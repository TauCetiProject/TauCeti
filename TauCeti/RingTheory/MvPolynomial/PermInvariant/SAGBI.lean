/-!
# Finite SAGBI bases of permutation-invariant polynomial algebras

Let `G ≤ Equiv.Perm σ` be a permutation group acting on `MvPolynomial σ R` by variable renaming
(in the given permutation coordinates), and let `m : MonomialOrder σ` be any monomial order. This
file completes the Reichstein / Thiéry–Thomassé characterization: `permInvariantSubalgebra G R` has
a finite `m`-SAGBI basis if and only if `G` is generated by transpositions, equivalently `G` is the
direct product of the full symmetric groups on its orbits
(`TauCeti.fiberSubgroup (Quotient.mk (MulAction.orbitRel G σ))`).

The positive direction (block elementary symmetric polynomials form a finite `m`-SAGBI basis over
every commutative semiring `R`) is proved in
`TauCeti.RingTheory.MvPolynomial.PermInvariant.BlockEsymm`.
For the negative direction (over any nontrivial commutative semiring without zero divisors, hence
every field in every characteristic), a finite `m`-SAGBI basis forces the monoid
`m.maxOrbitExponents G` to be finitely generated. Embedding into `σ → ℚ`, the generated rational
pointed cone `C` is polyhedral by Minkowski–Weyl duality (`PointedCone.fg_iff_dualFG`), and its
`G`-translates cover the nonnegative orthant with disjoint interiors. Walking along a generic
rational segment from a point in `C` to a perturbation of its `g`-translate crosses bounding
hyperplanes and coordinate-equality hyperplanes one at a time, factoring `g` into transpositions in
`G`. As an immediate corollary, `alternatingGroup (Fin n)` admits no finite `m`-SAGBI basis for any
`n ≥ 3` and any monomial order `m`.

## Main results

* `MonomialOrder.fg_maxOrbitExponents_iff_closure_isSwap_eq`: `m.maxOrbitExponents G` is finitely
  generated if and only if `G` is generated by transpositions.
* `MonomialOrder.exists_finite_isSAGBIBasis_permInvariantSubalgebra_iff`: over any nontrivial
  commutative semiring without zero divisors, `permInvariantSubalgebra G R` admits a finite
  `m`-SAGBI basis if and only if `G` is generated by transpositions.
* `MonomialOrder.exists_finite_isSAGBIBasis_permInvariantSubalgebra_iff_eq_fiberSubgroup`:
  equivalently, if and only if `G = TauCeti.fiberSubgroup (Quotient.mk (MulAction.orbitRel G σ))`.
* `MonomialOrder.exists_finite_isSAGBIBasis_alternatingGroup_iff` and
  `MonomialOrder.not_exists_finite_isSAGBIBasis_alternatingGroup`: `alternatingGroup` admits a
  finite `m`-SAGBI basis if and only if the variable set has cardinality at most `2`.

## References

* L. Robbiano, M. Sweedler, *Subalgebra bases*, in *Commutative Algebra (Salvador, 1988)*,
  Lecture Notes in Mathematics 1430, Springer, 1990, 61–87.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
* M. Göbel, *A constructive description of SAGBI bases for polynomial invariants of permutation
  groups*, J. Symbolic Comput. **26** (1998).
* N. M. Thiéry, S. Thomassé, *Convex cones and SAGBI bases of permutation invariants*, in
  *Invariant Theory in All Characteristics*, CRM Proc. Lecture Notes 35, AMS, 2004.
-/

public section

open Equiv

namespace MonomialOrder

open MvPolynomial

/-! ### Negative direction: rational polyhedral cone and hyperplane crossing -/

section Negative

variable {σ : Type*}

/-- Embed an exponent vector `σ →₀ ℕ` into the rational vector space `σ → ℚ`. -/
private def ratEmbed : (σ →₀ ℕ) →+ (σ → ℚ) where
  toFun d i := (d i : ℚ)
  map_zero' := funext fun _ => by simp
  map_add' _ _ := funext fun _ => by simp

private theorem ratEmbed_injective : Function.Injective (ratEmbed (σ := σ)) :=
  fun _ _ h => Finsupp.ext fun i => Nat.cast_injective (congrFun h i)

/-- The left permutation action on `σ → ℚ` given by `(permAct g v) i = v (g⁻¹ i)`. -/
private def permAct (g : Perm σ) (v : σ → ℚ) : σ → ℚ := fun i => v (g.symm i)

private theorem permAct_one (v : σ → ℚ) : permAct 1 v = v := rfl
private theorem permAct_mul (g₁ g₂ : Perm σ) (v : σ → ℚ) :
    permAct (g₁ * g₂) v = permAct g₁ (permAct g₂ v) := rfl
private theorem permAct_add (g : Perm σ) (u v : σ → ℚ) :
    permAct g (u + v) = permAct g u + permAct g v := rfl
private theorem permAct_smul (g : Perm σ) (c : ℚ) (v : σ → ℚ) :
    permAct g (c • v) = c • permAct g v := rfl

private theorem permAct_ratEmbed (g : Perm σ) (d : σ →₀ ℕ) :
    permAct g (ratEmbed d) = ratEmbed (d.equivMapDomain g) :=
  funext fun i => by simp [permAct, ratEmbed, Finsupp.equivMapDomain_apply]

private def permActLinearEquiv (g : Perm σ) : (σ → ℚ) ≃ₗ[ℚ] (σ → ℚ) where
  toFun := permAct g
  invFun := permAct g⁻¹
  left_inv _ := funext fun _ => by simp [permAct, Perm.inv_def]
  right_inv _ := funext fun _ => by simp [permAct, Perm.inv_def]
  map_add' := permAct_add g
  map_smul' := permAct_smul g

/-- The rational pointed cone generated by the image of `m.maxOrbitExponents G`. -/
private noncomputable def maxOrbitCone (m : MonomialOrder σ) (G : Subgroup (Perm σ)) :
    PointedCone ℚ (σ → ℚ) :=
  PointedCone.hull ℚ (ratEmbed '' (m.maxOrbitExponents G : Set (σ →₀ ℕ)))

private theorem fg_maxOrbitCone (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (hfg : (m.maxOrbitExponents G).FG) : (maxOrbitCone m G).FG := by
  classical
  rw [AddSubmonoid.fg_iff] at hfg
  obtain ⟨S, hS, hSfin⟩ := hfg
  have heq : maxOrbitCone m G = PointedCone.hull ℚ (ratEmbed '' S) := by
    refine le_antisymm ?_ (Submodule.span_mono fun _ ⟨a, ha, h⟩ =>
      ⟨a, hS ▸ AddSubmonoid.subset_closure ha, h⟩)
    rw [maxOrbitCone, PointedCone.hull, Submodule.span_le]
    rintro _ ⟨d, hd, rfl⟩
    rw [← hS] at hd
    induction hd using AddSubmonoid.closure_induction with
    | mem a ha => exact PointedCone.subset_hull ⟨a, ha, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add _ _ _ _ iha ihb => rw [map_add]; exact add_mem iha ihb
  exact heq ▸ Submodule.fg_span (hSfin.image ratEmbed)

/-- A nonnegative rational scaled by a multiple of its denominator is a natural number. -/
private theorem rat_nonneg_mul_nat_eq_nat {q : ℚ} (hq : 0 ≤ q) {N : ℕ} (hdvd : q.den ∣ N) :
    ∃ k : ℕ, (N : ℚ) * q = (k : ℚ) := by
  obtain ⟨r, rfl⟩ := hdvd
  refine ⟨r * q.num.toNat, ?_⟩
  have hden0 : (q.den : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr q.den_nz
  have hnum_eq : ((q.num.toNat : ℕ) : ℚ) = (q.num : ℚ) := by
    exact_mod_cast Int.toNat_of_nonneg (Rat.num_nonneg.mpr hq)
  calc ((q.den * r : ℕ) : ℚ) * q
      = (q.den : ℚ) * (r : ℚ) * ((q.num : ℚ) / (q.den : ℚ)) := by
          rw [Nat.cast_mul, Rat.num_div_den]
    _ = (r : ℚ) * (q.num : ℚ) := by field_simp [hden0]
    _ = ((r * q.num.toNat : ℕ) : ℚ) := by rw [Nat.cast_mul, hnum_eq]

/-- `m.maxOrbitExponents G` is saturated under positive scalar multiplication, so integer points in
`maxOrbitCone m G` lie in `m.maxOrbitExponents G`. -/
private theorem ratEmbed_mem_maxOrbitCone_iff (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (d : σ →₀ ℕ) :
    ratEmbed d ∈ maxOrbitCone m G ↔ d ∈ m.maxOrbitExponents G := by
  refine ⟨fun hd => ?_, fun hd => PointedCone.subset_hull ⟨d, hd, rfl⟩⟩
  obtain ⟨c, hc_supp, hc_nonneg, hc_sum⟩ := PointedCone.mem_hull_set.mp hd
  let N : ℕ := ∏ y ∈ c.support, (c y).den
  have hNpos : 0 < N := Finset.prod_pos fun y _ => (c y).pos
  choose k hk using fun y (hy : y ∈ c.support) =>
    rat_nonneg_mul_nat_eq_nat (hc_nonneg y) (Finset.dvd_prod_of_mem (fun z => (c z).den) hy)
  choose a ha haeq using fun y (hy : y ∈ c.support) => hc_supp (Finset.mem_coe.mpr hy)
  let d' : σ →₀ ℕ := ∑ y ∈ c.support.attach, k y.1 y.2 • a y.1 y.2
  have hd'_mem : d' ∈ m.maxOrbitExponents G := sum_mem fun y _ => nsmul_mem (ha y.1 y.2) _
  have hNd : N • d = d' := by
    apply ratEmbed_injective
    have hcast : ∀ (n : ℕ) (v : σ → ℚ), n • v = (n : ℚ) • v := fun _ _ => funext fun _ => by simp
    rw [map_nsmul, hcast, ← hc_sum, Finsupp.sum, Finset.smul_sum, map_sum,
      ← Finset.sum_attach c.support]
    refine Finset.sum_congr rfl fun y _ => ?_
    rw [smul_smul, hk y.1 y.2, map_nsmul, hcast, haeq y.1 y.2]
  rw [mem_maxOrbitExponents_iff]
  intro g hg
  have h1 := (m.mem_maxOrbitExponents_iff G d').mp hd'_mem g hg
  rw [← hNd, show (N • d).equivMapDomain g = N • d.equivMapDomain g by
    ext i; simp [Finsupp.equivMapDomain_apply], map_nsmul, map_nsmul] at h1
  by_contra hnot
  push Not at hnot
  exact not_lt_of_ge h1 (nsmul_lt_nsmul_right hNpos.ne' hnot)

/-- Any nonnegative rational vector `x : σ → ℚ` scales to `ratEmbed d` for some `d : σ →₀ ℕ`. -/
private theorem exists_nat_smul_eq_ratEmbed [Finite σ] {x : σ → ℚ} (hx : ∀ i, 0 ≤ x i) :
    ∃ (D : ℕ) (d : σ →₀ ℕ), 0 < D ∧ (D : ℚ) • x = ratEmbed d := by
  cases nonempty_fintype σ
  let D : ℕ := ∏ i : σ, (x i).den
  choose k hk using fun i =>
    rat_nonneg_mul_nat_eq_nat (hx i)
      (Finset.dvd_prod_of_mem (fun j => (x j).den) (Finset.mem_univ i))
  refine ⟨D, Finsupp.equivFunOnFinite.symm k, Finset.prod_pos fun i _ => (x i).pos,
    funext fun i => hk i⟩

/-- **Covering:** every nonnegative rational vector can be moved into `maxOrbitCone m G` by some
element of `G`. -/
private theorem exists_permAct_mem_maxOrbitCone [Finite σ] (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) {x : σ → ℚ} (hx : ∀ i, 0 ≤ x i) :
    ∃ g ∈ G, permAct g x ∈ maxOrbitCone m G := by
  classical
  let _ : Fintype G := Fintype.ofFinite G
  obtain ⟨D, d, hDpos, hDd⟩ := exists_nat_smul_eq_ratEmbed hx
  obtain ⟨g₀, -, hg₀max⟩ := Finset.exists_max_image Finset.univ
    (fun g : G => m.toSyn (d.equivMapDomain (g : Perm σ)))
    (Finset.univ_nonempty_iff.mpr ⟨⟨1, G.one_mem⟩⟩)
  have hd'_mem : d.equivMapDomain (g₀ : Perm σ) ∈ m.maxOrbitExponents G :=
    (m.mem_maxOrbitExponents_iff G _).mpr fun h hh => by
      rw [← Finsupp.equivMapDomain_trans]
      exact hg₀max ⟨h * g₀, G.mul_mem hh g₀.2⟩ (Finset.mem_univ _)
  refine ⟨(g₀ : Perm σ), g₀.2, ?_⟩
  have heq : permAct (g₀ : Perm σ) x =
      (D : ℚ)⁻¹ • ratEmbed (d.equivMapDomain (g₀ : Perm σ)) := by
    rw [← permAct_ratEmbed, ← hDd, permAct_smul]
    ext i; simp [permAct, Nat.cast_ne_zero.mpr hDpos.ne']
  rw [heq]
  exact PointedCone.smul_mem _ (inv_nonneg.mpr (Nat.cast_nonneg D))
    ((ratEmbed_mem_maxOrbitCone_iff m G _).mpr hd'_mem)

/-- **Disjointness on non-fixed points:** if a nonnegative rational vector `x` and its `g`-translate
both lie in `maxOrbitCone m G` (`g ∈ G`), then `g` fixes `x`. -/
private theorem permAct_eq_self_of_mem_maxOrbitCone [Finite σ] (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) {x : σ → ℚ} (hx : ∀ i, 0 ≤ x i) {g : Perm σ} (hg : g ∈ G)
    (hxC : x ∈ maxOrbitCone m G) (hgxC : permAct g x ∈ maxOrbitCone m G) :
    permAct g x = x := by
  obtain ⟨D, d, hDpos, hDd⟩ := exists_nat_smul_eq_ratEmbed hx
  have hd_mem : d ∈ m.maxOrbitExponents G := by
    rw [← ratEmbed_mem_maxOrbitCone_iff, ← hDd]
    exact PointedCone.smul_mem _ (Nat.cast_nonneg D) hxC
  have hgd_mem : d.equivMapDomain g ∈ m.maxOrbitExponents G := by
    rw [← ratEmbed_mem_maxOrbitCone_iff, ← permAct_ratEmbed, ← hDd, permAct_smul]
    exact PointedCone.smul_mem _ (Nat.cast_nonneg D) hgxC
  have hle2 : d ≼[m] d.equivMapDomain g := by
    have h := (m.mem_maxOrbitExponents_iff G _).mp hgd_mem g⁻¹ (G.inv_mem hg)
    rwa [← Finsupp.equivMapDomain_trans, Perm.inv_def, Equiv.self_trans_symm,
      Finsupp.equivMapDomain_refl] at h
  have hdeq : d.equivMapDomain g = d :=
    m.toSyn.injective (le_antisymm ((m.mem_maxOrbitExponents_iff G _).mp hd_mem g hg) hle2)
  have hscale : (D : ℚ) • permAct g x = (D : ℚ) • x := by
    rw [← permAct_smul, hDd, permAct_ratEmbed, hdeq]
  exact smul_right_injective (σ → ℚ) (Nat.cast_ne_zero.mpr hDpos.ne') hscale

/-- The coordinate-equality hyperplane `{v : σ → ℚ | v a = v b}`. -/
private def coordEqHyperplane (a b : σ) : Submodule ℚ (σ → ℚ) :=
  LinearMap.ker ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b)

private theorem mem_coordEqHyperplane_iff (a b : σ) (v : σ → ℚ) :
    v ∈ coordEqHyperplane a b ↔ v a = v b := by
  simp [coordEqHyperplane, sub_eq_zero]

/-- Distinct pairs of indices define distinct coordinate-equality hyperplanes (up to swapping the
pair). -/
private theorem eq_or_eq_of_coordEqHyperplane_eq {a b c d : σ}
    (hcd : c ≠ d) (heq : coordEqHyperplane a b = coordEqHyperplane c d) :
    c = a ∨ c = b := by
  classical
  by_contra hneither
  push Not at hneither
  have hmem : Pi.single c (1 : ℚ) ∈ coordEqHyperplane a b := by
    rw [mem_coordEqHyperplane_iff, Pi.single_eq_of_ne hneither.1.symm,
      Pi.single_eq_of_ne hneither.2.symm]
  rw [heq, mem_coordEqHyperplane_iff, Pi.single_eq_same, Pi.single_eq_of_ne hcd.symm] at hmem
  exact one_ne_zero hmem

/-- If two hyperplanes `ker φ₁ ≠ ker φ₂` both avoid `p`, then `span {p} ⊔ (ker φ₁ ⊓ ker φ₂) ≠ ⊤`. -/
private theorem span_sup_inf_ker_ne_top {V : Type*} [AddCommGroup V] [Module ℚ V]
    {φ₁ φ₂ : Module.Dual ℚ V} {p : V}
    (hne : LinearMap.ker φ₁ ≠ LinearMap.ker φ₂)
    (hp₁ : p ∉ LinearMap.ker φ₁) (hp₂ : p ∉ LinearMap.ker φ₂) :
    Submodule.span ℚ {p} ⊔ (LinearMap.ker φ₁ ⊓ LinearMap.ker φ₂) ≠ ⊤ := by
  let ψ : Module.Dual ℚ V := (φ₂ p) • φ₁ - (φ₁ p) • φ₂
  have hle : Submodule.span ℚ {p} ⊔ (LinearMap.ker φ₁ ⊓ LinearMap.ker φ₂) ≤ LinearMap.ker ψ :=
    sup_le (by rw [Submodule.span_singleton_le_iff_mem, LinearMap.mem_ker]; simp [ψ, mul_comm])
      fun _ ⟨hv₁, hv₂⟩ => by simp [ψ, LinearMap.mem_ker.mp hv₁, LinearMap.mem_ker.mp hv₂]
  have hψ0 : ψ ≠ 0 := fun h0 => hne <| Submodule.ext fun v => by
    have hv := LinearMap.congr_fun h0 v
    simp only [ψ, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul, LinearMap.zero_apply,
      sub_eq_zero] at hv
    have h1 : φ₁ p ≠ 0 := by simpa [LinearMap.mem_ker] using hp₁
    have h2 : φ₂ p ≠ 0 := by simpa [LinearMap.mem_ker] using hp₂
    simp only [LinearMap.mem_ker]
    exact ⟨fun h => (mul_eq_zero.mp (by rw [← hv, h, mul_zero])).resolve_left h1,
      fun h => (mul_eq_zero.mp (by rw [hv, h, mul_zero])).resolve_left h2⟩
  intro htop
  rw [htop, top_le_iff] at hle
  exact hψ0 (LinearMap.ker_eq_top.mp hle)

/-- Perturb a point `q` along a direction avoiding a finite family of submodules so that finitely
many strictly positive linear conditions are preserved while avoiding every submodule in the
family. -/
private theorem exists_perturb_pos_and_notMem {V : Type*} [AddCommGroup V] [Module ℚ V]
    (q : V) (L : Finset (Module.Dual ℚ V)) (hL : ∀ φ ∈ L, 0 < φ q)
    (ℬ : Finset (Submodule ℚ V)) (hℬ : ∀ K ∈ ℬ, K ≠ ⊤) :
    ∃ q' : V, (∀ φ ∈ L, 0 < φ q') ∧ (∀ K ∈ ℬ, q' ∉ K) := by
  classical
  obtain ⟨v, hv⟩ := Submodule.exists_forall_notMem_of_forall_ne_top
    (fun K : ℬ => (K : Submodule ℚ V)) (fun K => hℬ K.1 K.2)
  let bounds : Finset ℚ := insert 1 (L.image fun φ => φ q / (|φ v| + 1))
  let ε : ℚ := bounds.min' (Finset.insert_nonempty _ _)
  have hε : 0 < ε := by
    have hmem : ε ∈ bounds := Finset.min'_mem bounds (Finset.insert_nonempty _ _)
    rcases Finset.mem_insert.mp hmem with h1 | h2
    · rw [h1]; exact zero_lt_one
    · obtain ⟨φ, hφ, hφeq⟩ := Finset.mem_image.mp h2
      rw [← hφeq]; exact div_pos (hL φ hφ) (by positivity)
  have hbad_fin : (⋃ K ∈ ℬ, {s : ℚ | q + s • v ∈ K}).Finite :=
    ℬ.finite_toSet.biUnion fun K hK => Set.Subsingleton.finite fun s₁ hs₁ s₂ hs₂ => by
      by_contra hne
      have hdiff : (s₁ - s₂) • v ∈ K := by
        have heq : (q + s₁ • v) - (q + s₂ • v) = (s₁ - s₂) • v := by module
        exact heq ▸ K.sub_mem hs₁ hs₂
      have hvK := K.smul_mem (s₁ - s₂)⁻¹ hdiff
      rw [smul_smul, inv_mul_cancel₀ (sub_ne_zero.mpr hne), one_smul] at hvK
      exact hv ⟨K, hK⟩ hvK
  obtain ⟨s, hsIoo, hsnot⟩ := (Set.Ioo_infinite hε).exists_notMem_finite hbad_fin
  refine ⟨q + s • v, fun φ hφ => ?_, fun K hK hmem => hsnot (Set.mem_biUnion hK hmem)⟩
  have hs_lt : s < φ q / (|φ v| + 1) := lt_of_lt_of_le hsIoo.2
    (Finset.min'_le bounds _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hφ)))
  have hmul : s * (|φ v| + 1) < φ q := (lt_div_iff₀ (by positivity)).mp hs_lt
  have hle : s * (-(φ v)) ≤ s * |φ v| :=
    mul_le_mul_of_nonneg_left (neg_le_abs (φ v)) hsIoo.1.le
  rw [map_add, map_smul, smul_eq_mul]
  linarith [hsIoo.1]

/-- One-sided rational affine sign preservation at the left endpoint of `(a, m]`. -/
private theorem rational_affine_nonneg_left {a m u v : ℚ} (ham : a < m)
    (hm : 0 < (1 - m) * u + m * v) (hno : ∀ t ∈ Set.Ioo a m, (1 - t) * u + t * v ≠ 0) :
    0 ≤ (1 - a) * u + a * v := by
  by_contra hlt
  push Not at hlt
  set fa := (1 - a) * u + a * v
  set fm := (1 - m) * u + m * v
  have hden : 0 < fm - fa := by linarith
  let t : ℚ := (a * fm + m * (-fa)) / (fm - fa)
  have hzero : (1 - t) * u + t * v = 0 := by
    have hmul : (fm - fa) * ((1 - t) * u + t * v) = 0 := by
      calc (fm - fa) * ((1 - t) * u + t * v)
          = (fm - fa) * u + ((fm - fa) * t) * (v - u) := by ring
        _ = (fm - fa) * u + (a * fm + m * (-fa)) * (v - u) := by
            rw [mul_div_cancel₀ _ hden.ne']
        _ = 0 := by simp only [fa, fm]; ring
    exact (mul_eq_zero.mp hmul).resolve_left hden.ne'
  exact hno t ⟨(lt_div_iff₀ hden).mpr (by nlinarith), (div_lt_iff₀ hden).mpr (by nlinarith)⟩ hzero

/-- Rational affine sign preservation: if `f(t) = (1 - t) * u + t * v` is strictly positive at an
interior point `m ∈ (a, b)` and never vanishes on `(a, b)`, then `0 ≤ f a` and `0 ≤ f b`. -/
private theorem rational_affine_nonneg_of_no_zero {a m b u v : ℚ}
    (ham : a < m) (hmb : m < b) (hm : 0 < (1 - m) * u + m * v)
    (hno : ∀ t ∈ Set.Ioo a b, (1 - t) * u + t * v ≠ 0) :
    0 ≤ (1 - a) * u + a * v ∧ 0 ≤ (1 - b) * u + b * v :=
  ⟨rational_affine_nonneg_left ham hm fun t ht => hno t ⟨ht.1, lt_trans ht.2 hmb⟩, by
    simpa [sub_sub_cancel, add_comm] using
      rational_affine_nonneg_left (a := 1 - b) (m := 1 - m) (u := v) (v := u) (by linarith)
        (by linarith) fun t ht => by
          have := hno (1 - t) ⟨by linarith [ht.2], by linarith [ht.1]⟩
          intro h; exact this (by linarith)⟩

/-- If a permutation `τ` fixes a point `x : σ → ℚ` that lies on at most one coordinate-equality
hyperplane, then `τ = 1` or `τ` is a transposition. -/
private theorem eq_one_or_isSwap_of_permAct_eq [DecidableEq σ] {τ : Perm σ} {x : σ → ℚ}
    (hfix : permAct τ x = x)
    (huniq : ∀ a b c d : σ, a ≠ b → c ≠ d →
      x ∈ coordEqHyperplane a b → x ∈ coordEqHyperplane c d →
      coordEqHyperplane a b = coordEqHyperplane c d) :
    τ = 1 ∨ τ.IsSwap := by
  rcases eq_or_ne τ 1 with rfl | hne
  · exact Or.inl rfl
  · right
    obtain ⟨a, ha⟩ : ∃ a : σ, τ⁻¹ a ≠ a := by
      by_contra hall; push Not at hall
      exact hne (inv_eq_one.mp (Equiv.ext hall))
    let b : σ := τ⁻¹ a
    have hab : a ≠ b := ha.symm
    have hxab : x ∈ coordEqHyperplane a b :=
      (mem_coordEqHyperplane_iff a b x).mpr (congrFun hfix a).symm
    have hmoved : ∀ z : σ, τ⁻¹ z ≠ z → z = a ∨ z = b := fun z hz =>
      eq_or_eq_of_coordEqHyperplane_eq hz.symm
        (huniq a b z (τ⁻¹ z) hab hz.symm hxab
          ((mem_coordEqHyperplane_iff z (τ⁻¹ z) x).mpr (congrFun hfix z).symm))
    have hinv_b : τ⁻¹ b = a := by
      have hnb : τ⁻¹ b ≠ b := fun h => hab (τ⁻¹.injective h).symm
      exact (hmoved (τ⁻¹ b) (fun h => hnb (τ⁻¹.injective h))).resolve_right hnb
    have hinv_eq : τ⁻¹ = swap a b := by
      ext z
      rcases eq_or_ne z a with rfl | hza; · simp [b]
      rcases eq_or_ne z b with rfl | hzb; · simp [hinv_b]
      rw [swap_apply_of_ne_of_ne hza hzb]
      by_contra hz; exact (hmoved z hz).elim hza hzb
    exact ⟨a, b, hab, by rw [← inv_inv τ, hinv_eq]; exact Equiv.symm_swap a b⟩

/-- A permutation fixing a point outside all coordinate-equality hyperplanes is the identity. -/
private theorem eq_one_of_permAct_eq_of_notMem_coordEq {τ : Perm σ} {x : σ → ℚ}
    (hfix : permAct τ x = x)
    (hout : ∀ a b : σ, a ≠ b → x ∉ coordEqHyperplane a b) :
    τ = 1 := by
  ext i
  by_contra hne
  have hne' : i ≠ τ.symm i := fun heq => hne (by simpa using congrArg τ heq)
  exact hout i (τ.symm i) hne' ((mem_coordEqHyperplane_iff i (τ.symm i) x).mpr
    (congrFun hfix i).symm)

/-- Walking along a generic rational segment `γ t = (1 - t) • p₁ + t • q₁` between `p₁ ∈ C` and
`q₁ ∈ g • C` factors `g` as a product of transpositions in `G`. -/
private theorem mem_closure_isSwap_of_generic_segment [Finite σ] [DecidableEq σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (F : Finset (Module.Dual ℚ (σ → ℚ)))
    (hC_iff : ∀ x : σ → ℚ, x ∈ maxOrbitCone m G ↔ ∀ ℓ ∈ F, 0 ≤ ℓ x)
    (Φ : Finset (Module.Dual ℚ (σ → ℚ)))
    (hwall : ∀ h ∈ G, ∀ ℓ ∈ F, ℓ.comp (permActLinearEquiv h⁻¹).toLinearMap ∈ Φ)
    (heq_mem : ∀ a b : σ, a ≠ b →
      ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b) ∈ Φ)
    {g : Perm σ} (hg : g ∈ G) {p₁ q₁ : σ → ℚ}
    (hp₁_pos : ∀ i, 0 < p₁ i) (hq₁_pos : ∀ i, 0 < q₁ i)
    (hp₁C : p₁ ∈ maxOrbitCone m G) (hq₁_gC : permAct g⁻¹ q₁ ∈ maxOrbitCone m G)
    (hp₁_out : ∀ φ ∈ Φ, φ p₁ ≠ 0) (hq₁_out : ∀ φ ∈ Φ, φ q₁ ≠ 0)
    (hγ_uniq : ∀ (t : ℚ) {φ₁ φ₂ : Module.Dual ℚ (σ → ℚ)}, φ₁ ∈ Φ → φ₂ ∈ Φ →
      φ₁ ((1 - t) • p₁ + t • q₁) = 0 → φ₂ ((1 - t) • p₁ + t • q₁) = 0 →
      LinearMap.ker φ₁ = LinearMap.ker φ₂) :
    g ∈ Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} := by
  classical
  let γ : ℚ → (σ → ℚ) := fun t => (1 - t) • p₁ + t • q₁
  have hγ_pos : ∀ t : ℚ, 0 ≤ t → t ≤ 1 → ∀ i, 0 < γ t i := fun t ht0 ht1 i => by
    simp only [γ, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    rcases eq_or_lt_of_le ht0 with rfl | ht0'
    · simpa using hp₁_pos i
    · have : 0 ≤ 1 - t := sub_nonneg.mpr ht1
      nlinarith [hp₁_pos i, hq₁_pos i]
  let crossTimes : Finset ℚ :=
    ((Φ.filter fun φ => φ p₁ ≠ φ q₁).image fun φ => φ p₁ / (φ p₁ - φ q₁)).filter
      fun t => 0 < t ∧ t < 1
  let nodes : Finset ℚ := insert 0 (insert 1 crossTimes)
  have h0_mem : (0 : ℚ) ∈ nodes := Finset.mem_insert_self _ _
  have h1_mem : (1 : ℚ) ∈ nodes := Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)
  have hnodes_card : 2 ≤ nodes.card :=
    le_trans (by decide : 2 ≤ ({0, 1} : Finset ℚ).card) (Finset.card_le_card fun x hx => by
      rcases Finset.mem_insert.mp hx with rfl | hx'
      · exact h0_mem
      · rw [Finset.mem_singleton.mp hx']; exact h1_mem)
  let k : ℕ := nodes.card - 2
  have hk_eq : nodes.card = k + 2 := by omega
  let c : Fin (k + 2) ↪o ℚ := nodes.orderEmbOfFin hk_eq
  have hrange : (nodes : Set ℚ) = Set.range c := (Finset.range_orderEmbOfFin nodes hk_eq).symm
  have hc_mem : ∀ j, c j ∈ nodes := fun j => Finset.orderEmbOfFin_mem nodes hk_eq j
  have hc_bounds : ∀ t ∈ nodes, 0 ≤ t ∧ t ≤ 1 := fun t ht => by
    rcases Finset.mem_insert.mp ht with rfl | ht'
    · exact ⟨le_rfl, zero_le_one⟩
    · rcases Finset.mem_insert.mp ht' with rfl | ht''
      · exact ⟨zero_le_one, le_rfl⟩
      · have := (Finset.mem_filter.mp ht'').2; exact ⟨this.1.le, this.2.le⟩
  have hc0 : c 0 = 0 := by
    obtain ⟨j, hj⟩ := hrange ▸ Finset.mem_coe.mpr h0_mem
    exact le_antisymm (hj ▸ c.monotone (Fin.zero_le j)) (hc_bounds _ (hc_mem 0)).1
  have hclast : c (Fin.last (k + 1)) = 1 := by
    obtain ⟨j, hj⟩ := hrange ▸ Finset.mem_coe.mpr h1_mem
    exact le_antisymm (hc_bounds _ (hc_mem _)).2 (hj ▸ c.monotone (Fin.le_last j))
  have hno_cross : ∀ (j : Fin (k + 1)) (t : ℚ),
      t ∈ Set.Ioo (c j.castSucc) (c j.succ) → ∀ φ ∈ Φ, φ (γ t) ≠ 0 := by
    intro j t ht φ hφ hzero
    have ht0 : 0 < t := lt_of_le_of_lt (hc_bounds _ (hc_mem j.castSucc)).1 ht.1
    have ht1 : t < 1 := lt_of_lt_of_le ht.2 (hc_bounds _ (hc_mem j.succ)).2
    have hlin : (1 - t) * φ p₁ + t * φ q₁ = 0 := by
      simpa [γ, map_add, map_smul, smul_eq_mul] using hzero
    have hne : φ p₁ ≠ φ q₁ := fun heq => hp₁_out φ hφ (by rw [heq] at hlin; linarith)
    have hteq : t = φ p₁ / (φ p₁ - φ q₁) := by
      have hsub : φ p₁ - φ q₁ ≠ 0 := sub_ne_zero.mpr hne
      field_simp [hsub]; linarith
    have ht_node : t ∈ nodes := Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
      (Finset.mem_filter.mpr ⟨Finset.mem_image.mpr
        ⟨φ, Finset.mem_filter.mpr ⟨hφ, hne⟩, hteq.symm⟩, ht0, ht1⟩))
    obtain ⟨i, hi⟩ := hrange ▸ Finset.mem_coe.mpr ht_node
    have h1 : (j : ℕ) < (i : ℕ) := c.lt_iff_lt.mp (hi.symm ▸ ht.1)
    have h2 : (i : ℕ) < (j : ℕ) + 1 := c.lt_iff_lt.mp (hi.symm ▸ ht.2)
    omega
  let mid : Fin (k + 1) → ℚ := fun j => (c j.castSucc + c j.succ) / 2
  have hmid_Ioo : ∀ j : Fin (k + 1), mid j ∈ Set.Ioo (c j.castSucc) (c j.succ) := fun j => by
    have hlt : c j.castSucc < c j.succ := c.strictMono Fin.castSucc_lt_succ
    exact ⟨by simp only [mid]; linarith, by simp only [mid]; linarith⟩
  choose h hhG hhC using fun j : Fin (k + 1) => show ∃ h ∈ G,
      permAct h⁻¹ (γ (mid j)) ∈ maxOrbitCone m G from by
    have hm0 : 0 ≤ mid j := le_trans (hc_bounds _ (hc_mem j.castSucc)).1 (hmid_Ioo j).1.le
    have hm1 : mid j ≤ 1 := le_trans (hmid_Ioo j).2.le (hc_bounds _ (hc_mem j.succ)).2
    obtain ⟨h', hh', hh'C⟩ := exists_permAct_mem_maxOrbitCone m G
      fun i => (hγ_pos (mid j) hm0 hm1 i).le
    exact ⟨h'⁻¹, G.inv_mem hh', by simpa only [inv_inv] using hh'C⟩
  have hendpoints : ∀ j : Fin (k + 1),
      permAct (h j)⁻¹ (γ (c j.castSucc)) ∈ maxOrbitCone m G ∧
      permAct (h j)⁻¹ (γ (c j.succ)) ∈ maxOrbitCone m G := fun j => by
    have hpair : ∀ ℓ ∈ F,
        0 ≤ ℓ (permAct (h j)⁻¹ (γ (c j.castSucc))) ∧ 0 ≤ ℓ (permAct (h j)⁻¹ (γ (c j.succ))) := by
      intro ℓ hℓ
      let φ : Module.Dual ℚ (σ → ℚ) := ℓ.comp (permActLinearEquiv (h j)⁻¹).toLinearMap
      have hφ : φ ∈ Φ := hwall (h j) (hhG j) ℓ hℓ
      have hφ_eval : ∀ t : ℚ, φ (γ t) = (1 - t) * φ p₁ + t * φ q₁ := fun t => by
        simp [γ, map_add, map_smul, smul_eq_mul]
      have hfm : 0 < (1 - mid j) * φ p₁ + mid j * φ q₁ := by
        rw [← hφ_eval]
        exact lt_of_le_of_ne ((hC_iff _).mp (hhC j) ℓ hℓ)
          (hno_cross j (mid j) (hmid_Ioo j) φ hφ).symm
      have hres := rational_affine_nonneg_of_no_zero (hmid_Ioo j).1 (hmid_Ioo j).2 hfm
        fun t ht => by rw [← hφ_eval]; exact hno_cross j t ht φ hφ
      exact ⟨by change 0 ≤ φ (γ (c j.castSucc)); rw [hφ_eval]; exact hres.1,
        by change 0 ≤ φ (γ (c j.succ)); rw [hφ_eval]; exact hres.2⟩
    exact ⟨(hC_iff _).mpr fun ℓ hℓ => (hpair ℓ hℓ).1, (hC_iff _).mpr fun ℓ hℓ => (hpair ℓ hℓ).2⟩
  have hh0 : h 0 = 1 := by
    have h0C : permAct (h 0)⁻¹ p₁ ∈ maxOrbitCone m G := by simpa [γ, hc0] using (hendpoints 0).1
    have hfix := permAct_eq_self_of_mem_maxOrbitCone m G (fun i => (hp₁_pos i).le)
      (G.inv_mem (hhG 0)) hp₁C h0C
    exact inv_eq_one.mp (eq_one_of_permAct_eq_of_notMem_coordEq hfix fun a b hab hmem =>
      hp₁_out _ (heq_mem a b hab) hmem)
  have hhlast : h (Fin.last k) = g := by
    have hlastC : permAct (h (Fin.last k))⁻¹ q₁ ∈ maxOrbitCone m G := by
      simpa [γ, hclast] using (hendpoints (Fin.last k)).2
    have hcompC : permAct ((h (Fin.last k))⁻¹ * g) (permAct g⁻¹ q₁) ∈ maxOrbitCone m G := by
      rw [← permAct_mul, mul_assoc, mul_inv_cancel, mul_one]; exact hlastC
    have hfix := permAct_eq_self_of_mem_maxOrbitCone m G (x := permAct g⁻¹ q₁)
      (fun i => (hq₁_pos (g⁻¹.symm i)).le)
      (G.mul_mem (G.inv_mem (hhG (Fin.last k))) hg) hq₁_gC hcompC
    rw [← permAct_mul, mul_assoc, mul_inv_cancel, mul_one] at hfix
    have hfix' : permAct (g * (h (Fin.last k))⁻¹) q₁ = q₁ := by
      rw [permAct_mul, hfix, ← permAct_mul, mul_inv_cancel, permAct_one]
    exact (mul_inv_eq_one.mp (eq_one_of_permAct_eq_of_notMem_coordEq hfix' fun a b hab hmem =>
      hq₁_out _ (heq_mem a b hab) hmem)).symm
  have hstep : ∀ j : Fin k,
      h j.castSucc * (h j.succ)⁻¹ ∈ Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} := fun j => by
    let t := c j.succ.castSucc
    have h1C : permAct (h j.castSucc)⁻¹ (γ t) ∈ maxOrbitCone m G := (hendpoints j.castSucc).2
    have h2C : permAct (h j.succ)⁻¹ (γ t) ∈ maxOrbitCone m G := (hendpoints j.succ).1
    have ht_nonneg : ∀ i, 0 ≤ permAct (h j.castSucc)⁻¹ (γ t) i := fun _ =>
      (hγ_pos t (hc_bounds _ (hc_mem _)).1 (hc_bounds _ (hc_mem _)).2 _).le
    have hcompC : permAct ((h j.succ)⁻¹ * h j.castSucc) (permAct (h j.castSucc)⁻¹ (γ t)) ∈
        maxOrbitCone m G := by
      rw [← permAct_mul, mul_assoc, mul_inv_cancel, mul_one]; exact h2C
    have hfix := permAct_eq_self_of_mem_maxOrbitCone m G ht_nonneg
      (G.mul_mem (G.inv_mem (hhG j.succ)) (hhG j.castSucc)) h1C hcompC
    rw [← permAct_mul, mul_assoc, mul_inv_cancel, mul_one] at hfix
    have hfix_step : permAct (h j.castSucc * (h j.succ)⁻¹) (γ t) = γ t := by
      rw [permAct_mul, hfix, ← permAct_mul, mul_inv_cancel, permAct_one]
    rcases eq_one_or_isSwap_of_permAct_eq hfix_step (fun a b c' d' hab hcd h1 h2 =>
      hγ_uniq t (heq_mem a b hab) (heq_mem c' d' hcd) h1 h2) with h1 | hswap
    · rw [h1]; exact one_mem _
    · exact Subgroup.subset_closure ⟨G.mul_mem (hhG j.castSucc) (G.inv_mem (hhG j.succ)), hswap⟩
  have hall : ∀ j : Fin (k + 1), h j ∈ Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} := fun j =>
    Fin.induction (hh0.symm ▸ one_mem _) (fun j ih => by
      have hmul : h j.succ = (h j.castSucc * (h j.succ)⁻¹)⁻¹ * h j.castSucc := by group
      exact hmul ▸ Subgroup.mul_mem _ (Subgroup.inv_mem _ (hstep j)) ih) j
  exact hhlast ▸ hall (Fin.last k)

/-- **Negative direction of the permutation SAGBI criterion (Reichstein / Thiéry–Thomassé):**
if `m.maxOrbitExponents G` is finitely generated on a finite type `σ`, then `G` is generated by
transpositions. -/
private theorem closure_isSwap_eq_of_fg_maxOrbitExponents [Finite σ] [DecidableEq σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ)) (hfg : (m.maxOrbitExponents G).FG) :
    Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G := by
  classical
  cases nonempty_fintype σ
  let _ : Fintype G := Fintype.ofFinite G
  obtain ⟨F₀, hF₀⟩ := PointedCone.fg_iff_dualFG.mp (fg_maxOrbitCone m G hfg)
  let F : Finset (Module.Dual ℚ (σ → ℚ)) := F₀.filter (· ≠ 0)
  have hC_iff : ∀ x : σ → ℚ, x ∈ maxOrbitCone m G ↔ ∀ ℓ ∈ F, 0 ≤ ℓ x := fun x => by
    rw [← hF₀, PointedCone.mem_dual]
    exact ⟨fun hx ℓ hℓ => hx (Finset.mem_filter.mp hℓ).1, fun hx ℓ hℓ => by
      rcases eq_or_ne ℓ 0 with rfl | hℓ0; · simp
      exact hx ℓ (Finset.mem_filter.mpr ⟨hℓ, hℓ0⟩)⟩
  let wallFuncs : Finset (Module.Dual ℚ (σ → ℚ)) :=
    (Finset.univ ×ˢ F).image fun p : G × Module.Dual ℚ (σ → ℚ) =>
      p.2.comp (permActLinearEquiv (p.1 : Perm σ)⁻¹).toLinearMap
  let eqFuncs : Finset (Module.Dual ℚ (σ → ℚ)) :=
    ((Finset.univ : Finset (σ × σ)).filter fun p => p.1 ≠ p.2).image fun p =>
      (LinearMap.proj p.1 : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj p.2
  let Φ : Finset (Module.Dual ℚ (σ → ℚ)) := wallFuncs ∪ eqFuncs
  have hwall : ∀ h ∈ G, ∀ ℓ ∈ F, ℓ.comp (permActLinearEquiv h⁻¹).toLinearMap ∈ Φ := fun h hh ℓ hℓ =>
    Finset.mem_union_left _ (Finset.mem_image.mpr
      ⟨(⟨h, hh⟩, ℓ), Finset.mem_product.mpr ⟨Finset.mem_univ _, hℓ⟩, rfl⟩)
  have heq_mem : ∀ a b : σ, a ≠ b →
      ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b) ∈ Φ := fun a b hab =>
    Finset.mem_union_right _ (Finset.mem_image.mpr
      ⟨(a, b), Finset.mem_filter.mpr ⟨Finset.mem_univ _, hab⟩, rfl⟩)
  have hΦ_ne_zero : ∀ φ ∈ Φ, φ ≠ 0 := fun φ hφ => by
    rcases Finset.mem_union.mp hφ with hw | he
    · obtain ⟨⟨h, ℓ⟩, hp, rfl⟩ := Finset.mem_image.mp hw
      intro h0
      apply (Finset.mem_filter.mp (Finset.mem_product.mp hp).2).2
      refine LinearMap.ext fun w => ?_
      have hw0 : ℓ (permAct (h : Perm σ)⁻¹ (permAct (h : Perm σ) w)) = 0 :=
        LinearMap.congr_fun h0 (permAct (h : Perm σ) w)
      rwa [← permAct_mul, inv_mul_cancel, permAct_one] at hw0
    · obtain ⟨⟨a, b⟩, hp, rfl⟩ := Finset.mem_image.mp he
      intro h0
      have := LinearMap.congr_fun h0 (Pi.single a (1 : ℚ))
      simp [Pi.single_eq_of_ne (Finset.mem_filter.mp hp).2.symm] at this
  let ℋ : Finset (Submodule ℚ (σ → ℚ)) := Φ.image LinearMap.ker
  have hℋ_ne_top : ∀ H ∈ ℋ, H ≠ ⊤ := fun H hH => by
    obtain ⟨φ, hφ, rfl⟩ := Finset.mem_image.mp hH
    exact fun htop => hΦ_ne_zero φ hφ (LinearMap.ker_eq_top.mp htop)
  have hΦ_perm : ∀ (h : Perm σ), h ∈ G → ∀ φ ∈ Φ,
      LinearMap.ker (φ.comp (permActLinearEquiv h).toLinearMap) ∈ ℋ := fun h hh φ hφ => by
    rcases Finset.mem_union.mp hφ with hw | he
    · obtain ⟨⟨k, ℓ⟩, hp, rfl⟩ := Finset.mem_image.mp hw
      have hcomp : (ℓ.comp (permActLinearEquiv (k : Perm σ)⁻¹).toLinearMap).comp
          (permActLinearEquiv h).toLinearMap =
          ℓ.comp (permActLinearEquiv ((h⁻¹ * (k : Perm σ)) : Perm σ)⁻¹).toLinearMap :=
        LinearMap.ext fun w => by
          change ℓ (permAct (k : Perm σ)⁻¹ (permAct h w)) = _
          rw [← permAct_mul, mul_inv_rev, inv_inv]; rfl
      rw [hcomp]
      exact Finset.mem_image_of_mem _ (hwall _ (G.mul_mem (G.inv_mem hh) k.2) ℓ
        (Finset.mem_product.mp hp).2)
    · obtain ⟨⟨a, b⟩, hp, rfl⟩ := Finset.mem_image.mp he
      have hcomp : ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b).comp
          (permActLinearEquiv h).toLinearMap =
          (LinearMap.proj (h.symm a) : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj (h.symm b) :=
        LinearMap.ext fun _ => rfl
      rw [hcomp]
      exact Finset.mem_image_of_mem _
        (heq_mem (h.symm a) (h.symm b) (h.symm.injective.ne (Finset.mem_filter.mp hp).2))
  obtain ⟨p₀, hp₀_pos, hp₀_out⟩ := exists_perturb_pos_and_notMem
    (fun _ : σ => (1 : ℚ)) (Finset.univ.image fun i : σ => (LinearMap.proj i : (σ → ℚ) →ₗ[ℚ] ℚ))
    (fun φ hφ => by obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hφ; exact zero_lt_one)
    ℋ hℋ_ne_top
  obtain ⟨h₀, hh₀G, hp₁C⟩ := exists_permAct_mem_maxOrbitCone m G fun i =>
    (hp₀_pos (LinearMap.proj i) (Finset.mem_image_of_mem _ (Finset.mem_univ i))).le
  let p₁ : σ → ℚ := permAct h₀ p₀
  have hp₁_pos : ∀ i, 0 < p₁ i := fun i =>
    hp₀_pos (LinearMap.proj (h₀.symm i)) (Finset.mem_image_of_mem _ (Finset.mem_univ _))
  have hp₁_out : ∀ φ ∈ Φ, φ p₁ ≠ 0 := fun φ hφ h0 =>
    hp₀_out _ (hΦ_perm h₀ hh₀G φ hφ) (by simpa [permActLinearEquiv, p₁] using h0)
  refine le_antisymm ((Subgroup.closure_le G).2 fun _ h => h.1) fun g hg => ?_
  let q₀ : σ → ℚ := permAct g p₁
  let pairSubs : Finset (Submodule ℚ (σ → ℚ)) :=
    ((ℋ ×ˢ ℋ).filter fun P => P.1 ≠ P.2).image fun P => Submodule.span ℚ {p₁} ⊔ (P.1 ⊓ P.2)
  let ℬ : Finset (Submodule ℚ (σ → ℚ)) := ℋ ∪ pairSubs
  have hℬ_ne_top : ∀ K ∈ ℬ, K ≠ ⊤ := fun K hK => by
    rcases Finset.mem_union.mp hK with h1 | h2
    · exact hℋ_ne_top K h1
    · obtain ⟨⟨H₁, H₂⟩, hP, rfl⟩ := Finset.mem_image.mp h2
      obtain ⟨h12, hne⟩ := Finset.mem_filter.mp hP
      obtain ⟨φ₁, hφ₁, rfl⟩ := Finset.mem_image.mp (Finset.mem_product.mp h12).1
      obtain ⟨φ₂, hφ₂, rfl⟩ := Finset.mem_image.mp (Finset.mem_product.mp h12).2
      exact span_sup_inf_ker_ne_top hne (hp₁_out φ₁ hφ₁) (hp₁_out φ₂ hφ₂)
  let Lpos : Finset (Module.Dual ℚ (σ → ℚ)) :=
    (Finset.univ.image fun i : σ => (LinearMap.proj i : (σ → ℚ) →ₗ[ℚ] ℚ)) ∪
    (F.image fun ℓ => ℓ.comp (permActLinearEquiv g⁻¹).toLinearMap)
  have hLpos : ∀ φ ∈ Lpos, 0 < φ q₀ := fun φ hφ => by
    rcases Finset.mem_union.mp hφ with h1 | h2
    · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp h1; exact hp₁_pos (g.symm i)
    · obtain ⟨ℓ, hℓ, rfl⟩ := Finset.mem_image.mp h2
      have hval : (ℓ.comp (permActLinearEquiv g⁻¹).toLinearMap) q₀ = ℓ p₁ := by
        change ℓ (permAct g⁻¹ (permAct g p₁)) = ℓ p₁
        rw [← permAct_mul, inv_mul_cancel, permAct_one]
      rw [hval]
      have hne : ℓ p₁ ≠ 0 := by
        have hcomp : ℓ = ℓ.comp (permActLinearEquiv (1 : Perm σ)⁻¹).toLinearMap :=
          LinearMap.ext fun _ => by
            change ℓ _ = ℓ (permAct (1 : Perm σ)⁻¹ _)
            rw [inv_one, permAct_one]
        exact hcomp ▸ hp₁_out _ (hwall 1 G.one_mem ℓ hℓ)
      exact lt_of_le_of_ne ((hC_iff p₁).mp hp₁C ℓ hℓ) hne.symm
  obtain ⟨q₁, hq₁_L, hq₁_ℬ⟩ := exists_perturb_pos_and_notMem q₀ Lpos hLpos ℬ hℬ_ne_top
  refine mem_closure_isSwap_of_generic_segment m G F hC_iff Φ hwall heq_mem hg hp₁_pos
    (fun i => hq₁_L _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ i))))
    hp₁C ((hC_iff _).mpr fun ℓ hℓ =>
      (hq₁_L _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hℓ))).le)
    hp₁_out
    (fun φ hφ h0 => hq₁_ℬ _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hφ)) h0)
    fun t {φ₁ φ₂} hφ₁ hφ₂ h1 h2 => by
      by_contra hne
      rcases eq_or_ne t 0 with rfl | ht0
      · exact hp₁_out φ₁ hφ₁ (by simpa using h1)
      · have hdecomp : q₁ = (-(1 - t) / t) • p₁ + t⁻¹ • ((1 - t) • p₁ + t • q₁) := by
          ext i; simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]; field_simp [ht0]; ring
        have hmem : q₁ ∈ Submodule.span ℚ {p₁} ⊔ (LinearMap.ker φ₁ ⊓ LinearMap.ker φ₂) :=
          hdecomp ▸ Submodule.add_mem_sup (Submodule.smul_mem _ _ (Submodule.subset_span rfl))
            ((LinearMap.ker φ₁ ⊓ LinearMap.ker φ₂).smul_mem t⁻¹ ⟨h1, h2⟩)
        exact hq₁_ℬ _ (Finset.mem_union_right _ (Finset.mem_image.mpr
          ⟨(LinearMap.ker φ₁, LinearMap.ker φ₂), Finset.mem_filter.mpr
            ⟨Finset.mem_product.mpr ⟨Finset.mem_image_of_mem _ hφ₁, Finset.mem_image_of_mem _ hφ₂⟩,
              hne⟩, rfl⟩)) hmem

end Negative

/-! ### Main equivalence theorems and alternating-group corollaries -/

section Main

variable {σ R : Type*}

/-- **Leading-exponent monoid characterization (Reichstein / Thiéry–Thomassé):** for a finite type
`σ`, a permutation subgroup `G ≤ Equiv.Perm σ`, and any monomial order `m`, the monoid
`m.maxOrbitExponents G` of `m`-maximal orbit exponents is finitely generated if and only if `G` is
generated by transpositions. -/
theorem fg_maxOrbitExponents_iff_closure_isSwap_eq [Finite σ] [DecidableEq σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ)) :
    (m.maxOrbitExponents G).FG ↔ Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G :=
  ⟨closure_isSwap_eq_of_fg_maxOrbitExponents m G, fun hG => by
    rw [← m.leadingExponents_permInvariantSubalgebra_eq G ℚ]
    exact m.fg_leadingExponents_of_finite_isSAGBIBasis (blockEsymmSet_finite G ℚ)
      (m.isSAGBIBasis_blockEsymmSet G ℚ hG)⟩

/-- **Finite SAGBI criterion for permutation-invariant polynomial algebras (Reichstein /
Thiéry–Thomassé):** over any nontrivial commutative semiring `R` without zero divisors (in
particular, over any field in any characteristic) and for any monomial order `m`, the
`G`-invariant subalgebra `MvPolynomial.permInvariantSubalgebra G R` has a finite `m`-SAGBI basis
if and only if `G` is generated by transpositions. -/
theorem exists_finite_isSAGBIBasis_permInvariantSubalgebra_iff [Finite σ] [DecidableEq σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ)) (R : Type*)
    [CommSemiring R] [NoZeroDivisors R] [Nontrivial R] :
    (∃ B : Set (MvPolynomial σ R), B.Finite ∧
        m.IsSAGBIBasis B (permInvariantSubalgebra G R)) ↔
      Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G :=
  ⟨fun ⟨_, hBfin, hB⟩ => (m.fg_maxOrbitExponents_iff_closure_isSwap_eq G).mp
      (m.leadingExponents_permInvariantSubalgebra_eq G R ▸
        m.fg_leadingExponents_of_finite_isSAGBIBasis hBfin hB),
    fun hG => ⟨blockEsymmSet G R, blockEsymmSet_finite G R, m.isSAGBIBasis_blockEsymmSet G R hG⟩⟩

/-- **Product-of-symmetric-groups form of the permutation SAGBI criterion:**
`permInvariantSubalgebra G R` has a finite `m`-SAGBI basis if and only if `G` equals the fiber
subgroup of its orbit quotient map (the product of the full symmetric groups on its orbits). -/
theorem exists_finite_isSAGBIBasis_permInvariantSubalgebra_iff_eq_fiberSubgroup
    [Finite σ] (m : MonomialOrder σ) (G : Subgroup (Perm σ)) (R : Type*)
    [CommSemiring R] [NoZeroDivisors R] [Nontrivial R] :
    (∃ B : Set (MvPolynomial σ R), B.Finite ∧
        m.IsSAGBIBasis B (permInvariantSubalgebra G R)) ↔
      G = TauCeti.fiberSubgroup (Quotient.mk (MulAction.orbitRel G σ)) := by
  classical
  rw [m.exists_finite_isSAGBIBasis_permInvariantSubalgebra_iff G R,
    TauCeti.closure_isSwap_eq_iff_eq_fiberSubgroup_orbitRel G]

/-- **Alternating-group SAGBI characterization:** over any nontrivial commutative semiring `R`
without zero divisors and for any monomial order `m`, the alternating invariant subalgebra
`permInvariantSubalgebra (alternatingGroup σ) R` admits a finite `m`-SAGBI basis if and only if
`Fintype.card σ ≤ 2`. -/
theorem exists_finite_isSAGBIBasis_alternatingGroup_iff [Fintype σ] [DecidableEq σ]
    (m : MonomialOrder σ) (R : Type*) [CommSemiring R] [NoZeroDivisors R] [Nontrivial R] :
    (∃ B : Set (MvPolynomial σ R), B.Finite ∧
        m.IsSAGBIBasis B (permInvariantSubalgebra (alternatingGroup σ) R)) ↔
      Fintype.card σ ≤ 2 := by
  rw [m.exists_finite_isSAGBIBasis_permInvariantSubalgebra_iff,
    TauCeti.closure_isSwap_alternatingGroup_eq_iff]

/-- **Nonfinite SAGBI for alternating groups (`n ≥ 3`):** for every `n ≥ 3`, every monomial order
`m`, and every nontrivial commutative semiring `R` without zero divisors (in particular every field
in every characteristic), `permInvariantSubalgebra (alternatingGroup (Fin n)) R` admits no finite
`m`-SAGBI basis. -/
theorem not_exists_finite_isSAGBIBasis_alternatingGroup {n : ℕ} (hn : 3 ≤ n)
    (m : MonomialOrder (Fin n)) (R : Type*) [CommSemiring R] [NoZeroDivisors R] [Nontrivial R] :
    ¬ ∃ B : Set (MvPolynomial (Fin n) R), B.Finite ∧
        m.IsSAGBIBasis B (permInvariantSubalgebra (alternatingGroup (Fin n)) R) := by
  rw [m.exists_finite_isSAGBIBasis_alternatingGroup_iff, Fintype.card_fin]
  omega

/-- For `n = 1`, `{X 0}` is a singleton `m`-SAGBI basis of
`permInvariantSubalgebra (alternatingGroup (Fin 1)) R` for every monomial order `m`. -/
theorem isSAGBIBasis_singleton_X_zero_alternatingGroup_one (m : MonomialOrder (Fin 1))
    (R : Type*) [CommSemiring R] :
    m.IsSAGBIBasis {(X (0 : Fin 1) : MvPolynomial (Fin 1) R)}
      (permInvariantSubalgebra (alternatingGroup (Fin 1)) R) := by
  have hbot : alternatingGroup (Fin 1) = ⊥ := TauCeti.alternatingGroup_eq_bot_iff.mpr (by simp)
  rw [hbot, permInvariantSubalgebra_bot]
  have hrange : Set.range (X : Fin 1 → MvPolynomial (Fin 1) R) = {X 0} := by
    ext p; simp [eq_comm]
  simpa [hrange] using m.isSAGBIBasis_range_X (R := R)

end Main

end MonomialOrder
