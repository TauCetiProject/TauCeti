/-!
# Finite SAGBI bases of permutation-invariant polynomial algebras

Let `G ≤ Equiv.Perm σ` be a permutation group acting on `MvPolynomial σ R` by variable renaming
(in the given permutation coordinates), and let `m : MonomialOrder σ` be any monomial order. This
file completes the Reichstein / Thiéry–Thomassé characterization:
`TauCeti.MvPolynomial.permInvariants R G` has a finite `m`-SAGBI basis if and only if `G` is
generated by transpositions, equivalently `G` is the direct product of the full symmetric groups on
its orbits (`TauCeti.fiberSubgroup (Quotient.mk (MulAction.orbitRel G σ))`).

The positive direction (`MonomialOrder.exists_finite_isSAGBIBasis_permInvariants`, via the
elementary symmetric polynomials `TauCeti.MvPolynomial.orbitEsymm` of the variable orbits) is proved
in `TauCeti.RingTheory.MvPolynomial.PermInvariant.LeadingExponents`.
For the negative direction (over any nontrivial commutative semiring without zero divisors, hence
every field in every characteristic), a finite `m`-SAGBI basis forces the monoid
`m.maxOrbitExponents G` to be finitely generated. Embedding into `σ → ℚ`, the generated rational
pointed cone `C` is polyhedral by Minkowski–Weyl duality (`PointedCone.fg_iff_dualFG`), and its
`G`-translates cover the nonnegative orthant with disjoint interiors. Walking along a generic
rational segment from a point in `C` to a perturbation of its `g`-translate crosses bounding
hyperplanes and coordinate-equality hyperplanes one at a time, factoring `g` into transpositions in
`G`. As an immediate corollary, `alternatingGroup (Fin n)` admits no finite `m`-SAGBI basis for any
`n ≥ 3` and any monomial order `m`.

## Main results

* `MonomialOrder.fg_maxOrbitExponents_iff_closure_isSwap_eq`: `m.maxOrbitExponents G` is finitely
  generated if and only if `G` is generated by transpositions.
* `MonomialOrder.exists_finite_isSAGBIBasis_permInvariants_iff`: over any nontrivial commutative
  semiring without zero divisors, `permInvariants R G` admits a finite `m`-SAGBI basis if and only
  if `G` is generated by transpositions.
* `MonomialOrder.exists_finite_isSAGBIBasis_permInvariants_iff_eq_fiberSubgroup`:
  equivalently, if and only if `G = TauCeti.fiberSubgroup (Quotient.mk (MulAction.orbitRel G σ))`.
* `MonomialOrder.exists_finite_isSAGBIBasis_alternatingGroup_iff` and
  `MonomialOrder.not_exists_finite_isSAGBIBasis_alternatingGroup`: `alternatingGroup` admits a
  finite `m`-SAGBI basis if and only if the variable set has cardinality at most `2`.

## References

* L. Robbiano, M. Sweedler, *Subalgebra bases*, in *Commutative Algebra (Salvador, 1988)*,
  Lecture Notes in Mathematics 1430, Springer, 1990, 61–87.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
* M. Göbel, *A constructive description of SAGBI bases for polynomial invariants of permutation
  groups*, J. Symbolic Comput. **26** (1998).
* N. M. Thiéry, S. Thomassé, *Convex cones and SAGBI bases of permutation invariants*, in
  *Invariant Theory in All Characteristics*, CRM Proc. Lecture Notes 35, AMS, 2004.
-/

public section

open Equiv

namespace MonomialOrder

open MvPolynomial TauCeti.MvPolynomial

/-! ### Negative direction: rational polyhedral cone and hyperplane crossing -/

section Negative

variable {σ : Type*}

/-- The rational pointed cone generated by the image of `m.maxOrbitExponents G`. -/
private noncomputable def maxOrbitCone (m : MonomialOrder σ) (G : Subgroup (Perm σ)) :
    PointedCone ℚ (σ → ℚ) :=
  PointedCone.hull ℚ (TauCeti.ratEmbed '' (m.maxOrbitExponents G : Set (σ →₀ ℕ)))

private theorem fg_maxOrbitCone (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (hfg : (m.maxOrbitExponents G).FG) : (maxOrbitCone m G).FG := by
  classical
  rw [AddSubmonoid.fg_iff] at hfg
  obtain ⟨S, hS, hSfin⟩ := hfg
  have heq : maxOrbitCone m G = PointedCone.hull ℚ (TauCeti.ratEmbed '' S) := by
    refine le_antisymm ?_ (Submodule.span_mono fun _ ⟨a, ha, h⟩ =>
      ⟨a, hS ▸ AddSubmonoid.subset_closure ha, h⟩)
    rw [maxOrbitCone, PointedCone.hull, Submodule.span_le]
    rintro _ ⟨d, hd, rfl⟩
    rw [← hS] at hd
    induction hd using AddSubmonoid.closure_induction with
    | mem a ha => exact PointedCone.subset_hull ⟨a, ha, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add _ _ _ _ iha ihb => rw [map_add]; exact add_mem iha ihb
  exact heq ▸ Submodule.fg_span (hSfin.image TauCeti.ratEmbed)

/-- `m.maxOrbitExponents G` is saturated under positive scalar multiplication, so integer points in
`maxOrbitCone m G` lie in `m.maxOrbitExponents G`. -/
private theorem ratEmbed_mem_maxOrbitCone_iff (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (d : σ →₀ ℕ) :
    TauCeti.ratEmbed d ∈ maxOrbitCone m G ↔ d ∈ m.maxOrbitExponents G := by
  refine ⟨fun hd => ?_, fun hd => PointedCone.subset_hull ⟨d, hd, rfl⟩⟩
  obtain ⟨c, hc_supp, hc_nonneg, hc_sum⟩ := PointedCone.mem_hull_set.mp hd
  obtain ⟨N, k, hNpos, hk⟩ :=
    c.support.exists_nat_mul_eq_natCast fun y _ => hc_nonneg y
  choose a ha haeq using fun y (hy : y ∈ c.support) => hc_supp (Finset.mem_coe.mpr hy)
  let d' : σ →₀ ℕ := ∑ y ∈ c.support.attach, k y.val • a y.val y.property
  have hd'_mem : d' ∈ m.maxOrbitExponents G :=
    sum_mem fun y _ => nsmul_mem (ha y.val y.property) _
  have hNd : N • d = d' := by
    apply TauCeti.ratEmbed_injective
    have hcast : ∀ (n : ℕ) (v : σ → ℚ), n • v = (n : ℚ) • v := fun _ _ => funext fun _ => by simp
    rw [map_nsmul, hcast, ← hc_sum, Finsupp.sum, Finset.smul_sum, map_sum,
      ← Finset.sum_attach c.support]
    refine Finset.sum_congr rfl fun y _ => ?_
    rw [smul_smul, hk y.val y.property, map_nsmul, hcast, haeq y.val y.property]
  rw [mem_maxOrbitExponents_iff]
  intro g hg
  have h1 := (m.mem_maxOrbitExponents_iff G d').mp hd'_mem g hg
  rw [← hNd, Finsupp.mapDomain_smul, map_nsmul, map_nsmul] at h1
  exact le_of_not_gt fun hnot => not_lt_of_ge h1 (nsmul_lt_nsmul_right hNpos.ne' hnot)

/-- **Covering:** every nonnegative rational vector can be moved into `maxOrbitCone m G` by some
element of `G`. -/
private theorem exists_permAct_mem_maxOrbitCone [Finite σ] (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) {x : σ → ℚ} (hx : ∀ i, 0 ≤ x i) :
    ∃ g ∈ G, LinearEquiv.funCongrLeft ℚ ℚ g.symm x ∈ maxOrbitCone m G := by
  obtain ⟨D, d, hDpos, hDd⟩ := TauCeti.exists_nat_smul_eq_ratEmbed hx
  obtain ⟨_, hrel, hmax⟩ := m.exists_permOrbitRel_forall_toSyn_mapDomain_le G d
  obtain ⟨g₀, hg₀, rfl⟩ := permOrbitRel_iff.mp hrel
  refine ⟨g₀, hg₀, ?_⟩
  have heq : LinearEquiv.funCongrLeft ℚ ℚ g₀.symm x =
      (D : ℚ)⁻¹ • TauCeti.ratEmbed (d.mapDomain g₀) := by
    rw [TauCeti.ratEmbed_mapDomain]
    ext i
    simp [LinearMap.funLeft_apply, ← hDd, Nat.cast_ne_zero.mpr hDpos.ne']
  rw [heq]
  exact PointedCone.smul_mem _ (inv_nonneg.mpr (Nat.cast_nonneg D))
    ((ratEmbed_mem_maxOrbitCone_iff m G _).mpr ((m.mem_maxOrbitExponents_iff G _).mpr hmax))

/-- **Disjointness on non-fixed points:** if a nonnegative rational vector `x` and its `g`-translate
both lie in `maxOrbitCone m G` (`g ∈ G`), then `g` fixes `x`. -/
private theorem permAct_eq_self_of_mem_maxOrbitCone [Finite σ] (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) {x : σ → ℚ} (hx : ∀ i, 0 ≤ x i) {g : Perm σ} (hg : g ∈ G)
    (hxC : x ∈ maxOrbitCone m G)
    (hgxC : LinearEquiv.funCongrLeft ℚ ℚ g.symm x ∈ maxOrbitCone m G) :
    LinearEquiv.funCongrLeft ℚ ℚ g.symm x = x := by
  obtain ⟨D, d, hDpos, hDd⟩ := TauCeti.exists_nat_smul_eq_ratEmbed hx
  have hd_mem : d ∈ m.maxOrbitExponents G := by
    rw [← ratEmbed_mem_maxOrbitCone_iff, ← hDd]
    exact PointedCone.smul_mem _ (Nat.cast_nonneg D) hxC
  have hgx : (D : ℚ) • LinearEquiv.funCongrLeft ℚ ℚ g.symm x =
      TauCeti.ratEmbed (d.mapDomain g) := by
    rw [TauCeti.ratEmbed_mapDomain]
    ext i
    simp [LinearMap.funLeft_apply, ← hDd]
  have hgd_mem : d.mapDomain g ∈ m.maxOrbitExponents G := by
    rw [← ratEmbed_mem_maxOrbitCone_iff, ← hgx]
    exact PointedCone.smul_mem _ (Nat.cast_nonneg D) hgxC
  have hle2 : d ≼[m] d.mapDomain g := by
    have h := (m.mem_maxOrbitExponents_iff G _).mp hgd_mem g⁻¹ (G.inv_mem hg)
    rwa [← Finsupp.mapDomain_comp, ← Equiv.Perm.coe_mul, inv_mul_cancel, Equiv.Perm.coe_one,
      Finsupp.mapDomain_id] at h
  have hdeq : d.mapDomain g = d :=
    m.toSyn.injective (le_antisymm ((m.mem_maxOrbitExponents_iff G _).mp hd_mem g hg) hle2)
  have hscale : (D : ℚ) • LinearEquiv.funCongrLeft ℚ ℚ g.symm x = (D : ℚ) • x := by
    rw [hgx, hdeq, ← hDd]
  exact smul_right_injective (σ → ℚ) (Nat.cast_ne_zero.mpr hDpos.ne') hscale

/-- If two translates `g₁⁻¹ • x` and `g₂⁻¹ • x` (`g₁, g₂ ∈ G`) of a nonnegative vector `x` both
lie in `maxOrbitCone m G`, then `g₁ * g₂⁻¹` fixes `x`. -/
private theorem permAct_mul_inv_eq_self_of_mem_maxOrbitCone [Finite σ] (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) {x : σ → ℚ} (hx : ∀ i, 0 ≤ x i) {g₁ g₂ : Perm σ}
    (hg₁ : g₁ ∈ G) (hg₂ : g₂ ∈ G)
    (h1 : LinearEquiv.funCongrLeft ℚ ℚ g₁⁻¹.symm x ∈ maxOrbitCone m G)
    (h2 : LinearEquiv.funCongrLeft ℚ ℚ g₂⁻¹.symm x ∈ maxOrbitCone m G) :
    LinearEquiv.funCongrLeft ℚ ℚ (g₁ * g₂⁻¹).symm x = x := by
  have hx1_nonneg : ∀ i, 0 ≤ LinearEquiv.funCongrLeft ℚ ℚ g₁⁻¹.symm x i := fun _ => hx _
  have hcomp : LinearEquiv.funCongrLeft ℚ ℚ (g₂⁻¹ * g₁).symm
      (LinearEquiv.funCongrLeft ℚ ℚ g₁⁻¹.symm x) =
      LinearEquiv.funCongrLeft ℚ ℚ g₂⁻¹.symm x := by
    rw [← LinearEquiv.trans_apply, ← LinearEquiv.funCongrLeft_comp, ← Equiv.symm_trans,
      ← Equiv.Perm.mul_def, mul_assoc, mul_inv_cancel, mul_one]
  have hfix := permAct_eq_self_of_mem_maxOrbitCone m G hx1_nonneg
    (G.mul_mem (G.inv_mem hg₂) hg₁) h1 (hcomp ▸ h2)
  rw [hcomp] at hfix
  rw [Equiv.Perm.mul_def, Equiv.symm_trans, LinearEquiv.funCongrLeft_comp,
    LinearEquiv.trans_apply, hfix, Equiv.Perm.inv_def, Equiv.symm_symm,
    ← LinearEquiv.funCongrLeft_symm, LinearEquiv.symm_apply_apply]

/-- If the `h`-translate of the midpoint of `(a, b)` lies in `maxOrbitCone m G` and no wall
functional vanishes on `(a, b)`, then the `h`-translates of both endpoints lie in
`maxOrbitCone m G`. -/
private theorem mem_maxOrbitCone_endpoints_of_mid (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (F Φ : Finset (Module.Dual ℚ (σ → ℚ)))
    (hC_iff : ∀ x : σ → ℚ, x ∈ maxOrbitCone m G ↔ ∀ ℓ ∈ F, 0 ≤ ℓ x)
    (hwall : ∀ h ∈ G, ∀ ℓ ∈ F, ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm).toLinearMap ∈ Φ)
    {p₁ q₁ : σ → ℚ} {a mid b : ℚ} (ham : a < mid) (hmb : mid < b) {h : Perm σ} (hhG : h ∈ G)
    (hhC : LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm ((1 - mid) • p₁ + mid • q₁) ∈ maxOrbitCone m G)
    (hno : ∀ t ∈ Set.Ioo a b, ∀ φ ∈ Φ, φ ((1 - t) • p₁ + t • q₁) ≠ 0) :
    LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm ((1 - a) • p₁ + a • q₁) ∈ maxOrbitCone m G ∧
      LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm ((1 - b) • p₁ + b • q₁) ∈ maxOrbitCone m G := by
  have hpair : ∀ ℓ ∈ F,
      0 ≤ ℓ (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm ((1 - a) • p₁ + a • q₁)) ∧
      0 ≤ ℓ (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm ((1 - b) • p₁ + b • q₁)) := by
    intro ℓ hℓ
    let φ : Module.Dual ℚ (σ → ℚ) :=
      ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm).toLinearMap
    have hφ : φ ∈ Φ := hwall h hhG ℓ hℓ
    have hφ_eval : ∀ t : ℚ, φ ((1 - t) • p₁ + t • q₁) = AffineMap.lineMap (φ p₁) (φ q₁) t :=
      fun t => by
        rw [AffineMap.lineMap_apply_module, smul_eq_mul]
        simp only [map_add, map_smul, smul_eq_mul]
    have hfm : 0 < AffineMap.lineMap (φ p₁) (φ q₁) mid := by
      rw [← hφ_eval]
      exact lt_of_le_of_ne ((hC_iff _).mp hhC ℓ hℓ)
        (hno mid ⟨ham, hmb⟩ φ hφ).symm
    have hres := AffineMap.lineMap_nonneg_endpoints_of_pos_of_forall_ne_zero ham hmb hfm
      fun t ht => by rw [← hφ_eval]; exact hno t ht φ hφ
    have hcomp : ∀ x : σ → ℚ, ℓ (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm x) = φ x := fun _ => rfl
    rw [hcomp, hcomp, hφ_eval a, hφ_eval b]
    exact hres
  exact ⟨(hC_iff _).mpr fun ℓ hℓ => (hpair ℓ hℓ).left,
    (hC_iff _).mpr fun ℓ hℓ => (hpair ℓ hℓ).right⟩

/-- A vector avoiding every coordinate-difference functional `proj a - proj b` (`a ≠ b`) in `Φ`
is injective. -/
private theorem injective_of_forall_proj_sub_proj_ne_zero {Φ : Finset (Module.Dual ℚ (σ → ℚ))}
    {p : σ → ℚ}
    (heq_mem : ∀ a b : σ, a ≠ b →
      ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b) ∈ Φ)
    (hp_out : ∀ φ ∈ Φ, φ p ≠ 0) : Function.Injective p := fun a b hab => by
  by_contra hne
  exact hp_out _ (heq_mem a b hne) (by simp [hab])

/-- If two `G`-translates of a nonnegative injective vector `p` both lie in `maxOrbitCone m G`,
then the two group elements agree. -/
private theorem eq_of_permAct_mem_maxOrbitCone_of_injective [Finite σ] (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) {p : σ → ℚ} (hp_pos : ∀ i, 0 ≤ p i) (hp_inj : Function.Injective p)
    {g₁ g₂ : Perm σ} (hg₁ : g₁ ∈ G) (hg₂ : g₂ ∈ G)
    (h1 : LinearEquiv.funCongrLeft ℚ ℚ g₁⁻¹.symm p ∈ maxOrbitCone m G)
    (h2 : LinearEquiv.funCongrLeft ℚ ℚ g₂⁻¹.symm p ∈ maxOrbitCone m G) :
    g₁ = g₂ := by
  have hfix := permAct_mul_inv_eq_self_of_mem_maxOrbitCone m G hp_pos hg₁ hg₂ h1 h2
  have hfix' : p ∘ (g₁ * g₂⁻¹).symm = p :=
    funext fun i => by simpa [LinearMap.funLeft_apply] using congrFun hfix i
  have hmem : g₁ * g₂⁻¹ ∈ TauCeti.fiberSubgroup p :=
    TauCeti.comp_symm_eq_self_iff_mem_fiberSubgroup.mp hfix'
  rw [TauCeti.fiberSubgroup_eq_bot_of_injective hp_inj, Subgroup.mem_bot, mul_inv_eq_one] at hmem
  exact hmem

/-- Walking along a generic rational segment `(1 - t) • p₁ + t • q₁` between `p₁ ∈ C` and
`q₁ ∈ g • C` factors `g` as a product of transpositions in `G`. -/
private theorem mem_closure_isSwap_of_generic_segment [Finite σ] [DecidableEq σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (F Φ : Finset (Module.Dual ℚ (σ → ℚ)))
    (hC_iff : ∀ x : σ → ℚ, x ∈ maxOrbitCone m G ↔ ∀ ℓ ∈ F, 0 ≤ ℓ x)
    (hwall : ∀ h ∈ G, ∀ ℓ ∈ F, ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm).toLinearMap ∈ Φ)
    (heq_mem : ∀ a b : σ, a ≠ b →
      ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b) ∈ Φ)
    {g : Perm σ} (hg : g ∈ G) {p₁ q₁ : σ → ℚ}
    (hp₁_pos : ∀ i, 0 < p₁ i) (hq₁_pos : ∀ i, 0 < q₁ i)
    (hp₁C : p₁ ∈ maxOrbitCone m G)
    (hq₁_gC : LinearEquiv.funCongrLeft ℚ ℚ g⁻¹.symm q₁ ∈ maxOrbitCone m G)
    (hp₁_out : ∀ φ ∈ Φ, φ p₁ ≠ 0) (hq₁_out : ∀ φ ∈ Φ, φ q₁ ≠ 0)
    (hγ_uniq : ∀ (t : ℚ) {a b c d : σ}, a ≠ b → c ≠ d →
      ((1 - t) • p₁ + t • q₁) ∈ TauCeti.coordEq ℚ a b →
      ((1 - t) • p₁ + t • q₁) ∈ TauCeti.coordEq ℚ c d →
      TauCeti.coordEq ℚ a b = TauCeti.coordEq ℚ c d) :
    g ∈ Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} := by
  classical
  -- 1. Positivity along the segment `γ t = (1 - t) • p₁ + t • q₁` for `0 ≤ t ≤ 1`.
  let γ : ℚ → (σ → ℚ) := fun t => (1 - t) • p₁ + t • q₁
  have hγ_pos : ∀ t : ℚ, 0 ≤ t → t ≤ 1 → ∀ i, 0 < γ t i := fun t ht0 ht1 i => by
    simp only [γ, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    rcases eq_or_lt_of_le ht0 with rfl | ht0'
    · simpa using hp₁_pos i
    · have : 0 ≤ 1 - t := sub_nonneg.mpr ht1
      nlinarith [hp₁_pos i, hq₁_pos i]
  -- 2. Crossing nodes subdividing `[0, 1]` at the zeros of `Φ` along `γ`.
  obtain ⟨k, c, hc0, hclast, hc_bounds, hno_cross⟩ :=
    AffineMap.exists_orderEmbedding_fin_forall_lineMap_ne_zero Φ hp₁_out
  simp_rw [AffineMap.lineMap_apply_module] at hno_cross
  -- 3. Choose a group element `h j ∈ G` placing each subinterval midpoint into `maxOrbitCone m G`.
  let mid : Fin (k + 1) → ℚ := fun j => (c j.castSucc + c j.succ) / 2
  have hmid_Ioo : ∀ j : Fin (k + 1), mid j ∈ Set.Ioo (c j.castSucc) (c j.succ) := fun j => by
    have hlt : c j.castSucc < c j.succ := c.strictMono Fin.castSucc_lt_succ
    exact ⟨by simp only [mid]; linarith, by simp only [mid]; linarith⟩
  have hex : ∀ j : Fin (k + 1),
      ∃ h ∈ G, LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm (γ (mid j)) ∈ maxOrbitCone m G :=
    fun j => by
      have hm0 : 0 ≤ mid j := le_trans (hc_bounds j.castSucc).left (hmid_Ioo j).left.le
      have hm1 : mid j ≤ 1 := le_trans (hmid_Ioo j).right.le (hc_bounds j.succ).right
      obtain ⟨h', hh', hh'C⟩ := exists_permAct_mem_maxOrbitCone m G
        fun i => (hγ_pos (mid j) hm0 hm1 i).le
      exact ⟨h'⁻¹, G.inv_mem hh', by simpa only [inv_inv] using hh'C⟩
  choose h hhG hhC using hex
  -- 4. Extend cone membership from each midpoint to both endpoints of its subinterval.
  have hendpoints : ∀ j : Fin (k + 1),
      LinearEquiv.funCongrLeft ℚ ℚ (h j)⁻¹.symm (γ (c j.castSucc)) ∈ maxOrbitCone m G ∧
      LinearEquiv.funCongrLeft ℚ ℚ (h j)⁻¹.symm (γ (c j.succ)) ∈ maxOrbitCone m G :=
    fun j => mem_maxOrbitCone_endpoints_of_mid m G F Φ hC_iff hwall
      (hmid_Ioo j).left (hmid_Ioo j).right (hhG j) (hhC j) (hno_cross j)
  -- 5. Identify the first and last group elements as `1` and `g` via injectivity of `p₁` and `q₁`.
  have hh0 : h 0 = 1 := by
    have h0C : LinearEquiv.funCongrLeft ℚ ℚ (h 0)⁻¹.symm p₁ ∈ maxOrbitCone m G := by
      simpa [γ, hc0] using (hendpoints 0).left
    have h1C : LinearEquiv.funCongrLeft ℚ ℚ (1 : Perm σ)⁻¹.symm p₁ ∈ maxOrbitCone m G := by
      rwa [inv_one, Equiv.Perm.one_def, Equiv.refl_symm, LinearEquiv.funCongrLeft_id]
    exact (eq_of_permAct_mem_maxOrbitCone_of_injective m G (fun i => (hp₁_pos i).le)
      (injective_of_forall_proj_sub_proj_ne_zero heq_mem hp₁_out) G.one_mem (hhG 0) h1C h0C).symm
  have hhlast : h (Fin.last k) = g := by
    have hlastC : LinearEquiv.funCongrLeft ℚ ℚ (h (Fin.last k))⁻¹.symm q₁ ∈ maxOrbitCone m G := by
      simpa [γ, hclast] using (hendpoints (Fin.last k)).right
    exact (eq_of_permAct_mem_maxOrbitCone_of_injective m G (fun i => (hq₁_pos i).le)
      (injective_of_forall_proj_sub_proj_ne_zero heq_mem hq₁_out) hg (hhG (Fin.last k))
      hq₁_gC hlastC).symm
  -- 6. Adjacent transitions fix `γ (c j.succ)` (which has at most one pair of equal coordinates),
  -- hence are `1` or swaps.
  have hstep : ∀ j : Fin k,
      h j.castSucc * (h j.succ)⁻¹ ∈ Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} := fun j => by
    let t := c j.succ.castSucc
    have ht_nonneg : ∀ i, 0 ≤ γ t i :=
      fun _ => (hγ_pos t (hc_bounds _).left (hc_bounds _).right _).le
    have hfix := permAct_mul_inv_eq_self_of_mem_maxOrbitCone m G ht_nonneg
      (hhG j.castSucc) (hhG j.succ) (hendpoints j.castSucc).right (hendpoints j.succ).left
    have hfix' : γ t ∘ (h j.castSucc * (h j.succ)⁻¹).symm = γ t :=
      funext fun i => by simpa [LinearMap.funLeft_apply] using congrFun hfix i
    have hmem : h j.castSucc * (h j.succ)⁻¹ ∈ TauCeti.fiberSubgroup (γ t) :=
      TauCeti.comp_symm_eq_self_iff_mem_fiberSubgroup.mp hfix'
    rcases TauCeti.eq_one_or_isSwap_of_mem_fiberSubgroup (fun a b c' d' hab hcd h1 h2 =>
      TauCeti.eq_or_eq_of_coordEq_eq hcd (hγ_uniq t hab hcd
        ((TauCeti.mem_coordEq_iff a b _).mpr h1)
        ((TauCeti.mem_coordEq_iff c' d' _).mpr h2))) hmem with h1 | hswap
    · rw [h1]; exact one_mem _
    · exact Subgroup.subset_closure ⟨G.mul_mem (hhG j.castSucc) (G.inv_mem (hhG j.succ)), hswap⟩
  -- 7. Induct along the chain of subintervals to conclude `g ∈ closure {τ ∈ G | τ.IsSwap}`.
  have hall : ∀ j : Fin (k + 1), h j ∈ Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} := fun j =>
    Fin.induction (hh0.symm ▸ one_mem _) (fun j ih => by
      have hmul : h j.succ = (h j.castSucc * (h j.succ)⁻¹)⁻¹ * h j.castSucc := by group
      exact hmul ▸ Subgroup.mul_mem _ (Subgroup.inv_mem _ (hstep j)) ih) j
  exact hhlast ▸ hall (Fin.last k)

/-- The union of `G`-translates of `F` and coordinate-difference functionals is stable under
precomposition by `h ∈ G`. -/
private theorem wallFuncs_union_eqFuncs_comp_mem (G : Subgroup (Perm σ))
    (F : Finset (Module.Dual ℚ (σ → ℚ))) (eqFuncs Φ : Finset (Module.Dual ℚ (σ → ℚ)))
    (hwall : ∀ h ∈ G, ∀ ℓ ∈ F,
      ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm).toLinearMap ∈ Φ)
    (heq_mem : ∀ a b : σ, a ≠ b →
      ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b) ∈ eqFuncs)
    (heq_sub : eqFuncs ⊆ Φ)
    (hΦ_def : ∀ φ ∈ Φ,
      (∃ (k : Perm σ) (_ : k ∈ G) (ℓ : Module.Dual ℚ (σ → ℚ)) (_ : ℓ ∈ F),
        φ = ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ k⁻¹.symm).toLinearMap) ∨
      (∃ a b : σ, a ≠ b ∧
        φ = (LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b))
    {h : Perm σ} (hh : h ∈ G) {φ : Module.Dual ℚ (σ → ℚ)} (hφ : φ ∈ Φ) :
    φ.comp (LinearEquiv.funCongrLeft ℚ ℚ h.symm).toLinearMap ∈ Φ := by
  rcases hΦ_def φ hφ with ⟨k, hk, ℓ, hℓ, rfl⟩ | ⟨a, b, hab, rfl⟩
  · have hcomp :
        (ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ k⁻¹.symm).toLinearMap).comp
          (LinearEquiv.funCongrLeft ℚ ℚ h.symm).toLinearMap =
        ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ ((h⁻¹ * k)⁻¹.symm)).toLinearMap := by
      rw [LinearMap.comp_assoc]
      refine congrArg (LinearMap.comp ℓ) (LinearMap.ext fun w => ?_)
      simp only [LinearMap.comp_apply, LinearEquiv.coe_toLinearMap]
      rw [← LinearEquiv.trans_apply, ← LinearEquiv.funCongrLeft_comp, mul_inv_rev, inv_inv,
        Equiv.Perm.mul_def, Equiv.symm_trans]
    rw [hcomp]
    exact hwall _ (G.mul_mem (G.inv_mem hh) hk) ℓ hℓ
  · have hsub : ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b).comp
        (LinearEquiv.funCongrLeft ℚ ℚ h.symm).toLinearMap =
        (LinearMap.proj (h.symm a) : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj (h.symm b) := by
      ext w
      simp [LinearMap.funLeft_apply]
    rw [hsub]
    exact heq_sub (heq_mem (h.symm a) (h.symm b) (h.symm.injective.ne hab))

/-- Build the finite family of wall functionals and coordinate-equality functionals, and choose a
generic positive basepoint `p₁ ∈ maxOrbitCone m G` avoiding all their kernels. -/
private theorem exists_hyperplane_system_and_basepoint [Finite σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (F : Finset (Module.Dual ℚ (σ → ℚ)))
    (hF_ne_zero : ∀ ℓ ∈ F, ℓ ≠ 0) :
    ∃ (Φ eqFuncs : Finset (Module.Dual ℚ (σ → ℚ))) (p₁ : σ → ℚ),
      (∀ h ∈ G, ∀ ℓ ∈ F,
        ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm).toLinearMap ∈ Φ) ∧
      (∀ a b : σ, a ≠ b →
        ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b) ∈ eqFuncs) ∧
      eqFuncs ⊆ Φ ∧
      (∀ φ ∈ Φ, φ ≠ 0) ∧
      (∀ i, 0 < p₁ i) ∧
      p₁ ∈ maxOrbitCone m G ∧
      (∀ φ ∈ Φ, φ p₁ ≠ 0) := by
  classical
  cases nonempty_fintype σ
  let _ : Fintype G := Fintype.ofFinite G
  -- 1. Assemble wall functionals `wallFuncs` and coordinate-difference functionals `eqFuncs`.
  let wallFuncs : Finset (Module.Dual ℚ (σ → ℚ)) :=
    (Finset.univ ×ˢ F).image fun p : G × Module.Dual ℚ (σ → ℚ) =>
      p.snd.comp (LinearEquiv.funCongrLeft ℚ ℚ (p.fst : Perm σ)⁻¹.symm).toLinearMap
  let eqFuncs : Finset (Module.Dual ℚ (σ → ℚ)) :=
    ((Finset.univ : Finset (σ × σ)).filter fun p => p.fst ≠ p.snd).image fun p =>
      (LinearMap.proj p.fst : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj p.snd
  let Φ : Finset (Module.Dual ℚ (σ → ℚ)) := wallFuncs ∪ eqFuncs
  have hwall : ∀ h ∈ G, ∀ ℓ ∈ F,
      ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm).toLinearMap ∈ Φ := fun h hh ℓ hℓ =>
    Finset.mem_union_left _ (Finset.mem_image.mpr
      ⟨(⟨h, hh⟩, ℓ), Finset.mem_product.mpr ⟨Finset.mem_univ _, hℓ⟩, rfl⟩)
  have heq_mem : ∀ a b : σ, a ≠ b →
      ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b) ∈ eqFuncs := fun a b hab =>
    Finset.mem_image.mpr ⟨(a, b), Finset.mem_filter.mpr ⟨Finset.mem_univ _, hab⟩, rfl⟩
  have heq_sub : eqFuncs ⊆ Φ := Finset.subset_union_right
  -- 2. Verify every functional in `Φ` is nonzero and `Φ` is stable under `G`.
  have hΦ_ne_zero : ∀ φ ∈ Φ, φ ≠ 0 := fun φ hφ => by
    rcases Finset.mem_union.mp hφ with hw | he
    · obtain ⟨⟨h, ℓ⟩, hp, rfl⟩ := Finset.mem_image.mp hw
      intro h0
      apply hF_ne_zero ℓ (Finset.mem_product.mp hp).right
      refine LinearMap.ext fun w => ?_
      have hw0 : (ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ (h : Perm σ)⁻¹.symm).toLinearMap)
          (LinearEquiv.funCongrLeft ℚ ℚ (h : Perm σ).symm w) = 0 :=
        LinearMap.congr_fun h0 _
      rwa [LinearMap.comp_apply, LinearEquiv.coe_toLinearMap, Equiv.Perm.inv_def,
        ← LinearEquiv.funCongrLeft_symm, LinearEquiv.symm_apply_apply] at hw0
    · obtain ⟨⟨a, b⟩, hp, rfl⟩ := Finset.mem_image.mp he
      intro h0
      have := LinearMap.congr_fun h0 (Pi.single a (1 : ℚ))
      simp [Pi.single_eq_of_ne (Finset.mem_filter.mp hp).right.symm] at this
  let ℋ : Finset (Submodule ℚ (σ → ℚ)) := Φ.image LinearMap.ker
  have hℋ_ne_top : ∀ H ∈ ℋ, H ≠ ⊤ := fun H hH => by
    obtain ⟨φ, hφ, rfl⟩ := Finset.mem_image.mp hH
    exact fun htop => hΦ_ne_zero φ hφ (LinearMap.ker_eq_top.mp htop)
  have hΦ_def : ∀ φ ∈ Φ,
      (∃ (k : Perm σ) (_ : k ∈ G) (ℓ : Module.Dual ℚ (σ → ℚ)) (_ : ℓ ∈ F),
        φ = ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ k⁻¹.symm).toLinearMap) ∨
      (∃ a b : σ, a ≠ b ∧
        φ = (LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b) := fun φ hφ => by
    rcases Finset.mem_union.mp hφ with hw | he
    · obtain ⟨⟨k, ℓ⟩, hp, rfl⟩ := Finset.mem_image.mp hw
      exact Or.inl ⟨k, k.property, ℓ, (Finset.mem_product.mp hp).right, rfl⟩
    · obtain ⟨⟨a, b⟩, hp, rfl⟩ := Finset.mem_image.mp he
      exact Or.inr ⟨a, b, (Finset.mem_filter.mp hp).right, rfl⟩
  -- 3. Perturb `(1, ..., 1)` away from `ℋ`, then move into `maxOrbitCone m G`.
  obtain ⟨p₀, hp₀_pos, hp₀_out⟩ := TauCeti.exists_forall_pos_and_forall_notMem
    (fun _ : σ => (1 : ℚ)) (Finset.univ.image fun i : σ => (LinearMap.proj i : (σ → ℚ) →ₗ[ℚ] ℚ))
    (fun φ hφ => by obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hφ; exact zero_lt_one)
    ℋ hℋ_ne_top
  obtain ⟨h₀, hh₀G, hp₁C⟩ := exists_permAct_mem_maxOrbitCone m G fun i =>
    (hp₀_pos (LinearMap.proj i) (Finset.mem_image_of_mem _ (Finset.mem_univ i))).le
  let p₁ : σ → ℚ := LinearEquiv.funCongrLeft ℚ ℚ h₀.symm p₀
  refine ⟨Φ, eqFuncs, p₁, hwall, heq_mem, heq_sub, hΦ_ne_zero, fun i => ?_, hp₁C, fun φ hφ h0 => ?_⟩
  · have h := hp₀_pos (LinearMap.proj (h₀.symm i)) (Finset.mem_image_of_mem _ (Finset.mem_univ _))
    rwa [LinearMap.proj_apply] at h
  · have h0' : (φ.comp (LinearEquiv.funCongrLeft ℚ ℚ h₀.symm).toLinearMap) p₀ = 0 := by
      rwa [LinearMap.comp_apply, LinearEquiv.coe_toLinearMap]
    exact hp₀_out _ (Finset.mem_image_of_mem _
      (wallFuncs_union_eqFuncs_comp_mem G F eqFuncs Φ hwall heq_mem heq_sub hΦ_def hh₀G hφ))
      (LinearMap.mem_ker.mpr h0')

/-- Every hyperplane `ker φ` (`φ ∈ Φ`) and every span-plus-codimension-2 subspace
`span {p₁} ⊔ (ker φ₁ ⊓ ker φ₂)` (`ker φ₁ ≠ ker φ₂`) is a proper subspace when `p₁` avoids `Φ`. -/
private theorem hyperplane_or_pair_ne_top
    {Φ eqFuncs : Finset (Module.Dual ℚ (σ → ℚ))}
    (heq_sub : eqFuncs ⊆ Φ) (hΦ_ne_zero : ∀ φ ∈ Φ, φ ≠ 0)
    {p₁ : σ → ℚ} (hp₁_out : ∀ φ ∈ Φ, φ p₁ ≠ 0) :
    ∀ K ∈ (Φ.image LinearMap.ker) ∪
      (((eqFuncs.image LinearMap.ker ×ˢ eqFuncs.image LinearMap.ker).filter
          fun P => P.fst ≠ P.snd).image fun P =>
        Submodule.span ℚ {p₁} ⊔ (P.fst ⊓ P.snd)), K ≠ ⊤ := by
  classical
  intro K hK
  rcases Finset.mem_union.mp hK with h1 | h2
  · obtain ⟨φ, hφ, rfl⟩ := Finset.mem_image.mp h1
    exact fun htop => hΦ_ne_zero φ hφ (LinearMap.ker_eq_top.mp htop)
  · obtain ⟨⟨H₁, H₂⟩, hP, rfl⟩ := Finset.mem_image.mp h2
    obtain ⟨h12, hne⟩ := Finset.mem_filter.mp hP
    obtain ⟨φ₁, hφ₁, rfl⟩ := Finset.mem_image.mp (Finset.mem_product.mp h12).left
    obtain ⟨φ₂, hφ₂, rfl⟩ := Finset.mem_image.mp (Finset.mem_product.mp h12).right
    exact Module.Dual.span_sup_inf_ker_ne_top hne
      (LinearMap.mem_ker.not.mpr (hp₁_out φ₁ (heq_sub hφ₁)))
      (LinearMap.mem_ker.not.mpr (hp₁_out φ₂ (heq_sub hφ₂)))

/-- Perturb `g • p₁` into a point `q₁ ∈ g • C` whose segment to `p₁` meets at most one
coordinate-equality hyperplane at a time. -/
private theorem exists_generic_endpoint [Finite σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (F Φ eqFuncs : Finset (Module.Dual ℚ (σ → ℚ)))
    (hC_iff : ∀ x : σ → ℚ, x ∈ maxOrbitCone m G ↔ ∀ ℓ ∈ F, 0 ≤ ℓ x)
    (hwall : ∀ h ∈ G, ∀ ℓ ∈ F, ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ h⁻¹.symm).toLinearMap ∈ Φ)
    (heq_mem : ∀ a b : σ, a ≠ b →
      ((LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b) ∈ eqFuncs)
    (heq_sub : eqFuncs ⊆ Φ) (hΦ_ne_zero : ∀ φ ∈ Φ, φ ≠ 0)
    {p₁ : σ → ℚ} (hp₁_pos : ∀ i, 0 < p₁ i) (hp₁C : p₁ ∈ maxOrbitCone m G)
    (hp₁_out : ∀ φ ∈ Φ, φ p₁ ≠ 0) (g : Perm σ) :
    ∃ q₁ : σ → ℚ,
      (∀ i, 0 < q₁ i) ∧
      LinearEquiv.funCongrLeft ℚ ℚ g⁻¹.symm q₁ ∈ maxOrbitCone m G ∧
      (∀ φ ∈ Φ, φ q₁ ≠ 0) ∧
      ∀ (t : ℚ) {a b c d : σ}, a ≠ b → c ≠ d →
        ((1 - t) • p₁ + t • q₁) ∈ TauCeti.coordEq ℚ a b →
        ((1 - t) • p₁ + t • q₁) ∈ TauCeti.coordEq ℚ c d →
        TauCeti.coordEq ℚ a b = TauCeti.coordEq ℚ c d := by
  classical
  cases nonempty_fintype σ
  -- 1. Assemble the obstacle subspaces `ℬ` (hyperplanes in `Φ` and pairwise intersections
  -- spanned with `p₁`).
  let q₀ : σ → ℚ := LinearEquiv.funCongrLeft ℚ ℚ g.symm p₁
  let ℋ : Finset (Submodule ℚ (σ → ℚ)) := Φ.image LinearMap.ker
  let eqSubs : Finset (Submodule ℚ (σ → ℚ)) := eqFuncs.image LinearMap.ker
  let pairSubs : Finset (Submodule ℚ (σ → ℚ)) :=
    ((eqSubs ×ˢ eqSubs).filter fun P => P.fst ≠ P.snd).image fun P =>
      Submodule.span ℚ {p₁} ⊔ (P.fst ⊓ P.snd)
  let ℬ : Finset (Submodule ℚ (σ → ℚ)) := ℋ ∪ pairSubs
  have hℬ_ne_top : ∀ K ∈ ℬ, K ≠ ⊤ :=
    hyperplane_or_pair_ne_top heq_sub hΦ_ne_zero hp₁_out
  -- 2. Verify strict positivity of the coordinate and `g`-translated cone functionals at `q₀`.
  let Lpos : Finset (Module.Dual ℚ (σ → ℚ)) :=
    (Finset.univ.image fun i : σ => (LinearMap.proj i : (σ → ℚ) →ₗ[ℚ] ℚ)) ∪
    (F.image fun ℓ => ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ g⁻¹.symm).toLinearMap)
  have hLpos : ∀ φ ∈ Lpos, 0 < φ q₀ := fun φ hφ => by
    rcases Finset.mem_union.mp hφ with h1 | h2
    · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp h1
      simpa only [LinearMap.proj_apply, q₀, LinearEquiv.funCongrLeft_apply,
        LinearMap.funLeft_apply] using hp₁_pos (g.symm i)
    · obtain ⟨ℓ, hℓ, rfl⟩ := Finset.mem_image.mp h2
      have hval : (ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ g⁻¹.symm).toLinearMap) q₀ = ℓ p₁ := by
        rw [LinearMap.comp_apply, LinearEquiv.coe_toLinearMap]
        dsimp only [q₀]
        rw [Equiv.Perm.inv_def, ← LinearEquiv.funCongrLeft_symm, LinearEquiv.symm_apply_apply]
      rw [hval]
      have hne : ℓ p₁ ≠ 0 := by
        have hcomp : ℓ = ℓ.comp (LinearEquiv.funCongrLeft ℚ ℚ (1 : Perm σ)⁻¹.symm).toLinearMap := by
          rw [inv_one, Equiv.Perm.one_def, Equiv.refl_symm, LinearEquiv.funCongrLeft_id,
            LinearEquiv.refl_toLinearMap, LinearMap.comp_id]
        exact hcomp ▸ hp₁_out _ (hwall 1 G.one_mem ℓ hℓ)
      exact lt_of_le_of_ne ((hC_iff p₁).mp hp₁C ℓ hℓ) hne.symm
  -- 3. Perturb `q₀` to `q₁` preserving `Lpos` and avoiding `ℬ`.
  obtain ⟨q₁, hq₁_L, hq₁_ℬ⟩ := TauCeti.exists_forall_pos_and_forall_notMem q₀ Lpos hLpos ℬ hℬ_ne_top
  refine ⟨q₁,
    fun i => hq₁_L _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ i))),
    (hC_iff _).mpr fun ℓ hℓ =>
      (hq₁_L _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hℓ))).le,
    fun φ hφ h0 => hq₁_ℬ _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hφ))
      (LinearMap.mem_ker.mpr h0),
    fun t {a b c d} hab hcd h1 h2 => ?_⟩
  -- 4. Deduce uniqueness of any coordinate-equality hyperplane met along the segment `[p₁, q₁]`.
  simp_rw [TauCeti.coordEq_eq_ker] at h1 h2 ⊢
  let φ₁ : Module.Dual ℚ (σ → ℚ) := (LinearMap.proj a : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj b
  let φ₂ : Module.Dual ℚ (σ → ℚ) := (LinearMap.proj c : (σ → ℚ) →ₗ[ℚ] ℚ) - LinearMap.proj d
  by_contra hne
  rcases eq_or_ne t 0 with rfl | ht0
  · exact hp₁_out φ₁ (heq_sub (heq_mem a b hab)) (by simpa [φ₁] using LinearMap.mem_ker.mp h1)
  · have hdecomp : q₁ = (-(1 - t) / t) • p₁ + t⁻¹ • ((1 - t) • p₁ + t • q₁) := by
      ext i; simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]; field_simp [ht0]; ring
    have hmem : q₁ ∈ Submodule.span ℚ {p₁} ⊔ (LinearMap.ker φ₁ ⊓ LinearMap.ker φ₂) :=
      hdecomp ▸ Submodule.add_mem_sup (Submodule.smul_mem _ _ (Submodule.subset_span rfl))
        ((LinearMap.ker φ₁ ⊓ LinearMap.ker φ₂).smul_mem t⁻¹ (Submodule.mem_inf.mpr ⟨h1, h2⟩))
    exact hq₁_ℬ _ (Finset.mem_union_right _ (Finset.mem_image.mpr
      ⟨(LinearMap.ker φ₁, LinearMap.ker φ₂), Finset.mem_filter.mpr
        ⟨Finset.mem_product.mpr ⟨Finset.mem_image_of_mem _ (heq_mem a b hab),
          Finset.mem_image_of_mem _ (heq_mem c d hcd)⟩, hne⟩, rfl⟩)) hmem

/-- **Negative direction of the permutation SAGBI criterion (Reichstein / Thiéry–Thomassé):**
if `m.maxOrbitExponents G` is finitely generated on a finite type `σ`, then `G` is generated by
transpositions. -/
private theorem closure_isSwap_eq_of_fg_maxOrbitExponents [Finite σ] [DecidableEq σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ)) (hfg : (m.maxOrbitExponents G).FG) :
    Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G := by
  classical
  obtain ⟨F₀, hF₀⟩ := PointedCone.fg_iff_dualFG.mp (fg_maxOrbitCone m G hfg)
  let F : Finset (Module.Dual ℚ (σ → ℚ)) := F₀.filter (· ≠ 0)
  have hC_iff : ∀ x : σ → ℚ, x ∈ maxOrbitCone m G ↔ ∀ ℓ ∈ F, 0 ≤ ℓ x := fun x => by
    rw [← hF₀, PointedCone.mem_dual]
    exact ⟨fun hx ℓ hℓ => hx (Finset.mem_filter.mp hℓ).left, fun hx ℓ hℓ => by
      rcases eq_or_ne ℓ 0 with rfl | hℓ0; · simp
      exact hx ℓ (Finset.mem_filter.mpr ⟨hℓ, hℓ0⟩)⟩
  obtain ⟨Φ, eqFuncs, p₁, hwall, heq_mem, heq_sub, hΦ_ne_zero, hp₁_pos, hp₁C, hp₁_out⟩ :=
    exists_hyperplane_system_and_basepoint m G F fun _ hℓ => (Finset.mem_filter.mp hℓ).right
  refine le_antisymm ((Subgroup.closure_le G).2 fun _ h => h.left) fun g hg => ?_
  obtain ⟨q₁, hq₁_pos, hq₁_gC, hq₁_out, hγ_uniq⟩ := exists_generic_endpoint m G F Φ eqFuncs
    hC_iff hwall heq_mem heq_sub hΦ_ne_zero hp₁_pos hp₁C hp₁_out g
  exact mem_closure_isSwap_of_generic_segment m G F Φ hC_iff hwall
    (fun a b hab => heq_sub (heq_mem a b hab))
    hg hp₁_pos hq₁_pos hp₁C hq₁_gC hp₁_out hq₁_out hγ_uniq

end Negative

/-! ### Main equivalence theorems and alternating-group corollaries -/

section Main

variable {σ R : Type*}

/-- **Leading-exponent monoid characterization (Reichstein / Thiéry–Thomassé):** for a finite type
`σ`, a permutation subgroup `G ≤ Equiv.Perm σ`, and any monomial order `m`, the monoid
`m.maxOrbitExponents G` of `m`-maximal orbit exponents is finitely generated if and only if `G` is
generated by transpositions. -/
theorem fg_maxOrbitExponents_iff_closure_isSwap_eq [Finite σ] [DecidableEq σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ)) :
    (m.maxOrbitExponents G).FG ↔ Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G :=
  ⟨closure_isSwap_eq_of_fg_maxOrbitExponents m G, fun hG => by
    rw [← m.leadingExponents_permInvariants_eq G ℚ]
    obtain ⟨B, hBfin, hB⟩ := m.exists_finite_isSAGBIBasis_permInvariants ℚ
      fun _ _ h => G.swap_mem_of_orbitRel_of_closure_isSwap_eq hG (MulAction.mem_orbit_symm.1 h)
    exact m.fg_leadingExponents_of_finite_isSAGBIBasis hBfin hB⟩

/-- **Finite SAGBI criterion for permutation-invariant polynomial algebras (Reichstein /
Thiéry–Thomassé):** over any nontrivial commutative semiring `R` without zero divisors (in
particular, over any field in any characteristic) and for any monomial order `m`, the
`G`-invariant subalgebra `TauCeti.MvPolynomial.permInvariants R G` has a finite `m`-SAGBI basis
if and only if `G` is generated by transpositions. -/
theorem exists_finite_isSAGBIBasis_permInvariants_iff [Finite σ] [DecidableEq σ]
    (m : MonomialOrder σ) (G : Subgroup (Perm σ)) (R : Type*)
    [CommSemiring R] [NoZeroDivisors R] [Nontrivial R] :
    (∃ B : Set (MvPolynomial σ R), B.Finite ∧
        m.IsSAGBIBasis B (permInvariants R G)) ↔
      Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G :=
  ⟨fun ⟨_, hBfin, hB⟩ => (m.fg_maxOrbitExponents_iff_closure_isSwap_eq G).mp
      (m.leadingExponents_permInvariants_eq G R ▸
        m.fg_leadingExponents_of_finite_isSAGBIBasis hBfin hB),
    fun hG => m.exists_finite_isSAGBIBasis_permInvariants R
      fun _ _ h => G.swap_mem_of_orbitRel_of_closure_isSwap_eq hG (MulAction.mem_orbit_symm.1 h)⟩

/-- **Product-of-symmetric-groups form of the permutation SAGBI criterion:**
`permInvariants R G` has a finite `m`-SAGBI basis if and only if `G` equals the fiber
subgroup of its orbit quotient map (the product of the full symmetric groups on its orbits). -/
theorem exists_finite_isSAGBIBasis_permInvariants_iff_eq_fiberSubgroup
    [Finite σ] (m : MonomialOrder σ) (G : Subgroup (Perm σ)) (R : Type*)
    [CommSemiring R] [NoZeroDivisors R] [Nontrivial R] :
    (∃ B : Set (MvPolynomial σ R), B.Finite ∧
        m.IsSAGBIBasis B (permInvariants R G)) ↔
      G = TauCeti.fiberSubgroup (Quotient.mk (MulAction.orbitRel G σ)) := by
  classical
  rw [m.exists_finite_isSAGBIBasis_permInvariants_iff G R,
    G.closure_isSwap_eq_iff_eq_fiberSubgroup_orbitRel]

/-- **Alternating-group SAGBI characterization:** over any nontrivial commutative semiring `R`
without zero divisors and for any monomial order `m`, the alternating invariant subalgebra
`permInvariants R (alternatingGroup σ)` admits a finite `m`-SAGBI basis if and only if
`Fintype.card σ ≤ 2`. -/
theorem exists_finite_isSAGBIBasis_alternatingGroup_iff [Fintype σ] [DecidableEq σ]
    (m : MonomialOrder σ) (R : Type*) [CommSemiring R] [NoZeroDivisors R] [Nontrivial R] :
    (∃ B : Set (MvPolynomial σ R), B.Finite ∧
        m.IsSAGBIBasis B (permInvariants R (alternatingGroup σ))) ↔
      Fintype.card σ ≤ 2 := by
  rw [m.exists_finite_isSAGBIBasis_permInvariants_iff,
    TauCeti.closure_isSwap_alternatingGroup_eq_iff]

/-- **Nonfinite SAGBI for alternating groups (`n ≥ 3`):** for every `n ≥ 3`, every monomial order
`m`, and every nontrivial commutative semiring `R` without zero divisors (in particular every field
in every characteristic), `permInvariants R (alternatingGroup (Fin n))` admits no finite
`m`-SAGBI basis. -/
theorem not_exists_finite_isSAGBIBasis_alternatingGroup {n : ℕ} (hn : 3 ≤ n)
    (m : MonomialOrder (Fin n)) (R : Type*) [CommSemiring R] [NoZeroDivisors R] [Nontrivial R] :
    ¬ ∃ B : Set (MvPolynomial (Fin n) R), B.Finite ∧
        m.IsSAGBIBasis B (permInvariants R (alternatingGroup (Fin n))) := by
  rw [m.exists_finite_isSAGBIBasis_alternatingGroup_iff, Fintype.card_fin]
  omega

/-- For `n = 1`, `{X 0}` is a singleton `m`-SAGBI basis of
`permInvariants R (alternatingGroup (Fin 1))` for every monomial order `m`. -/
theorem isSAGBIBasis_singleton_X_zero_alternatingGroup_one (m : MonomialOrder (Fin 1))
    (R : Type*) [CommSemiring R] :
    m.IsSAGBIBasis {(X (0 : Fin 1) : MvPolynomial (Fin 1) R)}
      (permInvariants R (alternatingGroup (Fin 1))) := by
  have hbot : alternatingGroup (Fin 1) = ⊥ := TauCeti.alternatingGroup_eq_bot_iff.mpr (by simp)
  rw [hbot, permInvariants_bot]
  have hrange : Set.range (X : Fin 1 → MvPolynomial (Fin 1) R) = {X 0} := by
    ext p; simp [eq_comm]
  simpa [hrange] using m.isSAGBIBasis_range_X (R := R)

end Main

end MonomialOrder
