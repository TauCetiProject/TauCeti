public import TauCeti.RingTheory.MvPolynomial.PermInvariant.BlockEsymm
import Mathlib.Data.Finset.Sort
import Mathlib.Geometry.Convex.Cone.Dual
import TauCeti.Algebra.Order.Field.Basic
