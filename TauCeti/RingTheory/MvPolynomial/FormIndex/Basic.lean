/-!
# The index of a polynomial along linear forms

Let the variables `X (h, i)` of a polynomial ring be split into blocks indexed by `h : κ`, each
block carrying the coordinates `i : ι`, and fix in every block a linear form
`M h (X h) = ∑ i, M h i • X (h, i)` and a degree `d h`. The ideal `MvPolynomial.formIdeal t d M` is
generated by the products `∏ h, M h (X h) ^ j h` with `t ≤ ∑ h, j h / d h`, and the index of `P`
along the forms, `MvPolynomial.formIndex d M P`, is the supremum of the `t` with `P` in it. It
measures to which weighted order `P` vanishes along the product of the hyperplanes
`M h (x h) = 0`, and is the index along linear forms of the multihomogeneous form of Roth's method
in the proof of the Subspace Theorem. The quotients `j h / d h` are taken in `ℝ≥0∞`, so a block
of degree `0` makes every positive power of its form infinitely expensive.

Over a field, choose in every block a coordinate `i₀ h` at which `M h` does not vanish. The
substitution `MvPolynomial.substForm M i₀` puts the form `M h (X h)` in place of `X (h, i₀ h)` and
fixes the other variables; its inverse is `MvPolynomial.substFormInv M i₀`. In the new
coordinates every form is a variable, the ideal becomes a monomial ideal, and the index is the
least value of `∑ h, n (h, i₀ h) / d h` over the monomials `n` of `substFormInv M i₀ P`. This
gives the index the behaviour of an order of vanishing: it is attained, with positive degrees it
is infinite only at `0`, it is at least the smaller index of two summands, and it is additive on
products, by `MvPolynomial.iInf_support_weight_mul`.

## Main definitions

* `MvPolynomial.formIdeal t d M`: the ideal of polynomials of index at least `t` along `M`.
* `MvPolynomial.formIndex d M P`: the index of `P` along `M`, in `ℝ≥0∞`.
* `MvPolynomial.substForm M i₀`, `MvPolynomial.substFormInv M i₀`: the mutually inverse
  substitutions `X (h, i₀ h) ↦ M h (X h)` and back.

## Main results

* `MvPolynomial.formIdeal_eq_map_substForm`: the ideal along the forms is the image of a monomial
  ideal under `substForm`.
* `MvPolynomial.mem_formIdeal_iff`, `MvPolynomial.formIndex_eq_iInf`: the ideal and the index in
  the coordinates of `substFormInv`.
* `MvPolynomial.mem_formIdeal_iff_le_formIndex`: the supremum defining the index is attained.
* `MvPolynomial.formIndex_prod_pow`: the index of `∏ h, M h (X h) ^ j h` is `∑ h, j h / d h`.
* `MvPolynomial.formIndex_eq_top_iff`, `MvPolynomial.min_formIndex_le_add`,
  `MvPolynomial.formIndex_mul`, `MvPolynomial.formIndex_pow`, `MvPolynomial.formIndex_smul`,
  `MvPolynomial.formIndex_smul_form`: the index is a valuation and invariant under unit scaling of
  each block's form.
* `MvPolynomial.IsMultiHomogeneous.substForm`, `MvPolynomial.IsMultiHomogeneous.substFormInv`:
  both coordinate substitutions preserve multihomogeneity.

## References

* E. Bombieri and W. Gubler, *Heights in Diophantine Geometry*, Cambridge University Press
  (2006), Definition 7.5.17 and 7.5.18.
* Ralf Stephan, `DiophantineApproximation/GeneralizedRothLemma.lean` in `rwst/Subspace-Theorems`,
  commit `09835cb23557ae5ae0cf55a9c4ab9055f5d60338` (Apache 2.0).
-/

public section

namespace MvPolynomial

open Finset
open scoped ENNReal

variable {R K κ ι : Type*}

section Substitution

variable [Fintype ι] [DecidableEq ι]

section CommSemiring

variable [CommSemiring R] {M : κ → ι → R} {i₀ : κ → ι}

/-- The substitution putting the linear form `M h (X h) = ∑ i, M h i • X (h, i)` in place of the
variable `X (h, i₀ h)` of every block and fixing the other variables. -/
noncomputable def substForm (M : κ → ι → R) (i₀ : κ → ι) :
    MvPolynomial (κ × ι) R →ₐ[R] MvPolynomial (κ × ι) R :=
  aeval fun p ↦ if p.2 = i₀ p.1 then ∑ i, C (M p.1 i) * X (p.1, i) else X p

@[simp]
theorem substForm_X_self (h : κ) :
    substForm M i₀ (X (h, i₀ h)) = ∑ i, C (M h i) * X (h, i) := by
  simp [substForm]

@[simp]
theorem substForm_X_of_ne {h : κ} {i : ι} (hi : i ≠ i₀ h) :
    substForm M i₀ (X (h, i)) = X (h, i) := by
  simp [substForm, hi]

/-- A map fixing the variables `X (h, i)` with `i ≠ i₀ h` fixes the part of the form
`M h (X h)` off the coordinate `i₀ h`. -/
private theorem sum_erase_C_mul_map_X {f : MvPolynomial (κ × ι) R →ₐ[R] MvPolynomial (κ × ι) R}
    {h : κ} (hf : ∀ i ≠ i₀ h, f (X (h, i)) = X (h, i)) :
    ∑ i ∈ univ.erase (i₀ h), C (M h i) * f (X (h, i)) =
      ∑ i ∈ univ.erase (i₀ h), C (M h i) * X (h, i) :=
  Finset.sum_congr rfl fun i hi ↦ by rw [hf i (Finset.ne_of_mem_erase hi)]

end CommSemiring

variable [Field K] {M : κ → ι → K} {i₀ : κ → ι}

/-- The inverse of `substForm M i₀` when no `M h (i₀ h)` vanishes: the variable `X (h, i₀ h)`
becomes `(X (h, i₀ h) - ∑ i ≠ i₀ h, M h i • X (h, i)) / M h (i₀ h)`. -/
noncomputable def substFormInv (M : κ → ι → K) (i₀ : κ → ι) :
    MvPolynomial (κ × ι) K →ₐ[K] MvPolynomial (κ × ι) K :=
  aeval fun p ↦ if p.2 = i₀ p.1 then
    C (M p.1 p.2)⁻¹ * (X p - ∑ i ∈ univ.erase p.2, C (M p.1 i) * X (p.1, i)) else X p

@[simp]
theorem substFormInv_X_self (h : κ) :
    substFormInv M i₀ (X (h, i₀ h)) =
      C (M h (i₀ h))⁻¹ * (X (h, i₀ h) - ∑ i ∈ univ.erase (i₀ h), C (M h i) * X (h, i)) := by
  simp [substFormInv]

@[simp]
theorem substFormInv_X_of_ne {h : κ} {i : ι} (hi : i ≠ i₀ h) :
    substFormInv M i₀ (X (h, i)) = X (h, i) := by
  simp [substFormInv, hi]

/-- `substForm M i₀` undoes `substFormInv M i₀`. -/
@[simp]
theorem substForm_substFormInv (hM : ∀ h, M h (i₀ h) ≠ 0) (P : MvPolynomial (κ × ι) K) :
    substForm M i₀ (substFormInv M i₀ P) = P := by
  suffices (substForm M i₀).comp (substFormInv M i₀) = AlgHom.id K _ from
    AlgHom.congr_fun this P
  ext ⟨h, i⟩ : 1
  by_cases hi : i = i₀ h
  · subst hi
    simp only [AlgHom.comp_apply, substFormInv_X_self, map_mul, map_sub, map_sum, algHom_C,
      algebraMap_eq, substForm_X_self, AlgHom.id_apply,
      sum_erase_C_mul_map_X fun i hi ↦ substForm_X_of_ne hi]
    rw [← Finset.add_sum_erase _ _ (mem_univ (i₀ h))]
    simp [← mul_assoc, ← C_mul, hM h]
  · simp [hi]

/-- `substFormInv M i₀` undoes `substForm M i₀`. -/
@[simp]
theorem substFormInv_substForm (hM : ∀ h, M h (i₀ h) ≠ 0) (P : MvPolynomial (κ × ι) K) :
    substFormInv M i₀ (substForm M i₀ P) = P := by
  suffices (substFormInv M i₀).comp (substForm M i₀) = AlgHom.id K _ from
    AlgHom.congr_fun this P
  ext ⟨h, i⟩ : 1
  by_cases hi : i = i₀ h
  · subst hi
    rw [AlgHom.comp_apply, substForm_X_self, ← Finset.add_sum_erase _ _ (mem_univ (i₀ h))]
    simp only [map_add, map_sum, map_mul, algHom_C, algebraMap_eq, substFormInv_X_self,
      AlgHom.id_apply, sum_erase_C_mul_map_X fun i hi ↦ substFormInv_X_of_ne hi]
    simp [← mul_assoc, ← C_mul, hM h]
  · simp [hi]

/-- `substFormInv M i₀` turns the form `M h (X h)` into the variable `X (h, i₀ h)`. -/
theorem substFormInv_sum_C_mul_X (hM : ∀ h, M h (i₀ h) ≠ 0) (h : κ) :
    substFormInv M i₀ (∑ i, C (M h i) * X (h, i)) = X (h, i₀ h) := by
  rw [← substForm_X_self, substFormInv_substForm hM]

/-- `substForm M i₀` preserves multihomogeneity of any multidegree `e`. -/
theorem IsMultiHomogeneous.substForm {R : Type*} [CommSemiring R] [DecidableEq κ]
    {e : κ → ℕ} {P : MvPolynomial (κ × ι) R} (hP : IsMultiHomogeneous e P)
    (M : κ → ι → R) (i₀ : κ → ι) :
    IsMultiHomogeneous e (MvPolynomial.substForm M i₀ P) := by
  rw [MvPolynomial.substForm]
  refine hP.aeval fun h i ↦ ?_
  by_cases hi : i = i₀ h
  · subst hi
    simp only [↓reduceIte]
    exact IsMultiHomogeneous.sum (univ : Finset ι) _ fun j _ ↦ (isMultiHomogeneous_X h j).C_mul _
  · simp [hi]

/-- `substFormInv M i₀` preserves multihomogeneity of any multidegree `e`. -/
theorem IsMultiHomogeneous.substFormInv [DecidableEq κ] {e : κ → ℕ}
    {P : MvPolynomial (κ × ι) K} (hP : IsMultiHomogeneous e P) (M : κ → ι → K) (i₀ : κ → ι) :
    IsMultiHomogeneous e (MvPolynomial.substFormInv M i₀ P) := by
  rw [MvPolynomial.substFormInv]
  refine hP.aeval fun h i ↦ ?_
  by_cases hi : i = i₀ h
  · subst hi
    simp only [↓reduceIte]
    exact ((isMultiHomogeneous_X h (i₀ h)).sub
      (IsMultiHomogeneous.sum _ _ fun j _ ↦ (isMultiHomogeneous_X h j).C_mul _)).C_mul _
  · simp [hi]

end Substitution

section CommSemiring

variable [CommSemiring R] [Fintype κ] [Fintype ι]

/-- The ideal of polynomials of index at least `t` along the linear forms
`M h (X h) = ∑ i, M h i • X (h, i)`, one in each block of variables: it is generated by the
products `∏ h, M h (X h) ^ j h` with `t ≤ ∑ h, j h / d h`. -/
noncomputable def formIdeal (t : ℝ≥0∞) (d : κ → ℕ) (M : κ → ι → R) :
    Ideal (MvPolynomial (κ × ι) R) :=
  Ideal.span ((fun j : κ → ℕ ↦ ∏ h, (∑ i, C (M h i) * X (h, i)) ^ j h) ''
    {j | t ≤ ∑ h, (j h : ℝ≥0∞) / d h})

/-- The index of `P` along the linear forms `M h (X h)` with the degrees `d h`: the supremum of
the `t` with `P ∈ formIdeal t d M`. -/
noncomputable def formIndex (d : κ → ℕ) (M : κ → ι → R) (P : MvPolynomial (κ × ι) R) : ℝ≥0∞ :=
  ⨆ (t : ℝ≥0∞) (_ : P ∈ formIdeal t d M), t

variable {t : ℝ≥0∞} {d : κ → ℕ} {M : κ → ι → R} {P Q : MvPolynomial (κ × ι) R}

/-- The defining generators of `formIdeal t d M`. -/
theorem formIdeal_def (t : ℝ≥0∞) (d : κ → ℕ) (M : κ → ι → R) :
    formIdeal t d M = Ideal.span ((fun j : κ → ℕ ↦ ∏ h, (∑ i, C (M h i) * X (h, i)) ^ j h) ''
      {j | t ≤ ∑ h, (j h : ℝ≥0∞) / d h}) :=
  (rfl)

/-- The defining supremum of `formIndex d M P`. -/
theorem formIndex_def (d : κ → ℕ) (M : κ → ι → R) (P : MvPolynomial (κ × ι) R) :
    formIndex d M P = ⨆ (t : ℝ≥0∞) (_ : P ∈ formIdeal t d M), t :=
  (rfl)

/-- A product of powers of the forms lies in the ideal of every `t ≤ ∑ h, j h / d h`. -/
theorem prod_pow_mem_formIdeal {j : κ → ℕ} (hj : t ≤ ∑ h, (j h : ℝ≥0∞) / d h) :
    ∏ h, (∑ i, C (M h i) * X (h, i)) ^ j h ∈ formIdeal t d M :=
  Ideal.subset_span ⟨j, hj, rfl⟩

/-- Raising the threshold `t` shrinks the ideal. -/
theorem formIdeal_antitone (d : κ → ℕ) (M : κ → ι → R) : Antitone fun t ↦ formIdeal t d M :=
  fun _ _ hst ↦ Ideal.span_mono (Set.image_mono fun _ hj ↦ hst.trans hj)

@[simp]
theorem formIdeal_zero (d : κ → ℕ) (M : κ → ι → R) : formIdeal 0 d M = ⊤ :=
  (Ideal.eq_top_iff_one _).mpr <| by
    simpa using prod_pow_mem_formIdeal (j := 0) (d := d) (M := M) zero_le

/-- Membership in the ideal of threshold `t` bounds the index below by `t`. -/
theorem le_formIndex_of_mem (hP : P ∈ formIdeal t d M) : t ≤ formIndex d M P :=
  le_iSup₂ (f := fun t (_ : P ∈ formIdeal t d M) ↦ t) t hP

/-- A polynomial lies in the ideal of every threshold below its index. -/
theorem mem_formIdeal_of_lt_formIndex (ht : t < formIndex d M P) : P ∈ formIdeal t d M := by
  obtain ⟨s, hs⟩ := lt_iSup_iff.mp ht
  obtain ⟨hPs, hts⟩ := lt_iSup_iff.mp hs
  exact formIdeal_antitone d M hts.le hPs

@[simp]
theorem formIndex_zero : formIndex d M 0 = ⊤ :=
  top_unique (le_formIndex_of_mem (Ideal.zero_mem _))

/-- The constant `1` has index `0`. -/
@[simp]
theorem formIndex_one [Nontrivial R] : formIndex d M (1 : MvPolynomial (κ × ι) R) = 0 := by
  refine le_antisymm (iSup₂_le fun t ht ↦ ?_) zero_le
  by_contra! ht0
  have hker : formIdeal t d M ≤ RingHom.ker (constantCoeff (σ := κ × ι) (R := R)) := by
    rw [formIdeal, Ideal.span_le]
    rintro _ ⟨j, hj, rfl⟩
    obtain ⟨h, hh⟩ : ∃ h, j h ≠ 0 := by
      by_contra! hj0
      simpa [hj0] using ht0.trans_le hj
    simpa using Finset.prod_eq_zero (f := fun h ↦ (0 : R) ^ j h) (mem_univ h) (zero_pow hh)
  simpa using RingHom.mem_ker.mp (hker ht)

/-- The index of a sum is at least the smaller index of the summands. -/
theorem min_formIndex_le_add (P Q : MvPolynomial (κ × ι) R) :
    min (formIndex d M P) (formIndex d M Q) ≤ formIndex d M (P + Q) :=
  le_of_forall_lt_imp_le_of_dense fun _ ht ↦ le_formIndex_of_mem <| add_mem
    (mem_formIdeal_of_lt_formIndex (lt_min_iff.mp ht).1)
    (mem_formIdeal_of_lt_formIndex (lt_min_iff.mp ht).2)

/-- Multiplication by a unit does not change the index. -/
theorem formIndex_smul {c : R} (hc : IsUnit c) (P : MvPolynomial (κ × ι) R) :
    formIndex d M (c • P) = formIndex d M P := by
  simp only [formIndex, smul_eq_C_mul, Ideal.unit_mul_mem_iff_mem _ (hc.map C)]

/-- Scaling each form `M h` by a unit `c h` does not change `formIdeal`. -/
theorem formIdeal_smul_form {c : κ → R} (hc : ∀ h, IsUnit (c h)) (t : ℝ≥0∞) (d : κ → ℕ)
    (M : κ → ι → R) :
    formIdeal t d (fun h ↦ c h • M h) = formIdeal t d M := by
  have hgen (j : κ → ℕ) :
      ∏ h, (∑ i, C ((c h • M h) i) * X (h, i)) ^ j h =
        C (∏ h, c h ^ j h) * ∏ h, (∑ i, C (M h i) * X (h, i)) ^ j h := by
    simp only [Pi.smul_apply, smul_eq_mul, C_mul, mul_assoc, ← mul_sum, mul_pow, prod_mul_distrib,
      ← map_pow, ← map_prod]
  have hunit (j : κ → ℕ) : IsUnit (C (∏ h, c h ^ j h) : MvPolynomial (κ × ι) R) :=
    (Finset.prod_induction _ IsUnit (fun _ _ ↦ IsUnit.mul) isUnit_one
      fun h _ ↦ (hc h).pow (j h)).map C
  refine le_antisymm ?_ ?_ <;> rw [formIdeal, Ideal.span_le] <;> rintro _ ⟨j, hj, rfl⟩ <;>
    dsimp only <;> rw [SetLike.mem_coe]
  · rw [hgen j, Ideal.unit_mul_mem_iff_mem _ (hunit j)]
    exact prod_pow_mem_formIdeal hj
  · rw [← Ideal.unit_mul_mem_iff_mem _ (hunit j), ← hgen j]
    exact prod_pow_mem_formIdeal hj

/-- Scaling each form `M h` by a unit `c h` does not change `formIndex`. -/
theorem formIndex_smul_form {c : κ → R} (hc : ∀ h, IsUnit (c h)) (d : κ → ℕ)
    (M : κ → ι → R) (P : MvPolynomial (κ × ι) R) :
    formIndex d (fun h ↦ c h • M h) P = formIndex d M P := by
  simp only [formIndex, formIdeal_smul_form hc]

variable [DecidableEq ι] {i₀ : κ → ι}

/-- The exponent with `j h` at `(h, i₀ h)` for every `h` and zero elsewhere. -/
private noncomputable def blockExp (i₀ : κ → ι) (j : κ → ℕ) : κ × ι →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm fun p ↦ if p.2 = i₀ p.1 then j p.1 else 0

private theorem blockExp_apply (j : κ → ℕ) (p : κ × ι) :
    blockExp i₀ j p = if p.2 = i₀ p.1 then j p.1 else 0 := by
  simp [blockExp]

private theorem substForm_monomial_blockExp (j : κ → ℕ) :
    substForm M i₀ (monomial (blockExp i₀ j) (1 : R)) = ∏ h, (∑ i, C (M h i) * X (h, i)) ^ j h := by
  rw [monomial_eq, C_1, one_mul, Finsupp.prod_fintype _ _ fun _ ↦ pow_zero _,
    Fintype.prod_prod_type, map_prod]
  refine Finset.prod_congr rfl fun h _ ↦ ?_
  rw [Fintype.prod_eq_single (i₀ h) fun i hi ↦ by simp [blockExp_apply, hi]]
  simp [blockExp_apply]

/-- The ideal of index at least `t` along the forms is the image under `substForm M i₀` of the
monomial ideal spanned by the exponents `n` with `t ≤ ∑ h, n (h, i₀ h) / d h`. -/
theorem formIdeal_eq_map_substForm (t : ℝ≥0∞) (d : κ → ℕ) (M : κ → ι → R) (i₀ : κ → ι) :
    formIdeal t d M = Ideal.map (substForm M i₀) (Ideal.span ((fun n ↦ monomial n (1 : R)) ''
      {n | t ≤ ∑ h, (n (h, i₀ h) : ℝ≥0∞) / d h})) := by
  apply le_antisymm
  · rw [formIdeal, Ideal.span_le]
    rintro _ ⟨j, hj, rfl⟩
    dsimp only
    rw [SetLike.mem_coe, ← substForm_monomial_blockExp]
    exact Ideal.mem_map_of_mem _
      (Ideal.subset_span ⟨blockExp i₀ j, by simpa [blockExp_apply] using hj, rfl⟩)
  · rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨n, hn, rfl⟩, rfl⟩
    -- Split off from `n` the exponents at the coordinates `i₀ h`.
    set e := blockExp i₀ fun h ↦ n (h, i₀ h)
    have hle : e ≤ n := fun p ↦ by
      obtain ⟨h, i⟩ := p
      by_cases hi : i = i₀ h
      · subst hi
        simp [e, blockExp_apply]
      · simp [e, blockExp_apply, hi]
    have hsplit : monomial n (1 : R) = monomial e 1 * monomial (n - e) 1 := by
      rw [monomial_mul_monomial, one_mul, add_tsub_cancel_of_le hle]
    dsimp only
    rw [SetLike.mem_coe, hsplit, map_mul, substForm_monomial_blockExp]
    exact Ideal.mul_mem_right _ _ (prod_pow_mem_formIdeal hn)

end CommSemiring

section Field

variable [Field K] [Fintype κ] [Fintype ι] {t : ℝ≥0∞} {d : κ → ℕ} {M : κ → ι → K}

section Coordinates

variable [DecidableEq ι] {i₀ : κ → ι}

/-- In the coordinates of `substFormInv M i₀`, membership in the ideal of index at least `t` along
the forms is a condition on each monomial separately. -/
theorem mem_formIdeal_iff (hM : ∀ h, M h (i₀ h) ≠ 0) {P : MvPolynomial (κ × ι) K} :
    P ∈ formIdeal t d M ↔
      ∀ n ∈ (substFormInv M i₀ P).support, t ≤ ∑ h, (n (h, i₀ h) : ℝ≥0∞) / d h := by
  set J : Ideal (MvPolynomial (κ × ι) K) := Ideal.span ((fun n ↦ monomial n (1 : K)) ''
    {n | t ≤ ∑ h, (n (h, i₀ h) : ℝ≥0∞) / d h})
  have hJ (Q : MvPolynomial (κ × ι) K) :
      Q ∈ J ↔ ∀ n ∈ Q.support, t ≤ ∑ h, (n (h, i₀ h) : ℝ≥0∞) / d h := by
    rw [mem_ideal_span_monomial_image]
    refine forall₂_congr fun n _ ↦ ⟨?_, fun hn ↦ ⟨n, hn, le_rfl⟩⟩
    rintro ⟨e, he, hen⟩
    exact he.trans (Finset.sum_le_sum fun h _ ↦
      ENNReal.div_le_div_right (by exact_mod_cast hen (h, i₀ h)) _)
  rw [formIdeal_eq_map_substForm t d M i₀, ← hJ]
  refine ⟨fun hP ↦ ?_, fun hP ↦ substForm_substFormInv hM P ▸ Ideal.mem_map_of_mem _ hP⟩
  have hle : Ideal.map (substForm M i₀) J ≤ Ideal.comap (substFormInv M i₀) J := by
    rw [Ideal.map_le_iff_le_comap]
    intro Q hQ
    rwa [Ideal.mem_comap, Ideal.mem_comap, substFormInv_substForm hM]
  exact hle hP

/-- The index along the forms is the least value of `∑ h, n (h, i₀ h) / d h` over the monomials
`n` of `substFormInv M i₀ P`. -/
theorem formIndex_eq_iInf (hM : ∀ h, M h (i₀ h) ≠ 0) (P : MvPolynomial (κ × ι) K) :
    formIndex d M P = ⨅ n ∈ (substFormInv M i₀ P).support, ∑ h, (n (h, i₀ h) : ℝ≥0∞) / d h :=
  le_antisymm (iSup₂_le fun _ ht ↦ le_iInf₂ ((mem_formIdeal_iff hM).mp ht))
    (le_formIndex_of_mem ((mem_formIdeal_iff hM).mpr fun n hn ↦ iInf₂_le n hn))

end Coordinates

/-- The supremum defining the index is attained: `P` lies in the ideal of index at least `t`
exactly when its index is at least `t`. -/
theorem mem_formIdeal_iff_le_formIndex (hM : ∀ h, M h ≠ 0) {P : MvPolynomial (κ × ι) K} :
    P ∈ formIdeal t d M ↔ t ≤ formIndex d M P := by
  classical
  choose i₀ hi₀ using fun h ↦ Function.ne_iff.mp (hM h)
  rw [mem_formIdeal_iff hi₀, formIndex_eq_iInf hi₀, le_iInf₂_iff]

/-- The index of a product of powers of the forms is `∑ h, j h / d h`. -/
theorem formIndex_prod_pow (hM : ∀ h, M h ≠ 0) (j : κ → ℕ) :
    formIndex d M (∏ h, (∑ i, C (M h i) * X (h, i)) ^ j h) = ∑ h, (j h : ℝ≥0∞) / d h := by
  classical
  choose i₀ hi₀ using fun h ↦ Function.ne_iff.mp (hM h)
  rw [formIndex_eq_iInf hi₀, ← substForm_monomial_blockExp (i₀ := i₀),
    substFormInv_substForm hi₀]
  simp [support_monomial, blockExp_apply]

/-- With positive degrees, only `0` has infinite index. -/
@[simp]
theorem formIndex_eq_top_iff (hM : ∀ h, M h ≠ 0) (hd : ∀ h, d h ≠ 0)
    {P : MvPolynomial (κ × ι) K} : formIndex d M P = ⊤ ↔ P = 0 := by
  classical
  choose i₀ hi₀ using fun h ↦ Function.ne_iff.mp (hM h)
  refine ⟨fun htop ↦ by_contra fun hP ↦ ?_, fun hP ↦ hP ▸ formIndex_zero⟩
  have hQ : substFormInv M i₀ P ≠ 0 := fun h0 ↦
    hP (by rw [← substForm_substFormInv hi₀ P, h0, map_zero])
  obtain ⟨n, hn⟩ := support_nonempty.mpr hQ
  have hlt : ∑ h, (n (h, i₀ h) : ℝ≥0∞) / d h < ⊤ := ENNReal.sum_lt_top.mpr fun h _ ↦
    ENNReal.div_lt_top (ENNReal.natCast_ne_top _) (by exact_mod_cast hd h)
  rw [formIndex_eq_iInf hi₀] at htop
  exact hlt.ne (top_le_iff.mp (htop ▸ iInf₂_le n hn))

/-- The index along nonzero forms is additive on products. -/
theorem formIndex_mul (hM : ∀ h, M h ≠ 0) (P Q : MvPolynomial (κ × ι) K) :
    formIndex d M (P * Q) = formIndex d M P + formIndex d M Q := by
  classical
  choose i₀ hi₀ using fun h ↦ Function.ne_iff.mp (hM h)
  simp only [formIndex_eq_iInf hi₀, map_mul, ← Finsupp.weight_ite_inv_natCast_eq_sum_div]
  exact iInf_support_weight_mul _ _ _

/-- The index of `P ^ n` along nonzero forms is `n` times the index of `P`. -/
theorem formIndex_pow (hM : ∀ h, M h ≠ 0) (P : MvPolynomial (κ × ι) K) (n : ℕ) :
    formIndex d M (P ^ n) = n • formIndex d M P := by
  induction n with
  | zero => simp
  | succ n ih => rw [pow_succ, formIndex_mul hM, ih, succ_nsmul]

end Field

end MvPolynomial
