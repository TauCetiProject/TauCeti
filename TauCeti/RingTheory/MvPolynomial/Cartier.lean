/-!
# Cartier operators and the Frobenius trace of a polynomial ring

For `0 < n` and an exponent `r : σ →₀ ℕ`, the **Cartier operator**
`MvPolynomial.cartier R n r` selects the coefficients of a polynomial at the exponents
`n • d + r` and reindexes them by `d`: `(cartier R n r f).coeff d = f.coeff (n • d + r)`. It is
`R`-linear. At the residues `β` modulo `n` these operators are the coordinates of the monomial
basis of `R[X_i]` over `R[X_i ^ n]` (`MvPolynomial.basisExpand_repr_apply`). So when
every entry of `r` is below `n`, the Cartier operator at `r` is linear over the image of
`expand n` (`MvPolynomial.cartier_expand_mul`), and for finitely many variables these
components rebuild a polynomial from its residues modulo `n`:
`f = ∑_β X ^ β * expand n (cartier R n β f)`, with `β` running over the exponents with entries
below `n` (`MvPolynomial.sum_monomial_mul_expand_cartier`).

Now let `R` be a perfect ring of exponential characteristic `p`, let `σ` be finite, and write
`ρ = (p - 1, …, p - 1)`. The **Frobenius trace** `MvPolynomial.frobeniusTrace σ R p` of
`R[X_i]` is the Cartier operator at the residue `ρ` followed by the inverse Frobenius of `R` on
the coefficients:

`frobeniusTrace σ R p (∑_e a_e X ^ e) = ∑_d a_{p • d + ρ} ^ (1 / p) X ^ d`.

It keeps exactly the monomials whose exponents are all congruent to `p - 1` modulo `p`, and it is
`p⁻¹`-linear: `frobeniusTrace σ R p (g ^ p * f) = g * frobeniusTrace σ R p f`. Under the
trivialization of the canonical bundle of affine space by `dX₁ ∧ ⋯ ∧ dXₙ` it is the Cartier
trace `F_* ω → ω` of the Frobenius morphism, and it sends the anticanonical section
`(X₁ ⋯ Xₙ) ^ (p - 1)` to `1`.

Every `p⁻¹`-linear additive endomorphism `φ` of `R[X_i]` is `f ↦ frobeniusTrace σ R p (h * f)`
for a unique polynomial `h`, namely `h = MvPolynomial.frobeniusTraceDual p φ`
(`MvPolynomial.frobeniusTrace_frobeniusTraceDual_mul`,
`MvPolynomial.existsUnique_eq_frobeniusTrace_mul`). This is the affine-space case of the
identification `Hom(F_* O, O) ≅ F_* (ω ^ (1 - p))`, under which the trace generates the
homomorphisms out of the Frobenius pushforward. For `h = (X₁ ⋯ Xₙ) ^ (p - 1)` the resulting map
`f ↦ ∑_d a_{p • d} ^ (1 / p) X ^ d` is the standard Frobenius splitting of affine space: it fixes
`1`, is `p⁻¹`-linear, and maps each ideal generated by a set of variables into itself
(`MvPolynomial.frobeniusTrace_prod_X_pow_mul_mem_ideal_span_X_image`). These are the
local calculations on the affine root-coordinate charts of flag varieties, on which their
Frobenius splittings are built from anticanonical sections.

## Main definitions

* `MvPolynomial.cartier R n r`: the coefficients at the exponents `n • d + r`, as an
  `R`-linear map.
* `MvPolynomial.frobeniusTrace σ R p`: the Frobenius trace of a polynomial ring in finitely
  many variables over a perfect ring.
* `MvPolynomial.frobeniusTraceDual p φ`: the polynomial `h` with
  `φ f = frobeniusTrace σ R p (h * f)` for a `p⁻¹`-linear additive endomorphism `φ`.

## Main results

* `MvPolynomial.basisExpand_repr_apply`: the Cartier operators at the residues modulo `n`
  are the coordinates in `TauCeti.MvPolynomial.basisExpand`.
* `MvPolynomial.cartier_expand_mul`: `cartier R n r (expand n g * f) = g * cartier R n r f`
  for a residue `r`.
* `MvPolynomial.sum_monomial_mul_expand_cartier`: the decomposition of a polynomial into
  its Cartier components.
* `MvPolynomial.prod_X_pow_eq_monomial_equivFunOnFinite_symm`: `(X₁ ⋯ Xₙ) ^ k` is the
  monomial with all exponents `k`.
* `MvPolynomial.frobeniusTrace_pow_mul`, `MvPolynomial.frobeniusTrace_C_mul`: the
  trace is `p⁻¹`-linear.
* `MvPolynomial.frobeniusTrace_prod_X_pow`: the trace sends `(X₁ ⋯ Xₙ) ^ (p - 1)` to `1`.
* `MvPolynomial.frobeniusTrace_frobeniusTraceDual_mul`: `φ` is
  `f ↦ frobeniusTrace σ R p (frobeniusTraceDual p φ * f)`.
* `MvPolynomial.existsUnique_eq_frobeniusTrace_mul`: **every `p⁻¹`-linear additive
  endomorphism is `f ↦ frobeniusTrace σ R p (h * f)` for a unique `h`.**
* `MvPolynomial.coeff_frobeniusTrace_prod_X_pow_mul`: the splitting
  `f ↦ frobeniusTrace σ R p ((X₁ ⋯ Xₙ) ^ (p - 1) * f)` takes the `p`-th roots of the coefficients
  at the exponents divisible by `p`.
* `MvPolynomial.frobeniusTrace_prod_X_pow_mul_mem_ideal_span_X_image`: that splitting
  maps the ideal generated by any set of variables into itself.

## References

* M. Brion and S. Kumar, *Frobenius splitting methods in geometry and representation theory*,
  Progress in Mathematics 231, Birkhäuser, 2005, Chapter 1 (the trace map of the Frobenius
  morphism and the Frobenius splitting of affine space).
* P. Cartier, *Une nouvelle opération sur les formes différentielles*, C. R. Acad. Sci. Paris 244
  (1957), 426–428.
-/

public section

namespace MvPolynomial

open Finsupp
open TauCeti.MvPolynomial (basisExpand basisExpand_apply)

variable {σ R : Type*} [CommSemiring R]

/-! ### Cartier operators -/

section Cartier

variable (n : ℕ) [NeZero n]

variable (R) in
/-- The **Cartier operator** of modulus `n` and offset `r`: it keeps the coefficients of a
polynomial at the exponents `n • d + r`, moved to the exponents `d`
(`MvPolynomial.coeff_cartier`). -/
noncomputable def cartier (r : σ →₀ ℕ) : MvPolynomial σ R →ₗ[R] MvPolynomial σ R :=
  (AddMonoidAlgebra.coeffLinearEquiv R).symm.toLinearMap ∘ₗ
    Finsupp.lcomapDomain _ (nsmul_add_injective n r) ∘ₗ
      (AddMonoidAlgebra.coeffLinearEquiv R).toLinearMap

variable {n}

/-- The coefficient of the Cartier operator at `d` is the coefficient at `n • d + r`. -/
@[simp]
theorem coeff_cartier (r : σ →₀ ℕ) (f : MvPolynomial σ R) (d : σ →₀ ℕ) :
    (cartier R n r f).coeff d = f.coeff (n • d + r) :=
  (rfl)

/-- The Cartier operator moves the monomial at `n • d + r` to `d`. -/
@[simp]
theorem cartier_monomial_nsmul_add_self (r d : σ →₀ ℕ) (a : R) :
    cartier R n r (monomial (n • d + r) a) = monomial d a := by
  classical
  ext c
  simp [coeff_monomial, (nsmul_add_injective n r).eq_iff]

/-- For residues `s` and `r` modulo `n`, the Cartier operator at `r` kills the monomials at
`n • d + s` with `s ≠ r`. -/
theorem cartier_monomial_nsmul_add [DecidableEq σ] {r s : σ →₀ ℕ} (hr : ∀ i, r i < n)
    (hs : ∀ i, s i < n) (d : σ →₀ ℕ) (a : R) :
    cartier R n r (monomial (n • d + s) a) = if s = r then monomial d a else 0 := by
  split_ifs with h
  · rw [h, cartier_monomial_nsmul_add_self]
  · ext c
    simp [coeff_monomial, nsmul_add_eq_nsmul_add_iff n hs hr, h]

/-- **The Cartier operators at the residues modulo `n` are the coordinates in the monomial basis
along `expand n`.** The `letI` names the module structure along `expand n`, as in
`MvPolynomial.coeff_basisExpand_repr`. -/
theorem basisExpand_repr_apply (f : MvPolynomial σ R) (β : σ →₀ Fin n) :
    letI : Module (MvPolynomial σ R) (MvPolynomial σ R) :=
      (expand n : MvPolynomial σ R →ₐ[R] _).toRingHom.toAlgebra.toModule
    (basisExpand σ R n).repr f β = cartier R n (β.mapRange Fin.val (Fin.val_zero n)) f := by
  ext d
  rw [coeff_basisExpand_repr, coeff_cartier]

/-- **The Cartier operator at a residue is linear over the image of `expand n`.** -/
theorem cartier_expand_mul {r : σ →₀ ℕ} (hr : ∀ i, r i < n) (g f : MvPolynomial σ R) :
    cartier R n r (expand n g * f) = g * cartier R n r f := by
  obtain ⟨β, rfl⟩ : ∃ β : σ →₀ Fin n, β.mapRange Fin.val (Fin.val_zero n) = r :=
    ⟨r.mapRange (Fin.ofNat n) (Fin.ofNat_zero n), by ext i; simp [Nat.mod_eq_of_lt (hr i)]⟩
  let : Module (MvPolynomial σ R) (MvPolynomial σ R) :=
    (expand n : MvPolynomial σ R →ₐ[R] _).toRingHom.toAlgebra.toModule
  rw [← basisExpand_repr_apply, ← basisExpand_repr_apply]
  exact DFunLike.congr_fun ((basisExpand σ R n).repr.map_smul g f) β

/-- **Decomposition into Cartier components.** In finitely many variables, a polynomial is the
sum over the residues `β` modulo `n` of `X ^ β` times the expansion of its Cartier component at
`β`. -/
theorem sum_monomial_mul_expand_cartier [Fintype σ] [DecidableEq σ] (f : MvPolynomial σ R) :
    ∑ β : σ →₀ Fin n, monomial (β.mapRange Fin.val (Fin.val_zero n)) 1 *
      expand n (cartier R n (β.mapRange Fin.val (Fin.val_zero n)) f) = f := by
  let : Module (MvPolynomial σ R) (MvPolynomial σ R) :=
    (expand n : MvPolynomial σ R →ₐ[R] _).toRingHom.toAlgebra.toModule
  conv_rhs => rw [← (basisExpand σ R n).sum_repr f]
  refine Finset.sum_congr rfl fun β _ ↦ ?_
  rw [basisExpand_repr_apply, basisExpand_apply, mul_comm]
  rfl

end Cartier

omit [CommSemiring R] in
/-- A power of the product of all variables is the monomial with all exponents equal to that
power. -/
theorem prod_X_pow_eq_monomial_equivFunOnFinite_symm [CommSemiring R] [Fintype σ] (k : ℕ) :
    (∏ i, X i : MvPolynomial σ R) ^ k = monomial (equivFunOnFinite.symm fun _ ↦ k) 1 := by
  rw [monomial_eq, C_1, one_mul, Finsupp.prod_fintype _ _ (by simp), ← Finset.prod_pow]
  simp

/-! ### The Frobenius trace -/

section FrobeniusTrace

variable (p : ℕ) [ExpChar R p] [PerfectRing R p]

variable (σ R) in
/-- The Frobenius trace of `R[X_i]` for a perfect ring `R` of exponential characteristic `p` and
finitely many variables: it keeps the monomials whose exponents are all congruent to `p - 1`
modulo `p`, and takes the `p`-th roots of their coefficients
(`MvPolynomial.coeff_frobeniusTrace`). -/
noncomputable def frobeniusTrace [Finite σ] : MvPolynomial σ R →+ MvPolynomial σ R :=
  have : NeZero p := ⟨expChar_ne_zero R p⟩
  (map (frobeniusEquiv R p).symm : MvPolynomial σ R →+* _).toAddMonoidHom.comp
    (cartier R p (equivFunOnFinite.symm fun _ ↦ p - 1)).toAddMonoidHom

variable {p}

section Finite

variable [Finite σ]

/-- The offset `ρ = (p - 1, …, p - 1)` of the Frobenius trace is a residue modulo `p`. -/
private theorem equivFunOnFinite_symm_sub_one_lt (hp : p ≠ 0) (i : σ) :
    (equivFunOnFinite.symm fun _ : σ ↦ p - 1) i < p := by
  simpa using Nat.sub_one_lt hp

private theorem frobeniusTrace_apply (f : MvPolynomial σ R) :
    have : NeZero p := ⟨expChar_ne_zero R p⟩
    frobeniusTrace σ R p f =
      map (frobeniusEquiv R p).symm (cartier R p (equivFunOnFinite.symm fun _ ↦ p - 1) f) :=
  (rfl)

/-- The coefficient of the Frobenius trace at `d` is the `p`-th root of the coefficient at
`p • d + ρ`. -/
@[simp]
theorem coeff_frobeniusTrace (f : MvPolynomial σ R) (d : σ →₀ ℕ) :
    (frobeniusTrace σ R p f).coeff d =
      (frobeniusEquiv R p).symm (f.coeff (p • d + equivFunOnFinite.symm fun _ ↦ p - 1)) := by
  have : NeZero p := ⟨expChar_ne_zero R p⟩
  simp [frobeniusTrace_apply, coeff_map]

/-- **The Frobenius trace is `p⁻¹`-linear.** -/
theorem frobeniusTrace_pow_mul (g f : MvPolynomial σ R) :
    frobeniusTrace σ R p (g ^ p * f) = g * frobeniusTrace σ R p f := by
  have : NeZero p := ⟨expChar_ne_zero R p⟩
  obtain ⟨g, rfl⟩ := map_surjective (f := ((frobeniusEquiv R p).symm : R →+* R))
    (frobeniusEquiv R p).symm.surjective g
  rw [frobeniusTrace_apply, frobeniusTrace_apply, ← expand_eq_map_frobeniusEquiv_symm_pow,
    cartier_expand_mul (equivFunOnFinite_symm_sub_one_lt (expChar_ne_zero R p)), map_mul]

/-- The Frobenius trace is linear over the inverse Frobenius of the coefficients. -/
theorem frobeniusTrace_C_mul (c : R) (f : MvPolynomial σ R) :
    frobeniusTrace σ R p (C c * f) = C ((frobeniusEquiv R p).symm c) * frobeniusTrace σ R p f := by
  rw [← frobeniusTrace_pow_mul, ← C_pow, frobeniusEquiv_symm_pow_p]

/-- A polynomial `h` is determined by the map `f ↦ frobeniusTrace p (h * f)`. -/
theorem eq_of_forall_frobeniusTrace_mul_eq {h h' : MvPolynomial σ R}
    (hh : ∀ f, frobeniusTrace σ R p (h * f) = frobeniusTrace σ R p (h' * f)) : h = h' := by
  have : NeZero p := ⟨expChar_ne_zero R p⟩
  ext e
  obtain ⟨q, s, hs, rfl⟩ := exists_eq_nsmul_add p e
  -- Multiplying by `X ^ (ρ - s)` moves the coefficient at `p • q + s` to `p • q + ρ`, where the
  -- trace reads it off at `q`.
  let t : σ →₀ ℕ := equivFunOnFinite.symm fun i ↦ p - 1 - s i
  have ht : p • q + (equivFunOnFinite.symm fun _ ↦ p - 1) = t + (p • q + s) := by
    ext i
    have := hs i
    simp only [coe_add, coe_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
      coe_equivFunOnFinite_symm, t]
    omega
  have key (g : MvPolynomial σ R) : (frobeniusTrace σ R p (g * monomial t 1)).coeff q =
      (frobeniusEquiv R p).symm (g.coeff (p • q + s)) := by
    rw [coeff_frobeniusTrace, ht, mul_comm, coeff_monomial_mul, one_mul]
  simpa [key] using congrArg (fun g ↦ g.coeff q) (hh (monomial t 1))

end Finite

section Fintype

variable [Fintype σ]

/-- The Frobenius trace of a monomial whose exponent is `p • d + s` with all entries of `s` below
`p`: it vanishes unless all entries of `s` are `p - 1`. -/
theorem frobeniusTrace_monomial_nsmul_add {s : σ →₀ ℕ} (hs : ∀ i, s i < p) (d : σ →₀ ℕ) (a : R) :
    frobeniusTrace σ R p (monomial (p • d + s) a) =
      if ∀ i, s i = p - 1 then monomial d ((frobeniusEquiv R p).symm a) else 0 := by
  classical
  have : NeZero p := ⟨expChar_ne_zero R p⟩
  rw [frobeniusTrace_apply,
    cartier_monomial_nsmul_add (equivFunOnFinite_symm_sub_one_lt (expChar_ne_zero R p)) hs]
  have : (s = equivFunOnFinite.symm fun _ ↦ p - 1) ↔ ∀ i, s i = p - 1 := by
    simp [Finsupp.ext_iff]
  simp only [this]
  split_ifs <;> simp

/-- **The Frobenius trace sends the anticanonical section `(X₁ ⋯ Xₙ) ^ (p - 1)` to `1`.** -/
@[simp]
theorem frobeniusTrace_prod_X_pow : frobeniusTrace σ R p ((∏ i, X i) ^ (p - 1)) = 1 := by
  have : NeZero p := ⟨expChar_ne_zero R p⟩
  simpa [prod_X_pow_eq_monomial_equivFunOnFinite_symm] using
    frobeniusTrace_monomial_nsmul_add (σ := σ) (R := R) (p := p)
      (s := equivFunOnFinite.symm fun _ ↦ p - 1)
      (equivFunOnFinite_symm_sub_one_lt (expChar_ne_zero R p)) 0 1

/-- The splitting `f ↦ frobeniusTrace p ((X₁ ⋯ Xₙ) ^ (p - 1) * f)` takes the `p`-th roots of the
coefficients at the exponents divisible by `p`. -/
theorem coeff_frobeniusTrace_prod_X_pow_mul (f : MvPolynomial σ R) (d : σ →₀ ℕ) :
    (frobeniusTrace σ R p ((∏ i, X i) ^ (p - 1) * f)).coeff d =
      (frobeniusEquiv R p).symm (f.coeff (p • d)) := by
  rw [prod_X_pow_eq_monomial_equivFunOnFinite_symm, coeff_frobeniusTrace, add_comm,
    coeff_monomial_mul, one_mul]

/-- **The standard splitting of affine space is compatible with the coordinate subspaces**: the
map `f ↦ frobeniusTrace p ((X₁ ⋯ Xₙ) ^ (p - 1) * f)` sends the ideal generated by any set of
variables into itself. -/
theorem frobeniusTrace_prod_X_pow_mul_mem_ideal_span_X_image {s : Set σ} {f : MvPolynomial σ R}
    (hf : f ∈ Ideal.span (X '' s)) :
    frobeniusTrace σ R p ((∏ i, X i) ^ (p - 1) * f) ∈ Ideal.span (X '' s) := by
  rw [mem_ideal_span_X_image] at hf ⊢
  intro m hm
  rw [MvPolynomial.mem_support_iff, coeff_frobeniusTrace_prod_X_pow_mul, ne_eq,
    EmbeddingLike.map_eq_zero_iff, ← ne_eq, ← MvPolynomial.mem_support_iff] at hm
  obtain ⟨i, hi, hmi⟩ := hf _ hm
  exact ⟨i, hi, fun h ↦ hmi (by simp [h])⟩

/-- A `p⁻¹`-linear additive map is determined by its values on the monomials with exponents below
`p`. -/
private theorem eq_sum_of_map_pow_mul [DecidableEq σ] [NeZero p]
    (ψ : MvPolynomial σ R →+ MvPolynomial σ R) (hψ : ∀ g f, ψ (g ^ p * f) = g * ψ f)
    (f : MvPolynomial σ R) :
    ψ f = ∑ β : σ →₀ Fin p, map (frobeniusEquiv R p).symm
      (cartier R p (β.mapRange Fin.val (Fin.val_zero p)) f) *
        ψ (monomial (β.mapRange Fin.val (Fin.val_zero p)) 1) := by
  conv_lhs => rw [← sum_monomial_mul_expand_cartier (n := p) f]
  simp only [map_sum, expand_eq_map_frobeniusEquiv_symm_pow, mul_comm (monomial _ _), hψ]

end Fintype

/-- The trace of `X ^ (ρ - γ + β)` for residues `β` and `γ` modulo `p` is `1` if `β = γ`, and `0`
otherwise. -/
private theorem frobeniusTrace_monomial_tsub_add [Finite σ] [DecidableEq σ] [NeZero p]
    (β γ : σ →₀ Fin p) :
    frobeniusTrace σ R p (monomial ((equivFunOnFinite.symm fun _ ↦ p - 1) -
      γ.mapRange Fin.val (Fin.val_zero p) + β.mapRange Fin.val (Fin.val_zero p)) 1) =
      if γ = β then 1 else 0 := by
  have := Fintype.ofFinite σ
  by_cases hγβ : γ = β
  · subst hγβ
    rw [tsub_add_cancel_of_le (fun i ↦ by simpa using Nat.le_sub_one_of_lt (γ i).isLt),
      ← prod_X_pow_eq_monomial_equivFunOnFinite_symm, frobeniusTrace_prod_X_pow]
    simp
  simp only [hγβ, ↓reduceIte]
  ext d
  classical
  rw [coeff_frobeniusTrace, coeff_monomial, ite_eq_right_iff.2 fun he ↦ (hγβ ?_).elim, map_zero]
  · simp
  refine Finsupp.ext fun i ↦ ?_
  have hi := DFunLike.congr_fun he i
  have hβ := (β i).isLt
  have hγ := (γ i).isLt
  simp only [coe_add, coe_tsub, coe_smul, Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul,
    coe_equivFunOnFinite_symm, mapRange_apply] at hi
  rcases Nat.eq_zero_or_pos (d i) with h0 | hpos
  · rw [h0] at hi
    exact Fin.ext (by omega)
  · have := Nat.le_mul_of_pos_right p hpos
    omega

section Fintype

variable [Fintype σ] [DecidableEq σ]

variable (p) in
/-- The polynomial `∑_γ φ (X ^ γ) ^ p * X ^ (ρ - γ)`, with `γ` running over the residues modulo
`p`, that represents a `p⁻¹`-linear additive endomorphism `φ` of `R[X_i]` through the Frobenius
trace (`MvPolynomial.frobeniusTrace_frobeniusTraceDual_mul`). It is dual to the basis
`X ^ β`, `β < p`, of `R[X_i]` over the subring of `p`-th powers. -/
noncomputable def frobeniusTraceDual (φ : MvPolynomial σ R →+ MvPolynomial σ R) :
    MvPolynomial σ R :=
  have : NeZero p := ⟨expChar_ne_zero R p⟩
  ∑ γ : σ →₀ Fin p, φ (monomial (γ.mapRange Fin.val (Fin.val_zero p)) 1) ^ p *
    monomial ((equivFunOnFinite.symm fun _ ↦ p - 1) - γ.mapRange Fin.val (Fin.val_zero p)) 1

/-- **The Frobenius trace represents every `p⁻¹`-linear additive endomorphism**: such a `φ` is
`f ↦ frobeniusTrace p (frobeniusTraceDual p φ * f)`. -/
theorem frobeniusTrace_frobeniusTraceDual_mul {φ : MvPolynomial σ R →+ MvPolynomial σ R}
    (hφ : ∀ g f, φ (g ^ p * f) = g * φ f) (f : MvPolynomial σ R) :
    frobeniusTrace σ R p (frobeniusTraceDual p φ * f) = φ f := by
  have : NeZero p := ⟨expChar_ne_zero R p⟩
  have hdual (β : σ →₀ Fin p) :
      frobeniusTrace σ R p
          (frobeniusTraceDual p φ * monomial (β.mapRange Fin.val (Fin.val_zero p)) 1) =
        φ (monomial (β.mapRange Fin.val (Fin.val_zero p)) 1) := by
    simp [frobeniusTraceDual, Finset.sum_mul, mul_assoc, frobeniusTrace_pow_mul,
      monomial_mul_monomial, frobeniusTrace_monomial_tsub_add]
  have := eq_sum_of_map_pow_mul
    ((frobeniusTrace σ R p).comp (AddMonoidHom.mulLeft (frobeniusTraceDual p φ)))
    (fun g f ↦ by
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddMonoidHom.coe_mulLeft]
      rw [mul_left_comm, frobeniusTrace_pow_mul]) f
  simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddMonoidHom.coe_mulLeft, hdual] at this
  rw [this, eq_sum_of_map_pow_mul φ hφ f]

end Fintype

/-- **Every `p⁻¹`-linear additive endomorphism of `R[X_i]` is `f ↦ frobeniusTrace p (h * f)` for
a unique polynomial `h`.** This is the affine-space case of `Hom(F_* O, O) ≅ F_* (ω ^ (1 - p))`;
the polynomial is `MvPolynomial.frobeniusTraceDual p φ`. -/
theorem existsUnique_eq_frobeniusTrace_mul [Finite σ] (φ : MvPolynomial σ R →+ MvPolynomial σ R)
    (hφ : ∀ g f, φ (g ^ p * f) = g * φ f) :
    ∃! h : MvPolynomial σ R, ∀ f, φ f = frobeniusTrace σ R p (h * f) := by
  classical
  have := Fintype.ofFinite σ
  have hex (f : MvPolynomial σ R) : φ f = frobeniusTrace σ R p (frobeniusTraceDual p φ * f) :=
    (frobeniusTrace_frobeniusTraceDual_mul hφ f).symm
  exact ⟨_, hex, fun h' hh' ↦ eq_of_forall_frobeniusTrace_mul_eq fun f ↦ (hh' f).symm.trans (hex f)⟩

end FrobeniusTrace

end MvPolynomial
