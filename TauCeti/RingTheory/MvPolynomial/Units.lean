/-!
# Homogeneous units of weighted polynomial rings and their localizations

Give `MvPolynomial σ R` the weighted grading `weightedHomogeneousSubmodule R w` associated to a
weight function `w : σ → M` with values in an additive commutative group `M`. Over any nontrivial
commutative semiring `R`, evaluating at `0` sends any unit of `R[σ]` to a unit of `R`, so the
constant term of a unit cannot vanish and every homogeneous unit has weight `0`:
`homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥`, with shift class group `M`. No
domain, reducedness, or positivity assumption on the weights is needed.

When `R` is an integral domain and `f ∈ R[σ]` is a prime weighted-homogeneous polynomial of weight
`e` (or a finite product `∏ j ∈ s, p j` of prime weighted-homogeneous polynomials of weights `d j`),
the units of a localization away from `f` are the constant units times integer powers of `f`
(`Prime.isUnit_mvPolynomial_away_iff`), and the degrees of the homogeneous units of
`Localization.Away f` under `awayGrading` are `AddSubgroup.zmultiples e` (respectively the subgroup
generated by the `d j`). For integer weights `w : σ → ℤ` and a prime `f` of weight `e`, the shift
class group of `Localization.Away f` is `ZMod e.natAbs`: geometrically, this classifies the
`𝔾_m`-linearized trivial line bundles on the invariant open complement `D(f)` inside weighted
affine space `𝔸^σ`.

Note that Mathlib's `MvPolynomial.weightedGradedAlgebra` and
`MvPolynomial.WeightedHomogeneousSubmodule.gradedMonoid` are not global instances (to avoid a
diamond with `MvPolynomial.gradedAlgebra` at `w = 1`); callers stating `awayGrading` on
`weightedHomogeneousSubmodule R w` install either one as a `local instance`, and the two agree
definitionally on `SetLike.GradedMonoid`.

## Main results

* `Prime.isUnit_mvPolynomial_away_iff`: over a commutative ring `R` without zero divisors, the units
  of a localization of `MvPolynomial σ R` away from a prime `f` are the `C c * f ^ m` with `c` a
  unit of `R` and `m : ℤ`.
* `TauCeti.homogeneousUnitDegrees_weightedHomogeneousSubmodule`: over a nontrivial commutative
  semiring, `homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥`.
* `TauCeti.shiftClassGroupWeightedEquiv`: the shift class group of
  `weightedHomogeneousSubmodule R w` is `M`.
* `TauCeti.homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prod_prime` and
  `TauCeti.homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime`: the
  homogeneous unit degrees of `Localization.Away f` when `f` is a product of weighted-homogeneous
  primes or a single weighted-homogeneous prime.
* `TauCeti.homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_prod_X` and
  `TauCeti.homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_X`: specializations to
  products of coordinate hyperplanes and single variables `X i`.
* `TauCeti.shiftClassGroupWeightedAwayPrimeEquiv`: for `w : σ → ℤ` and a prime `f` of weight `e`,
  `ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hf) ≃+ ZMod e.natAbs`.
-/

public section

namespace Prime

open MvPolynomial

/-- **Units of a polynomial ring localized at a prime.** Over a commutative ring `R` without zero
divisors, an element of a localization `S` of `MvPolynomial σ R` away from a prime polynomial `f`
is a unit if and only if it has the form `algebraMap _ S (C c) * selfZPow f S m` with `c` a unit of
`R` and `m : ℤ`. -/
theorem isUnit_mvPolynomial_away_iff {σ R S : Type*} [CommRing R] [NoZeroDivisors R]
    [CommSemiring S] [Algebra (MvPolynomial σ R) S] {f : MvPolynomial σ R} (hf : Prime f)
    [IsLocalization.Away f S] {y : S} :
    IsUnit y ↔ ∃ c : R, IsUnit c ∧
      ∃ m : ℤ, algebraMap (MvPolynomial σ R) S (C c) * selfZPow f S m = y := by
  rw [hf.isUnit_away_iff]
  constructor
  · rintro ⟨u, hu, m, rfl⟩
    obtain ⟨c, hc, rfl⟩ := isUnit_iff_eq_C_of_isReduced.mp hu
    exact ⟨c, hc, m, rfl⟩
  · rintro ⟨c, hc, m, rfl⟩
    exact ⟨C c, hc.map C, m, rfl⟩

end Prime

namespace TauCeti

open MvPolynomial TauCeti.GradedAlgebra

attribute [local instance] MvPolynomial.WeightedHomogeneousSubmodule.gradedMonoid

section Nontrivial

variable {σ R M : Type*} [CommSemiring R] [Nontrivial R] [AddCommGroup M]

/-- **Homogeneous unit degrees of a weighted polynomial ring.** For any weights `w : σ → M` over a
nontrivial commutative semiring `R`, every homogeneous unit of `MvPolynomial σ R` has weight `0`:
`homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥`. -/
@[simp]
theorem homogeneousUnitDegrees_weightedHomogeneousSubmodule (w : σ → M) :
    homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥ := by
  rw [eq_bot_iff, homogeneousUnitDegrees_le_iff]
  intro u d hu
  -- Evaluating at `0` maps the unit `u` to a unit of `R`, so its constant term is nonzero.
  have hc0 : (u : MvPolynomial σ R).coeff 0 ≠ 0 := by
    rw [← constantCoeff_eq]
    exact (u.isUnit.map constantCoeff).ne_zero
  rw [AddSubgroup.mem_bot, ← hu hc0, map_zero]

/-- For any weights `w : σ → M` over a nontrivial commutative semiring `R`, the shift class group of
`MvPolynomial σ R` is `M`: distinct shifts are never graded-isomorphic. -/
noncomputable def shiftClassGroupWeightedEquiv (w : σ → M) :
    ShiftClassGroup (weightedHomogeneousSubmodule R w) ≃+ M :=
  (QuotientAddGroup.quotientAddEquivOfEq
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule w)).trans
    QuotientAddGroup.quotientBot

/-- `shiftClassGroupWeightedEquiv` evaluates on the class of `d : M` as `d`. -/
@[simp]
theorem shiftClassGroupWeightedEquiv_mk (w : σ → M) (d : M) :
    shiftClassGroupWeightedEquiv (R := R) w d = d :=
  -- Both quotient equivalences act as the identity on representatives.
  (rfl)

/-- The inverse of `shiftClassGroupWeightedEquiv` sends `d : M` to its shift class. -/
@[simp]
theorem shiftClassGroupWeightedEquiv_symm_apply (w : σ → M) (d : M) :
    (shiftClassGroupWeightedEquiv (R := R) w).symm d = d :=
  (rfl)

end Nontrivial

section Domain

variable {σ R M : Type*} [CommSemiring R] [IsCancelAdd R] [IsDomain R] [AddCommGroup M]

/-- **Homogeneous unit degrees after inverting a product of weighted-homogeneous primes.** Over a
domain `R`, if `f = ∏ j ∈ s, p j` in `MvPolynomial σ R` is a product of prime weighted-homogeneous
polynomials `p j` of weights `d j`, then the homogeneous unit degrees of `Localization.Away f` are
generated by the weights `d j` (`j ∈ s`). -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prod_prime
    {w : σ → M} {J : Type*} {s : Finset J} {p : J → MvPolynomial σ R} {d : J → M}
    {f : MvPolynomial σ R} {e : M} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hp : ∀ j ∈ s, Prime (p j))
    (hp_mem : ∀ j ∈ s, p j ∈ weightedHomogeneousSubmodule R w (d j))
    (hprod : ∏ j ∈ s, p j = f) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.closure (d '' (s : Set J)) := by
  classical
  let _ := MvPolynomial.weightedGradedAlgebra R w
  rw [homogeneousUnitDegrees_awayGrading_of_prod_prime (weightedHomogeneousSubmodule R w) hf
    hp hp_mem hprod, homogeneousUnitDegrees_weightedHomogeneousSubmodule, bot_sup_eq]

/-- **Homogeneous unit degrees after inverting a weighted-homogeneous prime.** Over a domain `R`, if
`f ∈ MvPolynomial σ R` is prime and weighted homogeneous of weight `e`, then the homogeneous unit
degrees of `Localization.Away f` are the integer multiples of `e`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime
    {w : σ → M} {f : MvPolynomial σ R} {e : M} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hp : Prime f) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples e := by
  classical
  let _ := MvPolynomial.weightedGradedAlgebra R w
  rw [homogeneousUnitDegrees_awayGrading_of_prime (weightedHomogeneousSubmodule R w) hf hp,
    homogeneousUnitDegrees_weightedHomogeneousSubmodule, bot_sup_eq]

end Domain

section CommRingDomain

variable {σ R M : Type*} [CommRing R] [IsDomain R] [AddCommGroup M]

/-- Inverting a finite product of variables `∏ j ∈ s, X (g j)` in `MvPolynomial σ R` over a
commutative integral domain `R` produces homogeneous unit degrees generated by their weights
`w (g j)`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_prod_X
    {w : σ → M} {J : Type*} {s : Finset J} {g : J → σ} {e : M}
    (hf : ∏ j ∈ s, X (R := R) (g j) ∈ weightedHomogeneousSubmodule R w e) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.closure ((w ∘ g) '' (s : Set J)) :=
  homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prod_prime hf
    (fun _ _ ↦ prime_X) (fun j _ ↦ isWeightedHomogeneous_X R w (g j)) rfl

/-- Inverting a single variable `X i` in `MvPolynomial σ R` over a commutative integral domain `R`
produces homogeneous unit degrees `AddSubgroup.zmultiples (w i)`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_X
    {w : σ → M} {i : σ} {e : M}
    (hf : X (R := R) i ∈ weightedHomogeneousSubmodule R w e) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples (w i) := by
  rw [homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime hf prime_X,
    IsWeightedHomogeneous.inj_right (X_ne_zero i) hf (isWeightedHomogeneous_X R w i)]

end CommRingDomain

section ShiftClassGroup

attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable {σ R : Type*} [CommSemiring R] [IsCancelAdd R] [IsDomain R]

/-- **Shift class group of weighted affine space minus an irreducible invariant divisor.** Over a
domain `R`, for weights `w : σ → ℤ` and a prime weighted-homogeneous polynomial `f` of weight `e`,
the shift class group of `Localization.Away f` is `ZMod e.natAbs`. -/
noncomputable def shiftClassGroupWeightedAwayPrimeEquiv {w : σ → ℤ}
    {f : MvPolynomial σ R} {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hp : Prime f) :
    ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hf) ≃+ ZMod e.natAbs :=
  shiftClassGroupAwayGradingEquiv
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule w) hf hp

/-- The identification of the shift classes of `(MvPolynomial σ R)_f` with `ZMod |e|` sends the
class of a shift `d` to `d mod |e|`. -/
@[simp]
theorem shiftClassGroupWeightedAwayPrimeEquiv_mk {w : σ → ℤ}
    {f : MvPolynomial σ R} {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hp : Prime f) (d : ℤ) :
    shiftClassGroupWeightedAwayPrimeEquiv hf hp d = d := by
  simp [shiftClassGroupWeightedAwayPrimeEquiv]

/-- The inverse of `shiftClassGroupWeightedAwayPrimeEquiv` sends `n : ZMod |e|` to the shift class
of `ZMod.cast n : ℤ`. -/
theorem shiftClassGroupWeightedAwayPrimeEquiv_symm_apply {w : σ → ℤ}
    {f : MvPolynomial σ R} {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hp : Prime f) (n : ZMod e.natAbs) :
    (shiftClassGroupWeightedAwayPrimeEquiv hf hp).symm n = (ZMod.cast n : ℤ) :=
  shiftClassGroupAwayGradingEquiv_symm_apply
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule w) hf hp n

/-- The inverse of `shiftClassGroupWeightedAwayPrimeEquiv` sends `(d : ZMod |e|)` to the shift class
of `d : ℤ`. -/
@[simp]
theorem shiftClassGroupWeightedAwayPrimeEquiv_symm_intCast {w : σ → ℤ}
    {f : MvPolynomial σ R} {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hp : Prime f) (d : ℤ) :
    (shiftClassGroupWeightedAwayPrimeEquiv hf hp).symm d = d :=
  (shiftClassGroupWeightedAwayPrimeEquiv hf hp).symm_apply_eq.mpr
    (shiftClassGroupWeightedAwayPrimeEquiv_mk hf hp d).symm

end ShiftClassGroup

end TauCeti
