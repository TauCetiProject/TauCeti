/-!
# Flag minors and Gelfand-Tsetlin patterns

The **flag minor** `TauCeti.flagMinor R I` of the generic `n × n` matrix `Z = (z_{r,c})` on a
set `I = {i_0 < ⋯ < i_{d-1}}` of rows is its minor on the rows of `I` and the first `d` columns.
For the row-major lexicographic order on the variables, in which `z_{0,0}` is the largest variable,
it is monic with leading monomial the main diagonal `∏_{c < d} z_{i_c, c}`, whose exponent is
`TauCeti.flagExponent I`.

An exponent `e` of the variables `z_{r,c}` gives the cumulative-sum array
`λ_{c,j} = ∑_{r < j} e(r, c)` on the cells `c < n`, `j ≤ n` (`TauCeti.exponentPattern`): row `j`
records, column by column, the degree of `e` in the first `j` rows. It sends the diagonal exponent
of the flag minor on `I` to the row-subset pattern `TauCeti.GTPattern.rowSubset I`. Since the
row-subset patterns generate the nonnegative Gelfand-Tsetlin patterns, the monoid generated by
the leading exponents of the flag minors is carried onto the monoid of nonnegative patterns.
The cumulative-sum map is injective: every exponent is recovered from its array by the successive
differences `e(r, c) = λ_{c,r+1} - λ_{c,r}`. Thus the monoid generated by the leading exponents
of the flag minors is isomorphic to the monoid of nonnegative Gelfand-Tsetlin patterns
(`TauCeti.flagExponentEquiv`). This is the combinatorial half of the identification of the
initial algebra of the flag-minor algebra with the semigroup algebra of patterns; the other half
is that the flag minors form a SAGBI basis.

## Main definitions

* `TauCeti.flagMinor R I`: the flag minor of the generic matrix on the rows `I`.
* `TauCeti.flagExponent I`: the exponent of the main diagonal of the flag minor on `I`.
* `TauCeti.exponentPattern`: the array `λ_{c,j} = ∑_{r < j} e(r, c)` of an exponent `e`.
* `TauCeti.flagExponentEquiv`: the additive equivalence between the monoid generated by the
  flag exponents and the nonnegative Gelfand-Tsetlin patterns.

## Main results

* `TauCeti.degree_rename_toLex_flagMinor` and `TauCeti.monic_rename_toLex_flagMinor`:
  the flag minor is monic with leading exponent `TauCeti.flagExponent I`.
* `TauCeti.exponentPattern_flagExponent`: the array of the flag exponent of `I` is the
  row-subset pattern of `I`.
* `TauCeti.map_exponentPattern_closure_range_flagExponent`: the arrays of the monoid generated by
  the flag exponents are exactly the nonnegative Gelfand-Tsetlin patterns.
* `TauCeti.exponentPattern_add_one_sub`: every exponent is recovered from its array by
  successive differences (`TauCeti.exponentPattern_injective`).

## References

* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 14 (flag minors, diagonal term orders and Gelfand-Tsetlin patterns).
* M. Kogan and E. Miller, *Toric degeneration of Schubert varieties and Gelfand-Tsetlin
  polytopes*, Adv. Math. **193** (2005), 1-17.
-/

public section

open Finset MonomialOrder

namespace TauCeti

variable {n : ℕ}

/-! ### The diagonal exponent of a flag minor -/

/-- The exponent of the main diagonal `∏_{c < #I} z_{i_c, c}` of the flag minor on the rows
`I = {i_0 < ⋯}`, as an exponent of the lexicographically ordered variables. -/
noncomputable def flagExponent (I : Finset (Fin n)) : Fin n ×ₗ Fin n →₀ ℕ :=
  ∑ c : Fin #I,
    Finsupp.single (toLex (I.orderEmbOfFin rfl c, Fin.castLE (I.card_le_univ.trans_eq
      (Fintype.card_fin n)) c)) 1

/-- The diagonal exponent is the sum of the exponents of its diagonal variables. -/
theorem flagExponent_def (I : Finset (Fin n)) :
    flagExponent I = ∑ c : Fin #I,
      Finsupp.single (toLex (I.orderEmbOfFin rfl c, Fin.castLE (I.card_le_univ.trans_eq
        (Fintype.card_fin n)) c)) 1 := by
  rw [flagExponent]

/-- The flag exponent of `I` has entry one at `(i_c, c)` for each `c < #I`, and zero elsewhere. -/
private theorem flagExponent_apply_sum (I : Finset (Fin n)) (r c : Fin n) :
    flagExponent I (toLex (r, c)) =
      ∑ c' : Fin #I, if I.orderEmbOfFin rfl c' = r ∧ (c' : ℕ) = c then 1 else 0 := by
  rw [flagExponent, Finset.sum_apply']
  refine Finset.sum_congr rfl fun c' _ ↦ ?_
  rw [Finsupp.single_apply]
  simp only [EmbeddingLike.apply_eq_iff_eq, Prod.mk.injEq, Fin.ext_iff, Fin.val_castLE]

/-- The flag exponent is the indicator of the diagonal positions selected by the row subset. -/
theorem flagExponent_apply (I : Finset (Fin n)) (r c : Fin n) :
    flagExponent I (toLex (r, c)) =
      if h : (c : ℕ) < #I then
        if I.orderEmbOfFin rfl ⟨c, h⟩ = r then 1 else 0
      else 0 := by
  rw [flagExponent_apply_sum]
  by_cases hc : (c : ℕ) < #I
  · rw [dite_eq_left hc, Finset.sum_eq_single ⟨c, hc⟩]
    · simp
    · intro c' _ hc'
      exact ite_eq_right_iff.2 fun h ↦ (hc' (Fin.ext h.2)).elim
    · simp
  · rw [dite_eq_right hc]
    exact Finset.sum_eq_zero fun c' _ ↦ ite_eq_right_iff.2
      fun h ↦ (hc (h.2 ▸ c'.2)).elim

/-- The empty row subset has zero diagonal exponent. -/
@[simp]
theorem flagExponent_empty : flagExponent (∅ : Finset (Fin n)) = 0 := by
  simp [flagExponent_def]

/-- The full row subset has the exponent of the product of diagonal entries. -/
theorem flagExponent_univ :
    flagExponent (univ : Finset (Fin n)) = ∑ c : Fin n, Finsupp.single (toLex (c, c)) 1 := by
  rw [flagExponent_def]
  apply Fintype.sum_equiv (finCongr (by simp))
  intro c
  rw [orderEmbOfFin_univ_apply]
  rfl

/-- A singleton row subset selects its entry in the first column. -/
@[simp]
theorem flagExponent_singleton (r : Fin n) :
    flagExponent {r} = Finsupp.single (toLex (r, ⟨0, r.pos⟩)) 1 := by
  have : Unique (Fin #{r}) := by
    rw [card_singleton]
    infer_instance
  rw [flagExponent_def, Fintype.sum_unique]
  congr 2
  apply Prod.ext
  · exact mem_singleton.1 (orderEmbOfFin_mem {r} rfl _)
  · apply Fin.ext
    have := (default : Fin #{r}).2
    simp only [card_singleton] at this
    simpa using Nat.eq_zero_of_le_zero (Nat.le_of_lt_succ this)

/-- The flag exponents do not involve the variables `z_{r,c}` with `r < c`. -/
theorem flagExponent_apply_eq_zero_of_lt (I : Finset (Fin n)) {r c : Fin n} (hrc : r < c) :
    flagExponent I (toLex (r, c)) = 0 := by
  rw [flagExponent_apply_sum]
  refine Finset.sum_eq_zero fun c' _ ↦ ite_eq_right_iff.2 fun ⟨hr, hc⟩ ↦ ?_
  have := I.val_le_val_orderEmbOfFin rfl c'
  rw [hr, hc] at this
  exact ((Fin.lt_def.1 hrc).not_ge this).elim

/-! ### The pattern of an exponent -/

/-- The cumulative-sum array `λ_{c,j} = ∑_{r < j} e(r, c)` of an exponent `e` of the variables
`z_{r,c}` of the generic `n × n` matrix, on the cells `c < n`, `j ≤ n`, and zero elsewhere. Row `j`
records, column by column, the degree of `e` in the first `j` rows of the matrix. -/
noncomputable def exponentPattern : (Fin n ×ₗ Fin n →₀ ℕ) →+ ℕ → ℕ → ℤ where
  toFun e c j :=
    if h : c < n ∧ j ≤ n then ∑ r : Fin n with r.val < j, (e (toLex (r, ⟨c, by omega⟩)) : ℤ)
    else 0
  map_zero' := by
    funext c j
    split_ifs <;> simp
  map_add' e e' := by
    funext c j
    simp only [Pi.add_apply]
    split_ifs
    · simp [sum_add_distrib]
    · simp

/-- On a matrix column and within the matrix rows, the array is the cumulative column sum. -/
theorem exponentPattern_apply (e : Fin n ×ₗ Fin n →₀ ℕ) (c : Fin n) {j : ℕ} (hj : j ≤ n) :
    exponentPattern e c j = ∑ r : Fin n with r.val < j, (e (toLex (r, c)) : ℤ) :=
  dite_eq_left ⟨c.2, hj⟩

/-- The array vanishes beyond the matrix columns. -/
@[simp]
theorem exponentPattern_apply_of_le (e : Fin n ×ₗ Fin n →₀ ℕ) {c j : ℕ} (hc : n ≤ c) :
    exponentPattern e c j = 0 :=
  dite_eq_right (fun h ↦ (not_lt_of_ge hc) h.1)

/-- The array vanishes beyond the matrix rows. -/
@[simp]
theorem exponentPattern_apply_of_lt (e : Fin n ×ₗ Fin n →₀ ℕ) {c j : ℕ} (hj : n < j) :
    exponentPattern e c j = 0 :=
  dite_eq_right (fun h ↦ (not_le_of_gt hj) h.2)

/-- The cumulative sum before the first matrix row is zero. -/
@[simp]
theorem exponentPattern_apply_zero (e : Fin n ×ₗ Fin n →₀ ℕ) (c : ℕ) :
    exponentPattern e c 0 = 0 := by
  by_cases hc : c < n
  · rw [exponentPattern_apply e ⟨c, hc⟩ (Nat.zero_le n)]
    simp
  · exact exponentPattern_apply_of_le e (not_lt.1 hc)

/-- Cumulative sums of natural exponents are nonnegative. -/
theorem exponentPattern_nonneg (e : Fin n ×ₗ Fin n →₀ ℕ) : 0 ≤ exponentPattern e := by
  intro c j
  -- Expose the guarded sum through the homomorphism coercion before splitting its condition.
  change 0 ≤ if h : c < n ∧ j ≤ n then _ else _
  split_ifs
  · exact Finset.sum_nonneg fun _ _ ↦ Int.natCast_nonneg _
  · exact le_rfl

/-- **The array of the flag exponent of `I` is the row-subset pattern of `I`.** -/
@[simp]
theorem exponentPattern_flagExponent (I : Finset (Fin n)) :
    exponentPattern (flagExponent I) = ⇑(GTPattern.rowSubset I) := by
  funext c j
  rw [GTPattern.rowSubset_apply]
  by_cases h : c < n ∧ j ≤ n
  · rw [exponentPattern_apply _ ⟨c, h.1⟩ h.2]
    simp only [h.2, true_and, flagExponent_apply_sum, Nat.cast_sum, Nat.cast_ite, Nat.cast_one,
      Nat.cast_zero]
    rw [sum_comm]
    -- Only the `c`-th element of `I` contributes, provided that it lies below row `j`.
    have hinner (c' : Fin #I) : (∑ r : Fin n with r.val < j,
        if I.orderEmbOfFin rfl c' = r ∧ (c' : ℕ) = c then (1 : ℤ) else 0) =
        if (c' : ℕ) = c ∧ ((I.orderEmbOfFin rfl c' : Fin n) : ℕ) < j then 1 else 0 := by
      by_cases hc' : (c' : ℕ) = c <;> simp [hc', Finset.sum_ite_eq]
    simp only [hinner]
    by_cases hcI : c < #I
    · rw [Finset.sum_eq_single ⟨c, hcI⟩ (fun c' _ hc' ↦ ite_eq_right_iff.2 fun h' ↦
        absurd (Fin.ext h'.1) hc') (by simp)]
      have := I.lt_card_filter_iff_orderEmbOfFin rfl ⟨c, hcI⟩ (fun r : Fin n ↦ r.val < j)
        fun _ _ _ _ hle hx ↦ (Fin.le_def.1 hle).trans_lt hx
      simp [← this]
    · rw [Finset.sum_eq_zero fun (c' : Fin #I) _ ↦ ite_eq_right_iff.2
          fun (h' : (c' : ℕ) = c ∧ _) ↦ absurd (h'.1 ▸ c'.2) hcI,
        ite_eq_right_iff.2 fun (h' : c < #{r ∈ I | r.val < j}) ↦
          absurd (h'.trans_le (card_le_card (filter_subset _ _))) hcI]
  · have hz : exponentPattern (flagExponent I) c j = 0 := dite_eq_right h
    rw [hz, eq_comm, ite_eq_right_iff]
    intro h'
    have := (card_le_card (filter_subset (fun r : Fin n ↦ r.val < j) I)).trans
      (I.card_le_univ.trans_eq (Fintype.card_fin n))
    omega

/-- Distinct row subsets give distinct diagonal exponents. -/
theorem flagExponent_injective : Function.Injective (flagExponent (n := n)) := by
  intro I J h
  apply GTPattern.rowSubset_injective
  apply DFunLike.coe_injective
  simpa only [exponentPattern_flagExponent] using congrArg exponentPattern h

/-! ### The monoid generated by the flag exponents -/

/-- **The arrays of the monoid generated by the flag exponents are exactly the nonnegative
Gelfand-Tsetlin patterns.** -/
theorem map_exponentPattern_closure_range_flagExponent :
    (AddSubmonoid.closure (Set.range (flagExponent (n := n)))).map exponentPattern =
      (AddSubmonoid.nonneg (GTPattern n)).map GTPattern.coeFnAddMonoidHom := by
  rw [AddMonoidHom.map_mclosure, ← GTPattern.closure_range_rowSubset, AddMonoidHom.map_mclosure,
    ← Set.range_comp, ← Set.range_comp]
  congr 2
  funext I
  rw [Function.comp_apply, Function.comp_apply, GTPattern.coeFnAddMonoidHom_apply,
    exponentPattern_flagExponent]

/-- The elements of the monoid generated by the flag exponents do not involve the variables
`z_{r,c}` with `r < c`. -/
theorem apply_toLex_eq_zero_of_mem_closure_range_flagExponent {e : Fin n ×ₗ Fin n →₀ ℕ}
    (he : e ∈ AddSubmonoid.closure (Set.range flagExponent)) {r c : Fin n} (hrc : r < c) :
    e (toLex (r, c)) = 0 := by
  induction he using AddSubmonoid.closure_induction with
  | mem _ h =>
    obtain ⟨I, rfl⟩ := h
    exact flagExponent_apply_eq_zero_of_lt I hrc
  | zero => rfl
  | add _ _ _ _ h₁ h₂ => rw [Finsupp.add_apply, h₁, h₂]

/-- **Successive differences.** The exponent of `z_{r,c}` is the difference
`λ_{c,r+1} - λ_{c,r}` of two consecutive cumulative column sums. -/
theorem exponentPattern_add_one_sub (e : Fin n ×ₗ Fin n →₀ ℕ) (r c : Fin n) :
    exponentPattern e c (r + 1) - exponentPattern e c r = e (toLex (r, c)) := by
  rw [exponentPattern_apply e c r.2, exponentPattern_apply e c r.2.le,
    sum_filter, sum_filter, ← sum_sub_distrib, Finset.sum_eq_single r]
  · simp
  · intro r' _ hr'
    have : (r' : ℕ) ≠ r := fun h ↦ hr' (Fin.ext h)
    split_ifs <;> omega
  · simp

/-- Cumulative column sums determine every exponent. -/
theorem exponentPattern_injective : Function.Injective (exponentPattern (n := n)) := by
  intro e e' h
  ext x
  rw [← toLex_ofLex x]
  exact_mod_cast (exponentPattern_add_one_sub e _ _).symm.trans
    (h ▸ exponentPattern_add_one_sub e' _ _)

/-- An exponent is generated by flag exponents exactly when its cumulative column sums form
a nonnegative Gelfand-Tsetlin pattern. -/
theorem mem_closure_range_flagExponent_iff (e : Fin n ×ₗ Fin n →₀ ℕ) :
    e ∈ AddSubmonoid.closure (Set.range flagExponent) ↔
      ∃ P : GTPattern n, 0 ≤ P ∧ ⇑P = exponentPattern e := by
  rw [← AddSubmonoid.mem_map_iff_mem exponentPattern_injective,
    map_exponentPattern_closure_range_flagExponent]
  simp only [AddSubmonoid.mem_map, AddSubmonoid.mem_nonneg, GTPattern.coeFnAddMonoidHom_apply]

/-- **The monoid generated by the leading exponents of the flag minors is the monoid of
nonnegative Gelfand-Tsetlin patterns.** An exponent `e` is sent to the pattern
`λ_{c,j} = ∑_{r < j} e(r, c)`, and is recovered from it by successive differences
(`TauCeti.flagExponentEquiv_symm_apply`). -/
noncomputable def flagExponentEquiv :
    AddSubmonoid.closure (Set.range (flagExponent (n := n))) ≃+
      AddSubmonoid.nonneg (GTPattern n) :=
  ((AddSubmonoid.closure (Set.range (flagExponent (n := n)))).equivMapOfInjective
    exponentPattern exponentPattern_injective).trans
      ((AddEquiv.addSubmonoidCongr map_exponentPattern_closure_range_flagExponent).trans
        ((AddSubmonoid.nonneg (GTPattern n)).equivMapOfInjective
          GTPattern.coeFnAddMonoidHom (fun P Q h ↦ DFunLike.coe_injective (by
            simpa only [GTPattern.coeFnAddMonoidHom_apply] using h))).symm)

/-- The pattern corresponding to an exponent `e` is its array `λ_{c,j} = ∑_{r < j} e(r, c)`. -/
@[simp]
theorem coe_flagExponentEquiv_apply
    (e : AddSubmonoid.closure (Set.range (flagExponent (n := n)))) :
    ⇑(flagExponentEquiv e : GTPattern n) = exponentPattern (e : Fin n ×ₗ Fin n →₀ ℕ) := by
  have h := congrArg Subtype.val
    (((AddSubmonoid.nonneg (GTPattern n)).equivMapOfInjective
      GTPattern.coeFnAddMonoidHom (fun P Q h ↦ DFunLike.coe_injective (by
        simpa only [GTPattern.coeFnAddMonoidHom_apply] using h))).apply_symm_apply
          ((AddEquiv.addSubmonoidCongr map_exponentPattern_closure_range_flagExponent)
            (((AddSubmonoid.closure (Set.range (flagExponent (n := n)))).equivMapOfInjective
              exponentPattern exponentPattern_injective) e)))
  -- Normalize the local equivalence composition before rewriting the opaque imported homomorphism.
  change GTPattern.coeFnAddMonoidHom (flagExponentEquiv e : GTPattern n) =
    exponentPattern (e : Fin n ×ₗ Fin n →₀ ℕ) at h
  simpa only [GTPattern.coeFnAddMonoidHom_apply] using h

/-- On the generated monoid the cumulative sums vanish outside the pattern triangle. -/
@[simp]
theorem exponentPattern_apply_eq_zero_of_le {e : Fin n ×ₗ Fin n →₀ ℕ}
    (he : e ∈ AddSubmonoid.closure (Set.range flagExponent)) {c j : ℕ} (h : j ≤ c) :
    exponentPattern e c j = 0 := by
  rw [← coe_flagExponentEquiv_apply ⟨e, he⟩]
  exact GTPattern.entry_eq_zero_of_le _ h

/-- The flag exponent of `I` corresponds to the row-subset pattern of `I`. -/
@[simp]
theorem flagExponentEquiv_flagExponent (I : Finset (Fin n)) :
    flagExponentEquiv ⟨flagExponent I, AddSubmonoid.subset_closure ⟨I, rfl⟩⟩ =
      ⟨GTPattern.rowSubset I, GTPattern.zero_le_rowSubset I⟩ :=
  Subtype.ext <| DFunLike.coe_injective <| by
    rw [coe_flagExponentEquiv_apply, exponentPattern_flagExponent]

/-- Applying the cumulative-sum map to the inverse recovers the pattern entries. -/
@[simp]
theorem exponentPattern_flagExponentEquiv_symm (P : AddSubmonoid.nonneg (GTPattern n)) :
    exponentPattern (flagExponentEquiv.symm P : Fin n ×ₗ Fin n →₀ ℕ) = ⇑(P : GTPattern n) := by
  rw [← coe_flagExponentEquiv_apply, AddEquiv.apply_symm_apply]

/-- The inverse sends a row-subset pattern to its diagonal exponent. -/
@[simp]
theorem flagExponentEquiv_symm_rowSubset (I : Finset (Fin n)) :
    flagExponentEquiv.symm ⟨GTPattern.rowSubset I, GTPattern.zero_le_rowSubset I⟩ =
      ⟨flagExponent I, AddSubmonoid.subset_closure ⟨I, rfl⟩⟩ :=
  flagExponentEquiv.symm_apply_eq.2 (flagExponentEquiv_flagExponent I).symm

/-- **The inverse correspondence is given by successive differences:** the exponent of `z_{r,c}`
corresponding to a nonnegative pattern `λ` is `λ_{c,r+1} - λ_{c,r}`. -/
theorem flagExponentEquiv_symm_apply (P : AddSubmonoid.nonneg (GTPattern n)) (r c : Fin n) :
    ((flagExponentEquiv.symm P : Fin n ×ₗ Fin n →₀ ℕ) (toLex (r, c)) : ℤ) =
      (P : GTPattern n) c (r + 1) - (P : GTPattern n) c r := by
  rw [← exponentPattern_add_one_sub,
    ← coe_flagExponentEquiv_apply, AddEquiv.apply_symm_apply]

open MvPolynomial

variable {n : ℕ} (R : Type*) [CommRing R]

/-- The **flag minor** of the generic `n × n` matrix on a set `I` of rows: its minor on the rows
of `I`, in increasing order, and on the first `#I` columns. -/
noncomputable def flagMinor (I : Finset (Fin n)) : MvPolynomial (Fin n × Fin n) R :=
  Matrix.mvPolynomialMinor R (I.orderEmbOfFin rfl)
    (Fin.castLE (I.card_le_univ.trans_eq (Fintype.card_fin n)))

/-- The flag minor on `I` is the minor of the generic matrix on the rows of `I`, in increasing
order, and on the first `#I` columns. -/
theorem flagMinor_def (I : Finset (Fin n)) :
    flagMinor R I = Matrix.mvPolynomialMinor R (I.orderEmbOfFin rfl)
      (Fin.castLE (I.card_le_univ.trans_eq (Fintype.card_fin n))) := by
  rw [flagMinor]

variable {R}

/-- For the row-major lexicographic order on the variables, the leading exponent of the flag
minor on `I` is the exponent of its main diagonal. -/
@[simp]
theorem degree_rename_toLex_flagMinor [Nontrivial R] (I : Finset (Fin n)) :
    lex.degree (rename toLex (flagMinor R I)) = TauCeti.flagExponent I := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix]
  exact Matrix.degree_rename_toLex_det_submatrix_mvPolynomialX (I.orderEmbOfFin rfl).strictMono
    (Fin.strictMono_castLE _)

/-- For the row-major lexicographic order on the variables, every flag minor is monic. -/
@[simp]
theorem monic_rename_toLex_flagMinor (I : Finset (Fin n)) :
    lex.Monic (rename toLex (flagMinor R I)) := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix]
  exact Matrix.monic_rename_toLex_det_submatrix_mvPolynomialX (I.orderEmbOfFin rfl).strictMono
    (Fin.strictMono_castLE _)

/-- The leading term of a flag minor is its diagonal monomial. -/
@[simp]
theorem leadingTerm_rename_toLex_flagMinor (I : Finset (Fin n)) :
    lex.leadingTerm (rename toLex (flagMinor R I)) = monomial (flagExponent I) 1 := by
  nontriviality R
  rw [MonomialOrder.leadingTerm, degree_rename_toLex_flagMinor,
    (monic_rename_toLex_flagMinor I).leadingCoeff_eq_one]

/-- Every flag minor over a nontrivial coefficient ring is nonzero. -/
@[simp]
theorem flagMinor_ne_zero [Nontrivial R] (I : Finset (Fin n)) : flagMinor R I ≠ 0 := by
  intro h
  exact (monic_rename_toLex_flagMinor (R := R) I).ne_zero (by rw [h, map_zero])

/-- Distinct row subsets give distinct flag minors over a nontrivial coefficient ring. -/
theorem flagMinor_injective [Nontrivial R] : Function.Injective (flagMinor (n := n) R) := by
  intro I J h
  apply flagExponent_injective
  simpa only [degree_rename_toLex_flagMinor] using
    congrArg (fun p ↦ lex.degree (rename toLex p)) h

/-- The flag minor of the empty row subset is one. -/
@[simp]
theorem flagMinor_empty : flagMinor R (∅ : Finset (Fin n)) = 1 := by
  rw [flagMinor_def]
  have : IsEmpty (Fin #(∅ : Finset (Fin n))) := by
    simp only [card_empty]
    infer_instance
  exact Matrix.mvPolynomialMinor_zero _ _

/-- The flag minor of the full row subset is the determinant of the generic matrix. -/
@[simp]
theorem flagMinor_univ :
    flagMinor R (univ : Finset (Fin n)) = (Matrix.mvPolynomialX (Fin n) (Fin n) R).det := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix]
  convert Matrix.det_submatrix_equiv_self (finCongr (by simp : #(univ : Finset (Fin n)) = n))
    (Matrix.mvPolynomialX (Fin n) (Fin n) R) using 2
  ext i j
  simp only [Matrix.submatrix_apply, orderEmbOfFin_univ_apply]
  rfl

/-- A singleton flag minor is the corresponding variable in the first column. -/
@[simp]
theorem flagMinor_singleton (r : Fin n) : flagMinor R {r} = X (r, ⟨0, r.pos⟩) := by
  rw [flagMinor_def]
  have : Unique (Fin #{r}) := by
    simp only [card_singleton]
    infer_instance
  rw [Matrix.mvPolynomialMinor_one]
  congr 2
  · exact mem_singleton.1 (orderEmbOfFin_mem {r} rfl _)
  · apply Fin.ext
    have := (default : Fin #{r}).2
    simp only [card_singleton] at this
    simpa using Nat.eq_zero_of_le_zero (Nat.le_of_lt_succ this)

/-- Flag minors commute with a change of coefficient ring. -/
@[simp]
theorem map_flagMinor {S : Type*} [CommRing S] (f : R →+* S) (I : Finset (Fin n)) :
    map f (flagMinor R I) = flagMinor S I := by
  simp only [flagMinor_def, Matrix.map_mvPolynomialMinor]

end TauCeti
