/-!
# Flag minors and Gelfand-Tsetlin patterns

The **flag minor** `TauCeti.flagMinor R I` of a set `I = {i_0 < ⋯ < i_(d-1)}` of rows of the
generic `n × n` matrix `(z_(r,c))` is its minor on the rows of `I` and the first `d` columns.
Order the variables row by row, renaming them along `toLex`, and use the lexicographic monomial
order, for which `z_(0,0)` is the largest variable, followed by `z_(0,1)`. Then the flag minor is
monic, and its leading monomial is its main diagonal `∏_(c < d) z_(i_c, c)`, with exponent
`TauCeti.flagDiagonalExponent I`.

An exponent `e` of the matrix variables determines the array of partial column sums
`λ_(c,j) = ∑_(r < j) e(r, c)` (`TauCeti.GTPattern.exponentEntries`). The diagonal exponent of `I`
is sent to the row-subset pattern `TauCeti.GTPattern.rowSubset I`, and the exponent is recovered
from the array by the successive differences `e(r, c) = λ_(c,r+1) - λ_(c,r)`. Since the
row-subset patterns generate the nonnegative Gelfand-Tsetlin patterns, the monoid generated by the
leading exponents of the `2 ^ n` flag minors is isomorphic, by the partial column sums, to the
monoid of nonnegative patterns (`TauCeti.GTPattern.flagExponentEquiv`). The determinant, the
flag minor of all rows, corresponds to the constant pattern `1`
(`TauCeti.GTPattern.rowSubset_univ`).

This identifies the monoid generated by the leading exponents of the flag minors. That the flag
minors form a SAGBI basis, so that this monoid is the leading-exponent monoid of the whole
flag-minor algebra, is a separate theorem not proved here.

## Main definitions

* `TauCeti.flagMinor R I`: the minor of the generic matrix on the rows `I` and the first `#I`
  columns.
* `TauCeti.flagDiagonalExponent I`: the exponent of its main diagonal.
* `TauCeti.GTPattern.exponentEntries`: the partial column sums of an exponent.
* `TauCeti.GTPattern.flagExponentEquiv`: the monoid generated by the diagonal exponents of the
  flag minors is isomorphic to the monoid of nonnegative Gelfand-Tsetlin patterns.

## Main results

* `TauCeti.degree_rename_toLex_flagMinor` and `TauCeti.monic_rename_toLex_flagMinor`: for the
  row-major lexicographic order, a flag minor is monic with leading exponent its diagonal exponent.
* `TauCeti.GTPattern.exponentEntries_succ_sub`: the exponent is recovered from its partial column
  sums by successive differences.
* `TauCeti.GTPattern.exponentEntries_flagDiagonalExponent`: the diagonal exponent of `I` is sent to
  the row-subset pattern of `I`.
* `TauCeti.GTPattern.mem_closure_range_flagDiagonalExponent_iff`: an exponent lies in the monoid
  generated by the diagonal exponents if and only if its partial column sums form a nonnegative
  Gelfand-Tsetlin pattern.

## References

* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 14 (flag minors, their diagonal initial terms and Gelfand-Tsetlin patterns).
* M. Kogan and E. Miller, *Toric degeneration of Schubert varieties and Gelfand-Tsetlin
  polytopes*, Adv. Math. **193** (2005), 1-17.
-/

public section

namespace TauCeti

open MvPolynomial Finset MonomialOrder

variable {n : ℕ}

/-! ### Flag minors and their leading exponents -/

section FlagMinor

variable (R : Type*) [CommRing R]

/-- The **flag minor** of a set `I` of rows of the generic `n × n` matrix: its minor on the rows of
`I`, in increasing order, and the first `#I` columns. -/
noncomputable def flagMinor (I : Finset (Fin n)) : MvPolynomial (Fin n × Fin n) R :=
  Matrix.mvPolynomialMinor R (I.orderEmbOfFin rfl) (Fin.castLE (card_finset_fin_le I))

theorem flagMinor_def (I : Finset (Fin n)) :
    flagMinor R I =
      Matrix.mvPolynomialMinor R (I.orderEmbOfFin rfl) (Fin.castLE (card_finset_fin_le I)) :=
  (rfl)

/-- The flag minor of the empty set of rows is the empty minor `1`. -/
@[simp]
theorem flagMinor_empty : flagMinor R (∅ : Finset (Fin n)) = 1 :=
  have : IsEmpty (Fin #(∅ : Finset (Fin n))) := card_empty (α := Fin n) ▸ inferInstance
  Matrix.mvPolynomialMinor_zero _ _

/-- The flag minor of a single row `r` is the matrix variable `z_(r,0)`. -/
@[simp]
theorem flagMinor_singleton (r : Fin n) : flagMinor R {r} = X (r, ⟨0, r.pos⟩) := by
  have : Unique (Fin #{r}) := card_singleton r ▸ inferInstance
  rw [flagMinor_def, Matrix.mvPolynomialMinor_one, mem_singleton.1 (orderEmbOfFin_mem _ _ _)]
  congr
  exact Fin.ext (Nat.lt_one_iff.1 ((default : Fin #{r}).2.trans_eq (card_singleton r)))

/-- The exponent of the main diagonal `∏_(c < d) z_(i_c, c)` of the flag minor of
`I = {i_0 < ⋯ < i_(d-1)}`, in the variables indexed by the lexicographically ordered pairs. -/
noncomputable def flagDiagonalExponent (I : Finset (Fin n)) : Fin n ×ₗ Fin n →₀ ℕ :=
  ∑ c : Fin #I,
    Finsupp.single (toLex (I.orderEmbOfFin rfl c, Fin.castLE (card_finset_fin_le I) c)) 1

/-- The diagonal exponent of `I` takes the value `1` at the variable `z_(r,c)` exactly when
`c < #I` and `r` is the `c`-th element of `I`, and `0` elsewhere. -/
theorem flagDiagonalExponent_apply (I : Finset (Fin n)) (r c : Fin n) :
    flagDiagonalExponent I (toLex (r, c)) =
      if h : (c : ℕ) < #I then if I.orderEmbOfFin rfl ⟨c, h⟩ = r then 1 else 0 else 0 := by
  rw [flagDiagonalExponent, Finsupp.finsetSum_apply]
  split_ifs with hc hr
  · rw [Fintype.sum_eq_single ⟨c, hc⟩ fun d hd ↦ Finsupp.single_eq_of_ne fun h ↦ hd ?_]
    · simp [← hr]
    · exact Fin.ext (congrArg (fun x ↦ ((ofLex x).2 : ℕ)) h).symm
  · rw [Fintype.sum_eq_single ⟨c, hc⟩ fun d hd ↦ Finsupp.single_eq_of_ne fun h ↦ hd ?_]
    · exact Finsupp.single_eq_of_ne fun h ↦ hr (congrArg (fun x ↦ (ofLex x).1) h).symm
    · exact Fin.ext (congrArg (fun x ↦ ((ofLex x).2 : ℕ)) h).symm
  · refine Fintype.sum_eq_zero _ fun d ↦ Finsupp.single_eq_of_ne fun h ↦ hc ?_
    have := congrArg (fun x ↦ ((ofLex x).2 : ℕ)) h
    simp only [ofLex_toLex, Fin.val_castLE] at this
    exact this ▸ d.2

/-- For the lexicographic order on the variables ordered row by row, the leading exponent of a
flag minor is its diagonal exponent. -/
@[simp]
theorem degree_rename_toLex_flagMinor [Nontrivial R] (I : Finset (Fin n)) :
    lex.degree (rename toLex (flagMinor R I)) = flagDiagonalExponent I := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix, flagDiagonalExponent]
  exact Matrix.degree_rename_toLex_det_submatrix_mvPolynomialX (I.orderEmbOfFin rfl).strictMono
    (Fin.strictMono_castLE _)

/-- For the lexicographic order on the variables ordered row by row, a flag minor is monic. -/
@[simp]
theorem monic_rename_toLex_flagMinor (I : Finset (Fin n)) :
    lex.Monic (rename toLex (flagMinor R I)) := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix]
  exact Matrix.monic_rename_toLex_det_submatrix_mvPolynomialX (I.orderEmbOfFin rfl).strictMono
    (Fin.strictMono_castLE _)

end FlagMinor

/-! ### Partial column sums of exponents -/

namespace GTPattern

/-- The partial column sums `λ_(c,j) = ∑_(r < j) e(r, c)` of an exponent `e` of the variables of
the generic `n × n` matrix, on the columns `c < n` and rows `j ≤ n`, and `0` elsewhere. On the
monoid generated by the diagonal exponents of the flag minors it takes values in the nonnegative
Gelfand-Tsetlin patterns (`TauCeti.GTPattern.flagExponentEquiv`). -/
noncomputable def exponentEntries : (Fin n ×ₗ Fin n →₀ ℕ) →+ ℕ → ℕ → ℤ where
  toFun e c j :=
    if h : c < n ∧ j ≤ n then ∑ r : Fin n with r.val < j, (e (toLex (r, ⟨c, h.1⟩)) : ℤ) else 0
  map_zero' := by
    funext c j
    by_cases h : c < n ∧ j ≤ n <;> simp [h]
  map_add' e f := by
    funext c j
    by_cases h : c < n ∧ j ≤ n <;> simp [h, sum_add_distrib]

theorem exponentEntries_apply (e : Fin n ×ₗ Fin n →₀ ℕ) (c j : ℕ) :
    exponentEntries e c j =
      if h : c < n ∧ j ≤ n then ∑ r : Fin n with r.val < j, (e (toLex (r, ⟨c, h.1⟩)) : ℤ)
      else 0 :=
  (rfl)

/-- **Successive differences.** The exponent `e(r, c)` is the difference `λ_(c,r+1) - λ_(c,r)`
of consecutive partial column sums. -/
@[simp]
theorem exponentEntries_succ_sub (e : Fin n ×ₗ Fin n →₀ ℕ) (r c : Fin n) :
    exponentEntries e c (r + 1) - exponentEntries e c r = e (toLex (r, c)) := by
  have hfilter : (univ.filter fun r' : Fin n ↦ r'.val < r + 1) =
      insert r (univ.filter fun r' : Fin n ↦ r'.val < r) := by
    ext r'
    simp only [mem_filter, mem_univ, true_and, mem_insert, Fin.ext_iff]
    omega
  have h₁ : (c : ℕ) < n ∧ (r : ℕ) + 1 ≤ n := ⟨c.2, r.2⟩
  have h₂ : (c : ℕ) < n ∧ (r : ℕ) ≤ n := ⟨c.2, r.2.le⟩
  simp only [exponentEntries_apply, h₁, h₂, and_self, dite_true, hfilter]
  rw [sum_insert (by simp), add_sub_cancel_right]

/-- An exponent is determined by its partial column sums. -/
theorem exponentEntries_injective :
    Function.Injective (exponentEntries (n := n)) := by
  intro e f h
  ext x
  have hx := congrArg (fun F ↦ F (ofLex x).2 ((ofLex x).1 + 1) - F (ofLex x).2 (ofLex x).1) h
  simpa using hx

/-- **The partial column sums of the diagonal exponent of `I` form the row-subset pattern of
`I`.** -/
@[simp]
theorem exponentEntries_flagDiagonalExponent (I : Finset (Fin n)) :
    exponentEntries (flagDiagonalExponent I) = ⇑(rowSubset I) := by
  funext c j
  rw [exponentEntries_apply, rowSubset_apply]
  -- The `c`-th element `i_c` of `I` lies below `j` exactly when `c < #{r ∈ I | r < j}`.
  have key (hcI : c < #I) :
      c < #{r ∈ I | r.val < j} ↔ (I.orderEmbOfFin rfl ⟨c, hcI⟩).val < j :=
    lt_card_filter_iff_apply_orderEmbOfFin_of_imp I rfl ⟨c, hcI⟩ (fun r : Fin n ↦ r.val < j)
      fun _ _ hba hp ↦ lt_of_le_of_lt (Fin.le_iff_val_le_val.1 hba) hp
  split_ifs with h hcj hcj
  · -- Only the row `i_c` contributes to the sum.
    have hcI : c < #I := hcj.2.trans_le (card_le_card (filter_subset _ _))
    simp [flagDiagonalExponent_apply, hcI, (key hcI).1 hcj.2]
  · refine sum_eq_zero fun r hr ↦ ?_
    rw [mem_filter] at hr
    rw [flagDiagonalExponent_apply]
    split_ifs with hcI hr'
    · exact absurd ⟨h.2, (key hcI).2 (hr' ▸ hr.2)⟩ hcj
    all_goals simp
  · have := card_filter_val_lt_le I j
    omega
  · rfl

/-- Distinct row subsets have distinct diagonal exponents, so the flag minors have `2 ^ n`
distinct leading exponents. -/
theorem flagDiagonalExponent_injective :
    Function.Injective (flagDiagonalExponent (n := n)) := fun I J h ↦
  rowSubset_injective <| DFunLike.coe_injective <| by
    rw [← exponentEntries_flagDiagonalExponent, ← exponentEntries_flagDiagonalExponent, h]

/-- The partial column sums map the monoid generated by the diagonal exponents onto the
nonnegative patterns. -/
private theorem map_closure_range_flagDiagonalExponent :
    (AddSubmonoid.closure (Set.range (flagDiagonalExponent (n := n)))).map exponentEntries =
      (AddSubmonoid.nonneg (GTPattern n)).map coeFnAddMonoidHom := by
  rw [← closure_range_rowSubset, AddMonoidHom.map_mclosure, AddMonoidHom.map_mclosure,
    ← Set.range_comp, ← Set.range_comp]
  congr 2
  funext I
  simp [exponentEntries_flagDiagonalExponent, coeFnAddMonoidHom_apply]

/-- **The monoid generated by the diagonal exponents of the flag minors.** An exponent lies in it
if and only if its partial column sums are the entries of a nonnegative Gelfand-Tsetlin pattern. -/
theorem mem_closure_range_flagDiagonalExponent_iff {e : Fin n ×ₗ Fin n →₀ ℕ} :
    e ∈ AddSubmonoid.closure (Set.range flagDiagonalExponent) ↔
      ∃ P : GTPattern n, 0 ≤ P ∧ ⇑P = exponentEntries e := by
  constructor
  · intro he
    obtain ⟨P, hP, hPe⟩ : exponentEntries e ∈ (AddSubmonoid.nonneg (GTPattern n)).map
        coeFnAddMonoidHom :=
      map_closure_range_flagDiagonalExponent ▸ AddSubmonoid.mem_map_of_mem _ he
    exact ⟨P, hP, by rwa [coeFnAddMonoidHom_apply] at hPe⟩
  · rintro ⟨P, hP, hPe⟩
    have he : exponentEntries e ∈ (AddSubmonoid.nonneg (GTPattern n)).map coeFnAddMonoidHom :=
      ⟨P, hP, by rw [coeFnAddMonoidHom_apply, hPe]⟩
    rw [← map_closure_range_flagDiagonalExponent] at he
    obtain ⟨e', he', hee'⟩ := he
    rwa [← exponentEntries_injective hee']

/-- **The diagonal exponents of the flag minors generate the monoid of nonnegative
Gelfand-Tsetlin patterns.** The isomorphism sends an exponent `e` to the pattern of its partial
column sums `λ_(c,j) = ∑_(r < j) e(r, c)` (`TauCeti.GTPattern.coe_flagExponentEquiv_apply`), with
inverse given by successive differences (`TauCeti.GTPattern.flagExponentEquiv_symm_apply`). -/
noncomputable def flagExponentEquiv :
    AddSubmonoid.closure (Set.range (flagDiagonalExponent (n := n))) ≃+
      AddSubmonoid.nonneg (GTPattern n) :=
  ((AddSubmonoid.equivMapOfInjective _ _ exponentEntries_injective).trans
    (AddEquiv.addSubmonoidCongr map_closure_range_flagDiagonalExponent)).trans
    (AddSubmonoid.equivMapOfInjective _ _ coeFnAddMonoidHom_injective).symm

@[simp]
theorem coe_flagExponentEquiv_apply
    (e : AddSubmonoid.closure (Set.range (flagDiagonalExponent (n := n)))) :
    ⇑(flagExponentEquiv e : GTPattern n) = exponentEntries (e : Fin n ×ₗ Fin n →₀ ℕ) := by
  rw [← coeFnAddMonoidHom_apply, ← AddSubmonoid.coe_equivMapOfInjective_apply _ _
    coeFnAddMonoidHom_injective, flagExponentEquiv, AddEquiv.trans_apply,
    AddEquiv.apply_symm_apply]
  -- `AddEquiv.addSubmonoidCongr` does not change the underlying element; Mathlib states no lemma
  -- for this, so it is closed by definitional unfolding.
  rfl

/-- The diagonal exponent of the flag minor of `I` corresponds to the row-subset pattern of `I`. -/
@[simp]
theorem flagExponentEquiv_flagDiagonalExponent (I : Finset (Fin n)) :
    flagExponentEquiv ⟨flagDiagonalExponent I, AddSubmonoid.subset_closure ⟨I, rfl⟩⟩ =
      ⟨rowSubset I, zero_le_rowSubset I⟩ :=
  Subtype.ext <| DFunLike.coe_injective <| by
    rw [coe_flagExponentEquiv_apply, exponentEntries_flagDiagonalExponent]

/-- **The inverse is given by successive differences**: the exponent of a nonnegative pattern `P`
at `z_(r,c)` is `λ_(c,r+1) - λ_(c,r)`. -/
theorem flagExponentEquiv_symm_apply (P : AddSubmonoid.nonneg (GTPattern n)) (r c : Fin n) :
    ((flagExponentEquiv.symm P : Fin n ×ₗ Fin n →₀ ℕ) (toLex (r, c)) : ℤ) =
      (P : GTPattern n) c (r + 1) - (P : GTPattern n) c r := by
  conv_rhs => rw [← flagExponentEquiv.apply_symm_apply P, coe_flagExponentEquiv_apply,
    exponentEntries_succ_sub]

end GTPattern

end TauCeti
