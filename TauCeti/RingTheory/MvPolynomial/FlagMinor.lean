module

public import TauCeti.Data.Finset.Sort
public import TauCeti.LinearAlgebra.Matrix.MvPolynomial
public import TauCeti.RepresentationTheory.ClassicalGroups.GelfandTsetlin.RowSubset
public import Mathlib.RingTheory.MvPolynomial.DeterminantalIdeal

/-!
# Flag minors and Gelfand-Tsetlin patterns

The **flag minor** `MvPolynomial.flagMinor R I` of the generic `n × n` matrix `Z = (z_{r,c})` on a
set `I = {i_0 < ⋯ < i_{d-1}}` of rows is its minor on the rows of `I` and the first `d` columns.
For the row-major lexicographic order on the variables, in which `z_{0,0}` is the largest variable,
it is monic with leading monomial the main diagonal `∏_{c < d} z_{i_c, c}`, whose exponent is
`TauCeti.flagExponent I`.

An exponent `e` of the variables `z_{r,c}` gives the triangular array
`λ_{c,j} = ∑_{r < j} e(r, c)` on the cells `c < j ≤ n` (`TauCeti.exponentPattern`): row `j`
records, column by column, the degree of `e` in the first `j` rows. It sends the diagonal exponent
of the flag minor on `I` to the row-subset pattern `TauCeti.GTPattern.rowSubset I`. Since the
row-subset patterns generate the nonnegative Gelfand-Tsetlin patterns, the monoid generated by
the leading exponents of the flag minors is carried onto the monoid of nonnegative patterns.
This correspondence is injective on that monoid: its elements do not involve the variables
`z_{r,c}` with `r < c`, so the exponent is recovered from the pattern by the successive
differences `e(r, c) = λ_{c,r+1} - λ_{c,r}`. Thus the monoid generated by the leading exponents
of the flag minors is isomorphic to the monoid of nonnegative Gelfand-Tsetlin patterns
(`TauCeti.flagExponentEquiv`). This is the combinatorial half of the identification of the
initial algebra of the flag-minor algebra with the semigroup algebra of patterns; the other half
is that the flag minors form a SAGBI basis.

## Main definitions

* `MvPolynomial.flagMinor R I`: the flag minor of the generic matrix on the rows `I`.
* `TauCeti.flagExponent I`: the exponent of the main diagonal of the flag minor on `I`.
* `TauCeti.exponentPattern`: the array `λ_{c,j} = ∑_{r < j} e(r, c)` of an exponent `e`.
* `TauCeti.flagExponentEquiv`: the additive equivalence between the monoid generated by the
  flag exponents and the nonnegative Gelfand-Tsetlin patterns.

## Main results

* `MvPolynomial.degree_rename_toLex_flagMinor` and `MvPolynomial.monic_rename_toLex_flagMinor`:
  the flag minor is monic with leading exponent `TauCeti.flagExponent I`.
* `TauCeti.exponentPattern_flagExponent`: the array of the flag exponent of `I` is the
  row-subset pattern of `I`.
* `TauCeti.map_exponentPattern_closure_range_flagExponent`: the arrays of the monoid generated by
  the flag exponents are exactly the nonnegative Gelfand-Tsetlin patterns.
* `TauCeti.exponentPattern_add_one_sub_of_mem_closure`: on that monoid the exponent is recovered
  from its array by successive differences, so `TauCeti.exponentPattern` is injective there
  (`TauCeti.injOn_exponentPattern`).

## References

* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 14 (flag minors, diagonal term orders and Gelfand-Tsetlin patterns).
* M. Kogan and E. Miller, *Toric degeneration of Schubert varieties and Gelfand-Tsetlin
  polytopes*, Adv. Math. **193** (2005), 1-17.
-/

public section

open Finset MonomialOrder

namespace TauCeti

variable {n : ℕ}

/-! ### The diagonal exponent of a flag minor -/

/-- The exponent of the main diagonal `∏_{c < #I} z_{i_c, c}` of the flag minor on the rows
`I = {i_0 < ⋯}`, as an exponent of the lexicographically ordered variables. -/
noncomputable def flagExponent (I : Finset (Fin n)) : Fin n ×ₗ Fin n →₀ ℕ :=
  ∑ c : Fin #I,
    Finsupp.single (toLex (I.orderEmbOfFin rfl c, Fin.castLE (I.card_le_univ.trans_eq
      (Fintype.card_fin n)) c)) 1

/-- The flag exponent of `I` has entry one at `(i_c, c)` for each `c < #I`, and zero elsewhere. -/
theorem flagExponent_apply (I : Finset (Fin n)) (r c : Fin n) :
    flagExponent I (toLex (r, c)) =
      ∑ c' : Fin #I, if I.orderEmbOfFin rfl c' = r ∧ (c' : ℕ) = c then 1 else 0 := by
  rw [flagExponent, Finset.sum_apply']
  refine Finset.sum_congr rfl fun c' _ ↦ ?_
  rw [Finsupp.single_apply]
  simp only [EmbeddingLike.apply_eq_iff_eq, Prod.mk.injEq, Fin.ext_iff, Fin.val_castLE]

/-- The flag exponents do not involve the variables `z_{r,c}` with `r < c`. -/
theorem flagExponent_apply_eq_zero_of_lt (I : Finset (Fin n)) {r c : Fin n} (hrc : r < c) :
    flagExponent I (toLex (r, c)) = 0 := by
  rw [flagExponent_apply]
  refine Finset.sum_eq_zero fun c' _ ↦ ite_eq_right_iff.2 fun ⟨hr, hc⟩ ↦ ?_
  have := I.val_le_val_orderEmbOfFin rfl c'
  rw [hr, hc] at this
  exact ((Fin.lt_def.1 hrc).not_ge this).elim

/-! ### The pattern of an exponent -/

/-- The triangular array `λ_{c,j} = ∑_{r < j} e(r, c)` of an exponent `e` of the variables
`z_{r,c}` of the generic `n × n` matrix, on the cells `c < j ≤ n`, and zero elsewhere. Row `j`
records, column by column, the degree of `e` in the first `j` rows of the matrix. -/
noncomputable def exponentPattern : (Fin n ×ₗ Fin n →₀ ℕ) →+ ℕ → ℕ → ℤ where
  toFun e c j :=
    if h : c < j ∧ j ≤ n then ∑ r : Fin n with r.val < j, (e (toLex (r, ⟨c, by omega⟩)) : ℤ)
    else 0
  map_zero' := by
    funext c j
    split_ifs <;> simp
  map_add' e e' := by
    funext c j
    simp only [Pi.add_apply]
    split_ifs
    · simp [sum_add_distrib]
    · simp

/-- On the cells `c < j ≤ n`, the array of `e` is `∑_{r < j} e(r, c)`. -/
theorem exponentPattern_apply_of_lt_of_le (e : Fin n ×ₗ Fin n →₀ ℕ) {c j : ℕ} (hcj : c < j)
    (hj : j ≤ n) :
    exponentPattern e c j = ∑ r : Fin n with r.val < j, (e (toLex (r, ⟨c, by omega⟩)) : ℤ) :=
  dite_eq_left ⟨hcj, hj⟩

/-- Outside the cells `c < j ≤ n`, the array of `e` vanishes. -/
theorem exponentPattern_apply_of_not_lt_and_le (e : Fin n ×ₗ Fin n →₀ ℕ) {c j : ℕ}
    (h : ¬(c < j ∧ j ≤ n)) : exponentPattern e c j = 0 :=
  dite_eq_right h

/-- **The array of the flag exponent of `I` is the row-subset pattern of `I`.** -/
@[simp]
theorem exponentPattern_flagExponent (I : Finset (Fin n)) :
    exponentPattern (flagExponent I) = ⇑(GTPattern.rowSubset I) := by
  funext c j
  rw [GTPattern.rowSubset_apply]
  by_cases h : c < j ∧ j ≤ n
  · rw [exponentPattern_apply_of_lt_of_le _ h.1 h.2]
    simp only [h.2, true_and, flagExponent_apply, Nat.cast_sum, Nat.cast_ite, Nat.cast_one,
      Nat.cast_zero]
    rw [sum_comm]
    -- Only the `c`-th element of `I` contributes, provided that it lies below row `j`.
    have hinner (c' : Fin #I) : (∑ r : Fin n with r.val < j,
        if I.orderEmbOfFin rfl c' = r ∧ (c' : ℕ) = c then (1 : ℤ) else 0) =
        if (c' : ℕ) = c ∧ ((I.orderEmbOfFin rfl c' : Fin n) : ℕ) < j then 1 else 0 := by
      by_cases hc' : (c' : ℕ) = c <;> simp [hc', Finset.sum_ite_eq]
    simp only [hinner]
    by_cases hcI : c < #I
    · rw [Finset.sum_eq_single ⟨c, hcI⟩ (fun c' _ hc' ↦ ite_eq_right_iff.2 fun h' ↦
        absurd (Fin.ext h'.1) hc') (by simp)]
      have := I.lt_card_filter_iff_orderEmbOfFin rfl ⟨c, hcI⟩ (fun r : Fin n ↦ r.val < j)
        fun _ _ hle hx ↦ (Fin.le_def.1 hle).trans_lt hx
      simp [← this]
    · rw [Finset.sum_eq_zero fun (c' : Fin #I) _ ↦ ite_eq_right_iff.2
          fun (h' : (c' : ℕ) = c ∧ _) ↦ absurd (h'.1 ▸ c'.2) hcI,
        ite_eq_right_iff.2 fun (h' : c < #{r ∈ I | r.val < j}) ↦
          absurd (h'.trans_le (card_le_card (filter_subset _ _))) hcI]
  · rw [exponentPattern_apply_of_not_lt_and_le _ h, eq_comm, ite_eq_right_iff]
    intro h'
    have := Finset.card_filter_val_lt_le I j
    omega

/-! ### The monoid generated by the flag exponents -/

/-- **The arrays of the monoid generated by the flag exponents are exactly the nonnegative
Gelfand-Tsetlin patterns.** -/
theorem map_exponentPattern_closure_range_flagExponent :
    (AddSubmonoid.closure (Set.range (flagExponent (n := n)))).map exponentPattern =
      (AddSubmonoid.nonneg (GTPattern n)).map GTPattern.coeFnAddMonoidHom := by
  rw [AddMonoidHom.map_mclosure, ← GTPattern.closure_range_rowSubset, AddMonoidHom.map_mclosure,
    ← Set.range_comp, ← Set.range_comp]
  congr 2
  funext I
  rw [Function.comp_apply, Function.comp_apply, GTPattern.coeFnAddMonoidHom_apply,
    exponentPattern_flagExponent]

/-- The elements of the monoid generated by the flag exponents do not involve the variables
`z_{r,c}` with `r < c`. -/
theorem apply_toLex_eq_zero_of_mem_closure_range_flagExponent {e : Fin n ×ₗ Fin n →₀ ℕ}
    (he : e ∈ AddSubmonoid.closure (Set.range flagExponent)) {r c : Fin n} (hrc : r < c) :
    e (toLex (r, c)) = 0 := by
  induction he using AddSubmonoid.closure_induction with
  | mem _ h =>
    obtain ⟨I, rfl⟩ := h
    exact flagExponent_apply_eq_zero_of_lt I hrc
  | zero => rfl
  | add _ _ _ _ h₁ h₂ => rw [Finsupp.add_apply, h₁, h₂]

/-- On the monoid generated by the flag exponents, the defining formula `∑_{r < j} e(r, c)` of the
array holds on every cell `(c, j)` with `j ≤ n`, also outside the triangle `c < j`. -/
theorem exponentPattern_apply_of_mem_closure {e : Fin n ×ₗ Fin n →₀ ℕ}
    (he : e ∈ AddSubmonoid.closure (Set.range flagExponent)) (c : Fin n) {j : ℕ} (hj : j ≤ n) :
    exponentPattern e c j = ∑ r : Fin n with r.val < j, (e (toLex (r, c)) : ℤ) := by
  by_cases hcj : (c : ℕ) < j
  · exact exponentPattern_apply_of_lt_of_le e hcj hj
  · rw [exponentPattern_apply_of_not_lt_and_le e fun h ↦ hcj h.1, eq_comm]
    refine Finset.sum_eq_zero fun r hr ↦ ?_
    rw [apply_toLex_eq_zero_of_mem_closure_range_flagExponent he
      (Fin.lt_def.2 ((mem_filter.1 hr).2.trans_le (not_lt.1 hcj))), Nat.cast_zero]

/-- **Successive differences.** On the monoid generated by the flag exponents, the exponent of
`z_{r,c}` is the difference `λ_{c,r+1} - λ_{c,r}` of two consecutive rows of the array. -/
theorem exponentPattern_add_one_sub_of_mem_closure {e : Fin n ×ₗ Fin n →₀ ℕ}
    (he : e ∈ AddSubmonoid.closure (Set.range flagExponent)) (r c : Fin n) :
    exponentPattern e c (r + 1) - exponentPattern e c r = e (toLex (r, c)) := by
  rw [exponentPattern_apply_of_mem_closure he c r.2, exponentPattern_apply_of_mem_closure he c
    r.2.le, sum_filter, sum_filter, ← sum_sub_distrib, Finset.sum_eq_single r]
  · simp
  · intro r' _ hr'
    have : (r' : ℕ) ≠ r := fun h ↦ hr' (Fin.ext h)
    split_ifs <;> omega
  · simp

/-- The array determines the exponent on the monoid generated by the flag exponents. -/
theorem injOn_exponentPattern :
    Set.InjOn exponentPattern
      (AddSubmonoid.closure (Set.range (flagExponent (n := n))) : Set (Fin n ×ₗ Fin n →₀ ℕ)) := by
  intro e he e' he' h
  ext x
  rw [← toLex_ofLex x]
  exact_mod_cast (exponentPattern_add_one_sub_of_mem_closure he _ _).symm.trans
    (h ▸ exponentPattern_add_one_sub_of_mem_closure he' _ _)

/-- The array of an element of the monoid generated by the flag exponents is a nonnegative
Gelfand-Tsetlin pattern. -/
theorem exists_coe_eq_exponentPattern {e : Fin n ×ₗ Fin n →₀ ℕ}
    (he : e ∈ AddSubmonoid.closure (Set.range flagExponent)) :
    ∃ P : GTPattern n, 0 ≤ P ∧ ⇑P = exponentPattern e := by
  have := AddSubmonoid.mem_map_of_mem exponentPattern he
  rw [map_exponentPattern_closure_range_flagExponent] at this
  obtain ⟨P, hP, h⟩ := this
  exact ⟨P, hP, (GTPattern.coeFnAddMonoidHom_apply P).symm.trans h⟩

/-- **The monoid generated by the leading exponents of the flag minors is the monoid of
nonnegative Gelfand-Tsetlin patterns.** An exponent `e` is sent to the pattern
`λ_{c,j} = ∑_{r < j} e(r, c)`, and is recovered from it by successive differences
(`TauCeti.flagExponentEquiv_symm_apply`). -/
noncomputable def flagExponentEquiv :
    AddSubmonoid.closure (Set.range (flagExponent (n := n))) ≃+
      AddSubmonoid.nonneg (GTPattern n) :=
  AddEquiv.ofBijective (F := AddSubmonoid.closure (Set.range (flagExponent (n := n))) →+
      AddSubmonoid.nonneg (GTPattern n))
    { toFun e := ⟨(exists_coe_eq_exponentPattern e.2).choose,
        AddSubmonoid.mem_nonneg.2 (exists_coe_eq_exponentPattern e.2).choose_spec.1⟩
      map_zero' := Subtype.ext <| DFunLike.coe_injective <| by
        refine (exists_coe_eq_exponentPattern
          (0 : AddSubmonoid.closure (Set.range (flagExponent (n := n)))).2).choose_spec.2.trans ?_
        simp
      map_add' e e' := Subtype.ext <| DFunLike.coe_injective <| by
        simp only [AddSubmonoid.coe_add, GTPattern.coe_add]
        rw [(exists_coe_eq_exponentPattern (e + e').2).choose_spec.2,
          (exists_coe_eq_exponentPattern e.2).choose_spec.2,
          (exists_coe_eq_exponentPattern e'.2).choose_spec.2, AddSubmonoid.coe_add, map_add] }
    ⟨fun e e' h ↦ Subtype.ext <| injOn_exponentPattern e.2 e'.2 <| by
        rw [← (exists_coe_eq_exponentPattern e.2).choose_spec.2,
          ← (exists_coe_eq_exponentPattern e'.2).choose_spec.2]
        exact congrArg (fun P : AddSubmonoid.nonneg (GTPattern n) ↦ ⇑(P : GTPattern n)) h,
      fun P ↦ by
        have := AddSubmonoid.mem_map_of_mem GTPattern.coeFnAddMonoidHom P.2
        rw [← map_exponentPattern_closure_range_flagExponent] at this
        obtain ⟨e, he, h⟩ := this
        refine ⟨⟨e, he⟩, Subtype.ext <| DFunLike.coe_injective ?_⟩
        exact (exists_coe_eq_exponentPattern he).choose_spec.2.trans
          (h.trans (GTPattern.coeFnAddMonoidHom_apply _))⟩

/-- The pattern corresponding to an exponent `e` is its array `λ_{c,j} = ∑_{r < j} e(r, c)`. -/
@[simp]
theorem coe_flagExponentEquiv_apply
    (e : AddSubmonoid.closure (Set.range (flagExponent (n := n)))) :
    ⇑(flagExponentEquiv e : GTPattern n) = exponentPattern (e : Fin n ×ₗ Fin n →₀ ℕ) :=
  (exists_coe_eq_exponentPattern e.2).choose_spec.2

/-- The flag exponent of `I` corresponds to the row-subset pattern of `I`. -/
@[simp]
theorem flagExponentEquiv_flagExponent (I : Finset (Fin n)) :
    flagExponentEquiv ⟨flagExponent I, AddSubmonoid.subset_closure ⟨I, rfl⟩⟩ =
      ⟨GTPattern.rowSubset I, GTPattern.zero_le_rowSubset I⟩ :=
  Subtype.ext <| DFunLike.coe_injective <| by
    rw [coe_flagExponentEquiv_apply, exponentPattern_flagExponent]

/-- **The inverse correspondence is given by successive differences:** the exponent of `z_{r,c}`
corresponding to a nonnegative pattern `λ` is `λ_{c,r+1} - λ_{c,r}`. -/
theorem flagExponentEquiv_symm_apply (P : AddSubmonoid.nonneg (GTPattern n)) (r c : Fin n) :
    ((flagExponentEquiv.symm P : Fin n ×ₗ Fin n →₀ ℕ) (toLex (r, c)) : ℤ) =
      (P : GTPattern n) c (r + 1) - (P : GTPattern n) c r := by
  rw [← exponentPattern_add_one_sub_of_mem_closure (flagExponentEquiv.symm P).2,
    ← coe_flagExponentEquiv_apply, AddEquiv.apply_symm_apply]

end TauCeti

namespace MvPolynomial

variable {n : ℕ} (R : Type*) [CommRing R]

/-- The **flag minor** of the generic `n × n` matrix on a set `I` of rows: its minor on the rows
of `I`, in increasing order, and on the first `#I` columns. -/
noncomputable def flagMinor (I : Finset (Fin n)) : MvPolynomial (Fin n × Fin n) R :=
  Matrix.mvPolynomialMinor R (I.orderEmbOfFin rfl)
    (Fin.castLE (I.card_le_univ.trans_eq (Fintype.card_fin n)))

/-- The flag minor on `I` is the minor of the generic matrix on the rows of `I`, in increasing
order, and on the first `#I` columns. -/
theorem flagMinor_def (I : Finset (Fin n)) :
    flagMinor R I = Matrix.mvPolynomialMinor R (I.orderEmbOfFin rfl)
      (Fin.castLE (I.card_le_univ.trans_eq (Fintype.card_fin n))) := by
  rw [flagMinor]

variable {R}

/-- For the row-major lexicographic order on the variables, the leading exponent of the flag
minor on `I` is the exponent of its main diagonal. -/
@[simp]
theorem degree_rename_toLex_flagMinor [Nontrivial R] (I : Finset (Fin n)) :
    lex.degree (rename toLex (flagMinor R I)) = TauCeti.flagExponent I := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix]
  exact Matrix.degree_rename_toLex_det_submatrix_mvPolynomialX (I.orderEmbOfFin rfl).strictMono
    (Fin.strictMono_castLE _)

/-- For the row-major lexicographic order on the variables, every flag minor is monic. -/
@[simp]
theorem monic_rename_toLex_flagMinor (I : Finset (Fin n)) :
    lex.Monic (rename toLex (flagMinor R I)) := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix]
  exact Matrix.monic_rename_toLex_det_submatrix_mvPolynomialX (I.orderEmbOfFin rfl).strictMono
    (Fin.strictMono_castLE _)

end MvPolynomial
