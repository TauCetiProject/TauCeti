module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Regular sequences of polynomial variables

Any finite list of distinct indeterminates is a regular sequence over a nontrivial
commutative ring, and prepending a regular non-unit scalar `C r` preserves regularity
(`MvPolynomial.isRegular_C_cons_map_X`). This is the starting regular sequence for
transporting polynomial coordinates to a polynomial algebra and then along a flat extension.

The proofs use Mathlib's description of the ideal generated by a set of variables as
the kernel of the substitution killing those variables, together with the contraction
of variable ideals along coefficient reduction modulo an ideal of `R`
(`MvPolynomial.comap_map_quotient_mk_span_X_image`).
-/

public section

namespace MvPolynomial

open RingTheory.Sequence

variable {R σ : Type*} [CommRing R]

/-- Under coefficient reduction `MvPolynomial σ R →+* MvPolynomial σ (R ⧸ I)`, the preimage of
the monomial ideal generated by `X '' s` is `I.map C ⊔ Ideal.span (X '' s)`. -/
theorem comap_map_quotient_mk_span_X_image (I : Ideal R) (s : Set σ) :
    Ideal.comap
        (MvPolynomial.map (Ideal.Quotient.mk I) :
          MvPolynomial σ R →+* MvPolynomial σ (R ⧸ I))
        (Ideal.span (X '' s)) =
      I.map C ⊔ Ideal.span (X '' s) := by
  let π : MvPolynomial σ R →+* MvPolynomial σ (R ⧸ I) := MvPolynomial.map (Ideal.Quotient.mk I)
  have hsurj : Function.Surjective π := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
  have hker : RingHom.ker π = I.map C := by rw [MvPolynomial.ker_map, Ideal.mk_ker]
  have hmap : Ideal.map π (Ideal.span (X '' s)) = Ideal.span (X '' s) := by
    simp [π, Ideal.map_span, Set.image_image]
  rw [← hmap, Ideal.comap_map_of_surjective π hsurj, ← RingHom.ker_eq_comap_bot, hker, sup_comm]

/-- A constant polynomial `C r` is regular on `MvPolynomial σ R` if and only if `r` is regular on
`R`. -/
@[simp]
theorem isSMulRegular_C_iff {r : R} :
    IsSMulRegular (MvPolynomial σ R) (C r : MvPolynomial σ R) ↔ IsSMulRegular R r := by
  constructor
  · intro hr a b hab
    have h : (C r : MvPolynomial σ R) • (C a : MvPolynomial σ R) =
        (C r : MvPolynomial σ R) • C b := by
      simpa only [smul_eq_mul, ← map_mul] using congrArg (C (σ := σ)) hab
    simpa using congrArg (constantCoeff (σ := σ)) (hr h)
  · intro hr f g hfg
    ext d
    exact hr (by simpa only [smul_eq_mul, coeff_C_mul] using congrArg (fun q ↦ q.coeff d) hfg)

/-- A variable outside a set `s` of variables is regular modulo the ideal they generate. -/
theorem isSMulRegular_quotient_span_X_image (s : Set σ) {i : σ} (hi : i ∉ s) :
    IsSMulRegular (MvPolynomial σ R ⧸ Ideal.span ((X : σ → MvPolynomial σ R) '' s))
      (X i : MvPolynomial σ R) := by
  classical
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro p hp
  rw [span_X_image_eq_ker_aeval_ite_mem, RingHom.mem_ker] at hp ⊢
  simp only [map_mul, aeval_X, Set.mem_compl_iff, hi, not_false_eq_true, ↓reduceIte,
    smul_eq_mul] at hp
  exact isRegular_X.left.mul_left_eq_zero_iff.mp hp

/-- A variable outside a set `s` is regular modulo `I.map C ⊔ Ideal.span (X '' s)` for every ideal
`I` of `R`. -/
theorem isSMulRegular_X_quotient_map_C_sup_span_X_image (I : Ideal R) (s : Set σ) {i : σ}
    (hi : i ∉ s) :
    IsSMulRegular (MvPolynomial σ R ⧸ (I.map C ⊔ Ideal.span ((X : σ → MvPolynomial σ R) '' s)))
      (X i : MvPolynomial σ R) := by
  rw [← comap_map_quotient_mk_span_X_image, isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro f hf
  rw [Ideal.mem_comap] at hf ⊢
  rw [smul_eq_mul, map_mul, map_X] at hf
  exact (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mp
    (isSMulRegular_quotient_span_X_image (R := R ⧸ I) s hi) _ hf

/-- Distinct polynomial variables form a weakly regular sequence, without a
nontriviality hypothesis on the coefficient ring. -/
theorem isWeaklyRegular_map_X (l : List σ) (hl : l.Nodup) :
    IsWeaklyRegular (MvPolynomial σ R) (l.map (X (R := R))) := by
  constructor
  intro j hj
  have hj' : j < l.length := by simpa using hj
  have hnot : l[j] ∉ l.take j := by
    have h := hl.take (i := j + 1)
    rw [List.take_succ_eq_append_getElem hj', List.pairwise_append] at h
    exact fun hm ↦ h.2.2 _ hm _ (by simp) rfl
  have hI : Ideal.ofList ((l.map (X : σ → MvPolynomial σ R)).take j) =
      Ideal.span (X '' {i | i ∈ l.take j}) := by
    rw [Ideal.ofList, ← List.map_take]
    congr 1
    ext p
    simp only [List.mem_map, Set.mem_ofPred_eq, Set.mem_image]
  rw [hI, Ideal.smul_eq_mul, Ideal.mul_top, List.getElem_map]
  exact isSMulRegular_quotient_span_X_image (R := R) {i | i ∈ l.take j} hnot

/-- Any finite list of distinct polynomial variables is a regular sequence. -/
theorem isRegular_map_X [Nontrivial R] (l : List σ) (hl : l.Nodup) :
    RingTheory.Sequence.IsRegular (MvPolynomial σ R) (l.map (X (R := R))) := by
  refine ⟨isWeaklyRegular_map_X l hl, ?_⟩
  rw [Ideal.smul_eq_mul, Ideal.mul_top]
  have hle : Ideal.ofList (l.map (X : σ → MvPolynomial σ R)) ≤
      RingHom.ker (constantCoeff : MvPolynomial σ R →+* R) := by
    rw [Ideal.ofList, Ideal.span_le]
    intro p hp
    obtain ⟨i, _, rfl⟩ := List.mem_map.1 hp
    simp
  exact (ne_top_of_le_ne_top (RingHom.ker_ne_top constantCoeff) hle).symm

/-- If `r` is regular on `R` and `(r) ≠ ⊤`, then `C r` followed by any finite list of distinct
indeterminates is a regular sequence on `MvPolynomial σ R`. -/
theorem isRegular_C_cons_map_X {r : R} (hr : IsSMulRegular R r) (htop : Ideal.span {r} ≠ ⊤)
    {l : List σ} (hl : l.Nodup) :
    RingTheory.Sequence.IsRegular (MvPolynomial σ R) (C r :: l.map (X (R := R))) := by
  have : Nontrivial (R ⧸ Ideal.span {r}) := Ideal.Quotient.nontrivial_iff.mpr htop
  have hspan (k : ℕ) :
      Ideal.ofList ((C r :: l.map (X : σ → MvPolynomial σ R)).take (k + 1)) =
        (Ideal.span {r}).map C ⊔ Ideal.span (X '' {i | i ∈ l.take k}) := by
    rw [List.take_succ_cons, Ideal.ofList_cons, Ideal.map_span, Set.image_singleton,
      Ideal.ofList, ← List.map_take]
    congr 2
    ext p
    simp only [List.mem_map, Set.mem_ofPred_eq, Set.mem_image]
  refine ⟨⟨fun j hj ↦ ?_⟩, ?_⟩
  · rw [Ideal.smul_eq_mul, Ideal.mul_top]
    rcases j with _ | k
    · have h0 : Ideal.ofList ((C r :: l.map (X : σ → MvPolynomial σ R)).take 0) = ⊥ := by simp
      rw [h0, List.getElem_cons_zero, isSMulRegular_quotient_iff_mem_of_smul_mem]
      intro f hf
      rw [Ideal.mem_bot] at hf ⊢
      exact isSMulRegular_C_iff.mpr hr (hf.trans (smul_zero _).symm)
    · have hk : k < l.length := by simpa using hj
      have hnot : l[k] ∉ l.take k := by
        have h := hl.take (i := k + 1)
        rw [List.take_succ_eq_append_getElem hk, List.pairwise_append] at h
        exact fun hm ↦ h.2.2 _ hm _ (by simp) rfl
      rw [hspan k, List.getElem_cons_succ, List.getElem_map]
      exact isSMulRegular_X_quotient_map_C_sup_span_X_image (Ideal.span {r})
        {i | i ∈ l.take k} hnot
  · rw [Ideal.smul_eq_mul, Ideal.mul_top, ne_comm]
    have hfull : (C r :: l.map (X : σ → MvPolynomial σ R)).take (l.length + 1) =
        C r :: l.map (X : σ → MvPolynomial σ R) :=
      List.take_of_length_le (by simp)
    rw [← hfull, hspan l.length, ← comap_map_quotient_mk_span_X_image]
    intro htop'
    rw [Ideal.eq_top_iff_one, Ideal.mem_comap, map_one, ← Ideal.eq_top_iff_one] at htop'
    have hle : Ideal.span ((X : σ → MvPolynomial σ (R ⧸ Ideal.span {r})) ''
          {i | i ∈ l.take l.length}) ≤
        RingHom.ker constantCoeff := by
      rw [Ideal.span_le]
      rintro _ ⟨i, -, rfl⟩
      simp
    exact RingHom.ker_ne_top constantCoeff (top_le_iff.mp (htop' ▸ hle))

end MvPolynomial
