module

public import TauCeti.RingTheory.MvPolynomial.Initial.Ideal
public import TauCeti.RingTheory.MvPolynomial.Groebner.Cone
public import TauCeti.RingTheory.MvPolynomial.Groebner.Finite

/-!
# Computing weight-initial ideals by Gröbner bases

A Gröbner basis for the weight-refined monomial order computes the entire weight-initial
ideal: it is generated by the weight-initial forms of the basis elements. Bounded standard
representations are essential here; initial forms of arbitrary ideal generators need not
generate the initial ideal.

For a finite Gröbner basis with unit leading coefficients, finitely many strict comparisons
ensure both stability of the Gröbner basis and a unique maximal-weight term in each basis
element. A positive integral weight realizing these comparisons identifies the weight-initial
ideal with the original monomial-order leading-term ideal. This only represents the finite
data needed for this ideal, not every comparison of the monomial order.

## References

* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, AMS, 1996, Chapters 1–2.
* D. Cox, J. Little, D. O'Shea, *Ideals, Varieties, and Algorithms*, Chapter 2, §6
  (standard representations and Gröbner bases).
-/

public section

open MvPolynomial

namespace MonomialOrder

variable {σ R : Type*} {m : MonomialOrder σ} {w : σ → ℕ}

section CommSemiring

variable [CommSemiring R] {G : Set (MvPolynomial σ R)} {f : MvPolynomial σ R}

/-- A bounded standard representation in the weight-refined order implies membership of the
weight-initial form in the ideal generated by the weight-initial forms of the divisors.
Neither division nor unit leading coefficients are needed. -/
theorem IsRemainder.weightInitialForm_mem_span
    (h : (m.weightRefinement w).IsRemainder f G 0) :
    weightInitialForm w f ∈ Ideal.span (weightInitialForm w '' G) := by
  classical
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  obtain ⟨q, hq, hbound⟩ := h.exists_linearCombination
  rw [add_zero, Finsupp.linearCombination_apply, Finsupp.sum] at hq
  have htop := congrArg (weightedHomogeneousComponent w (f.weightedTotalDegree w)) hq
  rw [map_sum] at htop
  rw [weightInitialForm_def, htop]
  refine sum_mem fun g _ ↦ ?_
  by_cases hg0 : (g : MvPolynomial σ R) = 0
  · simp [hg0]
  by_cases hq0 : q g = 0
  · simp [hq0]
  have hdeg := (toWithBotSyn_withBotDegree_add_le_iff hg0 hq0 hf).1 (hbound g)
  rw [← map_add] at hdeg
  have hw := m.weight_le_of_weightRefinement_le w hdeg
  simp only [map_add, m.weight_degree_weightRefinement] at hw
  -- Only products reaching the maximal weight contribute; their top components factor.
  rcases eq_or_lt_of_le hw with heq | hlt
  · rw [← heq, add_comm, smul_eq_mul, weightedHomogeneousComponent_weightedTotalDegree_add,
      ← weightInitialForm_def, ← weightInitialForm_def]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨g, g.2, rfl⟩)
  · rw [smul_eq_mul, weightedHomogeneousComponent_eq_zero _ _
      ((weightedTotalDegree_mul_le w (q g) (g : MvPolynomial σ R)).trans_lt
        (by simpa [add_comm] using hlt))]
    exact zero_mem _

end CommSemiring

section CommRing

variable [CommRing R] {G : Set (MvPolynomial σ R)} {I : Ideal (MvPolynomial σ R)}

/-- A Gröbner basis for the weight-refined order computes the whole weight-initial ideal,
not just initial forms of a chosen generating set. This holds over any commutative ring,
without conditions on leading coefficients or the number of variables or generators. -/
theorem IsGroebnerBasis.weightInitialIdeal_eq_span
    (h : (m.weightRefinement w).IsGroebnerBasis G I) :
    I.weightInitialIdeal w = Ideal.span (weightInitialForm w '' G) := by
  refine le_antisymm ((Ideal.weightInitialIdeal_le_iff w).2 fun f hf ↦ ?_)
    (Ideal.span_le.2 ?_)
  · exact (h.isRemainder_zero_iff_mem.2 hf).weightInitialForm_mem_span
  · rintro _ ⟨g, hg, rfl⟩
    exact Ideal.weightInitialForm_mem_weightInitialIdeal w (h.subset hg)

/-- A finite Gröbner basis with unit leading coefficients admits a positive integral weight
which preserves the basis in the refined order and makes each basis initial a single term.
Consequently the entire weight-initial ideal equals the original leading-term ideal. -/
theorem IsGroebnerBasis.exists_pos_weight_weightInitialIdeal_eq_span_leadingTerm
    (h : m.IsGroebnerBasis G I) (hG : G.Finite)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g)) :
    ∃ w : σ → ℕ, (∀ i, 0 < w i) ∧
      (m.weightRefinement w).IsGroebnerBasis G I ∧
      (∀ g ∈ G, weightInitialForm w g = m.leadingTerm g) ∧
      I.weightInitialIdeal w = Ideal.span (m.leadingTerm '' (I : Set (MvPolynomial σ R))) := by
  classical
  let := hG.fintype
  obtain ⟨C, hCm, hCn⟩ := h.exists_finset_comparisons hG hu
  let D : Finset ((σ →₀ ℕ) × (σ →₀ ℕ)) := C ∪ Finset.univ.biUnion fun g : G ↦
    ((g : MvPolynomial σ R).support.erase (m.degree (g : MvPolynomial σ R))).image
      fun a ↦ (a, m.degree (g : MvPolynomial σ R))
  have hDm : ∀ p ∈ D, p.1 ≺[m] p.2 := by
    intro p hp
    rcases Finset.mem_union.1 hp with hp | hp
    · exact hCm p hp
    · obtain ⟨g, -, hp⟩ := Finset.mem_biUnion.1 hp
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hp
      obtain ⟨hne, ha⟩ := Finset.mem_erase.1 ha
      exact lt_of_le_of_ne (m.le_degree ha) (m.toSyn.injective.ne hne)
  obtain ⟨w, hw, hcomp⟩ := m.exists_pos_weight_lt
    (a := fun p : D ↦ p.1.1) (b := fun p : D ↦ p.1.2) fun p ↦ hDm p p.2
  have hn := (hCn (m.weightRefinement w) fun p hp ↦
    m.weightRefinement_lt_of_weight_lt w (hcomp ⟨p, Finset.mem_union_left _ hp⟩)).1
  have hi : ∀ g ∈ G, weightInitialForm w g = m.leadingTerm g := by
    intro g hg
    apply m.weightInitialForm_eq_leadingTerm w g
    intro a ha hne
    exact hcomp ⟨(a, m.degree g), Finset.mem_union_right _
      (Finset.mem_biUnion.2 ⟨⟨g, hg⟩, Finset.mem_univ _,
        Finset.mem_image.2 ⟨a, Finset.mem_erase.2 ⟨hne, ha⟩, rfl⟩⟩)⟩
  refine ⟨w, hw, hn, hi, ?_⟩
  rw [hn.weightInitialIdeal_eq_span, h.span_leadingTerm_image]
  congr 1
  exact Set.image_congr hi

/-- Over a field in finitely many variables, every monomial-order initial ideal is a
weight-initial ideal for some strictly positive integral weight. This assertion is about the
given ideal, not a representation of the monomial order on all monomials. -/
theorem exists_pos_weight_weightInitialIdeal_eq_span_leadingTerm {k : Type*} [Field k] [Finite σ]
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ k)) :
    ∃ w : σ → ℕ, (∀ i, 0 < w i) ∧
      I.weightInitialIdeal w = Ideal.span (m.leadingTerm '' (I : Set (MvPolynomial σ k))) := by
  obtain ⟨G, hG⟩ := m.exists_finset_isGroebnerBasis I
  obtain ⟨w, hw, -, -, heq⟩ :=
    hG.exists_pos_weight_weightInitialIdeal_eq_span_leadingTerm G.finite_toSet
    fun g _ ↦ m.isUnit_leadingCoeff.2
  exact ⟨w, hw, heq⟩

end CommRing

end MonomialOrder
