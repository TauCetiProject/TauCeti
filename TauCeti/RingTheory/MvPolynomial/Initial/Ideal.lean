module

public import TauCeti.RingTheory.MvPolynomial.Initial.Weight

/-!
# Weight-initial ideals

`Ideal.weightInitialIdeal` is generated by the maximal-weight initial forms of all polynomials
in an ideal. It is homogeneous for the weight grading and fixes every ideal already homogeneous
for that grading; consequently taking the initial ideal twice has the same effect as taking it
once. For a principal ideal over a semiring without zero divisors, the initial form of its
generator generates its entire initial ideal.

The definition uses all members of the ideal. Initial forms of an arbitrary chosen generating
set alone need not generate the initial ideal.

## References

* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, AMS, 1996, Chapter 1.
-/

public section

open MvPolynomial

namespace Ideal

variable {σ R : Type*} [CommSemiring R]

/-- The ideal generated by maximal-weight initial forms of all members of `I`. -/
noncomputable def weightInitialIdeal (I : Ideal (MvPolynomial σ R)) (w : σ → ℕ) :
    Ideal (MvPolynomial σ R) :=
  span (weightInitialForm w '' I)

theorem weightInitialIdeal_def (I : Ideal (MvPolynomial σ R)) (w : σ → ℕ) :
    I.weightInitialIdeal w = span (weightInitialForm w '' I) := (rfl)

theorem weightInitialForm_mem_weightInitialIdeal {I : Ideal (MvPolynomial σ R)} (w : σ → ℕ)
    {p : MvPolynomial σ R} (hp : p ∈ I) : weightInitialForm w p ∈ I.weightInitialIdeal w :=
  subset_span (Set.mem_image_of_mem _ hp)

/-- To bound an initial ideal, it suffices to check the initial forms of all members. -/
theorem weightInitialIdeal_le_iff {I J : Ideal (MvPolynomial σ R)} (w : σ → ℕ) :
    I.weightInitialIdeal w ≤ J ↔ ∀ p ∈ I, weightInitialForm w p ∈ J := by
  rw [weightInitialIdeal_def, span_le, Set.image_subset_iff]
  rfl

theorem weightInitialIdeal_mono {I J : Ideal (MvPolynomial σ R)} (h : I ≤ J) (w : σ → ℕ) :
    I.weightInitialIdeal w ≤ J.weightInitialIdeal w :=
  span_mono (Set.image_mono h)

attribute [local instance] MvPolynomial.weightedGradedAlgebra

/-- A weight-initial ideal is homogeneous for the same weight grading. -/
theorem isHomogeneous_weightInitialIdeal (I : Ideal (MvPolynomial σ R)) (w : σ → ℕ) :
    (I.weightInitialIdeal w).IsHomogeneous (weightedHomogeneousSubmodule R w) := by
  apply homogeneous_span
  rintro _ ⟨p, _, rfl⟩
  exact ⟨_, isWeightedHomogeneous_weightInitialForm w p⟩

/-- A weight-homogeneous ideal is unchanged by taking its weight-initial ideal. -/
theorem IsHomogeneous.weightInitialIdeal_eq {I : Ideal (MvPolynomial σ R)} {w : σ → ℕ}
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule R w)) : I.weightInitialIdeal w = I := by
  refine le_antisymm ((weightInitialIdeal_le_iff w).mpr fun p hp ↦ ?_) ?_
  · rw [weightInitialForm_def]
    exact weightedHomogeneousComponent_mem_of_mem R w hI hp _
  · intro p hp
    rw [← finsum_weightedHomogeneousComponent w p,
      finsum_eq_sum _ (weightedHomogeneousComponent_finsupp p)]
    apply sum_mem
    intro n _
    rw [← (weightedHomogeneousComponent_isWeightedHomogeneous n p).weightInitialForm w]
    exact weightInitialForm_mem_weightInitialIdeal w
      (weightedHomogeneousComponent_mem_of_mem R w hI hp n)

/-- The fixed ideals of the initial-ideal operation are exactly the weight-homogeneous ideals. -/
theorem weightInitialIdeal_eq_self_iff (I : Ideal (MvPolynomial σ R)) (w : σ → ℕ) :
    I.weightInitialIdeal w = I ↔ I.IsHomogeneous (weightedHomogeneousSubmodule R w) := by
  refine ⟨fun h ↦ ?_, fun h ↦ h.weightInitialIdeal_eq⟩
  rw [← h]
  exact I.isHomogeneous_weightInitialIdeal w

@[simp]
theorem weightInitialIdeal_weightInitialIdeal (I : Ideal (MvPolynomial σ R)) (w : σ → ℕ) :
    (I.weightInitialIdeal w).weightInitialIdeal w = I.weightInitialIdeal w :=
  (I.isHomogeneous_weightInitialIdeal w).weightInitialIdeal_eq

@[simp]
theorem weightInitialIdeal_bot (w : σ → ℕ) :
    (⊥ : Ideal (MvPolynomial σ R)).weightInitialIdeal w = ⊥ :=
  (Ideal.IsHomogeneous.bot _).weightInitialIdeal_eq

@[simp]
theorem weightInitialIdeal_top (w : σ → ℕ) :
    (⊤ : Ideal (MvPolynomial σ R)).weightInitialIdeal w = ⊤ :=
  (Ideal.IsHomogeneous.top _).weightInitialIdeal_eq

/-- For a principal ideal, the initial form of its generator generates the whole initial ideal,
provided the coefficient semiring has no zero divisors. -/
@[simp]
theorem weightInitialIdeal_span_singleton [NoZeroDivisors R] (w : σ → ℕ)
    (p : MvPolynomial σ R) :
    (span {p}).weightInitialIdeal w = span {weightInitialForm w p} := by
  refine le_antisymm ((weightInitialIdeal_le_iff w).mpr ?_) (span_le.mpr ?_)
  · intro f hf
    obtain ⟨q, rfl⟩ := mem_span_singleton.mp hf
    rw [weightInitialForm_mul]
    exact mul_mem_right _ _ (subset_span (Set.mem_singleton _))
  · rintro _ rfl
    exact weightInitialForm_mem_weightInitialIdeal w (subset_span (Set.mem_singleton _))

end Ideal
