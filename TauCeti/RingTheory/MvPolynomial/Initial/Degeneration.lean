module

public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.PolynomialAlgebra
public import TauCeti.RingTheory.MvPolynomial.Initial.Ideal
public import TauCeti.RingTheory.MvPolynomial.WeightFiltration

/-!
# The flat degeneration of an ideal to its weight-initial ideal

Give the variable `X i` of `MvPolynomial σ R` the weight `w i ∈ ℕ`, and let `I` be an ideal of
`MvPolynomial σ R`. The *Rees ideal* `Ideal.weightReesIdeal I w` of `(MvPolynomial σ R)[t]` is
the ideal of the one-parameter family degenerating `I` to its weight-initial ideal: it consists of
the `f` whose image under `TauCeti.MvPolynomial.weightReesHom`, the substitution
`X i ↦ X i * t ^ w i`, has all its coefficients in `I`. Through the isomorphism
`TauCeti.MvPolynomial.weightReesEquiv` of `(MvPolynomial σ R)[t]` with the Rees algebra of the
weight filtration, it corresponds to the elements `∑ bₙ tⁿ` of the Rees algebra with every `bₙ`
in `I`, so it is generated by the homogenizations of the members of `I`
(`Ideal.weightReesIdeal_eq_span`).

The quotient `(MvPolynomial σ R)[t] ⧸ I.weightReesIdeal w` is the family. Its fibre at `t = 1` is
`MvPolynomial σ R ⧸ I` (`Ideal.map_evalRingHom_one_weightReesIdeal`), and its special fibre at
`t = 0` is `MvPolynomial σ R ⧸ I.weightInitialIdeal w`
(`Ideal.map_constantCoeff_weightReesIdeal`). The Rees ideal is `t`-saturated
(`Ideal.X_mul_mem_weightReesIdeal_iff`), so the special fibre carries no extra component supported
at `t = 0`. More generally it is saturated with respect to every `r ∈ R[t]` whose leading
coefficient is a unit (`Ideal.mem_weightReesIdeal_of_map_C_mul_mem`), since modulo `I` such an `r`
is not a zero divisor in `(MvPolynomial σ R ⧸ I)[t]`. Over a field `k`, every nonzero `r ∈ k[t]` is
of this kind, so the family is torsion-free, and therefore flat, over the principal ideal domain
`k[t]` (`Ideal.flat_quotient_weightReesIdeal`).

No finiteness is needed: `I` is arbitrary, and the weights may vanish.

## Main results

* `Ideal.mem_weightReesIdeal_iff`: membership in the Rees ideal, coefficientwise.
* `Ideal.mem_weightReesIdeal_iff_map_mk`: over a commutative ring, membership in the Rees ideal
  as vanishing modulo `I`.
* `Ideal.weightReesIdeal_eq_span`: the Rees ideal is generated by the homogenizations of the
  members of `I`.
* `Ideal.X_mul_mem_weightReesIdeal_iff`: the Rees ideal is `t`-saturated.
* `Ideal.map_evalRingHom_one_weightReesIdeal`: the fibre at `t = 1` is `I`.
* `Ideal.map_constantCoeff_weightReesIdeal`: the fibre at `t = 0` is the weight-initial ideal.
* `Ideal.mem_weightReesIdeal_of_map_C_mul_mem`: the Rees ideal is saturated with respect to every
  `r ∈ R[t]` with a unit leading coefficient.
* `Ideal.flat_quotient_weightReesIdeal`: over a field `k`, the family is flat over `k[t]`.

## References

* D. Eisenbud, *Commutative Algebra with a View Toward Algebraic Geometry*, GTM 150, §15.8
  (flat degeneration to the initial ideal).
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 1.
-/

public section

open scoped Polynomial

open MvPolynomial TauCeti.MvPolynomial

namespace Ideal

variable {σ R : Type*} [CommSemiring R]

/-- The Rees ideal of `I` for the weights `w`: the ideal of `(MvPolynomial σ R)[t]` of the
polynomials whose image under the substitution `X i ↦ X i * t ^ w i` has all its coefficients
in `I`. The quotient by it is the family whose fibre at `t = 1` is `MvPolynomial σ R ⧸ I` and
whose fibre at `t = 0` is the quotient by the weight-initial ideal of `I`; over a field it is flat
over `k[t]` (`Ideal.flat_quotient_weightReesIdeal`). -/
noncomputable def weightReesIdeal (I : Ideal (MvPolynomial σ R)) (w : σ → ℕ) :
    Ideal (MvPolynomial σ R)[X] :=
  (I.map Polynomial.C).comap (weightReesHom R w)

theorem weightReesIdeal_def (I : Ideal (MvPolynomial σ R)) (w : σ → ℕ) :
    I.weightReesIdeal w = (I.map Polynomial.C).comap (weightReesHom R w) := (rfl)

variable {I : Ideal (MvPolynomial σ R)} {w : σ → ℕ}

/-- A polynomial lies in the Rees ideal exactly when every coefficient of its image under
`weightReesHom` lies in `I`. -/
theorem mem_weightReesIdeal_iff {f : (MvPolynomial σ R)[X]} :
    f ∈ I.weightReesIdeal w ↔ ∀ n, (weightReesHom R w f).coeff n ∈ I := by
  rw [weightReesIdeal_def, mem_comap, mem_map_C_iff]

/-- The homogenization in degree `n` of a member of `I` of weight at most `n` lies in the Rees
ideal. -/
theorem weightHomogenization_mem_weightReesIdeal {n : ℕ} {p : MvPolynomial σ R} (hpI : p ∈ I)
    (hp : p ∈ weightFiltration R w n) : weightHomogenization R w n p ∈ I.weightReesIdeal w := by
  rw [mem_weightReesIdeal_iff, weightReesHom_weightHomogenization hp]
  intro k
  rw [Polynomial.coeff_monomial, Finsupp.single_apply]
  split_ifs
  exacts [hpI, zero_mem I]

variable (I w) in
/-- The Rees ideal is generated by the homogenizations of the members of `I`, in every degree at
least their weight. -/
theorem weightReesIdeal_eq_span :
    I.weightReesIdeal w = span {f | ∃ n, ∃ p ∈ I, p ∈ weightFiltration R w n ∧
      weightHomogenization R w n p = f} := by
  refine le_antisymm (fun f hf ↦ ?_) (span_le.mpr ?_)
  · rw [← f.sum_weightHomogenization_coeff_weightReesHom (w := w)]
    refine _root_.sum_mem fun n _ ↦ subset_span ?_
    exact ⟨n, _, mem_weightReesIdeal_iff.mp hf n, f.coeff_weightReesHom_mem_weightFiltration n, rfl⟩
  · rintro _ ⟨n, p, hpI, hp, rfl⟩
    exact weightHomogenization_mem_weightReesIdeal hpI hp

/-- The Rees ideal is saturated with respect to the Rees parameter `t`. -/
@[simp]
theorem X_mul_mem_weightReesIdeal_iff {f : (MvPolynomial σ R)[X]} :
    Polynomial.X * f ∈ I.weightReesIdeal w ↔ f ∈ I.weightReesIdeal w := by
  simp only [mem_weightReesIdeal_iff, map_mul, weightReesHom_X]
  refine ⟨fun h n ↦ by simpa using h (n + 1), fun h n ↦ ?_⟩
  cases n with
  | zero => simp
  | succ n => simpa using h n

variable (I w) in
/-- The fibre of the family at `t = 1`: setting `t = 1` in the Rees ideal gives back `I`. -/
@[simp]
theorem map_evalRingHom_one_weightReesIdeal :
    (I.weightReesIdeal w).map (Polynomial.evalRingHom 1) = I := by
  rw [weightReesIdeal_eq_span, map_span]
  refine le_antisymm (span_le.mpr ?_) fun p hp ↦ subset_span ⟨_, ⟨_, p, hp,
    mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl, rfl⟩, ?_⟩
  · rintro _ ⟨_, ⟨n, p, hpI, -, rfl⟩, rfl⟩
    simpa using hpI
  · simp

variable (I w) in
/-- The special fibre of the family: setting `t = 0` in the Rees ideal gives the weight-initial
ideal of `I`. -/
@[simp]
theorem map_constantCoeff_weightReesIdeal :
    (I.weightReesIdeal w).map Polynomial.constantCoeff = I.weightInitialIdeal w := by
  rw [weightReesIdeal_eq_span, map_span, weightInitialIdeal_def]
  refine le_antisymm (span_le.mpr ?_) (span_mono ?_)
  · rintro _ ⟨_, ⟨n, p, hpI, hp, rfl⟩, rfl⟩
    rw [Polynomial.constantCoeff_apply, coeff_zero_weightHomogenization hp]
    rcases (mem_weightFiltration_iff_weightedTotalDegree_le.mp hp).lt_or_eq with hlt | rfl
    · rw [weightedHomogeneousComponent_eq_zero _ _ hlt]
      exact zero_mem _
    · exact subset_span ⟨p, hpI, weightInitialForm_def w p⟩
  · rintro _ ⟨p, hp, rfl⟩
    refine ⟨_, ⟨_, p, hp, mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl, rfl⟩, ?_⟩
    rw [Polynomial.constantCoeff_apply, coeff_zero_weightHomogenization
      (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl), weightInitialForm_def]

section CommRing

variable {R : Type*} [CommRing R] {I : Ideal (MvPolynomial σ R)}

/-- A polynomial lies in the Rees ideal exactly when its image under `weightReesHom` vanishes
modulo `I`. -/
theorem mem_weightReesIdeal_iff_map_mk {f : (MvPolynomial σ R)[X]} :
    f ∈ I.weightReesIdeal w ↔ (weightReesHom R w f).map (Quotient.mk I) = 0 := by
  rw [weightReesIdeal_def, mem_comap, ← Polynomial.coe_mapRingHom, ← RingHom.mem_ker,
    Polynomial.ker_mapRingHom, mk_ker]

/-- The Rees ideal is saturated with respect to every `r ∈ R[t]` whose leading coefficient is a
unit, such as a monic `r`: if `r * f` lies in it, so does `f`. -/
theorem mem_weightReesIdeal_of_map_C_mul_mem {r : R[X]} (hr : IsUnit r.leadingCoeff)
    {f : (MvPolynomial σ R)[X]} (h : r.map C * f ∈ I.weightReesIdeal w) :
    f ∈ I.weightReesIdeal w := by
  -- Reduce modulo `I`: the image of `r` in `(MvPolynomial σ R ⧸ I)[t]` still has a unit leading
  -- coefficient, so it is not a zero divisor.
  rw [mem_weightReesIdeal_iff_map_mk] at h ⊢
  simp only [map_mul, Polynomial.weightReesHom_map_C, Polynomial.map_mul, Polynomial.map_map] at h
  nontriviality MvPolynomial σ R ⧸ I
  have hu : IsUnit ((Quotient.mk I).comp C r.leadingCoeff) := hr.map _
  rw [← Polynomial.leadingCoeff_map_of_leadingCoeff_ne_zero _ hu.ne_zero] at hu
  exact (Polynomial.isUnit_leadingCoeff_mul_right_eq_zero_iff hu).mp h

end CommRing

section Field

variable {k : Type*} [Field k] {I : Ideal (MvPolynomial σ k)}

attribute [local instance] Polynomial.algebra

variable (I w) in
/-- **Flatness of the degeneration.** Over a field `k`, the family
`(MvPolynomial σ k)[t] ⧸ I.weightReesIdeal w`, which degenerates `MvPolynomial σ k ⧸ I` to
`MvPolynomial σ k ⧸ I.weightInitialIdeal w`, is flat over `k[t]`, acting through
`Polynomial.algebra`. -/
theorem flat_quotient_weightReesIdeal :
    Module.Flat k[X] ((MvPolynomial σ k)[X] ⧸ I.weightReesIdeal w) := by
  -- Over the principal ideal domain `k[t]`, torsion-free modules are flat.
  have : Module.IsTorsionFree k[X] ((MvPolynomial σ k)[X] ⧸ I.weightReesIdeal w) := by
    refine .of_smul_eq_zero fun r g hrg ↦ or_iff_not_imp_left.mpr fun hr ↦ ?_
    obtain ⟨f, rfl⟩ := Quotient.mk_surjective g
    -- Through `Polynomial.algebra`, `r` acts on `(MvPolynomial σ k)[t]` as multiplication by
    -- `r.map C`.
    have hrf : r • f = r.map C * f := by simp [Algebra.smul_def]
    have hmem : r.map C * f ∈ I.weightReesIdeal w := by
      rw [← hrf, ← Quotient.eq_zero_iff_mem]
      exact (Submodule.Quotient.mk_smul _ r f).trans hrg
    exact Quotient.eq_zero_iff_mem.mpr <| mem_weightReesIdeal_of_map_C_mul_mem
      (isUnit_iff_ne_zero.mpr (Polynomial.leadingCoeff_ne_zero.mpr hr)) hmem
  infer_instance

end Field

end Ideal
