module

public import Mathlib.Algebra.MvPolynomial.Monad
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.Tactic.Ring

/-!
# Rescaling the variables of a multivariate polynomial

For `a : σ → R`, the `R`-algebra endomorphism `MvPolynomial.rescale a` of `MvPolynomial σ R`
substitutes `C (a i) * X i` for each variable `X i`. It multiplies the coefficient of `X^n` by
`∏ i, a i ^ n i`, so it is the polynomial counterpart of Mathlib's `MvPowerSeries.rescale`. For a
family of units it is an algebra automorphism, `MvPolynomial.rescaleEquiv`, whose inverse rescales
by the inverse units.

Rescaling the variables before substituting a family `f` is the same as substituting the rescaled
family `a i • f i` (`MvPolynomial.aeval_rescale`). This is how the substitution of a family
`b i = C (ℓ i) * c i` is compared with the substitution of `c`: one is obtained from the other by
the automorphism `rescaleEquiv ℓ`, which changes neither supports nor kernels up to transport.
-/

public section

namespace MvPolynomial

variable {σ R : Type*} [CommSemiring R]

/-- The `R`-algebra endomorphism of `MvPolynomial σ R` substituting `C (a i) * X i` for each
variable `X i`; it multiplies the coefficient of `X^n` by `∏ i, a i ^ n i`. -/
noncomputable def rescale (a : σ → R) : MvPolynomial σ R →ₐ[R] MvPolynomial σ R :=
  aeval fun i ↦ C (a i) * X i

variable {a : σ → R}

/-- Unfolding lemma for `MvPolynomial.rescale`. -/
theorem rescale_def (a : σ → R) : rescale a = aeval fun i ↦ C (a i) * X i :=
  (rfl)

@[simp]
theorem rescale_X (a : σ → R) (i : σ) : rescale a (X i) = C (a i) * X i :=
  aeval_X _ _

@[simp]
theorem rescale_monomial (a : σ → R) (n : σ →₀ ℕ) (r : R) :
    rescale a (monomial n r) = monomial n ((n.prod fun i e ↦ a i ^ e) * r) := by
  rw [rescale, aeval_monomial, monomial_eq, algebraMap_eq]
  simp only [Finsupp.prod, mul_pow, Finset.prod_mul_distrib, ← map_pow, ← map_prod, C_mul]
  ring

@[simp]
theorem coeff_rescale (a : σ → R) (p : MvPolynomial σ R) (n : σ →₀ ℕ) :
    (rescale a p).coeff n = (n.prod fun i e ↦ a i ^ e) * p.coeff n := by
  classical
  induction p using MvPolynomial.induction_on' with
  | monomial e r =>
    rw [rescale_monomial, coeff_monomial, coeff_monomial]
    split_ifs with h
    · rw [h]
    · rw [mul_zero]
  | add p q hp hq =>
    simp only [map_add, AddMonoidAlgebra.coeff_add, Finsupp.coe_add, Pi.add_apply]
    rw [hp, hq, mul_add]

/-- Substituting a family into a rescaled polynomial is substituting the rescaled family. -/
theorem aeval_rescale {S : Type*} [CommSemiring S] [Algebra R S] (f : σ → S) (a : σ → R)
    (p : MvPolynomial σ R) :
    aeval f (rescale a p) = aeval (fun i ↦ algebraMap R S (a i) * f i) p := by
  rw [rescale, ← AlgHom.comp_apply, comp_aeval]
  simp

@[simp]
theorem rescale_rescale (a b : σ → R) (p : MvPolynomial σ R) :
    rescale a (rescale b p) = rescale (a * b) p := by
  have h : (rescale a).comp (rescale b) = rescale (a * b) := algHom_ext fun i ↦ by
    simp only [AlgHom.comp_apply, rescale_X, map_mul, algHom_C, algebraMap_eq, Pi.mul_apply]
    ring
  exact DFunLike.congr_fun h p

@[simp]
theorem rescale_one : rescale (1 : σ → R) = AlgHom.id R (MvPolynomial σ R) :=
  algHom_ext fun i ↦ by simp

/-- Rescaling by units does not change the support. -/
theorem support_rescale (ha : ∀ i, IsUnit (a i)) (p : MvPolynomial σ R) :
    (rescale a p).support = p.support := by
  ext n
  have hn : IsUnit (n.prod fun i e ↦ a i ^ e) := IsUnit.prod_iff.2 fun i _ ↦ (ha i).pow _
  simp only [mem_support_iff, coeff_rescale, ne_eq, hn.mul_right_eq_zero]

/-- Rescaling by a family of units is an `R`-algebra automorphism, with inverse rescaling by the
inverse units. -/
noncomputable def rescaleEquiv (u : σ → Rˣ) : MvPolynomial σ R ≃ₐ[R] MvPolynomial σ R :=
  AlgEquiv.ofAlgHom (rescale fun i ↦ (u i : R)) (rescale fun i ↦ ((u i)⁻¹ : Rˣ))
    (algHom_ext fun i ↦ by simp [← mul_assoc, ← C_mul])
    (algHom_ext fun i ↦ by simp [← mul_assoc, ← C_mul])

@[simp]
theorem coe_rescaleEquiv (u : σ → Rˣ) : ⇑(rescaleEquiv u) = rescale fun i ↦ (u i : R) :=
  (rfl)

@[simp]
theorem rescaleEquiv_symm (u : σ → Rˣ) : (rescaleEquiv u).symm = rescaleEquiv u⁻¹ :=
  (rfl)

/-- The preimage of an ideal generated by `F` under rescaling by units is generated by the image
of `F` under rescaling by the inverse units. -/
theorem comap_rescaleEquiv_span (u : σ → Rˣ) (F : Set (MvPolynomial σ R)) :
    (Ideal.span F).comap (rescaleEquiv u) = Ideal.span (rescaleEquiv u⁻¹ '' F) := by
  rw [← rescaleEquiv_symm, ← Ideal.map_span]
  exact (Ideal.map_symm (rescaleEquiv u).toRingEquiv).symm

end MvPolynomial
