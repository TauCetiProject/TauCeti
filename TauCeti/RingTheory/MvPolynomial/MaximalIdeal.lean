/-!
# Triangular monic generators of maximal ideals of polynomial rings

Let `P` be a maximal ideal of `K[X₀, …, Xₙ₋₁]` for a field `K`. Then `P` is generated by `n`
polynomials `p₀, …, pₙ₋₁` in triangular form: `pᵢ` is monic in `Xᵢ`, with coefficients
polynomials in the later variables `Xⱼ`, `j > i`. Concretely `pᵢ = gᵢ(Xᵢ)` for a monic
one-variable polynomial `gᵢ` over `K[X₀, …, Xₙ₋₁]` whose coefficients only involve the variables
`Xⱼ` with `j > i`. For instance the maximal ideal `(X₀ - X₁, X₁² - 2)` of `ℚ[X₀, X₁]` has this
form, with `g₀ = T - X₁` and `g₁ = T² - 2`.

More generally, over a Jacobson ring `R` every maximal ideal `P` of `R[X₀, …, Xₙ₋₁]` is
`(P ∩ R) R[X] + (p₀, …, pₙ₋₁)` with the `pᵢ` as above.

This normal form describes the closed points of affine space by equations: the residue field
`K[X] ⧸ P` is obtained from `K` by adjoining successively roots of the monic polynomials
`gₙ₋₁, …, g₀`. Grosse-Klönne uses it for the Monsky–Washnitzer algebra `K⟨X₀, …, Xₙ₋₁⟩†`, each of
whose maximal ideals is generated by polynomials of this form.

## Main results

* `MvPolynomial.exists_monic_span_sup_map_eq`: over a Jacobson ring, a maximal ideal `P` of
  `R[X₀, …, Xₙ₋₁]` is generated by `P ∩ R` and `n` triangular polynomials, monic in successive
  variables.
* `MvPolynomial.exists_monic_span_eq`: over a field, a maximal ideal of `K[X₀, …, Xₙ₋₁]` is
  generated by `n` triangular polynomials, monic in successive variables.

## References

* E. Grosse-Klönne, *Rigid analytic spaces with overconvergent structure sheaf*,
  J. reine angew. Math. 519 (2000), §1, Proposition 1.5.
-/

public section

namespace MvPolynomial

variable {R : Type*} [CommRing R]

/-- The inductive step of `exists_monic_span_sup_map_eq`: over a Jacobson ring `R`, if every
maximal ideal of `R[X₀, …, Xₙ₋₁]` is the sum of the extension of its contraction to `R` and the
ideal generated by `n` triangular polynomials, monic in successive variables, then so is every
maximal ideal of `R[X₀, …, Xₙ]`. -/
private theorem exists_monic_span_sup_map_eq_succ [IsJacobsonRing R] {n : ℕ}
    (ih : ∀ (P : Ideal (MvPolynomial (Fin n) R)) [P.IsMaximal],
      ∃ g : Fin n → Polynomial (MvPolynomial (Fin n) R),
        (∀ i, (g i).Monic) ∧ (∀ i k, vars ((g i).coeff k) ⊆ Finset.Ioi i) ∧
          P = (P.comap C).map C ⊔ Ideal.span (Set.range fun i ↦ (g i).eval (X i)))
    (P : Ideal (MvPolynomial (Fin (n + 1)) R)) [P.IsMaximal] :
    ∃ g : Fin (n + 1) → Polynomial (MvPolynomial (Fin (n + 1)) R),
      (∀ i, (g i).Monic) ∧ (∀ i k, vars ((g i).coeff k) ⊆ Finset.Ioi i) ∧
        P = (P.comap C).map C ⊔ Ideal.span (Set.range fun i ↦ (g i).eval (X i)) := by
  classical
  -- Proof: separate the variable `X₀` with `MvPolynomial.finSuccEquiv`. The contraction of `P` to
  -- `R[X₁, …, Xₙ]` is maximal because this ring is Jacobson
  -- (`Polynomial.isMaximal_comap_C_of_isJacobsonRing`), and over the residue field of that
  -- contraction a maximal ideal of a polynomial ring in one variable has a monic generator
  -- (`Polynomial.exists_monic_span_sup_map_eq`).
  -- Separate the variable `X₀`: `R[X₀, …, Xₙ] ≅ A[T]` with `A = R[X₁, …, Xₙ]`.
  set e : MvPolynomial (Fin (n + 1)) R ≃+* Polynomial (MvPolynomial (Fin n) R) :=
    (finSuccEquiv R n).toRingEquiv with he
  set ψ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin (n + 1)) R :=
    (rename Fin.succ : MvPolynomial (Fin n) R →ₐ[R] _).toRingHom with hψ
  have hsymm (f : Polynomial (MvPolynomial (Fin n) R)) : e.symm f = (f.map ψ).eval (X 0) := by
    simpa [he, hψ, ← finSuccEquiv'_zero] using finSuccEquiv'_symm_apply (R := R) 0 f
  have heψ : e.symm.toRingHom.comp Polynomial.C = ψ :=
    RingHom.ext fun a ↦ by simp [hsymm]
  have hψC : ψ.comp C = C := RingHom.ext fun r ↦ rename_C _ r
  -- The contraction `q = P ∩ A` is maximal since `A` is a Jacobson ring.
  set P' := P.comap e.symm.toRingHom with hP'
  have hP'max : P'.IsMaximal := Ideal.comap_isMaximal_of_surjective _ e.symm.surjective
  set q := P'.comap Polynomial.C with hq
  have hqmax : q.IsMaximal := Polynomial.isMaximal_comap_C_of_isJacobsonRing P'
  have hqP : q.comap C = P.comap C := by
    rw [hq, hP', Ideal.comap_comap, Ideal.comap_comap, ← RingHom.comp_assoc, heψ, hψC]
  obtain ⟨g', hg'm, hg'v, hg'⟩ := ih q
  -- `P'` is not extended from `q`, so it has a monic generator `f` over `q`.
  obtain ⟨f, hfm, hf⟩ :=
    Polynomial.exists_monic_span_sup_map_eq _ P' hqmax (hP'max.ne_map_C q)
  refine ⟨Fin.cons (f.map ψ) fun i ↦ (g' i).map ψ, fun i ↦ ?_, fun i k ↦ ?_, ?_⟩
  · cases i using Fin.cases with
    | zero => rw [Fin.cons_zero]; exact hfm.map ψ
    | succ i => rw [Fin.cons_succ]; exact (hg'm i).map ψ
  · cases i using Fin.cases with
    | zero =>
      simpa [hψ] using vars_rename_subset_Ioi Fin.succ fun j _ ↦ Fin.succ_pos j
    | succ i =>
      simpa [hψ] using vars_rename_subset_Ioi Fin.succ fun j hj ↦
        Fin.succ_lt_succ_iff.2 (Finset.mem_Ioi.1 (hg'v i k hj))
  · -- Renaming the variables along `Fin.succ` moves the generators `g' i (X i)` of `q` to
    -- `(g' i).map ψ (X (i + 1))`.
    have hg'ψ (i : Fin n) : ψ ((g' i).eval (X i)) = ((g' i).map ψ).eval (X i.succ) := by
      simp [hψ, Polynomial.eval_map, ← Polynomial.eval₂_at_apply]
    have hrange : (Set.range fun i ↦ ((Fin.cons (f.map ψ) fun i ↦ (g' i).map ψ :
        Fin (n + 1) → Polynomial (MvPolynomial (Fin (n + 1)) R)) i).eval (X i)) =
        insert (e.symm f) (ψ '' Set.range fun i ↦ (g' i).eval (X i)) := by
      simp [Fin.range_fin_succ, Fin.tail_def, ← Set.range_comp, Function.comp_def, hsymm, hg'ψ]
    calc P = P'.map e.symm.toRingHom :=
          (Ideal.map_comap_of_surjective _ e.symm.surjective P).symm
      _ = (q.map Polynomial.C ⊔ Ideal.span {f}).map e.symm.toRingHom := congrArg _ hf
      _ = q.map ψ ⊔ Ideal.span {e.symm f} := by
        simp [Ideal.map_sup, Ideal.map_map, Ideal.map_span, ← heψ]
      _ = ((q.comap C).map C ⊔ Ideal.span (Set.range fun i ↦ (g' i).eval (X i))).map ψ ⊔
            Ideal.span {e.symm f} := by
        rw [← hg']
      _ = _ := by
        simp only [Ideal.map_sup, Ideal.map_map, hψC, hqP, Ideal.map_span, hrange,
          Ideal.span_insert]
        ac_rfl

/-- **Triangular monic generators of maximal ideals** over a Jacobson ring. Every maximal ideal
`P` of `R[X₀, …, Xₙ₋₁]` is generated by its contraction `P ∩ R` together with the `n`
polynomials `gᵢ(Xᵢ)`, where each `gᵢ` is a monic polynomial in one variable whose coefficients
only involve the variables `Xⱼ` with `j > i`. -/
theorem exists_monic_span_sup_map_eq [IsJacobsonRing R] {n : ℕ}
    (P : Ideal (MvPolynomial (Fin n) R)) [P.IsMaximal] :
    ∃ g : Fin n → Polynomial (MvPolynomial (Fin n) R),
      (∀ i, (g i).Monic) ∧ (∀ i k, vars ((g i).coeff k) ⊆ Finset.Ioi i) ∧
        P = (P.comap C).map C ⊔ Ideal.span (Set.range fun i ↦ (g i).eval (X i)) := by
  classical
  -- Induction on `n`, separating the variable `X₀` with `MvPolynomial.finSuccEquiv`. The
  -- contraction of `P` to `R[X₁, …, Xₙ₋₁]` is maximal because this ring is Jacobson
  -- (`Polynomial.isMaximal_comap_C_of_isJacobsonRing`), and over the residue field of that
  -- contraction a maximal ideal of a polynomial ring in one variable has a monic generator
  -- (`Polynomial.exists_monic_span_sup_map_eq`).
  induction n with
  | zero =>
    refine ⟨Fin.elim0, fun i ↦ i.elim0, fun i ↦ i.elim0, ?_⟩
    rw [Set.range_eq_empty, Ideal.span_empty, sup_bot_eq,
      Ideal.map_comap_of_surjective _ (C_surjective _)]
  | succ n ih =>
    exact exists_monic_span_sup_map_eq_succ (fun Q _ ↦ ih Q) P

/-- **Triangular monic generators of maximal ideals** over a field. Every maximal ideal `P` of
`K[X₀, …, Xₙ₋₁]` is generated by the `n` polynomials `gᵢ(Xᵢ)`, where each `gᵢ` is a monic
polynomial in one variable whose coefficients only involve the variables `Xⱼ` with `j > i`. -/
theorem exists_monic_span_eq {K : Type*} [Field K] {n : ℕ}
    (P : Ideal (MvPolynomial (Fin n) K)) [P.IsMaximal] :
    ∃ g : Fin n → Polynomial (MvPolynomial (Fin n) K),
      (∀ i, (g i).Monic) ∧ (∀ i k, vars ((g i).coeff k) ⊆ Finset.Ioi i) ∧
        P = Ideal.span (Set.range fun i ↦ (g i).eval (X i)) := by
  obtain ⟨g, hm, hv, hP⟩ := exists_monic_span_sup_map_eq P
  refine ⟨g, hm, hv, ?_⟩
  have hbot : P.comap (C : K →+* MvPolynomial (Fin n) K) = ⊥ :=
    (Ideal.eq_bot_or_top _).resolve_right (Ideal.comap_ne_top _ (Ideal.IsMaximal.ne_top ‹_›))
  rwa [hbot, Ideal.map_bot, bot_sup_eq] at hP

end MvPolynomial
