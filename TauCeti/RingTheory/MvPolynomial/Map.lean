module

public import Mathlib.LinearAlgebra.Dual.Lemmas
public import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# Subalgebras of polynomial rings under extension of scalars

Let `k` be a commutative semiring, `K` a `k`-algebra and `A` a `k`-subalgebra of
`MvPolynomial σ k`. Its *extension* to `K` is the `K`-subalgebra
`Algebra.adjoin K (map (algebraMap k K) '' A)` of `MvPolynomial σ K` generated by the images of the
elements of `A`.

The key observation is a coordinate argument. A `k`-linear form `ℓ : K → k` applied to every
coefficient of a polynomial in the `K`-span of `map (algebraMap k K) '' V`, for a `k`-submodule
`V` of `MvPolynomial σ k`, gives an element of `V`. Over a field `k` and for a nontrivial `K`,
choosing `ℓ` with `ℓ 1 = 1` shows that the extension of `A` contracts back to `A`.

## Main results

* `MvPolynomial.exists_mem_forall_coeff_eq_of_mem_span_image_map`: the coordinate argument.
* `MvPolynomial.toSubmodule_adjoin_image_map`: as a `K`-module, the extension of `A` is spanned
  by the images of the elements of `A`.
* `MvPolynomial.adjoin_image_map_adjoin`: the extension of the subalgebra generated by `B` is
  generated by the image of `B`.
* `MvPolynomial.map_mem_adjoin_image_map_iff`: the extension of `A` contracts back to `A`.
-/

public section

namespace MvPolynomial

variable {σ k K : Type*}

section CommSemiring

variable [CommSemiring k] [CommSemiring K] [Algebra k K]

/-- Applying a `k`-linear form `ℓ : K → k` to the coefficients of a polynomial in the `K`-span
of the image of a `k`-submodule `V` of `MvPolynomial σ k` gives an element of `V`. -/
theorem exists_mem_forall_coeff_eq_of_mem_span_image_map {V : Submodule k (MvPolynomial σ k)}
    {f : MvPolynomial σ K} (hf : f ∈ Submodule.span K (map (algebraMap k K) '' V))
    (ℓ : K →ₗ[k] k) : ∃ g ∈ V, ∀ e, g.coeff e = ℓ (f.coeff e) := by
  obtain ⟨l, hl, rfl⟩ := (Finsupp.mem_span_image_iff_linearCombination K).1 hf
  refine ⟨l.sum fun a c ↦ ℓ c • a, Submodule.sum_mem _ fun a ha ↦
    V.smul_mem _ ((Finsupp.mem_supported K l).1 hl ha), fun e ↦ ?_⟩
  simp only [Finsupp.linearCombination_apply, Finsupp.sum, coeff_sum, map_sum]
  refine Finset.sum_congr rfl fun a _ ↦ ?_
  simp [coeff_map, mul_comm, ← Algebra.smul_def]

/-- As a `K`-module, the extension to `K` of a `k`-subalgebra `A` of `MvPolynomial σ k` is spanned
by the images of the elements of `A`. -/
theorem toSubmodule_adjoin_image_map (A : Subalgebra k (MvPolynomial σ k)) :
    Subalgebra.toSubmodule (Algebra.adjoin K (map (algebraMap k K) '' ↑A)) =
      Submodule.span K (map (algebraMap k K) '' (A : Set (MvPolynomial σ k))) := by
  let L : Submonoid (MvPolynomial σ K) := A.toSubmonoid.map (map (algebraMap k K))
  have hL : (L : Set (MvPolynomial σ K)) = map (algebraMap k K) '' A := Submonoid.coe_map _ _
  rw [← hL, Algebra.adjoin_eq_span, L.closure_eq]

/-- The extension to `K` of the `k`-subalgebra generated by `B` is the `K`-subalgebra generated
by the image of `B`. -/
theorem adjoin_image_map_adjoin (B : Set (MvPolynomial σ k)) :
    Algebra.adjoin K (map (algebraMap k K) '' Algebra.adjoin k B) =
      Algebra.adjoin K (map (algebraMap k K) '' B) := by
  have h (s : Set (MvPolynomial σ k)) :
      map (algebraMap k K) '' s = mapAlgHom (Algebra.ofId k K) '' s := by
    ext
    simp
  rw [h, h, ← Subalgebra.coe_map, ← Algebra.adjoin_image, Algebra.adjoin_adjoin_of_tower]

end CommSemiring

variable [Field k] [CommRing K] [Algebra k K]

/-- **Contraction of an extended subalgebra.** A polynomial over a field `k` whose image lies in
the extension to a nontrivial `k`-algebra `K` of a `k`-subalgebra `A` already lies in `A`. -/
@[simp]
theorem map_mem_adjoin_image_map_iff [Nontrivial K] {A : Subalgebra k (MvPolynomial σ k)}
    {f : MvPolynomial σ k} :
    map (algebraMap k K) f ∈ Algebra.adjoin K (map (algebraMap k K) '' ↑A) ↔ f ∈ A := by
  refine ⟨fun hf ↦ ?_, fun hf ↦ Algebra.subset_adjoin ⟨f, hf, rfl⟩⟩
  rw [← Subalgebra.mem_toSubmodule, toSubmodule_adjoin_image_map] at hf
  obtain ⟨ℓ, hℓ⟩ := Module.Projective.exists_dual_eq_one k (one_ne_zero (α := K))
  obtain ⟨g, hg, hgf⟩ := exists_mem_forall_coeff_eq_of_mem_span_image_map
    (V := Subalgebra.toSubmodule A) hf ℓ
  have hgf' : g = f := by
    ext e
    simp [hgf, coeff_map, Algebra.algebraMap_eq_smul_one, hℓ]
  exact (Subalgebra.mem_toSubmodule A).1 (hgf' ▸ hg)

end MvPolynomial
