module

public import TauCeti.RingTheory.Ideal.Colon
public import TauCeti.RingTheory.MvPolynomial.Ideal
public import TauCeti.RingTheory.MvPolynomial.Groebner.Elimination

/-!
# Saturations and colon ideals by Gröbner bases

Let `I` be an ideal of `MvPolynomial σ R` and `f` a polynomial. The saturation of `I` by `f`
consists of the polynomials `g` with `f ^ n * g ∈ I` for some `n`; it is the contraction of `I`
from the localization of `MvPolynomial σ R` away from `f`. Adjoining the variable `X none`, it
is the contraction along `rename some` of the ideal `I + (f X_none - 1)`
(`Ideal.comap_rename_some_map_rename_some_sup_span`). Hence a Gröbner basis of this auxiliary
ideal decides membership in the saturation by a single remainder, and, for an elimination order,
its members free of `X none` form a Gröbner basis of the saturation.

The colon ideal `(I : f)` of polynomials `g` with `f * g ∈ I` is computed from the intersection
`I ∩ (f)`: when `f` is regular, `(I : f)` is generated by the quotients by `f` of generators of
`I ∩ (f)` (`Ideal.colon_singleton_eq_of_inf_span_singleton_eq`). The intersection is itself an
elimination ideal (`Ideal.span_inf_span_eq_comap_rename_some`), so the members free of `X none`
of a Gröbner basis for an elimination order give generators of `(I : f)` after division by `f`.

## Main results

* `MonomialOrder.IsGroebnerBasis.remainder_eq_zero_iff_exists_pow_mul_mem`: a remainder of `g`
  modulo a Gröbner basis of `I + (f X_none - 1)` vanishes exactly when some power of `f`
  multiplies `g` into `I`.
* `MonomialOrder.IsGroebnerBasis.comap_map_algebraMap_away`: for an elimination order, the
  members free of `X none` of such a Gröbner basis form a Gröbner basis of the saturation.
* `MonomialOrder.IsGroebnerBasis.colon_singleton_eq_span`: for a regular `f` and an elimination
  order, the quotients by `f` of the members free of `X none` of a Gröbner basis of the
  intersection ideal generate the colon ideal.

The variable `X none` is eliminated by any monomial order on `Option σ` for which every monomial
below a monomial free of `X none` is free of `X none`. No result assumes that the coefficients
form a field.

## References

* D. Cox, J. Little, D. O'Shea, *Ideals, Varieties, and Algorithms*, Chapter 4, §4, computing
  ideal quotients and saturations by elimination.
-/

public section

open MvPolynomial

namespace MonomialOrder

variable {σ R : Type*} [CommRing R] {m : MonomialOrder (Option σ)} {m' : MonomialOrder σ}
  {G : Set (MvPolynomial (Option σ) R)} {I : Ideal (MvPolynomial σ R)}
  {f g : MvPolynomial σ R} {r : MvPolynomial (Option σ) R}

/-- A remainder modulo a Gröbner basis of `I + (f X_none - 1)` vanishes exactly on the
saturation of `I` by `f`. Only the given remainder, not its existence, is needed, so this
equivalence requires no unit leading coefficients. -/
theorem IsGroebnerBasis.remainder_eq_zero_iff_exists_pow_mul_mem
    (h : m.IsGroebnerBasis G (I.map (rename some) ⊔ Ideal.span {rename some f * X none - 1}))
    (hr : m.IsRemainder (rename some g) G r) :
    r = 0 ↔ ∃ n : ℕ, f ^ n * g ∈ I := by
  rw [h.remainder_eq_zero_iff_mem hr, ← Ideal.mem_comap,
    Ideal.mem_comap_rename_some_map_rename_some_sup_span_iff]

/-- **Saturation by elimination.** For an elimination order eliminating `X none`, the members
free of `X none` of a Gröbner basis of `I + (f X_none - 1)` form a Gröbner basis of the
saturation of `I` by `f`, the contraction of `I` from the localization `S` away from `f`. -/
theorem IsGroebnerBasis.comap_map_algebraMap_away
    (h : m.IsGroebnerBasis G (I.map (rename some) ⊔ Ideal.span {rename some f * X none - 1}))
    (hm : ∀ a b : σ →₀ ℕ, a ≼[m'] b ↔ a.mapDomain some ≼[m] b.mapDomain some)
    (helim : ∀ a b : Option σ →₀ ℕ, a ≼[m] b → ↑b.support ⊆ Set.range (some : σ → Option σ) →
      ↑a.support ⊆ Set.range (some : σ → Option σ))
    (S : Type*) [CommSemiring S] [Algebra (MvPolynomial σ R) S] [IsLocalization.Away f S] :
    m'.IsGroebnerBasis (rename some ⁻¹' G) ((I.map (algebraMap _ S)).comap (algebraMap _ S)) := by
  rw [← Ideal.comap_rename_some_map_rename_some_sup_span I f S]
  exact h.comap_rename hm helim

/-- **Colon ideals by elimination.** Let `f` be regular, and let `G` be a Gröbner basis, for an
elimination order eliminating `X none`, of the ideal generated by the `X none * p`, `p ∈ s`, and
by `(1 - X none) * f`. Then the colon ideal `(span s : f)` is generated by the polynomials `q`
such that `f * q` is a member of `G` free of `X none`. -/
theorem IsGroebnerBasis.colon_singleton_eq_span {s : Set (MvPolynomial σ R)}
    (h : m.IsGroebnerBasis G
      (Ideal.span ((fun p ↦ X none * rename some p) '' s ∪ {(1 - X none) * rename some f})))
    (hm : ∀ a b : σ →₀ ℕ, a ≼[m'] b ↔ a.mapDomain some ≼[m] b.mapDomain some)
    (helim : ∀ a b : Option σ →₀ ℕ, a ≼[m] b → ↑b.support ⊆ Set.range (some : σ → Option σ) →
      ↑a.support ⊆ Set.range (some : σ → Option σ))
    (hf : IsLeftRegular f) :
    (Ideal.span s).colon {f} = Ideal.span {q | rename some (f * q) ∈ G} := by
  have hinf : Ideal.span s ⊓ Ideal.span {f} = Ideal.span (rename some ⁻¹' G) := by
    rw [Ideal.span_inf_span_eq_comap_rename_some, Set.image_singleton]
    exact h.comap_rename_eq_span hm helim
  -- Every member of `G` free of `X none` lies in `(f)`, so it is `f` times some `q`.
  have hG : rename some ⁻¹' G = (f * ·) '' {q | rename some (f * q) ∈ G} := by
    refine Set.Subset.antisymm (fun p hp ↦ ?_) (Set.image_subset_iff.mpr fun _ hq ↦ hq)
    have hpf : p ∈ Ideal.span s ⊓ Ideal.span {f} := by
      rw [hinf]
      exact Ideal.subset_span hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hpf.2
    exact ⟨q, by rwa [Set.mem_ofPred_eq, mul_comm], mul_comm f q⟩
  refine Ideal.colon_singleton_eq_of_inf_span_singleton_eq hf ?_
  rw [hinf, hG, Ideal.span_mul_span, Set.singleton_mul]

end MonomialOrder
