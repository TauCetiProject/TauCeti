module

public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.RingTheory.MvPolynomial.Basic
public import TauCeti.RingTheory.MvPolynomial.MonomialOrder

/-!
# Initial algebras and SAGBI bases

Let `m` be a monomial order on `σ →₀ ℕ` and let `A` be a subalgebra of `MvPolynomial σ R`. The
*initial algebra* of `A` is the subalgebra generated by the leading terms of all elements of `A`.
A *SAGBI basis* of `A` (Subalgebra Analogue of Gröbner Bases for Ideals) is a subset `B ⊆ A`
whose leading terms generate the initial algebra. This is the subalgebra counterpart of a Gröbner
basis of an ideal: it is the input to subduction, flat degenerations of `A` to its initial algebra
and the SAGBI criterion for presentations.

* `MonomialOrder.initialAlgebra m A`: the initial algebra of `A`.
* `MonomialOrder.leadingExponents m A`: the leading exponents of the nonzero elements of `A`, an
  additive submonoid of `σ →₀ ℕ` when the coefficients have no zero divisors.
* `MonomialOrder.IsSAGBIBasis m B A`: `B ⊆ A` and the leading terms of `B` generate the initial
  algebra of `A`. No finiteness or monicity is required.

## Main results

* `MonomialOrder.mem_initialAlgebra_iff`: over a field, the initial algebra consists of the
  polynomials supported on the leading exponents of `A`.
* `MonomialOrder.initialAlgebraEquiv`: over a field, the initial algebra of `A` is isomorphic to
  the monoid algebra of the monoid of leading exponents of `A`.
* `MonomialOrder.isSAGBIBasis_iff_exists_mem_closure`: over a field, `B ⊆ A` is a SAGBI basis of
  `A` if and only if the leading exponent of every nonzero element of `A` is the leading exponent
  of a nonzero product of elements of `B`.
* `MonomialOrder.IsSAGBIBasis.mem_span`: **subduction**, every element `f` of `A` is a linear
  combination of products of elements of a SAGBI basis, each of leading exponent at most that of
  `f`. Conversely such representations characterize SAGBI bases
  (`MonomialOrder.isSAGBIBasis_iff_forall_mem_span`).
* `MonomialOrder.IsSAGBIBasis.adjoin_eq`: a SAGBI basis of `A` generates `A` as an algebra.

## Implementation notes

The monoid-algebra results use that `MvPolynomial σ k` is by definition
`AddMonoidAlgebra k (σ →₀ ℕ)`, with `AddMonoidAlgebra.single a c` corresponding to `monomial a c`
(`MvPolynomial.single_eq_monomial`).

## References

* L. Robbiano, M. Sweedler, *Subalgebra bases*, in *Commutative Algebra (Salvador, 1988)*,
  Lecture Notes in Mathematics 1430, Springer, 1990, 61–87.
* D. Kapur, K. Madlener, *A completion procedure for computing a canonical basis for a
  k-subalgebra*, in *Computers and Mathematics*, Springer, 1989, 1–11.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
-/

public section

namespace MonomialOrder

open MvPolynomial

variable {σ R : Type*} (m : MonomialOrder σ)

section CommSemiring

variable [CommSemiring R]

/-- The initial algebra of a subalgebra `A` of `MvPolynomial σ R` for the monomial order `m`:
the subalgebra generated by the leading terms of the elements of `A`. -/
noncomputable def initialAlgebra (A : Subalgebra R (MvPolynomial σ R)) :
    Subalgebra R (MvPolynomial σ R) :=
  Algebra.adjoin R (m.leadingTerm '' A)

/-- A subset `B` of a subalgebra `A` is a SAGBI basis of `A` for the monomial order `m` if the
leading terms of the elements of `B` generate the initial algebra of `A`. -/
def IsSAGBIBasis (B : Set (MvPolynomial σ R)) (A : Subalgebra R (MvPolynomial σ R)) : Prop :=
  B ⊆ A ∧ Algebra.adjoin R (m.leadingTerm '' B) = m.initialAlgebra A

variable {m} {f : MvPolynomial σ R} {B B' : Set (MvPolynomial σ R)}
  {A A' : Subalgebra R (MvPolynomial σ R)}

/-- Unfolding lemma for `MonomialOrder.initialAlgebra`. -/
theorem initialAlgebra_def : m.initialAlgebra A = Algebra.adjoin R (m.leadingTerm '' A) :=
  (rfl)

theorem leadingTerm_mem_initialAlgebra (hf : f ∈ A) : m.leadingTerm f ∈ m.initialAlgebra A :=
  Algebra.subset_adjoin ⟨f, hf, rfl⟩

theorem initialAlgebra_mono (h : A ≤ A') : m.initialAlgebra A ≤ m.initialAlgebra A' :=
  Algebra.adjoin_mono (Set.image_mono h)

/-- The initial algebra of the whole polynomial ring is the whole polynomial ring. -/
@[simp]
theorem initialAlgebra_top : m.initialAlgebra (⊤ : Subalgebra R (MvPolynomial σ R)) = ⊤ := by
  refine eq_top_iff.2 (adjoin_range_X.symm.le.trans (Algebra.adjoin_le ?_))
  rintro _ ⟨i, rfl⟩
  rw [← m.leadingTerm_X]
  exact leadingTerm_mem_initialAlgebra Algebra.mem_top

/-- Unfolding lemma for `MonomialOrder.IsSAGBIBasis`. -/
theorem isSAGBIBasis_iff : m.IsSAGBIBasis B A ↔
    B ⊆ A ∧ Algebra.adjoin R (m.leadingTerm '' B) = m.initialAlgebra A :=
  Iff.rfl

theorem IsSAGBIBasis.mk (hBA : B ⊆ A)
    (h : Algebra.adjoin R (m.leadingTerm '' B) = m.initialAlgebra A) : m.IsSAGBIBasis B A :=
  ⟨hBA, h⟩

theorem IsSAGBIBasis.subset (h : m.IsSAGBIBasis B A) : B ⊆ A :=
  h.1

theorem IsSAGBIBasis.adjoin_leadingTerm (h : m.IsSAGBIBasis B A) :
    Algebra.adjoin R (m.leadingTerm '' B) = m.initialAlgebra A :=
  h.2

/-- The leading terms of a subset of `A` always generate a subalgebra of the initial algebra. -/
theorem adjoin_leadingTerm_le_initialAlgebra (hBA : B ⊆ A) :
    Algebra.adjoin R (m.leadingTerm '' B) ≤ m.initialAlgebra A :=
  Algebra.adjoin_mono (Set.image_mono hBA)

/-- A subset of `A` is a SAGBI basis of `A` as soon as its leading terms generate a subalgebra
containing the initial algebra. -/
theorem isSAGBIBasis_iff_initialAlgebra_le :
    m.IsSAGBIBasis B A ↔ B ⊆ A ∧ m.initialAlgebra A ≤ Algebra.adjoin R (m.leadingTerm '' B) :=
  ⟨fun h ↦ ⟨h.1, h.2.ge⟩, fun h ↦ ⟨h.1, (adjoin_leadingTerm_le_initialAlgebra h.1).antisymm h.2⟩⟩

theorem isSAGBIBasis_self (A : Subalgebra R (MvPolynomial σ R)) : m.IsSAGBIBasis A A :=
  ⟨subset_rfl, rfl⟩

/-- A SAGBI basis remains a SAGBI basis after adding further elements of `A`. -/
theorem IsSAGBIBasis.mono (h : m.IsSAGBIBasis B A) (hBB' : B ⊆ B') (hB'A : B' ⊆ A) :
    m.IsSAGBIBasis B' A :=
  isSAGBIBasis_iff_initialAlgebra_le.2
    ⟨hB'A, h.2.symm.le.trans (Algebra.adjoin_mono (Set.image_mono hBB'))⟩

/-- Removing the zero polynomial does not change whether a set is a SAGBI basis. -/
theorem isSAGBIBasis_sdiff_singleton_zero :
    m.IsSAGBIBasis (B \ {0}) A ↔ m.IsSAGBIBasis B A := by
  have hadj : Algebra.adjoin R (m.leadingTerm '' (B \ {0})) =
      Algebra.adjoin R (m.leadingTerm '' B) := by
    refine (Algebra.adjoin_mono (Set.image_mono Set.sdiff_subset)).antisymm
      (Algebra.adjoin_le ?_)
    rintro _ ⟨f, hf, rfl⟩
    rcases eq_or_ne f 0 with rfl | hf0
    · simp
    · exact Algebra.subset_adjoin ⟨f, ⟨hf, hf0⟩, rfl⟩
  simp only [isSAGBIBasis_iff, hadj, Set.sdiff_singleton_subset_iff,
    Set.insert_eq_of_mem (show (0 : MvPolynomial σ R) ∈ (A : Set _) from A.zero_mem)]

/-- The variables form a SAGBI basis of the whole polynomial ring. -/
theorem isSAGBIBasis_range_X :
    m.IsSAGBIBasis (Set.range X) (⊤ : Subalgebra R (MvPolynomial σ R)) := by
  refine ⟨Set.subset_univ _, ?_⟩
  rw [initialAlgebra_top, ← Set.range_comp]
  simp [Function.comp_def, m.leadingTerm_X]

end CommSemiring

section NoZeroDivisors

variable [CommSemiring R] [NoZeroDivisors R] [Nontrivial R]

/-- The leading exponents of the nonzero elements of a subalgebra `A`. Since the coefficients
have no zero divisors, leading exponents add under multiplication, so they form an additive
submonoid of `σ →₀ ℕ`. -/
def leadingExponents (A : Subalgebra R (MvPolynomial σ R)) : AddSubmonoid (σ →₀ ℕ) where
  carrier := {a | ∃ f ∈ A, f ≠ 0 ∧ m.degree f = a}
  zero_mem' := ⟨1, A.one_mem, one_ne_zero, by simp⟩
  add_mem' := by
    rintro _ _ ⟨f, hfA, hf0, rfl⟩ ⟨g, hgA, hg0, rfl⟩
    exact ⟨f * g, A.mul_mem hfA hgA, mul_ne_zero hf0 hg0, m.degree_mul hf0 hg0⟩

variable {m} {f : MvPolynomial σ R} {B : Set (MvPolynomial σ R)}
  {A A' : Subalgebra R (MvPolynomial σ R)} {a : σ →₀ ℕ}

@[simp]
theorem mem_leadingExponents_iff :
    a ∈ m.leadingExponents A ↔ ∃ f ∈ A, f ≠ 0 ∧ m.degree f = a :=
  Iff.rfl

theorem degree_mem_leadingExponents (hf : f ∈ A) (hf0 : f ≠ 0) :
    m.degree f ∈ m.leadingExponents A :=
  ⟨f, hf, hf0, rfl⟩

theorem leadingExponents_mono (h : A ≤ A') : m.leadingExponents A ≤ m.leadingExponents A' :=
  fun _ ⟨f, hf, hf0, hfa⟩ ↦ ⟨f, h hf, hf0, hfa⟩

/-- The additive submonoid generated by the leading exponents of the nonzero elements of `B`
consists of the leading exponents of the nonzero products of elements of `B`. -/
theorem mem_closure_image_degree_iff :
    a ∈ AddSubmonoid.closure (m.degree '' (B \ {0})) ↔
      ∃ g ∈ Submonoid.closure B, g ≠ 0 ∧ m.degree g = a := by
  constructor
  · intro ha
    induction ha using AddSubmonoid.closure_induction with
    | mem _ hb =>
      obtain ⟨b, ⟨hb, hb0⟩, rfl⟩ := hb
      exact ⟨b, Submonoid.subset_closure hb, hb0, rfl⟩
    | zero => exact ⟨1, one_mem _, one_ne_zero, by simp⟩
    | add _ _ _ _ ih₁ ih₂ =>
      obtain ⟨g₁, hg₁, hg₁0, rfl⟩ := ih₁
      obtain ⟨g₂, hg₂, hg₂0, rfl⟩ := ih₂
      exact ⟨g₁ * g₂, mul_mem hg₁ hg₂, mul_ne_zero hg₁0 hg₂0, m.degree_mul hg₁0 hg₂0⟩
  · rintro ⟨g, hg, hg0, rfl⟩
    induction hg using Submonoid.closure_induction with
    | mem b hb => exact AddSubmonoid.subset_closure ⟨b, ⟨hb, hg0⟩, rfl⟩
    | one => simp
    | mul g₁ g₂ _ _ ih₁ ih₂ =>
      rw [m.degree_mul (left_ne_zero_of_mul hg0) (right_ne_zero_of_mul hg0)]
      exact add_mem (ih₁ (left_ne_zero_of_mul hg0)) (ih₂ (right_ne_zero_of_mul hg0))

/-- The leading exponents of `A` form the additive submonoid generated by the leading exponents
of the nonzero elements of `A`. -/
theorem closure_image_degree_eq_leadingExponents :
    AddSubmonoid.closure (m.degree '' ((A : Set (MvPolynomial σ R)) \ {0})) =
      m.leadingExponents A :=
  le_antisymm (AddSubmonoid.closure_le.2 fun _ ⟨f, ⟨hf, hf0⟩, hfa⟩ ↦ ⟨f, hf, hf0, hfa⟩)
    fun _ ⟨f, hf, hf0, hfa⟩ ↦ AddSubmonoid.subset_closure ⟨f, ⟨hf, hf0⟩, hfa⟩

end NoZeroDivisors

section Field

variable {k : Type*} [Field k] {m} {f p : MvPolynomial σ k} {B : Set (MvPolynomial σ k)}
  {A : Subalgebra k (MvPolynomial σ k)} {a : σ →₀ ℕ}

/-- Over a field, the leading terms of `B` generate the monomial `X^a` if and only if `a` is a sum
of leading exponents of nonzero elements of `B`. -/
theorem monomial_one_mem_adjoin_leadingTerm_iff :
    monomial a 1 ∈ Algebra.adjoin k (m.leadingTerm '' B) ↔
      a ∈ AddSubmonoid.closure (m.degree '' (B \ {0})) := by
  have hadj : Algebra.adjoin k (m.leadingTerm '' B) =
      Algebra.adjoin k ((monomial · (1 : k)) '' (m.degree '' (B \ {0}))) := by
    refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
    · rintro _ ⟨f, hf, rfl⟩
      rcases eq_or_ne f 0 with rfl | hf0
      · simp
      · exact (m.leadingTerm_mem_iff _ hf0).2 (Algebra.subset_adjoin ⟨_, ⟨f, ⟨hf, hf0⟩, rfl⟩, rfl⟩)
    · rintro _ ⟨_, ⟨f, ⟨hf, hf0⟩, rfl⟩, rfl⟩
      exact (m.leadingTerm_mem_iff _ hf0).1 (Algebra.subset_adjoin ⟨f, hf, rfl⟩)
  -- `AddMonoidAlgebra.mem_closure_of_mem_span_closure` is stated for `AddMonoidAlgebra`. We apply
  -- it to `MvPolynomial σ k`, which is by definition `AddMonoidAlgebra k (σ →₀ ℕ)`; `hof` matches
  -- `AddMonoidAlgebra.of'` with `monomial · 1` via `single_eq_monomial`.
  have hof : (monomial · (1 : k)) = AddMonoidAlgebra.of' k (σ →₀ ℕ) :=
    funext fun b ↦ by rw [AddMonoidAlgebra.of'_apply, single_eq_monomial]
  rw [hadj]
  refine ⟨fun h ↦ AddMonoidAlgebra.mem_closure_of_mem_span_closure (R := k) ?_, fun h ↦ ?_⟩
  · rw [← Algebra.adjoin_eq_span, ← hof, Subalgebra.mem_toSubmodule]
    exact h
  · induction h using AddSubmonoid.closure_induction with
    | mem b hb => exact Algebra.subset_adjoin ⟨b, hb, rfl⟩
    | zero => simp
    | add a b _ _ iha ihb => simpa using mul_mem iha ihb

/-- Over a field, the leading terms of `B` generate the leading term of a nonzero polynomial `f`
if and only if its leading exponent is a sum of leading exponents of nonzero elements of `B`. -/
theorem leadingTerm_mem_adjoin_leadingTerm_iff (hf : f ≠ 0) :
    m.leadingTerm f ∈ Algebra.adjoin k (m.leadingTerm '' B) ↔
      m.degree f ∈ AddSubmonoid.closure (m.degree '' (B \ {0})) := by
  rw [m.leadingTerm_mem_iff _ hf, monomial_one_mem_adjoin_leadingTerm_iff]

/-- Over a field, a monomial lies in the initial algebra of `A` if and only if its exponent is a
leading exponent of `A` or its coefficient vanishes. -/
@[simp]
theorem monomial_mem_initialAlgebra_iff {c : k} :
    monomial a c ∈ m.initialAlgebra A ↔ a ∈ m.leadingExponents A ∨ c = 0 := by
  rcases eq_or_ne c 0 with rfl | hc
  · simp
  rw [monomial_mem_iff_monomial_one_mem _ hc.isUnit, initialAlgebra_def,
    monomial_one_mem_adjoin_leadingTerm_iff,
    closure_image_degree_eq_leadingExponents]
  simp [hc]

/-- Over a field, the initial algebra of `A` consists of the polynomials supported on the leading
exponents of `A`. -/
theorem mem_initialAlgebra_iff :
    p ∈ m.initialAlgebra A ↔ (p.support : Set (σ →₀ ℕ)) ⊆ m.leadingExponents A := by
  classical
  refine ⟨fun hp ↦ ?_, fun hp ↦ ?_⟩
  · induction hp using Algebra.adjoin_induction with
    | mem _ hx =>
      obtain ⟨f, hf, rfl⟩ := hx
      rcases eq_or_ne f 0 with rfl | hf0
      · simp
      · simpa [support_leadingTerm' hf0] using degree_mem_leadingExponents hf hf0
    | algebraMap c =>
      rcases eq_or_ne c 0 with rfl | hc
      · simp
      · simp [support_C, hc]
    | add x y _ _ hx hy =>
      exact (Finset.coe_subset.2 support_add).trans (by simpa using And.intro hx hy)
    | mul x y _ _ hx hy =>
      refine (Finset.coe_subset.2 (support_mul x y)).trans ?_
      rw [Finset.coe_add]
      exact Set.add_subset_iff.2 fun a ha b hb ↦ add_mem (hx ha) (hy hb)
  · rw [p.as_sum]
    exact Subalgebra.sum_mem _ fun a ha ↦ monomial_mem_initialAlgebra_iff.2 (.inl (hp ha))

/-- Over a field, the initial algebra of `A` is spanned by the monomials whose exponents are
leading exponents of `A`. -/
theorem toSubmodule_initialAlgebra :
    Subalgebra.toSubmodule (m.initialAlgebra A) = restrictSupport k (m.leadingExponents A) :=
  Submodule.ext fun _ ↦ mem_initialAlgebra_iff

/-- The image of the monoid algebra of the leading exponents of `A` in the polynomial ring is the
initial algebra of `A`. Here `MvPolynomial σ k` is identified with `AddMonoidAlgebra k (σ →₀ ℕ)`,
as it is by definition (compare `MvPolynomial.single_eq_monomial`). -/
theorem range_mapDomainAlgHom_leadingExponents :
    (AddMonoidAlgebra.mapDomainAlgHom k k (m.leadingExponents A).subtype).range =
      m.initialAlgebra A := by
  have h (x : AddMonoidAlgebra k (m.leadingExponents A)) :
      AddMonoidAlgebra.mapDomainAlgHom k k (m.leadingExponents A).subtype x ∈
        m.initialAlgebra A := by
    induction x using AddMonoidAlgebra.induction_linear with
    | zero => simp
    | add x y hx hy =>
      rw [map_add]
      exact add_mem hx hy
    | single a c =>
      rw [AddMonoidAlgebra.mapDomainAlgHom_apply, AddMonoidAlgebra.mapDomain_single,
        single_eq_monomial]
      exact monomial_mem_initialAlgebra_iff.2 (.inl a.2)
  refine le_antisymm ?_ (Algebra.adjoin_le ?_)
  · rintro _ ⟨x, rfl⟩
    exact h x
  · rintro _ ⟨f, hf, rfl⟩
    rcases eq_or_ne f 0 with rfl | hf0
    · exact ⟨0, by simp⟩
    · exact ⟨AddMonoidAlgebra.single ⟨_, degree_mem_leadingExponents hf hf0⟩ (m.leadingCoeff f),
        by simp [leadingTerm, single_eq_monomial]⟩

variable (m A) in
/-- Over a field, the initial algebra of `A` is isomorphic to the monoid algebra of the monoid of
leading exponents of `A`, the exponent `a` corresponding to the monomial `X^a`. -/
noncomputable def initialAlgebraEquiv :
    AddMonoidAlgebra k (m.leadingExponents A) ≃ₐ[k] m.initialAlgebra A :=
  (AlgEquiv.ofInjective (AddMonoidAlgebra.mapDomainAlgHom k k (m.leadingExponents A).subtype)
      (AddMonoidAlgebra.mapDomain_injective Subtype.val_injective)).trans
    (Subalgebra.equivOfEq _ _ range_mapDomainAlgHom_leadingExponents)

/-- The isomorphism `initialAlgebraEquiv` is induced by the inclusion of the leading exponents
into `σ →₀ ℕ`. -/
theorem coe_initialAlgebraEquiv (x : AddMonoidAlgebra k (m.leadingExponents A)) :
    (m.initialAlgebraEquiv A x : MvPolynomial σ k) = AddMonoidAlgebra.mapDomain Subtype.val x := by
  rw [initialAlgebraEquiv, AlgEquiv.trans_apply, Subalgebra.equivOfEq_apply]
  exact (AlgEquiv.ofInjective_apply _
    (AddMonoidAlgebra.mapDomain_injective Subtype.val_injective) x).trans
    (AddMonoidAlgebra.mapDomainAlgHom_apply k k _ x)

@[simp]
theorem coe_initialAlgebraEquiv_single (a : m.leadingExponents A) (c : k) :
    (m.initialAlgebraEquiv A (AddMonoidAlgebra.single a c) : MvPolynomial σ k) =
      monomial (a : σ →₀ ℕ) c := by
  rw [coe_initialAlgebraEquiv, AddMonoidAlgebra.mapDomain_single, single_eq_monomial]

/-- Over a field, `B ⊆ A` is a SAGBI basis of `A` if and only if the leading exponent of every
nonzero element of `A` is a sum of leading exponents of nonzero elements of `B`. -/
theorem isSAGBIBasis_iff_degree_mem_closure :
    m.IsSAGBIBasis B A ↔
      B ⊆ A ∧ ∀ f ∈ A, f ≠ 0 → m.degree f ∈ AddSubmonoid.closure (m.degree '' (B \ {0})) := by
  rw [isSAGBIBasis_iff_initialAlgebra_le, initialAlgebra_def, Algebra.adjoin_le_iff]
  refine and_congr_right fun _ ↦ ⟨fun h f hf hf0 ↦
    (leadingTerm_mem_adjoin_leadingTerm_iff hf0).1 (h ⟨f, hf, rfl⟩), ?_⟩
  rintro h _ ⟨f, hf, rfl⟩
  rcases eq_or_ne f 0 with rfl | hf0
  · simp
  · exact (leadingTerm_mem_adjoin_leadingTerm_iff hf0).2 (h f hf hf0)

/-- Over a field, `B ⊆ A` is a SAGBI basis of `A` if and only if every nonzero element of `A` has
the same leading exponent as some nonzero product of elements of `B`. -/
theorem isSAGBIBasis_iff_exists_mem_closure :
    m.IsSAGBIBasis B A ↔ B ⊆ A ∧
      ∀ f ∈ A, f ≠ 0 → ∃ g ∈ Submonoid.closure B, g ≠ 0 ∧ m.degree g = m.degree f := by
  simp only [isSAGBIBasis_iff_degree_mem_closure, mem_closure_image_degree_iff]

/-- **Subduction.** Every element `f` of a subalgebra `A` with SAGBI basis `B` is a `k`-linear
combination of products of elements of `B` whose leading exponents are at most that of `f`. -/
theorem IsSAGBIBasis.mem_span (h : m.IsSAGBIBasis B A) (hf : f ∈ A) :
    f ∈ Submodule.span k {g ∈ Submonoid.closure B | m.degree g ≼[m] m.degree f} := by
  -- Cancel the leading term of `f` by a scalar multiple of a product of elements of `B` with the
  -- same leading exponent, and induct on the degree in the well-founded synonym order.
  induction hd : m.toWithBotSyn (m.withBotDegree f) using WellFoundedLT.induction
    generalizing f with
  | ind d ih =>
  subst hd
  rcases eq_or_ne f 0 with rfl | hf0
  · exact zero_mem _
  obtain ⟨q, hq, hq0, hqf⟩ := (isSAGBIBasis_iff_exists_mem_closure.1 h).2 f hf hf0
  have hqA : q ∈ A := (Submonoid.closure_le (S := A.toSubmonoid)).2 h.subset hq
  obtain ⟨c, hc⟩ : ∃ c : k, c * m.leadingCoeff q = m.leadingCoeff f :=
    ⟨_, div_mul_cancel₀ _ (m.leadingCoeff_ne_zero_iff.2 hq0)⟩
  have hdeg : m.degree (c • q) ≼[m] m.degree f := hqf ▸ m.degree_smul_le
  have hle : m.toWithBotSyn (m.withBotDegree (c • q)) ≤ m.toWithBotSyn (m.withBotDegree f) := by
    rw [(m.withBotDegree_eq_coe_degree_iff f).2 hf0, toWithBotSyn_apply_coe]
    exact (m.toWithBotSyn_withBotDegree_le_toSyn_degree _).trans (WithBot.coe_le_coe.2 hdeg)
  have hcoeff : (c • q).coeff (m.degree f) = m.leadingCoeff f := by
    rw [coeff_smul, ← hqf, smul_eq_mul, ← leadingCoeff, hc]
  have hlt := m.withBotDegree_sub_lt hf0 hle hcoeff
  have hsub : m.degree (f - c • q) ≼[m] m.degree f := m.degree_sub_le.trans (sup_le le_rfl hdeg)
  have h₁ : f - c • q ∈
      Submodule.span k {g ∈ Submonoid.closure B | m.degree g ≼[m] m.degree f} :=
    Submodule.span_mono (Set.ofPred_subset_ofPred.2 fun _ hg ↦ ⟨hg.1, hg.2.trans hsub⟩)
      (ih _ hlt (sub_mem hf (A.smul_mem hqA c)) rfl)
  have h₂ : c • q ∈ Submodule.span k {g ∈ Submonoid.closure B | m.degree g ≼[m] m.degree f} :=
    Submodule.smul_mem _ c (Submodule.subset_span ⟨hq, (congrArg m.toSyn hqf).le⟩)
  simpa using add_mem h₁ h₂

/-- Over a field, `B ⊆ A` is a SAGBI basis of `A` if and only if every element `f` of `A` is a
`k`-linear combination of products of elements of `B` whose leading exponents are at most that
of `f`. -/
theorem isSAGBIBasis_iff_forall_mem_span :
    m.IsSAGBIBasis B A ↔ B ⊆ A ∧
      ∀ f ∈ A, f ∈ Submodule.span k {g ∈ Submonoid.closure B | m.degree g ≼[m] m.degree f} := by
  refine ⟨fun h ↦ ⟨h.subset, fun f ↦ h.mem_span⟩, fun ⟨hBA, h⟩ ↦
    isSAGBIBasis_iff_exists_mem_closure.2 ⟨hBA, fun f hf hf0 ↦ ?_⟩⟩
  -- Otherwise every product in the representation of `f` has vanishing coefficient at the leading
  -- exponent of `f`, and so does `f`.
  by_contra hne
  simp only [not_exists, not_and] at hne
  have hker : Submodule.span k {g ∈ Submonoid.closure B | m.degree g ≼[m] m.degree f} ≤
      LinearMap.ker (lcoeff k (m.degree f)) := by
    refine Submodule.span_le.2 fun g ⟨hg, hgf⟩ ↦ ?_
    rw [SetLike.mem_coe, LinearMap.mem_ker, lcoeff_apply]
    by_contra hc
    exact hne g hg (fun h0 ↦ hc (by simp [h0]))
      (m.toSyn.injective (le_antisymm hgf (m.le_degree (mem_support_iff.2 hc))))
  have hf' := hker (h f hf)
  rw [LinearMap.mem_ker, lcoeff_apply] at hf'
  exact hf0 (m.coeff_degree_eq_zero_iff.1 hf')

/-- A SAGBI basis of `A` generates `A` as a `k`-algebra. -/
theorem IsSAGBIBasis.adjoin_eq (h : m.IsSAGBIBasis B A) : Algebra.adjoin k B = A := by
  refine le_antisymm (Algebra.adjoin_le h.subset) fun f hf ↦ ?_
  rw [← Subalgebra.mem_toSubmodule, Algebra.adjoin_eq_span]
  exact Submodule.span_mono (Set.sep_subset _ _) (h.mem_span hf)

end Field

end MonomialOrder
