module

public import TauCeti.RingTheory.MvPolynomial.Rescale
public import TauCeti.RingTheory.MvPolynomial.SAGBI.Criterion

/-!
# Monic normalization of SAGBI families

The SAGBI criterion `MonomialOrder.isSAGBIBasis_range_iff_forall_exists_aeval_eq` is stated for
monic families. This file reduces an arbitrary family `b : ι → MvPolynomial σ k` of nonzero
polynomials over a field to the monic family `c i = C (ℓ i)⁻¹ * b i`, where
`ℓ i = m.leadingCoeff (b i)`, without changing the subalgebra, its initial algebra or the
coefficient-one presentation data, and keeps track of the scalars `ℓ i` in every comparison.
Zero members are first removed with `MonomialOrder.isSAGBIBasis_range_subtype_ne_zero_iff` and
`MonomialOrder.adjoin_range_subtype_ne_zero`.

* `MonomialOrder.monicNormalize m p`: the polynomial `C (m.leadingCoeff p)⁻¹ * p`, which is monic
  with the same leading exponent when `p ≠ 0`, and satisfies
  `C (m.leadingCoeff p) * m.monicNormalize p = p`.

Normalization changes neither the generated subalgebra nor the algebra generated by the leading
terms, so it preserves SAGBI bases. Let `D_ℓ = MvPolynomial.rescale ℓ` be the automorphism
`Y i ↦ ℓ i * Y i` of the polynomial ring in the variables `Y i`, `i : ι`, with inverse
`D_(ℓ⁻¹)`. The substitution `φ_b = aeval b` is `φ_c ∘ D_ℓ`, and the substitution
`ψ_b : Y i ↦ m.leadingTerm (b i)` of the actual leading terms is `ψ_1 ∘ D_ℓ`, where
`ψ_1 : Y i ↦ X^(m.degree (b i))` has the toric ideal as kernel. Hence the kernels of `φ_b` and
`ψ_b` are the transports by `D_(ℓ⁻¹)` of the kernels of `φ_c` and `ψ_1`, and the same transport
carries generators to generators. The monomial `Y^w` acquires the factor `∏ i, ℓ i ^ w i` under
`D_ℓ` (`MvPolynomial.rescale_monomial`), and `D_ℓ` does not change supports, so certificates
keep their exponent bounds.

## Main results

* `MonomialOrder.isSAGBIBasis_range_monicNormalize_iff`: the normalized family is a SAGBI basis
  of the subalgebra it generates if and only if the original family is.
* `MonomialOrder.aeval_monicNormalize_rescale`, `MonomialOrder.aeval_monomial_degree_rescale`:
  `φ_c ∘ D_ℓ = φ_b` and `ψ_1 ∘ D_ℓ = ψ_b`.
* `MonomialOrder.ker_aeval_eq_span_image` and `MonomialOrder.ker_aeval_leadingTerm_eq_span_image`:
  generators of the kernels of `φ_c` and of `ψ_1` give, after the transport `D_(ℓ⁻¹)`, generators
  of the kernels of `φ_b` and of `ψ_b`.
* `MonomialOrder.isSAGBIBasis_range_iff_forall_exists_aeval_eq_rescale`: **the SAGBI criterion for
  a family of nonzero polynomials**, with the relations `D_(ℓ⁻¹) (Y^(u j) - Y^(v j))` and the
  bounded zero subductions stated for the original family `b`.

## References

* Bruns, Conca, Lembo, arXiv:2504.10019, §2, Theorem 2.2 and Proposition 2.4, for monic SAGBI
  families and bounded subduction.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
-/

public section

open MvPolynomial

namespace MonomialOrder

variable {σ ι k : Type*} [Field k] {m : MonomialOrder σ}

section Polynomial

variable (m) in
/-- The monic normalization `C (m.leadingCoeff p)⁻¹ * p` of a polynomial `p` over a field: it is
monic with the same leading exponent when `p ≠ 0`, and the zero polynomial is its own
normalization. -/
noncomputable def monicNormalize (p : MvPolynomial σ k) : MvPolynomial σ k :=
  C (m.leadingCoeff p)⁻¹ * p

variable {p : MvPolynomial σ k}

theorem monicNormalize_def : m.monicNormalize p = C (m.leadingCoeff p)⁻¹ * p :=
  (rfl)

theorem monicNormalize_eq_smul : m.monicNormalize p = (m.leadingCoeff p)⁻¹ • p := by
  rw [monicNormalize_def, smul_eq_C_mul]

@[simp]
theorem monicNormalize_zero : m.monicNormalize (0 : MvPolynomial σ k) = 0 := by
  simp [monicNormalize_def]

@[simp]
theorem monicNormalize_eq_zero_iff : m.monicNormalize p = 0 ↔ p = 0 := by
  simp [monicNormalize_def]

/-- A polynomial is the product of its leading coefficient and its monic normalization. -/
@[simp]
theorem C_leadingCoeff_mul_monicNormalize (p : MvPolynomial σ k) :
    C (m.leadingCoeff p) * m.monicNormalize p = p := by
  rcases eq_or_ne p 0 with rfl | hp
  · simp
  rw [monicNormalize_def, ← mul_assoc, ← C_mul, mul_inv_cancel₀ (m.leadingCoeff_ne_zero_iff.2 hp),
    C_1, one_mul]

@[simp]
theorem degree_monicNormalize (p : MvPolynomial σ k) :
    m.degree (m.monicNormalize p) = m.degree p := by
  rcases eq_or_ne p 0 with rfl | hp
  · simp
  rw [monicNormalize_def,
    m.degree_mul (C_ne_zero.2 (inv_ne_zero (m.leadingCoeff_ne_zero_iff.2 hp))) hp, m.degree_C,
    zero_add]

theorem monic_monicNormalize (hp : p ≠ 0) : m.Monic (m.monicNormalize p) := by
  rw [Monic, monicNormalize_def, leadingCoeff_mul, leadingCoeff_C,
    inv_mul_cancel₀ (m.leadingCoeff_ne_zero_iff.2 hp)]

/-- A monic polynomial is its own monic normalization. -/
theorem Monic.monicNormalize_eq (hp : m.Monic p) : m.monicNormalize p = p := by
  rw [monicNormalize_def, hp.leadingCoeff_eq_one, inv_one, C_1, one_mul]

/-- Leading terms commute with monic normalization. -/
theorem leadingTerm_monicNormalize (p : MvPolynomial σ k) :
    m.leadingTerm (m.monicNormalize p) = m.monicNormalize (m.leadingTerm p) := by
  rw [monicNormalize_def, monicNormalize_def, leadingTerm_mul, leadingTerm_C,
    leadingCoeff_leadingTerm]

variable {B : Set (MvPolynomial σ k)} {A : Subalgebra k (MvPolynomial σ k)}

theorem image_monicNormalize_subset_iff : m.monicNormalize '' B ⊆ A ↔ B ⊆ A := by
  refine ⟨fun h p hp ↦ ?_, fun h ↦ ?_⟩
  · rw [← C_leadingCoeff_mul_monicNormalize (m := m) p, ← smul_eq_C_mul]
    exact A.smul_mem (h ⟨p, hp, rfl⟩) _
  · rintro _ ⟨p, hp, rfl⟩
    rw [monicNormalize_eq_smul]
    exact A.smul_mem (h hp) _

/-- Monic normalization does not change the generated subalgebra. -/
@[simp]
theorem adjoin_image_monicNormalize (B : Set (MvPolynomial σ k)) :
    Algebra.adjoin k (m.monicNormalize '' B) = Algebra.adjoin k B :=
  le_antisymm (Algebra.adjoin_le (image_monicNormalize_subset_iff.2 Algebra.subset_adjoin))
    (Algebra.adjoin_le (image_monicNormalize_subset_iff.1 Algebra.subset_adjoin))

/-- Monic normalization does not change the algebra generated by the leading terms. -/
theorem adjoin_leadingTerm_image_monicNormalize (B : Set (MvPolynomial σ k)) :
    Algebra.adjoin k (m.leadingTerm '' (m.monicNormalize '' B)) =
      Algebra.adjoin k (m.leadingTerm '' B) := by
  rw [Set.image_image]
  simp_rw [leadingTerm_monicNormalize]
  rw [← Set.image_image m.monicNormalize, adjoin_image_monicNormalize]

/-- Monic normalization preserves SAGBI bases. -/
@[simp]
theorem isSAGBIBasis_image_monicNormalize_iff :
    m.IsSAGBIBasis (m.monicNormalize '' B) A ↔ m.IsSAGBIBasis B A := by
  rw [isSAGBIBasis_iff, isSAGBIBasis_iff, image_monicNormalize_subset_iff,
    adjoin_leadingTerm_image_monicNormalize]

end Polynomial

section Family

variable (b : ι → MvPolynomial σ k)

variable {b} in
/-- The monic normalization of a family is a SAGBI basis of the subalgebra it generates if and
only if the family itself is a SAGBI basis of the subalgebra it generates. -/
theorem isSAGBIBasis_range_monicNormalize_iff :
    m.IsSAGBIBasis (Set.range (fun i ↦ m.monicNormalize (b i)))
        (Algebra.adjoin k (Set.range (fun i ↦ m.monicNormalize (b i)))) ↔
      m.IsSAGBIBasis (Set.range b) (Algebra.adjoin k (Set.range b)) := by
  rw [Set.range_comp', adjoin_image_monicNormalize, isSAGBIBasis_image_monicNormalize_iff]

/-- The substitution `φ_b` of the family `b` is the substitution `φ_c` of its monic
normalization `c`, after the rescaling `D_ℓ : Y i ↦ ℓ i * Y i` by the leading coefficients
`ℓ i` of `b`. -/
theorem aeval_monicNormalize_rescale (P : MvPolynomial ι k) :
    aeval (fun i ↦ m.monicNormalize (b i)) (rescale (fun i ↦ m.leadingCoeff (b i)) P) =
      aeval b P := by
  rw [aeval_rescale]
  simp [algebraMap_eq]

/-- The substitution `φ_c` of the monic normalization `c` of `b` is the substitution `φ_b`, after
the rescaling `D_(ℓ⁻¹) : Y i ↦ ℓ i⁻¹ * Y i` by the inverse leading coefficients `ℓ i⁻¹` of `b`. -/
theorem aeval_rescale_inv_leadingCoeff (P : MvPolynomial ι k) :
    aeval b (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹) P) =
      aeval (fun i ↦ m.monicNormalize (b i)) P := by
  rw [aeval_rescale]
  simp [algebraMap_eq, monicNormalize_def]

/-- The substitution `ψ_b : Y i ↦ m.leadingTerm (b i)` of the actual leading terms of `b` is the
substitution `ψ_1 : Y i ↦ X^(m.degree (b i))` of the coefficient-one leading monomials, after the
rescaling `D_ℓ` by the leading coefficients `ℓ i` of `b`. -/
theorem aeval_monomial_degree_rescale (P : MvPolynomial ι k) :
    aeval (fun i ↦ monomial (m.degree (b i)) (1 : k))
        (rescale (fun i ↦ m.leadingCoeff (b i)) P) =
      aeval (fun i ↦ m.leadingTerm (b i)) P := by
  rw [aeval_rescale]
  simp [algebraMap_eq]

/-- The kernel of `ψ_b : Y i ↦ m.leadingTerm (b i)` is the preimage of the toric ideal of the
leading exponents of `b` under the rescaling `D_ℓ` by the leading coefficients of `b`. -/
theorem ker_aeval_leadingTerm_eq_comap :
    RingHom.ker (aeval fun i ↦ m.leadingTerm (b i)) =
      (TauCeti.toricIdeal k fun i ↦ m.degree (b i)).comap
        (rescale fun i ↦ m.leadingCoeff (b i)) := by
  ext P
  simp only [RingHom.mem_ker, Ideal.mem_comap, TauCeti.mem_toricIdeal_iff, single_eq_monomial,
    aeval_monomial_degree_rescale]

/-- The kernel of `φ_b = aeval b` is the preimage of the kernel of `φ_c` under the rescaling
`D_ℓ` by the leading coefficients of `b`, where `c` is the monic normalization of `b`. -/
theorem ker_aeval_eq_comap_rescale :
    RingHom.ker (aeval b) =
      (RingHom.ker (aeval (fun i ↦ m.monicNormalize (b i)))).comap
        (rescale fun i ↦ m.leadingCoeff (b i)) := by
  ext P
  rw [RingHom.mem_ker, Ideal.mem_comap, RingHom.mem_ker, aeval_monicNormalize_rescale]

variable {b}

/-- For a family of nonzero polynomials, the preimage of an ideal under the rescaling `D_ℓ` by
the leading coefficients is its image under the inverse rescaling `D_(ℓ⁻¹)`; on an ideal given by
generators, this transports the generators. -/
private theorem comap_rescale_span (hb : ∀ i, b i ≠ 0) (F : Set (MvPolynomial ι k)) :
    (Ideal.span F).comap (rescale fun i ↦ m.leadingCoeff (b i)) =
      Ideal.span (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹) '' F) := by
  let u : ι → kˣ := fun i ↦ Units.mk0 _ (m.leadingCoeff_ne_zero_iff.2 (hb i))
  ext P
  have h := SetLike.ext_iff.1 (comap_rescaleEquiv_span u F) P
  simp only [Ideal.mem_comap, coe_rescaleEquiv, Pi.inv_apply, Units.val_inv_eq_inv_val,
    Units.val_mk0, u] at h
  simpa only [Ideal.mem_comap] using h

/-- **Transport of presentations.** Let `c` be the monic normalization of a family `b` of nonzero
polynomials, with leading coefficients `ℓ i`. If `F` generates the kernel of `φ_c = aeval c`, then
its image under the rescaling `D_(ℓ⁻¹)` generates the kernel of `φ_b = aeval b`. -/
theorem ker_aeval_eq_span_image (hb : ∀ i, b i ≠ 0) {F : Set (MvPolynomial ι k)}
    (hF : RingHom.ker (aeval (fun i ↦ m.monicNormalize (b i))) = Ideal.span F) :
    RingHom.ker (aeval b) =
      Ideal.span (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹) '' F) := by
  rw [ker_aeval_eq_comap_rescale, hF, comap_rescale_span hb]

/-- Let `b` be a family of nonzero polynomials with leading coefficients `ℓ i`. If `F` generates
the toric ideal of the leading exponents of `b`, then its image under the rescaling `D_(ℓ⁻¹)`
generates the kernel of `ψ_b : Y i ↦ m.leadingTerm (b i)`. -/
theorem ker_aeval_leadingTerm_eq_span_image (hb : ∀ i, b i ≠ 0) {F : Set (MvPolynomial ι k)}
    (hF : TauCeti.toricIdeal k (fun i ↦ m.degree (b i)) = Ideal.span F) :
    RingHom.ker (aeval fun i ↦ m.leadingTerm (b i)) =
      Ideal.span (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹) '' F) := by
  rw [ker_aeval_leadingTerm_eq_comap, hF, comap_rescale_span hb]

/-- **The SAGBI criterion for a family of nonzero polynomials.** Let `b` be a family of nonzero
polynomials over a field with leading coefficients `ℓ i`, write
`A w = ∑ i, w i • m.degree (b i)`, and let binomials `Y^(u j) - Y^(v j)` generate the toric ideal
of the leading exponents of `b`. Then `b` is a SAGBI basis of the subalgebra it generates if and
only if, for every `j`, the image under `aeval b` of the rescaled relation
`D_(ℓ⁻¹) (Y^(u j) - Y^(v j))` is the image under `aeval b` of a polynomial all of whose exponents
`w` satisfy `A w ≺ A (u j)`. -/
theorem isSAGBIBasis_range_iff_forall_exists_aeval_eq_rescale {J : Type*}
    (hb : ∀ i, b i ≠ 0) {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal k (fun i ↦ m.degree (b i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1)) :
    m.IsSAGBIBasis (Set.range b) (Algebra.adjoin k (Set.range b)) ↔
      ∀ j, ∃ Q : MvPolynomial ι k,
        aeval b Q = aeval b (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹)
          (monomial (u j) (1 : k) - monomial (v j) 1)) ∧
        ∀ w ∈ Q.support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) w ≺[m]
          Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) (u j) := by
  have hdeg : (fun i ↦ m.degree ((fun i ↦ m.monicNormalize (b i)) i)) = fun i ↦ m.degree (b i) :=
    funext fun i ↦ degree_monicNormalize (b i)
  have hunit (i : ι) : IsUnit (m.leadingCoeff (b i)) :=
    (m.leadingCoeff_ne_zero_iff.2 (hb i)).isUnit
  rw [← isSAGBIBasis_range_monicNormalize_iff,
    isSAGBIBasis_range_iff_forall_exists_aeval_eq (fun i ↦ monic_monicNormalize (hb i))
      (hdeg ▸ hJ), hdeg]
  -- The certificates for `b` and for its normalization correspond under the rescalings, which
  -- preserve supports.
  refine forall_congr' fun j ↦ ⟨fun ⟨Q, hQ, hQw⟩ ↦ ?_, fun ⟨Q, hQ, hQw⟩ ↦ ?_⟩
  · refine ⟨rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹) Q, ?_, ?_⟩
    · rw [aeval_rescale_inv_leadingCoeff, aeval_rescale_inv_leadingCoeff, hQ]
    · rwa [support_rescale fun i ↦ (hunit i).inv]
  · refine ⟨rescale (fun i ↦ m.leadingCoeff (b i)) Q, ?_, ?_⟩
    · rw [aeval_monicNormalize_rescale, hQ, aeval_rescale_inv_leadingCoeff]
    · rwa [support_rescale hunit]

end Family

end MonomialOrder
