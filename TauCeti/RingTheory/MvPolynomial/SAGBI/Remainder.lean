/-!
# Subduction with an irreducible remainder

Subduction by an arbitrary nonzero polynomial family produces both a polynomial expression
and a remainder. Every monomial of the remainder has exponent outside the additive monoid
generated by the family's leading exponents. Each product in the expression has leading
exponent bounded by that of the input. No SAGBI hypothesis or finiteness is needed.

A remainder of an element of the generated algebra still belongs to that algebra. If it is
nonzero, adjoining its monic normalization preserves the algebra and strictly enlarges the
algebra generated by leading terms. Thus a stopped subduction is a completion certificate,
not a certificate of nonmembership in the original algebra. For a SAGBI basis, every such
remainder of an element of the algebra vanishes. Over a field, adjoining the normalized
remainders `m.monicNormalize (r j)` of subductions of `aeval b (P j)` also extends the
presentation map with explicit retraction and presentation kernel
(`MonomialOrder.aeval_comp_aeval_sumElim_of_isSubduction`,
`MonomialOrder.ker_aeval_sumElim_monicNormalize`,
`MonomialOrder.ker_aeval_sumElim_monicNormalize_of_ne_zero`).

## References

* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, Chapter 11.
* D. Kapur, K. Madlener, *A completion procedure for computing a canonical basis for a
  k-subalgebra*, in *Computers and Mathematics*, Springer, 1989, 1–11.
-/

public section

namespace MonomialOrder

open MvPolynomial

variable {σ ι k : Type*}

section CommSemiring

variable [CommSemiring k]

/-- A subduction certificate records an expression, a remainder irreducible by products of
`b`, and bounds on both parts. It does not assert uniqueness of either part. -/
structure IsSubduction (m : MonomialOrder σ) (b : ι → MvPolynomial σ k)
    (f : MvPolynomial σ k) (Q : MvPolynomial ι k) (r : MvPolynomial σ k) : Prop where
  /-- The expression and remainder recover the input. -/
  eq_aeval_add : f = aeval b Q + r
  /-- Each product in the expression has bounded leading exponent. -/
  support_le : ∀ u ∈ Q.support,
    Finsupp.linearCombination ℕ (m.degree ∘ b) u ≼[m] m.degree f
  /-- No monomial in the remainder can be cancelled by a product of the generators. -/
  irreducible : ∀ a ∈ r.support, a ∉ AddSubmonoid.closure (Set.range (m.degree ∘ b))
  /-- The remainder has no larger leading exponent than the input. -/
  degree_le : m.degree r ≼[m] m.degree f

end CommSemiring

section CommRing

variable [CommRing k] {m : MonomialOrder σ}
  {b : ι → MvPolynomial σ k} {f r : MvPolynomial σ k} {Q : MvPolynomial ι k}

/-- Subduction preserves membership in every algebra containing the generators. In particular,
a nonzero remainder need not lie outside the algebra being subducted. -/
theorem IsSubduction.remainder_mem_iff (h : m.IsSubduction b f Q r)
    {A : Subalgebra k (MvPolynomial σ k)} (hbA : Set.range b ⊆ A) : r ∈ A ↔ f ∈ A := by
  have hQ : aeval b Q ∈ A := by
    apply (Algebra.adjoin_le hbA : Algebra.adjoin k (Set.range b) ≤ A)
    rw [← aeval_range]
    exact ⟨Q, rfl⟩
  rw [h.eq_aeval_add]
  exact ⟨A.add_mem hQ, fun hf ↦ by simpa using A.sub_mem hf hQ⟩

end CommRing

variable [Field k] {m : MonomialOrder σ}
  {b : ι → MvPolynomial σ k} {f r : MvPolynomial σ k} {Q : MvPolynomial ι k}

/-- If the leading exponent of `f` is generated by those of `b`, a product of the generators
has that exponent and a scalar multiple with the same leading coefficient as `f`. -/
theorem exists_smul_aeval_monomial_cancel (hb : ∀ i, b i ≠ 0)
    (hred : m.degree f ∈ AddSubmonoid.closure (Set.range (m.degree ∘ b))) :
    ∃ (u : ι →₀ ℕ) (c : k),
      m.degree (aeval b (monomial u (1 : k))) = m.degree f ∧
      (c • aeval b (monomial u (1 : k))).coeff (m.degree f) = m.leadingCoeff f := by
  obtain ⟨u, hu⟩ := AddSubmonoid.mem_closure_range_iff.1 hred
  have hdegree : m.degree (aeval b (monomial u (1 : k))) = m.degree f := by
    rw [m.degree_aeval_monomial_one_of_ne_zero hb]
    simpa [Finsupp.linearCombination_apply, Function.comp_def] using hu.symm
  refine ⟨u, m.leadingCoeff f / m.leadingCoeff (aeval b (monomial u (1 : k))), hdegree, ?_⟩
  rw [coeff_smul, ← hdegree, ← leadingCoeff, smul_eq_mul]
  exact div_mul_cancel₀ _ (m.leadingCoeff_ne_zero_iff.2 (aeval_monomial_one_ne_zero hb u))

/-- Over a field, every polynomial has a subduction certificate with respect to any family
of nonzero polynomials. No SAGBI hypothesis, monicity, or finiteness is assumed. -/
theorem exists_isSubduction (hb : ∀ i, b i ≠ 0) (f : MvPolynomial σ k) :
    ∃ Q r, m.IsSubduction b f Q r := by
  classical
  induction hd : m.toWithBotSyn (m.withBotDegree f) using WellFoundedLT.induction
    generalizing f with
  | ind d ih =>
  subst hd
  by_cases hf : f = 0
  · subst f
    exact ⟨0, 0, by constructor <;> simp⟩
  have recurse (q : MvPolynomial σ k) (hq : m.degree q ≼[m] m.degree f)
      (hc : q.coeff (m.degree f) = m.leadingCoeff f) :
      ∃ Q r, m.IsSubduction b (f - q) Q r := by
    have hbot : m.toWithBotSyn (m.withBotDegree q) ≤
        m.toWithBotSyn (m.withBotDegree f) := by
      rw [(m.withBotDegree_eq_coe_degree_iff f).2 hf, toWithBotSyn_apply_coe]
      exact (m.toWithBotSyn_withBotDegree_le_toSyn_degree q).trans (WithBot.coe_le_coe.2 hq)
    exact ih _ (m.withBotDegree_sub_lt hf hbot hc) _ rfl
  -- Cancel a reducible leading term, retaining its scalar coefficient in the expression.
  by_cases hred : m.degree f ∈ AddSubmonoid.closure (Set.range (m.degree ∘ b))
  · obtain ⟨u, c, hdegree, hc⟩ := m.exists_smul_aeval_monomial_cancel hb hred
    have hq : m.degree (c • aeval b (monomial u (1 : k))) ≼[m] m.degree f :=
      hdegree ▸ m.degree_smul_le
    obtain ⟨Q, r, h⟩ := recurse _ hq hc
    have hsub : m.degree (f - c • aeval b (monomial u (1 : k))) ≼[m] m.degree f :=
      m.degree_sub_le.trans (sup_le le_rfl hq)
    refine ⟨Q + c • monomial u 1, r, ?_⟩
    constructor
    · simpa only [map_add, map_smul] using (sub_eq_iff_eq_add.1 h.eq_aeval_add)
        |>.trans (by ring)
    · intro v hv
      rcases Finset.mem_union.1 (support_add hv) with hv | hv
      · exact (h.support_le v hv).trans hsub
      · have hvu : u = v := by simpa using support_smul hv
        subst v
        rw [← m.degree_aeval_monomial_one_of_ne_zero hb, hdegree]
    · exact h.irreducible
    · exact h.degree_le.trans hsub
  -- An irreducible leading term is transferred to the remainder instead.
  · obtain ⟨Q, r, h⟩ := recurse (m.leadingTerm f) (by simp) (by simp [leadingTerm])
    have hsub := m.degree_sub_leadingTerm_le f
    refine ⟨Q, r + m.leadingTerm f, ?_⟩
    constructor
    · exact (sub_eq_iff_eq_add.1 h.eq_aeval_add).trans (by ring)
    · exact fun u hu ↦ (h.support_le u hu).trans hsub
    · intro a ha
      rcases Finset.mem_union.1 (support_add ha) with ha | ha
      · exact h.irreducible a ha
      · have ha' : a = m.degree f := by simpa [m.support_leadingTerm' hf] using ha
        simpa [ha'] using hred
    · exact m.degree_add_le.trans (sup_le (h.degree_le.trans hsub) (by simp))

namespace IsSubduction

/-- A nonzero subduction remainder has leading term outside the algebra generated by the
leading terms of the current family. -/
theorem leadingTerm_notMem_adjoin_leadingTerm (h : m.IsSubduction b f Q r) (hr : r ≠ 0) :
    m.leadingTerm r ∉ Algebra.adjoin k (m.leadingTerm '' Set.range b) := by
  intro hmem
  have hdeg := m.leadingTerm_mem_adjoin_leadingTerm_iff.1 hmem
  apply h.irreducible _ (m.degree_mem_support hr)
  apply AddSubmonoid.closure_mono (s := m.degree '' (Set.range b \ {0})) _ hdeg
  rintro _ ⟨_, ⟨⟨i, rfl⟩, _⟩, rfl⟩
  exact Set.mem_range_self i

/-- If the family is SAGBI, every subduction remainder of an element of its algebra is zero. -/
theorem remainder_eq_zero (h : m.IsSubduction b f Q r)
    {A : Subalgebra k (MvPolynomial σ k)} (hB : m.IsSAGBIBasis (Set.range b) A)
    (hf : f ∈ A) : r = 0 := by
  by_contra hr
  apply h.leadingTerm_notMem_adjoin_leadingTerm hr
  rw [hB.adjoin_leadingTerm]
  exact leadingTerm_mem_initialAlgebra ((h.remainder_mem_iff hB.subset).2 hf)

/-- Adjoining the monic normalization of a nonzero remainder strictly enlarges the algebra
of leading terms. -/
theorem adjoin_leadingTerm_lt (h : m.IsSubduction b f Q r) (hr : r ≠ 0) :
    Algebra.adjoin k (m.leadingTerm '' Set.range b) <
      Algebra.adjoin k (m.leadingTerm '' insert (m.monicNormalize r) (Set.range b)) := by
  refine lt_of_le_not_ge (Algebra.adjoin_mono (Set.image_mono (Set.subset_insert _ _))) ?_
  intro hle
  apply h.leadingTerm_notMem_adjoin_leadingTerm hr
  have hnorm := hle (Algebra.subset_adjoin
    ⟨m.monicNormalize r, Set.mem_insert _ _, rfl⟩)
  rw [m.leadingTerm_monicNormalize_of_ne_zero hr] at hnorm
  exact (m.leadingTerm_mem_iff _ (m.leadingCoeff_ne_zero_iff.2 hr).isUnit).2 hnorm

/-- The normalized remainder has an explicit expression in the original generators whenever
the input does. The inverse leading coefficient is retained in the certificate. -/
theorem monicNormalize_eq_aeval (h : m.IsSubduction b f Q r)
    {P : MvPolynomial ι k} (hP : aeval b P = f) :
    m.monicNormalize r = aeval b (C (m.leadingCoeff r)⁻¹ * (P - Q)) := by
  have hr : r = aeval b P - aeval b Q := by
    rw [hP, h.eq_aeval_add]
    ring
  rw [map_mul, map_sub, aeval_C, algebraMap_eq, ← hr, monicNormalize_def]

/-- Adjoining a normalized remainder of an element of the generated algebra leaves that
algebra unchanged. -/
theorem adjoin_insert_monicNormalize (h : m.IsSubduction b f Q r)
    (hf : f ∈ Algebra.adjoin k (Set.range b)) :
    Algebra.adjoin k (insert (m.monicNormalize r) (Set.range b)) =
      Algebra.adjoin k (Set.range b) := by
  apply le_antisymm (Algebra.adjoin_le ?_)
    (Algebra.adjoin_mono (Set.subset_insert _ _))
  refine Set.insert_subset_iff.2 ⟨?_, Algebra.subset_adjoin⟩
  exact (m.monicNormalize_mem_iff).2 ((h.remainder_mem_iff Algebra.subset_adjoin).2 hf)

/-- Once `f` with `f = 0 ∨ m.degree f ≺ α` is subducted against `b` with certificate `Q` and
remainder `r`, any family `b'` whose range contains `Set.range b` (and `m.monicNormalize r` when
`r ≠ 0`) admits a polynomial `Q'` with `aeval b' Q' = f` all of whose exponents have
leading-exponent weight strictly below `α`. -/
theorem exists_aeval_eq_of_range_subset {κ : Type*} (h : m.IsSubduction b f Q r)
    {b' : κ → MvPolynomial σ k} (hb' : Set.range b ⊆ Set.range b')
    (hr' : r ≠ 0 → m.monicNormalize r ∈ Set.range b') {α : σ →₀ ℕ}
    (hf : f = 0 ∨ m.degree f ≺[m] α) :
    ∃ Q' : MvPolynomial κ k, aeval b' Q' = f ∧
      ∀ w ∈ Q'.support, Finsupp.linearCombination ℕ (fun j ↦ m.degree (b' j)) w ≺[m] α := by
  classical
  rcases hf with rfl | hfα
  · exact ⟨0, by simp, by simp⟩
  choose g hg using fun i ↦ hb' (Set.mem_range_self i)
  have hbg : b' ∘ g = b := funext hg
  have hQ₁_eval : aeval b' (rename g Q) = aeval b Q := by rw [aeval_rename, hbg]
  have hQ₁_lt (w' : κ →₀ ℕ) (hw' : w' ∈ (rename g Q).support) :
      Finsupp.linearCombination ℕ (fun j ↦ m.degree (b' j)) w' ≺[m] α := by
    obtain ⟨w, rfl, hw⟩ := coeff_rename_ne_zero g Q w' (mem_support_iff.1 hw')
    have hle : Finsupp.linearCombination ℕ (fun j ↦ m.degree (b' j)) (w.mapDomain g) ≼[m]
        m.degree f := by
      simpa [Finsupp.linearCombination_mapDomain, Function.comp_def, hg] using
        h.support_le w (mem_support_iff.2 hw)
    exact hle.trans_lt hfα
  rcases eq_or_ne r 0 with rfl | hr0
  · exact ⟨rename g Q, by rw [hQ₁_eval, h.eq_aeval_add, add_zero], hQ₁_lt⟩
  obtain ⟨j₀, hj₀⟩ := hr' hr0
  refine ⟨rename g Q + monomial (Finsupp.single j₀ 1) (m.leadingCoeff r), ?_, fun w' hw' ↦ ?_⟩
  · rw [map_add, hQ₁_eval, aeval_monomial, algebraMap_eq]
    simp [hj₀, C_leadingCoeff_mul_monicNormalize, ← h.eq_aeval_add]
  · rcases Finset.mem_union.1 (support_add hw') with hw' | hw'
    · exact hQ₁_lt w' hw'
    · rw [Finset.mem_singleton.1 (support_monomial_subset hw')]
      simp only [Finsupp.linearCombination_single, one_smul, hj₀, degree_monicNormalize]
      exact h.degree_le.trans_lt hfα

end IsSubduction

/-! ### Presentation maps under remainder adjunction -/

section PresentationTracking

variable {σ ι κ k : Type*} [Field k] {m : MonomialOrder σ}

/-- Adjoining the normalized remainders `m.monicNormalize (r j)` of subductions
`m.IsSubduction b (aeval b (P j)) (Q j) (r j)` induces an explicit `k`-algebra retraction
`MvPolynomial (κ ⊕ ι) k →ₐ[k] MvPolynomial ι k` compatible with `aeval`, sending each new variable
`X (inl j)` to `C (m.leadingCoeff (r j))⁻¹ * (P j - Q j)`. -/
theorem aeval_comp_aeval_sumElim_of_isSubduction {b : ι → MvPolynomial σ k}
    {P Q : κ → MvPolynomial ι k} {r : κ → MvPolynomial σ k}
    (hs : ∀ j, m.IsSubduction b (aeval b (P j)) (Q j) (r j)) :
    (aeval b).comp
        (aeval (Sum.elim (fun j ↦ C (m.leadingCoeff (r j))⁻¹ * (P j - Q j)) X)) =
      aeval (Sum.elim (fun j ↦ m.monicNormalize (r j)) b) := by
  refine algHom_ext fun x ↦ ?_
  cases x with
  | inl j => simp [((hs j).monicNormalize_eq_aeval rfl).symm]
  | inr i => simp

/-- **Presentation kernel after adjoining normalized subduction remainders.** If each
`aeval b (P j)` subducts against `b` with expression `Q j` and remainder `r j`, then the kernel of
the extended presentation map `aeval (Sum.elim (fun j ↦ m.monicNormalize (r j)) b)` is generated by
the image of `RingHom.ker (aeval b)` along `rename Sum.inr` together with the defining relations
`X (inl j) - rename Sum.inr (C (m.leadingCoeff (r j))⁻¹ * (P j - Q j))`. -/
theorem ker_aeval_sumElim_monicNormalize {b : ι → MvPolynomial σ k}
    {P Q : κ → MvPolynomial ι k} {r : κ → MvPolynomial σ k}
    (hs : ∀ j, m.IsSubduction b (aeval b (P j)) (Q j) (r j)) :
    RingHom.ker (aeval (Sum.elim (fun j ↦ m.monicNormalize (r j)) b)) =
      (RingHom.ker (aeval b)).map (rename Sum.inr) ⊔
        Ideal.span (Set.range fun j ↦
          X (Sum.inl j) - rename Sum.inr (C (m.leadingCoeff (r j))⁻¹ * (P j - Q j))) := by
  set ψ : MvPolynomial (κ ⊕ ι) k →ₐ[k] MvPolynomial σ k :=
    aeval (Sum.elim (fun j ↦ m.monicNormalize (r j)) b)
  have hcomp : ψ.comp (rename (R := k) (Sum.inr : ι → κ ⊕ ι)) = aeval b :=
    algHom_ext fun i ↦ by simp [ψ]
  have hker := MvPolynomial.ker_eq_map_ker_comp_rename_inr_sup (ψ := ψ)
    (fun j ↦ C (m.leadingCoeff (r j))⁻¹ * (P j - Q j)) fun j ↦ by
      rw [← AlgHom.comp_apply, hcomp, ← (hs j).monicNormalize_eq_aeval rfl]
      simp [ψ]
  simpa only [hcomp] using hker

/-- **Leading-coefficient-retained presentation kernel after adjoining nonzero remainders.** When
every remainder `r j` is nonzero, the defining relations in `ker_aeval_sumElim_monicNormalize` can
be written as `C (m.leadingCoeff (r j)) * X (inl j) - rename Sum.inr (P j - Q j)`, retaining the
leading coefficients without taking inverses. -/
theorem ker_aeval_sumElim_monicNormalize_of_ne_zero {b : ι → MvPolynomial σ k}
    {P Q : κ → MvPolynomial ι k} {r : κ → MvPolynomial σ k}
    (hs : ∀ j, m.IsSubduction b (aeval b (P j)) (Q j) (r j)) (hr : ∀ j, r j ≠ 0) :
    RingHom.ker (aeval (Sum.elim (fun j ↦ m.monicNormalize (r j)) b)) =
      (RingHom.ker (aeval b)).map (rename Sum.inr) ⊔
        Ideal.span (Set.range fun j ↦
          C (m.leadingCoeff (r j)) * X (Sum.inl j) - rename Sum.inr (P j - Q j)) := by
  rw [ker_aeval_sumElim_monicNormalize hs]
  congr 1
  have hrel (j : κ) :
      C (m.leadingCoeff (r j)) * X (Sum.inl j) - rename Sum.inr (P j - Q j) =
        C (m.leadingCoeff (r j)) *
          (X (Sum.inl j) - rename Sum.inr (C (m.leadingCoeff (r j))⁻¹ * (P j - Q j))) := by
    have hne : m.leadingCoeff (r j) ≠ 0 := m.leadingCoeff_ne_zero_iff.2 (hr j)
    rw [mul_sub, map_mul, rename_C, ← mul_assoc, ← C_mul, mul_inv_cancel₀ hne, C_1, one_mul]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ ⟨j, rfl⟩
    dsimp only
    have hinv :
        X (Sum.inl j) - rename Sum.inr (C (m.leadingCoeff (r j))⁻¹ * (P j - Q j)) =
          C (m.leadingCoeff (r j))⁻¹ *
            (C (m.leadingCoeff (r j)) * X (Sum.inl j) - rename Sum.inr (P j - Q j)) := by
      have hne : m.leadingCoeff (r j) ≠ 0 := m.leadingCoeff_ne_zero_iff.2 (hr j)
      rw [hrel j, ← mul_assoc, ← C_mul, inv_mul_cancel₀ hne, C_1, one_mul]
    rw [hinv]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
  · rintro _ ⟨j, rfl⟩
    dsimp only
    rw [hrel j]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)

/-- Adjoining the normalized subduction remainders `m.monicNormalize (r j)` resolves every tested
polynomial `aeval b (P j)` whose leading exponent was cancelled below `α j`: in the extended family
`Sum.elim (fun j ↦ m.monicNormalize (r j)) b`, each `aeval b (P j)` has a strict bounded expression
with exponent weights below `α j`. -/
theorem exists_aeval_sumElim_monicNormalize_eq {b : ι → MvPolynomial σ k}
    {P Q : κ → MvPolynomial ι k} {r : κ → MvPolynomial σ k}
    (hs : ∀ j, m.IsSubduction b (aeval b (P j)) (Q j) (r j)) {α : κ → σ →₀ ℕ}
    (hα : ∀ j, aeval b (P j) = 0 ∨ m.degree (aeval b (P j)) ≺[m] α j) (j : κ) :
    ∃ Q' : MvPolynomial (κ ⊕ ι) k,
      aeval (Sum.elim (fun l ↦ m.monicNormalize (r l)) b) Q' = aeval b (P j) ∧
      ∀ w ∈ Q'.support,
        Finsupp.linearCombination ℕ
          (fun x ↦ m.degree (Sum.elim (fun l ↦ m.monicNormalize (r l)) b x)) w ≺[m] α j :=
  (hs j).exists_aeval_eq_of_range_subset
    (fun _ ⟨i, hi⟩ ↦ ⟨Sum.inr i, hi⟩) (fun _ ↦ ⟨Sum.inl j, rfl⟩) (hα j)

end PresentationTracking

end MonomialOrder
