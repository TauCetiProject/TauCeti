module

public import TauCeti.RingTheory.MvPolynomial.Map
public import TauCeti.RingTheory.MvPolynomial.SAGBI.Basic

/-!
# Initial algebras and SAGBI bases under extension of the scalar field

Let `k` be a field, `K` a `k`-algebra, for instance a field extension of `k`, and let `A` be a
`k`-subalgebra of `MvPolynomial σ k`. Its *extension* to `K` is the `K`-subalgebra
`Algebra.adjoin K (map (algebraMap k K) '' A)` of `MvPolynomial σ K` generated by the images of the
elements of `A`; as a `K`-module it is spanned by these images. This file shows that extending the
scalars changes neither the leading exponents, nor the initial algebra, nor SAGBI bases.

The key observation is a coordinate argument from `TauCeti.RingTheory.MvPolynomial.Map`. A
`k`-linear form `ℓ : K → k` applied to every coefficient of a polynomial in the `K`-span of
`map (algebraMap k K) '' V`, for a `k`-subspace `V` of `MvPolynomial σ k`, gives an element of
`V` (`MvPolynomial.exists_mem_forall_coeff_eq_of_mem_span_image_map`). Choosing `ℓ` with
`ℓ 1 = 1` shows that the extension of `A` contracts back to `A`
(`MvPolynomial.map_mem_adjoin_image_map_iff`). Choosing `ℓ` nonzero on the leading coefficient of
a nonzero element `f` of the extension produces an element of `A` with the same leading exponent
as `f`. So, when `K` is nontrivial and has no zero divisors, the monoid of leading exponents of the
extension is that of `A` (`MonomialOrder.leadingExponents_adjoin_image_map`).

Consequently, over a field `K`, the initial algebra of the extension is the extension of the
initial algebra (`MonomialOrder.initialAlgebra_adjoin_image_map`), a set `B` is a SAGBI basis of
`A` if and only if its image is a SAGBI basis of the extension
(`MonomialOrder.isSAGBIBasis_image_map_iff`), and `A` has a finite SAGBI basis if and only if its
extension has one (`MonomialOrder.exists_finite_isSAGBIBasis_adjoin_image_map_iff`). In
particular, whether a family of polynomials over `k` is a SAGBI basis of the algebra it generates
may be checked over any extension field (`MonomialOrder.isSAGBIBasis_image_map_adjoin_iff`).

## References

* L. Robbiano, M. Sweedler, *Subalgebra bases*, in *Commutative Algebra (Salvador, 1988)*,
  Lecture Notes in Mathematics 1430, Springer, 1990, 61–87.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
-/

public section

open MvPolynomial

namespace MonomialOrder

variable {σ k K : Type*} (m : MonomialOrder σ) [Field k] {A : Subalgebra k (MvPolynomial σ k)}

section NoZeroDivisors

variable [CommRing K] [NoZeroDivisors K] [Nontrivial K] [Algebra k K]

/-- **Leading exponents under extension of scalars.** Extending the scalars of a subalgebra `A`
of `MvPolynomial σ k` to a nontrivial `k`-algebra `K` without zero divisors does not change its
monoid of leading exponents. -/
@[simp]
theorem leadingExponents_adjoin_image_map :
    m.leadingExponents (Algebra.adjoin K (map (algebraMap k K) '' ↑A)) =
      m.leadingExponents A := by
  refine le_antisymm (fun a ha ↦ ?_) fun a ha ↦ ?_
  · obtain ⟨f, hf, hf0, rfl⟩ := mem_leadingExponents_iff.1 ha
    rw [← Subalgebra.mem_toSubmodule, toSubmodule_adjoin_image_map] at hf
    -- A `k`-linear form not vanishing on the leading coefficient of `f`, applied to the
    -- coefficients of `f`, gives an element of `A` whose support lies in that of `f` and contains
    -- its leading exponent.
    obtain ⟨ℓ, hℓ⟩ :=
      Module.Projective.exists_dual_ne_zero k (m.leadingCoeff_ne_zero_iff.2 hf0)
    obtain ⟨g, hg, hgf⟩ := exists_mem_forall_coeff_eq_of_mem_span_image_map
      (V := Subalgebra.toSubmodule A) hf ℓ
    have hdeg : m.degree f ∈ g.support := by
      rwa [mem_support_iff, hgf]
    have hsupp : g.support ⊆ f.support := fun e he ↦ by
      rw [mem_support_iff, hgf] at he
      exact mem_support_iff.2 fun h ↦ he (by rw [h, map_zero])
    exact mem_leadingExponents_iff.2 ⟨g, hg, fun h ↦ by simp [h] at hdeg,
      m.degree_eq_of_support_subset hsupp hdeg⟩
  · obtain ⟨f, hf, hf0, rfl⟩ := mem_leadingExponents_iff.1 ha
    rw [← m.degree_map_of_injective (algebraMap k K).injective]
    exact degree_mem_leadingExponents (Algebra.subset_adjoin ⟨f, hf, rfl⟩)
      ((map_ne_zero_iff _ (map_injective _ (algebraMap k K).injective)).2 hf0)

end NoZeroDivisors

section Field

variable [Field K] [Algebra k K]

/-- **Initial algebras under extension of scalars.** The initial algebra of the extension of a
subalgebra `A` of `MvPolynomial σ k` to an extension field `K` is the extension of the initial
algebra of `A`. -/
theorem initialAlgebra_adjoin_image_map :
    m.initialAlgebra (Algebra.adjoin K (map (algebraMap k K) '' ↑A)) =
      Algebra.adjoin K (map (algebraMap k K) '' ↑(m.initialAlgebra A)) := by
  refine le_antisymm (fun p hp ↦ ?_) (Algebra.adjoin_le ?_)
  · rw [mem_initialAlgebra_iff, leadingExponents_adjoin_image_map] at hp
    rw [p.as_sum]
    refine Subalgebra.sum_mem _ fun e he ↦ ?_
    have hpe : monomial e (p.coeff e) = p.coeff e • map (algebraMap k K) (monomial e 1) := by
      simp [smul_monomial]
    rw [hpe]
    exact Subalgebra.smul_mem _
      (Algebra.subset_adjoin (Set.mem_image_of_mem _
        (monomial_mem_initialAlgebra_iff.2 (.inl (hp he))))) _
  · rintro _ ⟨q, hq, rfl⟩
    rw [SetLike.mem_coe, mem_initialAlgebra_iff, leadingExponents_adjoin_image_map,
      support_map_of_injective _ (algebraMap k K).injective]
    exact mem_initialAlgebra_iff.1 hq

/-- **SAGBI bases under extension of scalars.** A set `B` of polynomials over `k` is a SAGBI basis
of a subalgebra `A` if and only if its image is a SAGBI basis of the extension of `A` to an
extension field `K`. -/
theorem isSAGBIBasis_image_map_iff {B : Set (MvPolynomial σ k)} :
    m.IsSAGBIBasis (map (algebraMap k K) '' B)
        (Algebra.adjoin K (map (algebraMap k K) '' ↑A)) ↔ m.IsSAGBIBasis B A := by
  have hinj := map_injective (σ := σ) _ (algebraMap k K).injective
  have hdeg : m.degree '' (map (algebraMap k K) '' B \ {0}) = m.degree '' (B \ {0}) := by
    ext a
    simp [map_eq_zero_iff _ hinj, m.degree_map_of_injective (algebraMap k K).injective]
  rw [isSAGBIBasis_iff_degree_mem_closure, isSAGBIBasis_iff_degree_mem_closure,
    ← leadingExponents_le_iff, ← leadingExponents_le_iff, hdeg,
    leadingExponents_adjoin_image_map, Set.image_subset_iff]
  exact and_congr_left' ⟨fun h _ hb ↦ map_mem_adjoin_image_map_iff.1 (h hb),
    fun h _ hb ↦ map_mem_adjoin_image_map_iff.2 (h hb)⟩

/-- A family `B` of polynomials over `k` is a SAGBI basis of the `k`-algebra it generates if and
only if its image is a SAGBI basis of the `K`-algebra it generates, for an extension field `K`. -/
theorem isSAGBIBasis_image_map_adjoin_iff {B : Set (MvPolynomial σ k)} :
    m.IsSAGBIBasis (map (algebraMap k K) '' B) (Algebra.adjoin K (map (algebraMap k K) '' B)) ↔
      m.IsSAGBIBasis B (Algebra.adjoin k B) := by
  rw [← adjoin_image_map_adjoin, isSAGBIBasis_image_map_iff]

/-- A subalgebra of `MvPolynomial σ k` has a finite SAGBI basis if and only if its extension to an
extension field `K` has one. -/
theorem exists_finite_isSAGBIBasis_adjoin_image_map_iff :
    (∃ B : Set (MvPolynomial σ K), B.Finite ∧
        m.IsSAGBIBasis B (Algebra.adjoin K (map (algebraMap k K) '' ↑A))) ↔
      ∃ B : Set (MvPolynomial σ k), B.Finite ∧ m.IsSAGBIBasis B A := by
  rw [exists_finite_isSAGBIBasis_iff_fg, exists_finite_isSAGBIBasis_iff_fg,
    leadingExponents_adjoin_image_map]

end Field

end MonomialOrder
