module

public import TauCeti.RingTheory.MvPolynomial.Rescale
public import TauCeti.RingTheory.MvPolynomial.SAGBI.Presentation

/-!
# Monic normalization of SAGBI generators

Let `m` be a monomial order on `σ →₀ ℕ` and `k` a field. Dividing a polynomial `f` by its leading
coefficient gives `m.monicNormalize f = C (m.leadingCoeff f)⁻¹ * f`, which is monic with the same
leading exponent when `f ≠ 0` (`MonomialOrder.monic_monicNormalize`,
`MonomialOrder.degree_monicNormalize`), and satisfies
`f = C (m.leadingCoeff f) * m.monicNormalize f`
(`MonomialOrder.C_leadingCoeff_mul_monicNormalize`). Normalizing every member of a set `B` changes
neither the subalgebra generated by `B`, nor the subalgebra generated by the leading terms of `B`,
nor whether `B` is a SAGBI basis of a subalgebra. Arbitrary, possibly infinite, sets are allowed;
zero members stay zero and nonzero constants become `1`, of leading exponent `0`.

For an indexed family `b : ι → MvPolynomial σ k` with leading coefficients `ℓ i` and normalized
members `c i`, the presentation maps of `b` factor through those of `c` by the diagonal rescalings
`D_ℓ = MvPolynomial.rescale ℓ`, `Y i ↦ ℓ i * Y i`, and
`D_ℓ⁻¹ = MvPolynomial.rescale ℓ⁻¹`, `Y i ↦ (ℓ i)⁻¹ * Y i`:

* `aeval b = (aeval c).comp D_ℓ` and `aeval c = (aeval b).comp D_ℓ⁻¹`,
* `aeval (m.leadingTerm ∘ b) = (aeval fun i ↦ monomial (m.degree (b i)) 1).comp D_ℓ`.

The last coefficient-one map has the toric ideal of the leading exponents as its kernel. So when
every `b i` is nonzero, the relations among the actual generators, and among their actual leading
terms, are the images under `D_ℓ⁻¹` of the relations for the monic family and of the binomial toric
relations. This transport multiplies the coefficient of every monomial `Y^w` by
`∏ i, (ℓ i)⁻¹ ^ w i` (`MvPolynomial.coeff_rescale`), rather than substituting `b` into relations
computed for the coefficient-one leading terms, and transports the SAGBI criterion, standard
representations, and subalgebra presentations directly to nonzero families without clearing leading
coefficients.

## Main results

* `MonomialOrder.adjoin_image_monicNormalize` and
  `MonomialOrder.adjoin_image_leadingTerm_image_monicNormalize`: normalization preserves the
  generated subalgebra and the subalgebra generated by the leading terms.
* `MonomialOrder.isSAGBIBasis_image_monicNormalize_iff`: normalization preserves SAGBI bases.
* `MonomialOrder.aeval_monicNormalize_comp_rescale`,
  `MonomialOrder.aeval_comp_rescale_inv_leadingCoeff`, and
  `MonomialOrder.aeval_monomial_degree_comp_rescale`: the factorizations through `D_ℓ` and `D_ℓ⁻¹`.
* `MonomialOrder.exists_aeval_eq_aeval_rescale_iff`: bounded zero-subduction certificates for `b` on
  `D_ℓ⁻¹ P` correspond via `D_ℓ` and `D_ℓ⁻¹` to bounded zero-subduction certificates for `c` on `P`.
* `MonomialOrder.ker_aeval_leadingTerm`: over any commutative semiring, the relations among the
  leading terms are the preimage under `D_ℓ` of the toric ideal of the leading exponents.
* `MonomialOrder.ker_aeval_leadingTerm_eq_map`, `MonomialOrder.ker_aeval_eq_map` and
  `MonomialOrder.ker_aeval_eq_span_image`: for nonzero members over a field, these relation ideals
  and their generators are transported by `D_ℓ⁻¹`.
* `MonomialOrder.isSAGBIBasis_range_iff_forall_exists_aeval_rescale`: the SAGBI criterion for a
  family of nonzero polynomials, tested on the rescaled toric binomials `D_ℓ⁻¹ (Y^(u j) - Y^(v j))`.
* `MonomialOrder.exists_finsupp_sum_eq_of_aeval_eq_zero_of_ne_zero`,
  `MonomialOrder.ker_aeval_eq_span_of_ne_zero`, and
  `MonomialOrder.IsSAGBIBasis.exists_ker_aeval_eq_span_of_ne_zero`: standard representations and
  lifted presentations for families of nonzero polynomials.

## References

* W. Bruns, A. Conca, M. Lembo, *SAGBI combinatorics of maximal minors and a SAGBI algorithm*,
  2025, arXiv:2504.10019, Section 2.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
-/

public section

namespace MonomialOrder

open MvPolynomial

variable {σ ι : Type*} (m : MonomialOrder σ)

section Normalization

variable {k : Type*} [Field k] {m}

/-- Normalizing the members of `B` does not change the subalgebra they generate. -/
@[simp]
theorem adjoin_image_monicNormalize (B : Set (MvPolynomial σ k)) :
    Algebra.adjoin k (m.monicNormalize '' B) = Algebra.adjoin k B := by
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le fun f hf ↦ ?_)
  · rintro _ ⟨f, hf, rfl⟩
    exact monicNormalize_mem_iff.2 (Algebra.subset_adjoin hf)
  · exact monicNormalize_mem_iff.1 (Algebra.subset_adjoin ⟨f, hf, rfl⟩)

/-- Normalizing the members of `B` does not change the subalgebra generated by their leading
terms. -/
@[simp]
theorem adjoin_image_leadingTerm_image_monicNormalize (B : Set (MvPolynomial σ k)) :
    Algebra.adjoin k (m.leadingTerm '' (m.monicNormalize '' B)) =
      Algebra.adjoin k (m.leadingTerm '' B) := by
  rw [Set.image_image, funext leadingTerm_monicNormalize, ← Set.image_image,
    adjoin_image_monicNormalize]

/-- Normalizing the members of `B` does not change whether `B` is a SAGBI basis of `A`. -/
@[simp]
theorem isSAGBIBasis_image_monicNormalize_iff {B : Set (MvPolynomial σ k)}
    {A : Subalgebra k (MvPolynomial σ k)} :
    m.IsSAGBIBasis (m.monicNormalize '' B) A ↔ m.IsSAGBIBasis B A := by
  simp [isSAGBIBasis_iff, Set.subset_def]

end Normalization

section Presentation

variable {R : Type*} [CommSemiring R] (b : ι → MvPolynomial σ R)

/-- The map `Y i ↦ m.leadingTerm (b i)` factors through the coefficient-one map
`Y i ↦ X ^ (m.degree (b i))` by the rescaling `Y i ↦ m.leadingCoeff (b i) * Y i`. -/
theorem aeval_monomial_degree_comp_rescale :
    (aeval fun i ↦ monomial (m.degree (b i)) (1 : R)).comp
        (rescale fun i ↦ m.leadingCoeff (b i)) =
      aeval fun i ↦ m.leadingTerm (b i) :=
  algHom_ext fun i ↦ by simp

/-- The relations among the leading terms of `b` are the preimages under the rescaling
`Y i ↦ m.leadingCoeff (b i) * Y i` of the toric ideal of the leading exponents. -/
theorem ker_aeval_leadingTerm :
    RingHom.ker (aeval fun i ↦ m.leadingTerm (b i)) =
      (TauCeti.toricIdeal R fun i ↦ m.degree (b i)).comap
        (rescale fun i ↦ m.leadingCoeff (b i)) := by
  rw [← aeval_monomial_degree_comp_rescale, ← AlgHom.comap_ker,
    TauCeti.toricIdeal_eq_ker_aeval_monomial]

end Presentation

section Field

variable {k : Type*} [Field k] (b : ι → MvPolynomial σ k)

/-- The presentation map `Y i ↦ b i` factors through the presentation map of the normalized
family by the rescaling `Y i ↦ m.leadingCoeff (b i) * Y i`. -/
theorem aeval_monicNormalize_comp_rescale :
    (aeval fun i ↦ m.monicNormalize (b i)).comp (rescale fun i ↦ m.leadingCoeff (b i)) =
      aeval b :=
  algHom_ext fun i ↦ by simp

/-- Evaluating the normalized family on `P` rescaled by `m.leadingCoeff (b i)` recovers `aeval b P`.
-/
theorem aeval_monicNormalize_rescale (P : MvPolynomial ι k) :
    aeval (fun i ↦ m.monicNormalize (b i)) (rescale (fun i ↦ m.leadingCoeff (b i)) P) =
      aeval b P :=
  AlgHom.congr_fun (m.aeval_monicNormalize_comp_rescale b) P

/-- The presentation map of the normalized family factors through `aeval b` by the inverse
rescaling `Y i ↦ (m.leadingCoeff (b i))⁻¹ * Y i`. Zero members map to `0` on both sides. -/
theorem aeval_comp_rescale_inv_leadingCoeff :
    (aeval b).comp (rescale fun i ↦ (m.leadingCoeff (b i))⁻¹) =
      aeval fun i ↦ m.monicNormalize (b i) :=
  algHom_ext fun i ↦ by simp [monicNormalize_def]

/-- Evaluating `b` on `P` rescaled by `(m.leadingCoeff (b i))⁻¹` equals evaluating the normalized
family on `P`. -/
theorem aeval_rescale_inv_leadingCoeff (P : MvPolynomial ι k) :
    aeval b (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹) P) =
      aeval (fun i ↦ m.monicNormalize (b i)) P :=
  AlgHom.congr_fun (m.aeval_comp_rescale_inv_leadingCoeff b) P

/-- Bounded zero-subduction certificates for `b` on `P` rescaled by `(m.leadingCoeff (b i))⁻¹`
correspond via diagonal rescaling to bounded zero-subduction certificates for the normalized
family on `P`. No nonvanishing hypothesis on `b` is needed. -/
theorem exists_aeval_eq_aeval_rescale_iff {m : MonomialOrder σ} (P : MvPolynomial ι k)
    (α : σ →₀ ℕ) :
    (∃ Q : MvPolynomial ι k,
      aeval b Q = aeval b (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹) P) ∧
      ∀ w ∈ Q.support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) w ≺[m] α) ↔
    ∃ Q' : MvPolynomial ι k,
      aeval (fun i ↦ m.monicNormalize (b i)) Q' =
        aeval (fun i ↦ m.monicNormalize (b i)) P ∧
      ∀ w ∈ Q'.support,
        Finsupp.linearCombination ℕ (fun i ↦ m.degree (m.monicNormalize (b i))) w ≺[m] α := by
  simp only [degree_monicNormalize]
  refine ⟨fun ⟨Q, hQb, hQ⟩ ↦ ⟨rescale (fun i ↦ m.leadingCoeff (b i)) Q, ?_, fun w hw ↦
    hQ w (support_rescale_subset _ _ hw)⟩,
    fun ⟨Q', hQc, hQ'⟩ ↦ ⟨rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹) Q', ?_, fun w hw ↦
      hQ' w (support_rescale_subset _ _ hw)⟩⟩
  · rw [m.aeval_monicNormalize_rescale b Q, hQb, m.aeval_rescale_inv_leadingCoeff b P]
  · rw [m.aeval_rescale_inv_leadingCoeff b Q', hQc, ← m.aeval_rescale_inv_leadingCoeff b P]

variable {b} (hb : ∀ i, b i ≠ 0)
include hb

/-- For a family of nonzero polynomials, the relations among their leading terms are the images
of the toric ideal of the leading exponents under the rescaling
`Y i ↦ (m.leadingCoeff (b i))⁻¹ * Y i`. -/
theorem ker_aeval_leadingTerm_eq_map :
    RingHom.ker (aeval fun i ↦ m.leadingTerm (b i)) =
      (TauCeti.toricIdeal k fun i ↦ m.degree (b i)).map
        (rescale fun i ↦ (m.leadingCoeff (b i))⁻¹) := by
  rw [ker_aeval_leadingTerm, comap_rescale fun i ↦
    mul_inv_cancel₀ (m.leadingCoeff_ne_zero_iff.2 (hb i))]

/-- For a family of nonzero polynomials, the relations among the `b i` are the images of the
relations among their normalizations under the rescaling
`Y i ↦ (m.leadingCoeff (b i))⁻¹ * Y i`. -/
theorem ker_aeval_eq_map :
    RingHom.ker (aeval b) =
      (RingHom.ker (aeval fun i ↦ m.monicNormalize (b i))).map
        (rescale fun i ↦ (m.leadingCoeff (b i))⁻¹) := by
  rw [← aeval_monicNormalize_comp_rescale m b, ← AlgHom.comap_ker, comap_rescale fun i ↦
    mul_inv_cancel₀ (m.leadingCoeff_ne_zero_iff.2 (hb i))]

/-- If the polynomials `F` generate the relations among the normalizations of a family of nonzero
polynomials `b`, then their rescalings by `Y i ↦ (m.leadingCoeff (b i))⁻¹ * Y i` generate the
relations among the `b i`. -/
theorem ker_aeval_eq_span_image {F : Set (MvPolynomial ι k)}
    (hF : RingHom.ker (aeval fun i ↦ m.monicNormalize (b i)) = Ideal.span F) :
    RingHom.ker (aeval b) =
      Ideal.span ((rescale fun i ↦ (m.leadingCoeff (b i))⁻¹) '' F) := by
  rw [ker_aeval_eq_map m hb, hF, Ideal.map_span]

end Field

section CriterionAndPresentation

variable {k J : Type*} [Field k] {m} {b : ι → MvPolynomial σ k} (hb : ∀ i, b i ≠ 0)
include hb

/-- **The SAGBI criterion for nonzero families.** Let `b` be a family of nonzero polynomials over a
field, write `A w = ∑ i, w i • m.degree (b i)`, and let binomials `Y^(u j) - Y^(v j)` generate the
toric ideal of the leading exponents of `b`. Then `b` is a SAGBI basis of the subalgebra it
generates if and only if, for every `j`, the evaluation of the inverse-leading-coefficient rescaled
binomial `rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹) (Y^(u j) - Y^(v j))` at `b` is the evaluation
of a polynomial in `b` all of whose exponents `w` satisfy `A w ≺ A (u j)`. -/
theorem isSAGBIBasis_range_iff_forall_exists_aeval_rescale {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal k (fun i ↦ m.degree (b i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1)) :
    m.IsSAGBIBasis (Set.range b) (Algebra.adjoin k (Set.range b)) ↔
      ∀ j, ∃ Q : MvPolynomial ι k,
        aeval b Q = aeval b (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹)
          (monomial (u j) (1 : k) - monomial (v j) 1)) ∧
        ∀ w ∈ Q.support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) w ≺[m]
          Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) (u j) := by
  have hrange : Set.range (fun i ↦ m.monicNormalize (b i)) = m.monicNormalize '' Set.range b :=
    Set.range_comp m.monicNormalize b
  have hJ' : TauCeti.toricIdeal k (fun i ↦ m.degree (m.monicNormalize (b i))) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1) := by
    simpa only [degree_monicNormalize] using hJ
  rw [← isSAGBIBasis_image_monicNormalize_iff (m := m), ← adjoin_image_monicNormalize (m := m),
    ← hrange, isSAGBIBasis_range_iff_forall_exists_aeval_eq
      (fun i ↦ m.monic_monicNormalize (hb i)) hJ']
  refine forall_congr' fun j ↦ ?_
  simpa only [degree_monicNormalize] using
    (exists_aeval_eq_aeval_rescale_iff b (monomial (u j) (1 : k) - monomial (v j) 1)
      (Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) (u j))).symm

/-- **Standard representations for nonzero families.** Let `b` be a family of nonzero polynomials
over a field, write `A w = ∑ i, w i • m.degree (b i)`, let binomials `Y^(u j) - Y^(v j)` generate
the toric ideal of the leading exponents of `b`, and let `Q j` be bounded zero subductions in `b`
of the rescaled binomials `D_ℓ⁻¹ (Y^(u j) - Y^(v j))`, where `ℓ i = m.leadingCoeff (b i)`. If
`aeval b P = 0` and every exponent `w` of `P` satisfies `A w ≼ δ`, then `P` has a representation
`P = ∑ j, g j * (D_ℓ⁻¹ (Y^(u j) - Y^(v j)) - Q j)` in which every exponent `x` of `g j` satisfies
`A x + A (u j) ≼ δ`. -/
theorem exists_finsupp_sum_eq_of_aeval_eq_zero_of_ne_zero {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal k (fun i ↦ m.degree (b i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1))
    {Q : J → MvPolynomial ι k}
    (hQb : ∀ j, aeval b (Q j) = aeval b (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹)
      (monomial (u j) (1 : k) - monomial (v j) 1)))
    (hQ : ∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) w ≺[m]
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) (u j))
    {P : MvPolynomial ι k} (hP : aeval b P = 0) {δ : σ →₀ ℕ}
    (hPδ : ∀ w ∈ P.support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) w ≼[m] δ) :
    ∃ g : J →₀ MvPolynomial ι k,
      (g.sum fun j q ↦ q *
        (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹)
          (monomial (u j) (1 : k) - monomial (v j) 1) - Q j)) = P ∧
      ∀ j, ∀ x ∈ (g j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) x +
        Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) (u j) ≼[m] δ := by
  set c := fun i ↦ m.monicNormalize (b i)
  set ℓ := fun i ↦ m.leadingCoeff (b i)
  set ℓ_inv := fun i ↦ (m.leadingCoeff (b i))⁻¹
  have hℓ (i : ι) : ℓ i * ℓ_inv i = 1 := mul_inv_cancel₀ (m.leadingCoeff_ne_zero_iff.2 (hb i))
  have hc (i : ι) : m.Monic (c i) := m.monic_monicNormalize (hb i)
  have hJ' : TauCeti.toricIdeal k (fun i ↦ m.degree (c i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1) := by
    simpa only [c, degree_monicNormalize] using hJ
  have hQc' (j : J) : aeval c (rescale ℓ (Q j)) =
      aeval c (monomial (u j) (1 : k) - monomial (v j) 1) := by
    rw [m.aeval_monicNormalize_rescale b (Q j), hQb j, m.aeval_rescale_inv_leadingCoeff b]
  have hQ' (j : J) (w : ι →₀ ℕ) (hw : w ∈ (rescale ℓ (Q j)).support) :
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≺[m]
        Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j) := by
    simpa only [c, degree_monicNormalize] using hQ j w (support_rescale_subset ℓ (Q j) hw)
  have hP' : aeval c (rescale ℓ P) = 0 := by
    rw [m.aeval_monicNormalize_rescale b P, hP]
  have hP'δ (w : ι →₀ ℕ) (hw : w ∈ (rescale ℓ P).support) :
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≼[m] δ := by
    simpa only [c, degree_monicNormalize] using hPδ w (support_rescale_subset ℓ P hw)
  obtain ⟨g', hg', hg'δ⟩ := exists_finsupp_sum_eq_of_aeval_eq_zero hc hJ' hQc' hQ' hP' hP'δ
  refine ⟨g'.mapRange (rescale ℓ_inv) (map_zero _), ?_, fun j x hx ↦ ?_⟩
  · have hsum := congrArg (rescale ℓ_inv) hg'
    rw [rescale_rescale_of_mul_eq_one hℓ P, map_finsuppSum] at hsum
    rw [Finsupp.sum_mapRange_index fun _ ↦ zero_mul _]
    refine (Finsupp.sum_congr fun j _ ↦ ?_).trans hsum
    simp only [map_mul, map_sub, rescale_rescale_of_mul_eq_one hℓ]
  · simpa only [c, degree_monicNormalize] using
      hg'δ j x (support_rescale_subset ℓ_inv (g' j) hx)

/-- **The presentation of `k[b]` for a nonzero family.** Let `b` be a family of nonzero polynomials
over a field, write `A w = ∑ i, w i • m.degree (b i)`, and let binomials `Y^(u j) - Y^(v j)`
generate the toric ideal of the leading exponents of `b`. If each rescaled binomial
`D_ℓ⁻¹ (Y^(u j) - Y^(v j))` evaluates under `aeval b` to `aeval b (Q j)` for a polynomial `Q j` all
of whose exponents `w` satisfy `A w ≺ A (u j)`, then the lifted relations
`D_ℓ⁻¹ (Y^(u j) - Y^(v j)) - Q j` generate the kernel of `aeval b`. -/
theorem ker_aeval_eq_span_of_ne_zero {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal k (fun i ↦ m.degree (b i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1))
    {Q : J → MvPolynomial ι k}
    (hQb : ∀ j, aeval b (Q j) = aeval b (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹)
      (monomial (u j) (1 : k) - monomial (v j) 1)))
    (hQ : ∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) w ≺[m]
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) (u j)) :
    RingHom.ker (aeval b) =
      Ideal.span (Set.range fun j ↦
        rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹)
          (monomial (u j) (1 : k) - monomial (v j) 1) - Q j) := by
  set ℓ := fun i ↦ m.leadingCoeff (b i)
  set ℓ_inv := fun i ↦ (m.leadingCoeff (b i))⁻¹
  have hℓ (i : ι) : ℓ i * ℓ_inv i = 1 := mul_inv_cancel₀ (m.leadingCoeff_ne_zero_iff.2 (hb i))
  have hJ' : TauCeti.toricIdeal k (fun i ↦ m.degree (m.monicNormalize (b i))) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1) := by
    simpa only [degree_monicNormalize] using hJ
  have hQc' (j : J) : aeval (fun i ↦ m.monicNormalize (b i)) (rescale ℓ (Q j)) =
      aeval (fun i ↦ m.monicNormalize (b i)) (monomial (u j) (1 : k) - monomial (v j) 1) := by
    rw [m.aeval_monicNormalize_rescale b (Q j), hQb j, m.aeval_rescale_inv_leadingCoeff b]
  have hQ' (j : J) (w : ι →₀ ℕ) (hw : w ∈ (rescale ℓ (Q j)).support) :
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (m.monicNormalize (b i))) w ≺[m]
        Finsupp.linearCombination ℕ (fun i ↦ m.degree (m.monicNormalize (b i))) (u j) := by
    simpa only [degree_monicNormalize] using hQ j w (support_rescale_subset ℓ (Q j) hw)
  rw [ker_aeval_eq_span_image m hb (ker_aeval_eq_span
      (fun i ↦ m.monic_monicNormalize (hb i)) hJ' hQc' hQ'), ← Set.range_comp]
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext j
  simp only [Function.comp_apply, map_sub, ℓ_inv, rescale_rescale_of_mul_eq_one hℓ]

/-- **The presentation of a nonzero SAGBI family.** Let `b` be a family of nonzero polynomials over
a field which is a SAGBI basis of the subalgebra it generates, write
`A w = ∑ i, w i • m.degree (b i)`, and let binomials `Y^(u j) - Y^(v j)` generate the toric ideal of
the leading exponents of `b`. Then each rescaled binomial `D_ℓ⁻¹ (Y^(u j) - Y^(v j))` has a bounded
zero subduction `Q j` in `b`, and the lifted relations `D_ℓ⁻¹ (Y^(u j) - Y^(v j)) - Q j` generate
the kernel of `aeval b`. -/
theorem IsSAGBIBasis.exists_ker_aeval_eq_span_of_ne_zero
    (h : m.IsSAGBIBasis (Set.range b) (Algebra.adjoin k (Set.range b)))
    {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal k (fun i ↦ m.degree (b i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1)) :
    ∃ Q : J → MvPolynomial ι k,
      (∀ j, aeval b (Q j) = aeval b (rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹)
        (monomial (u j) (1 : k) - monomial (v j) 1))) ∧
      (∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) w ≺[m]
        Finsupp.linearCombination ℕ (fun i ↦ m.degree (b i)) (u j)) ∧
      RingHom.ker (aeval b) =
        Ideal.span (Set.range fun j ↦
          rescale (fun i ↦ (m.leadingCoeff (b i))⁻¹)
            (monomial (u j) (1 : k) - monomial (v j) 1) - Q j) := by
  choose Q hQb hQ using (isSAGBIBasis_range_iff_forall_exists_aeval_rescale hb hJ).1 h
  exact ⟨Q, hQb, hQ, ker_aeval_eq_span_of_ne_zero hb hJ hQb hQ⟩

end CriterionAndPresentation

