module

public import TauCeti.RingTheory.MvPolynomial.Rescale
public import TauCeti.RingTheory.MvPolynomial.SAGBI.Basic
public import TauCeti.RingTheory.MvPolynomial.ToricIdeal.Basic

/-!
# Monic normalization of SAGBI generators

Let `m` be a monomial order on `σ →₀ ℕ` and `k` a field. Dividing a polynomial `f` by its leading
coefficient gives `m.monicNormalize f = C (m.leadingCoeff f)⁻¹ * f`, which is monic with the same
leading exponent when `f ≠ 0` (`MonomialOrder.monic_monicNormalize`,
`MonomialOrder.degree_monicNormalize`), and satisfies
`f = C (m.leadingCoeff f) * m.monicNormalize f`
(`MonomialOrder.C_leadingCoeff_mul_monicNormalize`). Normalizing every member of a set `B` changes
neither the subalgebra generated by `B`, nor the subalgebra generated by the leading terms of `B`,
nor whether `B` is a SAGBI basis of a subalgebra. Arbitrary, possibly infinite, sets are allowed;
zero members stay zero and nonzero constants become `1`, of leading exponent `0`.

For an indexed family `b : ι → MvPolynomial σ k` with leading coefficients `ℓ i` and normalized
members `c i`, the presentation maps of `b` factor through those of `c` by the diagonal rescaling
`D_ℓ = MvPolynomial.rescale ℓ`, `Y i ↦ ℓ i * Y i`:

* `aeval b = (aeval c).comp D_ℓ`, and
* `aeval (m.leadingTerm ∘ b) = (aeval fun i ↦ monomial (m.degree (b i)) 1).comp D_ℓ`.

The last coefficient-one map has the toric ideal of the leading exponents as its kernel. So when
every `b i` is nonzero, the relations among the actual generators, and among their actual leading
terms, are the images under `D_ℓ⁻¹ = MvPolynomial.rescale ℓ⁻¹` of the relations for the monic
family and of the binomial toric relations. This transport multiplies the coefficient of every
monomial `Y^w` by `∏ i, (ℓ i)⁻¹ ^ w i` (`MvPolynomial.coeff_rescale`), rather than substituting `b`
into relations computed for the coefficient-one leading terms.

## Main results

* `MonomialOrder.adjoin_image_monicNormalize` and
  `MonomialOrder.adjoin_image_leadingTerm_image_monicNormalize`: normalization preserves the
  generated subalgebra and the subalgebra generated by the leading terms.
* `MonomialOrder.isSAGBIBasis_image_monicNormalize_iff`: normalization preserves SAGBI bases.
* `MonomialOrder.aeval_monicNormalize_comp_rescale` and
  `MonomialOrder.aeval_monomial_degree_comp_rescale`: the factorizations through `D_ℓ`.
* `MonomialOrder.ker_aeval_leadingTerm`: over any commutative semiring, the relations among the
  leading terms are the preimage under `D_ℓ` of the toric ideal of the leading exponents.
* `MonomialOrder.ker_aeval_leadingTerm_eq_map`, `MonomialOrder.ker_aeval_eq_map` and
  `MonomialOrder.ker_aeval_eq_span_image`: for nonzero members over a field, these relation ideals
  and their generators are transported by `D_ℓ⁻¹`.

## References

* W. Bruns, A. Conca, M. Lembo, *SAGBI combinatorics of maximal minors and a SAGBI algorithm*,
  2025, arXiv:2504.10019, Section 2.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
-/

public section

namespace MonomialOrder

open MvPolynomial

variable {σ ι : Type*} (m : MonomialOrder σ)

section Normalization

variable {k : Type*} [Field k] {m}

/-- Normalizing the members of `B` does not change the subalgebra they generate. -/
@[simp]
theorem adjoin_image_monicNormalize (B : Set (MvPolynomial σ k)) :
    Algebra.adjoin k (m.monicNormalize '' B) = Algebra.adjoin k B := by
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le fun f hf ↦ ?_)
  · rintro _ ⟨f, hf, rfl⟩
    exact monicNormalize_mem_iff.2 (Algebra.subset_adjoin hf)
  · exact monicNormalize_mem_iff.1 (Algebra.subset_adjoin ⟨f, hf, rfl⟩)

/-- Normalizing the members of `B` does not change the subalgebra generated by their leading
terms. -/
@[simp]
theorem adjoin_image_leadingTerm_image_monicNormalize (B : Set (MvPolynomial σ k)) :
    Algebra.adjoin k (m.leadingTerm '' (m.monicNormalize '' B)) =
      Algebra.adjoin k (m.leadingTerm '' B) := by
  rw [Set.image_image, funext leadingTerm_monicNormalize, ← Set.image_image,
    adjoin_image_monicNormalize]

/-- Normalizing the members of `B` does not change whether `B` is a SAGBI basis of `A`. -/
@[simp]
theorem isSAGBIBasis_image_monicNormalize_iff {B : Set (MvPolynomial σ k)}
    {A : Subalgebra k (MvPolynomial σ k)} :
    m.IsSAGBIBasis (m.monicNormalize '' B) A ↔ m.IsSAGBIBasis B A := by
  simp [isSAGBIBasis_iff, Set.subset_def]

end Normalization

section Presentation

variable {R : Type*} [CommSemiring R] (b : ι → MvPolynomial σ R)

/-- The map `Y i ↦ m.leadingTerm (b i)` factors through the coefficient-one map
`Y i ↦ X ^ (m.degree (b i))` by the rescaling `Y i ↦ m.leadingCoeff (b i) * Y i`. -/
theorem aeval_monomial_degree_comp_rescale :
    (aeval fun i ↦ monomial (m.degree (b i)) (1 : R)).comp
        (rescale fun i ↦ m.leadingCoeff (b i)) =
      aeval fun i ↦ m.leadingTerm (b i) :=
  algHom_ext fun i ↦ by simp

/-- The relations among the leading terms of `b` are the preimages under the rescaling
`Y i ↦ m.leadingCoeff (b i) * Y i` of the toric ideal of the leading exponents. -/
theorem ker_aeval_leadingTerm :
    RingHom.ker (aeval fun i ↦ m.leadingTerm (b i)) =
      (TauCeti.toricIdeal R fun i ↦ m.degree (b i)).comap
        (rescale fun i ↦ m.leadingCoeff (b i)) := by
  rw [← aeval_monomial_degree_comp_rescale, ← AlgHom.comap_ker,
    TauCeti.toricIdeal_eq_ker_aeval_monomial]

end Presentation

section Field

variable {k : Type*} [Field k] (b : ι → MvPolynomial σ k)

/-- The presentation map `Y i ↦ b i` factors through the presentation map of the normalized
family by the rescaling `Y i ↦ m.leadingCoeff (b i) * Y i`. -/
theorem aeval_monicNormalize_comp_rescale :
    (aeval fun i ↦ m.monicNormalize (b i)).comp (rescale fun i ↦ m.leadingCoeff (b i)) =
      aeval b :=
  algHom_ext fun i ↦ by simp

variable {b} (hb : ∀ i, b i ≠ 0)
include hb

/-- For a family of nonzero polynomials, the relations among their leading terms are the images
of the toric ideal of the leading exponents under the rescaling
`Y i ↦ (m.leadingCoeff (b i))⁻¹ * Y i`. -/
theorem ker_aeval_leadingTerm_eq_map :
    RingHom.ker (aeval fun i ↦ m.leadingTerm (b i)) =
      (TauCeti.toricIdeal k fun i ↦ m.degree (b i)).map
        (rescale fun i ↦ (m.leadingCoeff (b i))⁻¹) := by
  rw [ker_aeval_leadingTerm, comap_rescale fun i ↦
    mul_inv_cancel₀ (m.leadingCoeff_ne_zero_iff.2 (hb i))]

/-- For a family of nonzero polynomials, the relations among the `b i` are the images of the
relations among their normalizations under the rescaling
`Y i ↦ (m.leadingCoeff (b i))⁻¹ * Y i`. -/
theorem ker_aeval_eq_map :
    RingHom.ker (aeval b) =
      (RingHom.ker (aeval fun i ↦ m.monicNormalize (b i))).map
        (rescale fun i ↦ (m.leadingCoeff (b i))⁻¹) := by
  rw [← aeval_monicNormalize_comp_rescale m b, ← AlgHom.comap_ker, comap_rescale fun i ↦
    mul_inv_cancel₀ (m.leadingCoeff_ne_zero_iff.2 (hb i))]

/-- If the polynomials `F` generate the relations among the normalizations of a family of nonzero
polynomials `b`, then their rescalings by `Y i ↦ (m.leadingCoeff (b i))⁻¹ * Y i` generate the
relations among the `b i`. -/
theorem ker_aeval_eq_span_image {F : Set (MvPolynomial ι k)}
    (hF : RingHom.ker (aeval fun i ↦ m.monicNormalize (b i)) = Ideal.span F) :
    RingHom.ker (aeval b) =
      Ideal.span ((rescale fun i ↦ (m.leadingCoeff (b i))⁻¹) '' F) := by
  rw [ker_aeval_eq_map m hb, hF, Ideal.map_span]

end Field

end MonomialOrder
