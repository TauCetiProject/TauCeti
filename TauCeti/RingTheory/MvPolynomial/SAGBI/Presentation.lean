module

public import TauCeti.RingTheory.MvPolynomial.SAGBI.Criterion

/-!
# The presentation of the subalgebra generated by a monic family

Let `m` be a monomial order on `σ →₀ ℕ` and let `c : ι → MvPolynomial σ R` be a family of monic
polynomials over a nontrivial commutative ring, with leading exponents `a i = m.degree (c i)`. Write
`A w = ∑ i, w i • a i` (`Finsupp.linearCombination ℕ a w`) and `φ = aeval c` for the substitution
`Y i ↦ c i`. Let binomials `β j = Y^(u j) - Y^(v j)` generate the toric ideal of the `a i`, the
kernel of the substitution `Y i ↦ X^(a i)` of the leading monomials, and let `Q j` be bounded zero
subductions of the `φ (β j)`: `φ (Q j) = φ (β j)`, and every exponent `w` of `Q j` satisfies
`A w ≺ A (u j)`. Over a field such certificates exist exactly when `c` is a SAGBI basis of the
subalgebra it generates (`MonomialOrder.isSAGBIBasis_range_iff_forall_exists_aeval_eq`).

The *lifted relations* `F j = β j - Q j` lie in the kernel of `φ`, and their part of the top weight
`A (u j)` is the binomial `β j`
(`MonomialOrder.weightedHomogeneousComponent_monomial_sub_monomial_sub`). This file proves that
they generate the whole kernel of `φ`: the subalgebra `R[c]`, the range of `φ`, has generators
`Y i` and relations `F j`. More precisely, every element `P` of the kernel has a *standard
representation* `P = ∑ j, g j * F j` in which every exponent `x` of `g j` satisfies
`A x + A (u j) ≼ δ`, for any bound `δ` on the values of `A` on the exponents of `P`. These bounded
representations are the input to the flat degeneration of `R[c]` to the semigroup algebra of its
initial algebra, in which `F j` deforms to `β j`.

## Main results

* `MonomialOrder.exists_finsupp_sum_eq_of_aeval_eq_zero`: every element of the kernel of `φ` has a
  standard representation through the `F j`.
* `MonomialOrder.ker_aeval_eq_span`: the kernel of `φ` is generated by the `F j`.
* `MonomialOrder.IsSAGBIBasis.exists_ker_aeval_eq_span`: over a field, if `c` is a SAGBI basis of
  the subalgebra it generates, then bounded zero subductions `Q j` exist and the corresponding
  `F j` generate the kernel of `φ`.

## Implementation notes

The standard representation is constructed by well-founded induction on the bound `δ`. As `φ P = 0`,
the coefficient of `X^δ` in `φ P` vanishes, so by
`MonomialOrder.exists_finsupp_forall_mem_support_sub_sum_lt` the part of `P` of weight `δ` is, up to
exponents of smaller weight, a combination of the `F j` with coefficients of weight `δ - A (u j)`.
Subtracting it leaves an element of the kernel all of whose exponents have weight below `δ`.

## References

* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
* L. Robbiano, M. Sweedler, *Subalgebra bases*, in *Commutative Algebra (Salvador, 1988)*,
  Lecture Notes in Mathematics 1430, Springer, 1990, 61–87.
* W. Bruns, A. Conca, M. Lembo, arXiv:2504.10019, §2, for monic SAGBI families and bounded
  subduction.
-/

public section

open MvPolynomial

namespace MonomialOrder

variable {σ ι R J : Type*} {m : MonomialOrder σ} [CommRing R] {c : ι → MvPolynomial σ R}

variable [Nontrivial R]

/-- **Standard representations.** Let `c` be a monic family, write
`A w = ∑ i, w i • m.degree (c i)`, let binomials `Y^(u j) - Y^(v j)` generate the toric ideal of the
leading exponents of `c`, and let `Q j` be bounded zero subductions of their images under `aeval c`.
If `aeval c P = 0` and every exponent `w` of `P` satisfies `A w ≼ δ`, then
`P = ∑ j, g j * (Y^(u j) - Y^(v j) - Q j)` for some `g` such that every exponent `x` of `g j`
satisfies `A x + A (u j) ≼ δ`. -/
theorem exists_finsupp_sum_eq_of_aeval_eq_zero (hc : ∀ i, m.Monic (c i)) {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal R (fun i ↦ m.degree (c i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1))
    {Q : J → MvPolynomial ι R}
    (hQc : ∀ j, aeval c (Q j) = aeval c (monomial (u j) (1 : R) - monomial (v j) 1))
    (hQ : ∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≺[m]
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j))
    {P : MvPolynomial ι R} (hP : aeval c P = 0) {δ : σ →₀ ℕ}
    (hPδ : ∀ w ∈ P.support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≼[m] δ) :
    ∃ g : J →₀ MvPolynomial ι R,
      (g.sum fun j q ↦ q * (monomial (u j) 1 - monomial (v j) 1 - Q j)) = P ∧
      ∀ j, ∀ x ∈ (g j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) x +
        Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j) ≼[m] δ := by
  classical
  set A := Finsupp.linearCombination ℕ fun i ↦ m.degree (c i)
  induction hd : m.toSyn δ using WellFoundedLT.induction generalizing δ P with
  | ind d ih =>
  subst hd
  -- Subtract the combination of the lifted relations killing the part of `P` of weight `δ`.
  obtain ⟨g₁, hg₁, hlt⟩ := exists_finsupp_forall_mem_support_sub_sum_lt hc hJ hQ hPδ
    (by simp [hP])
  set P' := P - g₁.sum fun j q ↦ q * (monomial (u j) 1 - monomial (v j) 1 - Q j)
  have hP' : aeval c P' = 0 := by
    simp [P', Finsupp.sum, hP, hQc]
  have hg₁δ (j : J) (x : ι →₀ ℕ) (hx : x ∈ (g₁ j).support) : A x + A (u j) ≼[m] δ :=
    (congrArg m.toSyn (hg₁ j x hx)).le
  rcases eq_or_ne P' 0 with h0 | h0
  · exact ⟨g₁, (sub_eq_zero.1 h0).symm, hg₁δ⟩
  -- The remainder `P'` lies in the kernel and has a smaller bound `A w₀ ≺ δ`.
  obtain ⟨w₀, hw₀, hmax⟩ :=
    Finset.exists_max_image _ (fun w ↦ m.toSyn (A w)) (support_nonempty.2 h0)
  obtain ⟨g₂, hg₂, hg₂δ⟩ := ih _ (hlt w₀ hw₀) hP' hmax rfl
  refine ⟨g₁ + g₂, ?_, fun j x hx ↦ ?_⟩
  · rw [Finsupp.sum_add_index' (fun _ ↦ zero_mul _) fun _ _ _ ↦ add_mul _ _ _, hg₂,
      add_sub_cancel]
  · rw [Finsupp.add_apply] at hx
    rcases Finset.mem_union.1 (support_add hx) with hx | hx
    · exact hg₁δ j x hx
    · exact (hg₂δ j x hx).trans (hlt w₀ hw₀).le

/-- **The presentation of `R[c]`.** Let `c` be a monic family, write
`A w = ∑ i, w i • m.degree (c i)`, and let binomials `Y^(u j) - Y^(v j)` generate the toric ideal of
the leading exponents of `c`. If each image `aeval c (Y^(u j) - Y^(v j))` is the image of a
polynomial `Q j` all of whose exponents `w` satisfy `A w ≺ A (u j)`, then the lifted relations
`Y^(u j) - Y^(v j) - Q j` generate the kernel of `aeval c`. -/
theorem ker_aeval_eq_span (hc : ∀ i, m.Monic (c i)) {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal R (fun i ↦ m.degree (c i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1))
    {Q : J → MvPolynomial ι R}
    (hQc : ∀ j, aeval c (Q j) = aeval c (monomial (u j) (1 : R) - monomial (v j) 1))
    (hQ : ∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≺[m]
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j)) :
    RingHom.ker (aeval c) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1 - Q j) := by
  refine le_antisymm (fun P hP ↦ ?_) (Ideal.span_le.2 ?_)
  · -- Bound the values of `A` on the exponents of `P` by their maximum.
    set f := fun w ↦ m.toSyn (Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w)
    obtain ⟨g, hg, -⟩ := exists_finsupp_sum_eq_of_aeval_eq_zero hc hJ hQc hQ hP
      (δ := m.toSyn.symm (P.support.sup f)) fun w hw ↦ by
        rw [AddEquiv.apply_symm_apply]
        exact Finset.le_sup (f := f) hw
    exact Finsupp.mem_ideal_span_range_iff_exists_finsupp.2 ⟨g, hg⟩
  · rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, hQc, sub_self]

/-- **The presentation of a SAGBI family.** Over a field, let `c` be a monic family which is a SAGBI
basis of the subalgebra it generates, write `A w = ∑ i, w i • m.degree (c i)`, and let binomials
`Y^(u j) - Y^(v j)` generate the toric ideal of the leading exponents of `c`. Then each image
`aeval c (Y^(u j) - Y^(v j))` is the image of a polynomial `Q j` all of whose exponents `w` satisfy
`A w ≺ A (u j)`, and the lifted relations `Y^(u j) - Y^(v j) - Q j` generate the kernel of
`aeval c`. -/
theorem IsSAGBIBasis.exists_ker_aeval_eq_span {k : Type*} [Field k] {c : ι → MvPolynomial σ k}
    (hc : ∀ i, m.Monic (c i)) (h : m.IsSAGBIBasis (Set.range c) (Algebra.adjoin k (Set.range c)))
    {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal k (fun i ↦ m.degree (c i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1)) :
    ∃ Q : J → MvPolynomial ι k,
      (∀ j, aeval c (Q j) = aeval c (monomial (u j) (1 : k) - monomial (v j) 1)) ∧
      (∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≺[m]
        Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j)) ∧
      RingHom.ker (aeval c) =
        Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1 - Q j) := by
  choose Q hQc hQ using (isSAGBIBasis_range_iff_forall_exists_aeval_eq hc hJ).1 h
  exact ⟨Q, hQc, hQ, ker_aeval_eq_span hc hJ hQc hQ⟩

end MonomialOrder
