module

public import TauCeti.RingTheory.MvPolynomial.MonomialOrder
public import TauCeti.RingTheory.MvPolynomial.ToricIdeal.Basic
public import TauCeti.RingTheory.MvPolynomial.WeightedHomogeneous

/-!
# The presentation of a SAGBI subalgebra

Let `m` be a monomial order on `σ →₀ ℕ` and let `c : ι → MvPolynomial σ R` be a family of monic
polynomials, with leading exponents `a i = m.degree (c i)`. Write
`A u = ∑ i, u i • a i` for the exponent map `ℕ^(ι) → σ →₀ ℕ`, `φ = aeval c` for the substitution
`Y i ↦ c i`, and `ψ` for the substitution `Y i ↦ X^(a i)`, whose kernel is the toric ideal
`TauCeti.toricIdeal R a`.

Let `β j = Y^(u j) - Y^(v j)`, with `A (u j) = A (v j)`, be binomials generating the toric ideal,
and suppose that each `φ (β j)` has a *bounded zero subduction*: a polynomial `Q j` with
`φ (Q j) = φ (β j)` such that `A w ≺[m] A (u j)` for every `w` in the support of `Q j`.
For `F j = β j - Q j`, this file proves that the kernel of `φ` is the ideal generated by the
`F j`, over any commutative ring. By the SAGBI criterion
`MonomialOrder.isSAGBIBasis_range_iff_forall_exists_aeval_eq`, over a field such certificates
`Q j` exist exactly when the `c i` form a SAGBI basis of the subalgebra they generate, so this is
the presentation of that subalgebra as a quotient of a polynomial ring. The relation family may be
empty or infinite, the generators need not be finite in number, and constant generators are allowed:
the zero-exponent relations of a constant generator are covered, since only the exponents in the
support of `Q j` are compared, never the totalized degree of the zero polynomial.

## Main results

* `MonomialOrder.weightedHomogeneousComponent_monomial_sub_monomial_sub`: the top
  `A`-homogeneous part of `F j` is exactly `β j`.
* `MonomialOrder.weight_le_of_mem_support_monomial_sub_monomial_sub`: no exponent of `F j` has
  `A`-degree larger than `A (u j)`.
* `MonomialOrder.exists_mem_span_support_lt`: an `A`-homogeneous element of degree `d` of the
  ideal generated by the `β j` is congruent, modulo the ideal generated by the `F j`, to a
  polynomial all of whose exponents have `A`-degree strictly below `d`.
* `MonomialOrder.span_sub_le_ker_aeval`: the lifted relations `F j` lie in the kernel of `φ`.
* `MonomialOrder.exists_mem_span_degree_aeval_eq`: every polynomial is congruent, modulo the
  ideal generated by the `F j`, either to `0` or to a polynomial `P'` such that the leading
  exponent of `φ P'` is the largest `A`-degree of an exponent of `P'`.
* `MonomialOrder.ker_aeval_eq_span_sub`: **the presentation**, `ker φ = (F j)`.

The first three results hold for an arbitrary weight `a : ι → σ →₀ ℕ` in place of the leading
exponents of `c`, compared by the monomial order `m`.

## Implementation notes

The proof decreases the maximal `A`-degree `d` of the exponents of a polynomial `P`. The
coefficient of `φ P` at `d` is the sum of the coefficients of `P` at exponents of `A`-degree `d`,
because each `φ (Y^w)` is monic of leading exponent `A w`. If that sum vanishes, the
`A`-homogeneous component of `P` of degree `d` lies in the toric ideal. Since the toric ideal is
`A`-graded and generated by the `A`-homogeneous `β j`, this component is a combination of
monomial multiples `Y^t β j` with `A t + A (u j) = d`. Replacing each `β j` by `F j` changes `P`
by an element of the ideal generated by the `F j`, and leaves only exponents of `A`-degree
strictly below `d`, by the bounds on the `Q j`.

## References

* W. Bruns, A. Conca, F. Lembo, *Sagbi bases, defining equations and algebras of minors*,
  arXiv:2504.10019, §2, Theorem 2.2.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
-/

public section

namespace MonomialOrder

open MvPolynomial TauCeti

variable {σ ι κ R : Type*} [CommRing R] {m : MonomialOrder σ} {c : ι → MvPolynomial σ R}
  {u v : κ → ι →₀ ℕ} {Q : κ → MvPolynomial ι R} {a : ι → σ →₀ ℕ}

/-- **The top part of a lifted relation.** Write `A w = ∑ i, w i • a i`. If every exponent of
`Q` has `A`-degree strictly below the common `A`-degree of `u` and `v`, the `A`-homogeneous
component of `Y^u - Y^v - Q` of that degree is the binomial `Y^u - Y^v`. -/
theorem weightedHomogeneousComponent_monomial_sub_monomial_sub {u v : ι →₀ ℕ}
    {Q : MvPolynomial ι R}
    (huv : Finsupp.linearCombination ℕ a u = Finsupp.linearCombination ℕ a v)
    (hQ : ∀ w ∈ Q.support, Finsupp.linearCombination ℕ a w ≺[m] Finsupp.linearCombination ℕ a u) :
    weightedHomogeneousComponent a (Finsupp.linearCombination ℕ a u)
        (monomial u 1 - monomial v 1 - Q) = monomial u 1 - monomial v 1 := by
  classical
  rw [map_sub,
    (isWeightedHomogeneous_monomial_sub_monomial huv).weightedHomogeneousComponent_same,
    sub_eq_self, weightedHomogeneousComponent_apply]
  refine Finset.sum_eq_zero fun w hw ↦ ?_
  obtain ⟨hw, hwd⟩ := Finset.mem_filter.1 hw
  rw [Finsupp.weight_eq_linearCombination] at hwd
  exact absurd (congrArg m.toSyn hwd) (hQ w hw).ne

/-- Write `A w = ∑ i, w i • a i`. If every exponent of `Q` has `A`-degree at most the common
`A`-degree of `u` and `v`, then so does every exponent of `Y^u - Y^v - Q`. -/
theorem weight_le_of_mem_support_monomial_sub_monomial_sub {u v : ι →₀ ℕ}
    {Q : MvPolynomial ι R}
    (huv : Finsupp.linearCombination ℕ a u = Finsupp.linearCombination ℕ a v)
    (hQ : ∀ w ∈ Q.support, Finsupp.linearCombination ℕ a w ≼[m] Finsupp.linearCombination ℕ a u)
    {w : ι →₀ ℕ} (hw : w ∈ (monomial u (1 : R) - monomial v 1 - Q).support) :
    Finsupp.linearCombination ℕ a w ≼[m] Finsupp.linearCombination ℕ a u := by
  classical
  rcases Finset.mem_union.1 (support_sub _ _ _ hw) with hw | hw
  · rcases Finset.mem_union.1 (support_sub _ _ _ hw) with hw | hw
    · rw [(Finset.mem_singleton.1 (support_monomial_subset hw))]
    · rw [(Finset.mem_singleton.1 (support_monomial_subset hw)), huv]
  · exact hQ w hw

/-- **Lifting homogeneous relations.** Write `A w = ∑ i, w i • a i`, let
`β j = Y^(u j) - Y^(v j)` with `A (u j) = A (v j)`, and let every exponent of `Q j` have
`A`-degree strictly below `A (u j)`. An `A`-homogeneous element `T` of degree `d` of the ideal
generated by the `β j` is congruent, modulo the ideal generated by the `β j - Q j`, to a
polynomial whose exponents all have `A`-degree strictly below `d`. -/
theorem exists_mem_span_support_lt
    (huv : ∀ j, Finsupp.linearCombination ℕ a (u j) = Finsupp.linearCombination ℕ a (v j))
    (hQ : ∀ j, ∀ w ∈ (Q j).support,
      Finsupp.linearCombination ℕ a w ≺[m] Finsupp.linearCombination ℕ a (u j))
    {T : MvPolynomial ι R} {d : σ →₀ ℕ}
    (hT : T ∈ Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1))
    (hTd : IsWeightedHomogeneous a T d) :
    ∃ G ∈ Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1 - Q j),
      ∀ w ∈ (T - G).support, Finsupp.linearCombination ℕ a w ≺[m] d := by
  classical
  set A := Finsupp.linearCombination ℕ a
  obtain ⟨g, rfl⟩ := Finsupp.mem_ideal_span_range_iff_exists_finsupp.1 hT
  -- The component of the multiplier `g j` contributing to `A`-degree `d`.
  let h : κ → MvPolynomial ι R := fun j ↦
    if A (u j) ≤ d then weightedHomogeneousComponent a (d - A (u j)) (g j) else 0
  have hcomp (j) : weightedHomogeneousComponent a d
      (g j * (monomial (u j) 1 - monomial (v j) 1)) =
        h j * (monomial (u j) 1 - monomial (v j) 1) := by
    have hβ : IsWeightedHomogeneous a (monomial (u j) (1 : R) - monomial (v j) 1) (A (u j)) :=
      isWeightedHomogeneous_monomial_sub_monomial (huv j)
    rw [hβ.weightedHomogeneousComponent_mul_right]
    split_ifs with hle <;> simp [h, hle]
  refine ⟨∑ j ∈ g.support, h j * (monomial (u j) 1 - monomial (v j) 1 - Q j),
    Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩), ?_⟩
  have hTeq : (g.sum fun j p ↦ p * (monomial (u j) (1 : R) - monomial (v j) 1)) =
      ∑ j ∈ g.support, h j * (monomial (u j) 1 - monomial (v j) 1) := by
    rw [← hTd.weightedHomogeneousComponent_same, Finsupp.sum, map_sum]
    exact Finset.sum_congr rfl fun j _ ↦ hcomp j
  rw [hTeq, ← Finset.sum_sub_distrib]
  simp_rw [← mul_sub, sub_sub_cancel]
  -- An exponent of `h j * Q j` is a sum `x + y` with `A x = d - A (u j)` and `A y ≺ A (u j)`.
  intro w hw
  obtain ⟨j, -, hj⟩ := Finset.mem_biUnion.1 (support_sum hw)
  obtain ⟨x, hx, y, hy, rfl⟩ := Finset.mem_add.1 (support_mul _ _ hj)
  have hle : A (u j) ≤ d := by
    by_contra hle
    simp [h, hle] at hx
  have hAx : A x = d - A (u j) := by
    rw [← Finsupp.weight_eq_linearCombination]
    simp only [h, hle, ite_true] at hx
    exact weightedHomogeneousComponent_isWeightedHomogeneous _ _ (mem_support_iff.1 hx)
  rw [map_add, map_add, hAx]
  conv_rhs => rw [← tsub_add_cancel_of_le hle, map_add]
  exact add_lt_add_right (hQ j y hy) _

/-- The lifted relations `β j - Q j` lie in the kernel of `aeval c` whenever
`aeval c (Q j) = aeval c (β j)`. -/
theorem span_sub_le_ker_aeval
    (hQ : ∀ j, aeval c (Q j) = aeval c (monomial (u j) (1 : R) - monomial (v j) 1)) :
    Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1 - Q j) ≤
      RingHom.ker (aeval c) := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨j, rfl⟩
  rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, hQ, sub_self]

/-- **Standard representations.** Let `β j = Y^(u j) - Y^(v j)` be binomials with
`A (u j) = A (v j)` which generate the toric ideal of the leading exponents of a monic family `c`,
and let `Q j` be bounded zero subductions of the `β j`. Then every polynomial `P` is congruent,
modulo the ideal generated by the `β j - Q j`, to `0`, or to a polynomial `P - G` for which
`aeval c P` is nonzero with leading exponent `A w` for some exponent `w` of `P - G` of largest
`A`-degree. -/
theorem exists_mem_span_degree_aeval_eq (hc : ∀ i, m.Monic (c i))
    (huv : ∀ j, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j) =
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (v j))
    (hspan : toricIdeal R (fun i ↦ m.degree (c i)) ≤
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1))
    (hQ : ∀ j, aeval c (Q j) = aeval c (monomial (u j) (1 : R) - monomial (v j) 1))
    (hQlt : ∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≺[m]
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j))
    (P : MvPolynomial ι R) :
    ∃ G ∈ Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1 - Q j),
      P = G ∨ ∃ w ∈ (P - G).support, aeval c P ≠ 0 ∧
        m.degree (aeval c P) = Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ∧
        ∀ w' ∈ (P - G).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w' ≼[m]
          Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w := by
  classical
  set A := Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i))
  set J := Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1 - Q j)
  have hJ : ∀ G ∈ J, aeval c G = 0 := fun G hG ↦ RingHom.mem_ker.1 (span_sub_le_ker_aeval hQ hG)
  rcases subsingleton_or_nontrivial R with _ | _
  · exact ⟨0, J.zero_mem, Or.inl (Subsingleton.elim _ _)⟩
  induction P using induction_weight_support (m := m) (fun i ↦ m.degree (c i)) with
  | h0 => exact ⟨0, J.zero_mem, Or.inl rfl⟩
  | h d P hP ih =>
    by_cases hs : ∑ w ∈ P.support with A w = d, P.coeff w = 0
    · -- The top block lies in the toric ideal: lift it to the ideal `J`.
      have hT : weightedHomogeneousComponent (fun i ↦ m.degree (c i)) d P ∈
          toricIdeal R (fun i ↦ m.degree (c i)) := by
        rwa [weightedHomogeneousComponent_mem_toricIdeal_iff]
      obtain ⟨G₁, hG₁, hlt⟩ := exists_mem_span_support_lt huv hQlt (hspan hT)
        (weightedHomogeneousComponent_isWeightedHomogeneous _ _)
      have hP' : ∀ w ∈ (P - G₁).support, A w ≺[m] d := by
        intro w hw
        rw [← sub_add_sub_cancel P
          (weightedHomogeneousComponent (fun i ↦ m.degree (c i)) d P)] at hw
        rcases Finset.mem_union.1 (support_add hw) with hw | hw
        · exact weight_lt_of_mem_support_sub_weightedHomogeneousComponent hP hw
        · exact hlt w hw
      obtain ⟨G₂, hG₂, h⟩ := ih (P - G₁) hP'
      have haeval : aeval c (P - G₁) = aeval c P := by rw [map_sub, hJ G₁ hG₁, sub_zero]
      refine ⟨G₁ + G₂, J.add_mem hG₁ hG₂, ?_⟩
      rw [← sub_sub, ← haeval]
      rcases h with h | h
      · exact Or.inl (by rw [← h, add_sub_cancel])
      · exact Or.inr h
    · -- The top block survives substitution: `aeval c P` has leading exponent `d`.
      obtain ⟨w, hw, -⟩ := Finset.exists_ne_zero_of_sum_ne_zero hs
      obtain ⟨hwP, hwd⟩ := Finset.mem_filter.1 hw
      have hcoeff : (aeval c P).coeff d ≠ 0 := by rwa [coeff_aeval_of_forall_le hc hP]
      have hne : aeval c P ≠ 0 := fun h ↦ hcoeff (by simp [h])
      refine ⟨0, J.zero_mem, Or.inr ⟨w, by rwa [sub_zero], hne, ?_, ?_⟩⟩
      · rw [hwd]
        exact m.toSyn.injective (le_antisymm (degree_aeval_le_of_forall_le hc hP)
          (m.le_degree (mem_support_iff.2 hcoeff)))
      · rw [sub_zero, hwd]
        exact hP

/-- **The presentation of a SAGBI subalgebra.** Let `β j = Y^(u j) - Y^(v j)` be binomials with
`A (u j) = A (v j)` which generate the toric ideal of the leading exponents of a monic family `c`,
and let `Q j` be bounded zero subductions of the `β j`: `aeval c (Q j) = aeval c (β j)` and every
exponent of `Q j` has `A`-degree strictly below `A (u j)`. Then the kernel of `aeval c` is
generated by the lifted relations `β j - Q j`. -/
theorem ker_aeval_eq_span_sub (hc : ∀ i, m.Monic (c i))
    (huv : ∀ j, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j) =
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (v j))
    (hspan : toricIdeal R (fun i ↦ m.degree (c i)) ≤
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1))
    (hQ : ∀ j, aeval c (Q j) = aeval c (monomial (u j) (1 : R) - monomial (v j) 1))
    (hQlt : ∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≺[m]
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j)) :
    RingHom.ker (aeval c) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1 - Q j) := by
  refine le_antisymm (fun P hP ↦ ?_) (span_sub_le_ker_aeval hQ)
  obtain ⟨G, hG, h | ⟨_, _, hne, _⟩⟩ := exists_mem_span_degree_aeval_eq hc huv hspan hQ hQlt P
  · exact h ▸ hG
  · exact absurd (RingHom.mem_ker.1 hP) hne

end MonomialOrder
