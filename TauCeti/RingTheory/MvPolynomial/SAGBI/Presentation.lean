module

public import TauCeti.RingTheory.MvPolynomial.SAGBI.Criterion

/-!
# Presentations of subalgebras generated by monic SAGBI families

Let `m` be a monomial order on `σ →₀ ℕ` and let `c : ι → MvPolynomial σ R` be a family of monic
polynomials, with leading exponents `a i = m.degree (c i)`. Write `A w = ∑ i, w i • a i`
(`Finsupp.linearCombination ℕ a w`) for the exponent map and `φ = aeval c` for the substitution
`Y i ↦ c i`. Let binomials `β j = Y^(u j) - Y^(v j)` generate the toric ideal of the `a i`, the
kernel of the substitution `Y i ↦ X^(a i)` of the leading monomials, and let `Q j` be bounded zero
subductions of their images: `φ (Q j) = φ (β j)` and every exponent `w` of `Q j` satisfies
`A w ≺ A (u j)`. Such `Q j` exist exactly when `c` is a SAGBI basis of `k[c]`, by the SAGBI
criterion `MonomialOrder.isSAGBIBasis_range_iff_forall_exists_aeval_eq`.

This file shows that the relations `F j = β j - Q j` present the subalgebra generated by `c`:
they generate the kernel of `φ`. The relation `F j` lifts the relation `β j` among the leading
monomials: its part of top weight `A (u j)` is exactly `β j`, by
`MonomialOrder.weightedHomogeneousComponent_monomial_sub_monomial_sub`. These presentations, and
the bounds on the standard representations of relations through the `F j`, are the input to the
flat degeneration of a subalgebra with a finite monic SAGBI basis to the semigroup algebra of its
initial algebra.

## Main results

* `MonomialOrder.mem_span_monomial_mul_of_aeval_eq_zero`: **standard representations**, every
  polynomial `P` with `φ P = 0` whose exponents `w` satisfy `A w ≼ δ` is an `R`-linear combination
  of monomial multiples `Y^x * F j` with `A x + A (u j) ≼ δ`.
* `MonomialOrder.ker_aeval_eq_span`: **the presentation**, the `F j` generate the kernel of `φ`.
* `MonomialOrder.IsSAGBIBasis.exists_ker_aeval_eq_span`: over a field, a monic SAGBI basis `c` of
  `k[c]` admits such bounded `Q j`, and so a presentation of `k[c]` by the relations `F j`.

## Implementation notes

The standard representation is proved by well-founded induction on the bound `δ`. Since
`φ P = 0`, the coefficient of `X^δ` in `φ P` vanishes, and the reduction step
`MonomialOrder.exists_sub_mem_span_of_coeff_aeval_eq_zero` makes `P` congruent, modulo multiples
`Y^x * F j` with `A x + A (u j) = δ`, to a relation all of whose exponents have weight below `δ`.

## References

* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
* Bruns, Conca, Lembo, arXiv:2504.10019, §2, Theorem 2.2 and Proposition 2.4, for monic SAGBI
  families, bounded subduction and the lifting of toric relations.
-/

public section

open MvPolynomial

namespace MonomialOrder

variable {σ ι J : Type*} {m : MonomialOrder σ}

section CommRing

variable {R : Type*} [CommRing R]

variable [Nontrivial R] {c : ι → MvPolynomial σ R}

/-- **Standard representations of relations.** Let `c` be a monic family, write
`A w = ∑ i, w i • m.degree (c i)`, let binomials `Y^(u j) - Y^(v j)` generate the toric ideal of
the leading exponents of `c`, and let `Q j` be bounded zero subductions of their images:
`aeval c (Q j) = aeval c (Y^(u j) - Y^(v j))` and every exponent `w` of `Q j` satisfies
`A w ≺ A (u j)`. Then every polynomial `P` with `aeval c P = 0` all of whose exponents `w`
satisfy `A w ≼ δ` is an `R`-linear combination of the monomial multiples
`Y^x * (Y^(u j) - Y^(v j) - Q j)` with `A x + A (u j) ≼ δ`. -/
theorem mem_span_monomial_mul_of_aeval_eq_zero (hc : ∀ i, m.Monic (c i)) {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal R (fun i ↦ m.degree (c i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1))
    {Q : J → MvPolynomial ι R}
    (hQ : ∀ j, aeval c (Q j) = aeval c (monomial (u j) (1 : R) - monomial (v j) 1))
    (hQlt : ∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≺[m]
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j))
    {P : MvPolynomial ι R} (hP : aeval c P = 0) {δ : σ →₀ ℕ}
    (hPδ : ∀ w ∈ P.support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≼[m] δ) :
    P ∈ Submodule.span R {f | ∃ x j,
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) x +
        Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j) ≼[m] δ ∧
      monomial x 1 * (monomial (u j) 1 - monomial (v j) 1 - Q j) = f} := by
  classical
  set A := Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i))
  induction hd : m.toSyn δ using WellFoundedLT.induction generalizing δ P with
  | ind d ih =>
  subst hd
  -- `P` is congruent, modulo multiples of the relations of weight `δ`, to a relation `P'` all of
  -- whose exponents have weight below `δ`.
  obtain ⟨P', hPP', hP'δ⟩ := exists_sub_mem_span_of_coeff_aeval_eq_zero hc hJ hQlt hPδ
    (by simp [hP])
  have hP' : aeval c P' = 0 := by
    rw [← sub_sub_cancel P P', map_sub, hP, aeval_eq_zero_of_mem_span_monomial_mul hQ hPP',
      sub_zero]
  rw [← sub_add_cancel P P']
  refine add_mem (Submodule.span_mono ?_ hPP') ?_
  · rintro _ ⟨x, j, h, rfl⟩
    exact ⟨x, j, (congrArg m.toSyn h).le, rfl⟩
  rcases P'.support.eq_empty_or_nonempty with h0 | hne
  · rw [support_eq_empty.1 h0]
    exact zero_mem _
  -- Otherwise `P'` has a standard representation for the smaller bound `δ' ≺ δ`.
  obtain ⟨w₀, hw₀, hmax⟩ := Finset.exists_max_image _ (fun w ↦ m.toSyn (A w)) hne
  refine Submodule.span_mono ?_ (ih _ (hP'δ w₀ hw₀) hP' hmax rfl)
  rintro _ ⟨x, j, h, rfl⟩
  exact ⟨x, j, h.trans (hP'δ w₀ hw₀).le, rfl⟩

/-- **The presentation of a subalgebra generated by a monic family.** Let `c` be a monic family,
write `A w = ∑ i, w i • m.degree (c i)`, let binomials `Y^(u j) - Y^(v j)` generate the toric
ideal of the leading exponents of `c`, and let `Q j` be bounded zero subductions of their images:
`aeval c (Q j) = aeval c (Y^(u j) - Y^(v j))` and every exponent `w` of `Q j` satisfies
`A w ≺ A (u j)`. Then the relations `Y^(u j) - Y^(v j) - Q j` generate the kernel of `aeval c`. -/
theorem ker_aeval_eq_span (hc : ∀ i, m.Monic (c i)) {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal R (fun i ↦ m.degree (c i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1))
    {Q : J → MvPolynomial ι R}
    (hQ : ∀ j, aeval c (Q j) = aeval c (monomial (u j) (1 : R) - monomial (v j) 1))
    (hQlt : ∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≺[m]
      Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j)) :
    RingHom.ker (aeval c) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : R) - monomial (v j) 1 - Q j) := by
  refine le_antisymm (fun P hP ↦ ?_) (Ideal.span_le.2 ?_)
  · rcases P.support.eq_empty_or_nonempty with h0 | hne
    · rw [support_eq_empty.1 h0]
      exact zero_mem _
    obtain ⟨w₀, -, hmax⟩ := Finset.exists_max_image _
      (fun w ↦ m.toSyn (Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w)) hne
    refine (Submodule.span_le (p := (Ideal.span _).restrictScalars R)).2 ?_
      (mem_span_monomial_mul_of_aeval_eq_zero hc hJ hQ hQlt (RingHom.mem_ker.1 hP) hmax)
    rintro _ ⟨x, j, -, rfl⟩
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
  · rintro _ ⟨j, rfl⟩
    exact RingHom.mem_ker.2 (aeval_monomial_sub_monomial_sub_eq_zero (hQ j))

end CommRing

section Field

variable {k : Type*} [Field k] {c : ι → MvPolynomial σ k}

/-- **The presentation of a subalgebra generated by a monic SAGBI basis.** Let `c` be a monic family
over a field which is a SAGBI basis of the subalgebra `k[c]` it generates, write
`A w = ∑ i, w i • m.degree (c i)`, and let binomials `Y^(u j) - Y^(v j)` generate the toric ideal
of the leading exponents of `c`. Then there are polynomials `Q j` with
`aeval c (Q j) = aeval c (Y^(u j) - Y^(v j))`, all of whose exponents `w` satisfy
`A w ≺ A (u j)`, such that the relations `Y^(u j) - Y^(v j) - Q j` generate the kernel of
`aeval c`. -/
theorem IsSAGBIBasis.exists_ker_aeval_eq_span (hc : ∀ i, m.Monic (c i))
    (h : m.IsSAGBIBasis (Set.range c) (Algebra.adjoin k (Set.range c))) {u v : J → ι →₀ ℕ}
    (hJ : TauCeti.toricIdeal k (fun i ↦ m.degree (c i)) =
      Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1)) :
    ∃ Q : J → MvPolynomial ι k,
      (∀ j, aeval c (Q j) = aeval c (monomial (u j) (1 : k) - monomial (v j) 1)) ∧
      (∀ j, ∀ w ∈ (Q j).support, Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) w ≺[m]
        Finsupp.linearCombination ℕ (fun i ↦ m.degree (c i)) (u j)) ∧
      RingHom.ker (aeval c) =
        Ideal.span (Set.range fun j ↦ monomial (u j) (1 : k) - monomial (v j) 1 - Q j) := by
  choose Q hQ hQlt using (isSAGBIBasis_range_iff_forall_exists_aeval_eq hc hJ).1 h
  exact ⟨Q, hQ, hQlt, ker_aeval_eq_span hc hJ hQ hQlt⟩

end Field

end MonomialOrder
