module

public import Mathlib.GroupTheory.Perm.ClosureSwap
public import TauCeti.RingTheory.MvPolynomial.PermInvariant
public import TauCeti.RingTheory.MvPolynomial.SAGBI.Basic
public import TauCeti.RingTheory.MvPolynomial.Symmetric.LeadingTerm

/-!
# Leading exponents of permutation invariants

Let `G` be a finite subgroup of the permutation group of the variables `σ` (for instance, any
permutation group of finitely many variables), and let `m` be a
monomial order. The coefficients of a `G`-invariant polynomial are constant on the `G`-orbits of
exponents, so its leading exponent `e` is the largest exponent of its orbit: renaming by any
`g ∈ G` gives `m.toSyn (e.mapDomain g) ≤ m.toSyn e`. Conversely, if `e` is the largest exponent of
its orbit, the orbit sum `TauCeti.MvPolynomial.orbitSum R G e` is monic with leading exponent `e`.

Hence, over coefficients without zero divisors, the leading exponents of the invariant subalgebra
`TauCeti.MvPolynomial.permInvariants R G` are exactly the exponents that are largest in their orbits
(`MonomialOrder.mem_leadingExponents_permInvariants_iff`), and the orbit sums form a SAGBI basis of
the invariant subalgebra for every monomial order (`MonomialOrder.isSAGBIBasis_range_orbitSum`).
When `σ` is nonempty and `R` is nontrivial, this orbit-sum SAGBI basis is infinite. Over a field,
the invariant subalgebra has a finite SAGBI basis exactly when the monoid of orbit-maximal exponents
is finitely generated
(`MonomialOrder.exists_finite_isSAGBIBasis_iff_fg`); this is the monoid through which finite SAGBI
bases of permutation invariants are classified.

When `G` contains the transposition of any two variables in the same orbit, for instance when
`G` is generated by transpositions (`swap_mem_closure_isSwap`), so that `G` contains the full
symmetric group of each of its orbits, an orbit-maximal exponent is sorted on each orbit of
variables: exchanging the exponents of a larger and a smaller variable of one orbit would
otherwise give a larger exponent in the same `G`-orbit
(`MonomialOrder.toSyn_lt_toSyn_mapDomain_swap`). Such an exponent is a sum of indicators of
subsets of orbits closed upwards in their orbit, which are the leading exponents of the elementary
symmetric polynomials `TauCeti.MvPolynomial.orbitEsymm R G x r` of the orbits. Hence these
elementary symmetric polynomials form a SAGBI basis of the invariant subalgebra for every monomial
order and over every commutative semiring (`MonomialOrder.isSAGBIBasis_range_orbitEsymm`), which
is finite in finitely many variables.

## Main results

* `MonomialOrder.toSyn_mapDomain_degree_le_of_mem_permInvariants`: the leading exponent of an
  invariant polynomial is the largest exponent of its orbit.
* `MonomialOrder.degree_orbitSum`, `MonomialOrder.monic_orbitSum`: the orbit sum of an
  orbit-maximal exponent is monic with that leading exponent.
* `MonomialOrder.mem_leadingExponents_permInvariants_iff`: the leading exponents of the invariant
  subalgebra are the orbit-maximal exponents.
* `MonomialOrder.isSAGBIBasis_range_orbitSum`: the orbit sums form a SAGBI basis of the invariant
  subalgebra.
* `MonomialOrder.isSAGBIBasis_range_orbitEsymm`: if `G` contains the transposition of any two
  variables in the same orbit, the elementary symmetric polynomials of the orbits form a SAGBI
  basis of the invariant subalgebra; `MonomialOrder.isSAGBIBasis_range_orbitEsymm_closure` states
  this for the subgroup generated by a set of transpositions.
* `MonomialOrder.exists_finite_isSAGBIBasis_permInvariants`: in finitely many variables, such a
  permutation group has a finite SAGBI basis of invariants for every monomial order.

## References

* L. Robbiano, M. Sweedler, *Subalgebra bases*, in *Commutative Algebra (Salvador, 1988)*,
  Lecture Notes in Math. **1430**, Springer, 1990, 61–87.
* M. Göbel, *Computing bases for rings of permutation-invariant polynomials*, J. Symbolic Comput.
  **19** (1995), 285–291.
* N. M. Thiéry, S. Thomassé, *Convex cones and SAGBI bases of permutation invariants*,
  arXiv:math/0607380.
-/

public section

namespace MonomialOrder

open MvPolynomial TauCeti.MvPolynomial

variable {σ R : Type*} [CommSemiring R] (m : MonomialOrder σ) {G : Subgroup (Equiv.Perm σ)}
  {e : σ →₀ ℕ} {p : MvPolynomial σ R}

/-- The leading exponent of a `G`-invariant polynomial is the largest exponent of its `G`-orbit. -/
theorem toSyn_mapDomain_degree_le_of_mem_permInvariants (hp : p ∈ permInvariants R G)
    {g : Equiv.Perm σ} (hg : g ∈ G) :
    m.toSyn ((m.degree p).mapDomain g) ≤ m.toSyn (m.degree p) := by
  rcases eq_or_ne p 0 with rfl | hp0
  · simp
  refine m.le_degree (mem_support_iff.2 ?_)
  rw [mem_permInvariants_iff_forall_coeff_mapDomain.1 hp g hg]
  exact m.coeff_degree_ne_zero_iff.2 hp0

variable [Finite G]

variable (G) in
/-- Every `G`-orbit of exponents has a largest element for the monomial order. -/
theorem exists_permOrbitRel_forall_toSyn_mapDomain_le (e : σ →₀ ℕ) :
    ∃ f, permOrbitRel G e f ∧ ∀ g ∈ G, m.toSyn (f.mapDomain g) ≤ m.toSyn f := by
  obtain ⟨f, hf, hmax⟩ := (finite_setOf_permOrbitRel G e).toFinset.exists_max_image m.toSyn
    ⟨e, by simp⟩
  rw [Set.Finite.mem_toFinset] at hf
  refine ⟨f, hf, fun g hg ↦ hmax _ ?_⟩
  rw [Set.Finite.mem_toFinset]
  exact (permOrbitRel G).trans' hf (permOrbitRel_mapDomain hg f)

/-- The orbit sum of an exponent that is largest in its orbit has that exponent as its leading
exponent. -/
theorem degree_orbitSum [Nontrivial R]
    (he : ∀ g ∈ G, m.toSyn (e.mapDomain g) ≤ m.toSyn e) : m.degree (orbitSum R G e) = e := by
  refine m.toSyn.injective (le_antisymm (m.degree_le_iff.2 fun f hf ↦ ?_)
    (m.le_degree (mem_support_orbitSum.2 ((permOrbitRel G).refl' e))))
  obtain ⟨g, hg, rfl⟩ := permOrbitRel_iff.1 (mem_support_orbitSum.1 hf)
  exact he g hg

/-- The orbit sum of an exponent that is largest in its orbit is monic. -/
theorem monic_orbitSum (he : ∀ g ∈ G, m.toSyn (e.mapDomain g) ≤ m.toSyn e) :
    m.Monic (orbitSum R G e) := by
  nontriviality R
  rw [Monic, leadingCoeff, m.degree_orbitSum he,
    coeff_orbitSum_of_rel ((permOrbitRel G).refl' e)]

/-- The leading term of the orbit sum of an exponent that is largest in its orbit is the monomial
of that exponent. -/
theorem leadingTerm_orbitSum (he : ∀ g ∈ G, m.toSyn (e.mapDomain g) ≤ m.toSyn e) :
    m.leadingTerm (orbitSum R G e) = monomial e 1 := by
  nontriviality R
  rw [leadingTerm, (m.monic_orbitSum he).leadingCoeff_eq_one, m.degree_orbitSum he]

/-- Over coefficients without zero divisors, the leading exponents of the `G`-invariant
polynomials are the exponents that are largest in their `G`-orbits. -/
theorem mem_leadingExponents_permInvariants_iff [NoZeroDivisors R] [Nontrivial R] :
    e ∈ m.leadingExponents (permInvariants R G) ↔
      ∀ g ∈ G, m.toSyn (e.mapDomain g) ≤ m.toSyn e := by
  refine ⟨fun h ↦ ?_, fun he ↦ mem_leadingExponents_iff.2 ⟨orbitSum R G e,
    orbitSum_mem_permInvariants e, orbitSum_ne_zero, m.degree_orbitSum he⟩⟩
  obtain ⟨f, hf, -, rfl⟩ := mem_leadingExponents_iff.1 h
  exact fun g hg ↦ m.toSyn_mapDomain_degree_le_of_mem_permInvariants hf hg

variable (R G) in
/-- The orbit sums form a SAGBI basis of the invariant subalgebra of a permutation group, for
every monomial order. -/
theorem isSAGBIBasis_range_orbitSum :
    m.IsSAGBIBasis (Set.range (orbitSum R G)) (permInvariants R G) := by
  rw [isSAGBIBasis_iff_initialAlgebra_le, initialAlgebra_def]
  refine ⟨Set.range_subset_iff.2 orbitSum_mem_permInvariants, Algebra.adjoin_le ?_⟩
  rintro _ ⟨f, hf, rfl⟩
  have hmax : ∀ g ∈ G, m.toSyn ((m.degree f).mapDomain g) ≤ m.toSyn (m.degree f) :=
    fun g hg ↦ m.toSyn_mapDomain_degree_le_of_mem_permInvariants hf hg
  have hterm : m.leadingTerm f = C (m.leadingCoeff f) * m.leadingTerm (orbitSum R G (m.degree f)) :=
    by rw [m.leadingTerm_orbitSum hmax, C_mul_monomial, mul_one, leadingTerm]
  rw [hterm]
  exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
    (Algebra.subset_adjoin ⟨_, ⟨_, rfl⟩, rfl⟩)

section Transposition

open Finsupp

variable {m} [DecidableEq σ]

omit [Finite G] in
/-- If `G` contains the transposition of any two variables of the same orbit, an exponent that
is largest in its `G`-orbit is sorted on each orbit of variables: a larger variable carries a
larger exponent. -/
private theorem le_of_forall_toSyn_mapDomain_le
    (hG : ∀ x y, y ∈ MulAction.orbit G x → Equiv.swap x y ∈ G)
    (he : ∀ g ∈ G, m.toSyn (e.mapDomain g) ≤ m.toSyn e) {i j : σ}
    (hj : j ∈ MulAction.orbit G i) (hij : m.toSyn (single j 1) < m.toSyn (single i 1)) :
    e j ≤ e i := by
  by_contra! h
  exact (he _ (hG i j hj)).not_gt (m.toSyn_lt_toSyn_mapDomain_swap hij h)

omit [Finite G] [DecidableEq σ] in
/-- Removing from an exponent sorted on each orbit of variables the indicator of its support on
one orbit leaves an exponent sorted on each orbit. -/
private theorem tsub_sum_single_le {e : σ →₀ ℕ} {x : σ} {t : Finset σ}
    (ht : ∀ y, y ∈ t ↔ y ∈ MulAction.orbit G x ∧ e y ≠ 0)
    (he : ∀ i j, j ∈ MulAction.orbit G i → m.toSyn (single j 1) < m.toSyn (single i 1) →
      e j ≤ e i) {i j : σ} (hj : j ∈ MulAction.orbit G i)
    (hij : m.toSyn (single j 1) < m.toSyn (single i 1)) :
    (e - ∑ y ∈ t, single y 1 : σ →₀ ℕ) j ≤ (e - ∑ y ∈ t, single y 1 : σ →₀ ℕ) i := by
  classical
  have hji := he i j hj hij
  have hiff : j ∈ MulAction.orbit G x ↔ i ∈ MulAction.orbit G x := by
    rw [← MulAction.orbit_eq_iff, ← MulAction.orbit_eq_iff, MulAction.orbit_eq_iff.2 hj]
  have hind : ∀ z, (∑ y ∈ t, single y 1 : σ →₀ ℕ) z = if z ∈ t then 1 else 0 := fun z ↦ by
    simp [Finset.sum_apply', single_apply]
  rw [tsub_apply, tsub_apply, hind, hind]
  by_cases hi : i ∈ MulAction.orbit G x
  · simp only [ht, hi, hiff.2 hi, true_and]
    split_ifs <;> omega
  · simpa [ht, hi, hiff] using hji

omit [DecidableEq σ] in
/-- An exponent sorted on each orbit of variables is a sum of the leading exponents of the
elementary symmetric polynomials of the orbits: peel off the indicator of its support on one orbit,
which is closed upwards in the orbit, and induct. -/
private theorem monomial_mem_adjoin_leadingTerm_orbitEsymm {e : σ →₀ ℕ}
    (he : ∀ i j, j ∈ MulAction.orbit G i → m.toSyn (single j 1) < m.toSyn (single i 1) →
      e j ≤ e i) :
    monomial e (1 : R) ∈
      Algebra.adjoin R (m.leadingTerm '' Set.range fun p : σ × ℕ ↦ orbitEsymm R G p.1 p.2) := by
  classical
  induction e using WellFoundedLT.induction with
  | _ e ih =>
  rcases eq_or_ne e 0 with rfl | he0
  · rw [← one_def]
    exact Subalgebra.one_mem _
  obtain ⟨x, hx⟩ : ∃ x, e x ≠ 0 := by
    by_contra! h
    exact he0 (Finsupp.ext h)
  -- `t` is the support of `e` on the orbit `O` of `x`; it is closed upwards in `O`.
  set O := (Finite.finite_mulAction_orbit x : (MulAction.orbit G x).Finite).toFinset
  set t := O.filter (e · ≠ 0)
  have ht : ∀ y, y ∈ t ↔ y ∈ MulAction.orbit G x ∧ e y ≠ 0 := fun y ↦ by
    rw [Finset.mem_filter, Set.Finite.mem_toFinset]
  have hup : ∀ i ∈ t, ∀ j ∈ O, m.toSyn (single i 1) < m.toSyn (single j 1) → j ∈ t := by
    intro i hi j hj hij
    rw [ht] at hi ⊢
    rw [Set.Finite.mem_toFinset] at hj
    have hij' : i ∈ MulAction.orbit G j := by
      rw [MulAction.orbit_eq_iff.2 hj]
      exact hi.1
    exact ⟨hj, fun h0 ↦ hi.2 (Nat.eq_zero_of_le_zero (h0 ▸ he j i hij' hij))⟩
  -- Write `e = e' + ∑ i ∈ t, single i 1` with `e' < e` again sorted, and induct.
  have hle : ∑ i ∈ t, single i 1 ≤ e := fun y ↦ by
    simp only [Finset.sum_apply', single_apply, Finset.sum_ite_eq']
    split_ifs with hy
    · exact Nat.one_le_iff_ne_zero.2 ((ht y).1 hy).2
    · exact Nat.zero_le _
  have hlt : e - ∑ i ∈ t, single i 1 < e := by
    refine lt_of_le_of_ne tsub_le_self fun h ↦ ?_
    have := congrArg (· x) h
    simp only [coe_tsub, Pi.sub_apply, Finset.sum_apply', single_apply, Finset.sum_ite_eq',
      (ht x).2 ⟨MulAction.mem_orbit_self x, hx⟩, ite_true] at this
    omega
  rw [← tsub_add_cancel_of_le hle, ← mul_one (1 : R), ← monomial_mul_monomial]
  refine Subalgebra.mul_mem _ (ih _ hlt fun i j ↦ tsub_sum_single_le ht he)
    (Algebra.subset_adjoin ⟨orbitEsymm R G x t.card, ⟨(x, t.card), rfl⟩, ?_⟩)
  rw [orbitEsymm_def]
  exact leadingTerm_esymm_map_X (Finset.filter_subset _ _) hup

variable (R) in
/-- If a permutation group `G` contains the transposition of any two variables in the same orbit,
then the elementary symmetric polynomials of the orbits of variables form a SAGBI basis of the
invariant subalgebra, for every monomial order. -/
theorem isSAGBIBasis_range_orbitEsymm (hG : ∀ x y, y ∈ MulAction.orbit G x → Equiv.swap x y ∈ G) :
    m.IsSAGBIBasis (Set.range fun p : σ × ℕ ↦ orbitEsymm R G p.1 p.2) (permInvariants R G) := by
  rw [isSAGBIBasis_iff_initialAlgebra_le, initialAlgebra_def]
  refine ⟨Set.range_subset_iff.2 fun p ↦ orbitEsymm_mem_permInvariants p.1 p.2,
    Algebra.adjoin_le ?_⟩
  rintro _ ⟨f, hf, rfl⟩
  have hmax : ∀ g ∈ G, m.toSyn ((m.degree f).mapDomain g) ≤ m.toSyn (m.degree f) :=
    fun g hg ↦ m.toSyn_mapDomain_degree_le_of_mem_permInvariants hf hg
  rw [leadingTerm, ← mul_one (m.leadingCoeff f), ← C_mul_monomial]
  exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
    (monomial_mem_adjoin_leadingTerm_orbitEsymm fun i j hj hij ↦
      le_of_forall_toSyn_mapDomain_le hG hmax hj hij)

variable (R) in
/-- In finitely many variables, the invariant subalgebra of a permutation group containing the
transposition of any two variables in the same orbit has a finite SAGBI basis for every monomial
order. -/
theorem exists_finite_isSAGBIBasis_permInvariants [Finite σ]
    (hG : ∀ x y, y ∈ MulAction.orbit G x → Equiv.swap x y ∈ G) :
    ∃ B : Set (MvPolynomial σ R), B.Finite ∧ m.IsSAGBIBasis B (permInvariants R G) :=
  ⟨_, finite_range_orbitEsymm R G, isSAGBIBasis_range_orbitEsymm R hG⟩

end Transposition

variable (R) in
/-- For a permutation group generated by transpositions, the elementary symmetric polynomials of
its orbits of variables form a SAGBI basis of its invariant subalgebra, for every monomial
order. -/
theorem isSAGBIBasis_range_orbitEsymm_closure [DecidableEq σ] {S : Set (Equiv.Perm σ)}
    (hS : ∀ f ∈ S, f.IsSwap) [Finite (Subgroup.closure S)] :
    m.IsSAGBIBasis (Set.range fun p : σ × ℕ ↦ orbitEsymm R (Subgroup.closure S) p.1 p.2)
      (permInvariants R (Subgroup.closure S)) :=
  m.isSAGBIBasis_range_orbitEsymm R fun _ _ h ↦
    (swap_mem_closure_isSwap hS).2 (MulAction.mem_orbit_symm.1 h)

end MonomialOrder
