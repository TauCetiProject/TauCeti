public import TauCeti.RingTheory.MvPolynomial.SAGBI.Criterion
public import TauCeti.RingTheory.MvPolynomial.SAGBI.Monic
public import TauCeti.RingTheory.MvPolynomial.SAGBI.Remainder
import Mathlib.Tactic.LinearCombination

/-!
# Test families for the SAGBI criterion

Work in `ℚ[x, y]`, with `x = X 0` and `y = X 1`, for the lexicographic order with `x > y`, and
write `U, V, W` for the variables `X 0, X 1, X 2` of the polynomial ring in which relations among a
family of three generators live.

**Leading-coefficient collision.** The family `b = (x, x + y, 2x + y)`
(`TauCeti.SAGBI.Examples.collisionFamily`) has all three leading exponents equal to that of `x`,
with leading coefficients `1, 1, 2`. The toric ideal of these exponents is generated by the
coefficient-one binomials `U - W` and `V - W`. Substituting `b` turns them into `-(x + y)` and `-x`,
which subduct to zero in one step, against `-V` and `-U`. Nevertheless `b` is not a SAGBI basis of
`ℚ[b]`: the variable `y = (x + y) - x` lies in `ℚ[b]`, while the algebra generated by the leading
terms `x, x, 2x` is `ℚ[x]`. Substituting a nonmonic family into the coefficient-one relations
among its leading exponents therefore does not test the SAGBI property.

The monic normalization of `b` is `c = (x, x + y, x + y/2)`
(`TauCeti.SAGBI.Examples.normalizedCollisionFamily`), which generates the same algebra. Now the
relations `U - W` and `V - W` evaluate to `-y/2` and `y/2`. Their leading exponent is below that
of `x`, but the only products of the `c i` with exponent below that of `x` are the constants, so
neither value has a bounded zero subduction. The SAGBI criterion
`MonomialOrder.isSAGBIBasis_range_iff_forall_exists_aeval_eq` correctly rejects `c`.

**Degenerate families.** The criterion accepts the following SAGBI bases.

* `(1, x)`, with the nonzero scalar generator `1` of leading exponent `0`. The toric ideal is
  generated by the degree-zero relation `U - 1`, whose substituted value is exactly zero, so
  `Q = 0` certifies it without any inequality for the degree of the zero polynomial.
* The empty family, of the algebra `ℚ`, whose toric ideal is zero.
* The redundant monic family `(x, x + y, y)`. Its relation `U - V` evaluates to `-y`, the image of
  `-W`, of smaller exponent. The polynomial `x + y` has the two distinct expressions `V` and
  `U + W`, so expressions in a redundant SAGBI basis are not unique.

## Main results

* `TauCeti.SAGBI.Examples.isSubduction_aeval_collisionFamily_X_zero_sub_X_two` and
  `TauCeti.SAGBI.Examples.isSubduction_aeval_collisionFamily_X_one_sub_X_two`: the one-step zero
  subductions of the coefficient-one relations of `b`.
* `TauCeti.SAGBI.Examples.not_isSAGBIBasis_collisionFamily`: `b` is not a SAGBI basis.
* `TauCeti.SAGBI.Examples.not_exists_aeval_eq_normalizedCollisionFamily` and
  `TauCeti.SAGBI.Examples.not_isSAGBIBasis_normalizedCollisionFamily`: the bounded criterion
  rejects `c`.
* `TauCeti.SAGBI.Examples.isSAGBIBasis_scalarFamily`,
  `TauCeti.SAGBI.Examples.isSAGBIBasis_range_elim0` and
  `TauCeti.SAGBI.Examples.isSAGBIBasis_redundantFamily`: the criterion accepts the degenerate
  families.
* `TauCeti.SAGBI.Examples.not_injective_aeval_redundantFamily`: expressions in a redundant SAGBI
  basis are not unique.

## References

* W. Bruns, A. Conca, M. Lembo, *SAGBI combinatorics of maximal minors and a SAGBI algorithm*,
  2025, arXiv:2504.10019, Section 2.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
-/

public section

namespace TauCeti.SAGBI.Examples

open MvPolynomial MonomialOrder Finsupp

/-! ### Toric ideals of exponents of `x` and `y` -/

/-- In the quotient by an ideal, the image of a monomial is the product of the powers of the images
of the variables. -/
private theorem mk_monomial_one {ι : Type*} [Fintype ι] (I : Ideal (MvPolynomial ι ℚ))
    (u : ι →₀ ℕ) :
    Ideal.Quotient.mk I (monomial u 1) = ∏ i, Ideal.Quotient.mk I (X i) ^ u i := by
  rw [monomial_eq, C_1, one_mul, Finsupp.prod_fintype _ _ (fun _ ↦ pow_zero _), map_prod]
  simp_rw [map_pow]

/-- The monomial `X^(single i 1)` with coefficient `1` is the variable `X i`. -/
private theorem monomial_single_one {ι : Type*} (i : ι) :
    monomial (single i 1) (1 : ℚ) = X i := by
  rw [← C_mul_X_eq_monomial, C_1, one_mul]

/-- Over `ℚ`, the toric ideal of `a` lies in an ideal `I` as soon as monomials whose exponents have
the same image under `u ↦ ∑ i, u i • a i` are congruent modulo `I`. -/
private theorem toricIdeal_le {ι M : Type*} [Fintype ι] [AddCommMonoid M] {a : ι → M}
    {I : Ideal (MvPolynomial ι ℚ)}
    (h : ∀ u v : ι →₀ ℕ, linearCombination ℕ a u = linearCombination ℕ a v →
      ∏ i, Ideal.Quotient.mk I (X i) ^ u i = ∏ i, Ideal.Quotient.mk I (X i) ^ v i) :
    toricIdeal ℚ a ≤ I := by
  rw [toricIdeal_eq_span, Ideal.span_le]
  rintro _ ⟨u, v, huv, rfl⟩
  rw [SetLike.mem_coe, ← Ideal.Quotient.eq, mk_monomial_one, mk_monomial_one]
  exact h u v huv

/-- The coordinates of `∑ i, u i • a i`. -/
private theorem linearCombination_apply_apply {ι : Type*} [Fintype ι] (a : ι → Fin 2 →₀ ℕ)
    (u : ι →₀ ℕ) (s : Fin 2) :
    linearCombination ℕ a u s = ∑ i, u i * a i s := by
  rw [linearCombination_apply, Finsupp.sum_fintype _ _ (by simp), Finsupp.finsetSum_apply]
  simp

/-- `y ≺ x` for the lexicographic order. -/
private theorem single_one_lt_single_zero :
    single (1 : Fin 2) 1 ≺[lex] single 0 1 := by
  rw [lex_lt_iff]
  exact Finsupp.Lex.single_lt_iff.2 (by decide)

/-- A sum of copies of the exponent of `x` lies below the exponent of `x` only if it is empty. -/
private theorem eq_zero_of_nsmul_lt {n : ℕ} (h : n • single (0 : Fin 2) 1 ≺[lex] single 0 1) :
    n = 0 := by
  by_contra hn
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
  rw [succ_nsmul, map_add] at h
  exact h.not_ge (le_add_of_nonneg_left (lex.zero_le _))

/-- A nonzero multiple of a variable has the exponent of that variable. -/
private theorem lex_degree_C_mul_X {c : ℚ} (hc : c ≠ 0) (s : Fin 2) :
    lex.degree (C c * X s : MvPolynomial (Fin 2) ℚ) = single s 1 := by
  rw [C_mul_X_eq_monomial]
  simp [degree_monomial, hc]

/-- A multiple of `y` has exponent below that of `x`. -/
private theorem lex_degree_C_mul_X_one_lt (c : ℚ) :
    lex.degree (C c * X 1 : MvPolynomial (Fin 2) ℚ) ≺[lex] single 0 1 := by
  rw [C_mul_X_eq_monomial]
  exact (degree_monomial_le c).trans_lt single_one_lt_single_zero

/-- Adding a multiple of `y` to a nonzero multiple of `x` does not change the leading exponent. -/
private theorem lex_degree_C_mul_X_add_C_mul_X {c : ℚ} (hc : c ≠ 0) (d : ℚ) :
    lex.degree (C c * X 0 + C d * X 1 : MvPolynomial (Fin 2) ℚ) = single 0 1 := by
  rw [degree_add_of_lt (by rw [lex_degree_C_mul_X hc]; exact lex_degree_C_mul_X_one_lt d),
    lex_degree_C_mul_X hc]

/-- Adding a multiple of `y` to a nonzero multiple of `x` does not change the leading
coefficient. -/
private theorem lex_leadingCoeff_C_mul_X_add_C_mul_X {c : ℚ} (hc : c ≠ 0) (d : ℚ) :
    lex.leadingCoeff (C c * X 0 + C d * X 1 : MvPolynomial (Fin 2) ℚ) = c := by
  rw [leadingCoeff_add_of_lt (by rw [lex_degree_C_mul_X hc]; exact lex_degree_C_mul_X_one_lt d),
    C_mul_X_eq_monomial, leadingCoeff_monomial]

/-- `x + y` has the leading exponent of `x`. -/
private theorem lex_degree_X_zero_add_X_one :
    lex.degree (X 0 + X 1 : MvPolynomial (Fin 2) ℚ) = single 0 1 := by
  simpa using lex_degree_C_mul_X_add_C_mul_X one_ne_zero 1

/-! ### A leading-coefficient collision -/

/-- The family `(x, x + y, 2x + y)`, whose three leading exponents are all that of `x`. -/
noncomputable def collisionFamily : Fin 3 → MvPolynomial (Fin 2) ℚ :=
  ![X 0, X 0 + X 1, C 2 * X 0 + X 1]

theorem collisionFamily_def : collisionFamily = ![X 0, X 0 + X 1, C 2 * X 0 + X 1] :=
  (rfl)

/-- The family `collisionFamily` in the form `C (ℓ i) * x + C (d i) * y`. -/
private theorem collisionFamily_eq (i : Fin 3) :
    collisionFamily i = C (![1, 1, 2] i) * X 0 + C (![0, 1, 1] i) * X 1 := by
  fin_cases i <;> simp [collisionFamily]

/-- Every member of `collisionFamily` has the leading exponent of `x`. -/
theorem lex_degree_collisionFamily (i : Fin 3) :
    lex.degree (collisionFamily i) = single 0 1 := by
  rw [collisionFamily_eq]
  exact lex_degree_C_mul_X_add_C_mul_X (by fin_cases i <;> simp) _

/-- The leading coefficients of `collisionFamily` are `1, 1, 2`. -/
theorem lex_leadingCoeff_collisionFamily (i : Fin 3) :
    lex.leadingCoeff (collisionFamily i) = ![1, 1, 2] i := by
  rw [collisionFamily_eq]
  exact lex_leadingCoeff_C_mul_X_add_C_mul_X (by fin_cases i <;> simp) _

/-- No member of `collisionFamily` vanishes. -/
theorem collisionFamily_ne_zero (i : Fin 3) : collisionFamily i ≠ 0 := by
  rw [← lex.leadingCoeff_ne_zero_iff, lex_leadingCoeff_collisionFamily]
  fin_cases i <;> simp

/-- The coefficient-one relation `U - W` among the leading terms becomes `-(x + y)`. -/
theorem aeval_collisionFamily_X_zero_sub_X_two :
    aeval collisionFamily (X 0 - X 2 : MvPolynomial (Fin 3) ℚ) = -(X 0 + X 1) := by
  simp [collisionFamily, map_ofNat C 2]
  ring

/-- The coefficient-one relation `V - W` among the leading terms becomes `-x`. -/
theorem aeval_collisionFamily_X_one_sub_X_two :
    aeval collisionFamily (X 1 - X 2 : MvPolynomial (Fin 3) ℚ) = -X 0 := by
  simp [collisionFamily, map_ofNat C 2]
  ring

/-- The substituted relation `-(x + y)` subducts to zero in one step, against `-V`. -/
theorem isSubduction_aeval_collisionFamily_X_zero_sub_X_two :
    lex.IsSubduction collisionFamily (aeval collisionFamily (X 0 - X 2 : MvPolynomial (Fin 3) ℚ))
      (-X 1) 0 where
  eq_aeval_add := by
    rw [aeval_collisionFamily_X_zero_sub_X_two]
    simp [collisionFamily]
  support_le u hu := by
    rw [MvPolynomial.support_neg, support_X, Finset.mem_singleton] at hu
    subst hu
    rw [linearCombination_single, one_smul, Function.comp_apply, lex_degree_collisionFamily,
      aeval_collisionFamily_X_zero_sub_X_two, degree_neg, lex_degree_X_zero_add_X_one]
  irreducible := by simp
  degree_le := by simp

/-- The substituted relation `-x` subducts to zero in one step, against `-U`. -/
theorem isSubduction_aeval_collisionFamily_X_one_sub_X_two :
    lex.IsSubduction collisionFamily (aeval collisionFamily (X 1 - X 2 : MvPolynomial (Fin 3) ℚ))
      (-X 0) 0 where
  eq_aeval_add := by
    rw [aeval_collisionFamily_X_one_sub_X_two]
    simp [collisionFamily]
  support_le u hu := by
    rw [MvPolynomial.support_neg, support_X, Finset.mem_singleton] at hu
    subst hu
    rw [linearCombination_single, one_smul, Function.comp_apply, lex_degree_collisionFamily,
      aeval_collisionFamily_X_one_sub_X_two, degree_neg, degree_X]
  irreducible := by simp
  degree_le := by simp

/-- The variable `y = (x + y) - x` lies in the algebra generated by `collisionFamily`. -/
theorem X_one_mem_adjoin_range_collisionFamily :
    X 1 ∈ Algebra.adjoin ℚ (Set.range collisionFamily) := by
  have h : X 1 = collisionFamily 1 - collisionFamily 0 := by simp [collisionFamily]
  rw [h]
  exact sub_mem (Algebra.subset_adjoin ⟨1, rfl⟩) (Algebra.subset_adjoin ⟨0, rfl⟩)

/-- The variable `y` does not lie in the algebra `ℚ[x]` generated by the leading terms of
`collisionFamily`. -/
theorem X_one_notMem_adjoin_leadingTerm_collisionFamily :
    X 1 ∉ Algebra.adjoin ℚ (lex.leadingTerm '' Set.range collisionFamily) := by
  rw [← monomial_single_one, monomial_one_mem_adjoin_leadingTerm_iff]
  intro h
  have hle : AddSubmonoid.closure (lex.degree '' (Set.range collisionFamily \ {0})) ≤
      AddSubmonoid.closure {single 0 1} := by
    refine AddSubmonoid.closure_mono ?_
    rintro _ ⟨_, ⟨⟨i, rfl⟩, -⟩, rfl⟩
    exact lex_degree_collisionFamily i
  obtain ⟨n, hn⟩ := AddSubmonoid.mem_closure_singleton.1 (hle h)
  simpa using DFunLike.congr_fun hn 1

/-- **The collision family is not a SAGBI basis**, although its coefficient-one relations
subduct to zero. -/
theorem not_isSAGBIBasis_collisionFamily :
    ¬ lex.IsSAGBIBasis (Set.range collisionFamily)
      (Algebra.adjoin ℚ (Set.range collisionFamily)) := by
  intro h
  apply X_one_notMem_adjoin_leadingTerm_collisionFamily
  rw [h.adjoin_leadingTerm, ← lex.leadingTerm_X]
  exact lex.leadingTerm_mem_initialAlgebra X_one_mem_adjoin_range_collisionFamily

/-! ### The normalized collision family is rejected by the criterion -/

/-- The monic normalization `(x, x + y, x + y/2)` of `collisionFamily`. -/
noncomputable def normalizedCollisionFamily : Fin 3 → MvPolynomial (Fin 2) ℚ :=
  ![X 0, X 0 + X 1, X 0 + C (1 / 2) * X 1]

theorem normalizedCollisionFamily_def :
    normalizedCollisionFamily = ![X 0, X 0 + X 1, X 0 + C (1 / 2) * X 1] :=
  (rfl)

/-- `normalizedCollisionFamily` is the monic normalization of `collisionFamily`. -/
theorem monicNormalize_collisionFamily (i : Fin 3) :
    lex.monicNormalize (collisionFamily i) = normalizedCollisionFamily i := by
  rw [monicNormalize_def, lex_leadingCoeff_collisionFamily]
  fin_cases i
  · simp [collisionFamily, normalizedCollisionFamily]
  · simp [collisionFamily, normalizedCollisionFamily]
  · simp [collisionFamily, normalizedCollisionFamily, mul_add, ← mul_assoc, ← C_mul]

/-- The normalized family generates the same algebra as `collisionFamily`. -/
theorem adjoin_range_normalizedCollisionFamily :
    Algebra.adjoin ℚ (Set.range normalizedCollisionFamily) =
      Algebra.adjoin ℚ (Set.range collisionFamily) := by
  rw [← funext monicNormalize_collisionFamily, Set.range_comp', adjoin_image_monicNormalize]

/-- Every member of `normalizedCollisionFamily` is monic. -/
theorem monic_normalizedCollisionFamily (i : Fin 3) : lex.Monic (normalizedCollisionFamily i) := by
  rw [← monicNormalize_collisionFamily]
  exact monic_monicNormalize (collisionFamily_ne_zero i)

/-- Every member of `normalizedCollisionFamily` has the leading exponent of `x`. -/
theorem lex_degree_normalizedCollisionFamily (i : Fin 3) :
    lex.degree (normalizedCollisionFamily i) = single 0 1 := by
  rw [← monicNormalize_collisionFamily, degree_monicNormalize, lex_degree_collisionFamily]

/-- The relation `U - W` among the leading terms becomes `-y/2`. -/
theorem aeval_normalizedCollisionFamily_X_zero_sub_X_two :
    aeval normalizedCollisionFamily (X 0 - X 2 : MvPolynomial (Fin 3) ℚ) = -(C (1 / 2) * X 1) := by
  simp [normalizedCollisionFamily]

/-- The relation `V - W` among the leading terms becomes `y/2`. -/
theorem aeval_normalizedCollisionFamily_X_one_sub_X_two :
    aeval normalizedCollisionFamily (X 1 - X 2 : MvPolynomial (Fin 3) ℚ) = C (1 / 2) * X 1 := by
  simp only [map_sub, aeval_X, normalizedCollisionFamily, Matrix.cons_val_one,
    Matrix.cons_val_zero, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
  have h : (C (1 / 2) + C (1 / 2) : MvPolynomial (Fin 2) ℚ) = 1 := by
    rw [← C_add]
    norm_num
  linear_combination (-X 1) * h

/-- The toric ideal of the leading exponents of `normalizedCollisionFamily`, all equal to that of
`x`, is generated by the binomials `U - W` and `V - W`. -/
theorem toricIdeal_lex_degree_normalizedCollisionFamily :
    toricIdeal ℚ (fun i ↦ lex.degree (normalizedCollisionFamily i)) =
      Ideal.span (Set.range fun j : Fin 2 ↦
        monomial (![single 0 1, single 1 1] j) (1 : ℚ) - monomial (single 2 1) 1) := by
  simp_rw [lex_degree_normalizedCollisionFamily]
  obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial (Fin 3) ℚ), I = Ideal.span (Set.range fun j : Fin 2 ↦
      monomial (![single 0 1, single 1 1] j) (1 : ℚ) - monomial (single 2 1) 1) := ⟨_, rfl⟩
  rw [← hI]
  refine le_antisymm (toricIdeal_le fun u v huv ↦ ?_) (hI ▸ Ideal.span_le.2 ?_)
  · have h0 : Ideal.Quotient.mk I (X 0) = Ideal.Quotient.mk I (X 2) :=
      Ideal.Quotient.eq.2 (hI ▸ Ideal.subset_span ⟨0, by simp [monomial_single_one]⟩)
    have h1 : Ideal.Quotient.mk I (X 1) = Ideal.Quotient.mk I (X 2) :=
      Ideal.Quotient.eq.2 (hI ▸ Ideal.subset_span ⟨1, by simp [monomial_single_one]⟩)
    have hsum : u 0 + u 1 + u 2 = v 0 + v 1 + v 2 := by
      simpa [linearCombination_apply_apply, Fin.sum_univ_three] using DFunLike.congr_fun huv 0
    rw [Fin.prod_univ_three, Fin.prod_univ_three, h0, h1, ← pow_add, ← pow_add, ← pow_add,
      ← pow_add, hsum]
  · rintro _ ⟨j, rfl⟩
    refine monomial_sub_monomial_mem_toricIdeal ?_
    fin_cases j <;> simp

/-- A polynomial in the variables `U, V, W` all of whose exponents `w` have
`A w = ∑ i, w i • lex.degree (normalizedCollisionFamily i)` below the exponent of `x` is a
constant: the only products of the normalized family below `x` are the empty products. -/
private theorem eq_C_of_forall_linearCombination_lt {Q : MvPolynomial (Fin 3) ℚ}
    (hQ : ∀ w ∈ Q.support,
      linearCombination ℕ (fun i ↦ lex.degree (normalizedCollisionFamily i)) w ≺[lex]
        single 0 1) :
    Q = C (Q.coeff 0) := by
  have h0 (w : Fin 3 →₀ ℕ) (hw : w ∈ Q.support) : w = 0 := by
    have hw' := hQ w hw
    have hA : linearCombination ℕ (fun i ↦ lex.degree (normalizedCollisionFamily i)) w =
        (w 0 + w 1 + w 2) • single 0 1 := by
      ext s
      fin_cases s <;>
        simp [linearCombination_apply_apply, lex_degree_normalizedCollisionFamily,
          Fin.sum_univ_three]
    rw [hA] at hw'
    have := eq_zero_of_nsmul_lt hw'
    ext i
    fin_cases i <;> simp <;> omega
  ext w
  rw [coeff_C]
  split_ifs with hw
  · rw [hw]
  · by_contra hne
    exact Ne.symm hw (h0 w (MvPolynomial.mem_support_iff.2 hne))

/-- **The bounded criterion rejects the normalized family.** Neither `-y/2` nor `y/2`, the values of
the relations `U - W` and `V - W`, is the image of a polynomial all of whose exponents `w` have
`A w` below the common exponent `A(U) = A(V)` of `x`. -/
theorem not_exists_aeval_eq_normalizedCollisionFamily (j : Fin 2) :
    ¬ ∃ Q : MvPolynomial (Fin 3) ℚ,
      aeval normalizedCollisionFamily Q = aeval normalizedCollisionFamily
        (monomial (![single 0 1, single 1 1] j) (1 : ℚ) - monomial (single 2 1) 1) ∧
      ∀ w ∈ Q.support,
        linearCombination ℕ (fun i ↦ lex.degree (normalizedCollisionFamily i)) w ≺[lex]
          linearCombination ℕ (fun i ↦ lex.degree (normalizedCollisionFamily i))
            (![single 0 1, single 1 1] j) := by
  rintro ⟨Q, hQ, hlt⟩
  have hA : linearCombination ℕ (fun i ↦ lex.degree (normalizedCollisionFamily i))
      (![single 0 1, single 1 1] j) = single 0 1 := by
    fin_cases j <;> simp [lex_degree_normalizedCollisionFamily]
  rw [hA] at hlt
  rw [eq_C_of_forall_linearCombination_lt hlt, aeval_C] at hQ
  have h0 : (0 : Fin 2 →₀ ℕ) ≠ single 1 1 := (single_ne_zero.2 one_ne_zero).symm
  -- Compare the coefficients of `y`: that of the constant vanishes, that of `∓y/2` does not.
  fin_cases j
  · simp only [Fin.zero_eta, Matrix.cons_val_zero, monomial_single_one,
      aeval_normalizedCollisionFamily_X_zero_sub_X_two] at hQ
    simpa [coeff_C, h0] using congr_arg (fun p : MvPolynomial (Fin 2) ℚ ↦ p.coeff (single 1 1)) hQ
  · simp only [Fin.mk_one, Matrix.cons_val_one, Matrix.cons_val_zero, monomial_single_one,
      aeval_normalizedCollisionFamily_X_one_sub_X_two] at hQ
    simpa [coeff_C, h0] using congr_arg (fun p : MvPolynomial (Fin 2) ℚ ↦ p.coeff (single 1 1)) hQ

/-- **The normalized collision family is not a SAGBI basis**, as detected by the SAGBI
criterion. -/
theorem not_isSAGBIBasis_normalizedCollisionFamily :
    ¬ lex.IsSAGBIBasis (Set.range normalizedCollisionFamily)
      (Algebra.adjoin ℚ (Set.range normalizedCollisionFamily)) := by
  rw [isSAGBIBasis_range_iff_forall_exists_aeval_eq monic_normalizedCollisionFamily
    toricIdeal_lex_degree_normalizedCollisionFamily]
  exact fun h ↦ not_exists_aeval_eq_normalizedCollisionFamily 0 (h 0)

/-! ### A nonzero scalar generator and an exactly vanishing relation -/

/-- The family `(1, x)`, with the scalar generator `1` of leading exponent `0`. -/
noncomputable def scalarFamily : Fin 2 → MvPolynomial (Fin 2) ℚ :=
  ![1, X 0]

theorem scalarFamily_def : scalarFamily = ![1, X 0] :=
  (rfl)

/-- Both members of `scalarFamily` are monic. -/
theorem monic_scalarFamily (i : Fin 2) : lex.Monic (scalarFamily i) := by
  fin_cases i
  · exact monic_one
  · exact monic_X

/-- The toric ideal of the leading exponents `0` and that of `x` of `scalarFamily` is generated by
the degree-zero relation `U - 1`. -/
theorem toricIdeal_lex_degree_scalarFamily :
    toricIdeal ℚ (fun i ↦ lex.degree (scalarFamily i)) =
      Ideal.span (Set.range fun _ : Fin 1 ↦ monomial (single 0 1) (1 : ℚ) - monomial 0 1) := by
  have hdeg : (fun i ↦ lex.degree (scalarFamily i)) = ![0, single 0 1] := by
    ext i : 1
    fin_cases i <;> simp [scalarFamily, degree_X]
  rw [hdeg]
  obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial (Fin 2) ℚ),
      I = Ideal.span (Set.range fun _ : Fin 1 ↦ monomial (single 0 1) (1 : ℚ) - monomial 0 1) :=
    ⟨_, rfl⟩
  rw [← hI]
  refine le_antisymm (toricIdeal_le fun u v huv ↦ ?_) (hI ▸ Ideal.span_le.2 ?_)
  · have h0 : Ideal.Quotient.mk I (X 0) = 1 := by
      rw [← map_one (Ideal.Quotient.mk I)]
      exact Ideal.Quotient.eq.2 (hI ▸ Ideal.subset_span ⟨0, by simp [monomial_single_one]⟩)
    have hsum : u 1 = v 1 := by
      simpa [linearCombination_apply_apply] using DFunLike.congr_fun huv 0
    rw [Fin.prod_univ_two, Fin.prod_univ_two, h0, one_pow, one_pow, hsum]
  · rintro _ ⟨j, rfl⟩
    exact monomial_sub_monomial_mem_toricIdeal (by simp)

/-- The relation `U - 1` becomes exactly zero after substituting `scalarFamily`. -/
theorem aeval_scalarFamily_monomial_sub_one :
    aeval scalarFamily (monomial (single 0 1) (1 : ℚ) - monomial 0 1) = 0 := by
  simp [scalarFamily, monomial_single_one]

/-- **The family `(1, x)` is a SAGBI basis**, certified by the empty expression `Q = 0` for its
exactly vanishing relation. -/
theorem isSAGBIBasis_scalarFamily :
    lex.IsSAGBIBasis (Set.range scalarFamily) (Algebra.adjoin ℚ (Set.range scalarFamily)) := by
  rw [isSAGBIBasis_range_iff_forall_exists_aeval_eq monic_scalarFamily
    toricIdeal_lex_degree_scalarFamily]
  exact fun _ ↦ ⟨0, by rw [map_zero, aeval_scalarFamily_monomial_sub_one], by simp⟩

/-! ### The empty family -/

/-- **The empty family is a SAGBI basis** of the algebra `ℚ` it generates; its toric ideal is
zero, so the criterion has no relation to check. -/
theorem isSAGBIBasis_range_elim0 :
    lex.IsSAGBIBasis (Set.range (Fin.elim0 : Fin 0 → MvPolynomial (Fin 2) ℚ)) ⊥ := by
  have htoric : toricIdeal ℚ (fun i : Fin 0 ↦ lex.degree (Fin.elim0 i : MvPolynomial (Fin 2) ℚ)) =
      Ideal.span (Set.range fun j : Fin 0 ↦
        monomial (Fin.elim0 j : Fin 0 →₀ ℕ) (1 : ℚ) - monomial (Fin.elim0 j) 1) := by
    rw [Set.range_eq_empty, Ideal.span_empty, toricIdeal_eq_span, Ideal.span_eq_bot]
    rintro _ ⟨u, v, -, rfl⟩
    rw [Subsingleton.elim u v, sub_self]
  have h := (isSAGBIBasis_range_iff_forall_exists_aeval_eq (fun i ↦ i.elim0) htoric).2
    fun j ↦ j.elim0
  have hadj : Algebra.adjoin ℚ (Set.range (Fin.elim0 : Fin 0 → MvPolynomial (Fin 2) ℚ)) = ⊥ := by
    rw [Set.range_eq_empty, Algebra.adjoin_empty]
  rwa [hadj] at h

/-! ### Redundant monic generators -/

/-- The redundant monic family `(x, x + y, y)`. -/
noncomputable def redundantFamily : Fin 3 → MvPolynomial (Fin 2) ℚ :=
  ![X 0, X 0 + X 1, X 1]

theorem redundantFamily_def : redundantFamily = ![X 0, X 0 + X 1, X 1] :=
  (rfl)

/-- The leading exponents of `redundantFamily` are those of `x`, `x` and `y`. -/
theorem lex_degree_redundantFamily (i : Fin 3) :
    lex.degree (redundantFamily i) = ![single 0 1, single 0 1, single 1 1] i := by
  fin_cases i
  · exact degree_X
  · exact lex_degree_X_zero_add_X_one
  · exact degree_X

/-- Every member of `redundantFamily` is monic. -/
theorem monic_redundantFamily (i : Fin 3) : lex.Monic (redundantFamily i) := by
  fin_cases i
  · exact monic_X
  · exact monic_X.add_of_lt (by rw [degree_X, degree_X]; exact single_one_lt_single_zero)
  · exact monic_X

/-- The toric ideal of the leading exponents of `redundantFamily` is generated by `U - V`. -/
theorem toricIdeal_lex_degree_redundantFamily :
    toricIdeal ℚ (fun i ↦ lex.degree (redundantFamily i)) =
      Ideal.span (Set.range fun _ : Fin 1 ↦
        monomial (single 0 1) (1 : ℚ) - monomial (single 1 1) 1) := by
  simp_rw [lex_degree_redundantFamily]
  obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial (Fin 3) ℚ), I = Ideal.span (Set.range fun _ : Fin 1 ↦
      monomial (single 0 1) (1 : ℚ) - monomial (single 1 1) 1) := ⟨_, rfl⟩
  rw [← hI]
  refine le_antisymm (toricIdeal_le fun u v huv ↦ ?_) (hI ▸ Ideal.span_le.2 ?_)
  · have h0 : Ideal.Quotient.mk I (X 0) = Ideal.Quotient.mk I (X 1) :=
      Ideal.Quotient.eq.2 (hI ▸ Ideal.subset_span ⟨0, by simp [monomial_single_one]⟩)
    have hx : u 0 + u 1 = v 0 + v 1 := by
      simpa [linearCombination_apply_apply, Fin.sum_univ_three] using DFunLike.congr_fun huv 0
    have hy : u 2 = v 2 := by
      simpa [linearCombination_apply_apply, Fin.sum_univ_three] using DFunLike.congr_fun huv 1
    rw [Fin.prod_univ_three, Fin.prod_univ_three, h0, ← pow_add, ← pow_add, hx, hy]
  · rintro _ ⟨j, rfl⟩
    exact monomial_sub_monomial_mem_toricIdeal (by simp)

/-- The relation `U - V` becomes `-y`, the image of `-W`, whose exponent lies below that of `x`. -/
theorem aeval_redundantFamily_monomial_sub_monomial :
    aeval redundantFamily
        (monomial (single 0 1) (1 : ℚ) - monomial (single 1 1) 1 : MvPolynomial (Fin 3) ℚ) =
      aeval redundantFamily (-X 2 : MvPolynomial (Fin 3) ℚ) := by
  simp [redundantFamily, monomial_single_one]

/-- **The redundant family `(x, x + y, y)` is a SAGBI basis**, certified by the expression `-W`. -/
theorem isSAGBIBasis_redundantFamily :
    lex.IsSAGBIBasis (Set.range redundantFamily)
      (Algebra.adjoin ℚ (Set.range redundantFamily)) := by
  rw [isSAGBIBasis_range_iff_forall_exists_aeval_eq monic_redundantFamily
    toricIdeal_lex_degree_redundantFamily]
  refine fun _ ↦ ⟨-X 2, aeval_redundantFamily_monomial_sub_monomial.symm, fun w hw ↦ ?_⟩
  rw [MvPolynomial.support_neg, support_X, Finset.mem_singleton] at hw
  subst hw
  simpa [lex_degree_redundantFamily] using single_one_lt_single_zero

/-- Expressions in the redundant SAGBI basis `(x, x + y, y)` are not unique: the polynomial `x + y`
is the image of both `V` and `U + W`. -/
theorem not_injective_aeval_redundantFamily :
    ¬ Function.Injective (aeval redundantFamily : MvPolynomial (Fin 3) ℚ →ₐ[ℚ] _) := by
  intro h
  have hVUW : (X 1 : MvPolynomial (Fin 3) ℚ) = X 0 + X 2 := h (by simp [redundantFamily])
  simpa [coeff_X, Finsupp.single_left_inj one_ne_zero] using
    congr_arg (fun p : MvPolynomial (Fin 3) ℚ ↦ p.coeff (single 1 1)) hVUW

end TauCeti.SAGBI.Examples
