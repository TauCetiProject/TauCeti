module

public import TauCeti.Combinatorics.Young.Rect
public import TauCeti.RingTheory.MvPolynomial.Symmetric.Schur.Basis
public import TauCeti.RingTheory.MvPolynomial.Symmetric.Schur.JacobiTrudi
public import TauCeti.RingTheory.MvPolynomial.Symmetric.Schur.Pieri
import TauCeti.RingTheory.MvPolynomial.Symmetric.Complete.Elementary

/-!
# The rectangular Schur basis of the symmetric polynomials modulo `h_{m+1}, …, h_{m+n}`

Let `R` be a commutative ring and `Λₙ = R[x₁, …, xₙ]^{Sₙ}` the symmetric polynomials in `n`
variables. The quotient

```text
Λₙ ⧸ (h_{m+1}, …, h_{m+n})
```

by the complete homogeneous symmetric polynomials of degrees `m + 1, …, m + n` is the classical
presentation of the cohomology ring, with coefficients in `R`, of the Grassmannian of `n`-planes in
`ℂ^{n+m}`. This file proves that it is a free `R`-module whose basis is the classes of the Schur
polynomials `s_μ` of the Young diagrams `μ` contained in the `n × m` rectangle. No geometry is
involved: the statement and the proof are about symmetric polynomials over an arbitrary
commutative ring.

The argument identifies the ideal with an explicit span. Writing `J` for the `R`-span of the
Schur polynomials `s_ν` whose first row is longer than `m`:

* `J` contains the ideal: by the Pieri rule `TauCeti.hsymm_mul_diagramSchurPoly`, `h_k · s_μ` is a
  sum of `s_ν` over horizontal strips `ν / μ` of size `k`, and such a strip forces `ν₀ ≥ k`
  (`YoungDiagram.InterlacedBy.card_le_card_add_rowLen_zero`). Every symmetric polynomial is an
  `R`-combination of Schur polynomials (`TauCeti.span_symmetricDiagramSchurPoly_eq_top`), so
  every multiple of `h_k` with `k > m` lies in `J`.
* the ideal contains `J`: the relation `∑ᵢ (-1)ⁱ eᵢ h_{k-i} = 0` and the vanishing of `eᵢ` for
  `i > n` put every `h_k` with `k > m` in the ideal
  (`TauCeti.symmetricHsymm_mem_grassmannianIdeal`), and expanding the Jacobi–Trudi determinant
  `s_ν = det (h_{νᵢ - i + j})` along its first row writes `s_ν` as a combination of such `h_k`
  whenever `ν₀ > m` (`TauCeti.symmetricDiagramSchurPoly_mem_grassmannianIdeal`).

Since the Schur polynomials of the diagrams with at most `n` rows are linearly independent
(`TauCeti.linearIndependent_diagramSchurPoly`), the rectangular ones are independent modulo `J`
and span modulo it.

## Main definitions

* `TauCeti.grassmannianIdeal n m R`: the ideal of `Λₙ` generated by `h_{m+1}, …, h_{m+n}`.
* `TauCeti.grassmannianSchurBasis n m R`: the basis of `Λₙ ⧸ grassmannianIdeal n m R` given by
  the classes of the Schur polynomials of the diagrams in the `n × m` rectangle.

## Main results

* `TauCeti.grassmannianIdeal_le_iff`: the ideal lies in another ideal exactly when its generators
  do.
* `TauCeti.symmetricHsymm_mem_grassmannianIdeal`: `h_k` lies in the ideal for every `k > m`.
* `TauCeti.symmetricDiagramSchurPoly_mem_grassmannianIdeal`: `s_μ` lies in the ideal when
  `μ₀ > m`.
* `TauCeti.mem_grassmannianIdeal_iff`: the ideal is exactly the `R`-span of the Schur polynomials
  whose first row is longer than `m`.
* `TauCeti.grassmannianSchurBasis_apply`: the basis vectors are the classes of the Schur
  polynomials.

## References

* W. Fulton, *Young Tableaux*, Cambridge University Press, 1997, §9.4 (the presentation of the
  cohomology of the Grassmannian and its Schur basis).
* [I. G. Macdonald, *Symmetric Functions and Hall Polynomials*][macdonald1995], Chapter I,
  (3.4) (the Jacobi–Trudi identity) and (5.16) (the Pieri rule).
-/

public section

open MvPolynomial Finset

namespace TauCeti

variable (n m : ℕ) (R : Type*) [CommRing R]

/-- The ideal `(h_{m+1}, …, h_{m+n})` of the symmetric polynomials in `n` variables generated by
the complete homogeneous symmetric polynomials of degrees `m + 1` to `m + n`. Its quotient is the
classical presentation of the cohomology ring of the Grassmannian of `n`-planes in `ℂ^{n+m}`;
`TauCeti.symmetricHsymm_mem_grassmannianIdeal` shows that it contains every
`h_k` with `k > m`. -/
noncomputable def grassmannianIdeal : Ideal (symmetricSubalgebra (Fin n) R) :=
  Ideal.span (Set.range fun j : Fin n => symmetricHsymm (Fin n) R (m + j + 1))

/-- The ideal `TauCeti.grassmannianIdeal n m R` is generated by `h_{m+1}, …, h_{m+n}`. -/
theorem grassmannianIdeal_eq_span :
    grassmannianIdeal n m R =
      Ideal.span (Set.range fun j : Fin n => symmetricHsymm (Fin n) R (m + j + 1)) :=
  (rfl)

variable {n m R}

/-! ### The ideal -/

/-- The ideal `(h_{m+1}, …, h_{m+n})` lies in an ideal `I` exactly when its generators
`h_{m+1}, …, h_{m+n}` do. -/
theorem grassmannianIdeal_le_iff {I : Ideal (symmetricSubalgebra (Fin n) R)} :
    grassmannianIdeal n m R ≤ I ↔ ∀ j : Fin n, symmetricHsymm (Fin n) R (m + j + 1) ∈ I := by
  rw [grassmannianIdeal_eq_span, Ideal.span_le, Set.range_subset_iff]
  simp only [SetLike.mem_coe]

/-- **The ideal contains every `h_k` with `k > m`**, not just its generators
`h_{m+1}, …, h_{m+n}`: by the relation `∑ᵢ (-1)ⁱ eᵢ h_{k-i} = 0` and the vanishing of `eᵢ` for
`i > n`, each `h_k` with `k > m + n` is a combination of `h_{k-1}, …, h_{k-n}`. -/
theorem symmetricHsymm_mem_grassmannianIdeal {k : ℕ} (hk : m < k) :
    symmetricHsymm (Fin n) R k ∈ grassmannianIdeal n m R := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
  by_cases hkn : k ≤ m + n
  · exact Ideal.subset_span ⟨⟨k - m - 1, by omega⟩,
      congrArg (symmetricHsymm (Fin n) R) (by simp only; omega)⟩
  -- Past the generators, `h_k = -∑_{r<k} h_r (-1)^{k-r} e_{k-r}`, and every term has `m < r` or
  -- `n < k - r`, where `e_{k-r} = 0`.
  have hsum := sum_range_hsymm_mul_neg_one_pow_mul_esymm (σ := Fin n) R k
  have hk0 : k ≠ 0 := by omega
  simp only [sum_range_succ, hk0, ↓reduceIte, Nat.sub_self, pow_zero, esymm_zero,
    mul_one] at hsum
  have key : symmetricHsymm (Fin n) R k =
      -∑ r ∈ range k, symmetricHsymm (Fin n) R r *
        ((-1) ^ (k - r) * symmetricEsymm (Fin n) R (k - r)) :=
    Subtype.ext (by simpa [eq_neg_iff_add_eq_zero, add_comm] using hsum)
  rw [key]
  refine neg_mem (sum_mem fun r hr => ?_)
  by_cases hmr : m < r
  · exact Ideal.mul_mem_right _ _ (ih r (mem_range.mp hr) hmr)
  · simp [symmetricEsymm_eq_zero_of_lt (by simp; omega : Fintype.card (Fin n) < k - r)]

/-- **A Schur polynomial whose first row is longer than `m` lies in the ideal**: expanding the
Jacobi–Trudi determinant `s_μ = det (h_{μᵢ - i + j})` along its first row writes `s_μ` as a
combination of `h_{μ₀ + j}`, `j ≥ 0`, each of which lies in the ideal by
`TauCeti.symmetricHsymm_mem_grassmannianIdeal`. -/
theorem symmetricDiagramSchurPoly_mem_grassmannianIdeal {μ : YoungDiagram}
    (hμ : m < μ.rowLen 0) : symmetricDiagramSchurPoly n R μ ∈ grassmannianIdeal n m R := by
  obtain ⟨r, hr⟩ : ∃ r, μ.colLen 0 = r + 1 :=
    Nat.exists_eq_succ_of_ne_zero (YoungDiagram.lt_colLen_zero_of_mem
      (YoungDiagram.mem_iff_lt_rowLen.mpr (by omega : 0 < μ.rowLen 0))).ne'
  -- The Jacobi–Trudi matrix, with entries in the symmetric subalgebra.
  let A : Matrix (Fin (r + 1)) (Fin (r + 1)) (symmetricSubalgebra (Fin n) R) :=
    Matrix.of fun i j => ⟨hsymmInt (Fin n) R ((μ.rowLen i : ℤ) - (i : ℕ) + (j : ℕ)),
      hsymmInt_isSymmetric _⟩
  have hA : symmetricDiagramSchurPoly n R μ = A.det := by
    have hmap : (symmetricSubalgebra (Fin n) R).val.mapMatrix A = Matrix.of fun i j :
        Fin (r + 1) => hsymmInt (Fin n) R ((μ.rowLen i : ℤ) - (i : ℕ) + (j : ℕ)) := by
      ext i j
      simp [A]
    refine Subtype.ext ((coe_symmetricDiagramSchurPoly n μ).trans
      ((diagramSchurPoly_eq_det_hsymmInt n μ hr.le).trans ?_))
    rw [← hmap, ← AlgHom.map_det]
    simp
  rw [hA, Matrix.det_succ_row_zero]
  refine sum_mem fun j _ => Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ ?_)
  have hA0 : A 0 j = symmetricHsymm (Fin n) R (μ.rowLen 0 + j) :=
    Subtype.ext (by simp [A, ← hsymmInt_natCast])
  rw [hA0]
  exact symmetricHsymm_mem_grassmannianIdeal (by omega)

/-- **The ideal is the span of the Schur polynomials too wide for the rectangle**: a symmetric
polynomial lies in `(h_{m+1}, …, h_{m+n})` exactly when it is an `R`-linear combination of Schur
polynomials `s_ν` whose first row is longer than `m`. -/
theorem mem_grassmannianIdeal_iff {x : symmetricSubalgebra (Fin n) R} :
    x ∈ grassmannianIdeal n m R ↔ (x : MvPolynomial (Fin n) R) ∈
      Submodule.span R (diagramSchurPoly n R '' {ν | m < ν.rowLen 0}) := by
  set J := Submodule.span R (diagramSchurPoly n R '' {ν | m < ν.rowLen 0})
  classical
  constructor
  · -- By the Pieri rule, `s_μ h_k` is a sum of `s_ν` with `ν₀ ≥ k`.
    have hpieri (k : ℕ) (hk : m < k) (μ : YoungDiagram) :
        diagramSchurPoly n R μ * hsymm (Fin n) R k ∈ J := by
      rw [mul_comm, hsymm_mul_diagramSchurPoly]
      refine sum_mem fun ν hν => Submodule.subset_span ⟨_, ?_, rfl⟩
      have h := (mem_filter.mp hν).2.card_le_card_add_rowLen_zero
      rw [YoungDiagram.card_ofPartition] at h
      exact hk.trans_le (by simpa using h)
    -- Every symmetric polynomial is a combination of Schur polynomials.
    have hgen (k : ℕ) (hk : m < k) (y : symmetricSubalgebra (Fin n) R) :
        (y : MvPolynomial (Fin n) R) * hsymm (Fin n) R k ∈ J :=
      map_mem_of_forall_symmetricDiagramSchurPoly ((LinearMap.mulRight R (hsymm (Fin n) R k)).comp
        (symmetricSubalgebra (Fin n) R).val.toLinearMap) (fun μ => by simpa using hpieri k hk μ) y
    intro hx
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
    simpa using sum_mem fun j _ => hgen _ (by omega) (c j)
  · -- Conversely, every generator of `J` lies in the ideal.
    intro hx
    have hJ : J ≤ Submodule.map (symmetricSubalgebra (Fin n) R).val.toLinearMap
        ((grassmannianIdeal n m R).restrictScalars R) := by
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨ν, hν, rfl⟩
      exact ⟨_, symmetricDiagramSchurPoly_mem_grassmannianIdeal hν,
        coe_symmetricDiagramSchurPoly n ν⟩
    obtain ⟨y, hy, hyx⟩ := hJ hx
    rwa [Subtype.ext hyx] at hy

/-! ### The rectangular Schur basis -/

/-- The classes of the rectangular Schur polynomials are linearly independent modulo the ideal. -/
private theorem linearIndependent_mk_diagramSchurPoly :
    LinearIndependent R fun μ : {μ : YoungDiagram // μ ≤ YoungDiagram.rect n m} =>
      Ideal.Quotient.mkₐ R (grassmannianIdeal n m R) (symmetricDiagramSchurPoly n R μ) := by
  set F := fun μ : {μ : YoungDiagram // μ.colLen 0 ≤ n} => diagramSchurPoly n R μ
  let ι : {μ : YoungDiagram // μ ≤ YoungDiagram.rect n m} → {μ : YoungDiagram // μ.colLen 0 ≤ n} :=
    fun μ => ⟨μ, (YoungDiagram.le_rect_iff.mp μ.property).1⟩
  have hι : Function.Injective ι := fun μ ν h => Subtype.ext (by simpa [ι] using h)
  -- The ideal meets the span of the rectangular Schur polynomials only in `0`.
  have hdisj := (linearIndependent_diagramSchurPoly (N := n) (R := R)).disjoint_span_image
    (s := Set.range ι) (t := {ν | m < ν.val.rowLen 0}) (Set.disjoint_left.mpr <| by
      rintro _ ⟨μ, rfl⟩ h
      exact (YoungDiagram.le_rect_iff.mp μ.property).2.not_gt h)
  have hJ : Submodule.span R (diagramSchurPoly n R '' {ν | m < ν.rowLen 0}) ≤
      Submodule.span R (F '' {ν | m < ν.val.rowLen 0}) := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨ν, hν, rfl⟩
    rcases le_or_gt (ν.colLen 0) n with hn | hn
    · exact Submodule.subset_span ⟨⟨ν, hn⟩, hν, rfl⟩
    · simp [diagramSchurPoly_eq_zero_of_lt_colLen hn]
  rw [linearIndependent_iff']
  intro s g hg μ hμ
  have hmem : ∑ i ∈ s, g i • symmetricDiagramSchurPoly n R i ∈ grassmannianIdeal n m R := by
    have h : Ideal.Quotient.mkₐ R (grassmannianIdeal n m R)
        (∑ i ∈ s, g i • symmetricDiagramSchurPoly n R i) = 0 := by
      rw [map_sum]
      simpa only [map_smul] using hg
    rwa [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at h
  have hzero : ∑ i ∈ s, g i • F (ι i) = 0 := by
    refine (Submodule.disjoint_def.mp hdisj) _ ?_ (hJ ?_)
    · exact sum_mem fun i _ => Submodule.smul_mem _ _
        (Submodule.subset_span ⟨ι i, ⟨i, rfl⟩, rfl⟩)
    · simpa [F, ι] using mem_grassmannianIdeal_iff.mp hmem
  exact linearIndependent_iff'.mp (linearIndependent_diagramSchurPoly.comp ι hι) s g hzero μ hμ

/-- The classes of the rectangular Schur polynomials span the quotient. -/
private theorem top_le_span_mk_diagramSchurPoly :
    ⊤ ≤ Submodule.span R (Set.range fun μ : {μ : YoungDiagram // μ ≤ YoungDiagram.rect n m} =>
      Ideal.Quotient.mkₐ R (grassmannianIdeal n m R) (symmetricDiagramSchurPoly n R μ)) := by
  set T := Submodule.span R (Set.range fun μ : {μ : YoungDiagram // μ ≤ YoungDiagram.rect n m} =>
    Ideal.Quotient.mkₐ R (grassmannianIdeal n m R) (symmetricDiagramSchurPoly n R μ))
  -- The class of every Schur polynomial is a basis vector or zero.
  have hgen (μ : YoungDiagram) :
      Ideal.Quotient.mkₐ R (grassmannianIdeal n m R) (symmetricDiagramSchurPoly n R μ) ∈ T := by
    by_cases hrect : μ ≤ YoungDiagram.rect n m
    · exact Submodule.subset_span ⟨⟨μ, hrect⟩, rfl⟩
    rw [YoungDiagram.le_rect_iff, not_and_or, not_le, not_le] at hrect
    rcases hrect with hn | hm
    · simp [symmetricDiagramSchurPoly_eq_zero_of_lt_colLen hn]
    · rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem.mpr
        (symmetricDiagramSchurPoly_mem_grassmannianIdeal hm)]
      exact T.zero_mem
  -- Every symmetric polynomial is a combination of Schur polynomials.
  rintro x -
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mkₐ_surjective R _ x
  exact map_mem_of_forall_symmetricDiagramSchurPoly
    (Ideal.Quotient.mkₐ R (grassmannianIdeal n m R)).toLinearMap hgen y

variable (n m R) in
/-- **The rectangular Schur basis**: the quotient `Λₙ ⧸ (h_{m+1}, …, h_{m+n})` of the symmetric
polynomials in `n` variables over a commutative ring `R` is a free `R`-module, with basis the
classes of the Schur polynomials `s_μ` of the Young diagrams `μ` in the `n × m` rectangle
(`TauCeti.grassmannianSchurBasis_apply`). -/
noncomputable def grassmannianSchurBasis :
    Module.Basis {μ : YoungDiagram // μ ≤ YoungDiagram.rect n m} R
      (symmetricSubalgebra (Fin n) R ⧸ grassmannianIdeal n m R) :=
  .mk linearIndependent_mk_diagramSchurPoly top_le_span_mk_diagramSchurPoly

/-- The vectors of the rectangular Schur basis are the classes of the Schur polynomials. -/
@[simp]
theorem grassmannianSchurBasis_apply (μ : {μ : YoungDiagram // μ ≤ YoungDiagram.rect n m}) :
    grassmannianSchurBasis n m R μ =
      Ideal.Quotient.mk (grassmannianIdeal n m R) (symmetricDiagramSchurPoly n R μ) := by
  simp [grassmannianSchurBasis]

end TauCeti
