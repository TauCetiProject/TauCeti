module

public import Mathlib.RingTheory.MvPolynomial.Symmetric.FundamentalTheorem
public import Mathlib.RingTheory.MvPolynomial.Symmetric.NewtonIdentities
public import TauCeti.RingTheory.MvPolynomial.Symmetric.PowerSum.Basic
public import TauCeti.RingTheory.MvPolynomial.Symmetric.Schur.Basis
import Mathlib.LinearAlgebra.Dimension.OrzechProperty
import Mathlib.RingTheory.FiniteType

/-!
# The power sums generate the symmetric polynomials over a `ℚ`-algebra

Let `σ` be a finite alphabet and `R` a commutative `ℚ`-algebra, for instance `ℚ` itself or `ℂ`.
Newton's identities `MvPolynomial.mul_esymm_eq_sum`,

`k eₖ = (-1) ^ (k + 1) ∑_{a + b = k, a < k} (-1) ^ a e_a p_b`,

are triangular: they express `k eₖ` through `p₁, …, pₖ` and the lower `e_a`. Once the integers are
invertible they therefore write every elementary symmetric polynomial `eₖ` as a polynomial in the
power sums `p₁, …, pₖ`, and the fundamental theorem of symmetric polynomials
(`MvPolynomial.esymmAlgHom_surjective`) turns this into generation: **the power sums `p₁, …, pₙ`
generate the symmetric polynomials as an `R`-algebra** whenever the alphabet has at most `n`
letters. Over `ℤ` this fails already for two letters, where `e₂ = (p₁² - p₂) / 2`.

Graded by degree, generation says that the power-sum products `p_μ = ∏ᵢ p_{μᵢ}` of the partitions
`μ` of `n` span the symmetric polynomials of degree `n`. When the alphabet has at least `n` letters
there are exactly as many of them as there are monomial symmetric polynomials of degree `n`, and a
spanning family of that size in a free module over a commutative ring is a basis
(`linearIndependent_of_top_le_span_of_card_eq_finrank`). This is the **power-sum basis**, in
which the Frobenius characteristic `(1 / n!) ∑_π f(π) p_{ρ(π)}` of a class function `f` of `Sₙ` is
expanded; by spanning, two linear maps out of the symmetric polynomials of degree `n` agree as soon
as they agree on every `p_μ`.

## Main definitions

* `TauCeti.psumPartBasis`: for an alphabet with at least `n` letters, the power-sum products of
  the partitions of `n` as a basis of the symmetric polynomials of degree `n`.

## Main results

* `TauCeti.esymm_mem_adjoin_psum`: `eₖ` lies in the subalgebra generated by `p₁, …, pₖ`.
* `TauCeti.adjoin_psum_Icc_eq_symmetricSubalgebra`: **the power sums `p₁, …, pₙ` generate the
  symmetric polynomials** in at most `n` variables.
* `TauCeti.adjoin_range_psum_eq_symmetricSubalgebra`: the power sums generate the symmetric
  polynomials.
* `TauCeti.span_psumPart_eq_symmetricHomogeneousSubmodule`: the power-sum products of the
  partitions of `n` span the symmetric polynomials of degree `n`.
* `TauCeti.linearIndependent_psumPart`: in at least `n` variables they are linearly independent.

## References

* [I. G. Macdonald, *Symmetric Functions and Hall Polynomials*][macdonald1995], Chapter I,
  Section 2: Newton's formulas, and the power sums as generators and the `p_λ` as a basis of the
  symmetric functions over `ℚ`.
-/

public section

namespace TauCeti

open Finset MvPolynomial

variable (σ : Type*) [Fintype σ] (R : Type*) [CommRing R] [Algebra ℚ R]

/-! ### Generation as an algebra -/

/-- **Newton's identities express `eₖ` through the power sums**: over a `ℚ`-algebra the elementary
symmetric polynomial `eₖ` is a polynomial in the power sums `p₁, …, pₖ`. -/
theorem esymm_mem_adjoin_psum (k : ℕ) :
    esymm σ R k ∈ Algebra.adjoin R (psum σ R '' Set.Icc 1 k) := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · simp
  set A := Algebra.adjoin R (psum σ R '' Set.Icc 1 k)
  -- every summand on the right of Newton's identity for `k eₖ` lies in `A`
  have hmul : (k : MvPolynomial σ R) * esymm σ R k ∈ A := by
    rw [mul_esymm_eq_sum]
    refine A.mul_mem (A.pow_mem (A.neg_mem A.one_mem) _) (A.sum_mem fun a ha => ?_)
    obtain ⟨hak, hlt⟩ := mem_filter.mp ha
    rw [mem_antidiagonal] at hak
    refine A.mul_mem (A.mul_mem (A.pow_mem (A.neg_mem A.one_mem) _) ?_) ?_
    · exact Algebra.adjoin_mono (Set.image_mono (Set.Icc_subset_Icc_right (by omega)))
        (ih a.1 hlt)
    · exact Algebra.subset_adjoin ⟨a.2, ⟨by omega, by omega⟩, rfl⟩
  have hk' : (k : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hk.ne'
  have h := A.smul_mem hmul (algebraMap ℚ R (k : ℚ)⁻¹)
  rwa [algebraMap_smul, ← nsmul_eq_mul, ← Nat.cast_smul_eq_nsmul ℚ, inv_smul_smul₀ hk'] at h

/-- **The power sums generate the symmetric polynomials**: over a `ℚ`-algebra, the power sums
`p₁, …, pₙ` generate the symmetric polynomials in an alphabet of at most `n` letters as an
algebra. -/
theorem adjoin_psum_Icc_eq_symmetricSubalgebra {n : ℕ} (hn : Fintype.card σ ≤ n) :
    Algebra.adjoin R (psum σ R '' Set.Icc 1 n) = symmetricSubalgebra σ R := by
  refine le_antisymm (Algebra.adjoin_le ?_) fun p hp => ?_
  · rintro _ ⟨k, -, rfl⟩
    exact psum_isSymmetric σ R k
  obtain ⟨f, hf⟩ := esymmAlgHom_surjective R hn ⟨p, hp⟩
  have hf' : (esymmAlgHom σ R n f : MvPolynomial σ R) = p := by rw [hf]
  rw [esymmAlgHom_apply] at hf'
  rw [← hf']
  -- the generators `e_{i + 1}`, `i < n`, of the symmetric polynomials are polynomials in the `pₖ`
  have hgen : Set.range (fun i : Fin n => esymm σ R (i + 1)) ⊆
      Algebra.adjoin R (psum σ R '' Set.Icc 1 n) := by
    rintro _ ⟨i, rfl⟩
    exact Algebra.adjoin_mono (Set.image_mono (Set.Icc_subset_Icc_right (by omega)))
      (esymm_mem_adjoin_psum σ R (i + 1))
  refine Algebra.adjoin_le hgen ?_
  rw [Algebra.adjoin_range_eq_range_aeval]
  exact ⟨f, rfl⟩

/-- Over a `ℚ`-algebra, the power sums generate the symmetric polynomials as an algebra. -/
theorem adjoin_range_psum_eq_symmetricSubalgebra :
    Algebra.adjoin R (Set.range (psum σ R)) = symmetricSubalgebra σ R := by
  refine le_antisymm (Algebra.adjoin_le ?_) ?_
  · rintro _ ⟨k, rfl⟩
    exact psum_isSymmetric σ R k
  rw [← adjoin_psum_Icc_eq_symmetricSubalgebra σ R le_rfl]
  exact Algebra.adjoin_mono (Set.image_subset_range _ _)

/-! ### The power-sum products in a fixed degree -/

omit [Algebra ℚ R] in
/-- A product of power sums of positive degree is the power-sum product `p_μ` of a partition. -/
private theorem exists_eq_psumPart_of_mem_closure {N : ℕ} {g : MvPolynomial σ R}
    (hg : g ∈ Submonoid.closure (psum σ R '' Set.Icc 1 N)) :
    ∃ (m : ℕ) (μ : m.Partition), g = psumPart σ R μ := by
  induction hg using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨k, hk, rfl⟩ := hx
    exact ⟨k, .indiscrete k, (psumPart_indiscrete σ R (by grind)).symm⟩
  | one => exact ⟨0, .indiscrete 0, (psumPart_zero σ R).symm⟩
  | mul x y _ _ hx hy =>
    obtain ⟨m, μ, rfl⟩ := hx
    obtain ⟨m', ν, rfl⟩ := hy
    refine ⟨m + m', ⟨μ.parts + ν.parts, fun hi => ?_, by simp [μ.parts_sum, ν.parts_sum]⟩, ?_⟩
    · rcases Multiset.mem_add.mp hi with hi | hi
      exacts [μ.parts_pos hi, ν.parts_pos hi]
    · simp [psumPart, Multiset.map_add, Multiset.prod_add]

/-- **The power-sum products span the symmetric polynomials of degree `n`**: over a `ℚ`-algebra,
the products `p_μ = ∏ᵢ p_{μᵢ}` over the partitions `μ` of `n` span the symmetric polynomials that
are homogeneous of degree `n`. -/
theorem span_psumPart_eq_symmetricHomogeneousSubmodule (n : ℕ) :
    Submodule.span R (Set.range (psumPart σ R : n.Partition → MvPolynomial σ R)) =
      symmetricHomogeneousSubmodule σ R n := by
  refine le_antisymm (Submodule.span_le.mpr ?_) fun p hp => ?_
  · rintro _ ⟨μ, rfl⟩
    exact mem_symmetricHomogeneousSubmodule.mpr
      ⟨psumPart_isSymmetric R μ, isHomogeneous_psumPart R μ⟩
  obtain ⟨hsymm, hhom⟩ := mem_symmetricHomogeneousSubmodule.mp hp
  -- `p` is a combination of products of power sums; keep the degree-`n` part of each product
  have hp' : p ∈ Submodule.span R
      (Submonoid.closure (psum σ R '' Set.Icc 1 (Fintype.card σ)) : Set (MvPolynomial σ R)) := by
    rw [← Algebra.adjoin_eq_span, adjoin_psum_Icc_eq_symmetricSubalgebra σ R le_rfl]
    exact hsymm
  have h := Submodule.mem_map_of_mem (f := homogeneousComponent n) hp'
  rw [Submodule.map_span, homogeneousComponent_eq_self hhom] at h
  refine Submodule.span_le.mpr ?_ h
  rintro _ ⟨g, hg, rfl⟩
  obtain ⟨m, μ, rfl⟩ := exists_eq_psumPart_of_mem_closure σ R hg
  rw [SetLike.mem_coe, homogeneousComponent_of_mem (isHomogeneous_psumPart R μ)]
  split_ifs with hm
  · subst hm
    exact Submodule.subset_span ⟨μ, rfl⟩
  · exact zero_mem _

/-- The power-sum product `p_μ`, as an element of the symmetric polynomials of degree `n`. -/
private noncomputable def psumPartVec {n : ℕ} (μ : n.Partition) :
    symmetricHomogeneousSubmodule σ R n :=
  ⟨psumPart σ R μ, mem_symmetricHomogeneousSubmodule.mpr
    ⟨psumPart_isSymmetric R μ, isHomogeneous_psumPart R μ⟩⟩

private theorem top_le_span_psumPartVec (n : ℕ) :
    ⊤ ≤ Submodule.span R (Set.range (psumPartVec σ R (n := n))) :=
  ((Submodule.span_range_subtype_eq_top_iff _ _).mpr
    (span_psumPart_eq_symmetricHomogeneousSubmodule σ R n)).ge

private theorem linearIndependent_psumPartVec {n : ℕ} (hn : n ≤ Fintype.card σ) :
    LinearIndependent R (psumPartVec σ R (n := n)) := by
  classical
  -- in at least `n` letters every partition of `n` indexes a monomial basis vector
  have hcard (μ : n.Partition) : μ.parts.card ≤ Fintype.card σ := μ.card_parts_le.trans hn
  nontriviality R
  refine linearIndependent_of_top_le_span_of_card_eq_finrank (top_le_span_psumPartVec σ R n) ?_
  rw [Module.finrank_eq_card_basis ((msymmBasis σ R n).reindex (Equiv.subtypeUnivEquiv hcard))]

/-- **The power-sum basis**: over a `ℚ`-algebra and in an alphabet of at least `n` letters, the
power-sum products `p_μ` of the partitions `μ` of `n` form a basis of the symmetric polynomials of
degree `n`. -/
noncomputable def psumPartBasis {n : ℕ} (hn : n ≤ Fintype.card σ) :
    Module.Basis n.Partition R (symmetricHomogeneousSubmodule σ R n) :=
  .mk (linearIndependent_psumPartVec σ R hn) (top_le_span_psumPartVec σ R n)

/-- The vectors of the power-sum basis are the power-sum products. -/
@[simp]
theorem coe_psumPartBasis {n : ℕ} (hn : n ≤ Fintype.card σ) (μ : n.Partition) :
    (psumPartBasis σ R hn μ : MvPolynomial σ R) = psumPart σ R μ := by
  simp [psumPartBasis, psumPartVec]

/-- **The power-sum products are linearly independent**: over a `ℚ`-algebra and in an alphabet of
at least `n` letters, the products `p_μ` over the partitions `μ` of `n` are linearly independent. -/
theorem linearIndependent_psumPart {n : ℕ} (hn : n ≤ Fintype.card σ) :
    LinearIndependent R (psumPart σ R : n.Partition → MvPolynomial σ R) := by
  have h : psumPart σ R = (symmetricHomogeneousSubmodule σ R n).subtype ∘ psumPartBasis σ R hn :=
    funext fun μ => (coe_psumPartBasis σ R hn μ).symm
  rw [h]
  exact (psumPartBasis σ R hn).linearIndependent.map' _ (Submodule.ker_subtype _)

end TauCeti
