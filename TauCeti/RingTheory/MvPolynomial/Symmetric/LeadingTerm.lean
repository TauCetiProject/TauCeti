module

public import Mathlib.RingTheory.MvPolynomial.MonomialOrder
public import Mathlib.RingTheory.MvPolynomial.Symmetric.Defs
public import TauCeti.Data.Finsupp.MonomialOrder.Basic

/-!
# Leading terms of elementary symmetric polynomials

Let `m` be a monomial order and `s` a finite set of variables. The `r`-th elementary symmetric
polynomial `(s.val.map X).esymm r` of the variables of `s` is the sum of the squarefree monomials
`∏ i ∈ u, X i` over the subsets `u ⊆ s` with `r` elements. Its leading monomial is the product of
the `r` largest variables of `s`: if `t ⊆ s` is closed upwards in `s` for the order of the
variables, then `(s.val.map X).esymm #t` is monic with leading exponent `∑ i ∈ t, single i 1`.
Taking `s` to be all variables gives the leading term of `MvPolynomial.esymm σ R r`.

These are the leading terms through which the elementary symmetric polynomials of the orbits of a
permutation group generated by transpositions form a SAGBI basis of its invariant polynomials
(`TauCeti.RingTheory.MvPolynomial.SAGBI.PermInvariant`).

## Main results

* `MvPolynomial.esymm_map_X_eq_sum_monomial`: the elementary symmetric polynomial of the
  variables of `s` as a sum of squarefree monomials.
* `MvPolynomial.coeff_esymm_map_X_sum_single`: the monomial `∏ i ∈ t, X i` occurs with
  coefficient `1` in the elementary symmetric polynomial of degree `#t` of `s ⊇ t`.
* `MonomialOrder.degree_esymm_map_X`, `MonomialOrder.monic_esymm_map_X` and
  `MonomialOrder.leadingTerm_esymm_map_X`: for `t ⊆ s` closed upwards in `s`, the elementary
  symmetric polynomial of degree `#t` in the variables of `s` is monic with leading monomial
  `∏ i ∈ t, X i`.
* `MonomialOrder.degree_esymm`, `MonomialOrder.monic_esymm` and `MonomialOrder.leadingTerm_esymm`:
  the same for `MvPolynomial.esymm σ R #t`, when `t` is closed upwards among all variables.

## References

* D. Cox, J. Little, D. O'Shea, *Ideals, Varieties, and Algorithms*, 4th ed., Springer, 2015,
  §7.1.
-/

public section

open Finset Finsupp MvPolynomial

namespace MvPolynomial

variable {σ R : Type*} [CommSemiring R]

/-- The elementary symmetric polynomial of degree `r` in the variables of a finite set `s` is the
sum of the squarefree monomials of the subsets of `s` with `r` elements. -/
theorem esymm_map_X_eq_sum_monomial (s : Finset σ) (r : ℕ) :
    (s.val.map X).esymm r =
      ∑ u ∈ s.powersetCard r, monomial (∑ i ∈ u, single i 1) (1 : R) := by
  simp_rw [Finset.esymm_map_val, monomial_sum_one, ← X_pow_eq_monomial, pow_one]

/-- The coefficient of the squarefree monomial `∏ i ∈ t, X i` in the elementary symmetric
polynomial of degree `#t` in the variables of `s ⊇ t` is `1`. -/
theorem coeff_esymm_map_X_sum_single {s t : Finset σ} (ht : t ⊆ s) :
    ((s.val.map X).esymm t.card : MvPolynomial σ R).coeff (∑ i ∈ t, single i 1) = 1 := by
  classical
  have hinj : Function.Injective fun u : Finset σ ↦ ∑ i ∈ u, single i 1 := fun u v h ↦
    Finset.val_injective (by simpa [toMultiset_sum_single] using congrArg toMultiset h)
  rw [esymm_map_X_eq_sum_monomial, coeff_sum]
  simp_rw [coeff_monomial, hinj.eq_iff]
  rw [Finset.sum_ite_eq']
  simp [ht]

end MvPolynomial

namespace MonomialOrder

variable {σ R : Type*} [CommSemiring R] {m : MonomialOrder σ} {s t : Finset σ}

/-- If `t ⊆ s` is closed upwards in `s` for the order of the variables, the elementary symmetric
polynomial of degree `#t` in the variables of `s` has leading exponent `∑ i ∈ t, single i 1`: its
leading monomial is the product of the `#t` largest variables of `s`. -/
theorem degree_esymm_map_X [Nontrivial R] (ht : t ⊆ s)
    (hup : ∀ i ∈ t, ∀ j ∈ s, m.toSyn (single i 1) < m.toSyn (single j 1) → j ∈ t) :
    m.degree ((s.val.map X).esymm t.card : MvPolynomial σ R) = ∑ i ∈ t, single i 1 := by
  classical
  refine m.toSyn.injective (le_antisymm (m.degree_le_iff.2 fun d hd ↦ ?_)
    (m.le_degree (MvPolynomial.mem_support_iff.2 (by simp [coeff_esymm_map_X_sum_single ht]))))
  rw [esymm_map_X_eq_sum_monomial] at hd
  obtain ⟨u, hu, hdu⟩ := Finset.mem_biUnion.1 (support_sum hd)
  rw [support_monomial, ite_eq_right one_ne_zero, Finset.mem_singleton] at hdu
  subst hdu
  rw [Finset.mem_powersetCard] at hu
  rcases eq_or_ne u t with rfl | hut
  · exact le_rfl
  · exact (m.toSyn_sum_single_lt_of_card_eq ht hup hu.1 hu.2 hut).le

/-- If `t ⊆ s` is closed upwards in `s` for the order of the variables, the elementary symmetric
polynomial of degree `#t` in the variables of `s` is monic. -/
theorem monic_esymm_map_X (ht : t ⊆ s)
    (hup : ∀ i ∈ t, ∀ j ∈ s, m.toSyn (single i 1) < m.toSyn (single j 1) → j ∈ t) :
    m.Monic ((s.val.map X).esymm t.card : MvPolynomial σ R) := by
  nontriviality R
  rw [Monic, leadingCoeff, degree_esymm_map_X ht hup, coeff_esymm_map_X_sum_single ht]

/-- If `t ⊆ s` is closed upwards in `s` for the order of the variables, the leading term of the
elementary symmetric polynomial of degree `#t` in the variables of `s` is `∏ i ∈ t, X i`. -/
theorem leadingTerm_esymm_map_X (ht : t ⊆ s)
    (hup : ∀ i ∈ t, ∀ j ∈ s, m.toSyn (single i 1) < m.toSyn (single j 1) → j ∈ t) :
    m.leadingTerm ((s.val.map X).esymm t.card : MvPolynomial σ R) =
      monomial (∑ i ∈ t, single i 1) 1 := by
  nontriviality R
  rw [leadingTerm, (monic_esymm_map_X ht hup).leadingCoeff_eq_one, degree_esymm_map_X ht hup]

variable [Fintype σ]

/-- If `t` is closed upwards among all variables, the elementary symmetric polynomial
`MvPolynomial.esymm σ R #t` has leading exponent `∑ i ∈ t, single i 1`. -/
theorem degree_esymm [Nontrivial R]
    (hup : ∀ i ∈ t, ∀ j, m.toSyn (single i 1) < m.toSyn (single j 1) → j ∈ t) :
    m.degree (esymm σ R t.card) = ∑ i ∈ t, single i 1 := by
  rw [esymm_eq_multiset_esymm]
  exact degree_esymm_map_X (Finset.subset_univ t) fun i hi j _ ↦ hup i hi j

/-- If `t` is closed upwards among all variables, the elementary symmetric polynomial
`MvPolynomial.esymm σ R #t` is monic. -/
theorem monic_esymm
    (hup : ∀ i ∈ t, ∀ j, m.toSyn (single i 1) < m.toSyn (single j 1) → j ∈ t) :
    m.Monic (esymm σ R t.card) := by
  rw [esymm_eq_multiset_esymm]
  exact monic_esymm_map_X (Finset.subset_univ t) fun i hi j _ ↦ hup i hi j

/-- If `t` is closed upwards among all variables, the leading term of the elementary symmetric
polynomial `MvPolynomial.esymm σ R #t` is `∏ i ∈ t, X i`. -/
theorem leadingTerm_esymm
    (hup : ∀ i ∈ t, ∀ j, m.toSyn (single i 1) < m.toSyn (single j 1) → j ∈ t) :
    m.leadingTerm (esymm σ R t.card) = monomial (∑ i ∈ t, single i 1) 1 := by
  rw [esymm_eq_multiset_esymm]
  exact leadingTerm_esymm_map_X (Finset.subset_univ t) fun i hi j _ ↦ hup i hi j

end MonomialOrder
