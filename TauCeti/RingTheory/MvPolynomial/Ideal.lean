/-!
# Ideals of multivariate polynomial rings

Let `J` be the ideal of `R[X_i : i ∈ σ]` generated by the variables. It is the kernel of the
constant coefficient, and its powers are characterised by total degree.

The `k`-th power `J ^ k` consists of the polynomials all of whose monomials have total degree at
least `k` (`MvPolynomial.mem_pow_idealOfVars_iff`). This file records that multiplying an element of
`J ^ k` by any `q` only involves the constant coefficient of `q` in total degrees at most `k`.
This is how a linear map between free modules over `R[X_i : i ∈ σ]` acts, in the lowest degree
of the `J`-adic filtration, through its reduction modulo the variables. It also records that `J`
is maximal over a field, and that over a nontrivial base `J` is finitely generated if and only if
`σ` is finite, so `R[X_i : i ∈ σ]` is not noetherian when `σ` is infinite.

For arbitrary ideals given by generating sets, adjoining one auxiliary variable reduces their
intersection to contraction: multiply the first family by `X none` and the second by
`1 - X none`, then contract along `rename some`. Similarly, the saturation of an ideal `I` by a
polynomial `f`, the set of `g` with `f ^ n * g ∈ I` for some `n`, is the contraction along
`rename some` of `I + (f X_none - 1)`; it is also the contraction of `I` from the localization
away from `f`. Likewise, the relations of a polynomial parametrization are the contraction of
its graph equations `Y i - f i`. These formulas need no monomial order.

## Main results

* `MvPolynomial.ker_constantCoeff`: the kernel of the constant coefficient is the ideal generated
  by the variables.
* `MvPolynomial.isMaximal_idealOfVars`: over a field, the ideal of the variables is maximal.
* `MvPolynomial.not_fg_idealOfVars`, `MvPolynomial.fg_idealOfVars_iff`, and
  `MvPolynomial.not_isNoetherianRing`: over a nontrivial commutative semiring, the ideal of
  variables is finitely generated if and only if the index type is finite, so `MvPolynomial σ R`
  is not noetherian when `σ` is infinite.
* `MvPolynomial.coeff_mul_of_mem_pow_idealOfVars`: for `p ∈ J ^ k` and a monomial `e` of total
  degree at most `k`, the coefficient of `e` in `p * q` is the coefficient of `e` in `p` times the
  constant coefficient of `q`.
* `MvPolynomial.ker_aeval_sumElim`: the graph equations generate the kernel of substitution
  which keeps the original variables.
* `MvPolynomial.ker_aeval_eq_comap_graph`: the relations among a family of polynomials are
  obtained by eliminating the original variables from its graph ideal.
* `Ideal.span_inf_span_eq_comap_rename_some`: an intersection of generated ideals is the
  contraction of an ideal in one more variable.
* `Ideal.mem_comap_rename_some_map_rename_some_sup_span_iff` and
  `Ideal.comap_rename_some_map_rename_some_sup_span`: the saturation of an ideal by a polynomial is
  the contraction of an ideal in one more variable, and the contraction from the localization.

## References

* D. Cox, J. Little, D. O'Shea, *Ideals, Varieties, and Algorithms*, Chapter 4, §3,
  computing intersections by elimination; Chapter 4, §4, computing saturations by
  elimination; Chapter 3, §3, implicitization by elimination.
-/

public section

namespace MvPolynomial

open Finsupp

variable {R σ : Type*} [CommSemiring R]

variable (σ R) in
/-- The kernel of the constant coefficient is the ideal generated by the variables. -/
theorem ker_constantCoeff : RingHom.ker (constantCoeff (σ := σ) (R := R)) = idealOfVars σ R := by
  ext p
  rw [RingHom.mem_ker, ← pow_one (idealOfVars σ R), mem_pow_idealOfVars_iff', constantCoeff_eq]
  simp [degree_eq_zero_iff]

/-- Over a field, the ideal generated by all variables is maximal. -/
instance isMaximal_idealOfVars (σ K : Type*) [Field K] : (idealOfVars σ K).IsMaximal := by
  rw [← ker_constantCoeff]
  exact RingHom.ker_isMaximal_of_surjective (constantCoeff : MvPolynomial σ K →+* K)
    (fun scalar ↦ ⟨C scalar, by simp⟩)

/-- Over a nontrivial commutative semiring, the ideal generated by infinitely many variables is not
finitely generated: any finite set of polynomials involves only finitely many variables. -/
theorem not_fg_idealOfVars (σ R : Type*) [CommSemiring R] [Nontrivial R] [Infinite σ] :
    ¬ (idealOfVars σ R).FG := by
  classical
  rintro ⟨G, hG⟩
  let t : Finset σ := G.biUnion fun g ↦ g.support.biUnion Finsupp.support
  obtain ⟨i, hi⟩ := Infinite.exists_notMem_finset t
  have hle : idealOfVars σ R ≤ Ideal.span (X '' (t : Set σ)) := by
    rw [← hG, Ideal.span_le]
    intro g hg
    have hg' : g ∈ Ideal.span (X '' (Set.univ : Set σ)) := by
      rw [Set.image_univ, ← idealOfVars, ← hG]
      exact Ideal.subset_span hg
    refine mem_ideal_span_X_image.mpr fun m hm ↦ ?_
    obtain ⟨j, -, hj⟩ := mem_ideal_span_X_image.mp hg' m hm
    exact ⟨j, Finset.mem_biUnion.mpr ⟨g, hg, Finset.mem_biUnion.mpr
      ⟨m, hm, Finsupp.mem_support_iff.mpr hj⟩⟩, hj⟩
  have hXi : (X i : MvPolynomial σ R) ∈ Ideal.span (X '' (t : Set σ)) :=
    hle (Ideal.subset_span ⟨i, rfl⟩)
  obtain ⟨j, hj, hij⟩ := mem_ideal_span_X_image.mp hXi (Finsupp.single i 1) (by simp [support_X])
  have heq : i = j := by
    by_contra hne
    simp [hne] at hij
  exact hi (heq ▸ hj)

/-- Over a nontrivial commutative semiring, the ideal generated by all variables is finitely
generated if and only if the index type is finite. -/
@[simp]
theorem fg_idealOfVars_iff [Nontrivial R] : (idealOfVars σ R).FG ↔ Finite σ :=
  ⟨fun h ↦ by
    by_contra hinf
    have := not_finite_iff_infinite.mp hinf
    exact not_fg_idealOfVars σ R h, fun _ ↦ fg_idealOfVars σ R⟩

/-- Over a nontrivial commutative semiring, a polynomial ring in infinitely many variables is not
noetherian, since its ideal of variables is not finitely generated. -/
theorem not_isNoetherianRing (σ R : Type*) [CommSemiring R] [Nontrivial R] [Infinite σ] :
    ¬ IsNoetherianRing (MvPolynomial σ R) :=
  fun h ↦ not_fg_idealOfVars σ R (h.noetherian _)

/-- If `p` lies in the `k`-th power of the ideal generated by the variables, then the coefficients
of `p * q` in total degree at most `k` are those of `p` times the constant coefficient of `q`. -/
theorem coeff_mul_of_mem_pow_idealOfVars (p : MvPolynomial σ R) {k : ℕ}
    (hp : p ∈ idealOfVars σ R ^ k) (q : MvPolynomial σ R) {e : σ →₀ ℕ} (he : degree e ≤ k) :
    (p * q).coeff e = p.coeff e * constantCoeff q := by
  classical
  rw [coeff_mul, Finset.sum_eq_single (e, 0), constantCoeff_eq]
  · rintro ⟨a, b⟩ hab hne
    rw [Finset.mem_antidiagonal] at hab
    have hb : degree b ≠ 0 := by
      rw [Ne, degree_eq_zero_iff]
      rintro rfl
      exact hne (by simp_all)
    have hdeg : degree a + degree b = degree e := by rw [← map_add, hab]
    rw [(mem_pow_idealOfVars_iff' k p).mp hp a (by omega), zero_mul]
  · exact fun h ↦ absurd (Finset.mem_antidiagonal.mpr (add_zero e)) h

section Graph

variable {ι : Type*} {R : Type*} [CommRing R]

/-- The graph of a family of polynomials is cut out by the equations
`Y i - f i`: their ideal is the kernel of substitution, keeping the original variables. -/
theorem ker_aeval_sumElim (f : ι → MvPolynomial σ R) :
    RingHom.ker (aeval (Sum.elim X f)) =
      Ideal.span (Set.range fun i ↦ X (Sum.inr i) - rename Sum.inl (f i)) := by
  let J := Ideal.span (Set.range fun i ↦ X (Sum.inr i) - rename Sum.inl (f i))
  let q := Ideal.Quotient.mkₐ R J
  have hrel (i : ι) : q (X (Sum.inr i)) = q (rename Sum.inl (f i)) :=
    Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_range_self i))
  have hcomp : (q.comp (rename Sum.inl)).comp (aeval (Sum.elim X f)) = q := by
    ext i
    cases i with
    | inl j => simp
    | inr j => simpa using (hrel j).symm
  refine le_antisymm ?_ (Ideal.span_le.mpr ?_)
  · intro p hp
    have hp0 : aeval (Sum.elim X f) p = 0 := RingHom.mem_ker.mp hp
    have := DFunLike.congr_fun hcomp p
    simpa [hp0, q, Ideal.Quotient.eq_zero_iff_mem] using this.symm
  · rintro _ ⟨i, rfl⟩
    simp [RingHom.mem_ker, aeval_rename, aeval_X_left_apply]

/-- The relations among a family of polynomials are obtained by eliminating the original
variables from its graph equations. No finiteness or field hypothesis is needed. -/
theorem ker_aeval_eq_comap_graph (f : ι → MvPolynomial σ R) :
    RingHom.ker (aeval f) =
      (Ideal.span (Set.range fun i ↦ X (Sum.inr i) - rename Sum.inl (f i))).comap
        (rename (R := R) Sum.inr) := by
  rw [← ker_aeval_sumElim]
  ext p
  simp [RingHom.mem_ker, aeval_rename]

end Graph

end MvPolynomial

namespace Ideal

open MvPolynomial

variable {σ R : Type*} [CommRing R]

/-- An ideal intersection is the contraction of the ideal generated by the two families
multiplied by the auxiliary variable and its complement. -/
theorem span_inf_span_eq_comap_rename_some (s t : Set (MvPolynomial σ R)) :
    span s ⊓ span t =
      (span ((fun f ↦ X none * rename some f) '' s ∪
        (fun g ↦ (1 - X none) * rename some g) '' t)).comap
          (rename (R := R) some) := by
  let e := (optionEquivLeft R σ).toRingHom
  let K : Ideal (MvPolynomial (Option σ) R) :=
    span ((fun f ↦ X none * rename some f) '' s ∪
      (fun g ↦ (1 - X none) * rename some g) '' t)
  have hcomp : e.comp (rename (R := R) some).toRingHom = Polynomial.C := by
    ext <;> simp [e]
  have hmap : K.map e =
      span ((fun f ↦ Polynomial.X * Polynomial.C f) '' s ∪
        (fun g ↦ (1 - Polynomial.X) * Polynomial.C g) '' t) := by
    have he (f : MvPolynomial σ R) : e (rename some f) = Polynomial.C f :=
      RingHom.congr_fun hcomp f
    have hX : e (X none) = Polynomial.X := optionEquivLeft_X_none R σ
    simp only [K, map_span, Set.image_union, Set.image_image, map_mul, map_sub, map_one, he, hX]
  rw [span_inf_span_eq_comap_C, ← hmap, ← hcomp, ← comap_comap,
    K.comap_map_of_bijective e (optionEquivLeft R σ).bijective,
    AlgHom.toRingHom_eq_coe, comap_coe]

/-- **Saturation by an added variable.** A polynomial `g` lies in the contraction along
`rename some` of `I + (f X_none - 1)` if and only if some power of `f` multiplies it into `I`. -/
theorem mem_comap_rename_some_map_rename_some_sup_span_iff {I : Ideal (MvPolynomial σ R)}
    {f g : MvPolynomial σ R} :
    g ∈ (I.map (rename some) ⊔ span {rename some f * X none - 1}).comap
      (rename (R := R) some) ↔ ∃ n : ℕ, f ^ n * g ∈ I := by
  -- Transport to polynomials in `X none` over `MvPolynomial σ R`, where `rename some` is `C`.
  let e := (optionEquivLeft R σ).toAlgHom
  have hcomp : e.comp (rename (R := R) some) = Polynomial.CAlgHom := by
    ext; simp [e]
  have hf : e (rename some f) = Polynomial.C f := AlgHom.congr_fun hcomp f
  have hX : e (X none) = Polynomial.X := optionEquivLeft_X_none R σ
  have hmap : (I.map (rename some) ⊔ span {rename some f * X none - 1}).map e =
      I.map (Polynomial.CAlgHom (R := R)) ⊔ span {Polynomial.C f * Polynomial.X - 1} := by
    simp [map_sup, map_mapₐ, map_span, hcomp, hf, hX]
  rw [← comap_map_of_bijective e (optionEquivLeft R σ).bijective (I := I.map (rename some) ⊔ _),
    hmap, comap_comapₐ, hcomp]
  exact mem_comap_C_map_C_sup_span_C_mul_X_sub_one_iff

/-- The contraction along `rename some` of `I + (f X_none - 1)` is the contraction of `I` from
the localization `S` of `MvPolynomial σ R` away from `f`. -/
theorem comap_rename_some_map_rename_some_sup_span (I : Ideal (MvPolynomial σ R))
    (f : MvPolynomial σ R) (S : Type*) [CommSemiring S] [Algebra (MvPolynomial σ R) S]
    [IsLocalization.Away f S] :
    (I.map (rename some) ⊔ span {rename some f * X none - 1}).comap (rename (R := R) some) =
      (I.map (algebraMap _ S)).comap (algebraMap _ S) := by
  ext g
  rw [mem_comap_rename_some_map_rename_some_sup_span_iff, mem_comap,
    IsLocalization.Away.algebraMap_mem_map_algebraMap_iff f]

end Ideal
