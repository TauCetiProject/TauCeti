/-!
# Scaling the variables of a homogeneous polynomial

Evaluating a homogeneous polynomial of degree `n` after multiplying every variable by `a`
multiplies its value by `a ^ n`. This permits normalizing linear substitutions without
expanding the polynomial.

The results live in `MvPolynomial.IsHomogeneous`, so a homogeneity proof supports dot
notation such as `hp.eval₂_const_mul` and `hp.aeval_smul_of_algebra`, the latter for a scalar
algebra that may differ from the coefficient algebra; Mathlib supplies `hp.aeval_smul` and
`hp.eval_smul` themselves. In the same way
`hp.coeff_single_eq_eval` reads the coefficient of `X_j ^ n` off the value at the `j`-th basis
vector, `hp.aeval_eq_sum_finsuppAntidiag` expands a value as a sum over the exponent vectors of
degree `n`, `hp.constantCoeff_eq_zero` records that the constant coefficient vanishes in
positive degree, `hp.natDegree_aeval_le` bounds by `n` the degree of a substitution of
polynomials of degree at most one, `hp.homogeneousComponent_mul_right` records that
multiplying on the right by a homogeneous polynomial of degree `d` shifts homogeneous components
by `d`, and `hp.not_dvd_X` records that over a domain a homogeneous polynomial of degree at least
two divides no variable. Without zero divisors, the factors of a nonzero homogeneous product are
homogeneous (`hp.of_mul_left`, `hp.of_mul_right`). `TauCeti.eval_coe_homogeneousSubmodule_eq_sum`
restates the expansion of values for `eval` on elements of `homogeneousSubmodule`.

The file also records `MvPolynomial.isHomogeneous_coeff_prod_X_sub_C`: the coefficients of a
product of linear factors `X - C Ψ` with homogeneous `Ψ` of degree `m` are homogeneous, and
`TauCeti.sum_smul_X_pow_mem_homogeneousSubmodule`: the `n`-th power of a linear form is
homogeneous of degree `n`. Conversely, `MvPolynomial.homogeneousComponent_one_eq_sum` writes the
degree-one component of a polynomial in finitely many variables as the linear form
`∑ i, c i • X i` whose coefficients `c i` are the coefficients of the variables `X i`.
The top component of a nonzero polynomial is nonzero
(`MvPolynomial.homogeneousComponent_totalDegree_ne_zero`). With no variables every homogeneous
polynomial of positive degree is zero (`MvPolynomial.homogeneousSubmodule_succ_eq_bot_of_isEmpty`).
Finally, `MvPolynomial.eval_eq_sum_homogeneousComponent_of_eval_smul` averages over the `n`-th
roots of unity: if scaling the point by every `n`-th root of unity `ζ ^ j` scales the value by
`(ζ ^ j) ^ a`, only the homogeneous components of degree congruent to `a` modulo `n` contribute.

For an ideal `I` generated by a family `a`, `Ideal.mem_mul_span_pow_iff_exists_isHomogeneous`
describes `K * Iᵛ` as the values at `a` of the homogeneous polynomials of degree `ν` with
coefficients in `K`. If `a` is quasi-regular, `Ideal.mem_span_pow_of_mul_mem_span_pow` lifts a
nonzerodivisor modulo `I` to a nonzerodivisor modulo every power of `I`, and `hp.eval_mem_pow`
records that a degree-`ν` form takes values in `Iᵛ` on families in `I`. A homogeneous polynomial
of positive degree splits as `G + H * X_last`, with `G` free of the last variable
(`hp.exists_eq_rename_castSucc_add_mul_X_last`). These are the polynomial descriptions of ideal
powers used for associated graded rings.
-/

public section

namespace MvPolynomial.IsHomogeneous

/-- Scaling all variables by `a` scales the value of a degree-`n` homogeneous polynomial
by `a ^ n`, after any change of coefficient ring.

This is not a global `simp` lemma: the degree `n` cannot be inferred from its left-hand side. -/
theorem eval₂_const_mul {σ R S : Type*} [CommSemiring R] [CommSemiring S]
    {p : MvPolynomial σ R} {n : ℕ} (hp : p.IsHomogeneous n)
    (f : R →+* S) (g : σ → S) (a : S) :
    _root_.MvPolynomial.eval₂ f (fun i ↦ a * g i) p =
      a ^ n * _root_.MvPolynomial.eval₂ f g p := by
  classical
  simp only [_root_.MvPolynomial.eval₂_eq, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro d hd
  have hdeg : ∑ i ∈ d.support, d i = n := (hp.degree_eq_sum_deg_support hd).symm
  simp only [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
  ring

/-- Scaling the variables of a homogeneous polynomial by a scalar scales its algebra
evaluation by the corresponding power of that scalar. The scalar algebra may differ
from the coefficient algebra. -/
theorem aeval_smul_of_algebra {σ R S A : Type*}
    [CommSemiring R] [CommSemiring S] [CommSemiring A] [Algebra R A] [Algebra S A]
    {p : MvPolynomial σ R} {n : ℕ} (hp : p.IsHomogeneous n) (g : σ → A) (a : S) :
    _root_.MvPolynomial.aeval (a • g) p = a ^ n • _root_.MvPolynomial.aeval g p := by
  rw [Pi.smul_def]
  simpa only [_root_.MvPolynomial.aeval_def, Algebra.smul_def, map_pow] using
    hp.eval₂_const_mul (algebraMap R A) g (algebraMap S A a)

/-- The coefficient of `X_j ^ n` in a homogeneous polynomial of degree `n` is its value at the
`j`-th basis vector: every other monomial involves a variable other than `X_j`. -/
theorem coeff_single_eq_eval {σ R : Type*} [CommSemiring R] [DecidableEq σ]
    {p : MvPolynomial σ R} {n : ℕ} (hp : p.IsHomogeneous n) (j : σ) :
    p.coeff (Finsupp.single j n) = _root_.MvPolynomial.eval (Pi.single j 1) p := by
  conv_rhs => rw [p.as_sum]
  rw [map_sum, Finset.sum_eq_single (Finsupp.single j n)]
  · simp [_root_.MvPolynomial.eval_monomial]
  · intro s hs hne
    obtain ⟨i, hij, hi⟩ : ∃ i, i ≠ j ∧ s i ≠ 0 := by
      by_contra! h
      have hs' : s = Finsupp.single j (s j) := Finsupp.ext fun i ↦ by
        by_cases hi : i = j
        · simp [hi]
        · simp [hi, h i hi]
      have hdeg := hp (_root_.MvPolynomial.mem_support_iff.mp hs)
      rw [hs'] at hdeg
      simp only [Finsupp.weight_apply, Finsupp.sum_single_index, Pi.one_apply, smul_eq_mul,
        mul_one] at hdeg
      exact hne (hs'.trans (by rw [hdeg]))
    rw [_root_.MvPolynomial.eval_monomial, Finsupp.prod,
      Finset.prod_eq_zero (Finsupp.mem_support_iff.mpr hi)
        (by rw [Pi.single_eq_of_ne hij, zero_pow hi]), mul_zero]
  · intro h
    simp [_root_.MvPolynomial.notMem_support_iff.mp h]

/-- A homogeneous polynomial of positive degree has zero constant coefficient. -/
theorem constantCoeff_eq_zero {σ R : Type*} [CommSemiring R]
    {p : MvPolynomial σ R} {n : ℕ} (hp : p.IsHomogeneous n) (hn : n ≠ 0) :
    _root_.MvPolynomial.constantCoeff p = 0 := by
  rw [_root_.MvPolynomial.constantCoeff_eq]
  exact hp.coeff_eq_zero (by simpa using hn.symm)

/-- Substituting polynomials of degree at most one for the variables of a homogeneous
polynomial of degree `n` gives a polynomial of degree at most `n`. For instance, the
dehomogenization `F(X, 1)` of a binary form `F` of degree `n` has degree at most `n`. -/
theorem natDegree_aeval_le {σ R : Type*} [CommSemiring R]
    {p : MvPolynomial σ R} {n : ℕ} (hp : p.IsHomogeneous n) {v : σ → Polynomial R}
    (hv : ∀ i, (v i).natDegree ≤ 1) : (_root_.MvPolynomial.aeval v p).natDegree ≤ n := by
  conv_lhs => rw [p.as_sum]
  rw [map_sum]
  refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun s hs ↦ ?_
  rw [aeval_monomial, Polynomial.algebraMap_eq]
  refine (Polynomial.natDegree_C_mul_le _ _).trans <| (Polynomial.natDegree_prod_le _ _).trans ?_
  rw [← hp (mem_support_iff.mp hs), Finsupp.weight_apply, Finsupp.sum]
  refine Finset.sum_le_sum fun i _ ↦ (Polynomial.natDegree_pow_le).trans ?_
  simpa using Nat.mul_le_mul_left (s i) (hv i)

attribute [local instance] gradedAlgebra in
/-- Multiplying by a polynomial homogeneous of degree `d` shifts homogeneous components by `d`:
the degree-`n` component of `a * t` is `homogeneousComponent (n - d) a * t` when `d ≤ n`, and
vanishes otherwise. -/
theorem homogeneousComponent_mul_right {σ R : Type*} [CommSemiring R]
    {t : MvPolynomial σ R} {d : ℕ} (ht : t.IsHomogeneous d) (a : MvPolynomial σ R) (n : ℕ) :
    homogeneousComponent n (a * t) =
      if d ≤ n then homogeneousComponent (n - d) a * t else 0 := by
  have key (φ : MvPolynomial σ R) (i : ℕ) :
      (DirectSum.decompose (homogeneousSubmodule σ R) φ i : MvPolynomial σ R) =
        homogeneousComponent i φ :=
    decomposition.decompose'_apply φ i
  simpa only [key] using DirectSum.coe_decompose_mul_of_right_mem (homogeneousSubmodule σ R) n
    (a := a) ((mem_homogeneousSubmodule d t).mpr ht)

/-- The value of a homogeneous polynomial of degree `n` in finitely many variables is the sum, over
the exponent vectors `l` of total degree `n`, of its coefficient at `l` times the corresponding
monomial in the values: no monomial of any other degree occurs. -/
theorem aeval_eq_sum_finsuppAntidiag {σ R S : Type*} [Fintype σ] [DecidableEq σ]
    [CommSemiring R] [CommSemiring S] [Algebra R S] {p : MvPolynomial σ R} {n : ℕ}
    (hp : p.IsHomogeneous n) (f : σ → S) :
    _root_.MvPolynomial.aeval f p = ∑ l ∈ Finset.univ.finsuppAntidiag n,
      algebraMap R S (p.coeff l) * ∏ i, f i ^ l i := by
  rw [_root_.MvPolynomial.aeval_def, _root_.MvPolynomial.eval₂_eq']
  refine Finset.sum_subset (fun l hl => Finset.mem_finsuppAntidiag.mpr
    ⟨?_, Finset.subset_univ _⟩) fun l _ hl => ?_
  · rw [← Finsupp.degree_eq_sum]
    exact (hp.degree_eq_sum_deg_support hl).symm
  · rw [notMem_support_iff.mp hl, map_zero, zero_mul]

/-- Over a domain, a homogeneous polynomial of degree at least two divides none of the variables. -/
theorem not_dvd_X {σ R : Type*} [CommRing R] [IsDomain R] {p : MvPolynomial σ R} {n : ℕ}
    (hp : p.IsHomogeneous n) (hn : 2 ≤ n) (i : σ) : ¬ p ∣ _root_.MvPolynomial.X i := by
  rintro ⟨q, hq⟩
  have hq0 : q ≠ 0 := by rintro rfl; simp at hq
  have hp0 : p ≠ 0 := by rintro rfl; simp at hq
  have := congrArg _root_.MvPolynomial.totalDegree hq
  rw [_root_.MvPolynomial.totalDegree_X, _root_.MvPolynomial.totalDegree_mul_of_isDomain hp0 hq0,
    hp.totalDegree hp0] at this
  omega

/-- Without zero divisors, the left factor of a nonzero homogeneous product is homogeneous, of
degree its total degree. -/
theorem of_mul_left {σ R : Type*} [CommSemiring R] [NoZeroDivisors R] {p q : MvPolynomial σ R}
    {n : ℕ} (h : (p * q).IsHomogeneous n) (hpq : p * q ≠ 0) : p.IsHomogeneous p.totalDegree := by
  have hp : p ≠ 0 := left_ne_zero_of_mul hpq
  have hq : q ≠ 0 := right_ne_zero_of_mul hpq
  have hweight (s : σ →₀ ℕ) : Finsupp.weight 1 s = s.degree := by
    rw [Pi.one_def, ← Finsupp.degree_eq_weight_one]
  -- As a power series, a polynomial has order at most the degree of each of its monomials, hence
  -- at most its total degree.
  have horder {r : MvPolynomial σ R} {s : σ →₀ ℕ} (hs : s ∈ r.support) :
      (r : MvPowerSeries σ R).order ≤ s.degree :=
    MvPowerSeries.order_le (by rwa [_root_.MvPolynomial.coeff_coe, ← mem_support_iff])
  have hle {r : MvPolynomial σ R} (hr : r ≠ 0) :
      (r : MvPowerSeries σ R).order ≤ r.totalDegree := by
    obtain ⟨s, hs⟩ := support_nonempty.mpr hr
    exact (horder hs).trans (by exact_mod_cast le_totalDegree hs)
  obtain ⟨a, ha⟩ := ENat.ne_top_iff_exists.mp ((hle hp).trans_lt (ENat.natCast_lt_top _)).ne
  obtain ⟨b, hb⟩ := ENat.ne_top_iff_exists.mp ((hle hq).trans_lt (ENat.natCast_lt_top _)).ne
  -- The product is homogeneous of degree `n`, so `n` is its order.
  have hn : ((p * q : MvPolynomial σ R) : MvPowerSeries σ R).order = n := by
    obtain ⟨s, hs⟩ := support_nonempty.mpr hpq
    have hdeg {s : σ →₀ ℕ} (hs : s ∈ (p * q).support) : s.degree = n :=
      hweight s ▸ h (mem_support_iff.mp hs)
    rw [MvPowerSeries.order_eq_nat]
    refine ⟨⟨s, by rwa [_root_.MvPolynomial.coeff_coe, ← mem_support_iff], hdeg hs⟩,
      fun s hs' ↦ ?_⟩
    rw [_root_.MvPolynomial.coeff_coe, ← notMem_support_iff]
    exact fun hs ↦ hs'.ne (hdeg hs)
  -- Orders and total degrees of the factors both add up to `n`, so the order `a` of `p` is its
  -- total degree, and every monomial of `p` has degree between the two.
  rw [_root_.MvPolynomial.coe_mul, MvPowerSeries.order_mul, ← ha, ← hb] at hn
  have hdeg := _root_.MvPolynomial.totalDegree_mul_of_isDomain hp hq
  rw [h.totalDegree hpq] at hdeg
  have hap := ha ▸ hle hp
  have hbq := hb ▸ hle hq
  norm_cast at hn hap hbq
  intro s hs
  have h₁ := ha ▸ horder (mem_support_iff.mpr hs)
  have h₂ := le_totalDegree (mem_support_iff.mpr hs)
  rw [Finsupp.sum, ← Finsupp.degree_apply] at h₂
  norm_cast at h₁
  rw [hweight]
  omega

/-- Without zero divisors, the right factor of a nonzero homogeneous product is homogeneous, of
degree its total degree. -/
theorem of_mul_right {σ R : Type*} [CommSemiring R] [NoZeroDivisors R] {p q : MvPolynomial σ R}
    {n : ℕ} (h : (p * q).IsHomogeneous n) (hpq : p * q ≠ 0) : q.IsHomogeneous q.totalDegree :=
  of_mul_left (mul_comm p q ▸ h) (mul_comm p q ▸ hpq)

end MvPolynomial.IsHomogeneous

namespace TauCeti

open MvPolynomial

variable {σ R : Type*} [CommSemiring R]

/-- A homogeneous polynomial of degree `n` in finitely many variables evaluates as the sum, over
the exponent vectors `l` of degree `n`, of its coefficient at `l` times `∏ i, v i ^ l i`. -/
theorem eval_coe_homogeneousSubmodule_eq_sum [Fintype σ] [DecidableEq σ] {n : ℕ}
    (p : homogeneousSubmodule σ R n) (v : σ → R) :
    eval v (p : MvPolynomial σ R) = ∑ l ∈ Finset.univ.finsuppAntidiag n,
      (p : MvPolynomial σ R).coeff l * ∏ i, v i ^ l i := by
  simpa using ((mem_homogeneousSubmodule n _).mp p.2).aeval_eq_sum_finsuppAntidiag v

end TauCeti

namespace MvPolynomial

variable {σ R : Type*}

section CommSemiring

variable [CommSemiring R]

/-- Changing coefficients commutes with taking a homogeneous component. -/
theorem map_homogeneousComponent {S : Type*} [CommSemiring S] (f : R →+* S)
    (n : ℕ) (p : MvPolynomial σ R) :
    (homogeneousComponent n p).map f = homogeneousComponent n (p.map f) := by
  ext e
  simp only [coeff_map, coeff_homogeneousComponent]
  split_ifs <;> simp

/-- The homogeneous component in the total degree of a nonzero polynomial is nonzero. -/
theorem homogeneousComponent_totalDegree_ne_zero (p : MvPolynomial σ R) (hp : p ≠ 0) :
    homogeneousComponent p.totalDegree p ≠ 0 := by
  -- Mathlib defines ordinary homogeneous components as weighted components at weight one.
  have component_eq : homogeneousComponent p.totalDegree p =
      weightedHomogeneousComponent (1 : σ → ℕ) p.totalDegree p := rfl
  rw [component_eq]
  simpa only [weightInitialForm_def, weightedTotalDegree_one] using
    (weightInitialForm_eq_zero_iff (1 : σ → ℕ) p).not.mpr hp

/-- The degree-one component of a polynomial in finitely many variables is the linear form whose
coefficient of `X i` is the coefficient of `X i` in the polynomial. -/
theorem homogeneousComponent_one_eq_sum [Fintype σ] (φ : MvPolynomial σ R) :
    homogeneousComponent 1 φ = ∑ i, φ.coeff (Finsupp.single i 1) • X i := by
  classical
  ext d
  simp only [coeff_homogeneousComponent, coeff_sum, coeff_smul, coeff_X, smul_eq_mul, mul_ite,
    mul_one, mul_zero]
  split_ifs with hd
  · obtain ⟨i, rfl⟩ := (Finsupp.sum_eq_one_iff d).1 <| by
      rw [Finsupp.sum, ← Finsupp.degree_apply]
      exact hd
    simp [Finsupp.single_left_inj one_ne_zero]
  · refine (Finset.sum_eq_zero fun i _ ↦ ite_eq_right ?_).symm
    rintro rfl
    simp at hd

/-- With no variables, every homogeneous polynomial of positive degree is zero. -/
@[simp]
theorem homogeneousSubmodule_succ_eq_bot_of_isEmpty [IsEmpty σ] (n : ℕ) :
    homogeneousSubmodule σ R (n + 1) = ⊥ := by
  refine eq_bot_iff.2 fun p hp ↦ ?_
  rw [Submodule.mem_bot, eq_C_of_isEmpty p,
    ((mem_homogeneousSubmodule _ _).1 hp).coeff_eq_zero (by simp), map_zero]

end CommSemiring

section Field

/-- **Averaging over the `n`-th roots of unity.** If scaling the point `x` by every `n`-th root of
unity `ζ ^ j` scales the value of `P` by `(ζ ^ j) ^ a`, then the value of `P` at `x` is the sum of
the values of its homogeneous components of degree congruent to `a` modulo `n`. -/
theorem eval_eq_sum_homogeneousComponent_of_eval_smul {K : Type*} [Field K]
    (P : MvPolynomial σ K) {n : ℕ} [NeZero n] {ζ : K} (hζ : IsPrimitiveRoot ζ n) (a : ℤ)
    (x : σ → K) (hx : ∀ j : ℕ, eval ((ζ ^ j) • x) P = (ζ ^ j) ^ a * eval x P) :
    eval x P = ∑ d ∈ (Finset.range (P.totalDegree + 1)).filter (fun d : ℕ => (n : ℤ) ∣ d - a),
      eval x (homogeneousComponent d P) := by
  have : NeZero (n : K) := hζ.neZero'
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (NeZero.ne n)
  have hn : (n : K) ≠ 0 := NeZero.ne _
  set E : ℕ → K := fun d => eval x (homogeneousComponent d P)
  -- The value at `ζ ^ j • x`, expanded by homogeneous components.
  have hexp : ∀ j : ℕ, eval ((ζ ^ j) • x) P =
      ∑ d ∈ Finset.range (P.totalDegree + 1), (ζ ^ j) ^ (d : ℤ) * E d := fun j => by
    conv_lhs => rw [← sum_homogeneousComponent P]
    rw [map_sum]
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [(homogeneousComponent_isHomogeneous d P).eval_smul, zpow_natCast]
  -- Weighting by `(ζ ^ j) ^ (-a)` and summing over `j` keeps exactly the degrees `d ≡ a`.
  have hweight : ∀ (j : ℕ) (d : ℕ), (ζ ^ j) ^ (-a) * (ζ ^ j) ^ (d : ℤ) = (ζ ^ ((d : ℤ) - a)) ^ j :=
    fun j d => by
      rw [← zpow_add₀ (pow_ne_zero _ hζ0), neg_add_eq_sub, ← zpow_natCast, ← zpow_mul,
        ← zpow_natCast, ← zpow_mul, mul_comm]
  refine mul_left_cancel₀ hn ?_
  calc (n : K) * eval x P
      = ∑ j : Fin n, (ζ ^ (j : ℕ)) ^ (-a) * eval ((ζ ^ (j : ℕ)) • x) P := by
        simp_rw [hx, ← mul_assoc, ← zpow_add₀ (pow_ne_zero _ hζ0), neg_add_cancel, zpow_zero,
          one_mul, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    _ = ∑ d ∈ Finset.range (P.totalDegree + 1),
          (∑ j : Fin n, (ζ ^ ((d : ℤ) - a)) ^ (j : ℕ)) * E d := by
        simp_rw [hexp, Finset.mul_sum, ← mul_assoc, hweight, Finset.sum_mul]
        exact Finset.sum_comm
    _ = (n : K) * ∑ d ∈ (Finset.range (P.totalDegree + 1)).filter
          (fun d : ℕ => (n : ℤ) ∣ d - a), E d := by
        simp_rw [hζ.sum_zpow_pow_eq, Finset.sum_filter, Finset.mul_sum, ite_mul, zero_mul,
          mul_ite, mul_zero]

end Field

section CommRing

variable [CommRing R]

/-- The coefficient of `X ^ k` in a product of linear factors `X - C Ψ`, whose constant terms `Ψ`
are all homogeneous of degree `m`, is homogeneous of degree `m * (s.card - k)`. -/
theorem isHomogeneous_coeff_prod_X_sub_C {ι : Type*} (s : Finset ι)
    (Ψ : ι → MvPolynomial σ R) {m : ℕ} (hΨ : ∀ i ∈ s, (Ψ i).IsHomogeneous m) (k : ℕ) :
    ((∏ i ∈ s, (Polynomial.X - Polynomial.C (Ψ i))).coeff k).IsHomogeneous
      (m * (s.card - k)) := by
  classical
  induction s using Finset.induction_on generalizing k with
  | empty =>
    rw [Finset.prod_empty, Polynomial.coeff_one]
    split_ifs
    · simpa using isHomogeneous_one σ R
    · exact isHomogeneous_zero σ R _
  | insert a s ha ih =>
    have hs (k : ℕ) := ih (fun i hi => hΨ i (Finset.mem_insert_of_mem hi)) k
    have ha' := hΨ a (Finset.mem_insert_self a s)
    rw [Finset.prod_insert ha, Finset.card_insert_of_notMem ha, mul_comm]
    rcases k with _ | j
    · rw [Polynomial.mul_coeff_zero, Polynomial.coeff_sub, Polynomial.coeff_X_zero,
        Polynomial.coeff_C_zero, zero_sub, Nat.sub_zero, mul_add_one]
      have h0 := hs 0
      rw [Nat.sub_zero] at h0
      exact h0.mul ha'.neg
    · rw [Polynomial.coeff_mul_X_sub_C, Nat.add_sub_add_right]
      refine (hs j).sub ?_
      by_cases hj : j + 1 ≤ s.card
      · have hdeg : s.card - j = s.card - (j + 1) + 1 := by omega
        rw [hdeg, mul_add_one]
        exact (hs (j + 1)).mul ha'
      · have hle : (∏ i ∈ s, (Polynomial.X - Polynomial.C (Ψ i))).natDegree ≤ s.card := by
          refine (Polynomial.natDegree_prod_le _ _).trans ?_
          simpa using Finset.sum_le_card_nsmul s _ 1 fun i _ =>
            Polynomial.natDegree_X_sub_C_le (Ψ i)
        have hlt : (∏ i ∈ s, (Polynomial.X - Polynomial.C (Ψ i))).natDegree < j + 1 := by
          omega
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt, zero_mul]
        exact isHomogeneous_zero σ R _

end CommRing

end MvPolynomial

namespace TauCeti

open MvPolynomial

/-- The `n`-th power of a linear form is homogeneous of degree `n`. -/
theorem sum_smul_X_pow_mem_homogeneousSubmodule {σ R : Type*} [Fintype σ] [CommSemiring R]
    (x : σ → R) (n : ℕ) :
    (∑ i, x i • X i : MvPolynomial σ R) ^ n ∈ homogeneousSubmodule σ R n := by
  have h1 : (∑ i, x i • X i : MvPolynomial σ R) ∈ homogeneousSubmodule σ R 1 :=
    Submodule.sum_mem _ fun i _ ↦
      Submodule.smul_mem _ _ ((mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X R i))
  simpa using ((mem_homogeneousSubmodule 1 _).mp h1).pow n

end TauCeti

namespace Ideal

open MvPolynomial

/-- An element of `K * Iᵛ`, where `I` is generated by the family `a`, is exactly the value at `a`
of a homogeneous polynomial of degree `ν` whose coefficients lie in `K`. For `K = ⊤` this is
`Ideal.mem_span_pow_iff_exists_isHomogeneous`. -/
theorem mem_mul_span_pow_iff_exists_isHomogeneous {ι R : Type*} [CommSemiring R] (K : Ideal R)
    (a : ι → R) (ν : ℕ) (y : R) :
    y ∈ K * span (Set.range a) ^ ν ↔
      ∃ F : MvPolynomial ι R, F.IsHomogeneous ν ∧ (∀ e, F.coeff e ∈ K) ∧ F.eval a = y := by
  constructor
  · intro hy
    refine Submodule.mul_induction_on hy (fun k hk z hz ↦ ?_) ?_
    · obtain ⟨P, hP, rfl⟩ := (mem_span_pow_iff_exists_isHomogeneous a z).mp hz
      exact ⟨C k * P, hP.C_mul k, fun e ↦ by simpa using K.mul_mem_right _ hk, by simp⟩
    · rintro _ _ ⟨F, hF, hFK, rfl⟩ ⟨G, hG, hGK, rfl⟩
      exact ⟨F + G, hF.add hG, fun e ↦ by simpa using K.add_mem (hFK e) (hGK e), by simp⟩
  · rintro ⟨F, hF, hFK, rfl⟩
    rw [F.as_sum, map_sum]
    refine Ideal.sum_mem _ fun e he ↦ ?_
    rw [← mul_one (F.coeff e), ← C_mul_monomial, eval_mul, eval_C]
    refine mul_mem_mul (hFK e) ((mem_span_pow_iff_exists_isHomogeneous a _).mpr
      ⟨monomial e 1, isHomogeneous_monomial 1 ?_, rfl⟩)
    rw [Finsupp.degree_eq_weight_one]
    exact hF (mem_support_iff.mp he)

/-- Let `J` be the ideal generated by a family `a` that is quasi-regular, in the sense that a
homogeneous polynomial `F` of degree `ν` with `F(a) ∈ Jᵛ⁺¹` has all its coefficients in `J`. If `x`
is a nonzerodivisor modulo `J`, then `x` is a nonzerodivisor modulo every power `Jᵘ`. -/
theorem mem_span_pow_of_mul_mem_span_pow {ι R : Type*} [CommSemiring R] {a : ι → R}
    (hQ : ∀ {ν : ℕ} {F : MvPolynomial ι R}, F.IsHomogeneous ν →
      F.eval a ∈ span (Set.range a) ^ (ν + 1) → ∀ e, F.coeff e ∈ span (Set.range a))
    {x : R} (hx : ∀ y, x * y ∈ span (Set.range a) → y ∈ span (Set.range a)) (μ : ℕ) {y : R}
    (hy : x * y ∈ span (Set.range a) ^ μ) : y ∈ span (Set.range a) ^ μ := by
  induction μ generalizing y with
  | zero => simp
  | succ μ ih =>
    obtain ⟨P, hP, rfl⟩ := (mem_span_pow_iff_exists_isHomogeneous a y).mp
      (ih (pow_le_pow_right (Nat.le_succ μ) hy))
    have hc := hQ (hP.C_mul x) (by simpa using hy)
    rw [pow_succ']
    exact (mem_mul_span_pow_iff_exists_isHomogeneous _ a μ _).mpr
      ⟨P, hP, fun e ↦ hx _ (by simpa using hc e), rfl⟩

end Ideal

/-- The value of a homogeneous polynomial of degree `ν` at a family of elements of an ideal `I`
lies in `Iᵛ`. -/
theorem MvPolynomial.IsHomogeneous.eval_mem_pow {ι R : Type*} [CommSemiring R] {I : Ideal R}
    {a : ι → R} (ha : ∀ i, a i ∈ I) {ν : ℕ} {F : MvPolynomial ι R} (hF : F.IsHomogeneous ν) :
    F.eval a ∈ I ^ ν :=
  Ideal.pow_right_mono (Ideal.span_le.mpr (Set.range_subset_iff.mpr ha)) ν
    ((Ideal.mem_span_pow_iff_exists_isHomogeneous a _).mpr ⟨F, hF, rfl⟩)

/-- A homogeneous polynomial of degree `ν + 1` in `n + 1` variables is `G + H * X_last`, with `G`
homogeneous of degree `ν + 1` in the first `n` variables and `H` homogeneous of degree `ν`. -/
theorem MvPolynomial.IsHomogeneous.exists_eq_rename_castSucc_add_mul_X_last {R : Type*}
    [CommSemiring R] {n ν : ℕ} {F : MvPolynomial (Fin (n + 1)) R} (hF : F.IsHomogeneous (ν + 1)) :
    ∃ G : MvPolynomial (Fin n) R, G.IsHomogeneous (ν + 1) ∧ ∃ H, H.IsHomogeneous ν ∧
      F = rename Fin.castSucc G + H * X (Fin.last n) := by
  -- First split `F` without homogeneity, then take homogeneous components.
  have hsplit (P : MvPolynomial (Fin (n + 1)) R) :
      ∃ G H, P = rename Fin.castSucc G + H * X (Fin.last n) := by
    induction P using MvPolynomial.induction_on with
    | C r => exact ⟨C r, 0, by simp⟩
    | add p q hp hq =>
      obtain ⟨G, H, rfl⟩ := hp
      obtain ⟨G', H', rfl⟩ := hq
      exact ⟨G + G', H + H', by simp only [map_add]; ring⟩
    | mul_X p i hp =>
      obtain ⟨G, H, rfl⟩ := hp
      induction i using Fin.lastCases with
      | last => exact ⟨0, rename Fin.castSucc G + H * X (Fin.last n), by simp⟩
      | cast j => exact ⟨G * X j, H * X j.castSucc, by simp only [map_mul, rename_X]; ring⟩
  obtain ⟨G, H, hGH⟩ := hsplit F
  refine ⟨homogeneousComponent (ν + 1) G, homogeneousComponent_isHomogeneous _ _,
    homogeneousComponent ν H, homogeneousComponent_isHomogeneous _ _, ?_⟩
  rw [← homogeneousComponent_eq_self hF, hGH, map_add, ← rename_homogeneousComponent,
    (isHomogeneous_X R _).homogeneousComponent_mul_right]
  simp
