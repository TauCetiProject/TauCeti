module

public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.MvPolynomial.Localization
public import Mathlib.RingTheory.Polynomial.Basic

import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Submodules of free modules over polynomial rings are finitely generated up to torsion

Let `A` be a domain, which need not be Noetherian, and `σ`, `ι` finite types. Every submodule `K`
of `(MvPolynomial σ A)ⁱ` is finitely generated up to torsion: a finite subset of `K` spans a
submodule containing a nonzero multiple `b • x`, with `b : A`, of every `x ∈ K`. Indeed, over the
Noetherian ring `MvPolynomial σ (FractionRing A)` the submodule generated by `K` is finitely
generated, by finitely many elements of `K`, and clearing the denominators of the coefficients
expressing an element of `K` in terms of these generators gives the multiple `b • x`.

## Main declarations

* `Submodule.exists_finset_smul_mem_span_of_isDomain`: over a domain, a submodule of a finite
  free module over a polynomial ring in finitely many variables is finitely generated up to
  torsion.
-/

public section

namespace Submodule

attribute [local instance] MvPolynomial.algebraMvPolynomial in
/-- Over a domain `A`, every submodule `K` of `(MvPolynomial σ A)ⁱ` is finitely generated up to
torsion: some finite subset of `K` spans a submodule containing a nonzero multiple of each element
of `K`. This holds because `K` becomes finitely generated over the Noetherian ring
`MvPolynomial σ (FractionRing A)`. -/
theorem exists_finset_smul_mem_span_of_isDomain {A : Type*} [CommRing A] [IsDomain A]
    {σ ι : Type*} [Finite σ] [Finite ι] (K : Submodule (MvPolynomial σ A) (ι → MvPolynomial σ A)) :
    ∃ s : Finset (ι → MvPolynomial σ A), (s : Set (ι → MvPolynomial σ A)) ⊆ K ∧
      ∀ x ∈ K, ∃ b ∈ nonZeroDivisors A,
        b • x ∈ span (MvPolynomial σ A) (s : Set (ι → MvPolynomial σ A)) := by
  classical
  let F := FractionRing A
  let P := MvPolynomial σ A
  let PK := MvPolynomial σ F
  let S : Submonoid P := (nonZeroDivisors A).map (MvPolynomial.C (σ := σ))
  let f : (ι → P) →ₗ[P] (ι → PK) := (Algebra.linearMap P PK).compLeft ι
  have hf : Function.Injective f := fun x y h ↦ funext fun i ↦
    MvPolynomial.map_injective _ (IsFractionRing.injective A F) (congrFun h i)
  -- Finitely many elements of `K` span the image of `K` over the Noetherian ring `PK`.
  obtain ⟨s', hs'K, hspan⟩ := (fg_span_iff_fg_span_finset_subset (R := PK) (f '' K)).mp
    (IsNoetherian.noetherian _)
  let s := s'.preimage f hf.injOn
  have hs : f '' s = s' := by
    rw [Finset.coe_preimage]
    exact Set.image_preimage_eq_of_subset (hs'K.trans (Set.image_subset_range _ _))
  refine ⟨s, fun y hy ↦ ?_, fun x hx ↦ ?_⟩
  · obtain ⟨z, hz, hzy⟩ := hs'K (Finset.mem_preimage.mp hy)
    exact hf hzy ▸ hz
  have hfx : f x ∈ span PK (f '' s) := hs ▸ hspan ▸ subset_span ⟨x, hx, rfl⟩
  rw [← Finset.coe_image, mem_span_finset] at hfx
  obtain ⟨c, -, hc⟩ := hfx
  -- Clear the denominators of the coefficients.
  rw [Finset.sum_image fun y _ z _ h ↦ hf h] at hc
  obtain ⟨⟨b, hb⟩, hbc⟩ := IsLocalization.exist_integer_multiples_of_finset S
    (s.image fun y ↦ c (f y))
  choose a ha using fun y (hy : y ∈ s) ↦ hbc _ (Finset.mem_image_of_mem _ hy)
  obtain ⟨b, hb', rfl⟩ := hb
  refine ⟨b, hb', ?_⟩
  have key : f (∑ y ∈ s.attach, a y y.2 • y.1) = f (b • x) := by
    simp only [map_sum, map_smul] at ha ⊢
    rw [← IsScalarTower.algebraMap_smul P b x, map_smul, ← hc, Finset.smul_sum]
    rw [← Finset.sum_attach s]
    refine Finset.sum_congr rfl fun y _ ↦ ?_
    rw [← algebraMap_smul PK (a y y.2), ha y y.2, smul_assoc, MvPolynomial.algebraMap_eq]
  rw [← hf key]
  exact sum_mem fun y _ ↦ smul_mem _ _ (subset_span y.2)

end Submodule
