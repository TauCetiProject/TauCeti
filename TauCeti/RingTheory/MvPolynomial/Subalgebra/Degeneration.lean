/-!
# The weight-initial algebra and fibres of the subalgebra weight Rees algebra

For a subalgebra `A` of `MvPolynomial σ R` and nonnegative integral weights `w : σ → ℕ`, the
*weight-initial algebra* `A.weightInitialAlgebra w` is the `R`-subalgebra generated by the
maximal-weight initial forms `weightInitialForm w f` of all elements `f ∈ A`. Restricting the
ambient symbol map `TauCeti.MvPolynomial.weightReesSymbol R w` along the canonical embedding of
`A.weightReesAlgebra w` into `TauCeti.MvPolynomial.weightReesAlgebra R w` produces the subalgebra
symbol map `A.weightReesSymbol w : A.weightReesAlgebra w →ₐ[R] MvPolynomial σ R`.

Even over an arbitrary commutative semiring (possibly with zero divisors, where `weightInitialForm`
need not be multiplicative), the image of `A.weightReesSymbol w` is `A.weightInitialAlgebra w`,
and the underlying `R`-submodule of `A.weightInitialAlgebra w` is already the `R`-linear span of
`weightInitialForm w '' A` (`Subalgebra.toSubmodule_weightInitialAlgebra`). Consequently
`A.weightInitialAlgebra w` is weight-homogeneous, and `A.weightInitialAlgebra w = A` holds if and
only if `A` is weight-homogeneous (`Subalgebra.weightInitialAlgebra_eq_self_iff`). The kernel of
`A.weightReesSymbol w` is generated by the central Rees parameter `t`
(`Subalgebra.ker_weightReesSymbol`).

Over a commutative ring `R`, these descriptions identify all specialization fibres of the induced
Rees algebra `A.weightReesAlgebra w` over `R[t]`:

* **Special fibre at `t = 0`**: quotienting by `t`
  (`Subalgebra.quotientSpanXWeightReesAlgebraEquiv`) and tensor base change `R ⊗[R[t]] -` along
  evaluation at `0` (`Subalgebra.baseChangeZeroWeightReesAlgebraEquiv`) both recover
  `A.weightInitialAlgebra w`.
* **General fibre at units**: for every unit `a` of `R` (and in particular at `t = 1`), quotienting
  by `t - a` (`Subalgebra.quotientSpanXSubAlgebraMapWeightReesAlgebraEquiv`,
  `Subalgebra.quotientSpanXSubOneWeightReesAlgebraEquiv`) and tensor base change `R ⊗[R[t]] -`
  along evaluation at `a` (`Subalgebra.baseChangeEvalWeightReesAlgebraEquiv`,
  `Subalgebra.baseChangeOneWeightReesAlgebraEquiv`) recover `A`.

Over a field `k`, `A.weightReesAlgebra w` is flat over `k[t]` (`Subalgebra.flat_weightReesAlgebra`),
and `a = 0` versus `a ≠ 0` identifies every `k`-rational fibre and base change of the degeneration,
without any finite-generation or SAGBI assumption on `A`.

## Main definitions

* `Subalgebra.weightInitialAlgebra`: the subalgebra generated by `weightInitialForm w '' A`.
* `Subalgebra.weightReesInclusion`: the embedding of `A.weightReesAlgebra w` into the ambient
  polynomial weight Rees algebra, and `Subalgebra.weightReesMap`: functoriality for `A ≤ B`.
* `Subalgebra.weightReesSymbol`: the specialization `A.weightReesAlgebra w →ₐ[R] MvPolynomial σ R`
  sending `b tⁿ` to the weight-`n` component of `b`.
* `Subalgebra.quotientSpanXWeightReesAlgebraEquiv`,
  `Subalgebra.baseChangeZeroWeightReesAlgebraEquiv`: the special fibre at `t = 0`.
* `Subalgebra.quotientSpanXSubAlgebraMapWeightReesAlgebraEquiv`,
  `Subalgebra.quotientSpanXSubOneWeightReesAlgebraEquiv`,
  `Subalgebra.baseChangeEvalWeightReesAlgebraEquiv`,
  `Subalgebra.baseChangeOneWeightReesAlgebraEquiv`: the fibres at units and at `t = 1`.

## References

* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
* D. Eisenbud, *Commutative Algebra with a View Toward Algebraic Geometry*, GTM 150, §15.8.
-/

public section

open scoped Polynomial TensorProduct
open DirectSum MvPolynomial TauCeti TauCeti.MvPolynomial

namespace Subalgebra

section WeightInitialAlgebra

variable {σ R : Type*} [CommSemiring R]

/-- The weight-initial algebra of a polynomial subalgebra `A` for the weights `w`: the subalgebra
generated by the maximal-weight initial forms of all elements of `A`. -/
noncomputable def weightInitialAlgebra (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    Subalgebra R (MvPolynomial σ R) :=
  Algebra.adjoin R (weightInitialForm w '' A)

/-- Unfolding lemma for `Subalgebra.weightInitialAlgebra`. -/
theorem weightInitialAlgebra_def (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    A.weightInitialAlgebra w = Algebra.adjoin R (weightInitialForm w '' A) := (rfl)

theorem weightInitialForm_mem_weightInitialAlgebra {A : Subalgebra R (MvPolynomial σ R)}
    (w : σ → ℕ) {f : MvPolynomial σ R} (hf : f ∈ A) :
    weightInitialForm w f ∈ A.weightInitialAlgebra w :=
  Algebra.subset_adjoin ⟨f, hf, rfl⟩

/-- To bound a weight-initial algebra inside another subalgebra, it suffices to check the initial
forms of all members. -/
theorem weightInitialAlgebra_le_iff {A B : Subalgebra R (MvPolynomial σ R)} (w : σ → ℕ) :
    A.weightInitialAlgebra w ≤ B ↔ ∀ f ∈ A, weightInitialForm w f ∈ B := by
  rw [weightInitialAlgebra_def, Algebra.adjoin_le_iff, Set.image_subset_iff]
  rfl

theorem weightInitialAlgebra_mono {A B : Subalgebra R (MvPolynomial σ R)} (h : A ≤ B) (w : σ → ℕ) :
    A.weightInitialAlgebra w ≤ B.weightInitialAlgebra w :=
  Algebra.adjoin_mono (Set.image_mono h)

@[simp]
theorem weightInitialAlgebra_zero_weight (A : Subalgebra R (MvPolynomial σ R)) :
    A.weightInitialAlgebra 0 = A := by
  rw [weightInitialAlgebra_def]
  have himg : weightInitialForm (0 : σ → ℕ) '' (A : Set (MvPolynomial σ R)) = A := by
    ext p
    simp
  rw [himg, Algebra.adjoin_eq]

end WeightInitialAlgebra

section WeightReesSymbol

variable {σ R : Type*} [CommSemiring R]

/-- The canonical inclusion of the subalgebra weight Rees algebra into the ambient polynomial
weight Rees algebra. -/
noncomputable def weightReesInclusion (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    A.weightReesAlgebra w →ₐ[R] TauCeti.MvPolynomial.weightReesAlgebra R w :=
  ((Polynomial.mapAlgHom A.val).comp (A.weightReesAlgebra w).val).codRestrict _ fun g ↦
    TauCeti.mem_coeffSubalgebra_iff.mpr fun n ↦ by
      simpa using (A.mem_weightFiltration_iff w).mp (TauCeti.mem_coeffSubalgebra_iff.mp g.2 n)

@[simp]
theorem coe_weightReesInclusion (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)
    (g : A.weightReesAlgebra w) :
    (A.weightReesInclusion w g : (MvPolynomial σ R)[X]) = (g : A[X]).map A.val := (rfl)

theorem weightReesInclusion_injective (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    Function.Injective (A.weightReesInclusion w) := by
  intro f g h
  apply Subtype.ext
  exact Polynomial.map_injective _ Subtype.val_injective (congrArg Subtype.val h)

@[simp]
theorem weightReesInclusion_monomial (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)
    {n : ℕ} {b : A} (hb : b ∈ A.weightFiltration w n) :
    A.weightReesInclusion w (coeffSubalgebra.monomial _ n b hb) =
      coeffSubalgebra.monomial _ n (b : MvPolynomial σ R) ((A.mem_weightFiltration_iff w).mp hb) :=
  Subtype.ext (by simp)

@[simp]
theorem weightReesInclusion_X (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    A.weightReesInclusion w (coeffSubalgebra.X _ (A.one_mem_weightFiltration_one w)) =
      coeffSubalgebra.X _ (TauCeti.MvPolynomial.one_mem_weightFiltration_one R w) :=
  Subtype.ext (by simp)

/-- Functoriality of the weight Rees algebra for an inclusion of subalgebras `A ≤ B`, as a map of
`R[t]`-algebras. -/
noncomputable def weightReesMap {A B : Subalgebra R (MvPolynomial σ R)} (h : A ≤ B) (w : σ → ℕ) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := coeffSubalgebra.algebra (B.weightFiltration w) (B.one_mem_weightFiltration_one w)
    A.weightReesAlgebra w →ₐ[R[X]] B.weightReesAlgebra w :=
  letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  letI := coeffSubalgebra.algebra (B.weightFiltration w) (B.one_mem_weightFiltration_one w)
  { __ := (((Polynomial.mapAlgHom (Subalgebra.inclusion h)).comp
        (A.weightReesAlgebra w).val).codRestrict (B.weightReesAlgebra w) fun g ↦
          TauCeti.mem_coeffSubalgebra_iff.mpr fun n ↦ by
            simpa using (A.mem_weightFiltration_iff w).mp
              (TauCeti.mem_coeffSubalgebra_iff.mp g.2 n)).toRingHom
    commutes' p := Subtype.ext <| by
      simp [coeffSubalgebra.coe_algebraMap, Polynomial.map_map] }

@[simp]
theorem coe_weightReesMap {A B : Subalgebra R (MvPolynomial σ R)} (h : A ≤ B) (w : σ → ℕ)
    (g : A.weightReesAlgebra w) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := coeffSubalgebra.algebra (B.weightFiltration w) (B.one_mem_weightFiltration_one w)
    (weightReesMap h w g : B[X]) = (g : A[X]).map (Subalgebra.inclusion h) := (rfl)

@[simp]
theorem weightReesInclusion_weightReesMap {A B : Subalgebra R (MvPolynomial σ R)} (h : A ≤ B)
    (w : σ → ℕ) (g : A.weightReesAlgebra w) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := coeffSubalgebra.algebra (B.weightFiltration w) (B.one_mem_weightFiltration_one w)
    B.weightReesInclusion w (weightReesMap h w g) = A.weightReesInclusion w g := by
  apply Subtype.ext
  simp [Polynomial.map_map]
  rfl

/-- The symbol map on the subalgebra weight Rees algebra: `b tⁿ`, for `b ∈ A` of weight at most `n`,
is sent to the weighted homogeneous component of weight `n` of `b`. -/
noncomputable def weightReesSymbol (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    A.weightReesAlgebra w →ₐ[R] MvPolynomial σ R :=
  (TauCeti.MvPolynomial.weightReesSymbol R w).comp (A.weightReesInclusion w)

theorem weightReesSymbol_def (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    A.weightReesSymbol w =
      (TauCeti.MvPolynomial.weightReesSymbol R w).comp (A.weightReesInclusion w) := (rfl)

/-- The coefficient of `X^v` in the symbol of `g` is the coefficient of `X^v` in the `weight w v`
term of `g`. -/
theorem coeff_weightReesSymbol (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)
    (g : A.weightReesAlgebra w) (v : σ →₀ ℕ) :
    (A.weightReesSymbol w g).coeff v =
      (((g : A[X]).coeff (Finsupp.weight w v) : A) : MvPolynomial σ R).coeff v := by
  rw [weightReesSymbol_def, AlgHom.comp_apply, TauCeti.MvPolynomial.coeff_weightReesSymbol,
    coe_weightReesInclusion, Polynomial.coeff_map]
  rfl

@[simp]
theorem weightReesSymbol_monomial (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)
    {n : ℕ} {b : A} (hb : b ∈ A.weightFiltration w n) :
    A.weightReesSymbol w (coeffSubalgebra.monomial _ n b hb) =
      weightedHomogeneousComponent w n (b : MvPolynomial σ R) := by
  rw [weightReesSymbol_def, AlgHom.comp_apply, weightReesInclusion_monomial,
    TauCeti.MvPolynomial.weightReesSymbol_monomial]

@[simp]
theorem weightReesSymbol_X (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    A.weightReesSymbol w (coeffSubalgebra.X _ (A.one_mem_weightFiltration_one w)) = 0 := by
  rw [weightReesSymbol_def, AlgHom.comp_apply, weightReesInclusion_X,
    TauCeti.MvPolynomial.weightReesSymbol_X]

@[simp]
theorem weightReesSymbol_weightReesMap {A B : Subalgebra R (MvPolynomial σ R)} (h : A ≤ B)
    (w : σ → ℕ) (g : A.weightReesAlgebra w) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := coeffSubalgebra.algebra (B.weightFiltration w) (B.one_mem_weightFiltration_one w)
    B.weightReesSymbol w (weightReesMap h w g) = A.weightReesSymbol w g := by
  rw [weightReesSymbol_def, AlgHom.comp_apply, weightReesInclusion_weightReesMap,
    ← AlgHom.comp_apply, ← weightReesSymbol_def]

@[simp]
theorem weightReesSymbol_algebraMap (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) (p : R[X]) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    A.weightReesSymbol w (algebraMap R[X] (A.weightReesAlgebra w) p) = C (p.eval 0) := by
  let := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let := coeffSubalgebra.isScalarTower (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  have h : (A.weightReesSymbol w).comp (IsScalarTower.toAlgHom R R[X] (A.weightReesAlgebra w)) =
      (Algebra.ofId R (MvPolynomial σ R)).comp (Polynomial.aeval (0 : R)) := by
    ext
    simp
  simpa [MvPolynomial.algebraMap_eq] using congr($h p)

/-- Every element in the range of `A.weightReesSymbol w` lies in the `R`-linear span of the initial
forms of elements of `A`: the `n`-th coefficient of a Rees polynomial has weight at most `n`, so its
weight-`n` component is either zero or its initial form. -/
private theorem range_weightReesSymbol_le_span (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    (A.weightReesSymbol w).range.toSubmodule ≤ Submodule.span R (weightInitialForm w '' A) := by
  intro x hx
  obtain ⟨g, rfl⟩ := (A.weightReesSymbol w).mem_range.mp hx
  have hg : g = ∑ n ∈ (g : A[X]).support,
      coeffSubalgebra.monomial (A.weightFiltration w) n ((g : A[X]).coeff n)
        (TauCeti.mem_coeffSubalgebra_iff.mp g.2 n) :=
    Subtype.ext (by simpa using (g : A[X]).as_sum_support)
  rw [hg, map_sum]
  refine Submodule.sum_mem _ fun n _ ↦ ?_
  rw [weightReesSymbol_monomial]
  set f : MvPolynomial σ R := (((g : A[X]).coeff n : A) : MvPolynomial σ R)
  have hfn : f ∈ TauCeti.MvPolynomial.weightFiltration R w n :=
    (A.mem_weightFiltration_iff w).mp (TauCeti.mem_coeffSubalgebra_iff.mp g.2 n)
  rcases (mem_weightFiltration_iff_weightedTotalDegree_le.mp hfn).lt_or_eq with hlt | heq
  · rw [weightedHomogeneousComponent_eq_zero _ _ hlt]
    exact zero_mem _
  · rw [← heq, ← weightInitialForm_def]
    exact Submodule.subset_span ⟨f, ((g : A[X]).coeff n).2, rfl⟩

/-- The image of the subalgebra symbol map is the weight-initial algebra. -/
@[simp]
theorem range_weightReesSymbol (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    (A.weightReesSymbol w).range = A.weightInitialAlgebra w := by
  refine le_antisymm (fun x hx ↦ ?_) ((A.weightInitialAlgebra_le_iff w).mpr fun f hf ↦ ?_)
  · exact (Submodule.span_le (p := (A.weightInitialAlgebra w).toSubmodule).mpr
      Algebra.subset_adjoin) (A.range_weightReesSymbol_le_span w hx)
  · refine (A.weightReesSymbol w).mem_range.mpr
      ⟨coeffSubalgebra.monomial (A.weightFiltration w) (f.weightedTotalDegree w) ⟨f, hf⟩
        ((A.mem_weightFiltration_iff w).mpr
          (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl)), ?_⟩
    rw [weightReesSymbol_monomial, weightInitialForm_def]

/-- Even over an arbitrary commutative semiring, the weight-initial algebra of `A` is already the
`R`-linear span of the initial forms of all elements of `A`, because that span coincides with the
image of the ring homomorphism `A.weightReesSymbol w`. -/
theorem toSubmodule_weightInitialAlgebra (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    Subalgebra.toSubmodule (A.weightInitialAlgebra w) =
      Submodule.span R (weightInitialForm w '' A) := by
  refine le_antisymm ?_
    (Submodule.span_le.mpr (by rw [weightInitialAlgebra_def]; exact Algebra.subset_adjoin))
  rw [← A.range_weightReesSymbol w]
  exact A.range_weightReesSymbol_le_span w

attribute [local instance] MvPolynomial.weightedGradedAlgebra in
/-- A weight-initial algebra is homogeneous for the same weight grading. -/
theorem isHomogeneous_weightInitialAlgebra (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    SetLike.IsHomogeneous (weightedHomogeneousSubmodule R w) (A.weightInitialAlgebra w) := by
  intro n p hp
  rw [← Subalgebra.mem_toSubmodule] at hp
  change (DirectSum.decompose (weightedHomogeneousSubmodule R w) p n : MvPolynomial σ R) ∈
    Subalgebra.toSubmodule (A.weightInitialAlgebra w)
  rw [← DirectSum.Decomposition.decompose'_eq, weightedDecomposition.decompose'_apply]
  rw [A.toSubmodule_weightInitialAlgebra w] at hp ⊢
  induction hp using Submodule.span_induction with
  | mem q hq =>
    obtain ⟨f, hf, rfl⟩ := hq
    rw [weightedHomogeneousComponent_of_mem (isWeightedHomogeneous_weightInitialForm w f)]
    split_ifs
    · exact Submodule.subset_span ⟨f, hf, rfl⟩
    · exact zero_mem _
  | zero => simp
  | add x y _ _ hx hy =>
    rw [map_add]
    exact add_mem hx hy
  | smul r x _ hx =>
    rw [map_smul]
    exact Submodule.smul_mem _ r hx

attribute [local instance] MvPolynomial.weightedGradedAlgebra in
/-- A weight-homogeneous subalgebra is unchanged by taking its weight-initial algebra. -/
theorem weightInitialAlgebra_eq_of_isHomogeneous {A : Subalgebra R (MvPolynomial σ R)} {w : σ → ℕ}
    (hA : SetLike.IsHomogeneous (weightedHomogeneousSubmodule R w) A) :
    A.weightInitialAlgebra w = A := by
  refine le_antisymm ((A.weightInitialAlgebra_le_iff w).mpr fun f hf ↦ ?_) fun f hf ↦ ?_
  · rw [weightInitialForm_def, ← weightedDecomposition.decompose'_apply]
    exact hA _ hf
  · rw [← finsum_weightedHomogeneousComponent w f,
      finsum_eq_sum _ (weightedHomogeneousComponent_finsupp f)]
    refine sum_mem fun n _ ↦ ?_
    rw [← (weightedHomogeneousComponent_isWeightedHomogeneous n f).weightInitialForm w]
    apply A.weightInitialForm_mem_weightInitialAlgebra w
    rw [← weightedDecomposition.decompose'_apply]
    exact hA n hf

attribute [local instance] MvPolynomial.weightedGradedAlgebra in
/-- The fixed subalgebras of `weightInitialAlgebra` are precisely the weight-homogeneous
subalgebras. -/
theorem weightInitialAlgebra_eq_self_iff (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    A.weightInitialAlgebra w = A ↔ SetLike.IsHomogeneous (weightedHomogeneousSubmodule R w) A :=
  ⟨fun h ↦ h ▸ A.isHomogeneous_weightInitialAlgebra w, weightInitialAlgebra_eq_of_isHomogeneous⟩

@[simp]
theorem weightInitialAlgebra_weightInitialAlgebra (A : Subalgebra R (MvPolynomial σ R))
    (w : σ → ℕ) :
    (A.weightInitialAlgebra w).weightInitialAlgebra w = A.weightInitialAlgebra w :=
  weightInitialAlgebra_eq_of_isHomogeneous (A.isHomogeneous_weightInitialAlgebra w)

@[simp]
theorem weightInitialAlgebra_bot (w : σ → ℕ) :
    (⊥ : Subalgebra R (MvPolynomial σ R)).weightInitialAlgebra w = ⊥ := by
  refine le_antisymm ((weightInitialAlgebra_le_iff w).mpr ?_) bot_le
  intro f hf
  obtain ⟨r, rfl⟩ := Algebra.mem_bot.mp hf
  rw [MvPolynomial.algebraMap_eq, weightInitialForm_C, ← MvPolynomial.algebraMap_eq]
  exact Subalgebra.algebraMap_mem _ r

@[simp]
theorem weightInitialAlgebra_top (w : σ → ℕ) :
    (⊤ : Subalgebra R (MvPolynomial σ R)).weightInitialAlgebra w = ⊤ := by
  refine eq_top_iff.mpr (adjoin_range_X.symm.le.trans (Algebra.adjoin_le ?_))
  rintro _ ⟨i, rfl⟩
  rw [← weightInitialForm_X w i]
  exact weightInitialForm_mem_weightInitialAlgebra w Algebra.mem_top

/-- **Kernel of the subalgebra symbol map.** Over any commutative semiring, an element of
`A.weightReesAlgebra w` has zero symbol if and only if it is a multiple of the Rees parameter `t`
within `A.weightReesAlgebra w`: its constant term in `t` vanishes, and every higher coefficient
`g.coeff (n + 1)` has no component of weight `n + 1`, hence already lies in step `n`. -/
theorem ker_weightReesSymbol (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    RingHom.ker (A.weightReesSymbol w) =
      Ideal.span {coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w)} := by
  refine le_antisymm (fun g hg ↦ ?_) (Ideal.span_le.mpr ?_)
  · rw [RingHom.mem_ker] at hg
    have hc0 : (g : A[X]).coeff 0 = 0 := by
      apply Subtype.ext
      ext v
      simp only [ZeroMemClass.coe_zero, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
      by_contra hv
      have hfilt0 : (((g : A[X]).coeff 0 : A) : MvPolynomial σ R) ∈
          TauCeti.MvPolynomial.weightFiltration R w 0 :=
        (A.mem_weightFiltration_iff w).mp (TauCeti.mem_coeffSubalgebra_iff.mp g.2 0)
      have hvw : Finsupp.weight w v = 0 := Nat.eq_zero_of_le_zero
        (TauCeti.MvPolynomial.mem_weightFiltration_iff.mp hfilt0 v (mem_support_iff.mpr hv))
      have hsym := A.coeff_weightReesSymbol w g v
      rw [hg, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply, hvw] at hsym
      exact hv hsym.symm
    have hdiv : (g : A[X]).divX ∈ A.weightReesAlgebra w := by
      rw [TauCeti.mem_coeffSubalgebra_iff]
      intro n
      rw [Polynomial.coeff_divX, A.mem_weightFiltration_iff,
        TauCeti.MvPolynomial.mem_weightFiltration_iff]
      intro v hv
      have hfiltn : (((g : A[X]).coeff (n + 1) : A) : MvPolynomial σ R) ∈
          TauCeti.MvPolynomial.weightFiltration R w (n + 1) :=
        (A.mem_weightFiltration_iff w).mp (TauCeti.mem_coeffSubalgebra_iff.mp g.2 (n + 1))
      have hle := TauCeti.MvPolynomial.mem_weightFiltration_iff.mp hfiltn v hv
      have hne : Finsupp.weight w v ≠ n + 1 := by
        intro heq
        have hsym := A.coeff_weightReesSymbol w g v
        rw [hg, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply, heq] at hsym
        exact mem_support_iff.mp hv hsym.symm
      exact Nat.lt_succ_iff.mp (lt_of_le_of_ne hle hne)
    refine Ideal.mem_span_singleton.mpr ⟨⟨(g : A[X]).divX, hdiv⟩, Subtype.ext ?_⟩
    simpa [hc0] using (Polynomial.X_mul_divX_add (g : A[X])).symm
  · rintro _ rfl
    exact A.weightReesSymbol_X w

end WeightReesSymbol

section Fibres

variable {σ R : Type*} [CommRing R]

/-- **Special fibre at `t = 0`, quotient form.** Quotienting `A.weightReesAlgebra w` by the Rees
parameter gives the weight-initial algebra of `A`. -/
noncomputable def quotientSpanXWeightReesAlgebraEquiv (A : Subalgebra R (MvPolynomial σ R))
    (w : σ → ℕ) :
    (A.weightReesAlgebra w ⧸
      Ideal.span {coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w)})
      ≃ₐ[R] A.weightInitialAlgebra w :=
  have hker : RingHom.ker (A.weightReesSymbol w).rangeRestrict =
      Ideal.span {coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w)} := by
    rw [← A.ker_weightReesSymbol w]
    ext x
    simp [RingHom.mem_ker, Subtype.ext_iff]
  (Ideal.quotientEquivAlgOfEq R hker.symm).trans <|
    (Ideal.quotientKerAlgEquivOfSurjective (A.weightReesSymbol w).rangeRestrict_surjective).trans <|
      Subalgebra.equivOfEq _ _ (A.range_weightReesSymbol w)

@[simp]
theorem coe_quotientSpanXWeightReesAlgebraEquiv_mk (A : Subalgebra R (MvPolynomial σ R))
    (w : σ → ℕ) (g : A.weightReesAlgebra w) :
    (A.quotientSpanXWeightReesAlgebraEquiv w (Ideal.Quotient.mk _ g) : MvPolynomial σ R) =
      A.weightReesSymbol w g := by
  simp [quotientSpanXWeightReesAlgebraEquiv]

@[simp]
theorem quotientSpanXWeightReesAlgebraEquiv_symm_weightInitialForm
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {f : MvPolynomial σ R} (hf : f ∈ A) :
    (A.quotientSpanXWeightReesAlgebraEquiv w).symm
      ⟨weightInitialForm w f, A.weightInitialForm_mem_weightInitialAlgebra w hf⟩ =
      Ideal.Quotient.mk _ (coeffSubalgebra.monomial (A.weightFiltration w)
        (f.weightedTotalDegree w) ⟨f, hf⟩
        ((A.mem_weightFiltration_iff w).mpr
          (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl))) := by
  rw [AlgEquiv.symm_apply_eq]
  apply Subtype.ext
  change weightInitialForm w f = _
  rw [coe_quotientSpanXWeightReesAlgebraEquiv_mk, weightReesSymbol_monomial, weightInitialForm_def]

/-- The symbol map into `A.weightInitialAlgebra w` as an `R[t]`-algebra homomorphism, where `R[t]`
acts on `A.weightInitialAlgebra w` by evaluation at `0`. -/
private noncomputable def weightReesSymbolParamAlgHom (A : Subalgebra R (MvPolynomial σ R))
    (w : σ → ℕ) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom (A.weightInitialAlgebra w) (Polynomial.evalRingHom (0 : R))
    A.weightReesAlgebra w →ₐ[R[X]] A.weightInitialAlgebra w :=
  letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  letI := Algebra.compHom (A.weightInitialAlgebra w) (Polynomial.evalRingHom (0 : R))
  { __ := ((Subalgebra.equivOfEq _ _ (A.range_weightReesSymbol w)).toAlgHom.comp
        (A.weightReesSymbol w).rangeRestrict).toRingHom
    commutes' p := Subtype.ext <| by
      simp [Algebra.compHom_algebraMap_apply, MvPolynomial.algebraMap_eq] }

/-- The tensor base-change map along evaluation `R[t] → R` at `0`, before proving bijectivity. -/
private noncomputable def baseChangeZeroAlgHom (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (R ⊗[R[X]] A.weightReesAlgebra w) →ₐ[R] A.weightInitialAlgebra w :=
  letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  letI := Algebra.compHom (A.weightInitialAlgebra w) (Polynomial.evalRingHom (0 : R))
  letI : IsScalarTower R[X] R (A.weightInitialAlgebra w) :=
    IsScalarTower.of_algebraMap_eq fun p ↦ by simp [Algebra.compHom_algebraMap_apply]
  AlgHom.liftEquiv R[X] R (A.weightReesAlgebra w) (A.weightInitialAlgebra w)
    (A.weightReesSymbolParamAlgHom w)

private theorem coe_baseChangeZeroAlgHom_tmul (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)
    (r : R) (g : A.weightReesAlgebra w) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (A.baseChangeZeroAlgHom w (r ⊗ₜ[R[X]] g) : MvPolynomial σ R) =
      r • A.weightReesSymbol w g := by
  let := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  let := Algebra.compHom (A.weightInitialAlgebra w) (Polynomial.evalRingHom (0 : R))
  let : IsScalarTower R[X] R (A.weightInitialAlgebra w) :=
    IsScalarTower.of_algebraMap_eq fun p ↦ by simp [Algebra.compHom_algebraMap_apply]
  exact congrArg Subtype.val (AlgHom.liftEquiv_tmul (A.weightReesSymbolParamAlgHom w) r g)

private theorem baseChangeZeroAlgHom_bijective (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    Function.Bijective (A.baseChangeZeroAlgHom w) := by
  let := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  let : IsScalarTower R R[X] R := IsScalarTower.of_algebraMap_eq fun r ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  let : IsScalarTower R R[X] (A.weightReesAlgebra w) :=
    coeffSubalgebra.isScalarTower (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let i := (Algebra.TensorProduct.includeRight : A.weightReesAlgebra w →ₐ[R[X]]
    R ⊗[R[X]] A.weightReesAlgebra w).restrictScalars R
  have hi : Function.Surjective i :=
    Algebra.TensorProduct.includeRight_surjective _ fun r ↦
      ⟨Polynomial.C r, by simp [Algebra.compHom_algebraMap_apply]⟩
  have hfi (g : A.weightReesAlgebra w) :
      (A.baseChangeZeroAlgHom w (i g) : MvPolynomial σ R) = A.weightReesSymbol w g :=
    (A.coe_baseChangeZeroAlgHom_tmul w 1 g).trans (one_smul R _)
  have hix : i (coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w)) =
      0 := by
    have he := (Algebra.TensorProduct.includeRight : A.weightReesAlgebra w →ₐ[R[X]]
      R ⊗[R[X]] A.weightReesAlgebra w).commutes Polynomial.X
    simpa [i, Algebra.compHom_algebraMap_apply, Algebra.TensorProduct.algebraMap_apply] using he
  refine ⟨(injective_iff_map_eq_zero _).mpr fun x hx ↦ ?_, fun y ↦ ?_⟩
  · obtain ⟨g, rfl⟩ := hi x
    have hg : g ∈ RingHom.ker (A.weightReesSymbol w) :=
      RingHom.mem_ker.mpr ((hfi g).symm.trans (congrArg Subtype.val hx))
    rw [A.ker_weightReesSymbol w, Ideal.mem_span_singleton] at hg
    obtain ⟨q, rfl⟩ := hg
    rw [map_mul, hix, zero_mul]
  · have hy : (y : MvPolynomial σ R) ∈ (A.weightReesSymbol w).range := by
      rw [A.range_weightReesSymbol w]
      exact y.2
    obtain ⟨g, hg⟩ := (A.weightReesSymbol w).mem_range.mp hy
    exact ⟨i g, Subtype.ext ((hfi g).trans hg)⟩

/-- **Special fibre at `t = 0`, base-change form.** Tensor base change of `A.weightReesAlgebra w`
along evaluation `R[t] → R` at `0` recovers the weight-initial algebra of `A`. -/
noncomputable def baseChangeZeroWeightReesAlgebraEquiv (A : Subalgebra R (MvPolynomial σ R))
    (w : σ → ℕ) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (R ⊗[R[X]] A.weightReesAlgebra w) ≃ₐ[R] A.weightInitialAlgebra w :=
  AlgEquiv.ofBijective _ (A.baseChangeZeroAlgHom_bijective w)

@[simp]
theorem coe_baseChangeZeroWeightReesAlgebraEquiv_tmul (A : Subalgebra R (MvPolynomial σ R))
    (w : σ → ℕ) (r : R) (g : A.weightReesAlgebra w) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (A.baseChangeZeroWeightReesAlgebraEquiv w (r ⊗ₜ[R[X]] g) : MvPolynomial σ R) =
      r • A.weightReesSymbol w g :=
  A.coe_baseChangeZeroAlgHom_tmul w r g

@[simp]
theorem baseChangeZeroWeightReesAlgebraEquiv_symm_weightInitialForm
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {f : MvPolynomial σ R} (hf : f ∈ A) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (A.baseChangeZeroWeightReesAlgebraEquiv w).symm
      ⟨weightInitialForm w f, A.weightInitialForm_mem_weightInitialAlgebra w hf⟩ =
      1 ⊗ₜ[R[X]] coeffSubalgebra.monomial (A.weightFiltration w) (f.weightedTotalDegree w) ⟨f, hf⟩
        ((A.mem_weightFiltration_iff w).mpr
          (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl)) := by
  let := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  rw [AlgEquiv.symm_apply_eq]
  apply Subtype.ext
  change weightInitialForm w f = _
  rw [coe_baseChangeZeroWeightReesAlgebraEquiv_tmul, one_smul, weightReesSymbol_monomial,
    weightInitialForm_def]

/-- **General fibre at a unit, quotient form.** For every unit `a` of `R`, quotienting
`A.weightReesAlgebra w` by `t - a` recovers `A`. -/
noncomputable def quotientSpanXSubAlgebraMapWeightReesAlgebraEquiv
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {a : R} (ha : IsUnit a) :
    (A.weightReesAlgebra w ⧸
      Ideal.span {coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w) -
        algebraMap R (A.weightReesAlgebra w) a}) ≃ₐ[R] A :=
  coeffSubalgebra.quotientSpanXSubAlgebraMapEquiv (A.weightFiltration w)
    (A.one_mem_weightFiltration_one w) (A.weightFiltration_mono w) (A.iSup_weightFiltration w) ha

@[simp]
theorem quotientSpanXSubAlgebraMapWeightReesAlgebraEquiv_mk
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {a : R} (ha : IsUnit a)
    (g : A.weightReesAlgebra w) :
    A.quotientSpanXSubAlgebraMapWeightReesAlgebraEquiv w ha (Ideal.Quotient.mk _ g) =
      coeffSubalgebra.eval (A.weightFiltration w) a g :=
  coeffSubalgebra.quotientSpanXSubAlgebraMapEquiv_mk _ _ _ _ ha g

@[simp]
theorem quotientSpanXSubAlgebraMapWeightReesAlgebraEquiv_symm_eval
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {a : R} (ha : IsUnit a)
    (g : A.weightReesAlgebra w) :
    (A.quotientSpanXSubAlgebraMapWeightReesAlgebraEquiv w ha).symm
      (coeffSubalgebra.eval (A.weightFiltration w) a g) = Ideal.Quotient.mk _ g :=
  coeffSubalgebra.quotientSpanXSubAlgebraMapEquiv_symm_eval _ _ _ _ ha g

/-- **Fibre at `t = 1`, quotient form.** Quotienting `A.weightReesAlgebra w` by `t - 1` recovers
`A`. -/
noncomputable def quotientSpanXSubOneWeightReesAlgebraEquiv
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    (A.weightReesAlgebra w ⧸
      Ideal.span {coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w) - 1})
      ≃ₐ[R] A :=
  (Ideal.quotientEquivAlgOfEq R (by rw [map_one])).trans
    (A.quotientSpanXSubAlgebraMapWeightReesAlgebraEquiv w isUnit_one)

@[simp]
theorem quotientSpanXSubOneWeightReesAlgebraEquiv_mk
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) (g : A.weightReesAlgebra w) :
    A.quotientSpanXSubOneWeightReesAlgebraEquiv w (Ideal.Quotient.mk _ g) =
      coeffSubalgebra.evalOne (A.weightFiltration w) g := by
  simp [quotientSpanXSubOneWeightReesAlgebraEquiv, coeffSubalgebra.evalOne_eq_eval]

@[simp]
theorem quotientSpanXSubOneWeightReesAlgebraEquiv_symm_apply
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) (f : A) :
    (A.quotientSpanXSubOneWeightReesAlgebraEquiv w).symm f =
      Ideal.Quotient.mk _ (coeffSubalgebra.monomial (A.weightFiltration w)
        ((f : MvPolynomial σ R).weightedTotalDegree w) f
        ((A.mem_weightFiltration_iff w).mpr
          (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl))) := by
  rw [AlgEquiv.symm_apply_eq, quotientSpanXSubOneWeightReesAlgebraEquiv_mk,
    coeffSubalgebra.evalOne_monomial]

/-- **General fibre at a unit, base-change form.** Tensor base change of `A.weightReesAlgebra w`
along evaluation `R[t] → R` at a unit `a` recovers `A`. -/
noncomputable def baseChangeEvalWeightReesAlgebraEquiv
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {a : R} (ha : IsUnit a) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    (R ⊗[R[X]] A.weightReesAlgebra w) ≃ₐ[R] A :=
  coeffSubalgebra.baseChangeEvalEquiv (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    (A.weightFiltration_mono w) (A.iSup_weightFiltration w) ha

@[simp]
theorem baseChangeEvalWeightReesAlgebraEquiv_tmul
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {a : R} (ha : IsUnit a) (r : R)
    (g : A.weightReesAlgebra w) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    A.baseChangeEvalWeightReesAlgebraEquiv w ha (r ⊗ₜ[R[X]] g) =
      r • coeffSubalgebra.eval (A.weightFiltration w) a g :=
  coeffSubalgebra.baseChangeEvalEquiv_tmul _ _ _ _ ha r g

@[simp]
theorem baseChangeEvalWeightReesAlgebraEquiv_symm_eval
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {a : R} (ha : IsUnit a)
    (g : A.weightReesAlgebra w) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    (A.baseChangeEvalWeightReesAlgebraEquiv w ha).symm
      (coeffSubalgebra.eval (A.weightFiltration w) a g) = 1 ⊗ₜ[R[X]] g :=
  coeffSubalgebra.baseChangeEvalEquiv_symm_eval _ _ _ _ ha g

/-- **Fibre at `t = 1`, base-change form.** Tensor base change of `A.weightReesAlgebra w` along
evaluation `R[t] → R` at `1` recovers `A`. -/
noncomputable def baseChangeOneWeightReesAlgebraEquiv
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (1 : R))
    (R ⊗[R[X]] A.weightReesAlgebra w) ≃ₐ[R] A :=
  A.baseChangeEvalWeightReesAlgebraEquiv w isUnit_one

@[simp]
theorem baseChangeOneWeightReesAlgebraEquiv_tmul
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) (r : R) (g : A.weightReesAlgebra w) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (1 : R))
    A.baseChangeOneWeightReesAlgebraEquiv w (r ⊗ₜ[R[X]] g) =
      r • coeffSubalgebra.evalOne (A.weightFiltration w) g := by
  let := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let := Algebra.compHom R (Polynomial.evalRingHom (1 : R))
  rw [coeffSubalgebra.evalOne_eq_eval]
  exact A.baseChangeEvalWeightReesAlgebraEquiv_tmul w isUnit_one r g

@[simp]
theorem baseChangeOneWeightReesAlgebraEquiv_symm_apply
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) (f : A) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (1 : R))
    (A.baseChangeOneWeightReesAlgebraEquiv w).symm f =
      1 ⊗ₜ[R[X]] coeffSubalgebra.monomial (A.weightFiltration w)
        ((f : MvPolynomial σ R).weightedTotalDegree w) f
        ((A.mem_weightFiltration_iff w).mpr
          (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl)) := by
  let := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let := Algebra.compHom R (Polynomial.evalRingHom (1 : R))
  rw [AlgEquiv.symm_apply_eq, baseChangeOneWeightReesAlgebraEquiv_tmul, one_smul,
    coeffSubalgebra.evalOne_monomial]

end Fibres

