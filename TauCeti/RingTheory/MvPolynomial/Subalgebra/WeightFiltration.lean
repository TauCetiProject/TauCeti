module

public import TauCeti.RingTheory.MvPolynomial.SAGBI.Weight
public import TauCeti.RingTheory.GradedAlgebra.CoeffSubalgebra.Flat
public import TauCeti.RingTheory.GradedAlgebra.CoeffSubalgebra.ZeroFiber

/-!
# The induced weight filtration on a polynomial subalgebra

For a subalgebra `A` of a multivariate polynomial ring, pull back the ambient weight
filtration to `A`. Its Rees algebra is realized inside `A[t]` using `coeffSubalgebra`.
The coefficientwise embedding into the ambient polynomial ring identifies it with the
intersection of the ambient weight Rees algebra and `A[t]`. Thus the existing bounded
SAGBI certificates identify their Rees presentation with this carrier.

Over a field this Rees algebra is flat over `k[t]`, without any finite generation or SAGBI
hypothesis. The increasing and exhaustive filtration also permits applying the shared
`coeffSubalgebra` unit-fibre comparisons, while `Subalgebra.weightReesAlgebraSpecialFiberEquiv`
identifies the zero fibre `R ⊗[R[X]] A.weightReesAlgebra w` with the subalgebra generated by
weight-initial forms of elements of `A`.

## References

* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, AMS, 1996, Chapter 11.
* D. Eisenbud, *Commutative Algebra with a View Toward Algebraic Geometry*, §15.8.
-/

public section

open scoped Polynomial
open TauCeti TauCeti.MvPolynomial

namespace Subalgebra

variable {σ R : Type*} [CommSemiring R] (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)

/-- The ambient weight filtration restricted to a polynomial subalgebra. -/
noncomputable def weightFiltration (n : ℕ) : Submodule R A :=
  (TauCeti.MvPolynomial.weightFiltration R w n).comap A.val.toLinearMap

/-- Membership in the induced filtration is the ambient weight bound. -/
@[simp]
theorem mem_weightFiltration_iff {n : ℕ} {f : A} :
    f ∈ A.weightFiltration w n ↔
      (f : MvPolynomial σ R) ∈ TauCeti.MvPolynomial.weightFiltration R w n :=
  Iff.rfl

/-- The lower stages of the induced weight filtration. -/
noncomputable def weightFiltrationLT (n : ℕ) : Submodule R A :=
  (TauCeti.MvPolynomial.weightFiltrationLT R w n).comap A.val.toLinearMap

/-- Membership in a lower stage is the strict ambient weight bound. -/
@[simp]
theorem mem_weightFiltrationLT_iff {n : ℕ} {f : A} :
    f ∈ A.weightFiltrationLT w n ↔
      (f : MvPolynomial σ R) ∈ TauCeti.MvPolynomial.weightFiltrationLT R w n :=
  Iff.rfl

/-- The induced weight filtration is multiplicative. -/
instance weightFiltrationGradedMonoid : SetLike.GradedMonoid (A.weightFiltration w) where
  one_mem := by
    simpa using (SetLike.GradedOne.one_mem :
      (1 : MvPolynomial σ R) ∈ TauCeti.MvPolynomial.weightFiltration R w 0)
  mul_mem {i j} {f g} hf hg := by
    simpa using SetLike.mul_mem_graded
      ((A.mem_weightFiltration_iff w).mp hf) ((A.mem_weightFiltration_iff w).mp hg)

/-- The induced weight filtration is increasing. -/
theorem weightFiltration_mono : Monotone (A.weightFiltration w) :=
  fun _ _ h _ hf ↦ TauCeti.MvPolynomial.weightFiltration_mono h hf

/-- The induced filtration, with its strict lower stages, is a native ring filtration. -/
instance weightFiltrationIsRingFiltration :
    IsRingFiltration (A.weightFiltration w) (A.weightFiltrationLT w) where
  mono := A.weightFiltration_mono w
  is_le h _ hf := IsFiltration.is_le
    (F := TauCeti.MvPolynomial.weightFiltration R w) h hf
  is_sup B n hB := by
    cases n with
    | zero =>
      intro f hf
      have hf0 : (f : MvPolynomial σ R) = 0 := by
        simpa using (A.mem_weightFiltrationLT_iff w).mp hf
      have : f = 0 := Subtype.ext hf0
      exact this ▸ B.zero_mem
    | succ n =>
      intro f hf
      apply hB n (Nat.lt_succ_self n)
      simpa [weightFiltrationLT, weightFiltration,
        TauCeti.MvPolynomial.weightFiltrationLT_succ] using hf

/-- Every element of a polynomial subalgebra has a finite weight bound. -/
theorem iSup_weightFiltration : (⨆ n, A.weightFiltration w n) = ⊤ :=
  top_unique fun f _ ↦ Submodule.mem_iSup_of_mem ((f : MvPolynomial σ R).weightedTotalDegree w)
    (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl)

/-- The parameter belongs to the Rees algebra of the induced weight filtration. -/
theorem one_mem_weightFiltration_one : (1 : A) ∈ A.weightFiltration w 1 := by
  simpa using TauCeti.MvPolynomial.one_mem_weightFiltration_one R w

/-- The Rees algebra of the induced weight filtration, inside `A[t]`. -/
noncomputable abbrev weightReesAlgebra : Subalgebra R A[X] :=
  coeffSubalgebra (A.weightFiltration w)

/-- The induced Rees algebra embeds as the intersection of the ambient weight Rees algebra
with the polynomial algebra having coefficients in `A`. -/
theorem map_weightReesAlgebra :
    (A.weightReesAlgebra w).map (Polynomial.mapAlgHom A.val) =
      TauCeti.MvPolynomial.weightReesAlgebra R w ⊓ (Polynomial.mapAlgHom A.val).range := by
  ext p; simp only [Subalgebra.mem_map, Algebra.mem_inf]
  refine ⟨fun ⟨q, hq, h⟩ ↦ ⟨?_, h ▸ AlgHom.mem_range_self _ q⟩, fun ⟨hp, q, h⟩ ↦ ⟨q, ?_, h⟩⟩
  · subst h; rw [TauCeti.MvPolynomial.weightReesAlgebra, mem_coeffSubalgebra_iff]
    simpa using mem_coeffSubalgebra_iff.mp hq
  · subst h; exact mem_coeffSubalgebra_iff.mpr (by simpa using mem_coeffSubalgebra_iff.mp hp)

end Subalgebra

namespace Subalgebra

variable {σ R : Type*} [CommRing R] (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)

/-- Under bounded relation certificates, the SAGBI Rees presentation is exactly the embedded
Rees algebra of the induced filtration, not merely an algebra with the same generators. -/
theorem map_weightReesAlgebra_eq_range_weightReesAeval
    {ι J : Type*} {c g : ι → MvPolynomial σ R} {d : ι → ℕ}
    {r Q : J → MvPolynomial ι R} {e : J → ℕ}
    (hA : A = Algebra.adjoin R (Set.range c))
    (hc : ∀ i, c i ∈ TauCeti.MvPolynomial.weightFiltration R w (d i))
    (hg : ∀ i, MvPolynomial.weightedHomogeneousComponent w (d i) (c i) = g i)
    (hJ : RingHom.ker (MvPolynomial.aeval g) = Ideal.span (Set.range r))
    (hr : ∀ j, (r j).IsWeightedHomogeneous d (e j))
    (hQ : ∀ j, Q j ∈ TauCeti.MvPolynomial.weightFiltrationLT R d (e j))
    (hQc : ∀ j, MvPolynomial.aeval c (Q j) = MvPolynomial.aeval c (r j)) :
    (A.weightReesAlgebra w).map (Polynomial.mapAlgHom A.val) = (weightReesAeval c d).range := by
  rw [A.map_weightReesAlgebra, range_weightReesAeval_eq_inf hc hg hJ hr hQ hQc]
  congr 1; ext p
  exact (Polynomial.mem_map_rangeS A.val.toRingHom).trans <|
    (forall_congr' fun n ↦ by
      simp only [RingHom.mem_rangeS, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        ← Set.mem_range, ← AlgHom.coe_range, Subalgebra.range_val, MvPolynomial.aeval_range,
        hA]).trans
      (Polynomial.mem_map_rangeS (MvPolynomial.aeval (R := R) c).toRingHom).symm

/-- Embed the induced weight Rees algebra into the ambient weight Rees algebra via the inclusion
`A ↪ MvPolynomial σ R`. -/
noncomputable def weightReesInclusion :
    A.weightReesAlgebra w →ₐ[R] TauCeti.MvPolynomial.weightReesAlgebra R w :=
  ((Polynomial.mapAlgHom A.val).comp (A.weightReesAlgebra w).val).codRestrict _ fun g ↦
    mem_coeffSubalgebra_iff.mpr fun m ↦ by
      simpa [Polynomial.coeff_map] using
        (A.mem_weightFiltration_iff w).mp (mem_coeffSubalgebra_iff.mp g.property m)

/-- Coercing the image of `weightReesInclusion` to `(MvPolynomial σ R)[X]` maps coefficients
along `A.val`. -/
@[simp]
theorem coe_weightReesInclusion (g : A.weightReesAlgebra w) :
    ((A.weightReesInclusion w g : TauCeti.MvPolynomial.weightReesAlgebra R w) :
      (MvPolynomial σ R)[X]) =
      Polynomial.map A.val.toRingHom (g : A[X]) := by
  simp [weightReesInclusion]

/-- `weightReesInclusion` is injective. -/
theorem weightReesInclusion_injective : Function.Injective (A.weightReesInclusion w) :=
  fun _ _ h ↦ Subtype.ext <| Polynomial.map_injective A.val.toRingHom Subtype.coe_injective <| by
    simpa only [coe_weightReesInclusion] using congrArg Subtype.val h

/-- `weightReesInclusion` sends monomials of `A.weightReesAlgebra w` to the corresponding ambient
Rees monomials. -/
@[simp]
theorem weightReesInclusion_monomial (m : ℕ) (b : A) (hb : b ∈ A.weightFiltration w m) :
    A.weightReesInclusion w (coeffSubalgebra.monomial (A.weightFiltration w) m b hb) =
      coeffSubalgebra.monomial (TauCeti.MvPolynomial.weightFiltration R w) m (b : MvPolynomial σ R)
        ((A.mem_weightFiltration_iff w).mp hb) :=
  Subtype.ext (by simp [weightReesInclusion])

/-- `weightReesInclusion` sends the Rees parameter `X` of `A.weightReesAlgebra w` to the ambient
Rees parameter `X`. -/
@[simp]
theorem weightReesInclusion_X :
    A.weightReesInclusion w
        (coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w)) =
      coeffSubalgebra.X (TauCeti.MvPolynomial.weightFiltration R w)
        (TauCeti.MvPolynomial.one_mem_weightFiltration_one R w) :=
  Subtype.ext (by simp [weightReesInclusion])

/-- The induced weight Rees algebra is flat over the actual parameter ring. No SAGBI basis,
finite generation, positivity of weights, or finite-variable hypothesis is needed. -/
theorem flat_weightReesAlgebra {k : Type*} [Field k]
    (A : Subalgebra k (MvPolynomial σ k)) (w : σ → ℕ) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    Module.Flat k[X] (A.weightReesAlgebra w) :=
  coeffSubalgebra.flat _ _

open scoped TensorProduct in
/-- The symbol homomorphism from `A.weightReesAlgebra w` to the subalgebra generated by the
weight-initial forms of elements of `A`. -/
private noncomputable def weightReesSpecialFiberHom :
    A.weightReesAlgebra w →ₐ[R]
      Algebra.adjoin R (_root_.MvPolynomial.weightInitialForm w '' (A : Set (MvPolynomial σ R))) :=
  ((TauCeti.MvPolynomial.weightReesSymbol R w).comp (A.weightReesInclusion w)).codRestrict _
    fun g ↦ by
      classical
      have hsum : A.weightReesInclusion w g = ∑ m ∈ (g : A[X]).support,
          coeffSubalgebra.monomial (TauCeti.MvPolynomial.weightFiltration R w) m
            ((g : A[X]).coeff m : MvPolynomial σ R)
            ((A.mem_weightFiltration_iff w).mp (mem_coeffSubalgebra_iff.mp g.property m)) :=
        Subtype.ext <| by
          rw [AddSubmonoidClass.coe_finsetSum, coe_weightReesInclusion]
          simpa [Polynomial.map_sum] using
            congrArg (Polynomial.map A.val.toRingHom) (g : A[X]).as_sum_support
      rw [AlgHom.comp_apply, hsum, map_sum]
      refine Subalgebra.sum_mem _ fun m _ ↦ ?_
      rw [TauCeti.MvPolynomial.weightReesSymbol_monomial]
      set b : MvPolynomial σ R := ((g : A[X]).coeff m).val
      rcases (mem_weightFiltration_iff_weightedTotalDegree_le.mp
          ((A.mem_weightFiltration_iff w).mp
            (mem_coeffSubalgebra_iff.mp g.property m))).eq_or_lt with heq | hlt
      · rw [← heq, ← _root_.MvPolynomial.weightInitialForm_def]
        exact Algebra.subset_adjoin ⟨b, ((g : A[X]).coeff m).property, rfl⟩
      · rw [_root_.MvPolynomial.weightedHomogeneousComponent_eq_zero m b hlt]; exact zero_mem _

private theorem coe_weightReesSpecialFiberHom_apply (g : A.weightReesAlgebra w) :
    (A.weightReesSpecialFiberHom w g : MvPolynomial σ R) =
      TauCeti.MvPolynomial.weightReesSymbol R w (A.weightReesInclusion w g) := rfl

private theorem coe_weightReesSpecialFiberHom_monomial
    (m : ℕ) (b : A) (hb : b ∈ A.weightFiltration w m) :
    (A.weightReesSpecialFiberHom w
        (coeffSubalgebra.monomial (A.weightFiltration w) m b hb) : MvPolynomial σ R) =
      _root_.MvPolynomial.weightedHomogeneousComponent w m (b : MvPolynomial σ R) := by
  rw [coe_weightReesSpecialFiberHom_apply, weightReesInclusion_monomial,
    TauCeti.MvPolynomial.weightReesSymbol_monomial]

private theorem ker_weightReesSpecialFiberHom :
    RingHom.ker (A.weightReesSpecialFiberHom w) =
      Ideal.span {coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w)} := by
  set t := coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  ext g
  rw [RingHom.mem_ker, Subtype.ext_iff, ZeroMemClass.coe_zero,
    coe_weightReesSpecialFiberHom_apply, ← RingHom.mem_ker, ker_weightReesSymbol,
    Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  refine ⟨fun ⟨q, hq⟩ ↦ ?_, fun ⟨q, hq⟩ ↦ ⟨A.weightReesInclusion w q, ?_⟩⟩
  · have hcoeff (m : ℕ) :
        ((g : A[X]).coeff m : MvPolynomial σ R) = (Polynomial.X * q.val).coeff m := by
      simpa [Polynomial.coeff_map] using
        congrArg (fun p : (MvPolynomial σ R)[X] ↦ p.coeff m) (congrArg Subtype.val hq)
    have h0 : (g : A[X]).coeff 0 = 0 := Subtype.ext (by simpa using hcoeff 0)
    obtain ⟨q', hq'⟩ := Polynomial.X_dvd_iff.mpr h0
    refine ⟨⟨q', mem_coeffSubalgebra_iff.mpr fun m ↦ (A.mem_weightFiltration_iff w).mpr ?_⟩,
      Subtype.ext (by simpa [t] using hq')⟩
    have hm : (q'.coeff m : MvPolynomial σ R) = q.val.coeff m := by
      simpa [hq', Polynomial.coeff_X_mul] using hcoeff (m + 1)
    exact hm ▸ mem_coeffSubalgebra_iff.mp q.property m
  · rw [hq, map_mul, weightReesInclusion_X]

private theorem weightReesSpecialFiberHom_surjective :
    Function.Surjective (A.weightReesSpecialFiberHom w) := by
  rintro ⟨y, hy⟩
  induction hy using Algebra.adjoin_induction with
  | mem y hy =>
    rcases hy with ⟨b, hb, rfl⟩
    have hbm : (⟨b, hb⟩ : A) ∈ A.weightFiltration w (b.weightedTotalDegree w) :=
      (A.mem_weightFiltration_iff w).mpr
        (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl)
    exact ⟨coeffSubalgebra.monomial _ _ ⟨b, hb⟩ hbm, Subtype.ext
      ((coe_weightReesSpecialFiberHom_monomial A w _ ⟨b, hb⟩ hbm).trans
        (_root_.MvPolynomial.weightInitialForm_def w b).symm)⟩
  | algebraMap r => exact ⟨algebraMap R _ r, AlgHom.commutes _ r⟩
  | add _ _ _ _ hx hy =>
    obtain ⟨g₁, hg₁⟩ := hx; obtain ⟨g₂, hg₂⟩ := hy; exact ⟨g₁ + g₂, by simp [hg₁, hg₂]⟩
  | mul _ _ _ _ hx hy =>
    obtain ⟨g₁, hg₁⟩ := hx; obtain ⟨g₂, hg₂⟩ := hy; exact ⟨g₁ * g₂, by simp [hg₁, hg₂]⟩

open scoped TensorProduct in
/-- The zero fibre of the induced weight Rees algebra at `X = 0` is `R`-algebra isomorphic to the
subalgebra generated by the weight-initial forms of elements of `A`. -/
noncomputable def weightReesAlgebraSpecialFiberEquiv :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (R ⊗[R[X]] A.weightReesAlgebra w) ≃ₐ[R]
      Algebra.adjoin R (_root_.MvPolynomial.weightInitialForm w '' (A : Set (MvPolynomial σ R))) :=
  coeffSubalgebra.baseChangeEvalZeroEquiv (A.weightFiltration w)
    (A.one_mem_weightFiltration_one w) (A.weightReesSpecialFiberHom w)
    (A.weightReesSpecialFiberHom_surjective w) (A.ker_weightReesSpecialFiberHom w)

open scoped TensorProduct in
/-- Coercing the image of `r ⊗ g` under `weightReesAlgebraSpecialFiberEquiv` to `MvPolynomial σ R`
gives `r • weightReesSymbol R w (A.weightReesInclusion w g)`. -/
@[simp]
theorem coe_weightReesAlgebraSpecialFiberEquiv_tmul (r : R) (g : A.weightReesAlgebra w) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (A.weightReesAlgebraSpecialFiberEquiv w (r ⊗ₜ[R[X]] g) : MvPolynomial σ R) =
      r • TauCeti.MvPolynomial.weightReesSymbol R w (A.weightReesInclusion w g) := by
  let := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  simp [weightReesAlgebraSpecialFiberEquiv, coe_weightReesSpecialFiberHom_apply]

open scoped TensorProduct in
/-- Coercing the image of a pure tensor of `1` with a Rees monomial `b * X ^ m` under
`weightReesAlgebraSpecialFiberEquiv` gives the weight-`m` homogeneous component of `b`. -/
theorem coe_weightReesAlgebraSpecialFiberEquiv_tmul_monomial
    (m : ℕ) (b : A) (hb : b ∈ A.weightFiltration w m) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (A.weightReesAlgebraSpecialFiberEquiv w
        (1 ⊗ₜ[R[X]] coeffSubalgebra.monomial (A.weightFiltration w) m b hb) :
        MvPolynomial σ R) =
      _root_.MvPolynomial.weightedHomogeneousComponent w m (b : MvPolynomial σ R) := by
  let := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  rw [coe_weightReesAlgebraSpecialFiberEquiv_tmul, one_smul, weightReesInclusion_monomial,
    TauCeti.MvPolynomial.weightReesSymbol_monomial]

open scoped TensorProduct in
/-- `weightReesAlgebraSpecialFiberEquiv.symm` sends the weight-initial form of `b : A` to `1 ⊗ₜ`
the Rees monomial of `b` in its weighted total degree. -/
@[simp]
theorem weightReesAlgebraSpecialFiberEquiv_symm_weightInitialForm (b : A) :
    letI := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (A.weightReesAlgebraSpecialFiberEquiv w).symm
        ⟨_root_.MvPolynomial.weightInitialForm w (b : MvPolynomial σ R),
          Algebra.subset_adjoin ⟨(b : MvPolynomial σ R), b.property, rfl⟩⟩ =
      1 ⊗ₜ[R[X]] coeffSubalgebra.monomial (A.weightFiltration w)
        ((b : MvPolynomial σ R).weightedTotalDegree w) b
        ((A.mem_weightFiltration_iff w).mpr
          (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl)) := by
  let := coeffSubalgebra.algebra (A.weightFiltration w) (A.one_mem_weightFiltration_one w)
  let := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  refine (A.weightReesAlgebraSpecialFiberEquiv w).injective ?_
  rw [AlgEquiv.apply_symm_apply]
  refine Subtype.ext ?_
  rw [coe_weightReesAlgebraSpecialFiberEquiv_tmul_monomial,
    ← _root_.MvPolynomial.weightInitialForm_def]

end Subalgebra
