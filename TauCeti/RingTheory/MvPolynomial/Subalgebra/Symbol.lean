module

public import TauCeti.RingTheory.MvPolynomial.Initial.Algebra
public import TauCeti.RingTheory.MvPolynomial.Subalgebra.WeightFiltration

/-!
# The symbol map of a subalgebra weight Rees algebra

For a subalgebra `A` of `MvPolynomial σ R` over a commutative semiring `R` and nonnegative integral
weights `w : σ → ℕ`, restricting the ambient symbol map `TauCeti.MvPolynomial.weightReesSymbol R w`
along the canonical embedding `A.weightReesInclusion w` produces the subalgebra symbol map
`Subalgebra.weightReesSymbol A w : A.weightReesAlgebra w →ₐ[R] MvPolynomial σ R`, which on a lifted
Rees presentation `weightReesAevalLift` evaluates the constant term in `t` at the weight-`d i`
components of the generators (`TauCeti.MvPolynomial.weightReesSymbol_weightReesAevalLift`).

Even over an arbitrary commutative semiring (possibly with zero divisors, where `weightInitialForm`
need not be multiplicative), the image of `A.weightReesSymbol w` is the weight-initial algebra
`A.weightInitialAlgebra w` (`Subalgebra.range_weightReesSymbol`), and the underlying
`R`-submodule of `A.weightInitialAlgebra w` is already the `R`-linear span of
`weightInitialForm w '' A` (`Subalgebra.toSubmodule_weightInitialAlgebra`). Corestricting
`A.weightReesSymbol w` to `A.weightInitialAlgebra w` gives the surjective map
`Subalgebra.weightReesSymbolToInitial`, whose kernel equals `RingHom.ker (A.weightReesSymbol w)`
and is generated by the central Rees parameter `t` (`Subalgebra.ker_weightReesSymbol`).

## Main definitions

* `Subalgebra.weightReesSymbol`: the specialization `A.weightReesAlgebra w →ₐ[R] MvPolynomial σ R`
  sending `b tⁿ` to the weight-`n` component of `b`.
* `Subalgebra.weightReesSymbolToInitial`: `A.weightReesSymbol w` corestricted to
  `A.weightInitialAlgebra w`.

## Main results

* `Subalgebra.range_weightReesSymbol`: the image of `A.weightReesSymbol w` is
  `A.weightInitialAlgebra w`.
* `Subalgebra.toSubmodule_weightInitialAlgebra`: the underlying `R`-submodule of
  `A.weightInitialAlgebra w` is `Submodule.span R (weightInitialForm w '' A)`.
* `Subalgebra.ker_weightReesSymbol`: the kernel of `A.weightReesSymbol w` is generated by the Rees
  parameter `t`.
* `TauCeti.MvPolynomial.weightReesSymbol_weightReesAevalLift`: compatibility of
  `A.weightReesSymbol w` with `weightReesAevalLift`.

## References

* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
* D. Eisenbud, *Commutative Algebra with a View Toward Algebraic Geometry*, GTM 150, §15.8.
-/

public section

open scoped Polynomial
open DirectSum MvPolynomial TauCeti TauCeti.MvPolynomial

namespace Subalgebra

section WeightReesSymbol

variable {σ R : Type*} [CommSemiring R]

section

variable (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)

/-- The symbol map on the subalgebra weight Rees algebra: `b tⁿ`, for `b ∈ A` of weight at most `n`,
is sent to the weighted homogeneous component of weight `n` of `b`. -/
noncomputable def weightReesSymbol : A.weightReesAlgebra w →ₐ[R] MvPolynomial σ R :=
  (TauCeti.MvPolynomial.weightReesSymbol R w).comp ((A.weightReesInclusion w).restrictScalars R)

theorem weightReesSymbol_def :
    A.weightReesSymbol w =
      (TauCeti.MvPolynomial.weightReesSymbol R w).comp
        ((A.weightReesInclusion w).restrictScalars R) := (rfl)

/-- Evaluating `A.weightReesSymbol w` on `g` evaluates the ambient symbol map on
`A.weightReesInclusion w g`. -/
theorem weightReesSymbol_apply (g : A.weightReesAlgebra w) :
    A.weightReesSymbol w g =
      TauCeti.MvPolynomial.weightReesSymbol R w (A.weightReesInclusion w g) := by
  simp [weightReesSymbol_def]

/-- The coefficient of `X^v` in the symbol of `g` is the coefficient of `X^v` in the `weight w v`
term of `g`. -/
theorem coeff_weightReesSymbol (g : A.weightReesAlgebra w) (v : σ →₀ ℕ) :
    (A.weightReesSymbol w g).coeff v =
      (((g : A[X]).coeff (Finsupp.weight w v) : A) : MvPolynomial σ R).coeff v := by
  rw [weightReesSymbol_apply, TauCeti.MvPolynomial.coeff_weightReesSymbol,
    coe_weightReesInclusion, Polynomial.coeff_map, AlgHom.coe_toRingHom, Subalgebra.coe_val]

@[simp]
theorem weightReesSymbol_monomial {n : ℕ} {b : A} (hb : b ∈ A.weightFiltration w n) :
    A.weightReesSymbol w (coeffSubalgebra.monomial _ n b hb) =
      weightedHomogeneousComponent w n (b : MvPolynomial σ R) := by
  rw [weightReesSymbol_apply, weightReesInclusion_monomial,
    TauCeti.MvPolynomial.weightReesSymbol_monomial]

@[simp]
theorem weightReesSymbol_X :
    A.weightReesSymbol w (coeffSubalgebra.X _ (A.one_mem_weightFiltration_one w)) = 0 := by
  rw [weightReesSymbol_apply, weightReesInclusion_X, TauCeti.MvPolynomial.weightReesSymbol_X]

end

@[simp]
theorem weightReesSymbol_weightReesMap {A B : Subalgebra R (MvPolynomial σ R)} (h : A ≤ B)
    (w : σ → ℕ) (g : A.weightReesAlgebra w) :
    B.weightReesSymbol w (weightReesMap h w g) = A.weightReesSymbol w g := by
  simp [weightReesSymbol_def]

@[simp]
theorem weightReesSymbol_algebraMap (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) (p : R[X]) :
    A.weightReesSymbol w (algebraMap R[X] (A.weightReesAlgebra w) p) = C (p.eval 0) := by
  have h : (A.weightReesSymbol w).comp (IsScalarTower.toAlgHom R R[X] (A.weightReesAlgebra w)) =
      (Algebra.ofId R (MvPolynomial σ R)).comp (Polynomial.aeval (0 : R)) := by
    ext
    simp
  simpa [MvPolynomial.algebraMap_eq] using congr($h p)

/-- Every element in the range of `A.weightReesSymbol w` lies in the `R`-linear span of the initial
forms of elements of `A`: the `n`-th coefficient of a Rees polynomial has weight at most `n`, so its
weight-`n` component is either zero or its initial form. -/
private theorem range_weightReesSymbol_le_span (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    (A.weightReesSymbol w).range.toSubmodule ≤ Submodule.span R (weightInitialForm w '' A) := by
  intro x hx
  obtain ⟨g, rfl⟩ := (A.weightReesSymbol w).mem_range.mp hx
  have hg : g = ∑ n ∈ (g : A[X]).support,
      coeffSubalgebra.monomial (A.weightFiltration w) n ((g : A[X]).coeff n)
        (TauCeti.mem_coeffSubalgebra_iff.mp g.property n) :=
    Subtype.ext (by simpa using (g : A[X]).as_sum_support)
  rw [hg, map_sum]
  refine Submodule.sum_mem _ fun n _ ↦ ?_
  rw [weightReesSymbol_monomial]
  set f : MvPolynomial σ R := (((g : A[X]).coeff n : A) : MvPolynomial σ R)
  have hfn : f ∈ TauCeti.MvPolynomial.weightFiltration R w n :=
    (A.mem_weightFiltration_iff w).mp (TauCeti.mem_coeffSubalgebra_iff.mp g.property n)
  rcases (mem_weightFiltration_iff_weightedTotalDegree_le.mp hfn).lt_or_eq with hlt | heq
  · rw [weightedHomogeneousComponent_eq_zero _ _ hlt]
    exact zero_mem _
  · rw [← heq, ← weightInitialForm_def]
    exact Submodule.subset_span ⟨f, ((g : A[X]).coeff n).property, rfl⟩

/-- The image of the subalgebra symbol map is the weight-initial algebra. -/
@[simp]
theorem range_weightReesSymbol (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    (A.weightReesSymbol w).range = A.weightInitialAlgebra w := by
  refine le_antisymm (fun x hx ↦ ?_) ((A.weightInitialAlgebra_le_iff w).mpr fun f hf ↦ ?_)
  · exact (Submodule.span_le (p := (A.weightInitialAlgebra w).toSubmodule).mpr (by
        rintro _ ⟨f, hf, rfl⟩
        exact A.weightInitialForm_mem_weightInitialAlgebra w hf))
      (A.range_weightReesSymbol_le_span w hx)
  · refine (A.weightReesSymbol w).mem_range.mpr
      ⟨coeffSubalgebra.monomial (A.weightFiltration w) (f.weightedTotalDegree w) ⟨f, hf⟩
        ((A.mem_weightFiltration_iff w).mpr
          (mem_weightFiltration_iff_weightedTotalDegree_le.mpr le_rfl)), ?_⟩
    rw [weightReesSymbol_monomial, weightInitialForm_def]

/-- Over any commutative semiring, the underlying `R`-submodule of `A.weightInitialAlgebra w` is
the `R`-linear span of the initial forms of all elements of `A`. -/
theorem toSubmodule_weightInitialAlgebra (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    Subalgebra.toSubmodule (A.weightInitialAlgebra w) =
      Submodule.span R (weightInitialForm w '' A) := by
  -- `A.weightInitialAlgebra w` is the image of the ring homomorphism `A.weightReesSymbol w`,
  -- which already lands in `Submodule.span R (weightInitialForm w '' A)`.
  refine le_antisymm ?_
    (Submodule.span_le.mpr (by rw [weightInitialAlgebra_def]; exact Algebra.subset_adjoin))
  rw [← A.range_weightReesSymbol w]
  exact A.range_weightReesSymbol_le_span w

/-- The subalgebra symbol map `A.weightReesSymbol w` corestricted to its image
`A.weightInitialAlgebra w`. -/
noncomputable def weightReesSymbolToInitial (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    A.weightReesAlgebra w →ₐ[R] A.weightInitialAlgebra w :=
  (Subalgebra.equivOfEq _ _ (A.range_weightReesSymbol w)).toAlgHom.comp
    (A.weightReesSymbol w).rangeRestrict

@[simp]
theorem coe_weightReesSymbolToInitial (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)
    (g : A.weightReesAlgebra w) :
    (A.weightReesSymbolToInitial w g : MvPolynomial σ R) = A.weightReesSymbol w g := by
  simp [weightReesSymbolToInitial]

theorem weightedHomogeneousComponent_mem_weightInitialAlgebra
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {n : ℕ} {b : A}
    (hb : b ∈ A.weightFiltration w n) :
    weightedHomogeneousComponent w n (b : MvPolynomial σ R) ∈ A.weightInitialAlgebra w := by
  rw [← A.weightReesSymbol_monomial w hb, ← A.coe_weightReesSymbolToInitial w]
  exact SetLike.coe_mem _

@[simp]
theorem weightReesSymbolToInitial_monomial (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ)
    {n : ℕ} {b : A} (hb : b ∈ A.weightFiltration w n) :
    A.weightReesSymbolToInitial w (coeffSubalgebra.monomial _ n b hb) =
      ⟨weightedHomogeneousComponent w n (b : MvPolynomial σ R),
        A.weightedHomogeneousComponent_mem_weightInitialAlgebra w hb⟩ :=
  Subtype.ext (by simp)

theorem weightReesSymbolToInitial_monomial_weightedTotalDegree
    (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) {f : MvPolynomial σ R} (hf : f ∈ A)
    (hb : (⟨f, hf⟩ : A) ∈ A.weightFiltration w (f.weightedTotalDegree w)) :
    A.weightReesSymbolToInitial w
      (coeffSubalgebra.monomial (A.weightFiltration w) (f.weightedTotalDegree w) ⟨f, hf⟩ hb) =
      ⟨weightInitialForm w f, A.weightInitialForm_mem_weightInitialAlgebra w hf⟩ :=
  Subtype.ext (by simp [weightInitialForm_def])

@[simp]
theorem weightReesSymbolToInitial_X (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    A.weightReesSymbolToInitial w
      (coeffSubalgebra.X _ (A.one_mem_weightFiltration_one w)) = 0 :=
  Subtype.ext (by simp)

theorem weightReesSymbolToInitial_surjective (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    Function.Surjective (A.weightReesSymbolToInitial w) :=
  ((Subalgebra.equivOfEq _ _ (A.range_weightReesSymbol w)).surjective.comp
    (A.weightReesSymbol w).rangeRestrict_surjective)

theorem ker_weightReesSymbolToInitial (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    RingHom.ker (A.weightReesSymbolToInitial w) = RingHom.ker (A.weightReesSymbol w) := by
  ext g
  simp [RingHom.mem_ker, Subtype.ext_iff]

/-- **Kernel of the subalgebra symbol map.** Over any commutative semiring, the kernel of
`A.weightReesSymbol w` is generated by the Rees parameter. -/
theorem ker_weightReesSymbol (A : Subalgebra R (MvPolynomial σ R)) (w : σ → ℕ) :
    RingHom.ker (A.weightReesSymbol w) =
      Ideal.span {coeffSubalgebra.X (A.weightFiltration w) (A.one_mem_weightFiltration_one w)} := by
  refine le_antisymm (fun g hg ↦ ?_) (Ideal.span_le.mpr ?_)
  · -- Pull back `TauCeti.MvPolynomial.ker_weightReesSymbol` along `A.weightReesInclusion w` to
    -- see that the constant term in `t` vanishes and `(g : A[X]).divX` stays filtered.
    have hg' : A.weightReesInclusion w g ∈
        RingHom.ker (TauCeti.MvPolynomial.weightReesSymbol R w) := by
      rwa [RingHom.mem_ker, ← A.weightReesSymbol_apply w]
    rw [TauCeti.MvPolynomial.ker_weightReesSymbol, Ideal.mem_span_singleton] at hg'
    obtain ⟨q, hq⟩ := hg'
    have hmap : (g : A[X]).map A.val = Polynomial.X * (q : (MvPolynomial σ R)[X]) := by
      simpa using congrArg Subtype.val hq
    have hc0 : (g : A[X]).coeff 0 = 0 := Subtype.ext <| by
      have h0 := congrArg (fun p : (MvPolynomial σ R)[X] ↦ p.coeff 0) hmap
      simpa [Polynomial.coeff_X_mul_zero] using h0
    have hdiv : (g : A[X]).divX ∈ A.weightReesAlgebra w := by
      rw [TauCeti.mem_coeffSubalgebra_iff]
      intro n
      rw [Polynomial.coeff_divX, A.mem_weightFiltration_iff]
      have hn := congrArg (fun p : (MvPolynomial σ R)[X] ↦ p.coeff (n + 1)) hmap
      have hqn : (((g : A[X]).coeff (n + 1) : A) : MvPolynomial σ R) =
          (q : (MvPolynomial σ R)[X]).coeff n := by
        simpa [Polynomial.coeff_X_mul] using hn
      rw [hqn]
      exact TauCeti.mem_coeffSubalgebra_iff.mp q.property n
    refine Ideal.mem_span_singleton.mpr ⟨⟨(g : A[X]).divX, hdiv⟩, Subtype.ext ?_⟩
    simpa [hc0] using (Polynomial.X_mul_divX_add (g : A[X])).symm
  · rintro _ rfl
    exact A.weightReesSymbol_X w

end WeightReesSymbol

end Subalgebra

namespace TauCeti.MvPolynomial

attribute [local instance] Polynomial.algebra in
@[simp]
theorem weightReesSymbol_weightReesAevalLift {σ ι R : Type*} [CommSemiring R]
    {A : Subalgebra R (MvPolynomial σ R)} {w : σ → ℕ} {c : ι → MvPolynomial σ R} {d : ι → ℕ}
    (hcA : ∀ i, c i ∈ A) (hc : ∀ i, c i ∈ weightFiltration R w (d i))
    (f : (MvPolynomial ι R)[X]) :
    A.weightReesSymbol w (weightReesAevalLift hcA hc f) =
      aeval (fun i ↦ weightedHomogeneousComponent w (d i) (c i)) (f.coeff 0) := by
  have h : (A.weightReesSymbol w).comp ((weightReesAevalLift hcA hc).restrictScalars R) =
      (aeval fun i ↦ weightedHomogeneousComponent w (d i) (c i)).comp
        ((Polynomial.aeval (0 : MvPolynomial ι R)).restrictScalars R) := by
    refine Polynomial.algHom_ext' (MvPolynomial.algHom_ext fun i ↦ ?_) ?_ <;> simp
  simpa [← Polynomial.coeff_zero_eq_eval_zero] using congr($h f)

end TauCeti.MvPolynomial
