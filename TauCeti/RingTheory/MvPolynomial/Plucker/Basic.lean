/-!
# Maximal minors, Plücker evaluation and quadratic straightening relations

For the generic `n × d` matrix `Matrix.mvPolynomialX (Fin n) (Fin d) R`, the **maximal minor**
`TauCeti.maximalMinor R I` on a strictly increasing `d`-tuple of rows `I : Fin d ↪o Fin n` is the
determinant on the rows `I` and all `d` columns. Under row-major `MonomialOrder.lex` on the
`toLex`-renamed matrix variables `Fin n ×ₗ Fin d`, each maximal minor is monic with leading
exponent `TauCeti.maximalMinorDiagonalExponent I = ∑ c, single (toLex (I c, c)) 1`.

Indexing the Plücker variables by `(Lex (Fin d ↪o Fin n))ᵒᵈ` via `TauCeti.pluckerVar` makes the
graded reverse lexicographic order `TauCeti.MonomialOrder.degRevLex` satisfy
`X (pluckerVar I) < X (pluckerVar J) ↔ toLex I < toLex J`. Evaluation of Plücker variables at the
maximal minors (`TauCeti.pluckerEval R n d`) has image `TauCeti.maximalMinorSubalgebra R n d` and
kernel `TauCeti.pluckerIdeal R n d`, which is prime over every integral domain.

For any pair `I, J : Fin d ↪o Fin n` with `¬ I ≤ J`, choosing the first column `k` where
`J k < I k` and shuffling the tail `{a | k ≤ a}` of `I` against the initial segment `{a | a ≤ k}`
of `J` produces a homogeneous quadratic polynomial `TauCeti.pluckerQuadric R hIJ` in
`TauCeti.pluckerIdeal R n d`. When `toLex I < toLex J` (equivalently, when `I` and `J` are
componentwise incomparable and ordered with `I` lexicographically first), every non-identity
shuffle lowers the left row set in `Lex`, so `TauCeti.pluckerQuadric R hIJ` is monic for
`TauCeti.MonomialOrder.degRevLex` with leading monomial `X (pluckerVar I) * X (pluckerVar J)`.

That these quadratic straightening relations form a Gröbner basis of `TauCeti.pluckerIdeal R n d`,
presenting the Grassmannian coordinate algebra with its semistandard-tableau basis, is proved in
`TauCeti.RingTheory.MvPolynomial.Plucker.Groebner`.

## Main definitions

* `TauCeti.maximalMinor R I`: the `d × d` generic minor on the increasing row tuple
  `I : Fin d ↪o Fin n`.
* `TauCeti.maximalMinorDiagonalExponent I`: its diagonal exponent in `Fin n ×ₗ Fin d →₀ ℕ`.
* `TauCeti.pluckerVar`: the bijection `(Fin d ↪o Fin n) ≃ (Lex (Fin d ↪o Fin n))ᵒᵈ`.
* `TauCeti.pluckerEval R n d`, `TauCeti.pluckerIdeal R n d`,
  `TauCeti.maximalMinorSubalgebra R n d`: the evaluation algebra homomorphism at maximal minors,
  its kernel (the Plücker ideal) and the subalgebra generated by maximal minors.
* `TauCeti.pluckerLift R r`: the signed Plücker variable (or `0`) lifting a row tuple
  `r : Fin d → Fin n`.
* `TauCeti.pluckerQuadric R hIJ`, `TauCeti.pluckerQuadrics R n d`: the quadratic Plücker
  straightening relation for `hIJ : ¬ I ≤ J`, and the set of such relations with
  `toLex I < toLex J`.

## Main results

* `TauCeti.determinantalIdeal_eq_span_range_maximalMinor`: the `d × d` determinantal ideal of the
  generic `n × d` matrix is spanned by the maximal minors.
* `TauCeti.pluckerIdeal_isPrime`: over an integral domain, the Plücker ideal is prime.
* `TauCeti.pluckerQuadric_mem_pluckerIdeal`: every quadratic straightening relation lies in the
  Plücker ideal.
* `TauCeti.monic_pluckerQuadric`, `TauCeti.degree_pluckerQuadric`,
  `TauCeti.leadingTerm_pluckerQuadric`: for `toLex I < toLex J` and `¬ I ≤ J`,
  `pluckerQuadric R hIJ` is monic under `degRevLex` with leading term
  `X (pluckerVar I) * X (pluckerVar J)`.

## References

* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 14, Theorem 14.6 and Theorem 14.11.
* B. Sturmfels, *Algorithms in Invariant Theory*, 2nd ed., Springer, 2008, §3.1, Theorem 3.1.7.
* W. V. D. Hodge and D. Pedoe, *Methods of Algebraic Geometry*, Vol. II, Cambridge University
  Press, 1952, Book IV, Chapter XIV.
-/

public section

namespace TauCeti

open Equiv Finset MvPolynomial
open scoped _root_.MonomialOrder

variable {n d : ℕ}

/-! ### Generic maximal minors and diagonal leading terms -/

section MaximalMinor

variable (R : Type*) [CommRing R]

/-- The **maximal minor** of the generic `n × d` matrix on an increasing `d`-tuple of rows
`I : Fin d ↪o Fin n` and all `d` columns. -/
noncomputable def maximalMinor (I : Fin d ↪o Fin n) : MvPolynomial (Fin n × Fin d) R :=
  Matrix.mvPolynomialMinor R I id

theorem maximalMinor_def (I : Fin d ↪o Fin n) :
    maximalMinor R I = Matrix.mvPolynomialMinor R I id :=
  (rfl)

@[simp]
theorem maximalMinor_zero (I : Fin 0 ↪o Fin n) : maximalMinor R I = 1 :=
  Matrix.mvPolynomialMinor_zero I id

/-- Maximal minors are the Plücker coordinates of the columns of the generic `n × d` matrix. -/
theorem maximalMinor_eq_plucker_col (I : Fin d ↪o Fin n) :
    maximalMinor R I =
      plucker (Matrix.mvPolynomialX (Fin n) (Fin d) R).col (Set.powersetCard.ofFinEmbEquiv I) := by
  rw [maximalMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix, ← Matrix.det_transpose,
    plucker_apply, Equiv.symm_apply_apply]
  rfl

/-- Evaluating a maximal minor at an `n × d` matrix gives the corresponding concrete maximal
minor. -/
@[simp]
theorem aeval_maximalMinor {S : Type*} [CommRing S] [Algebra R S] (A : Matrix (Fin n) (Fin d) S)
    (I : Fin d ↪o Fin n) :
    aeval (fun ij : Fin n × Fin d ↦ A ij.1 ij.2) (maximalMinor R I) =
      (A.submatrix I id).det :=
  Matrix.aeval_mvPolynomialMinor R A I id

/-- Maximal minors commute with change of coefficient ring. -/
@[simp]
theorem map_maximalMinor {S : Type*} [CommRing S] (f : R →+* S) (I : Fin d ↪o Fin n) :
    map f (maximalMinor R I) = maximalMinor S I :=
  Matrix.map_mvPolynomialMinor f I id

/-- Every maximal minor of the `n × d` generic matrix is homogeneous of degree `d`. -/
theorem maximalMinor_isHomogeneous (I : Fin d ↪o Fin n) : (maximalMinor R I).IsHomogeneous d := by
  rw [maximalMinor_def]
  simpa using Matrix.isHomogeneous_mvPolynomialMinor R I (id : Fin d → Fin d)

/-- The `d × d` determinantal ideal of the generic `n × d` matrix is spanned by the maximal
minors. -/
theorem determinantalIdeal_eq_span_range_maximalMinor (n d : ℕ) :
    determinantalIdeal R (Fin n) (Fin d) (Fin d) = Ideal.span (Set.range (maximalMinor R)) := by
  rw [determinantalIdeal_eq_span_orderEmbedding]
  congr 1
  ext f
  simp only [Set.mem_ofPred_eq, Set.mem_range, maximalMinor_def]
  exact ⟨fun ⟨r, c, h⟩ ↦ ⟨r, c.strictMono.eq_id ▸ h⟩, fun ⟨r, h⟩ ↦ ⟨r, .refl _, h⟩⟩

/-- The exponent of the main diagonal `∏_(c < d) z_(I c, c)` of `maximalMinor R I` in the
row-major lexicographically ordered variables `Fin n ×ₗ Fin d`. -/
noncomputable def maximalMinorDiagonalExponent (I : Fin d ↪o Fin n) : Fin n ×ₗ Fin d →₀ ℕ :=
  ∑ c : Fin d, Finsupp.single (toLex (I c, c)) 1

theorem maximalMinorDiagonalExponent_def (I : Fin d ↪o Fin n) :
    maximalMinorDiagonalExponent I = ∑ c : Fin d, Finsupp.single (toLex (I c, c)) 1 :=
  (rfl)

/-- `maximalMinorDiagonalExponent I` takes the value `1` at `toLex (r, c)` when `I c = r` and `0`
otherwise. -/
theorem maximalMinorDiagonalExponent_apply (I : Fin d ↪o Fin n) (r : Fin n) (c : Fin d) :
    maximalMinorDiagonalExponent I (toLex (r, c)) = if I c = r then 1 else 0 := by
  rw [maximalMinorDiagonalExponent_def, Finsupp.finsetSum_apply,
    Fintype.sum_eq_single c fun c' hc' ↦ Finsupp.single_eq_of_ne fun h ↦
      hc' (congrArg (fun x ↦ (ofLex x).2) h).symm]
  by_cases h : I c = r <;> simp [h, toLex.injective.eq_iff]

@[simp]
theorem degree_maximalMinorDiagonalExponent (I : Fin d ↪o Fin n) :
    (maximalMinorDiagonalExponent I).degree = d := by
  simp [maximalMinorDiagonalExponent_def]

/-- Distinct row tuples have distinct diagonal exponents. -/
theorem maximalMinorDiagonalExponent_injective :
    Function.Injective (maximalMinorDiagonalExponent (n := n) (d := d)) := by
  intro I J h
  refine DFunLike.ext I J fun c ↦ ?_
  by_contra hne
  have hc := congrArg (fun e ↦ e (toLex (I c, c))) h
  simp [maximalMinorDiagonalExponent_apply, Ne.symm hne] at hc

/-- Under row-major `MonomialOrder.lex`, each maximal minor is monic. -/
@[simp]
theorem monic_rename_toLex_maximalMinor (I : Fin d ↪o Fin n) :
    _root_.MonomialOrder.lex.Monic (rename toLex (maximalMinor R I)) :=
  Matrix.monic_rename_toLex_mvPolynomialMinor R I.strictMono strictMono_id

/-- Under row-major `MonomialOrder.lex`, the leading exponent of `maximalMinor R I` is
`maximalMinorDiagonalExponent I`. -/
@[simp]
theorem degree_rename_toLex_maximalMinor [Nontrivial R] (I : Fin d ↪o Fin n) :
    _root_.MonomialOrder.lex.degree (rename toLex (maximalMinor R I)) =
      maximalMinorDiagonalExponent I :=
  Matrix.degree_rename_toLex_mvPolynomialMinor R I.strictMono strictMono_id

variable {R}

/-- Under row-major `MonomialOrder.lex`, the leading term of `maximalMinor R I` is its diagonal
monomial. -/
@[simp]
theorem leadingTerm_rename_toLex_maximalMinor (I : Fin d ↪o Fin n) :
    _root_.MonomialOrder.lex.leadingTerm (rename toLex (maximalMinor R I)) =
      monomial (maximalMinorDiagonalExponent I) 1 := by
  nontriviality R
  rw [_root_.MonomialOrder.leadingTerm, degree_rename_toLex_maximalMinor,
    (monic_rename_toLex_maximalMinor R I).leadingCoeff_eq_one]

@[simp]
theorem maximalMinor_ne_zero [Nontrivial R] (I : Fin d ↪o Fin n) : maximalMinor R I ≠ 0 :=
  fun h ↦ (monic_rename_toLex_maximalMinor R I).ne_zero (by rw [h, map_zero])

/-- Over a nontrivial commutative ring, distinct row tuples give distinct maximal minors. -/
theorem maximalMinor_injective (R : Type*) [CommRing R] [Nontrivial R] :
    Function.Injective (maximalMinor (n := n) (d := d) R) := fun I J h ↦
  maximalMinorDiagonalExponent_injective <| by
    simpa only [degree_rename_toLex_maximalMinor] using
      congrArg (fun p ↦ _root_.MonomialOrder.lex.degree (rename toLex p)) h

end MaximalMinor

/-! ### Plücker variables, evaluation, ideal and subalgebra -/

/-- The equivalence identifying an increasing `d`-tuple of rows `I : Fin d ↪o Fin n` with its
Plücker variable index in `(Lex (Fin d ↪o Fin n))ᵒᵈ`. Reversing the lexicographic order makes
`TauCeti.MonomialOrder.degRevLex` order Plücker variables isotonically with `Lex`:
`X (pluckerVar I) < X (pluckerVar J) ↔ toLex I < toLex J`. -/
def pluckerVar : (Fin d ↪o Fin n) ≃ (Lex (Fin d ↪o Fin n))ᵒᵈ :=
  toLex.trans OrderDual.toDual

theorem pluckerVar_def :
    (pluckerVar : (Fin d ↪o Fin n) ≃ (Lex (Fin d ↪o Fin n))ᵒᵈ) = toLex.trans OrderDual.toDual :=
  (rfl)

@[simp]
theorem pluckerVar_lt_iff {I J : Fin d ↪o Fin n} :
    pluckerVar I < pluckerVar J ↔ toLex J < toLex I :=
  Iff.rfl

@[simp]
theorem pluckerVar_le_iff {I J : Fin d ↪o Fin n} :
    pluckerVar I ≤ pluckerVar J ↔ toLex J ≤ toLex I :=
  Iff.rfl

theorem degRevLex_single_pluckerVar_lt_iff {I J : Fin d ↪o Fin n} :
    Finsupp.single (pluckerVar I) 1 ≺[MonomialOrder.degRevLex] Finsupp.single (pluckerVar J) 1 ↔
      toLex I < toLex J :=
  MonomialOrder.degRevLex_single_lt_iff

theorem degRevLex_single_pluckerVar_le_iff {I J : Fin d ↪o Fin n} :
    Finsupp.single (pluckerVar I) 1 ≼[MonomialOrder.degRevLex] Finsupp.single (pluckerVar J) 1 ↔
      toLex I ≤ toLex J :=
  MonomialOrder.degRevLex_single_le_iff

section PluckerIdeal

variable (R : Type*) [CommRing R]

/-- Evaluation of Plücker variables at the generic maximal minors `maximalMinor R I`. -/
noncomputable def pluckerEval (n d : ℕ) :
    MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R →ₐ[R] MvPolynomial (Fin n × Fin d) R :=
  aeval fun v ↦ maximalMinor R (pluckerVar.symm v)

theorem pluckerEval_def (n d : ℕ) :
    pluckerEval R n d = aeval fun v ↦ maximalMinor R (pluckerVar.symm v) :=
  (rfl)

@[simp]
theorem pluckerEval_X (v : (Lex (Fin d ↪o Fin n))ᵒᵈ) :
    pluckerEval R n d (X v) = maximalMinor R (pluckerVar.symm v) := by
  simp [pluckerEval_def]

theorem pluckerEval_X_pluckerVar (I : Fin d ↪o Fin n) :
    pluckerEval R n d (X (pluckerVar I)) = maximalMinor R I := by
  simp [pluckerEval_def]

/-- The subalgebra of `MvPolynomial (Fin n × Fin d) R` generated by the maximal minors of the
generic `n × d` matrix, i.e. the Grassmannian coordinate subalgebra over `R`. -/
noncomputable def maximalMinorSubalgebra (n d : ℕ) :
    Subalgebra R (MvPolynomial (Fin n × Fin d) R) :=
  Algebra.adjoin R (Set.range (maximalMinor R))

theorem maximalMinorSubalgebra_def (n d : ℕ) :
    maximalMinorSubalgebra R n d = Algebra.adjoin R (Set.range (maximalMinor R)) :=
  (rfl)

theorem maximalMinor_mem_maximalMinorSubalgebra (I : Fin d ↪o Fin n) :
    maximalMinor R I ∈ maximalMinorSubalgebra R n d :=
  Algebra.subset_adjoin ⟨I, rfl⟩

/-- The image of `pluckerEval R n d` is `maximalMinorSubalgebra R n d`. -/
@[simp]
theorem range_pluckerEval (n d : ℕ) :
    (pluckerEval R n d).range = maximalMinorSubalgebra R n d := by
  rw [pluckerEval_def, aeval_range, maximalMinorSubalgebra_def,
    show (fun v ↦ maximalMinor R (pluckerVar.symm v)) = maximalMinor R ∘ pluckerVar.symm from rfl,
    pluckerVar.symm.surjective.range_comp]

/-- The **Plücker ideal**: the ideal of polynomial relations among the `d × d` maximal minors of
the generic `n × d` matrix over `R`. -/
noncomputable def pluckerIdeal (n d : ℕ) : Ideal (MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :=
  RingHom.ker (pluckerEval R n d)

theorem pluckerIdeal_def (n d : ℕ) : pluckerIdeal R n d = RingHom.ker (pluckerEval R n d) :=
  (rfl)

@[simp]
theorem mem_pluckerIdeal_iff {f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R} :
    f ∈ pluckerIdeal R n d ↔ pluckerEval R n d f = 0 :=
  Iff.rfl

/-- Over an integral domain, the Plücker ideal is prime because `MvPolynomial (Fin n × Fin d) R` is
an integral domain. -/
instance pluckerIdeal_isPrime [IsDomain R] (n d : ℕ) : (pluckerIdeal R n d).IsPrime :=
  RingHom.ker_isPrime _

/-- The first isomorphism theorem for `pluckerEval`: the quotient of the Plücker polynomial ring by
`pluckerIdeal R n d` is isomorphic as an `R`-algebra to `maximalMinorSubalgebra R n d`. -/
noncomputable def quotientPluckerIdealAlgEquiv (n d : ℕ) :
    (MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R ⧸ pluckerIdeal R n d) ≃ₐ[R]
      maximalMinorSubalgebra R n d :=
  (Ideal.quotientKerEquivRange (pluckerEval R n d)).trans
    (Subalgebra.equivOfEq _ _ (range_pluckerEval R n d))

@[simp]
theorem coe_quotientPluckerIdealAlgEquiv_mk (n d : ℕ)
    (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :
    (quotientPluckerIdealAlgEquiv R n d (Ideal.Quotient.mk (pluckerIdeal R n d) f) :
      MvPolynomial (Fin n × Fin d) R) = pluckerEval R n d f :=
  congrArg Subtype.val
    (Ideal.quotientKerAlgEquivOfSurjective_mk (pluckerEval R n d).rangeRestrict_surjective f)

/-- `pluckerEval` commutes with change of coefficient ring. -/
theorem map_pluckerEval {S : Type*} [CommRing S] (φ : R →+* S)
    (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :
    map φ (pluckerEval R n d f) = pluckerEval S n d (map φ f) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp [pluckerEval_def]
  | add p q hp hq => simp [hp, hq]
  | mul_X p v hp =>
    obtain ⟨I, rfl⟩ := pluckerVar.surjective v
    simp [hp]

end PluckerIdeal

/-! ### Lifting arbitrary row tuples and quadratic straightening relations -/

section Straightening

/-- Lift an arbitrary row tuple `r : Fin d → Fin n` to a signed Plücker variable when `r` is
injective, and to `0` when `r` repeats an index. -/
noncomputable def pluckerLift (R : Type*) [CommRing R] (r : Fin d → Fin n) :
    MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R :=
  if hr : Function.Injective r then
    Perm.sign (Tuple.sort r) •
      X (pluckerVar
        (OrderEmbedding.ofStrictMono (r ∘ Tuple.sort r) (Tuple.strictMono_comp_sort hr)))
  else 0

theorem pluckerLift_of_injective (R : Type*) [CommRing R] {r : Fin d → Fin n}
    (hr : Function.Injective r) :
    pluckerLift R r =
      Perm.sign (Tuple.sort r) •
        X (pluckerVar
          (OrderEmbedding.ofStrictMono (r ∘ Tuple.sort r) (Tuple.strictMono_comp_sort hr))) :=
  dite_eq_left hr

@[simp]
theorem pluckerLift_of_not_injective (R : Type*) [CommRing R] {r : Fin d → Fin n}
    (hr : ¬ Function.Injective r) : pluckerLift R r = 0 :=
  dite_eq_right hr

/-- `pluckerLift R r` evaluates under `pluckerEval` to the generic minor on the rows `r`. -/
@[simp]
theorem pluckerEval_pluckerLift (R : Type*) [CommRing R] (r : Fin d → Fin n) :
    pluckerEval R n d (pluckerLift R r) = Matrix.mvPolynomialMinor R r id := by
  rw [pluckerLift]
  split_ifs with hr
  · let I : Fin d ↪o Fin n :=
      OrderEmbedding.ofStrictMono (r ∘ Tuple.sort r) (Tuple.strictMono_comp_sort hr)
    have hrI : r = ⇑I ∘ ⇑(Tuple.sort r)⁻¹ := by ext c; simp [I]
    conv_rhs => rw [hrI]
    rw [Matrix.mvPolynomialMinor_comp_perm_left, Perm.sign_inv, Units.smul_def, Units.smul_def,
      map_zsmul, pluckerEval_X_pluckerVar, maximalMinor_def]
  · rw [map_zero, Matrix.mvPolynomialMinor_eq_zero_of_not_injective_left hr]

/-- Lifting an already strictly increasing row tuple `I : Fin d ↪o Fin n` gives the Plücker
variable `X (pluckerVar I)` with sign `+1`. -/
@[simp]
theorem pluckerLift_coe (R : Type*) [CommRing R] (I : Fin d ↪o Fin n) :
    pluckerLift R ⇑I = X (pluckerVar I) := by
  have hsort : Tuple.sort ⇑I = Equiv.refl (Fin d) :=
    Tuple.sort_eq_refl_iff_monotone.2 I.monotone
  simp only [pluckerLift, I.injective, dite_true, hsort, Perm.sign_refl, one_smul]
  exact congrArg (fun J ↦ X (pluckerVar J)) (DFunLike.ext _ _ fun _ ↦ rfl)

theorem pluckerLift_isHomogeneous (R : Type*) [CommRing R] (r : Fin d → Fin n) :
    (pluckerLift R r).IsHomogeneous 1 := by
  rw [pluckerLift]
  split_ifs with hr
  · rw [← mem_homogeneousSubmodule, Units.smul_def]
    exact zsmul_mem ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X R _)) _
  · exact isHomogeneous_zero (Lex (Fin d ↪o Fin n))ᵒᵈ R 1

@[simp]
theorem map_pluckerLift {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (r : Fin d → Fin n) : map φ (pluckerLift R r) = pluckerLift S r := by
  rw [pluckerLift, pluckerLift]
  split_ifs with hr
  · simp [Units.smul_def]
  · simp

/-- The first column index `k` at which `J k < I k`, witnessing `¬ I ≤ J`. -/
private noncomputable def pluckerPivot {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) : Fin d :=
  (univ.filter fun c ↦ J c < I c).min' <| by
    rw [OrderEmbedding.le_def] at hIJ
    push Not at hIJ
    obtain ⟨c, hc⟩ := hIJ
    exact ⟨c, mem_filter.2 ⟨mem_univ c, hc⟩⟩

private theorem apply_pluckerPivot_lt {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    J (pluckerPivot hIJ) < I (pluckerPivot hIJ) := by
  rw [pluckerPivot]
  exact (mem_filter.1 (min'_mem (univ.filter fun c ↦ J c < I c) _)).2

private abbrev PluckerLeftTail {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) : Type :=
  {a : Fin d // ¬ a < pluckerPivot hIJ}

private abbrev PluckerRightInit {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) : Type :=
  {a : Fin d // ¬ pluckerPivot hIJ < a}

private noncomputable def pluckerGamma {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ → Fin n :=
  Sum.elim (fun a ↦ I a.1) (fun b ↦ J b.1)

private noncomputable def pluckerLeftRow {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J)
    (σ : Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ)) : Fin d → Fin n :=
  Sum.elim (fun a : {a : Fin d // a < pluckerPivot hIJ} ↦ I a.1)
    (pluckerGamma hIJ ∘ σ ∘ Sum.inl) ∘ (Equiv.sumCompl (· < pluckerPivot hIJ)).symm

private noncomputable def pluckerRightRow {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J)
    (σ : Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ)) : Fin d → Fin n :=
  Sum.elim (fun a : {a : Fin d // pluckerPivot hIJ < a} ↦ J a.1)
    (pluckerGamma hIJ ∘ σ ∘ Sum.inr) ∘ (Equiv.sumCompl (pluckerPivot hIJ < ·)).symm

private noncomputable def pluckerShuffleFinset {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    Finset (Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ)) :=
  univ.filter fun σ ↦ StrictMono (toLex ∘ σ ∘ Sum.inl) ∧ StrictMono (toLex ∘ σ ∘ Sum.inr)

private theorem one_mem_pluckerShuffleFinset {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    (1 : Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ)) ∈ pluckerShuffleFinset hIJ := by
  rw [pluckerShuffleFinset, mem_filter]
  exact ⟨mem_univ _,
    fun a b hab ↦ Sum.Lex.inl_lt_inl_iff.2 hab,
    fun a b hab ↦ Sum.Lex.inr_lt_inr_iff.2 hab⟩

private theorem pluckerLeftRow_one {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    pluckerLeftRow hIJ 1 = ⇑I := by
  ext c
  rw [pluckerLeftRow]
  by_cases hc : c < pluckerPivot hIJ <;> simp [pluckerGamma, Equiv.sumCompl, hc]

private theorem pluckerRightRow_one {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    pluckerRightRow hIJ 1 = ⇑J := by
  ext c
  rw [pluckerRightRow]
  by_cases hc : pluckerPivot hIJ < c <;> simp [pluckerGamma, Equiv.sumCompl, hc]

private theorem isComplement_pluckerShuffleFinset {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    Subgroup.IsComplement
      (pluckerShuffleFinset hIJ : Set (Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ)))
      (Perm.sumCongrHom (PluckerLeftTail hIJ) (PluckerRightInit hIJ)).range := by
  have hset :
      (pluckerShuffleFinset hIJ : Set (Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ))) =
        {σ : Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ) |
          StrictMono (toLex ∘ ⇑σ ∘ Sum.inl) ∧ StrictMono (toLex ∘ ⇑σ ∘ Sum.inr)} := by
    ext σ
    simp [pluckerShuffleFinset]
  rw [hset]
  exact Perm.isComplement_setOf_strictMono_toLex_sumCongrHom_range
    (PluckerLeftTail hIJ) (PluckerRightInit hIJ)

private theorem card_lt_pluckerShuffle {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    Fintype.card (Fin d) <
      Fintype.card (PluckerLeftTail hIJ) + Fintype.card (PluckerRightInit hIJ) := by
  have hsum : Fintype.card {a : Fin d // a < pluckerPivot hIJ} +
      Fintype.card (PluckerLeftTail hIJ) = Fintype.card (Fin d) := by
    rw [← Fintype.card_sum, Fintype.card_congr (Equiv.sumCompl (· < pluckerPivot hIJ))]
  have hlt : Fintype.card {a : Fin d // a < pluckerPivot hIJ} <
      Fintype.card (PluckerRightInit hIJ) := by
    rw [Fintype.card_subtype, Fintype.card_subtype]
    refine card_lt_card ⟨fun a ha ↦ mem_filter.2 ⟨mem_univ a, not_lt_of_gt (mem_filter.1 ha).2⟩,
      fun h ↦ ?_⟩
    exact lt_irrefl (pluckerPivot hIJ)
      (mem_filter.1 (h (mem_filter.2 ⟨mem_univ _, lt_irrefl _⟩))).2
  omega

/-- The **quadratic Plücker straightening relation** attached to `I, J : Fin d ↪o Fin n` with
`hIJ : ¬ I ≤ J`, obtained by shuffling `{a | k ≤ a}` of `I` with `{a | a ≤ k}` of `J` at the first
column `k` where `J k < I k`. -/
noncomputable def pluckerQuadric (R : Type*) [CommRing R] {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R :=
  ∑ σ ∈ pluckerShuffleFinset hIJ,
    Perm.sign σ •
      (pluckerLift R (pluckerLeftRow hIJ σ) * pluckerLift R (pluckerRightRow hIJ σ))

/-- Every quadratic Plücker straightening relation belongs to `pluckerIdeal R n d`. -/
theorem pluckerQuadric_mem_pluckerIdeal (R : Type*) [CommRing R] {I J : Fin d ↪o Fin n}
    (hIJ : ¬ I ≤ J) : pluckerQuadric R hIJ ∈ pluckerIdeal R n d := by
  rw [mem_pluckerIdeal_iff, pluckerQuadric, map_sum]
  have hterm (σ : Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ)) :
      pluckerEval R n d
          (Perm.sign σ •
            (pluckerLift R (pluckerLeftRow hIJ σ) * pluckerLift R (pluckerRightRow hIJ σ))) =
        Perm.sign σ •
          (Matrix.mvPolynomialMinor R (pluckerLeftRow hIJ σ) id *
            Matrix.mvPolynomialMinor R (pluckerRightRow hIJ σ) id) := by
    rw [Units.smul_def, Units.smul_def, map_zsmul, map_mul, pluckerEval_pluckerLift,
      pluckerEval_pluckerLift]
  simp_rw [hterm]
  exact Matrix.sum_sign_smul_mvPolynomialMinor_mul_mvPolynomialMinor_eq_zero R id
    (Equiv.sumCompl (· < pluckerPivot hIJ)).symm (Equiv.sumCompl (pluckerPivot hIJ < ·)).symm
    (fun a ↦ I a.1) (fun a ↦ J a.1) (pluckerGamma hIJ) (card_lt_pluckerShuffle hIJ)
    (isComplement_pluckerShuffleFinset hIJ)

/-- Every quadratic Plücker straightening relation is homogeneous of degree `2`. -/
theorem pluckerQuadric_isHomogeneous (R : Type*) [CommRing R] {I J : Fin d ↪o Fin n}
    (hIJ : ¬ I ≤ J) : (pluckerQuadric R hIJ).IsHomogeneous 2 := by
  rw [pluckerQuadric, ← mem_homogeneousSubmodule]
  refine sum_mem fun σ _ ↦ ?_
  rw [Units.smul_def]
  refine zsmul_mem ?_ _
  rw [mem_homogeneousSubmodule]
  exact (pluckerLift_isHomogeneous R _).mul (pluckerLift_isHomogeneous R _)

/-- Quadratic Plücker straightening relations commute with change of coefficient ring. -/
@[simp]
theorem map_pluckerQuadric {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    map φ (pluckerQuadric R hIJ) = pluckerQuadric S hIJ := by
  simp [pluckerQuadric, Units.smul_def]

/-- A non-identity `(PluckerLeftTail, PluckerRightInit)`-shuffle sends at least one left index
into the right summand. -/
private theorem exists_apply_inl_eq_inr_of_ne_one {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J)
    {σ : Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ)}
    (hσ : σ ∈ pluckerShuffleFinset hIJ) (hne : σ ≠ 1) :
    ∃ (a : PluckerLeftTail hIJ) (b : PluckerRightInit hIJ), σ (Sum.inl a) = Sum.inr b := by
  by_contra! h
  have hinl (a : PluckerLeftTail hIJ) : ∃ a', σ (Sum.inl a) = Sum.inl a' := by
    rcases h' : σ (Sum.inl a) with a' | b
    · exact ⟨a', rfl⟩
    · exact (h a b h').elim
  choose f hf using hinl
  have hf_inj : Function.Injective f := fun a₁ a₂ heq ↦
    Sum.inl_injective (σ.injective ((hf a₁).trans (heq ▸ (hf a₂).symm)))
  have hf_surj : Function.Surjective f := Finite.injective_iff_surjective.1 hf_inj
  have hisLeft (x : PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ) :
      (σ x).isLeft ↔ x.isLeft := by
    rcases x with a | b
    · simp [hf a]
    · rcases hb : σ (Sum.inr b) with a' | b'
      · obtain ⟨a, rfl⟩ := hf_surj a'
        exact absurd (σ.injective (hb.trans (hf a).symm)) (by simp)
      · simp
  have hisRight (x : PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ) :
      (σ x).isRight ↔ x.isRight := by
    simpa only [Sum.not_isLeft] using not_congr (hisLeft x)
  have hmem : σ ∈ (Perm.sumCongrHom (PluckerLeftTail hIJ) (PluckerRightInit hIJ)).range := by
    refine ⟨(Equiv.sumIsLeft.permCongr (σ.subtypePerm hisLeft),
        Equiv.sumIsRight.permCongr (σ.subtypePerm hisRight)), ?_⟩
    ext (a | b) <;> simp [Equiv.permCongr_apply, Perm.subtypePerm_apply]
  have heq : (⟨σ, hσ⟩ : ↥(pluckerShuffleFinset hIJ : Set _)) =
      ⟨1, one_mem_pluckerShuffleFinset hIJ⟩ :=
    (Subgroup.isComplement_iff_existsUnique_inv_mul_mem.1
      (isComplement_pluckerShuffleFinset hIJ) 1).unique
      (by simpa only [mul_one, SetLike.mem_coe] using Subgroup.inv_mem _ hmem)
      (by simpa only [inv_one, mul_one, SetLike.mem_coe] using
        one_mem (Perm.sumCongrHom (PluckerLeftTail hIJ) (PluckerRightInit hIJ)).range)
  exact hne (congrArg Subtype.val heq)

/-- For a non-identity shuffle whose left row tuple `r₁` is injective, sorting `r₁` yields an
increasing row tuple strictly preceding `I` in `Lex`. -/
private theorem toLex_sorted_pluckerLeftRow_lt {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J)
    {σ : Perm (PluckerLeftTail hIJ ⊕ PluckerRightInit hIJ)}
    (hσ : σ ∈ pluckerShuffleFinset hIJ) (hne : σ ≠ 1)
    (hr₁ : Function.Injective (pluckerLeftRow hIJ σ)) :
    toLex (OrderEmbedding.ofStrictMono (pluckerLeftRow hIJ σ ∘ Tuple.sort (pluckerLeftRow hIJ σ))
      (Tuple.strictMono_comp_sort hr₁)) < toLex I := by
  set r₁ := pluckerLeftRow hIJ σ
  set I' := OrderEmbedding.ofStrictMono (r₁ ∘ Tuple.sort r₁) (Tuple.strictMono_comp_sort hr₁)
  have hr₁_lt (c : Fin d) (hc : c < pluckerPivot hIJ) : r₁ c = I c := by
    simp [r₁, pluckerLeftRow, Equiv.sumCompl, hc]
  obtain ⟨a₀, b₀, hab⟩ := exists_apply_inl_eq_inr_of_ne_one hIJ hσ hne
  have hr₁_a₀ : r₁ a₀.1 < I (pluckerPivot hIJ) := by
    have hval : r₁ a₀.1 = J b₀.1 := by
      simp [r₁, pluckerLeftRow, Equiv.sumCompl, a₀.2, hab, pluckerGamma]
    exact hval.trans_lt ((J.monotone (le_of_not_gt b₀.2)).trans_lt (apply_pluckerPivot_lt hIJ))
  refine OrderEmbedding.toLex_lt_of_forall_lt_mem_range (k := pluckerPivot hIJ) (fun c hc ↦ ?_) ?_
  · rw [show Set.range ⇑I' = Set.range r₁ from Tuple.range_comp_sort r₁, ← hr₁_lt c hc]
    exact ⟨c, rfl⟩
  · rw [← Tuple.lt_card_lt_iff_apply_lt_of_monotone I'.monotone]
    have hcard_eq :
        #{x : Fin d | I' x < I (pluckerPivot hIJ)} =
          #{x : Fin d | r₁ x < I (pluckerPivot hIJ)} := by
      rw [← card_image_of_injective _ (Tuple.sort r₁).injective]
      congr 1
      ext x
      simp only [mem_image, mem_filter, mem_univ, true_and]
      exact ⟨fun ⟨_, hy, hyx⟩ ↦ hyx ▸ hy,
        fun hx ↦ ⟨(Tuple.sort r₁).symm x, by simpa [I'] using hx, by simp⟩⟩
    rw [hcard_eq]
    have hsub : insert a₀.1 (univ.filter (· < pluckerPivot hIJ)) ⊆
        univ.filter (fun x ↦ r₁ x < I (pluckerPivot hIJ)) := by
      intro x hx
      rcases mem_insert.1 hx with rfl | hx
      · exact mem_filter.2 ⟨mem_univ _, hr₁_a₀⟩
      · have hxk := (mem_filter.1 hx).2
        exact mem_filter.2 ⟨mem_univ _, (hr₁_lt x hxk).trans_lt (I.strictMono hxk)⟩
    have hcard_lt : #{x : Fin d | x < pluckerPivot hIJ} = (pluckerPivot hIJ : ℕ) := by
      have hid := Tuple.val_sort_symm_apply Function.injective_id (pluckerPivot hIJ)
      have hsort : Tuple.sort (id : Fin d → Fin d) = Equiv.refl (Fin d) :=
        Tuple.sort_eq_refl_iff_monotone.2 monotone_id
      simpa [hsort] using hid.symm
    have hle := card_le_card hsub
    rw [card_insert_of_notMem (by simpa using a₀.2), hcard_lt] at hle
    exact Nat.lt_of_succ_le hle

/-- If `toLex I' < toLex I` and `toLex I < toLex J`, then `X_{I'} * X_{J'}` is strictly smaller
than `X_I * X_J` in `TauCeti.MonomialOrder.degRevLex`. -/
private theorem degRevLex_pair_lt_of_toLex_lt {I J I' J' : Fin d ↪o Fin n}
    (hlt : toLex I < toLex J) (hI' : toLex I' < toLex I) :
    Finsupp.single (pluckerVar I') 1 + Finsupp.single (pluckerVar J') 1 ≺[MonomialOrder.degRevLex]
      Finsupp.single (pluckerVar I) 1 + Finsupp.single (pluckerVar J) 1 := by
  rw [MonomialOrder.degRevLex_lt_iff, DegRevLex.lt_iff_exists]
  refine Or.inr ⟨by simp, OrderDual.toDual (min (toLex I') (toLex J')), fun w hw ↦ ?_, ?_⟩
  · have hmw : OrderDual.ofDual w < min (toLex I') (toLex J') := hw
    have hwI' : w ≠ pluckerVar I' := fun h ↦
      (lt_of_lt_of_le hmw (min_le_left _ _)).ne (congrArg OrderDual.ofDual h)
    have hwJ' : w ≠ pluckerVar J' := fun h ↦
      (lt_of_lt_of_le hmw (min_le_right _ _)).ne (congrArg OrderDual.ofDual h)
    have hwI : w ≠ pluckerVar I := fun h ↦
      ((lt_of_lt_of_le hmw (min_le_left _ _)).trans hI').ne (congrArg OrderDual.ofDual h)
    have hwJ : w ≠ pluckerVar J := fun h ↦
      (((lt_of_lt_of_le hmw (min_le_left _ _)).trans hI').trans hlt).ne
        (congrArg OrderDual.ofDual h)
    simp [Finsupp.single_eq_of_ne, hwI', hwJ', hwI, hwJ]
  · set v : (Lex (Fin d ↪o Fin n))ᵒᵈ := OrderDual.toDual (min (toLex I') (toLex J'))
    have hvI : pluckerVar I ≠ v := fun h ↦
      (lt_of_le_of_lt (min_le_left _ _) hI').ne (congrArg OrderDual.ofDual h).symm
    have hvJ : pluckerVar J ≠ v := fun h ↦
      ((lt_of_le_of_lt (min_le_left _ _) hI').trans hlt).ne (congrArg OrderDual.ofDual h).symm
    have hlhs :
        ((Finsupp.single (pluckerVar I) 1 + Finsupp.single (pluckerVar J) 1 :
          (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ)) v = 0 := by
      simp [hvI, hvJ]
    rw [ofDegRevLex_toDegRevLex, ofDegRevLex_toDegRevLex, hlhs]
    rcases min_choice (toLex I') (toLex J') with hmin | hmin
    · have hv : v = pluckerVar I' := congrArg OrderDual.toDual hmin
      rw [hv, Finsupp.add_apply, Finsupp.single_eq_same]
      exact Nat.succ_add _ _ ▸ Nat.succ_pos _
    · have hv : v = pluckerVar J' := congrArg OrderDual.toDual hmin
      rw [hv, Finsupp.add_apply, Finsupp.single_eq_same]
      exact Nat.add_pos_right _ (Nat.succ_pos _)

private theorem pluckerQuadric_eq_monomial_add_rest (R : Type*) [CommRing R]
    {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) :
    pluckerQuadric R hIJ =
      monomial (Finsupp.single (pluckerVar I) 1 + Finsupp.single (pluckerVar J) 1) 1 +
        ∑ σ ∈ (pluckerShuffleFinset hIJ).erase 1,
          Perm.sign σ •
            (pluckerLift R (pluckerLeftRow hIJ σ) * pluckerLift R (pluckerRightRow hIJ σ)) := by
  rw [pluckerQuadric, ← add_sum_erase _ _ (one_mem_pluckerShuffleFinset hIJ), map_one, one_smul,
    pluckerLeftRow_one, pluckerRightRow_one, pluckerLift_coe, pluckerLift_coe, X, X,
    monomial_mul_monomial, one_mul]

private theorem degree_pluckerQuadric_rest_lt (R : Type*) [CommRing R]
    {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J) (hlt : toLex I < toLex J) :
    MonomialOrder.degRevLex.degree
        (∑ σ ∈ (pluckerShuffleFinset hIJ).erase 1,
          Perm.sign σ •
            (pluckerLift R (pluckerLeftRow hIJ σ) * pluckerLift R (pluckerRightRow hIJ σ)))
      ≺[MonomialOrder.degRevLex]
        Finsupp.single (pluckerVar I) 1 + Finsupp.single (pluckerVar J) 1 := by
  set e₀ := Finsupp.single (pluckerVar I) 1 + Finsupp.single (pluckerVar J) 1
  have hzero : (0 : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ) ≺[MonomialOrder.degRevLex] e₀ := by
    rw [MonomialOrder.degRevLex_lt_iff, DegRevLex.lt_iff]
    exact Or.inl (by simp [e₀])
  refine lt_of_le_of_lt MonomialOrder.degRevLex.degree_sum_le ?_
  rw [Finset.sup_lt_iff (by simpa using hzero)]
  intro σ hσ
  obtain ⟨hne, hσT⟩ := mem_erase.1 hσ
  by_cases hl : Function.Injective (pluckerLeftRow hIJ σ)
  · by_cases hr : Function.Injective (pluckerRightRow hIJ σ)
    · set I' := OrderEmbedding.ofStrictMono
        (pluckerLeftRow hIJ σ ∘ Tuple.sort (pluckerLeftRow hIJ σ)) (Tuple.strictMono_comp_sort hl)
      set J' := OrderEmbedding.ofStrictMono
        (pluckerRightRow hIJ σ ∘ Tuple.sort (pluckerRightRow hIJ σ)) (Tuple.strictMono_comp_sort hr)
      have hterm : Perm.sign σ •
          (pluckerLift R (pluckerLeftRow hIJ σ) * pluckerLift R (pluckerRightRow hIJ σ)) =
          monomial (Finsupp.single (pluckerVar I') 1 + Finsupp.single (pluckerVar J') 1)
            (((Perm.sign σ * Perm.sign (Tuple.sort (pluckerLeftRow hIJ σ)) *
              Perm.sign (Tuple.sort (pluckerRightRow hIJ σ)) : ℤˣ) : ℤ) : R) := by
        simp only [pluckerLift, hl, hr, dite_true, I', J', X, Units.smul_def, smul_monomial,
          zsmul_eq_mul, mul_one, monomial_mul_monomial, Units.val_mul, Int.cast_mul, mul_assoc]
      rw [hterm]
      exact lt_of_le_of_lt (MonomialOrder.degRevLex.degree_monomial_le _)
        (degRevLex_pair_lt_of_toLex_lt hlt (toLex_sorted_pluckerLeftRow_lt hIJ hσT hne hl))
    · simpa [pluckerLift, hr] using hzero
  · simpa [pluckerLift, hl] using hzero

/-- For `toLex I < toLex J` and `hIJ : ¬ I ≤ J`, the quadratic Plücker straightening relation
`pluckerQuadric R hIJ` is monic with respect to `TauCeti.MonomialOrder.degRevLex`. -/
@[simp]
theorem monic_pluckerQuadric (R : Type*) [CommRing R] {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J)
    (hlt : toLex I < toLex J) : MonomialOrder.degRevLex.Monic (pluckerQuadric R hIJ) := by
  classical
  nontriviality R
  rw [pluckerQuadric_eq_monomial_add_rest]
  refine (MonomialOrder.degRevLex.monic_monomial.2 rfl).add_of_lt ?_
  simpa [MonomialOrder.degRevLex.degree_monomial] using degree_pluckerQuadric_rest_lt R hIJ hlt

/-- For `toLex I < toLex J` and `hIJ : ¬ I ≤ J`, the leading exponent of `pluckerQuadric R hIJ`
under `TauCeti.MonomialOrder.degRevLex` is `single (pluckerVar I) 1 + single (pluckerVar J) 1`. -/
@[simp]
theorem degree_pluckerQuadric (R : Type*) [CommRing R] [Nontrivial R] {I J : Fin d ↪o Fin n}
    (hIJ : ¬ I ≤ J) (hlt : toLex I < toLex J) :
    MonomialOrder.degRevLex.degree (pluckerQuadric R hIJ) =
      Finsupp.single (pluckerVar I) 1 + Finsupp.single (pluckerVar J) 1 := by
  classical
  rw [pluckerQuadric_eq_monomial_add_rest]
  have hdeg : MonomialOrder.degRevLex.degree
      (monomial (Finsupp.single (pluckerVar I) 1 + Finsupp.single (pluckerVar J) 1) (1 : R)) =
      Finsupp.single (pluckerVar I) 1 + Finsupp.single (pluckerVar J) 1 := by
    simp [MonomialOrder.degRevLex.degree_monomial]
  rw [MonomialOrder.degRevLex.degree_add_of_lt, hdeg]
  rw [hdeg]
  exact degree_pluckerQuadric_rest_lt R hIJ hlt

/-- For `toLex I < toLex J` and `hIJ : ¬ I ≤ J`, the leading term of `pluckerQuadric R hIJ` under
`TauCeti.MonomialOrder.degRevLex` is `X (pluckerVar I) * X (pluckerVar J)`. -/
@[simp]
theorem leadingTerm_pluckerQuadric {R : Type*} [CommRing R] {I J : Fin d ↪o Fin n} (hIJ : ¬ I ≤ J)
    (hlt : toLex I < toLex J) :
    MonomialOrder.degRevLex.leadingTerm (pluckerQuadric R hIJ) =
      X (pluckerVar I) * X (pluckerVar J) := by
  nontriviality R
  rw [_root_.MonomialOrder.leadingTerm, degree_pluckerQuadric R hIJ hlt,
    (monic_pluckerQuadric R hIJ hlt).leadingCoeff_eq_one, X, X, monomial_mul_monomial, one_mul]

/-- When `toLex I < toLex J`, `¬ I ≤ J` is equivalent to componentwise incomparability
`¬ (I ≤ J ∨ J ≤ I)`, because `J ≤ I` would contradict `toLex I < toLex J`. -/
theorem not_le_iff_incomparable_of_toLex_lt {I J : Fin d ↪o Fin n} (hlt : toLex I < toLex J) :
    ¬ I ≤ J ↔ ¬ (I ≤ J ∨ J ≤ I) :=
  ⟨fun hIJ h ↦ h.elim hIJ fun hJI ↦ hlt.not_ge (OrderEmbedding.toLex_monotone hJI),
    fun h hIJ ↦ h (Or.inl hIJ)⟩

/-- The set of quadratic Plücker straightening relations attached to incomparable pairs
`(I, J)` ordered with `toLex I < toLex J`. -/
noncomputable def pluckerQuadrics (R : Type*) [CommRing R] (n d : ℕ) :
    Set (MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :=
  {g | ∃ (I J : Fin d ↪o Fin n) (hIJ : ¬ I ≤ J), toLex I < toLex J ∧ pluckerQuadric R hIJ = g}

theorem pluckerQuadrics_def (R : Type*) [CommRing R] (n d : ℕ) :
    pluckerQuadrics R n d =
      {g | ∃ (I J : Fin d ↪o Fin n) (hIJ : ¬ I ≤ J),
        toLex I < toLex J ∧ pluckerQuadric R hIJ = g} :=
  (rfl)

@[simp]
theorem mem_pluckerQuadrics_iff {R : Type*} [CommRing R]
    {g : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R} :
    g ∈ pluckerQuadrics R n d ↔
      ∃ (I J : Fin d ↪o Fin n) (hIJ : ¬ I ≤ J), toLex I < toLex J ∧ pluckerQuadric R hIJ = g :=
  Iff.rfl

theorem pluckerQuadrics_subset_pluckerIdeal (R : Type*) [CommRing R] (n d : ℕ) :
    pluckerQuadrics R n d ⊆ pluckerIdeal R n d := by
  rintro _ ⟨I, J, hIJ, -, rfl⟩
  exact pluckerQuadric_mem_pluckerIdeal R hIJ

theorem monic_of_mem_pluckerQuadrics {R : Type*} [CommRing R]
    {g : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R} (hg : g ∈ pluckerQuadrics R n d) :
    MonomialOrder.degRevLex.Monic g := by
  obtain ⟨I, J, hIJ, hlt, rfl⟩ := hg
  exact monic_pluckerQuadric R hIJ hlt

end Straightening

end TauCeti
