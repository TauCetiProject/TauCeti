/-!
# Certified Gröbner basis, standard monomials and SAGBI basis for maximal minors

For the generic `n × d` matrix (`d ≠ 0`) over any commutative ring `R`, this file proves that the
quadratic Plücker straightening relations `TauCeti.pluckerQuadrics R n d` form a certified Gröbner
basis of `TauCeti.pluckerIdeal R n d` with respect to the graded reverse lexicographic order
`TauCeti.MonomialOrder.degRevLex` on the Plücker variables `TauCeti.pluckerVar I`, and deduces:

1. **Polynomial presentation, base change and initial ideal:** `TauCeti.pluckerIdeal R n d` is
   generated by `TauCeti.pluckerQuadrics R n d` (`TauCeti.pluckerIdeal_eq_span_pluckerQuadrics`),
   commutes with arbitrary ring homomorphisms (`TauCeti.map_pluckerIdeal`), is homogeneous
   (`TauCeti.isHomogeneous_pluckerIdeal`), and has initial ideal generated by the quadratic
   monomials `X (pluckerVar I) * X (pluckerVar J)` for pairs `(I, J)` incomparable in the
   componentwise order (`TauCeti.span_leadingTerm_pluckerIdeal`).
2. **Tableau bijection for standard monomials:** an exponent `e` avoids these incomparable pairs
   (`TauCeti.IsPluckerChainExponent e`) if and only if its support is a chain in `Fin d ↪o Fin n`;
   summing unit steps along monotone chains and composing with `TauCeti.BoundedSSYT.rectColsEquiv`
   identifies these exponents bijectively with pairs `(m, T)` of a width `m : ℕ` and a bounded
   semistandard Young tableau `T : BoundedSSYT n (YoungDiagram.rect d m)`
   (`TauCeti.pluckerTableauExponentEquiv`).
3. **Standard-monomial normal form and bases:** distinct chain exponents have distinct diagonal
   weights (`TauCeti.injOn_pluckerDiagonalWeight_isPluckerChainExponent`), so no nonzero `R`-linear
   combination of chain monomials vanishes under `TauCeti.pluckerEval R n d`
   (`TauCeti.eq_zero_of_mem_restrictSupport_isPluckerChainExponent_of_mem_pluckerIdeal`).
   Consequently, every polynomial has a unique straightening normal form supported on chain
   exponents (`TauCeti.pluckerNormalForm`), and rectangular semistandard tableaux index `R`-bases of
   `MvPolynomial _ R ⧸ pluckerIdeal R n d` (`TauCeti.pluckerBasisQuotient`) and of
   `TauCeti.maximalMinorSubalgebra R n d` (`TauCeti.pluckerBasisSubalgebra`).
4. **Diagonal SAGBI basis:** for all `n, d : ℕ` and every commutative ring `R`, the `toLex`-renamed
   maximal minors form a SAGBI basis of the subalgebra they generate under row-major
   `MonomialOrder.lex` (`TauCeti.isSAGBIBasis_range_rename_toLex_maximalMinor`), with leading
   exponent monoid generated by `TauCeti.maximalMinorDiagonalExponent` over domains
   (`TauCeti.leadingExponents_map_rename_toLex_maximalMinorSubalgebra`).

## References

* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 14, Theorem 14.6 and Corollary 14.7.
* W. Bruns and U. Vetter, *Determinantal Rings*, Lecture Notes in Mathematics 1327, Springer, 1988,
  Section 4.A.
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
-/

public section

namespace TauCeti

open MvPolynomial Finset
open scoped _root_.MonomialOrder

section ChainExponents

variable {n d : ℕ}

/-- An exponent on the Plücker variables is a **chain exponent** when any two row embeddings
occurring in its support are comparable in the componentwise order on `Fin d ↪o Fin n`. -/
def IsPluckerChainExponent (e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ) : Prop :=
  ∀ ⦃I J : Fin d ↪o Fin n⦄, pluckerVar I ∈ e.support → pluckerVar J ∈ e.support → I ≤ J ∨ J ≤ I

theorem isPluckerChainExponent_def {e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ} :
    IsPluckerChainExponent e ↔
      ∀ ⦃I J : Fin d ↪o Fin n⦄,
        pluckerVar I ∈ e.support → pluckerVar J ∈ e.support → I ≤ J ∨ J ≤ I :=
  Iff.rfl

@[simp]
theorem isPluckerChainExponent_zero :
    IsPluckerChainExponent (0 : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ) := by
  simp [IsPluckerChainExponent]

@[simp]
theorem isPluckerChainExponent_single (v : (Lex (Fin d ↪o Fin n))ᵒᵈ) (k : ℕ) :
    IsPluckerChainExponent (Finsupp.single v k) := by
  intro I J hI hJ
  have hIv : pluckerVar I = v := Finset.mem_singleton.1 (Finsupp.support_single_subset hI)
  have hJv : pluckerVar J = v := Finset.mem_singleton.1 (Finsupp.support_single_subset hJ)
  exact Or.inl (le_of_eq (pluckerVar.injective (hIv.trans hJv.symm)))

/-- An exponent is a chain exponent if and only if it is not divisible by `X_I * X_J` for any pair
`(I, J)` with `toLex I < toLex J` and `¬ I ≤ J`. -/
theorem isPluckerChainExponent_iff_forall_not_le (e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ) :
    IsPluckerChainExponent e ↔
      ∀ ⦃I J : Fin d ↪o Fin n⦄, ¬ I ≤ J → toLex I < toLex J →
        ¬ Finsupp.single (pluckerVar I) 1 + Finsupp.single (pluckerVar J) 1 ≤ e := by
  refine ⟨fun he I J hIJ hlt hle ↦ ?_, fun h I J hI hJ ↦ ?_⟩
  · obtain ⟨hI, hJ⟩ := (Finsupp.single_one_add_single_one_le_iff
      (fun hv ↦ hlt.ne (congrArg toLex (pluckerVar.injective hv)))).1 hle
    exact (OrderEmbedding.not_le_iff_not_le_or_ge_of_toLex_lt hlt).1 hIJ (he hI hJ)
  · rcases lt_trichotomy (toLex I) (toLex J) with hlt | heq | hlt
    · by_contra hinc
      exact h ((OrderEmbedding.not_le_iff_not_le_or_ge_of_toLex_lt hlt).2 hinc) hlt
        ((Finsupp.single_one_add_single_one_le_iff
          (fun hv ↦ hlt.ne (congrArg toLex (pluckerVar.injective hv)))).2 ⟨hI, hJ⟩)
    · exact Or.inl (le_of_eq (toLex.injective heq))
    · by_contra hinc
      exact h ((OrderEmbedding.not_le_iff_not_le_or_ge_of_toLex_lt hlt).2 (Or.symm.mt hinc)) hlt
        ((Finsupp.single_one_add_single_one_le_iff
          (fun hv ↦ hlt.ne (congrArg toLex (pluckerVar.injective hv)))).2 ⟨hJ, hI⟩)

/-- The Plücker exponent attached to a monotone chain `C : Fin m →o (Fin d ↪o Fin n)`: the sum of
the unit steps at the Plücker variables of its columns. -/
noncomputable def pluckerChainExponent {m : ℕ} (C : Fin m →o (Fin d ↪o Fin n)) :
    (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ :=
  ∑ a : Fin m, Finsupp.single (pluckerVar (C a)) 1

theorem pluckerChainExponent_def {m : ℕ} (C : Fin m →o (Fin d ↪o Fin n)) :
    pluckerChainExponent C = ∑ a : Fin m, Finsupp.single (pluckerVar (C a)) 1 :=
  (rfl)

@[simp]
theorem pluckerChainExponent_apply [DecidableEq (Fin d ↪o Fin n)] {m : ℕ}
    (C : Fin m →o (Fin d ↪o Fin n)) (I : Fin d ↪o Fin n) :
    pluckerChainExponent C (pluckerVar I) = #{a : Fin m | C a = I} := by
  classical
  rw [pluckerChainExponent_def, Finsupp.sum_single_one_apply]
  congr 1
  ext a
  simp [pluckerVar.injective.eq_iff]

@[simp]
theorem degree_pluckerChainExponent {m : ℕ} (C : Fin m →o (Fin d ↪o Fin n)) :
    (pluckerChainExponent C).degree = m := by
  simp [pluckerChainExponent_def]

@[simp]
theorem isPluckerChainExponent_pluckerChainExponent {m : ℕ} (C : Fin m →o (Fin d ↪o Fin n)) :
    IsPluckerChainExponent (pluckerChainExponent C) := by
  intro I J hI hJ
  rw [Finsupp.mem_support_iff, pluckerChainExponent_def, Finsupp.sum_single_one_apply_ne_zero_iff]
    at hI hJ
  obtain ⟨a₁, ha₁⟩ := hI
  obtain ⟨a₂, ha₂⟩ := hJ
  have hI' : C a₁ = I := pluckerVar.injective ha₁
  have hJ' : C a₂ = J := pluckerVar.injective ha₂
  exact (le_total a₁ a₂).imp (fun h ↦ hI' ▸ hJ' ▸ C.monotone h)
    fun h ↦ hJ' ▸ hI' ▸ C.monotone h

variable (n d) in
/-- Monotone chains `(m : ℕ) × (Fin m →o (Fin d ↪o Fin n))` correspond bijectively via
`pluckerChainExponent` to chain exponents `{e | IsPluckerChainExponent e}`. -/
noncomputable def pluckerChainExponentEquiv :
    ((m : ℕ) × (Fin m →o (Fin d ↪o Fin n))) ≃
      {e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ | IsPluckerChainExponent e} :=
  Equiv.ofBijective
    (fun p ↦ ⟨pluckerChainExponent p.2, isPluckerChainExponent_pluckerChainExponent p.2⟩)
    ⟨by
      rintro ⟨m₁, C₁⟩ ⟨m₂, C₂⟩ h
      have heq : pluckerChainExponent C₁ = pluckerChainExponent C₂ := congrArg Subtype.val h
      have hm : m₁ = m₂ := by
        simpa using congrArg Finsupp.degree heq
      subst hm
      classical
      refine Sigma.ext rfl (heq_of_eq (DFunLike.coe_injective
        (Monotone.eq_of_card_filter_eq C₁.monotone C₂.monotone fun I ↦ ?_)))
      simpa only [pluckerChainExponent_apply] using congrArg (fun e ↦ e (pluckerVar I)) heq,
     by
      rintro ⟨e, he⟩
      let m := e.degree
      obtain ⟨f', hf'⟩ :=
        (Finsupp.exists_sum_single_eq_iff (n := m) e).2 (Finsupp.degree_apply e).symm
      set f : Fin m → Fin d ↪o Fin n := fun a ↦ pluckerVar.symm (f' a)
      set σ := Tuple.sort (toLex ∘ f)
      have hmem (a : Fin m) : pluckerVar (f (σ a)) ∈ e.support := by
        rw [Finsupp.mem_support_iff, ← hf']
        exact Finsupp.sum_single_one_apply_ne_zero_iff.2 ⟨σ a, by simp [f]⟩
      refine ⟨⟨m, ⟨f ∘ σ, fun a₁ a₂ ha ↦ ?_⟩⟩, Subtype.ext ?_⟩
      · exact (OrderEmbedding.le_iff_toLex_le_of_le_or_ge (he (hmem a₁) (hmem a₂))).2
          (Tuple.monotone_sort (toLex ∘ f) ha)
      · simp only [pluckerChainExponent_def]
        refine (Equiv.sum_comp σ fun a ↦ Finsupp.single (pluckerVar (f a)) 1).trans ?_
        simpa [f] using hf'⟩

@[simp]
theorem coe_pluckerChainExponentEquiv_apply {m : ℕ} (C : Fin m →o (Fin d ↪o Fin n)) :
    (pluckerChainExponentEquiv n d ⟨m, C⟩ : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ) =
      pluckerChainExponent C :=
  (rfl)

variable (n d) in
/-- **Tableau parametrization of chain exponents.** Pairs `(m, T)` of a width `m : ℕ` and a bounded
semistandard Young tableau `T : BoundedSSYT n (YoungDiagram.rect d m)` correspond bijectively to
chain exponents via `BoundedSSYT.rectColsEquiv` and `pluckerChainExponentEquiv`. -/
noncomputable def pluckerTableauExponentEquiv :
    ((m : ℕ) × BoundedSSYT n (YoungDiagram.rect d m)) ≃
      {e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ | IsPluckerChainExponent e} :=
  (Equiv.sigmaCongrRight (BoundedSSYT.rectColsEquiv n d)).symm.trans
    (pluckerChainExponentEquiv n d)

@[simp]
theorem coe_pluckerTableauExponentEquiv_apply {m : ℕ}
    (T : BoundedSSYT n (YoungDiagram.rect d m)) :
    (pluckerTableauExponentEquiv n d ⟨m, T⟩ : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ) =
      pluckerChainExponent ((BoundedSSYT.rectColsEquiv n d m).symm T) :=
  (rfl)

end ChainExponents

section DiagonalWeight

variable (n d : ℕ)

/-- The diagonal-exponent weight map sending a Plücker exponent `e` to the sum of the diagonal
exponents `maximalMinorDiagonalExponent I` weighted by `e (pluckerVar I)`. -/
noncomputable def pluckerDiagonalWeight :
    ((Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ) →ₗ[ℕ] (Fin n ×ₗ Fin d →₀ ℕ) :=
  Finsupp.linearCombination ℕ fun v ↦ maximalMinorDiagonalExponent (pluckerVar.symm v)

theorem pluckerDiagonalWeight_def :
    pluckerDiagonalWeight n d =
      Finsupp.linearCombination ℕ fun v ↦ maximalMinorDiagonalExponent (pluckerVar.symm v) :=
  (rfl)

variable {n d}

@[simp]
theorem pluckerDiagonalWeight_single (v : (Lex (Fin d ↪o Fin n))ᵒᵈ) (k : ℕ) :
    pluckerDiagonalWeight n d (Finsupp.single v k) =
      k • maximalMinorDiagonalExponent (pluckerVar.symm v) := by
  simp [pluckerDiagonalWeight]

theorem pluckerDiagonalWeight_single_pluckerVar (I : Fin d ↪o Fin n) (k : ℕ) :
    pluckerDiagonalWeight n d (Finsupp.single (pluckerVar I) k) =
      k • maximalMinorDiagonalExponent I := by
  simp

@[simp]
theorem degree_pluckerDiagonalWeight (e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ) :
    (pluckerDiagonalWeight n d e).degree = e.degree * d := by
  induction e using Finsupp.induction_linear with
  | zero => simp
  | add e₁ e₂ ih₁ ih₂ =>
    rw [map_add, Finsupp.degree_eq_weight_one, map_add, map_add, ← Finsupp.degree_eq_weight_one,
      ih₁, ih₂, add_mul]
  | single v k =>
    rw [pluckerDiagonalWeight_single, Finsupp.degree_eq_weight_one, map_nsmul,
      ← Finsupp.degree_eq_weight_one, degree_maximalMinorDiagonalExponent, Finsupp.degree_single,
      smul_eq_mul]

@[simp]
theorem pluckerDiagonalWeight_pluckerChainExponent {m : ℕ} (C : Fin m →o (Fin d ↪o Fin n)) :
    pluckerDiagonalWeight n d (pluckerChainExponent C) =
      ∑ a : Fin m, maximalMinorDiagonalExponent (C a) := by
  simp [pluckerChainExponent_def, map_sum]

theorem pluckerDiagonalWeight_pluckerChainExponent_apply {m : ℕ} (C : Fin m →o (Fin d ↪o Fin n))
    (r : Fin n) (c : Fin d) :
    pluckerDiagonalWeight n d (pluckerChainExponent C) (toLex (r, c)) =
      #{a : Fin m | C a c = r} := by
  rw [pluckerDiagonalWeight_pluckerChainExponent, Finsupp.finsetSum_apply, card_filter]
  exact sum_congr rfl fun a _ ↦ maximalMinorDiagonalExponent_apply (C a) r c

theorem degree_pluckerDiagonalWeight_pluckerChainExponent {m : ℕ}
    (C : Fin m →o (Fin d ↪o Fin n)) :
    (pluckerDiagonalWeight n d (pluckerChainExponent C)).degree = m * d := by
  simp

/-- **Distinct diagonal leading exponents.** When `d ≠ 0`, distinct chain exponents have distinct
diagonal weights in `Fin n ×ₗ Fin d →₀ ℕ`: the total degree recovers the chain length `m`, and the
entries in each column `c : Fin d` recover the monotone row sequence `a ↦ C a c`. -/
theorem injOn_pluckerDiagonalWeight_isPluckerChainExponent [NeZero d] :
    Set.InjOn (pluckerDiagonalWeight n d) {e | IsPluckerChainExponent e} := by
  intro e₁ he₁ e₂ he₂ h
  obtain ⟨⟨m₁, C₁⟩, h₁⟩ := (pluckerChainExponentEquiv n d).surjective ⟨e₁, he₁⟩
  obtain ⟨⟨m₂, C₂⟩, h₂⟩ := (pluckerChainExponentEquiv n d).surjective ⟨e₂, he₂⟩
  have he₁' : pluckerChainExponent C₁ = e₁ := congrArg Subtype.val h₁
  have he₂' : pluckerChainExponent C₂ = e₂ := congrArg Subtype.val h₂
  rw [← he₁', ← he₂'] at h ⊢
  have hm : m₁ = m₂ := Nat.eq_of_mul_eq_mul_right (NeZero.pos d) <| by
    simpa only [degree_pluckerDiagonalWeight_pluckerChainExponent] using
      congrArg Finsupp.degree h
  subst hm
  classical
  suffices C₁ = C₂ by rw [this]
  have hcol (c : Fin d) : (fun a ↦ C₁ a c) = fun a ↦ C₂ a c :=
    Monotone.eq_of_card_filter_eq (fun _ _ ha ↦ C₁.monotone ha c) (fun _ _ ha ↦ C₂.monotone ha c)
      fun r ↦ by
        simpa only [pluckerDiagonalWeight_pluckerChainExponent_apply] using
          congrArg (fun w ↦ w (toLex (r, c))) h
  ext a c
  exact congrArg Fin.val (congrFun (hcol c) a)

end DiagonalWeight

section Groebner

variable (R : Type*) [CommRing R] (n d : ℕ)

private theorem linearCombination_degree_rename_toLex_maximalMinor [Nontrivial R] :
    (Finsupp.linearCombination ℕ fun v : (Lex (Fin d ↪o Fin n))ᵒᵈ ↦
      _root_.MonomialOrder.lex.degree (rename toLex (maximalMinor R (pluckerVar.symm v)))) =
      pluckerDiagonalWeight n d := by
  ext v
  simp

/-- For `d ≠ 0` and any nonzero polynomial `r` supported on `{e | IsPluckerChainExponent e}`,
the leading exponent and leading coefficient of `rename toLex (pluckerEval R n d r)` under
row-major `MonomialOrder.lex` are `pluckerDiagonalWeight n d e₀` and `r.coeff e₀` for some
`e₀ ∈ r.support`. -/
theorem exists_mem_support_degree_rename_toLex_pluckerEval_eq_and_leadingCoeff_eq [NeZero d]
    {r : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R}
    (hr : r ∈ restrictSupport R {e | IsPluckerChainExponent e}) (hr0 : r ≠ 0) :
    ∃ e₀ ∈ r.support,
      _root_.MonomialOrder.lex.degree (rename toLex (pluckerEval R n d r)) =
        pluckerDiagonalWeight n d e₀ ∧
      _root_.MonomialOrder.lex.leadingCoeff (rename toLex (pluckerEval R n d r)) =
        r.coeff e₀ := by
  rcases subsingleton_or_nontrivial R with hR | hR
  · exact absurd (Subsingleton.elim r 0) hr0
  rw [pluckerEval_def, comp_aeval_apply]
  have hlin := linearCombination_degree_rename_toLex_maximalMinor R n d
  simpa only [Function.comp_def, hlin] using
    _root_.MonomialOrder.lex.exists_mem_support_degree_aeval_eq_and_leadingCoeff_eq
      (fun v ↦ monic_rename_toLex_maximalMinor R (pluckerVar.symm v))
      (by
        rw [hlin]
        exact injOn_pluckerDiagonalWeight_isPluckerChainExponent.mono
          ((mem_restrictSupport_iff R).1 hr))
      hr0

/-- For `d ≠ 0` and any nonzero polynomial `r` supported on `{e | IsPluckerChainExponent e}`,
`rename toLex (pluckerEval R n d r)` is nonzero. -/
theorem rename_toLex_pluckerEval_ne_zero [NeZero d]
    {r : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R}
    (hr : r ∈ restrictSupport R {e | IsPluckerChainExponent e}) (hr0 : r ≠ 0) :
    rename toLex (pluckerEval R n d r) ≠ 0 := by
  obtain ⟨e₀, he₀, -, hlc⟩ :=
    exists_mem_support_degree_rename_toLex_pluckerEval_eq_and_leadingCoeff_eq R n d hr hr0
  intro h0
  rw [h0, _root_.MonomialOrder.leadingCoeff_zero] at hlc
  exact MvPolynomial.mem_support_iff.1 he₀ hlc.symm

/-- **Linear independence of chain monomials.** Over any commutative ring `R`, when `d ≠ 0`, no
nonzero polynomial supported on `{e | IsPluckerChainExponent e}` lies in `pluckerIdeal R n d`. -/
theorem eq_zero_of_mem_restrictSupport_isPluckerChainExponent_of_mem_pluckerIdeal [NeZero d]
    {r : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R}
    (hr : r ∈ restrictSupport R {e | IsPluckerChainExponent e})
    (hmem : r ∈ pluckerIdeal R n d) : r = 0 := by
  by_contra hr0
  exact rename_toLex_pluckerEval_ne_zero R n d hr hr0
    (by rw [(mem_pluckerIdeal_iff R).1 hmem, map_zero])

private theorem isUnit_leadingCoeff_of_mem_pluckerQuadrics
    {g : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R} (hg : g ∈ pluckerQuadrics R n d) :
    IsUnit (MonomialOrder.degRevLex.leadingCoeff g) := by
  rw [(monic_of_mem_pluckerQuadrics hg).leadingCoeff_eq_one]
  exact isUnit_one

private theorem mem_restrictSupport_of_isRemainder_pluckerQuadrics
    {f r : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R}
    (hr : MonomialOrder.degRevLex.IsRemainder f (pluckerQuadrics R n d) r) :
    r ∈ restrictSupport R {e | IsPluckerChainExponent e} := by
  rcases subsingleton_or_nontrivial R with _ | _
  · rw [Subsingleton.elim r 0]
    exact zero_mem _
  · rw [mem_restrictSupport_iff]
    intro e he
    rw [Set.mem_ofPred_eq, isPluckerChainExponent_iff_forall_not_le]
    intro I J hIJ hlt
    rw [← degree_pluckerQuadric R hIJ hlt]
    exact hr.not_degree_le he (mem_pluckerQuadrics_iff.2 ⟨I, J, hIJ, hlt, rfl⟩)
      (monic_pluckerQuadric R hIJ hlt).ne_zero

private theorem exists_isRemainder_pluckerQuadrics
    (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :
    ∃ r ∈ restrictSupport R {e | IsPluckerChainExponent e},
      MonomialOrder.degRevLex.IsRemainder f (pluckerQuadrics R n d) r ∧
        f - r ∈ pluckerIdeal R n d := by
  obtain ⟨r, hr⟩ := _root_.MonomialOrder.exists_isRemainder
    (fun g hg _ ↦ isUnit_leadingCoeff_of_mem_pluckerQuadrics R n d hg) f
  exact ⟨r, mem_restrictSupport_of_isRemainder_pluckerQuadrics R n d hr, hr,
    Ideal.span_le.2 (pluckerQuadrics_subset_pluckerIdeal R n d) hr.sub_mem_span⟩

/-- **Certified Gröbner basis of the Plücker ideal.** Over any commutative ring `R`, when `d ≠ 0`,
the quadratic Plücker straightening relations `pluckerQuadrics R n d` form a Gröbner basis of
`pluckerIdeal R n d` with respect to `TauCeti.MonomialOrder.degRevLex`. -/
theorem isGroebnerBasis_pluckerQuadrics [NeZero d] :
    MonomialOrder.degRevLex.IsGroebnerBasis (pluckerQuadrics R n d) (pluckerIdeal R n d) := by
  refine _root_.MonomialOrder.isGroebnerBasis_iff_isRemainder_zero.2
    ⟨pluckerQuadrics_subset_pluckerIdeal R n d, fun f hf ↦ ?_⟩
  obtain ⟨r, hrsupp, hr, hsub⟩ := exists_isRemainder_pluckerQuadrics R n d f
  have hrI : r ∈ pluckerIdeal R n d := by
    simpa only [sub_sub_cancel] using (pluckerIdeal R n d).sub_mem hf hsub
  exact eq_zero_of_mem_restrictSupport_isPluckerChainExponent_of_mem_pluckerIdeal R n d hrsupp hrI
    ▸ hr

/-- **Polynomial presentation of the Plücker ideal.** For `d ≠ 0`, `pluckerIdeal R n d` is generated
by the quadratic Plücker straightening relations `pluckerQuadrics R n d` over every commutative
ring `R`. -/
theorem pluckerIdeal_eq_span_pluckerQuadrics [NeZero d] :
    pluckerIdeal R n d = Ideal.span (pluckerQuadrics R n d) :=
  (isGroebnerBasis_pluckerQuadrics R n d).ideal_eq_span

/-- **Base change of the Plücker ideal.** Because the quadratic Plücker relations (for `d ≠ 0`) and
`X (pluckerVar .ofIsEmpty) - 1` (for `d = 0`) commute with `MvPolynomial.map`, `pluckerIdeal`
commutes with arbitrary ring homomorphisms for all `n` and `d`. -/
theorem map_pluckerIdeal {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (n d : ℕ) :
    Ideal.map (MvPolynomial.map φ) (pluckerIdeal R n d) = pluckerIdeal S n d := by
  rcases eq_or_ne d 0 with rfl | hd
  · simp [pluckerIdeal_zero, Ideal.map_span]
  · have : NeZero d := ⟨hd⟩
    rw [pluckerIdeal_eq_span_pluckerQuadrics R n d, pluckerIdeal_eq_span_pluckerQuadrics S n d,
      Ideal.map_span, image_map_pluckerQuadrics]

attribute [local instance] MvPolynomial.gradedAlgebra in
/-- For `d ≠ 0`, `pluckerIdeal R n d` is homogeneous for the standard total-degree grading. -/
theorem isHomogeneous_pluckerIdeal [NeZero d] :
    (pluckerIdeal R n d).IsHomogeneous (homogeneousSubmodule (Lex (Fin d ↪o Fin n))ᵒᵈ R) := by
  rw [pluckerIdeal_eq_span_pluckerQuadrics]
  refine Ideal.homogeneous_span _ _ fun g hg ↦ ?_
  obtain ⟨I, J, hIJ, -, rfl⟩ := mem_pluckerQuadrics_iff.1 hg
  exact ⟨2, isHomogeneous_pluckerQuadric R hIJ⟩

/-- The `degRevLex` leading terms of `pluckerQuadrics R n d` are the quadratic monomials
`X (pluckerVar I) * X (pluckerVar J)` for pairs `(I, J)` incomparable in the componentwise order. -/
theorem image_leadingTerm_pluckerQuadrics :
    MonomialOrder.degRevLex.leadingTerm '' pluckerQuadrics R n d =
      {m | ∃ I J : Fin d ↪o Fin n,
        ¬ (I ≤ J ∨ J ≤ I) ∧ X (pluckerVar I) * X (pluckerVar J) = m} := by
  ext m
  simp only [Set.mem_image, mem_pluckerQuadrics_iff, Set.mem_ofPred_eq]
  refine ⟨?_, ?_⟩
  · rintro ⟨_, ⟨I, J, hIJ, hlt, rfl⟩, rfl⟩
    exact ⟨I, J, (OrderEmbedding.not_le_iff_not_le_or_ge_of_toLex_lt hlt).1 hIJ,
      (leadingTerm_pluckerQuadric hIJ hlt).symm⟩
  · rintro ⟨I, J, hinc, rfl⟩
    have hne : toLex I ≠ toLex J := fun h ↦ hinc (Or.inl (le_of_eq (toLex.injective h)))
    rcases lt_or_gt_of_ne hne with hlt | hlt
    · have hIJ : ¬ I ≤ J := (OrderEmbedding.not_le_iff_not_le_or_ge_of_toLex_lt hlt).2 hinc
      exact ⟨pluckerQuadric R hIJ, ⟨I, J, hIJ, hlt, rfl⟩, leadingTerm_pluckerQuadric hIJ hlt⟩
    · have hJI : ¬ J ≤ I :=
        (OrderEmbedding.not_le_iff_not_le_or_ge_of_toLex_lt hlt).2 (Or.symm.mt hinc)
      exact ⟨pluckerQuadric R hJI, ⟨J, I, hJI, hlt, rfl⟩,
        (leadingTerm_pluckerQuadric hJI hlt).trans (mul_comm _ _)⟩

/-- **Initial ideal of the Plücker ideal.** For `d ≠ 0`, the `degRevLex` initial ideal of
`pluckerIdeal R n d` is generated by `X (pluckerVar I) * X (pluckerVar J)` over all componentwise
incomparable pairs `(I, J)`. -/
theorem span_leadingTerm_pluckerIdeal [NeZero d] :
    Ideal.span (MonomialOrder.degRevLex.leadingTerm ''
        (pluckerIdeal R n d : Set (MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R))) =
      Ideal.span {m | ∃ I J : Fin d ↪o Fin n,
        ¬ (I ≤ J ∨ J ≤ I) ∧ X (pluckerVar I) * X (pluckerVar J) = m} := by
  rw [(isGroebnerBasis_pluckerQuadrics R n d).span_leadingTerm_image,
    image_leadingTerm_pluckerQuadrics]

/-- Over a nontrivial ring with `d ≠ 0`, the `degRevLex` standard monomials of `pluckerIdeal R n d`
are the chain exponents. -/
theorem standardMonomials_pluckerIdeal [Nontrivial R] [NeZero d] :
    MonomialOrder.degRevLex.standardMonomials (pluckerIdeal R n d) =
      {e | IsPluckerChainExponent e} := by
  ext e
  rw [(isGroebnerBasis_pluckerQuadrics R n d).mem_standardMonomials_iff, Set.mem_ofPred_eq,
    isPluckerChainExponent_iff_forall_not_le]
  refine ⟨fun h I J hIJ hlt ↦ ?_, fun h g hg _ ↦ ?_⟩
  · rw [← degree_pluckerQuadric R hIJ hlt]
    exact h (pluckerQuadric R hIJ) (mem_pluckerQuadrics_iff.2 ⟨I, J, hIJ, hlt, rfl⟩)
      (monic_pluckerQuadric R hIJ hlt).ne_zero
  · obtain ⟨I, J, hIJ, hlt, rfl⟩ := mem_pluckerQuadrics_iff.1 hg
    rw [degree_pluckerQuadric R hIJ hlt]
    exact h hIJ hlt

end Groebner

section StandardMonomialBasis

variable (R : Type*) [CommRing R] (n d : ℕ) [NeZero d]

/-- For `d ≠ 0`, the quotient map restricts to an `R`-linear isomorphism from the polynomials
supported on `{e | IsPluckerChainExponent e}` onto the quotient modulo `pluckerIdeal R n d`.
Unlike `MonomialOrder.standardMonomials`, `{e | IsPluckerChainExponent e}` is independent of `R`,
giving a uniform tableau-indexed basis over every commutative ring `R` (including trivial rings);
for `[Nontrivial R]` the two sets agree by `standardMonomials_pluckerIdeal`. -/
noncomputable def restrictSupportEquivQuotientPluckerIdeal :
    restrictSupport R {e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ | IsPluckerChainExponent e} ≃ₗ[R]
      MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R ⧸ pluckerIdeal R n d :=
  LinearEquiv.ofBijective
    ((Ideal.Quotient.mkₐ R (pluckerIdeal R n d)).toLinearMap ∘ₗ Submodule.subtype _)
    ⟨fun r₁ r₂ hr ↦ Subtype.ext <| sub_eq_zero.1 <|
        eq_zero_of_mem_restrictSupport_isPluckerChainExponent_of_mem_pluckerIdeal R n d
          (Submodule.sub_mem _ r₁.2 r₂.2) (Ideal.Quotient.eq.1 hr),
     fun x ↦ by
       obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
       obtain ⟨r, hrsupp, -, hsub⟩ := exists_isRemainder_pluckerQuadrics R n d f
       exact ⟨⟨r, hrsupp⟩, (Ideal.Quotient.eq.2 hsub).symm⟩⟩

@[simp]
theorem restrictSupportEquivQuotientPluckerIdeal_apply
    (r : restrictSupport R {e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ | IsPluckerChainExponent e}) :
    restrictSupportEquivQuotientPluckerIdeal R n d r =
      Ideal.Quotient.mk (pluckerIdeal R n d) (r : MvPolynomial _ R) :=
  (rfl)

/-- **Straightening normal form** modulo `pluckerIdeal R n d` (`d ≠ 0`): the `R`-linear map sending
`f` to the unique polynomial supported on `{e | IsPluckerChainExponent e}` that is congruent to `f`
modulo `pluckerIdeal R n d` (`pluckerNormalForm_eq_iff`). -/
noncomputable def pluckerNormalForm :
    MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R →ₗ[R] MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R :=
  (restrictSupport R {e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ | IsPluckerChainExponent e}).subtype ∘ₗ
    (restrictSupportEquivQuotientPluckerIdeal R n d).symm.toLinearMap ∘ₗ
    (Ideal.Quotient.mkₐ R (pluckerIdeal R n d)).toLinearMap

/-- The inverse of `restrictSupportEquivQuotientPluckerIdeal` sends the class of `f` to
`pluckerNormalForm R n d f`. -/
@[simp]
theorem coe_restrictSupportEquivQuotientPluckerIdeal_symm_mk
    (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :
    ((restrictSupportEquivQuotientPluckerIdeal R n d).symm
        (Ideal.Quotient.mk (pluckerIdeal R n d) f) : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) =
      pluckerNormalForm R n d f :=
  (rfl)

/-- The straightening normal form is supported on `{e | IsPluckerChainExponent e}`. -/
@[simp]
theorem pluckerNormalForm_mem_restrictSupport (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :
    pluckerNormalForm R n d f ∈
      restrictSupport R {e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ | IsPluckerChainExponent e} :=
  coe_restrictSupportEquivQuotientPluckerIdeal_symm_mk R n d f ▸
    ((restrictSupportEquivQuotientPluckerIdeal R n d).symm
      (Ideal.Quotient.mk (pluckerIdeal R n d) f)).2

/-- A polynomial and its straightening normal form have the same image in the quotient. -/
@[simp]
theorem mk_pluckerNormalForm (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :
    Ideal.Quotient.mk (pluckerIdeal R n d) (pluckerNormalForm R n d f) =
      Ideal.Quotient.mk (pluckerIdeal R n d) f := by
  rw [← restrictSupportEquivQuotientPluckerIdeal_apply R n d
    ⟨_, pluckerNormalForm_mem_restrictSupport R n d f⟩]
  exact (restrictSupportEquivQuotientPluckerIdeal R n d).apply_symm_apply _

/-- A polynomial is congruent to its straightening normal form modulo `pluckerIdeal R n d`. -/
theorem sub_pluckerNormalForm_mem (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :
    f - pluckerNormalForm R n d f ∈ pluckerIdeal R n d :=
  Ideal.Quotient.eq.1 (mk_pluckerNormalForm R n d f).symm

/-- Evaluating `pluckerNormalForm R n d f` on the maximal minors agrees with evaluating `f`. -/
@[simp]
theorem pluckerEval_pluckerNormalForm (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R) :
    pluckerEval R n d (pluckerNormalForm R n d f) = pluckerEval R n d f := by
  symm
  rw [← sub_eq_zero, ← map_sub]
  exact (mem_pluckerIdeal_iff R).1 (sub_pluckerNormalForm_mem R n d f)

/-- **Characterization of the straightening normal form.** `pluckerNormalForm R n d f` is the
unique polynomial supported on `{e | IsPluckerChainExponent e}` that is congruent to `f` modulo
`pluckerIdeal R n d`. -/
theorem pluckerNormalForm_eq_iff {f r : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R} :
    pluckerNormalForm R n d f = r ↔
      r ∈ restrictSupport R {e | IsPluckerChainExponent e} ∧ f - r ∈ pluckerIdeal R n d := by
  refine ⟨fun hr ↦ hr ▸ ⟨pluckerNormalForm_mem_restrictSupport R n d f,
      sub_pluckerNormalForm_mem R n d f⟩,
    fun ⟨hr, hfr⟩ ↦ sub_eq_zero.1 <|
      eq_zero_of_mem_restrictSupport_isPluckerChainExponent_of_mem_pluckerIdeal R n d
        (Submodule.sub_mem _ (pluckerNormalForm_mem_restrictSupport R n d f) hr) ?_⟩
  simpa only [sub_sub_sub_cancel_left] using
    (pluckerIdeal R n d).sub_mem hfr (sub_pluckerNormalForm_mem R n d f)

/-- Every polynomial supported on `{e | IsPluckerChainExponent e}` is its own straightening normal
form. -/
@[simp]
theorem pluckerNormalForm_of_mem_restrictSupport {r : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R}
    (hr : r ∈ restrictSupport R {e | IsPluckerChainExponent e}) :
    pluckerNormalForm R n d r = r :=
  (pluckerNormalForm_eq_iff R n d).2 ⟨hr, by simp⟩

/-- **Plücker ideal membership.** `pluckerNormalForm R n d f = 0` if and only if
`f ∈ pluckerIdeal R n d`. -/
@[simp]
theorem pluckerNormalForm_eq_zero_iff {f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R} :
    pluckerNormalForm R n d f = 0 ↔ f ∈ pluckerIdeal R n d := by
  simp [pluckerNormalForm_eq_iff]

/-- For `d ≠ 0`, the remainders of `f` on division by `pluckerQuadrics R n d` are equal to
`pluckerNormalForm R n d f`. -/
theorem isRemainder_pluckerQuadrics_iff_eq_pluckerNormalForm
    {f r : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R} :
    MonomialOrder.degRevLex.IsRemainder f (pluckerQuadrics R n d) r ↔
      r = pluckerNormalForm R n d f := by
  have key {r : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R}
      (hr : MonomialOrder.degRevLex.IsRemainder f (pluckerQuadrics R n d) r) :
      r = pluckerNormalForm R n d f :=
    ((pluckerNormalForm_eq_iff R n d).2
      ⟨mem_restrictSupport_of_isRemainder_pluckerQuadrics R n d hr,
        Ideal.span_le.2 (pluckerQuadrics_subset_pluckerIdeal R n d) hr.sub_mem_span⟩).symm
  refine ⟨key, ?_⟩
  rintro rfl
  obtain ⟨r, -, hr, -⟩ := exists_isRemainder_pluckerQuadrics R n d f
  rwa [← key hr]

/-- **Standard-monomial basis of the Plücker quotient.** For `d ≠ 0` and any commutative ring `R`,
pairs `(m, T)` of a width `m : ℕ` and a bounded rectangular semistandard Young tableau
`T : BoundedSSYT n (YoungDiagram.rect d m)` index an `R`-basis of
`MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R ⧸ pluckerIdeal R n d`. -/
noncomputable def pluckerBasisQuotient :
    Module.Basis ((m : ℕ) × BoundedSSYT n (YoungDiagram.rect d m)) R
      (MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R ⧸ pluckerIdeal R n d) :=
  ((basisRestrictSupport R
      {e : (Lex (Fin d ↪o Fin n))ᵒᵈ →₀ ℕ | IsPluckerChainExponent e}).reindex
    (pluckerTableauExponentEquiv n d).symm).map (restrictSupportEquivQuotientPluckerIdeal R n d)

@[simp]
theorem pluckerBasisQuotient_apply
    (p : (m : ℕ) × BoundedSSYT n (YoungDiagram.rect d m)) :
    pluckerBasisQuotient R n d p =
      Ideal.Quotient.mk (pluckerIdeal R n d)
        (∏ c : Fin p.1, X (pluckerVar ((BoundedSSYT.rectColsEquiv n d p.1).symm p.2 c))) := by
  rcases p with ⟨m, T⟩
  simp only [pluckerBasisQuotient, Module.Basis.map_apply, Module.Basis.reindex_apply,
    Equiv.symm_symm, restrictSupportEquivQuotientPluckerIdeal_apply, basisRestrictSupport_apply_coe,
    coe_pluckerTableauExponentEquiv_apply, pluckerChainExponent_def, monomial_sum_one, X]

/-- The coordinates of `Ideal.Quotient.mk (pluckerIdeal R n d) f` in `pluckerBasisQuotient R n d`
are the coefficients of `pluckerNormalForm R n d f` at `pluckerTableauExponentEquiv n d p`. -/
@[simp]
theorem pluckerBasisQuotient_repr_mk (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R)
    (p : (m : ℕ) × BoundedSSYT n (YoungDiagram.rect d m)) :
    (pluckerBasisQuotient R n d).repr (Ideal.Quotient.mk (pluckerIdeal R n d) f) p =
      (pluckerNormalForm R n d f).coeff (pluckerTableauExponentEquiv n d p) := by
  simp [pluckerBasisQuotient]

/-- **Standard-monomial basis of the maximal-minor subalgebra.** For `d ≠ 0` and any commutative
ring `R`, pairs `(m, T)` of a width `m : ℕ` and a bounded rectangular semistandard Young tableau
`T : BoundedSSYT n (YoungDiagram.rect d m)` index an `R`-basis of `maximalMinorSubalgebra R n d`,
sending `(m, T)` to the product of the maximal minors of the columns of `T`. -/
noncomputable def pluckerBasisSubalgebra :
    Module.Basis ((m : ℕ) × BoundedSSYT n (YoungDiagram.rect d m)) R
      (maximalMinorSubalgebra R n d) :=
  (pluckerBasisQuotient R n d).map (quotientPluckerIdealAlgEquiv R n d).toLinearEquiv

@[simp]
theorem coe_pluckerBasisSubalgebra_apply
    (p : (m : ℕ) × BoundedSSYT n (YoungDiagram.rect d m)) :
    (pluckerBasisSubalgebra R n d p : MvPolynomial (Fin n × Fin d) R) =
      ∏ c : Fin p.1, maximalMinor R ((BoundedSSYT.rectColsEquiv n d p.1).symm p.2 c) := by
  simp [pluckerBasisSubalgebra]

/-- Transporting coordinates along `quotientPluckerIdealAlgEquiv` identifies
`(pluckerBasisSubalgebra R n d).repr` with `(pluckerBasisQuotient R n d).repr`. -/
theorem pluckerBasisSubalgebra_repr_apply (x : maximalMinorSubalgebra R n d) :
    (pluckerBasisSubalgebra R n d).repr x =
      (pluckerBasisQuotient R n d).repr ((quotientPluckerIdealAlgEquiv R n d).symm x) :=
  (rfl)

/-- The coordinates of `⟨pluckerEval R n d f, _⟩` in `pluckerBasisSubalgebra R n d` are the
coefficients of `pluckerNormalForm R n d f` at `pluckerTableauExponentEquiv n d p`. -/
@[simp]
theorem pluckerBasisSubalgebra_repr_pluckerEval (f : MvPolynomial (Lex (Fin d ↪o Fin n))ᵒᵈ R)
    (hf : pluckerEval R n d f ∈ maximalMinorSubalgebra R n d)
    (p : (m : ℕ) × BoundedSSYT n (YoungDiagram.rect d m)) :
    (pluckerBasisSubalgebra R n d).repr ⟨pluckerEval R n d f, hf⟩ p =
      (pluckerNormalForm R n d f).coeff (pluckerTableauExponentEquiv n d p) := by
  have hmk : (quotientPluckerIdealAlgEquiv R n d).symm ⟨pluckerEval R n d f, hf⟩ =
      Ideal.Quotient.mk (pluckerIdeal R n d) f :=
    (quotientPluckerIdealAlgEquiv R n d).symm_apply_eq.2
      (Subtype.ext (coe_quotientPluckerIdealAlgEquiv_mk R n d f)).symm
  simp [pluckerBasisSubalgebra, hmk]

end StandardMonomialBasis

section SAGBI

variable (R : Type*) [CommRing R] (n d : ℕ)

/-- Mapping `maximalMinorSubalgebra R n d` along `rename toLex` gives the subalgebra generated by
the `toLex`-renamed maximal minors. -/
theorem map_rename_toLex_maximalMinorSubalgebra :
    (maximalMinorSubalgebra R n d).map (rename (toLex : Fin n × Fin d → Fin n ×ₗ Fin d)) =
      Algebra.adjoin R (Set.range fun I : Fin d ↪o Fin n ↦ rename toLex (maximalMinor R I)) := by
  rw [maximalMinorSubalgebra_def, AlgHom.map_adjoin, ← Set.range_comp]
  rfl

private theorem exists_chain_degree_eq_of_mem_map_maximalMinorSubalgebra [NeZero d]
    {p : MvPolynomial (Fin n ×ₗ Fin d) R}
    (hp : p ∈ (maximalMinorSubalgebra R n d).map
      (rename (toLex : Fin n × Fin d → Fin n ×ₗ Fin d)))
    (hp0 : p ≠ 0) :
    ∃ (m : ℕ) (C : Fin m →o (Fin d ↪o Fin n)),
      _root_.MonomialOrder.lex.degree p = ∑ a : Fin m, maximalMinorDiagonalExponent (C a) := by
  obtain ⟨q, hq, rfl⟩ := Subalgebra.mem_map.1 hp
  obtain ⟨⟨r, hrsupp⟩, hr⟩ :=
    ((restrictSupportEquivQuotientPluckerIdeal R n d).trans
      (quotientPluckerIdealAlgEquiv R n d).toLinearEquiv).surjective ⟨q, hq⟩
  have hrq : pluckerEval R n d r = q := by
    simpa using congrArg Subtype.val hr
  have hr0 : r ≠ 0 := fun h0 ↦ hp0 (by simp [← hrq, h0])
  obtain ⟨e₀, he₀, hdeg, -⟩ :=
    exists_mem_support_degree_rename_toLex_pluckerEval_eq_and_leadingCoeff_eq R n d hrsupp hr0
  obtain ⟨⟨m, C⟩, hC⟩ := (pluckerChainExponentEquiv n d).surjective
    ⟨e₀, (mem_restrictSupport_iff R).1 hrsupp he₀⟩
  have he₀' : pluckerChainExponent C = e₀ := congrArg Subtype.val hC
  exact ⟨m, C, by rw [← hrq, hdeg, ← he₀', pluckerDiagonalWeight_pluckerChainExponent]⟩

/-- **Diagonal SAGBI basis of maximal minors.** Over any commutative ring `R` and for all `n` and
`d`, the `toLex`-renamed maximal minors of the generic `n × d` matrix form a SAGBI basis of the
subalgebra they generate with respect to row-major `MonomialOrder.lex`. -/
theorem isSAGBIBasis_range_rename_toLex_maximalMinor :
    _root_.MonomialOrder.lex.IsSAGBIBasis
      (Set.range fun I : Fin d ↪o Fin n ↦ rename toLex (maximalMinor R I))
      (Algebra.adjoin R (Set.range fun I : Fin d ↪o Fin n ↦ rename toLex (maximalMinor R I))) := by
  refine _root_.MonomialOrder.isSAGBIBasis_iff_initialAlgebra_le.2 ⟨Algebra.subset_adjoin, ?_⟩
  rw [_root_.MonomialOrder.initialAlgebra_def]
  refine Algebra.adjoin_le ?_
  rintro _ ⟨p, hp, rfl⟩
  rw [SetLike.mem_coe] at hp ⊢
  rcases eq_or_ne p 0 with rfl | hp0
  · simp
  rw [← map_rename_toLex_maximalMinorSubalgebra] at hp
  rcases eq_or_ne d 0 with rfl | hd
  · rw [maximalMinorSubalgebra_zero, Subalgebra.mem_map] at hp
    obtain ⟨_, hq, rfl⟩ := hp
    obtain ⟨c, rfl⟩ := Algebra.mem_bot.1 hq
    rw [AlgHom.commutes, algebraMap_eq, _root_.MonomialOrder.leadingTerm_C]
    exact Subalgebra.algebraMap_mem _ c
  · have : NeZero d := ⟨hd⟩
    obtain ⟨m, C, hdeg⟩ := exists_chain_degree_eq_of_mem_map_maximalMinorSubalgebra R n d hp hp0
    rw [_root_.MonomialOrder.leadingTerm, hdeg, monomial_sum_index]
    refine Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (Subalgebra.prod_mem _ fun a _ ↦ ?_)
    rw [← leadingTerm_rename_toLex_maximalMinor (C a)]
    exact Algebra.subset_adjoin ⟨rename toLex (maximalMinor R (C a)), ⟨C a, rfl⟩, rfl⟩

/-- Over a nontrivial commutative ring with no zero divisors and for all `n` and `d`, the
`MonomialOrder.lex` leading exponents of the `toLex`-renamed maximal-minor subalgebra form the
additive submonoid generated by the diagonal exponents `maximalMinorDiagonalExponent I`. -/
theorem leadingExponents_map_rename_toLex_maximalMinorSubalgebra [NoZeroDivisors R] [Nontrivial R] :
    _root_.MonomialOrder.lex.leadingExponents
        ((maximalMinorSubalgebra R n d).map (rename (toLex : Fin n × Fin d → Fin n ×ₗ Fin d))) =
      AddSubmonoid.closure (Set.range (maximalMinorDiagonalExponent (n := n) (d := d))) := by
  refine le_antisymm ?_ (AddSubmonoid.closure_le.2 ?_)
  · intro a ha
    obtain ⟨p, hp, hp0, rfl⟩ := _root_.MonomialOrder.mem_leadingExponents_iff.1 ha
    rcases eq_or_ne d 0 with rfl | hd
    · rw [maximalMinorSubalgebra_zero, Subalgebra.mem_map] at hp
      obtain ⟨_, hq, rfl⟩ := hp
      obtain ⟨c, rfl⟩ := Algebra.mem_bot.1 hq
      rw [AlgHom.commutes, algebraMap_eq, _root_.MonomialOrder.degree_C]
      exact zero_mem _
    · have : NeZero d := ⟨hd⟩
      obtain ⟨m, C, hdeg⟩ := exists_chain_degree_eq_of_mem_map_maximalMinorSubalgebra R n d hp hp0
      rw [hdeg]
      exact sum_mem fun a _ ↦ AddSubmonoid.subset_closure ⟨C a, rfl⟩
  · rintro _ ⟨I, rfl⟩
    rw [← degree_rename_toLex_maximalMinor (R := R) I]
    exact _root_.MonomialOrder.degree_mem_leadingExponents
      (Subalgebra.mem_map.2 ⟨maximalMinor R I, maximalMinor_mem_maximalMinorSubalgebra R I, rfl⟩)
      (monic_rename_toLex_maximalMinor R I).ne_zero

end SAGBI

end TauCeti
