import TauCeti.RingTheory.Derivation.Ideal

/-!
# Derivative ideals of polynomial ideals

The derivative ideal `D(I)` of an ideal `I` of a polynomial ring is the ideal generated by `I`
together with all first partial derivatives of elements of `I`. It is the smallest ideal
containing `I` that contains `∂ f / ∂ Xᵢ` for every `f ∈ I` and every variable `Xᵢ`, and it can
be computed from any generating set of `I` by the product rule.

Differentiation lowers order at a point by at most one, so `D(I)` has order at least
`ord_a(I) - 1` at every rational point `a`, in every characteristic. In characteristic zero
this is an equality: the order of `I` at `a` drops by exactly one with each application of
`D`. Consequently, if `I` has finite positive order `d` at `a`, the `(d - 1)`-st iterate of `D`
contains a polynomial of order one at `a`: it vanishes at `a` and has a partial derivative that
does not, so it cuts out a hypersurface that is smooth at `a`. This is how hypersurfaces of
maximal contact arise in resolution of singularities in characteristic zero.

Characteristic zero is needed: over a field of characteristic `p`, the derivative ideal of
`(Xᵢ ^ p)` is `(Xᵢ ^ p)` itself, whereas in characteristic zero the derivative ideal of
`(Xᵢ ^ (n + 1))` is `(Xᵢ ^ n)`.

## Main definitions

* `Ideal.derivativeIdeal`: the derivative ideal of an ideal of a multivariate polynomial ring.

## Main results

* `Ideal.derivativeIdeal_le_iff`: the universal property of the derivative ideal.
* `Ideal.derivativeIdeal_span`: the derivative ideal of the ideal generated by a set.
* `Ideal.derivativeIdeal_le_pow_of_le_pow_succ`: an ideal inside `J ^ (n + 1)` has derivative
  ideal inside `J ^ n`.
* `Ideal.orderAt_pointToPoint_le_orderAt_derivativeIdeal_add_one`: the derivative ideal lowers
  order at a rational point by at most one.
* `Ideal.orderAt_derivativeIdeal_pointToPoint`: in characteristic zero, it lowers order at a
  rational point by exactly one.
* `Ideal.exists_orderAt_eq_one_mem_derivativeIdeal_iterate`: in characteristic zero, at a point
  where `I` has order `d > 0`, the `(d - 1)`-st iterated derivative ideal contains a polynomial
  of order one.

## References

* E. Bierstone and P. D. Milman, *Canonical desingularization in characteristic zero by blowing
  up the maximum strata of a local invariant*, Invent. Math. 128 (1997), Proposition 4.12 and
  Remarks 4.13, p. 244.
-/

public section

namespace Ideal

open MvPolynomial

section CommSemiring

variable {σ R : Type*} [CommSemiring R] {I J : Ideal (MvPolynomial σ R)}

/-- The derivative ideal of an ideal `I` of a multivariate polynomial ring: the ideal generated
by `I` and the first partial derivatives of all elements of `I`. -/
noncomputable def derivativeIdeal (I : Ideal (MvPolynomial σ R)) : Ideal (MvPolynomial σ R) :=
  I ⊔ span (⋃ i, pderiv i '' I)

theorem derivativeIdeal_def (I : Ideal (MvPolynomial σ R)) :
    I.derivativeIdeal = I ⊔ span (⋃ i, pderiv i '' I) :=
  (rfl)

/-- An ideal is contained in its derivative ideal. -/
theorem le_derivativeIdeal (I : Ideal (MvPolynomial σ R)) : I ≤ I.derivativeIdeal :=
  le_sup_left

/-- The derivative ideal contains every partial derivative of every element of the ideal. -/
theorem pderiv_mem_derivativeIdeal {f : MvPolynomial σ R} (hf : f ∈ I) (i : σ) :
    pderiv i f ∈ I.derivativeIdeal :=
  mem_sup_right (subset_span (Set.mem_iUnion.mpr ⟨i, Set.mem_image_of_mem _ hf⟩))

/-- The derivative ideal of `I` is the smallest ideal containing `I` and the partial derivatives
of all elements of `I`. -/
theorem derivativeIdeal_le_iff :
    I.derivativeIdeal ≤ J ↔ I ≤ J ∧ ∀ i, ∀ f ∈ I, pderiv i f ∈ J := by
  rw [derivativeIdeal_def, sup_le_iff, span_le, Set.iUnion_subset_iff]
  simp only [Set.subset_def, Set.forall_mem_image, SetLike.mem_coe]

theorem derivativeIdeal_mono : Monotone (derivativeIdeal (σ := σ) (R := R)) :=
  fun _ _ h ↦ derivativeIdeal_le_iff.mpr
    ⟨h.trans (le_derivativeIdeal _), fun i _ hf ↦ pderiv_mem_derivativeIdeal (h hf) i⟩

@[simp]
theorem derivativeIdeal_bot : (⊥ : Ideal (MvPolynomial σ R)).derivativeIdeal = ⊥ :=
  le_bot_iff.mp <| derivativeIdeal_le_iff.mpr ⟨le_rfl, fun i f hf ↦ by simp [mem_bot.mp hf]⟩

@[simp]
theorem derivativeIdeal_top : (⊤ : Ideal (MvPolynomial σ R)).derivativeIdeal = ⊤ :=
  top_le_iff.mp (le_derivativeIdeal ⊤)

/-- The derivative ideal of the ideal generated by a set `s` is generated by `s` and the partial
derivatives of the elements of `s`. -/
theorem derivativeIdeal_span (s : Set (MvPolynomial σ R)) :
    (span s).derivativeIdeal = span (s ∪ ⋃ i, pderiv i '' s) := by
  refine le_antisymm (derivativeIdeal_le_iff.mpr ⟨span_mono Set.subset_union_left, ?_⟩) ?_
  · intro i f hf
    induction hf using Submodule.span_induction with
    | mem x hx =>
      exact subset_span (Or.inr (Set.mem_iUnion.mpr ⟨i, Set.mem_image_of_mem _ hx⟩))
    | zero => simp
    | add x y _ _ hx hy => simpa using add_mem hx hy
    | smul a x hx' hx =>
      rw [smul_eq_mul, pderiv_mul]
      exact add_mem (mul_mem_left _ _ (span_mono Set.subset_union_left hx'))
        (mul_mem_left _ _ hx)
  · refine span_le.mpr (Set.union_subset (subset_span.trans (le_derivativeIdeal _)) ?_)
    simp only [Set.iUnion_subset_iff, Set.image_subset_iff]
    exact fun i f hf ↦ pderiv_mem_derivativeIdeal (subset_span hf) i

/-- The derivative ideal of a principal ideal `(f)` is generated by `f` and its partial
derivatives. -/
theorem derivativeIdeal_span_singleton (f : MvPolynomial σ R) :
    (span {f}).derivativeIdeal = span (insert f (Set.range fun i ↦ pderiv i f)) := by
  rw [derivativeIdeal_span, Set.singleton_union]
  simp [Set.image_singleton, Set.iUnion_singleton_eq_range]

/-- Differentiation lowers powers of an ideal by at most one: if `I ≤ J ^ (n + 1)` then the
derivative ideal of `I` lies in `J ^ n`. -/
theorem derivativeIdeal_le_pow_of_le_pow_succ {n : ℕ} (h : I ≤ J ^ (n + 1)) :
    I.derivativeIdeal ≤ J ^ n := by
  refine derivativeIdeal_le_iff.mpr ⟨h.trans (Ideal.pow_le_pow_right n.le_succ), ?_⟩
  intro i f hf
  simpa using (pderiv i).apply_mem_pow_smul_top_of_mem_pow_succ (h hf)

/-- If `n + 1` is invertible in `R`, the derivative ideal of `(Xᵢ ^ (n + 1))` is `(Xᵢ ^ n)`. -/
theorem derivativeIdeal_span_singleton_X_pow_succ (i : σ) {n : ℕ}
    (hn : IsUnit ((n + 1 : ℕ) : R)) :
    (span {(X i : MvPolynomial σ R) ^ (n + 1)}).derivativeIdeal = span {X i ^ n} := by
  classical
  have hderiv (j : σ) :
      pderiv j ((X i : MvPolynomial σ R) ^ (n + 1)) = C ((n + 1 : ℕ) : R) * X i ^ n *
        Pi.single (M := fun _ ↦ MvPolynomial σ R) j 1 i := by
    rw [pderiv_pow, pderiv_X, map_natCast, add_tsub_cancel_right]
  rw [derivativeIdeal_span_singleton]
  refine le_antisymm (span_le.mpr (Set.insert_subset_iff.mpr ⟨?_, ?_⟩)) ?_
  · exact mem_span_singleton.mpr (pow_dvd_pow _ n.le_succ)
  · refine Set.range_subset_iff.mpr fun j ↦ ?_
    rw [SetLike.mem_coe, mem_span_singleton, hderiv]
    exact (dvd_mul_left _ _).mul_right _
  · -- `Xᵢ ^ n` is `(n + 1)⁻¹` times the partial derivative of `Xᵢ ^ (n + 1)` in `Xᵢ`.
    rw [span_singleton_le_iff_mem]
    have hmem : pderiv i ((X i : MvPolynomial σ R) ^ (n + 1)) ∈
        span (insert (X i ^ (n + 1)) (Set.range fun j ↦ pderiv j ((X i : MvPolynomial σ R) ^
          (n + 1)))) :=
      subset_span (Set.mem_insert_of_mem _ (Set.mem_range_self i))
    have := mul_mem_left _ (C ((hn.unit⁻¹ : Rˣ) : R)) hmem
    rwa [hderiv, Pi.single_eq_same, mul_one, ← mul_assoc, ← C_mul, hn.val_inv_mul, C_1,
      one_mul] at this

/-- In characteristic `p`, the derivative ideal of `(Xᵢ ^ p)` is `(Xᵢ ^ p)` itself: every
partial derivative of `Xᵢ ^ p` vanishes. -/
theorem derivativeIdeal_span_singleton_X_pow_char (p : ℕ) [CharP R p] (i : σ) :
    (span {(X i : MvPolynomial σ R) ^ p}).derivativeIdeal = span {X i ^ p} := by
  rw [derivativeIdeal_span_singleton]
  refine le_antisymm (span_le.mpr (Set.insert_subset_iff.mpr ⟨subset_span rfl, ?_⟩))
    (span_mono (by simp))
  refine Set.range_subset_iff.mpr fun j ↦ ?_
  rw [pderiv_pow, ← map_natCast C, CharP.cast_eq_zero, map_zero, zero_mul, zero_mul]
  exact zero_mem _

end CommSemiring

section Field

variable {σ k : Type*} [Field k] {I : Ideal (MvPolynomial σ k)} {a : σ → k}

/-- The derivative ideal lowers the order of an ideal at a rational point by at most one, in
every characteristic. -/
theorem orderAt_pointToPoint_le_orderAt_derivativeIdeal_add_one (I : Ideal (MvPolynomial σ k))
    (a : σ → k) :
    I.orderAt (pointToPoint a) ≤ I.derivativeIdeal.orderAt (pointToPoint a) + 1 := by
  refine ENat.forall_natCast_le_iff_le.mp fun m hm ↦ ?_
  cases m with
  | zero => simp
  | succ n =>
    rw [natCast_le_orderAt_pointToPoint_iff_le_pow] at hm
    have h := (natCast_le_orderAt_pointToPoint_iff_le_pow _ a n).mpr
      (derivativeIdeal_le_pow_of_le_pow_succ hm)
    push_cast
    gcongr

/-- In characteristic zero, an ideal whose derivative ideal has order at least `n + 1` at a
rational point has order at least `n + 2` there. -/
private theorem natCast_add_two_le_orderAt_of_le_orderAt_derivativeIdeal [CharZero k] {n : ℕ}
    (h : ((n + 1 : ℕ) : ℕ∞) ≤ I.derivativeIdeal.orderAt (pointToPoint a)) :
    ((n + 2 : ℕ) : ℕ∞) ≤ I.orderAt (pointToPoint a) := by
  rw [natCast_le_orderAt_pointToPoint_iff] at h ⊢
  intro f hf
  have h1 : 1 ≤ f.orderAt a := le_trans (by simp) (h f (le_derivativeIdeal I hf))
  have h2 : ((n + 1 : ℕ) : ℕ∞) + 1 ≤ f.orderAt a := succ_le_orderAt_iff.mpr
    ⟨orderAt_pos_iff.mp (Order.one_le_iff_pos.mp h1),
      fun i ↦ h _ (pderiv_mem_derivativeIdeal hf i)⟩
  exact_mod_cast h2

/-- In characteristic zero, the derivative ideal lowers the order of an ideal at a rational
point by exactly one. An ideal of order zero keeps order zero, and the zero ideal keeps infinite
order. -/
theorem orderAt_derivativeIdeal_pointToPoint [CharZero k] (I : Ideal (MvPolynomial σ k))
    (a : σ → k) :
    I.derivativeIdeal.orderAt (pointToPoint a) = I.orderAt (pointToPoint a) - 1 := by
  refine le_antisymm ?_
    (tsub_le_iff_right.mpr (orderAt_pointToPoint_le_orderAt_derivativeIdeal_add_one I a))
  refine ENat.forall_natCast_le_iff_le.mp fun m hm ↦ ?_
  cases m with
  | zero => simp
  | succ n =>
    refine ENat.le_sub_of_add_le_right ENat.one_ne_top ?_
    exact_mod_cast natCast_add_two_le_orderAt_of_le_orderAt_derivativeIdeal hm

/-- In characteristic zero, the `n`-th iterated derivative ideal lowers the order of an ideal at
a rational point by exactly `n`, truncated at zero. -/
theorem orderAt_derivativeIdeal_iterate_pointToPoint [CharZero k] (I : Ideal (MvPolynomial σ k))
    (a : σ → k) (n : ℕ) :
    (derivativeIdeal^[n] I).orderAt (pointToPoint a) = I.orderAt (pointToPoint a) - n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply', orderAt_derivativeIdeal_pointToPoint, ih, tsub_tsub,
      Nat.cast_succ]

/-- In characteristic zero, at a rational point where an ideal `I` has finite positive order `d`,
the `(d - 1)`-st iterated derivative ideal of `I` contains a polynomial of order one there: it
vanishes at the point and has a partial derivative that does not. -/
theorem exists_orderAt_eq_one_mem_derivativeIdeal_iterate [CharZero k] {d : ℕ} (hd : d ≠ 0)
    (h : I.orderAt (pointToPoint a) = d) :
    ∃ g ∈ derivativeIdeal^[d - 1] I, g.orderAt a = 1 := by
  have h1 : (derivativeIdeal^[d - 1] I).orderAt (pointToPoint a) = ((1 : ℕ) : ℕ∞) := by
    rw [orderAt_derivativeIdeal_iterate_pointToPoint, h, ← ENat.natCast_sub]
    congr 1
    omega
  simpa using exists_mem_orderAt_eq_of_orderAt_pointToPoint_eq h1

end Field

end Ideal
