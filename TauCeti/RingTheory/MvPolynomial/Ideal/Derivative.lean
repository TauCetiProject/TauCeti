module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import TauCeti.RingTheory.Derivation.Ideal
public import TauCeti.RingTheory.MvPolynomial.LocalOrder
import TauCeti.RingTheory.Derivation.Order

/-!
# Derivative ideals of polynomial ideals

For an ideal `I` of a multivariate polynomial ring `MvPolynomial σ R`, its derivation ideal
`I.derivationIdeal R` agrees with the ideal generated by `I` together with all first partial
derivatives `pderiv i f` of elements `f ∈ I` (`Ideal.derivationIdeal_eq_sup_pderiv`), because every
`R`-derivation of `MvPolynomial σ R` is a linear combination of partial derivatives on any given
polynomial.

Differentiation lowers order at a point by at most one, so `I.derivationIdeal k` has order at
least `ord_a(I) - 1` at every rational point `a`, in every characteristic. In characteristic zero
this is an equality: the order of `I` at `a` drops by one (in `ℕ∞`, truncated at zero and
preserving `⊤`) with each application of `derivationIdeal k`. Consequently, if `I` has finite
positive order `d` at `a`, the `(d - 1)`-st iterate of `derivationIdeal k` contains a polynomial of
order one at `a`: it vanishes at `a` and has a partial derivative that does not, so it cuts out a
hypersurface that is smooth at `a`.

Characteristic zero is needed: over a field of characteristic `p`, the derivation ideal of
`(Xᵢ ^ p)` is `(Xᵢ ^ p)` itself, whereas in characteristic zero the derivation ideal of
`(Xᵢ ^ (n + 1))` is `(Xᵢ ^ n)`.

## Main results

* `Ideal.derivationIdeal_eq_sup_pderiv`: on `MvPolynomial σ R`, `I.derivationIdeal R` is generated
  by `I` and all partial derivatives `pderiv i f` for `f ∈ I`.
* `Ideal.derivationIdeal_le_iff_pderiv`: universal property of `derivationIdeal` in terms of
  partial derivatives.
* `Ideal.derivationIdeal_span_pderiv`: the derivation ideal of the ideal generated by a set in
  `MvPolynomial σ R`.
* `Ideal.orderAt_derivationIdeal_pointToPoint`: in characteristic zero, it lowers order at a
  rational point by one (as truncated subtraction in `ℕ∞`).
* `Ideal.exists_orderAt_eq_one_mem_derivationIdeal_iterate`: in characteristic zero, at a point
  where `I` has order `d > 0`, the `(d - 1)`-st iterated derivation ideal contains a polynomial
  of order one.

## References

* E. Bierstone and P. D. Milman, *Canonical desingularization in characteristic zero by blowing
  up the maximum strata of a local invariant*, Invent. Math. 128 (1997), Proposition 4.12 and
  Remarks 4.13, p. 244.
-/

public section

namespace Ideal

open MvPolynomial

section CommSemiring

variable {σ R : Type*} [CommSemiring R] {I J : Ideal (MvPolynomial σ R)}

/-- On a multivariate polynomial ring, the derivation ideal contains every partial derivative of
every element of the ideal. -/
theorem pderiv_mem_derivationIdeal {f : MvPolynomial σ R} (hf : f ∈ I) (i : σ) :
    pderiv i f ∈ I.derivationIdeal R :=
  apply_mem_derivationIdeal R (pderiv i) hf

private theorem derivation_apply_eq_sum_pderiv
    (D : Derivation R (MvPolynomial σ R) (MvPolynomial σ R)) (f : MvPolynomial σ R) :
    D f = ∑ i ∈ f.vars, D (X i) * pderiv i f := by
  classical
  let D' : Derivation R (MvPolynomial σ R) (MvPolynomial σ R) :=
    ∑ i ∈ f.vars, D (X i) • pderiv i
  have hD' (g : MvPolynomial σ R) : D' g = ∑ i ∈ f.vars, D (X i) * pderiv i g := by
    change (D' : MvPolynomial σ R →ₗ[R] MvPolynomial σ R) g = _
    dsimp only [D']
    rw [Derivation.coe_sum_linearMap, LinearMap.sum_apply]
    simp [smul_eq_mul]
  rw [← hD' f]
  refine derivation_eq_of_forall_mem_vars fun j hj ↦ ?_
  rw [hD', Finset.sum_eq_single j]
  · simp
  · intro i _ hij
    simp [pderiv_X_of_ne hij.symm]
  · intro hjn
    exact absurd hj hjn

/-- On a multivariate polynomial ring, `I.derivationIdeal R` is generated by `I` and the first
partial derivatives of all elements of `I`. -/
theorem derivationIdeal_eq_sup_pderiv (I : Ideal (MvPolynomial σ R)) :
    I.derivationIdeal R = I ⊔ span (⋃ i, pderiv i '' I) := by
  refine le_antisymm ((derivationIdeal_le_iff R).mpr ⟨le_sup_left, fun D f hf ↦ ?_⟩)
    (sup_le (le_derivationIdeal R I) (span_le.mpr (Set.iUnion_subset fun i ↦
      Set.image_subset_iff.mpr fun f hf ↦ pderiv_mem_derivationIdeal hf i)))
  rw [derivation_apply_eq_sum_pderiv D f]
  refine mem_sup_right (Ideal.sum_mem _ fun i _ ↦ Ideal.mul_mem_left _ _ ?_)
  exact subset_span (Set.mem_iUnion.mpr ⟨i, Set.mem_image_of_mem _ hf⟩)

/-- On a multivariate polynomial ring, `I.derivationIdeal R` is the smallest ideal containing `I`
and the partial derivatives of all elements of `I`. -/
theorem derivationIdeal_le_iff_pderiv :
    I.derivationIdeal R ≤ J ↔ I ≤ J ∧ ∀ i, ∀ f ∈ I, pderiv i f ∈ J := by
  rw [derivationIdeal_eq_sup_pderiv, sup_le_iff, span_le, Set.iUnion_subset_iff]
  simp only [Set.subset_def, Set.forall_mem_image, SetLike.mem_coe]

/-- On a multivariate polynomial ring, the derivation ideal of the ideal generated by a set `s` is
generated by `s` and the partial derivatives of the elements of `s`. -/
theorem derivationIdeal_span_pderiv (s : Set (MvPolynomial σ R)) :
    (span s).derivationIdeal R = span (s ∪ ⋃ i, pderiv i '' s) := by
  rw [derivationIdeal_span]
  refine le_antisymm
    (span_le.mpr (Set.union_subset (subset_span.trans (span_mono Set.subset_union_left)) ?_))
    (span_le.mpr (Set.union_subset (subset_span.trans (span_mono Set.subset_union_left)) ?_))
  · rintro _ ⟨_, ⟨D, rfl⟩, f, hf, rfl⟩
    rw [derivation_apply_eq_sum_pderiv D f]
    exact Ideal.sum_mem _ fun i _ ↦ Ideal.mul_mem_left _ _
      (subset_span (Or.inr (Set.mem_iUnion.mpr ⟨i, Set.mem_image_of_mem _ hf⟩)))
  · rintro _ ⟨_, ⟨i, rfl⟩, f, hf, rfl⟩
    exact subset_span (Or.inr (Set.mem_iUnion.mpr ⟨pderiv i, Set.mem_image_of_mem _ hf⟩))

/-- The derivation ideal of a principal ideal `(f)` in `MvPolynomial σ R` is generated by `f` and
its partial derivatives. -/
theorem derivationIdeal_span_singleton (f : MvPolynomial σ R) :
    (span {f}).derivationIdeal R = span (insert f (Set.range fun i ↦ pderiv i f)) := by
  rw [derivationIdeal_span_pderiv, Set.singleton_union]
  simp [Set.image_singleton, Set.iUnion_singleton_eq_range]

/-- If `n + 1` is invertible in `R`, the derivation ideal of `(Xᵢ ^ (n + 1))` is `(Xᵢ ^ n)`. -/
theorem derivationIdeal_span_singleton_X_pow_succ (i : σ) {n : ℕ}
    (hn : IsUnit ((n + 1 : ℕ) : R)) :
    (span {(X i : MvPolynomial σ R) ^ (n + 1)}).derivationIdeal R = span {X i ^ n} := by
  classical
  have hderiv (j : σ) :
      pderiv j ((X i : MvPolynomial σ R) ^ (n + 1)) = C ((n + 1 : ℕ) : R) * X i ^ n *
        Pi.single (M := fun _ ↦ MvPolynomial σ R) j 1 i := by
    rw [pderiv_pow, pderiv_X, map_natCast, add_tsub_cancel_right]
  rw [derivationIdeal_span_singleton]
  refine le_antisymm (span_le.mpr (Set.insert_subset_iff.mpr ⟨?_, ?_⟩)) ?_
  · exact mem_span_singleton.mpr (pow_dvd_pow _ n.le_succ)
  · refine Set.range_subset_iff.mpr fun j ↦ ?_
    rw [SetLike.mem_coe, mem_span_singleton, hderiv]
    exact (dvd_mul_left _ _).mul_right _
  · -- `Xᵢ ^ n` is `(n + 1)⁻¹` times the partial derivative of `Xᵢ ^ (n + 1)` in `Xᵢ`.
    refine (span_singleton_le_iff_mem _).mpr ((unit_mul_mem_iff_mem _ (hn.map C)).mp ?_)
    have h := hderiv i
    rw [Pi.single_eq_same, mul_one] at h
    exact h ▸ subset_span (Set.mem_insert_of_mem _ (Set.mem_range_self i))

/-- In characteristic `p`, the derivation ideal of `(Xᵢ ^ p)` is `(Xᵢ ^ p)` itself: every partial
derivative of `Xᵢ ^ p` vanishes. -/
theorem derivationIdeal_span_singleton_X_pow_char (p : ℕ) [CharP R p] (i : σ) :
    (span {(X i : MvPolynomial σ R) ^ p}).derivationIdeal R = span {X i ^ p} := by
  rw [derivationIdeal_span_singleton]
  refine le_antisymm (span_le.mpr (Set.insert_subset_iff.mpr ⟨subset_span rfl, ?_⟩))
    (span_mono (by simp))
  refine Set.range_subset_iff.mpr fun j ↦ ?_
  rw [pderiv_pow, ← map_natCast C, CharP.cast_eq_zero, map_zero, zero_mul, zero_mul]
  exact zero_mem _

end CommSemiring

section Field

variable {σ k : Type*} [Field k] {I : Ideal (MvPolynomial σ k)} {a : σ → k}

/-- In characteristic zero, an ideal whose derivation ideal has order at least `n + 1` at a
rational point has order at least `n + 2` there. -/
private theorem natCast_add_two_le_orderAt_of_le_orderAt_derivationIdeal [CharZero k] {n : ℕ}
    (h : ((n + 1 : ℕ) : ℕ∞) ≤ (I.derivationIdeal k).orderAt (pointToPoint a)) :
    ((n + 2 : ℕ) : ℕ∞) ≤ I.orderAt (pointToPoint a) := by
  rw [natCast_le_orderAt_pointToPoint_iff] at h ⊢
  intro f hf
  have h1 : 1 ≤ f.orderAt a := le_trans (by simp) (h f (le_derivationIdeal k I hf))
  have h2 : ((n + 1 : ℕ) : ℕ∞) + 1 ≤ f.orderAt a := succ_le_orderAt_iff.mpr
    ⟨orderAt_pos_iff.mp (Order.one_le_iff_pos.mp h1),
      fun i ↦ h _ (pderiv_mem_derivationIdeal hf i)⟩
  exact_mod_cast h2

/-- In characteristic zero, the derivation ideal lowers the order of an ideal at a rational point
by one, as truncated subtraction in `ℕ∞` (leaving `0` and `⊤` unchanged). -/
@[simp]
theorem orderAt_derivationIdeal_pointToPoint [CharZero k] (I : Ideal (MvPolynomial σ k))
    (a : σ → k) :
    (I.derivationIdeal k).orderAt (pointToPoint a) = I.orderAt (pointToPoint a) - 1 := by
  refine le_antisymm ?_
    (tsub_le_iff_right.mpr (orderAt_le_orderAt_derivationIdeal_add_one k I (pointToPoint a)))
  refine ENat.forall_natCast_le_iff_le.mp fun m hm ↦ ?_
  cases m with
  | zero => simp
  | succ n =>
    refine ENat.le_sub_of_add_le_right ENat.one_ne_top ?_
    exact_mod_cast natCast_add_two_le_orderAt_of_le_orderAt_derivationIdeal hm

/-- In characteristic zero, the `n`-th iterated derivation ideal lowers the order of an ideal at
a rational point by `n`, truncated at zero in `ℕ∞`. -/
@[simp]
theorem orderAt_derivationIdeal_iterate_pointToPoint [CharZero k] (I : Ideal (MvPolynomial σ k))
    (a : σ → k) (n : ℕ) :
    ((derivationIdeal k)^[n] I).orderAt (pointToPoint a) = I.orderAt (pointToPoint a) - n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply', orderAt_derivationIdeal_pointToPoint, ih, tsub_tsub,
      Nat.cast_succ]

/-- In characteristic zero, at a rational point where an ideal `I` has finite positive order `d`,
the `(d - 1)`-st iterated derivation ideal of `I` contains a polynomial of order one there: it
vanishes at the point and has a partial derivative that does not. -/
theorem exists_orderAt_eq_one_mem_derivationIdeal_iterate [CharZero k] {d : ℕ} (hd : d ≠ 0)
    (h : I.orderAt (pointToPoint a) = d) :
    ∃ g ∈ (derivationIdeal k)^[d - 1] I, g.orderAt a = 1 := by
  have h1 : ((derivationIdeal k)^[d - 1] I).orderAt (pointToPoint a) = ((1 : ℕ) : ℕ∞) := by
    rw [orderAt_derivationIdeal_iterate_pointToPoint, h, ← ENat.natCast_sub]
    congr 1
    omega
  simpa using exists_mem_orderAt_eq_of_orderAt_pointToPoint_eq h1

end Field

end Ideal
