module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import TauCeti.RingTheory.Derivation.DerivationIdeal
public import TauCeti.RingTheory.MvPolynomial.LocalOrder
import TauCeti.Algebra.MvPolynomial.PDeriv
import TauCeti.RingTheory.Derivation.Order.Bound

/-!
# Derivative ideals of polynomial ideals

For an ideal `I` of a multivariate polynomial ring `MvPolynomial σ R`, its derivative ideal
`I.derivativeIdeal R` agrees with the ideal generated by `I` together with all first partial
derivatives `pderiv i f` of elements `f ∈ I` (`Ideal.derivativeIdeal_eq_sup_pderiv`), because every
`R`-derivation of `MvPolynomial σ R` is a linear combination of partial derivatives on any given
polynomial.

Differentiation lowers order at a point by at most one, so `I.derivativeIdeal k` has order at
least `ord_a(I) - 1` at every rational point `a`, in every characteristic. In characteristic zero
this is an equality: the order of `I` at `a` drops by one (in `ℕ∞`, truncated at zero and
preserving `⊤`) with each application of `derivativeIdeal k`. Consequently, if `I` has finite
positive order `d` at `a`, the `(d - 1)`-st iterate of `derivativeIdeal k` contains a polynomial of
order one at `a`: it vanishes at `a` and has a partial derivative that does not, so it cuts out a
hypersurface that is smooth at `a`.

Characteristic zero is needed: over a field of characteristic `p`, the derivative ideal of
`(Xᵢ ^ p)` is `(Xᵢ ^ p)` itself, whereas whenever `n + 1` is a unit in `R` (in particular over a
characteristic-zero field) the derivative ideal of `(Xᵢ ^ (n + 1))` is `(Xᵢ ^ n)`.

Over a field of characteristic zero, the only ideals stable under every partial derivative, that
is, containing their derivative ideal, are `⊥` and `⊤`: a nonzero stable ideal contains a nonzero
polynomial of least total degree, whose partial derivatives lie in the ideal and have smaller
degree, so they vanish and the polynomial is a nonzero constant. Characteristic zero is needed
here too, since `(Xᵢ ^ p)` is stable in characteristic `p`.

## Main results

* `Ideal.derivativeIdeal_eq_sup_pderiv`: on `MvPolynomial σ R`, `I.derivativeIdeal R` is generated
  by `I` and all partial derivatives `pderiv i f` for `f ∈ I`.
* `Ideal.derivativeIdeal_le_iff_pderiv`: universal property of `derivativeIdeal` in terms of
  partial derivatives.
* `Ideal.derivativeIdeal_span_pderiv`: the derivative ideal of the ideal generated by a set in
  `MvPolynomial σ R`.
* `Ideal.orderAt_derivativeIdeal_pointToPoint`: in characteristic zero, it lowers order at a
  rational point by one (as truncated subtraction in `ℕ∞`).
* `Ideal.exists_orderAt_eq_one_mem_derivativeIdeal_iterate`: in characteristic zero, at a point
  where `I` has order `d > 0`, the `(d - 1)`-st iterated derivative ideal contains a polynomial
  of order one.
* `Ideal.derivativeIdeal_le_self_iff`: in characteristic zero, an ideal contains its derivative
  ideal if and only if it is `⊥` or `⊤`.

## References

* E. Bierstone and P. D. Milman, *Canonical desingularization in characteristic zero by blowing
  up the maximum strata of a local invariant*, Invent. Math. 128 (1997), Proposition 4.12 and
  Remarks 4.13, p. 244.
-/

public section

namespace Ideal

open MvPolynomial

section CommSemiring

variable {σ R : Type*} [CommSemiring R] {I J : Ideal (MvPolynomial σ R)}

/-- On a multivariate polynomial ring, the derivative ideal contains every partial derivative of
every element of the ideal. -/
theorem pderiv_mem_derivativeIdeal {f : MvPolynomial σ R} (hf : f ∈ I) (i : σ) :
    pderiv i f ∈ I.derivativeIdeal R :=
  apply_mem_derivativeIdeal R (pderiv i) hf

/-- On a multivariate polynomial ring, the derivative ideal of the ideal generated by a set `s` is
generated by `s` and the partial derivatives of the elements of `s`. -/
theorem derivativeIdeal_span_pderiv (s : Set (MvPolynomial σ R)) :
    (span s).derivativeIdeal R = span (s ∪ ⋃ i, pderiv i '' s) := by
  rw [derivativeIdeal_span]
  refine le_antisymm
    (span_le.mpr (Set.union_subset (subset_span.trans (span_mono Set.subset_union_left)) ?_))
    (span_le.mpr (Set.union_subset (subset_span.trans (span_mono Set.subset_union_left)) ?_))
  · rintro _ ⟨_, ⟨D, rfl⟩, f, hf, rfl⟩
    rw [derivation_apply_eq_sum_vars D f]
    refine Ideal.sum_mem _ fun i _ ↦ ?_
    rw [smul_eq_mul]
    exact Ideal.mul_mem_right _ _
      (subset_span (Or.inr (Set.mem_iUnion.mpr ⟨i, Set.mem_image_of_mem _ hf⟩)))
  · rintro _ ⟨_, ⟨i, rfl⟩, f, hf, rfl⟩
    exact subset_span (Or.inr (Set.mem_iUnion.mpr ⟨pderiv i, Set.mem_image_of_mem _ hf⟩))

/-- On a multivariate polynomial ring, `I.derivativeIdeal R` is generated by `I` and the first
partial derivatives of all elements of `I`. -/
theorem derivativeIdeal_eq_sup_pderiv (I : Ideal (MvPolynomial σ R)) :
    I.derivativeIdeal R = I ⊔ span (⋃ i, pderiv i '' I) := by
  simpa [Ideal.span_union, Ideal.span_eq] using
    derivativeIdeal_span_pderiv (R := R) (I : Set (MvPolynomial σ R))

/-- On a multivariate polynomial ring, `I.derivativeIdeal R` is the smallest ideal containing `I`
and the partial derivatives of all elements of `I`. -/
theorem derivativeIdeal_le_iff_pderiv :
    I.derivativeIdeal R ≤ J ↔ I ≤ J ∧ ∀ i, ∀ f ∈ I, pderiv i f ∈ J := by
  rw [derivativeIdeal_eq_sup_pderiv, sup_le_iff, span_le, Set.iUnion_subset_iff]
  simp only [Set.subset_def, Set.forall_mem_image, SetLike.mem_coe]

/-- The derivative ideal of a principal ideal `(f)` in `MvPolynomial σ R` is generated by `f` and
its partial derivatives. -/
theorem derivativeIdeal_span_singleton (f : MvPolynomial σ R) :
    (span {f}).derivativeIdeal R = span (insert f (Set.range fun i ↦ pderiv i f)) := by
  rw [derivativeIdeal_span_pderiv, Set.singleton_union]
  simp [Set.image_singleton, Set.iUnion_singleton_eq_range]

/-- If `n + 1` is invertible in `R`, the derivative ideal of `(Xᵢ ^ (n + 1))` is `(Xᵢ ^ n)`. -/
theorem derivativeIdeal_span_singleton_X_pow_succ (i : σ) {n : ℕ}
    (hn : IsUnit ((n + 1 : ℕ) : R)) :
    (span {(X i : MvPolynomial σ R) ^ (n + 1)}).derivativeIdeal R = span {X i ^ n} := by
  classical
  have hderiv (j : σ) :
      pderiv j ((X i : MvPolynomial σ R) ^ (n + 1)) = C ((n + 1 : ℕ) : R) * X i ^ n *
        Pi.single (M := fun _ ↦ MvPolynomial σ R) j 1 i := by
    rw [pderiv_pow, pderiv_X, map_natCast, add_tsub_cancel_right]
  rw [derivativeIdeal_span_singleton]
  refine le_antisymm (span_le.mpr (Set.insert_subset_iff.mpr ⟨?_, ?_⟩)) ?_
  · exact mem_span_singleton.mpr (pow_dvd_pow _ n.le_succ)
  · refine Set.range_subset_iff.mpr fun j ↦ ?_
    rw [SetLike.mem_coe, mem_span_singleton, hderiv]
    exact (dvd_mul_left _ _).mul_right _
  · -- `Xᵢ ^ n` is `(n + 1)⁻¹` times the partial derivative of `Xᵢ ^ (n + 1)` in `Xᵢ`.
    refine (span_singleton_le_iff_mem _).mpr ((unit_mul_mem_iff_mem _ (hn.map C)).mp ?_)
    have h := hderiv i
    rw [Pi.single_eq_same, mul_one] at h
    exact h ▸ subset_span (Set.mem_insert_of_mem _ (Set.mem_range_self i))

/-- In characteristic `p`, the derivative ideal of `(Xᵢ ^ p)` is `(Xᵢ ^ p)` itself: every partial
derivative of `Xᵢ ^ p` vanishes. -/
theorem derivativeIdeal_span_singleton_X_pow_char (p : ℕ) [CharP R p] (i : σ) :
    (span {(X i : MvPolynomial σ R) ^ p}).derivativeIdeal R = span {X i ^ p} := by
  rw [derivativeIdeal_span_singleton]
  refine le_antisymm (span_le.mpr (Set.insert_subset_iff.mpr ⟨subset_span rfl, ?_⟩))
    (span_mono (by simp))
  refine Set.range_subset_iff.mpr fun j ↦ ?_
  rw [pderiv_pow, ← map_natCast C, CharP.cast_eq_zero, map_zero, zero_mul, zero_mul]
  exact zero_mem _

end CommSemiring

section Field

variable {σ k : Type*} [Field k] {I : Ideal (MvPolynomial σ k)} {a : σ → k}

/-- In characteristic zero, an ideal whose derivative ideal has order at least `n + 1` at a
rational point has order at least `n + 2` there. -/
private theorem natCast_add_two_le_orderAt_of_le_orderAt_derivativeIdeal [CharZero k] {n : ℕ}
    (h : ((n + 1 : ℕ) : ℕ∞) ≤ (I.derivativeIdeal k).orderAt (pointToPoint a)) :
    ((n + 2 : ℕ) : ℕ∞) ≤ I.orderAt (pointToPoint a) := by
  rw [natCast_le_orderAt_pointToPoint_iff] at h ⊢
  intro f hf
  have h1 : 1 ≤ f.orderAt a := le_trans (by simp) (h f (le_derivativeIdeal k I hf))
  have h2 : ((n + 1 : ℕ) : ℕ∞) + 1 ≤ f.orderAt a := succ_le_orderAt_iff.mpr
    ⟨orderAt_pos_iff.mp (Order.one_le_iff_pos.mp h1),
      fun i ↦ h _ (pderiv_mem_derivativeIdeal hf i)⟩
  exact_mod_cast h2

/-- In characteristic zero, the derivative ideal lowers the order of an ideal at a rational point
by one, as truncated subtraction in `ℕ∞` (leaving `0` and `⊤` unchanged). -/
@[simp]
theorem orderAt_derivativeIdeal_pointToPoint [CharZero k] (I : Ideal (MvPolynomial σ k))
    (a : σ → k) :
    (I.derivativeIdeal k).orderAt (pointToPoint a) = I.orderAt (pointToPoint a) - 1 :=
  orderAt_derivativeIdeal_eq_sub_one_of_natCast_add_two_le k I (pointToPoint a) fun _ h ↦
    natCast_add_two_le_orderAt_of_le_orderAt_derivativeIdeal h

/-- In characteristic zero, the `n`-th iterated derivative ideal lowers the order of an ideal at
a rational point by `n`, truncated at zero in `ℕ∞`. -/
@[simp]
theorem orderAt_derivativeIdeal_iterate_pointToPoint [CharZero k] (I : Ideal (MvPolynomial σ k))
    (a : σ → k) (n : ℕ) :
    ((derivativeIdeal k)^[n] I).orderAt (pointToPoint a) = I.orderAt (pointToPoint a) - n :=
  orderAt_derivativeIdeal_iterate_eq_sub_of_forall k I (pointToPoint a) n fun J ↦
    orderAt_derivativeIdeal_pointToPoint J a

/-- In characteristic zero, at a rational point where an ideal `I` has finite positive order `d`,
the `(d - 1)`-st iterated derivative ideal of `I` contains a polynomial of order one there: it
vanishes at the point and has a partial derivative that does not. -/
theorem exists_orderAt_eq_one_mem_derivativeIdeal_iterate [CharZero k] {d : ℕ} (hd : d ≠ 0)
    (h : I.orderAt (pointToPoint a) = d) :
    ∃ g ∈ (derivativeIdeal k)^[d - 1] I, g.orderAt a = 1 := by
  have h1 : ((derivativeIdeal k)^[d - 1] I).orderAt (pointToPoint a) = ((1 : ℕ) : ℕ∞) := by
    rw [orderAt_derivativeIdeal_iterate_pointToPoint, h, ← ENat.natCast_sub]
    congr 1
    omega
  simpa using exists_mem_orderAt_eq_of_orderAt_pointToPoint_eq h1

/-- **The ideals stable under all partial derivatives** in characteristic zero: an ideal of a
multivariate polynomial ring over a field of characteristic zero contains its derivative ideal,
that is, contains `∂ f / ∂ Xᵢ` for every `f` in it and every variable `Xᵢ`, if and only if it is
`⊥` or `⊤`. Characteristic zero is needed: over a field of characteristic `p`, `(Xᵢ ^ p)` is a
proper nonzero ideal containing its derivative ideal
(`Ideal.derivativeIdeal_span_singleton_X_pow_char`). -/
theorem derivativeIdeal_le_self_iff [CharZero k] : I.derivativeIdeal k ≤ I ↔ I = ⊥ ∨ I = ⊤ := by
  refine ⟨fun h ↦ or_iff_not_imp_right.mpr fun hI ↦ ?_, by rintro (rfl | rfl) <;> simp⟩
  have hC (c : k) (hc : C c ∈ I) : c = 0 := by
    by_contra hc0
    exact hI (I.eq_top_of_isUnit_mem hc ((isUnit_iff_ne_zero.mpr hc0).map C))
  -- Every element of `I` of total degree at most `n` vanishes, by induction on `n`: the partial
  -- derivatives of such an element lie in `I` and have total degree at most `n - 1`, so they
  -- vanish, and the element is a constant of `I`, hence zero.
  have key (n : ℕ) : ∀ f ∈ I, f.totalDegree ≤ n → f = 0 := by
    induction n with
    | zero =>
      intro f hf hdeg
      rw [totalDegree_eq_zero_iff_eq_C.mp (Nat.le_zero.mp hdeg)] at hf ⊢
      rw [hC _ hf, C_0]
    | succ n ih =>
      intro f hf hdeg
      have hD (i : σ) : pderiv i f = 0 :=
        ih _ ((derivativeIdeal_le_iff_pderiv.mp h).2 i f hf)
          ((totalDegree_pderiv_le i f).trans (by omega))
      rw [eq_C_constantCoeff_of_forall_pderiv_eq_zero hD] at hf ⊢
      rw [hC _ hf, C_0]
  exact eq_bot_iff.mpr fun f hf ↦ (mem_bot).mpr (key _ f hf le_rfl)

end Field

end Ideal
