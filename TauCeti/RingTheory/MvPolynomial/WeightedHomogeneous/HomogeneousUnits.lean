module

public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import TauCeti.RingTheory.GradedAlgebra.Localization.HomogeneousUnits
import TauCeti.RingTheory.GradedAlgebra.Homogeneous.Generator

/-!
# Homogeneous units and shift classes of weighted polynomial rings

Give the variable `i` of `MvPolynomial σ R` the weight `w i` in an additive group `M`, so that
`MvPolynomial σ R` is graded by `weightedHomogeneousSubmodule R w`. For `M = ℤ` this is a
`𝔾_m`-action on the affine space `𝔸^σ`, with weight `w i` on the coordinate `i`.

Over a nontrivial semiring, the constant coefficient of a unit is a unit, hence nonzero, and the
constant monomial has weight zero; so every homogeneous unit has weight zero, whatever the weights
(`homogeneousUnitDegrees_weightedHomogeneousSubmodule`), and the shift class group is `M` itself
(`shiftClassGroupWeightedEquiv`). No positivity of the weights or finiteness of `σ` is needed.

Without any global cancellativity hypothesis on `R`, the localization results of
`TauCeti.RingTheory.GradedAlgebra.Localization.HomogeneousUnits` apply directly to any regular
weighted-homogeneous polynomial `f` (`IsLeftRegular f`):
* Inverting a regular weighted homogeneous prime `f` of weight `e` makes the degrees of the
  homogeneous units of `R[σ]_f` the multiples of `e`
  (`homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime`), and the same holds
  for a regular scalar multiple `f = C c * p` of a weighted homogeneous prime `p`
  (`homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_C_mul_prime`). For integer
  weights the shift classes of `R[σ]_f` are then `ZMod |e|`
  (`shiftClassGroupAwayGradingWeightedEquiv`). Geometrically, with positive weights on a finite
  `σ` and `e > 0`, `R[σ]_f` is the graded ring of the invariant open subscheme `𝔸^σ ∖ {f = 0}`.
* Inverting a nonzero power `f ^ k` of a regular weighted homogeneous prime `f` of weight `e` still
  yields `AddSubgroup.zmultiples e` (by `GradedAlgebra.homogeneousUnitDegrees_awayGrading_pow` and
  `homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime`), illustrating why
  primality of the inverted element cannot be dropped.
* Inverting a regular element associated to a finite product `∏ j ∈ t, p j` of weighted
  homogeneous primes of weights `d j` makes the degrees of the homogeneous units the subgroup
  generated by the `d j`
  (`homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_associated_prod`).
* Whenever `PrimeSpectrum (MvPolynomial σ R)` is preconnected (in particular over any domain `R`),
  every compatible `ℤ`-grading of the free rank-one module over `MvPolynomial σ R` is classified
  up to graded isomorphism by a unique integer shift
  (`TauCeti.GradedAlgebra.existsUnique_shift_linearEquiv_weightedHomogeneousSubmodule`), and
  whenever `PrimeSpectrum.basicOpen f` is preconnected (in particular when
  `PrimeSpectrum (MvPolynomial σ R)` is preirreducible), every compatible `ℤ`-grading over
  `Localization.Away f` is classified by a unique shift class
  (`TauCeti.GradedAlgebra.existsUnique_shiftClass_awayGrading_of_isPreconnected`,
  `TauCeti.GradedAlgebra.existsUnique_shiftClass_awayGrading_of_preirreducible`).

For example, in `k[x]` with `x` of weight `2`, inverting the prime `x` gives `2ℤ`; in `k[x, y]` with
weights `2` and `3`, inverting `x * y` gives the subgroup generated by `2` and `3`, that is `ℤ`.
-/

public section

open MvPolynomial

namespace TauCeti

variable {σ R M : Type*} [CommSemiring R] [AddCommGroup M]

/-- For any weights, the homogeneous units of `MvPolynomial σ R` over a nontrivial commutative
semiring have weight zero: they are the units of weight zero. -/
@[simp]
theorem homogeneousUnitDegrees_weightedHomogeneousSubmodule [Nontrivial R] (w : σ → M) :
    homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥ := by
  rw [eq_bot_iff, homogeneousUnitDegrees_le_iff]
  intro u d hu
  -- The constant coefficient of a unit is a unit, so it is nonzero, and it has weight zero.
  have h0 : (u : MvPolynomial σ R).coeff 0 ≠ 0 := by
    rw [← constantCoeff_eq]
    exact (u.isUnit.map constantCoeff).ne_zero
  rw [AddSubgroup.mem_bot, ← (mem_weightedHomogeneousSubmodule R w d _).mp hu h0, map_zero]

/-- The shift class group of a weighted polynomial ring over a nontrivial commutative semiring is
the degree group `M`. -/
noncomputable def shiftClassGroupWeightedEquiv (R : Type*) [CommSemiring R] [Nontrivial R]
    (w : σ → M) : ShiftClassGroup (weightedHomogeneousSubmodule R w) ≃+ M :=
  (QuotientAddGroup.quotientAddEquivOfEq
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule w)).trans
    QuotientAddGroup.quotientBot

/-- The identification of the shift class group of a weighted polynomial ring with `M` sends the
class of `d` to `d`. -/
@[simp]
theorem shiftClassGroupWeightedEquiv_mk (R : Type*) [CommSemiring R] [Nontrivial R]
    (w : σ → M) (d : M) :
    shiftClassGroupWeightedEquiv R w d = d := by
  simpa [shiftClassGroupWeightedEquiv] using
    (QuotientAddGroup.quotientBot (G := M)).apply_symm_apply d

attribute [local instance] WeightedHomogeneousSubmodule.gradedMonoid

/-- Inverting a regular element `f` associated to a finite product `∏ j ∈ t, p j` of weighted
homogeneous primes `p j` of weights `d j` in `MvPolynomial σ R`: the degrees of the homogeneous
units of the localization are the subgroup generated by the `d j`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_associated_prod
    [Nontrivial R] (w : σ → M) {f : MvPolynomial σ R} {e : M}
    (hf : f ∈ weightedHomogeneousSubmodule R w e) {J : Type*} (t : Finset J)
    {p : J → MvPolynomial σ R} {d : J → M}
    (hp : ∀ j ∈ t, p j ∈ weightedHomogeneousSubmodule R w (d j)) (hprime : ∀ j ∈ t, Prime (p j))
    (hassoc : Associated f (∏ j ∈ t, p j)) (hreg : IsLeftRegular f) :
    homogeneousUnitDegrees (GradedAlgebra.awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.closure (d '' t) := by
  classical
  let := weightedGradedAlgebra R w
  rw [GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_associated_prod _ hf hprime hp hassoc
      hreg,
    homogeneousUnitDegrees_weightedHomogeneousSubmodule, bot_sup_eq]

/-- Inverting a regular weighted homogeneous prime `f` of weight `e` in `MvPolynomial σ R`:
the degrees of the homogeneous units of the localization are the multiples of `e`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime (w : σ → M)
    {f : MvPolynomial σ R} {e : M} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hprime : Prime f) (hreg : IsLeftRegular f) :
    homogeneousUnitDegrees (GradedAlgebra.awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples e := by
  classical
  have : Nontrivial (MvPolynomial σ R) := nontrivial_of_ne f 0 hprime.ne_zero
  have : Nontrivial R := (C (σ := σ)).domain_nontrivial
  let := weightedGradedAlgebra R w
  rw [GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_prime _ hf hprime hreg,
    homogeneousUnitDegrees_weightedHomogeneousSubmodule, bot_sup_eq]

/-- Inverting a regular scalar multiple `f = C c * p` of a weighted homogeneous prime `p` of
weight `e` in `MvPolynomial σ R`: the degrees of the homogeneous units of the localization are
still the multiples of `e`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_C_mul_prime
    (w : σ → M) {f : MvPolynomial σ R} {e : M} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (c : R) {p : MvPolynomial σ R}
    (hp : p ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime p) (hreg : IsLeftRegular f)
    (hfeq : f = C c * p) :
    homogeneousUnitDegrees (GradedAlgebra.awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples e := by
  classical
  have : Nontrivial (MvPolynomial σ R) := nontrivial_of_ne p 0 hprime.ne_zero
  have : Nontrivial R := (C (σ := σ)).domain_nontrivial
  let := weightedGradedAlgebra R w
  have hregC : IsLeftRegular (C c : MvPolynomial σ R) := by
    rw [hfeq, mul_comm] at hreg
    exact hreg.of_mul
  have ha : ∀ (n : ℕ) {b : MvPolynomial σ R} {d : M},
      b ∈ weightedHomogeneousSubmodule R w d → b ∣ (C c) ^ n →
      d ∈ homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) := by
    intro n b d hb ⟨q, hq⟩
    have hcn : c ^ n ≠ 0 := fun h0 ↦
      one_ne_zero ((hregC.pow n) (by simp [← map_pow, h0]))
    have h0 : b.coeff 0 ≠ 0 := by
      rw [← constantCoeff_eq]
      intro hb0
      have hcr := congrArg (constantCoeff (σ := σ) (R := R)) hq
      rw [map_pow, constantCoeff_C, map_mul, hb0, zero_mul] at hcr
      exact hcn hcr
    rw [← (mem_weightedHomogeneousSubmodule R w d b).mp hb h0, map_zero]
    exact zero_mem _
  rw [GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_eq_mul_prod _ hf ha {()}
      (p := fun _ ↦ p) (d := fun _ ↦ e) (by simpa using hp) (by simpa using hprime) hreg
      (by simpa using hfeq),
    homogeneousUnitDegrees_weightedHomogeneousSubmodule, bot_sup_eq,
    AddSubgroup.zmultiples_eq_closure]
  simp

/-- For integer weights and a regular weighted homogeneous prime `f` of weight `e` in
`MvPolynomial σ R`, the shift classes of the localization `R[σ]_f` form `ZMod |e|`. -/
noncomputable def shiftClassGroupAwayGradingWeightedEquiv (w : σ → ℤ) {f : MvPolynomial σ R}
    {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime f)
    (hreg : IsLeftRegular f) :
    ShiftClassGroup (GradedAlgebra.awayGrading (weightedHomogeneousSubmodule R w) hf) ≃+
      ZMod e.natAbs :=
  ShiftClassGroup.equivZMod
    (homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime w hf hprime hreg)

/-- The identification of the shift classes of `R[σ]_f` with `ZMod |e|` sends the class of a
shift `c` to `c mod |e|`. -/
@[simp]
theorem shiftClassGroupAwayGradingWeightedEquiv_mk (w : σ → ℤ) {f : MvPolynomial σ R} {e : ℤ}
    (hf : f ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime f) (hreg : IsLeftRegular f)
    (c : ℤ) :
    shiftClassGroupAwayGradingWeightedEquiv w hf hprime hreg c = c :=
  ShiftClassGroup.equivZMod_mk _ c

end TauCeti

namespace TauCeti.GradedAlgebra

attribute [local instance] MvPolynomial.WeightedHomogeneousSubmodule.gradedMonoid

variable {σ R τ : Type*}

/-- Over a nontrivial commutative ring `R` such that `PrimeSpectrum (MvPolynomial σ R)` is
preconnected (in particular over any domain `R`), every compatible `ℤ`-grading of the free
rank-one module over a weighted polynomial ring `MvPolynomial σ R` is graded-isomorphic to a
shift by a unique integer `d`. -/
theorem existsUnique_shift_linearEquiv_weightedHomogeneousSubmodule [CommRing R] [Nontrivial R]
    [PreconnectedSpace (PrimeSpectrum (MvPolynomial σ R))] (w : σ → ℤ)
    [SetLike τ (MvPolynomial σ R)] [AddSubmonoidClass τ (MvPolynomial σ R)]
    (ℳ : ℤ → τ) [DirectSum.Decomposition ℳ]
    [SetLike.GradedSMul (weightedHomogeneousSubmodule R w) ℳ] :
    ∃! d : ℤ,
      ∃ φ : MvPolynomial σ R ≃ₗ[MvPolynomial σ R] MvPolynomial σ R,
        ∀ n x, φ x ∈ ℳ n ↔ x ∈ weightedHomogeneousSubmodule R w (n + d) := by
  let := MvPolynomial.weightedGradedAlgebra R w
  exact existsUnique_shift_linearEquiv_of_connected (weightedHomogeneousSubmodule R w) ℳ
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule w)

end TauCeti.GradedAlgebra
