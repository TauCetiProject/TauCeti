module

public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import TauCeti.RingTheory.GradedAlgebra.Localization.HomogeneousUnits

/-!
# Homogeneous units of weighted polynomial rings and their localizations

Give the variable `i` of `MvPolynomial σ R` the weight `w i` in an additive group `M`, so that
`MvPolynomial σ R` is graded by `weightedHomogeneousSubmodule R w`. For `M = ℤ` this is a
`𝔾_m`-action on the affine space `𝔸^σ`, with weight `w i` on the coordinate `i`.

Over a nontrivial semiring, the constant coefficient of a unit is a unit, hence nonzero, and the
constant monomial has weight zero; so every homogeneous unit has weight zero, whatever the weights
(`homogeneousUnitDegrees_weightedHomogeneousSubmodule`). No positivity of the weights is needed.

Over a domain, inverting a weighted homogeneous prime `f` of weight `e` makes the degrees of the
homogeneous units of `R[σ]_f` the multiples of `e`
(`homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime`, which needs only a
cancellative coefficient semiring, and
`homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_C_mul_prime` when scaled by a
nonzero constant), and inverting a product of weighted homogeneous primes of weights `d j` makes
them the subgroup generated by the `d j`
(`homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_eq_prod`). For integer
weights the shift classes of `R[σ]_f` are then `ZMod |e|`
(`shiftClassGroupAwayGradingWeightedEquiv`). Geometrically, with positive weights on a finite `σ`
and `e > 0`, `R[σ]_f` is the graded ring of the invariant open subscheme `𝔸^σ ∖ {f = 0}`.

For example, in `k[x]` with `x` of weight `2`, inverting the prime `x` gives `2ℤ`; in `k[x, y]` with
weights `2` and `3`, inverting `x * y` gives the subgroup generated by `2` and `3`, that is `ℤ`.
-/

public section

open MvPolynomial

namespace TauCeti

variable {σ R M : Type*} [CommSemiring R] [AddCommGroup M]

/-- For any weights, the homogeneous units of `MvPolynomial σ R` over a nontrivial commutative
semiring have weight zero: they are the units of weight zero. -/
@[simp]
theorem homogeneousUnitDegrees_weightedHomogeneousSubmodule [Nontrivial R] (w : σ → M) :
    homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥ := by
  rw [eq_bot_iff, homogeneousUnitDegrees_le_iff]
  intro u d hu
  -- The constant coefficient of a unit is a unit, so it is nonzero, and it has weight zero.
  have h0 : (u : MvPolynomial σ R).coeff 0 ≠ 0 := by
    rw [← constantCoeff_eq]
    exact (u.isUnit.map constantCoeff).ne_zero
  rw [AddSubgroup.mem_bot, ← (mem_weightedHomogeneousSubmodule R w d _).mp hu h0, map_zero]

/-- For a weighted polynomial ring over a nontrivial commutative semiring, the shift class group is
the weight group `M`. -/
noncomputable def shiftClassGroupWeightedEquiv (R : Type*) [CommSemiring R] [Nontrivial R]
    (w : σ → M) : ShiftClassGroup (weightedHomogeneousSubmodule R w) ≃+ M :=
  (QuotientAddGroup.quotientAddEquivOfEq
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule w)).trans QuotientAddGroup.quotientBot

/-- The identification of the shift class group of a weighted polynomial ring with `M` sends the
class of a shift `c` to `c`. -/
@[simp]
theorem shiftClassGroupWeightedEquiv_mk (R : Type*) [CommSemiring R] [Nontrivial R]
    (w : σ → M) (c : M) : shiftClassGroupWeightedEquiv R w c = c := by
  rw [shiftClassGroupWeightedEquiv, AddEquiv.trans_apply,
    QuotientAddGroup.quotientAddEquivOfEq_mk]
  -- `QuotientAddGroup.quotientBot` is defined as `quotientKerEquivOfRightInverse (.id M) id`,
  -- which evaluates to `c` on `QuotientAddGroup.mk c` definitionally.
  rfl

attribute [local instance] WeightedHomogeneousSubmodule.gradedMonoid

variable [IsCancelAdd R] [IsCancelMulZero R]

/-- Inverting a product `f` of weighted homogeneous primes `p j` of weights `d j` in
`MvPolynomial σ R` over a domain: the degrees of the homogeneous units of the localization are the
subgroup generated by the `d j`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_eq_prod [Nontrivial R]
    (w : σ → M) {f : MvPolynomial σ R} {e : M} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    {J : Type*} (t : Finset J) {p : J → MvPolynomial σ R} {d : J → M}
    (hp : ∀ j ∈ t, p j ∈ weightedHomogeneousSubmodule R w (d j)) (hprime : ∀ j ∈ t, Prime (p j))
    (hft : f = ∏ j ∈ t, p j) :
    homogeneousUnitDegrees (GradedAlgebra.awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.closure (d '' t) := by
  classical
  let := weightedGradedAlgebra R w
  rw [GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_eq_prod _ hf t hp hprime hft,
    homogeneousUnitDegrees_weightedHomogeneousSubmodule, bot_sup_eq]

/-- Inverting a weighted homogeneous prime `f` of weight `e` in `MvPolynomial σ R` over a
cancellative semiring:
the degrees of the homogeneous units of the localization are the multiples of `e`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime (w : σ → M)
    {f : MvPolynomial σ R} {e : M} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hprime : Prime f) :
    homogeneousUnitDegrees (GradedAlgebra.awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples e := by
  classical
  -- A prime is nonzero, so the coefficient ring is nontrivial.
  have : Nontrivial R := by
    by_contra h
    rw [not_nontrivial_iff_subsingleton] at h
    exact hprime.ne_zero (Subsingleton.elim _ _)
  let := weightedGradedAlgebra R w
  rw [GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_prime _ hf hprime,
    homogeneousUnitDegrees_weightedHomogeneousSubmodule, bot_sup_eq]

/-- Inverting a nonzero scalar multiple `f = C c * p` of a weighted homogeneous prime `p` of
weight `e` in `MvPolynomial σ R` over a cancellative semiring: the degrees of the homogeneous
units of the localization are still the multiples of `e`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_C_mul_prime
    (w : σ → M) {f : MvPolynomial σ R} {e : M} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    {c : R} (hc : c ≠ 0) {p : MvPolynomial σ R}
    (hp : p ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime p) (hfeq : f = C c * p) :
    homogeneousUnitDegrees (GradedAlgebra.awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples e := by
  classical
  have : Nontrivial R := ⟨⟨c, 0, hc⟩⟩
  let := weightedGradedAlgebra R w
  have ha : ∀ (n : ℕ) {b : MvPolynomial σ R} {d : M},
      b ∈ weightedHomogeneousSubmodule R w d → b ∣ (C c) ^ n →
      d ∈ homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) := by
    intro n b d hb ⟨q, hq⟩
    have h0 : b.coeff 0 ≠ 0 := by
      rw [← constantCoeff_eq]
      intro hb0
      have hcr := congrArg (constantCoeff (σ := σ) (R := R)) hq
      rw [map_pow, constantCoeff_C, map_mul, hb0, zero_mul] at hcr
      exact pow_ne_zero n hc hcr
    rw [← (mem_weightedHomogeneousSubmodule R w d b).mp hb h0, map_zero]
    exact zero_mem _
  rw [GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_eq_mul_prod _ hf ha {()}
      (p := fun _ ↦ p) (d := fun _ ↦ e) (by simpa using hp) (by simpa using hprime)
      (by simpa using hfeq),
    homogeneousUnitDegrees_weightedHomogeneousSubmodule, bot_sup_eq,
    AddSubgroup.zmultiples_eq_closure]
  simp

/-- For integer weights and a weighted homogeneous prime `f` of weight `e` in `MvPolynomial σ R`
over a cancellative semiring, the shift classes of the localization `R[σ]_f` form `ZMod |e|`. -/
noncomputable def shiftClassGroupAwayGradingWeightedEquiv (w : σ → ℤ) {f : MvPolynomial σ R}
    {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime f) :
    ShiftClassGroup (GradedAlgebra.awayGrading (weightedHomogeneousSubmodule R w) hf) ≃+
      ZMod e.natAbs :=
  ShiftClassGroup.equivZMod
    (homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime w hf hprime)

/-- The identification of the shift classes of `R[σ]_f` with `ZMod |e|` sends the class of a
shift `c` to `c mod |e|`. -/
@[simp]
theorem shiftClassGroupAwayGradingWeightedEquiv_mk (w : σ → ℤ) {f : MvPolynomial σ R} {e : ℤ}
    (hf : f ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime f) (c : ℤ) :
    shiftClassGroupAwayGradingWeightedEquiv w hf hprime c = c :=
  ShiftClassGroup.equivZMod_mk _ c

end TauCeti
