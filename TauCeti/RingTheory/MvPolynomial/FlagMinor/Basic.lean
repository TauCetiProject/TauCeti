/-!
# Flag minors, the flag-minor subalgebra, and Gelfand-Tsetlin patterns

The **flag minor** `TauCeti.flagMinor R I` of a set `I = {i_0 < ⋯ < i_(d-1)}` of rows of the
generic `n × n` matrix `(z_(r,c))` is its minor on the rows of `I` and the first `d` columns.
The **flag-minor algebra** `TauCeti.flagMinorAlgebra n R` is the `R`-subalgebra of
`MvPolynomial (Fin n × Fin n) R` generated by the indexed family `flagMinor R I` (`I ⊆ Fin n`),
or equivalently by the `2 ^ n - 1` nonempty row subsets (which include the determinant `flagMinor R
univ` when `0 < n`).

Order the variables row by row, renaming them along `toLex`, and use the lexicographic monomial
order, for which `z_(0,0)` is the largest variable, followed by `z_(0,1)`. Then the flag minor is
monic, and over `[Nontrivial R]` its leading monomial is its main diagonal `∏_(c < d) z_(i_c, c)`,
with exponent `TauCeti.flagDiagonalExponent I`.

An exponent `e` of the matrix variables determines the array of partial column sums
`λ_(c,j) = ∑_(r < j) e(r, c)` (`TauCeti.GTPattern.exponentEntries`). The diagonal exponent of `I`
is sent to the row-subset pattern `TauCeti.GTPattern.rowSubset I`, and the exponent is recovered
from the array by the successive differences `e(r, c) = λ_(c,r+1) - λ_(c,r)`. Since the
row-subset patterns generate the nonnegative Gelfand-Tsetlin patterns, the monoid generated by the
diagonal exponents of the `2 ^ n` row subsets is isomorphic, by the partial column sums, to the
monoid of nonnegative patterns (`TauCeti.GTPattern.flagExponentEquiv`), and both are saturated
under positive natural multiples
(`TauCeti.GTPattern.nsmulSaturated_closure_range_flagDiagonalExponent`).
The determinant, the flag minor of all rows, corresponds to the constant pattern `1`
(`TauCeti.GTPattern.rowSubset_univ`).

This identifies the monoid generated by the diagonal exponents of the flag minors. That the flag
minors form a SAGBI basis, so that over `[NoZeroDivisors R] [Nontrivial R]` this monoid is the
leading-exponent monoid of the whole flag-minor algebra, is proved in
`TauCeti.RingTheory.MvPolynomial.FlagMinor.SAGBI`.

## Main definitions

* `TauCeti.flagMinor R I`: the minor of the generic matrix on the rows `I` and the first `#I`
  columns.
* `TauCeti.flagMinorAlgebra n R`: the `R`-subalgebra generated by `flagMinor R I`.
* `TauCeti.flagDiagonalExponent I`: the exponent of its main diagonal.
* `TauCeti.GTPattern.exponentEntries`: the partial column sums of an exponent.
* `TauCeti.GTPattern.flagExponentEquiv`: the monoid generated by the diagonal exponents of the
  row subsets is isomorphic to the monoid of nonnegative Gelfand-Tsetlin patterns.

## Main results

* `TauCeti.degree_rename_toLex_flagMinor` and `TauCeti.monic_rename_toLex_flagMinor`: for the
  row-major lexicographic order, a flag minor is monic, and over `[Nontrivial R]` its leading
  exponent is its diagonal exponent.
* `TauCeti.mvPolynomialMinor_eq_zero_or_sign_smul_flagMinor`: a minor on arbitrary rows `u` and
  an initial column prefix either vanishes or equals `± flagMinor R (univ.image u)`.
* `TauCeti.flagMinor_univ`: the flag minor of all rows is the determinant of the generic matrix.
* `TauCeti.flagMinor_pair` and `TauCeti.flagDiagonalExponent_pair`: the flag minor of two rows is a
  `2 × 2` minor, with diagonal exponent that of `z_(i,0) z_(j,1)`.
* `TauCeti.flagMinor_singleton_mul_flagMinor_pair_sub_add_eq_zero`: the three-term relation
  `z_(i,0) Δ_(j,k) - z_(j,0) Δ_(i,k) + z_(k,0) Δ_(i,j) = 0` among flag minors of one and two rows.
* `TauCeti.flagMinor_injective`: over `[Nontrivial R]`, distinct sets of rows have distinct flag
  minors.
* `TauCeti.adjoin_flagMinor_nonempty`, `TauCeti.card_image_nonempty_flagMinor`, and
  `TauCeti.fg_flagMinorAlgebra`: the `2 ^ n - 1` nonempty row-subset minors generate
  `flagMinorAlgebra n R`, giving `2 ^ n - 1` distinct generators when `[Nontrivial R]`.
* `TauCeti.adjoin_map_flagMinorAlgebra` and `TauCeti.map_flagMinorAlgebra_eq_restrictScalars`:
  functoriality of `flagMinorAlgebra` under coefficient-ring homomorphisms.
* `TauCeti.GTPattern.exponentEntries_succ_sub`: the exponent is recovered from its partial column
  sums by successive differences.
* `TauCeti.GTPattern.exponentEntries_flagDiagonalExponent`: the diagonal exponent of `I` is sent to
  the row-subset pattern of `I`.
* `TauCeti.GTPattern.mem_closure_range_flagDiagonalExponent_iff` and
  `TauCeti.GTPattern.nsmulSaturated_closure_range_flagDiagonalExponent`: an exponent lies in the
  monoid generated by the diagonal exponents if and only if its partial column sums form a
  nonnegative Gelfand-Tsetlin pattern, and this monoid is saturated.

## References

* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 14 (flag minors, their diagonal initial terms and Gelfand-Tsetlin patterns).
* M. Kogan and E. Miller, *Toric degeneration of Schubert varieties and Gelfand-Tsetlin
  polytopes*, Adv. Math. **193** (2005), 1-17.
-/

public section

namespace TauCeti

open MvPolynomial Finset MonomialOrder

variable {n : ℕ}

/-! ### Flag minors and their leading exponents -/

section FlagMinor

variable (R : Type*) [CommRing R]

/-- The **flag minor** of a set `I` of rows of the generic `n × n` matrix: its minor on the rows of
`I`, in increasing order, and the first `#I` columns. -/
noncomputable def flagMinor (I : Finset (Fin n)) : MvPolynomial (Fin n × Fin n) R :=
  Matrix.mvPolynomialMinor R (I.orderEmbOfFin rfl) (Fin.castLE (card_finset_fin_le I))

theorem flagMinor_def (I : Finset (Fin n)) :
    flagMinor R I =
      Matrix.mvPolynomialMinor R (I.orderEmbOfFin rfl) (Fin.castLE (card_finset_fin_le I)) :=
  (rfl)

/-- A minor of the generic `n × n` matrix on rows `u : Fin d → Fin n` and the first `d` columns
either vanishes (when `u` repeats a row) or equals `± flagMinor R (univ.image u)`. -/
theorem mvPolynomialMinor_eq_zero_or_sign_smul_flagMinor
    {d : ℕ} (hd : d ≤ n) (u : Fin d → Fin n) :
    Matrix.mvPolynomialMinor R u (Fin.castLE hd) = 0 ∨
      Function.Injective u ∧
        ∃ s : ℤˣ, Matrix.mvPolynomialMinor R u (Fin.castLE hd) =
          (s : ℤ) • flagMinor R (univ.image u) := by
  by_cases hu : Function.Injective u
  · right
    set I' := univ.image u
    have hcard : #I' = d := (card_image_of_injective univ hu).trans (Fintype.card_fin d)
    obtain ⟨τ, hτ, -⟩ := Equiv.Perm.existsUnique_strictMono_comp hu
    have hord : (u ∘ τ) ∘ finCongr hcard = I'.orderEmbOfFin rfl :=
      orderEmbOfFin_unique rfl (fun _ ↦ mem_image_of_mem u (mem_univ _))
        (hτ.comp (Fin.castOrderIso hcard).strictMono)
    have hu_eq : u = (I'.orderEmbOfFin rfl ∘ finCongr hcard.symm) ∘ τ.symm :=
      funext fun i ↦ by simpa using congr_fun hord (finCongr hcard.symm (τ.symm i))
    have hc_eq : Fin.castLE hd = (Fin.castLE (card_finset_fin_le I') ∘ finCongr hcard.symm) ∘ id :=
      funext fun _ ↦ Fin.ext rfl
    refine ⟨hu, Equiv.Perm.sign τ.symm, ?_⟩
    rw [Matrix.mvPolynomialMinor_eq_det_submatrix, flagMinor_def,
      Matrix.mvPolynomialMinor_eq_det_submatrix, hu_eq, hc_eq,
      ← Matrix.submatrix_submatrix, Matrix.det_permute,
      ← Matrix.submatrix_submatrix, Matrix.det_submatrix_equiv_self]
    simp [zsmul_eq_mul]
  · left
    obtain ⟨_, _, hij, hne⟩ := Function.not_injective_iff.mp hu
    rw [Matrix.mvPolynomialMinor_eq_det_submatrix]
    exact Matrix.det_zero_of_row_eq hne (by ext; simp [hij])

/-- The flag minor of the empty set of rows is the empty minor `1`. -/
@[simp]
theorem flagMinor_empty : flagMinor R (∅ : Finset (Fin n)) = 1 :=
  have : IsEmpty (Fin #(∅ : Finset (Fin n))) := card_empty (α := Fin n) ▸ inferInstance
  Matrix.mvPolynomialMinor_zero _ _

/-- The flag minor of a single row `r` is the matrix variable `z_(r,0)`. -/
@[simp]
theorem flagMinor_singleton (r : Fin n) : flagMinor R {r} = X (r, ⟨0, r.pos⟩) := by
  have : Unique (Fin #{r}) := card_singleton r ▸ inferInstance
  rw [flagMinor_def, Matrix.mvPolynomialMinor_one, mem_singleton.1 (orderEmbOfFin_mem _ _ _)]
  congr
  exact Fin.ext (Nat.lt_one_iff.1 ((default : Fin #{r}).isLt.trans_eq (card_singleton r)))

/-- The first column, reindexed from the rows of a two-element set. -/
private theorem castLE_cast_zero {d : ℕ} (h : d ≤ n + 2) (h' : 2 = d) :
    Fin.castLE h (Fin.cast h' 0) = 0 :=
  Fin.ext (by simp)

/-- The second column, reindexed from the rows of a two-element set. -/
private theorem castLE_cast_one {d : ℕ} (h : d ≤ n + 2) (h' : 2 = d) :
    Fin.castLE h (Fin.cast h' 1) = 1 :=
  Fin.ext (by simp)

/-- The flag minor of two rows `i < j` is the `2 × 2` minor on these rows and the first two
columns. -/
@[simp]
theorem flagMinor_pair {i j : Fin (n + 2)} (hij : i < j) :
    flagMinor R {i, j} = X (i, 0) * X (j, 1) - X (i, 1) * X (j, 0) := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix,
    ← Matrix.det_submatrix_equiv_self (finCongr (card_pair hij.ne).symm), Matrix.det_fin_two]
  simp [orderEmbOfFin_apply, sort_pair _ hij.le hij.ne, castLE_cast_zero, castLE_cast_one]

/-- **The three-term relation** among the flag minors of one and two rows: for rows `i < j < k`,
`z_(i,0) Δ_(j,k) - z_(j,0) Δ_(i,k) + z_(k,0) Δ_(i,j) = 0`, where `Δ` denotes the flag minor of two
rows. It is the expansion along the first column of the vanishing `3 × 3` determinant on the rows
`i, j, k` and the columns `0, 0, 1`. -/
theorem flagMinor_singleton_mul_flagMinor_pair_sub_add_eq_zero {i j k : Fin (n + 2)} (hij : i < j)
    (hjk : j < k) :
    flagMinor R {i} * flagMinor R {j, k} - flagMinor R {j} * flagMinor R {i, k} +
      flagMinor R {k} * flagMinor R {i, j} = 0 := by
  simp only [flagMinor_singleton, Fin.zero_eta, flagMinor_pair R hij, flagMinor_pair R hjk,
    flagMinor_pair R (hij.trans hjk)]
  ring

/-- The exponent of the main diagonal `∏_(c < d) z_(i_c, c)` of the flag minor of
`I = {i_0 < ⋯ < i_(d-1)}`, in the variables indexed by the lexicographically ordered pairs. -/
noncomputable def flagDiagonalExponent (I : Finset (Fin n)) : Fin n ×ₗ Fin n →₀ ℕ :=
  ∑ c : Fin #I,
    Finsupp.single (toLex (I.orderEmbOfFin rfl c, Fin.castLE (card_finset_fin_le I) c)) 1

/-- The diagonal exponent of `I` takes the value `1` at the variable `z_(r,c)` exactly when
`c < #I` and `r` is the `c`-th element of `I`, and `0` elsewhere. -/
theorem flagDiagonalExponent_apply (I : Finset (Fin n)) (r c : Fin n) :
    flagDiagonalExponent I (toLex (r, c)) =
      if h : (c : ℕ) < #I then if I.orderEmbOfFin rfl ⟨c, h⟩ = r then 1 else 0 else 0 := by
  rw [flagDiagonalExponent, Finsupp.finsetSum_apply]
  split_ifs with hc hr
  · rw [Fintype.sum_eq_single ⟨c, hc⟩ fun d hd ↦ Finsupp.single_eq_of_ne fun h ↦ hd ?_]
    · simp [← hr]
    · exact Fin.ext (congrArg (fun x ↦ ((ofLex x).2 : ℕ)) h).symm
  · rw [Fintype.sum_eq_single ⟨c, hc⟩ fun d hd ↦ Finsupp.single_eq_of_ne fun h ↦ hd ?_]
    · exact Finsupp.single_eq_of_ne fun h ↦ hr (congrArg (fun x ↦ (ofLex x).1) h).symm
    · exact Fin.ext (congrArg (fun x ↦ ((ofLex x).2 : ℕ)) h).symm
  · refine Fintype.sum_eq_zero _ fun d ↦ Finsupp.single_eq_of_ne fun h ↦ hc ?_
    have := congrArg (fun x ↦ ((ofLex x).2 : ℕ)) h
    simp only [ofLex_toLex, Fin.val_castLE] at this
    exact this ▸ d.isLt

/-- The diagonal exponent of a single row `r` is that of the variable `z_(r,0)`. -/
@[simp]
theorem flagDiagonalExponent_singleton (r : Fin n) :
    flagDiagonalExponent {r} = Finsupp.single (toLex (r, ⟨0, r.pos⟩)) 1 := by
  have : Unique (Fin #{r}) := card_singleton r ▸ inferInstance
  rw [flagDiagonalExponent, Fintype.sum_unique, mem_singleton.1 (orderEmbOfFin_mem _ _ _)]
  congr
  exact Fin.ext (Nat.lt_one_iff.1 ((default : Fin #{r}).isLt.trans_eq (card_singleton r)))

/-- The diagonal exponent of two rows `i < j` is that of the diagonal `z_(i,0) z_(j,1)`. -/
@[simp]
theorem flagDiagonalExponent_pair {i j : Fin (n + 2)} (hij : i < j) :
    flagDiagonalExponent {i, j} =
      Finsupp.single (toLex (i, 0)) 1 + Finsupp.single (toLex (j, 1)) 1 := by
  rw [flagDiagonalExponent,
    ← Fintype.sum_equiv (finCongr (card_pair hij.ne).symm) _ _ fun _ ↦ rfl, Fin.sum_univ_two]
  simp [orderEmbOfFin_apply, sort_pair _ hij.le hij.ne, castLE_cast_zero, castLE_cast_one]

/-- The diagonal exponent of all rows is that of the main diagonal `∏_c z_(c,c)`. -/
theorem flagDiagonalExponent_univ :
    flagDiagonalExponent (univ : Finset (Fin n)) =
      ∑ c : Fin n, Finsupp.single (toLex (c, c)) 1 := by
  rw [flagDiagonalExponent]
  refine Fintype.sum_equiv (finCongr (by simp)) _ _ fun c ↦ ?_
  rw [orderEmbOfFin_univ_apply]
  rfl

/-- The diagonal exponents do not involve the variables `z_(r,c)` with `r < c`. -/
theorem flagDiagonalExponent_apply_eq_zero_of_lt (I : Finset (Fin n)) {r c : Fin n}
    (hrc : r < c) : flagDiagonalExponent I (toLex (r, c)) = 0 := by
  rw [flagDiagonalExponent_apply]
  split_ifs with hc hr
  · have := I.val_le_val_orderEmbOfFin rfl ⟨c, hc⟩
    rw [hr] at this
    exact ((Fin.lt_def.1 hrc).not_ge this).elim
  all_goals rfl

/-- For the lexicographic order on the variables ordered row by row, the leading exponent of a
flag minor is its diagonal exponent. -/
@[simp]
theorem degree_rename_toLex_flagMinor [Nontrivial R] (I : Finset (Fin n)) :
    lex.degree (rename toLex (flagMinor R I)) = flagDiagonalExponent I := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix, flagDiagonalExponent]
  exact Matrix.degree_rename_toLex_det_submatrix_mvPolynomialX (I.orderEmbOfFin rfl).strictMono
    (Fin.strictMono_castLE _)

/-- For the lexicographic order on the variables ordered row by row, a flag minor is monic. -/
@[simp]
theorem monic_rename_toLex_flagMinor (I : Finset (Fin n)) :
    lex.Monic (rename toLex (flagMinor R I)) := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix]
  exact Matrix.monic_rename_toLex_det_submatrix_mvPolynomialX (I.orderEmbOfFin rfl).strictMono
    (Fin.strictMono_castLE _)

variable {R}

/-- For the lexicographic order on the variables ordered row by row, the leading term of a flag
minor is its diagonal monomial. -/
@[simp]
theorem leadingTerm_rename_toLex_flagMinor (I : Finset (Fin n)) :
    lex.leadingTerm (rename toLex (flagMinor R I)) = monomial (flagDiagonalExponent I) 1 := by
  nontriviality R
  rw [MonomialOrder.leadingTerm, degree_rename_toLex_flagMinor,
    (monic_rename_toLex_flagMinor R I).leadingCoeff_eq_one]

/-- Every flag minor over a nontrivial coefficient ring is nonzero. -/
@[simp]
theorem flagMinor_ne_zero [Nontrivial R] (I : Finset (Fin n)) : flagMinor R I ≠ 0 := fun h ↦
  (monic_rename_toLex_flagMinor R I).ne_zero (by rw [h, map_zero])

/-- The flag minor of all rows is the determinant of the generic matrix. -/
@[simp]
theorem flagMinor_univ :
    flagMinor R (univ : Finset (Fin n)) = (Matrix.mvPolynomialX (Fin n) (Fin n) R).det := by
  rw [flagMinor_def, Matrix.mvPolynomialMinor_eq_det_submatrix]
  convert Matrix.det_submatrix_equiv_self (finCongr (by simp : #(univ : Finset (Fin n)) = n))
    (Matrix.mvPolynomialX (Fin n) (Fin n) R) using 2
  ext i j
  simp only [Matrix.submatrix_apply, orderEmbOfFin_univ_apply]
  rfl

/-- Flag minors commute with a change of coefficient ring. -/
@[simp]
theorem map_flagMinor {S : Type*} [CommRing S] (f : R →+* S) (I : Finset (Fin n)) :
    map f (flagMinor R I) = flagMinor S I := by
  simp only [flagMinor_def, Matrix.map_mvPolynomialMinor]

end FlagMinor

/-! ### The flag-minor subalgebra -/

/-- **The flag-minor subalgebra**: the `R`-subalgebra of `MvPolynomial (Fin n × Fin n) R` generated
by the flag minors `flagMinor R I` indexed by the `2 ^ n` subsets `I ⊆ Fin n`. -/
noncomputable def flagMinorAlgebra (n : ℕ) (R : Type*) [CommRing R] :
    Subalgebra R (MvPolynomial (Fin n × Fin n) R) :=
  Algebra.adjoin R (Set.range (flagMinor R))

theorem flagMinorAlgebra_def (n : ℕ) (R : Type*) [CommRing R] :
    flagMinorAlgebra n R = Algebra.adjoin R (Set.range (flagMinor R)) := by
  unfold flagMinorAlgebra
  rfl

theorem flagMinor_mem_flagMinorAlgebra (R : Type*) [CommRing R] (I : Finset (Fin n)) :
    flagMinor R I ∈ flagMinorAlgebra n R :=
  Algebra.subset_adjoin ⟨I, rfl⟩

/-- A subalgebra contains `flagMinorAlgebra n R` if and only if it contains every flag minor. -/
theorem flagMinorAlgebra_le_iff (R : Type*) [CommRing R]
    {S : Subalgebra R (MvPolynomial (Fin n × Fin n) R)} :
    flagMinorAlgebra n R ≤ S ↔ ∀ I : Finset (Fin n), flagMinor R I ∈ S := by
  rw [flagMinorAlgebra_def, Algebra.adjoin_le_iff, Set.range_subset_iff]
  rfl

/-- The empty flag minor is `1`, so the `2 ^ n - 1` nonempty row subsets already index generators
of `flagMinorAlgebra n R` (including for `n = 0`, where both sides are `⊥`, and including the
full determinant `flagMinor R univ` when `0 < n`). -/
theorem adjoin_flagMinor_nonempty (R : Type*) [CommRing R] :
    Algebra.adjoin R (flagMinor R '' {I : Finset (Fin n) | I.Nonempty}) =
      flagMinorAlgebra n R := by
  refine le_antisymm (Algebra.adjoin_mono (Set.image_subset_range _ _)) (Algebra.adjoin_le ?_)
  rintro _ ⟨I, rfl⟩
  rcases I.eq_empty_or_nonempty with rfl | hne
  · exact flagMinor_empty R ▸ one_mem _
  · exact Algebra.subset_adjoin ⟨I, hne, rfl⟩

/-- The flag-minor algebra is finitely generated over every commutative ring `R`. -/
theorem fg_flagMinorAlgebra (n : ℕ) (R : Type*) [CommRing R] : (flagMinorAlgebra n R).FG := by
  classical
  exact ⟨(univ : Finset (Finset (Fin n))).image (flagMinor R),
    by rw [coe_image, coe_univ, Set.image_univ, flagMinorAlgebra_def]⟩

/-- Coefficient-ring extension sends `flagMinorAlgebra n R` into `flagMinorAlgebra n S`. -/
theorem map_flagMinorAlgebra_le (R S : Type*) [CommRing R] [CommRing S] [Algebra R S] :
    (flagMinorAlgebra n R).map (MvPolynomial.mapAlgHom (Algebra.ofId R S)) ≤
      (flagMinorAlgebra n S).restrictScalars R := by
  rw [Subalgebra.map_le, flagMinorAlgebra_le_iff]
  exact fun I ↦ by simp [MvPolynomial.mapAlgHom_apply, flagMinor_mem_flagMinorAlgebra]

/-- Under any ring homomorphism `f : R →+* S`, the image of `flagMinorAlgebra n R` generates
`flagMinorAlgebra n S` over `S`. -/
theorem adjoin_map_flagMinorAlgebra {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) :
    Algebra.adjoin S (MvPolynomial.map f '' (flagMinorAlgebra n R : Set _)) =
      flagMinorAlgebra n S := by
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
  · rintro _ ⟨p, hp, rfl⟩
    rw [SetLike.mem_coe, flagMinorAlgebra_def] at hp
    induction hp using Algebra.adjoin_induction with
    | mem _ hx =>
      obtain ⟨I, rfl⟩ := hx; rw [map_flagMinor]; exact flagMinor_mem_flagMinorAlgebra S I
    | algebraMap r => simpa using (flagMinorAlgebra n S).algebraMap_mem (f r)
    | add _ _ _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul _ _ _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  · rintro _ ⟨I, rfl⟩
    exact Algebra.subset_adjoin
      ⟨flagMinor R I, flagMinor_mem_flagMinorAlgebra R I, map_flagMinor f I⟩

/-- Under a surjective `R`-algebra map `algebraMap R S`, base-changing `flagMinorAlgebra n R`
equals `(flagMinorAlgebra n S).restrictScalars R`. -/
theorem map_flagMinorAlgebra_eq_restrictScalars (R S : Type*) [CommRing R] [CommRing S]
    [Algebra R S] (hf : Function.Surjective (algebraMap R S)) :
    (flagMinorAlgebra n R).map (MvPolynomial.mapAlgHom (Algebra.ofId R S)) =
      (flagMinorAlgebra n S).restrictScalars R := by
  refine le_antisymm (map_flagMinorAlgebra_le R S) fun p hp ↦ ?_
  rw [Subalgebra.mem_restrictScalars, flagMinorAlgebra_def] at hp
  induction hp using Algebra.adjoin_induction with
  | mem _ hx =>
    obtain ⟨I, rfl⟩ := hx
    exact Subalgebra.mem_map.mpr ⟨flagMinor R I, flagMinor_mem_flagMinorAlgebra R I,
      by simp [MvPolynomial.mapAlgHom_apply]⟩
  | algebraMap s =>
    obtain ⟨r, rfl⟩ := hf s
    exact Subalgebra.mem_map.mpr
      ⟨algebraMap R _ r, (flagMinorAlgebra n R).algebraMap_mem r, by simp⟩
  | add _ _ _ _ hx hy => exact add_mem hx hy
  | mul _ _ _ _ hx hy => exact mul_mem hx hy

/-! ### Partial column sums of exponents -/

namespace GTPattern

/-- The partial column sums `λ_(c,j) = ∑_(r < j) e(r, c)` of an exponent `e` of the variables of
the generic `n × n` matrix, on the columns `c < n` and rows `j ≤ n`, and `0` elsewhere. On the
monoid generated by the diagonal exponents of the flag minors it takes values in the nonnegative
Gelfand-Tsetlin patterns (`TauCeti.GTPattern.flagExponentEquiv`). -/
noncomputable def exponentEntries : (Fin n ×ₗ Fin n →₀ ℕ) →+ ℕ → ℕ → ℤ where
  toFun e c j :=
    if h : c < n ∧ j ≤ n then ∑ r : Fin n with r.val < j, (e (toLex (r, ⟨c, h.1⟩)) : ℤ) else 0
  map_zero' := by funext c j; by_cases h : c < n ∧ j ≤ n <;> simp [h]
  map_add' e f := by funext c j; by_cases h : c < n ∧ j ≤ n <;> simp [h, sum_add_distrib]

theorem exponentEntries_apply (e : Fin n ×ₗ Fin n →₀ ℕ) (c j : ℕ) :
    exponentEntries e c j =
      if h : c < n ∧ j ≤ n then ∑ r : Fin n with r.val < j, (e (toLex (r, ⟨c, h.1⟩)) : ℤ)
      else 0 :=
  (rfl)

/-- **Successive differences.** The exponent `e(r, c)` is the difference `λ_(c,r+1) - λ_(c,r)`
of consecutive partial column sums. -/
@[simp]
theorem exponentEntries_succ_sub (e : Fin n ×ₗ Fin n →₀ ℕ) (r c : Fin n) :
    exponentEntries e c (r + 1) - exponentEntries e c r = e (toLex (r, c)) := by
  have hfilter : (univ.filter fun r' : Fin n ↦ r'.val < r + 1) =
      insert r (univ.filter fun r' : Fin n ↦ r'.val < r) := by
    ext r'; simp only [mem_filter, mem_univ, true_and, mem_insert, Fin.ext_iff]; omega
  have h₁ : (c : ℕ) < n ∧ (r : ℕ) + 1 ≤ n := ⟨c.isLt, r.isLt⟩
  have h₂ : (c : ℕ) < n ∧ (r : ℕ) ≤ n := ⟨c.isLt, r.isLt.le⟩
  simp only [exponentEntries_apply, h₁, h₂, and_self, dite_true, hfilter]
  rw [sum_insert (by simp), add_sub_cancel_right]

/-- An exponent is determined by its partial column sums. -/
theorem exponentEntries_injective :
    Function.Injective (exponentEntries (n := n)) := fun _ _ h ↦ Finsupp.ext fun x ↦ by
  simpa using congrArg (fun F ↦ F (ofLex x).2 ((ofLex x).1 + 1) - F (ofLex x).2 (ofLex x).1) h

/-- **The partial column sums of the diagonal exponent of `I` form the row-subset pattern of
`I`.** -/
@[simp]
theorem exponentEntries_flagDiagonalExponent (I : Finset (Fin n)) :
    exponentEntries (flagDiagonalExponent I) = ⇑(rowSubset I) := by
  funext c j
  rw [exponentEntries_apply, rowSubset_apply]
  -- The `c`-th element `i_c` of `I` lies below `j` exactly when `c < #{r ∈ I | r < j}`.
  have key (hcI : c < #I) :
      c < #{r ∈ I | r.val < j} ↔ (I.orderEmbOfFin rfl ⟨c, hcI⟩).val < j :=
    lt_card_filter_iff_apply_orderEmbOfFin_of_imp I rfl ⟨c, hcI⟩ (fun r : Fin n ↦ r.val < j)
      fun _ _ hba hp ↦ lt_of_le_of_lt (Fin.le_iff_val_le_val.1 hba) hp
  split_ifs with h hcj hcj
  · have hcI : c < #I := hcj.2.trans_le (card_le_card (filter_subset _ _))
    simp [flagDiagonalExponent_apply, hcI, (key hcI).1 hcj.2]
  · refine sum_eq_zero fun r hr ↦ ?_
    rw [mem_filter] at hr; rw [flagDiagonalExponent_apply]
    split_ifs with hcI hr'
    · exact absurd ⟨h.2, (key hcI).2 (hr' ▸ hr.2)⟩ hcj
    all_goals simp
  · have := card_filter_val_lt_le I j; omega
  · rfl

/-- Distinct row subsets have distinct diagonal exponents, so the `2 ^ n` subsets of `Fin n` give
`2 ^ n` distinct diagonal exponents. -/
theorem flagDiagonalExponent_injective :
    Function.Injective (flagDiagonalExponent (n := n)) := fun I J h ↦
  rowSubset_injective <| DFunLike.coe_injective <| by
    rw [← exponentEntries_flagDiagonalExponent, ← exponentEntries_flagDiagonalExponent, h]

/-- The partial column sums map the monoid generated by the diagonal exponents onto the
nonnegative patterns. -/
private theorem map_closure_range_flagDiagonalExponent :
    (AddSubmonoid.closure (Set.range (flagDiagonalExponent (n := n)))).map exponentEntries =
      (AddSubmonoid.nonneg (GTPattern n)).map coeFnAddMonoidHom := by
  rw [← closure_range_rowSubset, AddMonoidHom.map_mclosure, AddMonoidHom.map_mclosure,
    ← Set.range_comp, ← Set.range_comp]
  congr 2; funext I; simp [exponentEntries_flagDiagonalExponent, coeFnAddMonoidHom_apply]

/-- **The monoid generated by the diagonal exponents of the flag minors.** An exponent lies in it
if and only if its partial column sums are the entries of a nonnegative Gelfand-Tsetlin pattern. -/
theorem mem_closure_range_flagDiagonalExponent_iff {e : Fin n ×ₗ Fin n →₀ ℕ} :
    e ∈ AddSubmonoid.closure (Set.range flagDiagonalExponent) ↔
      ∃ P : GTPattern n, 0 ≤ P ∧ ⇑P = exponentEntries e := by
  constructor
  · intro he
    obtain ⟨P, hP, hPe⟩ : exponentEntries e ∈ (AddSubmonoid.nonneg (GTPattern n)).map
        coeFnAddMonoidHom :=
      map_closure_range_flagDiagonalExponent ▸ AddSubmonoid.mem_map_of_mem _ he
    exact ⟨P, hP, by rwa [coeFnAddMonoidHom_apply] at hPe⟩
  · rintro ⟨P, hP, hPe⟩
    have he : exponentEntries e ∈ (AddSubmonoid.nonneg (GTPattern n)).map coeFnAddMonoidHom :=
      ⟨P, hP, by rw [coeFnAddMonoidHom_apply, hPe]⟩
    obtain ⟨e', he', hee'⟩ := map_closure_range_flagDiagonalExponent ▸ he
    rwa [← exponentEntries_injective hee']

/-- **Saturation of the diagonal-exponent monoid.** Inside the ambient exponent monoid
`Fin n ×ₗ Fin n →₀ ℕ`, if a positive multiple `k • e` lies in the submonoid generated by the
diagonal exponents of the flag minors, then `e` already lies in it. -/
theorem nsmulSaturated_closure_range_flagDiagonalExponent (n : ℕ) :
    (AddSubmonoid.closure (Set.range (flagDiagonalExponent (n := n)))).NSMulSaturated := by
  intro k e hke
  rcases eq_or_ne k 0 with rfl | hk
  · exact .inl rfl
  · right
    obtain ⟨Q, -, hQe⟩ := mem_closure_range_flagDiagonalExponent_iff.mp hke
    have hk_pos : (0 : ℤ) < k := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hk)
    have hQ (i j : ℕ) : Q i j = (k : ℤ) * exponentEntries e i j := by
      rw [hQe, map_nsmul, Pi.smul_apply, Pi.smul_apply, nsmul_eq_mul]
    let P : GTPattern n :=
      { entry := exponentEntries e
        zeros' := fun {i j} h ↦
          (mul_eq_zero.mp (hQ i j ▸ Q.entry_eq_zero h)).resolve_left hk_pos.ne'
        interlacing' := fun {i j} hij hj ↦
          ⟨le_of_mul_le_mul_left
              (hQ i j ▸ hQ i (j + 1) ▸ Q.entry_le_entry_succ_row hij hj) hk_pos,
            le_of_mul_le_mul_left
              (hQ (i + 1) (j + 1) ▸ hQ i j ▸ Q.entry_succ_succ_le_entry (i := i) hj) hk_pos⟩ }
    refine mem_closure_range_flagDiagonalExponent_iff.mpr ⟨P, zero_le_iff.mpr fun i j ↦ ?_, rfl⟩
    rw [← entry_eq_coe]; dsimp only [P]; rw [exponentEntries_apply]
    split_ifs <;> [exact sum_nonneg fun _ _ ↦ Nat.cast_nonneg _; exact le_rfl]

@[simp]
theorem nsmulSaturation_closure_range_flagDiagonalExponent (n : ℕ) :
    (AddSubmonoid.closure (Set.range (flagDiagonalExponent (n := n)))).nsmulSaturation =
      AddSubmonoid.closure (Set.range (flagDiagonalExponent (n := n))) :=
  AddSubmonoid.nsmulSaturation_eq_self (nsmulSaturated_closure_range_flagDiagonalExponent n)

/-- **The diagonal exponents of the flag minors generate the monoid of nonnegative
Gelfand-Tsetlin patterns.** The isomorphism sends an exponent `e` to the pattern of its partial
column sums `λ_(c,j) = ∑_(r < j) e(r, c)` (`TauCeti.GTPattern.coe_flagExponentEquiv_apply`), with
inverse given by successive differences (`TauCeti.GTPattern.flagExponentEquiv_symm_apply`). -/
noncomputable def flagExponentEquiv :
    AddSubmonoid.closure (Set.range (flagDiagonalExponent (n := n))) ≃+
      AddSubmonoid.nonneg (GTPattern n) :=
  ((AddSubmonoid.equivMapOfInjective _ _ exponentEntries_injective).trans
    (AddEquiv.addSubmonoidCongr map_closure_range_flagDiagonalExponent)).trans
    (AddSubmonoid.equivMapOfInjective _ _ coeFnAddMonoidHom_injective).symm

@[simp]
theorem coe_flagExponentEquiv_apply
    (e : AddSubmonoid.closure (Set.range (flagDiagonalExponent (n := n)))) :
    ⇑(flagExponentEquiv e : GTPattern n) = exponentEntries (e : Fin n ×ₗ Fin n →₀ ℕ) := by
  rw [← coeFnAddMonoidHom_apply, ← AddSubmonoid.coe_equivMapOfInjective_apply _ _
    coeFnAddMonoidHom_injective, flagExponentEquiv, AddEquiv.trans_apply,
    AddEquiv.apply_symm_apply]
  -- `AddEquiv.addSubmonoidCongr` does not change the underlying element; Mathlib states no lemma
  -- for this, so it is closed by definitional unfolding.
  rfl

/-- The diagonal exponent of the flag minor of `I` corresponds to the row-subset pattern of `I`. -/
@[simp]
theorem flagExponentEquiv_flagDiagonalExponent (I : Finset (Fin n)) :
    flagExponentEquiv ⟨flagDiagonalExponent I, AddSubmonoid.subset_closure ⟨I, rfl⟩⟩ =
      ⟨rowSubset I, zero_le_rowSubset I⟩ :=
  Subtype.ext <| DFunLike.coe_injective <| by
    rw [coe_flagExponentEquiv_apply, exponentEntries_flagDiagonalExponent]

/-- **The inverse is given by successive differences**: the exponent of a nonnegative pattern `P`
at `z_(r,c)` is `λ_(c,r+1) - λ_(c,r)`. -/
theorem flagExponentEquiv_symm_apply (P : AddSubmonoid.nonneg (GTPattern n)) (r c : Fin n) :
    ((flagExponentEquiv.symm P : Fin n ×ₗ Fin n →₀ ℕ) (toLex (r, c)) : ℤ) =
      (P : GTPattern n) c (r + 1) - (P : GTPattern n) c r := by
  conv_rhs => rw [← flagExponentEquiv.apply_symm_apply P, coe_flagExponentEquiv_apply,
    exponentEntries_succ_sub]

end GTPattern

/-- Distinct sets of rows have distinct flag minors over a nontrivial coefficient ring. -/
theorem flagMinor_injective (R : Type*) [CommRing R] [Nontrivial R] :
    Function.Injective (flagMinor (n := n) R) := fun I J h ↦
  GTPattern.flagDiagonalExponent_injective <| by
    simpa only [degree_rename_toLex_flagMinor] using
      congrArg (fun p ↦ lex.degree (rename toLex p)) h

/-- Over a nontrivial commutative ring, the nonempty row subsets give `2 ^ n - 1` distinct flag
minors. -/
theorem card_image_nonempty_flagMinor (n : ℕ) (R : Type*) [CommRing R] [Nontrivial R] :
    Nat.card (flagMinor R '' {I : Finset (Fin n) | I.Nonempty}) = 2 ^ n - 1 := by
  rw [Nat.card_image_of_injective (flagMinor_injective R)]
  exact (TauCeti.card_nonempty_finset (ι := Fin n)).trans (by simp)

end TauCeti
