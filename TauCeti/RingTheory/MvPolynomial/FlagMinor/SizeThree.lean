public import TauCeti.RingTheory.MvPolynomial.FlagMinor.Basic
public import TauCeti.RingTheory.MvPolynomial.SAGBI.Presentation
import Mathlib.Tactic.LinearCombination
import TauCeti.Algebra.MvPolynomial.Monomial.Quadratic

/-!
# The flag-minor algebra of the generic `3 × 3` matrix

The flag minors of the generic `3 × 3` matrix `(z_(r,c))` are, besides the empty minor `1`, the
seven polynomials
`a = z_(0,0)`, `b = z_(1,0)`, `c = z_(2,0)`, the `2 × 2` minors `d, e, f` on the rows
`{0, 1}, {0, 2}, {1, 2}` and the first two columns, and the determinant `g`. The rows are listed by
`TauCeti.flagRowsThree : Fin 7 → Finset (Fin 3)`, so that the variable `X i` of
`MvPolynomial (Fin 7) R` stands for the `i`-th of `a, b, c, d, e, f, g`.

This file computes the flag-minor algebra `R[a, b, c, d, e, f, g]` in this case. For the row-major
lexicographic order on the matrix variables, the leading monomials of the seven minors are the
diagonals `z_(0,0)`, `z_(1,0)`, `z_(2,0)`, `z_(0,0) z_(1,1)`, `z_(0,0) z_(2,1)`,
`z_(1,0) z_(2,1)` and `z_(0,0) z_(1,1) z_(2,2)`. The toric ideal of the seven diagonal exponents is
generated by the single binomial `af - be`, that is `X 0 * X 5 - X 1 * X 4`. The three-term
relation `af - be + cd = 0` lifts this binomial with a correction `cd` of strictly smaller leading
monomial. Hence, by the SAGBI criterion, the seven minors form a SAGBI basis of the flag-minor
algebra over every field, and over every commutative ring the flag-minor algebra is presented as
`R[a, b, c, d, e, f, g] / (af - be + cd)`, while the algebra generated by the leading terms (over a
field, the initial algebra) is presented as `R[a, b, c, d, e, f, g] / (af - be)`.

## Main definitions

* `TauCeti.flagRowsThree`: the seven nonempty sets of rows of a `3 × 3` matrix.
* `TauCeti.flagMinorAlgebraThreeEquiv`: the presentation
  `R[a, b, c, d, e, f, g] / (af - be + cd) ≃ R[flag minors]`.

## Main results

* `TauCeti.toricIdeal_flagDiagonalExponent_flagRowsThree`: the toric ideal of the seven diagonal
  exponents is generated by `X 0 * X 5 - X 1 * X 4`.
* `TauCeti.ker_aeval_leadingTerm_flagRowsThree`: the initial presentation, the relations among the
  leading terms of the seven minors are generated by `af - be`.
* `TauCeti.isSAGBIBasis_flagRowsThree`: over a field, the seven minors form a SAGBI basis of the
  flag-minor algebra.
* `TauCeti.ker_aeval_flagMinor_flagRowsThree`: over every commutative ring, the relations among the
  seven minors are generated by `af - be + cd`.

## References

* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 14 (flag minors, their diagonal initial terms and the SAGBI degeneration).
* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 11.
-/

public section

namespace TauCeti

open MvPolynomial Finset MonomialOrder

/-- The seven nonempty sets of rows of a `3 × 3` matrix, in the order
`{0}, {1}, {2}, {0, 1}, {0, 2}, {1, 2}, {0, 1, 2}`. Their flag minors are the generators
`a, b, c, d, e, f, g` of the flag-minor algebra. -/
def flagRowsThree : Fin 7 → Finset (Fin 3) :=
  ![{0}, {1}, {2}, {0, 1}, {0, 2}, {1, 2}, univ]

theorem flagRowsThree_def :
    flagRowsThree = ![{0}, {1}, {2}, {0, 1}, {0, 2}, {1, 2}, univ] :=
  (rfl)

/-- Distinct indices list distinct sets of rows. -/
theorem flagRowsThree_injective : Function.Injective flagRowsThree := by
  decide

/-- The sets of rows listed by `flagRowsThree` are exactly the nonempty ones. -/
theorem range_flagRowsThree : Set.range flagRowsThree = {I | I.Nonempty} := by
  ext I
  simp only [Set.mem_range]
  revert I
  decide

/-- The seven nonempty flag minors generate the flag-minor algebra, since the remaining flag minor,
of the empty set of rows, is `1`. -/
theorem adjoin_range_flagMinor_flagRowsThree (R : Type*) [CommRing R] :
    Algebra.adjoin R (Set.range fun i ↦ flagMinor R (flagRowsThree i)) =
      Algebra.adjoin R (Set.range (flagMinor R)) := by
  refine le_antisymm (Algebra.adjoin_mono (Set.range_comp_subset_range _ _)) ?_
  refine Algebra.adjoin_le (Set.range_subset_iff.2 fun I ↦ ?_)
  obtain rfl | hI := I.eq_empty_or_nonempty
  · rw [flagMinor_empty]
    exact one_mem _
  · obtain ⟨i, rfl⟩ : I ∈ Set.range flagRowsThree := by rwa [range_flagRowsThree]
    exact Algebra.subset_adjoin ⟨i, rfl⟩

/-- The seven nonempty flag minors, in the lexicographically ordered matrix variables, generate the
flag-minor algebra in these variables. -/
theorem adjoin_range_rename_toLex_flagMinor_flagRowsThree (R : Type*) [CommRing R] :
    Algebra.adjoin R (Set.range fun i ↦ rename toLex (flagMinor R (flagRowsThree i))) =
      Algebra.adjoin R (Set.range fun I : Finset (Fin 3) ↦ rename toLex (flagMinor R I)) := by
  simp_rw [Set.range_comp' (rename toLex), ← AlgHom.map_adjoin,
    adjoin_range_flagMinor_flagRowsThree]

/-! ### The exponent map of the diagonal exponents -/

/-- The value of the exponent map `u ↦ ∑ i, u i • flagDiagonalExponent (flagRowsThree i)` at the
variable `z_(r,c)`. -/
private theorem linearCombination_flagDiagonalExponent_apply (u : Fin 7 →₀ ℕ) (r c : Fin 3) :
    Finsupp.linearCombination ℕ (fun i ↦ flagDiagonalExponent (flagRowsThree i)) u
        (toLex (r, c)) =
      ∑ i, u i * flagDiagonalExponent (flagRowsThree i) (toLex (r, c)) := by
  rw [Finsupp.linearCombination_apply, Finsupp.sum_fintype _ _ (by simp),
    Finsupp.finsetSum_apply]
  simp

/-- Two exponents with the same image under the exponent map differ by a multiple of the relation
`af = be`: they agree in the coordinates of `c`, `d` and `g`, and the differences in the
coordinates of `a, b, e, f` are `k, -k, -k, k` for some integer `k`. -/
private theorem exists_eq_add_smul_of_linearCombination_eq {u v : Fin 7 →₀ ℕ}
    (h : Finsupp.linearCombination ℕ (fun i ↦ flagDiagonalExponent (flagRowsThree i)) u =
      Finsupp.linearCombination ℕ (fun i ↦ flagDiagonalExponent (flagRowsThree i)) v) :
    ∃ (w : Fin 7 →₀ ℕ) (k : ℕ),
      (u = w + k • (Finsupp.single 0 1 + Finsupp.single 5 1) ∧
        v = w + k • (Finsupp.single 1 1 + Finsupp.single 4 1)) ∨
      (u = w + k • (Finsupp.single 1 1 + Finsupp.single 4 1) ∧
        v = w + k • (Finsupp.single 0 1 + Finsupp.single 5 1)) := by
  -- Compare the exponents of the variables occurring in the diagonals.
  have e (r c : Fin 3) := DFunLike.congr_fun h (toLex (r, c))
  have e00 := e 0 0
  have e10 := e 1 0
  have e20 := e 2 0
  have e11 := e 1 1
  have e21 := e 2 1
  have e22 := e 2 2
  simp only [linearCombination_flagDiagonalExponent_apply] at e00 e10 e20 e11 e21 e22
  simp [Fin.sum_univ_seven, flagRowsThree, flagDiagonalExponent_univ,
    Fin.sum_univ_three] at e00 e10 e20 e11 e21 e22
  refine ⟨u ⊓ v, if v 0 ≤ u 0 then u 0 - v 0 else v 0 - u 0, ?_⟩
  split_ifs
  · left
    constructor <;> ext i <;> fin_cases i <;> simp <;> omega
  · right
    constructor <;> ext i <;> fin_cases i <;> simp <;> omega

/-- The toric ideal of the seven diagonal exponents of the flag minors is generated by the single
binomial `af - be`, over every commutative ring. -/
theorem toricIdeal_flagDiagonalExponent_flagRowsThree (R : Type*) [CommRing R] :
    toricIdeal R (fun i ↦ flagDiagonalExponent (flagRowsThree i)) =
      Ideal.span {(X 0 * X 5 - X 1 * X 4 : MvPolynomial (Fin 7) R)} := by
  refine le_antisymm ?_ (Ideal.span_le.2 (Set.singleton_subset_iff.2 ?_))
  · rw [toricIdeal_eq_span, Ideal.span_le]
    rintro _ ⟨u, v, huv, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_span_singleton, X_mul_X_eq_monomial, X_mul_X_eq_monomial]
    have key (w s : Fin 7 →₀ ℕ) (k : ℕ) :
        monomial (w + k • s) (1 : R) = monomial w 1 * monomial s 1 ^ k := by
      rw [monomial_pow, one_pow, monomial_mul_monomial, one_mul]
    obtain ⟨w, k, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩ := exists_eq_add_smul_of_linearCombination_eq huv
    · rw [key, key, ← mul_sub]
      exact (sub_dvd_pow_sub_pow _ _ k).mul_left _
    · rw [dvd_sub_comm, key, key, ← mul_sub]
      exact (sub_dvd_pow_sub_pow _ _ k).mul_left _
  · rw [X_mul_X_eq_monomial, X_mul_X_eq_monomial]
    refine monomial_sub_monomial_mem_toricIdeal ?_
    simp [flagRowsThree]
    abel

/-- **The initial presentation.** The relations among the leading terms, for the row-major
lexicographic order, of the seven nonempty flag minors of the generic `3 × 3` matrix are generated
by `af - be`. -/
theorem ker_aeval_leadingTerm_flagRowsThree (R : Type*) [CommRing R] :
    RingHom.ker (aeval fun i ↦ lex.leadingTerm (rename toLex (flagMinor R (flagRowsThree i)))) =
      Ideal.span {(X 0 * X 5 - X 1 * X 4 : MvPolynomial (Fin 7) R)} := by
  simp only [leadingTerm_rename_toLex_flagMinor]
  rw [← toricIdeal_eq_ker_aeval_monomial, toricIdeal_flagDiagonalExponent_flagRowsThree]

/-! ### The SAGBI basis and the presentation -/

/-- The exponent `A(c d)` of the correction term lies strictly below `A(a f)` in the row-major
lexicographic order: both contain `z_(0,0)`, and only `af` contains `z_(1,0)`. -/
private theorem linearCombination_flagDiagonalExponent_lt :
    Finsupp.linearCombination ℕ (fun i ↦ flagDiagonalExponent (flagRowsThree i))
        (Finsupp.single 2 1 + Finsupp.single 3 1) ≺[lex]
      Finsupp.linearCombination ℕ (fun i ↦ flagDiagonalExponent (flagRowsThree i))
        (Finsupp.single 0 1 + Finsupp.single 5 1) := by
  rw [lex_lt_iff, Finsupp.Lex.lt_iff]
  refine ⟨toLex (1, 0), fun j hj ↦ ?_, ?_⟩
  · obtain ⟨⟨r, c⟩, rfl⟩ := toLex.surjective j
    revert hj
    fin_cases r <;> fin_cases c <;>
      simp [Prod.Lex.toLex_lt_toLex, flagRowsThree]
  · simp [flagRowsThree]

section Certificate

variable (R : Type*) [CommRing R]

/-- The three-term relation `af - be + cd = 0` among the seven nonempty flag minors. -/
private theorem aeval_flagMinor_flagRowsThree_relation :
    aeval (fun i ↦ flagMinor R (flagRowsThree i))
      (X 0 * X 5 - X 1 * X 4 + X 2 * X 3 : MvPolynomial (Fin 7) R) = 0 := by
  simpa [flagRowsThree, mul_comm] using
    flagMinor_singleton_mul_flagMinor_pair_sub_add_eq_zero (n := 1) R
      (show (0 : Fin 3) < 1 by decide) (show (1 : Fin 3) < 2 by decide)

/-- The leading exponents of the seven minors are their diagonal exponents. -/
private theorem degree_rename_toLex_flagMinor_flagRowsThree [Nontrivial R] :
    (fun i ↦ lex.degree (rename toLex (flagMinor R (flagRowsThree i)))) =
      fun i ↦ flagDiagonalExponent (flagRowsThree i) :=
  funext fun _ ↦ degree_rename_toLex_flagMinor R _

/-- The toric ideal of the leading exponents, generated by the binomial `af - be` written with
monomials as in the SAGBI criterion. -/
private theorem toricIdeal_degree_flagRowsThree [Nontrivial R] :
    toricIdeal R (fun i ↦ lex.degree (rename toLex (flagMinor R (flagRowsThree i)))) =
      Ideal.span (Set.range fun _ : Unit ↦
        monomial (Finsupp.single 0 1 + Finsupp.single 5 1) (1 : R) -
          monomial (Finsupp.single 1 1 + Finsupp.single 4 1) 1) := by
  rw [degree_rename_toLex_flagMinor_flagRowsThree, toricIdeal_flagDiagonalExponent_flagRowsThree,
    Set.range_const, X_mul_X_eq_monomial, X_mul_X_eq_monomial]

/-- The correction `-cd` is a bounded zero subduction of the binomial `af - be`. -/
private theorem aeval_neg_X_mul_X_flagRowsThree :
    aeval (fun i ↦ rename toLex (flagMinor R (flagRowsThree i)))
        (-(X 2 * X 3 : MvPolynomial (Fin 7) R)) =
      aeval (fun i ↦ rename toLex (flagMinor R (flagRowsThree i)))
        (monomial (Finsupp.single 0 1 + Finsupp.single 5 1) (1 : R) -
          monomial (Finsupp.single 1 1 + Finsupp.single 4 1) 1) := by
  rw [← X_mul_X_eq_monomial, ← X_mul_X_eq_monomial]
  have h := congrArg (rename toLex) (aeval_flagMinor_flagRowsThree_relation R)
  simp only [map_add, map_sub, map_mul, map_neg, map_zero, aeval_X] at h ⊢
  linear_combination -h

/-- Every exponent of the correction `-cd` has weight strictly below that of `af`. -/
private theorem forall_mem_support_neg_X_mul_X_lt [Nontrivial R] :
    ∀ w ∈ (-(X 2 * X 3) : MvPolynomial (Fin 7) R).support,
      Finsupp.linearCombination ℕ (fun i ↦ lex.degree (rename toLex
          (flagMinor R (flagRowsThree i)))) w ≺[lex]
        Finsupp.linearCombination ℕ (fun i ↦ lex.degree (rename toLex
          (flagMinor R (flagRowsThree i)))) (Finsupp.single 0 1 + Finsupp.single 5 1) := by
  intro w hw
  rw [support_neg, X_mul_X_eq_monomial] at hw
  rw [Finset.mem_singleton.1 (support_monomial_subset hw),
    degree_rename_toLex_flagMinor_flagRowsThree]
  exact linearCombination_flagDiagonalExponent_lt

/-- **The presentation of the flag-minor algebra.** Over every commutative ring, the relations
among the seven nonempty flag minors `a, b, c, d, e, f, g` of the generic `3 × 3` matrix are
generated by `af - be + cd`. -/
theorem ker_aeval_flagMinor_flagRowsThree :
    RingHom.ker (aeval fun i ↦ flagMinor R (flagRowsThree i)) =
      Ideal.span {(X 0 * X 5 - X 1 * X 4 + X 2 * X 3 : MvPolynomial (Fin 7) R)} := by
  nontriviality R
  have h := ker_aeval_eq_span (fun i ↦ monic_rename_toLex_flagMinor R (flagRowsThree i))
    (toricIdeal_degree_flagRowsThree R) (fun _ ↦ aeval_neg_X_mul_X_flagRowsThree R)
    (fun _ ↦ forall_mem_support_neg_X_mul_X_lt R)
  rw [Set.range_const, ← X_mul_X_eq_monomial, ← X_mul_X_eq_monomial, sub_neg_eq_add,
    ← comp_aeval] at h
  rw [← h]
  ext P
  simp only [RingHom.mem_ker, AlgHom.comp_apply]
  exact (map_eq_zero_iff _ (rename_injective _ toLex.injective)).symm

end Certificate

/-- **The SAGBI basis.** Over a field, the seven nonempty flag minors of the generic `3 × 3`
matrix form a SAGBI basis of the flag-minor algebra for the row-major lexicographic order. -/
theorem isSAGBIBasis_flagRowsThree (k : Type*) [Field k] :
    lex.IsSAGBIBasis (Set.range fun i ↦ rename toLex (flagMinor k (flagRowsThree i)))
      (Algebra.adjoin k (Set.range fun I : Finset (Fin 3) ↦ rename toLex (flagMinor k I))) := by
  rw [← adjoin_range_rename_toLex_flagMinor_flagRowsThree,
    isSAGBIBasis_range_iff_forall_exists_aeval_eq
    (fun i ↦ monic_rename_toLex_flagMinor k (flagRowsThree i)) (toricIdeal_degree_flagRowsThree k)]
  exact fun _ ↦ ⟨_, aeval_neg_X_mul_X_flagRowsThree k, forall_mem_support_neg_X_mul_X_lt k⟩

/-- **The presentation of the flag-minor algebra** of the generic `3 × 3` matrix:
`R[a, b, c, d, e, f, g] / (af - be + cd)` is isomorphic to the algebra generated by the flag
minors, by sending `X i` to the flag minor of `flagRowsThree i`. -/
noncomputable def flagMinorAlgebraThreeEquiv (R : Type*) [CommRing R] :
    (MvPolynomial (Fin 7) R ⧸
      Ideal.span {(X 0 * X 5 - X 1 * X 4 + X 2 * X 3 : MvPolynomial (Fin 7) R)}) ≃ₐ[R]
      Algebra.adjoin R (Set.range (flagMinor (n := 3) R)) :=
  (Ideal.quotientEquivAlgOfEq R <| by
      rw [AlgHom.ker_rangeRestrict, ker_aeval_flagMinor_flagRowsThree]).trans <|
    (Ideal.quotientKerAlgEquivOfSurjective
      (aeval fun i ↦ flagMinor R (flagRowsThree i)).rangeRestrict_surjective).trans <|
    Subalgebra.equivOfEq _ _ <| by
      rw [← Algebra.adjoin_range_eq_range_aeval, adjoin_range_flagMinor_flagRowsThree]

/-- The presentation sends the class of a polynomial `P` in `a, …, g` to its value at the flag
minors. -/
@[simp]
theorem coe_flagMinorAlgebraThreeEquiv_mk (R : Type*) [CommRing R] (P : MvPolynomial (Fin 7) R) :
    (flagMinorAlgebraThreeEquiv R (Ideal.Quotient.mk _ P) : MvPolynomial (Fin 3 × Fin 3) R) =
      aeval (fun i ↦ flagMinor R (flagRowsThree i)) P := by
  simp [flagMinorAlgebraThreeEquiv]

end TauCeti
