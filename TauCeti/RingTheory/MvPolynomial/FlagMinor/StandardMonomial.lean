/-!
# The standard-monomial basis and fundamental multigrading of the flag-minor algebra

The **flag-minor algebra** `TauCeti.flagMinorAlgebra n R` is the `R`-subalgebra of the generic
`n × n` polynomial ring `MvPolynomial (Fin n × Fin n) R` generated by the `2 ^ n` flag minors
`TauCeti.flagMinor R I` (or equivalently by the `2 ^ n - 1` nonempty ones). Over an algebraically
closed field, it is the multihomogeneous coordinate ring of the complete flag variety `GL_n / B` in
its Plücker embedding, or the invariant ring `R[Z]^U` under right lower-unitriangular action.

Two column sets `I` and `J` of a semistandard tableau satisfy `#J ≤ #I` and have weakly increasing
sorted entries along each row (`TauCeti.FlagTableauLe I J`). Whenever `#J ≤ #I` fails this
dominance condition, the shuffle Plücker relation expresses `flagMinor R I * flagMinor R J` as a
`ℤ`-linear combination of products `flagMinor R I' * flagMinor R J'` of the same sizes and total
row-index sum with strictly smaller `∑ x ∈ I', (x : ℕ)` (`TauCeti.flagMinor_mul_flagMinor_eq_sum`).
Iterating on the weighted row sum `∑ j, (k - j) * ∑ x ∈ I j, (x : ℕ)` straightening-rewrites every
product of flag minors into tableau products `T.flagMinorProd R`.

Combined with the triangularity of their monic row-major lexicographic leading terms from
`TauCeti.RingTheory.MvPolynomial.FlagMinor.Tableau`, the tableau products `T.flagMinorProd R`, as
`(μ, T)` ranges over shapes `μ` with `μ.colLen 0 ≤ n` and `T : BoundedSSYT n μ`, form a free
`R`-module basis of `flagMinorAlgebra n R` over **every** commutative ring `R`
(`TauCeti.flagMinorBasis`). Cutting out homogeneous components for the column indicator weights
`TauCeti.flagColWeight` decomposes `flagMinorAlgebra n R` into an internal direct sum
(`TauCeti.isInternal_flagMinorColSubmodule`), vanishing off antitone weights and having basis
`BoundedSSYT n μ` in shape degree `c ↦ μ.rowLen c` (`TauCeti.flagMinorShapeBasis`).

## Main definitions

* `TauCeti.flagMinorAlgebra n R`: the `R`-subalgebra generated by `flagMinor R I`.
* `TauCeti.FlagTableauLe I J`: column-standardness `#J ≤ #I` and `i_p ≤ j_p` for `p < #J`.
* `TauCeti.flagMinorBasis n R`: standard-monomial `R`-basis of `flagMinorAlgebra n R`.
* `TauCeti.flagMinorColSubmodule n R d`: column-multidegree `d` component of `flagMinorAlgebra n R`.
* `TauCeti.flagMinorShapeBasis R μ hμ`: tableau `R`-basis of the shape-`μ` component.

## Main results

* `TauCeti.flagMinor_mul_flagMinor_eq_sum`: quadratic shuffle Plücker straightening of flag minors.
* `TauCeti.toSubmodule_flagMinorAlgebra` and `TauCeti.linearIndependent_flagMinorProd`: spanning
  and `R`-linear independence of tableau products over every `CommRing R`.
* `TauCeti.exists_mem_support_degree_and_leadingCoeff_flagMinorProd`: exact leading exponent and
  leading coefficient of any nonzero linear combination of tableau products.
* `TauCeti.isInternal_flagMinorColSubmodule` and
  `TauCeti.flagMinorColSubmodule_eq_bot_of_not_antitone`: fundamental-multigrading decomposition.

## References

* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 14, Theorem 14.6 and Theorem 14.11.
* W. Fulton, *Young Tableaux*, LMSST 35, Cambridge University Press, 1997, §9.1.
* C. De Concini, D. Eisenbud, and C. Procesi, *Young diagrams and determinantal varieties*,
  Invent. Math. **56** (1980), 129-165.
-/

public section

namespace TauCeti

open Finset MvPolynomial MonomialOrder

variable {n : ℕ}

/-! ### The flag-minor subalgebra -/

/-- **The flag-minor subalgebra**: the `R`-subalgebra of `MvPolynomial (Fin n × Fin n) R` generated
by all `2 ^ n` flag minors `flagMinor R I`, `I ⊆ {0, …, n - 1}`. -/
noncomputable def flagMinorAlgebra (n : ℕ) (R : Type*) [CommRing R] :
    Subalgebra R (MvPolynomial (Fin n × Fin n) R) :=
  Algebra.adjoin R (Set.range (flagMinor R))

theorem flagMinorAlgebra_def (n : ℕ) (R : Type*) [CommRing R] :
    flagMinorAlgebra n R = Algebra.adjoin R (Set.range (flagMinor R)) :=
  (rfl)

theorem flagMinor_mem_flagMinorAlgebra (R : Type*) [CommRing R] (I : Finset (Fin n)) :
    flagMinor R I ∈ flagMinorAlgebra n R :=
  Algebra.subset_adjoin ⟨I, rfl⟩

/-- The empty flag minor is `1`, so the `2 ^ n - 1` nonempty flag minors already generate
`flagMinorAlgebra n R` (including for `n = 0`, where both sides are `⊥`). -/
theorem adjoin_flagMinor_nonempty (R : Type*) [CommRing R] :
    Algebra.adjoin R (flagMinor R '' {I : Finset (Fin n) | I.Nonempty}) =
      flagMinorAlgebra n R := by
  refine le_antisymm (Algebra.adjoin_mono (Set.image_subset_range _ _)) (Algebra.adjoin_le ?_)
  rintro _ ⟨I, rfl⟩
  rcases I.eq_empty_or_nonempty with rfl | hne
  · rw [flagMinor_empty]
    exact one_mem _
  · exact Algebra.subset_adjoin ⟨I, hne, rfl⟩

theorem BoundedSSYT.flagMinorProd_mem_flagMinorAlgebra {μ : YoungDiagram} (R : Type*) [CommRing R]
    (T : BoundedSSYT n μ) : T.flagMinorProd R ∈ flagMinorAlgebra n R := by
  rw [T.flagMinorProd_def R]
  exact prod_mem fun m _ ↦ flagMinor_mem_flagMinorAlgebra R (T.colFinset m)

/-! ### The column-standardness order and tableau reconstruction -/

/-- **Column-standardness order** on subsets of `Fin n`: `FlagTableauLe I J` holds when `#J ≤ #I`
and the `p`-th smallest element of `I` is at most the `p`-th smallest element of `J` for every
`p < #J`, i.e., `I` and `J` can appear as adjacent columns of a semistandard Young tableau. -/
def FlagTableauLe (I J : Finset (Fin n)) : Prop :=
  ∃ h : #J ≤ #I, ∀ p : Fin #J, I.orderEmbOfFin rfl (Fin.castLE h p) ≤ J.orderEmbOfFin rfl p

theorem flagTableauLe_def {I J : Finset (Fin n)} :
    FlagTableauLe I J ↔
      ∃ h : #J ≤ #I, ∀ p : Fin #J, I.orderEmbOfFin rfl (Fin.castLE h p) ≤ J.orderEmbOfFin rfl p :=
  Iff.rfl

theorem FlagTableauLe.card_le {I J : Finset (Fin n)} (h : FlagTableauLe I J) : #J ≤ #I :=
  h.1

@[refl]
theorem FlagTableauLe.refl (I : Finset (Fin n)) : FlagTableauLe I I :=
  ⟨le_rfl, fun _ ↦ le_rfl⟩

theorem FlagTableauLe.trans {I J K : Finset (Fin n)} (hIJ : FlagTableauLe I J)
    (hJK : FlagTableauLe J K) : FlagTableauLe I K := by
  obtain ⟨h₁, hp₁⟩ := hIJ
  obtain ⟨h₂, hp₂⟩ := hJK
  exact ⟨h₂.trans h₁, fun p ↦ (hp₁ (Fin.castLE h₂ p)).trans (hp₂ p)⟩

/-- Columns of a bounded semistandard tableau satisfy `FlagTableauLe` from left to right. -/
theorem BoundedSSYT.flagTableauLe_colFinset {μ : YoungDiagram} (T : BoundedSSYT n μ)
    {m₁ m₂ : ℕ} (hm : m₁ ≤ m₂) : FlagTableauLe (T.colFinset m₁) (T.colFinset m₂) := by
  have hcard : #(T.colFinset m₂) ≤ #(T.colFinset m₁) := by
    rw [T.card_colFinset, T.card_colFinset]
    exact μ.colLen_anti m₁ m₂ hm
  refine ⟨hcard, fun p ↦ Fin.le_iff_val_le_val.mpr ?_⟩
  have hp : (p : ℕ) < μ.colLen m₂ := p.2.trans_eq (T.card_colFinset m₂)
  rw [T.coe_orderEmbOfFin_colFinset_apply m₁ rfl, T.coe_orderEmbOfFin_colFinset_apply m₂ rfl]
  exact T.1.row_weak_of_le hm (YoungDiagram.mem_iff_lt_colLen.mpr hp)

/-- Reconstruct the Young diagram with columns of lengths `#(I m)` from a `FlagTableauLe`-chain. -/
private def shapeOfFlagChain {k : ℕ} (I : Fin k → Finset (Fin n))
    (hanti : Antitone fun m : Fin k ↦ #(I m)) : YoungDiagram :=
  (YoungDiagram.ofRowLensFin (fun m : Fin k ↦ #(I m)) hanti).transpose

private theorem mem_shapeOfFlagChain_iff {k : ℕ} {I : Fin k → Finset (Fin n)}
    {hanti : Antitone fun m : Fin k ↦ #(I m)} {i m : ℕ} :
    (i, m) ∈ shapeOfFlagChain I hanti ↔ ∃ hm : m < k, i < #(I ⟨m, hm⟩) := by
  rw [shapeOfFlagChain, YoungDiagram.mem_transpose, Prod.swap_prod_mk,
    YoungDiagram.mem_iff_lt_rowLen]
  by_cases hm : m < k
  · simp [hm, YoungDiagram.rowLen_ofRowLensFin _ _ ⟨m, hm⟩]
  · simp [hm, YoungDiagram.rowLen_ofRowLensFin_eq_zero_of_le _ _ (not_lt.mp hm)]

private theorem colLen_zero_shapeOfFlagChain_le {k : ℕ} {I : Fin k → Finset (Fin n)}
    (hanti : Antitone fun m : Fin k ↦ #(I m)) :
    (shapeOfFlagChain I hanti).colLen 0 ≤ n := by
  rw [shapeOfFlagChain, YoungDiagram.colLen_transpose]
  by_cases hk : 0 < k
  · simpa using (YoungDiagram.rowLen_ofRowLensFin (fun m : Fin k ↦ #(I m)) hanti ⟨0, hk⟩).le.trans
      (card_finset_fin_le _)
  · rw [YoungDiagram.rowLen_ofRowLensFin_eq_zero_of_le _ _ (by omega)]
    exact Nat.zero_le n

/-- Construct the `BoundedSSYT` whose columns are a given `FlagTableauLe`-chain `I`. -/
private def boundedSSYTOfFlagChain {k : ℕ} (I : Fin k → Finset (Fin n))
    (hchain : ∀ m₁ m₂, m₁ ≤ m₂ → FlagTableauLe (I m₁) (I m₂))
    (hanti : Antitone fun m : Fin k ↦ #(I m)) :
    BoundedSSYT n (shapeOfFlagChain I hanti) :=
  ⟨{ entry := fun i m ↦
       if h : ∃ hm : m < k, i < #(I ⟨m, hm⟩) then
         ((I ⟨m, h.1⟩).orderEmbOfFin rfl ⟨i, h.2⟩ : ℕ)
       else 0
     row_weak' := fun {i m₁ m₂} hm hcell ↦ by
       have h₂ := mem_shapeOfFlagChain_iff.mp hcell
       have h₁ := mem_shapeOfFlagChain_iff.mp ((shapeOfFlagChain I hanti).up_left_mem
         le_rfl hm.le hcell)
       simp only [h₁, h₂, ↓reduceDIte]
       obtain ⟨_, hp⟩ := hchain ⟨m₁, h₁.1⟩ ⟨m₂, h₂.1⟩ (Fin.le_def.mpr hm.le)
       exact Fin.le_iff_val_le_val.mp (hp ⟨i, h₂.2⟩)
     col_strict' := fun {i₁ i₂ m} hi hcell ↦ by
       have h₂ := mem_shapeOfFlagChain_iff.mp hcell
       have h₁ := mem_shapeOfFlagChain_iff.mp ((shapeOfFlagChain I hanti).up_left_mem
         hi.le le_rfl hcell)
       simp only [h₁, h₂, ↓reduceDIte]
       exact Fin.lt_def.mp (((I ⟨m, h₂.1⟩).orderEmbOfFin rfl).strictMono hi)
     zeros' := fun h ↦ by
       have h' : ¬ ∃ hm : _ < k, _ < #(I ⟨_, hm⟩) := h ∘ mem_shapeOfFlagChain_iff.mpr
       simp [h'] },
   fun i m hcell ↦ by
     have h := mem_shapeOfFlagChain_iff.mp hcell
     rw [← SemistandardYoungTableau.to_fun_eq_coe]
     simp only [h, ↓reduceDIte]
     exact ((I ⟨m, h.1⟩).orderEmbOfFin rfl ⟨i, h.2⟩).isLt⟩

private theorem boundedSSYTOfFlagChain_apply {k : ℕ} (I : Fin k → Finset (Fin n))
    (hchain : ∀ m₁ m₂, m₁ ≤ m₂ → FlagTableauLe (I m₁) (I m₂))
    (hanti : Antitone fun m : Fin k ↦ #(I m)) (i : ℕ) (m : Fin k) (hi : i < #(I m)) :
    (boundedSSYTOfFlagChain I hchain hanti).1 i m = ((I m).orderEmbOfFin rfl ⟨i, hi⟩ : ℕ) := by
  have h : ∃ hm : (m : ℕ) < k, i < #(I ⟨m, hm⟩) := ⟨m.2, hi⟩
  dsimp only [boundedSSYTOfFlagChain]
  rw [← SemistandardYoungTableau.to_fun_eq_coe]
  simp only [h, ↓reduceDIte]

/-- Every `FlagTableauLe`-chain of nonempty subsets of `Fin n` is the sequence of nonempty columns
of a bounded semistandard Young tableau of shape with at most `n` rows. -/
theorem exists_boundedSSYT_flagMinorProd_eq {k : ℕ} (R : Type*) [CommRing R]
    (I : Fin k → Finset (Fin n)) (hne : ∀ m, (I m).Nonempty)
    (hchain : ∀ m₁ m₂, m₁ ≤ m₂ → FlagTableauLe (I m₁) (I m₂)) :
    ∃ (μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}) (T : BoundedSSYT n μ.1),
      T.flagMinorProd R = ∏ m : Fin k, flagMinor R (I m) := by
  have hanti : Antitone (fun m : Fin k ↦ #(I m)) := fun _ _ h ↦ (hchain _ _ h).card_le
  let μ := shapeOfFlagChain I hanti
  let T := boundedSSYTOfFlagChain I hchain hanti
  have hrow0 : μ.rowLen 0 = k := by
    refine le_antisymm (not_lt.mp fun hk ↦ ?_) (not_lt.mp fun hk ↦ ?_)
    · obtain ⟨hm, _⟩ := mem_shapeOfFlagChain_iff.mp (YoungDiagram.mem_iff_lt_rowLen.mpr hk)
      omega
    · have hmem : (0, μ.rowLen 0) ∈ μ :=
        mem_shapeOfFlagChain_iff.mpr ⟨hk, (hne ⟨μ.rowLen 0, hk⟩).card_pos⟩
      exact (YoungDiagram.mem_iff_lt_rowLen.mp hmem).false
  refine ⟨⟨μ, colLen_zero_shapeOfFlagChain_le hanti⟩, T, ?_⟩
  rw [T.flagMinorProd_def R, hrow0, ← Fin.prod_univ_eq_prod_range]
  refine Fintype.prod_congr _ _ fun m ↦ congrArg (flagMinor R) ?_
  ext r
  rw [T.mem_colFinset_iff]
  have hlen : μ.colLen m = #(I m) := by simp [μ, shapeOfFlagChain, YoungDiagram.colLen_transpose]
  constructor
  · rintro ⟨i, hi, hir⟩
    rw [boundedSSYTOfFlagChain_apply I hchain hanti i m (hi.trans_eq hlen)] at hir
    exact Fin.ext hir ▸ (I m).orderEmbOfFin_mem rfl _
  · intro hr
    obtain ⟨i, rfl⟩ := (Finset.range_orderEmbOfFin (I m) rfl).symm.subset hr
    exact ⟨i, i.2.trans_eq hlen.symm, boundedSSYTOfFlagChain_apply I hchain hanti i m i.2⟩

/-! ### Quadratic shuffle Plücker straightening -/

/-- A minor of the generic `n × n` matrix on rows `u : Fin d → Fin n` and the first `d` columns
either vanishes (when `u` repeats a row) or equals `± flagMinor R (univ.image u)`. -/
private theorem mvPolynomialMinor_eq_zero_or_sign_smul_flagMinor (R : Type*) [CommRing R]
    {d : ℕ} (hd : d ≤ n) (u : Fin d → Fin n) :
    Matrix.mvPolynomialMinor R u (Fin.castLE hd) = 0 ∨
      Function.Injective u ∧
        ∃ s : ℤˣ, Matrix.mvPolynomialMinor R u (Fin.castLE hd) =
          (s : ℤ) • flagMinor R (univ.image u) := by
  by_cases hu : Function.Injective u
  · right
    refine ⟨hu, ?_⟩
    set I' := univ.image u
    have hcard : #I' = d := (card_image_of_injective univ hu).trans (Fintype.card_fin d)
    obtain ⟨τ, hτ, -⟩ := Equiv.Perm.existsUnique_strictMono_comp hu
    have hord : (u ∘ τ) ∘ finCongr hcard = I'.orderEmbOfFin rfl :=
      orderEmbOfFin_unique rfl (fun i ↦ mem_image_of_mem u (mem_univ _))
        (hτ.comp (Fin.castOrderIso hcard).strictMono)
    have hu_eq : u = I'.orderEmbOfFin rfl ∘ finCongr hcard.symm ∘ τ.symm := by
      ext1 i
      have hi := congr_fun hord (finCongr hcard.symm (τ.symm i))
      simp only [Function.comp_apply, finCongr_apply, Fin.cast_cast, Fin.cast_eq_self,
        Equiv.apply_symm_apply] at hi
      rw [Function.comp_apply, Function.comp_apply, finCongr_apply]
      exact hi
    have hc_eq : Fin.castLE hd = Fin.castLE (card_finset_fin_le I') ∘ finCongr hcard.symm := rfl
    refine ⟨Equiv.Perm.sign τ.symm, ?_⟩
    rw [Matrix.mvPolynomialMinor_eq_det_submatrix, flagMinor_def,
      Matrix.mvPolynomialMinor_eq_det_submatrix, hu_eq, hc_eq]
    have hsub :
        (Matrix.mvPolynomialX (Fin n) (Fin n) R).submatrix
            (I'.orderEmbOfFin rfl ∘ finCongr hcard.symm ∘ τ.symm)
            (Fin.castLE (card_finset_fin_le I') ∘ finCongr hcard.symm) =
          (((Matrix.mvPolynomialX (Fin n) (Fin n) R).submatrix
              (I'.orderEmbOfFin rfl) (Fin.castLE (card_finset_fin_le I'))).submatrix
              (finCongr hcard.symm) (finCongr hcard.symm)).submatrix τ.symm id := rfl
    rw [hsub, Matrix.det_permute, Matrix.det_submatrix_equiv_self]
    simp [zsmul_eq_mul]
  · left
    rw [Function.not_injective_iff] at hu
    obtain ⟨i, j, hij, hne⟩ := hu
    rw [Matrix.mvPolynomialMinor_eq_det_submatrix]
    exact Matrix.det_zero_of_row_eq hne (by ext k; simp [hij])

/-- A monotonic shuffle `σ ≠ 1` of an injective `γ : κ₁ ⊕ κ₂ → Fin n` cannot map `κ₁` into `κ₁`. -/
private theorem shuffle_map_inl_ne_of_ne_one {κ₁ κ₂ : Type*}
    [LinearOrder κ₁] [Fintype κ₁] [LinearOrder κ₂] [Finite κ₂]
    {γ : κ₁ ⊕ κ₂ → Fin n} (hγ : Function.Injective γ)
    (hγ₁ : StrictMono (γ ∘ Sum.inl)) (hγ₂ : StrictMono (γ ∘ Sum.inr))
    {σ : Equiv.Perm (κ₁ ⊕ κ₂)} (hσ₁ : StrictMono (γ ∘ σ ∘ Sum.inl))
    (hσ₂ : StrictMono (γ ∘ σ ∘ Sum.inr)) (hσ : σ ≠ 1) :
    (univ.map ⟨Sum.inl, Sum.inl_injective⟩).map σ.toEmbedding ≠
      univ.map ⟨Sum.inl, Sum.inl_injective⟩ := by
  intro heq
  have hinl : ∀ x : κ₁, ∃ y : κ₁, σ (.inl x) = .inl y := fun x ↦ by
    have hx : σ (.inl x) ∈ (univ.map ⟨Sum.inl, Sum.inl_injective⟩ : Finset (κ₁ ⊕ κ₂)) :=
      heq ▸ mem_map_of_mem _ (mem_map_of_mem _ (mem_univ x))
    obtain ⟨y, _, hy⟩ := mem_map.mp hx
    exact ⟨y, hy.symm⟩
  choose f hf using hinl
  have hfinj : Function.Injective f := fun x₁ x₂ h ↦
    Sum.inl_injective (σ.injective ((hf x₁).trans ((congrArg Sum.inl h).trans (hf x₂).symm)))
  let p : Equiv.Perm κ₁ := Equiv.ofBijective f ⟨hfinj, Finite.surjective_of_injective hfinj⟩
  have hp_mono : StrictMono ((γ ∘ Sum.inl) ∘ p) := fun x₁ x₂ h ↦ by
    have h' := hσ₁ h
    dsimp only [p, Equiv.ofBijective, Function.comp_apply] at h' ⊢
    rwa [hf x₁, hf x₂] at h'
  obtain ⟨_, _, huniq₁⟩ := Equiv.Perm.existsUnique_strictMono_comp (hγ.comp Sum.inl_injective)
  have hfix₁ : ∀ x : κ₁, σ (.inl x) = .inl x := fun x ↦ by
    have hp1 : p = 1 := (huniq₁ p hp_mono).trans (huniq₁ 1 hγ₁).symm
    exact (hf x).trans (congrArg Sum.inl (congr_fun (congrArg DFunLike.coe hp1) x))
  have hinr : ∀ y : κ₂, ∃ z : κ₂, σ (.inr y) = .inr z := fun y ↦ by
    rcases hsy : σ (.inr y) with x | z
    · exact absurd (σ.injective (hsy.trans (hfix₁ x).symm)) (by simp)
    · exact ⟨z, rfl⟩
  choose g hg using hinr
  have hginj : Function.Injective g := fun y₁ y₂ h ↦
    Sum.inr_injective (σ.injective ((hg y₁).trans ((congrArg Sum.inr h).trans (hg y₂).symm)))
  let q : Equiv.Perm κ₂ := Equiv.ofBijective g ⟨hginj, Finite.surjective_of_injective hginj⟩
  have hq_mono : StrictMono ((γ ∘ Sum.inr) ∘ q) := fun y₁ y₂ h ↦ by
    have h' := hσ₂ h
    dsimp only [q, Equiv.ofBijective, Function.comp_apply] at h' ⊢
    rwa [hg y₁, hg y₂] at h'
  obtain ⟨_, _, huniq₂⟩ := Equiv.Perm.existsUnique_strictMono_comp (hγ.comp Sum.inr_injective)
  have hfix₂ : ∀ y : κ₂, σ (.inr y) = .inr y := fun y ↦ by
    have hq1 : q = 1 := (huniq₂ q hq_mono).trans (huniq₂ 1 hγ₂).symm
    exact (hg y).trans (congrArg Sum.inr (congr_fun (congrArg DFunLike.coe hq1) y))
  exact hσ (Equiv.ext fun z ↦ by rcases z with x | y; exacts [hfix₁ x, hfix₂ y])

/-- For an injective map `γ : κ₁ ⊕ κ₂ → Fin n` strictly increasing on each summand, with values on
`κ₂` bounded by `a₀ < b₀` and values on `κ₁` at least `b₀`, any nontrivial shuffle `σ ≠ 1` strictly
decreases the sum of `γ` on `κ₁`. -/
private theorem sum_comp_inl_lt_of_shuffle_ne_one {κ₁ κ₂ : Type*}
    [LinearOrder κ₁] [Fintype κ₁] [LinearOrder κ₂] [Finite κ₂]
    {γ : κ₁ ⊕ κ₂ → Fin n} (hγ : Function.Injective γ)
    (hγ₁ : StrictMono (γ ∘ Sum.inl)) (hγ₂ : StrictMono (γ ∘ Sum.inr))
    {a₀ b₀ : Fin n} (hab : a₀ < b₀)
    (hκ₁ : ∀ x : κ₁, b₀ ≤ γ (.inl x)) (hκ₂ : ∀ y : κ₂, γ (.inr y) ≤ a₀)
    {σ : Equiv.Perm (κ₁ ⊕ κ₂)} (hσ₁ : StrictMono (γ ∘ σ ∘ Sum.inl))
    (hσ₂ : StrictMono (γ ∘ σ ∘ Sum.inr)) (hσ : σ ≠ 1) :
    (∑ x : κ₁, (γ (σ (.inl x)) : ℕ)) < ∑ x : κ₁, (γ (.inl x) : ℕ) := by
  classical
  let L : Finset (κ₁ ⊕ κ₂) := univ.map ⟨Sum.inl, Sum.inl_injective⟩
  let S : Finset (κ₁ ⊕ κ₂) := L.map σ.toEmbedding
  have hSL : S ≠ L := shuffle_map_inl_ne_of_ne_one hγ hγ₁ hγ₂ hσ₁ hσ₂ hσ
  have hsumS : (∑ x : κ₁, (γ (σ (.inl x)) : ℕ)) = (∑ z ∈ S \ L, (γ z : ℕ)) +
      ∑ z ∈ S ∩ L, (γ z : ℕ) := by
    rw [← sum_union (disjoint_sdiff_inter S L), sdiff_union_inter]
    simp [S, L]
  have hsumL : (∑ x : κ₁, (γ (.inl x) : ℕ)) = (∑ z ∈ L \ S, (γ z : ℕ)) +
      ∑ z ∈ S ∩ L, (γ z : ℕ) := by
    rw [inter_comm S L, ← sum_union (disjoint_sdiff_inter L S), sdiff_union_inter]
    simp [L]
  have hcard_sdiff : #(S \ L) = #(L \ S) := by
    have h₁ := card_sdiff_add_card_inter S L
    have h₂ := card_sdiff_add_card_inter L S
    have h₃ : #S = #L := card_map _
    rw [inter_comm L S] at h₂
    omega
  have hpos : 0 < #(S \ L) := card_pos.mpr (sdiff_nonempty.mpr fun hsub ↦
    hSL (eq_of_subset_of_card_le hsub (card_map _).ge))
  have hle_S : (∑ z ∈ S \ L, (γ z : ℕ)) ≤ #(S \ L) * (a₀ : ℕ) :=
    sum_le_card_nsmul (S \ L) (fun z ↦ (γ z : ℕ)) (a₀ : ℕ) fun z hz ↦ by
      rcases z with x | y
      · exact absurd (mem_map_of_mem _ (mem_univ x)) (mem_sdiff.mp hz).2
      · exact Fin.le_iff_val_le_val.mp (hκ₂ y)
  have hle_L : #(L \ S) * (b₀ : ℕ) ≤ ∑ z ∈ L \ S, (γ z : ℕ) :=
    card_nsmul_le_sum (L \ S) (fun z ↦ (γ z : ℕ)) (b₀ : ℕ) fun z hz ↦ by
      obtain ⟨x, _, rfl⟩ := mem_map.mp (mem_sdiff.mp hz).1
      exact Fin.le_iff_val_le_val.mp (hκ₁ x)
  have hlt_mul : #(S \ L) * (a₀ : ℕ) < #(L \ S) * (b₀ : ℕ) :=
    hcard_sdiff ▸ Nat.mul_lt_mul_of_pos_left (Fin.lt_def.mp hab) hpos
  omega

/-- Cardinality inequality `#I < #κ₁ + #κ₂` enabling the shuffle Plücker relation at row `p₀`. -/
private theorem card_fin_lt_add_card_compl {d₁ d₂ : ℕ} (hd : d₂ ≤ d₁) (p₀ : Fin d₂)
    [DecidablePred fun b : Fin d₁ ↦ b.val < p₀.val]
    [DecidablePred fun a : Fin d₂ ↦ p₀.val < a.val] :
    Fintype.card (Fin d₁) <
      Fintype.card {b : Fin d₁ // ¬ b.val < p₀.val} +
        Fintype.card {a : Fin d₂ // ¬ p₀.val < a.val} := by
  have hcard_ι₁ : Fintype.card {b : Fin d₁ // b.val < p₀.val} = p₀.val :=
    (Fintype.card_congr
      { toFun := fun b ↦ (⟨b.1.val, b.2⟩ : Fin p₀.val)
        invFun := fun x ↦ ⟨⟨x.val, x.2.trans (p₀.2.trans_le hd)⟩, x.2⟩
        left_inv := fun _ ↦ rfl
        right_inv := fun _ ↦ rfl }).trans (Fintype.card_fin p₀.val)
  have hcard_κ₂ : Fintype.card {a : Fin d₂ // ¬ p₀.val < a.val} = p₀.val + 1 :=
    (Fintype.card_congr
      { toFun := fun a ↦ (⟨a.1.val, Nat.lt_succ_of_le (not_lt.mp a.2)⟩ : Fin (p₀.val + 1))
        invFun := fun x ↦ ⟨⟨x.val, (Nat.lt_succ_iff.mp x.2).trans_lt p₀.2⟩,
          not_lt.mpr (Nat.lt_succ_iff.mp x.2)⟩
        left_inv := fun _ ↦ rfl
        right_inv := fun _ ↦ rfl }).trans (Fintype.card_fin (p₀.val + 1))
  have hsplit : Fintype.card (Fin d₁) =
      Fintype.card {b : Fin d₁ // b.val < p₀.val} +
        Fintype.card {b : Fin d₁ // ¬ b.val < p₀.val} := by
    rw [Fintype.card_congr (Equiv.sumCompl (fun b : Fin d₁ ↦ b.val < p₀.val)).symm,
      Fintype.card_sum]
  rw [Fintype.card_fin] at hsplit ⊢
  omega

/-- Row-sum conservation and strict first-factor decrease for an injective shuffle term. -/
private theorem sum_image_shuffle_eq_and_lt {I J : Finset (Fin n)} {ι₁ κ₁ ι₂ κ₂ : Type*}
    [Finite ι₁] [Fintype κ₁] [Finite ι₂] [Finite κ₂]
    (e₁ : Fin #I ≃ ι₁ ⊕ κ₁) (e₂ : Fin #J ≃ ι₂ ⊕ κ₂)
    (α : ι₁ → Fin n) (β : ι₂ → Fin n) (γ : κ₁ ⊕ κ₂ → Fin n)
    (he₁ : Sum.elim α (γ ∘ Sum.inl) ∘ e₁ = I.orderEmbOfFin rfl)
    (he₂ : Sum.elim β (γ ∘ Sum.inr) ∘ e₂ = J.orderEmbOfFin rfl)
    {σ : Equiv.Perm (κ₁ ⊕ κ₂)}
    (hlt : (∑ x : κ₁, (γ (σ (.inl x)) : ℕ)) < ∑ x : κ₁, (γ (.inl x) : ℕ))
    (hu₁ : Function.Injective (Sum.elim α (γ ∘ σ ∘ Sum.inl) ∘ e₁))
    (hu₂ : Function.Injective (Sum.elim β (γ ∘ σ ∘ Sum.inr) ∘ e₂)) :
    let u₁ := Sum.elim α (γ ∘ σ ∘ Sum.inl) ∘ e₁
    let u₂ := Sum.elim β (γ ∘ σ ∘ Sum.inr) ∘ e₂
    ((∑ x ∈ univ.image u₁, (x : ℕ)) + ∑ y ∈ univ.image u₂, (y : ℕ)) =
      (∑ x ∈ I, (x : ℕ)) + (∑ y ∈ J, (y : ℕ)) ∧
    (∑ x ∈ univ.image u₁, (x : ℕ)) < ∑ x ∈ I, (x : ℕ) := by
  cases nonempty_fintype ι₁; cases nonempty_fintype ι₂; cases nonempty_fintype κ₂
  intro u₁ u₂
  have hI_img : univ.image (I.orderEmbOfFin rfl) = I := by
    rw [← coe_inj, coe_image, coe_univ, Set.image_univ, range_orderEmbOfFin]
  have hJ_img : univ.image (J.orderEmbOfFin rfl) = J := by
    rw [← coe_inj, coe_image, coe_univ, Set.image_univ, range_orderEmbOfFin]
  have hI_sum : (∑ x ∈ I, (x : ℕ)) = (∑ x : ι₁, (α x : ℕ)) + ∑ x : κ₁, (γ (.inl x) : ℕ) := by
    rw [← hI_img, sum_image fun _ _ _ _ h ↦ (I.orderEmbOfFin rfl).injective h, ← he₁]
    dsimp only [Function.comp_apply]
    rw [Fintype.sum_equiv e₁ _
        (fun z ↦ ((Sum.elim α (γ ∘ (Sum.inl : κ₁ → κ₁ ⊕ κ₂)) z : Fin n) : ℕ))
        fun _ ↦ rfl, Fintype.sum_sum_type]
    simp
  have hJ_sum : (∑ y ∈ J, (y : ℕ)) = (∑ y : ι₂, (β y : ℕ)) + ∑ y : κ₂, (γ (.inr y) : ℕ) := by
    rw [← hJ_img, sum_image fun _ _ _ _ h ↦ (J.orderEmbOfFin rfl).injective h, ← he₂]
    dsimp only [Function.comp_apply]
    rw [Fintype.sum_equiv e₂ _
        (fun z ↦ ((Sum.elim β (γ ∘ (Sum.inr : κ₂ → κ₁ ⊕ κ₂)) z : Fin n) : ℕ))
        fun _ ↦ rfl, Fintype.sum_sum_type]
    simp
  have hu₁_sum : (∑ x ∈ univ.image u₁, (x : ℕ)) =
      (∑ x : ι₁, (α x : ℕ)) + ∑ x : κ₁, (γ (σ (.inl x)) : ℕ) := by
    rw [sum_image fun _ _ _ _ h ↦ hu₁ h]
    dsimp only [u₁, Function.comp_apply]
    rw [Fintype.sum_equiv e₁ _ (fun z ↦ ((Sum.elim α (γ ∘ ⇑σ ∘ Sum.inl) z : Fin n) : ℕ))
        fun _ ↦ rfl, Fintype.sum_sum_type]
    simp
  have hu₂_sum : (∑ y ∈ univ.image u₂, (y : ℕ)) =
      (∑ y : ι₂, (β y : ℕ)) + ∑ y : κ₂, (γ (σ (.inr y)) : ℕ) := by
    rw [sum_image fun _ _ _ _ h ↦ hu₂ h]
    dsimp only [u₂, Function.comp_apply]
    rw [Fintype.sum_equiv e₂ _ (fun z ↦ ((Sum.elim β (γ ∘ ⇑σ ∘ Sum.inr) z : Fin n) : ℕ))
        fun _ ↦ rfl, Fintype.sum_sum_type]
    simp
  have hperm : (∑ x : κ₁, (γ (σ (.inl x)) : ℕ)) + (∑ y : κ₂, (γ (σ (.inr y)) : ℕ)) =
      (∑ x : κ₁, (γ (.inl x) : ℕ)) + ∑ y : κ₂, (γ (.inr y) : ℕ) := by
    rw [← Fintype.sum_sum_type fun z ↦ (γ (σ z) : ℕ), Equiv.sum_comp σ fun z ↦ (γ z : ℕ),
      Fintype.sum_sum_type]
  omega

/-- Plücker shuffle expansion of `flagMinor R I * flagMinor R J` along a violating column `p₀`. -/
private theorem flagMinor_mul_flagMinor_eq_sum_shuffle (R : Type*) [CommRing R]
    {I J : Finset (Fin n)} (hJI : #J ≤ #I) (p₀ : Fin #J)
    (hp₀ : J.orderEmbOfFin rfl p₀ < I.orderEmbOfFin rfl (Fin.castLE hJI p₀))
    [DecidableEq (Equiv.Perm ({b : Fin #I // ¬ b.val < p₀.val} ⊕
      {a : Fin #J // ¬ p₀.val < a.val}))] :
    let r₁ := I.orderEmbOfFin rfl
    let r₂ := J.orderEmbOfFin rfl
    let p₁ : Fin #I → Prop := fun b ↦ b.val < p₀.val
    let p₂ : Fin #J → Prop := fun a ↦ p₀.val < a.val
    let e₁ := (Equiv.sumCompl p₁).symm
    let e₂ := (Equiv.sumCompl p₂).symm
    let α : {b // p₁ b} → Fin n := fun b ↦ r₁ b.1
    let β : {a // p₂ a} → Fin n := fun a ↦ r₂ a.1
    let γ : {b // ¬ p₁ b} ⊕ {a // ¬ p₂ a} → Fin n := Sum.elim (fun b ↦ r₁ b.1) (fun a ↦ r₂ a.1)
    let T := univ.filter fun σ : Equiv.Perm ({b // ¬ p₁ b} ⊕ {a // ¬ p₂ a}) ↦
      StrictMono (γ ∘ σ ∘ Sum.inl) ∧ StrictMono (γ ∘ σ ∘ Sum.inr)
    Function.Injective γ ∧
      flagMinor R I * flagMinor R J =
        ∑ σ ∈ T.erase 1, -(Equiv.Perm.sign σ •
          (Matrix.mvPolynomialMinor R (Sum.elim α (γ ∘ σ ∘ Sum.inl) ∘ e₁)
              (Fin.castLE (card_finset_fin_le I)) *
            Matrix.mvPolynomialMinor R (Sum.elim β (γ ∘ σ ∘ Sum.inr) ∘ e₂)
              (Fin.castLE (card_finset_fin_le J)))) := by
  intro r₁ r₂ p₁ p₂ e₁ e₂ α β γ T
  have hκ₁_ge : ∀ x : {b // ¬ p₁ b}, r₁ (Fin.castLE hJI p₀) ≤ γ (.inl x) := fun x ↦
    r₁.monotone (Fin.le_def.mpr (not_lt.mp x.2))
  have hκ₂_le : ∀ y : {a // ¬ p₂ a}, γ (.inr y) ≤ r₂ p₀ := fun y ↦
    r₂.monotone (Fin.le_def.mpr (not_lt.mp y.2))
  have hγ_inj : Function.Injective γ := by
    rintro (x₁ | y₁) (x₂ | y₂) h
    · exact congrArg Sum.inl (Subtype.ext (r₁.injective h))
    · exact absurd h (lt_of_le_of_lt (hκ₂_le y₂) (hp₀.trans_le (hκ₁_ge x₁))).ne'
    · exact absurd h (lt_of_le_of_lt (hκ₂_le y₁) (hp₀.trans_le (hκ₁_ge x₂))).ne
    · exact congrArg Sum.inr (Subtype.ext (r₂.injective h))
  have hT : Subgroup.IsComplement (T : Set (Equiv.Perm ({b // ¬ p₁ b} ⊕ {a // ¬ p₂ a})))
      ((Equiv.Perm.sumCongrHom {b // ¬ p₁ b} {a // ¬ p₂ a}).range :
        Set (Equiv.Perm ({b // ¬ p₁ b} ⊕ {a // ¬ p₂ a}))) := by
    convert Equiv.Perm.isComplement_setOf_strictMono_sumCongrHom_range hγ_inj using 1
    ext σ; simp [T]
  have hrel := Matrix.sum_sign_smul_mvPolynomialMinor_comp_mul_mvPolynomialMinor_comp_eq_zero R
    (Fin.castLE (card_finset_fin_le I)) id (Fin.castLE hJI) e₁ e₂ α β γ
    (card_fin_lt_add_card_compl hJI p₀) hT
  have hu₁_one : Sum.elim α (γ ∘ Sum.inl) ∘ e₁ = r₁ := by
    ext b; by_cases hb : p₁ b <;> simp [e₁, hb, α, γ]
  have hu₂_one : Sum.elim β (γ ∘ Sum.inr) ∘ e₂ = r₂ := by
    ext a; by_cases ha : p₂ a <;> simp [e₂, ha, β, γ]
  have hc₂_eq : Fin.castLE (card_finset_fin_le I) ∘ Fin.castLE hJI =
      Fin.castLE (card_finset_fin_le J) := rfl
  have h1T : (1 : Equiv.Perm ({b // ¬ p₁ b} ⊕ {a // ¬ p₂ a})) ∈ T :=
    mem_filter.mpr ⟨mem_univ _, fun _ _ h ↦ r₁.strictMono h, fun _ _ h ↦ r₂.strictMono h⟩
  rw [← add_sum_erase _ _ h1T, Equiv.Perm.sign_one, one_smul, Equiv.Perm.coe_one, Function.id_comp,
    Function.id_comp, hu₁_one, hu₂_one, Function.comp_id, hc₂_eq, ← flagMinor_def, ← flagMinor_def,
    add_eq_zero_iff_eq_neg, ← sum_neg_distrib] at hrel
  exact ⟨hγ_inj, by simpa only [Function.comp_id, hc₂_eq] using hrel⟩

/-- Given a column index `p₀` violating `FlagTableauLe I J`, `flagMinor R I * flagMinor R J` lies in
the `ℤ`-span of products `flagMinor R P.1 * flagMinor R P.2` with the same sizes and total row sum
and strictly smaller first-factor row sum. -/
private theorem flagMinor_mul_flagMinor_mem_span_of_lt (R : Type*) [CommRing R]
    {I J : Finset (Fin n)} (hJI : #J ≤ #I) (p₀ : Fin #J)
    (hp₀ : J.orderEmbOfFin rfl p₀ < I.orderEmbOfFin rfl (Fin.castLE hJI p₀)) :
    let S := univ.filter fun P : Finset (Fin n) × Finset (Fin n) ↦
      #P.1 = #I ∧ #P.2 = #J ∧
        (∑ x ∈ P.1, (x : ℕ)) + (∑ y ∈ P.2, (y : ℕ)) =
          (∑ x ∈ I, (x : ℕ)) + (∑ y ∈ J, (y : ℕ)) ∧
        (∑ x ∈ P.1, (x : ℕ)) < ∑ x ∈ I, (x : ℕ)
    flagMinor R I * flagMinor R J ∈ Submodule.span ℤ
      ((fun P : Finset (Fin n) × Finset (Fin n) ↦ flagMinor R P.1 * flagMinor R P.2) '' S) := by
  classical
  intro S
  obtain ⟨hγ_inj, hrel⟩ := flagMinor_mul_flagMinor_eq_sum_shuffle R hJI p₀ hp₀
  set r₁ := I.orderEmbOfFin rfl; set r₂ := J.orderEmbOfFin rfl
  let p₁ : Fin #I → Prop := fun b ↦ b.val < p₀.val; let p₂ : Fin #J → Prop := fun a ↦ p₀.val < a.val
  let e₁ := (Equiv.sumCompl p₁).symm; let e₂ := (Equiv.sumCompl p₂).symm
  let α : {b // p₁ b} → Fin n := fun b ↦ r₁ b.1; let β : {a // p₂ a} → Fin n := fun a ↦ r₂ a.1
  let γ : {b // ¬ p₁ b} ⊕ {a // ¬ p₂ a} → Fin n := Sum.elim (fun b ↦ r₁ b.1) (fun a ↦ r₂ a.1)
  have hu₁_one : Sum.elim α (γ ∘ Sum.inl) ∘ e₁ = r₁ := by
    ext b; by_cases hb : p₁ b <;> simp [e₁, hb, α, γ]
  have hu₂_one : Sum.elim β (γ ∘ Sum.inr) ∘ e₂ = r₂ := by
    ext a; by_cases ha : p₂ a <;> simp [e₂, ha, β, γ]
  rw [hrel]
  refine Submodule.sum_mem _ fun σ hσ ↦ ?_
  obtain ⟨hσ1, hσT⟩ := mem_erase.mp hσ; obtain ⟨_, hσ_inl, hσ_inr⟩ := mem_filter.mp hσT
  set u₁ := Sum.elim α (γ ∘ σ ∘ Sum.inl) ∘ e₁; set u₂ := Sum.elim β (γ ∘ σ ∘ Sum.inr) ∘ e₂
  rcases mvPolynomialMinor_eq_zero_or_sign_smul_flagMinor R (card_finset_fin_le I) u₁ with
    h0 | ⟨hu₁, s₁, hs₁⟩
  · simp [h0]
  rcases mvPolynomialMinor_eq_zero_or_sign_smul_flagMinor R (card_finset_fin_le J) u₂ with
    h0 | ⟨hu₂, s₂, hs₂⟩
  · simp [h0]
  obtain ⟨hsum, hlt⟩ := sum_image_shuffle_eq_and_lt e₁ e₂ α β γ hu₁_one hu₂_one
    (sum_comp_inl_lt_of_shuffle_ne_one hγ_inj (fun _ _ h ↦ r₁.strictMono h)
      (fun _ _ h ↦ r₂.strictMono h) hp₀ (fun x ↦ r₁.monotone (Fin.le_def.mpr (not_lt.mp x.2)))
      (fun y ↦ r₂.monotone (Fin.le_def.mpr (not_lt.mp y.2))) hσ_inl hσ_inr hσ1) hu₁ hu₂
  rw [hs₁, hs₂, Units.smul_def, smul_mul_smul_comm, smul_smul]
  exact Submodule.neg_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span
    ⟨(univ.image u₁, univ.image u₂), mem_filter.mpr ⟨mem_univ _,
      (card_image_of_injective univ hu₁).trans (Fintype.card_fin #I),
      (card_image_of_injective univ hu₂).trans (Fintype.card_fin #J), hsum, hlt⟩, rfl⟩))

/-- **Quadratic shuffle straightening of flag minors.** Whenever `#J ≤ #I` and
`¬ FlagTableauLe I J`, `flagMinor R I * flagMinor R J` is a `ℤ`-linear combination of products
`flagMinor R I' * flagMinor R J'` with `#I' = #I`, `#J' = #J`, the same total row-index sum, and
strictly smaller first-factor row-index sum `∑ x ∈ I', (x : ℕ) < ∑ x ∈ I, (x : ℕ)`. -/
theorem flagMinor_mul_flagMinor_eq_sum (R : Type*) [CommRing R] {I J : Finset (Fin n)}
    (hJI : #J ≤ #I) (hnot : ¬ FlagTableauLe I J) :
    let S := univ.filter fun P : Finset (Fin n) × Finset (Fin n) ↦
      #P.1 = #I ∧ #P.2 = #J ∧
        (∑ x ∈ P.1, (x : ℕ)) + (∑ y ∈ P.2, (y : ℕ)) =
          (∑ x ∈ I, (x : ℕ)) + (∑ y ∈ J, (y : ℕ)) ∧
        (∑ x ∈ P.1, (x : ℕ)) < ∑ x ∈ I, (x : ℕ)
    ∃ c : Finset (Fin n) × Finset (Fin n) → ℤ,
      flagMinor R I * flagMinor R J =
        ∑ P ∈ S, c P • (flagMinor R P.1 * flagMinor R P.2) := by
  classical
  intro S
  obtain ⟨p₀, hp₀⟩ : ∃ p₀ : Fin #J,
      J.orderEmbOfFin rfl p₀ < I.orderEmbOfFin rfl (Fin.castLE hJI p₀) := by
    by_contra! h; exact hnot ⟨hJI, h⟩
  obtain ⟨l, hlS, hlc⟩ := (Finsupp.mem_span_image_iff_linearCombination ℤ).mp
    (flagMinor_mul_flagMinor_mem_span_of_lt R hJI p₀ hp₀)
  refine ⟨l, ?_⟩
  rw [← hlc, Finsupp.linearCombination_apply]
  exact Finsupp.sum_of_support_subset l (Finset.coe_subset.mp hlS) _ fun _ _ ↦ zero_smul _ _

/-! ### Multi-factor straightening and the standard-monomial basis -/

/-- Weighted row-sum measure for straightening a decreasing-size tuple of flag minors. -/
private def straightenWeight {k : ℕ} (I : Fin k → Finset (Fin n)) : ℕ :=
  ∑ j : Fin k, (k - j.val) * ∑ x ∈ I j, (x : ℕ)

/-- If every adjacent pair in `I : Fin k → Finset (Fin n)` satisfies `FlagTableauLe`, then the whole
tuple is a `FlagTableauLe`-chain. -/
private theorem flagTableauLe_of_adjacent {k : ℕ} {I : Fin k → Finset (Fin n)}
    (hadj : ∀ (j : ℕ) (hj : j + 1 < k), FlagTableauLe (I ⟨j, Nat.lt_of_succ_lt hj⟩) (I ⟨j + 1, hj⟩))
    {m₁ m₂ : Fin k} (hm : m₁ ≤ m₂) : FlagTableauLe (I m₁) (I m₂) := by
  obtain ⟨a, ha⟩ := m₁
  obtain ⟨b, hb⟩ := m₂
  have hab : a ≤ b := Fin.le_def.mp hm
  clear hm
  induction b, hab using Nat.le_induction with
  | base => exact FlagTableauLe.refl _
  | succ d _ ih => exact (ih (Nat.lt_of_succ_lt hb)).trans (hadj d hb)

/-- Replacing an adjacent non-standard pair `(I j₀, I j₁)` by `(P.1, P.2)` with the same total row
sum and strictly smaller first-factor row sum strictly decreases `straightenWeight`. -/
private theorem straightenWeight_update_lt {k j : ℕ} (hj : j + 1 < k)
    (I : Fin k → Finset (Fin n)) {P : Finset (Fin n) × Finset (Fin n)}
    (hPsum : (∑ x ∈ P.1, (x : ℕ)) + (∑ y ∈ P.2, (y : ℕ)) =
      (∑ x ∈ I ⟨j, Nat.lt_of_succ_lt hj⟩, (x : ℕ)) + ∑ y ∈ I ⟨j + 1, hj⟩, (y : ℕ))
    (hPlt : (∑ x ∈ P.1, (x : ℕ)) < ∑ x ∈ I ⟨j, Nat.lt_of_succ_lt hj⟩, (x : ℕ)) :
    straightenWeight
      (Function.update (Function.update I ⟨j, Nat.lt_of_succ_lt hj⟩ P.1) ⟨j + 1, hj⟩ P.2) <
      straightenWeight I := by
  let j₀ : Fin k := ⟨j, Nat.lt_of_succ_lt hj⟩
  let j₁ : Fin k := ⟨j + 1, hj⟩
  have hj₀₁ : j₀ ≠ j₁ := by simp [j₀, j₁, Fin.ext_iff]
  let J := Function.update (Function.update I j₀ P.1) j₁ P.2
  have hsplit (K : Fin k → Finset (Fin n)) :
      straightenWeight K =
        (k - j₀.val) * (∑ x ∈ K j₀, (x : ℕ)) +
          ((k - j₁.val) * (∑ x ∈ K j₁, (x : ℕ)) +
            ∑ m ∈ (univ.erase j₀).erase j₁, (k - m.val) * ∑ x ∈ K m, (x : ℕ)) := by
    rw [straightenWeight, ← add_sum_erase _ _ (mem_univ j₀),
      ← add_sum_erase _ _ (mem_erase.mpr ⟨hj₀₁.symm, mem_univ j₁⟩)]
  have heq_rest :
      (∑ m ∈ (univ.erase j₀).erase j₁, (k - m.val) * ∑ x ∈ J m, (x : ℕ)) =
        ∑ m ∈ (univ.erase j₀).erase j₁, (k - m.val) * ∑ x ∈ I m, (x : ℕ) :=
    sum_congr rfl fun m hm ↦ by
      obtain ⟨hm₁, hm₀⟩ := mem_erase.mp hm
      simp [J, hm₁, (mem_erase.mp hm₀).1]
  have hJj₀ : J j₀ = P.1 := by simp [J, hj₀₁]
  have hJj₁ : J j₁ = P.2 := by simp [J]
  rw [hsplit J, hsplit I, hJj₀, hJj₁, heq_rest]
  simp only [j₀, j₁]
  have hk1 : k - j = k - (j + 1) + 1 := by omega
  have h₁ : (k - (j + 1)) * (∑ x ∈ P.1, (x : ℕ)) + (k - (j + 1)) * (∑ x ∈ P.2, (x : ℕ)) =
      (k - (j + 1)) * ((∑ x ∈ I j₀, (x : ℕ)) + ∑ y ∈ I j₁, (y : ℕ)) := by
    rw [← mul_add, hPsum]
  have h₂ : (k - (j + 1)) * (∑ x ∈ I j₀, (x : ℕ)) + (k - (j + 1)) * (∑ y ∈ I j₁, (y : ℕ)) =
      (k - (j + 1)) * ((∑ x ∈ I j₀, (x : ℕ)) + ∑ y ∈ I j₁, (y : ℕ)) :=
    (mul_add _ _ _).symm
  simp only [j₀, j₁] at h₁ h₂
  rw [hk1, add_one_mul, add_one_mul]
  omega

/-- Every product of nonempty flag minors sorted by decreasing size lies in the `R`-span of the
tableau products `s.2.flagMinorProd R`. -/
private theorem prod_flagMinor_mem_span_of_antitone (R : Type*) [CommRing R] {k : ℕ} :
    ∀ (W : ℕ) (I : Fin k → Finset (Fin n)),
      straightenWeight I = W →
      (∀ m, (I m).Nonempty) →
      Antitone (fun m : Fin k ↦ #(I m)) →
      (∏ m : Fin k, flagMinor R (I m)) ∈
        Submodule.span R
          (Set.range fun s : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) ↦
            s.2.flagMinorProd R) := by
  intro W
  induction W using Nat.strong_induction_on with
  | ind W ih =>
    intro I hW hne hanti
    by_cases hchain : ∀ (j : ℕ) (hj : j + 1 < k),
        FlagTableauLe (I ⟨j, Nat.lt_of_succ_lt hj⟩) (I ⟨j + 1, hj⟩)
    · obtain ⟨μ, T, hT⟩ := exists_boundedSSYT_flagMinorProd_eq R I hne fun m₁ m₂ hm ↦
        flagTableauLe_of_adjacent hchain hm
      exact hT ▸ Submodule.subset_span ⟨⟨μ, T⟩, rfl⟩
    · push Not at hchain
      obtain ⟨j, hj, hnot⟩ := hchain
      let j₀ : Fin k := ⟨j, Nat.lt_of_succ_lt hj⟩
      let j₁ : Fin k := ⟨j + 1, hj⟩
      have hj₀₁ : j₀ ≠ j₁ := by simp [j₀, j₁, Fin.ext_iff]
      obtain ⟨c, hc⟩ := flagMinor_mul_flagMinor_eq_sum R
        (hanti (Fin.le_def.mpr (Nat.le_succ j))) hnot
      have hprod_split (K : Fin k → Finset (Fin n)) :
          (∏ m : Fin k, flagMinor R (K m)) =
            (flagMinor R (K j₀) * flagMinor R (K j₁)) *
              ∏ m ∈ (univ.erase j₀).erase j₁, flagMinor R (K m) := by
        conv_rhs => rw [mul_assoc,
          mul_prod_erase (univ.erase j₀) (fun m ↦ flagMinor R (K m))
            (mem_erase.mpr ⟨hj₀₁.symm, mem_univ j₁⟩),
          mul_prod_erase univ (fun m ↦ flagMinor R (K m)) (mem_univ j₀)]
      rw [hprod_split I, hc, sum_mul]
      refine Submodule.sum_mem _ fun P hP ↦ ?_
      obtain ⟨_, hP₁, hP₂, hPsum, hPlt⟩ := mem_filter.mp hP
      let J : Fin k → Finset (Fin n) := Function.update (Function.update I j₀ P.1) j₁ P.2
      have hJj₀ : J j₀ = P.1 := by simp [J, hj₀₁]
      have hJj₁ : J j₁ = P.2 := by simp [J]
      have hJother : ∀ m ∈ (univ.erase j₀).erase j₁, J m = I m := fun m hm ↦ by
        obtain ⟨hm₁, hm₀⟩ := mem_erase.mp hm
        simp [J, hm₁, (mem_erase.mp hm₀).1]
      rw [smul_mul_assoc, ← hJj₀, ← hJj₁,
        ← prod_congr rfl fun m hm ↦ congrArg (flagMinor R) (hJother m hm), ← hprod_split J]
      have hJcard : ∀ m : Fin k, #(J m) = #(I m) := fun m ↦ by
        by_cases hm₁ : m = j₁
        · subst hm₁; exact hJj₁.symm ▸ hP₂
        · by_cases hm₀ : m = j₀
          · subst hm₀; exact hJj₀.symm ▸ hP₁
          · simp [J, hm₁, hm₀]
      exact zsmul_mem (ih (straightenWeight J)
        (hW ▸ straightenWeight_update_lt hj I hPsum hPlt) J rfl
        (fun m ↦ card_pos.mp ((hne m).card_pos.trans_eq (hJcard m).symm))
        (fun m₁ m₂ hm ↦ by simpa only [hJcard] using hanti hm)) (c P)

/-- Every finite product of flag minors lies in the `R`-linear span of the tableau products
`s.2.flagMinorProd R`. -/
theorem prod_flagMinor_mem_span_flagMinorProd (R : Type*) [CommRing R]
    (L : List (Finset (Fin n))) :
    (L.map (flagMinor R)).prod ∈
      Submodule.span R
        (Set.range fun s : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) ↦
          s.2.flagMinorProd R) := by
  have hfilter : ((L.filter fun I ↦ decide I.Nonempty).map (flagMinor R)).prod =
      (L.map (flagMinor R)).prod := by
    induction L with
    | nil => rfl
    | cons I tl ih =>
      rw [List.filter_cons]
      rcases I.eq_empty_or_nonempty with rfl | hne
      · simp [ih]
      · simp [hne, ih]
  rw [← hfilter]
  set L₁ := L.filter fun I ↦ decide I.Nonempty
  let L₂ := L₁.mergeSort (fun A B : Finset (Fin n) ↦ decide (#B ≤ #A))
  have hperm : (L₁.map (flagMinor R)).prod = (L₂.map (flagMinor R)).prod :=
    ((L₁.mergeSort_perm _).map (flagMinor R)).prod_eq.symm
  have hsorted : L₂.Pairwise (fun A B ↦ #B ≤ #A) := by
    have hp := L₁.pairwise_mergeSort (le := fun A B : Finset (Fin n) ↦ decide (#B ≤ #A))
      (fun _ _ _ h₁ h₂ ↦ decide_eq_true (le_trans (of_decide_eq_true h₂) (of_decide_eq_true h₁)))
      (fun A B ↦ by obtain h | h := le_total #B #A <;> simp [h])
    exact hp.imp fun h ↦ of_decide_eq_true h
  have hne₂ : ∀ I ∈ L₂, I.Nonempty := fun I hI ↦ by
    simpa [L₁] using (List.mem_filter.mp ((L₁.mergeSort_perm _).subset hI)).2
  let I : Fin L₂.length → Finset (Fin n) := fun m ↦ L₂[m.val]
  have hprod_fin : (L₂.map (flagMinor R)).prod = ∏ m : Fin L₂.length, flagMinor R (I m) := by
    have hofFn : L₂ = List.ofFn I := (List.ofFn_getElem (xs := L₂)).symm
    conv_lhs => rw [hofFn, List.map_ofFn, List.prod_ofFn]
    rfl
  have hanti : Antitone (fun m : Fin L₂.length ↦ #(I m)) := fun m₁ m₂ hm ↦ by
    rcases hm.eq_or_lt with rfl | hlt
    · exact le_rfl
    · exact List.pairwise_iff_getElem.mp hsorted m₁.val m₂.val m₁.2 m₂.2 hlt
  rw [hperm, hprod_fin]
  exact prod_flagMinor_mem_span_of_antitone R (straightenWeight I) I rfl
    (fun m ↦ hne₂ (I m) (List.getElem_mem _)) hanti

/-- **Spanning theorem.** As an `R`-submodule, `flagMinorAlgebra n R` is spanned by the tableau
products `s.2.flagMinorProd R` over all shapes `μ` with at most `n` rows and all
`T : BoundedSSYT n μ`. -/
theorem toSubmodule_flagMinorAlgebra (R : Type*) [CommRing R] :
    Subalgebra.toSubmodule (flagMinorAlgebra n R) =
      Submodule.span R
        (Set.range fun s : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) ↦
          s.2.flagMinorProd R) := by
  refine le_antisymm ?_ (Submodule.span_le.mpr ?_)
  · rw [flagMinorAlgebra_def, Algebra.adjoin_eq_span]
    refine Submodule.span_le.mpr fun p hp ↦ ?_
    obtain ⟨L, hL, rfl⟩ := Submonoid.exists_list_of_mem_closure hp
    choose f hf using fun x (hx : x ∈ L) ↦ hL x hx
    have hL_eq : L = (L.attach.map fun x ↦ f x.1 x.2).map (flagMinor R) := by
      conv_lhs => rw [← List.attach_map_subtype_val L]
      rw [List.map_map]
      exact List.map_congr_left fun x _ ↦ (hf x.1 x.2).symm
    rw [hL_eq]
    exact prod_flagMinor_mem_span_flagMinorProd R (L.attach.map fun x ↦ f x.1 x.2)
  · rintro _ ⟨s, rfl⟩
    exact s.2.flagMinorProd_mem_flagMinorAlgebra R

/-! ### Triangularity, linear independence, and `flagMinorBasis` -/

/-- **Exact leading data of linear combinations of tableau products.** Over **every** commutative
ring `R`, any nonzero `R`-linear combination of tableau products `s.2.flagMinorProd R` is nonzero,
and its row-major lexicographic leading exponent and leading coefficient are those of the unique
supported tableau `s₀ ∈ l.support` of largest diagonal-sum exponent, with leading coefficient
`l s₀`. -/
theorem exists_mem_support_degree_and_leadingCoeff_flagMinorProd {R : Type*} [CommRing R]
    {l : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) →₀ R}
    (hl : l ≠ 0) :
    haveI : Nontrivial R :=
      let ⟨s, hs⟩ := Finsupp.support_nonempty_iff.mpr hl
      ⟨⟨l s, 0, Finsupp.mem_support_iff.mp hs⟩⟩
    ∃ s₀ ∈ l.support,
      rename toLex (Finsupp.linearCombination R (fun s ↦ s.2.flagMinorProd R) l) ≠ 0 ∧
      lex.degree (rename toLex (Finsupp.linearCombination R (fun s ↦ s.2.flagMinorProd R) l)) =
        lex.degree (rename toLex (s₀.2.flagMinorProd R)) ∧
      lex.leadingCoeff
          (rename toLex (Finsupp.linearCombination R (fun s ↦ s.2.flagMinorProd R) l)) =
        l s₀ := by
  have hne : l.support.Nonempty := Finsupp.support_nonempty_iff.mpr hl
  have : Nontrivial R :=
    let ⟨s, hs⟩ := hne
    ⟨⟨l s, 0, Finsupp.mem_support_iff.mp hs⟩⟩
  set g : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) →
      MvPolynomial (Fin n ×ₗ Fin n) R := fun s ↦ rename toLex (s.2.flagMinorProd R)
  obtain ⟨s₀, hs₀, hmax⟩ := exists_max_image l.support (fun s ↦ lex.toSyn (lex.degree (g s))) hne
  set F := rename toLex (Finsupp.linearCombination R (fun s ↦ s.2.flagMinorProd R) l)
  have hF_eq : F = ∑ s ∈ l.support, l s • g s := by
    simp [F, g, Finsupp.linearCombination_apply, Finsupp.sum, map_sum]
  have hlt : ∀ s ∈ l.support, s ≠ s₀ → lex.degree (g s) ≺[lex] lex.degree (g s₀) := fun s hs hne' ↦
    lt_of_le_of_ne (hmax s hs)
      (lex.toSyn.injective.ne ((BoundedSSYT.degree_rename_toLex_flagMinorProd_injective R).ne hne'))
  have hcoeff : F.coeff (lex.degree (g s₀)) = l s₀ := by
    rw [hF_eq, coeff_sum, sum_eq_single s₀]
    · rw [coeff_smul, (s₀.2.monic_rename_toLex_flagMinorProd R).coeff_degree, smul_eq_mul, mul_one]
    · intro s hs hne'
      rw [coeff_smul, notMem_support_iff.mp fun hmem ↦ (lex.le_degree hmem).not_gt (hlt s hs hne'),
        smul_zero]
    · exact fun h ↦ absurd hs₀ h
  have hF_ne : F ≠ 0 := fun h0 ↦ Finsupp.mem_support_iff.mp hs₀ (by simp [← hcoeff, h0])
  have hdeg : lex.degree F = lex.degree (g s₀) := by
    apply lex.toSyn.injective
    refine le_antisymm ?_ (lex.le_degree (mem_support_iff.mpr (hcoeff.trans_ne
      (Finsupp.mem_support_iff.mp hs₀))))
    rw [hF_eq]
    exact lex.degree_sum_le.trans (Finset.sup_le fun s hs ↦
      lex.degree_smul_le.trans (hmax s hs))
  exact ⟨s₀, hs₀, hF_ne, hdeg, by rw [MonomialOrder.leadingCoeff, hdeg, hcoeff]⟩

/-- **Linear independence of tableau products over every commutative ring.** -/
theorem linearIndependent_flagMinorProd (R : Type*) [CommRing R] :
    LinearIndependent R
      (fun s : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) ↦
        s.2.flagMinorProd R) := by
  rw [linearIndependent_iff]
  intro l hl0
  by_contra hl
  obtain ⟨_, _, hne, _, _⟩ := exists_mem_support_degree_and_leadingCoeff_flagMinorProd hl
  exact hne (by rw [hl0, map_zero])

/-- **The standard-monomial basis of the flag-minor algebra**, over **every** commutative ring `R`,
indexed by bounded semistandard Young tableaux across all shapes `μ` with at most `n` rows. -/
noncomputable def flagMinorBasis (n : ℕ) (R : Type*) [CommRing R] :
    Module.Basis (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) R
      (flagMinorAlgebra n R) :=
  let v : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) →
      flagMinorAlgebra n R :=
    fun s ↦ ⟨s.2.flagMinorProd R, s.2.flagMinorProd_mem_flagMinorAlgebra R⟩
  Module.Basis.mk
    (LinearIndependent.of_comp (flagMinorAlgebra n R).val.toLinearMap (v := v)
      (linearIndependent_flagMinorProd R))
    fun x _ ↦ by
      have hx : (x : MvPolynomial (Fin n × Fin n) R) ∈
          Submodule.span R
            (Set.range fun s : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) ↦
              s.2.flagMinorProd R) := by
        rw [← toSubmodule_flagMinorAlgebra R]
        exact x.2
      obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hx
      refine Finsupp.mem_span_range_iff_exists_finsupp.mpr ⟨c, ?_⟩
      apply Subtype.ext
      have hval : ((c.sum fun i a ↦ a • v i : flagMinorAlgebra n R) :
          MvPolynomial (Fin n × Fin n) R) = (flagMinorAlgebra n R).val (c.sum fun i a ↦ a • v i) :=
        rfl
      rw [hval, Finsupp.sum, map_sum]
      simpa [Finsupp.sum, v] using hc

@[simp]
theorem coe_flagMinorBasis_apply (R : Type*) [CommRing R]
    (s : Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) :
    ((flagMinorBasis n R s : flagMinorAlgebra n R) : MvPolynomial (Fin n × Fin n) R) =
      s.2.flagMinorProd R := by
  simp [flagMinorBasis]

/-- `flagMinorAlgebra n R` is a free `R`-module over every commutative ring `R`. -/
instance (n : ℕ) (R : Type*) [CommRing R] : Module.Free R (flagMinorAlgebra n R) :=
  Module.Free.of_basis (flagMinorBasis n R)

private theorem sum_support_repr_flagMinorBasis {R : Type*} [CommRing R]
    (x : flagMinorAlgebra n R) :
    ∑ s ∈ ((flagMinorBasis n R).repr x).support,
      ((flagMinorBasis n R).repr x) s • flagMinorBasis n R s = x := by
  simpa [Finsupp.linearCombination_apply, Finsupp.sum] using
    (flagMinorBasis n R).linearCombination_repr x

/-! ### The fundamental column-multigrading decomposition -/

/-- The homogeneous component of `flagMinorAlgebra n R` of column multidegree `d : Fin n → ℕ` for
the indicator weights `flagColWeight c` of the columns of the generic matrix. -/
noncomputable def flagMinorColSubmodule (n : ℕ) (R : Type*) [CommRing R] (d : Fin n → ℕ) :
    Submodule R (flagMinorAlgebra n R) where
  carrier := {f | ∀ c : Fin n,
    (f : MvPolynomial (Fin n × Fin n) R).IsWeightedHomogeneous (flagColWeight c) (d c)}
  zero_mem' c := isWeightedHomogeneous_zero R (flagColWeight c) (d c)
  add_mem' hf hg c := (hf c).add (hg c)
  smul_mem' r _ hf c := by
    rw [Subalgebra.coe_smul, Algebra.smul_def, algebraMap_eq]
    exact (hf c).C_mul r

@[simp]
theorem mem_flagMinorColSubmodule_iff {R : Type*} [CommRing R] {d : Fin n → ℕ}
    {f : flagMinorAlgebra n R} :
    f ∈ flagMinorColSubmodule n R d ↔
      ∀ c : Fin n,
        (f : MvPolynomial (Fin n × Fin n) R).IsWeightedHomogeneous (flagColWeight c) (d c) :=
  Iff.rfl

instance (n : ℕ) (R : Type*) [CommRing R] :
    SetLike.GradedMonoid (flagMinorColSubmodule n R) where
  one_mem c := isWeightedHomogeneous_one R (flagColWeight c)
  mul_mem {_ _ _ _} hf hg c := (hf c).mul (hg c)

theorem flagMinorBasis_mem_flagMinorColSubmodule (R : Type*) [CommRing R]
    (s : Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) :
    flagMinorBasis n R s ∈ flagMinorColSubmodule n R (fun c ↦ s.1.1.rowLen c) := fun c ↦ by
  rw [coe_flagMinorBasis_apply]
  exact s.2.isWeightedHomogeneous_flagColWeight_flagMinorProd R c

/-- Column-multidegree components of `flagMinorAlgebra n R` are independent because polynomials of
distinct column multidegrees have disjoint monomial supports. -/
private theorem iSupIndep_flagMinorColSubmodule (R : Type*) [CommRing R] :
    iSupIndep (flagMinorColSubmodule n R) := by
  classical
  rw [iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero]
  intro s v hv hv0 d₀ hd₀
  ext1
  ext x
  simp only [ZeroMemClass.coe_zero, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
  by_cases hx : ∀ c : Fin n, Finsupp.weight (flagColWeight c) x = d₀ c
  · have h0 : ((flagMinorAlgebra n R).val (∑ d ∈ s, v d)).coeff x = 0 := by
      simp [hv0]
    rw [map_sum, coeff_sum, sum_eq_single d₀] at h0
    · exact h0
    · intro d hd hdne
      obtain ⟨c, hc⟩ := Function.ne_iff.mp hdne
      by_contra hne
      exact hc ((hv d hd c hne).symm.trans (hx c))
    · exact fun h ↦ absurd hd₀ h
  · push Not at hx
    obtain ⟨c, hc⟩ := hx
    by_contra hne
    exact hc (hv d₀ hd₀ c hne)

/-- **Fundamental-multigrading decomposition.** `flagMinorAlgebra n R` is the internal direct sum of
its column-multidegree components `flagMinorColSubmodule n R d`. -/
theorem isInternal_flagMinorColSubmodule (R : Type*) [CommRing R] :
    DirectSum.IsInternal (flagMinorColSubmodule n R) := by
  rw [DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top]
  refine ⟨iSupIndep_flagMinorColSubmodule R, eq_top_iff.mpr fun x _ ↦ ?_⟩
  rw [← sum_support_repr_flagMinorBasis x]
  exact Submodule.sum_mem _ fun s _ ↦ Submodule.mem_iSup_of_mem (fun c ↦ s.1.1.rowLen c)
    (Submodule.smul_mem _ _ (flagMinorBasis_mem_flagMinorColSubmodule R s))

private theorem sum_filter_repr_flagMinorBasis_eq {R : Type*} [CommRing R] {d : Fin n → ℕ}
    {x : flagMinorAlgebra n R} (hx : x ∈ flagMinorColSubmodule n R d) [DecidableEq (Fin n → ℕ)] :
    (∑ t ∈ ((flagMinorBasis n R).repr x).support with (fun c : Fin n ↦ t.1.1.rowLen c) = d,
        ((flagMinorBasis n R).repr x) t • flagMinorBasis n R t) = x := by
  let l := (flagMinorBasis n R).repr x
  let g : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1) → Fin n → ℕ :=
    fun t c ↦ t.1.1.rowLen c
  let A := l.support.filter fun t ↦ g t = d
  let B := l.support.filter fun t ↦ ¬ g t = d
  have hfib : (∑ t ∈ B, l t • flagMinorBasis n R t) =
      ∑ d' ∈ B.image g, ∑ t ∈ B with g t = d', l t • flagMinorBasis n R t :=
    (sum_fiberwise_of_maps_to (fun _ h ↦ mem_image_of_mem g h) _).symm
  have hsplit : x = (∑ t ∈ A, l t • flagMinorBasis n R t) +
      ∑ d' ∈ B.image g, ∑ t ∈ B with g t = d', l t • flagMinorBasis n R t := by
    rw [← hfib, sum_filter_add_sum_filter_not l.support (fun t ↦ g t = d),
      sum_support_repr_flagMinorBasis x]
  have hnotMem : d ∉ B.image g := fun hm ↦ by
    obtain ⟨t, ht, htd⟩ := mem_image.mp hm; exact (mem_filter.mp ht).2 htd
  let v : (Fin n → ℕ) → flagMinorAlgebra n R := fun d' ↦
    if d' = d then (∑ t ∈ A, l t • flagMinorBasis n R t) - x
    else ∑ t ∈ B with g t = d', l t • flagMinorBasis n R t
  have hv_sum : ∑ d' ∈ insert d (B.image g), v d' = 0 := by
    have hv_d : v d = (∑ t ∈ A, l t • flagMinorBasis n R t) - x := by simp [v]
    have hv_ne : ∀ d' ∈ B.image g, v d' = ∑ t ∈ B with g t = d', l t • flagMinorBasis n R t :=
      fun d' hd' ↦ by simp only [v, ne_of_mem_of_not_mem hd' hnotMem, ↓reduceIte]
    rw [sum_insert hnotMem, hv_d, sum_congr rfl hv_ne]
    conv_rhs => rw [← sub_self x]
    rw [hsplit]; abel
  have hv_mem : ∀ d' ∈ insert d (B.image g), v d' ∈ flagMinorColSubmodule n R d' := fun d' hd' ↦ by
    rcases mem_insert.mp hd' with rfl | hdB
    · simp only [v, ↓reduceIte]
      exact sub_mem (Submodule.sum_mem _ fun t ht ↦ (mem_filter.mp ht).2 ▸
        Submodule.smul_mem _ _ (flagMinorBasis_mem_flagMinorColSubmodule R t)) hx
    · simp only [v, ne_of_mem_of_not_mem hdB hnotMem, ↓reduceIte]
      exact Submodule.sum_mem _ fun t ht ↦ (mem_filter.mp ht).2 ▸
        Submodule.smul_mem _ _ (flagMinorBasis_mem_flagMinorColSubmodule R t)
  exact sub_eq_zero.mp <| by
    simpa [v] using (iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero _).mp
      (iSupIndep_flagMinorColSubmodule R) _ v hv_mem hv_sum d (mem_insert_self _ _)

/-- Every tableau in the `flagMinorBasis` support of a homogeneous element of column multidegree
`d` has shape multidegree `d`. -/
theorem rowLen_eq_of_mem_support_repr_flagMinorBasis {R : Type*} [CommRing R]
    {d : Fin n → ℕ} {x : flagMinorAlgebra n R} (hx : x ∈ flagMinorColSubmodule n R d)
    {s : Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.1}
    (hs : s ∈ ((flagMinorBasis n R).repr x).support) :
    (fun c : Fin n ↦ s.1.1.rowLen c) = d := by
  classical
  by_contra hsd
  have hrepr := congrArg (Finsupp.lapply (R := R) s)
    (congrArg (flagMinorBasis n R).repr (sum_filter_repr_flagMinorBasis_eq hx))
  simp only [map_sum, map_smul, Module.Basis.repr_self, Finsupp.lapply_apply] at hrepr
  rw [sum_eq_zero fun t ht ↦ by
    rw [Finsupp.single_eq_of_ne fun hst : s = t ↦ hsd (hst ▸ (mem_filter.mp ht).2),
      smul_zero]] at hrepr
  exact Finsupp.mem_support_iff.mp hs hrepr.symm

/-- **Vanishing off dominant weights.** If `d : Fin n → ℕ` is not weakly decreasing, the homogeneous
component of `flagMinorAlgebra n R` of column multidegree `d` is `⊥`. -/
theorem flagMinorColSubmodule_eq_bot_of_not_antitone (R : Type*) [CommRing R] {d : Fin n → ℕ}
    (hd : ¬ Antitone d) : flagMinorColSubmodule n R d = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  rw [Submodule.mem_bot, ← (flagMinorBasis n R).repr.map_eq_zero_iff]
  by_contra hne
  obtain ⟨s, hs⟩ := Finsupp.support_nonempty_iff.mpr hne
  refine hd ?_
  rw [← rowLen_eq_of_mem_support_repr_flagMinorBasis hx hs]
  exact fun _ _ h ↦ s.1.1.rowLen_anti _ _ h

/-- **Tableau basis of a shape component.** For a Young diagram `μ` with at most `n` rows, the
tableau products `T.flagMinorProd R` for `T : BoundedSSYT n μ` form a free `R`-module basis of the
shape-`μ` homogeneous component `flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)`. -/
noncomputable def flagMinorShapeBasis (R : Type*) [CommRing R] (μ : YoungDiagram)
    (hμ : μ.colLen 0 ≤ n) :
    Module.Basis (BoundedSSYT n μ) R (flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)) :=
  let w : BoundedSSYT n μ → flagMinorAlgebra n R := fun T ↦
    ⟨T.flagMinorProd R, T.flagMinorProd_mem_flagMinorAlgebra R⟩
  let v : BoundedSSYT n μ → flagMinorColSubmodule n R (fun c ↦ μ.rowLen c) := fun T ↦
    ⟨w T, T.isWeightedHomogeneous_flagColWeight_flagMinorProd R⟩
  have hw : LinearIndependent R w :=
    LinearIndependent.of_comp (flagMinorAlgebra n R).val.toLinearMap (v := w)
      ((linearIndependent_flagMinorProd R).comp
        (Sigma.mk (β := fun ν : {ν : YoungDiagram // ν.colLen 0 ≤ n} ↦ BoundedSSYT n ν.1) ⟨μ, hμ⟩)
        sigma_mk_injective)
  have hli : LinearIndependent R v :=
    LinearIndependent.of_comp (flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)).subtype (v := v) hw
  Module.Basis.mk hli fun x _ ↦ by
    set l := (flagMinorBasis n R).repr x.1
    have hshape : ∀ s ∈ l.support, s.1 = ⟨μ, hμ⟩ := fun s hs ↦ by
      apply Subtype.ext
      dsimp only
      rw [← YoungDiagram.ofRowLensFin_rowLen s.1.1 s.1.2, ← YoungDiagram.ofRowLensFin_rowLen μ hμ]
      simp_rw [congr_fun (rowLen_eq_of_mem_support_repr_flagMinorBasis x.2 hs)]
    have hmem : ∀ s ∈ l.support,
        l s • flagMinorBasis n R s ∈ flagMinorColSubmodule n R (fun c ↦ μ.rowLen c) :=
      fun s hs ↦ rowLen_eq_of_mem_support_repr_flagMinorBasis x.2 hs ▸
        Submodule.smul_mem _ (l s) (flagMinorBasis_mem_flagMinorColSubmodule R s)
    have hsub : x = ∑ s ∈ l.support.attach,
        (⟨l s.1 • flagMinorBasis n R s.1, hmem s.1 s.2⟩ :
          flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)) := by
      ext1
      rw [Submodule.coe_sum]
      dsimp only
      rw [sum_attach l.support fun t ↦ l t • flagMinorBasis n R t, sum_support_repr_flagMinorBasis]
    rw [hsub]
    refine Submodule.sum_mem _ fun s _ ↦ ?_
    obtain ⟨⟨ν, T⟩, hs⟩ := s
    have hν : ν = ⟨μ, hμ⟩ := hshape ⟨ν, T⟩ hs
    subst hν
    have heq : (⟨l ⟨⟨μ, hμ⟩, T⟩ • flagMinorBasis n R ⟨⟨μ, hμ⟩, T⟩,
        hmem ⟨⟨μ, hμ⟩, T⟩ hs⟩ : flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)) =
        l ⟨⟨μ, hμ⟩, T⟩ • v T := by
      ext1; ext1; simp [v, w]
    rw [heq]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨T, rfl⟩)

@[simp]
theorem coe_flagMinorShapeBasis_apply (R : Type*) [CommRing R] (μ : YoungDiagram)
    (hμ : μ.colLen 0 ≤ n) (T : BoundedSSYT n μ) :
    (((flagMinorShapeBasis R μ hμ T : flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)) :
      flagMinorAlgebra n R) : MvPolynomial (Fin n × Fin n) R) = T.flagMinorProd R := by
  simp [flagMinorShapeBasis]

end TauCeti
