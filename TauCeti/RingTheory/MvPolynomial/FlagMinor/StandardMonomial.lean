/-!
# The standard-monomial basis and fundamental multigrading of the flag-minor algebra

The **flag-minor algebra** `TauCeti.flagMinorAlgebra n R` (defined in
`TauCeti.RingTheory.MvPolynomial.FlagMinor.Basic`) is the `R`-subalgebra of `MvPolynomial
(Fin n × Fin n) R` generated by the flag minors `TauCeti.flagMinor R I` indexed by all `2 ^ n`
subsets `I ⊆ Fin n` (or equivalently by the `2 ^ n - 1` nonempty subsets, which include the full
determinant when `0 < n`; over `[Nontrivial R]`, these minors are pairwise distinct). Over an
algebraically closed field, this determinant-inclusive algebra is the invariant ring
`R[Mat_{n×n}]^U` under right upper-unitriangular action — the proper-minor multihomogeneous
Plücker coordinate ring of `GL_n / B` with an extra polynomial generator, the determinant.

Two column sets `I` and `J` of a semistandard tableau satisfy `#J ≤ #I` and have weakly increasing
sorted entries along each row (`TauCeti.FlagTableauLe I J`, from
`TauCeti.Combinatorics.Young.Columns`). Whenever `#J ≤ #I` holds and `TauCeti.FlagTableauLe I J`
fails, the shuffle Plücker relation expresses `flagMinor R I * flagMinor R J` as a `ℤ`-linear
combination of products `flagMinor R I' * flagMinor R J'` of the same sizes and total row-index sum
with strictly smaller `∑ x ∈ I', (x : ℕ)` (`TauCeti.flagMinor_mul_flagMinor_eq_sum`). Iterating on
`∑ j, (k - j) * ∑ x ∈ I j, (x : ℕ)` straightening-rewrites every product of flag minors into
tableau products `T.flagMinorProd R`.

Combined with the triangularity of their monic row-major lexicographic leading terms from
`TauCeti.RingTheory.MvPolynomial.FlagMinor.Tableau`, the tableau products `T.flagMinorProd R`, as
`(μ, T)` ranges over shapes `μ` with `μ.colLen 0 ≤ n` and `T : BoundedSSYT n μ`, form a free
`R`-module basis of `flagMinorAlgebra n R` over **every** commutative ring `R`
(`TauCeti.flagMinorBasis`). Using the column-multidegree components `TauCeti.flagMinorColSubmodule`
(from `TauCeti.RingTheory.MvPolynomial.FlagMinor.Homogeneous`), `flagMinorAlgebra n R` decomposes
into an internal direct sum (`TauCeti.isInternal_flagMinorColSubmodule`), vanishing off antitone
weights and having basis `BoundedSSYT n μ` in shape degree `c ↦ μ.rowLen c`
(`TauCeti.flagMinorShapeBasis`).

## Main definitions

* `TauCeti.flagMinorBasis n R`: standard-monomial `R`-basis of `flagMinorAlgebra n R`.
* `TauCeti.flagMinorShapeBasis R μ hμ`: tableau `R`-basis of the shape-`μ` component.

## Main results

* `TauCeti.flagMinor_mul_flagMinor_eq_sum`: quadratic shuffle Plücker straightening of flag minors.
* `TauCeti.toSubmodule_flagMinorAlgebra` and `TauCeti.linearIndependent_flagMinorProd`: spanning
  and `R`-linear independence of tableau products over every `CommRing R`.
* `TauCeti.exists_mem_support_degree_and_leadingCoeff_flagMinorProd`: a nonzero coefficient vector
  `l ≠ 0` gives a supported tableau whose linear combination of tableau products is nonzero, with
  matching leading exponent and leading coefficient.
* `TauCeti.isInternal_flagMinorColSubmodule` and
  `TauCeti.flagMinorColSubmodule_eq_bot_of_not_antitone`: fundamental-multigrading decomposition.

## References

* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 14, Theorem 14.6 and Theorem 14.11.
* W. Fulton, *Young Tableaux*, LMSST 35, Cambridge University Press, 1997, §9.1.
* C. De Concini, D. Eisenbud, and C. Procesi, *Young diagrams and determinantal varieties*,
  Invent. Math. **56** (1980), 129-165.
-/

public section

namespace TauCeti

open Finset MvPolynomial MonomialOrder

variable {n : ℕ}

/-! ### Quadratic shuffle Plücker straightening -/

/-- Each non-identity shuffle term in the quadratic Plücker identity lies in the `ℤ`-span of the
strictly smaller-weight minor products. -/
private theorem shuffle_term_mem_span (R : Type*) [CommRing R] {I J : Finset (Fin n)}
    (hJI : #J ≤ #I) {p₀ : Fin #J}
    (hp₀ : J.orderEmbOfFin rfl p₀ < I.orderEmbOfFin rfl (Fin.castLE hJI p₀))
    {ι₁ κ₁ ι₂ κ₂ : Type} [LinearOrder κ₁] [Fintype κ₁] [LinearOrder κ₂] [Fintype κ₂]
    [DecidableEq (κ₁ ⊕ κ₂)] [Finite ι₁] [Finite ι₂]
    (e₁ : Fin #I ≃ ι₁ ⊕ κ₁) (e₂ : Fin #J ≃ ι₂ ⊕ κ₂)
    (α : ι₁ → Fin n) (β : ι₂ → Fin n) (γ : κ₁ ⊕ κ₂ → Fin n)
    (he₁ : Sum.elim α (γ ∘ Sum.inl) ∘ e₁ = I.orderEmbOfFin rfl)
    (he₂ : Sum.elim β (γ ∘ Sum.inr) ∘ e₂ = J.orderEmbOfFin rfl)
    (hγ₁ : StrictMono (γ ∘ Sum.inl)) (hγ₂ : StrictMono (γ ∘ Sum.inr))
    (hκ₁_ge : ∀ x : κ₁, I.orderEmbOfFin rfl (Fin.castLE hJI p₀) ≤ γ (.inl x))
    (hκ₂_le : ∀ y : κ₂, γ (.inr y) ≤ J.orderEmbOfFin rfl p₀)
    {S : Finset (Finset (Fin n) × Finset (Fin n))}
    (hS : ∀ P : Finset (Fin n) × Finset (Fin n), #P.1 = #I → #P.2 = #J →
      (∑ x ∈ P.1, (x : ℕ)) + (∑ y ∈ P.2, (y : ℕ)) =
        (∑ x ∈ I, (x : ℕ)) + (∑ y ∈ J, (y : ℕ)) →
      (∑ x ∈ P.1, (x : ℕ)) < ∑ x ∈ I, (x : ℕ) → P ∈ S)
    {σ : Equiv.Perm (κ₁ ⊕ κ₂)}
    (hσ₁ : StrictMono (γ ∘ σ ∘ Sum.inl)) (hσ₂ : StrictMono (γ ∘ σ ∘ Sum.inr))
    (hσne : σ ≠ 1) :
    -(Equiv.Perm.sign σ •
        (Matrix.mvPolynomialMinor R (Sum.elim α (γ ∘ σ ∘ Sum.inl) ∘ e₁)
            (Fin.castLE (card_finset_fin_le I)) *
          Matrix.mvPolynomialMinor R (Sum.elim β (γ ∘ σ ∘ Sum.inr) ∘ e₂)
            (Fin.castLE (card_finset_fin_le J)))) ∈
      Submodule.span ℤ
        ((fun P : Finset (Fin n) × Finset (Fin n) ↦ flagMinor R P.1 * flagMinor R P.2) '' S) := by
  classical
  cases nonempty_fintype ι₁; cases nonempty_fintype ι₂
  set u₁ := Sum.elim α (γ ∘ σ ∘ Sum.inl) ∘ e₁
  set u₂ := Sum.elim β (γ ∘ σ ∘ Sum.inr) ∘ e₂
  rcases mvPolynomialMinor_eq_zero_or_sign_smul_flagMinor R (card_finset_fin_le I) u₁ with
    h0 | ⟨hu₁, s₁, hs₁⟩
  · simp [h0]
  rcases mvPolynomialMinor_eq_zero_or_sign_smul_flagMinor R (card_finset_fin_le J) u₂ with
    h0 | ⟨hu₂, s₂, hs₂⟩
  · simp [h0]
  have hlt := Equiv.Perm.sum_comp_inl_lt_of_strictMono_of_ne_one hγ₁ hγ₂
    (g := fun z ↦ (γ z : ℕ)) (Fin.lt_def.mp hp₀)
    (fun x ↦ Fin.le_def.mp (hκ₁_ge x)) (fun y ↦ Fin.le_def.mp (hκ₂_le y)) hσ₁ hσ₂ hσne
  have himg (K : Finset (Fin n)) : univ.image (K.orderEmbOfFin rfl) = K := by
    rw [← Finset.coe_inj, coe_image, coe_univ, Set.image_univ, range_orderEmbOfFin]
  have hr₁ := Fintype.sum_image_sum_elim_comp Fin.val e₁ α (γ ∘ Sum.inl)
    (he₁.symm ▸ (I.orderEmbOfFin rfl).injective)
  have hr₂ := Fintype.sum_image_sum_elim_comp Fin.val e₂ β (γ ∘ Sum.inr)
    (he₂.symm ▸ (J.orderEmbOfFin rfl).injective)
  have hu₁_sum := Fintype.sum_image_sum_elim_comp Fin.val e₁ α (γ ∘ σ ∘ Sum.inl) hu₁
  have hu₂_sum := Fintype.sum_image_sum_elim_comp Fin.val e₂ β (γ ∘ σ ∘ Sum.inr) hu₂
  rw [he₁, himg I] at hr₁; rw [he₂, himg J] at hr₂
  dsimp only [Function.comp_apply] at hu₁_sum hu₂_sum hr₁ hr₂
  have hsum : (∑ x ∈ univ.image u₁, (x : ℕ)) + ∑ y ∈ univ.image u₂, (y : ℕ) =
      (∑ x ∈ I, (x : ℕ)) + ∑ y ∈ J, (y : ℕ) := by
    rw [hu₁_sum, hu₂_sum, hr₁, hr₂, add_add_add_comm,
      Equiv.Perm.sum_comp_inl_add_sum_comp_inr (fun z ↦ (γ z : ℕ)) σ, add_add_add_comm]
  rw [hs₁, hs₂, Units.smul_def, smul_mul_smul_comm, smul_smul]
  exact Submodule.neg_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span
    ⟨(univ.image u₁, univ.image u₂), hS _
      ((card_image_of_injective univ hu₁).trans (Fintype.card_fin #I))
      ((card_image_of_injective univ hu₂).trans (Fintype.card_fin #J))
      hsum (by rw [hu₁_sum, hr₁]; exact add_lt_add_right hlt _), rfl⟩))

/-- The shuffles preserving increasing order on each summand form a complement to the subgroup
`sumCongrHom.range` of blockwise permutations. -/
private theorem orderedShuffles_isComplement {I J : Finset (Fin n)} (hJI : #J ≤ #I) {p₀ : Fin #J}
    (hp₀ : J.orderEmbOfFin rfl p₀ < I.orderEmbOfFin rfl (Fin.castLE hJI p₀))
    (p₁ : Fin #I → Prop) (p₂ : Fin #J → Prop)
    [DecidablePred p₁] [DecidablePred p₂]
    (hκ₁_ge : ∀ x : {b // ¬ p₁ b},
      I.orderEmbOfFin rfl (Fin.castLE hJI p₀) ≤ I.orderEmbOfFin rfl x.val)
    (hκ₂_le : ∀ y : {a // ¬ p₂ a}, J.orderEmbOfFin rfl y.val ≤ J.orderEmbOfFin rfl p₀) :
    let γ : {b // ¬ p₁ b} ⊕ {a // ¬ p₂ a} → Fin n :=
      Sum.elim (fun b ↦ I.orderEmbOfFin rfl b.val) (fun a ↦ J.orderEmbOfFin rfl a.val)
    let T := univ.filter fun σ : Equiv.Perm ({b // ¬ p₁ b} ⊕ {a // ¬ p₂ a}) ↦
      StrictMono (γ ∘ σ ∘ Sum.inl) ∧ StrictMono (γ ∘ σ ∘ Sum.inr)
    Subgroup.IsComplement (T : Set (Equiv.Perm ({b // ¬ p₁ b} ⊕ {a // ¬ p₂ a})))
      ((Equiv.Perm.sumCongrHom {b // ¬ p₁ b} {a // ¬ p₂ a}).range : Set _) := by
  intro γ T
  have hγ_inj : Function.Injective γ := by
    rintro (x₁ | y₁) (x₂ | y₂) h
    · exact congrArg Sum.inl (Subtype.ext ((I.orderEmbOfFin rfl).injective h))
    · exact absurd h (lt_of_le_of_lt (hκ₂_le y₂) (hp₀.trans_le (hκ₁_ge x₁))).ne'
    · exact absurd h (lt_of_le_of_lt (hκ₂_le y₁) (hp₀.trans_le (hκ₁_ge x₂))).ne
    · exact congrArg Sum.inr (Subtype.ext ((J.orderEmbOfFin rfl).injective h))
  exact (show (T : Set (Equiv.Perm ({b // ¬ p₁ b} ⊕ {a // ¬ p₂ a}))) =
      {σ : Equiv.Perm _ | StrictMono (γ ∘ σ ∘ Sum.inl) ∧ StrictMono (γ ∘ σ ∘ Sum.inr)} from by
    ext; simp [T]) ▸ Equiv.Perm.isComplement_setOf_strictMono_sumCongrHom_range hγ_inj

/-- The `σ = 1` summand in the Sylvester shuffle identity equals `flagMinor R I * flagMinor R J`. -/
private theorem identity_shuffle_term_eq (R : Type*) [CommRing R] {I J : Finset (Fin n)}
    (hJI : #J ≤ #I) {ι₁ κ₁ ι₂ κ₂ : Type} [Fintype κ₁] [Fintype κ₂] [DecidableEq (κ₁ ⊕ κ₂)]
    (e₁ : Fin #I ≃ ι₁ ⊕ κ₁) (e₂ : Fin #J ≃ ι₂ ⊕ κ₂)
    (α : ι₁ → Fin n) (β : ι₂ → Fin n) (γ : κ₁ ⊕ κ₂ → Fin n)
    (hu₁ : Sum.elim α (γ ∘ Sum.inl) ∘ e₁ = I.orderEmbOfFin rfl)
    (hu₂ : Sum.elim β (γ ∘ Sum.inr) ∘ e₂ = J.orderEmbOfFin rfl) :
    Equiv.Perm.sign (1 : Equiv.Perm (κ₁ ⊕ κ₂)) •
        (Matrix.mvPolynomialMinor R
            (Sum.elim α (γ ∘ (1 : Equiv.Perm (κ₁ ⊕ κ₂)) ∘ Sum.inl) ∘ e₁)
            (Fin.castLE (card_finset_fin_le I) ∘ id) *
          Matrix.mvPolynomialMinor R
            (Sum.elim β (γ ∘ (1 : Equiv.Perm (κ₁ ⊕ κ₂)) ∘ Sum.inr) ∘ e₂)
            (Fin.castLE (card_finset_fin_le I) ∘ Fin.castLE hJI)) =
      flagMinor R I * flagMinor R J := by
  have hcast : Fin.castLE (card_finset_fin_le I) ∘ Fin.castLE hJI =
      Fin.castLE (card_finset_fin_le J) := funext fun _ ↦ Fin.ext rfl
  rw [Equiv.Perm.sign_one, one_smul, Equiv.Perm.coe_one, Function.id_comp, Function.id_comp,
    hu₁, hu₂, Function.comp_id, hcast, ← flagMinor_def, ← flagMinor_def]

/-- **Quadratic shuffle straightening of flag minors.** Whenever `#J ≤ #I` and
`¬ FlagTableauLe I J`, `flagMinor R I * flagMinor R J` is a `ℤ`-linear combination of products
`flagMinor R I' * flagMinor R J'` with `#I' = #I`, `#J' = #J`, the same total row-index sum, and
strictly smaller first-factor row-index sum `∑ x ∈ I', (x : ℕ) < ∑ x ∈ I, (x : ℕ)`. -/
theorem flagMinor_mul_flagMinor_eq_sum (R : Type*) [CommRing R] {I J : Finset (Fin n)}
    (hJI : #J ≤ #I) (hnot : ¬ FlagTableauLe I J) :
    let S := univ.filter fun P : Finset (Fin n) × Finset (Fin n) ↦
      #P.1 = #I ∧ #P.2 = #J ∧
        (∑ x ∈ P.1, (x : ℕ)) + (∑ y ∈ P.2, (y : ℕ)) =
          (∑ x ∈ I, (x : ℕ)) + (∑ y ∈ J, (y : ℕ)) ∧
        (∑ x ∈ P.1, (x : ℕ)) < ∑ x ∈ I, (x : ℕ)
    ∃ c : Finset (Fin n) × Finset (Fin n) → ℤ,
      flagMinor R I * flagMinor R J =
        ∑ P ∈ S, c P • (flagMinor R P.1 * flagMinor R P.2) := by
  classical
  intro S
  suffices hmem : flagMinor R I * flagMinor R J ∈ Submodule.span ℤ
      ((fun P : Finset (Fin n) × Finset (Fin n) ↦ flagMinor R P.1 * flagMinor R P.2) '' S) by
    obtain ⟨l, hlS, hlc⟩ := (Finsupp.mem_span_image_iff_linearCombination ℤ).mp hmem
    refine ⟨l, ?_⟩
    rw [← hlc, Finsupp.linearCombination_apply]
    exact Finsupp.sum_of_support_subset l (Finset.coe_subset.mp hlS) _ fun _ _ ↦ zero_smul _ _
  obtain ⟨p₀, hp₀⟩ : ∃ p₀ : Fin #J,
      J.orderEmbOfFin rfl p₀ < I.orderEmbOfFin rfl (Fin.castLE hJI p₀) := by
    by_contra! h; exact hnot (flagTableauLe_def.mpr ⟨hJI, h⟩)
  set r₁ := I.orderEmbOfFin rfl; set r₂ := J.orderEmbOfFin rfl
  let p₁ : Fin #I → Prop := fun b ↦ b.val < p₀.val; let p₂ : Fin #J → Prop := fun a ↦ p₀.val < a.val
  let e₁ := (Equiv.sumCompl p₁).symm; let e₂ := (Equiv.sumCompl p₂).symm
  let α : {b // p₁ b} → Fin n := fun b ↦ r₁ b.val
  let β : {a // p₂ a} → Fin n := fun a ↦ r₂ a.val
  let γ : {b // ¬ p₁ b} ⊕ {a // ¬ p₂ a} → Fin n :=
    Sum.elim (fun b ↦ r₁ b.val) (fun a ↦ r₂ a.val)
  let T := univ.filter fun σ : Equiv.Perm ({b // ¬ p₁ b} ⊕ {a // ¬ p₂ a}) ↦
    StrictMono (γ ∘ σ ∘ Sum.inl) ∧ StrictMono (γ ∘ σ ∘ Sum.inr)
  have hκ₁_ge (x : {b // ¬ p₁ b}) : r₁ (Fin.castLE hJI p₀) ≤ γ (.inl x) :=
    r₁.monotone (Fin.le_def.mpr (not_lt.mp x.property))
  have hκ₂_le (y : {a // ¬ p₂ a}) : γ (.inr y) ≤ r₂ p₀ :=
    r₂.monotone (Fin.le_def.mpr (not_lt.mp y.property))
  have hrel := Matrix.sum_sign_smul_mvPolynomialMinor_comp_mul_mvPolynomialMinor_comp_eq_zero R
    (Fin.castLE (card_finset_fin_le I)) id (Fin.castLE hJI) e₁ e₂ α β γ
    (Fin.card_lt_add_card_compl p₀) (orderedShuffles_isComplement hJI hp₀ p₁ p₂ hκ₁_ge hκ₂_le)
  have hu₁_one : Sum.elim α (γ ∘ Sum.inl) ∘ e₁ = r₁ :=
    funext fun b ↦ by by_cases hb : p₁ b <;> simp [e₁, hb, α, γ]
  have hu₂_one : Sum.elim β (γ ∘ Sum.inr) ∘ e₂ = r₂ :=
    funext fun a ↦ by by_cases ha : p₂ a <;> simp [e₂, ha, β, γ]
  have h1T : (1 : Equiv.Perm ({b // ¬ p₁ b} ⊕ {a // ¬ p₂ a})) ∈ T :=
    mem_filter.mpr ⟨mem_univ _, fun _ _ h ↦ r₁.strictMono h, fun _ _ h ↦ r₂.strictMono h⟩
  rw [← add_sum_erase _ _ h1T,
    identity_shuffle_term_eq R hJI e₁ e₂ α β γ hu₁_one hu₂_one,
    add_eq_zero_iff_eq_neg, ← sum_neg_distrib] at hrel
  rw [hrel]
  refine Submodule.sum_mem _ fun σ hσ ↦ ?_
  obtain ⟨hσ1, hσT⟩ := mem_erase.mp hσ; obtain ⟨_, hσ_inl, hσ_inr⟩ := mem_filter.mp hσT
  exact shuffle_term_mem_span R hJI hp₀ e₁ e₂ α β γ hu₁_one hu₂_one
    (fun _ _ h ↦ r₁.strictMono h) (fun _ _ h ↦ r₂.strictMono h)
    hκ₁_ge hκ₂_le (fun P h₁ h₂ h₃ h₄ ↦ mem_filter.mpr ⟨mem_univ _, h₁, h₂, h₃, h₄⟩)
    hσ_inl hσ_inr hσ1

/-! ### Multi-factor straightening and the standard-monomial basis -/

/-- Weighted row-sum measure for straightening a decreasing-size tuple of flag minors. -/
private def straightenWeight {k : ℕ} (I : Fin k → Finset (Fin n)) : ℕ :=
  ∑ j : Fin k, (k - j.val) * ∑ x ∈ I j, (x : ℕ)

private theorem straightenWeight_split {k : ℕ} (K : Fin k → Finset (Fin n))
    {j₀ j₁ : Fin k} (hj₀₁ : j₀ ≠ j₁) :
    straightenWeight K =
      (k - j₀.val) * (∑ x ∈ K j₀, (x : ℕ)) + ((k - j₁.val) * (∑ x ∈ K j₁, (x : ℕ)) +
        ∑ m ∈ (univ.erase j₀).erase j₁, (k - m.val) * ∑ x ∈ K m, (x : ℕ)) := by
  rw [straightenWeight, ← add_sum_erase _ _ (mem_univ j₀),
    ← add_sum_erase _ _ (mem_erase.mpr ⟨hj₀₁.symm, mem_univ j₁⟩)]

private theorem prod_flagMinor_split (R : Type*) [CommRing R] {k : ℕ}
    (K : Fin k → Finset (Fin n)) {j₀ j₁ : Fin k} (hj₀₁ : j₀ ≠ j₁) :
    (∏ m : Fin k, flagMinor R (K m)) =
      (flagMinor R (K j₀) * flagMinor R (K j₁)) *
        ∏ m ∈ (univ.erase j₀).erase j₁, flagMinor R (K m) := by
  conv_rhs => rw [mul_assoc, mul_prod_erase (univ.erase j₀) (fun m ↦ flagMinor R (K m))
    (mem_erase.mpr ⟨hj₀₁.symm, mem_univ j₁⟩),
    mul_prod_erase univ (fun m ↦ flagMinor R (K m)) (mem_univ j₀)]

private theorem doubleUpdate_erase_spec {k : ℕ} (I : Fin k → Finset (Fin n))
    {j₀ j₁ : Fin k} (hj₀₁ : j₀ ≠ j₁) (P₁ P₂ : Finset (Fin n)) :
    Function.update (Function.update I j₀ P₁) j₁ P₂ j₀ = P₁ ∧
      Function.update (Function.update I j₀ P₁) j₁ P₂ j₁ = P₂ ∧
      ∀ m ∈ (univ.erase j₀).erase j₁,
        Function.update (Function.update I j₀ P₁) j₁ P₂ m = I m := by
  refine ⟨by simp [hj₀₁], by simp, fun m hm ↦ ?_⟩
  obtain ⟨hm₁, hm₀⟩ := mem_erase.mp hm; simp [hm₁, (mem_erase.mp hm₀).1]

/-- Replacing an adjacent non-standard pair `(I j₀, I j₁)` by `(P.1, P.2)` with the same total row
sum and strictly smaller first-factor row sum strictly decreases `straightenWeight`. -/
private theorem straightenWeight_update_lt {k j : ℕ} (hj : j + 1 < k)
    (I : Fin k → Finset (Fin n)) {P : Finset (Fin n) × Finset (Fin n)}
    (hPsum : (∑ x ∈ P.1, (x : ℕ)) + (∑ y ∈ P.2, (y : ℕ)) =
      (∑ x ∈ I ⟨j, Nat.lt_of_succ_lt hj⟩, (x : ℕ)) + ∑ y ∈ I ⟨j + 1, hj⟩, (y : ℕ))
    (hPlt : (∑ x ∈ P.1, (x : ℕ)) < ∑ x ∈ I ⟨j, Nat.lt_of_succ_lt hj⟩, (x : ℕ)) :
    straightenWeight
      (Function.update (Function.update I ⟨j, Nat.lt_of_succ_lt hj⟩ P.1) ⟨j + 1, hj⟩ P.2) <
      straightenWeight I := by
  let j₀ : Fin k := ⟨j, Nat.lt_of_succ_lt hj⟩; let j₁ : Fin k := ⟨j + 1, hj⟩
  have hj₀₁ : j₀ ≠ j₁ := by simp [j₀, j₁, Fin.ext_iff]
  obtain ⟨hJ₀, hJ₁, hJ_other⟩ := doubleUpdate_erase_spec I hj₀₁ P.1 P.2
  set J : Fin k → Finset (Fin n) := Function.update (Function.update I j₀ P.1) j₁ P.2
  have heq_rest :
      (∑ m ∈ (univ.erase j₀).erase j₁, (k - m.val) * ∑ x ∈ J m, (x : ℕ)) =
        ∑ m ∈ (univ.erase j₀).erase j₁, (k - m.val) * ∑ x ∈ I m, (x : ℕ) :=
    sum_congr rfl fun m hm ↦ by rw [hJ_other m hm]
  rw [straightenWeight_split J hj₀₁, straightenWeight_split I hj₀₁, hJ₀, hJ₁, heq_rest]
  simp only [j₀, j₁]
  have hmul := congrArg ((k - (j + 1)) * ·) hPsum; rw [mul_add, mul_add] at hmul
  have hkj : k - j = k - (j + 1) + 1 := by omega
  rw [hkj, add_one_mul, add_one_mul]; omega

/-- Every product of nonempty flag minors sorted by decreasing size lies in the `R`-span of the
tableau products `s.2.flagMinorProd R`. -/
private theorem prod_flagMinor_mem_span_of_antitone (R : Type*) [CommRing R] {k : ℕ} :
    ∀ (W : ℕ) (I : Fin k → Finset (Fin n)),
      straightenWeight I = W →
      (∀ m, (I m).Nonempty) →
      Antitone (fun m : Fin k ↦ #(I m)) →
      (∏ m : Fin k, flagMinor R (I m)) ∈
        Submodule.span R
          (Set.range fun s : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) ↦
            s.2.flagMinorProd R) := by
  intro W; induction W using Nat.strong_induction_on with
  | ind W ih =>
    intro I hW hne hanti
    by_cases hchain : ∀ (j : ℕ) (hj : j + 1 < k),
        FlagTableauLe (I ⟨j, Nat.lt_of_succ_lt hj⟩) (I ⟨j + 1, hj⟩)
    · obtain ⟨μ, T, -, -, hT⟩ := exists_boundedSSYT_flagMinorProd_eq R I hne fun _ _ hm ↦
        flagTableauLe_of_adjacent hchain hm
      exact hT ▸ Submodule.subset_span ⟨⟨μ, T⟩, rfl⟩
    · push Not at hchain; obtain ⟨j, hj, hnot⟩ := hchain
      let j₀ : Fin k := ⟨j, Nat.lt_of_succ_lt hj⟩; let j₁ : Fin k := ⟨j + 1, hj⟩
      have hj₀₁ : j₀ ≠ j₁ := by simp [j₀, j₁, Fin.ext_iff]
      obtain ⟨c, hc⟩ := flagMinor_mul_flagMinor_eq_sum R
        (hanti (Fin.le_def.mpr (Nat.le_succ j))) hnot
      rw [prod_flagMinor_split R I hj₀₁, hc, sum_mul]
      refine Submodule.sum_mem _ fun P hP ↦ ?_
      obtain ⟨_, hP₁, hP₂, hPsum, hPlt⟩ := mem_filter.mp hP
      obtain ⟨hJ₀, hJ₁, hJother⟩ := doubleUpdate_erase_spec I hj₀₁ P.1 P.2
      set J : Fin k → Finset (Fin n) := Function.update (Function.update I j₀ P.1) j₁ P.2
      have hJcard (m : Fin k) : #(J m) = #(I m) := by
        by_cases hm₁ : m = j₁ <;> by_cases hm₀ : m = j₀ <;>
          simp [J, j₀, j₁, hm₁, hm₀, hj₀₁, hP₁, hP₂]
      have hprod : (∏ m : Fin k, flagMinor R (J m)) =
          (flagMinor R P.1 * flagMinor R P.2) *
            ∏ m ∈ (univ.erase j₀).erase j₁, flagMinor R (I m) := by
        rw [prod_flagMinor_split R J hj₀₁, hJ₀, hJ₁]
        exact congrArg _ (prod_congr rfl fun m hm ↦ congrArg (flagMinor R) (hJother m hm))
      rw [smul_mul_assoc, ← hprod]
      exact zsmul_mem (ih (straightenWeight J)
        (hW ▸ straightenWeight_update_lt hj I hPsum hPlt) J rfl
        (fun m ↦ card_pos.mp ((hne m).card_pos.trans_eq (hJcard m).symm))
        (fun _ _ hm ↦ by simpa only [hJcard] using hanti hm)) (c P)

/-- Every finite product of flag minors lies in the `R`-linear span of the tableau products
`s.2.flagMinorProd R`. -/
theorem prod_flagMinor_mem_span_flagMinorProd (R : Type*) [CommRing R]
    (L : List (Finset (Fin n))) :
    (L.map (flagMinor R)).prod ∈
      Submodule.span R
        (Set.range fun s : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) ↦
          s.2.flagMinorProd R) := by
  have hfilter : ((L.filter fun I ↦ decide I.Nonempty).map (flagMinor R)).prod =
      (L.map (flagMinor R)).prod := by
    induction L with
    | nil => rfl
    | cons I _ ih => rcases I.eq_empty_or_nonempty with rfl | hne <;> simp [*]
  rw [← hfilter]
  set L₁ := L.filter fun I ↦ decide I.Nonempty
  let L₂ := L₁.mergeSort (fun A B : Finset (Fin n) ↦ decide (#B ≤ #A))
  have hsorted : L₂.Pairwise (fun A B ↦ #B ≤ #A) :=
    (L₁.pairwise_mergeSort (le := fun A B : Finset (Fin n) ↦ decide (#B ≤ #A))
      (fun _ _ _ h₁ h₂ ↦ decide_eq_true (le_trans (of_decide_eq_true h₂) (of_decide_eq_true h₁)))
      (fun A B ↦ by obtain h | h := le_total #B #A <;> simp [h])).imp fun h ↦ of_decide_eq_true h
  let I : Fin L₂.length → Finset (Fin n) := fun m ↦ L₂[m.val]
  have hL₂_prod : (L₂.map (flagMinor R)).prod = ∏ m : Fin L₂.length, flagMinor R (I m) := by
    conv_lhs => rw [← List.ofFn_getElem (xs := L₂), List.map_ofFn, List.prod_ofFn]
    rfl
  rw [((L₁.mergeSort_perm _).map (flagMinor R)).prod_eq.symm, hL₂_prod]
  exact prod_flagMinor_mem_span_of_antitone R (straightenWeight I) I rfl
    (fun m ↦ by simpa [L₁] using (List.mem_filter.mp ((L₁.mergeSort_perm _).subset
      (List.getElem_mem m.isLt))).2)
    fun m₁ m₂ hm ↦ hm.eq_or_lt.elim (fun h ↦ h ▸ le_rfl)
      (List.pairwise_iff_getElem.mp hsorted m₁.val m₂.val m₁.isLt m₂.isLt)

/-- **Spanning theorem.** As an `R`-submodule, `flagMinorAlgebra n R` is spanned by the tableau
products `s.2.flagMinorProd R` over all shapes `μ` with at most `n` rows and all
`T : BoundedSSYT n μ`. -/
theorem toSubmodule_flagMinorAlgebra (R : Type*) [CommRing R] :
    Subalgebra.toSubmodule (flagMinorAlgebra n R) =
      Submodule.span R
        (Set.range fun s : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) ↦
          s.2.flagMinorProd R) := by
  refine le_antisymm ?_ (Submodule.span_le.mpr fun _ ⟨s, h⟩ ↦
    h ▸ s.2.flagMinorProd_mem_flagMinorAlgebra R)
  rw [flagMinorAlgebra_def, Algebra.adjoin_eq_span]
  refine Submodule.span_le.mpr fun p hp ↦ ?_
  obtain ⟨L, hL, rfl⟩ := Submonoid.exists_list_of_mem_closure hp
  choose f hf using fun x (hx : x ∈ L) ↦ hL x hx
  have hL_eq : L = (L.attach.map fun x ↦ f x.val x.property).map (flagMinor R) := by
    conv_lhs => rw [← List.attach_map_subtype_val L]
    rw [List.map_map]; exact List.map_congr_left fun x _ ↦ (hf x.val x.property).symm
  exact hL_eq ▸ prod_flagMinor_mem_span_flagMinorProd R _

/-! ### Triangularity, linear independence, and `flagMinorBasis` -/

/-- **Exact leading data of linear combinations of tableau products.** Over **every** commutative
ring `R`, a nonzero coefficient vector `l ≠ 0` yields a supported tableau `s₀ ∈ l.support` such
that the `R`-linear combination of tableau products `s.2.flagMinorProd R` is nonzero, with
row-major lexicographic leading exponent equal to that of `s₀.2.flagMinorProd R` and leading
coefficient `l s₀`. -/
theorem exists_mem_support_degree_and_leadingCoeff_flagMinorProd {R : Type*} [CommRing R]
    {l : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) →₀ R}
    (hl : l ≠ 0) :
    ∃ s₀ ∈ l.support,
      rename toLex (Finsupp.linearCombination R (fun s ↦ s.2.flagMinorProd R) l) ≠ 0 ∧
      lex.degree (rename toLex (Finsupp.linearCombination R (fun s ↦ s.2.flagMinorProd R) l)) =
        lex.degree (rename toLex (s₀.2.flagMinorProd R)) ∧
      lex.leadingCoeff
          (rename toLex (Finsupp.linearCombination R (fun s ↦ s.2.flagMinorProd R) l)) =
        l s₀ := by
  have hne : l.support.Nonempty := Finsupp.support_nonempty_iff.mpr hl
  have : Nontrivial R := let ⟨s, hs⟩ := hne; ⟨⟨l s, 0, Finsupp.mem_support_iff.mp hs⟩⟩
  set g : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) →
      MvPolynomial (Fin n ×ₗ Fin n) R := fun s ↦ rename toLex (s.2.flagMinorProd R)
  obtain ⟨s₀, hs₀, hmax⟩ := exists_max_image l.support (fun s ↦ lex.toSyn (lex.degree (g s))) hne
  have hs₀_ne : l s₀ ≠ 0 := Finsupp.mem_support_iff.mp hs₀
  have hs₀_monic : lex.Monic (g s₀) := s₀.2.monic_rename_toLex_flagMinorProd R
  have hsum := lex.degree_sum_eq_and_leadingCoeff_sum_eq (s := l.support)
    (f := fun s ↦ l s • g s) hs₀
    (fun h0 ↦ hs₀_ne (by simpa [hs₀_monic.leadingCoeff_smul] using congrArg lex.leadingCoeff h0))
    fun s hs hne' ↦ by
      by_cases hs0 : l s = 0
      · exact Or.inl (by simp [hs0])
      · right; rw [(s.2.monic_rename_toLex_flagMinorProd R).degree_smul hs0,
          hs₀_monic.degree_smul hs₀_ne]
        exact lt_of_le_of_ne (hmax s hs) <| lex.toSyn.injective.ne <|
          (BoundedSSYT.degree_rename_toLex_flagMinorProd_injective R).ne hne'
  have hF : rename toLex (Finsupp.linearCombination R (fun s ↦ s.2.flagMinorProd R) l) =
      ∑ s ∈ l.support, l s • g s := by
    simp [g, Finsupp.linearCombination_apply, Finsupp.sum, map_sum]
  exact ⟨s₀, hs₀, by simpa only [← hF, hs₀_monic.degree_smul hs₀_ne,
    hs₀_monic.leadingCoeff_smul] using hsum⟩

/-- **Linear independence of tableau products over every commutative ring.** -/
theorem linearIndependent_flagMinorProd (R : Type*) [CommRing R] :
    LinearIndependent R
      (fun s : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) ↦
        s.2.flagMinorProd R) :=
  linearIndependent_iff.mpr fun l hl0 ↦ by_contra fun hl ↦
    let ⟨_, _, hne, _, _⟩ := exists_mem_support_degree_and_leadingCoeff_flagMinorProd hl
    hne (by rw [hl0, map_zero])

/-- **The standard-monomial basis of the flag-minor algebra**, over **every** commutative ring `R`,
indexed by bounded semistandard Young tableaux across all shapes `μ` with at most `n` rows. -/
noncomputable def flagMinorBasis (n : ℕ) (R : Type*) [CommRing R] :
    Module.Basis (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) R
      (flagMinorAlgebra n R) :=
  let v : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) →
      flagMinorAlgebra n R :=
    fun s ↦ ⟨s.2.flagMinorProd R, s.2.flagMinorProd_mem_flagMinorAlgebra R⟩
  Module.Basis.mk
    (LinearIndependent.of_comp (flagMinorAlgebra n R).val.toLinearMap (v := v)
      (linearIndependent_flagMinorProd R))
    fun x _ ↦ by
      have hmap : (Submodule.span R (Set.range v)).map (flagMinorAlgebra n R).val.toLinearMap =
          Subalgebra.toSubmodule (flagMinorAlgebra n R) := by
        rw [Submodule.map_span, ← Set.range_comp, toSubmodule_flagMinorAlgebra R]; rfl
      obtain ⟨y, hy, hyx⟩ := Submodule.mem_map.mp (hmap.symm.le x.property)
      exact Subtype.ext hyx ▸ hy

@[simp]
theorem coe_flagMinorBasis_apply (R : Type*) [CommRing R]
    (s : Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) :
    ((flagMinorBasis n R s : flagMinorAlgebra n R) : MvPolynomial (Fin n × Fin n) R) =
      s.2.flagMinorProd R := by
  simp [flagMinorBasis]

/-- Every element of `flagMinorAlgebra n R` expands in `MvPolynomial (Fin n × Fin n) R` as the sum
over its `flagMinorBasis` support of the tableau products `s.2.flagMinorProd R` scaled by its basis
coordinates. -/
theorem flagMinorBasis_repr_sum_eq {R : Type*} [CommRing R] (x : flagMinorAlgebra n R) :
    (x : MvPolynomial (Fin n × Fin n) R) =
      ∑ s ∈ ((flagMinorBasis n R).repr x).support,
        (flagMinorBasis n R).repr x s • s.2.flagMinorProd R := by
  conv_lhs => rw [← (flagMinorBasis n R).sum_support_repr_smul x]
  simp only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul, coe_flagMinorBasis_apply]

/-- `flagMinorAlgebra n R` is a free `R`-module over every commutative ring `R`. -/
instance (n : ℕ) (R : Type*) [CommRing R] : Module.Free R (flagMinorAlgebra n R) :=
  Module.Free.of_basis (flagMinorBasis n R)

/-! ### The fundamental column-multigrading decomposition -/

theorem flagMinorBasis_mem_flagMinorColSubmodule (R : Type*) [CommRing R]
    (s : Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) :
    flagMinorBasis n R s ∈ flagMinorColSubmodule n R (fun c ↦ s.1.val.rowLen c) :=
  mem_flagMinorColSubmodule_iff.mpr fun c ↦ by
    rw [coe_flagMinorBasis_apply]; exact s.2.isWeightedHomogeneous_flagColWeight_flagMinorProd R c

/-- **Fundamental-multigrading decomposition.** `flagMinorAlgebra n R` is the internal direct sum of
its column-multidegree components `flagMinorColSubmodule n R d`. -/
theorem isInternal_flagMinorColSubmodule (R : Type*) [CommRing R] :
    DirectSum.IsInternal (flagMinorColSubmodule n R) := by
  rw [DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top]
  refine ⟨iSupIndep_flagMinorColSubmodule R, eq_top_iff.mpr fun x _ ↦ ?_⟩
  rw [← (flagMinorBasis n R).sum_support_repr_smul x]
  exact Submodule.sum_mem _ fun s _ ↦ Submodule.mem_iSup_of_mem (fun c ↦ s.1.val.rowLen c)
    (Submodule.smul_mem _ _ (flagMinorBasis_mem_flagMinorColSubmodule R s))

/-- Every tableau in the `flagMinorBasis` support of a homogeneous element of column multidegree
`d` has shape multidegree `d`. -/
theorem rowLen_eq_of_mem_support_repr_flagMinorBasis {R : Type*} [CommRing R]
    {d : Fin n → ℕ} {x : flagMinorAlgebra n R} (hx : x ∈ flagMinorColSubmodule n R d)
    {s : Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val}
    (hs : s ∈ ((flagMinorBasis n R).repr x).support) :
    (fun c : Fin n ↦ s.1.val.rowLen c) = d := by
  classical
  by_contra hsd
  let l := (flagMinorBasis n R).repr x
  let g : (Σ μ : {μ : YoungDiagram // μ.colLen 0 ≤ n}, BoundedSSYT n μ.val) → Fin n → ℕ :=
    fun t c ↦ t.1.val.rowLen c
  let v : (Fin n → ℕ) → flagMinorAlgebra n R := fun d' ↦
    (∑ t ∈ l.support with g t = d', l t • flagMinorBasis n R t) - if d' = d then x else 0
  have hv_sum : ∑ d' ∈ insert d (l.support.image g), v d' = 0 := by
    simp only [v, sum_sub_distrib, sum_ite_eq', mem_insert_self, ↓reduceIte]
    rw [sum_fiberwise_of_maps_to (fun _ ht ↦ mem_insert_of_mem (mem_image_of_mem g ht)) _,
      (flagMinorBasis n R).sum_support_repr_smul x, sub_self]
  have hv_mem : ∀ d' ∈ insert d (l.support.image g), v d' ∈ flagMinorColSubmodule n R d' :=
    fun d' _ ↦ sub_mem
      (Submodule.sum_mem _ fun t ht ↦ (mem_filter.mp ht).2 ▸
        Submodule.smul_mem _ _ (flagMinorBasis_mem_flagMinorColSubmodule R t))
      (by split_ifs with h; exacts [h ▸ hx, zero_mem _])
  have hv_gs : v (g s) = 0 := (iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero _).mp
    (iSupIndep_flagMinorColSubmodule R) _ v hv_mem hv_sum (g s)
    (mem_insert_of_mem (mem_image_of_mem g hs))
  simp only [v, show g s ≠ d from hsd, ↓reduceIte, sub_zero] at hv_gs
  have hcoeff := congrArg (Finsupp.lapply (R := R) s) (congrArg (flagMinorBasis n R).repr hv_gs)
  simp only [map_sum, map_smul, Module.Basis.repr_self, map_zero, Finsupp.lapply_apply] at hcoeff
  rw [sum_eq_single_of_mem s (mem_filter.mpr ⟨hs, rfl⟩ : s ∈ l.support.filter fun t ↦ g t = g s)
    fun _ _ h ↦ by rw [Finsupp.single_eq_of_ne h.symm, smul_zero]] at hcoeff
  exact Finsupp.mem_support_iff.mp hs (by simpa using hcoeff)

/-- **Vanishing off dominant weights.** If `d : Fin n → ℕ` is not weakly decreasing, the homogeneous
component of `flagMinorAlgebra n R` of column multidegree `d` is `⊥`. -/
theorem flagMinorColSubmodule_eq_bot_of_not_antitone (R : Type*) [CommRing R] {d : Fin n → ℕ}
    (hd : ¬ Antitone d) : flagMinorColSubmodule n R d = ⊥ :=
  eq_bot_iff.mpr fun _ hx ↦ (Submodule.mem_bot R).mpr <|
    (flagMinorBasis n R).repr.map_eq_zero_iff.mp <| by_contra fun hne ↦
      let ⟨s, hs⟩ := Finsupp.support_nonempty_iff.mpr hne
      hd (rowLen_eq_of_mem_support_repr_flagMinorBasis hx hs ▸
        fun _ _ h ↦ s.1.val.rowLen_anti _ _ h)

/-- **Tableau basis of a shape component.** For a Young diagram `μ` with at most `n` rows, the
tableau products `T.flagMinorProd R` for `T : BoundedSSYT n μ` form a free `R`-module basis of the
shape-`μ` homogeneous component `flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)`. -/
noncomputable def flagMinorShapeBasis (R : Type*) [CommRing R] (μ : YoungDiagram)
    (hμ : μ.colLen 0 ≤ n) :
    Module.Basis (BoundedSSYT n μ) R (flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)) :=
  let w : BoundedSSYT n μ → flagMinorAlgebra n R := fun T ↦
    ⟨T.flagMinorProd R, T.flagMinorProd_mem_flagMinorAlgebra R⟩
  let v : BoundedSSYT n μ → flagMinorColSubmodule n R (fun c ↦ μ.rowLen c) := fun T ↦
    ⟨w T, mem_flagMinorColSubmodule_iff.mpr (T.isWeightedHomogeneous_flagColWeight_flagMinorProd R)⟩
  have hw : LinearIndependent R w :=
    LinearIndependent.of_comp (flagMinorAlgebra n R).val.toLinearMap (v := w)
      ((linearIndependent_flagMinorProd R).comp
        (Sigma.mk (β := fun ν : {ν : YoungDiagram // ν.colLen 0 ≤ n} ↦ BoundedSSYT n ν.val)
          ⟨μ, hμ⟩)
        sigma_mk_injective)
  Module.Basis.mk
    (LinearIndependent.of_comp (flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)).subtype (v := v) hw)
    fun x _ ↦ by
      have hx : x.val ∈ Submodule.span R (Set.range w) := by
        rw [← (flagMinorBasis n R).sum_support_repr_smul x.val]
        refine Submodule.sum_mem _ fun s hs ↦ Submodule.smul_mem _ _ ?_
        have hs1 : s.1 = ⟨μ, hμ⟩ := Subtype.ext <| by
          dsimp only
          rw [← YoungDiagram.ofRowLensFin_rowLen s.1.val s.1.property,
            ← YoungDiagram.ofRowLensFin_rowLen μ hμ]
          simp_rw [congr_fun (rowLen_eq_of_mem_support_repr_flagMinorBasis x.property hs)]
        rcases s with ⟨ν, T⟩; subst hs1; exact Submodule.subset_span ⟨T, by ext1; simp [w]⟩
      have hmap : (Submodule.span R (Set.range v)).map
          (flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)).subtype =
          Submodule.span R (Set.range w) := by rw [Submodule.map_span, ← Set.range_comp]; rfl
      obtain ⟨y, hy, hyx⟩ := hmap ▸ hx
      exact Subtype.ext hyx ▸ hy

@[simp]
theorem coe_flagMinorShapeBasis_apply (R : Type*) [CommRing R] (μ : YoungDiagram)
    (hμ : μ.colLen 0 ≤ n) (T : BoundedSSYT n μ) :
    (((flagMinorShapeBasis R μ hμ T : flagMinorColSubmodule n R (fun c ↦ μ.rowLen c)) :
      flagMinorAlgebra n R) : MvPolynomial (Fin n × Fin n) R) = T.flagMinorProd R := by
  simp [flagMinorShapeBasis]

end TauCeti
