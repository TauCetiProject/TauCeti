module

public import Mathlib.LinearAlgebra.Basis.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.Algebra.BigOperators.Finsupp.Basic

/-!
# Polynomial quotients with a prescribed basis

The coordinates of monomials in a prescribed finite polynomial basis satisfy
explicit relations. Their universal ring classifies ideals whose quotients
have that basis, by extension of the universal ideal.

Reference: The Stacks Project, Section 44.2, Hilbert scheme of points (Tag 0B94).
-/

public section

universe u

namespace MvPolynomial

variable {R : Type u} [CommRing R] {n : Type u} {ι : Type u} (w : ι → MvPolynomial n R)

/-- An ideal `I` of `A[n]`, for an `R`-algebra `A`, is `w`-adapted if the images of the
polynomials `w l` form a basis of the `A`-module `A[n] ⧸ I`. -/
structure IsQuotientBasis {A : Type*} [CommRing A] [Algebra R A]
    (I : Ideal (MvPolynomial n A)) : Prop where
  /-- The prescribed polynomials have linearly independent images. -/
  linearIndependent :
    LinearIndependent A (fun l ↦ Ideal.Quotient.mk I (map (algebraMap R A) (w l)))
  /-- The prescribed polynomials span the quotient. -/
  span_eq_top :
    Submodule.span A (Set.range fun l ↦ Ideal.Quotient.mk I (map (algebraMap R A) (w l))) = ⊤

/-- The linear map evaluating monomials at their prescribed coordinate vectors. -/
noncomputable def quotientBasisCoord {A : Type*} [CommRing A]
    (v : (n →₀ ℕ) × ι → A) : MvPolynomial n A →ₗ[A] (ι → A) :=
  (basisMonomials n A).constr A (fun m k ↦ v (m, k))

section Coord

variable {A : Type*} [CommRing A] (v : (n →₀ ℕ) × ι → A)

/-- The coordinates are the coefficient-weighted sum of monomial coordinates. -/
theorem quotientBasisCoord_eq_sum (g : MvPolynomial n A) (k : ι) :
    quotientBasisCoord v g k = ∑ m ∈ g.support, g.coeff m * v (m, k) := by
  simp [quotientBasisCoord, Module.Basis.constr_apply, basisMonomials, Finsupp.sum,
    finsupp_support_eq_support]

/-- The coordinates of `g` may be computed as a sum over any finite set containing the support
of `g`. -/
theorem quotientBasisCoord_eq_sum_of_subset {g : MvPolynomial n A} {s : Finset (n →₀ ℕ)}
    (hs : g.support ⊆ s) (k : ι) :
    quotientBasisCoord v g k = ∑ m ∈ s, g.coeff m * v (m, k) := by
  classical
  rw [quotientBasisCoord_eq_sum]
  exact Finset.sum_subset hs fun m _ hm ↦ by rw [notMem_support_iff.mp hm, zero_mul]

/-- Multiplying by a constant multiplies every coordinate. -/
theorem quotientBasisCoord_C_mul (a : A) (g : MvPolynomial n A) :
    quotientBasisCoord v (C a * g) = a • quotientBasisCoord v g := by
  rw [C_mul', map_smul]

/-- The coordinates of the monomial `a • m` are `a • v (m, ·)`. -/
theorem quotientBasisCoord_monomial (m : n →₀ ℕ) (a : A) (k : ι) :
    quotientBasisCoord v (monomial m a) k = a * v (m, k) := by
  classical
  rw [quotientBasisCoord_eq_sum_of_subset v support_monomial_subset, Finset.sum_singleton,
    coeff_monomial, ite_eq_left rfl]

/-- Coordinates commute with base change along a ring map. -/
theorem quotientBasisCoord_map {B : Type*} [CommRing B] (φ : A →+* B) (g : MvPolynomial n A)
    (k : ι) :
    φ (quotientBasisCoord v g k) = quotientBasisCoord (fun x ↦ φ (v x)) (map φ g) k := by
  rw [quotientBasisCoord_eq_sum_of_subset _ (support_map_subset φ g), quotientBasisCoord_eq_sum,
    map_sum]
  simp [coeff_map]

end Coord

variable [Fintype ι] [DecidableEq ι]

/-- The relations of the universal ring: the coordinates of `w l` are `e_l`, and the coordinates
of `X i * m` are those of `∑ₗ v (m, l) • (X i * w l)`. -/
noncomputable def quotientBasisRelations : Ideal (MvPolynomial ((n →₀ ℕ) × ι) R) :=
  Ideal.span (Set.range (fun lk : ι × ι ↦
      quotientBasisCoord X (map C (w lk.1)) lk.2 - if lk.1 = lk.2 then 1 else 0) ∪
    Set.range (fun imk : n × (n →₀ ℕ) × ι ↦
      X (imk.2.1 + Finsupp.single imk.1 1, imk.2.2) -
        ∑ l, X (imk.2.1, l) * quotientBasisCoord X (map C (X imk.1 * w l)) imk.2.2))

/-- The universal ring of `w`-adapted ideals. -/
abbrev QuotientBasisRing : Type u :=
  MvPolynomial ((n →₀ ℕ) × ι) R ⧸ quotientBasisRelations w

/-- The ideal of `A[n]` generated by the `m - ∑ₗ v (m, l) • w l`, for the monomials `m`. -/
noncomputable def quotientBasisIdealOf {A : Type*} [CommRing A] [Algebra R A]
    (v : (n →₀ ℕ) × ι → A) : Ideal (MvPolynomial n A) :=
  Ideal.span (Set.range fun m ↦ monomial m 1 - ∑ l, C (v (m, l)) * map (algebraMap R A) (w l))

/-- The universal `w`-adapted ideal. -/
noncomputable def quotientBasisIdeal : Ideal (MvPolynomial n (QuotientBasisRing w)) :=
  quotientBasisIdealOf w fun x ↦ Ideal.Quotient.mk _ (X x)



section Ideal

variable {A : Type*} [CommRing A] [Algebra R A] (v : (n →₀ ℕ) × ι → A)

omit [DecidableEq ι] in
/-- Every polynomial `g` is congruent to `∑ₗ (coordinates of g)ₗ • w l` modulo
`quotientBasisIdealOf w v`. -/
theorem sub_sum_mem_quotientBasisIdealOf (g : MvPolynomial n A) :
    g - ∑ l, C (quotientBasisCoord v g l) * map (algebraMap R A) (w l) ∈
      quotientBasisIdealOf w v := by
  induction g using MvPolynomial.induction_on' with
  | monomial m a =>
    have h : monomial m a - ∑ l, C (quotientBasisCoord v (monomial m a) l) *
        map (algebraMap R A) (w l) =
        C a * (monomial m 1 - ∑ l, C (v (m, l)) * map (algebraMap R A) (w l)) := by
      simp [quotientBasisCoord_monomial, mul_sub, Finset.mul_sum, C_mul_monomial, mul_assoc]
    rw [h]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨m, rfl⟩)
  | add f g hf hg =>
    convert Ideal.add_mem _ hf hg using 1
    simp only [map_add, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
    abel

/-- Scalar multiplication on a quotient of `A[n]` is multiplication by a constant. -/
theorem smul_mk_eq_mk_C_mul (I : Ideal (MvPolynomial n A)) (a : A) (p : MvPolynomial n A) :
    a • Ideal.Quotient.mk I p = Ideal.Quotient.mk I (C a * p) := by
  rw [C_mul', ← Ideal.Quotient.mkₐ_eq_mk A]
  exact (map_smul (Ideal.Quotient.mkₐ A I) a p).symm

omit [DecidableEq ι] in
/-- If `I` contains `quotientBasisIdealOf w v`, then the image of `g` in `A[n] ⧸ I` is the
combination of the images of the `w l` with coefficients the coordinates of `g`. -/
theorem mk_eq_sum_quotientBasisCoord {I : Ideal (MvPolynomial n A)}
    (hle : quotientBasisIdealOf w v ≤ I) (g : MvPolynomial n A) :
    Ideal.Quotient.mk I g = ∑ l, quotientBasisCoord v g l •
      Ideal.Quotient.mk I (map (algebraMap R A) (w l)) := by
  have h := Ideal.Quotient.eq_zero_iff_mem.2 (hle (sub_sum_mem_quotientBasisIdealOf w v g))
  rw [map_sub, sub_eq_zero, map_sum] at h
  simpa [smul_mk_eq_mk_C_mul] using h

omit [DecidableEq ι] in
/-- If `I` is `w`-adapted and contains `quotientBasisIdealOf w v`, then the coordinates of the
image of `g` in the basis of `A[n] ⧸ I` are the coordinates of `g`. -/
theorem repr_mk_eq_quotientBasisCoord {I : Ideal (MvPolynomial n A)} (hI : IsQuotientBasis w I)
    (hle : quotientBasisIdealOf w v ≤ I) (g : MvPolynomial n A) (k : ι) :
    (Module.Basis.mk hI.linearIndependent hI.span_eq_top.ge).repr (Ideal.Quotient.mk I g) k =
      quotientBasisCoord v g k := by
  have h : Ideal.Quotient.mk I g =
      ∑ l, quotientBasisCoord v g l • Module.Basis.mk hI.linearIndependent hI.span_eq_top.ge l := by
    rw [mk_eq_sum_quotientBasisCoord w v hle g]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    rw [Module.Basis.mk_apply]
  rw [h, Module.Basis.repr_sum_self]

omit [Fintype ι] [DecidableEq ι] in
/-- Evaluating the universal coordinates of `p` at `v` gives the coordinates of `p` for `v`. -/
theorem aeval_quotientBasisCoord (p : MvPolynomial n R) (k : ι) :
    aeval v (quotientBasisCoord X (map C p) k) =
      quotientBasisCoord v (map (algebraMap R A) p) k := by
  rw [← AlgHom.coe_toRingHom, quotientBasisCoord_map, map_map, ← algebraMap_eq,
    AlgHom.comp_algebraMap]
  simp

/-- If `v` satisfies the relations, the coordinates of `w l` are `e_l`. -/
theorem quotientBasisCoord_w_of_relations
    (hv : ∀ x ∈ quotientBasisRelations w, aeval v x = 0) (l k : ι) :
    quotientBasisCoord v (map (algebraMap R A) (w l)) k = if l = k then 1 else 0 := by
  have h := hv _ (Ideal.subset_span (Or.inl ⟨(l, k), rfl⟩))
  rwa [map_sub, aeval_quotientBasisCoord, sub_eq_zero, apply_ite (aeval v), map_one,
    map_zero] at h

/-- If `v` satisfies the relations, the coordinates of `X i * m` are those of
`∑ₗ v (m, l) • (X i * w l)`. -/
theorem eq_sum_quotientBasisCoord_of_relations
    (hv : ∀ x ∈ quotientBasisRelations w, aeval v x = 0) (i : n)
    (m : n →₀ ℕ) (k : ι) :
    v (m + Finsupp.single i 1, k) =
      ∑ l, v (m, l) * quotientBasisCoord v (map (algebraMap R A) (X i * w l)) k := by
  have h := hv _ (Ideal.subset_span (Or.inr ⟨(i, m, k), rfl⟩))
  dsimp only at h
  rw [map_sub, sub_eq_zero, map_sum, aeval_X] at h
  rw [h]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [map_mul, aeval_X, aeval_quotientBasisCoord]

/-- Conversely, coordinates `v` with these two properties satisfy the relations. -/
theorem aeval_eq_zero_of_quotientBasisCoord
    (ha : ∀ l k, quotientBasisCoord v (map (algebraMap R A) (w l)) k = if l = k then 1 else 0)
    (hb : ∀ i m k, v (m + Finsupp.single i 1, k) =
      ∑ l, v (m, l) * quotientBasisCoord v (map (algebraMap R A) (X i * w l)) k) :
    ∀ x ∈ quotientBasisRelations w, aeval v x = 0 := by
  intro x hx
  refine (Ideal.span_le (I := RingHom.ker (aeval v))).2 ?_ hx
  rintro _ (⟨⟨l, k⟩, rfl⟩ | ⟨⟨i, m, k⟩, rfl⟩)
  · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, aeval_quotientBasisCoord, ha,
      apply_ite (aeval v), map_one, map_zero, sub_self]
  · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_sum, sub_eq_zero, aeval_X, hb]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    rw [map_mul (aeval v), aeval_X, aeval_quotientBasisCoord]

/-- If `v` satisfies the relations, the coordinates of `X i * g` are determined by those of `g`. -/
theorem quotientBasisCoord_X_mul (hv : ∀ x ∈ quotientBasisRelations w, aeval v x = 0) (i : n)
    (g : MvPolynomial n A) :
    quotientBasisCoord v (X i * g) = ∑ l, quotientBasisCoord v g l •
      quotientBasisCoord v (map (algebraMap R A) (X i * w l)) := by
  induction g using MvPolynomial.induction_on' with
  | monomial m a =>
    ext k
    rw [X, monomial_mul_monomial, one_mul, add_comm, quotientBasisCoord_monomial,
      eq_sum_quotientBasisCoord_of_relations w v hv]
    simp [quotientBasisCoord_monomial, Finset.mul_sum, mul_assoc]
  | add f g hf hg =>
    rw [mul_add, map_add, hf, hg, ← Finset.sum_add_distrib]
    simp [map_add, add_smul]

/-- If `v` satisfies the relations, the kernel of the coordinates is an ideal. -/
theorem quotientBasisCoord_mul_eq_zero (hv : ∀ x ∈ quotientBasisRelations w, aeval v x = 0)
    (h : MvPolynomial n A) {g : MvPolynomial n A} (hg : quotientBasisCoord v g = 0) :
    quotientBasisCoord v (h * g) = 0 := by
  induction h using MvPolynomial.induction_on generalizing g with
  | C a => rw [quotientBasisCoord_C_mul, hg, smul_zero]
  | add p q hp hq => rw [add_mul, map_add, hp hg, hq hg, add_zero]
  | mul_X p i hp =>
    rw [mul_assoc, hp]
    rw [quotientBasisCoord_X_mul w v hv, hg]
    simp

/-- If `v` satisfies the relations, the coordinates vanish on `quotientBasisIdealOf w v`. -/
theorem quotientBasisCoord_eq_zero_of_mem (hv : ∀ x ∈ quotientBasisRelations w, aeval v x = 0)
    {g : MvPolynomial n A} (hg : g ∈ quotientBasisIdealOf w v) : quotientBasisCoord v g = 0 := by
  let J : Ideal (MvPolynomial n A) :=
    { carrier := {g | quotientBasisCoord v g = 0}
      add_mem' := fun {f g} hf hg ↦ by
        rw [Set.mem_ofPred_eq, map_add, hf, hg, add_zero]
      zero_mem' := map_zero (quotientBasisCoord v)
      smul_mem' := fun c _ hx ↦ quotientBasisCoord_mul_eq_zero w v hv c hx }
  refine (Ideal.span_le (I := J)).2 ?_ hg
  rintro _ ⟨m, rfl⟩
  ext k
  simp [map_sub, map_sum, quotientBasisCoord_C_mul,
    quotientBasisCoord_monomial, quotientBasisCoord_w_of_relations w v hv]

/-- **Key lemma.** If `v` satisfies the relations of `quotientBasisRelations w`, then
`quotientBasisIdealOf w v` is `w`-adapted. -/
theorem isQuotientBasis_quotientBasisIdealOf
    (hv : ∀ x ∈ quotientBasisRelations w, aeval v x = 0) :
    IsQuotientBasis w (quotientBasisIdealOf w v) := by
  constructor
  · rw [Fintype.linearIndependent_iff]
    intro c hc l
    have hmem : ∑ i, C (c i) * map (algebraMap R A) (w i) ∈ quotientBasisIdealOf w v := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sum]
      simpa [smul_mk_eq_mk_C_mul] using hc
    have h := congr_fun (quotientBasisCoord_eq_zero_of_mem w v hv hmem) l
    simpa [map_sum, quotientBasisCoord_C_mul,
      quotientBasisCoord_w_of_relations w v hv] using h
  · rw [eq_top_iff]
    rintro x -
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [mk_eq_sum_quotientBasisCoord w v le_rfl g]
    exact Submodule.sum_mem _ fun l _ ↦
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)

omit [DecidableEq ι] in
/-- Extension of scalars of `quotientBasisIdealOf w v` along `ψ`. -/
theorem map_quotientBasisIdealOf {B : Type*} [CommRing B] [Algebra R B] (ψ : A →ₐ[R] B) :
    (quotientBasisIdealOf w v).map (map ψ.toRingHom) =
      quotientBasisIdealOf w fun x ↦ ψ (v x) := by
  rw [quotientBasisIdealOf, quotientBasisIdealOf, Ideal.map_span, ← Set.range_comp]
  congr 2
  funext m
  simp [map_map]

omit [DecidableEq ι] in
/-- For a `w`-adapted ideal `I`, with `v` the coordinates of the monomials in the basis of
`A[n] ⧸ I`, the ideal `quotientBasisIdealOf w v` is contained in `I`. -/
theorem quotientBasisIdealOf_le_of_isQuotientBasis {I : Ideal (MvPolynomial n A)}
    (hI : IsQuotientBasis w I) :
    quotientBasisIdealOf w (fun x ↦ (Module.Basis.mk hI.linearIndependent hI.span_eq_top.ge).repr
      (Ideal.Quotient.mk I (monomial x.1 1)) x.2) ≤ I := by
  rw [quotientBasisIdealOf, Ideal.span_le]
  rintro _ ⟨m, rfl⟩
  rw [SetLike.mem_coe, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero, map_sum]
  conv_lhs => rw [← (Module.Basis.mk hI.linearIndependent hI.span_eq_top.ge).sum_repr
      (Ideal.Quotient.mk I _)]
  simp [smul_mk_eq_mk_C_mul]

omit [DecidableEq ι] in
/-- A `w`-adapted ideal `I` is `quotientBasisIdealOf w v` for `v` the coordinates of the
monomials in the basis of `A[n] ⧸ I`. -/
theorem quotientBasisIdealOf_eq_of_isQuotientBasis {I : Ideal (MvPolynomial n A)}
    (hI : IsQuotientBasis w I) :
    quotientBasisIdealOf w (fun x ↦ (Module.Basis.mk hI.linearIndependent hI.span_eq_top.ge).repr
      (Ideal.Quotient.mk I (monomial x.1 1)) x.2) = I := by
  refine le_antisymm (quotientBasisIdealOf_le_of_isQuotientBasis w hI) fun g hg ↦ ?_
  have h0 : quotientBasisCoord (fun x ↦ (Module.Basis.mk hI.linearIndependent
      hI.span_eq_top.ge).repr
      (Ideal.Quotient.mk I (monomial x.1 1)) x.2) g = 0 := by
    funext k
    rw [← repr_mk_eq_quotientBasisCoord w _ hI (quotientBasisIdealOf_le_of_isQuotientBasis w hI),
      Ideal.Quotient.eq_zero_iff_mem.2 hg, map_zero, Finsupp.zero_apply, Pi.zero_apply]
  have h := sub_sum_mem_quotientBasisIdealOf w (fun x ↦ (Module.Basis.mk hI.linearIndependent
      hI.span_eq_top.ge).repr
    (Ideal.Quotient.mk I (monomial x.1 1)) x.2) g
  simp only [h0, Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero, sub_zero] at h
  exact h

/-- The coordinates of the monomials in the basis of a `w`-adapted ideal satisfy the relations. -/
theorem aeval_eq_zero_of_isQuotientBasis {I : Ideal (MvPolynomial n A)} (hI : IsQuotientBasis w I) :
    ∀ x ∈ quotientBasisRelations w, aeval (fun x ↦ (Module.Basis.mk hI.linearIndependent
      hI.span_eq_top.ge).repr
      (Ideal.Quotient.mk I (monomial x.1 1)) x.2) x = 0 := by
  have hle := quotientBasisIdealOf_le_of_isQuotientBasis w hI
  refine aeval_eq_zero_of_quotientBasisCoord w _ (fun l k ↦ ?_) (fun i m k ↦ ?_)
  · rw [← repr_mk_eq_quotientBasisCoord w _ hI hle, ← Module.Basis.mk_apply hI.linearIndependent
      hI.span_eq_top.ge l,
      Module.Basis.repr_self, Finsupp.single_apply]
  · have hX : monomial (m + Finsupp.single i 1) (1 : A) = X i * monomial m 1 := by
      rw [X, monomial_mul_monomial, one_mul, add_comm]
    have key : Ideal.Quotient.mk I (monomial (m + Finsupp.single i 1) 1) =
        ∑ l, quotientBasisCoord (fun x ↦ (Module.Basis.mk hI.linearIndependent
      hI.span_eq_top.ge).repr
          (Ideal.Quotient.mk I (monomial x.1 1)) x.2) (monomial m 1) l •
          Ideal.Quotient.mk I (map (algebraMap R A) (X i * w l)) := by
      rw [hX, map_mul, mk_eq_sum_quotientBasisCoord w _ hle (monomial m 1), Finset.mul_sum]
      refine Finset.sum_congr rfl fun l _ ↦ ?_
      rw [mul_smul_comm, ← map_mul, map_mul (map (algebraMap R A)), map_X]
    dsimp only
    rw [key, map_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    rw [map_smul, Finsupp.smul_apply, smul_eq_mul,
      repr_mk_eq_quotientBasisCoord w _ hI hle (map (algebraMap R A) (X i * w l)) k,
      quotientBasisCoord_monomial, one_mul]

end Ideal

/-- The universal ideal has the prescribed quotient basis. -/
theorem isQuotientBasis_quotientBasisIdeal : IsQuotientBasis w (quotientBasisIdeal w) :=
  isQuotientBasis_quotientBasisIdealOf w _ fun x hx ↦ by
    rwa [← Ideal.Quotient.mkₐ_eq_mk R, ← comp_aeval_apply, aeval_X_left_apply,
      Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]

/-- The extension of the universal ideal along any `φ : QuotientBasisRing w →ₐ[R] A` is
`w`-adapted. -/
theorem isQuotientBasis_map_quotientBasisIdeal {A : Type*} [CommRing A] [Algebra R A]
    (φ : QuotientBasisRing w →ₐ[R] A) :
    IsQuotientBasis w ((quotientBasisIdeal w).map (map φ.toRingHom)) := by
  rw [quotientBasisIdeal, map_quotientBasisIdealOf]
  refine isQuotientBasis_quotientBasisIdealOf w _ fun x hx ↦ ?_
  rw [← comp_aeval_apply, ← Ideal.Quotient.mkₐ_eq_mk R,
    ← comp_aeval_apply, aeval_X_left_apply, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq_zero_iff_mem.2 hx, map_zero]

/-- The coordinates of the monomials in the basis attached to the extension of the universal
ideal along `φ` are the images under `φ` of the universal coordinates. -/
theorem repr_mk_map_quotientBasisIdeal {A : Type*} [CommRing A] [Algebra R A]
    (φ : QuotientBasisRing w →ₐ[R] A)
    (hI : IsQuotientBasis w ((quotientBasisIdeal w).map (map φ.toRingHom)))
    (x : (n →₀ ℕ) × ι) :
    (Module.Basis.mk hI.linearIndependent hI.span_eq_top.ge).repr (Ideal.Quotient.mk _ (monomial
      x.1 1)) x.2 =
      φ (Ideal.Quotient.mk _ (X x)) := by
  rw [repr_mk_eq_quotientBasisCoord w (fun x ↦ φ (Ideal.Quotient.mk _ (X x))) hI ?_,
    quotientBasisCoord_monomial, one_mul]
  rw [quotientBasisIdeal, map_quotientBasisIdealOf]

/-- The universal property of `QuotientBasisRing w`: algebra maps
`QuotientBasisRing w →ₐ[R] A` correspond to `w`-adapted ideals
of `A[n]`, by extending the universal ideal `quotientBasisIdeal w`. -/
noncomputable def quotientBasisEquiv (A : Type*) [CommRing A] [Algebra R A] :
    (QuotientBasisRing w →ₐ[R] A) ≃ {I : Ideal (MvPolynomial n A) // IsQuotientBasis w I} where
  toFun φ := ⟨(quotientBasisIdeal w).map (map φ.toRingHom),
    isQuotientBasis_map_quotientBasisIdeal w φ⟩
  invFun I := Ideal.Quotient.liftₐ _ (aeval fun x ↦
    (Module.Basis.mk I.2.linearIndependent I.2.span_eq_top.ge).repr (Ideal.Quotient.mk I.1
      (monomial x.1 1)) x.2)
    (aeval_eq_zero_of_isQuotientBasis w I.2)
  left_inv φ := by
    refine Ideal.Quotient.algHom_ext _ (MvPolynomial.algHom_ext fun x ↦ ?_)
    dsimp only
    simp only [← Ideal.Quotient.mkₐ_eq_mk R,
      Ideal.Quotient.liftₐ_comp, aeval_X]
    exact repr_mk_map_quotientBasisIdeal w φ (isQuotientBasis_map_quotientBasisIdeal w φ) x
  right_inv I := by
    refine Subtype.ext ?_
    dsimp only
    rw [quotientBasisIdeal, map_quotientBasisIdealOf]
    simp only [← Ideal.Quotient.mkₐ_eq_mk R, ← AlgHom.comp_apply,
      Ideal.Quotient.liftₐ_comp, aeval_X]
    exact quotientBasisIdealOf_eq_of_isQuotientBasis w I.2

/-- The classifier sends an algebra map to the extension of the universal ideal. -/
@[simp]
theorem coe_quotientBasisEquiv_apply {A : Type*} [CommRing A] [Algebra R A]
    (φ : QuotientBasisRing w →ₐ[R] A) :
    (quotientBasisEquiv w A φ).1 = (quotientBasisIdeal w).map (map φ.toRingHom) :=
  (rfl)

/-- The inverse classifier sends a universal variable to its monomial coordinate. -/
@[simp]
theorem quotientBasisEquiv_symm_apply_mk_X {A : Type*} [CommRing A] [Algebra R A]
    (I : {I : Ideal (MvPolynomial n A) // IsQuotientBasis w I}) (x : (n →₀ ℕ) × ι) :
    (quotientBasisEquiv w A).symm I (Ideal.Quotient.mk _ (X x)) =
      (Module.Basis.mk I.2.linearIndependent I.2.span_eq_top.ge).repr
        (Ideal.Quotient.mk I.1 (monomial x.1 1)) x.2 := by
  simp only [quotientBasisEquiv, Equiv.coe_fn_symm_mk, ← Ideal.Quotient.mkₐ_eq_mk R,
    ← AlgHom.comp_apply, Ideal.Quotient.liftₐ_comp, aeval_X]

/-- Classification of basis quotients commutes with extension of scalars. -/
theorem quotientBasisEquiv_comp {source target : Type*} [CommRing source] [CommRing target]
    [Algebra R source] [Algebra R target] (scalarMap : source →ₐ[R] target)
    (classifier : QuotientBasisRing w →ₐ[R] source) :
    (quotientBasisEquiv w target (scalarMap.comp classifier)).1 =
      ((quotientBasisEquiv w source classifier).1).map (map scalarMap.toRingHom) := by
  rw [coe_quotientBasisEquiv_apply, coe_quotientBasisEquiv_apply, Ideal.map_map]
  congr 1
  exact RingHom.ext fun polynomial ↦
    (map_map classifier.toRingHom scalarMap.toRingHom polynomial).symm

omit [Fintype ι] [DecidableEq ι] in
/-- A prescribed polynomial basis remains a basis after extension of scalars. -/
theorem IsQuotientBasis.map [Finite ι] {source target : Type*} [CommRing source] [CommRing target]
    [Algebra R source] [Algebra R target] {ideal : Ideal (MvPolynomial n source)}
    (basis : IsQuotientBasis w ideal) (scalarMap : source →ₐ[R] target) :
    IsQuotientBasis w (ideal.map (map scalarMap.toRingHom)) := by
  classical
  let := Fintype.ofFinite ι
  obtain ⟨classifier, equality⟩ := (quotientBasisEquiv w source).surjective ⟨ideal, basis⟩
  have idealEquality : (quotientBasisEquiv w source classifier).1 = ideal :=
    congrArg Subtype.val equality
  rw [← idealEquality, ← quotientBasisEquiv_comp]
  exact (quotientBasisEquiv w target (scalarMap.comp classifier)).2

end MvPolynomial
