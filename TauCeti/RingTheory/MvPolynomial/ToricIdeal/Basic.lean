module

public import TauCeti.Algebra.Group.Submonoid.Closure
public import TauCeti.Algebra.MonoidAlgebra.Exactness
public import Mathlib.RingTheory.FiniteType

/-!
# Toric ideals and the binomial presentation of semigroup algebras

Let `a : ι → M` be a family in an additive commutative monoid, and write
`A u = ∑ i, u i • a i` (`Finsupp.linearCombination ℕ a u`) for the exponent map `ℕ^(ι) → M`.
The *toric ideal* `TauCeti.toricIdeal R a` is the kernel of the `R`-algebra map
`MvPolynomial ι R → R[M]` sending `X i` to the basis element `single (a i) 1`; this map sends
the monomial `c X^u` to `single (A u) c`.

Over every commutative ring `R`, the toric ideal is generated by the binomials `X^u - X^v` with
`A u = A v`. It is unchanged when `M` is replaced by a larger monoid, and its formation commutes
with change of coefficients. If the `a i` generate `M`, then `MvPolynomial ι R ⧸ toricIdeal R a`
is the semigroup algebra `R[M]`; in general it is the semigroup algebra of the submonoid
`AddSubmonoid.closure (Set.range a)` generated by the `a i`. For finitely many exponents, a single
finite family of binomials, with exponent pairs independent of `R`, generates the toric ideal over
every commutative ring: such a family is selected over `ℤ` by noetherianity and transported to
`R` by change of coefficients.

## Main declarations

* `TauCeti.toricIdeal`: the kernel of `X i ↦ single (a i) 1`.
* `TauCeti.toricIdeal_eq_span`: it is generated by the binomials `X^u - X^v` with
  `A u = A v`.
* `TauCeti.monomial_sub_monomial_mem_toricIdeal_iff`: over a nontrivial ring,
  `X^u - X^v` lies in the toric ideal exactly when `A u = A v`.
* `TauCeti.toricIdeal_comp_of_injective`: the toric ideal does not depend on the
  ambient monoid.
* `TauCeti.map_toricIdeal`: the toric ideal over `S` is the extension of the toric
  ideal over `R` along any ring homomorphism `R →+* S`.
* `TauCeti.quotientToricIdealAlgEquiv`: if the `a i` generate `M`, the quotient by the
  toric ideal is `R[M]`.
* `TauCeti.quotientToricIdealAlgEquivClosure`: the quotient by the toric ideal is the
  semigroup algebra of the submonoid generated by the `a i`.
* `TauCeti.exists_finset_toricIdeal_eq_span`: for finite `ι`, finitely many binomials,
  with exponent pairs independent of the coefficient ring, generate the toric ideal over every
  commutative ring.

## References

* B. Sturmfels, *Gröbner Bases and Convex Polytopes*, University Lecture Series 8, AMS, 1996,
  Chapter 4, Lemma 4.1.
* E. Miller and B. Sturmfels, *Combinatorial Commutative Algebra*, GTM 227, Springer, 2005,
  Chapter 7.
-/

public section

open AddMonoidAlgebra MvPolynomial

namespace TauCeti

universe u

variable {ι M N : Type*} [AddCommMonoid M] [AddCommMonoid N]

section CommSemiring

variable (R : Type*) [CommSemiring R]

/-- The `R`-algebra map `MvPolynomial ι R → R[M]` sending `X i` to `single (a i) 1` is the map
of monoid algebras induced by the exponent map `u ↦ ∑ i, u i • a i`. -/
theorem aeval_single_eq_mapDomainAlgHom (a : ι → M) :
    aeval (fun i ↦ single (a i) (1 : R)) =
      mapDomainAlgHom R R (Finsupp.linearCombination ℕ a).toAddMonoidHom := by
  refine algHom_ext fun i ↦ ?_
  rw [aeval_X, X, ← single_eq_monomial, mapDomainAlgHom_apply, mapDomain_single]
  simp

/-- The image of the monomial `c X^u` under `X i ↦ single (a i) 1` is `single (A u) c`, where
`A u = ∑ i, u i • a i`. -/
@[simp]
theorem aeval_single_monomial (a : ι → M) (u : ι →₀ ℕ) (c : R) :
    aeval (fun i ↦ single (a i) (1 : R)) (monomial u c) =
      single (Finsupp.linearCombination ℕ a u) c := by
  rw [aeval_single_eq_mapDomainAlgHom, ← single_eq_monomial]
  simp

/-- If the `a i` generate `M`, then `X i ↦ single (a i) 1` is surjective onto `R[M]`. This is
`AddMonoidAlgebra.mvPolynomial_aeval_of_surjective_of_closure`, for the variables indexed by the
family `a` rather than by the set of its values. -/
theorem aeval_single_surjective {a : ι → M} (ha : AddSubmonoid.closure (Set.range a) = ⊤) :
    Function.Surjective (aeval (R := R) fun i ↦ single (a i) (1 : R)) := by
  intro y
  obtain ⟨q, rfl⟩ := mvPolynomial_aeval_of_surjective_of_closure (R := R) ha y
  obtain ⟨p, rfl⟩ := rename_surjective _ Set.rangeFactorization_surjective q
  exact ⟨p, by simp [aeval_rename, Function.comp_def, of'_apply]⟩

/-- The *toric ideal* of a family `a : ι → M`: the kernel of the `R`-algebra map
`MvPolynomial ι R → R[M]` sending `X i` to the basis element `single (a i) 1`. -/
noncomputable def toricIdeal (a : ι → M) : Ideal (MvPolynomial ι R) :=
  RingHom.ker (aeval fun i ↦ single (a i) (1 : R))

variable {R} in
/-- A polynomial lies in the toric ideal exactly when it vanishes under `X i ↦ single (a i) 1`. -/
theorem mem_toricIdeal_iff {a : ι → M} {p : MvPolynomial ι R} :
    p ∈ toricIdeal R a ↔ aeval (fun i ↦ single (a i) (1 : R)) p = 0 :=
  RingHom.mem_ker

/-- The toric ideal does not depend on the ambient monoid: it is unchanged by an injective
additive homomorphism `g : M →+ N`. -/
theorem toricIdeal_comp_of_injective (a : ι → M) {g : M →+ N} (hg : Function.Injective g) :
    toricIdeal R (g ∘ a) = toricIdeal R a := by
  have h : aeval (fun i ↦ single (g (a i)) (1 : R)) =
      (mapDomainAlgHom R R g).comp (aeval fun i ↦ single (a i) (1 : R)) :=
    algHom_ext fun i ↦ by simp
  ext p
  rw [mem_toricIdeal_iff, mem_toricIdeal_iff, Function.comp_def, h, AlgHom.comp_apply,
    mapDomainAlgHom_apply, ← mapDomain_zero g]
  exact (mapDomain_injective hg).eq_iff

end CommSemiring

variable (R : Type*) [CommRing R]

/-- **Binomial generation of toric ideals.** Over any commutative ring, the toric ideal of
`a : ι → M` is generated by the binomials `X^u - X^v` with `∑ i, u i • a i = ∑ i, v i • a i`. -/
theorem toricIdeal_eq_span (a : ι → M) :
    toricIdeal R a = Ideal.span {p | ∃ u v : ι →₀ ℕ,
      Finsupp.linearCombination ℕ a u = Finsupp.linearCombination ℕ a v ∧
        p = monomial u 1 - monomial v 1} := by
  rw [toricIdeal, aeval_single_eq_mapDomainAlgHom]
  simp_rw [← single_eq_monomial]
  exact TauCeti.AddMonoidAlgebra.ker_mapDomainRingHom_eq_span_single_sub_single R _

/-- The binomial generators of the toric ideal, indexed by exponent pairs with equal image. -/
private theorem toricIdeal_eq_span_image (a : ι → M) :
    toricIdeal R a = Ideal.span ((fun p : (ι →₀ ℕ) × (ι →₀ ℕ) ↦ monomial p.1 (1 : R) -
      monomial p.2 1) '' {p | Finsupp.linearCombination ℕ a p.1 =
        Finsupp.linearCombination ℕ a p.2}) := by
  rw [toricIdeal_eq_span]
  congr 1
  ext q
  simp [eq_comm]

variable {R}

/-- A binomial `X^u - X^v` with `∑ i, u i • a i = ∑ i, v i • a i` lies in the toric ideal. -/
theorem monomial_sub_monomial_mem_toricIdeal {a : ι → M} {u v : ι →₀ ℕ}
    (h : Finsupp.linearCombination ℕ a u = Finsupp.linearCombination ℕ a v) :
    monomial u (1 : R) - monomial v 1 ∈ toricIdeal R a := by
  rw [mem_toricIdeal_iff, map_sub, aeval_single_monomial, aeval_single_monomial, h, sub_self]

/-- Over a nontrivial ring, a binomial `X^u - X^v` lies in the toric ideal exactly when
`∑ i, u i • a i = ∑ i, v i • a i`. -/
@[simp]
theorem monomial_sub_monomial_mem_toricIdeal_iff [Nontrivial R] {a : ι → M} {u v : ι →₀ ℕ} :
    monomial u (1 : R) - monomial v 1 ∈ toricIdeal R a ↔
      Finsupp.linearCombination ℕ a u = Finsupp.linearCombination ℕ a v := by
  rw [mem_toricIdeal_iff, map_sub, aeval_single_monomial, aeval_single_monomial, sub_eq_zero]
  exact (single_left_injective one_ne_zero).eq_iff

variable (R)

/-- The formation of toric ideals commutes with change of coefficients: the toric ideal over `S`
is generated by the image of the toric ideal over `R`, for any ring homomorphism `R →+* S`. -/
theorem map_toricIdeal {S : Type*} [CommRing S] (f : R →+* S) (a : ι → M) :
    (toricIdeal R a).map (map f) = toricIdeal S a := by
  rw [toricIdeal_eq_span, toricIdeal_eq_span, Ideal.map_span]
  congr 1
  ext p
  constructor
  · rintro ⟨_, ⟨u, v, h, rfl⟩, rfl⟩
    exact ⟨u, v, h, by simp⟩
  · rintro ⟨u, v, h, rfl⟩
    exact ⟨_, ⟨u, v, h, rfl⟩, by simp⟩

/-- **The binomial presentation of a semigroup algebra.** If the `a i` generate `M`, then
`X i ↦ single (a i) 1` identifies the quotient of `MvPolynomial ι R` by the toric ideal with
the semigroup algebra `R[M]`. -/
noncomputable def quotientToricIdealAlgEquiv {a : ι → M}
    (ha : AddSubmonoid.closure (Set.range a) = ⊤) :
    (MvPolynomial ι R ⧸ toricIdeal R a) ≃ₐ[R] AddMonoidAlgebra R M :=
  Ideal.quotientKerAlgEquivOfSurjective (aeval_single_surjective R ha)

/-- The presentation `quotientToricIdealAlgEquiv` sends the class of `p` to its image under
`X i ↦ single (a i) 1`. -/
@[simp]
theorem quotientToricIdealAlgEquiv_mk {a : ι → M} (ha : AddSubmonoid.closure (Set.range a) = ⊤)
    (p : MvPolynomial ι R) :
    quotientToricIdealAlgEquiv R ha (Ideal.Quotient.mk _ p) =
      aeval (fun i ↦ single (a i) (1 : R)) p :=
  Ideal.quotientKerAlgEquivOfSurjective_mk _ _

/-- The family `a`, viewed in the submonoid `AddSubmonoid.closure (Set.range a)` it generates. -/
private def toClosure (a : ι → M) (i : ι) : AddSubmonoid.closure (Set.range a) :=
  ⟨a i, AddSubmonoid.subset_closure (Set.mem_range_self i)⟩

private theorem toricIdeal_toClosure (a : ι → M) :
    toricIdeal R (toClosure a) = toricIdeal R a := by
  have h : (AddSubmonoid.closure (Set.range a)).subtype ∘ toClosure a = a := funext fun _ ↦ rfl
  rw [← toricIdeal_comp_of_injective R (toClosure a) (AddSubmonoid.subtype_injective _), h]

/-- **The binomial presentation of the semigroup algebra of `S = ⟨a i⟩`.** The map
`X i ↦ single (a i) 1` identifies the quotient of `MvPolynomial ι R` by the toric ideal with the
semigroup algebra `R[S]` of the submonoid `S` generated by the `a i`. -/
noncomputable def quotientToricIdealAlgEquivClosure (a : ι → M) :
    (MvPolynomial ι R ⧸ toricIdeal R a) ≃ₐ[R]
      AddMonoidAlgebra R (AddSubmonoid.closure (Set.range a)) :=
  (Ideal.quotientEquivAlgOfEq R (toricIdeal_toClosure R a).symm).trans
    (quotientToricIdealAlgEquiv R (closure_range_mk_eq_top a))

/-- The presentation `quotientToricIdealAlgEquivClosure` sends the class of `p` to its image under
`X i ↦ single (a i) 1`, computed in the semigroup algebra of the submonoid generated by the `a i`.
-/
@[simp]
theorem quotientToricIdealAlgEquivClosure_mk (a : ι → M) (p : MvPolynomial ι R) :
    quotientToricIdealAlgEquivClosure R a (Ideal.Quotient.mk _ p) =
      aeval (fun i ↦ single (⟨a i, AddSubmonoid.subset_closure (Set.mem_range_self i)⟩ :
        AddSubmonoid.closure (Set.range a)) (1 : R)) p :=
  quotientToricIdealAlgEquiv_mk (a := toClosure a) R (closure_range_mk_eq_top a) p

/-- **Finite binomial generation.** For finitely many exponents `a i`, there are finitely many
pairs `(u, v)` with `∑ i, u i • a i = ∑ i, v i • a i` whose binomials `X^u - X^v` generate the
toric ideal over every commutative ring. The pairs are chosen over `ℤ`, where the polynomial ring
is noetherian, and the generators are transported by change of coefficients. -/
theorem exists_finset_toricIdeal_eq_span [Finite ι] (a : ι → M) :
    ∃ P : Finset ((ι →₀ ℕ) × (ι →₀ ℕ)),
      (∀ p ∈ P, Finsupp.linearCombination ℕ a p.1 = Finsupp.linearCombination ℕ a p.2) ∧
      ∀ (R : Type u) [CommRing R],
        toricIdeal R a = Ideal.span
          ((fun p : (ι →₀ ℕ) × (ι →₀ ℕ) ↦ monomial p.1 (1 : R) - monomial p.2 1) '' P) := by
  classical
  have hfg := (IsNoetherian.noetherian (toricIdeal ℤ a) : (toricIdeal ℤ a).FG)
  rw [toricIdeal_eq_span_image] at hfg
  obtain ⟨s, hsE, hs⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).1 hfg
  obtain ⟨P, hPE, rfl⟩ := Finset.subset_set_image_iff.1 hsE
  refine ⟨P, fun p hp ↦ hPE hp, fun R _ ↦ ?_⟩
  rw [← map_toricIdeal ℤ (Int.castRingHom R), toricIdeal_eq_span_image, Ideal.span, hs,
    ← Ideal.span, Finset.coe_image, Ideal.map_span, Set.image_image]
  simp

end TauCeti
