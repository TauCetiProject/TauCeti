module

public import Mathlib.RingTheory.Polynomial.Basic

import TauCeti.RingTheory.MvPolynomial.Evaluation.Single
import TauCeti.RingTheory.MvPolynomial.Ideal

/-!
# Noetherianity of multivariate polynomial rings

By Hilbert's basis theorem (`MvPolynomial.isNoetherianRing`), `MvPolynomial σ R` is Noetherian
whenever `R` is Noetherian and `σ` is finite. Conversely, over a nontrivial commutative ring `R`,
any finite set of polynomials involves only finitely many variables, so the ideal generated by all
variables `(X_i)_{i : σ}` cannot be finitely generated when `σ` is infinite, while surjectivity of
`MvPolynomial.constantCoeff` forces `R` itself to be Noetherian whenever `MvPolynomial σ R` is.

## Main results

* `MvPolynomial.not_isNoetherianRing`: over a nontrivial commutative ring, a polynomial ring in
  infinitely many variables is never Noetherian.
* `MvPolynomial.isNoetherianRing_iff`: over a nontrivial commutative ring `R`, `MvPolynomial σ R`
  is Noetherian if and only if `R` is Noetherian and `σ` is finite.
-/

public section

namespace MvPolynomial

/-- A polynomial ring in infinitely many variables over a nontrivial commutative ring is never
Noetherian. -/
theorem not_isNoetherianRing {R σ : Type*} [CommRing R] [Nontrivial R] [Infinite σ] :
    ¬ IsNoetherianRing (MvPolynomial σ R) := by
  -- Any finite generating set for `idealOfVars σ R` misses some variable `X_i`.
  intro hnoeth
  classical
  obtain ⟨s, hs⟩ := (isNoetherianRing_iff_ideal_fg (MvPolynomial σ R)).mp hnoeth
    (MvPolynomial.idealOfVars σ R)
  obtain ⟨i, hi⟩ := Infinite.exists_notMem_finset (s.biUnion MvPolynomial.vars)
  have hle : MvPolynomial.idealOfVars σ R ≤
      RingHom.ker (MvPolynomial.eval₂Hom (RingHom.id R) (Pi.single i 1)) := by
    rw [← hs]
    refine MvPolynomial.span_le_ker_eval₂Hom_single (RingHom.id R) 1 (fun g hg ↦ ?_)
      (fun g hg hgi ↦ hi (Finset.mem_biUnion.mpr ⟨g, hg, hgi⟩))
    rw [← RingHom.mem_ker, MvPolynomial.ker_constantCoeff, ← hs]
    exact Submodule.subset_span hg
  have hXi := RingHom.mem_ker.mp (hle (Ideal.subset_span ⟨i, rfl⟩))
  simp at hXi

/-- Over a nontrivial commutative ring `R`, `MvPolynomial σ R` is Noetherian if and only if `R` is
Noetherian and `σ` is finite. -/
theorem isNoetherianRing_iff {R σ : Type*} [CommRing R] [Nontrivial R] :
    IsNoetherianRing (MvPolynomial σ R) ↔ IsNoetherianRing R ∧ Finite σ := by
  refine ⟨fun h ↦ ⟨?_, ?_⟩, fun ⟨_, _⟩ ↦ inferInstance⟩
  · exact isNoetherianRing_of_surjective (MvPolynomial σ R) R MvPolynomial.constantCoeff
      fun r ↦ ⟨MvPolynomial.C r, by simp⟩
  · by_contra hinf
    have : Infinite σ := not_finite_iff_infinite.mp hinf
    exact not_isNoetherianRing h

end MvPolynomial
