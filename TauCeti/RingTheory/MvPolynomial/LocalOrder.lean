/-!
# Taylor order and localized ideal order

At a rational point of affine space over a field, the order of a principal ideal in the
localized polynomial ring equals the Taylor order of its generator. More generally, the order
of an ideal generated by an arbitrary family is the infimum of the generators' Taylor orders.
This includes empty families, whose order is infinite, and works in every characteristic and
with arbitrarily many variables.

At an arbitrary prime `p` of `MvPolynomial σ R`, evaluating the variables in the residue field
`κ(p) = p.asIdeal.ResidueField` defines the tautological `κ(p)`-point of `MvPolynomial σ κ(p)`.
The comparison between the localized ideal order `(Ideal.span {f}).orderAt p` and the Taylor order
of `f` over `κ(p)` at this tautological point splits into two halves with distinct hypotheses:

* When `κ(p)` has no additive torsion
  (`MvPolynomial.orderAt_span_singleton_le_orderAt_map_residueField`), localized derivations map
  powers of the maximal ideal of the local ring at `p` down by one step, bounding the localized
  ideal order above by the residue-field Taylor order.
* When `κ(p)` is formally smooth over `R`
  (`MvPolynomial.orderAt_map_residueField_le_orderAt_span_singleton`), infinitesimal lifting
  produces a section of `A ⧸ 𝔪 ^ m →ₐ[R] κ(p)` on the Artinian local quotients of
  `A = Localization.AtPrime p.asIdeal`, bounding the residue-field Taylor order above by the
  localized ideal order. Over a perfect base field, `TauCeti.formallySmooth_of_perfectField`
  supplies formal smoothness without any finiteness assumption on `σ`.

Over a field of characteristic zero both hypotheses hold automatically at every prime `p` and for
every variable set `σ`, yielding equality (`MvPolynomial.orderAt_span_singleton`) and characterizing
order thresholds by membership of iterated partial derivatives in `p.asIdeal`
(`MvPolynomial.natCast_le_orderAt_span_singleton_iff_forall_foldl_pderiv_mem`,
`Ideal.natCast_le_orderAt_iff_forall_foldl_pderiv_mem`).

The local order convention and the Taylor homomorphism are discussed in Bierstone–Milman,
*Canonical desingularization in characteristic zero by blowing up the maximum strata of a
local invariant* (1997), Remark 1.8, Definition 3.4, and Proposition 4.12.
-/

public section

namespace MvPolynomial

/-- Iterated partial differentiation along a list of variables commutes with coefficient maps. -/
theorem foldl_pderiv_map {σ R S : Type*} [CommSemiring R] [CommSemiring S] (φ : R →+* S)
    (l : List σ) (f : MvPolynomial σ R) :
    l.foldl (fun q i ↦ pderiv i q) (f.map φ) = (l.foldl (fun q i ↦ pderiv i q) f).map φ := by
  induction l generalizing f with
  | nil => rfl
  | cons i l ih => rw [List.foldl_cons, List.foldl_cons, pderiv_map, ih]

section RationalPoint

variable {σ k : Type*} [Field k]

/-- A polynomial belongs to the `n`-th power of the ideal of a rational point exactly when
its Taylor order there is at least `n`. -/
theorem mem_pow_vanishingIdeal_singleton_iff (f : MvPolynomial σ k) (a : σ → k) (n : ℕ) :
    f ∈ vanishingIdeal k {a} ^ n ↔ (n : ℕ∞) ≤ f.orderAt a := by
  have hbij : Function.Bijective (taylor a) :=
    ⟨taylor_injective a, fun g ↦ ⟨taylor (-a) g, by simp [taylor_taylor]⟩⟩
  have hker : vanishingIdeal k {a} = (idealOfVars σ k).comap (taylor a) := by
    ext g
    rw [mem_vanishingIdeal_singleton_iff, Ideal.mem_comap, ← ker_constantCoeff,
      RingHom.mem_ker, constantCoeff_taylor]
    simp
  have hmap : (vanishingIdeal k {a}).map (taylor a) = idealOfVars σ k := by
    rw [hker, Ideal.map_comap_of_surjective _ hbij.2]
  rw [← Ideal.comap_map_of_bijective (taylor a) hbij
    (I := vanishingIdeal k {a} ^ n), Ideal.mem_comap, Ideal.map_pow, hmap,
    mem_pow_idealOfVars_iff', le_orderAt_iff]
  simp only [Nat.cast_lt]

end RationalPoint

end MvPolynomial

namespace Ideal

open MvPolynomial

variable {σ k : Type*} [Field k]

/-- At a rational evaluation prime, an ideal has order at least `n` precisely when each of its
polynomials has Taylor order at least `n`. -/
theorem natCast_le_orderAt_pointToPoint_iff (I : Ideal (MvPolynomial σ k)) (a : σ → k)
    (n : ℕ) :
    (n : ℕ∞) ≤ I.orderAt (pointToPoint a) ↔ ∀ f ∈ I, (n : ℕ∞) ≤ f.orderAt a := by
  let : (pointToPoint (k := k) a).asIdeal.IsMaximal :=
    inferInstanceAs (vanishingIdeal k {a}).IsMaximal
  rw [natCast_le_orderAt_iff, Ideal.map_le_iff_le_comap]
  have hpow := IsLocalization.AtPrime.under_maximalIdeal_pow
    (pointToPoint (k := k) a).asIdeal (Localization.AtPrime (pointToPoint (k := k) a).asIdeal) n
  rw [← Ideal.under_def, hpow]
  exact forall_congr' fun f ↦ forall_congr' fun _ ↦
    mem_pow_vanishingIdeal_singleton_iff f a n

end Ideal

namespace MvPolynomial

section RationalPoint

variable {σ k : Type*} [Field k]

/-- The localized order of a principal polynomial ideal at a rational point is the Taylor
order of its generator. No characteristic-zero or finiteness hypothesis is needed. -/
@[simp]
theorem orderAt_span_singleton_pointToPoint (f : MvPolynomial σ k) (a : σ → k) :
    (Ideal.span {f}).orderAt (pointToPoint a) = f.orderAt a := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  rw [Ideal.natCast_le_orderAt_pointToPoint_iff]
  simp_rw [← mem_pow_vanishingIdeal_singleton_iff]
  exact Ideal.span_singleton_le_iff_mem _

/-- Over a field of characteristic zero, the localized order of a principal ideal at a rational
point is at least `n` if and only if every iterated partial derivative of length `< n` vanishes at
that point. -/
theorem natCast_le_orderAt_span_singleton_pointToPoint_iff_eval_foldl_pderiv [CharZero k]
    (f : MvPolynomial σ k) (a : σ → k) (n : ℕ) :
    (n : ℕ∞) ≤ (Ideal.span {f}).orderAt (pointToPoint a) ↔
      ∀ l : List σ, l.length < n → eval a (l.foldl (fun q i ↦ pderiv i q) f) = 0 := by
  rw [orderAt_span_singleton_pointToPoint, le_orderAt_iff_eval_foldl_pderiv]

end RationalPoint

section ResidueField

/-- Evaluating a polynomial after mapping its coefficients into an `MvPolynomial σ R`-algebra
agrees with the algebra map when each variable is sent to its image. -/
private theorem eval_map_algebraMap {σ R A : Type*} [CommSemiring R] [CommSemiring A]
    [Algebra R A] [Algebra (MvPolynomial σ R) A] [IsScalarTower R (MvPolynomial σ R) A]
    (g : MvPolynomial σ R) :
    eval (fun i ↦ algebraMap (MvPolynomial σ R) A (X i)) (g.map (algebraMap R A)) =
      algebraMap (MvPolynomial σ R) A g := by
  induction g using MvPolynomial.induction_on with
  | C r =>
    simp [IsScalarTower.algebraMap_apply R (MvPolynomial σ R) A, ← algebraMap_eq]
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp]

/-- When the residue field `κ(p)` has no additive torsion, the localized order of `(f)` at `p` is
at most the Taylor order of `f` over `κ(p)` at the tautological `κ(p)`-point. -/
theorem orderAt_span_singleton_le_orderAt_map_residueField {σ R : Type*} [CommRing R]
    (f : MvPolynomial σ R) (p : PrimeSpectrum (MvPolynomial σ R))
    [IsAddTorsionFree p.asIdeal.ResidueField] :
    (Ideal.span {f}).orderAt p ≤
      (f.map (algebraMap R p.asIdeal.ResidueField)).orderAt
        (fun i ↦ algebraMap (MvPolynomial σ R) p.asIdeal.ResidueField (X i)) := by
  refine ENat.forall_natCast_le_iff_le.mp fun m hm ↦ ?_
  rw [Ideal.natCast_le_orderAt_iff, Ideal.map_span, Set.image_singleton,
    Ideal.span_singleton_le_iff_mem] at hm
  rw [le_orderAt_iff_eval_foldl_pderiv]
  intro l hl
  rw [foldl_pderiv_map, eval_map_algebraMap, Ideal.algebraMap_residueField_eq_zero]
  exact Derivation.foldl_mem_of_algebraMap_mem_maximalIdeal_pow
    (fun i : σ ↦ (pderiv i : Derivation R (MvPolynomial σ R) (MvPolynomial σ R))) hm hl

/-- Formal smoothness of the residue field `κ` of a local `R`-algebra `A` gives an `R`-algebra
section `κ →ₐ[R] A ⧸ 𝔪 ^ (n + 1)` lifting the residue map modulo `𝔪`. -/
private theorem exists_section_quotient_maximalIdeal_pow {R A : Type*} [CommRing R] [CommRing A]
    [IsLocalRing A] [Algebra R A] [Algebra.FormallySmooth R (IsLocalRing.ResidueField A)] (n : ℕ) :
    ∃ s : IsLocalRing.ResidueField A →ₐ[R] A ⧸ IsLocalRing.maximalIdeal A ^ (n + 1),
      ∀ a : A, Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (n + 1)) a -
        s (IsLocalRing.residue A a) ∈
          Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (n + 1)))
            (IsLocalRing.maximalIdeal A) := by
  -- Factor the residue map through `A ⧸ 𝔪 ^ (n + 1)` and verify that its kernel is nilpotent.
  have hle : IsLocalRing.maximalIdeal A ^ (n + 1) ≤ IsLocalRing.maximalIdeal A :=
    Ideal.pow_le_self (Nat.succ_ne_zero n)
  let q : A ⧸ IsLocalRing.maximalIdeal A ^ (n + 1) →ₐ[R] IsLocalRing.ResidueField A :=
    Ideal.Quotient.liftₐ (IsLocalRing.maximalIdeal A ^ (n + 1))
      (IsScalarTower.toAlgHom R A (IsLocalRing.ResidueField A))
      fun a ha ↦ (IsLocalRing.residue_eq_zero_iff a).mpr (hle ha)
  have hq_surj : Function.Surjective q := fun c ↦ by
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective c
    exact ⟨Ideal.Quotient.mk _ a, rfl⟩
  have hker : RingHom.ker q.toRingHom =
      Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (n + 1)))
        (IsLocalRing.maximalIdeal A) := by
    refine le_antisymm (fun z hz ↦ ?_) (Ideal.map_le_iff_le_comap.mpr fun a ha ↦ ?_)
    · obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      exact Ideal.mem_map_of_mem _ ((IsLocalRing.residue_eq_zero_iff a).mp hz)
    · exact (IsLocalRing.residue_eq_zero_iff a).mpr ha
  have hnil : IsNilpotent (RingHom.ker (q : A ⧸ IsLocalRing.maximalIdeal A ^ (n + 1) →+*
      IsLocalRing.ResidueField A)) := by
    refine ⟨n + 1, ?_⟩
    change RingHom.ker q.toRingHom ^ (n + 1) = 0
    rw [hker, ← Ideal.map_pow (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (n + 1)))
      (IsLocalRing.maximalIdeal A) (n + 1), Ideal.map_quotient_self, Ideal.zero_eq_bot]
  -- Infinitesimal lifting produces an `R`-algebra section `s` of `q`.
  let s := Algebra.FormallySmooth.liftOfSurjective (AlgHom.id R (IsLocalRing.ResidueField A)) q
    hq_surj hnil
  refine ⟨s, fun a ↦ ?_⟩
  rw [← hker, RingHom.mem_ker]
  have hqs : q (s (IsLocalRing.residue A a)) = IsLocalRing.residue A a :=
    AlgHom.congr_fun (Algebra.FormallySmooth.comp_liftOfSurjective
      (AlgHom.id R (IsLocalRing.ResidueField A)) q hq_surj hnil) (IsLocalRing.residue A a)
  change q (Ideal.Quotient.mk _ a - s (IsLocalRing.residue A a)) = 0
  rw [map_sub, hqs]
  exact sub_self (IsLocalRing.residue A a)

/-- In a local `R`-algebra `A` whose residue field `κ` is formally smooth over `R`, a polynomial
whose image over `κ` has Taylor order at least `m` at the residue coordinates maps into `𝔪 ^ m`. -/
private theorem mem_maximalIdeal_pow_of_le_orderAt_residueField {σ R A : Type*} [CommRing R]
    [CommRing A] [IsLocalRing A] [Algebra R A] [Algebra (MvPolynomial σ R) A]
    [IsScalarTower R (MvPolynomial σ R) A] [Algebra.FormallySmooth R (IsLocalRing.ResidueField A)]
    (f : MvPolynomial σ R) (m : ℕ)
    (hm : (m : ℕ∞) ≤ (f.map (algebraMap R (IsLocalRing.ResidueField A))).orderAt
      (fun i ↦ IsLocalRing.residue A (algebraMap (MvPolynomial σ R) A (X i)))) :
    algebraMap (MvPolynomial σ R) A f ∈ IsLocalRing.maximalIdeal A ^ m := by
  cases m with
  | zero => simp
  | succ n =>
    -- Expand `f` around `s ∘ x` in `A ⧸ 𝔪 ^ (n + 1)` using the formal-smoothness section `s`.
    obtain ⟨s, hs⟩ := exists_section_quotient_maximalIdeal_pow (R := R) (A := A) n
    let mk := Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (n + 1))
    let x : σ → IsLocalRing.ResidueField A :=
      fun i ↦ IsLocalRing.residue A (algebraMap (MvPolynomial σ R) A (X i))
    let y : σ → A ⧸ IsLocalRing.maximalIdeal A ^ (n + 1) :=
      fun i ↦ mk (algebraMap (MvPolynomial σ R) A (X i)) - s (x i)
    have heval (g : MvPolynomial σ R) : mk (algebraMap (MvPolynomial σ R) A g) =
        eval₂ s.toRingHom y (taylor x (g.map (algebraMap R (IsLocalRing.ResidueField A)))) := by
      induction g using MvPolynomial.induction_on with
      | C r =>
        rw [map_C, taylor_C, eval₂_C]
        simp [mk, IsScalarTower.algebraMap_apply R (MvPolynomial σ R) A,
          IsScalarTower.algebraMap_apply R A (A ⧸ IsLocalRing.maximalIdeal A ^ (n + 1)),
          ← algebraMap_eq]
      | add g₁ g₂ h₁ h₂ => simp [h₁, h₂]
      | mul_X g i hg => simp [hg, y]
    -- Every surviving Taylor term has degree `≥ n + 1`, so `y ^ d` vanishes modulo `𝔪 ^ (n + 1)`.
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change mk (algebraMap (MvPolynomial σ R) A f) = 0
    rw [heval f, eval₂_eq]
    refine Finset.sum_eq_zero fun d hd ↦ ?_
    have hdeg : n + 1 ≤ d.degree := by
      by_contra hlt
      exact Finsupp.mem_support_iff.mp hd
        (le_orderAt_iff.mp hm d (by exact_mod_cast Nat.lt_of_not_ge hlt))
    have hpow : Ideal.map mk (IsLocalRing.maximalIdeal A) ^ (n + 1) = ⊥ := by
      rw [← Ideal.map_pow mk (IsLocalRing.maximalIdeal A) (n + 1), Ideal.map_quotient_self]
    have hmem : ∀ u : Finset σ, ∏ i ∈ u, y i ^ d i ∈
        Ideal.map mk (IsLocalRing.maximalIdeal A) ^ (∑ i ∈ u, d i) := by
      classical
      intro u
      induction u using Finset.induction_on with
      | empty => simp
      | insert i u hi ih =>
        rw [Finset.prod_insert hi, Finset.sum_insert hi,
          pow_add (Ideal.map mk (IsLocalRing.maximalIdeal A))]
        exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (hs _) (d i)) ih
    have hprod : ∏ i ∈ d.support, y i ^ d i = 0 := by
      rw [← Ideal.mem_bot, ← hpow]
      exact Ideal.pow_le_pow_right hdeg (by simpa only [Finsupp.degree_apply] using hmem d.support)
    rw [hprod, mul_zero]

/-- When the residue field `κ(p)` is formally smooth over `R`, the Taylor order of `f` over `κ(p)`
at the tautological `κ(p)`-point is at most the localized order of `(f)` at `p`. -/
theorem orderAt_map_residueField_le_orderAt_span_singleton {σ R : Type*} [CommRing R]
    (f : MvPolynomial σ R) (p : PrimeSpectrum (MvPolynomial σ R))
    [Algebra.FormallySmooth R p.asIdeal.ResidueField] :
    (f.map (algebraMap R p.asIdeal.ResidueField)).orderAt
        (fun i ↦ algebraMap (MvPolynomial σ R) p.asIdeal.ResidueField (X i)) ≤
      (Ideal.span {f}).orderAt p := by
  refine ENat.forall_natCast_le_iff_le.mp fun m hm ↦ ?_
  rw [Ideal.natCast_le_orderAt_iff, Ideal.map_span, Set.image_singleton,
    Ideal.span_singleton_le_iff_mem]
  refine mem_maximalIdeal_pow_of_le_orderAt_residueField (A := Localization.AtPrime p.asIdeal) f m
    ?_
  convert hm using 2
  funext i
  rw [IsScalarTower.algebraMap_apply (MvPolynomial σ R) (Localization.AtPrime p.asIdeal)
    p.asIdeal.ResidueField, IsLocalRing.ResidueField.algebraMap_eq]

/-- Over a perfect field, the residue-field Taylor order of `f` at any prime `p` is at most the
localized order of `(f)` at `p`, with no finiteness assumption on the variable set `σ`. -/
theorem orderAt_map_residueField_le_orderAt_span_singleton_of_perfectField {σ k : Type*}
    [Field k] [PerfectField k] (f : MvPolynomial σ k) (p : PrimeSpectrum (MvPolynomial σ k)) :
    (f.map (algebraMap k p.asIdeal.ResidueField)).orderAt
        (fun i ↦ algebraMap (MvPolynomial σ k) p.asIdeal.ResidueField (X i)) ≤
      (Ideal.span {f}).orderAt p :=
  orderAt_map_residueField_le_orderAt_span_singleton f p

/-- When `κ(p)` is formally smooth over `R` and torsion-free as an additive group, the localized
order of `(f)` at `p` equals the Taylor order of `f` over `κ(p)` at the tautological point. -/
theorem orderAt_span_singleton_of_formallySmooth {σ R : Type*} [CommRing R]
    (f : MvPolynomial σ R) (p : PrimeSpectrum (MvPolynomial σ R))
    [Algebra.FormallySmooth R p.asIdeal.ResidueField] [IsAddTorsionFree p.asIdeal.ResidueField] :
    (Ideal.span {f}).orderAt p =
      (f.map (algebraMap R p.asIdeal.ResidueField)).orderAt
        (fun i ↦ algebraMap (MvPolynomial σ R) p.asIdeal.ResidueField (X i)) :=
  le_antisymm (orderAt_span_singleton_le_orderAt_map_residueField f p)
    (orderAt_map_residueField_le_orderAt_span_singleton f p)

/-- Over a field of characteristic zero, the localized order of a principal polynomial ideal `(f)`
at any prime `p` equals the Taylor order of `f` over `κ(p)` at the tautological `κ(p)`-point. No
finiteness hypothesis on `σ` is needed. -/
theorem orderAt_span_singleton {σ k : Type*} [Field k] [CharZero k]
    (f : MvPolynomial σ k) (p : PrimeSpectrum (MvPolynomial σ k)) :
    (Ideal.span {f}).orderAt p =
      (f.map (algebraMap k p.asIdeal.ResidueField)).orderAt
        (fun i ↦ algebraMap (MvPolynomial σ k) p.asIdeal.ResidueField (X i)) := by
  have : CharZero p.asIdeal.ResidueField :=
    charZero_of_injective_algebraMap (algebraMap k p.asIdeal.ResidueField).injective
  exact orderAt_span_singleton_of_formallySmooth f p

/-- Over a field of characteristic zero, a principal polynomial ideal `(f)` has localized order at
least `n` at a prime `p` if and only if every iterated partial derivative of `f` along a list of
length strictly less than `n` belongs to `p.asIdeal`. -/
theorem natCast_le_orderAt_span_singleton_iff_forall_foldl_pderiv_mem {σ k : Type*}
    [Field k] [CharZero k] (f : MvPolynomial σ k) (p : PrimeSpectrum (MvPolynomial σ k)) (n : ℕ) :
    (n : ℕ∞) ≤ (Ideal.span {f}).orderAt p ↔
      ∀ l : List σ, l.length < n → l.foldl (fun q i ↦ pderiv i q) f ∈ p.asIdeal := by
  have : CharZero p.asIdeal.ResidueField :=
    charZero_of_injective_algebraMap (algebraMap k p.asIdeal.ResidueField).injective
  rw [orderAt_span_singleton, le_orderAt_iff_eval_foldl_pderiv]
  refine forall_congr' fun l ↦ forall_congr' fun _ ↦ ?_
  rw [foldl_pderiv_map, eval_map_algebraMap, Ideal.algebraMap_residueField_eq_zero]

end ResidueField

end MvPolynomial

namespace Ideal

open MvPolynomial

variable {σ k : Type*} [Field k]

/-- The order of an ideal generated by any family of polynomials at a rational point is the
infimum of their Taylor orders. The empty family gives order `∞`. -/
theorem orderAt_span_range_pointToPoint {ι : Type*} (f : ι → MvPolynomial σ k) (a : σ → k) :
    (span (Set.range f)).orderAt (pointToPoint a) = ⨅ i, (f i).orderAt a := by
  rw [orderAt_span_range]
  simp_rw [orderAt_span_singleton_pointToPoint]

/-- Over a field of characteristic zero, the localized order at any prime `p` of the ideal
generated by a family of polynomials is the infimum of their residue-field Taylor orders. -/
theorem orderAt_span_range_eq_iInf_orderAt_map_residueField [CharZero k] {ι : Type*}
    (f : ι → MvPolynomial σ k) (p : PrimeSpectrum (MvPolynomial σ k)) :
    (span (Set.range f)).orderAt p =
      ⨅ i, ((f i).map (algebraMap k p.asIdeal.ResidueField)).orderAt
        (fun j ↦ algebraMap (MvPolynomial σ k) p.asIdeal.ResidueField (X j)) := by
  rw [orderAt_span_range]
  simp_rw [MvPolynomial.orderAt_span_singleton]

/-- Over a field of characteristic zero, the localized order of an ideal `I` at any prime `p` is
the infimum of the residue-field Taylor orders of elements of `I`. -/
theorem orderAt_eq_iInf_orderAt_map_residueField [CharZero k]
    (I : Ideal (MvPolynomial σ k)) (p : PrimeSpectrum (MvPolynomial σ k)) :
    I.orderAt p =
      ⨅ f ∈ I, (f.map (algebraMap k p.asIdeal.ResidueField)).orderAt
        (fun j ↦ algebraMap (MvPolynomial σ k) p.asIdeal.ResidueField (X j)) := by
  conv_lhs => rw [← span_eq I, ← Subtype.range_coe (s := (I : Set (MvPolynomial σ k)))]
  rw [orderAt_span_range_eq_iInf_orderAt_map_residueField]
  refine le_antisymm ?_ ?_
  · refine le_iInf₂ fun f hf ↦ ?_
    exact iInf_le _ (⟨f, hf⟩ : (I : Set (MvPolynomial σ k)))
  · exact le_iInf fun x ↦ iInf₂_le x.1 x.2

/-- Over a field of characteristic zero, an ideal `I` of `MvPolynomial σ k` has localized order at
least `n` at a prime `p` if and only if every iterated partial derivative of length `< n` of every
`f ∈ I` belongs to `p.asIdeal`. -/
theorem natCast_le_orderAt_iff_forall_foldl_pderiv_mem [CharZero k]
    (I : Ideal (MvPolynomial σ k)) (p : PrimeSpectrum (MvPolynomial σ k)) (n : ℕ) :
    (n : ℕ∞) ≤ I.orderAt p ↔
      ∀ f ∈ I, ∀ l : List σ, l.length < n → l.foldl (fun q i ↦ pderiv i q) f ∈ p.asIdeal := by
  rw [orderAt_eq_iInf_orderAt_map_residueField, le_iInf₂_iff]
  refine forall_congr' fun f ↦ forall_congr' fun _ ↦ ?_
  rw [← MvPolynomial.orderAt_span_singleton,
    MvPolynomial.natCast_le_orderAt_span_singleton_iff_forall_foldl_pderiv_mem]

