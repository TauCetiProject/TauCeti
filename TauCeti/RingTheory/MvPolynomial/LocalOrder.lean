module

public import Mathlib.RingTheory.Nullstellensatz
public import TauCeti.RingTheory.Ideal.Order
public import TauCeti.RingTheory.MvPolynomial.OrderAt
import TauCeti.RingTheory.MvPolynomial.Ideal

/-!
# Taylor order and localized ideal order

At a rational point of affine space over a field, the order of a principal ideal in the
localized polynomial ring equals the Taylor order of its generator. More generally, the order
of an ideal generated by an arbitrary family is the infimum of the generators' Taylor orders.
This includes empty families, whose order is infinite, and works in every characteristic and
with arbitrarily many variables. A finite ideal order is attained by one of the ideal's
polynomials.

The comparison uses the ideal generated by the variables in Taylor coordinates and Mathlib's
power-membership criterion `MvPolynomial.mem_pow_idealOfVars_iff'`. Localization preserves
membership in powers of a maximal ideal by
`IsLocalization.AtPrime.under_maximalIdeal_pow`.

The local order convention and the Taylor homomorphism are discussed in Bierstone–Milman,
*Canonical desingularization in characteristic zero by blowing up the maximum strata of a
local invariant* (1997), Remark 1.8 and Definition 3.4.
-/

public section

namespace MvPolynomial

variable {σ k : Type*} [Field k]

/-- A polynomial belongs to the `n`-th power of the ideal of a rational point exactly when
its Taylor order there is at least `n`. -/
theorem mem_pow_vanishingIdeal_singleton_iff (f : MvPolynomial σ k) (a : σ → k) (n : ℕ) :
    f ∈ vanishingIdeal k {a} ^ n ↔ (n : ℕ∞) ≤ f.orderAt a := by
  have hbij : Function.Bijective (taylor a) :=
    ⟨taylor_injective a, fun g ↦ ⟨taylor (-a) g, by simp [taylor_taylor]⟩⟩
  have hker : vanishingIdeal k {a} = (idealOfVars σ k).comap (taylor a) := by
    ext g
    rw [mem_vanishingIdeal_singleton_iff, Ideal.mem_comap, ← ker_constantCoeff,
      RingHom.mem_ker, constantCoeff_taylor]
    simp
  have hmap : (vanishingIdeal k {a}).map (taylor a) = idealOfVars σ k := by
    rw [hker, Ideal.map_comap_of_surjective _ hbij.2]
  rw [← Ideal.comap_map_of_bijective (taylor a) hbij
    (I := vanishingIdeal k {a} ^ n), Ideal.mem_comap, Ideal.map_pow, hmap,
    mem_pow_idealOfVars_iff', le_orderAt_iff]
  simp only [Nat.cast_lt]

end MvPolynomial

namespace Ideal

open MvPolynomial

variable {σ k : Type*} [Field k]

/-- At a rational evaluation prime, an ideal has order at least `n` precisely when each of its
polynomials has Taylor order at least `n`. -/
theorem natCast_le_orderAt_pointToPoint_iff (I : Ideal (MvPolynomial σ k)) (a : σ → k)
    (n : ℕ) :
    (n : ℕ∞) ≤ I.orderAt (pointToPoint a) ↔ ∀ f ∈ I, (n : ℕ∞) ≤ f.orderAt a := by
  let : (pointToPoint (k := k) a).asIdeal.IsMaximal :=
    inferInstanceAs (vanishingIdeal k {a}).IsMaximal
  rw [natCast_le_orderAt_iff, Ideal.map_le_iff_le_comap]
  have hpow := IsLocalization.AtPrime.under_maximalIdeal_pow
    (pointToPoint (k := k) a).asIdeal (Localization.AtPrime (pointToPoint (k := k) a).asIdeal) n
  rw [← Ideal.under_def, hpow]
  exact forall_congr' fun f ↦ forall_congr' fun _ ↦
    mem_pow_vanishingIdeal_singleton_iff f a n

/-- At a rational evaluation prime, an ideal has order at least `n` precisely when it lies in
the `n`-th power of the ideal of the point. -/
theorem natCast_le_orderAt_pointToPoint_iff_le_pow (I : Ideal (MvPolynomial σ k)) (a : σ → k)
    (n : ℕ) :
    (n : ℕ∞) ≤ I.orderAt (pointToPoint a) ↔ I ≤ vanishingIdeal k {a} ^ n := by
  simp_rw [natCast_le_orderAt_pointToPoint_iff, ← mem_pow_vanishingIdeal_singleton_iff]
  rfl

end Ideal

namespace MvPolynomial

variable {σ k : Type*} [Field k]

/-- The localized order of a principal polynomial ideal at a rational point is the Taylor
order of its generator. No characteristic-zero or finiteness hypothesis is needed. -/
@[simp]
theorem orderAt_span_singleton_pointToPoint (f : MvPolynomial σ k) (a : σ → k) :
    (Ideal.span {f}).orderAt (pointToPoint a) = f.orderAt a := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  rw [Ideal.natCast_le_orderAt_pointToPoint_iff]
  simp_rw [← mem_pow_vanishingIdeal_singleton_iff]
  exact Ideal.span_singleton_le_iff_mem _

end MvPolynomial

namespace Ideal

open MvPolynomial

variable {σ k : Type*} [Field k]

/-- The order of an ideal generated by any family of polynomials at a rational point is the
infimum of their Taylor orders. The empty family gives order `∞`. -/
theorem orderAt_span_range_pointToPoint {ι : Type*} (f : ι → MvPolynomial σ k) (a : σ → k) :
    (span (Set.range f)).orderAt (pointToPoint a) = ⨅ i, (f i).orderAt a := by
  rw [orderAt_span_range]
  simp_rw [orderAt_span_singleton_pointToPoint]

/-- A finite order of an ideal at a rational point is attained by one of its polynomials. -/
theorem exists_mem_orderAt_eq_of_orderAt_pointToPoint_eq {I : Ideal (MvPolynomial σ k)}
    {a : σ → k} {n : ℕ} (h : I.orderAt (pointToPoint a) = n) : ∃ f ∈ I, f.orderAt a = n := by
  have hlt : ¬ ((n + 1 : ℕ) : ℕ∞) ≤ I.orderAt (pointToPoint a) := by
    simp [h, ENat.lt_natCast_add_one_iff]
  rw [natCast_le_orderAt_pointToPoint_iff] at hlt
  push Not at hlt
  obtain ⟨f, hf, hfn⟩ := hlt
  refine ⟨f, hf, le_antisymm ?_ ((natCast_le_orderAt_pointToPoint_iff I a n).mp h.ge f hf)⟩
  exact ENat.lt_natCast_add_one_iff.mp (by exact_mod_cast hfn)

end Ideal
