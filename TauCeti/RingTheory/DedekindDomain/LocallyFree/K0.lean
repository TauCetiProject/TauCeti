/-!
# Projective `K₀` of a Dedekind domain

For a Dedekind domain `A`, the rank and the Steinitz class of finite projective modules are
additive invariants, and together they identify the split Grothendieck group of finite
projective `A`-modules:

```text
K₀(A) ≃+ ℤ × Additive (ClassGroup A),   [P] ↦ (rank P, st(P)).
```

The inverse sends `(n, c)` to `n[A] + ([I] - [A])` for any nonzero ideal `I` of class `c`, that
is, to `n[A]` plus the value at `c` of the ideal-class homomorphism
`TauCeti.FiniteProjectiveModules.idealClassHom`. Its image is the kernel of the rank, which is
therefore the locally free class group of `A` over itself
(`TauCeti.LocallyFree.mem_classGroup_iff_rankSteinitz_fst_eq_zero`); the injectivity of the
ideal-class homomorphism and its identification with the locally free class group
(`TauCeti.LocallyFree.ofIdealClassEquiv`) are in
`TauCeti.RingTheory.DedekindDomain.LocallyFree.IdealClass`.

Extension of scalars along an injective homomorphism `A → B` of Dedekind domains is
`(n, c) ↦ (n, c B)` in these coordinates
(`TauCeti.FiniteProjectiveModules.rankSteinitz_map_extendScalars`): `B` is flat over `A`, so the
extension `B ⊗[A] I` of a nonzero ideal is the extended ideal `I B`. For the localization `B` of
`A` at a submonoid `M` not containing zero, the class group computations
`ClassGroup.extendedHom_surjective_of_isLocalization` and
`ClassGroup.ker_extendedHom_of_isLocalization` therefore show that `K₀(A) → K₀(B)` is surjective,
with kernel generated by the classes `[𝔭] - [A]` of the height-one primes `𝔭` meeting `M`. The
rank coordinate is unchanged.

## Main definitions

* `TauCeti.FiniteProjectiveModules.rankSteinitz`: the homomorphism `[P] ↦ (rank P, st(P))`.
* `TauCeti.FiniteProjectiveModules.rankSteinitzEquiv`: the isomorphism
  `K₀(A) ≃+ ℤ × Additive (ClassGroup A)`.

## Main results

* `TauCeti.FiniteProjectiveModules.rankSteinitz_of`, `rankSteinitz_idealClassHom` and
  `rankSteinitzEquiv_symm_apply`: the values on projective classes and on ideal classes, and the
  inverse.
* `TauCeti.FiniteProjectiveModules.mem_range_idealClassHom_iff`: the reduced ideal classes are
  exactly the classes of rank zero.
* `TauCeti.LocallyFree.mem_classGroup_iff_rankSteinitz_fst_eq_zero`: the locally free classes are
  exactly the classes of rank zero.
* `TauCeti.FiniteProjectiveModules.map_extendScalars_idealClassHom`,
  `TauCeti.FiniteProjectiveModules.rankSteinitz_map_extendScalars`: extension of scalars along an
  injective homomorphism of Dedekind domains extends the ideal class and keeps the rank.
* `TauCeti.FiniteProjectiveModules.map_extendScalars_surjective_of_isLocalization`,
  `TauCeti.FiniteProjectiveModules.ker_map_extendScalars_of_isLocalization`: `K₀` of a localization
  of a Dedekind domain.

## References

* C. A. Weibel, *The K-book: an introduction to algebraic K-theory*, Chapter II,
  Proposition 2.6 and Corollary 2.6.3, and Chapter I, Proposition 3.4 and Exercise 3.8.
-/

public section

namespace TauCeti

universe u

variable (A : Type u) [CommRing A] [IsDedekindDomain A]

namespace FiniteProjectiveModules

/-- Rank and Steinitz class, as an additive invariant of finite projective modules. -/
private noncomputable def rankSteinitzInvariant :
    SplitK0.AdditiveInvariant (finiteProjectiveModules A).FullSubcategory
      (ℤ × Additive (ClassGroup A)) where
  obj P := (Module.finrank A P.obj, Additive.ofMul (Module.steinitzClass A P.obj))
  map_iso X Y e := by
    let e' : X.obj ≃ₗ[A] Y.obj := ((finiteProjectiveModules A).ι.mapIso e).toLinearEquiv
    rw [e'.finrank_eq, Module.steinitzClass_congr e']
  map_biprod X Y := by
    let e := biprodLinearEquiv X Y
    rw [e.finrank_eq, Module.steinitzClass_congr e,
      Module.finrank_prod_of_hasRankNullity (Module.rank_lt_aleph0 A X.obj)
        (Module.rank_lt_aleph0 A Y.obj), Module.steinitzClass_prod]
    simp

/-- The inverse of the rank–Steinitz isomorphism, `(n, c) ↦ n[A] + idealClassHom c`. -/
private noncomputable def rankSteinitzInv :
    ℤ × Additive (ClassGroup A) →+ SplitK0.{u} (finiteProjectiveModules A).FullSubcategory :=
  (zmultiplesHom (SplitK0.{u} (finiteProjectiveModules A).FullSubcategory)
    (SplitK0.of.{u} (finiteProjectiveModulesRegular A))).coprod (idealClassHom A)

/-- The homomorphism from projective `K₀` of a Dedekind domain sending the class of a finite
projective module to its rank and its Steinitz class. -/
noncomputable def rankSteinitz :
    SplitK0.{u} (finiteProjectiveModules A).FullSubcategory →+ ℤ × Additive (ClassGroup A) :=
  SplitK0.lift (rankSteinitzInvariant A)

/-- The class of a finite projective module goes to its rank and its Steinitz class. -/
@[simp]
theorem rankSteinitz_of (P : (finiteProjectiveModules A).FullSubcategory) :
    rankSteinitz A (SplitK0.of P) =
      ((Module.finrank A P.obj : ℤ), Additive.ofMul (Module.steinitzClass A P.obj)) :=
  SplitK0.lift_of _ _

/-- The class of the regular module goes to rank one and the trivial class. -/
theorem rankSteinitz_of_finiteProjectiveModulesRegular :
    rankSteinitz A (SplitK0.of.{u} (finiteProjectiveModulesRegular A)) = (1, 0) := by
  simp [finiteProjectiveModulesRegular]

/-- A reduced ideal class `[I] - [A]` has rank zero and Steinitz class `[I]`. -/
@[simp]
theorem rankSteinitz_idealClassHom (c : Additive (ClassGroup A)) :
    rankSteinitz A (idealClassHom A c) = (0, c) := by
  obtain ⟨I, hI⟩ := ClassGroup.mk0_surjective c.toMul
  have hrank : Module.finrank A (I : Ideal A) = 1 :=
    Ideal.finrank_eq_one_of_ne_bot (mem_nonZeroDivisors_iff_ne_zero.mp I.property)
  rw [← ofMul_toMul c, ← hI]
  simp [classOf_def, hrank]

/-- **Projective `K₀` of a Dedekind domain.** Rank and Steinitz class identify projective `K₀`
with `ℤ × Additive (ClassGroup A)`. -/
noncomputable def rankSteinitzEquiv :
    SplitK0.{u} (finiteProjectiveModules A).FullSubcategory ≃+ ℤ × Additive (ClassGroup A) where
  toFun := rankSteinitz A
  invFun := rankSteinitzInv A
  left_inv := DFunLike.congr_fun (show (rankSteinitzInv A).comp (rankSteinitz A) =
      AddMonoidHom.id _ from SplitK0.hom_ext fun P ↦ by
    simp [rankSteinitzInv, idealClassHom_steinitzClass, classOf_def,
      finiteProjectiveModulesRegular])
  right_inv p := by
    simp only [rankSteinitzInv, AddMonoidHom.coprod_apply, zmultiplesHom_apply, map_add,
      map_zsmul, rankSteinitz_of_finiteProjectiveModulesRegular, rankSteinitz_idealClassHom]
    ext <;> simp
  map_add' := map_add _

@[simp]
theorem rankSteinitzEquiv_apply (x : SplitK0.{u} (finiteProjectiveModules A).FullSubcategory) :
    rankSteinitzEquiv A x = rankSteinitz A x :=
  (rfl)

/-- The inverse of the rank–Steinitz isomorphism sends `(n, c)` to `n[A]` plus the reduced ideal
class `c`. -/
@[simp]
theorem rankSteinitzEquiv_symm_apply (p : ℤ × Additive (ClassGroup A)) :
    (rankSteinitzEquiv A).symm p =
      p.1 • SplitK0.of.{u} (finiteProjectiveModulesRegular A) + idealClassHom A p.2 := by
  simp [rankSteinitzEquiv, rankSteinitzInv, AddEquiv.symm_mk, AddMonoidHom.coprod_apply,
    zmultiplesHom_apply]

/-- The reduced ideal classes are exactly the classes of rank zero in projective `K₀`. -/
theorem mem_range_idealClassHom_iff
    {x : SplitK0.{u} (finiteProjectiveModules A).FullSubcategory} :
    x ∈ (idealClassHom A).range ↔ (rankSteinitz A x).1 = 0 := by
  refine ⟨?_, fun hx ↦ ⟨(rankSteinitz A x).2, (rankSteinitzEquiv A).injective ?_⟩⟩
  · rintro ⟨c, rfl⟩
    simp
  · rw [rankSteinitzEquiv_apply, rankSteinitzEquiv_apply, rankSteinitz_idealClassHom]
    exact Prod.ext hx.symm rfl

section ExtendScalars

open IsDedekindDomain
open scoped TensorProduct nonZeroDivisors

variable {A} {B : Type u} [CommRing B] [Algebra A B]

/-- **Extension of scalars on reduced ideal classes.** Along an injective homomorphism `A → B` of
Dedekind domains, extension of scalars sends the reduced class `[I] - [A]` of a nonzero ideal `I`
to the reduced class `[I B] - [B]` of the extended ideal. -/
@[simp]
theorem map_extendScalars_idealClassHom [IsDedekindDomain B] [Module.IsTorsionFree A B]
    (c : Additive (ClassGroup A)) :
    SplitK0.map.{u, u} (algebraMap A B).finiteProjectiveModulesExtendScalars (idealClassHom A c) =
      idealClassHom B (Additive.ofMul (ClassGroup.extendedHom A B c.toMul)) := by
  obtain ⟨I, hI⟩ := ClassGroup.mk0_surjective c.toMul
  rw [← ofMul_toMul c, ← hI, toMul_ofMul, ClassGroup.extendedHom_mk0]
  rw [idealClassHom_mk0, idealClassHom_mk0, map_extendScalars_classOf]
  refine classOf_congr ?_ 1
  -- The balanced extension is Mathlib's `B ⊗[A] I`, which is `I B` because `B` is flat over `A`.
  -- The underlying module of `(BalancedExtension.functor (algebraMap A B)).obj (ModuleCat.of A I)`
  -- is `BalancedExtension (algebraMap A B) I` by definition (`BalancedExtension.functor_obj`).
  exact ((BalancedExtension.extendScalarsIso (algebraMap A B)).app (ModuleCat.of A (I : Ideal A)) ≪≫
    ModuleCat.extendScalarsAlgebraMapIso (ModuleCat.of A (I : Ideal A))).toLinearEquiv.trans
      (LinearEquiv.ofBijective _ (Ideal.liftBaseChange_idealMap_bijective B (I : Ideal A)))

/-- **Extension of scalars in rank–Steinitz coordinates.** Along an injective homomorphism
`A → B` of Dedekind domains, the rank of an extended class is unchanged and its Steinitz class is
extended from `A` to `B`: in the coordinates of `rankSteinitz`, extension of scalars is
`(n, c) ↦ (n, c B)`. -/
@[simp]
theorem rankSteinitz_map_extendScalars [IsDedekindDomain B] [Module.IsTorsionFree A B]
    (x : SplitK0.{u} (finiteProjectiveModules A).FullSubcategory) :
    rankSteinitz B (SplitK0.map.{u, u} (algebraMap A B).finiteProjectiveModulesExtendScalars x) =
      ((rankSteinitz A x).1,
        Additive.ofMul (ClassGroup.extendedHom A B (rankSteinitz A x).2.toMul)) := by
  conv_lhs => rw [← (rankSteinitzEquiv A).symm_apply_apply x]
  simp only [rankSteinitzEquiv_symm_apply, rankSteinitzEquiv_apply, map_add, map_zsmul,
    SplitK0.map_of, SplitK0.of_extendScalars_obj_finiteProjectiveModulesRegular,
    map_extendScalars_idealClassHom, rankSteinitz_of_finiteProjectiveModulesRegular,
    rankSteinitz_idealClassHom]
  ext <;> simp

variable (M : Submonoid A)

include M in
/-- **`K₀` of a localization of a Dedekind domain is a quotient.** Extension of scalars from a
Dedekind domain to any of its localizations is surjective on projective `K₀`. -/
theorem map_extendScalars_surjective_of_isLocalization [IsLocalization M B] :
    Function.Surjective
      (SplitK0.map.{u, u} (algebraMap A B).finiteProjectiveModulesExtendScalars) := by
  cases subsingleton_or_nontrivial B
  · exact fun y ↦ ⟨0, Subsingleton.elim _ _⟩
  have := TauCeti.IsLocalization.isDedekindDomain_of_nontrivial M B
  -- `B` is flat, hence torsion-free, over `A`.
  have := IsLocalization.flat B M
  intro y
  obtain ⟨c, hc⟩ := ClassGroup.extendedHom_surjective_of_isLocalization M B
    (rankSteinitz B y).2.toMul
  refine ⟨(rankSteinitzEquiv A).symm ((rankSteinitz B y).1, Additive.ofMul c),
    (rankSteinitzEquiv B).injective ?_⟩
  rw [rankSteinitzEquiv_apply, rankSteinitzEquiv_apply, rankSteinitz_map_extendScalars,
    ← rankSteinitzEquiv_apply, AddEquiv.apply_symm_apply, toMul_ofMul, hc, ofMul_toMul]

/-- **The kernel of `K₀` localization of a Dedekind domain.** Extension of scalars from a
Dedekind domain `A` to its localization `B` at `M` has kernel generated by the classes
`[𝔭] - [A]` of the height-one primes `𝔭` of `A` meeting `M` (`idealClassHom_mk0` computes the
generator at `𝔭` as `[𝔭] - [A]`). The localization must not be the zero ring: inverting zero kills
all of `K₀(A)`, including `[A]`. -/
theorem ker_map_extendScalars_of_isLocalization [Nontrivial B] [IsLocalization M B] :
    (SplitK0.map.{u, u} (algebraMap A B).finiteProjectiveModulesExtendScalars).ker =
      AddSubgroup.closure ((fun v : HeightOneSpectrum A ↦
        idealClassHom A (Additive.ofMul v.classGroupMk)) ''
          {v : HeightOneSpectrum A | ∃ m ∈ M, m ∈ v.asIdeal}) := by
  have := TauCeti.IsLocalization.isDedekindDomain_of_nontrivial M B
  -- `B` is flat, hence torsion-free, over `A`.
  have := IsLocalization.flat B M
  -- The generators are the reduced classes of the kernel of extension of ideal classes.
  have hS : AddSubgroup.closure ((fun v : HeightOneSpectrum A ↦
        idealClassHom A (Additive.ofMul v.classGroupMk)) ''
          {v : HeightOneSpectrum A | ∃ m ∈ M, m ∈ v.asIdeal}) =
      (ClassGroup.extendedHom A B).ker.toAddSubgroup.map (idealClassHom A) := by
    rw [ClassGroup.ker_extendedHom_of_isLocalization M B, Subgroup.toAddSubgroup_closure,
      AddMonoidHom.map_closure]
    congr 1
    ext y
    simp [Additive.exists]
  rw [hS]
  ext x
  simp only [AddMonoidHom.mem_ker, AddSubgroup.mem_map, Additive.mem_toAddSubgroup,
    MonoidHom.mem_ker]
  constructor
  · intro hx
    have h := congrArg (rankSteinitz B) hx
    rw [rankSteinitz_map_extendScalars, map_zero, Prod.ext_iff] at h
    refine ⟨(rankSteinitz A x).2, by simpa using h.2, (rankSteinitzEquiv A).injective ?_⟩
    rw [rankSteinitzEquiv_apply, rankSteinitzEquiv_apply, rankSteinitz_idealClassHom]
    exact Prod.ext h.1.symm rfl
  · rintro ⟨c, hc, rfl⟩
    rw [map_extendScalars_idealClassHom, hc, ofMul_one, map_zero]

end ExtendScalars

end FiniteProjectiveModules

namespace LocallyFree

variable {A} {K : Type*} [Field K] [Algebra A K] [IsFractionRing A K]

open FiniteProjectiveModules

/-- The locally free class group of a Dedekind domain `A` over itself is the kernel of the rank on
projective `K₀`. -/
theorem mem_classGroup_iff_rankSteinitz_fst_eq_zero
    {x : SplitK0.{u} (finiteProjectiveModules A).FullSubcategory} :
    x ∈ classGroup A K A ↔ (rankSteinitz A x).1 = 0 := by
  rw [← mem_range_idealClassHom_iff]
  refine ⟨fun hx ↦ ?_, ?_⟩
  · obtain ⟨c, hc⟩ := ofIdealClass_surjective (K := K) ⟨x, hx⟩
    exact ⟨c, by simpa using congrArg Subtype.val hc⟩
  · rintro ⟨c, rfl⟩
    exact idealClassHom_mem_classGroup c

end LocallyFree

end TauCeti
