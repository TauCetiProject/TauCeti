public import TauCeti.Algebra.Category.ModuleCat.CartanMap.ExtendScalars
public import TauCeti.Algebra.Category.ModuleCat.FiniteProjective.StableEquivalent
public import TauCeti.RingTheory.DedekindDomain.LocallyFree.ScalarChange

/-!
# The locally free class group of an order

Let `A` be a Dedekind domain with fraction field `K` and `Λ` an `A`-algebra, for instance an
`A`-order in a finite-dimensional semisimple `K`-algebra such as `ℤ[G] ⊆ ℚ[G]`. Write `K₀(Λ)` for
the split Grothendieck group `TauCeti.SplitK0` of the finitely generated projective left
`Λ`-modules. For a finitely generated projective `Λ`-module `M` and `n : ℕ`, put

```text
c(M, n) = [M] - n[Λ] ∈ K₀(Λ).
```

When `A` is not a field, the *locally free class group* `Cl(Λ) ⊆ K₀(Λ)` is the subgroup
generated by the classes `c(M, n)` of the finitely generated projective locally free `Λ`-lattices
`M` of rank `n`. If moreover `Λ` is finite over `A`, locally free lattices are finitely generated
projective (`TauCeti.LocallyFree.IsLocallyFreeOfRank.projective`), so every locally free lattice
has a class.
Over a field there are no height-one primes, so the completion condition defining local freeness
is vacuous; `Cl(Λ)` is then defined to be trivial (`TauCeti.LocallyFree.classGroup_eq_bot`).

The class `c(M, n)` vanishes exactly when `M` is stably free, `M × Λᵏ ≃ Λⁿ⁺ᵏ` for some `k`, and
two lattices of the same rank have the same class exactly when they are stably equivalent. Classes
add on products and vanish on `Λⁿ`.

Extension of scalars along a ring homomorphism `f : Λ →+* Λ'`, for instance the inclusion of
`Λ` into a maximal order `Λ'`, sends `c(M, n)` to `c(Λ' ⊗_Λ M, n)`. Restricted to `Cl(Λ)` this is
`TauCeti.LocallyFree.classGroupK0Map`, valued in `K₀(Λ')`; its kernel is the *kernel group*
`D(Λ)`. The kernel depends only on the map into `K₀(Λ')`, of which `Cl(Λ')` is a subgroup.
For a morphism `f : Λ →ₐ[A] Γ` of `A`-algebras whose destination `Γ` is finite over `A` (the
source need not be), extension of scalars preserves locally free lattices of every rank
(`TauCeti.LocallyFree.IsLocallyFreeOfRank.extendScalars`), so it restricts to the
subgroup-valued map `TauCeti.LocallyFree.classGroupMap A K f : Cl(Λ) → Cl(Γ)`.

## Main definitions

* `TauCeti.FiniteProjectiveModules.classOf Λ M n`: the class `[M] - n[Λ]` in `K₀(Λ)`.
* `TauCeti.LocallyFree.classGroup A K Λ`: the locally free class group `Cl(Λ)`.
* `TauCeti.LocallyFree.classGroupK0Map A K f`: extension of scalars `Cl(Λ) → K₀(Λ')` along
  `f : Λ →+* Λ'`.
* `TauCeti.LocallyFree.kernelGroup A K f`: its kernel, the kernel group `D(Λ)`.
* `TauCeti.LocallyFree.classGroupMap A K f`: extension of scalars `Cl(Λ) → Cl(Γ)` along a
  morphism `f : Λ →ₐ[A] Γ` of `A`-algebras with `Γ` finite over `A`.

## Main results

* `TauCeti.FiniteProjectiveModules.classOf_eq_zero_iff`: `[M] - n[Λ] = 0` if and only if
  `M × Λᵏ ≃ Λⁿ⁺ᵏ` for some `k`.
* `TauCeti.FiniteProjectiveModules.classOf_eq_classOf_iff`: two modules have the same class
  in the same rank if and only if they are stably equivalent.
* `TauCeti.FiniteProjectiveModules.classOf_prod` and
  `TauCeti.FiniteProjectiveModules.classOf_free`: classes add on products and vanish on free
  modules.
* `TauCeti.LocallyFree.classOf_mem_classGroup` and `TauCeti.LocallyFree.classGroup_le_iff`: if
  `A` is not a field, the classes of finitely generated projective locally free lattices
  lie in `Cl(Λ)` and generate it.
* `TauCeti.LocallyFree.classGroup_eq_bot`: over a field, `Cl(Λ)` is trivial.
* `TauCeti.FiniteProjectiveModules.map_extendScalars_classOf`: extension of scalars sends
  `[M] - n[Λ]` to `[Λ' ⊗_Λ M] - n[Λ']`.
* `TauCeti.LocallyFree.classOf_mem_kernelGroup_iff`: a reduced class of a finitely generated
  projective `Λ`-module `M` known to lie in `Cl(Λ)` belongs to the kernel group exactly when
  `Λ' ⊗_Λ M` is stably free of rank `n`.
* `TauCeti.LocallyFree.kernelGroup_id`: the kernel group of the identity is trivial.
* `TauCeti.LocallyFree.classGroupMap_classOf`, `TauCeti.LocallyFree.classGroupMap_id`, and
  `TauCeti.LocallyFree.classGroupMap_comp`: the reduced-class formula for classes known to
  belong to `Cl(Λ)` and functoriality of the subgroup-valued map. For finitely generated
  projective locally free lattices, membership follows over a nonfield base;
  the map itself also exists over a field.
* `TauCeti.LocallyFree.ker_classGroupMap`: the kernel of `Cl(Λ) → Cl(Γ)` is the kernel group.

## References

* H. Johnston, *Notes on Galois modules*, Section 15.1, pp. 27–28.
* J. Voight, *Quaternion algebras*, Graduate Texts in Mathematics 288, Springer, 2021,
  Remark 20.7.13, for the identification of the stable class group with a subgroup of `K₀`.
* F. Ferri and C. Greither, *Tame Galois module structure revisited*, Introduction, pp. 2–3, for
  the kernel group.
* A. Fröhlich, *Arithmetic and Galois module structure for tame extensions*, Appendix VI,
  Proposition 2, and Appendix VII, Proposition 1, for the map `Cl(Λ) → Cl(Γ)`.
-/

public section

open CategoryTheory

namespace TauCeti.LocallyFree

universe u

open FiniteProjectiveModules

section ClassGroup

variable (A : Type*) [CommRing A] [IsDedekindDomain A] (K : Type*) [Field K] [Algebra A K]
  [IsFractionRing A K] (Λ : Type u) [Ring Λ] [Algebra A Λ]

/-- The *locally free class group* `Cl(Λ)` of `Λ` over the Dedekind domain `A`. When `A` is not a
field, it is the subgroup of the split `K₀` of finitely generated projective `Λ`-modules generated
by the classes `[M] - n[Λ]` of the finitely generated projective locally free `Λ`-lattices `M` of
rank `n`. If moreover `Λ` is finite over `A`, every locally free lattice is finitely generated
projective (`TauCeti.LocallyFree.IsLocallyFreeOfRank.projective`). If `A` is a field, local
freeness imposes no condition at the completions, as there are no height-one primes, and the
group is defined to be trivial (`classGroup_eq_bot`). -/
noncomputable def classGroup :
    AddSubgroup (SplitK0.{u} (finiteProjectiveModules Λ).FullSubcategory) :=
  AddSubgroup.closure {x | ¬IsField A ∧ ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module A M)
    (_ : Module Λ M) (_ : IsScalarTower A Λ M) (_ : Module.Finite Λ M)
    (_ : Module.Projective Λ M) (n : ℕ), IsLocallyFreeOfRank A K Λ M n ∧ classOf Λ M n = x}

variable {A} in
/-- Over a field the locally free class group is trivial. -/
theorem classGroup_eq_bot (hA : IsField A) : classGroup A K Λ = ⊥ := by
  rw [classGroup, AddSubgroup.closure_eq_bot_iff]
  rintro _ ⟨hA', -⟩
  exact (hA' hA).elim

variable {A K Λ} {M : Type u} [AddCommGroup M] [Module A M] [Module Λ M] [IsScalarTower A Λ M]
  [Module.Finite Λ M] [Module.Projective Λ M] {n : ℕ}

/-- If `A` is not a field, the class `[M] - n[Λ]` of a finitely generated projective locally
free lattice of rank `n` lies in the locally free class group. For `Λ` finite over `A`,
projectivity follows from `IsLocallyFreeOfRank.projective`. -/
theorem classOf_mem_classGroup (hA : ¬IsField A) (h : IsLocallyFreeOfRank A K Λ M n) :
    classOf Λ M n ∈ classGroup A K Λ :=
  AddSubgroup.subset_closure ⟨hA, M, _, _, _, _, _, _, n, h, rfl⟩

/-- If `A` is not a field, a subgroup contains the locally free class group if and only if it
contains the class of every finitely generated projective locally free lattice. -/
theorem classGroup_le_iff (hA : ¬IsField A)
    {H : AddSubgroup (SplitK0.{u} (finiteProjectiveModules Λ).FullSubcategory)} :
    classGroup A K Λ ≤ H ↔ ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module Λ M]
      [IsScalarTower A Λ M] [Module.Finite Λ M] [Module.Projective Λ M] (n : ℕ),
        IsLocallyFreeOfRank A K Λ M n → classOf Λ M n ∈ H := by
  refine ⟨fun hH M _ _ _ _ _ _ n h ↦ hH (classOf_mem_classGroup hA h), fun hH ↦ ?_⟩
  rw [classGroup, AddSubgroup.closure_le]
  rintro _ ⟨-, M, _, _, _, _, _, _, n, h, rfl⟩
  exact hH M n h

variable (A K) {Λ' : Type u} [Ring Λ'] (f : Λ →+* Λ')

/-- **Extension of scalars on the locally free class group.** A ring homomorphism `f : Λ →+* Λ'`
sends a class `[M] - n[Λ]` of `Cl(Λ)` to `[Λ' ⊗_Λ M] - n[Λ']`
(`FiniteProjectiveModules.map_extendScalars_classOf`). This is the restriction to `Cl(Λ)` of the
map induced on split `K₀` by extension of scalars, and its
values are taken in the split `K₀` of `Λ'`. -/
noncomputable def classGroupK0Map :
    classGroup A K Λ →+ SplitK0.{u} (finiteProjectiveModules Λ').FullSubcategory :=
  (SplitK0.map.{u, u} f.finiteProjectiveModulesExtendScalars).comp (classGroup A K Λ).subtype

/-- The ambient class-group map is the restriction of extension on split `K₀`. -/
@[simp]
theorem classGroupK0Map_apply (x : classGroup A K Λ) :
    classGroupK0Map A K f x = SplitK0.map.{u, u} f.finiteProjectiveModulesExtendScalars x :=
  (rfl)

variable {A K}

variable (A K) in
/-- The *kernel group* `D(Λ)`: the kernel of extension of scalars `Cl(Λ) → K₀(Λ')` along
`f : Λ →+* Λ'`. For the inclusion of an order `Λ` into a maximal order `Λ'` it is the kernel of
`Cl(Λ) → Cl(Λ')`, since `Cl(Λ')` is a subgroup of `K₀(Λ')`. -/
noncomputable def kernelGroup : AddSubgroup (classGroup A K Λ) :=
  (classGroupK0Map A K f).ker

theorem mem_kernelGroup_iff {x : classGroup A K Λ} :
    x ∈ kernelGroup A K f ↔ SplitK0.map.{u, u} f.finiteProjectiveModulesExtendScalars x = 0 :=
  AddMonoidHom.mem_ker

omit [Module A M] [IsScalarTower A Λ M] in
/-- A reduced class of a finitely generated projective `Λ`-module `M` known to belong to `Cl(Λ)`
lies in the kernel group exactly when `Λ' ⊗_Λ M` is stably free of rank `n`:
`(Λ' ⊗_Λ M) × Λ'ᵏ ≃ Λ'ⁿ⁺ᵏ` for some `k`. For a finitely generated projective locally free lattice
over a nonfield base, membership follows from `classOf_mem_classGroup`; if `Λ` is finite over
`A`, projectivity follows from `IsLocallyFreeOfRank.projective`. -/
theorem classOf_mem_kernelGroup_iff (hx : classOf Λ M n ∈ classGroup A K Λ) :
    ⟨classOf Λ M n, hx⟩ ∈ kernelGroup A K f ↔
      ∃ k : ℕ, Nonempty ((BalancedExtension f M × (Fin k → Λ')) ≃ₗ[Λ'] (Fin (n + k) → Λ')) := by
  rw [kernelGroup, AddMonoidHom.mem_ker, classGroupK0Map_apply, map_extendScalars_classOf,
    classOf_eq_zero_iff]

variable (A K Λ) in
/-- The ambient class-group map along the identity is the inclusion into split `K₀`. -/
@[simp]
theorem classGroupK0Map_id :
    classGroupK0Map A K (RingHom.id Λ) = (classGroup A K Λ).subtype := by
  ext x
  apply fromSplit_finiteProjectiveModules_injective Λ
  simpa only [classGroupK0Map_apply, AddMonoidHom.comp_apply,
    RingHom.finiteProjectiveModulesK0Extend_id, AddMonoidHom.id_apply,
    AddSubgroup.subtype_apply] using
      (DFunLike.congr_fun (RingHom.id Λ).finiteProjectiveModulesK0Extend_comp_fromSplit
        (x : SplitK0.{u} (finiteProjectiveModules Λ).FullSubcategory)).symm

variable (A K Λ) in
/-- The kernel group of the identity is trivial. -/
@[simp]
theorem kernelGroup_id : kernelGroup A K (RingHom.id Λ) = ⊥ := by
  ext x
  rw [kernelGroup, classGroupK0Map_id, AddMonoidHom.mem_ker, AddSubgroup.subtype_apply,
    ZeroMemClass.coe_eq_zero, AddSubgroup.mem_bot]

end ClassGroup

section ClassGroupMap

attribute [local instance low] BalancedExtension.moduleBase

variable {A : Type*} [CommRing A] [IsDedekindDomain A] {K : Type*} [Field K] [Algebra A K]
  [IsFractionRing A K] {Λ Γ : Type u} [Ring Λ] [Ring Γ] [Algebra A Λ] [Algebra A Γ]
  [Module.Finite A Γ] (f : Λ →ₐ[A] Γ)

/-- Scalar extension sends the locally free class subgroup into the destination subgroup. -/
theorem classGroupK0Map_mem_classGroup (x : classGroup A K Λ) :
    classGroupK0Map A K (RingHomClass.toRingHom f) x ∈ classGroup A K Γ := by
  classical
  by_cases hA : IsField A
  · have hx : x = 0 := Subtype.ext (by simpa [classGroup_eq_bot K Λ hA] using x.property)
    simp [hx]
  have hle : classGroup A K Λ ≤ (classGroup A K Γ).comap
      (SplitK0.map.{u, u} (RingHomClass.toRingHom f).finiteProjectiveModulesExtendScalars) := by
    rw [classGroup_le_iff hA]
    intro M _ _ _ _ _ _ n h
    rw [AddSubgroup.mem_comap]
    rw [map_extendScalars_classOf]
    exact classOf_mem_classGroup hA (h.extendScalars f)
  simpa only [classGroupK0Map_apply, AddSubgroup.mem_comap] using hle x.property

variable (A K) in
/-- Extension of scalars on locally free class groups, for a morphism of algebras whose
destination is finite over the central Dedekind base. This includes inclusions of orders. -/
noncomputable def classGroupMap : classGroup A K Λ →+ classGroup A K Γ :=
  (classGroupK0Map A K (RingHomClass.toRingHom f)).codRestrict (classGroup A K Γ)
    (classGroupK0Map_mem_classGroup f)

/-- The class-group map agrees with scalar extension in ambient projective `K₀`. -/
@[simp]
theorem coe_classGroupMap (x : classGroup A K Λ) :
    (classGroupMap A K f x : SplitK0.{u} (finiteProjectiveModules Γ).FullSubcategory) =
      classGroupK0Map A K (RingHomClass.toRingHom f) x := (rfl)

variable {M : Type u} [AddCommGroup M] [Module Λ M]
  [Module.Finite Λ M] [Module.Projective Λ M] {n : ℕ}

/-- Extension sends a reduced class known to lie in `Cl(Λ)` to the reduced class of `Γ ⊗_Λ M`.
For a finitely generated projective locally free lattice over a nonfield base, the membership
hypothesis is supplied by `classOf_mem_classGroup`. The formula also accepts any other proof
of membership, including over a field. -/
@[simp]
theorem classGroupMap_classOf (hx : classOf Λ M n ∈ classGroup A K Λ) :
    classGroupMap A K f ⟨classOf Λ M n, hx⟩ =
      ⟨classOf Γ (BalancedExtension (RingHomClass.toRingHom f) M) n, by
        simpa only [classGroupK0Map_apply, map_extendScalars_classOf] using
          classGroupK0Map_mem_classGroup f ⟨classOf Λ M n, hx⟩⟩ := by
  apply Subtype.ext
  rw [coe_classGroupMap, classGroupK0Map_apply, map_extendScalars_classOf]

/-- The kernel of the subgroup-valued scalar map is the kernel group, as computed in `K₀`. -/
@[simp]
theorem ker_classGroupMap :
    (classGroupMap A K f).ker = kernelGroup A K (RingHomClass.toRingHom f) := by
  unfold classGroupMap kernelGroup
  exact AddMonoidHom.ker_codRestrict _ _ _

variable (A K Λ) in
/-- Extension of scalars along the identity is the identity of `Cl(Λ)`. -/
@[simp]
theorem classGroupMap_id [Module.Finite A Λ] :
    classGroupMap A K (AlgHom.id A Λ) = AddMonoidHom.id _ :=
  AddMonoidHom.ext fun x ↦ Subtype.ext <| by
    simp only [coe_classGroupMap, AlgHom.id_toRingHom, classGroupK0Map_id,
      AddSubgroup.subtype_apply, AddMonoidHom.id_apply]

/-- Extension of scalars along a composite is the composite of the class-group maps. -/
@[simp]
theorem classGroupMap_comp {Γ' : Type u} [Ring Γ'] [Algebra A Γ'] [Module.Finite A Γ']
    (g : Γ →ₐ[A] Γ') :
    classGroupMap A K (g.comp f) = (classGroupMap A K g).comp (classGroupMap A K f) :=
  AddMonoidHom.ext fun x ↦ Subtype.ext <| by
    simp only [coe_classGroupMap, AddMonoidHom.comp_apply, classGroupK0Map_apply,
      AlgHom.comp_toRingHom]
    apply fromSplit_finiteProjectiveModules_injective Γ'
    have hn (R S : Type u) [Ring R] [Ring S] (k : R →+* S) (y) :=
      DFunLike.congr_fun k.finiteProjectiveModulesK0Extend_comp_fromSplit y
    simp only [AddMonoidHom.comp_apply] at hn
    rw [← hn _ _ ((RingHomClass.toRingHom g).comp (RingHomClass.toRingHom f)),
      ← hn _ _ (RingHomClass.toRingHom g), ← hn _ _ (RingHomClass.toRingHom f)]
    simp only [RingHom.finiteProjectiveModulesK0Extend_comp, AddMonoidHom.comp_apply]

end ClassGroupMap

end TauCeti.LocallyFree
