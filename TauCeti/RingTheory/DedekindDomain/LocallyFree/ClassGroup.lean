module

public import TauCeti.Algebra.Category.ModuleCat.FiniteProjective.ScalarChange
public import TauCeti.Algebra.Category.ModuleCat.FiniteProjective.StableEquivalent
public import TauCeti.RingTheory.DedekindDomain.LocallyFree.Basic

/-!
# The locally free class group of an order

Let `A` be a Dedekind domain with fraction field `K` and `Λ` an `A`-algebra, for instance an
`A`-order in a finite-dimensional semisimple `K`-algebra such as `ℤ[G] ⊆ ℚ[G]`. Write `K₀(Λ)` for
the split Grothendieck group `TauCeti.SplitK0` of the finitely generated projective left
`Λ`-modules. For a finitely generated projective `Λ`-module `M` and `n : ℕ`, put

```text
c(M, n) = [M] - n[Λ] ∈ K₀(Λ).
```

The *locally free class group* `Cl(Λ) ⊆ K₀(Λ)` is the subgroup generated by the classes
`c(M, n)` of the locally free `Λ`-lattices `M` of rank `n`. When `A` is not a field and `Λ` is
finite over `A`, locally free lattices are finitely generated projective
(`TauCeti.LocallyFree.IsLocallyFreeOfRank.projective`), so every locally free lattice has a class.
Over a field there are no height-one primes, so the completion condition defining local freeness
is vacuous; `Cl(Λ)` is then defined to be trivial (`TauCeti.LocallyFree.classGroup_eq_bot`).

The class `c(M, n)` vanishes exactly when `M` is stably free, `M × Λᵏ ≃ Λⁿ⁺ᵏ` for some `k`, and
two lattices of the same rank have the same class exactly when they are stably equivalent. Classes
add on products and vanish on `Λⁿ`.

Extension of scalars along a ring homomorphism `f : Λ →+* Λ'`, for instance the inclusion of
`Λ` into a maximal order `Λ'`, sends `c(M, n)` to `c(Λ' ⊗_Λ M, n)`. Restricted to `Cl(Λ)` this is
`TauCeti.LocallyFree.classGroupMap`, valued in `K₀(Λ')`; its kernel is the *kernel group*
`D(Λ)`. The kernel depends only on the map into `K₀(Λ')`, of which `Cl(Λ')` is a subgroup.

## Main definitions

* `TauCeti.FiniteProjectiveModules.classOf Λ M n`: the class `[M] - n[Λ]` in `K₀(Λ)`.
* `TauCeti.LocallyFree.classGroup A K Λ`: the locally free class group `Cl(Λ)`.
* `TauCeti.LocallyFree.classGroupMap A K f`: extension of scalars `Cl(Λ) → K₀(Λ')` along
  `f : Λ →+* Λ'`.
* `TauCeti.LocallyFree.kernelGroup A K f`: its kernel, the kernel group `D(Λ)`.

## Main results

* `TauCeti.FiniteProjectiveModules.classOf_eq_zero_iff`: `[M] - n[Λ] = 0` if and only if
  `M × Λᵏ ≃ Λⁿ⁺ᵏ` for some `k`.
* `TauCeti.FiniteProjectiveModules.classOf_eq_classOf_iff`: two modules have the same class
  in the same rank if and only if they are stably equivalent.
* `TauCeti.FiniteProjectiveModules.classOf_prod` and
  `TauCeti.FiniteProjectiveModules.classOf_free`: classes add on products and vanish on free
  modules.
* `TauCeti.LocallyFree.classOf_mem_classGroup` and `TauCeti.LocallyFree.classGroup_le_iff`: if
  `A` is not a field, the classes of locally free lattices lie in `Cl(Λ)` and generate it.
* `TauCeti.LocallyFree.classGroup_eq_bot`: over a field, `Cl(Λ)` is trivial.
* `TauCeti.LocallyFree.classGroupMap_classOf`: extension of scalars sends `[M] - n[Λ]` to
  `[Λ' ⊗_Λ M] - n[Λ']`.
* `TauCeti.LocallyFree.classOf_mem_kernelGroup_iff`: the class of a locally free lattice `M` lies
  in the kernel group exactly when `Λ' ⊗_Λ M` is stably free.
* `TauCeti.LocallyFree.kernelGroup_id`: the kernel group of the identity is trivial.

## References

* H. Johnston, *Notes on Galois modules*, Section 15.1, pp. 27–28.
* J. Voight, *Quaternion algebras*, Graduate Texts in Mathematics 288, Springer, 2021,
  Remark 20.7.13, for the identification of the stable class group with a subgroup of `K₀`.
* F. Ferri and C. Greither, *Tame Galois module structure revisited*, Introduction, pp. 2–3, for
  the kernel group.
-/

public section

open CategoryTheory

namespace TauCeti.LocallyFree

universe u

open FiniteProjectiveModules

section ClassGroup

variable (A : Type*) [CommRing A] [IsDedekindDomain A] (K : Type*) [Field K] [Algebra A K]
  [IsFractionRing A K] (Λ : Type u) [Ring Λ] [Algebra A Λ]

/-- The *locally free class group* `Cl(Λ)` of `Λ` over the Dedekind domain `A`: the subgroup of
the split `K₀` of finitely generated projective `Λ`-modules generated by the classes
`[M] - n[Λ]` of the finitely generated projective locally free `Λ`-lattices `M` of rank `n`. When
`A` is not a field and `Λ` is finite over `A`, every locally free lattice is finitely generated
projective (`TauCeti.LocallyFree.IsLocallyFreeOfRank.projective`). If `A` is a field, local
freeness imposes no condition at the completions, as there are no height-one primes, and the
group is defined to be trivial (`classGroup_eq_bot`). -/
noncomputable def classGroup :
    AddSubgroup (SplitK0.{u} (finiteProjectiveModules Λ).FullSubcategory) :=
  AddSubgroup.closure {x | ¬IsField A ∧ ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module A M)
    (_ : Module Λ M) (_ : IsScalarTower A Λ M) (_ : Module.Finite Λ M)
    (_ : Module.Projective Λ M) (n : ℕ), IsLocallyFreeOfRank A K Λ M n ∧ classOf Λ M n = x}

variable {A} in
/-- Over a field the locally free class group is trivial. -/
theorem classGroup_eq_bot (hA : IsField A) : classGroup A K Λ = ⊥ := by
  rw [classGroup, AddSubgroup.closure_eq_bot_iff]
  rintro _ ⟨hA', -⟩
  exact (hA' hA).elim

variable {A K Λ} {M : Type u} [AddCommGroup M] [Module A M] [Module Λ M] [IsScalarTower A Λ M]
  [Module.Finite Λ M] [Module.Projective Λ M] {n : ℕ}

/-- If `A` is not a field, the class `[M] - n[Λ]` of a locally free lattice of rank `n` lies in
the locally free class group. -/
theorem classOf_mem_classGroup (hA : ¬IsField A) (h : IsLocallyFreeOfRank A K Λ M n) :
    classOf Λ M n ∈ classGroup A K Λ :=
  AddSubgroup.subset_closure ⟨hA, M, _, _, _, _, _, _, n, h, rfl⟩

/-- If `A` is not a field, a subgroup contains the locally free class group if and only if it
contains the class of every finitely generated projective locally free lattice. -/
theorem classGroup_le_iff (hA : ¬IsField A)
    {H : AddSubgroup (SplitK0.{u} (finiteProjectiveModules Λ).FullSubcategory)} :
    classGroup A K Λ ≤ H ↔ ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module Λ M]
      [IsScalarTower A Λ M] [Module.Finite Λ M] [Module.Projective Λ M] (n : ℕ),
        IsLocallyFreeOfRank A K Λ M n → classOf Λ M n ∈ H := by
  refine ⟨fun hH M _ _ _ _ _ _ n h ↦ hH (classOf_mem_classGroup hA h), fun hH ↦ ?_⟩
  rw [classGroup, AddSubgroup.closure_le]
  rintro _ ⟨-, M, _, _, _, _, _, _, n, h, rfl⟩
  exact hH M n h

variable (A K) {Λ' : Type u} [Ring Λ'] (f : Λ →+* Λ')

/-- **Extension of scalars on the locally free class group.** A ring homomorphism `f : Λ →+* Λ'`
sends a class `[M] - n[Λ]` of `Cl(Λ)` to `[Λ' ⊗_Λ M] - n[Λ']` (`classGroupMap_classOf`). This is
the restriction to `Cl(Λ)` of the map induced on split `K₀` by extension of scalars, and its
values are taken in the split `K₀` of `Λ'`. -/
noncomputable def classGroupMap :
    classGroup A K Λ →+ SplitK0.{u} (finiteProjectiveModules Λ').FullSubcategory :=
  (SplitK0.map.{u, u} f.finiteProjectiveModulesExtendScalars).comp (classGroup A K Λ).subtype

theorem classGroupMap_apply (x : classGroup A K Λ) :
    classGroupMap A K f x = SplitK0.map.{u, u} f.finiteProjectiveModulesExtendScalars x :=
  (rfl)

variable {A K}

/-- If `A` is not a field, extension of scalars sends `[M] - n[Λ]` to `[Λ' ⊗_Λ M] - n[Λ']`. -/
theorem classGroupMap_classOf (hA : ¬IsField A) (h : IsLocallyFreeOfRank A K Λ M n) :
    classGroupMap A K f ⟨classOf Λ M n, classOf_mem_classGroup hA h⟩ =
      classOf Λ' (BalancedExtension f M) n := by
  rw [classGroupMap_apply, Subtype.coe_mk, classOf_def, classOf_def, map_sub, map_nsmul,
    SplitK0.map_of, SplitK0.map_of,
    SplitK0.of_extendScalars_obj (Q := ⟨ModuleCat.of Λ' (BalancedExtension f M),
      finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩) (.refl _ _),
    -- `Λ' ⊗_Λ Λ ≃ Λ'`, through `Λ ≃ Λ¹` and `Λ' ⊗_Λ Λ¹ ≃ Λ'¹`.
    SplitK0.of_extendScalars_obj (Q := ⟨ModuleCat.of Λ' Λ',
      finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩)
      ((BalancedExtension.congr f (LinearEquiv.funUnique (Fin 1) Λ Λ).symm).trans
        ((BalancedExtension.piScalarRight f (Fin 1)).trans (LinearEquiv.funUnique (Fin 1) Λ' Λ')))]

variable (A K) in
/-- The *kernel group* `D(Λ)`: the kernel of extension of scalars `Cl(Λ) → K₀(Λ')` along
`f : Λ →+* Λ'`. For the inclusion of an order `Λ` into a maximal order `Λ'` it is the kernel of
`Cl(Λ) → Cl(Λ')`, since `Cl(Λ')` is a subgroup of `K₀(Λ')`. -/
noncomputable def kernelGroup : AddSubgroup (classGroup A K Λ) :=
  (classGroupMap A K f).ker

theorem mem_kernelGroup_iff {x : classGroup A K Λ} :
    x ∈ kernelGroup A K f ↔ SplitK0.map.{u, u} f.finiteProjectiveModulesExtendScalars x = 0 :=
  AddMonoidHom.mem_ker

/-- If `A` is not a field, the class of a locally free lattice `M` of rank `n` lies in the kernel
group exactly when `Λ' ⊗_Λ M` is stably free of rank `n`: `(Λ' ⊗_Λ M) × Λ'ᵏ ≃ Λ'ⁿ⁺ᵏ` for some
`k`. -/
theorem classOf_mem_kernelGroup_iff (hA : ¬IsField A) (h : IsLocallyFreeOfRank A K Λ M n) :
    ⟨classOf Λ M n, classOf_mem_classGroup hA h⟩ ∈ kernelGroup A K f ↔
      ∃ k : ℕ, Nonempty ((BalancedExtension f M × (Fin k → Λ')) ≃ₗ[Λ'] (Fin (n + k) → Λ')) := by
  rw [kernelGroup, AddMonoidHom.mem_ker, classGroupMap_classOf f hA h, classOf_eq_zero_iff]

variable (A K Λ) in
/-- The kernel group of the identity is trivial. -/
@[simp]
theorem kernelGroup_id : kernelGroup A K (RingHom.id Λ) = ⊥ := by
  -- Extension of scalars along the identity is isomorphic to the identity functor, `Λ ⊗_Λ P ≃ P`.
  have hmap : SplitK0.map.{u, u} (RingHom.id Λ).finiteProjectiveModulesExtendScalars =
      AddMonoidHom.id _ := by
    rw [SplitK0.map_congr.{u, u} (G := 𝟭 _) fun P ↦
      ⟨ObjectProperty.isoMk _ (eqToIso ((RingHom.id Λ).finiteProjectiveModulesExtendScalars_obj_obj
        P) ≪≫ (BalancedExtension.lid Λ P.obj).toModuleIso)⟩, SplitK0.map_id]
  ext x
  rw [mem_kernelGroup_iff, hmap, AddMonoidHom.id_apply, AddSubgroup.mem_bot,
    ZeroMemClass.coe_eq_zero]

end ClassGroup

end TauCeti.LocallyFree
