/-!
# The Steinitz class of a finite projective module over a Dedekind domain

Over a Dedekind domain `R`, a finite flat (equivalently, finite projective) module `M` is
isomorphic to a finite product `J₁ × ⋯ × Jₙ` of nonzero ideals
(`Module.exists_linearEquiv_pi_ideal`). The ideals themselves are not determined by `M`, but the
class of their product in the ideal class group is: this is the *Steinitz class* of `M`.

The invariance rests on a determinant computation. The ideal generated by the determinants of
the square matrices whose `i`-th row lies in `Iᵢ` is `∏ Iᵢ`
(`Matrix.span_det_eq_prod_row_ideals`). A linear
isomorphism `∏ᵢ Iᵢ ≃ ∏ⱼ Jⱼ` multiplies all such determinants by one fixed ratio of nonzero ring
elements, so `∏ Iᵢ` and `∏ Jⱼ` differ by principal ideals
(`ClassGroup.mk0_prod_eq_of_linearEquiv`). The Steinitz class is multiplicative on products,
trivial on free modules, and the class of a nonzero ideal is its ideal class. The same
decomposition computes the rank: `M ≃ J₁ × ⋯ × Jₙ` has `finrank R M = n`
(`Module.finrank_eq_card_of_linearEquiv_pi`).

## Main definitions

* `Module.steinitzClass R M`: the Steinitz class of a finite flat module over a Dedekind domain.

## Main results

* `ClassGroup.mk0_prod_eq_of_linearEquiv`: isomorphic finite products of nonzero ideals have
  products in the same ideal class.
* `Module.steinitzClass_eq_of_linearEquiv_pi`: the Steinitz class is the class of the product of
  the ideals in any decomposition `M ≃ ∏ᵢ Jᵢ`.
* `Module.steinitzClass_congr`, `Module.steinitzClass_prod`, `Module.steinitzClass_eq_one_of_free`
  and `Module.steinitzClass_ideal`: invariance under isomorphism, multiplicativity, and the values
  on free modules and on nonzero ideals.

## References

* J. Voight, *Quaternion Algebras*, Graduate Texts in Mathematics 288, Springer, 2021,
  Theorem 9.3.9 and Exercise 9.7 (the Steinitz class and its well-definedness).
* C. A. Weibel, *The K-book: an introduction to algebraic K-theory*, Chapter I, §3,
  Propositions 3.4–3.5.
-/

public section

open Module Matrix
open scoped nonZeroDivisors Pointwise

section Invariance

variable {R ι : Type*} [CommRing R] [IsDomain R] [Fintype ι] [DecidableEq ι]
  {I J : ι → Ideal R}

omit [IsDomain R] [Fintype ι] in
/-- A linear map out of a product of ideals satisfies `a • f (single i x) = x • f (single i a)`
for `a, x ∈ I i`. -/
private theorem smul_apply_single (f : ((i : ι) → I i) →ₗ[R] (i : ι) → J i) (i : ι)
    (x a : I i) : (a : R) • f (Pi.single i x) = (x : R) • f (Pi.single i a) := by
  rw [← map_smul, ← map_smul]
  congr 1
  ext j : 1
  rcases eq_or_ne j i with rfl | h
  · exact Subtype.ext (by simp [mul_comm])
  · simp [h]

omit [IsDomain R] in
/-- Coordinates of the image of `v` under a linear map `f` out of a product of ideals, after
scaling by `∏ aₖ`, in terms of the columns `f (single i aᵢ)`. -/
private theorem prod_mul_apply (f : ((i : ι) → I i) →ₗ[R] (i : ι) → J i)
    (a v : (i : ι) → I i) (j : ι) :
    (∏ k, (a k : R)) * (f v j : R) =
      ∑ i, (f (Pi.single i (a i)) j : R) * ((∏ k ∈ Finset.univ.erase i, (a k : R)) * v i) := by
  conv_lhs => rw [← Finset.univ_sum_single v]
  rw [map_sum, Finset.sum_apply, Submodule.coe_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  have h := congrArg (fun u : (k : ι) → J k ↦ (u j : R)) (smul_apply_single f i (v i) (a i))
  simp only [Pi.smul_apply, SetLike.val_smul, smul_eq_mul] at h
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ i)]
  linear_combination (∏ k ∈ Finset.univ.erase i, (a k : R)) * h

/-- Determinants of `n` vectors of a product of ideals and of their images under a linear map `f`
are related by the determinant of the columns `f (single i aᵢ)`. -/
private theorem prod_mul_det (f : ((i : ι) → I i) →ₗ[R] (i : ι) → J i)
    (a : (i : ι) → I i) (ha : ∀ i, (a i : R) ≠ 0) (V : ι → (i : ι) → I i) :
    (∏ k, (a k : R)) * (of fun j l ↦ (f (V l) j : R)).det =
      (of fun j i ↦ (f (Pi.single i (a i)) j : R)).det * (of fun i l ↦ (V l i : R)).det := by
  set α := ∏ k, (a k : R)
  set β : ι → R := fun i ↦ ∏ k ∈ Finset.univ.erase i, (a k : R)
  have hmat : α • (of fun j l ↦ (f (V l) j : R)) =
      (of fun j i ↦ (f (Pi.single i (a i)) j : R)) * (diagonal β * of fun i l ↦ (V l i : R)) := by
    ext j l
    rw [Matrix.smul_apply, Matrix.mul_apply, smul_eq_mul, of_apply, prod_mul_apply]
    simp [diagonal_mul, β]
  have hdet := congrArg det hmat
  rw [det_smul, det_mul, det_mul, det_diagonal] at hdet
  have hβ : (∏ i, β i) * α = α ^ Fintype.card ι := by
    simp only [β, α, ← Finset.prod_mul_distrib, Finset.prod_erase_mul _ _ (Finset.mem_univ _),
      Finset.prod_const, Finset.card_univ]
  have hα : α ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ ↦ ha i
  apply mul_left_cancel₀ (pow_ne_zero (Fintype.card ι) hα)
  linear_combination α * hdet + (of fun j i ↦ (f (Pi.single i (a i)) j : R)).det *
    (of fun i l ↦ (V l i : R)).det * hβ

omit [DecidableEq ι] in
/-- A linear isomorphism `∏ Iᵢ ≃ ∏ Jᵢ` of products of ideals, the `Iᵢ` nonzero, forces
`a • ∏ Jᵢ = b • ∏ Iᵢ` for some ring elements `a ≠ 0` and `b`. -/
private theorem exists_span_singleton_mul_prod_eq (hI : ∀ i, I i ≠ ⊥)
    (e : ((i : ι) → I i) ≃ₗ[R] (i : ι) → J i) :
    ∃ a : R, a ≠ 0 ∧ ∃ b : R, Ideal.span {a} * ∏ i, J i = Ideal.span {b} * ∏ i, I i := by
  classical
  choose a ha ha0 using fun i ↦ Submodule.exists_mem_ne_zero_of_ne_bot (hI i)
  let a' : (i : ι) → I i := fun i ↦ ⟨a i, ha i⟩
  refine ⟨∏ i, a i, Finset.prod_ne_zero_iff.mpr fun i _ ↦ ha0 i,
    (of fun j i ↦ (e (Pi.single i (a' i)) j : R)).det, ?_⟩
  rw [← span_det_eq_prod_row_ideals J, ← span_det_eq_prod_row_ideals I, Ideal.span_mul_span,
    Ideal.span_mul_span, Set.singleton_mul, Set.singleton_mul]
  congr 1
  ext x
  constructor
  · rintro ⟨_, ⟨M, hM, rfl⟩, rfl⟩
    let V : ι → (i : ι) → I i := fun l ↦ e.symm fun j ↦ ⟨M j l, hM j l⟩
    refine ⟨_, ⟨of fun i l ↦ (V l i : R), fun i l ↦ (V l i).property, rfl⟩, ?_⟩
    have h := prod_mul_det e.toLinearMap a' ha0 V
    simp only [V, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply] at h
    exact h.symm
  · rintro ⟨_, ⟨M, hM, rfl⟩, rfl⟩
    let V : ι → (i : ι) → I i := fun l i ↦ ⟨M i l, hM i l⟩
    refine ⟨_, ⟨of fun j l ↦ (e (V l) j : R), fun j l ↦ (e (V l) j).property, rfl⟩, ?_⟩
    exact prod_mul_det e.toLinearMap a' ha0 V

end Invariance

/-- **Invariance of the Steinitz class.** Isomorphic finite products of nonzero ideals of a
Dedekind domain have products in the same ideal class. -/
theorem ClassGroup.mk0_prod_eq_of_linearEquiv {R ι κ : Type*} [CommRing R] [IsDedekindDomain R]
    [Fintype ι] [Fintype κ] {I : ι → (Ideal R)⁰} {J : κ → (Ideal R)⁰}
    (e : ((i : ι) → (I i : Ideal R)) ≃ₗ[R] (k : κ) → (J k : Ideal R)) :
    ClassGroup.mk0 (∏ i, I i) = ClassGroup.mk0 (∏ k, J k) := by
  classical
  have hI (i : ι) : (I i : Ideal R) ≠ ⊥ := mem_nonZeroDivisors_iff_ne_zero.mp (I i).property
  have hJ (k : κ) : (J k : Ideal R) ≠ ⊥ := mem_nonZeroDivisors_iff_ne_zero.mp (J k).property
  have hcard : Fintype.card ι = Fintype.card κ := by
    have := e.lift_rank_eq
    rw [Module.rank_pi_ideal hI, Module.rank_pi_ideal hJ, Cardinal.lift_natCast,
      Cardinal.lift_natCast] at this
    exact_mod_cast this
  let σ : ι ≃ κ := Fintype.equivOfCardEq hcard
  obtain ⟨a, ha, b, hab⟩ := exists_span_singleton_mul_prod_eq hI
    (e.trans (LinearEquiv.piCongrLeft R (fun k ↦ (J k : Ideal R)) σ).symm)
  rw [← Equiv.prod_comp σ (fun k ↦ J k)]
  have hJprod : ∏ i, (J (σ i) : Ideal R) ≠ ⊥ := by
    simpa [Submonoid.coe_finsetProd] using
      mem_nonZeroDivisors_iff_ne_zero.mp (∏ i, J (σ i)).property
  have hb : b ≠ 0 := by
    rintro rfl
    rw [Ideal.span_singleton_eq_bot.mpr rfl, Ideal.bot_mul, Ideal.mul_eq_bot,
      Ideal.span_singleton_eq_bot] at hab
    exact hab.elim ha hJprod
  exact ClassGroup.mk0_eq_mk0_iff.mpr ⟨b, a, hb, ha, by simpa [Submonoid.coe_finsetProd] using
    hab.symm⟩

namespace Module

variable (R : Type*) [CommRing R] [IsDedekindDomain R]
  (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Flat R M]
  {N : Type*} [AddCommGroup N] [Module R N] [Module.Finite R N] [Module.Flat R N]

/-- The **Steinitz class** of a finite flat module `M` over a Dedekind domain: the ideal class of
`J₁ ⋯ Jₙ` for any decomposition `M ≃ J₁ × ⋯ × Jₙ` into nonzero ideals. It does not depend on the
decomposition (`Module.steinitzClass_eq_of_linearEquiv_pi`). -/
noncomputable def steinitzClass : ClassGroup R :=
  let h := exists_linearEquiv_pi_ideal R (FractionRing R) M
  ClassGroup.mk0 (∏ i, ⟨h.choose i, mem_nonZeroDivisors_of_ne_zero (h.choose_spec.1 i)⟩)

/-- The Steinitz class is the ideal class of the product of the ideals in any decomposition of the
module into a finite product of nonzero ideals. -/
theorem steinitzClass_eq_of_linearEquiv_pi {ι : Type*} [Fintype ι] {J : ι → (Ideal R)⁰}
    (e : M ≃ₗ[R] (i : ι) → (J i : Ideal R)) :
    steinitzClass R M = ClassGroup.mk0 (∏ i, J i) := by
  obtain ⟨-, ⟨e₀⟩⟩ := (exists_linearEquiv_pi_ideal R (FractionRing R) M).choose_spec
  exact ClassGroup.mk0_prod_eq_of_linearEquiv (e₀.symm.trans e)

variable {R M}

/-- Isomorphic modules have the same Steinitz class. -/
theorem steinitzClass_congr (e : M ≃ₗ[R] N) : steinitzClass R M = steinitzClass R N := by
  obtain ⟨n, J, ⟨e₀⟩⟩ := exists_linearEquiv_pi_nonZeroDivisors R N
  rw [steinitzClass_eq_of_linearEquiv_pi R M (e.trans e₀),
    steinitzClass_eq_of_linearEquiv_pi R N e₀]

variable (R M N)

/-- The Steinitz class is multiplicative on products. -/
@[simp]
theorem steinitzClass_prod : steinitzClass R (M × N) = steinitzClass R M * steinitzClass R N := by
  obtain ⟨m, JM, ⟨eM⟩⟩ := exists_linearEquiv_pi_nonZeroDivisors R M
  obtain ⟨n, JN, ⟨eN⟩⟩ := exists_linearEquiv_pi_nonZeroDivisors R N
  let e : (M × N) ≃ₗ[R] (s : Fin m ⊕ Fin n) → ((Sum.elim JM JN s : (Ideal R)⁰) : Ideal R) :=
    (eM.prodCongr eN).trans
      (LinearEquiv.sumPiEquivProdPi R _ _ fun s ↦ ((Sum.elim JM JN s : (Ideal R)⁰) : Ideal R)).symm
  rw [steinitzClass_eq_of_linearEquiv_pi R (M × N) e, steinitzClass_eq_of_linearEquiv_pi R M eM,
    steinitzClass_eq_of_linearEquiv_pi R N eN, Fintype.prod_sum_type, map_mul]
  simp only [Sum.elim_inl, Sum.elim_inr]

/-- A finite free module has trivial Steinitz class. -/
@[simp]
theorem steinitzClass_eq_one_of_free [Module.Free R M] : steinitzClass R M = 1 := by
  let e : R ≃ₗ[R] ((1 : (Ideal R)⁰) : Ideal R) :=
    Submodule.topEquiv.symm.trans (LinearEquiv.ofEq _ _ (by simp [Ideal.one_eq_top]))
  rw [steinitzClass_eq_of_linearEquiv_pi R M (J := fun _ ↦ 1)
    ((Module.Free.chooseBasis R M).equivFun.trans (LinearEquiv.piCongrRight fun _ ↦ e)),
    Finset.prod_const_one, map_one]

/-- The Steinitz class of a nonzero ideal is its ideal class. -/
@[simp]
theorem steinitzClass_ideal (I : (Ideal R)⁰) :
    steinitzClass R (I : Ideal R) = ClassGroup.mk0 I := by
  rw [steinitzClass_eq_of_linearEquiv_pi R (I : Ideal R) (J := fun _ : Unit ↦ I)
    (LinearEquiv.piUnique R fun _ : Unit ↦ (I : Ideal R)).symm, Fintype.prod_unique]

end Module
