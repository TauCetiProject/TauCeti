module

public import TauCeti.RingTheory.DedekindDomain.AdicValuation.Basic
import TauCeti.RingTheory.DedekindDomain.Factorization

/-!
# Elements dividing a fixed element away from finitely many primes

Let `R` be a Dedekind domain, `P` a finite set of height one primes of `R`, `h > 0`, and for each
`v ∈ P` let `π v ∈ R` generate `v ^ h`. When the class group of `R` is finite, such generators
exist for `h` the order of the class group (`Ideal.isPrincipal_pow_natCard_classGroup`).

Fix `m ≠ 0`. This file shows that the nonzero `β ∈ R` which divide `m` away from `P`, that is,
with `ord_v(β) ≤ ord_v(m)` at every height one prime `v ∉ P`, fall into finitely many classes
modulo the multiplicative monoid generated by the units of `R` and the `π v`: there is a finite
set `M` of divisors of `m * ∏ v ∈ P, π v` such that every such `β` is

  `β = ε * μ * ∏ v ∈ P, π v ^ k v`

with `ε` a unit, `μ ∈ M` and natural exponents `k v`.

The proof writes `ord_v(β) = h * k v + r v` with `0 ≤ r v < h` for `v ∈ P`. Then
`∏ v ∈ P, π v ^ k v` divides `β`, and the quotient `μ` has order `r v < h` at `v ∈ P` and order at
most `ord_v(m)` elsewhere, so `μ` divides `m * ∏ v ∈ P, π v`. A nonzero element of a Dedekind
domain has only finitely many divisors up to units
(`IsDedekindDomain.exists_finset_forall_dvd_exists_associated`).

For a number field `K`, `R = 𝓞 K` and `P` the primes above `p₁, …, p_s`, consider a
Thue–Mahler equation `F(x, y) = m p₁ ^ z₁ ⋯ p_s ^ z_s`. Each linear factor `x - θ y` of `F(x, y)`
divides `m` away from `P`, so this result places it in one of finitely many classes `μ` times the
monoid generated by the units and the `π v`. Turning these into unit equations still needs
Siegel's identity on three factors, which is not part of this file.

## Main results

* `TauCeti.exists_dvd_mul_prod_and_eq_mul_prod_pow`: a nonzero `β` dividing `m` away from `P` is
  `μ * ∏ v ∈ P, π v ^ k v` with `μ` dividing `m * ∏ v ∈ P, π v`.
* `TauCeti.exists_finset_forall_eq_unit_mul_mul_prod_pow`: the finite set of representatives
  described above.

## References

* N. Tzanakis and B. M. M. de Weger, *How to explicitly solve a Thue–Mahler equation*,
  Compositio Math. **84** (1992), 223–288, §§5–6.
* [J.-H. Evertse, *Diophantine Approximation*, lecture notes, Leiden/Mastermath, 2019],
  Chapter 5, Corollary 5.11.
-/

public section

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum WithZero

namespace TauCeti

variable {R : Type*} [CommRing R] [IsDedekindDomain R]

variable {P : Finset (HeightOneSpectrum R)} {h : ℕ} {π : HeightOneSpectrum R → R}

/-- Let `π v` generate `v ^ h` for each `v` in a finite set `P` of height one primes, with
`h > 0`. A nonzero `β` which divides `m` away from `P`, in the sense that `β` vanishes to order at
most `ord_v(m)` at every `v ∉ P`, is `μ * ∏ v ∈ P, π v ^ k v` for some `μ` dividing
`m * ∏ v ∈ P, π v` and some natural exponents `k`. -/
theorem exists_dvd_mul_prod_and_eq_mul_prod_pow (hh : 0 < h)
    (hπ : ∀ v ∈ P, Ideal.span {π v} = v.asIdeal ^ h) {m β : R} (hβ : β ≠ 0)
    (hmβ : ∀ v ∉ P, v.intValuation m ≤ v.intValuation β) :
    ∃ (μ : R) (k : HeightOneSpectrum R → ℕ),
      μ ∣ m * ∏ v ∈ P, π v ∧ β = μ * ∏ v ∈ P, π v ^ k v := by
  classical
  -- `e v` is the order of vanishing of `β` at `v`, and `k v = ⌊e v / h⌋`.
  set e : HeightOneSpectrum R → ℕ := fun v ↦
    (Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {β})).factors
  have he (v : HeightOneSpectrum R) : v.intValuation β = exp (-(e v : ℤ)) :=
    v.intValuation_if_neg hβ
  set k : HeightOneSpectrum R → ℕ := fun v ↦ e v / h
  have hprod0 : ∏ v ∈ P, π v ^ k v ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun v hv ↦
      pow_ne_zero _ (v.ne_zero_of_span_singleton_eq_pow (hπ v hv))
  -- `∏ v ∈ P, π v ^ k v` divides `β`, since `h * k v ≤ e v`.
  obtain ⟨μ, hμ⟩ : ∏ v ∈ P, π v ^ k v ∣ β := by
    refine (dvd_iff_forall_intValuation_le hprod0).mpr fun v ↦ ?_
    rw [v.intValuation_prod_pow_of_span_singleton_eq_pow hπ]
    split_ifs
    · rw [he, exp_le_exp, neg_le_neg_iff]
      exact_mod_cast Nat.mul_div_le (e v) h
    · exact v.intValuation_le_one β
  have hμ0 : μ ≠ 0 := by
    rintro rfl
    exact hβ (by rw [hμ, mul_zero])
  refine ⟨μ, k, ?_, by rw [hμ, mul_comm]⟩
  -- The quotient `μ` vanishes to order `e v % h < h` at `v ∈ P`, and to order `e v` elsewhere.
  refine (dvd_iff_forall_intValuation_le hμ0).mpr fun v ↦ ?_
  have hβv := he v
  have hP := v.intValuation_prod_pow_of_span_singleton_eq_pow hπ fun _ ↦ 1
  simp only [pow_one, Nat.cast_one, mul_one] at hP
  rw [hμ, map_mul, v.intValuation_prod_pow_of_span_singleton_eq_pow hπ] at hβv
  rw [map_mul, hP]
  by_cases hv : v ∈ P
  · simp only [hv, ↓reduceIte] at hβv ⊢
    refine (mul_le_of_le_one_left' (v.intValuation_le_one m)).trans ?_
    rw [← exp_log (v.intValuation_ne_zero μ hμ0)] at hβv ⊢
    rw [← exp_add, exp_inj] at hβv
    rw [exp_le_exp]
    have hdiv : (h * (e v / h : ℕ) + (e v % h : ℕ) : ℤ) = e v := by
      exact_mod_cast Nat.div_add_mod (e v) h
    have hmod : ((e v % h : ℕ) : ℤ) < h := by exact_mod_cast Nat.mod_lt (e v) hh
    linarith
  · simp only [hv, ↓reduceIte, one_mul, mul_one] at hβv ⊢
    rw [hβv, ← he]
    exact hmβ v hv

/-- **Representatives of the divisors of `m` away from `P`** (Tzanakis–de Weger). Let `π v`
generate `v ^ h` for each `v` in a finite set `P` of height one primes, with `h > 0`, and let
`m ≠ 0`. There is a finite set `M` of divisors of `m * ∏ v ∈ P, π v` such that every nonzero `β`
vanishing to order at most `ord_v(m)` at each `v ∉ P` is `ε * μ * ∏ v ∈ P, π v ^ k v` with `ε` a
unit, `μ ∈ M` and natural exponents `k`. -/
theorem exists_finset_forall_eq_unit_mul_mul_prod_pow (hh : 0 < h)
    (hπ : ∀ v ∈ P, Ideal.span {π v} = v.asIdeal ^ h) {m : R} (hm : m ≠ 0) :
    ∃ M : Finset R, (∀ μ ∈ M, μ ∣ m * ∏ v ∈ P, π v) ∧
      ∀ β : R, β ≠ 0 → (∀ v ∉ P, v.intValuation m ≤ v.intValuation β) →
        ∃ μ ∈ M, ∃ (ε : Rˣ) (k : HeightOneSpectrum R → ℕ), β = ε * μ * ∏ v ∈ P, π v ^ k v := by
  have hπ0 : ∏ v ∈ P, π v ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun v hv ↦ v.ne_zero_of_span_singleton_eq_pow (hπ v hv)
  obtain ⟨M, hMdvd, hM⟩ := exists_finset_forall_dvd_exists_associated (mul_ne_zero hm hπ0)
  refine ⟨M, hMdvd, fun β hβ hmβ ↦ ?_⟩
  obtain ⟨μ, k, hμ, rfl⟩ := exists_dvd_mul_prod_and_eq_mul_prod_pow hh hπ hβ hmβ
  obtain ⟨μ₀, hμ₀, ε, rfl⟩ := hM μ hμ
  exact ⟨μ₀, hμ₀, ε, k, by ring⟩

end TauCeti
