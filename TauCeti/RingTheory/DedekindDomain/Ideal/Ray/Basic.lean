module

public import TauCeti.RingTheory.DedekindDomain.Ideal.Congruence
public import TauCeti.RingTheory.DedekindDomain.Ideal.Ray.Moving
public import TauCeti.RingTheory.DedekindDomain.Ideal.UnitsAway

/-!
# Finite ray class groups of Dedekind domains

Let `R` be a Dedekind domain with fraction field `K`, and let `m` be a nonzero ideal of `R`.
The finite ray class group modulo `m` is the group of invertible fractional ideals prime to `m`,
modulo the principal ideals generated by elements congruent to one modulo `m`.

This file builds that quotient without assuming that residue rings or the ordinary class group are
finite.  It also supplies the quotient's universal property, its integral-ideal class map, and the
surjective map to the ordinary class group.  The kernel of the latter consists exactly of the
principal ray classes, giving the right-hand part of the finite ray class exact sequence.

The construction uses the existing prime-to ideal group `idealsAway` and finite congruence subgroup
`Ideal.congruenceSubgroup`; it introduces no parallel ideal or congruence carrier.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter VI, §1.
* S. Lang, *Algebraic Number Theory*, Chapter VI, §1.
-/

public section
noncomputable section

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
open scoped nonZeroDivisors
open TauCeti.NumberFieldArithmetic

namespace Ideal

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

/-- The finite set of height-one primes dividing a nonzero ideal. -/
def finiteRaySupport (m : Ideal R) (hm : m ≠ ⊥) : Finset (HeightOneSpectrum R) :=
  (Ideal.finite_factors hm).toFinset

/-- A height-one prime belongs to the finite ray support exactly when it divides the modulus. -/
@[simp]
theorem mem_finiteRaySupport_iff (m : Ideal R) (hm : m ≠ ⊥) (v : HeightOneSpectrum R) :
    v ∈ finiteRaySupport m hm ↔ v.asIdeal ∣ m :=
  Set.Finite.mem_toFinset _

/-- The principal-ideal map from elements congruent to one modulo `m` to fractional ideals prime
to `m`. -/
def finiteRayHom (m : Ideal R) (hm : m ≠ ⊥) :
    m.congruenceSubgroup K hm →* idealsAway K (finiteRaySupport m hm) :=
  ((toPrincipalIdeal R K).comp (m.congruenceSubgroup K hm).subtype).codRestrict _ fun x ↦
    toPrincipalIdeal_mem_idealsAway_iff.mpr <| by
      -- `Set.unit` has no membership theorem, so expose its defining valuation condition.
      change ∀ v ∉ ((finiteRaySupport m hm : Finset (HeightOneSpectrum R)) :
        Set (HeightOneSpectrum R))ᶜ, v.valuation K ((x : Kˣ) : K) = 1
      simpa only [Set.mem_compl_iff, Finset.mem_coe, not_not, mem_finiteRaySupport_iff] using
        fun v hv ↦ Ideal.valuation_eq_one_of_mem_congruenceSubgroup x.2 hv

/-- The restricted principal-ideal map has the usual underlying principal fractional ideal. -/
@[simp]
theorem coe_finiteRayHom (m : Ideal R) (hm : m ≠ ⊥)
    (x : m.congruenceSubgroup K hm) :
    (finiteRayHom m hm x : (FractionalIdeal R⁰ K)ˣ) =
      toPrincipalIdeal R K (x : Kˣ) :=
  (rfl)

/-- The finite ray modulo `m`, consisting of principal ideals generated by elements congruent to
one modulo `m`. -/
def finiteRay (m : Ideal R) (hm : m ≠ ⊥) :
    Subgroup (idealsAway K (finiteRaySupport m hm)) :=
  (finiteRayHom m hm).range

/-- Membership in the finite ray is the existence of a congruent principal generator. -/
@[simp]
theorem mem_finiteRay_iff {m : Ideal R} {hm : m ≠ ⊥}
    {I : idealsAway K (finiteRaySupport m hm)} :
    I ∈ finiteRay m hm ↔ ∃ x : Kˣ, x ∈ m.congruenceSubgroup K hm ∧
      toPrincipalIdeal R K x = (I : (FractionalIdeal R⁰ K)ˣ) := by
  rw [finiteRay, MonoidHom.mem_range]
  refine ⟨fun ⟨x, hx⟩ ↦ ⟨x, x.2, ?_⟩, fun ⟨x, hx, hxI⟩ ↦ ?_⟩
  · rw [← coe_finiteRayHom m hm x, hx]
  · exact ⟨⟨x, hx⟩, Subtype.ext (Units.ext (by rw [coe_finiteRayHom, hxI]))⟩

/-- The finite ray class group of a Dedekind domain modulo a nonzero ideal. -/
def FiniteRayClassGroup (m : Ideal R) (hm : m ≠ ⊥) (K : Type*) [Field K] [Algebra R K]
    [IsFractionRing R K] : Type _ :=
  idealsAway K (finiteRaySupport m hm) ⧸ finiteRay m hm

instance (m : Ideal R) (hm : m ≠ ⊥) : CommGroup (FiniteRayClassGroup m hm K) :=
  inferInstanceAs (CommGroup (idealsAway K (finiteRaySupport m hm) ⧸ finiteRay m hm))

instance (m : Ideal R) (hm : m ≠ ⊥) : Inhabited (FiniteRayClassGroup m hm K) := ⟨1⟩

/-- The finite ray class of an invertible fractional ideal prime to the modulus. -/
def finiteRayClassMk (m : Ideal R) (hm : m ≠ ⊥) :
    idealsAway K (finiteRaySupport m hm) →* FiniteRayClassGroup m hm K :=
  QuotientGroup.mk' (finiteRay m hm)

/-- Every finite ray class has a fractional ideal representative prime to the modulus. -/
theorem finiteRayClassMk_surjective (m : Ideal R) (hm : m ≠ ⊥) :
    Function.Surjective (finiteRayClassMk (K := K) m hm) :=
  QuotientGroup.mk'_surjective _

/-- A fractional ideal has trivial finite ray class exactly when it belongs to the finite ray. -/
@[simp]
theorem finiteRayClassMk_eq_one_iff {m : Ideal R} {hm : m ≠ ⊥}
    {I : idealsAway K (finiteRaySupport m hm)} :
    finiteRayClassMk m hm I = 1 ↔ I ∈ finiteRay m hm :=
  QuotientGroup.eq_one_iff I

/-- The universal property of the finite ray class group. -/
def finiteRayClassLift {M : Type*} [Monoid M] {m : Ideal R} {hm : m ≠ ⊥}
    (φ : idealsAway K (finiteRaySupport m hm) →* M) (h : finiteRay m hm ≤ φ.ker) :
    FiniteRayClassGroup m hm K →* M :=
  QuotientGroup.lift (finiteRay m hm) φ h

/-- The lifted homomorphism agrees with the original map on ideal representatives. -/
@[simp]
theorem finiteRayClassLift_finiteRayClassMk {M : Type*} [Monoid M]
    {m : Ideal R} {hm : m ≠ ⊥} (φ : idealsAway K (finiteRaySupport m hm) →* M)
    (h : finiteRay m hm ≤ φ.ker) (I : idealsAway K (finiteRaySupport m hm)) :
    finiteRayClassLift φ h (finiteRayClassMk m hm I) = φ I :=
  (rfl)

/-- A homomorphism from the finite ray class group is determined on ideal representatives. -/
theorem finiteRayClassLift_unique {M : Type*} [Monoid M]
    {m : Ideal R} {hm : m ≠ ⊥} (φ : idealsAway K (finiteRaySupport m hm) →* M)
    (h : finiteRay m hm ≤ φ.ker) {ψ : FiniteRayClassGroup m hm K →* M}
    (hψ : ψ.comp (finiteRayClassMk m hm) = φ) : ψ = finiteRayClassLift φ h := by
  refine MonoidHom.ext fun c ↦ ?_
  obtain ⟨I, rfl⟩ := finiteRayClassMk_surjective m hm c
  rw [finiteRayClassLift_finiteRayClassMk, ← hψ, MonoidHom.comp_apply]

/-- The kernel of a map lifted from ideal representatives is the image of the original kernel. -/
theorem ker_finiteRayClassLift {M : Type*} [Monoid M]
    {m : Ideal R} {hm : m ≠ ⊥} (φ : idealsAway K (finiteRaySupport m hm) →* M)
    (h : finiteRay m hm ≤ φ.ker) :
    (finiteRayClassLift φ h).ker = Subgroup.map (finiteRayClassMk m hm) φ.ker :=
  QuotientGroup.ker_lift (finiteRay m hm) φ h

/-- The finite ray class of a nonzero integral ideal prime to the modulus. -/
def finiteIdealClass (m : Ideal R) (hm : m ≠ ⊥) :
    integralIdealsAway (R := R) (finiteRaySupport m hm) →* FiniteRayClassGroup m hm K :=
  (finiteRayClassMk m hm).comp (integralIdealsAwayHom K (finiteRaySupport m hm))

/-- The finite ray class of an integral ideal is represented by its fractional ideal. -/
theorem finiteIdealClass_apply (m : Ideal R) (hm : m ≠ ⊥)
    (I : integralIdealsAway (R := R) (finiteRaySupport m hm)) :
    finiteIdealClass (K := K) m hm I =
      finiteRayClassMk m hm (integralIdealsAwayHom K (finiteRaySupport m hm) I) :=
  (rfl)

/-- An integral ideal has trivial finite ray class exactly when it has a fractional generator
congruent to one modulo the modulus. -/
@[simp]
theorem finiteIdealClass_eq_one_iff {m : Ideal R} {hm : m ≠ ⊥}
    (I : integralIdealsAway (R := R) (finiteRaySupport m hm)) :
    finiteIdealClass (K := K) m hm I = 1 ↔ ∃ x : Kˣ,
      x ∈ m.congruenceSubgroup K hm ∧
        ((I : Ideal R) : FractionalIdeal R⁰ K) = FractionalIdeal.spanSingleton R⁰ (x : K) := by
  rw [finiteIdealClass, MonoidHom.comp_apply, finiteRayClassMk_eq_one_iff,
    mem_finiteRay_iff]
  refine exists_congr fun x ↦ and_congr_right fun _ ↦ ?_
  rw [Units.ext_iff, coe_toPrincipalIdeal, coe_integralIdealsAwayHom]
  exact eq_comm

/-- The ordinary ideal class of an invertible fractional ideal prime to `m`. -/
def finiteIdealsToClassGroup (m : Ideal R) (hm : m ≠ ⊥) :
    idealsAway K (finiteRaySupport m hm) →* ClassGroup R :=
  (ClassGroup.mk K).comp (idealsAway K (finiteRaySupport m hm)).subtype

/-- The ordinary ideal-class map sends an ideal away from the modulus to its class as a
fractional ideal. -/
@[simp]
theorem finiteIdealsToClassGroup_apply (m : Ideal R) (hm : m ≠ ⊥)
    (I : idealsAway K (finiteRaySupport m hm)) :
    finiteIdealsToClassGroup (K := K) m hm I =
      ClassGroup.mk K (I : (FractionalIdeal R⁰ K)ˣ) :=
  (rfl)

private theorem finiteRay_le_ker_finiteIdealsToClassGroup (m : Ideal R) (hm : m ≠ ⊥) :
    finiteRay m hm ≤ (finiteIdealsToClassGroup (K := K) m hm).ker := by
  intro I hI
  obtain ⟨x, -, hxI⟩ := mem_finiteRay_iff.mp hI
  rw [MonoidHom.mem_ker, finiteIdealsToClassGroup, MonoidHom.comp_apply,
    Subgroup.subtype_apply, ← hxI]
  exact ClassGroup.mk_toPrincipalIdeal x

/-- Forgetting the finite congruence condition maps the finite ray class group to the ordinary
class group. -/
def finiteRayClassToClassGroup (m : Ideal R) (hm : m ≠ ⊥) :
    FiniteRayClassGroup m hm K →* ClassGroup R :=
  finiteRayClassLift (finiteIdealsToClassGroup m hm)
    (finiteRay_le_ker_finiteIdealsToClassGroup m hm)

/-- Forgetting the modulus sends a ray-class representative to its ordinary ideal class. -/
@[simp]
theorem finiteRayClassToClassGroup_finiteRayClassMk (m : Ideal R) (hm : m ≠ ⊥)
    (I : idealsAway K (finiteRaySupport m hm)) :
    finiteRayClassToClassGroup m hm (finiteRayClassMk m hm I) =
      ClassGroup.mk K (I : (FractionalIdeal R⁰ K)ˣ) :=
  (rfl)

/-- The finite ray class of a principal fractional ideal whose generator is a local unit at every
prime dividing the modulus. -/
def finitePrincipalRayClass (m : Ideal R) (hm : m ≠ ⊥) :
    ((finiteRaySupport m hm : Set (HeightOneSpectrum R))ᶜ).unit K →*
      FiniteRayClassGroup m hm K :=
  (finiteRayClassMk m hm).comp (principalIdealAway K (finiteRaySupport m hm))

/-- A principal finite ray class is represented by the principal ideal of its generator. -/
@[simp]
theorem finitePrincipalRayClass_apply (m : Ideal R) (hm : m ≠ ⊥)
    (x : ((finiteRaySupport m hm : Set (HeightOneSpectrum R))ᶜ).unit K) :
    finitePrincipalRayClass m hm x =
      finiteRayClassMk m hm (principalIdealAway K (finiteRaySupport m hm) x) :=
  (rfl)

/-- Every ordinary ideal class has a representative prime to a prescribed nonzero ideal. -/
theorem finiteIdealsToClassGroup_surjective (m : Ideal R) (hm : m ≠ ⊥) :
    Function.Surjective (finiteIdealsToClassGroup (K := K) m hm) := by
  intro c
  refine ClassGroup.induction K (fun I ↦ ?_) c
  let I₀ : idealsAway K ∅ := (idealsAwayEmptyEquiv K).symm I
  obtain ⟨x, -, hx⟩ := exists_mul_toPrincipalIdeal_mem_idealsAway I₀
    (finiteRaySupport m hm) (fun _ ↦ 0)
  let J : idealsAway K (finiteRaySupport m hm) :=
    ⟨(I : (FractionalIdeal R⁰ K)ˣ) * toPrincipalIdeal R K x, by
      simpa only [I₀, coe_idealsAwayEmptyEquiv_symm_apply] using hx⟩
  refine ⟨J, ?_⟩
  rw [finiteIdealsToClassGroup, MonoidHom.comp_apply, Subgroup.subtype_apply]
  -- Expose the fractional ideal so the homomorphism and principal-class lemmas apply.
  change ClassGroup.mk K ((I : (FractionalIdeal R⁰ K)ˣ) * toPrincipalIdeal R K x) =
    ClassGroup.mk K I
  rw [map_mul, ClassGroup.mk_toPrincipalIdeal, mul_one]

/-- The map from the finite ray class group to the ordinary class group is surjective. -/
theorem finiteRayClassToClassGroup_surjective (m : Ideal R) (hm : m ≠ ⊥) :
    Function.Surjective (finiteRayClassToClassGroup (K := K) m hm) := by
  intro c
  obtain ⟨I, rfl⟩ := finiteIdealsToClassGroup_surjective (K := K) m hm c
  exact ⟨finiteRayClassMk m hm I, finiteRayClassToClassGroup_finiteRayClassMk m hm I⟩

/-- The kernel of the map to the ordinary class group is the range of the principal finite ray
class map. -/
theorem ker_finiteRayClassToClassGroup_eq_range (m : Ideal R) (hm : m ≠ ⊥) :
    (finiteRayClassToClassGroup (K := K) m hm).ker =
      (finitePrincipalRayClass m hm).range := by
  rw [finiteRayClassToClassGroup, ker_finiteRayClassLift, finiteIdealsToClassGroup,
    ← range_principalIdealAway (K := K) (finiteRaySupport m hm),
    finitePrincipalRayClass, MonoidHom.range_comp]

/-- Principal finite ray classes followed by forgetting the modulus form an exact pair. -/
theorem mulExact_finitePrincipalRayClass_finiteRayClassToClassGroup
    (m : Ideal R) (hm : m ≠ ⊥) :
    Function.MulExact (finitePrincipalRayClass (K := K) m hm)
      (finiteRayClassToClassGroup m hm) :=
  MonoidHom.mulExact_iff.mpr (ker_finiteRayClassToClassGroup_eq_range m hm)

end Ideal
