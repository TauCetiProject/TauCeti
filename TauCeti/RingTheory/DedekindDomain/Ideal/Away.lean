module

public import Mathlib.GroupTheory.MonoidLocalization.Maps
public import TauCeti.RingTheory.DedekindDomain.Factorization
public import TauCeti.RingTheory.DedekindDomain.Ideal.Basic

/-!
# Fractional ideals away from finitely many primes

For a Dedekind domain `R` with fraction field `K` and a finite set `S` of height-one primes,
this file defines the subgroup `idealsAway K S` of invertible fractional ideals whose multiplicity
vanishes at every member of `S`. It proves that this subgroup is generated by the prime ideals
outside `S`, so that a homomorphism out of it is determined by its values on those primes, and
supplies the inclusion induced by enlarging `S`.

The integral counterpart `integralIdealsAway S` consists of the nonzero integral ideals divisible
by no prime in `S`, that is, the ideals that are `Ideal.IsPrimeTo S`. Its map to `idealsAway K S`
is the restriction of Mathlib's `FractionalIdeal.mk0`. Every fractional ideal away from `S` is
a quotient of two such integral ideals, and `integralIdealsAwayLocalizationMap` packages this
as the universal property of localization at all elements of the integral monoid.

Generation comes from `FractionalIdeal.mem_closure_unitOfPrime_of_count_eq_zero`, the unit-level
form of Mathlib's unique factorization of a nonzero fractional ideal.

## Main definitions

* `NumberFieldArithmetic.idealsAway`: unit fractional ideals trivial at the primes in `S`.
* `NumberFieldArithmetic.idealsAwayEmptyEquiv`: ideals away from no primes are all invertible
  fractional ideals.
* `NumberFieldArithmetic.idealsAwayInclusion`: inclusion obtained from `S ⊆ S'`.
* `NumberFieldArithmetic.integralIdealsAway`: nonzero integral ideals prime to `S`.
* `NumberFieldArithmetic.integralIdealsAwayHom`: the map from integral to fractional ideals.

## Main results

* `NumberFieldArithmetic.idealsAway_eq_closure_primes`: `idealsAway K S` is generated by the
  primes outside `S`.
* `NumberFieldArithmetic.idealsAway_hom_ext`, `NumberFieldArithmetic.integralIdealsAway_hom_ext`:
  a monoid homomorphism out of `idealsAway K S` or `integralIdealsAway S` is determined by its
  values on the primes outside `S`.
* `NumberFieldArithmetic.exists_integralIdealsAway_div`: every fractional ideal away from `S`
  has an integral numerator and denominator away from `S`.
* `NumberFieldArithmetic.integralIdealsAwayLocalizationMap`: the fractional ideal group is the
  localization of the integral ideal monoid at all of its elements.

## References

The unit-level factorization behind the generation statement is adapted from Michael Stoll's
`EllipticCurves/Mathlib/FractionalIdeal.lean` at commit `66889eada51a` of the
`MichaelStollBayreuth/EllipticCurves` repository (Apache 2.0).
-/

public section

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
open scoped nonZeroDivisors

namespace TauCeti.NumberFieldArithmetic

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

variable (K) in
/-- The subgroup of invertible fractional ideals whose multiplicity vanishes at every prime in
`S`. -/
def idealsAway (S : Finset (HeightOneSpectrum R)) :
    Subgroup (FractionalIdeal R⁰ K)ˣ where
  carrier := {I | ∀ v ∈ S, FractionalIdeal.count K v (I : FractionalIdeal R⁰ K) = 0}
  one_mem' := fun v _ ↦ FractionalIdeal.count_one K v
  mul_mem' := by
    intro I J hI hJ v hv
    rw [Units.val_mul, FractionalIdeal.count_mul K v (Units.ne_zero I) (Units.ne_zero J),
      hI v hv, hJ v hv, add_zero]
  inv_mem' := by
    intro I hI v hv
    rw [Units.val_inv_eq_inv_val, FractionalIdeal.count_inv, hI v hv, neg_zero]

/-- Membership in `idealsAway K S` means vanishing multiplicity at every prime in `S`. -/
@[simp]
theorem mem_idealsAway_iff {S : Finset (HeightOneSpectrum R)}
    {I : (FractionalIdeal R⁰ K)ˣ} :
    I ∈ idealsAway K S ↔
      ∀ v ∈ S, FractionalIdeal.count K v (I : FractionalIdeal R⁰ K) = 0 :=
  Iff.rfl

variable (K) in
/-- Ideals away from the empty set are canonically all invertible fractional ideals. -/
def idealsAwayEmptyEquiv :
    idealsAway (R := R) K ∅ ≃* (FractionalIdeal R⁰ K)ˣ where
  toFun I := I
  invFun I := ⟨I, by simp⟩
  left_inv I := rfl
  right_inv I := rfl
  map_mul' _ _ := rfl

/-- The equivalence from ideals away from the empty set does not change the underlying fractional
ideal unit. -/
@[simp]
theorem idealsAwayEmptyEquiv_apply (I : idealsAway (R := R) K ∅) :
    idealsAwayEmptyEquiv K I = (I : (FractionalIdeal R⁰ K)ˣ) :=
  (rfl)

/-- The inverse equivalence regards every invertible fractional ideal as an ideal away from the
empty set, without changing its underlying value. -/
@[simp]
theorem coe_idealsAwayEmptyEquiv_symm_apply (I : (FractionalIdeal R⁰ K)ˣ) :
    (((idealsAwayEmptyEquiv K).symm I : idealsAway (R := R) K ∅) :
      (FractionalIdeal R⁰ K)ˣ) = I :=
  (rfl)

variable (K) in
/-- Enlarging the excluded set of primes shrinks the group of fractional ideals away from it. -/
theorem idealsAway_antitone : Antitone (idealsAway (R := R) K) :=
  fun _ _ h _ hI v hv ↦ hI v (h hv)

variable (K) in
/-- The inclusion of fractional ideals away from `S'` into those away from `S`, for `S ⊆ S'`. -/
def idealsAwayInclusion {S S' : Finset (HeightOneSpectrum R)} (h : S ⊆ S') :
    idealsAway K S' →* idealsAway K S :=
  Subgroup.inclusion (idealsAway_antitone K h)

/-- The inclusion between groups of ideals away from finite sets does not change the underlying
fractional ideal. -/
@[simp]
theorem coe_idealsAwayInclusion {S S' : Finset (HeightOneSpectrum R)} (h : S ⊆ S')
    (I : idealsAway K S') :
    ((idealsAwayInclusion K h I : idealsAway K S) :
        (FractionalIdeal R⁰ K)ˣ) = I :=
  (rfl)

/-- `idealsAway K S` is generated by the height-one prime ideals outside `S`. -/
theorem idealsAway_eq_closure_primes (S : Finset (HeightOneSpectrum R)) :
    idealsAway K S = Subgroup.closure {I : (FractionalIdeal R⁰ K)ˣ |
      ∃ v : HeightOneSpectrum R, v ∉ S ∧
        ((I : FractionalIdeal R⁰ K) =
          (v.asIdeal : FractionalIdeal R⁰ K))} := by
  refine le_antisymm (fun I hI ↦ ?_) ((Subgroup.closure_le _).mpr ?_)
  · refine Subgroup.closure_mono ?_ (FractionalIdeal.mem_closure_unitOfPrime_of_count_eq_zero
      (T := (S : Set (HeightOneSpectrum R))ᶜ) fun v hv ↦ hI v (by simpa using hv))
    rintro _ ⟨v, hv, rfl⟩
    exact ⟨v, hv, v.coe_unitOfPrime K⟩
  · rintro I ⟨v, hv, hI⟩ w hw
    have hwv : w ≠ v := fun hwv ↦ hv (hwv ▸ hw)
    rw [hI, FractionalIdeal.count_maximal_coprime K w hwv.symm]

/-- **Homomorphisms out of `idealsAway K S` are determined on the primes.** Two monoid homomorphisms
from the fractional ideals away from `S` agree as soon as they agree on every prime outside `S`. -/
theorem idealsAway_hom_ext {M : Type*} [Monoid M] {S : Finset (HeightOneSpectrum R)}
    {f g : idealsAway K S →* M}
    (h : ∀ (I : idealsAway K S) (v : HeightOneSpectrum R), v ∉ S →
      ((I : (FractionalIdeal R⁰ K)ˣ) : FractionalIdeal R⁰ K) = v.asIdeal → f I = g I) :
    f = g := by
  have key : idealsAway K S ≤ (f.eqLocus g).map (idealsAway K S).subtype := by
    refine (idealsAway_eq_closure_primes S).le.trans ((Subgroup.closure_le _).mpr ?_)
    rintro J ⟨v, hv, hJ⟩
    have hmem : J ∈ idealsAway K S :=
      (idealsAway_eq_closure_primes S).ge (Subgroup.subset_closure ⟨v, hv, hJ⟩)
    exact ⟨⟨J, hmem⟩, h ⟨J, hmem⟩ v hv hJ, rfl⟩
  refine MonoidHom.ext fun I ↦ ?_
  obtain ⟨y, hy, hyI⟩ := key I.2
  obtain rfl : y = I := Subtype.ext hyI
  exact hy

/-- The monoid of nonzero integral ideals divisible by no prime in `S`. -/
def integralIdealsAway (S : Finset (HeightOneSpectrum R)) : Submonoid (Ideal R) where
  carrier := {I | Ideal.IsPrimeTo I (S : Set (HeightOneSpectrum R))}
  one_mem' := by
    rw [Set.mem_ofPred_eq, Ideal.one_eq_top]
    exact Ideal.isPrimeTo_top
  mul_mem' := fun hI hJ ↦ Ideal.isPrimeTo_mul_iff.mpr ⟨hI, hJ⟩

/-- Membership in `integralIdealsAway S` is being prime to `S`. -/
theorem mem_integralIdealsAway_iff_isPrimeTo {S : Finset (HeightOneSpectrum R)}
    {I : Ideal R} :
    I ∈ integralIdealsAway S ↔ I.IsPrimeTo (S : Set (HeightOneSpectrum R)) :=
  Iff.rfl

/-- Membership in `integralIdealsAway S` is nonvanishing together with divisibility by no prime
in `S`. -/
@[simp]
theorem mem_integralIdealsAway_iff {S : Finset (HeightOneSpectrum R)}
    {I : Ideal R} :
    I ∈ integralIdealsAway S ↔ I ≠ ⊥ ∧ ∀ v ∈ S, ¬ v.asIdeal ∣ I :=
  mem_integralIdealsAway_iff_isPrimeTo.trans Ideal.isPrimeTo_iff

/-- The members of `integralIdealsAway S` are nonzero ideals. -/
theorem integralIdealsAway_le_nonZeroDivisors (S : Finset (HeightOneSpectrum R)) :
    integralIdealsAway (R := R) S ≤ (Ideal R)⁰ :=
  fun _ hI ↦ mem_nonZeroDivisors_of_ne_zero (mem_integralIdealsAway_iff.mp hI).1

/-- Members of `integralIdealsAway S` are nonzero ideals of a Dedekind domain, so they cancel. -/
instance (S : Finset (HeightOneSpectrum R)) : CancelCommMonoid (integralIdealsAway S) where
  mul_left_cancel a _ _ h :=
    Subtype.ext <| mul_left_cancel₀ (mem_integralIdealsAway_iff.mp a.2).1 (congrArg Subtype.val h)

/-- **Homomorphisms out of `integralIdealsAway S` are determined on the primes.** Two monoid
homomorphisms from the integral ideals prime to `S` agree as soon as they agree on every prime
outside `S`. -/
theorem integralIdealsAway_hom_ext {M : Type*} [MulOne M]
    {S : Finset (HeightOneSpectrum R)} {f g : integralIdealsAway (R := R) S →* M}
    (h : ∀ (v : HeightOneSpectrum R) (hv : v.asIdeal ∈ integralIdealsAway (R := R) S),
      f ⟨v.asIdeal, hv⟩ = g ⟨v.asIdeal, hv⟩) : f = g := by
  refine MonoidHom.ext fun ⟨I, hI⟩ ↦ ?_
  refine Ideal.IsPrimeTo.induction_on (motive := fun J ↦ ∀ hJ : J ∈ integralIdealsAway (R := R) S,
    f ⟨J, hJ⟩ = g ⟨J, hJ⟩) (mem_integralIdealsAway_iff_isPrimeTo.mp hI) (fun htop ↦ ?_)
    (fun v J hv hJ ih _ ↦ ?_) hI
  · have hone : (⟨⊤, htop⟩ : integralIdealsAway (R := R) S) = 1 :=
      Subtype.ext Ideal.one_eq_top.symm
    rw [hone, map_one, map_one]
  · have hvS : v.asIdeal ∈ integralIdealsAway (R := R) S :=
      mem_integralIdealsAway_iff_isPrimeTo.mpr (Ideal.isPrimeTo_asIdeal_iff.mpr hv)
    rw [← Submonoid.mk_mul_mk _ _ _ hvS hJ, map_mul, map_mul, ih hJ, h v hvS]

/-- Divisibility in `integralIdealsAway S` is divisibility of the underlying ideals: a cofactor
of two ideals prime to `S` is itself prime to `S`. -/
theorem integralIdealsAway_dvd_iff_dvd_coe {S : Finset (HeightOneSpectrum R)}
    {I J : integralIdealsAway S} : I ∣ J ↔ (I : Ideal R) ∣ (J : Ideal R) := by
  refine ⟨fun ⟨c, hc⟩ ↦ ⟨c, by rw [hc, Submonoid.coe_mul]⟩, fun ⟨c, hc⟩ ↦ ?_⟩
  have hJ := mem_integralIdealsAway_iff_isPrimeTo.mp J.2
  rw [hc, Ideal.isPrimeTo_mul_iff] at hJ
  exact ⟨⟨c, mem_integralIdealsAway_iff_isPrimeTo.mpr hJ.2⟩, Subtype.ext hc⟩

/-- Membership in `integralIdealsAway S` is equivalently nonvanishing and vanishing fractional
ideal multiplicity at every prime in `S`. -/
theorem mem_integralIdealsAway_iff_count_eq_zero {S : Finset (HeightOneSpectrum R)}
    {I : Ideal R} :
    I ∈ integralIdealsAway S ↔ I ≠ ⊥ ∧
      ∀ v ∈ S, FractionalIdeal.count K v (I : FractionalIdeal R⁰ K) = 0 := by
  rw [mem_integralIdealsAway_iff]
  refine and_congr_right fun hI ↦ forall_congr' fun v ↦ forall_congr' fun _ ↦ ?_
  rw [FractionalIdeal.count_coe K v hI, Int.natCast_eq_zero,
    ← Associates.count_ne_zero_iff_dvd hI v.irreducible, not_not]

variable (K) in
/-- Map a nonzero integral ideal away from `S` to its invertible fractional ideal. -/
noncomputable def integralIdealsAwayHom (S : Finset (HeightOneSpectrum R)) :
    integralIdealsAway (R := R) S →* idealsAway K S :=
  ((FractionalIdeal.mk0 K).comp (Submonoid.inclusion (integralIdealsAway_le_nonZeroDivisors S))
    ).codRestrict _ fun I ↦ mem_idealsAway_iff.mpr fun v hv ↦ by
      rw [MonoidHom.comp_apply, FractionalIdeal.coe_mk0]
      exact (mem_integralIdealsAway_iff_count_eq_zero.mp I.2).2 v hv

/-- The integral-to-fractional map does not change the underlying ideal. -/
@[simp]
theorem coe_integralIdealsAwayHom (S : Finset (HeightOneSpectrum R))
    (I : integralIdealsAway (R := R) S) :
    (((integralIdealsAwayHom K S I : idealsAway K S) :
        (FractionalIdeal R⁰ K)ˣ) : FractionalIdeal R⁰ K) = I := by
  simp only [integralIdealsAwayHom, MonoidHom.codRestrict_apply, MonoidHom.comp_apply,
    FractionalIdeal.coe_mk0, Submonoid.coe_inclusion]

/-- The integral-to-fractional ideal map is injective. -/
theorem integralIdealsAwayHom_injective (S : Finset (HeightOneSpectrum R)) :
    Function.Injective (integralIdealsAwayHom K S) := by
  intro I J h
  apply Subtype.ext
  apply FractionalIdeal.coeIdeal_injective (K := K)
  simpa only [coe_integralIdealsAwayHom] using
    congrArg (fun x : idealsAway K S ↦ ((x : (FractionalIdeal R⁰ K)ˣ) :
      FractionalIdeal R⁰ K)) h

/-- Every fractional ideal away from `S` is a quotient of two integral ideals away from `S`. -/
theorem exists_integralIdealsAway_div (S : Finset (HeightOneSpectrum R))
    (I : idealsAway K S) :
    ∃ A B : integralIdealsAway S,
      I = integralIdealsAwayHom K S A / integralIdealsAwayHom K S B := by
  have h : ∀ x ∈ idealsAway K S,
      ∃ A B : integralIdealsAway S,
        x = (integralIdealsAwayHom K S A : (FractionalIdeal R⁰ K)ˣ) /
          (integralIdealsAwayHom K S B : (FractionalIdeal R⁰ K)ˣ) := by
    intro x hx
    rw [idealsAway_eq_closure_primes] at hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨v, hv, hval⟩ := hx
      have hv' : v.asIdeal ∈ integralIdealsAway S :=
        mem_integralIdealsAway_iff_isPrimeTo.mpr (Ideal.isPrimeTo_asIdeal_iff.mpr hv)
      refine ⟨⟨v.asIdeal, hv'⟩, 1, ?_⟩
      apply Units.ext
      simpa only [map_one, Subgroup.coe_one, div_one, coe_integralIdealsAwayHom] using hval
    | one => exact ⟨1, 1, by simp⟩
    | mul x y hx hy ihx ihy =>
      obtain ⟨A, B, rfl⟩ := ihx
      obtain ⟨C, D, rfl⟩ := ihy
      exact ⟨A * C, B * D, by simp [div_mul_div_comm]⟩
    | inv x hx ih =>
      obtain ⟨A, B, rfl⟩ := ih
      exact ⟨B, A, by simp⟩
  obtain ⟨A, B, hAB⟩ := h I I.2
  exact ⟨A, B, Subtype.ext hAB⟩

variable (K) in
/-- The group of fractional ideals away from `S` is the localization of its integral ideal monoid
at all its elements. This supplies the universal property for extending multiplicative maps on
integral ideals to fractional ideals. -/
noncomputable def integralIdealsAwayLocalizationMap (S : Finset (HeightOneSpectrum R)) :
    Submonoid.LocalizationMap (⊤ : Submonoid (integralIdealsAway (R := R) S))
      (idealsAway K S) where
  toMulHom := (integralIdealsAwayHom K S).toMulHom
  isLocalizationMap := Submonoid.isLocalizationMap_of_group
    (integralIdealsAwayHom_injective S) fun I ↦ by
      obtain ⟨A, B, h⟩ := exists_integralIdealsAway_div S I
      exact ⟨A, B, Submonoid.mem_top _, h⟩

/-- The localization map is the canonical integral-to-fractional ideal map. -/
@[simp]
theorem integralIdealsAwayLocalizationMap_apply (S : Finset (HeightOneSpectrum R))
    (I : integralIdealsAway S) :
    integralIdealsAwayLocalizationMap K S I = integralIdealsAwayHom K S I :=
  (rfl)

end TauCeti.NumberFieldArithmetic
