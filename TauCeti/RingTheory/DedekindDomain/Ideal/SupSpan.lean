module

public import Mathlib.RingTheory.DedekindDomain.Ideal.Basic
import Mathlib.RingTheory.DedekindDomain.Factorization
import TauCeti.RingTheory.Length
import TauCeti.RingTheory.StableRange.Commutative
import Mathlib.Tactic.LinearCombination

/-!
# A second generator in a prescribed coset

In a Dedekind domain every ideal `I` is generated by any nonzero `J ≤ I` together with one more
element (`IsDedekindDomain.exists_sup_span_eq`). This file shows that the extra generator can be
taken in a prescribed coset `b + aI`, as soon as `b ∈ I` and `a` is coprime to `b`.

The proof writes `I = (y) + (g)` for a nonzero `y ∈ J`, so that `b = c y + d g`. The ring
`R ⧸ (y)` is artinian, hence has stable range one, and `d` is coprime to `a` modulo `y`; so
`d + a τ` is a unit modulo `y` for some `τ`, and then `b + (g τ) a = c y + g (d + a τ)`
generates `I` together with `y`.

This is the Dedekind input to the theory of Mennicke symbols, where it is used to move a pair
`(a, b)` to a pair whose second entry generates the level ideal together with a prescribed
element.

## Main results

* `IsDedekindDomain.exists_mem_sup_span_add_mul_eq`: for `0 ≠ J ≤ I`, `b ∈ I` and `a` coprime to
  `b`, some `t ∈ I` has `J ⊔ (b + t a) = I`.
-/

public section

open Ideal

namespace IsDedekindDomain

variable {R : Type*} [CommRing R] [IsDedekindDomain R]

/-- **A second generator in a prescribed coset.** In a Dedekind domain, if `J ≤ I` with `J ≠ 0`,
`b ∈ I` and `a` is coprime to `b`, then `J ⊔ (b + t a) = I` for some `t ∈ I`. -/
theorem exists_mem_sup_span_add_mul_eq {I J : Ideal R} (hJI : J ≤ I) (hJ : J ≠ ⊥) {a b : R}
    (hb : b ∈ I) (hab : IsCoprime a b) : ∃ t ∈ I, J ⊔ span {b + t * a} = I := by
  obtain ⟨y, hyJ, hy0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
  obtain ⟨g, hg⟩ := exists_sup_span_eq ((span_singleton_le_iff_mem _).mpr (hJI hyJ))
    (by rwa [Ne, zero_eq_bot, span_singleton_eq_bot])
  have hgI : g ∈ I := hg ▸ mem_sup_right (mem_span_singleton_self g)
  obtain ⟨c, d, hcd⟩ : ∃ c d, c * y + d * g = b := by
    rw [← mem_span_pair, span_insert, hg]
    exact hb
  -- `d` is coprime to `a` modulo `y`, and `R ⧸ (y)` has stable range one.
  obtain ⟨u, v, huv⟩ := hab
  have hcop : IsCoprime (Ideal.Quotient.mk (span {y}) d) (Ideal.Quotient.mk (span {y}) a) := by
    refine ⟨Ideal.Quotient.mk _ (v * g), Ideal.Quotient.mk _ u, ?_⟩
    rw [← map_mul, ← map_mul, ← map_add, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq]
    exact mem_span_singleton'.mpr ⟨-(v * c), by linear_combination -huv - v * hcd⟩
  have : IsArtinianRing (R ⧸ span {y}) := TauCeti.isArtinianRing_quotient_span_singleton R hy0
  obtain ⟨τ', hτ'⟩ := hcop.exists_isUnit_add_mul
  obtain ⟨τ, rfl⟩ := Ideal.Quotient.mk_surjective τ'
  obtain ⟨w', hw'⟩ := hτ'.exists_right_inv
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w'
  rw [← map_mul, ← map_add, ← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq] at hw'
  obtain ⟨k, hk⟩ := mem_span_singleton'.mp hw'
  refine ⟨g * τ, mul_mem_right τ _ hgI, le_antisymm (sup_le hJI ?_) ?_⟩
  · rw [span_singleton_le_iff_mem]
    exact add_mem hb (mul_mem_right a _ (mul_mem_right τ _ hgI))
  · -- `g = w (b + g τ a) - (w c + g k) y`, so `I = (y) + (g)` lies in `J ⊔ (b + g τ a)`.
    rw [← hg, sup_le_iff,
      span_singleton_le_iff_mem, span_singleton_le_iff_mem]
    refine ⟨mem_sup_left hyJ, Submodule.mem_sup.mpr ⟨-(w * c + g * k) * y,
      J.mul_mem_left _ hyJ, w * (b + g * τ * a), mem_span_singleton'.mpr ⟨w, rfl⟩, ?_⟩⟩
    linear_combination -w * hcd - g * hk

end IsDedekindDomain
