module

public import TauCeti.RingTheory.DedekindDomain.FiniteAdeleRing.Topology
public import TauCeti.RingTheory.DedekindDomain.FiniteAdeleRing.Units

/-!
# The `S`-integral finite ideles

Let `R` be a Dedekind domain with fraction field `K`, and let `S` be a set of height one primes of
`R`. The finite ideles that are units of the local integers at every place outside `S` form the
subgroup

`∏_{v ∈ S} K_vˣ × ∏_{v ∉ S} 𝒪_vˣ`

of the finite ideles `𝔸ᶠ[R, K]ˣ`, the **`S`-integral finite ideles**. For `S = ∅` this is the group
`integralUnits R K` of everywhere-integral units, which is defined as this case of
`IsDedekindDomain.FiniteAdeleRing.sIntegralUnits` in
`TauCeti.RingTheory.DedekindDomain.FiniteAdeleRing.ClassGroup`. This file develops the
restricted-product description of the finite ideles through these subgroups:

* a finite idele lies in the `S`-integral finite ideles exactly when `S` contains the finitely many
  places at which it is not a local unit, so the finite ideles are the union of the `S`-integral
  finite ideles over finite sets `S`;
* every `S`-integral finite idele group is an open, hence closed, subgroup for the units topology,
  and for finite `S` its subspace topology is the product topology of the local unit groups;
* the `S`-integral finite ideles meet the principal finite ideles in the `S`-units `S.unit K`;
* their image in the ideal class group is the subgroup generated by the classes of the primes in
  `S`, so together with the principal finite ideles they generate the finite ideles exactly when
  these classes generate the class group.

## Main results

* `IsDedekindDomain.FiniteAdeleRing.mem_sIntegralUnits_iff_subset` and
  `IsDedekindDomain.FiniteAdeleRing.iSup_sIntegralUnits`: the restricted-product condition.
* `IsDedekindDomain.FiniteAdeleRing.isOpen_sIntegralUnits`,
  `IsDedekindDomain.FiniteAdeleRing.isClosed_sIntegralUnits`, and
  `IsDedekindDomain.FiniteAdeleRing.isEmbedding_sIntegralUnits`: the topology of the `S`-integral
  finite ideles.
* `IsDedekindDomain.FiniteAdeleRing.comap_unitEmbedding_sIntegralUnits`: the principal finite
  ideles that are `S`-integral are those of the `S`-units.
* `IsDedekindDomain.FiniteAdeleRing.map_toClassGroup_sIntegralUnits` and
  `IsDedekindDomain.FiniteAdeleRing.sIntegralUnits_sup_range_unitEmbedding_eq_top_iff`: the ideal
  classes of the `S`-integral finite ideles.

## References

* J. W. S. Cassels and A. Fröhlich, eds., *Algebraic Number Theory*, Chapter II, §16.
* J. Neukirch, *Algebraic Number Theory*, Chapter VI, §1.
-/

public section

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
open scoped RestrictedProduct

namespace IsDedekindDomain.FiniteAdeleRing

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

/-! ### The `S`-integral finite ideles -/

/-- A finite idele is `S`-integral exactly when its components outside `S` are units of the local
integers, that is, when they and the components of its inverse are integral. -/
theorem mem_sIntegralUnits_iff_forall_mem_adicCompletionIntegers {S : Set (HeightOneSpectrum R)}
    {x : 𝔸ᶠ[R, K]ˣ} :
    x ∈ sIntegralUnits R K S ↔ ∀ v ∉ S,
      (x : 𝔸ᶠ[R, K]) v ∈ v.adicCompletionIntegers K ∧
        ((x⁻¹ : 𝔸ᶠ[R, K]ˣ) : 𝔸ᶠ[R, K]) v ∈ v.adicCompletionIntegers K :=
  mem_sIntegralUnits.trans (forall₂_congr fun v _ ↦ valued_coe_units_apply_eq_one_iff x v)

variable (R K) in
/-- Every finite idele is integral outside the set of all finite places. -/
@[simp]
theorem sIntegralUnits_univ : sIntegralUnits R K Set.univ = ⊤ := by
  ext x
  simp

variable (R K) in
/-- Allowing more non-integral places gives more `S`-integral finite ideles. -/
theorem sIntegralUnits_mono : Monotone (sIntegralUnits R K) :=
  fun _ _ hST _ hx ↦ mem_sIntegralUnits.mpr fun v hv ↦ mem_sIntegralUnits.mp hx v fun hvS ↦
    hv (hST hvS)

variable (R K) in
/-- The everywhere-integral units are `S`-integral for every `S`. -/
theorem integralUnits_le_sIntegralUnits (S : Set (HeightOneSpectrum R)) :
    integralUnits R K ≤ sIntegralUnits R K S :=
  sIntegralUnits_empty R K ▸ sIntegralUnits_mono R K (Set.empty_subset S)

/-- **The restricted-product condition, in terms of `S`-integral finite ideles.** A finite idele
is `S`-integral exactly when `S` contains the finitely many places
(`IsDedekindDomain.FiniteAdeleRing.eventually_valued_coe_units_apply_eq_one`) at which it is not a
local unit. -/
theorem mem_sIntegralUnits_iff_subset {S : Set (HeightOneSpectrum R)} {x : 𝔸ᶠ[R, K]ˣ} :
    x ∈ sIntegralUnits R K S ↔ {v | Valued.v ((x : 𝔸ᶠ[R, K]) v) ≠ 1} ⊆ S := by
  simp only [mem_sIntegralUnits, Set.subset_def, Set.mem_ofPred_eq]
  exact forall_congr' fun v ↦ not_imp_comm

/-- Every finite idele is `S`-integral for some finite set `S` of places. -/
theorem exists_finset_mem_sIntegralUnits (x : 𝔸ᶠ[R, K]ˣ) :
    ∃ S : Finset (HeightOneSpectrum R), x ∈ sIntegralUnits R K S :=
  have hfin := Filter.eventually_cofinite.mp (eventually_valued_coe_units_apply_eq_one x)
  ⟨hfin.toFinset, mem_sIntegralUnits_iff_subset.mpr hfin.coe_toFinset.ge⟩

variable (R K) in
/-- The finite ideles are the union of their `S`-integral subgroups over finite sets `S` of
places. -/
theorem iSup_sIntegralUnits :
    ⨆ S : Finset (HeightOneSpectrum R), sIntegralUnits R K S = ⊤ :=
  eq_top_iff.mpr fun x _ ↦
    let ⟨S, hS⟩ := exists_finset_mem_sIntegralUnits x
    Subgroup.mem_iSup_of_mem S hS

/-! ### Topology -/

variable (R K) in
/-- The `S`-integral finite ideles are open in the units topology, for every set `S`: they contain
the open subgroup of everywhere-integral units. -/
theorem isOpen_sIntegralUnits (S : Set (HeightOneSpectrum R)) :
    IsOpen (sIntegralUnits R K S : Set 𝔸ᶠ[R, K]ˣ) :=
  Subgroup.isOpen_mono (integralUnits_le_sIntegralUnits R K S) (TauCeti.isOpen_integralUnits R K)

variable (R K) in
/-- The `S`-integral finite ideles are closed in the units topology, being an open subgroup. -/
theorem isClosed_sIntegralUnits (S : Set (HeightOneSpectrum R)) :
    IsClosed (sIntegralUnits R K S : Set 𝔸ᶠ[R, K]ˣ) :=
  (sIntegralUnits R K S).isClosed_of_isOpen (isOpen_sIntegralUnits R K S)

/-- **For finite `S`, the `S`-integral finite ideles carry the product topology** of
`∏_{v ∈ S} K_vˣ × ∏_{v ∉ S} 𝒪_vˣ`: reading off the local units embeds them topologically into the
full product `∏_v K_vˣ` of the local unit groups. Finiteness of `S` cannot be dropped in general:
for `S = Set.univ` this would say that the units topology of the finite ideles is the product
topology. -/
theorem isEmbedding_sIntegralUnits {S : Set (HeightOneSpectrum R)} (hS : S.Finite) :
    Topology.IsEmbedding fun x : sIntegralUnits R K S ↦ ⇑(unitsContinuousMulEquiv R K x) := by
  have hle : Filter.cofinite ≤ Filter.principal Sᶜ :=
    Filter.le_principal_iff.mpr hS.compl_mem_cofinite
  -- the `S`-integral finite ideles land in the restricted product with respect to `𝓟 Sᶜ`
  have hmem (x : sIntegralUnits R K S) (v : HeightOneSpectrum R) (hv : v ∉ S) :
      unitsContinuousMulEquiv R K x v ∈ (Submonoid.ofClass (v.adicCompletionIntegers K)).units := by
    rw [Submonoid.mem_units_iff, coe_unitsContinuousMulEquiv_apply, ← RestrictedProduct.inv_apply,
      ← map_inv, coe_unitsContinuousMulEquiv_apply]
    exact mem_sIntegralUnits_iff_forall_mem_adicCompletionIntegers.mp x.2 v hv
  let g : sIntegralUnits R K S →
      Πʳ v : HeightOneSpectrum R, [(v.adicCompletion K)ˣ,
        (Submonoid.ofClass (v.adicCompletionIntegers K)).units]_[Filter.principal Sᶜ] :=
    fun x ↦ ⟨⇑(unitsContinuousMulEquiv R K x), Filter.eventually_principal.mpr (hmem x)⟩
  -- `RestrictedProduct.inclusion` composed with `g` is the restriction of a homeomorphism
  have hg : Topology.IsEmbedding g := by
    refine ⟨((RestrictedProduct.isEmbedding_inclusion_principal hle).isInducing.of_comp_iff).mp
      ((unitsContinuousMulEquiv R K).toHomeomorph.isInducing.comp
        Topology.IsInducing.subtypeVal), fun x y hxy ↦ ?_⟩
    refine Subtype.ext ((unitsContinuousMulEquiv R K).injective ?_)
    ext v : 1
    exact RestrictedProduct.ext_iff.mp hxy v
  exact RestrictedProduct.isEmbedding_coe_of_principal.comp hg

/-! ### Principal `S`-integral finite ideles -/

variable (R K) in
/-- **The principal `S`-integral finite ideles are those of the `S`-units**: an element of `Kˣ`
has `S`-integral principal finite idele exactly when it lies in `S.unit K`. -/
@[simp]
theorem comap_unitEmbedding_sIntegralUnits (S : Set (HeightOneSpectrum R)) :
    (sIntegralUnits R K S).comap (unitEmbedding R K) = S.unit K := by
  ext a
  rw [Subgroup.mem_comap, mem_sIntegralUnits]
  exact forall_valued_unitEmbedding_eq_one_iff a

variable (R K) in
/-- The `S`-integral principal finite ideles are the image of the `S`-units. -/
theorem range_unitEmbedding_inf_sIntegralUnits (S : Set (HeightOneSpectrum R)) :
    (unitEmbedding R K).range ⊓ sIntegralUnits R K S = (S.unit K).map (unitEmbedding R K) := by
  rw [← Subgroup.map_comap_eq, comap_unitEmbedding_sIntegralUnits]

/-! ### Ideal classes of `S`-integral finite ideles -/

variable (R K) in
/-- **The ideal classes of the `S`-integral finite ideles** form the subgroup of the class group
generated by the classes of the primes in `S`. -/
@[simp]
theorem map_toClassGroup_sIntegralUnits (S : Set (HeightOneSpectrum R)) :
    (sIntegralUnits R K S).map (toClassGroup R K) =
      Subgroup.closure (HeightOneSpectrum.classGroupMk '' S) := by
  refine le_antisymm ?_ fun c hc ↦ ?_
  · rintro _ ⟨x, hx, rfl⟩
    exact (toClassGroup_mem_closure_iff x).mpr ⟨1, by simpa using hx⟩
  · obtain ⟨x, rfl⟩ := toClassGroup_surjective (R := R) (K := K) c
    obtain ⟨a, ha⟩ := (toClassGroup_mem_closure_iff x).mp hc
    refine ⟨x * unitEmbedding R K a, mem_sIntegralUnits.mpr ha, ?_⟩
    rw [map_mul, toClassGroup_apply (unitEmbedding R K a), toFractionalIdeal_unitEmbedding,
      ClassGroup.mk_toPrincipalIdeal, mul_one]

variable (R K) in
/-- **The `S`-integral finite ideles and the principal finite ideles generate the finite ideles**
exactly when the classes of the primes in `S` generate the ideal class group. -/
theorem sIntegralUnits_sup_range_unitEmbedding_eq_top_iff (S : Set (HeightOneSpectrum R)) :
    sIntegralUnits R K S ⊔ (unitEmbedding R K).range = ⊤ ↔
      Subgroup.closure (HeightOneSpectrum.classGroupMk '' S) = ⊤ := by
  refine ⟨fun h ↦ ?_, fun h ↦ eq_top_iff.mpr fun x _ ↦ ?_⟩
  · -- the principal finite ideles have trivial class
    have hrange : (unitEmbedding R K).range.map (toClassGroup R K) = ⊥ := by
      rw [Subgroup.map_eq_bot_iff, ker_toClassGroup]
      exact le_sup_right
    -- push the equality forward to the class group
    have hmap := congrArg (Subgroup.map (toClassGroup R K)) h
    rwa [Subgroup.map_sup, hrange, sup_bot_eq, map_toClassGroup_sIntegralUnits,
      ← MonoidHom.range_eq_map, MonoidHom.range_eq_top.mpr toClassGroup_surjective] at hmap
  · obtain ⟨a, ha⟩ := exists_valued_mul_unitEmbedding_eq_one (K := K) h x
    have hx : x * unitEmbedding R K a * unitEmbedding R K a⁻¹ ∈
        sIntegralUnits R K S ⊔ (unitEmbedding R K).range :=
      Subgroup.mul_mem_sup (mem_sIntegralUnits.mpr ha) ⟨a⁻¹, rfl⟩
    rwa [map_inv, mul_inv_cancel_right] at hx

end IsDedekindDomain.FiniteAdeleRing
