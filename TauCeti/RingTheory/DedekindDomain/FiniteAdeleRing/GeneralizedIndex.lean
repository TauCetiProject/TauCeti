/-!
# Ideals of finite index of the integral finite adeles, and the generalised index

Let `R` be a Dedekind domain with fraction field `K`, `𝔸_f` its finite adeles and `Ô` the
integral ones. A finite idele `t` whose fractional ideal is an integral ideal `N` is integral, and
`tÔ` is the completion `NÔ` of `N`. If `R` has characteristic zero, an ideal `I` of finite index of
`Ô` contains its index, a nonzero integer, and is therefore the completion of the ideal of `R` it
cuts out. So every ideal of finite index of `Ô` is principal, generated by an integral adele that
is a unit of `𝔸_f`.

For a number field `K`, the *generalised index* `[a]` of a finite adele `a` is the absolute norm of
its fractional ideal when `a` is a unit, and `0` otherwise
(`NumberField.FiniteAdeleRing.genIndex`). It is multiplicative, it is `|N_{K/ℚ} x|` on the
diagonal image of `x ∈ K`, and for an integral adele
`g` that is a unit of `𝔸_f` it is the index `[Ô : gÔ]`. It is invariant under ring automorphisms of
`𝔸_f` that preserve `Ô`. In terms of Haar measure, `[a]` is the inverse of the factor by which
multiplication by `a` scales a Haar measure of `𝔸_f`; that description is not used here.

## Main declarations

* `IsDedekindDomain.FiniteAdeleRing.completedIdeal_eq_span_singleton`: `NÔ = tÔ` for a finite
  idele `t` with fractional ideal `N`.
* `IsDedekindDomain.FiniteAdeleRing.exists_eq_completedIdeal_of_cardQuot_ne_zero`: an ideal of
  finite index of `Ô` is a completed ideal.
* `IsDedekindDomain.FiniteAdeleRing.exists_eq_span_singleton_of_cardQuot_ne_zero`,
  `IsDedekindDomain.FiniteAdeleRing.isPrincipal_of_cardQuot_ne_zero`: an ideal of finite index
  of `Ô` is generated by an integral adele that is a unit of `𝔸_f`.
* `NumberField.FiniteAdeleRing.genIndex`: the generalised index `𝔸_f →*₀ ℚ`.
* `NumberField.FiniteAdeleRing.genIndex_algebraMap`: `[x] = |N_{K/ℚ} x|` for `x ∈ K`.
* `NumberField.FiniteAdeleRing.genIndex_eq_cardQuot`: `[g] = [Ô : gÔ]`.
* `NumberField.FiniteAdeleRing.genIndex_map`: invariance under automorphisms preserving `Ô`.

## Attribution

The principality of the ideals of finite index of `Ô` is
`New.Filling.isPrincipal_of_cardQuot_ne_zero`, and the generalised index is `New.genIndex`, in
grh-lean (https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic, PBC), files
`src/New/Spanning/RemainingTerms/Discriminants.lean` and `src/Lib/General/Measure/HaarModulus.lean`.
There the index is defined through Haar measure and principality comes from a Bezout property of
`Ô`; here both come from the fractional ideal of a finite idele.
-/

public section
noncomputable section

open IsDedekindDomain HeightOneSpectrum
open scoped nonZeroDivisors

namespace IsDedekindDomain.FiniteAdeleRing

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

/-- A finite idele whose fractional ideal is a nonzero integral ideal `N` is integral. -/
theorem coe_mem_integralAdeles_of_toFractionalIdeal_eq {N : Ideal R} (hN : N ≠ ⊥)
    {t : 𝔸ᶠ[R, K]ˣ}
    (ht : toFractionalIdeal t = FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩) :
    (t : 𝔸ᶠ[R, K]) ∈ integralAdeles R K := by
  rw [← toFractionalIdeal_le_one_iff, ht, FractionalIdeal.coe_mk0]
  exact FractionalIdeal.coeIdeal_le_one

/-- Let `t` be a finite idele whose fractional ideal is a nonzero integral ideal `N`. Then the
completion `NÔ` of `N` is the principal ideal of `Ô` generated by `t`. -/
theorem completedIdeal_eq_span_singleton {N : Ideal R} (hN : N ≠ ⊥) {t : 𝔸ᶠ[R, K]ˣ}
    (ht : toFractionalIdeal t = FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩) :
    completedIdeal K N =
      Ideal.span {⟨t, coe_mem_integralAdeles_of_toFractionalIdeal_eq hN ht⟩} := by
  ext x
  rw [← coe_mem_finiteAdelicIdeal_iff_mem_completedIdeal hN, mem_finiteAdelicIdeal_iff t ht,
    Ideal.mem_span_singleton']
  refine ⟨fun hx ↦ ⟨⟨_, hx⟩, Subtype.ext ?_⟩, ?_⟩
  · change (↑t⁻¹ : 𝔸ᶠ[R, K]) * x * t = x
    rw [mul_right_comm, Units.inv_mul, one_mul]
  · rintro ⟨c, rfl⟩
    change (↑t⁻¹ : 𝔸ᶠ[R, K]) * (c * t) ∈ integralAdeles R K
    rw [mul_left_comm, Units.inv_mul, mul_one]
    exact c.property

/-- In characteristic zero, an ideal `I` of finite index of the integral finite adeles `Ô` is the
completion `NÔ` of the nonzero ideal `N` of `R` that it cuts out: `I` contains its index, a
nonzero integer, and `R` is dense in `Ô`. -/
theorem exists_eq_completedIdeal_of_cardQuot_ne_zero [CharZero R]
    {I : Ideal (integralAdeles R K)} (hI : I.cardQuot ≠ 0) :
    ∃ N : Ideal R, N ≠ ⊥ ∧ I = completedIdeal K N := by
  set N := I.comap (algebraMap R (integralAdeles R K))
  have h_index : algebraMap R (integralAdeles R K) (I.cardQuot : R) ∈ I := by
    have h := AddSubgroup.nsmul_index_mem I.toAddSubgroup 1
    rw [nsmul_eq_mul, mul_one] at h
    rwa [map_natCast]
  have hN : N ≠ ⊥ := fun h ↦ by
    have h_mem : ((I.cardQuot : ℕ) : R) ∈ N := h_index
    rw [h, Ideal.mem_bot, Nat.cast_eq_zero] at h_mem
    exact hI h_mem
  have h_le : completedIdeal K N ≤ I := by
    rw [completedIdeal_def]
    exact Ideal.map_le_iff_le_comap.2 le_rfl
  refine ⟨N, hN, le_antisymm (fun x hx ↦ ?_) h_le⟩
  obtain ⟨r, hr⟩ := exists_sub_mem_completedIdeal hN x
  have hrN : r ∈ N := by simpa [N] using (I.sub_mem hx (h_le hr))
  simpa using (completedIdeal K N).add_mem hr (algebraMap_mem_completedIdeal hrN)

/-- In characteristic zero, an ideal of finite index of the integral finite adeles `Ô` is
generated by an integral adele that is a unit of the finite adeles. -/
theorem exists_eq_span_singleton_of_cardQuot_ne_zero [CharZero R]
    {I : Ideal (integralAdeles R K)} (hI : I.cardQuot ≠ 0) :
    ∃ g : integralAdeles R K, IsUnit (g : 𝔸ᶠ[R, K]) ∧ I = Ideal.span {g} := by
  obtain ⟨N, hN, rfl⟩ := exists_eq_completedIdeal_of_cardQuot_ne_zero hI
  obtain ⟨t, ht⟩ := toFractionalIdeal_surjective (R := R) (K := K)
    (FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩)
  exact ⟨_, t.isUnit, completedIdeal_eq_span_singleton hN ht⟩

/-- In characteristic zero, every ideal of finite index of the integral finite adeles is
principal. -/
theorem isPrincipal_of_cardQuot_ne_zero [CharZero R] {I : Ideal (integralAdeles R K)}
    (hI : I.cardQuot ≠ 0) : I.IsPrincipal := by
  obtain ⟨g, -, rfl⟩ := exists_eq_span_singleton_of_cardQuot_ne_zero hI
  exact ⟨g, rfl⟩

end IsDedekindDomain.FiniteAdeleRing

namespace NumberField.FiniteAdeleRing

open IsDedekindDomain IsDedekindDomain.FiniteAdeleRing
open scoped NumberField.AdeleRing

variable {K : Type*} [Field K] [NumberField K]

/-- The finite adele ring of a number field is nontrivial. -/
instance : Nontrivial 𝔸ᶠ[K] :=
  (proj_surjective (K := K) (Classical.arbitrary (HeightOneSpectrum (𝓞 K)))).nontrivial

open Classical in
variable (K) in
/-- The **generalised index** `[a]` of a finite adele `a` of a number field: the absolute norm of
the fractional ideal of `a` if `a` is a unit, and `0` otherwise. It is the inverse of the factor
by which multiplication by `a` scales a Haar measure of the finite adeles. -/
def genIndex : 𝔸ᶠ[K] →*₀ ℚ where
  toFun a := if h : IsUnit a then
    FractionalIdeal.absNorm ((toFractionalIdeal h.unit : (FractionalIdeal (𝓞 K)⁰ K)ˣ) :
      FractionalIdeal (𝓞 K)⁰ K) else 0
  map_zero' := dite_eq_right not_isUnit_zero
  map_one' := by
    rw [dite_eq_left isUnit_one, IsUnit.unit_one, map_one, Units.val_one,
      FractionalIdeal.absNorm_one]
  map_mul' a b := by
    by_cases ha : IsUnit a
    · by_cases hb : IsUnit b
      · rw [dite_eq_left (ha.mul hb), dite_eq_left ha, dite_eq_left hb, ← map_mul,
          ← Units.val_mul, ← map_mul]
        congr 3
        exact Units.ext rfl
      · rw [dite_eq_right (fun h ↦ hb (isUnit_of_mul_isUnit_right h)), dite_eq_right hb, mul_zero]
    · rw [dite_eq_right (fun h ↦ ha (isUnit_of_mul_isUnit_left h)), dite_eq_right ha, zero_mul]

/-- The generalised index of a finite idele is the absolute norm of its fractional ideal. -/
theorem genIndex_units (t : 𝔸ᶠ[K]ˣ) :
    genIndex K t = FractionalIdeal.absNorm (toFractionalIdeal t : FractionalIdeal (𝓞 K)⁰ K) := by
  simp only [genIndex, MonoidWithZeroHom.coe_mk, ZeroHom.coe_mk, dite_eq_left t.isUnit,
    IsUnit.unit_of_val_units]

/-- The generalised index of a finite adele that is not a unit is `0`. -/
theorem genIndex_of_not_isUnit {a : 𝔸ᶠ[K]} (ha : ¬ IsUnit a) : genIndex K a = 0 := by
  simp only [genIndex, MonoidWithZeroHom.coe_mk, ZeroHom.coe_mk, dite_eq_right ha]

/-- The generalised index of a finite idele is positive. -/
theorem genIndex_units_pos (t : 𝔸ᶠ[K]ˣ) : 0 < genIndex K t := by
  rw [genIndex_units]
  refine (FractionalIdeal.absNorm_nonneg _).lt_of_ne' fun h ↦ ?_
  exact (toFractionalIdeal t).ne_zero (FractionalIdeal.absNorm_eq_zero_iff.1 h)

/-- The generalised index is nonnegative. -/
theorem genIndex_nonneg (a : 𝔸ᶠ[K]) : 0 ≤ genIndex K a := by
  by_cases ha : IsUnit a
  · exact (genIndex_units_pos ha.unit).le
  · exact (genIndex_of_not_isUnit ha).ge

/-- The generalised index of a finite adele vanishes exactly when it is not a unit. -/
theorem genIndex_eq_zero_iff {a : 𝔸ᶠ[K]} : genIndex K a = 0 ↔ ¬ IsUnit a :=
  ⟨fun h ha ↦ (genIndex_units_pos ha.unit).ne' h, genIndex_of_not_isUnit⟩

/-- The generalised index of the diagonal image of `x ∈ K` is `|N_{K/ℚ} x|`. -/
theorem genIndex_algebraMap (x : K) : genIndex K (algebraMap K 𝔸ᶠ[K] x) = |Algebra.norm ℚ x| := by
  obtain rfl | hx := eq_or_ne x 0
  · simp
  have h := genIndex_units (unitEmbedding (𝓞 K) K (Units.mk0 x hx))
  rw [toFractionalIdeal_unitEmbedding, coe_toPrincipalIdeal, Units.val_mk0,
    FractionalIdeal.absNorm_span_singleton] at h
  exact h

/-- Let `g` be an integral finite adele that is a unit of the finite adeles. Its generalised index
is the index `[Ô : gÔ]` of the ideal it generates in the integral finite adeles `Ô`. -/
theorem genIndex_eq_cardQuot {g : integralAdeles (𝓞 K) K} (hg : IsUnit (g : 𝔸ᶠ[K])) :
    genIndex K g = (Ideal.span {g}).cardQuot := by
  obtain ⟨N, hN⟩ := FractionalIdeal.le_one_iff_exists_coeIdeal.1
    ((toFractionalIdeal_le_one_iff hg.unit).2 g.property)
  have hN0 : N ≠ ⊥ := by
    rintro rfl
    exact (toFractionalIdeal hg.unit).ne_zero (by rw [← hN, FractionalIdeal.coeIdeal_bot])
  have ht : toFractionalIdeal hg.unit =
      FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN0⟩ :=
    Units.ext (by rw [FractionalIdeal.coe_mk0, hN])
  have h_span : Ideal.span {g} = completedIdeal K N := by
    rw [completedIdeal_eq_span_singleton hN0 ht]
    rfl
  have : Finite (𝓞 K ⧸ N) := Ring.HasFiniteQuotients.finiteQuotient hN0
  rw [h_span, Submodule.cardQuot_apply, ← Nat.card_congr
      (quotientEquivQuotientCompletedIdeal K hN0).toEquiv, ← Submodule.cardQuot_apply,
    ← Ideal.absNorm_apply, ← FractionalIdeal.coeIdeal_absNorm (K := K), hN,
    ← genIndex_units hg.unit, IsUnit.unit_spec]

/-- Some positive integer multiple of a finite adele is integral. -/
theorem exists_natCast_mul_mem_integralAdeles (a : 𝔸ᶠ[K]) :
    ∃ m : ℕ, m ≠ 0 ∧ (m : 𝔸ᶠ[K]) * a ∈ integralAdeles (𝓞 K) K := by
  obtain ⟨b, hb, hab⟩ := mul_nonZeroDivisor_mem_integralAdeles (R := 𝓞 K) a
  have hb0 : Ideal.span {b} ≠ ⊥ := by simpa using nonZeroDivisors.ne_zero hb
  have h_mem : ((Ideal.span {b}).cardQuot : 𝓞 K) ∈ Ideal.span {b} := by
    have h := AddSubgroup.nsmul_index_mem (Ideal.span {b}).toAddSubgroup 1
    rwa [nsmul_eq_mul, mul_one] at h
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 h_mem
  refine ⟨(Ideal.span {b}).cardQuot, (Ring.HasFiniteQuotients.cardQuot_pos _ hb0).ne', ?_⟩
  have h_eq : ((Ideal.span {b}).cardQuot : 𝔸ᶠ[K]) * a =
      algebraMap (𝓞 K) 𝔸ᶠ[K] c * (a * algebraMap (𝓞 K) 𝔸ᶠ[K] b) := by
    rw [← map_natCast (algebraMap (𝓞 K) 𝔸ᶠ[K]), ← hc, map_mul]
    ring
  rw [h_eq]
  exact mul_mem ((integralAdeles (𝓞 K) K).algebraMap_mem c) hab

/-- Two integral adeles that correspond under a ring isomorphism of `Ô` generate ideals of the
same index. -/
private theorem cardQuot_span_singleton_map
    (σ : integralAdeles (𝓞 K) K ≃+* integralAdeles (𝓞 K) K) (g : integralAdeles (𝓞 K) K) :
    (Ideal.span {σ g}).cardQuot = (Ideal.span {g}).cardQuot := by
  rw [Submodule.cardQuot_apply, Submodule.cardQuot_apply]
  refine (Nat.card_congr (Ideal.quotientEquiv _ _ σ ?_).toEquiv).symm
  rw [Ideal.map_span, Set.image_singleton]
  rfl

/-- A ring automorphism of the finite adeles that preserves the integral finite adeles restricts
to a ring automorphism of the integral finite adeles. -/
private def restrictIntegral (σ : 𝔸ᶠ[K] ≃+* 𝔸ᶠ[K])
    (hσ : ∀ x, σ x ∈ integralAdeles (𝓞 K) K ↔ x ∈ integralAdeles (𝓞 K) K) :
    integralAdeles (𝓞 K) K ≃+* integralAdeles (𝓞 K) K where
  toFun x := ⟨σ x, (hσ x).mpr x.property⟩
  invFun x := ⟨σ.symm (x : 𝔸ᶠ[K]), by rw [← hσ, RingEquiv.apply_symm_apply]; exact x.property⟩
  left_inv x := Subtype.ext (σ.symm_apply_apply (x : 𝔸ᶠ[K]))
  right_inv x := Subtype.ext (σ.apply_symm_apply (x : 𝔸ᶠ[K]))
  map_mul' x y := Subtype.ext (map_mul σ (x : 𝔸ᶠ[K]) y)
  map_add' x y := Subtype.ext (map_add σ (x : 𝔸ᶠ[K]) y)

/-- The generalised index is invariant under a ring automorphism `σ` of the finite adeles that
preserves the integral finite adeles. -/
theorem genIndex_map (σ : 𝔸ᶠ[K] ≃+* 𝔸ᶠ[K])
    (hσ : ∀ x, σ x ∈ integralAdeles (𝓞 K) K ↔ x ∈ integralAdeles (𝓞 K) K) (a : 𝔸ᶠ[K]) :
    genIndex K (σ a) = genIndex K a := by
  by_cases ha : IsUnit a
  swap
  · rw [genIndex_of_not_isUnit ha, genIndex_of_not_isUnit (by rwa [isUnit_map_iff])]
  -- Reduce to an integral multiple `m a`, on which the index is that of an ideal of `Ô`.
  obtain ⟨m, hm, hma⟩ := exists_natCast_mul_mem_integralAdeles a
  have hm' : IsUnit (m : 𝔸ᶠ[K]) := by
    simpa using (Nat.cast_ne_zero.2 hm : (m : K) ≠ 0).isUnit.map (algebraMap K 𝔸ᶠ[K])
  have h_int : genIndex K (σ ((m : 𝔸ᶠ[K]) * a)) = genIndex K ((m : 𝔸ᶠ[K]) * a) := by
    have h₁ := genIndex_eq_cardQuot (g := restrictIntegral σ hσ ⟨_, hma⟩)
      ((isUnit_map_iff σ _).2 (hm'.mul ha))
    have h₂ := genIndex_eq_cardQuot (g := ⟨_, hma⟩) (hm'.mul ha)
    rw [cardQuot_span_singleton_map] at h₁
    exact h₁.trans h₂.symm
  rw [map_mul, map_natCast, map_mul, map_mul] at h_int
  exact mul_left_cancel₀ ((genIndex_units_pos hm'.unit).ne') h_int

end NumberField.FiniteAdeleRing
