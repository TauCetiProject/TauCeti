module

public import Mathlib.RingTheory.Ideal.Norm.AbsNorm
public import TauCeti.RingTheory.DedekindDomain.FiniteAdeleRing.FractionalIdeal
import TauCeti.Algebra.Algebra.NatCast

/-!
# The completion of an integral ideal in the integral finite adeles

For a Dedekind domain `R` with fraction field `K`, write `Ô = ∏_v 𝒪_v` for the integral finite
adeles `IsDedekindDomain.FiniteAdeleRing.integralAdeles R K`. An integral ideal `N` of `R`
extends to the ideal `NÔ = N.map (algebraMap R Ô)`, the image of `N ⊗[R] Ô`. No generator of `N`
is chosen.

For `N ≠ ⊥`, the ideal `NÔ` is the trace on `Ô` of the finite adelic extension
`IsDedekindDomain.FiniteAdeleRing.finiteAdelicIdeal` of `N`, viewed as a nonzero fractional ideal.
It is open and closed in `Ô`, its rational points are `N`, and the diagonal map induces a ring
isomorphism `R ⧸ N ≃ Ô ⧸ NÔ`, so `NÔ` has the same index in `Ô` as `N` in `R`. The proofs use
only that `R` is dense in `Ô` and that `aÔ` is open in the finite adeles for every nonzero
`a ∈ R`; no ideal factorization is needed.

## Main declarations

* `IsDedekindDomain.FiniteAdeleRing.completedIdeal`: the ideal `NÔ` of the integral finite
  adeles.
* `IsDedekindDomain.FiniteAdeleRing.algebraMap_mem_completedIdeal_iff`: for `N ≠ ⊥`, the rational
  points of `NÔ` are the elements of `N`.
* `IsDedekindDomain.FiniteAdeleRing.coe_mem_finiteAdelicIdeal_iff_mem_completedIdeal`: an integral
  finite adele lies in `NÔ` exactly when it lies in the finite adelic extension of `N`.
* `IsDedekindDomain.FiniteAdeleRing.isOpen_completedIdeal`,
  `IsDedekindDomain.FiniteAdeleRing.isClosed_completedIdeal`: for `N ≠ ⊥`, `NÔ` is open and closed
  in `Ô`.
* `IsDedekindDomain.FiniteAdeleRing.quotientEquivQuotientCompletedIdeal`: the diagonal ring
  isomorphism `R ⧸ N ≃ Ô ⧸ NÔ` for `N ≠ ⊥`.
* `IsDedekindDomain.FiniteAdeleRing.cardQuot_completedIdeal`: `[Ô : NÔ] = [R : N]` for `N ≠ ⊥`.

## References

* J. S. Milne, *Introduction to Shimura varieties*, §4, p. 42.
-/

public section
noncomputable section

open IsDedekindDomain HeightOneSpectrum
open scoped nonZeroDivisors

namespace IsDedekindDomain.FiniteAdeleRing

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

variable (K) in
/-- The **completion `NÔ`** of an integral ideal `N` of `R` in the integral finite adeles
`Ô = ∏_v 𝒪_v`: the ideal generated by the image of `N`, that is, the image of `N ⊗[R] Ô`. -/
def completedIdeal (N : Ideal R) : Ideal (integralAdeles R K) :=
  N.map (algebraMap R (integralAdeles R K))

variable (K) in
/-- The completion of an ideal is generated by the image of the ideal. -/
theorem completedIdeal_def (N : Ideal R) :
    completedIdeal K N = N.map (algebraMap R (integralAdeles R K)) :=
  (rfl)

variable (K) in
/-- The completion of the unit ideal is the whole ring of integral finite adeles. -/
@[simp]
theorem completedIdeal_top : completedIdeal K (⊤ : Ideal R) = ⊤ :=
  Ideal.map_top _

variable (K) in
/-- The completion of the zero ideal is zero. -/
@[simp]
theorem completedIdeal_bot : completedIdeal K (⊥ : Ideal R) = ⊥ :=
  Ideal.map_bot

variable (K) in
/-- Completion of ideals is monotone. -/
theorem completedIdeal_mono : Monotone (completedIdeal (R := R) K) :=
  fun _ _ h ↦ Ideal.map_mono h

/-- The image of an element of `N` lies in `NÔ`. -/
theorem algebraMap_mem_completedIdeal {N : Ideal R} {r : R} (hr : r ∈ N) :
    algebraMap R (integralAdeles R K) r ∈ completedIdeal K N :=
  Ideal.mem_map_of_mem _ hr

/-- The diagonal image of `r ∈ R` lies in the finite adelic extension of a nonzero ideal `N`,
viewed as a unit fractional ideal, exactly when `r ∈ N`. -/
theorem algebraMap_mem_finiteAdelicIdeal_mk0_iff {N : Ideal R} (hN : N ≠ ⊥) (r : R) :
    algebraMap R 𝔸ᶠ[R, K] r ∈
        finiteAdelicIdeal (FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩) ↔
      r ∈ N := by
  rw [IsScalarTower.algebraMap_apply R K, algebraMap_mem_finiteAdelicIdeal_iff,
    FractionalIdeal.coe_mk0, FractionalIdeal.mem_coeIdeal]
  refine ⟨fun ⟨s, hs, hsr⟩ ↦ ?_, fun hr ↦ ⟨r, hr, rfl⟩⟩
  rwa [← IsFractionRing.injective R K hsr]

/-- Elements of `NÔ` lie in the finite adelic extension of `N`. -/
theorem coe_mem_finiteAdelicIdeal_of_mem_completedIdeal {N : Ideal R} (hN : N ≠ ⊥)
    {x : integralAdeles R K} (hx : x ∈ completedIdeal K N) :
    (x : 𝔸ᶠ[R, K]) ∈
      finiteAdelicIdeal (FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩) := by
  -- The trace of the adelic extension on `Ô` is an ideal containing the image of `N`.
  let J : Ideal (integralAdeles R K) :=
    (finiteAdelicIdeal (FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩)).comap
      (Algebra.linearMap (integralAdeles R K) 𝔸ᶠ[R, K])
  have hle : completedIdeal K N ≤ J := by
    refine Ideal.map_le_iff_le_comap.mpr fun r hr ↦ ?_
    rw [Ideal.mem_comap, Submodule.mem_comap, Algebra.linearMap_apply,
      ← IsScalarTower.algebraMap_apply]
    exact (algebraMap_mem_finiteAdelicIdeal_mk0_iff hN r).mpr hr
  have hxJ := hle hx
  rwa [Submodule.mem_comap, Algebra.linearMap_apply, Subalgebra.algebraMap_apply] at hxJ

variable (K) in
/-- For `N ≠ ⊥`, the completion `NÔ` is open in the integral finite adeles. -/
theorem isOpen_completedIdeal {N : Ideal R} (hN : N ≠ ⊥) :
    IsOpen (completedIdeal K N : Set (integralAdeles R K)) := by
  obtain ⟨a, haN, ha⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hN
  set c : 𝔸ᶠ[R, K] := algebraMap K 𝔸ᶠ[R, K] (algebraMap R K a)⁻¹
  -- The integral finite adeles `y` with `a⁻¹ y` integral form an open neighbourhood of zero
  -- contained in `aÔ ⊆ NÔ`.
  let U : Set (integralAdeles R K) := {y | c * (y : 𝔸ᶠ[R, K]) ∈ integralAdeles R K}
  have hU : IsOpen U :=
    (isOpen_integralAdeles R K).preimage (continuous_const.mul continuous_subtypeVal)
  have hUN : U ⊆ completedIdeal K N := by
    intro y hy
    have hy' : y = algebraMap R (integralAdeles R K) a * ⟨_, hy⟩ := by
      refine Subtype.ext ?_
      simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
      rw [← mul_assoc, TauCeti.algebraMap_mul_algebraMap_inv
        ((map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr ha), one_mul]
    rw [SetLike.mem_coe, hy']
    exact Ideal.mul_mem_right _ _ (algebraMap_mem_completedIdeal haN)
  have h0 : (0 : integralAdeles R K) ∈ U := by
    simpa only [U, Set.mem_ofPred_eq, ZeroMemClass.coe_zero, mul_zero] using
      zero_mem (integralAdeles R K)
  exact (completedIdeal K N).toAddSubgroup.isOpen_of_mem_nhds
    (Filter.mem_of_superset (hU.mem_nhds h0) hUN)

variable (K) in
/-- For `N ≠ ⊥`, the completion `NÔ` is closed in the integral finite adeles. -/
theorem isClosed_completedIdeal {N : Ideal R} (hN : N ≠ ⊥) :
    IsClosed (completedIdeal K N : Set (integralAdeles R K)) :=
  (completedIdeal K N).toAddSubgroup.isClosed_of_isOpen (isOpen_completedIdeal K hN)

/-- For `N ≠ ⊥`, every integral finite adele is congruent modulo `NÔ` to the diagonal image of an
element of `R`: `R` is dense in `Ô` and `NÔ` is open. -/
theorem exists_sub_mem_completedIdeal {N : Ideal R} (hN : N ≠ ⊥) (x : integralAdeles R K) :
    ∃ r : R, x - algebraMap R (integralAdeles R K) r ∈ completedIdeal K N :=
  (denseRange_algebraMap_integralAdeles R K).exists_mem_open
    ((isOpen_completedIdeal K hN).preimage (continuous_const.sub continuous_id)) ⟨x, by simp⟩

/-- For `N ≠ ⊥`, an integral finite adele lies in the finite adelic extension of `N` exactly when
it lies in `NÔ`. -/
theorem coe_mem_finiteAdelicIdeal_iff_mem_completedIdeal {N : Ideal R} (hN : N ≠ ⊥)
    (x : integralAdeles R K) :
    (x : 𝔸ᶠ[R, K]) ∈
        finiteAdelicIdeal (FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩) ↔
      x ∈ completedIdeal K N := by
  refine ⟨fun hx ↦ ?_, coe_mem_finiteAdelicIdeal_of_mem_completedIdeal hN⟩
  obtain ⟨r, hr⟩ := exists_sub_mem_completedIdeal hN x
  have hrN : r ∈ N := by
    rw [← algebraMap_mem_finiteAdelicIdeal_mk0_iff (K := K) hN]
    have h := sub_mem hx (coe_mem_finiteAdelicIdeal_of_mem_completedIdeal hN hr)
    simpa only [Subalgebra.coe_sub, Subalgebra.coe_algebraMap, sub_sub_cancel] using h
  simpa using add_mem hr (algebraMap_mem_completedIdeal (K := K) hrN)

/-- For `N ≠ ⊥`, the rational points of `NÔ` are the elements of `N`. -/
theorem algebraMap_mem_completedIdeal_iff {N : Ideal R} (hN : N ≠ ⊥) {r : R} :
    algebraMap R (integralAdeles R K) r ∈ completedIdeal K N ↔ r ∈ N := by
  rw [← coe_mem_finiteAdelicIdeal_iff_mem_completedIdeal hN, Subalgebra.coe_algebraMap,
    algebraMap_mem_finiteAdelicIdeal_mk0_iff hN]

variable (K) in
/-- For `N ≠ ⊥`, pulling `NÔ` back along the diagonal map recovers `N`. -/
theorem comap_completedIdeal {N : Ideal R} (hN : N ≠ ⊥) :
    (completedIdeal K N).comap (algebraMap R (integralAdeles R K)) = N :=
  Ideal.ext fun _ ↦ algebraMap_mem_completedIdeal_iff hN

variable (K) in
/-- For `N ≠ ⊥`, the kernel of the diagonal map `R → Ô ⧸ NÔ` is `N`. -/
theorem ker_quotientMk_comp_algebraMap {N : Ideal R} (hN : N ≠ ⊥) :
    RingHom.ker ((Ideal.Quotient.mk (completedIdeal K N)).comp
      (algebraMap R (integralAdeles R K))) = N := by
  rw [← RingHom.comap_ker, Ideal.mk_ker, comap_completedIdeal K hN]

variable (K) in
/-- For `N ≠ ⊥`, the diagonal map `R → Ô ⧸ NÔ` is surjective. -/
theorem quotientMk_comp_algebraMap_surjective {N : Ideal R} (hN : N ≠ ⊥) :
    Function.Surjective ((Ideal.Quotient.mk (completedIdeal K N)).comp
      (algebraMap R (integralAdeles R K))) := fun x ↦ by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨r, hr⟩ := exists_sub_mem_completedIdeal (K := K) hN x
  exact ⟨r, (Ideal.Quotient.eq.mpr hr).symm⟩

variable (K) in
/-- For `N ≠ ⊥`, the diagonal map induces a ring isomorphism `R ⧸ N ≃ Ô ⧸ NÔ`. -/
def quotientEquivQuotientCompletedIdeal {N : Ideal R} (hN : N ≠ ⊥) :
    R ⧸ N ≃+* integralAdeles R K ⧸ completedIdeal K N :=
  (Ideal.quotEquivOfEq (ker_quotientMk_comp_algebraMap K hN).symm).trans
    (RingHom.quotientKerEquivOfSurjective (quotientMk_comp_algebraMap_surjective K hN))

/-- The isomorphism `R ⧸ N ≃ Ô ⧸ NÔ` is induced by the diagonal map. -/
@[simp]
theorem quotientEquivQuotientCompletedIdeal_mk {N : Ideal R} (hN : N ≠ ⊥) (r : R) :
    quotientEquivQuotientCompletedIdeal K hN (Ideal.Quotient.mk N r) =
      Ideal.Quotient.mk _ (algebraMap R (integralAdeles R K) r) := by
  rw [quotientEquivQuotientCompletedIdeal, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk, RingHom.comp_apply]

variable (K) in
/-- For `N ≠ ⊥`, the completion `NÔ` has the same index in `Ô` as `N` has in `R`. -/
@[simp]
theorem cardQuot_completedIdeal {N : Ideal R} (hN : N ≠ ⊥) :
    (completedIdeal K N).cardQuot = N.cardQuot := by
  rw [Submodule.cardQuot_apply, Submodule.cardQuot_apply,
    Nat.card_congr (quotientEquivQuotientCompletedIdeal K hN).toEquiv]

variable (K) in
/-- For `N ≠ ⊥` with `R ⧸ N` finite, for instance over the ring of integers of a number field,
the quotient `Ô ⧸ NÔ` is finite. -/
theorem finite_quotient_completedIdeal {N : Ideal R} (hN : N ≠ ⊥) [Finite (R ⧸ N)] :
    Finite (integralAdeles R K ⧸ completedIdeal K N) :=
  .of_equiv _ (quotientEquivQuotientCompletedIdeal K hN).toEquiv

end IsDedekindDomain.FiniteAdeleRing
