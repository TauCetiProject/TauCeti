module

public import TauCeti.RingTheory.DedekindDomain.FiniteAdeleRing.ClassGroup
public import TauCeti.RingTheory.DedekindDomain.FiniteAdeleRing.Place
public import TauCeti.RingTheory.DedekindDomain.FiniteAdeleRing.Units

/-!
# The finite ideles at a single place

Let `R` be a Dedekind domain with fraction field `K`, and let `𝔸ᶠ = 𝔸ᶠ[R, K]` be its finite adele
ring. The finite ideles `𝔸ᶠˣ` carry the units topology. This file relates them to one local unit
group `K_vˣ` at a time, as `IsDedekindDomain.FiniteAdeleRing.proj` and
`IsDedekindDomain.FiniteAdeleRing.single` do for the finite adeles:

* the coordinate `unitsProj K v : 𝔸ᶠˣ →* K_vˣ` reads off the `v`-component of a finite idele. It is
  continuous, surjective and open, hence a quotient map, and on the principal finite ideles it is
  the completion map `Kˣ → K_vˣ`;
* the embedding `unitsOfAdicCompletion K v : K_vˣ →* 𝔸ᶠˣ` sends `u` to the finite idele with
  `v`-component `u` and all other components `1`. It is a closed embedding, a section of
  `unitsProj K v`, and its range is the set of finite ideles that are `1` away from `v`.

The local integral units `{u ∈ K_vˣ | |u|_v = 1}` are exactly the coordinates at `v` of the
everywhere-integral finite ideles `integralUnits R K`. Combined with the restricted-product
condition, the single-place embeddings decompose the finite ideles: for a finite set `S` of
places, every `S`-integral finite idele `x` is the product of the finite ideles concentrated at the
places of `S` with the coordinates of `x` there, and an everywhere-integral unit. Hence

`sIntegralUnits R K S = (⨆ v ∈ S, K_vˣ) ⊔ integralUnits R K`,

and the finite idele group is generated by the local unit groups `K_vˣ` together with the
everywhere-integral units.

## Main definitions

* `IsDedekindDomain.FiniteAdeleRing.unitsProj`: the coordinate of a finite idele at a finite place.
* `IsDedekindDomain.FiniteAdeleRing.unitsOfAdicCompletion`: the finite ideles concentrated at a
  single place.

## Main results

* `IsDedekindDomain.FiniteAdeleRing.isOpenQuotientMap_unitsProj`: the coordinate at `v` is an open
  quotient map for the units topology.
* `IsDedekindDomain.FiniteAdeleRing.isClosedEmbedding_unitsOfAdicCompletion` and
  `IsDedekindDomain.FiniteAdeleRing.mem_range_unitsOfAdicCompletion_iff`: the single-place
  embedding is a closed embedding onto the finite ideles that are `1` away from `v`.
* `IsDedekindDomain.FiniteAdeleRing.image_unitsProj_integralUnits`: the everywhere-integral units
  project onto the local integral units.
* `IsDedekindDomain.FiniteAdeleRing.sIntegralUnits_eq_iSup_range_sup_integralUnits`: the
  `S`-integral finite ideles are generated by the local unit groups at the places of `S` and the
  everywhere-integral units.
* `IsDedekindDomain.FiniteAdeleRing.iSup_range_unitsOfAdicCompletion_sup_integralUnits`: the finite
  ideles are generated by all local unit groups and the everywhere-integral units.

## References

* J. W. S. Cassels and A. Fröhlich, eds., *Algebraic Number Theory*, Chapter II, §16.
* A. Weil, *Basic Number Theory*, Chapter IV, §3.
-/

public section

namespace IsDedekindDomain.FiniteAdeleRing

open HeightOneSpectrum Topology

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K]

/-! ### The coordinate of a finite idele at one place -/

variable (K) in
/-- The coordinate of a finite idele at a finite place `v`, a unit of the completion
`v.adicCompletion K`. -/
noncomputable def unitsProj (v : HeightOneSpectrum R) : 𝔸ᶠ[R, K]ˣ →* (v.adicCompletion K)ˣ :=
  Units.map (RestrictedProduct.evalMonoidHom _ v)

/-- The coordinate of a finite idele at `v` is its `v`-component. -/
@[simp]
theorem coe_unitsProj_apply (v : HeightOneSpectrum R) (x : 𝔸ᶠ[R, K]ˣ) :
    (unitsProj K v x : v.adicCompletion K) = (x : 𝔸ᶠ[R, K]) v :=
  (rfl)

/-- The coordinate at `v` is continuous for the units topology on the finite ideles. -/
@[continuity, fun_prop]
theorem continuous_unitsProj (v : HeightOneSpectrum R) : Continuous (unitsProj K v) :=
  Continuous.units_map _ (RestrictedProduct.continuous_eval v)

/-- The coordinate at `v` of a principal finite idele is the image of the global unit in the
completion at `v`. -/
@[simp]
theorem unitsProj_unitEmbedding (v : HeightOneSpectrum R) (x : Kˣ) :
    unitsProj K v (unitEmbedding R K x) =
      Units.map (algebraMap K (v.adicCompletion K)).toMonoidHom x :=
  Units.ext (algebraMap_apply R K (x : K) v)

/-! ### The finite ideles concentrated at one place -/

variable (K) in
/-- The finite idele concentrated at the single place `v`: its `v`-component is the unit `u` of
`v.adicCompletion K` and all its other components are `1`. -/
noncomputable def unitsOfAdicCompletion (v : HeightOneSpectrum R) :
    (v.adicCompletion K)ˣ →* 𝔸ᶠ[R, K]ˣ :=
  Units.map (ofAdicCompletion K v)

/-- The finite adele underlying `unitsOfAdicCompletion K v u` is `ofAdicCompletion K v u`. -/
@[simp]
theorem coe_unitsOfAdicCompletion_apply (v : HeightOneSpectrum R) (u : (v.adicCompletion K)ˣ) :
    (unitsOfAdicCompletion K v u : 𝔸ᶠ[R, K]) = ofAdicCompletion K v u :=
  (rfl)

/-- The finite idele concentrated at `v` has coordinate `u` at `v`. -/
@[simp]
theorem unitsProj_unitsOfAdicCompletion (v : HeightOneSpectrum R) (u : (v.adicCompletion K)ˣ) :
    unitsProj K v (unitsOfAdicCompletion K v u) = u :=
  Units.ext <| by
    classical
    exact (ofAdicCompletion_apply_coe K v u v).trans (Pi.mulSingle_eq_same _ _)

/-- The finite idele concentrated at `v` has coordinate `1` at every other place. -/
@[simp]
theorem unitsProj_unitsOfAdicCompletion_of_ne {v w : HeightOneSpectrum R} (h : w ≠ v)
    (u : (v.adicCompletion K)ˣ) :
    unitsProj K w (unitsOfAdicCompletion K v u) = 1 :=
  Units.ext <| by
    classical
    exact (ofAdicCompletion_apply_coe K v u w).trans (Pi.mulSingle_eq_of_ne h _)

/-- The coordinates of a product of finite ideles, one concentrated at each place of a finite set
`S`: the prescribed unit at a place of `S`, and `1` elsewhere. -/
theorem unitsProj_prod_unitsOfAdicCompletion [DecidableEq (HeightOneSpectrum R)]
    (w : HeightOneSpectrum R) (S : Finset (HeightOneSpectrum R))
    (u : ∀ v : HeightOneSpectrum R, (v.adicCompletion K)ˣ) :
    unitsProj K w (∏ v ∈ S, unitsOfAdicCompletion K v (u v)) = if w ∈ S then u w else 1 := by
  rw [map_prod]
  split_ifs with hw
  · rw [Finset.prod_eq_single_of_mem w hw fun v _ hv ↦
      unitsProj_unitsOfAdicCompletion_of_ne (Ne.symm hv) (u v)]
    exact unitsProj_unitsOfAdicCompletion w (u w)
  · exact Finset.prod_eq_one fun v hv ↦
      unitsProj_unitsOfAdicCompletion_of_ne (ne_of_mem_of_not_mem hv hw).symm (u v)

/-- The coordinate at `v` is a left inverse of the embedding concentrated at `v`. -/
theorem leftInverse_unitsProj_unitsOfAdicCompletion (v : HeightOneSpectrum R) :
    Function.LeftInverse (unitsProj K v) (unitsOfAdicCompletion K v) :=
  unitsProj_unitsOfAdicCompletion v

/-- The coordinate at `v` is surjective. -/
theorem unitsProj_surjective (v : HeightOneSpectrum R) :
    Function.Surjective (unitsProj K v) :=
  (leftInverse_unitsProj_unitsOfAdicCompletion v).surjective

/-- The embedding concentrated at `v` is injective. -/
theorem unitsOfAdicCompletion_injective (v : HeightOneSpectrum R) :
    Function.Injective (unitsOfAdicCompletion K v) :=
  (leftInverse_unitsProj_unitsOfAdicCompletion v).injective

/-- A finite idele is concentrated at `v` exactly when it is `unitsOfAdicCompletion K v` of its
coordinate at `v`. -/
theorem eq_unitsOfAdicCompletion_iff (v : HeightOneSpectrum R) (x : 𝔸ᶠ[R, K]ˣ) :
    x = unitsOfAdicCompletion K v (unitsProj K v x) ↔ ∀ w ≠ v, unitsProj K w x = 1 := by
  refine ⟨fun h w hw ↦ by rw [h, unitsProj_unitsOfAdicCompletion_of_ne hw], fun h ↦ ?_⟩
  refine Units.ext (FiniteAdeleRing.ext K fun w ↦ ?_)
  rw [← coe_unitsProj_apply, ← coe_unitsProj_apply]
  rcases eq_or_ne w v with rfl | hw
  · rw [unitsProj_unitsOfAdicCompletion]
  · rw [unitsProj_unitsOfAdicCompletion_of_ne hw, h w hw]

/-- The range of `unitsOfAdicCompletion K v` is the set of finite ideles whose coordinates at all
places other than `v` are `1`. -/
theorem mem_range_unitsOfAdicCompletion_iff {v : HeightOneSpectrum R} {x : 𝔸ᶠ[R, K]ˣ} :
    x ∈ (unitsOfAdicCompletion K v).range ↔ ∀ w ≠ v, unitsProj K w x = 1 := by
  refine ⟨?_, fun h ↦ ⟨unitsProj K v x, ((eq_unitsOfAdicCompletion_iff v x).mpr h).symm⟩⟩
  rintro ⟨u, rfl⟩ w hw
  exact unitsProj_unitsOfAdicCompletion_of_ne hw u

/-! ### Topological properties -/

/-- The embedding concentrated at `v` is continuous for the units topology on the finite
ideles. -/
@[continuity, fun_prop]
theorem continuous_unitsOfAdicCompletion (v : HeightOneSpectrum R) :
    Continuous (unitsOfAdicCompletion K v) :=
  Continuous.units_map _ (continuous_ofAdicCompletion K v)

/-- The embedding concentrated at `v` is a closed embedding of `K_vˣ` into the finite ideles. -/
theorem isClosedEmbedding_unitsOfAdicCompletion (v : HeightOneSpectrum R) :
    IsClosedEmbedding (unitsOfAdicCompletion K v) :=
  (leftInverse_unitsProj_unitsOfAdicCompletion v).isClosedEmbedding (continuous_unitsProj v)
    (continuous_unitsOfAdicCompletion v)

/-- The coordinate at `v` is an open map for the units topology on the finite ideles. -/
theorem isOpenMap_unitsProj (v : HeightOneSpectrum R) :
    IsOpenMap (unitsProj K v : 𝔸ᶠ[R, K]ˣ → (v.adicCompletion K)ˣ) := by
  -- Through `unitsContinuousMulEquiv`, the coordinate at `v` is evaluation at `v` on the
  -- restricted product of the local unit groups, which is open.
  have h : (unitsProj K v : 𝔸ᶠ[R, K]ˣ → (v.adicCompletion K)ˣ) =
      (fun y ↦ y v) ∘ unitsContinuousMulEquiv R K :=
    funext fun x ↦ Units.ext (coe_unitsContinuousMulEquiv_apply x v).symm
  rw [h]
  exact (TauCeti.isOpenMap_restrictedProduct_eval v).comp
    (unitsContinuousMulEquiv R K).toHomeomorph.isOpenMap

/-- The coordinate at `v` is an open quotient map for the units topology on the finite ideles. -/
theorem isOpenQuotientMap_unitsProj (v : HeightOneSpectrum R) :
    IsOpenQuotientMap (unitsProj K v : 𝔸ᶠ[R, K]ˣ → (v.adicCompletion K)ˣ) :=
  ⟨unitsProj_surjective v, continuous_unitsProj v, isOpenMap_unitsProj v⟩

/-! ### Integral units and the decomposition of `S`-integral finite ideles -/

/-- The finite idele concentrated at `v` is `S`-integral for every `S` containing `v`. -/
theorem unitsOfAdicCompletion_mem_sIntegralUnits {S : Set (HeightOneSpectrum R)}
    {v : HeightOneSpectrum R} (hv : v ∈ S) (u : (v.adicCompletion K)ˣ) :
    unitsOfAdicCompletion K v u ∈ sIntegralUnits R K S := by
  refine mem_sIntegralUnits_iff.mpr fun w hw ↦ ?_
  rw [← coe_unitsProj_apply,
    unitsProj_unitsOfAdicCompletion_of_ne (ne_of_mem_of_not_mem hv hw).symm, Units.val_one, map_one]

/-- The finite idele concentrated at `v` is an everywhere-integral unit exactly when its
coordinate at `v` is a local integral unit. -/
theorem unitsOfAdicCompletion_mem_integralUnits_iff {v : HeightOneSpectrum R}
    {u : (v.adicCompletion K)ˣ} :
    unitsOfAdicCompletion K v u ∈ integralUnits R K ↔ Valued.v (u : v.adicCompletion K) = 1 := by
  refine ⟨fun h ↦ ?_, fun h ↦ mem_integralUnits_iff.mpr fun w ↦ ?_⟩
  · simpa only [← coe_unitsProj_apply, unitsProj_unitsOfAdicCompletion] using
      mem_integralUnits_iff.mp h v
  · rw [← coe_unitsProj_apply]
    rcases eq_or_ne w v with rfl | hw
    · rwa [unitsProj_unitsOfAdicCompletion]
    · rw [unitsProj_unitsOfAdicCompletion_of_ne hw, Units.val_one, map_one]

/-- The everywhere-integral finite ideles project onto the local integral units at `v`. -/
theorem image_unitsProj_integralUnits (v : HeightOneSpectrum R) :
    unitsProj K v '' (integralUnits R K : Set 𝔸ᶠ[R, K]ˣ) =
      {u : (v.adicCompletion K)ˣ | Valued.v (u : v.adicCompletion K) = 1} := by
  ext u
  refine ⟨?_, fun hu ↦ ⟨unitsOfAdicCompletion K v u,
    unitsOfAdicCompletion_mem_integralUnits_iff.mpr hu, unitsProj_unitsOfAdicCompletion v u⟩⟩
  rintro ⟨x, hx, rfl⟩
  exact mem_integralUnits_iff.mp hx v

/-- **Splitting off the places of `S`**: dividing an `S`-integral finite idele `x` by the product,
over the places `v` of the finite set `S`, of the finite ideles concentrated at `v` with
coordinate that of `x` leaves an everywhere-integral unit. -/
theorem prod_unitsOfAdicCompletion_inv_mul_mem_integralUnits {S : Finset (HeightOneSpectrum R)}
    {x : 𝔸ᶠ[R, K]ˣ} (hx : x ∈ sIntegralUnits R K S) :
    (∏ v ∈ S, unitsOfAdicCompletion K v (unitsProj K v x))⁻¹ * x ∈ integralUnits R K := by
  classical
  refine mem_integralUnits_iff.mpr fun w ↦ ?_
  rw [← coe_unitsProj_apply, map_mul, map_inv, unitsProj_prod_unitsOfAdicCompletion]
  split_ifs with hw
  · rw [inv_mul_cancel, Units.val_one, map_one]
  · rw [inv_one, one_mul, coe_unitsProj_apply]
    exact mem_sIntegralUnits_iff.mp hx w (Finset.mem_coe.not.mpr hw)

variable (R K) in
/-- **The `S`-integral finite ideles are generated by local unit groups and integral units**: for
a finite set `S` of places, `I^S = (∏_{v ∈ S} K_vˣ) · 𝒪̂ˣ` inside the finite ideles, where `K_vˣ`
is embedded by `unitsOfAdicCompletion K v` and `𝒪̂ˣ = integralUnits R K`. -/
theorem sIntegralUnits_eq_iSup_range_sup_integralUnits (S : Finset (HeightOneSpectrum R)) :
    sIntegralUnits R K S =
      (⨆ v ∈ S, (unitsOfAdicCompletion K v).range) ⊔ integralUnits R K := by
  refine le_antisymm (fun x hx ↦ ?_) (sup_le (iSup₂_le fun v hv ↦ ?_) ?_)
  · rw [← mul_inv_cancel_left (∏ v ∈ S, unitsOfAdicCompletion K v (unitsProj K v x)) x]
    refine Subgroup.mul_mem _ (Subgroup.mem_sup_left (Subgroup.prod_mem _ fun v hv ↦ ?_))
      (Subgroup.mem_sup_right (prod_unitsOfAdicCompletion_inv_mul_mem_integralUnits hx))
    exact Subgroup.mem_iSup_of_mem v (Subgroup.mem_iSup_of_mem hv ⟨unitsProj K v x, rfl⟩)
  · rintro _ ⟨u, rfl⟩
    exact unitsOfAdicCompletion_mem_sIntegralUnits (Finset.mem_coe.mpr hv) u
  · rw [← sIntegralUnits_empty]
    exact sIntegralUnits_mono R K (Set.empty_subset _)

variable (R K) in
/-- **The finite ideles are generated by the local unit groups and the integral units**: every
finite idele is a product of finitely many finite ideles concentrated at single places and an
everywhere-integral unit. -/
theorem iSup_range_unitsOfAdicCompletion_sup_integralUnits :
    (⨆ v, (unitsOfAdicCompletion K v).range) ⊔ integralUnits R K = ⊤ := by
  refine eq_top_iff.mpr fun x _ ↦ ?_
  obtain ⟨S, hS⟩ := exists_finset_mem_sIntegralUnits x
  rw [sIntegralUnits_eq_iSup_range_sup_integralUnits] at hS
  exact sup_le_sup_right (iSup₂_le fun v _ ↦ le_iSup (fun v ↦ (unitsOfAdicCompletion K v).range) v)
    _ hS

end IsDedekindDomain.FiniteAdeleRing
