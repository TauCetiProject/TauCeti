import TauCeti.RingTheory.Ideal.Norm.AbsNorm

/-!
# Ideals of finite index of the integral finite adeles

Let `R` be a Dedekind domain with fraction field `K`, `𝔸_f` its finite adeles and `Ô` the
integral ones. A finite idele `t` whose fractional ideal is an integral ideal `N` is integral, and
`tÔ` is the completion `NÔ` of `N`. If `R` has characteristic zero, an ideal `I` of finite index of
`Ô` contains its index, a nonzero integer, and is therefore the completion of the ideal of `R` it
cuts out. So every ideal of finite index of `Ô` is principal, generated by an integral adele that
is a unit of `𝔸_f`; in particular an integral adele generating an ideal of finite index is a unit
of `𝔸_f`.

The completion `N ↦ NÔ` keeps the index, since `R ⧸ N ≃ Ô ⧸ NÔ`. In characteristic zero it is
therefore a bijection from the ideals of finite index of `R` onto those of `Ô` that keeps the
index, and the ideal zeta sums `ζ_Ô(s) = ∑_I [Ô : I]^(-s)` and `ζ_R(s)` agree.

## Main declarations

* `IsDedekindDomain.FiniteAdeleRing.completedIdeal_eq_span_singleton`: `NÔ = tÔ` for a finite
  idele `t` with fractional ideal `N`.
* `IsDedekindDomain.FiniteAdeleRing.exists_eq_completedIdeal_of_cardQuot_ne_zero`: an ideal of
  finite index of `Ô` is a completed ideal.
* `IsDedekindDomain.FiniteAdeleRing.exists_eq_span_singleton_of_cardQuot_ne_zero`,
  `IsDedekindDomain.FiniteAdeleRing.isPrincipal_of_cardQuot_ne_zero`: an ideal of finite index
  of `Ô` is generated by an integral adele that is a unit of `𝔸_f`.
* `IsDedekindDomain.FiniteAdeleRing.isUnit_coe_of_cardQuot_span_singleton_ne_zero`: an integral
  adele generating an ideal of finite index of `Ô` is a unit of `𝔸_f`.
* `IsDedekindDomain.FiniteAdeleRing.cardQuot_completedIdeal`: `[Ô : NÔ] = [R : N]` for `N ≠ ⊥`.
* `IsDedekindDomain.FiniteAdeleRing.submoduleZeta_integralAdeles`: `ζ_Ô(s) = ζ_R(s)` in
  characteristic zero.

## Attribution

The principality of the ideals of finite index of `Ô` is
`New.Filling.isPrincipal_of_cardQuot_ne_zero` in the file
`src/New/Spanning/RemainingTerms/Discriminants.lean` of grh-lean
(https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic, PBC). There it comes
from a Bezout property of `Ô`; here it comes from the fractional ideal of a finite idele.
-/
public section
noncomputable section

open IsDedekindDomain HeightOneSpectrum
open scoped nonZeroDivisors

namespace IsDedekindDomain.FiniteAdeleRing

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

/-- A finite idele whose fractional ideal is a nonzero integral ideal `N` is integral. -/
theorem coe_mem_integralAdeles_of_toFractionalIdeal_eq {N : Ideal R} (hN : N ≠ ⊥)
    {t : 𝔸ᶠ[R, K]ˣ}
    (ht : toFractionalIdeal t = FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩) :
    (t : 𝔸ᶠ[R, K]) ∈ integralAdeles R K := by
  rw [← toFractionalIdeal_le_one_iff, ht, FractionalIdeal.coe_mk0]
  exact FractionalIdeal.coeIdeal_le_one

/-- Let `t` be a finite idele whose fractional ideal is a nonzero integral ideal `N`. Then the
completion `NÔ` of `N` is the principal ideal of `Ô` generated by `t`. -/
theorem completedIdeal_eq_span_singleton {N : Ideal R} (hN : N ≠ ⊥) {t : 𝔸ᶠ[R, K]ˣ}
    (ht : toFractionalIdeal t = FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩) :
    completedIdeal K N =
      Ideal.span {⟨t, coe_mem_integralAdeles_of_toFractionalIdeal_eq hN ht⟩} := by
  ext x
  rw [← coe_mem_finiteAdelicIdeal_iff_mem_completedIdeal hN, mem_finiteAdelicIdeal_iff t ht,
    Ideal.mem_span_singleton']
  refine ⟨fun hx ↦ ⟨⟨_, hx⟩, Subtype.ext ?_⟩, ?_⟩
  · rw [MulMemClass.coe_mul, mul_right_comm, Units.inv_mul, one_mul]
  · rintro ⟨c, rfl⟩
    rw [MulMemClass.coe_mul, mul_left_comm, Units.inv_mul, mul_one]
    exact c.property

/-- In characteristic zero, an ideal `I` of finite index of the integral finite adeles `Ô` is the
completion `NÔ` of the nonzero ideal `N` of `R` that it cuts out. -/
theorem exists_eq_completedIdeal_of_cardQuot_ne_zero [CharZero R]
    {I : Ideal (integralAdeles R K)} (hI : I.cardQuot ≠ 0) :
    ∃ N : Ideal R, N ≠ ⊥ ∧ I = completedIdeal K N := by
  -- `I` contains its index, a nonzero integer, and `R` is dense in `Ô`.
  set N := I.comap (algebraMap R (integralAdeles R K))
  have h_index : algebraMap R (integralAdeles R K) (I.cardQuot : R) ∈ I := by
    rw [map_natCast]
    exact Submodule.natCast_cardQuot_mem I
  have hN : N ≠ ⊥ := fun h ↦ by
    have h_mem : ((I.cardQuot : ℕ) : R) ∈ N := h_index
    rw [h, Ideal.mem_bot, Nat.cast_eq_zero] at h_mem
    exact hI h_mem
  have h_le : completedIdeal K N ≤ I := by
    rw [completedIdeal_def]
    exact Ideal.map_le_iff_le_comap.2 le_rfl
  refine ⟨N, hN, le_antisymm (fun x hx ↦ ?_) h_le⟩
  obtain ⟨r, hr⟩ := exists_sub_mem_completedIdeal hN x
  have hrN : r ∈ N := by simpa [N] using (I.sub_mem hx (h_le hr))
  simpa using (completedIdeal K N).add_mem hr (algebraMap_mem_completedIdeal hrN)

/-- In characteristic zero, an ideal of finite index of the integral finite adeles `Ô` is
generated by an integral adele that is a unit of the finite adeles. -/
theorem exists_eq_span_singleton_of_cardQuot_ne_zero [CharZero R]
    {I : Ideal (integralAdeles R K)} (hI : I.cardQuot ≠ 0) :
    ∃ g : integralAdeles R K, IsUnit (g : 𝔸ᶠ[R, K]) ∧ I = Ideal.span {g} := by
  obtain ⟨N, hN, rfl⟩ := exists_eq_completedIdeal_of_cardQuot_ne_zero hI
  obtain ⟨t, ht⟩ := toFractionalIdeal_surjective (R := R) (K := K)
    (FractionalIdeal.mk0 K ⟨N, mem_nonZeroDivisors_of_ne_zero hN⟩)
  exact ⟨_, t.isUnit, completedIdeal_eq_span_singleton hN ht⟩

/-- In characteristic zero, every ideal of finite index of the integral finite adeles is
principal. -/
theorem isPrincipal_of_cardQuot_ne_zero [CharZero R] {I : Ideal (integralAdeles R K)}
    (hI : I.cardQuot ≠ 0) : I.IsPrincipal := by
  obtain ⟨g, -, rfl⟩ := exists_eq_span_singleton_of_cardQuot_ne_zero hI
  exact ⟨g, rfl⟩

/-- In characteristic zero, an integral finite adele `g` that generates an ideal of finite index
of the integral finite adeles is a unit of the finite adeles. -/
theorem isUnit_coe_of_cardQuot_span_singleton_ne_zero [CharZero R] {g : integralAdeles R K}
    (hg : (Ideal.span {g}).cardQuot ≠ 0) : IsUnit (g : 𝔸ᶠ[R, K]) := by
  obtain ⟨g', hg', h_eq⟩ := exists_eq_span_singleton_of_cardQuot_ne_zero hg
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.1 (h_eq ▸ Ideal.mem_span_singleton_self g')
  refine isUnit_of_mul_isUnit_right (x := (d : 𝔸ᶠ[R, K])) ?_
  rw [← MulMemClass.coe_mul, hd]
  exact hg'

variable (K) in
/-- For `N ≠ ⊥`, the completion `NÔ` has the same index in `Ô` as `N` has in `R`. -/
@[simp]
theorem cardQuot_completedIdeal {N : Ideal R} (hN : N ≠ ⊥) :
    (completedIdeal K N).cardQuot = N.cardQuot := by
  rw [Submodule.cardQuot_apply, Submodule.cardQuot_apply,
    Nat.card_congr (quotientEquivQuotientCompletedIdeal K hN).toEquiv]

variable (R K) in
/-- **The ideal zeta sums of `Ô` and of `R` agree.** In characteristic zero, the completion
`N ↦ NÔ` is a bijection from the ideals of finite index of `R` onto those of the integral finite
adeles `Ô` that keeps the index, so `∑_I [Ô : I]^(-s) = ∑_N [R : N]^(-s)` for every `s`. -/
@[simp]
theorem submoduleZeta_integralAdeles [CharZero R] (s : ℕ) :
    Module.submoduleZeta (integralAdeles R K) (integralAdeles R K) s =
      Module.submoduleZeta R R s := by
  -- `R` is infinite, so an ideal of finite index of `R` is nonzero.
  have h_ne_bot {N : Ideal R} (hN : N.cardQuot ≠ 0) : N ≠ ⊥ := by
    rintro rfl
    exact hN (Submodule.cardQuot_bot R R)
  let e (N : {N : Ideal R // N.cardQuot ≠ 0}) :
      {I : Ideal (integralAdeles R K) // I.cardQuot ≠ 0} :=
    ⟨completedIdeal K N.val, (cardQuot_completedIdeal K (h_ne_bot N.property)).trans_ne N.property⟩
  have he : Function.Bijective e := by
    refine ⟨fun ⟨N₁, h₁⟩ ⟨N₂, h₂⟩ h ↦ Subtype.ext ?_, fun ⟨I, hI⟩ ↦ ?_⟩
    · have h_eq := congrArg (fun I ↦ Ideal.comap (algebraMap R (integralAdeles R K)) I.val) h
      simpa only [e, comap_completedIdeal K (h_ne_bot h₁), comap_completedIdeal K (h_ne_bot h₂)]
        using h_eq
    · obtain ⟨N, hN, rfl⟩ := exists_eq_completedIdeal_of_cardQuot_ne_zero hI
      exact ⟨⟨N, (cardQuot_completedIdeal K hN).symm.trans_ne hI⟩, rfl⟩
  rw [Module.submoduleZeta_def, Module.submoduleZeta_def, ← (Equiv.ofBijective e he).tsum_eq]
  exact tsum_congr fun N ↦ by
    rw [Equiv.ofBijective_apply, cardQuot_completedIdeal K (h_ne_bot N.property)]

end IsDedekindDomain.FiniteAdeleRing
