module

public import TauCeti.RingTheory.DedekindDomain.FiniteAdeleRing.CongruenceLevel
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Map

/-!
# Principal congruence levels form a basis of neighbourhoods of `1` in `GL_n(𝔸_f)`

For a Dedekind domain `R` with fraction field `K`, write `Ô` for the integral finite adeles and
`NÔ` for the completion `IsDedekindDomain.FiniteAdeleRing.completedIdeal K N` of an integral
ideal `N`. The principal congruence level of `N` in `GL_n(𝔸_f)` is the image under the open
embedding `IsDedekindDomain.FiniteAdeleRing.integralGL` of the kernel of reduction
`GL_n(Ô) → GL_n(Ô ⧸ NÔ)`, that is, `{g ∈ GL_n(Ô) : g ≡ 1 mod NÔ}`.

This file shows that these levels, for `N ≠ ⊥`, form a basis of neighbourhoods of `1` in
`GL_n(𝔸_f)`: the ideals `NÔ` form a basis of neighbourhoods of `0` in `Ô`
(`IsDedekindDomain.FiniteAdeleRing.hasBasis_nhds_zero_completedIdeal`), so their kernels of
reduction form one of `1` in `GL_n(Ô)`
(`TauCeti.GeneralLinear.hasBasis_nhds_one_ker_map_quotientMk`), and `GL_n(Ô)` is open in
`GL_n(𝔸_f)`. When the quotients of `R` by nonzero ideals are finite and
`R` has characteristic zero, for instance for the ring of integers of a number field, every nonzero
ideal `N` contains the integer `[R : N]`, so the levels of the ideals `M R` generated by positive
integers `M` already form such a basis: every neighbourhood of `1` in `GL_n(𝔸_f)` contains
`{g ∈ GL_n(Ô) : g ≡ 1 mod MÔ}` for some integer `M ≥ 1`. Intersecting with a subgroup of
`GL_n(𝔸_f)` carrying the subspace topology, such as a finite adelic unitary group, shows that every
neighbourhood of `1` in it contains the trace of such a level.

## Main declarations

* `IsDedekindDomain.FiniteAdeleRing.hasBasis_nhds_one_map_ker_integralGL`: the principal
  congruence levels of the nonzero ideals of `R` form a basis of neighbourhoods of `1` in
  `GL_n(𝔸_f)`.
* `IsDedekindDomain.FiniteAdeleRing.hasBasis_nhds_one_map_ker_integralGL_natCast`: over a ring of
  characteristic zero with finite quotients, the principal congruence levels of the positive
  integers already form such a basis.
* `IsDedekindDomain.FiniteAdeleRing.hasBasis_nhds_one_principalLevel`: the principal levels `K(N)`
  of `GL₂(𝔸_f)` form a basis of neighbourhoods of `1`.

## References

* V. Platonov, A. Rapinchuk, *Algebraic groups and number theory*, Pure and Applied Mathematics
  139, Academic Press (1994), §5.1.
* The statement for integer levels and the approach through the topology of `Ô` follow
  `New.exists_congruenceGL_subset` in `grh/src/Lib/Adelic/Unitary/CongruenceLevels.lean` of
  grh-lean (https://github.com/lsernau/grh-lean at commit
  `72fead102f663d5c7a407964a13dc0cf9d977207`, Apache 2.0, Copyright 2026 Anthropic, PBC); no
  code is adapted from it.
-/

public section

open Topology

namespace IsDedekindDomain.FiniteAdeleRing

open TauCeti

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K] (n : ℕ)

/-- **The principal congruence levels form a basis of neighbourhoods of `1` in `GL_n(𝔸_f)`.** As
`N` runs over the nonzero ideals of `R`, the images in `GL_n(𝔸_f)` of the kernels of reduction
`GL_n(Ô) → GL_n(Ô ⧸ NÔ)`, the groups `{g ∈ GL_n(Ô) : g ≡ 1 mod NÔ}`, form a basis of
neighbourhoods of the identity. -/
theorem hasBasis_nhds_one_map_ker_integralGL :
    (𝓝 (1 : GL (Fin n) 𝔸ᶠ[R, K])).HasBasis (fun N : Ideal R ↦ N ≠ ⊥) fun N ↦
      ((Matrix.GeneralLinearGroup.map (n := Fin n) (Ideal.Quotient.mk (completedIdeal K N))).ker.map
        (integralGL K n) : Set (GL (Fin n) 𝔸ᶠ[R, K])) := by
  have h := (GeneralLinear.hasBasis_nhds_one_ker_map_quotientMk n
    (hasBasis_nhds_zero_completedIdeal (R := R) K)).map (integralGL K n)
  rw [(isOpenEmbedding_integralGL K n).map_nhds_eq, map_one] at h
  simpa only [Subgroup.coe_map] using h

/-- **The principal congruence levels of the positive integers form a basis of neighbourhoods of
`1` in `GL_n(𝔸_f)`.** Over a ring `R` of characteristic zero whose quotients by nonzero ideals are
finite, for instance the ring of integers of a number field, the groups
`{g ∈ GL_n(Ô) : g ≡ 1 mod MÔ}` for integers `M ≥ 1` form a basis of neighbourhoods of the identity:
every neighbourhood of `1` contains one of them. -/
theorem hasBasis_nhds_one_map_ker_integralGL_natCast [CharZero R] [Ring.HasFiniteQuotients R] :
    (𝓝 (1 : GL (Fin n) 𝔸ᶠ[R, K])).HasBasis (fun M : ℕ ↦ M ≠ 0) fun M ↦
      ((Matrix.GeneralLinearGroup.map (n := Fin n)
        (Ideal.Quotient.mk (completedIdeal K (Ideal.span {(M : R)})))).ker.map
          (integralGL K n) : Set (GL (Fin n) 𝔸ᶠ[R, K])) := by
  refine (hasBasis_nhds_one_map_ker_integralGL K n).to_hasBasis (fun N hN ↦ ?_) fun M hM ↦ ?_
  · -- A nonzero ideal `N` contains its absolute norm `[R : N]`, a positive integer.
    refine ⟨Ideal.absNorm N, Ideal.absNorm_eq_zero_iff.not.mpr hN, Subgroup.map_mono ?_⟩
    exact Matrix.GeneralLinearGroup.ker_map_quotientMk_mono
      (completedIdeal_mono K ((Ideal.span_singleton_le_iff_mem N).mpr (Ideal.absNorm_mem N)))
  · exact ⟨Ideal.span {(M : R)}, by simpa using hM, le_rfl⟩

/-- **The principal levels `K(N)` form a basis of neighbourhoods of `1` in `GL₂(𝔸_f)`**, as `N`
runs over the nonzero ideals of `R`. -/
theorem hasBasis_nhds_one_principalLevel :
    (𝓝 (1 : GL (Fin 2) 𝔸ᶠ[R, K])).HasBasis (fun N : Ideal R ↦ N ≠ ⊥) fun N ↦
      (principalLevel K N : Set (GL (Fin 2) 𝔸ᶠ[R, K])) := by
  simpa only [principalLevel_eq_map_ker] using hasBasis_nhds_one_map_ker_integralGL (R := R) K 2

end IsDedekindDomain.FiniteAdeleRing
