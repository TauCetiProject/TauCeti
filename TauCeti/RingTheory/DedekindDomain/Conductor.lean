/-!
# Local monogenicity at primes with separable residue extension

Let `C` be a Dedekind domain, module-finite over a domain `A`, let `p ≠ 0` be a maximal ideal of
`A` and `Q` a maximal ideal of `C` over `p` whose residue extension `(C ⧸ Q) / (A ⧸ p)` is
separable. Then `C` is generated by a single element locally at `Q`: there is `x : C` whose
conductor `{a ∈ C | a C ⊆ A[x]}` is not contained in `Q` (`TauCeti.exists_not_conductor_le`).
Consequently, the localization of `C` at `Q` is the localization of `A[x]` at `Q ∩ A[x]`
(`TauCeti.isLocalization_adjoin_of_not_conductor_le`). Such an `x` computes local invariants of
`C / A` at `Q` from the single polynomial equation of `x`; for example, the different ideal of
`C / A` is generated at `Q` by `f'(x)`, where `f` is the minimal polynomial of `x`.

The element `x` is produced by Serre's argument. A lift `a` of a primitive element of the residue
extension is modified by a Newton step so that the lift `g` of its residual minimal polynomial
takes a value of `Q`-adic order exactly one, and the Chinese remainder theorem moves `x` away from
the other primes above `p` without changing it modulo `Q ^ 2`. Then `Q = (g(x)) + p C`, and
Nakayama's lemma over `A[x]` at `Q ∩ A[x]` gives an element of the conductor outside `Q`. No
completion is needed, and the extension `C / A` may have several primes above `p`.

## Main results

* `TauCeti.exists_sub_mem_and_aeval_notMem_pow_two`: the Newton step in a Dedekind domain.
* `TauCeti.span_singleton_sup_map_eq`: `Q = (y) + p C` when `y` has order one at `Q` and avoids
  the other primes above `p`.
* `TauCeti.not_conductor_le_of_le_map`: Nakayama's criterion for the conductor of `A[x]`.
* `TauCeti.exists_not_conductor_le`: **local monogenicity** at a prime with separable residue
  extension.
* `TauCeti.isLocalization_adjoin_of_not_conductor_le`: the localization of `C` at `Q` is a
  localization of `A[x]`.
* `TauCeti.algebra_adjoin_eq_top_of_conductor_ne_bot`: an element with nonzero conductor generates
  the fraction field.

## References

* [J.-P. Serre, *Corps locaux*][serre1968], Chapter III, §6, Proposition 12.
-/

public section

open Polynomial UniqueFactorizationMonoid

namespace TauCeti

variable {A C : Type*} [CommRing A] [CommRing C] [Algebra A C]

/-- **Newton step in a Dedekind domain.** If `a` is a simple root of `g` modulo a nonzero prime
`Q`, then `g` takes a value of `Q`-adic order exactly one at some `b ≡ a` modulo `Q`: either `a`
itself works, or `a + π` does for any `π` of order one. This is the counterpart, at a prime of a
Dedekind domain, of the local-ring Newton step
`TauCeti.IsLocalRing.exists_span_eval_eq_maximalIdeal`. -/
theorem exists_sub_mem_and_aeval_notMem_pow_two [IsDedekindDomain C] {Q : Ideal C} [Q.IsPrime]
    (hQ : Q ≠ ⊥) {g : A[X]} {a : C} (ha : aeval a g ∈ Q) (ha' : aeval a (derivative g) ∉ Q) :
    ∃ b : C, b - a ∈ Q ∧ aeval b g ∈ Q ∧ aeval b g ∉ Q ^ 2 := by
  by_cases h : aeval a g ∈ Q ^ 2
  swap
  · exact ⟨a, by simp, ha, h⟩
  obtain ⟨π, hπ, hπ2⟩ := Ideal.exists_mem_pow_notMem_pow_succ Q hQ (Ideal.IsPrime.ne_top ‹_›) 1
  rw [pow_one] at hπ
  -- Taylor expansion: `g (a + π) = g a + g' a * π + k * π ^ 2`.
  obtain ⟨k, hk⟩ := binomExpansion (g.map (algebraMap A C)) a π
  simp only [eval_map_algebraMap, derivative_map] at hk
  have hk2 : k * π ^ 2 ∈ Q ^ 2 := Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hπ 2)
  refine ⟨a + π, by simpa using hπ, ?_, fun h' ↦ ?_⟩
  · rw [hk]
    exact Q.add_mem (Q.add_mem ha (Q.mul_mem_left _ hπ)) (Ideal.pow_le_self two_ne_zero hk2)
  · have e : aeval a (derivative g) * π = aeval (a + π) g - aeval a g - k * π ^ 2 := by
      rw [hk]; ring
    exact (Ideal.IsPrime.mul_mem_pow Q (e ▸ sub_mem (sub_mem h' h) hk2)).elim ha' hπ2

variable [IsDomain A] [Module.IsTorsionFree A C]

/-- In a Dedekind domain, an element `y` of order one at a prime `Q` above `p`, and outside every
other prime above `p`, generates `Q` together with `p`: `(y) + p C = Q`. -/
theorem span_singleton_sup_map_eq [IsDedekindDomain C] {p : Ideal A} (hp : p ≠ ⊥) {Q : Ideal C}
    [hQ : Q.IsPrime] {y : C} (hyQ : y ∈ Q) (hyQ2 : y ∉ Q ^ 2)
    (hpQ : p.map (algebraMap A C) ≤ Q)
    (hy : ∀ P : Ideal C, P.IsPrime → p.map (algebraMap A C) ≤ P → P ≠ Q → y ∉ P) :
    Ideal.span {y} ⊔ p.map (algebraMap A C) = Q := by
  classical
  have hy0 : Ideal.span {y} ≠ ⊥ := by
    rw [Ne, Ideal.span_singleton_eq_bot]
    rintro rfl
    exact hyQ2 (zero_mem _)
  have hpC : p.map (algebraMap A C) ≠ ⊥ :=
    (Ideal.map_eq_bot_iff_of_injective (FaithfulSMul.algebraMap_injective A C)).not.mpr hp
  have hQ0 : Q ≠ ⊥ := ne_bot_of_le_ne_bot hpC hpQ
  -- In a Dedekind domain the sup is the greatest common divisor, here `Q` with multiplicity one.
  suffices normalizedFactors (Ideal.span {y}) ∩ normalizedFactors (p.map (algebraMap A C)) = {Q} by
    rw [Ideal.sup_eq_prod_inf_factors hy0 hpC, this, Multiset.prod_singleton]
  ext P
  rw [Multiset.count_inter, Multiset.count_singleton]
  by_cases hPQ : P = Q
  · subst hPQ
    have h1 : Multiset.count P (normalizedFactors (Ideal.span {y})) = 1 :=
      count_normalizedFactors_eq (Ideal.prime_of_isPrime hQ0 hQ).irreducible (normalize_eq P)
        (by rwa [pow_one, Ideal.dvd_span_singleton]) (by rwa [Ideal.dvd_span_singleton])
    have h2 : 1 ≤ Multiset.count P (normalizedFactors (p.map (algebraMap A C))) :=
      Multiset.one_le_count_iff_mem.mpr ((Ideal.mem_normalizedFactors_iff hpC).mpr ⟨hQ, hpQ⟩)
    simp [h1, h2]
  simp only [hPQ, ↓reduceIte]
  by_cases hP : P ∈ normalizedFactors (p.map (algebraMap A C))
  · obtain ⟨hPp, hle⟩ := (Ideal.mem_normalizedFactors_iff hpC).mp hP
    have : Multiset.count P (normalizedFactors (Ideal.span {y})) = 0 :=
      Multiset.count_eq_zero.mpr fun h ↦ hy P hPp hle hPQ
        (((Ideal.mem_normalizedFactors_iff hy0).mp h).2 (Ideal.mem_span_singleton_self y))
    simp [this]
  · simp [Multiset.count_eq_zero.mpr hP]

omit [IsDomain A] [Module.IsTorsionFree A C] in
/-- **Nakayama's criterion for the conductor.** Let `C` be module-finite over `A`, and let `Q ≠ C`
be an ideal such that `A[x]` meets every residue class modulo `Q`, and `Q` is generated by elements
of `Q ∩ A[x]`. Then the conductor of `A[x]` in `C` is not contained in `Q`. -/
theorem not_conductor_le_of_le_map [Module.Finite A C] {x : C} {Q : Ideal C} (hQ : Q ≠ ⊤)
    (hres : ∀ y : C, ∃ d ∈ Algebra.adjoin A {x}, y - d ∈ Q)
    (hQq : Q ≤ (Q.comap (algebraMap (Algebra.adjoin A {x}) C)).map
      (algebraMap (Algebra.adjoin A {x}) C)) :
    ¬ conductor A x ≤ Q := by
  let D := Algebra.adjoin A {x}
  have : Module.Finite D C := Module.Finite.of_restrictScalars_finite A D C
  -- `C = D + q C` for `q = Q ∩ D`, so some `r ≡ 1` modulo `q` multiplies `C` into `D`.
  have hle : (⊤ : Submodule D C) ≤ LinearMap.range (Algebra.linearMap D C) ⊔
      Q.comap (algebraMap D C) • ⊤ := by
    rintro y -
    obtain ⟨d, hd, hyd⟩ := hres y
    rw [Ideal.smul_top_eq_map]
    exact Submodule.mem_sup.mpr ⟨d, ⟨⟨d, hd⟩, rfl⟩, y - d, hQq hyd, add_sub_cancel _ _⟩
  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup
    Module.Finite.fg_top le_rfl hle
  have hrc : (r : C) ∈ conductor A x := by
    refine mem_conductor_iff.mpr fun b ↦ ?_
    obtain ⟨d, hd⟩ := hr (Submodule.smul_mem_pointwise_smul b r ⊤ trivial)
    have hrb : (r : C) * b = d := by simpa [Algebra.smul_def] using hd.symm
    exact hrb ▸ d.2
  have hrQ : (r : C) - 1 ∈ Q := by simpa using hr1
  exact fun hcond ↦ hQ (Q.eq_top_iff_one.mpr (by simpa using Q.sub_mem (hcond hrc) hrQ))

section Residue

attribute [local instance] Ideal.Quotient.field

variable {p : Ideal A}

omit [IsDomain A] [Module.IsTorsionFree A C] in
/-- If the residue of `x` generates the residue extension at `Q`, then `A[x]` meets every residue
class of `C` modulo `Q`. -/
private theorem exists_mem_adjoin_sub_mem {Q : Ideal C} [Q.LiesOver p] {x : C}
    (hx : Algebra.adjoin (A ⧸ p) {Ideal.Quotient.mk Q x} = ⊤) (y : C) :
    ∃ d ∈ Algebra.adjoin A {x}, y - d ∈ Q := by
  have hy : Ideal.Quotient.mk Q y ∈ Algebra.adjoin (A ⧸ p) {Ideal.Quotient.mk Q x} :=
    hx ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hy
  obtain ⟨h, hh⟩ := hy
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at hh
  obtain ⟨h, rfl⟩ := Polynomial.map_surjective _ Ideal.Quotient.mk_surjective h
  refine ⟨aeval x h, Algebra.adjoin_singleton_eq_range_aeval A x ▸ ⟨h, rfl⟩, ?_⟩
  rw [← Ideal.Quotient.eq, ← hh,
    ← map_aeval_eq_aeval_map (RingHom.ext (Ideal.Quotient.algebraMap_mk_of_liesOver Q p))]

omit [IsDomain A] [Module.IsTorsionFree A C] in
/-- If `Q` lies over `p` and is generated by `p` together with `g(x)` for a polynomial `g` over
`A`, then `Q` is generated by `Q ∩ A[x]`. -/
private theorem le_map_comap_adjoin {Q : Ideal C} [Q.LiesOver p] {x : C} {g : A[X]}
    (hQ : Ideal.span {aeval x g} ⊔ p.map (algebraMap A C) = Q) :
    Q ≤ (Q.comap (algebraMap (Algebra.adjoin A {x}) C)).map
      (algebraMap (Algebra.adjoin A {x}) C) := by
  refine hQ.symm.le.trans (sup_le ?_ ?_)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    let xD : Algebra.adjoin A {x} := ⟨x, Algebra.self_mem_adjoin_singleton A x⟩
    have hxQ : aeval x g ∈ Q := hQ ▸ Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
    have : aeval xD g ∈ Q.comap (algebraMap _ C) := by simpa [xD, aeval_subalgebra_coe] using hxQ
    simpa [xD, aeval_subalgebra_coe] using Ideal.mem_map_of_mem (algebraMap _ C) this
  · rw [IsScalarTower.algebraMap_eq A (Algebra.adjoin A {x}) C, ← Ideal.map_map]
    refine Ideal.map_mono (Ideal.map_le_iff_le_comap.mpr ?_)
    rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq, ← Ideal.under_def,
      ← Ideal.LiesOver.over (P := Q) (p := p)]

/-- **Avoiding the other primes.** Given `β : C`, a polynomial `g`, and a constant `c` at which `g`
is a unit modulo `p`, some `x ≡ β` modulo `Q ^ 2` makes `g(x)` a unit at every other prime of `C`
above `p`. -/
private theorem exists_sub_mem_pow_two_and_aeval_notMem [IsDedekindDomain C] [p.IsMaximal]
    (hp : p ≠ ⊥) {Q : Ideal C} [Q.IsPrime] [Q.LiesOver p] (β : C) {g : A[X]} {c : A}
    (hc : aeval c g ∉ p) :
    ∃ x : C, x - β ∈ Q ^ 2 ∧
      ∀ P : Ideal C, P.IsPrime → p.map (algebraMap A C) ≤ P → P ≠ Q → aeval x g ∉ P := by
  classical
  have hpC : p.map (algebraMap A C) ≠ ⊥ :=
    (Ideal.map_eq_bot_iff_of_injective (FaithfulSMul.algebraMap_injective A C)).not.mpr hp
  set s := (normalizedFactors (p.map (algebraMap A C))).toFinset
  have hs {P : Ideal C} : P ∈ s ↔ P.IsPrime ∧ p.map (algebraMap A C) ≤ P := by
    rw [Multiset.mem_toFinset, Ideal.mem_normalizedFactors_iff hpC]
  -- The Chinese remainder theorem over the primes above `p`.
  obtain ⟨x, hx⟩ := IsDedekindDomain.exists_forall_sub_mem_ideal (s := s) id
    (fun P ↦ if P = Q then 2 else 1)
    (fun P hP ↦ Ideal.prime_of_isPrime (ne_bot_of_le_ne_bot hpC (hs.mp hP).2) (hs.mp hP).1)
    (fun _ _ _ _ h ↦ h) (fun P ↦ if (P : Ideal C) = Q then β else algebraMap A C c)
  have hpQ : p.map (algebraMap A C) ≤ Q := Ideal.map_le_iff_le_comap.mpr Ideal.LiesOver.over.le
  refine ⟨x, by simpa using hx Q (hs.mpr ⟨inferInstance, hpQ⟩), fun P hP hle hPQ hxP ↦ hc ?_⟩
  have hxc : x - algebraMap A C c ∈ P := by simpa [hPQ] using hx P (hs.mpr ⟨hP, hle⟩)
  have hcomap : P.comap (algebraMap A C) = p :=
    (‹p.IsMaximal›.eq_of_le (Ideal.comap_ne_top _ hP.ne_top)
      (Ideal.map_le_iff_le_comap.mp hle)).symm
  have := Ideal.mem_of_dvd _ (sub_dvd_eval_sub x (algebraMap A C c) (g.map (algebraMap A C))) hxc
  rw [eval_map_algebraMap, eval_map_algebraMap, aeval_algebraMap_apply] at this
  exact hcomap ▸ Ideal.mem_comap.mpr (by simpa using P.sub_mem hxP this)

omit [IsDomain A] [Module.IsTorsionFree A C] in
/-- The lift `g` of the minimal polynomial of a residue class `α` is a unit modulo `p` at `0` or at
`1`: the minimal polynomial has at most one root in `A ⧸ p`, namely `α` if it lies there. -/
private theorem exists_aeval_notMem [p.IsMaximal] {Q : Ideal C} [Q.IsMaximal] [Q.LiesOver p]
    [Algebra.IsIntegral (A ⧸ p) (C ⧸ Q)] (α : C ⧸ Q)
    {g : A[X]} (hg : g.map (Ideal.Quotient.mk p) = minpoly (A ⧸ p) α) :
    ∃ c : A, aeval c g ∉ p := by
  by_contra! h
  have hr (c : A) : algebraMap (A ⧸ p) (C ⧸ Q) (Ideal.Quotient.mk p c) = α := by
    refine minpoly.root (Algebra.IsIntegral.isIntegral α) ?_
    rw [IsRoot, ← hg, eval_map, eval₂_hom, Ideal.Quotient.eq_zero_iff_mem]
    simpa using h c
  simpa using (hr 0).trans (hr 1).symm

/-- **Local monogenicity.** Let `C` be a Dedekind domain, module-finite over `A`, and let `Q` be a
maximal ideal of `C` over a nonzero maximal ideal `p` of `A`, with separable residue extension.
Then some `x : C` generates `C` locally at `Q`: the conductor of `A[x]` is not contained in `Q`. -/
theorem exists_not_conductor_le [IsDedekindDomain C] [Module.Finite A C] [p.IsMaximal] (hp : p ≠ ⊥)
    (Q : Ideal C) [Q.IsMaximal] [Q.LiesOver p] [Algebra.IsSeparable (A ⧸ p) (C ⧸ Q)] :
    ∃ x : C, ¬ conductor A x ≤ Q := by
  have hQ0 : Q ≠ ⊥ := by
    rintro rfl
    exact hp ((Ideal.LiesOver.over (P := (⊥ : Ideal C)) (p := p)).trans
      (Ideal.comap_bot_of_injective _ (FaithfulSMul.algebraMap_injective A C)))
  have hsq : (algebraMap (A ⧸ p) (C ⧸ Q)).comp (Ideal.Quotient.mk p) =
      (Ideal.Quotient.mk Q).comp (algebraMap A C) :=
    RingHom.ext (Ideal.Quotient.algebraMap_mk_of_liesOver Q p)
  -- A lift `a` of a primitive element of the residue extension, and a lift `g` of its minimal
  -- polynomial, which has a simple root at `a` modulo `Q`.
  obtain ⟨α, hα⟩ := Field.exists_primitive_element (A ⧸ p) (C ⧸ Q)
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective α
  obtain ⟨g, hg⟩ := Polynomial.map_surjective _ Ideal.Quotient.mk_surjective
    (minpoly (A ⧸ p) (Ideal.Quotient.mk Q a))
  have ha : aeval a g ∈ Q := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_aeval_eq_aeval_map hsq, hg, minpoly.aeval]
  have ha' : aeval a (derivative g) ∉ Q := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_aeval_eq_aeval_map hsq, ← derivative_map, hg]
    exact (Algebra.IsSeparable.isSeparable _ _).aeval_derivative_ne_zero (minpoly.aeval _ _)
  -- Make `g(x)` of order one at `Q` and a unit at the other primes above `p`.
  obtain ⟨β, hβa, hβ, hβ2⟩ := exists_sub_mem_and_aeval_notMem_pow_two hQ0 ha ha'
  obtain ⟨c, hc⟩ := exists_aeval_notMem _ hg
  obtain ⟨x, hxβ, hother⟩ := exists_sub_mem_pow_two_and_aeval_notMem (Q := Q) hp β hc
  have hgx : aeval x g - aeval β g ∈ Q ^ 2 := by
    simpa only [aeval_def, eval₂_eq_eval_map] using
      Ideal.mem_of_dvd _ (sub_dvd_eval_sub x β (g.map (algebraMap A C))) hxβ
  have hJ : Ideal.span {aeval x g} ⊔ p.map (algebraMap A C) = Q :=
    span_singleton_sup_map_eq hp (by simpa using Q.add_mem (Ideal.pow_le_self two_ne_zero hgx) hβ)
      (fun h ↦ hβ2 (by simpa using (Q ^ 2).sub_mem h hgx))
      (Ideal.map_le_iff_le_comap.mpr (Ideal.LiesOver.over (P := Q) (p := p)).le) hother
  -- Now `A[x]` meets every residue class modulo `Q`, and `g(x)` and `p` lie in `Q ∩ A[x]`.
  refine ⟨x, not_conductor_le_of_le_map Ideal.IsPrime.ne_top'
    (exists_mem_adjoin_sub_mem (p := p) ?_) ?_⟩
  · rw [show Ideal.Quotient.mk Q x = Ideal.Quotient.mk Q a from Ideal.Quotient.eq.mpr
      (by simpa using Q.add_mem (Ideal.pow_le_self two_ne_zero hxβ) hβa)]
    exact Algebra.adjoin_eq_top_of_primitive_element
      (Algebra.IsIntegral.isIntegral _).isAlgebraic hα
  exact le_map_comap_adjoin hJ

end Residue

omit [IsDomain A] [Module.IsTorsionFree A C] in
/-- If the conductor of `A[x]` is not contained in the prime `Q`, then the localization of `C` at
`Q` is also the localization of `A[x]` at `Q ∩ A[x]`, with the algebra structure through `C`. This
is the `IsLocalization` form of Mathlib's `Localization.localRingHom_bijective_of_not_conductor_le`,
as needed to transport base-change statements from `A[x]` to `C`. -/
theorem isLocalization_adjoin_of_not_conductor_le [IsDomain C] {x : C} (Q : Ideal C) [Q.IsPrime]
    (hx : ¬ conductor A x ≤ Q) :
    IsLocalization (Q.comap (algebraMap (Algebra.adjoin A {x}) C)).primeCompl
      (Localization.AtPrime Q) := by
  obtain ⟨r, hr, hrQ⟩ := IsConcreteLE.not_le_iff_exists.mp hx
  have hinj : Function.Injective (algebraMap C (Localization.AtPrime Q)) :=
    IsLocalization.injective _ Q.primeCompl_le_nonZeroDivisors
  have hD (d : Algebra.adjoin A {x}) : algebraMap _ (Localization.AtPrime Q) d =
      algebraMap C (Localization.AtPrime Q) d :=
    IsScalarTower.algebraMap_apply _ C _ d
  refine ⟨fun s ↦ ?_, fun z ↦ ?_, fun {a b} h ↦ ⟨1, ?_⟩⟩
  · rw [hD]
    exact IsLocalization.map_units _ (⟨_, s.2⟩ : Q.primeCompl)
  · -- A fraction `c / t` of `C` is the fraction `r c / r t` of `A[x]`.
    obtain ⟨⟨c, t⟩, hct⟩ := IsLocalization.surj Q.primeCompl z
    refine ⟨⟨⟨r * c, mem_conductor_iff.mp hr c⟩,
      ⟨⟨r * t, mem_conductor_iff.mp hr t⟩, ?_⟩⟩, ?_⟩
    · exact fun h ↦ (Ideal.IsPrime.mem_or_mem ‹_› h).elim hrQ t.2
    · simp only [hD, map_mul] at hct ⊢
      rw [← hct]
      ring
  · rw [hD, hD] at h
    simpa using hinj h

omit [IsDomain A] [Module.IsTorsionFree A C] in
/-- If the conductor of `A[x]` in `C` is nonzero, then `x` generates the fraction field `L` of `C`
over the fraction field `K` of `A`. -/
theorem algebra_adjoin_eq_top_of_conductor_ne_bot (K L : Type*) [Field K] [Field L] [Algebra A K]
    [Algebra C L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A C L]
    [IsFractionRing C L] [Algebra.IsAlgebraic K L] {x : C} (hx : conductor A x ≠ ⊥) :
    Algebra.adjoin K {algebraMap C L x} = ⊤ := by
  obtain ⟨r, hr, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hx
  replace hr0 : algebraMap C L r ≠ 0 := by
    rwa [ne_eq, map_eq_zero_iff _ (IsFractionRing.injective C L)]
  -- `r` multiplies `C` into `A[x]`, so every fraction of `C` is a fraction of `A[x]`.
  have hmem (b : C) : algebraMap C L (r * b) ∈ IntermediateField.adjoin K {algebraMap C L x} := by
    have h : algebraMap C L (r * b) ∈ (Algebra.adjoin A {x}).map (IsScalarTower.toAlgHom A C L) :=
      Subalgebra.mem_map.mpr ⟨_, mem_conductor_iff.mp hr b, rfl⟩
    rw [AlgHom.map_adjoin_singleton] at h
    exact Algebra.adjoin_le
      (S := (IntermediateField.adjoin K {algebraMap C L x}).toSubalgebra.restrictScalars A)
      (by simp) h
  rw [← IntermediateField.adjoin_eq_top_iff_of_isAlgebraic
    (fun y _ ↦ Algebra.IsAlgebraic.isAlgebraic y), eq_top_iff]
  rintro l -
  obtain ⟨c, s, -, rfl⟩ := IsFractionRing.div_surjective C l
  rw [← mul_div_mul_left _ _ hr0, ← map_mul, ← map_mul]
  exact div_mem (hmem c) (hmem s)

end TauCeti
