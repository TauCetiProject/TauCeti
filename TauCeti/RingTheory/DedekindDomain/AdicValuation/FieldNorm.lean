module

public import Mathlib.RingTheory.DedekindDomain.AdicValuation
public import Mathlib.RingTheory.Ideal.Norm.RelNorm
import TauCeti.RingTheory.Ideal.Norm.RelNorm

/-!
# The adic valuation of a field norm

Let `R` be a Dedekind domain with fraction field `K`, let `L` be a finite extension of `K`, and let
`B` be the integral closure of `R` in `L`, a finite `R`-module. For a height-one prime `v` of `R`
and a nonzero `z ∈ L`, the `v`-adic valuation of the norm `N_{L/K}(z)` is the product, over the
height-one primes `w` of `B` above `v`, of the `w`-adic valuations of `z` raised to the inertia
degrees `f(w ∣ v)`:

`v(N_{L/K} z) = ∏_{w ∣ v} w(z) ^ f(w ∣ v)`.

In additive notation this is `ord_v(N z) = Σ_{w ∣ v} f(w ∣ v) · ord_w(z)`. It is the identity that
reads parity information about the valuations of `z` off the valuation of its norm, as in the
`2`-descent on an elliptic curve. The proof applies the coefficient formula for relative norms of
ideals, `TauCeti.multiplicity_relNorm`, to the principal ideal of an integral element, whose
relative norm is generated by its norm (`Ideal.relNorm_singleton`), and passes to quotients.

## Main results

* `IsDedekindDomain.HeightOneSpectrum.valuation_norm`: `v(N_{L/K} z) = ∏_{w ∣ v} w(z) ^ f(w ∣ v)`.

## Provenance

The local case, for the integral closure of the valuation ring of a complete discretely valued
field in a finite separable extension, where there is a single prime above `v`, is
`IsDedekindDomain.HeightOneSpectrum.valued_norm_eq_pow_inertiaDeg` in Michael Stoll's
`EllipticCurves` project (`github.com/MichaelStollBayreuth/EllipticCurves`, Apache-2.0, revision
`3bfe124`, `EllipticCurves/Mathlib/FormalGroup.lean`), proved there the same way through
`Ideal.relNorm`.

## References

* [J. Neukirch, *Algebraic number theory*][Neukirch1992], Chapter III, §1.
-/

public section

open Ideal WithZero

namespace IsDedekindDomain.HeightOneSpectrum

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K] [PerfectField K]
  {L : Type*} [Field L] [Algebra K L] [FiniteDimensional K L]
  {B : Type*} [CommRing B] [IsDedekindDomain B] [Algebra R B] [Module.Finite R B]
  [Module.IsTorsionFree R B] [Algebra R L] [IsScalarTower R K L] [Algebra B L]
  [IsScalarTower R B L] [IsIntegralClosure B R L] [IsFractionRing B L]

variable (v : HeightOneSpectrum R)
  [Fintype {w : HeightOneSpectrum B // w.asIdeal.LiesOver v.asIdeal}]

/-- The formula for integral elements: the valuation of the norm of a nonzero `r ∈ B` is the
weighted product of the valuations of `r` at the primes above `v`. -/
private lemma valuation_norm_algebraMap {r : B} (hr : r ≠ 0) :
    v.valuation K (Algebra.norm K (algebraMap B L r)) =
      ∏ w : {w : HeightOneSpectrum B // w.asIdeal.LiesOver v.asIdeal},
        w.1.valuation L (algebraMap B L r) ^ w.1.asIdeal.inertiaDeg R := by
  have hPerf : PerfectField (FractionRing R) :=
    PerfectField.of_ringEquiv (FractionRing.algEquiv R K).symm.toRingEquiv
  have hN : Algebra.intNorm R B r ≠ 0 := by
    intro h
    have h' := Algebra.algebraMap_intNorm (A := R) (K := K) (L := L) r
    rw [h, map_zero, eq_comm, Algebra.norm_eq_zero_iff, map_eq_zero_iff _
      (IsFractionRing.injective B L)] at h'
    exact hr h'
  have hspan : Ideal.span {r} ≠ ⊥ := by simpa using hr
  rw [← Algebra.algebraMap_intNorm (A := R) (K := K), valuation_of_algebraMap,
    intValuation_eq_exp_neg_multiplicity v hN, ← Ideal.relNorm_singleton,
    TauCeti.multiplicity_relNorm B v.asIdeal v.ne_bot hspan]
  have hexp (s : Finset {w : HeightOneSpectrum B // w.asIdeal.LiesOver v.asIdeal})
      (g : {w : HeightOneSpectrum B // w.asIdeal.LiesOver v.asIdeal} → ℤ) :
      ∏ i ∈ s, exp (g i) = exp (∑ i ∈ s, g i) := by
    simp only [exp_eq_coe_ofAdd, ofAdd_sum]
    exact (map_prod (WithZero.coeMonoidHom (α := Multiplicative ℤ)) _ _).symm
  simp_rw [valuation_of_algebraMap, intValuation_eq_exp_neg_multiplicity _ hr, ← exp_nsmul, hexp]
  congr 1
  push_cast
  rw [← Finset.sum_neg_distrib, Finset.sum_subtype _ fun _ ↦ Set.mem_toFinset]
  -- the height-one primes of `B` above `v` are the prime ideals of `B` lying over `v`
  refine Fintype.sum_equiv
    { toFun := fun P ↦
        have := P.2.2
        ⟨⟨P.1, P.2.1, ne_bot_of_liesOver_of_ne_bot v.ne_bot P.1⟩, P.2.2⟩
      invFun := fun w ↦ ⟨w.1.asIdeal, w.1.isPrime, w.2⟩
      left_inv := fun _ ↦ rfl
      right_inv := fun _ ↦ rfl } _ _ fun P ↦ ?_
  simp

/-- **The adic valuation of a field norm.** For a height-one prime `v` of `R` and `z ∈ L`, the
`v`-adic valuation of `N_{L/K}(z)` is the product over the height-one primes `w` of `B` above `v`
of `w(z) ^ f(w ∣ v)`. -/
theorem valuation_norm (z : L) :
    v.valuation K (Algebra.norm K z) =
      ∏ w : {w : HeightOneSpectrum B // w.asIdeal.LiesOver v.asIdeal},
        w.1.valuation L z ^ w.1.asIdeal.inertiaDeg R := by
  rcases eq_or_ne z 0 with rfl | hz
  · -- Some prime lies above `v`, and its inertia degree is positive.
    obtain ⟨P, hP, hPv⟩ := (inferInstance : Nonempty (v.asIdeal.primesOver B))
    rw [Algebra.norm_zero, map_zero, eq_comm]
    refine Finset.prod_eq_zero
      (Finset.mem_univ ⟨⟨P, hP, ne_bot_of_liesOver_of_ne_bot v.ne_bot P⟩, hPv⟩) ?_
    rw [map_zero]
    exact zero_pow (inertiaDeg_pos P R).ne'
  obtain ⟨r, s, hs, rfl⟩ := IsFractionRing.div_surjective (A := B) z
  have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
  have hr0 : r ≠ 0 := by
    rintro rfl
    simp at hz
  rw [div_eq_mul_inv, map_mul, Algebra.norm_inv, map_mul, map_inv₀,
    valuation_norm_algebraMap v hr0, valuation_norm_algebraMap v hs0, ← Finset.prod_inv_distrib,
    ← Finset.prod_mul_distrib]
  simp_rw [map_mul, map_inv₀, mul_pow, inv_pow]

end IsDedekindDomain.HeightOneSpectrum

end
