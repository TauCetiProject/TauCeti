/-!
# Trace duals and the different ideal across a semilocal decomposition

Let `R` be a Dedekind domain with fraction field `K`, let `L / K` be a finite separable extension,
and let `S` be an integral closure of `R` in `L`. Suppose `R'` is a Dedekind `R`-algebra with
fraction field `K'` over `K`, and `(S' i, L' i)` is a finite family of completed or localized
Dedekind extensions equipped with semilocal algebra isomorphisms

`eField : K' ⊗[K] L ≃ₐ[K'] ∀ i, L' i` and `eInt : R' ⊗[R] S ≃ₐ[R'] ∀ i, S' i`

compatible with ring homomorphisms `fField i : L →+* L' i` and `fInt i : S →+* S' i`.

This file extracts the abstract Dedekind-domain comparison shared by number-field completions
(`TauCeti/NumberTheory/NumberField/LocalGlobal/Different/Basic.lean`) and function-field place
completions (`TauCeti/FieldTheory/FunctionField/Different/Completion.lean`):

1. `K`-linear trace-dual expansions on `L` pass through `K' ⊗[K] L` to every factor `L' i`
   (`TauCeti.sum_trace_mul_smul_of_semilocal`).
2. Every element of the global trace dual `Sᵛ` maps into the local trace dual `(S' i)ᵛ`, and once a
   single local extension `(S₀, L₀)` enjoys these two properties its trace dual is spanned over
   `S₀` by the image of `Sᵛ` (`TauCeti.span_traceDual_one_eq_traceDual_one_of_forall`), its
   fractional-ideal dual is the extension of `Sᵛ`
   (`TauCeti.extended_dual_one_eq_dual_one_of_span_eq`), and its different ideal is generated by
   `differentIdeal R S` (`TauCeti.map_differentIdeal_eq_differentIdeal_of_extended_eq`).
3. Extending `differentIdeal R S` to `R' ⊗[R] S` and transporting along `eInt` gives the product
   ideal `Ideal.pi fun i ↦ differentIdeal R' (S' i)` (`TauCeti.map_differentIdeal_semilocal`).
-/

public section

open IsDedekindDomain Module
open scoped TensorProduct nonZeroDivisors

namespace TauCeti

section SingleLocal

variable {R K S L R' K' S₀ L₀ : Type*}
  [CommRing R] [Field K] [CommRing S] [Field L]
  [CommRing R'] [Field K'] [CommRing S₀] [Field L₀]
  [Algebra R K] [Algebra K L] [Algebra R S] [Algebra S L] [Algebra R L]
  [IsScalarTower R K L] [IsScalarTower R S L]
  [Algebra R' K'] [Algebra K' L₀] [Algebra R' S₀] [Algebra S₀ L₀] [Algebra R' L₀]
  [IsScalarTower R' K' L₀] [IsScalarTower R' S₀ L₀]

/-- **Local trace duals from global trace-dual families.** If elements of the global trace dual of
`S / R` map into the local trace dual of `S₀ / R'` and finite `K`-linear trace-dual expansions on
`L` persist in `L₀`, then the trace dual of `S₀ / R'` is spanned over `S₀` by the image of the
trace dual of `S / R`. -/
theorem span_traceDual_one_eq_traceDual_one_of_forall
    [IsDedekindDomain R] [IsFractionRing R K]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [IsIntegralClosure S R L] [Module.Finite R S] [Module.IsTorsionFree R S]
    (fField₀ : L →+* L₀) (fInt₀ : S →+* S₀)
    (hfCompat₀ : ∀ x : S, algebraMap S₀ L₀ (fInt₀ x) = fField₀ (algebraMap S L x))
    (hMem : ∀ ⦃d : L⦄, d ∈ Submodule.traceDual R K (1 : Submodule S L) →
      fField₀ d ∈ Submodule.traceDual R' K' (1 : Submodule S₀ L₀))
    (hExp : ∀ {n : ℕ} (b y : Fin n → L),
      (∀ x : L, ∑ j, Algebra.trace K L (x * b j) • y j = x) →
      ∀ z : L₀, ∑ j, Algebra.trace K' L₀ (z * fField₀ (b j)) • fField₀ (y j) = z) :
    Submodule.span S₀ (fField₀ '' Submodule.traceDual R K (1 : Submodule S L)) =
      Submodule.traceDual R' K' (1 : Submodule S₀ L₀) := by
  refine le_antisymm (Submodule.span_le.mpr ?_) fun z hz ↦ ?_
  · rintro _ ⟨d, hd, rfl⟩
    exact hMem hd
  -- `S` is torsion-free and finite over the Dedekind domain `R`, hence projective, so it admits a
  -- finite trace-dual family `(b, y)`.
  have := Module.finitePresentation_of_finite R S
  have : Module.Projective R S := Module.Flat.projective_of_finitePresentation
  obtain ⟨n, b, y, hy, hb⟩ := exists_sum_trace_mul_smul_eq R K (L := L) (B := S)
  rw [← hExp (fun j ↦ algebraMap S L (b j)) y hb z]
  refine Submodule.sum_mem _ fun j _ ↦ ?_
  obtain ⟨c, hc⟩ := Submodule.mem_traceDual.mp hz _
    (Submodule.mem_one.mpr ⟨fInt₀ (b j), hfCompat₀ (b j)⟩)
  rw [Algebra.traceForm_apply] at hc
  have hsmul : Algebra.trace K' L₀ (z * fField₀ (algebraMap S L (b j))) • fField₀ (y j) =
      algebraMap R' S₀ c • fField₀ (y j) := by
    rw [← hc, Algebra.smul_def, Algebra.smul_def, ← IsScalarTower.algebraMap_apply R' K' L₀,
      IsScalarTower.algebraMap_apply R' S₀ L₀]
  rw [hsmul]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨y j, hy j, rfl⟩)

/-- If the `S₀`-span of the image of the submodule trace dual equals the local submodule trace
dual, extending the fractional-ideal trace dual along `fInt₀` yields the local fractional-ideal
trace dual. -/
theorem extended_dual_one_eq_dual_one_of_span_eq
    [IsDomain R] [IsIntegrallyClosed R] [IsFractionRing R K]
    [IsDedekindDomain S] [IsFractionRing S L] [IsIntegralClosure S R L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [IsDomain R'] [IsIntegrallyClosed R'] [IsFractionRing R' K']
    [IsDedekindDomain S₀] [IsFractionRing S₀ L₀] [IsIntegralClosure S₀ R' L₀]
    [FiniteDimensional K' L₀] [Algebra.IsSeparable K' L₀]
    (fField₀ : L →+* L₀) (fInt₀ : S →+* S₀) (hfInj : Function.Injective fInt₀)
    (hfCompat₀ : ∀ x : S, algebraMap S₀ L₀ (fInt₀ x) = fField₀ (algebraMap S L x))
    (hSpan : Submodule.span S₀ (fField₀ '' Submodule.traceDual R K (1 : Submodule S L)) =
      Submodule.traceDual R' K' (1 : Submodule S₀ L₀)) :
    (FractionalIdeal.dual R K (1 : FractionalIdeal S⁰ L)).extended L₀
        (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _ hfInj) =
      FractionalIdeal.dual R' K' (1 : FractionalIdeal S₀⁰ L₀) := by
  let hf := nonZeroDivisors_le_comap_nonZeroDivisors_of_injective fInt₀ hfInj
  have hmap : IsLocalization.map (S := L) L₀ fInt₀ hf = fField₀ := by
    refine IsFractionRing.ringHom_ext (A := S) fun x ↦ ?_
    rw [IsLocalization.map_eq, hfCompat₀]
  have hdual : ((FractionalIdeal.dual R K (1 : FractionalIdeal S⁰ L)) : Set L) =
      Submodule.traceDual R K (1 : Submodule S L) := by
    ext x
    rw [SetLike.mem_coe, SetLike.mem_coe, ← FractionalIdeal.mem_coeToSubmodule,
      FractionalIdeal.coeToSubmodule_dual_one]
  rw [← FractionalIdeal.coeToSubmodule_inj, FractionalIdeal.coeToSubmodule_extended_eq_span,
    hmap, hdual, FractionalIdeal.coeToSubmodule_dual_one]
  exact hSpan

attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra in
/-- Extending `differentIdeal R S` along an injective integral map `fInt₀ : S →+* S₀` gives
`differentIdeal R' S₀` whenever the fractional-ideal trace dual commutes with extension along
`fInt₀`. -/
theorem map_differentIdeal_eq_differentIdeal_of_extended_eq
    [IsDedekindDomain R] [IsFractionRing R K]
    [IsDedekindDomain S] [IsFractionRing S L] [IsIntegralClosure S R L]
    [Module.Finite R S] [Module.IsTorsionFree R S]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [IsDedekindDomain R'] [IsFractionRing R' K']
    [IsDedekindDomain S₀] [IsFractionRing S₀ L₀] [IsIntegralClosure S₀ R' L₀]
    [Module.IsTorsionFree R' S₀]
    [FiniteDimensional K' L₀] [Algebra.IsSeparable K' L₀]
    (fInt₀ : S →+* S₀) (hfInj : Function.Injective fInt₀)
    (hExt : (FractionalIdeal.dual R K (1 : FractionalIdeal S⁰ L)).extended L₀
        (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _ hfInj) =
      FractionalIdeal.dual R' K' (1 : FractionalIdeal S₀⁰ L₀)) :
    (differentIdeal R S).map fInt₀ = differentIdeal R' S₀ := by
  have : Module.Finite R' S₀ := IsIntegralClosure.finite R' K' L₀ S₀
  have : Algebra.IsSeparable (FractionRing R) (FractionRing S) :=
    IsFractionRing.isSeparable_fractionRing R S K L
  have : Algebra.IsSeparable (FractionRing R') (FractionRing S₀) :=
    IsFractionRing.isSeparable_fractionRing R' S₀ K' L₀
  let hf := nonZeroDivisors_le_comap_nonZeroDivisors_of_injective fInt₀ hfInj
  rw [← FractionalIdeal.coeIdeal_inj (K := L₀),
    ← FractionalIdeal.extended_coeIdeal_eq_map (K := L) L₀ hf,
    ← FractionalIdeal.extendedHom'_apply, coeIdeal_differentIdeal R K L S,
    coeIdeal_differentIdeal R' K' L₀ S₀, map_inv₀, FractionalIdeal.extendedHom'_apply, hExt]

end SingleLocal

section Semilocal

variable {ι : Type*} [Finite ι]
variable {R K S L R' K' : Type*}
  [CommRing R] [Field K] [CommRing S] [Field L]
  [CommRing R'] [Field K']
  [Algebra R K] [Algebra K L] [Algebra R S] [Algebra S L] [Algebra R L]
  [IsScalarTower R K L] [IsScalarTower R S L]
  [Algebra R R'] [Algebra R' K'] [Algebra K K'] [Algebra R K']
  [IsScalarTower R R' K'] [IsScalarTower R K K']
variable {S' : ι → Type*} {L' : ι → Type*}
  [∀ i, CommRing (S' i)] [∀ i, Field (L' i)]
  [∀ i, Algebra K' (L' i)] [∀ i, FiniteDimensional K' (L' i)]
  [∀ i, Algebra R' (S' i)] [∀ i, Algebra (S' i) (L' i)] [∀ i, Algebra R' (L' i)]
  [∀ i, IsScalarTower R' K' (L' i)] [∀ i, IsScalarTower R' (S' i) (L' i)]

omit [CommRing R] [CommRing S] [CommRing R'] [Algebra R K] [Algebra R S] [Algebra S L]
  [Algebra R L] [IsScalarTower R K L] [IsScalarTower R S L] [Algebra R R'] [Algebra R' K']
  [Algebra R K'] [IsScalarTower R R' K'] [IsScalarTower R K K'] [∀ i, CommRing (S' i)]
  [∀ i, Algebra R' (S' i)] [∀ i, Algebra (S' i) (L' i)] [∀ i, Algebra R' (L' i)]
  [∀ i, IsScalarTower R' K' (L' i)] [∀ i, IsScalarTower R' (S' i) (L' i)] in
/-- **Trace-dual expansions pass through a semilocal field decomposition.** If
`eField : K' ⊗[K] L ≃ₐ[K'] ∀ i, L' i` sends `a ⊗ x` in component `i` to `a · fField i x`, then any
finite `K`-linear trace-dual expansion on `L` holds in every factor `L' i`. -/
theorem sum_trace_mul_smul_of_semilocal
    (eField : K' ⊗[K] L ≃ₐ[K'] ∀ i, L' i) (fField : ∀ i, L →+* L' i)
    (heField : ∀ (a : K') (x : L) (i : ι),
      eField (a ⊗ₜ[K] x) i = algebraMap K' (L' i) a * fField i x)
    {J : Type*} [Fintype J] (b y : J → L)
    (h : ∀ x : L, ∑ j, Algebra.trace K L (x * b j) • y j = x)
    (i : ι) (z : L' i) :
    ∑ j, Algebra.trace K' (L' i) (z * fField i (b j)) • fField i (y j) = z := by
  classical
  -- Extend the `K`-linear expansion to `K' ⊗[K] L`, evaluate at `eField.symm (Pi.single i z)`,
  -- and read off the `i`-th component.
  have h' := congrArg (fun ξ ↦ eField ξ i)
    (Algebra.sum_trace_tmul_mul_smul_eq (A := K') b y h (eField.symm (Pi.single i z)))
  simp only [AlgEquiv.apply_symm_apply, Pi.single_eq_same, map_sum, map_smul,
    Finset.sum_apply, Pi.smul_apply, heField, map_one, one_mul,
    Algebra.trace_symm_single_mul_of_algEquiv] at h'
  exact h'

/-- Under compatible field and integral semilocal decompositions `(eField, eInt)`, every element of
the global trace dual `Submodule.traceDual R K 1` maps into `Submodule.traceDual R' K' 1` in each
component `i`. -/
theorem mem_traceDual_one_of_semilocal
    (eField : K' ⊗[K] L ≃ₐ[K'] ∀ i, L' i) (eInt : R' ⊗[R] S ≃ₐ[R'] ∀ i, S' i)
    (fField : ∀ i, L →+* L' i) (fInt : ∀ i, S →+* S' i)
    (heField : ∀ (a : K') (x : L) (i : ι),
      eField (a ⊗ₜ[K] x) i = algebraMap K' (L' i) a * fField i x)
    (heInt : ∀ (a : R') (x : S) (i : ι),
      eInt (a ⊗ₜ[R] x) i = algebraMap R' (S' i) a * fInt i x)
    (hfCompat : ∀ (i : ι) (x : S),
      algebraMap (S' i) (L' i) (fInt i x) = fField i (algebraMap S L x))
    (i : ι) ⦃d : L⦄ (hd : d ∈ Submodule.traceDual R K (1 : Submodule S L)) :
    fField i d ∈ Submodule.traceDual R' K' (1 : Submodule (S' i) (L' i)) := by
  classical
  -- Construct the canonical `R`-algebra map `R' ⊗[R] S →ₐ[R] K' ⊗[K] L` internally so callers do
  -- not need to supply its compatibility proof separately.
  let toField : R' ⊗[R] S →ₐ[R] K' ⊗[K] L :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft : K' →ₐ[K] K' ⊗[K] L).restrictScalars R |>.comp
        (IsScalarTower.toAlgHom R R' K'))
      ((Algebra.TensorProduct.includeRight : L →ₐ[K] K' ⊗[K] L).restrictScalars R |>.comp
        (IsScalarTower.toAlgHom R S L))
      fun _ _ ↦ .all _ _
  have htoField_tmul (a : R') (x : S) :
      toField (a ⊗ₜ[R] x) = algebraMap R' K' a ⊗ₜ[K] algebraMap S L x := by
    simp [toField]
  have hcompat (t : R' ⊗[R] S) :
      eField (toField t) = fun j ↦ algebraMap (S' j) (L' j) (eInt t j) := by
    induction t using TensorProduct.inductionOn with
    | add x y hx hy =>
      funext j
      simp [congrFun hx j, congrFun hy j]
    | tmul a x =>
      funext j
      rw [htoField_tmul, heField, heInt, map_mul, hfCompat,
        ← IsScalarTower.algebraMap_apply R' K' (L' j),
        IsScalarTower.algebraMap_apply R' (S' j) (L' j)]
  have hmem (t : R' ⊗[R] S) :
      Algebra.trace K' (K' ⊗[K] L) (toField t * (1 ⊗ₜ[K] d)) ∈ (algebraMap R' K').range := by
    induction t using TensorProduct.inductionOn with
    | add t u ht hu =>
      rw [map_add, add_mul, map_add]
      exact add_mem ht hu
    | tmul a x =>
      obtain ⟨r, hr⟩ := Submodule.mem_traceDual.mp hd _ (Submodule.mem_one.mpr ⟨x, rfl⟩)
      refine ⟨a * algebraMap R R' r, ?_⟩
      rw [Algebra.trace_map_tmul_mul toField htoField_tmul, mul_comm (algebraMap S L x),
        ← Algebra.traceForm_apply, ← hr, map_mul,
        ← IsScalarTower.algebraMap_apply R R' K', IsScalarTower.algebraMap_apply R K K']
  rw [Submodule.mem_traceDual]
  intro _ hz
  obtain ⟨z, rfl⟩ := Submodule.mem_one.mp hz
  -- Lift `z`, placed in the `i`-th component of `∀ j, S' j`, to `R' ⊗[R] S` via `eInt`.
  obtain ⟨t, ht⟩ := eInt.surjective (Pi.single i z)
  have hξ : toField t = eField.symm (Pi.single i (algebraMap (S' i) (L' i) z)) := by
    rw [AlgEquiv.eq_symm_apply, hcompat, ht]
    funext j
    obtain rfl | hj := eq_or_ne j i
    · simp
    · simp [Pi.single_eq_of_ne hj]
  have htr := Algebra.trace_symm_single_mul_of_algEquiv eField i (algebraMap (S' i) (L' i) z)
    ((1 : K') ⊗ₜ[K] d)
  rw [heField, map_one, one_mul] at htr
  rw [Algebra.traceForm_apply, mul_comm, ← htr, ← hξ]
  exact hmem t

/-- **The local trace dual is spanned by the global one** in a semilocal decomposition. -/
theorem span_traceDual_one_eq_traceDual_one_of_semilocal
    [IsDedekindDomain R] [IsFractionRing R K]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [IsIntegralClosure S R L] [Module.Finite R S] [Module.IsTorsionFree R S]
    (eField : K' ⊗[K] L ≃ₐ[K'] ∀ i, L' i) (eInt : R' ⊗[R] S ≃ₐ[R'] ∀ i, S' i)
    (fField : ∀ i, L →+* L' i) (fInt : ∀ i, S →+* S' i)
    (heField : ∀ (a : K') (x : L) (i : ι),
      eField (a ⊗ₜ[K] x) i = algebraMap K' (L' i) a * fField i x)
    (heInt : ∀ (a : R') (x : S) (i : ι),
      eInt (a ⊗ₜ[R] x) i = algebraMap R' (S' i) a * fInt i x)
    (hfCompat : ∀ (i : ι) (x : S),
      algebraMap (S' i) (L' i) (fInt i x) = fField i (algebraMap S L x))
    (i : ι) :
    Submodule.span (S' i) (fField i '' Submodule.traceDual R K (1 : Submodule S L)) =
      Submodule.traceDual R' K' (1 : Submodule (S' i) (L' i)) :=
  span_traceDual_one_eq_traceDual_one_of_forall (fField i) (fInt i) (hfCompat i)
    (mem_traceDual_one_of_semilocal eField eInt fField fInt heField heInt hfCompat i)
    (fun b y hb ↦ sum_trace_mul_smul_of_semilocal eField fField heField b y hb i)

/-- **Fractional-ideal trace duals commute with completion** in a semilocal decomposition. -/
theorem extended_dual_one_eq_dual_one_of_semilocal
    [IsDedekindDomain R] [IsFractionRing R K]
    [IsDedekindDomain S] [IsFractionRing S L] [IsIntegralClosure S R L]
    [Module.Finite R S] [Module.IsTorsionFree R S]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [IsDomain R'] [IsIntegrallyClosed R'] [IsFractionRing R' K']
    (eField : K' ⊗[K] L ≃ₐ[K'] ∀ i, L' i) (eInt : R' ⊗[R] S ≃ₐ[R'] ∀ i, S' i)
    (fField : ∀ i, L →+* L' i) (fInt : ∀ i, S →+* S' i)
    (heField : ∀ (a : K') (x : L) (i : ι),
      eField (a ⊗ₜ[K] x) i = algebraMap K' (L' i) a * fField i x)
    (heInt : ∀ (a : R') (x : S) (i : ι),
      eInt (a ⊗ₜ[R] x) i = algebraMap R' (S' i) a * fInt i x)
    (hfCompat : ∀ (i : ι) (x : S),
      algebraMap (S' i) (L' i) (fInt i x) = fField i (algebraMap S L x))
    (i : ι) [IsDedekindDomain (S' i)] [IsFractionRing (S' i) (L' i)]
    [IsIntegralClosure (S' i) R' (L' i)]
    [Algebra.IsSeparable K' (L' i)] (hfInj : Function.Injective (fInt i)) :
    (FractionalIdeal.dual R K (1 : FractionalIdeal S⁰ L)).extended (L' i)
        (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _ hfInj) =
      FractionalIdeal.dual R' K' (1 : FractionalIdeal (S' i)⁰ (L' i)) :=
  extended_dual_one_eq_dual_one_of_span_eq (fField i) (fInt i) hfInj (hfCompat i)
    (span_traceDual_one_eq_traceDual_one_of_semilocal eField eInt fField fInt heField heInt
      hfCompat i)

/-- **The different ideal commutes with completion** in a semilocal decomposition. -/
theorem map_differentIdeal_eq_differentIdeal_of_semilocal
    [IsDedekindDomain R] [IsFractionRing R K]
    [IsDedekindDomain S] [IsFractionRing S L] [IsIntegralClosure S R L]
    [Module.Finite R S] [Module.IsTorsionFree R S]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [IsDedekindDomain R'] [IsFractionRing R' K']
    (eField : K' ⊗[K] L ≃ₐ[K'] ∀ i, L' i) (eInt : R' ⊗[R] S ≃ₐ[R'] ∀ i, S' i)
    (fField : ∀ i, L →+* L' i) (fInt : ∀ i, S →+* S' i)
    (heField : ∀ (a : K') (x : L) (i : ι),
      eField (a ⊗ₜ[K] x) i = algebraMap K' (L' i) a * fField i x)
    (heInt : ∀ (a : R') (x : S) (i : ι),
      eInt (a ⊗ₜ[R] x) i = algebraMap R' (S' i) a * fInt i x)
    (hfCompat : ∀ (i : ι) (x : S),
      algebraMap (S' i) (L' i) (fInt i x) = fField i (algebraMap S L x))
    (i : ι) [IsDedekindDomain (S' i)] [IsFractionRing (S' i) (L' i)]
    [IsIntegralClosure (S' i) R' (L' i)] [Module.IsTorsionFree R' (S' i)]
    [Algebra.IsSeparable K' (L' i)] (hfInj : Function.Injective (fInt i)) :
    (differentIdeal R S).map (fInt i) = differentIdeal R' (S' i) :=
  map_differentIdeal_eq_differentIdeal_of_extended_eq (K := K) (L := L) (K' := K') (L₀ := L' i)
    (fInt i) hfInj
    (extended_dual_one_eq_dual_one_of_semilocal eField eInt fField fInt heField heInt hfCompat i
      hfInj)

end Semilocal

section SemilocalIdeal

variable {ι R S R' : Type*} [Finite ι]
  [CommRing R] [IsDomain R] [CommRing S] [IsDedekindDomain S] [Algebra R S]
  [Module.IsTorsionFree R S]
  [CommRing R'] [IsDomain R'] [Algebra R R']
  {S' : ι → Type*} [∀ i, CommRing (S' i)] [∀ i, IsDedekindDomain (S' i)]
  [∀ i, Algebra R' (S' i)] [∀ i, Module.IsTorsionFree R' (S' i)]

/-- **The different ideal across an integral semilocal decomposition.** Extending
`differentIdeal R S` to `R' ⊗[R] S` and transporting along `eInt : R' ⊗[R] S ≃ₐ[R'] ∀ i, S' i`
produces the product of the local different ideals `Ideal.pi fun i ↦ differentIdeal R' (S' i)`. -/
theorem map_differentIdeal_semilocal
    (eInt : R' ⊗[R] S ≃ₐ[R'] ∀ i, S' i) (fInt : ∀ i, S →+* S' i)
    (heInt : ∀ (a : R') (x : S) (i : ι),
      eInt (a ⊗ₜ[R] x) i = algebraMap R' (S' i) a * fInt i x)
    (hLocal : ∀ i : ι, (differentIdeal R S).map (fInt i) = differentIdeal R' (S' i)) :
    ((differentIdeal R S).map
        (Algebra.TensorProduct.includeRight : S →ₐ[R] R' ⊗[R] S)).map eInt =
      Ideal.pi fun i ↦ differentIdeal R' (S' i) := by
  have hmap : ((differentIdeal R S).map
        (Algebra.TensorProduct.includeRight : S →ₐ[R] R' ⊗[R] S)).map eInt =
      (differentIdeal R S).map
        (eInt.toRingEquiv.toRingHom.comp
          (Algebra.TensorProduct.includeRight : S →ₐ[R] R' ⊗[R] S).toRingHom) :=
    Ideal.map_map (Algebra.TensorProduct.includeRight : S →ₐ[R] R' ⊗[R] S).toRingHom
      eInt.toRingEquiv.toRingHom
  rw [hmap]
  have hproj (i : ι) :
      ((differentIdeal R S).map
          (eInt.toRingEquiv.toRingHom.comp
            (Algebra.TensorProduct.includeRight : S →ₐ[R] R' ⊗[R] S).toRingHom)).map
        (Pi.evalRingHom S' i) = differentIdeal R' (S' i) := by
    rw [Ideal.map_map, ← hLocal i]
    congr 1
    ext x
    simpa using heInt 1 x i
  -- `Ideal.piOrderIso` is `.symm { toFun := Ideal.pi, invFun I i := I.map (Pi.evalRingHom _ i) }`
  -- (Mathlib's `@[simps!]` on `OrderIso` generates no projection lemma), so `symm_apply_apply`
  -- expresses any ideal of `∀ i, S' i` as `Ideal.pi` of its coordinate projections.
  exact (Ideal.piOrderIso.symm_apply_apply _).symm.trans (congrArg Ideal.pi (funext hproj))

end SemilocalIdeal

end TauCeti

end
