/-!
# The Kähler different and the trace-dual different

For a finite extension `B / A` there are two differents. The *trace-dual* (Dedekind) different
`differentIdeal A B` is the inverse of the complementary module `{y | Tr(y B) ⊆ A}`. The *Kähler*
different is the zeroth Fitting ideal `Fitt₀(Ω[B⁄A])` of the relative differentials. For a
morphism of schemes `f : X ⟶ Y` it is the local form of the ramification ideal sheaf
(`TauCeti.AlgebraicGeometry.ramificationIdealSheaf`), which on smooth curves cuts out the Cartier
ramification divisor, the zero divisor of the cotangent map `f^* Ω_Y → Ω_X`.

When `B = A[x]` is monogenic both are generated by `f'(x)`, `f` the minimal polynomial of `x`
(`AdjoinRoot.fittingIdeal_kaehlerDifferential_zero` and
`TauCeti.differentIdeal_eq_span_aeval_derivative_minpoly`), so they agree. A finite extension of
discrete valuation rings with separable residue extension is monogenic
(`TauCeti.IsDiscreteValuationRing.exists_adjoin_eq_top`), so on that branch the Kähler different
is the trace-dual different, with no completeness or finiteness assumption on the residue fields.

## Main results

* `TauCeti.fittingIdeal_kaehlerDifferential_zero_eq_differentIdeal_of_adjoin_eq_top`: for a
  monogenic extension of Dedekind domains, `Fitt₀(Ω[B⁄A]) = differentIdeal A B`.
* `TauCeti.IsDiscreteValuationRing.fittingIdeal_kaehlerDifferential_zero_eq_differentIdeal`: the
  same for a finite extension of discrete valuation rings with separable residue extension and
  separable fraction-field extension.

## References

* [Stacks Project, Tag 0BVH](https://stacks.math.columbia.edu/tag/0BVH): the Kähler different.
* J.-P. Serre, *Local Fields*, Chapter III, §6, Corollary 2 of Proposition 11 and Proposition 12.
-/

public section

open IsLocalRing

namespace TauCeti

section Monogenic

variable (A K L B : Type*) [CommRing A] [Field K] [Field L] [CommRing B]
  [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
  [IsScalarTower A K L] [IsScalarTower A B L]
  [IsDomain A] [IsFractionRing A K] [IsIntegralClosure B A L]
  [IsIntegrallyClosed A] [IsDedekindDomain B] [Module.IsTorsionFree A B]
  [FiniteDimensional K L] [Algebra.IsSeparable K L] [Module.Finite B Ω[B⁄A]]

include K L in
/-- **The Kähler different of a monogenic extension is the trace-dual different.** If `x`
generates the integral closure `B` of `A` in the finite separable extension `L / K` as an
`A`-algebra, then `Fitt₀(Ω[B⁄A]) = differentIdeal A B`: both are generated by `f'(x)`. -/
theorem fittingIdeal_kaehlerDifferential_zero_eq_differentIdeal_of_adjoin_eq_top {x : B}
    (hx : Algebra.adjoin A {x} = ⊤) :
    fittingIdeal B Ω[B⁄A] 0 = differentIdeal A B := by
  have := IsIntegralClosure.isFractionRing_of_finite_extension A K L B
  rw [differentIdeal_eq_span_aeval_derivative_minpoly A K L B x hx,
    fittingIdeal_kaehlerDifferential_zero_of_adjoin_eq_top
      (IsIntegralClosure.isIntegral A L x) hx]

end Monogenic

namespace IsDiscreteValuationRing

variable {A B : Type*} [CommRing A] [CommRing B] [IsDomain A] [IsDomain B]
  [IsDiscreteValuationRing A] [IsDiscreteValuationRing B] [Algebra A B] [Module.Finite A B]
  [FaithfulSMul A B] (K L : Type*) [Field K] [Field L] [Algebra A K] [IsFractionRing A K]
  [Algebra B L] [IsFractionRing B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
  [IsScalarTower A B L] [Algebra.IsSeparable K L]

include K L in
/-- **The Kähler different on the separable-residue branch.** For a finite extension of discrete
valuation rings `B / A` with separable residue extension and separable fraction-field extension
`L / K`, the zeroth Fitting ideal of `Ω[B⁄A]` is the trace-dual different `differentIdeal A B`.
Neither completeness nor finiteness of the residue fields is assumed. -/
theorem fittingIdeal_kaehlerDifferential_zero_eq_differentIdeal
    [Algebra.IsSeparable (ResidueField A) (ResidueField B)] :
    fittingIdeal B Ω[B⁄A] 0 = differentIdeal A B := by
  obtain ⟨x, hx⟩ := exists_adjoin_eq_top (R := A) (S := B)
  -- `x` also generates `L` over `K`, and is algebraic over `K`, so `L / K` is finite.
  have hK : IntermediateField.adjoin K {algebraMap B L x} = ⊤ :=
    IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top hx
  have hxK : IsIntegral K (algebraMap B L x) :=
    ((IsIntegral.of_finite A x).map (IsScalarTower.toAlgHom A B L)).tower_top
  have : FiniteDimensional K L := by
    have := IntermediateField.adjoin.finiteDimensional hxK
    rw [hK] at this
    exact IntermediateField.topEquiv.toLinearEquiv.finiteDimensional
  exact fittingIdeal_kaehlerDifferential_zero_eq_differentIdeal_of_adjoin_eq_top A K L B hx

end IsDiscreteValuationRing

end TauCeti
