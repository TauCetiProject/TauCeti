/-!
# Trace-dual quotient comparison for linear maps

Let `A` be an integral domain with fraction field `K`, let `L / K` be a finite separable extension,
and let `B` be the integral closure of `A` in `L`, with trace dual
`Bᵛ = Submodule.traceDual A K (1 : Submodule B L)`.

When `B` is a finite projective `A`-module, the trace map `L → K` descends to an `A`-linear map
`L ⧸ Bᵛ → K ⧸ A`, and postcomposition yields a canonical `A`-linear equivalence

`(M →ₗ[B] (L ⧸ Bᵛ)) ≃ₗ[A] (M →ₗ[A] (K ⧸ A))`

for every `B`-module `M`, with inverse constructed from any finite trace-dual family `(bᵢ, yᵢ)`.
When the different ideal `differentIdeal A B` is principal and generated by `δ`, dividing by `δ`
identifies `L ⧸ B` with `L ⧸ Bᵛ`. By contrast, the direct trace pairing
`L ⧸ B → (B →ₗ[A] (K ⧸ A))` has kernel `Bᵛ ⧸ B`, which vanishes if and only if
`differentIdeal A B = ⊤`.

## Main definitions and results

* `TauCeti.traceDualQuotientMap`: the `A`-linear map `L ⧸ Bᵛ → K ⧸ A` induced by `Algebra.trace`.
* `TauCeti.mulByTraceDualQuotientMap`: the `A`-linear map `K ⧸ A → L ⧸ Bᵛ` multiplying by an
  element of `Bᵛ`.
* `TauCeti.traceDualLinearMapEquiv`: the canonical equivalence
  `(M →ₗ[B] (L ⧸ Bᵛ)) ≃ₗ[A] (M →ₗ[A] (K ⧸ A))`.
* `TauCeti.traceDualLinearMapEquiv_symm_apply_of_dualFamily`: explicit formula for the inverse
  in terms of any finite trace-dual family.
* `TauCeti.quotientEquivTraceDualQuotientOfDifferentIdealEqSpan`: `B`-linear equivalence
  `(L ⧸ B) ≃ₗ[B] (L ⧸ Bᵛ)` given a generator `δ` of `differentIdeal A B`.
* `TauCeti.directTraceQuotientMap` and `TauCeti.directTracePairing`: the naive trace map
  `L ⧸ B → K ⧸ A` and induced pairing `L ⧸ B → (B →ₗ[A] K ⧸ A)`.
* `TauCeti.ker_directTracePairing`: the kernel of `directTracePairing` is the image of `Bᵛ` in
  `L ⧸ B`.
* `TauCeti.ker_directTracePairing_eq_bot_iff_differentIdeal_eq_top`: the direct trace pairing is
  injective if and only if `differentIdeal A B = ⊤`.

## References

* J.-P. Serre, *Local Fields*, Chapter III, §3.
* J. Neukirch, *Algebraic Number Theory*, Chapter III, §2.
-/

public section

namespace TauCeti

section TraceDualQuotient

variable (A K B L : Type*) [CommRing A] [Field K] [CommRing B] [Field L]
  [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
  [IsScalarTower A K L] [IsScalarTower A B L]

/-- The `A`-linear map `L ⧸ Bᵛ → K ⧸ A` induced by `Algebra.trace K L`. -/
noncomputable def traceDualQuotientMap :
    (L ⧸ Submodule.traceDual A K (1 : Submodule B L)) →ₗ[A] (K ⧸ (1 : Submodule A K)) :=
  ((Submodule.traceDual A K (1 : Submodule B L)).restrictScalars A).liftQ
    ((1 : Submodule A K).mkQ ∘ₗ (Algebra.trace K L).restrictScalars A) <| by
    intro x hx
    rw [LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.restrictScalars_apply,
      Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_one]
    have h := Submodule.mem_traceDual.mp hx 1 (Submodule.mem_one.mpr ⟨1, map_one _⟩)
    simpa [Algebra.traceForm_apply] using h

@[simp]
theorem traceDualQuotientMap_mk (x : L) :
    traceDualQuotientMap A K B L (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (Algebra.trace K L x) := (rfl)

/-- For `y ∈ Bᵛ`, multiplication by `y` descends to an `A`-linear map `K ⧸ A → L ⧸ Bᵛ`. -/
noncomputable def mulByTraceDualQuotientMap (y : L)
    (hy : y ∈ Submodule.traceDual A K (1 : Submodule B L)) :
    (K ⧸ (1 : Submodule A K)) →ₗ[A] (L ⧸ Submodule.traceDual A K (1 : Submodule B L)) :=
  (1 : Submodule A K).liftQ
    { toFun := fun k ↦ Submodule.Quotient.mk (k • y)
      map_add' := fun k₁ k₂ ↦ by rw [add_smul, Submodule.Quotient.mk_add]
      map_smul' := fun a k ↦ by
        simp only [RingHom.id_apply, smul_assoc]
        rfl } <| by
    intro k hk
    obtain ⟨a, rfl⟩ := Submodule.mem_one.mp hk
    rw [LinearMap.mem_ker, LinearMap.coe_mk, AddHom.coe_mk, Submodule.Quotient.mk_eq_zero,
      algebraMap_smul, ← algebraMap_smul B a y]
    exact (Submodule.traceDual A K (1 : Submodule B L)).smul_mem (algebraMap A B a) hy

@[simp]
theorem mulByTraceDualQuotientMap_mk (y : L)
    (hy : y ∈ Submodule.traceDual A K (1 : Submodule B L)) (k : K) :
    mulByTraceDualQuotientMap A K B L y hy (Submodule.Quotient.mk k) =
      Submodule.Quotient.mk (k • y) := (rfl)

end TraceDualQuotient

section TraceDualEquiv

variable (A K B L : Type*) [CommRing A] [Field K] [CommRing B] [Field L]
  [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
  [IsScalarTower A K L] [IsScalarTower A B L]
  [IsDomain A] [IsFractionRing A K] [FiniteDimensional K L] [Algebra.IsSeparable K L]
  [IsIntegralClosure B A L]

omit [IsDomain A] [IsFractionRing A K] in
/-- Given a finite trace-dual family `(b, y)` and a scalar `c : B`, there is an `A`-valued matrix
`t i j` expressing both `c * b j = ∑ i, t i j • b i` and `c • y i = ∑ j, t i j • y j`. -/
private theorem exists_matrix_of_dualFamily {n : ℕ} (b : Fin n → B) (y : Fin n → L)
    (hy : ∀ i, y i ∈ Submodule.traceDual A K (1 : Submodule B L))
    (hsum : ∀ x : L, ∑ i, Algebra.trace K L (x * algebraMap B L (b i)) • y i = x) (c : B) :
    ∃ t : Fin n → Fin n → A,
      (∀ j, ∑ i, t i j • b i = c * b j) ∧
      (∀ i, ∑ j, algebraMap A K (t i j) • y j = algebraMap B L c * y i) := by
  have ht_ex : ∀ i j : Fin n,
      ∃ a : A, algebraMap A K a = Algebra.trace K L (y i * algebraMap B L (c * b j)) := fun i j ↦
    Submodule.mem_traceDual.mp (hy i) (algebraMap B L (c * b j))
      (Submodule.mem_one.mpr ⟨c * b j, rfl⟩)
  choose t ht using ht_ex
  refine ⟨t, fun j ↦ ?_, fun i ↦ ?_⟩
  · apply IsIntegralClosure.algebraMap_injective B A L
    rw [← sub_eq_zero]
    refine (traceForm_nondegenerate K L).1 _ fun x ↦ ?_
    rw [Algebra.traceForm_apply, mul_comm, mul_sub, map_sub, sub_eq_zero, map_sum, Finset.mul_sum,
      map_sum]
    have hL : Algebra.trace K L (x * algebraMap B L (c * b j)) =
        Algebra.trace K L ((∑ i, Algebra.trace K L (x * algebraMap B L (b i)) • y i) *
          algebraMap B L (c * b j)) := by
      rw [hsum x]
    rw [hL, Finset.sum_mul, map_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    have hsm : algebraMap B L (t i j • b i) = algebraMap A K (t i j) • algebraMap B L (b i) := by
      rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply A B L,
        IsScalarTower.algebraMap_apply A K L, ← Algebra.smul_def]
    rw [hsm, mul_smul_comm, smul_mul_assoc, map_smul, map_smul, smul_eq_mul, smul_eq_mul,
      ht i j, mul_comm]
  · calc
      ∑ j, algebraMap A K (t i j) • y j
        = ∑ j, Algebra.trace K L (y i * algebraMap B L (c * b j)) • y j := by
            refine Finset.sum_congr rfl fun j _ ↦ by rw [ht i j]
      _ = ∑ j, Algebra.trace K L ((algebraMap B L c * y i) * algebraMap B L (b j)) • y j := by
            refine Finset.sum_congr rfl fun j _ ↦ by
              rw [map_mul (algebraMap B L)]
              congr 2
              ring
      _ = algebraMap B L c * y i := hsum (algebraMap B L c * y i)

omit [IsDomain A] [IsFractionRing A K] in
/-- Given a finite trace-dual family `(b, y)`, the traces `Tr(yᵢ)` lie in `A` and satisfy
`∑ i, Tr(yᵢ) • bᵢ = 1`. -/
private theorem exists_trace_coeffs_of_dualFamily {n : ℕ} (b : Fin n → B) (y : Fin n → L)
    (hy : ∀ i, y i ∈ Submodule.traceDual A K (1 : Submodule B L))
    (hsum : ∀ x : L, ∑ i, Algebra.trace K L (x * algebraMap B L (b i)) • y i = x) :
    ∃ a : Fin n → A,
      (∀ i, algebraMap A K (a i) = Algebra.trace K L (y i)) ∧
      ∑ i, a i • b i = 1 := by
  have ha_ex : ∀ i : Fin n, ∃ a : A, algebraMap A K a = Algebra.trace K L (y i) := fun i ↦ by
    have h := Submodule.mem_traceDual.mp (hy i) 1 (Submodule.mem_one.mpr ⟨1, map_one _⟩)
    simpa [Algebra.traceForm_apply] using h
  choose a ha using ha_ex
  refine ⟨a, ha, ?_⟩
  apply IsIntegralClosure.algebraMap_injective B A L
  rw [← sub_eq_zero]
  refine (traceForm_nondegenerate K L).1 _ fun x ↦ ?_
  rw [Algebra.traceForm_apply, mul_comm, mul_sub, map_sub, sub_eq_zero, map_sum, Finset.mul_sum,
    map_sum, map_one, mul_one]
  conv_rhs => rw [← hsum x, map_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  have hsm : algebraMap B L (a i • b i) = algebraMap A K (a i) • algebraMap B L (b i) := by
    rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply A B L,
      IsScalarTower.algebraMap_apply A K L, ← Algebra.smul_def]
  rw [hsm, mul_smul_comm, map_smul, map_smul, smul_eq_mul, smul_eq_mul, ha i, mul_comm]

omit [IsDomain A] [IsFractionRing A K] in
/-- Given a finite trace-dual family `(b, y)`, build the `B`-linear map `M →ₗ[B] L ⧸ Bᵛ`
corresponding to an `A`-linear map `ψ : M →ₗ[A] K ⧸ A`. -/
private noncomputable def traceDualLiftOfDualFamily {M : Type*} [AddCommGroup M]
    [Module B M] [Module A M] [IsScalarTower A B M]
    {n : ℕ} (b : Fin n → B) (y : Fin n → L)
    (hy : ∀ i, y i ∈ Submodule.traceDual A K (1 : Submodule B L))
    (hsum : ∀ x : L, ∑ i, Algebra.trace K L (x * algebraMap B L (b i)) • y i = x)
    (ψ : M →ₗ[A] (K ⧸ (1 : Submodule A K))) :
    M →ₗ[B] (L ⧸ Submodule.traceDual A K (1 : Submodule B L)) where
  toFun m := ∑ i, mulByTraceDualQuotientMap A K B L (y i) (hy i) (ψ (b i • m))
  map_add' m₁ m₂ := by
    simp only [smul_add, map_add, Finset.sum_add_distrib]
  map_smul' c m := by
    obtain ⟨t, htb, hty⟩ := exists_matrix_of_dualFamily A K B L b y hy hsum c
    have hstep : ∀ (i : Fin n) (q : K ⧸ (1 : Submodule A K)),
        c • mulByTraceDualQuotientMap A K B L (y i) (hy i) q =
          ∑ j, mulByTraceDualQuotientMap A K B L (y j) (hy j) (t i j • q) := by
      intro i q
      obtain ⟨k, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      change Submodule.Quotient.mk (c • (k • y i)) =
        ∑ j, Submodule.Quotient.mk ((t i j • k) • y j)
      simp_rw [← Submodule.mkQ_apply]
      rw [← map_sum]
      congr 1
      calc
        c • (k • y i) = k • (algebraMap B L c * y i) := by
          rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def]
          ring
        _ = k • ∑ j, algebraMap A K (t i j) • y j := by rw [← hty i]
        _ = ∑ j, k • (algebraMap A K (t i j) • y j) := Finset.smul_sum
        _ = ∑ j, (t i j • k) • y j := by
          refine Finset.sum_congr rfl fun j _ ↦ ?_
          rw [smul_smul, mul_comm k, ← Algebra.smul_def]
    simp only [RingHom.id_apply, Finset.smul_sum]
    calc
      ∑ j, mulByTraceDualQuotientMap A K B L (y j) (hy j) (ψ (b j • (c • m)))
        = ∑ j, mulByTraceDualQuotientMap A K B L (y j) (hy j) (ψ ((c * b j) • m)) := by
            refine Finset.sum_congr rfl fun j _ ↦ by rw [smul_smul, mul_comm c]
      _ = ∑ j, mulByTraceDualQuotientMap A K B L (y j) (hy j)
            (ψ ((∑ i, t i j • b i) • m)) := by
            refine Finset.sum_congr rfl fun j _ ↦ by rw [htb j]
      _ = ∑ j, ∑ i, mulByTraceDualQuotientMap A K B L (y j) (hy j) (t i j • ψ (b i • m)) := by
            refine Finset.sum_congr rfl fun j _ ↦ ?_
            simp only [Finset.sum_smul, map_sum, smul_assoc, map_smul]
      _ = ∑ i, ∑ j, mulByTraceDualQuotientMap A K B L (y j) (hy j) (t i j • ψ (b i • m)) :=
            Finset.sum_comm
      _ = ∑ i, c • mulByTraceDualQuotientMap A K B L (y i) (hy i) (ψ (b i • m)) := by
            refine Finset.sum_congr rfl fun i _ ↦ (hstep i _).symm

omit [IsDomain A] [IsFractionRing A K] in
/-- Postcomposing `traceDualLiftOfDualFamily` with `traceDualQuotientMap` recovers the original
`A`-linear map. -/
private theorem traceDualQuotientMap_traceDualLiftOfDualFamily {M : Type*} [AddCommGroup M]
    [Module B M] [Module A M] [IsScalarTower A B M]
    {n : ℕ} (b : Fin n → B) (y : Fin n → L)
    (hy : ∀ i, y i ∈ Submodule.traceDual A K (1 : Submodule B L))
    (hsum : ∀ x : L, ∑ i, Algebra.trace K L (x * algebraMap B L (b i)) • y i = x)
    (ψ : M →ₗ[A] (K ⧸ (1 : Submodule A K))) :
    traceDualQuotientMap A K B L ∘ₗ
        (traceDualLiftOfDualFamily A K B L b y hy hsum ψ).restrictScalars A = ψ := by
  obtain ⟨a, ha, ha_sum⟩ := exists_trace_coeffs_of_dualFamily A K B L b y hy hsum
  have hcomp : ∀ (i : Fin n) (q : K ⧸ (1 : Submodule A K)),
      traceDualQuotientMap A K B L (mulByTraceDualQuotientMap A K B L (y i) (hy i) q) =
        a i • q := by
    intro i q
    obtain ⟨k, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    rw [mulByTraceDualQuotientMap_mk, traceDualQuotientMap_mk, map_smul, smul_eq_mul, ← ha i,
      mul_comm k, ← Algebra.smul_def]
    rfl
  ext m
  change traceDualQuotientMap A K B L
      (∑ i, mulByTraceDualQuotientMap A K B L (y i) (hy i) (ψ (b i • m))) = ψ m
  rw [map_sum]
  simp_rw [hcomp]
  calc
    ∑ i, a i • ψ (b i • m) = ψ (∑ i, (a i • b i) • m) := by
      simp only [map_sum, smul_assoc, map_smul]
    _ = ψ ((1 : B) • m) := by rw [← Finset.sum_smul, ha_sum]
    _ = ψ m := by rw [one_smul]

/-- **Inverse-different trace comparison for linear maps**: when `B` is a finite projective
`A`-module, postcomposition with `traceDualQuotientMap` gives a canonical `A`-linear equivalence
`(M →ₗ[B] (L ⧸ Bᵛ)) ≃ₗ[A] (M →ₗ[A] (K ⧸ A))` for every `B`-module `M`. -/
noncomputable def traceDualLinearMapEquiv [Module.Finite A B] [Module.Projective A B]
    (M : Type*) [AddCommGroup M] [Module B M] [Module A M] [IsScalarTower A B M] :
    (M →ₗ[B] (L ⧸ Submodule.traceDual A K (1 : Submodule B L))) ≃ₗ[A]
      (M →ₗ[A] (K ⧸ (1 : Submodule A K))) := by
  have hfam := Classical.choose_spec (exists_sum_trace_mul_smul_eq A K (B := B) (L := L))
  let b := Classical.choose hfam
  have hb := Classical.choose_spec hfam
  let y := Classical.choose hb
  have hy_all := Classical.choose_spec hb
  let hy := hy_all.1
  let hsum := hy_all.2
  refine LinearEquiv.ofBijective
    { toFun := fun φ ↦ traceDualQuotientMap A K B L ∘ₗ φ.restrictScalars A
      map_add' := fun φ₁ φ₂ ↦ by ext m; simp
      map_smul' := fun a φ ↦ by ext m; simp }
    (Function.bijective_iff_has_inverse.mpr
      ⟨traceDualLiftOfDualFamily A K B L b y hy hsum, fun φ ↦ ?_,
        fun ψ ↦ traceDualQuotientMap_traceDualLiftOfDualFamily A K B L b y hy hsum ψ⟩)
  ext m
  obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective _ (φ m)
  change ∑ i, mulByTraceDualQuotientMap A K B L (y i) (hy i)
      (traceDualQuotientMap A K B L (φ (b i • m))) = φ m
  rw [← hx]
  have hbi : ∀ i, φ (b i • m) = Submodule.Quotient.mk (algebraMap B L (b i) * x) := fun i ↦ by
    rw [map_smul, ← hx, ← Submodule.Quotient.mk_smul, Algebra.smul_def]
  simp only [hbi, traceDualQuotientMap_mk, mulByTraceDualQuotientMap_mk]
  simp_rw [← Submodule.mkQ_apply]
  rw [← map_sum]
  congr 1
  simpa only [mul_comm x] using hsum x

@[simp]
theorem traceDualLinearMapEquiv_apply [Module.Finite A B] [Module.Projective A B]
    {M : Type*} [AddCommGroup M] [Module B M] [Module A M] [IsScalarTower A B M]
    (φ : M →ₗ[B] (L ⧸ Submodule.traceDual A K (1 : Submodule B L))) (m : M) :
    traceDualLinearMapEquiv A K B L M φ m = traceDualQuotientMap A K B L (φ m) := (rfl)

/-- `traceDualLinearMapEquiv` is compatible with the `B`-module structure on `M`. -/
theorem traceDualLinearMapEquiv_smul_apply [Module.Finite A B] [Module.Projective A B]
    {M : Type*} [AddCommGroup M] [Module B M] [Module A M] [IsScalarTower A B M]
    (b : B) (φ : M →ₗ[B] (L ⧸ Submodule.traceDual A K (1 : Submodule B L))) (m : M) :
    traceDualLinearMapEquiv A K B L M (b • φ) m = traceDualLinearMapEquiv A K B L M φ (b • m) := by
  simp [traceDualLinearMapEquiv_apply, map_smul]

/-- Explicit formula for `(traceDualLinearMapEquiv).symm` in terms of any finite trace-dual
family `(b, y)`. -/
theorem traceDualLinearMapEquiv_symm_apply_of_dualFamily
    [Module.Finite A B] [Module.Projective A B]
    {M : Type*} [AddCommGroup M] [Module B M] [Module A M] [IsScalarTower A B M]
    {n : ℕ} (b : Fin n → B) (y : Fin n → L)
    (hy : ∀ i, y i ∈ Submodule.traceDual A K (1 : Submodule B L))
    (hsum : ∀ x : L, ∑ i, Algebra.trace K L (x * algebraMap B L (b i)) • y i = x)
    (ψ : M →ₗ[A] (K ⧸ (1 : Submodule A K))) (m : M) :
    (traceDualLinearMapEquiv A K B L M).symm ψ m =
      ∑ i, mulByTraceDualQuotientMap A K B L (y i) (hy i) (ψ (b i • m)) := by
  have hfun : (traceDualLinearMapEquiv A K B L M).symm ψ =
      traceDualLiftOfDualFamily A K B L b y hy hsum ψ := by
    apply (traceDualLinearMapEquiv A K B L M).injective
    rw [LinearEquiv.apply_symm_apply]
    exact (traceDualQuotientMap_traceDualLiftOfDualFamily A K B L b y hy hsum ψ).symm
  exact LinearMap.congr_fun hfun m

end TraceDualEquiv

section PrincipalDifferent

variable (A K B L : Type*) [CommRing A] [Field K] [CommRing B] [Field L]
  [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
  [IsScalarTower A K L] [IsScalarTower A B L]
  [IsDomain A] [IsFractionRing A K] [IsFractionRing B L]
  [IsIntegrallyClosed A] [IsIntegralClosure B A L]
  [FiniteDimensional K L] [Algebra.IsSeparable K L]
  [IsDedekindDomain B] [Module.IsTorsionFree A B]

/-- When `differentIdeal A B = Ideal.span {δ}`, dividing by `δ` induces a `B`-linear equivalence
`(L ⧸ B) ≃ₗ[B] (L ⧸ Bᵛ)`. -/
noncomputable def quotientEquivTraceDualQuotientOfDifferentIdealEqSpan {δ : B}
    (hδ : differentIdeal A B = Ideal.span {δ}) :
    (L ⧸ (1 : Submodule B L)) ≃ₗ[B] (L ⧸ Submodule.traceDual A K (1 : Submodule B L)) := by
  have hδL : algebraMap B L δ ≠ 0 :=
    algebraMap_ne_zero_of_differentIdeal_eq_span (R := A) (K := K) (L := L) hδ
  let divMap : L →ₗ[B] L :=
    { toFun := fun x ↦ x / algebraMap B L δ
      map_add' := fun x y ↦ add_div x y _
      map_smul' := fun b x ↦ by simp [Algebra.smul_def, mul_div_assoc] }
  let mulMap : L →ₗ[B] L :=
    { toFun := fun x ↦ x * algebraMap B L δ
      map_add' := fun x y ↦ add_mul x y _
      map_smul' := fun b x ↦ by simp [Algebra.smul_def, mul_assoc] }
  let toF : (L ⧸ (1 : Submodule B L)) →ₗ[B]
      (L ⧸ Submodule.traceDual A K (1 : Submodule B L)) :=
    Submodule.mapQ _ _ divMap <| by
      intro x hx
      rw [Submodule.mem_comap]
      change x / algebraMap B L δ ∈ Submodule.traceDual A K (1 : Submodule B L)
      rw [mem_traceDual_one_iff_mul_of_differentIdeal_eq_span hδ, div_mul_cancel₀ _ hδL]
      exact hx
  let invF : (L ⧸ Submodule.traceDual A K (1 : Submodule B L)) →ₗ[B]
      (L ⧸ (1 : Submodule B L)) :=
    Submodule.mapQ _ _ mulMap <| by
      intro x hx
      rw [Submodule.mem_comap]
      exact (mem_traceDual_one_iff_mul_of_differentIdeal_eq_span hδ).mp hx
  refine LinearEquiv.ofLinearMap toF invF ?_ ?_
  · ext x
    simp [toF, invF, divMap, mulMap, mul_div_cancel_right₀ _ hδL]
  · ext x
    simp [toF, invF, divMap, mulMap, div_mul_cancel₀ _ hδL]

@[simp]
theorem quotientEquivTraceDualQuotientOfDifferentIdealEqSpan_mk {δ : B}
    (hδ : differentIdeal A B = Ideal.span {δ}) (x : L) :
    quotientEquivTraceDualQuotientOfDifferentIdealEqSpan A K B L hδ (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (x / algebraMap B L δ) := (rfl)

@[simp]
theorem quotientEquivTraceDualQuotientOfDifferentIdealEqSpan_symm_mk {δ : B}
    (hδ : differentIdeal A B = Ideal.span {δ}) (x : L) :
    (quotientEquivTraceDualQuotientOfDifferentIdealEqSpan A K B L hδ).symm
        (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (x * algebraMap B L δ) := (rfl)

end PrincipalDifferent

section DirectTrace

variable (A K B L : Type*) [CommRing A] [Field K] [CommRing B] [Field L]
  [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
  [IsScalarTower A K L] [IsScalarTower A B L]
  [IsFractionRing A K] [IsIntegrallyClosed A] [IsIntegralClosure B A L]
  [FiniteDimensional K L]

/-- The direct `A`-linear trace map `L ⧸ B → K ⧸ A`, descending from `Algebra.trace K L`. -/
noncomputable def directTraceQuotientMap :
    (L ⧸ (1 : Submodule B L)) →ₗ[A] (K ⧸ (1 : Submodule A K)) :=
  ((1 : Submodule B L).restrictScalars A).liftQ
    ((1 : Submodule A K).mkQ ∘ₗ (Algebra.trace K L).restrictScalars A) <| by
    intro x hx
    rw [LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.restrictScalars_apply,
      Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_one]
    have hx' : x ∈ Submodule.traceDual A K (1 : Submodule B L) :=
      Submodule.one_le_traceDual_one hx
    have h := Submodule.mem_traceDual.mp hx' 1 (Submodule.mem_one.mpr ⟨1, map_one _⟩)
    simpa [Algebra.traceForm_apply] using h

@[simp]
theorem directTraceQuotientMap_mk (x : L) :
    directTraceQuotientMap A K B L (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (Algebra.trace K L x) := (rfl)

/-- The direct trace pairing `L ⧸ B → (B →ₗ[A] (K ⧸ A))` sending `[x]` to `b ↦ [Tr_{L/K}(b x)]`. -/
noncomputable def directTracePairing :
    (L ⧸ (1 : Submodule B L)) →ₗ[A] (B →ₗ[A] (K ⧸ (1 : Submodule A K))) where
  toFun q :=
    { toFun := fun b ↦ directTraceQuotientMap A K B L (b • q)
      map_add' := fun b₁ b₂ ↦ by rw [add_smul, map_add]
      map_smul' := fun a b ↦ by
        simp only [RingHom.id_apply, smul_assoc, map_smul] }
  map_add' q₁ q₂ := by
    ext b
    simp [smul_add, map_add]
  map_smul' a q := by
    ext b
    simp [smul_comm b a, map_smul]

@[simp]
theorem directTracePairing_mk_apply (x : L) (b : B) :
    directTracePairing A K B L (Submodule.Quotient.mk x) b =
      Submodule.Quotient.mk (Algebra.trace K L (algebraMap B L b * x)) := by
  change directTraceQuotientMap A K B L (b • Submodule.Quotient.mk x) = _
  rw [← Submodule.Quotient.mk_smul, directTraceQuotientMap_mk, Algebra.smul_def]

/-- An element `[x] ∈ L ⧸ B` lies in the kernel of `directTracePairing` if and only if `x ∈ Bᵛ`. -/
theorem mem_ker_directTracePairing_iff (x : L) :
    Submodule.Quotient.mk (p := (1 : Submodule B L)) x ∈
        LinearMap.ker (directTracePairing A K B L) ↔
      x ∈ Submodule.traceDual A K (1 : Submodule B L) := by
  rw [LinearMap.mem_ker, LinearMap.ext_iff, Submodule.mem_traceDual]
  constructor
  · intro h y hy
    obtain ⟨b, rfl⟩ := Submodule.mem_one.mp hy
    have hb := h b
    rw [directTracePairing_mk_apply, LinearMap.zero_apply, Submodule.Quotient.mk_eq_zero,
      Submodule.mem_one, mul_comm] at hb
    simpa [Algebra.traceForm_apply] using hb
  · intro h b
    rw [directTracePairing_mk_apply, LinearMap.zero_apply, Submodule.Quotient.mk_eq_zero,
      Submodule.mem_one, mul_comm]
    simpa [Algebra.traceForm_apply] using h (algebraMap B L b) (Submodule.mem_one.mpr ⟨b, rfl⟩)

/-- **Kernel of the naive trace pairing**: `ker(L ⧸ B → Hom_A(B, K ⧸ A))` is precisely the image
of the inverse different `Bᵛ` in `L ⧸ B`. -/
theorem ker_directTracePairing :
    LinearMap.ker (directTracePairing A K B L) =
      ((Submodule.traceDual A K (1 : Submodule B L)).restrictScalars A).map
        ((1 : Submodule B L).mkQ.restrictScalars A) := by
  ext q
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  rw [mem_ker_directTracePairing_iff, Submodule.mem_map]
  constructor
  · intro hx
    exact ⟨x, hx, rfl⟩
  · rintro ⟨y, hy, hyx⟩
    have hdiff : y - x ∈ (1 : Submodule B L) :=
      (Submodule.Quotient.eq (1 : Submodule B L)).mp hyx
    have hdiff' : y - x ∈ Submodule.traceDual A K (1 : Submodule B L) :=
      Submodule.one_le_traceDual_one hdiff
    have : x = y - (y - x) := by abel
    rw [this]
    exact (Submodule.traceDual A K (1 : Submodule B L)).sub_mem hy hdiff'

/-- The direct trace pairing `L ⧸ B → Hom_A(B, K ⧸ A)` is injective if and only if
`Bᵛ = B`. -/
theorem ker_directTracePairing_eq_bot_iff :
    LinearMap.ker (directTracePairing A K B L) = ⊥ ↔
      Submodule.traceDual A K (1 : Submodule B L) = 1 := by
  rw [eq_bot_iff]
  constructor
  · intro h
    refine le_antisymm (fun x hx ↦ ?_) Submodule.one_le_traceDual_one
    have hq : Submodule.Quotient.mk (p := (1 : Submodule B L)) x ∈ (⊥ : Submodule A _) :=
      h ((mem_ker_directTracePairing_iff A K B L x).mpr hx)
    rwa [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero] at hq
  · intro h q hq
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    rw [mem_ker_directTracePairing_iff, h] at hq
    rwa [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]

/-- Over a Dedekind domain `B`, the direct trace pairing `L ⧸ B → Hom_A(B, K ⧸ A)` is injective
if and only if `differentIdeal A B = ⊤`. -/
theorem ker_directTracePairing_eq_bot_iff_differentIdeal_eq_top
    [IsDomain A] [Algebra.IsSeparable K L] [IsDedekindDomain B] [Module.IsTorsionFree A B] :
    LinearMap.ker (directTracePairing A K B L) = ⊥ ↔ differentIdeal A B = ⊤ := by
  rw [ker_directTracePairing_eq_bot_iff]
  constructor
  · intro h
    rw [eq_top_iff]
    intro y _
    rw [mem_differentIdeal_iff_forall_mem_traceDual (R := A) (K := K) (L := L), h]
    intro x hx
    obtain ⟨b, rfl⟩ := Submodule.mem_one.mp hx
    exact Submodule.mem_one.mpr ⟨b * y, map_mul (algebraMap B L) b y⟩
  · intro h
    refine le_antisymm (fun x hx ↦ ?_) Submodule.one_le_traceDual_one
    have hmem := (mem_traceDual_one_iff_forall_mem_differentIdeal (R := A) (K := K)).mp hx
      1 (h.symm ▸ Submodule.mem_top)
    simpa using hmem

end DirectTrace

end TauCeti
