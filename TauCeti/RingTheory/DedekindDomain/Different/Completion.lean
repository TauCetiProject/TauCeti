/-!
# The trace-dual different under adic completion

Let `R ⊆ B` be Dedekind domains with fraction fields `K ⊆ L`, with `B` the integral closure of `R`
in the finite separable extension `L / K`, and let `w` be a height-one prime of `B` lying over the
height-one prime `v` of `R`. Without any finiteness or separability hypothesis on the residue
fields `R ⧸ v` and `B ⧸ w`, the completed extension `𝒪_w / 𝒪_v` inside `L_w / K_v` satisfies:

* the local complementary module `Submodule.traceDual 𝒪_v K_v 1` is spanned over `𝒪_w` by the image
  of the global complementary module `Submodule.traceDual R K 1`;
* the different ideal commutes with completion:
  `differentIdeal 𝒪_v 𝒪_w = (differentIdeal R B).map (algebraMap B 𝒪_w)`;
* the local different exponent equals the global multiplicity `multiplicity w (differentIdeal R B)`;
* the length of the completed complementary-module quotient `C_w / 𝒪_w` over `𝒪_v`, and the `𝒪_v`-
  valuation of the discriminant of any `𝒪_v`-basis of `𝒪_w`, equal
  `multiplicity w (differentIdeal R B) * w.asIdeal.inertiaDeg R`, where `w.asIdeal.inertiaDeg R` is
  the full inertia degree (including its inseparable factor).

## Main results

Height-one spectrum declarations live in `IsDedekindDomain.HeightOneSpectrum`, and the local
discrete-valuation-ring invariance corollaries live in `TauCeti`:

* `IsDedekindDomain.HeightOneSpectrum.sum_trace_adicCompletion_mul_smul_eq`: a trace-dual expansion
  of `L / K` remains one of `L_w / K_v`.
* `IsDedekindDomain.HeightOneSpectrum.traceDual_one_adicCompletionIntegers_eq_span` and
  `IsDedekindDomain.HeightOneSpectrum.dual_one_adicCompletionIntegers_eq_extended`: the completed
  complementary module is generated by the global one.
* `IsDedekindDomain.HeightOneSpectrum.differentIdeal_adicCompletionIntegers_eq_map` and
  `IsDedekindDomain.HeightOneSpectrum.differentIdeal_adicCompletionIntegersSemilocal`: the
  different ideal commutes with completion and with the integral semilocal decomposition.
* `IsDedekindDomain.HeightOneSpectrum.multiplicity_differentIdeal_adicCompletionIntegers` and
  `IsDedekindDomain.HeightOneSpectrum.differentIdeal_adicCompletionIntegers_eq_maximalIdeal_pow`:
  the completed different exponent is `multiplicity w.asIdeal (differentIdeal R B)`.
* `IsDedekindDomain.HeightOneSpectrum.length_traceDual_adicCompletionIntegers_quotient` and
  `IsDedekindDomain.HeightOneSpectrum.ord_discr_adicCompletionIntegers`: the completed
  complementary-module length and discriminant valuation equal `d(w ∣ v) · f(w ∣ v)` with no
  residue-separability hypothesis; for a local extension of discrete valuation rings,
  `TauCeti.length_traceDual_adicCompletionIntegers_quotient_eq` and
  `TauCeti.ord_discr_adicCompletionIntegers_eq` show both invariants are unchanged by completion.

## Provenance

The trace-dual and fractional-ideal comparison adapts the number-field argument in
`TauCeti.NumberTheory.NumberField.LocalGlobal.Different.Basic` from `𝓞 K ⊆ 𝓞 L` to an arbitrary
finite separable extension of Dedekind domains via the residue-unrestricted semilocal decomposition
of `TauCeti.RingTheory.DedekindDomain.AdicValuation.Semilocal`.

## References

* [J.-P. Serre, *Corps Locaux*][serre1968], Chapter III, §§3–4.
* [J. Neukirch, *Algebraic Number Theory*][Neukirch1992], Chapter III, Proposition (2.2).
-/

public section
noncomputable section

open TauCeti IsDedekindDomain TensorProduct
open scoped AdicCompletionExtension nonZeroDivisors

namespace IsDedekindDomain.HeightOneSpectrum

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
  {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]
  {B : Type*} [CommRing B] [IsDedekindDomain B] [Algebra R B]
  {L : Type*} [Field L] [Algebra K L] [Algebra R L] [IsScalarTower R K L]
  [Algebra B L] [IsFractionRing B L] [IsScalarTower R B L]
  [IsIntegralClosure B R L] [Module.IsTorsionFree R B]
  [FiniteDimensional K L] [Algebra.IsSeparable K L]
  (v : HeightOneSpectrum R) (w : HeightOneSpectrum B) [w.asIdeal.LiesOver v.asIdeal]

private abbrev primeAbove : {u : HeightOneSpectrum B // u.asIdeal.LiesOver v.asIdeal} :=
  ⟨w, inferInstance⟩

omit [Algebra R L] [IsScalarTower R K L] [IsIntegralClosure B R L]
  [Module.IsTorsionFree R B] [Algebra.IsSeparable K L] in
private theorem trace_tmul_mul_smul (a : v.adicCompletion K) (x b y : L) :
    Algebra.trace (v.adicCompletion K) (v.adicCompletion K ⊗[K] L)
        ((a ⊗ₜ x) * (1 ⊗ₜ b)) • ((1 : v.adicCompletion K) ⊗ₜ[K] y) =
      a ⊗ₜ[K] (Algebra.trace K L (x * b) • y) := by
  have ha : a ⊗ₜ[K] (x * b) = a • ((1 : v.adicCompletion K) ⊗ₜ[K] (x * b)) := by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ha, map_smul, Algebra.trace_baseChange_tmul]
  simp only [smul_eq_mul, TensorProduct.smul_tmul', mul_one, mul_comm a,
    ← Algebra.smul_def, TensorProduct.smul_tmul]

omit [Module.IsTorsionFree R B] in
/-- **Trace-dual expansions pass to completions.** If `x = ∑ᵢ Tr_{L/K}(x bᵢ) yᵢ` for every `x ∈ L`,
then `z = ∑ᵢ Tr_{L_w/K_v}(z bᵢ) yᵢ` for every `z ∈ L_w`. -/
theorem sum_trace_adicCompletion_mul_smul_eq {ι : Type*} [Fintype ι] (b y : ι → L)
    (h : ∀ x : L, ∑ i, Algebra.trace K L (x * b i) • y i = x) (z : w.adicCompletion L) :
    ∑ i, Algebra.trace (v.adicCompletion K) (w.adicCompletion L)
        (z * algebraMap L (w.adicCompletion L) (b i)) • algebraMap L (w.adicCompletion L) (y i) =
      z := by
  classical
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  have hF (ξ : v.adicCompletion K ⊗[K] L) :
      ∑ i, Algebra.trace (v.adicCompletion K) (v.adicCompletion K ⊗[K] L) (ξ * (1 ⊗ₜ b i)) •
        ((1 : v.adicCompletion K) ⊗ₜ[K] y i) = ξ := by
    induction ξ using TensorProduct.inductionOn with
    | add ξ η hξ hη =>
      conv_rhs => rw [← hξ, ← hη]
      simp only [add_mul, map_add, add_smul, Finset.sum_add_distrib]
    | tmul a x =>
      conv_rhs => rw [← h x, TensorProduct.tmul_sum]
      exact Finset.sum_congr rfl fun i _ ↦ trace_tmul_mul_smul v a x (b i) (y i)
  have h' := congrArg (fun ξ ↦ v.adicCompletionSemilocalEquiv K B L ξ (primeAbove v w))
    (hF ((v.adicCompletionSemilocalEquiv K B L).symm (Pi.single (primeAbove v w) z)))
  simp only [AlgEquiv.apply_symm_apply, Pi.single_eq_same, map_sum, map_smul,
    Finset.sum_apply, Pi.smul_apply, adicCompletionSemilocalEquiv_tmul, map_one, one_mul,
    trace_adicCompletionSemilocalEquiv_symm_single_mul] at h'
  exact h'

omit [Module.IsTorsionFree R B] in
private theorem trace_adicCompletionIntegersSemilocalToField_mul_mem {d : L}
    (hd : d ∈ Submodule.traceDual R K (1 : Submodule B L)) :
    haveI : Module.Finite R B := IsIntegralClosure.finite R K L B
    ∀ t : v.adicCompletionIntegers K ⊗[R] B,
      Algebra.trace (v.adicCompletion K) (v.adicCompletion K ⊗[K] L)
          (v.adicCompletionIntegersSemilocalToField K B L t * (1 ⊗ₜ d)) ∈
        (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K)).range := by
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  intro t
  induction t using TensorProduct.inductionOn with
  | add t u ht hu =>
    rw [map_add, add_mul, map_add]
    exact add_mem ht hu
  | tmul a x =>
    obtain ⟨r, hr⟩ := Submodule.mem_traceDual.mp hd _ (Submodule.mem_one.mpr ⟨x, rfl⟩)
    refine ⟨a * algebraMap R (v.adicCompletionIntegers K) r, ?_⟩
    rw [trace_adicCompletionIntegersSemilocalToField_tmul_mul, mul_comm (algebraMap B L x),
      ← Algebra.traceForm_apply, ← hr]
    simp only [map_mul, ValuationSubring.algebraMap_apply,
      algebraMap_adicCompletionIntegers_apply, algebraMap_adicCompletion,
      Function.comp_apply, Algebra.algebraMap_self_apply]

omit [Module.IsTorsionFree R B] in
private theorem algebraMap_mem_traceDual_adicCompletionIntegers {d : L}
    (hd : d ∈ Submodule.traceDual R K (1 : Submodule B L)) :
    algebraMap L (w.adicCompletion L) d ∈
      Submodule.traceDual (v.adicCompletionIntegers K) (v.adicCompletion K)
        (1 : Submodule (w.adicCompletionIntegers L) (w.adicCompletion L)) := by
  classical
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  rw [Submodule.mem_traceDual]
  intro _ hz
  obtain ⟨z, rfl⟩ := Submodule.mem_one.mp hz
  obtain ⟨t, ht⟩ :=
    (v.adicCompletionIntegersSemilocalEquiv K B L).surjective (Pi.single (primeAbove v w) z)
  have hξ : v.adicCompletionIntegersSemilocalToField K B L t =
      (v.adicCompletionSemilocalEquiv K B L).symm (Pi.single (primeAbove v w)
        (algebraMap (w.adicCompletionIntegers L) (w.adicCompletion L) z)) := by
    rw [AlgEquiv.eq_symm_apply, adicCompletionIntegersSemilocalEquiv_fieldCompatibility, ht]
    funext w'
    obtain rfl | hw' := eq_or_ne w' (primeAbove v w)
    · simp
    · simp [Pi.single_eq_of_ne hw']
  rw [Algebra.traceForm_apply, mul_comm,
    ← v.trace_adicCompletionSemilocalEquiv_symm_single_mul (B := B) w, ← hξ]
  exact trace_adicCompletionIntegersSemilocalToField_mul_mem v hd t

omit [Module.IsTorsionFree R B] in
/-- **The completed complementary module is spanned by the global one.** With no hypothesis on the
residue fields, the trace dual of `𝒪_w` over `𝒪_v` is the `𝒪_w`-span of the image of the trace dual
of `B` over `R`. -/
theorem traceDual_one_adicCompletionIntegers_eq_span :
    Submodule.traceDual (v.adicCompletionIntegers K) (v.adicCompletion K)
        (1 : Submodule (w.adicCompletionIntegers L) (w.adicCompletion L)) =
      Submodule.span (w.adicCompletionIntegers L)
        (algebraMap L (w.adicCompletion L) '' Submodule.traceDual R K (1 : Submodule B L)) := by
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  have : FaithfulSMul R B := FaithfulSMul.of_field_isFractionRing R B K L
  have : Module.IsTorsionFree R B :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr (FaithfulSMul.algebraMap_injective R B)
  have := Module.finitePresentation_of_finite R B
  have : Module.Projective R B := Module.Flat.projective_of_finitePresentation
  refine le_antisymm (fun z hz ↦ ?_) (Submodule.span_le.mpr ?_)
  · obtain ⟨n, b, y, hy, hb⟩ := exists_sum_trace_mul_smul_eq R K (L := L) (B := B)
    rw [← sum_trace_adicCompletion_mul_smul_eq v w (fun i ↦ algebraMap B L (b i)) y hb z]
    refine Submodule.sum_mem _ fun i _ ↦ ?_
    obtain ⟨c, hc⟩ := Submodule.mem_traceDual.mp hz _ (Submodule.mem_one.mpr
      ⟨_, (w.algebraMap_adicCompletion_eq_algebraMap_adicCompletionIntegers (b i)).symm⟩)
    rw [Algebra.traceForm_apply] at hc
    rw [← hc, algebraMap_smul]
    exact Submodule.smul_of_tower_mem _ c (Submodule.subset_span ⟨y i, hy i, rfl⟩)
  · rintro _ ⟨d, hd, rfl⟩
    exact algebraMap_mem_traceDual_adicCompletionIntegers v w hd

omit [Module.IsTorsionFree R B] in
/-- **Trace duals commute with adic completion** as fractional ideals. -/
theorem dual_one_adicCompletionIntegers_eq_extended :
    haveI : Module.Finite R B := IsIntegralClosure.finite R K L B
    haveI := finiteDimensional_adicCompletion_of_finite (K := K) (B := B) (L := L) v w
    haveI := isIntegralClosure_adicCompletionIntegers_of_finite (K := K) (B := B) (L := L) v w
    haveI := isSeparable_adicCompletion_of_isSeparable (K := K) (B := B) (L := L) v w
    FractionalIdeal.dual (v.adicCompletionIntegers K) (v.adicCompletion K)
        (1 : FractionalIdeal (w.adicCompletionIntegers L)⁰ (w.adicCompletion L)) =
      (FractionalIdeal.dual R K (1 : FractionalIdeal B⁰ L)).extended (w.adicCompletion L)
        (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
          (FaithfulSMul.algebraMap_injective B (w.adicCompletionIntegers L))) := by
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  have := finiteDimensional_adicCompletion_of_finite (K := K) (B := B) (L := L) v w
  have := isIntegralClosure_adicCompletionIntegers_of_finite (K := K) (B := B) (L := L) v w
  have := isSeparable_adicCompletion_of_isSeparable (K := K) (B := B) (L := L) v w
  have hmap : IsLocalization.map (S := L) (w.adicCompletion L)
      (algebraMap B (w.adicCompletionIntegers L))
      (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
        (FaithfulSMul.algebraMap_injective B (w.adicCompletionIntegers L))) =
      algebraMap L (w.adicCompletion L) := by
    refine IsFractionRing.ringHom_ext (A := B) fun x ↦ ?_
    rw [IsLocalization.map_eq, algebraMap_adicCompletion_eq_algebraMap_adicCompletionIntegers]
  have hdual : ((FractionalIdeal.dual R K (1 : FractionalIdeal B⁰ L)) : Set L) =
      Submodule.traceDual R K (1 : Submodule B L) := by
    ext x
    rw [SetLike.mem_coe, SetLike.mem_coe, ← FractionalIdeal.mem_coeToSubmodule,
      FractionalIdeal.coeToSubmodule_dual_one]
  rw [← FractionalIdeal.coeToSubmodule_inj, FractionalIdeal.coeToSubmodule_dual_one,
    FractionalIdeal.coeToSubmodule_extended_eq_span, hmap, hdual]
  exact traceDual_one_adicCompletionIntegers_eq_span v w

include K L in
/-- **The different ideal commutes with adic completion**, with no finiteness or separability
hypothesis on the residue fields: `𝔇(𝒪_w / 𝒪_v) = 𝔇(B / R) · 𝒪_w`. -/
theorem differentIdeal_adicCompletionIntegers_eq_map :
    differentIdeal (v.adicCompletionIntegers K) (w.adicCompletionIntegers L) =
      (differentIdeal R B).map (algebraMap B (w.adicCompletionIntegers L)) := by
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  have := moduleFinite_adicCompletionIntegers_of_finite (K := K) (B := B) (L := L) v w
  have := finiteDimensional_adicCompletion_of_finite (K := K) (B := B) (L := L) v w
  have := isIntegralClosure_adicCompletionIntegers_of_finite (K := K) (B := B) (L := L) v w
  have := isSeparable_adicCompletion_of_isSeparable (K := K) (B := B) (L := L) v w
  rw [← FractionalIdeal.coeIdeal_inj (K := w.adicCompletion L),
    ← FractionalIdeal.extended_coeIdeal_eq_map (K := L) (w.adicCompletion L)
      (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
        (FaithfulSMul.algebraMap_injective B (w.adicCompletionIntegers L))),
    ← FractionalIdeal.extendedHom'_apply, coeIdeal_differentIdeal R K L B,
    coeIdeal_differentIdeal (v.adicCompletionIntegers K) (v.adicCompletion K) (w.adicCompletion L)
      (w.adicCompletionIntegers L), map_inv₀, FractionalIdeal.extendedHom'_apply,
    dual_one_adicCompletionIntegers_eq_extended v w]

/-- **The different of the integral semilocal algebra, read componentwise.** Extending
`differentIdeal R B` to `𝒪_v ⊗[R] B` and transporting along `adicCompletionIntegersSemilocalEquiv`
yields the product of the completed different ideals above `v`. -/
theorem differentIdeal_adicCompletionIntegersSemilocal :
    haveI : Module.Finite R B := IsIntegralClosure.finite R K L B
    ((differentIdeal R B).map
        (Algebra.TensorProduct.includeRight :
          B →ₐ[R] v.adicCompletionIntegers K ⊗[R] B)).map
        (v.adicCompletionIntegersSemilocalEquiv K B L) =
      Ideal.pi fun u ↦
        differentIdeal (v.adicCompletionIntegers K) (u.1.adicCompletionIntegers L) := by
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  have hmap : ((differentIdeal R B).map
        (Algebra.TensorProduct.includeRight :
          B →ₐ[R] v.adicCompletionIntegers K ⊗[R] B)).map
        (v.adicCompletionIntegersSemilocalEquiv K B L) =
      (differentIdeal R B).map
        ((v.adicCompletionIntegersSemilocalEquiv K B L).toRingEquiv.toRingHom.comp
          (Algebra.TensorProduct.includeRight : B →ₐ[R] _).toRingHom) :=
    Ideal.map_map (Algebra.TensorProduct.includeRight : B →ₐ[R] _).toRingHom
      (v.adicCompletionIntegersSemilocalEquiv K B L).toRingEquiv.toRingHom
  rw [hmap]
  apply Ideal.piOrderIso.injective
  funext u
  simp only [Ideal.piOrderIso, OrderIso.symm_mk, RelIso.coe_fn_mk,
    Equiv.coe_fn_symm_mk, RingEquiv.toRingHom_eq_coe, AlgEquiv.toRingEquiv_toRingHom,
    AlgHom.toRingHom_eq_coe]
  rw [Ideal.map_evalRingHom_pi, Ideal.map_map,
    differentIdeal_adicCompletionIntegers_eq_map (K := K) (L := L) v u.1]
  congr 1
  ext x
  simp

include K L in
/-- **Completion preserves the different exponent**: the multiplicity of the maximal ideal of `𝒪_w`
in `𝔇(𝒪_w / 𝒪_v)` equals the multiplicity of `w` in `𝔇(B / R)`. -/
@[simp]
theorem multiplicity_differentIdeal_adicCompletionIntegers :
    multiplicity (IsLocalRing.maximalIdeal (w.adicCompletionIntegers L))
        (differentIdeal (v.adicCompletionIntegers K) (w.adicCompletionIntegers L)) =
      multiplicity w.asIdeal (differentIdeal R B) := by
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  rw [differentIdeal_adicCompletionIntegers_eq_map (K := K) (L := L) v w]
  exact w.multiplicity_map_adicCompletionIntegers (differentIdeal R B)
    (differentIdeal_ne_bot_of_isSeparable (K := K) (L := L))

include K L in
/-- **The completed different ideal as a power of the maximal ideal.** -/
theorem differentIdeal_adicCompletionIntegers_eq_maximalIdeal_pow :
    differentIdeal (v.adicCompletionIntegers K) (w.adicCompletionIntegers L) =
      IsLocalRing.maximalIdeal (w.adicCompletionIntegers L) ^
        multiplicity w.asIdeal (differentIdeal R B) := by
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  have := moduleFinite_adicCompletionIntegers_of_finite (K := K) (B := B) (L := L) v w
  have := finiteDimensional_adicCompletion_of_finite (K := K) (B := B) (L := L) v w
  have := isIntegralClosure_adicCompletionIntegers_of_finite (K := K) (B := B) (L := L) v w
  have := isSeparable_adicCompletion_of_isSeparable (K := K) (B := B) (L := L) v w
  have hD : differentIdeal (v.adicCompletionIntegers K) (w.adicCompletionIntegers L) ≠ ⊥ :=
    differentIdeal_ne_bot_of_isSeparable (K := v.adicCompletion K) (L := w.adicCompletion L)
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (w.adicCompletionIntegers L)
  obtain ⟨n, hn⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hD hϖ
  have hpow : differentIdeal (v.adicCompletionIntegers K) (w.adicCompletionIntegers L) =
      IsLocalRing.maximalIdeal (w.adicCompletionIntegers L) ^ n := by
    rw [hn, ← Ideal.span_singleton_pow, ← hϖ.maximalIdeal_eq]
  have hQ0 : IsLocalRing.maximalIdeal (w.adicCompletionIntegers L) ≠ ⊥ :=
    IsDiscreteValuationRing.not_a_field (w.adicCompletionIntegers L)
  have hn_eq : n = multiplicity w.asIdeal (differentIdeal R B) := by
    rw [← multiplicity_differentIdeal_adicCompletionIntegers (K := K) (L := L) v w, hpow,
      multiplicity_pow_self_of_prime (Ideal.prime_of_isPrime hQ0 inferInstance)]
  exact hn_eq ▸ hpow

/-- **The completed complementary-module length formula**, with no residue-separability or
residue-finiteness hypothesis: the `𝒪_v`-length of `C_w / 𝒪_w` equals
`multiplicity w (differentIdeal R B) * w.asIdeal.inertiaDeg R`. -/
theorem length_traceDual_adicCompletionIntegers_quotient :
    Module.length (v.adicCompletionIntegers K)
        ((Submodule.traceDual (v.adicCompletionIntegers K) (v.adicCompletion K)
            (1 : Submodule (w.adicCompletionIntegers L) (w.adicCompletion L))) ⧸
          (1 : Submodule (w.adicCompletionIntegers L) (w.adicCompletion L)).comap
            (Submodule.traceDual (v.adicCompletionIntegers K) (v.adicCompletion K)
              (1 : Submodule (w.adicCompletionIntegers L) (w.adicCompletion L))).subtype) =
      (multiplicity w.asIdeal (differentIdeal R B) : ℕ∞) * w.asIdeal.inertiaDeg R := by
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  have := v.moduleFinite_adicCompletionIntegers_of_finite (K := K) (L := L) w
  have := v.finiteDimensional_adicCompletion_of_finite (K := K) (L := L) w
  have := v.isIntegralClosure_adicCompletionIntegers_of_finite (K := K) (L := L) w
  have := v.isSeparable_adicCompletion_of_isSeparable (K := K) (L := L) w
  rw [length_traceDual_quotient_eq_multiplicity_mul_finrank,
    multiplicity_differentIdeal_adicCompletionIntegers (K := K) (L := L) v w,
    finrank_residueField_adicCompletionIntegers (K := K) (L := L) v w]

include K L in
/-- **The completed discriminant valuation formula**, with no residue-separability hypothesis: for
any `𝒪_v`-basis `b` of `𝒪_w`, `Ring.ord 𝒪_v (discr 𝒪_v b)` equals
`multiplicity w (differentIdeal R B) * w.asIdeal.inertiaDeg R`. -/
theorem ord_discr_adicCompletionIntegers {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b : Module.Basis ι (v.adicCompletionIntegers K) (w.adicCompletionIntegers L)) :
    Ring.ord (v.adicCompletionIntegers K) (Algebra.discr (v.adicCompletionIntegers K) b) =
      (multiplicity w.asIdeal (differentIdeal R B) : ℕ∞) * w.asIdeal.inertiaDeg R := by
  have : Module.Finite R B := IsIntegralClosure.finite R K L B
  have := v.isIntegralClosure_adicCompletionIntegers_of_finite (K := K) (L := L) w
  have := v.isSeparable_adicCompletion_of_isSeparable (K := K) (L := L) w
  rw [ord_discr_eq_multiplicity_mul_finrank (v.adicCompletion K) (w.adicCompletion L) b,
    multiplicity_differentIdeal_adicCompletionIntegers (K := K) (L := L) v w,
    finrank_residueField_adicCompletionIntegers (K := K) (L := L) v w]

end IsDedekindDomain.HeightOneSpectrum

namespace TauCeti

section DiscreteValuationRing

variable {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
  {K : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
  {B : Type*} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B]
  {L : Type*} [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
  [Algebra B L] [IsFractionRing B L] [IsScalarTower A B L]
  [IsIntegralClosure B A L] [Module.IsTorsionFree A B] [IsLocalHom (algebraMap A B)]
  [FiniteDimensional K L] [Algebra.IsSeparable K L]

omit [IsFractionRing A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
  [Algebra B L] [IsFractionRing B L] [IsScalarTower A B L]
  [IsIntegralClosure B A L] [Module.IsTorsionFree A B]
  [FiniteDimensional K L] [Algebra.IsSeparable K L] in
private theorem inertiaDeg_maximalIdeal_eq_finrank_residueField :
    haveI : (IsDiscreteValuationRing.maximalIdeal B).asIdeal.LiesOver
        (IsDiscreteValuationRing.maximalIdeal A).asIdeal :=
      ⟨(IsLocalRing.maximalIdeal_comap (algebraMap A B)).symm⟩
    (IsDiscreteValuationRing.maximalIdeal B).asIdeal.inertiaDeg A =
      Module.finrank (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B) := by
  let v := IsDiscreteValuationRing.maximalIdeal A
  let w := IsDiscreteValuationRing.maximalIdeal B
  have : w.asIdeal.LiesOver v.asIdeal :=
    ⟨(IsLocalRing.maximalIdeal_comap (algebraMap A B)).symm⟩
  rw [Ideal.inertiaDeg_eq_of_isMaximal v.asIdeal w.asIdeal]
  refine Algebra.finrank_eq_of_equiv_equiv (RingEquiv.refl _) (RingEquiv.refl _)
    (RingHom.ext fun x ↦ ?_)
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact (IsLocalRing.ResidueField.algebraMap_residue a).trans
    (Ideal.Quotient.algebraMap_mk_of_liesOver w.asIdeal v.asIdeal a).symm

/-- **Completing a local extension of discrete valuation rings preserves the complementary-module
length**, with no separability hypothesis on the residue fields. -/
theorem length_traceDual_adicCompletionIntegers_quotient_eq
    [Module.Finite (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B)] :
    haveI : (IsDiscreteValuationRing.maximalIdeal B).asIdeal.LiesOver
        (IsDiscreteValuationRing.maximalIdeal A).asIdeal :=
      ⟨(IsLocalRing.maximalIdeal_comap (algebraMap A B)).symm⟩
    Module.length ((IsDiscreteValuationRing.maximalIdeal A).adicCompletionIntegers K)
        ((Submodule.traceDual
            ((IsDiscreteValuationRing.maximalIdeal A).adicCompletionIntegers K)
            ((IsDiscreteValuationRing.maximalIdeal A).adicCompletion K)
            (1 : Submodule ((IsDiscreteValuationRing.maximalIdeal B).adicCompletionIntegers L)
              ((IsDiscreteValuationRing.maximalIdeal B).adicCompletion L))) ⧸
          (1 : Submodule ((IsDiscreteValuationRing.maximalIdeal B).adicCompletionIntegers L)
              ((IsDiscreteValuationRing.maximalIdeal B).adicCompletion L)).comap
            (Submodule.traceDual
              ((IsDiscreteValuationRing.maximalIdeal A).adicCompletionIntegers K)
              ((IsDiscreteValuationRing.maximalIdeal A).adicCompletion K)
              (1 : Submodule ((IsDiscreteValuationRing.maximalIdeal B).adicCompletionIntegers L)
                ((IsDiscreteValuationRing.maximalIdeal B).adicCompletion L))).subtype) =
      Module.length A
        ((Submodule.traceDual A K (1 : Submodule B L)) ⧸
          (1 : Submodule B L).comap (Submodule.traceDual A K (1 : Submodule B L)).subtype) := by
  let v := IsDiscreteValuationRing.maximalIdeal A
  let w := IsDiscreteValuationRing.maximalIdeal B
  have : w.asIdeal.LiesOver v.asIdeal :=
    ⟨(IsLocalRing.maximalIdeal_comap (algebraMap A B)).symm⟩
  rw [v.length_traceDual_adicCompletionIntegers_quotient (K := K) (L := L) w,
    length_traceDual_quotient_eq_multiplicity_mul_finrank,
    inertiaDeg_maximalIdeal_eq_finrank_residueField (A := A) (B := B)]
  rfl

include K L in
/-- **Completing a local extension of discrete valuation rings preserves the discriminant
valuation**, with no separability hypothesis on the residue fields. -/
theorem ord_discr_adicCompletionIntegers_eq {ι ι' : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype ι'] [DecidableEq ι'] (b : Module.Basis ι A B) :
    haveI : (IsDiscreteValuationRing.maximalIdeal B).asIdeal.LiesOver
        (IsDiscreteValuationRing.maximalIdeal A).asIdeal :=
      ⟨(IsLocalRing.maximalIdeal_comap (algebraMap A B)).symm⟩
    ∀ b' : Module.Basis ι' ((IsDiscreteValuationRing.maximalIdeal A).adicCompletionIntegers K)
        ((IsDiscreteValuationRing.maximalIdeal B).adicCompletionIntegers L),
      Ring.ord ((IsDiscreteValuationRing.maximalIdeal A).adicCompletionIntegers K)
          (Algebra.discr ((IsDiscreteValuationRing.maximalIdeal A).adicCompletionIntegers K) b') =
        Ring.ord A (Algebra.discr A b) := by
  let v := IsDiscreteValuationRing.maximalIdeal A
  let w := IsDiscreteValuationRing.maximalIdeal B
  have : w.asIdeal.LiesOver v.asIdeal :=
    ⟨(IsLocalRing.maximalIdeal_comap (algebraMap A B)).symm⟩
  intro b'
  rw [v.ord_discr_adicCompletionIntegers (K := K) (L := L) w b',
    ord_discr_eq_multiplicity_mul_finrank K L b,
    inertiaDeg_maximalIdeal_eq_finrank_residueField (A := A) (B := B)]
  rfl

end DiscreteValuationRing

