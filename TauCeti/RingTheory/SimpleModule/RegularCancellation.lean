module

public import Mathlib.LinearAlgebra.DirectSum.Finsupp
public import Mathlib.RingTheory.FiniteLength
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.TensorProduct.Basic
public import TauCeti.LinearAlgebra.TensorProduct.Quotient
public import TauCeti.RingTheory.KrullSchmidt.Cancellation

/-!
# Cancelling a regular summand of `S²`

Let `S` be a semisimple ring. If `v : S²` generates a copy of the regular module, that is, if
`x ↦ x v` is injective on `S`, then the quotient `S² / S v` is again isomorphic to `S`. The
submodule `S v` has a complement `Q` because every module over a semisimple ring is semisimple, so
that `S × Q ≃ S × S`; since `S` has finite length as a module over itself, the Krull–Schmidt
cancellation theorem gives `Q ≃ S`. For the group algebra `k[G]` of a finite group over a field
in which `#G` is invertible, the semisimplicity is Maschke's theorem.

The second result applies this after a flat base change. Let `A` be an algebra over a commutative
ring `R`, and `Q` a flat `R`-algebra such that `A ⊗[R] Q` is semisimple — `A = ℤ_p[G]` and
`Q = ℚ_p` for a finite group `G`, say. If `v : A²` generates a copy of `A`, then the base change
`(A² / A v) ⊗[R] Q` is isomorphic to `A ⊗[R] Q` as a left `A`-module: tensoring is right exact,
so the base change of `A² / A v` is `(A ⊗[R] Q)² / (A ⊗[R] Q) v`, and flatness carries the
injectivity of `x ↦ x v` to `A ⊗[R] Q`, where the first result applies.

## Main statements

* `TauCeti.nonempty_quotient_span_singleton_linearEquiv_of_injective`: over a semisimple ring,
  the quotient of `S²` by an injectively generated singleton relation is linearly equivalent to
  `S`.
* `TauCeti.nonempty_quotient_span_singleton_tensor_linearEquiv_of_injective`: the base change of
  `A² / A v` along a flat `R`-algebra `Q` with `A ⊗[R] Q` semisimple is `A ⊗[R] Q`.
-/

public section

namespace TauCeti

open _root_.TensorProduct

section Semisimple

variable {S : Type*} [Ring S] [IsSemisimpleRing S]

/-- Let `S` be a semisimple ring. If the singleton relation generated by `v : S²` is a copy of the
regular module, then its quotient is also linearly equivalent to the regular module. -/
theorem nonempty_quotient_span_singleton_linearEquiv_of_injective (v : Fin 2 →₀ S)
    (hinj : Function.Injective (LinearMap.toSpanSingleton S (Fin 2 →₀ S) v)) :
    Nonempty (((Fin 2 →₀ S) ⧸ Submodule.span S {v}) ≃ₗ[S] S) := by
  let V := Fin 2 →₀ S
  let N : Submodule S V := Submodule.span S {v}
  obtain ⟨Q, hNQ⟩ := exists_isCompl N
  let eN : S ≃ₗ[S] N :=
    (LinearEquiv.ofInjective (LinearMap.toSpanSingleton S V v) hinj).trans
      (LinearEquiv.ofEq _ _ (LinearMap.range_toSpanSingleton v))
  let eV : V ≃ₗ[S] S × S :=
    (Finsupp.linearEquivFunOnFinite S S (Fin 2)).trans (LinearEquiv.finTwoArrow S S)
  let eProd :=
    (eN.prodCongr (LinearEquiv.refl S Q)).trans
      ((Submodule.prodEquivOfIsCompl N Q hNQ).trans eV)
  have hS : IsFiniteLength S S := by
    apply (IsSemisimpleModule.finite_tfae (R := S) (M := S)).out 1 4 |>.mp
    infer_instance
  obtain ⟨eQ⟩ := nonempty_linearEquiv_of_prod_linearEquiv_of_isFiniteLength
    (A := S) (M := Q) (N := S) (P := S) hS
    ⟨(LinearEquiv.prodComm S Q S).trans eProd⟩
  exact ⟨(N.quotientEquivOfIsCompl Q hNQ).trans eQ⟩

end Semisimple

section BaseChange

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]

/-- **Cancelling a regular summand after a flat base change.** Let `A` be an algebra over the
commutative ring `R`, and `Q` a flat `R`-algebra such that `A ⊗[R] Q` is a semisimple ring. If
`v : A²` generates a copy of `A`, then the base change `(A² ⧸ A v) ⊗[R] Q` is isomorphic to
`A ⊗[R] Q` as a left `A`-module. -/
theorem nonempty_quotient_span_singleton_tensor_linearEquiv_of_injective (Q : Type*) [Ring Q]
    [Algebra R Q] [Module.Flat R Q] [IsSemisimpleRing (A ⊗[R] Q)] (v : Fin 2 →₀ A)
    (hinj : Function.Injective (LinearMap.toSpanSingleton A (Fin 2 →₀ A) v)) :
    Nonempty ((((Fin 2 →₀ A) ⧸ Submodule.span A {v}) ⊗[R] Q) ≃ₗ[A] A ⊗[R] Q) := by
  let f : A →ₗ[A] (Fin 2 →₀ A) := LinearMap.toSpanSingleton A (Fin 2 →₀ A) v
  let e := finsuppLeft R A A Q (Fin 2)
  let vQ : Fin 2 →₀ A ⊗[R] Q := e (v ⊗ₜ 1)
  -- The base change of `x ↦ x v` is `y ↦ y vQ`.
  have hcomp (x : A ⊗[R] Q) : e (AlgebraTensorModule.rTensor R Q f x) = x • vQ := by
    induction x using TensorProduct.inductionOn with
    | tmul a q =>
      ext i
      simp [vQ, e, f, LinearMap.toSpanSingleton_apply, Algebra.TensorProduct.tmul_mul_tmul]
    | add x y hx hy => simp only [map_add, hx, hy, add_smul]
  -- Flatness carries the injectivity of `x ↦ x v` to `y ↦ y vQ`.
  have hinjQ :
      Function.Injective (LinearMap.toSpanSingleton (A ⊗[R] Q) (Fin 2 →₀ A ⊗[R] Q) vQ) := by
    have hfun : ⇑(LinearMap.toSpanSingleton (A ⊗[R] Q) (Fin 2 →₀ A ⊗[R] Q) vQ) =
        e ∘ AlgebraTensorModule.rTensor R Q f :=
      funext fun x ↦ by rw [LinearMap.toSpanSingleton_apply, Function.comp_apply, hcomp]
    rw [hfun]
    exact e.injective.comp
      (Module.Flat.rTensor_preserves_injective_linearMap (f.restrictScalars R) hinj)
  obtain ⟨c⟩ := nonempty_quotient_span_singleton_linearEquiv_of_injective vQ hinjQ
  -- `e` carries the range of the base change of `f` to the relation submodule `(A ⊗[R] Q) vQ`.
  have hmap : (LinearMap.range (AlgebraTensorModule.rTensor R Q f)).map
      (e : (Fin 2 →₀ A) ⊗[R] Q →ₗ[A] Fin 2 →₀ A ⊗[R] Q) =
        (Submodule.span (A ⊗[R] Q) {vQ}).restrictScalars A := by
    ext y
    simp only [Submodule.mem_map, LinearMap.mem_range, Submodule.restrictScalars_mem,
      Submodule.mem_span_singleton]
    constructor
    · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
      exact ⟨x, (hcomp x).symm⟩
    · rintro ⟨x, rfl⟩
      exact ⟨_, ⟨x, rfl⟩, hcomp x⟩
  exact ⟨(AlgebraTensorModule.congr
    (Submodule.quotEquivOfEq _ _ (LinearMap.range_toSpanSingleton v).symm)
    (LinearEquiv.refl R Q)).trans ((AlgebraTensorModule.quotientRangeTensorEquiv f).trans
      ((Submodule.Quotient.equiv _ _ e hmap).trans
        ((Submodule.Quotient.restrictScalarsEquiv A _).trans (c.restrictScalars A))))⟩

end BaseChange

end TauCeti
