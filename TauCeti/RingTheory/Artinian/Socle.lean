module

public import Mathlib.RingTheory.Artinian.Ring

/-!
# Vectors killed by an ideal, and characters of Artinian algebras

If some power of an ideal `I` kills a nonzero module, then a nonzero vector is killed by `I`
itself: take the last nonzero term of the chain `N ⊇ I • N ⊇ I ^ 2 • N ⊇ ⋯`. Over a commutative
Artinian ring `H` this applies to the maximal ideals. The nilradical of `H` is nilpotent and is
the intersection of the finitely many maximal ideals, so for a maximal ideal `m` the product `Q`
of the powers `m' ^ n` of the other maximal ideals satisfies `m ^ n * Q = 0`. When `m` contains
the annihilator of `V`, the submodule `Q • V` is nonzero, and the first step produces a nonzero
vector of `V` killed by `m`. No finiteness of `V` is needed.

For a commutative Artinian algebra `H` over `k` acting on `V`, this says that every character
`χ : H →ₐ[k] k` vanishing on the annihilator of `V` occurs on `V`: some nonzero `v` satisfies
`h • v = χ h • v` for every `h`. In particular every character occurs on a faithful module. No
semisimplicity of the action is needed. This is the occurrence step of the Deligne–Serre lifting
lemma, applied to the commutative operator algebra generated by Hecke operators.

## Main results

* `Submodule.exists_mem_ne_zero_forall_smul_eq_zero_of_pow_smul_eq_bot`: if `I ^ n • N = ⊥` for a
  nonzero submodule `N`, then `N` contains a nonzero vector killed by `I`.
* `Ideal.exists_ne_zero_forall_smul_eq_zero_of_isNilpotent`: a nilpotent ideal kills some nonzero
  vector of every nontrivial module.
* `IsArtinianRing.exists_ne_zero_forall_smul_eq_zero_of_annihilator_le`: over a commutative
  Artinian ring, every proper ideal containing the annihilator of `V` kills a nonzero vector of
  `V`.
* `AlgHom.exists_ne_zero_forall_smul_eq_smul_of_annihilator_le`,
  `AlgHom.exists_ne_zero_forall_smul_eq_smul`: a character of a commutative Artinian algebra
  vanishing on the annihilator of `V`, for instance any character when `V` is faithful, has a
  nonzero eigenvector in `V`.

## References

* P. Deligne and J.-P. Serre, *Formes modulaires de poids 1*, Ann. Sci. ENS 7 (1974),
  Lemme 6.11 and its proof.
* M. F. Atiyah and I. G. Macdonald, *Introduction to commutative algebra*, Chapter 8.
-/

public section

section Socle

variable {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]

/-- If a power of the ideal `I` kills the nonzero submodule `N`, then `N` contains a nonzero
vector killed by `I`. -/
theorem Submodule.exists_mem_ne_zero_forall_smul_eq_zero_of_pow_smul_eq_bot {I : Ideal R}
    {N : Submodule R M} {n : ℕ} (hIN : I ^ n • N = ⊥) (hN : N ≠ ⊥) :
    ∃ v ∈ N, v ≠ 0 ∧ ∀ a ∈ I, a • v = 0 := by
  induction n generalizing N with
  | zero => simp_all
  | succ n ih =>
    by_cases h : I • N = ⊥
    · obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff N).1 hN
      refine ⟨v, hv, hv0, fun a ha ↦ ?_⟩
      simpa [h] using Submodule.smul_mem_smul ha hv
    · rw [pow_succ, Submodule.mul_smul] at hIN
      obtain ⟨v, hv, hv0, hvI⟩ := ih hIN h
      exact ⟨v, Submodule.smul_le_right hv, hv0, hvI⟩

/-- A nilpotent ideal kills some nonzero vector of every nontrivial module. -/
theorem Ideal.exists_ne_zero_forall_smul_eq_zero_of_isNilpotent [Nontrivial M] {I : Ideal R}
    (hI : IsNilpotent I) : ∃ v : M, v ≠ 0 ∧ ∀ a ∈ I, a • v = 0 := by
  obtain ⟨n, hn⟩ := hI
  obtain ⟨v, -, hv⟩ := Submodule.exists_mem_ne_zero_forall_smul_eq_zero_of_pow_smul_eq_bot
    (N := (⊤ : Submodule R M)) (by rw [hn, Ideal.zero_eq_bot, Submodule.bot_smul]) top_ne_bot
  exact ⟨v, hv⟩

end Socle

section Artinian

variable {H V : Type*} [CommRing H] [IsArtinianRing H] [AddCommGroup V] [Module H V]

/-- Over a commutative Artinian ring, every proper ideal containing the annihilator of a module
`V` kills some nonzero vector of `V`. The module `V` need not be finitely generated. -/
theorem IsArtinianRing.exists_ne_zero_forall_smul_eq_zero_of_annihilator_le {I : Ideal H}
    (hI : I ≠ ⊤) (hann : Module.annihilator H V ≤ I) : ∃ v : V, v ≠ 0 ∧ ∀ a ∈ I, a • v = 0 := by
  classical
  have : Fintype (MaximalSpectrum H) := Fintype.ofFinite _
  obtain ⟨m, hm, hIm⟩ := Ideal.exists_le_maximal I hI
  obtain ⟨n, hn⟩ := IsArtinianRing.isNilpotent_nilradical H
  -- `Q` is the product of the `n`-th powers of the maximal ideals other than `m`.
  let s : Finset (MaximalSpectrum H) := Finset.univ.filter fun m' ↦ m'.asIdeal ≠ m
  let Q : Ideal H := ∏ m' ∈ s, m'.asIdeal ^ n
  -- `m ^ n * Q` lies in every `m' ^ n`, hence in the `n`-th power of the nilradical, which is zero.
  have hmQ : m ^ n * Q = ⊥ := by
    refine eq_bot_iff.2 ?_
    rw [← Ideal.zero_eq_bot, ← hn, IsArtinianRing.nilradical_pow_eq_iInf]
    refine le_iInf fun m' ↦ ?_
    by_cases hm' : m'.asIdeal = m
    · exact hm' ▸ Ideal.mul_le_left
    · exact Ideal.mul_le_right.trans <| Ideal.prod_le_inf.trans <|
        Finset.inf_le (Finset.mem_filter.2 ⟨Finset.mem_univ _, hm'⟩)
  -- `Q` does not lie in `m`, since no other maximal ideal does, so `Q` does not kill `V`.
  have hQ : Q • (⊤ : Submodule H V) ≠ ⊥ := by
    intro hQ
    rw [← Submodule.le_annihilator_iff, Submodule.annihilator_top] at hQ
    have hQm : Q ≤ m := hQ.trans (hann.trans hIm)
    obtain ⟨m', hm's, hm'm⟩ := hm.isPrime.prod_le.1 hQm
    exact (Finset.mem_filter.1 hm's).2 <|
      m'.isMaximal.eq_of_le hm.ne_top (hm.isPrime.le_of_pow_le hm'm)
  obtain ⟨v, -, hv0, hv⟩ := Submodule.exists_mem_ne_zero_forall_smul_eq_zero_of_pow_smul_eq_bot
    (I := m) (by rw [← Submodule.mul_smul, hmQ, Submodule.bot_smul]) hQ
  exact ⟨v, hv0, fun a ha ↦ hv a (hIm ha)⟩

variable {k : Type*} [CommRing k] [Nontrivial k] [Algebra k H] [Module k V] [IsScalarTower k H V]

/-- **Occurrence of characters.** Let `H` be a commutative Artinian `k`-algebra acting on `V`.
Every character `χ : H →ₐ[k] k` vanishing on the annihilator of `V` occurs on `V`: some nonzero
`v` satisfies `h • v = χ h • v` for every `h : H`. The module `V` need not be finitely generated,
and the action need not be semisimple. -/
theorem AlgHom.exists_ne_zero_forall_smul_eq_smul_of_annihilator_le (χ : H →ₐ[k] k)
    (hχ : Module.annihilator H V ≤ RingHom.ker χ) : ∃ v : V, v ≠ 0 ∧ ∀ h : H, h • v = χ h • v := by
  obtain ⟨v, hv0, hv⟩ :=
    IsArtinianRing.exists_ne_zero_forall_smul_eq_zero_of_annihilator_le (RingHom.ker_ne_top χ) hχ
  refine ⟨v, hv0, fun h ↦ ?_⟩
  have hmem : h - algebraMap k H (χ h) ∈ RingHom.ker χ := by simp [RingHom.mem_ker]
  rw [← algebraMap_smul H (χ h) v, ← sub_eq_zero, ← sub_smul]
  exact hv _ hmem

/-- **Occurrence of characters on a faithful module.** Every character `χ : H →ₐ[k] k` of a
commutative Artinian `k`-algebra `H` occurs on every faithful `H`-module `V`: some nonzero `v`
satisfies `h • v = χ h • v` for every `h : H`. -/
theorem AlgHom.exists_ne_zero_forall_smul_eq_smul [FaithfulSMul H V] (χ : H →ₐ[k] k) :
    ∃ v : V, v ≠ 0 ∧ ∀ h : H, h • v = χ h • v :=
  χ.exists_ne_zero_forall_smul_eq_smul_of_annihilator_le <| by
    simp [Module.annihilator_eq_bot.2 ‹_›]

end Artinian
