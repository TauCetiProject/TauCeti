/-!
# Dimensions over a field of modules over a finite algebra, computed locally

Let `A` be a finite algebra over a field `k`. Then `A` is Artinian, hence the product of its
finitely many localizations `A_q` at primes, so every `A`-module `M` is the product of the
`A_q ⊗[A] M`, and its `k`-dimension is the sum of theirs
(`TauCeti.Module.finrank_eq_finsum_finrank_localization_tensorProduct`). For a quotient `A ⧸ 𝔞`
the factors are the quotients `A_q ⧸ 𝔞 A_q` (`Ideal.finrank_quotient_eq_finsum`).

The second half of the file is a local-to-global criterion for the additivity
`dim A = dim (A ⧸ 𝔞) + dim (A ⧸ 𝔟)`. Over any finite-dimensional `k`-algebra `L`, multiplication
by `a` identifies `L ⧸ Ann(a)` with the principal ideal `(a)`, so
`dim L = dim (L ⧸ (a)) + dim (L ⧸ Ann(a))`
(`TauCeti.finrank_quotient_span_singleton_add_finrank_quotient_annihilator`). Hence if, at every
prime `q` of `A`, the ideal `𝔞 A_q` is generated by an element `a` whose annihilator is `𝔟 A_q`,
then summing over the primes gives `dim (A ⧸ 𝔞) + dim (A ⧸ 𝔟) = dim A`
(`TauCeti.finrank_quotient_add_finrank_quotient_of_forall`).

Geometrically, for effective Cartier divisors `D` and `E` with local equations `a` and `b`, the
ideal of `D` in `D + E` is locally `(a) ⊆ 𝒪 ⧸ (ab)`, whose annihilator is `(b)`, the ideal of
`E`. The criterion therefore says that the degree of a finite divisor `D + E` over a field is the
sum of the degrees of `D` and `E`.

## References

* [Stacks Project, Tag 00JA](https://stacks.math.columbia.edu/tag/00JA): an Artinian ring is the
  product of its localizations at its maximal ideals.
-/

public section

open Module TensorProduct

namespace TauCeti

namespace Module

variable (k : Type*) {A : Type*} (M : Type*) [Field k] [CommRing A] [Algebra k A]
  [Module.Finite k A] [AddCommGroup M] [Module A M] [Module k M] [IsScalarTower k A M]
  [Module.Finite A M]

/-- Over a finite algebra `A` over a field `k`, the `k`-dimension of a finite `A`-module `M` is
the sum, over the finitely many primes `q` of `A`, of the `k`-dimensions of the localizations
`A_q ⊗[A] M`. -/
theorem finrank_eq_finsum_finrank_localization_tensorProduct :
    finrank k M = ∑ᶠ q : PrimeSpectrum A, finrank k (Localization.AtPrime q.asIdeal ⊗[A] M) := by
  classical
  have : IsArtinianRing A := IsArtinianRing.of_finite k A
  have := Fintype.ofFinite (PrimeSpectrum A)
  -- `A` is the product of its localizations, so `M` is the product of the `A_q ⊗[A] M`.
  let e : M ≃ₗ[A] ∀ q : PrimeSpectrum A, Localization.AtPrime q.asIdeal ⊗[A] M :=
    (TensorProduct.lid A M).symm ≪≫ₗ
      TensorProduct.congr (PrimeSpectrum.toPiLocalizationEquiv A).toLinearEquiv (.refl A M) ≪≫ₗ
      TensorProduct.piLeft (R := A) (N := M)
        (M := fun q : PrimeSpectrum A ↦ Localization.AtPrime q.asIdeal)
  have : Module.Finite k (∀ q : PrimeSpectrum A, Localization.AtPrime q.asIdeal ⊗[A] M) :=
    have : Module.Finite k M := .trans A M
    .equiv (e.restrictScalars k)
  have (q : PrimeSpectrum A) : Module.Finite k (Localization.AtPrime q.asIdeal ⊗[A] M) :=
    .of_surjective (LinearMap.proj (R := k)
      (φ := fun q : PrimeSpectrum A ↦ Localization.AtPrime q.asIdeal ⊗[A] M) q)
      (Function.surjective_eval q)
  rw [(e.restrictScalars k).finrank_eq, Module.finrank_pi_fintype, finsum_eq_sum_of_fintype]

end Module

end TauCeti

namespace Ideal

variable (k : Type*) {A : Type*} [Field k] [CommRing A] [Algebra k A] [Module.Finite k A]

/-- Over a finite algebra `A` over a field `k`, the `k`-dimension of a quotient `A ⧸ 𝔞` is the
sum, over the primes `q` of `A`, of the `k`-dimensions of the local quotients `A_q ⧸ 𝔞 A_q`. -/
theorem finrank_quotient_eq_finsum (𝔞 : Ideal A) :
    finrank k (A ⧸ 𝔞) = ∑ᶠ q : PrimeSpectrum A,
      finrank k (Localization.AtPrime q.asIdeal ⧸
        𝔞.map (algebraMap A (Localization.AtPrime q.asIdeal))) := by
  rw [TauCeti.Module.finrank_eq_finsum_finrank_localization_tensorProduct k (A := A)
    (A ⧸ 𝔞)]
  refine finsum_congr fun q ↦ ?_
  exact ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.AtPrime q.asIdeal)
    𝔞).toLinearEquiv.restrictScalars k).finrank_eq.symm

end Ideal

namespace TauCeti

/-- **Multiplication by `a` splits a finite-dimensional algebra.** Over a finite-dimensional
commutative `k`-algebra `L`, multiplication by `a` identifies `L ⧸ Ann(a)` with the principal ideal
`(a)`, so `dim L = dim (L ⧸ (a)) + dim (L ⧸ Ann(a))`. -/
theorem finrank_quotient_span_singleton_add_finrank_quotient_annihilator {k L : Type*} [Field k]
    [CommRing L] [Algebra k L] [Module.Finite k L] (a : L) :
    finrank k (L ⧸ Ideal.span {a}) + finrank k (L ⧸ (Ideal.span {a}).annihilator) =
      finrank k L := by
  let μ : L →ₗ[k] L := LinearMap.mulLeft k a
  have hrange : LinearMap.range μ = (Ideal.span {a}).restrictScalars k := by
    ext x
    simp [μ, Ideal.mem_span_singleton', mul_comm, eq_comm]
  have hker : LinearMap.ker μ = ((Ideal.span {a}).annihilator).restrictScalars k := by
    ext x
    simp [μ, Ideal.span, Submodule.mem_annihilator_span_singleton, mul_comm]
  have h := LinearMap.finrank_range_add_finrank_ker μ
  have h𝔞 := ((Ideal.span {a}).restrictScalars k).finrank_quotient_add_finrank
  have h𝔟 := (((Ideal.span {a}).annihilator).restrictScalars k).finrank_quotient_add_finrank
  rw [hrange, hker] at h
  rw [← (Submodule.Quotient.restrictScalarsEquiv k (Ideal.span {a})).finrank_eq,
    ← (Submodule.Quotient.restrictScalarsEquiv k (Ideal.span {a}).annihilator).finrank_eq]
  omega

/-- **A local criterion for additivity of dimensions.** Let `A` be a finite algebra over a field
`k`, and let `𝔞` and `𝔟` be ideals of `A`. Suppose that for every prime `q` of `A`, in some
localization `L q` of `A` at `q`, the ideal `𝔞 L q` is generated by an element `a` whose
annihilator is `𝔟 L q`. Then `dim (A ⧸ 𝔞) + dim (A ⧸ 𝔟) = dim A`. -/
theorem finrank_quotient_add_finrank_quotient_of_forall {k A : Type*} [Field k] [CommRing A]
    [Algebra k A] [Module.Finite k A] (𝔞 𝔟 : Ideal A) (L : PrimeSpectrum A → Type*)
    [∀ q, CommRing (L q)] [∀ q, Algebra A (L q)] [∀ q, IsLocalization.AtPrime (L q) q.asIdeal]
    (h : ∀ q : PrimeSpectrum A, ∃ a : L q, 𝔞.map (algebraMap A (L q)) = Ideal.span {a} ∧
      𝔟.map (algebraMap A (L q)) = (Ideal.span {a}).annihilator) :
    finrank k (A ⧸ 𝔞) + finrank k (A ⧸ 𝔟) = finrank k A := by
  have : IsArtinianRing A := IsArtinianRing.of_finite k A
  rw [_root_.Ideal.finrank_quotient_eq_finsum, _root_.Ideal.finrank_quotient_eq_finsum,
    ← finsum_add_distrib (Set.toFinite _) (Set.toFinite _),
    Module.finrank_eq_finsum_finrank_localization_tensorProduct k (A := A) A]
  refine finsum_congr fun q ↦ ?_
  -- Each localization `A_q` is a quotient of `A`, hence finite-dimensional.
  have : Module.Finite k (Localization.AtPrime q.asIdeal) :=
    .of_surjective (IsScalarTower.toAlgHom k A (Localization.AtPrime q.asIdeal)).toLinearMap
      (IsArtinianRing.localization_surjective q.asIdeal.primeCompl _)
  obtain ⟨a, ha, hb⟩ := h q
  obtain ⟨ha, hb⟩ :=
    (IsLocalization.algEquiv q.asIdeal.primeCompl (Localization.AtPrime q.asIdeal)
      (L q)).map_eq_span_singleton_and_annihilator ha hb
  rw [ha, hb, finrank_quotient_span_singleton_add_finrank_quotient_annihilator,
    ((TensorProduct.AlgebraTensorModule.rid A (Localization.AtPrime q.asIdeal)
      (Localization.AtPrime q.asIdeal)).restrictScalars k).finrank_eq]

end TauCeti
