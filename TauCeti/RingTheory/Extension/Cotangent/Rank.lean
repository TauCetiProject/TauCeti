/-!
# Fibres of conormal modules at field-valued points

Let `P` present an `R`-algebra `S` as a quotient of a polynomial ring `R[x₁, …, x_m]` by an ideal
`I`, and let `S → F` be a field-valued point. The dimension of the fibre `F ⊗[S] I/I²` of the
conormal module `I/I²` is, when `I` is finitely generated (by Nakayama's lemma), the minimal
number of generators of `I` near that point. This file compares it across presentations.

* If `S` also has a presentation with `m'` generators and `c'` relations, then
  `dim F ⊗[S] I/I² + m' ≤ c' + m` (`Algebra.Generators.finrank_tensor_cotangent_add_card_le`).
  Thus `dim F ⊗[S] I/I² - m` is bounded by the number of relations minus the number of generators
  of any presentation; in particular a presentation of `S` by `n + c'` generators and `c'`
  relations forces `I` to need at most `m - n` generators near every point.
* Inverting an element `g` of `S` by one more generator `y` and one more relation `g y - 1` raises
  the dimension of the fibre by one
  (`Algebra.Generators.finrank_tensor_cotangent_comp_localizationAway`).
* The fibre of `I/I²` over `S` is the fibre of `I` over `R[x₁, …, x_m]`
  (`Algebra.Generators.finrank_tensor_cotangent`).

The first statement compares `P` with the presentation `R[x, z] → S` combining the generators of
`P` and the generators `z` of the other presentation. Its kernel is generated by the relations in
the `z` together with one relation `x_i - φ_i(z)` for each `x_i`, which gives at most `c' + m`
generators of its conormal module (`Algebra.Generators.exists_surjective_cotangent_extend`).
Conversely, sending `z_j` to a lift of its image in `R[x]` and reading off the coefficients of
`d z_j` maps this conormal module onto `I/I² × S^{m'}`
(`Algebra.Generators.surjective_cotangentMap_prod_cotangentRestrict_extend`).

These are the counts behind the independence of the complete-intersection property from the
chosen presentation.

## References

* The Stacks Project, Commutative Algebra, Section *Syntomic morphisms* (relative global complete
  intersections) and Section *The naive cotangent complex*.
-/

public section

open TensorProduct MvPolynomial

namespace Algebra.Generators

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {ι : Type*}

/-- The fibre of the conormal module `I/I²` of a presentation `P` at a field-valued point of `S`
is the fibre of the kernel `I` at the induced point of the polynomial ring. -/
theorem finrank_tensor_cotangent (P : Generators R S ι) (F : Type*) [Field F] [Algebra S F]
    [Algebra P.Ring F] [IsScalarTower P.Ring S F] :
    Module.finrank F (F ⊗[S] P.toExtension.Cotangent) =
      Module.finrank F (F ⊗[P.Ring] P.ker) := by
  rw [← (P.toExtension.cotangentEquiv.baseChange S F _ _).finrank_eq]
  exact (AlgebraTensorModule.cancelBaseChange P.Ring S F F P.ker).finrank_eq

/-- Extend a presentation `P` of `S` by the generators of a second presentation `P'` with relations
indexed by `σ`. The conormal module of the extended presentation is generated by `#ι + #σ`
elements: the relations of `P'`, and one relation eliminating each generator of `P`. -/
theorem exists_surjective_cotangent_extend (P : Generators R S ι) [Finite ι] {ι' σ : Type*}
    [Finite σ] (P' : Presentation R S ι' σ) :
    ∃ γ : (ι ⊕ σ → S) →ₗ[S] (P.extend P'.val).toExtension.Cotangent, Function.Surjective γ := by
  classical
  have := Fintype.ofFinite ι
  have := Fintype.ofFinite σ
  let E := P.extend P'.val
  obtain ⟨G, hG⟩ := P'.exists_ker_eq_span_range (fun _ ↦ 1) (ψ := aeval E.val)
    (by ext j; simp [E])
  have hG' : Ideal.span (Set.range G) = E.ker := by rw [E.ker_eq_ker_aeval_val, hG]
  refine ⟨Fintype.linearCombination S
    fun l ↦ Extension.Cotangent.mk ⟨G l, hG'.le (Ideal.subset_span ⟨l, rfl⟩)⟩, ?_⟩
  rw [← LinearMap.range_eq_top, Fintype.range_linearCombination]
  exact Extension.Cotangent.span_eq_top_of_span_eq_ker (P := E.toExtension) G hG'

/-- Let `E` extend generators `P` of `S` by new generators `z_j` with values `v j`, and let
`r : E → P` be a map of generators fixing the generators of `P`. Then the map induced by `r` on
conormal modules, together with the coefficients of the `d z_j`, maps the conormal module of `E`
onto `I/I² × S^{ι'}`, where `I` is the kernel of `P`. -/
theorem surjective_cotangentMap_prod_cotangentRestrict_extend (P : Generators R S ι)
    {ι' : Type*} [Finite ι'] (v : ι' → S) (r : (P.extend v).Hom P)
    (hr : ∀ i, r.val (Sum.inl i) = X i) :
    Function.Surjective ((Extension.Cotangent.map r.toExtensionHom).prod
      ((P.extend v).cotangentRestrict Sum.inr_injective)) := by
  classical
  have := Fintype.ofFinite ι'
  have hpderiv : ∀ (y : P.Ring) (j : ι'), pderiv (Sum.inr j) (rename Sum.inl y) = 0 :=
    fun y j ↦ pderiv_eq_zero_of_notMem_vars fun h ↦ by
      obtain ⟨i, -, hi⟩ := Finset.mem_image.mp (vars_rename _ _ h)
      exact Sum.inl_ne_inr hi
  -- Elements `y` of `I` give elements `y'` of the kernel of `E` with no `d z_j` components.
  obtain ⟨incl, hincl⟩ : ∃ incl : P.ker → (P.extend v).ker,
      ∀ y, (incl y).1 = rename Sum.inl y.1 :=
    ⟨fun y ↦ ⟨rename Sum.inl y.1, by
      rw [ker_eq_ker_aeval_val, RingHom.mem_ker, MvPolynomial.aeval_rename]
      exact P.aeval_val_eq_zero y.2⟩, fun _ ↦ rfl⟩
  have h1 : ∀ y, Extension.Cotangent.map r.toExtensionHom (Extension.Cotangent.mk (incl y)) =
      Extension.Cotangent.mk y := fun y ↦ by
    refine (Extension.Cotangent.map_mk _ _).trans (congrArg _ (Subtype.ext ?_))
    rw [Subtype.coe_mk, Hom.toExtensionHom_toAlgHom_apply, Hom.toAlgHom, hincl,
      MvPolynomial.aeval_rename]
    exact congrArg (aeval · y.1) (funext hr) |>.trans (aeval_X_left_apply _)
  have h1' : ∀ y, (P.extend v).cotangentRestrict Sum.inr_injective
      (Extension.Cotangent.mk (incl y)) = 0 := fun y ↦ by
    ext j
    simp [cotangentRestrict_mk, hincl, hpderiv]
  -- The relations `z_j - σ (v j)` have `d z_j` components the standard basis vectors.
  have hz : ∀ j, X (Sum.inr j) - rename Sum.inl (P.σ (v j)) ∈ (P.extend v).ker := fun j ↦ by
    rw [ker_eq_ker_aeval_val, RingHom.mem_ker, map_sub, aeval_X, MvPolynomial.aeval_rename]
    simp [Function.comp_def]
  have h2 : ∀ j, (P.extend v).cotangentRestrict Sum.inr_injective
      (Extension.Cotangent.mk (⟨_, hz j⟩ : (P.extend v).ker)) = Finsupp.single j 1 := fun j ↦ by
    ext j'
    rw [cotangentRestrict_mk]
    by_cases h : j = j' <;> simp [hpderiv, h]
  rintro ⟨c, w⟩
  have hmk : ∀ c : P.toExtension.Cotangent, ∃ y : P.ker, Extension.Cotangent.mk y = c :=
    Extension.Cotangent.mk_surjective
  obtain ⟨y, rfl⟩ := hmk c
  choose y' hy' using fun j ↦ hmk (Extension.Cotangent.map r.toExtensionHom
    (Extension.Cotangent.mk (⟨_, hz j⟩ : (P.extend v).ker)))
  refine ⟨Extension.Cotangent.mk (incl y) + ∑ j, w j •
    (Extension.Cotangent.mk (⟨_, hz j⟩ : (P.extend v).ker) - Extension.Cotangent.mk (incl (y' j))),
    ?_⟩
  rw [LinearMap.prod_apply, Function.prod_apply]
  refine Prod.ext ?_ ?_
  · simp only [map_add, map_sum, map_smul, map_sub, h1, ← hy', sub_self, smul_zero,
      Finset.sum_const_zero, add_zero]
  · simp only [map_add, map_sum, map_smul, map_sub, h1', h2, sub_zero, zero_add,
      Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.univ_sum_single]

/-- Let `P` present `S` over `R` with generators indexed by `ι`, and let `S → F` be a field-valued
point. If `S` also has a presentation with generators indexed by `ι'` and relations indexed by
`σ`, then the fibre at `F` of the conormal module of `P` has dimension at most
`#σ + #ι - #ι'`. -/
theorem finrank_tensor_cotangent_add_card_le (P : Generators R S ι) (F : Type*) [Field F]
    [Algebra S F] [Finite ι] {ι' σ : Type*} [Finite ι'] [Finite σ] (P' : Presentation R S ι' σ) :
    Module.finrank F (F ⊗[S] P.toExtension.Cotangent) + Nat.card ι' ≤
      Nat.card σ + Nat.card ι := by
  have := Fintype.ofFinite ι
  have := Fintype.ofFinite ι'
  have := Fintype.ofFinite σ
  obtain ⟨γ, hγ⟩ := P.exists_surjective_cotangent_extend P'
  -- The retraction of the extended presentation onto `P`.
  let r : (P.extend P'.val).Hom P := ⟨Sum.elim X (P.σ ∘ P'.val), by rintro (i | j) <;> simp⟩
  obtain ⟨α, hα⟩ : ∃ α : (P.extend P'.val).toExtension.Cotangent →ₗ[S]
      P.toExtension.Cotangent × (ι' →₀ S), Function.Surjective α :=
    ⟨_, P.surjective_cotangentMap_prod_cotangentRestrict_extend P'.val r fun _ ↦ rfl⟩
  have hαγ : Function.Surjective (α ∘ₗ γ) := by rw [LinearMap.coe_comp]; exact hα.comp hγ
  have : Module.Finite S P.toExtension.Cotangent :=
    .of_surjective (LinearMap.fst S _ _ ∘ₗ α ∘ₗ γ) (Prod.fst_surjective.comp hαγ)
  have hle := LinearMap.finrank_range_le (LinearMap.baseChange F (α ∘ₗ γ))
  have : Nontrivial S := (algebraMap S F).domain_nontrivial
  rw [LinearMap.range_eq_top.mpr (LinearMap.baseChange_surjective F hαγ), finrank_top,
    Module.finrank_baseChange (R := F) (M' := ι ⊕ σ → S), Module.finrank_fintype_fun_eq_card,
    (TensorProduct.prodRight S F F _ _).finrank_eq, Module.finrank_prod,
    Module.finrank_baseChange (R := F) (M' := ι' →₀ S), Module.finrank_finsupp_self] at hle
  simpa [Nat.card_eq_fintype_card, Fintype.card_sum, add_comm] using hle

variable {T F : Type*} [CommRing T] [Algebra R T] [Algebra S T] [IsScalarTower R S T] [Field F]
  [Algebra S F] [Algebra T F] [IsScalarTower S T F]

/-- Presenting the localization `T = S[1/g]` by the generators of `P` and one more generator
`y`, subject to one more relation `g y - 1`, raises the dimension of the fibre of the conormal
module at a field-valued point of `T` by one. -/
theorem finrank_tensor_cotangent_comp_localizationAway (g : S) [IsLocalization.Away g T]
    (P : Generators R S ι) [Module.Finite S P.toExtension.Cotangent] :
    Module.finrank F (F ⊗[T] ((localizationAway T g).comp P).toExtension.Cotangent) =
      Module.finrank F (F ⊗[S] P.toExtension.Cotangent) + 1 := by
  obtain ⟨x, hx⟩ := Cotangent.surjective_map_ofComp (localizationAway T g) P
    (cMulXSubOneCotangent T g)
  have : Nontrivial T := (algebraMap T F).domain_nontrivial
  have : Module.Finite T (localizationAway T g).toExtension.Cotangent :=
    .of_basis (basisCotangentAway T g)
  rw [((cotangentCompLocalizationAwayEquiv g P hx).baseChange T F _ _).finrank_eq,
    (TensorProduct.prodRight T F F _ _).finrank_eq, Module.finrank_prod,
    (AlgebraTensorModule.cancelBaseChange S T F F _).finrank_eq,
    Module.finrank_baseChange (R := F) (S := T),
    Module.finrank_eq_card_basis (basisCotangentAway T g), Fintype.card_unit]

end Algebra.Generators
