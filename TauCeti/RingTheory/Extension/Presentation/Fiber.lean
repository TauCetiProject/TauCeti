/-!
# Lifting presentations from a fibre

Let `A` be a flat and finitely presented `R`-algebra, `p` a prime of `R` and `q` a prime of `A`
lying over `p`. Suppose the fibre `κ(p) ⊗[R] A` has a presentation over `κ(p)` with `n + c`
generators and `c` relations. Then some localization `A[1/g]` with `g ∉ q` has a presentation over
`R` with `n + c'` generators and `c'` relations
(`Algebra.Presentation.exists_presentation_localizationAway_of_fiber`).

This is the presentation half of the fibrewise criterion for syntomic morphisms, which asserts
that a flat, finitely presented algebra whose fibres are relative global complete intersections of
relative dimension `n` is, locally on the source, a relative global complete intersection of
relative dimension `n`. The other half is the dimension of the fibres of `A[1/g]`, which the
theorem here does not address.

The proof presents `A` by generators `x_i ↦ f (X i)` of `A` together with lifts `y_j ↦ a_j` of
the generators of the fibre presentation, which exist up to units of `κ(p)`.

* On the fibre, each `x_i` is a polynomial `Φ i` in the `y_j`, so the kernel of the fibre map is
  generated by the `m` elements `x_i - Φ i` and the `c` relations of the fibre presentation
  (`MvPolynomial.ker_eq_map_ker_comp_rename_inr_sup`,
  `Algebra.Presentation.exists_ker_eq_span_range`).
* These generators lift, up to units, to elements `k_l` of the kernel `K` of `R[x, y] → A`
  (`MvPolynomial.exists_C_mul_eq_map_of_mem_map`).
* As `A` is flat, `K ∩ p R[x, y] = p K`; Nakayama's lemma, in the form of supports of finite
  modules, shows that the `k_l` generate `K` after inverting some `g ∉ q`
  (`MvPolynomial.exists_notMem_forall_mul_mem_of_map_ker_le`).

## Main results

* `Algebra.Presentation.exists_presentation_localizationAway_of_fiber`: the lifting theorem.
* `MvPolynomial.exists_notMem_forall_mul_mem_of_map_ker_le`: an ideal `J` contained in the
  kernel `K` of a surjection `R[V] → A` onto a flat `R`-algebra, which generates `K` on the fibre
  over `p`, agrees with `K` near every prime over `p`.
* `MvPolynomial.ker_eq_map_ker_comp_rename_inr_sup`: eliminating redundant variables from the
  kernel of a map out of a polynomial ring.
* `IsLocalization.Away.of_surjective_of_mul_eq_zero`: a localization of a quotient `B ⧸ I` away
  from the image of an element `b` with `b I = 0` is a localization of `B` away from `b`.

## References

* The Stacks Project, Commutative Algebra, Section *Syntomic morphisms* (the lemma that a flat
  finitely presented ring map whose fibre is a local complete intersection at a prime is a
  relative global complete intersection near that prime) and Section *Nakayama's lemma*.
-/

public section

open MvPolynomial TensorProduct

namespace MvPolynomial

variable {R : Type*} [CommRing R] {p : Ideal R} [p.IsPrime] {V : Type*}

/-- Every polynomial over the residue field `κ(p)` becomes, after multiplication by the image of
some `s ∉ p`, the image of a polynomial over `R`. -/
theorem exists_C_mul_eq_map_residueField (c : MvPolynomial V p.ResidueField) :
    ∃ s ∉ p, ∃ d : MvPolynomial V R,
      C (algebraMap R p.ResidueField s) * c = map (algebraMap R p.ResidueField) d := by
  let e := algebraTensorAlgEquiv (σ := V) R p.ResidueField
  obtain ⟨s, hs, d, hd⟩ := Ideal.Fiber.exists_smul_eq_one_tmul p (e.symm c)
  refine ⟨s, hs, d, ?_⟩
  have := congr(e $hd)
  rwa [algebraTensorAlgEquiv_tmul, one_smul, ← algebraMap_smul p.ResidueField s, map_smul,
    AlgEquiv.apply_symm_apply, smul_eq_C_mul] at this

/-- An element of the extension of an ideal `L ⊆ R[V]` to `κ(p)[V]` is, after multiplication by
the image of some `s ∉ p`, the image of an element of `L`. -/
theorem exists_C_mul_eq_map_of_mem_map {L : Ideal (MvPolynomial V R)}
    {z : MvPolynomial V p.ResidueField} (hz : z ∈ L.map (map (algebraMap R p.ResidueField))) :
    ∃ s ∉ p, ∃ y ∈ L,
      C (algebraMap R p.ResidueField s) * z = map (algebraMap R p.ResidueField) y := by
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨y, hy, rfl⟩ := hz
    exact ⟨1, p.primeCompl.one_mem, y, hy, by simp⟩
  | zero => exact ⟨1, p.primeCompl.one_mem, 0, L.zero_mem, by simp⟩
  | add z₁ z₂ _ _ h₁ h₂ =>
    obtain ⟨s₁, hs₁, y₁, hy₁, e₁⟩ := h₁
    obtain ⟨s₂, hs₂, y₂, hy₂, e₂⟩ := h₂
    refine ⟨s₁ * s₂, p.primeCompl.mul_mem hs₁ hs₂, C s₂ * y₁ + C s₁ * y₂,
      L.add_mem (L.mul_mem_left _ hy₁) (L.mul_mem_left _ hy₂), ?_⟩
    simp only [map_add, map_mul, map_C, ← e₁, ← e₂]
    ring
  | smul c z _ h =>
    obtain ⟨s₁, hs₁, d, e₁⟩ := exists_C_mul_eq_map_residueField c
    obtain ⟨s₂, hs₂, y, hy, e₂⟩ := h
    refine ⟨s₁ * s₂, p.primeCompl.mul_mem hs₁ hs₂, d * y, L.mul_mem_left _ hy, ?_⟩
    simp only [smul_eq_mul, map_mul, ← e₁, ← e₂]
    ring

/-- If the image of `x ∈ R[V]` in `κ(p)[V]` lies in the extension of an ideal `L`, then `s x`
lies in `L + p R[V]` for some `s ∉ p`. -/
theorem exists_C_mul_mem_sup_of_map_mem_map {L : Ideal (MvPolynomial V R)} {x : MvPolynomial V R}
    (hx : map (algebraMap R p.ResidueField) x ∈ L.map (map (algebraMap R p.ResidueField))) :
    ∃ s ∉ p, C s * x ∈ L ⊔ p.map C := by
  obtain ⟨s, hs, y, hy, e⟩ := exists_C_mul_eq_map_of_mem_map hx
  refine ⟨s, hs, Submodule.mem_sup.mpr ⟨y, hy, C s * x - y, ?_, by ring⟩⟩
  rw [← p.ker_algebraMap_residueField, ← ker_map, RingHom.mem_ker, map_sub, map_mul, map_C, e,
    sub_self]

variable {A : Type*} [CommRing A] [Algebra R A]

/-- Let `A` be a flat `R`-algebra, presented as a quotient of `R[V]` with finitely generated
kernel `K`. If an ideal `J ⊆ K` generates `K` on the fibre over `p`, in the sense that `K` and `J`
have the same extension to `κ(p)[V]`, then `J` and `K` agree near every prime `Q` of `R[V]` lying
over `p`: some `g ∉ Q` satisfies `g K ⊆ J`. -/
theorem exists_notMem_forall_mul_mem_of_map_ker_le [Module.Flat R A]
    {ϕ : MvPolynomial V R →ₐ[R] A} (hϕ : Function.Surjective ϕ) (hK : (RingHom.ker ϕ).FG)
    {J : Ideal (MvPolynomial V R)} (hJ : J ≤ RingHom.ker ϕ)
    (h : (RingHom.ker ϕ).map (map (algebraMap R p.ResidueField)) ≤
      J.map (map (algebraMap R p.ResidueField)))
    (Q : Ideal (MvPolynomial V R)) [Q.IsPrime] [Q.LiesOver p] :
    ∃ g ∉ Q, ∀ k ∈ RingHom.ker ϕ, g * k ∈ J := by
  set K := RingHom.ker ϕ
  set I : Ideal (MvPolynomial V R) := p.map C
  have hp : ∀ r, r ∈ p ↔ C r ∈ Q := fun r ↦ by rw [Ideal.mem_of_liesOver Q p, algebraMap_eq]
  have hIQ : I ≤ Q := Ideal.map_le_iff_le_comap.mpr fun r hr ↦ (hp r).mp hr
  -- Flatness of `A` gives `K ∩ p R[V] = p K`.
  have hflat : ∀ x ∈ K, x ∈ I → x ∈ I • K := by
    intro x hxK hxI
    have hx : x ∈ p • (⊤ : Submodule R (MvPolynomial V R)) := by
      rwa [Ideal.smul_top_eq_map, algebraMap_eq]
    have hx' : x ∈ p • LinearMap.ker ϕ.toLinearMap :=
      LinearMap.ker_inf_smul_top_eq_smul_of_flat p ϕ.toLinearMap hϕ ▸ ⟨hxK, hx⟩
    refine (Submodule.smul_le.mpr fun r hr n hn ↦ ?_ :
      p • LinearMap.ker ϕ.toLinearMap ≤ (I • K).restrictScalars R) hx'
    rw [Submodule.restrictScalars_mem, smul_eq_C_mul]
    exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem C hr) hn
  -- The finite module `M = K ⧸ J` vanishes at `Q`: `M ⧸ I M` does, and `Q` contains `I`.
  let N : Submodule (MvPolynomial V R) K := Submodule.comap K.subtype J
  have : Module.Finite (MvPolynomial V R) K := Module.Finite.iff_fg.mpr hK
  let Q' : PrimeSpectrum (MvPolynomial V R) := ⟨Q, inferInstance⟩
  have h₁ : Q' ∉ Module.support (MvPolynomial V R)
      ((K ⧸ N) ⧸ I • (⊤ : Submodule (MvPolynomial V R) (K ⧸ N))) := by
    rw [Module.notMem_support_iff']
    intro m
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective _ m
    obtain ⟨⟨k, hk⟩, rfl⟩ := Submodule.mkQ_surjective _ m
    -- On the fibre, `k` lies in the extension of `J`, so `s k = j + i` with `j ∈ J`, `i ∈ p K`.
    obtain ⟨s, hs, hsk⟩ := exists_C_mul_mem_sup_of_map_mem_map (h (Ideal.mem_map_of_mem _ hk))
    obtain ⟨j, hj, i, hi, hji⟩ := Submodule.mem_sup.mp hsk
    have hiK : i ∈ K := by
      have : i = C s * k - j := by rw [← hji]; ring
      exact this ▸ K.sub_mem (K.mul_mem_left _ hk) (hJ hj)
    refine ⟨C s, fun h ↦ hs ((hp s).mpr h), ?_⟩
    have hsk' : C s • (⟨k, hk⟩ : K) = ⟨j, hJ hj⟩ + ⟨i, hiK⟩ :=
      Subtype.ext (by rw [Submodule.coe_add, hji, Submodule.coe_smul, smul_eq_mul])
    rw [← map_smul, ← map_smul, hsk', map_add, Submodule.mkQ_apply N,
      (Submodule.Quotient.mk_eq_zero N).mpr (show _ ∈ N from hj), zero_add,
      Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    have hi' : (⟨i, hiK⟩ : K) ∈ I • (⊤ : Submodule (MvPolynomial V R) K) :=
      (Submodule.mem_smul_top_iff I K _).mpr (hflat i hiK hi)
    have := Submodule.mem_map_of_mem (f := N.mkQ) hi'
    rwa [Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ] at this
  have h₂ : Q' ∉ Module.support (MvPolynomial V R) (K ⧸ N) := fun hm ↦
    h₁ (by rw [Module.support_quotient]; exact ⟨hm, hIQ⟩)
  -- Hence some `g ∉ Q` annihilates the finite module `M`.
  rw [Module.mem_support_iff_of_finite, IsConcreteLE.not_le_iff_exists] at h₂
  obtain ⟨g, hg, hgQ⟩ := h₂
  refine ⟨g, hgQ, fun k hk ↦ ?_⟩
  have := Module.mem_annihilator.mp hg (N.mkQ ⟨k, hk⟩)
  rwa [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this

/-- **Eliminating redundant variables.** If `ψ : B[ι ⊕ σ] → S` sends each variable `X (inl i)` to
the image of a polynomial `Φ i` in the remaining variables, then the kernel of `ψ` is generated by
the kernel of its restriction to `B[σ]` together with the relations `X (inl i) - Φ i`. -/
theorem ker_eq_map_ker_comp_rename_inr_sup {B S : Type*} [CommRing B] [CommRing S] [Algebra B S]
    {ι σ : Type*} {ψ : MvPolynomial (ι ⊕ σ) B →ₐ[B] S} (Φ : ι → MvPolynomial σ B)
    (hΦ : ∀ i, ψ (rename Sum.inr (Φ i)) = ψ (X (Sum.inl i))) :
    RingHom.ker ψ = (RingHom.ker (ψ.comp (rename Sum.inr))).map (rename Sum.inr) ⊔
      Ideal.span (Set.range fun i ↦ X (Sum.inl i) - rename Sum.inr (Φ i)) := by
  set L := (RingHom.ker (ψ.comp (rename Sum.inr))).map (rename (R := B) (Sum.inr (α := ι))) ⊔
    Ideal.span (Set.range fun i ↦ X (Sum.inl i) - rename Sum.inr (Φ i))
  refine le_antisymm (fun f hf ↦ ?_) (sup_le ?_ ?_)
  · -- Substituting `Φ i` for `X (inl i)` changes `f` only modulo `L`, and does not change `ψ f`.
    let e := (rename (R := B) (Sum.inr : σ → ι ⊕ σ)).comp (aeval (Sum.elim Φ X))
    have he : (Ideal.Quotient.mkₐ B L).comp e = Ideal.Quotient.mkₐ B L := by
      ext (i | j)
      · simp only [e, AlgHom.comp_apply, aeval_X, Sum.elim_inl, Ideal.Quotient.mkₐ_eq_mk]
        rw [Ideal.Quotient.eq, ← neg_sub, neg_mem_iff]
        exact Ideal.mem_sup_right (Ideal.subset_span ⟨i, rfl⟩)
      · simp [e]
    have hψ : ψ.comp e = ψ := by ext (i | j) <;> simp [e, hΦ]
    have h₁ : f - e f ∈ L := Ideal.Quotient.eq.mp congr($he.symm f)
    have h₂ : e f ∈ L := by
      refine Ideal.mem_sup_left (Ideal.mem_map_of_mem _ ?_)
      rw [RingHom.mem_ker] at hf ⊢
      exact congr($hψ f).trans hf
    simpa using L.add_mem h₁ h₂
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simpa using hx
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp [hΦ]

end MvPolynomial

/-- Let `B → A` be surjective, with kernel annihilated by `b ∈ B`. Then a localization of `A` away
from the image of `b` is a localization of `B` away from `b`. -/
theorem IsLocalization.Away.of_surjective_of_mul_eq_zero {B A T : Type*} [CommRing B]
    [CommRing A] [CommRing T] [Algebra B A] [Algebra A T] [Algebra B T] [IsScalarTower B A T]
    (hBA : Function.Surjective (algebraMap B A)) {b : B}
    (hb : ∀ x ∈ RingHom.ker (algebraMap B A), b * x = 0)
    [IsLocalization.Away (algebraMap B A b) T] : IsLocalization.Away b T := by
  refine .mk b ?_ (fun t ↦ ?_) fun x y h ↦ ?_
  · rw [IsScalarTower.algebraMap_apply B A T]
    exact IsLocalization.Away.algebraMap_isUnit _
  · obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj (algebraMap B A b) t
    obtain ⟨x, rfl⟩ := hBA a
    exact ⟨n, x, by simpa [← IsScalarTower.algebraMap_apply] using ha⟩
  · rw [IsScalarTower.algebraMap_apply B A T, IsScalarTower.algebraMap_apply B A T y] at h
    obtain ⟨n, hn⟩ := IsLocalization.Away.exists_of_eq (algebraMap B A b) h
    refine ⟨n + 1, ?_⟩
    have := hb (b ^ n * (x - y)) (by simp [mul_sub, hn])
    linear_combination this

namespace Algebra.Presentation

section Elimination

variable {B S σ τ : Type*} [CommRing B] [CommRing S] [Algebra B S]

/-- Let `Q` present `S` over `B` with generators indexed by `σ` and relations indexed by `τ`, and
let `ψ : B[ι ⊕ σ] → S` send the variables `X (inr j)` to the generators of `Q` rescaled by units
`u j`. Then the kernel of `ψ` is generated by a family indexed by `ι ⊕ τ`: the rescaled relations
of `Q` and one relation eliminating each variable `X (inl i)`. -/
theorem exists_ker_eq_span_range (Q : Presentation B S σ τ) (u : σ → Bˣ) {ι : Type*}
    {ψ : MvPolynomial (ι ⊕ σ) B →ₐ[B] S}
    (hψ : ψ.comp (rename Sum.inr) = aeval fun j ↦ (u j : B) • Q.val j) :
    ∃ G : ι ⊕ τ → MvPolynomial (ι ⊕ σ) B, RingHom.ker ψ = Ideal.span (Set.range G) := by
  -- Rescaling the variables is an automorphism `e` of `B[σ]`.
  let e : MvPolynomial σ B ≃ₐ[B] MvPolynomial σ B :=
    AlgEquiv.ofAlgHom (aeval fun j ↦ C (↑(u j) : B) * X j) (aeval fun j ↦ C (↑(u j)⁻¹ : B) * X j)
      (algHom_ext fun j ↦ by simp [← mul_assoc, ← C_mul])
      (algHom_ext fun j ↦ by simp [← mul_assoc, ← C_mul])
  have he : (aeval (R := B) fun j ↦ (u j : B) • Q.val j) = (aeval Q.val).comp e.toAlgHom := by
    ext j
    simp [e, Algebra.smul_def]
  rw [he] at hψ
  have hker : RingHom.ker (ψ.comp (rename Sum.inr)) =
      Ideal.span (e.symm '' Set.range Q.relation) := by
    ext x
    rw [hψ, RingHom.mem_ker, AlgHom.comp_apply, ← RingHom.mem_ker,
      ← Generators.ker_eq_ker_aeval_val, ← Q.span_range_relation_eq_ker, ← Ideal.map_span,
      Ideal.mem_map_of_equiv]
    exact ⟨fun h ↦ ⟨e x, h, e.symm_apply_apply x⟩, by rintro ⟨y, hy, rfl⟩; simpa using hy⟩
  have hsurj : Function.Surjective (ψ.comp (rename Sum.inr)) :=
    hψ ▸ Q.aeval_val_surjective.comp e.surjective
  choose Φ hΦ using fun i ↦ hsurj (ψ (X (Sum.inl i)))
  refine ⟨Sum.elim (fun i ↦ X (Sum.inl i) - rename Sum.inr (Φ i))
    (fun t ↦ rename Sum.inr (e.symm (Q.relation t))), ?_⟩
  rw [MvPolynomial.ker_eq_map_ker_comp_rename_inr_sup Φ hΦ, hker, Ideal.map_span,
    ← Ideal.span_union, Set.Sum.elim_range, Set.union_comm, Set.image_image, ← Set.range_comp,
    Function.comp_def]

end Elimination

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- If the kernel of a surjection `ϕ : R[V] → A` is generated by a family `k` after inverting `g`,
then `A[1/ϕ g]` has a presentation over `R` with one more generator than `R[V]` and one more
relation than `k`. -/
private theorem nonempty_presentation_localizationAway {V τ : Type*}
    {ϕ : MvPolynomial V R →ₐ[R] A} (hϕ : Function.Surjective ϕ) {k : τ → MvPolynomial V R}
    (hk : ∀ l, k l ∈ RingHom.ker ϕ) {g : MvPolynomial V R}
    (hg : ∀ x ∈ RingHom.ker ϕ, g * x ∈ Ideal.span (Set.range k)) :
    Nonempty (Presentation R (Localization.Away (ϕ g)) (Unit ⊕ V) (Unit ⊕ τ)) := by
  let J := Ideal.span (Set.range k)
  let π : (MvPolynomial V R ⧸ J) →ₐ[R] A :=
    Ideal.Quotient.liftₐ J ϕ fun x hx ↦ Ideal.span_le.mpr (Set.range_subset_iff.mpr hk) hx
  algebraize [π.toRingHom]
  have hπ : Function.Surjective (algebraMap (MvPolynomial V R ⧸ J) A) :=
    fun x ↦ let ⟨y, hy⟩ := hϕ x; ⟨Ideal.Quotient.mk J y, hy⟩
  have hgπ : algebraMap (MvPolynomial V R ⧸ J) A (Ideal.Quotient.mk J g) = ϕ g :=
    Ideal.Quotient.liftₐ_apply _ _ _ _
  have : IsLocalization.Away (algebraMap (MvPolynomial V R ⧸ J) A (Ideal.Quotient.mk J g))
      (Localization.Away (ϕ g)) := hgπ ▸ inferInstance
  have : IsLocalization.Away (Ideal.Quotient.mk J g) (Localization.Away (ϕ g)) := by
    refine IsLocalization.Away.of_surjective_of_mul_eq_zero hπ fun x hx ↦ ?_
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact hg y hx
  exact ⟨(localizationAway (Localization.Away (ϕ g)) (Ideal.Quotient.mk J g)).comp
    (naive (v := k))⟩

/-- **Lifting presentations from a fibre.** Let `A` be a flat and finitely presented `R`-algebra,
and `q` a prime of `A` lying over a prime `p` of `R`. If the fibre `κ(p) ⊗[R] A` has a
presentation over `κ(p)` with `n + c` generators and `c` relations, then for some `g ∉ q` the
localization `A[1/g]` has a presentation over `R` with `n + c'` generators and `c'` relations. -/
theorem exists_presentation_localizationAway_of_fiber [Module.Flat R A]
    [Algebra.FinitePresentation R A] {p : Ideal R} [p.IsPrime] {σ τ : Type*} [Finite σ]
    [Finite τ] {n : ℕ} (Q : Presentation p.ResidueField (p.Fiber A) σ τ)
    (hQ : Nat.card σ = n + Nat.card τ) (q : Ideal A) [q.IsPrime] [q.LiesOver p] :
    ∃ g ∉ q, ∃ (ι' σ' : Type) (_ : Finite ι') (_ : Finite σ')
      (_ : Presentation R (Localization.Away g) ι' σ'), Nat.card ι' = n + Nat.card σ' := by
  classical
  obtain ⟨m, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : Algebra.FiniteType R A)
  -- Lift the generators of the fibre to elements `a j` of `A`, up to units `r j ∉ p`.
  choose r hr a ha using fun j ↦ Ideal.Fiber.exists_smul_eq_one_tmul p (Q.val j)
  -- Present `A` by the generators `f (X i)` of `A` together with the lifts `a j`.
  let val : Fin m ⊕ σ → A := Sum.elim (fun i ↦ f (X i)) a
  let ϕ : MvPolynomial (Fin m ⊕ σ) R →ₐ[R] A := aeval val
  have hϕ : Function.Surjective ϕ := by
    have : ϕ.comp (rename Sum.inl) = f := by ext i; simp [ϕ, val]
    intro x
    obtain ⟨y, rfl⟩ := hf x
    exact ⟨rename Sum.inl y, by rw [← this, AlgHom.comp_apply]⟩
  have hK : (RingHom.ker ϕ).FG := Algebra.FinitePresentation.ker_fG_of_surjective ϕ hϕ
  obtain ⟨s, hs⟩ := hK
  let PA : Presentation R A (Fin m ⊕ σ) s :=
    { toGenerators := .ofSurjective val hϕ
      relation := Subtype.val
      span_range_relation_eq_ker := by
        rw [Subtype.range_coe, hs, Generators.ker_eq_ker_aeval_val,
          funext (Generators.ofSurjective_val val hϕ)] }
  -- On the fibre, the kernel of `ψ : κ(p)[Fin m ⊕ σ] → κ(p) ⊗[R] A` is the extension of `ker ϕ`.
  let ψ : MvPolynomial (Fin m ⊕ σ) p.ResidueField →ₐ[p.ResidueField] p.Fiber A :=
    aeval fun v ↦ 1 ⊗ₜ val v
  have hker : (RingHom.ker ϕ).map (map (algebraMap R p.ResidueField)) = RingHom.ker ψ := by
    have h := PA.span_range_relation_eq_ker_baseChange p.ResidueField
    have h₁ : (Set.range fun i ↦ map (algebraMap R p.ResidueField) (PA.relation i)) =
        map (algebraMap R p.ResidueField) '' s := by
      ext
      simp [PA]
    have h₂ : (PA.toGenerators.baseChange p.ResidueField).val = fun v ↦ 1 ⊗ₜ val v := by
      ext
      simp [PA]
    rw [h₁, h₂] at h
    rw [← hs, Ideal.map_span]
    exact h
  -- On the variables `σ`, `ψ` is the presentation map of `Q` with rescaled generators, so its
  -- kernel is generated by `m + #τ` elements.
  have hne : ∀ t ∉ p, algebraMap R p.ResidueField t ≠ 0 := fun t ht h ↦
    ht (p.ker_algebraMap_residueField ▸ RingHom.mem_ker.mpr h)
  let u : σ → p.ResidueFieldˣ := fun j ↦ Units.mk0 _ (hne (r j) (hr j))
  have hψ₂ : ψ.comp (rename Sum.inr) = aeval fun j ↦ (u j : p.ResidueField) • Q.val j := by
    ext j
    simp [ψ, val, u, ← ha, algebraMap_smul]
  obtain ⟨G, hG⟩ := Q.exists_ker_eq_span_range u hψ₂
  -- Lift these generators to elements `k l` of `ker ϕ`, up to units.
  have hlift : ∀ l, ∃ t ∉ p, ∃ k ∈ RingHom.ker ϕ,
      C (algebraMap R p.ResidueField t) * G l = map (algebraMap R p.ResidueField) k :=
    fun l ↦ MvPolynomial.exists_C_mul_eq_map_of_mem_map (hker ▸ hG ▸ Ideal.subset_span ⟨l, rfl⟩)
  choose t ht k hk htk using hlift
  have hJ : Ideal.span (Set.range k) ≤ RingHom.ker ϕ :=
    Ideal.span_le.mpr (Set.range_subset_iff.mpr hk)
  have hJK : (RingHom.ker ϕ).map (map (algebraMap R p.ResidueField)) ≤
      (Ideal.span (Set.range k)).map (map (algebraMap R p.ResidueField)) := by
    rw [hker, hG, Ideal.span_le, Set.range_subset_iff]
    intro l
    have : G l =
        C (algebraMap R p.ResidueField (t l))⁻¹ * map (algebraMap R p.ResidueField) (k l) := by
      rw [← htk, ← mul_assoc, ← C_mul, inv_mul_cancel₀ (hne _ (ht l)), C_1, one_mul]
    rw [SetLike.mem_coe, this]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨l, rfl⟩))
  -- By flatness and Nakayama, the `k l` generate `ker ϕ` after inverting some `g ∉ q`.
  obtain ⟨g, hgq, hg⟩ :=
    MvPolynomial.exists_notMem_forall_mul_mem_of_map_ker_le hϕ ⟨s, hs⟩ hJ hJK (q.comap ϕ)
  obtain ⟨PT⟩ := nonempty_presentation_localizationAway hϕ hk hg
  refine ⟨ϕ g, hgq, _, _, inferInstance, inferInstance,
    PT.reindex (Finite.equivFin _).symm (Finite.equivFin _).symm, ?_⟩
  simp only [Nat.card_fin, Nat.card_sum, Nat.card_eq_fintype_card (α := Unit), Fintype.card_unit,
    hQ]
  omega

end Algebra.Presentation
