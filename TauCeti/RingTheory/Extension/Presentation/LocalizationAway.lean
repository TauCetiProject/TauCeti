module

public import Mathlib.RingTheory.Extension.Presentation.Basic
import TauCeti.RingTheory.Localization.Away.Quotient

/-!
# Presentations of away localizations from generic generation of the kernel

Let `ϕ : R[V] → A` be a surjection of `R`-algebras and `k` a family in its kernel which generates
the kernel after inverting some `g ∈ R[V]`. Then `A[1/ϕ g]` is presented over `R` by the
variables `V` and one more variable inverting `g`, subject to the relations `k` and one more
relation.

## Main results

* `Algebra.Presentation.nonempty_presentation_localizationAway`: such a presentation of
  `A[1/ϕ g]` exists.
-/

public section

open MvPolynomial

namespace Algebra.Presentation

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- If the kernel of a surjection `ϕ : R[V] → A` is generated by a family `k` after inverting `g`,
then `A[1/ϕ g]` has a presentation over `R` with one more generator than `R[V]` and one more
relation than `k`. -/
theorem nonempty_presentation_localizationAway {V τ : Type*}
    {ϕ : MvPolynomial V R →ₐ[R] A} (hϕ : Function.Surjective ϕ) {k : τ → MvPolynomial V R}
    (hk : ∀ l, k l ∈ RingHom.ker ϕ) {g : MvPolynomial V R}
    (hg : ∀ x ∈ RingHom.ker ϕ, g * x ∈ Ideal.span (Set.range k)) :
    Nonempty (Presentation R (Localization.Away (ϕ g)) (Unit ⊕ V) (Unit ⊕ τ)) := by
  let J := Ideal.span (Set.range k)
  let π : (MvPolynomial V R ⧸ J) →ₐ[R] A :=
    Ideal.Quotient.liftₐ J ϕ fun x hx ↦ Ideal.span_le.mpr (Set.range_subset_iff.mpr hk) hx
  algebraize [π.toRingHom]
  have hπ : Function.Surjective (algebraMap (MvPolynomial V R ⧸ J) A) :=
    fun x ↦ let ⟨y, hy⟩ := hϕ x; ⟨Ideal.Quotient.mk J y, hy⟩
  have hgπ : algebraMap (MvPolynomial V R ⧸ J) A (Ideal.Quotient.mk J g) = ϕ g :=
    Ideal.Quotient.liftₐ_apply _ _ _ _
  have : IsLocalization.Away (algebraMap (MvPolynomial V R ⧸ J) A (Ideal.Quotient.mk J g))
      (Localization.Away (ϕ g)) := hgπ ▸ inferInstance
  have : IsLocalization.Away (Ideal.Quotient.mk J g) (Localization.Away (ϕ g)) := by
    refine IsLocalization.Away.of_surjective_of_mul_eq_zero hπ fun x hx ↦ ?_
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact hg y hx
  exact ⟨(localizationAway (Localization.Away (ϕ g)) (Ideal.Quotient.mk J g)).comp
    (naive (v := k))⟩

end Algebra.Presentation
