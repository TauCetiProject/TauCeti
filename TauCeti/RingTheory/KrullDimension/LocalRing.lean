module

public import Mathlib.RingTheory.KrullDimension.LocalRing

/-!
# Elements of a local domain of dimension at most one

A nonzero element `x` of the maximal ideal of a local domain of dimension at most one generates an
ideal whose radical is the maximal ideal. In dimension one this is the other half of Mathlib's
characterisation `ringKrullDim_eq_one_iff_of_isLocalRing_isDomain`, which gives only that the
radical contains the maximal ideal.

## Main results

* `TauCeti.radical_span_singleton_eq_maximalIdeal_of_ringKrullDim_le_one`: the radical of the
  ideal generated by a nonzero element of the maximal ideal is the maximal ideal.
-/

public section

namespace TauCeti

open _root_.IsLocalRing

universe u

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]

/-- A nonzero element `x` of the maximal ideal of a local domain of dimension at most one
generates an ideal whose radical is the maximal ideal. -/
theorem radical_span_singleton_eq_maximalIdeal_of_ringKrullDim_le_one
    (hdim : ringKrullDim A ≤ 1) {x : A} (hxm : x ∈ maximalIdeal A) (hx : x ≠ 0) :
    (Ideal.span {x}).radical = maximalIdeal A := by
  have : Ring.KrullDimLE 1 A := Ring.krullDimLE_iff.mpr hdim
  refine le_antisymm ?_ ?_
  · exact (IsLocalRing.maximalIdeal.isMaximal A).isPrime.radical_le_iff.2
      ((Ideal.span_singleton_le_iff_mem _).2 hxm)
  · -- Every prime containing `x` is nonzero, hence maximal in dimension at most one.
    rw [Ideal.radical_eq_sInf]
    refine le_sInf fun J ⟨hJ, hJp⟩ ↦ ?_
    have hJ0 : J ≠ ⊥ := fun h ↦ hx (by simpa [h] using hJ (Ideal.mem_span_singleton_self x))
    exact (IsLocalRing.eq_maximalIdeal (hJp.isMaximal_of_ne_bot hJ0)).ge

end TauCeti
