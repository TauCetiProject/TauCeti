module

public import Mathlib.RingTheory.KrullDimension.LocalRing

/-!
# Elements of a one-dimensional local domain

A nonzero element `x` of the maximal ideal of a one-dimensional local domain generates an ideal
whose radical is the maximal ideal. This is the other half of Mathlib's characterisation
`ringKrullDim_eq_one_iff_of_isLocalRing_isDomain`, which gives only that the radical contains the
maximal ideal.

## Main results

* `TauCeti.radical_span_singleton_eq_maximalIdeal_of_ringKrullDim_eq_one`: the radical of the
  ideal generated by a nonzero element of the maximal ideal is the maximal ideal.
-/

public section

namespace TauCeti

open _root_.IsLocalRing

universe u

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]

/-- A nonzero element `x` of the maximal ideal of a one-dimensional local domain generates an ideal
whose radical is the maximal ideal. -/
theorem radical_span_singleton_eq_maximalIdeal_of_ringKrullDim_eq_one
    (hdim : ringKrullDim A = 1) {x : A} (hxm : x ∈ maximalIdeal A) (hx : x ≠ 0) :
    (Ideal.span {x}).radical = maximalIdeal A :=
  le_antisymm
    ((IsLocalRing.maximalIdeal.isMaximal A).isPrime.radical_le_iff.2
      ((Ideal.span_singleton_le_iff_mem _).2 hxm))
    (((ringKrullDim_eq_one_iff_of_isLocalRing_isDomain).mp hdim).2 _ hx)

end TauCeti
