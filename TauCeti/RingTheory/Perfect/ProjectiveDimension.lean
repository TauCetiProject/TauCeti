module

public import Mathlib.RingTheory.TensorProduct.Quotient
public import TauCeti.Algebra.Category.ModuleCat.Projective.SequentialColimit
public import TauCeti.RingTheory.Flat.ProjectiveDimension
public import TauCeti.RingTheory.Perfect.PerfectClosure
public import TauCeti.RingTheory.RegularLocalRing.Frobenius
public import TauCeti.RingTheory.RegularLocalRing.ProjectiveDimension

/-!
# Projective dimension over the perfection of a ring

Let `K` be a ring of exponential characteristic `p` whose Frobenius endomorphism is flat, and let
`i : K →+* L` be a perfect closure of `K`, for instance Mathlib's colimit perfection
`PerfectClosure K p`. If every `K`-module has projective dimension at most `n`, then every
`L`-module has projective dimension at most `n + 1`. By Kunz's theorem this applies to a regular
ring `K` of finite Krull dimension `d`, giving the bound `d + 1` over its perfection.

The perfection of a regular ring is not Noetherian, and the bound `d + 1` can be attained. For a
perfect field `k` and `L` the perfection of `k[t]`, the ideal `J` generated by the roots
`t ^ (1 / p ^ k)` is not projective: a nonzero projective ideal of a domain is finitely generated,
while `J = J ^ 2` is a proper nonzero ideal. Hence the residue field `L ⧸ J` has projective
dimension `2`.

## Proof

It suffices to bound the projective dimensions of the cyclic modules `L ⧸ I`. Write `ψₖ` for the
ring homomorphism `x ↦ i(x) ^ (1 / p ^ k)`. Since `L` is the union of the images of the `ψₖ`, the
ideal `I` is the increasing union of the ideals `Iₖ` generated by `ψₖ(ψₖ⁻¹(I))`, so `L ⧸ I` is the
colimit of the quotients `L ⧸ Iₖ` (`ModuleCat.hasProjectiveDimensionLT_succ_quotient_iSup`). Each
of these is the base change of the `K`-module `K ⧸ ψₖ⁻¹(I)` along `ψₖ`, which is flat because
Frobenius is (`RingHom.Flat.of_isPerfectClosure`), so it has projective dimension at most `n`
(`ModuleCat.hasProjectiveDimensionLT_tensorProduct`). The colimit of a sequence of modules of
projective dimension at most `n` has projective dimension at most `n + 1`.

## Main results

* `TauCeti.hasProjectiveDimensionLE_succ_of_isPerfectClosure`: if Frobenius of `K` is flat and
  every `K`-module has projective dimension at most `n`, every module over a perfect closure of `K`
  has projective dimension at most `n + 1`.
* `TauCeti.IsRegularRing.hasProjectiveDimensionLE_succ_of_isPerfectClosure`: every module over a
  perfect closure of a regular ring of characteristic `p` and Krull dimension at most `n` has
  projective dimension at most `n + 1`.

## References

* B. Bhatt and P. Scholze, *Projectivity of the Witt vector affine Grassmannian*,
  Invent. Math. 209 (2017), Proposition 11.31 and its proof.
-/

public section

open CategoryTheory

universe u

namespace TauCeti

variable {K L : Type u} [CommRing K] [CommRing L] (i : K →+* L) (p : ℕ) [ExpChar K p]
  [ExpChar L p] [PerfectRing L p] [IsPerfectClosure i p]

include i in
/-- **Projective dimension over a perfect closure.** Let `K` be a ring of exponential
characteristic `p` with flat Frobenius, and `i : K →+* L` a perfect closure of `K`. If every
`K`-module has projective dimension at most `n`, then every `L`-module has projective dimension at
most `n + 1`. -/
theorem hasProjectiveDimensionLE_succ_of_isPerfectClosure (hF : (frobenius K p).Flat) {n : ℕ}
    (hK : ∀ M : ModuleCat.{u} K, HasProjectiveDimensionLE M n) (M : ModuleCat.{u} L) :
    HasProjectiveDimensionLE M (n + 1) := by
  refine ModuleCat.hasProjectiveDimensionLE_of_quotients (n + 1) (fun I ↦ ?_) M
  -- The `p ^ k`-th roots `ψ k x = i(x) ^ (1 / p ^ k)` of the images of elements of `K`.
  let ψ (k : ℕ) : K →+* L := ((iterateFrobeniusEquiv L p k).symm : L →+* L).comp i
  have hψ (k : ℕ) (x : K) : ψ (k + 1) (x ^ p) = ψ k x := by
    apply (iterateFrobeniusEquiv L p (k + 1)).injective
    simp only [ψ, RingHom.coe_comp, RingHom.coe_coe, Function.comp_apply,
      RingEquiv.apply_symm_apply, map_pow]
    rw [iterateFrobeniusEquiv_def, pow_succ, pow_mul, ← iterateFrobeniusEquiv_def,
      RingEquiv.apply_symm_apply]
  -- The ideals `Iₖ = ψₖ(ψₖ⁻¹(I))` increase, with union `I`.
  have hmono : Monotone fun k ↦ (I.comap (ψ k)).map (ψ k) := by
    refine monotone_nat_of_le_succ fun k ↦ Ideal.map_le_iff_le_comap.2 fun x hx ↦ ?_
    rw [Ideal.mem_comap, ← hψ k x]
    exact Ideal.mem_map_of_mem _ (by rwa [Ideal.mem_comap, hψ k x])
  have hsup : ⨆ k, (I.comap (ψ k)).map (ψ k) = I := by
    refine le_antisymm (iSup_le fun k ↦ Ideal.map_comap_le) fun y hy ↦ ?_
    obtain ⟨k, x, hx⟩ := IsPRadical.pow_mem i p y
    have hxy : ψ k x = y := by
      rw [← (iterateFrobeniusEquiv L p k).injective.eq_iff]
      simp only [ψ, RingHom.coe_comp, RingHom.coe_coe, Function.comp_apply,
        RingEquiv.apply_symm_apply, iterateFrobeniusEquiv_def, hx]
    exact Ideal.mem_iSup_of_mem k (hxy ▸ Ideal.mem_map_of_mem _ (by rwa [Ideal.mem_comap, hxy]))
  -- Each `L ⧸ Iₖ` is the base change of `K ⧸ ψₖ⁻¹(I)` along the flat map `ψₖ`.
  have hstage (k : ℕ) :
      HasProjectiveDimensionLE (ModuleCat.of L (L ⧸ (I.comap (ψ k)).map (ψ k))) n := by
    have hflat : (ψ k).Flat := (RingHom.Flat.of_isPerfectClosure i p hF).comp
      (RingHom.Flat.of_bijective (iterateFrobeniusEquiv L p k).symm.bijective)
    algebraize [ψ k]
    have := ModuleCat.hasProjectiveDimensionLT_tensorProduct L _ (hK (.of K (K ⧸ I.comap (ψ k))))
    exact hasProjectiveDimensionLT_of_iso
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot L
        (I.comap (ψ k))).toLinearEquiv.toModuleIso.symm _
  have := ModuleCat.hasProjectiveDimensionLT_succ_quotient_iSup hmono (n + 1) hstage
  have : HasProjectiveDimensionLE (ModuleCat.of L (L ⧸ I)) (n + 1) :=
    hasProjectiveDimensionLT_of_iso (Submodule.quotEquivOfEq _ _ hsup).toModuleIso _
  exact hasProjectiveDimensionLT_of_iso (Shrink.linearEquiv L (L ⧸ I)).symm.toModuleIso _

include i p in
/-- **Projective dimension over the perfection of a regular ring.** Let `K` be a regular ring of
exponential characteristic `p` and Krull dimension at most `n`, and `i : K →+* L` a perfect closure
of `K`, for instance `PerfectClosure K p`. Then every `L`-module has projective dimension at most
`n + 1`. -/
theorem IsRegularRing.hasProjectiveDimensionLE_succ_of_isPerfectClosure [IsRegularRing K] {n : ℕ}
    (hn : ringKrullDim K ≤ n) (M : ModuleCat.{u} L) : HasProjectiveDimensionLE M (n + 1) :=
  TauCeti.hasProjectiveDimensionLE_succ_of_isPerfectClosure i p (IsRegularRing.flat_frobenius p)
    (IsRegularRing.hasProjectiveDimensionLE hn) M

end TauCeti
