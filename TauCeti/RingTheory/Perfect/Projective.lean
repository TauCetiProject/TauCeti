module

public import Mathlib.FieldTheory.Perfect
public import TauCeti.RingTheory.FittingIdeal.Projective
public import TauCeti.RingTheory.FittingIdeal.Semilinear

/-!
# Finitely presented Frobenius modules over a perfect ring are projective

Let `R` be a perfect ring of characteristic `p`, let `a ≥ 1`, and let `φ^a` be the `a`-th power
of its Frobenius, `x ↦ x ^ p ^ a`. A `φ^a`-module structure on a finitely presented `R`-module `M`
is an isomorphism `R ⊗_{R, φ^a} M ≅ M`; since `φ^a` is an automorphism of `R`, this is the same as
an additive automorphism `F` of `M` with `F (r • x) = r ^ p ^ a • F x`. Such an `M` is projective.

The proof goes through Fitting ideals. Transport of structure along `(φ^a, F)` shows that each
Fitting ideal `J = Fitt_k(M)` satisfies `J = φ^a(J) R`. But `φ^a(J) R` is generated by
`p ^ a`-th powers of elements of `J`, so it lies in `J ^ (p ^ a) ≤ J ^ 2`; hence `J = J ^ 2`. A
finitely presented module whose Fitting ideals are idempotent is projective
(`TauCeti.projective_iff_forall_isIdempotentElem_fittingIdeal`).

The finitely generated ideals `J` with `J ≤ φ^a(J) R` are thus generated by idempotents
(`Ideal.isIdempotentElem_iff_of_fg`). The inclusion cannot be reversed: in the perfection of
`𝔽_p[T]` the ideal `(T)` contains `φ((T)) R = (T ^ p)` but is not idempotent.

The perfectness of `R` is needed. Over `𝔽_p[U]`, the identity of `𝔽_p[U] ⧸ (U)` is an additive
automorphism semilinear along the Frobenius, but this module is not projective; its Frobenius
linearization `𝔽_p[U] ⧸ (U ^ p) → 𝔽_p[U] ⧸ (U)` is not an isomorphism.

Since `W₁(R) = R`, this is the case `n = 1` of the projectivity of finitely presented modules
over the truncated Witt vectors `W_n(R)` which are flat over `ℤ ⧸ p ^ n` and carry an invertible
Frobenius linearization (Kedlaya–Liu, Proposition 3.2.13).

## Main results

* `Ideal.isIdempotentElem_of_le_map_iterateFrobenius`: an ideal `J` with `J ≤ φ^a(J) R` for some
  `a ≥ 1` is idempotent.
* `TauCeti.projective_of_addEquiv_iterateFrobenius`: a finitely presented module over a perfect
  ring of characteristic `p`, with an additive automorphism semilinear along `φ^a` for some
  `a ≥ 1`, is projective.

## References

* K. S. Kedlaya and R. Liu, *Relative p-adic Hodge theory: foundations*, Astérisque 371 (2015),
  Lemma 3.2.12 and Proposition 3.2.13.
-/

public section

noncomputable section

namespace Ideal

variable {R : Type*} [CommRing R] {p : ℕ} [ExpChar R p] [Fact p.Prime] {a : ℕ}

/-- An ideal contained in the ideal generated by the `p ^ a`-th powers of its elements, for some
`a ≥ 1`, is idempotent. In particular a finitely generated ideal `J` of a perfect ring with
`φ(J) = J` is generated by an idempotent element (`Ideal.isIdempotentElem_iff_of_fg`). -/
theorem isIdempotentElem_of_le_map_iterateFrobenius (ha : a ≠ 0) {J : Ideal R}
    (h : J ≤ J.map (iterateFrobenius R p a)) : IsIdempotentElem J := by
  have hp : 2 ≤ p ^ a := Nat.one_lt_pow ha (Fact.out : p.Prime).one_lt
  -- The `p ^ a`-th powers of elements of `J` lie in `J ^ (p ^ a) ≤ J ^ 2`.
  have hle : J.map (iterateFrobenius R p a) ≤ J ^ 2 := by
    refine map_le_iff_le_comap.2 fun x hx ↦ ?_
    rw [mem_comap, iterateFrobenius_def]
    exact pow_le_pow_right hp (pow_mem_pow hx _)
  exact le_antisymm mul_le_left (sq J ▸ h.trans hle)

end Ideal

namespace TauCeti

open Module

variable {R M : Type*} [CommRing R] (p : ℕ) [ExpChar R p] [Fact p.Prime] [PerfectRing R p]
  [AddCommGroup M] [Module R M] [Module.FinitePresentation R M]

attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm in
/-- **Frobenius modules over a perfect ring are projective.** Let `R` be a perfect ring of
characteristic `p` and `a ≥ 1`. A finitely presented `R`-module `M` with an additive automorphism
`F` satisfying `F (r • x) = r ^ p ^ a • F x`, that is, with an invertible `φ^a`-linearization,
is projective. -/
theorem projective_of_addEquiv_iterateFrobenius {a : ℕ} (ha : a ≠ 0) (F : M ≃+ M)
    (hF : ∀ (r : R) (x : M), F (r • x) = iterateFrobenius R p a r • F x) :
    Projective R M := by
  let e : M ≃ₛₗ[(iterateFrobeniusEquiv R p a : R →+* R)] M :=
    { F with map_smul' := hF }
  refine (projective_iff_forall_isIdempotentElem_fittingIdeal).2 fun k ↦
    Ideal.isIdempotentElem_of_le_map_iterateFrobenius (p := p) ha ?_
  exact (fittingIdeal_eq_map_of_semilinearEquiv e k).le

end TauCeti
