/-!
# Frobenius-root ideals in perfect rings

Let `R` be a perfect ring of exponential characteristic `p` and let `f ∈ R`. Writing
`f ^ (1 / p ^ n)` for the unique `p ^ n`-th root `(iterateFrobeniusEquiv R p n).symm f` of `f`,
the *Frobenius-root ideal* of `f` is the increasing union
`J_f = ⋃ₙ (f ^ (1 / p ^ n))` of principal ideals.

When `p` is prime, we show that `J_f` is the radical of the principal ideal `(f)` and that it is
idempotent. When moreover `R` is a ring, `J_f` is a flat `R`-module, with no assumption that `R`
be a domain, and we present `J_f` as a sequential colimit: the colimit of copies of `R` along the
multiplication maps by `f ^ (1 / p ^ n - 1 / p ^ (n + 1))` maps isomorphically onto `J_f`, by
sending `a` at stage `n` to `f ^ (1 / p ^ n) * a`.

Thus `0 → J_f → R → R ⧸ √(f) → 0` is a flat resolution of length one. Such resolutions are the
building blocks of the Tor independence of perfect rings.

## Main definitions

* `TauCeti.frobeniusRootIdeal R p f`: the ideal `J_f = ⋃ₙ (f ^ (1 / p ^ n))`.
* `TauCeti.frobeniusRootTransition R p f`: the transition maps of the sequential colimit
  presentation of `J_f`.
* `TauCeti.frobeniusRootDirectLimitEquiv R p f`: the colimit presentation of `J_f`.

## Main results

* `TauCeti.mem_frobeniusRootIdeal`: `x ∈ J_f` iff some `f ^ (1 / p ^ n)` divides `x`.
* `TauCeti.map_iterateFrobeniusEquiv_frobeniusRootIdeal`: `J_f` is stable under Frobenius.
* `TauCeti.frobeniusRootIdeal_eq_radical`: `J_f = √(f)`.
* `TauCeti.frobeniusRootDirectLimitEquiv_of`: the colimit presentation on each stage.
* `TauCeti.isIdempotentElem_frobeniusRootIdeal`: `J_f * J_f = J_f`.
* `TauCeti.flat_frobeniusRootIdeal`: `J_f` is a flat `R`-module.

## References

* B. Bhatt and P. Scholze, *Projectivity of the Witt vector affine Grassmannian*,
  Invent. Math. 209 (2017), proof of Lemma 3.16.
-/

public section

namespace TauCeti

section CommSemiring

variable (R : Type*) [CommSemiring R] (p : ℕ) [ExpChar R p] [PerfectRing R p]

/-- The *Frobenius-root ideal* `J_f = ⋃ₙ (f ^ (1 / p ^ n))` of an element `f` of a perfect ring
`R` of exponential characteristic `p`: the supremum of the principal ideals generated by the
`p ^ n`-th roots of `f`. For prime `p`, it equals the radical of `(f)`
(`TauCeti.frobeniusRootIdeal_eq_radical`). -/
noncomputable def frobeniusRootIdeal (f : R) : Ideal R :=
  ⨆ n : ℕ, Ideal.span {(iterateFrobeniusEquiv R p n).symm f}

variable {R p}

/-- An element of `R` belongs to the Frobenius-root ideal of `f` if and only if it is divisible
by some `p ^ n`-th root of `f`. -/
theorem mem_frobeniusRootIdeal {f x : R} :
    x ∈ frobeniusRootIdeal R p f ↔ ∃ n, (iterateFrobeniusEquiv R p n).symm f ∣ x := by
  rw [frobeniusRootIdeal, Submodule.mem_iSup_of_directed]
  · simp only [Ideal.mem_span_singleton]
  · refine Monotone.directed_le fun m n h ↦ ?_
    exact Ideal.span_singleton_le_span_singleton.mpr (iterateFrobeniusEquiv_symm_dvd_of_le f h)

/-- The Frobenius-root ideal of `f` is the ideal generated by all `p ^ n`-th roots of `f`. -/
theorem frobeniusRootIdeal_eq_span_range (f : R) :
    frobeniusRootIdeal R p f =
      Ideal.span (Set.range fun n ↦ (iterateFrobeniusEquiv R p n).symm f) :=
  (Submodule.span_range_eq_iSup ..).symm

/-- Every `p ^ n`-th root of `f` lies in the Frobenius-root ideal of `f`. -/
theorem iterateFrobeniusEquiv_symm_mem_frobeniusRootIdeal (f : R) (n : ℕ) :
    (iterateFrobeniusEquiv R p n).symm f ∈ frobeniusRootIdeal R p f :=
  mem_frobeniusRootIdeal.mpr ⟨n, dvd_rfl⟩

/-- An element lies in its own Frobenius-root ideal. -/
@[simp]
theorem self_mem_frobeniusRootIdeal (f : R) : f ∈ frobeniusRootIdeal R p f := by
  simpa using iterateFrobeniusEquiv_symm_mem_frobeniusRootIdeal (p := p) f 0

/-- The Frobenius-root ideal of `f` is stable under the iterated Frobenius `x ↦ x ^ p ^ n`. With
this lemma, `simp` proves that every `p ^ n`-th root of `f` lies in the Frobenius-root ideal
of `f`. -/
@[simp]
theorem map_iterateFrobeniusEquiv_frobeniusRootIdeal (f : R) (n : ℕ) :
    (frobeniusRootIdeal R p f).map (iterateFrobeniusEquiv R p n) = frobeniusRootIdeal R p f := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun x hx ↦ ?_) fun x hx ↦ ?_
  · rw [Ideal.mem_comap, iterateFrobeniusEquiv_def]
    exact Ideal.pow_mem_of_mem _ hx _ (pow_pos (expChar_pos R p) n)
  · -- The `p ^ n`-th root of a multiple of `f ^ (1 / p ^ m)` is a multiple of
    -- `f ^ (1 / p ^ (n + m))`.
    rw [← RingEquiv.apply_symm_apply (iterateFrobeniusEquiv R p n) x]
    refine Ideal.mem_map_of_mem _ ?_
    obtain ⟨m, a, rfl⟩ := mem_frobeniusRootIdeal.mp hx
    rw [map_mul, ← iterateFrobeniusEquiv_symm_add_apply]
    exact Ideal.mul_mem_right _ _ (iterateFrobeniusEquiv_symm_mem_frobeniusRootIdeal f _)

/-- Finitely many elements of the Frobenius-root ideal of `f` are all divisible by a single
`p ^ n`-th root of `f`. -/
private theorem exists_root_dvd_of_mem {ι : Type*} [Finite ι] {f : R} {x : ι → R}
    (hx : ∀ i, x i ∈ frobeniusRootIdeal R p f) :
    ∃ n, ∀ i, (iterateFrobeniusEquiv R p n).symm f ∣ x i := by
  have := Fintype.ofFinite ι
  choose m hm using fun i ↦ mem_frobeniusRootIdeal.mp (hx i)
  exact ⟨Finset.univ.sup m, fun i ↦
    (iterateFrobeniusEquiv_symm_dvd_of_le f (Finset.le_sup (Finset.mem_univ i))).trans (hm i)⟩

/-- The Frobenius-root ideal of `0` is zero. -/
@[simp]
theorem frobeniusRootIdeal_zero : frobeniusRootIdeal R p 0 = ⊥ := by
  simp [frobeniusRootIdeal]

/-- The Frobenius-root ideal of `1` is the unit ideal. -/
@[simp]
theorem frobeniusRootIdeal_one : frobeniusRootIdeal R p 1 = ⊤ :=
  (Ideal.eq_top_iff_one _).mpr (self_mem_frobeniusRootIdeal 1)

variable (R p)

/-- The transition maps of the sequential colimit presentation of the Frobenius-root ideal of
`f`: from stage `m` to stage `n ≥ m`, multiplication by `f ^ (1 / p ^ m - 1 / p ^ n)`, the
`(p ^ (n - m) - 1)`-st power of the `p ^ n`-th root of `f`. -/
noncomputable def frobeniusRootTransition (f : R) (m n : ℕ) (_ : m ≤ n) : R →ₗ[R] R :=
  LinearMap.mulLeft R ((iterateFrobeniusEquiv R p n).symm f ^ (p ^ (n - m) - 1))

variable {R p}

/-- The transition from stage `m` to stage `n` multiplies by the `(p ^ (n - m) - 1)`-st power of
the `p ^ n`-th root of `f`. -/
@[simp]
theorem frobeniusRootTransition_apply (f : R) {m n : ℕ} (h : m ≤ n) (a : R) :
    frobeniusRootTransition R p f m n h a =
      (iterateFrobeniusEquiv R p n).symm f ^ (p ^ (n - m) - 1) * a :=
  (rfl)

/-- The transition from stage `m` to stage `n`, followed by multiplication by the `p ^ n`-th root
of `f`, is multiplication by the `p ^ m`-th root of `f`. -/
theorem frobeniusRootTransition_apply_mul_iterateFrobeniusEquiv_symm (f : R) {m n : ℕ} (h : m ≤ n)
    (a : R) :
    frobeniusRootTransition R p f m n h a * (iterateFrobeniusEquiv R p n).symm f =
      a * (iterateFrobeniusEquiv R p m).symm f := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [frobeniusRootTransition_apply, Nat.add_sub_cancel_left,
    ← iterateFrobeniusEquiv_symm_add_pow f m k,
    ← pow_sub_one_mul (pow_ne_zero k (expChar_ne_zero R p))]
  ring

/-- The transition maps of the colimit presentation of the Frobenius-root ideal form a directed
system. -/
instance (f : R) : DirectedSystem (fun _ : ℕ ↦ R) fun m n h ↦ frobeniusRootTransition R p f m n h
    where
  map_self m a := by simp
  map_map k j i hij hjk a := by
    obtain ⟨u, rfl⟩ := Nat.exists_eq_add_of_le hij
    obtain ⟨v, rfl⟩ := Nat.exists_eq_add_of_le hjk
    have hu := Nat.one_le_pow u p (expChar_pos R p)
    have hv := Nat.one_le_pow v p (expChar_pos R p)
    have huv := Nat.one_le_pow (u + v) p (expChar_pos R p)
    -- The exponents of the `p ^ (i + u + v)`-th root agree.
    have he : p ^ v - 1 + p ^ v * (p ^ u - 1) = p ^ (u + v) - 1 := by
      zify [hu, hv, huv]
      ring
    simp only [frobeniusRootTransition_apply, add_assoc, add_tsub_cancel_left, Nat.add_sub_add_left]
    rw [← he, ← add_assoc, ← iterateFrobeniusEquiv_symm_add_pow f (i + u) v]
    ring

/-- The map from the colimit of `frobeniusRootTransition` to the Frobenius-root ideal of `f`,
sending `a` at stage `n` to `f ^ (1 / p ^ n) * a`. -/
private noncomputable def directLimitLift (f : R) :
    Module.DirectLimit (fun _ : ℕ ↦ R) (frobeniusRootTransition R p f) →ₗ[R]
      frobeniusRootIdeal R p f :=
  Module.DirectLimit.lift R ℕ (fun _ ↦ R) (frobeniusRootTransition R p f)
    (fun n ↦ LinearMap.toSpanSingleton R _
      ⟨_, iterateFrobeniusEquiv_symm_mem_frobeniusRootIdeal f n⟩)
    fun m n h a ↦ Subtype.ext <| by
      simpa only [LinearMap.toSpanSingleton_apply, Submodule.coe_smul, smul_eq_mul] using
        frobeniusRootTransition_apply_mul_iterateFrobeniusEquiv_symm f h a

private theorem directLimitLift_of (f : R) (n : ℕ) (a : R) :
    (directLimitLift f
        (Module.DirectLimit.of R ℕ (fun _ ↦ R) (frobeniusRootTransition R p f) n a) : R) =
      a * (iterateFrobeniusEquiv R p n).symm f := by
  simp [directLimitLift]

section Prime

variable [hp : Fact p.Prime]

/-- **Frobenius-root ideals are radicals.** In a perfect ring, the Frobenius-root ideal of `f`
is the radical of the principal ideal `(f)`. -/
theorem frobeniusRootIdeal_eq_radical (f : R) :
    frobeniusRootIdeal R p f = (Ideal.span {f}).radical := by
  refine le_antisymm (iSup_le fun n ↦ ?_) fun x ⟨m, hm⟩ ↦ ?_
  · rw [Ideal.span_singleton_le_iff_mem]
    refine ⟨p ^ n, ?_⟩
    rw [← iterateFrobeniusEquiv_def, RingEquiv.apply_symm_apply]
    exact Ideal.mem_span_singleton_self f
  · -- `x ^ p ^ m` is a multiple `f * c`; taking `p ^ m`-th roots, `x` is a multiple of the
    -- `p ^ m`-th root of `f`.
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp
      (Ideal.mul_mem_left _ (x ^ (p ^ m - m)) hm)
    rw [← pow_add, Nat.sub_add_cancel (Nat.lt_pow_self hp.out.one_lt).le,
      ← iterateFrobeniusEquiv_def] at hc
    refine mem_frobeniusRootIdeal.mpr ⟨m, ⟨(iterateFrobeniusEquiv R p m).symm c, ?_⟩⟩
    rw [← map_mul, mul_comm, hc, RingEquiv.symm_apply_apply]

/-- **Frobenius-root ideals are idempotent**: `J_f * J_f = J_f`. -/
theorem isIdempotentElem_frobeniusRootIdeal (f : R) :
    IsIdempotentElem (frobeniusRootIdeal R p f) := by
  refine le_antisymm Ideal.mul_le_right fun x hx ↦ ?_
  obtain ⟨n, a, rfl⟩ := mem_frobeniusRootIdeal.mp hx
  rw [← iterateFrobeniusEquiv_symm_succ_pow f n, ← pow_sub_one_mul hp.out.ne_zero,
    mul_comm _ ((iterateFrobeniusEquiv R p (n + 1)).symm f), mul_assoc]
  refine Ideal.mul_mem_mul (iterateFrobeniusEquiv_symm_mem_frobeniusRootIdeal f _)
    (Ideal.mul_mem_right _ _ ?_)
  exact Ideal.pow_mem_of_mem _ (iterateFrobeniusEquiv_symm_mem_frobeniusRootIdeal f _) _
    (Nat.sub_pos_of_lt hp.out.one_lt)

end Prime

end CommSemiring

section CommRing

variable {R : Type*} [CommRing R] {p : ℕ} [ExpChar R p] [PerfectRing R p] [hp : Fact p.Prime]

/-- **Frobenius-root ideals are flat**, also when `R` has zero divisors. -/
instance flat_frobeniusRootIdeal (f : R) : Module.Flat R (frobeniusRootIdeal R p f) := by
  -- All `x i` are multiples of one root `f ^ (1 / p ^ n)`. If `c * f ^ (1 / p ^ n) = 0`, then
  -- `c * f ^ ((p - 1) / p ^ (n + 1)) = 0` because Frobenius is injective, so the relation becomes
  -- trivial through the next root `f ^ (1 / p ^ (n + 1))`.
  refine Module.Flat.of_forall_isTrivialRelation fun {l g x} hgx ↦ ?_
  obtain ⟨n, hn⟩ := exists_root_dvd_of_mem fun i ↦ (x i).2
  choose b hb using hn
  have hrel : (∑ i, g i * b i) * (iterateFrobeniusEquiv R p n).symm f = 0 := by
    have := congr_arg Subtype.val hgx
    simp only [Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul, hb, Submodule.coe_zero] at this
    rw [Finset.sum_mul]
    refine (Finset.sum_congr rfl fun i _ ↦ ?_).trans this
    ring
  refine ⟨1, fun i _ ↦ (iterateFrobeniusEquiv R p (n + 1)).symm f ^ (p - 1) * b i,
    fun _ ↦ ⟨_, iterateFrobeniusEquiv_symm_mem_frobeniusRootIdeal f (n + 1)⟩, fun i ↦ ?_,
    fun _ ↦ ?_⟩
  · ext
    simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton,
      Submodule.coe_smul, smul_eq_mul, hb, ← iterateFrobeniusEquiv_symm_succ_pow f n]
    rw [← pow_sub_one_mul hp.out.ne_zero]
    ring
  · have := mul_iterateFrobeniusEquiv_symm_succ_pow_eq_zero
      (Nat.sub_ne_zero_of_lt hp.out.one_lt) hrel
    rw [Finset.sum_mul] at this
    refine (Finset.sum_congr rfl fun i _ ↦ ?_).trans this
    ring

private theorem bijective_directLimitLift (f : R) :
    Function.Bijective (directLimitLift (p := p) f) := by
  refine ⟨(injective_iff_map_eq_zero _).mpr fun z hz ↦ ?_, fun ⟨y, hy⟩ ↦ ?_⟩
  · -- An element `a` at stage `n` mapping to zero dies at stage `n + 1`.
    obtain ⟨n, a, rfl⟩ := Module.DirectLimit.exists_of z
    have ha : a * (iterateFrobeniusEquiv R p n).symm f = 0 := by
      rw [← directLimitLift_of, hz, ZeroMemClass.coe_zero]
    have hstep : frobeniusRootTransition R p f n (n + 1) n.le_succ a = 0 := by
      rw [frobeniusRootTransition_apply, Nat.add_sub_cancel_left, pow_one, mul_comm]
      exact mul_iterateFrobeniusEquiv_symm_succ_pow_eq_zero (Nat.sub_ne_zero_of_lt hp.out.one_lt)
        ha
    rw [← Module.DirectLimit.of_f (hij := n.le_succ), hstep, map_zero]
  · obtain ⟨n, c, rfl⟩ := mem_frobeniusRootIdeal.mp hy
    exact ⟨Module.DirectLimit.of R ℕ (fun _ ↦ R) _ n c,
      Subtype.ext ((directLimitLift_of f n c).trans (mul_comm _ _))⟩

variable (R p)

/-- **The colimit presentation of a Frobenius-root ideal.** The sequential colimit of copies of
`R` along `frobeniusRootTransition` is isomorphic to the Frobenius-root ideal of `f`, by sending
`a` at stage `n` to `f ^ (1 / p ^ n) * a`. -/
noncomputable def frobeniusRootDirectLimitEquiv (f : R) :
    Module.DirectLimit (fun _ : ℕ ↦ R) (frobeniusRootTransition R p f) ≃ₗ[R]
      frobeniusRootIdeal R p f :=
  LinearEquiv.ofBijective (directLimitLift f) (bijective_directLimitLift f)

variable {R p}

/-- The colimit presentation sends `a` at stage `n` to `f ^ (1 / p ^ n) * a`. -/
@[simp]
theorem frobeniusRootDirectLimitEquiv_of (f : R) (n : ℕ) (a : R) :
    (frobeniusRootDirectLimitEquiv R p f
        (Module.DirectLimit.of R ℕ (fun _ ↦ R) (frobeniusRootTransition R p f) n a) : R) =
      a * (iterateFrobeniusEquiv R p n).symm f := by
  rw [frobeniusRootDirectLimitEquiv, LinearEquiv.ofBijective_apply, directLimitLift_of]

end CommRing

end TauCeti
