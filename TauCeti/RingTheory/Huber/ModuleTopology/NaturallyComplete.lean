public import TauCeti.RingTheory.Huber.ClosedSubmodule
public import TauCeti.Topology.Algebra.Module.Finite
import TauCeti.Topology.Algebra.Module.ModuleTopology

/-!
# Naturally complete modules

An `A`-module `M` over a topological ring is *naturally complete* if it is complete and Hausdorff
for its natural topology, Mathlib's `moduleTopology A M` with the canonical uniformity of a
commutative topological group (Kedlaya–Liu II, Definition 1.2.2). This is the analytic half of
Kedlaya–Liu's strict pseudocoherence: a strictly pseudocoherent module over a complete Tate ring
is a pseudocoherent module that is naturally complete, and the stably pseudocoherent modules,
whose base changes to rational localisations are pseudocoherent and naturally complete, are the
modules that glue to coherent sheaves on non-noetherian adic spaces.

For a finite module over a complete first-countable ring, completeness is automatic
(`TauCeti.completeSpace_moduleTopology`), so natural completeness is the Hausdorff property
(`TauCeti.Huber.isNaturallyComplete_iff_t2Space`), and that is closedness of the kernel of any
presentation (`TauCeti.Huber.isNaturallyComplete_iff_isClosed_ker`; Kedlaya–Liu II, Remark 1.2.3).
Finite projective modules over a complete Hausdorff first-countable ring are naturally complete
(Kedlaya–Liu II, Remark 1.2.4). Over a complete Hausdorff Tate ring, a submodule of a naturally
complete finite module whose closure is finitely generated is closed and itself naturally complete,
and a dense submodule is everything (Kedlaya–Liu II, Corollary 1.2.11). Finite generation of the
submodule alone is not enough: the ideal `x · C(ℤ_p, ℚ_p)` generated by the identity function is not
closed in the Banach algebra `C(ℤ_p, ℚ_p)`.

## Main definitions

* `TauCeti.Huber.IsNaturallyComplete`: `M` is complete and Hausdorff for its natural topology.

## Main results

* `TauCeti.Huber.isNaturallyComplete_iff`: for any uniform additive group structure on `M` whose
  topology is the module topology, natural completeness is completeness together with the Hausdorff
  property.
* `TauCeti.Huber.isNaturallyComplete_iff_t2Space`: a finite module over a complete first-countable
  ring is naturally complete exactly when its module topology is Hausdorff.
* `TauCeti.Huber.isNaturallyComplete_iff_isClosed_ker`: it is naturally complete exactly when the
  kernel of a linear surjection onto it from a module with its module topology is closed.
* `TauCeti.Huber.IsNaturallyComplete.of_projective`: finite projective modules over a complete
  Hausdorff first-countable ring are naturally complete.
* `TauCeti.Huber.IsNaturallyComplete.of_injective`: a finite module embedding linearly into a
  naturally complete module is naturally complete.
* `TauCeti.Huber.IsNaturallyComplete.isClosed_of_module_finite_topologicalClosure` and
  `TauCeti.Huber.IsNaturallyComplete.submodule_of_module_finite_topologicalClosure`: over a complete
  Hausdorff Tate ring, a submodule of a naturally complete finite module whose closure is finitely
  generated is closed and naturally complete.
* `TauCeti.Huber.IsNaturallyComplete.eq_top_of_dense`: over a complete Hausdorff Tate ring, a dense
  submodule of a naturally complete finite module is everything.

## References

* K. S. Kedlaya and R. Liu, *Relative p-adic Hodge theory, II: Imperfect period rings*, §1.2,
  Definition 1.2.2, Remarks 1.2.3 and 1.2.4, and Corollary 1.2.11.
-/

public section

open Topology
open scoped Uniformity

namespace TauCeti.Huber

section Defs

variable (A : Type*) [Semiring A] [TopologicalSpace A] (M : Type*) [AddCommGroup M] [Module A M]

/-- The `A`-module `M` is *naturally complete* if it is complete and Hausdorff for its natural
topology, Mathlib's `moduleTopology A M`, with the canonical uniformity of a commutative
topological group (Kedlaya–Liu II, Definition 1.2.2). Use `TauCeti.Huber.isNaturallyComplete_iff`
to work with a uniform structure already present on `M`. -/
def IsNaturallyComplete : Prop :=
  letI : TopologicalSpace M := moduleTopology A M
  letI : IsTopologicalAddGroup M := IsModuleTopology.isTopologicalAddGroup A M
  letI : UniformSpace M := IsTopologicalAddGroup.rightUniformSpace M
  CompleteSpace M ∧ T2Space M

variable {A M}

/-- **Natural completeness on a uniform carrier.** If `M` carries a uniform additive group
structure whose topology is the module topology, `M` is naturally complete exactly when it is
complete and Hausdorff. -/
theorem isNaturallyComplete_iff [UniformSpace M] [IsUniformAddGroup M] [IsModuleTopology A M] :
    IsNaturallyComplete A M ↔ CompleteSpace M ∧ T2Space M := by
  -- Any topology equal to the module topology, with any topological group structure, unfolds
  -- `IsNaturallyComplete` in the same way.
  have key (τ : TopologicalSpace M) (hτ : τ = moduleTopology A M) (_ : IsTopologicalAddGroup M) :
      IsNaturallyComplete A M ↔
        letI : UniformSpace M := IsTopologicalAddGroup.rightUniformSpace M
        CompleteSpace M ∧ T2Space M := by
    subst hτ
    rfl
  -- The uniformity of a uniform additive group is the one determined by its topology.
  rw [key _ (eq_moduleTopology A M) inferInstance, IsUniformAddGroup.rightUniformSpace_eq]

/-- A naturally complete module is Hausdorff for its natural topology. -/
theorem IsNaturallyComplete.t2Space (h : IsNaturallyComplete A M) :
    @T2Space M (moduleTopology A M) :=
  h.2

end Defs

section Finite

variable {A : Type*} [Ring A] [UniformSpace A] [IsTopologicalRing A] [IsUniformAddGroup A]
  [CompleteSpace A] [FirstCountableTopology A]
  {M : Type*} [AddCommGroup M] [Module A M]

/-- **A finite module over a complete first-countable ring is naturally complete exactly when its
module topology is Hausdorff** (Kedlaya–Liu II, Remark 1.2.3): completeness is automatic, by
`TauCeti.completeSpace_moduleTopology`. -/
theorem isNaturallyComplete_iff_t2Space [Module.Finite A M] :
    IsNaturallyComplete A M ↔ @T2Space M (moduleTopology A M) :=
  ⟨IsNaturallyComplete.t2Space, fun h ↦ ⟨completeSpace_moduleTopology, h⟩⟩

/-- **A finite module over a complete first-countable ring is naturally complete exactly when the
kernel of a presentation is closed** (Kedlaya–Liu II, Remark 1.2.3). Here `q : F → M` is any
linear surjection from a module with its module topology, for instance a surjection from a finite
free module. -/
theorem isNaturallyComplete_iff_isClosed_ker [Module.Finite A M] {F : Type*} [AddCommGroup F]
    [Module A F] [TopologicalSpace F] [IsModuleTopology A F] {q : F →ₗ[A] M}
    (hq : Function.Surjective q) :
    IsNaturallyComplete A M ↔ IsClosed (LinearMap.ker q : Set F) :=
  isNaturallyComplete_iff_t2Space.trans (t2Space_moduleTopology_iff_isClosed_ker hq)

/-- **Finite projective modules are naturally complete** (Kedlaya–Liu II, Remark 1.2.4): over a
complete Hausdorff first-countable ring, a finite projective module is complete and Hausdorff for
its natural topology. -/
theorem IsNaturallyComplete.of_projective [T2Space A] [Module.Finite A M]
    [Module.Projective A M] : IsNaturallyComplete A M :=
  isNaturallyComplete_iff_t2Space.2 t2Space_moduleTopology_of_projective

/-- **A finite module embedding into a naturally complete module is naturally complete.** If
`f : N → M` is an injective linear map, `N` is finite and `M` is naturally complete, then `N` is
naturally complete: `f` is continuous for the module topologies, so it pulls back the Hausdorff
property, and completeness of `N` is automatic. -/
theorem IsNaturallyComplete.of_injective {N : Type*} [AddCommGroup N] [Module A N]
    [Module.Finite A N] (h : IsNaturallyComplete A M) {f : N →ₗ[A] M}
    (hf : Function.Injective f) : IsNaturallyComplete A N := by
  let _ : TopologicalSpace M := moduleTopology A M
  let _ : TopologicalSpace N := moduleTopology A N
  have _ : IsModuleTopology A M := ⟨rfl⟩
  have _ : IsModuleTopology A N := ⟨rfl⟩
  have _ : ContinuousAdd M := IsModuleTopology.toContinuousAdd A M
  have _ : T2Space M := h.t2Space
  exact isNaturallyComplete_iff_t2Space.2
    (.of_injective_continuous hf (IsModuleTopology.continuous_of_linearMap f))

end Finite

section Tate

variable {A : Type*} [CommRing A] [UniformSpace A] [IsTopologicalRing A] [IsUniformAddGroup A]
  [CompleteSpace A] [T2Space A] [IsTateRing A]
  {M : Type*} [AddCommGroup M] [Module A M] [Module.Finite A M] [UniformSpace M]
  [IsUniformAddGroup M] [IsModuleTopology A M]

/-- **A submodule with finitely generated closure in a naturally complete finite module is
closed** (Kedlaya–Liu II, Corollary 1.2.11), over a complete Hausdorff Tate ring. -/
theorem IsNaturallyComplete.isClosed_of_module_finite_topologicalClosure
    (h : IsNaturallyComplete A M) {N : Submodule A M}
    (hN : Module.Finite A N.topologicalClosure) : IsClosed (N : Set M) := by
  obtain ⟨_, _⟩ := isNaturallyComplete_iff.1 h
  have : (𝓤 A).IsCountablyGenerated := IsUniformAddGroup.uniformity_countably_generated
  have : FirstCountableTopology M := by
    rw [eq_moduleTopology A M]
    exact firstCountableTopology_moduleTopology
  have : (𝓤 M).IsCountablyGenerated := IsUniformAddGroup.uniformity_countably_generated
  exact Huber.isClosed_of_module_finite_topologicalClosure N hN

/-- **A dense submodule of a naturally complete finite module is everything** (Kedlaya–Liu II,
Corollary 1.2.11), over a complete Hausdorff Tate ring. -/
theorem IsNaturallyComplete.eq_top_of_dense (h : IsNaturallyComplete A M) {N : Submodule A M}
    (hN : Dense (N : Set M)) : N = ⊤ := by
  obtain ⟨_, _⟩ := isNaturallyComplete_iff.1 h
  have : (𝓤 A).IsCountablyGenerated := IsUniformAddGroup.uniformity_countably_generated
  have : FirstCountableTopology M := by
    rw [eq_moduleTopology A M]
    exact firstCountableTopology_moduleTopology
  have : (𝓤 M).IsCountablyGenerated := IsUniformAddGroup.uniformity_countably_generated
  exact Huber.eq_top_of_dense_of_module_finite N hN

/-- **A submodule with finitely generated closure in a naturally complete finite module is
naturally complete** (Kedlaya–Liu II, Corollary 1.2.11), over a complete Hausdorff Tate ring: it
is closed, hence equal to its closure and finite. -/
theorem IsNaturallyComplete.submodule_of_module_finite_topologicalClosure
    (h : IsNaturallyComplete A M) {N : Submodule A M}
    (hN : Module.Finite A N.topologicalClosure) : IsNaturallyComplete A N := by
  have hclosed : N.topologicalClosure = N :=
    (h.isClosed_of_module_finite_topologicalClosure hN).submodule_topologicalClosure_eq
  have : Module.Finite A N := hclosed ▸ hN
  have : FirstCountableTopology A :=
    have : (𝓤 A).IsCountablyGenerated := IsUniformAddGroup.uniformity_countably_generated
    inferInstance
  exact h.of_injective N.injective_subtype

end Tate

end TauCeti.Huber

end
