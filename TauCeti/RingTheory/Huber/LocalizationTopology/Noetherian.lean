module

public import TauCeti.RingTheory.Huber.Completion.Noetherian
public import TauCeti.RingTheory.Huber.LocalizationTopology.CompleteSeparated.Basic

import Mathlib.RingTheory.Adjoin.FG
import Mathlib.RingTheory.Ideal.Quotient.Noetherian

/-!
# Rational localisations of a Huber ring with a noetherian ring of definition

Let `A` be a Huber ring with a pair of definition `(A₀, I)` whose ring of definition `A₀` is
noetherian, and let `(T, s)` present a rational localisation with `T` finite. The ring of definition
`A₀[T/s]` of the uncompleted localisation `Aₛ` is the `A₀`-subalgebra generated by the finitely
many fractions `t/s`, so it is noetherian by the Hilbert basis theorem. Its completion, the ring of
definition of `A⟨T/s⟩`, is then noetherian too, by the noetherianity of `I`-adic completions
(`TauCeti.Huber.PairOfDefinition.isNoetherianRing_completion`). Hence `A⟨T/s⟩` is again a Huber
ring with a noetherian ring of definition, and in particular of noetherian type.

This is the stability under rational localisation that Huber's sheafiness theorem for rings with a
noetherian ring of definition needs: it makes every ring of sections `𝒪_X(U)` on a rational subset
`U ⊆ Spa(A, A⁺)` satisfy the same hypothesis as `A`, so that the argument may be repeated on `U`.
The noetherianity of the uncompleted ring `A₀[T/s]` is also what lets the finite-module strictness
theorem `TauCeti.Huber.PairOfDefinition.isStrictMap_of_isNoetherianRing` apply over the
uncompleted rational localisations forming the terms of Huber's Čech complex.

The strongly noetherian Tate analogue is
`TauCeti.Huber.PairOfDefinition.isStronglyNoetherian_completion`.

## Main results

* `TauCeti.Huber.PairOfDefinition.isNoetherianRing_locSubring`: `A₀[T/s]` is noetherian.
* `TauCeti.Huber.PairOfDefinition.isNoetherianRing_completionLocalization`: the ring of definition
  of `A⟨T/s⟩` is noetherian.
* `TauCeti.Huber.PairOfDefinition.isNoetherianType_completion_locTopology`: `A⟨T/s⟩` is of
  noetherian type.
* `TauCeti.Huber.PairOfDefinition.exists_noetherianPairOfDefinition_completionLocObj`: the complete
  separated topological ring `A⟨T/s⟩` has a pair of definition with noetherian ring of definition.

## References

* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217
  (1994), §2, proof of Theorem 2.5, Case I, p. 529.
* [T. Wedhorn, *Adic Spaces*][wedhorn_adic], Proposition and Definition 5.51 and Remark 6.37.
-/

public section

namespace TauCeti.Huber.PairOfDefinition

variable {A : Type*} [CommRing A] [TopologicalSpace A]

/-- **The ring of definition `A₀[T/s]` of a rational localisation is noetherian** when `A₀` is
and `T` is finite: it is the `A₀`-subalgebra of `Aₛ` generated by the finitely many fractions
`t/s`. -/
theorem isNoetherianRing_locSubring (P : PairOfDefinition A)
    [IsNoetherianRing P.ringOfDefinition] {T : Set A} (hT : T.Finite) (s : A) (S : Type*)
    [CommRing S] [Algebra A S] [IsLocalization.Away s S] :
    IsNoetherianRing (P.locSubring T s S) := by
  have : Finite T := hT.to_subtype
  rw [locSubring_eq_adjoin]
  exact isNoetherianRing_of_fg ⟨(Set.finite_range _).toFinset, by rw [Set.Finite.coe_toFinset]⟩

variable [IsTopologicalRing A]

/-- **The ring of definition of `A⟨T/s⟩` is noetherian** when `A₀` is and `T` is finite: it is
the completion of the noetherian ring `A₀[T/s]` for the adic topology of a finitely generated
ideal. -/
theorem isNoetherianRing_completionLocalization (P : PairOfDefinition A)
    [IsNoetherianRing P.ringOfDefinition] {T : Set A} (hT : T.Finite) (s : A) (S : Type*)
    [CommRing S] [Algebra A S] [IsLocalization.Away s S] (hden : HasDenominatorPower P T s S) :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    IsNoetherianRing (completionLocalization P T s S hden).ringOfDefinition := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have : IsNoetherianRing (localizationUniform P T s S hden).ringOfDefinition := by
    rw [localizationUniform_ringOfDefinition]
    exact P.isNoetherianRing_locSubring hT s S
  rw [completionLocalization_ringOfDefinition]
  exact (localizationUniform P T s S hden).isNoetherianRing_completionRingOfDefinition_of_quotient

/-- **A rational localisation of a Huber ring with a noetherian ring of definition is of
noetherian type**: for finite `T`, the completed pair of definition of `A⟨T/s⟩` has a noetherian
ring of definition (`isNoetherianRing_completionLocalization`). -/
theorem isNoetherianType_completion_locTopology (P : PairOfDefinition A)
    [IsNoetherianRing P.ringOfDefinition] {T : Set A} (hT : T.Finite) (s : A) (S : Type*)
    [CommRing S] [Algebra A S] [IsLocalization.Away s S] (hden : HasDenominatorPower P T s S) :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := isHuberRing_completion_locTopology P T s S hden
    IsNoetherianType (UniformSpace.Completion S) := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have _ := isHuberRing_completion_locTopology P T s S hden
  exact .of_pairOfDefinition _ (P.isNoetherianRing_completionLocalization hT s S hden)

/-- **The rings of rational subsets keep a noetherian ring of definition** (Huber, proof of
Theorem 2.5, Case I): if `A` has a pair of definition with noetherian ring of definition, then so
does the complete separated topological ring `A⟨T/s⟩` of every presentation `(T, s)`. -/
theorem exists_noetherianPairOfDefinition_completionLocObj (P : PairOfDefinition A)
    [IsNoetherianRing P.ringOfDefinition] (T : Finset A) (s : A) (S : Type*) [CommRing S]
    [Algebra A S] [IsLocalization.Away s S] (hden : HasDenominatorPower P T s S) :
    ∃ Q : PairOfDefinition (completionLocObj P T s S hden).obj,
      IsNoetherianRing Q.ringOfDefinition := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  rw [completionLocObj_obj]
  exact ⟨completionLocalization P T s S hden,
    P.isNoetherianRing_completionLocalization T.finite_toSet s S hden⟩

end TauCeti.Huber.PairOfDefinition
