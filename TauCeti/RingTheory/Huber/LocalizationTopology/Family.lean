module

public import TauCeti.RingTheory.Huber.LocalizationTopology.Completion

/-!
# The localisation `A(T/s)` for a family of denominators

Wedhorn's Proposition and Definition 5.51 localises a nonarchimedean ring `A` at a finite family
of denominators `s = (sᵢ)_{i ∈ ι}`, each with its own set of numerators `Tᵢ`, subject to the
standing hypothesis that every `Tᵢ · A` is open. The underlying ring is the algebraic localisation
`A[1/s₁, …, 1/sₙ] = A[1/∏ᵢ sᵢ]`, the candidate ring of definition is
`D = A₀[t/sᵢ : i ∈ ι, t ∈ Tᵢ]`, and the resulting topological ring `A(T/s)` has the universal
property: the `sᵢ` become units and every fraction `t/sᵢ` is power-bounded, and every continuous
homomorphism to a nonarchimedean ring with these two properties extends uniquely.

This file reduces the family to the single-denominator construction
`TauCeti.Huber.PairOfDefinition.locTopology` at the product `∏ᵢ sᵢ`. Over the common denominator,
`t/sᵢ` is the fraction `(t · ∏_{j ≠ i} sⱼ) / ∏ⱼ sⱼ`, so the numerators of the single presentation
are the rescaled numerators `familyNumerators T s = {t · ∏_{j ≠ i} sⱼ : i ∈ ι, t ∈ Tᵢ}`, and the two
candidate rings of definition coincide. The single presentation need not satisfy the openness
condition of a rational presentation (the ideal generated by `familyNumerators T s` can fail to be
open), so the standing hypothesis of the construction is derived from the openness of each
`Tᵢ · A` separately. For a single denominator the cofactor `∏_{j ≠ i} sⱼ` is the empty product,
and the construction is the ordinary `A(T/s)`.

That the topology does not depend on the pair of definition is
`TauCeti.Huber.PairOfDefinition.locTopology_congr_pairOfDefinition`, which applies unchanged.

## Main definitions

* `TauCeti.Huber.familyNumerators T s`: the numerators `t · ∏_{j ≠ i} sⱼ` over the common
  denominator `∏ⱼ sⱼ`.

## Main results

* `TauCeti.Huber.PairOfDefinition.locSubring_familyNumerators`: the candidate ring of definition
  is `A₀[t/sᵢ : i ∈ ι, t ∈ Tᵢ]`, where `t/sᵢ` is the element whose product with `sᵢ` is `t`.
  Over the common denominator it is `(t · ∏_{j ≠ i} sⱼ) / ∏ⱼ sⱼ`
  (`TauCeti.Localization.algebraMap_mul_divBy_mul_of_eq_mul`).
* `TauCeti.Huber.PairOfDefinition.hasDenominatorPower_familyNumerators`: if each `Tᵢ · A` is open,
  the construction's standing hypothesis holds.
* `TauCeti.Huber.PairOfDefinition.isPowerBounded_of_algebraMap_mul_eq_familyNumerators`: in
  `A(T/s)` every fraction `t/sᵢ` is power-bounded. Each `sᵢ` is a unit there because it divides
  `∏ⱼ sⱼ` (`IsLocalization.Away.isUnit_of_dvd`).
* `PairOfDefinition.existsUnique_continuous_ringHom_locTopology_familyNumerators`: the universal
  property of `A(T/s)`.
* `PairOfDefinition.existsUnique_continuous_ringHom_completion_locTopology_familyNumerators`: the
  universal property of its completion `A⟨T/s⟩`, for complete Hausdorff targets.

## References

* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Proposition and Definition 5.51.
-/

open Pointwise Topology

namespace TauCeti.Huber

open TauCeti.Localization

public section

variable {A : Type*} [CommRing A] {ι : Type*} [Fintype ι]

/-! ### Numerators over the common denominator -/

/-- **The numerators of `A(T/s)` over the common denominator.** For a family of numerator sets
`Tᵢ` and denominators `sᵢ`, these are the products `t · ∏_{j ≠ i} sⱼ` with `t ∈ Tᵢ`: the
numerators that put `t/sᵢ` over `∏ⱼ sⱼ`. -/
noncomputable def familyNumerators (T : ι → Finset A) (s : ι → A) : Finset A := by
  classical
  exact Finset.univ.biUnion fun i ↦ (T i).image (· * ∏ j ∈ Finset.univ.erase i, s j)

/-- Membership in `familyNumerators T s`: the elements are the `t · ∏_{j ≠ i} sⱼ` with `t ∈ Tᵢ`. -/
@[simp]
theorem mem_familyNumerators [DecidableEq ι] {T : ι → Finset A} {s : ι → A} {x : A} :
    x ∈ familyNumerators T s ↔ ∃ i, ∃ t ∈ T i, t * ∏ j ∈ Finset.univ.erase i, s j = x := by
  classical
  simp only [familyNumerators, Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_image]
  -- the definition erases `i` with the classical instance, the statement with the given one
  convert Iff.rfl

/-- The rescaled numerator `t · ∏_{j ≠ i} sⱼ` of `t ∈ Tᵢ` is one of `familyNumerators T s`. -/
theorem mul_prod_erase_mem_familyNumerators [DecidableEq ι] {T : ι → Finset A} {s : ι → A} {i : ι}
    {t : A} (ht : t ∈ T i) : t * ∏ j ∈ Finset.univ.erase i, s j ∈ familyNumerators T s :=
  mem_familyNumerators.mpr ⟨i, t, ht, rfl⟩

variable (s : ι → A) (S : Type*) [CommRing S] [Algebra A S] [IsLocalization.Away (∏ i, s i) S]

/-- Under a homomorphism making every `φ sᵢ` a unit, the image of the rescaled numerator over the
image of the common denominator is `φ t / φ sᵢ`. -/
private theorem map_mul_prod_erase_mul_inv [DecidableEq ι] {B : Type*} [CommRing B] (φ : A →+* B)
    (hs : ∀ i, IsUnit (φ (s i))) (hprod : IsUnit (φ (∏ i, s i))) (i : ι) (t : A) :
    φ (t * ∏ j ∈ Finset.univ.erase i, s j) * ↑hprod.unit⁻¹ = φ t * ↑(hs i).unit⁻¹ := by
  rw [Units.mul_inv_eq_iff_eq_mul, IsUnit.unit_spec,
    ← Finset.mul_prod_erase _ _ (Finset.mem_univ i), map_mul, map_mul]
  linear_combination (-(φ t * φ (∏ j ∈ Finset.univ.erase i, s j))) * (hs i).val_inv_mul

namespace PairOfDefinition

variable [TopologicalSpace A] (P : PairOfDefinition A) (T : ι → Finset A)

/-! ### The ring of definition -/

/-- **The candidate ring of definition of `A(T/s)` is `A₀[t/sᵢ : i ∈ ι, t ∈ Tᵢ]`**: the subring of
`S` generated by the image of `A₀` and by the elements `x` with `sᵢ · x = t` for some `i` and some
`t ∈ Tᵢ`, which are the fractions `t/sᵢ`. -/
theorem locSubring_familyNumerators :
    locSubring P (familyNumerators T s) (∏ i, s i) S = Subring.closure
      ((algebraMap A S) '' (P.ringOfDefinition : Set A) ∪
        {x | ∃ i, ∃ t ∈ T i, algebraMap A S (s i) * x = algebraMap A S t}) := by
  classical
  rw [locSubring_def]
  congr 2
  ext x
  constructor
  · rintro ⟨⟨y, hy⟩, rfl⟩
    obtain ⟨i, t, ht, rfl⟩ := mem_familyNumerators.mp hy
    exact ⟨i, t, ht, algebraMap_mul_divBy_mul_of_eq_mul _
      (Finset.mul_prod_erase _ _ (Finset.mem_univ i)).symm t⟩
  · rintro ⟨i, t, ht, hx⟩
    exact ⟨⟨_, mul_prod_erase_mem_familyNumerators ht⟩,
      (eq_divBy_mul_of_algebraMap_mul_eq _ (Finset.mul_prod_erase _ _ (Finset.mem_univ i)).symm
        hx).symm⟩

/-- Each fraction `t/sᵢ` with `t ∈ Tᵢ` lies in the candidate ring of definition. -/
theorem mem_locSubring_familyNumerators_of_algebraMap_mul_eq {i : ι} {t : A} (ht : t ∈ T i)
    {x : S} (hx : algebraMap A S (s i) * x = algebraMap A S t) :
    x ∈ locSubring P (familyNumerators T s) (∏ i, s i) S := by
  rw [locSubring_familyNumerators]
  exact Subring.subset_closure (Or.inr ⟨i, t, ht, hx⟩)

/-! ### The standing hypothesis -/

/-- **Wedhorn's openness hypothesis gives the standing hypothesis.** If every `Tᵢ · A` is open,
then some power of the ideal of definition has all its fractions `b / ∏ᵢ sᵢ` in
`A₀[t/sᵢ : i ∈ ι, t ∈ Tᵢ]`, so `locTopology` is defined on `A(T/s)`. -/
theorem hasDenominatorPower_familyNumerators [IsTopologicalRing A]
    (hT : ∀ i, IsOpen (Ideal.span (T i : Set A) : Set A)) :
    HasDenominatorPower P (familyNumerators T s) (∏ i, s i) S := by
  classical
  -- For each `i`, openness of `Tᵢ · A` puts `b/sᵢ` in the ring of definition for `b` in a power
  -- `I ^ N i` of the ideal of definition. A product of one element from each `I ^ N i`, divided by
  -- `∏ᵢ sᵢ`, is the product of these fractions.
  choose N hN using fun i ↦ (hasDenominatorPower_iff P (T i) (s i) (Localization.Away (s i))).mp
    (hasDenominatorPower_of_isOpen_span P (T i) (s i) _ (hT i))
  have hgen (i : ι) {b : A} (hb : (divBy b (s i) : Localization.Away (s i)) ∈
      locSubring P (T i) (s i) (Localization.Away (s i))) :
      divBy (b * ∏ j ∈ Finset.univ.erase i, s j) (∏ j, s j) ∈
        locSubring P (familyNumerators T s) (∏ i, s i) S :=
    divBy_mul_mem_locSubring P (T i) (s i) _ _ _ S _
      (Finset.mul_prod_erase _ _ (Finset.mem_univ i)).symm
      (fun _ ht ↦ mul_prod_erase_mem_familyNumerators ht) hb
  -- Induct over the set `F` of denominators already used: `b ∈ I ^ (∑_{i ∈ F} N i)` divided by
  -- `∏_{i ∈ F} sᵢ`, written over the common denominator, lies in the ring of definition.
  have key (F : Finset ι) : ∀ b ∈ P.idealOfDefinition ^ (∑ i ∈ F, N i),
      divBy ((b : A) * ∏ j ∈ Finset.univ \ F, s j) (∏ j, s j) ∈
        locSubring P (familyNumerators T s) (∏ i, s i) S := by
    induction F using Finset.induction_on with
    | empty =>
      intro b _
      rw [Finset.sdiff_empty, divBy_mul_cancel_right]
      exact algebraMap_mem_locSubring P _ _ S b.2
    | @insert i F hi ih =>
      intro b hb
      rw [Finset.sum_insert hi, pow_add] at hb
      refine Submodule.mul_induction_on hb (fun x hx y hy ↦ ?_) (fun p q hp hq ↦ ?_)
      · have hsplit : ∏ j ∈ Finset.univ \ F, s j =
            (∏ j ∈ Finset.univ \ insert i F, s j) * s i := by
          rw [mul_comm, ← Finset.prod_insert (by simp)]
          congr 1
          ext j
          by_cases hj : j = i <;> simp [hj, hi]
        rw [Subring.coe_mul, mul_assoc, divBy_mul_divBy_of_eq_mul (∏ j, s j)
          (Finset.mul_prod_erase _ _ (Finset.mem_univ i)).symm, mul_assoc, ← hsplit]
        exact Subring.mul_mem _ (hgen i (hN i x hx)) (ih y hy)
      · rw [Subring.coe_add, add_mul, divBy_add]
        exact Subring.add_mem _ hp hq
  refine (hasDenominatorPower_iff P _ _ S).mpr ⟨∑ i, N i, fun b hb ↦ ?_⟩
  simpa using key Finset.univ b hb

/-! ### The universal property -/

/-- **The fractions `t/sᵢ` are power-bounded in `A(T/s)`.** Each `sᵢ` is also a unit in `A(T/s)`,
since it divides `∏ⱼ sⱼ` (`IsLocalization.Away.isUnit_of_dvd`), so `A(T/s)` itself satisfies the
conditions of its universal property. -/
theorem isPowerBounded_of_algebraMap_mul_eq_familyNumerators [SeparatelyContinuousMul A]
    (hden : HasDenominatorPower P (familyNumerators T s) (∏ i, s i) S) {i : ι} {t : A}
    (ht : t ∈ T i) {x : S} (hx : algebraMap A S (s i) * x = algebraMap A S t) :
    letI := locTopology P (familyNumerators T s) (∏ i, s i) S hden
    IsPowerBounded x :=
  isPowerBounded_of_mem_locSubring P _ _ S hden
    (mem_locSubring_familyNumerators_of_algebraMap_mul_eq s S P T ht hx)

/-- **Wedhorn 5.51, the universal property of `A(T/s)`.** A ring homomorphism `φ : A →+* B` into
a nonarchimedean ring extends to `A(T/s)` in exactly one continuous way, provided `φ` is
continuous, every `φ sᵢ` is a unit, and every fraction `φ t / φ sᵢ` with `t ∈ Tᵢ` is
power-bounded. -/
theorem existsUnique_continuous_ringHom_locTopology_familyNumerators {B : Type*} [CommRing B]
    [TopologicalSpace B] [NonarchimedeanRing B] [IsTopologicalRing A]
    (hden : HasDenominatorPower P (familyNumerators T s) (∏ i, s i) S) {φ : A →+* B}
    (hφ : ContinuousAt φ 0) (hs : ∀ i, IsUnit (φ (s i)))
    (hpow : ∀ i, ∀ t ∈ T i, IsPowerBounded (φ t * ↑(hs i).unit⁻¹)) :
    letI := locTopology P (familyNumerators T s) (∏ i, s i) S hden
    ∃! f : S →+* B, Continuous f ∧ f.comp (algebraMap A S) = φ := by
  classical
  have hprod : IsUnit (φ (∏ i, s i)) := by simpa [map_prod] using hs
  refine existsUnique_continuous_ringHom_locTopology P _ _ S hden hφ hprod fun x hx ↦ ?_
  obtain ⟨i, t, ht, rfl⟩ := mem_familyNumerators.mp hx
  rw [map_mul_prod_erase_mul_inv s φ hs hprod i t]
  exact hpow i t ht

/-- **The universal property of the completion `A⟨T/s⟩`**, for complete Hausdorff targets: a ring
homomorphism `φ : A →+* B` continuous at zero, with every `φ sᵢ` a unit and every fraction
`φ t / φ sᵢ` with `t ∈ Tᵢ` power-bounded, extends to the completion of `A(T/s)` in exactly one
continuous way. -/
theorem existsUnique_continuous_ringHom_completion_locTopology_familyNumerators {B : Type*}
    [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [NonarchimedeanRing B] [CompleteSpace B]
    [T0Space B] [IsTopologicalRing A]
    (hden : HasDenominatorPower P (familyNumerators T s) (∏ i, s i) S)
    {φ : A →+* B} (hφ : ContinuousAt φ 0) (hs : ∀ i, IsUnit (φ (s i)))
    (hpow : ∀ i, ∀ t ∈ T i, IsPowerBounded (φ t * ↑(hs i).unit⁻¹)) :
    letI := locUniformSpace P (familyNumerators T s) (∏ i, s i) S hden
    letI := isUniformAddGroup_locUniformSpace P (familyNumerators T s) (∏ i, s i) S hden
    letI := isTopologicalRing_locUniformSpace P (familyNumerators T s) (∏ i, s i) S hden
    ∃! g : UniformSpace.Completion S →+* B,
      Continuous g ∧ g.comp (toCompletionLoc P (familyNumerators T s) (∏ i, s i) S hden) = φ := by
  classical
  have hprod : IsUnit (φ (∏ i, s i)) := by simpa [map_prod] using hs
  refine existsUnique_continuous_ringHom_completion_locTopology P _ _ S hden hφ hprod
    fun x hx ↦ ?_
  obtain ⟨i, t, ht, rfl⟩ := mem_familyNumerators.mp hx
  rw [map_mul_prod_erase_mul_inv s φ hs hprod i t]
  exact hpow i t ht

end PairOfDefinition

end

end TauCeti.Huber
