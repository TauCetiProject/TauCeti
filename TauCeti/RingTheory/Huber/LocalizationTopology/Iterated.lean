module

public import TauCeti.RingTheory.Huber.LocalizationTopology.Restriction

/-!
# A rational localisation of `A⟨T/s⟩` is a rational localisation of `A`

Let `B = A⟨T/s⟩`, with structure map `ρ : A → B`, and let `(T'', s'')` refine `(T, s)`:
`s'' = s * r` and every `t * r`, for `t ∈ T`, lies in `T''`. Wedhorn's Remark 8.4 identifies
`A⟨T''/s''⟩` with the rational localisation `B⟨ρ(T'')/ρ(s'')⟩` of `B`, compatibly with the
structure maps from `A` and from `B`. This file proves that identification for the rings.

`B` carries the pair of definition `TauCeti.Huber.PairOfDefinition.completionLocalization`: its
ring of definition `B₀` is the closure of the image of `A₀[T/s]`, and its ideal of definition is
generated by the image of `I`. The standing hypothesis `HasDenominatorPower` for
`(ρ(T''), ρ(s''))` is derived, not assumed: it follows from the one for `(T'', s'')`, because
`A_{s''} → B_{ρ(s'')}` carries `A₀[T''/s'']` into `B₀[ρ(T'')/ρ(s'')]` and the powers of the ideal
of definition of `B` are generated by the images of the powers of `I`. So the interface below asks
only for the hypotheses over `A`. The comparison maps come from the two universal properties, and
each of their composites fixes a structure map, hence is the identity.

The numerators over `B` are a finset `TB` with underlying set `ρ '' T''`, so that no decidable
equality on `B` enters the statements.

Under the isomorphism the restriction map `A⟨T/s⟩ → A⟨T''/s''⟩` is the structure map
`B → B⟨ρ(T'')/ρ(s'')⟩`. This is the reduction that opens Wedhorn's proof of Proposition 8.30, after
which the Laurent chain of Remark 7.55 runs over `B`; it is how
`TauCeti.Huber.PairOfDefinition.flat_restrictionRingHom` obtains flatness of restriction maps that
change the denominator.

## Main definitions

* `TauCeti.Huber.PairOfDefinition.iteratedLocalizationRingEquiv` : the isomorphism
  `A⟨T''/s''⟩ ≃+* B⟨ρ(T'')/ρ(s'')⟩`.

## Main results

* `TauCeti.Huber.PairOfDefinition.hasDenominatorPower_completionLocalization` : the standing
  hypothesis for `(ρ(T''), ρ(s''))` over `B`, for any `TB` containing the images, and
  `…_of_coe_eq_image` : its specialisation to a `TB` equal to the image, which is what the
  declarations below derive rather than assume.
* `TauCeti.Huber.PairOfDefinition.continuous_iteratedLocalizationRingEquiv` and
  `…_symm` : the isomorphism is one of topological rings.
* `TauCeti.Huber.PairOfDefinition.iteratedLocalizationRingEquiv_coe_comp_toCompletionLoc` and
  `…_symm_coe_comp_toCompletionLoc` : compatibility with the structure maps from `A` and from
  `B`; the latter says the inverse turns the structure map of `B⟨ρ(T'')/ρ(s'')⟩` into the
  restriction map.
* `TauCeti.Huber.PairOfDefinition.eq_iteratedLocalizationRingEquiv` : continuity and compatibility
  with the structure maps from `A` already determine the isomorphism.

## Provenance

AINTLIB (branch `dev/adic-spaces`, commit `37bbdaeb9`) builds the same identification in
`projects/AdicSpaces/Adic spaces/RelativeRationalLocData.lean`, as `relativeRationalLocData`, with
the comparison maps `relativeLaurentNormalized_forwardHom` and
`relativeLaurentNormalized_backwardHom` assembled into `relativeLaurentNormalized_equiv`. Its
openness condition `relativeRationalLocData_hopen_proof` is left unproved there, and is proved only
when `1` is a numerator (`relativeRationalLocData_hopen_proof_of_laurentNormalized`). There the two
presentations may carry different pairs of definition; here both use the pair of `A`, which is what
lets the standing hypothesis transfer in general. The comparison maps here come from the universal
property of `A⟨T/s⟩`, and no code is ported.

## References

* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Remark 8.4, Proposition 8.30 and
  Remark 7.55.
* [C. Birkbeck, *AINTLIB*](https://github.com/CBirkbeck/AINTLIB), branch `dev/adic-spaces`,
  commit `37bbdaeb9`, `projects/AdicSpaces/Adic spaces/RelativeRationalLocData.lean`.
-/

namespace TauCeti.Huber

open TauCeti.Localization

public section

variable {A : Type*} [CommRing A] [TopologicalSpace A]

namespace PairOfDefinition

variable [IsTopologicalRing A] (P : PairOfDefinition A) (T : Finset A) (s : A) (S : Type*)
  [CommRing S] [Algebra A S] [IsLocalization.Away s S] (hden : HasDenominatorPower P T s S)

/-! ### The standing hypothesis over `A⟨T/s⟩` -/

-- The `N`-th power of the ideal of definition of `A⟨T/s⟩` lies in every ideal of its ring of
-- definition that contains the image of `I ^ N`: that power is generated by the image of `I ^ N`.
private theorem completionLocalization_idealOfDefinition_pow_le (N : ℕ) :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    ∀ K : Ideal (completionLocalization P T s S hden).ringOfDefinition,
      (∀ a ∈ P.idealOfDefinition ^ N, ∀ x : (completionLocalization P T s S hden).ringOfDefinition,
        (x : UniformSpace.Completion S) = toCompletionLoc P T s S hden a → x ∈ K) →
      (completionLocalization P T s S hden).idealOfDefinition ^ N ≤ K := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  intro K hK
  let e₁ := RingEquiv.subringCongr (completionLocalization_ringOfDefinition P T s S hden)
  let e₂ := RingEquiv.subringCongr (localizationUniform_ringOfDefinition P T s S hden)
  have h₁ : (completionLocalization P T s S hden).idealOfDefinition =
      (localizationUniform P T s S hden).completionIdeal.comap e₁ :=
    Ideal.ext fun _ ↦ mem_completionLocalization_idealOfDefinition P T s S hden
  have h₂ : (localizationUniform P T s S hden).idealOfDefinition = (locIdeal P T s S).comap e₂ :=
    Ideal.ext fun _ ↦ mem_localizationUniform_idealOfDefinition P T s S hden
  -- the ideal is the image of `I` along `A₀ → D → D̂`, and images commute with powers
  rw [h₁, completionIdeal_def, h₂, locIdeal_def, ← Ideal.map_symm, ← Ideal.map_symm]
  simp only [← Ideal.map_pow, Ideal.map_le_iff_le_comap]
  exact fun a ha ↦ hK a ha _ <| by simp [e₁, e₂]

variable (T'' : Finset A) (s'' : A) (S'' : Type*) [CommRing S''] [Algebra A S'']
  [IsLocalization.Away s'' S''] (hden'' : HasDenominatorPower P T'' s'' S'')
  (SB : Type*) [CommRing SB]
  [letI := locUniformSpace P T s S hden
   letI := isUniformAddGroup_locUniformSpace P T s S hden
   letI := isTopologicalRing_locUniformSpace P T s S hden
   Algebra (UniformSpace.Completion S) SB]
  [letI := locUniformSpace P T s S hden
   letI := isUniformAddGroup_locUniformSpace P T s S hden
   letI := isTopologicalRing_locUniformSpace P T s S hden
   IsLocalization.Away (toCompletionLoc P T s S hden s'') SB]
  (TB : Finset (letI := locUniformSpace P T s S hden; UniformSpace.Completion S))

-- The localisation map `A_{s''} → B_{ρ(s'')}` carries `A₀[T''/s'']` into `B₀[TB/ρ(s'')]` as soon
-- as `TB` contains `ρ(T'')`: it sends `A₀` into the closure of the image of `A₀[T/s]`, and `t/s''`
-- to `ρ(t)/ρ(s'')`.
private theorem map_mem_locSubring_completionLocalization
    (hTB : ∀ t ∈ T'', toCompletionLoc P T s S hden t ∈ TB) {x : S''}
    (hx : x ∈ locSubring P T'' s'' S'') :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    IsLocalization.Away.map S'' SB (toCompletionLoc P T s S hden) s'' x ∈ locSubring
      (completionLocalization P T s S hden) TB (toCompletionLoc P T s S hden s'') SB := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  refine (locSubring_le_iff P T'' s'' S'' (R := (locSubring (completionLocalization P T s S hden)
    TB (toCompletionLoc P T s S hden s'') SB).comap (IsLocalization.Away.map S'' SB
      (toCompletionLoc P T s S hden) s''))).mpr ⟨fun a ha ↦ ?_, fun t ht ↦ ?_⟩ hx
  · rw [Subring.mem_comap, IsLocalization.Away.map, IsLocalization.map_eq]
    refine algebraMap_mem_locSubring _ _ _ _ ?_
    rw [completionLocalization_ringOfDefinition, mem_completionRingOfDefinition_iff,
      localizationUniform_ringOfDefinition, toCompletionLoc_apply]
    exact subset_closure ⟨_, algebraMap_mem_locSubring P T s S ha, rfl⟩
  · rw [Subring.mem_comap, RingHom.awayMap_divBy]
    exact divBy_mem_locSubring _ _ _ _ (hTB t ht)

include hden'' in
/-- **The standing hypothesis over `A⟨T/s⟩`.** If `(T'', s'')` satisfies `HasDenominatorPower` over
`A`, then so does `(TB, ρ(s''))` over `A⟨T/s⟩` for its pair of definition
`TauCeti.Huber.PairOfDefinition.completionLocalization`, for any finset `TB` containing the images
`ρ(t)` of the numerators `t ∈ T''`.

The exponent is unchanged: the `N`-th power of the ideal of definition of `A⟨T/s⟩` is generated by
the images `ρ(b)` of the `b ∈ I ^ N`, and `ρ(b)/ρ(s'')` is the image of `b/s''`, which lies in
`A₀[T''/s'']` by hypothesis. -/
theorem hasDenominatorPower_completionLocalization
    (hTB : ∀ t ∈ T'', toCompletionLoc P T s S hden t ∈ TB) :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    HasDenominatorPower (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  obtain ⟨N, hN⟩ := (hasDenominatorPower_iff _ _ _ _).mp hden''
  set L := locSubring (completionLocalization P T s S hden) TB (toCompletionLoc P T s S hden s'') SB
  -- the elements whose fraction over `ρ(s'')` lies in `L` form an ideal of the ring of definition
  let K : Ideal (completionLocalization P T s S hden).ringOfDefinition :=
    { carrier := {x | divBy (x : UniformSpace.Completion S) (toCompletionLoc P T s S hden s'') ∈ L}
      add_mem' := fun hx hy ↦ by simpa using L.add_mem hx hy
      zero_mem' := by simp
      smul_mem' := fun c x hx ↦ by
        simpa [divBy_mul] using L.mul_mem (algebraMap_mem_locSubring _ _ _ _ c.2) hx }
  refine (hasDenominatorPower_iff _ _ _ _).mpr ⟨N, fun b hb ↦
    completionLocalization_idealOfDefinition_pow_le P T s S hden N K (fun a ha x hx ↦ ?_) hb⟩
  have h := map_mem_locSubring_completionLocalization P T s S hden T'' s'' S'' SB TB hTB (hN a ha)
  rwa [RingHom.awayMap_divBy, ← hx] at h

variable
  (hTB : letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    (TB : Set (UniformSpace.Completion S)) = toCompletionLoc P T s S hden '' T'')

include hden'' hTB in
/-- **The standing hypothesis over `A⟨T/s⟩`, for the numerators on the nose.** The specialisation
of `hasDenominatorPower_completionLocalization` to a `TB` that *is* the image `ρ '' T''`, rather
than merely containing it. This is the form the isomorphism below runs on, which is why none of
its interface takes the conclusion as a hypothesis. -/
theorem hasDenominatorPower_completionLocalization_of_coe_eq_image :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    HasDenominatorPower (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB :=
  hasDenominatorPower_completionLocalization P T s S hden T'' s'' S'' hden'' SB TB
    fun _ ht ↦ by simpa only [← Finset.mem_coe, hTB] using Set.mem_image_of_mem _ ht

/-! ### The two comparison maps -/

variable (r : A) (hs'' : s'' = s * r) (hT : ∀ t ∈ T, t * r ∈ T'')

-- The map `A⟨T''/s''⟩ → B⟨TB/ρ(s'')⟩`: the universal property of `A⟨T''/s''⟩` applied to the
-- composite `A → B → B⟨TB/ρ(s'')⟩`, which inverts `s''` and makes each `t/s''` power-bounded.
private theorem existsUnique_continuous_ringHom_toIteratedLocalization :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := locUniformSpace P T'' s'' S'' hden''
    letI := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
    letI := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
    letI hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
      hden'' SB TB hTB
    letI := locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    ∃! f : UniformSpace.Completion S'' →+* UniformSpace.Completion SB, Continuous f ∧
      f.comp (toCompletionLoc P T'' s'' S'' hden'') =
        (toCompletionLoc (completionLocalization P T s S hden) TB
          (toCompletionLoc P T s S hden s'') SB hB).comp (toCompletionLoc P T s S hden) := by
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
    hden'' SB TB hTB
  have _ := isUniformAddGroup_locUniformSpace _ TB _ SB hB
  have _ := isTopologicalRing_locUniformSpace _ TB _ SB hB
  have _ := isHuberRing_completion_locTopology _ TB _ SB hB
  have hu := isUnit_toCompletionLoc_of_dvd _ TB _ SB hB dvd_rfl
  exact existsUnique_continuous_ringHom_completion_locTopology P T'' s'' S'' hden''
    ((continuous_toCompletionLoc _ _ _ SB hB).comp
      (continuous_toCompletionLoc P T s S hden)).continuousAt hu
    fun t ht ↦ isPowerBounded_toCompletionLoc_mul_unit_inv _ _ _ SB hB (mul_one _).symm hu
      (by simpa only [mul_one, ← Finset.mem_coe, hTB] using Set.mem_image_of_mem _ ht)

-- The map `B⟨TB/ρ(s'')⟩ → A⟨T''/s''⟩`: the universal property of `B⟨TB/ρ(s'')⟩` applied to the
-- restriction map `B → A⟨T''/s''⟩`, which agrees with the structure map of `A⟨T''/s''⟩` on `A`.
private theorem existsUnique_continuous_ringHom_ofIteratedLocalization :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := locUniformSpace P T'' s'' S'' hden''
    letI := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
    letI := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
    letI hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
      hden'' SB TB hTB
    letI := locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    ∃! g : UniformSpace.Completion SB →+* UniformSpace.Completion S'', Continuous g ∧
      g.comp (toCompletionLoc (completionLocalization P T s S hden) TB
          (toCompletionLoc P T s S hden s'') SB hB) =
        restrictionRingHom P T s S hden T'' s'' S'' hden'' r hs'' hT := by
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
  have _ := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
  have _ := isHuberRing_completion_locTopology P T'' s'' S'' hden''
  have hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
    hden'' SB TB hTB
  have hρ (a : A) : restrictionRingHom P T s S hden T'' s'' S'' hden'' r hs'' hT
      (toCompletionLoc P T s S hden a) = toCompletionLoc P T'' s'' S'' hden'' a := by
    rw [← RingHom.comp_apply, restrictionRingHom_comp_toCompletionLoc]
  have hu := isUnit_toCompletionLoc_of_dvd P T'' s'' S'' hden'' dvd_rfl
  refine existsUnique_continuous_ringHom_completion_locTopology _ TB _ SB hB
    (continuous_restrictionRingHom P T s S hden T'' s'' S'' hden'' r hs'' hT).continuousAt
    (hρ s'' ▸ hu) fun u hu' ↦ ?_
  -- a numerator `ρ(t)` goes to `t`, so its fraction is the distinguished fraction `t/s''`
  obtain ⟨t, ht, rfl⟩ := hTB.subset hu'
  simpa only [hρ] using isPowerBounded_toCompletionLoc_mul_unit_inv P T'' s'' S'' hden''
    (mul_one s'').symm hu (t := t) (by simpa using ht)

-- The two comparison maps are mutually inverse, so they form a ring isomorphism, continuous in
-- both directions and compatible with the structure maps. Each composite is continuous and fixes a
-- structure map, hence is the identity; for the composite on `B⟨TB/ρ(s'')⟩` this is first checked
-- after the restriction map, on `B`, where it holds after `A → B`.
private theorem exists_ringEquiv_iteratedLocalization :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := locUniformSpace P T'' s'' S'' hden''
    letI := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
    letI := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
    letI hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
      hden'' SB TB hTB
    letI := locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    ∃ e : UniformSpace.Completion S'' ≃+* UniformSpace.Completion SB,
      Continuous e ∧ Continuous e.symm ∧
      (e : UniformSpace.Completion S'' →+* UniformSpace.Completion SB).comp
          (toCompletionLoc P T'' s'' S'' hden'') =
        (toCompletionLoc (completionLocalization P T s S hden) TB
          (toCompletionLoc P T s S hden s'') SB hB).comp (toCompletionLoc P T s S hden) ∧
      (e.symm : UniformSpace.Completion SB →+* UniformSpace.Completion S'').comp
          (toCompletionLoc (completionLocalization P T s S hden) TB
            (toCompletionLoc P T s S hden s'') SB hB) =
        restrictionRingHom P T s S hden T'' s'' S'' hden'' r hs'' hT := by
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
  have _ := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
  have hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
    hden'' SB TB hTB
  have _ := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
    (toCompletionLoc P T s S hden s'') SB hB
  have _ := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
    (toCompletionLoc P T s S hden s'') SB hB
  obtain ⟨f, ⟨hf, hfc⟩, -⟩ := existsUnique_continuous_ringHom_toIteratedLocalization P T s S hden
    T'' s'' S'' hden'' SB TB hTB
  obtain ⟨g, ⟨hg, hgc⟩, -⟩ := existsUnique_continuous_ringHom_ofIteratedLocalization P T s S hden
    T'' s'' S'' hden'' SB TB hTB r hs'' hT
  refine ⟨RingEquiv.ofRingHom f g ?_ ?_, hf, hg, hfc, hgc⟩
  · refine eq_id_of_comp_toCompletionLoc_eq_self _ TB _ SB hB _ (hf.comp hg) ?_
    rw [RingHom.comp_assoc, hgc]
    refine completion_locTopology_ringHom_ext_of_continuous P T s S hden _ _
      (hf.comp (continuous_restrictionRingHom P T s S hden T'' s'' S'' hden'' r hs'' hT))
      (continuous_toCompletionLoc _ _ _ SB hB) ?_
    rw [RingHom.comp_assoc, restrictionRingHom_comp_toCompletionLoc, hfc]
  · refine eq_id_of_comp_toCompletionLoc_eq_self P T'' s'' S'' hden'' _ (hg.comp hf) ?_
    rw [RingHom.comp_assoc, hfc, ← RingHom.comp_assoc, hgc, restrictionRingHom_comp_toCompletionLoc]

/-! ### The isomorphism -/

include r hs'' hT in
/-- **Wedhorn's Remark 8.4, for rings.** Let `B = A⟨T/s⟩` and let `(T'', s'')` refine `(T, s)` with
cofactor `r`. Then `A⟨T''/s''⟩` is isomorphic to the rational localisation `B⟨TB/ρ(s'')⟩`, where
`ρ : A → B` is the structure map and `TB` is a finset with underlying set `ρ(T'')`.

Its four defining properties are `continuous_iteratedLocalizationRingEquiv` and
`continuous_iteratedLocalizationRingEquiv_symm` (it is continuous in both directions),
`iteratedLocalizationRingEquiv_coe_comp_toCompletionLoc` (compatibility with the structure maps from
`A`) and `iteratedLocalizationRingEquiv_symm_coe_comp_toCompletionLoc` (compatibility with those
from `B`, which is what separates it from `restrictionRingHom`), and
`eq_iteratedLocalizationRingEquiv` says that the first and third already determine it. Those five
are the interface to use. -/
noncomputable def iteratedLocalizationRingEquiv :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := locUniformSpace P T'' s'' S'' hden''
    letI := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
    letI := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
    letI hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
      hden'' SB TB hTB
    letI := locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    UniformSpace.Completion S'' ≃+* UniformSpace.Completion SB :=
  (exists_ringEquiv_iteratedLocalization P T s S hden T'' s'' S'' hden'' SB TB hTB r hs'' hT).choose

/-- The isomorphism `A⟨T''/s''⟩ ≃+* B⟨TB/ρ(s'')⟩` is continuous, for the topologies of the two
pairs of definition: `P` at `(T'', s'')` on the source, and `B`'s pair
`completionLocalization P T s S hden` at `(TB, ρ(s''))` on the target. For the other direction see
`continuous_iteratedLocalizationRingEquiv_symm`. -/
theorem continuous_iteratedLocalizationRingEquiv :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := locUniformSpace P T'' s'' S'' hden''
    letI := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
    letI := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
    letI hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
      hden'' SB TB hTB
    letI := locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    Continuous
      (iteratedLocalizationRingEquiv P T s S hden T'' s'' S'' hden'' SB TB hTB r hs'' hT) :=
  (exists_ringEquiv_iteratedLocalization P T s S hden T'' s'' S'' hden'' SB TB hTB r hs''
    hT).choose_spec.1

/-- The inverse of the isomorphism `A⟨T''/s''⟩ ≃+* B⟨TB/ρ(s'')⟩` is continuous, so the isomorphism
is one of topological rings. The topologies are those of the two pairs of definition, in the roles
opposite to `continuous_iteratedLocalizationRingEquiv`: `B`'s pair
`completionLocalization P T s S hden` at `(TB, ρ(s''))` on the source, and `P` at `(T'', s'')` on
the target. -/
theorem continuous_iteratedLocalizationRingEquiv_symm :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := locUniformSpace P T'' s'' S'' hden''
    letI := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
    letI := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
    letI hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
      hden'' SB TB hTB
    letI := locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    Continuous
      (iteratedLocalizationRingEquiv P T s S hden T'' s'' S'' hden'' SB TB hTB r hs'' hT).symm :=
  (exists_ringEquiv_iteratedLocalization P T s S hden T'' s'' S'' hden'' SB TB hTB r hs''
    hT).choose_spec.2.1

/-- **Compatibility with the structure maps from `A`.** The isomorphism carries the structure map
`A → A⟨T''/s''⟩` to the composite `A → B → B⟨TB/ρ(s'')⟩`, for the topologies of the two pairs of
definition: `P` at `(T'', s'')` on the source, and `B`'s pair `completionLocalization P T s S hden`
at `(TB, ρ(s''))` on the target. Together with continuity this compatibility determines the
isomorphism (`eq_iteratedLocalizationRingEquiv`). -/
@[simp]
theorem iteratedLocalizationRingEquiv_coe_comp_toCompletionLoc :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := locUniformSpace P T'' s'' S'' hden''
    letI := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
    letI := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
    letI hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
      hden'' SB TB hTB
    letI := locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    (iteratedLocalizationRingEquiv P T s S hden T'' s'' S'' hden'' SB TB hTB r hs'' hT :
      UniformSpace.Completion S'' →+* UniformSpace.Completion SB).comp
      (toCompletionLoc P T'' s'' S'' hden'') =
      (toCompletionLoc (completionLocalization P T s S hden) TB
        (toCompletionLoc P T s S hden s'') SB hB).comp (toCompletionLoc P T s S hden) :=
  (exists_ringEquiv_iteratedLocalization P T s S hden T'' s'' S'' hden'' SB TB hTB r hs''
    hT).choose_spec.2.2.1

/-- **Compatibility with the structure maps from `B`.** The inverse isomorphism carries the
structure map `B → B⟨TB/ρ(s'')⟩` to the restriction map `B → A⟨T''/s''⟩`: up to the isomorphism,
the restriction map of the refinement is the structure map of a rational localisation of `B`. The
topologies are those of the two pairs of definition, in the roles opposite to
`iteratedLocalizationRingEquiv_coe_comp_toCompletionLoc`: `B`'s pair
`completionLocalization P T s S hden` at `(TB, ρ(s''))` on the source, and `P` at `(T'', s'')` on
the target. -/
@[simp]
theorem iteratedLocalizationRingEquiv_symm_coe_comp_toCompletionLoc :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := locUniformSpace P T'' s'' S'' hden''
    letI := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
    letI := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
    letI hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
      hden'' SB TB hTB
    letI := locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    ((iteratedLocalizationRingEquiv P T s S hden T'' s'' S'' hden'' SB TB hTB r hs'' hT).symm :
      UniformSpace.Completion SB →+* UniformSpace.Completion S'').comp
      (toCompletionLoc (completionLocalization P T s S hden) TB
        (toCompletionLoc P T s S hden s'') SB hB) =
      restrictionRingHom P T s S hden T'' s'' S'' hden'' r hs'' hT :=
  (exists_ringEquiv_iteratedLocalization P T s S hden T'' s'' S'' hden'' SB TB hTB r hs''
    hT).choose_spec.2.2.2

/-- **Continuity and compatibility with the structure maps from `A` determine the isomorphism.**
Any continuous ring isomorphism `A⟨T''/s''⟩ ≃+* B⟨TB/ρ(s'')⟩` carrying the structure map
`A → A⟨T''/s''⟩` to the composite `A → B → B⟨TB/ρ(s'')⟩` is it, so the two properties of its
inverse come for free. -/
theorem eq_iteratedLocalizationRingEquiv :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    letI := locUniformSpace P T'' s'' S'' hden''
    letI := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
    letI := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
    letI hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
      hden'' SB TB hTB
    letI := locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    letI := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
      (toCompletionLoc P T s S hden s'') SB hB
    ∀ e : UniformSpace.Completion S'' ≃+* UniformSpace.Completion SB, Continuous e →
      (e : UniformSpace.Completion S'' →+* UniformSpace.Completion SB).comp
          (toCompletionLoc P T'' s'' S'' hden'') =
        (toCompletionLoc (completionLocalization P T s S hden) TB
          (toCompletionLoc P T s S hden s'') SB hB).comp (toCompletionLoc P T s S hden) →
      e = iteratedLocalizationRingEquiv P T s S hden T'' s'' S'' hden'' SB TB hTB r hs'' hT := by
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T'' s'' S'' hden''
  have _ := isTopologicalRing_locUniformSpace P T'' s'' S'' hden''
  have hB := hasDenominatorPower_completionLocalization_of_coe_eq_image P T s S hden T'' s'' S''
    hden'' SB TB hTB
  have _ := isUniformAddGroup_locUniformSpace (completionLocalization P T s S hden) TB
    (toCompletionLoc P T s S hden s'') SB hB
  have _ := isTopologicalRing_locUniformSpace (completionLocalization P T s S hden) TB
    (toCompletionLoc P T s S hden s'') SB hB
  have h := existsUnique_continuous_ringHom_toIteratedLocalization P T s S hden T'' s'' S'' hden''
    SB TB hTB
  have hcont := continuous_iteratedLocalizationRingEquiv P T s S hden T'' s'' S'' hden'' SB TB
    hTB r hs'' hT
  have hcomp := iteratedLocalizationRingEquiv_coe_comp_toCompletionLoc P T s S hden T'' s'' S''
    hden'' SB TB hTB r hs'' hT
  exact fun e he hec ↦ RingEquiv.toRingHom_injective <| h.unique ⟨he, hec⟩ ⟨hcont, hcomp⟩

end PairOfDefinition

