/-!
# Rational localisation as a quotient of a weighted restricted power-series ring

Let `A` be a Huber ring with pair of definition `(A₀, I)`, and let `T ⊆ A` be finite and `s ∈ A`
with `T ∪ {s}` generating an open ideal. Wedhorn constructs the rational localisation `A⟨T/s⟩`
(Proposition and Definition 5.51) from `A[1/s]` with ring of definition `D = A₀[T/s]`. This file
presents it, over an arbitrary Huber ring, as a quotient of the weighted restricted power-series
ring in one variable with weight `T ∪ {s}` (Remark and Definition 5.48):

```text
A⟨X⟩_{T ∪ {s}} → A⟨T/s⟩,      X ↦ 1/s.
```

The weight is what makes the presentation work without a Tate hypothesis: the neighbourhood
`Iᵐ⟨X⟩` of `A⟨X⟩_{T ∪ {s}}`, whose `n`-th coefficients lie in the subgroup generated by
`(T ∪ {s})ⁿ · Iᵐ`, is carried onto the `m`-th neighbourhood `Iᵐ · D` of `A[1/s]`. So the
polynomial evaluation `A[X] → A[1/s]` is an open quotient map, and completing it gives that
`A⟨X⟩_{T ∪ {s}} → A⟨T/s⟩` is an open quotient map. Consequently `A → A⟨T/s⟩` is topologically of
finite type (Wedhorn, Proposition and Definition 6.29(i)) for every Huber ring `A`.

Over a Tate ring, where an open ideal is the unit ideal, the unweighted presentation
`A⟨X₁, …, Xₖ⟩ → A⟨T/s⟩`, `Xᵢ ↦ tᵢ/s`, of
`TauCeti.RingTheory.Huber.LocalizationTopology.Evaluation` is also a quotient map. Over a Huber
ring that is not Tate, such as `ℤ_[p]` with `T = {p}` and `s = p`, the fractions `t/s` need not
generate `A[1/s]` as an `A`-algebra, and the weighted variable is what supplies `1/s`.

## Main definitions

* `TauCeti.Huber.rationalWeight`: the weight family `T ∪ {s}` in one variable.
* `TauCeti.Huber.weightedPolyEvalHom`: the evaluation `A[X] → A[1/s]`, `X ↦ 1/s`, on the
  polynomials inside `A⟨X⟩_{T ∪ {s}}`.
* `TauCeti.Huber.PairOfDefinition.weightedRationalEvalHom`: the completed evaluation
  `A⟨X⟩_{T ∪ {s}} → A⟨T/s⟩`.

## Main results

* `TauCeti.Huber.isWeightFamily_rationalWeight`: over a Huber ring `T ∪ {s}` is an admissible
  weight as soon as it generates an open ideal.
* `TauCeti.Huber.PairOfDefinition.isOpenQuotientMap_weightedPolyEvalHom`: the polynomial
  evaluation is an open quotient map onto `A[1/s]` with its localisation topology.
* `TauCeti.Huber.PairOfDefinition.isOpenQuotientMap_weightedRationalEvalHom`: the completed
  evaluation is an open quotient map onto `A⟨T/s⟩`.
* `TauCeti.Huber.PairOfDefinition.isTopologicallyFiniteType_toCompletionLoc`: the structure map
  `A → A⟨T/s⟩` of a rational localisation of a Huber ring is topologically of finite type.

## References

* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Remark and Definition 5.48,
  Proposition and Definition 5.51, Proposition and Definition 6.29, and Example 6.38.
-/

public section

namespace TauCeti.Huber

open UniformSpace TauCeti.Localization
open scoped Pointwise

section Weight

variable {A : Type*}

/-- The weight family `T ∪ {s}` on a single variable, the weight of the presentation
`A⟨X⟩_{T ∪ {s}} → A⟨T/s⟩`, `X ↦ 1/s`. -/
def rationalWeight (T : Finset A) (s : A) : Fin 1 → Set A := fun _ ↦ insert s (T : Set A)

/-- Every weight set of `rationalWeight T s` is `T ∪ {s}`. -/
@[simp]
theorem rationalWeight_apply (T : Finset A) (s : A) (i : Fin 1) :
    rationalWeight T s i = insert s (T : Set A) := (rfl)

/-- Each weight set of `rationalWeight T s` is finite. -/
theorem finite_rationalWeight (T : Finset A) (s : A) (i : Fin 1) :
    (rationalWeight T s i).Finite :=
  (T.finite_toSet.insert s)

/-- **`T ∪ {s}` is an admissible weight over a Huber ring when it generates an open ideal**, which
is the condition under which `R(T/s)` is a rational subset. -/
theorem isWeightFamily_rationalWeight [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsHuberRing A]
    {T : Finset A} {s : A} (hT : IsOpen (Ideal.span (insert s (T : Set A)) : Set A)) :
    IsWeightFamily (rationalWeight T s) :=
  isWeightFamily_iff_isOpen_span.mpr fun _ ↦ hT

end Weight

section Nonarchimedean

variable {A : Type*} [CommRing A] [TopologicalSpace A] [NonarchimedeanRing A]

section PolynomialEvaluation

variable (T : Finset A) (s : A) (S : Type*) [CommRing S] [Algebra A S] [IsLocalization.Away s S]
  (hW : IsWeightFamily (rationalWeight T s))

/-- **The evaluation `X ↦ 1/s` of polynomials**, read on the subring of polynomials inside
`A⟨X⟩_{T ∪ {s}}`. It lands in `A[1/s]` itself; its completion is
`TauCeti.Huber.PairOfDefinition.weightedRationalEvalHom`. -/
noncomputable def weightedPolyEvalHom : weightedPolynomials (rationalWeight T s) hW →+* S :=
  (MvPolynomial.aeval fun _ ↦ (IsLocalization.Away.invSelf s : S)).toRingHom.comp
    (weightedPolynomialsEquiv hW).symm.toRingHom

/-- **How `TauCeti.Huber.weightedPolyEvalHom` acts**: on the copy of a polynomial inside
`A⟨X⟩_{T ∪ {s}}` it is evaluation of that polynomial at `1/s`. -/
@[simp]
theorem weightedPolyEvalHom_weightedPolynomialsEquiv_apply (p : MvPolynomial (Fin 1) A) :
    weightedPolyEvalHom T s S hW (weightedPolynomialsEquiv hW p)
      = MvPolynomial.aeval (fun _ ↦ (IsLocalization.Away.invSelf s : S)) p := by
  simp [weightedPolyEvalHom]

/-- **The polynomial evaluation is onto `A[1/s]`**: every element of `A[1/s]` is `a/sⁿ`, the value
of `a Xⁿ`. Unlike `TauCeti.Huber.polyEvalHom_surjective`, this needs no hypothesis on `T`. -/
theorem weightedPolyEvalHom_surjective : Function.Surjective (weightedPolyEvalHom T s S hW) := by
  intro z
  obtain ⟨n, a, h⟩ := IsLocalization.Away.surj s z
  refine ⟨weightedPolynomialsEquiv hW (MvPolynomial.monomial (Finsupp.single 0 n) a), ?_⟩
  rw [weightedPolyEvalHom_weightedPolynomialsEquiv_apply, MvPolynomial.aeval_monomial,
    Finsupp.prod_single_index (by simp), ← h, mul_assoc, ← mul_pow,
    IsLocalization.Away.mul_invSelf, one_pow, mul_one]

end PolynomialEvaluation

namespace PairOfDefinition

variable (P : PairOfDefinition A) (T : Finset A) (s : A) (S : Type*) [CommRing S] [Algebra A S]
  [IsLocalization.Away s S] (hden : HasDenominatorPower P T s S)

omit [NonarchimedeanRing A] in
/-- A product of `n` elements of `T ∪ {s}`, divided by `sⁿ`, lies in the ring of definition
`D = A₀[T/s]` of `A[1/s]`. -/
theorem algebraMap_mul_invSelf_pow_mem_locSubring {n : ℕ} {t : A}
    (ht : t ∈ insert s (T : Set A) ^ n) :
    algebraMap A S t * IsLocalization.Away.invSelf s ^ n ∈ locSubring P T s S := by
  induction n generalizing t with
  | zero =>
    obtain rfl : t = 1 := by simpa using ht
    simp
  | succ n ih =>
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_mul.mp (by simpa only [pow_succ] using ht)
    have hfac : algebraMap A S (a * b) * IsLocalization.Away.invSelf s ^ (n + 1)
        = (algebraMap A S a * IsLocalization.Away.invSelf s ^ n)
          * (IsLocalization.Away.invSelf s * algebraMap A S b) := by
      rw [map_mul, pow_succ]; ring
    rw [hfac]
    refine (locSubring P T s S).mul_mem (ih ha) ?_
    -- the new factor is `s/s = 1` or a fraction `t/s`
    rcases hb with hb | hb
    · rw [hb, mul_comm, IsLocalization.Away.mul_invSelf]
      exact (locSubring P T s S).one_mem
    · rw [invSelf_mul_algebraMap]
      exact divBy_mem_locSubring P T s S hb

/-! ### The completed evaluation -/

variable (hW : IsWeightFamily (rationalWeight T s))

/-- The weighted monomials `t · (1/s)ⁿ`, `t ∈ (T ∪ {s})ⁿ`, form a bounded subset of `A⟨T/s⟩`.
This is the hypothesis of the universal property of `A⟨X⟩_{T ∪ {s}}`. -/
theorem isWeightBounded_rationalWeight :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    IsWeightBounded (toCompletionLoc P T s S hden) (rationalWeight T s)
      (fun _ ↦ ((IsLocalization.Away.invSelf s : S) : Completion S)) := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have _ := isHuberRing_locUniformSpace P T s S hden
  -- the weighted monomials lie in the image of the bounded ring of definition `D`
  have hD := isBounded_locSubring P T s S hden
  rw [← locUniformSpace_toTopologicalSpace P T s S hden] at hD
  rw [isWeightBounded_iff]
  refine (isBounded_image_completion_coe_of_isBounded hD).subset
    (Set.iUnion_subset fun ν ↦ ?_)
  rintro _ ⟨t, ht, rfl⟩
  rw [weightPow_def, Fin.prod_univ_one, rationalWeight_apply] at ht
  refine ⟨algebraMap A S t * IsLocalization.Away.invSelf s ^ ν 0,
    algebraMap_mul_invSelf_pow_mem_locSubring P T s S ht, ?_⟩
  simp only [Fin.prod_univ_one, toCompletionLoc_apply]
  -- the coercion is `⇑Completion.coeRingHom`, so it commutes with powers
  rw [Completion.coe_mul]
  exact congrArg _ (map_pow Completion.coeRingHom _ _)

/-- **The evaluation map `A⟨X⟩_{T ∪ {s}} → A⟨T/s⟩`**, sending the variable to `1/s` and each
constant to its image under the structure map: Wedhorn's Proposition 5.50 for the completion of
`A⟨X⟩_{T ∪ {s}}`, applied to `1/s`. -/
noncomputable def weightedRationalEvalHom :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    Completion (weightedRestrictedSubring (rationalWeight T s) hW) →+* Completion S :=
  letI := locUniformSpace P T s S hden
  letI := isUniformAddGroup_locUniformSpace P T s S hden
  letI := isTopologicalRing_locUniformSpace P T s S hden
  letI := isHuberRing_locUniformSpace P T s S hden
  weightedEvalHomCompletion (φ := toCompletionLoc P T s S hden) hW
    (continuous_toCompletionLoc P T s S hden).continuousAt
    (isWeightBounded_rationalWeight P T s S hden)

/-- The evaluation map is continuous. -/
theorem continuous_weightedRationalEvalHom :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    Continuous (weightedRationalEvalHom P T s S hden hW) :=
  letI := locUniformSpace P T s S hden
  letI := isUniformAddGroup_locUniformSpace P T s S hden
  letI := isTopologicalRing_locUniformSpace P T s S hden
  letI := isHuberRing_locUniformSpace P T s S hden
  continuous_weightedEvalHomCompletion _ _ _

/-- The evaluation map sends a constant to its image under the structure map `A → A⟨T/s⟩`. -/
@[simp]
theorem weightedRationalEvalHom_coe_weightedC (a : A) :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    weightedRationalEvalHom P T s S hden hW
        ((weightedC (rationalWeight T s) hW a : weightedRestrictedSubring _ _) :
          Completion (weightedRestrictedSubring (rationalWeight T s) hW))
      = toCompletionLoc P T s S hden a := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have _ := isHuberRing_locUniformSpace P T s S hden
  rw [weightedRationalEvalHom, weightedEvalHomCompletion_coe, weightedEvalHom_weightedC]

/-- **The evaluation map sends the variable to `1/s`**, the defining property. -/
@[simp]
theorem weightedRationalEvalHom_coe_weightedX (i : Fin 1) :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    weightedRationalEvalHom P T s S hden hW
        ((weightedX (rationalWeight T s) hW i : weightedRestrictedSubring _ _) :
          Completion (weightedRestrictedSubring (rationalWeight T s) hW))
      = ((IsLocalization.Away.invSelf s : S) : Completion S) := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have _ := isHuberRing_locUniformSpace P T s S hden
  rw [weightedRationalEvalHom, weightedEvalHomCompletion_coe, weightedEvalHom_weightedX]

/-- **The evaluation map is a map over `A`**: composed with the structure map of
`A⟨X⟩_{T ∪ {s}}` it is the structure map of `A⟨T/s⟩`. -/
theorem weightedRationalEvalHom_comp_algebraMap :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    (weightedRationalEvalHom P T s S hden hW).comp
        (algebraMap A (Completion (weightedRestrictedSubring (rationalWeight T s) hW)))
      = toCompletionLoc P T s S hden := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  refine RingHom.ext fun a ↦ ?_
  rw [RingHom.comp_apply, algebraMap_completion_weightedRestrictedSubring_apply,
    weightedRationalEvalHom_coe_weightedC]

/-- **On a polynomial the completed evaluation is the polynomial evaluation at `1/s`**, carried
into the completion. -/
@[simp]
theorem weightedRationalEvalHom_coe_weightedPolynomialHom (p : MvPolynomial (Fin 1) A) :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    weightedRationalEvalHom P T s S hden hW
        ((weightedPolynomialHom (rationalWeight T s) hW p : weightedRestrictedSubring _ _) :
          Completion (weightedRestrictedSubring (rationalWeight T s) hW))
      = ((MvPolynomial.aeval (fun _ ↦ (IsLocalization.Away.invSelf s : S)) p : S) :
          Completion S) := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  induction p using MvPolynomial.induction_on with
  | C a => simp [toCompletionLoc_apply]
  | add q r hq hr => simp only [map_add, Completion.coe_add, hq, hr]
  | mul_X q i hq =>
    simp only [map_mul, weightedPolynomialHom_X, Completion.coe_mul, hq,
      weightedRationalEvalHom_coe_weightedX, MvPolynomial.aeval_X]

/-! ### The polynomial evaluation is an open quotient map -/

/-- Every element of `D = A₀[T/s]` is the value at `1/s` of a polynomial in
`A₀⟨X⟩_{T ∪ {s}}`. -/
theorem exists_weightedPolyEvalHom_eq_of_mem_locSubring {d : S}
    (hd : d ∈ locSubring P T s S) :
    ∃ g : weightedPolynomials (rationalWeight T s) hW,
      (g : weightedRestrictedSubring _ hW) ∈
          weightedSubring (rationalWeight T s) hW P.ringOfDefinition ∧
        weightedPolyEvalHom T s S hW g = d := by
  let R : Subring (weightedPolynomials (rationalWeight T s) hW) :=
    (weightedSubring (rationalWeight T s) hW P.ringOfDefinition).comap
      (weightedPolynomials (rationalWeight T s) hW).subtype
  suffices h : locSubring P T s S ≤ R.map (weightedPolyEvalHom T s S hW) by
    obtain ⟨g, hg, rfl⟩ := Subring.mem_map.mp (h hd)
    exact ⟨g, hg, rfl⟩
  -- the generators `a ∈ A₀` and `t/s` are the values of `a` and of the weighted variable `t X`
  rw [locSubring_eq_adjoin, Algebra.adjoin_eq_ring_closure, Subring.closure_le]
  rintro _ (⟨a, rfl⟩ | ⟨y, rfl⟩)
  · refine ⟨weightedPolynomialsEquiv hW (MvPolynomial.C a), ?_, ?_⟩
    · simp [R]
    · rw [weightedPolyEvalHom_weightedPolynomialsEquiv_apply, MvPolynomial.aeval_C]
      exact (IsScalarTower.algebraMap_apply P.ringOfDefinition A S a).symm
  · refine ⟨weightedPolynomialsEquiv hW (MvPolynomial.monomial (Finsupp.single 0 1) y), ?_, ?_⟩
    · simp only [R, Subring.mem_carrier, Subring.mem_comap, Subring.subtype_apply,
        coe_weightedPolynomialsEquiv, weightedPolynomialHom_monomial_mem_weightedSubring]
      rw [← mul_one (y : A)]
      exact mul_mem_weightMul _ _ _
        (by simp [weightPow_single]) P.ringOfDefinition.one_mem
    · rw [weightedPolyEvalHom_weightedPolynomialsEquiv_apply, MvPolynomial.aeval_monomial,
        Finsupp.prod_single_index (by simp), pow_one, mul_comm, invSelf_mul_algebraMap]

/-- **Every element of the `m`-th neighbourhood `Iᵐ · D` of `A[1/s]` is the value at `1/s` of a
polynomial in `Iᵐ⟨X⟩`.** This is what makes the evaluation open. -/
theorem exists_weightedPolyEvalHom_eq_of_mem_locIdealImage (m : ℕ) {x : S}
    (hx : x ∈ locIdealImage P T s S m) :
    ∃ f : weightedPolynomials (rationalWeight T s) hW,
      (f : weightedRestrictedSubring _ hW) ∈ weightedNhd (rationalWeight T s) hW (P.idealImage m) ∧
        weightedPolyEvalHom T s S hW f = x := by
  rw [mem_locIdealImage_iff] at hx
  obtain ⟨d, hd, rfl⟩ := hx
  -- the elements of `D` with the stated property form an ideal
  let Q : Ideal (locSubring P T s S) :=
    { carrier := {d | ∃ f : weightedPolynomials (rationalWeight T s) hW,
        (f : weightedRestrictedSubring _ hW) ∈
            weightedNhd (rationalWeight T s) hW (P.idealImage m) ∧
          weightedPolyEvalHom T s S hW f = (d : S)}
      zero_mem' := ⟨0, zero_mem _, by simp⟩
      add_mem' := by
        rintro a b ⟨fa, hfa, ha⟩ ⟨fb, hfb, hb⟩
        exact ⟨fa + fb, add_mem hfa hfb, by rw [map_add, ha, hb]; rfl⟩
      smul_mem' := by
        rintro c a ⟨fa, hfa, ha⟩
        obtain ⟨g, hg, hgc⟩ := exists_weightedPolyEvalHom_eq_of_mem_locSubring P T s S hW c.2
        refine ⟨g * fa, mem_weightedNhd.mpr fun ν ↦ ?_, by rw [map_mul, hgc, ha]; rfl⟩
        have hle : AddSubgroup.closure ((P.ringOfDefinition.toAddSubgroup : Set A) *
            (P.idealImage m : Set A)) ≤ P.idealImage m := by
          rw [AddSubgroup.closure_le]
          rintro _ ⟨u, hu, v, hv, rfl⟩
          exact P.mul_mem_idealImage hu hv
        simpa only [MulMemClass.coe_mul] using weightMul_mono _ ν hle
          (coeff_mul_mem_weightMul (mem_weightedNhd.mp (mem_weightedSubring.mp hg))
            (mem_weightedNhd.mp hfa) ν) }
  have hQle : locIdeal P T s S ^ m ≤ Q := by
    rw [locIdeal_def, ← Ideal.map_pow, Ideal.map_le_iff_le_comap]
    intro c hc
    refine ⟨weightedPolynomialsEquiv hW (MvPolynomial.C (c : A)), ?_, ?_⟩
    · simpa using (P.mem_idealImage m).mpr ⟨c, hc, rfl⟩
    · simp [toLocSubring_apply]
  exact hQle hd

/-- **The polynomial evaluation `X ↦ 1/s` is an open map** for the localisation topology. -/
theorem isOpenMap_weightedPolyEvalHom :
    letI := locTopology P T s S hden
    IsOpenMap (weightedPolyEvalHom T s S hW) := by
  let _ := locTopology P T s S hden
  have _ := isTopologicalRing_locTopology P T s S hden
  rw [IsTopologicalAddGroup.isOpenMap_iff_nhds_zero, Filter.le_map_iff]
  intro V hV
  obtain ⟨W, hW', hWV⟩ := (mem_nhds_subtype _ _ _).mp hV
  obtain ⟨U, -, hUW⟩ := (hasBasis_nhds_zero_weightedTopology hW).mem_iff.mp hW'
  obtain ⟨n, -, hn⟩ := P.hasBasis_nhds_zero.mem_iff.mp (U.isOpen.mem_nhds U.zero_mem)
  refine Filter.mem_of_superset
    ((isOpen_locIdealImage P T s S hden n).mem_nhds (locIdealImage P T s S n).zero_mem)
    fun x hx ↦ ?_
  obtain ⟨f, hf, rfl⟩ := exists_weightedPolyEvalHom_eq_of_mem_locIdealImage P T s S hW n hx
  exact ⟨f, hWV (hUW (weightedNhd_mono (U := P.idealImage n) (V := U.toAddSubgroup) hn hf)), rfl⟩

/-- **The polynomial evaluation is continuous** for the localisation topology. -/
theorem continuous_weightedPolyEvalHom :
    letI := locTopology P T s S hden
    Continuous (weightedPolyEvalHom T s S hW) := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  -- read through the embedding of `A[1/s]` in its completion, the polynomial evaluation is the
  -- restriction of the continuous completed evaluation to the polynomials
  rw [← locUniformSpace_toTopologicalSpace P T s S hden,
    (Completion.isUniformInducing_coe S).isInducing.continuous_iff]
  have h : ((↑) : S → Completion S) ∘ weightedPolyEvalHom T s S hW
      = weightedRationalEvalHom P T s S hden hW ∘ ((↑) : _ → Completion _) ∘
        (Subtype.val : weightedPolynomials (rationalWeight T s) hW → _) := by
    funext f
    obtain ⟨p, rfl⟩ := (weightedPolynomialsEquiv hW).surjective f
    simp
  rw [h]
  exact (continuous_weightedRationalEvalHom P T s S hden hW).comp
    ((Completion.continuous_coe _).comp continuous_subtype_val)

/-- **The polynomial evaluation is an open quotient map onto `A[1/s]`**, with its localisation
topology. -/
theorem isOpenQuotientMap_weightedPolyEvalHom :
    letI := locTopology P T s S hden
    IsOpenQuotientMap (weightedPolyEvalHom T s S hW) :=
  letI := locTopology P T s S hden
  ⟨weightedPolyEvalHom_surjective T s S hW, continuous_weightedPolyEvalHom P T s S hden hW,
    isOpenMap_weightedPolyEvalHom P T s S hden hW⟩

/-! ### The completed evaluation is an open quotient map -/

/-- `TauCeti.Huber.PairOfDefinition.continuous_weightedPolyEvalHom` read at the packaged
uniformity. -/
private theorem continuous_weightedPolyEvalHom_locUniformSpace :
    letI := locUniformSpace P T s S hden
    Continuous (weightedPolyEvalHom T s S hW) := by
  have h := continuous_weightedPolyEvalHom P T s S hden hW
  rwa [← locUniformSpace_toTopologicalSpace P T s S hden] at h

/-- **The comparison square on the completions**: the completed evaluation, after the map induced
by the inclusion of the polynomials, is the completion of the polynomial evaluation. -/
private theorem weightedRationalEvalHom_comp_completionMap :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    (fun w ↦ weightedRationalEvalHom P T s S hden hW
        (Completion.map
          (Subtype.val : weightedPolynomials (rationalWeight T s) hW → _) w))
      = fun w ↦ (weightedPolyEvalHom T s S hW).toAddMonoidHom.completion
        (continuous_weightedPolyEvalHom_locUniformSpace P T s S hden hW) w := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  refine Completion.ext
    ((continuous_weightedRationalEvalHom P T s S hden hW).comp Completion.continuous_map)
    (AddMonoidHom.continuous_completion _ _) fun f ↦ ?_
  obtain ⟨p, rfl⟩ := (weightedPolynomialsEquiv hW).surjective f
  rw [Completion.map_coe uniformContinuous_subtype_val, AddMonoidHom.completion_coe]
  simp

variable [(nhds (0 : A)).IsCountablyGenerated]

/-- **The evaluation map `A⟨X⟩_{T ∪ {s}} → A⟨T/s⟩` is surjective.** -/
theorem weightedRationalEvalHom_surjective :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    Function.Surjective (weightedRationalEvalHom P T s S hden hW) := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have _ : (nhds (0 : weightedPolynomials (rationalWeight T s) hW)).IsCountablyGenerated := by
    rw [nhds_induced, ZeroMemClass.coe_zero]; infer_instance
  have hopen := isOpenMap_weightedPolyEvalHom P T s S hden hW
  rw [← locUniformSpace_toTopologicalSpace P T s S hden] at hopen
  intro y
  obtain ⟨z, hz⟩ := AddMonoidHom.surjective_completion (weightedPolyEvalHom T s S hW).toAddMonoidHom
    (continuous_weightedPolyEvalHom_locUniformSpace P T s S hden hW)
    (weightedPolyEvalHom_surjective T s S hW) hopen y
  exact ⟨_, (congrFun (weightedRationalEvalHom_comp_completionMap P T s S hden hW) z).trans hz⟩

/-- **The evaluation map `A⟨X⟩_{T ∪ {s}} → A⟨T/s⟩` is open.** -/
theorem isOpenMap_weightedRationalEvalHom :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    IsOpenMap (weightedRationalEvalHom P T s S hden hW) := by
  let _ := locUniformSpace P T s S hden
  have _ := isUniformAddGroup_locUniformSpace P T s S hden
  have _ := isTopologicalRing_locUniformSpace P T s S hden
  have _ : (nhds (0 : weightedPolynomials (rationalWeight T s) hW)).IsCountablyGenerated := by
    rw [nhds_induced, ZeroMemClass.coe_zero]; infer_instance
  have hopen := isOpenMap_weightedPolyEvalHom P T s S hden hW
  rw [← locUniformSpace_toTopologicalSpace P T s S hden] at hopen
  have hcompl := AddMonoidHom.isOpenMap_completion (weightedPolyEvalHom T s S hW).toAddMonoidHom
    (continuous_weightedPolyEvalHom_locUniformSpace P T s S hden hW) hopen
  -- the image of a neighbourhood `V` of zero contains the image, under the open completion of the
  -- polynomial evaluation, of the preimage of `V` in the completion of the polynomials
  rw [IsTopologicalAddGroup.isOpenMap_iff_nhds_zero, Filter.le_map_iff]
  intro V hV
  have hpre : Completion.map (Subtype.val : weightedPolynomials (rationalWeight T s) hW → _) ⁻¹' V
      ∈ nhds 0 := by
    refine Completion.continuous_map.continuousAt.preimage_mem_nhds ?_
    rwa [← Completion.coe_zero, Completion.map_coe uniformContinuous_subtype_val,
      ZeroMemClass.coe_zero, Completion.coe_zero]
  refine Filter.mem_of_superset
    (Filter.le_map_iff.mp (IsTopologicalAddGroup.isOpenMap_iff_nhds_zero.mp hcompl) _ hpre) ?_
  rintro _ ⟨w, hw, rfl⟩
  exact ⟨_, hw, congrFun (weightedRationalEvalHom_comp_completionMap P T s S hden hW) w⟩

/-- **The evaluation map `A⟨X⟩_{T ∪ {s}} → A⟨T/s⟩` is an open quotient map**: it presents the
rational localisation of a Huber ring as a topological quotient of a weighted restricted
power-series ring in one variable. -/
theorem isOpenQuotientMap_weightedRationalEvalHom :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    IsOpenQuotientMap (weightedRationalEvalHom P T s S hden hW) :=
  letI := locUniformSpace P T s S hden
  letI := isUniformAddGroup_locUniformSpace P T s S hden
  letI := isTopologicalRing_locUniformSpace P T s S hden
  ⟨weightedRationalEvalHom_surjective P T s S hden hW,
    continuous_weightedRationalEvalHom P T s S hden hW,
    isOpenMap_weightedRationalEvalHom P T s S hden hW⟩

end PairOfDefinition

end Nonarchimedean

namespace PairOfDefinition

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsHuberRing A]
  (P : PairOfDefinition A) (T : Finset A) (s : A) (S : Type*) [CommRing S] [Algebra A S]
  [IsLocalization.Away s S] (hden : HasDenominatorPower P T s S)

/-- **The rational localisation of a Huber ring is topologically of finite type**: if `T ∪ {s}`
generates an open ideal, then `A → A⟨T/s⟩` is presented by `A⟨X⟩_{T ∪ {s}}`, `X ↦ 1/s`
(Wedhorn, Proposition and Definition 6.29(i), at Example 6.38). No Tate hypothesis is needed. -/
theorem isTopologicallyFiniteType_toCompletionLoc
    (hT : IsOpen (Ideal.span (insert s (T : Set A)) : Set A)) :
    letI := locUniformSpace P T s S hden
    letI := isUniformAddGroup_locUniformSpace P T s S hden
    letI := isTopologicalRing_locUniformSpace P T s S hden
    IsTopologicallyFiniteType (toCompletionLoc P T s S hden) :=
  letI := locUniformSpace P T s S hden
  letI := isUniformAddGroup_locUniformSpace P T s S hden
  letI := isTopologicalRing_locUniformSpace P T s S hden
  isTopologicallyFiniteType_iff.mpr ⟨1, rationalWeight T s, finite_rationalWeight T s,
    isWeightFamily_rationalWeight hT, weightedRationalEvalHom P T s S hden _,
    isOpenQuotientMap_weightedRationalEvalHom P T s S hden _,
    weightedRationalEvalHom_comp_algebraMap P T s S hden _⟩

end PairOfDefinition

end TauCeti.Huber

