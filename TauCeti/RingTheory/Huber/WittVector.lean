module

public import Mathlib.RingTheory.WittVector.Teichmuller
public import TauCeti.RingTheory.Huber.Adic

/-!
# Witt vectors with the `(p, [ϖ])`-adic topology are Huber rings

For a commutative ring `R`, a prime `p`, and `ϖ : R`, let `I = (p, [ϖ])` be the ideal of `W(R)`
generated by `p` and the Teichmüller representative of `ϖ`.  Since `I` has two generators, its
adic topology makes `W(R)` a Huber ring with pair of definition `(W(R), I)`.

This is the Huber-ring input for the construction of `A_inf = W(𝒪_F)`.  When `R` is perfect of
characteristic `p` and `(ϖ)`-adically complete, this topology is moreover complete and Hausdorff:
see `TauCeti.WittVector.completeSpace_and_t2Space_adicTopology_span_p_teichmuller` in
`TauCeti/RingTheory/WittVector/Complete.lean`.

## Main results

* `TauCeti.Huber.WittVector.isHuberRing_adicTopology_span_p_teichmuller`: the `(p, [ϖ])`-adic
  Witt-vector ring is Huber.

## References

* L. Fargues and J.-M. Fontaine, *Courbes et fibrés vectoriels en théorie de Hodge p-adique*,
  for the ring `A_inf` and its `(p, [ϖ])`-adic topology.
-/

public section

namespace TauCeti.Huber.WittVector

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R]

/-- Witt vectors equipped with their `(p, [ϖ])`-adic topology form a Huber ring. -/
theorem isHuberRing_adicTopology_span_p_teichmuller (ϖ : R) :
    letI :=
      (Ideal.span {(p : _root_.WittVector p R), _root_.WittVector.teichmuller p ϖ}).adicTopology
    IsHuberRing (_root_.WittVector p R) :=
  isHuberRing_adicTopology _ (Submodule.fg_span (by simp))

end TauCeti.Huber.WittVector
