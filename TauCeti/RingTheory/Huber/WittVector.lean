module

public import TauCeti.RingTheory.Huber.Adic
public import TauCeti.RingTheory.WittVector.Complete

/-!
# Witt vectors with the `(p, [ϖ])`-adic topology: Huber structure and Tate criterion

For a commutative ring `R`, a prime `p`, and `ϖ : R`, let `I = (p, [ϖ])` be the ideal of `W(R)`
generated by `p` and the Teichmüller representative of `ϖ`.  Since `I` has two generators, its
adic topology makes `W(R)` a Huber ring with pair of definition `(W(R), I)`.

This is the Huber-ring input for the construction of `A_inf = W(𝒪_F)`.  When `R` is perfect of
characteristic `p` and `(ϖ)`-adically complete, this topology is moreover complete and Hausdorff:
see `TauCeti.WittVector.completeSpace_and_t2Space_adicTopology_span_p_teichmuller` in
`TauCeti/RingTheory/WittVector/Complete.lean`.

When `R` has characteristic `p` and `ϖ` is not a unit, as for a pseudouniformiser of the ring of
integers `𝒪_F` of a perfectoid field, this Huber ring is not Tate: it has no topologically
nilpotent unit, since the ideal `(p, [ϖ])` is proper. Its rational localisations therefore need the
general topological localisation of Huber rings rather than the Tate-ring one. The topology is
linear (Mathlib's `Ideal.isLinearTopology`), so every element is power-bounded
(`TauCeti.Huber.powerBoundedSubring_eq_top`) and the Huber pair `TauCeti.Huber.Pair.powerBounded`
has plus ring all of `W(R)`: this is the Huber pair `(A_inf, A_inf)`.

## Main results

* `TauCeti.Huber.WittVector.isHuberRing_adicTopology_span_p_teichmuller`: the `(p, [ϖ])`-adic
  Witt-vector ring is Huber.
* `TauCeti.Huber.WittVector.isTateRing_adicTopology_span_p_teichmuller_iff`: if `R` has
  characteristic `p`, it is Tate exactly when `ϖ` is a unit of `R`.

## References

* L. Fargues and J.-M. Fontaine, *Courbes et fibrés vectoriels en théorie de Hodge p-adique*,
  for the ring `A_inf` and its `(p, [ϖ])`-adic topology.
-/

public section

namespace TauCeti.Huber.WittVector

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R]

/-- Witt vectors equipped with their `(p, [ϖ])`-adic topology form a Huber ring. -/
theorem isHuberRing_adicTopology_span_p_teichmuller (ϖ : R) :
    letI :=
      (Ideal.span {(p : _root_.WittVector p R), _root_.WittVector.teichmuller p ϖ}).adicTopology
    IsHuberRing (_root_.WittVector p R) :=
  isHuberRing_adicTopology _ (Submodule.fg_span (by simp))

/-- **`A_inf` is not a Tate ring.** If `R` has characteristic `p`, the Witt vectors with their
`(p, [ϖ])`-adic topology form a Tate ring exactly when `ϖ` is a unit of `R`. So for a
pseudouniformiser `ϖ` of `𝒪_F`, the Huber ring `A_inf = W(𝒪_F)` has no topologically nilpotent
unit. -/
theorem isTateRing_adicTopology_span_p_teichmuller_iff [CharP R p] (ϖ : R) :
    letI :=
      (Ideal.span {(p : _root_.WittVector p R), _root_.WittVector.teichmuller p ϖ}).adicTopology
    IsTateRing (_root_.WittVector p R) ↔ IsUnit ϖ := by
  let _ :=
    (Ideal.span {(p : _root_.WittVector p R), _root_.WittVector.teichmuller p ϖ}).adicTopology
  rw [isTateRing_iff_eq_top_of_isAdic rfl,
    _root_.WittVector.span_p_teichmuller_eq_top_iff]

end TauCeti.Huber.WittVector
