/-!
# Generators of continuous differentials

Let `A → B` be an adic homomorphism with `B` complete and Hausdorff, and let `s ⊆ B` generate a
dense `A`-subalgebra. The completed diagonal ideal `I = ker(B ⊗̂_A B → B)` is then the closure of
the ideal generated by the differences `1 ⊗ b − b ⊗ 1`, `b ∈ s`: modulo that closed ideal every
element of `B ⊗̂_A B` agrees with the left image of its product, since this holds on the dense
image of the algebraic tensor product.

When every ideal of `B ⊗̂_A B` is closed, for instance when it is of noetherian type, the closure
is not needed: `I` is generated by these differences, so `Ωᶜ[B⁄A] = I / I²` is spanned over `B`
by the differentials `d b`, `b ∈ s`. If `B` is of noetherian type and topologically of finite
type over `A`, then `B ⊗̂_A B` is of noetherian type and `B` has a finite set of topological
generators, so `Ωᶜ[B⁄A]` is a finitely generated `B`-module (Huber 1996, (1.6.2)). Without a
noetherian hypothesis the ideal generated by the differences need not be closed, and only the
closure statement holds.

## Main results

* `TauCeti.Huber.ContinuousKaehlerDifferential.ideal_eq_closure_span`: the completed diagonal
  ideal is the closure of the ideal generated by the `1 ⊗ b − b ⊗ 1`, `b ∈ s`.
* `TauCeti.Huber.ContinuousKaehlerDifferential.ideal_eq_span`: if `B ⊗̂_A B` is of noetherian
  type, the completed diagonal ideal is generated by these differences.
* `TauCeti.Huber.ContinuousKaehlerDifferential.span_image_D_eq_top`: then `Ωᶜ[B⁄A]` is spanned
  by `d s`.
* `TauCeti.Huber.ContinuousKaehlerDifferential.finite`: `Ωᶜ[B⁄A]` is a finitely generated
  `B`-module when `B` is of noetherian type and topologically of finite type over `A`.

## References

* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.6, (1.6.2) and its proof.
* K. Fujiwara, F. Kato, *Foundations of rigid geometry I* (2018), Ch. I, §5.1(d),
  Corollary 5.1.11, the formal analogue.
-/

public section

namespace TauCeti.Huber.ContinuousKaehlerDifferential

open CompletedTensor

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [TopologicalSpace A]
  [IsTopologicalRing A] [UniformSpace B] [IsUniformAddGroup B] [NonarchimedeanRing B]
  [CompleteSpace B] [T0Space B] [IsAdicHom (algebraMap A B)]

/-- **Topological generators of the completed diagonal ideal.** If `s ⊆ B` generates a dense
`A`-subalgebra, then the completed diagonal ideal `ker(B ⊗̂_A B → B)` is the closure of the ideal
generated by the differences `1 ⊗ b − b ⊗ 1`, `b ∈ s`. -/
theorem ideal_eq_closure_span {s : Set B} (hs : Dense (Algebra.adjoin A s : Set B)) :
    ideal A B = (Ideal.span ((fun b ↦ inr A B B b - inl A B B b) '' s)).closure := by
  set K := (Ideal.span ((fun b ↦ inr A B B b - inl A B B b) '' s)).closure
  refine le_antisymm (fun x hx ↦ ?_) fun x hx ↦ ?_
  · -- work modulo the closed ideal `K`, a Hausdorff quotient
    have : T1Space (CompletedTensor A B B ⧸ K) := (Ideal.Quotient.t1Space_iff K).mpr <| by
      rw [Ideal.coe_closure]
      exact isClosed_closure
    let q := Ideal.Quotient.mkₐ A K
    have hq : Continuous q := continuous_quot_mk
    -- the two coprojections agree modulo `K` on `s`, hence everywhere by density
    let f : B →A[A] CompletedTensor A B B ⧸ K :=
      ⟨{ q.toRingHom.comp (inr A B B) with commutes' := fun a ↦ by simp },
        hq.comp (continuous_inr A B B)⟩
    let g : B →A[A] CompletedTensor A B B ⧸ K :=
      ⟨{ q.toRingHom.comp (inl A B B) with commutes' := fun a ↦ by simp },
        hq.comp (continuous_inl A B B)⟩
    have hfg : f = g := ContinuousAlgHom.ext_on hs fun b hb ↦ by
      refine (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (subset_closure ?_)
      exact Ideal.subset_span ⟨b, hb, rfl⟩
    -- so the quotient map factors through multiplication `B ⊗̂_A B → B`
    have hm : q.toRingHom = (q.toRingHom.comp (inl A B B)).comp (mulRingHom A B) :=
      hom_ext hq ((hq.comp (continuous_inl A B B)).comp (continuous_mulRingHom A B))
        (by ext; simp) (by
          ext b
          simp only [RingHom.comp_apply, mulRingHom_inr]
          exact congr($hfg b))
    have hx' := RingHom.congr_fun hm x
    simp only [RingHom.comp_apply, mem_ideal_iff.mp hx, map_zero] at hx'
    exact Ideal.Quotient.eq_zero_iff_mem.mp hx'
  · rw [← SetLike.mem_coe, Ideal.coe_closure] at hx
    refine closure_minimal (Ideal.span_le.mpr ?_) (isClosed_ideal A B) hx
    rintro _ ⟨b, -, rfl⟩
    exact inr_sub_inl_mem_ideal A B b

/-- **Generators of the completed diagonal ideal** (Huber 1996, proof of (1.6.2)). If
`B ⊗̂_A B` is of noetherian type and `s ⊆ B` generates a dense `A`-subalgebra, then the completed
diagonal ideal is generated by the differences `1 ⊗ b − b ⊗ 1`, `b ∈ s`: every ideal of the
complete Hausdorff ring `B ⊗̂_A B` is closed. -/
theorem ideal_eq_span [IsNoetherianType (CompletedTensor A B B)] {s : Set B}
    (hs : Dense (Algebra.adjoin A s : Set B)) :
    ideal A B = Ideal.span ((fun b ↦ inr A B B b - inl A B B b) '' s) := by
  rw [ideal_eq_closure_span hs, Ideal.closure_eq_of_isClosed _ (IsNoetherianType.isClosed_ideal _)]

/-- **Continuous differentials are spanned by the differentials of topological generators.** If
`B ⊗̂_A B` is of noetherian type and `s ⊆ B` generates a dense `A`-subalgebra, then `Ωᶜ[B⁄A]` is
spanned over `B` by `d b`, `b ∈ s`. -/
theorem span_image_D_eq_top [IsNoetherianType (CompletedTensor A B B)] {s : Set B}
    (hs : Dense (Algebra.adjoin A s : Set B)) :
    Submodule.span B (D A B '' s) = ⊤ := by
  set N := Submodule.span B (D A B '' s)
  -- induct over the ideal generated by the differences
  have key (x : CompletedTensor A B B)
      (hx : x ∈ Ideal.span ((fun b ↦ inr A B B b - inl A B B b) '' s)) :
      fromIdeal A B ⟨x, (ideal_eq_span hs).ge hx⟩ ∈ N := by
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨b, hb, rfl⟩ := hy
      exact Submodule.subset_span ⟨b, hb, D_apply A B b⟩
    | zero =>
      rw [(Submodule.mk_eq_zero _ _).mpr rfl, map_zero]
      exact N.zero_mem
    | add y z hy' hz' hy hz =>
      rw [show (⟨y + z, _⟩ : ideal A B) =
        ⟨y, (ideal_eq_span hs).ge hy'⟩ + ⟨z, (ideal_eq_span hs).ge hz'⟩ by ext; simp, map_add]
      exact N.add_mem hy hz
    | smul c y hy' hy =>
      rw [show (⟨c • y, _⟩ : ideal A B) = c • ⟨y, (ideal_eq_span hs).ge hy'⟩ by ext; simp,
        map_smul, smul_eq_mulRingHom_smul]
      exact N.smul_mem _ hy
  refine eq_top_iff.mpr fun ω _ ↦ ?_
  obtain ⟨⟨x, hx⟩, rfl⟩ := fromIdeal_surjective A B ω
  rw [ideal_eq_span hs] at hx
  exact key x hx

/-- If `B ⊗̂_A B` is of noetherian type, `Ωᶜ[B⁄A]` is spanned over `B` by the image of `d`. -/
theorem span_range_D_eq_top [IsNoetherianType (CompletedTensor A B B)] :
    Submodule.span B (Set.range (D A B)) = ⊤ := by
  rw [← Set.image_univ]
  exact span_image_D_eq_top (by simp)

/-- If `B ⊗̂_A B` is of noetherian type, two `B`-linear maps out of `Ωᶜ[B⁄A]` agreeing on every
`d b` are equal. -/
@[ext]
theorem linearMap_ext [IsNoetherianType (CompletedTensor A B B)] {M : Type*} [AddCommMonoid M]
    [Module B M] {u v : ContinuousKaehlerDifferential A B →ₗ[B] M}
    (h : ∀ b, u (D A B b) = v (D A B b)) : u = v :=
  LinearMap.ext_on_range span_range_D_eq_top h

/-- **Continuous differentials are finitely generated** (Huber 1996, (1.6.2)). If `B` is of
noetherian type and topologically of finite type over `A`, then `Ωᶜ[B⁄A]` is a finitely
generated `B`-module, spanned by the differentials of finitely many topological generators. -/
theorem finite [IsHuberRing A] [IsHuberRing B] [IsNoetherianType B]
    (h : IsTopologicallyFiniteType (algebraMap A B)) :
    Module.Finite B (ContinuousKaehlerDifferential A B) := by
  have := isNoetherianType_of_isTopologicallyFiniteType (B := B) h
  obtain ⟨s, hs, hdense⟩ := h.exists_finite_dense_adjoin
  exact ⟨⟨(hs.image (D A B)).toFinset, by
    rw [Set.Finite.coe_toFinset, span_image_D_eq_top hdense]⟩⟩

end TauCeti.Huber.ContinuousKaehlerDifferential
