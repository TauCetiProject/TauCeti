module

public import TauCeti.RingTheory.Huber.TensorProduct.Completion
public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.Topology.Algebra.Module.ModuleTopology

/-!
# Continuous differentials of a complete Huber algebra

Let `A → B` be an adic homomorphism, with `B` complete and Hausdorff, and let
`m : B ⊗̂_A B → B` be the continuous extension of multiplication `b ⊗ b' ↦ b b'` to the separated
completed tensor ring. The *module of continuous differentials* is `Ωᶜ[B⁄A] := I / I²` for
`I = ker m` (Huber 1996, Definition 1.6.1 and the paragraph after it). It is a `B`-module through
the left coprojection `B → B ⊗̂_A B`, carries the natural `B`-module topology, and receives the
derivation `d : B → Ωᶜ[B⁄A]`, `b ↦ [1 ⊗ b − b ⊗ 1]`.

This is the completed analogue of Mathlib's `KaehlerDifferential`, which is the same construction
on the uncompleted tensor product `B ⊗[A] B`. The two differ: for the Tate algebra
`ℚ_p⟨T⟩` over `ℚ_p`, Mathlib's `Ω[ℚ_p⟨T⟩⁄ℚ_p]` is not finitely generated, while `Ωᶜ` is
free on `dT`. Completing the tensor product is what makes `Ωᶜ[B⁄A]` see only the topology of `B`
over `A`. The universal property of Kähler differentials gives the comparison
`Ω[B⁄A] → Ωᶜ[B⁄A]`; on the diagonal ideal it is the map induced by `B ⊗[A] B → B ⊗̂_A B`.

The finiteness, continuity and universality of `d`, which need a noetherian hypothesis on `A` so
that the ideal generated by the `1 ⊗ b − b ⊗ 1` is closed, are not treated here. What is proved
here holds for every adic `A → B` with `B` complete and Hausdorff.

## Main definitions

* `TauCeti.Huber.ContinuousKaehlerDifferential.ideal`: the kernel of the multiplication map
  `TauCeti.Huber.CompletedTensor.mulRingHom : B ⊗̂_A B → B`, the completed diagonal ideal.
* `TauCeti.Huber.ContinuousKaehlerDifferential A B`: the continuous differentials `Ωᶜ[B⁄A]`.
* `TauCeti.Huber.ContinuousKaehlerDifferential.D`: the derivation `d : B → Ωᶜ[B⁄A]`.
* `TauCeti.Huber.ContinuousKaehlerDifferential.fromKaehler`: the `B`-linear comparison
  `Ω[B⁄A] → Ωᶜ[B⁄A]` from Mathlib's Kähler differentials.

## Main results

* `TauCeti.Huber.ContinuousKaehlerDifferential.smul_eq_mulRingHom_smul`: the action of
  `B ⊗̂_A B` on `Ωᶜ[B⁄A]` factors through multiplication; in particular the two coprojections
  induce the same `B`-module structure.
* `TauCeti.Huber.ContinuousKaehlerDifferential.fromKaehler_fromIdeal`: the comparison is induced
  by the completion map on diagonal ideals.
* `TauCeti.Huber.ContinuousKaehlerDifferential.subsingleton_of_surjective`: `Ωᶜ[B⁄A] = 0` when
  `A → B` is surjective; in particular `Ωᶜ[A⁄A] = 0` for complete Hausdorff `A`.

## References

* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.6, Definition 1.6.1 and (1.6.2).
* K. Fujiwara, F. Kato, *Foundations of rigid geometry I* (2018), Ch. I, §5.1, the formal
  analogue `Ω̂`.
-/

public section

open TensorProduct

namespace TauCeti.Huber

variable (A B : Type*) [CommRing A] [CommRing B] [Algebra A B] [TopologicalSpace A]
  [IsTopologicalRing A] [UniformSpace B] [IsUniformAddGroup B] [NonarchimedeanRing B]
  [CompleteSpace B] [T0Space B] [IsAdicHom (algebraMap A B)]

open CompletedTensor

namespace ContinuousKaehlerDifferential

/-- The **completed diagonal ideal**: the kernel of multiplication `B ⊗̂_A B → B`. -/
noncomputable def ideal : Ideal (CompletedTensor A B B) :=
  RingHom.ker (mulRingHom A B)

variable {A B} in
/-- An element lies in the completed diagonal ideal exactly when its product is zero. -/
@[simp] theorem mem_ideal_iff {x : CompletedTensor A B B} :
    x ∈ ideal A B ↔ mulRingHom A B x = 0 :=
  RingHom.mem_ker

/-- `1 ⊗ b − b ⊗ 1` lies in the completed diagonal ideal. -/
theorem inr_sub_inl_mem_ideal (b : B) : inr A B B b - inl A B B b ∈ ideal A B := by
  simp

end ContinuousKaehlerDifferential

/-- The **module of continuous differentials** `Ωᶜ[B⁄A] = I / I²` of a complete Hausdorff
`A`-algebra `B` along an adic structure map, where `I` is the kernel of multiplication
`B ⊗̂_A B → B` on the separated completed tensor ring (Huber 1996, Definition 1.6.1). -/
noncomputable def ContinuousKaehlerDifferential : Type _ :=
  (ContinuousKaehlerDifferential.ideal A B).Cotangent

namespace ContinuousKaehlerDifferential

noncomputable instance : AddCommGroup (ContinuousKaehlerDifferential A B) :=
  inferInstanceAs (AddCommGroup (ideal A B).Cotangent)

noncomputable instance : Module (CompletedTensor A B B) (ContinuousKaehlerDifferential A B) :=
  inferInstanceAs (Module (CompletedTensor A B B) (ideal A B).Cotangent)

noncomputable instance : Module A (ContinuousKaehlerDifferential A B) :=
  inferInstanceAs (Module A (ideal A B).Cotangent)

instance : IsScalarTower A (CompletedTensor A B B) (ContinuousKaehlerDifferential A B) :=
  inferInstanceAs (IsScalarTower A (CompletedTensor A B B) (ideal A B).Cotangent)

/-- `Ωᶜ[B⁄A]` is a `B`-module through the left coprojection `B → B ⊗̂_A B`; by
`TauCeti.Huber.ContinuousKaehlerDifferential.inr_smul` the right coprojection gives the same
action. -/
noncomputable instance : Module B (ContinuousKaehlerDifferential A B) :=
  Module.compHom _ (inl A B B)

/-- `Ωᶜ[B⁄A]` carries the natural topology of a `B`-module. -/
noncomputable instance : TopologicalSpace (ContinuousKaehlerDifferential A B) :=
  moduleTopology B _

instance : IsModuleTopology B (ContinuousKaehlerDifferential A B) := ⟨rfl⟩

instance : IsTopologicalAddGroup (ContinuousKaehlerDifferential A B) :=
  IsModuleTopology.isTopologicalAddGroup B _

/-- The quotient map `I → Ωᶜ[B⁄A] = I / I²` from the completed diagonal ideal. -/
noncomputable def fromIdeal :
    ideal A B →ₗ[CompletedTensor A B B] ContinuousKaehlerDifferential A B :=
  (ideal A B).toCotangent

/-- Every continuous differential is the class of an element of the completed diagonal ideal. -/
theorem fromIdeal_surjective : Function.Surjective (fromIdeal A B) :=
  (ideal A B).toCotangent_surjective

variable {A B}

/-- Two elements of the diagonal ideal have the same class in `Ωᶜ[B⁄A]` exactly when their
difference lies in `I²`. -/
theorem fromIdeal_eq_fromIdeal_iff {x y : ideal A B} :
    fromIdeal A B x = fromIdeal A B y ↔ (x - y : CompletedTensor A B B) ∈ ideal A B ^ 2 :=
  (ideal A B).toCotangent_eq

/-- An element of the diagonal ideal has zero class in `Ωᶜ[B⁄A]` exactly when it lies in `I²`. -/
theorem fromIdeal_eq_zero_iff {x : ideal A B} :
    fromIdeal A B x = 0 ↔ (x : CompletedTensor A B B) ∈ ideal A B ^ 2 :=
  (ideal A B).toCotangent_eq_zero x

/-- The `B`-action on `Ωᶜ[B⁄A]` is the action of the left coprojection. -/
@[simp] theorem inl_smul (b : B) (ω : ContinuousKaehlerDifferential A B) :
    inl A B B b • ω = b • ω := (rfl)

/-- The action of `B ⊗̂_A B` on `Ωᶜ[B⁄A]` factors through multiplication `B ⊗̂_A B → B`: the
completed diagonal ideal kills `Ωᶜ[B⁄A] = I / I²`. -/
theorem smul_eq_mulRingHom_smul (x : CompletedTensor A B B)
    (ω : ContinuousKaehlerDifferential A B) : x • ω = mulRingHom A B x • ω := by
  rw [← inl_smul, ← sub_eq_zero, ← sub_smul]
  refine Ideal.Cotangent.smul_eq_zero_of_mem (I := ideal A B) ?_ ω
  simp

/-- The right coprojection induces the same `B`-action on `Ωᶜ[B⁄A]` as the left one. -/
@[simp] theorem inr_smul (b : B) (ω : ContinuousKaehlerDifferential A B) :
    inr A B B b • ω = b • ω := by
  rw [smul_eq_mulRingHom_smul, mulRingHom_inr]

instance : IsScalarTower A B (ContinuousKaehlerDifferential A B) where
  smul_assoc a b ω := by
    rw [← inl_smul, ← inl_smul, Algebra.smul_def, map_mul, mul_smul, inl_algebraMap,
      algebraMap_smul]

variable (A B)

/-- The derivation `d : B → Ωᶜ[B⁄A]`, sending `b` to the class of `1 ⊗ b − b ⊗ 1`. -/
noncomputable def D : Derivation A B (ContinuousKaehlerDifferential A B) :=
  Derivation.mk'
    { toFun b := fromIdeal A B ⟨inr A B B b - inl A B B b, inr_sub_inl_mem_ideal A B b⟩
      map_add' b c := by
        rw [← map_add]
        congr 1
        ext
        simp only [map_add, Submodule.coe_add]
        ring
      map_smul' a b := by
        rw [RingHom.id_apply,
          ← algebraMap_smul (CompletedTensor A B B) (M := ContinuousKaehlerDifferential A B) a,
          ← map_smul]
        congr 1
        ext
        simp only [Algebra.smul_def, map_mul, inl_algebraMap, inr_algebraMap,
          Submodule.coe_smul, Algebra.algebraMap_self, RingHom.id_apply]
        ring }
    fun a b ↦ by
      simp only [LinearMap.coe_mk, AddHom.coe_mk, ← inl_smul, ← map_smul, ← map_add,
        fromIdeal_eq_fromIdeal_iff, pow_two]
      convert Ideal.mul_mem_mul (inr_sub_inl_mem_ideal A B a) (inr_sub_inl_mem_ideal A B b)
        using 1
      simp only [map_mul, Submodule.coe_add, Submodule.coe_smul, smul_eq_mul]
      ring

/-- `d b` is the class of `1 ⊗ b − b ⊗ 1`. -/
theorem D_apply (b : B) :
    D A B b = fromIdeal A B ⟨inr A B B b - inl A B B b, inr_sub_inl_mem_ideal A B b⟩ := (rfl)

/-- The **comparison with Kähler differentials**: the `B`-linear map `Ω[B⁄A] → Ωᶜ[B⁄A]` induced,
by the universal property of `Ω[B⁄A]`, by the derivation `d`. -/
noncomputable def fromKaehler : Ω[B⁄A] →ₗ[B] ContinuousKaehlerDifferential A B :=
  (D A B).liftKaehlerDifferential

/-- The comparison sends the universal derivation to `d`. -/
@[simp] theorem fromKaehler_D (b : B) :
    fromKaehler A B (KaehlerDifferential.D A B b) = D A B b :=
  (D A B).liftKaehlerDifferential_comp_D b

/-- The image of `x ∈ B ⊗[A] B` in `B ⊗̂_A B`, corrected by the left image of its product, lies in
the completed diagonal ideal. -/
private theorem toCompletion_sub_inl_mem_ideal (x : B ⊗[A] B) :
    toCompletion A B B x - inl A B B (Algebra.TensorProduct.lmul' A x) ∈ ideal A B := by
  simp

/-- The `B ⊗[A] B`-linear map attached to `d` sends `x` to the class of
`x − (product of x) ⊗ 1` in `B ⊗̂_A B`. -/
private theorem tensorProductTo_D (x : B ⊗[A] B) :
    (D A B).tensorProductTo x = fromIdeal A B ⟨_, toCompletion_sub_inl_mem_ideal A B x⟩ := by
  induction x using TensorProduct.inductionOn with
  | tmul b c =>
    rw [Derivation.tensorProductTo_tmul, D_apply, ← inl_smul, ← map_smul]
    congr 1
    ext
    simp only [Submodule.coe_smul, smul_eq_mul, toCompletion_tmul,
      Algebra.TensorProduct.lmul'_apply_tmul, map_mul]
    ring
  | add x y hx hy =>
    rw [map_add, hx, hy, ← map_add]
    congr 1
    ext
    simp only [map_add, Submodule.coe_add]
    ring

/-- On the algebraic diagonal ideal, the comparison `Ω[B⁄A] → Ωᶜ[B⁄A]` is induced by the
completion map `B ⊗[A] B → B ⊗̂_A B`, which carries the algebraic diagonal ideal into the
completed one. -/
theorem fromKaehler_fromIdeal (x : KaehlerDifferential.ideal A B) :
    fromKaehler A B (KaehlerDifferential.fromIdeal A B x) =
      fromIdeal A B ⟨toCompletion A B B x, by
        simpa using RingHom.mem_ker.mp x.2⟩ := by
  refine ((D A B).liftKaehlerDifferential_apply x).trans ?_
  rw [tensorProductTo_D]
  congr 1
  ext
  simp [RingHom.mem_ker.mp x.2]

variable {A B}

/-- **Continuous differentials vanish along a surjection**: if `A → B` is surjective, then
`Ωᶜ[B⁄A] = 0`, because multiplication `B ⊗̂_A B → B` is then injective. -/
theorem subsingleton_of_surjective (h : Function.Surjective (algebraMap A B)) :
    Subsingleton (ContinuousKaehlerDifferential A B) := by
  refine subsingleton_of_forall_eq 0 fun ω ↦ ?_
  obtain ⟨⟨x, hx⟩, rfl⟩ := fromIdeal_surjective A B ω
  have hx0 : x = 0 := by
    rw [← inl_mulRingHom_of_surjective h x, mem_ideal_iff.mp hx, map_zero]
  subst hx0
  exact (fromIdeal A B).map_zero

end ContinuousKaehlerDifferential

end TauCeti.Huber
