/-!
# Generation, finiteness, and finite-algebra comparison for continuous differentials

Let `A → B` be an adic homomorphism into a complete Hausdorff ring `B`. This file establishes
the topological generation of the completed diagonal ideal `I = ker (B ⊗̂_A B → B)` by elements
`1 ⊗ b − b ⊗ 1` for `b` ranging over any subset `S ⊆ B` whose `A`-subalgebra `A[S]` is dense in
`B`, together with Huber's finiteness, separatedness, and finite-algebra comparison properties
(Huber 1996, §1.6, (1.6.2)(ii)–(iii)):

* Without any noetherian or finite-type hypothesis, `I` is the closure in `B ⊗̂_A B` of the ideal
  generated by `{1 ⊗ b − b ⊗ 1 | b ∈ S}` (`closure_span_inr_sub_inl_eq_ideal`).
* If `A` is a Huber ring, `B` is of noetherian type, and `A → B` is topologically of finite type,
  then `B ⊗̂_A B` is again of noetherian type (`CompletedTensor.isTopologicallyFiniteType_inl` and
  `IsNoetherianType.of_isTopologicallyFiniteType`), so every ideal of `B ⊗̂_A B` is closed. Hence
  `I` is generated algebraically by `{1 ⊗ b − b ⊗ 1 | b ∈ S}` (`span_inr_sub_inl_eq_ideal`),
  `Ωᶜ[B⁄A]` is spanned over `B` by `d '' S` (`span_D_eq_top`), both `I` and `Ωᶜ[B⁄A]` are finitely
  generated (`ideal_fg`, `finite`), and `Ωᶜ[B⁄A]` is naturally complete and Hausdorff in its
  natural `B`-module topology (`isNaturallyComplete`, `t2Space`). Note that `[IsNoetherianType B]`
  is strictly weaker than `[IsNoetherianType A]`, since noetherian type ascends along `A → B` by
  `IsNoetherianType.of_isTopologicallyFiniteType`.
* If `B` is module-finite over `A`, carries the `A`-module topology, and is a complete Hausdorff
  Huber ring of noetherian type, then `B ⊗[A] B → B ⊗̂_A B` is bijective
  (`CompletedTensor.toCompletion_bijective_of_isNoetherianType`) and the comparison
  `fromKaehler A B : Ω[B⁄A] →ₗ[B] Ωᶜ[B⁄A]` is an isomorphism (`fromKaehler_bijective_of_finite`,
  `fromKaehlerEquiv`; over a complete Tate base `[IsModuleTopology A B]` is automatic,
  `fromKaehler_bijective_of_finite_of_isTateRing`).

## Main results

* `TauCeti.Huber.ContinuousKaehlerDifferential.closure_span_inr_sub_inl_eq_ideal`: `I` is the
  closure of the ideal generated by `{1 ⊗ b − b ⊗ 1 | b ∈ S}` for any `S` with `A[S]` dense in `B`.
* `TauCeti.Huber.ContinuousKaehlerDifferential.span_inr_sub_inl_eq_ideal`,
  `TauCeti.Huber.ContinuousKaehlerDifferential.span_D_eq_top`: algebraic generation of `I` and
  `Ωᶜ[B⁄A]` (Huber 1996, §1.6, (1.6.2)(ii)).
* `TauCeti.Huber.ContinuousKaehlerDifferential.ideal_fg`,
  `TauCeti.Huber.ContinuousKaehlerDifferential.finite`: `I` and `Ωᶜ[B⁄A]` are finitely generated.
* `TauCeti.Huber.ContinuousKaehlerDifferential.isNaturallyComplete`,
  `TauCeti.Huber.ContinuousKaehlerDifferential.t2Space`: `Ωᶜ[B⁄A]` is complete and Hausdorff.
* `TauCeti.Huber.ContinuousKaehlerDifferential.fromKaehler_bijective_of_finite`,
  `TauCeti.Huber.ContinuousKaehlerDifferential.fromKaehlerEquiv`: isomorphism with algebraic
  Kähler differentials for finite algebras (Huber 1996, §1.6, (1.6.2)(iii)).

## References

* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.6, (1.6.2)(ii)–(iii).
-/

public section

open TensorProduct Algebra.TensorProduct UniformSpace Topology
open scoped Uniformity

namespace TauCeti.Huber

namespace ContinuousKaehlerDifferential

open CompletedTensor

section TopologicalGeneration

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [TopologicalSpace A]
  [IsTopologicalRing A] [UniformSpace B] [IsUniformAddGroup B] [NonarchimedeanRing B]
  [CompleteSpace B] [T0Space B] [IsAdicHom (algebraMap A B)]

omit [IsUniformAddGroup B] [CompleteSpace B] [T0Space B] in
/-- If `A[S]` is dense in `B`, then `1 ⊗ b − b ⊗ 1` belongs to the closure of the ideal generated
by `{1 ⊗ s − s ⊗ 1 | s ∈ S}` for every `b ∈ B`. -/
private theorem inr_sub_inl_mem_closure_span {S : Set B}
    (hS : Dense (Algebra.adjoin A S : Set B)) (b : B) :
    inr A B B b - inl A B B b ∈
      (Ideal.span ((fun s ↦ inr A B B s - inl A B B s) '' S)).closure := by
  let I₀ := Ideal.span ((fun s ↦ inr A B B s - inl A B B s) '' S)
  let R₀ : Subalgebra A B :=
    { carrier := {x : B | inr A B B x - inl A B B x ∈ I₀.closure}
      algebraMap_mem' a := by simp
      add_mem' {x y} hx hy := by
        have hxy : inr A B B (x + y) - inl A B B (x + y) =
            (inr A B B x - inl A B B x) + (inr A B B y - inl A B B y) := by
          simp only [map_add]; ring
        rw [Set.mem_ofPred_eq, hxy]
        exact I₀.closure.add_mem hx hy
      mul_mem' {x y} hx hy := by
        have hxy : inr A B B (x * y) - inl A B B (x * y) =
            inr A B B x * (inr A B B y - inl A B B y) +
              inl A B B y * (inr A B B x - inl A B B x) := by
          simp only [map_mul]; ring
        rw [Set.mem_ofPred_eq, hxy]
        exact I₀.closure.add_mem (I₀.closure.mul_mem_left _ hy)
          (I₀.closure.mul_mem_left _ hx) }
  have hclosed : IsClosed (R₀ : Set B) := by
    convert (isClosed_closure (s := (I₀ : Set _))).preimage
      ((continuous_inr A B B).sub (continuous_inl A B B)) using 1
    ext x
    simp [R₀, ← Ideal.coe_closure]
  have hle : (Algebra.adjoin A S : Set B) ⊆ R₀ :=
    Algebra.adjoin_le fun s hs ↦ by
      rw [SetLike.mem_coe, Subalgebra.mem_mk, Subsemiring.mem_mk, Submonoid.mem_mk,
        Subsemigroup.mem_mk, Set.mem_ofPred_eq, ← SetLike.mem_coe, Ideal.coe_closure]
      exact subset_closure (Ideal.subset_span ⟨s, hs, rfl⟩)
  exact closure_minimal hle hclosed (hS b)

omit [IsUniformAddGroup B] [CompleteSpace B] [T0Space B] in
/-- Every algebraic tensor `x ∈ B ⊗[A] B`, corrected by the left image of its product, lies in the
closure of the ideal generated by `{1 ⊗ s − s ⊗ 1 | s ∈ S}`. -/
private theorem toCompletion_sub_inl_lmul_mem_closure_span {S : Set B}
    (hS : Dense (Algebra.adjoin A S : Set B)) (x : B ⊗[A] B) :
    toCompletion A B B x - inl A B B (Algebra.TensorProduct.lmul' A x) ∈
      (Ideal.span ((fun s ↦ inr A B B s - inl A B B s) '' S)).closure := by
  let J := (Ideal.span ((fun s ↦ inr A B B s - inl A B B s) '' S)).closure
  induction x using TensorProduct.inductionOn with
  | tmul b c =>
    have hbc : toCompletion A B B (b ⊗ₜ[A] c) - inl A B B (Algebra.TensorProduct.lmul' A (b ⊗ₜ c)) =
        inl A B B b * (inr A B B c - inl A B B c) := by
      simp only [toCompletion_tmul, lmul'_apply_tmul, map_mul]; ring
    exact hbc ▸ J.mul_mem_left _ (inr_sub_inl_mem_closure_span hS c)
  | add x y hx hy =>
    have hxy : toCompletion A B B (x + y) - inl A B B (Algebra.TensorProduct.lmul' A (x + y)) =
        (toCompletion A B B x - inl A B B (Algebra.TensorProduct.lmul' A x)) +
          (toCompletion A B B y - inl A B B (Algebra.TensorProduct.lmul' A y)) := by
      simp only [map_add]; ring
    exact hxy ▸ J.add_mem hx hy

/-- **Topological generation of the completed diagonal ideal**: for any subset `S ⊆ B` whose
`A`-subalgebra `A[S]` is dense in `B`, the completed diagonal ideal `ker (B ⊗̂_A B → B)` is the
closure of the ideal generated by `{1 ⊗ s − s ⊗ 1 | s ∈ S}`. No noetherian or finite-type
hypothesis is required. -/
theorem closure_span_inr_sub_inl_eq_ideal {S : Set B}
    (hS : Dense (Algebra.adjoin A S : Set B)) :
    (Ideal.span ((fun s ↦ inr A B B s - inl A B B s) '' S)).closure = ideal A B := by
  let J := Ideal.span ((fun s ↦ inr A B B s - inl A B B s) '' S)
  refine le_antisymm ?_ fun z hz ↦ ?_
  · rw [← SetLike.coe_subset_coe, Ideal.coe_closure]
    refine closure_minimal ?_ (isClosed_ideal A B)
    rw [SetLike.coe_subset_coe, Ideal.span_le]
    rintro _ ⟨s, -, rfl⟩
    exact inr_sub_inl_mem_ideal A B s
  · have hclosed : IsClosed {w : CompletedTensor A B B |
        w - inl A B B (mulRingHom A B w) ∈ J.closure} :=
      (Ideal.coe_closure J ▸ isClosed_closure).preimage
        (continuous_id.sub ((continuous_inl A B B).comp (continuous_mulRingHom A B)))
    have hmem : z - inl A B B (mulRingHom A B z) ∈ J.closure := by
      refine closure_minimal ?_ hclosed (denseRange_toCompletion A B B z)
      rintro _ ⟨x, rfl⟩
      simpa only [Set.mem_ofPred_eq, mulRingHom_toCompletion] using
        toCompletion_sub_inl_lmul_mem_closure_span hS x
    simpa [mem_ideal_iff.mp hz] using hmem

variable (A B) in
/-- The completed diagonal ideal is the closure of the ideal generated by all elements
`1 ⊗ b − b ⊗ 1` for `b ∈ B`. -/
theorem closure_span_range_inr_sub_inl_eq_ideal :
    (Ideal.span (Set.range fun b : B ↦ inr A B B b - inl A B B b)).closure = ideal A B := by
  simpa [Set.image_univ] using closure_span_inr_sub_inl_eq_ideal (A := A) (B := B) (S := Set.univ)
    (by simp [Algebra.adjoin_univ])

/-- Whenever `{1 ⊗ s − s ⊗ 1 | s ∈ S}` generates `ideal A B` as an ideal of `B ⊗̂_A B`, its images
`d '' S` span `Ωᶜ[B⁄A]` as a `B`-module. -/
theorem span_D_eq_top_of_span_eq_ideal {S : Set B}
    (hspan : Ideal.span ((fun s ↦ inr A B B s - inl A B B s) '' S) = ideal A B) :
    Submodule.span B (D A B '' S) = ⊤ := by
  let M := Submodule.span B (D A B '' S)
  let P : Ideal (CompletedTensor A B B) :=
    { carrier := {z | ∃ hz : z ∈ ideal A B, fromIdeal A B ⟨z, hz⟩ ∈ M}
      zero_mem' := ⟨zero_mem _, by
        rw [(Submodule.mk_eq_zero _ _).mpr rfl, map_zero]
        exact M.zero_mem⟩
      add_mem' {x y} := fun ⟨hx, hfx⟩ ⟨hy, hfy⟩ ↦
        ⟨add_mem hx hy, by
          rw [← AddMemClass.mk_add_mk (hx := hx) (hy := hy), map_add]
          exact M.add_mem hfx hfy⟩
      smul_mem' r {x} := fun ⟨hx, hfx⟩ ↦
        ⟨(ideal A B).mul_mem_left r hx, by
          rw [← SetLike.mk_smul_mk (hx := hx), map_smul, smul_eq_mulRingHom_smul]
          exact M.smul_mem _ hfx⟩ }
  have hle : ideal A B ≤ P := by
    rw [← hspan, Ideal.span_le]
    rintro _ ⟨s, hs, rfl⟩
    exact ⟨inr_sub_inl_mem_ideal A B s, Submodule.subset_span ⟨s, hs, D_apply A B s⟩⟩
  rw [eq_top_iff]
  rintro ω -
  obtain ⟨⟨z, hz⟩, rfl⟩ := fromIdeal_surjective A B ω
  obtain ⟨_, hfz⟩ := hle hz
  exact hfz

end TopologicalGeneration

section FiniteType

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
  [TopologicalSpace A] [IsTopologicalRing A] [IsHuberRing A]
  [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsHuberRing B]
  [CompleteSpace B] [T0Space B] [IsNoetherianType B] [IsAdicHom (algebraMap A B)]

/-- **Algebraic generation of the completed diagonal ideal** (Huber 1996, §1.6, (1.6.2)(ii)):
if `A` is a Huber ring, `B` is a complete Hausdorff Huber ring of noetherian type, `A → B` is
topologically of finite type, and `A[S]` is dense in `B`, then `ideal A B` is generated as an ideal
of `B ⊗̂_A B` by `{1 ⊗ s − s ⊗ 1 | s ∈ S}`. -/
theorem span_inr_sub_inl_eq_ideal (h : IsTopologicallyFiniteType (algebraMap A B)) {S : Set B}
    (hS : Dense (Algebra.adjoin A S : Set B)) :
    Ideal.span ((fun s ↦ inr A B B s - inl A B B s) '' S) = ideal A B := by
  have : IsNoetherianType (CompletedTensor A B B) :=
    .of_isTopologicallyFiniteType (isTopologicallyFiniteType_inl h)
  let J := Ideal.span ((fun s ↦ inr A B B s - inl A B B s) '' S)
  have hJ : J.closure = J := J.closure_eq_of_isClosed (IsNoetherianType.isClosed_ideal J)
  exact hJ.symm.trans (closure_span_inr_sub_inl_eq_ideal hS)

/-- **Generation of `Ωᶜ[B⁄A]` by a topological generating set** (Huber 1996, §1.6, (1.6.2)(ii)):
if `A` is a Huber ring, `B` is a complete Hausdorff Huber ring of noetherian type, `A → B` is
topologically of finite type, and `A[S]` is dense in `B`, then `Ωᶜ[B⁄A]` is generated as a
`B`-module by `d '' S`. -/
theorem span_D_eq_top (h : IsTopologicallyFiniteType (algebraMap A B)) {S : Set B}
    (hS : Dense (Algebra.adjoin A S : Set B)) :
    Submodule.span B (D A B '' S) = ⊤ :=
  span_D_eq_top_of_span_eq_ideal (span_inr_sub_inl_eq_ideal h hS)

/-- If `A` is a Huber ring, `B` is a complete Hausdorff Huber ring of noetherian type, and `A → B`
is topologically of finite type, then `Ωᶜ[B⁄A]` is generated as a `B`-module by the image of
`d : B → Ωᶜ[B⁄A]` (Huber 1996, §1.6, (1.6.2)(ii)). -/
theorem span_range_derivation (h : IsTopologicallyFiniteType (algebraMap A B)) :
    Submodule.span B (Set.range (D A B)) = ⊤ := by
  simpa [Set.image_univ] using span_D_eq_top h (S := Set.univ) (by simp [Algebra.adjoin_univ])

/-- If `A` is a Huber ring, `B` is a complete Hausdorff Huber ring of noetherian type, and `A → B`
is topologically of finite type, then the canonical comparison `Ω[B⁄A] →ₗ[B] Ωᶜ[B⁄A]` from
algebraic Kähler differentials is surjective (Huber 1996, §1.6, (1.6.2)(ii)). -/
theorem fromKaehler_surjective (h : IsTopologicallyFiniteType (algebraMap A B)) :
    Function.Surjective (fromKaehler A B) := by
  rw [← LinearMap.range_eq_top, eq_top_iff, ← span_range_derivation h, Submodule.span_le]
  rintro _ ⟨b, rfl⟩
  exact ⟨KaehlerDifferential.D A B b, fromKaehler_D A B b⟩

/-- **The completed diagonal ideal is finitely generated** when `A` is a Huber ring, `B` is a
complete Hausdorff Huber ring of noetherian type, and `A → B` is topologically of finite type
(Huber 1996, §1.6, (1.6.2)(ii)). -/
theorem ideal_fg (h : IsTopologicallyFiniteType (algebraMap A B)) :
    (ideal A B).FG := by
  classical
  obtain ⟨N, hN⟩ := h.exists_finset_dense_adjoin
  refine ⟨N.image (fun s ↦ inr A B B s - inl A B B s), ?_⟩
  simpa [Finset.coe_image] using span_inr_sub_inl_eq_ideal h hN

/-- **`Ωᶜ[B⁄A]` is a finitely generated `B`-module** when `A` is a Huber ring, `B` is a complete
Hausdorff Huber ring of noetherian type, and `A → B` is topologically of finite type
(Huber 1996, §1.6, (1.6.2)(ii)). -/
theorem finite (h : IsTopologicallyFiniteType (algebraMap A B)) :
    Module.Finite B (ContinuousKaehlerDifferential A B) := by
  classical
  obtain ⟨N, hN⟩ := h.exists_finset_dense_adjoin
  refine ⟨⟨N.image (D A B), ?_⟩⟩
  simpa [Finset.coe_image] using span_D_eq_top h hN

/-- **`Ωᶜ[B⁄A]` is naturally complete** as a `B`-module when `A` is a Huber ring, `B` is a
complete Hausdorff Huber ring of noetherian type, and `A → B` is topologically of finite type
(Huber 1996, §1.6, (1.6.2)(ii)). -/
theorem isNaturallyComplete (h : IsTopologicallyFiniteType (algebraMap A B)) :
    IsNaturallyComplete B (ContinuousKaehlerDifferential A B) := by
  have := finite h
  exact IsNoetherianType.isNaturallyComplete (A := B)

/-- **`Ωᶜ[B⁄A]` is Hausdorff** in its natural `B`-module topology when `A` is a Huber ring, `B` is
a complete Hausdorff Huber ring of noetherian type, and `A → B` is topologically of finite type
(Huber 1996, §1.6, (1.6.2)(ii)). -/
theorem t2Space (h : IsTopologicallyFiniteType (algebraMap A B)) :
    T2Space (ContinuousKaehlerDifferential A B) := by
  have := finite h
  exact IsNoetherianType.t2Space_of_isModuleTopology (A := B)

end FiniteType

section FiniteAlgebraNoetherianType

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
  [TopologicalSpace A] [IsTopologicalRing A]
  [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsHuberRing B]
  [CompleteSpace B] [T0Space B] [IsNoetherianType B] [IsAdicHom (algebraMap A B)]

/-- **Finite-algebra comparison** (Huber 1996, §1.6, (1.6.2)(iii)): if `B` is a module-finite
`A`-algebra carrying the `A`-module topology and `B` is a complete Hausdorff Huber ring of
noetherian type, then the canonical comparison `fromKaehler A B : Ω[B⁄A] →ₗ[B] Ωᶜ[B⁄A]` is
bijective. -/
theorem fromKaehler_bijective_of_finite [IsModuleTopology A B] [Module.Finite A B] :
    Function.Bijective (fromKaehler A B) :=
  fromKaehler_bijective_of_bijective_toCompletion
    (CompletedTensor.toCompletion_bijective_of_isNoetherianType A B B)

variable (A B) in
/-- **Finite-algebra comparison as a linear equivalence** (Huber 1996, §1.6, (1.6.2)(iii)): for a
module-finite `A`-algebra `B` carrying the `A`-module topology with `B` a complete Hausdorff Huber
ring of noetherian type, `Ω[B⁄A] ≃ₗ[B] Ωᶜ[B⁄A]` via `fromKaehler A B`. -/
noncomputable def fromKaehlerEquiv [IsModuleTopology A B] [Module.Finite A B] :
    Ω[B⁄A] ≃ₗ[B] ContinuousKaehlerDifferential A B :=
  LinearEquiv.ofBijective (fromKaehler A B) (fromKaehler_bijective_of_finite (A := A) (B := B))

/-- Applying `fromKaehlerEquiv` is the canonical comparison map `fromKaehler`. -/
@[simp]
theorem fromKaehlerEquiv_apply [IsModuleTopology A B] [Module.Finite A B] (ω : Ω[B⁄A]) :
    fromKaehlerEquiv A B ω = fromKaehler A B ω := (rfl)

/-- The inverse of `fromKaehlerEquiv` cancels `fromKaehler`. -/
@[simp]
theorem fromKaehlerEquiv_symm_fromKaehler [IsModuleTopology A B] [Module.Finite A B]
    (ω : Ω[B⁄A]) :
    (fromKaehlerEquiv A B).symm (fromKaehler A B ω) = ω :=
  (fromKaehlerEquiv A B).symm_apply_apply ω

/-- `fromKaehler` cancels the inverse of `fromKaehlerEquiv`. -/
@[simp]
theorem fromKaehler_fromKaehlerEquiv_symm [IsModuleTopology A B] [Module.Finite A B]
    (ω : ContinuousKaehlerDifferential A B) :
    fromKaehler A B ((fromKaehlerEquiv A B).symm ω) = ω :=
  (fromKaehlerEquiv A B).apply_symm_apply ω

/-- The inverse of `fromKaehlerEquiv` sends the continuous universal derivation to the algebraic
Kähler derivation. -/
@[simp]
theorem fromKaehlerEquiv_symm_D [IsModuleTopology A B] [Module.Finite A B] (b : B) :
    (fromKaehlerEquiv A B).symm (D A B b) = KaehlerDifferential.D A B b :=
  (fromKaehlerEquiv A B).injective (by simp)

end FiniteAlgebraNoetherianType

/-- Over a complete Tate ring `A`, if `B` is a module-finite complete Hausdorff Huber `A`-algebra
of noetherian type, then the canonical comparison `fromKaehler A B : Ω[B⁄A] →ₗ[B] Ωᶜ[B⁄A]` is
bijective (Huber 1996, §1.6, (1.6.2)(iii)). -/
theorem fromKaehler_bijective_of_finite_of_isTateRing {A B : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
    [CompleteSpace A]
    [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsHuberRing B]
    [CompleteSpace B] [T0Space B] [IsNoetherianType B] [IsAdicHom (algebraMap A B)]
    [Module.Finite A B] :
    Function.Bijective (fromKaehler A B) := by
  have : (𝓤 B).IsCountablyGenerated := IsUniformAddGroup.uniformity_countably_generated
  have : ContinuousSMul A B :=
    continuousSMul_of_algebraMap A B (IsAdicHom.continuous inferInstance)
  have : IsModuleTopology A B := IsTateRing.isModuleTopology (A := A) (M := B)
  exact fromKaehler_bijective_of_finite (A := A) (B := B)

end ContinuousKaehlerDifferential

end TauCeti.Huber
