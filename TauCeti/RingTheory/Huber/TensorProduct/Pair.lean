module

public import TauCeti.RingTheory.Huber.TensorProduct.Completion

/-!
# The completed tensor product of Huber pairs

Let `A → B` and `A → C` be adic homomorphisms of Huber rings, and let `(B, B⁺)` and `(C, C⁺)` be
Huber pairs. In `E = B ⊗[A] C` let `E⁺` be the integral closure of the image of `B⁺ ⊗ C⁺`, that
is, of the subring generated by the `b ⊗ 1` with `b ∈ B⁺` and the `1 ⊗ c` with `c ∈ C⁺`. For the
tensor topology `E⁺` is a ring of integral elements of `E`. The *completed tensor product*
`B ⊗̂_A C` is the complete Hausdorff Huber pair whose ring is the separated completion
`TauCeti.Huber.CompletedTensor A B C` of `E`, and whose ring of integral elements is the closure
of the image of `E⁺`.

The two coprojections are morphisms of Huber pairs, and the completed tensor product is the
pushout of Huber pairs over complete Hausdorff targets: compatible continuous homomorphisms
`B → R` and `C → R` carrying `B⁺` and `C⁺` into a closed integrally closed subring `R⁺` of a
complete Hausdorff nonarchimedean ring `R` extend uniquely to a continuous homomorphism
`B ⊗̂_A C → R`, and this extension carries the plus ring into `R⁺`. This is the affinoid
input for fibre products of adic spaces.

The plus ring uses the plus rings of `B` and `C` only; the plus ring of `A` plays no role, since
the image of `B⁺ ⊗[A⁺] C⁺` in `B ⊗[A] C` does not depend on it.

## Main definitions

* `TauCeti.Huber.Pair.tensorPlus A T U`: the integral closure `E⁺` in `B ⊗[A] C` of the image of
  `B⁺ ⊗ C⁺`.
* `TauCeti.Huber.Pair.completedTensor A T U`: the completed tensor product `B ⊗̂_A C` of the
  Huber pairs `T = (B, B⁺)` and `U = (C, C⁺)`.
* `TauCeti.Huber.Pair.completedTensor.inl`, `TauCeti.Huber.Pair.completedTensor.inr`: the
  coprojections, as morphisms of Huber pairs.
* `TauCeti.Huber.Pair.completedTensor.lift`: the morphism of Huber pairs out of `B ⊗̂_A C`
  induced by compatible morphisms into a complete Hausdorff Huber pair.

## Main results

* `TauCeti.Huber.Pair.isRingOfIntegralElements_tensorPlus`: `E⁺` is a ring of integral elements
  of `B ⊗[A] C` for the tensor topology.
* `TauCeti.Huber.Pair.completedTensor.inl_comp`: the two coprojections agree on `(A, A⁺)`.
* `TauCeti.Huber.Pair.completedTensor.lift_apply_mem` and
  `TauCeti.Huber.Pair.completedTensor.existsUnique_lift`: the universal property with plus rings.
* `TauCeti.Huber.Pair.completedTensor.hom_ext`: morphisms of Huber pairs out of `B ⊗̂_A C` are
  determined by their restrictions along the coprojections.

## References

* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217
  (1994), §3, proof of Lemma 3.9(i) and proof of Proposition 3.7.
* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.2, proof of Proposition 1.2.2(1).
* [Wedhorn, *Adic Spaces*][wedhorn_adic], Lemma 7.47 and proof of Theorem 8.56.
-/

public section

open TensorProduct Algebra.TensorProduct Topology

namespace TauCeti.Huber

variable (A : Type*) {B C : Type*} [CommRing A] [CommRing B] [CommRing C]
  [Algebra A B] [Algebra A C] [TopologicalSpace B] [TopologicalSpace C]
  [IsTopologicalRing B] [IsTopologicalRing C] [IsHuberRing B] [IsHuberRing C]

namespace Pair

/-- The integral closure `E⁺` in `E = B ⊗[A] C` of the image of `B⁺ ⊗ C⁺`, that is, of the
subring generated by the `b ⊗ 1` with `b ∈ B⁺` and the `1 ⊗ c` with `c ∈ C⁺`. For the tensor
topology it is a ring of integral elements
(`TauCeti.Huber.Pair.isRingOfIntegralElements_tensorPlus`), and the plus ring of the completed
tensor product is the closure of its image. -/
noncomputable def tensorPlus (T : Pair B) (U : Pair C) : Subring (B ⊗[A] C) :=
  (integralClosure (T.plus.map includeLeftRingHom ⊔
    U.plus.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C) : Subring (B ⊗[A] C))
    (B ⊗[A] C)).toSubring

variable {A}

/-- The defining equation of `tensorPlus`, whose body is not exposed. -/
theorem tensorPlus_def (T : Pair B) (U : Pair C) :
    tensorPlus A T U = (integralClosure (T.plus.map includeLeftRingHom ⊔
      U.plus.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C) : Subring (B ⊗[A] C))
      (B ⊗[A] C)).toSubring :=
  (rfl)

/-- Membership in the tensor plus ring is integrality over the subring generated by the
images of the two original plus rings. -/
@[simp]
theorem mem_tensorPlus_iff {T : Pair B} {U : Pair C} {x : B ⊗[A] C} :
    x ∈ tensorPlus A T U ↔
      IsIntegral (T.plus.map includeLeftRingHom ⊔
        U.plus.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C) :
          Subring (B ⊗[A] C)) x := by
  rw [tensorPlus_def, Subalgebra.mem_toSubring, mem_integralClosure_iff]

/-- The image of `B⁺ ⊗ C⁺` lies in `tensorPlus`. -/
theorem tmul_mem_tensorPlus {T : Pair B} {U : Pair C} {b : B} {c : C} (hb : b ∈ T.plus)
    (hc : c ∈ U.plus) : b ⊗ₜ[A] c ∈ tensorPlus A T U := by
  set P₀ : Subring (B ⊗[A] C) := T.plus.map includeLeftRingHom ⊔
    U.plus.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)
  have hbc : b ⊗ₜ[A] c ∈ P₀ := by
    simpa using P₀.mul_mem (le_sup_left (b := U.plus.map _) (Subring.mem_map.mpr ⟨b, hb, rfl⟩))
      (le_sup_right (a := T.plus.map _) (Subring.mem_map.mpr ⟨c, hc, rfl⟩))
  exact (integralClosure P₀ (B ⊗[A] C)).algebraMap_mem ⟨_, hbc⟩

variable [TopologicalSpace A] [IsTopologicalRing A]
  [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]

variable (A) in
/-- **`E⁺` is a ring of integral elements** of `B ⊗[A] C` for the tensor topology (Huber94, §3,
proof of Lemma 3.9(i)). -/
theorem isRingOfIntegralElements_tensorPlus (T : Pair B) (U : Pair C) :
    letI := tensorTopology A B C
    letI := isTopologicalRing_tensorTopology A B C
    letI := isHuberRing_tensorTopology A B C
    IsRingOfIntegralElements (tensorPlus A T U) := by
  let _ := tensorTopology A B C
  have _ := isTopologicalRing_tensorTopology A B C
  have _ := isHuberRing_tensorTopology A B C
  set P₀ : Subring (B ⊗[A] C) := T.plus.map includeLeftRingHom ⊔
    U.plus.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)
  apply isRingOfIntegralElements_integralClosure
  -- `P₀` is open since it contains the image of `(I B₀)ⁿ ⊗ (I C₀)ᵐ` for large `n` and `m`, and
  -- it consists of power-bounded elements since both inclusions are adic.
  · -- `P₀` contains a basic neighbourhood of zero of the tensor topology.
    obtain ⟨D⟩ := TensorDatum.nonempty A B C
    obtain ⟨n, -, hn⟩ := D.left.hasBasis_nhds_zero.mem_iff.mp
      (T.isRingOfIntegralElements.isOpen.mem_nhds T.plus.zero_mem)
    obtain ⟨m, -, hm⟩ := D.right.hasBasis_nhds_zero.mem_iff.mp
      (U.isRingOfIntegralElements.isOpen.mem_nhds U.plus.zero_mem)
    have hle := D.map_idealImage_le (RingHom.id _) P₀.toAddSubgroup n m fun b hb c hc ↦ by
      simpa using P₀.mul_mem
        (le_sup_left (b := U.plus.map _) (Subring.mem_map.mpr
          ⟨b, hn ((D.left.mem_idealImage n).mpr ⟨b, hb, rfl⟩), rfl⟩))
        (le_sup_right (a := T.plus.map _) (Subring.mem_map.mpr
          ⟨c, hm ((D.right.mem_idealImage m).mpr ⟨c, hc, rfl⟩), rfl⟩))
    have hopen := D.isOpen_idealImage (n + m)
    rw [← tensorTopology_eq A B C D] at hopen
    exact AddSubgroup.isOpen_mono (H₂ := P₀.toAddSubgroup) (fun x hx ↦ hle hx) hopen
  · refine sup_le (Subring.map_le_iff_le_comap.mpr fun b hb ↦ ?_)
      (Subring.map_le_iff_le_comap.mpr fun c hc ↦ ?_)
    · exact mem_powerBoundedSubring.mpr <|
        (isAdicHom_includeLeft_tensorTopology A B C).isPowerBounded_map
          (T.isRingOfIntegralElements.isPowerBounded_of_mem hb)
    · exact mem_powerBoundedSubring.mpr <|
        (isAdicHom_includeRight_tensorTopology A B C).isPowerBounded_map
          (U.isRingOfIntegralElements.isPowerBounded_of_mem hc)

variable (A) in
/-- **The completed tensor product `B ⊗̂_A C` of Huber pairs** along adic structure maps: the
separated completion of `B ⊗[A] C` for the tensor topology, with plus ring the closure of the
image of `tensorPlus A T U`, a ring of integral elements of the completion (Huber96, §1.2,
proof of Proposition 1.2.2(1); Wedhorn, Lemma 7.47). -/
noncomputable def completedTensor (T : Pair B) (U : Pair C) : Pair (CompletedTensor A B C) where
  plus := ((tensorPlus A T U).map (CompletedTensor.toCompletion A B C)).topologicalClosure
  isRingOfIntegralElements :=
    CompletedTensor.isRingOfIntegralElements_topologicalClosure_map A B C
      (isRingOfIntegralElements_tensorPlus A T U)

/-- The plus ring of `B ⊗̂_A C` is the closure of the image of `tensorPlus A T U`. -/
@[simp]
theorem completedTensor_plus (T : Pair B) (U : Pair C) :
    (completedTensor A T U).plus =
      ((tensorPlus A T U).map (CompletedTensor.toCompletion A B C)).topologicalClosure :=
  (rfl)

/-- The completion map carries `tensorPlus` into the plus ring of `B ⊗̂_A C`. -/
theorem toCompletion_mem_completedTensor_plus {T : Pair B} {U : Pair C} {x : B ⊗[A] C}
    (hx : x ∈ tensorPlus A T U) :
    CompletedTensor.toCompletion A B C x ∈ (completedTensor A T U).plus :=
  Subring.le_topologicalClosure _ (Subring.mem_map.mpr ⟨x, hx, rfl⟩)

namespace completedTensor

variable (A) (T : Pair B) (U : Pair C)

/-- The left coprojection `(B, B⁺) → B ⊗̂_A C`, `b ↦ b ⊗ 1`, as a morphism of Huber pairs. -/
noncomputable def inl : Hom T (completedTensor A T U) where
  toRingHom := CompletedTensor.inl A B C
  continuous_toRingHom := CompletedTensor.continuous_inl A B C
  map_mem_plus b hb := by
    simpa using
      toCompletion_mem_completedTensor_plus (tmul_mem_tensorPlus (A := A) hb U.plus.one_mem)

/-- The right coprojection `(C, C⁺) → B ⊗̂_A C`, `c ↦ 1 ⊗ c`, as a morphism of Huber pairs. -/
noncomputable def inr : Hom U (completedTensor A T U) where
  toRingHom := CompletedTensor.inr A B C
  continuous_toRingHom := CompletedTensor.continuous_inr A B C
  map_mem_plus c hc := by
    simpa using
      toCompletion_mem_completedTensor_plus (tmul_mem_tensorPlus (A := A) T.plus.one_mem hc)

/-- The underlying ring homomorphism of the left coprojection. -/
@[simp]
theorem toRingHom_inl : (inl A T U).toRingHom = CompletedTensor.inl A B C := (rfl)

/-- The underlying ring homomorphism of the right coprojection. -/
@[simp]
theorem toRingHom_inr : (inr A T U).toRingHom = CompletedTensor.inr A B C := (rfl)

variable {A T U}

/-- The two coprojections agree on `(A, A⁺)`: for the structure maps `f : (A, A⁺) → (B, B⁺)`
and `g : (A, A⁺) → (C, C⁺)`, `inl ∘ f = inr ∘ g` as morphisms of Huber pairs. -/
theorem inl_comp [IsHuberRing A] {S : Pair A} (f : Hom S T) (g : Hom S U)
    (hf : f.toRingHom = algebraMap A B) (hg : g.toRingHom = algebraMap A C) :
    (inl A T U).comp f = (inr A T U).comp g := by
  ext1
  simp [hf, hg]

section Lift

variable {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [NonarchimedeanRing R]
  [CompleteSpace R] [T0Space R] {Rplus : Subring R}

/-- **The extension of compatible maps carries the plus ring into `R⁺`**: if `R⁺` is a closed
subring of `R` integrally closed in `R`, and `φ : B → R`, `ψ : C → R` carry `B⁺` and `C⁺` into
`R⁺`, then their extension `B ⊗̂_A C → R` carries the plus ring of `B ⊗̂_A C` into `R⁺`. -/
theorem lift_apply_mem (hclosed : IsClosed (Rplus : Set R))
    (hint : IsIntegrallyClosedIn Rplus R) (φ : B →+* R) (ψ : C →+* R)
    (h : φ.comp (algebraMap A B) = ψ.comp (algebraMap A C))
    (hφ : Continuous φ) (hψ : Continuous ψ) (hφp : ∀ b ∈ T.plus, φ b ∈ Rplus)
    (hψp : ∀ c ∈ U.plus, ψ c ∈ Rplus) {x : CompletedTensor A B C}
    (hx : x ∈ (completedTensor A T U).plus) :
    CompletedTensor.lift φ ψ h hφ hψ x ∈ Rplus := by
  set L := CompletedTensor.lift φ ψ h hφ hψ
  set g := L.comp (CompletedTensor.toCompletion A B C)
  set P₀ : Subring (B ⊗[A] C) := T.plus.map includeLeftRingHom ⊔
    U.plus.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)
  -- `g` carries the image of `B⁺ ⊗ C⁺` into `R⁺`, hence also its integral closure.
  have h₀ : P₀ ≤ Rplus.comap g := by
    refine sup_le (Subring.map_le_iff_le_comap.mpr fun b hb ↦ ?_)
      (Subring.map_le_iff_le_comap.mpr fun c hc ↦ ?_)
    · simpa [g, L] using hφp b hb
    · simpa [g, L] using hψp c hc
  have h₁ : tensorPlus A T U ≤ Rplus.comap g := by
    intro y hy
    have hy := mem_tensorPlus_iff.mp hy
    let g₀ : P₀ →+* Rplus := (g.comp P₀.subtype).codRestrict Rplus fun z ↦ h₀ z.2
    exact Subring.isIntegrallyClosedIn_iff.mp hint (hy.map_of_comp_eq g₀ g (by ext; rfl))
  -- The preimage of `R⁺` under the continuous extension is closed.
  have hcl : IsClosed
      ((Rplus.comap L : Subring (CompletedTensor A B C)) : Set (CompletedTensor A B C)) :=
    hclosed.preimage (CompletedTensor.continuous_lift φ ψ h hφ hψ)
  rw [completedTensor_plus] at hx
  have h₂ : (tensorPlus A T U).map (CompletedTensor.toCompletion A B C) ≤ Rplus.comap L :=
    Subring.map_le_iff_le_comap.mpr fun y hy ↦ h₁ hy
  exact Subring.topologicalClosure_minimal _ h₂ hcl hx

/-- **Universal property of the completed tensor product of Huber pairs** (Huber94, §3, proof of
Proposition 3.7; Wedhorn, proof of Theorem 8.56): for a closed subring `R⁺` of `R` integrally
closed in `R`, and compatible continuous homomorphisms `φ : B → R`, `ψ : C → R` carrying `B⁺` and
`C⁺` into `R⁺`, there is exactly one continuous homomorphism `B ⊗̂_A C → R` carrying the plus ring
into `R⁺` and restricting to `φ` and `ψ` along the coprojections. -/
theorem existsUnique_lift (hclosed : IsClosed (Rplus : Set R))
    (hint : IsIntegrallyClosedIn Rplus R) (φ : B →+* R) (ψ : C →+* R)
    (h : φ.comp (algebraMap A B) = ψ.comp (algebraMap A C))
    (hφ : Continuous φ) (hψ : Continuous ψ) (hφp : ∀ b ∈ T.plus, φ b ∈ Rplus)
    (hψp : ∀ c ∈ U.plus, ψ c ∈ Rplus) :
    ∃! χ : CompletedTensor A B C →+* R, Continuous χ ∧
      (∀ x ∈ (completedTensor A T U).plus, χ x ∈ Rplus) ∧
        χ.comp (CompletedTensor.inl A B C) = φ ∧ χ.comp (CompletedTensor.inr A B C) = ψ := by
  refine ⟨CompletedTensor.lift φ ψ h hφ hψ, ⟨CompletedTensor.continuous_lift φ ψ h hφ hψ,
    fun x hx ↦ lift_apply_mem hclosed hint φ ψ h hφ hψ hφp hψp hx, by simp, by simp⟩, ?_⟩
  rintro χ ⟨hχ, -, hχB, hχC⟩
  exact CompletedTensor.hom_ext hχ (CompletedTensor.continuous_lift φ ψ h hφ hψ)
    (by simpa using hχB) (by simpa using hχC)

end Lift

section HuberPair

variable {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsHuberRing R] [CompleteSpace R] [T0Space R] {V : Pair R}

/-- **The morphism of Huber pairs `B ⊗̂_A C → (R, R⁺)` induced by compatible morphisms** from
`(B, B⁺)` and `(C, C⁺)` into a complete Hausdorff Huber pair. -/
noncomputable def lift (φ : Hom T V) (ψ : Hom U V)
    (h : φ.toRingHom.comp (algebraMap A B) = ψ.toRingHom.comp (algebraMap A C)) :
    Hom (completedTensor A T U) V where
  toRingHom := CompletedTensor.lift φ.toRingHom ψ.toRingHom h φ.continuous_toRingHom
    ψ.continuous_toRingHom
  continuous_toRingHom := CompletedTensor.continuous_lift _ _ _ _ _
  map_mem_plus _ hx :=
    lift_apply_mem (V.plus.toAddSubgroup.isClosed_of_isOpen V.isRingOfIntegralElements.isOpen)
      V.isRingOfIntegralElements.isIntegrallyClosedIn _ _ h _ _ φ.map_mem_plus ψ.map_mem_plus hx

/-- The underlying ring homomorphism of `lift` is the continuous extension of the two maps. -/
@[simp]
theorem toRingHom_lift (φ : Hom T V) (ψ : Hom U V)
    (h : φ.toRingHom.comp (algebraMap A B) = ψ.toRingHom.comp (algebraMap A C)) :
    (lift φ ψ h).toRingHom = CompletedTensor.lift φ.toRingHom ψ.toRingHom h
      φ.continuous_toRingHom ψ.continuous_toRingHom :=
  (rfl)

/-- `lift` restricts to the prescribed morphism along the left coprojection. -/
@[simp]
theorem lift_comp_inl (φ : Hom T V) (ψ : Hom U V)
    (h : φ.toRingHom.comp (algebraMap A B) = ψ.toRingHom.comp (algebraMap A C)) :
    (lift φ ψ h).comp (inl A T U) = φ := by
  ext1
  simp

/-- `lift` restricts to the prescribed morphism along the right coprojection. -/
@[simp]
theorem lift_comp_inr (φ : Hom T V) (ψ : Hom U V)
    (h : φ.toRingHom.comp (algebraMap A B) = ψ.toRingHom.comp (algebraMap A C)) :
    (lift φ ψ h).comp (inr A T U) = ψ := by
  ext1
  simp

end HuberPair

/-- Morphisms of Huber pairs out of `B ⊗̂_A C` into a Hausdorff Huber pair are determined by their
restrictions along the two coprojections. -/
theorem hom_ext {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    [IsHuberRing R] [T2Space R] {V : Pair R} {χ χ' : Hom (completedTensor A T U) V}
    (hB : χ.comp (inl A T U) = χ'.comp (inl A T U))
    (hC : χ.comp (inr A T U) = χ'.comp (inr A T U)) : χ = χ' :=
  Hom.ext <| CompletedTensor.hom_ext χ.continuous_toRingHom χ'.continuous_toRingHom
    (by simpa using congrArg Hom.toRingHom hB) (by simpa using congrArg Hom.toRingHom hC)

end completedTensor

end Pair

end TauCeti.Huber
