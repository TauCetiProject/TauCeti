module

public import TauCeti.RingTheory.Huber.TensorProduct.Completion
import TauCeti.RingTheory.IntegralClosure.IntegrallyClosed

/-!
# The completed tensor product of Huber pairs

Let `A → B` and `A → C` be adic homomorphisms of Huber rings and let `(B, B⁺)` and `(C, C⁺)` be
Huber pairs. Huber's completed tensor product `(B, B⁺) ⊗̂_A (C, C⁺)` is the Huber pair whose
ring is the separated completed tensor ring `TauCeti.Huber.CompletedTensor A B C` and whose
ring of integral elements is the closure of the image of the integral closure, in `B ⊗[A] C`,
of the subring generated by `B⁺ ⊗ 1` and `1 ⊗ C⁺`.

The image itself is in general not integrally closed, so the integral closure cannot be
omitted: for a ramified quadratic extension `L` of `ℚ_p`, the idempotent `(1, 0)` of
`L ⊗_{ℚ_p} L ≅ L × L` is integral over the image of `O_L ⊗ O_L` but does not lie in it.

The plus ring is a ring of integral elements because the subring generated by `B⁺ ⊗ 1` and
`1 ⊗ C⁺` contains the image of a power of the ideal of definition of the tensor topology and
consists of power-bounded elements, and because completion preserves rings of integral
elements. The pair carries the two coprojections as morphisms of Huber pairs and represents
compatible pairs of morphisms into complete Hausdorff Huber pairs.

## Main definitions

* `TauCeti.Huber.Pair.completedTensor A S T`: the completed tensor product of the Huber pairs
  `S` on `B` and `T` on `C` over `A`.
* `TauCeti.Huber.Pair.completedTensor.inl`, `TauCeti.Huber.Pair.completedTensor.inr`: the
  coprojections as morphisms of Huber pairs.
* `TauCeti.Huber.Pair.completedTensor.lift`: the morphism of Huber pairs induced by compatible
  morphisms into a complete Hausdorff Huber pair.

## Main results

* `TauCeti.Huber.Pair.completedTensor.plus_eq`: the plus ring is the closure of the image of the
  integral closure of the subring generated by `B⁺ ⊗ 1` and `1 ⊗ C⁺`.
* `TauCeti.Huber.Pair.completedTensor_plus_le_comap`: a continuous ring map out of the completed
  tensor ring which carries both `B⁺` and `C⁺` into a closed integrally closed subring carries
  the whole plus ring into it.
* `TauCeti.Huber.Pair.completedTensor.existsUnique_lift`: the universal property of the completed
  tensor product of Huber pairs, for complete Hausdorff nonarchimedean targets with a closed
  integrally closed subring.

## References

* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217
  (1994), §3, proof of Lemma 3.9(i) and proof of Proposition 3.7.
* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.2, proof of Proposition 1.2.2(1).
* S. Morel, *Adic spaces*, §II.3.2, Proposition II.3.2.1.
* [Wedhorn, *Adic Spaces*][wedhorn_adic], Lemma 7.47 (completion preserves rings of integral
  elements).
-/

public section

open TensorProduct Algebra.TensorProduct

namespace TauCeti.Huber

variable (A : Type*) {B C : Type*} [CommRing A] [CommRing B] [CommRing C]
  [Algebra A B] [Algebra A C]
  [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]
  [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]
  [IsHuberRing B] [IsHuberRing C]
  [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]

namespace Pair

/-- The subring of `B ⊗[A] C` generated by `B⁺ ⊗ 1` and `1 ⊗ C⁺`. -/
private def plusTensor (S : Pair B) (T : Pair C) : Subring (B ⊗[A] C) :=
  S.plus.map includeLeftRingHom ⊔ T.plus.map (includeRight : C →ₐ[A] B ⊗[A] C).toRingHom

variable {A} (S : Pair B) (T : Pair C)

omit [TopologicalSpace A] [IsTopologicalRing A] [IsAdicHom (algebraMap A B)]
  [IsAdicHom (algebraMap A C)] in
private theorem tmul_mem_plusTensor {b : B} {c : C} (hb : b ∈ S.plus) (hc : c ∈ T.plus) :
    b ⊗ₜ[A] c ∈ plusTensor A S T := by
  have h : b ⊗ₜ[A] c =
      includeLeftRingHom b * (includeRight : C →ₐ[A] B ⊗[A] C).toRingHom c := by
    simp
  rw [h]
  exact mul_mem ((le_sup_left : S.plus.map _ ≤ plusTensor A S T) ⟨b, hb, rfl⟩)
    ((le_sup_right : T.plus.map _ ≤ plusTensor A S T) ⟨c, hc, rfl⟩)

/-- The subring generated by `B⁺ ⊗ 1` and `1 ⊗ C⁺` is open for the tensor topology: it contains
the image of a power of the ideal of definition of any tensor datum. -/
private theorem isOpen_plusTensor :
    @IsOpen (B ⊗[A] C) (tensorTopology A B C) (plusTensor A S T : Set (B ⊗[A] C)) := by
  obtain ⟨D⟩ := TensorDatum.nonempty A B C
  rw [tensorTopology_eq A B C D]
  let _ := D.topology
  have _ := D.isTopologicalRing
  obtain ⟨n, -, hn⟩ := D.left.hasBasis_nhds_zero.mem_iff.mp
    (S.isRingOfIntegralElements.isOpen.mem_nhds S.plus.zero_mem)
  obtain ⟨m, -, hm⟩ := D.right.hasBasis_nhds_zero.mem_iff.mp
    (T.isRingOfIntegralElements.isOpen.mem_nhds T.plus.zero_mem)
  have hle : D.idealImage (n + m) ≤ (plusTensor A S T).toAddSubgroup := by
    intro x hx
    suffices h : x ∈ (plusTensor A S T).toAddSubgroup.comap (RingHom.id _).toAddMonoidHom by
      simpa using h
    exact D.map_idealImage_le (RingHom.id _) _ n m (fun b hb c hc ↦ S.tmul_mem_plusTensor T
      (hn ((D.left.mem_idealImage n).mpr ⟨b, hb, rfl⟩))
      (hm ((D.right.mem_idealImage m).mpr ⟨c, hc, rfl⟩))) hx
  exact AddSubgroup.isOpen_mono hle (D.isOpen_idealImage _)

/-- The subring generated by `B⁺ ⊗ 1` and `1 ⊗ C⁺` consists of power-bounded elements for the
tensor topology, since both coprojections are adic. -/
private theorem plusTensor_le_powerBoundedSubring :
    letI := tensorTopology A B C
    haveI := isTopologicalRing_tensorTopology A B C
    haveI := isHuberRing_tensorTopology A B C
    plusTensor A S T ≤ powerBoundedSubring (B ⊗[A] C) := by
  let _ := tensorTopology A B C
  have _ := isTopologicalRing_tensorTopology A B C
  have _ := isHuberRing_tensorTopology A B C
  refine sup_le (Subring.map_le_iff_le_comap.mpr fun b hb ↦ ?_)
    (Subring.map_le_iff_le_comap.mpr fun c hc ↦ ?_)
  · exact mem_powerBoundedSubring.mpr <| (isAdicHom_includeLeft_tensorTopology A B C)
      |>.isPowerBounded_map (S.isRingOfIntegralElements.isPowerBounded_of_mem hb)
  · exact mem_powerBoundedSubring.mpr <| (isAdicHom_includeRight_tensorTopology A B C)
      |>.isPowerBounded_map (T.isRingOfIntegralElements.isPowerBounded_of_mem hc)

/-- The closure of the image of the integral closure of the subring generated by `B⁺ ⊗ 1` and
`1 ⊗ C⁺` is a ring of integral elements of the completed tensor ring. -/
private theorem isRingOfIntegralElements_completedTensorPlus :
    IsRingOfIntegralElements
      (((integralClosure (plusTensor A S T) (B ⊗[A] C)).toSubring.map
        (CompletedTensor.toCompletion A B C)).topologicalClosure) :=
  CompletedTensor.isRingOfIntegralElements_topologicalClosure_map_toCompletion A B C <| by
    let _ := tensorTopology A B C
    have _ := isTopologicalRing_tensorTopology A B C
    have _ := isHuberRing_tensorTopology A B C
    exact isRingOfIntegralElements_integralClosure (isOpen_plusTensor S T)
      (plusTensor_le_powerBoundedSubring S T)

variable (A) in
/-- **The completed tensor product `(B, B⁺) ⊗̂_A (C, C⁺)` of Huber pairs** along adic structure
maps. Its ring is the separated completed tensor ring `CompletedTensor A B C`, and its plus ring
is the closure of the image of the integral closure of the subring of `B ⊗[A] C` generated by
`B⁺ ⊗ 1` and `1 ⊗ C⁺` (`TauCeti.Huber.Pair.completedTensor.plus_eq`). -/
noncomputable def completedTensor : Pair (CompletedTensor A B C) where
  plus := ((integralClosure (plusTensor A S T) (B ⊗[A] C)).toSubring.map
    (CompletedTensor.toCompletion A B C)).topologicalClosure
  isRingOfIntegralElements := isRingOfIntegralElements_completedTensorPlus S T

/-- The plus ring of the completed tensor product is the closure of the image of the integral
closure, in `B ⊗[A] C`, of the subring generated by `B⁺ ⊗ 1` and `1 ⊗ C⁺`. -/
theorem completedTensor.plus_eq :
    (S.completedTensor A T).plus =
      ((integralClosure
        (S.plus.map includeLeftRingHom ⊔
          T.plus.map (includeRight : C →ₐ[A] B ⊗[A] C).toRingHom : Subring (B ⊗[A] C))
        (B ⊗[A] C)).toSubring.map (CompletedTensor.toCompletion A B C)).topologicalClosure :=
  (rfl)

/-- The completion of an element integral over the subring generated by `B⁺ ⊗ 1` and `1 ⊗ C⁺`
lies in the plus ring of the completed tensor product. -/
theorem toCompletion_mem_completedTensor_plus {x : B ⊗[A] C}
    (hx : IsIntegral (S.plus.map includeLeftRingHom ⊔
      T.plus.map (includeRight : C →ₐ[A] B ⊗[A] C).toRingHom : Subring (B ⊗[A] C)) x) :
    CompletedTensor.toCompletion A B C x ∈ (S.completedTensor A T).plus :=
  Subring.le_topologicalClosure _ ⟨x, (mem_integralClosure_iff _ _).mpr hx, rfl⟩

/-- The completion of `b ⊗ c` lies in the plus ring when `b ∈ B⁺` and `c ∈ C⁺`. -/
theorem toCompletion_tmul_mem_completedTensor_plus {b : B} {c : C} (hb : b ∈ S.plus)
    (hc : c ∈ T.plus) :
    CompletedTensor.toCompletion A B C (b ⊗ₜ[A] c) ∈ (S.completedTensor A T).plus :=
  S.toCompletion_mem_completedTensor_plus T
    (isIntegral_algebraMap (x := (⟨_, S.tmul_mem_plusTensor T hb hc⟩ : plusTensor A S T)))

/-- The left coprojection carries `B⁺` into the plus ring of the completed tensor product. -/
theorem inl_mem_completedTensor_plus {b : B} (hb : b ∈ S.plus) :
    CompletedTensor.inl A B C b ∈ (S.completedTensor A T).plus := by
  simpa using S.toCompletion_tmul_mem_completedTensor_plus (A := A) T hb T.plus.one_mem

/-- The right coprojection carries `C⁺` into the plus ring of the completed tensor product. -/
theorem inr_mem_completedTensor_plus {c : C} (hc : c ∈ T.plus) :
    CompletedTensor.inr A B C c ∈ (S.completedTensor A T).plus := by
  simpa using S.toCompletion_tmul_mem_completedTensor_plus (A := A) T S.plus.one_mem hc

/-- **Rings of integral elements of targets bound the image of the plus ring.** A continuous ring
homomorphism out of the completed tensor ring which carries `B⁺` and `C⁺` into a closed subring
`R⁺` integrally closed in the target carries the whole plus ring into `R⁺`. -/
theorem completedTensor_plus_le_comap {R : Type*} [CommRing R] [TopologicalSpace R]
    {Rplus : Subring R} (hclosed : IsClosed (Rplus : Set R)) [IsIntegrallyClosedIn Rplus R]
    {f : CompletedTensor A B C →+* R} (hf : Continuous f)
    (hB : ∀ b ∈ S.plus, f (CompletedTensor.inl A B C b) ∈ Rplus)
    (hC : ∀ c ∈ T.plus, f (CompletedTensor.inr A B C c) ∈ Rplus) :
    (S.completedTensor A T).plus ≤ Rplus.comap f := by
  -- `f ∘ toCompletion` carries the generating subring into `R⁺`, hence its integral closure too.
  let g := f.comp (CompletedTensor.toCompletion A B C)
  have hle : plusTensor A S T ≤ Rplus.comap g := sup_le
    (Subring.map_le_iff_le_comap.mpr fun b hb ↦ by simpa [g] using hB b hb)
    (Subring.map_le_iff_le_comap.mpr fun c hc ↦ by simpa [g] using hC c hc)
  exact Subring.topologicalClosure_minimal _
    (Subring.map_le_iff_le_comap.mpr (Subring.integralClosure_subring_le_iff.mpr hle))
    (hclosed.preimage hf)

namespace completedTensor

variable (A) in
/-- The left coprojection `(B, B⁺) → (B, B⁺) ⊗̂_A (C, C⁺)` as a morphism of Huber pairs. -/
noncomputable def inl : Hom S (S.completedTensor A T) where
  toRingHom := CompletedTensor.inl A B C
  continuous_toRingHom := CompletedTensor.continuous_inl A B C
  map_mem_plus _ hb := S.inl_mem_completedTensor_plus T hb

variable (A) in
/-- The right coprojection `(C, C⁺) → (B, B⁺) ⊗̂_A (C, C⁺)` as a morphism of Huber pairs. -/
noncomputable def inr : Hom T (S.completedTensor A T) where
  toRingHom := CompletedTensor.inr A B C
  continuous_toRingHom := CompletedTensor.continuous_inr A B C
  map_mem_plus _ hc := S.inr_mem_completedTensor_plus T hc

/-- The underlying ring homomorphism of the left coprojection. -/
@[simp]
theorem toRingHom_inl : (inl A S T).toRingHom = CompletedTensor.inl A B C := (rfl)

/-- The underlying ring homomorphism of the right coprojection. -/
@[simp]
theorem toRingHom_inr : (inr A S T).toRingHom = CompletedTensor.inr A B C := (rfl)

variable {S T} in
/-- The two coprojections agree on a Huber pair of the base whose morphisms into `(B, B⁺)` and
`(C, C⁺)` are the structure maps. -/
theorem inl_comp [IsHuberRing A] {P : Pair A} {f : Hom P S} {g : Hom P T}
    (hf : f.toRingHom = algebraMap A B) (hg : g.toRingHom = algebraMap A C) :
    (inl A S T).comp f = (inr A S T).comp g := by
  ext1
  simp [hf, hg]

variable {S T} in
/-- Morphisms out of the completed tensor product into a Hausdorff Huber pair are determined by
their composites with the two coprojections. -/
theorem hom_ext {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [T2Space R]
    [IsHuberRing R] {U : Pair R} {f g : Hom (S.completedTensor A T) U}
    (hB : f.comp (inl A S T) = g.comp (inl A S T))
    (hC : f.comp (inr A S T) = g.comp (inr A S T)) : f = g :=
  Hom.ext <| CompletedTensor.hom_ext f.continuous_toRingHom g.continuous_toRingHom
    (by simpa using congrArg Hom.toRingHom hB) (by simpa using congrArg Hom.toRingHom hC)

section Lift

variable {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [CompleteSpace R]
  [T0Space R]

/-- **The universal property of the completed tensor product of Huber pairs.** Let `R` be a
complete Hausdorff nonarchimedean ring and `R⁺` a closed subring integrally closed in `R`. Two
continuous ring homomorphisms `φ : B → R` and `ψ : C → R`, agreeing on `A` and carrying `B⁺` and
`C⁺` into `R⁺`, extend uniquely to a continuous ring homomorphism out of the completed tensor
ring which carries its plus ring into `R⁺`. -/
theorem existsUnique_lift [NonarchimedeanRing R] {Rplus : Subring R}
    (hclosed : IsClosed (Rplus : Set R)) [IsIntegrallyClosedIn Rplus R] (φ : B →+* R)
    (ψ : C →+* R) (h : φ.comp (algebraMap A B) = ψ.comp (algebraMap A C))
    (hφ : Continuous φ) (hψ : Continuous ψ) (hφ' : ∀ b ∈ S.plus, φ b ∈ Rplus)
    (hψ' : ∀ c ∈ T.plus, ψ c ∈ Rplus) :
    ∃! χ : CompletedTensor A B C →+* R, Continuous χ ∧
      (S.completedTensor A T).plus ≤ Rplus.comap χ ∧
      χ.comp (CompletedTensor.inl A B C) = φ ∧ χ.comp (CompletedTensor.inr A B C) = ψ := by
  refine ⟨CompletedTensor.lift φ ψ h hφ hψ, ⟨CompletedTensor.continuous_lift φ ψ h hφ hψ,
    S.completedTensor_plus_le_comap T hclosed (CompletedTensor.continuous_lift φ ψ h hφ hψ)
      (by simpa using hφ') (by simpa using hψ'), by simp, by simp⟩, ?_⟩
  rintro χ ⟨hχ, -, hχB, hχC⟩
  exact CompletedTensor.hom_ext hχ (CompletedTensor.continuous_lift φ ψ h hφ hψ)
    (by simpa using hχB) (by simpa using hχC)

variable [IsTopologicalRing R] [IsHuberRing R] {S T} {U : Pair R}

/-- The morphism of Huber pairs `(B, B⁺) ⊗̂_A (C, C⁺) → (R, R⁺)` induced by morphisms
`(B, B⁺) → (R, R⁺)` and `(C, C⁺) → (R, R⁺)` agreeing on `A`, for a complete Hausdorff target. -/
noncomputable def lift (φ : Hom S U) (ψ : Hom T U)
    (h : φ.toRingHom.comp (algebraMap A B) = ψ.toRingHom.comp (algebraMap A C)) :
    Hom (S.completedTensor A T) U where
  toRingHom := CompletedTensor.lift φ.toRingHom ψ.toRingHom h φ.continuous_toRingHom
    ψ.continuous_toRingHom
  continuous_toRingHom := CompletedTensor.continuous_lift _ _ _ _ _
  map_mem_plus := by
    have := U.isRingOfIntegralElements.isIntegrallyClosedIn
    exact S.completedTensor_plus_le_comap T
      (U.plus.toAddSubgroup.isClosed_of_isOpen U.isRingOfIntegralElements.isOpen)
      (CompletedTensor.continuous_lift _ _ _ _ _) (by simpa using φ.map_mem_plus)
      (by simpa using ψ.map_mem_plus)

/-- The underlying ring homomorphism of the induced morphism is the continuous extension of the
two given ring homomorphisms. -/
@[simp]
theorem toRingHom_lift (φ : Hom S U) (ψ : Hom T U)
    (h : φ.toRingHom.comp (algebraMap A B) = ψ.toRingHom.comp (algebraMap A C)) :
    (lift φ ψ h).toRingHom = CompletedTensor.lift φ.toRingHom ψ.toRingHom h
      φ.continuous_toRingHom ψ.continuous_toRingHom :=
  (rfl)

/-- The induced morphism restricts to the given morphism on the left factor. -/
@[simp]
theorem lift_comp_inl (φ : Hom S U) (ψ : Hom T U)
    (h : φ.toRingHom.comp (algebraMap A B) = ψ.toRingHom.comp (algebraMap A C)) :
    (lift φ ψ h).comp (inl A S T) = φ := by
  ext1
  simp

/-- The induced morphism restricts to the given morphism on the right factor. -/
@[simp]
theorem lift_comp_inr (φ : Hom S U) (ψ : Hom T U)
    (h : φ.toRingHom.comp (algebraMap A B) = ψ.toRingHom.comp (algebraMap A C)) :
    (lift φ ψ h).comp (inr A S T) = ψ := by
  ext1
  simp

end Lift

end completedTensor

end Pair

end TauCeti.Huber
