/-!
# Completed tensor products of adic rings

Let `A → B` and `A → C` be adic homomorphisms of Huber rings, and suppose that the topologies of
`B` and `C` are the `I`-adic and `J`-adic topologies for ideals `I ⊆ B` and `J ⊆ C`. Write
`K = I (B ⊗[A] C) + J (B ⊗[A] C)` for the ideal of `B ⊗[A] C` generated by the images of `I` and
`J`. Then the tensor topology on `B ⊗[A] C` is the `K`-adic topology. Consequently, when `I` and
`J` are finitely generated, Huber's completed tensor product `B ⊗̂_A C` is the algebraic adic
completion `AdicCompletion K (B ⊗[A] C)`: the extension of the canonical map is a ring
isomorphism, and a homeomorphism for the adic topology of the extended ideal. This is the
comparison between the completed tensor product of Huber rings and the completed tensor product
of adic rings used in formal geometry.

The key point is that `B` and `C` are bounded in themselves, being adic, and adic homomorphisms
preserve bounded sets. So the images of `B` and `C` in `B ⊗[A] C` are bounded, and the ideal
generated by a small image of `I` or `J` is small: its elements are sums of products of a small
element of the image of `B` with an element of the image of `C`, or conversely. Conversely the
powers of `K` contain the images of powers of `I`, which are open because `B → B ⊗[A] C` is adic.

No completeness of `A`, `B` or `C` is assumed, and `A` need not be adic. The plus rings play no
role here: for Huber pairs whose plus rings are the whole rings, the plus ring of the completed
tensor product is again the whole ring (`TauCeti.Huber.Pair.completedTensor.plus_eq_top`).

## Main results

* `TauCeti.Huber.isAdic_tensorTopology`: the tensor topology is the `K`-adic topology.
* `TauCeti.Huber.CompletedTensor.isAdic_map_toCompletion`: the topology of `B ⊗̂_A C` is the adic
  topology of the extension of `K`.
* `TauCeti.Huber.CompletedTensor.equivAdicCompletion`: the ring isomorphism
  `B ⊗̂_A C ≃+* AdicCompletion K (B ⊗[A] C)`, with
  `TauCeti.Huber.CompletedTensor.equivAdicCompletion_toCompletion` and
  `TauCeti.Huber.CompletedTensor.isHomeomorph_equivAdicCompletion`.

## References

* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.2, proof of Proposition 1.2.2(1).
* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217
  (1994), §3, proof of Lemma 3.9(i).
* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique I*, Ch. 0, §7.7.
-/

public section

open TensorProduct Algebra.TensorProduct UniformSpace Topology

namespace TauCeti.Huber

variable (A : Type*) {B C : Type*} [CommRing A] [CommRing B] [CommRing C]
  [Algebra A B] [Algebra A C]
  [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]
  [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]
  [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  {I : Ideal B} {J : Ideal C}

/-- The tensor topology, registered locally on the algebraic tensor product. -/
noncomputable local instance adicTensorTopology : TopologicalSpace (B ⊗[A] C) :=
  tensorTopology A B C

local instance adicTensorTopologicalRing : IsTopologicalRing (B ⊗[A] C) :=
  isTopologicalRing_tensorTopology A B C

local instance adicTensorHuberRing : IsHuberRing (B ⊗[A] C) :=
  isHuberRing_tensorTopology A B C

/-- The additive group uniformity of the tensor topology. -/
noncomputable local instance adicTensorUniformity : UniformSpace (B ⊗[A] C) :=
  IsTopologicalAddGroup.rightUniformSpace _

local instance adicTensorUniformAddGroup : IsUniformAddGroup (B ⊗[A] C) :=
  isUniformAddGroup_of_addCommGroup

/-- An ideal lies in an additive subgroup `U` as soon as every multiple of each of its generators
lies in `U`. -/
private theorem coe_span_subset_of_forall_mul_mem {E : Type*} [CommRing E] {X : Set E}
    {U : AddSubgroup E} (h : ∀ x ∈ X, ∀ e : E, e * x ∈ U) :
    ((Ideal.span X : Ideal E) : Set E) ⊆ U := by
  intro y hy
  have hy' : y ∈ (Submodule.span E X).toAddSubmonoid := hy
  rw [Submodule.span_eq_closure] at hy'
  refine (AddSubmonoid.closure_le (S := U.toAddSubmonoid)).mpr ?_ hy'
  rintro _ ⟨e, -, x, hx, rfl⟩
  exact h x hx e

/-- The tensor topology of `I`-adic and `J`-adic rings, stated for the local instance. -/
private theorem isAdic_tensorTopology_aux (hI : IsAdic I) (hJ : IsAdic J) :
    IsAdic (I.map includeLeftRingHom ⊔
      J.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)) := by
  have := hI.isLinearTopology
  have := hJ.isLinearTopology
  let inl : B →+* B ⊗[A] C := includeLeftRingHom
  let inr : C →+* B ⊗[A] C := ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)
  have hl : IsAdicHom inl := isAdicHom_includeLeft_tensorTopology A B C
  have hr : IsAdicHom inr := isAdicHom_includeRight_tensorTopology A B C
  rw [isAdic_iff]
  refine ⟨fun n ↦ ?_, fun s hs ↦ ?_⟩
  · -- The `n`-th power contains the image of `Iⁿ`, which is open since `inl` is adic.
    refine AddSubgroup.isOpen_mono (H₁ := ((I ^ n).map inl).toAddSubgroup)
      (H₂ := ((I.map inl ⊔ J.map inr) ^ n).toAddSubgroup) ?_ (hl.isOpen_map (hI.isOpen_pow n))
    rw [Ideal.map_pow]
    exact Ideal.pow_right_mono le_sup_left n
  · -- Shrink `s` to an open subgroup `U`, absorbing the bounded images of `B` and `C`.
    obtain ⟨U, hUs⟩ := NonarchimedeanAddGroup.is_nonarchimedean s hs
    obtain ⟨VB, hVB, hVBU⟩ := isBounded_iff.mp
      (hr.isBounded_image (isBounded_of_isLinearTopology Set.univ)) U U.mem_nhds_zero
    obtain ⟨VC, hVC, hVCU⟩ := isBounded_iff.mp
      (hl.isBounded_image (isBounded_of_isLinearTopology Set.univ)) U U.mem_nhds_zero
    obtain ⟨m, -, hm⟩ := hI.hasBasis_nhds_zero.mem_iff.mp
      (hl.continuous.tendsto' 0 0 (map_zero inl) hVB)
    obtain ⟨m', -, hm'⟩ := hJ.hasBasis_nhds_zero.mem_iff.mp
      (hr.continuous.tendsto' 0 0 (map_zero inr) hVC)
    -- Every multiple of the image of an element of `Iᵐ` lies in `VB · inr(C) ⊆ U`.
    have hIU : (((I ^ m).map inl : Ideal (B ⊗[A] C)) : Set (B ⊗[A] C)) ⊆ U := by
      refine coe_span_subset_of_forall_mul_mem ?_
      rintro _ ⟨b, hb, rfl⟩ e
      induction e using TensorProduct.inductionOn with
      | tmul b' c =>
        have h : b' ⊗ₜ[A] c * inl b = inl (b' * b) * inr c := by simp [inl, inr, mul_comm]
        exact h ▸ hVBU (Set.mul_mem_mul (hm (Ideal.mul_mem_left _ b' hb)) ⟨c, trivial, rfl⟩)
      | add x y hx hy => simpa [add_mul] using U.add_mem hx hy
    -- Every multiple of the image of an element of `Jᵐ'` lies in `VC · inl(B) ⊆ U`.
    have hJU : (((J ^ m').map inr : Ideal (B ⊗[A] C)) : Set (B ⊗[A] C)) ⊆ U := by
      refine coe_span_subset_of_forall_mul_mem ?_
      rintro _ ⟨c, hc, rfl⟩ e
      induction e using TensorProduct.inductionOn with
      | tmul b c' =>
        have h : b ⊗ₜ[A] c' * inr c = inr (c' * c) * inl b := by simp [inl, inr, mul_comm]
        exact h ▸ hVCU (Set.mul_mem_mul (hm' (Ideal.mul_mem_left _ c' hc)) ⟨b, trivial, rfl⟩)
      | add x y hx hy => simpa [add_mul] using U.add_mem hx hy
    refine ⟨m + m', fun x hx ↦ hUs ?_⟩
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp (Ideal.sup_pow_add_le_pow_sup_pow hx)
    rw [← Ideal.map_pow] at hy hz
    exact U.add_mem (hIU hy) (hJU hz)

/-- **The tensor topology of adic rings is adic.** If the topologies of `B` and `C` are the
`I`-adic and `J`-adic topologies, the tensor topology on `B ⊗[A] C` is the adic topology of the
ideal generated by the images of `I` and `J`. -/
theorem isAdic_tensorTopology (hI : IsAdic I) (hJ : IsAdic J) :
    @IsAdic (B ⊗[A] C) _ (tensorTopology A B C)
      (I.map includeLeftRingHom ⊔ J.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)) :=
  isAdic_tensorTopology_aux A hI hJ

namespace CompletedTensor

private theorem continuous_coeRingHom_comp_includeLeft :
    Continuous (Completion.coeRingHom.comp includeLeftRingHom : B →+* Completion (B ⊗[A] C)) :=
  (Completion.continuous_coe _).comp (isAdicHom_includeLeft_tensorTopology A B C).continuous

private theorem continuous_coeRingHom_comp_includeRight :
    Continuous (Completion.coeRingHom.comp ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)) :=
  (Completion.continuous_coe _).comp (isAdicHom_includeRight_tensorTopology A B C).continuous

/-- The extension to `B ⊗̂_A C` of the canonical map from `B ⊗[A] C` to its uniform completion. -/
private noncomputable def toUniformCompletion :
    CompletedTensor A B C →+* Completion (B ⊗[A] C) :=
  lift (Completion.coeRingHom.comp includeLeftRingHom)
    (Completion.coeRingHom.comp ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C))
    (by rw [RingHom.comp_assoc, RingHom.comp_assoc, includeLeftRingHom_comp_algebraMap,
      AlgHom.toRingHom_eq_coe])
    (continuous_coeRingHom_comp_includeLeft A) (continuous_coeRingHom_comp_includeRight A)

private theorem continuous_toUniformCompletion :
    Continuous (toUniformCompletion A (B := B) (C := C)) :=
  continuous_lift ..

private theorem toUniformCompletion_toCompletion (x : B ⊗[A] C) :
    toUniformCompletion A (toCompletion A B C x) = x := by
  induction x using TensorProduct.inductionOn with
  | tmul b c =>
    rw [toCompletion_tmul, map_mul, toUniformCompletion, lift_inl, lift_inr]
    simp [← Completion.coe_mul]
  | add x y hx hy => rw [map_add, map_add, hx, hy, Completion.coe_add]

/-- The extension to the uniform completion of the canonical map into `B ⊗̂_A C`. -/
private noncomputable def ofUniformCompletion :
    Completion (B ⊗[A] C) →+* CompletedTensor A B C :=
  Completion.extensionHom (toCompletion A B C) (continuous_toCompletion A B C)

private theorem ofUniformCompletion_coe (x : B ⊗[A] C) :
    ofUniformCompletion A (x : Completion (B ⊗[A] C)) = toCompletion A B C x :=
  Completion.extensionHom_coe _ _ x

/-- The completed tensor ring is the uniform completion of `B ⊗[A] C` for the tensor topology.
The identification is assembled from the universal properties of both sides, so that it only uses
the interface of `CompletedTensor`. -/
private noncomputable def equivCompletion : CompletedTensor A B C ≃+* Completion (B ⊗[A] C) :=
  RingEquiv.ofRingHom (toUniformCompletion A) (ofUniformCompletion A)
    (DFunLike.coe_injective <| Completion.ext
      ((continuous_toUniformCompletion A).comp Completion.continuous_extension) continuous_id
      fun x ↦ by simp [ofUniformCompletion_coe, toUniformCompletion_toCompletion])
    (hom_ext (Completion.continuous_extension.comp (continuous_toUniformCompletion A))
      continuous_id
      (by
        ext b
        simpa [ofUniformCompletion_coe] using
          congrArg (ofUniformCompletion A) (toUniformCompletion_toCompletion A (b ⊗ₜ[A] (1 : C))))
      (by
        ext c
        simpa [ofUniformCompletion_coe] using
          congrArg (ofUniformCompletion A) (toUniformCompletion_toCompletion A ((1 : B) ⊗ₜ[A] c))))

private theorem equivCompletion_toCompletion (x : B ⊗[A] C) :
    equivCompletion A (toCompletion A B C x) = x :=
  toUniformCompletion_toCompletion A x

private theorem isHomeomorph_equivCompletion :
    IsHomeomorph (equivCompletion A (B := B) (C := C)) :=
  (Homeomorph.mk (equivCompletion A).toEquiv (continuous_toUniformCompletion A)
    Completion.continuous_extension).isHomeomorph

/-- **The completed tensor product of adic rings is adic.** If the topologies of `B` and `C` are
the `I`-adic and `J`-adic topologies for finitely generated ideals, the topology of `B ⊗̂_A C` is
the adic topology of the ideal generated by the images of `I` and `J`. -/
theorem isAdic_map_toCompletion (hI : IsAdic I) (hIfg : I.FG) (hJ : IsAdic J) (hJfg : J.FG) :
    IsAdic ((I.map includeLeftRingHom ⊔
      J.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)).map (toCompletion A B C)) := by
  have h := ((isAdic_tensorTopology_aux A hI hJ).map_coeRingHom
    (Submodule.FG.sup (hIfg.map _) (hJfg.map _))).comap (equivCompletion A)
    (isHomeomorph_equivCompletion A).isInducing
  have he : (equivCompletion A).symm.toRingHom.comp Completion.coeRingHom = toCompletion A B C :=
    RingHom.ext fun x ↦ (RingEquiv.symm_apply_eq _).mpr (equivCompletion_toCompletion A x).symm
  rw [← he, ← Ideal.map_map, RingEquiv.toRingHom_eq_coe, Ideal.map_comap_of_equiv,
    RingEquiv.symm_symm]
  exact h

/-- **The completed tensor product of adic rings is their adic completion.** If the topologies of
`B` and `C` are the `I`-adic and `J`-adic topologies for finitely generated ideals, `B ⊗̂_A C` is
isomorphic to the adic completion of `B ⊗[A] C` along the ideal generated by the images of `I`
and `J`, through the extension of the canonical map. -/
noncomputable def equivAdicCompletion (hI : IsAdic I) (hIfg : I.FG) (hJ : IsAdic J)
    (hJfg : J.FG) :
    CompletedTensor A B C ≃+* AdicCompletion
      (I.map includeLeftRingHom ⊔ J.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C))
      (B ⊗[A] C) :=
  (equivCompletion A).trans <| (isAdic_tensorTopology_aux A hI hJ).completionEquivAdicCompletion
    (Submodule.FG.sup (hIfg.map _) (hJfg.map _))

/-- The isomorphism `equivAdicCompletion` sends the image of `x ∈ B ⊗[A] C` in the completed
tensor product to its image in the adic completion. -/
@[simp]
theorem equivAdicCompletion_toCompletion (hI : IsAdic I) (hIfg : I.FG) (hJ : IsAdic J)
    (hJfg : J.FG) (x : B ⊗[A] C) :
    equivAdicCompletion A hI hIfg hJ hJfg (toCompletion A B C x) = algebraMap _ _ x := by
  rw [equivAdicCompletion, RingEquiv.trans_apply, equivCompletion_toCompletion]
  exact IsAdic.completionEquivAdicCompletion_coe _ _ x

/-- The inverse of `equivAdicCompletion` sends the image of `x ∈ B ⊗[A] C` in the adic completion
to its image in the completed tensor product. -/
@[simp]
theorem equivAdicCompletion_symm_algebraMap (hI : IsAdic I) (hIfg : I.FG) (hJ : IsAdic J)
    (hJfg : J.FG) (x : B ⊗[A] C) :
    (equivAdicCompletion A hI hIfg hJ hJfg).symm (algebraMap _ _ x) = toCompletion A B C x := by
  rw [RingEquiv.symm_apply_eq, equivAdicCompletion_toCompletion]

/-- The isomorphism `equivAdicCompletion` is a homeomorphism when the adic completion carries the
adic topology of the extension of the ideal generated by the images of `I` and `J`. -/
theorem isHomeomorph_equivAdicCompletion (hI : IsAdic I) (hIfg : I.FG) (hJ : IsAdic J)
    (hJfg : J.FG) :
    @IsHomeomorph _ _ _
      (Ideal.map (algebraMap (B ⊗[A] C) (AdicCompletion
        (I.map includeLeftRingHom ⊔ J.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C))
        (B ⊗[A] C)))
        (I.map includeLeftRingHom ⊔
          J.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C))).adicTopology
      (equivAdicCompletion A hI hIfg hJ hJfg) :=
  letI := Ideal.adicTopology (Ideal.map (algebraMap (B ⊗[A] C) (AdicCompletion
    (I.map includeLeftRingHom ⊔ J.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C))
    (B ⊗[A] C)))
    (I.map includeLeftRingHom ⊔ J.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)))
  ((isAdic_tensorTopology_aux A hI hJ).isHomeomorph_completionEquivAdicCompletion
    (Submodule.FG.sup (hIfg.map _) (hJfg.map _))).comp (isHomeomorph_equivCompletion A)

end CompletedTensor

end TauCeti.Huber
