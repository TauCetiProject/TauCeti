module

public import TauCeti.RingTheory.Huber.LocalizationTopology.Presentation
public import TauCeti.RingTheory.Huber.TensorProduct.Completion

/-!
# Presentations of rational intersections on completed tensor products

Let `A → B` and `A → C` be adic homomorphisms of Huber rings and `D = B ⊗̂_A C` their separated
completed tensor ring, with coprojections `inl : B → D` and `inr : C → D`. Given rational-subset
presentations `(T, s)` on `B` and `(T', s')` on `C` whose numerator finsets generate open ideals,
the intersection of the preimages of `R(T/s)` and `R(T'/s')` on `Spa` is presented by the numerator
finset

```text
T'' = ({inl(s)} ∪ inl(T)) · ({inr(s')} ∪ inr(T'))
```

and the denominator `inl(s) · inr(s')`. This lightweight module proves openness of the ideal
generated by `T''`, verifies `HasDenominatorPower` for `(T'', inl(s) · inr(s'))`, and packages the
resulting presentation `interPresentation`, without importing the completed-localisation tensor
equivalence of `TauCeti.RingTheory.Huber.TensorProduct.Rational.Basic`.

## Main definitions

* `TauCeti.Huber.CompletedTensor.interPresentation`: canonical presentation of the intersection
  denominator `inl(s) · inr(s')` on `B ⊗̂_A C`.

## Main results

* `TauCeti.Huber.CompletedTensor.hasDenominatorPower_inl_mul_inr`: if `T · B` and `T' · C` are
  open, the localisation of `D` at `T''` and `inl(s) · inr(s')` is defined.
* `TauCeti.Huber.CompletedTensor.isOpen_span_inl_mul_inr`: if `T · B` and `T' · C` are open,
  the intersection numerator finset `T''` generates an open ideal in `D`.
* `TauCeti.Huber.CompletedTensor.interPresentation_num` and `interPresentation_den`: numerator and
  denominator of `interPresentation`.

## References

* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217 (1994),
  §1, Lemma 1.5(ii).
* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), §7.5, Lemma 7.46(3).
-/

public section

namespace TauCeti.Huber.CompletedTensor

open PairOfDefinition

open scoped Pointwise

variable {A B C : Type*} [CommRing A] [CommRing B] [CommRing C] [Algebra A B]
  [Algebra A C] [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]
  [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]
  [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)] [DecidableEq (CompletedTensor A B C)]

/-- If `T · B` and `T' · C` are open, the standing hypothesis of the localisation of `B ⊗̂_A C` at
the numerators `insert (inl s) (inl T) * insert (inr s') (inr T')` and the denominator
`inl(s) · inr(s')` holds, for every pair of definition. These are the numerators presenting the
intersection of the preimages of `R(T/s)` and `R(T'/s')`
(`TauCeti.ValuationSpectrum.rationalSubset_inter`). -/
theorem hasDenominatorPower_inl_mul_inr (Q : PairOfDefinition (CompletedTensor A B C))
    {T : Finset B} {s : B} {T' : Finset C} {s' : C}
    (hT : IsOpen (Ideal.span (T : Set B) : Set B)) (hT' : IsOpen (Ideal.span (T' : Set C) : Set C))
    (S'' : Type*) [CommRing S''] [Algebra (CompletedTensor A B C) S'']
    [IsLocalization.Away (inl A B C s * inr A B C s') S''] :
    HasDenominatorPower Q
      (insert (inl A B C s) (T.image (inl A B C)) *
        insert (inr A B C s') (T'.image (inr A B C)) : Finset _)
      (inl A B C s * inr A B C s') S'' := by
  refine hasDenominatorPower_mul Q (inl A B C '' T) (inr A B C '' T') _ _ _
    (Localization.Away (inl A B C s))
    (Localization.Away (inr A B C s')) S'' ?_ ?_
    (hasDenominatorPower_of_isOpen_span Q _ _ _
      (by rw [← Ideal.map_span]; exact (isAdicHom_inl A B C).isOpen_map hT))
    (hasDenominatorPower_of_isOpen_span Q _ _ _
      (by rw [← Ideal.map_span]; exact (isAdicHom_inr A B C).isOpen_map hT'))
  · rintro _ ⟨t, ht, rfl⟩
    exact Finset.mul_mem_mul (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ ht))
      (Finset.mem_insert_self _ _)
  · rintro _ ⟨t', ht', rfl⟩
    rw [Finset.mem_coe, mul_comm (inr A B C t')]
    exact Finset.mul_mem_mul (Finset.mem_insert_self _ _)
      (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ ht'))

/-- When `T · B` and `T' · C` are open ideals, the intersection numerator finset
`insert (inl s) (inl T) * insert (inr s') (inr T')` generates an open ideal in `B ⊗̂_A C`. -/
theorem isOpen_span_inl_mul_inr {T : Finset B} {s : B} {T' : Finset C} {s' : C}
    (hT : IsOpen (Ideal.span (T : Set B) : Set B))
    (hT' : IsOpen (Ideal.span (T' : Set C) : Set C)) :
    IsOpen (Ideal.span
      ((insert (inl A B C s) (T.image (inl A B C)) *
        insert (inr A B C s') (T'.image (inr A B C)) :
          Finset (CompletedTensor A B C)) : Set (CompletedTensor A B C)) :
      Set (CompletedTensor A B C)) := by
  obtain ⟨PD⟩ := IsHuberRing.nonempty_pairOfDefinition (A := CompletedTensor A B C)
  have hTl : IsOpen (Ideal.span ((T.image (inl A B C) :
      Finset (CompletedTensor A B C)) : Set (CompletedTensor A B C)) :
      Set (CompletedTensor A B C)) := by
    rw [Finset.coe_image, ← Ideal.map_span]
    exact (isAdicHom_inl A B C).isOpen_map hT
  have hTr : IsOpen (Ideal.span ((T'.image (inr A B C) :
      Finset (CompletedTensor A B C)) : Set (CompletedTensor A B C)) :
      Set (CompletedTensor A B C)) := by
    rw [Finset.coe_image, ← Ideal.map_span]
    exact (isAdicHom_inr A B C).isOpen_map hT'
  convert PD.isOpen_span_insert_mul_insert hTl hTr

/-- **The canonical presentation at denominator `inl(s) · inr(s')`** with respect to a pair of
definition `PD` on `B ⊗̂_A C`, when `T · B` and `T' · C` are open ideals. -/
noncomputable def interPresentation
    (PD : PairOfDefinition (CompletedTensor A B C)) {T : Finset B} (s : B) {T' : Finset C} (s' : C)
    (hT : IsOpen (Ideal.span (T : Set B) : Set B))
    (hT' : IsOpen (Ideal.span (T' : Set C) : Set C)) : PD.Presentation where
  num := insert (inl A B C s) (T.image (inl A B C)) *
    insert (inr A B C s') (T'.image (inr A B C))
  den := inl A B C s * inr A B C s'
  hasDenominatorPower := hasDenominatorPower_inl_mul_inr PD hT hT' _

/-- Numerator finset of `interPresentation`. -/
@[simp] theorem interPresentation_num
    (PD : PairOfDefinition (CompletedTensor A B C)) {T : Finset B} (s : B) {T' : Finset C} (s' : C)
    (hT : IsOpen (Ideal.span (T : Set B) : Set B))
    (hT' : IsOpen (Ideal.span (T' : Set C) : Set C)) :
    (interPresentation PD s s' hT hT').num =
      insert (inl A B C s) (T.image (inl A B C)) *
        insert (inr A B C s') (T'.image (inr A B C)) := (rfl)

/-- Denominator of `interPresentation`. -/
@[simp] theorem interPresentation_den
    (PD : PairOfDefinition (CompletedTensor A B C)) {T : Finset B} (s : B) {T' : Finset C} (s' : C)
    (hT : IsOpen (Ideal.span (T : Set B) : Set B))
    (hT' : IsOpen (Ideal.span (T' : Set C) : Set C)) :
    (interPresentation PD s s' hT hT').den = inl A B C s * inr A B C s' := (rfl)

end TauCeti.Huber.CompletedTensor
