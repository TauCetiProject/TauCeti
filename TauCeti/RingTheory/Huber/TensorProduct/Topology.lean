module

public import Mathlib.RingTheory.TensorProduct.Basic
public import TauCeti.RingTheory.Huber.AdicHom.Basic

/-!
# The tensor topology of Huber rings along adic homomorphisms

Let `A → B` and `A → C` be adic homomorphisms of Huber rings. Choose a pair of definition
`(A₀, I)` of `A` and pairs of definition `(B₀, I B₀)` of `B` and `(C₀, I C₀)` of `C` with
`A₀ → B₀` and `A₀ → C₀` (a `TauCeti.Huber.TensorDatum`). In `E = B ⊗[A] C` let `F` be the subring
generated by the images of `B₀` and `C₀`, that is the image of `B₀ ⊗[A₀] C₀`, and let `J = I F`.
The images in `E` of the powers `Jⁿ` are a basis of neighbourhoods of zero for a ring topology on
`E`, for which `(F, J)` is a pair of definition and both inclusions `B → E` and `C → E` are adic.

This topology does not depend on the chosen pairs of definition
(`TauCeti.Huber.TensorDatum.topology_eq`), and compatible pairs exist as soon as both structure
maps are adic. The result is the *tensor topology* `TauCeti.Huber.tensorTopology A B C`. Its
Hausdorff completion is Huber's completed tensor product `B ⊗̂_A C`, the affinoid form of the
fibre product of adic spaces.

## Main definitions

* `TauCeti.Huber.TensorDatum A B C`: compatible pairs of definition of `A`, `B` and `C`.
* `TauCeti.Huber.TensorDatum.ringOfDefinition`, `TauCeti.Huber.TensorDatum.idealOfDefinition`:
  the subring `F` of `B ⊗[A] C` and its ideal `J = I F`.
* `TauCeti.Huber.TensorDatum.topology`: the topology on `B ⊗[A] C` whose neighbourhoods of zero
  are the images of the powers of `J`.
* `TauCeti.Huber.TensorDatum.pairOfDefinition`: `(F, J)` as a pair of definition.
* `TauCeti.Huber.tensorTopology A B C`: the tensor topology, for adic structure maps.

## Main results

* `TauCeti.Huber.TensorDatum.isTopologicalRing`, `TauCeti.Huber.TensorDatum.isHuberRing`: the
  topology of a datum makes `B ⊗[A] C` a Huber ring.
* `TauCeti.Huber.TensorDatum.isAdicHom_includeLeft`,
  `TauCeti.Huber.TensorDatum.isAdicHom_includeRight`: the two inclusions are adic.
* `TauCeti.Huber.TensorDatum.topology_eq`: the topology does not depend on the datum.
* `TauCeti.Huber.hasBasis_tensorTopology`: every datum gives a neighbourhood basis of zero for
  the tensor topology.

## References

* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217
  (1994), §3, proof of Lemma 3.9(i).
* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.2, proof of Proposition 1.2.2(1).
* S. Morel, *Adic spaces*, §II.3.2, Proposition II.3.2.1.
-/

public section

open TensorProduct Algebra.TensorProduct Topology Filter
open scoped Pointwise

namespace TauCeti.Huber

variable (A B C : Type*) [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]
  [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]

/-- Pairs of definition of `A`, `B` and `C` compatible with the structure maps `A → B` and
`A → C`: the ring of definition of `A` maps into those of `B` and `C`, and the ideal of
definition of `A` generates theirs. Such data define the tensor topology on `B ⊗[A] C`; they
make both structure maps adic, and they exist when both structure maps are adic
(`TauCeti.Huber.TensorDatum.nonempty`). -/
structure TensorDatum where
  /-- The pair of definition `(A₀, I)` of `A`. -/
  base : PairOfDefinition A
  /-- The pair of definition `(B₀, I B₀)` of `B`. -/
  left : PairOfDefinition B
  /-- The pair of definition `(C₀, I C₀)` of `C`. -/
  right : PairOfDefinition C
  /-- The ring of definition of `A` maps into that of `B`. -/
  algebraMap_mem_left : ∀ a ∈ base.ringOfDefinition, algebraMap A B a ∈ left.ringOfDefinition
  /-- The ring of definition of `A` maps into that of `C`. -/
  algebraMap_mem_right : ∀ a ∈ base.ringOfDefinition, algebraMap A C a ∈ right.ringOfDefinition
  /-- The ideal of definition of `B` is generated by the image of that of `A`. -/
  map_idealOfDefinition_left : base.idealOfDefinition.map
    ((algebraMap A B).restrict _ _ algebraMap_mem_left) = left.idealOfDefinition
  /-- The ideal of definition of `C` is generated by the image of that of `A`. -/
  map_idealOfDefinition_right : base.idealOfDefinition.map
    ((algebraMap A C).restrict _ _ algebraMap_mem_right) = right.idealOfDefinition

namespace TensorDatum

variable {A B C} (D : TensorDatum A B C)

include D in
/-- The structure map `A → B` of a tensor datum is adic. -/
theorem isAdicHom_algebraMap_left : IsAdicHom (algebraMap A B) :=
  ⟨D.base, D.left, D.algebraMap_mem_left, D.map_idealOfDefinition_left⟩

include D in
/-- The structure map `A → C` of a tensor datum is adic. -/
theorem isAdicHom_algebraMap_right : IsAdicHom (algebraMap A C) :=
  ⟨D.base, D.right, D.algebraMap_mem_right, D.map_idealOfDefinition_right⟩

/-! ### The ring and the ideal of definition -/

/-- The ring of definition `F` of `B ⊗[A] C`: the subring generated by the images of the rings
of definition of `B` and `C`. -/
def ringOfDefinition : Subring (B ⊗[A] C) :=
  D.left.ringOfDefinition.map includeLeftRingHom ⊔
    D.right.ringOfDefinition.map ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C)

/-- `F` contains the image of `B₀`. -/
theorem tmul_one_mem_ringOfDefinition {b : B} (hb : b ∈ D.left.ringOfDefinition) :
    b ⊗ₜ[A] (1 : C) ∈ D.ringOfDefinition :=
  le_sup_left (a := D.left.ringOfDefinition.map _) (Subring.mem_map.mpr ⟨b, hb, rfl⟩)

/-- `F` contains the image of `C₀`. -/
theorem one_tmul_mem_ringOfDefinition {c : C} (hc : c ∈ D.right.ringOfDefinition) :
    (1 : B) ⊗ₜ[A] c ∈ D.ringOfDefinition :=
  le_sup_right (b := D.right.ringOfDefinition.map _) (Subring.mem_map.mpr ⟨c, hc, rfl⟩)

/-- `F` contains the image of `B₀ ⊗[A₀] C₀`. -/
theorem tmul_mem_ringOfDefinition {b : B} {c : C} (hb : b ∈ D.left.ringOfDefinition)
    (hc : c ∈ D.right.ringOfDefinition) : b ⊗ₜ[A] c ∈ D.ringOfDefinition := by
  simpa using mul_mem (D.tmul_one_mem_ringOfDefinition hb) (D.one_tmul_mem_ringOfDefinition hc)

/-- `F` is the smallest subring containing the image of `B₀ ⊗[A₀] C₀`. -/
theorem ringOfDefinition_le_iff {S : Subring (B ⊗[A] C)} :
    D.ringOfDefinition ≤ S ↔ ∀ b ∈ D.left.ringOfDefinition, ∀ c ∈ D.right.ringOfDefinition,
      b ⊗ₜ[A] c ∈ S := by
  refine ⟨fun h b hb c hc ↦ h (D.tmul_mem_ringOfDefinition hb hc), fun h ↦ sup_le ?_ ?_⟩
  · rintro _ ⟨b, hb, rfl⟩
    exact h b hb 1 (one_mem _)
  · rintro _ ⟨c, hc, rfl⟩
    exact h 1 (one_mem _) c hc

/-- The ring of definition of a tensor datum is additively generated by the pure tensors
of elements of the two rings of definition. -/
theorem ringOfDefinition_le_addSubgroup_iff (H : AddSubgroup (B ⊗[A] C)) :
    D.ringOfDefinition.toAddSubgroup ≤ H ↔
      ∀ b ∈ D.left.ringOfDefinition, ∀ c ∈ D.right.ringOfDefinition, b ⊗ₜ[A] c ∈ H := by
  refine ⟨fun h b hb c hc ↦ h (D.tmul_mem_ringOfDefinition hb hc), fun h ↦ ?_⟩
  let S : Submonoid (B ⊗[A] C) :=
    { carrier := {x | ∃ b ∈ D.left.ringOfDefinition, ∃ c ∈ D.right.ringOfDefinition,
        b ⊗ₜ[A] c = x}
      one_mem' := ⟨1, one_mem _, 1, one_mem _, rfl⟩
      mul_mem' := by
        rintro _ _ ⟨b, hb, c, hc, rfl⟩ ⟨b', hb', c', hc', rfl⟩
        exact ⟨b * b', mul_mem hb hb', c * c', mul_mem hc hc', by rw [tmul_mul_tmul]⟩ }
  have hF : D.ringOfDefinition ≤ Subring.closure (S : Set (B ⊗[A] C)) :=
    D.ringOfDefinition_le_iff.mpr fun b hb c hc ↦
      Subring.subset_closure ⟨b, hb, c, hc, rfl⟩
  intro x hx
  have hx := Subring.mem_closure_iff.mp (hF hx)
  rw [Submonoid.closure_eq] at hx
  apply ((AddSubgroup.closure_le H (k := (S : Set (B ⊗[A] C)))).mpr ?_) hx
  rintro x ⟨b, hb, c, hc, hbc⟩
  exact hbc ▸ h b hb c hc

/-- `F` contains the image of `A₀`. -/
theorem algebraMap_mem_ringOfDefinition {a : A} (ha : a ∈ D.base.ringOfDefinition) :
    algebraMap A (B ⊗[A] C) a ∈ D.ringOfDefinition :=
  D.tmul_one_mem_ringOfDefinition (D.algebraMap_mem_left a ha)

/-- The homomorphism `A₀ → F` induced by the structure map `A → B ⊗[A] C`. -/
def toRingOfDefinition : D.base.ringOfDefinition →+* D.ringOfDefinition :=
  (algebraMap A (B ⊗[A] C)).restrict _ _ fun _ ha ↦ D.algebraMap_mem_ringOfDefinition ha

/-- `A₀ → F` is the restriction of the structure map. -/
@[simp]
theorem coe_toRingOfDefinition (a : D.base.ringOfDefinition) :
    (D.toRingOfDefinition a : B ⊗[A] C) = algebraMap A (B ⊗[A] C) a :=
  (rfl)

/-- The ideal of definition `J = I F` of `F`, generated by the image of the ideal of definition
of `A`. -/
def idealOfDefinition : Ideal D.ringOfDefinition :=
  D.base.idealOfDefinition.map D.toRingOfDefinition

/-- `A₀ → B₀ → F` is `A₀ → F`. -/
private theorem restrict_includeLeft_comp_restrict_algebraMap :
    (includeLeftRingHom.restrict _ D.ringOfDefinition
      fun _ hb ↦ D.tmul_one_mem_ringOfDefinition hb).comp
        ((algebraMap A B).restrict _ _ D.algebraMap_mem_left) = D.toRingOfDefinition :=
  RingHom.ext fun a ↦ Subtype.ext (algebraMap_apply (a : A)).symm

/-- `A₀ → C₀ → F` is `A₀ → F`. -/
private theorem restrict_includeRight_comp_restrict_algebraMap :
    (((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C).restrict _ D.ringOfDefinition
      fun _ hc ↦ D.one_tmul_mem_ringOfDefinition hc).comp
        ((algebraMap A C).restrict _ _ D.algebraMap_mem_right) = D.toRingOfDefinition :=
  RingHom.ext fun a ↦ Subtype.ext (algebraMap_apply' (a : A)).symm

/-- Unfolding lemma for `TauCeti.Huber.TensorDatum.idealOfDefinition`. -/
theorem idealOfDefinition_def :
    D.idealOfDefinition = D.base.idealOfDefinition.map D.toRingOfDefinition :=
  (rfl)

/-- `J` is finitely generated, since the ideal of definition of `A` is. -/
theorem fg_idealOfDefinition : D.idealOfDefinition.FG :=
  D.base.fg_idealOfDefinition.map _

/-- **Induction on `Jᵏ`**: a property of elements of `F` that holds at zero, is closed under
addition and under multiplication by elements of `F`, and holds on the image of `Iᵏ`, holds on
`Jᵏ`. -/
theorem idealOfDefinition_pow_induction {k : ℕ} {p : D.ringOfDefinition → Prop} (zero : p 0)
    (add : ∀ y z, p y → p z → p (y + z)) (mul : ∀ r y, p y → p (r * y))
    (image : ∀ a ∈ D.base.idealOfDefinition ^ k, p (D.toRingOfDefinition a))
    {y : D.ringOfDefinition} (hy : y ∈ D.idealOfDefinition ^ k) : p y := by
  rw [idealOfDefinition, ← Ideal.map_pow] at hy
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, ha, rfl⟩ := hy
    exact image a ha
  | zero => exact zero
  | add y z _ _ hy hz => exact add y z hy hz
  | smul r y _ hy => exact mul r y hy

/-! ### The neighbourhoods of zero -/

/-- The image in `B ⊗[A] C` of the power `Jⁿ` of the ideal of definition. -/
def idealImage (n : ℕ) : AddSubgroup (B ⊗[A] C) :=
  (D.idealOfDefinition ^ n).toAddSubgroup.map D.ringOfDefinition.subtype.toAddMonoidHom

/-- Membership in the image of `Jⁿ`. -/
@[simp]
theorem mem_idealImage {n : ℕ} {x : B ⊗[A] C} :
    x ∈ D.idealImage n ↔ ∃ y ∈ D.idealOfDefinition ^ n, (y : B ⊗[A] C) = x := by
  simp [idealImage]

/-- The image of `Iⁿ` lies in the image of `Jⁿ`. -/
theorem algebraMap_mem_idealImage {n : ℕ} {a : D.base.ringOfDefinition}
    (ha : a ∈ D.base.idealOfDefinition ^ n) :
    algebraMap A (B ⊗[A] C) a ∈ D.idealImage n := by
  refine D.mem_idealImage.mpr ⟨D.toRingOfDefinition a, ?_, rfl⟩
  rw [idealOfDefinition, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ ha

/-- The zeroth neighbourhood is `F` itself. -/
@[simp]
theorem idealImage_zero : D.idealImage 0 = D.ringOfDefinition.toAddSubgroup := by
  ext x
  simp only [mem_idealImage, pow_zero, Ideal.one_eq_top, Submodule.mem_top, true_and,
    Subring.mem_toAddSubgroup]
  exact ⟨fun ⟨y, hy⟩ ↦ hy ▸ y.2, fun hx ↦ ⟨⟨x, hx⟩, rfl⟩⟩

/-- The images of the powers of `J` are nested. -/
theorem idealImage_antitone : Antitone D.idealImage :=
  fun _ _ h ↦ AddSubgroup.map_mono (Submodule.toAddSubgroup_mono (Ideal.pow_le_pow_right h))

/-- Pulling the image of `Jⁿ` back to `F` gives `Jⁿ`. -/
@[simp]
theorem preimage_idealImage (n : ℕ) :
    (Subtype.val : D.ringOfDefinition → B ⊗[A] C) ⁻¹' D.idealImage n =
      ((D.idealOfDefinition ^ n : Ideal D.ringOfDefinition) : Set D.ringOfDefinition) := by
  ext y
  simp only [Set.mem_preimage, SetLike.mem_coe, mem_idealImage]
  exact ⟨fun ⟨z, hz, hzy⟩ ↦ Subtype.ext hzy ▸ hz, fun hy ↦ ⟨y, hy, rfl⟩⟩

private theorem idealImage_mul_subset (n : ℕ) :
    (D.idealImage n : Set (B ⊗[A] C)) * (D.idealImage n : Set (B ⊗[A] C)) ⊆
      (D.idealImage n : Set (B ⊗[A] C)) := by
  rintro _ ⟨_, hx, _, hy, rfl⟩
  obtain ⟨x, -, rfl⟩ := D.mem_idealImage.mp hx
  obtain ⟨y, hy', rfl⟩ := D.mem_idealImage.mp hy
  exact D.mem_idealImage.mpr ⟨x * y, Ideal.mul_mem_left _ _ hy', rfl⟩

/-- The image of `Iᵏ` in `B` is the image of an element of `(I B₀)ᵏ`. -/
private theorem restrict_mem_left_pow {k : ℕ} {a : D.base.ringOfDefinition}
    (ha : a ∈ D.base.idealOfDefinition ^ k) :
    (algebraMap A B).restrict _ _ D.algebraMap_mem_left a ∈ D.left.idealOfDefinition ^ k := by
  rw [← D.map_idealOfDefinition_left, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ ha

/-- The image of `Iᵏ` in `C` is the image of an element of `(I C₀)ᵏ`. -/
private theorem restrict_mem_right_pow {k : ℕ} {a : D.base.ringOfDefinition}
    (ha : a ∈ D.base.idealOfDefinition ^ k) :
    (algebraMap A C).restrict _ _ D.algebraMap_mem_right a ∈ D.right.idealOfDefinition ^ k := by
  rw [← D.map_idealOfDefinition_right, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ ha

/-- If `x` multiplies the image of `Iᵏ` into `F`, then it multiplies `Jᵏ` into `F`. -/
private theorem mul_mem_of_forall_algebraMap {x : B ⊗[A] C} {k : ℕ}
    (hx : ∀ a ∈ D.base.idealOfDefinition ^ k,
      x * algebraMap A (B ⊗[A] C) a ∈ D.ringOfDefinition)
    {y : D.ringOfDefinition} (hy : y ∈ D.idealOfDefinition ^ k) :
    x * y ∈ D.ringOfDefinition :=
  D.idealOfDefinition_pow_induction (p := fun y ↦ x * y ∈ D.ringOfDefinition) (by simp)
    (fun y z hy hz ↦ by simpa [mul_add] using add_mem hy hz)
    (fun r y hy ↦ by simpa [mul_left_comm] using mul_mem r.2 hy) hx hy

/-- **Every element of `B ⊗[A] C` multiplies a power of `J` into `F`.** This is the
left-multiplication condition making the images of the powers of `J` a `RingSubgroupsBasis`. -/
theorem exists_forall_mul_mem [SeparatelyContinuousMul B] [SeparatelyContinuousMul C]
    (x : B ⊗[A] C) :
    ∃ k, ∀ y ∈ D.idealOfDefinition ^ k, x * (y : B ⊗[A] C) ∈ D.ringOfDefinition := by
  induction x using TensorProduct.inductionOn with
  | tmul b c =>
    -- A power of `I B₀` multiplies `b` into `B₀`, and a power of `I C₀` multiplies `c` into `C₀`.
    obtain ⟨k₁, hk₁⟩ :=
      D.left.exists_pow_idealOfDefinition_mul_mem D.left.isOpen_ringOfDefinition b
    obtain ⟨k₂, hk₂⟩ :=
      D.right.exists_pow_idealOfDefinition_mul_mem D.right.isOpen_ringOfDefinition c
    have h₁ : ∀ y ∈ D.idealOfDefinition ^ k₁, b ⊗ₜ[A] (1 : C) * y ∈ D.ringOfDefinition :=
      fun y ↦ D.mul_mem_of_forall_algebraMap fun a ha ↦ by
        rw [algebraMap_apply, tmul_mul_tmul, mul_one]
        exact D.tmul_one_mem_ringOfDefinition (hk₁ _ (D.restrict_mem_left_pow ha))
    have h₂ : ∀ y ∈ D.idealOfDefinition ^ k₂, (1 : B) ⊗ₜ[A] c * y ∈ D.ringOfDefinition :=
      fun y ↦ D.mul_mem_of_forall_algebraMap fun a ha ↦ by
        rw [algebraMap_apply', tmul_mul_tmul, one_mul]
        exact D.one_tmul_mem_ringOfDefinition (hk₂ _ (D.restrict_mem_right_pow ha))
    refine ⟨k₁ + k₂, fun y hy ↦ ?_⟩
    rw [pow_add] at hy
    refine Submodule.mul_induction_on hy (fun y hy z hz ↦ ?_)
      (fun y z hy hz ↦ by simpa [mul_add] using add_mem hy hz)
    have h : b ⊗ₜ[A] c * ↑(y * z) =
        (b ⊗ₜ[A] (1 : C) * y) * ((1 : B) ⊗ₜ[A] c * z) := by
      rw [Subring.coe_mul, mul_mul_mul_comm, tmul_mul_tmul, mul_one, one_mul]
    exact h ▸ mul_mem (h₁ y hy) (h₂ z hz)
  | add x x' hx hx' =>
    obtain ⟨k, hk⟩ := hx
    obtain ⟨k', hk'⟩ := hx'
    refine ⟨max k k', fun y hy ↦ ?_⟩
    rw [add_mul]
    exact add_mem (hk y (Ideal.pow_le_pow_right (le_max_left k k') hy))
      (hk' y (Ideal.pow_le_pow_right (le_max_right k k') hy))

private theorem idealImage_leftMul [SeparatelyContinuousMul B] [SeparatelyContinuousMul C]
    (x : B ⊗[A] C) (n : ℕ) :
    ∃ m, (D.idealImage m : Set (B ⊗[A] C)) ⊆ (x * ·) ⁻¹' D.idealImage n := by
  obtain ⟨k, hk⟩ := D.exists_forall_mul_mem x
  refine ⟨k + n, fun x' hx' ↦ ?_⟩
  obtain ⟨y, hy, rfl⟩ := D.mem_idealImage.mp hx'
  rw [pow_add] at hy
  simp only [Set.mem_preimage, SetLike.mem_coe]
  refine Submodule.mul_induction_on hy (fun y hy z hz ↦ ?_)
    (fun y z hy hz ↦ by simpa [mul_add] using add_mem hy hz)
  exact D.mem_idealImage.mpr ⟨⟨_, hk y hy⟩ * z, Ideal.mul_mem_left _ _ hz, by simp [mul_assoc]⟩

private theorem basis [SeparatelyContinuousMul B] [SeparatelyContinuousMul C] :
    RingSubgroupsBasis D.idealImage :=
  .of_comm _
    (fun i j ↦ ⟨max i j, le_inf (D.idealImage_antitone (le_max_left i j))
      (D.idealImage_antitone (le_max_right i j))⟩)
    (fun i ↦ ⟨i, D.idealImage_mul_subset i⟩) D.idealImage_leftMul

/-! ### The topology of a tensor datum -/

section Topology

variable [SeparatelyContinuousMul B] [SeparatelyContinuousMul C]

/-- The topology on `B ⊗[A] C` whose neighbourhoods of zero are the images of the powers of the
ideal of definition `J`. When `A`, `B` and `C` are topological rings it does not depend on the
datum (`TauCeti.Huber.TensorDatum.topology_eq`). -/
@[instance_reducible] def topology : TopologicalSpace (B ⊗[A] C) :=
  D.basis.topology

/-- The images of the powers of `J` are a basis of neighbourhoods of zero. -/
theorem hasBasis_nhds_zero :
    (@nhds _ D.topology 0).HasBasis (fun _ : ℕ ↦ True)
      fun n ↦ (D.idealImage n : Set (B ⊗[A] C)) :=
  D.basis.hasBasis_nhds_zero

/-- The topology of a tensor datum is a ring topology. -/
theorem isTopologicalRing : @IsTopologicalRing (B ⊗[A] C) D.topology _ :=
  D.basis.toRingFilterBasis.isTopologicalRing

/-- The image of each power of `J` is open. -/
theorem isOpen_idealImage (n : ℕ) :
    @IsOpen (B ⊗[A] C) D.topology (D.idealImage n : Set (B ⊗[A] C)) := by
  let _ := D.topology
  exact (D.basis.openAddSubgroup n).isOpen

/-- `F` is open. -/
theorem isOpen_ringOfDefinition :
    @IsOpen (B ⊗[A] C) D.topology (D.ringOfDefinition : Set (B ⊗[A] C)) := by
  simpa using D.isOpen_idealImage 0

/-- The subspace topology on `F` is the `J`-adic topology. -/
theorem isAdic_idealOfDefinition :
    letI := D.topology
    IsAdic D.idealOfDefinition := by
  let _ := D.topology
  have _ := D.isTopologicalRing
  have hbasis : (𝓝 (0 : D.ringOfDefinition)).HasBasis (fun _ : ℕ ↦ True)
      fun n ↦ ((D.idealOfDefinition ^ n : Ideal D.ringOfDefinition) : Set D.ringOfDefinition) := by
    rw [nhds_induced]
    simpa using D.hasBasis_nhds_zero.comap (Subtype.val : D.ringOfDefinition → B ⊗[A] C)
  rw [isAdic_iff]
  refine ⟨fun n ↦ ?_, fun U hU ↦ ?_⟩
  · exact (D.idealOfDefinition ^ n).toAddSubgroup.isOpen_of_mem_nhds (g := 0)
      (hbasis.mem_of_mem (i := n) trivial)
  · obtain ⟨n, -, hn⟩ := hbasis.mem_iff.mp hU
    exact ⟨n, hn⟩

/-- `(F, J)` is a pair of definition of `B ⊗[A] C` for the topology of the datum. -/
def pairOfDefinition :
    letI := D.topology
    PairOfDefinition (B ⊗[A] C) :=
  letI := D.topology
  { ringOfDefinition := D.ringOfDefinition
    isOpen_ringOfDefinition := D.isOpen_ringOfDefinition
    idealOfDefinition := D.idealOfDefinition
    fg_idealOfDefinition := D.fg_idealOfDefinition
    isAdic_idealOfDefinition := D.isAdic_idealOfDefinition }

/-- The ring of definition of `pairOfDefinition` is `F`. -/
@[simp]
theorem pairOfDefinition_ringOfDefinition :
    letI := D.topology
    D.pairOfDefinition.ringOfDefinition = D.ringOfDefinition :=
  (rfl)

/-- The neighbourhoods of zero of `pairOfDefinition` are the images of the powers of `J`. -/
@[simp]
theorem pairOfDefinition_idealImage (n : ℕ) :
    letI := D.topology
    D.pairOfDefinition.idealImage n = D.idealImage n := by
  let _ := D.topology
  ext
  exact (PairOfDefinition.mem_idealImage _ n).trans D.mem_idealImage.symm

/-- Membership in the ideal of definition of `pairOfDefinition` is membership in `J`. -/
@[simp]
theorem mem_pairOfDefinition_idealOfDefinition
    {x : letI := D.topology; D.pairOfDefinition.ringOfDefinition} :
    letI := D.topology
    x ∈ D.pairOfDefinition.idealOfDefinition ↔
      (⟨x, by rw [← D.pairOfDefinition_ringOfDefinition]; exact x.2⟩ : D.ringOfDefinition) ∈
        D.idealOfDefinition :=
  (Iff.rfl)

/-- The topology of a tensor datum makes `B ⊗[A] C` a Huber ring. -/
theorem isHuberRing :
    letI := D.topology
    letI := D.isTopologicalRing
    IsHuberRing (B ⊗[A] C) :=
  let _ := D.topology
  let _ := D.isTopologicalRing
  ⟨⟨D.pairOfDefinition⟩⟩

/-- The inclusion `B → B ⊗[A] C` is adic for the topology of a tensor datum: it carries `B₀`
into `F`, and `I B₀` to the ideal `J = I F`. -/
theorem isAdicHom_includeLeft :
    letI := D.topology
    IsAdicHom (includeLeftRingHom : B →+* B ⊗[A] C) := by
  let _ := D.topology
  refine ⟨D.left, D.pairOfDefinition, fun _ hb ↦ D.tmul_one_mem_ringOfDefinition hb, ?_⟩
  -- The pair `D.pairOfDefinition` has ring of definition `F` and ideal of definition `J` by
  -- definition (`pairOfDefinition_ringOfDefinition`).
  change Ideal.map (includeLeftRingHom.restrict _ D.ringOfDefinition
    fun _ hb ↦ D.tmul_one_mem_ringOfDefinition hb) D.left.idealOfDefinition = D.idealOfDefinition
  rw [← D.map_idealOfDefinition_left, Ideal.map_map, restrict_includeLeft_comp_restrict_algebraMap,
    idealOfDefinition_def]

/-- The inclusion `C → B ⊗[A] C` is adic for the topology of a tensor datum: it carries `C₀`
into `F`, and `I C₀` to the ideal `J = I F`. -/
theorem isAdicHom_includeRight :
    letI := D.topology
    IsAdicHom ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C) := by
  let _ := D.topology
  refine ⟨D.right, D.pairOfDefinition, fun _ hc ↦ D.one_tmul_mem_ringOfDefinition hc, ?_⟩
  -- As for `isAdicHom_includeLeft`, the pair `D.pairOfDefinition` is `(F, J)` by definition.
  change Ideal.map (((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C).restrict _
    D.ringOfDefinition fun _ hc ↦ D.one_tmul_mem_ringOfDefinition hc) D.right.idealOfDefinition =
      D.idealOfDefinition
  rw [← D.map_idealOfDefinition_right, Ideal.map_map,
    restrict_includeRight_comp_restrict_algebraMap, idealOfDefinition_def]

end Topology

/-! ### Independence of the datum -/

variable [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]

/-- For two tensor data `D` and `D'`, every neighbourhood `image(Jⁿ)` of `D` contains a
neighbourhood `image(J'ᵐ)` of `D'`. For the topology of `D`, the ring of definition `F'` of `D'`
is bounded, because the two inclusions are adic, and the structure map from `A` is continuous;
so the image of a deep power of the ideal of definition of `A` multiplies `F'` into `image(Jⁿ)`.
-/
private theorem exists_idealImage_le (D' : TensorDatum A B C) (n : ℕ) :
    ∃ m, D'.idealImage m ≤ D.idealImage n := by
  let _ := D.topology
  have _ := D.isTopologicalRing
  have _ := D.pairOfDefinition.toNonarchimedeanRing
  have hF' : IsBounded (D'.ringOfDefinition : Set (B ⊗[A] C)) :=
    isBounded_sup _ _
      (by simpa using D.isAdicHom_includeLeft.isBounded_image D'.left.isBounded_ringOfDefinition)
      (by simpa using D.isAdicHom_includeRight.isBounded_image D'.right.isBounded_ringOfDefinition)
  obtain ⟨V, hV, hVF⟩ := isBounded_iff.mp hF' _
    ((D.isOpen_idealImage n).mem_nhds (D.idealImage n).zero_mem)
  have hc : Continuous (algebraMap A (B ⊗[A] C)) :=
    D.isAdicHom_includeLeft.continuous.comp D.isAdicHom_algebraMap_left.continuous
  obtain ⟨m, -, hm⟩ := D'.base.hasBasis_nhds_zero.mem_iff.mp
    (hc.continuousAt.preimage_mem_nhds (by simpa using hV))
  refine ⟨m, fun _ hx ↦ ?_⟩
  obtain ⟨y, hy, rfl⟩ := D'.mem_idealImage.mp hx
  simpa using D'.idealOfDefinition_pow_induction
    (p := fun y ↦ ∀ r ∈ D'.ringOfDefinition, r * (y : B ⊗[A] C) ∈ D.idealImage n)
    (fun r _ ↦ by simp) (fun y z hy hz r hr ↦ by simpa [mul_add] using add_mem (hy r hr) (hz r hr))
    (fun s y hy r hr ↦ by simpa [mul_assoc] using hy (r * s) (mul_mem hr s.2))
    (fun a ha r hr ↦ hVF ⟨_, hm ((D'.base.mem_idealImage m).mpr ⟨a, ha, rfl⟩), r, hr,
      mul_comm _ _⟩) hy 1 (one_mem _)

/-- **The tensor topology does not depend on the choice of compatible pairs of definition.** -/
theorem topology_eq (D' : TensorDatum A B C) :
    D.topology = D'.topology :=
  IsTopologicalAddGroup.ext (@IsTopologicalRing.isTopologicalAddGroup _ _ D.topology
      D.isTopologicalRing)
    (@IsTopologicalRing.isTopologicalAddGroup _ _ D'.topology D'.isTopologicalRing) <|
    D.hasBasis_nhds_zero.ext D'.hasBasis_nhds_zero
      (fun n _ ↦ (D.exists_idealImage_le D' n).imp fun _ h ↦ ⟨trivial, h⟩)
      (fun m _ ↦ (D'.exists_idealImage_le D m).imp fun _ h ↦ ⟨trivial, h⟩)

omit [IsTopologicalRing B] in
variable (A B C) in
/-- Compatible pairs of definition exist when both structure maps are adic. -/
theorem nonempty [hB : IsAdicHom (algebraMap A B)]
    [hC : IsAdicHom (algebraMap A C)] : Nonempty (TensorDatum A B C) := by
  obtain ⟨P, Q, hQ, hIQ⟩ := hB.exists_pairOfDefinition
  obtain ⟨R, hR, hIR⟩ := hC.exists_pairOfDefinition_map_eq P
  exact ⟨⟨P, Q, R, hQ, hR, hIQ, hIR⟩⟩

end TensorDatum

/-! ### The tensor topology -/

variable [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]
  [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]

/-- **The tensor topology** on `B ⊗[A] C`, for adic structure maps `A → B` and `A → C`: for any
compatible pairs of definition `(A₀, I)`, `(B₀, I B₀)` and `(C₀, I C₀)`, its neighbourhoods of
zero are generated by the images of `Iⁿ F`, where `F` is the image of `B₀ ⊗[A₀] C₀`
(`TauCeti.Huber.hasBasis_tensorTopology`). It is not an instance, since `B ⊗[A] C` may carry
other topologies. -/
@[instance_reducible] noncomputable def tensorTopology : TopologicalSpace (B ⊗[A] C) :=
  (TensorDatum.nonempty A B C).some.topology

/-- The tensor topology is the topology of any tensor datum. -/
theorem tensorTopology_eq (D : TensorDatum A B C) : tensorTopology A B C = D.topology :=
  (TensorDatum.nonempty A B C).some.topology_eq D

/-- For any tensor datum, the images of the powers of its ideal of definition are a basis of
neighbourhoods of zero for the tensor topology. -/
theorem hasBasis_tensorTopology (D : TensorDatum A B C) :
    (@nhds _ (tensorTopology A B C) 0).HasBasis (fun _ : ℕ ↦ True)
      fun n ↦ (D.idealImage n : Set (B ⊗[A] C)) :=
  tensorTopology_eq A B C D ▸ D.hasBasis_nhds_zero

/-- The tensor topology is a ring topology. -/
theorem isTopologicalRing_tensorTopology : @IsTopologicalRing (B ⊗[A] C) (tensorTopology A B C) _ :=
  (TensorDatum.nonempty A B C).some.isTopologicalRing

/-- The tensor topology makes `B ⊗[A] C` a Huber ring. -/
theorem isHuberRing_tensorTopology :
    letI := tensorTopology A B C
    letI := isTopologicalRing_tensorTopology A B C
    IsHuberRing (B ⊗[A] C) :=
  (TensorDatum.nonempty A B C).some.isHuberRing

/-- The inclusion `B → B ⊗[A] C` is adic for the tensor topology. -/
theorem isAdicHom_includeLeft_tensorTopology :
    letI := tensorTopology A B C
    IsAdicHom (includeLeftRingHom : B →+* B ⊗[A] C) :=
  (TensorDatum.nonempty A B C).some.isAdicHom_includeLeft

/-- The inclusion `C → B ⊗[A] C` is adic for the tensor topology. -/
theorem isAdicHom_includeRight_tensorTopology :
    letI := tensorTopology A B C
    IsAdicHom ((includeRight : C →ₐ[A] B ⊗[A] C) : C →+* B ⊗[A] C) :=
  (TensorDatum.nonempty A B C).some.isAdicHom_includeRight

end TauCeti.Huber
