module

public import TauCeti.RingTheory.Huber.TensorProduct.Quotient
public import TauCeti.RingTheory.Huber.TensorProduct.Restricted
public import TauCeti.RingTheory.Huber.NoetherianType.TopologicallyFiniteType

import TauCeti.Topology.Maps.OpenQuotient

/-!
# Presentations of completed base changes

Let `λ : A → B` be an adic homomorphism of Huber rings, `T` a weight family on `A`, and
`σ : A⟨X⟩_T → C` an open quotient map of `A`-algebras out of the completed weighted restricted
power series, so that `C = A⟨X⟩_T / ker σ` as a topological ring. Write
`λ' : A⟨X⟩_T → B⟨X⟩_{λ(T)}` for the coefficientwise extension of `λ`. Base change of `σ` along `λ`,
read through the identification `A⟨X⟩_T ⊗̂_A B ≅ B⟨X⟩_{λ(T)}`
(`TauCeti.Huber.CompletedTensor.weightedRestrictedEquiv`), is an open quotient map

```text
B⟨X⟩_{λ(T)} → C ⊗̂_A B,    λ'(f) ↦ σ(f) ⊗ 1,    b ↦ 1 ⊗ b,
```

and its kernel is the closure of the ideal generated by `λ'(ker σ)`. Hence

```text
B⟨X⟩_{λ(T)} / closure(λ'(ker σ) · B⟨X⟩_{λ(T)}) ≅ C ⊗̂_A B
```

as topological rings. On algebraic tensors the kernel is generated by `ker σ`, by right
exactness of the tensor product; completion identifies the kernel only up to closure. When `B` is
of noetherian type and the weights are finite, every ideal of `B⟨X⟩_{λ(T)}` is closed and the
closure can be omitted.

This is the ring-level presentation of completed tensor products with algebras topologically of
finite type: it describes `C ⊗̂_A B` concretely as a quotient of restricted power series over
`B`.

## Main definitions

* `TauCeti.Huber.CompletedTensor.baseChangePresentation`: the base change
  `B⟨X⟩_{λ(T)} → C ⊗̂_A B` of a continuous `A`-algebra map `σ : A⟨X⟩_T → C`.
* `TauCeti.Huber.CompletedTensor.baseChangeQuotientEquiv`: the ring isomorphism
  `B⟨X⟩_{λ(T)} / closure(λ'(ker σ)) ≃+* C ⊗̂_A B` for an open quotient map `σ`.

## Main results

* `TauCeti.Huber.CompletedTensor.isOpenQuotientMap_baseChangePresentation`: the base change of an
  open quotient map is an open quotient map.
* `TauCeti.Huber.CompletedTensor.ker_baseChangePresentation`: its kernel is the closure of the
  ideal generated by `λ'(ker σ)`.
* `TauCeti.Huber.CompletedTensor.ker_baseChangePresentation_of_isNoetherianType`: if `B` is of
  noetherian type and the weights are finite, the kernel is the ideal generated by `λ'(ker σ)`.
* `TauCeti.Huber.CompletedTensor.isHomeomorph_baseChangeQuotientEquiv`: the quotient isomorphism
  is a homeomorphism for the quotient topology.

## References

* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217
  (1994), §3, Lemma 3.5 and the proof of Proposition 3.7.
* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.2, proof of Proposition 1.2.2.
* [T. Wedhorn, *Adic Spaces*][wedhorn_adic], §8.6, proof of Theorem 8.56.
-/

public section

open UniformSpace

namespace TauCeti.Huber.CompletedTensor

variable {k : ℕ} {A : Type*} (B : Type*) {C : Type*} [CommRing A] [TopologicalSpace A]
  [IsTopologicalRing A] [IsHuberRing A] [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
  [IsHuberRing B] [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
  [Algebra A B] [Algebra A C] [hAB : IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  {T : Fin k → Set A} {hT : IsWeightFamily T}
  {σ : Completion (weightedRestrictedSubring T hT) →+* C}
  (hσA : σ.comp (algebraMap A (Completion (weightedRestrictedSubring T hT))) = algebraMap A C)

/-- **The base change of a presentation.** For a continuous `A`-algebra map `σ : A⟨X⟩_T → C`, the
ring homomorphism `B⟨X⟩_{λ(T)} → C ⊗̂_A B` obtained by tensoring `σ` with `B` over `A` and
identifying `A⟨X⟩_T ⊗̂_A B` with `B⟨X⟩_{λ(T)}`. It sends `λ'(f)` to `σ(f) ⊗ 1` and the constant
`b` to `1 ⊗ b`. -/
noncomputable def baseChangePresentation (hσ : Continuous σ) :
    Completion (weightedRestrictedSubring (fun i ↦ algebraMap A B '' T i)
        (hAB.isWeightFamily_image hT)) →+* CompletedTensor A C B :=
  (map (RingHom.id A) σ (RingHom.id B) hσA (RingHom.id_comp _) hσ continuous_id).comp
    (weightedRestrictedEquiv B hT).symm.toRingHom

/-- The base change of a presentation is `σ ⊗ id` after `B⟨X⟩_{λ(T)} ≅ A⟨X⟩_T ⊗̂_A B`. -/
private theorem coe_baseChangePresentation (hσ : Continuous σ) :
    ⇑(baseChangePresentation B hσA hσ) =
      ⇑(map (RingHom.id A) σ (RingHom.id B) hσA (RingHom.id_comp _) hσ continuous_id) ∘
        ⇑(weightedRestrictedEquiv B hT).symm :=
  rfl

/-- The base change of a presentation sends `λ'(f)` to `σ(f) ⊗ 1`. -/
@[simp] theorem baseChangePresentation_weightedMapCompletion (hσ : Continuous σ)
    (f : Completion (weightedRestrictedSubring T hT)) :
    baseChangePresentation B hσA hσ
        (weightedMapCompletion hAB.continuous hT (hAB.isWeightFamily_image hT)
          (fun _ ↦ subset_rfl) f) =
      inl A C B (σ f) := by
  rw [coe_baseChangePresentation, Function.comp_apply, ← weightedRestrictedEquiv_inl B hT,
    RingEquiv.symm_apply_apply, map_inl]

/-- The base change of a presentation sends the constant `b` to `1 ⊗ b`. -/
@[simp] theorem baseChangePresentation_weightedC (hσ : Continuous σ) (b : B) :
    baseChangePresentation B hσA hσ
        (weightedC _ (hAB.isWeightFamily_image hT) b :
          weightedRestrictedSubring (fun i ↦ algebraMap A B '' T i)
            (hAB.isWeightFamily_image hT)) =
      inr A C B b := by
  rw [coe_baseChangePresentation, Function.comp_apply, weightedRestrictedEquiv_symm_weightedC,
    map_inr, RingHom.id_apply]

/-- The base change of a presentation is continuous. -/
@[fun_prop] theorem continuous_baseChangePresentation (hσ : Continuous σ) :
    Continuous (baseChangePresentation B hσA hσ) := by
  rw [coe_baseChangePresentation]
  exact (continuous_map (RingHom.id A) σ (RingHom.id B) hσA (RingHom.id_comp _) hσ
    continuous_id).comp (continuous_weightedRestrictedEquiv_symm B hT)

/-- **The base change of an open quotient map out of `A⟨X⟩_T` is an open quotient map**
`B⟨X⟩_{λ(T)} → C ⊗̂_A B`. -/
theorem isOpenQuotientMap_baseChangePresentation (hσ : IsOpenQuotientMap σ) :
    IsOpenQuotientMap (baseChangePresentation B hσA hσ.continuous) := by
  rw [coe_baseChangePresentation]
  exact (isOpenQuotientMap_map hσA (RingHom.id_comp _) hσ .id).comp
    (isHomeomorph_weightedRestrictedEquiv_symm B hT).isOpenQuotientMap

/-- **The kernel of the base change of a presentation** `σ : A⟨X⟩_T → C` is the closure of the
ideal of `B⟨X⟩_{λ(T)}` generated by `λ'(ker σ)`. -/
theorem ker_baseChangePresentation (hσ : IsOpenQuotientMap σ) :
    RingHom.ker (baseChangePresentation B hσA hσ.continuous) =
      ((RingHom.ker σ).map (weightedMapCompletion hAB.continuous hT
        (hAB.isWeightFamily_image hT) fun _ ↦ subset_rfl)).closure := by
  -- the kernel of `σ ⊗ id` is the closure of the ideal generated by the left image of `ker σ`
  have hker := ker_map hσA (RingHom.id_comp (algebraMap A B)) hσ .id
  rw [(RingHom.injective_iff_ker_eq_bot (RingHom.id B)).mp Function.injective_id, Ideal.map_bot,
    sup_bot_eq] at hker
  -- transport it along the homeomorphic isomorphism `A⟨X⟩_T ⊗̂_A B ≅ B⟨X⟩_{λ(T)}`
  have hinl : (weightedRestrictedEquiv B hT).toRingHom.comp
      (inl A (Completion (weightedRestrictedSubring T hT)) B) =
      weightedMapCompletion hAB.continuous hT (hAB.isWeightFamily_image hT) fun _ ↦ subset_rfl :=
    RingHom.ext fun f ↦ weightedRestrictedEquiv_inl B hT f
  have hcomap : RingHom.ker (baseChangePresentation B hσA hσ.continuous) =
      (RingHom.ker (map (RingHom.id A) σ (RingHom.id B) hσA (RingHom.id_comp _) hσ.continuous
        continuous_id)).comap (weightedRestrictedEquiv B hT).symm :=
    Ideal.ext fun x ↦ by rw [RingHom.mem_ker, Ideal.mem_comap, RingHom.mem_ker,
      coe_baseChangePresentation, Function.comp_apply]
  have he := isHomeomorph_weightedRestrictedEquiv_symm B hT
  apply SetLike.coe_injective
  rw [hcomap, hker, ← hinl, ← Ideal.map_map, RingEquiv.toRingHom_eq_coe, Ideal.map_comap_of_equiv]
  simp only [Ideal.coe_comap, Ideal.coe_closure]
  exact he.isOpenMap.preimage_closure_eq_closure_preimage he.continuous _

/-- **Noetherian type removes the closure.** If `B` is of noetherian type and the weights are
finite, the kernel of the base change of a presentation `σ : A⟨X⟩_T → C` is the ideal of
`B⟨X⟩_{λ(T)}` generated by `λ'(ker σ)`: `B⟨X⟩_{λ(T)}` is topologically of finite type over `B`,
hence a complete Hausdorff Huber ring of noetherian type, all of whose ideals are closed. -/
theorem ker_baseChangePresentation_of_isNoetherianType [IsNoetherianType B]
    (hTfin : ∀ i, (T i).Finite) (hσ : IsOpenQuotientMap σ) :
    RingHom.ker (baseChangePresentation B hσA hσ.continuous) =
      (RingHom.ker σ).map (weightedMapCompletion hAB.continuous hT
        (hAB.isWeightFamily_image hT) fun _ ↦ subset_rfl) := by
  have hB : IsTopologicallyFiniteType (algebraMap B (Completion (weightedRestrictedSubring
      (fun i ↦ algebraMap A B '' T i) (hAB.isWeightFamily_image hT)))) :=
    isTopologicallyFiniteType_iff.mpr ⟨k, _, fun i ↦ (hTfin i).image _, _, RingHom.id _, .id,
      RingHom.id_comp _⟩
  have := IsNoetherianType.of_isTopologicallyFiniteType hB
  rw [ker_baseChangePresentation B hσA hσ]
  exact Ideal.closure_eq_of_isClosed _ (IsNoetherianType.isClosed_ideal _)

/-- **The completed base change as a quotient of restricted power series.** For an open quotient
map `σ : A⟨X⟩_T → C` of `A`-algebras, `C ⊗̂_A B` is the quotient of `B⟨X⟩_{λ(T)}` by the closure
of the ideal generated by `λ'(ker σ)`. The isomorphism is induced by the base change of `σ`
(`TauCeti.Huber.CompletedTensor.baseChangeQuotientEquiv_mk`), and it is a homeomorphism for the
quotient topology (`TauCeti.Huber.CompletedTensor.isHomeomorph_baseChangeQuotientEquiv`). -/
noncomputable def baseChangeQuotientEquiv (hσ : IsOpenQuotientMap σ) :
    Completion (weightedRestrictedSubring (fun i ↦ algebraMap A B '' T i)
        (hAB.isWeightFamily_image hT)) ⧸
      ((RingHom.ker σ).map (weightedMapCompletion hAB.continuous hT
        (hAB.isWeightFamily_image hT) fun _ ↦ subset_rfl)).closure ≃+*
      CompletedTensor A C B :=
  (Ideal.quotEquivOfEq (ker_baseChangePresentation B hσA hσ).symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (isOpenQuotientMap_baseChangePresentation B hσA hσ).surjective)

/-- The quotient isomorphism sends the class of `x` to its image under the base change of the
presentation. -/
@[simp] theorem baseChangeQuotientEquiv_mk (hσ : IsOpenQuotientMap σ)
    (x : Completion (weightedRestrictedSubring (fun i ↦ algebraMap A B '' T i)
      (hAB.isWeightFamily_image hT))) :
    baseChangeQuotientEquiv B hσA hσ (Ideal.Quotient.mk _ x) =
      baseChangePresentation B hσA hσ.continuous x := by
  simp [baseChangeQuotientEquiv]

/-- The inverse of the quotient isomorphism sends `σ(f) ⊗ 1` to the class of `λ'(f)`. -/
@[simp] theorem baseChangeQuotientEquiv_symm_inl (hσ : IsOpenQuotientMap σ)
    (f : Completion (weightedRestrictedSubring T hT)) :
    (baseChangeQuotientEquiv B hσA hσ).symm (inl A C B (σ f)) =
      Ideal.Quotient.mk _ (weightedMapCompletion hAB.continuous hT
        (hAB.isWeightFamily_image hT) (fun _ ↦ subset_rfl) f) := by
  rw [RingEquiv.symm_apply_eq, baseChangeQuotientEquiv_mk,
    baseChangePresentation_weightedMapCompletion]

/-- The inverse of the quotient isomorphism sends `1 ⊗ b` to the class of the constant `b`. -/
@[simp] theorem baseChangeQuotientEquiv_symm_inr (hσ : IsOpenQuotientMap σ) (b : B) :
    (baseChangeQuotientEquiv B hσA hσ).symm (inr A C B b) =
      Ideal.Quotient.mk _ ((weightedC _ (hAB.isWeightFamily_image hT) b :
        weightedRestrictedSubring (fun i ↦ algebraMap A B '' T i) (hAB.isWeightFamily_image hT)) :
          Completion (weightedRestrictedSubring (fun i ↦ algebraMap A B '' T i)
            (hAB.isWeightFamily_image hT))) := by
  rw [RingEquiv.symm_apply_eq, baseChangeQuotientEquiv_mk, baseChangePresentation_weightedC]

/-- **The quotient isomorphism is a homeomorphism** for the quotient topology on
`B⟨X⟩_{λ(T)} / closure(λ'(ker σ))`, because it factors the open quotient map
`B⟨X⟩_{λ(T)} → C ⊗̂_A B` through the quotient map. -/
theorem isHomeomorph_baseChangeQuotientEquiv (hσ : IsOpenQuotientMap σ) :
    IsHomeomorph (baseChangeQuotientEquiv B hσA hσ) := by
  have hcomp : ⇑(baseChangeQuotientEquiv B hσA hσ) ∘ Ideal.Quotient.mk _ =
      baseChangePresentation B hσA hσ.continuous :=
    funext (baseChangeQuotientEquiv_mk B hσA hσ)
  have hq := (QuotientRing.isOpenQuotientMap_mk _).of_comp_iff.mp
    (hcomp ▸ isOpenQuotientMap_baseChangePresentation B hσA hσ)
  exact isHomeomorph_iff_isQuotientMap_injective.mpr
    ⟨hq.isQuotientMap, (baseChangeQuotientEquiv B hσA hσ).injective⟩

end TauCeti.Huber.CompletedTensor
