module

public import TauCeti.RingTheory.Huber.TensorProduct.Pair

/-!
# Plus rings of completed tensor products

The plus ring of a completed tensor product is the closure of the integral closure of the
subring generated by the two factor plus rings, taken inside the completed tensor ring.
This agrees with the construction using integral closure before completion. In particular,
enlarging either factor plus ring enlarges the tensor plus ring, without changing the
underlying topological ring. No completeness or sheafiness assumption on the inputs is needed.

## References

* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, §3,
  proof of Lemma 3.9(i).
* K. S. Kedlaya and R. Liu, *Relative p-adic Hodge theory: foundations*, §2.4,
  Definition 2.4.1 and (2.4.3.1).
-/

public section

open TensorProduct Algebra.TensorProduct

namespace TauCeti.Huber.Pair.completedTensor

variable {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]
  [Algebra A B] [Algebra A C]
  [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]
  [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]
  [IsHuberRing B] [IsHuberRing C]
  [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]

/-- The tensor plus ring is also obtained by taking integral closure inside the completed
tensor ring and then topological closure. -/
theorem plus_eq_closure_integralClosure (S : Pair B) (T : Pair C) :
    (S.completedTensor A T).plus =
      (integralClosure
        (S.plus.map (CompletedTensor.inl A B C) ⊔ T.plus.map (CompletedTensor.inr A B C) :
          Subring (CompletedTensor A B C))
        (CompletedTensor A B C)).toSubring.topologicalClosure := by
  let Q : Subring (B ⊗[A] C) :=
    S.plus.map includeLeftRingHom ⊔ T.plus.map (includeRight : C →ₐ[A] B ⊗[A] C).toRingHom
  let R : Subring (CompletedTensor A B C) :=
    S.plus.map (CompletedTensor.inl A B C) ⊔ T.plus.map (CompletedTensor.inr A B C)
  have hQR : Q ≤ R.comap (CompletedTensor.toCompletion A B C) := by
    refine sup_le (Subring.map_le_iff_le_comap.mpr fun b hb ↦ ?_)
      (Subring.map_le_iff_le_comap.mpr fun c hc ↦ ?_)
    · exact (le_sup_left : S.plus.map _ ≤ R) ⟨b, hb, by simp⟩
    · exact (le_sup_right : T.plus.map _ ≤ R) ⟨c, hc, by simp⟩
  apply le_antisymm
  · rw [plus_eq]
    apply Subring.topologicalClosure_mono
    rintro _ ⟨x, hx, rfl⟩
    exact (mem_integralClosure_iff _ _).mpr <|
      ((mem_integralClosure_iff _ _).mp hx).map_of_comp_eq
        ((CompletedTensor.toCompletion A B C).restrict Q R hQR)
        (CompletedTensor.toCompletion A B C) rfl
  · have := (S.completedTensor A T).isRingOfIntegralElements.isIntegrallyClosedIn
    apply Subring.topologicalClosure_minimal _ _
      ((S.completedTensor A T).plus.toAddSubgroup.isClosed_of_isOpen
        (S.completedTensor A T).isRingOfIntegralElements.isOpen)
    apply Subring.integralClosure_subring_le_iff.mpr
    exact sup_le
      (Subring.map_le_iff_le_comap.mpr fun _ hb ↦ S.inl_mem_completedTensor_plus T hb)
      (Subring.map_le_iff_le_comap.mpr fun _ hc ↦ S.inr_mem_completedTensor_plus T hc)

/-- Enlarging the plus rings of the factors enlarges the completed tensor plus ring. -/
theorem plus_mono {S S' : Pair B} {T T' : Pair C}
    (hS : S.plus ≤ S'.plus) (hT : T.plus ≤ T'.plus) :
    (S.completedTensor A T).plus ≤ (S'.completedTensor A T').plus := by
  have := (S'.completedTensor A T').isRingOfIntegralElements.isIntegrallyClosedIn
  exact S.completedTensor_plus_le_comap T
    ((S'.completedTensor A T').plus.toAddSubgroup.isClosed_of_isOpen
      (S'.completedTensor A T').isRingOfIntegralElements.isOpen)
    (f := RingHom.id _) continuous_id
    (fun _ hb ↦ S'.inl_mem_completedTensor_plus T' (hS hb))
    (fun _ hc ↦ S'.inr_mem_completedTensor_plus T' (hT hc))

end TauCeti.Huber.Pair.completedTensor
