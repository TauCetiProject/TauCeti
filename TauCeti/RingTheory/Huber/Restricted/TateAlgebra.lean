module

public import TauCeti.RingTheory.Huber.Restricted.GaussNorm
public import TauCeti.RingTheory.KrullDimension.Basic
public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.Jacobson
public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.KrullDimension
public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.MaximalIdeal
public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.Regular
public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.UniqueFactorization

/-!
# Algebraic structure of the completed Tate algebras

Over a complete nonarchimedean field `K`, the completed Huber algebra
`K⟨X₁, …, Xₙ⟩ = TauCeti.Huber.restrictedMvPowerSeriesCompletion n K` is identified with the
Gauss-normed ring of unit-radius restricted series by the topological algebra isomorphism
`TauCeti.Huber.restrictedMvPowerSeriesCompletionGaussAlgEquiv`. This file transports the
ring-theoretic structure theorems for Tate algebras, proved on the Gauss-normed carrier, to the
completed Huber carrier, which is the ring that adic spaces, rational localisations and the
strong noetherianness of `K` are stated over. Noetherianity itself is transported in
`TauCeti.RingTheory.Huber.Restricted.Noetherian`.

The polynomial algebra `K[X₁, …, Xₙ]` maps into the completion through the Huber inclusion
`TauCeti.Huber.weightedPolynomialHom` followed by the completion map; under the comparison this
is the Gauss-normed polynomial inclusion
(`TauCeti.Huber.restrictedMvPowerSeriesCompletionGaussEquiv_comp_weightedPolynomialHom`).

## Main results

* `TauCeti.Huber.uniqueFactorizationMonoid_restrictedMvPowerSeriesCompletion`: the completed
  Tate algebra is a unique factorisation domain, hence integrally closed.
* `TauCeti.Huber.isJacobsonRing_restrictedMvPowerSeriesCompletion`: it is a Jacobson ring.
* `TauCeti.Huber.ringKrullDim_restrictedMvPowerSeriesCompletion`: it has Krull dimension `n`.
* `TauCeti.Huber.isRegularRing_restrictedMvPowerSeriesCompletion`: it is a regular ring.
* `TauCeti.Huber.height_eq_of_isMaximal_restrictedMvPowerSeriesCompletion` and
  `TauCeti.Huber.spanFinrank_eq_of_isMaximal_restrictedMvPowerSeriesCompletion`: every maximal
  ideal has height `n` and is minimally generated by `n` elements.
* `TauCeti.Huber.finite_quotient_of_isMaximal_restrictedMvPowerSeriesCompletion`: every residue
  field is a finite extension of `K`.
* `TauCeti.Huber.isMaximal_comap_polynomial_restrictedMvPowerSeriesCompletion` and
  `TauCeti.Huber.map_comap_polynomial_of_isMaximal_restrictedMvPowerSeriesCompletion`: over a
  nontrivially normed field, the polynomials in a maximal ideal form a maximal ideal of
  `K[X₁, …, Xₙ]` and generate the maximal ideal.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §§5.2.5–5.2.6,
  6.1.2 and 7.1.1.
* T. Wedhorn, *Adic Spaces*, §5.6, for the completed restricted-series algebra.
-/

public section

namespace TauCeti.Huber

open UniformSpace

section Polynomial

variable {n : ℕ} {R : Type*} [NormedCommRing R] [IsUltrametricDist R] [NonarchimedeanRing R]
  [CompleteSpace R]

/-- Under the completed Gauss comparison, the polynomials in the completed Huber algebra are the
Gauss-normed polynomial inclusion. -/
theorem restrictedMvPowerSeriesCompletionGaussEquiv_comp_weightedPolynomialHom :
    (restrictedMvPowerSeriesCompletionGaussEquiv (n := n) (R := R)).toRingHom.comp
        (Completion.coeRingHom.comp (weightedPolynomialHom _ isWeightFamily_one_weight)) =
      (TauCeti.MvPowerSeries.polynomialToRestricted (R := R) fun _ : Fin n ↦ (1 : ℝ)).toRingHom :=
  RingHom.ext fun p ↦ by simp [Completion.coeRingHom]

/-- The polynomials in the completed Huber algebra are the image of the Gauss-normed polynomials
under the inverse comparison. -/
private theorem coeRingHom_comp_weightedPolynomialHom :
    Completion.coeRingHom.comp (weightedPolynomialHom (k := n) (A := R) _
        isWeightFamily_one_weight) =
      (restrictedMvPowerSeriesCompletionGaussEquiv (n := n) (R := R)).symm.toRingHom.comp
        (TauCeti.MvPowerSeries.polynomialToRestricted (R := R)
          fun _ : Fin n ↦ (1 : ℝ)).toRingHom := by
  rw [← restrictedMvPowerSeriesCompletionGaussEquiv_comp_weightedPolynomialHom,
    ← RingHom.comp_assoc, RingEquiv.symm_toRingHom_comp_toRingHom, RingHom.id_comp]

end Polynomial

variable {K : Type*} [NormedField K] [IsUltrametricDist K] [NonarchimedeanRing K]
  [CompleteSpace K] {n : ℕ}

/-- The completed Tate algebra over a complete nonarchimedean field is a domain. -/
instance isDomain_restrictedMvPowerSeriesCompletion :
    IsDomain (restrictedMvPowerSeriesCompletion n K) :=
  restrictedMvPowerSeriesCompletionGaussEquiv.toMulEquiv.isDomain _

/-- **The completed Tate algebra is a unique factorisation domain** over a complete nonarchimedean
field. By `UniqueFactorizationMonoid.instIsIntegrallyClosed` it is therefore integrally
closed. -/
instance uniqueFactorizationMonoid_restrictedMvPowerSeriesCompletion :
    UniqueFactorizationMonoid (restrictedMvPowerSeriesCompletion n K) :=
  restrictedMvPowerSeriesCompletionGaussEquiv.symm.toMulEquiv.uniqueFactorizationMonoid
    inferInstance

/-- **The completed Tate algebra is a Jacobson ring** over a complete nonarchimedean field: every
prime ideal is an intersection of maximal ideals. -/
instance isJacobsonRing_restrictedMvPowerSeriesCompletion :
    IsJacobsonRing (restrictedMvPowerSeriesCompletion n K) :=
  (isJacobsonRing_iso restrictedMvPowerSeriesCompletionGaussEquiv).mpr inferInstance

/-- **The completed Tate algebra in `n` variables has Krull dimension `n`** over a complete
nonarchimedean field. -/
@[simp]
theorem ringKrullDim_restrictedMvPowerSeriesCompletion :
    ringKrullDim (restrictedMvPowerSeriesCompletion n K) = n := by
  rw [ringKrullDim_eq_of_ringEquiv restrictedMvPowerSeriesCompletionGaussEquiv,
    TauCeti.MvPowerSeries.ringKrullDim_isRestricted_subring, Nat.card_fin]

/-- The completed Tate algebra has finite Krull dimension. -/
instance finiteRingKrullDim_restrictedMvPowerSeriesCompletion :
    FiniteRingKrullDim (restrictedMvPowerSeriesCompletion n K) :=
  .of_ringKrullDim_eq_natCast ringKrullDim_restrictedMvPowerSeriesCompletion

/-- **The completed Tate algebra is a regular ring** over a complete nonarchimedean field: its
localisation at every prime ideal is a regular local ring. -/
instance isRegularRing_restrictedMvPowerSeriesCompletion :
    IsRegularRing (restrictedMvPowerSeriesCompletion n K) :=
  .of_ringEquiv restrictedMvPowerSeriesCompletionGaussEquiv.symm

section Maximal

variable (m : Ideal (restrictedMvPowerSeriesCompletion n K)) [m.IsMaximal]

/-- A maximal ideal of the completed Tate algebra contracts to a maximal ideal of the Gauss-normed
carrier. -/
private theorem isMaximal_comap_symm :
    (m.comap (restrictedMvPowerSeriesCompletionGaussEquiv (n := n) (R := K)).symm).IsMaximal :=
  Ideal.comap_isMaximal_of_surjective _ (RingEquiv.surjective _)

/-- **Every maximal ideal of the completed Tate algebra in `n` variables has height `n`** over a
complete nonarchimedean field. -/
@[simp]
theorem height_eq_of_isMaximal_restrictedMvPowerSeriesCompletion : m.height = n := by
  have := isMaximal_comap_symm m
  rw [← RingEquiv.height_comap (restrictedMvPowerSeriesCompletionGaussEquiv (n := n) (R := K)).symm,
    Ideal.height_eq_natCard_of_isMaximal_isRestricted_subring, Nat.card_fin]

/-- **Every maximal ideal of the completed Tate algebra in `n` variables is generated by `n`
elements**, and by no fewer, over a complete nonarchimedean field. -/
@[simp]
theorem spanFinrank_eq_of_isMaximal_restrictedMvPowerSeriesCompletion : m.spanFinrank = n := by
  have := isMaximal_comap_symm m
  rw [← Ideal.map_comap_of_surjective _
      (restrictedMvPowerSeriesCompletionGaussEquiv (n := n) (R := K)).symm.surjective m,
    Ideal.spanFinrank_map_eq_of_ringEquiv,
    Ideal.spanFinrank_eq_natCard_of_isMaximal_isRestricted_subring, Nat.card_fin]

/-- **The Nullstellensatz for the completed Tate algebra.** Over a complete nonarchimedean field
`K`, the residue field of every maximal ideal of `K⟨X₁, …, Xₙ⟩` is a finite extension of `K`. -/
theorem finite_quotient_of_isMaximal_restrictedMvPowerSeriesCompletion :
    Module.Finite K (restrictedMvPowerSeriesCompletion n K ⧸ m) :=
  TauCeti.MvPowerSeries.finite_quotient_of_surjective
    (φ := (restrictedMvPowerSeriesCompletionGaussAlgEquiv (n := n) (R := K)).symm.toAlgHom)
    restrictedMvPowerSeriesCompletionGaussAlgEquiv.symm.surjective m

end Maximal

section NontriviallyNormedField

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [NonarchimedeanRing K]
  [CompleteSpace K] {n : ℕ} (m : Ideal (restrictedMvPowerSeriesCompletion n K)) [m.IsMaximal]

/-- The polynomials in a maximal ideal `m` of the completed Tate algebra `K⟨X₁, …, Xₙ⟩` form a
maximal ideal of `K[X₁, …, Xₙ]`. -/
theorem isMaximal_comap_polynomial_restrictedMvPowerSeriesCompletion :
    (m.comap (Completion.coeRingHom.comp
      (weightedPolynomialHom _ isWeightFamily_one_weight))).IsMaximal := by
  have := isMaximal_comap_symm m
  rw [coeRingHom_comp_weightedPolynomialHom, ← Ideal.comap_comap]
  simpa only [AlgHom.toRingHom_eq_coe, RingEquiv.toRingHom_eq_coe, Ideal.comap_coe] using
    Ideal.isMaximal_comap_polynomialToRestricted _

/-- **Maximal ideals of the completed Tate algebra are generated by polynomials.** Every maximal
ideal `m` of `K⟨X₁, …, Xₙ⟩` is generated by the polynomials it contains. -/
theorem map_comap_polynomial_of_isMaximal_restrictedMvPowerSeriesCompletion :
    (m.comap (Completion.coeRingHom.comp
      (weightedPolynomialHom _ isWeightFamily_one_weight))).map
        (Completion.coeRingHom.comp (weightedPolynomialHom _ isWeightFamily_one_weight)) = m := by
  have := isMaximal_comap_symm m
  rw [coeRingHom_comp_weightedPolynomialHom, ← Ideal.comap_comap, ← Ideal.map_map]
  simp only [AlgHom.toRingHom_eq_coe, RingEquiv.toRingHom_eq_coe, Ideal.comap_coe, Ideal.map_coe,
    Ideal.map_comap_polynomialToRestricted_of_isMaximal]
  exact Ideal.map_comap_of_surjective _ (RingEquiv.surjective _) m

end NontriviallyNormedField

end TauCeti.Huber
