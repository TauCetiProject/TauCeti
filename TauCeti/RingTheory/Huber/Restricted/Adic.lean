module

public import TauCeti.RingTheory.AdicRing.Basic
public import TauCeti.RingTheory.Huber.Completion.Noetherian
public import TauCeti.RingTheory.Huber.WeightedRestrictedSeries.PairOfDefinition
public import TauCeti.RingTheory.Huber.StronglyNoetherian

import TauCeti.RingTheory.AdicCompletion.Noetherian

/-!
# Restricted power series over adic rings

For a finitely generated ideal `I` defining the topology of `A`, the restricted-series
ring `A⟨X₁, …, Xₙ⟩` has the adic topology of the ideal generated by the constant series
from `I`. The same holds after separated completion. In particular, the completed
restricted-series algebra is an adic ring of finite ideal type.

If `A` is noetherian, these completed algebras are noetherian, so `A` is strongly
noetherian. This supplies noetherian coordinate rings for affine formal spaces and for
quotients presenting topologically finite type adic algebras. No field, Tate, or
completeness hypothesis on `A` is needed for the noetherianity theorem.

The argument uses the coefficient decomposition in
`TauCeti.Huber.PairOfDefinition.weightedIdeal_one_pow` to identify the adic topology,
and `Ideal.isNoetherianRing_of_isAdicComplete_of_denseRange` to pass from the dense
polynomial subring to the completion.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique I*, Ch. 0,
  §7.5.1 and Proposition 7.5.4(ii).
* T. Wedhorn, *Adic Spaces*, §5.6, for the weighted restricted-series construction.
-/

public section

open Topology UniformSpace

namespace TauCeti.Huber

section AdicTopology

variable {A : Type*} [CommRing A] [TopologicalSpace A]
  [NonarchimedeanRing A] {I : Ideal A} (n : ℕ)

/-- Restricted power series over an `I`-adic ring have the adic topology of the extended
ideal `I`, provided `I` is finitely generated. -/
theorem isAdic_map_algebraMap_weightedRestrictedSubring_one_weight
    (hI : IsAdic I) (hfg : I.FG) :
    IsAdic (I.map (algebraMap A
      (weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A))
        isWeightFamily_one_weight))) := by
  let S := weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight
  let P := PairOfDefinition.adic I hI hfg
  let Q := P.weighted (k := n) isWeightFamily_one_weight
  have htop : Q.ringOfDefinition = ⊤ := by
    ext f
    simp [Q, PairOfDefinition.weightedRingOfDefinition_def, P,
      PairOfDefinition.adic_ringOfDefinition, mem_weightedNhd, weightMul_one_weight]
  have hsurj : Function.Surjective Q.ringOfDefinition.subtype := by
    intro f
    exact ⟨⟨f, htop ▸ Subring.mem_top f⟩, rfl⟩
  have hpow (m : ℕ) :
      ((Q.extendedIdealOfDefinition ^ m : Ideal S) : Set S) = (Q.idealImage m : Set S) := by
    ext f
    simp only [SetLike.mem_coe]
    rw [PairOfDefinition.extendedIdealOfDefinition_def, ← Ideal.map_pow,
      Ideal.mem_map_iff_of_surjective _ hsurj, Q.mem_idealImage]
    rfl
  have hadic : IsAdic Q.extendedIdealOfDefinition := by
    refine isAdic_iff.mpr ⟨fun m ↦ ?_, fun s hs ↦ ?_⟩
    · rw [hpow]
      exact Q.isOpen_idealImage m
    · obtain ⟨m, -, hm⟩ := Q.hasBasis_nhds_zero.mem_iff.mp hs
      exact ⟨m, (hpow m).symm ▸ hm⟩
  rw [PairOfDefinition.weighted_extendedIdealOfDefinition,
    PairOfDefinition.adic_extendedIdealOfDefinition] at hadic
  exact hadic

/-- The separated completion of restricted power series over an `I`-adic ring has the
adic topology of the extended ideal `I`, for finitely generated `I`. -/
theorem isAdic_map_algebraMap_restrictedMvPowerSeriesCompletion
    (hI : IsAdic I) (hfg : I.FG) :
    IsAdic (I.map (algebraMap A (restrictedMvPowerSeriesCompletion n A))) := by
  have h := (isAdic_map_algebraMap_weightedRestrictedSubring_one_weight n hI hfg).map_coeRingHom
    (hfg.map _)
  rw [Ideal.map_map] at h
  exact h

/-- Completed restricted power series over a noetherian adic ring are noetherian.
The coefficient ring need not be complete. -/
theorem isNoetherianRing_restrictedMvPowerSeriesCompletion_of_isAdic
    [IsNoetherianRing A] (hI : IsAdic I) :
    IsNoetherianRing (restrictedMvPowerSeriesCompletion n A) := by
  let S := weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight
  let P := weightedPolynomials (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight
  let J := I.map (algebraMap A (restrictedMvPowerSeriesCompletion n A))
  have hJ : IsAdic J := isAdic_map_algebraMap_restrictedMvPowerSeriesCompletion n hI
    (IsNoetherian.noetherian I)
  have : IsAdicComplete J (restrictedMvPowerSeriesCompletion n A) :=
    hJ.isAdicComplete_iff.mpr ⟨inferInstance, inferInstance⟩
  have : IsNoetherianRing P :=
    isNoetherianRing_of_ringEquiv _ (weightedPolynomialsEquiv isWeightFamily_one_weight)
  have hdense : DenseRange ((Completion.coeRingHom : S →+* Completion S).comp P.subtype) :=
    Completion.denseRange_coe.comp
      (dense_weightedPolynomials isWeightFamily_one_weight).denseRange_val
      (Completion.continuous_coe _)
  exact Ideal.isNoetherianRing_of_isAdicComplete_of_denseRange (I := J)
    (Ideal.FG.map (IsNoetherian.noetherian I) _)
    (by simpa only [pow_one] using hJ.isOpen_pow 1) hdense

end AdicTopology

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] (n : ℕ)

/-- Completed restricted power series over an adic ring form an adic ring of finite
ideal type. -/
instance isAdicRing_restrictedMvPowerSeriesCompletion [IsAdicRing A] :
    IsAdicRing (restrictedMvPowerSeriesCompletion n A) := by
  obtain ⟨hfg, hI, -⟩ := IsAdicRing.ideal_spec A
  let J := (IsAdicRing.ideal A).map (algebraMap A (restrictedMvPowerSeriesCompletion n A))
  have hJ : IsAdic J := isAdic_map_algebraMap_restrictedMvPowerSeriesCompletion n hI hfg
  exact ⟨J, hfg.map _, hJ, hJ.isAdicComplete_iff.mpr ⟨inferInstance, inferInstance⟩⟩

/-- Every noetherian adic ring of finite ideal type is strongly noetherian. -/
instance IsStronglyNoetherian.of_isAdicRing [IsAdicRing A] [IsNoetherianRing A] :
    IsStronglyNoetherian A :=
  ⟨fun n ↦ isNoetherianRing_restrictedMvPowerSeriesCompletion_of_isAdic n
    (IsAdicRing.ideal_spec A).2.1⟩

end TauCeti.Huber
