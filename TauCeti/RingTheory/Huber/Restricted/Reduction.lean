/-!
# Polynomial reductions of adic restricted power series

Reduction of restricted power series modulo an open ideal is polynomial, both on the uncompleted
subring (`Ideal.restrictedReduction`) and on the separated completion `A⟨X₁, …, Xₖ⟩`
(`Ideal.restrictedReductionCompletion`), with no completeness or separation hypothesis on `A`.
For a finitely generated ideal of definition `I`, the kernel on either carrier is the extended
ideal generated by `I`. Consequently `A⟨X⟩ ⧸ (I · A⟨X⟩) ^ m ≃ₐ[A] (A ⧸ I ^ m)[X]` for every
nonzero `m`, compatibly with the transition maps `Ideal.Quotient.factorPow` of the infinitesimal
thickenings of affine formal space.

Reduction commutes with continuous coefficient maps (`restrictedReduction_weightedMap`,
`restrictedReductionCompletion_weightedMapCompletion`) without any flatness or completeness
hypothesis, and with continuous series evaluation (`mk_weightedEvalHom_eq_eval₂_restrictedReduction`
and `mk_weightedEvalHomCompletion_eq_eval₂_restrictedReductionCompletion`).

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique I*, Ch. 0, §7.5.1–7.5.3.
* T. Wedhorn, *Adic Spaces*, arXiv:1910.05934v1, §5.6, Proposition 5.50.
-/

public section

open Topology

variable {A : Type*} [CommRing A] [TopologicalSpace A] [NonarchimedeanRing A]
  {k : ℕ} {I : Ideal A}

namespace TauCeti.Huber

/-- Membership in the extension of a finitely generated ideal of definition to restricted
series is coefficientwise. -/
theorem mem_map_weightedC_iff_of_isAdic (hI : IsAdic I) (hfg : I.FG)
    (f : weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A))
      isWeightFamily_one_weight) :
    f ∈ I.map (weightedC _ isWeightFamily_one_weight) ↔
      ∀ ν, MvPowerSeries.coeff ν (f : MvPowerSeries (Fin k) A) ∈ I := by
  constructor
  · exact fun hf ↦ Ideal.coeff_mem_of_mem_map_weightedC hf
  · intro hf
    let P := PairOfDefinition.adic I hI hfg
    let Q := P.weighted (k := k) isWeightFamily_one_weight
    have htop : Q.ringOfDefinition = ⊤ :=
      P.weighted_ringOfDefinition_one_weight_eq_top
        (PairOfDefinition.adic_ringOfDefinition I hI hfg)
    let g : Q.ringOfDefinition := ⟨f, htop ▸ Subring.mem_top f⟩
    have hg : g ∈ Q.idealOfDefinition := by
      rw [PairOfDefinition.mem_weighted_idealOfDefinition]
      simpa [PairOfDefinition.mem_weightedIdeal, mem_weightedNhd,
        weightMul_one_weight, P, g] using hf
    have hext := P.weighted_extendedIdealOfDefinition (k := k) isWeightFamily_one_weight
    rw [PairOfDefinition.adic_extendedIdealOfDefinition,
      algebraMap_weightedRestrictedSubring] at hext
    rw [← hext, PairOfDefinition.extendedIdealOfDefinition_def]
    exact Ideal.mem_map_of_mem _ hg

end TauCeti.Huber

namespace Ideal

open TauCeti.Huber

/-- Reduction of restricted series modulo an open ideal is polynomial, since only finitely
many coefficients survive. -/
noncomputable def restrictedReduction (J : Ideal A) (hJ : IsOpen (J : Set A)) :
    weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight →+*
      MvPolynomial (Fin k) (A ⧸ J) := by
  letI : DiscreteTopology (A ⧸ J) := Submodule.Quotient.discreteTopology_of_isOpen J hJ
  exact (weightedPolynomialEquivOfDiscrete (fun _ : Fin k ↦ ({1} : Set (A ⧸ J)))
    isWeightFamily_one_weight).symm.toRingHom.comp
      (weightedMap (φ := Ideal.Quotient.mk J) (QuotientRing.isOpenQuotientMap_mk J).continuous
        isWeightFamily_one_weight isWeightFamily_one_weight (by simp))

/-- Polynomial reduction reduces each coefficient modulo the given ideal. -/
@[simp]
theorem coeff_restrictedReduction (J : Ideal A) (hJ : IsOpen (J : Set A))
    (f : weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A))
      isWeightFamily_one_weight) (ν : Fin k →₀ ℕ) :
    (restrictedReduction J hJ f).coeff ν =
      Ideal.Quotient.mk J (MvPowerSeries.coeff ν (f : MvPowerSeries (Fin k) A)) := by
  let : DiscreteTopology (A ⧸ J) := Submodule.Quotient.discreteTopology_of_isOpen J hJ
  dsimp only [restrictedReduction, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
    RingEquiv.coe_toRingHom]
  rw [coeff_weightedPolynomialEquivOfDiscrete_symm]
  simp

/-- On polynomials, reduction of restricted series is the usual coefficient map. -/
@[simp]
theorem restrictedReduction_weightedPolynomialHom (J : Ideal A) (hJ : IsOpen (J : Set A))
    (p : MvPolynomial (Fin k) A) :
    restrictedReduction J hJ (weightedPolynomialHom _ isWeightFamily_one_weight p) =
      MvPolynomial.map (Ideal.Quotient.mk J) p := by
  ext ν
  simp [MvPolynomial.coeff_map]

/-- Reduction sends a constant series to the corresponding constant polynomial. -/
@[simp]
theorem restrictedReduction_weightedC (J : Ideal A) (hJ : IsOpen (J : Set A)) (a : A) :
    restrictedReduction (k := k) J hJ (weightedC _ isWeightFamily_one_weight a) =
      MvPolynomial.C (Ideal.Quotient.mk J a) := by
  simpa using restrictedReduction_weightedPolynomialHom J hJ (MvPolynomial.C a)

/-- Reduction preserves the coordinate variables. -/
@[simp]
theorem restrictedReduction_weightedX (J : Ideal A) (hJ : IsOpen (J : Set A)) (i : Fin k) :
    restrictedReduction J hJ (weightedX _ isWeightFamily_one_weight i) = MvPolynomial.X i := by
  simpa using restrictedReduction_weightedPolynomialHom J hJ (MvPolynomial.X i)

/-- Every polynomial over the quotient lifts to a restricted series, already to a polynomial. -/
theorem restrictedReduction_surjective (J : Ideal A) (hJ : IsOpen (J : Set A)) :
    Function.Surjective (restrictedReduction (k := k) J hJ) := by
  intro p
  obtain ⟨q, rfl⟩ := MvPolynomial.map_surjective (Ideal.Quotient.mk J)
    Ideal.Quotient.mk_surjective p
  exact ⟨weightedPolynomialHom _ isWeightFamily_one_weight q, by simp⟩

/-- With any topology on `MvPolynomial (Fin k) (A ⧸ J)`, `restrictedReduction J hJ` is continuous
because it factors through a discrete restricted-series subring. -/
theorem continuous_restrictedReduction (J : Ideal A) (hJ : IsOpen (J : Set A))
    [TopologicalSpace (MvPolynomial (Fin k) (A ⧸ J))] :
    Continuous (restrictedReduction (k := k) J hJ) := by
  have : DiscreteTopology (A ⧸ J) := Submodule.Quotient.discreteTopology_of_isOpen J hJ
  have : DiscreteTopology (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set (A ⧸ J)))
      isWeightFamily_one_weight) := discreteTopology_weightedRestrictedSubring
  dsimp only [restrictedReduction, RingHom.coe_comp]
  exact continuous_of_discreteTopology.comp (continuous_weightedMap ..)

/-- Reduction of the completed restricted power-series algebra `A⟨X₁, …, Xₖ⟩` modulo an open
ideal `J` of `A` lands in `(A ⧸ J)[X₁, …, Xₖ]`, without assuming `A` complete or Hausdorff. -/
noncomputable def restrictedReductionCompletion (J : Ideal A) (hJ : IsOpen (J : Set A)) :
    restrictedMvPowerSeriesCompletion k A →+* MvPolynomial (Fin k) (A ⧸ J) := by
  have : DiscreteTopology (A ⧸ J) := Submodule.Quotient.discreteTopology_of_isOpen J hJ
  have : DiscreteTopology (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set (A ⧸ J)))
      isWeightFamily_one_weight) := discreteTopology_weightedRestrictedSubring
  have : DiscreteUniformity (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set (A ⧸ J)))
      isWeightFamily_one_weight) := IsRightUniformAddGroup.discreteUniformity
  exact (weightedPolynomialEquivOfDiscrete (fun _ : Fin k ↦ ({1} : Set (A ⧸ J)))
    isWeightFamily_one_weight).symm.toRingHom.comp
      ((restrictedMvPowerSeriesCompletionEquiv k (A ⧸ J)).toRingHom.comp
        (weightedMapCompletion (φ := Ideal.Quotient.mk J)
          (QuotientRing.isOpenQuotientMap_mk J).continuous
          isWeightFamily_one_weight isWeightFamily_one_weight (by simp)))

/-- On the canonical image of a restricted series, `restrictedReductionCompletion` agrees with
`restrictedReduction`. -/
@[simp]
theorem restrictedReductionCompletion_coe (J : Ideal A) (hJ : IsOpen (J : Set A))
    (f : weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A))
      isWeightFamily_one_weight) :
    restrictedReductionCompletion J hJ (f : restrictedMvPowerSeriesCompletion k A) =
      restrictedReduction J hJ f := by
  have : DiscreteTopology (A ⧸ J) := Submodule.Quotient.discreteTopology_of_isOpen J hJ
  have : DiscreteTopology (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set (A ⧸ J)))
      isWeightFamily_one_weight) := discreteTopology_weightedRestrictedSubring
  have : DiscreteUniformity (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set (A ⧸ J)))
      isWeightFamily_one_weight) := IsRightUniformAddGroup.discreteUniformity
  simp [restrictedReductionCompletion, restrictedReduction]

/-- With any topology on `MvPolynomial (Fin k) (A ⧸ J)`, `restrictedReductionCompletion J hJ` is
continuous because it factors through the discrete ring `(A ⧸ J)⟨X₁, …, Xₖ⟩`. -/
theorem continuous_restrictedReductionCompletion (J : Ideal A) (hJ : IsOpen (J : Set A))
    [TopologicalSpace (MvPolynomial (Fin k) (A ⧸ J))] :
    Continuous (restrictedReductionCompletion (k := k) J hJ) := by
  have : DiscreteTopology (A ⧸ J) := Submodule.Quotient.discreteTopology_of_isOpen J hJ
  have : DiscreteTopology (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set (A ⧸ J)))
      isWeightFamily_one_weight) := discreteTopology_weightedRestrictedSubring
  have : DiscreteUniformity (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set (A ⧸ J)))
      isWeightFamily_one_weight) := IsRightUniformAddGroup.discreteUniformity
  dsimp only [restrictedReductionCompletion, RingHom.coe_comp, RingEquiv.toRingHom_eq_coe,
    RingEquiv.coe_toRingHom]
  exact continuous_of_discreteTopology.comp
    (uniformContinuous_restrictedMvPowerSeriesCompletionEquiv.continuous.comp
      (continuous_weightedMapCompletion ..))

/-- `restrictedReductionCompletion` sends constants to constant polynomials modulo `J`. -/
theorem restrictedReductionCompletion_algebraMap (J : Ideal A) (hJ : IsOpen (J : Set A)) (a : A) :
    restrictedReductionCompletion (k := k) J hJ
      (algebraMap A (restrictedMvPowerSeriesCompletion k A) a) =
        MvPolynomial.C (Ideal.Quotient.mk J a) := by
  simp

/-- `restrictedReductionCompletion` preserves the coordinate variables. -/
theorem restrictedReductionCompletion_weightedX (J : Ideal A) (hJ : IsOpen (J : Set A))
    (i : Fin k) :
    restrictedReductionCompletion J hJ
      ((weightedX _ isWeightFamily_one_weight i :
        weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight) :
          restrictedMvPowerSeriesCompletion k A) = MvPolynomial.X i := by
  simp

/-- Every polynomial over `A ⧸ J` lifts to `restrictedMvPowerSeriesCompletion k A`. -/
theorem restrictedReductionCompletion_surjective (J : Ideal A) (hJ : IsOpen (J : Set A)) :
    Function.Surjective (restrictedReductionCompletion (k := k) J hJ) := fun p ↦ by
  obtain ⟨f, rfl⟩ := restrictedReduction_surjective (k := k) J hJ p
  exact ⟨f, restrictedReductionCompletion_coe J hJ f⟩

end Ideal

namespace TauCeti.Huber

open Ideal (restrictedReduction restrictedReduction_surjective continuous_restrictedReduction
  restrictedReductionCompletion restrictedReductionCompletion_coe
  continuous_restrictedReductionCompletion restrictedReductionCompletion_surjective)

/-- Reduction modulo a finitely generated ideal of definition has exactly the extended ideal
as its kernel. -/
theorem ker_restrictedReduction (hI : IsAdic I) (hfg : I.FG) :
    RingHom.ker (restrictedReduction (k := k) I (by simpa only [pow_one] using hI.isOpen_pow 1)) =
      I.map (weightedC _ isWeightFamily_one_weight) := by
  ext f
  rw [RingHom.mem_ker, mem_map_weightedC_iff_of_isAdic hI hfg, MvPolynomial.ext_iff]
  simp [Ideal.Quotient.eq_zero_iff_mem]

/-- The infinitesimal reduction of restricted power series is a polynomial algebra. -/
noncomputable def quotientRestrictedEquivMvPolynomialQuotient (hI : IsAdic I) (hfg : I.FG) :
    (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight ⧸
      I.map (weightedC _ isWeightFamily_one_weight)) ≃ₐ[A]
      MvPolynomial (Fin k) (A ⧸ I) := by
  let e := (Ideal.quotEquivOfEq (ker_restrictedReduction (k := k) hI hfg).symm).trans
    ((restrictedReduction I (by simpa using hI.isOpen_pow 1)).quotientKerEquivOfSurjective
      (restrictedReduction_surjective I (by simpa only [pow_one] using hI.isOpen_pow 1)))
  refine AlgEquiv.ofRingEquiv (f := e) fun a ↦ ?_
  have he : e (algebraMap A _ a) =
      restrictedReduction I (by simpa only [pow_one] using hI.isOpen_pow 1) (algebraMap A _ a) := by
    rw [← Ideal.Quotient.mk_algebraMap]
    simp only [e, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
  rw [he]
  simp [algebraMap_weightedRestrictedSubring]

/-- On a represented series the quotient comparison computes its polynomial reduction. -/
@[simp]
theorem quotientRestrictedEquivMvPolynomialQuotient_mk (hI : IsAdic I) (hfg : I.FG)
    (f : weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A))
      isWeightFamily_one_weight) :
    quotientRestrictedEquivMvPolynomialQuotient hI hfg (Ideal.Quotient.mk _ f) =
      restrictedReduction I (by simpa only [pow_one] using hI.isOpen_pow 1) f := by
  simp [quotientRestrictedEquivMvPolynomialQuotient]

/-- Reduction is compatible with passing to a larger open ideal. -/
@[simp]
theorem map_restrictedReduction {J : Ideal A} (hJ : IsOpen (J : Set A))
    (hI : IsOpen (I : Set A)) (hJI : J ≤ I)
    (f : weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A))
      isWeightFamily_one_weight) :
    MvPolynomial.map (Ideal.Quotient.factor hJI) (restrictedReduction J hJ f) =
      restrictedReduction I hI f := by
  ext ν
  simp [MvPolynomial.coeff_map]

/-- Completed reduction is compatible with passing to a larger open ideal. -/
theorem map_restrictedReductionCompletion {J : Ideal A} (hJ : IsOpen (J : Set A))
    (hI : IsOpen (I : Set A)) (hJI : J ≤ I) (x : restrictedMvPowerSeriesCompletion k A) :
    MvPolynomial.map (Ideal.Quotient.factor hJI) (restrictedReductionCompletion J hJ x) =
      restrictedReductionCompletion I hI x := by
  let _ : TopologicalSpace (MvPolynomial (Fin k) (A ⧸ J)) := ⊥
  have : DiscreteTopology (MvPolynomial (Fin k) (A ⧸ J)) := ⟨rfl⟩
  let _ : TopologicalSpace (MvPolynomial (Fin k) (A ⧸ I)) := ⊥
  have : DiscreteTopology (MvPolynomial (Fin k) (A ⧸ I)) := ⟨rfl⟩
  exact UniformSpace.Completion.ext'
    ((continuous_of_discreteTopology (f := MvPolynomial.map (Ideal.Quotient.factor hJI))).comp
      (continuous_restrictedReductionCompletion J hJ))
    (continuous_restrictedReductionCompletion I hI)
    (fun f ↦ by
      simp only [Function.comp_apply, restrictedReductionCompletion_coe]
      exact map_restrictedReduction hJ hI hJI f) x

/-- When the restricted-series subring is already complete and Hausdorff, completed reduction
agrees with uncompleted reduction along `restrictedMvPowerSeriesCompletionEquiv`. -/
@[simp]
theorem restrictedReduction_restrictedMvPowerSeriesCompletionEquiv
    [CompleteSpace (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A))
      isWeightFamily_one_weight)]
    [T0Space (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A))
      isWeightFamily_one_weight)]
    (J : Ideal A) (hJ : IsOpen (J : Set A)) (x : restrictedMvPowerSeriesCompletion k A) :
    restrictedReduction J hJ (restrictedMvPowerSeriesCompletionEquiv k A x) =
      restrictedReductionCompletion J hJ x := by
  let _ : TopologicalSpace (MvPolynomial (Fin k) (A ⧸ J)) := ⊥
  have : DiscreteTopology (MvPolynomial (Fin k) (A ⧸ J)) := ⟨rfl⟩
  exact UniformSpace.Completion.ext'
    ((continuous_restrictedReduction J hJ).comp
      (uniformContinuous_restrictedMvPowerSeriesCompletionEquiv (k := k) (A := A)).continuous)
    (continuous_restrictedReductionCompletion J hJ)
    (fun f ↦ by simp) x

/-- Reduction of the completed restricted-series algebra modulo a finitely generated ideal of
definition `I` has kernel equal to the extended ideal `I · A⟨X₁, …, Xₖ⟩`, without assuming `A`
complete or Hausdorff. -/
theorem ker_restrictedReductionCompletion (hI : IsAdic I) (hfg : I.FG) :
    RingHom.ker (restrictedReductionCompletion (k := k) I
      (by simpa only [pow_one] using hI.isOpen_pow 1)) =
      I.map (algebraMap A (restrictedMvPowerSeriesCompletion k A)) := by
  set hIo : IsOpen (I : Set A) := by simpa only [pow_one] using hI.isOpen_pow 1
  set S := weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight
  set IK : Ideal (restrictedMvPowerSeriesCompletion k A) :=
    I.map (algebraMap A (restrictedMvPowerSeriesCompletion k A))
  have hmap : (I.map (weightedC (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight)).map
      (UniformSpace.Completion.coeRingHom : S →+* restrictedMvPowerSeriesCompletion k A) = IK := by
    rw [Ideal.map_map]
    congr 1
  have hle : IK ≤ RingHom.ker (restrictedReductionCompletion (k := k) I hIo) := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem.mpr ha]
  refine le_antisymm (fun x hx ↦ ?_) hle
  have hIKopen : IsOpen (IK : Set (restrictedMvPowerSeriesCompletion k A)) := by
    simpa only [pow_one] using
      (isAdic_map_algebraMap_restrictedMvPowerSeriesCompletion k hI hfg).isOpen_pow 1
  obtain ⟨f, hf⟩ : ∃ f : S, (f : restrictedMvPowerSeriesCompletion k A) - x ∈ IK :=
    UniformSpace.Completion.denseRange_coe.exists_mem_open
      (hIKopen.preimage (continuous_sub_right x)) ⟨x, by simp⟩
  have hfx : restrictedReduction I hIo f = 0 := by
    rw [← restrictedReductionCompletion_coe]
    have hsub : restrictedReductionCompletion I hIo
        ((f : restrictedMvPowerSeriesCompletion k A) - x) = 0 := hle hf
    rwa [map_sub, RingHom.mem_ker.mp hx, sub_zero] at hsub
  have hfK : (f : restrictedMvPowerSeriesCompletion k A) ∈ IK := by
    rw [← hmap]
    exact Ideal.mem_map_of_mem _ ((ker_restrictedReduction (k := k) hI hfg) ▸
      RingHom.mem_ker.mpr hfx)
  simpa using sub_mem hfK hf

section Completion

variable {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [NonarchimedeanRing R] [T2Space R] [CompleteSpace R] {J : Ideal R}

/-- The reduction modulo a finitely generated ideal of definition of the completed
restricted-series algebra is the polynomial algebra over the quotient of the coefficients. -/
noncomputable def quotientRestrictedCompletionEquivMvPolynomialQuotient
    (hJ : IsAdic J) (hfg : J.FG) :
    (restrictedMvPowerSeriesCompletion k R ⧸
      J.map (algebraMap R (restrictedMvPowerSeriesCompletion k R))) ≃ₐ[R]
      MvPolynomial (Fin k) (R ⧸ J) :=
  (Ideal.quotientEquivAlg _ _ (restrictedMvPowerSeriesCompletionAlgEquiv k R) (by
    rw [Ideal.map_map]
    congr 1
    rw [← algebraMap_weightedRestrictedSubring]
    exact (restrictedMvPowerSeriesCompletionAlgEquiv k R).toAlgHom.comp_algebraMap.symm)).trans
      (quotientRestrictedEquivMvPolynomialQuotient hJ hfg)

/-- On an arbitrary completion element, the quotient comparison reduces its associated
restricted series coefficientwise. -/
@[simp]
theorem quotientRestrictedCompletionEquivMvPolynomialQuotient_mk
    (hJ : IsAdic J) (hfg : J.FG) (x : restrictedMvPowerSeriesCompletion k R) :
    quotientRestrictedCompletionEquivMvPolynomialQuotient hJ hfg (Ideal.Quotient.mk _ x) =
      restrictedReduction J (by simpa only [pow_one] using hJ.isOpen_pow 1)
        (restrictedMvPowerSeriesCompletionAlgEquiv k R x) := by
  simp [quotientRestrictedCompletionEquivMvPolynomialQuotient]

end Completion

section Powers

/-- For every nonzero `m`, the quotient of uncompleted restricted power series by the `m`-th power
of the extended ideal `I · A⟨X⟩` is the polynomial algebra `(A ⧸ I ^ m)[X₁, …, Xₖ]`. -/
noncomputable def quotientRestrictedPowEquivMvPolynomialQuotient
    (hI : IsAdic I) (hfg : I.FG) {m : ℕ} (hm : m ≠ 0) :
    (weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight ⧸
      I.map (weightedC _ isWeightFamily_one_weight) ^ m) ≃ₐ[A]
      MvPolynomial (Fin k) (A ⧸ I ^ m) :=
  (Ideal.quotientEquivAlgOfEq A (I.map_pow (weightedC _ isWeightFamily_one_weight) m).symm).trans
    (quotientRestrictedEquivMvPolynomialQuotient
      (is_ideal_adic_pow hI (Nat.pos_of_ne_zero hm)) hfg.pow)

/-- On a represented series, `quotientRestrictedPowEquivMvPolynomialQuotient` reduces
coefficients modulo `I ^ m`. -/
@[simp]
theorem quotientRestrictedPowEquivMvPolynomialQuotient_mk
    (hI : IsAdic I) (hfg : I.FG) {m : ℕ} (hm : m ≠ 0)
    (f : weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight) :
    quotientRestrictedPowEquivMvPolynomialQuotient hI hfg hm (Ideal.Quotient.mk _ f) =
      restrictedReduction (I ^ m) (hI.isOpen_pow m) f := by
  simp [quotientRestrictedPowEquivMvPolynomialQuotient]

/-- The power-`m` quotient equivalences on uncompleted restricted series commute with the
transition maps `Ideal.Quotient.factorPow`. -/
theorem map_factorPow_quotientRestrictedPowEquivMvPolynomialQuotient
    (hI : IsAdic I) (hfg : I.FG) {m n : ℕ} (hn : n ≠ 0) (hnm : n ≤ m)
    (z : weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight ⧸
      I.map (weightedC _ isWeightFamily_one_weight) ^ m) :
    MvPolynomial.map (Ideal.Quotient.factorPow I hnm)
        (quotientRestrictedPowEquivMvPolynomialQuotient hI hfg
          (Nat.ne_of_gt (lt_of_lt_of_le (Nat.pos_of_ne_zero hn) hnm)) z) =
      quotientRestrictedPowEquivMvPolynomialQuotient hI hfg hn
        (Ideal.Quotient.factorPow _ hnm z) := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp only [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk,
    quotientRestrictedPowEquivMvPolynomialQuotient_mk]
  exact map_restrictedReduction (hI.isOpen_pow m) (hI.isOpen_pow n) (Ideal.pow_le_pow_right hnm) f

/-- For every nonzero `m`, the quotient of the completed restricted power-series algebra
`A⟨X₁, …, Xₖ⟩` by `(I · A⟨X₁, …, Xₖ⟩) ^ m` is `(A ⧸ I ^ m)[X₁, …, Xₖ]`, without assuming `A`
complete or Hausdorff. -/
noncomputable def quotientRestrictedCompletionPowEquivMvPolynomialQuotient
    (hI : IsAdic I) (hfg : I.FG) {m : ℕ} (hm : m ≠ 0) :
    (restrictedMvPowerSeriesCompletion k A ⧸
      I.map (algebraMap A (restrictedMvPowerSeriesCompletion k A)) ^ m) ≃ₐ[A]
      MvPolynomial (Fin k) (A ⧸ I ^ m) := by
  have hIm : IsAdic (I ^ m) := is_ideal_adic_pow hI (Nat.pos_of_ne_zero hm)
  let hIo : IsOpen ((I ^ m : Ideal A) : Set A) := hI.isOpen_pow m
  have hker : RingHom.ker (restrictedReductionCompletion (k := k) (I ^ m) hIo) =
      I.map (algebraMap A (restrictedMvPowerSeriesCompletion k A)) ^ m :=
    (ker_restrictedReductionCompletion (k := k) hIm hfg.pow).trans
      (I.map_pow (algebraMap A (restrictedMvPowerSeriesCompletion k A)) m)
  let e := (Ideal.quotEquivOfEq hker.symm).trans
    ((restrictedReductionCompletion (I ^ m) hIo).quotientKerEquivOfSurjective
      (restrictedReductionCompletion_surjective (I ^ m) hIo))
  refine AlgEquiv.ofRingEquiv (f := e) fun a ↦ ?_
  have he : e (algebraMap A _ a) =
      restrictedReductionCompletion (I ^ m) hIo
        (algebraMap A (restrictedMvPowerSeriesCompletion k A) a) := by
    rw [← Ideal.Quotient.mk_algebraMap]
    simp only [e, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
  rw [he]
  simp

/-- On a represented completion element, `quotientRestrictedCompletionPowEquivMvPolynomialQuotient`
computes its completed polynomial reduction modulo `I ^ m`. -/
@[simp]
theorem quotientRestrictedCompletionPowEquivMvPolynomialQuotient_mk
    (hI : IsAdic I) (hfg : I.FG) {m : ℕ} (hm : m ≠ 0)
    (x : restrictedMvPowerSeriesCompletion k A) :
    quotientRestrictedCompletionPowEquivMvPolynomialQuotient hI hfg hm (Ideal.Quotient.mk _ x) =
      restrictedReductionCompletion (I ^ m) (hI.isOpen_pow m) x := by
  simp [quotientRestrictedCompletionPowEquivMvPolynomialQuotient]

/-- The power-`m` quotient equivalences on `A⟨X₁, …, Xₖ⟩` commute with the transition maps
`Ideal.Quotient.factorPow`. -/
theorem map_factorPow_quotientRestrictedCompletionPowEquivMvPolynomialQuotient
    (hI : IsAdic I) (hfg : I.FG) {m n : ℕ} (hn : n ≠ 0) (hnm : n ≤ m)
    (z : restrictedMvPowerSeriesCompletion k A ⧸
      I.map (algebraMap A (restrictedMvPowerSeriesCompletion k A)) ^ m) :
    MvPolynomial.map (Ideal.Quotient.factorPow I hnm)
        (quotientRestrictedCompletionPowEquivMvPolynomialQuotient hI hfg
          (Nat.ne_of_gt (lt_of_lt_of_le (Nat.pos_of_ne_zero hn) hnm)) z) =
      quotientRestrictedCompletionPowEquivMvPolynomialQuotient hI hfg hn
        (Ideal.Quotient.factorPow _ hnm z) := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp only [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk,
    quotientRestrictedCompletionPowEquivMvPolynomialQuotient_mk]
  exact map_restrictedReductionCompletion (hI.isOpen_pow m) (hI.isOpen_pow n)
    (Ideal.pow_le_pow_right hnm) x

end Powers

section BaseChangeAndEval

/-- Polynomial reduction commutes with coefficient base change along any continuous ring
homomorphism `φ : A →+* B` carrying `I` into `J`, with no flatness or completeness hypothesis. -/
theorem restrictedReduction_weightedMap
    {B : Type*} [CommRing B] [TopologicalSpace B] [NonarchimedeanRing B]
    {φ : A →+* B} (hφ : Continuous φ) {J : Ideal B}
    (hI : IsOpen (I : Set A)) (hJ : IsOpen (J : Set B)) (hIJ : I ≤ J.comap φ)
    (f : weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight) :
    restrictedReduction J hJ
        (weightedMap hφ isWeightFamily_one_weight isWeightFamily_one_weight (fun _ ↦ by simp) f) =
      MvPolynomial.map (Ideal.quotientMap J φ hIJ) (restrictedReduction I hI f) := by
  ext ν
  simp [MvPolynomial.coeff_map]

/-- Completed polynomial reduction commutes with `weightedMapCompletion` along any continuous ring
homomorphism `φ : A →+* B` carrying `I` into `J`. -/
theorem restrictedReductionCompletion_weightedMapCompletion
    {B : Type*} [CommRing B] [TopologicalSpace B] [NonarchimedeanRing B]
    {φ : A →+* B} (hφ : Continuous φ) {J : Ideal B}
    (hI : IsOpen (I : Set A)) (hJ : IsOpen (J : Set B)) (hIJ : I ≤ J.comap φ)
    (x : restrictedMvPowerSeriesCompletion k A) :
    restrictedReductionCompletion J hJ
        (weightedMapCompletion hφ isWeightFamily_one_weight isWeightFamily_one_weight
          (fun _ ↦ by simp) x) =
      MvPolynomial.map (Ideal.quotientMap J φ hIJ) (restrictedReductionCompletion I hI x) := by
  let _ : TopologicalSpace (MvPolynomial (Fin k) (A ⧸ I)) := ⊥
  have : DiscreteTopology (MvPolynomial (Fin k) (A ⧸ I)) := ⟨rfl⟩
  let _ : TopologicalSpace (MvPolynomial (Fin k) (B ⧸ J)) := ⊥
  have : DiscreteTopology (MvPolynomial (Fin k) (B ⧸ J)) := ⟨rfl⟩
  exact UniformSpace.Completion.ext'
    ((continuous_restrictedReductionCompletion J hJ).comp
      (continuous_weightedMapCompletion hφ isWeightFamily_one_weight isWeightFamily_one_weight
        (fun _ ↦ by simp)))
    ((continuous_of_discreteTopology (f := MvPolynomial.map (Ideal.quotientMap J φ hIJ))).comp
      (continuous_restrictedReductionCompletion I hI))
    (fun f ↦ by
      simp only [Function.comp_apply, weightedMapCompletion_coe, restrictedReductionCompletion_coe]
      exact restrictedReduction_weightedMap hφ hI hJ hIJ f) x

/-- Reducing the continuous evaluation of a restricted series modulo an open ideal `J` agrees with
evaluating its polynomial reduction modulo `I` at the reduced tuple. -/
theorem mk_weightedEvalHom_eq_eval₂_restrictedReduction
    {B : Type*} [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [NonarchimedeanRing B]
    [CompleteSpace B] [T2Space B] {φ : A →+* B} (hφ : ContinuousAt φ 0) {b : Fin k → B}
    (hb : IsWeightBounded φ (fun _ : Fin k ↦ ({1} : Set A)) b) {J : Ideal B}
    (hI : IsOpen (I : Set A)) (hJ : IsOpen (J : Set B)) (hIJ : I ≤ J.comap φ)
    (f : weightedRestrictedSubring (fun _ : Fin k ↦ ({1} : Set A)) isWeightFamily_one_weight) :
    Ideal.Quotient.mk J (weightedEvalHom isWeightFamily_one_weight hφ hb f) =
      MvPolynomial.eval₂ (Ideal.quotientMap J φ hIJ) (fun i ↦ Ideal.Quotient.mk J (b i))
        (restrictedReduction I hI f) := by
  have : DiscreteTopology (B ⧸ J) := Submodule.Quotient.discreteTopology_of_isOpen J hJ
  let _ : TopologicalSpace (MvPolynomial (Fin k) (A ⧸ I)) := ⊥
  have : DiscreteTopology (MvPolynomial (Fin k) (A ⧸ I)) := ⟨rfl⟩
  let lhs := (Ideal.Quotient.mk J).comp (weightedEvalHom isWeightFamily_one_weight hφ hb)
  let rhs := (MvPolynomial.eval₂Hom (Ideal.quotientMap J φ hIJ)
    (fun i ↦ Ideal.Quotient.mk J (b i))).comp (restrictedReduction I hI)
  have hlhs : Continuous lhs :=
    (QuotientRing.isOpenQuotientMap_mk J).continuous.comp
      (continuous_weightedEvalHom isWeightFamily_one_weight hφ hb)
  have hrhs : Continuous rhs := by
    dsimp only [rhs, RingHom.coe_comp]
    exact continuous_of_discreteTopology.comp (continuous_restrictedReduction I hI)
  have heq : lhs = rhs := weightedRestrictedSubring_ringHom_ext_of_continuous
    isWeightFamily_one_weight hlhs hrhs
    (fun a ↦ by simp [lhs, rhs])
    (fun i ↦ by simp [lhs, rhs])
  exact congr($heq f)

/-- Reducing the completed evaluation `weightedEvalHomCompletion` modulo an open ideal `J` agrees
with evaluating `restrictedReductionCompletion` at the reduced tuple. -/
theorem mk_weightedEvalHomCompletion_eq_eval₂_restrictedReductionCompletion
    {B : Type*} [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [NonarchimedeanRing B]
    [CompleteSpace B] [T2Space B] {φ : A →+* B} (hφ : ContinuousAt φ 0) {b : Fin k → B}
    (hb : IsWeightBounded φ (fun _ : Fin k ↦ ({1} : Set A)) b) {J : Ideal B}
    (hI : IsOpen (I : Set A)) (hJ : IsOpen (J : Set B)) (hIJ : I ≤ J.comap φ)
    (x : restrictedMvPowerSeriesCompletion k A) :
    Ideal.Quotient.mk J (weightedEvalHomCompletion isWeightFamily_one_weight hφ hb x) =
      MvPolynomial.eval₂ (Ideal.quotientMap J φ hIJ) (fun i ↦ Ideal.Quotient.mk J (b i))
        (restrictedReductionCompletion I hI x) := by
  have : DiscreteTopology (B ⧸ J) := Submodule.Quotient.discreteTopology_of_isOpen J hJ
  let _ : TopologicalSpace (MvPolynomial (Fin k) (A ⧸ I)) := ⊥
  have : DiscreteTopology (MvPolynomial (Fin k) (A ⧸ I)) := ⟨rfl⟩
  exact UniformSpace.Completion.ext'
    ((QuotientRing.isOpenQuotientMap_mk J).continuous.comp
      (continuous_weightedEvalHomCompletion isWeightFamily_one_weight hφ hb))
    ((continuous_of_discreteTopology (f := MvPolynomial.eval₂ (Ideal.quotientMap J φ hIJ)
      (fun i ↦ Ideal.Quotient.mk J (b i)))).comp
      (continuous_restrictedReductionCompletion I hI))
    (fun f ↦ by
      simp only [Function.comp_apply, weightedEvalHomCompletion_coe,
        restrictedReductionCompletion_coe]
      exact mk_weightedEvalHom_eq_eval₂_restrictedReduction hφ hb hI hJ hIJ f) x

end BaseChangeAndEval

