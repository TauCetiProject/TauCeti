module

public import TauCeti.RingTheory.Huber.OpenIdeal
public import TauCeti.RingTheory.Huber.WeightedRestrictedSeries.Basic

/-!
# Open ideals and admissible weights

Over a Huber ring, a family `T` is admissible for weighted restricted power series exactly when
each weight set `T i` generates an open ideal. This identifies the algebraic admission condition
with the neighbourhood condition `IsWeightFamily` used to define the weighted series topology.
In particular, finite numerator sets of rational subsets provide admissible weights even over
Huber rings that are not Tate rings.

The implication from open ideals uses Wedhorn's Lemma 6.20: each additive subgroup generated by
`Tᵐ · U` is a neighbourhood of zero whenever `U` is one. Neither this implication nor the
equivalence assumes that the weight sets are finite or bounded.

## Main result

* `TauCeti.Huber.isWeightFamily_iff_isOpen_span`: the algebraic criterion for admissibility.

## References

* [T. Wedhorn, *Adic Spaces*][wedhorn_adic], Lemma 6.20 and Remark and Definition 5.48.
-/

public section

open scoped Topology Pointwise

namespace TauCeti.Huber

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
  [IsHuberRing A] {k : ℕ} {T : Fin k → Set A}

/-- **The algebraic criterion for admissible weights over a Huber ring**: a family is admissible
for weighted restricted power series exactly when each of its weight sets generates an open
ideal. The sets may be infinite or unbounded. -/
theorem isWeightFamily_iff_isOpen_span :
    IsWeightFamily T ↔ ∀ i, IsOpen (Ideal.span (T i) : Set A) := by
  refine ⟨fun h i ↦ ?_, fun h ↦ ?_⟩
  · have hle : weightMul T (Finsupp.single i 1) ⊤ ≤ (Ideal.span (T i)).toAddSubgroup := by
      apply weightMul_le.mpr
      intro t ht a _
      rw [weightPow_single, pow_one] at ht
      exact Ideal.mul_mem_right a _ (Ideal.subset_span ht)
    exact AddSubgroup.isOpen_mono hle (h.isOpen_weightMul_top i 1)
  · obtain ⟨P⟩ := IsHuberRing.nonempty_pairOfDefinition (A := A)
    exact isWeightFamily_iff.mpr fun i m U hU ↦
      P.addSubgroupClosure_pow_mul_mem_nhds (h i) m hU

end TauCeti.Huber
