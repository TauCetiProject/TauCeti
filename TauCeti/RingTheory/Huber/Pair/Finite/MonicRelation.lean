/-!
# Finiteness from monic relations

Let `(A, A⁺)` be a complete Hausdorff Tate pair and `f : (A, A⁺) → (B, B⁺)` a morphism of Huber
pairs into a Hausdorff pair, presented by a quotient mapping `π : A⟨T₁, …, Tₙ⟩ → B` out of the
relative closed unit polydisc, with images `tᵢ = π(Tᵢ) ∈ B⁺`. Huber's Lemma 1.4.3 says that `f`
is finite exactly when every `tᵢ` satisfies a monic relation over `A⁺` up to a topologically
nilpotent error: there are monic `pᵢ ∈ A⁺[X]` with `pᵢ(tᵢ)` topologically nilpotent in `B`
(`TauCeti.Huber.Pair.Hom.isFinite_iff_forall_exists_monic`). This is the finiteness test used to
recognise finite morphisms near a point with proper fibre.

The forward direction is the integrality of `B⁺` over `A⁺`. For the converse choose a ring of
definition `A₀ ⊆ A⁺` containing the coefficients of the `pᵢ` and a pseudouniformiser `ϖ ∈ A₀`.
The closure `B₀` in `B` of the subring generated by the image of `A₀` and the `tᵢ` is open,
because it contains the image under `π` of the closure of `A₀[T₁, …, Tₙ]`
(`TauCeti.Huber.isOpen_topologicalClosure_closure_polydiscVar`), and bounded. Modulo `ϖ B₀` it is
generated over `A₀` by the classes of the `tᵢ`, which are integral since a power of `pᵢ(tᵢ)` lies
in `ϖ B₀`; so `B₀ ⧸ ϖ B₀` is a finite `A₀`-module. As `A₀` is `ϖ`-adically complete and the bounded
`B₀` is `ϖ`-adically separated, Nakayama's lemma for complete rings
(`Module.Finite.of_finite_quotient_smul_top`) makes `B₀` a finite `A₀`-module. Hence `B` is a
finite `A`-module and the elements of `B₀`, which include the `tᵢ`, are integral over `A₀ ⊆ A⁺`;
this controls the plus ring `B⁺`, the integral closure of the image of `A⁺⟨T⟩`.

## Main results

* `TauCeti.Huber.Pair.Hom.isFinite_iff_forall_exists_monic`: Huber's Lemma 1.4.3.
* `TauCeti.Huber.Pair.Hom.IsFinite.finite`: over a complete Hausdorff Tate pair, a finite morphism
  into a Hausdorff pair is module-finite on the underlying rings.

## References

* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.4, Lemma 1.4.3 and its proof.
* B. Zavyalov, *Quotients of admissible formal schemes and adic spaces by finite groups*,
  Appendix B.2, Lemma B.2.9.
-/

public section

open Topology Polynomial

namespace TauCeti.Huber

variable {A B : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A]
  [CompleteSpace A] [T0Space A] [IsTateRing A]
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsHuberRing B] [T2Space B]

/-! ### An open bounded subring of `B` generated by integral elements modulo `ϖ` -/

section Core

omit [T2Space B] in
/-- The closure of the subring generated by a bounded subring and finitely many power-bounded
elements is bounded. -/
private theorem isBounded_topologicalClosure_closure {R : Subring B} (hR : IsBounded (R : Set B))
    {n : ℕ} {t : Fin n → B} (ht : ∀ i, IsPowerBounded (t i)) :
    IsBounded ((Subring.closure ((R : Set B) ∪ Set.range t)).topologicalClosure : Set B) := by
  rw [Subring.topologicalClosure_coe, Subring.closure_union, Subring.closure_eq]
  exact (isBounded_sup _ _ hR
    (isBounded_subringClosure (Set.finite_range t) (by rintro _ ⟨i, rfl⟩; exact ht i))).closure

omit [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [CompleteSpace A] [T0Space A]
  [IsTateRing A] [CommRing A] [TopologicalSpace B] [IsTopologicalRing B] [IsHuberRing B]
  [T2Space B] in
/-- In an `R`-algebra `B₀ ⊆ B` lifting `ψ : R → B`, an element `ψ(ϖ) y` with `y ∈ B₀` lies in the
ideal of `B₀` generated by `ϖ`. -/
private theorem mem_map_span_singleton {R : Type*} [CommRing R] {ψ : R →+* B} {B₀ : Subring B}
    [Algebra R B₀] (halg : ∀ a, ((algebraMap R B₀ a : B₀) : B) = ψ a) (ϖ : R) {x : B₀} {y : B}
    (hy : y ∈ B₀) (hxy : (x : B) = ψ ϖ * y) :
    x ∈ (Ideal.span {ϖ}).map (algebraMap R B₀) := by
  have hx : x = algebraMap R B₀ ϖ * ⟨y, hy⟩ := Subtype.ext (by simp [hxy, halg])
  exact hx ▸ Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self ϖ))

omit [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [CompleteSpace A] [T0Space A]
  [IsTateRing A] [IsHuberRing B] [T2Space B] in
/-- **Modulo `ϖ`, the closure `B₀` is generated by the `tᵢ`.** If `B₀` is the closure of the
subring generated by `φ(A₀)` and the `tᵢ`, and `φ(ϖ) B₀` is open, then `B₀ ⧸ ϖ B₀` is generated as
an `A₀`-algebra by the classes of the `tᵢ`. -/
private theorem adjoin_range_mk_eq_top (φ : A →+* B) {A₀ : Subring A} (ϖ : A₀) {n : ℕ}
    {t : Fin n → B} {B₀ : Subring B}
    (hB₀ : B₀ = (Subring.closure ((A₀.map φ : Set B) ∪ Set.range t)).topologicalClosure)
    (hopen : IsOpen (B₀ : Set B)) (hu : IsUnit (φ ϖ)) [Algebra A₀ B₀]
    (halg : ∀ a, ((algebraMap A₀ B₀ a : B₀) : B) = φ a) (htB₀ : ∀ i, t i ∈ B₀) :
    Algebra.adjoin A₀ (Set.range fun i ↦
      Ideal.Quotient.mk ((Ideal.span {ϖ}).map (algebraMap A₀ B₀)) ⟨t i, htB₀ i⟩) = ⊤ := by
  set J := (Ideal.span {ϖ}).map (algebraMap A₀ B₀)
  refine eq_top_iff.mpr fun z _ ↦ ?_
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
  -- approximate `b` by an element `d` of the generated subring, up to a multiple of `φ ϖ`
  have hb : (b : B) ∈ closure (Subring.closure ((A₀.map φ : Set B) ∪ Set.range t) : Set B) := by
    rw [← Subring.topologicalClosure_coe, ← hB₀]; exact b.property
  obtain ⟨d, hd, y, hy, hdb⟩ := mem_closure_iff_nhds_zero.mp hb _
    ((hopen.smul hu.unit).mem_nhds (Set.zero_mem_smul_set (zero_mem B₀)))
  -- the generated subring maps into the subalgebra generated by the classes of the `tᵢ`
  have hle : Subring.closure ((A₀.map φ : Set B) ∪ Set.range t) ≤
      ((Algebra.adjoin A₀ (Set.range fun i ↦ Ideal.Quotient.mk J ⟨t i, htB₀ i⟩)).toSubring.comap
        (Ideal.Quotient.mk J)).map B₀.subtype := by
    refine Subring.closure_le.mpr ?_
    rintro _ (⟨a, ha, rfl⟩ | ⟨i, rfl⟩)
    · refine ⟨algebraMap A₀ B₀ ⟨a, ha⟩, Subring.mem_comap.mpr ?_, halg _⟩
      rw [Ideal.Quotient.mk_algebraMap]
      exact Subalgebra.algebraMap_mem _ _
    · exact ⟨⟨t i, htB₀ i⟩, Algebra.subset_adjoin ⟨i, rfl⟩, rfl⟩
  obtain ⟨d', hd', rfl⟩ := hle hd
  rw [← Ideal.Quotient.eq.mpr (mem_map_span_singleton (ψ := φ.comp A₀.subtype) halg ϖ hy
    (by simpa [Units.smul_def] using hdb.symm))]
  exact hd'

/-- **The core of Huber's Lemma 1.4.3.** Let `A₀` be a ring of definition of the complete Tate ring
`A` with a pseudouniformiser `ϖ ∈ A₀`, let `φ : A → B` be continuous, and let `t₁, …, tₙ ∈ B` be
power-bounded with monic `pᵢ ∈ A₀[X]` such that `pᵢ(tᵢ)` is topologically nilpotent. If the
closure `B₀` of the subring generated by `φ(A₀)` and the `tᵢ` is open, then `B₀` is a finite
`A₀`-module, for any `A₀`-algebra structure on `B₀` lifting `φ`. -/
private theorem module_finite_topologicalClosure (φ : A →+* B) (hφ : Continuous φ)
    (P : PairOfDefinition A) {ϖ : P.ringOfDefinition} (hϖ : IsPseudoUniformizer (ϖ : A))
    {n : ℕ} {t : Fin n → B} (ht : ∀ i, IsPowerBounded (t i))
    {p : Fin n → P.ringOfDefinition[X]} (hp : ∀ i, (p i).Monic)
    (hpt : ∀ i, IsTopologicallyNilpotent ((p i).eval₂ (φ.comp P.ringOfDefinition.subtype) (t i)))
    {B₀ : Subring B} (hB₀ : B₀ = (Subring.closure
      ((P.ringOfDefinition.map φ : Set B) ∪ Set.range t)).topologicalClosure)
    (hopen : IsOpen (B₀ : Set B)) [Algebra P.ringOfDefinition B₀]
    (halg : ∀ a, ((algebraMap P.ringOfDefinition B₀ a : B₀) : B) = φ a) :
    Module.Finite P.ringOfDefinition B₀ := by
  have hbdd : IsBounded (B₀ : Set B) := hB₀ ▸ isBounded_topologicalClosure_closure (by
    rw [Subring.coe_map]; exact P.isBounded_ringOfDefinition.image_of_isTateRing hφ.continuousAt) ht
  have hu := hϖ.map hφ
  have htB₀ (i : Fin n) : t i ∈ B₀ :=
    hB₀ ▸ Subring.le_topologicalClosure _ (Subring.subset_closure (Or.inr ⟨i, rfl⟩))
  set J : Ideal B₀ := (Ideal.span {ϖ}).map (algebraMap P.ringOfDefinition B₀) with hJdef
  -- the classes of the `tᵢ` modulo `J` are integral, since a power of `pᵢ(tᵢ)` lies in `ϖ B₀`
  have hint (i : Fin n) : IsIntegral P.ringOfDefinition (Ideal.Quotient.mk J ⟨t i, htB₀ i⟩) := by
    obtain ⟨N, y, hy, hN⟩ := ((hpt i).eventually_mem
      ((hopen.smul hu.isUnit.unit).mem_nhds (Set.zero_mem_smul_set (zero_mem B₀)))).exists
    refine ⟨p i ^ N, (hp i).pow N, ?_⟩
    rw [← aeval_def, ← Ideal.Quotient.mkₐ_eq_mk P.ringOfDefinition, aeval_algHom_apply,
      Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    refine mem_map_span_singleton (ψ := φ.comp P.ringOfDefinition.subtype) halg ϖ hy ?_
    have hcomp : B₀.subtype.comp (algebraMap P.ringOfDefinition B₀) =
        φ.comp P.ringOfDefinition.subtype := RingHom.ext halg
    rw [aeval_def, ← B₀.coe_subtype, hom_eval₂, hcomp, eval₂_pow]
    simpa [Units.smul_def] using hN.symm
  -- so `B₀ ⧸ J` is a finite `A₀`-module
  have hfinQ : Module.Finite P.ringOfDefinition (B₀ ⧸ J) := by
    have h := fg_adjoin_of_finite (Set.finite_range _) (by rintro _ ⟨i, rfl⟩; exact hint i)
    rw [adjoin_range_mk_eq_top φ ϖ hB₀ hopen hu.isUnit halg htB₀, Algebra.top_toSubmodule] at h
    exact ⟨h⟩
  -- Nakayama's lemma for the `ϖ`-adically complete `A₀` and the `ϖ`-adically separated `B₀`
  have : IsAdicComplete (Ideal.span {ϖ}) P.ringOfDefinition :=
    P.isAdicComplete_span_singleton ϖ hϖ
  have hϖB₀ : φ ϖ ∈ B₀ := halg ϖ ▸ (algebraMap P.ringOfDefinition B₀ ϖ).property
  have hJ : J = Ideal.span {(⟨φ ϖ, hϖB₀⟩ : B₀)} := by
    rw [hJdef, Ideal.map_span, Set.image_singleton]
    exact congrArg (fun b ↦ Ideal.span {b}) (Subtype.ext (halg ϖ))
  have : IsHausdorff J B₀ := hJ ▸ (B₀.isAdic_span_singleton_of_isOpen_of_isBounded hopen hbdd hu
    hϖB₀).isHausdorff_iff.mpr inferInstance
  have : IsHausdorff (Ideal.span {ϖ}) B₀ := IsHausdorff.map_algebraMap_iff.mp this
  have : Module.Finite P.ringOfDefinition
      (B₀ ⧸ (Ideal.span {ϖ} • ⊤ : Submodule P.ringOfDefinition B₀)) := by
    rw [Ideal.smul_top_eq_map]
    exact Module.Finite.equiv (Submodule.Quotient.restrictScalarsEquiv _ J).symm
  exact Module.Finite.of_finite_quotient_smul_top (Ideal.span {ϖ}) B₀

end Core

/-! ### Morphisms presented by a polydisc -/

namespace Pair.Hom

variable {S : Pair A} {U : Pair B} {n : ℕ} {π : Hom (S.polydisc n) U} {f : Hom S U}

omit [IsUniformAddGroup A] [CompleteSpace A] [T0Space A] [T2Space B] in
/-- On constants, a morphism presented by `π` is `π` composed with the structure map of
`A⟨T₁, …, Tₙ⟩`. -/
private theorem toRingHom_apply_eq
    (hπf : π.comp (S.weightedCompletionHom isWeightFamily_one_weight) = f) (a : A) :
    f.toRingHom a = π.toRingHom (algebraMap A (restrictedMvPowerSeriesCompletion n A) a) := by
  rw [← hπf, toRingHom_comp, toRingHom_weightedCompletionHom, RingHom.comp_apply,
    algebraMap_completion_weightedRestrictedSubring_apply]

omit [IsUniformAddGroup A] [CompleteSpace A] [T0Space A] [T2Space B] in
/-- The presentation `π` carries the closure of `R[T₁, …, Tₙ]` into the closure of the subring
generated by `f(R)` and the images `tᵢ = π(Tᵢ)` of the coordinates. -/
private theorem image_topologicalClosure_closure_subset
    (hπf : π.comp (S.weightedCompletionHom isWeightFamily_one_weight) = f) (R : Subring A) :
    π.toRingHom '' ((Subring.closure (algebraMap A (restrictedMvPowerSeriesCompletion n A) '' R ∪
      Set.range (Pair.polydiscVar n A))).topologicalClosure : Set _) ⊆
      ((Subring.closure ((R.map f.toRingHom : Set B) ∪
        Set.range fun i ↦ π.toRingHom (Pair.polydiscVar n A i))).topologicalClosure :
          Set B) := by
  rintro _ ⟨x, hx, rfl⟩
  rw [Subring.topologicalClosure_coe] at hx ⊢
  refine closure_mono ?_ (image_closure_subset_closure_image π.continuous_toRingHom ⟨x, hx, rfl⟩)
  rintro _ ⟨y, hy, rfl⟩
  have hy' : π.toRingHom y ∈ (Subring.closure _).map π.toRingHom := ⟨y, hy, rfl⟩
  rw [RingHom.map_closure, Set.image_union, Set.image_image, ← Set.range_comp] at hy'
  refine Subring.closure_mono ?_ hy'
  rintro _ (⟨a, ha, rfl⟩ | ⟨i, rfl⟩)
  · exact Or.inl ⟨a, ha, toRingHom_apply_eq hπf a⟩
  · exact Or.inr ⟨i, rfl⟩

omit [IsUniformAddGroup A] [CompleteSpace A] [T0Space A] [T2Space B] in
/-- For an open subring `R` of `A`, the closure of the subring generated by `f(R)` and the `tᵢ` is
open: it contains the image under the open map `π` of the open closure of `R[T₁, …, Tₙ]`. -/
private theorem isOpen_topologicalClosure_closure (hπ : π.IsQuotientMapping)
    (hπf : π.comp (S.weightedCompletionHom isWeightFamily_one_weight) = f) {R : Subring A}
    (hR : IsOpen (R : Set A)) :
    IsOpen ((Subring.closure ((R.map f.toRingHom : Set B) ∪
      Set.range fun i ↦ π.toRingHom (Pair.polydiscVar n A i))).topologicalClosure : Set B) := by
  rw [← Subring.coe_toAddSubgroup]
  refine AddSubgroup.isOpen_of_mem_nhds _ (g := 0) (Filter.mem_of_superset ?_
    (image_topologicalClosure_closure_subset hπf R))
  exact (hπ.isOpenQuotientMap.isOpenMap _ (isOpen_topologicalClosure_closure_polydiscVar hR n)
    ).mem_nhds ⟨0, zero_mem _, map_zero _⟩

omit [IsUniformAddGroup A] [CompleteSpace A] [T0Space A] in
/-- A ring of definition inside `A⁺` containing the coefficients of finitely many polynomials over
`A⁺`, together with a pseudouniformiser lying in it. -/
private theorem exists_pairOfDefinition_coeffs_subset {p : Fin n → A[X]}
    (hp : ∀ i j, (p i).coeff j ∈ S.plus) :
    ∃ P : PairOfDefinition A, P.ringOfDefinition ≤ S.plus ∧
      (∀ i, ((p i).coeffs : Set A) ⊆ P.ringOfDefinition) ∧
        ∃ ϖ : P.ringOfDefinition, IsPseudoUniformizer (ϖ : A) := by
  classical
  let c : Finset A := Finset.univ.biUnion fun i ↦ (p i).coeffs
  have hcS : Subring.closure (c : Set A) ≤ S.plus := Subring.closure_le.mpr fun x hx ↦ by
    obtain ⟨i, -, hx⟩ := Finset.mem_biUnion.mp hx
    obtain ⟨j, -, rfl⟩ := mem_coeffs_iff.mp hx
    exact hp i j
  obtain ⟨P, hcP, hPS⟩ := exists_pairOfDefinition_le_le (isBounded_subringClosure c.finite_toSet
    fun x hx ↦ S.isRingOfIntegralElements.isPowerBounded_of_mem (hcS (Subring.subset_closure hx)))
    S.isRingOfIntegralElements.isOpen hcS
  refine ⟨P, hPS, fun i x hx ↦ hcP (Subring.subset_closure ?_), ?_⟩
  · exact Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hx⟩)
  exact P.exists_isPseudoUniformizer

/-- **The monic relations give an open subring of `B` finite over a ring of definition.** If each
`tᵢ = π(Tᵢ)` has a monic `pᵢ ∈ A⁺[X]` with `pᵢ(tᵢ)` topologically nilpotent, there is an open
subring `B₀` of `B` containing the `tᵢ`, all of whose elements are integral over the image of `A⁺`,
and spanned over the image of `A` by finitely many elements. -/
private theorem exists_subring_of_forall_exists_monic (hπ : π.IsQuotientMapping)
    (hπf : π.comp (S.weightedCompletionHom isWeightFamily_one_weight) = f)
    (hmonic : ∀ i, ∃ p : A[X], p.Monic ∧ (∀ j, p.coeff j ∈ S.plus) ∧
      IsTopologicallyNilpotent (p.eval₂ f.toRingHom (π.toRingHom (Pair.polydiscVar n A i)))) :
    ∃ B₀ : Subring B, IsOpen (B₀ : Set B) ∧ (∀ i, π.toRingHom (Pair.polydiscVar n A i) ∈ B₀) ∧
      (∀ b ∈ B₀, IsIntegral (S.plus.map f.toRingHom) b) ∧
        ∃ (m : ℕ) (g : Fin m → B), ∀ b ∈ B₀, ∃ c : Fin m → A, b = ∑ j, f.toRingHom (c j) * g j := by
  choose p hpm hpS hpt using hmonic
  obtain ⟨P, hPS, hcoeffs, ϖ, hϖ⟩ := exists_pairOfDefinition_coeffs_subset hpS
  set t : Fin n → B := fun i ↦ π.toRingHom (Pair.polydiscVar n A i)
  set B₀ := (Subring.closure ((P.ringOfDefinition.map f.toRingHom : Set B) ∪
    Set.range t)).topologicalClosure
  have hφA₀ (a : P.ringOfDefinition) : f.toRingHom a ∈ B₀ :=
    Subring.le_topologicalClosure _ (Subring.subset_closure (Or.inl ⟨a, a.property, rfl⟩))
  let : Algebra P.ringOfDefinition B₀ :=
    ((f.toRingHom.comp P.ringOfDefinition.subtype).codRestrict _ hφA₀).toAlgebra
  -- the algebra map of `B₀` is `f` on `A₀`, by construction
  have halg (a : P.ringOfDefinition) :
      ((algebraMap P.ringOfDefinition B₀ a : B₀) : B) = f.toRingHom a := rfl
  have hopen := isOpen_topologicalClosure_closure hπ hπf P.isOpen_ringOfDefinition
  have hfin := module_finite_topologicalClosure f.toRingHom f.continuous_toRingHom P hϖ
    (fun i ↦ U.isRingOfIntegralElements.isPowerBounded_of_mem
      (π.map_mem_plus _ (S.polydiscVar_mem_polydiscPlus n i)))
    (p := fun i ↦ (p i).toSubring _ (hcoeffs i)) (fun i ↦ (monic_toSubring _ _ _).mpr (hpm i))
    (fun i ↦ by rw [← eval₂_map, map_toSubring]; exact hpt i) rfl hopen halg
  refine ⟨B₀, hopen, fun i ↦ Subring.le_topologicalClosure _
    (Subring.subset_closure (Or.inr ⟨i, rfl⟩)), fun b hb ↦ ?_, ?_⟩
  · have : Algebra.IsIntegral P.ringOfDefinition B₀ := Algebra.IsIntegral.of_finite _ _
    exact (Algebra.IsIntegral.isIntegral (⟨b, hb⟩ : B₀)).map_of_comp_eq
      ((f.toRingHom.comp P.ringOfDefinition.subtype).codRestrict (S.plus.map f.toRingHom)
        fun a ↦ Subring.mem_map.mpr ⟨a, hPS a.property, rfl⟩)
      B₀.subtype (RingHom.ext fun a ↦ (halg a).symm)
  · obtain ⟨m, g, hg⟩ := Module.Finite.exists_fin (R := P.ringOfDefinition) (M := B₀)
    refine ⟨m, fun j ↦ g j, fun b hb ↦ ?_⟩
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp
      (hg ▸ Submodule.mem_top (x := (⟨b, hb⟩ : B₀)))
    refine ⟨fun j ↦ c j, ?_⟩
    have hb' : b = ((⟨b, hb⟩ : B₀) : B) := rfl
    rw [hb', ← hc, AddSubmonoidClass.coe_finsetSum]
    simp only [Algebra.smul_def, Subring.coe_mul, halg]

/-- **Module-finiteness from monic relations.** If every `tᵢ = π(Tᵢ)` has a monic `pᵢ ∈ A⁺[X]`
with `pᵢ(tᵢ)` topologically nilpotent, then `B` is a finite `A`-module: some `f(ϖ)ᴺ b` lies in
the open subring `B₀`, which is finitely spanned. -/
private theorem finite_toRingHom_of_forall_exists_monic (hπ : π.IsQuotientMapping)
    (hπf : π.comp (S.weightedCompletionHom isWeightFamily_one_weight) = f)
    (hmonic : ∀ i, ∃ p : A[X], p.Monic ∧ (∀ j, p.coeff j ∈ S.plus) ∧
      IsTopologicallyNilpotent (p.eval₂ f.toRingHom (π.toRingHom (Pair.polydiscVar n A i)))) :
    f.toRingHom.Finite := by
  classical
  obtain ⟨B₀, hopen, -, -, m, g, hg⟩ := exists_subring_of_forall_exists_monic hπ hπf hmonic
  obtain ⟨ϖ, hϖ⟩ := IsTateRing.exists_isPseudoUniformizer (A := A)
  let := f.toRingHom.toAlgebra
  suffices h : Module.Finite A B from h
  refine ⟨⟨Finset.univ.image g, eq_top_iff.mpr fun b _ ↦ ?_⟩⟩
  -- some `f(ϖ)ᴺ b` lies in the open subring `B₀`
  have hlim := (hϖ.map f.continuous_toRingHom).isTopologicallyNilpotent.mul_const b
  rw [zero_mul] at hlim
  obtain ⟨N, hN⟩ := (hlim.eventually_mem (hopen.mem_nhds (zero_mem _))).exists
  obtain ⟨c, hc⟩ := hg _ hN
  have h1 : f.toRingHom (↑hϖ.isUnit.unit⁻¹ ^ N) * f.toRingHom ϖ ^ N = 1 := by
    rw [← map_pow, ← map_mul, ← mul_pow, hϖ.isUnit.val_inv_mul, one_pow, map_one]
  have hb : b = ∑ j, (↑hϖ.isUnit.unit⁻¹ ^ N * c j) • g j := by
    simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra, map_mul, mul_assoc,
      ← Finset.mul_sum, ← hc]
    rw [← mul_assoc, h1, one_mul]
  rw [hb]
  exact Submodule.sum_mem _ fun j _ ↦ Submodule.smul_mem _ _
    (Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem g (Finset.mem_univ j))))

/-- **Sufficiency in Huber's Lemma 1.4.3.** If every `tᵢ = π(Tᵢ)` has a monic `pᵢ ∈ A⁺[X]` with
`pᵢ(tᵢ)` topologically nilpotent, then `f` is finite. -/
private theorem isFinite_of_forall_exists_monic (hπ : π.IsQuotientMapping)
    (hπf : π.comp (S.weightedCompletionHom isWeightFamily_one_weight) = f)
    (hmonic : ∀ i, ∃ p : A[X], p.Monic ∧ (∀ j, p.coeff j ∈ S.plus) ∧
      IsTopologicallyNilpotent (p.eval₂ f.toRingHom (π.toRingHom (Pair.polydiscVar n A i)))) :
    f.IsFinite := by
  obtain ⟨B₀, hopen, htB₀, hint, -⟩ := exists_subring_of_forall_exists_monic hπ hπf hmonic
  refine ⟨isTopologicallyFiniteType_iff.mpr ⟨n, fun _ ↦ {1}, fun _ ↦ Set.finite_singleton 1,
    isWeightFamily_one_weight, π, hπ, hπf⟩,
    (finite_toRingHom_of_forall_exists_monic hπ hπf hmonic).to_isIntegral, fun b hb ↦ ?_⟩
  -- `B⁺` is the integral closure of `π(A⁺⟨T⟩)`, and `π(A⁺⟨T⟩)` lies in `A⁺[t] + B₀`
  refine (Subring.integralClosure_subring_le_iff
    (T := (integralClosure (S.plus.map f.toRingHom) B).toSubring)).mpr ?_ (hπ.mem_plus_iff.mp hb)
  have hE : Subring.closure ((S.plus.map f.toRingHom : Set B) ∪
      Set.range fun i ↦ π.toRingHom (Pair.polydiscVar n A i)) ≤
        (integralClosure (S.plus.map f.toRingHom) B).toSubring := by
    refine Subring.closure_le.mpr ?_
    rintro _ (⟨a, ha, rfl⟩ | ⟨i, rfl⟩)
    · exact Subalgebra.algebraMap_mem _ (⟨_, a, ha, rfl⟩ : S.plus.map f.toRingHom)
    · exact hint _ (htB₀ i)
  rintro _ ⟨x, hx, rfl⟩
  have hx' : x ∈ S.polydiscPlus n := hx
  rw [Pair.polydiscPlus_eq_topologicalClosure] at hx'
  have hcl := image_topologicalClosure_closure_subset hπf S.plus ⟨x, hx', rfl⟩
  rw [SetLike.mem_coe, ← SetLike.mem_coe, Subring.topologicalClosure_coe] at hcl
  obtain ⟨e, heE, he⟩ := mem_closure_iff_nhds_zero.mp hcl _ (hopen.mem_nhds (zero_mem B₀))
  rw [← sub_sub_cancel e (π.toRingHom x)]
  exact sub_mem (hE heE) (hint _ he)

/-- **Huber's Lemma 1.4.3.** Let `(A, A⁺)` be a complete Hausdorff Tate pair and `f : (A, A⁺) →
(B, B⁺)` a morphism into a Hausdorff pair presented by a quotient mapping
`π : A⟨T₁, …, Tₙ⟩ → B`. Then `f` is finite exactly when every `tᵢ = π(Tᵢ)` has a monic
`pᵢ ∈ A⁺[X]` with `pᵢ(tᵢ)` topologically nilpotent in `B`. -/
theorem isFinite_iff_forall_exists_monic (hπ : π.IsQuotientMapping)
    (hπf : π.comp (S.weightedCompletionHom isWeightFamily_one_weight) = f) :
    f.IsFinite ↔ ∀ i, ∃ p : A[X], p.Monic ∧ (∀ j, p.coeff j ∈ S.plus) ∧
      IsTopologicallyNilpotent (p.eval₂ f.toRingHom (π.toRingHom (Pair.polydiscVar n A i))) := by
  refine ⟨fun hf i ↦ ?_, isFinite_of_forall_exists_monic hπ hπf⟩
  -- a finite morphism makes `tᵢ ∈ B⁺` integral over `A⁺`
  obtain ⟨q, hq, hqt⟩ := hf.isIntegral_restrict
    ⟨π.toRingHom (Pair.polydiscVar n A i), π.map_mem_plus _ (S.polydiscVar_mem_polydiscPlus n i)⟩
  refine ⟨q.map S.plus.subtype, hq.map _, fun j ↦ by simp [coeff_map], ?_⟩
  have hcomp : U.plus.subtype.comp (f.toRingHom.restrict S.plus U.plus f.map_mem_plus) =
      f.toRingHom.comp S.plus.subtype := RingHom.ext fun _ ↦ rfl
  have h := congrArg U.plus.subtype hqt
  rw [hom_eval₂, hcomp, map_zero, Subring.coe_subtype] at h
  rw [eval₂_map, h]
  exact .zero

/-- **A finite morphism of Huber pairs from a complete Hausdorff Tate pair into a Hausdorff pair
is module-finite**: the target ring is a finite module over the source ring (Zavyalov,
Lemma B.2.9). -/
theorem IsFinite.finite (hf : f.IsFinite) : f.toRingHom.Finite := by
  obtain ⟨m, π, hπ, hπf⟩ := hf.isTopologicallyFiniteType.exists_isQuotientMapping_one_weight
  exact finite_toRingHom_of_forall_exists_monic hπ hπf
    ((isFinite_iff_forall_exists_monic hπ hπf).mp hf)

end Pair.Hom

