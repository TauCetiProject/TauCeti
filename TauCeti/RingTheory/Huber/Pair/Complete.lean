/-!
# Completeness of rings of integral elements

In a uniform Huber ring, every ring of integral elements `A⁺` is bounded. If the ambient
ring is complete and Hausdorff, `A⁺` is complete for the ideal generated by any
pseudouniformiser it contains. Its subspace topology is the corresponding adic topology.
In a Tate ring, `A⁺` is then also complete for any topologically nilpotent element, such as `p`
when `p` is topologically nilpotent, since some power of that element is divisible by a
pseudouniformiser. These facts allow integral constructions to be made on an arbitrary plus
ring, not only on `A°`. Adic completeness also upgrades surjectivity of Frobenius modulo `p`
in `A⁺` to roots modulo `ϖ p` whenever `ϖ ^ p ∣ p` in `A⁺`.

Inverting the pseudouniformiser recovers the ambient ring by
`Subring.isLocalizationAway_of_isOpen`; this requires only openness, not uniformity or
completeness. In a nonzero Hausdorff uniform ring, no topologically nilpotent element can
be a unit of `A⁺`. In particular, a topologically nilpotent prime satisfies the nonunit
hypothesis used in the integral tilt and Fontaine's map.

## Main results

* `TauCeti.Huber.IsRingOfIntegralElements.isBounded`: a plus ring in a uniform ring is bounded.
* `TauCeti.Huber.IsRingOfIntegralElements.isAdicComplete_span_singleton`: completeness for a
  pseudouniformiser.
* `IsRingOfIntegralElements.isAdicComplete_span_singleton_of_isTopologicallyNilpotent`: in a
  Tate ring, completeness for any topologically nilpotent element, and in particular `p`-adic
  completeness (`isAdicComplete_span_natCast`) when `p` is topologically nilpotent.
* `TauCeti.Huber.IsRingOfIntegralElements.not_isUnit_of_isTopologicallyNilpotent`: exclusion of
  topologically nilpotent units in the plus ring, such as `p`
  (`not_isUnit_natCast_of_isTopologicallyNilpotent`).

## References

* [Wedhorn, *Adic Spaces*][wedhorn_adic], Proposition 6.14 and Definition 7.14.
* B. Bhatt, M. Morrow, P. Scholze, *Integral p-adic Hodge theory*, §3.1.
-/

public section

open Topology

namespace TauCeti.Huber

variable {A : Type*} [CommRing A] [TopologicalSpace A] [NonarchimedeanRing A]
  [IsUniform A] {Aplus : Subring A}

/-- A ring of integral elements in a uniform ring is bounded, since it is contained in `A°`. -/
theorem IsRingOfIntegralElements.isBounded (h : IsRingOfIntegralElements Aplus) :
    IsBounded (Aplus : Set A) :=
  IsUniform.isBounded_powerBoundedSubring.subset h.le_powerBoundedSubring

/-- In a nonzero Hausdorff uniform ring, a topologically nilpotent element is not a unit of
any ring of integral elements. Neither completeness nor the Tate hypothesis is needed. -/
theorem IsRingOfIntegralElements.not_isUnit_of_isTopologicallyNilpotent
    [T2Space A] [Nontrivial A] (h : IsRingOfIntegralElements Aplus) {a : Aplus}
    (ha : IsTopologicallyNilpotent (a : A)) : ¬ IsUnit a :=
  Aplus.not_isUnit_of_isTopologicallyNilpotent h.isBounded ha

/-- In a nonzero Hausdorff uniform ring in which `p` is topologically nilpotent, `p` is not a unit
of any ring of integral elements. -/
theorem IsRingOfIntegralElements.not_isUnit_natCast_of_isTopologicallyNilpotent
    [T2Space A] [Nontrivial A]
    (h : IsRingOfIntegralElements Aplus) (p : ℕ) (hp : IsTopologicallyNilpotent (p : A)) :
    ¬ IsUnit (p : Aplus) :=
  h.not_isUnit_of_isTopologicallyNilpotent (by simpa using hp)

end TauCeti.Huber

namespace TauCeti.Huber

variable {A : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A]
  [NonarchimedeanRing A] [IsUniform A] [CompleteSpace A] [T0Space A]
  {Aplus : Subring A}

/-- A ring of integral elements in a complete Hausdorff uniform ring is complete and separated
for the ideal generated by any pseudouniformiser it contains. The ambient ring need not come
with a chosen pair of definition. -/
theorem IsRingOfIntegralElements.isAdicComplete_span_singleton
    (h : IsRingOfIntegralElements Aplus) (a : Aplus) (ha : IsPseudoUniformizer (a : A)) :
    IsAdicComplete (Ideal.span {a}) Aplus :=
  Aplus.isAdicComplete_span_singleton h.isOpen h.isBounded a ha

/-- A ring of integral elements in a complete Hausdorff uniform Tate ring is complete and
separated for the ideal generated by any of its topologically nilpotent elements, such as `p`
when `p` is topologically nilpotent. -/
theorem IsRingOfIntegralElements.isAdicComplete_span_singleton_of_isTopologicallyNilpotent
    [IsTateRing A] (h : IsRingOfIntegralElements Aplus) {a : Aplus}
    (ha : IsTopologicallyNilpotent (a : A)) : IsAdicComplete (Ideal.span {a}) Aplus := by
  obtain ⟨ϖ, hϖ⟩ := IsTateRing.exists_isPseudoUniformizer (A := A)
  have hϖA : ϖ ∈ Aplus := h.mem_of_isTopologicallyNilpotent hϖ.isTopologicallyNilpotent
  have := h.isAdicComplete_span_singleton ⟨ϖ, hϖA⟩ hϖ
  obtain ⟨u, hu⟩ := hϖ.isUnit
  -- `a ^ n ϖ⁻¹ → 0`, so `ϖ` divides `a ^ n` in `A⁺` for some `n > 0`
  have ht : Filter.Tendsto (fun n ↦ (a : A) ^ n * ↑u⁻¹) Filter.atTop (𝓝 0) := by
    simpa using ha.mul_const (↑u⁻¹ : A)
  obtain ⟨n, hmem, hn⟩ :=
    ((ht.eventually (h.isOpen.mem_nhds Aplus.zero_mem)).and (Filter.eventually_gt_atTop 0)).exists
  have hdvd : (⟨ϖ, hϖA⟩ : Aplus) ∣ a ^ n :=
    ⟨⟨_, hmem⟩, Subtype.ext <| by simp [← hu, mul_comm (u : A)]⟩
  have := IsAdicComplete.span_singleton_of_dvd (M := Aplus) hdvd
  -- the `a ^ n`-adic and `a`-adic topologies agree
  refine IsAdicComplete.of_pow_le_of_pow_le (I := Ideal.span {a ^ n}) (k := n) (l := 1) ?_ ?_
  · rw [Ideal.span_singleton_pow]
  · rw [pow_one, Ideal.span_singleton_le_span_singleton]
    exact dvd_pow_self a hn.ne'

/-- A ring of integral elements in a complete Hausdorff uniform Tate ring is `p`-adically complete
when `p` is topologically nilpotent. -/
theorem IsRingOfIntegralElements.isAdicComplete_span_natCast [IsTateRing A]
    (h : IsRingOfIntegralElements Aplus) (p : ℕ) (hp : IsTopologicallyNilpotent (p : A)) :
    IsAdicComplete (Ideal.span {(p : Aplus)}) Aplus :=
  h.isAdicComplete_span_singleton_of_isTopologicallyNilpotent (by simpa using hp)

/-- Surjectivity of Frobenius modulo `p` in a ring of integral elements gives roots modulo
`ϖ p` for every pseudouniformiser with `ϖ ^ p ∣ p` in that ring. -/
theorem IsRingOfIntegralElements.exists_mul_natCast_dvd_sub_pow_of_forall_exists_natCast_dvd_sub_pow
    {p : ℕ} [Fact p.Prime]
    (h : IsRingOfIntegralElements Aplus) {ϖ : Aplus}
    (hϖ : IsPseudoUniformizer (ϖ : A)) (hdvd : ϖ ^ p ∣ (p : Aplus))
    (hs : ∀ x : Aplus, ∃ y : Aplus, (p : Aplus) ∣ x - y ^ p) (x : Aplus) :
    ∃ y : Aplus, ϖ * p ∣ x - y ^ p := by
  have := h.isAdicComplete_span_singleton ϖ hϖ
  have hiff := (tfae_forall_exists_dvd_sub_pow ϖ hdvd).out 2 3
  exact hiff.mp hs x

end TauCeti.Huber
