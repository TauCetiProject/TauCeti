/-!
# Completeness of rings of integral elements

In a uniform Huber ring, every ring of integral elements `A⁺` is bounded. If the ambient
ring is complete and Hausdorff, `A⁺` is complete for the ideal generated by any
pseudouniformiser it contains. Its subspace topology is the corresponding adic topology. In a
Tate ring `A⁺` is also complete for every topologically nilpotent element, which need not be a
pseudouniformiser and may vanish, such as a topologically nilpotent prime `p`.
These facts allow integral constructions to be made on an arbitrary plus ring, not only on
`A°`.

Inverting the pseudouniformiser recovers the ambient ring by
`Subring.isLocalizationAway_of_isOpen`; this requires only openness, not uniformity or
completeness. In a nonzero Hausdorff uniform ring, no topologically nilpotent element can
be a unit of `A⁺`. In particular, a topologically nilpotent prime satisfies the nonunit
hypothesis used in the integral tilt and Fontaine's map.

## Main results

* `TauCeti.Huber.IsRingOfIntegralElements.isBounded`: a plus ring in a uniform ring is bounded.
* `TauCeti.Huber.IsRingOfIntegralElements.isAdicComplete_span_singleton`: completeness for a
  pseudouniformiser.
* `IsRingOfIntegralElements.isAdicComplete_span_singleton_of_isTopologicallyNilpotent`:
  completeness for a topologically nilpotent element of a Tate ring.
* `IsRingOfIntegralElements.isAdicComplete_span_natCast`: completeness for a topologically
  nilpotent natural number.
* `IsRingOfIntegralElements.not_isUnit_natCast`: a topologically nilpotent natural number is
  not a unit of the plus ring.
* `TauCeti.Huber.IsRingOfIntegralElements.not_isUnit_of_isTopologicallyNilpotent`: exclusion of
  topologically nilpotent units in the plus ring.

## References

* [Wedhorn, *Adic Spaces*][wedhorn_adic], Proposition 6.14 and Definition 7.14.
* B. Bhatt, M. Morrow, P. Scholze, *Integral p-adic Hodge theory*, §3.1.
-/

public section

open Topology

namespace TauCeti.Huber

variable {A : Type*} [CommRing A] [TopologicalSpace A] [NonarchimedeanRing A]
  [IsUniform A] {Aplus : Subring A}

/-- A ring of integral elements in a uniform ring is bounded, since it is contained in `A°`. -/
theorem IsRingOfIntegralElements.isBounded (h : IsRingOfIntegralElements Aplus) :
    IsBounded (Aplus : Set A) :=
  IsUniform.isBounded_powerBoundedSubring.subset h.le_powerBoundedSubring

/-- In a nonzero Hausdorff uniform ring, a topologically nilpotent element is not a unit of
any ring of integral elements. Neither completeness nor the Tate hypothesis is needed. -/
theorem IsRingOfIntegralElements.not_isUnit_of_isTopologicallyNilpotent
    [T2Space A] [Nontrivial A] (h : IsRingOfIntegralElements Aplus) {a : Aplus}
    (ha : IsTopologicallyNilpotent (a : A)) : ¬ IsUnit a :=
  Aplus.not_isUnit_of_isTopologicallyNilpotent h.isBounded ha

/-- A topologically nilpotent natural number is not a unit of a ring of integral elements
of a nonzero Hausdorff uniform ring. -/
theorem IsRingOfIntegralElements.not_isUnit_natCast
    [T2Space A] [Nontrivial A] (h : IsRingOfIntegralElements Aplus) {p : ℕ}
    [hpn : Fact (IsTopologicallyNilpotent (p : A))] : ¬IsUnit (p : Aplus) :=
  h.not_isUnit_of_isTopologicallyNilpotent <| by
    rw [Subring.coe_natCast]
    exact hpn.out

end TauCeti.Huber

namespace TauCeti.Huber

variable {A : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A]
  [NonarchimedeanRing A] [IsUniform A] [CompleteSpace A] [T0Space A]
  {Aplus : Subring A}

/-- A ring of integral elements in a complete Hausdorff uniform ring is complete and separated
for the ideal generated by any pseudouniformiser it contains. The ambient ring need not come
with a chosen pair of definition. -/
theorem IsRingOfIntegralElements.isAdicComplete_span_singleton
    (h : IsRingOfIntegralElements Aplus) (a : Aplus) (ha : IsPseudoUniformizer (a : A)) :
    IsAdicComplete (Ideal.span {a}) Aplus :=
  Aplus.isAdicComplete_span_singleton h.isOpen h.isBounded a ha

/-- A ring of integral elements in a complete Hausdorff uniform Tate ring is complete and
separated for the ideal generated by any topologically nilpotent element. The element need not be
a unit of `A`, or even nonzero: some power of it is a multiple of a pseudouniformiser. -/
theorem IsRingOfIntegralElements.isAdicComplete_span_singleton_of_isTopologicallyNilpotent
    [IsTateRing A] (h : IsRingOfIntegralElements Aplus) (a : Aplus)
    (ha : IsTopologicallyNilpotent (a : A)) : IsAdicComplete (Ideal.span {a}) Aplus := by
  obtain ⟨ϖ, hϖ⟩ := IsTateRing.exists_isPseudoUniformizer (A := A)
  obtain ⟨⟨u, rfl⟩, hu⟩ := isPseudoUniformizer_iff.mp hϖ
  have hmem := h.mem_of_isTopologicallyNilpotent hu
  have hopen : IsOpen {x : A | (↑u⁻¹ : A) * x ∈ Aplus} :=
    h.isOpen.preimage (continuous_const.mul continuous_id)
  obtain ⟨n, hn, hn0⟩ := ((ha.eventually_mem (hopen.mem_nhds (by simp))).and
    (Filter.eventually_gt_atTop 0)).exists
  have := h.isAdicComplete_span_singleton ⟨u, hmem⟩ hϖ
  have hpow : IsAdicComplete (Ideal.span {a ^ n}) Aplus :=
    .span_singleton_of_dvd (π := (⟨u, hmem⟩ : Aplus))
      ⟨⟨_, hn⟩, Subtype.ext (by simp)⟩
  rw [← Ideal.span_singleton_pow] at hpow
  exact .of_pow hn0.ne'

/-- A ring of integral elements of a complete Hausdorff uniform Tate ring is `p`-adically
complete and separated when `p` is topologically nilpotent, even though `p` need not be a
pseudouniformiser. -/
theorem IsRingOfIntegralElements.isAdicComplete_span_natCast
    [IsTateRing A] (h : IsRingOfIntegralElements Aplus) {p : ℕ}
    [hpn : Fact (IsTopologicallyNilpotent (p : A))] :
    IsAdicComplete (Ideal.span {(p : Aplus)}) Aplus :=
  h.isAdicComplete_span_singleton_of_isTopologicallyNilpotent _ <| by
    rw [Subring.coe_natCast]
    exact hpn.out

end TauCeti.Huber
