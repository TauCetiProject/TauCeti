module

public import TauCeti.RingTheory.Huber.TopologicallyFiniteType.Comp

/-!
# Morphisms of Huber pairs of +weakly finite type

A morphism `f : (A, A⁺) → (B, B⁺)` of Huber pairs is *of +weakly finite type* (Huber 1996,
Definition 1.2.1(ii)) when its ring homomorphism `A → B` is topologically of finite type and there
is a finite set `E ⊆ B` such that `B⁺` is the smallest ring of integral elements of `B` containing
`f(A⁺)` and `E`: the integral closure of the subring generated by `f(A⁺)`, `E` and the
topologically nilpotent elements of `B` (`TauCeti.Huber.plusClosure`). The set `E` then lies
in `B⁺`.

This is the affinoid condition from which morphisms of adic spaces locally of +weakly finite type
are built, the finiteness condition in Huber's definitions of proper and partially proper
morphisms. It sits between the two notions of topological finite type: a morphism of Huber pairs
topologically of finite type (Wedhorn, Definition 8.42), presented by a quotient mapping out of a
completed weighted restricted power-series pair, is of +weakly finite type, with `E` the images of
the finitely many weighted variables `t Xᵢ`; and the ring homomorphism of a morphism of
+weakly finite type is topologically of finite type (Wedhorn, Proposition and Definition 6.29(i)),
by definition.

## Main definitions

* `TauCeti.Huber.Pair.Hom.IsPlusWeaklyFiniteType`: Huber 1996, Definition 1.2.1(ii).

## Main results

* `TauCeti.Huber.Pair.Hom.isPlusWeaklyFiniteType_of_plus_le`: to check the plus ring condition it
  suffices to check `E ⊆ B⁺` and `B⁺ ⊆ plusClosure (f(A⁺) ∪ E)`, the reverse inclusion being
  automatic (`TauCeti.Huber.Pair.Hom.plusClosure_image_union_le`).
* `TauCeti.Huber.Pair.Hom.IsPlusWeaklyFiniteType.isTopologicallyFiniteType_toRingHom`: the ring
  homomorphism of a morphism of +weakly finite type is topologically of finite type.
* `TauCeti.Huber.Pair.Hom.IsTopologicallyFiniteType.isPlusWeaklyFiniteType`: a morphism of Huber
  pairs topologically of finite type is of +weakly finite type.
* `TauCeti.Huber.Pair.Hom.isPlusWeaklyFiniteType_id`: the identity of a complete Hausdorff Huber
  pair is of +weakly finite type.
* `TauCeti.Huber.Pair.Hom.IsPlusWeaklyFiniteType.comp`: morphisms of +weakly finite type are
  stable under composition, with the union of `E` for the second morphism and the image of `E`
  for the first.

## References

* R. Huber, *Étale cohomology of rigid analytic varieties and adic spaces*, Aspects of
  Mathematics E30 (1996), §1.2, Definition 1.2.1(ii) and the remarks following it.
* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Proposition and
  Definition 6.29, Remark 7.15(2), and Definition 8.42.
-/

public section

open UniformSpace

namespace TauCeti.Huber.Pair.Hom

variable {A B C : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsHuberRing A]
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsHuberRing B]
  [CommRing C] [TopologicalSpace C] [IsTopologicalRing C] [IsHuberRing C]
  {S : Pair A} {U : Pair B} {V : Pair C}

/-- **Huber 1996, Definition 1.2.1(ii)**: a morphism `f : (A, A⁺) → (B, B⁺)` of Huber pairs is
*of +weakly finite type* when its ring homomorphism is topologically of finite type and there is a
finite set `E ⊆ B` such that `B⁺` is the smallest ring of integral elements containing `f(A⁺)`
and `E`, that is, `B⁺ = plusClosure (f(A⁺) ∪ E)`. -/
def IsPlusWeaklyFiniteType (f : Hom S U) : Prop :=
  _root_.TauCeti.Huber.IsTopologicallyFiniteType f.toRingHom ∧
    ∃ E : Finset B, U.plus = plusClosure (f.toRingHom '' S.plus ∪ E)

/-- Unfolding lemma for the sealed definition `TauCeti.Huber.Pair.Hom.IsPlusWeaklyFiniteType`. -/
theorem isPlusWeaklyFiniteType_iff {f : Hom S U} :
    f.IsPlusWeaklyFiniteType ↔
      _root_.TauCeti.Huber.IsTopologicallyFiniteType f.toRingHom ∧
        ∃ E : Finset B, U.plus = plusClosure (f.toRingHom '' S.plus ∪ E) :=
  (Iff.rfl)

/-- **The ring homomorphism of a morphism of +weakly finite type is topologically of finite
type.** -/
theorem IsPlusWeaklyFiniteType.isTopologicallyFiniteType_toRingHom {f : Hom S U}
    (hf : f.IsPlusWeaklyFiniteType) :
    _root_.TauCeti.Huber.IsTopologicallyFiniteType f.toRingHom :=
  (isPlusWeaklyFiniteType_iff.mp hf).1

/-- **Introduction rule for `TauCeti.Huber.Pair.Hom.IsPlusWeaklyFiniteType`**: for a finite set
`E ⊆ B⁺`, the inclusion `plusClosure (f(A⁺) ∪ E) ⊆ B⁺` is automatic
(`TauCeti.Huber.Pair.Hom.plusClosure_image_union_le`), so only the reverse inclusion is to be
checked. -/
theorem isPlusWeaklyFiniteType_of_plus_le {f : Hom S U}
    (hf : _root_.TauCeti.Huber.IsTopologicallyFiniteType f.toRingHom) (E : Finset B)
    (hE : (E : Set B) ⊆ U.plus) (hplus : U.plus ≤ plusClosure (f.toRingHom '' S.plus ∪ E)) :
    f.IsPlusWeaklyFiniteType :=
  isPlusWeaklyFiniteType_iff.mpr ⟨hf, E, le_antisymm hplus (f.plusClosure_image_union_le hE)⟩

/-- **A morphism of Huber pairs topologically of finite type is of +weakly finite type** (Huber
1996, §1.2, the remarks following Definition 1.2.1). If `f` factors through a quotient mapping
`π` out of a completed weighted pair `(A⟨X⟩_T, A⟨X⟩_T⁺)^`, then `B⁺` is the integral closure of
`π(A⟨X⟩_T⁺)`, and `π` carries the generators of `A⟨X⟩_T⁺`, the constants from `A⁺` and the
weighted variables `t Xᵢ` with `t ∈ Tᵢ`, into `plusClosure (f(A⁺) ∪ E)` for `E` the finitely
many images of the weighted variables. -/
theorem IsTopologicallyFiniteType.isPlusWeaklyFiniteType {f : Hom S U}
    (hf : f.IsTopologicallyFiniteType) : f.IsPlusWeaklyFiniteType := by
  obtain ⟨k, T, hTfin, hT, π, hπ, rfl⟩ := isTopologicallyFiniteType_iff.mp hf
  -- the images of the weighted variables, finitely many since each weight `Tᵢ` is finite
  set E : Set B := ⋃ i, (fun t ↦ π.toRingHom ((weightedC T hT t * weightedX T hT i :
    weightedRestrictedSubring T hT) : Completion (weightedRestrictedSubring T hT))) '' T i
  have hEfin : E.Finite := Set.finite_iUnion fun i ↦ (hTfin i).image _
  have hEU : E ⊆ U.plus := Set.iUnion_subset fun i ↦ Set.image_subset_iff.mpr fun t ht ↦
    π.map_mem_plus _ (S.weightedC_mul_weightedX_mem_weighted_completion_plus hT ht)
  refine isPlusWeaklyFiniteType_of_plus_le hf.isTopologicallyFiniteType_toRingHom hEfin.toFinset
    (by rwa [Set.Finite.coe_toFinset]) ?_
  rw [Set.Finite.coe_toFinset]
  -- `plusClosure (f(A⁺) ∪ E)` is a ring of integral elements, since `f(A⁺) ∪ E ⊆ B⁺`
  have hQ := isRingOfIntegralElements_plusClosure fun _ hb ↦
    U.isRingOfIntegralElements.le_powerBoundedSubring
      ((π.comp (S.weightedCompletionHom hT)).plusClosure_image_union_le hEU
        (subset_plusClosure _ hb))
  have := hQ.isIntegrallyClosedIn
  rw [hπ.plus_eq, Subring.integralClosure_subring_le_iff]
  refine Subring.map_le_iff_le_comap.mpr <| S.weighted_completion_plus_le_comap hT ⟨_, hQ⟩
    π.continuous_toRingHom (fun a ha ↦ subset_plusClosure _ (Or.inl ⟨a, ha, ?_⟩))
    fun i t ht ↦ subset_plusClosure _ (Or.inr (Set.mem_iUnion.mpr ⟨i, t, ht, rfl⟩))
  simp [algebraMap_completion_weightedRestrictedSubring_apply]

/-- **The identity of a complete Hausdorff Huber pair is of +weakly finite type**: it is
topologically of finite type, presented with no variables. -/
theorem isPlusWeaklyFiniteType_id {A : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A]
    [IsTopologicalRing A] [CompleteSpace A] [T0Space A] [IsHuberRing A] (S : Pair A) :
    (Hom.id S).IsPlusWeaklyFiniteType :=
  (isTopologicallyFiniteType_id S).isPlusWeaklyFiniteType

/-- **Morphisms of +weakly finite type are stable under composition** (Huber 1996, §1.2, the
remarks following Definition 1.2.1). If `B⁺ = plusClosure (f(A⁺) ∪ E)` and
`C⁺ = plusClosure (g(B⁺) ∪ E')`, then `C⁺ = plusClosure (g(f(A⁺)) ∪ g(E) ∪ E')`, since `g`
carries `plusClosure (f(A⁺) ∪ E)` into `plusClosure (g(f(A⁺)) ∪ g(E))`. -/
theorem IsPlusWeaklyFiniteType.comp {f : Hom S U} {g : Hom U V} (hg : g.IsPlusWeaklyFiniteType)
    (hf : f.IsPlusWeaklyFiniteType) : (g.comp f).IsPlusWeaklyFiniteType := by
  classical
  obtain ⟨hf, E, hE⟩ := isPlusWeaklyFiniteType_iff.mp hf
  obtain ⟨hg, E', hE'⟩ := isPlusWeaklyFiniteType_iff.mp hg
  have hEU : (E : Set B) ⊆ U.plus := hE ▸ fun _ hb ↦ subset_plusClosure _ (Or.inr hb)
  have hE'V : (E' : Set C) ⊆ V.plus := hE' ▸ fun _ hc ↦ subset_plusClosure _ (Or.inr hc)
  have hEV : ((E.image g.toRingHom ∪ E' : Finset C) : Set C) ⊆ V.plus := by
    rw [Finset.coe_union, Finset.coe_image]
    exact Set.union_subset (Set.image_subset_iff.mpr fun _ hb ↦ g.map_mem_plus _ (hEU hb)) hE'V
  refine isPlusWeaklyFiniteType_of_plus_le (by rw [toRingHom_comp]; exact hg.comp hf) _ hEV ?_
  set X := (g.comp f).toRingHom '' S.plus ∪ ↑(E.image g.toRingHom ∪ E')
  -- `plusClosure X` is a ring of integral elements, since `X ⊆ C⁺`
  have hQ := isRingOfIntegralElements_plusClosure fun _ hc ↦
    V.isRingOfIntegralElements.le_powerBoundedSubring
      ((g.comp f).plusClosure_image_union_le hEV (subset_plusClosure X hc))
  have := hQ.isIntegrallyClosedIn
  -- `g(f(A⁺) ∪ E) ⊆ X`
  have hgX : g.toRingHom '' (f.toRingHom '' S.plus ∪ E) ⊆ plusClosure X := by
    rintro _ ⟨b, hb | hb, rfl⟩
    · obtain ⟨a, ha, rfl⟩ := hb
      exact subset_plusClosure X (Or.inl ⟨a, ha, by simp⟩)
    · exact subset_plusClosure X
        (Or.inr (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hb))))
  -- `g(B⁺) ⊆ plusClosure (g(f(A⁺) ∪ E)) ⊆ plusClosure X`
  have hgU : g.toRingHom '' U.plus ⊆ plusClosure X := by
    rintro _ ⟨b, hb, rfl⟩
    rw [hE] at hb
    exact plusClosure_le hQ.isOpen hgX
      (map_plusClosure_le g.continuous_toRingHom _ ⟨b, hb, rfl⟩)
  rw [hE']
  exact plusClosure_le hQ.isOpen <| Set.union_subset hgU fun _ hc ↦
    subset_plusClosure X (Or.inr (Finset.mem_coe.mpr (Finset.mem_union_right _ hc)))

end TauCeti.Huber.Pair.Hom
