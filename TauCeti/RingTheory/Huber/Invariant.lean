/-!
# The invariant Huber pair of a finite group action

Let `G` be a finite group acting by continuous ring automorphisms on a Huber or Tate ring `A`, with
no condition on the order `|G|` (the residue characteristic may divide `|G|`). Equip the fixed
subring `Aᴳ = FixedPoints.subring A G` with the subspace topology. This file develops the basic
Huber-pair theory of `Aᴳ`:

* When `A` is Hausdorff, `Aᴳ` is closed (`FixedPoints.isClosed_subring`), hence complete whenever
  `A` is complete (`FixedPoints.completeSpace_subring`).
* The orbit product `N(a) = ∏ g, g • a` carries topologically nilpotent elements to topologically
  nilpotent elements and pseudouniformisers to pseudouniformisers of both `A` and `Aᴳ`
  (`TauCeti.Huber.isPseudoUniformizer_coe_orbitProd`,
  `TauCeti.Huber.isPseudoUniformizer_orbitProd`).
* Every Huber ring with a continuous action of a finite group `G` admits a `G`-stable ring of
  definition (`TauCeti.Huber.exists_pairOfDefinition_smul_mem`), constructed as the subring
  generated by the translates of any ring of definition.
* When `A` is a Tate ring, `Aᴳ` is again a Tate ring (`TauCeti.Huber.isTateRing_fixedPoints`),
  intersecting a `G`-stable ring of definition with `Aᴳ` gives a ring of definition of `Aᴳ`
  (`TauCeti.Huber.exists_pairOfDefinition_fixedPoints`), power-bounded elements agree:
  `(Aᴳ)° = A° ∩ Aᴳ` (`TauCeti.Huber.powerBoundedSubring_fixedPoints`), and the integral closure in
  `A` of any open subring of `Aᴳ` is open in `A`
  (`TauCeti.Huber.isOpen_integralClosure_map_subtype_fixedPoints`).
* For a Huber pair `P = (A, A⁺)` on a Tate ring `A`, the pair
  `P.invariant G = (Aᴳ, A⁺ ∩ Aᴳ)` is a Tate–Huber pair (`TauCeti.Huber.Pair.invariant`), without
  assuming that `G` preserves `A⁺`. When `G` does preserve `A⁺`, `A⁺` is the integral closure of
  `A⁺ ∩ Aᴳ` in `A` (`TauCeti.Huber.Pair.plus_eq_integralClosure_invariant`).
* The construction is functorial in `G`-equivariant morphisms of Huber pairs
  (`TauCeti.Huber.Pair.Hom.invariant`) and in restriction to subgroups `H ≤ G`
  (`TauCeti.Huber.Pair.invariantSubgroup`).

## Main definitions

* `TauCeti.Huber.Pair.invariant`: the invariant Huber pair `(Aᴳ, A⁺ ∩ Aᴳ)`.
* `TauCeti.Huber.Pair.invariantInclusion`: the canonical inclusion `(Aᴳ, A⁺ ∩ Aᴳ) → (A, A⁺)`.
* `TauCeti.Huber.Pair.Hom.invariant`: restriction of a `G`-equivariant morphism of Huber pairs to
  invariant pairs.
* `TauCeti.Huber.Pair.invariantSubgroup`: the canonical inclusion `(Aᴳ, A⁺ ∩ Aᴳ) → (Aᴴ, A⁺ ∩ Aᴴ)`
  for a subgroup `H ≤ G`.

## Main results

* `FixedPoints.isClosed_subring`, `FixedPoints.completeSpace_subring`: `Aᴳ` is closed in a
  Hausdorff ring and complete in a complete Hausdorff ring.
* `TauCeti.Huber.isPseudoUniformizer_coe_orbitProd`,
  `TauCeti.Huber.isPseudoUniformizer_orbitProd`: the orbit product of a pseudouniformiser is a
  pseudouniformiser of `A` and of `Aᴳ`.
* `TauCeti.Huber.exists_pairOfDefinition_smul_mem`: every Huber ring with a continuous finite group
  action admits a `G`-stable ring of definition.
* `TauCeti.Huber.isTateRing_fixedPoints`: `Aᴳ` is a Tate ring.
* `TauCeti.Huber.powerBoundedSubring_fixedPoints`: `(Aᴳ)° = A° ∩ Aᴳ`.
* `TauCeti.Huber.isOpen_integralClosure_map_subtype_fixedPoints`: the integral closure in `A` of an
  open subring of `Aᴳ` is open in `A`.
* `TauCeti.Huber.Pair.plus_eq_integralClosure_invariant`: when `G` preserves `A⁺`, `A⁺` is the
  integral closure of `A⁺ ∩ Aᴳ` in `A`.

## References

* D. Hansen, *Quotients of adic spaces by finite groups*, Math. Res. Lett. 28 (2021), §2 and
  proofs of Theorems 3.1 and 3.3.
-/

public section

open Filter Topology TauCeti

namespace FixedPoints

/-- The fixed subring of a continuous monoid action on a Hausdorff ring is closed. -/
theorem isClosed_subring {A G : Type*} [Ring A] [TopologicalSpace A] [T2Space A] [Monoid G]
    [MulSemiringAction G A] [ContinuousConstSMul G A] :
    IsClosed (FixedPoints.subring A G : Set A) :=
  isClosed_fixedPoints_of_continuousConstSMul

/-- The fixed subring of a continuous monoid action on a complete Hausdorff ring is complete. -/
instance completeSpace_subring {A G : Type*} [Ring A] [UniformSpace A] [CompleteSpace A]
    [T2Space A] [Monoid G] [MulSemiringAction G A] [ContinuousConstSMul G A] :
    CompleteSpace (FixedPoints.subring A G) :=
  isClosed_subring.completeSpace_coe

end FixedPoints

namespace TauCeti.Huber

section OrbitProd

variable (G : Type*) {A : Type*} [Group G] [Fintype G] [CommRing A] [TopologicalSpace A]
  [ContinuousMul A] [MulSemiringAction G A] [ContinuousConstSMul G A]

/-- The orbit product `N(a) = ∏ g, g • a` of a topologically nilpotent element is topologically
nilpotent in `A`. -/
theorem isTopologicallyNilpotent_coe_orbitProd {a : A} (ha : IsTopologicallyNilpotent a) :
    IsTopologicallyNilpotent (MulSemiringAction.orbitProd G a : A) := by
  have h := tendsto_finsetProd (Finset.univ : Finset G) fun g _ ↦
    ha.map (φ := MulSemiringAction.toRingHom G A g) (continuous_const_smul g)
  have hzero : (∏ _ : G, (0 : A)) = 0 :=
    Finset.prod_eq_zero (Finset.mem_univ (1 : G)) rfl
  simpa only [IsTopologicallyNilpotent, MulSemiringAction.coe_orbitProd, Finset.prod_pow,
    MulSemiringAction.toRingHom_apply, hzero] using h

/-- The orbit product `N(a)` of a topologically nilpotent element is topologically nilpotent in the
fixed subring `Aᴳ`. -/
theorem isTopologicallyNilpotent_orbitProd {a : A} (ha : IsTopologicallyNilpotent a) :
    IsTopologicallyNilpotent (MulSemiringAction.orbitProd G a) :=
  isTopologicallyNilpotent_mk (MulSemiringAction.orbitProd G a).2
    (isTopologicallyNilpotent_coe_orbitProd G ha)

/-- The orbit product `N(ϖ)` of a pseudouniformiser is a `G`-invariant pseudouniformiser of `A`. -/
theorem isPseudoUniformizer_coe_orbitProd {ϖ : A} (hϖ : IsPseudoUniformizer ϖ) :
    IsPseudoUniformizer (MulSemiringAction.orbitProd G ϖ : A) :=
  isPseudoUniformizer_iff.mpr
    ⟨((MulSemiringAction.isUnit_orbitProd_iff G).mpr hϖ.isUnit).map
        (FixedPoints.subring A G).subtype,
      isTopologicallyNilpotent_coe_orbitProd G hϖ.isTopologicallyNilpotent⟩

/-- The orbit product `N(ϖ)` of a pseudouniformiser of `A` is a pseudouniformiser of `Aᴳ`. -/
theorem isPseudoUniformizer_orbitProd {ϖ : A} (hϖ : IsPseudoUniformizer ϖ) :
    IsPseudoUniformizer (MulSemiringAction.orbitProd G ϖ) :=
  isPseudoUniformizer_iff.mpr
    ⟨(MulSemiringAction.isUnit_orbitProd_iff G).mpr hϖ.isUnit,
      isTopologicallyNilpotent_orbitProd G hϖ.isTopologicallyNilpotent⟩

end OrbitProd

section StableRingOfDefinition

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsHuberRing A]

/-- **Existence of a `G`-stable ring of definition.** Every Huber ring with a continuous action of
a finite group `G` admits a pair of definition whose ring of definition is preserved by `G`. -/
theorem exists_pairOfDefinition_smul_mem (G : Type*) [Group G] [Finite G]
    [MulSemiringAction G A] [ContinuousConstSMul G A] :
    ∃ P : PairOfDefinition A, ∀ g : G, ∀ a ∈ P.ringOfDefinition, g • a ∈ P.ringOfDefinition := by
  classical
  cases nonempty_fintype G
  obtain ⟨P₀⟩ := IsHuberRing.nonempty_pairOfDefinition (A := A)
  have := P₀.toNonarchimedeanRing
  let R : G → Subring A := fun g ↦ P₀.ringOfDefinition.map (MulSemiringAction.toRingHom G A g)
  have hR_bdd : ∀ g : G, IsBounded (R g : Set A) := fun g ↦ by
    let e : A ≃+* A :=
      { MulSemiringAction.toRingHom G A g with
        invFun := MulSemiringAction.toRingHom G A g⁻¹
        left_inv := inv_smul_smul g
        right_inv := smul_inv_smul g }
    simpa [R, e] using P₀.isBounded_ringOfDefinition.image_ringEquiv e
      (continuous_const_smul g) (continuous_const_smul g⁻¹)
  let B : Subring A := Finset.univ.sup R
  have hB_bdd : IsBounded (B : Set A) := by
    suffices ∀ s : Finset G, IsBounded ((s.sup R : Subring A) : Set A) from this Finset.univ
    intro s
    induction s using Finset.induction_on with
    | empty =>
      exact P₀.isBounded_ringOfDefinition.subset (bot_le : (⊥ : Subring A) ≤ P₀.ringOfDefinition)
    | insert g s _ ih =>
      rw [Finset.sup_insert]
      exact isBounded_sup (R g) (s.sup R) (hR_bdd g) ih
  have hle : P₀.ringOfDefinition ≤ B := by
    have h1 : R 1 = P₀.ringOfDefinition := by
      ext a
      simp [R]
    exact h1 ▸ Finset.le_sup (f := R) (Finset.mem_univ (1 : G))
  have hB_open : IsOpen (B : Set A) :=
    AddSubgroup.isOpen_of_mem_nhds B.toAddSubgroup <|
      Filter.mem_of_superset (P₀.isOpen_ringOfDefinition.mem_nhds P₀.ringOfDefinition.zero_mem) hle
  obtain ⟨P, hP⟩ := exists_pairOfDefinition_ringOfDefinition_eq B hB_open hB_bdd
  refine ⟨P, fun g a ha ↦ ?_⟩
  rw [hP] at ha ⊢
  have hmap : B.map (MulSemiringAction.toRingHom G A g) ≤ B := by
    rw [Subring.map_le_iff_le_comap]
    refine Finset.sup_le fun h _ ↦ ?_
    rw [← Subring.map_le_iff_le_comap, Subring.map_map]
    have hcomp : (MulSemiringAction.toRingHom G A g).comp (MulSemiringAction.toRingHom G A h) =
        MulSemiringAction.toRingHom G A (g * h) :=
      RingHom.ext fun x ↦ (mul_smul g h x).symm
    rw [hcomp]
    exact Finset.le_sup (f := R) (Finset.mem_univ (g * h))
  exact hmap (Subring.mem_map.mpr ⟨a, ha, rfl⟩)

end StableRingOfDefinition

section Tate

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]

/-- **The fixed subring of a Tate ring under a continuous finite group action is a Tate ring.**
The orbit product of a pseudouniformiser supplies a pseudouniformiser in `Aᴳ` whose inverse also
lies in `Aᴳ`. -/
instance isTateRing_fixedPoints {G : Type*} [Group G] [Finite G] [MulSemiringAction G A]
    [ContinuousConstSMul G A] : IsTateRing (FixedPoints.subring A G) := by
  cases nonempty_fintype G
  obtain ⟨ϖ, hϖ⟩ := IsTateRing.exists_isPseudoUniformizer (A := A)
  obtain ⟨u, hu⟩ := (isPseudoUniformizer_orbitProd G hϖ).isUnit
  exact (FixedPoints.subring A G).isTateRing_of_isPseudoUniformizer
    (Units.map (FixedPoints.subring A G).subtype.toMonoidHom u)
    (by simpa [hu] using isPseudoUniformizer_coe_orbitProd G hϖ)
    (by simp)
    (by simp)

/-- For a continuous action of a finite group `G` on a Tate ring `A`, there is a `G`-stable ring of
definition `A₀` of `A` whose intersection `A₀ ∩ Aᴳ` is a ring of definition of `Aᴳ`. -/
theorem exists_pairOfDefinition_fixedPoints (G : Type*) [Group G] [Finite G]
    [MulSemiringAction G A] [ContinuousConstSMul G A] :
    ∃ (P : PairOfDefinition A) (Q : PairOfDefinition (FixedPoints.subring A G)),
      (∀ g : G, ∀ a ∈ P.ringOfDefinition, g • a ∈ P.ringOfDefinition) ∧
        Q.ringOfDefinition = P.ringOfDefinition.comap (FixedPoints.subring A G).subtype := by
  obtain ⟨P, hP⟩ := exists_pairOfDefinition_smul_mem G (A := A)
  obtain ⟨Q, hQ⟩ := (FixedPoints.subring A G).exists_pairOfDefinition_comap P
  exact ⟨P, Q, hP, hQ⟩

/-- **Power-bounded elements of the fixed subring.** For a continuous action of a finite group `G`
on a Tate ring `A`, `(Aᴳ)° = A° ∩ Aᴳ`. -/
theorem powerBoundedSubring_fixedPoints (G : Type*) [Group G] [Finite G] [MulSemiringAction G A]
    [ContinuousConstSMul G A] :
    powerBoundedSubring (FixedPoints.subring A G) =
      (powerBoundedSubring A).comap (FixedPoints.subring A G).subtype := by
  cases nonempty_fintype G
  obtain ⟨ϖ, hϖ⟩ := IsTateRing.exists_isPseudoUniformizer (A := A)
  obtain ⟨u, hu⟩ := (isPseudoUniformizer_coe_orbitProd G hϖ).isUnit
  exact (FixedPoints.subring A G).powerBoundedSubring_eq_comap u
    (hu ▸ isPseudoUniformizer_coe_orbitProd G hϖ)
    (hu ▸ (MulSemiringAction.orbitProd G ϖ).2)

open scoped Pointwise in
/-- For a `G`-stable subring `C` of `A`, a `G`-invariant element `s ∈ C`, and a subring `R` of
`Aᴳ` containing every `G`-invariant element of `s • C`, every element of `s • C` is integral over
the image of `R` in `A`. -/
private theorem isIntegral_map_subtype_of_smul_subset {A G : Type*} [CommRing A] [Group G]
    [Finite G] [MulSemiringAction G A] {C : Subring A} (hC : ∀ g : G, ∀ a ∈ C, g • a ∈ C)
    {s : A} (hsC : s ∈ C) (hs_fix : ∀ g : G, g • s = s) {R : Subring (FixedPoints.subring A G)}
    (hsub : ∀ x : FixedPoints.subring A G, (x : A) ∈ s • (C : Set A) → x ∈ R)
    {c : A} (hc : c ∈ C) :
    IsIntegral (R.map (FixedPoints.subring A G).subtype) (s * c) := by
  cases nonempty_fintype G
  let : IsInvariantSubring G C := ⟨fun g _ hb ↦ hC g _ hb⟩
  set S := R.map (FixedPoints.subring A G).subtype
  set s' : C := ⟨s, hsC⟩
  set c' : C := ⟨c, hc⟩
  set I : Ideal C := Ideal.span {s'}
  set p : Polynomial C := MulSemiringAction.charpoly G (s' * c')
  -- Modulo `I = (s')`, every `g • s' = s'` vanishes, so `p ≡ X ^ |G|`.
  have hmod : (p - Polynomial.X ^ Fintype.card G).map (Ideal.Quotient.mk I) = 0 := by
    have hmem : ∀ g : G, Ideal.Quotient.mk I (g • s') = 0 := fun g ↦
      Ideal.Quotient.eq_zero_iff_mem.mpr <| by
        rw [show g • s' = s' from Subtype.ext (hs_fix g)]
        exact Ideal.subset_span rfl
    simp [p, MulSemiringAction.charpoly_eq, Polynomial.map_prod, hmem]
  have hcoeff : ∀ n : ℕ, ((p.map C.subtype).coeff n) ∈ Set.range S.subtype := fun n ↦ by
    have hI : (p - Polynomial.X ^ Fintype.card G).coeff n ∈ I :=
      Ideal.Quotient.eq_zero_iff_mem.mp <| by
        rw [← Polynomial.coeff_map, hmod, Polynomial.coeff_zero]
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp hI
    have hfix : ∀ g : G, g • ((p - Polynomial.X ^ Fintype.card G).coeff n : A) =
        ((p - Polynomial.X ^ Fintype.card G).coeff n : A) := fun g ↦ by
      have hg : g • (p - Polynomial.X ^ Fintype.card G) = p - Polynomial.X ^ Fintype.card G := by
        rw [smul_sub, MulSemiringAction.smul_charpoly, smul_pow', Polynomial.smul_X]
      have hcoeff_fix :
          g • (p - Polynomial.X ^ Fintype.card G).coeff n =
            (p - Polynomial.X ^ Fintype.card G).coeff n := by
        rw [← AddMonoidAlgebra.coeff_smul_apply g, hg]
      exact congrArg Subtype.val hcoeff_fix
    have hmemR : (⟨_, hfix⟩ : FixedPoints.subring A G) ∈ R :=
      hsub ⟨_, hfix⟩ ⟨(d : A), d.2, by simpa [s', smul_eq_mul] using (congrArg Subtype.val hd).symm⟩
    have h1 : (((p - Polynomial.X ^ Fintype.card G).coeff n : C) : A) ∈ S :=
      Subring.mem_map.mpr ⟨⟨_, hfix⟩, hmemR, rfl⟩
    have h2 : (((Polynomial.X ^ Fintype.card G : Polynomial C).coeff n : C) : A) ∈ S := by
      rw [Polynomial.coeff_X_pow]
      split_ifs <;> simp [S.zero_mem, S.one_mem]
    refine ⟨⟨_, S.add_mem h1 h2⟩, ?_⟩
    simp [Polynomial.coeff_map]
  obtain ⟨q, hq⟩ := (Polynomial.mem_lifts _).mp ((Polynomial.lifts_iff_coeff_lifts _).mpr hcoeff)
  refine ⟨q, Polynomial.monic_of_injective (f := S.subtype) Subtype.val_injective ?_, ?_⟩
  · rw [hq]
    exact (MulSemiringAction.monic_charpoly G (s' * c')).map C.subtype
  · change Polynomial.eval₂ S.subtype (s * c) q = 0
    rw [Polynomial.eval₂_eq_eval_map, hq, show s * c = C.subtype (s' * c') from rfl,
      Polynomial.eval_map_apply, MulSemiringAction.eval_charpoly, map_zero]

/-- **Openness of the integral closure of an open subring of `Aᴳ`.** For a continuous action of a
finite group `G` on a Tate ring `A` and an open subring `R` of `Aᴳ`, the integral closure of the
image of `R` in `A` is open in `A`. -/
theorem isOpen_integralClosure_map_subtype_fixedPoints {G : Type*} [Group G] [Finite G]
    [MulSemiringAction G A] [ContinuousConstSMul G A]
    {R : Subring (FixedPoints.subring A G)} (hR : IsOpen (R : Set (FixedPoints.subring A G))) :
    IsOpen ((integralClosure (R.map (FixedPoints.subring A G).subtype) A).toSubring : Set A) := by
  cases nonempty_fintype G
  obtain ⟨P, hP⟩ := exists_pairOfDefinition_smul_mem G (A := A)
  obtain ⟨ϖ₀, hϖ₀⟩ := IsTateRing.exists_isPseudoUniformizer (A := A)
  set ϖ : A := (MulSemiringAction.orbitProd G ϖ₀ : A)
  have hϖ : IsPseudoUniformizer ϖ := isPseudoUniformizer_coe_orbitProd G hϖ₀
  have hϖ_fix : ∀ g : G, g • ϖ = ϖ := (MulSemiringAction.orbitProd G ϖ₀).2
  obtain ⟨m, hm⟩ := Filter.eventually_atTop.mp (hϖ.eventually_pow_mem_ringOfDefinition P)
  set π : A := ϖ ^ (m + 1)
  have hπC : π ∈ P.ringOfDefinition := hm (m + 1) (Nat.le_succ m)
  have hπ : IsPseudoUniformizer π :=
    isPseudoUniformizer_iff.mpr
      ⟨hϖ.isUnit.pow _, hϖ.isTopologicallyNilpotent.pow (Nat.succ_ne_zero m)⟩
  have hπ_fix : ∀ g : G, g • π = π := fun g ↦ by simp [π, smul_pow', hϖ_fix g]
  have hRnhd : (R : Set (FixedPoints.subring A G)) ∈ 𝓝 (0 : FixedPoints.subring A G) :=
    hR.mem_nhds R.zero_mem
  rw [nhds_induced] at hRnhd
  obtain ⟨U, hU, hUR⟩ := Filter.mem_comap.mp hRnhd
  obtain ⟨k, -, hk⟩ := (hπ.hasBasis_nhds_zero P).mem_iff.mp hU
  refine AddSubgroup.isOpen_of_mem_nhds
    (integralClosure (R.map (FixedPoints.subring A G).subtype) A).toSubring.toAddSubgroup <|
    Filter.mem_of_superset (hπ.smul_ringOfDefinition_mem_nhds_zero P k) ?_
  rintro _ ⟨c, hc, rfl⟩
  exact isIntegral_map_subtype_of_smul_subset hP (pow_mem hπC k)
    (fun g ↦ by simp [smul_pow', hπ_fix g]) (fun x hx ↦ hUR (hk hx)) hc

end Tate

namespace Pair

section Invariant

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]
  {G : Type*} [Group G] [Finite G] [MulSemiringAction G A] [ContinuousConstSMul G A]

/-- **The invariant Huber pair `(Aᴳ, A⁺ ∩ Aᴳ)`** of a continuous action of a finite group `G` on a
Tate–Huber pair `(A, A⁺)`. Stability of `A⁺` under `G` is not required for the construction. -/
def invariant (G : Type*) [Group G] [Finite G] [MulSemiringAction G A] [ContinuousConstSMul G A]
    (P : Pair A) : Pair (FixedPoints.subring A G) where
  plus := P.plus.comap (FixedPoints.subring A G).subtype
  isRingOfIntegralElements := P.isRingOfIntegralElements.comap_subtype (FixedPoints.subring A G)

/-- The plus ring of `P.invariant G` is `P.plus.comap (FixedPoints.subring A G).subtype`. -/
@[simp]
theorem invariant_plus (G : Type*) [Group G] [Finite G] [MulSemiringAction G A]
    [ContinuousConstSMul G A] (P : Pair A) :
    (P.invariant G).plus = P.plus.comap (FixedPoints.subring A G).subtype := (rfl)

/-- Membership in the plus ring of `P.invariant G` is membership of the underlying element in
`P.plus`. (Not `@[simp]`: `simp` already simplifies the left-hand side via `invariant_plus`.) -/
theorem mem_invariant_plus_iff (G : Type*) [Group G] [Finite G] [MulSemiringAction G A]
    [ContinuousConstSMul G A] (P : Pair A) {x : FixedPoints.subring A G} :
    x ∈ (P.invariant G).plus ↔ (x : A) ∈ P.plus := Iff.rfl

/-- **Integral closure of the invariant plus ring.** When `G` preserves `A⁺`, `A⁺` is the integral
closure of `A⁺ ∩ Aᴳ` in `A`. -/
theorem plus_eq_integralClosure_invariant (G : Type*) [Group G] [Finite G]
    [MulSemiringAction G A] [ContinuousConstSMul G A] (P : Pair A)
    (hP : ∀ g : G, ∀ a ∈ P.plus, g • a ∈ P.plus) :
    P.plus =
      (integralClosure ((P.invariant G).plus.map (FixedPoints.subring A G).subtype) A).toSubring :=
  by
  have := P.isRingOfIntegralElements.isIntegrallyClosedIn
  rw [invariant_plus, Subring.map_comap_eq, Subring.range_subtype]
  exact (Subring.integralClosure_inf_fixedPoints_eq G hP).symm

/-- The canonical inclusion morphism `(Aᴳ, A⁺ ∩ Aᴳ) → (A, A⁺)`. -/
def invariantInclusion (G : Type*) [Group G] [Finite G] [MulSemiringAction G A]
    [ContinuousConstSMul G A] (P : Pair A) : Hom (P.invariant G) P where
  toRingHom := (FixedPoints.subring A G).subtype
  continuous_toRingHom := continuous_subtype_val
  map_mem_plus _ ha := ha

/-- The underlying ring homomorphism of `P.invariantInclusion G` is the subtype inclusion
`Aᴳ →+* A`. -/
@[simp]
theorem toRingHom_invariantInclusion (G : Type*) [Group G] [Finite G] [MulSemiringAction G A]
    [ContinuousConstSMul G A] (P : Pair A) :
    (P.invariantInclusion G).toRingHom = (FixedPoints.subring A G).subtype := (rfl)

/-- For a trivial action (in particular for a trivial group), the invariant inclusion is bijective
on underlying rings. -/
theorem bijective_toRingHom_invariantInclusion_of_forall_smul_eq (G : Type*) [Group G] [Finite G]
    [MulSemiringAction G A] [ContinuousConstSMul G A] (P : Pair A)
    (htriv : ∀ (g : G) (a : A), g • a = a) :
    Function.Bijective (P.invariantInclusion G).toRingHom :=
  ⟨Subtype.val_injective, fun a ↦ ⟨⟨a, fun g ↦ htriv g a⟩, rfl⟩⟩

/-- For a subgroup `H ≤ G`, the canonical inclusion morphism
`(Aᴳ, A⁺ ∩ Aᴳ) → (Aᴴ, A⁺ ∩ Aᴴ)`. -/
def invariantSubgroup (H : Subgroup G) (P : Pair A) : Hom (P.invariant G) (P.invariant H) where
  toRingHom := (FixedPoints.subring A G).subtype.codRestrict (FixedPoints.subring A H)
    fun x h ↦ x.2 h.1
  continuous_toRingHom := continuous_subtype_val.subtype_mk _
  map_mem_plus _ ha := ha

/-- On underlying elements of `A`, `P.invariantSubgroup H` is the identity. -/
@[simp]
theorem coe_toRingHom_invariantSubgroup (H : Subgroup G) (P : Pair A)
    (x : FixedPoints.subring A G) :
    ((P.invariantSubgroup H).toRingHom x : A) = x := (rfl)

/-- Composing the subgroup inclusion `(Aᴳ, A⁺ ∩ Aᴳ) → (Aᴴ, A⁺ ∩ Aᴴ)` with the inclusion into
`(A, A⁺)` recovers `P.invariantInclusion G`. -/
@[simp]
theorem invariantInclusion_comp_invariantSubgroup (H : Subgroup G) (P : Pair A) :
    (P.invariantInclusion H).comp (P.invariantSubgroup H) = P.invariantInclusion G := by
  ext x
  simp

/-- Every subgroup restriction `(Aᴳ, A⁺ ∩ Aᴳ) → (Aᴴ, A⁺ ∩ Aᴴ)` is injective on underlying rings. -/
theorem injective_toRingHom_invariantSubgroup (H : Subgroup G) (P : Pair A) :
    Function.Injective (P.invariantSubgroup H).toRingHom := fun _ _ h ↦
  Subtype.ext <| by simpa using congrArg Subtype.val h

/-- Restriction to the whole group `⊤ : Subgroup G` is bijective on underlying rings. -/
theorem bijective_toRingHom_invariantSubgroup_top (P : Pair A) :
    Function.Bijective (P.invariantSubgroup (⊤ : Subgroup G)).toRingHom :=
  ⟨injective_toRingHom_invariantSubgroup ⊤ P,
    fun x ↦ ⟨⟨x.1, fun g ↦ x.2 ⟨g, trivial⟩⟩, Subtype.ext rfl⟩⟩

end Invariant

namespace Hom

variable {A B C : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsTateRing B]
  [CommRing C] [TopologicalSpace C] [IsTopologicalRing C] [IsTateRing C]
  (G : Type*) [Group G] [Finite G]
  [MulSemiringAction G A] [ContinuousConstSMul G A]
  [MulSemiringAction G B] [ContinuousConstSMul G B]
  [MulSemiringAction G C] [ContinuousConstSMul G C]

/-- **Functoriality of the invariant Huber pair.** A `G`-equivariant morphism of Tate–Huber pairs
`f : (A, A⁺) → (B, B⁺)` restricts to a morphism `(Aᴳ, A⁺ ∩ Aᴳ) → (Bᴳ, B⁺ ∩ Bᴳ)`. -/
def invariant {P : Pair A} {Q : Pair B} (f : Hom P Q)
    (hf : ∀ (g : G) (a : A), f.toRingHom (g • a) = g • f.toRingHom a) :
    Hom (P.invariant G) (Q.invariant G) where
  toRingHom := (f.toRingHom.comp (FixedPoints.subring A G).subtype).codRestrict
    (FixedPoints.subring B G) fun x g ↦ by
      rw [RingHom.comp_apply, Subring.coe_subtype, ← hf, x.2 g]
  continuous_toRingHom := (f.continuous_toRingHom.comp continuous_subtype_val).subtype_mk _
  map_mem_plus x hx := f.map_mem_plus x.1 hx

/-- On underlying ring elements, `f.invariant G hf` agrees with `f.toRingHom`. -/
@[simp]
theorem coe_toRingHom_invariant {P : Pair A} {Q : Pair B} (f : Hom P Q)
    (hf : ∀ (g : G) (a : A), f.toRingHom (g • a) = g • f.toRingHom a)
    (x : FixedPoints.subring A G) :
    ((f.invariant G hf).toRingHom x : B) = f.toRingHom x := (rfl)

/-- Restriction to invariants commutes with the canonical inclusions into the ambient pairs. -/
@[simp]
theorem invariantInclusion_comp_invariant {P : Pair A} {Q : Pair B} (f : Hom P Q)
    (hf : ∀ (g : G) (a : A), f.toRingHom (g • a) = g • f.toRingHom a) :
    (Q.invariantInclusion G).comp (f.invariant G hf) = f.comp (P.invariantInclusion G) := by
  ext x
  simp

/-- Restriction to invariants preserves identity morphisms. -/
@[simp]
theorem invariant_id (P : Pair A) :
    (Hom.id P).invariant G (fun _ _ ↦ by simp) = Hom.id (P.invariant G) := by
  ext x
  simp

/-- Restriction to invariants preserves composition. -/
@[simp]
theorem invariant_comp {P : Pair A} {Q : Pair B} {R : Pair C} (g : Hom Q R) (f : Hom P Q)
    (hg : ∀ (γ : G) (b : B), g.toRingHom (γ • b) = γ • g.toRingHom b)
    (hf : ∀ (γ : G) (a : A), f.toRingHom (γ • a) = γ • f.toRingHom a) :
    (g.comp f).invariant G (fun γ a ↦ by simp [hf, hg]) =
      (g.invariant G hg).comp (f.invariant G hf) := by
  ext x
  simp

/-- Restriction to invariants preserves injectivity on underlying rings. -/
theorem injective_toRingHom_invariant {P : Pair A} {Q : Pair B} (f : Hom P Q)
    (hf : ∀ (g : G) (a : A), f.toRingHom (g • a) = g • f.toRingHom a)
    (hinj : Function.Injective f.toRingHom) :
    Function.Injective (f.invariant G hf).toRingHom := fun _ _ h ↦
  Subtype.ext (hinj (by simpa using congrArg Subtype.val h))

end Hom

end Pair

end TauCeti.Huber
