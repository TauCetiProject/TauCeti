/-!
# Standard étale presentations of Huber pairs over complete Tate pairs

Over a complete Hausdorff Tate pair `(A, A⁺)` with a chosen pseudouniformiser `ϖ ∈ A`, a
*standard étale presentation* of a Huber `(A, A⁺)`-algebra `(C, C⁺)` (`StandardEtalePresentation`)
realises `(C, C⁺)` as the topological quotient of `(A⟨T₁, …, T_N⟩, A⁺⟨T₁, …, T_N⟩)` by the closure
of the ideal generated by `F₁, …, F_N ∈ A⁺⟨T₁, …, T_N⟩`, such that:

1. `π : A⟨T₁, …, T_N⟩ →ₐ[A] C` is a topological (hence open) quotient map with kernel
   `(Ideal.span (Set.range F)).closure`;
2. `C⁺` is the integral closure in `C` of `π(A⁺⟨T₁, …, T_N⟩)`; and
3. `π(det(∂Fᵢ/∂Tⱼ))` is a unit `u ∈ Cˣ` with `algebraMap A C (ϖ ^ k) * ↑u⁻¹ ∈ C⁺` for some `k : ℕ`.

Carrying `k : ℕ` explicitly is essential over Tate rings (`C = C⁺[1/ϖ]`): `π(J)` need not be a unit
of `C⁺`, and `k` feeds into `TauCeti.Huber.exists_unique_zero_restrictedPowerSeries`.

## Main definitions

* `TauCeti.Huber.StandardEtalePresentation`: data presenting `(C, C⁺)` as a standard étale quotient
  of `(A⟨T₁, …, T_N⟩, A⁺⟨T₁, …, T_N⟩)` with Jacobian scale `ϖ ^ k`.
* `TauCeti.Huber.StandardEtalePresentation.toBasePairHom`, `toPairHom`, `quotientToTarget`,
  `targetToQuotient`, and `quotientAlgEquiv`: induced Huber-pair morphisms and quotient isomorphism.
* `TauCeti.Huber.StandardEtalePresentation.ofQuotient` and `identity`: model quotient and
  `0`-variable identity presentations.

## Main results

* `TauCeti.Huber.StandardEtalePresentation.isOpenQuotientMap_π` and `isQuotientMapping`: `π` is an
  open quotient map and a quotient mapping of Huber pairs.
* `TauCeti.Huber.StandardEtalePresentation.t2Space` and `completeSpace`: any Huber ring admitting a
  standard étale presentation over a complete Hausdorff Tate ring is complete and Hausdorff.

## References

* R. Huber, *Étale Cohomology of Rigid Analytic Varieties and Adic Spaces*, Vieweg (1996), §1.6–1.7.
* P. Scholze, *Perfectoid spaces*, Publ. Math. IHÉS **116** (2012), §6–7 (Proposition 6.4).
-/

public section

open Filter Matrix Topology

namespace TauCeti.Huber

/-- **Standard étale presentation of a Huber `(A, A⁺)`-algebra `(C, C⁺)`** over a complete Hausdorff
Tate pair `(A, A⁺)` with chosen pseudouniformiser `ϖ ∈ A`: a topological quotient `A`-algebra map
`π : A⟨T₁, …, T_N⟩ →ₐ[A] C` with kernel `(Ideal.span (Set.range F)).closure` for integral equations
`F : Fin N → A⁺⟨T₁, …, T_N⟩`, plus ring `C⁺` equal to the integral closure of `π(A⁺⟨T₁, …, T_N⟩)`,
and formal Jacobian image `π(det(∂Fᵢ/∂Tⱼ))` invertible in `C` with inverse bounded by `ϖ ^ k`
relative to `C⁺`. -/
structure StandardEtalePresentation {A : Type*} [CommRing A] [UniformSpace A]
    [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A] [CompleteSpace A] [T2Space A]
    (Aplus : Pair A) (ϖ : A)
    {C : Type*} [CommRing C] [TopologicalSpace C] [IsTopologicalRing C] [IsHuberRing C]
    [Algebra A C] (Cplus : Pair C) where
  /-- `ϖ` is a pseudouniformiser of the Tate base `A`. -/
  isPseudoUniformizer : IsPseudoUniformizer ϖ
  /-- Number of restricted-series variables and defining equations. -/
  N : ℕ
  /-- The `N`-tuple of defining restricted power series in `A⟨T₁, …, T_N⟩`. -/
  F : Fin N → tateSeries N A
  /-- Every defining series has coefficients in `A⁺`. -/
  F_mem_plus : ∀ i, F i ∈ tateSeriesPlus N A Aplus.plus
  /-- Exponent `k` bounding the inverse of the Jacobian determinant by `ϖ ^ k`. -/
  k : ℕ
  /-- Presenting `A`-algebra quotient map `A⟨T₁, …, T_N⟩ →ₐ[A] C`. -/
  π : tateSeries N A →ₐ[A] C
  /-- `π` is a topological quotient map. -/
  isQuotientMap_π : IsQuotientMap π
  /-- The kernel of `π` is the closure of the ideal generated by `F₁, …, F_N`. -/
  ker_π : RingHom.ker π = (Ideal.span (Set.range F)).closure
  /-- `C⁺` is the integral closure in `C` of the image of `A⁺⟨T₁, …, T_N⟩` under `π`. -/
  mem_plus_iff : ∀ c : C, c ∈ Cplus.plus ↔
    ((tateSeriesPlus N A Aplus.plus).map (π : tateSeries N A →+* C)).subtype.IsIntegralElem c
  /-- The formal Jacobian determinant maps to a unit `u ∈ Cˣ` with `ϖ ^ k · u⁻¹ ∈ C⁺`. -/
  exists_unit_jacobian : ∃ u : Cˣ,
    (u : C) = π (tateSeries.jacobian F) ∧ algebraMap A C (ϖ ^ k) * ↑u⁻¹ ∈ Cplus.plus

namespace StandardEtalePresentation

section API

variable {A : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A]
  [IsTateRing A] [CompleteSpace A] [T2Space A] {Aplus : Pair A} {ϖ : A}
  {C : Type*} [CommRing C] [TopologicalSpace C] [IsTopologicalRing C] [IsHuberRing C]
  [Algebra A C] {Cplus : Pair C}

/-- The pseudouniformiser `ϖ` automatically belongs to `A⁺`, since `A°° ⊆ A⁺` for every ring of
integral elements. -/
theorem mem_plus_pseudoUniformizer (P : StandardEtalePresentation Aplus ϖ Cplus) :
    ϖ ∈ Aplus.plus :=
  Aplus.isRingOfIntegralElements.mem_of_isTopologicallyNilpotent
    P.isPseudoUniformizer.isTopologicallyNilpotent

/-- The closed defining ideal `(Ideal.span (Set.range P.F)).closure` in `tateSeries P.N A`. -/
noncomputable def ideal (P : StandardEtalePresentation Aplus ϖ Cplus) :
    Ideal (tateSeries P.N A) :=
  (Ideal.span (Set.range P.F)).closure

theorem ideal_def (P : StandardEtalePresentation Aplus ϖ Cplus) :
    P.ideal = (Ideal.span (Set.range P.F)).closure :=
  (rfl)

/-- The formal Jacobian determinant `tateSeries.jacobian P.F ∈ tateSeries P.N A`. -/
noncomputable def jacobian (P : StandardEtalePresentation Aplus ϖ Cplus) :
    tateSeries P.N A :=
  tateSeries.jacobian P.F

theorem jacobian_def (P : StandardEtalePresentation Aplus ϖ Cplus) :
    P.jacobian = tateSeries.jacobian P.F :=
  (rfl)

/-- The formal Jacobian determinant of `P` has coefficients in `A⁺`. -/
theorem jacobian_mem_plus (P : StandardEtalePresentation Aplus ϖ Cplus) :
    P.jacobian ∈ tateSeriesPlus P.N A Aplus.plus :=
  tateSeries.jacobian_mem_tateSeriesPlus P.F_mem_plus

/-- `P.π P.jacobian` is a unit `u ∈ Cˣ` with `algebraMap A C (ϖ ^ P.k) * ↑u⁻¹ ∈ Cplus.plus`. -/
theorem exists_unit_π_jacobian (P : StandardEtalePresentation Aplus ϖ Cplus) :
    ∃ u : Cˣ, (u : C) = P.π P.jacobian ∧ algebraMap A C (ϖ ^ P.k) * ↑u⁻¹ ∈ Cplus.plus :=
  P.exists_unit_jacobian

/-- The image `P.π P.jacobian` of the formal Jacobian determinant is a unit of `C`. -/
theorem isUnit_π_jacobian (P : StandardEtalePresentation Aplus ϖ Cplus) :
    IsUnit (P.π P.jacobian) := by
  obtain ⟨u, hu, -⟩ := P.exists_unit_π_jacobian
  exact hu ▸ u.isUnit

/-- Each defining series `P.F i` vanishes in `C` under `P.π`. -/
@[simp]
theorem π_F (P : StandardEtalePresentation Aplus ϖ Cplus) (i : Fin P.N) :
    P.π (P.F i) = 0 :=
  RingHom.mem_ker.mp (P.ker_π ▸ subset_closure (Ideal.subset_span ⟨i, rfl⟩))

/-- The presenting map `P.π` is continuous. -/
theorem continuous_π (P : StandardEtalePresentation Aplus ϖ Cplus) :
    Continuous P.π :=
  P.isQuotientMap_π.continuous

/-- The presenting map `P.π` is surjective. -/
theorem surjective_π (P : StandardEtalePresentation Aplus ϖ Cplus) :
    Function.Surjective P.π :=
  P.isQuotientMap_π.surjective

/-- Because `P.π` is an additive group homomorphism and a topological quotient map, it is
automatically an *open* quotient map. -/
theorem isOpenQuotientMap_π (P : StandardEtalePresentation Aplus ϖ Cplus) :
    IsOpenQuotientMap P.π :=
  AddMonoidHom.isOpenQuotientMap_of_isQuotientMap (φ := (P.π : tateSeries P.N A →+ C))
    P.isQuotientMap_π

/-- A standard étale presentation forces the structure map `algebraMap A C` to be continuous. -/
theorem continuous_algebraMap (P : StandardEtalePresentation Aplus ϖ Cplus) :
    Continuous (algebraMap A C) := by
  have hcomp : (algebraMap A C : A → C) =
      fun a ↦ P.π (weightedC (fun _ : Fin P.N ↦ ({1} : Set A)) isWeightFamily_one_weight a) := by
    funext a
    rw [← algebraMap_weightedRestrictedSubring, AlgHom.commutes]
  rw [hcomp]
  exact P.continuous_π.comp (continuous_weightedC isWeightFamily_one_weight)

/-- A standard étale presentation carries `A⁺` into `C⁺` along `algebraMap A C`. -/
theorem algebraMap_mem_plus (P : StandardEtalePresentation Aplus ϖ Cplus) {a : A}
    (ha : a ∈ Aplus.plus) : algebraMap A C a ∈ Cplus.plus := by
  rw [← P.π.commutes a, P.mem_plus_iff]
  let R := (tateSeriesPlus P.N A Aplus.plus).map (P.π : tateSeries P.N A →+* C)
  exact isIntegral_algebraMap (R := R) (x := ⟨P.π (algebraMap A (tateSeries P.N A) a),
    Subring.mem_map.mpr ⟨algebraMap A (tateSeries P.N A) a,
      algebraMap_mem_tateSeriesPlus_iff.mpr ha, rfl⟩⟩)

/-- The structure morphism `(A, A⁺) → (C, C⁺)` of Huber pairs induced by a standard étale
presentation. -/
def toBasePairHom (P : StandardEtalePresentation Aplus ϖ Cplus) : Pair.Hom Aplus Cplus where
  toRingHom := algebraMap A C
  continuous_toRingHom := P.continuous_algebraMap
  map_mem_plus _ ha := P.algebraMap_mem_plus ha

@[simp]
theorem toBasePairHom_toRingHom (P : StandardEtalePresentation Aplus ϖ Cplus) :
    P.toBasePairHom.toRingHom = algebraMap A C :=
  (rfl)

/-- The presenting quotient morphism `(tateSeriesPair P.N A Aplus) → Cplus` of Huber pairs. -/
noncomputable def toPairHom (P : StandardEtalePresentation Aplus ϖ Cplus) :
    Pair.Hom (tateSeriesPair P.N A Aplus) Cplus where
  toRingHom := P.π
  continuous_toRingHom := P.continuous_π
  map_mem_plus f hf := by
    rw [P.mem_plus_iff]
    let R := (tateSeriesPlus P.N A Aplus.plus).map (P.π : tateSeries P.N A →+* C)
    exact isIntegral_algebraMap (R := R) (x := ⟨P.π f, Subring.mem_map.mpr
      ⟨f, by simpa only [tateSeriesPair_plus] using hf, rfl⟩⟩)

@[simp]
theorem toPairHom_toRingHom (P : StandardEtalePresentation Aplus ϖ Cplus) :
    P.toPairHom.toRingHom = (P.π : tateSeries P.N A →+* C) :=
  (rfl)

/-- The presenting morphism `P.toPairHom` is a quotient mapping of Huber pairs. -/
theorem isQuotientMapping (P : StandardEtalePresentation Aplus ϖ Cplus) :
    P.toPairHom.IsQuotientMapping := by
  refine (Pair.Hom.isQuotientMapping_iff_isOpenQuotientMap_and_isIntegral P.toPairHom).mpr
    ⟨P.isOpenQuotientMap_π, fun c hc ↦ ?_⟩
  have hS : (tateSeriesPair P.N A Aplus).plus.map P.toPairHom.toRingHom =
      (tateSeriesPlus P.N A Aplus.plus).map (P.π : tateSeries P.N A →+* C) := by
    rw [toPairHom_toRingHom, tateSeriesPair_plus]
  rw [hS]
  exact (P.mem_plus_iff c).mp hc

/-- The kernel of `P.π` is a closed ideal of `tateSeries P.N A`. -/
theorem isClosed_ker_π (P : StandardEtalePresentation Aplus ϖ Cplus) :
    IsClosed (RingHom.ker (P.π : tateSeries P.N A →+* C) : Set (tateSeries P.N A)) := by
  have hker : RingHom.ker (P.π : tateSeries P.N A →+* C) = P.ideal := P.ker_π
  rw [hker, ideal_def, Ideal.coe_closure]
  exact isClosed_closure

/-- Every Huber `(A, A⁺)`-algebra admitting a standard étale presentation over a complete Hausdorff
Tate pair is Hausdorff (`T2Space`), since it is homeomorphic to the quotient of the Hausdorff ring
`tateSeries P.N A` by the closed ideal `RingHom.ker P.π`. -/
theorem t2Space (P : StandardEtalePresentation Aplus ϖ Cplus) : T2Space C := by
  let K := RingHom.ker (P.π : tateSeries P.N A →+* C)
  have : IsClosed (K : Set (tateSeries P.N A)) := P.isClosed_ker_π
  have hhome := (P.π : tateSeries P.N A →+* C).isHomeomorph_kerLift P.isQuotientMap_π
  exact (IsHomeomorph.homeomorph _ hhome).symm.isEmbedding.t2Space

/-- Every Huber `(A, A⁺)`-algebra admitting a standard étale presentation over a complete Hausdorff
Tate pair is complete (`CompleteSpace`) with respect to its additive right uniformity, since it is
an open quotient of the complete first-countable ring `tateSeries P.N A`. -/
theorem completeSpace (P : StandardEtalePresentation Aplus ϖ Cplus) :
    @CompleteSpace C (IsTopologicalAddGroup.rightUniformSpace C) := by
  let _ : UniformSpace C := IsTopologicalAddGroup.rightUniformSpace C
  have : IsUniformAddGroup C := isUniformAddGroup_of_addCommGroup
  exact P.isOpenQuotientMap_π.completeSpace

/-- Forward morphism of Huber pairs from the model quotient pair
`(tateSeriesPair P.N A Aplus).quotient P.ideal` to `Cplus`. -/
noncomputable def quotientToTarget (P : StandardEtalePresentation Aplus ϖ Cplus) :
    Pair.Hom ((tateSeriesPair P.N A Aplus).quotient P.ideal) Cplus :=
  P.toPairHom.quotientLift P.ideal (by
    rw [toPairHom_toRingHom]
    exact P.ker_π.symm.le)

@[simp]
theorem quotientToTarget_mk (P : StandardEtalePresentation Aplus ϖ Cplus)
    (f : tateSeries P.N A) :
    P.quotientToTarget.toRingHom (Ideal.Quotient.mk P.ideal f) = P.π f := by
  rw [quotientToTarget, Pair.Hom.toRingHom_quotientLift, Ideal.Quotient.lift_mk,
    toPairHom_toRingHom]
  rfl

/-- Inverse morphism of Huber pairs from `Cplus` to the model quotient pair
`(tateSeriesPair P.N A Aplus).quotient P.ideal`. -/
noncomputable def targetToQuotient (P : StandardEtalePresentation Aplus ϖ Cplus) :
    Pair.Hom Cplus ((tateSeriesPair P.N A Aplus).quotient P.ideal) :=
  ((Pair.quotientHom (tateSeriesPair P.N A Aplus) P.ideal).quotientLift
    (RingHom.ker P.toPairHom.toRingHom) (by
      rw [Pair.Hom.toRingHom_quotientHom, Ideal.mk_ker, toPairHom_toRingHom]
      exact P.ker_π.le)).comp P.isQuotientMapping.quotientKerInverse

@[simp]
theorem targetToQuotient_π (P : StandardEtalePresentation Aplus ϖ Cplus)
    (f : tateSeries P.N A) :
    P.targetToQuotient.toRingHom (P.π f) = Ideal.Quotient.mk P.ideal f := by
  have hπ : P.π f = P.toPairHom.toRingHom f := rfl
  rw [hπ, targetToQuotient, Pair.Hom.toRingHom_comp, RingHom.comp_apply,
    Pair.Hom.IsQuotientMapping.toRingHom_quotientKerInverse, RingEquiv.toRingHom_eq_coe,
    RingHom.coe_coe, RingHom.quotientKerEquivOfSurjective_symm_apply,
    Pair.Hom.toRingHom_quotientLift, Ideal.Quotient.lift_mk, Pair.Hom.toRingHom_quotientHom]

@[simp]
theorem quotientToTarget_comp_targetToQuotient (P : StandardEtalePresentation Aplus ϖ Cplus) :
    P.quotientToTarget.comp P.targetToQuotient = Pair.Hom.id Cplus := by
  apply Pair.Hom.ext; ext c; obtain ⟨f, rfl⟩ := P.surjective_π c; simp

@[simp]
theorem targetToQuotient_comp_quotientToTarget (P : StandardEtalePresentation Aplus ϖ Cplus) :
    P.targetToQuotient.comp P.quotientToTarget =
      Pair.Hom.id ((tateSeriesPair P.N A Aplus).quotient P.ideal) := by
  apply Pair.Hom.ext; apply Ideal.Quotient.ringHom_ext; ext f; simp

/-- The underlying `A`-algebra equivalence `(tateSeries P.N A ⧸ P.ideal) ≃ₐ[A] C` induced by `P`. -/
noncomputable def quotientAlgEquiv (P : StandardEtalePresentation Aplus ϖ Cplus) :
    (tateSeries P.N A ⧸ P.ideal) ≃ₐ[A] C where
  toFun := P.quotientToTarget.toRingHom
  invFun := P.targetToQuotient.toRingHom
  left_inv x := by obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x; simp
  right_inv c := by obtain ⟨f, rfl⟩ := P.surjective_π c; simp
  map_mul' := map_mul P.quotientToTarget.toRingHom
  map_add' := map_add P.quotientToTarget.toRingHom
  commutes' a := by rw [← Ideal.Quotient.mk_algebraMap, quotientToTarget_mk, P.π.commutes]

@[simp]
theorem quotientAlgEquiv_mk (P : StandardEtalePresentation Aplus ϖ Cplus)
    (f : tateSeries P.N A) :
    P.quotientAlgEquiv (Ideal.Quotient.mk P.ideal f) = P.π f := by
  simp [quotientAlgEquiv]

@[simp]
theorem quotientAlgEquiv_symm_π (P : StandardEtalePresentation Aplus ϖ Cplus)
    (f : tateSeries P.N A) :
    P.quotientAlgEquiv.symm (P.π f) = Ideal.Quotient.mk P.ideal f :=
  P.quotientAlgEquiv.injective (by rw [AlgEquiv.apply_symm_apply, quotientAlgEquiv_mk])

end API

section Constructors

variable {A : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A]
  [IsTateRing A] [CompleteSpace A] [T2Space A]

/-- **Canonical standard étale presentation of a model quotient pair:** if
`F : Fin N → tateSeries N A` has coefficients in `A⁺` and its formal Jacobian determinant maps to a
unit `u` in `tateSeries N A ⧸ (Ideal.span (Set.range F)).closure` with `ϖ ^ k · u⁻¹` integral over
the image of `A⁺⟨T⟩`, then `(tateSeriesPair N A Aplus).quotient (Ideal.span (Set.range F)).closure`
carries a canonical `StandardEtalePresentation`. -/
noncomputable def ofQuotient (Aplus : Pair A) {ϖ : A} (hϖ : IsPseudoUniformizer ϖ)
    {N : ℕ} (F : Fin N → tateSeries N A) (hF : ∀ i, F i ∈ tateSeriesPlus N A Aplus.plus)
    (k : ℕ)
    (hu : ∃ u : (tateSeries N A ⧸ (Ideal.span (Set.range F)).closure)ˣ,
      (u : tateSeries N A ⧸ (Ideal.span (Set.range F)).closure) =
        Ideal.Quotient.mk (Ideal.span (Set.range F)).closure (tateSeries.jacobian F) ∧
      algebraMap A (tateSeries N A ⧸ (Ideal.span (Set.range F)).closure) (ϖ ^ k) * ↑u⁻¹ ∈
        ((tateSeriesPair N A Aplus).quotient (Ideal.span (Set.range F)).closure).plus) :
    StandardEtalePresentation Aplus ϖ
      ((tateSeriesPair N A Aplus).quotient (Ideal.span (Set.range F)).closure) where
  isPseudoUniformizer := hϖ
  N := N
  F := F
  F_mem_plus := hF
  k := k
  π := Ideal.Quotient.mkₐ A (Ideal.span (Set.range F)).closure
  isQuotientMap_π := (QuotientRing.isOpenQuotientMap_mk _).isQuotientMap
  ker_π := Ideal.mk_ker
  mem_plus_iff c := by
    rw [Pair.quotient_plus, tateSeriesPair_plus, Subalgebra.mem_toSubring, mem_integralClosure_iff]
    exact Iff.rfl
  exists_unit_jacobian := hu

@[simp]
theorem ofQuotient_N (Aplus : Pair A) {ϖ : A} (hϖ : IsPseudoUniformizer ϖ)
    {N : ℕ} (F : Fin N → tateSeries N A) (hF : ∀ i, F i ∈ tateSeriesPlus N A Aplus.plus)
    (k : ℕ) (hu) : (ofQuotient Aplus hϖ F hF k hu).N = N := (rfl)

@[simp]
theorem ofQuotient_k (Aplus : Pair A) {ϖ : A} (hϖ : IsPseudoUniformizer ϖ)
    {N : ℕ} (F : Fin N → tateSeries N A) (hF : ∀ i, F i ∈ tateSeriesPlus N A Aplus.plus)
    (k : ℕ) (hu) : (ofQuotient Aplus hϖ F hF k hu).k = k := (rfl)

/-- The defining equation family of `ofQuotient` is `F` (transported along `ofQuotient_N`). -/
@[simp]
theorem ofQuotient_F (Aplus : Pair A) {ϖ : A} (hϖ : IsPseudoUniformizer ϖ)
    {N : ℕ} (F : Fin N → tateSeries N A) (hF : ∀ i, F i ∈ tateSeriesPlus N A Aplus.plus)
    (k : ℕ) (hu) :
    cast (congrArg (fun n ↦ Fin n → tateSeries n A) (ofQuotient_N Aplus hϖ F hF k hu))
      (ofQuotient Aplus hϖ F hF k hu).F = F := (rfl)

@[simp]
theorem ofQuotient_π_apply (Aplus : Pair A) {ϖ : A} (hϖ : IsPseudoUniformizer ϖ)
    {N : ℕ} (F : Fin N → tateSeries N A) (hF : ∀ i, F i ∈ tateSeriesPlus N A Aplus.plus)
    (k : ℕ) (hu) (f : tateSeries N A) :
    (ofQuotient Aplus hϖ F hF k hu).π
      (cast (congrArg (tateSeries · A) (ofQuotient_N Aplus hϖ F hF k hu).symm) f) =
      Ideal.Quotient.mk (Ideal.span (Set.range F)).closure f := (rfl)

/-- **The identity standard étale presentation of `(A, A⁺)` over itself** (`N = 0`, `k = 0`),
identifying `tateSeries 0 A` with `A` via `weightedRestrictedSubringFinZeroEquiv`. -/
noncomputable def identity (Aplus : Pair A) (ϖ : A) (hϖ : IsPseudoUniformizer ϖ) :
    StandardEtalePresentation Aplus ϖ Aplus :=
  let T₀ : Fin 0 → Set A := fun _ ↦ ({1} : Set A)
  let e : tateSeries 0 A ≃+* A := weightedRestrictedSubringFinZeroEquiv T₀
  let π₀ : tateSeries 0 A →ₐ[A] A :=
    { toFun := e, map_one' := e.map_one, map_mul' := e.map_mul, map_zero' := e.map_zero,
      map_add' := e.map_add,
      commutes' a := by simp [e, weightedRestrictedSubringFinZeroEquiv_apply] }
  { isPseudoUniformizer := hϖ
    N := 0
    F := Fin.elim0
    F_mem_plus := fun i ↦ Fin.elim0 i
    k := 0
    π := π₀
    isQuotientMap_π :=
      (Homeomorph.mk e.toEquiv (continuous_weightedRestrictedSubringFinZeroEquiv T₀)
        (continuous_weightedRestrictedSubringFinZeroEquiv_symm T₀)).isQuotientMap
    ker_π := by
      have hbot_set : ((⊥ : Ideal (tateSeries 0 A)) : Set (tateSeries 0 A)) = {0} := by ext; simp
      have hspan : Ideal.span (Set.range (Fin.elim0 : Fin 0 → tateSeries 0 A)) = ⊥ := by
        simp [Set.range_eq_empty]
      rw [(RingHom.injective_iff_ker_eq_bot π₀).mp e.injective, hspan,
        Ideal.closure_eq_of_isClosed ⊥ (hbot_set ▸ isClosed_singleton)]
    mem_plus_iff := fun a ↦ by
      have hmap : (tateSeriesPlus 0 A Aplus.plus).map (π₀ : tateSeries 0 A →+* A) =
          Aplus.plus := by
        ext x; simp only [Subring.mem_map]
        refine ⟨?_, fun hx ↦ ⟨algebraMap A (tateSeries 0 A) x,
          algebraMap_mem_tateSeriesPlus_iff.mpr hx, π₀.commutes x⟩⟩
        rintro ⟨f, hf, rfl⟩
        have hπf : (π₀ : tateSeries 0 A →+* A) f = weightedRestrictedSubringFinZeroEquiv T₀ f := rfl
        rw [hπf, weightedRestrictedSubringFinZeroEquiv_apply,
          ← MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
        exact mem_tateSeriesPlus_iff.mp hf 0
      rw [hmap]
      exact ⟨fun ha ↦ isIntegral_algebraMap (R := Aplus.plus) (x := ⟨a, ha⟩),
        fun hx ↦ Subring.isIntegrallyClosedIn_iff.mp
          Aplus.isRingOfIntegralElements.isIntegrallyClosedIn hx⟩
    exists_unit_jacobian :=
      ⟨1, by simp [tateSeries.jacobian_fin_zero], by simp [Aplus.plus.one_mem]⟩ }

@[simp]
theorem identity_N (Aplus : Pair A) (ϖ : A) (hϖ : IsPseudoUniformizer ϖ) :
    (identity Aplus ϖ hϖ).N = 0 := (rfl)

@[simp]
theorem identity_k (Aplus : Pair A) (ϖ : A) (hϖ : IsPseudoUniformizer ϖ) :
    (identity Aplus ϖ hϖ).k = 0 := (rfl)

@[simp]
theorem identity_π_apply (Aplus : Pair A) (ϖ : A) (hϖ : IsPseudoUniformizer ϖ)
    (f : tateSeries 0 A) :
    (identity Aplus ϖ hϖ).π
      (cast (congrArg (tateSeries · A) (identity_N Aplus ϖ hϖ).symm) f) =
      MvPowerSeries.constantCoeff (f : MvPowerSeries (Fin 0) A) :=
  weightedRestrictedSubringFinZeroEquiv_apply (fun _ : Fin 0 ↦ ({1} : Set A)) f

