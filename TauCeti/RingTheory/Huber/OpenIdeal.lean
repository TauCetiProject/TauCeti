module

public import Mathlib.RingTheory.Finiteness.Ideal
public import TauCeti.RingTheory.Huber.Basic

/-!
# Open ideals of a Huber ring

Fix a pair of definition `(A₀, I)` for a Huber ring `A`. The neighbourhoods of zero that are
cofinal are the *images* of the powers `Iⁿ` in `A`, not the ideals they generate — an ideal span
can be much larger than the additive subgroup it is spanned by. What makes the ideal statement
work is that an *ideal* of `A` containing the image of `Iⁿ` automatically contains its span
`(I · A)ⁿ`. So an ideal of `A` is open exactly when it contains one of those powers, and since
`I · A` is finitely generated that is the same as asking `I · A` to lie in its radical.

## Main definitions

* `TauCeti.Huber.PairOfDefinition.extendedIdealOfDefinition_pow`: the powers of `I · A`
  (defined in `TauCeti/RingTheory/Huber/Basic.lean`) are generated by the basic neighbourhoods
  of zero.

## Main results

* `TauCeti.Huber.PairOfDefinition.isOpen_iff_exists_pow_le`: an ideal of `A` is open exactly when
  it contains a power of `I · A`.
* `TauCeti.Huber.PairOfDefinition.isOpen_iff_le_radical`: an ideal of `A` is open exactly when its
  radical contains `I · A`.

## Provenance

AINTLIB formalises this same layer: `projects/AdicSpaces/Adic spaces/OpenIdeals.lean` is headed
"We prove Lemma 6.6 … of [Wedhorn, *Adic Spaces*]", and `HuberRings.lean` defines the extension
`I · A` under this very name with the same one-line `Ideal.FG.map` proof. It was consulted for the
choice and naming of results; the proofs here are independent, and route the whole lemma through
`Ideal.map_pow` rather than the pointwise-power argument.

## References

* [Wedhorn, *Adic Spaces*][wedhorn_adic], Lemma 6.6.
* [AINTLIB](https://github.com/CBirkbeck/AINTLIB), branch `dev/adic-spaces`,
  `projects/AdicSpaces/Adic spaces/OpenIdeals.lean` and `HuberRings.lean`.
-/

public section

namespace TauCeti.Huber

namespace PairOfDefinition

variable {A : Type*} [CommRing A] [TopologicalSpace A]

/-- The `n`-th power of `I · A` is generated by the `n`-th basic neighbourhood of zero: the
image `TauCeti.Huber.PairOfDefinition.idealImage n` of `Iⁿ` in `A`. -/
theorem extendedIdealOfDefinition_pow (P : PairOfDefinition A) (n : ℕ) :
    P.extendedIdealOfDefinition ^ n = Ideal.span (P.idealImage n : Set A) := by
  -- both sides are the pushforward of `Iⁿ`, since `Ideal.map` is the span of the image
  rw [P.coe_idealImage, P.extendedIdealOfDefinition_eq, ← Ideal.map_pow]
  rfl

variable [IsTopologicalRing A]

/-- Wedhorn Lemma 6.6: an ideal of a Huber ring is open exactly when it contains a power of the
ideal `I · A` generated by an ideal of definition.

An ideal containing `(I · A)ⁿ` contains the open additive subgroup `Iⁿ`, hence is open;
conversely an open ideal is a neighbourhood of zero, so it contains some `Iⁿ` by
`TauCeti.Huber.PairOfDefinition.hasBasis_nhds_zero`. -/
theorem isOpen_iff_exists_pow_le (P : PairOfDefinition A) (a : Ideal A) :
    IsOpen (a : Set A) ↔ ∃ n : ℕ, P.extendedIdealOfDefinition ^ n ≤ a := by
  constructor
  · intro ha
    obtain ⟨n, -, hn⟩ := P.hasBasis_nhds_zero.mem_iff.mp (ha.mem_nhds a.zero_mem)
    exact ⟨n, by rw [P.extendedIdealOfDefinition_pow, Ideal.span_le]; exact hn⟩
  · rintro ⟨n, hn⟩
    rw [P.extendedIdealOfDefinition_pow, Ideal.span_le] at hn
    exact AddSubgroup.isOpen_mono (H₂ := a.toAddSubgroup) hn (P.isOpen_idealImage n)

/-- Wedhorn Lemma 6.6, radical form: an ideal of a Huber ring is open exactly when its radical
contains the ideal `I · A` generated by an ideal of definition.

This is `TauCeti.Huber.PairOfDefinition.isOpen_iff_exists_pow_le` together with the finite
generation of `I · A`, which turns membership in the radical into a uniform power. -/
theorem isOpen_iff_le_radical (P : PairOfDefinition A) (a : Ideal A) :
    IsOpen (a : Set A) ↔ P.extendedIdealOfDefinition ≤ a.radical := by
  rw [P.isOpen_iff_exists_pow_le a]
  exact ⟨fun ⟨n, hn⟩ _ hx ↦ ⟨n, hn (Ideal.pow_mem_pow hx n)⟩,
    fun h ↦ Ideal.exists_pow_le_of_le_radical_of_fg h P.fg_extendedIdealOfDefinition⟩

end PairOfDefinition

end TauCeti.Huber
