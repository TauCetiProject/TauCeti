module

public import Mathlib.RingTheory.Finiteness.Ideal
public import TauCeti.RingTheory.Huber.Basic

/-!
# Open ideals of a Huber ring

Fix a pair of definition `(A₀, I)` for a Huber ring `A`. The powers of the ideal `I · A` that `I`
generates in `A` are cofinal among the neighbourhoods of zero, so an ideal of `A` is open exactly
when it contains one of those powers. Since `I · A` is finitely generated, that is the same as
asking `I · A` to lie in the radical of the ideal.

## Main definitions

* `TauCeti.Huber.PairOfDefinition.idealOfDefinition`: the ideal `I · A` of `A` generated by the
  ideal of definition `I ⊆ A₀`.

## Main results

* `TauCeti.Huber.PairOfDefinition.isOpen_iff_exists_pow_le`: an ideal of `A` is open exactly when
  it contains a power of `I · A`.
* `TauCeti.Huber.PairOfDefinition.isOpen_iff_le_radical`: an ideal of `A` is open exactly when its
  radical contains `I · A`.

## References

* [Wedhorn, *Adic Spaces*][wedhorn_adic], Lemma 6.6.
-/

@[expose] public section

namespace TauCeti.Huber

namespace PairOfDefinition

variable {A : Type*} [CommRing A] [TopologicalSpace A]

/-- The ideal `I · A` of `A` generated by the ideal of definition `I ⊆ A₀` of a pair of
definition. -/
def idealOfDefinition (P : PairOfDefinition A) : Ideal A :=
  P.ideal.map P.ringOfDefinition.subtype

/-- `I · A` is finitely generated, being generated by the image of the finitely generated `I`. -/
theorem fg_idealOfDefinition (P : PairOfDefinition A) : P.idealOfDefinition.FG :=
  P.fg_ideal.map _

/-- The `n`-th power of `I · A` is generated by the `n`-th basic neighbourhood of zero: the
image `TauCeti.Huber.PairOfDefinition.idealImage n` of `Iⁿ` in `A`. -/
theorem idealOfDefinition_pow (P : PairOfDefinition A) (n : ℕ) :
    P.idealOfDefinition ^ n = Ideal.span (P.idealImage n : Set A) :=
  -- both sides are the pushforward of `Iⁿ`, since `Ideal.map` is the span of the image
  (Ideal.map_pow P.ringOfDefinition.subtype P.ideal n).symm

/-- An ideal of `A` contains `(I · A)ⁿ` exactly when it contains the image of `Iⁿ`, because that
image generates the power. This is `Ideal.span_le` transported across
`TauCeti.Huber.PairOfDefinition.idealOfDefinition_pow`. -/
private theorem pow_idealOfDefinition_le_iff (P : PairOfDefinition A) (n : ℕ) (a : Ideal A) :
    P.idealOfDefinition ^ n ≤ a ↔ ∀ x ∈ P.idealImage n, x ∈ a := by
  rw [P.idealOfDefinition_pow, Ideal.span_le]
  exact Iff.rfl

variable [IsTopologicalRing A]

/-- Wedhorn Lemma 6.6: an ideal of a Huber ring is open exactly when it contains a power of the
ideal `I · A` generated by an ideal of definition.

An ideal containing `(I · A)ⁿ` contains the open additive subgroup `Iⁿ`, hence is open;
conversely an open ideal is a neighbourhood of zero, so it contains some `Iⁿ` by
`TauCeti.Huber.PairOfDefinition.hasBasis_nhds_zero`. -/
theorem isOpen_iff_exists_pow_le (P : PairOfDefinition A) (a : Ideal A) :
    IsOpen (a : Set A) ↔ ∃ n : ℕ, P.idealOfDefinition ^ n ≤ a := by
  constructor
  · intro ha
    obtain ⟨n, -, hn⟩ := P.hasBasis_nhds_zero.mem_iff.mp (ha.mem_nhds a.zero_mem)
    exact ⟨n, (P.pow_idealOfDefinition_le_iff n a).mpr hn⟩
  · rintro ⟨n, hn⟩
    exact AddSubgroup.isOpen_mono (H₂ := a.toAddSubgroup)
      ((P.pow_idealOfDefinition_le_iff n a).mp hn) (P.isOpen_idealImage n)

/-- Wedhorn Lemma 6.6, radical form: an ideal of a Huber ring is open exactly when its radical
contains the ideal `I · A` generated by an ideal of definition.

This is `TauCeti.Huber.PairOfDefinition.isOpen_iff_exists_pow_le` together with the finite
generation of `I · A`, which turns membership in the radical into a uniform power. -/
theorem isOpen_iff_le_radical (P : PairOfDefinition A) (a : Ideal A) :
    IsOpen (a : Set A) ↔ P.idealOfDefinition ≤ a.radical := by
  rw [P.isOpen_iff_exists_pow_le a]
  exact ⟨fun ⟨n, hn⟩ _ hx ↦ ⟨n, hn (Ideal.pow_mem_pow hx n)⟩,
    fun h ↦ Ideal.exists_pow_le_of_le_radical_of_fg h P.fg_idealOfDefinition⟩

end PairOfDefinition

end TauCeti.Huber
