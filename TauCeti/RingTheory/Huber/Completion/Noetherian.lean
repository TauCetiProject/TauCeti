module

public import Mathlib.RingTheory.AdicCompletion.Topology
public import TauCeti.RingTheory.AdicCompletion.Noetherian
public import TauCeti.RingTheory.Huber.Adic
public import TauCeti.RingTheory.Huber.Completion.Basic

/-!
# Noetherian rings of definition of the completion

Let `(A₀, I)` be a pair of definition of a Huber ring `A`, and let `(Â₀, Î)` be the pair of
definition of the Hausdorff completion `Â` given by `TauCeti.Huber.PairOfDefinition.completion`:
`Â₀` is the closure of the image of `A₀` and `Î` is the ideal of `Â₀` generated by the image of
`I`. This file shows that `Â₀` is the `I`-adic completion of `A₀` in the algebraic sense:

* `Â₀` is `Î`-adically complete and separated, because it is closed in the complete space `Â`
  and carries the `Î`-adic topology;
* the completion map induces ring isomorphisms `A₀ ⧸ Iⁿ ≃ Â₀ ⧸ Îⁿ` for every `n`, because `Îⁿ`
  is the closure of the image of `Iⁿ` (`TauCeti.Huber.PairOfDefinition.completionIdeal_pow`).

With the noetherianity criterion for complete rings
(`Ideal.isNoetherianRing_of_isAdicComplete`), it follows that `Â₀` is noetherian as soon as
`A₀ ⧸ I` is, in particular whenever `A₀` is. This is the input which lets the class of Huber
rings with a noetherian ring of definition pass to completions.

Applied to the pair of definition `(A, I)` of a ring `A` whose topology is `I`-adic for a
finitely generated ideal `I`, the same statements say that the uniform completion of `A` is
complete for the ideal `I · Â`, and that it is noetherian when `A` is.

## Main results

* `TauCeti.Huber.PairOfDefinition.isAdicComplete_completionIdeal`: `Â₀` is `Î`-adically complete.
* `TauCeti.Huber.PairOfDefinition.quotientPowEquivCompletion`: the isomorphism
  `A₀ ⧸ Iⁿ ≃+* Â₀ ⧸ Îⁿ` induced by the completion map.
* `TauCeti.Huber.PairOfDefinition.isNoetherianRing_completionRingOfDefinition_of_quotient` and
  the instance `TauCeti.Huber.PairOfDefinition.isNoetherianRing_completionRingOfDefinition`:
  `Â₀` is noetherian when `A₀ ⧸ I`, respectively `A₀`, is; the instance
  `TauCeti.Huber.PairOfDefinition.isNoetherianRing_completion_ringOfDefinition` states the latter
  for the ring of definition of `P.completion`.
* `TauCeti.Huber.isAdicComplete_completion_of_isAdic`: if the topology of `A` is `I`-adic with
  `I` finitely generated, then `Â` is `I · Â`-adically complete.
* `TauCeti.Huber.isNoetherianRing_completion_of_isAdic_of_fg` and
  `TauCeti.Huber.isNoetherianRing_completion_of_isAdic`: the completion of an `I`-adic ring is
  noetherian when `A ⧸ I` is (and `I` is finitely generated), in particular when `A` is.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique I*, Publ. Math. IHÉS
  4 (1960), Chapitre 0, (7.2.6) and (7.3.1).
* [The Stacks Project][stacks], Lemma 10.96.3 (tag
  [05GG](https://stacks.math.columbia.edu/tag/05GG)).
* [Wedhorn, *Adic Spaces*][wedhorn_adic], Remark 6.8 and the proof of Proposition 6.35.
-/

public section

open UniformSpace

namespace TauCeti.Huber

variable {A : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A]

namespace PairOfDefinition

variable (P : PairOfDefinition A)

/-- **`Â₀` is `Î`-adically complete.** The ring of definition of the completion is closed in the
complete space `Â`, and its topology is the `Î`-adic one (Wedhorn, Remark 6.8). -/
instance isAdicComplete_completionIdeal :
    IsAdicComplete P.completionIdeal P.completionRingOfDefinition := by
  have : IsUniformAddGroup P.completionRingOfDefinition :=
    P.completionRingOfDefinition.toAddSubgroup.isUniformAddGroup
  have hclosed : IsClosed (P.completionRingOfDefinition : Set (Completion A)) := by
    rw [coe_completionRingOfDefinition]
    exact isClosed_closure
  have : CompleteSpace P.completionRingOfDefinition := hclosed.completeSpace_coe
  exact (IsAdic.isAdicComplete_iff P.isAdic_completionIdeal).mpr ⟨inferInstance, inferInstance⟩

/-- The completion map `A₀ → Â₀ ⧸ Îⁿ` is surjective: every point of `Â₀` is congruent modulo the
open ideal `Îⁿ` to the image of a point of `A₀`. -/
theorem mk_comp_toCompletionRingOfDefinition_surjective (n : ℕ) :
    Function.Surjective
      ((Ideal.Quotient.mk (P.completionIdeal ^ n)).comp P.toCompletionRingOfDefinition) := by
  intro y
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨a, ha⟩ := P.exists_coe_sub_mem_completionIdealImage n y
  have hmem : (a : Completion A) ∈ P.completionRingOfDefinition := by
    simpa using add_mem (P.completionIdealImage_le n ha) y.2
  refine ⟨⟨a, P.coe_mem_completionRingOfDefinition_iff.mp hmem⟩, ?_⟩
  rw [RingHom.comp_apply, Ideal.Quotient.eq, P.completionIdeal_pow,
    mem_completionIdealImageIdeal_iff]
  simpa using ha

/-- The kernel of the completion map `A₀ → Â₀ ⧸ Îⁿ` is `Iⁿ`. -/
theorem ker_mk_comp_toCompletionRingOfDefinition (n : ℕ) :
    RingHom.ker ((Ideal.Quotient.mk (P.completionIdeal ^ n)).comp P.toCompletionRingOfDefinition)
      = P.idealOfDefinition ^ n := by
  ext x
  rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, P.completionIdeal_pow,
    mem_completionIdealImageIdeal_iff, toCompletionRingOfDefinition_apply,
    coe_mem_completionIdealImage_iff, mem_idealImage]
  exact ⟨fun ⟨y, hy, hyx⟩ ↦ Subtype.val_injective hyx ▸ hy, fun hx ↦ ⟨x, hx, rfl⟩⟩

/-- **`A₀ ⧸ Iⁿ ≃ Â₀ ⧸ Îⁿ`.** The completion map induces an isomorphism of each quotient of the
ring of definition by a power of the ideal of definition with the corresponding quotient of the
ring of definition of the completion. -/
noncomputable def quotientPowEquivCompletion (n : ℕ) :
    P.ringOfDefinition ⧸ P.idealOfDefinition ^ n ≃+*
      P.completionRingOfDefinition ⧸ P.completionIdeal ^ n :=
  (Ideal.quotEquivOfEq (P.ker_mk_comp_toCompletionRingOfDefinition n).symm).trans
    (RingHom.quotientKerEquivOfSurjective (P.mk_comp_toCompletionRingOfDefinition_surjective n))

/-- The isomorphism `A₀ ⧸ Iⁿ ≃ Â₀ ⧸ Îⁿ` is induced by the completion map. -/
@[simp]
theorem quotientPowEquivCompletion_mk (n : ℕ) (x : P.ringOfDefinition) :
    P.quotientPowEquivCompletion n (Ideal.Quotient.mk _ x)
      = Ideal.Quotient.mk _ (P.toCompletionRingOfDefinition x) :=
  (rfl)

/-- **The ring of definition of the completion is noetherian** as soon as `A₀ ⧸ I` is: `Â₀` is
complete for the finitely generated ideal `Î`, and `Â₀ ⧸ Î ≃ A₀ ⧸ I`
(EGA I, Chapitre 0, (7.2.6)). -/
theorem isNoetherianRing_completionRingOfDefinition_of_quotient
    [IsNoetherianRing (P.ringOfDefinition ⧸ P.idealOfDefinition)] :
    IsNoetherianRing P.completionRingOfDefinition := by
  have : IsNoetherianRing (P.completionRingOfDefinition ⧸ P.completionIdeal) :=
    isNoetherianRing_of_ringEquiv _ <| (Ideal.quotEquivOfEq (pow_one _).symm).trans <|
      (P.quotientPowEquivCompletion 1).trans (Ideal.quotEquivOfEq (pow_one _))
  exact Ideal.isNoetherianRing_of_isAdicComplete _ P.fg_completionIdeal

/-- **A noetherian ring of definition stays noetherian under completion** (EGA I, Chapitre 0,
(7.3.1); Wedhorn, proof of Proposition 6.35). -/
instance isNoetherianRing_completionRingOfDefinition [IsNoetherianRing P.ringOfDefinition] :
    IsNoetherianRing P.completionRingOfDefinition :=
  P.isNoetherianRing_completionRingOfDefinition_of_quotient

/-- The ring of definition of the completed pair of definition is noetherian when `A₀` is. This
restates `isNoetherianRing_completionRingOfDefinition` for `P.completion`, whose ring of
definition is `Â₀` only propositionally (`completion_ringOfDefinition`), so that instance search
finds it on the pair of definition of `Â`. -/
instance isNoetherianRing_completion_ringOfDefinition [IsNoetherianRing P.ringOfDefinition] :
    IsNoetherianRing P.completion.ringOfDefinition := by
  rw [completion_ringOfDefinition]
  infer_instance

end PairOfDefinition

section IsAdic

variable {I : Ideal A} (hI : IsAdic I) (hfg : I.FG)

/-- For the pair of definition `(A, I)` of an `I`-adic ring, the ring of definition of the
completion is all of `Â`, because the image of `A` is dense. -/
private theorem adic_completionRingOfDefinition_eq_top :
    (PairOfDefinition.adic I hI hfg).completionRingOfDefinition = ⊤ := by
  ext x
  rw [PairOfDefinition.mem_completionRingOfDefinition_iff, PairOfDefinition.adic_ringOfDefinition,
    Subring.coe_top, Set.image_univ, Completion.denseRange_coe.closure_range]
  exact iff_of_true (Set.mem_univ x) (Subring.mem_top x)

/-- For the pair of definition `(A, I)` of an `I`-adic ring, the inclusion of the ring of
definition of the completion into `Â` is a ring isomorphism. -/
private noncomputable def adicCompletionRingOfDefinitionEquiv :
    (PairOfDefinition.adic I hI hfg).completionRingOfDefinition ≃+* Completion A :=
  (RingEquiv.subringCongr (adic_completionRingOfDefinition_eq_top hI hfg)).trans Subring.topEquiv

/-- The isomorphism `Â₀ ≃ Â` carries `Î` onto the ideal `I · Â`. -/
private theorem map_completionIdeal_adicCompletionRingOfDefinitionEquiv :
    (PairOfDefinition.adic I hI hfg).completionIdeal.map
        (adicCompletionRingOfDefinitionEquiv hI hfg)
      = I.map (Completion.coeRingHom : A →+* Completion A) := by
  set P := PairOfDefinition.adic I hI hfg
  have hcomp : ((adicCompletionRingOfDefinitionEquiv hI hfg : _ →+* Completion A).comp
      P.toCompletionRingOfDefinition) =
        Completion.coeRingHom.comp (PairOfDefinition.adicRingOfDefinitionEquiv I hI hfg) :=
    RingHom.ext fun x ↦ by simp [P, adicCompletionRingOfDefinitionEquiv]
  rw [← Ideal.map_coe, PairOfDefinition.completionIdeal_def, Ideal.map_map, hcomp, ← Ideal.map_map,
    Ideal.map_coe, PairOfDefinition.map_adic_idealOfDefinition]

include hI hfg in
/-- **The completion of an adic ring is adically complete** (Stacks, Lemma 10.96.3): if the
topology of `A` is the `I`-adic topology for a finitely generated ideal `I`, then the uniform
completion `Â` is complete and separated for the ideal `I · Â` generated by the image of `I`. -/
theorem isAdicComplete_completion_of_isAdic :
    IsAdicComplete (I.map (Completion.coeRingHom : A →+* Completion A)) (Completion A) := by
  rw [← map_completionIdeal_adicCompletionRingOfDefinitionEquiv hI hfg]
  exact (IsAdicComplete.congr_ringEquiv _ _).mpr inferInstance

include hI hfg in
/-- **The completion of an adic ring is noetherian** as soon as `A ⧸ I` is, for a finitely
generated ideal of definition `I` (EGA I, Chapitre 0, (7.2.6)). -/
theorem isNoetherianRing_completion_of_isAdic_of_fg [IsNoetherianRing (A ⧸ I)] :
    IsNoetherianRing (Completion A) := by
  set P := PairOfDefinition.adic I hI hfg
  have : IsNoetherianRing (P.ringOfDefinition ⧸ P.idealOfDefinition) :=
    isNoetherianRing_of_ringEquiv _ (Ideal.quotientEquiv _ _
      (PairOfDefinition.adicRingOfDefinitionEquiv I hI hfg)
      (PairOfDefinition.map_adic_idealOfDefinition I hI hfg).symm).symm
  have := P.isNoetherianRing_completionRingOfDefinition_of_quotient
  exact isNoetherianRing_of_ringEquiv _ (adicCompletionRingOfDefinitionEquiv hI hfg)

end IsAdic

/-- **The completion of a noetherian adic ring is noetherian** (EGA I, Chapitre 0, (7.3.1)): if
`A` is noetherian and its topology is the `I`-adic topology, then `Â` is noetherian. -/
theorem isNoetherianRing_completion_of_isAdic [IsNoetherianRing A] {I : Ideal A} (hI : IsAdic I) :
    IsNoetherianRing (Completion A) :=
  isNoetherianRing_completion_of_isAdic_of_fg hI (IsNoetherian.noetherian I)

end TauCeti.Huber
