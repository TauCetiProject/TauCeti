module

public import TauCeti.RingTheory.Huber.Completion.Basic
public import TauCeti.RingTheory.Huber.NoetherianType.Basic

import TauCeti.RingTheory.AdicCompletion.Noetherian
import TauCeti.RingTheory.Huber.Adic
import TauCeti.Topology.Algebra.Nonarchimedean.AdicTopology

/-!
# Noetherianity of completions of adic rings and of rings of definition

Let `R` be a commutative ring whose topology is the `I`-adic topology for a finitely generated
ideal `I`. Its Hausdorff completion `R̂` (Mathlib's `UniformSpace.Completion`) carries the adic
topology of the extended ideal `I·R̂`, and is complete for it. If `R` is Noetherian, so is `R̂`.

The same argument applies to a ring of definition `A₀` of a Huber ring `A`: if `A₀` is Noetherian,
then so is the ring of definition `Â₀` of the completion `Â`, namely the closure of the image of
`A₀` (`TauCeti.Huber.PairOfDefinition.completion`). Consequently the completion of a Huber ring of
noetherian type is again of noetherian type. This is the form in which a noetherian hypothesis on
a possibly incomplete Huber ring reaches its completion, as in Huber's sheafiness theorem for rings
with a noetherian ring of definition.

In both cases the completed ring is adically complete for a finitely generated open ideal, and its
quotient by that ideal is the quotient of the original ring. More precisely, `Â₀` is the `I`-adic
completion of `A₀` in the algebraic sense: it is `Î`-adically complete and separated, where `Î` is
the ideal generated by the image of `I`, and the completion map induces ring isomorphisms
`A₀ ⧸ Iⁿ ≃ Â₀ ⧸ Îⁿ` for every `n`, because `Îⁿ` is the closure of the image of `Iⁿ`
(`TauCeti.Huber.PairOfDefinition.completionIdeal_pow`). With the noetherianity criterion for
complete rings (`Ideal.isNoetherianRing_of_isAdicComplete`), `Â₀` is therefore Noetherian as soon as
`A₀ ⧸ I` is, and likewise `R̂` is Noetherian as soon as `R ⧸ I` is, for `I` finitely generated. The
Noetherian results above are the special cases where `A₀`, respectively `R`, is Noetherian.

## Main results

* `IsAdic.map_coeRingHom`: the topology of `R̂` is the `I·R̂`-adic topology, for `I` finitely
  generated.
* `IsAdic.isAdicComplete_map_coeRingHom`: `R̂` is `I·R̂`-adically complete.
* `IsAdic.isNoetherianRing_completion`: the completion of a Noetherian ring for an adic topology
  is Noetherian.
* `TauCeti.Huber.PairOfDefinition.isNoetherianRing_completion`: the completion of a Noetherian ring
  of definition is a Noetherian ring of definition of the completion.
* `TauCeti.Huber.PairOfDefinition.quotientPowEquivCompletion`: the isomorphism
  `A₀ ⧸ Iⁿ ≃+* Â₀ ⧸ Îⁿ` induced by the completion map.
* `TauCeti.Huber.PairOfDefinition.isNoetherianRing_completionRingOfDefinition_of_quotient`: `Â₀` is
  Noetherian as soon as `A₀ ⧸ I` is.
* `IsAdic.isNoetherianRing_completion_of_quotient`: the completion of an adic ring is Noetherian as
  soon as `R ⧸ I` is, for `I` finitely generated.
* `TauCeti.Huber.IsNoetherianType.completion`: the completion of a Huber ring of noetherian type is
  of noetherian type.

## References

* [The Stacks Project][stacks], Lemma 10.96.3 (tag
  [05GG](https://stacks.math.columbia.edu/tag/05GG)).
* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique I*, Ch. 0, (7.2.6) and
  (7.3.1).
* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217
  (1994), §2, Theorem 2.2.
* T. Wedhorn, *Adic Spaces*, Remark 6.8, Proposition 6.35 and Remark 6.37.
-/

public section

open UniformSpace

variable {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]

namespace IsAdic

variable {I : Ideal R}

open TauCeti.Huber.PairOfDefinition in
/-- For the adic pair, whose ring of definition is all of `R`, the ring of definition `Â₀` of the
completion is all of `R̂`, since `R` is dense in `R̂`. -/
private theorem adic_completionRingOfDefinition (hI : IsAdic I) (hfg : I.FG) :
    (adic I hI hfg).completionRingOfDefinition = ⊤ := by
  ext x
  simp [mem_completionRingOfDefinition_iff, adic_ringOfDefinition,
    Completion.denseRange_coe.closure_range]

open TauCeti.Huber.PairOfDefinition in
/-- **The completion of an adic ring is adic for the extended ideal** (Stacks, Tag 05GG). If the
topology of `R` is `I`-adic for a finitely generated ideal `I`, the topology of its Hausdorff
completion `R̂` is the `I·R̂`-adic topology. -/
theorem map_coeRingHom (hI : IsAdic I) (hfg : I.FG) :
    IsAdic (I.map (Completion.coeRingHom : R →+* Completion R)) := by
  let P := adic I hI hfg
  -- The ring of definition of `P` is all of `R`, so `Â₀ = R̂`.
  have htop (t : Completion R) : t ∈ P.completionRingOfDefinition := by
    simp [P, adic_completionRingOfDefinition hI hfg]
  -- The `n`-th power of `I·R̂` is the closure of the image of `Iⁿ`.
  have hpow (n : ℕ) : ((I.map (Completion.coeRingHom : R →+* Completion R) ^ n : Ideal _) :
      Set (Completion R)) = P.completionIdealImage n := by
    have hmem {a : R} : a ∈ P.idealImage n ↔ a ∈ I ^ n := by
      simp [P, adic_idealImage]
    refine subset_antisymm ?_ (P.completionIdealImage_le_of_image_subset n fun a ha ↦ ?_)
    · let K : Ideal (Completion R) :=
        { carrier := P.completionIdealImage n
          add_mem' := (P.completionIdealImage n).add_mem
          zero_mem' := (P.completionIdealImage n).zero_mem
          smul_mem' := fun t _ hy ↦ P.mul_mem_completionIdealImage (htop t) hy }
      have hK : (I ^ n).map (Completion.coeRingHom : R →+* Completion R) ≤ K :=
        Ideal.map_le_iff_le_comap.mpr fun a ha ↦ P.coe_mem_completionIdealImage (hmem.mpr ha)
      rw [← Ideal.map_pow]
      exact hK
    · rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ (hmem.mp ha)
  refine isAdic_iff.mpr ⟨fun n ↦ ?_, fun s hs ↦ ?_⟩
  · rw [hpow]
    exact P.isOpen_completionIdealImage n
  · obtain ⟨n, -, hn⟩ := P.hasBasis_nhds_zero_completion.mem_iff.mp hs
    exact ⟨n, (hpow n).symm ▸ hn⟩

/-- **The completion of an adic ring is adically complete for the extended ideal** (Stacks, Tag
05GG). If the topology of `R` is `I`-adic for a finitely generated ideal `I`, its Hausdorff
completion `R̂` is `I·R̂`-adically complete and separated. -/
theorem isAdicComplete_map_coeRingHom (hI : IsAdic I) (hfg : I.FG) :
    IsAdicComplete (I.map (Completion.coeRingHom : R →+* Completion R)) (Completion R) :=
  (hI.map_coeRingHom hfg).isAdicComplete_iff.mpr ⟨inferInstance, inferInstance⟩

end IsAdic

namespace TauCeti.Huber

namespace PairOfDefinition

variable (P : PairOfDefinition R)

/-- The completion map `A₀ → Â₀ ⧸ Îⁿ` is surjective: every point of `Â₀` is congruent modulo the
open ideal `Îⁿ` to the image of a point of `A₀`. -/
theorem mk_comp_toCompletionRingOfDefinition_surjective (n : ℕ) :
    Function.Surjective
      ((Ideal.Quotient.mk (P.completionIdeal ^ n)).comp P.toCompletionRingOfDefinition) := by
  intro y
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨b, hb⟩ := P.exists_sub_toCompletionRingOfDefinition_mem_completionIdeal_pow n y
  exact ⟨b, (Ideal.Quotient.eq.mpr hb).symm⟩

/-- The kernel of the completion map `A₀ → Â₀ ⧸ Îⁿ` is `Iⁿ`. -/
theorem ker_mk_comp_toCompletionRingOfDefinition (n : ℕ) :
    RingHom.ker ((Ideal.Quotient.mk (P.completionIdeal ^ n)).comp P.toCompletionRingOfDefinition)
      = P.idealOfDefinition ^ n := by
  ext x
  rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, P.completionIdeal_pow,
    mem_completionIdealImageIdeal_iff, toCompletionRingOfDefinition_apply,
    coe_mem_completionIdealImage_iff, mem_idealImage]
  exact ⟨fun ⟨y, hy, hyx⟩ ↦ Subtype.val_injective hyx ▸ hy, fun hx ↦ ⟨x, hx, rfl⟩⟩

/-- **`A₀ ⧸ Iⁿ ≃ Â₀ ⧸ Îⁿ`** (EGA I, Ch. 0, (7.3.1)). The completion map induces an isomorphism of
each quotient of the ring of definition by a power of the ideal of definition with the
corresponding quotient of the ring of definition of the completion. -/
noncomputable def quotientPowEquivCompletion (n : ℕ) :
    P.ringOfDefinition ⧸ P.idealOfDefinition ^ n ≃+*
      P.completionRingOfDefinition ⧸ P.completionIdeal ^ n :=
  (Ideal.quotEquivOfEq (P.ker_mk_comp_toCompletionRingOfDefinition n).symm).trans
    (RingHom.quotientKerEquivOfSurjective (P.mk_comp_toCompletionRingOfDefinition_surjective n))

/-- The isomorphism `A₀ ⧸ Iⁿ ≃ Â₀ ⧸ Îⁿ` is induced by the completion map. -/
@[simp]
theorem quotientPowEquivCompletion_mk (n : ℕ) (x : P.ringOfDefinition) :
    P.quotientPowEquivCompletion n (Ideal.Quotient.mk _ x)
      = Ideal.Quotient.mk _ (P.toCompletionRingOfDefinition x) :=
  (rfl)

/-- **The ring of definition of the completion is Noetherian as soon as `A₀ ⧸ I` is** (EGA I,
Ch. 0, (7.2.6)): `Â₀` is complete for the finitely generated ideal `Î`, and `Â₀ ⧸ Î ≃ A₀ ⧸ I`. -/
theorem isNoetherianRing_completionRingOfDefinition_of_quotient
    [IsNoetherianRing (P.ringOfDefinition ⧸ P.idealOfDefinition)] :
    IsNoetherianRing P.completionRingOfDefinition := by
  have : IsNoetherianRing (P.completionRingOfDefinition ⧸ P.completionIdeal) :=
    isNoetherianRing_of_ringEquiv _ <| (Ideal.quotEquivOfEq (pow_one _).symm).trans <|
      (P.quotientPowEquivCompletion 1).trans (Ideal.quotEquivOfEq (pow_one _))
  exact Ideal.isNoetherianRing_of_isAdicComplete _ P.fg_completionIdeal

/-- **The completion of a Noetherian ring of definition is Noetherian** (EGA I, Ch. 0, (7.2.6)).
If a pair of definition `(A₀, I)` of `R` has `A₀` Noetherian, the ring of definition `Â₀` of the
completed pair `P.completion`, the closure of the image of `A₀` in `R̂`, is Noetherian. -/
instance isNoetherianRing_completion [IsNoetherianRing P.ringOfDefinition] :
    IsNoetherianRing P.completion.ringOfDefinition := by
  rw [completion_ringOfDefinition]
  exact P.isNoetherianRing_completionRingOfDefinition_of_quotient

end PairOfDefinition

/-- **The completion of a Huber ring of noetherian type is of noetherian type.** A Noetherian ring
of definition of `R` completes to a Noetherian ring of definition of `R̂`
(`TauCeti.Huber.PairOfDefinition.isNoetherianRing_completion`), and a strongly noetherian Tate ring
completes to a strongly noetherian Tate ring. -/
instance IsNoetherianType.completion [IsHuberRing R] [IsNoetherianType R] :
    IsNoetherianType (Completion R) :=
  IsNoetherianType.elim ‹_› (fun P _ ↦ .of_pairOfDefinition P.completion inferInstance)
    fun _ _ ↦
      have : IsStronglyNoetherian (Completion R) :=
        (Completion.isDenseInducing_coe.isStronglyNoetherian_iff
          (φ := (Completion.coeRingHom : R →+* Completion R))).mp ‹_›
      inferInstance

end TauCeti.Huber

namespace IsAdic

variable {I : Ideal R}

open TauCeti.Huber TauCeti.Huber.PairOfDefinition in
/-- **The completion of an adic ring is Noetherian as soon as `R ⧸ I` is** (EGA I, Ch. 0,
(7.2.6)), for a finitely generated ideal `I` defining the topology. -/
theorem isNoetherianRing_completion_of_quotient (hI : IsAdic I) (hfg : I.FG)
    [IsNoetherianRing (R ⧸ I)] : IsNoetherianRing (Completion R) := by
  let P := adic I hI hfg
  -- Both rings of definition of the adic pair, `A₀ = R` and `Â₀ = R̂`, are everything.
  let e : P.ringOfDefinition ≃+* R :=
    (RingEquiv.subringCongr (adic_ringOfDefinition I hI hfg)).trans Subring.topEquiv
  -- `e` is the inclusion `A₀ → R`, so the extension of `P.idealOfDefinition` along it is `I`.
  have hI' : I = P.idealOfDefinition.map e := by
    rw [← adic_extendedIdealOfDefinition I hI hfg, extendedIdealOfDefinition_def]
    rfl
  have : IsNoetherianRing (P.ringOfDefinition ⧸ P.idealOfDefinition) :=
    isNoetherianRing_of_ringEquiv _ (Ideal.quotientEquiv _ _ e hI').symm
  have := P.isNoetherianRing_completionRingOfDefinition_of_quotient
  exact isNoetherianRing_of_ringEquiv _
    ((RingEquiv.subringCongr (adic_completionRingOfDefinition hI hfg)).trans Subring.topEquiv)

/-- **The completion of a Noetherian ring for an adic topology is Noetherian** (EGA I, Ch. 0,
(7.3.1)). If the topology of a Noetherian ring `R` is `I`-adic for some ideal `I`, its Hausdorff
completion is Noetherian. -/
theorem isNoetherianRing_completion [IsNoetherianRing R] (hI : IsAdic I) :
    IsNoetherianRing (Completion R) :=
  hI.isNoetherianRing_completion_of_quotient (IsNoetherian.noetherian I)

end IsAdic
