module

public import TauCeti.RingTheory.Huber.Pair
public import TauCeti.RingTheory.IntegralClosure.IntegrallyClosed
public import Mathlib.RingTheory.Perfection

/-!
# Topologically nilpotent elements and compatible roots

Let `A⁺` be a ring of integral elements in a nonarchimedean topological ring `A`, and let
`r : Perfection A⁺ p` be a compatible root system whose zeroth coordinate is a
pseudouniformiser. If `2 ≤ p`, the topologically nilpotent elements of `A⁺` are exactly the
elements divisible by some coordinate of `r`. Consequently they form the ideal generated
by these coordinates.

This identifies the topological ideal used in almost mathematics with an algebraic root
ideal. Neither completeness, uniformity, nor a perfectoid hypothesis is needed. The statement
allows any ring of integral elements, including `A°` itself.

## Main results

* `TauCeti.Huber.IsRingOfIntegralElements.isTopologicallyNilpotent_iff_exists_dvd`:
  topological nilpotence is divisibility by a sufficiently deep root.
* `TauCeti.Huber.IsRingOfIntegralElements.comap_topologicallyNilpotentIdeal_eq_span_range`:
  the pullback of `A°°` to `A⁺` is the root ideal.
* `TauCeti.Huber.topologicallyNilpotentIdeal_eq_span_range`: the ideal equality in `A°`.

## References

* P. Scholze, *Étale cohomology of diamonds*, §3, Definition 3.21 and its preamble.
* B. Bhatt, *Lecture notes for a class on perfectoid spaces*, Lemma 3.1.3(2).
-/

public section

open Filter Topology

namespace TauCeti.Huber

variable {A : Type*} [CommRing A] [TopologicalSpace A] [NonarchimedeanRing A]
  {Aplus : Subring A} {p : ℕ}

/-- In a ring of integral elements, an element is topologically nilpotent exactly when it is
divisible by some member of a compatible root system of a pseudouniformiser. -/
theorem IsRingOfIntegralElements.isTopologicallyNilpotent_iff_exists_dvd
    (h : IsRingOfIntegralElements Aplus) (hp : 2 ≤ p) (r : Perfection Aplus p)
    (hr : IsPseudoUniformizer (Perfection.coeffMonoidHom Aplus p 0 r : A)) (x : Aplus) :
    IsTopologicallyNilpotent (x : A) ↔
      ∃ n, Perfection.coeffMonoidHom Aplus p n r ∣ x := by
  have := h.isIntegrallyClosedIn
  have hn (n : ℕ) : p ^ n ≠ 0 := pow_ne_zero n (by omega)
  have hpow (n : ℕ) :
      (Perfection.coeffMonoidHom Aplus p n r : A) ^ p ^ n =
        Perfection.coeffMonoidHom Aplus p 0 r := by
    exact_mod_cast Perfection.coeffMonoidHom_pow_p_pow_self r n
  have hunit (n : ℕ) : IsUnit (Perfection.coeffMonoidHom Aplus p n r : A) := by
    apply (isUnit_pow_iff (hn n)).mp
    rw [hpow]
    exact hr.isUnit
  constructor
  · intro hx
    -- Multiplication by the inverse pseudouniformiser eventually puts powers in the open plus ring.
    have ht : Tendsto (fun k ↦ (hr.isUnit.unit⁻¹ : Aˣ).val * (x : A) ^ k) atTop (𝓝 0) := by
      simpa using hx.const_mul (hr.isUnit.unit⁻¹ : Aˣ).val
    obtain ⟨N, hN⟩ := (ht.eventually_mem (h.isOpen.mem_nhds Aplus.zero_mem)).exists_forall_of_atTop
    refine ⟨N, (IsIntegrallyClosedIn.pow_dvd_pow_iff (hn N) (hunit N)).mp ?_⟩
    rw [Perfection.coeffMonoidHom_pow_p_pow_self]
    have hmem := hN (p ^ N) (Nat.lt_pow_self (by omega : 1 < p)).le
    refine ⟨⟨_, hmem⟩, Subtype.ext ?_⟩
    simp only [Subring.coe_mul, Subring.coe_pow]
    rw [mul_left_comm, ← mul_assoc, hr.isUnit.val_inv_mul, one_mul]
  · rintro ⟨n, y, rfl⟩
    have hnil : IsTopologicallyNilpotent (Perfection.coeffMonoidHom Aplus p n r : A) := by
      apply IsTopologicallyNilpotent.of_pow (hn n)
      rw [hpow]
      exact hr.isTopologicallyNilpotent
    simpa only [Subring.coe_mul, mul_comm] using
      (h.isPowerBounded_of_mem y.property).isTopologicallyNilpotent_mul hnil

/-- The ideal of topologically nilpotent elements pulled back from `A°` to any plus ring is
generated by the compatible roots of a pseudouniformiser. -/
theorem IsRingOfIntegralElements.comap_topologicallyNilpotentIdeal_eq_span_range
    (h : IsRingOfIntegralElements Aplus) (hp : 2 ≤ p) (r : Perfection Aplus p)
    (hr : IsPseudoUniformizer (Perfection.coeffMonoidHom Aplus p 0 r : A)) :
    (topologicallyNilpotentIdeal A).comap (Aplus.inclusion h.le_powerBoundedSubring) =
      Ideal.span (Set.range fun n ↦ Perfection.coeffMonoidHom Aplus p n r) := by
  apply le_antisymm
  · intro x hx
    rw [Ideal.mem_comap, mem_topologicallyNilpotentIdeal, Subring.coe_inclusion] at hx
    obtain ⟨n, y, hxy⟩ := (h.isTopologicallyNilpotent_iff_exists_dvd hp r hr x).mp hx
    rw [hxy]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨n, rfl⟩)
  · refine Ideal.span_le.mpr ?_
    rintro x ⟨n, rfl⟩
    simpa only [SetLike.mem_coe, Ideal.mem_comap, mem_topologicallyNilpotentIdeal,
      Subring.coe_inclusion] using
      (h.isTopologicallyNilpotent_iff_exists_dvd hp r hr _).mpr ⟨n, dvd_rfl⟩

/-- In a Huber ring admitting compatible roots of a pseudouniformiser, the ideal `A°°` is
generated by these roots in `A°`. -/
theorem topologicallyNilpotentIdeal_eq_span_range [IsHuberRing A] (hp : 2 ≤ p)
    (r : Perfection (powerBoundedSubring A) p)
    (hr : IsPseudoUniformizer
      (Perfection.coeffMonoidHom (powerBoundedSubring A) p 0 r : A)) :
    topologicallyNilpotentIdeal A =
      Ideal.span (Set.range fun n ↦ Perfection.coeffMonoidHom (powerBoundedSubring A) p n r) := by
  have h : IsRingOfIntegralElements (powerBoundedSubring A) := by
    simpa only [Pair.powerBounded_plus] using (Pair.powerBounded A).isRingOfIntegralElements
  have hi : (powerBoundedSubring A).inclusion h.le_powerBoundedSubring = RingHom.id _ := by
    ext x
    rfl
  simpa only [hi, Ideal.comap_id] using
    h.comap_topologicallyNilpotentIdeal_eq_span_range hp r hr

end TauCeti.Huber
