module

public import TauCeti.RingTheory.Huber.AdicHom.Basic
public import TauCeti.RingTheory.Huber.Completion.Basic

/-!
# Adicness of the completion homomorphism

The completion homomorphism of a Huber ring is adic. Its continuity and preservation of open
ideals come from the completed pairs of definition: their ideals are generated by the original
ideals of definition.
-/

public section

namespace TauCeti.Huber.IsAdicHom

open UniformSpace

/-- The completion homomorphism of a Huber ring is adic. -/
theorem coeRingHom {A : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A]
    [IsTopologicalRing A] [IsHuberRing A] :
    IsAdicHom (Completion.coeRingHom : A →+* Completion A) :=
  of_continuous_isOpen_map (Completion.continuous_coe A) fun _ hI ↦ isOpen_map_coeRingHom hI

end TauCeti.Huber.IsAdicHom
