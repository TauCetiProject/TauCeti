import TauCeti.Topology.Algebra.Nonarchimedean.AdicTopology

/-!
# Adic homomorphisms of Huber rings

An adic homomorphism admits compatible pairs of definition for which the target ideal of
definition is generated by the source ideal. This condition implies continuity and is stronger
than continuity: it also preserves open ideals. Conversely these two intrinsic conditions
characterize adic homomorphisms. They make composition and cancellation independent of the
chosen pairs of definition.

The definition follows Wedhorn, *Adic Spaces*, Definition 6.23; the intrinsic criterion and
composition properties are the content of §6.5.
-/

public section

open Topology

namespace TauCeti.Huber

variable {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]
  [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]

/-- A ring homomorphism is adic if it carries some pair of definition to a pair of definition,
with the target ideal generated by the image of the source ideal. -/
class IsAdicHom (f : A →+* B) : Prop where
  /-- Compatible pairs whose ideals of definition are related by extension. -/
  exists_pairOfDefinition : ∃ (P : PairOfDefinition A) (Q : PairOfDefinition B)
    (h : ∀ a ∈ P.ringOfDefinition, f a ∈ Q.ringOfDefinition),
    P.idealOfDefinition.map (f.restrict _ _ h) = Q.idealOfDefinition

/-- Characteristic introduction and elimination criterion for adic homomorphisms. -/
theorem isAdicHom_iff {f : A →+* B} : IsAdicHom f ↔
    ∃ (P : PairOfDefinition A) (Q : PairOfDefinition B)
      (h : ∀ a ∈ P.ringOfDefinition, f a ∈ Q.ringOfDefinition),
      P.idealOfDefinition.map (f.restrict _ _ h) = Q.idealOfDefinition :=
  ⟨fun h ↦ h.exists_pairOfDefinition, IsAdicHom.mk⟩

namespace IsAdicHom

variable [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]
  {f : A →+* B}

/-- An adic homomorphism is continuous. -/
theorem continuous (hf : IsAdicHom f) : Continuous f := by
  obtain ⟨P, Q, h, heq⟩ := hf.exists_pairOfDefinition
  have hc : Continuous (f.restrict _ _ h) :=
    P.isAdic_idealOfDefinition.continuous_of_map_le_radical Q.isAdic_idealOfDefinition
      P.fg_idealOfDefinition (heq ▸ Ideal.le_radical)
  apply continuous_of_continuousAt_zero f
  apply (P.isOpen_ringOfDefinition.isOpenEmbedding_subtypeVal.continuousAt_iff
    (x := (0 : P.ringOfDefinition))).mp
  exact continuous_subtype_val.continuousAt.comp hc.continuousAt

/-- The identity homomorphism of a Huber ring is adic. -/
theorem id [IsHuberRing A] : IsAdicHom (RingHom.id A) := by
  obtain ⟨P⟩ := IsHuberRing.nonempty_pairOfDefinition (A := A)
  refine ⟨P, P, fun _ hx ↦ hx, ?_⟩
  have h : (RingHom.id A).restrict P.ringOfDefinition P.ringOfDefinition
      (fun _ hx ↦ hx) = RingHom.id _ := by ext; rfl
  simp [h]

omit [IsTopologicalRing A] [IsTopologicalRing B] in
/-- An adic homomorphism extends the ideal generated by a source ideal of definition to the
ideal generated by a target ideal of definition. -/
private theorem exists_map_extendedIdealOfDefinition_eq (hf : IsAdicHom f) :
    ∃ (P : PairOfDefinition A) (Q : PairOfDefinition B),
      P.extendedIdealOfDefinition.map f = Q.extendedIdealOfDefinition := by
  obtain ⟨P, Q, h, heq⟩ := hf.exists_pairOfDefinition
  refine ⟨P, Q, ?_⟩
  rw [P.extendedIdealOfDefinition_def, Q.extendedIdealOfDefinition_def, ← heq,
    Ideal.map_map, Ideal.map_map]
  rfl

omit [IsTopologicalRing A] in
/-- Adic homomorphisms carry open ideals to open ideals. -/
theorem isOpen_map (hf : IsAdicHom f) {I : Ideal A} (hI : IsOpen (I : Set A)) :
    IsOpen (I.map f : Set B) := by
  obtain ⟨P, Q, heq⟩ := hf.exists_map_extendedIdealOfDefinition_eq
  exact P.isOpen_map_of_isOpen_map_extendedIdealOfDefinition Q f
    (heq ▸ Q.isOpen_extendedIdealOfDefinition) hI

/-- Adic homomorphisms carry bounded sets to bounded sets. -/
theorem isBounded_image (hf : IsAdicHom f) {S : Set A} (hS : IsBounded S) :
    IsBounded (f '' S) := by
  obtain ⟨P, Q, heq⟩ := hf.exists_map_extendedIdealOfDefinition_eq
  exact hS.image_of_isOpen_map_extendedIdealOfDefinition P Q hf.continuous.continuousAt
    (heq ▸ Q.isOpen_extendedIdealOfDefinition)

end IsAdicHom

namespace PairOfDefinition

variable [IsTopologicalRing A] [IsTopologicalRing B]

omit [IsTopologicalRing A] in
/-- For compatible rings of definition, a continuous map extending a source ideal of definition
to an open ambient ideal makes its extension an ideal of definition in the target subring. -/
theorem isAdic_map_idealOfDefinition (P : PairOfDefinition A) (Q : PairOfDefinition B)
    (f : A →+* B) (h : ∀ a ∈ P.ringOfDefinition, f a ∈ Q.ringOfDefinition)
    (hf : Continuous f) (hopen : IsOpen (P.extendedIdealOfDefinition.map f : Set B)) :
    IsAdic (P.idealOfDefinition.map (f.restrict _ _ h)) := by
  classical
  let f₀ := f.restrict _ _ h
  have hc : Continuous f₀ := (hf.comp continuous_subtype_val).subtype_mk _
  have hrad := P.isAdic_idealOfDefinition.map_le_radical_of_continuous
    Q.isAdic_idealOfDefinition hc
  apply Q.isAdic_idealOfDefinition.isAdic_iff_isOpen_and_exists_pow_le.mpr
  refine ⟨?_, Ideal.exists_pow_le_of_le_radical_of_fg hrad
    (P.fg_idealOfDefinition.map f₀)⟩
  obtain ⟨G, hG⟩ := P.fg_idealOfDefinition
  let T := G.image (fun a : P.ringOfDefinition ↦ f (a : A))
  have hT : Ideal.span (T : Set B) = P.extendedIdealOfDefinition.map f := by
    rw [P.extendedIdealOfDefinition_def, ← hG, Ideal.map_map, Ideal.map_span]
    simp [T, Finset.coe_image, RingHom.coe_comp]
  obtain ⟨n, hn⟩ := Q.exists_forall_mem_idealImage_exists_sum_eq T
    (hT ▸ hopen.mem_nhds (Ideal.zero_mem _)) 0
  apply (P.idealOfDefinition.map f₀).toAddSubgroup.isOpen_of_mem_nhds
  apply Filter.mem_of_superset (Q.isAdic_idealOfDefinition.hasBasis_nhds_zero.mem_of_mem
    (i := n) trivial)
  intro a ha
  obtain ⟨w, hw, heq⟩ := hn a ((Q.mem_idealImage n).mpr ⟨a, ha, rfl⟩)
  have hwQ : ∀ t ∈ T, w t ∈ Q.ringOfDefinition :=
    fun t ht ↦ Q.idealImage_le_ringOfDefinition 0 (hw t ht)
  have htQ : ∀ t ∈ T, t ∈ Q.ringOfDefinition := by
    intro t ht
    obtain ⟨g, -, rfl⟩ := Finset.mem_image.mp ht
    exact h g g.2
  have heq' : ∑ t ∈ T.attach, (⟨t.1, htQ t.1 t.2⟩ : Q.ringOfDefinition) *
      ⟨w t.1, hwQ t.1 t.2⟩ = a := by
    apply Subtype.ext
    simpa using heq
  rw [← heq']
  apply sum_mem
  intro t ht
  apply Ideal.mul_mem_right
  obtain ⟨g, hg, hgt⟩ := Finset.mem_image.mp t.2
  have hgI : g ∈ P.idealOfDefinition := hG ▸ Ideal.subset_span hg
  convert Ideal.mem_map_of_mem f₀ hgI using 1
  exact Subtype.ext hgt.symm

end PairOfDefinition

namespace IsAdicHom

variable [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]
  {f : A →+* B} {g : B →+* C}

/-- Continuity and preservation of open ideals imply adicness. -/
theorem of_continuous_isOpen_map [IsHuberRing A] [IsHuberRing B]
    (hf : Continuous f) (hopen : ∀ I : Ideal A, IsOpen (I : Set A) →
      IsOpen (I.map f : Set B)) : IsAdicHom f := by
  obtain ⟨P⟩ := IsHuberRing.nonempty_pairOfDefinition (A := A)
  obtain ⟨Q₀⟩ := IsHuberRing.nonempty_pairOfDefinition (A := B)
  have hI := hopen P.extendedIdealOfDefinition P.isOpen_extendedIdealOfDefinition
  have hb : IsBounded (P.ringOfDefinition.map f : Set B) := by
    rw [Subring.coe_map]
    exact P.isBounded_ringOfDefinition.image_of_isOpen_map_extendedIdealOfDefinition
      P Q₀ hf.continuousAt hI
  let Q := Q₀.enlargeSup (P.ringOfDefinition.map f) hb
  have h : ∀ a ∈ P.ringOfDefinition, f a ∈ Q.ringOfDefinition := by
    intro a ha
    exact Q₀.le_enlargeSup_right _ hb (Subring.mem_map.mpr ⟨a, ha, rfl⟩)
  let Q' : PairOfDefinition B :=
    { ringOfDefinition := Q.ringOfDefinition
      isOpen_ringOfDefinition := Q.isOpen_ringOfDefinition
      idealOfDefinition := P.idealOfDefinition.map (f.restrict _ _ h)
      fg_idealOfDefinition := P.fg_idealOfDefinition.map _
      isAdic_idealOfDefinition := P.isAdic_map_idealOfDefinition Q f h hf hI }
  exact ⟨P, Q', h, rfl⟩

/-- An open quotient homomorphism from a Huber ring is adic. -/
theorem of_isOpenQuotientMap [IsHuberRing A] (hf : IsOpenQuotientMap f) :
    IsAdicHom f := by
  obtain ⟨P⟩ := IsHuberRing.nonempty_pairOfDefinition (A := A)
  refine ⟨P, P.map f hf, fun a ha ↦ ?_, ?_⟩
  · rw [P.map_ringOfDefinition]
    exact Subring.mem_map.mpr ⟨a, ha, rfl⟩
  · rw [P.map_idealOfDefinition]
    rfl

/-- Intrinsic criterion: an adic homomorphism is precisely a continuous homomorphism preserving
open ideals. -/
theorem iff_continuous_isOpen_map [IsHuberRing A] [IsHuberRing B] :
    IsAdicHom f ↔ Continuous f ∧ ∀ I : Ideal A, IsOpen (I : Set A) →
      IsOpen (I.map f : Set B) :=
  ⟨fun h ↦ ⟨h.continuous, fun _ hI ↦ h.isOpen_map hI⟩,
    fun ⟨hc, ho⟩ ↦ of_continuous_isOpen_map hc ho⟩

/-- The composite of adic homomorphisms is adic. -/
theorem comp (hg : IsAdicHom g) (hf : IsAdicHom f) :
    IsAdicHom (g.comp f) := by
  obtain ⟨P, _, _, _⟩ := hf.exists_pairOfDefinition
  obtain ⟨_, Q, _, _⟩ := hg.exists_pairOfDefinition
  have : IsHuberRing A := ⟨⟨P⟩⟩
  have : IsHuberRing C := ⟨⟨Q⟩⟩
  refine of_continuous_isOpen_map (f := g.comp f) (hg.continuous.comp hf.continuous) ?_
  intro I hI
  rw [← Ideal.map_map]
  exact hg.isOpen_map (hf.isOpen_map hI)

omit [IsTopologicalRing A] in
/-- If a composite is adic and both factors are continuous, then its final factor is adic. -/
theorem of_comp [IsHuberRing B] (h : IsAdicHom (g.comp f))
    (hf : Continuous f) (hg : Continuous g) : IsAdicHom g := by
  obtain ⟨_, Q, _, _⟩ := h.exists_pairOfDefinition
  have : IsHuberRing C := ⟨⟨Q⟩⟩
  apply of_continuous_isOpen_map hg
  intro J hJ
  have ho := h.isOpen_map (I := J.comap f) (hJ.preimage hf)
  apply Submodule.isOpen_mono (U := (J.comap f).map (g.comp f)) _ ho
  rw [← Ideal.map_map]
  exact Ideal.map_mono Ideal.map_comap_le

/-- Every continuous homomorphism from a Tate ring to a Huber ring is adic. -/
theorem of_isTateRing [IsHuberRing B] [IsTateRing A]
    (hf : Continuous f) : IsAdicHom f :=
  of_continuous_isOpen_map hf fun _ hI ↦ IsTateRing.isOpen_map_of_isOpen f hI

/-- A homomorphism from a discrete Huber ring is adic exactly when its target is discrete. -/
theorem of_discrete_iff [DiscreteTopology A] :
    IsAdicHom f ↔ DiscreteTopology B := by
  constructor
  · intro hf
    rw [discreteTopology_iff_isOpen_singleton_zero]
    simpa using hf.isOpen_map (I := ⊥) (isOpen_discrete _)
  · intro hB
    let := hB
    exact of_continuous_isOpen_map (continuous_of_discreteTopology)
      (fun _ _ ↦ isOpen_discrete _)

omit [IsTopologicalRing A] [IsTopologicalRing B] in
/-- The radical criterion for compatible pairs of definition. Equality of radicals permits
replacing the target ideal by the ideal generated by the source ideal. -/
theorem of_radical_eq (P : PairOfDefinition A) (Q : PairOfDefinition B)
    (h : ∀ a ∈ P.ringOfDefinition, f a ∈ Q.ringOfDefinition)
    (hrad : (P.idealOfDefinition.map (f.restrict _ _ h)).radical =
      Q.idealOfDefinition.radical) : IsAdicHom f := by
  let Q' : PairOfDefinition B :=
    { ringOfDefinition := Q.ringOfDefinition
      isOpen_ringOfDefinition := Q.isOpen_ringOfDefinition
      idealOfDefinition := P.idealOfDefinition.map (f.restrict _ _ h)
      fg_idealOfDefinition := P.fg_idealOfDefinition.map _
      isAdic_idealOfDefinition := Q.isAdic_idealOfDefinition.of_radical_eq
        Q.fg_idealOfDefinition (P.fg_idealOfDefinition.map _) hrad.symm }
  exact ⟨P, Q', h, rfl⟩

end IsAdicHom

end TauCeti.Huber
