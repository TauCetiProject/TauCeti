/-!
# The spectral topology of a Tate ring

Let `A` be a Tate ring and write `A°°` for its topologically nilpotent elements. The *spectral
topology* on `A` is the ring topology whose neighbourhoods of zero are generated by the sets
`ϖ ^ n • A°°`, for a pseudouniformiser `ϖ` and `n ≥ 0`. It is the topology of the spectral seminorm
`|·|_sp` of any norm datum of `A`, whose open ball of radius `r ^ n` is `ϖ ^ n • A°°`; in
particular it depends neither on the norm datum nor on the pseudouniformiser. It is coarser than
the topology of `A`, and in general neither Hausdorff nor complete (Kedlaya–Liu, Remark
2.3.11(c)).

The type synonym `SpectralTop A` carries the ring structure of `A` and the spectral topology,
with the ring isomorphism `toSpectralTop : A ≃+* SpectralTop A`. The topology is defined from
the subgroups `u • A°°`, one for every pseudouniformiser `u`, which involves no choice. Then:

* the identity `A → SpectralTop A` is continuous;
* `SpectralTop A` is a Tate ring with the same topologically nilpotent elements as `A`;
* the power-bounded elements of `SpectralTop A` are those with `|x|_sp ≤ 1`, and they form a
  bounded set, so `SpectralTop A` is uniform;
* continuous homomorphisms of Tate rings are continuous for the spectral topologies.

The separated completion of `SpectralTop A` is the ring of the uniformization of `A`
(Kedlaya–Liu, Definition 2.8.13); this is what the uniform structure below is for.

## Main definitions

* `TauCeti.Huber.SpectralTop A`: the ring `A` with its spectral topology.
* `TauCeti.Huber.toSpectralTop A`: the identity of `A`, as a ring isomorphism onto
  `SpectralTop A`.
* `TauCeti.Huber.SpectralTop.map`: the homomorphism of spectral topologies induced by a ring
  homomorphism.

## Main results

* `TauCeti.Huber.SpectralTop.hasBasis_nhds_zero`: for a pseudouniformiser `ϖ`, the sets
  `ϖ ^ n • A°°` form a basis of neighbourhoods of zero.
* `TauCeti.Huber.SpectralTop.hasBasis_nhds_zero_spectralSeminorm`: for every norm datum, the open
  balls of its spectral seminorm form a basis of neighbourhoods of zero.
* `TauCeti.Huber.SpectralTop.continuous_toSpectralTop`: the identity `A → SpectralTop A` is
  continuous.
* `TauCeti.Huber.SpectralTop.isTopologicallyNilpotent_toSpectralTop_iff`: the two topologies have
  the same topologically nilpotent elements.
* `TauCeti.Huber.SpectralTop.isPseudoUniformizer_toSpectralTop_iff`: the two topologies have the
  same pseudouniformisers.
* `TauCeti.Huber.SpectralTop.isTateRing`: `SpectralTop A` is a Tate ring.
* `TauCeti.Huber.SpectralTop.powerBoundedSubring_eq`: the power-bounded elements of
  `SpectralTop A` are those of spectral seminorm at most one.
* `TauCeti.Huber.SpectralTop.isUniform`: `SpectralTop A` is uniform.
* `TauCeti.Huber.SpectralTop.continuous_map`: functoriality for continuous homomorphisms.

## References

* K. S. Kedlaya and R. Liu, *Relative p-adic Hodge theory: foundations*, Astérisque 371 (2015),
  Remark 2.3.11(c) and Definition 2.8.13.
* D. Hansen and K. S. Kedlaya, *Sheafiness criteria for Huber rings*, §2, Definition 2.3 and
  Remark 2.11.
-/

public section

open Filter Topology
open scoped Pointwise

namespace TauCeti.Huber

variable (A : Type*) [CommRing A]

/-- The ring `A` with its spectral topology, as a type synonym. The topology, defined when `A` is
a Tate ring, is generated by the sets `ϖ ^ n • A°°` for a pseudouniformiser `ϖ`
(`TauCeti.Huber.SpectralTop.hasBasis_nhds_zero`). -/
@[expose] def SpectralTop := A

instance : CommRing (SpectralTop A) := inferInstanceAs (CommRing A)

/-- The identity of `A`, as a ring isomorphism from `A` onto `SpectralTop A`. -/
def toSpectralTop : A ≃+* SpectralTop A := RingEquiv.refl A

namespace SpectralTop

section Map

variable {A} {B C : Type*} [CommRing B] [CommRing C]

/-- The homomorphism `SpectralTop A →+* SpectralTop B` with the same underlying map as
`φ : A →+* B`. It is continuous when `φ` is (`TauCeti.Huber.SpectralTop.continuous_map`). -/
def map (φ : A →+* B) : SpectralTop A →+* SpectralTop B :=
  ((toSpectralTop B : B →+* SpectralTop B).comp φ).comp (toSpectralTop A).symm

/-- `SpectralTop.map φ` acts as `φ`. -/
@[simp]
theorem map_apply (φ : A →+* B) (x : A) :
    map φ (toSpectralTop A x) = toSpectralTop B (φ x) := by
  simp [map]

/-- `SpectralTop.map` preserves identities. -/
@[simp]
theorem map_id : map (RingHom.id A) = RingHom.id (SpectralTop A) := by
  ext x
  simpa using map_apply (RingHom.id A) ((toSpectralTop A).symm x)

/-- `SpectralTop.map` preserves composition. -/
theorem map_comp (ψ : B →+* C) (φ : A →+* B) : map (ψ.comp φ) = (map ψ).comp (map φ) := by
  ext x
  obtain ⟨x, rfl⟩ := (toSpectralTop A).surjective x
  simp

end Map

section Topology

variable {A} [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]

/-- The subgroup `u • A°°` of `SpectralTop A`: the elements `x` with `u⁻¹ x` topologically
nilpotent in `A`. For pseudouniformisers `u` these form the basis of the spectral topology. -/
private def basisSubgroup (u : Aˣ) : AddSubgroup (SpectralTop A) where
  carrier := {x | IsTopologicallyNilpotent (((u⁻¹ : Aˣ) : A) * (toSpectralTop A).symm x)}
  zero_mem' := by simpa using IsTopologicallyNilpotent.zero
  add_mem' {x y} hx hy := by
    simpa [mul_add] using isTopologicallyNilpotent_add hx hy
  neg_mem' {x} hx := by simpa using hx.neg

private theorem mem_basisSubgroup {u : Aˣ} {x : SpectralTop A} :
    x ∈ basisSubgroup u ↔
      IsTopologicallyNilpotent (((u⁻¹ : Aˣ) : A) * (toSpectralTop A).symm x) :=
  Iff.rfl

/-- If `u⁻¹ v` is power-bounded, then `v • A°° ⊆ u • A°°`. -/
private theorem basisSubgroup_le {u v : Aˣ} (h : IsPowerBounded (((u⁻¹ : Aˣ) : A) * v)) :
    basisSubgroup v ≤ basisSubgroup u := fun x hx ↦ by
  have := h.isTopologicallyNilpotent_mul (mem_basisSubgroup.mp hx)
  rwa [mul_assoc, Units.mul_inv_cancel_left] at this

/-- For a topologically nilpotent unit `v`, some power `v ^ n • A°°` lies in `u • A°°`. -/
private theorem exists_basisSubgroup_pow_le (u : Aˣ) {v : Aˣ}
    (hv : IsTopologicallyNilpotent (v : A)) : ∃ n : ℕ, basisSubgroup (v ^ n) ≤ basisSubgroup u := by
  obtain ⟨n, hn⟩ := hv.exists_pow_mul ((u⁻¹ : Aˣ) : A)
  refine ⟨n, basisSubgroup_le ?_⟩
  simpa [mul_comm] using IsPowerBounded.of_isTopologicallyNilpotent hn

/-- The subgroups `u • A°°`, for `u` a pseudouniformiser, form a basis of a ring topology. -/
private theorem ringSubgroupsBasis :
    RingSubgroupsBasis fun u : {u : Aˣ // IsTopologicallyNilpotent (u : A)} ↦
      basisSubgroup (u : Aˣ) := by
  refine .of_comm _ (fun u v ↦ ?_) (fun u ↦ ⟨u, ?_⟩) fun x u ↦ ?_
  · -- `uv • A°°` lies in both `u • A°°` and `v • A°°`.
    have hu := IsPowerBounded.of_isTopologicallyNilpotent u.2
    have hv := IsPowerBounded.of_isTopologicallyNilpotent v.2
    refine ⟨⟨u.1 * v.1, by simpa using hu.isTopologicallyNilpotent_mul v.2⟩,
      le_inf (basisSubgroup_le ?_) (basisSubgroup_le ?_)⟩
    · simpa using hv
    · simpa [mul_comm (u.1 : A)] using hu
  · -- `u⁻¹ (xy) = (u⁻¹ x) (u⁻¹ y u)`, and `u⁻¹ y u` is power-bounded.
    rintro _ ⟨x, hx, y, hy, rfl⟩
    have hpb := (IsPowerBounded.of_isTopologicallyNilpotent (mem_basisSubgroup.mp hy)).mul
      (IsPowerBounded.of_isTopologicallyNilpotent u.2)
    refine mem_basisSubgroup.mpr ?_
    convert hpb.isTopologicallyNilpotent_mul (mem_basisSubgroup.mp hx) using 1
    rw [map_mul]
    linear_combination -(((u.1⁻¹ : Aˣ) : A) * (toSpectralTop A).symm x *
      (toSpectralTop A).symm y) * Units.inv_mul u.1
  · -- If `uⁿ x` is topologically nilpotent, then `x • (u ^ (n + 1) • A°°) ⊆ u • A°°`.
    obtain ⟨n, hn⟩ := u.2.exists_pow_mul ((toSpectralTop A).symm x)
    refine ⟨⟨u.1 ^ (n + 1), by simpa using u.2.pow n.succ_ne_zero⟩, fun y hy ↦ ?_⟩
    have := (IsPowerBounded.of_isTopologicallyNilpotent hn).isTopologicallyNilpotent_mul
      (mem_basisSubgroup.mp hy)
    refine mem_basisSubgroup.mpr ?_
    convert this using 1
    simp only [map_mul, ← inv_pow, Units.val_pow_eq_pow_val]
    calc ((u.1⁻¹ : Aˣ) : A) * ((toSpectralTop A).symm x * (toSpectralTop A).symm y) =
        ((u.1⁻¹ : Aˣ) : A) * (toSpectralTop A).symm x * (toSpectralTop A).symm y *
          ((u.1 : A) * ((u.1⁻¹ : Aˣ) : A)) ^ n := by
          rw [Units.mul_inv, one_pow, mul_one, mul_assoc]
      _ = _ := by ring

private theorem nonempty_pseudoUniformizer :
    Nonempty {u : Aˣ // IsTopologicallyNilpotent (u : A)} := by
  obtain ⟨ϖ, hϖ⟩ := IsTateRing.exists_isPseudoUniformizer (A := A)
  exact ⟨⟨hϖ.isUnit.unit, hϖ.isTopologicallyNilpotent⟩⟩

/-- The spectral topology of a Tate ring, generated by the subgroups `u • A°°` for the
pseudouniformisers `u` of `A`. -/
@[instance_reducible] noncomputable def topology : TopologicalSpace (SpectralTop A) :=
  haveI := nonempty_pseudoUniformizer (A := A)
  ringSubgroupsBasis.topology

attribute [instance] topology

/-- The spectral topology is a ring topology. -/
theorem isTopologicalRing : IsTopologicalRing (SpectralTop A) :=
  haveI := nonempty_pseudoUniformizer (A := A)
  ringSubgroupsBasis.toRingFilterBasis.isTopologicalRing

attribute [instance] isTopologicalRing

private theorem hasBasis_nhds_zero_basisSubgroup :
    (𝓝 (0 : SpectralTop A)).HasBasis (fun _ ↦ True)
      fun u : {u : Aˣ // IsTopologicallyNilpotent (u : A)} ↦ (basisSubgroup (u : Aˣ) : Set _) :=
  haveI := nonempty_pseudoUniformizer (A := A)
  ringSubgroupsBasis.hasBasis_nhds_zero

/-- The basis subgroup `u • A°°` of a pseudouniformiser `u` is a neighbourhood of zero. -/
private theorem basisSubgroup_mem_nhds (u : {u : Aˣ // IsTopologicallyNilpotent (u : A)}) :
    (basisSubgroup (u : Aˣ) : Set (SpectralTop A)) ∈ 𝓝 0 :=
  hasBasis_nhds_zero_basisSubgroup.mem_of_mem trivial

/-- The additive uniformity of the spectral topology. -/
noncomputable instance : UniformSpace (SpectralTop A) := IsTopologicalAddGroup.rightUniformSpace _

/-- The spectral uniformity is compatible with addition. -/
instance isUniformAddGroup : IsUniformAddGroup (SpectralTop A) := isUniformAddGroup_of_addCommGroup

omit [IsTopologicalRing A] [IsTateRing A] in
/-- `y ∈ uⁿ • A°°` if and only if `u⁻ⁿ y` is topologically nilpotent. -/
private theorem mem_pow_smul_iff (u : Aˣ) (n : ℕ) {y : A} :
    y ∈ (u : A) ^ n • {a : A | IsTopologicallyNilpotent a} ↔
      IsTopologicallyNilpotent ((((u ^ n)⁻¹ : Aˣ) : A) * y) := by
  rw [Set.mem_smul_set, ← Units.val_pow_eq_pow_val]
  constructor
  · rintro ⟨z, hz, rfl⟩
    rwa [smul_eq_mul, Units.inv_mul_cancel_left]
  · exact fun hy ↦ ⟨_, hy, by rw [smul_eq_mul, Units.mul_inv_cancel_left]⟩

/-- The image of `uⁿ • A°°` in `SpectralTop A` is the basis subgroup of `uⁿ`. -/
private theorem image_pow_smul (u : Aˣ) (n : ℕ) :
    toSpectralTop A '' ((u : A) ^ n • {a : A | IsTopologicallyNilpotent a}) =
      basisSubgroup (u ^ n) := by
  ext x
  rw [SetLike.mem_coe, mem_basisSubgroup, ← mem_pow_smul_iff]
  constructor
  · rintro ⟨y, hy, rfl⟩
    rwa [RingEquiv.symm_apply_apply]
  · exact fun hx ↦ ⟨_, hx, RingEquiv.apply_symm_apply _ _⟩

/-- **The basis of the spectral topology.** For a pseudouniformiser `ϖ` of `A`, the sets
`ϖ ^ n • A°°`, `n ≥ 0`, form a basis of neighbourhoods of zero in `SpectralTop A`. -/
theorem hasBasis_nhds_zero {ϖ : A} (hϖ : IsPseudoUniformizer ϖ) :
    (𝓝 (0 : SpectralTop A)).HasBasis (fun _ : ℕ ↦ True)
      fun n ↦ toSpectralTop A '' (ϖ ^ n • {a : A | IsTopologicallyNilpotent a}) := by
  obtain ⟨u, rfl⟩ := hϖ.isUnit
  have hnil := hϖ.isTopologicallyNilpotent
  simp only [image_pow_smul]
  refine hasBasis_nhds_zero_basisSubgroup.to_hasBasis (fun v _ ↦ ?_) fun n _ ↦ ?_
  · obtain ⟨n, hn⟩ := exists_basisSubgroup_pow_le v.1 hnil
    exact ⟨n, trivial, hn⟩
  · have hpb : IsPowerBounded ((((u ^ n)⁻¹ : Aˣ) : A) * ((u ^ (n + 1) : Aˣ) : A)) := by
      rw [pow_succ, Units.val_mul, ← mul_assoc, Units.inv_mul, one_mul]
      exact IsPowerBounded.of_isTopologicallyNilpotent hnil
    exact ⟨⟨u ^ (n + 1), by simpa using hnil.pow n.succ_ne_zero⟩, trivial, basisSubgroup_le hpb⟩

/-- **The spectral topology is the topology of the spectral seminorm**: for every norm datum `d`
of `A`, the open balls of `spectralSeminorm d` form a basis of neighbourhoods of zero in
`SpectralTop A`. -/
theorem hasBasis_nhds_zero_spectralSeminorm (d : TateNormDatum A) :
    (𝓝 (0 : SpectralTop A)).HasBasis (fun ε : ℝ ↦ 0 < ε)
      fun ε ↦ toSpectralTop A '' {x | spectralSeminorm d x < ε} := by
  -- The ball of radius `r ^ n` is `ϖ ^ n • A°°`.
  have hball (n : ℕ) : {x | spectralSeminorm d x < d.radius ^ n} =
      (d.pseudoUniformizer : A) ^ n • {a : A | IsTopologicallyNilpotent a} := by
    ext x
    rw [Set.mem_ofPred_eq, spectralSeminorm_lt_pow_iff, mem_pow_smul_iff, zpow_neg, zpow_natCast]
  refine (hasBasis_nhds_zero d.isPseudoUniformizer).to_hasBasis (fun n _ ↦ ?_) fun ε hε ↦ ?_
  · exact ⟨d.radius ^ n, pow_pos d.radius_pos n, by rw [hball]⟩
  · obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hε d.radius_lt_one
    exact ⟨n, trivial, by rw [← hball]; exact Set.image_mono fun x hx ↦ hx.trans hn⟩

/-- **The spectral topology is coarser**: the identity `A → SpectralTop A` is continuous. -/
@[fun_prop]
theorem continuous_toSpectralTop : Continuous (toSpectralTop A) := by
  refine continuous_of_tendsto_nhds_zero (toSpectralTop A)
    (hasBasis_nhds_zero_basisSubgroup.tendsto_right_iff.mpr fun u _ ↦ ?_)
  -- `u⁻¹ x` is topologically nilpotent near zero, since `A°°` contains an open ideal image.
  obtain ⟨P⟩ := IsHuberRing.nonempty_pairOfDefinition (A := A)
  have hP : (P.idealImage 1 : Set A) ∈ 𝓝 0 := (P.isOpen_idealImage 1).mem_nhds (zero_mem _)
  filter_upwards [(continuous_const_mul ((u.1⁻¹ : Aˣ) : A)).tendsto' 0 0 (mul_zero _) hP]
    with x hx
  simpa [mem_basisSubgroup] using P.isTopologicallyNilpotent_of_mem_idealImage one_ne_zero hx

/-- **The spectral topology has the same topologically nilpotent elements as `A`.** -/
@[simp]
theorem isTopologicallyNilpotent_toSpectralTop_iff {x : A} :
    IsTopologicallyNilpotent (toSpectralTop A x) ↔ IsTopologicallyNilpotent x := by
  refine ⟨fun h ↦ ?_, fun h ↦ h.map continuous_toSpectralTop⟩
  -- Some positive power `xⁿ` lies in `ϖ • A°° ⊆ A°°`.
  obtain ⟨⟨u, hu⟩⟩ := nonempty_pseudoUniformizer (A := A)
  obtain ⟨n, hn, hn0⟩ :=
    ((h.eventually_mem (basisSubgroup_mem_nhds ⟨u, hu⟩)).and (eventually_ne_atTop 0)).exists
  rw [SetLike.mem_coe, mem_basisSubgroup, ← map_pow, RingEquiv.symm_apply_apply] at hn
  refine IsTopologicallyNilpotent.of_pow hn0 ?_
  simpa using (IsPowerBounded.of_isTopologicallyNilpotent hu).isTopologicallyNilpotent_mul hn

/-- **The spectral topology has the same pseudouniformisers as `A`.** -/
theorem isPseudoUniformizer_toSpectralTop_iff {ϖ : A} :
    IsPseudoUniformizer (toSpectralTop A ϖ) ↔ IsPseudoUniformizer ϖ := by
  simp [isPseudoUniformizer_iff]

/-- **The spectral topology is a Tate topology**: the image of the power-bounded subring of `A`
is an open bounded subring of `SpectralTop A`, and a pseudouniformiser of `A` remains one. -/
instance isTateRing : IsTateRing (SpectralTop A) := by
  obtain ⟨ϖ, hϖ⟩ := IsTateRing.exists_isPseudoUniformizer (A := A)
  let S : Subring (SpectralTop A) :=
    (powerBoundedSubring A).map (toSpectralTop A : A →+* SpectralTop A)
  have hS {x : SpectralTop A} : x ∈ S ↔ IsPowerBounded ((toSpectralTop A).symm x) :=
    Subring.mem_map_equiv.trans mem_powerBoundedSubring
  refine IsTateRing.of_isOpen_isBounded S ?_ ?_ (ϖ := toSpectralTop A ϖ)
    (isPseudoUniformizer_toSpectralTop_iff.mpr hϖ)
  · -- `S` contains the neighbourhood `u • A°°` of zero.
    obtain ⟨⟨u, hu⟩⟩ := nonempty_pseudoUniformizer (A := A)
    refine S.toAddSubgroup.isOpen_of_mem_nhds
      (Filter.mem_of_superset (basisSubgroup_mem_nhds ⟨u, hu⟩) fun x hx ↦ hS.mpr ?_)
    simpa using (IsPowerBounded.of_isTopologicallyNilpotent hu).mul
      (IsPowerBounded.of_isTopologicallyNilpotent (mem_basisSubgroup.mp hx))
  · -- `(u • A°°) * S ⊆ u • A°°`, since `A°° A° ⊆ A°°`.
    refine isBounded_iff.mpr fun U hU ↦ ?_
    obtain ⟨u, -, huU⟩ := hasBasis_nhds_zero_basisSubgroup.mem_iff.mp hU
    refine ⟨_, basisSubgroup_mem_nhds u, ?_⟩
    rintro _ ⟨x, hx, s, hs, rfl⟩
    refine huU (mem_basisSubgroup.mpr ?_)
    simpa [mul_comm, mul_left_comm] using
      (hS.mp hs).isTopologicallyNilpotent_mul (mem_basisSubgroup.mp hx)

variable (d : TateNormDatum A)

/-- The elements of spectral seminorm at most one form a bounded subset of `SpectralTop A`. -/
theorem isBounded_setOf_spectralSeminorm_le_one :
    IsBounded (toSpectralTop A '' {x | spectralSeminorm d x ≤ 1}) := by
  refine isBounded_iff.mpr fun U hU ↦ ?_
  obtain ⟨ε, hε, hεU⟩ := (hasBasis_nhds_zero_spectralSeminorm d).mem_iff.mp hU
  refine ⟨_, (hasBasis_nhds_zero_spectralSeminorm d).mem_of_mem hε, ?_⟩
  rintro _ ⟨_, ⟨v, hv, rfl⟩, _, ⟨s, hs, rfl⟩, rfl⟩
  refine hεU ⟨v * s, ?_, map_mul _ v s⟩
  calc spectralSeminorm d (v * s) ≤ spectralSeminorm d v * spectralSeminorm d s :=
        map_mul_le_mul _ v s
    _ ≤ spectralSeminorm d v * 1 := by gcongr; exact hs
    _ < ε := by rwa [mul_one]

/-- **The power-bounded elements of the spectral topology** are the elements of spectral
seminorm at most one, for any norm datum `d`. -/
theorem isPowerBounded_toSpectralTop_iff {x : A} :
    IsPowerBounded (toSpectralTop A x) ↔ spectralSeminorm d x ≤ 1 := by
  constructor
  · -- If `|x|_sp > 1`, the products `ϖ ^ m x · x ^ k` leave the unit ball, although the
    -- `ϖ ^ m x` tend to zero.
    intro hx
    by_contra! h
    obtain ⟨V, hV, hVU⟩ := isBounded_iff.mp (isPowerBounded_iff.mp hx) _
      ((hasBasis_nhds_zero_spectralSeminorm d).mem_of_mem one_pos)
    obtain ⟨δ, hδ, hδV⟩ := (hasBasis_nhds_zero_spectralSeminorm d).mem_iff.mp hV
    have hx0 : 0 < spectralSeminorm d x := one_pos.trans h
    obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one (div_pos hδ hx0) d.radius_lt_one
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt (d.radius ^ m)⁻¹ h
    let w : A := (d.pseudoUniformizer : A) ^ m
    have hwx : toSpectralTop A (w * x) ∈ V := hδV ⟨w * x, by
      simpa [w] using (lt_div_iff₀ hx0).mp hm, rfl⟩
    obtain ⟨y, hy, hyx⟩ := hVU (Set.mul_mem_mul hwx ⟨k, rfl⟩)
    obtain rfl : y = w * x ^ (k + 1) :=
      (toSpectralTop A).injective (by simp [hyx, pow_succ', mul_assoc])
    -- `|ϖ ^ m x ^ (k + 1)|_sp = r ^ m |x|_sp ^ (k + 1) > r ^ m (r ^ m)⁻¹ = 1`.
    have hpos := pow_pos d.radius_pos m
    refine (show spectralSeminorm d (w * x ^ (k + 1)) < 1 from hy).not_ge ?_
    calc 1 = d.radius ^ m * (d.radius ^ m)⁻¹ := (mul_inv_cancel₀ hpos.ne').symm
      _ ≤ d.radius ^ m * spectralSeminorm d x ^ (k + 1) := by
          gcongr
          exact hk.le.trans (pow_le_pow_right₀ h.le k.le_succ)
      _ = spectralSeminorm d (w * x ^ (k + 1)) := by
          rw [spectralSeminorm_pow_mul, isPowMul_spectralSeminorm d x k.succ_pos]
  · -- The powers of `x` stay in the bounded set of elements of spectral seminorm at most one.
    intro hx
    refine isPowerBounded_iff.mpr ((isBounded_setOf_spectralSeminorm_le_one d).subset ?_)
    rintro _ ⟨k, rfl⟩
    refine ⟨x ^ k, ?_, map_pow _ x k⟩
    rcases k.eq_zero_or_pos with rfl | hk
    · simpa using (spectralSeminorm_le_tateNorm d 1).trans (tateNorm_one_le d)
    · rw [Set.mem_ofPred_eq, isPowMul_spectralSeminorm d x hk]
      exact pow_le_one₀ (apply_nonneg _ x) hx

/-- The power-bounded subring `(SpectralTop A)°` is the image of the closed unit ball of the
spectral seminorm of any norm datum `d`. -/
theorem powerBoundedSubring_eq :
    (powerBoundedSubring (SpectralTop A) : Set (SpectralTop A)) =
      toSpectralTop A '' {x | spectralSeminorm d x ≤ 1} := by
  ext x
  obtain ⟨x, rfl⟩ := (toSpectralTop A).surjective x
  rw [SetLike.mem_coe, mem_powerBoundedSubring, isPowerBounded_toSpectralTop_iff d,
    (toSpectralTop A).injective.mem_set_image, Set.mem_ofPred_eq]

/-- **The spectral topology is uniform**: its power-bounded elements form a bounded set. -/
instance isUniform : IsUniform (SpectralTop A) := by
  obtain ⟨d⟩ := (inferInstance : Nonempty (TateNormDatum A))
  rw [isUniform_iff, ← coe_powerBoundedSubring, powerBoundedSubring_eq d]
  exact isBounded_setOf_spectralSeminorm_le_one d

/-- **Functoriality of the spectral topology**: a continuous homomorphism of Tate rings is
continuous for their spectral topologies. -/
@[fun_prop]
theorem continuous_map {B : Type*} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsTateRing B] {φ : A →+* B} (hφ : Continuous φ) : Continuous (map φ) := by
  obtain ⟨ϖ, hϖ⟩ := IsTateRing.exists_isPseudoUniformizer (A := A)
  refine continuous_of_tendsto_nhds_zero (map φ) ?_
  rw [(hasBasis_nhds_zero hϖ).tendsto_iff (hasBasis_nhds_zero (hϖ.map hφ))]
  refine fun n _ ↦ ⟨n, trivial, ?_⟩
  rintro _ ⟨_, ⟨a, ha, rfl⟩, rfl⟩
  exact ⟨_, ⟨φ a, ha.map hφ, rfl⟩, by simp⟩

