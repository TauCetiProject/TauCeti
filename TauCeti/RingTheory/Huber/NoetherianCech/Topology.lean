module

public import TauCeti.Algebra.Module.LocalizedModule.Cech
public import TauCeti.RingTheory.Huber.LocalizationTopology.Basic
public import TauCeti.RingTheory.Huber.ModuleTopology.Basic
public import Mathlib.Topology.Algebra.IsUniformGroup.Defs
import Mathlib.Topology.Algebra.Algebra

/-!
# The topology of the Čech complex of uncompleted rational localisations

Let `B` be a topological ring with a pair of definition `(C, I)`, let `f : ι → B` be a family
generating the unit ideal and let `M` be a `B`-module. For a finite set `S ⊆ ι` with `p + 1`
elements write `f_S = ∏_{i ∈ S} f i`. The intersection `U_S = ⋂_{i ∈ S} R(f / f i)` of the
standard rational subsets is the rational subset `R(F_p / f_S)`, whose numerators
`F_p = {∏_k f (j k) | j : Fin (p + 1) → ι}` are the products of `p + 1` members of the family.
Its uncompleted coordinate ring is the localisation `B_{f_S}`, with Wedhorn's topology
`TauCeti.Huber.PairOfDefinition.locTopology`: the ring of definition is
`C[F_p / f_S] = C[f j / f i : j ∈ ι, i ∈ S]` with ideal of definition generated by `I`.

The degree `p` term `∏_{|S| = p + 1} M_{f_S}` of the Čech complex of localizations
(`TauCeti.cechLocalizationTerm`) is then a product of modules over these Huber rings. This file
gives it the product of their natural module topologies and the corresponding uniformity, and
describes the topology by the filtration of Huber's proof of sheafiness for Huber rings with a
noetherian ring of definition: for a set `N` of generators of `M`, the `i`-th subgroup in degree
`p` is the product over the faces `S` of `Iⁱ · C[F_p / f_S] · N ⊆ M_{f_S}`. When `ι` is finite,
`N` is finite and `N` generates `M`, these subgroups form a basis of neighbourhoods of zero. These
are the topologised terms whose completions form Huber's completed Čech complex.

No noetherian or completeness hypothesis is needed for anything in this file. The noetherian ring
of definition enters in the strictness of the complex and in the topology of its augmentation
term, which are not treated here.

## Main definitions

* `TauCeti.Huber.NoetherianCech.numerators f p`: the numerators `F_p` of the rational subsets
  `U_S`, `|S| = p + 1`.
* `TauCeti.Huber.NoetherianCech.faceTopology` and `TauCeti.Huber.NoetherianCech.facePair`: the
  topology of `B_{f_S}` as the uncompleted rational localisation `B(F_p / f_S)`, and its pair of
  definition.
* `TauCeti.Huber.NoetherianCech.termTopology`, `termUniformSpace`: the product of the natural
  module topologies on the term of degree `p`, and its additive uniformity.
* `TauCeti.Huber.NoetherianCech.filtration`: Huber's filtration `K_i^p` of the term of degree `p`.

## Main results

* `TauCeti.Huber.NoetherianCech.hasDenominatorPower`: Wedhorn's denominator-power hypothesis for
  every face, so that the topologies above exist.
* `TauCeti.Huber.NoetherianCech.isTopologicalAddGroup_termTopology` and
  `isUniformAddGroup_termUniformSpace`: the term is a topological, and a uniform, additive group.
* `TauCeti.Huber.NoetherianCech.hasBasis_nhds_zero_filtration`: the filtration is a basis of
  neighbourhoods of zero.
* `TauCeti.Huber.NoetherianCech.hasBasis_uniformity_filtration`: the filtration gives a basis of
  entourages of `termUniformSpace`.

## References

* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217
  (1994), §2, proof of Theorem 2.5, Case I, (1.2)(ii) and (1.3.1)(ii).
* [T. Wedhorn, *Adic Spaces*][wedhorn_adic], Proposition and Definition 5.51.
-/

public section

open Filter Topology LocalizedModule

namespace TauCeti.Huber.NoetherianCech

variable {B : Type*} [CommRing B] {ι : Type*} (f : ι → B)

/-! ### The numerators of the faces -/

/-- The numerators `F_p = {∏_k f (j k) | j : Fin (p + 1) → ι}` of the rational subset
`⋂_{i ∈ S} R(f / f i) = R(F_p / f_S)` attached to a face `S` with `p + 1` elements. -/
def numerators (p : ℕ) : Set B :=
  Set.range fun j : Fin (p + 1) → ι ↦ ∏ k, f (j k)

/-- The numerators in degree `p` are the products of `p + 1` members of the family. -/
@[simp]
theorem mem_numerators {p : ℕ} {b : B} :
    b ∈ numerators f p ↔ ∃ j : Fin (p + 1) → ι, ∏ k, f (j k) = b :=
  Iff.rfl

/-- Each `f i ^ (p + 1)` is a numerator in degree `p`. -/
theorem pow_mem_numerators (p : ℕ) (i : ι) : f i ^ (p + 1) ∈ numerators f p :=
  ⟨fun _ ↦ i, by simp⟩

/-- If the `f i` generate the unit ideal, so do the numerators in every degree. -/
theorem span_numerators_eq_top (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ) :
    Ideal.span (numerators f p) = ⊤ := by
  refine top_unique ((Ideal.span_pow_eq_top _ hf (p + 1)).symm.le.trans (Ideal.span_mono ?_))
  rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
  exact pow_mem_numerators f p i

/-- Multiplying a degree-`p` numerator by one cover element gives a degree-`p + 1` numerator. -/
theorem mul_mem_numerators {p : ℕ} {t : B} (ht : t ∈ numerators f p) (a : ι) :
    t * f a ∈ numerators f (p + 1) := by
  obtain ⟨j, rfl⟩ := (mem_numerators f).mp ht
  apply (mem_numerators f).mpr
  exact ⟨Fin.snoc j a, by simp [Fin.prod_univ_castSucc]⟩

variable [TopologicalSpace B] [IsTopologicalRing B] (P : PairOfDefinition B)

/-- **The denominator-power hypothesis holds on every face.** If the `f i` generate the unit
ideal, so do the numerators `F_p`, and an open (here: the unit) numerator ideal supplies Wedhorn's
standing hypothesis for every denominator, in particular for `f_S`. -/
theorem hasDenominatorPower (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ) (S : Finset ι) :
    P.HasDenominatorPower (numerators f p) (∏ i ∈ S, f i)
      (Localization.Away (∏ i ∈ S, f i)) :=
  P.hasDenominatorPower_of_isOpen_span _ _ _ <| by
    rw [span_numerators_eq_top f hf p]; exact isOpen_univ

/-! ### The topology of a face -/

/-- The topology of `B_{f_S}` as the uncompleted rational localisation `B(F_p / f_S)`. -/
@[instance_reducible] noncomputable def faceTopology (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ)
    (S : Finset ι) : TopologicalSpace (Localization.Away (∏ i ∈ S, f i)) :=
  P.locTopology (numerators f p) _ _ (hasDenominatorPower f P hf p S)

/-- `faceTopology` is a ring topology. -/
theorem isTopologicalRing_faceTopology (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ)
    (S : Finset ι) :
    @IsTopologicalRing _ (faceTopology f P hf p S) _ :=
  P.isTopologicalRing_locTopology _ _ _ _

/-- `faceTopology` is Wedhorn's topology on `B_{f_S}` for the numerators `F_p`. -/
theorem faceTopology_eq_locTopology (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ)
    (S : Finset ι) :
    faceTopology f P hf p S =
      P.locTopology (numerators f p) _ _ (hasDenominatorPower f P hf p S) :=
  (rfl)

/-- The pair of definition `(C[F_p / f_S], I · C[F_p / f_S])` of `B(F_p / f_S)`. -/
noncomputable def facePair (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ) (S : Finset ι) :
    letI := faceTopology f P hf p S
    PairOfDefinition (Localization.Away (∏ i ∈ S, f i)) :=
  P.localization (numerators f p) _ _ (hasDenominatorPower f P hf p S)

/-- The ring of definition of `facePair` is `C[F_p / f_S]`. -/
@[simp]
theorem facePair_ringOfDefinition (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ) (S : Finset ι) :
    letI := faceTopology f P hf p S
    (facePair f P hf p S).ringOfDefinition =
      P.locSubring (numerators f p) (∏ i ∈ S, f i) (Localization.Away (∏ i ∈ S, f i)) :=
  P.localization_ringOfDefinition _ _ _ _

/-- Membership in the ideal of definition of `facePair` is membership in `I · C[F_p / f_S]`. -/
@[simp]
theorem mem_facePair_idealOfDefinition (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ)
    (S : Finset ι) {x : letI := faceTopology f P hf p S; (facePair f P hf p S).ringOfDefinition} :
    letI := faceTopology f P hf p S
    x ∈ (facePair f P hf p S).idealOfDefinition ↔
      (⟨x, by rw [← facePair_ringOfDefinition f P hf p S]; exact x.2⟩ :
        P.locSubring (numerators f p) (∏ i ∈ S, f i) (Localization.Away (∏ i ∈ S, f i))) ∈
        P.locIdeal (numerators f p) _ _ :=
  P.mem_localization_idealOfDefinition _ _ _ _

/-! ### The topology of the terms -/

variable (M : Type*) [AddCommGroup M] [Module B M]

/-- The natural topology of `M_{f_S}` as a module over the uncompleted rational localisation
`B(F_p / f_S)`. -/
@[instance_reducible] noncomputable def faceModuleTopology (hf : Ideal.span (Set.range f) = ⊤)
    (p : ℕ) (S : Finset ι) : TopologicalSpace (LocalizedModule (.powers (∏ i ∈ S, f i)) M) :=
  letI := faceTopology f P hf p S
  moduleTopology (Localization.Away (∏ i ∈ S, f i)) _

/-- `faceModuleTopology` is the natural module topology over `B(F_p / f_S)`. -/
theorem isModuleTopology_faceModuleTopology (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ)
    (S : Finset ι) :
    letI := faceTopology f P hf p S
    letI := faceModuleTopology f P M hf p S
    IsModuleTopology (Localization.Away (∏ i ∈ S, f i))
      (LocalizedModule (.powers (∏ i ∈ S, f i)) M) := by
  let _ := faceTopology f P hf p S
  let _ := faceModuleTopology f P M hf p S
  exact ⟨rfl⟩

/-- `M_{f_S}` is a topological additive group for `faceModuleTopology`. -/
theorem isTopologicalAddGroup_faceModuleTopology (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ)
    (S : Finset ι) :
    @IsTopologicalAddGroup _ (faceModuleTopology f P M hf p S) _ :=
  letI := faceTopology f P hf p S
  letI := faceModuleTopology f P M hf p S
  haveI := isModuleTopology_faceModuleTopology f P M hf p S
  IsModuleTopology.isTopologicalAddGroup (Localization.Away (∏ i ∈ S, f i)) _

/-- The natural topology on a localized module makes its action by the original coefficient
ring continuous. -/
theorem continuousSMul_faceModuleTopology (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ)
    (S : Finset ι) :
    letI := faceModuleTopology f P M hf p S
    ContinuousSMul B (LocalizedModule (.powers (∏ i ∈ S, f i)) M) := by
  let _ := faceTopology f P hf p S
  let _ := faceModuleTopology f P M hf p S
  have := isModuleTopology_faceModuleTopology f P M hf p S
  have := IsModuleTopology.toContinuousSMul (Localization.Away (∏ i ∈ S, f i))
    (LocalizedModule (.powers (∏ i ∈ S, f i)) M)
  have hc : @Continuous _ _ _ (faceTopology f P hf p S)
      (algebraMap B (Localization.Away (∏ i ∈ S, f i))) := by
    rw [faceTopology_eq_locTopology]
    exact P.continuous_algebraMap_locTopology _ _ _ _
  have := isTopologicalRing_faceTopology f P hf p S
  have := continuousSMul_of_algebraMap B (Localization.Away (∏ i ∈ S, f i)) hc
  exact IsScalarTower.continuousSMul (Localization.Away (∏ i ∈ S, f i))

/-- The topology on the term `∏_{|S| = p + 1} M_{f_S}` of degree `p` of the Čech complex of
localizations: the product of the natural module topologies of the `M_{f_S}` over the
uncompleted rational localisations `B(F_p / f_S)`. -/
@[instance_reducible] noncomputable def termTopology (hf : Ideal.span (Set.range f) = ⊤)
    (p : ℕ) : TopologicalSpace (cechLocalizationTerm M f p) :=
  @Pi.topologicalSpace _
    (fun S : {S : Finset ι // S.card = p + 1} ↦ LocalizedModule (.powers (∏ i ∈ S.1, f i)) M)
    fun S ↦ faceModuleTopology f P M hf p S.1

/-- `termTopology` is the product of the natural module topologies of the factors. -/
theorem termTopology_eq_pi (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ) :
    termTopology f P M hf p =
      @Pi.topologicalSpace _
        (fun S : {S : Finset ι // S.card = p + 1} ↦ LocalizedModule (.powers (∏ i ∈ S.1, f i)) M)
        fun S ↦ faceModuleTopology f P M hf p S.1 :=
  (rfl)

/-- The term of degree `p` is a topological additive group. -/
theorem isTopologicalAddGroup_termTopology (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ) :
    @IsTopologicalAddGroup _ (termTopology f P M hf p) _ :=
  @Pi.isTopologicalAddGroup _
    (fun S : {S : Finset ι // S.card = p + 1} ↦ LocalizedModule (.powers (∏ i ∈ S.1, f i)) M)
    (fun S ↦ faceModuleTopology f P M hf p S.1) _
    fun S ↦ isTopologicalAddGroup_faceModuleTopology f P M hf p S.1

/-- The additive uniformity of `termTopology`. -/
@[instance_reducible] noncomputable def termUniformSpace (hf : Ideal.span (Set.range f) = ⊤)
    (p : ℕ) : UniformSpace (cechLocalizationTerm M f p) :=
  @IsTopologicalAddGroup.rightUniformSpace _ _ (termTopology f P M hf p)
    (isTopologicalAddGroup_termTopology f P M hf p)

/-- `termUniformSpace` induces `termTopology`. -/
theorem termUniformSpace_toTopologicalSpace (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ) :
    (termUniformSpace f P M hf p).toTopologicalSpace = termTopology f P M hf p :=
  (rfl)

/-- The term of degree `p` is a uniform additive group for `termUniformSpace`. -/
instance isUniformAddGroup_termUniformSpace (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ) :
    @IsUniformAddGroup _ (termUniformSpace f P M hf p) _ :=
  @isUniformAddGroup_of_addCommGroup _ _ (termTopology f P M hf p)
    (isTopologicalAddGroup_termTopology f P M hf p)

/-! ### Huber's filtration -/

/-- The `i`-th subgroup `Iⁱ · C[F_p / f_S] · N` of `M_{f_S}`, where `N ⊆ M` is mapped to `M_{f_S}`
by `m ↦ m / 1`. These are the sections over the chart `D₊(f_S T^{p + 1})` of `Iⁱ` times the
sheaf associated to the submodule generated by `N` on Huber's submodule blow-up. -/
noncomputable def faceFiltration (hf : Ideal.span (Set.range f) = ⊤) (N : Set M) (p : ℕ)
    (S : Finset ι) (i : ℕ) : AddSubgroup (LocalizedModule (.powers (∏ j ∈ S, f j)) M) :=
  letI := faceTopology f P hf p S
  ((facePair f P hf p S).idealOfDefinition ^ i •
    Submodule.span (facePair f P hf p S).ringOfDefinition
      (mkLinearMap (.powers (∏ j ∈ S, f j)) M '' N)).toAddSubgroup

/-- Membership in `faceFiltration` is membership in `Iⁱ · C[F_p / f_S] · N`. -/
@[simp]
theorem mem_faceFiltration (hf : Ideal.span (Set.range f) = ⊤) (N : Set M) (p : ℕ)
    (S : Finset ι) (i : ℕ) (x : LocalizedModule (.powers (∏ j ∈ S, f j)) M) :
    letI := faceTopology f P hf p S
    x ∈ faceFiltration f P M hf N p S i ↔ x ∈ (facePair f P hf p S).idealOfDefinition ^ i •
      Submodule.span (facePair f P hf p S).ringOfDefinition
        (mkLinearMap (.powers (∏ j ∈ S, f j)) M '' N) :=
  Iff.rfl

/-- Level zero of the face filtration is the `C[F_p / f_S]`-span of `N`. -/
@[simp]
theorem faceFiltration_zero (hf : Ideal.span (Set.range f) = ⊤) (N : Set M) (p : ℕ)
    (S : Finset ι) :
    letI := faceTopology f P hf p S
    faceFiltration f P M hf N p S 0 = (Submodule.span (facePair f P hf p S).ringOfDefinition
      (mkLinearMap (.powers (∏ j ∈ S, f j)) M '' N)).toAddSubgroup := by
  simp [faceFiltration]

/-- The face filtration of the empty set vanishes. -/
@[simp]
theorem faceFiltration_empty (hf : Ideal.span (Set.range f) = ⊤) (p : ℕ) (S : Finset ι)
    (i : ℕ) : faceFiltration f P M hf ∅ p S i = ⊥ := by
  simp [faceFiltration]

/-- The subgroups `faceFiltration` decrease. -/
theorem faceFiltration_antitone (hf : Ideal.span (Set.range f) = ⊤) (N : Set M) (p : ℕ)
    (S : Finset ι) : Antitone (faceFiltration f P M hf N p S) := fun _ _ hij _ hx ↦
  letI := faceTopology f P hf p S
  Submodule.smul_mono_left (Ideal.pow_le_pow_right hij) hx

/-- **The face filtration is a basis of neighbourhoods of zero.** If `N` is a finite set
generating `M`, the subgroups `Iⁱ · C[F_p / f_S] · N` form a basis of neighbourhoods of zero in
`M_{f_S}` for its natural topology over `B(F_p / f_S)`. -/
theorem hasBasis_nhds_zero_faceFiltration (hf : Ideal.span (Set.range f) = ⊤) {N : Set M}
    (hN : N.Finite) (hspan : Submodule.span B N = ⊤) (p : ℕ) (S : Finset ι) :
    (@nhds _ (faceModuleTopology f P M hf p S) 0).HasBasis (fun _ : ℕ ↦ True)
      fun i ↦ (faceFiltration f P M hf N p S i : Set _) := by
  let _ := faceTopology f P hf p S
  have := isTopologicalRing_faceTopology f P hf p S
  let _ := faceModuleTopology f P M hf p S
  have := isModuleTopology_faceModuleTopology f P M hf p S
  refine (facePair f P hf p S).hasBasis_nhds_zero_idealOfDefinition_pow_smul
    (Submodule.fg_span (hN.image _)) ?_
  rw [Submodule.span_span_of_tower]
  exact span_eq_top_of_isLocalizedModule _ (.powers (∏ i ∈ S, f i)) _ hspan

/-- **Huber's filtration** `K_i^p` of the term of degree `p`: for a set `N ⊆ M`, the product over
the faces `S`, `|S| = p + 1`, of the subgroups `Iⁱ · C[F_p / f_S] · N` of `M_{f_S}`. -/
noncomputable def filtration (hf : Ideal.span (Set.range f) = ⊤) (N : Set M) (p i : ℕ) :
    AddSubgroup (cechLocalizationTerm M f p) :=
  AddSubgroup.pi Set.univ fun S ↦ faceFiltration f P M hf N p S.1 i

/-- An element lies in the filtration exactly when each of its components lies in the face
filtration. -/
@[simp]
theorem mem_filtration (hf : Ideal.span (Set.range f) = ⊤) (N : Set M) (p i : ℕ)
    (x : cechLocalizationTerm M f p) :
    x ∈ filtration f P M hf N p i ↔ ∀ S, x S ∈ faceFiltration f P M hf N p S.1 i := by
  simp only [filtration, AddSubgroup.mem_pi, Set.mem_univ, forall_const]

/-- The filtration of the empty set vanishes. -/
@[simp]
theorem filtration_empty (hf : Ideal.span (Set.range f) = ⊤) (p i : ℕ) :
    filtration f P M hf ∅ p i = ⊥ := by
  ext x
  simp [funext_iff]

/-- The filtration is decreasing. -/
theorem filtration_antitone (hf : Ideal.span (Set.range f) = ⊤) (N : Set M) (p : ℕ) :
    Antitone (filtration f P M hf N p) := fun _ _ hij _ hx ↦
  (mem_filtration f P M hf N p _ _).mpr fun S ↦
    faceFiltration_antitone f P M hf N p S.1 hij ((mem_filtration f P M hf N p _ _).mp hx S)

/-- **The filtration is a basis of neighbourhoods of zero**: the case of nonnegative degree of
Huber94 §2, (1.3.1)(ii), with the subgroups `K_i^p` read off the charts of (1.2)(ii). If `ι` is
finite and `N` is a finite set generating `M`, the subgroups `K_i^p` form a basis of
neighbourhoods of zero for `termTopology`. -/
theorem hasBasis_nhds_zero_filtration [Finite ι] (hf : Ideal.span (Set.range f) = ⊤)
    {N : Set M} (hN : N.Finite) (hspan : Submodule.span B N = ⊤) (p : ℕ) :
    (@nhds _ (termTopology f P M hf p) 0).HasBasis (fun _ : ℕ ↦ True)
      fun i ↦ (filtration f P M hf N p i : Set (cechLocalizationTerm M f p)) := by
  have hfactor : ∀ S : {S : Finset ι // S.card = p + 1},
      (@nhds _ (faceModuleTopology f P M hf p S.1)
        ((0 : cechLocalizationTerm M f p) S)).HasBasis (fun _ : ℕ ↦ True)
        fun i ↦ (faceFiltration f P M hf N p S.1 i : Set _) :=
    fun S ↦ hasBasis_nhds_zero_faceFiltration f P M hf hN hspan p S.1
  have hpi := Filter.hasBasis_pi_same_index hfactor fun I k hI _ ↦
    ⟨hI.toFinset.sup k, trivial, fun S hS ↦ faceFiltration_antitone f P M hf N p S.1
      (Finset.le_sup (hI.mem_toFinset.mpr hS))⟩
  rw [termTopology_eq_pi, @nhds_pi _
    (fun S : {S : Finset ι // S.card = p + 1} ↦ LocalizedModule (.powers (∏ i ∈ S.1, f i)) M)
    fun S ↦ faceModuleTopology f P M hf p S.1]
  refine hpi.to_hasBasis
    (fun Ik _ ↦ ⟨Ik.2, trivial, fun x hx S _ ↦ (mem_filtration f P M hf N p _ _).mp hx S⟩)
    fun i _ ↦ ⟨(Set.univ, i), ⟨Set.finite_univ, trivial⟩, fun x hx ↦
      (mem_filtration f P M hf N p _ _).mpr fun S ↦ hx S trivial⟩

/-- **The filtration is a basis of entourages**: if `ι` is finite and `N` is a finite set
generating `M`, the sets `{(x, y) | y - x ∈ K_i^p}` form a basis of the uniformity
`termUniformSpace`. -/
theorem hasBasis_uniformity_filtration [Finite ι] (hf : Ideal.span (Set.range f) = ⊤)
    {N : Set M} (hN : N.Finite) (hspan : Submodule.span B N = ⊤) (p : ℕ) :
    (@uniformity _ (termUniformSpace f P M hf p)).HasBasis (fun _ : ℕ ↦ True)
      fun i ↦ {xy | xy.2 - xy.1 ∈ filtration f P M hf N p i} :=
  @Filter.HasBasis.uniformity_of_nhds_zero _ (termUniformSpace f P M hf p) _
    (isUniformAddGroup_termUniformSpace f P M hf p) _ _ _
    (hasBasis_nhds_zero_filtration f P M hf hN hspan p)

end TauCeti.Huber.NoetherianCech
