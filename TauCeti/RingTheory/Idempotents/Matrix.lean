module

public import Mathlib.Data.Matrix.Basis
public import Mathlib.LinearAlgebra.Matrix.Action
public import Mathlib.RingTheory.TwoSidedIdeal.Operations
public import TauCeti.RingTheory.Idempotents.Corner.Basic

/-!
# The corner of a diagonal matrix unit

For a ring `α` and an index `i`, the diagonal matrix unit `Eᵢᵢ = Matrix.single i i 1` is an
idempotent of `Matrix n n α`. Its corner `Eᵢᵢ · Matrix n n α · Eᵢᵢ` consists of the matrices
supported on the entry `(i, i)`, so it is a copy of `α`; and `Eᵢᵢ` is **full**, generating the
whole matrix ring as a two-sided ideal, because `1 = ∑ⱼ Eⱼᵢ Eᵢᵢ Eᵢⱼ`.

Together these say that `α` is a full idempotent corner of `Matrix n n α`, the standard instance of
Morita equivalence. In a product of matrix rings over division rings, one such unit per factor
selects a full idempotent whose corner is a product of division rings.

The right ideal `Eᵢᵢ · Matrix n n α` generated by `Eᵢᵢ` consists of the matrices supported on
row `i`, so it is a copy of the row module `n → α`, on which matrices act by `Matrix.vecMul`.

## Main definitions

* `Matrix.cornerSingleOneEquiv`: the corner of `Eᵢᵢ` is isomorphic to the coefficient ring.
* `Matrix.cornerSingleOneAlgEquiv`: the same isomorphism, of algebras over a commutative ring.
* `TauCeti.Matrix.rowLinearMap`: the embedding of the row module into the regular right module as
  the matrices supported on row `i`.
* `TauCeti.Matrix.rowLinearEquivSpanSingle`: the row module is isomorphic to the right ideal
  generated by `Eᵢᵢ`.

## Main results

* `Matrix.isIdempotentElem_single_one`: the diagonal matrix unit `Eᵢᵢ` is idempotent.
* `Matrix.orthogonalIdempotents_map_single`: the images of the diagonal matrix units under a
  homomorphism out of `Mₙ(α)` are orthogonal idempotents.
* `Matrix.completeOrthogonalIdempotents_single_one`: the diagonal matrix units form a complete
  family of orthogonal idempotents.
* `Matrix.single_apply_eq_of_mem_corner`: a matrix in the corner of `Eᵢᵢ` is supported on the
  entry `(i, i)`.
* `Matrix.twoSidedIdeal_span_single_one_eq_top`: the diagonal matrix unit `Eᵢᵢ` is full.
* `TauCeti.Matrix.range_rowLinearMap`: the matrices supported on row `i` form the right ideal
  generated by `Eᵢᵢ`.
-/

public section

namespace Matrix

variable {n α : Type*} [Fintype n] [DecidableEq n]

/-- The diagonal matrix unit `Eᵢᵢ` is idempotent. -/
@[simp]
theorem isIdempotentElem_single_one [NonAssocSemiring α] (i : n) :
    IsIdempotentElem (single i i (1 : α)) := by
  simp [IsIdempotentElem]

section Map

variable {B F : Type*} [NonAssocSemiring α] [FunLike F (Matrix n n α) B]

/-- The images of the diagonal matrix units are orthogonal idempotents. -/
theorem orthogonalIdempotents_map_single [Semiring B] [NonUnitalRingHomClass F (Matrix n n α) B]
    (f : F) : OrthogonalIdempotents fun i : n => f (single i i 1) :=
  ⟨fun i => (isIdempotentElem_single_one i).map f, fun i j hij => by simp [← map_mul, hij]⟩

end Map

section Semiring

variable [Semiring α]

/-- A matrix in the corner of `Eᵢᵢ` is supported on the entry `(i, i)`. -/
theorem single_apply_eq_of_mem_corner {i : n} {x : Matrix n n α}
    (hx : x ∈ Subsemigroup.corner (single i i (1 : α))) : single i i (x i i) = x := by
  obtain ⟨hl, hr⟩ := (Subsemigroup.mem_corner_iff (isIdempotentElem_single_one i)).mp hx
  calc single i i (x i i) = single i i (1 : α) * x * single i i 1 := by
        rw [single_mul_mul_single, one_mul, mul_one]
    _ = x := by rw [hl, hr]

/-- **The corner of the diagonal matrix unit `Eᵢᵢ` is the coefficient ring**, through the
`(i, i)` entry. -/
def cornerSingleOneEquiv (i : n) : (isIdempotentElem_single_one (α := α) i).Corner ≃+* α where
  toFun x := x.val i i
  invFun a := ⟨single i i a, (Subsemigroup.mem_corner_iff (isIdempotentElem_single_one i)).mpr
    ⟨by simp, by simp⟩⟩
  left_inv x := Subtype.ext (single_apply_eq_of_mem_corner x.property)
  right_inv a := by simp
  map_mul' x y := by
    rw [IsIdempotentElem.Corner.val_mul]
    conv_lhs => rw [← single_apply_eq_of_mem_corner x.property, ← single_apply_eq_of_mem_corner
        y.property]
    simp
  map_add' _ _ := rfl

@[simp]
theorem cornerSingleOneEquiv_apply (i : n) (x : (isIdempotentElem_single_one (α := α) i).Corner) :
    cornerSingleOneEquiv i x = x.val i i :=
  (rfl)

@[simp]
theorem val_cornerSingleOneEquiv_symm_apply (i : n) (a : α) :
    ((cornerSingleOneEquiv i).symm a).val = single i i a :=
  (rfl)

/-- **The diagonal matrix units `Eᵢᵢ` form a complete family of orthogonal idempotents.** -/
theorem completeOrthogonalIdempotents_single_one :
    CompleteOrthogonalIdempotents fun i : n ↦ single i i (1 : α) where
  idem := isIdempotentElem_single_one
  ortho i j h := single_mul_single_of_ne (1 : α) i i j h 1
  complete := sum_single_one

/-- The corner of the diagonal matrix unit `Eᵢᵢ` is the coefficient algebra, through the `(i, i)`
entry: `Matrix.cornerSingleOneEquiv` as an isomorphism of `R`-algebras. -/
def cornerSingleOneAlgEquiv (R : Type*) [CommSemiring R] [Algebra R α] (i : n) :
    (isIdempotentElem_single_one (α := α) i).Corner ≃ₐ[R] α :=
  AlgEquiv.ofRingEquiv (f := cornerSingleOneEquiv i) fun r ↦ by
    rw [cornerSingleOneEquiv_apply, IsIdempotentElem.Corner.val_algebraMap, Matrix.smul_apply,
      single_apply_same, Algebra.smul_def, mul_one]

@[simp]
theorem cornerSingleOneAlgEquiv_apply (R : Type*) [CommSemiring R] [Algebra R α] (i : n)
    (x : (isIdempotentElem_single_one (α := α) i).Corner) :
    cornerSingleOneAlgEquiv R i x = x.val i i :=
  (rfl)

@[simp]
theorem val_cornerSingleOneAlgEquiv_symm_apply (R : Type*) [CommSemiring R] [Algebra R α]
    (i : n) (a : α) : ((cornerSingleOneAlgEquiv R i).symm a).val = single i i a :=
  (rfl)

end Semiring

/-- **The diagonal matrix unit `Eᵢᵢ` is full**: it generates `Matrix n n α` as a two-sided ideal,
since `1 = ∑ⱼ Eⱼᵢ Eᵢᵢ Eᵢⱼ`. -/
theorem twoSidedIdeal_span_single_one_eq_top [NonAssocRing α] (i : n) :
    TwoSidedIdeal.span {single i i (1 : α)} = ⊤ := by
  refine (TwoSidedIdeal.one_mem_iff _).mp ?_
  rw [← sum_single_one]
  refine sum_mem fun j _ ↦ ?_
  have h : single j i (1 : α) * single i i 1 * single i j 1 = single j j 1 := by simp
  rw [← h]
  exact TwoSidedIdeal.mul_mem_right _ _ _
    (TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span rfl))

end Matrix

namespace TauCeti

/-! ### The right ideal generated by a diagonal matrix unit -/

section RowIdeal

variable {ι D : Type*} [Fintype ι] [DecidableEq ι] [Semiring D]

variable (D) in
/-- The embedding of the row module `ι → D` into the regular right module `Matᵢ(D)ᵐᵒᵖ` as the
matrices supported on row `i`: a row `v` goes to the matrix whose `i`-th row is `v` and whose other
rows vanish. Its range is the corner right ideal generated by `single i i 1`
(`TauCeti.Matrix.range_rowLinearMap`). -/
def Matrix.rowLinearMap (i : ι) : (ι → D) →ₗ[(Matrix ι ι D)ᵐᵒᵖ] (Matrix ι ι D)ᵐᵒᵖ where
  toFun v := MulOpposite.op (Matrix.vecMulVec (Pi.single i 1) v)
  map_add' v w := by simp [Matrix.vecMulVec_add]
  map_smul' B v := by simp [← Matrix.vecMulVec_mul]

@[simp]
theorem Matrix.rowLinearMap_apply (i : ι) (v : ι → D) :
    Matrix.rowLinearMap D i v = MulOpposite.op (Matrix.vecMulVec (Pi.single i 1) v) := by
  simp only [Matrix.rowLinearMap]
  rfl

/-- Row `i` of `TauCeti.Matrix.rowLinearMap D i v` is `v`. -/
theorem Matrix.unop_rowLinearMap_apply_self (i : ι) (v : ι → D) :
    (Matrix.rowLinearMap D i v).unop i = v :=
  funext fun j ↦ by simp [Matrix.vecMulVec_apply]

/-- Left multiplication by the matrix unit `single i i 1`, written in the regular right module,
keeps row `i` and kills the others. -/
theorem Matrix.mul_op_single_eq_rowLinearMap (i : ι) (a : (Matrix ι ι D)ᵐᵒᵖ) :
    a * MulOpposite.op (Matrix.single i i 1) = Matrix.rowLinearMap D i (a.unop i) :=
  MulOpposite.unop_injective <| by
    simp [Matrix.single_eq_single_vecMulVec_single, Matrix.vecMulVec_mul, Matrix.row_apply']

variable (D) in
/-- The matrices supported on row `i` form the principal right ideal generated by
`single i i 1`. -/
theorem Matrix.range_rowLinearMap (i : ι) :
    LinearMap.range (Matrix.rowLinearMap D i) =
      Submodule.span (Matrix ι ι D)ᵐᵒᵖ {MulOpposite.op (Matrix.single i i (1 : D))} := by
  ext x
  rw [LinearMap.mem_range, Submodule.mem_span_singleton]
  refine ⟨fun ⟨v, hv⟩ ↦ ⟨Matrix.rowLinearMap D i v, ?_⟩, fun ⟨a, ha⟩ ↦ ⟨a.unop i, ?_⟩⟩
  · rw [← hv, smul_eq_mul, Matrix.mul_op_single_eq_rowLinearMap,
      Matrix.unop_rowLinearMap_apply_self]
  · rw [← ha, smul_eq_mul, Matrix.mul_op_single_eq_rowLinearMap]

variable (D) in
/-- **The row module is the corner right ideal.** Sending a row `v` to the matrix whose `i`-th row
is `v` and whose other rows vanish identifies the row module `ι → D` with the right ideal
`e_{ii} Matᵢ(D)` generated by the matrix unit `e_{ii} = single i i 1`. -/
def Matrix.rowLinearEquivSpanSingle (i : ι) :
    (ι → D) ≃ₗ[(Matrix ι ι D)ᵐᵒᵖ]
      Submodule.span (Matrix ι ι D)ᵐᵒᵖ {MulOpposite.op (Matrix.single i i (1 : D))} :=
  -- Mathlib's `LinearEquiv.ofLeftInverse_apply` lemmas need a linear left inverse, so the
  -- simp lemmas below unfold `LinearEquiv.ofLeftInverse` itself.
  (LinearEquiv.ofLeftInverse (f := Matrix.rowLinearMap D i) (g := fun M ↦ M.unop i)
    (Matrix.unop_rowLinearMap_apply_self i)).trans
    (LinearEquiv.ofEq _ _ (Matrix.range_rowLinearMap D i))

/-- `TauCeti.Matrix.rowLinearEquivSpanSingle` sends a row `v` to the matrix whose `i`-th row is `v`
and whose other rows vanish. -/
@[simp]
theorem Matrix.coe_rowLinearEquivSpanSingle_apply (i : ι) (v : ι → D) :
    (Matrix.rowLinearEquivSpanSingle D i v : (Matrix ι ι D)ᵐᵒᵖ) =
      MulOpposite.op (Matrix.vecMulVec (Pi.single i 1) v) := by
  simp [Matrix.rowLinearEquivSpanSingle, LinearEquiv.ofLeftInverse]

/-- The inverse of `TauCeti.Matrix.rowLinearEquivSpanSingle` reads off row `i`. -/
@[simp]
theorem Matrix.rowLinearEquivSpanSingle_symm_apply (i : ι)
    (x : Submodule.span (Matrix ι ι D)ᵐᵒᵖ {MulOpposite.op (Matrix.single i i (1 : D))}) :
    (Matrix.rowLinearEquivSpanSingle D i).symm x = (x : (Matrix ι ι D)ᵐᵒᵖ).unop i := by
  simp [Matrix.rowLinearEquivSpanSingle, LinearEquiv.ofLeftInverse]

end RowIdeal

end TauCeti
