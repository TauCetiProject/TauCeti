module

public import Mathlib.RingTheory.TensorProduct.Basic
public import TauCeti.RingTheory.Idempotents.Primitive.Basic

/-!
# Tensor products of idempotent left ideals

For idempotents `e` and `f` in ground-ring algebras `A` and `B`,
`Ae ⊗ Bf` is the left ideal generated by `e ⊗ f` in `A ⊗ B`.
The identification uses the split projections onto the two ideals and
`TensorProduct.map`; it needs no flatness assumption.

This relates the cyclic enveloping-algebra presentation of the zigzag vertex
bimodule to its two outer factors. It lets the full balanced self-tensor
calculation reuse `BalancedTensorProduct.outerFactors` and the middle corner
identification before constructing inverse braid homotopy equivalences.

See Assem--Simson--Skowroński, *Elements of the Representation Theory of
Associative Algebras, Vol. 1*, Section I.4, for the idempotent-ideal description
of projective modules.
-/

public section

noncomputable section

namespace TauCeti

open scoped TensorProduct

variable (k : Type*) [CommSemiring k] {A B : Type*} [Semiring A] [Semiring B]
  [Algebra k A] [Algebra k B] {e : A} {f : B}

private def idealProjection (e : A) : A →ₗ[k] (Ideal.span {e} : Ideal A) :=
  (LinearMap.toSpanSingleton A _ (spanSingletonGenerator e)).restrictScalars k

private theorem coe_idealProjection (e : A) (a : A) :
    (idealProjection k e a : A) = a * e := by
  simp only [idealProjection, LinearMap.restrictScalars_apply,
    LinearMap.toSpanSingleton_apply, SetLike.val_smul, smul_eq_mul,
    coe_spanSingletonGenerator]

variable {k A B : Type*} [CommSemiring k]
  [NonUnitalNonAssocSemiring A] [NonUnitalNonAssocSemiring B]
  [Module k A] [SMulCommClass k A A] [IsScalarTower k A A]
  [Module k B] [SMulCommClass k B B] [IsScalarTower k B B] {e : A} {f : B} in
/-- A pure tensor of idempotents is idempotent in the tensor product. -/
theorem _root_.IsIdempotentElem.tmul (he : IsIdempotentElem e) (hf : IsIdempotentElem f) :
    IsIdempotentElem (e ⊗ₜ[k] f) := by
  rw [IsIdempotentElem, Algebra.TensorProduct.tmul_mul_tmul, he.eq, hf.eq]

private def idealTensorInclude :
    (Ideal.span {e} : Ideal A) ⊗[k] (Ideal.span {f} : Ideal B) →ₗ[k] A ⊗[k] B :=
  TensorProduct.map ((Ideal.span {e} : Ideal A).subtype.restrictScalars k)
    ((Ideal.span {f} : Ideal B).subtype.restrictScalars k)

private def idealTensorToSpan (he : IsIdempotentElem e) (hf : IsIdempotentElem f) :
    (Ideal.span {e} : Ideal A) ⊗[k] (Ideal.span {f} : Ideal B) →ₗ[k]
      (Ideal.span {e ⊗ₜ[k] f} : Ideal (A ⊗[k] B)) :=
  (idealTensorInclude k).codRestrict
    ((Ideal.span {e ⊗ₜ[k] f} : Ideal (A ⊗[k] B)).restrictScalars k) fun t ↦ by
    apply (mem_span_singleton_iff_mul_eq_self (he.tmul (k := k) hf)).mpr
    induction t using TensorProduct.inductionOn with
    | tmul x y =>
      simp only [idealTensorInclude, TensorProduct.map_tmul, LinearMap.restrictScalars_apply,
        Submodule.subtype_apply, Algebra.TensorProduct.tmul_mul_tmul,
        (mem_span_singleton_iff_mul_eq_self he).mp x.2,
        (mem_span_singleton_iff_mul_eq_self hf).mp y.2]
    | add t t' ht ht' => simp only [map_add, add_mul, ht, ht']

@[simp]
private theorem coe_idealTensorToSpan (he : IsIdempotentElem e) (hf : IsIdempotentElem f)
    (t : (Ideal.span {e} : Ideal A) ⊗[k] (Ideal.span {f} : Ideal B)) :
    (idealTensorToSpan k he hf t : A ⊗[k] B) = idealTensorInclude k t :=
  LinearMap.codRestrict_apply _ _ t

private def spanToIdealTensor :
    (Ideal.span {e ⊗ₜ[k] f} : Ideal (A ⊗[k] B)) →ₗ[k]
      (Ideal.span {e} : Ideal A) ⊗[k] (Ideal.span {f} : Ideal B) :=
  TensorProduct.map (idealProjection k e) (idealProjection k f) ∘ₗ
    (Ideal.span {e ⊗ₜ[k] f} : Ideal (A ⊗[k] B)).subtype.restrictScalars k

@[simp]
private theorem spanToIdealTensor_apply
    (x : (Ideal.span {e ⊗ₜ[k] f} : Ideal (A ⊗[k] B))) :
    spanToIdealTensor k x = TensorProduct.map (idealProjection k e) (idealProjection k f)
      (x : A ⊗[k] B) := rfl

private theorem idealTensorInclude_projection :
    idealTensorInclude k ∘ₗ TensorProduct.map (idealProjection k e) (idealProjection k f) =
      LinearMap.mulRight k (e ⊗ₜ[k] f) := by
  apply TensorProduct.ext'
  intro a b
  simp only [LinearMap.comp_apply, idealTensorInclude, TensorProduct.map_tmul,
    LinearMap.restrictScalars_apply, Submodule.subtype_apply, coe_idealProjection,
    LinearMap.mulRight_apply, Algebra.TensorProduct.tmul_mul_tmul]

/-- The tensor of two idempotent left ideals is the ideal generated by their pure tensor.
The equivalence is ground-linear, and its forward map is the tensor of the inclusions. -/
def spanSingletonTensorProductEquiv (he : IsIdempotentElem e) (hf : IsIdempotentElem f) :
    (Ideal.span {e} : Ideal A) ⊗[k] (Ideal.span {f} : Ideal B) ≃ₗ[k]
      (Ideal.span {e ⊗ₜ[k] f} : Ideal (A ⊗[k] B)) :=
  LinearEquiv.ofLinearMap (idealTensorToSpan k he hf) (spanToIdealTensor k)
    (by
      apply LinearMap.ext
      intro x
      apply Subtype.ext
      simpa only [LinearMap.comp_apply, coe_idealTensorToSpan, spanToIdealTensor_apply,
        LinearMap.id_apply] using
          (LinearMap.congr_fun (idealTensorInclude_projection k) (x : A ⊗[k] B)).trans
            ((mem_span_singleton_iff_mul_eq_self (he.tmul (k := k) hf)).mp x.2))
    (by
      apply TensorProduct.ext'
      intro x y
      rw [LinearMap.comp_apply, spanToIdealTensor_apply, coe_idealTensorToSpan]
      simp only [idealTensorInclude, TensorProduct.map_tmul,
        LinearMap.restrictScalars_apply, Submodule.subtype_apply,
        LinearMap.id_apply, idealProjection, LinearMap.toSpanSingleton_apply,
        smul_spanSingletonGenerator he x, smul_spanSingletonGenerator hf y])

/-- The forward map is the tensor product of the two ideal inclusions. -/
@[simp]
theorem coe_spanSingletonTensorProductEquiv_apply
    (he : IsIdempotentElem e) (hf : IsIdempotentElem f)
    (t : (Ideal.span {e} : Ideal A) ⊗[k] (Ideal.span {f} : Ideal B)) :
    (spanSingletonTensorProductEquiv k he hf t : A ⊗[k] B) =
      TensorProduct.map ((Ideal.span {e} : Ideal A).subtype.restrictScalars k)
        ((Ideal.span {f} : Ideal B).subtype.restrictScalars k) t := by
  simp only [spanSingletonTensorProductEquiv, LinearEquiv.coe_ofLinearMap,
    coe_idealTensorToSpan, idealTensorInclude]

/-- The inverse sends a scaled tensor generator to the tensor of the scaled generators. -/
@[simp]
theorem spanSingletonTensorProductEquiv_symm_tmul_smul_generator
    (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (a : A) (b : B) :
    (spanSingletonTensorProductEquiv k he hf).symm
      ((a ⊗ₜ[k] b) • spanSingletonGenerator (e ⊗ₜ[k] f)) =
        (a • spanSingletonGenerator e) ⊗ₜ[k] (b • spanSingletonGenerator f) := by
  apply (spanSingletonTensorProductEquiv k he hf).injective
  apply Subtype.ext
  rw [LinearEquiv.apply_symm_apply]
  simp only [coe_spanSingletonTensorProductEquiv_apply, TensorProduct.map_tmul,
    LinearMap.restrictScalars_apply, Submodule.subtype_apply, SetLike.val_smul,
    smul_eq_mul, coe_spanSingletonGenerator, Algebra.TensorProduct.tmul_mul_tmul]

/-- The identification carries the two factor actions to the tensor-algebra action. -/
@[simp]
theorem spanSingletonTensorProductEquiv_map_smul
    (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (a : A) (b : B)
    (t : (Ideal.span {e} : Ideal A) ⊗[k] (Ideal.span {f} : Ideal B)) :
    spanSingletonTensorProductEquiv k he hf
        (TensorProduct.map ((Algebra.lsmul k k (Ideal.span {e} : Ideal A)) a)
          ((Algebra.lsmul k k (Ideal.span {f} : Ideal B)) b) t) =
      (a ⊗ₜ[k] b) • spanSingletonTensorProductEquiv k he hf t := by
  apply Subtype.ext
  induction t using TensorProduct.inductionOn with
  | tmul x y =>
    simp only [TensorProduct.map_tmul, Algebra.lsmul_apply,
      coe_spanSingletonTensorProductEquiv_apply, LinearMap.restrictScalars_apply,
      Submodule.subtype_apply, SetLike.val_smul,
      smul_eq_mul, Algebra.TensorProduct.tmul_mul_tmul]
  | add t t' ht ht' =>
    simp only [map_add, smul_add, Submodule.coe_add, ht, ht']

end TauCeti
