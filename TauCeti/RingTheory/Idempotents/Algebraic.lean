/-!
# Idempotents generated by algebraic elements

An algebraic element `c` of an algebra over a field that is not nilpotent has a nonzero idempotent
multiple `p(c) c`, for a polynomial `p`. Writing a nonzero annihilating polynomial of `c` as
`Xⁿ q` with `q(0) ≠ 0`, the idempotent is `(u Xⁿ⁺¹)(c)` for a Bézout relation
`u Xⁿ⁺¹ + v q = 1`; it is the polynomial idempotent which is `0` modulo `Xⁿ⁺¹` and `1` modulo `q`.
Such an idempotent lies in every left ideal containing `c`.

A left ideal consisting of nilpotent elements lies in the Jacobson radical. Hence a left ideal of
algebraic elements which is not contained in the Jacobson radical contains a nonzero idempotent.
Every element of a finite-dimensional left ideal is algebraic, so a finite-dimensional left ideal
lies in the Jacobson radical exactly when its only idempotent is `0`. In particular, every nonzero
finite-dimensional left ideal of an algebra with zero Jacobson radical contains a nonzero
idempotent.

These are the idempotents of the structure theory of separating ideals of Banach algebras: a
nonzero finite-dimensional separating ideal of a semisimple Banach algebra contains a nonzero
idempotent. Ideals are given as scalar submodules closed under left multiplication, so that no
unit or two-sided structure is needed to state the hypotheses.

## Main results

* `IsAlgebraic.exists_isIdempotentElem_aeval_mul_ne_zero`: a non-nilpotent algebraic element `c`
  has a nonzero idempotent multiple `p(c) c`.
* `Submodule.isAlgebraic_of_mem`: elements of finite-dimensional left ideals are algebraic.
* `Submodule.exists_mem_isIdempotentElem_ne_zero_of_isAlgebraic`: a left ideal of algebraic
  elements outside the Jacobson radical contains a nonzero idempotent.
* `Submodule.le_jacobson_iff_forall_isIdempotentElem_eq_zero`: a finite-dimensional left ideal
  lies in the Jacobson radical exactly when it contains no nonzero idempotent.
* `Submodule.exists_mem_isIdempotentElem_ne_zero_of_jacobson_eq_bot`: a nonzero
  finite-dimensional left ideal of an algebra with zero Jacobson radical contains a nonzero
  idempotent.

## References

* H. G. Dales, *Banach Algebras and Automatic Continuity*, §5.2: the structure of separating
  ideals.
* T. Y. Lam, *A First Course in Noncommutative Rings*, §4: nil one-sided ideals lie in the
  Jacobson radical.
-/

public section

open Polynomial

namespace IsAlgebraic

variable {k B : Type*} [Field k] [Ring B] [Algebra k B]

/-- A non-nilpotent algebraic element `c` of an algebra over a field has a nonzero idempotent
multiple `p(c) c`, for some polynomial `p`. Being a left multiple of `c`, this idempotent lies in
every left ideal containing `c`. -/
theorem exists_isIdempotentElem_aeval_mul_ne_zero {c : B} (hc : IsAlgebraic k c)
    (hnil : ¬IsNilpotent c) :
    ∃ p : k[X], IsIdempotentElem (aeval c p * c) ∧ aeval c p * c ≠ 0 := by
  obtain ⟨f, hf, hfc⟩ := hc
  -- Split the annihilating polynomial as `f = Xⁿ q` with `X ∤ q`.
  obtain ⟨q, hfq, hq⟩ := exists_eq_pow_rootMultiplicity_mul_and_not_dvd f hf 0
  set n := f.rootMultiplicity 0
  rw [C_0, sub_zero] at hfq hq
  -- The Bézout relation `u Xⁿ⁺¹ + v q = 1`.
  obtain ⟨u, v, huv⟩ := (irreducible_X.coprime_iff_not_dvd.2 hq).pow_left (m := n + 1)
  have he : aeval c (u * X ^ n) * c = aeval c (u * X ^ (n + 1)) := by
    rw [pow_succ, ← mul_assoc, map_mul (aeval c) (u * X ^ n) X, aeval_X]
  have hvq : aeval c (v * q) = 1 - aeval c (u * X ^ (n + 1)) := by
    rw [eq_sub_iff_add_eq', ← map_add, huv, map_one]
  -- `f` divides `u Xⁿ⁺¹ · v q`, so `e = (u Xⁿ⁺¹)(c)` satisfies `e (1 - e) = 0`.
  have hprod : aeval c (u * X ^ (n + 1)) * aeval c (v * q) = 0 := by
    rw [← map_mul, show u * X ^ (n + 1) * (v * q) = u * v * X * f by rw [hfq]; ring, map_mul,
      hfc, mul_zero]
  refine ⟨u * X ^ n, ?_, ?_⟩
  · rw [hvq, mul_sub, mul_one, sub_eq_zero] at hprod
    rw [he]
    exact hprod.symm
  · -- If `e = 0`, then `(v q)(c) = 1`, so `cⁿ = (Xⁿ v q)(c) = (v f)(c) = 0`.
    rw [he]
    intro h0
    rw [h0, sub_zero] at hvq
    have hpow : aeval c (X ^ n * (v * q)) = 0 := by
      rw [show X ^ n * (v * q) = v * f by rw [hfq]; ring, map_mul, hfc, mul_zero]
    rw [map_mul, hvq, mul_one, map_pow, aeval_X] at hpow
    exact hnil ⟨n, hpow⟩

end IsAlgebraic

namespace Submodule

variable {k B : Type*} [Field k] [Ring B] [Algebra k B]

/-- Every element of a finite-dimensional left ideal of an algebra over a field is algebraic.
The left ideal is a scalar submodule `J` closed under left multiplication. -/
theorem isAlgebraic_of_mem (J : Submodule k B) [FiniteDimensional k J]
    (hJ : ∀ (b : B) {y : B}, y ∈ J → b * y ∈ J) {c : B} (hc : c ∈ J) : IsAlgebraic k c := by
  -- `p ↦ p(c) c` maps the infinite-dimensional space `k[X]` into `J`, so it is not injective.
  obtain ⟨φ, hφ⟩ : ∃ φ : k[X] →ₗ[k] J, ∀ p, (φ p : B) = aeval c p * c :=
    ⟨LinearMap.codRestrict J ((LinearMap.mulRight k c).comp (aeval c).toLinearMap)
      (fun p ↦ hJ _ hc), fun p ↦ LinearMap.codRestrict_apply _ _ p⟩
  obtain ⟨p, hp, hpc⟩ : ∃ p, p ≠ 0 ∧ φ p = 0 := by
    by_contra! h
    exact Polynomial.not_finite (R := k) <| Module.Finite.of_injective φ <|
      (injective_iff_map_eq_zero φ).2 fun p hp ↦ by_contra fun hp0 ↦ h p hp0 hp
  refine ⟨p * X, mul_ne_zero hp X_ne_zero, ?_⟩
  rw [map_mul, aeval_X, ← hφ, hpc, ZeroMemClass.coe_zero]

/-- **Idempotents in left ideals outside the radical.** A left ideal of an algebra over a field
whose elements are algebraic, and which is not contained in the Jacobson radical, contains a
nonzero idempotent. The left ideal is a scalar submodule `J` closed under left multiplication. -/
theorem exists_mem_isIdempotentElem_ne_zero_of_isAlgebraic (J : Submodule k B)
    (hJ : ∀ (b : B) {y : B}, y ∈ J → b * y ∈ J) (halg : ∀ y ∈ J, IsAlgebraic k y)
    (hrad : ¬J ≤ (Ring.jacobson B).restrictScalars k) :
    ∃ e ∈ J, IsIdempotentElem e ∧ e ≠ 0 := by
  -- A left ideal of nilpotent elements lies in the radical, so `J` has a non-nilpotent element.
  obtain ⟨c, hcJ, hc⟩ : ∃ c ∈ J, ¬IsNilpotent c := by
    by_contra! h
    refine hrad fun c hc ↦ (restrictScalars_mem k _ c).2 ?_
    exact TauCeti.Ring.mem_jacobson_iff_isUnit_one_add_mul_left.2 fun y ↦
      IsNilpotent.isUnit_one_add (h _ (hJ y hc))
  obtain ⟨p, hp, hp0⟩ := (halg c hcJ).exists_isIdempotentElem_aeval_mul_ne_zero hc
  exact ⟨_, hJ _ hcJ, hp, hp0⟩

/-- A finite-dimensional left ideal of an algebra over a field lies in the Jacobson radical
exactly when its only idempotent is `0`. The left ideal is a scalar submodule `J` closed under
left multiplication. -/
theorem le_jacobson_iff_forall_isIdempotentElem_eq_zero (J : Submodule k B)
    [FiniteDimensional k J] (hJ : ∀ (b : B) {y : B}, y ∈ J → b * y ∈ J) :
    J ≤ (Ring.jacobson B).restrictScalars k ↔ ∀ e ∈ J, IsIdempotentElem e → e = 0 := by
  refine ⟨fun h e he hidem ↦ hidem.eq_zero_of_mem_jacobson_bot ?_, fun h ↦ ?_⟩
  · rw [Ideal.jacobson_bot]
    exact (restrictScalars_mem k _ e).1 (h he)
  · by_contra hrad
    obtain ⟨e, he, hidem, he0⟩ := J.exists_mem_isIdempotentElem_ne_zero_of_isAlgebraic hJ
      (fun _ ↦ J.isAlgebraic_of_mem hJ) hrad
    exact he0 (h e he hidem)

/-- A nonzero finite-dimensional left ideal of an algebra over a field with zero Jacobson radical
contains a nonzero idempotent. The left ideal is a scalar submodule `J` closed under left
multiplication. -/
theorem exists_mem_isIdempotentElem_ne_zero_of_jacobson_eq_bot (J : Submodule k B)
    [FiniteDimensional k J] (hJ : ∀ (b : B) {y : B}, y ∈ J → b * y ∈ J)
    (hB : Ring.jacobson B = ⊥) (hJ0 : J ≠ ⊥) : ∃ e ∈ J, IsIdempotentElem e ∧ e ≠ 0 := by
  refine J.exists_mem_isIdempotentElem_ne_zero_of_isAlgebraic hJ
    (fun _ ↦ J.isAlgebraic_of_mem hJ) fun h ↦ hJ0 <| eq_bot_iff.2 fun x hx ↦ ?_
  simpa [hB] using h hx

end Submodule
