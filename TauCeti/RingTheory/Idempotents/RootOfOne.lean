module

public import Mathlib.Algebra.BigOperators.Group.Finset.Defs
public import Mathlib.Algebra.Group.Invertible.Defs
public import Mathlib.Algebra.Module.Defs
public import Mathlib.Algebra.Ring.Idempotent

import Mathlib.Algebra.Group.Action.Basic
import Mathlib.Algebra.Module.NatInt
import Mathlib.Algebra.Ring.GeomSum

/-!
# The averaging idempotent of a root of one

Let `A` be a semiring that is a module over a semiring `R` in which the natural number `n` is
invertible, and let `υ : A` satisfy `υ ^ n = 1`. Then `(1 + υ + ⋯ + υ ^ (n - 1)) / n` is
idempotent: it is the averaging idempotent of the cyclic group generated by `υ`. For `n = 3` this is
the idempotent `(1 + υ + υ²) / 3` of a cube root of one; for `n = 2` it is the idempotent
`(1 + υ) / 2` of a square root of one, which over a commutative ring is `TauCeti.halfOneAdd`.

No compatibility between the `R`-action and the multiplication of `A` is assumed: `⅟n • x` is
pinned down as the unique `y` with `n • y = x`.

## Main results

* `TauCeti.isIdempotentElem_invOf_smul_geom_sum`: `(∑ i < n, υ ^ i) / n` is idempotent when
  `υ ^ n = 1`.
-/

public section

open Finset

namespace TauCeti

variable (R : Type*) {A : Type*} [Semiring R] [Semiring A] [Module R A] {υ : A}

/-- **`(1 + υ + ⋯ + υ ^ (n - 1)) / n` is idempotent** when `υ ^ n = 1` and `n` is invertible: it is
the averaging idempotent of the cyclic group generated by `υ`. Over a commutative ring, the case
`n = 2` is also `TauCeti.isIdempotentElem_halfOneAdd`. -/
theorem isIdempotentElem_invOf_smul_geom_sum {n : ℕ} [Invertible (n : R)] (hυ : υ ^ n = 1) :
    IsIdempotentElem ((⅟(n : R)) • ∑ i ∈ range n, υ ^ i) := by
  -- `N = ∑ i < n, υ ^ i` is fixed by left multiplication by `υ`, hence
  -- `N * N = ∑ i < n, υ ^ i * N = n • N`
  have hυN : υ * ∑ i ∈ range n, υ ^ i = ∑ i ∈ range n, υ ^ i := by
    cases n with
    | zero => simp
    | succ m =>
      -- `υ (υ ^ m + ∑ i < m, υ ^ i) = υ ^ (m + 1) + υ ∑ i < m, υ ^ i = υ ∑ i < m, υ ^ i + 1`
      rw [geom_sum_succ', mul_add, ← pow_succ', hυ, add_comm, ← geom_sum_succ, geom_sum_succ']
  set N := ∑ i ∈ range n, υ ^ i
  have hN : N * N = n • N := by
    have (i : ℕ) : υ ^ i * N = N := by
      induction i with
      | zero => rw [pow_zero, one_mul]
      | succ i ih => rw [pow_succ, mul_assoc, hυN, ih]
    calc N * N = ∑ i ∈ range n, υ ^ i * N := sum_mul ..
      _ = n • N := by simp [this]
  -- `e = ⅟n • N` satisfies `n • e = N`, so `n • n • (e * e) = N * N = n • N = n • n • e`;
  -- cancel `n`
  have hn (x : A) : (⅟(n : R)) • n • x = x := by rw [← Nat.cast_smul_eq_nsmul R, invOf_smul_smul]
  have hn_inj {x y : A} (h : n • x = n • y) : x = y := by rw [← hn x, h, hn]
  set e := (⅟(n : R)) • N
  have he : n • e = N := by rw [← Nat.cast_smul_eq_nsmul R, smul_invOf_smul]
  refine hn_inj (hn_inj ?_)
  rw [← smul_mul_assoc, ← mul_smul_comm, he, hN]

end TauCeti
