module

public import Mathlib.RingTheory.Idempotents
import Mathlib.LinearAlgebra.Projection

/-!
# Left ideals generated by idempotents

A principal left ideal has an idempotent generator exactly when its generator has an inner
inverse. In a ring, the ideals generated by idempotents are precisely the complemented left
ideals. Finite sums of orthogonal idempotents generate the sums of the corresponding ideals.
-/

public section

namespace TauCeti

variable {A : Type*} [Semiring A] {e : A}

/-- Membership in the left ideal generated by an idempotent: `x` lies in `Ae` exactly when `e` is a
right unit for `x`. -/
@[simp]
theorem mem_span_singleton_iff_mul_eq_self (he : IsIdempotentElem e) {x : A} :
    x ∈ (Ideal.span {e} : Ideal A) ↔ x * e = x := by
  refine ⟨fun hx ↦ ?_, fun hx ↦ Ideal.mem_span_singleton'.2 ⟨x, hx⟩⟩
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hx
  rw [mul_assoc, he.eq]

/-- A principal left ideal is generated by an idempotent exactly when its generator has an inner
inverse. -/
theorem exists_isIdempotentElem_span_singleton_eq_iff {R : Type*} [Semiring R] (a : R) :
    (∃ e : R, IsIdempotentElem e ∧ Ideal.span {a} = Ideal.span {e}) ↔
      ∃ b : R, a * b * a = a := by
  constructor
  · rintro ⟨e, he, hspan⟩
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (hspan ▸ Ideal.mem_span_singleton_self e)
    refine ⟨b, ?_⟩
    rw [mul_assoc, hb]
    exact (mem_span_singleton_iff_mul_eq_self he).mp
      (hspan ▸ Ideal.mem_span_singleton_self a)
  · rintro ⟨b, hb⟩
    refine ⟨b * a, ?_, le_antisymm ?_ ?_⟩
    · rw [IsIdempotentElem, mul_assoc b, ← mul_assoc a, hb]
    · exact (Ideal.span_singleton_le_iff_mem _).mpr
        (Ideal.mem_span_singleton'.mpr ⟨a, by rwa [← mul_assoc]⟩)
    · exact (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.mem_span_singleton'.mpr ⟨b, rfl⟩)

end TauCeti

namespace IsIdempotentElem

variable {A : Type*} [Ring A]

/-- The left ideals `Ay` and `A(1 - y)` of an idempotent `y` are complementary. -/
theorem isCompl_span_singleton_one_sub {y : A} (hy : IsIdempotentElem y) :
    IsCompl (Ideal.span {y} : Ideal A) (Ideal.span {1 - y}) := by
  refine ⟨Submodule.disjoint_def.2 fun z hz hz' ↦ ?_, codisjoint_iff.2 ?_⟩
  · obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hz'
    -- `z y = z` as `z ∈ Ay`, and `z y = 0` as `z ∈ A(1 - y)`.
    have h₁ : b * (1 - y) * y = 0 := by rw [mul_assoc, hy.one_sub_mul_self, mul_zero]
    rwa [hb, mul_assoc, hy.eq] at h₁
  · refine Ideal.eq_top_of_isUnit_mem _ ?_ isUnit_one
    simpa using Submodule.add_mem_sup (Ideal.mem_span_singleton_self y)
      (Ideal.mem_span_singleton_self (1 - y))

end IsIdempotentElem

namespace OrthogonalIdempotents

variable {A : Type*} [Semiring A] {ι : Type*} {f : ι → A}

/-- For orthogonal idempotents, the left ideal generated by a partial sum is the sum of the left
ideals generated by its terms. -/
theorem span_singleton_sum_eq_sup (hf : OrthogonalIdempotents f) (s : Finset ι) :
    (Ideal.span {∑ i ∈ s, f i} : Ideal A) = s.sup fun i ↦ Ideal.span {f i} := by
  refine le_antisymm ?_ (Finset.sup_le fun i hi ↦ ?_)
  · rw [Ideal.span_singleton_le_iff_mem]
    exact Submodule.sum_mem _ fun i hi ↦
      Finset.le_sup (f := fun i ↦ (Ideal.span {f i} : Ideal A)) hi
        (Ideal.mem_span_singleton_self _)
  · -- `fᵢ = fᵢ ∑ⱼ fⱼ` for `i ∈ s`.
    rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton']
    exact ⟨f i, hf.mul_sum_of_mem hi⟩

end OrthogonalIdempotents

namespace Ideal

variable {R : Type*} [Ring R]

/-- A left ideal has a complement exactly when it is generated by an idempotent. -/
theorem isComplemented_iff_eq_span_idempotent (I : Ideal R) :
    IsComplemented I ↔ ∃ e : R, IsIdempotentElem e ∧ I = Ideal.span {e} := by
  constructor
  · rintro ⟨J, hJ⟩
    -- Use the projection construction of Mathlib's `IsSemisimpleRing.ideal_eq_span_idempotent`.
    obtain ⟨f, hf, rfl⟩ := I.isIdempotentElemEquiv.symm (I.isComplEquivProj ⟨J, hJ⟩)
    have h : f = LinearMap.toSpanSingleton R R (f 1) :=
      LinearMap.ext_ring (LinearMap.toSpanSingleton_apply_one R R (f 1)).symm
    refine ⟨f 1, LinearMap.isIdempotentElem_map_one_iff.mpr hf, ?_⟩
    calc
      f.range = (LinearMap.toSpanSingleton R R (f 1)).range := congrArg LinearMap.range h
      _ = Ideal.span {f 1} := by rw [LinearMap.range_toSpanSingleton, Ideal.submodule_span_eq]
  · rintro ⟨e, he, rfl⟩
    exact ⟨_, he.isCompl_span_singleton_one_sub⟩

end Ideal

namespace TauCeti

/-- A principal left ideal is complemented exactly when its generator has an inner inverse. -/
theorem isComplemented_span_singleton_iff {R : Type*} [Ring R] (a : R) :
    IsComplemented (Ideal.span {a} : Ideal R) ↔ ∃ b : R, a * b * a = a :=
  (Ideal.span {a}).isComplemented_iff_eq_span_idempotent.trans
    (exists_isIdempotentElem_span_singleton_eq_iff a)

end TauCeti
