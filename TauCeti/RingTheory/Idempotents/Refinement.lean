module

public import Mathlib.RingTheory.Idempotents

import Mathlib.Algebra.Order.Ring.Idempotent
import Mathlib.Order.Disjointed

/-!
# Orthogonal refinement of a finite family of idempotents

In a commutative ring, idempotents `e i` are the clopen subsets `D(e i)` of the spectrum, and they
form a Boolean algebra (`a ⊓ b = a * b`, `aᶜ = 1 - a`). Finitely many of them can be made disjoint
without changing their union (`Fintype.exists_disjointed_le`): order the index set and replace
`D(e i)` by the part of it not covered by the earlier ones. Algebraically, the idempotents
`f i = e i * ∏ j < i, (1 - e j)` are orthogonal, with `f i * e i = f i` and
`∑ i, f i = 1 - ∏ i, (1 - e i)` (`TauCeti.exists_orthogonalIdempotents_sum_eq_one_sub_prod`).
If the `D(e i)` cover the spectrum, that is, if `∏ i, (1 - e i) = 0`, the refinement is a complete
orthogonal family (`TauCeti.exists_completeOrthogonalIdempotents_of_prod_one_sub_eq_zero`).

The common refinement of the partitions `{e i, 1 - e i}` consists of the choice products
`∏ i, (if σ i then e i else 1 - e i)`, one for each `σ : ι → Bool`. Some of them may be `0`; the
nonzero ones are the atoms of the Boolean algebra generated by the `e i`. The choice products form
a complete orthogonal family (`TauCeti.completeOrthogonalIdempotents_prod_ite`) whose components
are the loci where each `D(e i)` is either fully present or fully absent: a proper ideal over the
component `R ⧸ (1 - ∏ i, ...)` of a choice product avoids `e i` exactly when the product uses
`e i` (`TauCeti.notMem_iff_of_one_sub_prod_ite_mem`).
-/

public section

namespace TauCeti

variable {R : Type*} [CommRing R]

/-- Finitely many idempotents `e i` of a commutative ring can be refined to orthogonal idempotents
`f i` with `f i * e i = f i` and the same union of components, `∑ i, f i = 1 - ∏ i, (1 - e i)`. -/
theorem exists_orthogonalIdempotents_sum_eq_one_sub_prod {ι : Type*} [Fintype ι] (e : ι → R)
    (he : ∀ i, IsIdempotentElem (e i)) :
    ∃ f : ι → R, OrthogonalIdempotents f ∧ (∀ i, f i * e i = f i) ∧
      ∑ i, f i = 1 - ∏ i, (1 - e i) := by
  -- Refine `e` by `Fintype.exists_disjointed_le` in the Boolean algebra of idempotents, where
  -- `a ≤ b` means `a * b = a`, `a ⊓ b = a * b`, `⊥ = 0` and `aᶜ = 1 - a`.
  obtain ⟨g, hge, hsup, hdisj⟩ :=
    Fintype.exists_disjointed_le fun i ↦ (⟨e i, he i⟩ : {a : R // IsIdempotentElem a})
  have hinf (s : Finset ι) (h : ι → {a : R // IsIdempotentElem a}) :
      ((s.inf h : {a : R // IsIdempotentElem a}) : R) = ∏ i ∈ s, (h i : R) :=
    (Finset.fold_hom (m := Subtype.val) fun _ _ ↦ rfl).symm
  have hg : OrthogonalIdempotents fun i ↦ (g i : R) :=
    ⟨fun i ↦ (g i).property, fun i j hij ↦ congrArg Subtype.val (hdisj hij).eq_bot⟩
  refine ⟨fun i ↦ g i, hg, hge, ?_⟩
  -- Taking complements, `sup g = sup e` becomes `∏ i, (1 - g i) = ∏ i, (1 - e i)`.
  have h := congrArg (fun a ↦ ((aᶜ : {a : R // IsIdempotentElem a}) : R)) hsup
  simp only [Finset.compl_sup, hinf] at h
  rw [← sub_sub_cancel 1 (∑ i, (g i : R)), ← hg.prod_one_sub]
  exact congrArg (1 - ·) h

/-- Idempotents `e i` whose components cover the spectrum, `∏ i, (1 - e i) = 0`, can be refined to
a complete orthogonal family `f i` with `f i * e i = f i`. -/
theorem exists_completeOrthogonalIdempotents_of_prod_one_sub_eq_zero {ι : Type*} [Fintype ι]
    (e : ι → R) (he : ∀ i, IsIdempotentElem (e i)) (hcover : ∏ i, (1 - e i) = 0) :
    ∃ f : ι → R, CompleteOrthogonalIdempotents f ∧ ∀ i, f i * e i = f i := by
  obtain ⟨f, hf, hfe, hsum⟩ := exists_orthogonalIdempotents_sum_eq_one_sub_prod e he
  exact ⟨f, ⟨hf, by rw [hsum, hcover, sub_zero]⟩, hfe⟩

/-- The choice products of finitely many idempotents `e i`: for each choice `σ i` of `e i` or
`1 - e i`, the product `∏ i, (if σ i then e i else 1 - e i)`. They form a complete orthogonal
family, the common refinement of the partitions `{e i, 1 - e i}`; the nonzero ones are the atoms
of the Boolean algebra generated by the `e i`. -/
theorem completeOrthogonalIdempotents_prod_ite {ι : Type*} [Fintype ι] [DecidableEq ι]
    {e : ι → R} (he : ∀ i, IsIdempotentElem (e i)) :
    CompleteOrthogonalIdempotents fun σ : ι → Bool ↦ ∏ i, if σ i then e i else 1 - e i where
  idem σ := Finset.prod_induction _ IsIdempotentElem (fun _ _ ↦ IsIdempotentElem.mul) .one
    fun i _ ↦ by
      split
      · exact he i
      · exact (he i).one_sub
  ortho σ τ hστ := by
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hστ
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_eq_zero (Finset.mem_univ i) ?_
    cases hσ : σ i <;> cases hτ : τ i <;> simp_all [(he i).mul_one_sub_self,
      (he i).one_sub_mul_self]
  complete := by
    have h := Fintype.prod_sum fun i (b : Bool) ↦ if b then e i else 1 - e i
    simpa using h.symm

/-- Each idempotent factor of a choice product `∏ y, (if σ y then e y else 1 - e y)` absorbs
it. -/
theorem ite_mul_prod_ite {ι : Type*} [Fintype ι] {e : ι → R} (σ : ι → Bool) {x : ι}
    (hx : IsIdempotentElem (e x)) :
    (if σ x then e x else 1 - e x) * ∏ y, (if σ y then e y else 1 - e y) =
      ∏ y, (if σ y then e y else 1 - e y) := by
  have hidem : IsIdempotentElem (if σ x then e x else 1 - e x) := by
    split
    · exact hx
    · exact hx.one_sub
  classical
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ x), ← mul_assoc, hidem.eq]

/-- A proper ideal over the component `R ⧸ (1 - ∏ y, ...)` of a choice product contains `e x`
exactly when the product uses `1 - e x`. Only `e x` has to be idempotent, and only modulo the
ideal. -/
theorem notMem_iff_of_one_sub_prod_ite_mem {ι : Type*} [Fintype ι] {e : ι → R}
    (σ : ι → Bool) {p : Ideal R} (hp : p ≠ ⊤)
    (hF : 1 - ∏ y, (if σ y then e y else 1 - e y) ∈ p) {x : ι} (hx : e x * e x - e x ∈ p) :
    e x ∉ p ↔ σ x := by
  set F := ∏ y, (if σ y then e y else 1 - e y)
  cases hσx : σ x
  · -- In `R ⧸ p`, `e x` is idempotent, `F = 1`, and `1 - e x` absorbs `F`, so `e x = 0`.
    have hidem : IsIdempotentElem (Ideal.Quotient.mk p (e x)) := by
      rw [IsIdempotentElem, ← map_mul]
      exact Ideal.Quotient.eq.mpr hx
    have hF' : ∏ y, (if σ y then Ideal.Quotient.mk p (e y) else 1 - Ideal.Quotient.mk p (e y)) =
        1 := by
      have h := Ideal.Quotient.eq_zero_iff_mem.mpr hF
      rw [map_sub, map_one, sub_eq_zero, map_prod] at h
      simpa only [apply_ite (Ideal.Quotient.mk p), map_sub, map_one] using h.symm
    have h := ite_mul_prod_ite (e := fun i ↦ Ideal.Quotient.mk p (e i)) σ hidem
    simpa [hσx, hF', Ideal.Quotient.eq_zero_iff_mem] using h
  · -- If `e x ∈ p`, then so is the product `F`, and with `1 - F ∈ p` this gives `1 ∈ p`.
    refine iff_of_true (fun h ↦ hp ((Ideal.eq_top_iff_one _).mpr ?_)) rfl
    rw [← sub_add_cancel 1 F]
    exact p.add_mem hF (p.prod_mem (Finset.mem_univ x) (by simpa [hσx] using h))

end TauCeti
