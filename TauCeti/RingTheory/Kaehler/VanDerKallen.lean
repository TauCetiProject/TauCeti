/-!
# Van der Kallen's module

For a commutative ring `R`, **van der Kallen's module** `M_R` is the `R`-module generated by
symbols `D b`, `b ∈ R`, subject to

* `D (a * b) = a • D b + b • D a`,
* `D (a + b) = D a + D b + F (a * b)`,
* `F (a + b) = F a + F b`,

where `F a = D (1 + a) - D a`. Van der Kallen proved that `M_R` is isomorphic to the relative
group `K₂(R[ε], (ε))` of the dual numbers, with `a • D b` corresponding to the Dennis–Stein
expression `⟨-b, a ε⟩ + ⟨-a b ε, a b ε⟩`. If `F` were zero the relations would be those of the
absolute Kähler differentials `Ω[R⁄ℤ]`, and the correction term `F` measures the difference.

This file computes that difference at the level of modules, independently of `K₂`.

* `F` is additive, satisfies `F (c * c * a) = c • F a` and is killed by `2`.
* `Db ↦ db` is a surjection `VanDerKallenModule.toKaehler : M_R →ₗ[R] Ω[R⁄ℤ]` whose kernel is
  the span of the values of `F` (`VanDerKallenModule.ker_toKaehler`), for every commutative
  ring `R`.
* When `2` is a unit of `R`, `F` vanishes and `toKaehler` is an isomorphism
  (`VanDerKallenModule.kaehlerEquiv`).
* Without that hypothesis the two differ: `M_ℤ ≃ ℤ/2`, generated by `F 1`, while `Ω[ℤ⁄ℤ] = 0`
  (`VanDerKallenModule.intEquiv`), and `M_R = 0` when `2 = 0` in `R` and every element of `R` is
  a square, as for `𝔽₂` or a perfect field of characteristic two
  (`VanDerKallenModule.subsingleton_of_two_eq_zero_of_forall_isSquare`).

## Main definitions

* `TauCeti.vanDerKallenRelations R`: the generators and relations.
* `TauCeti.VanDerKallenModule R`: the module `M_R` they present.
* `TauCeti.VanDerKallenModule.D`, `TauCeti.VanDerKallenModule.F`: the symbols `D b` and
  `F a = D (1 + a) - D a`.
* `TauCeti.VanDerKallenModule.lift`: the universal property.
* `TauCeti.VanDerKallenModule.toKaehler`: the map `D b ↦ d b` to `Ω[R⁄ℤ]`.
* `TauCeti.VanDerKallenModule.kaehlerEquiv`: `M_R ≃ₗ[R] Ω[R⁄ℤ]` when `2` is a unit.
* `TauCeti.VanDerKallenModule.intEquiv`: `M_ℤ ≃+ ZMod 2`.

## References

* W. van der Kallen, *Le K₂ des nombres duaux*, C. R. Acad. Sci. Paris Sér. A 273 (1971),
  1204–1207: the theorem, its corollary and Examples 1 and 3.
* C. Weibel, *The K-book*, Exercise III.5.14(c).
-/

public section

noncomputable section

namespace TauCeti

open Finsupp

variable (R : Type*) [CommRing R]

/-- The generators and relations of **van der Kallen's module**: one generator `D b` for each
`b : R`, and, writing `F a = D (1 + a) - D a`, the three families of relations
`D (a * b) - a • D b - b • D a`, `D (a + b) - D a - D b - F (a * b)` and
`F (a + b) - F a - F b`. -/
abbrev vanDerKallenRelations : Module.Relations R where
  G := R
  R := (R × R) ⊕ (R × R) ⊕ (R × R)
  relation := Sum.elim
    (fun p ↦ single (p.1 * p.2) 1 - single p.2 p.1 - single p.1 p.2)
    (Sum.elim
      (fun p ↦ single (p.1 + p.2) 1 - single p.1 1 - single p.2 1 -
        (single (1 + p.1 * p.2) 1 - single (p.1 * p.2) 1))
      (fun p ↦ (single (1 + (p.1 + p.2)) 1 - single (p.1 + p.2) 1) -
        (single (1 + p.1) 1 - single p.1 1) - (single (1 + p.2) 1 - single p.2 1)))

/-- **Van der Kallen's module** `M_R` of a commutative ring `R`: the `R`-module presented by
`vanDerKallenRelations R`. By van der Kallen's theorem it is isomorphic to the relative group
`K₂(R[ε], (ε))` of the dual numbers. -/
abbrev VanDerKallenModule : Type _ := (vanDerKallenRelations R).Quotient

namespace VanDerKallenModule

variable {R}

/-- The generator `D b` of van der Kallen's module. -/
def D (b : R) : VanDerKallenModule R :=
  (vanDerKallenRelations R).toQuotient (single b 1)

/-- The correction term `F a = D (1 + a) - D a` of van der Kallen's module. -/
def F (a : R) : VanDerKallenModule R := D (1 + a) - D a

theorem F_def (a : R) : F a = D (1 + a) - D a := (rfl)

theorem D_one_add (a : R) : D (1 + a) = D a + F a := by
  rw [F_def, add_sub_cancel]

/-- The Leibniz relation. -/
theorem D_mul (a b : R) : D (a * b) = a • D b + b • D a := by
  have := (vanDerKallenRelations R).toQuotient_relation (.inl (a, b))
  simp only [Sum.elim_inl, map_sub, ← smul_single_one b a, ← smul_single_one a b,
    map_smul] at this
  simp only [D]
  linear_combination (norm := module) this

/-- Additivity of `D` up to the correction term `F`. -/
theorem D_add (a b : R) : D (a + b) = D a + D b + F (a * b) := by
  have := (vanDerKallenRelations R).toQuotient_relation (.inr (.inl (a, b)))
  simp only [Sum.elim_inl, Sum.elim_inr, map_sub] at this
  simp only [F_def, D]
  linear_combination (norm := module) this

/-- Additivity of the correction term `F`. -/
theorem F_add (a b : R) : F (a + b) = F a + F b := by
  have := (vanDerKallenRelations R).toQuotient_relation (.inr (.inr (a, b)))
  simp only [Sum.elim_inr, map_sub] at this
  simp only [F_def, D]
  linear_combination (norm := module) this

@[simp]
theorem D_one : D (1 : R) = 0 := by
  simpa using D_mul (1 : R) 1

@[simp]
theorem D_zero : D (0 : R) = 0 := by
  simpa using D_mul (0 : R) 0

@[simp]
theorem F_zero : F (0 : R) = 0 := by
  simp [F_def]

/-- `F`, as an additive homomorphism `R →+ M_R`. -/
def FHom : R →+ VanDerKallenModule R where
  toFun := F
  map_zero' := F_zero
  map_add' := F_add

@[simp]
theorem FHom_apply (a : R) : FHom a = F a := (rfl)

@[simp]
theorem F_neg (a : R) : F (-a) = -F a := map_neg FHom a

@[simp]
theorem F_sub (a b : R) : F (a - b) = F a - F b := map_sub FHom a b

/-- The value `F 1 = D 2`, which controls `F` on squares by `F_mul_self_mul`. -/
theorem F_one : F (1 : R) = D 2 := by
  rw [F_def, D_one, sub_zero, one_add_one_eq_two]

/-- The semilinearity of `F`: `F (c² a) = c • F a`. -/
theorem F_mul_self_mul (c a : R) : F (c * c * a) = c • F a := by
  -- Expand `D ((a + 1) c)` once by the Leibniz rule and once by the twisted additivity.
  have h := D_mul (a + 1) c
  have h₁ : D ((a + 1) * c) = D (a * c) + D c + F (a * c * c) := by rw [add_one_mul, D_add]
  have h₂ : D (a + 1) = D a + F a := by rw [D_add, D_one, mul_one, add_zero]
  have h₃ := D_mul a c
  rw [show c * c * a = a * c * c by ring]
  linear_combination (norm := module) h - h₁ + c • h₂ - h₃

/-- `F` is killed by `2`. -/
@[simp]
theorem F_add_self (a : R) : F a + F a = 0 := by
  have h := F_mul_self_mul (-1 : R) a
  rwa [neg_one_mul, neg_neg, one_mul, neg_one_smul, eq_neg_iff_add_eq_zero] at h

@[simp]
theorem two_smul_F (a : R) : (2 : R) • F a = 0 := by
  rw [two_smul, F_add_self]

@[simp]
theorem F_two_mul (a : R) : F (2 * a) = 0 := by
  rw [two_mul, F_add, F_add_self]

/-- When `2` is a unit, the correction term vanishes. -/
theorem F_eq_zero_of_isUnit_two (h : IsUnit (2 : R)) (a : R) : F a = 0 := by
  obtain ⟨u, hu⟩ := h
  have : a = 2 * (↑u⁻¹ * a) := by rw [← hu, ← mul_assoc, Units.mul_inv, one_mul]
  rw [this, F_two_mul]

/-- The symbols `D b` span van der Kallen's module: they are the generators of its presentation,
the variables of the tautological solution `Module.Relations.Solution.ofQuotient`. -/
theorem span_range_D : Submodule.span R (Set.range (D (R := R))) = ⊤ :=
  (Module.Relations.Solution.surjective_π_iff_span_eq_top _).1
    (Module.Relations.Solution.ofQuotient_isPresentation _).surjective_π

/-- An induction principle for van der Kallen's module: a property holding for every `D b` and
stable under sums and scalar multiples holds everywhere. -/
@[elab_as_elim]
theorem induction_on {P : VanDerKallenModule R → Prop} (x : VanDerKallenModule R)
    (D : ∀ b, P (D b)) (add : ∀ x y, P x → P y → P (x + y))
    (smul : ∀ (r : R) x, P x → P (r • x)) : P x := by
  have hx : x ∈ Submodule.span R (Set.range (VanDerKallenModule.D (R := R))) := by
    rw [span_range_D]
    exact Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem _ h => obtain ⟨b, rfl⟩ := h; exact D b
  | zero => exact D_zero (R := R) ▸ D 0
  | add x y _ _ hx hy => exact add x y hx hy
  | smul r x _ hx => exact smul r x hx

/-- Two linear maps out of van der Kallen's module agree if they agree on every `D b`. -/
@[ext]
theorem hom_ext {N : Type*} [AddCommGroup N] [Module R N] {f g : VanDerKallenModule R →ₗ[R] N}
    (h : ∀ b, f (D b) = g (D b)) : f = g :=
  Module.Relations.Quotient.linearMap_ext h

section lift

variable {N : Type*} [AddCommGroup N] [Module R N]

/-- The universal property of van der Kallen's module: a function `d : R → N` satisfying the
three defining relations induces a linear map `M_R →ₗ[R] N` sending `D b` to `d b`. -/
def lift (d : R → N) (hmul : ∀ a b, d (a * b) = a • d b + b • d a)
    (hadd : ∀ a b, d (a + b) = d a + d b + (d (1 + a * b) - d (a * b)))
    (hF : ∀ a b, d (1 + (a + b)) - d (a + b) = (d (1 + a) - d a) + (d (1 + b) - d b)) :
    VanDerKallenModule R →ₗ[R] N :=
  Module.Relations.Solution.fromQuotient
    { var := d
      linearCombination_var_relation := by
        rintro (⟨a, b⟩ | ⟨a, b⟩ | ⟨a, b⟩)
        · simp only [Sum.elim_inl, map_sub, linearCombination_single, one_smul]
          rw [hmul a b]
          abel
        · simp only [Sum.elim_inl, Sum.elim_inr, map_sub, linearCombination_single, one_smul]
          rw [hadd a b]
          abel
        · simp only [Sum.elim_inr, map_sub, linearCombination_single, one_smul]
          rw [hF a b]
          abel }

/-- The map `lift d` sends `D b` to `d b`. -/
@[simp]
theorem lift_D (d : R → N) (hmul : ∀ a b, d (a * b) = a • d b + b • d a)
    (hadd : ∀ a b, d (a + b) = d a + d b + (d (1 + a * b) - d (a * b)))
    (hF : ∀ a b, d (1 + (a + b)) - d (a + b) = (d (1 + a) - d a) + (d (1 + b) - d b))
    (b : R) : lift d hmul hadd hF (D b) = d b := by
  rw [lift, D, Module.Relations.Solution.fromQuotient_toQuotient,
    Module.Relations.Solution.π_single]

end lift

/-! ### Comparison with the Kähler differentials -/

/-- The map `D b ↦ d b` from van der Kallen's module to the absolute Kähler differentials. It is
surjective, with kernel the span of the correction terms `F a`. -/
def toKaehler : VanDerKallenModule R →ₗ[R] Ω[R⁄ℤ] :=
  lift (KaehlerDifferential.D ℤ R) (KaehlerDifferential.D ℤ R).leibniz
    (fun a b ↦ by simp only [map_add, Derivation.map_one_eq_zero, zero_add, sub_self, add_zero])
    (fun a b ↦ by simp only [map_add, Derivation.map_one_eq_zero, zero_add]; abel)

@[simp]
theorem toKaehler_D (b : R) : toKaehler (D b) = KaehlerDifferential.D ℤ R b := by
  simp [toKaehler]

@[simp]
theorem toKaehler_F (a : R) : toKaehler (F a) = 0 := by
  simp [F_def]

theorem toKaehler_surjective : Function.Surjective (toKaehler (R := R)) := by
  rw [← LinearMap.range_eq_top, eq_top_iff, ← KaehlerDifferential.span_range_derivation,
    Submodule.span_le]
  rintro _ ⟨b, rfl⟩
  exact ⟨D b, toKaehler_D b⟩

/-- `D`, viewed in the quotient of van der Kallen's module by the correction terms, is additive.
-/
private def addHomQuotient :
    R →+ VanDerKallenModule R ⧸ Submodule.span R (Set.range (F (R := R))) where
  toFun b := Submodule.Quotient.mk (D b)
  map_zero' := by rw [D_zero, Submodule.Quotient.mk_zero]
  map_add' a b := by
    rw [D_add, Submodule.Quotient.mk_add, (Submodule.Quotient.mk_eq_zero _).2
      (Submodule.subset_span (Set.mem_range_self (a * b))), add_zero, Submodule.Quotient.mk_add]

/-- `D`, viewed in the quotient of van der Kallen's module by the correction terms, is a
derivation. -/
private def derivationQuotient :
    Derivation ℤ R (VanDerKallenModule R ⧸ Submodule.span R (Set.range (F (R := R)))) :=
  Derivation.mk' addHomQuotient.toIntLinearMap fun a b ↦ by
    simp only [AddMonoidHom.coe_toIntLinearMap, addHomQuotient, AddMonoidHom.coe_mk,
      ZeroHom.coe_mk, D_mul, Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul]

/-- The kernel of `toKaehler` is the span of the correction terms `F a`, so that `Ω[R⁄ℤ]` is
van der Kallen's module modulo the values of `F`. -/
theorem ker_toKaehler :
    LinearMap.ker (toKaehler (R := R)) = Submodule.span R (Set.range (F (R := R))) := by
  refine le_antisymm (fun x hx ↦ ?_) (Submodule.span_le.2 ?_)
  · have key : derivationQuotient.liftKaehlerDifferential ∘ₗ toKaehler =
        (Submodule.span R (Set.range (F (R := R)))).mkQ := by
      ext b
      simp [derivationQuotient, addHomQuotient]
    rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, ← key, LinearMap.comp_apply,
      LinearMap.mem_ker.1 hx, map_zero]
  · rintro _ ⟨a, rfl⟩
    exact toKaehler_F a

/-- When `2` is a unit of `R`, van der Kallen's module is the module of absolute Kähler
differentials, by `D b ↦ d b`. -/
def kaehlerEquiv (h : IsUnit (2 : R)) : VanDerKallenModule R ≃ₗ[R] Ω[R⁄ℤ] :=
  LinearEquiv.ofBijective toKaehler
    ⟨by
      rw [← LinearMap.ker_eq_bot, ker_toKaehler, Submodule.span_eq_bot]
      rintro _ ⟨a, rfl⟩
      exact F_eq_zero_of_isUnit_two h a,
    toKaehler_surjective⟩

@[simp]
theorem kaehlerEquiv_apply (h : IsUnit (2 : R)) (x : VanDerKallenModule R) :
    kaehlerEquiv h x = toKaehler x := (rfl)

@[simp]
theorem kaehlerEquiv_symm_D (h : IsUnit (2 : R)) (b : R) :
    (kaehlerEquiv h).symm (KaehlerDifferential.D ℤ R b) = D b := by
  rw [LinearEquiv.symm_apply_eq, kaehlerEquiv_apply, toKaehler_D]

/-! ### The examples `ℤ` and characteristic two -/

/-- Over `ℤ`, `F m = m • F 1`, by additivity of `F`. -/
theorem F_eq_zsmul_F_one (m : ℤ) : F m = m • F 1 := by
  simpa only [smul_eq_mul, mul_one, FHom_apply] using map_zsmul (FHom (R := ℤ)) m 1

/-- Over `ℤ` every element of van der Kallen's module is a multiple of `F 1`. -/
theorem exists_eq_zsmul_F_one (x : VanDerKallenModule ℤ) : ∃ k : ℤ, x = k • F 1 := by
  induction x using induction_on with
  | D n =>
    induction n using Int.induction_on with
    | zero => exact ⟨0, by simp⟩
    | succ m hm =>
      obtain ⟨k, hk⟩ := hm
      exact ⟨k + m, by rw [add_comm, D_one_add, hk, add_zsmul, F_eq_zsmul_F_one (m : ℤ)]⟩
    | pred m hm =>
      obtain ⟨k, hk⟩ := hm
      have h := D_one_add (-(m : ℤ) - 1)
      rw [show (1 : ℤ) + (-(m : ℤ) - 1) = -(m : ℤ) by ring] at h
      refine ⟨k - (-(m : ℤ) - 1), ?_⟩
      rw [sub_zsmul, ← hk, ← F_eq_zsmul_F_one (-(m : ℤ) - 1), h]
      abel
  | add x y hx hy =>
    obtain ⟨k, rfl⟩ := hx
    obtain ⟨l, rfl⟩ := hy
    exact ⟨k + l, (add_zsmul _ _ _).symm⟩
  | smul r x hx =>
    obtain ⟨k, rfl⟩ := hx
    refine ⟨r * k, ?_⟩
    rw [mul_zsmul]
    -- `r • _` is the scalar action of the presented `ℤ`-module, and `k • F 1` is `zsmul`; all
    -- `ℤ`-module structures agree, and `int_smul_eq_zsmul` identifies the two.
    exact int_smul_eq_zsmul _ r _

/-- The value of `D n` in `ℤ/2` under the isomorphism `M_ℤ ≃ ℤ/2`: the binomial coefficient
`n (n - 1) / 2` modulo `2`, which only depends on `n` modulo `4`. -/
private def intTable (x : ZMod 4) : ZMod 2 := if 2 ≤ x.val then 1 else 0

private theorem intTable_mul :
    ∀ x y : ZMod 4, intTable (x * y) = (x.cast : ZMod 2) * intTable y +
      (y.cast : ZMod 2) * intTable x := by
  decide

private theorem intTable_add :
    ∀ x y : ZMod 4, intTable (x + y) =
      intTable x + intTable y + (intTable (1 + x * y) - intTable (x * y)) := by
  decide

private theorem intTable_F :
    ∀ x y : ZMod 4, intTable (1 + (x + y)) - intTable (x + y) =
      (intTable (1 + x) - intTable x) + (intTable (1 + y) - intTable y) := by
  decide

private theorem cast_cast_four (n : ℤ) : ((n : ZMod 4).cast : ZMod 2) = n := by
  rw [ZMod.cast_intCast (by decide : 2 ∣ 4)]

/-- The detector `M_ℤ → ℤ/2`, sending `D n` to `n (n - 1) / 2` modulo `2`. -/
private def intDetector : VanDerKallenModule ℤ →+ ZMod 2 :=
  (lift (fun n : ℤ ↦ intTable n)
    (fun a b ↦ by
      rw [Int.cast_mul, intTable_mul, cast_cast_four, cast_cast_four, zsmul_eq_mul,
        zsmul_eq_mul])
    (fun a b ↦ by push_cast; exact intTable_add _ _)
    (fun a b ↦ by push_cast; exact intTable_F _ _)).toAddMonoidHom

private theorem intDetector_F_one : intDetector (F (1 : ℤ)) = 1 := by
  rw [F_def, map_sub, intDetector, LinearMap.toAddMonoidHom_coe, lift_D, lift_D]
  decide

/-- Over `ℤ`, the correction term `F 1` is nonzero, although `Ω[ℤ⁄ℤ] = 0`. -/
theorem F_one_int_ne_zero : F (1 : ℤ) ≠ 0 := fun h ↦ by
  simpa [h] using intDetector_F_one

/-- **Van der Kallen's module of `ℤ`** is `ℤ/2` as an abelian group, generated by `F 1`. -/
def intEquiv : VanDerKallenModule ℤ ≃+ ZMod 2 :=
  AddEquiv.ofBijective intDetector
    ⟨(injective_iff_map_eq_zero _).2 fun x hx ↦ by
      obtain ⟨k, rfl⟩ := exists_eq_zsmul_F_one x
      rw [map_zsmul, intDetector_F_one, zsmul_one, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      obtain ⟨m, rfl⟩ := hx
      simp [mul_comm, mul_zsmul, two_zsmul],
    fun y ↦ ⟨(y.val : ℤ) • F 1, by
      rw [map_zsmul, intDetector_F_one, zsmul_one, Int.cast_natCast, ZMod.natCast_zmod_val]⟩⟩

@[simp]
theorem intEquiv_F_one : intEquiv (F (1 : ℤ)) = 1 :=
  intDetector_F_one

@[simp]
theorem intEquiv_symm_one : intEquiv.symm 1 = F (1 : ℤ) := by
  rw [AddEquiv.symm_apply_eq, intEquiv_F_one]

/-- Van der Kallen's module vanishes over a ring of characteristic two in which every element is
a square, for instance a perfect field of characteristic two: `D (c * c) = (2 * c) • D c = 0`, and
the symbols `D b` span. -/
theorem subsingleton_of_two_eq_zero_of_forall_isSquare (h2 : (2 : R) = 0)
    (hsq : ∀ b : R, IsSquare b) : Subsingleton (VanDerKallenModule R) := by
  refine subsingleton_of_forall_eq 0 fun x ↦ ?_
  induction x using induction_on with
  | D b =>
    obtain ⟨c, rfl⟩ := hsq b
    rw [D_mul, ← add_smul, ← two_mul, h2, zero_mul, zero_smul]
  | add x y hx hy => rw [hx, hy, add_zero]
  | smul r x hx => rw [hx, smul_zero]

/-- Van der Kallen's module of `𝔽₂` is zero. -/
instance : Subsingleton (VanDerKallenModule (ZMod 2)) :=
  subsingleton_of_two_eq_zero_of_forall_isSquare (by decide) fun b ↦
    ⟨b, by revert b; decide⟩

end VanDerKallenModule

end TauCeti
