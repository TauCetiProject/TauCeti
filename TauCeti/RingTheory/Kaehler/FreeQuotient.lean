module

public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.LocalRing.Basic
public import Mathlib.RingTheory.Localization.Defs

/-!
# Free quotients of the Kähler differentials of the node and the cusp

For a local `k`-algebra `R` whose Kähler differentials `Ω[R⁄k]` are spanned by `d x` and `d y`,
a relation `p • d x + q • d y = 0` in which neither of `p`, `q` divides the other rules out every
surjection `Ω[R⁄k] → R ^ d` with `d ≠ 0`: the images `a`, `b` of `d x`, `d y` under such a
surjection generate the unit ideal, so one of them is a unit, and `p a + q b = 0` then makes one
of `p`, `q` a multiple of the other.

This applies to the node `x y = 0`, where `y • d x + x • d y = 0`, and, when `2` and `3` are
units, to the cusp `y ^ 2 = x ^ 3`, where `3 x ^ 2 • d x - 2 y • d y = 0`. These are the
ring-level halves of the node example and of the Check "the cusp over `ℚ` admits no locally free
quotient of rank one" for `HasLocallyFreeQuotientOfDifferentials` (NashBlowups §0.7).

The hypothesis that `d x` and `d y` span holds for the localizations of a `k`-algebra generated by
`x` and `y` (`TauCeti.span_D_image_eq_top_of_isLocalization`).

## Main results

* `TauCeti.span_D_image_eq_top_of_isLocalization`: if `A` is generated by `s` as a `k`-algebra and
  `R` is a localization of `A`, then the `d (a / 1)` for `a ∈ s` span `Ω[R⁄k]`.
* `TauCeti.not_surjective_kaehlerDifferential_of_smul_D_add_smul_D_eq_zero`: the general
  criterion above.
* `TauCeti.not_surjective_kaehlerDifferential_of_mul_eq_zero`: the node.
* `TauCeti.not_surjective_kaehlerDifferential_of_sq_eq_pow_three`: the cusp.
-/

public section

open KaehlerDifferential

namespace TauCeti

variable {k R : Type*} [CommRing k] [CommRing R] [Algebra k R]

/-- If the `k`-algebra `A` is generated by `s` and `R` is a localization of `A` at a submonoid
`M`, then the differentials of the images of the elements of `s` span `Ω[R⁄k]`. -/
theorem span_D_image_eq_top_of_isLocalization {A : Type*} [CommRing A] [Algebra k A]
    [Algebra A R] [IsScalarTower k A R] (M : Submonoid A) [IsLocalization M R] {s : Set A}
    (hs : Algebra.adjoin k s = ⊤) :
    Submodule.span R (D k R '' (algebraMap A R '' s)) = ⊤ := by
  set W := Submodule.span R (D k R '' (algebraMap A R '' s))
  -- The elements of `A` whose image has differential in `W` form a subalgebra containing `s`.
  have hA : ∀ a : A, D k R (algebraMap A R a) ∈ W := by
    intro a
    have ha : a ∈ Algebra.adjoin k s := hs ▸ Algebra.mem_top
    induction ha using Algebra.adjoin_induction with
    | mem x hx => exact Submodule.subset_span ⟨_, ⟨x, hx, rfl⟩, rfl⟩
    | algebraMap c => simp [← IsScalarTower.algebraMap_apply]
    | add x y _ _ hx hy => simpa using W.add_mem hx hy
    | mul x y _ _ hx hy =>
      rw [map_mul, Derivation.leibniz]
      exact W.add_mem (W.smul_mem _ hy) (W.smul_mem _ hx)
  rw [eq_top_iff, ← span_range_derivation, Submodule.span_le]
  rintro _ ⟨r, rfl⟩
  obtain ⟨⟨a, m⟩, hr⟩ := IsLocalization.surj M r
  -- `r * m = a`, so `m • d r = d a - r • d m`, and `m` is a unit of `R`.
  have hm : IsUnit (algebraMap A R m) := IsLocalization.map_units R m
  have h : algebraMap A R m • D k R r =
      D k R (algebraMap A R a) - r • D k R (algebraMap A R m) := by
    rw [← hr, Derivation.leibniz]
    abel
  have hmem : algebraMap A R m • D k R r ∈ W := h ▸ W.sub_mem (hA a) (W.smul_mem _ (hA m))
  have := W.smul_mem (↑hm.unit⁻¹ : R) hmem
  rwa [smul_smul, hm.val_inv_mul, one_smul] at this

/-- **No free quotient from a relation between two generators.** Let `R` be a local `k`-algebra
whose differentials are spanned by `d x` and `d y`, and let `p • d x + q • d y = 0` with
`p ∉ (q)` and `q ∉ (p)`. Then no `R`-linear map `Ω[R⁄k] → R ^ d` with `d ≠ 0` is surjective. -/
theorem not_surjective_kaehlerDifferential_of_smul_D_add_smul_D_eq_zero [IsLocalRing R]
    {x y p q : R} (hspan : Submodule.span R {D k R x, D k R y} = ⊤)
    (hrel : p • D k R x + q • D k R y = 0) (hp : p ∉ Ideal.span {q}) (hq : q ∉ Ideal.span {p})
    {d : ℕ} (hd : d ≠ 0) (g : Ω[R⁄k] →ₗ[R] (Fin d → R)) : ¬ Function.Surjective g := by
  intro hg
  let g₀ : Ω[R⁄k] →ₗ[R] R := LinearMap.proj ⟨0, Nat.pos_of_ne_zero hd⟩ ∘ₗ g
  obtain ⟨ω, hω⟩ := hg fun _ ↦ 1
  obtain ⟨α, β, rfl⟩ := Submodule.mem_span_pair.mp (hspan ▸ Submodule.mem_top (x := ω))
  have h1 : α * g₀ (D k R x) + β * g₀ (D k R y) = 1 := by
    simpa [g₀] using congrFun hω ⟨0, Nat.pos_of_ne_zero hd⟩
  have h0 : p * g₀ (D k R x) + q * g₀ (D k R y) = 0 := by
    simpa using congrArg g₀ hrel
  rcases IsLocalRing.isUnit_or_isUnit_of_add_one h1 with h | h
  · obtain ⟨u, hu⟩ := isUnit_of_mul_isUnit_right h
    refine hp (Ideal.mem_span_singleton'.mpr ⟨-(g₀ (D k R y) * ↑u⁻¹), ?_⟩)
    calc -(g₀ (D k R y) * ↑u⁻¹) * q = -(q * g₀ (D k R y)) * ↑u⁻¹ := by ring
      _ = p * g₀ (D k R x) * ↑u⁻¹ := by rw [← eq_neg_of_add_eq_zero_left h0]
      _ = p := by rw [← hu, mul_assoc, Units.mul_inv, mul_one]
  · obtain ⟨u, hu⟩ := isUnit_of_mul_isUnit_right h
    refine hq (Ideal.mem_span_singleton'.mpr ⟨-(g₀ (D k R x) * ↑u⁻¹), ?_⟩)
    calc -(g₀ (D k R x) * ↑u⁻¹) * p = -(p * g₀ (D k R x)) * ↑u⁻¹ := by ring
      _ = q * g₀ (D k R y) * ↑u⁻¹ := by rw [← eq_neg_of_add_eq_zero_right h0]
      _ = q := by rw [← hu, mul_assoc, Units.mul_inv, mul_one]

/-- **The node.** Let `R` be a local `k`-algebra whose differentials are spanned by `d x` and
`d y`, with `x y = 0`, `x ∉ (y)` and `y ∉ (x)`. Then `Ω[R⁄k]` has no free quotient of nonzero
rank: a surjection would send `d x`, `d y` to `a`, `b` with `y a + x b = 0`, one of them a unit. -/
theorem not_surjective_kaehlerDifferential_of_mul_eq_zero [IsLocalRing R] {x y : R}
    (hspan : Submodule.span R {D k R x, D k R y} = ⊤) (hxy : x * y = 0)
    (hx : x ∉ Ideal.span {y}) (hy : y ∉ Ideal.span {x}) {d : ℕ} (hd : d ≠ 0)
    (g : Ω[R⁄k] →ₗ[R] (Fin d → R)) : ¬ Function.Surjective g := by
  refine not_surjective_kaehlerDifferential_of_smul_D_add_smul_D_eq_zero hspan
    (p := y) (q := x) ?_ hy hx hd g
  have := congrArg (D k R) hxy
  rw [Derivation.leibniz, map_zero] at this
  rw [← this, add_comm]

/-- **The cusp.** Let `R` be a local `k`-algebra in which `2` and `3` are units, whose
differentials are spanned by `d x` and `d y`, with `y ^ 2 = x ^ 3`, `y ∉ (x ^ 2)` and
`x ^ 2 ∉ (y)`. Then `Ω[R⁄k]` has no free quotient of nonzero rank: `3 x ^ 2 • d x = 2 y • d y`. -/
theorem not_surjective_kaehlerDifferential_of_sq_eq_pow_three [IsLocalRing R] {x y : R}
    (h2 : IsUnit (2 : R)) (h3 : IsUnit (3 : R))
    (hspan : Submodule.span R {D k R x, D k R y} = ⊤) (hxy : y ^ 2 = x ^ 3)
    (hx : x ^ 2 ∉ Ideal.span {y}) (hy : y ∉ Ideal.span {x ^ 2}) {d : ℕ} (hd : d ≠ 0)
    (g : Ω[R⁄k] →ₗ[R] (Fin d → R)) : ¬ Function.Surjective g := by
  refine not_surjective_kaehlerDifferential_of_smul_D_add_smul_D_eq_zero hspan
    (p := 3 * x ^ 2) (q := -(2 * y)) ?_ ?_ ?_ hd g
  · have := congrArg (D k R) hxy
    rw [Derivation.leibniz_pow, Derivation.leibniz_pow] at this
    norm_num at this
    rw [mul_smul, neg_smul, mul_smul, ofNat_smul_eq_nsmul (R := R) 3,
      ofNat_smul_eq_nsmul (R := R) 2, this, add_neg_cancel]
  · rw [Ideal.mem_span_singleton', not_exists] at hx ⊢
    intro c hc
    obtain ⟨u, hu⟩ := h3
    refine hx (-(c * 2 * ↑u⁻¹)) ?_
    calc -(c * 2 * ↑u⁻¹) * y = c * -(2 * y) * ↑u⁻¹ := by ring
      _ = x ^ 2 := by rw [hc, ← hu, mul_right_comm, Units.mul_inv, one_mul]
  · rw [Ideal.mem_span_singleton', not_exists] at hy ⊢
    intro c hc
    obtain ⟨u, hu⟩ := h2
    refine hy (-(c * 3 * ↑u⁻¹)) ?_
    calc -(c * 3 * ↑u⁻¹) * x ^ 2 = -(c * (3 * x ^ 2)) * ↑u⁻¹ := by ring
      _ = y := by rw [hc, neg_neg, ← hu, mul_right_comm, Units.mul_inv, one_mul]

end TauCeti
