module

public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.LocalRing.Basic

/-!
# Free quotients of the Kähler differentials of the node and the cusp

For a module `M` over a local ring `R` spanned by `m₁` and `m₂`, a relation `p • m₁ + q • m₂ = 0`
in which neither of `p`, `q` divides the other rules out every surjection `M → R ^ d` with
`d ≠ 0`: the images `a`, `b` of `m₁`, `m₂` under such a surjection generate the unit ideal, so one
of them is a unit, and `p a + q b = 0` then makes one of `p`, `q` a multiple of the other.

Applied to the Kähler differentials `Ω[R⁄k]` of a local `k`-algebra `R` spanned by `d x` and
`d y`, this covers the node `x y = 0`, where `y • d x + x • d y = 0`, and, when `2` and `3` are
units, the cusp `y ^ 2 = x ^ 3`, where `3 x ^ 2 • d x - 2 y • d y = 0`. In both cases `Ω[R⁄k]`
has no free quotient of nonzero rank, which obstructs a locally free quotient of the
differentials at such a singular point.

The hypothesis that `d x` and `d y` span holds for the localizations of a `k`-algebra generated by
`x` and `y` (`TauCeti.KaehlerDifferential.span_D_image_eq_top_of_isLocalization`).

## Main results

* `TauCeti.not_surjective_of_smul_add_smul_eq_zero`: the criterion above for maps to `R`.
* `TauCeti.not_surjective_pi_of_smul_add_smul_eq_zero`: the criterion above for maps to `R ^ d`.
* `TauCeti.not_surjective_kaehlerDifferential_of_mul_eq_zero`: the node.
* `TauCeti.not_surjective_kaehlerDifferential_of_sq_eq_pow_three`: the cusp.
-/

public section

open KaehlerDifferential

namespace TauCeti

section Module

variable {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M] [Module R M]

/-- **No free quotient from a relation between two generators.** Let `M` be a module over a local
ring `R`, spanned by `m₁` and `m₂`, and let `p • m₁ + q • m₂ = 0` with `p ∉ (q)` and `q ∉ (p)`.
Then no `R`-linear map `M → R` is surjective. -/
theorem not_surjective_of_smul_add_smul_eq_zero {m₁ m₂ : M} {p q : R}
    (hspan : Submodule.span R {m₁, m₂} = ⊤) (hrel : p • m₁ + q • m₂ = 0)
    (hp : p ∉ Ideal.span {q}) (hq : q ∉ Ideal.span {p}) (g : M →ₗ[R] R) :
    ¬ Function.Surjective g := by
  intro hg
  obtain ⟨ω, hω⟩ := hg 1
  obtain ⟨α, β, rfl⟩ := Submodule.mem_span_pair.mp (hspan ▸ Submodule.mem_top (x := ω))
  have h1 : α * g m₁ + β * g m₂ = 1 := by simpa using hω
  have h0 : p * g m₁ + q * g m₂ = 0 := by simpa using congrArg g hrel
  rcases IsLocalRing.isUnit_or_isUnit_of_add_one h1 with h | h
  · refine hp ((Ideal.mul_unit_mem_iff_mem _ (isUnit_of_mul_isUnit_right h)).mp ?_)
    rw [eq_neg_of_add_eq_zero_left h0, ← mul_neg]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self q)
  · refine hq ((Ideal.mul_unit_mem_iff_mem _ (isUnit_of_mul_isUnit_right h)).mp ?_)
    rw [eq_neg_of_add_eq_zero_right h0, ← mul_neg]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self p)

/-- Let `M` be a module over a local ring `R`, spanned by `m₁` and `m₂`, and let
`p • m₁ + q • m₂ = 0` with `p ∉ (q)` and `q ∉ (p)`. Then no `R`-linear map `M → R ^ d` with
`d ≠ 0` is surjective. -/
theorem not_surjective_pi_of_smul_add_smul_eq_zero {m₁ m₂ : M} {p q : R}
    (hspan : Submodule.span R {m₁, m₂} = ⊤) (hrel : p • m₁ + q • m₂ = 0)
    (hp : p ∉ Ideal.span {q}) (hq : q ∉ Ideal.span {p}) {d : ℕ} (hd : d ≠ 0)
    (g : M →ₗ[R] (Fin d → R)) : ¬ Function.Surjective g := fun hg ↦
  not_surjective_of_smul_add_smul_eq_zero hspan hrel hp hq
    (LinearMap.proj ⟨0, Nat.pos_of_ne_zero hd⟩ ∘ₗ g)
    ((Function.surjective_eval _).comp hg)

end Module

variable {k R : Type*} [CommRing k] [CommRing R] [Algebra k R] [IsLocalRing R]

/-- **The node.** Let `R` be a local `k`-algebra whose differentials are spanned by `d x` and
`d y`, with `x y = 0`, `x ∉ (y)` and `y ∉ (x)`. Then `Ω[R⁄k]` has no free quotient of nonzero
rank. -/
theorem not_surjective_kaehlerDifferential_of_mul_eq_zero {x y : R}
    (hspan : Submodule.span R {D k R x, D k R y} = ⊤) (hxy : x * y = 0)
    (hx : x ∉ Ideal.span {y}) (hy : y ∉ Ideal.span {x}) {d : ℕ} (hd : d ≠ 0)
    (g : Ω[R⁄k] →ₗ[R] (Fin d → R)) : ¬ Function.Surjective g := by
  refine not_surjective_pi_of_smul_add_smul_eq_zero hspan (p := y) (q := x) ?_ hy hx hd g
  have := congrArg (D k R) hxy
  rw [Derivation.leibniz, map_zero] at this
  rw [← this, add_comm]

/-- **The cusp.** Let `R` be a local `k`-algebra in which `2` and `3` are units, whose
differentials are spanned by `d x` and `d y`, with `y ^ 2 = x ^ 3`, `y ∉ (x ^ 2)` and
`x ^ 2 ∉ (y)`. Then `Ω[R⁄k]` has no free quotient of nonzero rank. -/
theorem not_surjective_kaehlerDifferential_of_sq_eq_pow_three {x y : R}
    (h2 : IsUnit (2 : R)) (h3 : IsUnit (3 : R))
    (hspan : Submodule.span R {D k R x, D k R y} = ⊤) (hxy : y ^ 2 = x ^ 3)
    (hx : x ^ 2 ∉ Ideal.span {y}) (hy : y ∉ Ideal.span {x ^ 2}) {d : ℕ} (hd : d ≠ 0)
    (g : Ω[R⁄k] →ₗ[R] (Fin d → R)) : ¬ Function.Surjective g := by
  refine not_surjective_pi_of_smul_add_smul_eq_zero hspan
    (p := 3 * x ^ 2) (q := -(2 * y)) ?_ ?_ ?_ hd g
  · -- Differentiating `y ^ 2 = x ^ 3` gives `2 y • d y = 3 x ^ 2 • d x`.
    have := congrArg (D k R) hxy
    rw [Derivation.leibniz_pow, Derivation.leibniz_pow] at this
    norm_num at this
    rw [mul_smul, neg_smul, mul_smul, ofNat_smul_eq_nsmul (R := R) 3,
      ofNat_smul_eq_nsmul (R := R) 2, this, add_neg_cancel]
  · rwa [Ideal.span_singleton_neg, Ideal.span_singleton_mul_left_unit h2,
      Ideal.unit_mul_mem_iff_mem _ h3]
  · rwa [Ideal.span_singleton_mul_left_unit h3, neg_mem_iff, Ideal.unit_mul_mem_iff_mem _ h2]

end TauCeti
