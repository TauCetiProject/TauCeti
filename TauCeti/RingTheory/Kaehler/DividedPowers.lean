/-!
# Divided power differentials

For a divided power structure `δ` on an ideal of an `R`-algebra `B`, the module
`TauCeti.PDKaehlerDifferential R δ` is the quotient of the ordinary Kähler differentials
by the relations `d(δₙ₊₁(x)) = δₙ(x) • dx`. Its universal derivation represents the
`B`-module of divided power `R`-derivations. A divided power algebra map induces a
semilinear map on these modules.

## References

* [Stacks Project, Definition 60.6.1](https://stacks.math.columbia.edu/tag/07HR).
* M. D'Addezio, *Affine crystalline cohomology and de Rham cohomology in Lean 4*, v1.0.0.
  The files `PDDifferentials.lean` and `PDDifferentials/Representability.lean` also formalize
  the universal divided power derivation.
-/

public section

noncomputable section

open KaehlerDifferential

variable {R B C E M : Type*} [CommRing R] [CommRing B] [CommRing C] [CommRing E]
  [Algebra R B] [Algebra R C] [Algebra R E] [AddCommGroup M] [Module B M] [Module R M]
  [IsScalarTower R B M] {I : Ideal B} {J : Ideal C} {K : Ideal E}

/-- A divided power derivation satisfies the chain rule for every positive divided power on
the ideal. -/
def Derivation.IsPD (d : Derivation R B M) (δ : DividedPowers I) : Prop :=
  ∀ n x, x ∈ I → d (δ.dpow (n + 1) x) = δ.dpow n x • d x

omit [IsScalarTower R B M] in
/-- The chain rule for a divided power of successor degree. -/
theorem Derivation.IsPD.apply_dpow_succ {d : Derivation R B M} {δ : DividedPowers I}
    (hd : d.IsPD δ) (n : ℕ) {x : B} (hx : x ∈ I) :
    d (δ.dpow (n + 1) x) = δ.dpow n x • d x :=
  hd n x hx

/-- The submodule of derivations compatible with the divided powers `δ`. -/
def DividedPowers.derivations (δ : DividedPowers I) (R M : Type*) [CommRing R]
    [Algebra R B] [AddCommGroup M] [Module R M] [Module B M] [IsScalarTower R B M] :
    Submodule B (Derivation R B M) where
  carrier := {d | d.IsPD δ}
  zero_mem' := by intro n x _; simp
  add_mem' hd he := by
    intro n x hx
    simp [hd.apply_dpow_succ n hx, he.apply_dpow_succ n hx, smul_add]
  smul_mem' a _ hd := by
    intro n x hx
    simp [hd.apply_dpow_succ n hx, smul_comm a (δ.dpow n x)]

/-- Membership in the submodule of divided power derivations is the divided power chain rule. -/
theorem DividedPowers.mem_derivations_iff {δ : DividedPowers I} {d : Derivation R B M} :
    d ∈ δ.derivations R M ↔ d.IsPD δ :=
  (Iff.rfl)

namespace TauCeti.PDKaehlerDifferential

variable (R) (δ : DividedPowers I)

/-- The submodule of the ordinary Kähler differentials generated by the divided power relations. -/
def relations : Submodule B Ω[B⁄R] :=
  Submodule.span B {ω | ∃ (n : ℕ) (x : B), x ∈ I ∧
    D R B (δ.dpow (n + 1) x) - δ.dpow n x • D R B x = ω}

/-- The presentation of the relation submodule by the divided power chain rule. -/
theorem relations_le_iff {N : Submodule B Ω[B⁄R]} :
    relations R δ ≤ N ↔ ∀ (n : ℕ) (x : B), x ∈ I →
      D R B (δ.dpow (n + 1) x) - δ.dpow n x • D R B x ∈ N := by
  rw [relations, Submodule.span_le]
  constructor
  · intro h n x hx
    exact h ⟨n, x, hx, rfl⟩
  · rintro h _ ⟨n, x, hx, rfl⟩
    exact h n x hx

/-- The divided power relations lie in the kernel exactly when the induced derivation is a PD
derivation. -/
theorem relations_le_ker_iff (f : Ω[B⁄R] →ₗ[B] M) :
    relations R δ ≤ LinearMap.ker f ↔ (f.compDer (D R B)).IsPD δ := by
  rw [relations_le_iff, Derivation.IsPD]
  simp only [LinearMap.mem_ker, map_sub, map_smul, sub_eq_zero]
  rfl

end TauCeti.PDKaehlerDifferential

namespace TauCeti

/-- Kähler differentials modulo the relations for the divided power chain rule. -/
abbrev PDKaehlerDifferential (R : Type*) [CommRing R] [Algebra R B] (δ : DividedPowers I) :=
  Ω[B⁄R] ⧸ PDKaehlerDifferential.relations R δ

namespace PDKaehlerDifferential

variable (R) (δ : DividedPowers I)

/-- The quotient map from ordinary Kähler differentials to divided power differentials. -/
abbrev mkQ : Ω[B⁄R] →ₗ[B] PDKaehlerDifferential R δ :=
  (relations R δ).mkQ

/-- The universal derivation into the divided power differentials. -/
def d : Derivation R B (PDKaehlerDifferential R δ) :=
  (mkQ R δ).compDer (D R B)

/-- The universal divided power derivation is the quotient of the ordinary derivation. -/
@[simp]
theorem mk_D (x : B) :
    Submodule.Quotient.mk (p := relations R δ) (D R B x) = d R δ x :=
  (rfl)

/-- The universal derivation satisfies the divided power chain rule. -/
theorem isPD_d : (d R δ).IsPD δ :=
  (relations_le_ker_iff R δ (mkQ R δ)).mp (by simp)

/-- The universal divided power derivation differentiates positive divided powers. -/
@[simp]
theorem d_dpow_succ (n : ℕ) {x : B} (hx : x ∈ I) :
    d R δ (δ.dpow (n + 1) x) = δ.dpow n x • d R δ x :=
  (isPD_d R δ).apply_dpow_succ n hx

/-- The generators `dx` span the module of divided power differentials. -/
theorem span_range_d : Submodule.span B (Set.range (d R δ)) = ⊤ := by
  rw [← (relations R δ).range_mkQ, ← Submodule.map_top, ← span_range_derivation R B,
    Submodule.map_span, ← Set.range_comp]
  rfl

variable {R δ}

omit [Algebra R C] in
/-- Two semilinear maps from the divided power differentials agree if they agree on `dx`. -/
@[ext]
theorem hom_ext {N : Type*} [AddCommGroup N] [Module C N] {σ : B →+* C}
    {f g : PDKaehlerDifferential R δ →ₛₗ[σ] N}
    (h : ∀ x, f (d R δ x) = g (d R δ x)) : f = g :=
  LinearMap.ext_on (span_range_d R δ) (by rintro _ ⟨x, rfl⟩; exact h x)

/-- The linear map corresponding to a divided power derivation. -/
def lift {θ : Derivation R B M} (hθ : θ.IsPD δ) : PDKaehlerDifferential R δ →ₗ[B] M :=
  (relations R δ).liftQ θ.liftKaehlerDifferential <| by
    rw [relations_le_ker_iff, θ.liftKaehlerDifferential_comp]
    exact hθ

/-- The universal lift evaluates on the image of an ordinary differential by the ordinary lift. -/
@[simp]
theorem lift_mk {θ : Derivation R B M} (hθ : θ.IsPD δ) (ω : Ω[B⁄R]) :
    lift hθ (Submodule.Quotient.mk ω) = θ.liftKaehlerDifferential ω :=
  (rfl)

/-- The universal lift sends `dx` to the value of the given derivation on `x`. -/
@[simp]
theorem lift_d {θ : Derivation R B M} (hθ : θ.IsPD δ) (x : B) :
    lift hθ (d R δ x) = θ x := by
  rw [← mk_D, lift_mk, Derivation.liftKaehlerDifferential_comp_D]

/-- The universal property of divided power differentials as a linear equivalence. -/
def linearMapEquivDerivation :
    (PDKaehlerDifferential R δ →ₗ[B] M) ≃ₗ[B] δ.derivations R M where
  toFun f := ⟨f.compDer (d R δ), DividedPowers.mem_derivations_iff.mpr <| by
    intro n x hx
    simp only [Derivation.coe_comp, LinearMap.comp_apply, LinearMap.coe_restrictScalars,
      Derivation.coeFn_coe, (isPD_d R δ).apply_dpow_succ n hx, map_smul]⟩
  invFun θ := lift (DividedPowers.mem_derivations_iff.mp θ.property)
  left_inv f := hom_ext fun x ↦ lift_d _ x
  right_inv θ :=
    Subtype.ext (Derivation.ext (lift_d (DividedPowers.mem_derivations_iff.mp θ.property)))
  map_add' _ _ := Subtype.ext (Derivation.ext fun _ ↦ rfl)
  map_smul' _ _ := Subtype.ext (Derivation.ext fun _ ↦ rfl)

/-- The represented derivation evaluates by applying the linear map to `dx`. -/
@[simp]
theorem linearMapEquivDerivation_apply (f : PDKaehlerDifferential R δ →ₗ[B] M) (x : B) :
    (linearMapEquivDerivation f).val x = f (d R δ x) :=
  (rfl)

/-- The inverse of the representing equivalence is the universal lift. -/
@[simp]
theorem linearMapEquivDerivation_symm_apply (θ : δ.derivations R M) :
    linearMapEquivDerivation.symm θ = lift (DividedPowers.mem_derivations_iff.mp θ.property) :=
  (rfl)

section Map

variable {ε : DividedPowers J} {ζ : DividedPowers K} {f : B →ₐ[R] C} {g : C →ₐ[R] E}

/-- A divided power algebra map induces a semilinear map on the PD differentials. -/
noncomputable def map (hf : δ.IsDPMorphism ε f.toRingHom) :
    PDKaehlerDifferential R δ →ₛₗ[f.toRingHom] PDKaehlerDifferential R ε :=
  (relations R δ).mapQ (relations R ε) (KaehlerDifferential.mapSemilinear f) <| by
    rw [relations_le_iff]
    intro n x hx
    have hfx : f x ∈ J := hf.ideal_comp (Ideal.mem_map_of_mem f.toRingHom hx)
    rw [Submodule.mem_comap, map_sub, KaehlerDifferential.mapSemilinear_smul,
      KaehlerDifferential.mapSemilinear_D, KaehlerDifferential.mapSemilinear_D]
    have hd (k : ℕ) : f (δ.dpow k x) = ε.dpow k (f x) := hf.map_dpow hx
    rw [hd, hd]
    exact (relations_le_iff R ε).mp le_rfl n (f x) hfx

/-- The map on PD differentials commutes with the quotient of ordinary differentials. -/
@[simp]
theorem map_mk (hf : δ.IsDPMorphism ε f.toRingHom) (ω : Ω[B⁄R]) :
    map hf (Submodule.Quotient.mk ω) =
      Submodule.Quotient.mk (KaehlerDifferential.mapSemilinear f ω) :=
  (rfl)

/-- The map on PD differentials takes `dx` to `d(f x)`. -/
@[simp]
theorem map_d (hf : δ.IsDPMorphism ε f.toRingHom) (x : B) :
    map hf (d R δ x) = d R ε (f x) := by
  rw [← mk_D, map_mk, KaehlerDifferential.mapSemilinear_D, mk_D]

/-- The identity algebra map induces the identity on PD differentials. -/
@[simp]
theorem map_id (h : δ.IsDPMorphism δ (AlgHom.id R B).toRingHom) :
    (map h : PDKaehlerDifferential R δ →ₗ[B] _) = LinearMap.id :=
  hom_ext fun x ↦ map_d h x

/-- The map on PD differentials respects composition of PD algebra maps. -/
theorem map_comp (hg : ε.IsDPMorphism ζ g.toRingHom) (hf : δ.IsDPMorphism ε f.toRingHom) :
    map (f := g.comp f) (hg.comp ζ hf) = (map hg).comp (map hf) :=
  hom_ext fun x ↦ by
    refine (map_d (f := g.comp f) _ x).trans ?_
    rw [AlgHom.comp_apply, LinearMap.comp_apply, map_d hf, map_d hg]

end Map

/-- The zero PD ideal adds no relations to ordinary Kähler differentials. -/
@[simp]
theorem relations_bot (R B : Type*) [CommRing R] [CommRing B] [Algebra R B] :
    relations R (dividedPowersBot B) = ⊥ := by
  rw [eq_bot_iff, relations_le_iff]
  rintro n x hx
  rw [Ideal.mem_bot] at hx
  subst x
  simp [(dividedPowersBot B).dpow_eval_zero (Nat.succ_ne_zero n)]

/-- For the zero divided power ideal the PD differentials are the ordinary ones. -/
def botEquiv (R B : Type*) [CommRing R] [CommRing B] [Algebra R B] :
    PDKaehlerDifferential R (dividedPowersBot B) ≃ₗ[B] Ω[B⁄R] :=
  Submodule.quotEquivOfEqBot _ (relations_bot R B)

/-- The identification at the zero ideal sends the PD derivation to the ordinary derivation. -/
@[simp]
theorem botEquiv_d (R B : Type*) [CommRing R] [CommRing B] [Algebra R B] (x : B) :
    botEquiv R B (d R (dividedPowersBot B) x) = D R B x :=
  Submodule.quotEquivOfEqBot_apply_mk _ (relations_bot R B) _

end PDKaehlerDifferential
end TauCeti
