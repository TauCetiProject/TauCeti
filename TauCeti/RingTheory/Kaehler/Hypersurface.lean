module

public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.TensorProduct.Free
public import TauCeti.RingTheory.FittingIdeal.Content

/-!
# The differentials of a hypersurface

Let `P` be a `K`-algebra whose module of differentials `Ω[P⁄K]` is free with a finite basis `b`
indexed by `ι`, for instance a polynomial ring, or a localization of a smooth algebra on which
`Ω` is free. For `f ∈ P`, the differentials of the hypersurface `A = P ⧸ (f)` are the quotient of
`A ⊗[P] Ω[P⁄K] ≅ Aⁿ`, where `n = |ι|`, by the single relation `1 ⊗ df`. Their
`(n - 1)`-st Fitting ideal is therefore generated by the coordinates of `df`, the partial
derivatives of `f` with respect to the dual basis. The results here are purely algebraic. When
`P` is smooth of relative dimension `n` over a field `K` and `f` is a nonzero-divisor, so that
`A` has relative dimension `n - 1`, this Fitting ideal cuts out the singular locus of `A`, and
for `n = 2` it is the Jacobian ideal `(f, ∂f/∂s, ∂f/∂t)` of a plane curve singularity, read
in `A`.

## Main results

* `TauCeti.ker_mapBaseChange_quotient_span`: for an ideal `(s)` of `P`, the kernel of
  `(P ⧸ (s)) ⊗[P] Ω[P⁄K] → Ω[(P ⧸ (s))⁄K]` is generated by the `1 ⊗ dg` for `g ∈ s`; for
  `A = P ⧸ (f)` it is generated by `1 ⊗ df`.
* `TauCeti.exists_basis_kaehlerDifferential_quotient`: if the differentials of `z : κ₁ ⊕ κ₂ → P`
  form a basis of `Ω[P⁄K]`, then those of the `z (inr j)` form a basis of the differentials of
  `P ⧸ (z (inl i) : i ∈ κ₁)`.
* `TauCeti.fittingIdeal_kaehlerDifferential_quotient_span_singleton`: the `(n - 1)`-st Fitting
  ideal of `Ω[A⁄K]` is generated by the images of the coordinates of `df`.

## References

* [Stacks Project, Tag 00RU](https://stacks.math.columbia.edu/tag/00RU): the conormal sequence
  for a quotient, here Mathlib's `KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange`.
* [Stacks Project, Tag 07Z6](https://stacks.math.columbia.edu/tag/07Z6): Fitting ideals.
-/

public section

noncomputable section

open KaehlerDifferential TensorProduct

namespace TauCeti

variable {K P : Type*} [CommRing K] [CommRing P] [Algebra K P]

/-- The differentials of `P ⧸ (s)` are those of `P`, restricted to `P ⧸ (s)`, modulo the
differentials of the generators: the kernel of `(P ⧸ (s)) ⊗[P] Ω[P⁄K] → Ω[(P ⧸ (s))⁄K]` is
generated by the elements `1 ⊗ dg` for `g ∈ s`. -/
theorem ker_mapBaseChange_quotient_span (s : Set P) :
    LinearMap.ker (mapBaseChange K P (P ⧸ Ideal.span s)) =
      Submodule.span (P ⧸ Ideal.span s)
        ((fun g ↦ (1 : P ⧸ Ideal.span s) ⊗ₜ[P] D K P g) '' s) := by
  set A := P ⧸ Ideal.span s
  have hsurj : Function.Surjective (algebraMap P A) := Ideal.Quotient.mk_surjective
  -- For `g ∈ (s)`, `1 ⊗ dg` lies in the span, since `d(r g) = r dg` in `A`.
  have key (g : P) (hg : g ∈ Ideal.span s) :
      (1 : A) ⊗ₜ[P] D K P g ∈ Submodule.span A ((fun g ↦ (1 : A) ⊗ₜ[P] D K P g) '' s) := by
    induction hg using Submodule.span_induction with
    | mem g hg => exact Submodule.subset_span ⟨g, hg, rfl⟩
    | zero => simp
    | add g h _ _ hg hh => rw [map_add, tmul_add]; exact add_mem hg hh
    | smul r g hg' hg =>
      have hg0 : g • (1 : A) = 0 := by
        simpa [A, Algebra.smul_def, Ideal.Quotient.eq_zero_iff_mem] using hg'
      simpa [Derivation.leibniz, tmul_add, smul_tmul', hg0] using
        Submodule.smul_mem _ (algebraMap P A r) hg
  refine le_antisymm (fun y hy ↦ ?_) ?_
  · -- By the conormal sequence, `y = 1 ⊗ dg` for some `g ∈ (s)`.
    have hy' : y ∈ (LinearMap.ker (mapBaseChange K P A)).restrictScalars P := hy
    rw [← range_kerCotangentToTensor K P A hsurj] at hy'
    obtain ⟨z, rfl⟩ := hy'
    obtain ⟨⟨g, hg⟩, rfl⟩ := Ideal.toCotangent_surjective _ z
    rw [kerCotangentToTensor_toCotangent]
    exact key g (Ideal.Quotient.eq_zero_iff_mem.1 hg)
  · rw [Submodule.span_le, Set.image_subset_iff]
    intro g hg
    simp [Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span hg)]

/-- **Quotient by some coordinates.** If the differentials of `z : κ₁ ⊕ κ₂ → P` form a basis of
`Ω[P⁄K]`, then the differentials of the remaining elements `z (inr j)` form a basis of the
differentials of `P ⧸ (z (inl i) : i ∈ κ₁)`. -/
theorem exists_basis_kaehlerDifferential_quotient {κ₁ κ₂ : Type*}
    (b : Module.Basis (κ₁ ⊕ κ₂) P Ω[P⁄K]) {z : κ₁ ⊕ κ₂ → P} (hb : ∀ k, b k = D K P (z k)) :
    ∃ b' : Module.Basis κ₂ (P ⧸ Ideal.span (Set.range (z ∘ Sum.inl)))
        Ω[(P ⧸ Ideal.span (Set.range (z ∘ Sum.inl)))⁄K],
      ∀ j, b' j = D K _ (Ideal.Quotient.mk _ (z (.inr j))) := by
  classical
  set J := Ideal.span (Set.range (z ∘ Sum.inl))
  set v : κ₂ → Ω[(P ⧸ J)⁄K] := fun j ↦ D K _ (Ideal.Quotient.mk J (z (.inr j)))
  -- The coordinate derivations along the remaining coordinates preserve `J`.
  have hJ (j : κ₂) (a : P) (ha : a ∈ J) : (b.coord (.inr j)).compDer (D K P) a ∈ J := by
    induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨i, rfl⟩ := ha
      simp [← hb]
    | zero => simp
    | add a a' _ _ h h' => simpa using add_mem h h'
    | smul r a ha h =>
      rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact add_mem (Ideal.mul_mem_left _ _ h) (Ideal.mul_mem_right _ _ ha)
  have hd (j : κ₂) (a : P) (ha : Ideal.Quotient.mkₐ K J a = 0) :
      Ideal.Quotient.mkₐ K J ((b.coord (.inr j)).compDer (D K P) a) = 0 := by
    simp only [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at ha ⊢
    exact hJ j a ha
  -- They descend to derivations of `P ⧸ J`, dual to the differentials of the remaining `z`.
  let δ (j : κ₂) : Derivation K (P ⧸ J) (P ⧸ J) :=
    Derivation.liftOfSurjective (Ideal.Quotient.mkₐ_surjective K J) (hd j)
  have hδ (j : κ₂) (k : κ₁ ⊕ κ₂) :
      (δ j).liftKaehlerDifferential (D K _ (Ideal.Quotient.mk J (z k))) =
        if k = .inr j then 1 else 0 := by
    rw [Derivation.liftKaehlerDifferential_comp_D, ← Ideal.Quotient.mkₐ_eq_mk K]
    simp only [δ]
    rw [Derivation.liftOfSurjective_apply]
    simp [← hb, Finsupp.single_apply]
  have hli : LinearIndependent (P ⧸ J) v := by
    rw [linearIndependent_iff']
    intro s c hc j hj
    have := congrArg (δ j).liftKaehlerDifferential hc
    simp only [map_sum, map_smul, v, hδ, Sum.inr.injEq, smul_eq_mul, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq', hj, ite_true, map_zero] at this
    exact this
  have hsp : ⊤ ≤ Submodule.span (P ⧸ J) (Set.range v) := by
    rw [← span_range_derivation, Submodule.span_le]
    rintro _ ⟨p, rfl⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective p
    have ha : D K P a ∈ Submodule.span P (Set.range b) := b.mem_span _
    have hmap : ∀ ω ∈ Submodule.span P (Set.range b),
        map K K P (P ⧸ J) ω ∈ (Submodule.span (P ⧸ J) (Set.range v)).restrictScalars P := by
      intro ω hω
      induction hω using Submodule.span_induction with
      | mem ω hω =>
        obtain ⟨k, rfl⟩ := hω
        rw [hb, map_D]
        rcases k with i | j
        · have hz : Ideal.Quotient.mk J (z (.inl i)) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨i, rfl⟩)
          simp [Ideal.Quotient.algebraMap_eq, hz]
        · exact Submodule.subset_span ⟨j, rfl⟩
      | zero => simp
      | add ω ω' _ _ h h' => simpa using add_mem h h'
      | smul r ω _ h => simpa using Submodule.smul_of_tower_mem _ r h
    simpa [map_D, Ideal.Quotient.algebraMap_eq] using hmap _ ha
  exact ⟨Module.Basis.mk hli hsp, fun j ↦ Module.Basis.mk_apply _ _ _⟩

variable {ι : Type*} [Fintype ι] [Nonempty ι]

/-- **The Fitting ideal of the differentials of a hypersurface.** If `Ω[P⁄K]` has a basis `b`
indexed by `ι`, the `(|ι| - 1)`-st Fitting ideal of the differentials of `P ⧸ (f)` is generated by
the images of the coordinates of `df` in `b`, the partial derivatives of `f`. -/
theorem fittingIdeal_kaehlerDifferential_quotient_span_singleton (f : P)
    [Module.Finite (P ⧸ Ideal.span {f}) Ω[(P ⧸ Ideal.span {f})⁄K]] (b : Module.Basis ι P Ω[P⁄K]) :
    fittingIdeal (P ⧸ Ideal.span {f}) Ω[(P ⧸ Ideal.span {f})⁄K] (Fintype.card ι - 1) =
      (Ideal.span (Set.range fun i ↦ b.coord i (D K P f))).map (Ideal.Quotient.mk _) := by
  nontriviality P ⧸ Ideal.span {f}
  let bA := Algebra.TensorProduct.basis (P ⧸ Ideal.span {f}) b
  have : Module.Free (P ⧸ Ideal.span {f}) ((P ⧸ Ideal.span {f}) ⊗[P] Ω[P⁄K]) := .of_basis bA
  have : Module.Finite (P ⧸ Ideal.span {f}) ((P ⧸ Ideal.span {f}) ⊗[P] Ω[P⁄K]) := .of_basis bA
  rw [fittingIdeal_eq_minorsIdeal_ker
      (mapBaseChange_surjective K P _ Ideal.Quotient.mk_surjective),
    ker_mapBaseChange_quotient_span, Set.image_singleton, Module.finrank_eq_card_basis bA,
    Nat.sub_sub_self Fintype.card_pos, Submodule.minorsIdeal_one_span_singleton bA,
    Ideal.map_span, ← Set.range_comp]
  congr 2
  ext i
  simp [bA, Algebra.TensorProduct.basis_repr_tmul, Ideal.Quotient.algebraMap_eq]

end TauCeti
