module

public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.TensorProduct.Free
public import TauCeti.RingTheory.FittingIdeal.Content

/-!
# The differentials of a hypersurface

Let `P` be a `K`-algebra whose module of differentials `Ω[P⁄K]` is free with a finite basis `b`
indexed by `ι`, for instance a polynomial ring, or a localization of a smooth algebra on which
`Ω` is free. For `f ∈ P`, the differentials of the hypersurface `A = P ⧸ (f)` are the quotient of
`A ⊗[P] Ω[P⁄K] ≅ Aⁿ`, where `n = |ι|`, by the single relation `1 ⊗ df`. Their
`(n - 1)`-st Fitting ideal is therefore generated by the coordinates of `df`, the partial
derivatives of `f` with respect to the dual basis. This is the ideal cutting out the singular
locus of a hypersurface of relative dimension `n - 1`, and for `n = 2` it is the Jacobian ideal
`(f, ∂f/∂s, ∂f/∂t)` of a plane curve singularity, read in `A`.

## Main results

* `TauCeti.ker_mapBaseChange_quotient_span_singleton`: the kernel of
  `A ⊗[P] Ω[P⁄K] → Ω[A⁄K]` is generated by `1 ⊗ df`.
* `TauCeti.fittingIdeal_kaehlerDifferential_quotient_span_singleton`: the `(n - 1)`-st Fitting
  ideal of `Ω[A⁄K]` is generated by the images of the coordinates of `df`.

## References

* [Stacks Project, Tag 00RU](https://stacks.math.columbia.edu/tag/00RU): the conormal sequence
  for a quotient, here Mathlib's `KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange`.
* [Stacks Project, Tag 07Z6](https://stacks.math.columbia.edu/tag/07Z6): Fitting ideals.
-/

public section

noncomputable section

open KaehlerDifferential TensorProduct

namespace TauCeti

variable {K P : Type*} [CommRing K] [CommRing P] [Algebra K P] (f : P)

/-- The differentials of `P ⧸ (f)` are those of `P`, restricted to `P ⧸ (f)`, modulo `df`: the
kernel of `(P ⧸ (f)) ⊗[P] Ω[P⁄K] → Ω[(P ⧸ (f))⁄K]` is generated by `1 ⊗ df`. -/
theorem ker_mapBaseChange_quotient_span_singleton :
    LinearMap.ker (mapBaseChange K P (P ⧸ Ideal.span {f})) =
      (P ⧸ Ideal.span {f}) ∙ ((1 : P ⧸ Ideal.span {f}) ⊗ₜ[P] D K P f) := by
  set A := P ⧸ Ideal.span {f}
  have hsurj : Function.Surjective (algebraMap P A) := Ideal.Quotient.mk_surjective
  refine le_antisymm (fun y hy ↦ ?_) ?_
  · -- By the conormal sequence, `y = 1 ⊗ dg` for some `g = r f ∈ (f)`, and `d(r f) = r df` in `A`.
    have hy' : y ∈ (LinearMap.ker (mapBaseChange K P A)).restrictScalars P := hy
    rw [← range_kerCotangentToTensor K P A hsurj] at hy'
    obtain ⟨z, rfl⟩ := hy'
    obtain ⟨⟨g, hg⟩, rfl⟩ := Ideal.toCotangent_surjective _ z
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.1 (Ideal.Quotient.eq_zero_iff_mem.1 hg)
    refine Submodule.mem_span_singleton.2 ⟨algebraMap P A r, ?_⟩
    have hf0 : f • (1 : A) = 0 := by
      rw [Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton_self f
    rw [kerCotangentToTensor_toCotangent, Derivation.leibniz, tmul_add, tmul_smul, tmul_smul,
      algebraMap_smul, smul_tmul' f (1 : A), hf0, zero_tmul, add_zero]
  · rw [Submodule.span_le, Set.singleton_subset_iff, SetLike.mem_coe, LinearMap.mem_ker,
      mapBaseChange_tmul, map_D, one_smul, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton_self f), map_zero]

variable {ι : Type*} [Fintype ι] [Nonempty ι]

/-- **The Fitting ideal of the differentials of a hypersurface.** If `Ω[P⁄K]` has a basis `b`
indexed by `ι`, the `(|ι| - 1)`-st Fitting ideal of the differentials of `P ⧸ (f)` is generated by
the images of the coordinates of `df` in `b`, the partial derivatives of `f`. -/
theorem fittingIdeal_kaehlerDifferential_quotient_span_singleton
    [Module.Finite (P ⧸ Ideal.span {f}) Ω[(P ⧸ Ideal.span {f})⁄K]] (b : Module.Basis ι P Ω[P⁄K]) :
    fittingIdeal (P ⧸ Ideal.span {f}) Ω[(P ⧸ Ideal.span {f})⁄K] (Fintype.card ι - 1) =
      (Ideal.span (Set.range fun i ↦ b.coord i (D K P f))).map (Ideal.Quotient.mk _) := by
  nontriviality P ⧸ Ideal.span {f}
  let bA := Algebra.TensorProduct.basis (P ⧸ Ideal.span {f}) b
  have : Module.Free (P ⧸ Ideal.span {f}) ((P ⧸ Ideal.span {f}) ⊗[P] Ω[P⁄K]) := .of_basis bA
  have : Module.Finite (P ⧸ Ideal.span {f}) ((P ⧸ Ideal.span {f}) ⊗[P] Ω[P⁄K]) := .of_basis bA
  rw [fittingIdeal_eq_minorsIdeal_ker
      (mapBaseChange_surjective K P _ Ideal.Quotient.mk_surjective),
    ker_mapBaseChange_quotient_span_singleton, Module.finrank_eq_card_basis bA,
    Nat.sub_sub_self Fintype.card_pos, Submodule.minorsIdeal_one_span_singleton bA,
    Ideal.map_span, ← Set.range_comp]
  congr 2
  ext i
  simp [bA, Algebra.TensorProduct.basis_repr_tmul, Ideal.Quotient.algebraMap_eq]

end TauCeti
