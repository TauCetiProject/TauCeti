/-!
# The Kähler different of a monogenic algebra

For a polynomial `f` over a commutative ring `R`, the differentials of `R[X] ⧸ (f)` are the
quotient of the free module `R[X] ⧸ (f) · dX` by the single relation `f'(X) dX = 0`. Their zeroth
Fitting ideal, the *Kähler different* of `R[X] ⧸ (f)` over `R`, is therefore the principal ideal
generated by `f'` evaluated at the root:

`Fitt₀(Ω[AdjoinRoot f⁄R]) = (f'(root f))`.

When `R` is an integrally closed domain and `S` is a torsion-free domain generated over `R` by a
single integral element `x`, then `S ≅ R[X] ⧸ (minpoly R x)`, so the Kähler different of `S / R`
is generated by `(minpoly R x)'(x)`. On the Dedekind side this is also a generator of the
trace-dual different (`TauCeti.differentIdeal_eq_span_aeval_derivative_minpoly`); the two
differents are compared in `TauCeti.RingTheory.DedekindDomain.Different.Kaehler`.

## Main results

* `AdjoinRoot.fittingIdeal_kaehlerDifferential_zero`: `Fitt₀(Ω[AdjoinRoot f⁄R]) = (f'(root f))`.
* `TauCeti.fittingIdeal_kaehlerDifferential_zero_of_adjoin_eq_top`: for `S = R[x]` with `x`
  integral over an integrally closed domain `R`, `Fitt₀(Ω[S⁄R]) = ((minpoly R x)'(x))`.

## References

* [Stacks Project, Tag 0BVH](https://stacks.math.columbia.edu/tag/0BVH): the Kähler different.
* J.-P. Serre, *Local Fields*, Chapter III, §6, Corollary 2 of Proposition 11.
-/

public section

open Polynomial KaehlerDifferential TauCeti

namespace AdjoinRoot

variable {R : Type*} [CommRing R]

/-- **The Kähler different of `R[X] ⧸ (f)`**: the zeroth Fitting ideal of the differentials of
`AdjoinRoot f` over `R` is generated by the derivative of `f` evaluated at the root. -/
theorem fittingIdeal_kaehlerDifferential_zero (f : R[X]) :
    fittingIdeal (AdjoinRoot f) Ω[AdjoinRoot f⁄R] 0 =
      Ideal.span {aeval (root f) (derivative f)} := by
  -- `Ω[R[X]⁄R]` is free on `dX`, and the coordinate of `df` is `f'`.
  let b : Module.Basis Unit R[X] Ω[R[X]⁄R] :=
    (Module.Basis.singleton Unit R[X]).map (polynomialEquiv R).symm
  have hb : b.coord () (D R R[X] f) = derivative f := by
    simp [b, Module.Basis.coord_apply, polynomialEquiv_D]
  -- `AdjoinRoot f` is by definition the hypersurface `R[X] ⧸ (f)`.
  have h := TauCeti.fittingIdeal_kaehlerDifferential_quotient_span_singleton f b
  rw [Fintype.card_unit, Nat.sub_self, Set.range_unique, PUnit.default_eq_unit, hb, Ideal.map_span,
    Set.image_singleton] at h
  rw [aeval_eq]
  exact h

end AdjoinRoot

namespace TauCeti

variable {R S : Type*} [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing S] [IsDomain S]
  [Algebra R S] [Module.IsTorsionFree R S] [Module.Finite S Ω[S⁄R]]

/-- **The Kähler different of a monogenic extension.** If `S` is generated over the integrally
closed domain `R` by a single integral element `x`, the zeroth Fitting ideal of `Ω[S⁄R]` is
generated by `f'(x)`, where `f` is the minimal polynomial of `x`. -/
theorem fittingIdeal_kaehlerDifferential_zero_of_adjoin_eq_top {x : S} (hx : IsIntegral R x)
    (hadj : Algebra.adjoin R {x} = ⊤) :
    fittingIdeal S Ω[S⁄R] 0 = Ideal.span {aeval x (derivative (minpoly R x))} := by
  -- `S ≃ R[X] ⧸ (minpoly R x)`, sending the root to `x`.
  let e : AdjoinRoot (minpoly R x) ≃ₐ[R] S :=
    (minpoly.equivAdjoin hx).trans ((Subalgebra.equivOfEq _ _ hadj).trans Subalgebra.topEquiv)
  have he : e (AdjoinRoot.root (minpoly R x)) = x := by simp [e]
  rw [fittingIdeal_kaehlerDifferential_eq_map_algEquiv e,
    AdjoinRoot.fittingIdeal_kaehlerDifferential_zero, Ideal.map_span, Set.image_singleton]
  congr 2
  rw [← aeval_algHom_apply, he]

end TauCeti
