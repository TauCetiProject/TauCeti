/-!
# The conormal sequence of a formally smooth quotient

Let `P → S` be a surjection of `R`-algebras with kernel `I`. The conormal sequence

`I/I² → S ⊗[P] Ω[P⁄R] → Ω[S⁄R] → 0`

is exact (`KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange`). If `S` is formally
smooth over `R`, the identity of `S` lifts along the square-zero extension `P/I² → S`, and such a
section is the same as a retraction of `I/I² → S ⊗[P] Ω[P⁄R]`
(`retractionKerCotangentToTensorEquivSection`). So the first map is injective, and the sequence is
exact on the left as well. If `S` is moreover formally unramified, then `Ω[S⁄R] = 0` and the
conormal module `I/I²` is identified with `S ⊗[P] Ω[P⁄R]`.

Formal unramifiedness alone gives the surjectivity half: if `P ⧸ I` is formally unramified over
`R`, then `Ω[P⁄R]` is generated by the differentials `da`, `a ∈ I`, modulo `I • Ω[P⁄R]`.
Equivalently, for an ideal `J` of `P` with `P ⧸ J` formally unramified over `R`, for instance the
kernel of a section `P → R ⧸ I` of `Spec P → Spec R` over `V(I)`, every class in
`Ω[P⁄R] ⧸ J • Ω[P⁄R]` is the class of `D x` for some `x ∈ J`.

For a closed point of a scheme over a field whose residue field `κ` is a finite separable extension
of the base, `κ` is étale (formally smooth and formally unramified) over the base, so the conormal
map is an isomorphism (`kerCotangentToTensor_bijective_of_formallyEtale`), identifying the Zariski
cotangent space `𝔪/𝔪²` with the fibre of the differentials. In particular, at a `k`-point of any
`k`-algebra, with no Noetherian hypothesis, the residue field is `k` and `𝔪/𝔪² → κ ⊗[R] Ω[R⁄k]` is
bijective for the local ring `R` at that point. More generally, when `κ` is merely formally smooth
over `k` (for example, separable without being finite), the conormal map is injective
(`kerCotangentToTensor_injective_of_formallySmooth`), so the differentials `1 ⊗ d t_j` of any
minimal generating set of `𝔪_A` are `κ`-linearly independent in `κ ⊗[A] Ω[A⁄k]`.

## Main results

* `KaehlerDifferential.kerCotangentToTensor_injective_of_formallySmooth`: the conormal map
  `I/I² → S ⊗[P] Ω[P⁄R]` is injective when `S` is formally smooth over `R`.
* `KaehlerDifferential.kerCotangentToTensor_bijective_of_formallyEtale`: it is bijective when `S`
  is formally étale over `R`.
* `KaehlerDifferential.linearIndependent_tmul_D`: when the residue field `κ` of a local
  `k`-algebra `A` is formally smooth over `k`, the differentials `1 ⊗ d t_j` of a minimal
  generating set of `𝔪_A` are `κ`-linearly independent in `κ ⊗[A] Ω[A⁄k]`.
* `KaehlerDifferential.span_D_image_sup_eq_top`: if `P ⧸ I` is formally unramified over `R`, the
  `da` for `a ∈ I` generate `Ω[P⁄R]` modulo `I • Ω[P⁄R]`.
* `KaehlerDifferential.exists_mem_and_mk_D_eq`: if `P ⧸ J` is formally unramified over `R`, every
  class in `Ω[P⁄R] ⧸ J • Ω[P⁄R]` is the class of `D x` for some `x ∈ J`.
* `AlgHom.kerCotangentToTensor_residueField_bijective`: for the local ring `R` of a `k`-algebra at
  the kernel of a `k`-point, the conormal map `𝔪/𝔪² → κ ⊗[R] Ω[R⁄k]` is bijective.

## References

* [Stacks Project, Tag 031I](https://stacks.math.columbia.edu/tag/031I): a quotient `P/I` is
  formally smooth exactly when the conormal sequence is split exact on the left, given `P`
  formally smooth. Only the implication from formal smoothness to injectivity is used here, and it
  needs no hypothesis on `P`.
-/

public section

noncomputable section

open Function IsLocalRing Submodule TensorProduct

namespace KaehlerDifferential

variable {R P S : Type*} [CommRing R] [CommRing P] [CommRing S] [Algebra R P] [Algebra P S]
  [Algebra R S] [IsScalarTower R P S]

/-- For a surjection `P → S` with kernel `I` onto a formally smooth `R`-algebra, the conormal map
`I/I² → S ⊗[P] Ω[P⁄R]` is injective. -/
theorem kerCotangentToTensor_injective_of_formallySmooth [Algebra.FormallySmooth R S]
    (hf : Surjective (algebraMap P S)) :
    Injective (kerCotangentToTensor R P S) := by
  let f := IsScalarTower.toAlgHom R P S
  -- The kernel of `P/I² → S` is `I/I²`, which squares to zero.
  have hnil : IsNilpotent (RingHom.ker f.kerSquareLift) :=
    ⟨2, (congrArg (· ^ 2) f.ker_kerSquareLift).trans (Ideal.cotangentIdeal_square _)⟩
  have hsurj : Surjective f.kerSquareLift := by
    intro s
    obtain ⟨p, rfl⟩ := hf s
    exact ⟨Ideal.Quotient.mk _ p, rfl⟩
  -- Formal smoothness lifts the identity of `S` to a section of `P/I² → S`.
  let g := Algebra.FormallySmooth.liftOfSurjective (AlgHom.id R S) f.kerSquareLift hsurj hnil
  have hg : f.kerSquareLift.comp g = AlgHom.id R S :=
    AlgHom.ext <| Algebra.FormallySmooth.liftOfSurjective_apply _ _ hsurj hnil
  -- A section gives a retraction of the conormal map.
  obtain ⟨l, hl⟩ := (retractionKerCotangentToTensorEquivSection (R := R) hf).symm ⟨g, hg⟩
  exact LeftInverse.injective (g := l) fun x ↦ congr($hl x)

/-- For a surjection `P → S` with kernel `I` onto a formally étale `R`-algebra, the conormal map
`I/I² → S ⊗[P] Ω[P⁄R]` is bijective. -/
theorem kerCotangentToTensor_bijective_of_formallyEtale [Algebra.FormallyEtale R S]
    (hf : Surjective (algebraMap P S)) :
    Bijective (kerCotangentToTensor R P S) := by
  refine ⟨kerCotangentToTensor_injective_of_formallySmooth hf, fun x ↦ ?_⟩
  exact (exact_kerCotangentToTensor_mapBaseChange R P S hf x).1 (Subsingleton.elim _ _)

/-- For a minimal system of generators `t : Fin r → A` of the maximal ideal of a local ring `A`
whose residue field `κ` is formally smooth over `k`, the tensors `1 ⊗ d(t j)` are `κ`-linearly
independent in `κ ⊗[A] Ω[A⁄k]`. -/
theorem linearIndependent_tmul_D {k A : Type*} [CommRing k] [CommRing A] [Algebra k A]
    [IsLocalRing A] [Algebra.FormallySmooth k (ResidueField A)]
    {r : ℕ} {t : Fin r → A} (ht : Ideal.span (Set.range t) = maximalIdeal A)
    (hr : (maximalIdeal A).spanFinrank = r) :
    LinearIndependent (ResidueField A)
      (fun j : Fin r ↦ (1 : ResidueField A) ⊗ₜ[A] KaehlerDifferential.D k A (t j)) := by
  set κ := ResidueField A
  have hker : RingHom.ker (algebraMap A κ) = maximalIdeal A := by
    rw [ResidueField.algebraMap_eq, ker_residue]
  have hsurj : Function.Surjective (algebraMap A κ) := by
    rw [ResidueField.algebraMap_eq]
    exact residue_surjective
  have hinj := kerCotangentToTensor_injective_of_formallySmooth (R := k) (P := A) (S := κ) hsurj
  let e := Ideal.Cotangent.equivOfEq (maximalIdeal A) (RingHom.ker (algebraMap A κ)) hker.symm
  let φ : (maximalIdeal A).Cotangent →ₗ[κ] κ ⊗[A] Ω[A⁄k] :=
    (kerCotangentToTensor k A κ ∘ₗ e.toLinearMap).extendScalarsOfSurjective hsurj
  have hli := (TauCeti.IsLocalRing.linearIndependent_toCotangent ht hr).map' φ
    (LinearMap.ker_eq_bot.mpr (hinj.comp e.injective))
  have hφ (j : Fin r) :
      φ ((maximalIdeal A).toCotangent ⟨t j, ht ▸ Ideal.subset_span ⟨j, rfl⟩⟩) =
        (1 : κ) ⊗ₜ[A] KaehlerDifferential.D k A (t j) := by
    simp [φ, e]
  convert hli using 1
  ext j
  exact (hφ j).symm

/-- If `P ⧸ I` is formally unramified over `R`, then `Ω[P⁄R]` is generated by the differentials `da`
of elements `a ∈ I`, modulo `I • Ω[P⁄R]`. This is the surjectivity of the conormal map
`I/I² → (P ⧸ I) ⊗[P] Ω[P⁄R]`. -/
theorem span_D_image_sup_eq_top (I : Ideal P) [Algebra.FormallyUnramified R (P ⧸ I)] :
    span P (D R P '' I) ⊔ I • (⊤ : Submodule P Ω[P⁄R]) = ⊤ := by
  refine eq_top_iff.2 fun ω _ ↦ ?_
  -- `1 ⊗ ω` is in the range of the conormal map, since `Ω[(P ⧸ I)⁄R] = 0`.
  obtain ⟨c, hc⟩ := (exact_kerCotangentToTensor_mapBaseChange R P (P ⧸ I)
    Ideal.Quotient.mk_surjective ((1 : P ⧸ I) ⊗ₜ ω)).1 (Subsingleton.elim _ _)
  obtain ⟨⟨a, ha⟩, rfl⟩ := Ideal.toCotangent_surjective _ c
  rw [kerCotangentToTensor_toCotangent] at hc
  rw [Ideal.Quotient.algebraMap_eq, Ideal.mk_ker] at ha
  have hω : ω - D R P a ∈ I • (⊤ : Submodule P Ω[P⁄R]) := by
    rw [← LinearMap.ker_tensorProductMk, LinearMap.mem_ker, map_sub, sub_eq_zero,
      TensorProduct.mk_apply, TensorProduct.mk_apply, hc]
  rw [← sub_add_cancel ω (D R P a)]
  exact add_mem (mem_sup_right hω) (mem_sup_left (subset_span ⟨a, ha, rfl⟩))

/-- If `P ⧸ J` is formally unramified over `R`, then every class in `Ω[P⁄R] ⧸ J • Ω[P⁄R]` is the
class of the differential of an element of `J`: the conormal map `J/J² → (P ⧸ J) ⊗[P] Ω[P⁄R]` is
surjective, as `Ω[(P ⧸ J)⁄R] = 0`. -/
theorem exists_mem_and_mk_D_eq (J : Ideal P) [Algebra.FormallyUnramified R (P ⧸ J)]
    (q : Ω[P⁄R] ⧸ J • (⊤ : Submodule P Ω[P⁄R])) :
    ∃ x ∈ J, Submodule.Quotient.mk (D R P x) = q := by
  obtain ⟨y, hy⟩ := (exact_kerCotangentToTensor_mapBaseChange R P (P ⧸ J)
    Ideal.Quotient.mk_surjective ((TensorProduct.quotTensorEquivQuotSMul _ J).symm q)).mp
    (Subsingleton.elim _ _)
  obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective _ y
  refine ⟨x, by simpa using hx, ?_⟩
  rwa [kerCotangentToTensor_toCotangent, LinearEquiv.eq_symm_apply,
    TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul] at hy

end KaehlerDifferential

namespace AlgHom

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A] (point : A →ₐ[k] k)

attribute [local instance] RingHom.ker_isPrime

/-- The residue field of a `k`-algebra at the kernel of a `k`-point is formally étale over `k`,
being `k` itself. -/
instance formallyEtale_residueField_ker :
    Algebra.FormallyEtale k (RingHom.ker point).ResidueField :=
  .of_equiv (AlgEquiv.ofBijective (Algebra.ofId k _) point.algebraMap_residueField_bijective)

/-- **The conormal map at a rational point is bijective.** For the local ring `R` of a
`k`-algebra at the kernel of a `k`-point, `𝔪/𝔪² → κ ⊗[R] Ω[R⁄k]` is bijective, with no Noetherian
hypothesis. -/
theorem kerCotangentToTensor_residueField_bijective :
    Bijective (KaehlerDifferential.kerCotangentToTensor k
      (Localization.AtPrime (RingHom.ker point)) (RingHom.ker point).ResidueField) :=
  KaehlerDifferential.kerCotangentToTensor_bijective_of_formallyEtale IsLocalRing.residue_surjective

end AlgHom
