/-!
# γ-operations and the γ-filtration

For a pre-λ structure `Λ` on a commutative ring `R`, the *γ-operations* are obtained from the
λ-operations by the substitution `t ↦ t / (1 - t)` in the total operation:

```text
γ_t x = λ_{t/(1-t)} x,    γⁿ⁺¹ x = ∑ j ≤ n, (n choose j) λʲ⁺¹ x.
```

Because substitution is a ring homomorphism of power series, `γ_t` again turns sums into
products, so the γ-operations form a pre-λ structure `Λ.gamma` on `R`. The substitution
`t ↦ t / (1 + t)` inverts `t ↦ t / (1 - t)`, so `λ_t x = γ_{t/(1+t)} x` and the λ-operations
can be recovered from the γ-operations. Morphisms of pre-λ structures commute with the
γ-operations. For a line element `l`, `γⁿ l = l` for `n ≥ 1`; if moreover `1` is a line
element, then `l - 1` is a line element of the γ-structure: `γ_t (l - 1) = 1 + (l - 1) t`. On a
binomial ring the γ-operations are the multichoose coefficients, `γⁿ x = multichoose x n`; thus in
`ℤ`, `γ² 3 = 6` while `λ² 3 = 3`.

The γ-operations are the operations adapted to an augmentation ideal: on `K₀` of a scheme, the
classes of rank zero. For an ideal `I` of `R`, the *γ-filtration* `Fⁿ` is the ideal generated by
the products `∏ᵢ γ^{kᵢ} xᵢ` with `xᵢ ∈ I`, every `kᵢ ≥ 1` and `∑ᵢ kᵢ ≥ n`. The empty product is
allowed, so `F⁰ = R`. The filtration is decreasing and multiplicative, `Fᵐ Fⁿ ⊆ Fᵐ⁺ⁿ`, contains
`Iⁿ`, and is natural in morphisms of pre-λ structures. When `I` is a λ-ideal, for instance the
kernel of an augmentation `R → H`, the first step is `F¹ = I`. When `I` is additively generated
by line elements of the γ-structure, as the augmentation ideal of a group ring `ℤ[G]` is
generated by the elements `g - 1`, the γ-filtration is the `I`-adic filtration, `Fⁿ = Iⁿ`.

## Main definitions

* `TauCeti.PreLambdaStructure.gamma`: the γ-operations of a pre-λ structure, as a pre-λ structure.
* `TauCeti.PreLambdaHom.gamma`: a morphism of pre-λ structures is a morphism of their
  γ-structures.
* `TauCeti.PreLambdaStructure.gammaFiltration`: the γ-filtration `Fⁿ` of an ideal.

## Main results

* `TauCeti.PreLambdaStructure.totalSeries_gamma`: `γ_t x = λ_{t/(1-t)} x`.
* `TauCeti.PreLambdaStructure.subst_totalSeries_gamma`: the inverse substitution,
  `γ_{t/(1+t)} x = λ_t x`.
* `TauCeti.PreLambdaStructure.gamma_lambda_succ`: `γⁿ⁺¹ x = ∑ j ≤ n, (n choose j) λʲ⁺¹ x`.
* `TauCeti.PreLambdaStructure.IsLine.totalSeries_gamma`: `γ_t l = 1 + l t / (1 - t)` for a line
  element `l`.
* `TauCeti.PreLambdaStructure.IsLine.isLine_gamma_sub_one`: `γ_t (l - 1) = 1 + (l - 1) t` for
  a line element `l` when `1` is a line element.
* `TauCeti.PreLambdaStructure.binomial_gamma_lambda`: the binomial γ-operations are the
  multichoose coefficients.
* `TauCeti.PreLambdaStructure.gammaFiltration_mul_le`,
  `TauCeti.PreLambdaStructure.gammaFiltration_antitone`,
  `TauCeti.PreLambdaStructure.pow_le_gammaFiltration`: the filtration is multiplicative,
  decreasing and contains the powers of `I`.
* `TauCeti.PreLambdaStructure.gammaFiltration_one`: `F¹ = I` for a λ-ideal `I`.
* `TauCeti.PreLambdaStructure.gammaFiltration_eq_pow`,
  `TauCeti.PreLambdaStructure.gammaFiltration_eq_pow_of_isLine`: if `I` is additively generated
  by line elements of the γ-structure, for instance by elements `l - 1` with `l` and `1` line
  elements, then `Fⁿ = Iⁿ`.
* `TauCeti.PreLambdaStructure.map_gammaFiltration_le`: naturality of the filtration.

## References

* C. A. Weibel, *The K-book*, §II.4, the γ-operations and the γ-filtration.
* M. F. Atiyah and D. O. Tall, *Group representations, λ-rings and the J-homomorphism*,
  Topology 8 (1969), §1.
* W. Fulton and S. Lang, *Riemann–Roch algebra*, Grundlehren 277, Chapter III, §1.
-/

public noncomputable section

open PowerSeries

namespace TauCeti

namespace PreLambdaStructure

variable {R S : Type*} [CommRing R] [CommRing S]
variable (Λ : PreLambdaStructure R)

/-! ### The γ-operations -/

/-- The **γ-operations** of a pre-λ structure, with total operation `γ_t x = λ_{t/(1-t)} x`,
form a pre-λ structure. -/
def gamma : PreLambdaStructure R where
  lambda n x := coeff n ((Λ.totalSeries x).subst (X * PowerSeries.mk 1 : R⟦X⟧))
  lambda_zero x := by
    rw [coeff_subst_eq_sum_range _ (by simp)]
    simp
  lambda_one x := by
    rw [coeff_subst_eq_sum_range _ (by simp), Finset.sum_range_succ, Finset.sum_range_one,
      coeff_succ_X_mul_mk_one_pow_succ 0 0]
    simp
  lambda_add n x y := by
    rw [totalSeries_add, subst_mul hasSubst_X_mul_mk_one, coeff_mul]

/-- The total γ-operation is the total λ-operation substituted at `t / (1 - t)`:
`γ_t x = λ_{t/(1-t)} x`. -/
theorem totalSeries_gamma (x : R) :
    Λ.gamma.totalSeries x = (Λ.totalSeries x).subst (X * PowerSeries.mk 1 : R⟦X⟧) := by
  ext n
  -- `γⁿ x` is by definition the `n`th coefficient of the substituted series
  rw [coeff_totalSeries]
  rfl

/-- The γ-operations in terms of the λ-operations: `γⁿ⁺¹ x = ∑ j ≤ n, (n choose j) λʲ⁺¹ x`. -/
theorem gamma_lambda_succ (n : ℕ) (x : R) :
    Λ.gamma.lambda (n + 1) x =
      ∑ j ∈ Finset.range (n + 1), (n.choose j : R) * Λ.lambda (j + 1) x := by
  rw [← coeff_totalSeries, totalSeries_gamma, coeff_subst_eq_sum_range _ (by simp),
    Finset.sum_range_succ']
  simp [coeff_succ_X_mul_mk_one_pow_succ, mul_comm]

/-- The second γ-operation: `γ² x = x + λ² x`. -/
theorem gamma_lambda_two (x : R) : Λ.gamma.lambda 2 x = x + Λ.lambda 2 x := by
  simp [gamma_lambda_succ, Finset.sum_range_succ]

/-- The substitution `t ↦ t / (1 + t)` undoes `t ↦ t / (1 - t)`: `γ_{t/(1+t)} x = λ_t x`. -/
theorem subst_totalSeries_gamma (x : R) :
    (Λ.gamma.totalSeries x).subst (X * PowerSeries.mk fun n => (-1 : R) ^ n : R⟦X⟧) =
      Λ.totalSeries x := by
  rw [totalSeries_gamma, subst_comp_subst_apply hasSubst_X_mul_mk_one
    hasSubst_X_mul_mk_neg_one_pow, X_mul_mk_one_subst_X_mul_mk_neg_one_pow, X_subst]

/-- Morphisms of pre-λ structures commute with the γ-operations. -/
@[simp]
theorem _root_.TauCeti.PreLambdaHom.map_gamma_lambda {Λ' : PreLambdaStructure S}
    (f : PreLambdaHom Λ Λ') (n : ℕ) (x : R) :
    f (Λ.gamma.lambda n x) = Λ'.gamma.lambda n (f x) := by
  cases n with
  | zero => simp
  | succ n => simp [gamma_lambda_succ, map_sum, f.map_lambda]

/-- A morphism of pre-λ structures, as a morphism of their γ-structures. -/
def _root_.TauCeti.PreLambdaHom.gamma {Λ' : PreLambdaStructure S} (f : PreLambdaHom Λ Λ') :
    PreLambdaHom Λ.gamma Λ'.gamma where
  __ := (f : R →+* S)
  map_lambda' := f.map_gamma_lambda

@[simp]
theorem _root_.TauCeti.PreLambdaHom.coe_gamma {Λ' : PreLambdaStructure S}
    (f : PreLambdaHom Λ Λ') : ⇑f.gamma = f :=
  (rfl)

/-! ### Line elements -/

variable {Λ} in
/-- A line element is fixed by every positive γ-operation: `γⁿ⁺¹ l = l`. -/
theorem IsLine.gamma_lambda_succ {l : R} (h : Λ.IsLine l) (n : ℕ) :
    Λ.gamma.lambda (n + 1) l = l := by
  rw [PreLambdaStructure.gamma_lambda_succ, Finset.sum_eq_single 0]
  · simp
  · intro j _ hj
    rw [h.lambda_eq_zero (by omega), mul_zero]
  · simp

variable {Λ} in
/-- The total γ-operation of a line element `l` is `γ_t l = 1 + l t / (1 - t)`. -/
theorem IsLine.totalSeries_gamma {l : R} (h : Λ.IsLine l) :
    Λ.gamma.totalSeries l = 1 + C l * (X * PowerSeries.mk 1) := by
  have ha := hasSubst_X_mul_mk_one (R := R)
  rw [PreLambdaStructure.totalSeries_gamma, h.totalSeries_eq, subst_add ha, subst_mul ha,
    subst_X ha, subst_one, subst_C, ← PowerSeries.C_apply]

variable {Λ} in
/-- If `l` and `1` are line elements, then `l - 1` is a line element of the γ-structure:
`γ_t (l - 1) = 1 + (l - 1) t`, so `γⁿ (l - 1) = 0` for `n ≥ 2`. -/
theorem IsLine.isLine_gamma_sub_one {l : R} (hl : Λ.IsLine l) (h1 : Λ.IsLine 1) :
    Λ.gamma.IsLine (l - 1) := by
  have hsum := Λ.gamma.totalSeries_add (l - 1) 1
  rw [sub_add_cancel, hl.totalSeries_gamma, h1.totalSeries_gamma, map_one, one_mul] at hsum
  rw [isLine_iff_totalSeries]
  have hm := mk_one_mul_one_sub_eq_one R
  -- multiplying `hsum` by `1 - t` and using `hm : mk 1 * (1 - t) = 1` gives
  -- `γ_t (l - 1) = 1 - t + l t`
  linear_combination (X - 1) * hsum - (Λ.gamma.totalSeries (l - 1) * X - C l * X) * hm -
    X * map_sub C l 1 + X * map_one (C : R →+* R⟦X⟧)

/-! ### The binomial structure -/

/-- On a binomial ring the γ-operations are the multichoose coefficients:
`γⁿ x = multichoose x n`, the coefficients of `γ_t x = (1 - t)⁻ˣ`. -/
@[simp]
theorem binomial_gamma_lambda [BinomialRing R] (n : ℕ) (x : R) :
    (binomial R).gamma.lambda n x = Ring.multichoose x n := by
  cases n with
  | zero => simp
  | succ n =>
    -- Chu–Vandermonde: `(x + n choose n + 1) = ∑ i + j = n + 1, (x choose i) (n choose j)`
    rw [gamma_lambda_succ, Ring.multichoose_eq, Nat.cast_succ, ← add_assoc, add_sub_cancel_right,
      Ring.add_choose_eq _ (Commute.all _ _), Finset.Nat.sum_antidiagonal_succ,
      Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
    simp only [binomial_lambda, Ring.choose_natCast, Ring.choose_zero_right, one_mul,
      Nat.choose_succ_self, Nat.cast_zero, zero_add]
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [Nat.choose_symm (by simpa [Nat.lt_succ_iff] using hj), mul_comm]

/-! ### The γ-filtration -/

/-- The products `∏ᵢ γ^{kᵢ} xᵢ` with `xᵢ ∈ I`, every `kᵢ ≥ 1` and `∑ᵢ kᵢ ≥ n`, generating the
`n`th step of the γ-filtration of `I`. -/
private def gammaGenerators (I : Ideal R) (n : ℕ) : Set R :=
  {r | ∃ l : List (ℕ × R), (∀ p ∈ l, 1 ≤ p.1 ∧ p.2 ∈ I) ∧ n ≤ (l.map Prod.fst).sum ∧
    (l.map fun p => Λ.gamma.lambda p.1 p.2).prod = r}

/-- The **γ-filtration** of an ideal `I`: its `n`th step `Fⁿ` is the ideal generated by the
products `∏ᵢ γ^{kᵢ} xᵢ` with `xᵢ ∈ I`, every `kᵢ ≥ 1` and `∑ᵢ kᵢ ≥ n`. For an augmentation
`ε : R → H`, the γ-filtration of the augmentation is that of `I = ker ε`. -/
def gammaFiltration (I : Ideal R) (n : ℕ) : Ideal R :=
  Ideal.span (Λ.gammaGenerators I n)

variable {Λ} {I J : Ideal R} {n : ℕ}

/-- A product `∏ᵢ γ^{kᵢ} xᵢ` with `xᵢ ∈ I`, every `kᵢ ≥ 1` and `∑ᵢ kᵢ ≥ n` lies in `Fⁿ`. -/
theorem list_prod_mem_gammaFiltration (l : List (ℕ × R)) (hl : ∀ p ∈ l, 1 ≤ p.1 ∧ p.2 ∈ I)
    (hn : n ≤ (l.map Prod.fst).sum) :
    (l.map fun p => Λ.gamma.lambda p.1 p.2).prod ∈ Λ.gammaFiltration I n :=
  Ideal.subset_span ⟨l, hl, hn, rfl⟩

/-- `Fⁿ` is the smallest ideal containing the products `∏ᵢ γ^{kᵢ} xᵢ` with `xᵢ ∈ I`, every
`kᵢ ≥ 1` and `∑ᵢ kᵢ ≥ n`. -/
theorem gammaFiltration_le_iff :
    Λ.gammaFiltration I n ≤ J ↔ ∀ l : List (ℕ × R), (∀ p ∈ l, 1 ≤ p.1 ∧ p.2 ∈ I) →
      n ≤ (l.map Prod.fst).sum → (l.map fun p => Λ.gamma.lambda p.1 p.2).prod ∈ J := by
  rw [gammaFiltration, Ideal.span_le]
  exact ⟨fun h l hl hn => h ⟨l, hl, hn, rfl⟩, fun h _ ⟨l, hl, hn, hr⟩ => hr ▸ h l hl hn⟩

/-- `γᵏ x ∈ Fᵏ` for `x ∈ I`. -/
theorem gamma_lambda_mem_gammaFiltration {x : R} (hx : x ∈ I) (k : ℕ) :
    Λ.gamma.lambda k x ∈ Λ.gammaFiltration I k := by
  rcases k.eq_zero_or_pos with rfl | hk
  · simpa using list_prod_mem_gammaFiltration (Λ := Λ) [] (by simp) le_rfl
  · simpa using list_prod_mem_gammaFiltration (Λ := Λ) [(k, x)] (by simpa using ⟨hk, hx⟩) le_rfl

@[simp]
theorem gammaFiltration_zero : Λ.gammaFiltration I 0 = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  simpa using gamma_lambda_mem_gammaFiltration (Λ := Λ) I.zero_mem 0

/-- The γ-filtration is decreasing. -/
theorem gammaFiltration_antitone : Antitone (Λ.gammaFiltration I) := fun _ _ hmn =>
  gammaFiltration_le_iff.2 fun l hl hn => list_prod_mem_gammaFiltration l hl (hmn.trans hn)

/-- The γ-filtration is monotone in the ideal. -/
theorem gammaFiltration_mono (h : I ≤ J) (n : ℕ) :
    Λ.gammaFiltration I n ≤ Λ.gammaFiltration J n :=
  gammaFiltration_le_iff.2 fun l hl hn =>
    list_prod_mem_gammaFiltration l (fun p hp => ⟨(hl p hp).1, h (hl p hp).2⟩) hn

/-- The γ-filtration is multiplicative: `Fᵐ Fⁿ ⊆ Fᵐ⁺ⁿ`. -/
theorem gammaFiltration_mul_le (m n : ℕ) :
    Λ.gammaFiltration I m * Λ.gammaFiltration I n ≤ Λ.gammaFiltration I (m + n) := by
  rw [gammaFiltration, gammaFiltration, Ideal.span_mul_span, Ideal.span_le]
  rintro _ ⟨_, ⟨l₁, hl₁, hm, rfl⟩, _, ⟨l₂, hl₂, hn, rfl⟩, rfl⟩
  simp only [SetLike.mem_coe, ← List.prod_append, ← List.map_append]
  refine list_prod_mem_gammaFiltration _ (fun p hp => (List.mem_append.1 hp).elim (hl₁ p) (hl₂ p))
    ?_
  rw [List.map_append, List.sum_append]
  exact add_le_add hm hn

/-- The first step of the γ-filtration contains the ideal. -/
theorem le_gammaFiltration_one : I ≤ Λ.gammaFiltration I 1 := fun x hx => by
  simpa using gamma_lambda_mem_gammaFiltration (Λ := Λ) hx 1

/-- The γ-filtration contains the powers of the ideal: `Iⁿ ⊆ Fⁿ`. -/
theorem pow_le_gammaFiltration (n : ℕ) : I ^ n ≤ Λ.gammaFiltration I n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ]
    exact (Ideal.mul_mono ih le_gammaFiltration_one).trans (gammaFiltration_mul_le n 1)

/-- The positive γ-operations preserve a λ-ideal. -/
theorem IsLambdaIdeal.gamma_lambda_mem (hI : Λ.IsLambdaIdeal I) {k : ℕ} (hk : k ≠ 0)
    {x : R} (hx : x ∈ I) : Λ.gamma.lambda k x ∈ I := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk
  rw [gamma_lambda_succ]
  exact I.sum_mem fun j _ => I.mul_mem_left _ (hI.lambda_mem j.succ_ne_zero hx)

/-- For a λ-ideal `I`, for instance the kernel of an augmentation, the first step of the
γ-filtration is `F¹ = I`. -/
theorem gammaFiltration_one (hI : Λ.IsLambdaIdeal I) : Λ.gammaFiltration I 1 = I := by
  refine le_antisymm (gammaFiltration_le_iff.2 fun l hl hn => ?_) le_gammaFiltration_one
  -- a product of total degree at least one has a factor `γᵏ x` with `k ≥ 1` and `x ∈ I`
  obtain ⟨p, hp⟩ := List.exists_mem_of_ne_nil l (by rintro rfl; simp at hn)
  exact Ideal.mem_of_dvd _ (List.dvd_prod (List.mem_map_of_mem hp))
    (hI.gamma_lambda_mem (Nat.one_le_iff_ne_zero.1 (hl p hp).1) (hl p hp).2)

/-- For a λ-ideal `I`, every positive step of the γ-filtration lies in `I`. -/
theorem gammaFiltration_le_self (hI : Λ.IsLambdaIdeal I) (hn : n ≠ 0) :
    Λ.gammaFiltration I n ≤ I :=
  (gammaFiltration_antitone (Nat.one_le_iff_ne_zero.2 hn)).trans (gammaFiltration_one hI).le

/-- The γ-filtration is natural: a morphism of pre-λ structures carrying `I` into `J` carries
the γ-filtration of `I` into that of `J`. -/
theorem map_gammaFiltration_le {Λ' : PreLambdaStructure S} (f : PreLambdaHom Λ Λ')
    {J : Ideal S} (h : I.map f ≤ J) (n : ℕ) :
    (Λ.gammaFiltration I n).map f ≤ Λ'.gammaFiltration J n := by
  rw [gammaFiltration, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨l, hl, hn, rfl⟩, rfl⟩
  have hl' : ∀ p ∈ l.map fun p => (p.1, f p.2), 1 ≤ p.1 ∧ p.2 ∈ J := by
    simp only [List.mem_map]
    rintro _ ⟨p, hp, rfl⟩
    exact ⟨(hl p hp).1, h (Ideal.mem_map_of_mem f (hl p hp).2)⟩
  have := list_prod_mem_gammaFiltration (Λ := Λ') (n := n) _ hl'
    (by rw [List.map_map]; exact hn)
  simpa [map_list_prod, List.map_map, Function.comp_def] using this

/-- If the elements of `T ⊆ I` are line elements of the γ-structure, then `γᵏ x ∈ Iᵏ` for every
`x` in the additive subgroup generated by `T`. -/
private theorem gamma_lambda_mem_pow_of_mem_closure {T : Set R}
    (hT : ∀ x ∈ T, Λ.gamma.IsLine x) (hTI : T ⊆ I) {x : R} (hx : x ∈ AddSubgroup.closure T)
    (k : ℕ) : Λ.gamma.lambda k x ∈ I ^ k := by
  induction hx using AddSubgroup.closure_induction'' generalizing k with
  | mem x hx =>
    rcases k with _ | _ | k
    · simp
    · simpa using hTI hx
    · rw [(hT x hx).lambda_eq_zero (by omega)]
      exact zero_mem _
  | neg_mem x hx =>
    rw [(hT x hx).lambda_neg]
    exact Ideal.pow_mem_pow (I.neg_mem_iff.2 (hTI hx)) k
  | zero =>
    rcases k with _ | k
    · simp
    · rw [lambda_apply_zero_of_ne_zero _ k.succ_ne_zero]
      exact zero_mem _
  | add x y _ _ hx hy =>
    rw [lambda_add]
    refine sum_mem fun p hp => ?_
    rw [← Finset.mem_antidiagonal.1 hp, pow_add]
    exact Ideal.mul_mem_mul (hx p.1) (hy p.2)

/-- If an ideal `I` is additively generated by line elements of the γ-structure, its γ-filtration
is its `I`-adic filtration: `Fⁿ = Iⁿ`. -/
theorem gammaFiltration_eq_pow {T : Set R} (hT : ∀ x ∈ T, Λ.gamma.IsLine x)
    (hI : I.toAddSubgroup = AddSubgroup.closure T) (n : ℕ) :
    Λ.gammaFiltration I n = I ^ n := by
  have hclosure {x : R} : x ∈ I ↔ x ∈ AddSubgroup.closure T := by
    rw [← hI, Submodule.mem_toAddSubgroup]
  have hmem {x : R} (hx : x ∈ I) (k : ℕ) : Λ.gamma.lambda k x ∈ I ^ k :=
    gamma_lambda_mem_pow_of_mem_closure hT (fun _ hy => hclosure.2 (AddSubgroup.subset_closure hy))
      (hclosure.1 hx) k
  refine le_antisymm (gammaFiltration_le_iff.2 fun l hl hn => ?_) (pow_le_gammaFiltration n)
  refine Ideal.pow_le_pow_right hn ?_
  clear hn
  induction l with
  | nil => simp
  | cons p l ih =>
    simp only [List.map_cons, List.prod_cons, List.sum_cons, pow_add]
    exact Ideal.mul_mem_mul (hmem (hl p (by simp)).2 p.1) (ih fun q hq => hl q (by simp [hq]))

/-- If `1` is a line element and the ideal `I` is additively generated by the elements `l - 1`
for line elements `l ∈ L`, as the augmentation ideal of a group ring is generated by the
elements `g - 1`, then its γ-filtration is its `I`-adic filtration: `Fⁿ = Iⁿ`. -/
theorem gammaFiltration_eq_pow_of_isLine (h1 : Λ.IsLine 1) {L : Set R}
    (hL : ∀ l ∈ L, Λ.IsLine l) (hI : I.toAddSubgroup = AddSubgroup.closure ((· - 1) '' L))
    (n : ℕ) : Λ.gammaFiltration I n = I ^ n :=
  gammaFiltration_eq_pow (by rintro _ ⟨l, hl, rfl⟩; exact (hL l hl).isLine_gamma_sub_one h1) hI n

end PreLambdaStructure

end TauCeti
