/-!
# The pre-Bloch group of a commutative ring

Let `A` be a commutative ring. An *exceptional unit* of `A` is an element `x` such that `x` and
`1 - x` are both units, and a pair `(x, y)` of exceptional units is *admissible* when `x - y` is a
unit as well. The *pre-Bloch group* `P(A)` is the quotient of the free abelian group `ℤ[Aˣ]` on
the units of `A` by the subgroup generated by

* the basis vectors `[u]` of the units `u` that are not exceptional, i.e. with `1 - u` not a
  unit, and
* the *five-term elements* `[x] - [y] + [y/x] - [(1 - x⁻¹)/(1 - y⁻¹)] + [(1 - x)/(1 - y)]` of the
  admissible pairs `(x, y)`.

Over a field `F` the exceptional units are the elements of `F ∖ {0, 1}`, a pair is admissible
exactly when its entries are distinct, and `P(F)` is Suslin's pre-Bloch group, presented by
generators `[x]` for `x ∈ Fˣ` subject to `[1] = 0` and the five-term relation. The pre-Bloch
group is the source of the Bloch boundary `[x] ↦ x ∧ (1 - x)`, whose kernel is the Bloch group,
the target of the map from indecomposable `K₃`.

Every element of a ring has a symbol `preBlochSymbol x : preBloch A`, the class of the basis
vector `[x]` when `x` is a unit and zero otherwise. The symbol vanishes off the exceptional units
(`preBlochSymbol_eq_zero_of_notMem_exceptionalUnits`), satisfies the five-term relation
(`preBlochSymbol_fiveTerm`), and the symbols of the exceptional units generate `P(A)`
(`closure_preBlochSymbol_image_exceptionalUnits`). A function on `A` with these two properties
factors uniquely through `P(A)` (`preBloch.lift`, `preBloch.hom_ext`). Comparing the five-term
relations at an admissible pair `(x, y)` and at its reflection `(1 - y, 1 - x)` gives
`[x] + [1 - x] = [y] + [1 - y]` (`preBlochSymbol_add_preBlochSymbol_one_sub`).

A ring homomorphism maps exceptional units and admissible pairs to exceptional units and
admissible pairs, but it need not map a non-exceptional unit to a non-exceptional one: `-1` is a
non-exceptional unit of `ℤ` and an exceptional unit of `ℚ`. So the map of free abelian groups on
the units does not descend in general. The induced homomorphism `preBloch.map` is instead defined
by `[x] ↦ [f x]` on the exceptional units; for a local homomorphism, in particular for any
homomorphism of fields, it sends every symbol `[x]` to `[f x]`
(`preBloch.map_preBlochSymbol_of_isLocalHom`).

Finally, `P(A)` has the *reduced presentation* on the free abelian group on the exceptional
units, subject to the five-term relations alone (`preBlochEquivReduced`). When `A` has no
admissible pair, `P(A)` is therefore free abelian on the exceptional units
(`preBlochEquivFreeAddCommGroup`): `P(ℤ) = 0`, while `P(𝔽₃)` is infinite cyclic on `[-1]`.

## Main definitions

* `TauCeti.exceptionalUnits A`: the elements `x` of a ring with `x` and `1 - x` units.
* `TauCeti.IsFiveTermAdmissible x y`: `x`, `y` are exceptional units and `x - y` is a unit.
* `TauCeti.preBlochRawSymbol x`: the basis vector `[x]` of `ℤ[Aˣ]` if `x` is a unit, else `0`.
* `TauCeti.preBlochFiveTerm x y`: the five-term element of `ℤ[Aˣ]`.
* `TauCeti.preBlochRelations A`: the subgroup of relations of the pre-Bloch group.
* `TauCeti.preBloch A`: the pre-Bloch group, with symbols `TauCeti.preBlochSymbol x`.
* `TauCeti.preBloch.lift`, `TauCeti.preBloch.map`: the universal property and functoriality.
* `TauCeti.preBlochEquivReduced`: the reduced presentation of the pre-Bloch group.

## References

* C. Weibel, *The K-book: an introduction to algebraic K-theory*, Chapter VI, Definition 5.1.
* B. Mirzaii, F. Y. Mokari, *A Bloch-Wigner theorem over rings with many units II*,
  arXiv:1108.5452, §3.
-/

public section

open FreeAddCommGroup
open scoped Ring

namespace TauCeti

/-! ### Exceptional units and admissible pairs -/

section Ring

variable {A B : Type*} [Ring A] [Ring B]

variable (A) in
/-- The *exceptional units* of a ring: the elements `x` such that `x` and `1 - x` are both units.
Over a field these are the elements different from `0` and `1` (`mem_exceptionalUnits_iff_ne`). -/
def exceptionalUnits : Set A := {x | IsUnit x ∧ IsUnit (1 - x)}

@[simp]
theorem mem_exceptionalUnits {x : A} : x ∈ exceptionalUnits A ↔ IsUnit x ∧ IsUnit (1 - x) :=
  Iff.rfl

theorem one_sub_mem_exceptionalUnits {x : A} :
    1 - x ∈ exceptionalUnits A ↔ x ∈ exceptionalUnits A := by
  simp [and_comm]

/-- A ring homomorphism maps exceptional units to exceptional units. -/
theorem map_mem_exceptionalUnits {F : Type*} [FunLike F A B] [RingHomClass F A B] (f : F)
    {x : A} (hx : x ∈ exceptionalUnits A) : f x ∈ exceptionalUnits B :=
  ⟨hx.1.map f, by simpa using hx.2.map f⟩

/-- A local homomorphism reflects exceptional units. -/
theorem map_mem_exceptionalUnits_iff {F : Type*} [FunLike F A B] [RingHomClass F A B] (f : F)
    [IsLocalHom f] {x : A} : f x ∈ exceptionalUnits B ↔ x ∈ exceptionalUnits A := by
  rw [mem_exceptionalUnits, mem_exceptionalUnits, ← isUnit_map_iff f x, ← isUnit_map_iff f (1 - x),
    map_sub, map_one]

/-- A pair `(x, y)` of elements of a ring is *admissible* for the five-term relation when `x` and
`y` are exceptional units and `x - y` is a unit. Over a field these are the pairs of distinct
elements of `F ∖ {0, 1}` (`isFiveTermAdmissible_iff_ne`). -/
structure IsFiveTermAdmissible (x y : A) : Prop where
  left_mem : x ∈ exceptionalUnits A
  right_mem : y ∈ exceptionalUnits A
  isUnit_sub : IsUnit (x - y)

namespace IsFiveTermAdmissible

variable {x y : A}

/-- Swapping the entries preserves admissibility. -/
theorem symm (h : IsFiveTermAdmissible x y) : IsFiveTermAdmissible y x :=
  ⟨h.right_mem, h.left_mem, by simpa using h.isUnit_sub.neg⟩

/-- The reflection `(x, y) ↦ (1 - y, 1 - x)` preserves admissibility. -/
theorem one_sub (h : IsFiveTermAdmissible x y) : IsFiveTermAdmissible (1 - y) (1 - x) :=
  ⟨one_sub_mem_exceptionalUnits.2 h.right_mem, one_sub_mem_exceptionalUnits.2 h.left_mem,
    by simpa using h.isUnit_sub⟩

/-- A ring homomorphism maps admissible pairs to admissible pairs. -/
theorem map {F : Type*} [FunLike F A B] [RingHomClass F A B] (h : IsFiveTermAdmissible x y)
    (f : F) : IsFiveTermAdmissible (f x) (f y) :=
  ⟨map_mem_exceptionalUnits f h.left_mem, map_mem_exceptionalUnits f h.right_mem,
    by simpa using h.isUnit_sub.map f⟩

/-- Inverting both entries preserves admissibility. -/
theorem ringInverse (h : IsFiveTermAdmissible x y) : IsFiveTermAdmissible x⁻¹ʳ y⁻¹ʳ := by
  obtain ⟨⟨hx, hx1⟩, ⟨hy, hy1⟩, hxy⟩ := h
  have one_sub_inv {z : A} (hz : IsUnit z) : 1 - z⁻¹ʳ = -((1 - z) * z⁻¹ʳ) := by
    rw [sub_mul, one_mul, Ring.mul_inverse_cancel z hz, neg_sub]
  refine ⟨⟨hx.ringInverse, ?_⟩, ⟨hy.ringInverse, ?_⟩, ?_⟩
  · rw [one_sub_inv hx]
    exact (hx1.mul hx.ringInverse).neg
  · rw [one_sub_inv hy]
    exact (hy1.mul hy.ringInverse).neg
  · have : x⁻¹ʳ - y⁻¹ʳ = x⁻¹ʳ * -(x - y) * y⁻¹ʳ := by
      rw [neg_sub, mul_sub, sub_mul, Ring.inverse_mul_cancel x hx, one_mul,
        Ring.mul_inverse_cancel_right y _ hy]
    rw [this]
    exact (hx.ringInverse.mul hxy.neg).mul hy.ringInverse

/-- For an admissible pair `(x, y)`, the third argument `y/x` of the five-term relation is an
exceptional unit. -/
theorem mul_ringInverse_mem (h : IsFiveTermAdmissible x y) :
    y * x⁻¹ʳ ∈ exceptionalUnits A := by
  have hx := h.left_mem.1
  refine ⟨h.right_mem.1.mul hx.ringInverse, ?_⟩
  have : 1 - y * x⁻¹ʳ = (x - y) * x⁻¹ʳ := by rw [sub_mul, Ring.mul_inverse_cancel x hx]
  rw [this]
  exact h.isUnit_sub.mul hx.ringInverse

/-- For an admissible pair `(x, y)`, the fourth argument `(1 - x⁻¹)/(1 - y⁻¹)` of the five-term
relation is an exceptional unit. -/
theorem one_sub_ringInverse_mul_mem (h : IsFiveTermAdmissible x y) :
    (1 - x⁻¹ʳ) * (1 - y⁻¹ʳ)⁻¹ʳ ∈ exceptionalUnits A :=
  h.ringInverse.one_sub.mul_ringInverse_mem

/-- For an admissible pair `(x, y)`, the fifth argument `(1 - x)/(1 - y)` of the five-term
relation is an exceptional unit. -/
theorem one_sub_mul_ringInverse_mem (h : IsFiveTermAdmissible x y) :
    (1 - x) * (1 - y)⁻¹ʳ ∈ exceptionalUnits A :=
  h.one_sub.mul_ringInverse_mem

section map

variable {F : Type*} [FunLike F A B] [RingHomClass F A B]

/-- A ring homomorphism maps the third argument `y/x` of the five-term relation at an admissible
pair `(x, y)` to the third argument at `(f x, f y)`. -/
theorem map_mul_ringInverse (h : IsFiveTermAdmissible x y) (f : F) :
    f (y * x⁻¹ʳ) = f y * (f x)⁻¹ʳ := by
  rw [map_mul, h.left_mem.1.map_ringInverse f]

/-- A ring homomorphism maps the fourth argument `(1 - x⁻¹)/(1 - y⁻¹)` of the five-term relation
at an admissible pair `(x, y)` to the fourth argument at `(f x, f y)`. -/
theorem map_one_sub_ringInverse_mul (h : IsFiveTermAdmissible x y) (f : F) :
    f ((1 - x⁻¹ʳ) * (1 - y⁻¹ʳ)⁻¹ʳ) = (1 - (f x)⁻¹ʳ) * (1 - (f y)⁻¹ʳ)⁻¹ʳ := by
  simp only [map_mul, map_sub, map_one, h.left_mem.1.map_ringInverse f,
    h.right_mem.1.map_ringInverse f, h.ringInverse.right_mem.2.map_ringInverse f]

/-- A ring homomorphism maps the fifth argument `(1 - x)/(1 - y)` of the five-term relation at an
admissible pair `(x, y)` to the fifth argument at `(f x, f y)`. -/
theorem map_one_sub_mul_ringInverse (h : IsFiveTermAdmissible x y) (f : F) :
    f ((1 - x) * (1 - y)⁻¹ʳ) = (1 - f x) * (1 - f y)⁻¹ʳ := by
  simp only [map_mul, map_sub, map_one, h.right_mem.2.map_ringInverse f]

end map

end IsFiveTermAdmissible

end Ring

section DivisionRing

variable {K : Type*} [DivisionRing K]

/-- Over a division ring, the exceptional units are the elements different from `0` and `1`. -/
theorem mem_exceptionalUnits_iff_ne {x : K} : x ∈ exceptionalUnits K ↔ x ≠ 0 ∧ x ≠ 1 := by
  rw [mem_exceptionalUnits, isUnit_iff_ne_zero, isUnit_iff_ne_zero, sub_ne_zero,
    ne_comm (a := (1 : K))]

/-- Over a division ring, the admissible pairs are the pairs of distinct elements different from
`0` and `1`. -/
theorem isFiveTermAdmissible_iff_ne {x y : K} :
    IsFiveTermAdmissible x y ↔ x ≠ 0 ∧ x ≠ 1 ∧ y ≠ 0 ∧ y ≠ 1 ∧ x ≠ y := by
  constructor
  · rintro ⟨hx, hy, hxy⟩
    rw [mem_exceptionalUnits_iff_ne] at hx hy
    exact ⟨hx.1, hx.2, hy.1, hy.2, sub_ne_zero.1 hxy.ne_zero⟩
  · rintro ⟨hx0, hx1, hy0, hy1, hxy⟩
    exact ⟨mem_exceptionalUnits_iff_ne.2 ⟨hx0, hx1⟩, mem_exceptionalUnits_iff_ne.2 ⟨hy0, hy1⟩,
      isUnit_iff_ne_zero.2 (sub_ne_zero.2 hxy)⟩

end DivisionRing

section Monoid

/-! ### Raw symbols and five-term elements -/

variable {A B : Type*} [Monoid A] [Monoid B]

/-- The *raw pre-Bloch symbol* of an element `x` of a monoid: the basis vector `[x]` of the free
abelian group `ℤ[Aˣ]` on the units when `x` is a unit, and zero otherwise. Over a field it is zero
exactly at `0`; its value at `1` is the basis vector `[1]`, which is nonzero. -/
noncomputable def preBlochRawSymbol (x : A) : FreeAddCommGroup Aˣ := by
  classical
  exact if h : IsUnit x then FreeAddCommGroup.of h.unit else 0

theorem preBlochRawSymbol_of_isUnit {x : A} (hx : IsUnit x) :
    preBlochRawSymbol x = FreeAddCommGroup.of hx.unit := by
  simp [preBlochRawSymbol, hx]

@[simp]
theorem preBlochRawSymbol_coe (u : Aˣ) : preBlochRawSymbol (u : A) = FreeAddCommGroup.of u := by
  rw [preBlochRawSymbol_of_isUnit u.isUnit, IsUnit.unit_of_val_units]

theorem preBlochRawSymbol_of_not_isUnit {x : A} (hx : ¬IsUnit x) : preBlochRawSymbol x = 0 := by
  simp [preBlochRawSymbol, hx]

@[simp]
theorem preBlochRawSymbol_eq_zero_iff {x : A} : preBlochRawSymbol x = 0 ↔ ¬IsUnit x := by
  refine ⟨fun h hx => ?_, preBlochRawSymbol_of_not_isUnit⟩
  rw [preBlochRawSymbol_of_isUnit hx] at h
  exact FreeAddCommGroup.of_ne_zero _ h

@[simp]
theorem preBlochRawSymbol_zero {A₀ : Type*} [MonoidWithZero A₀] [Nontrivial A₀] :
    preBlochRawSymbol (0 : A₀) = 0 :=
  preBlochRawSymbol_of_not_isUnit not_isUnit_zero

/-- A monoid homomorphism maps the raw symbol of a unit `x` to the raw symbol of `f x`. -/
theorem map_preBlochRawSymbol (f : A →* B) {x : A} (hx : IsUnit x) :
    FreeAddCommGroup.map (Units.map f) (preBlochRawSymbol x) = preBlochRawSymbol (f x) := by
  obtain ⟨u, rfl⟩ := hx
  rw [preBlochRawSymbol_coe, map_of_apply, ← preBlochRawSymbol_coe, Units.coe_map]

/-- The value of `FreeAddCommGroup.lift (g ∘ Units.val)` on a raw symbol, for a function `g`
vanishing on the non-units. -/
theorem lift_preBlochRawSymbol {G : Type*} [AddCommGroup G] {g : A → G}
    (hg : ∀ x, ¬IsUnit x → g x = 0) (x : A) :
    FreeAddCommGroup.lift (fun u : Aˣ => g u) (preBlochRawSymbol x) = g x := by
  by_cases hx : IsUnit x
  · obtain ⟨u, rfl⟩ := hx
    simp
  · rw [preBlochRawSymbol_of_not_isUnit hx, map_zero, hg x hx]

end Monoid

section CommRing

variable {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]

/-- For an exceptional unit `z`, `1 - (1 - z)⁻¹ = (1 - z⁻¹)⁻¹`. -/
theorem one_sub_ringInverse_one_sub {z : A} (hz : z ∈ exceptionalUnits A) :
    1 - (1 - z)⁻¹ʳ = (1 - z⁻¹ʳ)⁻¹ʳ := by
  have h : (1 - z⁻¹ʳ) * (1 - (1 - z)⁻¹ʳ) = 1 := by
    linear_combination z⁻¹ʳ * Ring.mul_inverse_cancel _ hz.2 +
      (1 - z)⁻¹ʳ * Ring.mul_inverse_cancel _ hz.1
  rw [← Ring.inverse_mul_cancel_left _ (1 - (1 - z)⁻¹ʳ) (.of_mul_eq_one _ h), h, mul_one]

/-- The *five-term element* `[x] - [y] + [y/x] - [(1 - x⁻¹)/(1 - y⁻¹)] + [(1 - x)/(1 - y)]` of the
free abelian group on the units, in Suslin's normalisation. It is a relation of the pre-Bloch group
when `(x, y)` is admissible. -/
noncomputable def preBlochFiveTerm (x y : A) : FreeAddCommGroup Aˣ :=
  preBlochRawSymbol x - preBlochRawSymbol y + preBlochRawSymbol (y * x⁻¹ʳ) -
    preBlochRawSymbol ((1 - x⁻¹ʳ) * (1 - y⁻¹ʳ)⁻¹ʳ) + preBlochRawSymbol ((1 - x) * (1 - y)⁻¹ʳ)

/-- A ring homomorphism maps the five-term element of an admissible pair `(x, y)` to the five-term
element of `(f x, f y)`. -/
theorem map_preBlochFiveTerm (f : A →+* B) {x y : A} (h : IsFiveTermAdmissible x y) :
    FreeAddCommGroup.map (Units.map (f : A →* B)) (preBlochFiveTerm x y) =
      preBlochFiveTerm (f x) (f y) := by
  simp only [preBlochFiveTerm, map_add, map_sub, map_preBlochRawSymbol _ h.left_mem.1,
    map_preBlochRawSymbol _ h.right_mem.1, map_preBlochRawSymbol _ h.mul_ringInverse_mem.1,
    map_preBlochRawSymbol _ h.one_sub_ringInverse_mul_mem.1,
    map_preBlochRawSymbol _ h.one_sub_mul_ringInverse_mem.1, MonoidHom.coe_ofClass]
  rw [h.map_mul_ringInverse f, h.map_one_sub_ringInverse_mul f, h.map_one_sub_mul_ringInverse f]

/-- The *reflection identity*: the five-term elements of an admissible pair `(x, y)` and of its
reflection `(1 - y, 1 - x)` differ by `([x] + [1 - x]) - ([y] + [1 - y])`. -/
theorem preBlochFiveTerm_sub_preBlochFiveTerm_one_sub {x y : A} (h : IsFiveTermAdmissible x y) :
    preBlochFiveTerm x y - preBlochFiveTerm (1 - y) (1 - x) =
      preBlochRawSymbol x + preBlochRawSymbol (1 - x) -
        (preBlochRawSymbol y + preBlochRawSymbol (1 - y)) := by
  have h₄ : (1 - (1 - y)⁻¹ʳ) * (1 - (1 - x)⁻¹ʳ)⁻¹ʳ = (1 - x⁻¹ʳ) * (1 - y⁻¹ʳ)⁻¹ʳ := by
    rw [one_sub_ringInverse_one_sub h.left_mem, one_sub_ringInverse_one_sub h.right_mem,
      Ring.inverse_inverse h.ringInverse.left_mem.2, mul_comm]
  rw [preBlochFiveTerm, preBlochFiveTerm, h₄, sub_sub_cancel, sub_sub_cancel]
  abel

/-! ### The pre-Bloch group -/

variable (A) in
/-- The subgroup of relations of the pre-Bloch group of a commutative ring: it is generated by the
basis vectors `[u]` of the units `u` with `1 - u` not a unit, and by the five-term elements of the
admissible pairs. Over a field the first family is the single vector `[1]`. -/
def preBlochRelations : AddSubgroup (FreeAddCommGroup Aˣ) :=
  AddSubgroup.closure {r | (∃ u : A, IsUnit u ∧ ¬IsUnit (1 - u) ∧ r = preBlochRawSymbol u) ∨
    ∃ x y : A, IsFiveTermAdmissible x y ∧ r = preBlochFiveTerm x y}

/-- The raw symbol of every element that is not an exceptional unit is a relation: a unit `u` with
`1 - u` not a unit is a generator, and a non-unit has raw symbol zero. -/
theorem preBlochRawSymbol_mem_preBlochRelations {u : A} (hu : u ∉ exceptionalUnits A) :
    preBlochRawSymbol u ∈ preBlochRelations A := by
  by_cases h : IsUnit u
  · exact AddSubgroup.subset_closure (Or.inl ⟨u, h, fun h' => hu ⟨h, h'⟩, rfl⟩)
  · rw [preBlochRawSymbol_of_not_isUnit h]
    exact zero_mem _

theorem preBlochFiveTerm_mem_preBlochRelations {x y : A} (h : IsFiveTermAdmissible x y) :
    preBlochFiveTerm x y ∈ preBlochRelations A :=
  AddSubgroup.subset_closure (Or.inr ⟨x, y, h, rfl⟩)

/-- `preBlochRelations A` is the smallest subgroup containing the raw symbols of the elements
that are not exceptional units and the five-term elements of the admissible pairs. -/
theorem preBlochRelations_le_iff {H : AddSubgroup (FreeAddCommGroup Aˣ)} :
    preBlochRelations A ≤ H ↔ (∀ u : A, u ∉ exceptionalUnits A → preBlochRawSymbol u ∈ H) ∧
      ∀ x y : A, IsFiveTermAdmissible x y → preBlochFiveTerm x y ∈ H := by
  rw [preBlochRelations, AddSubgroup.closure_le]
  constructor
  · intro h
    exact ⟨fun u hu => (AddSubgroup.closure_le H).2 h (preBlochRawSymbol_mem_preBlochRelations hu),
      fun x y hxy => h (Or.inr ⟨x, y, hxy, rfl⟩)⟩
  · rintro ⟨h₁, h₂⟩ r (⟨u, -, hu1, rfl⟩ | ⟨x, y, hxy, rfl⟩)
    exacts [h₁ u fun h => hu1 h.2, h₂ x y hxy]

variable (A) in
/-- The *pre-Bloch group* `P(A)` of a commutative ring `A`: the free abelian group on the units of
`A` modulo `preBlochRelations A`. It is generated by the classes `[x]` of the units, subject to
`[u] = 0` when `1 - u` is not a unit and to the five-term relation at every admissible pair. Over a
field `F` it is Suslin's pre-Bloch group, generated by the `[x]` for `x ≠ 0` subject to `[1] = 0`
and the five-term relations at all `x ≠ y` in `F ∖ {0, 1}`. -/
def preBloch : Type _ :=
  FreeAddCommGroup Aˣ ⧸ preBlochRelations A

noncomputable instance : AddCommGroup (preBloch A) :=
  inferInstanceAs (AddCommGroup (FreeAddCommGroup Aˣ ⧸ preBlochRelations A))

namespace preBloch

variable (A) in
/-- The quotient map from the free abelian group on the units onto the pre-Bloch group. -/
noncomputable def mk : FreeAddCommGroup Aˣ →+ preBloch A :=
  QuotientAddGroup.mk' (preBlochRelations A)

theorem mk_surjective : Function.Surjective (mk A) :=
  QuotientAddGroup.mk'_surjective _

@[simp]
theorem ker_mk : (mk A).ker = preBlochRelations A :=
  QuotientAddGroup.ker_mk' _

theorem mk_eq_zero_iff {z : FreeAddCommGroup Aˣ} : mk A z = 0 ↔ z ∈ preBlochRelations A :=
  QuotientAddGroup.eq_zero_iff z

end preBloch

/-- The *pre-Bloch symbol* `[x] ∈ P(A)` of an element `x` of a commutative ring: the class of the
raw symbol, so the class of the basis vector `[x]` when `x` is a unit and zero otherwise. It
vanishes at every element that is not an exceptional unit; over a field, at `0` and `1`. -/
noncomputable def preBlochSymbol (x : A) : preBloch A :=
  preBloch.mk A (preBlochRawSymbol x)

@[simp]
theorem preBloch.mk_preBlochRawSymbol (x : A) :
    preBloch.mk A (preBlochRawSymbol x) = preBlochSymbol x :=
  (rfl)

@[simp]
theorem preBloch.mk_of (u : Aˣ) :
    preBloch.mk A (FreeAddCommGroup.of u) = preBlochSymbol (u : A) := by
  rw [← preBlochRawSymbol_coe, preBloch.mk_preBlochRawSymbol]

theorem preBlochSymbol_eq_zero_of_notMem_exceptionalUnits {x : A} (hx : x ∉ exceptionalUnits A) :
    preBlochSymbol x = 0 :=
  preBloch.mk_eq_zero_iff.2 (preBlochRawSymbol_mem_preBlochRelations hx)

theorem preBloch.mk_preBlochFiveTerm {x y : A} (h : IsFiveTermAdmissible x y) :
    preBloch.mk A (preBlochFiveTerm x y) = 0 :=
  preBloch.mk_eq_zero_iff.2 (preBlochFiveTerm_mem_preBlochRelations h)

/-- The *five-term relation* in the pre-Bloch group: for an admissible pair `(x, y)`,
`[x] - [y] + [y/x] - [(1 - x⁻¹)/(1 - y⁻¹)] + [(1 - x)/(1 - y)] = 0`. -/
theorem preBlochSymbol_fiveTerm {x y : A} (h : IsFiveTermAdmissible x y) :
    preBlochSymbol x - preBlochSymbol y + preBlochSymbol (y * x⁻¹ʳ) -
        preBlochSymbol ((1 - x⁻¹ʳ) * (1 - y⁻¹ʳ)⁻¹ʳ) + preBlochSymbol ((1 - x) * (1 - y)⁻¹ʳ) =
      0 := by
  simpa [preBlochFiveTerm] using preBloch.mk_preBlochFiveTerm h

/-- For an admissible pair `(x, y)`, `[x] + [1 - x] = [y] + [1 - y]` in the pre-Bloch group: the
difference of the five-term relations at `(x, y)` and at `(1 - y, 1 - x)`. Over a field, any two
distinct elements of `F ∖ {0, 1}` form an admissible pair. -/
theorem preBlochSymbol_add_preBlochSymbol_one_sub {x y : A} (h : IsFiveTermAdmissible x y) :
    preBlochSymbol x + preBlochSymbol (1 - x) = preBlochSymbol y + preBlochSymbol (1 - y) := by
  have := congrArg (preBloch.mk A) (preBlochFiveTerm_sub_preBlochFiveTerm_one_sub h)
  simp only [map_add, map_sub, preBloch.mk_preBlochRawSymbol, preBloch.mk_preBlochFiveTerm h,
    preBloch.mk_preBlochFiveTerm h.one_sub, sub_self] at this
  exact sub_eq_zero.1 this.symm

/-- The symbol of `1` vanishes. Over a nontrivial ring `1 - 1 = 0` is not a unit; over the zero
ring the five-term element of the admissible pair `(1, 1)` is `[1]`. -/
@[simp]
theorem preBlochSymbol_one : preBlochSymbol (1 : A) = 0 := by
  rcases subsingleton_or_nontrivial A with hA | hA
  · have h : IsFiveTermAdmissible (1 : A) 1 :=
      ⟨⟨isUnit_of_subsingleton _, isUnit_of_subsingleton _⟩,
        ⟨isUnit_of_subsingleton _, isUnit_of_subsingleton _⟩, isUnit_of_subsingleton _⟩
    simpa [Subsingleton.elim _ (1 : A)] using preBlochSymbol_fiveTerm h
  · exact preBlochSymbol_eq_zero_of_notMem_exceptionalUnits (by simp)

@[simp]
theorem preBlochSymbol_zero : preBlochSymbol (0 : A) = 0 := by
  rcases subsingleton_or_nontrivial A with hA | hA
  · rw [Subsingleton.elim (0 : A) 1, preBlochSymbol_one]
  · exact preBlochSymbol_eq_zero_of_notMem_exceptionalUnits (by simp)

/-- The symbols of the exceptional units generate the pre-Bloch group. -/
theorem closure_preBlochSymbol_image_exceptionalUnits :
    AddSubgroup.closure (preBlochSymbol '' exceptionalUnits A) = ⊤ := by
  refine (AddSubgroup.eq_top_iff' _).2 fun z => ?_
  obtain ⟨z, rfl⟩ := preBloch.mk_surjective z
  induction z using FreeAddCommGroup.induction_on with
  | zero => simp
  | of u =>
    rw [preBloch.mk_of]
    by_cases hu : (u : A) ∈ exceptionalUnits A
    · exact AddSubgroup.subset_closure ⟨u, hu, rfl⟩
    · rw [preBlochSymbol_eq_zero_of_notMem_exceptionalUnits hu]
      exact zero_mem _
  | neg u hu => simpa using neg_mem hu
  | add z w hz hw => simpa using add_mem hz hw

namespace preBloch

/-- Two homomorphisms out of the pre-Bloch group agreeing on the symbols of the exceptional units
are equal. -/
@[ext]
theorem hom_ext {G : Type*} [AddCommGroup G] {f g : preBloch A →+ G}
    (h : ∀ x ∈ exceptionalUnits A, f (preBlochSymbol x) = g (preBlochSymbol x)) : f = g := by
  refine AddMonoidHom.eq_of_eqOn_dense closure_preBlochSymbol_image_exceptionalUnits ?_
  rintro _ ⟨x, hx, rfl⟩
  exact h x hx

variable {G : Type*} [AddCommGroup G]

/-- The *universal property* of the pre-Bloch group: a function `f` on a commutative ring that
vanishes off the exceptional units and satisfies the five-term relation at every admissible pair
induces a homomorphism `P(A) →+ G` with `[x] ↦ f x`. -/
noncomputable def lift (f : A → G) (hf : ∀ x, x ∉ exceptionalUnits A → f x = 0)
    (h₅ : ∀ x y, IsFiveTermAdmissible x y →
      f x - f y + f (y * x⁻¹ʳ) - f ((1 - x⁻¹ʳ) * (1 - y⁻¹ʳ)⁻¹ʳ) + f ((1 - x) * (1 - y)⁻¹ʳ) = 0) :
    preBloch A →+ G :=
  QuotientAddGroup.lift (preBlochRelations A) (FreeAddCommGroup.lift fun u : Aˣ => f u) <| by
    have hraw := lift_preBlochRawSymbol (g := f) fun x hx => hf x fun h => hx h.1
    refine preBlochRelations_le_iff.2 ⟨fun u hu => ?_, fun x y hxy => ?_⟩
    · rw [AddMonoidHom.mem_ker, hraw, hf u hu]
    · rw [AddMonoidHom.mem_ker, preBlochFiveTerm]
      simp only [map_add, map_sub, hraw]
      exact h₅ x y hxy

@[simp]
theorem lift_preBlochSymbol (f : A → G) (hf : ∀ x, x ∉ exceptionalUnits A → f x = 0)
    (h₅ : ∀ x y, IsFiveTermAdmissible x y →
      f x - f y + f (y * x⁻¹ʳ) - f ((1 - x⁻¹ʳ) * (1 - y⁻¹ʳ)⁻¹ʳ) + f ((1 - x) * (1 - y)⁻¹ʳ) = 0)
    (x : A) : lift f hf h₅ (preBlochSymbol x) = f x := by
  -- `lift` is `QuotientAddGroup.lift` and `mk` is `QuotientAddGroup.mk'`, so `lift_mk` applies
  -- once both sides are unfolded.
  rw [← mk_preBlochRawSymbol]
  exact (QuotientAddGroup.lift_mk _ _ _).trans
    (lift_preBlochRawSymbol (fun x hx => hf x fun h => hx h.1) x)

/-- The homomorphism `P(A) → P(B)` induced by a ring homomorphism `f : A →+* B`: it sends the symbol
`[x]` of an exceptional unit to `[f x]`. It is not induced by the map of free abelian groups on the
units, which need not respect the relations (see the module docstring); for a local homomorphism,
in particular a homomorphism of fields, it nonetheless sends every symbol `[x]` to `[f x]`
(`preBloch.map_preBlochSymbol_of_isLocalHom`). -/
noncomputable def map (f : A →+* B) : preBloch A →+ preBloch B := by
  classical
  refine lift (fun x => if x ∈ exceptionalUnits A then preBlochSymbol (f x) else 0)
    (fun x hx => by simp [hx]) fun x y h => ?_
  simp only [h.left_mem, h.right_mem, h.mul_ringInverse_mem, h.one_sub_ringInverse_mul_mem,
    h.one_sub_mul_ringInverse_mem, ↓reduceIte]
  rw [h.map_mul_ringInverse f, h.map_one_sub_ringInverse_mul f, h.map_one_sub_mul_ringInverse f]
  exact preBlochSymbol_fiveTerm (h.map f)

@[simp]
theorem map_preBlochSymbol (f : A →+* B) {x : A} (hx : x ∈ exceptionalUnits A) :
    map f (preBlochSymbol x) = preBlochSymbol (f x) := by
  classical
  rw [map, lift_preBlochSymbol]
  simp [hx]

/-- A local homomorphism, for instance a homomorphism of fields, maps every symbol `[x]` to
`[f x]`. -/
@[simp]
theorem map_preBlochSymbol_of_isLocalHom (f : A →+* B) [IsLocalHom f] (x : A) :
    map f (preBlochSymbol x) = preBlochSymbol (f x) := by
  by_cases hx : x ∈ exceptionalUnits A
  · exact map_preBlochSymbol f hx
  · rw [preBlochSymbol_eq_zero_of_notMem_exceptionalUnits hx, map_zero,
      preBlochSymbol_eq_zero_of_notMem_exceptionalUnits (by rwa [map_mem_exceptionalUnits_iff])]

@[simp]
theorem map_id : map (RingHom.id A) = AddMonoidHom.id (preBloch A) :=
  hom_ext fun x hx => by rw [map_preBlochSymbol _ hx, RingHom.id_apply, AddMonoidHom.id_apply]

theorem map_comp (g : B →+* C) (f : A →+* B) : map (g.comp f) = (map g).comp (map f) :=
  hom_ext fun x hx => by
    rw [map_preBlochSymbol _ hx, AddMonoidHom.comp_apply, map_preBlochSymbol _ hx,
      map_preBlochSymbol _ (map_mem_exceptionalUnits f hx), RingHom.comp_apply]

end preBloch

/-! ### The reduced presentation -/

/-- The *reduced raw symbol* of an element `x` of a commutative ring: the basis vector `[x]` of the
free abelian group on the exceptional units when `x` is an exceptional unit, and zero otherwise.
Unlike `preBlochRawSymbol`, it vanishes at `1` over a nontrivial ring, where `1` is not an
exceptional unit. -/
noncomputable def preBlochReducedRawSymbol (x : A) : FreeAddCommGroup (exceptionalUnits A) := by
  classical
  exact if h : x ∈ exceptionalUnits A then FreeAddCommGroup.of ⟨x, h⟩ else 0

theorem preBlochReducedRawSymbol_of_mem {x : A} (hx : x ∈ exceptionalUnits A) :
    preBlochReducedRawSymbol x = FreeAddCommGroup.of ⟨x, hx⟩ := by
  simp [preBlochReducedRawSymbol, hx]

@[simp]
theorem preBlochReducedRawSymbol_coe (w : exceptionalUnits A) :
    preBlochReducedRawSymbol (w : A) = FreeAddCommGroup.of w :=
  preBlochReducedRawSymbol_of_mem w.property

theorem preBlochReducedRawSymbol_of_notMem {x : A} (hx : x ∉ exceptionalUnits A) :
    preBlochReducedRawSymbol x = 0 := by
  simp [preBlochReducedRawSymbol, hx]

/-- The five-term element `[x] - [y] + [y/x] - [(1 - x⁻¹)/(1 - y⁻¹)] + [(1 - x)/(1 - y)]` in the
free abelian group on the exceptional units. -/
noncomputable def preBlochReducedFiveTerm (x y : A) : FreeAddCommGroup (exceptionalUnits A) :=
  preBlochReducedRawSymbol x - preBlochReducedRawSymbol y + preBlochReducedRawSymbol (y * x⁻¹ʳ) -
    preBlochReducedRawSymbol ((1 - x⁻¹ʳ) * (1 - y⁻¹ʳ)⁻¹ʳ) +
    preBlochReducedRawSymbol ((1 - x) * (1 - y)⁻¹ʳ)

variable (A) in
/-- The relations of the reduced presentation of the pre-Bloch group: the subgroup of the free
abelian group on the exceptional units generated by the five-term elements of the admissible
pairs. -/
def preBlochReducedRelations : AddSubgroup (FreeAddCommGroup (exceptionalUnits A)) :=
  AddSubgroup.closure {r | ∃ x y : A, IsFiveTermAdmissible x y ∧ r = preBlochReducedFiveTerm x y}

theorem preBlochReducedFiveTerm_mem_preBlochReducedRelations {x y : A}
    (h : IsFiveTermAdmissible x y) : preBlochReducedFiveTerm x y ∈ preBlochReducedRelations A :=
  AddSubgroup.subset_closure ⟨x, y, h, rfl⟩

/-- `preBlochReducedRelations A` is the smallest subgroup containing the five-term elements of the
admissible pairs. -/
theorem preBlochReducedRelations_le_iff {H : AddSubgroup (FreeAddCommGroup (exceptionalUnits A))} :
    preBlochReducedRelations A ≤ H ↔
      ∀ x y : A, IsFiveTermAdmissible x y → preBlochReducedFiveTerm x y ∈ H := by
  rw [preBlochReducedRelations, AddSubgroup.closure_le]
  exact ⟨fun h x y hxy => h ⟨x, y, hxy, rfl⟩, fun h _ ⟨x, y, hxy, hr⟩ => hr ▸ h x y hxy⟩

/-- The value of `FreeAddCommGroup.lift (g ∘ Subtype.val)` on a reduced raw symbol, for a function
`g` vanishing off the exceptional units. -/
theorem lift_preBlochReducedRawSymbol {G : Type*} [AddCommGroup G] {g : A → G}
    (hg : ∀ x, x ∉ exceptionalUnits A → g x = 0) (x : A) :
    FreeAddCommGroup.lift (fun w : exceptionalUnits A => g w) (preBlochReducedRawSymbol x) =
      g x := by
  by_cases hx : x ∈ exceptionalUnits A
  · rw [preBlochReducedRawSymbol_of_mem hx, FreeAddCommGroup.lift_apply_of]
  · rw [preBlochReducedRawSymbol_of_notMem hx, map_zero, hg x hx]

/-- The map from the pre-Bloch group to its reduced presentation, `[x] ↦ [x]` on the exceptional
units. -/
private noncomputable def toReduced :
    preBloch A →+ FreeAddCommGroup (exceptionalUnits A) ⧸ preBlochReducedRelations A :=
  preBloch.lift (fun x => QuotientAddGroup.mk (preBlochReducedRawSymbol x))
    (fun x hx => by rw [preBlochReducedRawSymbol_of_notMem hx, QuotientAddGroup.mk_zero])
    fun x y h => by
      simp only [← QuotientAddGroup.mk_sub, ← QuotientAddGroup.mk_add]
      exact (QuotientAddGroup.eq_zero_iff _).2
        (preBlochReducedFiveTerm_mem_preBlochReducedRelations h)

private theorem toReduced_preBlochSymbol (x : A) :
    toReduced (preBlochSymbol x) = QuotientAddGroup.mk (preBlochReducedRawSymbol x) :=
  preBloch.lift_preBlochSymbol _ _ _ x

/-- The map from the reduced presentation to the pre-Bloch group, `[x] ↦ [x]`. -/
private noncomputable def ofReduced :
    FreeAddCommGroup (exceptionalUnits A) ⧸ preBlochReducedRelations A →+ preBloch A :=
  QuotientAddGroup.lift _ (FreeAddCommGroup.lift fun w : exceptionalUnits A => preBlochSymbol w)
    (preBlochReducedRelations_le_iff.2 fun x y h => by
      rw [AddMonoidHom.mem_ker, preBlochReducedFiveTerm]
      simp only [map_add, map_sub, lift_preBlochReducedRawSymbol
        (fun _ => preBlochSymbol_eq_zero_of_notMem_exceptionalUnits)]
      exact preBlochSymbol_fiveTerm h)

private theorem ofReduced_mk_of (w : exceptionalUnits A) :
    ofReduced (QuotientAddGroup.mk (FreeAddCommGroup.of w)) = preBlochSymbol (w : A) := by
  rw [ofReduced, QuotientAddGroup.lift_mk, FreeAddCommGroup.lift_apply_of]

/-- The pre-Bloch group of a commutative ring has the *reduced presentation*: generators `[x]` for
the exceptional units `x`, subject only to the five-term relations at the admissible pairs. The
equivalence sends the symbol `[x]` of an exceptional unit to the class of the generator `[x]`. -/
noncomputable def preBlochEquivReduced :
    preBloch A ≃+ FreeAddCommGroup (exceptionalUnits A) ⧸ preBlochReducedRelations A :=
  AddMonoidHom.toAddEquiv toReduced ofReduced
    (preBloch.hom_ext fun x hx => by
      rw [AddMonoidHom.comp_apply, toReduced_preBlochSymbol, preBlochReducedRawSymbol_of_mem hx,
        ofReduced_mk_of, AddMonoidHom.id_apply])
    (QuotientAddGroup.addMonoidHom_ext _ (FreeAddCommGroup.lift_ext _ _ fun w => by
      simp [ofReduced_mk_of, toReduced_preBlochSymbol]))

/-- The reduced presentation sends every symbol `[x]` to the class of the reduced raw symbol of
`x`, which is zero off the exceptional units. -/
@[simp]
theorem preBlochEquivReduced_preBlochSymbol (x : A) :
    preBlochEquivReduced (preBlochSymbol x) =
      (preBlochReducedRawSymbol x : FreeAddCommGroup (exceptionalUnits A)) := by
  rw [preBlochEquivReduced, AddMonoidHom.toAddEquiv_apply]
  exact toReduced_preBlochSymbol x

@[simp]
theorem preBlochEquivReduced_symm_of (w : exceptionalUnits A) :
    preBlochEquivReduced.symm (FreeAddCommGroup.of w : FreeAddCommGroup (exceptionalUnits A)) =
      preBlochSymbol (w : A) := by
  rw [AddEquiv.symm_apply_eq, preBlochEquivReduced_preBlochSymbol, preBlochReducedRawSymbol_coe]

/-- A commutative ring without admissible pairs has pre-Bloch group free abelian on its
exceptional units: there are no five-term relations, and `[x] ↦ [x]` is an isomorphism. -/
noncomputable def preBlochEquivFreeAddCommGroup (h : ∀ x y : A, ¬IsFiveTermAdmissible x y) :
    preBloch A ≃+ FreeAddCommGroup (exceptionalUnits A) :=
  AddMonoidHom.toAddEquiv
    (preBloch.lift preBlochReducedRawSymbol (fun _ => preBlochReducedRawSymbol_of_notMem)
      fun x y hxy => absurd hxy (h x y))
    (FreeAddCommGroup.lift fun w : exceptionalUnits A => preBlochSymbol (w : A))
    (preBloch.hom_ext fun x hx => by simp [preBlochReducedRawSymbol_of_mem hx])
    (FreeAddCommGroup.lift_ext _ _ fun w => by simp)

@[simp]
theorem preBlochEquivFreeAddCommGroup_preBlochSymbol
    (h : ∀ x y : A, ¬IsFiveTermAdmissible x y) (x : A) :
    preBlochEquivFreeAddCommGroup h (preBlochSymbol x) = preBlochReducedRawSymbol x := by
  rw [preBlochEquivFreeAddCommGroup, AddMonoidHom.toAddEquiv_apply]
  exact preBloch.lift_preBlochSymbol _ (fun _ => preBlochReducedRawSymbol_of_notMem)
    (fun x y hxy => absurd hxy (h x y)) x

@[simp]
theorem preBlochEquivFreeAddCommGroup_symm_of (h : ∀ x y : A, ¬IsFiveTermAdmissible x y)
    (w : exceptionalUnits A) :
    (preBlochEquivFreeAddCommGroup h).symm (FreeAddCommGroup.of w) = preBlochSymbol (w : A) := by
  rw [AddEquiv.symm_apply_eq, preBlochEquivFreeAddCommGroup_preBlochSymbol,
    preBlochReducedRawSymbol_coe]

/-- The pre-Bloch group of a commutative ring without exceptional units is trivial. -/
theorem subsingleton_preBloch (h : exceptionalUnits A = ∅) : Subsingleton (preBloch A) := by
  have htop := closure_preBlochSymbol_image_exceptionalUnits (A := A)
  rw [h, Set.image_empty, AddSubgroup.closure_empty] at htop
  have h0 (z : preBloch A) : z = 0 := AddSubgroup.mem_bot.1 (htop ▸ AddSubgroup.mem_top z)
  exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩

end CommRing

/-! ### Examples -/

/-- The pre-Bloch group of `ℤ` is trivial: the units of `ℤ` are `±1`, and `1 - 1 = 0` and
`1 - (-1) = 2` are not units, so `ℤ` has no exceptional units. -/
example : Subsingleton (preBloch ℤ) := by
  refine subsingleton_preBloch (Set.eq_empty_of_forall_notMem fun x ⟨hx, hx1⟩ => ?_)
  rcases Int.isUnit_iff.1 hx with rfl | rfl
  · simp at hx1
  · exact absurd (Int.isUnit_iff.1 hx1) (by decide)

/-- The pre-Bloch group of `𝔽₂` is trivial: its only unit is `1`, which is not exceptional. -/
example : Subsingleton (preBloch (ZMod 2)) := by
  refine subsingleton_preBloch (Set.eq_empty_of_forall_notMem fun x => ?_)
  have : ∀ x : ZMod 2, ¬(x ≠ 0 ∧ x ≠ 1) := by decide
  simpa only [mem_exceptionalUnits_iff_ne] using this x

/-- The pre-Bloch group of `𝔽₃` is infinite cyclic, generated by `[-1]`: the only exceptional unit
is `-1`, and there is no admissible pair. -/
example : Nonempty (preBloch (ZMod 3) ≃+ ℤ) := by
  have hW : exceptionalUnits (ZMod 3) = {-1} := by
    have : ∀ x : ZMod 3, (x ≠ 0 ∧ x ≠ 1 ↔ x = -1) := by decide
    ext x
    simpa only [mem_exceptionalUnits_iff_ne, Set.mem_singleton_iff] using this x
  have hA : ∀ x y : ZMod 3, ¬IsFiveTermAdmissible x y := by
    have : ∀ x y : ZMod 3, ¬(x ≠ 0 ∧ x ≠ 1 ∧ y ≠ 0 ∧ y ≠ 1 ∧ x ≠ y) := by decide
    simpa only [isFiveTermAdmissible_iff_ne] using this
  have : Unique (exceptionalUnits (ZMod 3)) := by rw [hW]; infer_instance
  exact ⟨(preBlochEquivFreeAddCommGroup hA).trans (FreeAddCommGroup.uniqueEquiv _)⟩

end TauCeti
