/-!
# The cyclotomic index monoid

For a commutative ring `R` and a set `S : Set ℕ` of root orders, Habiro's cyclotomic completion of
`R[X]` is indexed by the multiplicative submonoid `cycloIndex R S ≤ R[X]` generated by the
cyclotomic polynomials `Polynomial.cyclotomic n R` for `n ∈ S`. Working with the submonoid of
actual polynomials in `R[X]` — rather than formal exponent tuples — identifies products that
coincide in `R[X]`, such as `Φ₁` and `Φ₂` in characteristic two.

Every polynomial in `cycloIndex R S` is monic and hence a nonzerodivisor in `R[X]`. Under
divisibility the indexing monoid is directed (with common upper bound given by multiplication),
commutes with base change along any ring homomorphism `R →+* R'`, ignores order `0` because
`cyclotomic 0 R = 1`, and admits an explicit countable cofinal chain
`cycloChain R S N = ∏_{n ∈ S, 1 ≤ n ≤ N} Φ_n ^ N` as well as cofinal powers of
`∏_{n ∈ S} Φ_n` when `S` is finite.

## Main definitions

* `TauCeti.cycloIndex`: the submonoid of `R[X]` generated by `{cyclotomic n R | n ∈ S}`.
* `TauCeti.cycloChain`, `TauCeti.cycloChainIndex`: the countable cofinal divisibility chain
  `∏_{n ∈ S, 1 ≤ n ≤ N} (cyclotomic n R) ^ N` in `cycloIndex R S`.
* `TauCeti.cycloProd`: for finite `S`, the product `∏_{n ∈ S} cyclotomic n R`, whose powers are
  cofinal in `cycloIndex R S`.

## References

* K. Habiro, *Cyclotomic completions of polynomial rings*, Publ. Res. Inst. Math. Sci. **40**
  (2004), 1127–1146, §3.1.
-/

public section

open Polynomial

namespace TauCeti

section Basic

variable {R R' : Type*} [CommRing R] [CommRing R']

/-- The multiplicative submonoid of `R[X]` generated by the cyclotomic polynomials
`cyclotomic n R` for `n ∈ S`. Coincident polynomial products represent the same index. -/
noncomputable def cycloIndex (R : Type*) [CommRing R] (S : Set ℕ) : Submonoid R[X] :=
  Submonoid.closure ((fun n ↦ cyclotomic n R) '' S)

theorem cycloIndex_def (R : Type*) [CommRing R] (S : Set ℕ) :
    cycloIndex R S = Submonoid.closure ((fun n ↦ cyclotomic n R) '' S) :=
  (rfl)

/-- Each generator `cyclotomic n R` with `n ∈ S` belongs to `cycloIndex R S`. -/
theorem cyclotomic_mem_cycloIndex {S : Set ℕ} {n : ℕ} (hn : n ∈ S) :
    cyclotomic n R ∈ cycloIndex R S :=
  Submonoid.subset_closure ⟨n, hn, rfl⟩

/-- Powers of `cyclotomic n R` with `n ∈ S` belong to `cycloIndex R S`. -/
theorem cyclotomic_pow_mem_cycloIndex {S : Set ℕ} {n : ℕ} (hn : n ∈ S) (k : ℕ) :
    cyclotomic n R ^ k ∈ cycloIndex R S :=
  pow_mem (cyclotomic_mem_cycloIndex hn) k

/-- Finite products of powers of cyclotomic polynomials with orders in `S` belong to
`cycloIndex R S`. -/
theorem prod_cyclotomic_pow_mem_cycloIndex {S : Set ℕ} {ι : Type*} (s : Finset ι)
    (n : ι → ℕ) (e : ι → ℕ) (hn : ∀ i ∈ s, n i ∈ S) :
    (∏ i ∈ s, cyclotomic (n i) R ^ e i) ∈ cycloIndex R S :=
  prod_mem fun i hi ↦ cyclotomic_pow_mem_cycloIndex (hn i hi) (e i)

/-- Every polynomial in `cycloIndex R S` is monic. -/
theorem monic_of_mem_cycloIndex {S : Set ℕ} {f : R[X]} (hf : f ∈ cycloIndex R S) : f.Monic := by
  induction hf using Submonoid.closure_induction with
  | mem _ h =>
    rcases h with ⟨n, _, rfl⟩
    exact cyclotomic.monic n R
  | one => exact monic_one
  | mul _ _ _ _ hf₁ hf₂ => exact hf₁.mul hf₂

/-- Every index in `cycloIndex R S` is monic as a polynomial in `R[X]`. -/
theorem cycloIndex.monic {S : Set ℕ} (f : cycloIndex R S) : (f : R[X]).Monic :=
  monic_of_mem_cycloIndex f.2

/-- Every polynomial in `cycloIndex R S` is a regular element of `R[X]`. -/
theorem isRegular_of_mem_cycloIndex {S : Set ℕ} {f : R[X]} (hf : f ∈ cycloIndex R S) :
    IsRegular f :=
  (monic_of_mem_cycloIndex hf).isRegular

/-- The cyclotomic index monoid is monotone in the order set `S`. -/
@[gcongr]
theorem cycloIndex_mono {S T : Set ℕ} (hTS : T ⊆ S) : cycloIndex R T ≤ cycloIndex R S :=
  Submonoid.closure_mono (Set.image_mono hTS)

/-- An empty order set generates the trivial submonoid `{1}`. -/
@[simp]
theorem cycloIndex_empty (R : Type*) [CommRing R] : cycloIndex R ∅ = ⊥ := by
  simp [cycloIndex_def]

/-- Adjoining order `0` does not change `cycloIndex R S`, since `cyclotomic 0 R = 1`. -/
@[simp]
theorem cycloIndex_insert_zero (R : Type*) [CommRing R] (S : Set ℕ) :
    cycloIndex R (insert 0 S) = cycloIndex R S := by
  refine le_antisymm (Submonoid.closure_le.mpr ?_) (cycloIndex_mono (Set.subset_insert 0 S))
  rintro _ ⟨n, rfl | hn, rfl⟩
  · simp [cyclotomic_zero]
  · exact cyclotomic_mem_cycloIndex hn

/-- Removing order `0` does not change `cycloIndex R S`, since `cyclotomic 0 R = 1`. -/
@[simp]
theorem cycloIndex_sdiff_singleton_zero (R : Type*) [CommRing R] (S : Set ℕ) :
    cycloIndex R (S \ {0}) = cycloIndex R S := by
  refine le_antisymm (cycloIndex_mono Set.sdiff_subset) (Submonoid.closure_le.mpr ?_)
  rintro _ ⟨n, hn, rfl⟩
  rcases eq_or_ne n 0 with rfl | hn0
  · simp [cyclotomic_zero]
  · exact cyclotomic_mem_cycloIndex ⟨hn, hn0⟩

/-- If `S` contains no positive orders, `cycloIndex R S` is trivial. -/
theorem cycloIndex_eq_bot_of_forall_eq_zero {S : Set ℕ} (hS : ∀ n ∈ S, n = 0) :
    cycloIndex R S = ⊥ := by
  rw [← cycloIndex_sdiff_singleton_zero]
  convert cycloIndex_empty R
  ext n
  simpa using hS n

@[simp]
theorem cycloIndex_singleton_zero (R : Type*) [CommRing R] : cycloIndex R {0} = ⊥ :=
  cycloIndex_eq_bot_of_forall_eq_zero fun _ hn ↦ hn

/-- `cycloIndex R S` is trivial if and only if `R` is subsingleton or `S` contains no positive
orders. -/
theorem cycloIndex_eq_bot_iff (R : Type*) [CommRing R] (S : Set ℕ) :
    cycloIndex R S = ⊥ ↔ Subsingleton R ∨ ∀ n ∈ S, n = 0 := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · by_cases hR : Subsingleton R
    · exact Or.inl hR
    · rw [not_subsingleton_iff_nontrivial] at hR
      refine Or.inr fun n hn ↦ by_contra fun hn0 ↦ ?_
      have hmem : cyclotomic n R ∈ (⊥ : Submonoid R[X]) := h ▸ cyclotomic_mem_cycloIndex hn
      rw [Submonoid.mem_bot] at hmem
      have hdeg := congrArg natDegree hmem
      rw [natDegree_cyclotomic, natDegree_one] at hdeg
      exact (Nat.totient_pos.mpr (Nat.pos_of_ne_zero hn0)).ne' hdeg
  · rintro (hR | hS)
    · exact Subsingleton.elim _ _
    · exact cycloIndex_eq_bot_of_forall_eq_zero hS

/-- In characteristic two, `cyclotomic 1 R = cyclotomic 2 R`, so `{1}` and `{2}` generate the same
cyclotomic index monoid. -/
theorem cycloIndex_singleton_one_eq_singleton_two (R : Type*) [CommRing R] [CharP R 2] :
    cycloIndex R {1} = cycloIndex R {2} := by
  simp only [cycloIndex_def, Set.image_singleton, cyclotomic_one, cyclotomic_two,
    CharTwo.sub_eq_add]

/-- Base change along `φ : R →+* R'` maps `cycloIndex R S` onto `cycloIndex R' S`. -/
@[simp]
theorem map_cycloIndex (φ : R →+* R') (S : Set ℕ) :
    (cycloIndex R S).map (Polynomial.mapRingHom φ) = cycloIndex R' S := by
  rw [← Submonoid.map_coe_toMonoidHom, ← RingHom.toMonoidHom_eq_coe, cycloIndex_def,
    cycloIndex_def, MonoidHom.map_mclosure]
  congr 1
  ext p
  simp [Polynomial.map_cyclotomic]

/-- Mapping polynomials along a ring homomorphism `φ : R →+* R'` carries `cycloIndex R S` into
`cycloIndex R' S`. -/
theorem map_mem_cycloIndex (φ : R →+* R') {S : Set ℕ} {f : R[X]} (hf : f ∈ cycloIndex R S) :
    f.map φ ∈ cycloIndex R' S :=
  map_cycloIndex φ S ▸ Submonoid.mem_map_of_mem (Polynomial.mapRingHom φ) hf

/-- Every index in `cycloIndex R' S` is the base change of an index in `cycloIndex R S`. -/
theorem exists_map_eq_of_mem_cycloIndex (φ : R →+* R') {S : Set ℕ} {f' : R'[X]}
    (hf' : f' ∈ cycloIndex R' S) : ∃ f : cycloIndex R S, (f : R[X]).map φ = f' := by
  rw [← map_cycloIndex φ S, Submonoid.mem_map] at hf'
  rcases hf' with ⟨f, hf, rfl⟩
  exact ⟨⟨f, hf⟩, rfl⟩

/-- Any two indices in `cycloIndex R S` divide a common index in `cycloIndex R S` (namely their
product), making `(cycloIndex R S, ∣)` directed. -/
theorem cycloIndex.exists_dvd_and_dvd {S : Set ℕ} (f g : cycloIndex R S) :
    ∃ h : cycloIndex R S, (f : R[X]) ∣ h ∧ (g : R[X]) ∣ h :=
  ⟨f * g, dvd_mul_right (f : R[X]) g, dvd_mul_left (g : R[X]) f⟩

end Basic

section Cofinal

variable {R R' : Type*} [CommRing R] [CommRing R']

open Classical in
/-- An explicit countable cofinal chain in `cycloIndex R S`: at level `N`, the product of
`(cyclotomic n R) ^ N` over all `n ∈ S` with `1 ≤ n ≤ N`. -/
noncomputable def cycloChain (R : Type*) [CommRing R] (S : Set ℕ) (N : ℕ) : R[X] :=
  ∏ n ∈ (Finset.Icc 1 N).filter (· ∈ S), cyclotomic n R ^ N

open Classical in
theorem cycloChain_def (R : Type*) [CommRing R] (S : Set ℕ) (N : ℕ) :
    cycloChain R S N = ∏ n ∈ (Finset.Icc 1 N).filter (· ∈ S), cyclotomic n R ^ N :=
  (rfl)

@[simp]
theorem cycloChain_zero (R : Type*) [CommRing R] (S : Set ℕ) : cycloChain R S 0 = 1 := by
  classical
  simp [cycloChain_def]

/-- Each term of `cycloChain R S` belongs to `cycloIndex R S`. -/
theorem cycloChain_mem_cycloIndex (R : Type*) [CommRing R] (S : Set ℕ) (N : ℕ) :
    cycloChain R S N ∈ cycloIndex R S := by
  classical
  exact prod_cyclotomic_pow_mem_cycloIndex _ id (fun _ ↦ N) fun n hn ↦ (Finset.mem_filter.mp hn).2

/-- `cycloChain R S N` bundled as an element of `cycloIndex R S`. -/
noncomputable def cycloChainIndex (R : Type*) [CommRing R] (S : Set ℕ) (N : ℕ) :
    cycloIndex R S :=
  ⟨cycloChain R S N, cycloChain_mem_cycloIndex R S N⟩

@[simp]
theorem coe_cycloChainIndex (R : Type*) [CommRing R] (S : Set ℕ) (N : ℕ) :
    (cycloChainIndex R S N : R[X]) = cycloChain R S N :=
  (rfl)

@[simp]
theorem cycloChainIndex_zero (R : Type*) [CommRing R] (S : Set ℕ) :
    cycloChainIndex R S 0 = 1 :=
  Subtype.ext (cycloChain_zero R S)

/-- `cycloChain` commutes with coefficient ring homomorphisms. -/
@[simp]
theorem map_cycloChain (φ : R →+* R') (S : Set ℕ) (N : ℕ) :
    (cycloChain R S N).map φ = cycloChain R' S N := by
  classical
  simp [cycloChain_def, Polynomial.map_prod, Polynomial.map_cyclotomic]

/-- Enlarging the order set `S` produces a multiple in `cycloChain` at every level `N`. -/
theorem cycloChain_dvd_of_subset {S T : Set ℕ} (hTS : T ⊆ S) (N : ℕ) :
    cycloChain R T N ∣ cycloChain R S N := by
  classical
  refine Finset.prod_dvd_prod_of_subset _ _ _ fun n hn ↦ ?_
  rw [Finset.mem_filter] at hn ⊢
  exact ⟨hn.1, hTS hn.2⟩

/-- `cycloChain R S` is a divisibility chain: `cycloChain R S M ∣ cycloChain R S N` for `M ≤ N`. -/
theorem cycloChain_dvd_of_le {S : Set ℕ} {M N : ℕ} (hMN : M ≤ N) :
    cycloChain R S M ∣ cycloChain R S N := by
  classical
  have hsub : (Finset.Icc 1 M).filter (· ∈ S) ⊆ (Finset.Icc 1 N).filter (· ∈ S) := by
    intro n hn
    rw [Finset.mem_filter, Finset.mem_Icc] at hn ⊢
    exact ⟨⟨hn.1.1, hn.1.2.trans hMN⟩, hn.2⟩
  refine dvd_trans (Finset.prod_dvd_prod_of_dvd _ _ fun n _ ↦ pow_dvd_pow (cyclotomic n R) hMN) ?_
  exact Finset.prod_dvd_prod_of_subset _ _ _ hsub

/-- Multiplying terms at levels `M` and `N` divides the term at level `M + N`. -/
theorem cycloChain_mul_dvd_add (R : Type*) [CommRing R] (S : Set ℕ) (M N : ℕ) :
    cycloChain R S M * cycloChain R S N ∣ cycloChain R S (M + N) := by
  classical
  let T := (Finset.Icc 1 (M + N)).filter (· ∈ S)
  have hM : (Finset.Icc 1 M).filter (· ∈ S) ⊆ T := by
    intro n hn
    rw [Finset.mem_filter, Finset.mem_Icc] at hn ⊢
    exact ⟨⟨hn.1.1, hn.1.2.trans (Nat.le_add_right M N)⟩, hn.2⟩
  have hN : (Finset.Icc 1 N).filter (· ∈ S) ⊆ T := by
    intro n hn
    rw [Finset.mem_filter, Finset.mem_Icc] at hn ⊢
    exact ⟨⟨hn.1.1, hn.1.2.trans (Nat.le_add_left N M)⟩, hn.2⟩
  have hdvd₁ : cycloChain R S M ∣ ∏ n ∈ T, cyclotomic n R ^ M :=
    Finset.prod_dvd_prod_of_subset _ _ _ hM
  have hdvd₂ : cycloChain R S N ∣ ∏ n ∈ T, cyclotomic n R ^ N :=
    Finset.prod_dvd_prod_of_subset _ _ _ hN
  refine dvd_trans (mul_dvd_mul hdvd₁ hdvd₂) ?_
  rw [← Finset.prod_mul_distrib]
  simp_rw [← pow_add]
  exact dvd_rfl

/-- Cofinality of `cycloChain`: every polynomial in `cycloIndex R S` divides some
`cycloChain R S N`. -/
theorem exists_dvd_cycloChain {S : Set ℕ} {f : R[X]} (hf : f ∈ cycloIndex R S) :
    ∃ N : ℕ, f ∣ cycloChain R S N := by
  classical
  induction hf using Submonoid.closure_induction with
  | mem _ h =>
    rcases h with ⟨n, hn, rfl⟩
    rcases eq_or_ne n 0 with rfl | hn0
    · exact ⟨0, by simp [cyclotomic_zero]⟩
    · refine ⟨n, dvd_trans (dvd_pow_self _ hn0) ?_⟩
      refine Finset.dvd_prod_of_mem _ ?_
      rw [Finset.mem_filter, Finset.mem_Icc]
      exact ⟨⟨Nat.pos_of_ne_zero hn0, le_rfl⟩, hn⟩
  | one => exact ⟨0, one_dvd _⟩
  | mul _ _ _ _ hf₁ hf₂ =>
    rcases hf₁ with ⟨M, hM⟩
    rcases hf₂ with ⟨N, hN⟩
    exact ⟨M + N, dvd_trans (mul_dvd_mul hM hN) (cycloChain_mul_dvd_add R S M N)⟩

/-- For a finite order set `S`, the product `∏_{n ∈ S} cyclotomic n R`. -/
noncomputable def cycloProd (R : Type*) [CommRing R] {S : Set ℕ} (hS : S.Finite) : R[X] :=
  ∏ n ∈ hS.toFinset, cyclotomic n R

theorem cycloProd_def (R : Type*) [CommRing R] {S : Set ℕ} (hS : S.Finite) :
    cycloProd R hS = ∏ n ∈ hS.toFinset, cyclotomic n R :=
  (rfl)

@[simp]
theorem cycloProd_empty (R : Type*) [CommRing R] (hS : (∅ : Set ℕ).Finite) :
    cycloProd R hS = 1 := by
  simp [cycloProd_def]

@[simp]
theorem cycloProd_singleton (R : Type*) [CommRing R] {n : ℕ} (hS : ({n} : Set ℕ).Finite) :
    cycloProd R hS = cyclotomic n R := by
  simp [cycloProd_def]

/-- `cycloProd` commutes with coefficient ring homomorphisms. -/
@[simp]
theorem map_cycloProd (φ : R →+* R') {S : Set ℕ} (hS : S.Finite) :
    (cycloProd R hS).map φ = cycloProd R' hS := by
  simp [cycloProd_def, Polynomial.map_prod, Polynomial.map_cyclotomic]

/-- Every generator `cyclotomic n R` with `n ∈ S` divides `cycloProd R hS`. -/
theorem cyclotomic_dvd_cycloProd {S : Set ℕ} (hS : S.Finite) {n : ℕ} (hn : n ∈ S) :
    cyclotomic n R ∣ cycloProd R hS :=
  Finset.dvd_prod_of_mem _ (hS.mem_toFinset.mpr hn)

/-- `cycloProd R hS` belongs to `cycloIndex R S`. -/
theorem cycloProd_mem_cycloIndex (R : Type*) [CommRing R] {S : Set ℕ} (hS : S.Finite) :
    cycloProd R hS ∈ cycloIndex R S :=
  prod_mem fun _ hn ↦ cyclotomic_mem_cycloIndex (hS.mem_toFinset.mp hn)

/-- When `S` is finite, the powers of `cycloProd R hS` are cofinal in `cycloIndex R S`. -/
theorem exists_dvd_cycloProd_pow {S : Set ℕ} (hS : S.Finite) {f : R[X]}
    (hf : f ∈ cycloIndex R S) : ∃ k : ℕ, f ∣ cycloProd R hS ^ k := by
  induction hf using Submonoid.closure_induction with
  | mem _ h =>
    rcases h with ⟨n, hn, rfl⟩
    exact ⟨1, by simpa only [pow_one] using cyclotomic_dvd_cycloProd hS hn⟩
  | one => exact ⟨0, by simp⟩
  | mul _ _ _ _ hf₁ hf₂ =>
    rcases hf₁ with ⟨k₁, hk₁⟩
    rcases hf₂ with ⟨k₂, hk₂⟩
    exact ⟨k₁ + k₂, by rw [pow_add]; exact mul_dvd_mul hk₁ hk₂⟩

end Cofinal

end TauCeti
