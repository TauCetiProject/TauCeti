public import TauCeti.RingTheory.CyclotomicCompletion.Index
public import TauCeti.RingTheory.AdjoinRoot.Basic
public import Mathlib.RingTheory.Polynomial.Quotient

/-!
# Habiro's cyclotomic completion of a polynomial ring

Given a commutative ring `R` and a set `S : Set ℕ` of root orders, Habiro's `S`-cyclotomic
completion of `R[X]` is the `R`-subalgebra `CycloCompletion R S` of
`∀ f : cycloIndex R S, AdjoinRoot (f : R[X])` consisting of families `(x_f)` compatible with the
canonical quotient homomorphisms `AdjoinRoot.algHomOfDvd` whenever `f ∣ g` in `R[X]`.

Every polynomial `f ∈ cycloIndex R S` is monic and hence regular in `R[X]`. A fundamental feature
of the cyclotomic completion is that this regularity survives passage to the limit without any
domain hypothesis on `R`: for every `f : cycloIndex R S`, its image `fromPoly R S f` is a
nonzerodivisor in `CycloCompletion R S`, the kernel of the `f`-th projection `proj f` is the
principal ideal generated by `fromPoly R S f`, and the completed quotient
`CycloCompletion R S ⧸ Ideal.span {fromPoly R S f}` is canonically isomorphic as an `R`-algebra to
`AdjoinRoot (f : R[X])`.

## Main definitions

* `TauCeti.CycloCompletion.compatSubalgebra`: the `R`-subalgebra of
  `∀ f : cycloIndex R S, AdjoinRoot (f : R[X])` cut out by divisibility compatibility.
* `TauCeti.CycloCompletion`: the compatible-family carrier
  `↥(CycloCompletion.compatSubalgebra R S)`.
* `TauCeti.CycloCompletion.proj`: the `f`-th coordinate projection as an `R`-algebra homomorphism.
* `TauCeti.CycloCompletion.liftCompatAlgHom`: universal property of `CycloCompletion R S` as the
  limit of `AdjoinRoot (f : R[X])` in `R`-algebras.
* `TauCeti.CycloCompletion.fromPoly`: the canonical `R`-algebra map
  `R[X] →ₐ[R] CycloCompletion R S`.
* `TauCeti.CycloCompletion.quotientSpanAlgEquiv`: the canonical `R`-algebra isomorphism
  `(CycloCompletion R S ⧸ Ideal.span {fromPoly R S f}) ≃ₐ[R] AdjoinRoot (f : R[X])`.
* `TauCeti.CycloCompletion.quotientSpanXSubOneAlgEquiv`: when `1 ∈ S`, the evaluation isomorphism
  `(CycloCompletion R S ⧸ Ideal.span {fromPoly R S (X - 1)}) ≃ₐ[R] R`.

## Main results

* `TauCeti.CycloCompletion.fromPoly_injective_iff`: `fromPoly R S` is injective if and only if `R`
  is subsingleton or `S` contains a positive order.
* `TauCeti.CycloCompletion.isUnit_fromPoly_iff`,
  `TauCeti.CycloCompletion.not_isUnit_fromPoly_cyclotomic`: `fromPoly R S f` (`f : cycloIndex R S`)
  is a unit if and only if `(f : R[X]) = 1`; over nontrivial `R`, the image of `cyclotomic n R` is
  not a unit for `0 < n` with `n ∈ S`.
* `TauCeti.CycloCompletion.isRegular_fromPoly`: for every `f : cycloIndex R S`, `fromPoly R S f` is
  a regular element of `CycloCompletion R S`.
* `TauCeti.CycloCompletion.ker_proj`: `RingHom.ker (proj f) = Ideal.span {fromPoly R S f}`.
* `TauCeti.CycloCompletion.existsUnique_modByMonic_eq_fromPoly_add_mul`: every `x` in
  `CycloCompletion R S` decomposes uniquely as `fromPoly R S b + fromPoly R S f * c` with `b`
  reduced modulo `f`.

## References

* K. Habiro, *Cyclotomic completions of polynomial rings*, Publ. Res. Inst. Math. Sci. **40**
  (2004), 1127–1146, §1, §3.1, §4, and §6 (proof of Theorem 6.1).
-/

public section

open Polynomial

namespace TauCeti

section Carrier

variable {R : Type*} [CommRing R] {S : Set ℕ}

namespace CycloCompletion

/-- The `R`-subalgebra of `∀ f : cycloIndex R S, AdjoinRoot (f : R[X])` consisting of families
compatible along `AdjoinRoot.algHomOfDvd` whenever `f ∣ g`. -/
noncomputable def compatSubalgebra (R : Type*) [CommRing R] (S : Set ℕ) :
    Subalgebra R (∀ f : cycloIndex R S, AdjoinRoot (f : R[X])) where
  carrier := {x | ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
    AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (x g) = x f}
  zero_mem' := fun _ _ _ ↦ map_zero _
  one_mem' := fun _ _ _ ↦ map_one _
  add_mem' hx hy f g h := by simp only [Pi.add_apply, map_add, hx f g h, hy f g h]
  mul_mem' hx hy f g h := by simp only [Pi.mul_apply, map_mul, hx f g h, hy f g h]
  algebraMap_mem' r _ _ h := (AdjoinRoot.algHomOfDvd R _ _ h).commutes r

@[simp]
theorem mem_compatSubalgebra_iff {x : ∀ f : cycloIndex R S, AdjoinRoot (f : R[X])} :
    x ∈ compatSubalgebra R S ↔ ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
      AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (x g) = x f :=
  Iff.rfl

end CycloCompletion

/-- Habiro's `S`-cyclotomic completion of `R[X]`, realized as the `R`-algebra of compatible
families in `∀ f : cycloIndex R S, AdjoinRoot (f : R[X])`. -/
abbrev CycloCompletion (R : Type*) [CommRing R] (S : Set ℕ) :=
  ↥(CycloCompletion.compatSubalgebra R S)

namespace CycloCompletion

/-- The `f`-th quotient projection `CycloCompletion R S →ₐ[R] AdjoinRoot (f : R[X])`. -/
noncomputable def proj (f : cycloIndex R S) : CycloCompletion R S →ₐ[R] AdjoinRoot (f : R[X]) :=
  (Pi.evalAlgHom R (fun g : cycloIndex R S ↦ AdjoinRoot (g : R[X])) f).comp
    (compatSubalgebra R S).val

theorem proj_apply (f : cycloIndex R S) (x : CycloCompletion R S) :
    proj f x = x.1 f :=
  (rfl)

/-- Compatibility of coordinate projections along divisibility `f ∣ g` in `cycloIndex R S`. -/
@[simp]
theorem algHomOfDvd_proj {f g : cycloIndex R S} (h : (f : R[X]) ∣ g) (x : CycloCompletion R S) :
    AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (proj g x) = proj f x :=
  x.2 f g h

@[simp]
theorem algHomOfDvd_comp_proj {f g : cycloIndex R S} (h : (f : R[X]) ∣ g) :
    (AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h).comp (proj g) = proj f :=
  AlgHom.ext (algHomOfDvd_proj h)

@[ext]
theorem ext {x y : CycloCompletion R S} (h : ∀ f : cycloIndex R S, proj f x = proj f y) :
    x = y :=
  Subtype.ext (funext h)

/-- Construct an element of `CycloCompletion R S` from a family of classes compatible under
divisibility. -/
noncomputable def mk (x : ∀ f : cycloIndex R S, AdjoinRoot (f : R[X]))
    (hx : ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
      AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (x g) = x f) :
    CycloCompletion R S :=
  ⟨x, hx⟩

@[simp]
theorem proj_mk (f : cycloIndex R S) (x : ∀ g : cycloIndex R S, AdjoinRoot (g : R[X]))
    (hx : ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
      AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (x g) = x f) :
    proj f (mk x hx) = x f :=
  (rfl)

/-- Two elements of `CycloCompletion R S` are equal if their projections agree along the cofinal
chain `cycloChainIndex R S`. -/
theorem ext_of_cycloChain {x y : CycloCompletion R S}
    (h : ∀ N : ℕ, proj (cycloChainIndex R S N) x = proj (cycloChainIndex R S N) y) : x = y := by
  ext f
  obtain ⟨N, hN⟩ := exists_dvd_cycloChain f.2
  rw [← coe_cycloChainIndex] at hN
  rw [← algHomOfDvd_proj hN x, ← algHomOfDvd_proj hN y, h N]

/-- A polynomial sequence `p : ℕ → R[X]` satisfying `cycloChain R S N ∣ p (N + 1) - p N` for all `N`
determines an element of `CycloCompletion R S` projecting to the class of `p N` at each
`cycloChainIndex R S N`. -/
theorem exists_proj_cycloChainIndex_eq_mk {p : ℕ → R[X]}
    (hp : ∀ N : ℕ, cycloChain R S N ∣ p (N + 1) - p N) :
    ∃ x : CycloCompletion R S, ∀ N : ℕ,
      proj (cycloChainIndex R S N) x =
        AdjoinRoot.mk ((cycloChainIndex R S N : cycloIndex R S) : R[X]) (p N) := by
  have hp_dvd : ∀ {M N : ℕ}, M ≤ N → cycloChain R S M ∣ p N - p M := by
    intro M N hMN
    induction N, hMN using Nat.le_induction with
    | base => simp
    | succ N hMN ih =>
      have hstep : p (N + 1) - p M = (p N - p M) + (p (N + 1) - p N) := by ring
      rw [hstep]
      exact dvd_add ih ((cycloChain_dvd_of_le hMN).trans (hp N))
  have hp_mk_eq : ∀ (f : cycloIndex R S) {M N : ℕ},
      (f : R[X]) ∣ cycloChain R S M → (f : R[X]) ∣ cycloChain R S N →
      AdjoinRoot.mk (f : R[X]) (p M) = AdjoinRoot.mk (f : R[X]) (p N) := by
    intro f M N hM hN
    have hdM : (f : R[X]) ∣ p (max M N) - p M := hM.trans (hp_dvd (le_max_left M N))
    have hdN : (f : R[X]) ∣ p (max M N) - p N := hN.trans (hp_dvd (le_max_right M N))
    have hdMN : (f : R[X]) ∣ p M - p N := by
      simpa only [sub_sub_sub_cancel_left] using dvd_sub hdN hdM
    exact sub_eq_zero.mp (by rw [← map_sub]; exact AdjoinRoot.mk_eq_zero.mpr hdMN)
  choose MOf hMOf using fun f : cycloIndex R S ↦ exists_dvd_cycloChain f.2
  refine ⟨mk (fun f ↦ AdjoinRoot.mk (f : R[X]) (p (MOf f))) fun f g h ↦ ?_, fun N ↦ ?_⟩
  · rw [AdjoinRoot.algHomOfDvd_mk]
    exact hp_mk_eq f (h.trans (hMOf g)) (hMOf f)
  · exact hp_mk_eq (cycloChainIndex R S N) (hMOf _) (by rw [coe_cycloChainIndex])

/-- Universal property of `CycloCompletion R S` as the limit of `AdjoinRoot (f : R[X])` in the
category of `R`-algebras: a compatible cone of `R`-algebra maps out of `B` factors through
`CycloCompletion R S`. -/
noncomputable def liftCompatAlgHom {B : Type*} [Semiring B] [Algebra R B]
    (φ : ∀ f : cycloIndex R S, B →ₐ[R] AdjoinRoot (f : R[X]))
    (hφ : ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
      (AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h).comp (φ g) = φ f) :
    B →ₐ[R] CycloCompletion R S :=
  (AlgHom.pi φ).codRestrict (compatSubalgebra R S) fun b f g h ↦ AlgHom.congr_fun (hφ f g h) b

@[simp]
theorem proj_liftCompatAlgHom {B : Type*} [Semiring B] [Algebra R B]
    (φ : ∀ f : cycloIndex R S, B →ₐ[R] AdjoinRoot (f : R[X]))
    (hφ : ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
      (AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h).comp (φ g) = φ f)
    (f : cycloIndex R S) (b : B) :
    proj f (liftCompatAlgHom φ hφ b) = φ f b :=
  (rfl)

@[simp]
theorem proj_comp_liftCompatAlgHom {B : Type*} [Semiring B] [Algebra R B]
    (φ : ∀ f : cycloIndex R S, B →ₐ[R] AdjoinRoot (f : R[X]))
    (hφ : ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
      (AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h).comp (φ g) = φ f)
    (f : cycloIndex R S) :
    (proj f).comp (liftCompatAlgHom φ hφ) = φ f :=
  (rfl)

/-- Two `R`-algebra homomorphisms into `CycloCompletion R S` are equal if their compositions with
every projection `proj f` agree. -/
theorem algHom_ext {B : Type*} [Semiring B] [Algebra R B] {φ ψ : B →ₐ[R] CycloCompletion R S}
    (h : ∀ f : cycloIndex R S, (proj f).comp φ = (proj f).comp ψ) : φ = ψ :=
  AlgHom.ext fun b ↦ ext fun f ↦ AlgHom.congr_fun (h f) b

/-- The canonical `R`-algebra homomorphism from `R[X]` into `CycloCompletion R S` sending a
polynomial `p` to the compatible family `(AdjoinRoot.mk f p)_f`. -/
noncomputable def fromPoly (R : Type*) [CommRing R] (S : Set ℕ) :
    R[X] →ₐ[R] CycloCompletion R S :=
  liftCompatAlgHom (fun f ↦ AdjoinRoot.mkₐ (f : R[X])) fun _ _ _ ↦ Polynomial.algHom_ext (by simp)

theorem fromPoly_C (R : Type*) [CommRing R] (S : Set ℕ) (r : R) :
    fromPoly R S (C r) = algebraMap R (CycloCompletion R S) r :=
  (fromPoly R S).commutes r

@[simp]
theorem proj_fromPoly (f : cycloIndex R S) (p : R[X]) :
    proj f (fromPoly R S p) = AdjoinRoot.mk (f : R[X]) p :=
  (rfl)

@[simp]
theorem proj_comp_fromPoly (f : cycloIndex R S) :
    (proj f).comp (fromPoly R S) = AdjoinRoot.mkₐ (f : R[X]) :=
  (rfl)

/-- Every coordinate projection `proj f : CycloCompletion R S →ₐ[R] AdjoinRoot (f : R[X])` is
surjective. -/
theorem proj_surjective (f : cycloIndex R S) : Function.Surjective (proj f) := fun a ↦ by
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective a
  exact ⟨fromPoly R S p, rfl⟩

end CycloCompletion

end Carrier

section DegeneracyAndInjectivity

variable {R : Type*} [CommRing R] {S : Set ℕ}

namespace CycloCompletion

/-- If `cycloIndex R S = ⊥`, then `CycloCompletion R S` is subsingleton. -/
theorem subsingleton_of_cycloIndex_eq_bot (h : cycloIndex R S = ⊥) :
    Subsingleton (CycloCompletion R S) := by
  refine subsingleton_of_zero_eq_one (ext fun f ↦ ?_)
  have hf : (f : R[X]) = 1 := Submonoid.mem_bot.mp (h ▸ f.2)
  rw [map_zero, map_one, ← map_one (AdjoinRoot.mk (f : R[X])), ← hf, AdjoinRoot.mk_self]

/-- If `S` contains no positive orders, `CycloCompletion R S` is subsingleton. -/
theorem subsingleton_of_forall_eq_zero (hS : ∀ n ∈ S, n = 0) :
    Subsingleton (CycloCompletion R S) :=
  subsingleton_of_cycloIndex_eq_bot (cycloIndex_eq_bot_of_forall_eq_zero hS)

instance (R : Type*) [CommRing R] : Subsingleton (CycloCompletion R ∅) :=
  subsingleton_of_cycloIndex_eq_bot (cycloIndex_empty R)

instance (R : Type*) [CommRing R] : Subsingleton (CycloCompletion R {0}) :=
  subsingleton_of_cycloIndex_eq_bot (cycloIndex_singleton_zero R)

instance [Subsingleton R] : Subsingleton (CycloCompletion R S) := by
  refine subsingleton_of_zero_eq_one (ext fun f ↦ ?_)
  rw [map_zero, map_one, ← map_one (AdjoinRoot.mk (f : R[X])),
    Subsingleton.elim (1 : R[X]) (f : R[X]), AdjoinRoot.mk_self]

/-- When `R` is nontrivial and `S` contains a positive order `n`, `CycloCompletion R S` is
nontrivial. -/
theorem nontrivial_of_pos [Nontrivial R] {n : ℕ} (hn : n ∈ S) (hpos : 0 < n) :
    Nontrivial (CycloCompletion R S) := by
  let f : cycloIndex R S := ⟨cyclotomic n R, cyclotomic_mem_cycloIndex hn⟩
  have hf : Nontrivial (AdjoinRoot (f : R[X])) := by
    rw [AdjoinRoot.nontrivial_iff_of_monic (cycloIndex.monic f)]
    simpa [f, degree_cyclotomic] using Nat.totient_pos.mpr hpos
  exact (proj_surjective f).nontrivial

/-- `CycloCompletion R S` is subsingleton if and only if `R` is subsingleton or `S` contains no
positive orders. -/
theorem subsingleton_iff (R : Type*) [CommRing R] (S : Set ℕ) :
    Subsingleton (CycloCompletion R S) ↔ Subsingleton R ∨ ∀ n ∈ S, n = 0 := by
  rw [← cycloIndex_eq_bot_iff]
  refine ⟨fun h ↦ ?_, subsingleton_of_cycloIndex_eq_bot⟩
  by_contra hne
  rw [cycloIndex_eq_bot_iff] at hne
  push Not at hne
  rcases hne with ⟨hR, n, hn, hn0⟩
  have : Nontrivial (CycloCompletion R S) := nontrivial_of_pos hn (Nat.pos_of_ne_zero hn0)
  exact not_subsingleton (CycloCompletion R S) h

/-- For `1 ∈ S`, the image of `X` in the `Φ₁`-quotient of `CycloCompletion R S` is `1`. -/
theorem proj_cyclotomic_one_fromPoly_X (h1 : 1 ∈ S) :
    proj ⟨cyclotomic 1 R, cyclotomic_mem_cycloIndex h1⟩ (fromPoly R S X) = 1 := by
  rw [proj_fromPoly]
  refine sub_eq_zero.mp ?_
  rw [← map_one (AdjoinRoot.mk _), ← map_sub, ← cyclotomic_one, AdjoinRoot.mk_self]

/-- Whenever `S` contains a positive order `n`, the polynomial map `fromPoly R S` is injective
over any commutative ring `R`. -/
theorem fromPoly_injective_of_pos {n : ℕ} (hn : n ∈ S) (hpos : 0 < n) :
    Function.Injective (fromPoly R S) := by
  by_cases hR : Subsingleton R
  · intro p q _
    exact Subsingleton.elim p q
  · rw [not_subsingleton_iff_nontrivial] at hR
    rw [injective_iff_map_eq_zero]
    intro p hp
    let k := p.natDegree + 1
    let g : cycloIndex R S := ⟨cyclotomic n R ^ k, cyclotomic_pow_mem_cycloIndex hn k⟩
    have hg : (g : R[X]).Monic := cycloIndex.monic g
    have hdvd : (g : R[X]) ∣ p := by
      rw [← AdjoinRoot.mk_eq_zero, ← proj_fromPoly g p, hp, map_zero]
    have htot : 1 ≤ n.totient := Nat.totient_pos.mpr hpos
    have hdeg : p.degree < (g : R[X]).degree := by
      calc
        p.degree ≤ p.natDegree := degree_le_natDegree
        _ < (k : WithBot ℕ) := WithBot.coe_lt_coe.mpr (Nat.lt_succ_self _)
        _ ≤ (k * n.totient : ℕ) := WithBot.coe_le_coe.mpr (Nat.le_mul_of_pos_right k htot)
        _ = (g : R[X]).degree := by
          rw [degree_eq_natDegree hg.ne_zero]
          simp [g, (cyclotomic.monic n R).natDegree_pow, natDegree_cyclotomic]
    rw [← (modByMonic_eq_self_iff hg).mpr hdeg, (modByMonic_eq_zero_iff_dvd hg).mpr hdvd]

/-- `fromPoly R S` is injective if and only if `R` is subsingleton or `S` contains a positive
order. -/
theorem fromPoly_injective_iff (R : Type*) [CommRing R] (S : Set ℕ) :
    Function.Injective (fromPoly R S) ↔ Subsingleton R ∨ ∃ n ∈ S, 0 < n := by
  refine ⟨fun hinj ↦ ?_, ?_⟩
  · by_cases hR : Subsingleton R
    · exact Or.inl hR
    · rw [not_subsingleton_iff_nontrivial] at hR
      refine Or.inr (by_contra fun hno ↦ ?_)
      push Not at hno
      have hsub : Subsingleton (CycloCompletion R S) :=
        subsingleton_of_forall_eq_zero fun n hn ↦ Nat.eq_zero_of_le_zero (hno n hn)
      exact zero_ne_one (hinj (Subsingleton.elim (fromPoly R S 0) (fromPoly R S 1)))
  · rintro (hR | ⟨n, hn, hpos⟩)
    · intro p q _
      exact Subsingleton.elim p q
    · exact fromPoly_injective_of_pos hn hpos

/-- For `f : cycloIndex R S`, `fromPoly R S f` is a unit in `CycloCompletion R S` if and only if
`(f : R[X]) = 1`. -/
theorem isUnit_fromPoly_iff (f : cycloIndex R S) :
    IsUnit (fromPoly R S (f : R[X])) ↔ (f : R[X]) = 1 := by
  refine ⟨fun hu ↦ ?_, fun h ↦ h ▸ by rw [map_one]; exact isUnit_one⟩
  have h0 : IsUnit (0 : AdjoinRoot (f : R[X])) := by
    simpa only [proj_fromPoly, AdjoinRoot.mk_self] using hu.map (proj f)
  have h1 : AdjoinRoot.mk (f : R[X]) 1 = 0 := by
    rw [map_one]
    exact (isUnit_zero_iff.mp h0).symm
  exact (cycloIndex.monic f).eq_one_of_isUnit (isUnit_iff_dvd_one.mpr (AdjoinRoot.mk_eq_zero.mp h1))

/-- Over a nontrivial ring `R`, the image of `cyclotomic n R` in `CycloCompletion R S` is not a
unit for any positive order `n ∈ S`. -/
theorem not_isUnit_fromPoly_cyclotomic [Nontrivial R] {n : ℕ} (hn : n ∈ S) (hpos : 0 < n) :
    ¬ IsUnit (fromPoly R S (cyclotomic n R)) := by
  rw [isUnit_fromPoly_iff ⟨cyclotomic n R, cyclotomic_mem_cycloIndex hn⟩]
  intro h
  exact (Nat.totient_pos.mpr hpos).ne'
    (by simpa only [natDegree_cyclotomic, natDegree_one] using congrArg natDegree h)

end CycloCompletion

end DegeneracyAndInjectivity

section QuotientAndRegularity

variable {R : Type*} [CommRing R] {S : Set ℕ}

namespace CycloCompletion

/-- Every polynomial `f ∈ cycloIndex R S` maps to a regular element (nonzerodivisor) in
`CycloCompletion R S`, over an arbitrary commutative ring `R`. -/
theorem isRegular_fromPoly (f : cycloIndex R S) : IsRegular (fromPoly R S (f : R[X])) := by
  refine (Commute.isRegular_iff (Commute.all _)).mpr fun x y hxy ↦ ?_
  rw [← sub_eq_zero, ← mul_sub] at hxy
  suffices x - y = 0 by exact sub_eq_zero.mp this
  ext g
  rw [map_zero]
  obtain ⟨p, hp⟩ := AdjoinRoot.mk_surjective (proj (f * g) (x - y))
  have hfg : AdjoinRoot.mk ((f * g : cycloIndex R S) : R[X]) ((f : R[X]) * p) = 0 := by
    rw [map_mul, hp, ← proj_fromPoly (f * g), ← map_mul, hxy, map_zero]
  obtain ⟨q, hq⟩ := AdjoinRoot.mk_eq_zero.mp hfg
  have hcancel : p = (g : R[X]) * q := (cycloIndex.monic f).isRegular.left (by
    calc
      (f : R[X]) * p = ((f * g : cycloIndex R S) : R[X]) * q := hq
      _ = (f : R[X]) * ((g : R[X]) * q) := mul_assoc _ _ _)
  have hdvd : (g : R[X]) ∣ ((f * g : cycloIndex R S) : R[X]) := dvd_mul_left (g : R[X]) (f : R[X])
  rw [← algHomOfDvd_proj hdvd (x - y), ← hp, AdjoinRoot.algHomOfDvd_mk]
  exact AdjoinRoot.mk_eq_zero.mpr ⟨q, hcancel⟩

/-- Left multiplication by `fromPoly R S f` on `CycloCompletion R S` is injective for every
`f : cycloIndex R S`. -/
theorem fromPoly_mul_injective (f : cycloIndex R S) :
    Function.Injective (fromPoly R S (f : R[X]) * ·) :=
  (isRegular_fromPoly f).left

/-- An element `x : CycloCompletion R S` projects to `0` at `f` if and only if `fromPoly R S f`
divides `x` in `CycloCompletion R S`. -/
theorem proj_eq_zero_iff_dvd (f : cycloIndex R S) (x : CycloCompletion R S) :
    proj f x = 0 ↔ fromPoly R S (f : R[X]) ∣ x := by
  have hf : (f : R[X]).Monic := cycloIndex.monic f
  refine ⟨fun hx ↦ ?_, ?_⟩
  · let r : cycloIndex R S → R[X] := fun g ↦
      AdjoinRoot.modByMonicHom (cycloIndex.monic (f * g)) (proj (f * g) x)
    have hr_mk (g : cycloIndex R S) :
        AdjoinRoot.mk ((f * g : cycloIndex R S) : R[X]) (r g) = proj (f * g) x :=
      AdjoinRoot.mk_leftInverse (cycloIndex.monic (f * g)) (proj (f * g) x)
    have hr_eq (g : cycloIndex R S) : (f : R[X]) * (r g /ₘ (f : R[X])) = r g := by
      have hdvd : (f : R[X]) ∣ r g := by
        rw [← AdjoinRoot.mk_eq_zero]
        have hdvd_fg : (f : R[X]) ∣ ((f * g : cycloIndex R S) : R[X]) :=
          dvd_mul_right (f : R[X]) (g : R[X])
        have hcomp := algHomOfDvd_proj hdvd_fg x
        rw [← hr_mk g, AdjoinRoot.algHomOfDvd_mk, hx] at hcomp
        exact hcomp
      have hmod : r g %ₘ (f : R[X]) = 0 := (modByMonic_eq_zero_iff_dvd hf).mpr hdvd
      simpa [hmod] using modByMonic_add_div (r g) (f : R[X])
    refine ⟨mk (fun g ↦ AdjoinRoot.mk (g : R[X]) (r g /ₘ (f : R[X]))) fun g₁ g₂ h ↦ ?_, ?_⟩
    · rw [AdjoinRoot.algHomOfDvd_mk]
      refine sub_eq_zero.mp ?_
      rw [← map_sub, AdjoinRoot.mk_eq_zero]
      have hfg : ((f * g₁ : cycloIndex R S) : R[X]) ∣ (f * g₂ : cycloIndex R S) :=
        mul_dvd_mul_left (f : R[X]) h
      have hsub : AdjoinRoot.mk ((f * g₁ : cycloIndex R S) : R[X]) (r g₂ - r g₁) = 0 := by
        rw [map_sub, hr_mk g₁, ← algHomOfDvd_proj hfg x, ← hr_mk g₂,
          AdjoinRoot.algHomOfDvd_mk, sub_self]
      obtain ⟨k, hk⟩ := AdjoinRoot.mk_eq_zero.mp hsub
      refine ⟨k, hf.isRegular.left ?_⟩
      calc
        (f : R[X]) * (r g₂ /ₘ (f : R[X]) - r g₁ /ₘ (f : R[X]))
          = r g₂ - r g₁ := by rw [mul_sub, hr_eq g₂, hr_eq g₁]
        _ = ((f * g₁ : cycloIndex R S) : R[X]) * k := hk
        _ = (f : R[X]) * ((g₁ : R[X]) * k) := mul_assoc _ _ _
    · ext g
      rw [map_mul, proj_fromPoly, proj_mk, ← map_mul, hr_eq g]
      have hdvd_gf : (g : R[X]) ∣ ((f * g : cycloIndex R S) : R[X]) :=
        dvd_mul_left (g : R[X]) (f : R[X])
      have hcomp := algHomOfDvd_proj hdvd_gf x
      rw [← hr_mk g, AdjoinRoot.algHomOfDvd_mk] at hcomp
      exact hcomp.symm
  · rintro ⟨c, rfl⟩
    rw [map_mul, proj_fromPoly, AdjoinRoot.mk_self, zero_mul]

/-- The kernel of `proj f : CycloCompletion R S →ₐ[R] AdjoinRoot (f : R[X])` is the principal
ideal generated by `fromPoly R S f`. -/
theorem ker_proj (f : cycloIndex R S) :
    RingHom.ker (proj f) = Ideal.span {fromPoly R S (f : R[X])} := by
  ext x
  rw [RingHom.mem_ker, Ideal.mem_span_singleton]
  exact proj_eq_zero_iff_dvd f x

@[simp]
theorem ker_proj_one : RingHom.ker (proj (1 : cycloIndex R S)) = ⊤ := by
  rw [ker_proj]
  simp

/-- Every `x : CycloCompletion R S` decomposes uniquely as `fromPoly R S b + fromPoly R S f * c`
where `b : R[X]` is reduced modulo the monic polynomial `f` (`b %ₘ f = b`). -/
theorem existsUnique_modByMonic_eq_fromPoly_add_mul (f : cycloIndex R S)
    (x : CycloCompletion R S) :
    ∃! bc : R[X] × CycloCompletion R S,
      bc.1 %ₘ (f : R[X]) = bc.1 ∧ x = fromPoly R S bc.1 + fromPoly R S (f : R[X]) * bc.2 := by
  have hf : (f : R[X]).Monic := cycloIndex.monic f
  let b₀ := AdjoinRoot.modByMonicHom hf (proj f x)
  have hb₀_mk : AdjoinRoot.mk (f : R[X]) b₀ = proj f x :=
    AdjoinRoot.mk_leftInverse hf (proj f x)
  have hb₀_mod : b₀ %ₘ (f : R[X]) = b₀ := by
    rw [← AdjoinRoot.modByMonicHom_mk hf b₀, hb₀_mk]
  have hzero : proj f (x - fromPoly R S b₀) = 0 := by
    rw [map_sub, proj_fromPoly, hb₀_mk, sub_self]
  obtain ⟨c₀, hc₀⟩ := (proj_eq_zero_iff_dvd f (x - fromPoly R S b₀)).mp hzero
  refine ⟨(b₀, c₀), ⟨hb₀_mod, eq_add_of_sub_eq' hc₀⟩, ?_⟩
  rintro ⟨b, c⟩ ⟨hb_mod, hx_eq⟩
  have hb_mk : AdjoinRoot.mk (f : R[X]) b = proj f x := by
    have hproj := congrArg (proj f) hx_eq
    simpa [AdjoinRoot.mk_self] using hproj.symm
  have hb_eq : b = b₀ := by
    calc
      b = b %ₘ (f : R[X]) := hb_mod.symm
      _ = AdjoinRoot.modByMonicHom hf (AdjoinRoot.mk (f : R[X]) b) :=
        (AdjoinRoot.modByMonicHom_mk hf b).symm
      _ = b₀ := by rw [hb_mk]
  subst hb_eq
  refine Prod.ext rfl (fromPoly_mul_injective f ?_)
  linear_combination hx_eq.symm + hc₀

/-- Every `x : CycloCompletion R S` is congruent modulo `fromPoly R S f` to a polynomial with the
same image under `proj f`. -/
theorem exists_eq_fromPoly_add_mul (f : cycloIndex R S) (x : CycloCompletion R S) :
    ∃ (b : R[X]) (c : CycloCompletion R S),
      AdjoinRoot.mk (f : R[X]) b = proj f x ∧ x = fromPoly R S b + fromPoly R S (f : R[X]) * c := by
  obtain ⟨⟨b, c⟩, ⟨_, hx⟩, _⟩ := existsUnique_modByMonic_eq_fromPoly_add_mul f x
  refine ⟨b, c, ?_, hx⟩
  have hproj := congrArg (proj f) hx
  simpa [AdjoinRoot.mk_self] using hproj.symm

/-- The completed finite quotient `CycloCompletion R S ⧸ Ideal.span {fromPoly R S f}` is
canonically isomorphic as an `R`-algebra to `AdjoinRoot (f : R[X])`. -/
noncomputable def quotientSpanAlgEquiv (f : cycloIndex R S) :
    (CycloCompletion R S ⧸ Ideal.span {fromPoly R S (f : R[X])}) ≃ₐ[R] AdjoinRoot (f : R[X]) :=
  (Ideal.quotientEquivAlgOfEq R (ker_proj f).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (proj_surjective f))

@[simp]
theorem quotientSpanAlgEquiv_mk (f : cycloIndex R S) (x : CycloCompletion R S) :
    quotientSpanAlgEquiv f (Ideal.Quotient.mk _ x) = proj f x := by
  simp [quotientSpanAlgEquiv]

theorem quotientSpanAlgEquiv_mk_fromPoly (f : cycloIndex R S) (p : R[X]) :
    quotientSpanAlgEquiv f (Ideal.Quotient.mk _ (fromPoly R S p)) = AdjoinRoot.mk (f : R[X]) p := by
  simp

@[simp]
theorem quotientSpanAlgEquiv_symm_proj (f : cycloIndex R S) (x : CycloCompletion R S) :
    (quotientSpanAlgEquiv f).symm (proj f x) = Ideal.Quotient.mk _ x :=
  (quotientSpanAlgEquiv f).symm_apply_eq.mpr (quotientSpanAlgEquiv_mk f x).symm

@[simp]
theorem quotientSpanAlgEquiv_symm_mk (f : cycloIndex R S) (p : R[X]) :
    (quotientSpanAlgEquiv f).symm (AdjoinRoot.mk (f : R[X]) p) =
      Ideal.Quotient.mk _ (fromPoly R S p) := by
  rw [← proj_fromPoly, quotientSpanAlgEquiv_symm_proj]

@[simp]
theorem quotientSpanAlgEquiv_symm_root (f : cycloIndex R S) :
    (quotientSpanAlgEquiv f).symm (AdjoinRoot.root (f : R[X])) =
      Ideal.Quotient.mk _ (fromPoly R S X) := by
  rw [← AdjoinRoot.mk_X, quotientSpanAlgEquiv_symm_mk]

theorem span_fromPoly_le_of_dvd {f g : cycloIndex R S} (h : (f : R[X]) ∣ g) :
    Ideal.span {fromPoly R S (g : R[X])} ≤ Ideal.span {fromPoly R S (f : R[X])} :=
  Ideal.span_singleton_le_span_singleton.mpr (map_dvd (fromPoly R S) h)

/-- The finite-quotient isomorphisms `quotientSpanAlgEquiv` commute with quotient transition maps
for `f ∣ g` in `cycloIndex R S`. -/
theorem algHomOfDvd_quotientSpanAlgEquiv {f g : cycloIndex R S} (h : (f : R[X]) ∣ g)
    (q : CycloCompletion R S ⧸ Ideal.span {fromPoly R S (g : R[X])}) :
    AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (quotientSpanAlgEquiv g q) =
      quotientSpanAlgEquiv f (Ideal.Quotient.factor (span_fromPoly_le_of_dvd h) q) := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
  simp [algHomOfDvd_proj h]

/-- When `1 ∈ S`, quotienting `CycloCompletion R S` by `fromPoly R S (X - 1)` recovers `R` via
polynomial evaluation at `1`. -/
noncomputable def quotientSpanXSubOneAlgEquiv (h1 : 1 ∈ S) :
    (CycloCompletion R S ⧸ Ideal.span {fromPoly R S (X - 1)}) ≃ₐ[R] R :=
  let f1 : cycloIndex R S := ⟨cyclotomic 1 R, cyclotomic_mem_cycloIndex h1⟩
  have hf1 : Ideal.span {fromPoly R S (X - 1)} = Ideal.span {fromPoly R S (f1 : R[X])} := by
    simp [f1, cyclotomic_one]
  have hspan : Ideal.span {(f1 : R[X])} = Ideal.span ({X - C (1 : R)} : Set R[X]) := by
    simp [f1, cyclotomic_one]
  (Ideal.quotientEquivAlgOfEq R hf1).trans <|
    (quotientSpanAlgEquiv f1).trans <|
      (Polynomial.quotientSpanAlgEquivAdjoinRoot (f1 : R[X])).symm.trans <|
        (Ideal.quotientEquivAlgOfEq R hspan).trans (Polynomial.quotientSpanXSubCAlgEquiv 1)

@[simp]
theorem quotientSpanXSubOneAlgEquiv_mk_fromPoly (h1 : 1 ∈ S) (p : R[X]) :
    quotientSpanXSubOneAlgEquiv h1 (Ideal.Quotient.mk _ (fromPoly R S p)) = p.eval 1 := by
  have hmk := quotientSpanAlgEquiv_mk_fromPoly ⟨cyclotomic 1 R, cyclotomic_mem_cycloIndex h1⟩ p
  simp only at hmk
  simp [quotientSpanXSubOneAlgEquiv, hmk]

@[simp]
theorem quotientSpanXSubOneAlgEquiv_symm_apply (h1 : 1 ∈ S) (r : R) :
    (quotientSpanXSubOneAlgEquiv h1).symm r =
      algebraMap R (CycloCompletion R S ⧸ Ideal.span {fromPoly R S (X - 1)}) r :=
  (quotientSpanXSubOneAlgEquiv h1).symm.commutes r

