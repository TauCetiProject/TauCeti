module

public import TauCeti.LinearAlgebra.Dual.Opposite
public import TauCeti.RingTheory.MatlisDuality.ArtinAlgebra
import TauCeti.RingTheory.Artinian.FiniteLength

/-!
# The Nakayama functor of an Artin algebra

Let `R` be a commutative Artinian ring with an injective hull `E` of `R ⧸ J(R)`, and let `A` be an
Artin `R`-algebra. The **Nakayama functor** sends a left `A`-module `P` to

`ν P = D_R (Hom_A(P, A))`,

the Matlis dual `TauCeti.MatlisDual R E (Module.Dual A P)` of the right `A`-module `Hom_A(P, A)`,
which is again a left `A`-module. Both dualizations reverse arrows, so `ν` is covariant: it sends
`g : P →ₗ[A] Q` to `MatlisDual.mapOp (g.lcomp Aᵐᵒᵖ A)`.

This file proves that `ν` is an equivalence from finitely generated projective to finitely
generated injective `A`-modules. For finitely generated projective `P`, the right module
`Hom_A(P, A)` is finitely generated and projective (`TauCeti.oppositeDual_finite`,
`TauCeti.oppositeDual_projective`), so `ν P` is injective by the instance for duals of projective
right modules, `E` being injective (`TauCeti.IsInjectiveEnvelope.moduleInjective`), and finitely
generated by `TauCeti.IsInjectiveEnvelope.finite_matlisDual_of_finite_op`. The
functor is fully faithful on these modules, and every finitely generated injective module is
isomorphic to `ν P` for a finitely generated projective `P`, which is how the injective terms of
Auslander–Reiten theory are computed from projective ones. On the regular module, `ν A` is the
injective cogenerator `D_R A` by `TauCeti.MatlisDual.dualSelfEquiv`.

Over a field `k` with `E = k`, the module `ν P` has the same underlying `A`-module as
`TauCeti.NakayamaModule k A P`, the form used in the Auslander–Reiten theory of
finite-dimensional algebras.

## Main results

* `TauCeti.IsInjectiveEnvelope.bijective_mapOp_lcomp`: the Nakayama functor is fully faithful on
  finitely generated projective modules.
* `TauCeti.IsInjectiveEnvelope.nakayamaEquiv`: a finitely generated injective module `I` is
  isomorphic to `ν P` for the finitely generated projective module `P = Hom_{Aᵐᵒᵖ}(D_R I, A)`.
* `TauCeti.IsInjectiveEnvelope.moduleInjective_iff_exists_linearEquiv`: a finitely generated
  `A`-module is injective exactly when it is isomorphic to `ν P` for some finitely generated
  projective `P`.

## References

* M. Auslander, I. Reiten, S. O. Smalø, *Representation Theory of Artin Algebras*, Section II.4.
-/

public section

noncomputable section

namespace TauCeti

open MatlisDual

universe u v w w' t

section Artin

variable {R : Type u} [CommRing R] [IsArtinianRing R] {E : Type v} [AddCommGroup E] [Module R E]
  [Small.{v} R] {f : R ⧸ Ring.jacobson R →ₗ[R] E} {A : Type t} [Ring A] [Algebra R A]
  [Module.Finite R A]

/-- **The Nakayama functor is fully faithful on finitely generated projective modules.** For
finitely generated `P` and finitely generated projective `Q`, sending `g : P → Q` to the map
`ν g : D_R (Hom_A(P, A)) → D_R (Hom_A(Q, A))` is a bijection. -/
theorem IsInjectiveEnvelope.bijective_mapOp_lcomp (hf : IsInjectiveEnvelope f)
    (P : Type w) [AddCommGroup P] [Module A P] [Module.Finite A P]
    (Q : Type w') [AddCommGroup Q] [Module A Q] [Module.Finite A Q] [Module.Projective A Q] :
    Function.Bijective fun g : P →ₗ[A] Q => mapOp (R := R) (E := E) (g.lcomp Aᵐᵒᵖ A) :=
  (hf.bijective_mapOp (isFiniteLength_dual R A Q) (isFiniteLength_dual R A P)).comp
    (opDual_lcomp_bijective A Q)

variable {I : Type w} [AddCommGroup I] [Module R I] [Module A I] [IsScalarTower R A I]
  [Module.Finite A I] [Module.Injective A I] [Small.{w} A]

/-- **Every finitely generated injective module is in the image of the Nakayama functor.** A
finitely generated injective `A`-module `I` is isomorphic to `ν P` for the finitely generated
projective module `P = Hom_{Aᵐᵒᵖ}(D_R I, A)`: the point `x` goes to the functional sending the
evaluation `p ↦ p φ` at `φ : D_R I` to `φ x`. -/
def IsInjectiveEnvelope.nakayamaEquiv (hf : IsInjectiveEnvelope f) :
    I ≃ₗ[A] MatlisDual R E (Module.Dual A (MatlisDual R E I →ₗ[Aᵐᵒᵖ] A)) :=
  have := hf.finite_op_matlisDual (A := A) (N := I)
  have := hf.moduleProjective_op_matlisDual_of_injective (A := A) (N := I)
  (hf.matlisDualEvalEquiv (isFiniteLength_of_finite_trans R A I)).trans
    (congrOp (unopDualEvalEquiv A (MatlisDual R E I)).symm)

/-- `nakayamaEquiv x` sends the evaluation `ψ = (p ↦ p φ)` at `φ : D_R I` to `φ x`. Every
`ψ : Hom_A(P, A)` is such an evaluation, so this determines `nakayamaEquiv`. -/
theorem IsInjectiveEnvelope.nakayamaEquiv_apply (hf : IsInjectiveEnvelope f) (x : I)
    (φ : MatlisDual R E I) (ψ : Module.Dual A (MatlisDual R E I →ₗ[Aᵐᵒᵖ] A))
    (hψ : ∀ p, ψ p = p φ) :
    equivLinearMap R E _ (hf.nakayamaEquiv x) ψ = equivLinearMap R E I φ x := by
  have := hf.finite_op_matlisDual (A := A) (N := I)
  have := hf.moduleProjective_op_matlisDual_of_injective (A := A) (N := I)
  obtain rfl : ψ = unopDualEvalEquiv A _ φ := LinearMap.ext fun p => by simp [hψ]
  simp [nakayamaEquiv]

/-- `nakayamaEquiv x` sends the canonical evaluation `unopDualEvalEquiv A _ φ` at `φ : D_R I`
to `φ x`. The finiteness and projectivity instances on `D_R I`, which follow from `hf`, are
needed to state `unopDualEvalEquiv`; any goal mentioning it already has them in context. -/
@[simp]
theorem IsInjectiveEnvelope.nakayamaEquiv_apply_unopDualEvalEquiv (hf : IsInjectiveEnvelope f)
    [Module.Finite Aᵐᵒᵖ (MatlisDual R E I)] [Module.Projective Aᵐᵒᵖ (MatlisDual R E I)] (x : I)
    (φ : MatlisDual R E I) :
    equivLinearMap R E _ (hf.nakayamaEquiv x) (unopDualEvalEquiv A _ φ) =
      equivLinearMap R E I φ x :=
  hf.nakayamaEquiv_apply x φ _ fun _ => unopDualEvalEquiv_apply A _ φ _

end Artin

section Characterization

variable {R : Type u} [CommRing R] [IsArtinianRing R] {E : Type v} [AddCommGroup E] [Module R E]
  [Small.{v} R] {f : R ⧸ Ring.jacobson R →ₗ[R] E} {A : Type t} [Ring A] [Algebra R A]
  [Module.Finite R A] {I : Type w} [AddCommGroup I] [Module R I] [Module A I]
  [IsScalarTower R A I] [Module.Finite A I] [Small.{w} A]

/-- **The essential image of the Nakayama functor.** A finitely generated `A`-module is injective
exactly when it is isomorphic to `ν P = D_R (Hom_A(P, A))` for some finitely generated projective
`A`-module `P`. -/
theorem IsInjectiveEnvelope.moduleInjective_iff_exists_linearEquiv (hf : IsInjectiveEnvelope f) :
    Module.Injective A I ↔ ∃ (P : Type (max v w t)) (_ : AddCommGroup P) (_ : Module A P)
      (_ : Module.Finite A P) (_ : Module.Projective A P),
      Nonempty (I ≃ₗ[A] MatlisDual R E (Module.Dual A P)) := by
  refine ⟨fun _ => ?_, fun ⟨P, _, _, _, _, ⟨e⟩⟩ => ?_⟩
  · have := hf.finite_op_matlisDual (A := A) (N := I)
    have := hf.moduleProjective_op_matlisDual_of_injective (A := A) (N := I)
    exact ⟨_, inferInstance, inferInstance, inferInstance, inferInstance, ⟨hf.nakayamaEquiv⟩⟩
  · have := hf.moduleInjective
    exact Module.Baer.injective
      (Module.Baer.of_equiv e.symm (Module.Baer.of_injective inferInstance))

end Characterization

end TauCeti
