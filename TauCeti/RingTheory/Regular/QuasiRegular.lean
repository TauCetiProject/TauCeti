/-!
# Weakly regular sequences are quasi-regular

Let `x₁, …, xₙ` be a weakly regular sequence in a commutative ring `R`, generating the ideal `I`.
If a homogeneous polynomial `F` of degree `ν` with coefficients in `R` satisfies
`F(x₁, …, xₙ) ∈ I ^ (ν + 1)`, then every coefficient of `F` lies in `I`. Equivalently, the
monomials of degree `ν` in the `xᵢ` are linearly independent over `R ⧸ I` in `I ^ ν ⧸ I ^ (ν + 1)`;
this is the statement that `(R ⧸ I)[X₁, …, Xₙ] → gr_I R` is injective.

## Main results

* `RingTheory.Sequence.IsWeaklyRegular.coeff_mem_of_eval_mem_pow_succ`: **a weakly regular
  sequence is quasi-regular.**
* `Ideal.AssociatedGraded.ofMvPolynomial_injective` and
  `Ideal.AssociatedGraded.ofMvPolynomialEquiv`: for a weakly regular sequence `x₁, …, xₙ`
  generating `I`, the map `(R ⧸ I)[X₁, …, Xₙ] → gr_I R` sending `X i` to the class of `xᵢ` in
  degree one is an isomorphism.

## Implementation notes

The proof is a double induction, on the length of the sequence and on the degree `ν`; the ring
stays fixed throughout, with no passage to quotient rings. Write the sequence as `x', y` with `x'`
quasi-regular by induction and `y` regular modulo `I' = (x')`.
* Quasi-regularity of `x'` shows that `y` is regular modulo every power `I' ^ k`.
* It suffices to treat `F(x) = 0`: if `F(x) ∈ I ^ (ν + 1)`, subtract `∑ xᵢ Gᵢ` with `Gᵢ`
  homogeneous of degree `ν` and `F(x) = ∑ xᵢ Gᵢ(x)`.
* Split `F = G(X') + Y H` with `G` homogeneous of degree `ν` in the first variables and `H`
  homogeneous of degree `ν - 1`. Then `y H(x) = -G(x') ∈ I' ^ ν`, so `H(x) ∈ I' ^ ν ⊆ I ^ ν`,
  and the induction on the degree puts the coefficients of `H` in `I`. Writing
  `H(x) = G'(x')` with `G'` homogeneous of degree `ν`, the polynomial `G + y G'` vanishes at
  `x'`, so its coefficients lie in `I'` and those of `G` lie in `I`.

## References

* H. Matsumura, *Commutative Ring Theory*, Theorem 16.2.
-/

public section

open MvPolynomial RingTheory.Sequence

namespace RingTheory.Sequence.IsWeaklyRegular

variable {R : Type*} [CommRing R] {σ : Type*}

/-- Quasi-regularity of `x` in degree `ν`: a homogeneous polynomial of degree `ν` whose value at
`x` lies in `I ^ (ν + 1)`, for `I` the ideal generated by `x`, has all its coefficients in `I`. -/
private def QuasiRegularAt (x : σ → R) (ν : ℕ) : Prop :=
  ∀ F : MvPolynomial σ R, F.IsHomogeneous ν → F.eval x ∈ Ideal.span (Set.range x) ^ (ν + 1) →
    F ∈ Ideal.map C (Ideal.span (Set.range x))

/-- It suffices to prove quasi-regularity for polynomials vanishing at `x`. -/
private theorem quasiRegularAt_of_eval_eq_zero {x : σ → R} {ν : ℕ}
    (h : ∀ F : MvPolynomial σ R, F.IsHomogeneous ν → F.eval x = 0 →
      F ∈ Ideal.map C (Ideal.span (Set.range x))) :
    QuasiRegularAt x ν := by
  intro F hF hFx
  rw [pow_succ, ← Ideal.smul_eq_mul, Ideal.span, Submodule.mem_ideal_smul_span_iff_exists_sum]
    at hFx
  obtain ⟨a, ha, hsum⟩ := hFx
  choose G hG hGx using fun i ↦ (Ideal.mem_span_pow_iff_exists_isHomogeneous x (a i)).1 (ha i)
  have hmem : (a.sum fun i _ ↦ C (x i) * G i) ∈ Ideal.map C (Ideal.span (Set.range x)) :=
    Ideal.sum_mem _ fun i _ ↦
      Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩))
  have hH := h (F - a.sum fun i _ ↦ C (x i) * G i)
    (hF.sub (IsHomogeneous.sum _ _ _ fun i _ ↦ (hG i).C_mul _)) (by
      simp only [map_sub, Finsupp.sum, map_sum, map_mul, eval_C, hGx, ← hsum, smul_eq_mul,
        mul_comm, sub_self])
  simpa using add_mem hH hmem

/-- Quasi-regularity in degree zero. -/
private theorem quasiRegularAt_zero (x : σ → R) : QuasiRegularAt x 0 :=
  quasiRegularAt_of_eval_eq_zero fun F hF h0 ↦ by
    rw [← homogeneousComponent_eq_self hF, homogeneousComponent_zero] at h0 ⊢
    rw [eval_C] at h0
    simp [h0]

/-- The empty sequence is quasi-regular. -/
private theorem quasiRegularAt_of_isEmpty [IsEmpty σ] (x : σ → R) (ν : ℕ) :
    QuasiRegularAt x ν :=
  quasiRegularAt_of_eval_eq_zero fun F _ h0 ↦ by
    rw [eq_C_of_isEmpty F, eval_C] at h0
    rw [eq_C_of_isEmpty F, h0, C_0]
    exact zero_mem _

/-- Quasi-regularity is invariant under reindexing the sequence. -/
private theorem quasiRegularAt_comp_equiv {τ : Type*} {x : τ → R} (e : σ ≃ τ) {ν : ℕ}
    (h : QuasiRegularAt x ν) : QuasiRegularAt (x ∘ e) ν := by
  intro F hF hFx
  rw [EquivLike.range_comp] at hFx ⊢
  have hmem := h (rename e F) hF.rename_isHomogeneous (by rwa [eval_rename])
  rw [mem_map_C_iff] at hmem ⊢
  intro d
  simpa [coeff_rename_mapDomain e e.injective] using hmem (d.mapDomain e)

/-- If `x` is quasi-regular and `y` is regular modulo `(x)`, then `y` is regular modulo every
power of `(x)`. -/
private theorem mem_pow_of_mul_mem_pow {x : σ → R} (hx : ∀ ν, QuasiRegularAt x ν) {y : R}
    (hy : ∀ r, y * r ∈ Ideal.span (Set.range x) → r ∈ Ideal.span (Set.range x)) :
    ∀ (k : ℕ) (r : R), y * r ∈ Ideal.span (Set.range x) ^ k →
      r ∈ Ideal.span (Set.range x) ^ k := by
  intro k
  induction k with
  | zero => simp
  | succ k ih =>
    intro r hr
    obtain ⟨F, hF, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous x r).1
      (ih r (Ideal.pow_le_pow_right k.le_succ hr))
    have hyF := hx k (C y * F) (hF.C_mul y) (by simpa using hr)
    have hFI : F ∈ Ideal.map C (Ideal.span (Set.range x)) :=
      mem_map_C_iff.2 fun d ↦ hy _ (by simpa [coeff_C_mul] using mem_map_C_iff.1 hyF d)
    rw [pow_succ']
    exact hF.eval_mem_mul_pow (fun i ↦ Ideal.subset_span ⟨i, rfl⟩) (mem_map_C_iff.1 hFI)

/-- A homogeneous polynomial of positive degree in the variables `Option σ` is
`G(X') + X none * H` with `G` and `H` homogeneous. -/
private theorem exists_eq_rename_some_add_X_none_mul {F : MvPolynomial (Option σ) R} {ν : ℕ}
    (hF : F.IsHomogeneous (ν + 1)) :
    ∃ (G : MvPolynomial σ R) (H : MvPolynomial (Option σ) R), G.IsHomogeneous (ν + 1) ∧
      H.IsHomogeneous ν ∧ F = rename some G + X none * H := by
  -- Split off the constant coefficient of `F` as a polynomial in `X none`.
  obtain ⟨p, rfl⟩ := (optionEquivLeft R σ).symm.surjective F
  have hdec : (optionEquivLeft R σ).symm p =
      rename some (p.coeff 0) + X none * (optionEquivLeft R σ).symm p.divX := by
    conv_lhs => rw [← Polynomial.X_mul_divX_add p]
    rw [map_add, map_mul, optionEquivLeft_symm_X, add_comm]
    simp [optionEquivLeft_symm_apply]
  -- Taking homogeneous components makes both parts homogeneous.
  refine ⟨homogeneousComponent (ν + 1) (p.coeff 0),
    homogeneousComponent ν ((optionEquivLeft R σ).symm p.divX),
    homogeneousComponent_isHomogeneous _ _, homogeneousComponent_isHomogeneous _ _, ?_⟩
  have hX := (isHomogeneous_X R (none : Option σ)).homogeneousComponent_mul_right
    ((optionEquivLeft R σ).symm p.divX) (ν + 1)
  simp only [show 1 ≤ ν + 1 by omega, ↓reduceIte, Nat.add_sub_cancel] at hX
  rw [← homogeneousComponent_eq_self hF, hdec, map_add, ← rename_homogeneousComponent,
    mul_comm (X none), hX, mul_comm]

/-- **Adjoining a regular element preserves quasi-regularity.** If `x` is quasi-regular and `y`
is regular modulo `(x)`, then the sequence `x, y`, indexed by `Option σ` with `y` at `none`, is
quasi-regular. -/
private theorem quasiRegularAt_option {x : σ → R} (hx : ∀ ν, QuasiRegularAt x ν) {y : R}
    (hy : ∀ r, y * r ∈ Ideal.span (Set.range x) → r ∈ Ideal.span (Set.range x)) (ν : ℕ) :
    QuasiRegularAt (fun o : Option σ ↦ o.elim y x) ν := by
  set x' : Option σ → R := fun o ↦ o.elim y x
  have hle : Ideal.span (Set.range x) ≤ Ideal.span (Set.range x') :=
    Ideal.span_mono (by rintro _ ⟨i, rfl⟩; exact ⟨some i, rfl⟩)
  have hy' : y ∈ Ideal.span (Set.range x') := Ideal.subset_span ⟨none, rfl⟩
  induction ν with
  | zero => exact quasiRegularAt_zero _
  | succ ν ih =>
    refine quasiRegularAt_of_eval_eq_zero fun F hF h0 ↦ ?_
    obtain ⟨G, H, hG, hH, rfl⟩ := exists_eq_rename_some_add_X_none_mul hF
    have heval : G.eval x + y * H.eval x' = 0 := by
      simpa [eval_rename, x', Function.comp_def] using h0
    -- `y H(x) = -G(x')` lies in `I' ^ (ν + 1)`, hence so does `H(x)`.
    have hHx : H.eval x' ∈ Ideal.span (Set.range x) ^ (ν + 1) :=
      mem_pow_of_mul_mem_pow hx hy _ _ (by
        rw [eq_neg_of_add_eq_zero_right heval]
        exact neg_mem ((Ideal.mem_span_pow_iff_exists_isHomogeneous x _).2 ⟨G, hG, rfl⟩))
    have hHmem : H ∈ Ideal.map C (Ideal.span (Set.range x')) :=
      ih H hH (Ideal.pow_right_mono hle _ hHx)
    -- Writing `H(x) = G'(x')`, the polynomial `G + y G'` vanishes at `x'`.
    obtain ⟨G', hG', hG'x⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous x _).1 hHx
    have hsum := hx (ν + 1) (G + C y * G') (hG.add (hG'.C_mul y)) (by
      rw [map_add, map_mul, eval_C, hG'x, heval]
      exact zero_mem _)
    have hGmem : G ∈ Ideal.map C (Ideal.span (Set.range x')) := by
      simpa using sub_mem (Ideal.map_mono hle hsum)
        (Ideal.mul_mem_right G' _ (Ideal.mem_map_of_mem C hy'))
    refine add_mem ?_ (Ideal.mul_mem_left _ _ hHmem)
    have hren := Ideal.mem_map_of_mem (rename (R := R) some).toRingHom hGmem
    rwa [Ideal.map_map, show (rename (R := R) some).toRingHom.comp C = C from
      RingHom.ext (rename_C some)] at hren

/-- Weakly regular sequences are quasi-regular in every degree. -/
private theorem quasiRegularAt_of_isWeaklyRegular :
    ∀ (n : ℕ) (x : Fin n → R), IsWeaklyRegular R (List.ofFn x) → ∀ ν, QuasiRegularAt x ν
  | 0, x, _, ν => quasiRegularAt_of_isEmpty x ν
  | n + 1, x, hx, ν => by
    rw [List.ofFn_succ', List.concat_eq_append] at hx
    have hreg := isLeftRegular_mk_ofList hx
    rw [Ideal.ofList_ofFn] at hreg
    have hy : ∀ r, x (Fin.last n) * r ∈ Ideal.span (Set.range fun i : Fin n ↦ x i.castSucc) →
        r ∈ Ideal.span (Set.range fun i : Fin n ↦ x i.castSucc) := fun r hr ↦ by
      rw [← Ideal.Quotient.eq_zero_iff_mem] at hr ⊢
      exact hreg (by simpa using hr)
    have h := quasiRegularAt_comp_equiv finSuccEquivLast <| quasiRegularAt_option
      (quasiRegularAt_of_isWeaklyRegular n _ ((isWeaklyRegular_append_iff _ _ _).1 hx).1) hy ν
    have hfun : (fun o : Option (Fin n) ↦ o.elim (x (Fin.last n)) fun i : Fin n ↦ x i.castSucc) ∘
        finSuccEquivLast = x :=
      funext <| Fin.lastCases (by simp [finSuccEquivLast_last])
        fun i ↦ by simp [finSuccEquivLast_castSucc]
    rwa [hfun] at h

/-- **A weakly regular sequence is quasi-regular.** Let `x₁, …, xₙ` be a weakly regular sequence
in `R`, generating the ideal `I`. If a homogeneous polynomial `F` of degree `ν` satisfies
`F(x₁, …, xₙ) ∈ I ^ (ν + 1)`, then every coefficient of `F` lies in `I`. -/
theorem coeff_mem_of_eval_mem_pow_succ {n ν : ℕ} {x : Fin n → R}
    (hx : IsWeaklyRegular R (List.ofFn x)) {F : MvPolynomial (Fin n) R} (hF : F.IsHomogeneous ν)
    (hFx : F.eval x ∈ Ideal.span (Set.range x) ^ (ν + 1)) (d : Fin n →₀ ℕ) :
    F.coeff d ∈ Ideal.span (Set.range x) :=
  mem_map_C_iff.1 (quasiRegularAt_of_isWeaklyRegular n x hx ν F hF hFx) d

end RingTheory.Sequence.IsWeaklyRegular

namespace Ideal.AssociatedGraded

variable {R : Type*} [CommRing R] {I : Ideal R} {σ : Type*} {x : σ → R}

/-- The degree-`k` component of the image of `F` modulo `I` is the class of the value at `x` of
the degree-`k` homogeneous component of `F`. -/
private theorem ofMvPolynomial_map_apply (hx : ∀ i, x i ∈ I) (F : MvPolynomial σ R) (k : ℕ) :
    ofMvPolynomial x hx (MvPolynomial.map (Ideal.Quotient.mk I) F) k =
      Submodule.Quotient.mk ⟨(homogeneousComponent k F).eval x,
        (homogeneousComponent_isHomogeneous k F).eval_mem_pow hx⟩ := by
  conv_lhs => rw [← sum_homogeneousComponent F, map_sum, map_sum]
  simp_rw [ofMvPolynomial_map_of_isHomogeneous hx (homogeneousComponent_isHomogeneous _ F),
    mk_apply, DirectSum.sum_apply]
  rw [Finset.sum_eq_single k]
  · exact DirectSum.of_eq_same _ _
  · exact fun b _ hb ↦ DirectSum.of_eq_of_ne _ _ _ hb.symm
  · intro hk
    rw [DirectSum.of_eq_same]
    have h0 : homogeneousComponent k F = 0 :=
      homogeneousComponent_eq_zero _ _ (by simpa [Nat.lt_succ_iff] using hk)
    simp [h0]

/-- **The associated graded ring of a weakly regular sequence.** If `x₁, …, xₙ` is a weakly
regular sequence generating `I`, then `ofMvPolynomial : (R ⧸ I)[X₁, …, Xₙ] → gr_I R` is
injective. -/
theorem ofMvPolynomial_injective {n : ℕ} {x : Fin n → R} (hreg : IsWeaklyRegular R (List.ofFn x))
    (hx : ∀ i, x i ∈ I) (hI : I ≤ Ideal.span (Set.range x)) :
    Function.Injective (ofMvPolynomial x hx) := by
  have hspan : Ideal.span (Set.range x) = I :=
    le_antisymm (Ideal.span_le.2 (Set.range_subset_iff.2 hx)) hI
  rw [injective_iff_map_eq_zero]
  intro P hP
  obtain ⟨F, rfl⟩ := map_surjective _ Ideal.Quotient.mk_surjective P
  suffices h : ∀ d, F.coeff d ∈ I by
    ext d
    simpa [coeff_map, Ideal.Quotient.eq_zero_iff_mem] using h d
  intro d
  -- The degree-`|d|` component of the image vanishes, so `F` is quasi-regular in that degree.
  have hk := congrArg (fun z : I.AssociatedGraded ↦ z d.degree) hP
  simp only [ofMvPolynomial_map_apply, DirectSum.zero_apply, gradedPiece_mk_eq_zero_iff] at hk
  rw [← hspan] at hk ⊢
  simpa [coeff_homogeneousComponent] using
    hreg.coeff_mem_of_eval_mem_pow_succ (homogeneousComponent_isHomogeneous _ F) hk d

/-- **Polynomial structure of the associated graded ring of a weakly regular sequence.** If
`x₁, …, xₙ` is a weakly regular sequence generating `I`, then `gr_I R` is the polynomial ring
`(R ⧸ I)[X₁, …, Xₙ]`, with `X i` corresponding to the class of `x i` in degree one. -/
noncomputable def ofMvPolynomialEquiv {n : ℕ} {x : Fin n → R}
    (hreg : IsWeaklyRegular R (List.ofFn x)) (hx : ∀ i, x i ∈ I)
    (hI : I ≤ Ideal.span (Set.range x)) :
    MvPolynomial (Fin n) (R ⧸ I) ≃ₐ[R ⧸ I] I.AssociatedGraded :=
  AlgEquiv.ofBijective (ofMvPolynomial x hx)
    ⟨ofMvPolynomial_injective hreg hx hI, ofMvPolynomial_surjective hx hI⟩

/-- `ofMvPolynomialEquiv` is `ofMvPolynomial`. -/
@[simp]
theorem coe_ofMvPolynomialEquiv {n : ℕ} {x : Fin n → R}
    (hreg : IsWeaklyRegular R (List.ofFn x)) (hx : ∀ i, x i ∈ I)
    (hI : I ≤ Ideal.span (Set.range x)) :
    ⇑(ofMvPolynomialEquiv hreg hx hI) = ofMvPolynomial x hx :=
  (rfl)

end Ideal.AssociatedGraded
