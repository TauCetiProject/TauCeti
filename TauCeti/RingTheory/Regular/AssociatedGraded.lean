module

public import TauCeti.RingTheory.Ideal.AssociatedGraded
public import TauCeti.RingTheory.Regular.RegularSequence

/-!
# The associated graded ring of a weakly regular sequence

Let `I` be an ideal of a commutative ring `R` generated by `a₁, …, aₙ`. Sending `Xᵢ` to the
degree-one class of `aᵢ` defines an `R ⧸ I`-algebra map `(R ⧸ I)[X₁, …, Xₙ] → gr_I R` onto the
associated graded ring `gr_I R = ⨁ ν, Iᵛ ⧸ Iᵛ⁺¹`; it sends the reduction of a homogeneous
polynomial `F` of degree `ν` to the degree-`ν` class of `F(a)`. If `a₁, …, aₙ` is a weakly regular
sequence on `R`, this map is an isomorphism: a weakly regular sequence is quasi-regular.

Quasi-regularity is the statement that a homogeneous form `F` of degree `ν` with
`F(a) ∈ Iᵛ⁺¹` has all its coefficients in `I`.

The degree-one part of the isomorphism is `RingTheory.Sequence.IsWeaklyRegular.cotangentBasis`.
For a regular system of parameters of a regular local ring it identifies the associated graded
ring of the maximal ideal with a polynomial ring over the residue field.

## Main definitions

* `RingTheory.Sequence.IsWeaklyRegular.associatedGradedEquiv`: for a weakly regular sequence
  generating `I`, this map is an isomorphism `(R ⧸ I)[X₁, …, Xₙ] ≃ₐ[R ⧸ I] gr_I R`.

## Main results

* `RingTheory.Sequence.IsWeaklyRegular.coeff_mem_of_eval_mem_pow_succ`: a weakly regular sequence
  is quasi-regular.
* `RingTheory.Sequence.IsWeaklyRegular.mvPolynomialHom_injective`: for a weakly regular sequence
  generating `I`, the map is injective.

## References

* H. Matsumura, *Commutative Ring Theory*, Theorem 16.2 (i).
* W. Bruns and J. Herzog, *Cohen–Macaulay Rings*, Theorem 1.1.8.
* The Stacks project, Section 10.69 (quasi-regular sequences).
-/

public section

open MvPolynomial RingTheory.Sequence

variable {R : Type*} [CommRing R]

namespace RingTheory.Sequence.IsWeaklyRegular

open Ideal

/-- If homogeneous forms in `a` of degree `ν` with value in `Jᵛ⁺¹` have coefficients in
`J = (a)`, and `x` is a nonzerodivisor modulo `J`, then `x` is a nonzerodivisor modulo every
power of `J`. -/
private theorem mem_pow_of_mul_mem_pow {σ : Type*} {a : σ → R}
    (hQ : ∀ {ν : ℕ} {F : MvPolynomial σ R}, F.IsHomogeneous ν →
      F.eval a ∈ span (Set.range a) ^ (ν + 1) → ∀ e, F.coeff e ∈ span (Set.range a))
    {x : R} (hx : ∀ y, x * y ∈ span (Set.range a) → y ∈ span (Set.range a)) :
    ∀ (μ : ℕ) (y : R), x * y ∈ span (Set.range a) ^ μ → y ∈ span (Set.range a) ^ μ := by
  intro μ
  induction μ with
  | zero => simp
  | succ μ ih =>
    intro y hy
    obtain ⟨P, hP, rfl⟩ := (mem_span_pow_iff_exists_isHomogeneous a y).mp
      (ih y (pow_le_pow_right (Nat.le_succ μ) hy))
    have hc := hQ (hP.C_mul x) (by simpa using hy)
    rw [pow_succ']
    exact (mem_mul_span_pow_iff_exists_isHomogeneous _ a μ _).mpr
      ⟨P, hP, fun e ↦ hx _ (by simpa using hc e), rfl⟩

/-- The inductive step of quasi-regularity: if the first `n` entries of `a` are quasi-regular and
the last entry `x` is a nonzerodivisor modulo the ideal `J` they generate, then `a` is
quasi-regular. -/
private theorem coeff_mem_of_eval_mem_pow_succ_of_castSucc {n : ℕ} {a : Fin (n + 1) → R}
    (hQ : ∀ {ν : ℕ} {F : MvPolynomial (Fin n) R}, F.IsHomogeneous ν →
      F.eval (fun i : Fin n ↦ a i.castSucc) ∈
        span (Set.range fun i : Fin n ↦ a i.castSucc) ^ (ν + 1) →
      ∀ e, F.coeff e ∈ span (Set.range fun i : Fin n ↦ a i.castSucc))
    (hx : ∀ y, a (Fin.last n) * y ∈ span (Set.range fun i : Fin n ↦ a i.castSucc) →
      y ∈ span (Set.range fun i : Fin n ↦ a i.castSucc))
    {ν : ℕ} {F : MvPolynomial (Fin (n + 1)) R} (hF : F.IsHomogeneous ν)
    (hFa : F.eval a ∈ span (Set.range a) ^ (ν + 1)) (e : Fin (n + 1) →₀ ℕ) :
    F.coeff e ∈ span (Set.range a) := by
  set a' : Fin n → R := fun i : Fin n ↦ a i.castSucc
  set x := a (Fin.last n)
  have hJI : span (Set.range a') ≤ span (Set.range a) :=
    span_mono (Set.range_comp_subset_range Fin.castSucc a)
  have hxI : x ∈ span (Set.range a) := subset_span ⟨_, rfl⟩
  have hreg := mem_pow_of_mul_mem_pow hQ hx
  induction ν generalizing F e with
  | zero =>
    rw [totalDegree_eq_zero_iff_eq_C.mp (Nat.le_zero.mp hF.totalDegree_le)] at hFa ⊢
    rw [coeff_C]
    split_ifs
    · simpa using hFa
    · exact zero_mem _
  | succ ν ih =>
    -- Subtracting a form with coefficients in `I` and the same value reduces to `F(a) = 0`.
    obtain ⟨F', hF', hF'I, hF'a⟩ :=
      (mem_mul_span_pow_iff_exists_isHomogeneous _ a (ν + 1) _).mp (by rwa [← pow_succ'])
    suffices hD : ∀ e, (F - F').coeff e ∈ span (Set.range a) by
      simpa using add_mem (hD e) (hF'I e)
    obtain ⟨G, hG, H, hH, hGH⟩ :=
      (hF.sub hF').exists_eq_rename_castSucc_add_mul_X_last
    have h0 : G.eval a' + x * H.eval a = 0 := by
      have := congrArg (eval a) hGH
      rw [map_sub, hF'a, sub_self, map_add, eval_rename, map_mul, eval_X] at this
      rw [mul_comm]
      exact this.symm
    -- `x H(a) = -G(a') ∈ Jᵛ⁺¹`, hence `H(a) ∈ Jᵛ⁺¹`.
    have hHJ : H.eval a ∈ span (Set.range a') ^ (ν + 1) := hreg _ _ <| by
      rw [eq_neg_of_add_eq_zero_right h0]
      exact neg_mem ((mem_span_pow_iff_exists_isHomogeneous a' _).mpr ⟨G, hG, rfl⟩)
    have hHI : ∀ e, H.coeff e ∈ span (Set.range a) := ih hH (pow_right_mono hJI _ hHJ)
    -- Writing `H(a) = K(a')`, the form `G + x K` vanishes at `a'`.
    obtain ⟨K, hK, hKa⟩ := (mem_span_pow_iff_exists_isHomogeneous a' _).mp hHJ
    have hGK := hQ (hG.add (hK.C_mul x)) (by simp [hKa, h0])
    have hGI (e) : G.coeff e ∈ span (Set.range a) := by
      simpa [coeff_C_mul] using sub_mem (hJI (hGK e)) (mul_mem_right (K.coeff e) _ hxI)
    simp only [← Ideal.Quotient.eq_zero_iff_mem, ← coeff_map] at hGI hHI ⊢
    have hG0 : G.map (Ideal.Quotient.mk _) = 0 := MvPolynomial.ext _ _ hGI
    have hH0 : H.map (Ideal.Quotient.mk _) = 0 := MvPolynomial.ext _ _ hHI
    simp [hGH, map_rename, hG0, hH0]

/-- If `a : Fin n → R` is weakly regular and a homogeneous polynomial `F` of degree `ν`
satisfies `F(a) ∈ (a)ᵛ⁺¹`, then every coefficient of `F` belongs to `(a)`. -/
private theorem coeff_mem_of_eval_mem_pow_succ_aux :
    ∀ {n : ℕ} {a : Fin n → R}, IsWeaklyRegular R (List.ofFn a) →
      ∀ {ν : ℕ} {F : MvPolynomial (Fin n) R}, F.IsHomogeneous ν →
        F.eval a ∈ span (Set.range a) ^ (ν + 1) → ∀ e, F.coeff e ∈ span (Set.range a) := by
  /- Induct on the length of the sequence. Write `J` for the ideal of the first `n - 1`
  elements and `x = aₙ`. Since the first `n - 1` elements are quasi-regular and `x` is a
  nonzerodivisor modulo `J`, multiplication by `x` is injective modulo every power `Jᵘ`.
  Splitting `F = G + H Xₙ`, with `G` free of `Xₙ`, a form with `F(a) = 0` then has
  `H(a) ∈ Jᵛ`; the coefficients of `H` lie in `I` by induction on the degree, and those of
  `G` by quasi-regularity of the first `n - 1` elements. -/
  intro n
  induction n with
  | zero =>
    intro a _ ν F _ hFa e
    have hI : span (Set.range a) = ⊥ := by simp [Set.range_eq_empty]
    rw [hI, ← Ideal.zero_eq_bot, zero_pow (Nat.succ_ne_zero ν), Ideal.zero_eq_bot,
      eq_C_of_isEmpty F, eval_C] at hFa
    rw [hI, eq_C_of_isEmpty F, Subsingleton.elim e 0, coeff_zero_C]
    exact hFa
  | succ n ih =>
    intro a h
    rw [List.ofFn_succ', List.concat_eq_append] at h
    have hx := isLeftRegular_mk_ofList h
    rw [Ideal.ofList_ofFn] at hx
    rw [isWeaklyRegular_append_iff, Ideal.ofList_ofFn] at h
    intro ν F
    refine coeff_mem_of_eval_mem_pow_succ_of_castSucc (ih h.1) fun y hy ↦ ?_
    rw [← Ideal.Quotient.eq_zero_iff_mem] at hy ⊢
    exact hx (by beta_reduce; rwa [mul_zero, ← map_mul])

/-- **A weakly regular sequence is quasi-regular.** If `rs` is weakly regular on `R` and `F` is a
homogeneous polynomial of degree `ν` whose value at `rs` lies in `(rs)ᵛ⁺¹`, then every coefficient
of `F` lies in `(rs)`. -/
theorem coeff_mem_of_eval_mem_pow_succ {rs : List R} (h : IsWeaklyRegular R rs) {ν : ℕ}
    {F : MvPolynomial (Fin rs.length) R} (hF : F.IsHomogeneous ν)
    (hFa : F.eval (fun i ↦ rs[i]) ∈ ofList rs ^ (ν + 1)) (e : Fin rs.length →₀ ℕ) :
    F.coeff e ∈ ofList rs := by
  rw [← List.ofFn_getElem (xs := rs)] at h
  rw [ofList_eq_span_range_getElem] at hFa ⊢
  exact coeff_mem_of_eval_mem_pow_succ_aux h hF hFa e

/-- For a weakly regular sequence `rs` generating `I`, the map `(R ⧸ I)[X₁, …, Xₙ] → gr_I R`
sending `Xᵢ` to the degree-one class of `rsᵢ` is injective. -/
theorem mvPolynomialHom_injective {rs : List R} (h : IsWeaklyRegular R rs) {I : Ideal R}
    (hI : I ≤ ofList rs) (ha : ∀ i : Fin rs.length, rs[i] ∈ I) :
    Function.Injective (AssociatedGraded.mvPolynomialHom I ha) := by
  rw [injective_iff_map_eq_zero]
  intro P hP
  obtain ⟨F, rfl⟩ := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective P
  -- Reading off degree `ν`, the `ν`-th homogeneous component of `F` has value in `Iᵛ⁺¹`.
  have hcomp (ν : ℕ) :
      (homogeneousComponent ν F).eval (fun i : Fin rs.length ↦ rs[i]) ∈ I ^ (ν + 1) := by
    by_cases hν : ν ≤ F.totalDegree
    · have := DFunLike.congr_fun hP ν
      rw [← sum_homogeneousComponent F, map_sum, map_sum, DirectSum.zero_apply,
        DirectSum.sum_apply, Finset.sum_eq_single ν] at this
      · rwa [AssociatedGraded.mvPolynomialHom_map_of_isHomogeneous ha
          (homogeneousComponent_isHomogeneous _ _), AssociatedGraded.mk_apply,
          DirectSum.of_eq_same, gradedPiece_mk_eq_zero_iff] at this
      · intro μ _ hμ
        rw [AssociatedGraded.mvPolynomialHom_map_of_isHomogeneous ha
          (homogeneousComponent_isHomogeneous _ _), AssociatedGraded.mk_apply,
          DirectSum.of_eq_of_ne _ _ _ (Ne.symm hμ)]
      · simp only [Finset.mem_range]
        omega
    · rw [homogeneousComponent_eq_zero _ _ (by omega), map_zero]
      exact zero_mem _
  have hle : ofList rs ≤ I := span_le.mpr fun r hr ↦ by
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hr
    exact ha ⟨i, hi⟩
  refine MvPolynomial.ext _ _ fun e ↦ ?_
  have := h.coeff_mem_of_eval_mem_pow_succ (homogeneousComponent_isHomogeneous e.degree F)
    (pow_right_mono hI _ (hcomp _)) e
  simp only [coeff_homogeneousComponent, ↓reduceIte] at this
  rw [coeff_map]
  simpa [Ideal.Quotient.eq_zero_iff_mem] using hle this

/-- **The associated graded ring of a weakly regular sequence is a polynomial ring.** If the
weakly regular sequence `rs` generates `I`, then `gr_I R` is the polynomial ring over `R ⧸ I` in
the degree-one classes of the entries of `rs`. -/
noncomputable def associatedGradedEquiv {rs : List R} (h : IsWeaklyRegular R rs) {I : Ideal R}
    (hI : ofList rs = I) :
    MvPolynomial (Fin rs.length) (R ⧸ I) ≃ₐ[R ⧸ I] I.AssociatedGraded :=
  have ha (i : Fin rs.length) : rs[i] ∈ I := hI ▸ subset_span (List.getElem_mem _)
  .ofBijective (AssociatedGraded.mvPolynomialHom I ha)
    ⟨h.mvPolynomialHom_injective hI.ge ha,
      AssociatedGraded.mvPolynomialHom_surjective ha (hI ▸ (ofList_eq_span_range_getElem rs).le)⟩

/-- `associatedGradedEquiv` is `Ideal.AssociatedGraded.mvPolynomialHom`. -/
@[simp]
theorem associatedGradedEquiv_apply {rs : List R} (h : IsWeaklyRegular R rs) {I : Ideal R}
    (hI : ofList rs = I) (P : MvPolynomial (Fin rs.length) (R ⧸ I)) :
    h.associatedGradedEquiv hI P = AssociatedGraded.mvPolynomialHom I
      (fun i ↦ by rw [← hI]; exact subset_span (List.getElem_mem _) :
        ∀ i : Fin rs.length, rs[i] ∈ I) P :=
  (rfl)

end RingTheory.Sequence.IsWeaklyRegular
