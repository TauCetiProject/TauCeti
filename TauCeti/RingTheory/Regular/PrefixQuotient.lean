module

public import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.RingTheory.Nakayama

/-!
# Prefix quotients

For a module `M` over a commutative ring and a list `rs = (r₁, …, rₛ)`, the *prefix quotient*
`prefixQuotient M rs` is `M ⧸ (r₁, …, rₛ) M`. It comes with linear equivalences identifying the
quotient by the empty list with `M`, the quotient by `rs ++ qs` with the iterated quotient, the
quotient by a permuted list with the original one, and quotients of equivalent modules. Over a
local ring, the prefix quotient of a nonzero finite module by a list in the maximal ideal is
nonzero.

## Main definitions

* `TauCeti.prefixQuotient M rs`: the quotient `M ⧸ (r₁, …, rₛ) M`.
* `TauCeti.prefixQuotient.nilEquiv`: `M ⧸ () M ≃ M`.
* `TauCeti.prefixQuotient.singletonEquiv`: `M ⧸ (r) M ≃ QuotSMulTop r M`.
* `TauCeti.prefixQuotient.appendEquiv`: `M ⧸ (rs ++ qs) M ≃ (M ⧸ (rs) M) ⧸ (qs) (M ⧸ (rs) M)`.
* `TauCeti.prefixQuotient.equivOfPerm`: permuting the list does not change the quotient.
* `TauCeti.prefixQuotient.dropReverseEquiv`:
  `M ⧸ (rs.reverse.drop k) M ≃ M ⧸ (rs.take (len - k)) M`.
* `TauCeti.prefixQuotient.congr`: a linear equivalence `M ≃ N` induces `M ⧸ (rs) M ≃ N ⧸ (rs) N`.

## Main results

* `TauCeti.prefixQuotient.nontrivial_of_forall_mem_maximalIdeal`: by Nakayama's lemma, the prefix
  quotient of a nonzero finite module over a local ring by a list in `𝔪` is nonzero.
-/

public section

open Ideal IsLocalRing Pointwise

namespace TauCeti

variable {R : Type*} [CommRing R] (M : Type*) [AddCommGroup M] [Module R M]
  {N : Type*} [AddCommGroup N] [Module R N]

/-- The *prefix quotient* `M ⧸ (r₁, …, rₛ) M` of `M` by the submodule `(r₁, …, rₛ) M = I • M`,
where `I` is the ideal generated by the entries of the list `rs = (r₁, …, rₛ)`. -/
abbrev prefixQuotient (rs : List R) : Type _ :=
  M ⧸ (ofList rs • (⊤ : Submodule R M))

namespace prefixQuotient

/-- The quotient of `M` by the empty list is `M` itself. -/
noncomputable def nilEquiv : prefixQuotient M ([] : List R) ≃ₗ[R] M :=
  Submodule.quotEquivOfEqBot _ (by rw [ofList_nil, Submodule.bot_smul])

@[simp]
theorem nilEquiv_mk (x : M) :
    nilEquiv M (Submodule.Quotient.mk x : prefixQuotient M ([] : List R)) = x :=
  (rfl)

@[simp]
theorem nilEquiv_symm_apply (x : M) :
    (nilEquiv M).symm x = (Submodule.Quotient.mk x : prefixQuotient M ([] : List R)) :=
  (rfl)

/-- The quotient of `M` by a singleton list `[r]` is `QuotSMulTop r M`. -/
noncomputable def singletonEquiv (r : R) : prefixQuotient M [r] ≃ₗ[R] QuotSMulTop r M :=
  Submodule.quotEquivOfEq _ _ (by rw [ofList_singleton, Submodule.ideal_span_singleton_smul])

@[simp]
theorem singletonEquiv_mk (r : R) (x : M) :
    singletonEquiv M r (Submodule.Quotient.mk x) = Submodule.Quotient.mk x :=
  Submodule.quotEquivOfEq_mk _ _ _ x

@[simp]
theorem singletonEquiv_symm_mk (r : R) (x : M) :
    (singletonEquiv M r).symm (Submodule.Quotient.mk x) = Submodule.Quotient.mk x := by
  rw [← singletonEquiv_mk M r x, LinearEquiv.symm_apply_apply]

/-- The quotient of `M` by `rs ++ qs` is the quotient of `M ⧸ (rs) M` by `qs`. -/
noncomputable def appendEquiv (rs qs : List R) :
    prefixQuotient M (rs ++ qs) ≃ₗ[R] prefixQuotient (prefixQuotient M rs) qs :=
  Submodule.quotEquivOfEq _ _ (by rw [ofList_append, Submodule.sup_smul]) ≪≫ₗ
    (Submodule.quotientQuotientEquivQuotientSup _ _).symm ≪≫ₗ
      Submodule.quotEquivOfEq _ _
        (by rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ])

@[simp]
theorem appendEquiv_mk (rs qs : List R) (x : M) :
    appendEquiv M rs qs (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (Submodule.Quotient.mk x) :=
  (rfl)

@[simp]
theorem appendEquiv_symm_mk_mk (rs qs : List R) (x : M) :
    (appendEquiv M rs qs).symm (Submodule.Quotient.mk (Submodule.Quotient.mk x)) =
      Submodule.Quotient.mk x :=
  (rfl)

/-- Permuting a list does not change the prefix quotient, since the generated ideal is the same. -/
noncomputable def equivOfPerm {rs qs : List R} (h : rs.Perm qs) :
    prefixQuotient M rs ≃ₗ[R] prefixQuotient M qs :=
  Submodule.quotEquivOfEq _ _ (by simp only [ofList, h.mem_iff])

@[simp]
theorem equivOfPerm_mk {rs qs : List R} (h : rs.Perm qs) (x : M) :
    equivOfPerm M h (Submodule.Quotient.mk x) = Submodule.Quotient.mk x :=
  (rfl)

/-- Dropping `k` entries from the reversed list `rs.reverse` reverses the prefix
`rs.take (rs.length - k)`, so the two prefix quotients are canonically equivalent. -/
noncomputable def dropReverseEquiv (rs : List R) (k : ℕ) :
    prefixQuotient M (rs.reverse.drop k) ≃ₗ[R] prefixQuotient M (rs.take (rs.length - k)) :=
  equivOfPerm M (List.drop_reverse ▸ (rs.take (rs.length - k)).reverse_perm)

@[simp]
theorem dropReverseEquiv_mk (rs : List R) (k : ℕ) (x : M) :
    dropReverseEquiv M rs k (Submodule.Quotient.mk x) = Submodule.Quotient.mk x :=
  equivOfPerm_mk M _ x

@[simp]
theorem dropReverseEquiv_symm_mk (rs : List R) (k : ℕ) (x : M) :
    (dropReverseEquiv M rs k).symm (Submodule.Quotient.mk x) = Submodule.Quotient.mk x := by
  rw [← dropReverseEquiv_mk M rs k x, LinearEquiv.symm_apply_apply]

/-- By Nakayama's lemma, the prefix quotient of a nonzero finite module over a local ring by a list
whose entries lie in the maximal ideal is nonzero. -/
theorem nontrivial_of_forall_mem_maximalIdeal [IsLocalRing R] [Module.Finite R M] [Nontrivial M]
    {rs : List R} (h : ∀ r ∈ rs, r ∈ maximalIdeal R) : Nontrivial (prefixQuotient M rs) :=
  Submodule.Quotient.nontrivial_iff.2 (Submodule.top_ne_ideal_smul_of_le_jacobson_annihilator
    (span_le.2 fun r hr ↦ maximalIdeal_le_jacobson _ (h r hr))).symm

variable {M}

/-- A linear equivalence `M ≃ N` induces `M ⧸ (rs) M ≃ N ⧸ (rs) N`. -/
protected noncomputable def congr (rs : List R) (e : M ≃ₗ[R] N) :
    prefixQuotient M rs ≃ₗ[R] prefixQuotient N rs :=
  Submodule.Quotient.equiv _ _ e
    (by rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range])

@[simp]
theorem congr_mk (rs : List R) (e : M ≃ₗ[R] N) (x : M) :
    prefixQuotient.congr rs e (Submodule.Quotient.mk x) = Submodule.Quotient.mk (e x) :=
  (rfl)

end prefixQuotient

end TauCeti
