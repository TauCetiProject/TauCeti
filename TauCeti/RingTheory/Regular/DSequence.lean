module

public import Mathlib.RingTheory.Regular.RegularSequence
public import TauCeti.Algebra.Module.Torsion.Basic

/-!
# d-sequences and the Goto–Yamagishi identities

Huneke's d-sequences weaken regular sequences. For a module `M` over a commutative ring `R`, a list
`r₁, …, rₛ` with ideal `J = (r₁, …, rₛ)` is a *d-sequence* on `M` when, for every `i`,
multiplication by `rᵢ` is injective on the submodule `J · (M ⧸ (r₁, …, r_{i-1}) M)` of the `i`-th
prefix quotient, that is, on the image of `J M`. Only this submodule is involved, not the whole
prefix quotient, so a weakly regular sequence is a d-sequence, and so are lists such as `[0]` on a
field and `[1]` on any module. Nothing is assumed about `R`, `M` or the list.

Writing `Qᵢ = (r₁, …, r_{i-1}) M`, the condition says that an element of `J M` whose product with
`rᵢ` lies in `Qᵢ` already lies in `Qᵢ`. Equivalently, for all `i ≤ j` the `r_j`-torsion and the
`rᵢ r_j`-torsion of `M ⧸ Qᵢ` coincide; note that the later element `r_j` appears in both. This
torsion form is Kawasaki's definition. For a d-sequence and `n ≥ 1` the Goto–Yamagishi identities
hold:
`(Qᵢ :_M rᵢ) ∩ Jⁿ M = Qᵢ ∩ Jⁿ M = (r₁, …, r_{i-1}) J^{n-1} M`.

d-sequences arise in Kawasaki's construction of Cohen–Macaulay blowing-ups: reversed initial
segments of the parameter sequences used there are d-sequences after dividing by auxiliary
parameters, and the Goto–Yamagishi identities control the products of the ideals generated by
their initial segments.

Indices are `0`-based: the `i`-th prefix quotient is `M ⧸ (Ideal.ofList (rs.take i) • ⊤)`, and
the element acting on it is `rs[i]`.

## Main definitions and results

* `Ideal.ofList_mono`: `Ideal.ofList` is monotone along list inclusion.
* `TauCeti.IsDSequence M rs`: the list `rs` is a d-sequence on `M`.
* `TauCeti.isDSequence_iff_forall_mem_of_smul_mem`: the membership form of the definition.
* `RingTheory.Sequence.IsWeaklyRegular.isDSequence`: weakly regular sequences are d-sequences.
* `TauCeti.isDSequence_singleton_iff`: `[r]` is a d-sequence iff `r` is injective on `r M`.
* `LinearEquiv.isDSequence_congr`: d-sequences are invariant under linear equivalences.
* `TauCeti.isDSequence_iff_torsionBy_eq`: the torsion characterization.
* `TauCeti.IsDSequence.comap_lsmul_inf_pow_smul_top_eq`: the Goto–Yamagishi colon identity.
* `TauCeti.IsDSequence.inf_pow_smul_top_eq`: the Goto–Yamagishi intersection identity.

## References

* C. Huneke, *The theory of d-sequences and powers of ideals*, Adv. Math. 46 (1982), 249–279.
* K. Česnavičius, *Macaulayfication of Noetherian schemes*, Duke Math. J. 170 (2021),
  arXiv:1810.04493v2, Definition 3.8 and Remarks 3.9–3.10.
* T. Kawasaki, *On Macaulayfication of local rings — in the case dim non-CM ≤ 2*,
  RIMS Kôkyûroku 964 (1996), Definition 2.1.
-/

public section

open scoped Pointwise

open Submodule

/-- The ideal generated by a list is monotone along list inclusion. -/
theorem Ideal.ofList_mono {R : Type*} [Semiring R] {l₁ l₂ : List R} (h : l₁ ⊆ l₂) :
    Ideal.ofList l₁ ≤ Ideal.ofList l₂ :=
  Ideal.span_mono fun _ hr => h hr

variable {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

namespace TauCeti

variable (M) in
/-- A list `rs = [r₁, …, rₛ]` is a *d-sequence* on `M` (Huneke) when, for every `i`,
multiplication by `rᵢ` is injective on the submodule `(r₁, …, rₛ) · (M ⧸ (r₁, …, r_{i-1}) M)` of
the `i`-th prefix quotient. No finiteness, locality or properness is assumed. -/
@[mk_iff]
structure IsDSequence (rs : List R) : Prop where
  /-- Multiplication by `rs[i]` is injective on the image of `(rs) M` in `M ⧸ (rs.take i) M`. -/
  isSMulRegular : ∀ i (h : i < rs.length),
    IsSMulRegular
      (Ideal.ofList rs • ⊤ : Submodule R (M ⧸ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M)))
      rs[i]

/-- Membership form of the definition: `rs` is a d-sequence on `M` if and only if every element
`x` of `(rs) M` with `rs[i] • x ∈ (rs.take i) M` lies in `(rs.take i) M`. -/
theorem isDSequence_iff_forall_mem_of_smul_mem (rs : List R) :
    IsDSequence M rs ↔ ∀ i (h : i < rs.length), ∀ x ∈ (Ideal.ofList rs • ⊤ : Submodule R M),
      rs[i] • x ∈ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) →
        x ∈ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) := by
  rw [isDSequence_iff]
  refine forall₂_congr fun i hi => (isSMulRegular_iff_torsionBy_eq_bot
    (Ideal.ofList rs • ⊤ : Submodule R (M ⧸ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M)))
    rs[i]).trans ?_
  -- the image of `(rs) M` in the prefix quotient is `(rs) · (M ⧸ (rs.take i) M)`
  have hmap : ∀ y : M ⧸ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M),
      y ∈ (Ideal.ofList rs • ⊤ : Submodule R (M ⧸ _)) ↔
        ∃ x ∈ (Ideal.ofList rs • ⊤ : Submodule R M), mkQ _ x = y := fun y => by
    rw [← mem_map, map_smul'', Submodule.map_top, range_mkQ]
  rw [Submodule.eq_bot_iff]
  simp only [mem_torsionBy_iff]
  refine ⟨fun h x hx hrx => ?_, fun h => ?_⟩
  · have hmem := (hmap _).2 ⟨x, hx, rfl⟩
    have hrx' : rs[i] • (⟨_, hmem⟩ : ↥(Ideal.ofList rs • ⊤ : Submodule R (M ⧸ _))) = 0 :=
      Subtype.ext (by simpa [← Quotient.mk_smul] using hrx)
    simpa using congrArg Subtype.val (h _ hrx')
  · rintro ⟨y, hy⟩ hry
    obtain ⟨x, hx, rfl⟩ := (hmap _).1 hy
    have hrx : rs[i] • x ∈ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) := by
      simpa [← Quotient.mk_smul] using congrArg Subtype.val hry
    exact Subtype.ext (by simpa using h x hx hrx)

/-- In a d-sequence, an element `x` of `(rs) M` with `rs[i] • x ∈ (rs.take i) M` lies in
`(rs.take i) M`. -/
theorem IsDSequence.mem_of_smul_mem {rs : List R} (h : IsDSequence M rs) {i : ℕ}
    (hi : i < rs.length) {x : M} (hx : x ∈ (Ideal.ofList rs • ⊤ : Submodule R M))
    (hrx : rs[i] • x ∈ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M)) :
    x ∈ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) :=
  (isDSequence_iff_forall_mem_of_smul_mem rs).1 h i hi x hx hrx

variable (M) in
/-- The empty list is a d-sequence on every module. -/
@[simp]
theorem isDSequence_nil : IsDSequence M ([] : List R) :=
  ⟨fun _ h => absurd h (Nat.not_lt_zero _)⟩

/-- Every list is a d-sequence on a subsingleton module. -/
theorem IsDSequence.of_subsingleton [Subsingleton M] (rs : List R) : IsDSequence M rs :=
  (isDSequence_iff_forall_mem_of_smul_mem rs).2 fun _ _ x _ _ => by
    rw [Subsingleton.elim x 0]
    exact zero_mem _

/-- `[r]` is a d-sequence on `M` if and only if multiplication by `r` is injective on `r M`. -/
theorem isDSequence_singleton_iff (r : R) :
    IsDSequence M [r] ↔ ∀ x : M, r • r • x = 0 → r • x = 0 := by
  simp only [isDSequence_iff_forall_mem_of_smul_mem, List.length_singleton, Nat.lt_one_iff,
    forall_eq, List.take_zero, Ideal.ofList_nil, bot_smul, mem_bot, Ideal.ofList_singleton,
    ideal_span_singleton_smul, mem_smul_pointwise_iff_exists, mem_top, true_and,
    forall_exists_index, List.getElem_singleton]
  exact ⟨fun h x hx => h _ x rfl hx, fun h _ x hx hrx => hx ▸ h x (hx ▸ hrx)⟩

end TauCeti

open TauCeti

/-- A weakly regular sequence is a d-sequence: injectivity on the whole prefix quotient restricts
to the submodule `(rs) · (M ⧸ (rs.take i) M)`. -/
theorem RingTheory.Sequence.IsWeaklyRegular.isDSequence {rs : List R}
    (h : RingTheory.Sequence.IsWeaklyRegular M rs) : IsDSequence M rs :=
  (isDSequence_iff_forall_mem_of_smul_mem rs).2 fun i hi x _ hrx =>
    (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).1 (h.regular_mod_prev i hi) x hrx

/-- d-sequences are invariant under linear equivalences. -/
theorem LinearEquiv.isDSequence_congr (e : M ≃ₗ[R] N) (rs : List R) :
    IsDSequence M rs ↔ IsDSequence N rs := by
  have key : ∀ (I : Ideal R) (x : M),
      e x ∈ (I • ⊤ : Submodule R N) ↔ x ∈ (I • ⊤ : Submodule R M) := fun I x =>
    ⟨fun hx => by simpa using smul_top_le_comap_smul_top I e.symm.toLinearMap hx,
      fun hx => smul_top_le_comap_smul_top I e.toLinearMap hx⟩
  simp only [isDSequence_iff_forall_mem_of_smul_mem]
  refine forall₂_congr fun i hi => ⟨fun h y hy hry => ?_, fun h x hx hrx => ?_⟩
  · obtain ⟨x, rfl⟩ := e.surjective y
    rw [← map_smul] at hry
    rw [key] at hy hry ⊢
    exact h _ hy hry
  · rw [← key] at hx hrx ⊢
    exact h _ hx (by rwa [← map_smul])

namespace TauCeti

/-- The element form of the torsion conditions: for `i ≤ j`, if `(rs[i] * rs[j]) • x` lies in
`(rs.take i) M` then so does `rs[j] • x`. -/
private def TorsionCondition (M : Type*) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  ∀ i j (hij : i ≤ j) (hj : j < rs.length) (x : M),
    (rs[i] * rs[j]) • x ∈ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) →
      rs[j] • x ∈ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M)

/-- A list satisfying the torsion conditions is a d-sequence. -/
private theorem isDSequence_of_torsionCondition {rs : List R} (h : TorsionCondition M rs) :
    IsDSequence M rs := by
  -- Induct on the length, splitting off the last element `r`: an element `x` of `(rs ++ [r]) M`
  -- killed by `rs[i]` modulo `(rs.take i) M` is first shown to lie in `(rs) M`, using the
  -- conditions for `(i, last)` and `(last, last)`, and then the induction hypothesis applies.
  induction rs using List.reverseRecOn with
  | nil => exact isDSequence_nil M
  | append_singleton rs r ih =>
    have hlen : (rs ++ [r]).length = rs.length + 1 := by simp
    -- the conditions for `rs ++ [r]` restrict to `rs`
    have hrs : IsDSequence M rs := ih fun i j hij hj x hx => by
      have := h i j hij (by omega) x
      simp only [List.getElem_append_left (show i < rs.length by omega),
        List.getElem_append_left hj, List.take_append_of_le_length (show i ≤ rs.length by omega)]
        at this
      exact this hx
    refine (isDSequence_iff_forall_mem_of_smul_mem _).2 fun i hi x hx hrx => ?_
    have hi' : i ≤ rs.length := by omega
    have hlast : (rs ++ [r])[rs.length]'(by omega) = r := by simp
    have htake : (rs ++ [r]).take rs.length = rs := by simp
    -- the `(i, last)` condition: `r • x ∈ Qᵢ`
    have hrx' : r • x ∈ (Ideal.ofList ((rs ++ [r]).take i) • ⊤ : Submodule R M) := by
      have := h i rs.length hi' (by omega) x
      rw [hlast, mul_smul, smul_comm] at this
      exact this (smul_mem _ _ hrx)
    -- write `x = y + r • z` with `y ∈ (rs) M`
    rw [Ideal.ofList_append, sup_smul, Ideal.ofList_singleton, ideal_span_singleton_smul,
      mem_sup] at hx
    obtain ⟨y, hy, w, hw, rfl⟩ := hx
    obtain ⟨z, -, rfl⟩ := (mem_smul_pointwise_iff_exists _ _ _).1 hw
    -- the `(last, last)` condition: `r • z ∈ (rs) M`
    have hrz : r • z ∈ (Ideal.ofList rs • ⊤ : Submodule R M) := by
      have := h rs.length rs.length le_rfl (by omega) z
      rw [hlast, htake, mul_smul] at this
      refine this ?_
      have h1 : r • (y + r • z) ∈ (Ideal.ofList rs • ⊤ : Submodule R M) := by
        rw [← htake]
        exact smul_mono_left (Ideal.ofList_mono (List.take_prefix_take_left hi').subset) hrx'
      rw [smul_add] at h1
      exact (add_mem_cancel_left (smul_mem _ r hy)).1 h1
    have hmem : y + r • z ∈ (Ideal.ofList rs • ⊤ : Submodule R M) := add_mem hy hrz
    rcases hi'.lt_or_eq with hi' | rfl
    · rw [List.take_append_of_le_length hi'.le] at hrx ⊢
      rw [List.getElem_append_left hi'] at hrx
      exact hrs.mem_of_smul_mem hi' hmem hrx
    · rwa [htake]

/-- **Torsion characterization of d-sequences.** A list `rs` is a d-sequence on `M` if and only if
for all `i ≤ j` the `rs[j]`-torsion and the `rs[i] * rs[j]`-torsion of the prefix quotient
`M ⧸ (rs.take i) M` coincide. The later element `rs[j]` appears on both sides. -/
theorem isDSequence_iff_torsionBy_eq (rs : List R) :
    IsDSequence M rs ↔ ∀ i j (hij : i ≤ j) (hj : j < rs.length),
      torsionBy R (M ⧸ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M)) (rs[i] * rs[j]) =
        torsionBy R (M ⧸ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M)) rs[j] := by
  have key : ∀ i j (hij : i ≤ j) (hj : j < rs.length),
      torsionBy R (M ⧸ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M)) (rs[i] * rs[j]) =
          torsionBy R (M ⧸ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M)) rs[j] ↔
        ∀ x : M, (rs[i] * rs[j]) • x ∈ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) →
          rs[j] • x ∈ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) := by
    intro i j hij hj
    refine ⟨fun h x hx => ?_, fun h => le_antisymm ?_ ?_⟩
    · rwa [← Quotient.mk_mem_torsionBy_iff, h, Quotient.mk_mem_torsionBy_iff] at hx
    · rintro ⟨x⟩ hx
      rw [Quotient.quot_mk_eq_mk, Quotient.mk_mem_torsionBy_iff] at hx ⊢
      exact h x hx
    · rintro ⟨x⟩ hx
      rw [Quotient.quot_mk_eq_mk, Quotient.mk_mem_torsionBy_iff] at hx ⊢
      rw [mul_smul]
      exact smul_mem _ _ hx
  refine ⟨fun h i j hij hj => (key i j hij hj).2 fun x hx => ?_,
    fun h => isDSequence_of_torsionCondition fun i j hij hj => (key i j hij hj).1 (h i j hij hj)⟩
  have hj' : rs[j] ∈ Ideal.ofList rs := Ideal.subset_span (List.getElem_mem hj)
  refine h.mem_of_smul_mem (by omega) (smul_mem_smul hj' mem_top) ?_
  rwa [← mul_smul]

/-- **The Goto–Yamagishi colon identity.** For a d-sequence `rs` with ideal `J`, `i < length rs`
and `n ≥ 1`, `((rs.take i) M :_M rs[i]) ∩ Jⁿ M = (rs.take i) M ∩ Jⁿ M`, the colon being the
preimage under multiplication by `rs[i]`. -/
theorem IsDSequence.comap_lsmul_inf_pow_smul_top_eq {rs : List R} (h : IsDSequence M rs) {i : ℕ}
    (hi : i < rs.length) {n : ℕ} (hn : n ≠ 0) :
    (Ideal.ofList (rs.take i) • ⊤ : Submodule R M).comap (LinearMap.lsmul R M rs[i]) ⊓
        Ideal.ofList rs ^ n • ⊤ =
      (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) ⊓ Ideal.ofList rs ^ n • ⊤ := by
  refine le_antisymm ?_ (inf_le_inf_right _ fun x hx => mem_comap.2 (smul_mem _ _ hx))
  rintro x ⟨hx, hxn⟩
  exact ⟨h.mem_of_smul_mem hi (smul_mono_left (Ideal.pow_le_self hn) hxn) hx, hxn⟩

/-- The inductive step of the Goto–Yamagishi intersection identity at exponent `m + 2`: given the
identity at exponent `m + 1` for `i` and at exponent `m + 2` for `i + 1`, it holds at exponent
`m + 2` for `i`. -/
private theorem IsDSequence.inf_pow_smul_top_le_step {rs : List R} (h : IsDSequence M rs) {i : ℕ}
    (hi : i < rs.length) {m : ℕ}
    (hm : (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) ⊓ Ideal.ofList rs ^ (m + 1) • ⊤ ≤
      (Ideal.ofList (rs.take i) * Ideal.ofList rs ^ m) • ⊤)
    (hsucc : (Ideal.ofList (rs.take (i + 1)) • ⊤ : Submodule R M) ⊓
        Ideal.ofList rs ^ (m + 2) • ⊤ ≤
      (Ideal.ofList (rs.take (i + 1)) * Ideal.ofList rs ^ (m + 1)) • ⊤) :
    (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) ⊓ Ideal.ofList rs ^ (m + 2) • ⊤ ≤
      (Ideal.ofList (rs.take i) * Ideal.ofList rs ^ (m + 1)) • ⊤ := by
  set J := Ideal.ofList rs
  set Q : Submodule R M := Ideal.ofList (rs.take i) • ⊤
  rintro x ⟨hxQ, hxn⟩
  -- by the case `i + 1`, `x = y + rs[i] • z` with `y ∈ (rs.take i) J^{m+1} M`, `z ∈ J^{m+1} M`
  have hx := hsucc ⟨smul_mono_left
    (Ideal.ofList_mono (List.take_prefix_take_left i.le_succ).subset) hxQ, hxn⟩
  rw [List.take_succ_eq_append_getElem hi, Ideal.ofList_append, Ideal.ofList_singleton,
    Ideal.sup_mul, sup_smul, mem_sup] at hx
  obtain ⟨y, hy, w, hw, rfl⟩ := hx
  rw [Submodule.mul_smul, ideal_span_singleton_smul, mem_smul_pointwise_iff_exists] at hw
  obtain ⟨z, hz, rfl⟩ := hw
  have hyQ : y ∈ Q := smul_mono_left Ideal.mul_le_left hy
  -- `rs[i] • z ∈ Q`, so `z ∈ Q` by the d-sequence property
  have hzQ : z ∈ Q := h.mem_of_smul_mem hi (smul_mono_left (Ideal.pow_le_self (by omega)) hz)
    ((add_mem_cancel_left hyQ).1 hxQ)
  -- by the case `m + 1`, `z ∈ (rs.take i) J^m M`, so `rs[i] • z ∈ (rs.take i) J^{m+1} M`
  have hz' := hm ⟨hzQ, hz⟩
  refine add_mem hy ?_
  have hJ : rs[i] ∈ J := Ideal.subset_span (List.getElem_mem hi)
  have := smul_mem_smul hJ hz'
  rwa [← Submodule.mul_smul, mul_left_comm, ← pow_succ'] at this

/-- **The Goto–Yamagishi intersection identity.** For a d-sequence `rs` with ideal `J`, every `i`
and `n ≥ 1`, `(rs.take i) M ∩ Jⁿ M = (rs.take i) J^{n-1} M`. For `i ≥ length rs` this is
`J M ∩ Jⁿ M = Jⁿ M`. -/
theorem IsDSequence.inf_pow_smul_top_eq {rs : List R} (h : IsDSequence M rs) (i : ℕ) {n : ℕ}
    (hn : n ≠ 0) :
    (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) ⊓ Ideal.ofList rs ^ n • ⊤ =
      (Ideal.ofList (rs.take i) * Ideal.ofList rs ^ (n - 1)) • ⊤ := by
  set J := Ideal.ofList rs
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hn
  rw [Nat.add_sub_cancel]
  refine le_antisymm ?_ (le_inf (smul_mono_left Ideal.mul_le_left) (smul_mono_left ?_))
  · -- induction on `m`, and for fixed `m` decreasing induction on `i`
    induction m generalizing i with
    | zero => simp
    | succ m ihm =>
      -- for `i ≥ length rs` the prefix is all of `rs`
      have hge : ∀ i, rs.length ≤ i →
          (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) ⊓ J ^ (m + 2) • ⊤ ≤
            (Ideal.ofList (rs.take i) * J ^ (m + 1)) • ⊤ := fun i hi => by
        rw [List.take_of_length_le hi, ← pow_succ']
        exact inf_le_right
      suffices ∀ k i, rs.length ≤ i + k →
          (Ideal.ofList (rs.take i) • ⊤ : Submodule R M) ⊓ J ^ (m + 2) • ⊤ ≤
            (Ideal.ofList (rs.take i) * J ^ (m + 1)) • ⊤ from this rs.length i (by omega)
      intro k
      induction k with
      | zero => exact fun i hi => hge i hi
      | succ k ihk =>
        intro i hi
        rcases lt_or_ge i rs.length with hi' | hi'
        · exact h.inf_pow_smul_top_le_step hi' (ihm i (by omega)) (ihk (i + 1) (by omega))
        · exact hge i hi'
  · rw [pow_succ']
    exact Ideal.mul_mono_left (Ideal.ofList_mono (List.take_subset i rs))

end TauCeti
