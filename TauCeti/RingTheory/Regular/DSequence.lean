module

public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.RingTheory.Regular.RegularSequence

import TauCeti.RingTheory.Ideal.Operations

/-!
# d-sequences and the Goto–Yamagishi identities

Huneke's d-sequences weaken regular sequences. A list `r₁, …, rₛ` in a commutative ring `R` is a
d-sequence on an `R`-module `M` when, for every `i`, multiplication by `rᵢ` is injective on the
submodule `J · (M ⧸ Qᵢ)` of the prefix quotient `M ⧸ Qᵢ`, where `J = (r₁, …, rₛ)` and
`Qᵢ = (r₁, …, r_{i-1}) M`. Only on the part of the prefix quotient generated by the whole
sequence is multiplication by the particular element `rᵢ` asked to be injective, so `[0]` and `[1]`
are d-sequences on every module, and the order of the entries matters. Nothing here assumes
finiteness, a Noetherian or local ring, or a nonzero module.

The torsion characterization is Kawasaki's definition of d-sequences: for all `i ≤ j`, the
`r_j`-torsion and the `rᵢ r_j`-torsion of `M ⧸ Qᵢ` agree. Note that the index that survives is the
later one, `j`.

The Goto–Yamagishi identities compute the powers of `J` against the prefix submodules: for a
d-sequence and every `n`,

`(Qᵢ :_M rᵢ) ∩ J^{n+1} M = Qᵢ ∩ J^{n+1} M = (r₁, …, r_{i-1}) Jⁿ M`.

They control the Rees module of `J` and of the products of prefix ideals of a d-sequence, which is
how they enter the study of Cohen–Macaulay blowing-ups.

## Main definitions

* `RingTheory.Sequence.IsDSequence`: `rs` is a d-sequence on `M`.

## Main results

* `Ideal.ofList_mono`: the ideal generated by a list grows with the set of its entries.
* `RingTheory.Sequence.isDSequence_iff_smul_mem`: the d-sequence condition in terms of submodules
  of `M`, without passing to prefix quotients.
* `RingTheory.Sequence.IsWeaklyRegular.isDSequence`: weakly regular sequences are d-sequences.
* `RingTheory.Sequence.isDSequence_singleton_iff`: `[r]` is a d-sequence iff `r` is regular on
  `r M`.
* `LinearEquiv.isDSequence_congr`: d-sequences are invariant under linear equivalences.
* `RingTheory.Sequence.isDSequence_iff_torsionBy_mul_eq`: the torsion characterization.
* `RingTheory.Sequence.IsDSequence.comap_lsmul_inf_pow_smul_top`: the colon identity
  `(Qᵢ :_M rᵢ) ∩ J^{n+1} M = Qᵢ ∩ J^{n+1} M`.
* `RingTheory.Sequence.IsDSequence.ofList_take_smul_top_inf_pow_smul_top`: the intersection
  identity `Qᵢ ∩ J^{n+1} M = (r₁, …, r_{i-1}) Jⁿ M`.

## References

* C. Huneke, *The theory of d-sequences and powers of ideals*, Adv. Math. 46 (1982), 249–279.
* T. Kawasaki, *On Macaulayfication of local rings — in the case dim non-CM ≤ 2*, RIMS Kôkyûroku
  964 (1996), 40–50, Definition 2.1.
* T. Kawasaki, *On arithmetic Macaulayfication of local rings*, author preprint (1999),
  Proposition 3.2.
* K. Česnavičius, *Macaulayfication of Noetherian schemes*, Duke Math. J. 170 (2021),
  arXiv:1810.04493v2, Definition 3.8, Remarks 3.9 and 3.10.
-/

public section

open scoped Pointwise

open Ideal Submodule

/-- The ideal generated by a list grows with the set of its entries. -/
theorem Ideal.ofList_mono {R : Type*} [Semiring R] {l₁ l₂ : List R} (h : l₁ ⊆ l₂) :
    ofList l₁ ≤ ofList l₂ :=
  Ideal.span_mono fun _ hr => h hr

variable {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

namespace RingTheory.Sequence

variable (M) in
/-- A list `[r₁, …, rₛ]` is a *d-sequence* on `M` (Huneke) if, for every `i`, multiplication by
`rᵢ` is injective on the submodule `(r₁, …, rₛ) • (M ⧸ (r₁, …, r_{i-1}) M)` of the prefix
quotient `M ⧸ (r₁, …, r_{i-1}) M`. -/
@[mk_iff]
structure IsDSequence (rs : List R) : Prop where
  regular_mod_prev : ∀ i (h : i < rs.length),
    IsSMulRegular (ofList rs • ⊤ : Submodule R (M ⧸ (ofList (rs.take i) • ⊤ : Submodule R M)))
      rs[i]

/-- `rs` is a d-sequence on `M` iff, for every `i`, an element of `(r₁, …, rₛ) M` whose product
with `rᵢ` lies in `(r₁, …, r_{i-1}) M` already lies in `(r₁, …, r_{i-1}) M`. -/
theorem isDSequence_iff_smul_mem {rs : List R} :
    IsDSequence M rs ↔ ∀ i (h : i < rs.length), ∀ x ∈ (ofList rs • ⊤ : Submodule R M),
      rs[i] • x ∈ (ofList (rs.take i) • ⊤ : Submodule R M) →
        x ∈ (ofList (rs.take i) • ⊤ : Submodule R M) := by
  rw [isDSequence_iff]
  refine forall₂_congr fun i hi => ?_
  set Q : Submodule R M := ofList (rs.take i) • ⊤
  -- The image of `J M` in `M ⧸ Q` is `J • (M ⧸ Q)`.
  have hJ : (ofList rs • ⊤ : Submodule R (M ⧸ Q)) = (ofList rs • ⊤ : Submodule R M).map Q.mkQ :=
    (map_smul_top_of_surjective _ Q.mkQ Q.mkQ_surjective).symm
  rw [isSMulRegular_submodule_iff_right_eq_zero_of_smul, hJ]
  constructor
  · intro h x hx hrx
    rw [← Quotient.mk_eq_zero, ← mkQ_apply]
    refine h _ (mem_map_of_mem hx) ?_
    rwa [← map_smul, mkQ_apply, Quotient.mk_eq_zero]
  · rintro h _ ⟨x, hx, rfl⟩ hrx
    rw [mkQ_apply, ← Quotient.mk_smul, Quotient.mk_eq_zero] at hrx
    rw [mkQ_apply, Quotient.mk_eq_zero]
    exact h x hx hrx

namespace IsDSequence

variable {rs : List R}

/-- In a d-sequence, an element of `(r₁, …, rₛ) M` whose product with `rᵢ` lies in
`(r₁, …, r_{i-1}) M` already lies in `(r₁, …, r_{i-1}) M`. -/
theorem mem_of_smul_mem (h : IsDSequence M rs) {i : ℕ} (hi : i < rs.length) {x : M}
    (hx : x ∈ (ofList rs • ⊤ : Submodule R M))
    (hrx : rs[i] • x ∈ (ofList (rs.take i) • ⊤ : Submodule R M)) :
    x ∈ (ofList (rs.take i) • ⊤ : Submodule R M) :=
  isDSequence_iff_smul_mem.mp h i hi x hx hrx

variable (M) in
/-- The empty list is a d-sequence on every module. -/
@[simp]
theorem nil : IsDSequence M ([] : List R) :=
  ⟨fun _ h => absurd h (Nat.not_lt_zero _)⟩

/-- Every list is a d-sequence on the zero module. -/
theorem of_subsingleton [Subsingleton M] (rs : List R) : IsDSequence M rs :=
  isDSequence_iff_smul_mem.mpr fun _ _ x _ _ => Subsingleton.elim x 0 ▸ zero_mem _

end IsDSequence

/-- A weakly regular sequence is a d-sequence. -/
theorem IsWeaklyRegular.isDSequence {rs : List R} (h : IsWeaklyRegular M rs) :
    IsDSequence M rs :=
  ⟨fun i hi => (h.regular_mod_prev i hi).submodule _ _⟩

/-- A singleton `[r]` is a d-sequence on `M` iff multiplication by `r` is injective on `r M`. -/
theorem isDSequence_singleton_iff (r : R) :
    IsDSequence M [r] ↔ IsSMulRegular (r • ⊤ : Submodule R M) r := by
  simp only [isDSequence_iff_smul_mem, List.length_singleton, Nat.lt_one_iff, ofList_singleton,
    ideal_span_singleton_smul, isSMulRegular_submodule_iff_right_eq_zero_of_smul]
  simp

end RingTheory.Sequence

open RingTheory.Sequence in
/-- d-sequences are invariant under linear equivalences. -/
theorem LinearEquiv.isDSequence_congr (e : M ≃ₗ[R] N) (rs : List R) :
    IsDSequence M rs ↔ IsDSequence N rs := by
  have key (I : Ideal R) (x : M) :
      e x ∈ (I • ⊤ : Submodule R N) ↔ x ∈ (I • ⊤ : Submodule R M) := by
    rw [← map_smul_top_of_surjective I (e : M →ₗ[R] N) e.surjective, mem_map_equiv,
      LinearEquiv.symm_apply_apply]
  simp only [isDSequence_iff_smul_mem]
  refine forall₂_congr fun i hi => ⟨fun h y hy hry => ?_, fun h x hx hrx => ?_⟩
  · obtain ⟨x, rfl⟩ := e.surjective y
    rw [← map_smul, key] at hry
    rw [key] at hy ⊢
    exact h x hy hry
  · rw [← key, map_smul] at hrx
    rw [← key] at hx ⊢
    exact h (e x) hx hrx

namespace RingTheory.Sequence

variable (M) in
/-- The torsion form of the d-sequence condition, stated on `M`: for `i ≤ j`, if
`rᵢ r_j x ∈ (r₁, …, r_{i-1}) M` then `r_j x ∈ (r₁, …, r_{i-1}) M`. -/
private def TorsionCondition (rs : List R) : Prop :=
  ∀ i j (hij : i ≤ j) (hj : j < rs.length) (x : M),
    (rs[i] * rs[j]) • x ∈ (ofList (rs.take i) • ⊤ : Submodule R M) →
      rs[j] • x ∈ (ofList (rs.take i) • ⊤ : Submodule R M)

/-- The torsion condition passes from `l ++ [a]` to `l`. -/
private lemma TorsionCondition.of_append_singleton {l : List R} {a : R}
    (h : TorsionCondition M (l ++ [a])) : TorsionCondition M l := by
  intro i j hij hj x hx
  have hi : i ≤ l.length := hij.trans hj.le
  have := h i j hij (by simp; omega) x
  simp only [List.getElem_append_left (hij.trans_lt hj), List.getElem_append_left hj,
    List.take_append_of_le_length hi] at this
  exact this hx

/-- The converse half of the torsion characterization, by induction on the length of the list:
the last element `a` of `l ++ [a]` moves an element of `(l ++ [a]) M` satisfying the hypothesis
into `l M`, where the inductive hypothesis applies. -/
private lemma isDSequence_of_torsionCondition :
    ∀ {rs : List R}, TorsionCondition M rs → IsDSequence M rs := by
  intro rs
  induction rs using List.reverseRecOn with
  | nil => exact fun _ => IsDSequence.nil M
  | append_singleton l a ih =>
    intro h
    have hl := isDSequence_iff_smul_mem.mp (ih h.of_append_singleton)
    refine isDSequence_iff_smul_mem.mpr fun i hi x hx hrx => ?_
    simp only [List.length_append, List.length_singleton] at hi
    have hil : i ≤ l.length := Nat.le_of_lt_succ hi
    have hlast : (l ++ [a])[l.length] = a := by simp
    have htake : (l ++ [a]).take i = l.take i := List.take_append_of_le_length hil
    have htake' : (l ++ [a]).take l.length = l := by simp
    have hQ : (ofList (l.take i) • ⊤ : Submodule R M) ≤ ofList l • ⊤ :=
      smul_mono_left (ofList_mono (List.take_subset _ _))
    rw [htake] at hrx ⊢
    -- Step 1: the `(i, s)` torsion condition gives `a • x ∈ (r₁, …, r_{i-1}) M`.
    have hax : a • x ∈ (ofList (l.take i) • ⊤ : Submodule R M) := by
      have := h i l.length hil (by simp) x
      rw [hlast, htake, mul_comm, mul_smul] at this
      exact this (smul_mem _ a hrx)
    -- Step 2: the `(s, s)` condition moves `x` into `l M`.
    have hxl : x ∈ (ofList l • ⊤ : Submodule R M) := by
      rw [ofList_append, ofList_singleton, sup_smul, ideal_span_singleton_smul] at hx
      obtain ⟨y, hy, z, hz, rfl⟩ := mem_sup.mp hx
      obtain ⟨w, -, rfl⟩ := mem_smul_pointwise_iff_exists _ _ _ |>.mp hz
      have hw : (a * a) • w ∈ (ofList l • ⊤ : Submodule R M) := by
        rw [mul_smul]
        have := hQ hax
        rw [smul_add] at this
        exact (add_mem_cancel_left (smul_mem _ a hy)).mp this
      have := h l.length l.length le_rfl (by simp) w
      rw [hlast, htake'] at this
      exact add_mem hy (this hw)
    -- Step 3: conclude, directly for `i = s` and by induction for `i < s`.
    rcases hil.lt_or_eq with hil | rfl
    · rw [List.getElem_append_left hil] at hrx
      exact hl i hil x hxl hrx
    · rwa [List.take_length]

/-- **Torsion characterization of d-sequences** (Kawasaki's definition): `rs` is a d-sequence on
`M` iff for all `i ≤ j` the `r_j`-torsion and the `rᵢ r_j`-torsion of `M ⧸ (r₁, …, r_{i-1}) M`
agree. -/
theorem isDSequence_iff_torsionBy_mul_eq {rs : List R} :
    IsDSequence M rs ↔ ∀ i j (hij : i ≤ j) (hj : j < rs.length),
      torsionBy R (M ⧸ (ofList (rs.take i) • ⊤ : Submodule R M)) (rs[i] * rs[j]) =
        torsionBy R (M ⧸ (ofList (rs.take i) • ⊤ : Submodule R M)) rs[j] := by
  have key : ∀ i j (hij : i ≤ j) (hj : j < rs.length),
      torsionBy R (M ⧸ (ofList (rs.take i) • ⊤ : Submodule R M)) (rs[i] * rs[j]) =
          torsionBy R (M ⧸ (ofList (rs.take i) • ⊤ : Submodule R M)) rs[j] ↔
        ∀ x : M, (rs[i] * rs[j]) • x ∈ (ofList (rs.take i) • ⊤ : Submodule R M) →
          rs[j] • x ∈ (ofList (rs.take i) • ⊤ : Submodule R M) := by
    intro i j hij hj
    rw [le_antisymm_iff, and_iff_left (torsionBy_le_torsionBy_of_dvd _ _ (dvd_mul_left _ _))]
    refine ⟨fun h x hx => ?_, fun h y hy => ?_⟩
    · have := h (x := Submodule.Quotient.mk x) (by rwa [mem_torsionBy_iff, ← Quotient.mk_smul,
        Quotient.mk_eq_zero])
      rwa [mem_torsionBy_iff, ← Quotient.mk_smul, Quotient.mk_eq_zero] at this
    · obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ y
      rw [mem_torsionBy_iff, ← Quotient.mk_smul, Quotient.mk_eq_zero] at hy ⊢
      exact h x hy
  refine ⟨fun h i j hij hj => (key i j hij hj).mpr fun x hx => ?_, fun h =>
    isDSequence_of_torsionCondition fun i j hij hj => (key i j hij hj).mp (h i j hij hj)⟩
  rw [mul_smul] at hx
  exact h.mem_of_smul_mem (hij.trans_lt hj) (smul_mem_smul (Ideal.subset_span (List.getElem_mem hj))
    mem_top) hx

namespace IsDSequence

variable {rs : List R}

/-- **The Goto–Yamagishi colon identity**: in a d-sequence, for every `n`,
`(Qᵢ :_M rᵢ) ∩ J^{n+1} M = Qᵢ ∩ J^{n+1} M`, where `J = (r₁, …, rₛ)` and
`Qᵢ = (r₁, …, r_{i-1}) M`. It fails for `J⁰ M = M` in general. -/
theorem comap_lsmul_inf_pow_smul_top (h : IsDSequence M rs) {i : ℕ} (hi : i < rs.length)
    (n : ℕ) :
    (ofList (rs.take i) • ⊤ : Submodule R M).comap (LinearMap.lsmul R M rs[i]) ⊓
        ofList rs ^ (n + 1) • ⊤ =
      (ofList (rs.take i) • ⊤ : Submodule R M) ⊓ ofList rs ^ (n + 1) • ⊤ := by
  refine le_antisymm (fun x ⟨hrx, hx⟩ => ⟨h.mem_of_smul_mem hi ?_ hrx, hx⟩)
    (inf_le_inf_right _ fun x hx => smul_mem _ rs[i] hx)
  exact smul_mono_left (pow_le_self n.succ_ne_zero) hx

/-- **The Goto–Yamagishi intersection identity**: in a d-sequence, for every `i` and `n`,
`Qᵢ ∩ J^{n+1} M = (r₁, …, r_{i-1}) Jⁿ M`, where `J = (r₁, …, rₛ)` and
`Qᵢ = (r₁, …, r_{i-1}) M`. -/
theorem ofList_take_smul_top_inf_pow_smul_top (h : IsDSequence M rs) (i n : ℕ) :
    (ofList (rs.take i) • ⊤ : Submodule R M) ⊓ ofList rs ^ (n + 1) • ⊤ =
      (ofList (rs.take i) * ofList rs ^ n) • ⊤ := by
  refine le_antisymm ?_ (le_inf (smul_mono_left Ideal.mul_le_left) (smul_mono_left ?_))
  swap
  · rw [pow_succ']
    exact Ideal.mul_mono_left (ofList_mono (List.take_subset _ _))
  -- Increasing induction on `n`, and inside it decreasing induction on `i`.
  induction n generalizing i with
  | zero => simp
  | succ n ihn =>
    obtain ⟨k, hk⟩ : ∃ k, rs.length - i = k := ⟨_, rfl⟩
    induction k generalizing i with
    | zero =>
      rw [List.take_of_length_le (by omega), ← pow_succ']
      exact inf_le_right
    | succ k ihk =>
      have hi : i < rs.length := by omega
      intro x ⟨hxQ, hxJ⟩
      have hQ : (ofList (rs.take i) • ⊤ : Submodule R M) ≤ ofList (rs.take (i + 1)) • ⊤ :=
        smul_mono_left (ofList_mono (List.take_subset_take_left rs (by omega)))
      have hx := ihk (i + 1) (by omega) ⟨hQ hxQ, hxJ⟩
      rw [← List.take_concat_get' rs i hi, ofList_append, ofList_singleton, Ideal.sup_mul, sup_smul,
        Submodule.mul_smul (span {rs[i]}), ideal_span_singleton_smul] at hx
      obtain ⟨y, hy, z', hz', rfl⟩ := mem_sup.mp hx
      obtain ⟨z, hz, rfl⟩ := mem_smul_pointwise_iff_exists _ _ _ |>.mp hz'
      refine add_mem hy ?_
      have hyQ : y ∈ (ofList (rs.take i) • ⊤ : Submodule R M) := smul_mono_left Ideal.mul_le_left hy
      have hzQ : z ∈ (ofList (rs.take i) • ⊤ : Submodule R M) :=
        h.mem_of_smul_mem hi (smul_mono_left (pow_le_self n.succ_ne_zero) hz)
          ((add_mem_cancel_left hyQ).mp hxQ)
      have hz₂ := ihn i ⟨hzQ, hz⟩
      have : rs[i] • z ∈ ((span {rs[i]} * (ofList (rs.take i) * ofList rs ^ n)) • ⊤ :
          Submodule R M) := by
        rw [Submodule.mul_smul]
        exact smul_mem_smul (Ideal.mem_span_singleton_self _) hz₂
      refine smul_mono_left ?_ this
      rw [mul_left_comm, pow_succ' _ n]
      exact Ideal.mul_mono_right (Ideal.mul_mono_left ((Ideal.span_singleton_le_iff_mem _).mpr
        (Ideal.subset_span (List.getElem_mem hi))))

end IsDSequence

end RingTheory.Sequence
