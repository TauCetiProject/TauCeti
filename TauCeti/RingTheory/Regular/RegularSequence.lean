/-!
# Constructing regular sequences

This file produces regular sequences on a module `M` from local information.

The elementary pair-power results are supplied by `TauCeti.RingTheory.Regular.Pair`.
If `a, b` is a weakly `M`-regular sequence, then `bʲ` is regular on `M ⧸ aⁿ M` and `aʲ` is regular
on `M ⧸ bⁿ M` for all `n` and `j`.
For `M = R`, an element of the total ring of fractions of `R` which lies in `R` after multiplication
by a power of `a`, and also after multiplication by a power of `b`, already lies in `R`. When `a`
and `b` are non-zero-divisors, this says that `R_a` and `R_b` intersect in `R` inside the total
ring of fractions. More generally, elements of `R_a` and `R_b` with the same image in `R_{ab}` come
from a unique element of `R`, without assuming that `b` is a non-zero-divisor.

If `f₁, …, f_r` is weakly `M`-regular, every relation `∑ fᵢ mᵢ = 0` with `mᵢ ∈ M` has all its
coefficients in `(f₁, …, f_r) M`. Dividing the last element out first,
`f_r m_r ∈ (f₁, …, f_{r-1}) M` forces `m_r = ∑_{i<r} fᵢ nᵢ`, and the relation
`∑_{i<r} fᵢ (mᵢ + f_r nᵢ) = 0` among the first `r - 1` elements finishes the induction.

Let `M` be a finite module over a Noetherian ring `R` and `I` an ideal of `R`. By prime avoidance,
`I` contains an `M`-regular element exactly when `I` lies in no associated prime of `M`. Iterating,
if `depth M_p ≥ n` at every prime `p ⊇ I`, then `I` contains a weakly `M`-regular sequence of
length `n`: an associated prime containing `I` would give a localization of depth zero, and
dividing by a regular element of `I` lowers each of these local depths by exactly one.

The second statement passes from depth at the points of the closed subset `V(I)` of `Spec R` to a
regular sequence on `M` itself. This is how a depth condition at the points of `V(I)` is used to
extend sections of `M~` across `V(I)` (Stacks, Lemma 31.5.11 (0E9I)).

## Main results

* `Ideal.ofList_ofFn`, `Ideal.ofList_eq_span_range_getElem`: the ideal generated by a list as the
  span of a range.
* `TauCeti.isRegular_cons_iff_isRegular_quotient`: `x :: rs` is `R`-regular exactly
  when `x` is a non-zero-divisor and the images of `rs` are regular on `R ⧸ (x)`.
* `RingTheory.Sequence.isWeaklyRegular_append_singleton_iff_of_ofList_eq`: whether `rs ++ [a]` is
  weakly regular depends only on `rs` and the ideal generated by `rs ++ [a]`.
* `RingTheory.Sequence.isRegular_append_iff`, `RingTheory.Sequence.IsRegular.of_append_left`:
  characterization of regularity of a concatenated sequence and prefix projection.
* `RingTheory.Sequence.IsWeaklyRegular.mem_range_algebraMap_of_pow_mul_mem`: for a weakly
  `R`-regular sequence `a, b`, a fraction which lies in `R` after multiplication by a power of `a`,
  and also after multiplication by a power of `b`, already lies in `R`.
* `RingTheory.Sequence.IsWeaklyRegular.existsUnique_algebraMap_eq`: for a weakly `R`-regular
  sequence `a, b`, elements of `R_a` and `R_b` with the same image in `R_{ab}` come from a unique
  element of `R`.
* `RingTheory.Sequence.IsWeaklyRegular.mem_ofList_smul_top_of_sum_eq_zero`: the coefficients of a
  relation `∑ fᵢ mᵢ = 0` among a weakly `M`-regular sequence lie in `(f₁, …, f_r) M`.
* `RingTheory.Sequence.IsWeaklyRegular.isLeftRegular_mk_ofList`: the last element of a weakly
  `R`-regular sequence is left-regular modulo the ideal generated by the preceding elements.
* `IsLocalRing.exists_isSMulRegular_of_depth_ne_zero`: over a Noetherian local ring, a finite
  module of nonzero depth has a regular element in the maximal ideal.
* `TauCeti.exists_isWeaklyRegular_of_le_depth_localizedModule`: if `depth M_p ≥ n` at every prime
  `p ⊇ I`, then `I` contains a weakly `M`-regular sequence of length `n`.

## References

* [Stacks Project, Lemma 31.5.11](https://stacks.math.columbia.edu/tag/0E9I).
* [The Stacks Project, Tag 062F](https://stacks.math.columbia.edu/tag/062F)
-/

public section

universe u v

open IsLocalRing RingTheory.Sequence Module Pointwise

section OfList

variable {R : Type*} [Semiring R]

/-- The ideal generated by the entries of `List.ofFn f` is the span of the range of `f`. -/
@[simp]
theorem Ideal.ofList_ofFn {n : ℕ} (f : Fin n → R) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) :=
  congrArg Ideal.span (Set.ext fun _ ↦ List.mem_ofFn' f _)

/-- The ideal generated by a list is the span of its entries, indexed by position. -/
theorem Ideal.ofList_eq_span_range_getElem (rs : List R) :
    Ideal.ofList rs = Ideal.span (Set.range fun i : Fin rs.length ↦ rs[i]) := by
  simpa using Ideal.ofList_ofFn fun i : Fin rs.length ↦ rs[(i : ℕ)]

end OfList


section Subsingleton

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

/-- Every finite sequence is weakly regular on a module with at most one element. -/
theorem RingTheory.Sequence.IsWeaklyRegular.of_subsingleton [Subsingleton M] (rs : List R) :
    IsWeaklyRegular M rs :=
  ⟨fun _ _ _ _ _ ↦ Subsingleton.elim _ _⟩

end Subsingleton

section Cons

variable {R : Type u} [CommRing R]

/-- A sequence `x :: rs` is `R`-regular exactly when `x` is a non-zero-divisor and the images of
`rs` form a regular sequence on the ring `R ⧸ (x)`. -/
theorem TauCeti.isRegular_cons_iff_isRegular_quotient (x : R) (rs : List R) :
    IsRegular R (x :: rs) ↔ IsSMulRegular R x ∧
      IsRegular (R ⧸ Ideal.span {x}) (rs.map (Ideal.Quotient.mk (Ideal.span {x}))) := by
  -- `R ⧸ x R` and `R ⧸ (x)` agree as modules over `R ⧸ (x)`.
  rw [isRegular_cons_iff']
  exact and_congr_right' (((QuotSMulTop.equivQuotSpanSingleton x).extendScalarsOfSurjective
    Ideal.Quotient.mk_surjective).isRegular_congr _)

end Cons

section Append

section WeaklyRegular

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

/-- Whether `rs ++ [a]` is a weakly regular sequence on `M` depends only on `rs` and the ideal
generated by `rs ++ [a]`. -/
theorem RingTheory.Sequence.isWeaklyRegular_append_singleton_iff_of_ofList_eq {rs : List R}
    {a b : R} (h : Ideal.ofList (rs ++ [a]) = Ideal.ofList (rs ++ [b])) :
    IsWeaklyRegular M (rs ++ [a]) ↔ IsWeaklyRegular M (rs ++ [b]) := by
  -- each of `a` and `b` lies in the ideal generated by `rs` and the other
  have hmem {a b : R} (h : Ideal.ofList (rs ++ [a]) = Ideal.ofList (rs ++ [b])) :
      a ∈ Ideal.ofList rs ⊔ Ideal.span {b} := by
    rw [← Ideal.ofList_singleton, ← Ideal.ofList_append, ← h]
    exact Ideal.subset_span (by simp)
  rw [isWeaklyRegular_append_iff, isWeaklyRegular_append_iff, isWeaklyRegular_singleton_iff,
    isWeaklyRegular_singleton_iff]
  exact and_congr_right fun _ ↦
    ⟨(Ideal.ofList rs).isSMulRegular_quotient_smul_top_of_mem_sup_span_singleton (hmem h),
      (Ideal.ofList rs).isSMulRegular_quotient_smul_top_of_mem_sup_span_singleton (hmem h.symm)⟩

end WeaklyRegular

variable {R : Type u} [CommRing R] (M : Type v) [AddCommGroup M] [Module R M]

namespace RingTheory.Sequence

/-- Concatenating two sequences gives an `M`-regular sequence if and only if the prefix is
`M`-regular and the suffix is regular on `M ⧸ (rs)M`. -/
theorem isRegular_append_iff (rs ss : List R) :
    IsRegular M (rs ++ ss) ↔
      IsRegular M rs ∧ IsRegular (M ⧸ (Ideal.ofList rs • ⊤ : Submodule R M)) ss := by
  have htop : Ideal.ofList (rs ++ ss) • (⊤ : Submodule R M) = ⊤ ↔
      Ideal.ofList ss • (⊤ : Submodule R (M ⧸ (Ideal.ofList rs • ⊤ : Submodule R M))) = ⊤ := by
    rw [Ideal.ofList_append, Submodule.sup_smul_top_eq_top_iff]
  refine ⟨fun h ↦ ?_, fun ⟨hrs, hss⟩ ↦ ?_⟩
  · obtain ⟨hw1, hw2⟩ := (isWeaklyRegular_append_iff M rs ss).1 h.toIsWeaklyRegular
    exact ⟨⟨hw1, fun h1 ↦ h.top_ne_smul (top_le_iff.1 (h1.le.trans (Submodule.smul_mono_left
      (by rw [Ideal.ofList_append]; exact le_sup_left)))).symm⟩,
      ⟨hw2, fun h2 ↦ h.top_ne_smul (htop.2 h2.symm).symm⟩⟩
  · exact ⟨(isWeaklyRegular_append_iff M rs ss).2 ⟨hrs.toIsWeaklyRegular, hss.toIsWeaklyRegular⟩,
      fun h ↦ hss.top_ne_smul (htop.1 h.symm).symm⟩

/-- A prefix of a regular sequence is regular. -/
theorem IsRegular.of_append_left {M : Type v} [AddCommGroup M] [Module R M] {rs ss : List R}
    (h : IsRegular M (rs ++ ss)) : IsRegular M rs :=
  ((isRegular_append_iff M rs ss).1 h).1

end RingTheory.Sequence

end Append


section FractionRing

variable {R : Type u} [CommRing R] {K : Type v} [CommRing K] [Algebra R K] [IsFractionRing R K]

/-- If `a, b` is a weakly `R`-regular sequence, an element of the total ring of fractions of `R`
which lies in `R` after multiplication by a power of `a`, and also after multiplication by a power
of `b`, already lies in `R`. When `b` is also a non-zero-divisor, this says that the localizations
`R_a` and `R_b` intersect in `R` inside the total ring of fractions. -/
theorem RingTheory.Sequence.IsWeaklyRegular.mem_range_algebraMap_of_pow_mul_mem {a b : R}
    (h : IsWeaklyRegular R [a, b]) {z : K} {n j : ℕ}
    (ha : algebraMap R K (a ^ n) * z ∈ (algebraMap R K).range)
    (hb : algebraMap R K (b ^ j) * z ∈ (algebraMap R K).range) :
    z ∈ (algebraMap R K).range := by
  obtain ⟨u, hu⟩ := ha
  obtain ⟨v, hv⟩ := hb
  have han : IsSMulRegular R (a ^ n) := ((isWeaklyRegular_cons_iff R a [b]).1 h).1.pow n
  -- Cross-multiplying, `bʲ u = aⁿ v`, so `u ∈ aⁿ R` as `bʲ` is regular on `R ⧸ aⁿ R`.
  have huv : a ^ n • v = b ^ j • u := IsFractionRing.injective R K <| by
    simp only [smul_eq_mul, map_mul, hu, hv]
    ring
  obtain ⟨c, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1
    (TauCeti.isSMulRegular_quotSMulTop_iff.1 (h.isSMulRegular_quotSMulTop_pow n j) u v huv)
  -- Then `aⁿ z = aⁿ c`, and `aⁿ` is a unit of `K`.
  refine ⟨c, (IsLocalization.map_units K (⟨a ^ n, ?_⟩ : nonZeroDivisors R)).mul_left_cancel ?_⟩
  · exact ((Commute.isRegular_iff fun _ ↦ Commute.all _ _).2 han).mem_nonZeroDivisors
  · simpa [smul_eq_mul] using hu

end FractionRing

section Localization

variable {R : Type u} [CommRing R] {Ra Rb Rab : Type*} [CommRing Ra] [CommRing Rb] [CommRing Rab]
  [Algebra R Ra] [Algebra R Rb] [Algebra R Rab]

/-- **Gluing across a weakly regular sequence.** If `a, b` is a weakly `R`-regular sequence, an
element of `R_a` and an element of `R_b` with the same image in `R_{ab}` come from a unique element
of `R`. Here `R_a`, `R_b` and `R_{ab}` are any localizations of `R` away from `a`, `b` and `ab`.
This is the elementwise form of the algebraic Hartogs principle for the open subset
`D(a) ∪ D(b)` of `Spec R`, and its proof adapts the argument of
`TauCeti.AlgebraicGeometry.StructureSheaf.toOpenₗ_bijective_of_isWeaklyRegular`. -/
theorem RingTheory.Sequence.IsWeaklyRegular.existsUnique_algebraMap_eq {a b : R}
    [IsLocalization.Away a Ra] [IsLocalization.Away b Rb] [IsLocalization.Away (a * b) Rab]
    (h : IsWeaklyRegular R [a, b]) (x : Ra) (y : Rb)
    (hxy : IsLocalization.Away.awayToAwayRight a b (P := Rab) x =
      IsLocalization.Away.awayToAwayLeft b a y) :
    ∃! r : R, algebraMap R Ra r = x ∧ algebraMap R Rb r = y := by
  have ha : IsSMulRegular R a := ((isWeaklyRegular_cons_iff R a [b]).1 h).1
  refine existsUnique_of_exists_of_unique ?_ fun r s hr hs ↦ ?_
  · -- Write `x = r₁ / aⁿ` and `y = r₂ / bᵐ`.
    obtain ⟨n, r₁, hx⟩ := IsLocalization.Away.surj a x
    obtain ⟨m, r₂, hy⟩ := IsLocalization.Away.surj b y
    -- In `R_{ab}`, `bᵐ r₁ = aⁿ r₂`, so `(ab)ᵏ bᵐ r₁ = (ab)ᵏ aⁿ r₂` in `R` for some `k`.
    have hab : algebraMap R Rab (b ^ m * r₁) = algebraMap R Rab (a ^ n * r₂) := by
      have hx' := congrArg (IsLocalization.Away.awayToAwayRight a b (P := Rab)) hx
      have hy' := congrArg (IsLocalization.Away.awayToAwayLeft b a (P := Rab)) hy
      simp only [map_mul, map_pow, IsLocalization.Away.awayToAwayRight_eq,
        IsLocalization.Away.awayToAwayLeft_eq] at hx' hy'
      rw [map_mul, map_mul, map_pow, map_pow, ← hx', ← hy', hxy]
      ring
    obtain ⟨⟨_, k, rfl⟩, hk⟩ := IsLocalization.exists_of_eq (M := .powers (a * b)) (S := Rab) hab
    -- Cancelling `aᵏ` gives `bᵏ⁺ᵐ r₁ = aⁿ bᵏ r₂`.
    have hk' : a ^ n * (b ^ k * r₂) = b ^ (k + m) * r₁ :=
      (ha.pow k) (by simp only [smul_eq_mul, mul_pow] at hk ⊢; rw [pow_add]; linear_combination -hk)
    -- As `bᵏ⁺ᵐ` is regular modulo `aⁿ`, `r₁ = aⁿ c`.
    obtain ⟨c, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1
      (TauCeti.isSMulRegular_quotSMulTop_iff.1 (h.isSMulRegular_quotSMulTop_pow n (k + m)) r₁
        (b ^ k * r₂) hk')
    refine ⟨c, ?_, ?_⟩
    · -- `x aⁿ = aⁿ c` and `aⁿ` is a unit in `R_a`.
      refine ((IsLocalization.Away.algebraMap_isUnit (S := Ra) a).pow
        n).mul_left_injective ?_
      dsimp only
      rw [hx, smul_eq_mul, map_mul, map_pow, mul_comm]
    · -- Cancelling `aⁿ` gives `bᵏ (bᵐ c) = bᵏ r₂`, and `bᵏ`, `bᵐ` are units in `R_b`.
      rw [smul_eq_mul, pow_add] at hk'
      have hc : b ^ k * (b ^ m * c) = b ^ k * r₂ :=
        (ha.pow n) (by simp only [smul_eq_mul]; linear_combination -hk')
      have hu := IsLocalization.Away.algebraMap_isUnit (S := Rb) b
      refine (hu.pow k).mul_right_injective ((hu.pow m).mul_left_injective ?_)
      have := congrArg (algebraMap R Rb) hc
      simp only [map_mul, map_pow] at this
      dsimp only
      rw [mul_assoc _ y, hy, ← this]
      ring
  · -- `R → R_a` is injective, as `a` is regular.
    exact (IsLocalization.Away.injective_iff_isRegular (S := Ra) a).2
      (isLeftRegular_iff_isRegular.1 ha) (hr.1.trans hs.1.symm)

end Localization

section Relations

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

namespace RingTheory.Sequence.IsWeaklyRegular

/-- The relation statement for a sequence indexed by `Fin n`, by induction on `n`. -/
private theorem mem_smul_top_of_sum_eq_zero_aux :
    ∀ {n : ℕ} {rs : Fin n → R}, IsWeaklyRegular M (List.ofFn rs) → ∀ {m : Fin n → M},
      ∑ i, rs i • m i = 0 → ∀ i, m i ∈ Ideal.span (Set.range rs) • (⊤ : Submodule R M) := by
  intro n
  induction n with
  | zero => exact fun _ _ _ i ↦ i.elim0
  | succ n ih =>
    intro rs h m hm
    rw [List.ofFn_succ', List.concat_eq_append, isWeaklyRegular_append_iff,
      isWeaklyRegular_singleton_iff, Ideal.ofList_ofFn] at h
    obtain ⟨h₁, h₂⟩ := h
    set I' := Ideal.span (Set.range fun i : Fin n ↦ rs i.castSucc)
    rw [Fin.sum_univ_castSucc] at hm
    -- The last element is regular modulo `I' M`, so its coefficient lies in `I' M`.
    have hlast : m (Fin.last n) ∈ I' • (⊤ : Submodule R M) := by
      have : rs (Fin.last n) • m (Fin.last n) ∈ I' • (⊤ : Submodule R M) := by
        rw [eq_neg_of_add_eq_zero_right hm]
        exact neg_mem (sum_mem fun i _ ↦ Submodule.smul_mem_smul (Ideal.subset_span ⟨i, rfl⟩)
          Submodule.mem_top)
      rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_smul] at this
      rw [← Submodule.Quotient.mk_eq_zero]
      exact h₂.right_eq_zero_of_smul this
    -- Writing it as `∑ rsᵢ cᵢ` gives a relation among the first `n` elements.
    obtain ⟨c, hc⟩ := Submodule.mem_span_range_smul_top_iff_exists_fun.mp hlast
    have hrel := ih h₁ (m := fun i ↦ m i.castSucc + rs (Fin.last n) • c i) (by
      simpa [smul_add, Finset.sum_add_distrib, smul_comm (rs _) (rs (Fin.last n)),
        ← Finset.smul_sum, hc] using hm)
    have hle : I' ≤ Ideal.span (Set.range rs) :=
      Ideal.span_mono (Set.range_comp_subset_range Fin.castSucc rs)
    refine Fin.lastCases (Submodule.smul_mono_left hle hlast) fun i ↦ ?_
    simpa using sub_mem (Submodule.smul_mono_left hle (hrel i)) (Submodule.smul_mem_smul
      (Ideal.subset_span ⟨Fin.last n, rfl⟩) (Submodule.mem_top (x := c i)))

/-- **Relations among a weakly regular sequence have coefficients in the ideal it generates.** If
`rs` is weakly regular on `M` and `∑ rsᵢ • mᵢ = 0`, then every `mᵢ` lies in `(rs) M`. -/
theorem mem_ofList_smul_top_of_sum_eq_zero {rs : List R} (h : IsWeaklyRegular M rs)
    {m : Fin rs.length → M} (hm : ∑ i, rs[i] • m i = 0) (i : Fin rs.length) :
    m i ∈ Ideal.ofList rs • (⊤ : Submodule R M) := by
  rw [← List.ofFn_getElem (xs := rs)] at h
  exact Ideal.ofList_eq_span_range_getElem rs ▸ mem_smul_top_of_sum_eq_zero_aux h hm i

/-- The last element of a weakly `R`-regular sequence is a left-regular element of the quotient
ring by the ideal generated by the preceding elements. -/
theorem isLeftRegular_mk_ofList {rs : List R} {r : R} (h : IsWeaklyRegular R (rs ++ [r])) :
    IsLeftRegular (Ideal.Quotient.mk (Ideal.ofList rs) r) := by
  rw [isWeaklyRegular_append_iff, isWeaklyRegular_singleton_iff, Ideal.smul_eq_mul,
    Ideal.mul_top] at h
  intro x y hxy
  exact h.2 (by simpa only [Algebra.smul_def, Ideal.Quotient.algebraMap_eq] using hxy)

end RingTheory.Sequence.IsWeaklyRegular

end Relations

variable {R : Type u} [CommRing R] [IsNoetherianRing R] {M : Type v} [AddCommGroup M] [Module R M]
  [Module.Finite R M]

/-- Over a Noetherian local ring, a finite module of nonzero depth has a regular element in the
maximal ideal. -/
theorem IsLocalRing.exists_isSMulRegular_of_depth_ne_zero [IsLocalRing R] [Small.{v} R]
    (h : depth (ModuleCat.of R M) ≠ 0) : ∃ a ∈ maximalIdeal R, IsSMulRegular M a := by
  refine (maximalIdeal R).exists_mem_isSMulRegular_iff.2 fun p hp hle ↦ h ?_
  rw [depth_eq_zero_iff_maximalIdeal_mem_associatedPrimes,
    (maximalIdeal.isMaximal R).eq_of_le hp.isPrime.ne_top hle]
  exact hp

namespace TauCeti

/-- Let `M` be a finite module over a Noetherian ring and `I` an ideal. If `depth M_p ≥ n` for
every prime `p` containing `I`, then `I` contains a weakly `M`-regular sequence of length `n`. -/
theorem exists_isWeaklyRegular_of_le_depth_localizedModule (I : Ideal R) (n : ℕ)
    (h : ∀ (p : Ideal R) [p.IsPrime], I ≤ p →
      (n : ℕ∞) ≤ depth (ModuleCat.of (Localization.AtPrime p) (LocalizedModule p.primeCompl M))) :
    ∃ rs : List R, rs.length = n ∧ (∀ r ∈ rs, r ∈ I) ∧ IsWeaklyRegular M rs := by
  induction n generalizing M with
  | zero => exact ⟨[], rfl, by simp, IsWeaklyRegular.nil R M⟩
  | succ n ih =>
    -- An associated prime containing `I` would give a localization of depth zero.
    obtain ⟨a, haI, reg⟩ := (I.exists_mem_isSMulRegular_iff (M := M)).2 fun p hp hle ↦ by
      have := hp.isPrime
      have hdepth := h p hle
      rw [depth_localizedModule_eq_zero_iff.2 hp] at hdepth
      exact (Nat.cast_add_one_ne_zero n) (nonpos_iff_eq_zero.1 hdepth)
    -- Dividing by `a` lowers the depth of each localization at a prime `p ⊇ I` by exactly one.
    obtain ⟨rs, hlen, hmem, hrs⟩ := @ih (QuotSMulTop a M) _ _ _ fun p _ hle ↦ by
      have hdepth := h p hle
      rw [← depth_localizedModule_quotSMulTop_add_one reg p (hle haI), Nat.cast_add_one] at hdepth
      exact (ENat.add_le_add_iff_right ENat.one_ne_top).1 hdepth
    exact ⟨a :: rs, by simp [hlen], List.forall_mem_cons.2 ⟨haI, hmem⟩,
      (isWeaklyRegular_cons_iff M a rs).2 ⟨reg, hrs⟩⟩

end TauCeti
