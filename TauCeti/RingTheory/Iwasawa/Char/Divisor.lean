/-!
# The characteristic divisor of a torsion module

Let `M` be a finitely generated torsion module over a noetherian ring `A`. At a prime `𝔭` of
height one the localization `M_𝔭` has finite length over `A_𝔭`, and it vanishes for all but
finitely many such `𝔭`. The *characteristic divisor* of `M` is the finitely supported function

  `div_A(M) = Σ_𝔭 length_{A_𝔭}(M_𝔭) [𝔭]`,

the sum running over the primes of height one. Over a noetherian unique factorization domain each
height-one prime is principal, `𝔭 = (π_𝔭)`, and the characteristic ideal of `M`
(`TauCeti.Iwasawa.charIdeal`) is the principal ideal `(∏ π_𝔭 ^ length_{A_𝔭}(M_𝔭))` read off
`div_A(M)`; over the Iwasawa algebra `Λ = O⟦T⟧` it is
the ideal `(ϖ ^ μ F_M)` generated by a uniformizer power and the characteristic polynomial of `M`.

The divisor only sees localizations at height-one primes, so it is blind to pseudo-null modules:
it is additive in short exact sequences, invariant under pseudo-isomorphism, and vanishes exactly
on the pseudo-null modules.

## Main definitions

* `TauCeti.Iwasawa.charDivisor A M`: the characteristic divisor of `M`, a finitely supported
  function on the prime spectrum of `A`. It is zero at primes whose height is not one, and is
  meaningful when `M` is finitely generated and torsion and `A` is noetherian.

## Main results

* `TauCeti.Iwasawa.coe_charDivisor_apply`: at a prime `𝔭` of height one, `div_A(M)(𝔭)` is the
  finite length of `M_𝔭` over `A_𝔭`.
* `TauCeti.Iwasawa.mem_support_charDivisor`: the support of `div_A(M)` consists of the primes of
  height one in the support of `M`.
* `TauCeti.Iwasawa.charDivisor_eq_add_of_exact`: `div_A` is additive in short exact sequences.
* `TauCeti.Iwasawa.IsPseudoIsomorphism.charDivisor_eq`: `div_A` is invariant under
  pseudo-isomorphism, and in particular under linear equivalence (`LinearEquiv.charDivisor_eq`).
* `TauCeti.Iwasawa.charDivisor_eq_zero_iff`: `div_A(M) = 0` iff `M` is pseudo-null.
* `TauCeti.Iwasawa.charDivisor_quotient_of_height_eq_one`: for a prime `𝔭` of height one,
  `div_A(A ⧸ 𝔭) = [𝔭]`.
* `TauCeti.Iwasawa.charDivisor_prod`: `div_A` is additive on products.
* `TauCeti.Iwasawa.charDivisor_torsion_prod`, `TauCeti.Iwasawa.charDivisor_torsion_pi`: the
  divisor of the torsion submodule is additive on finite products of finitely generated modules.
* `TauCeti.Iwasawa.charDivisor_quotient_span_singleton_pow`: for a prime element `π` of a
  noetherian domain, `div_A(A ⧸ (π ^ m)) = m [(π)]`.
* `LinearEquiv.charDivisor_apply_comap`: along a ring isomorphism `σ : A → B`, a `σ`-semilinear
  equivalence `N ≃ M` gives `div_A(N)(σ⁻¹ 𝔮) = div_B(M)(𝔮)` at every prime `𝔮` of `B`.

The examples at the end of the file are over `Λ = ℤ_p⟦T⟧`: the nonzero module `Λ ⧸ (p, T) = 𝔽_p`
has characteristic divisor zero, while that of `Λ ⧸ (p)` is positive at the height-one prime `(p)`.

## References

* J. Rodrigues Jacinto and C. Williams, *An introduction to p-adic L-functions*, Definition 13.3.
* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, (5.1.8) and (5.3.9).
-/

public section

universe u

namespace TauCeti.Iwasawa

variable (A : Type*) [CommRing A] (M : Type*) [AddCommGroup M] [Module A M]

/-- The length of `M_𝔭` over `A_𝔭` at a prime of height one, read in `ℕ`, and zero at other
primes. -/
private noncomputable def localLength (𝔭 : PrimeSpectrum A) : ℕ :=
  if 𝔭.asIdeal.height = 1 then
    (Module.length (Localization.AtPrime 𝔭.asIdeal) (LocalizedModule 𝔭.asIdeal.primeCompl M)).toNat
  else 0

/-- The *characteristic divisor* `div_A(M) = Σ_𝔭 length_{A_𝔭}(M_𝔭) [𝔭]` of a module `M` over a
commutative ring `A`, the sum running over the primes `𝔭` of height one. It is meaningful when `A`
is noetherian and `M` is finitely generated and torsion: then each `M_𝔭` has finite length, which
is the value at `𝔭` (`coe_charDivisor_apply`), and only finitely many of them are nonzero. -/
noncomputable def charDivisor : PrimeSpectrum A →₀ ℕ :=
  open Classical in
  if h : (Function.support (localLength A M)).Finite then Finsupp.ofSupportFinite _ h else 0

variable {A M}

private theorem localLength_ne_zero {𝔭 : PrimeSpectrum A} (h : localLength A M 𝔭 ≠ 0) :
    𝔭 ∈ Module.support A M ∧ 𝔭.asIdeal.height = 1 := by
  by_cases hht : 𝔭.asIdeal.height = 1
  · refine ⟨?_, hht⟩
    by_contra hmem
    have := Module.notMem_support_iff.mp hmem
    simp [localLength, hht, Module.length_eq_zero] at h
  · simp [localLength, hht] at h

private theorem finite_support_localLength [IsNoetherianRing A] [Module.Finite A M]
    (hM : Module.IsTorsion A M) : (Function.support (localLength A M)).Finite :=
  hM.finite_setOf_mem_support_height_le_one.subset fun _ h𝔭 ↦
    have h := localLength_ne_zero h𝔭
    ⟨h.1, h.2.le⟩

private theorem charDivisor_apply_eq_localLength [IsNoetherianRing A] [Module.Finite A M]
    (hM : Module.IsTorsion A M) (𝔭 : PrimeSpectrum A) :
    charDivisor A M 𝔭 = localLength A M 𝔭 := by
  rw [charDivisor, dite_eq_left (finite_support_localLength hM), Finsupp.ofSupportFinite_coe]

/-- If the local lengths are the values of a finitely supported function `d`, then the
characteristic divisor is `d`. -/
private theorem charDivisor_eq_of_localLength_eq {d : PrimeSpectrum A →₀ ℕ}
    (h : localLength A M = d) : charDivisor A M = d := by
  rw [charDivisor, dite_eq_left (by rw [h, Finsupp.fun_support_eq]; exact Finset.finite_toSet _)]
  ext 𝔭
  simp [Finsupp.ofSupportFinite_coe, h]

/-- The characteristic divisor vanishes at primes whose height is not one. -/
@[simp]
theorem charDivisor_apply_of_height_ne_one {𝔭 : PrimeSpectrum A} (h : 𝔭.asIdeal.height ≠ 1) :
    charDivisor A M 𝔭 = 0 := by
  unfold charDivisor
  split_ifs <;> simp [Finsupp.ofSupportFinite_coe, localLength, h]

/-- The characteristic divisor vanishes at primes outside the support of the module. -/
theorem charDivisor_apply_eq_zero_of_notMem_support {𝔭 : PrimeSpectrum A}
    (h : 𝔭 ∉ Module.support A M) : charDivisor A M 𝔭 = 0 := by
  unfold charDivisor
  split_ifs
  · rw [Finsupp.ofSupportFinite_coe]
    by_contra hne
    exact h (localLength_ne_zero hne).1
  · rfl

/-- At a prime `𝔭` of height one, the characteristic divisor of a finitely generated torsion module
`M` over a noetherian ring is the length of `M_𝔭` over `A_𝔭`, which is finite. -/
theorem coe_charDivisor_apply [IsNoetherianRing A] [Module.Finite A M] (hM : Module.IsTorsion A M)
    {𝔭 : PrimeSpectrum A} (h : 𝔭.asIdeal.height = 1) :
    (charDivisor A M 𝔭 : ℕ∞) =
      Module.length (Localization.AtPrime 𝔭.asIdeal) (LocalizedModule 𝔭.asIdeal.primeCompl M) := by
  rw [charDivisor_apply_eq_localLength hM, localLength, ite_eq_left h, ENat.natCast_toNat]
  exact Module.length_ne_top_iff.mpr (hM.isFiniteLength_localizedModule h.le)

/-- The support of the characteristic divisor of a finitely generated torsion module over a
noetherian ring consists exactly of the primes of height one in the support of the module. -/
theorem mem_support_charDivisor [IsNoetherianRing A] [Module.Finite A M]
    (hM : Module.IsTorsion A M) {𝔭 : PrimeSpectrum A} :
    𝔭 ∈ (charDivisor A M).support ↔ 𝔭 ∈ Module.support A M ∧ 𝔭.asIdeal.height = 1 := by
  rw [Finsupp.mem_support_iff, charDivisor_apply_eq_localLength hM]
  refine ⟨localLength_ne_zero, fun ⟨hmem, hht⟩ ↦ ?_⟩
  rw [ne_eq, ← Nat.cast_inj (R := ℕ∞), ← charDivisor_apply_eq_localLength hM,
    coe_charDivisor_apply hM hht, Nat.cast_zero, Module.length_eq_zero_iff,
    not_subsingleton_iff_nontrivial]
  exact Module.mem_support_iff.mp hmem

/-- The characteristic divisor of a pseudo-null module is zero. -/
@[simp]
theorem IsPseudoNull.charDivisor_eq_zero (h : IsPseudoNull A M) : charDivisor A M = 0 := by
  have hloc : localLength A M = 0 := by
    ext 𝔭
    by_cases hht : 𝔭.asIdeal.height = 1
    · have := h.subsingleton_localizedModule 𝔭 hht.le
      simp [localLength, hht, Module.length_eq_zero]
    · simp [localLength, hht]
  exact charDivisor_eq_of_localLength_eq (by rw [hloc, Finsupp.coe_zero])

/-- The characteristic divisor of the zero module is zero. -/
@[simp]
theorem charDivisor_of_subsingleton [Subsingleton M] : charDivisor A M = 0 :=
  IsPseudoNull.of_subsingleton.charDivisor_eq_zero

/-- A finitely generated torsion module over a noetherian ring has characteristic divisor zero iff
it is pseudo-null. -/
theorem charDivisor_eq_zero_iff [IsNoetherianRing A] [Module.Finite A M]
    (hM : Module.IsTorsion A M) : charDivisor A M = 0 ↔ IsPseudoNull A M := by
  refine ⟨fun h ↦ isPseudoNull_iff_support.mpr ⟨inferInstance, fun 𝔭 hmem ↦ ?_⟩,
    IsPseudoNull.charDivisor_eq_zero⟩
  -- The support of a torsion module contains no prime of height zero, and by hypothesis none of
  -- height one.
  refine lt_of_not_ge fun hle ↦ ?_
  rcases hle.lt_or_eq with hlt | hht
  · exact hM.notMem_support_of_mem_minimalPrimes
      (Ideal.height_eq_zero_iff.mp (Order.lt_one_iff.mp hlt)) hmem
  · have := (mem_support_charDivisor hM).mpr ⟨hmem, hht⟩
    simp [h] at this

variable {N P : Type*} [AddCommGroup N] [Module A N] [AddCommGroup P] [Module A P]

/-- The characteristic divisor is invariant under pseudo-isomorphism. -/
theorem IsPseudoIsomorphism.charDivisor_eq {f : M →ₗ[A] N} (hf : IsPseudoIsomorphism f) :
    charDivisor A M = charDivisor A N := by
  have hloc : localLength A M = localLength A N := by
    ext 𝔭
    by_cases hht : 𝔭.asIdeal.height = 1
    · simp only [localLength, ite_eq_left hht,
        (LinearEquiv.ofBijective _ (hf.bijective_localizedModule_map 𝔭 hht.le)).length_eq]
    · simp [localLength, hht]
  rw [charDivisor, charDivisor, hloc]

/-- **Additivity of the characteristic divisor.** In a short exact sequence `0 → M → N → P → 0` of
finitely generated torsion modules over a noetherian ring, `div_A(N) = div_A(M) + div_A(P)`. -/
theorem charDivisor_eq_add_of_exact [IsNoetherianRing A] [Module.Finite A N]
    (hN : Module.IsTorsion A N) {f : M →ₗ[A] N} {g : N →ₗ[A] P} (hfg : Function.Exact f g)
    (hf : Function.Injective f) (hg : Function.Surjective g) :
    charDivisor A N = charDivisor A M + charDivisor A P := by
  have : Module.Finite A M := .of_injective f hf
  have : Module.Finite A P := .of_surjective g hg
  have hM : Module.IsTorsion A M := fun m ↦ by
    obtain ⟨a, ha⟩ := @hN (f m)
    exact ⟨a, hf (by rw [Submonoid.smul_def, map_smul, ← Submonoid.smul_def, ha, map_zero])⟩
  have hP : Module.IsTorsion A P := fun x ↦ by
    obtain ⟨n, rfl⟩ := hg x
    obtain ⟨a, ha⟩ := @hN n
    exact ⟨a, by rw [Submonoid.smul_def, ← map_smul, ← Submonoid.smul_def, ha, map_zero]⟩
  ext 𝔭
  by_cases hht : 𝔭.asIdeal.height = 1
  · rw [Finsupp.add_apply, ← Nat.cast_inj (R := ℕ∞), Nat.cast_add, coe_charDivisor_apply hN hht,
      coe_charDivisor_apply hM hht, coe_charDivisor_apply hP hht]
    -- Localization at `𝔭` is exact, and length is additive in exact sequences.
    exact Module.length_eq_add_of_exact (LocalizedModule.map 𝔭.asIdeal.primeCompl f)
      (LocalizedModule.map 𝔭.asIdeal.primeCompl g)
      (LocalizedModule.map_injective _ f hf) (LocalizedModule.map_surjective _ g hg)
      (LocalizedModule.map_exact _ f g hfg)
  · simp [charDivisor_apply_of_height_ne_one hht]

/-- **The divisor of a prime of height one.** For a prime `𝔭` of height one in a commutative ring,
the characteristic divisor of `A ⧸ 𝔭` is the prime divisor `[𝔭]`: the only height-one prime
containing `𝔭` is `𝔭` itself, and `(A ⧸ 𝔭)_𝔭` is the residue field of `A_𝔭`, of length one. -/
@[simp]
theorem charDivisor_quotient_of_height_eq_one {𝔭 : Ideal A} [𝔭.IsPrime] (h : 𝔭.height = 1) :
    charDivisor A (A ⧸ 𝔭) = Finsupp.single ⟨𝔭, inferInstance⟩ 1 := by
  have hloc : localLength A (A ⧸ 𝔭) = Finsupp.single ⟨𝔭, inferInstance⟩ 1 := by
    ext 𝔮
    by_cases h𝔮 : 𝔮 = ⟨𝔭, inferInstance⟩
    · subst h𝔮
      simp [localLength, h]
    · rw [Finsupp.single_eq_of_ne h𝔮]
      by_contra hne
      obtain ⟨hsupp, hht⟩ := localLength_ne_zero hne
      rw [Module.mem_support_iff_of_finite, Ideal.annihilator_quotient] at hsupp
      have : 𝔭.FiniteHeight := by simp [𝔭.finiteHeight_iff, h]
      exact h𝔮 (PrimeSpectrum.ext (𝔭.eq_of_le_of_height_le hsupp (hht.trans h.symm).le).symm)
  exact charDivisor_eq_of_localLength_eq hloc

/-- If the local lengths of `M` and `M'` correspond along a bijection of the prime spectra, then
so do their characteristic divisors. -/
private theorem charDivisor_apply_eq_of_localLength_eq {A' M' : Type*} [CommRing A']
    [AddCommGroup M'] [Module A' M'] (E : PrimeSpectrum A' ≃ PrimeSpectrum A)
    (h : ∀ 𝔮, localLength A M (E 𝔮) = localLength A' M' 𝔮) (𝔮 : PrimeSpectrum A') :
    charDivisor A M (E 𝔮) = charDivisor A' M' 𝔮 := by
  have hfin : (Function.support (localLength A M)).Finite ↔
      (Function.support (localLength A' M')).Finite := by
    have hsupp : Function.support (localLength A M) =
        E '' Function.support (localLength A' M') := by
      ext 𝔭
      obtain ⟨𝔮, rfl⟩ := E.surjective 𝔭
      simp [h]
    rw [hsupp, Set.finite_image_iff E.injective.injOn]
  unfold charDivisor
  split_ifs <;> simp_all [Finsupp.ofSupportFinite_coe]

end TauCeti.Iwasawa

/-- The characteristic divisor is invariant under linear equivalence. -/
theorem LinearEquiv.charDivisor_eq {A M N : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] (e : M ≃ₗ[A] N) :
    TauCeti.Iwasawa.charDivisor A M = TauCeti.Iwasawa.charDivisor A N :=
  (TauCeti.Iwasawa.IsPseudoIsomorphism.of_bijective e.bijective).charDivisor_eq

/-- **Transport of the characteristic divisor along a ring isomorphism.** Let `σ : A → B` be a ring
isomorphism and `e : N ≃ M` a `σ`-semilinear equivalence from an `A`-module to a `B`-module. Then
the characteristic divisor of `N` at the prime `σ⁻¹ 𝔮` is that of `M` at `𝔮`: the prime `σ⁻¹ 𝔮`
has the same height as `𝔮`, and the localizations `N_{σ⁻¹ 𝔮}` and `M_𝔮` have the same length. -/
theorem LinearEquiv.charDivisor_apply_comap {A B N M : Type*} [CommRing A] [CommRing B]
    [AddCommGroup N] [Module A N] [AddCommGroup M] [Module B M] {σ : A →+* B} {σ' : B →+* A}
    [RingHomInvPair σ σ'] [RingHomInvPair σ' σ] (e : N ≃ₛₗ[σ] M) (𝔮 : PrimeSpectrum B) :
    TauCeti.Iwasawa.charDivisor A N (PrimeSpectrum.comap σ 𝔮) =
      TauCeti.Iwasawa.charDivisor B M 𝔮 := by
  let σe := RingHomInvPair.toRingEquiv σ σ'
  let E := (PrimeSpectrum.comapEquiv σe).symm.toEquiv
  have hE (𝔮 : PrimeSpectrum B) : E 𝔮 = PrimeSpectrum.comap σ 𝔮 := by
    ext x
    simp [E, σe, PrimeSpectrum.comapEquiv_apply]
  rw [← hE]
  refine TauCeti.Iwasawa.charDivisor_apply_eq_of_localLength_eq E (fun 𝔮 ↦ ?_) 𝔮
  have hht : (𝔮.asIdeal.comap σ).height = 𝔮.asIdeal.height := σe.height_comap _
  simp only [TauCeti.Iwasawa.localLength, hE, PrimeSpectrum.comap_asIdeal, hht]
  split_ifs
  · exact congrArg ENat.toNat (e.length_localizedModule_comap 𝔮.asIdeal)
  · rfl

namespace TauCeti.Iwasawa

variable {A : Type*} [CommRing A] {M N : Type*} [AddCommGroup M] [Module A M] [AddCommGroup N]
  [Module A N]

/-- The characteristic divisor of a product of two finitely generated torsion modules over a
noetherian ring is the sum of their characteristic divisors. -/
theorem charDivisor_prod [IsNoetherianRing A] [Module.Finite A M] [Module.Finite A N]
    (hM : Module.IsTorsion A M) (hN : Module.IsTorsion A N) :
    charDivisor A (M × N) = charDivisor A M + charDivisor A N :=
  charDivisor_eq_add_of_exact (hM.prod hN) .inl_snd LinearMap.inl_injective
    LinearMap.snd_surjective

/-- The characteristic divisor of the torsion submodule is invariant under linear equivalence. -/
theorem _root_.LinearEquiv.charDivisor_torsion_eq (e : M ≃ₗ[A] N) :
    charDivisor A (Submodule.torsion A M) = charDivisor A (Submodule.torsion A N) := by
  have h : (Submodule.torsion A M).map (e : M →ₗ[A] N) = Submodule.torsion A N :=
    le_antisymm (Submodule.map_le_iff_le_comap.mpr e.toLinearMap.le_comap_torsion) fun x hx ↦
      ⟨e.symm x, e.symm.toLinearMap.le_comap_torsion hx, e.apply_symm_apply x⟩
  exact (e.ofSubmodules _ _ h).charDivisor_eq

/-- The characteristic divisor of the torsion submodule of a product of two finitely generated
modules over a noetherian ring is the sum of those of the torsion submodules of the factors. -/
theorem charDivisor_torsion_prod [IsNoetherianRing A] [Module.Finite A M] [Module.Finite A N] :
    charDivisor A (Submodule.torsion A (M × N)) =
      charDivisor A (Submodule.torsion A M) + charDivisor A (Submodule.torsion A N) := by
  rw [(Submodule.torsionProdEquiv A M N).charDivisor_eq,
    charDivisor_prod Submodule.torsion_isTorsion Submodule.torsion_isTorsion]

/-- The characteristic divisor of the torsion submodule of a finite product of finitely generated
modules over a noetherian ring is the sum of those of the torsion submodules of the factors. -/
theorem charDivisor_torsion_pi [IsNoetherianRing A] {ι : Type*} [Fintype ι] (M : ι → Type u)
    [∀ i, AddCommGroup (M i)] [∀ i, Module A (M i)] [∀ i, Module.Finite A (M i)] :
    charDivisor A (Submodule.torsion A (∀ i, M i)) =
      ∑ i, charDivisor A (Submodule.torsion A (M i)) := by
  -- Reduce to `ι = Fin k`, then split off one factor at a time.
  suffices h : ∀ (k : ℕ) (M : Fin k → Type u) [∀ i, AddCommGroup (M i)] [∀ i, Module A (M i)]
      [∀ i, Module.Finite A (M i)], charDivisor A (Submodule.torsion A (∀ i, M i)) =
        ∑ i, charDivisor A (Submodule.torsion A (M i)) by
    let e := (Fintype.equivFin ι).symm
    rw [← (LinearEquiv.piCongrLeft A M e).charDivisor_torsion_eq, h]
    exact e.sum_comp fun i ↦ charDivisor A (Submodule.torsion A (M i))
  intro k
  induction k with
  | zero => intro M _ _ _; simp
  | succ k ih =>
    intro M _ _ _
    rw [← (Fin.consLinearEquiv A M).charDivisor_torsion_eq, charDivisor_torsion_prod, ih,
      Fin.sum_univ_succ]

open scoped Pointwise in
/-- For non-zero-divisors `a` and `b` of a noetherian ring, the characteristic divisor of
`A ⧸ (a b)` is the sum of those of `A ⧸ (a)` and `A ⧸ (b)`. -/
theorem charDivisor_quotient_span_singleton_mul [IsNoetherianRing A] {a b : A}
    (ha : a ∈ nonZeroDivisors A) (hb : b ∈ nonZeroDivisors A) :
    charDivisor A (A ⧸ Ideal.span {a * b}) =
      charDivisor A (A ⧸ Ideal.span {a}) + charDivisor A (A ⧸ Ideal.span {b}) := by
  -- Multiplication by `a` gives the exact sequence `0 → A ⧸ (b) → A ⧸ (a b) → A ⧸ (a) → 0`.
  have hab : a • Ideal.span {b} = Ideal.span {a * b} := by
    rw [← Submodule.ideal_span_singleton_smul, smul_eq_mul,
      Ideal.span_singleton_mul_span_singleton]
  have hN : Module.IsTorsion A (A ⧸ a • Ideal.span {b}) :=
    Ideal.isTorsion_quotient_of_mem
      (Submodule.smul_mem_pointwise_smul _ _ _ (Ideal.mem_span_singleton_self b))
      (mul_mem ha hb)
  rw [← (Submodule.quotEquivOfEq _ _ hab).charDivisor_eq,
    charDivisor_eq_add_of_exact hN (Ideal.exact_mulQuot_quotOfMul _)
      (Ideal.mulQuot_injective _ ha) (Ideal.quotOfMul_surjective _), add_comm]

/-- **The divisor of a prime power.** For a prime element `π` of a noetherian domain, the
characteristic divisor of `A ⧸ (π ^ m)` is `m [(π)]`. -/
theorem charDivisor_quotient_span_singleton_pow [IsDomain A] [IsNoetherianRing A] {π : A}
    (hπ : Prime π) (m : ℕ) :
    charDivisor A (A ⧸ Ideal.span {π ^ m}) =
      m • Finsupp.single ⟨Ideal.span {π}, (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ⟩ 1 := by
  have hπ₀ : π ∈ nonZeroDivisors A := mem_nonZeroDivisors_of_ne_zero hπ.ne_zero
  have := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  induction m with
  | zero =>
    have : Subsingleton (A ⧸ Ideal.span {π ^ 0}) := by
      rw [pow_zero, Ideal.span_singleton_one]
      infer_instance
    simp
  | succ m ih =>
    rw [pow_succ', charDivisor_quotient_span_singleton_mul hπ₀ (pow_mem hπ₀ m), ih,
      charDivisor_quotient_of_height_eq_one
        (Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors hπ₀ hπ.not_isUnit),
      succ_nsmul']

open PowerSeries in
-- Over `Λ = ℤ_p⟦T⟧`, the nonzero module `Λ ⧸ (p, T) = 𝔽_p` is pseudo-null, so its characteristic
-- divisor is zero, while `Λ ⧸ (p)` is torsion and its support contains the height-one prime `(p)`,
-- where its characteristic divisor is positive.
example (p : ℕ) [Fact p.Prime] :
    charDivisor ℤ_[p]⟦X⟧ (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p]), X}) = 0 ∧
      0 < charDivisor ℤ_[p]⟦X⟧ (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p])})
        ⟨_, PadicInt.isPrime_span_C_p⟩ := by
  refine ⟨IsPseudoNull.charDivisor_eq_zero ((isPseudoNull_quotient_iff _).mpr fun 𝔮 h𝔮 ↦
    PadicInt.one_lt_height_of_C_p_mem_of_X_mem (h𝔮 (Ideal.subset_span (by simp)))
      (h𝔮 (Ideal.subset_span (by simp)))), Nat.pos_of_ne_zero ?_⟩
  have hp : C (p : ℤ_[p]) ∈ nonZeroDivisors ℤ_[p]⟦X⟧ :=
    mem_nonZeroDivisors_of_ne_zero
      ((map_ne_zero_iff _ C_injective).mpr (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero))
  have hM : Module.IsTorsion ℤ_[p]⟦X⟧ (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p])}) :=
    Ideal.isTorsion_quotient_of_mem (Ideal.mem_span_singleton_self _) hp
  refine Finsupp.mem_support_iff.mp
    ((mem_support_charDivisor hM).mpr ⟨?_, PadicInt.height_span_C_p⟩)
  rw [Module.mem_support_iff_of_finite, Ideal.annihilator_quotient]

end TauCeti.Iwasawa

