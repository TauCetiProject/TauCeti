/-!
# The cyclotomic delta submodule

For a module `M` over `O⟦X⟧`, its delta submodule is the increasing union of the kernels of
`ωₙ = (1 + X) ^ (p ^ n) - 1`. Linear maps preserve this submodule, and injective maps reflect it.

On a noetherian module the union stabilizes at a single kernel. If `O` is noetherian and
`I`-adically complete for an ideal `I` containing the prime `p`, this makes the delta submodule of
a finite `O⟦X⟧`-module finite over `O`: it is a finite module over the quotient by a distinguished
polynomial `ωₙ`. This is the finiteness input for separating cyclotomic factors in growth formulas.
No torsion, characteristic-zero, discrete-valuation or finite-residue-field hypothesis is needed
for this step. The delta submodule is not the whole cyclotomic-primary part: higher powers of a
cyclotomic factor need not be killed by any `ωₙ`.

On elementary blocks, the delta submodule vanishes on vertical blocks `O⟦X⟧ ⧸ (ϖ ^ m)`
(`deltaSubmodule_quotient_span_C_pow_eq_bot`) and on horizontal blocks `O⟦X⟧ ⧸ (F ^ n)` when `F`
divides no shifted prime-power cyclotomic polynomial
(`deltaSubmodule_quotient_span_pow_eq_bot_of_not_dvd`), while when `F` divides some
`Φ_{p ^ j}(X + 1)` the `ωₖ`-torsion stabilizes for `k ≥ j` at the cyclic submodule generated by
`F ^ (n - 1)` (`deltaSubmodule_quotient_span_pow_of_dvd`). Over a local noetherian ring `O` with
finite residue field and `dim O⟦X⟧ = 2`, pseudo-isomorphisms preserve the finiteness of `r • M_δ`
for every scalar `r` (`IsPseudoIsomorphism.finite_smul_deltaSubmodule_iff`).

## References

J. Neukirch, A. Schmidt and K. Wingberg, *Cohomology of Number Fields*, second edition,
§5.3, especially Proposition 5.3.17.
-/

public noncomputable section

open IsLocalRing PowerSeries Submodule
open scoped Pointwise Polynomial PowerSeries

namespace TauCeti.Iwasawa

section Basic

variable (p : ℕ) (O M : Type*) [CommRing O] [AddCommGroup M] [Module O⟦X⟧ M]

/-- The elements killed by some cyclotomic element `(1 + X) ^ (p ^ n) - 1`. -/
def deltaSubmodule : Submodule O⟦X⟧ M :=
  ⨆ n : ℕ, torsionBy O⟦X⟧ M ((1 + X) ^ p ^ n - 1)

/-- The delta submodule is the supremum of the finite-level cyclotomic kernels. -/
theorem deltaSubmodule_def :
    deltaSubmodule p O M = ⨆ n : ℕ, torsionBy O⟦X⟧ M ((1 + X) ^ p ^ n - 1) := (rfl)

/-- A submodule contains the delta submodule exactly when it contains every finite-level kernel. -/
@[simp]
theorem deltaSubmodule_le_iff {N : Submodule O⟦X⟧ M} :
    deltaSubmodule p O M ≤ N ↔ ∀ n : ℕ, torsionBy O⟦X⟧ M ((1 + X) ^ p ^ n - 1) ≤ N := by
  rw [deltaSubmodule_def, iSup_le_iff]

/-- The kernels defining the delta submodule increase with the level. -/
theorem monotone_torsionBy_one_add_X_pow_sub_one :
    Monotone fun n : ℕ ↦ torsionBy O⟦X⟧ M ((1 + X) ^ p ^ n - 1) := by
  intro m n hmn
  exact torsionBy_le_torsionBy_of_dvd _ _
    (dvd_pow_sub_one_of_dvd (pow_dvd_pow p hmn))

/-- Membership in the delta submodule means being killed at a single finite level. -/
@[simp]
theorem mem_deltaSubmodule (x : M) :
    x ∈ deltaSubmodule p O M ↔ ∃ n : ℕ, ((1 + X) ^ p ^ n - 1 : O⟦X⟧) • x = 0 := by
  rw [deltaSubmodule, Submodule.mem_iSup_of_directed _
    (monotone_torsionBy_one_add_X_pow_sub_one p O M).directed_le]
  simp only [mem_torsionBy_iff]

/-- Each finite-level kernel belongs to the delta submodule. -/
theorem torsionBy_le_deltaSubmodule (n : ℕ) :
    torsionBy O⟦X⟧ M ((1 + X) ^ p ^ n - 1) ≤ deltaSubmodule p O M :=
  le_iSup (fun n : ℕ ↦ torsionBy O⟦X⟧ M ((1 + X) ^ p ^ n - 1)) n

/-- On a noetherian module the delta submodule is already one finite-level kernel. -/
theorem exists_deltaSubmodule_eq_torsionBy [IsNoetherian O⟦X⟧ M] :
    ∃ n : ℕ, deltaSubmodule p O M = torsionBy O⟦X⟧ M ((1 + X) ^ p ^ n - 1) := by
  exact (IsNoetherian.noetherian (deltaSubmodule p O M)).stabilizes_of_iSup_eq
    ⟨_, monotone_torsionBy_one_add_X_pow_sub_one p O M⟩ rfl

/-- At all sufficiently deep levels, the cyclotomic kernel equals the delta submodule. -/
theorem eventually_deltaSubmodule_eq_torsionBy [IsNoetherian O⟦X⟧ M] :
    ∀ᶠ n : ℕ in Filter.atTop,
      deltaSubmodule p O M = torsionBy O⟦X⟧ M ((1 + X) ^ p ^ n - 1) := by
  obtain ⟨n, hn⟩ := exists_deltaSubmodule_eq_torsionBy p O M
  refine Filter.eventually_atTop.mpr ⟨n, fun m hm ↦ le_antisymm ?_ ?_⟩
  · rw [hn]
    exact monotone_torsionBy_one_add_X_pow_sub_one p O M hm
  · exact torsionBy_le_deltaSubmodule p O M m

/-- A torsion-free power-series module has zero delta submodule. -/
@[simp]
theorem deltaSubmodule_eq_bot [NeZero p] [IsDomain O] [Module.IsTorsionFree O⟦X⟧ M] :
    deltaSubmodule p O M = ⊥ := by
  apply eq_bot_iff.mpr
  intro x hx
  obtain ⟨n, hn⟩ := (mem_deltaSubmodule p O M x).mp hx
  have hne : ((1 + X) ^ p ^ n - 1 : O⟦X⟧) ≠ 0 := by
    have h := (TauCeti.Polynomial.monic_one_add_X_pow_sub_one
      (R := O) (pow_ne_zero n (NeZero.ne p))).ne_zero
    simpa using (Polynomial.coe_injective O).ne h
  exact (smul_eq_zero_iff_right hne).mp hn

/-- Over a complete noetherian coefficient ring, the delta submodule of a finite power-series
module is finite over the coefficients, whenever `p` is prime and lies in the completeness ideal. -/
theorem finite_deltaSubmodule [Fact p.Prime] [IsNoetherianRing O]
    [Module O M] [IsScalarTower O O⟦X⟧ M] [Module.Finite O⟦X⟧ M]
    {I : Ideal O} [IsAdicComplete I O] (hp : (p : O) ∈ I) :
    Module.Finite O (deltaSubmodule p O M) := by
  obtain ⟨n, hn⟩ := exists_deltaSubmodule_eq_torsionBy p O M
  have hkill : Module.IsTorsionBy O⟦X⟧ (deltaSubmodule p O M)
      ((1 + X) ^ p ^ n - 1) := by
    intro x
    apply Subtype.ext
    exact (mem_torsionBy_iff _ _).mp (hn ▸ x.property)
  have hF := (TauCeti.Polynomial.isDistinguishedAt_one_add_X_pow_sub_one
    (Fact.out : p.Prime) hp n).isWeierstrassFactorizationAt
  apply hF.finite_of_isTorsionBy
  simpa using hkill

/-- The delta submodule of a binary product is the product of the delta submodules. -/
@[simp]
theorem deltaSubmodule_prod (N : Type*) [AddCommGroup N] [Module O⟦X⟧ N] :
    deltaSubmodule p O (M × N) = (deltaSubmodule p O M).prod (deltaSubmodule p O N) := by
  ext ⟨x, y⟩
  simp only [mem_deltaSubmodule, Submodule.mem_prod, Prod.smul_mk, Prod.mk_eq_zero]
  refine ⟨fun ⟨n, hx, hy⟩ ↦ ⟨⟨n, hx⟩, ⟨n, hy⟩⟩, fun ⟨⟨m, hm⟩, ⟨n, hn⟩⟩ ↦ ⟨max m n, ?_, ?_⟩⟩
  · exact (mem_torsionBy_iff _ _).mp
      (monotone_torsionBy_one_add_X_pow_sub_one p O M (le_max_left m n) hm)
  · exact (mem_torsionBy_iff _ _).mp
      (monotone_torsionBy_one_add_X_pow_sub_one p O N (le_max_right m n) hn)

/-- The delta submodule of a finite product of modules is the product of their delta submodules. -/
@[simp]
theorem deltaSubmodule_pi {ι : Type*} [Finite ι] (F : ι → Type*) [∀ i, AddCommGroup (F i)]
    [∀ i, Module O⟦X⟧ (F i)] :
    deltaSubmodule p O (∀ i, F i) = Submodule.pi Set.univ fun i ↦ deltaSubmodule p O (F i) := by
  classical
  have := Fintype.ofFinite ι
  ext f
  simp only [mem_deltaSubmodule, Submodule.mem_pi, Set.mem_univ, forall_true_left, funext_iff,
    Pi.smul_apply, Pi.zero_apply]
  refine ⟨fun ⟨n, hn⟩ i ↦ ⟨n, hn i⟩, fun hf ↦ ?_⟩
  choose n hn using hf
  refine ⟨Finset.univ.sup n, fun i ↦ ?_⟩
  exact (mem_torsionBy_iff _ _).mp
    (monotone_torsionBy_one_add_X_pow_sub_one p O (F i)
      (Finset.le_sup (f := n) (Finset.mem_univ i)) (hn i))

end Basic

section Blocks

/-- Over a domain with prime `ϖ`, a vertical block `O⟦X⟧ ⧸ (ϖ ^ m)` has trivial delta submodule
whenever `p ≠ 0`. -/
theorem deltaSubmodule_quotient_span_C_pow_eq_bot {O : Type*} [CommRing O] [IsDomain O]
    {ϖ : O} (hϖ : Prime ϖ) {p : ℕ} (hp : p ≠ 0) (m : ℕ) :
    deltaSubmodule p O (O⟦X⟧ ⧸ Ideal.span {C (ϖ ^ m)}) = ⊥ := by
  rw [eq_bot_iff, deltaSubmodule_le_iff]
  intro n
  exact (PowerSeries.torsionBy_quotient_span_C_pow_one_add_X_pow_sub_one_eq_bot
    hϖ (pow_ne_zero n hp) m).le

/-- For a prime `p` with `(p : O) ≠ 0` and a prime polynomial `F` distinguished at `I` over an
`I`-adically complete domain `O`, if `F ∣ Φ_{p ^ j}(X + 1)` and `n ≠ 0`, then for every `k ≥ j`
the `ω_k`-torsion of `O⟦X⟧ ⧸ (F ^ n)` is the cyclic submodule generated by `F ^ (n - 1)`. -/
theorem torsionBy_one_add_X_pow_sub_one_quotient_span_pow {O : Type*} [CommRing O]
    [IsDomain O] {I : Ideal O} [IsAdicComplete I O] {p : ℕ} (hp : p.Prime) (hp0 : (p : O) ≠ 0)
    {F : O[X]} (hF : F.IsDistinguishedAt I) (hprime : Prime F) {n : ℕ} (hn : n ≠ 0) {j k : ℕ}
    (hj : F ∣ (Polynomial.cyclotomic (p ^ j) O).comp (Polynomial.X + 1)) (hk : j ≤ k) :
    torsionBy O⟦X⟧ (O⟦X⟧ ⧸ Ideal.span {((F ^ n : O[X]) : O⟦X⟧)}) ((1 + X) ^ p ^ k - 1) =
      Submodule.span O⟦X⟧
        {Ideal.Quotient.mk (Ideal.span {((F ^ n : O[X]) : O⟦X⟧)}) ((F : O⟦X⟧) ^ (n - 1))} := by
  have : Fact p.Prime := ⟨hp⟩
  have hprimeF' : Prime (F : O⟦X⟧) := hF.prime_coe_iff.mpr hprime
  set ω : O[X] := (1 + Polynomial.X) ^ p ^ k - 1
  have hcoe : (ω : O⟦X⟧) = (1 + X) ^ p ^ k - 1 := by simp [ω]
  have hdvd₁ : F ∣ ω := hj.trans (by
    dsimp only [ω]
    rw [← Polynomial.prod_range_cyclotomic_prime_pow_comp_X_add_one p k]
    exact Finset.dvd_prod_of_mem _ (Finset.mem_range.mpr (Nat.lt_succ_of_le hk)))
  have hndvd₂ : ¬ (F : O⟦X⟧) ^ 2 ∣ (ω : O⟦X⟧) := fun h2 ↦
    hprime.not_isUnit (TauCeti.Polynomial.squarefree_one_add_X_pow_sub_one (m := p ^ k)
      (by simpa using pow_ne_zero k hp0) F
      (sq F ▸ (hF.pow 2).coe_dvd_coe_iff.mp (by simpa only [Polynomial.coe_pow] using h2)))
  obtain ⟨q, hq⟩ := map_dvd Polynomial.coeToPowerSeries.ringHom hdvd₁
  simp only [Polynomial.coeToPowerSeries.ringHom_apply] at hq
  have hq' : ¬ (F : O⟦X⟧) ∣ q := fun ⟨r, hr⟩ ↦ hndvd₂ ⟨r, by rw [hq, hr, sq, mul_assoc]⟩
  have hIJ : Ideal.span {((F ^ n : O[X]) : O⟦X⟧)} ≤ Ideal.span {((F : O⟦X⟧) ^ (n - 1))} := by
    rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton, Polynomial.coe_pow]
    exact pow_dvd_pow _ (Nat.sub_le n 1)
  have hmap :=
    (Ideal.map_span (Ideal.Quotient.mk (Ideal.span {((F ^ n : O[X]) : O⟦X⟧)}))
      {(F : O⟦X⟧) ^ (n - 1)}).trans (by rw [Set.image_singleton])
  ext x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [mem_torsionBy_iff, ← hcoe, ← Ideal.Quotient.mk_eq_mk, ← Submodule.Quotient.mk_smul,
    Submodule.Quotient.mk_eq_zero, smul_eq_mul, Ideal.mem_span_singleton,
    ← Submodule.restrictScalars_span O⟦X⟧ (O⟦X⟧ ⧸ Ideal.span {((F ^ n : O[X]) : O⟦X⟧)})
      Ideal.Quotient.mk_surjective,
    Submodule.restrictScalars_mem, Ideal.Quotient.mk_eq_mk, Ideal.submodule_span_eq, ← hmap,
    Ideal.mem_quotient_iff_mem hIJ, Ideal.mem_span_singleton, Polynomial.coe_pow, hq, mul_assoc,
    ← mul_pow_sub_one hn (F : O⟦X⟧), mul_dvd_mul_iff_left hprimeF'.ne_zero]
  exact ⟨hprimeF'.pow_dvd_of_dvd_mul_left (n - 1) hq', fun hd ↦ dvd_mul_of_dvd_right hd q⟩

/-- For a prime `p` with `(p : O) ≠ 0` and a prime polynomial `F` distinguished at `I` over an
`I`-adically complete domain `O`, if `F ∣ Φ_{p ^ j}(X + 1)` and `n ≠ 0`, then the delta submodule
of `O⟦X⟧ ⧸ (F ^ n)` is the cyclic submodule generated by `F ^ (n - 1)`. -/
theorem deltaSubmodule_quotient_span_pow_of_dvd {O : Type*} [CommRing O] [IsDomain O]
    {I : Ideal O} [IsAdicComplete I O] {p : ℕ} (hp : p.Prime) (hp0 : (p : O) ≠ 0) {F : O[X]}
    (hF : F.IsDistinguishedAt I) (hprime : Prime F) {n : ℕ} (hn : n ≠ 0) {j : ℕ}
    (hj : F ∣ (Polynomial.cyclotomic (p ^ j) O).comp (Polynomial.X + 1)) :
    deltaSubmodule p O (O⟦X⟧ ⧸ Ideal.span {((F ^ n : O[X]) : O⟦X⟧)}) =
      Submodule.span O⟦X⟧
        {Ideal.Quotient.mk (Ideal.span {((F ^ n : O[X]) : O⟦X⟧)}) ((F : O⟦X⟧) ^ (n - 1))} := by
  refine le_antisymm ?_ ?_
  · rw [deltaSubmodule_le_iff]
    intro k
    exact (monotone_torsionBy_one_add_X_pow_sub_one p O _ (le_max_right j k)).trans
      (torsionBy_one_add_X_pow_sub_one_quotient_span_pow hp hp0 hF hprime hn hj
        (le_max_left j k)).le
  · rw [← torsionBy_one_add_X_pow_sub_one_quotient_span_pow hp hp0 hF hprime hn hj le_rfl]
    exact torsionBy_le_deltaSubmodule p O _ j

/-- For a prime `p` and a prime polynomial `F` distinguished at `I` over an `I`-adically complete
domain `O`, when `F` divides no shifted cyclotomic polynomial `Φ_{p ^ j}(X + 1)`, the delta
submodule of `O⟦X⟧ ⧸ (F ^ n)` is trivial. -/
theorem deltaSubmodule_quotient_span_pow_eq_bot_of_not_dvd {O : Type*} [CommRing O] [IsDomain O]
    {I : Ideal O} [IsAdicComplete I O] {p : ℕ} (hp : p.Prime) {F : O[X]}
    (hF : F.IsDistinguishedAt I) (hprime : Prime F) (n : ℕ)
    (hndvd : ∀ j, ¬ F ∣ (Polynomial.cyclotomic (p ^ j) O).comp (Polynomial.X + 1)) :
    deltaSubmodule p O (O⟦X⟧ ⧸ Ideal.span {((F ^ n : O[X]) : O⟦X⟧)}) = ⊥ := by
  have : Fact p.Prime := ⟨hp⟩
  rw [eq_bot_iff, deltaSubmodule_le_iff]
  intro k
  have H := (hF.pow n).isWeierstrassFactorizationAt
  set ω : O[X] := (1 + Polynomial.X) ^ p ^ k - 1
  have hcoe : (ω : O⟦X⟧) = (1 + X) ^ p ^ k - 1 := by simp [ω]
  rw [← hcoe, (H.torsionBy_eq_bot_iff (ω : O⟦X⟧)).mpr]
  rw [H.norm_mk_coe_eq_resultant,
    Polynomial.resultant_pow_left _ _ _ _ (by simp [hF.monic.leadingCoeff]) le_rfl]
  refine pow_ne_zero n fun h0 ↦ ?_
  have hdvd : F ∣ ω := (hF.monic.resultant_eq_zero_iff_dvd hprime ω).mp h0
  dsimp only [ω] at hdvd
  rw [← Polynomial.prod_range_cyclotomic_prime_pow_comp_X_add_one p k] at hdvd
  obtain ⟨i, -, hi⟩ := (Prime.dvd_finsetProd_iff hprime _).mp hdvd
  exact hndvd i hi

/-- For a prime `p` with `(p : O) ≠ 0` and a prime distinguished polynomial `F` over an infinite
`I`-adically complete domain `O`, the cyclotomic-torsion computation on a horizontal block
`O⟦X⟧ ⧸ (F ^ n)` (`n ≠ 0`): `g • M_δ` is finite iff every shifted cyclotomic factor divisible by
`F` implies `F ∣ g`. -/
theorem finite_smul_deltaSubmodule_quotient_span_pow_iff {O : Type*} [CommRing O] [IsDomain O]
    [Infinite O] {I : Ideal O} [IsAdicComplete I O] {p : ℕ} (hp : p.Prime)
    (hp0 : (p : O) ≠ 0) {F : O[X]} (hF : F.IsDistinguishedAt I) (hprime : Prime F) {n : ℕ}
    (hn : n ≠ 0) (g : O[X]) :
    Finite ↥((g : O⟦X⟧) •
      deltaSubmodule p O (O⟦X⟧ ⧸ Ideal.span {((F ^ n : O[X]) : O⟦X⟧)})) ↔
      ∀ j, F ∣ (Polynomial.cyclotomic (p ^ j) O).comp (Polynomial.X + 1) → F ∣ g := by
  rw [((hF.pow n).isWeierstrassFactorizationAt).finite_submodule_iff_eq_bot]
  have hprimeF' : Prime (F : O⟦X⟧) := hF.prime_coe_iff.mpr hprime
  by_cases hex : ∃ j, F ∣ (Polynomial.cyclotomic (p ^ j) O).comp (Polynomial.X + 1)
  · obtain ⟨j, hj⟩ := hex
    rw [deltaSubmodule_quotient_span_pow_of_dvd hp hp0 hF hprime hn hj,
      Submodule.pointwise_smul_def, Submodule.map_span, Set.image_singleton,
      Submodule.span_singleton_eq_bot, DistribSMul.toLinearMap_apply,
      ← Ideal.Quotient.mk_eq_mk, ← Submodule.Quotient.mk_smul,
      Submodule.Quotient.mk_eq_zero, smul_eq_mul, Ideal.mem_span_singleton,
      Polynomial.coe_pow, ← pow_sub_one_mul hn (F : O⟦X⟧), mul_comm (g : O⟦X⟧),
      mul_dvd_mul_iff_left (pow_ne_zero _ hprimeF'.ne_zero), hF.coe_dvd_coe_iff]
    exact ⟨fun h _ _ ↦ h, fun h ↦ h j hj⟩
  · push Not at hex
    rw [deltaSubmodule_quotient_span_pow_eq_bot_of_not_dvd hp hF hprime n hex,
      Submodule.smul_bot']
    exact ⟨fun _ j hj ↦ (hex j hj).elim, fun _ ↦ rfl⟩

/-- Over a local noetherian ring `O` with finite residue field and `dim O⟦X⟧ = 2`, a
pseudo-isomorphism `f : M → N` from a finitely generated `O⟦X⟧`-module `M` preserves the
finiteness of `r • M_δ` for every scalar `r`. -/
theorem IsPseudoIsomorphism.finite_smul_deltaSubmodule_iff {O M N : Type*} [CommRing O]
    [IsLocalRing O] [IsNoetherianRing O] [Finite (ResidueField O)]
    (hdim : ringKrullDim O⟦X⟧ = 2) [AddCommGroup M] [Module O⟦X⟧ M] [Module.Finite O⟦X⟧ M]
    [AddCommGroup N] [Module O⟦X⟧ N]
    {f : M →ₗ[O⟦X⟧] N} (hf : IsPseudoIsomorphism f) (p : ℕ) (r : O⟦X⟧) :
    Finite ↥(r • deltaSubmodule p O M) ↔ Finite ↥(r • deltaSubmodule p O N) := by
  have : Module.Finite O⟦X⟧ N := hf.finite_iff.mp ‹_›
  have : IsNoetherian O⟦X⟧ M := isNoetherian_of_isNoetherianRing_of_finite O⟦X⟧ M
  have : IsNoetherian O⟦X⟧ N := isNoetherian_of_isNoetherianRing_of_finite O⟦X⟧ N
  obtain ⟨k₁, hk₁⟩ := Filter.eventually_atTop.mp (eventually_deltaSubmodule_eq_torsionBy p O M)
  obtain ⟨k₂, hk₂⟩ := Filter.eventually_atTop.mp (eventually_deltaSubmodule_eq_torsionBy p O N)
  set k := max k₁ k₂
  have hM : deltaSubmodule p O M = torsionBy O⟦X⟧ M ((1 + X) ^ p ^ k - 1) :=
    hk₁ k (le_max_left k₁ k₂)
  have hN : deltaSubmodule p O N = torsionBy O⟦X⟧ N ((1 + X) ^ p ^ k - 1) :=
    hk₂ k (le_max_right k₁ k₂)
  have := ((isPseudoIsomorphism_iff_finite hdim).1 hf).1
  have := ((isPseudoIsomorphism_iff_finite hdim).1 hf).2
  set ω : O⟦X⟧ := (1 + X) ^ p ^ k - 1
  let φ := torsionByMap ω f
  have : Finite (LinearMap.ker φ) := finite_ker_torsionByMap ω f
  have : Finite (torsionBy O⟦X⟧ N ω ⧸ LinearMap.range φ) := finite_coker_torsionByMap ω f
  have hiff := finite_smul_top_iff_of_finite_ker_of_finite_coker r φ
  rw [hM, hN, ← Submodule.finite_smul_top_subtype_iff r (torsionBy O⟦X⟧ M ω),
    ← Submodule.finite_smul_top_subtype_iff r (torsionBy O⟦X⟧ N ω)]
  exact hiff

end Blocks

end TauCeti.Iwasawa

namespace LinearMap

variable {O M N : Type*} [CommRing O] [AddCommGroup M] [Module O⟦X⟧ M]
  [AddCommGroup N] [Module O⟦X⟧ N]

open TauCeti.Iwasawa

/-- Linear maps carry delta elements to delta elements. -/
theorem map_deltaSubmodule_le (f : M →ₗ[O⟦X⟧] N) (p : ℕ) :
    (deltaSubmodule p O M).map f ≤ deltaSubmodule p O N := by
  rintro y ⟨x, hx, rfl⟩
  obtain ⟨n, hn⟩ := (mem_deltaSubmodule p O M x).mp hx
  exact (mem_deltaSubmodule p O N (f x)).mpr ⟨n, by rw [← map_smul, hn, map_zero]⟩

/-- An injective linear map reflects the delta submodule as well as preserving it. -/
@[simp]
theorem comap_deltaSubmodule_of_injective (f : M →ₗ[O⟦X⟧] N) (hf : Function.Injective f)
    (p : ℕ) : (deltaSubmodule p O N).comap f = deltaSubmodule p O M := by
  ext x
  simp only [Submodule.mem_comap, mem_deltaSubmodule]
  exact exists_congr fun n ↦ by rw [← map_smul, ← map_zero f, hf.eq_iff]

end LinearMap

namespace LinearEquiv

variable {O M N : Type*} [CommRing O] [AddCommGroup M] [Module O⟦X⟧ M]
  [AddCommGroup N] [Module O⟦X⟧ N]

open TauCeti.Iwasawa

/-- Linear equivalences identify the delta submodules. -/
@[simp]
theorem map_deltaSubmodule (e : M ≃ₗ[O⟦X⟧] N) (p : ℕ) :
    (deltaSubmodule p O M).map e.toLinearMap = deltaSubmodule p O N := by
  rw [← e.toLinearMap.comap_deltaSubmodule_of_injective e.injective p,
    Submodule.map_comap_eq_of_surjective e.surjective]

end LinearEquiv

namespace Submodule

open TauCeti.Iwasawa

variable {O M : Type*} [CommRing O] [AddCommGroup M] [Module O⟦X⟧ M]

/-- Taking the delta submodule commutes with passage to a submodule. -/
@[simp]
theorem map_deltaSubmodule_subtype (S : Submodule O⟦X⟧ M) (p : ℕ) :
    (deltaSubmodule p O S).map S.subtype = S ⊓ deltaSubmodule p O M := by
  rw [← S.subtype.comap_deltaSubmodule_of_injective S.subtype_injective p,
    Submodule.map_comap_eq, Submodule.range_subtype, inf_comm]

end Submodule

namespace TauCeti.Iwasawa

variable (p : ℕ) (O : Type*) [CommRing O]

-- The zero module has no delta elements other than zero.
example : deltaSubmodule p O (Fin 0 → O⟦X⟧) = ⊥ := Subsingleton.elim _ _

-- In particular the free rank-one module has zero delta submodule.
example [NeZero p] [IsDomain O] : deltaSubmodule p O O⟦X⟧ = ⊥ := by simp

-- If X kills the module, every element is already a level-zero delta element.
example : deltaSubmodule p O (O⟦X⟧ ⧸ Ideal.span {(X : O⟦X⟧)}) = ⊤ := by
  apply top_unique
  intro x _
  refine (mem_deltaSubmodule p O _ x).mpr ⟨0, ?_⟩
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  simp only [pow_zero, pow_one, add_sub_cancel_left]
  rw [← Ideal.Quotient.mk_eq_mk, ← Submodule.Quotient.mk_smul, smul_eq_mul,
    Submodule.Quotient.mk_eq_zero]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton _))

end TauCeti.Iwasawa
