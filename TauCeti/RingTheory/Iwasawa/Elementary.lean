module

public import Mathlib.RingTheory.PowerSeries.WeierstrassPreparation
public import TauCeti.RingTheory.Iwasawa.PseudoIsomorphism

import TauCeti.RingTheory.Iwasawa.StructureTheorem
import TauCeti.RingTheory.PowerSeries.Weierstrass.HeightOne
import TauCeti.RingTheory.RegularLocalRing.PowerSeries

/-!
# The structure theorem for Iwasawa modules

Let `O` be a discrete valuation ring with uniformiser `ϖ`, complete for its maximal ideal, and let
`Λ = O⟦X⟧` be the Iwasawa algebra over `O`. An *elementary* `Λ`-module is a module
`Λʳ × ∏ᵢ Λ ⧸ (ϖ ^ mᵢ) × ∏ⱼ Λ ⧸ (Fⱼ ^ nⱼ)` with each `Fⱼ` an irreducible distinguished polynomial.
Every finitely generated `Λ`-module admits a pseudo-isomorphism, that is a map with finite kernel
and cokernel when the residue field of `O` is finite, onto an elementary module. The vertical
factors are powers of the uniformiser `ϖ`, not of `p`, which matters when `O` is ramified over
`ℤ_p`.

This specialises the structure theorem over a regular local ring of dimension two
(`TauCeti.Iwasawa.exists_isPseudoIsomorphism_prod_pi_quotient_pow`) to `Λ`, whose height-one primes
are `(ϖ)` and the ideals `(F)` with `F` irreducible and distinguished
(`PowerSeries.height_eq_one_iff_of_isDiscreteValuationRing`). In terms of the elementary module,
the Iwasawa invariants of a torsion module are `μ = Σ mᵢ` and `λ = Σ nⱼ deg Fⱼ`, and its
characteristic polynomial is `∏ Fⱼ ^ nⱼ`.

## Main definitions

* `TauCeti.Iwasawa.Elementary O ϖ r m F n`: the elementary module
  `O⟦X⟧ʳ × ∏ᵢ O⟦X⟧ ⧸ (ϖ ^ mᵢ) × ∏ⱼ O⟦X⟧ ⧸ (Fⱼ ^ nⱼ)`.

## Main results

* `TauCeti.Iwasawa.exists_isPseudoIsomorphism_elementary`: every finitely generated
  `O⟦X⟧`-module admits a pseudo-isomorphism onto an elementary module, with every exponent
  positive and every `Fⱼ` irreducible and distinguished.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, Theorem (5.3.8).
* L. Washington, *Introduction to Cyclotomic Fields*, second edition, GTM 83, Theorem 13.12.
-/

public section

open IsLocalRing PowerSeries
open scoped Polynomial PowerSeries

namespace TauCeti.Iwasawa

/-- The elementary `O⟦X⟧`-module `O⟦X⟧ʳ × ∏ᵢ O⟦X⟧ ⧸ (ϖ ^ mᵢ) × ∏ⱼ O⟦X⟧ ⧸ (Fⱼ ^ nⱼ)`, with
vertical factors indexed by `Fin a` and horizontal factors indexed by `Fin b`. -/
abbrev Elementary (O : Type*) [CommRing O] (ϖ : O) (r : ℕ) {a b : ℕ} (m : Fin a → ℕ)
    (F : Fin b → O[X]) (n : Fin b → ℕ) : Type _ :=
  (Fin r → O⟦X⟧) × (∀ i, O⟦X⟧ ⧸ Ideal.span {C (ϖ ^ m i)}) ×
    ∀ j, O⟦X⟧ ⧸ Ideal.span {((F j ^ n j : O[X]) : O⟦X⟧)}

variable {O : Type*} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  [IsAdicComplete (maximalIdeal O) O] {ϖ : O} {M : Type*} [AddCommGroup M] [Module O⟦X⟧ M]

/-- **The structure theorem for Iwasawa modules.** Let `O` be a discrete valuation ring with
uniformiser `ϖ`, complete for its maximal ideal. Every finitely generated `O⟦X⟧`-module admits a
pseudo-isomorphism onto an elementary module `O⟦X⟧ʳ × ∏ᵢ O⟦X⟧ ⧸ (ϖ ^ mᵢ) × ∏ⱼ O⟦X⟧ ⧸ (Fⱼ ^ nⱼ)`
with every `mᵢ` and `nⱼ` positive and every `Fⱼ` irreducible and distinguished.
Neukirch–Schmidt–Wingberg, Theorem (5.3.8). -/
theorem exists_isPseudoIsomorphism_elementary (hϖ : Irreducible ϖ) [Module.Finite O⟦X⟧ M] :
    ∃ (r a b : ℕ) (m : Fin a → ℕ) (F : Fin b → O[X]) (n : Fin b → ℕ), (∀ i, m i ≠ 0) ∧
      (∀ j, (F j).IsDistinguishedAt (maximalIdeal O) ∧ Irreducible (F j) ∧ n j ≠ 0) ∧
        ∃ f : M →ₗ[O⟦X⟧] Elementary O ϖ r m F n, IsPseudoIsomorphism f := by
  classical
  obtain ⟨r, ι, _, 𝔭, n, h𝔭n, f, hf⟩ := exists_isPseudoIsomorphism_prod_pi_quotient_pow
    (A := O⟦X⟧) (M := M) (TauCeti.PowerSeries.ringKrullDim_of_isDiscreteValuationRing).le
  -- Each height-one prime is `(ϖ)` or is generated by an irreducible distinguished polynomial.
  let p (i : ι) : Prop := (𝔭 i).asIdeal = Ideal.span {C ϖ}
  choose G hG using fun i : {i // ¬ p i} ↦
    ((height_eq_one_iff_of_isDiscreteValuationRing hϖ (𝔭 i).asIdeal).mp (h𝔭n i).1).resolve_left
      i.2
  let eV := Fintype.equivFin {i // p i}
  let eH := Fintype.equivFin {i // ¬ p i}
  refine ⟨r, _, _, fun k ↦ n (eV.symm k), fun k ↦ G (eH.symm k), fun k ↦ n (eH.symm k),
    fun k ↦ (h𝔭n _).2, fun k ↦ ⟨(hG _).1, (hG _).2.1, (h𝔭n _).2⟩, ?_⟩
  -- Split the product over `ι` into its vertical and horizontal factors, and reindex both.
  let split : (∀ i, O⟦X⟧ ⧸ (𝔭 i).asIdeal ^ n i) ≃ₗ[O⟦X⟧]
      (∀ i : {i // p i}, O⟦X⟧ ⧸ (𝔭 i).asIdeal ^ n i) ×
        ∀ i : {i // ¬ p i}, O⟦X⟧ ⧸ (𝔭 i).asIdeal ^ n i :=
    { Equiv.piEquivPiSubtypeProd p _ with map_add' := fun _ _ ↦ rfl, map_smul' := fun _ _ ↦ rfl }
  let eVert := LinearEquiv.piCongrLeft' O⟦X⟧ (fun i : {i // p i} ↦ O⟦X⟧ ⧸ (𝔭 i).asIdeal ^ n i)
      eV ≪≫ₗ LinearEquiv.piCongrRight fun k ↦ Submodule.quotEquivOfEq _
        (Ideal.span {C (ϖ ^ n (eV.symm k))})
        (by rw [(eV.symm k).2, Ideal.span_singleton_pow, map_pow])
  let eHor := LinearEquiv.piCongrLeft' O⟦X⟧ (fun i : {i // ¬ p i} ↦ O⟦X⟧ ⧸ (𝔭 i).asIdeal ^ n i)
      eH ≪≫ₗ LinearEquiv.piCongrRight fun k ↦ Submodule.quotEquivOfEq _
        (Ideal.span {((G (eH.symm k) ^ n (eH.symm k) : O[X]) : O⟦X⟧)})
        (by rw [(hG _).2.2, Ideal.span_singleton_pow, Polynomial.coe_pow])
  exact ⟨((LinearEquiv.refl _ _).prodCongr (split ≪≫ₗ eVert.prodCongr eHor)).toLinearMap ∘ₗ f,
    (IsPseudoIsomorphism.of_bijective (LinearEquiv.bijective _)).comp hf⟩

end TauCeti.Iwasawa
