/-!
# The characteristic polynomial and the `λ`-invariant of an Iwasawa module

Let `O` be a discrete valuation ring with maximal ideal `𝔪 = (ϖ)`, complete for `𝔪`, and let
`Λ = O⟦X⟧`. Besides the vertical prime `(ϖ)`, the height-one primes of `Λ` are the ideals `(F)`
generated by an irreducible polynomial `F` distinguished at `𝔪`
(`PowerSeries.height_eq_one_iff_of_isDiscreteValuationRing`), and the generator `F` is unique: it
is the *distinguished generator* of the prime (`PrimeSpectrum.distinguishedGenerator`). The
*characteristic polynomial* of a `Λ`-module `M` is

  `F_M = ∏_𝔭 F_𝔭 ^ div_Λ(T_Λ(M))(𝔭)`,

the product of the distinguished generators `F_𝔭` of the height-one primes `𝔭`, raised to their
multiplicities in the characteristic divisor of the torsion submodule `T_Λ(M)`; the vertical prime
has no distinguished generator and contributes `1`. The *`λ`-invariant* of `M` is the degree of
`F_M`.

Both are read off the characteristic divisor, so they are invariant under pseudo-isomorphism and,
for finitely generated torsion modules, multiplicative (resp. additive) in short exact sequences.
On an elementary module `Λʳ × ∏ᵢ Λ ⧸ (ϖ ^ mᵢ) × ∏ⱼ Λ ⧸ (Fⱼ ^ nⱼ)` with irreducible distinguished
`Fⱼ`, the characteristic polynomial is `∏ Fⱼ ^ nⱼ` and `λ = Σ nⱼ deg Fⱼ`: free and vertical
factors contribute nothing. By the structure theorem for Iwasawa modules
(`TauCeti.Iwasawa.exists_isPseudoIsomorphism_elementary`), these are therefore the horizontal data
of any elementary module pseudo-isomorphic to `M`, independently of the choice. Together with the
`μ`-invariant they determine the characteristic ideal: for a torsion module,
`char_Λ(M) = (ϖ ^ μ(M) F_M)`.

## Main definitions

* `TauCeti.Iwasawa.charPoly O M`: the characteristic polynomial `F_M` of an `O⟦X⟧`-module `M`.
* `TauCeti.Iwasawa.lambdaInvariant O M`: the `λ`-invariant of `M`, the degree of `F_M`.

## Main results

* `TauCeti.Iwasawa.isDistinguishedAt_charPoly`: `F_M` is distinguished, in particular monic.
* `TauCeti.Iwasawa.IsPseudoIsomorphism.charPoly_eq`,
  `TauCeti.Iwasawa.IsPseudoIsomorphism.lambdaInvariant_eq`: invariance under pseudo-isomorphism.
* `TauCeti.Iwasawa.charPoly_eq_mul_of_exact`, `TauCeti.Iwasawa.lambdaInvariant_eq_add_of_exact`:
  multiplicativity and additivity in short exact sequences of finitely generated torsion modules.
* `TauCeti.Iwasawa.charPoly_elementary`, `TauCeti.Iwasawa.lambdaInvariant_elementary`: the values
  on an elementary module, `∏ Fⱼ ^ nⱼ` and `Σ nⱼ deg Fⱼ`.
* `TauCeti.Iwasawa.IsPseudoIsomorphism.charPoly_eq_prod`,
  `TauCeti.Iwasawa.IsPseudoIsomorphism.lambdaInvariant_eq_sum`: the same values for any module
  pseudo-isomorphic to an elementary module.
* `TauCeti.Iwasawa.charIdeal_eq_span_C_pow_mul_charPoly`: `char_Λ(M) = (ϖ ^ μ(M) F_M)` for a
  torsion module `M`.

The examples at the end of the file are over `Λ = ℤ_p⟦T⟧`: `Λ ⧸ (p)` and the finite module
`Λ ⧸ (p, T)` have `F_M = 1` and `λ = 0`, while the module `Λ ⧸ (T² + pT + p)`, cut out by an
Eisenstein polynomial, has `F_M = T² + pT + p` and `λ = 2`.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, (5.3.9) and (5.3.10).
* L. Washington, *Introduction to Cyclotomic Fields*, second edition, GTM 83, §13.2.
-/

public section

open IsLocalRing PowerSeries Submodule
open scoped Polynomial PowerSeries

universe u

namespace TauCeti.Iwasawa

/-- The vertical prime `(ϖ)` has no distinguished generator, so its distinguished generator is
`1`. -/
@[simp]
theorem distinguishedGenerator_verticalPrime {O : Type*} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] : (verticalPrime O).distinguishedGenerator = 1 := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  exact PrimeSpectrum.distinguishedGenerator_eq_one_of_asIdeal_eq_span_C
    ((mem_maximalIdeal _).mpr hϖ.not_isUnit) (verticalPrime_asIdeal_eq_span hϖ)

section CharPoly

variable (O : Type*) [CommRing O] [IsLocalRing O] (M : Type*) [AddCommGroup M] [Module O⟦X⟧ M]

/-- The *characteristic polynomial* `F_M` of a module `M` over `O⟦X⟧`, for a local ring `O`: the
product of the distinguished generators of the primes `𝔭`, raised to their multiplicities in the
characteristic divisor of the torsion submodule of `M`. Over a complete discrete valuation ring the
vertical prime `(ϖ)` contributes `1`, every other height-one prime is generated by an irreducible
distinguished polynomial, and for finitely generated `M` the polynomial `F_M` is the product
`∏ Fⱼ ^ nⱼ` of the horizontal factors of any elementary module pseudo-isomorphic to `M`
(`IsPseudoIsomorphism.charPoly_eq_prod`). -/
noncomputable def charPoly : O[X] :=
  (charDivisor O⟦X⟧ (torsion O⟦X⟧ M)).prod fun 𝔭 n ↦ 𝔭.distinguishedGenerator ^ n

/-- The *`λ`-invariant* of a module `M` over `O⟦X⟧`, for a local ring `O`: the degree of its
characteristic polynomial. For finitely generated `M` over a complete discrete valuation ring it
is the sum `Σ nⱼ deg Fⱼ` over the horizontal factors of any elementary module pseudo-isomorphic to
`M` (`IsPseudoIsomorphism.lambdaInvariant_eq_sum`). -/
noncomputable def lambdaInvariant : ℕ :=
  (charPoly O M).natDegree

variable {O M}

theorem charPoly_def : charPoly O M =
    (charDivisor O⟦X⟧ (torsion O⟦X⟧ M)).prod fun 𝔭 n ↦ 𝔭.distinguishedGenerator ^ n :=
  (rfl)

theorem lambdaInvariant_def : lambdaInvariant O M = (charPoly O M).natDegree :=
  (rfl)

/-- The characteristic polynomial is distinguished at the maximal ideal. -/
theorem isDistinguishedAt_charPoly : (charPoly O M).IsDistinguishedAt (maximalIdeal O) :=
  Polynomial.isDistinguishedAt_prod fun 𝔭 _ ↦
    𝔭.isDistinguishedAt_distinguishedGenerator.pow _

/-- The characteristic polynomial is monic. -/
theorem monic_charPoly : (charPoly O M).Monic :=
  isDistinguishedAt_charPoly.monic

/-- The characteristic polynomial of a torsion module is read off its characteristic divisor. -/
theorem charPoly_eq_prod_charDivisor (hM : Module.IsTorsion O⟦X⟧ M) :
    charPoly O M = (charDivisor O⟦X⟧ M).prod fun 𝔭 n ↦ 𝔭.distinguishedGenerator ^ n := by
  rw [charPoly_def, (LinearEquiv.ofTop _
    (eq_top_iff.mpr fun x _ ↦ (mem_torsion_iff x).mpr (@hM x))).charDivisor_eq]

/-- The characteristic polynomial of `M` is that of its torsion submodule. -/
@[simp]
theorem charPoly_torsion : charPoly O (torsion O⟦X⟧ M) = charPoly O M := by
  rw [charPoly_eq_prod_charDivisor (torsion_isTorsion (R := O⟦X⟧) (M := M)), charPoly_def]

/-- The `λ`-invariant of `M` is that of its torsion submodule. -/
@[simp]
theorem lambdaInvariant_torsion : lambdaInvariant O (torsion O⟦X⟧ M) = lambdaInvariant O M := by
  rw [lambdaInvariant_def, charPoly_torsion, lambdaInvariant_def]

/-- The characteristic polynomial of a torsion-free module is `1`. -/
@[simp]
theorem charPoly_eq_one_of_isTorsionFree [IsDomain O] [Module.IsTorsionFree O⟦X⟧ M] :
    charPoly O M = 1 := by
  have := subsingleton_iff_eq_bot.mpr
    ((isTorsionFree_iff_torsion_eq_bot (R := O⟦X⟧) (M := M)).mp inferInstance)
  rw [charPoly_def, charDivisor_of_subsingleton, Finsupp.prod_zero_index]

/-- The `λ`-invariant of a torsion-free module is zero. -/
@[simp]
theorem lambdaInvariant_eq_zero_of_isTorsionFree [IsDomain O] [Module.IsTorsionFree O⟦X⟧ M] :
    lambdaInvariant O M = 0 := by
  rw [lambdaInvariant_def, charPoly_eq_one_of_isTorsionFree, Polynomial.natDegree_one]

/-- The characteristic polynomial of the zero module is `1`. -/
@[simp]
theorem charPoly_of_subsingleton [Subsingleton M] : charPoly O M = 1 := by
  rw [charPoly_def, charDivisor_of_subsingleton, Finsupp.prod_zero_index]

/-- The `λ`-invariant of the zero module is zero. -/
@[simp]
theorem lambdaInvariant_of_subsingleton [Subsingleton M] : lambdaInvariant O M = 0 := by
  rw [lambdaInvariant_def, charPoly_of_subsingleton, Polynomial.natDegree_one]

/-- The characteristic polynomial of a pseudo-null module is `1`. -/
theorem IsPseudoNull.charPoly_eq_one [IsNoetherianRing O] (hM : IsPseudoNull O⟦X⟧ M) :
    charPoly O M = 1 := by
  rw [charPoly_def, (hM.of_injective _ (torsion O⟦X⟧ M).injective_subtype).charDivisor_eq_zero,
    Finsupp.prod_zero_index]

/-- The `λ`-invariant of a pseudo-null module is zero. -/
theorem IsPseudoNull.lambdaInvariant_eq_zero [IsNoetherianRing O] (hM : IsPseudoNull O⟦X⟧ M) :
    lambdaInvariant O M = 0 := by
  rw [lambdaInvariant_def, hM.charPoly_eq_one, Polynomial.natDegree_one]

variable {N P : Type*} [AddCommGroup N] [Module O⟦X⟧ N] [AddCommGroup P] [Module O⟦X⟧ P]

/-- The characteristic polynomial is invariant under pseudo-isomorphism. -/
theorem IsPseudoIsomorphism.charPoly_eq [IsDomain O] [IsNoetherianRing O] {f : M →ₗ[O⟦X⟧] N}
    (hf : IsPseudoIsomorphism f) : charPoly O M = charPoly O N := by
  rw [charPoly_def, charPoly_def, hf.restrict_torsion.charDivisor_eq]

/-- The `λ`-invariant is invariant under pseudo-isomorphism. -/
theorem IsPseudoIsomorphism.lambdaInvariant_eq [IsDomain O] [IsNoetherianRing O]
    {f : M →ₗ[O⟦X⟧] N} (hf : IsPseudoIsomorphism f) :
    lambdaInvariant O M = lambdaInvariant O N := by
  rw [lambdaInvariant_def, lambdaInvariant_def, hf.charPoly_eq]

/-- The characteristic polynomial is invariant under linear equivalence. -/
theorem _root_.LinearEquiv.charPoly_eq (e : M ≃ₗ[O⟦X⟧] N) : charPoly O M = charPoly O N := by
  rw [charPoly_def, charPoly_def, e.charDivisor_torsion_eq]

/-- The `λ`-invariant is invariant under linear equivalence. -/
theorem _root_.LinearEquiv.lambdaInvariant_eq (e : M ≃ₗ[O⟦X⟧] N) :
    lambdaInvariant O M = lambdaInvariant O N := by
  rw [lambdaInvariant_def, lambdaInvariant_def, e.charPoly_eq]

/-- **Multiplicativity of the characteristic polynomial.** In a short exact sequence
`0 → M → N → P → 0` of finitely generated torsion `O⟦X⟧`-modules, `F_N = F_M F_P`. -/
theorem charPoly_eq_mul_of_exact [IsNoetherianRing O] [Module.Finite O⟦X⟧ N]
    (hN : Module.IsTorsion O⟦X⟧ N) {f : M →ₗ[O⟦X⟧] N} {g : N →ₗ[O⟦X⟧] P}
    (hfg : Function.Exact f g) (hf : Function.Injective f) (hg : Function.Surjective g) :
    charPoly O N = charPoly O M * charPoly O P := by
  rw [charPoly_eq_prod_charDivisor hN, charPoly_eq_prod_charDivisor (hN.of_injective hf),
    charPoly_eq_prod_charDivisor (hN.of_surjective hg), charDivisor_eq_add_of_exact hN hfg hf hg,
    Finsupp.prod_add_index' (fun _ ↦ pow_zero _) fun _ ↦ pow_add _]

/-- **Additivity of the `λ`-invariant.** In a short exact sequence `0 → M → N → P → 0` of finitely
generated torsion `O⟦X⟧`-modules, `λ(N) = λ(M) + λ(P)`. -/
theorem lambdaInvariant_eq_add_of_exact [IsNoetherianRing O] [Module.Finite O⟦X⟧ N]
    (hN : Module.IsTorsion O⟦X⟧ N) {f : M →ₗ[O⟦X⟧] N} {g : N →ₗ[O⟦X⟧] P}
    (hfg : Function.Exact f g) (hf : Function.Injective f) (hg : Function.Surjective g) :
    lambdaInvariant O N = lambdaInvariant O M + lambdaInvariant O P := by
  rw [lambdaInvariant_def, charPoly_eq_mul_of_exact hN hfg hf hg, monic_charPoly.natDegree_mul
    monic_charPoly, lambdaInvariant_def, lambdaInvariant_def]

/-- The characteristic polynomial of a product of two finitely generated modules is the product of
their characteristic polynomials. -/
@[simp]
theorem charPoly_prod [IsNoetherianRing O] [Module.Finite O⟦X⟧ M] [Module.Finite O⟦X⟧ N] :
    charPoly O (M × N) = charPoly O M * charPoly O N := by
  rw [charPoly_def, charDivisor_torsion_prod,
    Finsupp.prod_add_index' (fun _ ↦ pow_zero _) fun _ ↦ pow_add _, charPoly_def, charPoly_def]

/-- The `λ`-invariant of a product of two finitely generated modules is the sum of their
`λ`-invariants. -/
@[simp]
theorem lambdaInvariant_prod [IsNoetherianRing O] [Module.Finite O⟦X⟧ M] [Module.Finite O⟦X⟧ N] :
    lambdaInvariant O (M × N) = lambdaInvariant O M + lambdaInvariant O N := by
  rw [lambdaInvariant_def, charPoly_prod, monic_charPoly.natDegree_mul monic_charPoly,
    lambdaInvariant_def, lambdaInvariant_def]

/-- The characteristic polynomial of a finite product of finitely generated modules is the product
of their characteristic polynomials. -/
@[simp]
theorem charPoly_pi [IsNoetherianRing O] {ι : Type*} [Fintype ι] (M : ι → Type u)
    [∀ i, AddCommGroup (M i)] [∀ i, Module O⟦X⟧ (M i)] [∀ i, Module.Finite O⟦X⟧ (M i)] :
    charPoly O (∀ i, M i) = ∏ i, charPoly O (M i) := by
  simp only [charPoly_def]
  rw [charDivisor_torsion_pi, Finsupp.prod_finsetSum_index (fun _ ↦ pow_zero _) fun _ ↦ pow_add _]

/-- The `λ`-invariant of a finite product of finitely generated modules is the sum of their
`λ`-invariants. -/
@[simp]
theorem lambdaInvariant_pi [IsNoetherianRing O] {ι : Type*} [Fintype ι] (M : ι → Type u)
    [∀ i, AddCommGroup (M i)] [∀ i, Module O⟦X⟧ (M i)] [∀ i, Module.Finite O⟦X⟧ (M i)] :
    lambdaInvariant O (∀ i, M i) = ∑ i, lambdaInvariant O (M i) := by
  simp only [lambdaInvariant_def]
  rw [charPoly_pi, Polynomial.natDegree_prod_of_monic _ _ fun i _ ↦ monic_charPoly]

end CharPoly

section Elementary

variable {O : Type*} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] {ϖ : O}

/-- **The characteristic polynomial of a vertical factor.** For a uniformiser `ϖ` of `O`, the
characteristic polynomial of `O⟦X⟧ ⧸ (ϖ ^ m)` is `1`. -/
theorem charPoly_quotient_span_C_pow (hϖ : Irreducible ϖ) (m : ℕ) :
    charPoly O (O⟦X⟧ ⧸ Ideal.span {C (ϖ ^ m)}) = 1 := by
  have hϖ' : Prime (C ϖ : O⟦X⟧) := prime_C_iff.mpr hϖ.prime
  have hM := Ideal.isTorsion_quotient_of_mem (Ideal.mem_span_singleton_self (C (ϖ ^ m)))
    (mem_nonZeroDivisors_of_ne_zero (by rw [map_pow]; exact pow_ne_zero m hϖ'.ne_zero))
  have h : verticalPrime O = ⟨Ideal.span {C ϖ}, (Ideal.span_singleton_prime hϖ'.ne_zero).mpr hϖ'⟩ :=
    PrimeSpectrum.ext (verticalPrime_asIdeal_eq_span hϖ)
  rw [charPoly_eq_prod_charDivisor hM, map_pow, charDivisor_quotient_span_singleton_pow hϖ' m,
    ← h, Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.prod_single_index (by rw [pow_zero]),
    distinguishedGenerator_verticalPrime, one_pow]

/-- The `λ`-invariant of a vertical factor `O⟦X⟧ ⧸ (ϖ ^ m)` is zero. -/
theorem lambdaInvariant_quotient_span_C_pow (hϖ : Irreducible ϖ) (m : ℕ) :
    lambdaInvariant O (O⟦X⟧ ⧸ Ideal.span {C (ϖ ^ m)}) = 0 := by
  rw [lambdaInvariant_def, charPoly_quotient_span_C_pow hϖ, Polynomial.natDegree_one]

variable [IsAdicComplete (maximalIdeal O) O]

/-- **The characteristic polynomial of a horizontal factor.** For an irreducible polynomial `F`
distinguished at the maximal ideal, the characteristic polynomial of `O⟦X⟧ ⧸ (F ^ n)` is
`F ^ n`. -/
theorem charPoly_quotient_span_pow {F : O[X]} (hF : F.IsDistinguishedAt (maximalIdeal O))
    (hirr : Irreducible F) (n : ℕ) :
    charPoly O (O⟦X⟧ ⧸ Ideal.span {((F ^ n : O[X]) : O⟦X⟧)}) = F ^ n := by
  have hF' : Prime (F : O⟦X⟧) := hF.prime_coe_iff.mpr hirr.prime
  have hM := Ideal.isTorsion_quotient_of_mem (Ideal.mem_span_singleton_self ((F ^ n : O[X]) : O⟦X⟧))
    (mem_nonZeroDivisors_of_ne_zero (by rw [Polynomial.coe_pow]; exact pow_ne_zero n hF'.ne_zero))
  rw [charPoly_eq_prod_charDivisor hM, Polynomial.coe_pow,
    charDivisor_quotient_span_singleton_pow hF' n, Finsupp.smul_single, smul_eq_mul, mul_one,
    Finsupp.prod_single_index (by rw [pow_zero]), PrimeSpectrum.distinguishedGenerator_eq hF rfl]

/-- The `λ`-invariant of a horizontal factor `O⟦X⟧ ⧸ (F ^ n)`, for an irreducible distinguished
polynomial `F`, is `n deg F`. -/
theorem lambdaInvariant_quotient_span_pow {F : O[X]} (hF : F.IsDistinguishedAt (maximalIdeal O))
    (hirr : Irreducible F) (n : ℕ) :
    lambdaInvariant O (O⟦X⟧ ⧸ Ideal.span {((F ^ n : O[X]) : O⟦X⟧)}) = n * F.natDegree := by
  rw [lambdaInvariant_def, charPoly_quotient_span_pow hF hirr, hF.monic.natDegree_pow]

/-- **The characteristic polynomial of an elementary module.** Let `ϖ` be a uniformiser of `O` and
let the `Fⱼ` be irreducible and distinguished. The characteristic polynomial of
`O⟦X⟧ʳ × ∏ᵢ O⟦X⟧ ⧸ (ϖ ^ mᵢ) × ∏ⱼ O⟦X⟧ ⧸ (Fⱼ ^ nⱼ)` is `∏ Fⱼ ^ nⱼ`. -/
theorem charPoly_elementary (hϖ : Irreducible ϖ) (r : ℕ) {a b : ℕ} (m : Fin a → ℕ)
    {F : Fin b → O[X]} (hF : ∀ j, (F j).IsDistinguishedAt (maximalIdeal O))
    (hirr : ∀ j, Irreducible (F j)) (n : Fin b → ℕ) :
    charPoly O (Elementary O ϖ r m F n) = ∏ j, F j ^ n j := by
  rw [charPoly_prod, charPoly_prod, charPoly_eq_one_of_isTorsionFree, charPoly_pi, charPoly_pi]
  simp only [charPoly_quotient_span_C_pow hϖ, charPoly_quotient_span_pow (hF _) (hirr _),
    Finset.prod_const_one, one_mul]

/-- **The `λ`-invariant of an elementary module.** Let `ϖ` be a uniformiser of `O` and let the `Fⱼ`
be irreducible and distinguished. The `λ`-invariant of
`O⟦X⟧ʳ × ∏ᵢ O⟦X⟧ ⧸ (ϖ ^ mᵢ) × ∏ⱼ O⟦X⟧ ⧸ (Fⱼ ^ nⱼ)` is `Σ nⱼ deg Fⱼ`. -/
theorem lambdaInvariant_elementary (hϖ : Irreducible ϖ) (r : ℕ) {a b : ℕ} (m : Fin a → ℕ)
    {F : Fin b → O[X]} (hF : ∀ j, (F j).IsDistinguishedAt (maximalIdeal O))
    (hirr : ∀ j, Irreducible (F j)) (n : Fin b → ℕ) :
    lambdaInvariant O (Elementary O ϖ r m F n) = ∑ j, n j * (F j).natDegree := by
  rw [lambdaInvariant_prod, lambdaInvariant_prod, lambdaInvariant_eq_zero_of_isTorsionFree,
    lambdaInvariant_pi, lambdaInvariant_pi]
  simp only [lambdaInvariant_quotient_span_C_pow hϖ,
    lambdaInvariant_quotient_span_pow (hF _) (hirr _), Finset.sum_const_zero, zero_add]

variable {M : Type*} [AddCommGroup M] [Module O⟦X⟧ M]

/-- **The characteristic polynomial from an elementary module.** If a module `M` over `O⟦X⟧` is
pseudo-isomorphic to an elementary module `O⟦X⟧ʳ × ∏ᵢ O⟦X⟧ ⧸ (ϖ ^ mᵢ) × ∏ⱼ O⟦X⟧ ⧸ (Fⱼ ^ nⱼ)` with
irreducible distinguished `Fⱼ`, then `F_M = ∏ Fⱼ ^ nⱼ`. In particular this product does not depend
on the elementary module chosen in the structure theorem `exists_isPseudoIsomorphism_elementary`. -/
theorem IsPseudoIsomorphism.charPoly_eq_prod (hϖ : Irreducible ϖ) {r a b : ℕ} {m : Fin a → ℕ}
    {F : Fin b → O[X]} {n : Fin b → ℕ} (hF : ∀ j, (F j).IsDistinguishedAt (maximalIdeal O))
    (hirr : ∀ j, Irreducible (F j)) {f : M →ₗ[O⟦X⟧] Elementary O ϖ r m F n}
    (hf : IsPseudoIsomorphism f) : charPoly O M = ∏ j, F j ^ n j :=
  hf.charPoly_eq.trans (charPoly_elementary hϖ r m hF hirr n)

/-- **The `λ`-invariant from an elementary module.** If a module `M` over `O⟦X⟧` is
pseudo-isomorphic to an elementary module `O⟦X⟧ʳ × ∏ᵢ O⟦X⟧ ⧸ (ϖ ^ mᵢ) × ∏ⱼ O⟦X⟧ ⧸ (Fⱼ ^ nⱼ)` with
irreducible distinguished `Fⱼ`, then `λ(M) = Σ nⱼ deg Fⱼ`. -/
theorem IsPseudoIsomorphism.lambdaInvariant_eq_sum (hϖ : Irreducible ϖ) {r a b : ℕ}
    {m : Fin a → ℕ} {F : Fin b → O[X]} {n : Fin b → ℕ}
    (hF : ∀ j, (F j).IsDistinguishedAt (maximalIdeal O)) (hirr : ∀ j, Irreducible (F j))
    {f : M →ₗ[O⟦X⟧] Elementary O ϖ r m F n} (hf : IsPseudoIsomorphism f) :
    lambdaInvariant O M = ∑ j, n j * (F j).natDegree :=
  hf.lambdaInvariant_eq.trans (lambdaInvariant_elementary hϖ r m hF hirr n)

omit [IsAdicComplete (maximalIdeal O) O] in
/-- The vertical prime contributes `1` to the characteristic polynomial: for a torsion module `M`,
`F_M` is the product of the distinguished generators over the other primes of `div_Λ(M)`. -/
theorem charPoly_eq_prod_erase_verticalPrime (hM : Module.IsTorsion O⟦X⟧ M) :
    charPoly O M = ((charDivisor O⟦X⟧ M).erase (verticalPrime O)).prod
      fun 𝔭 n ↦ 𝔭.distinguishedGenerator ^ n := by
  rw [charPoly_eq_prod_charDivisor hM, ← Finsupp.mul_prod_erase' (charDivisor O⟦X⟧ M)
    (verticalPrime O) _ fun _ ↦ pow_zero _, distinguishedGenerator_verticalPrime, one_pow, one_mul]

/-- Over a complete discrete valuation ring, let `d` be a divisor supported on height-one primes of
`O⟦X⟧`. Away from the vertical prime `(ϖ)`, the product `∏ 𝔭 ^ d(𝔭)` is the principal ideal
generated by the product `∏ F_𝔭 ^ d(𝔭)` of the distinguished generators. -/
theorem prod_erase_verticalPrime_asIdeal_pow_eq_span {d : PrimeSpectrum O⟦X⟧ →₀ ℕ}
    (hd : ∀ 𝔭 ∈ d.support, 𝔭.asIdeal.height = 1) :
    ((d.erase (verticalPrime O)).prod fun 𝔭 n ↦ 𝔭.asIdeal ^ n) =
      Ideal.span {(((d.erase (verticalPrime O)).prod
        fun 𝔭 n ↦ 𝔭.distinguishedGenerator ^ n : O[X]) : O⟦X⟧)} := by
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  have hcoe := map_finsuppProd Polynomial.coeToPowerSeries.ringHom (d.erase (verticalPrime O))
    fun 𝔭 n ↦ 𝔭.distinguishedGenerator ^ n
  simp only [Polynomial.coeToPowerSeries.ringHom_apply, Polynomial.coe_pow] at hcoe
  rw [hcoe, Finsupp.prod, Finsupp.prod, ← Ideal.prod_span_singleton]
  refine Finset.prod_congr rfl fun 𝔭 h𝔭 ↦ ?_
  rw [Finsupp.support_erase, Finset.mem_erase] at h𝔭
  rw [← Ideal.span_singleton_pow, PrimeSpectrum.span_distinguishedGenerator hϖ (hd 𝔭 h𝔭.2)
    fun h ↦ h𝔭.1 (PrimeSpectrum.ext (h.trans (verticalPrime_asIdeal_eq_span hϖ).symm))]

/-- **The characteristic ideal from `μ` and `F_M`.** Over a complete discrete valuation ring with
uniformiser `ϖ`, the characteristic ideal of a torsion `O⟦X⟧`-module `M` is generated by
`ϖ ^ μ(M) F_M`: the vertical prime `(ϖ)` occurs with multiplicity `μ(M)`, and every other
height-one prime is generated by its distinguished generator. -/
theorem charIdeal_eq_span_C_pow_mul_charPoly (hϖ : Irreducible ϖ)
    (hM : Module.IsTorsion O⟦X⟧ M) :
    charIdeal O⟦X⟧ M = Ideal.span {C (ϖ ^ muInvariant O M) * (charPoly O M : O⟦X⟧)} := by
  classical
  have hd : ∀ 𝔭 ∈ (charDivisor O⟦X⟧ M).support, 𝔭.asIdeal.height = 1 := fun 𝔭 h𝔭 ↦ by
    by_contra hne
    exact Finsupp.mem_support_iff.mp h𝔭 (charDivisor_apply_of_height_ne_one hne)
  -- Split off the vertical prime from the divisor; the remaining primes are horizontal.
  rw [charIdeal_def, ← Finsupp.mul_prod_erase' _ (verticalPrime O) _ fun _ ↦ pow_zero _,
    prod_erase_verticalPrime_asIdeal_pow_eq_span hd, ← charPoly_eq_prod_erase_verticalPrime hM,
    ← muInvariant_eq_charDivisor hM, verticalPrime_asIdeal_eq_span hϖ, Ideal.span_singleton_pow,
    Ideal.span_singleton_mul_span_singleton, map_pow]

end Elementary

-- Over `Λ = ℤ_p⟦T⟧`: the vertical factor `Λ ⧸ (p)` and the finite module `Λ ⧸ (p, T)` have
-- characteristic polynomial `1` and `λ = 0`.
example (p : ℕ) [Fact p.Prime] :
    charPoly ℤ_[p] (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p])}) = 1 ∧
      lambdaInvariant ℤ_[p] (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p])}) = 0 ∧
        charPoly ℤ_[p] (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p]), X}) = 1 ∧
          lambdaInvariant ℤ_[p] (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p]), X}) = 0 := by
  have hfin : IsPseudoNull ℤ_[p]⟦X⟧ (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p]), X}) :=
    (isPseudoNull_quotient_iff _).mpr fun 𝔮 h𝔮 ↦
      PadicInt.one_lt_height_of_C_p_mem_of_X_mem (h𝔮 (Ideal.subset_span (by simp)))
        (h𝔮 (Ideal.subset_span (by simp)))
  have hϖ := PadicInt.irreducible_p (p := p)
  refine ⟨?_, ?_, hfin.charPoly_eq_one, hfin.lambdaInvariant_eq_zero⟩
  · have h := charPoly_quotient_span_C_pow hϖ 1
    rwa [pow_one] at h
  · have h := lambdaInvariant_quotient_span_C_pow hϖ 1
    rwa [pow_one] at h

-- The module `Λ ⧸ (T² + pT + p)`, cut out by an Eisenstein polynomial, has characteristic
-- polynomial `T² + pT + p` and `λ = 2`.
example (p : ℕ) [Fact p.Prime] :
    let F : ℤ_[p][X] := .X ^ 2 + .C (p : ℤ_[p]) * .X + .C (p : ℤ_[p])
    charPoly ℤ_[p] (ℤ_[p]⟦X⟧ ⧸ Ideal.span {(F : ℤ_[p]⟦X⟧)}) = F ∧
      lambdaInvariant ℤ_[p] (ℤ_[p]⟦X⟧ ⧸ Ideal.span {(F : ℤ_[p]⟦X⟧)}) = 2 := by
  intro F
  have hp : (p : ℤ_[p]) ∈ maximalIdeal ℤ_[p] := by
    rw [PadicInt.maximalIdeal_eq_span_p]
    exact Ideal.mem_span_singleton_self _
  have hE : F.IsEisensteinAt (maximalIdeal ℤ_[p]) :=
    TauCeti.isEisensteinAt_X_pow_add_C_mul_X_add_C_of_irreducible hp PadicInt.irreducible_p le_rfl
  have hdeg : F.natDegree = 2 := Polynomial.natDegree_X_pow_add_C_mul_X_add_C _ _ le_rfl
  have hmon : F.Monic := by
    rw [Polynomial.Monic, Polynomial.leadingCoeff, hdeg]
    simp [F]
  have hF : F.IsDistinguishedAt (maximalIdeal ℤ_[p]) := ⟨hE.isWeaklyEisensteinAt, hmon⟩
  have hirr : Irreducible F := hE.irreducible (maximalIdeal.isMaximal _).isPrime hmon.isPrimitive
    (by rw [hdeg]; norm_num)
  have h := charPoly_quotient_span_pow hF hirr 1
  have h' := lambdaInvariant_quotient_span_pow hF hirr 1
  rw [pow_one] at h h'
  exact ⟨h, by rw [h', one_mul, hdeg]⟩

end TauCeti.Iwasawa
