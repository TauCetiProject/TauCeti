module

public import TauCeti.RingTheory.Iwasawa.LambdaInvariant

import Mathlib.RingTheory.Polynomial.Eisenstein.Distinguished
import TauCeti.Algebra.Module.Torsion.Basic
import TauCeti.RingTheory.PowerSeries.Order

/-!
# The Iwasawa invariants under twisting by automorphisms of `O⟦X⟧`

Let `O` be a discrete valuation ring and `Λ = O⟦X⟧`. An Iwasawa module is a module over the
completed group algebra `O⟦Γ⟧` of `Γ ≅ ℤ_p`, read as a `Λ`-module through a topological generator
`γ` of `Γ` and the coordinate `X = γ - 1`. Replacing `γ` by another generator `γ ^ u`,
`u ∈ ℤ_pˣ`, changes the coordinate by the `O`-algebra automorphism `σ_u` of `Λ` with
`σ_u(X) = (1 + X) ^ u - 1`, and the module read through the new generator is the old one with
scalars twisted by `σ_u`. The independence of the invariants from the generator is therefore an
invariance statement for semilinear equivalences along automorphisms of `Λ`.

This file proves that invariance for every ring automorphism `σ` of `Λ` that fixes the vertical
prime `(ϖ)`, for instance any automorphism fixing the constants
(`comap_verticalPrime_of_comp_C`). Let `e : N ≃ M` be a `σ`-semilinear equivalence. Then

* `μ(N) = μ(M)`: `σ` matches the vertical primes, and the characteristic divisor is transported
  along `σ` (`LinearEquiv.charDivisor_apply_comap`);
* the characteristic polynomials generate ideals matched by `σ`, `(F_N) = σ⁻¹((F_M))`, although
  `F_N` and `F_M` differ in general;
* `λ(N) = λ(M)`: the degree of a distinguished polynomial is the order of its reduction modulo the
  maximal ideal of `O`, and `σ` preserves this order (`PowerSeries.order_map_le_order_map_apply`).

The rank over `Λ` is preserved by Mathlib's `rank_eq_of_equiv_equiv`, recorded as an example at the
end of the file.

## Main results

* `TauCeti.Iwasawa.comap_verticalPrime_of_comp_C`: an automorphism of `O⟦X⟧` fixing the constants
  fixes the vertical prime.
* `TauCeti.Iwasawa.order_map_mk_apply_of_comap_verticalPrime`: an automorphism fixing the vertical
  prime preserves the order of reductions modulo the maximal ideal of `O`.
* `LinearEquiv.muInvariant_eq_of_comap_verticalPrime`: semilinear equivalences along automorphisms
  fixing the vertical prime preserve `μ`.
* `LinearEquiv.span_charPoly_eq_comap`: they match the ideals generated by the characteristic
  polynomials.
* `LinearEquiv.lambdaInvariant_eq_of_comap_verticalPrime`: they preserve `λ`.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, (5.3.9), Remark 1.
-/

public section

open IsLocalRing PowerSeries Submodule
open scoped Polynomial PowerSeries

namespace TauCeti.Iwasawa

variable {O : Type*} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]

omit [IsDomain O] [IsDiscreteValuationRing O] in
/-- Pulling back an ideal along a ring automorphism `σ` is pushing it forward along `σ⁻¹`. -/
private theorem comap_eq_map_of_ringHomInvPair {σ σ' : O⟦X⟧ →+* O⟦X⟧} [RingHomInvPair σ σ']
    (I : Ideal O⟦X⟧) : I.comap σ = I.map σ' :=
  Ideal.comap_symm (RingHomInvPair.toRingEquiv σ σ').symm

/-- **An automorphism fixing the constants fixes the vertical prime.** If a ring automorphism `σ` of
`O⟦X⟧` fixes the constant series, it maps the vertical prime `(ϖ)` onto itself. This applies to the
coordinate changes `X ↦ (1 + X) ^ u - 1` of a change of topological generator. -/
theorem comap_verticalPrime_of_comp_C
    {σ σ' : O⟦X⟧ →+* O⟦X⟧} [RingHomInvPair σ σ']
    (hσ : σ.comp C = C) :
    PrimeSpectrum.comap σ (verticalPrime O) = verticalPrime O := by
  have hσ' : σ'.comp C = C := RingHom.ext fun a ↦ by
    have h := congrArg σ' (RingHom.congr_fun hσ a)
    rw [RingHom.comp_apply, RingHomInvPair.comp_apply_eq] at h
    rw [RingHom.comp_apply, ← h]
  ext1
  rw [PrimeSpectrum.comap_asIdeal, verticalPrime_asIdeal, comap_eq_map_of_ringHomInvPair,
    Ideal.map_map, hσ']

/-- The vertical prime is fixed by `σ⁻¹` once it is fixed by `σ`. -/
private theorem comap_verticalPrime_symm {σ σ' : O⟦X⟧ →+* O⟦X⟧} [RingHomInvPair σ σ']
    (hσ : PrimeSpectrum.comap σ (verticalPrime O) = verticalPrime O) :
    PrimeSpectrum.comap σ' (verticalPrime O) = verticalPrime O := by
  conv_lhs => rw [← hσ, ← PrimeSpectrum.comap_comp_apply, RingHomInvPair.comp_eq₂,
    PrimeSpectrum.comap_id]

/-- An automorphism of `O⟦X⟧` fixing the vertical prime does not lower the order of the reduction of
a power series modulo the maximal ideal of `O`. -/
private theorem order_map_mk_le_order_map_mk_apply
    {σ σ' : O⟦X⟧ →+* O⟦X⟧} [RingHomInvPair σ σ']
    (hσ : PrimeSpectrum.comap σ (verticalPrime O) = verticalPrime O) (f : O⟦X⟧) :
    (map (Ideal.Quotient.mk (maximalIdeal O)) f).order ≤
      (map (Ideal.Quotient.mk (maximalIdeal O)) (σ f)).order := by
  refine order_map_le_order_map_apply Ideal.Quotient.mk_surjective (fun g hg ↦ ?_) ?_ f
  · rw [map_mk_eq_zero_iff_mem_verticalPrime] at hg ⊢
    rwa [← hσ] at hg
  · -- `σ X` is not a unit, since `X` is not, so its constant coefficient lies in `maximalIdeal O`.
    refine Ideal.Quotient.eq_zero_iff_mem.mpr ((mem_maximalIdeal _).mpr fun hu ↦ ?_)
    have hX : IsUnit (σ' (σ X)) := (isUnit_iff_constantCoeff.mpr hu).map σ'
    rw [RingHomInvPair.comp_apply_eq, isUnit_iff_constantCoeff, constantCoeff_X] at hX
    exact not_isUnit_zero hX

/-- **Automorphisms fixing `(ϖ)` preserve the Weierstrass degree.** A ring automorphism of `O⟦X⟧`
fixing the vertical prime preserves the order of the reduction of a power series modulo the maximal
ideal of `O`; for a series with nonzero reduction this order is the degree of its distinguished
factor. -/
theorem order_map_mk_apply_of_comap_verticalPrime
    {σ σ' : O⟦X⟧ →+* O⟦X⟧} [RingHomInvPair σ σ'] [RingHomInvPair σ' σ]
    (hσ : PrimeSpectrum.comap σ (verticalPrime O) = verticalPrime O) (f : O⟦X⟧) :
    (map (Ideal.Quotient.mk (maximalIdeal O)) (σ f)).order =
      (map (Ideal.Quotient.mk (maximalIdeal O)) f).order := by
  refine le_antisymm ?_ (order_map_mk_le_order_map_mk_apply hσ f)
  have h := order_map_mk_le_order_map_mk_apply (comap_verticalPrime_symm hσ) (σ f)
  rwa [RingHomInvPair.comp_apply_eq] at h

variable {N M : Type*} [AddCommGroup N] [Module O⟦X⟧ N] [AddCommGroup M] [Module O⟦X⟧ M]

/-- **Invariance of `μ` under a change of variable.** Let `σ` be a ring automorphism of `O⟦X⟧`
fixing the vertical prime `(ϖ)`, and `e : N ≃ M` a `σ`-semilinear equivalence of `O⟦X⟧`-modules.
Then `μ(N) = μ(M)`. A change of topological generator is such a twist, along an automorphism
fixing the constants. -/
theorem _root_.LinearEquiv.muInvariant_eq_of_comap_verticalPrime
    {σ σ' : O⟦X⟧ →+* O⟦X⟧} [RingHomInvPair σ σ'] [RingHomInvPair σ' σ]
    (hσ : PrimeSpectrum.comap σ (verticalPrime O) = verticalPrime O) (e : N ≃ₛₗ[σ] M) :
    muInvariant O N = muInvariant O M := by
  rw [muInvariant_def, muInvariant_def,
    ← (e.ofSubmodules _ _ e.map_torsion).charDivisor_apply_comap, hσ]

/-- **The characteristic polynomial under a change of variable.** Let `O` be a complete discrete
valuation ring, `σ` a ring automorphism of `O⟦X⟧` fixing the vertical prime `(ϖ)`, and `e : N ≃ M`
a `σ`-semilinear equivalence of `O⟦X⟧`-modules. Then the characteristic polynomials generate ideals
matched by `σ`: `(F_N) = σ⁻¹((F_M))`. The polynomials themselves differ in general: `F_N` is the
distinguished polynomial of the Weierstrass factorization of `σ⁻¹(F_M)`. -/
theorem _root_.LinearEquiv.span_charPoly_eq_comap [IsAdicComplete (maximalIdeal O) O]
    {σ σ' : O⟦X⟧ →+* O⟦X⟧} [RingHomInvPair σ σ'] [RingHomInvPair σ' σ]
    (hσ : PrimeSpectrum.comap σ (verticalPrime O) = verticalPrime O) (e : N ≃ₛₗ[σ] M) :
    Ideal.span {(charPoly O N : O⟦X⟧)} = (Ideal.span {(charPoly O M : O⟦X⟧)}).comap σ := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  -- Compare the characteristic ideals `(ϖ ^ μ F)` of the torsion submodules, then cancel the
  -- common factor `(ϖ) ^ μ`, which `σ` fixes.
  have h := (e.ofSubmodules _ _ e.map_torsion).charIdeal_eq_comap
  have hV : (verticalPrime O).asIdeal.comap σ = (verticalPrime O).asIdeal :=
    congrArg PrimeSpectrum.asIdeal hσ
  rw [charIdeal_eq_span_C_pow_mul_charPoly (M := torsion O⟦X⟧ N) hϖ torsion_isTorsion,
    charIdeal_eq_span_C_pow_mul_charPoly (M := torsion O⟦X⟧ M) hϖ torsion_isTorsion] at h
  rw [charPoly_torsion, charPoly_torsion, muInvariant_torsion, muInvariant_torsion,
    e.muInvariant_eq_of_comap_verticalPrime hσ] at h
  have ha : Ideal.span {C ϖ ^ muInvariant O M} = (verticalPrime O).asIdeal ^ muInvariant O M := by
    rw [verticalPrime_asIdeal_eq_span hϖ, Ideal.span_singleton_pow]
  rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton, map_pow,
    ha, comap_eq_map_of_ringHomInvPair, Ideal.map_mul, Ideal.map_pow,
    ← comap_eq_map_of_ringHomInvPair (σ := σ), ← comap_eq_map_of_ringHomInvPair (σ := σ), hV,
    ← ha] at h
  exact (Ideal.span_singleton_mul_right_inj (pow_ne_zero _ (prime_C_iff.mpr hϖ.prime).ne_zero)).mp h

/-- **Invariance of `λ` under a change of variable.** Let `O` be a complete discrete valuation ring,
`σ` a ring automorphism of `O⟦X⟧` fixing the vertical prime `(ϖ)`, and `e : N ≃ M` a
`σ`-semilinear equivalence of `O⟦X⟧`-modules. Then `λ(N) = λ(M)`, although `F_N` and `F_M` differ
in general (`LinearEquiv.span_charPoly_eq_comap`). -/
theorem _root_.LinearEquiv.lambdaInvariant_eq_of_comap_verticalPrime
    [IsAdicComplete (maximalIdeal O) O]
    {σ σ' : O⟦X⟧ →+* O⟦X⟧} [RingHomInvPair σ σ'] [RingHomInvPair σ' σ]
    (hσ : PrimeSpectrum.comap σ (verticalPrime O) = verticalPrime O) (e : N ≃ₛₗ[σ] M) :
    lambdaInvariant O N = lambdaInvariant O M := by
  have h := e.span_charPoly_eq_comap hσ
  rw [comap_eq_map_of_ringHomInvPair, Ideal.map_span, Set.image_singleton,
    Ideal.span_singleton_eq_span_singleton] at h
  obtain ⟨u, hu⟩ := h
  -- Both degrees are orders of reductions modulo `maximalIdeal O`, and `σ⁻¹` preserves these.
  have hN := isDistinguishedAt_charPoly.coe_natDegree_eq_order_map _ _
    (fun hu' ↦ (mem_maximalIdeal _).mp hu' (isUnit_iff_constantCoeff.mp u.isUnit)) hu.symm
  have hM := (isDistinguishedAt_charPoly (O := O) (M := M)).coe_natDegree_eq_order_map _ 1
    (by simp) (mul_one _).symm
  rw [lambdaInvariant_def, lambdaInvariant_def, ← Nat.cast_inj (R := ℕ∞), hN, hM,
    order_map_mk_apply_of_comap_verticalPrime (comap_verticalPrime_symm hσ)]

-- The rank over `O⟦X⟧` is preserved by any semilinear equivalence along a ring automorphism.
example {σ σ' : O⟦X⟧ →+* O⟦X⟧} [RingHomInvPair σ σ'] [RingHomInvPair σ' σ] {P Q : Type}
    [AddCommGroup P] [Module O⟦X⟧ P] [AddCommGroup Q] [Module O⟦X⟧ Q] (e : P ≃ₛₗ[σ] Q) :
    Module.rank O⟦X⟧ P = Module.rank O⟦X⟧ Q :=
  rank_eq_of_equiv_equiv σ e.toAddEquiv (RingHomInvPair.toRingEquiv σ σ').bijective e.map_smulₛₗ

end TauCeti.Iwasawa
