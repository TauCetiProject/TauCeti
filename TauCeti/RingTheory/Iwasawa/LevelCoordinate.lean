/-!
# The level coordinates of the Iwasawa algebra `O⟦T⟧`

Let `p` be a prime and let `O` be a local ring, complete for its maximal ideal `𝔪`, in which `p`
is not a unit (`hp : (p : O) ∈ 𝔪`, equivalently, the residue field has characteristic `p`); the
integers of a finite extension of `ℚ_p` are the example to keep in mind. For every `n` there is a
unique `O`-algebra map

  `levelCoordinate hp n : O⟦T⟧ →ₐ[O] O[ℤ/pⁿ]`,  `T ↦ [1] - 1`,

from the Iwasawa algebra to the group algebra of the cyclic group of order `pⁿ`. It is surjective
with kernel the principal ideal generated by

  `ω_n = (1 + T) ^ pⁿ - 1`,

so that `O⟦T⟧ ⧸ (ω_n) ≃ₐ[O] O[ℤ/pⁿ]` (`TauCeti.Iwasawa.levelEquiv`), and the level maps are
compatible with the projections `O[ℤ/pⁿ] → O[ℤ/pᵐ]` for `m ≤ n`. Over a noetherian `O` the ideals
`(ω_n)` meet in zero, so the assembled map `O⟦T⟧ → ∏ₙ O[ℤ/pⁿ]` is injective. These are the
finite levels of the identification of `O⟦T⟧` with the completed group algebra `O⟦ℤ_p⟧`, with
the topological generator `1 ∈ ℤ_p` corresponding to `1 + T`.

The construction composes three presentations. Since `p ∈ 𝔪`, the polynomial `ω_n` is
distinguished at `𝔪`, so Mathlib's Weierstrass division identifies `O⟦T⟧ ⧸ (ω_n)` with
`O[T] ⧸ (ω_n)` (`Polynomial.IsDistinguishedAt.algEquivQuotient`); and evaluation at `[1] - 1`
presents `O[ℤ/pⁿ]` as `O[T] ⧸ ((1 + T) ^ pⁿ - 1)`
(`TauCeti.MonoidAlgebra.ker_aeval_of_sub_one`). Uniqueness needs no continuity: an `O`-algebra
map out of `O⟦T⟧` that kills a distinguished polynomial is determined by the image of `T`
(`Polynomial.IsDistinguishedAt.algHom_ext`), because Weierstrass division writes every series as a
multiple of that polynomial plus a polynomial.

The hypothesis that `p` lies in the maximal ideal is essential: over `ℚ`, where `p` is a unit,
`ω_n` generates the ideal `(T)` for every `n`, and for `n > 0` no ring map `ℚ⟦T⟧ → ℚ[ℤ/pⁿ]` sends
`T` to `[1] - 1`, since `[1] - 1` is not nilpotent.

## Main definitions

* `TauCeti.Iwasawa.levelEquiv hp n`: the `O`-algebra isomorphism
  `O⟦T⟧ ⧸ ((1 + T) ^ pⁿ - 1) ≃ₐ[O] O[ℤ/pⁿ]` sending the class of `T` to `[1] - 1`.
* `TauCeti.Iwasawa.levelCoordinate hp n`: the level map `O⟦T⟧ →ₐ[O] O[ℤ/pⁿ]`.
* `TauCeti.Iwasawa.levelTransition p O h`: the projection `O[ℤ/pⁿ] →ₐ[O] O[ℤ/pᵐ]` for `m ≤ n`.
* `TauCeti.Iwasawa.iwasawaCoordinate hp`: the product of the level maps,
  `O⟦T⟧ →ₐ[O] ∏ₙ O[ℤ/pⁿ]`.

## Main results

* `PowerSeries.algHom_coe_eq_aeval`, `Polynomial.IsDistinguishedAt.algHom_ext`: an algebra map
  out of `A⟦X⟧` is evaluation at the image of `X` on polynomials, and, over an `I`-adically
  complete `A`, is determined by the image of `X` once it kills a polynomial distinguished at `I`.
* `TauCeti.Iwasawa.levelCoordinate_X`, `TauCeti.Iwasawa.levelCoordinate_one_add_X_pow`: `T` maps
  to `[1] - 1` and `(1 + T) ^ k` to the group element `[k]`.
* `TauCeti.Iwasawa.levelCoordinate_unique`: the level map is the only `O`-algebra map with
  `T ↦ [1] - 1`.
* `TauCeti.Iwasawa.levelCoordinate_surjective`, `TauCeti.Iwasawa.ker_levelCoordinate`,
  `TauCeti.Iwasawa.levelCoordinate_eq_zero_iff`: the level map is surjective with kernel
  `((1 + T) ^ pⁿ - 1)`.
* `TauCeti.Iwasawa.levelCoordinate_transition`: compatibility with `ℤ/pⁿ → ℤ/pᵐ` for `m ≤ n`.
* `TauCeti.Iwasawa.levelCoordinate_zero`: at level zero the coordinate is the constant coefficient.
* `TauCeti.Iwasawa.iInf_span_one_add_X_pow_sub_one_eq_bot`,
  `TauCeti.Iwasawa.iwasawaCoordinate_injective`: over a noetherian `O`, `⋂ₙ (ω_n) = 0`, so the
  product of the level maps is injective.
* `TauCeti.Iwasawa.one_add_X_pow_sub_one_eq_X_pow`: in characteristic `p`, `ω_n = T ^ pⁿ`.

The examples at the end of the file check the construction over `O = ℤ_p`: `ω_n` maps to zero at
level `n`, while for `p = 2` and `n = 1` the image `t = [1] - 1` of `T` satisfies `t² = -2t ≠ 0`,
so the kernel at level `1` is not `(T²)`.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, 2nd ed., Proposition
  (5.3.5), pp. 290–291.
* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., Theorem 7.1.
-/

public section

open IsLocalRing PowerSeries

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- An `A`-algebra map out of `A⟦X⟧` restricts on polynomials to evaluation at the image of `X`. -/
theorem PowerSeries.algHom_coe_eq_aeval (φ : A⟦X⟧ →ₐ[A] B) (f : Polynomial A) :
    φ (f : A⟦X⟧) = Polynomial.aeval (φ X) f := by
  have : φ.comp (Polynomial.coeToPowerSeries.algHom A) = Polynomial.aeval (φ X) :=
    Polynomial.algHom_ext (by simp)
  exact DFunLike.congr_fun this f

namespace Polynomial.IsDistinguishedAt

variable {g : A[X]} {I : Ideal A}

/-- **`A`-algebra maps out of `A⟦X⟧` killing a distinguished polynomial are determined by the
image of `X`.** Let `A` be `I`-adically complete and `g` distinguished at `I`. If two `A`-algebra
maps `A⟦X⟧ → B` agree on `X` and one of them kills `g`, they are equal. No continuity is
assumed: Weierstrass division writes every series as a multiple of `g` plus a polynomial. -/
theorem algHom_ext (H : g.IsDistinguishedAt I) [IsAdicComplete I A] {φ ψ : A⟦X⟧ →ₐ[A] B}
    (hg : φ (g : A⟦X⟧) = 0) (hX : φ PowerSeries.X = ψ PowerSeries.X) : φ = ψ := by
  have hg' : ψ (g : A⟦X⟧) = 0 := by
    rwa [PowerSeries.algHom_coe_eq_aeval, ← hX, ← PowerSeries.algHom_coe_eq_aeval]
  refine AlgHom.ext fun F ↦ ?_
  -- Weierstrass division: `F = g * q + r` with `r` a polynomial.
  obtain ⟨-, hF⟩ := H.isWeierstrassDivisorAt'.isWeierstrassDivisionAt_div_mod F
  rw [hF]
  simp only [map_add, map_mul, hg, hg', zero_mul, zero_add, PowerSeries.algHom_coe_eq_aeval, hX]

end Polynomial.IsDistinguishedAt

namespace TauCeti.Iwasawa

variable {p : ℕ} [Fact p.Prime] {O : Type*} [CommRing O]

section CharP

variable (p O) in
/-- **`ω_n = T ^ pⁿ` in characteristic `p`.** Over a ring of characteristic `p` the cyclotomic
series `(1 + T) ^ pⁿ - 1` is the monomial `T ^ pⁿ`, by the Frobenius identity. -/
theorem one_add_X_pow_sub_one_eq_X_pow [CharP O p] (n : ℕ) :
    (1 + X : O⟦X⟧) ^ p ^ n - 1 = X ^ p ^ n := by
  have : CharP O⟦X⟧ p := charP_of_injective_ringHom C_injective p
  rw [add_pow_char_pow, one_pow, add_sub_cancel_left]

end CharP

variable [IsLocalRing O] (hp : (p : O) ∈ maximalIdeal O) [IsAdicComplete (maximalIdeal O) O]

/-- **The finite levels of the Iwasawa algebra.** For a local ring `O`, complete for its maximal
ideal, in which `p` is not a unit, the quotient of `O⟦T⟧` by `ω_n = (1 + T) ^ pⁿ - 1` is the
group algebra `O[ℤ/pⁿ]`, the class of `T` corresponding to `[1] - 1`. -/
noncomputable def levelEquiv (n : ℕ) :
    (O⟦X⟧ ⧸ Ideal.span {(1 + X : O⟦X⟧) ^ p ^ n - 1}) ≃ₐ[O]
      MonoidAlgebra O (Multiplicative (ZMod (p ^ n))) :=
  (Ideal.quotientEquivAlgOfEq O (by simp)).trans <|
    (TauCeti.Polynomial.isDistinguishedAt_one_add_X_pow_sub_one Fact.out
      hp n).algEquivQuotient.symm.trans <|
      (Ideal.quotientEquivAlgOfEq O (by
        rw [TauCeti.MonoidAlgebra.ker_aeval_of_sub_one mem_zpowers_ofAdd_one,
          Nat.card_congr Multiplicative.toAdd, Nat.card_zmod])).trans <|
        Ideal.quotientKerAlgEquivOfSurjective
          (TauCeti.MonoidAlgebra.aeval_of_sub_one_surjective mem_zpowers_ofAdd_one)

/-- **The level-`n` Iwasawa coordinate** `O⟦T⟧ →ₐ[O] O[ℤ/pⁿ]`, `T ↦ [1] - 1`: the quotient map
by `ω_n = (1 + T) ^ pⁿ - 1` followed by `levelEquiv`. -/
noncomputable def levelCoordinate (n : ℕ) :
    O⟦X⟧ →ₐ[O] MonoidAlgebra O (Multiplicative (ZMod (p ^ n))) :=
  (levelEquiv hp n).toAlgHom.comp (Ideal.Quotient.mkₐ O _)

@[simp]
theorem levelEquiv_mk (n : ℕ) (F : O⟦X⟧) :
    levelEquiv hp n (Ideal.Quotient.mk _ F) = levelCoordinate hp n F :=
  (rfl)

/-- On polynomials, the level coordinate is evaluation at `[1] - 1`. -/
theorem levelCoordinate_coe (n : ℕ) (f : Polynomial O) :
    levelCoordinate hp n (f : O⟦X⟧) =
      Polynomial.aeval (MonoidAlgebra.single (Multiplicative.ofAdd 1) 1 - 1) f := by
  have H := TauCeti.Polynomial.isDistinguishedAt_one_add_X_pow_sub_one Fact.out hp n
  have hf : H.algEquivQuotient.symm (Ideal.Quotient.mk _ (f : O⟦X⟧)) = Ideal.Quotient.mk _ f := by
    rw [AlgEquiv.symm_apply_eq, Polynomial.IsDistinguishedAt.algEquivQuotient_apply]
    simp
  simp [levelCoordinate, levelEquiv, Ideal.quotientEquivAlgOfEq_mk, hf,
    Ideal.quotientKerAlgEquivOfSurjective_mk]

/-- The level coordinate sends `T` to `[1] - 1`. -/
@[simp]
theorem levelCoordinate_X (n : ℕ) :
    levelCoordinate hp n X = MonoidAlgebra.single (Multiplicative.ofAdd 1) 1 - 1 := by
  simpa using levelCoordinate_coe hp n Polynomial.X

/-- The level coordinate sends a constant `a` to `a · [0]`. -/
@[simp]
theorem levelCoordinate_C (n : ℕ) (a : O) :
    levelCoordinate hp n (C a) = MonoidAlgebra.single 1 a := by
  simpa using levelCoordinate_coe hp n (Polynomial.C a)

/-- The level coordinate sends `(1 + T) ^ k` to the group element `[k]`. -/
@[simp]
theorem levelCoordinate_one_add_X_pow (n k : ℕ) :
    levelCoordinate hp n ((1 + X) ^ k) =
      MonoidAlgebra.single (Multiplicative.ofAdd (k : ZMod (p ^ n))) 1 := by
  rw [map_pow, map_add, map_one, levelCoordinate_X, add_sub_cancel, MonoidAlgebra.single_pow,
    one_pow, ← ofAdd_nsmul, nsmul_one]

/-- **Uniqueness of the level coordinate.** An `O`-algebra map `O⟦T⟧ → O[ℤ/pⁿ]` sending `T` to
`[1] - 1` is the level coordinate; no continuity is assumed. -/
theorem levelCoordinate_unique (n : ℕ)
    {φ : O⟦X⟧ →ₐ[O] MonoidAlgebra O (Multiplicative (ZMod (p ^ n)))}
    (hφ : φ X = MonoidAlgebra.single (Multiplicative.ofAdd 1) 1 - 1) :
    φ = levelCoordinate hp n := by
  have H := TauCeti.Polynomial.isDistinguishedAt_one_add_X_pow_sub_one Fact.out hp n
  refine H.algHom_ext ?_ (by rw [hφ, levelCoordinate_X])
  have h := TauCeti.MonoidAlgebra.aeval_of_sub_one_one_add_X_pow_card_sub_one_eq_zero (R := O)
    (Multiplicative.ofAdd (1 : ZMod (p ^ n)))
  rwa [Nat.card_congr Multiplicative.toAdd, Nat.card_zmod, MonoidAlgebra.of_apply, ← hφ,
    ← PowerSeries.algHom_coe_eq_aeval] at h

/-- The level coordinate is surjective. -/
theorem levelCoordinate_surjective (n : ℕ) : Function.Surjective (levelCoordinate hp n) :=
  (levelEquiv hp n).surjective.comp Ideal.Quotient.mk_surjective

/-- **The kernel of the level coordinate** is the principal ideal generated by
`ω_n = (1 + T) ^ pⁿ - 1`. -/
theorem ker_levelCoordinate (n : ℕ) :
    RingHom.ker (levelCoordinate hp n) = Ideal.span {(1 + X : O⟦X⟧) ^ p ^ n - 1} := by
  ext F
  rw [RingHom.mem_ker, ← levelEquiv_mk, map_eq_zero_iff _ (levelEquiv hp n).injective,
    Ideal.Quotient.eq_zero_iff_mem]

/-- An element of `O⟦T⟧` maps to zero at level `n` exactly when `ω_n = (1 + T) ^ pⁿ - 1` divides
it. -/
theorem levelCoordinate_eq_zero_iff (n : ℕ) (F : O⟦X⟧) :
    levelCoordinate hp n F = 0 ↔ (1 + X : O⟦X⟧) ^ p ^ n - 1 ∣ F := by
  rw [← RingHom.mem_ker, ker_levelCoordinate, Ideal.mem_span_singleton]

variable (p O) in
/-- The projection `O[ℤ/pⁿ] → O[ℤ/pᵐ]` induced by reduction `ℤ/pⁿ → ℤ/pᵐ`, for `m ≤ n`. -/
noncomputable def levelTransition {m n : ℕ} (h : m ≤ n) :
    MonoidAlgebra O (Multiplicative (ZMod (p ^ n))) →ₐ[O]
      MonoidAlgebra O (Multiplicative (ZMod (p ^ m))) :=
  MonoidAlgebra.mapDomainAlgHom O O
    (ZMod.castHom (pow_dvd_pow p h) (ZMod (p ^ m))).toAddMonoidHom.toMultiplicative

/-- **Compatibility of the level coordinates.** For `m ≤ n`, the level-`n` coordinate followed by
the projection `O[ℤ/pⁿ] → O[ℤ/pᵐ]` is the level-`m` coordinate. -/
theorem levelCoordinate_transition {m n : ℕ} (h : m ≤ n) :
    (levelTransition p O h).comp (levelCoordinate hp n) = levelCoordinate hp m :=
  levelCoordinate_unique hp m (by
    rw [AlgHom.comp_apply, levelCoordinate_X, map_sub, map_one (levelTransition p O h)]
    simp [levelTransition, ZMod.cast_one (pow_dvd_pow p h)])

/-- At level zero the coordinate is the constant coefficient, as an element of
`O[ℤ/1] = O[1]`. -/
theorem levelCoordinate_zero (F : O⟦X⟧) :
    levelCoordinate hp 0 F = MonoidAlgebra.single 1 (constantCoeff F) := by
  have : Subsingleton (ZMod (p ^ 0)) := by rw [pow_zero]; infer_instance
  have hX : levelCoordinate hp 0 X = 0 := by
    rw [levelCoordinate_X, Subsingleton.elim (Multiplicative.ofAdd (1 : ZMod (p ^ 0))) 1,
      MonoidAlgebra.one_def, sub_self]
  conv_lhs => rw [eq_X_mul_shift_add_const F]
  rw [map_add, map_mul, hX, zero_mul, zero_add, levelCoordinate_C]

/-- The product of the level coordinates, `O⟦T⟧ →ₐ[O] ∏ₙ O[ℤ/pⁿ]`. -/
noncomputable def iwasawaCoordinate :
    O⟦X⟧ →ₐ[O] ∀ n : ℕ, MonoidAlgebra O (Multiplicative (ZMod (p ^ n))) :=
  AlgHom.pi (levelCoordinate hp)

@[simp]
theorem iwasawaCoordinate_apply (F : O⟦X⟧) (n : ℕ) :
    iwasawaCoordinate hp F n = levelCoordinate hp n F :=
  (rfl)

/-- The coordinates of `iwasawaCoordinate` are compatible with the projections
`O[ℤ/pⁿ] → O[ℤ/pᵐ]`. -/
theorem levelTransition_iwasawaCoordinate {m n : ℕ} (h : m ≤ n) (F : O⟦X⟧) :
    levelTransition p O h (iwasawaCoordinate hp F n) = iwasawaCoordinate hp F m := by
  simpa using DFunLike.congr_fun (levelCoordinate_transition hp h) F

include hp in
omit [Fact p.Prime] [IsAdicComplete (maximalIdeal O) O] in
/-- The series `ω_n = (1 + T) ^ pⁿ - 1` lies in the `(n + 1)`-st power of the maximal ideal of
`O⟦T⟧`: `ω_0 = T`, and `ω_{n+1} = ω_n · ∑_{i < p} (1 + T) ^ (i pⁿ)`, whose second factor has
constant coefficient `p`. -/
theorem one_add_X_pow_sub_one_mem_maximalIdeal_pow (n : ℕ) :
    (1 + X : O⟦X⟧) ^ p ^ n - 1 ∈ maximalIdeal O⟦X⟧ ^ (n + 1) := by
  have hmem (F : O⟦X⟧) (hF : constantCoeff F ∈ maximalIdeal O) : F ∈ maximalIdeal O⟦X⟧ := by
    rw [mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_constantCoeff]
    exact hF
  induction n with
  | zero => simpa using hmem X (by simp)
  | succ n ih =>
    rw [pow_succ p n, pow_mul, ← geom_sum_mul, pow_succ' (maximalIdeal O⟦X⟧)]
    refine Ideal.mul_mem_mul (hmem _ ?_) ih
    simpa using hp

include hp in
omit [Fact p.Prime] [IsAdicComplete (maximalIdeal O) O] in
/-- **The ideals `(ω_n)` meet in zero.** Over a noetherian local ring `O` in which `p` is not a
unit, no nonzero element of `O⟦T⟧` is divisible by every
`ω_n = (1 + T) ^ pⁿ - 1`, since `ω_n` lies in the `(n + 1)`-st power of the maximal ideal of the
noetherian local ring `O⟦T⟧`. -/
theorem iInf_span_one_add_X_pow_sub_one_eq_bot [IsNoetherianRing O] :
    ⨅ n : ℕ, Ideal.span {(1 + X : O⟦X⟧) ^ p ^ n - 1} = ⊥ := by
  refine eq_bot_iff.mpr <| (le_iInf fun n ↦ ?_).trans
    (Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal O⟦X⟧) (maximalIdeal.isMaximal _).ne_top).le
  refine (iInf_le _ n).trans ?_
  rw [Ideal.span_singleton_le_iff_mem]
  exact Ideal.pow_le_pow_right n.le_succ (one_add_X_pow_sub_one_mem_maximalIdeal_pow hp n)

/-- **The level coordinates separate points**: over a noetherian `O`, the product
`O⟦T⟧ → ∏ₙ O[ℤ/pⁿ]` of the level maps is injective. -/
theorem iwasawaCoordinate_injective [IsNoetherianRing O] :
    Function.Injective (iwasawaCoordinate hp) := by
  refine (injective_iff_map_eq_zero _).mpr fun F hF ↦ ?_
  have : F ∈ ⨅ n : ℕ, Ideal.span {(1 + X : O⟦X⟧) ^ p ^ n - 1} :=
    Ideal.mem_iInf.mpr fun n ↦ by
      rw [← ker_levelCoordinate hp, RingHom.mem_ker, ← iwasawaCoordinate_apply, hF, Pi.zero_apply]
  rwa [iInf_span_one_add_X_pow_sub_one_eq_bot, Ideal.mem_bot] at this

/-! ### Checks over `ℤ_p` -/

-- Over `ℤ_p`, the series `ω_n = (1 + T) ^ pⁿ - 1` maps to zero at level `n`.
example (p : ℕ) [Fact p.Prime] (n : ℕ) :
    levelCoordinate ((mem_maximalIdeal _).mpr (PadicInt.p_nonunit (p := p))) n
      ((1 + X) ^ p ^ n - 1) = 0 :=
  (levelCoordinate_eq_zero_iff _ n _).mpr dvd_rfl

-- For `p = 2` and `n = 1`, `t = [1] - 1` satisfies `t² = -2t ≠ 0` in `ℤ₂[ℤ/2]`, so `T²` is not in
-- the kernel `(ω₁) = (T² + 2T)`.
example :
    let φ := levelCoordinate ((mem_maximalIdeal _).mpr (PadicInt.p_nonunit (p := 2))) 1
    φ (X ^ 2) = -2 * φ X ∧ φ (X ^ 2) ≠ 0 := by
  intro φ
  set g : MonoidAlgebra ℤ_[2] (Multiplicative (ZMod (2 ^ 1))) :=
    MonoidAlgebra.single (Multiplicative.ofAdd 1) 1 with hg_def
  have hg : g * g = 1 := by
    have h11 : (1 + 1 : ZMod (2 ^ 1)) = 0 := by decide
    rw [hg_def, MonoidAlgebra.single_mul_single, ← ofAdd_add, h11, ofAdd_zero, mul_one,
      MonoidAlgebra.one_def]
  have h2 : φ (X ^ 2) = 2 - 2 * g := by
    rw [map_pow, levelCoordinate_X]
    linear_combination hg
  refine ⟨by rw [h2, levelCoordinate_X]; ring, fun h ↦ ?_⟩
  -- The coefficient of `[1]` in `2 - 2[1]` is `-2 ≠ 0`.
  have := congrArg (fun x ↦ x.coeff (Multiplicative.ofAdd 1)) (h2.symm.trans h)
  simp [hg_def] at this

end TauCeti.Iwasawa
