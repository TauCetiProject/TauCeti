/-!
# The structure theorem up to pseudo-isomorphism

Let `A` be a noetherian integrally closed domain. A finitely generated torsion `A`-module `M`
admits a pseudo-isomorphism `M → ∏ᵢ A ⧸ 𝔭ᵢ ^ nᵢ` onto a finite product of quotients by powers of
height-one primes, with every `nᵢ` positive. Over a regular local ring of dimension at most two,
such as the Iwasawa algebra `Λ = O⟦T⟧`, every finitely generated module `M` admits a
pseudo-isomorphism `M → Aʳ × ∏ᵢ A ⧸ 𝔭ᵢ ^ nᵢ`. This is the existence half of the structure theorem
for finitely generated modules over such rings; it is the form in which the theorem feeds the
structure theory of Iwasawa modules, where the height-one primes of `O⟦T⟧` are `(ϖ)` and the ideals
generated by irreducible distinguished polynomials.

The torsion case is local at the finitely many primes of height one in the support of `M`. At such
a prime `𝔭` the ring `A_𝔭` is a discrete valuation ring, so the structure theorem over a principal
ideal domain decomposes `M_𝔭` as a sum of quotients `A_𝔭 ⧸ (𝔭 A_𝔭) ^ k`; these are the
localizations of the `A ⧸ 𝔭 ^ k`, and the isomorphism lifts to a map `∏ A ⧸ 𝔭 ^ k → M` that is
bijective at `𝔭`. Summing these maps over the primes gives a pseudo-isomorphism onto `M`, since the
factor belonging to `𝔭` vanishes at every other prime of height at most one. Pseudo-isomorphisms
onto torsion modules can be reversed. The general case over a regular local ring of dimension at
most two combines this with the splitting off of the torsion submodule and the reflexive hull of
the torsion-free quotient.

## Main results

* `TauCeti.Iwasawa.exists_bijective_localizedModule_map_pi_quotient_pow`: at a prime `𝔭` of
  height one, a finitely generated torsion module `M` receives a map from some
  `∏ᵢ A ⧸ 𝔭 ^ nᵢ` that is bijective after localizing at `𝔭`.
* `TauCeti.Iwasawa.exists_isPseudoIsomorphism_pi_quotient_pow`: over a noetherian integrally
  closed domain, a finitely generated torsion module admits a pseudo-isomorphism to
  `∏ᵢ A ⧸ 𝔭ᵢ ^ nᵢ` with each `𝔭ᵢ` of height one and each `nᵢ` positive.
* `TauCeti.Iwasawa.exists_isPseudoIsomorphism_prod_pi_quotient_pow`: over a regular local ring of
  dimension at most two, a finitely generated module admits a pseudo-isomorphism to
  `Aʳ × ∏ᵢ A ⧸ 𝔭ᵢ ^ nᵢ`.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, (5.1.7)–(5.1.10).
* N. Bourbaki, *Commutative Algebra*, Chapter VII, §4.4, Theorem 5.
-/

public section

namespace TauCeti.Iwasawa

universe u v

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]

/-- **Elementary divisors at a height-one prime.** Let `A` be a noetherian integrally closed domain
and `𝔭` a prime of height one. A finitely generated torsion module `M` receives a linear map from
a finite product `∏ᵢ A ⧸ 𝔭 ^ nᵢ` that becomes bijective after localizing at `𝔭`. -/
theorem exists_bijective_localizedModule_map_pi_quotient_pow [IsDomain A] [IsNoetherianRing A]
    [IsIntegrallyClosed A] [Module.Finite A M] (hM : Module.IsTorsion A M) {𝔭 : Ideal A}
    [𝔭.IsPrime] (h𝔭 : 𝔭.height = 1) :
    ∃ (ι : Type u) (_ : Fintype ι) (n : ι → ℕ) (h : (∀ i, A ⧸ 𝔭 ^ n i) →ₗ[A] M),
      Function.Bijective (LocalizedModule.map 𝔭.primeCompl h) := by
  let Aₚ := Localization.AtPrime 𝔭
  have := IsLocalization.AtPrime.isDiscreteValuationRing_of_height_eq_one h𝔭 Aₚ
  -- Over the discrete valuation ring `A_𝔭`, `M_𝔭 ≅ ⨁ᵢ A_𝔭 ⧸ (qᵢ ^ eᵢ)` with `qᵢ` a uniformizer.
  obtain ⟨ι, _, q, hq, e, ⟨φ⟩⟩ :=
    Module.equiv_directSum_of_isTorsion (hM.localizedModule 𝔭.primeCompl)
  -- The localization of `A ⧸ 𝔭 ^ k` at `𝔭` is `A_𝔭 ⧸ (𝔭 A_𝔭) ^ k`, and `𝔭 A_𝔭 = (qᵢ)`.
  have hI (i : ι) : (𝔭 ^ e i).localized' Aₚ 𝔭.primeCompl (Algebra.linearMap A Aₚ) =
      Aₚ ∙ q i ^ e i := by
    rw [Ideal.localized'_eq_map, Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal,
      (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp (hq i), Ideal.span_singleton_pow]
  let l : (∀ i, Aₚ ⧸ (𝔭 ^ e i).localized' Aₚ 𝔭.primeCompl (Algebra.linearMap A Aₚ)) ≃ₗ[Aₚ]
      LocalizedModule 𝔭.primeCompl M :=
    LinearEquiv.piCongrRight (fun i ↦ Submodule.quotEquivOfEq _ _ (hI i)) ≪≫ₗ
      (DirectSum.linearEquivFunOnFintype Aₚ ι _).symm ≪≫ₗ φ.symm
  have := Module.finitePresentation_of_finite A (∀ i, A ⧸ 𝔭 ^ e i)
  obtain ⟨h, hh⟩ := Module.FinitePresentation.exists_bijective_map_of_isLocalizedModule
    𝔭.primeCompl (LinearMap.pi fun i ↦
      (𝔭 ^ e i).toLocalizedQuotient' Aₚ 𝔭.primeCompl (Algebra.linearMap A Aₚ) ∘ₗ
        LinearMap.proj i)
    (LocalizedModule.mkLinearMap 𝔭.primeCompl M) (l.restrictScalars A)
  exact ⟨ι, inferInstance, e, h,
    (IsLocalizedModule.map_bijective_iff_localizedModuleMap_bijective _ _).mp hh⟩

/-- A prime in the support of `∏ᵢ A ⧸ 𝔭 ^ nᵢ` contains `𝔭`. -/
private theorem le_of_mem_support_pi_quotient_pow {ι : Type*} [Finite ι] {𝔭 : Ideal A}
    {n : ι → ℕ} {𝔮 : PrimeSpectrum A} (h : 𝔮 ∈ Module.support A (∀ i, A ⧸ 𝔭 ^ n i)) :
    𝔭 ≤ 𝔮.asIdeal := by
  have := Fintype.ofFinite ι
  rw [Module.mem_support_iff_of_finite, Module.annihilator_pi, ← Finset.inf_univ_eq_iInf,
    𝔮.isPrime.inf_le'] at h
  obtain ⟨i, -, hi⟩ := h
  rw [Ideal.annihilator_quotient] at hi
  exact Ideal.IsPrime.le_of_pow_le hi

/-- Dropping the factors with exponent zero from `∏ᵢ A ⧸ Iᵢ ^ nᵢ` is bijective, as those factors
are `A ⧸ A = 0`. -/
private theorem bijective_pi_restrict_quotient_pow {ι : Type*} (I : ι → Ideal A) (n : ι → ℕ) :
    Function.Bijective (LinearMap.pi fun y : {i // n i ≠ 0} ↦ LinearMap.proj y.1 :
      (∀ i, A ⧸ I i ^ n i) →ₗ[A] ∀ y : {i // n i ≠ 0}, A ⧸ I y ^ n y) := by
  classical
  refine ⟨fun x x' hxx' ↦ funext fun i ↦ ?_, fun y ↦ ?_⟩
  · by_cases hi : n i = 0
    · have : Subsingleton (A ⧸ I i ^ n i) := by
        rw [Ideal.Quotient.subsingleton_iff]
        simp [hi]
      exact Subsingleton.elim _ _
    · exact congr_fun hxx' ⟨i, hi⟩
  · refine ⟨fun i ↦ if hi : n i = 0 then 0 else y ⟨i, hi⟩, funext fun i ↦ ?_⟩
    simp only [LinearMap.pi_apply, LinearMap.proj_apply, i.2, ↓reduceDIte]

/-- **The structure theorem for torsion modules.** Over a noetherian integrally closed domain `A`, a
finitely generated torsion module `M` admits a pseudo-isomorphism `M → ∏ᵢ A ⧸ 𝔭ᵢ ^ nᵢ` onto a
finite product, with each `𝔭ᵢ` a prime of height one and each `nᵢ` positive.
Neukirch–Schmidt–Wingberg, (5.1.10). -/
theorem exists_isPseudoIsomorphism_pi_quotient_pow [IsDomain A] [IsNoetherianRing A]
    [IsIntegrallyClosed A] [Module.Finite A M] (hM : Module.IsTorsion A M) :
    ∃ (ι : Type u) (_ : Fintype ι) (𝔭 : ι → PrimeSpectrum A) (n : ι → ℕ),
      (∀ i, (𝔭 i).asIdeal.height = 1 ∧ n i ≠ 0) ∧
        ∃ f : M →ₗ[A] (∀ i, A ⧸ (𝔭 i).asIdeal ^ n i), IsPseudoIsomorphism f := by
  classical
  -- The primes of height at most one in the support of `M`: finitely many, all of height one.
  let P := {𝔭 ∈ Module.support A M | 𝔭.asIdeal.height ≤ 1}
  have : Fintype P := hM.finite_setOf_mem_support_height_le_one.fintype
  have hP (𝔭 : P) : 𝔭.1.asIdeal.height = 1 := by
    refine le_antisymm 𝔭.2.2 (Order.one_le_iff_pos.mpr (pos_iff_ne_zero.mpr fun h0 ↦ ?_))
    exact hM.notMem_support_of_mem_minimalPrimes (Ideal.height_eq_zero_iff.mp h0) 𝔭.2.1
  choose ι _ n h hh using fun 𝔭 : P ↦
    exists_bijective_localizedModule_map_pi_quotient_pow hM (𝔭 := 𝔭.1.asIdeal) (hP 𝔭)
  let E (𝔭 : P) := ∀ i, A ⧸ 𝔭.1.asIdeal ^ n 𝔭 i
  -- The prime of height one belonging to a factor `E 𝔭` is the only prime of height at most one in
  -- its support.
  have hsupp (𝔭 : P) (𝔮 : PrimeSpectrum A) (h𝔮 : 𝔮.asIdeal.height ≤ 1)
      (hmem : 𝔮 ∈ Module.support A (E 𝔭)) : 𝔭.1 = 𝔮 := by
    have : 𝔭.1.asIdeal.FiniteHeight := ⟨.inr (by simp [hP 𝔭])⟩
    exact PrimeSpectrum.ext (Ideal.eq_of_le_of_height_le _ (le_of_mem_support_pi_quotient_pow hmem)
      (h𝔮.trans (hP 𝔭).ge))
  -- The sum of the local maps is a pseudo-isomorphism `∏_𝔭 E 𝔭 → M`.
  let H : (∀ 𝔭, E 𝔭) →ₗ[A] M := ∑ 𝔭, h 𝔭 ∘ₗ LinearMap.proj 𝔭
  have hH : IsPseudoIsomorphism H := by
    refine .of_bijective_localizedModule_map fun 𝔮 h𝔮 ↦ ?_
    by_cases hq : 𝔮 ∈ Module.support A M
    · -- At `𝔮 ∈ P`, every factor other than `E 𝔮` vanishes, and on `E 𝔮` the map is `h 𝔮`.
      let 𝔮' : P := ⟨𝔮, hq, h𝔮⟩
      have hcomp : H ∘ₗ LinearMap.single A E 𝔮' = h 𝔮' := by
        refine LinearMap.ext fun y ↦ ?_
        simp only [H, LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.proj_apply,
          LinearMap.coe_single]
        rw [Finset.sum_eq_single 𝔮' (fun 𝔭 _ h𝔭 ↦ by rw [Pi.single_eq_of_ne h𝔭, map_zero])
          (by simp), Pi.single_eq_same]
      have hsingle : Function.Bijective
          (LocalizedModule.map 𝔮.asIdeal.primeCompl (LinearMap.single A E 𝔮')) :=
        LocalizedModule.bijective_map_single 𝔮' fun 𝔭 hne ↦ Module.notMem_support_iff.mp
          fun hmem ↦ hne (Subtype.ext (hsupp 𝔭 𝔮 h𝔮 hmem))
      rw [← Function.Bijective.of_comp_iff _ hsingle, ← LinearMap.coe_comp,
        ← LocalizedModule.map_comp, hcomp]
      exact hh 𝔮'
    · -- At any other prime of height at most one both modules vanish.
      have : Subsingleton (LocalizedModule 𝔮.asIdeal.primeCompl M) :=
        Module.notMem_support_iff.mp hq
      have : Subsingleton (LocalizedModule 𝔮.asIdeal.primeCompl (∀ 𝔭, E 𝔭)) := by
        refine Module.notMem_support_iff.mp fun hmem ↦ ?_
        rw [Module.mem_support_iff_of_finite, Module.annihilator_pi, ← Finset.inf_univ_eq_iInf,
          𝔮.isPrime.inf_le'] at hmem
        obtain ⟨𝔭, -, h𝔭⟩ := hmem
        exact hq (hsupp 𝔭 𝔮 h𝔮 (Module.mem_support_iff_of_finite.mpr h𝔭) ▸ 𝔭.2.1)
      exact ⟨Function.injective_of_subsingleton _, Function.surjective_to_subsingleton _⟩
  obtain ⟨f, hf⟩ := hH.exists_reverse hM
  -- Flatten the index to `Σ 𝔭, ι 𝔭` and drop the factors with exponent zero, which vanish.
  let κ := {x : Σ 𝔭 : P, ι 𝔭 // n x.1 x.2 ≠ 0}
  exact ⟨κ, inferInstance, fun y ↦ y.1.1.1, fun y ↦ n y.1.1 y.1.2, fun y ↦ ⟨hP y.1.1, y.2⟩,
    (LinearMap.pi fun y : κ ↦ LinearMap.proj y.1) ∘ₗ
      (LinearEquiv.piCurry A fun 𝔭 i ↦ A ⧸ 𝔭.1.asIdeal ^ n 𝔭 i).symm.toLinearMap ∘ₗ f,
    (IsPseudoIsomorphism.of_bijective (bijective_pi_restrict_quotient_pow _ _)).comp
      ((IsPseudoIsomorphism.of_bijective (LinearEquiv.bijective _)).comp hf)⟩

/-- **The structure theorem over a regular local ring of dimension at most two.** Let `A` be a
regular local ring of dimension at most two, such as the Iwasawa algebra `O⟦T⟧`. A finitely
generated `A`-module `M` admits a pseudo-isomorphism `M → Aʳ × ∏ᵢ A ⧸ 𝔭ᵢ ^ nᵢ`, with each `𝔭ᵢ` a
prime of height one and each `nᵢ` positive. Neukirch–Schmidt–Wingberg, Theorem (5.1.10). -/
theorem exists_isPseudoIsomorphism_prod_pi_quotient_pow [IsRegularLocalRing A]
    (hdim : ringKrullDim A ≤ 2) [Module.Finite A M] :
    ∃ (r : ℕ) (ι : Type u) (_ : Fintype ι) (𝔭 : ι → PrimeSpectrum A) (n : ι → ℕ),
      (∀ i, (𝔭 i).asIdeal.height = 1 ∧ n i ≠ 0) ∧
        ∃ f : M →ₗ[A] (Fin r → A) × ∀ i, A ⧸ (𝔭 i).asIdeal ^ n i, IsPseudoIsomorphism f := by
  have := IsRegularLocalRing.uniqueFactorizationMonoid_of_ringKrullDim_le_two hdim
  obtain ⟨φ, hφ⟩ := exists_isPseudoIsomorphism_prod_torsion_mkQ (A := A) (M := M)
  obtain ⟨ι, _, 𝔭, n, h𝔭n, g, hg⟩ :=
    exists_isPseudoIsomorphism_pi_quotient_pow (M := Submodule.torsion A M)
      Submodule.torsion_isTorsion
  obtain ⟨r, k, hk⟩ :=
    exists_isPseudoIsomorphism_pi_of_isTorsionFree (M := M ⧸ Submodule.torsion A M) hdim
  exact ⟨r, ι, inferInstance, 𝔭, n, h𝔭n, k.prodMap g ∘ₗ
      (LinearEquiv.prodComm A _ _).toLinearMap ∘ₗ φ.prod (Submodule.torsion A M).mkQ,
    (hk.prodMap hg).comp ((IsPseudoIsomorphism.of_bijective (LinearEquiv.bijective _)).comp hφ)⟩

end TauCeti.Iwasawa
