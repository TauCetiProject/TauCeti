/-!
# The `μ`-invariant of an Iwasawa module

Let `O` be a discrete valuation ring with maximal ideal `𝔪 = (ϖ)` and let `Λ = O⟦X⟧`. The extended
ideal `𝔪Λ = (ϖ)` is a prime of height one, the *vertical prime* of `Λ`. The *`μ`-invariant* of a
`Λ`-module `M` is the multiplicity of `(ϖ)` in the characteristic divisor of its torsion submodule
`T_Λ(M)`. For finitely generated `M` this is the length of the localization of `T_Λ(M)` at `(ϖ)`.
The torsion submodule matters: localizing `M` itself at `(ϖ)` would also see free summands, of
infinite length.

The `μ`-invariant is invariant under pseudo-isomorphism, and it is additive on products of finitely
generated modules and in short exact sequences of finitely generated torsion modules. On an
elementary module
`Λʳ × ∏ᵢ Λ ⧸ (ϖ ^ mᵢ) × ∏ⱼ Λ ⧸ (Fⱼ ^ nⱼ)` with monic `Fⱼ` it is `Σ mᵢ`: the free part is
torsion-free, and a monic polynomial is not divisible by `ϖ`. By the structure theorem for Iwasawa
modules (`TauCeti.Iwasawa.exists_isPseudoIsomorphism_elementary`), the `μ`-invariant of a finitely
generated `Λ`-module is therefore the sum `Σ mᵢ` of the exponents of the vertical factors of any
elementary module pseudo-isomorphic to it. Together with the `λ`-invariant, it governs the growth
of the quotients `M ⧸ ω_n M` in Iwasawa's growth formula.

## Main definitions

* `TauCeti.Iwasawa.verticalPrime O`: the prime `𝔪 O⟦X⟧ = (ϖ)` of height one of `O⟦X⟧`.
* `TauCeti.Iwasawa.muInvariant O M`: the `μ`-invariant of an `O⟦X⟧`-module `M`.

## Main results

* `TauCeti.Iwasawa.coe_muInvariant`: `μ(M)` is the length of the localization of `T_Λ(M)` at
  `(ϖ)`.
* `TauCeti.Iwasawa.muInvariant_eq_charDivisor`: for torsion `M`, `μ(M)` is the multiplicity of
  `(ϖ)` in the characteristic divisor of `M`.
* `TauCeti.Iwasawa.IsPseudoIsomorphism.muInvariant_eq`: `μ` is invariant under
  pseudo-isomorphism.
* `TauCeti.Iwasawa.muInvariant_eq_add_of_exact`: `μ` is additive in short exact sequences of
  finitely generated torsion modules.
* `TauCeti.Iwasawa.muInvariant_prod`, `TauCeti.Iwasawa.muInvariant_pi`: `μ` is additive on finite
  products of finitely generated modules.
* `TauCeti.Iwasawa.muInvariant_quotient_span_C_pow`: `μ(Λ ⧸ (ϖ ^ m)) = m`.
* `TauCeti.Iwasawa.muInvariant_elementary`: the `μ`-invariant of an elementary module is `Σ mᵢ`.
* `TauCeti.Iwasawa.IsPseudoIsomorphism.muInvariant_eq_sum`: if `M` is pseudo-isomorphic to an
  elementary module, then `μ(M) = Σ mᵢ`.

The examples at the end of the file are over `Λ = ℤ_p⟦T⟧`: `μ(Λ ⧸ (p)) = 1`, while the finite
module `Λ ⧸ (p, T)` and the module `Λ ⧸ (T² + pT + p)` cut out by an Eisenstein polynomial have
`μ = 0`.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, (5.3.9).
* L. Washington, *Introduction to Cyclotomic Fields*, second edition, GTM 83, §13.2.
-/

public section

open IsLocalRing PowerSeries Submodule
open scoped Polynomial PowerSeries

universe u

namespace TauCeti.Iwasawa

section VerticalPrime

variable (O : Type*) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]

/-- The *vertical prime* `𝔪 O⟦X⟧ = (ϖ)` of `O⟦X⟧`, for a discrete valuation ring `O` with
maximal ideal `𝔪 = (ϖ)`. It has height one, and it is the prime at which the `μ`-invariant of an
`O⟦X⟧`-module is measured. -/
noncomputable def verticalPrime : PrimeSpectrum O⟦X⟧ :=
  ⟨(maximalIdeal O).map C, isPrime_map_C_of_fg (IsNoetherian.noetherian _)⟩

variable {O}

theorem verticalPrime_asIdeal : (verticalPrime O).asIdeal = (maximalIdeal O).map C := (rfl)

/-- The vertical prime is generated by `C ϖ`, for any uniformiser `ϖ`. -/
theorem verticalPrime_asIdeal_eq_span {ϖ : O} (hϖ : Irreducible ϖ) :
    (verticalPrime O).asIdeal = Ideal.span {C ϖ} := by
  rw [verticalPrime_asIdeal, hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]

/-- A power series lies in the vertical prime iff all of its coefficients lie in the maximal ideal
of `O`. -/
theorem mem_verticalPrime_iff {f : O⟦X⟧} :
    f ∈ (verticalPrime O).asIdeal ↔ ∀ n, coeff n f ∈ maximalIdeal O :=
  mem_map_C_iff_of_fg (IsNoetherian.noetherian _)

/-- A monic polynomial does not lie in the vertical prime: its leading coefficient is `1`. -/
theorem coe_notMem_verticalPrime_of_monic {F : O[X]} (hF : F.Monic) :
    (F : O⟦X⟧) ∉ (verticalPrime O).asIdeal := fun h ↦ by
  simpa [Polynomial.coeff_coe, hF.leadingCoeff] using
    mem_verticalPrime_iff.mp h F.natDegree

/-- The vertical prime has height one. -/
@[simp]
theorem height_verticalPrime : (verticalPrime O).asIdeal.height = 1 := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  have hϖ' : Prime (C ϖ : O⟦X⟧) := prime_C_iff.mpr hϖ.prime
  rw [verticalPrime_asIdeal_eq_span hϖ]
  exact Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero hϖ'.ne_zero) hϖ'.not_isUnit

end VerticalPrime

section MuInvariant

variable (O : Type*) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  (M : Type*) [AddCommGroup M] [Module O⟦X⟧ M]

/-- The *`μ`-invariant* of a module `M` over `O⟦X⟧`, for a discrete valuation ring `O`: the
multiplicity of the vertical prime `(ϖ)` in the characteristic divisor of the torsion submodule of
`M`. For finitely generated `M` it is the length of the localization of the torsion submodule at
`(ϖ)` (`coe_muInvariant`). -/
noncomputable def muInvariant : ℕ :=
  charDivisor O⟦X⟧ (torsion O⟦X⟧ M) (verticalPrime O)

variable {O M}

theorem muInvariant_def : muInvariant O M = charDivisor O⟦X⟧ (torsion O⟦X⟧ M) (verticalPrime O) :=
  (rfl)

/-- The `μ`-invariant of a finitely generated `O⟦X⟧`-module is the length of the localization of
its torsion submodule at the vertical prime `(ϖ)`. -/
theorem coe_muInvariant [Module.Finite O⟦X⟧ M] :
    (muInvariant O M : ℕ∞) = Module.length (Localization.AtPrime (verticalPrime O).asIdeal)
      (LocalizedModule (verticalPrime O).asIdeal.primeCompl (torsion O⟦X⟧ M)) :=
  coe_charDivisor_apply torsion_isTorsion height_verticalPrime

/-- The `μ`-invariant of a torsion `O⟦X⟧`-module is the multiplicity of the vertical prime `(ϖ)`
in its characteristic divisor. -/
theorem muInvariant_eq_charDivisor (hM : Module.IsTorsion O⟦X⟧ M) :
    muInvariant O M = charDivisor O⟦X⟧ M (verticalPrime O) := by
  rw [muInvariant_def, (LinearEquiv.ofTop _
    (eq_top_iff.mpr fun x _ ↦ (mem_torsion_iff x).mpr (@hM x))).charDivisor_eq]

/-- The `μ`-invariant of a torsion-free module is zero. -/
@[simp]
theorem muInvariant_eq_zero_of_isTorsionFree [Module.IsTorsionFree O⟦X⟧ M] :
    muInvariant O M = 0 := by
  have := subsingleton_iff_eq_bot.mpr
    ((isTorsionFree_iff_torsion_eq_bot (R := O⟦X⟧) (M := M)).mp inferInstance)
  rw [muInvariant_def, charDivisor_of_subsingleton, Finsupp.coe_zero, Pi.zero_apply]

/-- The `μ`-invariant vanishes when the vertical prime is not in the support of the module. -/
theorem muInvariant_eq_zero_of_notMem_support (h : verticalPrime O ∉ Module.support O⟦X⟧ M) :
    muInvariant O M = 0 :=
  charDivisor_apply_eq_zero_of_notMem_support fun h' ↦
    h (Module.support_subset_of_injective _ (torsion O⟦X⟧ M).injective_subtype h')

variable {N P : Type*} [AddCommGroup N] [Module O⟦X⟧ N] [AddCommGroup P] [Module O⟦X⟧ P]

/-- The `μ`-invariant is invariant under pseudo-isomorphism. -/
theorem IsPseudoIsomorphism.muInvariant_eq {f : M →ₗ[O⟦X⟧] N} (hf : IsPseudoIsomorphism f) :
    muInvariant O M = muInvariant O N := by
  rw [muInvariant_def, muInvariant_def, hf.restrict_torsion.charDivisor_eq]

/-- The `μ`-invariant is invariant under linear equivalence. -/
theorem _root_.LinearEquiv.muInvariant_eq (e : M ≃ₗ[O⟦X⟧] N) :
    muInvariant O M = muInvariant O N :=
  (IsPseudoIsomorphism.of_bijective e.bijective).muInvariant_eq

/-- **Additivity of the `μ`-invariant.** In a short exact sequence `0 → M → N → P → 0` of finitely
generated torsion `O⟦X⟧`-modules, `μ(N) = μ(M) + μ(P)`. -/
theorem muInvariant_eq_add_of_exact [Module.Finite O⟦X⟧ N] (hN : Module.IsTorsion O⟦X⟧ N)
    {f : M →ₗ[O⟦X⟧] N} {g : N →ₗ[O⟦X⟧] P} (hfg : Function.Exact f g) (hf : Function.Injective f)
    (hg : Function.Surjective g) : muInvariant O N = muInvariant O M + muInvariant O P := by
  rw [muInvariant_eq_charDivisor hN, muInvariant_eq_charDivisor (hN.of_injective hf),
    muInvariant_eq_charDivisor (hN.of_surjective hg),
    charDivisor_eq_add_of_exact hN hfg hf hg, Finsupp.add_apply]

/-- The `μ`-invariant of a product of two finitely generated modules is the sum of their
`μ`-invariants. -/
@[simp]
theorem muInvariant_prod [Module.Finite O⟦X⟧ M] [Module.Finite O⟦X⟧ N] :
    muInvariant O (M × N) = muInvariant O M + muInvariant O N := by
  rw [muInvariant_def, (Submodule.torsionProdEquiv O⟦X⟧ M N).charDivisor_eq,
    charDivisor_prod torsion_isTorsion torsion_isTorsion, Finsupp.add_apply, muInvariant_def,
    muInvariant_def]

/-- The `μ`-invariant of a finite product of finitely generated modules is the sum of their
`μ`-invariants. -/
@[simp]
theorem muInvariant_pi {ι : Type*} [Fintype ι] (M : ι → Type u) [∀ i, AddCommGroup (M i)]
    [∀ i, Module O⟦X⟧ (M i)] [∀ i, Module.Finite O⟦X⟧ (M i)] :
    muInvariant O (∀ i, M i) = ∑ i, muInvariant O (M i) := by
  -- Reduce to `ι = Fin k`, then split off one factor at a time.
  suffices h : ∀ (k : ℕ) (M : Fin k → Type u) [∀ i, AddCommGroup (M i)] [∀ i, Module O⟦X⟧ (M i)]
      [∀ i, Module.Finite O⟦X⟧ (M i)], muInvariant O (∀ i, M i) = ∑ i, muInvariant O (M i) by
    let e := (Fintype.equivFin ι).symm
    rw [← (LinearEquiv.piCongrLeft O⟦X⟧ M e).muInvariant_eq, h]
    exact e.sum_comp fun i ↦ muInvariant O (M i)
  intro k
  induction k with
  | zero => intro M _ _ _; simp [muInvariant_eq_zero_of_isTorsionFree]
  | succ k ih =>
    intro M _ _ _
    rw [← (Fin.consLinearEquiv O⟦X⟧ M).muInvariant_eq, muInvariant_prod, ih, Fin.sum_univ_succ]

/-- **The `μ`-invariant of a vertical factor.** For a uniformiser `ϖ` of `O`,
`μ(O⟦X⟧ ⧸ (ϖ ^ m)) = m`. -/
theorem muInvariant_quotient_span_C_pow {ϖ : O} (hϖ : Irreducible ϖ) (m : ℕ) :
    muInvariant O (O⟦X⟧ ⧸ Ideal.span {C (ϖ ^ m)}) = m := by
  have hϖ' : Prime (C ϖ : O⟦X⟧) := prime_C_iff.mpr hϖ.prime
  have hpow : C (ϖ ^ m) ∈ nonZeroDivisors O⟦X⟧ :=
    mem_nonZeroDivisors_of_ne_zero (by rw [map_pow]; exact pow_ne_zero m hϖ'.ne_zero)
  have hM := Ideal.isTorsion_quotient_of_mem (Ideal.mem_span_singleton_self _) hpow
  have h := charDivisor_quotient_span_singleton_pow hϖ' m
  rw [← map_pow] at h
  rw [muInvariant_eq_charDivisor hM, h]
  have : verticalPrime O = ⟨Ideal.span {C ϖ}, (Ideal.span_singleton_prime hϖ'.ne_zero).mpr hϖ'⟩ :=
    PrimeSpectrum.ext (verticalPrime_asIdeal_eq_span hϖ)
  rw [this, Finsupp.smul_apply, Finsupp.single_eq_same, smul_eq_mul, mul_one]

/-- The `μ`-invariant of `O⟦X⟧ ⧸ I` vanishes when `I` is not contained in the vertical prime. -/
theorem muInvariant_quotient_eq_zero {I : Ideal O⟦X⟧} (hI : ¬I ≤ (verticalPrime O).asIdeal) :
    muInvariant O (O⟦X⟧ ⧸ I) = 0 :=
  muInvariant_eq_zero_of_notMem_support (by
    rwa [Module.mem_support_iff_of_finite, Ideal.annihilator_quotient])

/-- **The `μ`-invariant of an elementary module.** Let `ϖ` be a uniformiser of `O` and let the
`Fⱼ` be monic. The `μ`-invariant of `O⟦X⟧ʳ × ∏ᵢ O⟦X⟧ ⧸ (ϖ ^ mᵢ) × ∏ⱼ O⟦X⟧ ⧸ (Fⱼ ^ nⱼ)` is
`Σ mᵢ`. -/
theorem muInvariant_elementary {ϖ : O} (hϖ : Irreducible ϖ) (r : ℕ) {a b : ℕ} (m : Fin a → ℕ)
    {F : Fin b → O[X]} (hF : ∀ j, (F j).Monic) (n : Fin b → ℕ) :
    muInvariant O (Elementary O ϖ r m F n) = ∑ i, m i := by
  have hFn (j : Fin b) : ¬Ideal.span {((F j ^ n j : O[X]) : O⟦X⟧)} ≤ (verticalPrime O).asIdeal :=
    fun h ↦ coe_notMem_verticalPrime_of_monic ((hF j).pow (n j))
      (h (Ideal.mem_span_singleton_self _))
  rw [muInvariant_prod, muInvariant_prod, muInvariant_eq_zero_of_isTorsionFree, muInvariant_pi,
    muInvariant_pi]
  simp only [muInvariant_quotient_span_C_pow hϖ, muInvariant_quotient_eq_zero (hFn _),
    Finset.sum_const_zero, zero_add, add_zero]

/-- **The `μ`-invariant from an elementary module.** If a module `M` over `O⟦X⟧` is
pseudo-isomorphic to an elementary module `O⟦X⟧ʳ × ∏ᵢ O⟦X⟧ ⧸ (ϖ ^ mᵢ) × ∏ⱼ O⟦X⟧ ⧸ (Fⱼ ^ nⱼ)` with
monic `Fⱼ`, then `μ(M) = Σ mᵢ`. In particular `Σ mᵢ` does not depend on the elementary module
chosen in the structure theorem `exists_isPseudoIsomorphism_elementary`. -/
theorem IsPseudoIsomorphism.muInvariant_eq_sum {ϖ : O} (hϖ : Irreducible ϖ) {r a b : ℕ}
    {m : Fin a → ℕ} {F : Fin b → O[X]} {n : Fin b → ℕ} (hF : ∀ j, (F j).Monic)
    {f : M →ₗ[O⟦X⟧] Elementary O ϖ r m F n} (hf : IsPseudoIsomorphism f) :
    muInvariant O M = ∑ i, m i :=
  hf.muInvariant_eq.trans (muInvariant_elementary hϖ r m hF n)

end MuInvariant

-- Over `Λ = ℤ_p⟦T⟧`: `μ(Λ ⧸ (p)) = 1`, while the finite module `Λ ⧸ (p, T)` and the module
-- `Λ ⧸ (T² + pT + p)`, cut out by an Eisenstein polynomial, have `μ = 0`.
example (p : ℕ) [Fact p.Prime] :
    muInvariant ℤ_[p] (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p])}) = 1 ∧
      muInvariant ℤ_[p] (ℤ_[p]⟦X⟧ ⧸ Ideal.span {C (p : ℤ_[p]), X}) = 0 ∧
        muInvariant ℤ_[p] (ℤ_[p]⟦X⟧ ⧸ Ideal.span {X ^ 2 + C (p : ℤ_[p]) * X + C (p : ℤ_[p])}) =
          0 := by
  have hX : (X : ℤ_[p]⟦X⟧) ∉ (verticalPrime ℤ_[p]).asIdeal := fun h ↦ by
    simpa using mem_verticalPrime_iff.mp h 1
  refine ⟨by
      have h := muInvariant_quotient_span_C_pow (PadicInt.irreducible_p (p := p)) 1
      rwa [pow_one] at h,
    muInvariant_quotient_eq_zero fun h ↦ hX (h (Ideal.subset_span (by simp))),
    muInvariant_quotient_eq_zero fun h ↦ ?_⟩
  have := mem_verticalPrime_iff.mp (h (Ideal.mem_span_singleton_self _)) 2
  simp [-map_natCast, coeff_X_pow] at this

end TauCeti.Iwasawa
