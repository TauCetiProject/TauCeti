/-!
# Sections of étale neighbourhoods of a Henselian pair

Let `(S, J)` be a Henselian pair. An étale neighbourhood of `(S, J)` is an étale `S`-algebra `C`
with `S ⧸ J ≅ C ⧸ JC`, so that `C` has exactly one `S`-algebra map to `S ⧸ J`. This file shows
that `C` has exactly one `S`-algebra map to `S`. These sections are the maps out of the stages of
the henselization of a pair into a Henselian pair. Existence holds more generally for flat,
finitely presented, quasi-finite algebras `C` with `S ⧸ J ≅ C ⧸ JC`.

## Implementation notes

By the global form of Zariski's main theorem, `C` agrees with a module-finite subalgebra `C'` on
finitely many basic opens covering `Spec C`. These produce an element of `C'` that is idempotent
modulo `JC'` and cuts out a summand of `C' ⧸ JC'` generated by one element over `S ⧸ J`. It lifts
to an idempotent `e` of `C'` (`TauCeti.HenselianRing.exists_isIdempotentElem_sub_mem_map`), and
Nakayama's lemma gives `e C = S e`. Flatness then makes `S → C ⧸ (1 - e)` an isomorphism.

## Main results

* `TauCeti.Henselization.nonempty_algHom_of_bijective_reducedMap`: a flat, finitely presented,
  quasi-finite `S`-algebra `C` with `S ⧸ J ≅ C ⧸ JC` has an `S`-algebra map to `S`.
* `TauCeti.Henselization.nonempty_unique_algHom_of_isNeighbourhood`: an étale neighbourhood of a
  Henselian pair has exactly one `S`-algebra map to `S`.
* `TauCeti.Henselization.IsNeighbourhood.nonempty_algHom`: an étale neighbourhood of `(R, I)` has
  an `R`-algebra map to every Henselian pair `(S, J)` with `IS ⊆ J`.

## References

* [Stacks Project, Lemma 15.11.6](https://stacks.math.columbia.edu/tag/09XI), condition (2).
* [Stacks Project, Tag 00Q9](https://stacks.math.columbia.edu/tag/00Q9), Zariski's main theorem.
-/

public section

open Filter

universe u v w

namespace TauCeti.Henselization

variable {S : Type u} [CommRing S] (J : Ideal S) {C : Type v} [CommRing C] [Algebra S C]

/-- An idempotent `e ≡ 1 mod JC` of a flat, finitely presented `S`-algebra `C` with `e C = S e`
gives an `S`-algebra map `C → S`, namely `C → C ⧸ (1 - e) ≅ S`. -/
private theorem nonempty_algHom_of_isIdempotentElem [Algebra.FinitePresentation S C]
    [Module.Flat S C] (hJ : J ≤ Ideal.jacobson ⊥) (hC : Function.Injective (reducedMap J C))
    {e : C} (he : IsIdempotentElem e) (he1 : 1 - e ∈ J.map (algebraMap S C))
    (hsc : ∀ c : C, ∃ s : S, s • e = e * c) : Nonempty (C →ₐ[S] S) := by
  let D := C ⧸ Ideal.span {1 - e}
  have hsurj : Function.Surjective (Algebra.ofId S D) := by
    intro d
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective d
    obtain ⟨s, hs⟩ := hsc c
    refine ⟨s, Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton'.mpr ⟨algebraMap S C s - c, ?_⟩)⟩
    rw [Algebra.smul_def] at hs
    linear_combination -hs
  -- The kernel `K` of `S → D` is a finitely generated pure ideal inside `J`, hence zero.
  let K := RingHom.ker (Algebra.ofId S D)
  have hKJ : K ≤ J := by
    intro s hs
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp hs)
    exact mem_of_algebraMap_mem_map_of_reducedMap_injective J hC
      (ha ▸ Ideal.mul_mem_left _ a he1)
  have : Algebra.FinitePresentation S D :=
    Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton _)
  have hKfg : K.FG := Algebra.FinitePresentation.ker_fG_of_surjective _ hsurj
  have : Module.Flat C D := Ideal.Pure.of_isIdempotentElem (Submodule.fg_span_singleton _)
    (by rw [IsIdempotentElem, Ideal.span_singleton_mul_span_singleton, he.one_sub.eq])
  have : Module.Flat S D := Module.Flat.trans S C D
  have : K.Pure :=
    Module.Flat.of_linearEquiv (Ideal.quotientKerAlgEquivOfSurjective hsurj).toLinearEquiv
  have hK : K = ⊥ := by
    refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot J K hKfg ?_ hJ
    rw [Ideal.smul_eq_mul, mul_comm, ← Ideal.inf_eq_mul_of_pure, inf_eq_left.mpr hKJ]
  have hinj : Function.Injective (Algebra.ofId S D) :=
    (RingHom.injective_iff_ker_eq_bot _).mpr hK
  exact ⟨((AlgEquiv.ofBijective _ ⟨hinj, hsurj⟩).symm : D →ₐ[S] S).comp (Ideal.Quotient.mkₐ S _)⟩

/-- The congruence `γ x ≡ σ γ mod JC'` for `x ≡ σ mod JC` propagates from a spanning family of
the subalgebra `C'` to all of `C'`. -/
private theorem exists_sub_mem_and_mul_sub_smul_mem_of_span (C' : Subalgebra S C) {ι : Type*}
    {g : ι → C'} (hg : Submodule.span S (Set.range g) = ⊤) (γ : C')
    (hgen : ∀ i, ∃ σ : S, (g i : C) - algebraMap S C σ ∈ J.map (algebraMap S C) ∧
      γ * g i - σ • γ ∈ J.map (algebraMap S C')) (x : C') :
    ∃ σ : S, (x : C) - algebraMap S C σ ∈ J.map (algebraMap S C) ∧
      γ * x - σ • γ ∈ J.map (algebraMap S C') := by
  induction (hg ▸ Submodule.mem_top : x ∈ Submodule.span S (Set.range g)) using
    Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact hgen i
  | zero => exact ⟨0, by simp, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨σx, hx1, hx2⟩ := hx
    obtain ⟨σy, hy1, hy2⟩ := hy
    refine ⟨σx + σy, ?_, ?_⟩
    · convert add_mem hx1 hy1 using 1
      push_cast
      ring
    · convert add_mem hx2 hy2 using 1
      rw [add_smul]
      ring
  | smul b x _ hx =>
    obtain ⟨σx, hx1, hx2⟩ := hx
    refine ⟨b * σx, ?_, ?_⟩
    · convert Submodule.smul_of_tower_mem _ b hx1 using 1
      simp only [Algebra.smul_def, map_mul, MulMemClass.coe_mul, Subalgebra.coe_algebraMap]
      ring
    · convert Submodule.smul_of_tower_mem _ b hx2 using 1
      simp only [Algebra.smul_def, map_mul]
      ring

/-- If `x - σ = ∑ aᵢ cᵢ` in `C` with all `aᵢ ∈ J`, and `y` moves every `cᵢ` into the subalgebra
`C'`, then `y (x - σ) ∈ JC'`. -/
private theorem mul_sub_algebraMap_mem_map (C' : Subalgebra S C) {x y : C'} {σ : S} {a : C →₀ S}
    (ha : ∀ c, a c ∈ J) (hsum : (a.sum fun c t ↦ t • id c) = (x : C) - algebraMap S C σ)
    (hy : ∀ c ∈ a.support, (y : C) * c ∈ C') :
    y * (x - algebraMap S C' σ) ∈ J.map (algebraMap S C') := by
  have : y * (x - algebraMap S C' σ) = ∑ c ∈ a.support.attach, a c • ⟨y * c, hy c c.2⟩ := by
    ext
    simp [← hsum, Finsupp.sum, Finset.mul_sum, Finset.sum_attach a.support fun c ↦ a c • (y * c)]
  rw [this]
  refine sum_mem fun c _ ↦ ?_
  rw [Algebra.smul_def]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (ha c))

/-- The element produced by the global form of Zariski's main theorem: if `C` agrees with the
module-finite subalgebra `C'` on the basic opens `D(r)`, `r ∈ s`, covering `Spec C`, and
`S ⧸ J → C ⧸ JC` is surjective, there is `γ ∈ C'` with `γ ≡ 1 mod JC`, lying in the ideal of `C'`
generated by `s`, such that `γ x ≡ σ γ mod JC'` whenever `x ≡ σ mod JC`. -/
private theorem exists_mul_sub_smul_mem (hC : Function.Surjective (reducedMap J C))
    (C' : Subalgebra S C) [Module.Finite S C'] (s : Finset C) (hsC' : (s : Set C) ⊆ C')
    (hspan : Ideal.span (s : Set C) = ⊤) (hZ : ∀ r ∈ s, ∀ x : C, ∀ᶠ m in atTop, r ^ m * x ∈ C') :
    ∃ γ : C', (γ : C) - 1 ∈ J.map (algebraMap S C) ∧ γ ∈ Ideal.span {x : C' | (x : C) ∈ s} ∧
      ∀ x : C', ∃ σ : S, (x : C) - algebraMap S C σ ∈ J.map (algebraMap S C) ∧
        γ * x - σ • γ ∈ J.map (algebraMap S C') := by
  classical
  have hlift := exists_sub_algebraMap_mem_map_of_reducedMap_surjective J hC
  -- Write each generator `gₗ` of `C'` as a scalar plus a `J`-combination of elements of `C`.
  obtain ⟨k, g, hg⟩ := Module.Finite.exists_fin (R := S) (M := C')
  choose σ hσ using fun l ↦ hlift (g l : C)
  have hσ' (l : Fin k) : (g l : C) - algebraMap S C (σ l) ∈
      J • Submodule.span S (Set.range (id : C → C)) := by
    rw [Set.range_id, Submodule.span_univ]
    simpa using hσ l
  choose a ha hsum using fun l ↦ (Submodule.mem_ideal_smul_span_iff_exists_sum J id _).mp (hσ' l)
  -- A power `N` of every `r ∈ s` moves all the elements so involved into `C'`.
  obtain ⟨N, hN1, hN⟩ : ∃ N, 1 ≤ N ∧ ∀ r ∈ s, ∀ l, ∀ c ∈ (a l).support, r ^ N * c ∈ C' :=
    ((eventually_ge_atTop 1).and ((eventually_all_finset s).mpr fun r hr ↦ eventually_all.mpr
      fun l ↦ (eventually_all_finset _).mpr fun c _ ↦ hZ r hr c)).exists
  -- The `N`-th powers of `s` generate the unit ideal; take the scalar parts of the coefficients.
  have h1 : (1 : C) ∈ Ideal.span ((· ^ N) '' (s : Set C)) := by
    rw [Ideal.span_pow_eq_top _ hspan]
    trivial
  obtain ⟨w, hw⟩ := (Fintype.mem_span_image_iff_exists_fun C).mp h1
  choose t ht using fun r : (s : Set C) ↦ hlift (w r)
  let r' (r : (s : Set C)) : C' := ⟨r, hsC' r.2⟩
  have hgen (r : (s : Set C)) (l : Fin k) :
      r' r ^ N * (g l - algebraMap S C' (σ l)) ∈ J.map (algebraMap S C') :=
    mul_sub_algebraMap_mem_map J C' (ha l) (hsum l) fun c hc ↦ by simpa [r'] using hN r r.2 l c hc
  refine ⟨∑ r, t r • r' r ^ N, ?_, ?_, fun x ↦ ?_⟩
  · have hcoe : ((∑ r, t r • r' r ^ N : C') : C) = ∑ r, algebraMap S C (t r) * (r : C) ^ N := by
      simp [r', Algebra.smul_def]
    rw [hcoe, ← hw, ← Finset.sum_sub_distrib]
    refine sum_mem fun r _ ↦ ?_
    rw [smul_eq_mul, ← sub_mul, ← neg_sub]
    exact Ideal.mul_mem_right _ _ (neg_mem (ht r))
  · refine sum_mem fun r _ ↦ Submodule.smul_of_tower_mem _ (t r) ?_
    exact Ideal.pow_mem_of_mem _ (Ideal.subset_span (s := {x : C' | (x : C) ∈ s}) r.2) N hN1
  refine exists_sub_mem_and_mul_sub_smul_mem_of_span J C' hg _ (fun l ↦ ⟨σ l, hσ l, ?_⟩) x
  have : (∑ r, t r • r' r ^ N) * g l - σ l • ∑ r, t r • r' r ^ N =
      ∑ r, t r • (r' r ^ N * (g l - algebraMap S C' (σ l))) := by
    simp only [Algebra.smul_def, Finset.mul_sum, Finset.sum_mul]
    rw [← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun r _ ↦ by ring
  rw [this]
  exact sum_mem fun r _ ↦ Submodule.smul_of_tower_mem _ _ (hgen r l)

/-- In a module-finite subalgebra `C'`, an element `γ ≡ 1 mod JC` with `γ x ≡ σ γ mod JC'`
whenever `x ≡ σ mod JC` lifts to an idempotent `e ≡ γ mod JC'` with `e C' = S e`. -/
private theorem exists_isIdempotentElem_smul_eq_mul [HenselianRing S J]
    (hC : Function.Injective (reducedMap J C)) (C' : Subalgebra S C) [Module.Finite S C']
    {γ : C'} (hγ1 : (γ : C) - 1 ∈ J.map (algebraMap S C))
    (hP : ∀ x : C', ∃ σ : S, (x : C) - algebraMap S C σ ∈ J.map (algebraMap S C) ∧
      γ * x - σ • γ ∈ J.map (algebraMap S C')) :
    ∃ e : C', IsIdempotentElem e ∧ e - γ ∈ J.map (algebraMap S C') ∧
      ∀ x : C', ∃ σ : S, σ • e = e * x := by
  have hγ : γ * γ - γ ∈ J.map (algebraMap S C') := by
    obtain ⟨σ, h1, h2⟩ := hP γ
    have hσ : σ - 1 ∈ J := by
      apply mem_of_algebraMap_mem_map_of_reducedMap_injective J hC
      rw [map_sub, map_one]
      convert sub_mem hγ1 h1 using 1
      ring
    convert add_mem h2 (Ideal.mul_mem_right γ _ (Ideal.mem_map_of_mem (algebraMap S C') hσ))
      using 1
    rw [Algebra.smul_def, map_sub, map_one]
    ring
  obtain ⟨e, he, heγ⟩ := HenselianRing.exists_isIdempotentElem_sub_mem_map J hγ
    fun x ↦ (hP x).imp fun _ h ↦ h.2
  refine ⟨e, he, heγ,
    he.exists_smul_eq_mul_of_mul_sub_smul_mem (HenselianRing.jac (I := J)) fun x ↦ ?_⟩
  obtain ⟨σ, -, h2⟩ := hP x
  refine ⟨σ, ?_⟩
  convert sub_mem (add_mem (Ideal.mul_mem_right x _ heγ) h2)
    (Submodule.smul_of_tower_mem _ σ heγ) using 1
  rw [smul_sub]
  ring

/-- If `C` agrees with the subalgebra `C'` on basic opens `D(r)`, `r ∈ s`, and `e` is an
idempotent of `C'` with `e C' = S e` that is congruent modulo `JC'` to an element of the ideal
generated by `s`, then also `e C = S e`. -/
private theorem exists_smul_eq_mul_of_subalgebra (hJ : J ≤ Ideal.jacobson ⊥)
    (C' : Subalgebra S C) [Module.Finite S C'] (s : Finset C)
    (hZ : ∀ r ∈ s, ∀ x : C, ∀ᶠ m in atTop, r ^ m * x ∈ C') {γ e : C'}
    (hγ : γ ∈ Ideal.span {x : C' | (x : C) ∈ s}) (he : IsIdempotentElem e)
    (heγ : e - γ ∈ J.map (algebraMap S C')) (hse : ∀ x : C', ∃ σ : S, σ • e = e * x) (c : C) :
    ∃ σ : S, σ • (e : C) = e * c := by
  classical
  obtain ⟨m, hm1, hm⟩ : ∃ m, 1 ≤ m ∧ ∀ r ∈ s, r ^ m * c ∈ C' :=
    ((eventually_ge_atTop 1).and ((eventually_all_finset s).mpr fun r hr ↦ hZ r hr c)).exists
  -- The `m`-th powers of `s` together with `1 - e` generate the unit ideal of `C'`.
  have h1 : (1 : C') ∈ Ideal.span ((· ^ m) '' {x : C' | (x : C) ∈ s}) ⊔ Ideal.span {1 - e} := by
    by_contra hne
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ ((Ideal.ne_top_iff_one _).mpr hne)
    have hJM : J.map (algebraMap S C') ≤ M :=
      (Ideal.map_le_jacobson_bot_of_isIntegral hJ).trans (sInf_le ⟨bot_le, hM⟩)
    have hsM : Ideal.span {x : C' | (x : C) ∈ s} ≤ M := Ideal.span_le.mpr fun x hx ↦
      hM.isPrime.mem_of_pow_mem m (hle (Ideal.mem_sup_left (Ideal.subset_span ⟨x, hx, rfl⟩)))
    have heM : e ∈ M := by simpa using M.add_mem (hJM heγ) (hsM hγ)
    exact hM.ne_top ((Ideal.eq_top_iff_one _).mpr (by
      simpa using M.add_mem heM (hle (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)))))
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp h1
  obtain ⟨u, rfl⟩ := Ideal.mem_span_singleton'.mp hz
  obtain ⟨T, hT, w, hw⟩ := (Submodule.mem_span_image_iff_exists_fun C').mp hy
  -- `e c = e (y c)`, and `y c` lies in `C'`.
  let x : C' := ∑ i, w i * ⟨(i : C) ^ m * c, hm _ (hT i.2)⟩
  obtain ⟨σ, hσ⟩ := hse x
  refine ⟨σ, ?_⟩
  have hey : e * y = e := by linear_combination e * hyz + u * he.eq
  have hx : (x : C) = y * c := by
    rw [← hw]
    simp only [x, AddSubmonoidClass.coe_finsetSum, MulMemClass.coe_mul, smul_eq_mul,
      SubmonoidClass.coe_pow, Finset.sum_mul, mul_assoc]
  rw [← Subalgebra.coe_smul, hσ, MulMemClass.coe_mul, hx, ← mul_assoc, ← MulMemClass.coe_mul,
    hey]

/-- **Sections over a Henselian pair.** Let `(S, J)` be a Henselian pair and let `C` be a flat,
finitely presented, quasi-finite `S`-algebra such that `S ⧸ J → C ⧸ JC` is bijective. Then there
is an `S`-algebra map `C → S`. -/
@[stacks 09XI "(1) ⇒ (2), for algebras with `S ⧸ J ≅ C ⧸ JC`"]
theorem nonempty_algHom_of_bijective_reducedMap [HenselianRing S J]
    [Algebra.FinitePresentation S C] [Module.Flat S C] [Algebra.QuasiFinite S C]
    (hC : Function.Bijective (reducedMap J C)) : Nonempty (C →ₐ[S] S) := by
  have hJ : J ≤ Ideal.jacobson ⊥ := HenselianRing.jac
  obtain ⟨C', s, hfg, hsC', hspan, hZ⟩ :=
    Algebra.QuasiFinite.exists_fg_subalgebra_and_span_eq_top (R := S) (A := C)
  have : Module.Finite S C' := ⟨(Submodule.fg_top _).mpr hfg⟩
  obtain ⟨γ, hγ1, hγs, hP⟩ := exists_mul_sub_smul_mem J hC.2 C' s hsC' hspan hZ
  obtain ⟨e, he, heγ, hse⟩ := exists_isIdempotentElem_smul_eq_mul J hC.1 C' hγ1 hP
  refine nonempty_algHom_of_isIdempotentElem J hJ hC.1 (he.map C'.val) ?_
    (exists_smul_eq_mul_of_subalgebra J hJ C' s hZ hγs he heγ hse)
  -- `JC' ⊆ JC` along the inclusion `C' ⊆ C`.
  have hJC : J.map (algebraMap S C') ≤ (J.map (algebraMap S C)).comap C'.val :=
    Ideal.map_le_iff_le_comap.mpr fun j hj ↦ by
      simpa [Ideal.mem_comap] using Ideal.mem_map_of_mem (algebraMap S C) hj
  convert neg_mem (add_mem hγ1 (hJC heγ)) using 1
  simp only [Subalgebra.coe_val, AddSubgroupClass.coe_sub]
  ring

/-- **Étale neighbourhoods of a Henselian pair have unique sections.** If `(S, J)` is a Henselian
pair and `C` is an étale neighbourhood of `(S, J)`, there is exactly one `S`-algebra map
`C → S`. -/
@[stacks 09XI "(1) ⇒ (2), for étale neighbourhoods"]
theorem nonempty_unique_algHom_of_isNeighbourhood [HenselianRing S J] {C : CommAlgCat.{v} S}
    (hC : IsNeighbourhood J C) : Nonempty (Unique (C →ₐ[S] S)) := by
  obtain ⟨hEt, hbij⟩ := (isNeighbourhood_iff J C).mp hC
  obtain ⟨σ⟩ := nonempty_algHom_of_bijective_reducedMap J hbij
  have hJ : J.map (algebraMap S S) ≤ Ideal.jacobson ⊥ := by
    rw [Algebra.algebraMap_self, Ideal.map_id]
    exact HenselianRing.jac
  exact ⟨{ default := σ, uniq := fun _ ↦ hC.algHom_ext hJ }⟩

end TauCeti.Henselization

namespace TauCeti.Henselization

variable {R : Type*} [CommRing R] {I : Ideal R}

open TensorProduct in
/-- An étale neighbourhood of `(R, I)` has an `R`-algebra map to every henselian pair `(S, J)`
receiving a map of pairs from `(R, I)`: the base change `S ⊗[R] B` is an étale neighbourhood of
`(S, J)`, and so has a section. -/
theorem IsNeighbourhood.nonempty_algHom {B : CommAlgCat.{w} R} (hB : IsNeighbourhood I B)
    {S : Type*} [CommRing S] [Algebra R S] {J : Ideal S} [HenselianRing S J]
    (hIJ : I.map (algebraMap R S) ≤ J) : Nonempty (B →ₐ[R] S) := by
  obtain ⟨hEtale, hBij⟩ := (isNeighbourhood_iff I B).mp hB
  -- Record the base-changed étale structure, from which instance search finds the flatness,
  -- finite presentation and quasi-finiteness that sections over `(S, J)` need.
  have : Algebra.Etale S (S ⊗[R] B) := inferInstance
  obtain ⟨σ⟩ := nonempty_algHom_of_bijective_reducedMap J (C := S ⊗[R] B)
    (reducedMap_bijective_of_le _ hIJ _ (reducedMap_bijective_baseChange I S B hBij))
  exact ⟨(σ.restrictScalars R).comp Algebra.TensorProduct.includeRight⟩

end TauCeti.Henselization
