module

public import TauCeti.RingTheory.Henselization.Map
public import TauCeti.RingTheory.Henselian.DirectLimit

/-!
# Henselization commutes with directed colimits of pairs

For a directed system of pairs `(Rᵢ, Iᵢ)`, `directLimitEquiv` identifies the direct limit of
their henselizations with the henselization of the direct limit along the ideal generated by
the images of the `Iᵢ`. The comparison sends each stage by the map of henselizations induced
by its inclusion in the direct limit. No injectivity, finiteness or Noetherian hypothesis is
needed on the rings, ideals or transition maps.

The proof uses `Ring.DirectLimit.henselianRing`: the direct limit of the henselizations is
already henselian along the direct limit of their extended ideals. The two universal
properties then give mutually inverse maps. The stage formula and the inverse formula on
base-ring elements characterize the comparison without unfolding it.

## References

* [Stacks Project, Lemma 15.12.5](https://stacks.math.columbia.edu/tag/0A04).
-/

public section

open Ring.DirectLimit

namespace TauCeti.Henselization

variable {ι : Type*} [Preorder ι] {R : ι → Type*} [∀ i, CommRing (R i)]
  (f : ∀ i j, i ≤ j → R i →+* R j) (I : ∀ i, Ideal (R i))
  (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (f i j hij))

/-- The transition maps on the henselizations induced by a system of maps of pairs. -/
noncomputable abbrev directLimitTransition (i j : ι) (hij : i ≤ j) :
    algebra (I i) →+* algebra (I j) :=
  map (f i j hij) (Ideal.map_le_iff_le_comap.mpr (hI i j hij))

instance [DirectedSystem R (f · · ·)] :
    DirectedSystem (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) where
  map_self i x := by
    have hf : f i i le_rfl = RingHom.id _ := RingHom.ext (fun x ↦ DirectedSystem.map_self' f x)
    simp [directLimitTransition, hf]
  map_map k j i hij hjk x := by
    have hf : (f j k hjk).comp (f i j hij) = f i k (hij.trans hjk) :=
      RingHom.ext (DirectedSystem.map_map' f hij hjk)
    simp only [directLimitTransition, map_map, hf]

private theorem extended_compatible (i j : ι) (hij : i ≤ j) :
    extended (I i) ≤ (extended (I j)).comap (directLimitTransition f I hI i j hij) :=
  Ideal.map_le_iff_le_comap.mp (map_extended_le _ _)

private noncomputable def toHenselization :
    Ring.DirectLimit (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) →+*
      algebra (⨆ i, (I i).map (of R (f · · ·) i)) :=
  Ring.DirectLimit.lift _ _ _ (fun i ↦ map (of R (f · · ·) i)
    (le_iSup (fun j ↦ (I j).map (of R (f · · ·) j)) i))
    (fun i j hij x ↦ by
      have he := map_comp (of R (f · · ·) j) (f i j hij)
        (le_iSup (fun k ↦ (I k).map (of R (f · · ·) k)) j)
        (Ideal.map_le_iff_le_comap.mpr (hI i j hij))
      simpa only [of_comp_f, RingHom.comp_apply] using (DFunLike.congr_fun he x).symm)

private noncomputable def colimitUnit :
    Ring.DirectLimit R (f · · ·) →+*
      Ring.DirectLimit (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) :=
  Ring.DirectLimit.map (fun i ↦ algebraMap (R i) (algebra (I i)))
    (fun i j hij ↦ (map_comp_algebraMap (f i j hij)
      (Ideal.map_le_iff_le_comap.mpr (hI i j hij))).symm)

private theorem map_iSup_map_colimitUnit :
    (⨆ i, (I i).map (of R (f · · ·) i)).map (colimitUnit f I hI) =
      ⨆ i, (extended (I i)).map
        (of (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) i) := by
  rw [Ideal.map_iSup]
  congr 1
  funext i
  rw [Ideal.map_map, extended, Ideal.map_map]
  congr 1
  ext r
  simp [colimitUnit]

variable [Nonempty ι] [IsDirectedOrder ι] [DirectedSystem R (f · · ·)]

private noncomputable def fromHenselization :
    algebra (⨆ i, (I i).map (of R (f · · ·) i)) →+*
      Ring.DirectLimit (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) := by
  let : Algebra (Ring.DirectLimit R (f · · ·))
      (Ring.DirectLimit (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·)) :=
    (colimitUnit f I hI).toAlgebra
  let J := ⨆ i, (extended (I i)).map
    (of (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) i)
  letI : HenselianRing _ J := Ring.DirectLimit.henselianRing (extended_compatible f I hI)
  exact (lift (I := ⨆ i, (I i).map (of R (f · · ·) i)) (J := J)
    (map_iSup_map_colimitUnit f I hI).le).toRingHom

@[simp]
private theorem fromHenselization_algebraMap (r : Ring.DirectLimit R (f · · ·)) :
    fromHenselization f I hI (algebraMap _ (algebra (⨆ i, (I i).map (of R (f · · ·) i))) r) =
      colimitUnit f I hI r := by
  let : Algebra (Ring.DirectLimit R (f · · ·))
      (Ring.DirectLimit (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·)) :=
    (colimitUnit f I hI).toAlgebra
  dsimp only [fromHenselization]
  exact AlgHom.commutes _ r

private theorem to_comp_from :
    (toHenselization f I hI).comp (fromHenselization f I hI) = RingHom.id _ := by
  have he : ((toHenselization f I hI).comp (fromHenselization f I hI)).comp
      (algebraMap (Ring.DirectLimit R (f · · ·))
        (algebra (⨆ i, (I i).map (of R (f · · ·) i)))) =
        algebraMap (Ring.DirectLimit R (f · · ·))
          (algebra (⨆ i, (I i).map (of R (f · · ·) i))) := by
    apply Ring.DirectLimit.hom_ext
    intro i
    ext r
    simp [colimitUnit, toHenselization]
  exact ringHom_ext_of_map_le_jacobson (he.trans (RingHom.id_comp _).symm)
    (by rw [he]; exact extended_le_jacobson _)

private theorem from_comp_to :
    (fromHenselization f I hI).comp (toHenselization f I hI) = RingHom.id _ := by
  apply Ring.DirectLimit.hom_ext
  intro i
  have he : (((fromHenselization f I hI).comp (toHenselization f I hI)).comp
      (of (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) i)).comp
        (algebraMap (R i) (algebra (I i))) =
      (RingHom.id _ |>.comp
        (of (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) i)).comp
        (algebraMap (R i) (algebra (I i))) := by
    ext r
    simp [toHenselization, colimitUnit]
  apply ringHom_ext_of_map_le_jacobson he
  · rw [he, RingHom.id_comp, ← Ideal.map_map]
    let J := ⨆ j, (extended (I j)).map
      (of (fun j ↦ algebra (I j)) (directLimitTransition f I hI · · ·) j)
    let : HenselianRing _ J := Ring.DirectLimit.henselianRing (extended_compatible f I hI)
    exact (le_iSup (fun j ↦ (extended (I j)).map
      (of (fun j ↦ algebra (I j)) (directLimitTransition f I hI · · ·) j)) i).trans
        (HenselianRing.jac (I := J))

/-- Henselization commutes with directed colimits of pairs. The ideal on the direct limit
is generated by the images of the stage ideals. The comparison is canonical on every stage,
as expressed by `directLimitEquiv_of`. -/
@[stacks 0A04 "directed systems of pairs"]
noncomputable def directLimitEquiv :
    Ring.DirectLimit (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) ≃+*
      algebra (⨆ i, (I i).map (of R (f · · ·) i)) :=
  RingEquiv.ofRingHom (toHenselization f I hI) (fromHenselization f I hI)
    (to_comp_from f I hI) (from_comp_to f I hI)

/-- On a stage henselization, the colimit comparison is the map induced by the stage's
canonical ring homomorphism to the direct limit. -/
@[simp]
theorem directLimitEquiv_of (i : ι) (x : algebra (I i)) :
    directLimitEquiv f I hI
      (of (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) i x) =
        map (of R (f · · ·) i)
          (le_iSup (fun j ↦ (I j).map (of R (f · · ·) j)) i) x := by
  unfold directLimitEquiv
  rw [RingEquiv.ofRingHom_apply]
  unfold toHenselization
  rw [Ring.DirectLimit.lift_of]

/-- The inverse colimit comparison on base-ring elements is induced by the structure maps
of the stage henselizations. -/
@[simp]
theorem directLimitEquiv_symm_algebraMap (i : ι) (r : R i) :
    (directLimitEquiv f I hI).symm
      (algebraMap _ (algebra (⨆ i, (I i).map (of R (f · · ·) i)))
        (of R (f · · ·) i r)) =
      of (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) i
        (algebraMap (R i) (algebra (I i)) r) := by
  simp [directLimitEquiv, colimitUnit]

/-- The colimit comparison identifies the ideal generated by the stagewise extended ideals
with the extended ideal of the direct limit pair. Thus it is an isomorphism of pairs. -/
@[simp]
theorem map_directLimitEquiv_iSup_map_extended :
    (⨆ i, (extended (I i)).map
      (of (fun i ↦ algebra (I i)) (directLimitTransition f I hI · · ·) i)).map
        (directLimitEquiv f I hI : _ →+* _) =
      extended (⨆ i, (I i).map (of R (f · · ·) i)) := by
  simp only [Ideal.map_iSup, extended, Ideal.map_map]
  congr 1
  funext i
  congr 1
  ext r
  simp

end TauCeti.Henselization
