module

public import TauCeti.RingTheory.Henselization.Map
public import TauCeti.RingTheory.Henselian.Quotient

/-!
# Henselization and quotient base change

For any two ideals `I` and `J` of a commutative ring `R`, henselizing `R/J` along the image
of `I` gives the quotient of the henselization of `(R, I)` by the ideal generated by `J`.
There is no containment condition between the ideals and no Noetherian hypothesis.

The comparison is induced by the functorial map of henselizations. Its inverse comes from
the universal property: a quotient of a henselian pair is henselian. We also identify the
kernel of the functorial map and prove its surjectivity.

## References

* The Stacks Project, Lemma 15.12.7 (Tag 0DYE), the quotient case of integral base change.
-/

public section

namespace TauCeti.Henselization

universe u

variable {R : Type u} [CommRing R] (I J : Ideal R)

private theorem map_le_ker_quotient :
    J.map (algebraMap R (algebra I)) ≤
      RingHom.ker (map (Ideal.Quotient.mk J) (I := I) le_rfl) := by
  rw [Ideal.map_le_iff_le_comap]
  intro r hr
  simp only [Ideal.mem_comap, RingHom.mem_ker, map_algebraMap,
    Ideal.Quotient.eq_zero_iff_mem.mpr hr, map_zero]

private noncomputable def quotientForward :
    algebra I ⧸ J.map (algebraMap R (algebra I)) →+*
      algebra (I.map (Ideal.Quotient.mk J)) :=
  Ideal.Quotient.lift _ (map (Ideal.Quotient.mk J) (I := I) le_rfl)
    (fun _ hx ↦ RingHom.mem_ker.mp (map_le_ker_quotient I J hx))

private theorem map_le_quotient_henselian_ideal :
    (I.map (Ideal.Quotient.mk J)).map
        (algebraMap (R ⧸ J) (algebra I ⧸ J.map (algebraMap R (algebra I)))) ≤
      (extended I).map (Ideal.Quotient.mk (J.map (algebraMap R (algebra I)))) := by
  rw [← Ideal.Quotient.algebraMap_eq, Ideal.map_map,
    ← IsScalarTower.algebraMap_eq, ← Ideal.Quotient.mk_comp_algebraMap, ← Ideal.map_map]

private noncomputable def quotientBackward :
    algebra (I.map (Ideal.Quotient.mk J)) →+*
      algebra I ⧸ J.map (algebraMap R (algebra I)) :=
  (lift (map_le_quotient_henselian_ideal I J)).toRingHom

private theorem quotientBackward_algebraMap (r : R) :
    quotientBackward I J
        (algebraMap (R ⧸ J) (algebra (I.map (Ideal.Quotient.mk J)))
          (Ideal.Quotient.mk J r)) =
      Ideal.Quotient.mk (J.map (algebraMap R (algebra I))) (algebraMap R (algebra I) r) := by
  simpa only [quotientBackward, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
    Ideal.Quotient.algebraMap_quotient_map_quotient] using
    (lift (map_le_quotient_henselian_ideal I J)).commutes (Ideal.Quotient.mk J r)

private theorem quotientBackward_comp_map :
    (quotientBackward I J).comp (map (Ideal.Quotient.mk J) (I := I) le_rfl) =
      Ideal.Quotient.mk (J.map (algebraMap R (algebra I))) := by
  apply ringHom_ext_of_map_le_jacobson (I := I)
  · ext r
    simp only [RingHom.comp_apply, map_algebraMap, quotientBackward_algebraMap]
  · rw [RingHom.comp_assoc, map_comp_algebraMap, ← RingHom.comp_assoc]
    have h : ((quotientBackward I J).comp
        (algebraMap (R ⧸ J) (algebra (I.map (Ideal.Quotient.mk J))))).comp
          (Ideal.Quotient.mk J) =
        (Ideal.Quotient.mk (J.map (algebraMap R (algebra I)))).comp
          (algebraMap R (algebra I)) := RingHom.ext (quotientBackward_algebraMap I J)
    rw [h, ← Ideal.map_map, ← extended]
    rw [Ideal.jacobson_bot]
    exact _root_.HenselianRing.jac

/-- Henselization commutes with quotienting the base by an arbitrary ideal. The forward map
is induced by the quotient map `R → R/J`. -/
@[stacks 0DYE "the quotient case"]
noncomputable def quotientBaseChangeEquiv :
    algebra I ⧸ J.map (algebraMap R (algebra I)) ≃+*
      algebra (I.map (Ideal.Quotient.mk J)) :=
  RingEquiv.ofRingHom (quotientForward I J) (quotientBackward I J)
    (by
      have h : ((quotientForward I J).comp (quotientBackward I J)).comp
          (algebraMap (R ⧸ J) (algebra (I.map (Ideal.Quotient.mk J)))) =
          algebraMap (R ⧸ J) (algebra (I.map (Ideal.Quotient.mk J))) := by
        apply RingHom.ext
        intro r
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
        simp only [RingHom.comp_apply, quotientBackward_algebraMap,
          quotientForward, Ideal.Quotient.lift_mk, map_algebraMap]
      apply ringHom_ext_of_map_le_jacobson (I := I.map (Ideal.Quotient.mk J))
        (h.trans (RingHom.id_comp _).symm)
      rw [h]
      exact extended_le_jacobson _)
    (by
      apply Ideal.Quotient.ringHom_ext
      rw [RingHom.comp_assoc, quotientForward, Ideal.Quotient.lift_comp_mk, RingHom.id_comp]
      exact quotientBackward_comp_map I J)

/-- On quotient representatives, the comparison is the functorial map of henselizations. -/
@[simp]
theorem quotientBaseChangeEquiv_mk (x : algebra I) :
    quotientBaseChangeEquiv I J
        (Ideal.Quotient.mk (J.map (algebraMap R (algebra I))) x) =
      map (Ideal.Quotient.mk J) (I := I) le_rfl x := by
  simp only [quotientBaseChangeEquiv, RingEquiv.ofRingHom_apply, quotientForward,
    Ideal.Quotient.lift_mk]

/-- The inverse comparison sends the image of an element of the original henselization
to its quotient class. -/
@[simp]
theorem quotientBaseChangeEquiv_symm_map (x : algebra I) :
    (quotientBaseChangeEquiv I J).symm (map (Ideal.Quotient.mk J) (I := I) le_rfl x) =
      Ideal.Quotient.mk (J.map (algebraMap R (algebra I))) x := by
  rw [← quotientBaseChangeEquiv_mk, RingEquiv.symm_apply_apply]

/-- On elements of the base ring, the inverse comparison is the quotient of the original
structure map. -/
@[simp]
theorem quotientBaseChangeEquiv_symm_algebraMap (r : R) :
    (quotientBaseChangeEquiv I J).symm
        (algebraMap (R ⧸ J) (algebra (I.map (Ideal.Quotient.mk J))) (Ideal.Quotient.mk J r)) =
      Ideal.Quotient.mk (J.map (algebraMap R (algebra I))) (algebraMap R (algebra I) r) := by
  rw [← map_algebraMap (Ideal.Quotient.mk J) (I := I) le_rfl r,
    quotientBaseChangeEquiv_symm_map]

/-- The functorial map on henselizations induced by quotienting the base is surjective. -/
theorem map_quotient_surjective :
    Function.Surjective (map (Ideal.Quotient.mk J) (I := I) le_rfl) := by
  intro x
  obtain ⟨y, rfl⟩ := (quotientBaseChangeEquiv I J).surjective x
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨y, (quotientBaseChangeEquiv_mk I J y).symm⟩

/-- The kernel of the functorial map induced by `R → R/J` is exactly the ideal generated
by `J` in the original henselization. -/
theorem ker_map_quotient :
    RingHom.ker (map (Ideal.Quotient.mk J) (I := I) le_rfl) =
      J.map (algebraMap R (algebra I)) := by
  ext x
  rw [RingHom.mem_ker, ← quotientBaseChangeEquiv_mk I J,
    map_eq_zero_iff _ (quotientBaseChangeEquiv I J).injective,
    Ideal.Quotient.eq_zero_iff_mem]

end TauCeti.Henselization
