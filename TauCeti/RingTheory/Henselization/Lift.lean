/-!
# The universal property of the henselization of a pair

The henselization of `(R, I)` is universal among henselian pairs `(S, J)` receiving a map of
pairs from `(R, I)`: there is exactly one `R`-algebra map from the henselization to `S`, and it
carries the extended ideal into `J`. In particular a henselian pair is its own henselization.

Uniqueness holds under the weaker hypothesis that `I` generates an ideal of `S` inside its
Jacobson radical: an `R`-algebra map out of the henselization is determined by its restrictions
to the étale neighbourhoods, and each restriction is a map out of an étale algebra which is
already determined modulo `IS`. For existence, each étale neighbourhood `B` of `(R, I)` base
changes to an étale neighbourhood `S ⊗[R] B` of `(S, J)`, which has a section over the
henselian pair `(S, J)`. By uniqueness these maps `B → S` form a cocone, and the colimit
property of the henselization assembles them.

## Main results

* `TauCeti.Henselization.algHom_ext_of_map_le_jacobson`: maps out of the henselization are
  unique once `IS` lies in the Jacobson radical of `S`.
* `TauCeti.Henselization.ringHom_ext_of_map_le_jacobson`: ring maps out of the henselization of
  `(R, I)` agreeing on `R` are equal once the image of `I` lies in the Jacobson radical.
* `TauCeti.Henselization.lift`: the map from the henselization of `(R, I)` to a henselian pair
  `(S, J)` with `IS ⊆ J`.
* `TauCeti.Henselization.existsUnique_lift`: the universal property of the henselization.
* `TauCeti.Henselization.algEquivOfHenselianRing`: if `(R, I)` is henselian, its henselization
  is `R`.

## Implementation notes

The henselization is a colimit in `CommAlgCat.{u} R`, while the target `S` may live in any
universe. The cocone is therefore built on the `R`-subalgebra of `S` generated by the images of
the stages, which is `u`-small, and transported along `Shrink`.

## References

* [Stacks Project, Lemma 15.12.1](https://stacks.math.columbia.edu/tag/0A02), the universal
  property of the henselization of a pair.
* The Stacks Project, Lemma 15.11.5, uniqueness of sections modulo an ideal in the Jacobson
  radical.
-/

public section

open CategoryTheory Limits TensorProduct

universe u v w

namespace TauCeti.Henselization

variable {R : Type u} [CommRing R] {I : Ideal R}

/-- Two `R`-algebra maps out of the henselization of `(R, I)` agree as soon as `I` generates an
ideal of the target inside its Jacobson radical. In particular, maps of pairs from the
henselization of `(R, I)` to a henselian pair are unique. -/
theorem algHom_ext_of_map_le_jacobson {S : Type*} [CommRing S] [Algebra R S]
    (hI : I.map (algebraMap R S) ≤ Ideal.jacobson ⊥) {f g : algebra I →ₐ[R] S} : f = g := by
  ext x
  obtain ⟨B, b, rfl⟩ := exists_stage_eq I x
  exact DFunLike.congr_fun (B.property.algHom_ext hI (f := f.comp (stage I B))
    (g := g.comp (stage I B))) b

/-- Two ring maps out of the henselization of `(R, I)` which agree on `R` are equal as soon as
`I` generates an ideal of the target inside its Jacobson radical. -/
theorem ringHom_ext_of_map_le_jacobson {T : Type*} [CommRing T] {g₁ g₂ : algebra I →+* T}
    (h : g₁.comp (algebraMap R (algebra I)) = g₂.comp (algebraMap R (algebra I)))
    (hI : I.map (g₁.comp (algebraMap R (algebra I))) ≤ Ideal.jacobson ⊥) : g₁ = g₂ := by
  let : Algebra R T := (g₁.comp (algebraMap R (algebra I))).toAlgebra
  have hfg := algHom_ext_of_map_le_jacobson (I := I) hI (f := ⟨g₁, fun _ ↦ rfl⟩)
    (g := ⟨g₂, fun r ↦ (DFunLike.congr_fun h r).symm⟩)
  exact RingHom.ext fun x ↦ DFunLike.congr_fun hfg x

section Lift

variable {S : Type v} [CommRing S] [Algebra R S] {J : Ideal S} [HenselianRing S J]

variable (J) in
/-- A chosen `R`-algebra map from an étale neighbourhood of `(R, I)` to `S`. -/
private noncomputable def stageLift (hIJ : I.map (algebraMap R S) ≤ J)
    (B : Neighbourhood.{u, u} I) : B.obj →ₐ[R] S :=
  (B.property.nonempty_algHom hIJ).some

variable (J) in
private theorem stageLift_comp (hIJ : I.map (algebraMap R S) ≤ J)
    {B C : Neighbourhood.{u, u} I} (f : B ⟶ C) :
    (stageLift J hIJ C).comp f.hom.hom = stageLift J hIJ B :=
  B.property.algHom_ext (hIJ.trans HenselianRing.jac)

variable (J) in
/-- The `R`-subalgebra of `S` generated by the images of the stages of the small diagram. It is
`u`-small, and contains the image of every stage. -/
private noncomputable abbrev liftRange (hIJ : I.map (algebraMap R S) ≤ J) : Subalgebra R S :=
  Algebra.adjoin R (Set.range fun p : Σ j, (diagram I).obj j ↦
    stageLift J hIJ ((equivSmallModel (Neighbourhood.{u, u} I)).inverse.obj p.1) p.2)

variable (J) in
private theorem stageLift_mem (hIJ : I.map (algebraMap R S) ≤ J) (B : Neighbourhood.{u, u} I)
    (b : B.obj) : stageLift J hIJ B b ∈ liftRange J hIJ := by
  let E := equivSmallModel (Neighbourhood.{u, u} I)
  have hmem : stageLift J hIJ (E.inverse.obj (E.functor.obj B))
      ((E.unitIso.hom.app B).hom.hom b) ∈ liftRange J hIJ :=
    Algebra.subset_adjoin ⟨⟨E.functor.obj B, (E.unitIso.hom.app B).hom.hom b⟩, rfl⟩
  -- The target of the equivalence unit is only definitionally `E.inverse.obj (E.functor.obj B)`.
  convert hmem using 1
  exact (DFunLike.congr_fun (stageLift_comp J hIJ (E.unitIso.hom.app B)) b).symm

variable (J) in
/-- The cocone on the étale neighbourhoods of `(R, I)` given by the maps to `S`, with apex a
`u`-small model of `liftRange`. -/
private noncomputable def liftCocone (hIJ : I.map (algebraMap R S) ≤ J) :
    Cocone (IsNeighbourhood I).ι where
  pt := CommAlgCat.of R (Shrink.{u} (liftRange J hIJ))
  ι :=
    { app B := CommAlgCat.ofHom <| (Shrink.algEquiv R (liftRange J hIJ)).symm.toAlgHom.comp <|
        (stageLift J hIJ B).codRestrict _ (stageLift_mem J hIJ B)
      naturality {B C} f := by
        ext b
        simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id,
          CommAlgCat.hom_comp, CommAlgCat.hom_ofHom, AlgHom.comp_apply, ObjectProperty.ι_map]
        congr 1
        exact Subtype.ext (DFunLike.congr_fun (stageLift_comp J hIJ f) b) }

/-- The `R`-algebra map from the henselization of `(R, I)` to a henselian pair `(S, J)` with
`IS ⊆ J`. It is the unique `R`-algebra map (`existsUnique_lift`). -/
noncomputable def lift (hIJ : I.map (algebraMap R S) ≤ J) : algebra I →ₐ[R] S :=
  ((liftRange J hIJ).val.comp (Shrink.algEquiv.{u} R (liftRange J hIJ)).toAlgHom).comp
    (desc I (liftCocone J hIJ))

/-- Every `R`-algebra map from the henselization of `(R, I)` to a henselian pair `(S, J)` with
`IS ⊆ J` is `lift`. -/
theorem eq_lift (hIJ : I.map (algebraMap R S) ≤ J) (f : algebra I →ₐ[R] S) : f = lift hIJ :=
  algHom_ext_of_map_le_jacobson (hIJ.trans HenselianRing.jac)

/-- On the stage of an étale neighbourhood `B`, `lift` restricts to any `R`-algebra map
`B → S`: there is exactly one such map. -/
theorem lift_comp_stage (hIJ : I.map (algebraMap R S) ≤ J) (B : Neighbourhood.{u, u} I)
    (φ : B.obj →ₐ[R] S) : (lift hIJ).comp (stage I B) = φ :=
  B.property.algHom_ext (hIJ.trans HenselianRing.jac)

/-- On the stage of an étale neighbourhood `B`, `lift` agrees with any `R`-algebra map
`B → S`. -/
theorem lift_stage (hIJ : I.map (algebraMap R S) ≤ J) (B : Neighbourhood.{u, u} I)
    (φ : B.obj →ₐ[R] S) (b : B.obj) : lift hIJ (stage I B b) = φ b :=
  DFunLike.congr_fun (lift_comp_stage hIJ B φ) b

variable (J) in
/-- **The universal property of the henselization.** For a henselian pair `(S, J)` receiving a
map of pairs from `(R, I)`, there is a unique `R`-algebra map from the henselization of
`(R, I)` to `S` carrying the extended ideal into `J`. -/
@[stacks 0A02 "universal property"]
theorem existsUnique_lift (hIJ : I.map (algebraMap R S) ≤ J) :
    ∃! f : algebra I →ₐ[R] S, (extended I).map f ≤ J :=
  ⟨lift hIJ, (map_extended I _).trans_le hIJ, fun f _ ↦ eq_lift hIJ f⟩

end Lift

section Henselian

variable (I) [HenselianRing R I]

/-- A henselian pair is its own henselization: if `(R, I)` is henselian, the structure map from
`R` to its henselization along `I` is an isomorphism. -/
noncomputable def algEquivOfHenselianRing : algebra I ≃ₐ[R] R :=
  AlgEquiv.ofAlgHom (lift (J := I) (by simp)) (Algebra.ofId R (algebra I))
    (Subsingleton.elim _ _)
    (algHom_ext_of_map_le_jacobson (extended_le_jacobson I))

/-- The inverse of `algEquivOfHenselianRing` is the structure map of the henselization. -/
@[simp]
theorem algEquivOfHenselianRing_symm_apply (r : R) :
    (algEquivOfHenselianRing I).symm r = algebraMap R (algebra I) r := by
  simpa using (algEquivOfHenselianRing I).symm.commutes r

/-- If `(R, I)` is henselian, the structure map from `R` to its henselization along `I` is
bijective. -/
theorem bijective_algebraMap_of_henselianRing : Function.Bijective (algebraMap R (algebra I)) := by
  have h : ⇑(algEquivOfHenselianRing I).symm = algebraMap R (algebra I) :=
    funext (algEquivOfHenselianRing_symm_apply I)
  exact h ▸ (algEquivOfHenselianRing I).symm.bijective

end Henselian

-- The henselization along the zero ideal does nothing.
example : Nonempty (algebra (⊥ : Ideal R) ≃ₐ[R] R) :=
  ⟨algEquivOfHenselianRing ⊥⟩

-- The ordinary henselization of the finite field `𝔽₅` is `𝔽₅`.
example : Nonempty (algebra (⊥ : Ideal (ZMod 5)) ≃ₐ[ZMod 5] ZMod 5) :=
  ⟨algEquivOfHenselianRing ⊥⟩

end TauCeti.Henselization
