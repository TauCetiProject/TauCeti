module

public import Mathlib.Algebra.Colimit.Ring
public import Mathlib.Algebra.Polynomial.Lifts
public import Mathlib.RingTheory.Henselian

/-!
# Henselian pairs under directed colimits

Let `(G i, I i)` be a directed system of pairs of a commutative ring and an ideal, indexed by a
nonempty directed preorder, whose transition maps `f i j` carry `I i` into `I j`. The colimit
ideal of `Ring.DirectLimit G f` is `⨆ i, (I i).map (of G f i)`. Its elements are exactly the
images of elements of the `I i` (`Ring.DirectLimit.mem_iSup_map_of_iff`), and an element of a
stage whose image lies in the colimit ideal already lies in `I j` at some later stage
(`Ring.DirectLimit.exists_f_mem_of_of_mem_iSup_map`); likewise for units modulo these ideals.

The main result, `Ring.DirectLimit.henselianRing`, is that the colimit of Henselian pairs is a
Henselian pair. A monic polynomial over the colimit with a simple root modulo the colimit ideal
comes, together with its approximate root and the witnesses for both conditions, from a single
stage; the root found there maps to the required root in the colimit. This is the
filtered-colimit case of the permanence properties of Henselian pairs. Directedness is essential:
the coproduct of two copies of `(ℤ_[p], (p))`, which is not a directed colimit, is not Henselian
along `p`.

## Main results

* `Ring.DirectLimit.mem_iSup_map_of_iff`: membership in the colimit ideal.
* `Ring.DirectLimit.exists_f_mem_of_of_mem_iSup_map`,
  `Ring.DirectLimit.exists_isUnit_mk_f_of_isUnit_mk_of`: descent of membership in the colimit
  ideal, and of units modulo it, to a finite stage.
* `Ring.DirectLimit.Polynomial.exists_monic_of`: a monic polynomial over the colimit comes from a
  monic polynomial over some stage.
* `Ring.DirectLimit.henselianRing`: a directed colimit of Henselian pairs is Henselian along the
  colimit ideal.

## References

* [Stacks Project, Lemma 15.11.13](https://stacks.math.columbia.edu/tag/0FWT).
* [Stacks Project, Example 15.11.14](https://stacks.math.columbia.edu/tag/0FWU) for the failure
  along non-filtered colimits.
-/

public section

open Polynomial

namespace Ring.DirectLimit

variable {ι : Type*} [Preorder ι] {G : ι → Type*} [∀ i, CommRing (G i)]
  {f : ∀ i j, i ≤ j → G i →+* G j} {I : ∀ i, Ideal (G i)}

/-- The canonical maps into a direct limit are compatible with the transition maps. -/
@[simp]
theorem of_comp_f {i j : ι} (hij : i ≤ j) :
    (of G (f · · ·) j).comp (f i j hij) = of G (f · · ·) i :=
  RingHom.ext fun _ ↦ of_f _ _

/-- In a directed colimit of rings, the ideal generated by the images of a compatible family of
ideals consists of the images of their elements. -/
theorem mem_iSup_map_of_iff [Nonempty ι] [IsDirectedOrder ι]
    (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (f i j hij)) {z : DirectLimit G (f · · ·)} :
    z ∈ ⨆ i, (I i).map (of G (f · · ·) i) ↔ ∃ i, ∃ x ∈ I i, of G (f · · ·) i x = z := by
  refine ⟨fun hz ↦ ?_, fun ⟨i, x, hx, hxz⟩ ↦
    hxz ▸ Ideal.mem_iSup_of_mem i (Ideal.mem_map_of_mem _ hx)⟩
  -- The images of the elements of the `I i` already form an ideal of the colimit.
  let J : Ideal (DirectLimit G (f · · ·)) :=
    { carrier := {z | ∃ i, ∃ x ∈ I i, of G (f · · ·) i x = z}
      zero_mem' := ⟨Classical.arbitrary ι, 0, zero_mem _, map_zero _⟩
      add_mem' := by
        rintro _ _ ⟨i, x, hx, rfl⟩ ⟨j, y, hy, rfl⟩
        obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
        exact ⟨k, f i k hik x + f j k hjk y, add_mem (hI i k hik hx) (hI j k hjk hy),
          by simp⟩
      smul_mem' := by
        rintro c _ ⟨i, x, hx, rfl⟩
        induction c using DirectLimit.induction_on with
        | ih j y =>
          obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
          exact ⟨k, f j k hjk y * f i k hik x, Ideal.mul_mem_left _ _ (hI i k hik hx),
            by simp⟩ }
  exact (iSup_le fun i ↦ Ideal.map_le_iff_le_comap.2 fun x hx ↦ ⟨i, x, hx, rfl⟩ :
    ⨆ i, (I i).map (of G (f · · ·) i) ≤ J) hz

/-- If the image of an element of a stage lies in the colimit of a compatible family of ideals,
then the element is carried into the ideal at some later stage. -/
theorem exists_f_mem_of_of_mem_iSup_map [IsDirectedOrder ι] [DirectedSystem G (f · · ·)]
    (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (f i j hij)) {i : ι} {x : G i}
    (hx : of G (f · · ·) i x ∈ ⨆ i, (I i).map (of G (f · · ·) i)) :
    ∃ j, ∃ hij : i ≤ j, f i j hij x ∈ I j := by
  have : Nonempty ι := ⟨i⟩
  obtain ⟨m, y, hy, hyx⟩ := (mem_iSup_map_of_iff hI).1 hx
  obtain ⟨k, hik, hmk⟩ := exists_ge_ge i m
  obtain ⟨j, hkj, hj⟩ : ∃ j, ∃ hkj : k ≤ j, f k j hkj (f i k hik x - f m k hmk y) = 0 :=
    of.zero_exact (by simp [hyx])
  refine ⟨j, hik.trans hkj, ?_⟩
  rw [map_sub, sub_eq_zero, DirectedSystem.map_map' f, DirectedSystem.map_map' f] at hj
  exact hj ▸ hI m j _ hy

/-- If an element of a stage is a unit modulo the colimit of a compatible family of ideals, then
it is a unit modulo the ideal at some later stage. -/
theorem exists_isUnit_mk_f_of_isUnit_mk_of [IsDirectedOrder ι] [DirectedSystem G (f · · ·)]
    (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (f i j hij)) {i : ι} {x : G i}
    (hx : IsUnit (Ideal.Quotient.mk (⨆ i, (I i).map (of G (f · · ·) i)) (of G (f · · ·) i x))) :
    ∃ j, ∃ hij : i ≤ j, IsUnit (Ideal.Quotient.mk (I j) (f i j hij x)) := by
  have : Nonempty ι := ⟨i⟩
  obtain ⟨u, hu⟩ := hx.exists_left_inv
  obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective u
  obtain ⟨m, v, rfl⟩ := exists_of u
  obtain ⟨k, hik, hmk⟩ := exists_ge_ge i m
  rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq] at hu
  obtain ⟨j, hkj, hj⟩ := exists_f_mem_of_of_mem_iSup_map hI
    (x := f m k hmk v * f i k hik x - 1) (by simpa using hu)
  refine ⟨j, hik.trans hkj, .of_mul_eq_one_right (Ideal.Quotient.mk _ (f m j (hmk.trans hkj) v)) ?_⟩
  rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq]
  simpa [DirectedSystem.map_map' f] using hj

/-- A monic polynomial over a directed colimit of rings is the image of a monic polynomial over
some stage. -/
theorem Polynomial.exists_monic_of [Nonempty ι] [IsDirectedOrder ι]
    {P : (DirectLimit G (f · · ·))[X]} (hP : P.Monic) :
    ∃ i, ∃ p : (G i)[X], p.Monic ∧ p.map (of G (f · · ·) i) = P := by
  obtain ⟨i, p, hp⟩ := Ring.DirectLimit.Polynomial.exists_of P
  obtain ⟨q, hq, -, hqm⟩ := lifts_and_natDegree_eq_and_monic ((mem_lifts P).2 ⟨p, hp⟩) hP
  exact ⟨i, q, hqm, hq⟩

/-- **Henselian pairs are stable under directed colimits.** If every `(G i, I i)` is a
Henselian pair and the transition maps carry `I i` into `I j`, then the directed colimit
`Ring.DirectLimit G f` is Henselian along the colimit ideal `⨆ i, (I i).map (of G f i)`. -/
theorem henselianRing [Nonempty ι] [IsDirectedOrder ι] [DirectedSystem G (f · · ·)]
    [∀ i, HenselianRing (G i) (I i)]
    (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (f i j hij)) :
    HenselianRing (DirectLimit G (f · · ·)) (⨆ i, (I i).map (of G (f · · ·) i)) where
  jac z hz := by
    obtain ⟨i, x, hx, rfl⟩ := (mem_iSup_map_of_iff hI).1 hz
    refine Ideal.mem_jacobson_bot.2 fun c ↦ ?_
    induction c using DirectLimit.induction_on with
    | ih j y =>
      obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
      have hu := Ideal.mem_jacobson_bot.1
        (HenselianRing.jac (I := I k) (hI i k hik hx)) (f j k hjk y)
      simpa using hu.map (of G (f · · ·) k)
  is_henselian P hP a₀ h₁ h₂ := by
    -- Lift `P` to a monic polynomial `q` and `a₀` to an element `b`, at a common stage `k`.
    obtain ⟨i, q, hqm, rfl⟩ := Polynomial.exists_monic_of hP
    obtain ⟨j, b, rfl⟩ := exists_of a₀
    obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
    rw [← of_comp_f hik, ← Polynomial.map_map, ← of_f hjk] at h₁ h₂ ⊢
    rw [eval_map, eval₂_at_apply] at h₁
    rw [derivative_map, eval_map, eval₂_at_apply] at h₂
    -- Both conditions descend to a common later stage `l`, where `(G l, I l)` is Henselian.
    obtain ⟨l₁, hkl₁, h₁⟩ := exists_f_mem_of_of_mem_iSup_map hI h₁
    obtain ⟨l₂, hkl₂, h₂⟩ := exists_isUnit_mk_f_of_isUnit_mk_of hI h₂
    obtain ⟨l, hl₁l, hl₂l⟩ := exists_ge_ge l₁ l₂
    have hkl := hkl₁.trans hl₁l
    have h₁ : f k l hkl ((q.map (f i k hik)).eval (f j k hjk b)) ∈ I l := by
      simpa only [Ideal.mem_comap, DirectedSystem.map_map' f] using hI l₁ l hl₁l h₁
    have h₂ := h₂.map (Ideal.quotientMap (I l) (f l₂ l hl₂l) (hI l₂ l hl₂l))
    rw [Ideal.quotientMap_mk, DirectedSystem.map_map' f] at h₂
    obtain ⟨a, ha, hab⟩ := HenselianRing.is_henselian (I := I l)
      ((q.map (f i k hik)).map (f k l hkl)) ((hqm.map _).map _) (f k l hkl (f j k hjk b))
      (by rwa [eval_map, eval₂_at_apply])
      (by rwa [derivative_map, eval_map, eval₂_at_apply])
    refine ⟨of G (f · · ·) l a, ?_, ?_⟩
    · rw [IsRoot, ← of_comp_f hkl, ← Polynomial.map_map, eval_map, eval₂_at_apply, ha.eq_zero,
        map_zero]
    · rw [← of_f hkl, ← map_sub]
      exact (mem_iSup_map_of_iff hI).2 ⟨l, _, hab, rfl⟩

end Ring.DirectLimit
