module

public import TauCeti.RingTheory.MvPolynomial.Jacobian.Minors
public import Mathlib.RingTheory.Ideal.Colon

/-!
# Elkik's presentation Jacobian ideal

For equations `f`, the ideal `elkikJacobianIdeal f` is the sum, over finite subsets `s`
of equations, of the full-size Jacobian minor ideal times the colon of the selected
relation ideal by the full relation ideal. The empty subset contributes the annihilator
of the relation ideal. This is the polynomial ideal used in approximation theorems;
no passage to the quotient or presentation independence is asserted here.

The construction follows Renée Elkik, *Solutions d'équations à coefficients dans un
anneau hensélien*, Ann. Sci. École Norm. Sup. (4) 6 (1973), §0.2, p. 555.
The full-size minor ideals are defined in
`TauCeti.RingTheory.MvPolynomial.Jacobian.Minors`.
-/

public section

namespace MvPolynomial

variable {R S σ ι : Type*} [CommRing R] [CommRing S] [DecidableEq σ]

/-- Elkik's Jacobian ideal of a family of polynomial equations.
The contribution of `s` is the full-size minor ideal multiplied by the ideal of
multipliers carrying all relations into the ideal generated by the selected equations. -/
noncomputable def elkikJacobianIdeal (f : σ → MvPolynomial ι R) :
    Ideal (MvPolynomial ι R) :=
  ⨆ s : Finset σ, jacobianMinorsIdeal f s *
    (Ideal.span (f '' (s : Set σ))).colon (Ideal.span (Set.range f))

/-- The sum formula characterizing Elkik's presentation Jacobian ideal. -/
theorem elkikJacobianIdeal_eq_iSup (f : σ → MvPolynomial ι R) :
    elkikJacobianIdeal f = ⨆ s : Finset σ, jacobianMinorsIdeal f s *
      (Ideal.span (f '' (s : Set σ))).colon (Ideal.span (Set.range f)) := (rfl)

/-- An ideal contains Elkik's ideal exactly when it contains every finite-subset
contribution. This exposes its universal property without unfolding the definition. -/
theorem elkikJacobianIdeal_le_iff (f : σ → MvPolynomial ι R)
    (I : Ideal (MvPolynomial ι R)) :
    elkikJacobianIdeal f ≤ I ↔ ∀ s : Finset σ, jacobianMinorsIdeal f s *
      (Ideal.span (f '' (s : Set σ))).colon (Ideal.span (Set.range f)) ≤ I := by
  rw [elkikJacobianIdeal_eq_iSup, iSup_le_iff]

/-- Every finite-subset contribution belongs to Elkik's presentation Jacobian ideal. -/
theorem jacobianMinorsIdeal_mul_colon_le_elkikJacobianIdeal
    (f : σ → MvPolynomial ι R) (s : Finset σ) :
    jacobianMinorsIdeal f s *
      (Ideal.span (f '' (s : Set σ))).colon (Ideal.span (Set.range f)) ≤
        elkikJacobianIdeal f := by
  exact (elkikJacobianIdeal_le_iff f _).mp le_rfl s

/-- A minor-ideal element times a multiplier carrying all relations into the selected
relation ideal belongs to Elkik's ideal. -/
theorem mul_mem_elkikJacobianIdeal (f : σ → MvPolynomial ι R) (s : Finset σ)
    {a b : MvPolynomial ι R} (ha : a ∈ jacobianMinorsIdeal f s)
    (hb : b ∈ (Ideal.span (f '' (s : Set σ))).colon (Ideal.span (Set.range f))) :
    a * b ∈ elkikJacobianIdeal f :=
  jacobianMinorsIdeal_mul_colon_le_elkikJacobianIdeal f s (Ideal.mul_mem_mul ha hb)

/-- The empty selection contributes precisely the annihilator of all relations. -/
theorem jacobianMinorsIdeal_empty_mul_colon (f : σ → MvPolynomial ι R) :
    jacobianMinorsIdeal f ∅ *
      (Ideal.span (f '' ((∅ : Finset σ) : Set σ))).colon (Ideal.span (Set.range f)) =
        (Ideal.span (Set.range f)).annihilator := by
  simp only [Finset.coe_empty, Set.image_empty, Ideal.span_empty, jacobianMinorsIdeal_empty,
    Ideal.top_mul, Submodule.bot_colon]

/-- If one equation generates all relations, its contribution is its partial-derivative ideal. -/
theorem jacobianMinorsIdeal_singleton_mul_colon (f : σ → MvPolynomial ι R) (a : σ)
    (hf : Ideal.span (Set.range f) ≤ Ideal.span {f a}) :
    jacobianMinorsIdeal f {a} *
      (Ideal.span (f '' (({a} : Finset σ) : Set σ))).colon (Ideal.span (Set.range f)) =
        Ideal.span (Set.range fun i => pderiv i (f a)) := by
  rw [Finset.coe_singleton, Set.image_singleton, Submodule.colon_eq_top_iff_le.mpr hf,
    Ideal.mul_top, jacobianMinorsIdeal_singleton]

/-- The empty-subset contribution is the annihilator of the relation ideal. -/
theorem annihilator_span_range_le_elkikJacobianIdeal (f : σ → MvPolynomial ι R) :
    (Ideal.span (Set.range f)).annihilator ≤ elkikJacobianIdeal f := by
  have h := jacobianMinorsIdeal_mul_colon_le_elkikJacobianIdeal f ∅
  simpa only [jacobianMinorsIdeal_empty_mul_colon] using h

/-- With no equations, Elkik's ideal is the unit ideal. -/
@[simp] theorem elkikJacobianIdeal_isEmpty [IsEmpty σ] (f : σ → MvPolynomial ι R) :
    elkikJacobianIdeal f = ⊤ := by
  have h := annihilator_span_range_le_elkikJacobianIdeal f
  have hf : Ideal.span (Set.range f) = ⊥ := by simp
  rw [hf, Submodule.annihilator_bot] at h
  exact top_unique h

/-- Under coefficient change Elkik's ideal can grow, since the colon factors can grow. -/
theorem map_elkikJacobianIdeal_le (g : R →+* S) (f : σ → MvPolynomial ι R) :
    Ideal.map (MvPolynomial.map g) (elkikJacobianIdeal f) ≤
      elkikJacobianIdeal (fun j => MvPolynomial.map g (f j)) := by
  rw [elkikJacobianIdeal_eq_iSup, Ideal.map_iSup]
  refine iSup_le fun s => ?_
  rw [Ideal.map_mul, map_jacobianMinorsIdeal]
  refine (Ideal.mul_mono le_rfl ?_).trans
    (jacobianMinorsIdeal_mul_colon_le_elkikJacobianIdeal _ s)
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap, Ideal.colon_span, Submodule.mem_colon]
  rintro _ ⟨j, rfl⟩
  have haj := (Submodule.mem_colon.mp ha) (f j) (Ideal.subset_span ⟨j, rfl⟩)
  have hselected : Ideal.map (MvPolynomial.map g) (Ideal.span (f '' (s : Set σ))) =
      Ideal.span ((fun j => MvPolynomial.map g (f j)) '' (s : Set σ)) := by
    rw [Ideal.map_span, Set.image_image]
  simpa only [smul_eq_mul, map_mul, hselected] using
    Ideal.mem_map_of_mem (MvPolynomial.map g) haj

/-- A one-equation presentation has the annihilator contribution and the partial derivatives. -/
theorem elkikJacobianIdeal_unique [Unique σ] (f : σ → MvPolynomial ι R) :
    elkikJacobianIdeal f = (Ideal.span {f default}).annihilator ⊔
      Ideal.span (Set.range fun i => pderiv i (f default)) := by
  have hrange : Set.range f = {f default} := Set.range_unique
  have hspan : Ideal.span (Set.range f) ≤ Ideal.span {f default} := by rw [hrange]
  apply le_antisymm
  · rw [elkikJacobianIdeal_le_iff]
    intro s
    by_cases hs : s = ∅
    · subst s
      rw [jacobianMinorsIdeal_empty_mul_colon, hrange]
      exact le_sup_left
    · have hs' : s = {default} :=
        (Finset.nonempty_iff_ne_empty.mpr hs).eq_singleton_default
      rw [hs', jacobianMinorsIdeal_singleton_mul_colon f default hspan]
      exact le_sup_right
  · refine sup_le ?_ ?_
    · simpa only [hrange] using annihilator_span_range_le_elkikJacobianIdeal f
    · have h := jacobianMinorsIdeal_mul_colon_le_elkikJacobianIdeal f {default}
      simpa only [jacobianMinorsIdeal_singleton_mul_colon f default hspan] using h

/-- For a single equation that is a non-zero-divisor, only its partials contribute. -/
theorem elkikJacobianIdeal_unique_of_mem_nonZeroDivisors [Unique σ]
    (f : σ → MvPolynomial ι R) (hf : f default ∈ nonZeroDivisors (MvPolynomial ι R)) :
    elkikJacobianIdeal f = Ideal.span (Set.range fun i => pderiv i (f default)) := by
  rw [elkikJacobianIdeal_unique]
  have h : (Ideal.span {f default}).annihilator = ⊥ := by
    ext a
    simp only [Ideal.span, Submodule.mem_annihilator_span_singleton, smul_eq_mul,
      Submodule.mem_bot, mul_right_mem_nonZeroDivisors_eq_zero_iff hf]
  rw [h, bot_sup_eq]

end MvPolynomial
