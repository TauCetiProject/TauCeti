section FullFaithful

variable {R : Type u} [CommRing R] (I : Ideal R) [HenselianRing R I]
  {A : Type v} [CommRing A] [Algebra R A] [Algebra.Etale R A]
  {B : Type w} [CommRing B] [Algebra R B] [Module.Finite R B] [Module.Projective R B]

/-- Over a Henselian pair `(R, I)`, postcomposing with `B → (R ⧸ I) ⊗[R] B` is a bijection on
`R`-algebra maps `A → B` from an étale `R`-algebra `A` into a finitely generated projective
`R`-algebra `B`. -/
theorem includeRight_comp_bijective :
    Function.Bijective
      ((Algebra.TensorProduct.includeRight (R := R) (A := R ⧸ I) (B := B)).comp :
        (A →ₐ[R] B) → A →ₐ[R] (R ⧸ I) ⊗[R] B) := by
  let W := WeilRestriction R B (B ⊗[R] A)
  let e₁ : (A →ₐ[R] B) ≃ (W →ₐ[R] R) :=
    (AlgEquiv.arrowCongr (AlgEquiv.refl : A ≃ₐ[R] A) (Algebra.TensorProduct.lid R B).symm).trans
      (WeilRestriction.tensorHomEquiv R B A R).symm
  let e₂ : (W →ₐ[R] R ⧸ I) ≃ (A →ₐ[R] (R ⧸ I) ⊗[R] B) :=
    WeilRestriction.tensorHomEquiv R B A (R ⧸ I)
  have hfactor : ((Algebra.TensorProduct.includeRight (R := R) (A := R ⧸ I) (B := B)).comp :
      (A →ₐ[R] B) → A →ₐ[R] (R ⧸ I) ⊗[R] B) =
        e₂ ∘ (Ideal.Quotient.mkₐ R I).comp ∘ e₁ := by
    ext f : 1
    dsimp only [Function.comp_apply, e₁, e₂, Equiv.trans_apply]
    rw [WeilRestriction.tensorHomEquiv_comp, Equiv.apply_symm_apply]
    ext a
    simp
  rw [hfactor]
  exact e₂.bijective.comp ((comp_bijective I (A := W)).comp e₁.bijective)

/-- Over a Henselian pair `(R, I)`, postcomposing with `B → B ⧸ IB` is a bijection on `R`-algebra
maps `A → B` from an étale `R`-algebra `A` into a finitely generated projective `R`-algebra `B`. -/
theorem comp_quotient_bijective :
    Function.Bijective
      ((Ideal.Quotient.mkₐ R (I.map (algebraMap R B))).comp :
        (A →ₐ[R] B) → A →ₐ[R] B ⧸ I.map (algebraMap R B)) := by
  let e : (A →ₐ[R] B ⧸ I.map (algebraMap R B)) ≃ (A →ₐ[R] (R ⧸ I) ⊗[R] B) :=
    AlgEquiv.arrowCongr AlgEquiv.refl
      ((Algebra.TensorProduct.quotIdealMapEquivQuotTensor B I).restrictScalars R)
  have hfactor : e ∘ ((Ideal.Quotient.mkₐ R (I.map (algebraMap R B))).comp :
      (A →ₐ[R] B) → A →ₐ[R] B ⧸ I.map (algebraMap R B)) =
        (Algebra.TensorProduct.includeRight (R := R) (A := R ⧸ I) (B := B)).comp := by
    ext f a
    simp [e]
  exact (e.bijective.of_comp_iff' _).mp (hfactor.symm ▸ includeRight_comp_bijective I)

/-- Over a Henselian pair `(R, I)`, base change to `R ⧸ I` is a bijection from `R`-algebra maps
`A → B` to `(R ⧸ I)`-algebra maps `(R ⧸ I) ⊗[R] A → (R ⧸ I) ⊗[R] B`, when `A` is étale over `R`
and `B` is finitely generated and projective as an `R`-module. -/
theorem tensorProduct_map_bijective :
    Function.Bijective
      (fun f : A →ₐ[R] B ↦ Algebra.TensorProduct.map (AlgHom.id (R ⧸ I) (R ⧸ I)) f) := by
  let e := AlgHom.liftEquiv R (R ⧸ I) A ((R ⧸ I) ⊗[R] B)
  have hfactor : (fun f : A →ₐ[R] B ↦ Algebra.TensorProduct.map (AlgHom.id (R ⧸ I) (R ⧸ I)) f) =
      e ∘ (Algebra.TensorProduct.includeRight (R := R) (A := R ⧸ I) (B := B)).comp := by
    ext f a
    simp [e]
  rw [hfactor]
  exact e.bijective.comp (includeRight_comp_bijective I)

end FullFaithful

section EssSurjHelpers

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- If `A ⧸ IA` is module-finite over `R` and `A` agrees with a subalgebra `A'` on basic opens
`D(r)` (`r ∈ s`) covering `Spec A`, there is a family `u : s → A'` such that `∑ r, u r * r` is
congruent to `1` modulo `IA`. -/
private theorem exists_sum_mul_sub_one_mem_map (I : Ideal R)
    [Module.Finite R (A ⧸ I.map (algebraMap R A))]
    (A' : Subalgebra R A) (s : Finset A) (hsA' : (s : Set A) ⊆ A')
    (hspan : Ideal.span (s : Set A) = ⊤) (hZ : ∀ r ∈ s, ∀ x : A, ∀ᶠ m in atTop, r ^ m * x ∈ A') :
    ∃ u : ↥(s : Set A) → A',
      ((∑ r : ↥(s : Set A), u r * ⟨r.1, hsA' r.2⟩ : A') : A) - 1 ∈ I.map (algebraMap R A) := by
  classical
  obtain ⟨k, y₀, hy₀⟩ := Module.Finite.exists_fin (R := R) (M := A ⧸ I.map (algebraMap R A))
  choose y hy using fun l ↦ Ideal.Quotient.mk_surjective (y₀ l)
  obtain ⟨N, hN⟩ : ∃ N, ∀ r ∈ s, ∀ l, r ^ N * y l ∈ A' :=
    ((eventually_all_finset s).mpr fun r hr ↦ eventually_all.mpr fun l ↦ hZ r hr (y l)).exists
  have h1 : (1 : A) ∈ Ideal.span ((· ^ (N + (N + 1))) '' (s : Set A)) := by
    rw [Ideal.span_pow_eq_top _ hspan]
    trivial
  obtain ⟨w, hw⟩ := (Fintype.mem_span_image_iff_exists_fun A).mp h1
  have hmem (r : ↥(s : Set A)) :
      Ideal.Quotient.mk (I.map (algebraMap R A)) (w r) ∈ Submodule.span R (Set.range y₀) := by
    rw [hy₀]; trivial
  choose t ht using fun r ↦ (Submodule.mem_span_range_iff_exists_fun R).mp (hmem r)
  let r' (r : ↥(s : Set A)) : A' := ⟨r.1, hsA' r.2⟩
  let u (r : ↥(s : Set A)) : A' :=
    (∑ l : Fin k, t r l • ⟨(r : A) ^ N * y l, hN r r.2 l⟩) * r' r ^ N
  refine ⟨u, ?_⟩
  have hdiff (r : ↥(s : Set A)) :
      (∑ l : Fin k, algebraMap R A (t r l) * y l) - w r ∈ I.map (algebraMap R A) := by
    apply Ideal.Quotient.eq.mp
    simpa [hy, Algebra.smul_def] using ht r
  have hcoe : ((∑ r, u r * r' r : A') : A) - 1 =
      ∑ r : ↥(s : Set A), ((∑ l : Fin k, algebraMap R A (t r l) * y l) - w r) *
        (r : A) ^ (N + (N + 1)) := by
    rw [← hw]
    simp only [u, r', AddSubmonoidClass.coe_finsetSum, MulMemClass.coe_mul, Finset.sum_mul,
      Algebra.smul_def, Subalgebra.coe_algebraMap, Algebra.algebraMap_self, RingHom.id_apply,
      SubmonoidClass.coe_pow, ← Finset.sum_sub_distrib, sub_mul, pow_add, pow_one]
    refine Finset.sum_congr rfl fun r _ ↦ ?_
    rw [sub_left_inj]
    exact Finset.sum_congr rfl fun l _ ↦ by ring
  rw [hcoe]
  exact sum_mem fun r _ ↦ Ideal.mul_mem_right _ _ (hdiff r)

/-- Raising `γ = ∑ r, u r * r` to a high enough power gives an element `a ∈ A'` in the ideal
generated by `s` with `(a : A) ≡ 1 mod IA` and `a (a - 1) ∈ IA'`. -/
private theorem exists_mem_span_and_mul_sub_one_mem (I : Ideal R)
    [Module.Finite R (A ⧸ I.map (algebraMap R A))]
    (A' : Subalgebra R A) (s : Finset A) (hsA' : (s : Set A) ⊆ A')
    (hspan : Ideal.span (s : Set A) = ⊤) (hZ : ∀ r ∈ s, ∀ x : A, ∀ᶠ m in atTop, r ^ m * x ∈ A') :
    ∃ a : A', (a : A) - 1 ∈ I.map (algebraMap R A) ∧
      a ∈ Ideal.span {x : A' | (x : A) ∈ s} ∧ a * (a - 1) ∈ I.map (algebraMap R A') := by
  classical
  let r' (r : ↥(s : Set A)) : A' := ⟨r.1, hsA' r.2⟩
  obtain ⟨u, hγ1⟩ := exists_sum_mul_sub_one_mem_map I A' s hsA' hspan hZ
  set γ : A' := ∑ r, u r * r' r
  have hγ_smul : (γ : A) - 1 ∈ I • Submodule.span R (Set.range (id : A → A)) := by
    rw [Set.range_id, Submodule.span_univ]
    simpa using hγ1
  obtain ⟨b, hb, hsum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum I id _).mp hγ_smul
  obtain ⟨M, hM₀⟩ := eventually_atTop.mp (((eventually_all_finset s).mpr fun r hr ↦
    (eventually_all_finset b.support).mpr fun c _ ↦ hZ r hr c))
  have hM : ∀ r ∈ s, ∀ c ∈ b.support, r ^ (M + 1) * c ∈ A' := fun r hr c hc ↦
    hM₀ (M + 1) (Nat.le_succ M) r hr c hc
  let K := (Finset.univ : Finset ↥(s : Set A)).card * M + 1
  have ha_pow : γ ^ K ∈ Ideal.span (Set.range fun r : ↥(s : Set A) ↦ r' r ^ (M + 1)) := by
    refine Ideal.span_le.mpr ?_ (Ideal.sum_pow_mem_span_pow Finset.univ (fun r ↦ u r * r' r) M)
    rintro _ ⟨r, -, rfl⟩
    dsimp only
    rw [mul_pow]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self r))
  have ha_mul_mem (c : A) (hc : c ∈ b.support) : ((γ ^ K : A') : A) * c ∈ A' := by
    refine Submodule.span_induction (p := fun (x : A') _ ↦ (x : A) * c ∈ A') ?_ (by simp)
      (fun x y _ _ hx hy ↦ by simpa [add_mul] using A'.add_mem hx hy)
      (fun (t : A') x _ hx ↦ by simpa [Algebra.smul_def, mul_assoc] using A'.mul_mem t.2 hx) ha_pow
    rintro _ ⟨r, rfl⟩
    exact hM r.1 r.2 c hc
  have haγ : γ ^ K * (γ - 1) ∈ I.map (algebraMap R A') := by
    have hdec : γ ^ K * (γ - 1) =
        ∑ c ∈ b.support.attach, b c • ⟨((γ ^ K : A') : A) * c, ha_mul_mem c c.2⟩ := by
      ext
      simp only [MulMemClass.coe_mul, AddSubgroupClass.coe_sub, OneMemClass.coe_one, ← hsum,
        Finsupp.sum, id_eq, Finset.mul_sum, AddSubmonoidClass.coe_finsetSum, Subalgebra.coe_smul,
        Finset.sum_attach b.support fun c ↦ b c • (((γ ^ K : A') : A) * c)]
      exact Finset.sum_congr rfl fun c _ ↦ by rw [Algebra.smul_def, Algebra.smul_def]; ring
    rw [hdec]
    refine sum_mem fun c _ ↦ ?_
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hb c))
  obtain ⟨d, hd⟩ := sub_one_dvd_pow_sub_one γ K
  refine ⟨γ ^ K, ?_, ?_, ?_⟩
  · have hcoe : ((γ ^ K : A') : A) - 1 = ((γ : A) - 1) * d := by
      simpa using congrArg (Subtype.val : A' → A) hd
    rw [hcoe]
    exact Ideal.mul_mem_right _ _ hγ1
  · refine Ideal.span_le.mpr ?_ ha_pow
    rintro _ ⟨r, rfl⟩
    exact Ideal.pow_mem_of_mem _ (Ideal.subset_span (s := {x : A' | (x : A) ∈ s}) r.2) _
      (Nat.succ_pos M)
  · have hmul : γ ^ K * (γ ^ K - 1) = γ ^ K * (γ - 1) * d := by rw [hd]; ring
    rw [hmul]
    exact Ideal.mul_mem_right _ _ haγ

/-- If `A` agrees with a subalgebra `A'` on basic opens `D(r)` (`r ∈ s`), and `e ∈ A'` is an
idempotent congruent modulo `IA'` (`I ≤ jac(R)`) to an element in the ideal of `A'` generated by
`s`, then `A' → A ⧸ (1 - e)` is surjective. -/
private theorem quotient_mk_comp_val_surjective {I : Ideal R} (hI : I ≤ Ideal.jacobson ⊥)
    (A' : Subalgebra R A) [Module.Finite R A'] (s : Finset A)
    (hZ : ∀ r ∈ s, ∀ x : A, ∀ᶠ m in atTop, r ^ m * x ∈ A') {a e : A'}
    (ha : a ∈ Ideal.span {x : A' | (x : A) ∈ s})
    (hea : e - a ∈ I.map (algebraMap R A'))
    (b : A ⧸ Ideal.span {1 - (e : A)}) :
    ∃ x : A', Ideal.Quotient.mk (Ideal.span {1 - (e : A)}) (x : A) = b := by
  classical
  obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨m, hm1, hm⟩ : ∃ m, 1 ≤ m ∧ ∀ r ∈ s, r ^ m * c ∈ A' :=
    ((eventually_ge_atTop 1).and ((eventually_all_finset s).mpr fun r hr ↦ hZ r hr c)).exists
  have h1 : (1 : A') ∈ Ideal.span ((· ^ m) '' {x : A' | (x : A) ∈ s}) ⊔ Ideal.span {1 - e} := by
    by_contra hne
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ ((Ideal.ne_top_iff_one _).mpr hne)
    have hIM : I.map (algebraMap R A') ≤ M :=
      (Ideal.map_le_jacobson_bot_of_isIntegral hI).trans (sInf_le ⟨bot_le, hM⟩)
    have hsM : Ideal.span {x : A' | (x : A) ∈ s} ≤ M := Ideal.span_le.mpr fun x hx ↦
      hM.isPrime.mem_of_pow_mem m (hle (Ideal.mem_sup_left (Ideal.subset_span ⟨x, hx, rfl⟩)))
    have heM : e ∈ M := by simpa using M.add_mem (hIM hea) (hsM ha)
    exact hM.ne_top ((Ideal.eq_top_iff_one _).mpr (by
      simpa using M.add_mem heM (hle (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)))))
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp h1
  obtain ⟨u, rfl⟩ := Ideal.mem_span_singleton'.mp hz
  obtain ⟨T, hT, w, hw⟩ := (Submodule.mem_span_image_iff_exists_fun A').mp hy
  let x : A' := ∑ i, w i * ⟨(i : A) ^ m * c, hm _ (hT i.2)⟩
  refine ⟨x, Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton'.mpr ⟨-(u : A) * c, ?_⟩)⟩
  have hx : (x : A) = (y : A) * c := by
    rw [← hw]
    simp only [x, AddSubmonoidClass.coe_finsetSum, MulMemClass.coe_mul, smul_eq_mul,
      SubmonoidClass.coe_pow, Finset.sum_mul, mul_assoc]
  have hyz' : (y : A) + (u : A) * (1 - (e : A)) = 1 := by exact_mod_cast hyz
  rw [hx]
  linear_combination -c * hyz'

end EssSurjHelpers

/-- **Lifting finite étale algebras along a Henselian pair.** Let `(R, I)` be a Henselian pair and
let `B₀` be a finite étale `(R ⧸ I)`-algebra (in any universe). Then there exists a finite étale
`R`-algebra `B` in the universe of `R` whose base change `(R ⧸ I) ⊗[R] B` is `(R ⧸ I)`-isomorphic
to `B₀`. -/
@[stacks 09ZL]
theorem exists_etale_and_finite_and_tensorProduct_algEquiv {R : Type u} [CommRing R] (I : Ideal R)
    [HenselianRing R I] (B₀ : Type*) [CommRing B₀] [Algebra (R ⧸ I) B₀]
    [Algebra.Etale (R ⧸ I) B₀] [Module.Finite (R ⧸ I) B₀] :
    ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B),
      Algebra.Etale R B ∧ Module.Finite R B ∧ Nonempty ((R ⧸ I) ⊗[R] B ≃ₐ[R ⧸ I] B₀) := by
  obtain ⟨A, _, _, _, ⟨eA⟩⟩ :=
    Algebra.Etale.exists_tensorProduct_algEquiv_of_surjective R (R ⧸ I) B₀
      Ideal.Quotient.mk_surjective
  have : Module.Finite (R ⧸ I) (A ⧸ I.map (algebraMap R A)) :=
    Module.Finite.equiv
      ((Algebra.TensorProduct.quotIdealMapEquivQuotTensor A I).trans eA).symm.toLinearEquiv
  have : Module.Finite R (A ⧸ I.map (algebraMap R A)) := Module.Finite.trans (R ⧸ I) _
  obtain ⟨A', s, hfg, hsA', hspan, hZ⟩ :=
    Algebra.QuasiFinite.exists_fg_subalgebra_and_span_eq_top (R := R) (A := A)
  have : Module.Finite R A' := ⟨(Submodule.fg_top _).mpr hfg⟩
  obtain ⟨a, ha1, has, ha_idem⟩ := exists_mem_span_and_mul_sub_one_mem I A' s hsA' hspan hZ
  obtain ⟨e, he, hea⟩ := Ideal.exists_isIdempotentElem_sub_mem_map_of_isIntegral I
    (by simpa only [mul_sub, mul_one] using ha_idem)
  let B := A ⧸ Ideal.span {1 - (e : A)}
  have : Algebra.Etale R B :=
    TauCeti.Algebra.Etale.quotient_span_singleton (he.map A'.val).one_sub
  have hjac : I ≤ Ideal.jacobson ⊥ := by
    simpa only [Ideal.jacobson_bot] using (HenselianRing.jac (R := R) (I := I))
  have hsurj : Function.Surjective
      ((Ideal.Quotient.mkₐ R (Ideal.span {1 - (e : A)})).comp A'.val) :=
    quotient_mk_comp_val_surjective hjac A' s hZ has hea
  have : Module.Finite R B := Module.Finite.of_surjective
    ((Ideal.Quotient.mkₐ R (Ideal.span {1 - (e : A)})).comp A'.val).toLinearMap hsurj
  have he1 : 1 - (e : A) ∈ I.map (algebraMap R A) := by
    have hIA : I.map (algebraMap R A') ≤ (I.map (algebraMap R A)).comap A'.val :=
      Ideal.map_le_iff_le_comap.mpr fun r hr ↦ by
        simpa [Ideal.mem_comap] using Ideal.mem_map_of_mem (algebraMap R A) hr
    convert neg_mem (add_mem ha1 (hIA hea)) using 1
    simp only [Subalgebra.coe_val, AddSubgroupClass.coe_sub]
    ring
  exact ⟨B, inferInstance, inferInstance, inferInstance, inferInstance,
    ⟨(Algebra.TensorProduct.tensorQuotientEquivOfLeMap I
      ((I.map (algebraMap R A)).span_singleton_le_iff_mem.mpr he1)).trans eA⟩⟩

end TauCeti.HenselianRing

namespace CommAlgCat.FiniteEtale

section Henselian

variable {R : Type u} [CommRing R]

/-- Over a Henselian pair `(R, I)`, base change `A ↦ (R ⧸ I) ⊗[R] A` on finite étale algebras is
fully faithful. -/
noncomputable def baseChangeQuotientFullyFaithful (I : Ideal R) [HenselianRing R I] :
    (baseChange.{v} R (R ⧸ I)).FullyFaithful where
  preimage {A B} g := by
    have : Module.FinitePresentation R B := .of_finite_of_finitePresentation R B
    have : Module.Projective R B := Module.Flat.projective_of_finitePresentation
    exact ofHom ((Equiv.ofBijective _
      (TauCeti.HenselianRing.tensorProduct_map_bijective I (A := A) (B := B))).symm g.hom.hom)
  map_preimage {A B} g := by
    have : Module.FinitePresentation R B := .of_finite_of_finitePresentation R B
    have : Module.Projective R B := Module.Flat.projective_of_finitePresentation
    let eqv := Equiv.ofBijective _
      (TauCeti.HenselianRing.tensorProduct_map_bijective I (A := A) (B := B))
    ext x
    exact DFunLike.congr_fun (eqv.apply_symm_apply g.hom.hom) x
  preimage_map {A B} f := by
    have : Module.FinitePresentation R B := .of_finite_of_finitePresentation R B
    have : Module.Projective R B := Module.Flat.projective_of_finitePresentation
    let eqv := Equiv.ofBijective _
      (TauCeti.HenselianRing.tensorProduct_map_bijective I (A := A) (B := B))
    ext a
    exact DFunLike.congr_fun (eqv.symm_apply_apply f.hom.hom) a

/-- Over a Henselian pair `(R, I)`, base change of finite étale algebras to `R ⧸ I` is faithful. -/
instance faithful_baseChange_quotient {I : Ideal R} [HenselianRing R I] :
    (baseChange.{v} R (R ⧸ I)).Faithful :=
  (baseChangeQuotientFullyFaithful I).faithful

/-- Over a Henselian pair `(R, I)`, base change of finite étale algebras to `R ⧸ I` is full. -/
instance full_baseChange_quotient {I : Ideal R} [HenselianRing R I] :
    (baseChange.{v} R (R ⧸ I)).Full :=
  (baseChangeQuotientFullyFaithful I).full

/-- Over a Henselian pair `(R, I)`, base change of finite étale algebras to `R ⧸ I` is essentially
surjective. -/
instance essSurj_baseChange_quotient {I : Ideal R} [HenselianRing R I] :
    (baseChange.{u} R (R ⧸ I)).EssSurj where
  mem_essImage B₀ := by
    obtain ⟨B, _, _, _, _, ⟨e⟩⟩ :=
      TauCeti.HenselianRing.exists_etale_and_finite_and_tensorProduct_algEquiv I B₀
    exact ⟨of R B, ⟨isoMk e⟩⟩

/-- **Equivalence of finite étale algebras for a Henselian pair.** For a Henselian pair `(R, I)`,
base change `A ↦ (R ⧸ I) ⊗[R] A` is an equivalence from `CommAlgCat.FiniteEtale R` to
`CommAlgCat.FiniteEtale (R ⧸ I)`. -/
@[stacks 09ZL]
instance isEquivalence_baseChange_quotient {I : Ideal R} [HenselianRing R I] :
    (baseChange.{u} R (R ⧸ I)).IsEquivalence where

/-- Base change of finite étale algebras along a surjective ring homomorphism whose kernel makes
the source a Henselian pair is an equivalence of categories. -/
theorem isEquivalence_baseChange_of_surjective {S : Type u} [CommRing S] [Algebra R S]
    (hsurj : Function.Surjective (algebraMap R S))
    [HenselianRing R (RingHom.ker (algebraMap R S))] :
    (baseChange.{u} R S).IsEquivalence := by
  let I : Ideal R := RingHom.ker (algebraMap R S)
  let e : (R ⧸ I) ≃ₐ[R] S := Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId R S) hsurj
  let : Algebra (R ⧸ I) S := e.toAlgHom.toRingHom.toAlgebra
  have : IsScalarTower R (R ⧸ I) S := .of_algebraMap_eq fun r ↦ (e.commutes r).symm
  have : (baseChange.{u} (R ⧸ I) S).IsEquivalence :=
    isEquivalence_baseChange_of_bijective e.bijective
  exact Functor.isEquivalence_of_iso (baseChangeCompIso R (R ⧸ I) S)

/-- **Equivalence of finite étale algebras over a Henselian local ring.** For a Henselian local
ring `R`, base change to the residue field `IsLocalRing.ResidueField R` is an equivalence from
`CommAlgCat.FiniteEtale R` to `CommAlgCat.FiniteEtale (IsLocalRing.ResidueField R)`. -/
instance isEquivalence_baseChange_residueField [HenselianLocalRing R] :
    (baseChange.{u} R (IsLocalRing.ResidueField R)).IsEquivalence := by
  have : HenselianRing R (RingHom.ker (algebraMap R (IsLocalRing.ResidueField R))) := by
    rw [IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.ker_residue]
    infer_instance
  exact isEquivalence_baseChange_of_surjective IsLocalRing.residue_surjective

-- Base change along `ℤ/4ℤ → (ℤ/4ℤ)/(2)` is an equivalence of categories of finite étale algebras,
-- since `(2)` is nilpotent (`2 ^ 2 = 0` in `ℤ/4ℤ`) and hence `(ℤ/4ℤ, (2))` is a Henselian pair.
example :
    (baseChange.{0} (ZMod 4) (ZMod 4 ⧸ Ideal.span {(2 : ZMod 4)})).IsEquivalence := by
  let I : Ideal (ZMod 4) := Ideal.span {(2 : ZMod 4)}
  have hI2 : I ^ 2 = ⊥ := by
    rw [Ideal.span_singleton_pow, Ideal.span_singleton_eq_bot]
    decide
  have : IsAdicComplete I (ZMod 4) :=
    TauCeti.isAdicComplete_of_pow_smul_eq_bot (by rw [hI2, Submodule.bot_smul])
  infer_instance

end Henselian

end CommAlgCat.FiniteEtale
