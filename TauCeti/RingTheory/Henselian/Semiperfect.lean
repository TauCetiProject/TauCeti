/-!
# Module-finite algebras over a Henselian local ring are semiperfect

Let `(R, 𝔪)` be a Henselian local ring and `A` an `R`-algebra, not necessarily commutative, that is
finitely generated as an `R`-module. Then `A` is semiperfect: `A ⧸ J(A)` is semisimple and
idempotents lift modulo `J(A)`. No Noetherian hypothesis is needed.

The idempotents are lifted one element at a time, inside the commutative subalgebra generated by
a lift `x` of the idempotent `b`. Let `F` be a monic polynomial killing `x`. Its reduction `F₀`
vanishes at `0` and `1` unless `b` is trivial, because a polynomial evaluated at an idempotent `b`
is `Q(0) (1 - b) + Q(1) b`. Split off the exact power of `X` from `F₀`, as `F₀ = Xʳ H₀` with
`H₀(0) ≠ 0`, and lift this coprime factorization to `F = G H` together with a Bézout identity
`U G + V H = 1`.
Then `e = U(x) G(x)` is idempotent, as `e (1 - e) = (U V F)(x) = 0`, and it lifts `b`, as
`G(b) = bʳ = b` and `U(1) ≡ 1`.

This lifting is `TauCeti.exists_isIdempotentElem_eq_of_isIntegral`. Since `𝔪 A` lies in the
Jacobson radical (`TauCeti.Ring.algebraMap_mem_jacobson`), the quotient
`A ⧸ J(A)` is a finite-dimensional algebra over the residue field, hence semisimple.

## Main results

* `TauCeti.IsSemiperfectRing.of_henselianRing`: a module-finite algebra over a Henselian local
  ring is semiperfect.

## References

* G. J. Leuschke, R. Wiegand, *Cohen-Macaulay Representations*, Mathematical Surveys and
  Monographs 181, AMS (2012), Theorem A.30.
* M. E. Alonso García, H. Lombardi, H. Perdry, *Elementary constructive theory of Henselian local
  rings*, Math. Log. Q. 54 (2008), 253–271, Theorem 5.9.
-/

public section

open Polynomial IsLocalRing

namespace TauCeti

/-- **A module-finite algebra over a Henselian local ring is semiperfect.** If `R` is a Henselian
local ring and `A` is an `R`-algebra, not necessarily commutative, that is finitely generated as an
`R`-module, then `A` is semiperfect. No Noetherian hypothesis is needed. -/
theorem IsSemiperfectRing.of_henselianRing (R : Type*) [CommRing R] [IsLocalRing R]
    [HenselianRing R (maximalIdeal R)] (A : Type*) [Ring A] [Algebra R A] [Module.Finite R A] :
    IsSemiperfectRing A := by
  set J := Ring.jacobson A
  -- The maximal ideal of `R` maps into the radical of `A`, so it acts by zero on `A ⧸ J(A)`.
  have hB : ∀ r ∈ maximalIdeal R, algebraMap R (A ⧸ J) r = 0 := fun r hr ↦ by
    rw [← (Ideal.Quotient.mkₐ R J).commutes r, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem]
    refine Ring.algebraMap_mem_jacobson ?_
    rw [← Ideal.jacobson_bot]
    exact maximalIdeal_le_jacobson ⊥ hr
  refine ⟨?_, fun e he ↦ ?_⟩
  · -- `A ⧸ J(A)` is a finite algebra over the residue field with zero radical.
    let := Ideal.Quotient.field (maximalIdeal R)
    let := Ideal.Quotient.algebraQuotientOfLEComap (R := R) (P := J) fun r hr ↦ by
      rw [Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem]; exact hB r hr
    have : IsScalarTower R (R ⧸ maximalIdeal R) (A ⧸ J) := .of_algebraMap_eq' rfl
    have : Module.Finite R (A ⧸ J) :=
      .of_surjective (Ideal.Quotient.mkₐ R J).toLinearMap Ideal.Quotient.mk_surjective
    have : Module.Finite (R ⧸ maximalIdeal R) (A ⧸ J) := .of_restrictScalars_finite R _ _
    have : IsArtinianRing (A ⧸ J) := .of_finite (R ⧸ maximalIdeal R) (A ⧸ J)
    exact ((Ideal.quotEquivOfEq (Ring.jacobson_quotient_jacobson A)).trans
      (RingEquiv.quotientBot _)).isSemisimpleRing
  · obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective e
    exact exists_isIdempotentElem_eq_of_isIntegral hB (Ideal.Quotient.mkₐ R J)
      (.of_finite R x) he

end TauCeti
