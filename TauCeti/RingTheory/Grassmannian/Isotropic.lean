module

public import Mathlib.LinearAlgebra.BilinearForm.Orthogonal
public import Mathlib.RingTheory.Finiteness.Bilinear
public import TauCeti.LinearAlgebra.BilinearForm.BaseChange
public import TauCeti.RingTheory.Grassmannian.Basic

/-!
# The isotropic locus of a point of the Grassmannian

Let `ω` be a bilinear form on a module `M` over a commutative ring `R`. A point `N` of the
Grassmannian functor `A ↦ G(k, A ⊗[R] M; A)` is an `A`-submodule of `A ⊗[R] M` whose quotient is
finite projective of constant rank `k`; it is *isotropic* for the base change `ω_A` of `ω` when
`ω_A` vanishes on `N × N`, that is, when `N ≤ N^⊥` for `ω_A`. For a nondegenerate alternating
form on `R^{2m}` and quotient rank `2m - r`, these are the points of the isotropic Grassmannian
of rank-`r` isotropic subbundles.

This file shows that isotropy is a closed condition on the Grassmannian. The ideal
`N.isotropicLocus ω` of `A` is generated by the values `ω_A(x, y)` for `x y ∈ N`: the values of
the form restricted to the tautological submodule. For every `R`-algebra map `f : A → B`, the base
change of `N` to `B` is isotropic for `ω_B` exactly when `f` kills `N.isotropicLocus ω`
(`Module.Grassmannian.isotropicLocus_le_ker_iff`), and the formation of this ideal commutes with
base change (`Module.Grassmannian.isotropicLocus_map`). The form need not be alternating,
symmetric or nondegenerate, and no hypothesis on `2` is needed, so this covers characteristic `2`.

The key input is right exactness of the tensor product: the base change of `N` is spanned over `B`
by the image of `N` (`Module.Grassmannian.ker_baseChangeMkQ`), and on that image `ω_B` takes the
values `f (ω_A(x, y))` (`LinearMap.BilinForm.baseChange_rTensor_rTensor`).

Since their formation commutes with base change, these ideals are compatible with restriction
between affine opens of the Grassmannian scheme, and they glue into the isotropic Grassmannian, a
closed subscheme of the Grassmannian scheme (`Module.Grassmannian.schemeIsotropicLocus`).

## Main definitions

* `Module.Grassmannian.isotropicLocus N ω`: the ideal of `A` generated by the values of `ω_A` on
  `N × N`.

## Main results

* `Module.Grassmannian.isotropicLocus_le_iff`: `N.isotropicLocus ω` lies in an ideal `J` exactly
  when every value `ω_A(x, y)`, `x y ∈ N`, lies in `J`.
* `Module.Grassmannian.isotropicLocus_eq_bot_iff`: `N.isotropicLocus ω` vanishes exactly when `N`
  is isotropic for `ω_A`.
* `Module.Grassmannian.isotropicLocus_map`: the formation of `isotropicLocus` commutes with base
  change.
* `Module.Grassmannian.isotropicLocus_le_ker_iff`: the base change of `N` along `f` is isotropic
  exactly when `f` kills `N.isotropicLocus ω`.
* `Module.Grassmannian.isotropicLocus_fg`: for `M` finite over `R`, the ideal `N.isotropicLocus ω`
  is finitely generated.

## References

* [The Stacks Project, Tag 089R](https://stacks.math.columbia.edu/tag/089R), for the Grassmannian
  functor.
* A. Grothendieck, J. Dieudonné, *Éléments de géométrie algébrique I* (Springer, 1971), 9.7, for
  closed conditions on the Grassmannian.
-/

public section

universe u v w

open TensorProduct

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M] {k : ℕ}
  {A B : Type w} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]

/-- The **isotropic locus** of a point `N` of `G(k, A ⊗[R] M; A)` for a bilinear form `ω` on `M`:
the ideal of `A` generated by the values `ω_A(x, y)`, `x y ∈ N`, of the base change of `ω` on `N`.
It cuts out the closed subscheme of `Spec A` over which `N` is isotropic
(`Module.Grassmannian.isotropicLocus_le_ker_iff`). -/
noncomputable def isotropicLocus (N : G(k, A ⊗[R] M; A)) (ω : LinearMap.BilinForm R M) :
    Ideal A :=
  Submodule.map₂ (ω.baseChange A) N.toSubmodule N.toSubmodule

/-- `N.isotropicLocus ω` is the image of `N × N` under the base change of `ω`. -/
theorem isotropicLocus_def (N : G(k, A ⊗[R] M; A)) (ω : LinearMap.BilinForm R M) :
    N.isotropicLocus ω = Submodule.map₂ (ω.baseChange A) N.toSubmodule N.toSubmodule :=
  (rfl)

/-- `N.isotropicLocus ω` is the ideal generated by the values `ω_A(x, y)`, `x y ∈ N`. -/
theorem isotropicLocus_eq_span (N : G(k, A ⊗[R] M; A)) (ω : LinearMap.BilinForm R M) :
    N.isotropicLocus ω =
      Ideal.span (Set.image2 (fun x y ↦ ω.baseChange A x y) N.toSubmodule N.toSubmodule) :=
  Submodule.map₂_eq_span_image2 _ _ _

/-- The value of the base change of `ω` on two vectors of `N` lies in `N.isotropicLocus ω`. -/
theorem baseChange_apply_mem_isotropicLocus (N : G(k, A ⊗[R] M; A))
    (ω : LinearMap.BilinForm R M) {x y : A ⊗[R] M} (hx : x ∈ N.toSubmodule)
    (hy : y ∈ N.toSubmodule) : ω.baseChange A x y ∈ N.isotropicLocus ω :=
  Submodule.apply_mem_map₂ _ hx hy

/-- `N.isotropicLocus ω` is contained in an ideal `J` exactly when every value `ω_A(x, y)`,
`x y ∈ N`, lies in `J`. -/
theorem isotropicLocus_le_iff (N : G(k, A ⊗[R] M; A)) (ω : LinearMap.BilinForm R M)
    (J : Ideal A) :
    N.isotropicLocus ω ≤ J ↔ ∀ x ∈ N.toSubmodule, ∀ y ∈ N.toSubmodule, ω.baseChange A x y ∈ J :=
  Submodule.map₂_le

/-- **`N.isotropicLocus ω` vanishes exactly when `N` is isotropic** for the base change of `ω`:
`N` lies in its own orthogonal. -/
theorem isotropicLocus_eq_bot_iff (N : G(k, A ⊗[R] M; A)) (ω : LinearMap.BilinForm R M) :
    N.isotropicLocus ω = ⊥ ↔
      N.toSubmodule ≤ (ω.baseChange A).orthogonal N.toSubmodule := by
  rw [← le_bot_iff, isotropicLocus_le_iff]
  exact ⟨fun h y hy ↦ LinearMap.BilinForm.mem_orthogonal_iff.2 fun x hx ↦
      (Submodule.mem_bot A).1 (h x hx y hy),
    fun h x hx y hy ↦
      (Submodule.mem_bot A).2 (LinearMap.BilinForm.mem_orthogonal_iff.1 (h hy) x hx)⟩

/-- **The formation of `isotropicLocus` commutes with base change.** For `f : A →ₐ[R] B`, the
isotropic locus of the base change of `N` to `B` is the ideal generated by the image under `f` of
the isotropic locus of `N`. -/
@[simp]
theorem isotropicLocus_map (f : A →ₐ[R] B) (N : G(k, A ⊗[R] M; A))
    (ω : LinearMap.BilinForm R M) :
    (map f N).isotropicLocus ω = Ideal.map f (N.isotropicLocus ω) := by
  algebraize [f.toRingHom]
  -- `algebraize` makes `f` the structure map of `B` as an `A`-algebra
  have hf : IsScalarTower.toAlgHom R A B = f := AlgHom.ext fun _ ↦ rfl
  -- the base change of `N` is spanned over `B` by the image of `N`, on which `ω_B` takes the
  -- values `f (ω_A(x, y))`
  rw [← hf, isotropicLocus_def, map_toAlgHom_toSubmodule, ker_baseChangeMkQ,
    Submodule.map₂_span_span, isotropicLocus_eq_span, Ideal.map_span]
  simp [Set.image_image2, Set.image2_image_left, Set.image2_image_right,
    LinearMap.BilinForm.baseChange_rTensor_rTensor]

/-- **Isotropy is a closed condition on the Grassmannian.** For `f : A →ₐ[R] B`, the base change
of `N` to `B` is isotropic for the base change of `ω` to `B` exactly when `f` kills
`N.isotropicLocus ω`. -/
theorem isotropicLocus_le_ker_iff (f : A →ₐ[R] B) (N : G(k, A ⊗[R] M; A))
    (ω : LinearMap.BilinForm R M) :
    N.isotropicLocus ω ≤ RingHom.ker f ↔
      (map f N).toSubmodule ≤ (ω.baseChange B).orthogonal (map f N).toSubmodule := by
  rw [← isotropicLocus_eq_bot_iff, isotropicLocus_map, Ideal.map_eq_bot_iff_le_ker]

/-- **Isotropy is stable under base change.** -/
theorem isotropicLocus_map_eq_bot {N : G(k, A ⊗[R] M; A)} {ω : LinearMap.BilinForm R M}
    (hN : N.isotropicLocus ω = ⊥) (f : A →ₐ[R] B) : (map f N).isotropicLocus ω = ⊥ := by
  rw [isotropicLocus_map, hN, Ideal.map_bot]

/-- For `M` finite over `R`, the ideal `N.isotropicLocus ω` is finitely generated: isotropy is cut
out by finitely many equations, the values of `ω_A` on pairs of generators of `N`. -/
theorem isotropicLocus_fg [Module.Finite R M] (N : G(k, A ⊗[R] M; A))
    (ω : LinearMap.BilinForm R M) : (N.isotropicLocus ω).FG :=
  N.fg_toSubmodule.map₂ _ N.fg_toSubmodule

end Module.Grassmannian
