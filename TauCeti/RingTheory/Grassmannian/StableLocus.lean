module

public import Mathlib.Algebra.Module.Submodule.Invariant
public import TauCeti.RingTheory.FittingIdeal.Content
public import TauCeti.RingTheory.Grassmannian.Basic

import TauCeti.LinearAlgebra.TensorProduct.Tower

/-!
# The locus of submodules stable under an endomorphism

Let `t` be an endomorphism of a module `M` over a commutative ring `R`. A point `N` of the
Grassmannian functor `A ↦ G(k, A ⊗[R] M; A)` is an `A`-submodule of `A ⊗[R] M` whose quotient
`Q = (A ⊗[R] M) ⧸ N` is finite projective of constant rank `k`; it is *`t`-stable* when the base
change `t_A` of `t` maps `N` into itself, that is, when `N` is an invariant submodule of `t_A`
(`Module.End.invtSubmodule`).

This file shows that `t`-stability is a closed condition on the Grassmannian. The ideal
`N.stableLocus t` of `A` is the content (`Submodule.minorsIdeal 1`) of the image of `N` under
`t_A` followed by the projection to `Q`: the ideal generated by the values of all linear forms on
`Q` at the classes of the vectors `t_A x`, `x ∈ N`. Since `Q` is projective, it vanishes exactly
when these classes do, that is, when `N` is `t_A`-stable
(`Module.Grassmannian.stableLocus_eq_bot_iff`). Its formation commutes with base change along
every `R`-algebra map `f : A → B` (`Module.Grassmannian.stableLocus_map`), so the base change of
`N` to `B` is `t_B`-stable exactly when `f` kills `N.stableLocus t`
(`Module.Grassmannian.stableLocus_le_ker_iff`). It is also unchanged when `t` and `N` are replaced
by their base changes along a ring map `R → R'` (`Module.Grassmannian.stableLocus_baseChangeEquiv`).

Since their formation commutes with base change, these ideals glue into the closed subscheme of
the Grassmannian scheme of the `t`-stable submodules (`Module.Grassmannian.schemeStableLocus`). For
`t` the multiplication by the uniformizer on a quotient of two lattices, this is the condition
cutting out the lattice charts of the loop Grassmannian of `GL_n` (Zhu, §1.1).

## Main definitions

* `Module.Grassmannian.stableLocus N t`: the ideal of `A` cutting out the locus where `N` is
  `t`-stable.

## Main results

* `Module.Grassmannian.stableLocus_le_iff`: `N.stableLocus t` lies in an ideal `J` exactly when
  every linear form on `Q` takes values in `J` at the classes of the `t_A x`, `x ∈ N`.
* `Module.Grassmannian.stableLocus_eq_bot_iff`: `N.stableLocus t` vanishes exactly when `N` is
  `t_A`-stable.
* `Module.Grassmannian.stableLocus_map`: the formation of `stableLocus` commutes with base change.
* `Module.Grassmannian.stableLocus_le_ker_iff`: the base change of `N` along `f` is stable exactly
  when `f` kills `N.stableLocus t`.
* `Module.Grassmannian.stableLocus_baseChangeEquiv`: the ideal is unchanged by base change of the
  module and of the endomorphism.
* `Module.Grassmannian.stableLocus_fg`: for `M` finite over `R`, the ideal is finitely generated.
* `Module.Grassmannian.stableLocus_zero`: every point is stable under `t = 0`.

## References

* A. Grothendieck, J. Dieudonné, *Éléments de géométrie algébrique I* (Springer, 1971), 9.7, for
  closed conditions on the Grassmannian.
* X. Zhu, *An introduction to affine Grassmannians and the geometric Satake equivalence*,
  Lecture notes, §1.1, for the lattice charts as `t`-stable points of a Grassmannian.
-/

public section

universe u v w

open TensorProduct

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M] {k : ℕ}
  {A B : Type w} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]

/-- The **stable locus** of a point `N` of `G(k, A ⊗[R] M; A)` for an endomorphism `t` of `M`: the
content of the image of `N` under the base change `t_A` of `t` followed by the projection to the
finite projective quotient by `N`. It cuts out the closed subscheme of `Spec A` over which `N` is
`t`-stable (`Module.Grassmannian.stableLocus_le_ker_iff`). -/
noncomputable def stableLocus (N : G(k, A ⊗[R] M; A)) (t : Module.End R M) : Ideal A :=
  (N.toSubmodule.map (N.toSubmodule.mkQ ∘ₗ t.baseChange A)).minorsIdeal 1

/-- `N.stableLocus t` is the content of the image of `N` in the quotient by `N` under `t_A`. -/
theorem stableLocus_def (N : G(k, A ⊗[R] M; A)) (t : Module.End R M) :
    N.stableLocus t = (N.toSubmodule.map (N.toSubmodule.mkQ ∘ₗ t.baseChange A)).minorsIdeal 1 :=
  (rfl)

/-- `N.stableLocus t` is contained in an ideal `J` exactly when every linear form on the quotient
by `N` takes values in `J` at the classes of the vectors `t_A x`, `x ∈ N`. -/
theorem stableLocus_le_iff (N : G(k, A ⊗[R] M; A)) (t : Module.End R M) (J : Ideal A) :
    N.stableLocus t ≤ J ↔
      ∀ (φ : Module.Dual A ((A ⊗[R] M) ⧸ N.toSubmodule)) (x : A ⊗[R] M),
        x ∈ N.toSubmodule → φ (N.toSubmodule.mkQ (t.baseChange A x)) ∈ J := by
  rw [stableLocus_def, Submodule.minorsIdeal_one_le_iff]
  refine ⟨fun h φ x hx ↦ h φ _ ⟨x, hx, rfl⟩, ?_⟩
  rintro h φ _ ⟨x, hx, rfl⟩
  exact h φ x hx

/-- **`N.stableLocus t` vanishes exactly when `N` is stable** under the base change `t_A` of `t`. -/
@[simp]
theorem stableLocus_eq_bot_iff (N : G(k, A ⊗[R] M; A)) (t : Module.End R M) :
    N.stableLocus t = ⊥ ↔ N.toSubmodule ∈ Module.End.invtSubmodule (t.baseChange A) := by
  rw [stableLocus_def, eq_bot_iff, Submodule.minorsIdeal_one_le_iff_le_smul_top,
    Submodule.bot_smul, Submodule.map_le_iff_le_comap, Submodule.comap_bot, LinearMap.ker_comp,
    Submodule.ker_mkQ, Module.End.mem_invtSubmodule]

/-- Every point is stable under the zero endomorphism. -/
@[simp]
theorem stableLocus_zero (N : G(k, A ⊗[R] M; A)) : N.stableLocus 0 = ⊥ := by
  rw [stableLocus_eq_bot_iff, Module.End.mem_invtSubmodule]
  intro x _
  simp

/-- **The formation of `stableLocus` commutes with base change.** For `f : A →ₐ[R] B`, the stable
locus of the base change of `N` to `B` is the ideal generated by the image under `f` of the stable
locus of `N`. -/
@[simp]
theorem stableLocus_map (f : A →ₐ[R] B) (N : G(k, A ⊗[R] M; A)) (t : Module.End R M) :
    (map f N).stableLocus t = Ideal.map f (N.stableLocus t) := by
  -- adapted from the proof of `Module.Grassmannian.incidenceLocus_map`, with the image of `N`
  -- under `t_A` in place of the second Grassmannian point
  algebraize [f.toRingHom]
  -- `algebraize` makes `f` the structure map of `B` as an `A`-algebra
  have hf : IsScalarTower.toAlgHom R A B = f := AlgHom.ext fun _ ↦ rfl
  have hN := map_toAlgHom_toSubmodule (B := B) N
  rw [hf] at hN
  -- the quotient by the base change of `N` is the base change of the quotient by `N`
  let e : ((B ⊗[R] M) ⧸ (map f N).toSubmodule) ≃ₗ[B]
      B ⊗[A] ((A ⊗[R] M) ⧸ N.toSubmodule) :=
    (Submodule.quotEquivOfEq _ _ hN).trans
      ((baseChangeMkQ B N.toSubmodule).quotKerEquivOfSurjective
        (baseChangeMkQ_surjective N.toSubmodule))
  -- under `e`, the image of the base change of `N` is spanned by the image of that of `N`; the
  -- submodule being mapped is generalised, so that it can be rewritten without the one in the
  -- quotient map
  have himage (S : Submodule B (B ⊗[R] M))
      (hS : S = Submodule.span B (f.toLinearMap.rTensor M '' N.toSubmodule)) :
      (S.map ((map f N).toSubmodule.mkQ ∘ₗ t.baseChange B)).map (e : _ →ₗ[B] _) =
        Submodule.span B (TensorProduct.mk A B _ 1 ''
          (N.toSubmodule.map (N.toSubmodule.mkQ ∘ₗ t.baseChange A) :
            Set ((A ⊗[R] M) ⧸ N.toSubmodule))) := by
    subst hS
    rw [Submodule.map_span, Submodule.map_span]
    simp only [Submodule.map_coe, Set.image_image]
    refine congrArg _ (Set.image_congr fun x _ ↦ ?_)
    simp [e, ← hf, ← LinearMap.rTensor_baseChange]
  rw [stableLocus_def, ← Submodule.minorsIdeal_map_equiv e,
    himage _ (map_toSubmodule_eq_span f N),
    (TensorProduct.isBaseChange A _ B).minorsIdeal_one_span_image, stableLocus_def]
  rfl

/-- **Stability is a closed condition on the Grassmannian.** For `f : A →ₐ[R] B`, the base change
of `N` to `B` is stable under the base change `t_B` of `t` exactly when `f` kills
`N.stableLocus t`. -/
theorem stableLocus_le_ker_iff (f : A →ₐ[R] B) (N : G(k, A ⊗[R] M; A)) (t : Module.End R M) :
    N.stableLocus t ≤ RingHom.ker f ↔
      (map f N).toSubmodule ∈ Module.End.invtSubmodule (t.baseChange B) := by
  rw [← stableLocus_eq_bot_iff, stableLocus_map, Ideal.map_eq_bot_iff_le_ker]

/-- **Stability is preserved by base change.** -/
theorem stableLocus_map_eq_bot {N : G(k, A ⊗[R] M; A)} {t : Module.End R M}
    (hN : N.stableLocus t = ⊥) (f : A →ₐ[R] B) : (map f N).stableLocus t = ⊥ := by
  rw [stableLocus_map, hN, Ideal.map_bot]

/-- For `M` finite over `R`, the ideal `N.stableLocus t` is finitely generated: stability is cut
out by finitely many equations. -/
theorem stableLocus_fg [Module.Finite R M] (N : G(k, A ⊗[R] M; A)) (t : Module.End R M) :
    (N.stableLocus t).FG :=
  (N.fg_toSubmodule.map _).minorsIdeal_one

end Module.Grassmannian

namespace Module.Grassmannian

variable {R R' : Type*} [CommRing R] [CommRing R'] [Algebra R R'] {M : Type v} [AddCommGroup M]
  [Module R M] {k : ℕ} {A : Type w} [CommRing A] [Algebra R A] [Algebra R' A]
  [IsScalarTower R R' A]

/-- **The stable locus is compatible with base change of the module.** For an `R`-algebra `R'`
and a point `N` of the Grassmannian of `R' ⊗[R] M` over an `R'`-algebra `A`, the stable locus of
`N` for the base change of `t` to `R'` is the stable locus for `t` of the image of `N` in
`G(k, A ⊗[R] M; A)` under `A ⊗[R'] (R' ⊗[R] M) ≃ A ⊗[R] M`. -/
@[simp]
theorem stableLocus_baseChangeEquiv (N : G(k, A ⊗[R'] (R' ⊗[R] M); A)) (t : Module.End R M) :
    (baseChangeEquiv R' N).stableLocus t = N.stableLocus (t.baseChange R') := by
  set c := AlgebraTensorModule.cancelBaseChange R R' A A M
  have hN : N.toSubmodule.map (c : _ →ₗ[A] _) = (baseChangeEquiv R' N).toSubmodule :=
    (toSubmodule_baseChangeEquiv R' N).symm
  -- the quotients by `N` and by its image are identified by `c`, compatibly with the base changes
  -- of `t`
  let e := Submodule.Quotient.equiv _ _ c hN
  have himage : (N.toSubmodule.map (N.toSubmodule.mkQ ∘ₗ (t.baseChange R').baseChange A)).map
      (e : _ →ₗ[A] _) = (baseChangeEquiv R' N).toSubmodule.map
        ((baseChangeEquiv R' N).toSubmodule.mkQ ∘ₗ t.baseChange A) := by
    -- rewrite only the submodule being mapped, not the one in the quotient map
    conv_rhs => arg 2; rw [← hN]
    rw [← Submodule.map_comp, ← Submodule.map_comp]
    refine congrArg (Submodule.map · _) (LinearMap.ext fun x ↦ ?_)
    have h := LinearMap.congr_fun
      (AlgebraTensorModule.lTensor_comp_cancelBaseChange R R' A (M := A) t) x
    simp only [AlgebraTensorModule.lTensor_eq_baseChange, LinearMap.coe_comp, LinearEquiv.coe_coe,
      Function.comp_apply] at h
    simp [e, c, h]
  rw [stableLocus_def, stableLocus_def, ← himage, Submodule.minorsIdeal_map_equiv]

end Module.Grassmannian
