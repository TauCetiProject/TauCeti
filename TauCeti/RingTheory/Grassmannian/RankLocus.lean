module

public import TauCeti.RingTheory.FittingIdeal.BaseChange
public import TauCeti.RingTheory.Grassmannian.Basic

import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Rank conditions on the Grassmannian

Let `M` be a module over a commutative ring `R` and `N` a point of the Grassmannian functor
`A ↦ G(k, A ⊗[R] M; A)`: an `A`-submodule of `A ⊗[R] M` whose quotient `Q = (A ⊗[R] M) ⧸ N` is
finite projective of constant rank `k`. A submodule `F ≤ M` gives the composite
`A ⊗[R] F → A ⊗[R] M → Q`, and the condition that this map have rank at most `s` is a
determinantal condition: its `(s + 1) × (s + 1)` minors vanish. This file defines the ideal
`N.rankLocus F s` of `A` generated by these minors, the ideal of minors
(`Submodule.minorsIdeal`) of the image of `A ⊗[R] F` in `Q`. Since `Q` need not be free, a minor
is a determinant `det (φ j (v i))` of `s + 1` linear functionals `φ j` on `Q` evaluated at `s + 1`
vectors `v i` of the image; it suffices to take the images of vectors of `F`
(`Module.Grassmannian.rankLocus_le_iff`).

The formation of `rankLocus` commutes with base change (`Module.Grassmannian.rankLocus_map`),
because the quotient of the base change of `N` to `B` is `B ⊗[A] Q` and minors ideals of submodules
of finite projective modules commute with base change (`IsBaseChange.minorsIdeal_span_image`). So
the rank conditions are closed conditions on the Grassmannian, and they cut out closed subschemes
of the Grassmannian scheme (`Module.Grassmannian.schemeRankLocus`). Over a field `K`, the ideal
vanishes exactly when the image of `K ⊗[R] F` in `Q` has dimension at most `s`
(`Module.Grassmannian.rankLocus_eq_bot_iff`). Write `F.baseChange K` for the image of
`K ⊗[R] F → K ⊗[R] M`; this map need not be injective, so `F.baseChange K` is in general a
quotient of `K ⊗[R] F`. When `F.baseChange K` is finite-dimensional, the condition is
`dim (F.baseChange K) ≤ s + dim (F.baseChange K ⊓ N)`
(`Module.Grassmannian.rankLocus_eq_bot_iff_finrank_inf`).

For the subspaces `F_j` of a complete flag in `M`, these are the incidence conditions
`dim (N ⊓ F_j) ≥ c_j` defining the Schubert varieties of the Grassmannian relative to the flag.

## Main definitions

* `Module.Grassmannian.rankLocus N F s`: the ideal of `(s + 1) × (s + 1)` minors of the image of
  `A ⊗[R] F` in the quotient `(A ⊗[R] M) ⧸ N`.

## Main results

* `Module.Grassmannian.rankLocus_le_iff`: `N.rankLocus F s` is generated by the minors
  `det (φ j [1 ⊗ₜ m i])` with `m i ∈ F`.
* `Module.Grassmannian.rankLocus_map`: **the formation of `rankLocus` commutes with base change**.
* `Module.Grassmannian.rankLocus_eq_bot_iff`: over a field, `N.rankLocus F s` vanishes exactly
  when the image of `K ⊗[R] F` in the quotient has dimension at most `s`.
* `Module.Grassmannian.rankLocus_eq_bot_iff_finrank_inf`: the same condition in terms of the
  dimension of the intersection of `N` with `F.baseChange K`, the image of `K ⊗[R] F` in
  `K ⊗[R] M`.

## References

* [The Stacks Project, Tag 089R](https://stacks.math.columbia.edu/tag/089R), for the Grassmannian
  functor.
* W. Fulton, *Young tableaux*, London Mathematical Society Student Texts 35, Cambridge University
  Press (1997), §9.4, for the rank conditions defining Schubert varieties.
-/

public section

universe u v w

open TensorProduct Module

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M] {k : ℕ}
  {A B : Type w} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]

/-- The **rank locus** of a point `N` of `G(k, A ⊗[R] M; A)` for a submodule `F` of `M` and a
bound `s`: the ideal of `(s + 1) × (s + 1)` minors of the image of `A ⊗[R] F` in the quotient
`(A ⊗[R] M) ⧸ N`. It cuts out the closed subscheme of `Spec A` over which the map from `F` to the
quotient has rank at most `s` (`Module.Grassmannian.rankLocus_eq_bot_iff`). -/
noncomputable def rankLocus (N : G(k, A ⊗[R] M; A)) (F : Submodule R M) (s : ℕ) : Ideal A :=
  ((F.baseChange A).map N.toSubmodule.mkQ).minorsIdeal (s + 1)

/-- `N.rankLocus F s` is the ideal of `(s + 1) × (s + 1)` minors of the image of `A ⊗[R] F` in the
quotient by `N`. -/
theorem rankLocus_def (N : G(k, A ⊗[R] M; A)) (F : Submodule R M) (s : ℕ) :
    N.rankLocus F s = ((F.baseChange A).map N.toSubmodule.mkQ).minorsIdeal (s + 1) :=
  (rfl)

/-- The image of `A ⊗[R] F` in the quotient by `N` is spanned by the classes of the vectors
`1 ⊗ₜ m`, `m ∈ F`. -/
private theorem map_baseChange_mkQ (N : G(k, A ⊗[R] M; A)) (F : Submodule R M) :
    (F.baseChange A).map N.toSubmodule.mkQ =
      Submodule.span A ((fun m ↦ N.toSubmodule.mkQ (1 ⊗ₜ m)) '' F) := by
  rw [Submodule.baseChange_eq_span, Submodule.map_span, Submodule.map_coe, Set.image_image]
  rfl

/-- **The generators of `rankLocus`.** `N.rankLocus F s` is contained in an ideal `J` exactly when
every determinant `det (φ j [1 ⊗ₜ m i])` of `s + 1` linear functionals `φ j` on the quotient by `N`
at the classes of `s + 1` vectors `m i` of `F` lies in `J`. -/
theorem rankLocus_le_iff (N : G(k, A ⊗[R] M; A)) (F : Submodule R M) (s : ℕ) (J : Ideal A) :
    N.rankLocus F s ≤ J ↔
      ∀ (φ : Fin (s + 1) → Dual A ((A ⊗[R] M) ⧸ N.toSubmodule)) (m : Fin (s + 1) → M),
        (∀ i, m i ∈ F) →
          (Matrix.of fun i j ↦ φ j (N.toSubmodule.mkQ (1 ⊗ₜ m i))).det ∈ J := by
  rw [rankLocus_def, map_baseChange_mkQ, Submodule.minorsIdeal_span, TauCeti.minorsIdealOfSet_def,
    Ideal.span_le]
  refine ⟨fun h φ m hm ↦ h ⟨φ, _, fun i ↦ ⟨m i, hm i, rfl⟩, rfl⟩, ?_⟩
  rintro h _ ⟨φ, v, hv, rfl⟩
  choose m hm hmv using hv
  obtain rfl : v = fun i ↦ N.toSubmodule.mkQ (1 ⊗ₜ m i) := funext fun i ↦ (hmv i).symm
  exact h φ m hm

/-- A determinant `det (φ j [1 ⊗ₜ m i])` of `s + 1` linear functionals `φ j` on the quotient by `N`
at the classes of `s + 1` vectors `m i` of `F` lies in `N.rankLocus F s`. -/
theorem det_mem_rankLocus (N : G(k, A ⊗[R] M; A)) {F : Submodule R M} {s : ℕ}
    (φ : Fin (s + 1) → Dual A ((A ⊗[R] M) ⧸ N.toSubmodule)) {m : Fin (s + 1) → M}
    (hm : ∀ i, m i ∈ F) :
    (Matrix.of fun i j ↦ φ j (N.toSubmodule.mkQ (1 ⊗ₜ m i))).det ∈ N.rankLocus F s :=
  (rankLocus_le_iff N F s _).1 le_rfl φ m hm

/-- The rank loci grow with the submodule `F`. -/
theorem rankLocus_mono (N : G(k, A ⊗[R] M; A)) {F F' : Submodule R M} (h : F ≤ F') (s : ℕ) :
    N.rankLocus F s ≤ N.rankLocus F' s :=
  Submodule.minorsIdeal_mono (Submodule.map_mono (Submodule.baseChange_mono A h)) _

/-- The rank loci shrink as the bound on the rank grows. -/
theorem rankLocus_antitone (N : G(k, A ⊗[R] M; A)) (F : Submodule R M) :
    Antitone (N.rankLocus F) :=
  fun _ _ h ↦ Submodule.minorsIdeal_antitone _ (Nat.succ_le_succ h)

/-- **The formation of `rankLocus` commutes with base change.** For `f : A →ₐ[R] B`, the rank locus
of the base change of `N` to `B` is the ideal generated by the image under `f` of the rank locus of
`N`. -/
@[simp]
theorem rankLocus_map (f : A →ₐ[R] B) (N : G(k, A ⊗[R] M; A)) (F : Submodule R M) (s : ℕ) :
    (map f N).rankLocus F s = Ideal.map f (N.rankLocus F s) := by
  algebraize [f.toRingHom]
  -- `algebraize` makes `f` the structure map of `B` as an `A`-algebra
  have hf : IsScalarTower.toAlgHom R A B = f := AlgHom.ext fun _ ↦ rfl
  -- the quotient by the base change of `N` is the base change `B ⊗[A] Q` of the quotient `Q` by
  -- `N`, through `baseChangeMkQ`, and it carries the image of `B ⊗[R] F` to the `B`-span of the
  -- image of `A ⊗[R] F`
  have hN := map_toAlgHom_toSubmodule (B := B) N
  rw [hf] at hN
  let e : ((B ⊗[R] M) ⧸ (map f N).toSubmodule) ≃ₗ[B]
      B ⊗[A] ((A ⊗[R] M) ⧸ N.toSubmodule) :=
    (Submodule.quotEquivOfEq _ _ hN).trans
      ((baseChangeMkQ B N.toSubmodule).quotKerEquivOfSurjective
        (baseChangeMkQ_surjective N.toSubmodule))
  have himage : ((F.baseChange B).map (map f N).toSubmodule.mkQ).map (e : _ →ₗ[B] _) =
      Submodule.span B
        (TensorProduct.mk A B _ 1 '' ((F.baseChange A).map N.toSubmodule.mkQ :
          Set ((A ⊗[R] M) ⧸ N.toSubmodule))) := by
    rw [map_baseChange_mkQ, map_baseChange_mkQ, Submodule.map_span, ← Submodule.map_coe,
      Submodule.map_span, Submodule.span_span_of_tower, Set.image_image, Set.image_image]
    refine congrArg _ (Set.image_congr fun m _ ↦ ?_)
    simp [e]
  rw [rankLocus_def, ← Submodule.minorsIdeal_map_equiv e, himage,
    (TensorProduct.isBaseChange A _ B).minorsIdeal_span_image, rankLocus_def]
  rfl

section Field

variable {K : Type w} [Field K] [Algebra R K]

/-- **The rank locus over a field.** For a point `N` of `G(k, K ⊗[R] M; K)` over a field `K`, the
ideal `N.rankLocus F s` vanishes exactly when the image of `K ⊗[R] F` in the quotient by `N` has
dimension at most `s`. -/
theorem rankLocus_eq_bot_iff (N : G(k, K ⊗[R] M; K)) (F : Submodule R M) (s : ℕ) :
    N.rankLocus F s = ⊥ ↔ finrank K ((F.baseChange K).map N.toSubmodule.mkQ) ≤ s := by
  rw [rankLocus_def, Submodule.minorsIdeal_eq_bot_iff_finrank_lt, Nat.lt_succ_iff]

/-- **The rank locus over a field, by intersection dimensions.** For a point `N` of
`G(k, K ⊗[R] M; K)` over a field `K` and a submodule `F` of `M` whose base change
`F.baseChange K` (the image of `K ⊗[R] F → K ⊗[R] M`, which need not be injective) is
finite-dimensional, the ideal `N.rankLocus F s` vanishes exactly when
`dim (F.baseChange K) ≤ s + dim (F.baseChange K ⊓ N)`. -/
theorem rankLocus_eq_bot_iff_finrank_inf (N : G(k, K ⊗[R] M; K)) (F : Submodule R M)
    [FiniteDimensional K (F.baseChange K)] (s : ℕ) :
    N.rankLocus F s = ⊥ ↔
      finrank K (F.baseChange K) ≤ s + finrank K (F.baseChange K ⊓ N.toSubmodule : Submodule K _)
    := by
  -- rank–nullity for the restriction of the quotient map to `K ⊗[R] F`, whose kernel is the
  -- intersection with `N`
  have h := LinearMap.finrank_range_add_finrank_ker (V := F.baseChange K)
    (V₂ := (K ⊗[R] M) ⧸ N.toSubmodule) (N.toSubmodule.mkQ.domRestrict (F.baseChange K))
  rw [LinearMap.range_domRestrict, LinearMap.ker_domRestrict, Submodule.ker_mkQ,
    ← Submodule.finrank_map_subtype_eq, Submodule.map_comap_subtype] at h
  rw [rankLocus_eq_bot_iff]
  omega

end Field

end Module.Grassmannian
