module

public import TauCeti.RingTheory.Grassmannian.Basic

/-!
# The ideal cut out by a point of the Grassmannian at a point of `Spec H`

Let `H` be a commutative `R`-algebra and `B` an `R`-algebra. A point `N` of the Grassmannian
functor `G(k, B ⊗[R] H; B)` is a `B`-submodule of `B ⊗[R] H`; it generates an ideal of
`B ⊗[R] H`, which cuts out a closed subscheme of `Spec (B ⊗[R] H)`. An `R`-algebra map
`x : H → B`, a `B`-point of `Spec H`, gives the section `b ⊗ h ↦ b * x h` of
`Spec (B ⊗[R] H) ⟶ Spec B`. The ideal `N.evalIdeal x` of `B` is the image of `N` under this
section: it cuts out the closed subscheme of `Spec B` over which the point `x` lies in the closed
subscheme cut out by `N`.

The formation of this ideal commutes with base change (`Module.Grassmannian.map_evalIdeal`). More
generally, for `f : A → B` and a point `N` of `G(k, A ⊗[R] H; A)`, the ideal of the base change of
`N` at `x` is the image of the ideal generated by `N` under `A ⊗[R] H → B, a ⊗ h ↦ f a * x h`
(`Module.Grassmannian.evalIdeal_map`). Applied to the inclusion of `A` into `A ⊗[R] H` and the
point `h ↦ 1 ⊗ h`, this recovers the ideal generated by `N` itself
(`Module.Grassmannian.evalIdeal_map_includeLeft`).

These ideals are the ideals, over affine opens, of the universal quotient closed subscheme of
`G(k, H) ×_{Spec R} Spec H` (`Module.Grassmannian.schemeUniversalIdeal`).

## Main definitions

* `Module.Grassmannian.evalIdeal N x`: the ideal of `B` generated by the values at `x` of the
  elements of `N`.

## Main results

* `Module.Grassmannian.evalIdeal_eq_bot_iff`: `N.evalIdeal x` vanishes exactly when every element
  of `N` vanishes at `x`.
* `Module.Grassmannian.evalIdeal_map` and `Module.Grassmannian.map_evalIdeal`: compatibility with
  base change.
* `Module.Grassmannian.evalIdeal_map_includeLeft`: at the universal point, the ideal is the ideal
  generated by `N`.
-/

public section

universe u v w

open TensorProduct Algebra.TensorProduct

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {H : Type v} [CommRing H] [Algebra R H] {k : ℕ}
  {A B C : Type w} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B] [CommRing C]
  [Algebra R C]

/-- For a point `N` of `G(k, B ⊗[R] H; B)` and a `B`-point `x : H →ₐ[R] B` of `Spec H`, the ideal
of `B` generated by the values at `x` of the elements of `N`: the image of the ideal generated by
`N` under `B ⊗[R] H → B, b ⊗ h ↦ b * x h`. It cuts out the closed subscheme of `Spec B` over which
`x` lies in the closed subscheme `Spec ((B ⊗[R] H) ⧸ N)`. -/
noncomputable def evalIdeal (N : G(k, B ⊗[R] H; B)) (x : H →ₐ[R] B) : Ideal B :=
  (Ideal.span (N.toSubmodule : Set (B ⊗[R] H))).map (productMap (AlgHom.id R B) x)

/-- `N.evalIdeal x` is the image of the ideal generated by `N` under `b ⊗ h ↦ b * x h`. -/
theorem evalIdeal_def (N : G(k, B ⊗[R] H; B)) (x : H →ₐ[R] B) :
    N.evalIdeal x =
      (Ideal.span (N.toSubmodule : Set (B ⊗[R] H))).map (productMap (AlgHom.id R B) x) :=
  (rfl)

/-- `N.evalIdeal x` vanishes exactly when every element of `N` vanishes at `x`. -/
theorem evalIdeal_eq_bot_iff (N : G(k, B ⊗[R] H; B)) (x : H →ₐ[R] B) :
    N.evalIdeal x = ⊥ ↔ ∀ n ∈ N.toSubmodule, productMap (AlgHom.id R B) x n = 0 := by
  simp [evalIdeal, Ideal.map_span]

/-- **The ideal of a base change.** For `f : A →ₐ[R] B` and a point `N` of `G(k, A ⊗[R] H; A)`,
the ideal at `x` of the base change of `N` to `B` is the image of the ideal generated by `N` under
`A ⊗[R] H → B, a ⊗ h ↦ f a * x h`. -/
theorem evalIdeal_map (f : A →ₐ[R] B) (N : G(k, A ⊗[R] H; A)) (x : H →ₐ[R] B) :
    (map f N).evalIdeal x =
      (Ideal.span (N.toSubmodule : Set (A ⊗[R] H))).map (productMap f x) := by
  algebraize [f.toRingHom]
  have hf : IsScalarTower.toAlgHom R A B = f := AlgHom.ext fun _ ↦ rfl
  set S := f.toLinearMap.rTensor H '' (N.toSubmodule : Set (A ⊗[R] H))
  -- the base change of `N` is spanned over `B` by the image `S` of `N`, so it generates the same
  -- ideal of `B ⊗[R] H` as `S`
  have hspan : Ideal.span (Submodule.span B S : Set (B ⊗[R] H)) = Ideal.span S :=
    Submodule.span_span_of_tower B (B ⊗[R] H) S
  have hS (n : A ⊗[R] H) :
      productMap (AlgHom.id R B) x (f.toLinearMap.rTensor H n) = productMap f x n := by
    induction n using TensorProduct.inductionOn with
    | tmul a h => simp [productMap_apply_tmul]
    | add n n' hn hn' => simp only [map_add, hn, hn']
  rw [evalIdeal, ← hf, map_toAlgHom_toSubmodule, ker_baseChangeMkQ, hf, hspan, Ideal.map_span,
    Ideal.map_span, Set.image_image]
  simp_rw [hS]

/-- **The formation of `evalIdeal` commutes with base change.** -/
theorem map_evalIdeal (f : B →ₐ[R] C) (N : G(k, B ⊗[R] H; B)) (x : H →ₐ[R] B) :
    (N.evalIdeal x).map f = (map f N).evalIdeal (f.comp x) := by
  have h : f.comp (productMap (AlgHom.id R B) x) = productMap f (f.comp x) :=
    Algebra.TensorProduct.ext' fun b h ↦ by simp [productMap_apply_tmul]
  rw [evalIdeal_map, evalIdeal, ← h, ← Ideal.map_coe (f.comp _), AlgHom.comp_toRingHom,
    ← Ideal.map_map, Ideal.map_coe, Ideal.map_coe]

/-- **The ideal at the universal point.** For a point `N` of `G(k, A ⊗[R] H; A)`, the ideal at
the point `h ↦ 1 ⊗ h` of the base change of `N` to `A ⊗[R] H` is the ideal generated by `N`. -/
theorem evalIdeal_map_includeLeft {D : Type v} [CommRing D] [Algebra R D]
    (N : G(k, D ⊗[R] H; D)) :
    (map includeLeft N).evalIdeal includeRight =
      Ideal.span (N.toSubmodule : Set (D ⊗[R] H)) := by
  have h : productMap (includeLeft : D →ₐ[R] D ⊗[R] H) includeRight = AlgHom.id R _ :=
    Algebra.TensorProduct.ext' fun a h ↦ by simp [productMap_apply_tmul]
  rw [evalIdeal_map, h, Ideal.map_idₐ]

end Module.Grassmannian
