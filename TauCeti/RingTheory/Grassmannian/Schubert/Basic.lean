/-!
# Schubert cells and determinantal Schubert ideals on the Grassmannian

Let `M` be a free module over a commutative ring `R` with a basis `b` indexed by `Fin n`, and let
`F_j = b.flag j` be the complete flag spanned by its first `j` basis vectors. For strictly
increasing zero-based pivot positions `p : Fin r → Fin n`, the determinantal Schubert conditions on
a point `N ∈ G(k, A ⊗[R] M; A)` require each `F_{p i + 1}` to map to `(A ⊗[R] M) ⧸ N` with rank at
most `p i - i`.

This file develops the ring-theoretic and functorial theory of Schubert rank ideals, adapted
standard charts, and corepresentable Schubert cells:

* **Full-flag presentation and Bruhat monotonicity:** the ideal generated by the `r` jump conditions
  `N.rankLocus (b.flag (p i).succ) (p i - i)` agrees with the ideal generated by the rank
  conditions at all `n + 1` steps of the flag (`iSup_rankLocus_flag_succ_eq`), shrinks as `p`
  grows coordinatewise (`iSup_rankLocus_flag_succ_anti`), and vanishes whenever every bound
  `p i - i` is at least `k` (`iSup_rankLocus_flag_succ_eq_bot_of_le`).
* **Adapted standard chart and Schubert cell:** when `r + k = n`, let `q : Fin k ↪o Fin n`
  enumerate the complement of `S = Finset.univ.image p` (`schubertComplEmb`). Reindexing `b` by
  `p` and `q` (`schubertChartBasis`), the Schubert rank ideal of a point in the chart at `b ∘ q`
  with matrix `Φ : Matrix (Fin r) (Fin k) A` is generated by the entries `Φ i j` with `p i < q j`
  (`iSup_rankLocus_schubertChartBasis`). Setting those entries to zero leaves the free echelon
  entries `S.echelonFreeEntries`, giving a natural bijection `schubertCellEquiv` with the affine
  space `S.echelonFreeEntries → A` of dimension `∑ i, (p i - i)` and an `R`-algebra surjection
  `schubertChartAlgHom : ChartAlgebra R (b ∘ q) →ₐ[R] MvPolynomial S.echelonFreeEntries R` whose
  kernel is the universal Schubert rank ideal on the chart (`ker_schubertChartAlgHom`).

Field-point characterizations via `Module.Basis.flagPivots` and one-step polynomial deformations
are developed in `TauCeti.RingTheory.Grassmannian.Schubert.Field`; both files feed the scheme-level
Schubert cells and Schubert rank subschemes in `TauCeti.AlgebraicGeometry.Grassmannian.Schubert`.

## Main definitions

* `Module.Grassmannian.schubertComplEmb hp hnk`: order embedding enumerating the non-pivot indices.
* `Module.Grassmannian.schubertChartBasis b hp hnk`: `b` reindexed via pivots and non-pivots.
* `Module.Grassmannian.schubertEchelonMatrix hp hnk a`: the chart matrix of a reduced echelon point.
* `Module.Grassmannian.schubertCellEquiv b hp hnk A`: affine-space coordinates of the Schubert cell.
* `Module.Grassmannian.schubertCellFunctor b hp hnk`: the Schubert cell subfunctor, corepresented by
  `MvPolynomial (Finset.univ.image p).echelonFreeEntries R` (`schubertCellCorepresentableBy`).
* `Module.Grassmannian.schubertChartAlgHom b hp hnk`: surjective `R`-algebra map from the adapted
  `ChartAlgebra` onto the polynomial ring of the Schubert cell.

## Main results

* `Module.Grassmannian.iSup_rankLocus_flag_succ_eq`: equivalence of jump and full-flag rank ideals.
* `Module.Grassmannian.iSup_rankLocus_flag_succ_anti`: coordinatewise monotonicity in `p`.
* `Module.Grassmannian.iSup_rankLocus_flag_succ_eq_bot_of_le`: vanishing when `k ≤ p i - i`.
* `Module.Grassmannian.iSup_rankLocus_schubertChartBasis`: adapted-chart generators `Φ i j`
  (`p i < q j`) of the Schubert rank ideal.
* `Module.Grassmannian.ker_schubertChartAlgHom`: `RingHom.ker (schubertChartAlgHom b hp hnk)` is the
  universal Schubert rank ideal on the adapted chart.

## References

* W. Fulton, *Young tableaux*, London Mathematical Society Student Texts 35, Cambridge University
  Press (1997), §9.4.
* W. V. D. Hodge, D. Pedoe, *Methods of Algebraic Geometry*, Vol. II, Cambridge University Press
  (1952), Book IV, Chapter XIV, for Schubert varieties and their cells.
* [The Stacks Project, Tag 089R](https://stacks.math.columbia.edu/tag/089R), for the Grassmannian
  functor.
-/

public section

universe u v w

open CategoryTheory TensorProduct Module Finset

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
  {A B : Type w} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]

/-! ### Full-flag presentation and Bruhat monotonicity of Schubert rank ideals -/

section FullFlag

variable {n r k : ℕ}

/-- **Full-flag presentation of the Schubert rank ideal.** For strictly increasing pivot positions
`p : Fin r → Fin n`, the ideal generated by the `r` jump conditions
`N.rankLocus (b.flag (p i).succ) (p i - i)` agrees with the ideal generated by the rank conditions
at all `n + 1` subspaces of the complete flag `b.flag`. -/
theorem iSup_rankLocus_flag_succ_eq (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (N : G(k, A ⊗[R] M; A)) :
    (⨆ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) =
      ⨆ j : Fin (n + 1), N.rankLocus (b.flag j) ((j : ℕ) - #{i : Fin r | (p i).castSucc < j}) := by
  have hsub (i : Fin r) :
      ((p i).succ : ℕ) - #{l : Fin r | (p l).castSucc < (p i).succ} = (p i : ℕ) - i := by
    have hset : ({l | (p l).castSucc < (p i).succ} : Finset (Fin r)) = Iic i := by
      ext l; simp [Fin.castSucc_lt_succ_iff, hp.le_iff_le]
    rw [hset, Fin.card_Iic, Fin.val_succ]; omega
  refine le_antisymm (iSup_le fun i ↦ hsub i ▸ le_iSup (fun j : Fin (n + 1) ↦
      N.rankLocus (b.flag j) ((j : ℕ) - #{l : Fin r | (p l).castSucc < j})) (p i).succ)
    (iSup_le fun j ↦ ?_)
  induction j using Fin.induction with
  | zero => rw [b.flag_zero, rankLocus_bot]; exact bot_le
  | succ t ih =>
    by_cases ht : ∃ i : Fin r, p i = t
    · obtain ⟨i, rfl⟩ := ht
      exact hsub i ▸ le_iSup (fun i : Fin r ↦ N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) i
    · push Not at ht
      have hcard : #{l : Fin r | (p l).castSucc < t.succ} =
          #{l : Fin r | (p l).castSucc < t.castSucc} := by
        congr 1; ext l
        simp [Fin.castSucc_lt_succ_iff, le_iff_lt_or_eq, ht l]
      have hle : #{l : Fin r | (p l).castSucc < t.castSucc} ≤ (t : ℕ) := by
        rw [← card_image_of_injective _ hp.injective, ← Fin.card_Iio t]
        exact card_le_card <| image_subset_iff.mpr fun l hl ↦
          mem_Iio.mpr (Fin.castSucc_lt_castSucc_iff.mp (mem_filter.mp hl).2)
      have hstep : (t.succ : ℕ) - #{l : Fin r | (p l).castSucc < t.succ} =
          ((t.castSucc : ℕ) - #{l : Fin r | (p l).castSucc < t.castSucc}) + 1 := by
        rw [hcard, Fin.val_succ, Fin.val_castSucc]; omega
      rw [hstep, b.flag_succ, sup_comm]
      exact (N.rankLocus_sup_span_singleton_succ_le _ _ _).trans ih

/-- **Bruhat monotonicity of the Schubert rank ideal.** If `p, p' : Fin r → Fin n` are strictly
increasing with `p' i ≤ p i` for every `i`, then the Schubert rank ideal of `p` is contained in
that of `p'`: larger pivots cut out a larger closed locus. -/
theorem iSup_rankLocus_flag_succ_anti (b : Basis (Fin n) R M) {p p' : Fin r → Fin n}
    (hp : StrictMono p) (hp' : StrictMono p') (hle : ∀ i, p' i ≤ p i)
    (N : G(k, A ⊗[R] M; A)) :
    (⨆ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) ≤
      ⨆ i : Fin r, N.rankLocus (b.flag (p' i).succ) ((p' i : ℕ) - i) := by
  rw [iSup_rankLocus_flag_succ_eq b hp N, iSup_rankLocus_flag_succ_eq b hp' N]
  refine iSup_mono fun j ↦ N.rankLocus_antitone (b.flag j) ?_
  have hcard : #{i : Fin r | (p i).castSucc < j} ≤ #{i : Fin r | (p' i).castSucc < j} :=
    card_le_card fun i hi ↦ mem_filter.mpr ⟨mem_univ i,
      (Fin.castSucc_le_castSucc_iff.mpr (hle i)).trans_lt (mem_filter.mp hi).2⟩
  omega

/-- If every Schubert rank bound `p i - i` is at least `k`, then the Schubert rank ideal vanishes
identically on `G(k, A ⊗[R] M; A)`. -/
theorem iSup_rankLocus_flag_succ_eq_bot_of_le (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : ∀ i, k ≤ (p i : ℕ) - i) (N : G(k, A ⊗[R] M; A)) :
    (⨆ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) = ⊥ :=
  iSup_eq_bot.mpr fun i ↦ N.rankLocus_eq_bot_of_le _ (hp i)

end FullFlag

/-! ### Adapted standard chart and determinantal ideal -/

section AdaptedChart

variable {n r k : ℕ} (b : Basis (Fin n) R M) {p : Fin r → Fin n} (hp : StrictMono p)
  (hnk : r + k = n)

/-- The order embedding `Fin k ↪o Fin n` enumerating the complement of the pivot set
`Finset.univ.image p` in increasing order. -/
noncomputable def schubertComplEmb : Fin k ↪o Fin n :=
  (univ.image p)ᶜ.orderEmbOfFin (hp.card_compl_image_eq_of_add_eq hnk)

/-- Every index in `schubertComplEmb hp hnk` lies outside `Finset.univ.image p`. -/
theorem schubertComplEmb_notMem_image (j : Fin k) :
    schubertComplEmb hp hnk j ∉ univ.image p :=
  mem_compl.mp ((univ.image p)ᶜ.orderEmbOfFin_mem (hp.card_compl_image_eq_of_add_eq hnk) j)

/-- A non-pivot index is never equal to a pivot index. -/
theorem schubertComplEmb_ne (i : Fin r) (j : Fin k) :
    schubertComplEmb hp hnk j ≠ p i :=
  fun h ↦ schubertComplEmb_notMem_image hp hnk j (h ▸ mem_image_of_mem p (mem_univ i))

/-- The image of `schubertComplEmb hp hnk` is the complement of `Finset.univ.image p`. -/
@[simp]
theorem image_schubertComplEmb :
    univ.image (schubertComplEmb hp hnk) = (univ.image p)ᶜ :=
  Finset.image_orderEmbOfFin_univ _ _

/-- The number of non-pivot indices strictly below `p i` is `p i - i`. -/
@[simp]
theorem card_filter_schubertComplEmb_lt (i : Fin r) :
    #{j : Fin k | schubertComplEmb hp hnk j < p i} = (p i : ℕ) - i := by
  have hpiv : {t ∈ Iio (p i) | t ∈ univ.image p} = (Iio i).image p := by
    ext t; simp only [mem_filter, mem_Iio, mem_image, mem_univ, true_and]
    exact ⟨fun ⟨ht, l, hl⟩ ↦ ⟨l, hp.lt_iff_lt.mp (hl ▸ ht), hl⟩,
      fun ⟨l, hl, hlt⟩ ↦ ⟨hlt ▸ hp hl, l, hlt⟩⟩
  have hcompl : {t ∈ Iio (p i) | t ∉ univ.image p} =
      Finset.image (schubertComplEmb hp hnk) {j | schubertComplEmb hp hnk j < p i} := by
    ext t; rw [mem_filter, mem_Iio, ← mem_compl, ← image_schubertComplEmb hp hnk]
    simp only [mem_image, mem_filter, mem_univ, true_and]
    exact ⟨by rintro ⟨ht, j, rfl⟩; exact ⟨j, ht, rfl⟩, by rintro ⟨j, hj, rfl⟩; exact ⟨hj, j, rfl⟩⟩
  have h := card_filter_add_card_filter_not (s := Iio (p i)) (· ∈ univ.image p)
  rw [hpiv, hcompl, card_image_of_injective _ hp.injective,
    card_image_of_injective _ (schubertComplEmb hp hnk).injective, Fin.card_Iio, Fin.card_Iio] at h
  omega

private noncomputable def schubertIndexEquiv : Fin n ≃ Fin r ⊕ Fin k :=
  (Equiv.ofBijective (Sum.elim p (schubertComplEmb hp hnk)) <|
    (Fintype.bijective_iff_injective_and_card _).mpr
      ⟨Sum.elim_injective.mpr ⟨hp.injective, (schubertComplEmb hp hnk).injective,
        fun i j h ↦ (schubertComplEmb_ne hp hnk i j h.symm).elim⟩,
      by simp [hnk]⟩).symm

/-- The basis `b` reindexed by `Fin r ⊕ Fin k` so that the `Fin r` summand enumerates the pivot
vectors `b (p i)` and the `Fin k` summand enumerates the non-pivot vectors
`b (schubertComplEmb hp hnk j)`. The standard chart of `G(k, M)` adapted to `p` is the chart at
these last `k` basis vectors. -/
noncomputable def schubertChartBasis : Basis (Fin r ⊕ Fin k) R M :=
  b.reindex (schubertIndexEquiv hp hnk)

@[simp]
theorem schubertChartBasis_inl (i : Fin r) :
    schubertChartBasis b hp hnk (.inl i) = b (p i) := by
  rw [schubertChartBasis, Basis.reindex_apply, schubertIndexEquiv, Equiv.symm_symm,
    Equiv.ofBijective_apply, Sum.elim_inl]

theorem schubertChartBasis_inr (j : Fin k) :
    schubertChartBasis b hp hnk (.inr j) = b (schubertComplEmb hp hnk j) := by
  rw [schubertChartBasis, Basis.reindex_apply, schubertIndexEquiv, Equiv.symm_symm,
    Equiv.ofBijective_apply, Sum.elim_inr]

private theorem chartBasisEquiv_apply_mem_rankLocus
    (N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)))
    {i : Fin r} {j : Fin k} (hij : p i < schubertComplEmb hp hnk j) :
    chartBasisEquiv (schubertChartBasis b hp hnk) A N i j ∈
      N.val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) := by
  set q := schubertComplEmb hp hnk
  set s := (p i : ℕ) - i
  let T : Finset (Fin k) := {j' : Fin k | q j' < p i}
  let e : Fin s ≃ T := (T.orderIsoOfFin (card_filter_schubertComplEmb_lt hp hnk i)).toEquiv
  let m : Fin (s + 1) → M := Fin.snoc (fun u : Fin s ↦ b (q (e u).val)) (b (p i))
  have hm (u : Fin (s + 1)) : m u ∈ b.flag (p i).succ :=
    u.lastCases (by simpa [m] using b.self_mem_flag Fin.castSucc_lt_succ) fun u₀ ↦ by
      simpa [m] using b.self_mem_flag (Fin.castSucc_lt_succ_iff.mpr (mem_filter.mp
          (e u₀).property).2.le)
  let idx : Fin (s + 1) → Fin k := Fin.snoc (fun v : Fin s ↦ (e v).val) j
  let φ : Fin (s + 1) → Dual A ((A ⊗[R] M) ⧸ N.val.toSubmodule) :=
    fun v ↦ LinearMap.proj (idx v) ∘ₗ (chartQuotEquiv N).symm.toLinearMap
  have hφ (y : A ⊗[R] M) (v : Fin (s + 1)) :
      φ v (N.val.toSubmodule.mkQ y) = (chartEquiv A _ N).val y (idx v) :=
    congrFun ((LinearEquiv.symm_apply_eq _).mpr (chartQuotEquiv_chartEquiv_apply _ N y).symm) _
  have hψq (j' : Fin k) : (chartEquiv A _ N).val (1 ⊗ₜ b (q j')) = Pi.single j' 1 := by
    rw [← schubertChartBasis_inr b hp hnk j']; exact chartEquiv_apply_apply_self _ N j'
  let B : Matrix (Fin (s + 1)) (Fin (s + 1)) A :=
    Matrix.of fun u v ↦ φ v (N.val.toSubmodule.mkQ (1 ⊗ₜ m u))
  have hB_tri : B.IsLowerTriangular := fun u v (huv : u < v) ↦ by
    obtain ⟨u₀, rfl⟩ := Fin.exists_castSucc_eq.mpr (huv.trans_le (Fin.le_last v)).ne
    dsimp only [B, m]; rw [Matrix.of_apply, hφ, Fin.snoc_castSucc, hψq]
    revert huv
    refine v.lastCases (fun _ ↦ Pi.single_eq_of_ne (fun h ↦ ?_) 1) fun v₀ hv ↦
      Pi.single_eq_of_ne (fun h ↦ ?_) 1
    · exact ((mem_filter.mp (e u₀).property).2.trans hij).ne' (congrArg q (by simpa [idx] using h))
    · exact (Fin.castSucc_lt_castSucc_iff.mp hv).ne
        (e.injective (Subtype.ext (by simpa [idx] using h.symm)))
  have hB_det : B.det = chartBasisEquiv (schubertChartBasis b hp hnk) A N i j := by
    rw [Matrix.det_of_isLowerTriangular B hB_tri, Fin.prod_univ_castSucc]
    dsimp only [B]; simp only [Matrix.of_apply, hφ]
    simp [m, idx, hψq, chartBasisEquiv_apply, schubertChartBasis_inl]
  exact hB_det ▸ N.val.det_mem_rankLocus φ hm

private theorem rankLocus_schubertChartBasis_eq_bot_of_eq_zero (Φ : Matrix (Fin r) (Fin k) A)
    (hΦ : ∀ (i' : Fin r) (j : Fin k), p i' < schubertComplEmb hp hnk j → Φ i' j = 0)
    (i : Fin r) :
    ((chartBasisEquiv (schubertChartBasis b hp hnk) A).symm Φ).val.rankLocus
      (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥ := by
  set q := schubertComplEmb hp hnk
  set N := (chartBasisEquiv (schubertChartBasis b hp hnk) A).symm Φ
  let T : Finset (Fin k) := {j : Fin k | q j < p i}
  have hzero {t : Fin n} (htp : t ≤ p i) {j : Fin k} (hpj : p i < q j) :
      (chartEquiv A _ N).val (1 ⊗ₜ b t) j = 0 := by
    obtain ⟨i' | j', heq⟩ := (schubertIndexEquiv hp hnk).symm.surjective t
    · obtain rfl : p i' = t := by simpa [schubertIndexEquiv] using heq
      have hval : (chartEquiv A _ N).val (1 ⊗ₜ b (p i')) = Φ i' := by
        rw [← Equiv.apply_symm_apply (chartBasisEquiv (schubertChartBasis b hp hnk) A) Φ,
          chartBasisEquiv_apply, schubertChartBasis_inl]
      rw [hval, hΦ i' j (htp.trans_lt hpj)]
    · obtain rfl : q j' = t := by simpa [q, schubertIndexEquiv] using heq
      have hval : (chartEquiv A _ N).val (1 ⊗ₜ b (q j')) = Pi.single j' 1 := by
        simpa [q, schubertChartBasis_inr] using chartEquiv_apply_apply_self _ N j'
      rw [hval, Pi.single_eq_of_ne fun hjj' ↦ (htp.trans_lt hpj).ne (congrArg _ hjj'.symm)]
  have hcomp :
      (chartQuotEquiv N).symm.toLinearMap ∘ₗ N.val.toSubmodule.mkQ = (chartEquiv A _ N).val :=
    LinearMap.ext fun x ↦ (LinearEquiv.symm_apply_eq _).mpr
      (chartQuotEquiv_chartEquiv_apply _ N x).symm
  rw [rankLocus_def, ← Submodule.minorsIdeal_map_equiv (chartQuotEquiv N).symm]
  refine Submodule.minorsIdeal_eq_bot_of_le_span_range (v := fun u : T ↦ Pi.single u.val (1 : A)) ?_
    (by rw [Nat.card_eq_fintype_card, Fintype.card_coe, card_filter_schubertComplEmb_lt]; omega)
  rw [← Submodule.map_comp, hcomp, Basis.flag, Submodule.baseChange_span, Submodule.map_span,
    Set.image_image, Set.image_image, Submodule.span_le]
  rintro _ ⟨t, ht, rfl⟩
  dsimp only; rw [TensorProduct.mk_apply]
  set v := (chartEquiv A _ N).val (1 ⊗ₜ b t) with hv
  rw [← Finset.univ_sum_single v]
  refine sum_mem fun j _ ↦ ?_
  by_cases hj : j ∈ T
  · rw [← mul_one (v j), ← smul_eq_mul, Pi.single_smul]
    exact Submodule.smul_mem _ (v j) (Submodule.subset_span ⟨⟨j, hj⟩, rfl⟩)
  · have hpj : p i < q j := lt_of_le_of_ne (not_lt.mp (by simpa [T] using hj))
      (schubertComplEmb_ne hp hnk i j).symm
    rw [hv, hzero (Fin.castSucc_lt_succ_iff.mp ht) hpj, Pi.single_zero]
    exact zero_mem _

/-- **The Schubert rank ideal in the adapted chart.** For a point `N` of the standard chart at the
non-pivot basis vectors `b (schubertComplEmb hp hnk j)` with matrix
`Φ = chartBasisEquiv (schubertChartBasis b hp hnk) A N`, the Schubert rank ideal of `p` at `N` is
generated by the entries `Φ i j` with `p i < schubertComplEmb hp hnk j`. -/
theorem iSup_rankLocus_schubertChartBasis
    (N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j))) :
    (⨆ i : Fin r, N.val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) =
      Ideal.span {a : A | ∃ (i : Fin r) (j : Fin k),
        p i < schubertComplEmb hp hnk j ∧
          chartBasisEquiv (schubertChartBasis b hp hnk) A N i j = a} := by
  set Φ := chartBasisEquiv (schubertChartBasis b hp hnk) A N
  set J := Ideal.span {a : A | ∃ (i : Fin r) (j : Fin k),
    p i < schubertComplEmb hp hnk j ∧ Φ i j = a}
  refine le_antisymm (iSup_le fun i ↦ ?_) (Ideal.span_le.mpr ?_)
  · let π : A →ₐ[R] A ⧸ J := Ideal.Quotient.mkₐ R J
    have hker : RingHom.ker π = J := Ideal.Quotient.mkₐ_ker R J
    have hN : (chartBasisEquiv (schubertChartBasis b hp hnk) A).symm Φ = N :=
      Equiv.symm_apply_apply _ N
    rw [← hker, ← Ideal.map_eq_bot_iff_le_ker, ← rankLocus_map, ← hN, map_chartBasisEquiv_symm]
    refine rankLocus_schubertChartBasis_eq_bot_of_eq_zero b hp hnk (Φ.map π) (fun i' j hij ↦ ?_) i
    rw [Matrix.map_apply, ← RingHom.mem_ker, hker]
    exact Ideal.subset_span ⟨i', j, hij, rfl⟩
  · rintro _ ⟨i, j, hij, rfl⟩
    exact le_iSup (fun i : Fin r ↦ N.val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) i
      (chartBasisEquiv_apply_mem_rankLocus b hp hnk N hij)

/-- A point `N` of the adapted chart satisfies all Schubert rank conditions for `p` if and only if
its chart matrix `Φ` vanishes at all pairs `(i, j)` with `p i < schubertComplEmb hp hnk j`. -/
theorem rankLocus_schubertChartBasis_eq_bot_iff
    (N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j))) :
    (∀ i : Fin r, N.val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥) ↔
      ∀ (i : Fin r) (j : Fin k), p i < schubertComplEmb hp hnk j →
        chartBasisEquiv (schubertChartBasis b hp hnk) A N i j = 0 := by
  rw [← iSup_eq_bot, iSup_rankLocus_schubertChartBasis b hp hnk N, Ideal.span_eq_bot]
  exact ⟨fun h i j hij ↦ h _ ⟨i, j, hij, rfl⟩, by rintro h _ ⟨i, j, hij, rfl⟩; exact h i j hij⟩

end AdaptedChart

/-! ### Echelon parametrization and corepresentability of the Schubert cell -/

section Cell

variable {n r k : ℕ} (b : Basis (Fin n) R M) {p : Fin r → Fin n} (hp : StrictMono p)
  (hnk : r + k = n)

private noncomputable def schubertFreeEntriesEquiv :
    {ij : Fin r × Fin k // schubertComplEmb hp hnk ij.2 < p ij.1} ≃
      (univ.image p).echelonFreeEntries :=
  Equiv.ofBijective
    (fun ij ↦ ⟨(p ij.val.1, schubertComplEmb hp hnk ij.val.2),
      mem_echelonFreeEntries.mpr ⟨mem_image_of_mem p (mem_univ _), ij.property,
        schubertComplEmb_notMem_image hp hnk _⟩⟩)
    ⟨fun ⟨⟨i₁, j₁⟩, _⟩ ⟨⟨i₂, j₂⟩, _⟩ h ↦ by
      obtain ⟨hi, hj⟩ := Prod.mk.inj (Subtype.mk.inj h)
      exact Subtype.ext (Prod.ext (hp.injective hi) ((schubertComplEmb hp hnk).injective hj)),
    fun ⟨⟨s, t⟩, hx⟩ ↦ by
      obtain ⟨hs, hts, ht⟩ := mem_echelonFreeEntries.mp hx
      obtain ⟨i, -, rfl⟩ := mem_image.mp hs
      rw [← mem_compl, ← image_schubertComplEmb hp hnk] at ht
      obtain ⟨j, -, rfl⟩ := mem_image.mp ht
      exact ⟨⟨(i, j), hts⟩, rfl⟩⟩

@[simp]
private theorem schubertFreeEntriesEquiv_apply
    (ij : {ij : Fin r × Fin k // schubertComplEmb hp hnk ij.2 < p ij.1}) :
    (schubertFreeEntriesEquiv hp hnk ij).val = (p ij.val.1, schubertComplEmb hp hnk ij.val.2) :=
  rfl

@[simp]
private theorem schubertFreeEntriesEquiv_symm_apply {i : Fin r} {j : Fin k}
    (h : (p i, schubertComplEmb hp hnk j) ∈ (univ.image p).echelonFreeEntries) :
    (schubertFreeEntriesEquiv hp hnk).symm ⟨(p i, schubertComplEmb hp hnk j), h⟩ =
      ⟨(i, j), (mem_echelonFreeEntries.mp h).2.1⟩ :=
  (Equiv.symm_apply_eq _).mpr rfl

/-- The `r × k` chart matrix corresponding to free echelon entries
`a : (Finset.univ.image p).echelonFreeEntries → α`. Writing `q = schubertComplEmb hp hnk`, its
`(i, j)`-entry is `-a (p i, q j)` at a free position `q j < p i`, and `0` when `p i < q j`. The
minus sign matches `Module.Grassmannian.chartGraphVector` with `Module.Basis.echelonRow`. -/
noncomputable def schubertEchelonMatrix {α : Type*} [AddGroup α]
    (a : (univ.image p).echelonFreeEntries → α) : Matrix (Fin r) (Fin k) α :=
  Matrix.of fun i j ↦
    if h : (p i, schubertComplEmb hp hnk j) ∈ (univ.image p).echelonFreeEntries then
      -a ⟨(p i, schubertComplEmb hp hnk j), h⟩
    else 0

/-- At a free position `schubertComplEmb hp hnk j < p i`, `schubertEchelonMatrix hp hnk a i j`
evaluates to `-a ⟨(p i, schubertComplEmb hp hnk j), _⟩`. -/
@[simp]
theorem schubertEchelonMatrix_apply_of_lt {α : Type*} [AddGroup α]
    (a : (univ.image p).echelonFreeEntries → α)
    {i : Fin r} {j : Fin k} (hij : schubertComplEmb hp hnk j < p i) :
    schubertEchelonMatrix hp hnk a i j =
      -a ⟨(p i, schubertComplEmb hp hnk j), mem_echelonFreeEntries.mpr
        ⟨mem_image_of_mem p (mem_univ i), hij, schubertComplEmb_notMem_image hp hnk j⟩⟩ := by
  rw [schubertEchelonMatrix, Matrix.of_apply, dite_eq_left]

/-- At a non-free position `p i < schubertComplEmb hp hnk j`,
`schubertEchelonMatrix hp hnk a i j` vanishes. -/
@[simp]
theorem schubertEchelonMatrix_eq_zero_of_lt {α : Type*} [AddGroup α]
    (a : (univ.image p).echelonFreeEntries → α)
    {i : Fin r} {j : Fin k} (hij : p i < schubertComplEmb hp hnk j) :
    schubertEchelonMatrix hp hnk a i j = 0 := by
  rw [schubertEchelonMatrix, Matrix.of_apply, dite_eq_right]
  exact fun h ↦ (mem_echelonFreeEntries.mp h).2.1.not_gt hij

/-- Applying an additive homomorphism entrywise to `schubertEchelonMatrix hp hnk a` composes `a`
with the homomorphism. -/
@[simp]
theorem schubertEchelonMatrix_map {α β : Type*} [AddGroup α] [AddGroup β]
    {F : Type*} [FunLike F α β] [AddMonoidHomClass F α β] (f : F)
    (a : (univ.image p).echelonFreeEntries → α) :
    (schubertEchelonMatrix hp hnk a).map f = schubertEchelonMatrix hp hnk (f ∘ a) :=
  Matrix.ext fun _ _ ↦ by simp [schubertEchelonMatrix, apply_dite f]

/-- The `i`-th graph vector of `schubertEchelonMatrix hp hnk a` in the adapted chart basis is the
reduced echelon row `(b.baseChange A).echelonRow (Finset.univ.image p) a (p i)`. -/
@[simp]
theorem chartGraphVector_schubertEchelonMatrix (a : (univ.image p).echelonFreeEntries → A)
    (i : Fin r) :
    chartGraphVector (schubertChartBasis b hp hnk) (schubertEchelonMatrix hp hnk a) i =
      (b.baseChange A).echelonRow (univ.image p) a (p i) := by
  refine (b.baseChange A).repr.injective (Finsupp.ext fun t ↦ ?_)
  rw [chartGraphVector_def, schubertChartBasis_inl, map_sub, map_sum, Finsupp.sub_apply,
    Finset.sum_apply']
  simp_rw [schubertChartBasis_inr, LinearEquiv.map_smul, Finsupp.smul_apply,
    ← Basis.baseChange_apply, Basis.repr_self, smul_eq_mul]
  obtain ⟨i' | j', heq⟩ := (schubertIndexEquiv hp hnk).symm.surjective t
  · obtain rfl : p i' = t := by simpa [schubertIndexEquiv] using heq
    rw [sum_eq_zero fun j _ ↦ by
      rw [Finsupp.single_eq_of_ne (schubertComplEmb_ne hp hnk i' j).symm, mul_zero],
      sub_zero, Basis.repr_echelonRow_of_mem a (p i) (mem_image_of_mem p (mem_univ i'))]
  · obtain rfl : schubertComplEmb hp hnk j' = t := by simpa [schubertIndexEquiv] using heq
    rw [Finsupp.single_eq_of_ne (schubertComplEmb_ne hp hnk i j'), zero_sub,
      Basis.repr_echelonRow, ite_eq_right (schubertComplEmb_ne hp hnk i j'),
      Finset.sum_eq_single j' (fun j _ hjj' ↦ by
        rw [Finsupp.single_eq_of_ne ((schubertComplEmb hp hnk).injective.ne hjj'.symm), mul_zero])
        (by simp),
      Finsupp.single_eq_same, mul_one, schubertEchelonMatrix, Matrix.of_apply]
    split_ifs <;> simp

/-- **Affine-space parametrization of the Schubert cell over an `R`-algebra.** The points of the
adapted chart at `b ∘ schubertComplEmb hp hnk` over `A` on which the Schubert rank loci of `p`
vanish are in bijection with `(Finset.univ.image p).echelonFreeEntries → A`. By
`StrictMono.card_echelonFreeEntries_image`, there are `∑ i, (p i - i)` coordinates. -/
noncomputable def schubertCellEquiv (A : Type w) [CommRing A] [Algebra R A] :
    {N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) //
      ∀ i : Fin r, N.val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥} ≃
      ((univ.image p).echelonFreeEntries → A) where
  toFun N x :=
    -chartBasisEquiv (schubertChartBasis b hp hnk) A N.val
      ((schubertFreeEntriesEquiv hp hnk).symm x).val.1
      ((schubertFreeEntriesEquiv hp hnk).symm x).val.2
  invFun a :=
    ⟨(chartBasisEquiv (schubertChartBasis b hp hnk) A).symm (schubertEchelonMatrix hp hnk a),
      (rankLocus_schubertChartBasis_eq_bot_iff b hp hnk _).mpr fun i j hij ↦ by
        rw [Equiv.apply_symm_apply]; exact schubertEchelonMatrix_eq_zero_of_lt hp hnk a hij⟩
  left_inv N := by
    refine Subtype.ext <| (chartBasisEquiv (schubertChartBasis b hp hnk) A).injective ?_
    rw [Equiv.apply_symm_apply]; ext i j
    rcases lt_or_gt_of_ne (schubertComplEmb_ne hp hnk i j) with hij | hij
    · simp [hij]
    · rw [schubertEchelonMatrix_eq_zero_of_lt hp hnk _ hij]
      exact ((rankLocus_schubertChartBasis_eq_bot_iff b hp hnk N.val).mp N.property i j hij).symm
  right_inv a := by
    funext x
    obtain ⟨⟨⟨i, j⟩, hij⟩, rfl⟩ := (schubertFreeEntriesEquiv hp hnk).surjective x
    dsimp only at hij ⊢
    rw [Equiv.symm_apply_apply, Equiv.apply_symm_apply,
      schubertEchelonMatrix_apply_of_lt hp hnk a hij, neg_neg]
    rfl

/-- The free coordinate of `schubertCellEquiv b hp hnk A N` at `(p i, schubertComplEmb hp hnk j)`
is `-chartBasisEquiv (schubertChartBasis b hp hnk) A N.1 i j`. -/
@[simp]
theorem schubertCellEquiv_apply
    (N : {N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) //
      ∀ i : Fin r, N.val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥})
    {i : Fin r} {j : Fin k}
    (h : (p i, schubertComplEmb hp hnk j) ∈ (univ.image p).echelonFreeEntries) :
    schubertCellEquiv b hp hnk A N ⟨(p i, schubertComplEmb hp hnk j), h⟩ =
      -chartBasisEquiv (schubertChartBasis b hp hnk) A N.val i j := by
  simp [schubertCellEquiv]

/-- The chart matrix of `(schubertCellEquiv b hp hnk A).symm a` in the adapted chart basis is
`schubertEchelonMatrix hp hnk a`. -/
theorem chartBasisEquiv_schubertCellEquiv_symm (a : (univ.image p).echelonFreeEntries → A) :
    chartBasisEquiv (schubertChartBasis b hp hnk) A ((schubertCellEquiv b hp hnk A).symm a).val =
      schubertEchelonMatrix hp hnk a :=
  Equiv.apply_symm_apply _ _

/-- The underlying adapted-chart point of `(schubertCellEquiv b hp hnk A).symm a` corresponds to
`schubertEchelonMatrix hp hnk a` under `chartBasisEquiv`. -/
@[simp]
theorem coe_schubertCellEquiv_symm_apply (a : (univ.image p).echelonFreeEntries → A) :
    ((schubertCellEquiv b hp hnk A).symm a).val =
      (chartBasisEquiv (schubertChartBasis b hp hnk) A).symm (schubertEchelonMatrix hp hnk a) :=
  (Equiv.eq_symm_apply _).mpr (chartBasisEquiv_schubertCellEquiv_symm b hp hnk a)

/-- **The point of the Schubert cell with free entries `a` is spanned by the reduced echelon
rows.** -/
theorem toSubmodule_schubertCellEquiv_symm (a : (univ.image p).echelonFreeEntries → A) :
    ((schubertCellEquiv b hp hnk A).symm a).val.val.toSubmodule =
      Submodule.span A (Set.range fun s : univ.image p ↦
        (b.baseChange A).echelonRow (univ.image p) a s) := by
  rw [coe_schubertCellEquiv_symm_apply, toSubmodule_chartBasisEquiv_symm]
  refine congrArg (Submodule.span A) (Set.ext fun v ↦ ?_)
  simp only [Set.mem_range, chartGraphVector_schubertEchelonMatrix]
  exact ⟨by rintro ⟨i, rfl⟩; exact ⟨⟨p i, mem_image_of_mem p (mem_univ i)⟩, rfl⟩,
    by rintro ⟨⟨_, hs⟩, rfl⟩; obtain ⟨i, -, rfl⟩ := mem_image.mp hs; exact ⟨i, rfl⟩⟩

/-- **Naturality of the Schubert cell coordinates.** Base change along `f : A →ₐ[R] B` applies `f`
to the free echelon entries. -/
theorem map_schubertCellEquiv_symm (f : A →ₐ[R] B) (a : (univ.image p).echelonFreeEntries → A) :
    map f ((schubertCellEquiv b hp hnk A).symm a).val.val =
      ((schubertCellEquiv b hp hnk B).symm (f ∘ a)).val.val := by
  rw [coe_schubertCellEquiv_symm_apply, coe_schubertCellEquiv_symm_apply,
    map_chartBasisEquiv_symm, schubertEchelonMatrix_map]

/-- **The Schubert cell as a subfunctor** of the Grassmannian functor: over `A`, it consists of
the points of `G(k, A ⊗[R] M; A)` lying in the adapted chart at `b ∘ schubertComplEmb hp hnk` on
which all Schubert rank loci of `p` vanish. -/
noncomputable def schubertCellFunctor :
    Subfunctor (functor.{u, v, w} (R := R) (M := M) k) where
  obj A := {N : G(k, A ⊗[R] M; A) |
    N ∈ chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) ∧
      ∀ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥}
  map {A B} f N hN :=
    ⟨(mem_chartFunctor_obj_iff (fun j ↦ schubertChartBasis b hp hnk (.inr j)) B _).mp <|
      (chartFunctor R _).map f ((mem_chartFunctor_obj_iff _ A N).mpr hN.1),
      fun i ↦ (rankLocus_map f.hom N _ _).trans (by rw [hN.2 i, Ideal.map_bot])⟩

@[simp]
theorem mem_schubertCellFunctor_obj_iff (A : CommAlgCat.{w} R) (N : G(k, A ⊗[R] M; A)) :
    N ∈ (schubertCellFunctor b hp hnk).obj A ↔
      N ∈ chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) ∧
        ∀ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥ :=
  (Iff.rfl)

/-- `R`-algebra homomorphisms from `MvPolynomial (Finset.univ.image p).echelonFreeEntries R` to `A`
are in natural bijection with the points of the Schubert cell over `A`. -/
noncomputable def schubertCellHomEquiv (A : Type w) [CommRing A] [Algebra R A] :
    (MvPolynomial (univ.image p).echelonFreeEntries R →ₐ[R] A) ≃
      {N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) //
        ∀ i : Fin r, N.val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥} :=
  (MvPolynomial.aevalEquiv _ R A).symm.trans (schubertCellEquiv b hp hnk A).symm

/-- Evaluating the algebra homomorphism classifying a Schubert cell point `N` on the generator
`MvPolynomial.X e` recovers its `e`-th free coordinate `schubertCellEquiv b hp hnk A N e`. -/
@[simp]
theorem schubertCellHomEquiv_symm_apply_X
    (N : {N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) //
      ∀ i : Fin r, N.val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥})
    (e : (univ.image p).echelonFreeEntries) :
    (schubertCellHomEquiv b hp hnk A).symm N (MvPolynomial.X e) =
      schubertCellEquiv b hp hnk A N e := by
  simp [schubertCellHomEquiv]

/-- The `e`-th free coordinate of the Schubert cell point classified by `g` is
`g (MvPolynomial.X e)`. -/
@[simp]
theorem schubertCellEquiv_schubertCellHomEquiv_apply
    (g : MvPolynomial (univ.image p).echelonFreeEntries R →ₐ[R] A)
    (e : (univ.image p).echelonFreeEntries) :
    schubertCellEquiv b hp hnk A (schubertCellHomEquiv b hp hnk A g) e =
      g (MvPolynomial.X e) := by
  rw [← schubertCellHomEquiv_symm_apply_X, Equiv.symm_apply_apply]

/-- `schubertCellHomEquiv` is natural in `A`. -/
theorem schubertCellHomEquiv_comp (f : A →ₐ[R] B)
    (g : MvPolynomial (univ.image p).echelonFreeEntries R →ₐ[R] A) :
    (schubertCellHomEquiv b hp hnk B (f.comp g)).val.val =
      map f (schubertCellHomEquiv b hp hnk A g).val.val :=
  (congrArg (fun a ↦ ((schubertCellEquiv b hp hnk B).symm a).val.val)
    (funext fun _ ↦ by simp : (MvPolynomial.aevalEquiv _ R B).symm (f.comp g) =
      f ∘ (MvPolynomial.aevalEquiv _ R A).symm g)).trans
    (map_schubertCellEquiv_symm b hp hnk f _).symm

/-- **The Schubert cell subfunctor is corepresented by a polynomial ring** over `R` in
`#(Finset.univ.image p).echelonFreeEntries = ∑ i, (p i - i)` variables. -/
noncomputable def schubertCellCorepresentableBy :
    (schubertCellFunctor.{u, v, u} b hp hnk).toFunctor.CorepresentableBy
      (CommAlgCat.of R (MvPolynomial (univ.image p).echelonFreeEntries R)) where
  homEquiv {A} := ConcreteCategory.homEquiv.trans <|
    (schubertCellHomEquiv b hp hnk A.carrier).trans
      { toFun N := ⟨N.val.val,
          (mem_schubertCellFunctor_obj_iff b hp hnk A N.val.val).mpr ⟨N.val.property, N.property⟩⟩
        invFun N :=
          let h := (mem_schubertCellFunctor_obj_iff b hp hnk A N.val).mp N.property
          ⟨⟨N.val, h.1⟩, h.2⟩
        left_inv _ := rfl
        right_inv _ := rfl }
  homEquiv_comp f g := Subtype.ext <| by exact schubertCellHomEquiv_comp b hp hnk f.hom g.hom

/-- The `R`-algebra homomorphism from the coordinate ring of the adapted chart to the polynomial
ring of the Schubert cell classifying the universal echelon point. -/
noncomputable def schubertChartAlgHom :
    ChartAlgebra R (fun j ↦ schubertChartBasis b hp hnk (.inr j)) →ₐ[R]
      MvPolynomial (univ.image p).echelonFreeEntries R :=
  (chartHomEquiv R _ _).symm
    (schubertCellHomEquiv b hp hnk _
      (AlgHom.id R (MvPolynomial (univ.image p).echelonFreeEntries R))).val

@[simp]
theorem chartHomEquiv_schubertChartAlgHom :
    chartHomEquiv R _ _ (schubertChartAlgHom b hp hnk) =
      (schubertCellHomEquiv b hp hnk _
        (AlgHom.id R (MvPolynomial (univ.image p).echelonFreeEntries R))).val :=
  Equiv.apply_symm_apply _ _

/-- On the generator `universalLinearMap R _ (b (p i)) j`, `schubertChartAlgHom` evaluates to the
`(i, j)`-entry of the universal echelon matrix `schubertEchelonMatrix hp hnk MvPolynomial.X`. -/
theorem schubertChartAlgHom_universalLinearMap (i : Fin r) (j : Fin k) :
    schubertChartAlgHom b hp hnk (ChartAlgebra.universalLinearMap R _ (b (p i)) j) =
      schubertEchelonMatrix hp hnk MvPolynomial.X i j := by
  have h1 := congrFun (chartBasisEquiv_apply (schubertChartBasis b hp hnk)
    (chartHomEquiv R _ _ (schubertChartAlgHom b hp hnk)) i) j
  rw [schubertChartBasis_inl, chartEquiv_chartHomEquiv_apply_tmul] at h1
  have haeval : (MvPolynomial.aevalEquiv (univ.image p).echelonFreeEntries R _).symm
      (AlgHom.id R _) = MvPolynomial.X := funext fun _ ↦ by simp
  rw [← h1, chartHomEquiv_schubertChartAlgHom, schubertCellHomEquiv, Equiv.trans_apply,
    haeval, chartBasisEquiv_schubertCellEquiv_symm]

/-- Composing an `R`-algebra map `g` out of the Schubert cell coordinate ring with
`schubertChartAlgHom` classifies the adapted-chart point `(schubertCellHomEquiv b hp hnk A g).1`. -/
@[simp]
theorem chartHomEquiv_comp_schubertChartAlgHom
    (g : MvPolynomial (univ.image p).echelonFreeEntries R →ₐ[R] A) :
    chartHomEquiv R _ A (g.comp (schubertChartAlgHom b hp hnk)) =
      (schubertCellHomEquiv b hp hnk A g).val := by
  refine (chartBasisEquiv (schubertChartBasis b hp hnk) A).injective (Matrix.ext fun i j ↦ ?_)
  rw [schubertCellHomEquiv, Equiv.trans_apply, chartBasisEquiv_schubertCellEquiv_symm]
  have h1 := congrFun (chartBasisEquiv_apply (schubertChartBasis b hp hnk)
    (chartHomEquiv R _ A (g.comp (schubertChartAlgHom b hp hnk))) i) j
  rw [schubertChartBasis_inl, chartEquiv_chartHomEquiv_apply_tmul, AlgHom.comp_apply,
    schubertChartAlgHom_universalLinearMap] at h1
  rw [h1, ← Matrix.map_apply (f := g), schubertEchelonMatrix_map]
  exact congrArg (fun a ↦ schubertEchelonMatrix hp hnk a i j) (funext fun _ ↦ by simp)

/-- **`schubertChartAlgHom` is surjective**: the Schubert cell is a closed subscheme of the adapted
standard chart. -/
theorem schubertChartAlgHom_surjective :
    Function.Surjective (schubertChartAlgHom b hp hnk) := by
  let sec : MvPolynomial (univ.image p).echelonFreeEntries R →ₐ[R]
      ChartAlgebra R (fun j ↦ schubertChartBasis b hp hnk (.inr j)) :=
    MvPolynomial.aeval fun e ↦ -ChartAlgebra.universalLinearMap R _
      (b (p ((schubertFreeEntriesEquiv hp hnk).symm e).val.1))
      ((schubertFreeEntriesEquiv hp hnk).symm e).val.2
  have hsec : (schubertChartAlgHom b hp hnk).comp sec = AlgHom.id R _ := by
    refine MvPolynomial.algHom_ext fun e ↦ ?_
    obtain ⟨⟨⟨i, j⟩, hij⟩, rfl⟩ := (schubertFreeEntriesEquiv hp hnk).surjective e
    simp [sec, schubertChartAlgHom_universalLinearMap, hij]; rfl
  exact fun f ↦ ⟨sec f, congrArg (fun g : _ →ₐ[R] _ ↦ g f) hsec⟩

/-- **The kernel of `schubertChartAlgHom` is the universal Schubert rank ideal** on the adapted
chart. -/
theorem ker_schubertChartAlgHom :
    RingHom.ker (schubertChartAlgHom b hp hnk) =
      ⨆ i : Fin r,
        (chartHomEquiv R (fun j ↦ schubertChartBasis b hp hnk (.inr j)) _
          (AlgHom.id R _)).val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) := by
  let x := fun j ↦ schubertChartBasis b hp hnk (.inr j)
  set N₀ := chartHomEquiv R x (ChartAlgebra R x) (AlgHom.id R _)
  set I := ⨆ i : Fin r, N₀.val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)
  refine le_antisymm (fun c hc ↦ ?_) ?_
  · -- The quotient point over `ChartAlgebra R x ⧸ I` kills `I`, hence factors through the cell.
    let mk : ChartAlgebra R x →ₐ[R] ChartAlgebra R x ⧸ I := Ideal.Quotient.mkₐ R I
    have hN : ∀ i : Fin r,
        (chartHomEquiv R x _ mk).val.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥ := by
      have hmap : (chartHomEquiv R x _ mk).val = map mk N₀.val := by
        dsimp only [N₀]; rw [← chartHomEquiv_comp x mk (AlgHom.id R _), AlgHom.comp_id]
      rw [← iSup_eq_bot, hmap]
      simp_rw [rankLocus_map, ← Ideal.map_iSup]
      exact (Ideal.map_eq_bot_iff_le_ker _).mpr (Ideal.Quotient.mkₐ_ker R I).ge
    let g := (schubertCellHomEquiv b hp hnk _).symm ⟨chartHomEquiv R x _ mk, hN⟩
    have hcomp : g.comp (schubertChartAlgHom b hp hnk) = mk :=
      (chartHomEquiv R x _).injective <| by
        rw [chartHomEquiv_comp_schubertChartAlgHom]
        exact congrArg Subtype.val ((schubertCellHomEquiv b hp hnk _).apply_symm_apply _)
    have hzero : mk c = 0 := by rw [← hcomp, AlgHom.comp_apply, RingHom.mem_ker.mp hc, map_zero]
    rwa [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at hzero
  · dsimp only [I]
    rw [iSup_rankLocus_schubertChartBasis b hp hnk N₀, Ideal.span_le]
    rintro _ ⟨i, j, hij, rfl⟩
    have hN₀ : chartBasisEquiv (schubertChartBasis b hp hnk) _ N₀ i j =
        ChartAlgebra.universalLinearMap R x (b (p i)) j := by
      rw [congrFun (chartBasisEquiv_apply (schubertChartBasis b hp hnk) N₀ i) j,
        schubertChartBasis_inl]
      exact chartEquiv_chartHomEquiv_apply_tmul x (AlgHom.id R _) (b (p i)) j
    rw [SetLike.mem_coe, RingHom.mem_ker, hN₀, schubertChartAlgHom_universalLinearMap]
    exact schubertEchelonMatrix_eq_zero_of_lt hp hnk MvPolynomial.X hij

end Cell

end Module.Grassmannian
