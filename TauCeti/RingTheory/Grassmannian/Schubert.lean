/-!
# Schubert cells and determinantal Schubert ideals on the Grassmannian

Let `M` be a free module over a commutative ring `R` with a basis `b` indexed by `Fin n`, and let
`F_j = b.flag j` be the complete flag spanned by its first `j` basis vectors. For strictly
increasing zero-based pivot positions `p : Fin r → Fin n`, the determinantal Schubert conditions on
a point `N ∈ G(k, A ⊗[R] M; A)` require each `F_{p i + 1}` to map to `(A ⊗[R] M) ⧸ N` with rank at
most `p i - i`.

This file develops the ring-theoretic and functorial side of these Schubert conditions and of the
associated Schubert cells:

* **Extreme dimensions:** `G(0, M; R)` is a point for every module `M` (`uniqueZero`), while for a
  free module of rank `n`, `G(k, A ⊗[R] M; A)` is empty over a nontrivial `A` when `n < k`
  (`isEmpty_of_lt`) and is a point when `k = n` (`uniqueOfBasis`).
* **Full-flag presentation and Bruhat monotonicity:** the ideal generated by the `r` jump conditions
  `N.rankLocus (b.flag (p i).succ) (p i - i)` agrees with the ideal generated by the rank
  conditions at all `n + 1` steps of the flag (`iSup_rankLocus_flag_succ_eq`), and shrinks as `p`
  grows coordinatewise (`iSup_rankLocus_flag_succ_antitone`).
* **Adapted standard chart and Schubert cell:** when `r + k = n`, let `q : Fin k ↪o Fin n`
  enumerate the complement of `S = Finset.univ.image p` (`schubertComplEmb`). Reindexing `b` by
  `p` and `q` (`schubertChartBasis`), the Schubert rank ideal of a point in the chart at `b ∘ q`
  with matrix `Φ : Matrix (Fin r) (Fin k) A` is generated by the entries `Φ i j` with `p i < q j`
  (`iSup_rankLocus_schubertChartBasis`). Setting those entries to zero leaves the free echelon
  entries `S.echelonFreeEntries`, giving a natural bijection `schubertCellEquiv` with the affine
  space `S.echelonFreeEntries → A` of dimension `∑ i, (p i - i)` and an `R`-algebra surjection
  `schubertChartAlgHom : ChartAlgebra R (b ∘ q) →ₐ[R] MvPolynomial S.echelonFreeEntries R` whose
  kernel is the universal Schubert rank ideal on the chart (`ker_schubertChartAlgHom`).
* **Field points and polynomial deformations:** over a field `K`, a point lies in the Schubert cell
  at `p` exactly when `(b.baseChange K).flagPivots N.toSubmodule = Finset.univ.image p`
  (`mem_chart_and_rankLocus_eq_bot_iff_flagPivots`), and satisfies the Schubert rank conditions for
  `p` exactly when its pivot tuple `p'` satisfies `p' ≤ p` coordinatewise
  (`forall_rankLocus_eq_bot_iff_exists_flagPivots`). Whenever `p' < p`, an elementary basis shear
  over `K[X]` produces an `𝔸¹`-family specializing at `0` to `N` whose generic point over
  `FractionRing K[X]` has a strictly larger pivot tuple `p'' ≤ p`
  (`exists_polynomial_deformation_of_flagPivots_lt`).

## Main definitions

* `Module.Grassmannian.schubertComplEmb hp hnk`: the order embedding `Fin k ↪o Fin n` enumerating
  the non-pivot indices.
* `Module.Grassmannian.schubertChartBasis b hp hnk`: `b` reindexed by `Fin r ⊕ Fin k` via the
  pivots `p` and non-pivots `schubertComplEmb hp hnk`.
* `Module.Grassmannian.schubertCellEquiv b hp hnk A`: points of the adapted chart satisfying the
  Schubert rank conditions are in bijection with `(Finset.univ.image p).echelonFreeEntries → A`.
* `Module.Grassmannian.schubertCellFunctor b hp hnk`: the Schubert cell as a subfunctor of the
  Grassmannian functor, corepresented by `MvPolynomial (Finset.univ.image p).echelonFreeEntries R`
  (`Module.Grassmannian.schubertCellCorepresentableBy`).
* `Module.Grassmannian.schubertChartAlgHom b hp hnk`: the surjective `R`-algebra homomorphism from
  the adapted `ChartAlgebra` onto the polynomial ring of the Schubert cell.

## Main results

* `Module.Grassmannian.iSup_rankLocus_flag_succ_eq`: equivalence of jump and full-flag rank ideals.
* `Module.Grassmannian.iSup_rankLocus_flag_succ_antitone`: coordinatewise monotonicity in `p`.
* `Module.Grassmannian.iSup_rankLocus_schubertChartBasis`: in the adapted chart, the Schubert rank
  ideal is generated by the matrix entries `Φ i j` with `p i < q j`.
* `Module.Grassmannian.ker_schubertChartAlgHom`: the kernel of `schubertChartAlgHom` is the
  universal Schubert rank ideal on the adapted chart.
* `Module.Grassmannian.mem_chart_and_rankLocus_eq_bot_iff_flagPivots` and
  `Module.Grassmannian.forall_rankLocus_eq_bot_iff_exists_flagPivots`: characterization of cell
  and Schubert-locus field points by `Module.Basis.flagPivots`.
* `Module.Grassmannian.exists_polynomial_deformation_of_flagPivots_lt`: one-step `𝔸¹`-deformation
  raising a non-maximal pivot tuple toward `p`.

## References

* W. Fulton, *Young tableaux*, London Mathematical Society Student Texts 35, Cambridge University
  Press (1997), §9.4.
* W. V. D. Hodge, D. Pedoe, *Methods of Algebraic Geometry*, Vol. II, Cambridge University Press
  (1952), Book IV, Chapter XIV, for Schubert varieties and their cells.
* [The Stacks Project, Tag 089R](https://stacks.math.columbia.edu/tag/089R), for the Grassmannian
  functor.
-/

public section

universe u v w

open CategoryTheory TensorProduct Module Finset

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
  {A B : Type w} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]

/-! ### Extreme dimensions -/

section Extreme

/-- Every point of `G(0, M; R)` is the full submodule `⊤`. -/
@[simp]
theorem toSubmodule_eq_top_zero (N : G(0, M; R)) : N.toSubmodule = ⊤ := by
  have hsub : Subsingleton (M ⧸ N.toSubmodule) :=
    (Module.rankAtStalk_eq_zero_iff_subsingleton (R := R) (M := M ⧸ N.toSubmodule)).mp
      (funext N.rankAtStalk_eq)
  ext x
  simp only [Submodule.mem_top, iff_true]
  exact (Submodule.Quotient.mk_eq_zero _).mp (Subsingleton.elim _ 0)

/-- `G(0, M; R)` has a unique point, namely the full submodule `⊤`, whose quotient is zero. -/
@[instance_reducible]
noncomputable instance uniqueZero : Unique G(0, M; R) where
  default := ofSurjective (0 : M →ₗ[R] Fin 0 → R)
    (fun x ↦ ⟨0, Subsingleton.elim _ x⟩) (rankAtStalk_fin_fun 0)
  uniq N := Grassmannian.ext ((toSubmodule_eq_top_zero N).trans (toSubmodule_eq_top_zero _).symm)

/-- Over a nontrivial `R`-algebra `A`, `G(k, A ⊗[R] M; A)` is empty when `M` has a basis of size
`n < k`. -/
theorem isEmpty_of_lt {n k : ℕ} [Nontrivial A] (b : Basis (Fin n) R M) (h : n < k) :
    IsEmpty G(k, A ⊗[R] M; A) := by
  refine ⟨fun N ↦ ?_⟩
  obtain ⟨m, hm⟩ := Ideal.exists_maximal A
  let _ := Ideal.Quotient.field m
  let N' := map (Ideal.Quotient.mkₐ R m) N
  have := Module.Finite.of_basis (b.baseChange (A ⧸ m))
  have hquot : finrank (A ⧸ m) (((A ⧸ m) ⊗[R] M) ⧸ N'.toSubmodule) = k :=
    TauCeti.Module.finrank_eq_of_rankAtStalk_eq (funext N'.rankAtStalk_eq)
  have hle := N'.toSubmodule.finrank_quotient_le
  rw [hquot, finrank_eq_card_basis (b.baseChange (A ⧸ m)), Fintype.card_fin] at hle
  omega

/-- When `M` has a basis indexed by `Fin n`, the only point of `G(n, A ⊗[R] M; A)` is the zero
submodule `⊥`. -/
theorem toSubmodule_eq_bot_of_basis {n : ℕ} (b : Basis (Fin n) R M) (N : G(n, A ⊗[R] M; A)) :
    N.toSubmodule = ⊥ := by
  let ψ₀ : {ψ : M →ₗ[R] Fin n → A // ∀ j, ψ (b j) = Pi.single j 1} :=
    ⟨b.constr ℕ fun j ↦ (Pi.single j 1 : Fin n → A), fun j ↦ b.constr_basis ℕ _ j⟩
  have hmem : N ∈ chart A (fun j ↦ (1 : A) ⊗ₜ[R] b j) := by
    rw [mem_chart_iff_sup_eq_top]
    have hspan : Submodule.span A (Set.range fun j ↦ (1 : A) ⊗ₜ[R] b j) = ⊤ := by
      rw [show (fun j ↦ (1 : A) ⊗ₜ[R] b j) = ⇑(b.baseChange A) from
        funext fun j ↦ (b.baseChange_apply A j).symm]
      exact (b.baseChange A).span_eq
    rw [hspan, sup_top_eq]
  have hψ : chartBaseChangeEquiv R A b ⟨N, hmem⟩ = ψ₀ :=
    Subtype.ext <| b.ext fun j ↦ ((chartBaseChangeEquiv R A b ⟨N, hmem⟩).2 j).trans (ψ₀.2 j).symm
  have hN : N = ((chartBaseChangeEquiv R A b).symm ψ₀).1 :=
    congrArg Subtype.val ((Equiv.eq_symm_apply _).mpr hψ)
  rw [hN, toSubmodule_chartBaseChangeEquiv_symm_apply]
  have heq : ψ₀.1.liftBaseChange A = (b.baseChange A).equivFun.toLinearMap :=
    (b.baseChange A).ext fun j ↦ by
      ext j'
      simp [ψ₀, Finsupp.single_apply, Pi.single_apply, eq_comm]
  rw [heq]
  exact LinearEquiv.ker _

/-- When `M` has a basis `b` indexed by `Fin n`, every point of `G(n, A ⊗[R] M; A)` lies in the
standard chart at `1 ⊗ₜ b` and corresponds to the unique map sending `b j` to `eⱼ`, so
`G(n, A ⊗[R] M; A)` has a unique point (namely `⊥`). -/
@[instance_reducible]
noncomputable def uniqueOfBasis {n : ℕ} (b : Basis (Fin n) R M) (A : Type w) [CommRing A]
    [Algebra R A] : Unique G(n, A ⊗[R] M; A) where
  default := ((chartBaseChangeEquiv R A b).symm
    ⟨b.constr ℕ fun j ↦ (Pi.single j 1 : Fin n → A), fun j ↦ b.constr_basis ℕ _ j⟩).1
  uniq N := Grassmannian.ext
    ((toSubmodule_eq_bot_of_basis b N).trans (toSubmodule_eq_bot_of_basis b _).symm)

end Extreme

/-! ### Full-flag presentation and Bruhat monotonicity of Schubert rank ideals -/

section FullFlag

variable {n r k : ℕ}

/-- For strictly increasing `p : Fin r → Fin n`, the pivots `p l` with `(p l).castSucc < (p i).succ`
are those with `l ≤ i`, of cardinality `i + 1`. -/
private theorem card_filter_castSucc_lt_succ_apply {p : Fin r → Fin n} (hp : StrictMono p)
    (i : Fin r) :
    #{l : Fin r | (p l).castSucc < (p i).succ} = (i : ℕ) + 1 := by
  have hset : ({l | (p l).castSucc < (p i).succ} : Finset (Fin r)) = Iic i := by
    ext l
    simp [Fin.castSucc_lt_succ_iff, hp.le_iff_le]
  rw [hset, Fin.card_Iic]

/-- For strictly increasing `p : Fin r → Fin n`, at most `j` indices satisfy
`(p l).castSucc < j`. -/
private theorem card_filter_castSucc_lt_le {p : Fin r → Fin n} (hp : StrictMono p)
    (j : Fin (n + 1)) :
    #{l : Fin r | (p l).castSucc < j} ≤ (j : ℕ) := by
  calc #{l : Fin r | (p l).castSucc < j}
      = #(Finset.image (Fin.castSucc ∘ p) {l | (p l).castSucc < j}) :=
        (card_image_of_injective _ ((Fin.castSucc_injective n).comp hp.injective)).symm
    _ ≤ #(Iio j) := card_le_card <| image_subset_iff.mpr fun l hl ↦
        mem_Iio.mpr (mem_filter.mp hl).2
    _ = (j : ℕ) := Fin.card_Iio j

/-- **Full-flag presentation of the Schubert rank ideal.** For strictly increasing pivot positions
`p : Fin r → Fin n`, the ideal generated by the `r` jump conditions
`N.rankLocus (b.flag (p i).succ) (p i - i)` agrees with the ideal generated by the rank conditions
at all `n + 1` subspaces of the complete flag `b.flag`. -/
theorem iSup_rankLocus_flag_succ_eq (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (N : G(k, A ⊗[R] M; A)) :
    (⨆ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) =
      ⨆ j : Fin (n + 1), N.rankLocus (b.flag j) ((j : ℕ) - #{i : Fin r | (p i).castSucc < j}) := by
  refine le_antisymm (iSup_le fun i ↦ ?_) (iSup_le fun j ↦ ?_)
  · have hsub : (p i : ℕ) - i =
        ((p i).succ : ℕ) - #{l : Fin r | (p l).castSucc < (p i).succ} := by
      rw [card_filter_castSucc_lt_succ_apply hp, Fin.val_succ]
      omega
    rw [hsub]
    exact le_iSup (fun j : Fin (n + 1) ↦
      N.rankLocus (b.flag j) ((j : ℕ) - #{l : Fin r | (p l).castSucc < j})) (p i).succ
  · induction j using Fin.induction with
    | zero =>
      rw [b.flag_zero, rankLocus_bot]
      exact bot_le
    | succ t ih =>
      by_cases ht : ∃ i : Fin r, p i = t
      · obtain ⟨i, rfl⟩ := ht
        have hsub : ((p i).succ : ℕ) - #{l : Fin r | (p l).castSucc < (p i).succ} =
            (p i : ℕ) - i := by
          rw [card_filter_castSucc_lt_succ_apply hp, Fin.val_succ]
          omega
        rw [hsub]
        exact le_iSup (fun i : Fin r ↦ N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) i
      · push Not at ht
        have hcard : #{l : Fin r | (p l).castSucc < t.succ} =
            #{l : Fin r | (p l).castSucc < t.castSucc} := by
          congr 1
          ext l
          simp only [mem_filter, mem_univ, true_and, Fin.castSucc_lt_succ_iff,
            Fin.castSucc_lt_castSucc_iff]
          exact ⟨fun h ↦ lt_of_le_of_ne h (ht l), le_of_lt⟩
        have hle := card_filter_castSucc_lt_le hp t.castSucc
        have hsub : (t.succ : ℕ) - #{l : Fin r | (p l).castSucc < t.succ} =
            ((t.castSucc : ℕ) - #{l : Fin r | (p l).castSucc < t.castSucc}) + 1 := by
          rw [Fin.val_castSucc] at hle
          rw [hcard, Fin.val_succ, Fin.val_castSucc]
          omega
        rw [hsub, b.flag_succ, sup_comm]
        exact (N.rankLocus_sup_span_singleton_succ_le _ _ _).trans ih

/-- **Bruhat monotonicity of the Schubert rank ideal.** If `p, p' : Fin r → Fin n` are strictly
increasing with `p' i ≤ p i` for every `i`, then the Schubert rank ideal of `p` is contained in
that of `p'`: larger pivots cut out a larger closed locus. -/
theorem iSup_rankLocus_flag_succ_antitone (b : Basis (Fin n) R M) {p p' : Fin r → Fin n}
    (hp : StrictMono p) (hp' : StrictMono p') (hle : ∀ i, p' i ≤ p i)
    (N : G(k, A ⊗[R] M; A)) :
    (⨆ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) ≤
      ⨆ i : Fin r, N.rankLocus (b.flag (p' i).succ) ((p' i : ℕ) - i) := by
  rw [iSup_rankLocus_flag_succ_eq b hp N, iSup_rankLocus_flag_succ_eq b hp' N]
  refine iSup_mono fun j ↦ N.rankLocus_antitone (b.flag j) ?_
  have hcard : #{i : Fin r | (p i).castSucc < j} ≤ #{i : Fin r | (p' i).castSucc < j} :=
    card_le_card fun i hi ↦ by
      simp only [mem_filter, mem_univ, true_and] at hi ⊢
      exact (Fin.castSucc_le_castSucc_iff.mpr (hle i)).trans_lt hi
  omega

/-- For the largest pivot sequence `p i = k + i` (when `r + k = n`), every Schubert rank condition
has bound `k`, hence vanishes identically. -/
theorem iSup_rankLocus_flag_succ_top_eq_bot (b : Basis (Fin n) R M) (hnk : r + k = n)
    (N : G(k, A ⊗[R] M; A)) :
    (⨆ i : Fin r, N.rankLocus (b.flag (⟨k + i, by omega⟩ : Fin n).succ)
      ((⟨k + i, by omega⟩ : Fin n) - i)) = ⊥ :=
  iSup_eq_bot.mpr fun i ↦ N.rankLocus_eq_bot_of_le _ (by simp)

end FullFlag

/-! ### Adapted standard chart and determinantal ideal -/

section AdaptedChart

variable {n r k : ℕ}

/-- When `r + k = n` and `p : Fin r → Fin n` is strictly increasing, there are `k` non-pivot
indices in `Fin n`. -/
theorem card_compl_image_pivots {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n) :
    #(univ.image p)ᶜ = k := by
  rw [card_compl, Fintype.card_fin, card_image_of_injective _ hp.injective, card_univ,
    Fintype.card_fin]
  omega

/-- The order embedding `Fin k ↪o Fin n` enumerating the complement of the pivot set
`Finset.univ.image p` in increasing order. -/
noncomputable def schubertComplEmb {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n) :
    Fin k ↪o Fin n :=
  (univ.image p)ᶜ.orderEmbOfFin (card_compl_image_pivots hp hnk)

/-- Every index in `schubertComplEmb hp hnk` lies outside `Finset.univ.image p`. -/
theorem schubertComplEmb_notMem_image {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n)
    (j : Fin k) :
    schubertComplEmb hp hnk j ∉ univ.image p :=
  mem_compl.mp ((univ.image p)ᶜ.orderEmbOfFin_mem (card_compl_image_pivots hp hnk) j)

/-- A non-pivot index is never equal to a pivot index. -/
theorem schubertComplEmb_ne {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n)
    (i : Fin r) (j : Fin k) :
    schubertComplEmb hp hnk j ≠ p i :=
  fun h ↦ schubertComplEmb_notMem_image hp hnk j (h ▸ mem_image_of_mem p (mem_univ i))

/-- The image of `schubertComplEmb hp hnk` is the complement of `Finset.univ.image p`. -/
theorem image_schubertComplEmb {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n) :
    univ.image (schubertComplEmb hp hnk) = (univ.image p)ᶜ := by
  rw [schubertComplEmb, ← coe_inj, coe_image, coe_univ, Set.image_univ,
    Finset.range_orderEmbOfFin]

/-- The number of non-pivot indices strictly below `p i` is `p i - i`. -/
theorem card_filter_schubertComplEmb_lt {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n)
    (i : Fin r) :
    #{j : Fin k | schubertComplEmb hp hnk j < p i} = (p i : ℕ) - i := by
  have hpiv : {t ∈ Iio (p i) | t ∈ univ.image p} = (Iio i).image p := by
    ext t
    simp only [mem_filter, mem_Iio, mem_image, mem_univ, true_and]
    exact ⟨fun ⟨ht, l, hl⟩ ↦ ⟨l, hp.lt_iff_lt.mp (hl ▸ ht), hl⟩,
      fun ⟨l, hl, hlt⟩ ↦ ⟨hlt ▸ hp hl, l, hlt⟩⟩
  have hcompl : {t ∈ Iio (p i) | t ∉ univ.image p} =
      Finset.image (schubertComplEmb hp hnk) {j | schubertComplEmb hp hnk j < p i} := by
    ext t
    simp only [mem_filter, mem_Iio]
    constructor
    · rintro ⟨ht, hnot⟩
      have ht' : t ∈ univ.image (schubertComplEmb hp hnk) := by
        rw [image_schubertComplEmb hp hnk, mem_compl]
        exact hnot
      obtain ⟨j, -, rfl⟩ := mem_image.mp ht'
      exact mem_image.mpr ⟨j, mem_filter.mpr ⟨mem_univ j, ht⟩, rfl⟩
    · intro h
      obtain ⟨j, hj, rfl⟩ := mem_image.mp h
      exact ⟨(mem_filter.mp hj).2, schubertComplEmb_notMem_image hp hnk j⟩
  have h := card_filter_add_card_filter_not (s := Iio (p i)) (· ∈ univ.image p)
  rw [hpiv, hcompl, card_image_of_injective _ hp.injective,
    card_image_of_injective _ (schubertComplEmb hp hnk).injective, Fin.card_Iio, Fin.card_Iio] at h
  omega

/-- The equivalence `Fin n ≃ Fin r ⊕ Fin k` splitting `Fin n` into the pivots `p` and the
complementary non-pivots `schubertComplEmb hp hnk`. -/
private noncomputable def schubertIndexEquiv {p : Fin r → Fin n} (hp : StrictMono p)
    (hnk : r + k = n) : Fin n ≃ Fin r ⊕ Fin k :=
  (Equiv.ofBijective (Sum.elim p (schubertComplEmb hp hnk)) <|
    (Fintype.bijective_iff_injective_and_card _).mpr
      ⟨Sum.elim_injective.mpr ⟨hp.injective, (schubertComplEmb hp hnk).injective,
        fun i j h ↦ (schubertComplEmb_ne hp hnk i j h.symm).elim⟩,
      by simp [hnk]⟩).symm

/-- The basis `b` reindexed by `Fin r ⊕ Fin k` so that the `Fin r` summand enumerates the pivot
vectors `b (p i)` and the `Fin k` summand enumerates the non-pivot vectors
`b (schubertComplEmb hp hnk j)`. The standard chart of `G(k, M)` adapted to `p` is the chart at
these last `k` basis vectors. -/
noncomputable def schubertChartBasis (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) : Basis (Fin r ⊕ Fin k) R M :=
  b.reindex (schubertIndexEquiv hp hnk)

@[simp]
theorem schubertChartBasis_inl (b : Basis (Fin n) R M) {p : Fin r → Fin n} (hp : StrictMono p)
    (hnk : r + k = n) (i : Fin r) :
    schubertChartBasis b hp hnk (.inl i) = b (p i) := by
  rw [schubertChartBasis, Basis.reindex_apply, schubertIndexEquiv, Equiv.symm_symm,
    Equiv.ofBijective_apply, Sum.elim_inl]

@[simp]
theorem schubertChartBasis_inr (b : Basis (Fin n) R M) {p : Fin r → Fin n} (hp : StrictMono p)
    (hnk : r + k = n) (j : Fin k) :
    schubertChartBasis b hp hnk (.inr j) = b (schubertComplEmb hp hnk j) := by
  rw [schubertChartBasis, Basis.reindex_apply, schubertIndexEquiv, Equiv.symm_symm,
    Equiv.ofBijective_apply, Sum.elim_inr]

/-- Each entry `Φ i j` with `p i < q j` of the chart matrix `Φ` of a point `N` in the adapted chart
arises as a lower-triangular `((p i - i) + 1)`-minor of `F_{p i + 1} → (A ⊗[R] M) ⧸ N`, hence lies
in `N.rankLocus (b.flag (p i).succ) (p i - i)`. -/
private theorem chartBasisEquiv_apply_mem_rankLocus (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n)
    (N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)))
    {i : Fin r} {j : Fin k} (hij : p i < schubertComplEmb hp hnk j) :
    chartBasisEquiv (schubertChartBasis b hp hnk) A N i j ∈
      N.1.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) := by
  set q := schubertComplEmb hp hnk
  set s := (p i : ℕ) - i
  let T : Finset (Fin k) := {j' : Fin k | q j' < p i}
  let e : Fin s ≃ T := (T.orderIsoOfFin (card_filter_schubertComplEmb_lt hp hnk i)).toEquiv
  let m : Fin (s + 1) → M := Fin.snoc (fun u : Fin s ↦ b (q (e u).1)) (b (p i))
  have hm (u : Fin (s + 1)) : m u ∈ b.flag (p i).succ :=
    u.lastCases (by simpa [m] using b.self_mem_flag Fin.castSucc_lt_succ) fun u₀ ↦ by
      simpa [m] using b.self_mem_flag
        (Fin.castSucc_lt_succ_iff.mpr (mem_filter.mp (e u₀).2).2.le)
  let idx : Fin (s + 1) → Fin k := Fin.snoc (fun v : Fin s ↦ (e v).1) j
  let φ : Fin (s + 1) → Dual A ((A ⊗[R] M) ⧸ N.1.toSubmodule) :=
    fun v ↦ LinearMap.proj (idx v) ∘ₗ (chartQuotEquiv N).symm.toLinearMap
  have hφ (y : A ⊗[R] M) (v : Fin (s + 1)) :
      φ v (N.1.toSubmodule.mkQ y) = (chartEquiv A _ N).1 y (idx v) :=
    congrFun ((LinearEquiv.symm_apply_eq _).mpr (chartQuotEquiv_chartEquiv_apply _ N y).symm)
      (idx v)
  have hψq (j' : Fin k) : (chartEquiv A _ N).1 (1 ⊗ₜ b (q j')) = Pi.single j' 1 := by
    rw [← schubertChartBasis_inr b hp hnk j']
    exact chartEquiv_apply_apply_self _ N j'
  let B : Matrix (Fin (s + 1)) (Fin (s + 1)) A :=
    Matrix.of fun u v ↦ φ v (N.1.toSubmodule.mkQ (1 ⊗ₜ m u))
  have hB_tri : B.IsLowerTriangular := fun u v (huv : u < v) ↦ by
    obtain ⟨u₀, rfl⟩ := Fin.exists_castSucc_eq.mpr (huv.trans_le (Fin.le_last v)).ne
    dsimp only [B]
    rw [Matrix.of_apply, hφ, show m u₀.castSucc = b (q (e u₀).1) by simp [m], hψq]
    revert huv
    refine v.lastCases (fun _ ↦ Pi.single_eq_of_ne (fun h ↦ ?_) 1) fun v₀ hv ↦
      Pi.single_eq_of_ne (fun h ↦ ?_) 1
    · exact ((mem_filter.mp (e u₀).2).2.trans hij).ne' (congrArg q (by simpa [idx] using h))
    · exact (Fin.castSucc_lt_castSucc_iff.mp hv).ne
        (e.injective (Subtype.ext (by simpa [idx] using h.symm)))
  have hB_det : B.det = chartBasisEquiv (schubertChartBasis b hp hnk) A N i j := by
    rw [Matrix.det_of_isLowerTriangular B hB_tri, Fin.prod_univ_castSucc]
    have hdiag (u₀ : Fin s) : B u₀.castSucc u₀.castSucc = 1 := by
      dsimp only [B]; rw [Matrix.of_apply, hφ]; simp [m, idx, hψq]
    have hlast : B (Fin.last s) (Fin.last s) =
        chartBasisEquiv (schubertChartBasis b hp hnk) A N i j := by
      dsimp only [B]; rw [Matrix.of_apply, hφ]; simp [m, idx, chartBasisEquiv_apply,
        schubertChartBasis_inl]
    simp [hdiag, hlast]
  exact hB_det ▸ N.1.det_mem_rankLocus φ hm

/-- Under the vanishing hypothesis `hΦ`, the image of `b t` (`t ≤ p i`) in the adapted chart
coordinates vanishes at every index `j` with `p i < q j`. -/
private theorem chartEquiv_schubertChartBasis_eq_zero (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (Φ : Matrix (Fin r) (Fin k) A)
    (hΦ : ∀ (i' : Fin r) (j : Fin k), p i' < schubertComplEmb hp hnk j → Φ i' j = 0)
    {i : Fin r} {t : Fin n} (htp : t ≤ p i) {j : Fin k}
    (hpj : p i < schubertComplEmb hp hnk j) :
    (chartEquiv A _ ((chartBasisEquiv (schubertChartBasis b hp hnk) A).symm Φ)).1
      (1 ⊗ₜ b t) j = 0 := by
  set N := (chartBasisEquiv (schubertChartBasis b hp hnk) A).symm Φ
  obtain ⟨i' | j', heq⟩ := (schubertIndexEquiv hp hnk).symm.surjective t
  · have ht_eq : p i' = t := by simpa [schubertIndexEquiv] using heq
    subst ht_eq
    have hval : (chartEquiv A _ N).1 (1 ⊗ₜ b (p i')) = Φ i' := by
      rw [← Equiv.apply_symm_apply (chartBasisEquiv (schubertChartBasis b hp hnk) A) Φ,
        chartBasisEquiv_apply, schubertChartBasis_inl]
    rw [hval, hΦ i' j (htp.trans_lt hpj)]
  · have ht_eq : schubertComplEmb hp hnk j' = t := by simpa [schubertIndexEquiv] using heq
    subst ht_eq
    have hval : (chartEquiv A _ N).1 (1 ⊗ₜ b (schubertComplEmb hp hnk j')) = Pi.single j' 1 := by
      simpa [schubertChartBasis_inr] using chartEquiv_apply_apply_self _ N j'
    have hne : j ≠ j' := fun hjj' ↦ (htp.trans_lt hpj).ne (congrArg _ hjj'.symm)
    rw [hval, Pi.single_eq_of_ne hne]

/-- If every entry `Φ i' j` with `p i' < q j` of a chart matrix `Φ` vanishes, then the `i`-th
Schubert rank locus of the corresponding chart point vanishes. -/
private theorem rankLocus_schubertChartBasis_eq_bot_of_eq_zero (b : Basis (Fin n) R M)
    {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n) (Φ : Matrix (Fin r) (Fin k) A)
    (hΦ : ∀ (i' : Fin r) (j : Fin k), p i' < schubertComplEmb hp hnk j → Φ i' j = 0)
    (i : Fin r) :
    ((chartBasisEquiv (schubertChartBasis b hp hnk) A).symm Φ).1.rankLocus
      (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥ := by
  set q := schubertComplEmb hp hnk
  set N := (chartBasisEquiv (schubertChartBasis b hp hnk) A).symm Φ
  let T : Finset (Fin k) := {j : Fin k | q j < p i}
  have hcomp : (chartQuotEquiv N).symm.toLinearMap ∘ₗ N.1.toSubmodule.mkQ =
      (chartEquiv A _ N).1 :=
    LinearMap.ext fun x ↦ (LinearEquiv.symm_apply_eq _).mpr
      (chartQuotEquiv_chartEquiv_apply _ N x).symm
  rw [rankLocus_def, ← Submodule.minorsIdeal_map_equiv (chartQuotEquiv N).symm]
  refine Submodule.minorsIdeal_eq_bot_of_le_span_range (v := fun u : T ↦ Pi.single u.1 (1 : A))
    ?_ ?_
  · rw [← Submodule.map_comp, hcomp, Basis.flag, Submodule.baseChange_span, Submodule.map_span,
      Set.image_image, Set.image_image, Submodule.span_le]
    rintro _ ⟨t, ht, rfl⟩
    dsimp only
    rw [TensorProduct.mk_apply]
    set v := (chartEquiv A _ N).1 (1 ⊗ₜ b t)
    rw [← Finset.univ_sum_single v]
    refine sum_mem fun j _ ↦ ?_
    by_cases hj : j ∈ T
    · have hvj : Pi.single j (v j) = v j • Pi.single j (1 : A) :=
        funext fun _ ↦ by simp [Pi.single_apply]
      exact hvj ▸ Submodule.smul_mem _ (v j) (Submodule.subset_span ⟨⟨j, hj⟩, rfl⟩)
    · have hpj : p i < q j := lt_of_le_of_ne (not_lt.mp (by simpa [T] using hj))
        (schubertComplEmb_ne hp hnk i j).symm
      dsimp only [v, N]
      rw [chartEquiv_schubertChartBasis_eq_zero b hp hnk Φ hΦ (Fin.castSucc_lt_succ_iff.mp ht) hpj,
        Pi.single_zero]
      exact zero_mem _
  · rw [Nat.card_eq_fintype_card, Fintype.card_coe, card_filter_schubertComplEmb_lt hp hnk i]
    omega

/-- **The Schubert rank ideal in the adapted chart.** For a point `N` of the standard chart at the
non-pivot basis vectors `b (schubertComplEmb hp hnk j)` with matrix
`Φ = chartBasisEquiv (schubertChartBasis b hp hnk) A N`, the Schubert rank ideal of `p` at `N` is
generated by the entries `Φ i j` with `p i < schubertComplEmb hp hnk j`. -/
theorem iSup_rankLocus_schubertChartBasis (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n)
    (N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j))) :
    (⨆ i : Fin r, N.1.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) =
      Ideal.span {a : A | ∃ (i : Fin r) (j : Fin k),
        p i < schubertComplEmb hp hnk j ∧
          chartBasisEquiv (schubertChartBasis b hp hnk) A N i j = a} := by
  set Φ := chartBasisEquiv (schubertChartBasis b hp hnk) A N
  set J := Ideal.span {a : A | ∃ (i : Fin r) (j : Fin k),
    p i < schubertComplEmb hp hnk j ∧ Φ i j = a}
  refine le_antisymm (iSup_le fun i ↦ ?_) (Ideal.span_le.mpr ?_)
  · let π : A →ₐ[R] A ⧸ J := Ideal.Quotient.mkₐ R J
    have hker : RingHom.ker π = J := Ideal.Quotient.mkₐ_ker R J
    rw [← hker, ← Ideal.map_eq_bot_iff_le_ker, ← rankLocus_map]
    have hN : N.1 = ((chartBasisEquiv (schubertChartBasis b hp hnk) A).symm Φ).1 := by
      simp [Φ]
    rw [hN, map_chartBasisEquiv_symm]
    refine rankLocus_schubertChartBasis_eq_bot_of_eq_zero b hp hnk (Φ.map π) (fun i' j hij ↦ ?_) i
    rw [Matrix.map_apply, ← RingHom.mem_ker, hker]
    exact Ideal.subset_span ⟨i', j, hij, rfl⟩
  · rintro _ ⟨i, j, hij, rfl⟩
    exact le_iSup (fun i : Fin r ↦ N.1.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)) i
      (chartBasisEquiv_apply_mem_rankLocus b hp hnk N hij)

/-- A point `N` of the adapted chart satisfies all Schubert rank conditions for `p` if and only if
its chart matrix `Φ` vanishes at all pairs `(i, j)` with `p i < schubertComplEmb hp hnk j`. -/
theorem rankLocus_schubertChartBasis_eq_bot_iff (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n)
    (N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j))) :
    (∀ i : Fin r, N.1.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥) ↔
      ∀ (i : Fin r) (j : Fin k), p i < schubertComplEmb hp hnk j →
        chartBasisEquiv (schubertChartBasis b hp hnk) A N i j = 0 := by
  rw [← iSup_eq_bot, iSup_rankLocus_schubertChartBasis b hp hnk N, Ideal.span_eq_bot]
  exact ⟨fun h i j hij ↦ h _ ⟨i, j, hij, rfl⟩,
    by rintro h _ ⟨i, j, hij, rfl⟩; exact h i j hij⟩

end AdaptedChart

/-! ### Echelon parametrization and corepresentability of the Schubert cell -/

section Cell

variable {n r k : ℕ}

/-- The pairs `(i, j) : Fin r × Fin k` with `schubertComplEmb hp hnk j < p i` correspond
bijectively to the free echelon positions `(Finset.univ.image p).echelonFreeEntries` via
`(i, j) ↦ (p i, schubertComplEmb hp hnk j)`. -/
private noncomputable def schubertFreeEntriesEquiv {p : Fin r → Fin n} (hp : StrictMono p)
    (hnk : r + k = n) :
    {ij : Fin r × Fin k // schubertComplEmb hp hnk ij.2 < p ij.1} ≃
      (univ.image p).echelonFreeEntries :=
  Equiv.ofBijective
    (fun ij ↦ ⟨(p ij.1.1, schubertComplEmb hp hnk ij.1.2),
      mem_echelonFreeEntries.mpr ⟨mem_image_of_mem p (mem_univ _), ij.2,
        schubertComplEmb_notMem_image hp hnk _⟩⟩)
    ⟨fun ⟨⟨i₁, j₁⟩, _⟩ ⟨⟨i₂, j₂⟩, _⟩ h ↦ by
      obtain ⟨hi, hj⟩ := Prod.mk.inj (Subtype.mk.inj h)
      exact Subtype.ext (Prod.ext (hp.injective hi) ((schubertComplEmb hp hnk).injective hj)),
    fun ⟨⟨s, t⟩, hx⟩ ↦ by
      obtain ⟨hs, hts, ht⟩ := mem_echelonFreeEntries.mp hx
      obtain ⟨i, -, rfl⟩ := mem_image.mp hs
      have ht' : t ∈ univ.image (schubertComplEmb hp hnk) := by
        rw [image_schubertComplEmb hp hnk, mem_compl]
        exact ht
      obtain ⟨j, -, rfl⟩ := mem_image.mp ht'
      exact ⟨⟨(i, j), hts⟩, rfl⟩⟩

/-- The `r × k` chart matrix corresponding to free echelon entries
`a : (Finset.univ.image p).echelonFreeEntries → A`: its `(i, j)`-entry is `-a (p i, q j)` at a
free position `q j < p i`, and `0` when `p i < q j`. The minus sign matches
`Module.Grassmannian.chartGraphVector` with `Module.Basis.echelonRow`. -/
noncomputable def schubertEchelonMatrix {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n)
    (a : (univ.image p).echelonFreeEntries → A) : Matrix (Fin r) (Fin k) A :=
  Matrix.of fun i j ↦
    if h : (p i, schubertComplEmb hp hnk j) ∈ (univ.image p).echelonFreeEntries then
      -a ⟨(p i, schubertComplEmb hp hnk j), h⟩
    else 0

private theorem schubertEchelonMatrix_eq_zero_of_lt {p : Fin r → Fin n} (hp : StrictMono p)
    (hnk : r + k = n) (a : (univ.image p).echelonFreeEntries → A) {i : Fin r} {j : Fin k}
    (hij : p i < schubertComplEmb hp hnk j) :
    schubertEchelonMatrix hp hnk a i j = 0 := by
  rw [schubertEchelonMatrix, Matrix.of_apply, dite_eq_right]
  intro h
  exact (mem_echelonFreeEntries.mp h).2.1.not_gt hij

/-- The `i`-th graph vector of `schubertEchelonMatrix hp hnk a` in the adapted chart basis is the
reduced echelon row `(b.baseChange A).echelonRow (Finset.univ.image p) a (p i)`. -/
theorem chartGraphVector_schubertEchelonMatrix (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (a : (univ.image p).echelonFreeEntries → A)
    (i : Fin r) :
    chartGraphVector (schubertChartBasis b hp hnk) (schubertEchelonMatrix hp hnk a) i =
      (b.baseChange A).echelonRow (univ.image p) a (p i) := by
  refine (b.baseChange A).repr.injective (Finsupp.ext fun t ↦ ?_)
  rw [chartGraphVector_def, schubertChartBasis_inl, map_sub, map_sum, Finsupp.sub_apply,
    Finset.sum_apply']
  obtain ⟨i' | j', heq⟩ := (schubertIndexEquiv hp hnk).symm.surjective t
  · have ht : p i' = t := by simpa [schubertIndexEquiv] using heq
    subst ht
    have hsum : (∑ j : Fin k, ((b.baseChange A).repr (schubertEchelonMatrix hp hnk a i j •
        (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j))) (p i')) = 0 := by
      refine sum_eq_zero fun j _ ↦ ?_
      rw [schubertChartBasis_inr, LinearEquiv.map_smul, Finsupp.smul_apply,
        ← Basis.baseChange_apply, Basis.repr_self,
        Finsupp.single_eq_of_ne (schubertComplEmb_ne hp hnk i' j).symm, smul_zero]
    rw [hsum, sub_zero, ← Basis.baseChange_apply, Basis.repr_self,
      Basis.repr_echelonRow_of_mem a (p i) (mem_image_of_mem p (mem_univ i'))]
  · have ht : schubertComplEmb hp hnk j' = t := by simpa [schubertIndexEquiv] using heq
    subst ht
    rw [← Basis.baseChange_apply, Basis.repr_self,
      Finsupp.single_eq_of_ne (schubertComplEmb_ne hp hnk i j'), zero_sub,
      Basis.repr_echelonRow, ite_eq_right (schubertComplEmb_ne hp hnk i j')]
    have hsum : (∑ j : Fin k, ((b.baseChange A).repr (schubertEchelonMatrix hp hnk a i j •
        (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)))
          (schubertComplEmb hp hnk j')) = schubertEchelonMatrix hp hnk a i j' := by
      rw [Finset.sum_eq_single j']
      · rw [schubertChartBasis_inr, LinearEquiv.map_smul, Finsupp.smul_apply,
          ← Basis.baseChange_apply, Basis.repr_self, Finsupp.single_eq_same, smul_eq_mul, mul_one]
      · intro j _ hjj'
        rw [schubertChartBasis_inr, LinearEquiv.map_smul, Finsupp.smul_apply,
          ← Basis.baseChange_apply, Basis.repr_self,
          Finsupp.single_eq_of_ne ((schubertComplEmb hp hnk).injective.ne hjj'.symm), smul_zero]
      · simp
    rw [hsum, schubertEchelonMatrix, Matrix.of_apply]
    split_ifs <;> simp

/-- **Affine-space parametrization of the Schubert cell over an `R`-algebra.** The points of the
adapted chart at `b ∘ schubertComplEmb hp hnk` over `A` on which the Schubert rank loci of `p`
vanish are in bijection with `(Finset.univ.image p).echelonFreeEntries → A`. By
`StrictMono.card_echelonFreeEntries_image`, there are `∑ i, (p i - i)` coordinates. -/
noncomputable def schubertCellEquiv (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (A : Type w) [CommRing A] [Algebra R A] :
    {N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) //
      ∀ i : Fin r, N.1.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥} ≃
      ((univ.image p).echelonFreeEntries → A) where
  toFun N x :=
    -chartBasisEquiv (schubertChartBasis b hp hnk) A N.1
      ((schubertFreeEntriesEquiv hp hnk).symm x).1.1
      ((schubertFreeEntriesEquiv hp hnk).symm x).1.2
  invFun a :=
    ⟨(chartBasisEquiv (schubertChartBasis b hp hnk) A).symm (schubertEchelonMatrix hp hnk a),
      (rankLocus_schubertChartBasis_eq_bot_iff b hp hnk _).mpr fun i j hij ↦ by
        rw [Equiv.apply_symm_apply]
        exact schubertEchelonMatrix_eq_zero_of_lt hp hnk a hij⟩
  left_inv N := by
    refine Subtype.ext <| (chartBasisEquiv (schubertChartBasis b hp hnk) A).injective ?_
    rw [Equiv.apply_symm_apply]
    ext i j
    rw [schubertEchelonMatrix, Matrix.of_apply]
    by_cases h : (p i, schubertComplEmb hp hnk j) ∈ (univ.image p).echelonFreeEntries
    · rw [dite_eq_left h]
      have hij : schubertComplEmb hp hnk j < p i := (mem_echelonFreeEntries.mp h).2.1
      have hsymm : (schubertFreeEntriesEquiv hp hnk).symm
          ⟨(p i, schubertComplEmb hp hnk j), h⟩ = ⟨(i, j), hij⟩ :=
        (Equiv.symm_apply_eq _).mpr rfl
      dsimp only
      rw [hsymm, neg_neg]
    · rw [dite_eq_right h]
      have hlt : p i < schubertComplEmb hp hnk j := by
        refine lt_of_le_of_ne (not_lt.mp fun hij ↦ h ?_) (schubertComplEmb_ne hp hnk i j).symm
        exact mem_echelonFreeEntries.mpr
          ⟨mem_image_of_mem p (mem_univ i), hij, schubertComplEmb_notMem_image hp hnk j⟩
      exact ((rankLocus_schubertChartBasis_eq_bot_iff b hp hnk N.1).mp N.2 i j hlt).symm
  right_inv a := by
    funext x
    obtain ⟨⟨⟨i, j⟩, hij⟩, rfl⟩ := (schubertFreeEntriesEquiv hp hnk).surjective x
    dsimp only
    rw [Equiv.symm_apply_apply, Equiv.apply_symm_apply, schubertEchelonMatrix, Matrix.of_apply]
    have hmem : (p i, schubertComplEmb hp hnk j) ∈ (univ.image p).echelonFreeEntries :=
      (schubertFreeEntriesEquiv hp hnk ⟨(i, j), hij⟩).2
    rw [dite_eq_left hmem, neg_neg]
    rfl

theorem chartBasisEquiv_schubertCellEquiv_symm (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (a : (univ.image p).echelonFreeEntries → A) :
    chartBasisEquiv (schubertChartBasis b hp hnk) A ((schubertCellEquiv b hp hnk A).symm a).1 =
      schubertEchelonMatrix hp hnk a := by
  exact Equiv.apply_symm_apply _ _

/-- The underlying adapted-chart point of `(schubertCellEquiv b hp hnk A).symm a` corresponds to
`schubertEchelonMatrix hp hnk a` under `chartBasisEquiv`. -/
@[simp]
theorem fst_schubertCellEquiv_symm (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (a : (univ.image p).echelonFreeEntries → A) :
    ((schubertCellEquiv b hp hnk A).symm a).1 =
      (chartBasisEquiv (schubertChartBasis b hp hnk) A).symm (schubertEchelonMatrix hp hnk a) :=
  (Equiv.eq_symm_apply _).mpr (chartBasisEquiv_schubertCellEquiv_symm b hp hnk a)

/-- **The point of the Schubert cell with free entries `a` is spanned by the reduced echelon
rows.** -/
theorem toSubmodule_schubertCellEquiv_symm (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (a : (univ.image p).echelonFreeEntries → A) :
    ((schubertCellEquiv b hp hnk A).symm a).1.1.toSubmodule =
      Submodule.span A (Set.range fun s : univ.image p ↦
        (b.baseChange A).echelonRow (univ.image p) a s) := by
  rw [fst_schubertCellEquiv_symm, toSubmodule_chartBasisEquiv_symm]
  refine congrArg (Submodule.span A) ?_
  ext v
  simp only [Set.mem_range, chartGraphVector_schubertEchelonMatrix]
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨⟨p i, mem_image_of_mem p (mem_univ i)⟩, rfl⟩
  · rintro ⟨⟨s, hs⟩, rfl⟩
    obtain ⟨i, -, rfl⟩ := mem_image.mp hs
    exact ⟨i, rfl⟩

/-- **Naturality of the Schubert cell coordinates.** Base change along `f : A →ₐ[R] B` applies `f`
to the free echelon entries. -/
theorem map_schubertCellEquiv_symm (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (f : A →ₐ[R] B)
    (a : (univ.image p).echelonFreeEntries → A) :
    map f ((schubertCellEquiv b hp hnk A).symm a).1.1 =
      ((schubertCellEquiv b hp hnk B).symm (f ∘ a)).1.1 := by
  have hmap : (schubertEchelonMatrix hp hnk a).map f = schubertEchelonMatrix hp hnk (f ∘ a) := by
    ext i j
    simp [schubertEchelonMatrix, apply_dite f]
  rw [fst_schubertCellEquiv_symm, fst_schubertCellEquiv_symm, map_chartBasisEquiv_symm, hmap]

/-- **The Schubert cell as a subfunctor** of the Grassmannian functor: over `A`, it consists of
the points of `G(k, A ⊗[R] M; A)` lying in the adapted chart at `b ∘ schubertComplEmb hp hnk` on
which all Schubert rank loci of `p` vanish. -/
noncomputable def schubertCellFunctor (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) :
    Subfunctor (functor.{u, v, w} (R := R) (M := M) k) where
  obj A := {N : G(k, A ⊗[R] M; A) |
    N ∈ chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) ∧
      ∀ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥}
  map {A B} f N hN := by
    let N' : G(k, A ⊗[R] M; A) := N
    have hN' : N' ∈ chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) ∧
        ∀ i : Fin r, N'.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥ := hN
    have hchart := (mem_chartFunctor_obj_iff
      (fun j ↦ schubertChartBasis b hp hnk (.inr j)) B _).mp <|
      (chartFunctor R (fun j ↦ schubertChartBasis b hp hnk (.inr j))).map f
        ((mem_chartFunctor_obj_iff _ A N').mpr hN'.1)
    refine ⟨hchart, fun i ↦ ?_⟩
    have hrank : (map f.hom N').rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥ := by
      rw [rankLocus_map, hN'.2 i, Ideal.map_bot]
    exact hrank

@[simp]
theorem mem_schubertCellFunctor_obj_iff (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (A : CommAlgCat.{w} R) (N : G(k, A ⊗[R] M; A)) :
    N ∈ (schubertCellFunctor b hp hnk).obj A ↔
      N ∈ chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) ∧
        ∀ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥ := by
  rfl

/-- `R`-algebra homomorphisms from `MvPolynomial (Finset.univ.image p).echelonFreeEntries R` to `A`
are in natural bijection with the points of the Schubert cell over `A`. -/
noncomputable def schubertCellHomEquiv (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (A : Type w) [CommRing A] [Algebra R A] :
    (MvPolynomial (univ.image p).echelonFreeEntries R →ₐ[R] A) ≃
      {N : chart A (fun j ↦ (1 : A) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) //
        ∀ i : Fin r, N.1.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥} :=
  (MvPolynomial.aevalEquiv _ R A).symm.trans (schubertCellEquiv b hp hnk A).symm

/-- `schubertCellHomEquiv` is natural in `A`. -/
theorem schubertCellHomEquiv_comp (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (f : A →ₐ[R] B)
    (g : MvPolynomial (univ.image p).echelonFreeEntries R →ₐ[R] A) :
    (schubertCellHomEquiv b hp hnk B (f.comp g)).1.1 =
      map f (schubertCellHomEquiv b hp hnk A g).1.1 := by
  have hcomp : (MvPolynomial.aevalEquiv _ R B).symm (f.comp g) =
      f ∘ (MvPolynomial.aevalEquiv _ R A).symm g :=
    funext fun _ ↦ by simp
  exact (congrArg (fun a ↦ ((schubertCellEquiv b hp hnk B).symm a).1.1) hcomp).trans
    (map_schubertCellEquiv_symm b hp hnk f _).symm

/-- **The Schubert cell subfunctor is corepresented by a polynomial ring** over `R` in
`#(Finset.univ.image p).echelonFreeEntries = ∑ i, (p i - i)` variables. -/
noncomputable def schubertCellCorepresentableBy (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) :
    (schubertCellFunctor.{u, v, u} b hp hnk).toFunctor.CorepresentableBy
      (CommAlgCat.of R (MvPolynomial (univ.image p).echelonFreeEntries R)) where
  homEquiv {A} := ConcreteCategory.homEquiv.trans <|
    (schubertCellHomEquiv b hp hnk A.carrier).trans
      { toFun N := ⟨N.1.1, (mem_schubertCellFunctor_obj_iff b hp hnk A N.1.1).mpr ⟨N.1.2, N.2⟩⟩
        invFun N :=
          let h := (mem_schubertCellFunctor_obj_iff b hp hnk A N.1).mp N.2
          ⟨⟨N.1, h.1⟩, h.2⟩
        left_inv _ := rfl
        right_inv _ := rfl }
  homEquiv_comp f g := Subtype.ext <| by exact schubertCellHomEquiv_comp b hp hnk f.hom g.hom

/-- The `R`-algebra homomorphism from the coordinate ring of the adapted chart to the polynomial
ring of the Schubert cell classifying the universal echelon point. -/
noncomputable def schubertChartAlgHom (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) :
    ChartAlgebra R (fun j ↦ schubertChartBasis b hp hnk (.inr j)) →ₐ[R]
      MvPolynomial (univ.image p).echelonFreeEntries R :=
  (chartHomEquiv R _ _).symm
    (schubertCellHomEquiv b hp hnk _
      (AlgHom.id R (MvPolynomial (univ.image p).echelonFreeEntries R))).1

@[simp]
theorem chartHomEquiv_schubertChartAlgHom (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) :
    chartHomEquiv R _ _ (schubertChartAlgHom b hp hnk) =
      (schubertCellHomEquiv b hp hnk _
        (AlgHom.id R (MvPolynomial (univ.image p).echelonFreeEntries R))).1 :=
  Equiv.apply_symm_apply _ _

/-- On the generator `universalLinearMap R _ (b (p i)) j`, `schubertChartAlgHom` evaluates to the
`(i, j)`-entry of the universal echelon matrix `schubertEchelonMatrix hp hnk MvPolynomial.X`. -/
theorem schubertChartAlgHom_universalLinearMap_inl (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) (i : Fin r) (j : Fin k) :
    schubertChartAlgHom b hp hnk (ChartAlgebra.universalLinearMap R _ (b (p i)) j) =
      schubertEchelonMatrix hp hnk MvPolynomial.X i j := by
  set x : Fin k → M := fun j' ↦ schubertChartBasis b hp hnk (.inr j')
  have h1 := congrFun (chartBasisEquiv_apply (schubertChartBasis b hp hnk)
    (chartHomEquiv R x _ (schubertChartAlgHom b hp hnk)) i) j
  rw [schubertChartBasis_inl] at h1
  have h2 := chartEquiv_chartHomEquiv_apply_tmul x (schubertChartAlgHom b hp hnk) (b (p i)) j
  have hid : (MvPolynomial.aevalEquiv (univ.image p).echelonFreeEntries R _).symm
      (AlgHom.id R _) = MvPolynomial.X :=
    funext fun _ ↦ by simp
  have hmat : chartBasisEquiv (schubertChartBasis b hp hnk) _
      (chartHomEquiv R x _ (schubertChartAlgHom b hp hnk)) =
      schubertEchelonMatrix hp hnk MvPolynomial.X := by
    rw [chartHomEquiv_schubertChartAlgHom, schubertCellHomEquiv, Equiv.trans_apply, hid,
      chartBasisEquiv_schubertCellEquiv_symm]
  exact h2.symm.trans (h1.symm.trans (congrFun (congrFun hmat i) j))

/-- Explicit `R`-algebra section of `schubertChartAlgHom` sending each polynomial variable `X e`
(with `e = (p i, q j)`) to `-universalLinearMap R _ (b (p i)) j`. -/
private noncomputable def schubertChartAlgHomSection (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) :
    MvPolynomial (univ.image p).echelonFreeEntries R →ₐ[R]
      ChartAlgebra R (fun j ↦ schubertChartBasis b hp hnk (.inr j)) :=
  MvPolynomial.aeval fun e ↦
    -ChartAlgebra.universalLinearMap R _
      (b (p ((schubertFreeEntriesEquiv hp hnk).symm e).1.1))
      ((schubertFreeEntriesEquiv hp hnk).symm e).1.2

private theorem schubertChartAlgHom_comp_section (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) :
    (schubertChartAlgHom b hp hnk).comp (schubertChartAlgHomSection b hp hnk) =
      AlgHom.id R (MvPolynomial (univ.image p).echelonFreeEntries R) := by
  refine MvPolynomial.algHom_ext fun e ↦ ?_
  obtain ⟨⟨⟨i, j⟩, hij⟩, rfl⟩ := (schubertFreeEntriesEquiv hp hnk).surjective e
  rw [AlgHom.comp_apply, AlgHom.id_apply, schubertChartAlgHomSection, MvPolynomial.aeval_X,
    Equiv.symm_apply_apply, map_neg, schubertChartAlgHom_universalLinearMap_inl,
    schubertEchelonMatrix, Matrix.of_apply]
  have hmem : (p i, schubertComplEmb hp hnk j) ∈ (univ.image p).echelonFreeEntries :=
    (schubertFreeEntriesEquiv hp hnk ⟨(i, j), hij⟩).2
  rw [dite_eq_left hmem, neg_neg]
  rfl

/-- **`schubertChartAlgHom` is surjective**: the Schubert cell is a closed subscheme of the adapted
standard chart. -/
theorem schubertChartAlgHom_surjective (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) :
    Function.Surjective (schubertChartAlgHom b hp hnk) := fun f ↦
  ⟨schubertChartAlgHomSection b hp hnk f,
    congrArg (fun g : _ →ₐ[R] _ ↦ g f) (schubertChartAlgHom_comp_section b hp hnk)⟩

/-- Modulo any ideal `I` containing the universal entries `universalLinearMap R x (b (p i)) j` with
`p i < q j`, the quotient projection factors through `schubertChartAlgHom` via
`schubertChartAlgHomSection`. -/
private theorem mk_comp_schubertChartAlgHomSection_comp (b : Basis (Fin n) R M)
    {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n)
    (I : Ideal (ChartAlgebra R (fun j ↦ schubertChartBasis b hp hnk (.inr j))))
    (hI : ∀ (i : Fin r) (j : Fin k), p i < schubertComplEmb hp hnk j →
      ChartAlgebra.universalLinearMap R (fun j ↦ schubertChartBasis b hp hnk (.inr j))
        (b (p i)) j ∈ I) :
    ((Ideal.Quotient.mkₐ R I).comp (schubertChartAlgHomSection b hp hnk)).comp
      (schubertChartAlgHom b hp hnk) = Ideal.Quotient.mkₐ R I := by
  let x := fun j ↦ schubertChartBasis b hp hnk (.inr j)
  let mk : ChartAlgebra R x →ₐ[R] ChartAlgebra R x ⧸ I := Ideal.Quotient.mkₐ R I
  let σ := schubertChartAlgHomSection b hp hnk
  let φ := schubertChartAlgHom b hp hnk
  refine ChartAlgebra.hom_ext R x fun m j ↦ ?_
  let L₁ : M →ₗ[R] ChartAlgebra R x ⧸ I :=
    ((mk.comp σ).comp φ).toLinearMap ∘ₗ LinearMap.proj j ∘ₗ ChartAlgebra.universalLinearMap R x
  let L₂ : M →ₗ[R] ChartAlgebra R x ⧸ I :=
    mk.toLinearMap ∘ₗ LinearMap.proj j ∘ₗ ChartAlgebra.universalLinearMap R x
  suffices L₁ = L₂ from congrArg (fun L : M →ₗ[R] _ ↦ L m) this
  refine (schubertChartBasis b hp hnk).ext fun idx ↦ ?_
  rcases idx with i | j'
  · dsimp only [L₁, L₂, LinearMap.coe_comp, Function.comp_apply, AlgHom.toLinearMap_apply,
      LinearMap.proj_apply, AlgHom.comp_apply]
    rw [schubertChartBasis_inl, schubertChartAlgHom_universalLinearMap_inl,
      schubertEchelonMatrix, Matrix.of_apply]
    by_cases hmem : (p i, schubertComplEmb hp hnk j) ∈ (univ.image p).echelonFreeEntries
    · rw [dite_eq_left hmem, map_neg, map_neg]
      have hij : schubertComplEmb hp hnk j < p i := (mem_echelonFreeEntries.mp hmem).2.1
      have hsymm : (schubertFreeEntriesEquiv hp hnk).symm
          ⟨(p i, schubertComplEmb hp hnk j), hmem⟩ = ⟨(i, j), hij⟩ :=
        (Equiv.symm_apply_eq _).mpr rfl
      simp [σ, schubertChartAlgHomSection, hsymm]
      rfl
    · rw [dite_eq_right hmem, map_zero, map_zero, eq_comm]
      dsimp only [mk]
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      refine hI i j (lt_of_le_of_ne (not_lt.mp fun hij ↦ hmem ?_)
        (schubertComplEmb_ne hp hnk i j).symm)
      exact mem_echelonFreeEntries.mpr
        ⟨mem_image_of_mem p (mem_univ i), hij, schubertComplEmb_notMem_image hp hnk j⟩
  · dsimp only [L₁, L₂, LinearMap.coe_comp, Function.comp_apply, AlgHom.toLinearMap_apply,
      LinearMap.proj_apply]
    have hx : schubertChartBasis b hp hnk (.inr j') = x j' := rfl
    rw [hx, ChartAlgebra.universalLinearMap_apply_self]
    by_cases hjj' : j = j'
    · subst hjj'; simp
    · simp [Pi.single_eq_of_ne hjj']

/-- **The kernel of `schubertChartAlgHom` is the universal Schubert rank ideal** on the adapted
chart. -/
theorem ker_schubertChartAlgHom (b : Basis (Fin n) R M) {p : Fin r → Fin n}
    (hp : StrictMono p) (hnk : r + k = n) :
    RingHom.ker (schubertChartAlgHom b hp hnk) =
      ⨆ i : Fin r,
        (chartHomEquiv R (fun j ↦ schubertChartBasis b hp hnk (.inr j)) _
          (AlgHom.id R _)).1.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) := by
  set x := fun j ↦ schubertChartBasis b hp hnk (.inr j)
  set N₀ := chartHomEquiv R x (ChartAlgebra R x) (AlgHom.id R _)
  set I := ⨆ i : Fin r, N₀.1.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i)
  have hN₀ (i : Fin r) (j : Fin k) :
      chartBasisEquiv (schubertChartBasis b hp hnk) _ N₀ i j =
        ChartAlgebra.universalLinearMap R x (b (p i)) j :=
    (congrFun (by rw [chartBasisEquiv_apply, schubertChartBasis_inl]) j).trans
      (chartEquiv_chartHomEquiv_apply_tmul x (AlgHom.id R (ChartAlgebra R x)) (b (p i)) j)
  have hI : I = Ideal.span {a : ChartAlgebra R x | ∃ (i : Fin r) (j : Fin k),
      p i < schubertComplEmb hp hnk j ∧
        ChartAlgebra.universalLinearMap R x (b (p i)) j = a} := by
    dsimp only [I]
    rw [iSup_rankLocus_schubertChartBasis b hp hnk N₀]
    simp_rw [hN₀]
  refine le_antisymm (fun c hc ↦ ?_) ?_
  · have hret := mk_comp_schubertChartAlgHomSection_comp b hp hnk I fun i j hij ↦ by
      rw [hI]; exact Ideal.subset_span ⟨i, j, hij, rfl⟩
    have hzero : Ideal.Quotient.mkₐ R I c = 0 := by
      rw [← hret, AlgHom.comp_apply, RingHom.mem_ker.mp hc, map_zero]
    rwa [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at hzero
  · rw [hI, Ideal.span_le]
    rintro _ ⟨i, j, hij, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, schubertChartAlgHom_universalLinearMap_inl]
    exact schubertEchelonMatrix_eq_zero_of_lt hp hnk MvPolynomial.X hij

end Cell

/-! ### Field points via `flagPivots` and single-step polynomial deformations -/

section Field

variable {n r k : ℕ} {K : Type w} [Field K] [Algebra R K]

/-- Over a field `K`, a point `N ∈ G(k, K ⊗[R] M; K)` with `r + k = n` has `dim_K N = r`. -/
theorem finrank_toSubmodule_of_basis (b : Basis (Fin n) R M) (hnk : r + k = n)
    (N : G(k, K ⊗[R] M; K)) :
    finrank K N.toSubmodule = r := by
  have := Module.Finite.of_basis (b.baseChange K)
  have hsum := N.toSubmodule.finrank_quotient_add_finrank
  rw [TauCeti.Module.finrank_eq_of_rankAtStalk_eq (funext N.rankAtStalk_eq),
    finrank_eq_card_basis (b.baseChange K), Fintype.card_fin] at hsum
  omega

/-- **Field points of the Schubert cell.** Over a field `K`, a point `N ∈ G(k, K ⊗[R] M; K)` lies
in the adapted chart at `b ∘ schubertComplEmb hp hnk` and satisfies all Schubert rank conditions
for `p` if and only if its pivot set `(b.baseChange K).flagPivots N.toSubmodule` equals
`Finset.univ.image p`. -/
theorem mem_chart_and_rankLocus_eq_bot_iff_flagPivots (b : Basis (Fin n) R M)
    {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n) (N : G(k, K ⊗[R] M; K)) :
    (N ∈ chart K (fun j ↦ (1 : K) ⊗ₜ[R] schubertChartBasis b hp hnk (.inr j)) ∧
      ∀ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥) ↔
      (b.baseChange K).flagPivots N.toSubmodule = univ.image p := by
  constructor
  · rintro ⟨hchart, hrank⟩
    let a := schubertCellEquiv b hp hnk K ⟨⟨N, hchart⟩, hrank⟩
    have hN : N.toSubmodule = ((schubertCellEquiv b hp hnk K).symm a).1.1.toSubmodule := by
      simp [a]
    rw [hN, toSubmodule_schubertCellEquiv_symm]
    exact Basis.flagPivots_span_echelonRow (univ.image p) a
  · intro hpiv
    let a := (b.baseChange K).flagCellEquiv (univ.image p) ⟨N.toSubmodule, hpiv⟩
    have hsub : N.toSubmodule = ((schubertCellEquiv b hp hnk K).symm a).1.1.toSubmodule := by
      rw [toSubmodule_schubertCellEquiv_symm, ← Basis.coe_flagCellEquiv_symm_apply,
        Equiv.symm_apply_apply]
    have hN : N = ((schubertCellEquiv b hp hnk K).symm a).1.1 := Grassmannian.ext hsub
    rw [hN]
    exact ⟨((schubertCellEquiv b hp hnk K).symm a).1.2,
      ((schubertCellEquiv b hp hnk K).symm a).2⟩

/-- **Field points of the Schubert rank locus in the Bruhat order.** Over a field `K`, a point
`N ∈ G(k, K ⊗[R] M; K)` (with `r + k = n`) satisfies all Schubert rank conditions for `p` if and
only if the strictly increasing pivot sequence `p' : Fin r → Fin n` of `N.toSubmodule` satisfies
`p' i ≤ p i` for every `i`. -/
theorem forall_rankLocus_eq_bot_iff_exists_flagPivots (b : Basis (Fin n) R M)
    {p : Fin r → Fin n} (hp : StrictMono p) (hnk : r + k = n) (N : G(k, K ⊗[R] M; K)) :
    (∀ i : Fin r, N.rankLocus (b.flag (p i).succ) ((p i : ℕ) - i) = ⊥) ↔
      ∃ p' : Fin r → Fin n, StrictMono p' ∧
        (b.baseChange K).flagPivots N.toSubmodule = univ.image p' ∧ ∀ i : Fin r, p' i ≤ p i := by
  have := Module.Finite.of_basis (b.baseChange K)
  have hcard : #((b.baseChange K).flagPivots N.toSubmodule) = r := by
    rw [Basis.card_flagPivots, finrank_toSubmodule_of_basis b hnk N]
  let p' : Fin r ↪o Fin n := ((b.baseChange K).flagPivots N.toSubmodule).orderEmbOfFin hcard
  have hp' : StrictMono p' := p'.strictMono
  have hpiv : (b.baseChange K).flagPivots N.toSubmodule = univ.image p' := by
    rw [← coe_inj, coe_image, coe_univ, Set.image_univ, Finset.range_orderEmbOfFin]
  constructor
  · intro hrank
    refine ⟨p', hp', hpiv, fun i ↦ ?_⟩
    by_contra! hlt
    have hdim := (N.rankLocus_eq_bot_iff_finrank_inf (b.flag (p i).succ) ((p i : ℕ) - i)).mp
      (hrank i)
    rw [← Basis.flag_baseChange, Basis.finrank_flag, Fin.val_succ, inf_comm,
      Basis.finrank_inf_flag, hpiv, filter_image, card_image_of_injective _ hp'.injective] at hdim
    have hhi := (Fin.val_strictMono.comp hp).add_sub_le_nat
      (Fin.le_def.mpr (Nat.zero_le i) : (⟨0, i.pos⟩ : Fin r) ≤ i)
    simp only [Function.comp_apply] at hhi
    have hsub : ({l : Fin r | (p' l).castSucc < (p i).succ} : Finset (Fin r)) ⊆ Iio i :=
      fun l hl ↦ by
        simp only [mem_filter, mem_univ, true_and, Fin.castSucc_lt_succ_iff] at hl
        exact mem_Iio.mpr (hp'.lt_iff_lt.mp (hl.trans_lt hlt))
    have hcard_lt : #{l : Fin r | (p' l).castSucc < (p i).succ} ≤ i :=
      (card_le_card hsub).trans_eq (Fin.card_Iio i)
    omega
  · rintro ⟨p₁, hp₁, hpiv₁, hle⟩
    have hcell := ((mem_chart_and_rankLocus_eq_bot_iff_flagPivots b hp₁ hnk N).mpr hpiv₁).2
    rw [← iSup_eq_bot] at hcell ⊢
    exact le_bot_iff.mp ((iSup_rankLocus_flag_succ_antitone b hp hp₁ hle N).trans_eq hcell)

/-- Coordinates in the base-changed basis commute with `f.toLinearMap.rTensor M`. -/
private theorem repr_baseChange_rTensor (b : Basis (Fin n) R M) (f : A →ₐ[R] B) (x : A ⊗[R] M)
    (w : Fin n) :
    (b.baseChange B).repr (f.toLinearMap.rTensor M x) w = f ((b.baseChange A).repr x w) := by
  have hterm (q : Fin n) :
      ((b.baseChange B).repr (f.toLinearMap.rTensor M
        ((b.baseChange A).repr x q • (b.baseChange A) q))) w =
        if w = q then f ((b.baseChange A).repr x q) else 0 := by
    rw [Basis.baseChange_apply, smul_tmul', smul_eq_mul, mul_one, LinearMap.rTensor_tmul,
      AlgHom.toLinearMap_apply, ← mul_one (f _), ← smul_eq_mul, ← smul_tmul',
      ← Basis.baseChange_apply, LinearEquiv.map_smul, Finsupp.smul_apply, Basis.repr_self,
      smul_eq_mul, Finsupp.single_apply]
    rcases eq_or_ne w q with rfl | hwq
    · simp
    · simp [hwq, hwq.symm]
  conv_lhs => rw [← (b.baseChange A).sum_repr x]
  rw [map_sum, map_sum, Finset.sum_apply']
  simp only [hterm, Finset.sum_ite_eq, mem_univ, ↓reduceIte]

/-- The elementary transvection `x ↦ x + (t * coord_u x) • b_v` on `A ⊗[R] M` along a basis `b`. -/
private noncomputable def shearLin (b : Basis (Fin n) R M) (u v : Fin n) (t : A) :
    A ⊗[R] M →ₗ[A] A ⊗[R] M :=
  LinearMap.id + t • ((b.baseChange A).coord u).smulRight ((b.baseChange A) v)

private theorem repr_shearLin (b : Basis (Fin n) R M) (u v : Fin n) (t : A) (x : A ⊗[R] M)
    (w : Fin n) :
    (b.baseChange A).repr (shearLin b u v t x) w =
      (b.baseChange A).repr x w + if w = v then t * (b.baseChange A).repr x u else 0 := by
  simp [shearLin, Finsupp.single_apply, eq_comm, mul_comm]

/-- For `u ≠ v`, `shearLin b u v t` is an `A`-linear automorphism with inverse
`shearLin b u v (-t)`. -/
private noncomputable def shearEquiv (b : Basis (Fin n) R M) {u v : Fin n} (huv : u ≠ v)
    (t : A) : (A ⊗[R] M) ≃ₗ[A] (A ⊗[R] M) :=
  LinearEquiv.ofLinearMap (shearLin b u v t) (shearLin b u v (-t))
    (LinearMap.ext fun x ↦ (b.baseChange A).repr.injective <| Finsupp.ext fun w ↦ by
      simp [repr_shearLin, ite_eq_right huv]; split_ifs <;> ring)
    (LinearMap.ext fun x ↦ (b.baseChange A).repr.injective <| Finsupp.ext fun w ↦ by
      simp [repr_shearLin, ite_eq_right huv]; split_ifs <;> ring)

private theorem rTensor_shearLin (b : Basis (Fin n) R M) (u v : Fin n) (t : A)
    (f : A →ₐ[R] B) (x : A ⊗[R] M) :
    f.toLinearMap.rTensor M (shearLin b u v t x) =
      shearLin b u v (f t) (f.toLinearMap.rTensor M x) := by
  refine (b.baseChange B).repr.injective (Finsupp.ext fun w ↦ ?_)
  rw [repr_baseChange_rTensor, repr_shearLin, repr_shearLin, repr_baseChange_rTensor,
    repr_baseChange_rTensor, map_add, apply_ite f, map_mul, map_zero]

private theorem map_grassmannianCongr_shearEquiv (b : Basis (Fin n) R M) {u v : Fin n}
    (huv : u ≠ v) (t : A) (f : A →ₐ[R] B) (N : G(k, A ⊗[R] M; A)) :
    map f ((shearEquiv b huv t).grassmannianCongr N) =
      (shearEquiv b huv (f t)).grassmannianCongr (map f N) := by
  ext : 1
  rw [map_toSubmodule_eq_span, LinearEquiv.toSubmodule_grassmannianCongr_apply,
    LinearEquiv.toSubmodule_grassmannianCongr_apply, map_toSubmodule_eq_span,
    Submodule.map_span, Submodule.map_coe, ← Set.image_comp, ← Set.image_comp]
  exact congrArg (Submodule.span B) <| Set.image_congr' fun x ↦ rTensor_shearLin b u v t f x

/-- Extending scalars of an `A`-span along `f : A →ₐ[R] B` is spanned over `B` by the images of the
original generators. -/
private theorem span_rTensor_image_span (f : A →ₐ[R] B) (s : Set (A ⊗[R] M)) :
    Submodule.span B (f.toLinearMap.rTensor M '' (Submodule.span A s : Set (A ⊗[R] M))) =
      Submodule.span B (f.toLinearMap.rTensor M '' s) := by
  have hsmul (a : A) (y : A ⊗[R] M) :
      f.toLinearMap.rTensor M (a • y) = f a • f.toLinearMap.rTensor M y := by
    induction y using TensorProduct.inductionOn with
    | tmul a' m => simp [smul_tmul', map_mul]
    | add y₁ y₂ h₁ h₂ => rw [smul_add, map_add, h₁, h₂, map_add, smul_add]
  refine le_antisymm (Submodule.span_le.mpr ?_)
    (Submodule.span_mono (Set.image_mono Submodule.subset_span))
  rintro _ ⟨x, hx, rfl⟩
  refine Submodule.span_induction (fun y hy ↦ Submodule.subset_span ⟨y, hy, rfl⟩)
    (by simp) (fun y₁ y₂ _ _ h₁ h₂ ↦ by rw [map_add]; exact add_mem h₁ h₂)
    (fun a y _ hy ↦ by rw [hsmul]; exact Submodule.smul_mem _ (f a) hy) hx

/-- If `p' < p` are strictly increasing pivot tuples in `Fin n`, incrementing `p'` at the greatest
index `i₀` where `p' i₀ < p i₀` produces a strictly increasing tuple `p'' ≤ p` with strictly
smaller gap sum `∑ i, (p i - p'' i)`. -/
private theorem exists_update_succ_strictMono {p p' : Fin r → Fin n} (hp : StrictMono p)
    (hp' : StrictMono p') (hle : ∀ i, p' i ≤ p i) (hne : p' ≠ p) :
    ∃ (i₀ : Fin r) (v : Fin n),
      (v : ℕ) = (p' i₀ : ℕ) + 1 ∧
      StrictMono (Function.update p' i₀ v) ∧
      (∀ i, Function.update p' i₀ v i ≤ p i) ∧
      (∀ l : Fin r, i₀ < l → v < p' l) ∧
      ∑ i, ((p i : ℕ) - Function.update p' i₀ v i) < ∑ i, ((p i : ℕ) - p' i) := by
  have hD : ({i : Fin r | p' i < p i} : Finset (Fin r)).Nonempty := by
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hne
    exact ⟨i, mem_filter.mpr ⟨mem_univ i, lt_of_le_of_ne (hle i) hi⟩⟩
  let i₀ : Fin r := ({i : Fin r | p' i < p i} : Finset (Fin r)).max' hD
  have hi₀ : p' i₀ < p i₀ := (mem_filter.mp (max'_mem _ hD)).2
  have hmax (l : Fin r) (hl : i₀ < l) : p' l = p l := by
    refine le_antisymm (hle l) (not_lt.mp fun hlt ↦ hl.not_ge ?_)
    exact le_max' _ l (mem_filter.mpr ⟨mem_univ l, hlt⟩)
  let v : Fin n := ⟨(p' i₀ : ℕ) + 1, lt_of_le_of_lt (Nat.succ_le_of_lt hi₀) (p i₀).isLt⟩
  have hv_val : (v : ℕ) = (p' i₀ : ℕ) + 1 := rfl
  have hvp : v ≤ p i₀ := Fin.le_def.mpr (Nat.succ_le_of_lt hi₀)
  have hgt (l : Fin r) (hl : i₀ < l) : v < p' l := (hmax l hl) ▸ hvp.trans_lt (hp hl)
  refine ⟨i₀, v, hv_val, fun a b hab ↦ ?_, fun i ↦ ?_, hgt, ?_⟩
  · by_cases ha : a = i₀
    · subst a; rw [Function.update_self, Function.update_of_ne hab.ne']; exact hgt b hab
    · rw [Function.update_of_ne ha]
      by_cases hb : b = i₀
      · subst b; rw [Function.update_self]; exact (hp' hab).trans (Fin.lt_def.mpr (by omega))
      · rw [Function.update_of_ne hb]; exact hp' hab
  · by_cases hi : i = i₀
    · subst i; rwa [Function.update_self]
    · rw [Function.update_of_ne hi]; exact hle i
  · refine Finset.sum_lt_sum (fun i _ ↦ ?_) ⟨i₀, mem_univ i₀, ?_⟩
    · by_cases hi : i = i₀
      · subst i; rw [Function.update_self]; omega
      · rw [Function.update_of_ne hi]
    · rw [Function.update_self]
      have : (p' i₀ : ℕ) < p i₀ := hi₀
      omega

/-- Row-reduced generators for `(shearEquiv b _ t).grassmannianCongr (map jKL N)` over `L`: the
`i₀`-th sheared echelon row is scaled by `t⁻¹`, and its `v`-coordinate is eliminated from the
other rows. -/
private noncomputable def shearEchelonVec {L : Type w} [Field L] [Algebra R L]
    (b : Basis (Fin n) R M) (jKL : K →ₐ[R] L) (p' : Fin r → Fin n) (i₀ : Fin r) (v : Fin n)
    (t : L) (N : G(k, K ⊗[R] M; K)) (l : Fin r) : L ⊗[R] M :=
  let y (m : Fin r) := shearLin b (p' i₀) v t
    (jKL.toLinearMap.rTensor M ((b.baseChange K).flagEchelon N.toSubmodule (p' m)))
  if l = i₀ then t⁻¹ • y i₀ else y l - ((b.baseChange L).repr (y l) v * t⁻¹) • y i₀

private theorem toSubmodule_grassmannianCongr_shearEquiv_eq_span {L : Type w} [Field L]
    [Algebra R L] (b : Basis (Fin n) R M) (jKL : K →ₐ[R] L) {p' : Fin r → Fin n}
    {i₀ : Fin r} {v : Fin n} (huv : p' i₀ < v) {t : L} (ht : t ≠ 0) (N : G(k, K ⊗[R] M; K))
    (hpiv : (b.baseChange K).flagPivots N.toSubmodule = univ.image p') :
    ((shearEquiv b huv.ne t).grassmannianCongr (map jKL N)).toSubmodule =
      Submodule.span L (Set.range (shearEchelonVec b jKL p' i₀ v t N)) := by
  let y (l : Fin r) : L ⊗[R] M := shearLin b (p' i₀) v t
    (jKL.toLinearMap.rTensor M ((b.baseChange K).flagEchelon N.toSubmodule (p' l)))
  set y' := shearEchelonVec b jKL p' i₀ v t N
  have hN_echelon : N.toSubmodule = Submodule.span K
      (Set.range fun l : Fin r ↦ (b.baseChange K).flagEchelon N.toSubmodule (p' l)) := by
    conv_lhs => rw [← (b.baseChange K).span_flagEchelon (W := N.toSubmodule)]
    refine congrArg (Submodule.span K) (Set.ext fun x ↦ ?_)
    simp only [Set.mem_range, Subtype.exists, hpiv, mem_image, mem_univ, true_and]
    exact ⟨by rintro ⟨_, ⟨l, rfl⟩, rfl⟩; exact ⟨l, rfl⟩, fun ⟨l, hx⟩ ↦ ⟨p' l, ⟨l, rfl⟩, hx⟩⟩
  rw [LinearEquiv.toSubmodule_grassmannianCongr_apply, map_toSubmodule_eq_span, hN_echelon,
    span_rTensor_image_span, Submodule.map_span, ← Set.image_comp, ← Set.range_comp]
  change Submodule.span L (Set.range y) = Submodule.span L (Set.range y')
  -- Reassociate `(shearEquiv ... ∘ rTensor ...) ∘ flagEchelon` as the family `y`.
  refine le_antisymm (Submodule.span_le.mpr ?_) (Submodule.span_le.mpr ?_)
  · rintro _ ⟨l, rfl⟩
    by_cases hl : l = i₀
    · subst l
      have hyi₀ : y i₀ = t • y' i₀ := by
        simp [y', shearEchelonVec, y, smul_smul, mul_inv_cancel₀ ht]
      exact hyi₀ ▸ Submodule.smul_mem _ t (Submodule.subset_span ⟨i₀, rfl⟩)
    · have hyl : y l = y' l + ((b.baseChange L).repr (y l) v) • y' i₀ := by
        simp [y', shearEchelonVec, y, ite_eq_right hl, smul_smul]
      exact hyl ▸ add_mem (Submodule.subset_span ⟨l, rfl⟩)
        (Submodule.smul_mem _ _ (Submodule.subset_span ⟨i₀, rfl⟩))
  · rintro _ ⟨l, rfl⟩
    by_cases hl : l = i₀
    · subst l
      simp only [y', shearEchelonVec, ↓reduceIte]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i₀, rfl⟩)
    · simp only [y', shearEchelonVec, ite_eq_right hl]
      exact sub_mem (Submodule.subset_span ⟨l, rfl⟩)
        (Submodule.smul_mem _ _ (Submodule.subset_span ⟨i₀, rfl⟩))

/-- `shearLin b (p' i₀) v t` fixes every echelon basis vector at index `p' m` with `m ≠ i₀`, since
such an echelon vector has zero `(p' i₀)`-coordinate. -/
private theorem shearLin_rTensor_flagEchelon_of_ne {L : Type w} [Field L] [Algebra R L]
    (b : Basis (Fin n) R M) (jKL : K →ₐ[R] L) {p' : Fin r → Fin n} (hp' : StrictMono p')
    {i₀ m : Fin r} (hm : m ≠ i₀) (v : Fin n) (t : L) (N : G(k, K ⊗[R] M; K))
    (hpiv : (b.baseChange K).flagPivots N.toSubmodule = univ.image p') :
    shearLin b (p' i₀) v t
        (jKL.toLinearMap.rTensor M ((b.baseChange K).flagEchelon N.toSubmodule (p' m))) =
      jKL.toLinearMap.rTensor M ((b.baseChange K).flagEchelon N.toSubmodule (p' m)) := by
  have hp'_mem (c : Fin r) : p' c ∈ (b.baseChange K).flagPivots N.toSubmodule := by
    rw [hpiv]; exact mem_image_of_mem p' (mem_univ c)
  refine (b.baseChange L).repr.injective (Finsupp.ext fun w ↦ ?_)
  have hz0 : (b.baseChange L).repr
      (jKL.toLinearMap.rTensor M ((b.baseChange K).flagEchelon N.toSubmodule (p' m))) (p' i₀) =
      0 := by
    rw [repr_baseChange_rTensor, Basis.repr_flagEchelon (hp'_mem m) (hp'_mem i₀),
      Finsupp.single_eq_of_ne (hp'.injective.ne hm.symm), map_zero]
  simp [repr_shearLin, hz0]

/-- Each row `shearEchelonVec ... l` lies in the flag step `(Function.update p' i₀ v l).succ`. -/
private theorem shearEchelonVec_mem_flag {L : Type w} [Field L] [Algebra R L]
    (b : Basis (Fin n) R M) (jKL : K →ₐ[R] L) {p' : Fin r → Fin n} (hp' : StrictMono p')
    {i₀ : Fin r} {v : Fin n} (huv : p' i₀ < v) (hgt : ∀ l : Fin r, i₀ < l → v < p' l)
    (t : L) (N : G(k, K ⊗[R] M; K))
    (hpiv : (b.baseChange K).flagPivots N.toSubmodule = univ.image p') (l : Fin r) :
    shearEchelonVec b jKL p' i₀ v t N l ∈
      (b.baseChange L).flag (Function.update p' i₀ v l).succ := by
  let z (m : Fin r) : L ⊗[R] M :=
    jKL.toLinearMap.rTensor M ((b.baseChange K).flagEchelon N.toSubmodule (p' m))
  have hp'_mem (m : Fin r) : p' m ∈ (b.baseChange K).flagPivots N.toSubmodule := by
    rw [hpiv]; exact mem_image_of_mem p' (mem_univ m)
  have hzf (m : Fin r) {q : Fin n} (hmq : p' m < q) : (b.baseChange L).repr (z m) q = 0 := by
    rw [repr_baseChange_rTensor, ((b.baseChange K).mem_flag_iff_repr_eq_zero.mp
      (Basis.flagEchelon_mem_flag (hp'_mem m))) q (Fin.succ_le_castSucc_iff.mpr hmq), map_zero]
  rw [Basis.mem_flag_iff_repr_eq_zero]
  intro w hw
  have hpw : Function.update p' i₀ v l < w := Fin.succ_le_castSucc_iff.mp hw
  by_cases hl : l = i₀
  · subst l
    have hvw : v < w := by simpa using hpw
    simp only [shearEchelonVec, ↓reduceIte, LinearEquiv.map_smul, Finsupp.smul_apply, smul_eq_mul,
      repr_shearLin, ite_eq_right hvw.ne', add_zero]
    exact mul_eq_zero_of_right _ (hzf i₀ (huv.trans hvw))
  · have hplw : p' l < w := by simpa [Function.update_of_ne hl] using hpw
    dsimp only [shearEchelonVec]
    rw [ite_eq_right hl, shearLin_rTensor_flagEchelon_of_ne b jKL hp' hl v t N hpiv, map_sub,
      LinearEquiv.map_smul, Finsupp.sub_apply, Finsupp.smul_apply, smul_eq_mul, hzf l hplw,
      zero_sub, neg_eq_zero]
    rcases lt_or_gt_of_ne hl with hlt | hgt'
    · rw [hzf l ((hp' hlt).trans huv), zero_mul, zero_mul]
    · have hvw : v < w := (hgt l hgt').trans hplw
      rw [repr_shearLin, ite_eq_right hvw.ne', add_zero, hzf i₀ (huv.trans hvw), mul_zero]

/-- On the updated pivot positions `p'' = Function.update p' i₀ v`, the vectors `shearEchelonVec`
satisfy the reduced-echelon duality `(b.baseChange L).repr (y' l) (p'' m) = δ_{p'' l, p'' m}`. -/
private theorem repr_shearEchelonVec_update {L : Type w} [Field L] [Algebra R L]
    (b : Basis (Fin n) R M) (jKL : K →ₐ[R] L) {p' : Fin r → Fin n} (hp' : StrictMono p')
    {i₀ : Fin r} {v : Fin n} (huv : p' i₀ < v) (hgt : ∀ l : Fin r, i₀ < l → v < p' l)
    {t : L} (ht : t ≠ 0) (N : G(k, K ⊗[R] M; K))
    (hpiv : (b.baseChange K).flagPivots N.toSubmodule = univ.image p') (l m : Fin r) :
    (b.baseChange L).repr (shearEchelonVec b jKL p' i₀ v t N l)
      (Function.update p' i₀ v m) =
      Finsupp.single (Function.update p' i₀ v l) 1 (Function.update p' i₀ v m) := by
  let z (c : Fin r) : L ⊗[R] M :=
    jKL.toLinearMap.rTensor M ((b.baseChange K).flagEchelon N.toSubmodule (p' c))
  set y' := shearEchelonVec b jKL p' i₀ v t N
  have hp'_mem (c : Fin r) : p' c ∈ (b.baseChange K).flagPivots N.toSubmodule := by
    rw [hpiv]; exact mem_image_of_mem p' (mem_univ c)
  have hp'_ne_v (c : Fin r) : p' c ≠ v := by
    rcases lt_trichotomy c i₀ with hlt | rfl | hgt'
    · exact ((hp' hlt).trans huv).ne
    · exact huv.ne
    · exact (hgt c hgt').ne'
  have hyi₀ (w : Fin n) :
      (b.baseChange L).repr (y' i₀) w =
        if w = v then 1 else t⁻¹ * (b.baseChange L).repr (z i₀) w := by
    simp only [y', shearEchelonVec, ↓reduceIte, LinearEquiv.map_smul, Finsupp.smul_apply,
      smul_eq_mul, repr_shearLin]
    split_ifs with hwv
    · subst w
      have hv0 : (b.baseChange L).repr (z i₀) v = 0 := by
        rw [repr_baseChange_rTensor, ((b.baseChange K).mem_flag_iff_repr_eq_zero.mp
          (Basis.flagEchelon_mem_flag (hp'_mem i₀))) v (Fin.succ_le_castSucc_iff.mpr huv), map_zero]
      rw [hv0, repr_baseChange_rTensor, Basis.repr_flagEchelon (hp'_mem i₀) (hp'_mem i₀),
        Finsupp.single_eq_same, map_one, zero_add, mul_one, inv_mul_cancel₀ ht]
    · rw [add_zero]
  by_cases hl : l = i₀
  · subst l
    by_cases hm : m = i₀
    · subst m; simp [hyi₀]
    · rw [Function.update_of_ne hm, Function.update_self, hyi₀, ite_eq_right (hp'_ne_v m),
        repr_baseChange_rTensor, Basis.repr_flagEchelon (hp'_mem i₀) (hp'_mem m),
        Finsupp.single_eq_of_ne (hp'.injective.ne hm), map_zero, mul_zero,
        Finsupp.single_eq_of_ne (hp'_ne_v m)]
  · have hy'_sub : y' l = z l - (b.baseChange L).repr (z l) v • y' i₀ := by
      simp [y', shearEchelonVec, z, ite_eq_right hl,
        shearLin_rTensor_flagEchelon_of_ne b jKL hp' hl v t N hpiv, smul_smul]
    by_cases hm : m = i₀
    · subst m
      rw [Function.update_self, Function.update_of_ne hl, hy'_sub, map_sub, LinearEquiv.map_smul,
        Finsupp.sub_apply, Finsupp.smul_apply, hyi₀, ite_eq_left rfl, smul_eq_mul, mul_one,
        sub_self, Finsupp.single_eq_of_ne (hp'_ne_v l).symm]
    · have hzi₀_m : (b.baseChange L).repr (z i₀) (p' m) = 0 := by
        rw [repr_baseChange_rTensor, Basis.repr_flagEchelon (hp'_mem i₀) (hp'_mem m),
          Finsupp.single_eq_of_ne (hp'.injective.ne hm), map_zero]
      rw [Function.update_of_ne hm, Function.update_of_ne hl, hy'_sub, map_sub,
        LinearEquiv.map_smul, Finsupp.sub_apply, Finsupp.smul_apply, smul_eq_mul, hyi₀,
        ite_eq_right (hp'_ne_v m), hzi₀_m, mul_zero, mul_zero, sub_zero, repr_baseChange_rTensor,
        Basis.repr_flagEchelon (hp'_mem l) (hp'_mem m)]
      simp [Finsupp.single_apply, hp'.injective.eq_iff]

/-- Applying an invertible transvection `shearEquiv b _ t` (`t ≠ 0`) from `p' i₀` to `v` (with
`p' i₀ < v` and `v < p' l` for all `i₀ < l`) shifts the `i₀`-th pivot of `N` from `p' i₀` to `v`. -/
private theorem flagPivots_grassmannianCongr_shearEquiv {L : Type w} [Field L] [Algebra R L]
    (b : Basis (Fin n) R M) (jKL : K →ₐ[R] L) {p' : Fin r → Fin n} (hp' : StrictMono p')
    {i₀ : Fin r} {v : Fin n} (huv : p' i₀ < v) (hgt : ∀ l : Fin r, i₀ < l → v < p' l)
    {t : L} (ht : t ≠ 0) (N : G(k, K ⊗[R] M; K))
    (hpiv : (b.baseChange K).flagPivots N.toSubmodule = univ.image p') :
    (b.baseChange L).flagPivots
      ((shearEquiv b huv.ne t).grassmannianCongr (map jKL N)).toSubmodule =
      univ.image (Function.update p' i₀ v) := by
  set p'' := Function.update p' i₀ v
  have hp'' : StrictMono p'' := fun a c hac ↦ by
    by_cases ha : a = i₀
    · subst a; dsimp only [p'']; rw [Function.update_self, Function.update_of_ne hac.ne']
      exact hgt c hac
    · dsimp only [p'']; rw [Function.update_of_ne ha]
      by_cases hc : c = i₀
      · subst c; rw [Function.update_self]; exact (hp' hac).trans huv
      · rw [Function.update_of_ne hc]; exact hp' hac
  set y' := shearEchelonVec b jKL p' i₀ v t N
  let eS : Fin r ≃ univ.image p'' :=
    Equiv.ofBijective (fun l ↦ ⟨p'' l, mem_image_of_mem p'' (mem_univ l)⟩)
      ⟨fun _ _ h ↦ hp''.injective (Subtype.mk.inj h),
        fun ⟨_, hs⟩ ↦ by obtain ⟨l, -, rfl⟩ := mem_image.mp hs; exact ⟨l, rfl⟩⟩
  have heS (l : Fin r) : (eS l : Fin n) = p'' l :=
    congrArg Subtype.val (congrFun (Equiv.coe_ofBijective _ _) l)
  have hrange : Set.range y' = Set.range (fun s : univ.image p'' ↦ y' (eS.symm s)) :=
    Set.ext fun x ↦ ⟨fun ⟨l, hl⟩ ↦ ⟨eS l, by simpa using hl⟩, fun ⟨s, hs⟩ ↦ ⟨eS.symm s, hs⟩⟩
  rw [toSubmodule_grassmannianCongr_shearEquiv_eq_span b jKL huv ht N hpiv, hrange]
  refine Basis.flagPivots_span_eq (fun s ↦ ?_) (fun s q hq ↦ ?_)
  · obtain ⟨l, rfl⟩ := eS.surjective s
    rw [Equiv.symm_apply_apply, heS l]
    exact shearEchelonVec_mem_flag b jKL hp' huv hgt t N hpiv l
  · obtain ⟨l, rfl⟩ := eS.surjective s
    obtain ⟨m, -, rfl⟩ := mem_image.mp hq
    rw [Equiv.symm_apply_apply, heS l]
    exact repr_shearEchelonVec_update b jKL hp' huv hgt ht N hpiv l m

/-- **One-step polynomial deformation in a Schubert locus.** Let `N ∈ G(k, K ⊗[R] M; K)` over a
field `K` have pivot sequence `p' : Fin r → Fin n` with `p' ≤ p` and `p' ≠ p`. Then there exists
an `𝔸¹_K`-family `N_poly ∈ G(k, K[X] ⊗[R] M; K[X])` whose fiber at `X = 0` is `N` and whose generic
fiber over `FractionRing K[X]` has a strictly increasing pivot sequence `p'' ≤ p` with strictly
smaller gap sum `∑ i, (p i - p'' i)`. -/
theorem exists_polynomial_deformation_of_flagPivots_lt (b : Basis (Fin n) R M)
    {p p' : Fin r → Fin n} (hp : StrictMono p) (hp' : StrictMono p')
    (hle : ∀ i, p' i ≤ p i) (hne : p' ≠ p) (N : G(k, K ⊗[R] M; K))
    (hpiv : (b.baseChange K).flagPivots N.toSubmodule = univ.image p') :
    ∃ (N_poly : G(k, Polynomial K ⊗[R] M; Polynomial K)) (p'' : Fin r → Fin n),
      StrictMono p'' ∧ (∀ i, p'' i ≤ p i) ∧
      ∑ i, ((p i : ℕ) - p'' i) < ∑ i, ((p i : ℕ) - p' i) ∧
      map ((Polynomial.aeval (0 : K)).restrictScalars R) N_poly = N ∧
      (b.baseChange (FractionRing (Polynomial K))).flagPivots
        (map (IsScalarTower.toAlgHom R (Polynomial K) (FractionRing (Polynomial K)))
          N_poly).toSubmodule = univ.image p'' := by
  obtain ⟨i₀, v, hv_val, hp'', hp''_le, hgt, hsum⟩ :=
    exists_update_succ_strictMono hp hp' hle hne
  have huv : p' i₀ < v := Fin.lt_def.mpr (by omega)
  let P := Polynomial K
  let L := FractionRing P
  let jKP : K →ₐ[R] P := IsScalarTower.toAlgHom R K P
  let ι : P →ₐ[R] L := IsScalarTower.toAlgHom R P L
  let N_poly : G(k, P ⊗[R] M; P) :=
    (shearEquiv b huv.ne Polynomial.X).grassmannianCongr (map jKP N)
  refine ⟨N_poly, Function.update p' i₀ v, hp'', hp''_le, hsum, ?_, ?_⟩
  · let ev₀ : P →ₐ[R] K := (Polynomial.aeval (0 : K)).restrictScalars R
    have hevX : ev₀ Polynomial.X = 0 := by
      rw [AlgHom.restrictScalars_apply, Polynomial.aeval_X]
    have hev_comp : ev₀.comp jKP = AlgHom.id R K := AlgHom.ext fun c ↦ by simp [ev₀, jKP]
    rw [map_grassmannianCongr_shearEquiv, hevX, ← map_comp, hev_comp, map_id k (.of R K)]
    ext : 1
    simp [shearEquiv, shearLin]
  · have ht : ι Polynomial.X ≠ 0 :=
      (map_ne_zero_iff ι (IsFractionRing.injective P L)).mpr Polynomial.X_ne_zero
    rw [map_grassmannianCongr_shearEquiv, ← map_comp]
    exact flagPivots_grassmannianCongr_shearEquiv b (ι.comp jKP) hp' huv hgt ht N hpiv

end Field

end Module.Grassmannian
