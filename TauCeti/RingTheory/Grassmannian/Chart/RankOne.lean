module

public import TauCeti.RingTheory.Grassmannian.Chart.Transition
public import TauCeti.LinearAlgebra.SymmetricAlgebra.HomogeneousLocalization

/-!
# Rank-one charts of the Grassmannian are standard charts of `Proj (Sym M)`

Let `M` be a module over a commutative ring `R` and `x ∈ M`. The chart of the rank-one Grassmannian
`G(1, M)` at `x` has coordinate ring `C_x = Module.Grassmannian.ChartAlgebra R (fun _ : Fin 1 ↦ x)`,
whose `R`-algebra maps to `A` are the linear forms `ψ : M → A` with `ψ x = 1`
(`Module.Grassmannian.ChartAlgebra.homEquiv`). The standard chart `D₊(x)` of the projective spectrum
`Proj (Sym M)` of the symmetric algebra, graded by
`TauCeti.SymmetricAlgebra.homogeneousSubmodule R M`, has coordinate ring the homogeneous
localization `Sym(M)_(x)`, the degree-zero part of
`Sym(M)[1/x]`, generated by the fractions `m / x`. The two rings are the same:

`Module.Grassmannian.ChartAlgebra.awayEquiv R x : C_x ≃ₐ[R] Sym(M)_(x)`

sends the universal linear form `m ↦ ψ m` to `m ↦ m / x`
(`Module.Grassmannian.ChartAlgebra.awayEquiv_universalLinearMap`) and the value of `a ∈ Sym M` of
degree `n` at the universal linear form to `a / xⁿ`
(`Module.Grassmannian.ChartAlgebra.awayEquiv_evalUniversal`); its inverse sends a fraction
`a / xⁿ` to the value of `a` at the universal linear form
(`Module.Grassmannian.ChartAlgebra.awayEquiv_symm_mk`). This is the chart-by-chart identification of
the rank-one Grassmannian with the projective spectrum of the symmetric algebra, with the chart at
`x` corresponding to `D₊(x)`.

The inverse is `HomogeneousLocalization.Away.lift` of the evaluation `Sym M → C_x` at the universal
linear form, which inverts `x` (`Module.Grassmannian.ChartAlgebra.awayEquiv_symm_toRingHom`).
That the two composites are identities is checked on the universal linear form
(`Module.Grassmannian.ChartAlgebra.hom_ext`) and on fractions `a / xⁿ` with `a` homogeneous of
degree `n`, where the evaluation at `m ↦ m / x` is `a / xⁿ`
(`AlgHom.apply_awayMk_eq_lift`).

On the overlap `O_xy = Module.Grassmannian.OverlapAlgebra` of the charts at `x` and `y`, the
rank-one transition determinant is the value `u_x(y)` of the universal linear form of the chart at
`x` (`Module.Grassmannian.ChartAlgebra.transitionDet_rankOne`), a unit of `O_xy`. The value of
`a ∈ Sym M` of degree `n` at the universal linear form of the chart at `x` is `u_x(y)ⁿ` times its
value at that of the chart at `y`, carried along the transition isomorphism
(`Module.Grassmannian.ChartAlgebra.algebraMap_evalUniversal_eq_pow_mul_transitionAlgEquiv`).
-/

public section

universe u v

open TauCeti.SymmetricAlgebra HomogeneousLocalization

namespace Module.Grassmannian.ChartAlgebra

variable (R : Type u) [CommRing R] {M : Type v} [AddCommGroup M] [Module R M] (x : M)

/-- The evaluation `Sym M → ChartAlgebra R (fun _ : Fin 1 ↦ x)` of the symmetric algebra at the
universal linear form of the chart at `x`. -/
noncomputable def evalUniversal :
    SymmetricAlgebra R M →ₐ[R] ChartAlgebra R (fun _ : Fin 1 ↦ x) :=
  SymmetricAlgebra.lift
    (LinearMap.proj (R := R) (φ := fun _ : Fin 1 ↦ ChartAlgebra R (fun _ : Fin 1 ↦ x)) 0 ∘ₗ
      universalLinearMap R (fun _ : Fin 1 ↦ x))

@[simp]
theorem evalUniversal_ι (m : M) :
    evalUniversal R x (SymmetricAlgebra.ι R M m) =
      universalLinearMap R (fun _ : Fin 1 ↦ x) m 0 := by
  simp [evalUniversal]

/-- The universal linear form of the chart at `x` takes the value `1` at `x`. -/
@[simp]
theorem universalLinearMap_self_zero : universalLinearMap R (fun _ : Fin 1 ↦ x) x 0 = 1 := by
  rw [universalLinearMap_apply_self R (fun _ : Fin 1 ↦ x) 0, Pi.single_eq_same]

/-- The map `ChartAlgebra R (fun _ : Fin 1 ↦ x) → Sym(M)_(x)` classifying the linear form
`m ↦ m / x`. -/
private noncomputable def toAway :
    ChartAlgebra R (fun _ : Fin 1 ↦ x) →ₐ[R]
      Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x) :=
  (homEquiv R (fun _ : Fin 1 ↦ x)).symm
    ⟨LinearMap.pi fun _ ↦ awayLinearMap R x, fun i ↦ by
      ext j
      rw [Subsingleton.elim i 0, Subsingleton.elim j 0]
      simp⟩

private theorem toAway_universalLinearMap (m : M) (j : Fin 1) :
    toAway R x (universalLinearMap R (fun _ : Fin 1 ↦ x) m j) = awayLinearMap R x m := by
  simp [toAway]

/-- The map `Sym(M)_(x) → ChartAlgebra R (fun _ : Fin 1 ↦ x)` sending `a / xⁿ` to the value of
`a` at the universal linear form. -/
private noncomputable def ofAway :
    Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x) →ₐ[R]
      ChartAlgebra R (fun _ : Fin 1 ↦ x) :=
  AlgHom.mk (Away.lift (homogeneousSubmodule R M) (evalUniversal R x).toRingHom (by simp))
    fun r ↦ by
      rw [algebraMap_eq_comp, RingHom.comp_apply]
      exact (Away.lift_algebraMap _ _ _).trans ((evalUniversal R x).commutes r)

private theorem ofAway_mk (n : ℕ) (a : SymmetricAlgebra R M)
    (ha : a ∈ homogeneousSubmodule R M (n • 1)) :
    ofAway R x (Away.mk (homogeneousSubmodule R M) (ι_mem_homogeneousSubmodule R M x) n a ha) =
      evalUniversal R x a := by
  simp only [ofAway, AlgHom.coe_mk, Away.lift_mk]
  simp

/-- `ofAway` is a left inverse of `toAway`. -/
private theorem ofAway_comp_toAway :
    (ofAway R x).comp (toAway R x) = AlgHom.id R (ChartAlgebra R (fun _ : Fin 1 ↦ x)) := by
  refine hom_ext R _ fun m j ↦ ?_
  rw [Subsingleton.elim j 0, AlgHom.comp_apply, toAway_universalLinearMap, awayLinearMap_apply,
    ofAway_mk, evalUniversal_ι, AlgHom.id_apply]

/-- `toAway` after the evaluation at the universal linear form is the evaluation at the linear
form `m ↦ m / x`. -/
private theorem toAway_comp_evalUniversal :
    (toAway R x).comp (evalUniversal R x) = SymmetricAlgebra.lift (awayLinearMap R x) :=
  SymmetricAlgebra.algHom_ext (LinearMap.ext fun m ↦ by simp [toAway_universalLinearMap])

/-- The value of `a ∈ Sym M` of degree `n` at the linear form `m ↦ m / x` is `a / xⁿ`. -/
private theorem toAway_evalUniversal {n : ℕ} {a : SymmetricAlgebra R M}
    (ha : a ∈ homogeneousSubmodule R M (n • 1)) :
    toAway R x (evalUniversal R x a) =
      Away.mk (homogeneousSubmodule R M) (ι_mem_homogeneousSubmodule R M x) n a ha := by
  rw [← AlgHom.comp_apply, toAway_comp_evalUniversal]
  exact ((AlgHom.id R _).apply_awayMk_eq_lift (awayLinearMap R x) (fun m ↦ by simp)
    (by simpa using ha)).symm

/-- `toAway` is a left inverse of `ofAway`. -/
private theorem toAway_comp_ofAway :
    (toAway R x).comp (ofAway R x) =
      AlgHom.id R (Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x)) := by
  refine AlgHom.ext fun z ↦ ?_
  obtain ⟨n, a, ha, rfl⟩ :=
    Away.mk_surjective (homogeneousSubmodule R M) (ι_mem_homogeneousSubmodule R M x) z
  rw [AlgHom.comp_apply, ofAway_mk, toAway_evalUniversal, AlgHom.id_apply]

/-- **The rank-one chart of the Grassmannian is a standard chart of `Proj (Sym M)`.** The
coordinate ring of the chart of `G(1, M)` at `x` is the homogeneous localization `Sym(M)_(x)`, the
coordinate ring of the standard chart `D₊(x)` of `Proj (Sym M)`, the universal linear form being
`m ↦ m / x`. -/
noncomputable def awayEquiv :
    ChartAlgebra R (fun _ : Fin 1 ↦ x) ≃ₐ[R]
      Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x) :=
  AlgEquiv.ofAlgHom (toAway R x) (ofAway R x) (toAway_comp_ofAway R x) (ofAway_comp_toAway R x)

/-- `awayEquiv` sends the universal linear form to `m ↦ m / x`. -/
@[simp]
theorem awayEquiv_universalLinearMap (m : M) (j : Fin 1) :
    awayEquiv R x (universalLinearMap R (fun _ : Fin 1 ↦ x) m j) =
      Away.mk (homogeneousSubmodule R M) (ι_mem_homogeneousSubmodule R M x) 1
        (SymmetricAlgebra.ι R M m) (ι_mem_homogeneousSubmodule_one_smul R M m) :=
  (toAway_universalLinearMap R x m j).trans (awayLinearMap_apply R x m)

/-- `awayEquiv` sends the value of `a ∈ Sym M` of degree `n` at the universal linear form to
`a / xⁿ`. -/
theorem awayEquiv_evalUniversal {n : ℕ} {a : SymmetricAlgebra R M}
    (ha : a ∈ homogeneousSubmodule R M (n • 1)) :
    awayEquiv R x (evalUniversal R x a) =
      Away.mk (homogeneousSubmodule R M) (ι_mem_homogeneousSubmodule R M x) n a ha :=
  toAway_evalUniversal R x ha

/-- The inverse of `awayEquiv` sends `a / xⁿ` to the value of `a` at the universal linear form. -/
@[simp]
theorem awayEquiv_symm_mk (n : ℕ) (a : SymmetricAlgebra R M)
    (ha : a ∈ homogeneousSubmodule R M (n • 1)) :
    (awayEquiv R x).symm
        (Away.mk (homogeneousSubmodule R M) (ι_mem_homogeneousSubmodule R M x) n a ha) =
      evalUniversal R x a :=
  ofAway_mk R x n a ha

/-- The inverse of `awayEquiv` is `HomogeneousLocalization.Away.lift` of the evaluation at the
universal linear form. -/
theorem awayEquiv_symm_toRingHom :
    (awayEquiv R x).symm.toRingHom =
      Away.lift (homogeneousSubmodule R M) (evalUniversal R x).toRingHom (by simp) :=
  (rfl)

/-- In rank one, the transition determinant from the chart at `x` to `y` is the value `u_x(y)` of
the universal linear form of the chart at `x`. -/
theorem transitionDet_rankOne (y : M) :
    transitionDet R (fun _ : Fin 1 ↦ x) (fun _ : Fin 1 ↦ y) =
      universalLinearMap R (fun _ : Fin 1 ↦ x) y 0 := by
  rw [transitionDet_def, Matrix.det_fin_one, transitionMatrix_apply]

/-- The value `u_x(y)` of the universal linear form of the chart at `x` is a unit on the overlap
of the charts at `x` and `y`. -/
theorem isUnit_algebraMap_universalLinearMap (y : M) :
    IsUnit (algebraMap (ChartAlgebra R (fun _ : Fin 1 ↦ x))
      (OverlapAlgebra R (fun _ : Fin 1 ↦ x) (fun _ : Fin 1 ↦ y))
      (universalLinearMap R (fun _ : Fin 1 ↦ x) y 0)) := by
  rw [← transitionDet_rankOne]
  exact IsLocalization.Away.algebraMap_isUnit _

/-- **The rank-one transition rescales homogeneous coordinates.** On the overlap of the charts at
`x` and `y`, the value of `a ∈ Sym M` of degree `n` at the universal linear form of the chart at
`x` is `u_x(y)ⁿ` times its value at the universal linear form of the chart at `y`, carried along
the transition isomorphism. -/
theorem algebraMap_evalUniversal_eq_pow_mul_transitionAlgEquiv (y : M) {n : ℕ}
    {a : SymmetricAlgebra R M} (ha : a ∈ homogeneousSubmodule R M n) :
    algebraMap (ChartAlgebra R (fun _ : Fin 1 ↦ x))
        (OverlapAlgebra R (fun _ : Fin 1 ↦ x) (fun _ : Fin 1 ↦ y)) (evalUniversal R x a) =
      algebraMap (ChartAlgebra R (fun _ : Fin 1 ↦ x))
          (OverlapAlgebra R (fun _ : Fin 1 ↦ x) (fun _ : Fin 1 ↦ y))
          (universalLinearMap R (fun _ : Fin 1 ↦ x) y 0) ^ n *
        transitionAlgEquiv R (fun _ : Fin 1 ↦ x) (fun _ : Fin 1 ↦ y)
          (algebraMap (ChartAlgebra R (fun _ : Fin 1 ↦ y))
            (OverlapAlgebra R (fun _ : Fin 1 ↦ y) (fun _ : Fin 1 ↦ x)) (evalUniversal R y a)) := by
  induction ha using Submodule.pow_induction_on_left' with
  | algebraMap r => simp [← IsScalarTower.algebraMap_apply]
  | add a b i _ _ iha ihb => simp only [map_add, iha, ihb, mul_add]
  | mem_mul c hc i a _ ih =>
    obtain ⟨m, rfl⟩ := hc
    -- in degree one, this is the transition formula for the universal linear forms
    have h1 := congrFun (transitionMatrix_mulVec_transitionAlgEquiv (R := R) (fun _ : Fin 1 ↦ x)
      (fun _ : Fin 1 ↦ y) m) 0
    simp only [Matrix.mulVec, dotProduct, Finset.univ_unique, Finset.sum_singleton,
      RingHom.mapMatrix_apply, Matrix.map_apply, transitionMatrix_apply] at h1
    rw [map_mul, map_mul, ih, evalUniversal_ι, map_mul, map_mul, map_mul, evalUniversal_ι, ← h1,
      Fin.default_eq_zero, pow_succ]
    ring

end Module.Grassmannian.ChartAlgebra
