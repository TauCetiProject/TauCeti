module

public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.IsTensorProduct

/-!
# Subalgebras generated by a base change of a submodule

If a submodule `K'` of an `R'`-algebra `A'` is a base change to `R'` of a submodule `K` of an
`R`-algebra `A`, compatibly with `A → A'`, then `K'` lies in the `R'`-subalgebra generated by the
image of any set containing `K`.

## Main results

* `Submodule.mem_adjoin_image_of_isBaseChange`: the elements of `K'` lie in the `R'`-subalgebra
  generated by the image of a set containing `K`.
-/

public section

open Algebra

namespace Submodule

/-- If `h : K →ₗ[R] K'` is a base change to `R'` of a submodule `K` of an `R`-algebra `A` into an
`R'`-submodule `K'` of `A'`, compatible with `A → A'`, and `K` lies in `S`, then every element of
`K'` lies in the `R'`-subalgebra generated by the image of `S`. -/
theorem mem_adjoin_image_of_isBaseChange {R A R' A' : Type*} [CommSemiring R] [CommSemiring A]
    [CommSemiring R'] [CommSemiring A'] [Algebra R A] [Algebra R R'] [Algebra R' A']
    [Algebra A A'] (K : Submodule R A) {S : Set A} (hKS : (K : Set A) ⊆ S)
    {K' : Submodule R' A'} [Module R K'] [IsScalarTower R R' K'] (h : K →ₗ[R] K')
    (hbc : IsBaseChange R' h) (hh : ∀ x, (h x : A') = algebraMap A A' x) (n : K') :
    (n : A') ∈ adjoin R' (algebraMap A A' '' S) := by
  induction n using hbc.inductionOn with
  | tmul a => exact hh a ▸ subset_adjoin ⟨a, hKS a.2, rfl⟩
  | smul r n hn => exact Subalgebra.smul_mem _ hn r
  | add n₁ n₂ h₁ h₂ => exact Subalgebra.add_mem _ h₁ h₂

end Submodule
