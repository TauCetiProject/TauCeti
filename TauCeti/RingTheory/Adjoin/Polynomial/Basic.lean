module

public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-!
# Spans over the algebra generated by one element

The subalgebra `R[F]` generated by a single element `F` is the range of evaluation at `F`
(`Algebra.adjoin_singleton_eq_range_aeval`). Hence an `R[F]`-linear combination of a finite
family is a sum of polynomials in `F` applied to its members.

## Main results

* `TauCeti.Algebra.mem_span_range_iff_exists_aeval`: `x` lies in the `R[F]`-span of a finite
  family `v` if and only if `x = ∑ i, u i (F) • v i` for some polynomials `u i`.
-/

public section

namespace TauCeti.Algebra

open Polynomial

variable {R B N : Type*} [CommSemiring R] [Semiring B] [Algebra R B] [AddCommMonoid N]
  [Module B N] {F : B}

/-- **Spans over `R[F]`.** An element lies in the `R[F]`-span of a finite family `v` if and only if
it is `∑ i, u i (F) • v i` for some polynomials `u i` over `R`. Compare
`Submodule.mem_span_range_iff_exists_fun`, which gives the coefficients in `R[F]` itself. -/
theorem mem_span_range_iff_exists_aeval {ι : Type*} [Fintype ι] {v : ι → N} {x : N} :
    x ∈ Submodule.span (Algebra.adjoin R {F}) (Set.range v) ↔
      ∃ u : ι → R[X], ∑ i, aeval F (u i) • v i = x := by
  have hmem (b : B) : b ∈ Algebra.adjoin R {F} ↔ ∃ p : R[X], aeval F p = b := by
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range]
  rw [Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨c, rfl⟩
    choose u hu using fun i ↦ (hmem (c i)).mp (c i).2
    exact ⟨u, Finset.sum_congr rfl fun i _ ↦ by rw [hu, Subalgebra.smul_def]⟩
  · rintro ⟨u, rfl⟩
    exact ⟨fun i ↦ ⟨aeval F (u i), (hmem _).mpr ⟨u i, rfl⟩⟩, rfl⟩

end TauCeti.Algebra
