module

public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Adjoin.Polynomial.Basic
public import TauCeti.RingTheory.Adjoin.Basic

/-!
# Spans over the algebra generated by one element

The subalgebra `R[F]` generated by a single element `F` is the range of evaluation at `F`
(`Algebra.adjoin_singleton_eq_range_aeval`). Hence an `R[F]`-linear combination of a finite
family is a sum of polynomials in `F` applied to its members.

If `A = R[c]`, a finitely generated `A`-submodule whose elements are killed by powers of `c` is
finitely generated over `R`.

## Main results

* `TauCeti.Algebra.mem_span_range_iff_exists_aeval`: `x` lies in the `R[F]`-span of a finite
  family `v` if and only if `x = ∑ i, u i (F) • v i` for some polynomials `u i`.
* `TauCeti.Algebra.fg_restrictScalars_of_forall_pow_smul_eq_zero`: over `A = R[c]`, a finitely
  generated `A`-submodule whose elements are killed by powers of `c` is finitely generated over
  `R`.
-/

public section

namespace TauCeti.Algebra

open Polynomial

variable {R B N : Type*} [CommSemiring R] [Semiring B] [Algebra R B] [AddCommMonoid N]
  [Module B N] {F : B}

/-- **Spans over `R[F]`.** An element lies in the `R[F]`-span of a finite family `v` if and only if
it is `∑ i, u i (F) • v i` for some polynomials `u i` over `R`. Compare
`Submodule.mem_span_range_iff_exists_fun`, which gives the coefficients in `R[F]` itself. -/
theorem mem_span_range_iff_exists_aeval {ι : Type*} [Fintype ι] {v : ι → N} {x : N} :
    x ∈ Submodule.span (Algebra.adjoin R {F}) (Set.range v) ↔
      ∃ u : ι → R[X], ∑ i, aeval F (u i) • v i = x := by
  have hmem (b : B) : b ∈ Algebra.adjoin R {F} ↔ ∃ p : R[X], aeval F p = b := by
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range]
  rw [Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨c, rfl⟩
    choose u hu using fun i ↦ (hmem (c i)).mp (c i).property
    exact ⟨u, Finset.sum_congr rfl fun i _ ↦ by rw [hu, Subalgebra.smul_def]⟩
  · rintro ⟨u, rfl⟩
    exact ⟨fun i ↦ ⟨aeval F (u i), (hmem _).mpr ⟨u i, rfl⟩⟩, rfl⟩

section Torsion

variable {A : Type*} [Semiring A] [Algebra R A] [Module R N] [Module A N] [IsScalarTower R A N]
  {c : A}

/-- **Finiteness of torsion over `R[c]`.** Let `A = R[c]` be generated as an `R`-algebra by a
single element `c`. A finitely generated `A`-submodule of an `A`-module whose elements are killed
by powers of `c` is finitely generated over `R`: it is spanned by the `cʲ • y` with `y` running
over its generators and `j` below the exponent killing `y`. -/
theorem fg_restrictScalars_of_forall_pow_smul_eq_zero (hc : Algebra.adjoin R {c} = ⊤)
    {K : Submodule A N} (hK : K.FG) (htors : ∀ y ∈ K, ∃ k : ℕ, c ^ k • y = 0) :
    (K.restrictScalars R).FG := by
  classical
  obtain ⟨t, rfl⟩ := hK
  choose! k hk using fun y (hy : y ∈ t) ↦ htors y (Submodule.subset_span hy)
  -- the `cʲ • y` with `y ∈ t` and `j ≤ k y`
  let T : Submodule R N := Submodule.span R
    ((fun p : ℕ × N ↦ c ^ p.1 • p.2) '' {p | p.2 ∈ t ∧ p.1 ≤ k p.2})
  have hfin : {p : ℕ × N | p.2 ∈ t ∧ p.1 ≤ k p.2}.Finite :=
    ((Set.finite_Iic (t.sup k)).prod t.finite_toSet).subset fun p ⟨hp, hpk⟩ ↦
      ⟨hpk.trans (Finset.le_sup hp), hp⟩
  -- `T` is stable under `c`, hence under `R[c] = A`
  have hcT : ∀ x ∈ T, c • x ∈ T := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨⟨j, y⟩, ⟨hy, hj⟩, rfl⟩ := hx
      dsimp only at hy hj ⊢
      rcases hj.lt_or_eq with h | rfl
      · rw [← mul_smul, ← pow_succ']
        exact Submodule.subset_span ⟨(j + 1, y), ⟨hy, Nat.add_one_le_of_lt h⟩, rfl⟩
      · rw [hk y hy, smul_zero]
        exact T.zero_mem
    | zero => rw [smul_zero]; exact T.zero_mem
    | add x x' _ _ h h' => rw [smul_add]; exact T.add_mem h h'
    | smul r x _ h => rw [smul_comm]; exact T.smul_mem r h
  have heq : (Submodule.span A (t : Set N)).restrictScalars R = T := by
    refine le_antisymm (fun x hx ↦ ?_) (Submodule.span_le.mpr ?_)
    · induction hx using Submodule.span_induction with
      | mem y hy => exact Submodule.subset_span ⟨(0, y), ⟨hy, Nat.zero_le _⟩, by simp⟩
      | zero => exact T.zero_mem
      | add _ _ _ _ h h' => exact T.add_mem h h'
      | smul a x _ h =>
        exact smul_mem_of_mem_adjoin (by simpa using hcT) (hc ▸ Algebra.mem_top) h
    · rintro _ ⟨⟨j, y⟩, ⟨hy, -⟩, rfl⟩
      exact Submodule.smul_mem _ _ (Submodule.subset_span hy)
  exact heq ▸ Submodule.fg_span (hfin.image _)

end Torsion

end TauCeti.Algebra
