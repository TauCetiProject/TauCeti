module

public import Mathlib.RingTheory.Adjoin.Basic

/-!
# Algebras generated by images of equalizers

Let `f g : A →+* B` and `f' g' : A' →+* B'` be two pairs of ring homomorphisms, related by maps
`φ : A →+* A'` and `ψ : B →+* B'` with `f' ∘ φ = ψ ∘ f` and `g' ∘ φ = ψ ∘ g`. Then `φ` carries the
equalizer `{a : f a = g a}` into the equalizer `{a' : f' a' = g' a'}`. If moreover `A'` is an
`R`-algebra on which `f'` and `g'` agree, the `R`-subalgebra generated by this image still lies in
the equalizer. This is the inclusion of the invariants of a base change into the invariants of the
base-changed relation, which needs no flatness.

## Main declarations

* `RingHom.adjoin_image_eqLocus_subset`: the `R`-subalgebra generated by the image of an
  equalizer lies in the target equalizer.
-/

public section

namespace RingHom

variable {R A B A' B' : Type*} [CommSemiring R] [Ring A] [Semiring B] [Ring A'] [Semiring B']
  [Algebra R A'] {f g : A →+* B} {f' g' : A' →+* B'} {φ : A →+* A'} {ψ : B →+* B'}

/-- If `f' ∘ φ = ψ ∘ f` and `g' ∘ φ = ψ ∘ g`, and `f'` and `g'` agree on `R`, then the
`R`-subalgebra generated by the image under `φ` of the equalizer of `f` and `g` lies in the
equalizer of `f'` and `g'`. -/
theorem adjoin_image_eqLocus_subset (hf : f'.comp φ = ψ.comp f) (hg : g'.comp φ = ψ.comp g)
    (hR : f'.comp (algebraMap R A') = g'.comp (algebraMap R A')) :
    (Algebra.adjoin R (φ '' f.eqLocus g) : Set A') ⊆ f'.eqLocus g' := by
  intro x hx
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    rw [SetLike.mem_coe, mem_eqLocus, ← comp_apply, hf, comp_apply, mem_eqLocus.mp ha,
      ← comp_apply, ← hg, comp_apply]
  | algebraMap r => exact congr($hR r)
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy => exact mul_mem hx hy

end RingHom
