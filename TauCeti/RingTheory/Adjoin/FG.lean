module

public import Mathlib.RingTheory.Adjoin.FG

import Mathlib.Algebra.Algebra.Subalgebra.Directed

/-!
# Finite subsets generating `Algebra.adjoin`

Every element of the subalgebra `Algebra.adjoin R s` generated by a subset `s` of a (not
necessarily commutative) `R`-algebra `A` already belongs to `Algebra.adjoin R t` for some finite
subset `t ⊆ s`. Consequently, `Algebra.adjoin R s` is finitely generated as an `R`-subalgebra if
and only if it coincides with `Algebra.adjoin R t` for some finite subset `t ⊆ s`. These are the
subalgebra counterparts of `Submodule.mem_span_iff_exists_finset_subset` and
`Submodule.fg_span_iff_fg_span_finset_subset`.

## Main results

* `TauCeti.mem_adjoin_iff_exists_finset_subset`: `x ∈ Algebra.adjoin R s` if and only if
  `x ∈ Algebra.adjoin R t` for some `t : Finset A` with `(t : Set A) ⊆ s`.
* `TauCeti.fg_adjoin_iff_exists_finset_subset_adjoin_eq`: `(Algebra.adjoin R s).FG` if and only if
  `Algebra.adjoin R t = Algebra.adjoin R s` for some `t : Finset A` with `(t : Set A) ⊆ s`.
-/

public section

namespace TauCeti

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R A]

/-- An element belongs to `Algebra.adjoin R s` if and only if it belongs to `Algebra.adjoin R t`
for some finite subset `t` of `s`. -/
theorem mem_adjoin_iff_exists_finset_subset {s : Set A} {x : A} :
    x ∈ Algebra.adjoin R s ↔
      ∃ t : Finset A, (t : Set A) ⊆ s ∧ x ∈ Algebra.adjoin R (t : Set A) where
  mp hx := by
    classical
    have hs : s = ⋃ y : s, {y.val} := by ext; simp
    rw [hs, Algebra.adjoin_iUnion, ← SetLike.mem_coe,
      Subalgebra.coe_iSup_eq_iUnion_finset_coe_biSup, Set.mem_iUnion] at hx
    obtain ⟨u, hxu⟩ := hx
    refine ⟨u.image Subtype.val, by simp, ?_⟩
    exact (iSup₂_le fun y hy ↦ Algebra.adjoin_mono <| by
      simpa using Finset.mem_image_of_mem Subtype.val hy) hxu
  mpr := by
    rintro ⟨t, hts, hxt⟩
    exact Algebra.adjoin_mono hts hxt

/-- The subalgebra `Algebra.adjoin R s` is finitely generated if and only if it is generated by a
finite subset of `s`. -/
theorem fg_adjoin_iff_exists_finset_subset_adjoin_eq {s : Set A} :
    (Algebra.adjoin R s).FG ↔
      ∃ t : Finset A, (t : Set A) ⊆ s ∧ Algebra.adjoin R (t : Set A) = Algebra.adjoin R s where
  mp := by
    rintro ⟨T, hT⟩
    classical
    choose u hus htu using fun t : T ↦
      mem_adjoin_iff_exists_finset_subset.1 (hT ▸ Algebra.subset_adjoin t.property)
    have hsub : ((T.attach.biUnion u : Finset A) : Set A) ⊆ s := by
      intro x hx
      obtain ⟨a, -, hxa⟩ := Finset.mem_biUnion.1 (Finset.mem_coe.1 hx)
      exact hus a hxa
    refine ⟨T.attach.biUnion u, hsub, le_antisymm (Algebra.adjoin_mono hsub) ?_⟩
    rw [Algebra.adjoin_attach_biUnion, ← hT, Algebra.adjoin_le_iff]
    exact fun x hx ↦ le_iSup (fun t : T ↦ Algebra.adjoin R (u t : Set A)) ⟨x, hx⟩ (htu ⟨x, hx⟩)
  mpr := by
    rintro ⟨t, -, ht⟩
    exact ⟨t, ht⟩

end TauCeti
