module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Submodules stable under the generators of a subalgebra

Let `B` be an `R`-algebra acting on a module `N` compatibly with `R`. An `R`-submodule of `N` that
is stable under multiplication by every element of a set `s ⊆ B` is stable under multiplication by
every element of the subalgebra `Algebra.adjoin R s` generated by `s`.

## Main results

* `TauCeti.Algebra.smul_mem_of_mem_adjoin`: an `R`-submodule stable under `s` is stable under
  `Algebra.adjoin R s`.
-/

public section

namespace TauCeti.Algebra

variable {R B N : Type*} [CommSemiring R] [Semiring B] [Algebra R B] [AddCommMonoid N]
  [Module R N] [Module B N] [IsScalarTower R B N]

/-- An `R`-submodule of a `B`-module that is stable under multiplication by every element of a set
`s` is stable under multiplication by every element of the subalgebra `Algebra.adjoin R s`. -/
theorem smul_mem_of_mem_adjoin {s : Set B} {P : Submodule R N}
    (hP : ∀ f ∈ s, ∀ x ∈ P, f • x ∈ P) {b : B} (hb : b ∈ Algebra.adjoin R s) {x : N}
    (hx : x ∈ P) : b • x ∈ P := by
  induction hb using Algebra.adjoin_induction generalizing x with
  | mem y hy => exact hP y hy x hx
  | algebraMap a => rw [algebraMap_smul]; exact P.smul_mem a hx
  | add y z _ _ hy hz => rw [add_smul]; exact P.add_mem (hy hx) (hz hx)
  | mul y z _ _ hy hz => rw [mul_smul]; exact hy (hz hx)

end TauCeti.Algebra
