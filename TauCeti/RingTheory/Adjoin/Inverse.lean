/-!
# The algebra generated by an element and its inverse

If `F * G = 1` in a commutative `R`-algebra, every monomial `Fⁱ Gʲ` is `Fⁱ⁻ʲ` or `Gʲ⁻ⁱ`. Hence the
subalgebra `R[F, G]` is, as an `R`-submodule, the sum of `R[F]` and `R[G]`: every element of
`R[F, G]` is a polynomial in `F` plus a polynomial in `G`. This is the decomposition of a Laurent
polynomial into its parts of nonnegative and of negative degree, for the image of `R[T, T⁻¹]`
under `T ↦ F`.

The same decomposition controls modules over `R[F, G]`. Let `N` be a finitely generated module
over an `R`-algebra `B = R[F, G]`, with generators `S`, and let `P` and `Q` be `R`-submodules of
`N` stable under `F` and under `G` respectively, with `S ⊆ Q` and `F ^ k • S ⊆ P` for some `k`.
Then `N` is `P + Q` up to the finitely many `F ^ i • n` with `i < k` and `n ∈ S`, so `N / (P + Q)`
is a finitely generated `R`-module. This is the algebraic content of the finiteness of the first
Čech cohomology of a quasi-coherent sheaf of finite type on the projective line, covered by the
charts `Spec R[F]` and `Spec R[G]` with overlap `Spec R[F, F⁻¹]`: there `P` and `Q` are the
sections over the two charts, restricted to the overlap.

Dually, when `R` is Noetherian, the elements of `N` that are both `R[F]`-linear and
`R[G]`-linear combinations of a finite set `S` form a finitely generated `R`-module. An element of
both kinds is `∑ uᵢ(F) • sᵢ = ∑ vᵢ(G) • sᵢ` for polynomials `uᵢ` and `vᵢ`. Multiplying by a
power `Fᵐ` that clears the denominators of the `vᵢ(G) = vᵢ(F⁻¹)` gives a relation among the
`sᵢ` with polynomial coefficients in `F`, whose part of degree at least `m` recovers the `uᵢ` up
to constants. The relations form a finitely generated module over the Noetherian ring `R[X]`,
so the parts of high degree of all relations lie in a single finitely generated `R`-module. On
the projective line this bounds the global sections of a quasi-coherent sheaf of finite type by
their restrictions to the two charts.

## Main results

* `TauCeti.Algebra.toSubmodule_adjoin_pair_eq_sup_of_mul_eq_one`: if `F * G = 1`, then
  `R[F, G] = R[F] + R[G]` as `R`-submodules.
* `TauCeti.Algebra.finite_quotient_sup_of_mul_eq_one`: if `F * G = 1` and `R[F, G] = B`, then
  `N / (P + Q)` is a finite `R`-module, for `P` and `Q` as above.
* `TauCeti.Algebra.fg_inf_of_mul_eq_one`: if `F * G = 1` and `R` is Noetherian, the
  intersection of the `R[F]`-span and the `R[G]`-span of a finite set is a finitely generated
  `R`-module.
-/

public section

namespace TauCeti.Algebra

section Semiring

variable {R B : Type*} [CommSemiring R] [CommSemiring B] [Algebra R B] {F G : B}

/-- **An algebra generated by an element and an inverse.** If `F * G = 1`, the subalgebra
`R[F, G]` is, as an `R`-submodule, the sum of `R[F]` and `R[G]`: every element of `R[F, G]` is an
element of `R[F]` plus an element of `R[G]`. Compare `Algebra.adjoin_union_coe_submodule`, which
for arbitrary `F` and `G` describes the same submodule as the product `R[F] * R[G]`. -/
theorem toSubmodule_adjoin_pair_eq_sup_of_mul_eq_one (hFG : F * G = 1) :
    Subalgebra.toSubmodule (Algebra.adjoin R {F, G}) =
      Subalgebra.toSubmodule (Algebra.adjoin R {F}) ⊔
        Subalgebra.toSubmodule (Algebra.adjoin R {G}) := by
  refine le_antisymm ?_ (sup_le (Algebra.adjoin_mono (by simp)) (Algebra.adjoin_mono (by simp)))
  rw [Algebra.adjoin_eq_span, Submodule.span_le]
  intro m hm
  obtain ⟨i, j, rfl⟩ := (Submonoid.mem_closure_pair F G m).1 hm
  -- `Fⁱ Gʲ` is `Fⁱ⁻ʲ` or `Gʲ⁻ⁱ`
  obtain ⟨k, rfl⟩ | ⟨k, rfl⟩ := (le_total j i).imp Nat.exists_eq_add_of_le' Nat.exists_eq_add_of_le
  · rw [pow_add, mul_assoc, pow_mul_pow_eq_one j hFG, mul_one]
    exact Submodule.mem_sup_left (pow_mem (Algebra.self_mem_adjoin_singleton R F) k)
  · rw [pow_add, ← mul_assoc, pow_mul_pow_eq_one i hFG, one_mul]
    exact Submodule.mem_sup_right (pow_mem (Algebra.self_mem_adjoin_singleton R G) k)

end Semiring

section Module

variable {R B N : Type*} [CommRing R] [CommSemiring B] [Algebra R B] [AddCommGroup N]
  [Module R N] [Module B N] [IsScalarTower R B N] {F G : B}

/-- **Finiteness of a cokernel over `R[F, F⁻¹]`.** Let `B = R[F, G]` with `F * G = 1`, and let `N`
be a `B`-module generated by a finite set `S`. If `P` and `Q` are `R`-submodules of `N`, stable
under `F` and under `G` respectively, with `S ⊆ Q` and every element of `S` carried into `P` by a
power of `F`, then `N / (P + Q)` is a finitely generated `R`-module.

On the projective line over `R`, with `F` and `G` the two affine coordinates on the overlap of the
standard charts, `N / (P + Q)` is the first cohomology of a quasi-coherent sheaf of finite type. -/
theorem finite_quotient_sup_of_mul_eq_one (hFG : F * G = 1) (hB : Algebra.adjoin R {F, G} = ⊤)
    {S : Set N} (hS : S.Finite) (hspan : Submodule.span B S = ⊤) {P Q : Submodule R N}
    (hP : ∀ x ∈ P, F • x ∈ P) (hSP : ∀ n ∈ S, ∃ k : ℕ, F ^ k • n ∈ P)
    (hQ : ∀ x ∈ Q, G • x ∈ Q) (hSQ : S ⊆ Q) :
    Module.Finite R (N ⧸ (P ⊔ Q)) := by
  have hpow (j : ℕ) {x : N} (hx : x ∈ P) : F ^ j • x ∈ P :=
    smul_mem_of_mem_adjoin_singleton hP (pow_mem (Algebra.self_mem_adjoin_singleton R F) j) hx
  -- a uniform exponent `k` with `F ^ k • S ⊆ P`
  obtain ⟨k, hk⟩ : ∃ k : ℕ, ∀ n ∈ S, F ^ k • n ∈ P := by
    choose! e he using hSP
    refine ⟨hS.toFinset.sup e, fun n hn ↦ ?_⟩
    obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_le (Finset.le_sup (f := e) (hS.mem_toFinset.mpr hn))
    rw [hj, pow_add, mul_comm, mul_smul]
    exact hpow j (he n hn)
  -- the `F ^ i • n` with `i < k` and `n ∈ S` span a finitely generated `R`-submodule `T`
  let T : Submodule R N := Submodule.span R ((fun p : ℕ × N ↦ F ^ p.1 • p.2) '' (Set.Iio k ×ˢ S))
  have hT : T.FG := Submodule.fg_span ((Set.finite_Iio k |>.prod hS).image _)
  -- `b • n ∈ P + Q + T` for `n ∈ S`, writing `b ∈ R[F, G]` as a polynomial in `F` plus one in `G`
  have hall : ∀ n ∈ S, ∀ b : B, b • n ∈ P ⊔ Q ⊔ T := by
    intro n hn b
    have hb : b ∈ Subalgebra.toSubmodule (Algebra.adjoin R {F, G}) := by simp [hB]
    rw [toSubmodule_adjoin_pair_eq_sup_of_mul_eq_one hFG, Submodule.mem_sup] at hb
    obtain ⟨p, hp, q, hq, rfl⟩ := hb
    rw [add_smul]
    refine Submodule.add_mem _ ?_ (Submodule.mem_sup_left (Submodule.mem_sup_right
      (smul_mem_of_mem_adjoin_singleton hQ hq (hSQ hn))))
    rw [Algebra.adjoin_eq_span] at hp
    induction hp using Submodule.span_induction with
    | mem m hm =>
      obtain ⟨i, rfl⟩ := Submonoid.mem_closure_singleton.mp hm
      rcases lt_or_ge i k with hi | hi
      · exact Submodule.mem_sup_right (Submodule.subset_span ⟨(i, n), ⟨hi, hn⟩, rfl⟩)
      · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hi
        rw [pow_add, mul_comm, mul_smul]
        exact Submodule.mem_sup_left (Submodule.mem_sup_left (hpow j (hk n hn)))
    | zero => rw [zero_smul]; exact Submodule.zero_mem _
    | add y z _ _ hy hz => rw [add_smul]; exact Submodule.add_mem _ hy hz
    | smul a y _ hy => rw [smul_assoc]; exact Submodule.smul_mem _ a hy
  -- hence `P + Q + T` is everything, as `S` generates `N` over `B`
  have htop : P ⊔ Q ⊔ T = ⊤ := by
    have key : ∀ x ∈ Submodule.span B S, ∀ b : B, b • x ∈ P ⊔ Q ⊔ T := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem n hn => exact hall n hn
      | zero => simp
      | add y z _ _ hy hz => intro b; rw [smul_add]; exact Submodule.add_mem _ (hy b) (hz b)
      | smul c y _ hy => intro b; rw [smul_smul]; exact hy _
    refine eq_top_iff.mpr fun x _ ↦ ?_
    simpa using key x (hspan ▸ Submodule.mem_top) 1
  have hmap : T.map (P ⊔ Q).mkQ = ⊤ := (Submodule.map_mkQ_eq_top (P ⊔ Q) T).mpr htop
  exact Module.finite_def.mpr (hmap ▸ hT.map _)

end Module

section Intersection

open Polynomial

variable {R B N : Type*} [CommRing R] [CommRing B] [Algebra R B] [AddCommGroup N]
  [Module R N] [Module B N] [IsScalarTower R B N] {F G : B}

/-- The relations among a finite family `S` of elements of `N` with polynomial coefficients in
`F`: the families `κ` of polynomials with `∑ κ i (F) • i = 0`, an `R[X]`-submodule. -/
private def relations (F : B) (S : Set N) [Fintype S] : Submodule R[X] (S → R[X]) where
  carrier := {κ | ∑ i, aeval F (κ i) • (i : N) = 0}
  add_mem' {κ κ'} hκ hκ' := by
    simp only [Set.mem_ofPred_eq, Pi.add_apply, map_add, add_smul, Finset.sum_add_distrib] at *
    rw [hκ, hκ', add_zero]
  zero_mem' := by simp
  smul_mem' c κ hκ := by
    simp only [Set.mem_ofPred_eq, Pi.smul_apply, smul_eq_mul, map_mul, mul_smul] at *
    rw [← Finset.smul_sum, hκ, smul_zero]

omit [Module R N] [IsScalarTower R B N] in
/-- Membership in `relations F S` unfolds to the vanishing of `∑ κ i (F) • i`. -/
private lemma mem_relations {S : Set N} [Fintype S] {κ : S → R[X]} :
    κ ∈ relations F S ↔ ∑ i, aeval F (κ i) • (i : N) = 0 :=
  Iff.rfl

/-- `κ ↦ ∑ i, (divX^[m] (κ i))(F) • i`: evaluate at `F` the polynomials `κ i` with their lowest
`m` coefficients removed and their degrees lowered by `m`. -/
private noncomputable def shiftEval (F : B) (S : Set N) [Fintype S] (m : ℕ) :
    (S → R[X]) →ₗ[R] N where
  toFun κ := ∑ i, aeval F (divX^[m] (κ i)) • (i : N)
  map_add' κ κ' := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' r κ := by simp [Finset.smul_sum, smul_assoc]

/-- On a relation, lowering degrees by `m` after multiplying by `Xⁿ` either kills the result or
lowers degrees by `m - n`. -/
private lemma shiftEval_X_pow_smul {S : Set N} [Fintype S] {κ : S → R[X]}
    (hκ : κ ∈ relations (R := R) F S) (m n : ℕ) :
    shiftEval F S m ((X : R[X]) ^ n • κ) = if m ≤ n then 0 else shiftEval F S (m - n) κ := by
  simp only [shiftEval, LinearMap.coe_mk, AddHom.coe_mk, Pi.smul_apply, smul_eq_mul,
    iterate_divX_X_pow_mul]
  split_ifs
  · simp only [map_mul, map_pow, aeval_X, mul_smul, ← Finset.smul_sum]
    rw [mem_relations.mp hκ, smul_zero]
  · rfl

/-- Lowering the degrees of a relation by any `m` lands in the `R`-span of the degree-lowered
generators of the relations, lowered by at most their degree bound `D`. -/
private lemma shiftEval_mem_span {S : Set N} [Fintype S] {g : Finset (S → R[X])}
    (hg : Submodule.span R[X] (g : Set (S → R[X])) = relations F S) {D : ℕ}
    (hD : ∀ κ ∈ g, ∀ i, (κ i).natDegree ≤ D) {κ : S → R[X]} (hκ : κ ∈ relations F S) (m : ℕ) :
    shiftEval F S m κ ∈ Submodule.span R
      ((fun p : ℕ × (S → R[X]) ↦ shiftEval F S p.1 p.2) '' (Set.Iic D ×ˢ g)) := by
  rw [← hg] at hκ
  induction hκ using Submodule.span_induction generalizing m with
  | mem κ hκ =>
    rcases le_or_gt m D with h | h
    · exact Submodule.subset_span ⟨(m, κ), ⟨h, hκ⟩, rfl⟩
    · simp [shiftEval, iterate_divX_eq_zero_of_natDegree_lt ((hD κ hκ _).trans_lt h)]
  | zero => simp
  | add κ κ' _ _ h h' => rw [map_add]; exact add_mem (h m) (h' m)
  | smul c κ hκ h =>
    rw [hg] at hκ
    induction c using Polynomial.induction_on' with
    | add p q hp hq => rw [add_smul, map_add]; exact add_mem hp hq
    | monomial n a =>
      rw [← C_mul_X_pow_eq_monomial, ← smul_eq_C_mul, smul_assoc, map_smul,
        shiftEval_X_pow_smul hκ]
      split_ifs
      · simp
      · exact Submodule.smul_mem _ a (h _)

/-- **Finiteness of an intersection over `R[F, F⁻¹]`.** Let `F * G = 1` in a commutative
`R`-algebra `B` over a Noetherian ring `R`, and let `S` be a finite subset of a `B`-module `N`.
The elements of `N` that are both an `R[F]`-linear and an `R[G]`-linear combination of `S` form
a finitely generated `R`-module.

On the projective line over `R`, with `F` and `G` the two affine coordinates on the overlap of the
standard charts, this bounds the sections over the overlap that extend to both charts, which
are the global sections up to sections supported away from the overlap. -/
theorem fg_inf_of_mul_eq_one [IsNoetherianRing R] (hFG : F * G = 1) {S : Set N}
    (hS : S.Finite) :
    ((Submodule.span (Algebra.adjoin R {F}) S).restrictScalars R ⊓
      (Submodule.span (Algebra.adjoin R {G}) S).restrictScalars R).FG := by
  classical
  have := hS.fintype
  -- the relations among `S` with coefficients polynomial in `F` are finitely generated
  obtain ⟨g, hg⟩ := IsNoetherian.noetherian (relations (R := R) F S)
  let D := g.sup fun κ ↦ Finset.univ.sup fun i ↦ (κ i).natDegree
  have hD (κ : S → R[X]) (hκ : κ ∈ g) (i : S) : (κ i).natDegree ≤ D :=
    (Finset.le_sup (f := fun i ↦ (κ i).natDegree) (Finset.mem_univ i)).trans
      (Finset.le_sup (f := fun κ ↦ Finset.univ.sup fun i ↦ (κ i).natDegree) hκ)
  let T : Submodule R N := Submodule.span R
    ((fun p : ℕ × (S → R[X]) ↦ shiftEval (R := R) F S p.1 p.2) '' (Set.Iic D ×ˢ g))
  have hT : T.FG := Submodule.fg_span (((Set.finite_Iic D).prod g.finite_toSet).image _)
  refine Submodule.FG.of_le (hT.sup (Submodule.fg_span hS)) ?_
  rintro x ⟨hxF, hxG⟩
  rw [SetLike.mem_coe, Submodule.restrictScalars_mem, ← Subtype.range_coe (s := S),
    mem_span_range_iff_exists_aeval] at hxF hxG
  obtain ⟨u, rfl⟩ := hxF
  obtain ⟨v, hv⟩ := hxG
  -- clear the denominators `Gᵏ = F⁻ᵏ` of `v` by a power of `F`
  let m := Finset.univ.sup fun i ↦ (v i).natDegree
  have hvm (i : S) : (v i).natDegree ≤ m := Finset.le_sup (f := fun i ↦ (v i).natDegree)
    (Finset.mem_univ i)
  let : Invertible G := ⟨F, hFG, (mul_comm _ _).trans hFG⟩
  have hrefl (i : S) : aeval F (reflect m (v i)) = F ^ m * aeval G (v i) := by
    rw [aeval_def, aeval_def, ← eval₂_reflect_mul_pow (algebraMap R B) G m (v i) (hvm i),
      mul_left_comm, ← mul_pow, hFG, one_pow, mul_one]
    rw [invOf_eq_left_inv hFG]
  let κ : S → R[X] := fun i ↦ X ^ m * u i - reflect m (v i)
  have hκ : κ ∈ relations F S := by
    rw [mem_relations]
    simp only [κ, map_sub, map_mul, map_pow, aeval_X, hrefl, sub_smul, Finset.sum_sub_distrib,
      mul_smul, ← Finset.smul_sum, hv, sub_self]
  have hx : ∑ i, aeval F (u i) • (i : N) = shiftEval F S m κ + ∑ i, (v i).coeff 0 • (i : N) := by
    simp only [shiftEval, LinearMap.coe_mk, AddHom.coe_mk, κ, iterate_divX_sub,
      iterate_divX_X_pow_mul, le_refl, ite_true, tsub_self, pow_zero, one_mul,
      iterate_divX_reflect (hvm _), map_sub, aeval_C, sub_smul, Finset.sum_sub_distrib,
      algebraMap_smul, sub_add_cancel]
  rw [hx]
  exact Submodule.add_mem_sup (shiftEval_mem_span hg hD hκ m)
    (Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span i.2))

end Intersection

end TauCeti.Algebra
