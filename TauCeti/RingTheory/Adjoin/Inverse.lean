module

public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Finiteness.Basic

/-!
# The algebra generated by an element and its inverse

If `F * G = 1` in a commutative `R`-algebra, every monomial `Fⁱ Gʲ` is `Fⁱ⁻ʲ` or `Gʲ⁻ⁱ`. Hence the
subalgebra `R[F, G]` is, as an `R`-submodule, the sum of `R[F]` and `R[G]`: every element of
`R[F, G]` is a polynomial in `F` plus a polynomial in `G`. This is the decomposition of a Laurent
polynomial into its parts of nonnegative and of negative degree, for the image of `R[T, T⁻¹]`
under `T ↦ F`.

The same decomposition controls modules over `R[F, G]`. Let `N` be a finitely generated module
over an `R`-algebra `B = R[F, G]`, with generators `S`, and let `P` and `Q` be `R`-submodules of
`N` stable under `F` and under `G` respectively, with `S ⊆ Q` and `F ^ k • S ⊆ P` for some `k`.
Then `N` is `P + Q` up to the finitely many `F ^ i • n` with `i < k` and `n ∈ S`, so `N / (P + Q)`
is a finitely generated `R`-module. This is the algebraic content of the finiteness of the first
Čech cohomology of a quasi-coherent sheaf of finite type on the projective line, covered by the
charts `Spec R[F]` and `Spec R[G]` with overlap `Spec R[F, F⁻¹]`: there `P` and `Q` are the
sections over the two charts, restricted to the overlap.

## Main results

* `TauCeti.Algebra.toSubmodule_adjoin_pair_eq_sup_of_mul_eq_one`: if `F * G = 1`, then
  `R[F, G] = R[F] + R[G]` as `R`-submodules.
* `TauCeti.Algebra.smul_mem_of_mem_adjoin_singleton`: an `R`-submodule stable under `F` is stable
  under `R[F]`.
* `TauCeti.Algebra.finite_quotient_sup_of_mul_eq_one`: if `F * G = 1` and `R[F, G] = B`, then
  `N / (P + Q)` is a finite `R`-module, for `P` and `Q` as above.
-/

public section

namespace TauCeti.Algebra

section Semiring

variable {R B : Type*} [CommSemiring R] [CommSemiring B] [Algebra R B] {F G : B}

/-- **An algebra generated by an element and an inverse.** If `F * G = 1`, the subalgebra
`R[F, G]` is, as an `R`-submodule, the sum of `R[F]` and `R[G]`: every element of `R[F, G]` is an
element of `R[F]` plus an element of `R[G]`. Compare `Algebra.adjoin_union_coe_submodule`, which
for arbitrary `F` and `G` describes the same submodule as the product `R[F] * R[G]`. -/
theorem toSubmodule_adjoin_pair_eq_sup_of_mul_eq_one (hFG : F * G = 1) :
    Subalgebra.toSubmodule (Algebra.adjoin R {F, G}) =
      Subalgebra.toSubmodule (Algebra.adjoin R {F}) ⊔
        Subalgebra.toSubmodule (Algebra.adjoin R {G}) := by
  refine le_antisymm ?_ (sup_le (Algebra.adjoin_mono (by simp)) (Algebra.adjoin_mono (by simp)))
  rw [Algebra.adjoin_eq_span, Submodule.span_le]
  intro m hm
  obtain ⟨i, j, rfl⟩ := (Submonoid.mem_closure_pair F G m).1 hm
  -- `Fⁱ Gʲ` is `Fⁱ⁻ʲ` or `Gʲ⁻ⁱ`
  obtain ⟨k, rfl⟩ | ⟨k, rfl⟩ := (le_total j i).imp Nat.exists_eq_add_of_le' Nat.exists_eq_add_of_le
  · rw [pow_add, mul_assoc, pow_mul_pow_eq_one j hFG, mul_one]
    exact Submodule.mem_sup_left (pow_mem (Algebra.self_mem_adjoin_singleton R F) k)
  · rw [pow_add, ← mul_assoc, pow_mul_pow_eq_one i hFG, one_mul]
    exact Submodule.mem_sup_right (pow_mem (Algebra.self_mem_adjoin_singleton R G) k)

end Semiring

section Module

/-- An `R`-submodule of a `B`-module that is stable under multiplication by `F` is stable under
multiplication by every element of the subalgebra `R[F]`. -/
theorem smul_mem_of_mem_adjoin_singleton {R B N : Type*} [CommSemiring R] [Semiring B]
    [Algebra R B] [AddCommMonoid N] [Module R N] [Module B N] [IsScalarTower R B N] {F : B}
    {P : Submodule R N} (hP : ∀ x ∈ P, F • x ∈ P) {b : B} (hb : b ∈ Algebra.adjoin R {F}) {x : N}
    (hx : x ∈ P) : b • x ∈ P := by
  induction hb using Algebra.adjoin_induction generalizing x with
  | mem y hy => rw [Set.mem_singleton_iff.mp hy]; exact hP x hx
  | algebraMap a => rw [algebraMap_smul]; exact P.smul_mem a hx
  | add y z _ _ hy hz => rw [add_smul]; exact P.add_mem (hy hx) (hz hx)
  | mul y z _ _ hy hz => rw [mul_smul]; exact hy (hz hx)

variable {R B N : Type*} [CommRing R] [CommSemiring B] [Algebra R B] [AddCommGroup N]
  [Module R N] [Module B N] [IsScalarTower R B N] {F G : B}

/-- **Finiteness of a cokernel over `R[F, F⁻¹]`.** Let `B = R[F, G]` with `F * G = 1`, and let `N`
be a `B`-module generated by a finite set `S`. If `P` and `Q` are `R`-submodules of `N`, stable
under `F` and under `G` respectively, with `S ⊆ Q` and every element of `S` carried into `P` by a
power of `F`, then `N / (P + Q)` is a finitely generated `R`-module.

On the projective line over `R`, with `F` and `G` the two affine coordinates on the overlap of the
standard charts, `N / (P + Q)` is the first cohomology of a quasi-coherent sheaf of finite type. -/
theorem finite_quotient_sup_of_mul_eq_one (hFG : F * G = 1) (hB : Algebra.adjoin R {F, G} = ⊤)
    {S : Set N} (hS : S.Finite) (hspan : Submodule.span B S = ⊤) {P Q : Submodule R N}
    (hP : ∀ x ∈ P, F • x ∈ P) (hSP : ∀ n ∈ S, ∃ k : ℕ, F ^ k • n ∈ P)
    (hQ : ∀ x ∈ Q, G • x ∈ Q) (hSQ : S ⊆ Q) :
    Module.Finite R (N ⧸ (P ⊔ Q)) := by
  have hpow (j : ℕ) {x : N} (hx : x ∈ P) : F ^ j • x ∈ P :=
    smul_mem_of_mem_adjoin_singleton hP (pow_mem (Algebra.self_mem_adjoin_singleton R F) j) hx
  -- a uniform exponent `k` with `F ^ k • S ⊆ P`
  obtain ⟨k, hk⟩ : ∃ k : ℕ, ∀ n ∈ S, F ^ k • n ∈ P := by
    choose! e he using hSP
    refine ⟨hS.toFinset.sup e, fun n hn ↦ ?_⟩
    obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_le (Finset.le_sup (f := e) (hS.mem_toFinset.mpr hn))
    rw [hj, pow_add, mul_comm, mul_smul]
    exact hpow j (he n hn)
  -- the `F ^ i • n` with `i < k` and `n ∈ S` span a finitely generated `R`-submodule `T`
  let T : Submodule R N := Submodule.span R ((fun p : ℕ × N ↦ F ^ p.1 • p.2) '' (Set.Iio k ×ˢ S))
  have hT : T.FG := Submodule.fg_span ((Set.finite_Iio k |>.prod hS).image _)
  -- `b • n ∈ P + Q + T` for `n ∈ S`, writing `b ∈ R[F, G]` as a polynomial in `F` plus one in `G`
  have hall : ∀ n ∈ S, ∀ b : B, b • n ∈ P ⊔ Q ⊔ T := by
    intro n hn b
    have hb : b ∈ Subalgebra.toSubmodule (Algebra.adjoin R {F, G}) := by simp [hB]
    rw [toSubmodule_adjoin_pair_eq_sup_of_mul_eq_one hFG, Submodule.mem_sup] at hb
    obtain ⟨p, hp, q, hq, rfl⟩ := hb
    rw [add_smul]
    refine Submodule.add_mem _ ?_ (Submodule.mem_sup_left (Submodule.mem_sup_right
      (smul_mem_of_mem_adjoin_singleton hQ hq (hSQ hn))))
    rw [Algebra.adjoin_eq_span] at hp
    induction hp using Submodule.span_induction with
    | mem m hm =>
      obtain ⟨i, rfl⟩ := Submonoid.mem_closure_singleton.mp hm
      rcases lt_or_ge i k with hi | hi
      · exact Submodule.mem_sup_right (Submodule.subset_span ⟨(i, n), ⟨hi, hn⟩, rfl⟩)
      · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hi
        rw [pow_add, mul_comm, mul_smul]
        exact Submodule.mem_sup_left (Submodule.mem_sup_left (hpow j (hk n hn)))
    | zero => rw [zero_smul]; exact Submodule.zero_mem _
    | add y z _ _ hy hz => rw [add_smul]; exact Submodule.add_mem _ hy hz
    | smul a y _ hy => rw [smul_assoc]; exact Submodule.smul_mem _ a hy
  -- hence `P + Q + T` is everything, as `S` generates `N` over `B`
  have htop : P ⊔ Q ⊔ T = ⊤ := by
    have key : ∀ x ∈ Submodule.span B S, ∀ b : B, b • x ∈ P ⊔ Q ⊔ T := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem n hn => exact hall n hn
      | zero => simp
      | add y z _ _ hy hz => intro b; rw [smul_add]; exact Submodule.add_mem _ (hy b) (hz b)
      | smul c y _ hy => intro b; rw [smul_smul]; exact hy _
    refine eq_top_iff.mpr fun x _ ↦ ?_
    simpa using key x (hspan ▸ Submodule.mem_top) 1
  have hmap : T.map (P ⊔ Q).mkQ = ⊤ := (Submodule.map_mkQ_eq_top (P ⊔ Q) T).mpr htop
  exact Module.finite_def.mpr (hmap ▸ hT.map _)

end Module

end TauCeti.Algebra
