module

public import Mathlib.Algebra.Algebra.Subalgebra.Tower

/-!
# Generators survive a change of base ring in an algebra tower

If `x` lies in the `F`-subalgebra of `A` generated by `s`, then for any `F`-algebra hom
`f : A →ₐ[F] K` and any `F`-algebra `R` over which `K` is an algebra compatibly, `f x` lies in
the `R`-subalgebra generated by `f '' s`. Applied to a generating set of `A`, this turns an
algebra-finite model of `A` over `F` into an algebra-finite model of its image over `R`.

## Main results

* `AlgHom.apply_mem_adjoin_image`: `f x ∈ Algebra.adjoin R (f '' s)` whenever
  `x ∈ Algebra.adjoin F s`.
-/

public section

namespace AlgHom

variable {F A K : Type*} (R : Type*) [CommSemiring F] [CommSemiring R] [Semiring A] [Semiring K]
  [Algebra F R] [Algebra F A] [Algebra F K] [Algebra R K] [IsScalarTower F R K]

/-- An `F`-algebra hom `f : A →ₐ[F] K` sends the `F`-subalgebra generated by `s` into the
`R`-subalgebra generated by `f '' s`, for any `F`-algebra `R` with `K` an `R`-algebra compatibly:
enlarging the base ring from `F` to `R` only enlarges the generated subalgebra. -/
theorem apply_mem_adjoin_image (f : A →ₐ[F] K) {s : Set A} {x : A}
    (hx : x ∈ Algebra.adjoin F s) : f x ∈ Algebra.adjoin R (f '' s) := by
  have hfx : f x ∈ (Algebra.adjoin F s).map f := Subalgebra.mem_map.2 ⟨x, hx, rfl⟩
  rw [f.map_adjoin] at hfx
  exact Algebra.adjoin_le (S := (Algebra.adjoin R (f '' s)).restrictScalars F)
    Algebra.subset_adjoin hfx

end AlgHom
