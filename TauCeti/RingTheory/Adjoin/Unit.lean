module

public import Mathlib.RingTheory.Artinian.Algebra
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic

/-!
# Algebra generated by an integral unit

This file records that over an Artinian commutative ring, the inverse of an integral unit belongs
to the algebra generated by that unit. This is the analogue for units of Mathlib's
`IsIntegral.inv_mem_adjoin`, which works over a field, and follows from
`IsArtinianRing.isUnit_of_isIntegral_of_nonZeroDivisor` applied in the generated subalgebra.

## Main declarations

* `Units.inv_mem_adjoin`: the inverse of an integral unit is contained in the algebra generated
  by that unit.
-/

public section

namespace Units

open nonZeroDivisors

variable {K A : Type*} [CommRing K] [IsArtinianRing K] [Ring A] [Algebra K A]

/-- The inverse of an integral unit over an Artinian commutative ring belongs to the algebra
generated by that unit. -/
theorem inv_mem_adjoin (u : Aˣ) (hu : IsIntegral K (u : A)) :
    ((u⁻¹ : Aˣ) : A) ∈ Algebra.adjoin K {(u : A)} := by
  let B := Algebra.adjoin K {(u : A)}
  obtain ⟨y, hy⟩ := (IsArtinianRing.isUnit_of_isIntegral_of_nonZeroDivisor
    (a := (⟨u, Algebra.self_mem_adjoin_singleton K _⟩ : B))
    ((isIntegral_algHom_iff B.val Subtype.val_injective).mp hu)
    (comap_nonZeroDivisors_le_of_injective (f := B.val) Subtype.val_injective
      u.isUnit.mem_nonZeroDivisors)).exists_right_inv
  rw [u.inv_eq_of_mul_eq_one_right (congrArg Subtype.val hy)]
  exact y.2

end Units
