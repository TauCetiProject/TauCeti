/-!
# Descent of standard syntomic algebras

Let `K / k` be a field extension and `A` a `k`-algebra. If `K ⊗[k] A` is locally standard syntomic
of relative dimension `n` over `K`, then `A` is locally standard syntomic of relative dimension `n`
over `k` (`TauCeti.locally_isStandardSyntomicOfRelativeDimension_of_tensorProduct`). In other
words, being a local complete intersection of relative dimension `n` over a field is insensitive
to extending the field.

Combined with the fibrewise criterion
`TauCeti.locally_isStandardSyntomicOfRelativeDimension_of_fiber`, this gives descent along every
faithfully flat ring map `R → S`
(`TauCeti.codescendsAlong_locally_isStandardSyntomicOfRelativeDimension_faithfullyFlat`):
flatness and finite presentation descend, and the fibre of `S ⊗[R] T` over a prime of `S` is the
base change of the fibre of `T` along an extension of residue fields. This is the affine input
for fpqc descent of syntomic morphisms of schemes.

The proof bounds the number of equations needed near a prime `q` of `A`. Present `A` as
`k[x₁, …, x_m] ⧸ I`. Near a prime `q'` of `K ⊗[k] A` over `q`, the algebra `K ⊗[k] A` has a
standard syntomic chart `(K ⊗[k] A)[1/t] = K[z₁, …, z_{n+c}] ⧸ (f₁, …, f_c)`. Comparing this
presentation with the presentation of `(K ⊗[k] A)[1/t]` by the generators `x` and one more
generator inverting `t` (`Algebra.Generators.finrank_tensor_cotangent_add_card_le`,
`Algebra.Generators.finrank_tensor_cotangent_comp_localizationAway`) bounds the dimension of the
fibre of the extended ideal `I K[x]` at `q'` by `m - n`. As `K[x]` is flat over `k[x]`, this is
also the dimension of the fibre of `I` (`Ideal.finrank_tensor_map_of_flat`). By Nakayama's lemma
(`Module.exists_finset_card_le_finrank_and_smul_mem_span`), after inverting some `g ∉ q` the
ideal `I` is generated by `d ≤ m - n` elements, which presents `A[1/g]` by `m + 1` generators and
`d + 1` relations. Since `dim A = dim (K ⊗[k] A) ≤ n`, Krull's height theorem forces `d = m - n`
and shows that `A[1/g]` has dimension `n`.

## Main results

* `TauCeti.exists_notMem_isStandardSyntomicOfRelativeDimension_localization_away_of_tensorProduct`:
  every prime `q` of `A` has a standard syntomic neighbourhood `A[1/g]`, `g ∉ q`, of relative
  dimension `n` over `k`.
* `TauCeti.locally_isStandardSyntomicOfRelativeDimension_of_tensorProduct`: `A` is locally
  standard syntomic of relative dimension `n` over `k`.
* `TauCeti.codescendsAlong_locally_isStandardSyntomicOfRelativeDimension_faithfullyFlat`: locally
  standard syntomic ring maps of relative dimension `n` descend along faithfully flat ring maps.

## References

* The Stacks Project, Commutative Algebra, Section *Syntomic morphisms*: being a local complete
  intersection over a field is unchanged by extending the field, and a presentation whose kernel
  needs the expected number of generators near a prime is a relative global complete
  intersection near that prime.
-/

public section

open TensorProduct

namespace TauCeti

universe u

variable {n : ℕ} {k K A : Type u} [Field k] [Field K] [Algebra k K] [CommRing A] [Algebra k A]

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- Let `P` present `A` over `k` with generators indexed by `ι`, and let `q` be a prime of `A`. If
`K ⊗[k] A` is locally standard syntomic of relative dimension `n`, then at some field-valued point
`F` of `k[ι]` lying over `q`, the fibre of the kernel of `P` has dimension at most `#ι - n`. -/
private theorem exists_finrank_tensor_ker_add_le {ι σ : Type} [Finite ι] [Finite σ]
    (P : Algebra.Presentation k A ι σ)
    (h : RingHom.Locally (IsStandardSyntomicOfRelativeDimension n) (algebraMap K (K ⊗[k] A)))
    (q : Ideal A) [q.IsPrime] :
    ∃ (F : Type u) (_ : Field F) (_ : Algebra P.Ring F),
      (∀ r : P.Ring, algebraMap P.Ring A r ∈ q → algebraMap P.Ring F r = 0) ∧
      Module.finrank F (F ⊗[P.Ring] P.ker) + n ≤ Nat.card ι := by
  -- A prime `q'` of `K ⊗[k] A` over `q`.
  obtain ⟨q₁, hq₁⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := A) (B := A ⊗[k] K)
    ⟨q, inferInstance⟩
  let q' : Ideal (K ⊗[k] A) := q₁.asIdeal.comap (Algebra.TensorProduct.comm k K A).toRingHom
  have hq' : q'.comap Algebra.TensorProduct.includeRight.toRingHom = q := by
    rw [Ideal.comap_comap]
    convert congrArg PrimeSpectrum.asIdeal hq₁ using 2
    ext a
    simp
  -- A standard syntomic chart `T = (K ⊗[k] A)[1/t]` around `q'`.
  obtain ⟨s, hs, hst⟩ := h
  have hq'top : q' ≠ ⊤ := fun h ↦ ‹q.IsPrime›.ne_top (by rw [← hq', h, Ideal.comap_top])
  obtain ⟨t, hts, hdisj⟩ := Ideal.exists_disjoint_powers_of_span_eq_top s hs q' hq'top
  let T := Localization.Away t
  have hT : Algebra.IsStandardSyntomicOfRelativeDimension n K T := by
    rw [← isStandardSyntomicOfRelativeDimension_algebraMap,
      IsScalarTower.algebraMap_eq K (K ⊗[k] A)]
    exact hst t hts
  let Q := q'.map (algebraMap (K ⊗[k] A) T)
  have : Q.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint _ _ q' inferInstance hdisj.symm
  -- The point `F = κ(Q)`, with its algebra structures over `K ⊗[k] A`, `K[ι]` and `k[ι]`.
  let F := Q.ResidueField
  let PK := P.baseChange K
  let : Algebra (K ⊗[k] A) F := ((algebraMap T F).comp (algebraMap (K ⊗[k] A) T)).toAlgebra
  let : Algebra PK.Ring F :=
    ((algebraMap (K ⊗[k] A) F).comp (algebraMap PK.Ring (K ⊗[k] A))).toAlgebra
  let : Algebra P.Ring F := ((algebraMap PK.Ring F).comp (algebraMap P.Ring PK.Ring)).toAlgebra
  have : IsScalarTower (K ⊗[k] A) T F := .of_algebraMap_eq' rfl
  have : IsScalarTower PK.Ring (K ⊗[k] A) F := .of_algebraMap_eq' rfl
  have : IsScalarTower P.Ring PK.Ring F := .of_algebraMap_eq' rfl
  refine ⟨F, inferInstance, inferInstance, fun r hr ↦ ?_, ?_⟩
  · have hr' : algebraMap PK.Ring (K ⊗[k] A) (algebraMap P.Ring PK.Ring r) =
        Algebra.TensorProduct.includeRight (algebraMap P.Ring A r) := by
      rw [Algebra.Generators.algebraMap_apply, Algebra.Generators.algebraMap_apply,
        MvPolynomial.algebraMap_def, MvPolynomial.aeval_map_algebraMap,
        MvPolynomial.comp_aeval_apply]
      simp only [PK, Algebra.Presentation.baseChange_toGenerators,
        Algebra.TensorProduct.includeRight_apply]
      exact congrArg (MvPolynomial.aeval · r) (funext (Algebra.Generators.baseChange_val _ _))
    rw [IsScalarTower.algebraMap_apply P.Ring PK.Ring F,
      IsScalarTower.algebraMap_apply PK.Ring (K ⊗[k] A) F,
      IsScalarTower.algebraMap_apply (K ⊗[k] A) T F, hr', Ideal.algebraMap_residueField_eq_zero]
    refine Ideal.mem_map_of_mem _ ?_
    rw [← hq'] at hr
    exact hr
  · obtain ⟨ι', σ', _, _, P', hP'⟩ := hT.exists_presentation
    -- The kernel of `K[ι] → K ⊗[k] A` is the extension of the kernel of `k[ι] → A`.
    have hker : PK.ker = P.ker.map (algebraMap P.Ring PK.Ring) := by
      rw [← PK.span_range_relation_eq_ker, ← P.span_range_relation_eq_ker, Ideal.map_span,
        ← Set.range_comp, MvPolynomial.algebraMap_def]
      exact congrArg (Ideal.span ∘ Set.range)
        (funext (Algebra.Presentation.baseChange_relation _ _))
    have : Module.Flat P.Ring PK.Ring :=
      Module.Flat.isBaseChange (R := k) (M := K) _ _ (Algebra.IsPushout.out (R := k) (S := P.Ring)
        (R' := K) (S' := PK.Ring))
    have hfg : PK.ker.FG := by
      rw [← PK.span_range_relation_eq_ker]
      exact Submodule.fg_span (Set.finite_range _)
    have : Module.Finite (K ⊗[k] A) PK.toExtension.Cotangent :=
      Algebra.Extension.Cotangent.finite hfg
    have h1 := ((Algebra.Generators.localizationAway T t).comp
      PK.toGenerators).finrank_tensor_cotangent_add_card_le F P'
    rw [Algebra.Generators.finrank_tensor_cotangent_comp_localizationAway,
      Algebra.Generators.finrank_tensor_cotangent, hker, Ideal.finrank_tensor_map_of_flat] at h1
    simp only [Nat.card_sum, Nat.card_unique, hP'] at h1
    omega

/-- **Standard syntomic charts descend along field extensions.** If `K ⊗[k] A` is locally standard
syntomic of relative dimension `n` over the extension field `K`, then every prime `q` of `A` has a
neighbourhood `A[1/g]`, `g ∉ q`, which is standard syntomic of relative dimension `n` over `k`. -/
theorem exists_notMem_isStandardSyntomicOfRelativeDimension_localization_away_of_tensorProduct
    (h : RingHom.Locally (IsStandardSyntomicOfRelativeDimension n) (algebraMap K (K ⊗[k] A)))
    (q : Ideal A) [q.IsPrime] :
    ∃ g ∉ q, Algebra.IsStandardSyntomicOfRelativeDimension n k (Localization.Away g) := by
  classical
  -- `A` is finitely presented over `k`, since `K ⊗[k] A` is finitely presented over `K`.
  have : Algebra.FinitePresentation K (K ⊗[k] A) := by
    rw [← RingHom.finitePresentation_algebraMap, ← RingHom.locally_iff_of_localizationSpanTarget
      RingHom.finitePresentation_respectsIso RingHom.finitePresentation_ofLocalizationSpanTarget]
    exact RingHom.locally_of_locally (fun hf ↦ hf.finitePresentation) h
  have : Algebra.FinitePresentation k A := .of_finitePresentation_tensorProduct_of_faithfullyFlat K
  let P := Algebra.Presentation.ofFinitePresentation k A
  obtain ⟨F, _, _, hF, hfin⟩ := exists_finrank_tensor_ker_add_le P h q
  have : Module.Finite P.Ring P.ker := by
    rw [Module.Finite.iff_fg, ← P.span_range_relation_eq_ker]
    exact Submodule.fg_span (Set.finite_range _)
  obtain ⟨s, hs, r, hr, hrs⟩ :=
    Module.exists_finset_card_le_finrank_and_smul_mem_span (R := P.Ring) (M := P.ker) (F := F)
  let ϕ : P.Ring →ₐ[k] A := MvPolynomial.aeval P.val
  have hker : RingHom.ker ϕ = P.ker := P.ker_eq_ker_aeval_val.symm
  have hk : ∀ l : s, (l : P.ker).1 ∈ RingHom.ker ϕ := fun l ↦ by
    rw [hker]
    exact (l : P.ker).2
  have hg : ∀ x ∈ RingHom.ker ϕ, r * x ∈ Ideal.span (Set.range fun l : s ↦ (l : P.ker).1) := by
    intro x hx
    rw [hker] at hx
    have := Submodule.mem_map_of_mem (f := P.ker.subtype) (hrs ⟨x, hx⟩)
    rw [Submodule.map_span] at this
    have hrange : (Set.range fun l : s ↦ (l : P.ker).1) = P.ker.subtype '' s := by
      ext
      simp
    rw [hrange]
    exact this
  obtain ⟨PB⟩ := Algebra.Presentation.nonempty_presentation_localizationAway
    P.aeval_val_surjective hk hg
  have hrq : ϕ r ∉ q := fun h' ↦ hr (hF r (by rwa [Algebra.Generators.algebraMap_apply]))
  refine ⟨ϕ r, hrq, ?_⟩
  -- `A[1/ϕ r]` is nonzero, of Krull dimension at most `dim A = dim (K ⊗[k] A) ≤ n`, and its
  -- presentation has at least `n` more generators than relations.
  have hdisj : Disjoint (Submonoid.powers (ϕ r) : Set A) q :=
    (Ideal.disjoint_powers_iff_notMem _ ‹q.IsPrime›.isRadical).mpr hrq
  have hqB : (q.map (algebraMap A (Localization.Away (ϕ r)))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint _ _ q inferInstance hdisj
  have : Nontrivial (Localization.Away (ϕ r)) := nontrivial_of_ne 0 1 fun h ↦
    hqB.ne_top ((Ideal.eq_top_iff_one _).mpr (h ▸ Ideal.zero_mem _))
  have hdimA : ringKrullDim A ≤ n := by
    rw [← ringKrullDim_tensorProduct_field_of_finiteType (k := k) K A]
    exact ringKrullDim_le_of_locally_isStandardSyntomicOfRelativeDimension h
  refine PB.isStandardSyntomicOfRelativeDimension_of_ringKrullDim_le ?_
    ((ringKrullDim_le_iff_height_le _).mpr fun p _ ↦ ?_)
  · simp only [Nat.card_eq_fintype_card, Fintype.card_sum, Fintype.card_unit, Fintype.card_coe,
      Fintype.card_fin] at hfin ⊢
    omega
  · rw [← IsLocalization.height_under (Submonoid.powers (ϕ r)) p]
    exact Ideal.height_le_ringKrullDim_of_isPrime.trans hdimA

/-- **Local complete intersections descend along field extensions.** If `K ⊗[k] A` is locally
standard syntomic of relative dimension `n` over the extension field `K`, then `A` is locally
standard syntomic of relative dimension `n` over `k`. -/
theorem locally_isStandardSyntomicOfRelativeDimension_of_tensorProduct
    (h : RingHom.Locally (IsStandardSyntomicOfRelativeDimension n) (algebraMap K (K ⊗[k] A))) :
    RingHom.Locally (IsStandardSyntomicOfRelativeDimension n) (algebraMap k A) := by
  rw [RingHom.locally_iff_span_eq_top]
  by_contra hne
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
  obtain ⟨g, hg, hstd⟩ :=
    exists_notMem_isStandardSyntomicOfRelativeDimension_localization_away_of_tensorProduct h m
  refine hg (hle (Ideal.subset_span ?_))
  rw [Set.mem_ofPred_eq, ← IsScalarTower.algebraMap_eq,
    isStandardSyntomicOfRelativeDimension_algebraMap]
  exact hstd

variable (n) in
/-- **Standard syntomic charts satisfy fpqc descent.** If `S` is faithfully flat over `R` and
`S ⊗[R] T` is locally standard syntomic of relative dimension `n` over `S`, then `T` is locally
standard syntomic of relative dimension `n` over `R`. -/
theorem codescendsAlong_locally_isStandardSyntomicOfRelativeDimension_faithfullyFlat :
    RingHom.CodescendsAlong (RingHom.Locally (IsStandardSyntomicOfRelativeDimension n))
      RingHom.FaithfullyFlat := by
  refine .mk _ (locally_isStandardSyntomicOfRelativeDimension_propertyIsLocal n).respectsIso
    fun R S T _ _ _ _ _ h h' ↦ ?_
  rw [RingHom.faithfullyFlat_algebraMap_iff] at h
  -- Flatness and finite presentation descend.
  have : Module.Flat S (S ⊗[R] T) := by
    rw [← RingHom.flat_algebraMap_iff, ← RingHom.locally_iff_of_localizationSpanTarget
      RingHom.Flat.respectsIso RingHom.Flat.ofLocalizationSpanTarget]
    exact RingHom.locally_of_locally (fun hf ↦ hf.flat) h'
  have : Algebra.FinitePresentation S (S ⊗[R] T) := by
    rw [← RingHom.finitePresentation_algebraMap, ← RingHom.locally_iff_of_localizationSpanTarget
      RingHom.finitePresentation_respectsIso RingHom.finitePresentation_ofLocalizationSpanTarget]
    exact RingHom.locally_of_locally (fun hf ↦ hf.finitePresentation) h'
  have : Module.Flat R T := .of_flat_tensorProduct R T S
  have : Algebra.FinitePresentation R T := .of_finitePresentation_tensorProduct_of_faithfullyFlat S
  -- By the fibrewise criterion it suffices to treat the fibre over a prime `p` of `R`. Choose a
  -- prime `P` of `S` over `p`; the fibre of `S ⊗[R] T` over `P` is the base change of the fibre
  -- of `T` over `p` along the residue field extension `κ(p) → κ(P)`.
  refine locally_isStandardSyntomicOfRelativeDimension_of_fiber fun p _ ↦ ?_
  obtain ⟨P, hP⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R) (B := S)
    ⟨p, inferInstance⟩
  let K := P.asIdeal.ResidueField
  have hpK : ∀ r, algebraMap R K r = 0 ↔ r ∈ p := fun r ↦ by
    rw [IsScalarTower.algebraMap_apply R S K, Ideal.algebraMap_residueField_eq_zero,
      ← Ideal.mem_comap, ← PrimeSpectrum.comap_asIdeal, hP]
  let φ : p.ResidueField →+* K := Ideal.ResidueField.lift p (algebraMap R K)
    (fun r hr ↦ (hpK r).mpr hr) fun r hr ↦ (IsUnit.mk0 _ fun h ↦ hr ((hpK r).mp h) :)
  let : Algebra p.ResidueField K := φ.toAlgebra
  have : IsScalarTower R p.ResidueField K := .of_algebraMap_eq fun r ↦ by
    rw [RingHom.algebraMap_toAlgebra]
    exact (Ideal.ResidueField.lift_algebraMap p (algebraMap R K) _ _ r).symm
  have hK := (RingHom.locally_isStableUnderBaseChange
    (isStandardSyntomicOfRelativeDimension_respectsIso n)
    (isStandardSyntomicOfRelativeDimension_isStableUnderBaseChange n)).tensorProduct K h'
  let e : K ⊗[S] (S ⊗[R] T) ≃ₐ[K] K ⊗[p.ResidueField] p.Fiber T :=
    (Algebra.TensorProduct.cancelBaseChange R S K K T).trans
      (Algebra.TensorProduct.cancelBaseChange R p.ResidueField K K T).symm
  refine locally_isStandardSyntomicOfRelativeDimension_of_tensorProduct (K := K) ?_
  have hK' := (locally_isStandardSyntomicOfRelativeDimension_propertyIsLocal n).respectsIso.left
    (T := K ⊗[p.ResidueField] p.Fiber T) _ e.toRingEquiv hK
  have he : (e.toRingEquiv : _ →+* _).comp (algebraMap K (K ⊗[S] (S ⊗[R] T))) =
      algebraMap K (K ⊗[p.ResidueField] p.Fiber T) :=
    RingHom.ext fun x ↦ e.commutes x
  rw [← he]
  exact hK'

end TauCeti
