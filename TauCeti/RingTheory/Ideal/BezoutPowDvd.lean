module

public import Mathlib.RingTheory.Bezout
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Uniform power divisors of finitely generated ideals into Bézout rings

Let `σ : R →+* S` be a ring homomorphism into a Bézout ring `S` in which every element admits an
`m`-th root. For any finitely generated ideal `I` of `R` whose pushforward `I.map σ` is proper,
`I.map σ` is principal and generated by some `x ^ m`, where `x : S` is a non-unit. If moreover an
element `a : S` divides a power of every non-unit of `S` (as a pseudouniformiser does in a rank-one
valuation ring such as `O_C`), then `a ∣ x ^ N` for some `N` while `x ^ m` divides `σ r` for every
`r ∈ I`.

## Main results

* `TauCeti.exists_not_isUnit_pow_dvd_map_of_fg`: existence of a non-unit `x : S` with
  `x ^ m ∣ σ r` for all `r ∈ I`.
* `TauCeti.exists_dvd_pow_and_pow_dvd_map_of_fg`: simultaneous existence of `x : S` and `N : ℕ`
  with `a ∣ x ^ N` and `x ^ m ∣ σ r` for all `r ∈ I`.

## Provenance

Adapted from grh-lean (https://github.com/lsernau/grh-lean at commit
`72fead102f663d5c7a407964a13dc0cf9d977207`, Apache 2.0, Copyright 2026 Anthropic, PBC), file
`src/Lib/PadicComparison/CrystallineFrobenius.lean` (`exists_dvd_pow_and_pow_dvd`), generalized
from noetherian rings and `O_C` to finitely generated ideals, proper pushforwards, arbitrary Bézout
rings with `m`-th roots, and arbitrary elements dividing a power of every non-unit.
-/

@[expose] public section

namespace TauCeti

/-- Let `σ : R →+* S` be a ring homomorphism into a Bézout ring `S` in which every element has an
`m`-th root. For any finitely generated ideal `I` of `R` whose pushforward `I.map σ` is proper,
there exists a non-unit `x : S` such that `x ^ m ∣ σ r` for every `r ∈ I`. -/
theorem exists_not_isUnit_pow_dvd_map_of_fg {R S : Type*} [CommRing R] [CommRing S] [IsBezout S]
    (σ : R →+* S) {I : Ideal R} (hfg : I.FG) (hproper : I.map σ ≠ ⊤) (m : ℕ)
    (hroot : ∀ y : S, ∃ x : S, x ^ m = y) :
    ∃ x : S, ¬IsUnit x ∧ ∀ r ∈ I, x ^ m ∣ σ r := by
  obtain ⟨S, rfl⟩ := hfg
  have hmap_fg : ((Ideal.span (S : Set R)).map σ).FG := by
    classical
    refine ⟨S.image σ, ?_⟩
    rw [Finset.coe_image, Ideal.map_span]
  obtain ⟨y, hy⟩ := IsBezout.isPrincipal_of_FG _ hmap_fg
  obtain ⟨x, rfl⟩ := hroot y
  refine ⟨x, ?_, fun r hr ↦ Ideal.mem_span_singleton.mp (hy.le (Ideal.mem_map_of_mem σ hr))⟩
  intro hx
  exact hproper (hy.trans (Ideal.span_singleton_eq_top.mpr (hx.pow m)))

/-- Under the hypotheses of `exists_not_isUnit_pow_dvd_map_of_fg`, if an element `a : S` divides a
power of every non-unit of `S`, then there exist `x : S` and `N : ℕ` such that `a ∣ x ^ N` and
`x ^ m ∣ σ r` for every `r ∈ I`. -/
theorem exists_dvd_pow_and_pow_dvd_map_of_fg {R S : Type*} [CommRing R] [CommRing S] [IsBezout S]
    (σ : R →+* S) {I : Ideal R} (hfg : I.FG) (hproper : I.map σ ≠ ⊤) (m : ℕ)
    (hroot : ∀ y : S, ∃ x : S, x ^ m = y) {a : S}
    (ha : ∀ x : S, ¬IsUnit x → ∃ N : ℕ, a ∣ x ^ N) :
    ∃ (x : S) (N : ℕ), a ∣ x ^ N ∧ ∀ r ∈ I, x ^ m ∣ σ r := by
  obtain ⟨x, hx, hdvd⟩ := exists_not_isUnit_pow_dvd_map_of_fg σ hfg hproper m hroot
  obtain ⟨N, hN⟩ := ha x hx
  exact ⟨x, N, hN, hdvd⟩

end TauCeti
