module

public import Mathlib.Algebra.Algebra.Operations
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import TauCeti.Algebra.LinearRecurrence.Inequality

/-!
# The Golod–Shafarevich inequality for finite-dimensional algebras

Let `A` be a finite-dimensional algebra over a field `k` and `I` a proper two-sided ideal of `A`,
generated as a left ideal by `x₁, …, x_d` with `d ≥ 1`. Suppose that every relation
`∑ aᵢ xᵢ = 0` is an `A`-linear combination of `r` vectors `y₁, …, y_r ∈ A^d` whose entries all
lie in `I`. Then

```text
d² < 4 r.
```

For a finite `p`-group `G` this applies to `A = 𝔽_p[G]`, its augmentation ideal, a minimal
generating tuple `gᵢ` of `G` with `xᵢ = gᵢ - 1`, and the relators of a minimal presentation of
`G`, and gives the Golod–Shafarevich inequality `d(G)² < 4 r(G)`.

The proof follows Roquette. Write `P m` for the left ideal generated by `I ^ m`, so that
`P 0 = A` and `P (m + 1) = P m * I`, and `c m = dim_k (A ⧸ P m)`. Left multiplication of the `xᵢ`
by a tuple of elements of `P m` has image `P (m + 1)`, and a combination of the `yⱼ` with
coefficients in `P m` has all its entries in `P (m + 1)`. Counting dimensions in the induced
complex

```text
(A ⧸ P m)^r → (A ⧸ P (m + 1))^d → P 1 ⧸ P (m + 2),
```

which is exact in the middle, gives
`c (m + 2) + r c m ≥ c 1 + d c (m + 1) ≥ 1 + d c (m + 1)`. The sequence `c` is bounded by
`dim_k A`, so `TauCeti.sq_lt_four_mul_of_forall_add_mul_le` forces `d² < 4 r`.

## Main results

* `TauCeti.card_sq_lt_four_mul_card`: **the Golod–Shafarevich inequality** `d² < 4 r` for a
  finite-dimensional algebra with a proper two-sided ideal generated by `d ≥ 1` elements whose
  relations lie in the span of `r` vectors with entries in the ideal.

## References

* E. S. Golod and I. R. Shafarevich, *On the class field tower*, Izv. Akad. Nauk SSSR Ser. Mat.
  28 (1964).
* P. Roquette, *On class field towers*, in J. W. S. Cassels and A. Fröhlich (eds.), *Algebraic
  Number Theory*, Chapter IX, §4.
* J. Neukirch, A. Schmidt and K. Wingberg, *Cohomology of Number Fields*, 2nd ed., (3.9.7).
-/

public section

namespace TauCeti

open Module Submodule

variable {A : Type*} [Ring A] {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- The dimension count behind the Golod–Shafarevich inequality. Let `W, U, T ≤ S` be subspaces of
`A` such that right multiplication by the entries of the relations `y` maps `W` into `U`, right
multiplication by the generators `x` maps `U` into `T`, every `∑ aᵢ xᵢ` lies in `S`, and every
element of `T` is a `U`-combination of the `x`. If every relation among the `x` is an
`A`-combination of the `y`, then the complex `(A ⧸ W)^κ → (A ⧸ U)^ι → A ⧸ T` is exact in the
middle and the image of its right map is killed by `A ⧸ T → A ⧸ S`, so
`#ι · dim (A ⧸ U) + dim (A ⧸ S) ≤ dim (A ⧸ T) + #κ · dim (A ⧸ W)`. -/
private theorem card_mul_finrank_quotient_add_le {k : Type*} [Field k] [Algebra k A]
    [FiniteDimensional k A] (x : ι → A) (y : κ → ι → A)
    (hker : ∀ a : ι → A, ∑ i, a i * x i = 0 → a ∈ span A (Set.range y))
    {W U T S : Submodule k A} (hWU : ∀ w ∈ W, ∀ j i, w * y j i ∈ U)
    (hUT : ∀ u ∈ U, ∀ i, u * x i ∈ T) (hTS : T ≤ S) (hxS : ∀ a : ι → A, ∑ i, a i * x i ∈ S)
    (hT : ∀ t ∈ T, ∃ a : ι → A, (∀ i, a i ∈ U) ∧ ∑ i, a i * x i = t) :
    Fintype.card ι * finrank k (A ⧸ U) + finrank k (A ⧸ S) ≤
      finrank k (A ⧸ T) + Fintype.card κ * finrank k (A ⧸ W) := by
  classical
  -- The maps induced on the quotients by the generators and by the relations.
  let d₁ : (ι → A ⧸ U) →ₗ[k] A ⧸ T := ∑ i,
    U.mapQ T (LinearMap.mulRight k (x i)) (fun u hu ↦ mem_comap.2 (hUT u hu i)) ∘ₗ LinearMap.proj i
  let d₂ : (κ → A ⧸ W) →ₗ[k] ι → A ⧸ U := LinearMap.pi fun i ↦ ∑ j,
    W.mapQ U (LinearMap.mulRight k (y j i)) (fun w hw ↦ mem_comap.2 (hWU w hw j i)) ∘ₗ
      LinearMap.proj j
  have hd₁ (a : ι → A) : d₁ (fun i ↦ U.mkQ (a i)) = T.mkQ (∑ i, a i * x i) := by
    simp [d₁, map_sum]
  have hd₂ (b : κ → A) : d₂ (fun j ↦ W.mkQ (b j)) = fun i ↦ U.mkQ (∑ j, b j * y j i) := by
    ext i
    simp [d₂, map_sum]
  have hlift (a : ι → A ⧸ U) : ∃ a' : ι → A, (fun i ↦ U.mkQ (a' i)) = a := by
    choose a' ha' using fun i ↦ U.mkQ_surjective (a i)
    exact ⟨a', funext ha'⟩
  -- The image of `d₁` lies in `S ⧸ T`, the kernel of `A ⧸ T → A ⧸ S`.
  have hrange : LinearMap.range d₁ ≤ LinearMap.ker (factor hTS) := by
    rintro _ ⟨a, rfl⟩
    obtain ⟨a, rfl⟩ := hlift a
    rw [LinearMap.mem_ker, hd₁, factor_mk, mkQ_apply, Quotient.mk_eq_zero]
    exact hxS a
  -- Exactness in the middle: a relation modulo `T` comes from the relations `y`.
  have hexact : LinearMap.ker d₁ ≤ LinearMap.range d₂ := by
    intro a ha
    obtain ⟨a, rfl⟩ := hlift a
    rw [LinearMap.mem_ker, hd₁, mkQ_apply, Quotient.mk_eq_zero] at ha
    obtain ⟨a', ha'U, ha'⟩ := hT _ ha
    obtain ⟨b, hb⟩ := (mem_span_range_iff_exists_fun A).1
      (hker (a - a') (by simp [sub_mul, Finset.sum_sub_distrib, ha']))
    refine ⟨fun j ↦ W.mkQ (b j), ?_⟩
    rw [hd₂]
    ext i
    have hbi : ∑ j, b j * y j i = a i - a' i := by
      simpa using congrFun hb i
    rw [hbi, mkQ_apply, mkQ_apply, Quotient.mk_sub, (Quotient.mk_eq_zero U).2 (ha'U i), sub_zero]
  -- Counting dimensions.
  have h₁ := LinearMap.finrank_range_add_finrank_ker d₁
  have h₂ := LinearMap.finrank_range_add_finrank_ker (factor hTS)
  rw [LinearMap.range_eq_top.2 (factor_surjective hTS), finrank_top] at h₂
  have h₃ := Submodule.finrank_mono hrange
  have h₄ := (Submodule.finrank_mono hexact).trans (LinearMap.finrank_range_le d₂)
  simp only [Module.finrank_pi_fintype, Finset.sum_const, Finset.card_univ, smul_eq_mul] at h₁ h₄
  omega

/-- **The Golod–Shafarevich inequality for finite-dimensional algebras.** Let `A` be a
finite-dimensional algebra over a field `k` and `I` a proper two-sided ideal of `A`, generated as
a left ideal by a nonempty finite family `x`. If every relation `∑ aᵢ xᵢ = 0` among the generators
is an `A`-linear combination of a finite family `y` of vectors in `A^ι` with all entries in `I`,
then `(#x)² < 4 · #y`. -/
theorem card_sq_lt_four_mul_card (k : Type*) [Field k] [Algebra k A] [FiniteDimensional k A]
    [Nonempty ι] (I : Ideal A) [I.IsTwoSided] (hI : I ≠ ⊤)
    (x : ι → A) (hx : span A (Set.range x) = I) (y : κ → ι → A) (hy : ∀ j i, y j i ∈ I)
    (hker : ∀ a : ι → A, ∑ i, a i * x i = 0 → a ∈ span A (Set.range y)) :
    Fintype.card ι ^ 2 < 4 * Fintype.card κ := by
  -- `P m` is the left ideal generated by `I ^ m`, as a `k`-subspace of `A`.
  let J : Submodule k A := I.restrictScalars k
  let P : ℕ → Submodule k A := fun m ↦ ⊤ * J ^ m
  have hP0 : P 0 = ⊤ := by simp [P]
  have hPsucc (m : ℕ) : P (m + 1) = P m * J := by simp only [P, pow_succ, mul_assoc]
  have hxI (i : ι) : x i ∈ I := hx ▸ subset_span ⟨i, rfl⟩
  have hmem (m : ℕ) {a b : A} (ha : a ∈ P m) (hb : b ∈ I) : a * b ∈ P (m + 1) :=
    hPsucc m ▸ mul_mem_mul ha hb
  -- Each `P m` is a right ideal, because `I` is.
  have hright (m : ℕ) {a : A} (ha : a ∈ P m) (b : A) : a * b ∈ P m := by
    induction m generalizing a with
    | zero => simp [hP0]
    | succ m ih =>
      rw [hPsucc] at ha ⊢
      induction ha using Submodule.mul_induction_on' with
      | mem_mul_mem u hu v hv => rw [mul_assoc u v b]; exact mul_mem_mul hu (I.mul_mem_right b hv)
      | add a _ a' _ ha ha' => rw [add_mul]; exact add_mem ha ha'
  have hanti : Antitone P := antitone_nat_of_succ_le fun m ↦
    hPsucc m ▸ mul_le.2 fun a ha _ _ ↦ hright m ha _
  -- Every element of `P (m + 1)` is a `P m`-combination of the generators.
  have hsurj (m : ℕ) (t : A) (ht : t ∈ P (m + 1)) :
      ∃ a : ι → A, (∀ i, a i ∈ P m) ∧ ∑ i, a i * x i = t := by
    rw [hPsucc] at ht
    induction ht using Submodule.mul_induction_on' with
    | mem_mul_mem u hu v hv =>
      obtain ⟨c, rfl⟩ := (mem_span_range_iff_exists_fun A).1 (by rw [hx]; exact hv)
      exact ⟨fun i ↦ u * c i, fun i ↦ hright m hu _, by simp [Finset.mul_sum, mul_assoc]⟩
    | add t _ t' _ ht ht' =>
      obtain ⟨a, ha, rfl⟩ := ht
      obtain ⟨a', ha', rfl⟩ := ht'
      exact ⟨a + a', fun i ↦ add_mem (ha i) (ha' i), by
        simp [add_mul, Finset.sum_add_distrib]⟩
  have hxP1 (a : ι → A) : ∑ i, a i * x i ∈ P 1 :=
    sum_mem fun i _ ↦ hmem 0 (hP0 ▸ mem_top) (hxI i)
  -- The codimensions `c m = dim (A ⧸ P m)` satisfy the Golod–Shafarevich recurrence.
  let c : ℕ → ℕ := fun m ↦ finrank k (A ⧸ P m)
  have hc (m : ℕ) : c m + finrank k (P m) = finrank k A := (P m).finrank_quotient_add_finrank
  have hc0 : c 0 = 0 := by have := hc 0; rw [hP0, finrank_top] at this; omega
  have hc1 : 1 ≤ c 1 := by
    have hP1 : P 1 ≠ ⊤ := by
      refine fun h ↦ hI ((I.eq_top_iff_one).2 ?_)
      have hle : P 1 ≤ J := hPsucc 0 ▸ mul_le.2 fun u _ v hv ↦ I.mul_mem_left u hv
      exact hle (h ▸ mem_top)
    have := Submodule.finrank_lt hP1
    have := hc 1
    omega
  refine sq_lt_four_mul_of_forall_add_mul_le Fintype.card_pos hc0
    ⟨finrank k A, by rintro _ ⟨m, rfl⟩; have := hc m; omega⟩ fun m ↦ ?_
  have := card_mul_finrank_quotient_add_le x y hker (W := P m) (U := P (m + 1)) (T := P (m + 2))
    (S := P 1) (fun w hw j i ↦ hmem m hw (hy j i)) (fun u hu i ↦ hmem (m + 1) hu (hxI i))
    (hanti (by omega)) hxP1 (hsurj (m + 1))
  simp only [c] at hc1 ⊢
  omega

end TauCeti
