module

public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Ideal.Operations

/-!
# Finitely generated subideals of an idempotent ideal

An idempotent ideal `I = I * I` is in general not finitely generated (a finitely generated
idempotent ideal is generated by an idempotent element, `Ideal.isIdempotentElem_iff_of_fg`), but
its finitely generated subideals still see the idempotence: each finitely generated `J ≤ I` lies in
`K ^ n` for a finitely generated `K ≤ I` and any prescribed `n`. Almost mathematics over a
basic setup `(V, m)` uses this to trade an annihilator condition for one finitely generated
subideal of `m` against the same condition for products of several of them.

## Main results

* `Ideal.exists_fg_le_mul_of_isIdempotentElem`: a finitely generated `J ≤ I` lies in `K * K` for
  a finitely generated `K ≤ I`.
* `Ideal.exists_fg_le_pow_of_isIdempotentElem`: the same with `K ^ n`, for every `n`.

## References

* O. Gabber, L. Ramero, *Almost ring theory*, Lecture Notes in Mathematics 1800, §2.3.
-/

public section

open scoped Pointwise

namespace Ideal

variable {R : Type*} [CommSemiring R] {I J : Ideal R}

/-- A finitely generated subideal `J` of an idempotent ideal `I` lies in `K * K` for some finitely
generated `K ≤ I`. -/
theorem exists_fg_le_mul_of_isIdempotentElem (hI : IsIdempotentElem I) (hJ : J.FG)
    (hJI : J ≤ I) : ∃ K : Ideal R, K.FG ∧ K ≤ I ∧ J ≤ K * K := by
  classical
  obtain ⟨s, rfl⟩ := hJ
  induction s using Finset.induction_on with
  | empty => exact ⟨⊥, Submodule.fg_bot, bot_le, by simp⟩
  | insert x s _ ih =>
    rw [Finset.coe_insert, span_insert] at hJI ⊢
    obtain ⟨K, hKfg, hKI, hK⟩ := ih (le_sup_right.trans hJI)
    have hx : x ∈ I * I := hI.eq.symm ▸ hJI (Submodule.mem_sup_left (mem_span_singleton_self x))
    obtain ⟨T, T', hT, hT', hxT⟩ := Submodule.mem_span_mul_finite_of_mem_mul hx
    have hL : Submodule.span R ((T : Set R) * (T' : Set R)) ≤
        (K ⊔ span ((T : Set R) ∪ T')) ^ 2 := by
      rw [← Submodule.span_mul_span, sq]
      exact mul_mono (le_sup_of_le_right (span_mono Set.subset_union_left))
        (le_sup_of_le_right (span_mono Set.subset_union_right))
    refine ⟨K ⊔ span ((T : Set R) ∪ T'), Submodule.FG.sup hKfg ⟨T ∪ T', by simp⟩,
      sup_le hKI (span_le.mpr (Set.union_subset hT hT')), sup_le ?_ ?_⟩
    · rw [span_singleton_le_iff_mem, ← sq]
      exact hL hxT
    · exact hK.trans (mul_mono le_sup_left le_sup_left)

/-- A finitely generated subideal `J` of an idempotent ideal `I` lies in `K ^ n` for some finitely
generated `K ≤ I`, for every `n`. -/
theorem exists_fg_le_pow_of_isIdempotentElem (hI : IsIdempotentElem I) (hJ : J.FG)
    (hJI : J ≤ I) (n : ℕ) : ∃ K : Ideal R, K.FG ∧ K ≤ I ∧ J ≤ K ^ n := by
  cases n with
  | zero => exact ⟨⊥, Submodule.fg_bot, bot_le, by simp⟩
  | succ n =>
    induction n with
    | zero => exact ⟨J, hJ, hJI, by simp⟩
    | succ n ih =>
      obtain ⟨K, hKfg, hKI, hJK⟩ := ih
      obtain ⟨L, hLfg, hLI, hKL⟩ := exists_fg_le_mul_of_isIdempotentElem hI hKfg hKI
      refine ⟨L, hLfg, hLI, hJK.trans ?_⟩
      calc K ^ (n + 1) ≤ (L * L) ^ (n + 1) := pow_right_mono hKL _
        _ = L ^ (2 * (n + 1)) := by rw [← sq, pow_mul]
        _ ≤ L ^ (n + 1 + 1) := pow_le_pow_right (by omega)

end Ideal
