module

public import TauCeti.RingTheory.Localization.Ideal
public import TauCeti.RingTheory.Localization.Away.Basic
public import TauCeti.RingTheory.Flat.NonZeroDivisors
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.RingHom.Flat

/-!
# Regular principal ideals and localization

An ideal is regular principal when generated by a nonzerodivisor. This condition is stable
under flat extension and ring isomorphisms. Over a noetherian ring it spreads from a prime
localization to a principal neighborhood. The result supplies local equations for Cartier
divisors and relative effective divisor loci.
-/

public section

noncomputable section

universe u

open scoped nonZeroDivisors

namespace Ideal

variable {R : Type*} [CommRing R]

/-- An ideal generated by a single non-zerodivisor. -/
def IsRegularPrincipal (J : Ideal R) : Prop :=
  ∃ s ∈ nonZeroDivisors R, J = Ideal.span {s}

/-- Characterize regular principal ideals by a nonzerodivisor generator. -/
theorem isRegularPrincipal_def {J : Ideal R} :
    J.IsRegularPrincipal ↔ ∃ s ∈ nonZeroDivisors R, J = Ideal.span {s} := Iff.rfl

end Ideal

namespace Ideal
variable {A : Type*} [CommRing A]

/-- The extension of `q` to the localization away from `g` is generated by the regular element `π`,
under the stated denominator-clearing and annihilator bounds. -/
lemma isRegularPrincipal_map_away {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (g : A) [IsLocalization.Away g B] (q : Ideal A) (π : A) (hπ : π ∈ q)
    (h1 : ∀ a ∈ q, g * a ∈ Ideal.span {π}) (h2 : ∀ b, π * b = 0 → g * b = 0) :
    (q.map (algebraMap A B)).IsRegularPrincipal := by
  refine ⟨algebraMap A B π, ?_, ?_⟩
  · apply mem_nonZeroDivisors_iff_left.mpr
    simpa only [smul_eq_mul] using
      (isSMulRegular_iff_right_eq_zero_of_smul.mp
        (IsLocalization.Away.isSMulRegular_algebraMap (B := B) h2))
  · apply Ideal.map_algebraMap_away_eq_span_singleton (r := g) hπ
    intro x hx
    obtain ⟨a, ha, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hx
    exact h1 a ha

end Ideal

namespace Ideal

variable {R S : Type*} [CommRing R] [CommRing S]

/-- Regular principality is preserved by a ring isomorphism. -/
lemma IsRegularPrincipal.map_of_bijective {J : Ideal R} (hJ : J.IsRegularPrincipal)
    {f : R →+* S} (hf : Function.Bijective f) : (J.map f).IsRegularPrincipal := by
  obtain ⟨s, hs, rfl⟩ := hJ
  refine ⟨f s, ?_, by rw [Ideal.map_span, Set.image_singleton]⟩
  rw [← MulEquivClass.map_nonZeroDivisors (RingEquiv.ofBijective f hf)]
  exact ⟨s, hs, rfl⟩

/-- Regular principality descends along a ring isomorphism. -/
lemma IsRegularPrincipal.of_comap_of_bijective {J : Ideal S} {f : R →+* S}
    (hf : Function.Bijective f) (hJ : (J.comap f).IsRegularPrincipal) :
    J.IsRegularPrincipal := by
  rw [← Ideal.map_comap_of_surjective f hf.2 J]
  exact hJ.map_of_bijective hf

/-- Regular principality is preserved by pulling back along a ring isomorphism. -/
lemma IsRegularPrincipal.comap_of_bijective {J : Ideal S} (hJ : J.IsRegularPrincipal)
    {f : R →+* S} (hf : Function.Bijective f) : (J.comap f).IsRegularPrincipal := by
  refine of_comap_of_bijective (f := ((RingEquiv.ofBijective f hf).symm : S →+* R))
    (RingEquiv.bijective _) ?_
  have hcomp : f.comp ((RingEquiv.ofBijective f hf).symm : S →+* R) = RingHom.id S :=
    RingHom.ext fun x ↦ (RingEquiv.ofBijective f hf).apply_symm_apply x
  rwa [Ideal.comap_comap, hcomp, Ideal.comap_id]

/-- **Regular principality is stable under flat base change.** Extending an ideal generated by a
non-zerodivisor along a flat ring homomorphism again gives such an ideal: the generator stays a
non-zerodivisor because a flat module is torsion-free. -/
lemma IsRegularPrincipal.map_of_flat {J : Ideal R} (hJ : J.IsRegularPrincipal) {f : R →+* S}
    (hf : f.Flat) : (J.map f).IsRegularPrincipal := by
  let := f.toAlgebra
  have : Module.Flat R S := hf
  obtain ⟨s, hs, rfl⟩ := hJ
  refine ⟨f s, ?_, by rw [Ideal.map_span, Set.image_singleton]⟩
  exact Module.Flat.algebraMap_mem_nonZeroDivisors hs

end Ideal

/-- Every generator of a regular principal ideal is a nonzerodivisor. -/
lemma Ideal.IsRegularPrincipal.mem_nonZeroDivisors_of_span_eq {R : Type*} [CommRing R]
    {I : Ideal R} (hI : I.IsRegularPrincipal) {c : R} (hc : Ideal.span {c} = I) :
    c ∈ nonZeroDivisors R := by
  obtain ⟨d, hd, rfl⟩ := hI
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp
    (hc.symm ▸ Ideal.mem_span_singleton_self d)
  exact (mul_mem_nonZeroDivisors.mp (ha ▸ hd)).1

/-- A singleton span is regular principal exactly when its generator is a nonzerodivisor. -/
@[simp]
lemma Ideal.isRegularPrincipal_span_singleton {R : Type*} [CommRing R] {s : R} :
    (Ideal.span {s}).IsRegularPrincipal ↔ s ∈ nonZeroDivisors R :=
  ⟨fun h ↦ h.mem_nonZeroDivisors_of_span_eq rfl, fun hs ↦ ⟨s, hs, rfl⟩⟩

/-- **Spreading out a principal ideal from a local ring.** Let `A` be a noetherian ring, `P` a
prime, and `I` an ideal whose extension to `A_P` is generated by a nonzerodivisor. Then there is
`g ∉ P` such that `I A_g` is generated by a non-zerodivisor. -/
lemma Ideal.exists_notMem_isRegularPrincipal_map_away {A : Type*} [CommRing A]
    [IsNoetherianRing A] (P : Ideal A) [P.IsPrime] (Ap : Type*) [CommRing Ap] [Algebra A Ap]
    [IsLocalization.AtPrime Ap P] (I : Ideal A) {t : Ap}
    (ht : I.map (algebraMap A Ap) = Ideal.span {t}) (ht0 : t ∈ nonZeroDivisors Ap) :
    ∃ g ∉ P, ∀ (Ag : Type*) [CommRing Ag] [Algebra A Ag] [IsLocalization.Away g Ag],
      (I.map (algebraMap A Ag)).IsRegularPrincipal := by
  classical
  obtain ⟨⟨⟨π, hπI⟩, s⟩, hπs⟩ := (IsLocalization.mem_map_algebraMap_iff P.primeCompl Ap).mp
    (ht ▸ Ideal.mem_span_singleton_self t)
  have hsu : IsUnit (algebraMap A Ap s) := IsLocalization.map_units Ap s
  have hspan : I.map (algebraMap A Ap) = Ideal.span {algebraMap A Ap π} := by
    rw [ht, ← hπs, Ideal.span_singleton_mul_right_unit hsu]
  have hπ0 : algebraMap A Ap π ∈ nonZeroDivisors Ap := by
    rw [← hπs]
    exact mul_mem ht0 hsu.mem_nonZeroDivisors
  have hreg : IsSMulRegular Ap (algebraMap A Ap π) :=
    IsSMulRegular.of_right_eq_zero_of_smul (mem_nonZeroDivisors_iff_left.mp hπ0)
  obtain ⟨g, hg, hbound, hkill⟩ :=
    Ideal.exists_notMem_smul_le_span_singleton_of_map_eq (P := P) Ap hspan hreg
  refine ⟨g, hg, fun Ag _ _ _ ↦ Ideal.isRegularPrincipal_map_away g I π hπI ?_ hkill⟩
  intro a ha
  exact hbound (Submodule.smul_mem_pointwise_smul a g I ha)
