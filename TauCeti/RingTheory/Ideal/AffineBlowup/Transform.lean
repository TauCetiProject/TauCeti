/-!
# The transform of an ideal on a chart of a quadratic transform

Let `𝔪 = (x, y)` be a maximal ideal of a commutative ring `A` generated by a regular pair `x, y`,
for instance the maximal ideal of a two-dimensional regular local ring with a regular system of
parameters `x, y`. The chart `B = A[𝔪/x]` of the blowup of `Spec A` at `V(𝔪)`, the *quadratic
transform*, is `A[X] ⧸ (xX - y)`, and its exceptional fibre `B ⧸ (x)` is the affine line
`(A ⧸ 𝔪)[X]` (`Ideal.affineBlowupQuotEquivPolynomial`).

For an ideal `I ⊆ 𝔪ʳ` the extension `I B` lies in `𝔪ʳ B = xʳ B`, so it factors as `xʳ · I'` with
`I' = (I B : xʳ)` (`Ideal.map_algebraMap_affineBlowup_eq_span_pow_mul_colon`). When `r` is the
order of `I`, that is `I ⊆ 𝔪ʳ` but `I ⊄ 𝔪ʳ⁺¹`, the ideal `I'` is the *transform* of `I`: the
part of the total transform `I B` that is not accounted for by the exceptional divisor `x = 0`.

The main result is that transforming lowers the colength of an `𝔪`-primary ideal:
`ℓ_A(B ⧸ I') + ℓ_A(A ⧸ 𝔪ʳ) ≤ ℓ_A(A ⧸ I)`
(`RingTheory.Sequence.IsWeaklyRegular.length_quotient_colon_add_length_quotient_pow_le`), so the
colength drops strictly as soon as `I ≠ A`
(`RingTheory.Sequence.IsWeaklyRegular.length_quotient_colon_lt`). This is Zariski's descent of
colength along quadratic transforms, the engine of the proof that a finite sequence of blowups in
closed points of a regular surface makes any ideal cosupported at finitely many closed points
invertible, and hence dominates any modification that is an isomorphism away from those points.

The proof is elementary. Every element of `𝔪ʳ` is `xʳ` times a polynomial of degree at most `r`
in `t = y/x` with coefficients in `A`, so `a ↦ a/xʳ` maps `𝔪ʳ` into `B`, and it sends `I` into
`I'`. It is onto `B ⧸ I'`: for `f ∈ I` of order `r`, the image of `f/xʳ ∈ I'` in the exceptional
fibre `(A ⧸ 𝔪)[X]` is a nonzero polynomial of degree at most `r`, so dividing by it with remainder
shows `B = 𝔪ʳ/xʳ + I' + xB`; this iterates to `B = 𝔪ʳ/xʳ + I' + xⁿB` for every `n`, and a power
of `x` lies in `I'` because `I` is `𝔪`-primary. Hence `B ⧸ I'` is a quotient of `𝔪ʳ ⧸ I`, whose
length is `ℓ(A ⧸ I) - ℓ(A ⧸ 𝔪ʳ)`.

## Main results

* `RingTheory.Sequence.IsWeaklyRegular.length_quotient_colon_add_length_quotient_pow_le`: the
  colength inequality `ℓ(B ⧸ I') + ℓ(A ⧸ 𝔪ʳ) ≤ ℓ(A ⧸ I)` for an `𝔪`-primary ideal `I` of order `r`.
* `RingTheory.Sequence.IsWeaklyRegular.length_quotient_colon_lt`: the strict inequality
  `ℓ(B ⧸ I') < ℓ(A ⧸ I)` when `r ≠ 0`, as `A ⧸ I` has finite length
  (`Ideal.isFiniteLength_quotient_pow_of_fg`).

## References

* O. Zariski, *Polynomial ideals defined by infinitely near base points*, Amer. J. Math. 60
  (1938), 151–204.
* C. Huneke, I. Swanson, *Integral Closure of Ideals, Rings, and Modules*, London Math. Soc.
  Lecture Note Ser. 336, Cambridge University Press, 2006, Chapter 14 (two-dimensional regular
  local rings: quadratic transforms and transforms of ideals).
-/

public section

open Polynomial TauCeti.Localization RingTheory.Sequence

namespace RingTheory.Sequence.IsWeaklyRegular

variable {A : Type*} [CommRing A] {x y : A} (S : Type*) [CommRing S] [Algebra A S]
  [IsLocalization.Away x S]

/-- The `A`-linear map `𝔪ʳ → A[𝔪/x]`, `a ↦ a/xʳ`, for `x ∈ 𝔪`. -/
private noncomputable def divPow {J : Ideal A} (hx : x ∈ J) (r : ℕ) :
    (J ^ r : Ideal A) →ₗ[A] J.affineBlowup x S where
  toFun a := ⟨IsLocalization.Away.invSelf x ^ r * algebraMap A S a,
    (Ideal.mem_affineBlowup_iff hx).mpr ⟨r, a, a.property, by
      rw [← mul_assoc, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, one_mul]⟩⟩
  map_add' a b := Subtype.ext (by simp [mul_add])
  map_smul' c a := Subtype.ext (by simp [Algebra.smul_def, mul_left_comm])

private theorem algebraMap_pow_mul_divPow {J : Ideal A} (hx : x ∈ J) (r : ℕ)
    (a : (J ^ r : Ideal A)) :
    algebraMap A (J.affineBlowup x S) x ^ r * divPow S hx r a =
      algebraMap A (J.affineBlowup x S) a :=
  Subtype.ext (by
    simp only [divPow, LinearMap.coe_mk, AddHom.coe_mk, Subalgebra.coe_mul, Subalgebra.coe_pow,
      Subalgebra.coe_algebraMap]
    rw [← mul_assoc, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, one_mul])

/-- The fraction `y/x` as an element of the chart `A[(x, y)/x]`. -/
private noncomputable abbrev chartCoord : (Ideal.span {x, y}).affineBlowup x S :=
  ⟨divBy y x, Ideal.divBy_mem_affineBlowup (Ideal.subset_span (by simp))⟩

/-- `x · (y/x) = y` in the chart. -/
private theorem algebraMap_mul_chartCoord :
    algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x * chartCoord S =
      algebraMap A ((Ideal.span {x, y}).affineBlowup x S) y :=
  Subtype.ext (by simp)

/-- A polynomial of degree at most `k` in `t = y/x`, multiplied by `xᵏ`, is the image of the
element `∑ qᵢ x^(k - i) yⁱ` of `𝔪ᵏ`. -/
private theorem algebraMap_pow_mul_aeval_chartCoord {k : ℕ} {q : A[X]} (hq : q.natDegree ≤ k) :
    algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ k * aeval (chartCoord S) q =
      algebraMap A ((Ideal.span {x, y}).affineBlowup x S)
        (∑ i ∈ Finset.range (k + 1), q.coeff i * x ^ (k - i) * y ^ i) := by
  rw [aeval_eq_sum_range' (Nat.lt_succ_of_le hq), Finset.mul_sum, map_sum]
  refine Finset.sum_congr rfl fun i hi ↦ ?_
  have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
  rw [map_mul, map_mul, map_pow, map_pow, ← algebraMap_mul_chartCoord S, mul_pow, Algebra.smul_def,
    ← Nat.sub_add_cancel hik, pow_add, Nat.add_sub_cancel]
  ring

/-- If every coefficient of `q` lies in `J`, then `∑ qᵢ x^(k - i) yⁱ` lies in `J 𝔪ᵏ`: in `𝔪ᵏ`
for `J = A`, and in `𝔪ᵏ⁺¹` for `J = 𝔪`. -/
private theorem sum_mem_span_pair_pow {J : Ideal A} (k : ℕ) (q : A[X])
    (hq : ∀ i, q.coeff i ∈ J) :
    ∑ i ∈ Finset.range (k + 1), q.coeff i * x ^ (k - i) * y ^ i ∈
      J * Ideal.span {x, y} ^ k := by
  refine Ideal.sum_mem _ fun i hi ↦ ?_
  have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
  rw [mul_assoc]
  refine Ideal.mul_mem_mul (hq i) ?_
  rw [← Nat.sub_add_cancel hik, pow_add, Nat.add_sub_cancel]
  exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) _)
    (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) _)

/-- Every element of `𝔪ᵏ` is `xᵏ` times a polynomial of degree at most `k` in `t = y/x`. -/
private theorem exists_natDegree_le_algebraMap_pow_mul_aeval_eq {k : ℕ} {a : A}
    (ha : a ∈ Ideal.span {x, y} ^ k) :
    ∃ q : A[X], q.natDegree ≤ k ∧
      algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ k * aeval (chartCoord S) q =
        algebraMap A ((Ideal.span {x, y}).affineBlowup x S) a := by
  induction k generalizing a with
  | zero => exact ⟨C a, by simp, by simp⟩
  | succ k ih =>
    rw [pow_succ] at ha
    induction ha using Submodule.mul_induction_on' with
    | mem_mul_mem b hb z hz =>
      obtain ⟨q, hqk, hq⟩ := ih hb
      obtain ⟨u, v, rfl⟩ := Ideal.mem_span_pair.mp hz
      refine ⟨q * (C u + C v * X), ?_, ?_⟩
      · refine (natDegree_mul_le).trans (add_le_add hqk ?_)
        exact (natDegree_add_le _ _).trans
          (max_le (by simp) ((natDegree_C_mul_le _ _).trans natDegree_X_le))
      · simp only [map_mul, map_add, aeval_C, aeval_X, pow_succ, ← hq,
          ← algebraMap_mul_chartCoord S]
        ring
    | add b _ c _ hb hc =>
      obtain ⟨q, hqk, hq⟩ := hb
      obtain ⟨q', hqk', hq'⟩ := hc
      exact ⟨q + q', (natDegree_add_le _ _).trans (max_le hqk hqk'), by
        rw [map_add, mul_add, hq, hq', map_add]⟩

/-- A polynomial `q` of degree at most `r` in `t = y/x` is `a/xʳ` for some `a ∈ 𝔪ʳ`. -/
private theorem exists_divPow_eq_aeval_chartCoord (hx : x ∈ Ideal.span {x, y}) {r : ℕ} {q : A[X]}
    (hq : q.natDegree ≤ r) : ∃ a, divPow S hx r a = aeval (chartCoord S) q := by
  have hmem := sum_mem_span_pair_pow (J := ⊤) (x := x) (y := y) r q (fun _ ↦ Submodule.mem_top)
  rw [Ideal.top_mul] at hmem
  refine ⟨⟨_, hmem⟩, (Ideal.isRegular_algebraMap_affineBlowup.pow r).left ?_⟩
  beta_reduce
  rw [algebraMap_pow_mul_divPow, algebraMap_pow_mul_aeval_chartCoord S hq]

/-- If `xʳ q(y/x) = f` with `q` of degree at most `r` and `f ∉ 𝔪ʳ⁺¹`, then `q` does not vanish
modulo `𝔪`. -/
private theorem map_ne_zero_of_notMem_pow_succ (hxy : IsWeaklyRegular A [x, y]) {r : ℕ}
    {q : A[X]} (hq : q.natDegree ≤ r) {f : A}
    (hqf : algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ r * aeval (chartCoord S) q =
      algebraMap A ((Ideal.span {x, y}).affineBlowup x S) f)
    (hf : f ∉ Ideal.span {x, y} ^ (r + 1)) :
    q.map (Ideal.Quotient.mk (Ideal.span {x, y})) ≠ 0 := fun hp ↦ hf <| by
  have hc i : q.coeff i ∈ Ideal.span {x, y} := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← coeff_map, hp, coeff_zero]
  rw [algebraMap_pow_mul_aeval_chartCoord S hq] at hqf
  rw [pow_succ', ← Ideal.algebraMap_affineBlowup_injective
    (isLeftRegular_iff.mpr ((isWeaklyRegular_cons_iff A x [y]).1 hxy).1) hqf]
  exact sum_mem_span_pair_pow r q hc

variable [(Ideal.span {x, y}).IsMaximal]

/-- **Division with remainder on the exceptional fibre.** Let `f ∈ I` have order `r`. Every
element `b` of the chart `B = A[𝔪/x]` is congruent modulo `x B` to `a/xʳ`, for some `a ∈ 𝔪ʳ`,
plus a multiple of `f/xʳ`, an element of the transform `(I B : xʳ)`. -/
private theorem exists_sub_divPow_sub_mem_colon (hxy : IsWeaklyRegular A [x, y]) {I : Ideal A}
    {r : ℕ} (hr : I ≤ Ideal.span {x, y} ^ r) (hr' : ¬ I ≤ Ideal.span {x, y} ^ (r + 1))
    (b : (Ideal.span {x, y}).affineBlowup x S) :
    ∃ a c, b - divPow S (Ideal.subset_span (by simp)) r a -
        algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x * c ∈
      (I.map (algebraMap A ((Ideal.span {x, y}).affineBlowup x S))).colon
        {algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ r} := by
  let := Ideal.Quotient.field (Ideal.span {x, y})
  have hx : x ∈ Ideal.span {x, y} := Ideal.subset_span (by simp)
  -- The exceptional fibre `B ⧸ (x) = (A ⧸ 𝔪)[X]`, with `y/x ↦ X`.
  let ρ : (Ideal.span {x, y}).affineBlowup x S →ₐ[A] (A ⧸ Ideal.span {x, y})[X] :=
    (Ideal.affineBlowupQuotEquivPolynomial S hxy).toAlgHom.comp (Ideal.Quotient.mkₐ A _)
  have hρ (q : A[X]) : ρ (aeval (chartCoord S) q) = q.map (Ideal.Quotient.mk _) := by
    rw [← aeval_algHom_apply, ← aeval_map_algebraMap (A ⧸ Ideal.span {x, y}),
      Ideal.Quotient.algebraMap_eq]
    simp [ρ]
  have hρker {b' : (Ideal.span {x, y}).affineBlowup x S} (h : ρ b' = 0) :
      ∃ c, b' = algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x * c := by
    have h' : Ideal.affineBlowupQuotEquivPolynomial S hxy (Ideal.Quotient.mk _ b') = 0 := h
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp
      ((map_eq_zero_iff _ (AlgEquiv.injective _)).mp h'))
    exact ⟨c, by rw [← hc, mul_comm]⟩
  -- An element `f ∈ I` of order `r`, with `f/xʳ` a polynomial `q_f(y/x)` in the transform.
  obtain ⟨f, hfI, hf⟩ := Set.not_subset.mp hr'
  obtain ⟨qf, hqf, hqfφ⟩ := exists_natDegree_le_algebraMap_pow_mul_aeval_eq S (hr hfI)
  -- The image `p` of `f/xʳ` in `(A ⧸ 𝔪)[X]` is nonzero: otherwise `f ∈ 𝔪ʳ⁺¹`.
  have hp := map_ne_zero_of_notMem_pow_succ S hxy hqf hqfφ hf
  set p := qf.map (Ideal.Quotient.mk (Ideal.span {x, y}))
  set p₀ := p * C p.leadingCoeff⁻¹ with hp₀_def
  have hp₀ : p₀.Monic := monic_mul_leadingCoeff_inv hp
  have hp₀r : p₀.natDegree ≤ r := by
    rw [natDegree_mul_C (inv_ne_zero (leadingCoeff_ne_zero.mpr hp))]
    exact natDegree_map_le.trans hqf
  -- Divide `ρ b` by `p₀`, and lift the remainder and the quotient.
  obtain ⟨q₁, hq₁, hq₁d⟩ := exists_natDegree_eq_of_mem_lifts
    (mem_lifts_of_surjective Ideal.Quotient.mk_surjective (ρ b %ₘ p₀))
  obtain ⟨a, ha⟩ := exists_divPow_eq_aeval_chartCoord S hx
    (hq₁d.trans_le ((natDegree_modByMonic_le _ hp₀).trans hp₀r))
  obtain ⟨q₂, hq₂⟩ := map_surjective _ Ideal.Quotient.mk_surjective
    (C p.leadingCoeff⁻¹ * (ρ b /ₘ p₀))
  obtain ⟨c, hc⟩ := hρker (b' := b - aeval (chartCoord S) q₁ -
    aeval (chartCoord S) qf * aeval (chartCoord S) q₂) (by
      rw [map_sub, map_sub, map_mul, hρ, hρ, hρ, hq₁, hq₂]
      linear_combination -(modByMonic_add_div (ρ b) p₀) + (ρ b /ₘ p₀) * hp₀_def)
  refine ⟨a, c, ?_⟩
  rw [ha, ← hc, sub_sub_cancel]
  refine Ideal.mul_mem_right _ _ (Submodule.mem_colon_singleton.mpr ?_)
  rw [smul_eq_mul, mul_comm, hqfφ]
  exact Ideal.mem_map_of_mem _ hfI

/-- **Zariski's colength inequality for quadratic transforms.** Let `x, y` be a weakly regular
sequence on `A` generating a maximal ideal `𝔪`, and let `I` be an ideal containing a power of `𝔪`,
with `I ⊆ 𝔪ʳ` but `I ⊄ 𝔪ʳ⁺¹`. On the chart `B = A[𝔪/x]` of the blowup of `Spec A` at `V(𝔪)`, the
transform `I' = (I B : xʳ)` of `I`, for which `I B = xʳ I'`, satisfies
`ℓ_A(B ⧸ I') + ℓ_A(A ⧸ 𝔪ʳ) ≤ ℓ_A(A ⧸ I)`. -/
theorem length_quotient_colon_add_length_quotient_pow_le (hxy : IsWeaklyRegular A [x, y])
    {I : Ideal A} {r s : ℕ} (hs : Ideal.span {x, y} ^ s ≤ I) (hr : I ≤ Ideal.span {x, y} ^ r)
    (hr' : ¬ I ≤ Ideal.span {x, y} ^ (r + 1)) :
    Module.length A ((Ideal.span {x, y}).affineBlowup x S ⧸
        (I.map (algebraMap A ((Ideal.span {x, y}).affineBlowup x S))).colon
          {algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ r}) +
      Module.length A (A ⧸ Ideal.span {x, y} ^ r) ≤ Module.length A (A ⧸ I) := by
  have hx : x ∈ Ideal.span {x, y} := Ideal.subset_span (by simp)
  set J := (I.map (algebraMap A ((Ideal.span {x, y}).affineBlowup x S))).colon
    {algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ r}
  -- Iterating the division with remainder, `B = 𝔪ʳ/xʳ + I' + xⁿ B` for every `n`.
  have hiter (n : ℕ) (b) : ∃ a c, b - divPow S hx r a -
      algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ n * c ∈ J := by
    induction n generalizing b with
    | zero => exact ⟨0, b, by simp⟩
    | succ n ih =>
      obtain ⟨a, c, h⟩ := ih b
      obtain ⟨a', c', h'⟩ := exists_sub_divPow_sub_mem_colon S hxy hr hr' c
      refine ⟨a + x ^ n • a', c', ?_⟩
      convert J.add_mem h (J.mul_mem_left
        (algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ n) h') using 1
      rw [map_add, map_smul, Algebra.smul_def, map_pow]
      ring
  -- A power of `x` lies in `I'`, since `I` contains a power of `𝔪`.
  have hxs : algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ s ∈ J := by
    rw [Submodule.mem_colon_singleton, smul_eq_mul, ← pow_add, ← map_pow]
    exact Ideal.mem_map_of_mem _
      (hs (Ideal.pow_le_pow_right (Nat.le_add_right s r) (Ideal.pow_mem_pow hx _)))
  -- So `a ↦ a/xʳ` maps `𝔪ʳ` onto `B ⧸ I'`, and it kills `I`.
  let Ψ := (Ideal.Quotient.mkₐ A J).toLinearMap ∘ₗ divPow S hx r
  have hΨ : Function.Surjective Ψ := by
    intro z
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨a, c, h⟩ := hiter s b
    refine ⟨a, (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr ?_⟩
    convert J.sub_mem (J.neg_mem h) (J.mul_mem_right c hxs) using 1
    ring
  have hker : Submodule.comap (Ideal.span {x, y} ^ r).subtype I ≤ LinearMap.ker Ψ := fun a ha ↦ by
    rw [LinearMap.mem_ker, LinearMap.comp_apply, AlgHom.toLinearMap_apply,
      Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, Submodule.mem_colon_singleton,
      smul_eq_mul, mul_comm, algebraMap_pow_mul_divPow]
    exact Ideal.mem_map_of_mem _ ha
  -- `ℓ(A ⧸ I) = ℓ(𝔪ʳ ⧸ I) + ℓ(A ⧸ 𝔪ʳ)`, and `B ⧸ I'` is a quotient of `𝔪ʳ ⧸ I`.
  rw [TauCeti.length_quotient_eq_length_quotient_comap_subtype_add hr]
  gcongr
  refine Module.length_le_of_surjective
    ((Submodule.comap (Ideal.span {x, y} ^ r).subtype I).liftQ Ψ hker) fun z ↦ ?_
  obtain ⟨a, rfl⟩ := hΨ z
  exact ⟨Submodule.Quotient.mk a, rfl⟩

/-- **The colength drops under a quadratic transform.** Let `x, y` be a weakly regular sequence
on `A` generating a maximal ideal `𝔪`, and let `I` be an ideal containing a power of `𝔪`, so of
finite colength, with `I ⊆ 𝔪ʳ` but `I ⊄ 𝔪ʳ⁺¹` for some `r ≠ 0`. Then the transform
`I' = (I B : xʳ)` on the chart `B = A[𝔪/x]` has `ℓ_A(B ⧸ I') < ℓ_A(A ⧸ I)`. -/
theorem length_quotient_colon_lt (hxy : IsWeaklyRegular A [x, y]) {I : Ideal A} {r s : ℕ}
    (hs : Ideal.span {x, y} ^ s ≤ I) (hr : I ≤ Ideal.span {x, y} ^ r)
    (hr' : ¬ I ≤ Ideal.span {x, y} ^ (r + 1)) (hr0 : r ≠ 0) :
    Module.length A ((Ideal.span {x, y}).affineBlowup x S ⧸
        (I.map (algebraMap A ((Ideal.span {x, y}).affineBlowup x S))).colon
          {algebraMap A ((Ideal.span {x, y}).affineBlowup x S) x ^ r}) <
      Module.length A (A ⧸ I) := by
  have h := length_quotient_colon_add_length_quotient_pow_le S hxy hs hr hr'
  -- `A ⧸ I` is a quotient of `A ⧸ 𝔪ˢ`, which has finite length as `𝔪` is finitely generated.
  have hI : Module.length A (A ⧸ I) ≠ ⊤ := ne_top_of_le_ne_top
    (Module.length_ne_top_iff.mpr (Ideal.isFiniteLength_quotient_pow_of_fg _
      (Submodule.fg_span (Set.toFinite _)) s)) (TauCeti.length_quotient_anti hs)
  -- `A ⧸ 𝔪ʳ` is nonzero, as `𝔪ʳ ⊆ 𝔪 ≠ A`.
  have : Nontrivial (A ⧸ Ideal.span {x, y} ^ r) :=
    Ideal.Quotient.nontrivial_iff.mpr (ne_top_of_le_ne_top (Ideal.IsMaximal.ne_top ‹_›)
      (Ideal.pow_le_self hr0))
  have ha := ne_top_of_le_ne_top hI (le_self_add.trans h)
  exact lt_of_lt_of_le (by simpa using (ENat.add_lt_add_iff_left ha).mpr Module.length_pos) h

end RingTheory.Sequence.IsWeaklyRegular
