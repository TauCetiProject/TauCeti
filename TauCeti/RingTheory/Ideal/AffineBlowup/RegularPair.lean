module

public import TauCeti.RingTheory.AdjoinRoot.Basic
public import TauCeti.RingTheory.Ideal.AffineBlowup.Basic

/-!
# The affine blowup algebra of a regular pair

Let `R` be a commutative ring and `a, g ∈ R` a regular pair: `a` is a nonzerodivisor on `R` and
`g` is a nonzerodivisor on `R ⧸ (a)`, that is, `a, g` is a weakly regular sequence on `R`
(`RingTheory.Sequence.IsWeaklyRegular R [a, g]`). Inside a localization `S` of `R` away from `a`,
the affine blowup algebra `R[g/a] = R[(a, g)/a]` is generated by the single fraction `g/a`, a root
of `aX - g`. This file shows that `aX - g` generates all the relations, so that `X ↦ g/a` is an
isomorphism `R[X] ⧸ (aX - g) ≃ₐ[R] R[g/a]`. The blowup algebra is thereby a hypersurface algebra
in one variable, to which flatness and syntomicity criteria for a single equation apply.

The key point is that `a` remains a nonzerodivisor on `R[X] ⧸ (aX - g)`: if `a h = (aX - g) k`,
then `g k = a (X k - h)`, so every coefficient of `k` lies in `(a)` because `g` is regular modulo
`a`; writing `k = a k'` and cancelling `a` gives `h = (aX - g) k'`. Since `aX = g` in
`R[X] ⧸ (aX - g)`, a power of `a` carries each of its elements to a constant. An element sent to
zero in `S` is therefore killed by a power of `a`, hence vanishes. These two facts about
`R[X] ⧸ (aX - g)`, which do not involve blowups, are
`RingTheory.Sequence.IsWeaklyRegular.isSMulRegular_adjoinRoot_C_mul_X_sub_C` and
`AdjoinRoot.exists_of_pow_mul_eq_of_C_mul_X_sub_C` in `TauCeti/RingTheory/AdjoinRoot/Basic.lean`.

The regularity of `g` modulo `a` cannot be dropped: for `R = ℤ` and `a = g = 2` the blowup algebra
`ℤ[2/2]` is `ℤ`, while `ℤ[X] ⧸ (2X - 2)` has the nonzero `2`-torsion class of `X - 1`.

## Main results

* `RingTheory.Sequence.IsWeaklyRegular.ker_aeval_divBy`: for a regular pair `a, g`, the kernel of
  `R[X] → R[1/a]`, `X ↦ g/a`, is generated by `aX - g`.
* `Ideal.adjoinRootEquivAffineBlowup`: for a regular pair `a, g`, the isomorphism
  `R[X] ⧸ (aX - g) ≃ₐ[R] R[g/a]` sending `X` to `g/a`.

## References

* The Stacks Project, Chapter *More on Algebra*, Lemma 15.32.2, for `H₁`-regular sequences,
  which include regular ones.
* K. Česnavičius, P. Scholze, *Purity for flat cohomology*, (2.3.6.1).
-/

public section

open Polynomial TauCeti.Localization RingTheory.Sequence

namespace Ideal

variable {R : Type*} [CommRing R] (a g : R) (S : Type*) [CommRing S] [Algebra R S]
  [IsLocalization.Away a S]

/-- The `R`-algebra map `R[X] ⧸ (aX - g) → S` sending `X` to `g/a`. -/
private noncomputable def toLocalization : AdjoinRoot (C a * X - C g) →ₐ[R] S :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId R S) (divBy g a) (by
    simp [eval₂_sub, algebraMap_mul_divBy])

private theorem toLocalization_mk (f : R[X]) :
    toLocalization a g S (AdjoinRoot.mk _ f) = aeval (divBy g a : S) f :=
  AdjoinRoot.liftAlgHom_mk _ _ _ _ f

variable {a g}

private theorem injective_toLocalization (hag : IsWeaklyRegular R [a, g]) :
    Function.Injective (toLocalization a g S) := by
  have ha : IsSMulRegular R a := ((isWeaklyRegular_cons_iff R a [g]).1 hag).1
  refine (injective_iff_map_eq_zero _).mpr fun x hx ↦ ?_
  obtain ⟨n, r, hr⟩ := x.exists_of_pow_mul_eq_of_C_mul_X_sub_C
  -- The constant `r` vanishes in `S`, hence in `R`, as `a` is a nonzerodivisor.
  have hr0 : r = 0 := by
    have h := congr_arg (toLocalization a g S) hr
    rw [map_mul, hx, mul_zero, ← AdjoinRoot.algebraMap_eq, AlgHom.commutes] at h
    refine (IsLocalization.Away.injective_iff_isRegular (S := S) a).mpr
      ((Commute.isRegular_iff (Commute.all a)).mpr (isLeftRegular_iff.mpr ha)) ?_
    rw [← h, map_zero]
  -- So `aⁿ x = 0`, and `a` is regular on `R[X] ⧸ (aX - g)`.
  refine (hag.isSMulRegular_adjoinRoot_C_mul_X_sub_C.pow n).right_eq_zero_of_smul ?_
  rw [Algebra.smul_def, AdjoinRoot.algebraMap_eq, hr, hr0, map_zero]

variable (a g) in
private theorem range_toLocalization :
    (toLocalization a g S).range = (span {a, g}).affineBlowup a S := by
  rw [affineBlowup_span_pair_eq_adjoin, Algebra.adjoin_singleton_eq_range_aeval]
  ext z
  refine ⟨?_, ?_⟩
  · rintro ⟨x, rfl⟩
    induction x using AdjoinRoot.induction_on with | ih f => ?_
    exact ⟨f, (toLocalization_mk a g S f).symm⟩
  · rintro ⟨f, rfl⟩
    exact ⟨AdjoinRoot.mk _ f, toLocalization_mk a g S f⟩

/-- **The kernel of `X ↦ g/a`.** For a weakly regular sequence `a, g` on `R`, the kernel of the
evaluation `R[X] → R[1/a]` at `g/a` is the ideal generated by `aX - g`. -/
theorem _root_.RingTheory.Sequence.IsWeaklyRegular.ker_aeval_divBy
    (hag : IsWeaklyRegular R [a, g]) :
    RingHom.ker (aeval (divBy g a : S)) = span {C a * X - C g} := by
  ext f
  rw [RingHom.mem_ker, ← toLocalization_mk, map_eq_zero_iff _ (injective_toLocalization S hag),
    AdjoinRoot.mk_eq_zero, mem_span_singleton]

/-- **The affine blowup algebra of a regular pair.** Let `a, g` be a weakly regular sequence on
`R`: `a` is a nonzerodivisor on `R` and `g` is a nonzerodivisor on `R ⧸ (a)`. Then `X ↦ g/a` is
an isomorphism from `R[X] ⧸ (aX - g)` onto the affine blowup algebra `R[g/a] = R[(a, g)/a]`
inside a localization `S` of `R` away from `a`. -/
noncomputable def adjoinRootEquivAffineBlowup (hag : IsWeaklyRegular R [a, g]) :
    AdjoinRoot (C a * X - C g) ≃ₐ[R] (span {a, g}).affineBlowup a S :=
  (AlgEquiv.ofInjective _ (injective_toLocalization S hag)).trans
    (Subalgebra.equivOfEq _ _ (range_toLocalization a g S))

/-- The isomorphism `R[X] ⧸ (aX - g) ≃ₐ[R] R[g/a]` evaluates polynomials at `g/a`. -/
@[simp]
theorem coe_adjoinRootEquivAffineBlowup_mk (hag : IsWeaklyRegular R [a, g]) (f : R[X]) :
    (adjoinRootEquivAffineBlowup S hag (AdjoinRoot.mk _ f) : S) = aeval (divBy g a : S) f :=
  toLocalization_mk a g S f

/-- The isomorphism `R[X] ⧸ (aX - g) ≃ₐ[R] R[g/a]` sends the class of `X` to `g/a`. -/
@[simp]
theorem coe_adjoinRootEquivAffineBlowup_root (hag : IsWeaklyRegular R [a, g]) :
    (adjoinRootEquivAffineBlowup S hag (AdjoinRoot.root _) : S) = divBy g a := by
  rw [← AdjoinRoot.mk_X, coe_adjoinRootEquivAffineBlowup_mk, aeval_X]

/-- The inverse of `R[X] ⧸ (aX - g) ≃ₐ[R] R[g/a]` sends `g/a` to the class of `X`. -/
@[simp]
theorem adjoinRootEquivAffineBlowup_symm_divBy (hag : IsWeaklyRegular R [a, g]) :
    (adjoinRootEquivAffineBlowup S hag).symm
        ⟨divBy g a, divBy_mem_affineBlowup (subset_span (Set.mem_insert_of_mem a rfl))⟩ =
      AdjoinRoot.root _ :=
  (AlgEquiv.symm_apply_eq _).mpr (Subtype.ext (coe_adjoinRootEquivAffineBlowup_root S hag).symm)

end Ideal
