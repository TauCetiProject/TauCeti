module

public import TauCeti.RingTheory.Ideal.AffineBlowup.Basic
public import TauCeti.RingTheory.Conductor

/-!
# The conductor of an affine blowup chart

If `I² ⊆ aI` and `a ∈ I`, then `Ideal.mem_affineBlowup_iff_exists_mul_eq` reduces the
fractions in `A[I/a]` to denominator `a`, using `Ideal.mem_affineBlowup_iff`.
For a nonzerodivisor `a`, `Ideal.conductor_affineBlowup_eq_colon` computes the conductor as
`((a) : I)`. The conductor is the maximal ideal in the nonprincipal nodal case by
`Ideal.conductor_affineBlowup_eq_of_isMaximal`.

See the Stacks Project, Tags 052P (blowup algebras) and 0C46 (nodal curves).
-/

public section

open TauCeti.Localization

namespace Ideal

variable {A S : Type*} [CommRing A] [CommRing S] [Algebra A S]
  {I : Ideal A} {a : A} [IsLocalization.Away a S]

/-- Adding the denominator to the generating ideal of `A[I/a]` does not change the algebra,
since the extra generator is `a/a = 1`. -/
@[simp]
theorem affineBlowup_sup_span_singleton : (I ⊔ span {a}).affineBlowup a S = I.affineBlowup a S := by
  have hspan : span (insert a (I : Set A)) = I ⊔ span {a} := by
    rw [span_insert, span_eq, sup_comm]
  -- The chart of the larger ideal is generated by the same fractions together with one.
  rw [affineBlowup_eq_adjoin_of_span_eq hspan, Set.image_insert_eq, divBy_self,
    Algebra.adjoin_insert_one, affineBlowup_def]

/-- If `a ∈ I` and `I² ⊆ aI`, every element of the chart `A[I/a]` has the form `b/a`
with `b ∈ I` (Stacks, Tag 052P). -/
theorem mem_affineBlowup_iff_exists_mul_eq (ha : a ∈ I)
    (hI : I ^ 2 ≤ span {a} * I) {z : S} :
    z ∈ I.affineBlowup a S ↔ ∃ b ∈ I, algebraMap A S a * z = algebraMap A S b := by
  rw [mem_affineBlowup_iff ha]
  refine ⟨?_, fun ⟨b, hb, hz⟩ ↦ ⟨1, b, by simpa only [pow_one] using hb,
    by simpa only [pow_one] using hz⟩⟩
  have hpow (n : ℕ) : I ^ (n + 1) ≤ span {a ^ n} * I := by
    induction n with
    | zero => simp
    | succ n ih =>
      calc
        I ^ (n + 1 + 1) = I ^ (n + 1) * I := pow_succ _ _
        _ ≤ (span {a ^ n} * I) * I := Ideal.mul_mono_left ih
        _ ≤ span {a ^ n} * (span {a} * I) := by
          rw [mul_assoc, ← pow_two]
          exact Ideal.mul_mono_right hI
        _ = span {a ^ (n + 1)} * I := by
          rw [← mul_assoc, span_singleton_mul_span_singleton, pow_succ]
  rintro ⟨n, b, hb, hz⟩
  cases n with
  | zero =>
    simp only [pow_zero, one_mul] at hz
    exact ⟨a * b, I.mul_mem_right b ha, by rw [hz, map_mul]⟩
  | succ n =>
    obtain ⟨c, hc, hcb⟩ := mem_span_singleton_mul.mp (hpow n hb)
    refine ⟨c, hc, ((IsLocalization.Away.algebraMap_isUnit (S := S) a).pow n).mul_left_cancel ?_⟩
    -- Multiplying by the common denominator reduces the equality to the numerator relation.
    rw [← mul_assoc, ← pow_succ, hz, ← map_pow, ← map_mul, hcb]

/-- If `a` is a nonzerodivisor, the conductor of `A → A[I/a]` is contained in
`((a) : I)`, since every `b/a` for `b ∈ I` lies in the chart. -/
theorem conductor_affineBlowup_le_colon (ha₀ : a ∈ nonZeroDivisors A) :
    TauCeti.Algebra.conductor A (I.affineBlowup a S) ≤ (span {a}).colon (I : Set A) := by
  intro r hr
  refine Submodule.mem_colon.mpr fun b hb ↦ ?_
  let z : I.affineBlowup a S := ⟨divBy b a, divBy_mem_affineBlowup hb⟩
  obtain ⟨c, hc⟩ := TauCeti.Algebra.mem_conductor_iff.mp hr z
  have hcz : algebraMap A S c = algebraMap A S r * divBy b a :=
    congrArg Subtype.val hc
  refine mem_span_singleton'.mpr ⟨c, IsLocalization.injective S
    (Submonoid.powers_le.mpr ha₀) ?_⟩
  simp only [smul_eq_mul, map_mul, hcz]
  rw [mul_right_comm, mul_assoc, algebraMap_mul_divBy]

/-- For a nonzerodivisor `a` with `I² ⊆ aI`, the conductor of `A → A[I/a]`
is the colon ideal `((a) : I)`. -/
theorem conductor_affineBlowup_eq_colon (ha₀ : a ∈ nonZeroDivisors A)
    (hI : I ^ 2 ≤ span {a} * I) :
    TauCeti.Algebra.conductor A (I.affineBlowup a S) = (span {a}).colon (I : Set A) := by
  refine le_antisymm (conductor_affineBlowup_le_colon ha₀) ?_
  intro r hr
  have hrI := Submodule.mem_colon.mp hr
  refine TauCeti.Algebra.mem_conductor_iff.mpr fun z ↦ ?_
  let J := I ⊔ span {a}
  have haJ : a ∈ J := mem_sup_right (mem_span_singleton_self a)
  have hJ : J ^ 2 ≤ span {a} * J := by
    have hmul : span {a} * I ≤ span {a} * J := Ideal.mul_mono_right le_sup_left
    rw [pow_two, sup_mul, mul_sup I]
    exact sup_le (sup_le ((pow_two I ▸ hI).trans hmul)
      ((mul_comm I (span {a})).le.trans hmul)) le_rfl
  have hzJ : (z : S) ∈ J.affineBlowup a S := by
    simpa only [J, affineBlowup_sup_span_singleton] using z.property
  obtain ⟨b, hb, hz⟩ := (mem_affineBlowup_iff_exists_mul_eq haJ hJ).mp hzJ
  have hb' : r * b ∈ span {a} := by
    obtain ⟨i, hi, j, hj, rfl⟩ := Submodule.mem_sup.mp hb
    rw [mul_add]
    exact Ideal.add_mem _ (hrI i hi) (Ideal.mul_mem_left _ _ hj)
  obtain ⟨c, hc⟩ := mem_span_singleton'.mp hb'
  have hu := IsLocalization.Away.algebraMap_isUnit (S := S) a
  refine ⟨c, Subtype.ext (hu.mul_left_cancel ?_)⟩
  have hmul : a * c = r * b := (mul_comm a c).trans hc
  simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
  rw [← map_mul, hmul, map_mul, ← hz, mul_left_comm]

/-- A maximal ideal `I` with `I² ⊆ aI` not contained in `(a)` is the conductor of
`A[I/a]` for a nonzerodivisor `a`. At a node, `I` is nonprincipal and `a ∈ I`,
so `I` is not contained in `(a)` (Stacks, Tag 0C46). -/
theorem conductor_affineBlowup_eq_of_isMaximal [I.IsMaximal] (ha₀ : a ∈ nonZeroDivisors A)
    (hI : I ^ 2 ≤ span {a} * I) (hle : ¬ I ≤ span {a}) :
    TauCeti.Algebra.conductor A (I.affineBlowup a S) = I := by
  refine (conductor_affineBlowup_eq_colon (S := S) ha₀ hI).trans ?_
  have htop : (span {a}).colon (I : Set A) ≠ ⊤ := fun h ↦
    hle (Submodule.colon_eq_top_iff_subset.mp h)
  refine (‹I.IsMaximal›.eq_of_le htop ?_).symm
  intro r hr
  refine Submodule.mem_colon.mpr fun b hb ↦ ?_
  have hrb : r * b ∈ I ^ 2 := by
    rw [pow_two]
    exact mul_mem_mul hr hb
  exact Ideal.mul_le_left (hI hrb)

end Ideal
