/-!
# Fixed-point ideals of families of endomorphisms

Given a family `f : ι → F` of endomorphisms of a ring `A`, the fixed-point ideal
`TauCeti.fixedPointsIdeal f` is the ideal generated by all differences `f i a - a`.
When `A` is a commutative `R`-algebra, the quotient `A ⧸ fixedPointsIdeal f` represents the
fixed-point subfunctor of `Spec A`: `R`-algebra homomorphisms out of the quotient correspond
naturally to `R`-algebra homomorphisms `g : A →ₐ[R] T` satisfying `g (f i a) = g a` for every `i`
and `a`.

When each `f i` is an `R`-algebra endomorphism and `A` is generated as an `R`-algebra by a set `s`,
the fixed-point ideal is already generated by the differences `f i a - a` for `a ∈ s`. In
particular, for a finite index set `ι` and a finite-type (resp. finitely presented) `R`-algebra
`A`, the fixed-point ideal is finitely generated and the fixed-point quotient is finitely
presented over `R`. Formation of the fixed-point ideal also commutes with arbitrary base change
`S ⊗[R] -`.

## Main definitions

* `TauCeti.fixedPointsIdeal`: the ideal generated by all differences `f i a - a`.
* `TauCeti.quotientFixedPointsAlgHomEquiv`: the universal property identifying `R`-algebra
  homomorphisms out of `A ⧸ fixedPointsIdeal f` with invariant `R`-algebra homomorphisms out of
  `A`.

## Main results

* `TauCeti.fixedPointsIdeal_le_ker_iff`: a ring homomorphism kills `fixedPointsIdeal f` iff it
  coequalizes every `f i` with the identity.
* `TauCeti.instIsTwoSided_fixedPointsIdeal`: for ring endomorphisms, `fixedPointsIdeal f` is
  two-sided even without commutativity of `A`.
* `TauCeti.fixedPointsIdeal_eq_span_of_adjoin_eq_top`: algebra generators of `A` yield ideal
  generators of `fixedPointsIdeal f`.
* `TauCeti.fg_fixedPointsIdeal` and `TauCeti.finitePresentation_quotient_fixedPointsIdeal`:
  finiteness and finite presentation of the fixed-point quotient for finite index sets.
* `TauCeti.fixedPointsIdeal_lTensor`: base change commutes with forming the fixed-point ideal.

## References

* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), Proposition 3.1,
  p. 293.
-/

public section

open scoped TensorProduct

namespace TauCeti

section Basic

variable {A : Type*} [Ring A] {ι : Sort*} {F : Type*} [FunLike F A A]

/-- The **fixed-point ideal** of a family of maps `f : ι → F` on a ring `A`, defined as the ideal
generated by all differences `f i a - a`.

When `A` is a commutative `R`-algebra, the quotient `A ⧸ fixedPointsIdeal f` corepresents the
fixed-point subfunctor of `Spec A` under the family `f`. -/
def fixedPointsIdeal (f : ι → F) : Ideal A :=
  Ideal.span {x : A | ∃ (i : ι) (a : A), f i a - a = x}

/-- The defining generating set of `fixedPointsIdeal f`. -/
theorem fixedPointsIdeal_eq_span (f : ι → F) :
    fixedPointsIdeal f = Ideal.span {x : A | ∃ (i : ι) (a : A), f i a - a = x} :=
  (rfl)

/-- Every difference `f i a - a` belongs to `fixedPointsIdeal f`. -/
theorem sub_mem_fixedPointsIdeal (f : ι → F) (i : ι) (a : A) :
    f i a - a ∈ fixedPointsIdeal f :=
  Ideal.subset_span ⟨i, a, rfl⟩

/-- Universal property of `fixedPointsIdeal f` among ideals of `A`. -/
theorem fixedPointsIdeal_le_iff {f : ι → F} {J : Ideal A} :
    fixedPointsIdeal f ≤ J ↔ ∀ i a, f i a - a ∈ J := by
  rw [fixedPointsIdeal, Ideal.span_le]
  exact ⟨fun h i a ↦ h ⟨i, a, rfl⟩, by rintro h _ ⟨i, a, rfl⟩; exact h i a⟩

/-- The fixed-point ideal of a family is the supremum of the individual fixed-point ideals. -/
theorem fixedPointsIdeal_eq_iSup (f : ι → F) :
    fixedPointsIdeal f = ⨆ i : ι, Ideal.span (Set.range fun a : A ↦ f i a - a) := by
  refine le_antisymm ?_ (iSup_le fun i ↦ Ideal.span_le.mpr ?_)
  · exact fixedPointsIdeal_le_iff.mpr fun i a ↦
      le_iSup (fun j : ι ↦ Ideal.span (Set.range fun b : A ↦ f j b - b)) i
        (Ideal.subset_span ⟨a, rfl⟩)
  · rintro _ ⟨a, rfl⟩
    exact sub_mem_fixedPointsIdeal f i a

/-- A ring homomorphism kills `fixedPointsIdeal f` if and only if it is invariant under every
`f i`. -/
theorem fixedPointsIdeal_le_ker_iff {B : Type*} [Ring B] {f : ι → F} (φ : A →+* B) :
    fixedPointsIdeal f ≤ RingHom.ker φ ↔ ∀ i a, φ (f i a) = φ a := by
  rw [fixedPointsIdeal_le_iff]
  refine forall₂_congr fun i a ↦ ?_
  rw [RingHom.mem_ker, map_sub, sub_eq_zero]

/-- The fixed-point ideal vanishes if and only if every `f i` acts as the identity. -/
theorem fixedPointsIdeal_eq_bot_iff {f : ι → F} :
    fixedPointsIdeal f = ⊥ ↔ ∀ i a, f i a = a := by
  rw [← le_bot_iff, fixedPointsIdeal_le_iff]
  exact forall₂_congr fun i a ↦ by rw [Ideal.mem_bot, sub_eq_zero]

/-- The fixed-point ideal of a constant family of identity ring homomorphisms is zero. -/
@[simp]
theorem fixedPointsIdeal_id (ι : Sort*) :
    fixedPointsIdeal (fun _ : ι ↦ RingHom.id A) = ⊥ :=
  fixedPointsIdeal_eq_bot_iff.mpr fun _ _ ↦ rfl

/-- Two families with the same pointwise action define the same fixed-point ideal. -/
theorem fixedPointsIdeal_congr {F' : Type*} [FunLike F' A A] {f : ι → F} {g : ι → F'}
    (h : ∀ i a, f i a = g i a) : fixedPointsIdeal f = fixedPointsIdeal g := by
  refine le_antisymm (fixedPointsIdeal_le_iff.mpr fun i a ↦ ?_)
    (fixedPointsIdeal_le_iff.mpr fun i a ↦ ?_)
  · rw [h i a]
    exact sub_mem_fixedPointsIdeal g i a
  · rw [← h i a]
    exact sub_mem_fixedPointsIdeal f i a

/-- Reindexing along a surjection does not change the fixed-point ideal. -/
theorem fixedPointsIdeal_comp_surjective {κ : Sort*} (f : ι → F) {e : κ → ι}
    (he : Function.Surjective e) : fixedPointsIdeal (f ∘ e) = fixedPointsIdeal f := by
  refine le_antisymm
    (fixedPointsIdeal_le_iff.mpr fun k a ↦ sub_mem_fixedPointsIdeal f (e k) a)
    (fixedPointsIdeal_le_iff.mpr fun i a ↦ ?_)
  obtain ⟨k, rfl⟩ := he i
  exact sub_mem_fixedPointsIdeal (f ∘ e) k a

/-- For a family of ring endomorphisms, `fixedPointsIdeal f` is automatically a two-sided ideal,
even when `A` is noncommutative. -/
instance instIsTwoSided_fixedPointsIdeal [RingHomClass F A A] (f : ι → F) :
    (fixedPointsIdeal f).IsTwoSided := by
  refine ⟨fun {x} b hx ↦ ?_⟩
  induction hx using Submodule.span_induction with
  | mem y hy =>
    rcases hy with ⟨i, a, rfl⟩
    have hmul : (f i a - a) * b = (f i (a * b) - a * b) - f i a * (f i b - b) := by
      rw [map_mul, sub_mul, mul_sub]
      abel
    rw [hmul]
    exact sub_mem (sub_mem_fixedPointsIdeal f i (a * b))
      (Ideal.mul_mem_left _ _ (sub_mem_fixedPointsIdeal f i b))
  | zero =>
    rw [zero_mul]
    exact zero_mem _
  | add y z _ _ hy hz =>
    rw [add_mul]
    exact add_mem hy hz
  | smul c y _ hy =>
    rw [smul_eq_mul, mul_assoc]
    exact Ideal.mul_mem_left _ _ hy

end Basic

section SurjectiveMap

variable {A B : Type*} [Ring A] [Ring B] {ι : Sort*}
variable {G : Type*} [FunLike G A B] [RingHomClass G A B]
variable {F₁ : Type*} [FunLike F₁ A A] {F₂ : Type*} [FunLike F₂ B B]

/-- A surjective ring homomorphism intertwining two families pushes the fixed-point ideal of the
source forward to the fixed-point ideal of the target. -/
theorem map_fixedPointsIdeal_of_surjective (φ : G) (hφ : Function.Surjective φ)
    (f : ι → F₁) (g : ι → F₂) (hfg : ∀ i a, φ (f i a) = g i (φ a)) :
    Ideal.map φ (fixedPointsIdeal f) = fixedPointsIdeal g := by
  refine le_antisymm ?_ ?_
  · rw [Ideal.map_le_iff_le_comap, fixedPointsIdeal_le_iff]
    intro i a
    rw [Ideal.mem_comap, map_sub, hfg i a]
    exact sub_mem_fixedPointsIdeal g i (φ a)
  · rw [fixedPointsIdeal_le_iff]
    intro i b
    obtain ⟨a, rfl⟩ := hφ b
    rw [← hfg i a, ← map_sub]
    exact Ideal.mem_map_of_mem φ (sub_mem_fixedPointsIdeal f i a)

end SurjectiveMap

section UniversalProperty

variable {R A T : Type*} [CommSemiring R] [CommRing A] [Algebra R A] [CommRing T] [Algebra R T]
variable {ι : Sort*} {F : Type*} [FunLike F A A]

/-- **Universal property of the fixed-point quotient.** An `R`-algebra homomorphism out of
`A ⧸ fixedPointsIdeal f` corresponds naturally to an `R`-algebra homomorphism `g : A →ₐ[R] T`
invariant under every `f i`. -/
noncomputable def quotientFixedPointsAlgHomEquiv (f : ι → F) :
    (A ⧸ fixedPointsIdeal f →ₐ[R] T) ≃ { g : A →ₐ[R] T // ∀ i a, g (f i a) = g a } where
  toFun q := ⟨q.comp (Ideal.Quotient.mkₐ R (fixedPointsIdeal f)), fun i a ↦ by
    have hsub : Ideal.Quotient.mkₐ R (fixedPointsIdeal f) (f i a - a) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (sub_mem_fixedPointsIdeal f i a)
    have hq : q (Ideal.Quotient.mkₐ R (fixedPointsIdeal f) (f i a - a)) = 0 := by
      rw [hsub, map_zero]
    rw [map_sub, map_sub, sub_eq_zero] at hq
    exact hq⟩
  invFun g := Ideal.Quotient.liftₐ (fixedPointsIdeal f) g.1 fun a ha ↦
    RingHom.mem_ker.mp ((fixedPointsIdeal_le_ker_iff g.1.toRingHom).mpr g.2 ha)
  left_inv q := by
    ext x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rfl
  right_inv g := by
    ext a
    rfl

/-- The forward direction of `quotientFixedPointsAlgHomEquiv` precomposes with the quotient map. -/
@[simp]
theorem quotientFixedPointsAlgHomEquiv_apply (f : ι → F)
    (q : A ⧸ fixedPointsIdeal f →ₐ[R] T) :
    (quotientFixedPointsAlgHomEquiv f q : A →ₐ[R] T) =
      q.comp (Ideal.Quotient.mkₐ R (fixedPointsIdeal f)) :=
  (rfl)

/-- The inverse direction of `quotientFixedPointsAlgHomEquiv` evaluates on a coset by applying the
underlying invariant homomorphism. -/
@[simp]
theorem quotientFixedPointsAlgHomEquiv_symm_apply_mk (f : ι → F)
    (g : { g : A →ₐ[R] T // ∀ i a, g (f i a) = g a }) (a : A) :
    (quotientFixedPointsAlgHomEquiv f).symm g (Ideal.Quotient.mk (fixedPointsIdeal f) a) =
      g.1 a :=
  (rfl)

/-- `quotientFixedPointsAlgHomEquiv` is natural in the target `R`-algebra `T`. -/
theorem quotientFixedPointsAlgHomEquiv_naturality {T' : Type*} [CommRing T'] [Algebra R T']
    (f : ι → F) (ψ : T →ₐ[R] T') (q : A ⧸ fixedPointsIdeal f →ₐ[R] T) :
    (quotientFixedPointsAlgHomEquiv f (ψ.comp q) : A →ₐ[R] T') =
      ψ.comp (quotientFixedPointsAlgHomEquiv f q : A →ₐ[R] T) :=
  (rfl)

end UniversalProperty

section GeneratorsAndFiniteness

variable {R A : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
variable {ι : Sort*} {F : Type*} [FunLike F A A] [AlgHomClass F R A A]

/-- If `s` generates `A` as an `R`-algebra, then the differences `f i a - a` for `a ∈ s` already
generate `fixedPointsIdeal f` as an ideal of `A`. -/
theorem fixedPointsIdeal_eq_span_of_adjoin_eq_top (f : ι → F) {s : Set A}
    (hs : Algebra.adjoin R s = ⊤) :
    fixedPointsIdeal f = Ideal.span {x : A | ∃ (i : ι), ∃ a ∈ s, f i a - a = x} := by
  let I₀ : Ideal A := Ideal.span {x : A | ∃ (i : ι), ∃ a ∈ s, f i a - a = x}
  refine le_antisymm ?_ (Ideal.span_mono fun x hx ↦ ?_)
  · let S : Subalgebra R A :=
      { carrier := {a : A | ∀ i, f i a - a ∈ I₀}
        mul_mem' := fun {a b} ha hb i ↦ by
          have hmul : f i (a * b) - a * b = f i a * (f i b - b) + (f i a - a) * b := by
            rw [map_mul]
            ring
          rw [hmul]
          exact add_mem (Ideal.mul_mem_left _ _ (hb i)) (Ideal.mul_mem_right _ _ (ha i))
        add_mem' := fun {a b} ha hb i ↦ by
          have hadd : f i (a + b) - (a + b) = (f i a - a) + (f i b - b) := by
            rw [map_add]
            ring
          rw [hadd]
          exact add_mem (ha i) (hb i)
        algebraMap_mem' := fun r i ↦ by
          rw [AlgHomClass.commutes, sub_self]
          exact zero_mem I₀ }
    have hsS : s ⊆ (S : Set A) := fun a ha i ↦ Ideal.subset_span ⟨i, a, ha, rfl⟩
    have hStop : S = ⊤ := eq_top_iff.mpr (hs ▸ Algebra.adjoin_le hsS)
    exact fixedPointsIdeal_le_iff.mpr fun i a ↦ (hStop.symm ▸ trivial : a ∈ S) i
  · rcases hx with ⟨i, a, _, rfl⟩
    exact ⟨i, a, rfl⟩

/-- The fixed-point ideal of a finite family of `R`-algebra endomorphisms of a finite-type
`R`-algebra is finitely generated. -/
theorem fg_fixedPointsIdeal [Algebra.FiniteType R A] {ι : Type*} [Finite ι] (f : ι → F) :
    (fixedPointsIdeal f).FG := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := A)
  rw [fixedPointsIdeal_eq_span_of_adjoin_eq_top f hs]
  have hfin : Set.Finite {x : A | ∃ (i : ι), ∃ a ∈ (s : Set A), f i a - a = x} := by
    have heq : {x : A | ∃ (i : ι), ∃ a ∈ (s : Set A), f i a - a = x} =
        (fun p : ι × A ↦ f p.1 p.2 - p.2) '' ((Set.univ : Set ι) ×ˢ (s : Set A)) := by
      ext x
      simp
    rw [heq]
    exact (Set.finite_univ.prod s.finite_toSet).image _
  exact ⟨hfin.toFinset, by rw [Set.Finite.coe_toFinset]⟩

/-- The fixed-point quotient of a finitely presented `R`-algebra under a finite family of
`R`-algebra endomorphisms is finitely presented over `R`. -/
theorem finitePresentation_quotient_fixedPointsIdeal {R : Type*} [CommRing R] {A : Type*}
    [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A]
    {ι : Type*} [Finite ι] {F : Type*} [FunLike F A A] [AlgHomClass F R A A] (f : ι → F) :
    Algebra.FinitePresentation R (A ⧸ fixedPointsIdeal f) :=
  Algebra.FinitePresentation.quotient (fg_fixedPointsIdeal (R := R) f)

end GeneratorsAndFiniteness

section BaseChange

variable {R A S : Type*} [CommSemiring R] [CommRing A] [Algebra R A] [CommRing S] [Algebra R S]
variable {ι : Sort*}

/-- Formation of the fixed-point ideal commutes with base change along `R → S`. -/
theorem fixedPointsIdeal_lTensor (f : ι → A →ₐ[R] A) :
    fixedPointsIdeal (fun i ↦ Algebra.TensorProduct.lTensor (S := S) S (f i)) =
      Ideal.map (Algebra.TensorProduct.includeRight (R := R) (A := S) (B := A)).toRingHom
        (fixedPointsIdeal f) := by
  refine le_antisymm ?_ ?_
  · rw [fixedPointsIdeal_le_iff]
    intro i t
    induction t with
    | tmul s a =>
      have htmul : Algebra.TensorProduct.lTensor (S := S) S (f i) (s ⊗ₜ[R] a) - s ⊗ₜ[R] a =
          (s ⊗ₜ[R] (1 : A)) *
            Algebra.TensorProduct.includeRight (R := R) (A := S) (B := A) (f i a - a) := by
        rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
          one_mul, TensorProduct.tmul_sub]
        rfl
      rw [htmul]
      exact Ideal.mul_mem_left _ _
        (Ideal.mem_map_of_mem _ (sub_mem_fixedPointsIdeal f i a))
    | add x y hx hy =>
      have hadd : Algebra.TensorProduct.lTensor (S := S) S (f i) (x + y) - (x + y) =
          (Algebra.TensorProduct.lTensor (S := S) S (f i) x - x) +
            (Algebra.TensorProduct.lTensor (S := S) S (f i) y - y) := by
        rw [map_add]
        ring
      rw [hadd]
      exact add_mem hx hy
  · rw [Ideal.map_le_iff_le_comap, fixedPointsIdeal_le_iff]
    intro i a
    rw [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      Algebra.TensorProduct.includeRight_apply, TensorProduct.tmul_sub]
    exact sub_mem_fixedPointsIdeal (fun j ↦ Algebra.TensorProduct.lTensor (S := S) S (f j)) i
      (1 ⊗ₜ[R] a)

end BaseChange

