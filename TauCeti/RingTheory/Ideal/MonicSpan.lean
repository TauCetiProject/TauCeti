module

public import Mathlib.Algebra.Module.SpanRank
public import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.Algebra.Field.Equiv
import Mathlib.RingTheory.Ideal.MonicSpan
import Mathlib.RingTheory.Polynomial.Quotient

/-!
# Generators of polynomial ideals over a maximal contraction

Let `P` be an ideal of `R[X]` whose contraction `p` to `R` is maximal. Then `P` is the extension
of `p`, or it is generated by `p` together with one monic polynomial, which lifts a generator of
the image of `P` in the principal ideal domain `(R ⧸ p)[X]`
(`Polynomial.exists_monic_span_sup_map_eq`). So `P` needs at most one generator more than `p`.
This is the step that bounds the number of generators of maximal ideals in an induction on the
number of variables.

## Main results

* `Polynomial.spanFinrank_le_spanFinrank_comap_C_add_one`: an ideal of `R[X]` whose contraction
  `p` to `R` is maximal and finitely generated is generated by `spanFinrank p + 1` elements.
* `Ideal.IsMaximal.ne_map_C`: a maximal ideal of `A[X]` is never extended from an ideal of
  `A`.

## References

* The bound is extracted from the proof of Mathlib's
  `Polynomial.isRegularLocalRing_localization_atPrime_of_comap_eq_maximalIdeal`.
-/

public section

open Ideal

namespace Polynomial

variable {R : Type*} [CommRing R]

/-- An ideal of `R[X]` whose contraction `p` to `R` is maximal and finitely generated is
generated by `spanFinrank p + 1` elements. -/
theorem spanFinrank_le_spanFinrank_comap_C_add_one (P : Ideal R[X]) (hP : (P.comap C).IsMaximal)
    (hfg : (P.comap C).FG) : P.spanFinrank ≤ (P.comap C).spanFinrank + 1 := by
  set p := P.comap C
  by_cases hPp : P = p.map C
  · rw [hPp]
    exact (Ideal.spanFinrank_map_le_of_fg C hfg).trans (Nat.le_succ _)
  -- Otherwise `P` is generated by `p` and one monic polynomial `f`.
  obtain ⟨f, -, hf⟩ := exists_monic_span_sup_map_eq R P hP hPp
  have hspan : Ideal.span p.generators = p := p.span_generators
  have hP' : P = Ideal.span (C '' p.generators ∪ {f}) := by
    rw [Ideal.span_union, ← Ideal.map_span, hspan, ← hf]
  -- `Ideal.FG` is by definition `Submodule.FG`, which carries the `generators` API.
  have hfg' : Submodule.FG p := hfg
  have hfin := hfg'.finite_generators
  rw [hP']
  refine (Submodule.spanFinrank_span_le_ncard_of_finite
    ((hfin.image _).union (Set.finite_singleton _))).trans ?_
  refine (Set.ncard_union_le _ _).trans ?_
  rw [Set.ncard_singleton, ← hfg'.generators_ncard]
  gcongr
  exact Set.ncard_image_le hfin

end Polynomial

namespace Ideal.IsMaximal

open Polynomial in
/-- A maximal ideal of `A[X]` is never extended from an ideal of `A`: if `P = I A[X]`, then
`A[X] ⧸ P ≃ (A ⧸ I)[X]` would be a field. -/
theorem ne_map_C {A : Type*} [CommRing A] {P : Ideal A[X]} (hP : P.IsMaximal) (I : Ideal A) :
    P ≠ I.map C := by
  rintro rfl
  refine Polynomial.not_isField (A ⧸ I)
    (MulEquiv.isField ?_ I.polynomialQuotientEquivQuotientPolynomial.toMulEquiv)
  exact (Quotient.maximal_ideal_iff_isField_quotient _).1 hP

end Ideal.IsMaximal
