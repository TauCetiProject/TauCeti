module

public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Transport of ideals along ring maps

An algebra equivalence transports a principal ideal to the ideal generated by the transported
element, and its annihilator to the annihilator of that ideal. The result below applies to ideals
extended from a common commutative semiring, without assuming the algebras commutative.
The file also lifts generators of an ideal from a principal quotient: adjoining the kernel
generator to lifts of quotient generators recovers the original ideal.
-/

public section

namespace AlgEquiv

/-- If the extensions of two ideals to `L'` are a principal ideal and its annihilator, the
extensions to an equivalent `A`-algebra `L` have the same form. -/
theorem map_eq_span_singleton_and_annihilator {A L L' : Type*} [CommSemiring A]
    [Semiring L] [Semiring L'] [Algebra A L] [Algebra A L'] (e : L ≃ₐ[A] L')
    {𝔞 𝔟 : Ideal A} {a' : L'} (h𝔞 : 𝔞.map (algebraMap A L') = Ideal.span {a'})
    (h𝔟 : 𝔟.map (algebraMap A L') = (Ideal.span {a'}).annihilator) :
    𝔞.map (algebraMap A L) = Ideal.span {e.symm a'} ∧
      𝔟.map (algebraMap A L) = (Ideal.span {e.symm a'}).annihilator := by
  have hmap (𝔠 : Ideal A) :
      𝔠.map (algebraMap A L) = (𝔠.map (algebraMap A L')).comap e.toRingEquiv := by
    rw [← e.symm.toAlgHom.comp_algebraMap, ← Ideal.map_map, AlgEquiv.toRingHom_toAlgHom,
      Ideal.map_comap_of_equiv, AlgEquiv.symm_toRingEquiv, RingEquiv.symm_symm]
  have hspan : (Ideal.span {a'}).comap e.toRingEquiv = Ideal.span {e.symm a'} := by
    rw [← Ideal.map_symm, Ideal.map_span, Set.image_singleton]
    simp
  refine ⟨by rw [hmap, h𝔞, hspan], ?_⟩
  rw [hmap, h𝔟, ← hspan]
  ext x
  simp only [Ideal.mem_comap, Submodule.mem_annihilator, smul_eq_mul,
    AlgEquiv.coe_toRingEquiv]
  constructor
  · intro hx y hy
    exact e.injective (by simpa only [map_mul, map_zero] using hx (e y) hy)
  · intro hx y hy
    simpa only [map_mul, e.apply_symm_apply, map_zero] using
      congrArg e (hx (e.symm y) (by simpa only [e.apply_symm_apply] using hy))

end AlgEquiv

namespace Ideal

variable {ring : Type*} [CommRing ring]

/-- If the image of an ideal in a principal quotient is generated by the images of a set,
adjoining the kernel generator to that set generates the original ideal. -/
theorem span_insert_eq_of_quotient (ideal : Ideal ring) {parameter : ring}
    (hmem : parameter ∈ ideal) (generators : Set ring)
    (himage : span ((Ideal.Quotient.mk (span {parameter})) '' generators) =
      ideal.map (Ideal.Quotient.mk (span {parameter}))) :
    span (insert parameter generators) = ideal := by
  have hmap : (span (insert parameter generators)).map (Ideal.Quotient.mk (span {parameter})) =
      ideal.map (Ideal.Quotient.mk (span {parameter})) := by
    rw [map_span, Set.image_insert_eq, Ideal.Quotient.eq_zero_iff_mem.mpr
      (mem_span_singleton_self parameter), span_insert_zero, himage]
  have heq := (map_eq_iff_sup_ker_eq_of_surjective _ Ideal.Quotient.mk_surjective).mp hmap
  rw [Ideal.mk_ker, sup_of_le_left (span_mono (Set.singleton_subset_iff.mpr
    (Set.mem_insert parameter generators))), sup_of_le_left
      ((span_singleton_le_iff_mem _).mpr hmem)] at heq
  exact heq

end Ideal
