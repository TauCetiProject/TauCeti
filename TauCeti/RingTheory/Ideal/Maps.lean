module

public import Mathlib.RingTheory.Ideal.Maps
import Mathlib.Algebra.Algebra.Tower

/-!
# Transport of ideals along ring homomorphisms

Taking radicals before extending an ideal does not change the radical of its extension. Extension
commutes with finite products of ideals. Powers of ideals commute with pullback along a ring
equivalence, a homomorphism of possibly noncommutative rings carrying `I` into `J` carries each
power of `I` into the same power of `J`, the powers of the image of an ideal along a surjective
homomorphism of possibly noncommutative rings lie in the image of its powers, and extension along a
bijective ring homomorphism preserves and reflects primality. An endomorphism congruent to a power
map modulo a radical ideal, such as a Frobenius lift, pulls that ideal back to itself. Extension
preserves coprimality to an ideal whose contraction is coprime to the original ideal. Extending an
ideal to an algebra and then along an algebra homomorphism or through a scalar tower is extending it
directly, so an algebra homomorphism carries each power of the principal ideal generated by an
algebra scalar into the corresponding power in the target algebra. An algebra equivalence transports
a principal ideal to the ideal generated by the transported element, and its annihilator to the
annihilator of that ideal. The principal-ideal result applies to ideals extended from a common
commutative semiring, without assuming the algebras commutative.

If `t ∈ I` and `r • I ≤ (t)`, then `I` extends to the principal ideal `(f t)` along every ring
homomorphism `f` for which `f r` is a unit. Extending an ideal spanned by an indexed family along
a ring homomorphism gives the ideal spanned by its pointwise image (`Ideal.map_span_range_eq`).
An ideal extended along a ring homomorphism into a finite product is the product of its component
extensions.

If the images of any two elements of `I` are comparable for divisibility, as when the source or
target is a valuation ring, the extension of `I` consists of the multiples of images of elements
of `I`. The greatest ideal whose contraction is contained in a prime `p` is prime.
-/

public section

namespace Ideal

/-- Taking the radical before extending an ideal does not change the radical of its extension. -/
@[simp]
theorem radical_map_radical {R S F : Type*} [CommSemiring R] [CommSemiring S]
    [FunLike F R S] [RingHomClass F R S] (I : Ideal R) (f : F) :
    (I.radical.map f).radical = (I.map f).radical :=
  le_antisymm (radical_le_radical_iff.mpr (map_radical_le f))
    (radical_mono (map_mono le_radical))

/-- Pullback along a ring equivalence commutes with powers of ideals. -/
@[simp]
theorem comap_pow_of_ringEquiv {R S : Type*} [CommSemiring R] [CommSemiring S]
    (I : Ideal R) (e : S ≃+* R) (n : ℕ) : (I ^ n).comap e = I.comap e ^ n := by
  rw [← map_symm, ← map_symm, Ideal.map_pow]

/-- Extension along a ring homomorphism commutes with finite products of ideals. -/
theorem map_finset_prod {R S F ι : Type*} [CommSemiring R] [CommSemiring S] [FunLike F R S]
    [RingHomClass F R S] (f : F) (s : Finset ι) (J : ι → Ideal R) :
    (∏ i ∈ s, J i).map f = ∏ i ∈ s, (J i).map f :=
  map_prod (mapHom f) J s

/-- Extension along a bijective ring homomorphism preserves and reflects primality; compare
`Ideal.isMaximal_map_iff_of_bijective`. -/
theorem isPrime_map_iff_of_bijective {R S F : Type*} [Semiring R] [Semiring S] [FunLike F R S]
    [RingHomClass F R S] (f : F) (hf : Function.Bijective f) {I : Ideal R} :
    (I.map f).IsPrime ↔ I.IsPrime :=
  ⟨fun _ => comap_map_of_bijective f hf (I := I) ▸ comap_isPrime f (I.map f),
    fun _ => map_isPrime_of_equiv (RingEquiv.ofBijective f hf)⟩

/-- Extension preserves coprimality: if `I` is coprime to the contraction of `J`, then the
extension of `I` is coprime to `J`. -/
theorem map_sup_eq_top_of_coprime_comap {R S F : Type*} [Semiring R] [Semiring S]
    [FunLike F R S] [RingHomClass F R S] {f : F} {I : Ideal R} {J : Ideal S}
    (h : I ⊔ J.comap f = ⊤) : I.map f ⊔ J = ⊤ := by
  rw [eq_top_iff, ← map_top f, ← h, map_sup]
  exact sup_le_sup_left map_comap_le _

/-- Extending an ideal of `R` to an `R`-algebra `A` and then along an `R`-algebra homomorphism
`A → B` gives its extension to `B`. -/
@[simp]
theorem map_map_algebraMap {R A B F : Type*} [CommSemiring R] [Semiring A] [Semiring B]
    [Algebra R A] [Algebra R B] [FunLike F A B] [AlgHomClass F R A B] (φ : F) (I : Ideal R) :
    (I.map (algebraMap R A)).map φ = I.map (algebraMap R B) := by
  rw [← (AlgHom.ofClass φ).comp_algebraMap, ← map_map]
  rfl

/-- Extending an ideal of `R` through a scalar tower `R → A → B` agrees with extending it
directly along `R → B`. -/
@[simp]
theorem map_algebraMap_map_algebraMap {R A B : Type*} [CommSemiring R] [CommSemiring A]
    [Semiring B] [Algebra R A] [Algebra A B] [Algebra R B] [IsScalarTower R A B] (I : Ideal R) :
    (I.map (algebraMap R A)).map (algebraMap A B) = I.map (algebraMap R B) := by
  rw [map_map, ← IsScalarTower.algebraMap_eq]

/-- If a ring homomorphism `f` satisfies `I ≤ J.comap f`, then `I ^ n ≤ (J ^ n).comap f`. Unlike
`Ideal.le_comap_pow`, neither ring need be commutative. -/
theorem pow_le_comap_pow_of_le_comap {R S F : Type*} [Semiring R] [Semiring S] [FunLike F R S]
    [RingHomClass F R S] (f : F) {I : Ideal R} {J : Ideal S} (h : I ≤ J.comap f) (n : ℕ) :
    I ^ n ≤ (J ^ n).comap f := by
  induction n with
  | zero => simp [Submodule.pow_zero, one_eq_top]
  | succ n ih =>
    rw [Submodule.pow_succ, Submodule.mul_le]
    intro a ha b hb
    rw [mem_comap, map_mul, Submodule.pow_succ]
    exact mul_mem_mul (ih ha) (h hb)

/-- A ring homomorphism `f` with `I ≤ J.comap f` maps `I ^ n` into `J ^ n`. -/
theorem map_mem_pow_of_le_comap {R S : Type*} [Semiring R] [Semiring S] (f : R →+* S)
    {I : Ideal R} {J : Ideal S} (h : I ≤ J.comap f) {n : ℕ} {x : R} (hx : x ∈ I ^ n) :
    f x ∈ J ^ n :=
  pow_le_comap_pow_of_le_comap f h n hx

/-- Along a surjective ring homomorphism, the powers of the image of an ideal lie in the image of
its powers. Unlike `Ideal.map_pow`, neither ring need be commutative. -/
theorem pow_map_le_map_pow_of_surjective {R S F : Type*} [Semiring R] [Semiring S]
    [FunLike F R S] [RingHomClass F R S] {f : F} (hf : Function.Surjective f) (I : Ideal R)
    (n : ℕ) : I.map f ^ n ≤ (I ^ n).map f := by
  induction n with
  | zero => simp only [Submodule.pow_zero, one_eq_top, map_top, le_refl]
  | succ n ih =>
    rw [Submodule.pow_succ, mul_le]
    intro r hr s hs
    obtain ⟨a, ha, rfl⟩ := (mem_map_iff_of_surjective f hf).mp (ih hr)
    obtain ⟨b, hb, rfl⟩ := (mem_map_iff_of_surjective f hf).mp hs
    rw [← map_mul, Submodule.pow_succ]
    exact mem_map_of_mem f (mul_mem_mul ha hb)

/-- A ring endomorphism `φ` that is congruent modulo a radical ideal `P` to a power map
`a ↦ a ^ q` with `q ≠ 0`, as a Frobenius lift is, has `φ⁻¹ P = P`. -/
theorem comap_eq_self_of_forall_sub_pow_mem {R : Type*} [CommRing R] {P : Ideal R}
    (hP : P.IsRadical) {φ : R →+* R} {q : ℕ} (hq : q ≠ 0) (hφ : ∀ a, φ a - a ^ q ∈ P) :
    P.comap φ = P := by
  ext a
  rw [mem_comap, ← sub_add_cancel (φ a) (a ^ q), add_mem_cancel_left (hφ a)]
  exact ⟨fun h ↦ hP ⟨q, h⟩, fun ha ↦ P.pow_mem_of_mem ha q (Nat.pos_of_ne_zero hq)⟩

/-- An `R`-algebra homomorphism carries `span {algebraMap R A r} ^ n` into
`span {algebraMap R B r} ^ n`. -/
theorem apply_mem_span_algebraMap_pow {R A B F : Type*} [CommSemiring R] [CommSemiring A]
    [CommSemiring B] [Algebra R A] [Algebra R B] [FunLike F A B] [AlgHomClass F R A B]
    (φ : F) {r : R} {n : ℕ} {x : A} (hx : x ∈ span {algebraMap R A r} ^ n) :
    φ x ∈ span {algebraMap R B r} ^ n := by
  have h : (span {algebraMap R A r} ^ n).map φ = span {algebraMap R B r} ^ n := by
    rw [Ideal.map_pow, map_span, Set.image_singleton, AlgHomClass.commutes]
  exact h ▸ mem_map_of_mem φ hx

open scoped Pointwise in
/-- If `f r` is a unit, `r • I ≤ (t)`, and `t ∈ I`, then `I` generates the principal ideal
`(f t)` after applying the ring homomorphism `f`. -/
theorem map_eq_span_singleton_of_isUnit {B B' F : Type*} [CommSemiring B] [Semiring B']
    [FunLike F B B'] [RingHomClass F B B'] (f : F) {I : Ideal B} {r t : B} (ht : t ∈ I)
    (h : r • I ≤ span {t}) (hr : IsUnit (f r)) :
    I.map f = span {f t} := by
  refine le_antisymm (map_le_iff_le_comap.mpr fun i hi ↦ ?_)
    ((span_singleton_le_iff_mem _).mpr (mem_map_of_mem f ht))
  have := mem_map_of_mem f (h (Submodule.smul_mem_pointwise_smul i r I hi))
  rwa [map_span, Set.image_singleton, smul_eq_mul, map_mul, unit_mul_mem_iff_mem _ hr] at this

/-- Extending an ideal spanned by an indexed family along a ring homomorphism gives the ideal
spanned by its pointwise image. -/
theorem map_span_range_eq {R S ι : Type*} [Semiring R] [Semiring S] (f : R →+* S)
    {g : ι → R} {g' : ι → S} (h : ∀ i, f (g i) = g' i) :
    (span (Set.range g)).map f = span (Set.range g') := by
  have hcomp : ⇑f ∘ g = g' := funext h
  rw [map_span, ← Set.range_comp, hcomp]

/-- An ideal extended along a ring homomorphism into a finite product equals the product of its
component extensions. -/
theorem map_eq_pi_of_map_evalRingHom {ι : Type*} [Finite ι] {A : Type*} {R : ι → Type*}
    [Semiring A] [∀ i, Semiring (R i)] (I : Ideal A) (f : A →+* ∀ i, R i)
    (J : ∀ i, Ideal (R i)) (h : ∀ i, I.map ((Pi.evalRingHom R i).comp f) = J i) :
    I.map f = pi J := by
  have hpi : I.map f = pi (piOrderIso (I.map f)) := (piOrderIso.symm_apply_apply (I.map f)).symm
  rw [hpi]
  congr 1
  ext i : 1
  rw [← map_evalRingHom_pi (I := piOrderIso (I.map f)) i, ← hpi, map_map, h i]

/-- If the images under `f` of any two elements of an ideal `I` are comparable for divisibility,
then an element lies in the extension `I.map f` if and only if it is divisible by `f a` for some
`a ∈ I`. This holds when the source or the target of `f` is a valuation ring. -/
theorem mem_map_iff_exists_dvd_of_dvd_total {R S : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) {I : Ideal R} (h : ∀ a ∈ I, ∀ b ∈ I, f a ∣ f b ∨ f b ∣ f a) {x : S} :
    x ∈ I.map f ↔ ∃ a ∈ I, f a ∣ x := by
  refine ⟨fun hx ↦ ?_, fun ⟨a, ha, hax⟩ ↦ mem_of_dvd _ hax (mem_map_of_mem f ha)⟩
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, ha, rfl⟩ := hy
    exact ⟨a, ha, dvd_rfl⟩
  | zero => exact ⟨0, I.zero_mem, dvd_zero _⟩
  | add y z _ _ hy hz =>
    obtain ⟨a, ha, hay⟩ := hy
    obtain ⟨b, hb, hbz⟩ := hz
    rcases h a ha b hb with h | h
    · exact ⟨a, ha, dvd_add hay (h.trans hbz)⟩
    · exact ⟨b, hb, dvd_add (h.trans hay) hbz⟩
  | smul r y _ hy =>
    obtain ⟨a, ha, hay⟩ := hy
    exact ⟨a, ha, hay.mul_left r⟩

/-- The greatest ideal of `W` whose contraction along `f : V →+* W` is contained in a prime `p`
of `V` is prime. -/
theorem isPrime_of_isGreatest_comap_le {V W : Type*} [CommSemiring V] [CommSemiring W]
    (f : V →+* W) {p : Ideal V} [p.IsPrime] {q : Ideal W}
    (hq : IsGreatest {J : Ideal W | J.comap f ≤ p} q) :
    q.IsPrime :=
  isPrime_of_maximally_disjoint q (p.primeCompl.map f)
    (disjoint_map_primeCompl_iff_comap_le.mpr hq.1)
    fun _ hJ hdisj ↦ hJ.not_ge (hq.2 (disjoint_map_primeCompl_iff_comap_le.mp hdisj))

end Ideal

namespace AlgEquiv

/-- If the extensions of two ideals to `L'` are a principal ideal and its annihilator, the
extensions to an equivalent `A`-algebra `L` have the same form. -/
theorem map_eq_span_singleton_and_annihilator {A L L' : Type*} [CommSemiring A]
    [Semiring L] [Semiring L'] [Algebra A L] [Algebra A L'] (e : L ≃ₐ[A] L')
    {𝔞 𝔟 : Ideal A} {a' : L'} (h𝔞 : 𝔞.map (algebraMap A L') = Ideal.span {a'})
    (h𝔟 : 𝔟.map (algebraMap A L') = (Ideal.span {a'}).annihilator) :
    𝔞.map (algebraMap A L) = Ideal.span {e.symm a'} ∧
      𝔟.map (algebraMap A L) = (Ideal.span {e.symm a'}).annihilator := by
  have hmap (𝔠 : Ideal A) :
      𝔠.map (algebraMap A L) = (𝔠.map (algebraMap A L')).comap e.toRingEquiv := by
    rw [← e.symm.toAlgHom.comp_algebraMap, ← Ideal.map_map, toRingHom_toAlgHom,
      Ideal.map_comap_of_equiv, symm_toRingEquiv, RingEquiv.symm_symm]
  have hspan : (Ideal.span {a'}).comap e.toRingEquiv = Ideal.span {e.symm a'} := by
    rw [← Ideal.map_symm, Ideal.map_span, Set.image_singleton]
    simp
  refine ⟨by rw [hmap, h𝔞, hspan], ?_⟩
  rw [hmap, h𝔟, ← hspan]
  ext x
  simp only [Ideal.mem_comap, Submodule.mem_annihilator, smul_eq_mul,
    coe_toRingEquiv]
  constructor
  · intro hx y hy
    exact e.injective (by simpa only [map_mul, map_zero] using hx (e y) hy)
  · intro hx y hy
    simpa only [map_mul, e.apply_symm_apply, map_zero] using
      congrArg e (hx (e.symm y) (by simpa only [e.apply_symm_apply] using hy))

end AlgEquiv
