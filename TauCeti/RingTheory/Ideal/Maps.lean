module

public import Mathlib.RingTheory.Ideal.Maps

/-!
# Transport of ideals along ring homomorphisms

Taking radicals before extending an ideal does not change the radical of its extension.
Powers of ideals commute with pullback along a ring equivalence, a ring homomorphism carrying `I`
into `J` carries each power of `I` into the same power of `J`, and extension along a bijective
ring homomorphism preserves and reflects primality. Extending an ideal to an algebra and then along
an algebra homomorphism is extending it directly. An algebra equivalence
transports a principal ideal to the ideal generated by the transported
element, and its annihilator to the annihilator of that ideal. The principal-ideal result applies
to ideals extended from a common commutative semiring, without assuming the algebras commutative.
-/

public section

namespace Ideal

/-- Taking the radical before extending an ideal does not change the radical of its extension. -/
@[simp]
theorem radical_map_radical {R S F : Type*} [CommSemiring R] [CommSemiring S]
    [FunLike F R S] [RingHomClass F R S] (I : Ideal R) (f : F) :
    (I.radical.map f).radical = (I.map f).radical :=
  le_antisymm (radical_le_radical_iff.mpr (map_radical_le f))
    (radical_mono (map_mono le_radical))

/-- Pullback along a ring equivalence commutes with powers of ideals. -/
@[simp]
theorem comap_pow_of_ringEquiv {R S : Type*} [CommSemiring R] [CommSemiring S]
    (I : Ideal R) (e : S ≃+* R) (n : ℕ) : (I ^ n).comap e = I.comap e ^ n := by
  rw [← Ideal.map_symm, ← Ideal.map_symm, Ideal.map_pow]

/-- Extension along a bijective ring homomorphism preserves and reflects primality; compare
`Ideal.isMaximal_map_iff_of_bijective`. -/
theorem isPrime_map_iff_of_bijective {R S F : Type*} [Semiring R] [Semiring S] [FunLike F R S]
    [RingHomClass F R S] (f : F) (hf : Function.Bijective f) {I : Ideal R} :
    (I.map f).IsPrime ↔ I.IsPrime :=
  ⟨fun _ => comap_map_of_bijective f hf (I := I) ▸ comap_isPrime f (I.map f),
    fun _ => map_isPrime_of_equiv (RingEquiv.ofBijective f hf)⟩

/-- Extending an ideal of `R` to an `R`-algebra `A` and then along an `R`-algebra homomorphism
`A → B` gives its extension to `B`. -/
@[simp]
theorem map_map_algebraMap {R A B F : Type*} [CommSemiring R] [Semiring A] [Semiring B]
    [Algebra R A] [Algebra R B] [FunLike F A B] [AlgHomClass F R A B] (φ : F) (I : Ideal R) :
    (I.map (algebraMap R A)).map φ = I.map (algebraMap R B) := by
  rw [← (AlgHom.ofClass φ).comp_algebraMap, ← Ideal.map_map]
  rfl

/-- A ring homomorphism `f` with `I ≤ J.comap f` maps `I ^ n` into `J ^ n`. -/
theorem map_mem_pow_of_le_comap {R S : Type*} [CommSemiring R] [CommSemiring S] (f : R →+* S)
    {I : Ideal R} {J : Ideal S} (h : I ≤ J.comap f) {n : ℕ} {x : R} (hx : x ∈ I ^ n) :
    f x ∈ J ^ n :=
  le_comap_pow f n (pow_right_mono h n hx)

end Ideal

namespace AlgEquiv

/-- If the extensions of two ideals to `L'` are a principal ideal and its annihilator, the
extensions to an equivalent `A`-algebra `L` have the same form. -/
theorem map_eq_span_singleton_and_annihilator {A L L' : Type*} [CommSemiring A]
    [Semiring L] [Semiring L'] [Algebra A L] [Algebra A L'] (e : L ≃ₐ[A] L')
    {𝔞 𝔟 : Ideal A} {a' : L'} (h𝔞 : 𝔞.map (algebraMap A L') = Ideal.span {a'})
    (h𝔟 : 𝔟.map (algebraMap A L') = (Ideal.span {a'}).annihilator) :
    𝔞.map (algebraMap A L) = Ideal.span {e.symm a'} ∧
      𝔟.map (algebraMap A L) = (Ideal.span {e.symm a'}).annihilator := by
  have hmap (𝔠 : Ideal A) :
      𝔠.map (algebraMap A L) = (𝔠.map (algebraMap A L')).comap e.toRingEquiv := by
    rw [← e.symm.toAlgHom.comp_algebraMap, ← Ideal.map_map, AlgEquiv.toRingHom_toAlgHom,
      Ideal.map_comap_of_equiv, AlgEquiv.symm_toRingEquiv, RingEquiv.symm_symm]
  have hspan : (Ideal.span {a'}).comap e.toRingEquiv = Ideal.span {e.symm a'} := by
    rw [← Ideal.map_symm, Ideal.map_span, Set.image_singleton]
    simp
  refine ⟨by rw [hmap, h𝔞, hspan], ?_⟩
  rw [hmap, h𝔟, ← hspan]
  ext x
  simp only [Ideal.mem_comap, Submodule.mem_annihilator, smul_eq_mul,
    AlgEquiv.coe_toRingEquiv]
  constructor
  · intro hx y hy
    exact e.injective (by simpa only [map_mul, map_zero] using hx (e y) hy)
  · intro hx y hy
    simpa only [map_mul, e.apply_symm_apply, map_zero] using
      congrArg e (hx (e.symm y) (by simpa only [e.apply_symm_apply] using hy))

end AlgEquiv
