module

public import Mathlib.RingTheory.Ideal.Maps

/-!
# Ideals generated in a finite product of rings

An ideal of a finite product `Π i, R i` is the product of its images in the factors. This file
records the consequence for the ideal generated by the image of a ring homomorphism into such a
product: it is read off componentwise, one factor at a time. This complements
`Mathlib/RingTheory/Ideal/Maps.lean`.

## Main results

* `Ideal.map_eq_pi_map_comp_evalRingHom`: for `φ : A →+* Π i, R i` with finitely many factors,
  `I.map φ` is the product of the ideals `I.map (evalᵢ ∘ φ)`.
-/

public section

namespace Ideal

/-- **Extension into a finite product is computed componentwise.** For a ring homomorphism
`φ : A →+* Π i, R i` with finitely many factors, the ideal generated by `φ(I)` is the product of
the ideals generated by the images of `I` in the factors. -/
theorem map_eq_pi_map_comp_evalRingHom {ι A : Type*} [Finite ι] [Semiring A]
    {R : ι → Type*} [∀ i, Semiring (R i)] (φ : A →+* ∀ i, R i) (I : Ideal A) :
    I.map φ = Ideal.pi fun i ↦ I.map ((Pi.evalRingHom R i).comp φ) := by
  classical
  have := Fintype.ofFinite ι
  refine le_antisymm (map_le_iff_le_comap.mpr fun x hx i ↦ mem_map_of_mem _ hx) fun r hr ↦ ?_
  -- Write `r` as the sum of its components, and lift each component to `I.map φ`.
  rw [← Finset.univ_sum_single r]
  refine sum_mem fun i _ ↦ ?_
  have hri : r i ∈ I.map ((Pi.evalRingHom R i).comp φ) := hr i
  rw [← map_map, mem_map_iff_of_surjective _ (Function.surjective_eval i)] at hri
  obtain ⟨s, hs, hsr⟩ := hri
  have hsingle : Pi.single i (r i) = Pi.single i 1 * s := by
    ext j
    obtain rfl | hj := eq_or_ne j i
    · simp [← hsr]
    · simp [Pi.single_eq_of_ne hj]
  rw [hsingle]
  exact mul_mem_left _ _ hs

end Ideal
