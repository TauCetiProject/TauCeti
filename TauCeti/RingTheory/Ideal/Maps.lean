module

public import Mathlib.RingTheory.Ideal.Maps

/-!
# Transport of principal ideals and their annihilators

An algebra equivalence carries a principal ideal and its annihilator to the corresponding
ideals generated by the transported element. The result below also transports ideals extended
from a common base algebra.
-/

public section

namespace TauCeti.Ideal

/-- If the extensions of two ideals to `L'` are a principal ideal and its annihilator, the
extensions to an equivalent `A`-algebra `L` have the same form. -/
theorem span_singleton_annihilator_of_algEquiv {A L L' : Type*} [CommRing A]
    [CommRing L] [CommRing L'] [Algebra A L] [Algebra A L'] (e : L ≃ₐ[A] L')
    {𝔞 𝔟 : _root_.Ideal A}
    {a' : L'} (h𝔞 : 𝔞.map (algebraMap A L') = _root_.Ideal.span {a'})
    (h𝔟 : 𝔟.map (algebraMap A L') = (_root_.Ideal.span {a'}).annihilator) :
    𝔞.map (algebraMap A L) = _root_.Ideal.span {e.symm a'} ∧
      𝔟.map (algebraMap A L) = (_root_.Ideal.span {e.symm a'}).annihilator := by
  have hmap (𝔠 : _root_.Ideal A) :
      𝔠.map (algebraMap A L) = (𝔠.map (algebraMap A L')).comap e.toRingEquiv := by
    have hcomp : algebraMap A L = (e.symm.toRingEquiv : L' →+* L).comp (algebraMap A L') := by
      ext x
      simp
    rw [hcomp, ← _root_.Ideal.map_map, _root_.Ideal.map_comap_of_equiv,
      AlgEquiv.symm_toRingEquiv, RingEquiv.symm_symm]
  refine ⟨?_, ?_⟩
  · rw [hmap, h𝔞, ← _root_.Ideal.map_symm, _root_.Ideal.map_span, Set.image_singleton]
    simp
  · rw [hmap, h𝔟]
    ext x
    rw [_root_.Ideal.mem_comap, _root_.Ideal.span, Submodule.mem_annihilator_span_singleton,
      Submodule.mem_annihilator_span_singleton, smul_eq_mul, smul_eq_mul]
    constructor
    · intro hx
      simpa using congrArg e.symm hx
    · intro hx
      simpa using congrArg e hx

end TauCeti.Ideal
