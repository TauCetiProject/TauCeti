module

public import Mathlib.RingTheory.Ideal.Norm.RelNorm
import TauCeti.NumberTheory.RamificationInertia.Galois

/-!
# Ideal norms as products of Galois conjugates

For a finite torsion-free Galois extension `R → S` of Dedekind domains with Galois group `G`, the
product of the Galois conjugates of any ideal `I` of `S` is the extension to `S` of its relative
norm:

  `∏ g : G, g • I = (I.relNorm R).map (algebraMap R S)`.

When `R = ℤ` and `S` is free of finite rank over `ℤ` (for instance `S = 𝓞 K` for a Galois number
field `K / ℚ`), the relative norm over `ℤ` is generated by the absolute norm, so the product of
the Galois conjugates of `I` is the principal ideal generated by `Ideal.absNorm I`:

  `∏ g : G, g • I = Ideal.span {(Ideal.absNorm I : S)}`.

Both identities hold without restriction on `I`: at `⊥` and `⊤` directly, at a nonzero prime ideal
by combining the Dedekind–Kummer factorisation of the prime below it with transitivity of `G` on
the primes above and the order `e * f` of the decomposition group, and in general by unique
factorisation into prime ideals.

## Main results

* `Ideal.prod_smul_eq_map_relNorm`: `∏ g : G, g • I = (I.relNorm R).map (algebraMap R S)` in a
  finite torsion-free Galois extension of Dedekind domains.
* `Ideal.prod_smul_eq_span_absNorm`: `∏ g : G, g • I = Ideal.span {(Ideal.absNorm I : S)}` when
  `G` is a Galois group of `S` over `ℤ`.

## References

* [J. Neukirch, *Algebraic Number Theory*][Neukirch1992], Chapter I, §8, Proposition 8.2, and
  Chapter III, §2.
* S. Lang, *Algebraic Number Theory*, 2nd ed., Chapter I, §7.
-/

public section

namespace Ideal

open UniqueFactorizationMonoid
open scoped Pointwise

/-- For a nonzero prime ideal `P` above `p = P.under R` and a prime `Q` above `p`, the number of
elements `g ∈ G` with `g • P = Q` is `e(P / p) * f(P / p)`. -/
private theorem card_filter_smul_eq (R : Type*) [CommRing R] [IsDedekindDomain R] {S : Type*}
    [CommRing S] [IsDedekindDomain S] [Algebra R S] [Module.Finite R S]
    [Module.IsTorsionFree R S] (G : Type*) [Group G] [Fintype G] [MulSemiringAction G S]
    [IsGaloisGroup G R S] {P Q : Ideal S} [P.IsPrime] [Q.IsPrime] (hP : P ≠ ⊥)
    [Q.LiesOver (P.under R)] :
    (Finset.univ.filter fun g : G ↦ g • P = Q).card = P.ramificationIdx R * P.inertiaDeg R := by
  classical
  set p : Ideal R := P.under R
  have hp₀ : p ≠ ⊥ := under_ne_bot R hP
  have : p.IsMaximal := (inferInstance : p.IsPrime).isMaximal hp₀
  obtain ⟨σ, rfl⟩ := exists_smul_eq_of_isGaloisGroup p P Q G
  have hbij : (Finset.univ.filter fun g : G ↦ g • P = σ • P).card =
      Fintype.card (MulAction.stabilizer G P) := by
    rw [Fintype.card_of_subtype (Finset.univ.filter fun g : G ↦ g ∈ MulAction.stabilizer G P)
      (by simp)]
    refine Finset.card_bij (fun g _ ↦ σ⁻¹ * g) ?_ (fun _ _ _ _ h ↦ mul_left_cancel h) ?_
    · intro g hg
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, MulAction.mem_stabilizer_iff]
        at hg ⊢
      rw [mul_smul, hg, inv_smul_smul]
    · intro h hh
      refine ⟨σ * h, ?_, inv_mul_cancel_left σ h⟩
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, MulAction.mem_stabilizer_iff]
        at hh ⊢
      rw [mul_smul, hh]
  rw [hbij, ← Nat.card_eq_fintype_card,
    card_stabilizer_eq_ramificationIdx_mul_inertiaDeg (R := R) (G := G)]

attribute [local instance] FractionRing.liftAlgebra in
/-- At a nonzero prime ideal `P` of `S`, the product of the Galois conjugates of `P` equals the
extension to `S` of the relative norm `P.relNorm R`. -/
private theorem prod_smul_eq_map_relNorm_of_isPrime (R : Type*) [CommRing R] [IsDedekindDomain R]
    {S : Type*} [CommRing S] [IsDedekindDomain S] [Algebra R S] [Module.Finite R S]
    [Module.IsTorsionFree R S] (G : Type*) [Group G] [Fintype G] [MulSemiringAction G S]
    [IsGaloisGroup G R S] {P : Ideal S} [P.IsPrime] (hP : P ≠ ⊥) :
    ∏ g : G, g • P = (P.relNorm R).map (algebraMap R S) := by
  classical
  set p : Ideal R := P.under R
  have hp₀ : p ≠ ⊥ := under_ne_bot R hP
  have : p.IsMaximal := (inferInstance : p.IsPrime).isMaximal hp₀
  have : P.IsMaximal := ‹P.IsPrime›.isMaximal hP
  -- Lift the Galois action to the fraction fields so `relNorm_eq_pow_of_isPrime_isGalois` applies.
  have hrel : P.relNorm R = p ^ P.inertiaDeg R := by
    let : MulSemiringAction G (FractionRing S) :=
      IsFractionRing.mulSemiringAction G S (FractionRing S)
    have : IsGalois (FractionRing R) (FractionRing S) :=
      IsGaloisGroup.isGalois G (FractionRing R) (FractionRing S)
    exact relNorm_eq_pow_of_isPrime_isGalois P p
  have hmaps : Set.MapsTo (fun g : G ↦ g • P) (Finset.univ : Finset G) (p.primesOver S).toFinset :=
    fun g _ ↦ Set.mem_toFinset.mpr ⟨inferInstance, inferInstance⟩
  calc
    ∏ g : G, g • P
      = ∏ Q ∈ (p.primesOver S).toFinset, ∏ g ∈ Finset.univ with g • P = Q, g • P :=
        (Finset.prod_fiberwise_of_maps_to hmaps _).symm
    _ = ∏ Q ∈ (p.primesOver S).toFinset, Q ^ (P.ramificationIdx R * P.inertiaDeg R) := by
        refine Finset.prod_congr rfl fun Q hQ ↦ ?_
        obtain ⟨_, _⟩ := Set.mem_toFinset.mp hQ
        rw [Finset.prod_congr rfl fun g hg ↦ (Finset.mem_filter.mp hg).2, Finset.prod_const,
          card_filter_smul_eq R G hP]
    _ = ∏ Q ∈ (p.primesOver S).toFinset, (Q ^ Q.ramificationIdx R) ^ P.inertiaDeg R := by
        refine Finset.prod_congr rfl fun Q hQ ↦ ?_
        obtain ⟨_, _⟩ := Set.mem_toFinset.mp hQ
        rw [← pow_mul, ramificationIdx_eq_of_isGaloisGroup p Q P G]
    _ = (∏ Q ∈ (p.primesOver S).toFinset, Q ^ Q.ramificationIdx R) ^ P.inertiaDeg R :=
        Finset.prod_pow _ _ _
    _ = (P.relNorm R).map (algebraMap R S) := by
        rw [hrel, Ideal.map_pow, map_algebraMap_eq_finsetProd_pow hp₀]

/-- **Product of Galois conjugates of an ideal.** In a finite torsion-free Galois extension
`R → S` of Dedekind domains with Galois group `G`, the product of the translates `g • I` over
`g ∈ G` is the extension to `S` of the relative norm `I.relNorm R`. -/
theorem prod_smul_eq_map_relNorm (R : Type*) [CommRing R] [IsDedekindDomain R] {S : Type*}
    [CommRing S] [IsDedekindDomain S] [Algebra R S] [Module.Finite R S]
    [Module.IsTorsionFree R S] (G : Type*) [Group G] [Fintype G] [MulSemiringAction G S]
    [IsGaloisGroup G R S] (I : Ideal S) :
    ∏ g : G, g • I = (I.relNorm R).map (algebraMap R S) := by
  classical
  induction I using induction_on_prime with
  | h₁ =>
    rw [zero_eq_bot, relNorm_bot, Ideal.map_bot, ← zero_eq_bot]
    refine Finset.prod_eq_zero (Finset.mem_univ (1 : G)) ?_
    rw [one_smul]
  | h₂ I hI =>
    rw [isUnit_iff.mp hI, relNorm_top, Ideal.map_top, ← one_eq_top]
    simp only [smul_one, Finset.prod_const_one]
  | h₃ I P _ hP ih =>
    have : P.IsPrime := isPrime_of_prime hP
    rw [map_mul, Ideal.map_mul, ← prod_smul_eq_map_relNorm_of_isPrime R G hP.ne_zero, ← ih,
      ← Finset.prod_mul_distrib]
    simp only [smul_mul']

/-- **Product of Galois conjugates of an ideal over `ℤ`.** Let `S` be a Dedekind domain that is
free of finite rank over `ℤ`, and `G` a finite Galois group of `S` over `ℤ` (for instance
`S = 𝓞 K` and `G = Gal(K/ℚ)` for a Galois number field `K`). For every ideal `I` of `S`, the
product of `g • I` over `g ∈ G` is the principal ideal generated by `Ideal.absNorm I`. -/
theorem prod_smul_eq_span_absNorm {S : Type*} [CommRing S] [IsDedekindDomain S]
    [Module.Finite ℤ S] [Module.Free ℤ S] (G : Type*) [Group G] [Fintype G]
    [MulSemiringAction G S] [IsGaloisGroup G ℤ S] (I : Ideal S) :
    ∏ g : G, g • I = span {(absNorm I : S)} := by
  rw [prod_smul_eq_map_relNorm ℤ G I, relNorm_int, map_span, Set.image_singleton, eq_intCast,
    Int.cast_natCast]

end Ideal
