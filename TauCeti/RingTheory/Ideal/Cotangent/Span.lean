module

public import Mathlib.RingTheory.Ideal.Cotangent

/-!
# Spanning families of a cotangent space

Let `I` be an ideal of a commutative ring `R`. A family `f` of elements of `I` has classes spanning
the cotangent space `I ⧸ I²` exactly when `I ≤ (f) + I²`, where `(f)` is the ideal generated by
the family. This is the form in which generators of `I ⧸ I²` are lifted to `I`, for instance
before applying a graded Nakayama lemma. Since `I ⧸ I²` is killed by `I`, spanning over `R` and
over `R ⧸ I` agree.

Unlike `IsLocalRing.CotangentSpace.span_image_eq_top_iff`, which uses Nakayama's lemma to compare
spanning `𝔪 ⧸ 𝔪²` with generating `𝔪` in a Noetherian local ring, these statements hold for every
ideal of every commutative ring.

## Main declarations

* `Ideal.span_range_toCotangent_eq_top_iff`: the classes of `f` span `I ⧸ I²` over `R` if and only
  if `I ≤ (f) + I²`.
* `Ideal.span_quotient_range_toCotangent_eq_top_iff`: the same with spanning over `R ⧸ I`.
-/

public section

namespace Ideal

variable {R ι : Type*} [CommRing R] (I : Ideal R) (f : ι → R) (hf : ∀ i, f i ∈ I)

/-- The classes of a family `f` of elements of `I` span the cotangent space `I ⧸ I²` over `R` if
and only if `I ≤ (f) + I²`. -/
theorem span_range_toCotangent_eq_top_iff :
    Submodule.span R (Set.range fun i ↦ I.toCotangent ⟨f i, hf i⟩) = ⊤ ↔
      I ≤ span (Set.range f) ⊔ I ^ 2 := by
  set g : ι → I := fun i ↦ ⟨f i, hf i⟩
  have hrange : Set.range (fun i ↦ I.toCotangent (g i)) = I.toCotangent '' Set.range g :=
    Set.range_comp ..
  have hsub : Submodule.map I.subtype (Submodule.span R (Set.range g)) = span (Set.range f) := by
    -- `I.subtype ∘ g` is `f` by the definition of `g`.
    rw [Submodule.map_span, ← Set.range_comp]
    rfl
  -- A submodule of `I` maps onto `I ⧸ I²` exactly when together with the kernel it is all of `I`.
  have hsurj : Submodule.span R (I.toCotangent '' Set.range g) = ⊤ ↔
      Submodule.span R (Set.range g) ⊔ LinearMap.ker I.toCotangent = ⊤ := by
    rw [Submodule.span_image, ← (Submodule.comap_injective_of_surjective
      I.toCotangent_surjective).eq_iff, Submodule.comap_map_eq, Submodule.comap_top]
  -- Pushed forward along the inclusion `I → R`, the kernel is `I²` and `span g` is `(f)`.
  have hmap : Submodule.span R (Set.range g) ⊔ LinearMap.ker I.toCotangent = ⊤ ↔
      span (Set.range f) ⊔ I ^ 2 = I := by
    rw [← (Submodule.map_injective_of_injective I.injective_subtype).eq_iff, Submodule.map_sup,
      hsub, map_toCotangent_ker, Submodule.map_top, Submodule.range_subtype]
  rw [hrange, hsurj, hmap]
  refine ⟨fun h ↦ h.ge, fun h ↦ le_antisymm (sup_le ?_ (pow_le_self two_ne_zero)) h⟩
  exact span_le.2 (Set.range_subset_iff.2 hf)

/-- The classes of a family `f` of elements of `I` span the cotangent space `I ⧸ I²` over `R ⧸ I`
if and only if `I ≤ (f) + I²`. -/
theorem span_quotient_range_toCotangent_eq_top_iff :
    Submodule.span (R ⧸ I) (Set.range fun i ↦ I.toCotangent ⟨f i, hf i⟩) = ⊤ ↔
      I ≤ span (Set.range f) ⊔ I ^ 2 := by
  rw [← span_range_toCotangent_eq_top_iff, ← (Submodule.restrictScalars_injective R ..).eq_iff,
    Submodule.restrictScalars_span R (R ⧸ I) Quotient.mk_surjective, Submodule.restrictScalars_top]

end Ideal
