module

public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Ideals generated by a list and iterated prefix quotients

Extends Mathlib's API for `Ideal.ofList rs` and quotients `M ⧸ Ideal.ofList rs • ⊤` (no locality
or Noetherian hypothesis). Permutations and reversals preserve `Ideal.ofList`, positive powers
preserve its radical, and canonical linear equivalences commute with quotient maps from `M`.

## Main definitions

* `Submodule.quotSupSMulTopEquiv`, `Submodule.quotOfListNilSMulTopEquiv`,
  `Submodule.quotOfListSingletonSMulTopEquiv`, `Submodule.quotOfListAppendSMulTopEquiv`,
  `Submodule.quotOfListSMulTopEquivOfPerm`, `LinearEquiv.quotSMulTop`.

## Main results

* `Ideal.ofList_perm`, `Ideal.ofList_reverse`, `Ideal.radical_ofList_eq_of_forall₂_pow`,
  `Ideal.radical_ofList_set_pow`.
-/

public section

open scoped Pointwise

namespace Ideal

section Semiring

variable {R : Type*} [Semiring R]

/-- Permuting a list does not change the ideal it generates. -/
theorem ofList_perm {rs qs : List R} (h : rs.Perm qs) : ofList rs = ofList qs :=
  congrArg span (Set.ext fun _ ↦ h.mem_iff)

/-- Reversing a list does not change the ideal it generates. -/
@[simp]
theorem ofList_reverse (rs : List R) : ofList rs.reverse = ofList rs :=
  ofList_perm rs.reverse_perm

/-- Monotonicity of `Ideal.ofList` with respect to list inclusion. -/
theorem ofList_le_ofList_of_subset {rs qs : List R} (h : ∀ r ∈ rs, r ∈ qs) :
    ofList rs ≤ ofList qs :=
  span_mono h

/-- The ideal generated by a prefix is contained in the ideal generated by the whole list. -/
theorem ofList_take_le (rs : List R) (i : ℕ) : ofList (rs.take i) ≤ ofList rs :=
  ofList_le_ofList_of_subset fun _ hr ↦ List.mem_of_mem_take hr

/-- The ideal generated by a suffix is contained in the ideal generated by the whole list. -/
theorem ofList_drop_le (rs : List R) (i : ℕ) : ofList (rs.drop i) ≤ ofList rs :=
  ofList_le_ofList_of_subset fun _ hr ↦ List.mem_of_mem_drop hr

end Semiring

section CommSemiring

variable {R : Type*} [CommSemiring R]

/-- Replacing every entry of a list by a positive power of itself preserves the radical of the
ideal generated by the list. -/
theorem radical_ofList_eq_of_forall₂_pow {rs qs : List R}
    (h : List.Forall₂ (fun a b ↦ ∃ k : ℕ, 0 < k ∧ b = a ^ k) rs qs) :
    (ofList rs).radical = (ofList qs).radical := by
  induction h with
  | nil => rfl
  | @cons a b as bs hab _ ih =>
    obtain ⟨k, hk, rfl⟩ := hab
    refine le_antisymm ?_ ?_ <;> rw [radical_le_radical_iff, ofList_cons, sup_le_iff]
    · exact ⟨(span_singleton_le_iff_mem _).mpr ⟨k, subset_span List.mem_cons_self⟩,
        (le_radical.trans_eq ih).trans (radical_mono (ofList_le_ofList_of_subset
          fun _ hr ↦ List.mem_cons_of_mem _ hr))⟩
    · exact ⟨(span_singleton_le_iff_mem _).mpr
          (le_radical (pow_mem_of_mem _ (subset_span List.mem_cons_self) k hk)),
        (le_radical.trans_eq ih.symm).trans (radical_mono (ofList_le_ofList_of_subset
          fun _ hr ↦ List.mem_cons_of_mem _ hr))⟩

/-- Replacing a single entry of a list by a positive power of itself preserves the radical of the
ideal generated by the list. -/
theorem radical_ofList_set_pow (rs : List R) {i : ℕ} (hi : i < rs.length) {k : ℕ} (hk : 0 < k) :
    (ofList (rs.set i (rs[i] ^ k))).radical = (ofList rs).radical := by
  symm
  refine radical_ofList_eq_of_forall₂_pow ?_
  induction rs generalizing i with
  | nil => simp at hi
  | cons a as ih =>
    cases i with
    | zero =>
      exact .cons ⟨k, hk, rfl⟩ (List.forall₂_same.mpr fun x _ ↦ ⟨1, one_pos, (pow_one x).symm⟩)
    | succ i => exact .cons ⟨1, one_pos, (pow_one a).symm⟩ (ih (by simpa using hi))

end CommSemiring

end Ideal

namespace Submodule

section Ring

variable {R : Type*} [Ring R] (M : Type*) [AddCommGroup M] [Module R M]

/-- Iterated quotient by a join of ideals: `M ⧸ (I ⊔ J) • M ≃ₗ[R] (M ⧸ I • M) ⧸ J • (M ⧸ I • M)`. -/
def quotSupSMulTopEquiv (I J : Ideal R) :
    (M ⧸ ((I ⊔ J) • (⊤ : Submodule R M))) ≃ₗ[R]
      (M ⧸ (I • (⊤ : Submodule R M))) ⧸
        (J • (⊤ : Submodule R (M ⧸ (I • (⊤ : Submodule R M))))) :=
  quotEquivOfEq _ _ (Submodule.sup_smul I J ⊤) ≪≫ₗ
    (quotientQuotientEquivQuotientSup (I • ⊤) (J • ⊤)).symm ≪≫ₗ
    quotEquivOfEq _ _ (by rw [map_smul'', map_top, range_mkQ])

@[simp]
theorem quotSupSMulTopEquiv_mk (I J : Ideal R) (m : M) :
    quotSupSMulTopEquiv M I J (Submodule.Quotient.mk m) =
      Submodule.Quotient.mk (Submodule.Quotient.mk m) := (rfl)

@[simp]
theorem quotSupSMulTopEquiv_symm_mk_mk (I J : Ideal R) (m : M) :
    (quotSupSMulTopEquiv M I J).symm (Submodule.Quotient.mk (Submodule.Quotient.mk m)) =
      Submodule.Quotient.mk m := (rfl)

/-- The quotient of `M` by the ideal generated by the empty list is canonically equivalent to
`M`. -/
def quotOfListNilSMulTopEquiv (R : Type*) [Ring R] (M : Type*) [AddCommGroup M] [Module R M] :
    (M ⧸ (Ideal.ofList ([] : List R) • (⊤ : Submodule R M))) ≃ₗ[R] M :=
  quotEquivOfEqBot _ (by rw [Ideal.ofList_nil, bot_smul])

@[simp]
theorem quotOfListNilSMulTopEquiv_mk (R : Type*) [Ring R] (M : Type*) [AddCommGroup M]
    [Module R M] (m : M) : quotOfListNilSMulTopEquiv R M (Submodule.Quotient.mk m) = m := (rfl)

@[simp]
theorem quotOfListNilSMulTopEquiv_symm_apply (R : Type*) [Ring R] (M : Type*) [AddCommGroup M]
    [Module R M] (m : M) :
    (quotOfListNilSMulTopEquiv R M).symm m = Submodule.Quotient.mk m := (rfl)

/-- Iterated prefix quotient:
`M ⧸ (rs ++ qs) • M ≃ₗ[R] (M ⧸ (rs) • M) ⧸ (qs) • (M ⧸ (rs) • M)`. -/
def quotOfListAppendSMulTopEquiv (rs qs : List R) :
    (M ⧸ (Ideal.ofList (rs ++ qs) • (⊤ : Submodule R M))) ≃ₗ[R]
      (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ⧸
        (Ideal.ofList qs • (⊤ : Submodule R (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))))) :=
  quotEquivOfEq _ _ (by rw [Ideal.ofList_append]) ≪≫ₗ
    quotSupSMulTopEquiv M (Ideal.ofList rs) (Ideal.ofList qs)

@[simp]
theorem quotOfListAppendSMulTopEquiv_mk (rs qs : List R) (m : M) :
    quotOfListAppendSMulTopEquiv M rs qs (Submodule.Quotient.mk m) =
      Submodule.Quotient.mk (Submodule.Quotient.mk m) := (rfl)

@[simp]
theorem quotOfListAppendSMulTopEquiv_symm_mk_mk (rs qs : List R) (m : M) :
    (quotOfListAppendSMulTopEquiv M rs qs).symm (Submodule.Quotient.mk (Submodule.Quotient.mk m)) =
      Submodule.Quotient.mk m := (rfl)

/-- Permuting a list induces a canonical linear equivalence on the quotient module, commuting with
the quotient maps from `M`. -/
def quotOfListSMulTopEquivOfPerm {rs qs : List R} (h : rs.Perm qs) :
    (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ≃ₗ[R]
      (M ⧸ (Ideal.ofList qs • (⊤ : Submodule R M))) :=
  quotEquivOfEq _ _ (by rw [Ideal.ofList_perm h])

@[simp]
theorem quotOfListSMulTopEquivOfPerm_mk {rs qs : List R} (h : rs.Perm qs) (m : M) :
    quotOfListSMulTopEquivOfPerm M h (Submodule.Quotient.mk m) = Submodule.Quotient.mk m := (rfl)

@[simp]
theorem quotOfListSMulTopEquivOfPerm_symm_mk {rs qs : List R} (h : rs.Perm qs) (m : M) :
    (quotOfListSMulTopEquivOfPerm M h).symm (Submodule.Quotient.mk m) =
      Submodule.Quotient.mk m := (rfl)

end Ring

section CommRing

variable {R : Type*} [CommRing R] (M : Type*) [AddCommGroup M] [Module R M]

/-- The quotient of `M` by the ideal generated by a singleton `[r]` is canonically equivalent to
`QuotSMulTop r M`. -/
def quotOfListSingletonSMulTopEquiv (r : R) :
    (M ⧸ (Ideal.ofList [r] • (⊤ : Submodule R M))) ≃ₗ[R] QuotSMulTop r M :=
  quotEquivOfEq _ _ (by rw [Ideal.ofList_singleton, ideal_span_singleton_smul])

@[simp]
theorem quotOfListSingletonSMulTopEquiv_mk (r : R) (m : M) :
    quotOfListSingletonSMulTopEquiv M r (Submodule.Quotient.mk m) = Submodule.Quotient.mk m := (rfl)

@[simp]
theorem quotOfListSingletonSMulTopEquiv_symm_mk (r : R) (m : M) :
    (quotOfListSingletonSMulTopEquiv M r).symm (Submodule.Quotient.mk m) =
      Submodule.Quotient.mk m := (rfl)

end CommRing

end Submodule

namespace LinearEquiv

variable {R : Type*} [Ring R] {M N : Type*} [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N]

/-- A linear equivalence `M ≃ₗ[R] N` induces a linear equivalence `M ⧸ I • M ≃ₗ[R] N ⧸ I • N` for
every ideal `I` of `R`. -/
def quotSMulTop (I : Ideal R) (e : M ≃ₗ[R] N) :
    (M ⧸ (I • (⊤ : Submodule R M))) ≃ₗ[R] (N ⧸ (I • (⊤ : Submodule R N))) :=
  Submodule.Quotient.equiv (I • ⊤) (I • ⊤) e <|
    (Submodule.map_smul'' I ⊤ e.toLinearMap).trans (by simp)

@[simp]
theorem quotSMulTop_mk (I : Ideal R) (e : M ≃ₗ[R] N) (m : M) :
    e.quotSMulTop I (Submodule.Quotient.mk m) = Submodule.Quotient.mk (e m) := (rfl)

@[simp]
theorem quotSMulTop_symm_mk (I : Ideal R) (e : M ≃ₗ[R] N) (n : N) :
    (e.quotSMulTop I).symm (Submodule.Quotient.mk n) = Submodule.Quotient.mk (e.symm n) := (rfl)

end LinearEquiv
