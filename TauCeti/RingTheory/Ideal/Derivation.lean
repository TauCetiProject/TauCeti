section CommSemiring

variable (k : Type*) [CommSemiring k] {R : Type*} [CommSemiring R] [Algebra k R]
  {I J : Ideal R}

/-- The derivation ideal of an ideal `I` of a `k`-algebra `R`: the ideal generated by `I` and the
values `D f` of all `k`-derivations `D : Derivation k R R` on elements `f ∈ I`. -/
def derivationIdeal (I : Ideal R) : Ideal R :=
  I ⊔ span (⋃ D : Derivation k R R, D '' I)

/-- The defining expression of `Ideal.derivationIdeal`. -/
theorem derivationIdeal_def (I : Ideal R) :
    I.derivationIdeal k = I ⊔ span (⋃ D : Derivation k R R, D '' I) :=
  (rfl)

/-- Every ideal is contained in its derivation ideal. -/
theorem le_derivationIdeal (I : Ideal R) : I ≤ I.derivationIdeal k :=
  le_sup_left

/-- The derivation ideal contains `D f` for every `f ∈ I` and every `k`-derivation `D`. -/
theorem apply_mem_derivationIdeal (D : Derivation k R R) {f : R} (hf : f ∈ I) :
    D f ∈ I.derivationIdeal k :=
  mem_sup_right (subset_span (Set.mem_iUnion.mpr ⟨D, Set.mem_image_of_mem _ hf⟩))

/-- The derivation ideal of `I` is the smallest ideal containing `I` and `D f` for every
`k`-derivation `D` and every `f ∈ I`. -/
theorem derivationIdeal_le_iff :
    I.derivationIdeal k ≤ J ↔ I ≤ J ∧ ∀ D : Derivation k R R, ∀ f ∈ I, D f ∈ J := by
  rw [derivationIdeal_def, sup_le_iff, span_le, Set.iUnion_subset_iff]
  simp only [Set.subset_def, Set.forall_mem_image, SetLike.mem_coe]

/-- Taking derivation ideals is monotone with respect to ideal inclusion. -/
theorem derivationIdeal_mono : Monotone (derivationIdeal k (R := R)) :=
  fun _ _ h ↦ (derivationIdeal_le_iff k).mpr
    ⟨h.trans (le_derivationIdeal k _), fun D _ hf ↦ apply_mem_derivationIdeal k D (h hf)⟩

/-- The derivation ideal of the zero ideal is the zero ideal. -/
@[simp]
theorem derivationIdeal_bot : (⊥ : Ideal R).derivationIdeal k = ⊥ :=
  le_bot_iff.mp <| (derivationIdeal_le_iff k).mpr
    ⟨le_rfl, fun D f hf ↦ by simp [mem_bot.mp hf]⟩

/-- The derivation ideal of the unit ideal is the unit ideal. -/
@[simp]
theorem derivationIdeal_top : (⊤ : Ideal R).derivationIdeal k = ⊤ :=
  top_le_iff.mp (le_derivationIdeal k ⊤)

/-- The derivation ideal commutes with arbitrary suprema of ideals. -/
@[simp]
theorem derivationIdeal_iSup {ι : Sort*} (I : ι → Ideal R) :
    (⨆ i, I i).derivationIdeal k = ⨆ i, (I i).derivationIdeal k := by
  refine le_antisymm ?_ (iSup_le fun i ↦ derivationIdeal_mono k (le_iSup I i))
  refine (derivationIdeal_le_iff k).mpr
    ⟨iSup_mono fun i ↦ le_derivationIdeal k (I i), fun D f hf ↦ ?_⟩
  induction hf using Submodule.iSup_induction' with
  | mem i x hx =>
    exact le_iSup (fun i ↦ (I i).derivationIdeal k) i (apply_mem_derivationIdeal k D hx)
  | zero => simp
  | add x y _ _ hx hy => simpa using add_mem hx hy

/-- The derivation ideal of a sum of two ideals is the sum of their derivation ideals. -/
@[simp]
theorem derivationIdeal_sup (I J : Ideal R) :
    (I ⊔ J).derivationIdeal k = I.derivationIdeal k ⊔ J.derivationIdeal k := by
  rw [sup_eq_iSup, derivationIdeal_iSup, sup_eq_iSup]
  congr 1
  funext b
  cases b <;> rfl

/-- The derivation ideal of the ideal generated by a set `s` is generated by `s` together with the
values of all `k`-derivations on `s`. -/
theorem derivationIdeal_span (s : Set R) :
    (span s).derivationIdeal k = span (s ∪ ⋃ D : Derivation k R R, D '' s) := by
  refine le_antisymm ((derivationIdeal_le_iff k).mpr ⟨span_mono Set.subset_union_left, ?_⟩) ?_
  · intro D f hf
    induction hf using Submodule.span_induction with
    | mem x hx =>
      exact subset_span (Or.inr (Set.mem_iUnion.mpr ⟨D, Set.mem_image_of_mem _ hx⟩))
    | zero => simp
    | add x y _ _ hx hy => simpa using add_mem hx hy
    | smul a x hx' hx =>
      rw [smul_eq_mul, D.leibniz, smul_eq_mul, smul_eq_mul]
      exact add_mem (mul_mem_left _ _ hx)
        (mul_mem_right _ _ (span_mono Set.subset_union_left hx'))
  · refine span_le.mpr (Set.union_subset (subset_span.trans (le_derivationIdeal k _)) ?_)
    simp only [Set.iUnion_subset_iff, Set.image_subset_iff]
    exact fun D f hf ↦ apply_mem_derivationIdeal k D (subset_span hf)

/-- Every derivation lowers powers of an ideal by at most one: if `I ≤ J ^ (n + 1)` then
`I.derivationIdeal k ≤ J ^ n`. -/
theorem derivationIdeal_le_pow_of_le_pow_succ {n : ℕ} (h : I ≤ J ^ (n + 1)) :
    I.derivationIdeal k ≤ J ^ n := by
  refine (derivationIdeal_le_iff k).mpr ⟨h.trans (Ideal.pow_le_pow_right n.le_succ), ?_⟩
  intro D f hf
  simpa using D.apply_mem_pow_smul_top_of_mem_pow_succ (h hf)

end CommSemiring

section OrderLowerBound

variable (k : Type*) [CommRing k] {R : Type*} [CommRing R] [Algebra k R]

/-- At any prime of any `k`-algebra, the derivation ideal lowers ideal order by at most one. -/
theorem orderAt_le_orderAt_derivationIdeal_add_one (I : Ideal R) (p : PrimeSpectrum R) :
    I.orderAt p ≤ (I.derivationIdeal k).orderAt p + 1 := by
  refine ENat.forall_natCast_le_iff_le.mp fun m hm ↦ ?_
  cases m with
  | zero => simp
  | succ n =>
    rw [natCast_le_orderAt_iff] at hm
    have hle : (I.derivationIdeal k).map (algebraMap R (Localization.AtPrime p.asIdeal)) ≤
        maximalIdeal (Localization.AtPrime p.asIdeal) ^ n := by
      rw [Ideal.map_le_iff_le_comap, derivationIdeal_le_iff]
      refine ⟨(Ideal.map_le_iff_le_comap.mp hm).trans
        (comap_mono (Ideal.pow_le_pow_right n.le_succ)), fun D f hf ↦ ?_⟩
      rw [mem_comap]
      let Dloc : Derivation k (Localization.AtPrime p.asIdeal)
          (Localization.AtPrime p.asIdeal) :=
        ((Algebra.linearMap R (Localization.AtPrime p.asIdeal)).compDer D
          ).extendOfIsLocalization p.asIdeal.primeCompl
      have hmem : algebraMap R (Localization.AtPrime p.asIdeal) f ∈
          maximalIdeal (Localization.AtPrime p.asIdeal) ^ (n + 1) :=
        hm (mem_map_of_mem _ hf)
      have hD := Dloc.apply_mem_pow_smul_top_of_mem_pow_succ hmem
      rw [Derivation.extendOfIsLocalization_algebraMap] at hD
      simpa using hD
    have hn : (n : ℕ∞) ≤ (I.derivationIdeal k).orderAt p :=
      (natCast_le_orderAt_iff _ p n).mpr hle
    push_cast
    gcongr

end OrderLowerBound

section SmoothCharZero

/-! ### Chain rule for derivations on evaluated multivariate polynomials -/

/-- Applying a `k`-derivation of `A` to a monomial evaluated at `t` differentiates the coefficient
and the variable powers via the Leibniz rule. -/
private theorem apply_eval_monomial {k A σ : Type*} [CommRing k] [CommRing A] [Algebra k A]
    [Fintype σ] (D : Derivation k A A) (e : σ →₀ ℕ) (a : A) (t : σ → A) :
    D ((monomial e a).eval t) =
      D a * (∏ j, t j ^ e j) + ∑ j, (pderiv j (monomial e a)).eval t * D (t j) := by
  classical
  have hprod : e.prod (fun j n ↦ t j ^ n) = ∏ j, t j ^ e j :=
    Finsupp.prod_fintype e (fun j n ↦ t j ^ n) fun _ ↦ pow_zero _
  rw [eval_monomial, hprod, D.leibniz, smul_eq_mul, smul_eq_mul, add_comm,
    mul_comm (∏ j, t j ^ e j)]
  congr 1
  rw [D.leibniz_prod, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [smul_eq_mul, D.leibniz_pow, nsmul_eq_mul, smul_eq_mul, pderiv_monomial, eval_monomial,
    Finsupp.prod_fintype _ _ (fun _ ↦ pow_zero _)]
  by_cases hj : e j = 0
  · simp [hj]
  · have hsub : ∏ l, t l ^ (e - Finsupp.single j (1 : ℕ)) l =
        t j ^ (e j - 1) * ∏ l ∈ Finset.univ.erase j, t l ^ e l := by
      rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ j)]
      congr 1
      · simp
      · refine Finset.prod_congr rfl fun l hl ↦ ?_
        simp [Finset.ne_of_mem_erase hl]
    rw [hsub]
    ring

/-- **Chain rule for a derivation on a polynomial evaluated at elements of `A`.** -/
private theorem apply_eval_mvPolynomial {k A σ : Type*} [CommRing k] [CommRing A] [Algebra k A]
    [Fintype σ] (D : Derivation k A A) (F : MvPolynomial σ A) (t : σ → A) :
    D (F.eval t) =
      (∑ e ∈ F.support, D (F.coeff e) * ∏ j, t j ^ e j) +
        ∑ j, (pderiv j F).eval t * D (t j) := by
  classical
  conv_lhs => rw [F.as_sum]
  rw [map_sum, map_sum]
  simp_rw [apply_eval_monomial, Finset.sum_add_distrib]
  congr 1
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [← Finset.sum_mul, ← map_sum, ← map_sum, ← F.as_sum]

/-! ### Lifting residue-field dual functionals to global derivations -/

/-- For a minimal system of generators `t : Fin r → A` of the maximal ideal of a local ring `A`
whose residue field `κ` is formally smooth over `k`, the tensors `1 ⊗ d(t j)` are `κ`-linearly
independent in `κ ⊗[A] Ω[A⁄k]`. -/
private theorem linearIndependent_tmul_D {k A : Type*} [CommRing k] [CommRing A] [Algebra k A]
    [IsLocalRing A] [Algebra.FormallySmooth k (IsLocalRing.ResidueField A)]
    {r : ℕ} {t : Fin r → A} (ht : span (Set.range t) = maximalIdeal A)
    (hr : (maximalIdeal A).spanFinrank = r) :
    LinearIndependent (IsLocalRing.ResidueField A)
      (fun j : Fin r ↦ (1 : IsLocalRing.ResidueField A) ⊗ₜ[A] KaehlerDifferential.D k A (t j)) := by
  set κ := IsLocalRing.ResidueField A
  have hker : RingHom.ker (algebraMap A κ) = maximalIdeal A := by
    rw [IsLocalRing.ResidueField.algebraMap_eq, ker_residue]
  have hsurj : Function.Surjective (algebraMap A κ) := by
    rw [IsLocalRing.ResidueField.algebraMap_eq]
    exact residue_surjective
  have hinj := kerCotangentToTensor_injective_of_formallySmooth (R := k) (P := A) (S := κ) hsurj
  have htker (j : Fin r) : t j ∈ RingHom.ker (algebraMap A κ) :=
    hker.symm ▸ ht ▸ subset_span ⟨j, rfl⟩
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  choose c' hc' using fun j ↦ hsurj (c j)
  have h0 : kerCotangentToTensor k A κ
      ((RingHom.ker (algebraMap A κ)).toCotangent (∑ j, c' j • ⟨t j, htker j⟩)) = 0 := by
    rw [← hc]
    simp only [map_sum, map_smul, kerCotangentToTensor_toCotangent, ← hc']
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [← algebraMap_smul κ (c' j), TensorProduct.smul_tmul']
  have hmem := (Ideal.toCotangent_eq_zero _ _).mp (hinj (h0.trans (map_zero _).symm))
  simp only [Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul, hker] at hmem
  rw [← hc', ← RingHom.mem_ker, hker]
  exact TauCeti.IsLocalRing.mem_maximalIdeal_of_sum_mul_mem_sq ht hr hmem i

/-- Given a `κ`-linear functional `φ : κ ⊗[A] Ω[A⁄k] →ₗ[κ] κ` on a local localization `A` of a
`k`-algebra `R` with finitely generated projective `Ω[R⁄k]`, there exist `s ∈ S` and a global
`k`-derivation `δ : Derivation k R R` whose localization `D : Derivation k A A` satisfies
`residue A (D x) = residue A (algebraMap R A s) * φ (1 ⊗ d x)` for all `x : A`. -/
private theorem exists_derivation_residue_eq {k R A : Type*} [CommRing k] [CommRing R] [CommRing A]
    [Algebra k R] [Algebra R A] [Algebra k A] [IsScalarTower k R A]
    [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (S : Submonoid R) [IsLocalization S A] [IsLocalRing A]
    (φ : IsLocalRing.ResidueField A ⊗[A] Ω[A⁄k] →ₗ[IsLocalRing.ResidueField A]
      IsLocalRing.ResidueField A) :
    ∃ (s : S) (δ : Derivation k R R),
      ∀ x : A,
        residue A ((((Algebra.linearMap R A).compDer δ).extendOfIsLocalization S) x) =
        residue A (algebraMap R A s) *
          φ ((1 : IsLocalRing.ResidueField A) ⊗ₜ[A] KaehlerDifferential.D k A x) := by
  classical
  set κ := IsLocalRing.ResidueField A
  -- Pull `φ` back along `Ω[R⁄k] → Ω[A⁄k] → κ ⊗[A] Ω[A⁄k]` as an `R`-linear map `Ω[R⁄k] →ₗ[R] κ`.
  let f : Ω[R⁄k] →ₗ[R] κ :=
    ((φ.restrictScalars A).comp (TensorProduct.mk A κ Ω[A⁄k] 1)).restrictScalars R ∘ₗ
      KaehlerDifferential.map k k R A
  -- Split `Ω[R⁄k]` as a direct summand of `Fin m → R`.
  obtain ⟨m, q, σ, -, -, hqσ⟩ := Module.Finite.exists_comp_eq_id_of_projective R Ω[R⁄k]
  -- Lift each `f (q e_j) ∈ κ` to `A` and clear denominators simultaneously with `s ∈ S`.
  choose x hx using fun j : Fin m ↦ residue_surjective (R := A) (f (q (Pi.single j 1)))
  choose as has using fun j : Fin m ↦ IsLocalization.surj S (x j)
  let s : S := ∏ j : Fin m, (as j).2
  let b : Fin m → R := fun j ↦ (as j).1 * ∏ l ∈ Finset.univ.erase j, ((as l).2 : R)
  have hb (j : Fin m) : algebraMap R A (b j) = x j * algebraMap R A s := by
    have hs : ((s : S) : R) = ∏ j : Fin m, ((as j).2 : R) := map_prod S.subtype _ _
    simp only [b, map_mul, hs, map_prod]
    rw [← Finset.mul_prod_erase Finset.univ (fun l ↦ algebraMap R A (as l).2) (Finset.mem_univ j),
      ← mul_assoc, has j]
  let h₀ : (Fin m → R) →ₗ[R] R :=
    { toFun := fun v ↦ ∑ j, v j * b j
      map_add' := fun u v ↦ by simp [add_mul, Finset.sum_add_distrib]
      map_smul' := fun r v ↦ by simp [Finset.mul_sum, mul_assoc] }
  let δ : Derivation k R R := (h₀ ∘ₗ σ).compDer (KaehlerDifferential.D k R)
  let Dloc : Derivation k A A := ((Algebra.linearMap R A).compDer δ).extendOfIsLocalization S
  refine ⟨s, δ, ?_⟩
  -- Both sides are derivations `A → κ` agreeing on `algebraMap R A`, hence equal on `A`.
  have hagree (r : R) :
      residue A (Dloc (algebraMap R A r)) =
        residue A (algebraMap R A s) *
          φ ((1 : κ) ⊗ₜ[A] KaehlerDifferential.D k A (algebraMap R A r)) := by
    have hdecomp : σ (KaehlerDifferential.D k R r) =
        ∑ j : Fin m, σ (KaehlerDifferential.D k R r) j • Pi.single j (1 : R) := by
      ext j; simp [Finset.sum_apply, Pi.single_apply]
    have hqσr : q (σ (KaehlerDifferential.D k R r)) = KaehlerDifferential.D k R r :=
      LinearMap.congr_fun hqσ _
    have hfr : f (KaehlerDifferential.D k R r) =
        ∑ j : Fin m, residue A (algebraMap R A (σ (KaehlerDifferential.D k R r) j)) *
          f (q (Pi.single j 1)) := by
      conv_lhs => rw [← hqσr, hdecomp, map_sum, map_sum]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      rw [map_smul, map_smul, Algebra.smul_def, IsScalarTower.algebraMap_apply R A κ,
        IsLocalRing.ResidueField.algebraMap_eq]
    have hloc : Dloc (algebraMap R A r) = algebraMap R A (δ r) := by simp [Dloc]
    have hδr : δ r = ∑ j : Fin m, σ (KaehlerDifferential.D k R r) j * b j := by simp [δ, h₀]
    rw [hloc, hδr, map_sum, map_sum, ← KaehlerDifferential.map_D k k R A r]
    have hfval :
        φ ((1 : κ) ⊗ₜ[A] KaehlerDifferential.map k k R A (KaehlerDifferential.D k R r)) =
          f (KaehlerDifferential.D k R r) := by simp [f]
    rw [hfval, hfr, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [map_mul, map_mul, hb j, map_mul, hx j]
    ring
  have heq := IsLocalization.eq_of_leibniz (A := R) (T := A) (N := κ) S
    (δ₁ := fun x ↦ residue A (Dloc x))
    (δ₂ := fun x ↦ residue A (algebraMap R A s) * φ ((1 : κ) ⊗ₜ[A] KaehlerDifferential.D k A x))
    (fun x y ↦ by
      rw [Dloc.leibniz, map_add, smul_eq_mul, smul_eq_mul, map_mul, map_mul,
        Algebra.smul_def, Algebra.smul_def, IsLocalRing.ResidueField.algebraMap_eq])
    (fun x y ↦ by
      rw [(KaehlerDifferential.D k A).leibniz, TensorProduct.tmul_add, map_add, mul_add,
        TensorProduct.tmul_smul, TensorProduct.tmul_smul,
        ← algebraMap_smul κ x, ← algebraMap_smul κ y, map_smul, map_smul,
        smul_eq_mul, smul_eq_mul, Algebra.smul_def, Algebra.smul_def]
      ring)
    hagree
  exact fun x ↦ congrFun heq x

/-- For a minimal system of generators `t : Fin r → A` of the maximal ideal of a local localization
`A` of `R` (with `Ω[R⁄k]` finite projective and `κ` formally smooth over `k`), each coordinate `i`
admits a global derivation `δ` and a denominator `s ∈ S` such that the localization `D` of `δ`
sends `t j` to `s · δ_{ij}` modulo `𝔪_A`. -/
private theorem exists_dual_derivation {k R A : Type*} [CommRing k] [CommRing R] [CommRing A]
    [Algebra k R] [Algebra R A] [Algebra k A] [IsScalarTower k R A]
    [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (S : Submonoid R) [IsLocalization S A] [IsLocalRing A]
    [Algebra.FormallySmooth k (IsLocalRing.ResidueField A)]
    {r : ℕ} {t : Fin r → A} (ht : span (Set.range t) = maximalIdeal A)
    (hr : (maximalIdeal A).spanFinrank = r) (i : Fin r) :
    ∃ (s : S) (δ : Derivation k R R),
      ∀ j : Fin r,
        residue A ((((Algebra.linearMap R A).compDer δ).extendOfIsLocalization S) (t j)) =
          if j = i then residue A (algebraMap R A s) else 0 := by
  classical
  set κ := IsLocalRing.ResidueField A
  have hli := linearIndependent_tmul_D (k := k) ht hr
  set V := Submodule.span κ
    (Set.range fun j : Fin r ↦ (1 : κ) ⊗ₜ[A] KaehlerDifferential.D k A (t j))
  obtain ⟨W, hVW⟩ := Submodule.exists_isCompl V
  let b := Module.Basis.span hli
  let φ : κ ⊗[A] Ω[A⁄k] →ₗ[κ] κ := (b.coord i).comp (V.projectionOnto W hVW)
  have hφ (j : Fin r) :
      φ ((1 : κ) ⊗ₜ[A] KaehlerDifferential.D k A (t j)) = if j = i then 1 else 0 := by
    have hmem : (1 : κ) ⊗ₜ[A] KaehlerDifferential.D k A (t j) ∈ V := Submodule.subset_span ⟨j, rfl⟩
    have hbj : (⟨(1 : κ) ⊗ₜ[A] KaehlerDifferential.D k A (t j), hmem⟩ : V) = b j := by
      ext; simp [b, Module.Basis.span_apply]
    have hproj : V.projectionOnto W hVW ((1 : κ) ⊗ₜ[A] KaehlerDifferential.D k A (t j)) = b j := by
      rw [← hbj]
      exact V.projectionOnto_apply_left hVW ⟨_, hmem⟩
    rw [LinearMap.comp_apply, hproj, b.coord_apply, b.repr_self, Finsupp.single_apply]
  obtain ⟨s, δ, hδ⟩ := exists_derivation_residue_eq (k := k) S φ
  refine ⟨s, δ, fun j ↦ ?_⟩
  rw [hδ (t j), hφ j]
  split_ifs <;> simp

/-- Every monomial in the support of a degree-`n` homogeneous polynomial, evaluated at generators of
the maximal ideal, lies in `𝔪 ^ n`. -/
private theorem prod_pow_mem_maximalIdeal_pow {A : Type*} [CommRing A] [IsLocalRing A]
    {r n : ℕ} {t : Fin r → A} (ht : span (Set.range t) = maximalIdeal A)
    {F : MvPolynomial (Fin r) A} (hF : F.IsHomogeneous n) {e : Fin r →₀ ℕ}
    (he : e ∈ F.support) :
    (∏ j, t j ^ e j) ∈ maximalIdeal A ^ n := by
  have hdeg : ∑ j, e j = n := by
    simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using hF (mem_support_iff.mp he)
  rw [← hdeg, ← Finset.prod_pow_eq_pow_sum]
  exact Ideal.prod_mem_prod fun j _ ↦
    Ideal.pow_mem_pow (ht ▸ subset_span ⟨j, rfl⟩) (e j)

/-- If a homogeneous form `F` of degree `n + 1` in a regular system of parameters `rs` of `A` has
every global derivation sending `F(rs)` into `𝔪 ^ (n + 1)`, then every partial derivative of
`F.map (residue A)` vanishes. -/
private theorem pderiv_map_residue_eq_zero {k R A : Type*} [Field k] [PerfectField k]
    [CommRing R] [CommRing A] [Algebra k R] [Algebra R A] [Algebra k A] [IsScalarTower k R A]
    [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (S : Submonoid R) [IsLocalization S A] [IsRegularLocalRing A]
    {rs : List A} (hofList : ofList rs = maximalIdeal A)
    (hlen : rs.length = (maximalIdeal A).spanFinrank)
    {n : ℕ} {F : MvPolynomial (Fin rs.length) A} (hF : F.IsHomogeneous (n + 1))
    (hD : ∀ δ : Derivation k R R,
      (((Algebra.linearMap R A).compDer δ).extendOfIsLocalization S) (F.eval fun j ↦ rs[j]) ∈
        maximalIdeal A ^ (n + 1)) (i : Fin rs.length) :
    pderiv i (F.map (residue A)) = 0 := by
  classical
  let t : Fin rs.length → A := fun j ↦ rs[j]
  have ht : span (Set.range t) = maximalIdeal A := by
    rw [← hofList, ofList_eq_span_range_getElem]
  have hreg : RingTheory.Sequence.IsWeaklyRegular A rs :=
    (TauCeti.IsRegularLocalRing.isRegular_of_ofList_eq_maximalIdeal hofList hlen.le
      ).toIsWeaklyRegular
  obtain ⟨s, δ, hDt⟩ := exists_dual_derivation (k := k) S ht hlen.symm i
  let Dloc : Derivation k A A := ((Algebra.linearMap R A).compDer δ).extendOfIsLocalization S
  have hchain := apply_eval_mvPolynomial Dloc F t
  have hcoeff_mem :
      (∑ e ∈ F.support, Dloc (F.coeff e) * ∏ j, t j ^ e j) ∈ maximalIdeal A ^ (n + 1) :=
    Ideal.sum_mem _ fun e he ↦ Ideal.mul_mem_left _ _ (prod_pow_mem_maximalIdeal_pow ht hF he)
  have hderiv_mem (j : Fin rs.length) : (pderiv j F).eval t ∈ maximalIdeal A ^ n := by
    rw [← ht]
    exact (Ideal.mem_span_pow_iff_exists_isHomogeneous t _).mpr ⟨pderiv j F, hF.pderiv, rfl⟩
  have htail_mem :
      (∑ j, (pderiv j F).eval t * Dloc (t j)) -
        (pderiv i F).eval t * algebraMap R A s ∈ maximalIdeal A ^ (n + 1) := by
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i), add_sub_right_comm, ← mul_sub]
    refine Ideal.add_mem _ ?_ (Ideal.sum_mem _ fun j hj ↦ ?_)
    · rw [pow_succ]
      have hsub : residue A (Dloc (t i)) = residue A (algebraMap R A s) := by
        simp [Dloc, hDt i]
      exact Ideal.mul_mem_mul (hderiv_mem i) ((residue_eq_zero_iff _).mp (by
        rw [map_sub, hsub, sub_self]))
    · rw [pow_succ]
      exact Ideal.mul_mem_mul (hderiv_mem j) ((residue_eq_zero_iff _).mp (by
        simp [Dloc, hDt j, Finset.ne_of_mem_erase hj]))
  have hmul_mem : (pderiv i F).eval t * algebraMap R A s ∈ maximalIdeal A ^ (n + 1) := by
    have hsum : (∑ j, (pderiv j F).eval t * Dloc (t j)) ∈ maximalIdeal A ^ (n + 1) := by
      have hsub : Dloc (F.eval t) -
          (∑ e ∈ F.support, Dloc (F.coeff e) * ∏ j, t j ^ e j) ∈ maximalIdeal A ^ (n + 1) :=
        Ideal.sub_mem _ (hD δ) hcoeff_mem
      rwa [hchain, add_sub_cancel_left] at hsub
    simpa using Ideal.sub_mem _ hsum htail_mem
  have hp_eval : (pderiv i F).eval t ∈ maximalIdeal A ^ (n + 1) := by
    obtain ⟨u, hu⟩ := IsLocalization.map_units A s
    have := Ideal.mul_mem_right (↑u⁻¹ : A) _ hmul_mem
    rwa [mul_assoc, ← hu, Units.mul_inv, mul_one] at this
  rw [pderiv_map]
  refine MvPolynomial.ext _ _ fun e ↦ ?_
  rw [coeff_map, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply, residue_eq_zero_iff]
  exact hofList ▸ hreg.coeff_mem_of_eval_mem_pow_succ hF.pderiv (hofList.symm ▸ hp_eval) e

/-- In a regular local localization `A` of `R` with `Ω[R⁄k]` finite projective over a
characteristic-zero field `k`, if `y ∈ 𝔪 ^ (n + 1)` has `D_loc y ∈ 𝔪 ^ (n + 1)` for every global
`k`-derivation `δ : Derivation k R R`, then `y ∈ 𝔪 ^ (n + 2)`. -/
private theorem mem_maximalIdeal_pow_add_two_of_forall_derivation {k R A : Type*} [Field k]
    [CharZero k] [CommRing R] [CommRing A] [Algebra k R] [Algebra R A] [Algebra k A]
    [IsScalarTower k R A] [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (S : Submonoid R) [IsLocalization S A] [IsRegularLocalRing A] {n : ℕ} {y : A}
    (hy : y ∈ maximalIdeal A ^ (n + 1))
    (hD : ∀ δ : Derivation k R R,
      (((Algebra.linearMap R A).compDer δ).extendOfIsLocalization S) y ∈ maximalIdeal A ^ (n + 1)) :
    y ∈ maximalIdeal A ^ (n + 2) := by
  classical
  -- Choose a regular system of parameters `rs` of `A` and write `y = F(rs)` with `F` homogeneous.
  obtain ⟨U, hcard, hU⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (maximalIdeal A).fg_of_isNoetherianRing
  let rs : List A := U.toList
  have hofList : ofList rs = maximalIdeal A := by
    simpa [rs, ofList] using hU
  have hlen : rs.length = (maximalIdeal A).spanFinrank := by simp [rs, hcard]
  let t : Fin rs.length → A := fun i ↦ rs[i]
  have ht : span (Set.range t) = maximalIdeal A := by
    rw [← hofList, ofList_eq_span_range_getElem]
  obtain ⟨F, hF, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous t y).mp (ht.symm ▸ hy)
  -- Every partial derivative of `F.map (residue A)` vanishes, so Euler's identity kills it.
  have hpderiv_zero := pderiv_map_residue_eq_zero (k := k) S hofList hlen hF hD
  have hchar : CharZero (IsLocalRing.ResidueField A) :=
    charZero_of_injective_algebraMap (algebraMap k (IsLocalRing.ResidueField A)).injective
  have heuler := (hF.map (residue A)).sum_X_mul_pderiv
  simp only [hpderiv_zero, mul_zero, Finset.sum_const_zero] at heuler
  have hFmap : F.map (residue A) = 0 := by
    have hcast : ((n + 1 : ℕ) : IsLocalRing.ResidueField A) • F.map (residue A) = 0 := by
      simpa [← Nat.cast_smul_eq_nsmul (IsLocalRing.ResidueField A)] using heuler.symm
    exact (smul_eq_zero.mp hcast).resolve_left (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n))
  -- Every coefficient of `F` lies in `𝔪`, so `F.eval t ∈ 𝔪 ^ (n + 2)`.
  rw [eval_eq']
  refine Ideal.sum_mem _ fun e he ↦ ?_
  have hce : F.coeff e ∈ maximalIdeal A := by
    rw [← residue_eq_zero_iff, ← coeff_map, hFmap]
    simp
  rw [pow_succ']
  exact Ideal.mul_mem_mul hce (prod_pow_mem_maximalIdeal_pow ht hF he)

variable (k : Type*) [Field k] [CharZero k] {R : Type*} [CommRing R] [Algebra k R]

/-- **In characteristic zero, the derivation ideal lowers order at a regular prime by one.**
When `Ω[R⁄k]` is finitely generated and projective over `R` and `R_p` is regular local,
`(I.derivationIdeal k).orderAt p = I.orderAt p - 1`. -/
theorem orderAt_derivationIdeal [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (I : Ideal R) (p : PrimeSpectrum R) [IsRegularLocalRing (Localization.AtPrime p.asIdeal)] :
    (I.derivationIdeal k).orderAt p = I.orderAt p - 1 := by
  refine le_antisymm ?_
    (tsub_le_iff_right.mpr (orderAt_le_orderAt_derivationIdeal_add_one k I p))
  refine ENat.forall_natCast_le_iff_le.mp fun m hm ↦ ?_
  cases m with
  | zero => simp
  | succ n =>
    refine ENat.le_sub_of_add_le_right ENat.one_ne_top ?_
    have hle : ((n + 2 : ℕ) : ℕ∞) ≤ I.orderAt p := by
      rw [natCast_le_orderAt_iff] at hm ⊢
      rw [Ideal.map_le_iff_le_comap]
      intro f hf
      rw [mem_comap]
      refine mem_maximalIdeal_pow_add_two_of_forall_derivation (k := k) p.asIdeal.primeCompl
        (hm (mem_map_of_mem _ (le_derivationIdeal k I hf))) fun δ ↦ ?_
      rw [Derivation.extendOfIsLocalization_algebraMap]
      exact hm (mem_map_of_mem _ (apply_mem_derivationIdeal k δ hf))
    exact_mod_cast hle

/-- In characteristic zero, the `n`-th iterated derivation ideal lowers the order at a regular
prime by `n` (truncated at zero). -/
theorem orderAt_derivationIdeal_iterate [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (I : Ideal R) (p : PrimeSpectrum R) [IsRegularLocalRing (Localization.AtPrime p.asIdeal)]
    (n : ℕ) :
    ((derivationIdeal k)^[n] I).orderAt p = I.orderAt p - n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply', orderAt_derivationIdeal, ih, tsub_tsub, Nat.cast_succ]

/-- In characteristic zero, at a regular prime of an algebra with finitely generated projective
differentials, an ideal has order at least `n + 1` precisely when its `n`-th iterated derivation
ideal lies in that prime. -/
theorem natCast_add_one_le_orderAt_iff_iterate_derivationIdeal_le [Module.Projective R Ω[R⁄k]]
    [Module.Finite R Ω[R⁄k]] (I : Ideal R) (p : PrimeSpectrum R)
    [IsRegularLocalRing (Localization.AtPrime p.asIdeal)] (n : ℕ) :
    ((n + 1 : ℕ) : ℕ∞) ≤ I.orderAt p ↔ (derivationIdeal k)^[n] I ≤ p.asIdeal := by
  rw [← one_le_orderAt_iff, orderAt_derivationIdeal_iterate k]
  cases h : I.orderAt p with
  | top => simp
  | coe a =>
    rw [← ENat.natCast_sub]
    norm_cast
    omega

/-- Over a characteristic-zero field, on a regular ring with finitely generated projective
differentials, the order-threshold locus `{p | n + 1 ≤ I.orderAt p}` is the zero locus of the
`n`-th iterated derivation ideal. -/
theorem setOf_natCast_add_one_le_orderAt_eq_zeroLocus [Module.Projective R Ω[R⁄k]]
    [Module.Finite R Ω[R⁄k]] [IsRegularRing R] (I : Ideal R) (n : ℕ) :
    {p : PrimeSpectrum R | ((n + 1 : ℕ) : ℕ∞) ≤ I.orderAt p} =
      PrimeSpectrum.zeroLocus (((derivationIdeal k)^[n] I) : Set R) := by
  ext p
  simp only [Set.mem_ofPred_eq, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
  exact natCast_add_one_le_orderAt_iff_iterate_derivationIdeal_le k I p n

/-- **Order-threshold loci are Zariski closed.** Over a characteristic-zero field, on a regular
ring with finitely generated projective differentials, `{p | c ≤ I.orderAt p}` is closed in
`PrimeSpectrum R` for every `c : ℕ∞` (including `c = ⊤`). -/
theorem isClosed_setOf_le_orderAt [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    [IsRegularRing R] (I : Ideal R) (c : ℕ∞) :
    IsClosed {p : PrimeSpectrum R | c ≤ I.orderAt p} := by
  cases c with
  | top =>
    have heq : {p : PrimeSpectrum R | (⊤ : ℕ∞) ≤ I.orderAt p} =
        ⋂ n : ℕ, {p : PrimeSpectrum R | ((n + 1 : ℕ) : ℕ∞) ≤ I.orderAt p} := by
      ext p
      simp only [Set.mem_ofPred_eq, Set.mem_iInter, top_le_iff]
      cases h : I.orderAt p with
      | top => simp
      | coe a =>
        simp only [ENat.natCast_ne_top, false_iff, not_forall]
        exact ⟨a, by norm_cast; omega⟩
    rw [heq]
    refine isClosed_iInter fun n ↦ ?_
    rw [setOf_natCast_add_one_le_orderAt_eq_zeroLocus k I n]
    exact PrimeSpectrum.isClosed_zeroLocus _
  | coe d =>
    cases d with
    | zero => simp
    | succ n =>
      rw [setOf_natCast_add_one_le_orderAt_eq_zeroLocus k I n]
      exact PrimeSpectrum.isClosed_zeroLocus _

/-- On a smooth algebra over a characteristic-zero field, every order-threshold locus
`{p | c ≤ I.orderAt p}` is Zariski closed. -/
theorem isClosed_setOf_le_orderAt_of_smooth [Algebra.Smooth k R] (I : Ideal R) (c : ℕ∞) :
    IsClosed {p : PrimeSpectrum R | c ≤ I.orderAt p} := by
  have : IsRegularRing R := TauCeti.IsRegularRing.of_smooth (R := k)
  exact isClosed_setOf_le_orderAt k I c

/-- On a regular algebra of finite type over a characteristic-zero field, every order-threshold
locus `{p | c ≤ I.orderAt p}` is Zariski closed. -/
theorem isClosed_setOf_le_orderAt_of_finiteType [Algebra.FiniteType k R] [IsRegularRing R]
    (I : Ideal R) (c : ℕ∞) :
    IsClosed {p : PrimeSpectrum R | c ≤ I.orderAt p} := by
  have : Algebra.Smooth k R := TauCeti.smooth_of_isRegularRing (k := k)
  exact isClosed_setOf_le_orderAt k I c

