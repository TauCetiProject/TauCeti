module

public import Mathlib.Algebra.CharZero.Defs
public import Mathlib.RingTheory.Ideal.Span

/-!
# Nonzero principal ideals generated by natural numbers

In a characteristic-zero semiring `R`, a nonzero natural number `n` casts to a nonzero element of
`R`, so the principal ideal `Ideal.span {(n : R)}` is nonzero. Packaging the composition of
`Ideal.span_singleton_eq_bot` with `Nat.cast_ne_zero` lets callers discharge `I ≠ ⊥` side
conditions (for example in `IsDedekindDomain.coe_primesOverFinset` and
`IsDedekindDomain.mem_primesOverFinset_iff` at rational primes `(p : ℤ)`) in a single term.

## Main results

* `Ideal.span_singleton_natCast_ne_bot`: if `n ≠ 0` and `[CharZero R]`, then
  `Ideal.span {(n : R)} ≠ ⊥`.
-/

public section

namespace Ideal

/-- In a characteristic-zero semiring, the ideal spanned by a nonzero natural number is nonzero. -/
theorem span_singleton_natCast_ne_bot {R : Type*} [Semiring R] [CharZero R] {n : ℕ}
    (hn : n ≠ 0) : Ideal.span {(n : R)} ≠ ⊥ := by
  simpa using hn

end Ideal
