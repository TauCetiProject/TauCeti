module

public import Mathlib.RingTheory.Ideal.Span
import Mathlib.Algebra.Algebra.Bilinear
import Mathlib.Algebra.Module.Submodule.EqLocus

/-!
# Principal ideals of integer casts, and sets generating the unit ideal

In any ring `R`, an integer `a : ℤ` casts to `±(a.natAbs : R)`, so the two-sided ideal generated by
`(a : R)` coincides with the ideal generated by `(a.natAbs : R)`. This extends Mathlib's
`Int.span_natAbs` from `ℤ` to an arbitrary ring. In a commutative semiring, an element is
determined by its products with any set generating the unit ideal.

A minimal nonzero ideal is spanned by any of its nonzero elements (`IsAtom.span_singleton_eq`).

## Main results

* `Ideal.span_singleton_intCast_eq_natAbs`: `Ideal.span {(a : R)} = Ideal.span {(a.natAbs : R)}` in
  any ring `R`.
* `Ideal.eq_of_forall_mul_eq_of_span_eq_top`: if `T` generates the unit ideal and `s x = t x` for
  every `x ∈ T`, then `s = t`.
-/

public section

namespace Ideal

/-- In any ring `R`, the ideal generated by `(a : R)` for an integer `a` equals the ideal generated
by `(a.natAbs : R)`. -/
theorem span_singleton_intCast_eq_natAbs {R : Type*} [Ring R] (a : ℤ) :
    span {(a : R)} = span {(a.natAbs : R)} := by
  rcases Int.natAbs_eq a with h | h
  · conv_lhs => rw [h, Int.cast_natCast]
  · conv_lhs => rw [h, Int.cast_neg, Int.cast_natCast, span_singleton_neg]

/-- In a characteristic-zero semiring, the ideal spanned by a nonzero natural number is nonzero. -/
theorem span_singleton_natCast_ne_bot {R : Type*} [Semiring R] [CharZero R] {n : ℕ}
    (hn : n ≠ 0) : Ideal.span {(n : R)} ≠ ⊥ := by
  simpa using hn

/-- In a commutative semiring, an element is determined by its products with the elements of a set
generating the unit ideal: if `s * x = t * x` for every `x ∈ T` and `Ideal.span T = ⊤`, then
`s = t`. -/
theorem eq_of_forall_mul_eq_of_span_eq_top {R : Type*} [CommSemiring R] {T : Set R}
    (hT : span T = ⊤) {s t : R} (h : ∀ x ∈ T, s * x = t * x) : s = t := by
  have hle : span T ≤ LinearMap.eqLocus (LinearMap.mulLeft R s) (LinearMap.mulLeft R t) :=
    span_le.mpr fun x hx ↦ LinearMap.mem_eqLocus.mpr (by simpa using h x hx)
  simpa using LinearMap.mem_eqLocus.mp (hle (hT ▸ Submodule.mem_top : (1 : R) ∈ span T))

end Ideal

/-- A minimal nonzero ideal is spanned by any of its nonzero elements. -/
theorem IsAtom.span_singleton_eq {R : Type*} [Semiring R] {I : Ideal R} (hI : IsAtom I) {t : R}
    (ht : t ∈ I) (ht0 : t ≠ 0) : Ideal.span {t} = I :=
  (hI.le_iff.mp ((Ideal.span_singleton_le_iff_mem _).mpr ht)).resolve_left
    (by rwa [Ideal.span_singleton_eq_bot])
