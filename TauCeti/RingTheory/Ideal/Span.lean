module

public import Mathlib.RingTheory.Ideal.Span

/-!
# Complements on spans of ideals

This file collects general facts about ideals generated by subsets of a ring, complementing
`Mathlib.RingTheory.Ideal.Span`.

## Main results

* `Ideal.sup_eq_span_union`: the supremum of two ideals is spanned by the union of their
  underlying sets.
-/

public section

namespace Ideal

/-- The supremum of two ideals is the ideal generated by the union of their underlying sets. -/
theorem sup_eq_span_union {α : Type*} [Semiring α] (I J : Ideal α) :
    I ⊔ J = span ((I : Set α) ∪ (J : Set α)) := by
  rw [span_union, span_eq, span_eq]

end Ideal
