/-!
# Flat ideals generated by regular elements

An ideal generated by a family of nonzerodivisors directed under reverse divisibility is flat.
In particular, the ideal generated by a compatible system of roots of a nonzerodivisor is flat.
This applies to compatible roots of a pseudouniformiser in a ring of integral elements, without
requiring the ambient ring to be a domain.

The flatness argument uses Mathlib's equational criterion: finitely many elements of the ideal
have a common regular divisor, and cancelling that divisor makes every relation trivial.

Without any regularity assumption, if an idempotent ideal `I` is directed under reverse
divisibility (condition (A) of Gabber–Ramero (2.1.6): any two elements of `I` have a common
divisor in `I`), then `I ⊗[R] I` is flat
(`Ideal.flat_tensorProduct_self_of_directed_dvd`). This is the flatness of `m~` needed for a
basic setup of almost mathematics. Here finitely many elements of `I ⊗[R] I` are multiples of a
single `z ⊗ z`, and a relation `a • (x ⊗ x) = 0` already holds in `(R ∙ z) ⊗[R] (R ∙ z)`.

## References

* B. Bhatt, *Lecture notes for a class on perfectoid spaces*, §4.1, Example 4.1.3.
* O. Gabber, L. Ramero, *Almost ring theory*, Lecture Notes in Mathematics 1800, §2.1:
  (2.1.6) and Proposition 2.1.7.
-/

public section

namespace Ideal

variable {R : Type*} [CommRing R]

/-- An ideal generated by regular elements directed under reverse divisibility is flat. -/
theorem flat_span_range_of_directed_dvd {ι : Type*} (r : ι → R)
    (hdir : Directed (fun a b : R ↦ b ∣ a) r)
    (hreg : ∀ i, IsSMulRegular R (r i)) : Module.Flat R (span (Set.range r)) := by
  classical
  cases isEmpty_or_nonempty ι
  · rw [Set.range_eq_empty, span_empty]
    infer_instance
  have hspan : Directed (· ≤ ·) (fun i ↦ span {r i}) := by
    intro i j
    obtain ⟨k, hi, hj⟩ := hdir i j
    exact ⟨k, span_singleton_le_span_singleton.mpr hi,
      span_singleton_le_span_singleton.mpr hj⟩
  have hmem {x : R} (hx : x ∈ span (Set.range r)) : ∃ i, r i ∣ x := by
    rw [← submodule_span_eq, Submodule.span_range_eq_iSup] at hx
    obtain ⟨i, hi⟩ := Submodule.mem_iSup_of_directed _ hspan |>.mp hx
    exact ⟨i, mem_span_singleton.mp hi⟩
  refine Module.Flat.of_forall_isTrivialRelation fun {l f x} hfx ↦ ?_
  choose n hn using fun i ↦ hmem (x i).property
  obtain ⟨k, hk⟩ := hdir.finset_le (Finset.univ.image n)
  have hdiv (i : Fin l) : r k ∣ (x i : R) :=
    (hk (n i) (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩)).trans (hn i)
  choose b hb using hdiv
  refine ⟨1, fun i _ ↦ b i, fun _ ↦ ⟨r k, subset_span ⟨k, rfl⟩⟩, fun i ↦ ?_, fun _ ↦ ?_⟩
  · apply Subtype.ext
    simpa [mul_comm] using hb i
  · apply hreg k
    have h := congrArg (Subtype.val : span (Set.range r) → R) hfx
    simpa [Submodule.coe_sum, hb, smul_eq_mul, Finset.mul_sum,
      mul_left_comm, mul_assoc] using h

/-! ### Condition (A) and flatness of `I ⊗[R] I`

Condition (A) on an ideal `I` (Gabber–Ramero (2.1.6)) says that any two elements of `I` have a
common divisor in `I`. -/

section FilteredPrincipal

open TensorProduct

variable {I : Ideal R}

/-- A divisibility in `R` between two elements of `I` is a membership in a cyclic submodule
of `I`. -/
theorem mem_span_singleton_of_coe_dvd {x z : I} (h : (z : R) ∣ x) : x ∈ R ∙ z := by
  obtain ⟨c, hc⟩ := h
  exact Submodule.mem_span_singleton.mpr ⟨c, Subtype.ext (by simp [hc, mul_comm])⟩

variable (hI : ∀ x ∈ I, ∀ y ∈ I, ∃ z ∈ I, z ∣ x ∧ z ∣ y)
include hI

/-- Under condition (A), two elements of `I` lie in a common cyclic submodule of `I`. -/
theorem exists_mem_span_singleton_of_directed_dvd (x y : I) :
    ∃ z : I, x ∈ R ∙ z ∧ y ∈ R ∙ z := by
  obtain ⟨z, hz, hx, hy⟩ := hI x x.2 y y.2
  exact ⟨⟨z, hz⟩, mem_span_singleton_of_coe_dvd hx, mem_span_singleton_of_coe_dvd hy⟩

/-- Under condition (A), every finitely generated submodule of `I` lies in a cyclic one. -/
theorem exists_le_span_singleton_of_directed_dvd {Q : Submodule R I} (hQ : Q.FG) :
    ∃ z : I, Q ≤ R ∙ z := by
  classical
  obtain ⟨s, rfl⟩ := hQ
  suffices ∃ z : I, ∀ x ∈ s, x ∈ R ∙ z from
    this.imp fun z hz ↦ Submodule.span_le.mpr hz
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | insert a s _ ih =>
    obtain ⟨z₁, hz₁⟩ := ih
    obtain ⟨z, ha, h₁⟩ := exists_mem_span_singleton_of_directed_dvd hI a z₁
    refine ⟨z, fun x hx ↦ ?_⟩
    rcases Finset.mem_insert.mp hx with rfl | hx
    · exact ha
    · exact Submodule.span_singleton_le_iff_mem _ _ |>.mpr h₁ (hz₁ x hx)

/-- Under condition (A), a tensor that vanishes in `I ⊗[R] N` and comes from a finitely
generated submodule of `I` already vanishes in `(R ∙ z) ⊗[R] N` for some `z ∈ I`. -/
theorem exists_rTensor_inclusion_eq_zero_of_directed_dvd (N : Type*) [AddCommGroup N]
    [Module R N] {P : Submodule R I} (hP : P.FG) {t : P ⊗[R] N} (ht : P.subtype.rTensor N t = 0) :
    ∃ (z : I) (h : P ≤ R ∙ z), (Submodule.inclusion h).rTensor N t = 0 := by
  obtain ⟨Q, hPQ, hQ, hQt⟩ := TensorProduct.eq_zero_of_fg_of_subtype_eq_zero hP ht
  obtain ⟨z, hz⟩ := exists_le_span_singleton_of_directed_dvd hI hQ
  have : Submodule.inclusion (hPQ.trans hz) =
      Submodule.inclusion hz ∘ₗ Submodule.inclusion hPQ := by
    ext; simp
  exact ⟨z, hPQ.trans hz, by rw [this, LinearMap.rTensor_comp_apply, hQt, map_zero]⟩

omit hI in
/-- The bilinear map `(R ∙ z) × (R ∙ z) → I`, `(c • z, t) ↦ c • t`, well defined because the
annihilator of `z` kills `R ∙ z`. -/
private noncomputable def spanSingletonMul (z : I) : (R ∙ z) →ₗ[R] (R ∙ z) →ₗ[R] I :=
  (Ideal.torsionOf R I z).liftQ ((LinearMap.lsmul R I).compl₂ (R ∙ z).subtype)
      (fun u hu ↦ LinearMap.mem_ker.mpr <| LinearMap.ext fun t ↦ by
        obtain ⟨d, hd⟩ := Submodule.mem_span_singleton.mp t.2
        rw [Ideal.mem_torsionOf_iff] at hu
        simp [← hd, hu]) ∘ₗ
    (Ideal.quotTorsionOfEquivSpanSingleton R I z).symm.toLinearMap

omit hI in
private theorem spanSingletonMul_apply {z : I} {c : R} {s : R ∙ z} (hs : (s : I) = c • z)
    (t : R ∙ z) : spanSingletonMul z s t = c • (t : I) := by
  have : (Ideal.quotTorsionOfEquivSpanSingleton R I z).symm s = Submodule.Quotient.mk c := by
    rw [LinearEquiv.symm_apply_eq, Ideal.quotTorsionOfEquivSpanSingleton_apply_mk]
    exact Subtype.ext (by simp [hs])
  simp only [spanSingletonMul, LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply, this,
    Submodule.liftQ_apply, LinearMap.compl₂_apply, LinearMap.lsmul_apply, Submodule.subtype_apply]

/-- Under condition (A), if `a • (x ⊗ x) = 0` in `I ⊗[R] I` then `x = c • z` for some `z ∈ I`
with `a * c * c * z = 0`: the vanishing already happens in `(R ∙ z) ⊗[R] (R ∙ z) ≅ R ∙ z`. -/
theorem exists_eq_smul_and_mul_eq_zero_of_directed_dvd {x : I} {a : R}
    (h : a • (x ⊗ₜ[R] x) = 0) : ∃ (z : I) (c : R), x = c • z ∧ a * c * c * z = 0 := by
  let x₀ : R ∙ x := ⟨x, Submodule.mem_span_singleton_self x⟩
  -- Make the left factor cyclic: the vanishing holds in `(R ∙ z₁) ⊗[R] I`.
  obtain ⟨z₁, h₁, ht₁⟩ := exists_rTensor_inclusion_eq_zero_of_directed_dvd hI I
    (Submodule.fg_span_singleton x) (t := a • (x₀ ⊗ₜ x)) (by simpa [x₀] using h)
  let x₁ : R ∙ z₁ := Submodule.inclusion h₁ x₀
  -- Swap the factors and make the other factor cyclic as well, containing the first one.
  obtain ⟨z, h, ht⟩ := exists_rTensor_inclusion_eq_zero_of_directed_dvd hI (R ∙ z₁)
    (Submodule.fg_span_singleton z₁) (t := a • (x₁ ⊗ₜ x₁)) (by
      simpa [x₁] using congrArg (TensorProduct.comm R (R ∙ z₁) I) ht₁)
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (h (h₁ x₀.2))
  have hxz : c * (z : R) = x := by simpa [x₀] using congrArg Subtype.val hc
  refine ⟨z, c, by simpa [x₀] using hc.symm, ?_⟩
  -- Apply the identification `(R ∙ z) ⊗[R] (R ∙ z) ≅ R ∙ z`.
  have := congrArg (TensorProduct.lift (spanSingletonMul z) ∘ₗ
    (Submodule.inclusion h).lTensor (R ∙ z)) ht
  simp only [map_smul, LinearMap.rTensor_tmul,
    LinearMap.coe_comp, Function.comp_apply, LinearMap.lTensor_tmul, TensorProduct.lift.tmul,
    map_zero] at this
  rw [spanSingletonMul_apply (c := c) (by simp [x₁, x₀, hc])] at this
  have := congrArg (Subtype.val : I → R) this
  simp only [Submodule.coe_smul, Submodule.coe_inclusion, x₁, x₀, smul_eq_mul,
    ZeroMemClass.coe_zero] at this
  linear_combination this + a * c * hxz

/-- Under condition (A), finitely many elements of `I ⊗[R] I` are multiples of a single
`z ⊗ z` with `z ∈ I`. -/
theorem exists_forall_mem_span_tmul_self_of_directed_dvd (s : Finset (I ⊗[R] I)) :
    ∃ z : I, ∀ t ∈ s, t ∈ R ∙ (z ⊗ₜ[R] z) := by
  classical
  have hmono {z z' : I} (hz : z ∈ R ∙ z') : R ∙ (z ⊗ₜ[R] z) ≤ R ∙ (z' ⊗ₜ[R] z') := by
    obtain ⟨d, rfl⟩ := Submodule.mem_span_singleton.mp hz
    rw [Submodule.span_singleton_le_iff_mem, smul_tmul_smul]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
  have hone (t : I ⊗[R] I) : ∃ z : I, t ∈ R ∙ (z ⊗ₜ[R] z) := by
    induction t using TensorProduct.inductionOn with
    | tmul x y =>
      obtain ⟨z, hx, hy⟩ := exists_mem_span_singleton_of_directed_dvd hI x y
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hx
      obtain ⟨d, rfl⟩ := Submodule.mem_span_singleton.mp hy
      rw [smul_tmul_smul]
      exact ⟨z, Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)⟩
    | add t t' ht ht' =>
      obtain ⟨z₁, hz₁⟩ := ht
      obtain ⟨z₂, hz₂⟩ := ht'
      obtain ⟨z, h₁, h₂⟩ := exists_mem_span_singleton_of_directed_dvd hI z₁ z₂
      exact ⟨z, add_mem (hmono h₁ hz₁) (hmono h₂ hz₂)⟩
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | insert t s _ ih =>
    obtain ⟨z₁, hz₁⟩ := ih
    obtain ⟨z₂, hz₂⟩ := hone t
    obtain ⟨z, h₁, h₂⟩ := exists_mem_span_singleton_of_directed_dvd hI z₁ z₂
    refine ⟨z, fun t' ht' ↦ ?_⟩
    rcases Finset.mem_insert.mp ht' with rfl | ht'
    · exact hmono h₂ hz₂
    · exact hmono h₁ (hz₁ t' ht')

/-- **Condition (A) makes `m~` flat** (Gabber–Ramero (2.1.6) and Proposition 2.1.7(i)): if `I` is
an idempotent ideal any two of whose elements have a common divisor in `I`, so that `I` is the
directed union of the principal ideals generated by its elements, then `m~ = I ⊗[R] I` is a flat
`R`-module. No element of `I` needs to be a nonzerodivisor. -/
theorem flat_tensorProduct_self_of_directed_dvd (hIdem : IsIdempotentElem I) :
    Module.Flat R (I ⊗[R] I) := by
  classical
  refine Module.Flat.of_forall_isTrivialRelation fun {l f t} hft ↦ ?_
  -- All the `t i` are multiples `c i • (z ⊗ z)` of a single `z ⊗ z`.
  obtain ⟨z, hz⟩ := exists_forall_mem_span_tmul_self_of_directed_dvd hI (Finset.univ.image t)
  choose c hc using fun i ↦ Submodule.mem_span_singleton.mp
    (hz (t i) (Finset.mem_image_of_mem t (Finset.mem_univ i)))
  have ha : (∑ i, f i * c i) • (z ⊗ₜ[R] z) = 0 := by
    simpa [Finset.sum_smul, ← hc, smul_smul] using hft
  -- Write `z = c' • w` with `a * c' * c' * w = 0`, and `w = y ^ 2 * d` with `y ∈ I`.
  obtain ⟨w, c', hzw, hw⟩ := exists_eq_smul_and_mul_eq_zero_of_directed_dvd hI ha
  obtain ⟨y, hy, d, hd⟩ := exists_pow_dvd_of_mem_pow hI 2 w
    (by rw [hIdem.pow_eq two_ne_zero]; exact w.2)
  have hzy : z = (c' * y * d) • (⟨y, hy⟩ : I) := by
    rw [hzw]
    ext
    simp only [Submodule.coe_smul, smul_eq_mul, hd]
    ring
  refine ⟨1, fun i _ ↦ c i * (c' * y * d) ^ 2, fun _ ↦ ⟨y, hy⟩ ⊗ₜ[R] ⟨y, hy⟩, fun i ↦ ?_,
    fun _ ↦ ?_⟩
  · rw [← hc i, hzy, smul_tmul_smul, Fin.sum_univ_one, smul_smul, sq]
  · rw [Finset.sum_congr rfl fun i _ ↦ (mul_assoc (f i) (c i) _).symm, ← Finset.sum_mul]
    linear_combination (d : R) * hw - (∑ i, f i * c i) * c' ^ 2 * d * hd

end FilteredPrincipal

end Ideal

namespace Perfection

variable {R : Type*} [CommRing R]

/-- The ideal generated by compatible roots of a nonzerodivisor is flat. Neither primality
of the exponent nor a characteristic assumption on the ring is required. -/
theorem flat_span_range_of_isSMulRegular {p : ℕ} [NeZero p] (r : Perfection R p)
    (hreg : IsSMulRegular R (Perfection.coeffMonoidHom R p 0 r)) :
    Module.Flat R (Ideal.span (Set.range fun n ↦ Perfection.coeffMonoidHom R p n r)) := by
  apply Ideal.flat_span_range_of_directed_dvd
  · have hdvd {i j : ℕ} (hij : i ≤ j) :
        Perfection.coeffMonoidHom R p j r ∣ Perfection.coeffMonoidHom R p i r :=
      TauCeti.dvd_of_compatible_roots (fun n ↦ r.2 n) hij
    exact fun i j ↦ ⟨max i j, hdvd (le_max_left i j), hdvd (le_max_right i j)⟩
  · intro n
    apply (IsSMulRegular.pow_iff (pow_pos (NeZero.pos p) n)).mp
    simpa only [Perfection.coeffMonoidHom_pow_p_pow_self] using hreg

end Perfection
