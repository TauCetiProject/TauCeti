module

public import Mathlib.RingTheory.Flat.EquationalCriterion
public import Mathlib.RingTheory.Perfection
import Mathlib.Data.Finset.Order
import Mathlib.Algebra.Regular.SMul

/-!
# Flat ideals generated by regular elements

An ideal generated by a family of nonzerodivisors directed under reverse divisibility is flat.
In particular, the ideal generated by a compatible system of roots of a nonzerodivisor is flat.
This applies to compatible roots of a pseudouniformiser in a ring of integral elements, without
requiring the ambient ring to be a domain.

The flatness argument uses Mathlib's equational criterion: finitely many elements of the ideal
have a common regular divisor, and cancelling that divisor makes every relation trivial.

## References

* B. Bhatt, *Lecture notes for a class on perfectoid spaces*, §4.1, Example 4.1.3.
-/

public section

namespace Ideal

variable {R : Type*} [CommRing R]

/-- An ideal generated by regular elements directed under reverse divisibility is flat. -/
theorem flat_span_range_of_directed_dvd {ι : Type*} (r : ι → R)
    (hdir : Directed (fun a b : R ↦ b ∣ a) r)
    (hreg : ∀ i, IsSMulRegular R (r i)) : Module.Flat R (span (Set.range r)) := by
  classical
  cases isEmpty_or_nonempty ι
  · rw [Set.range_eq_empty, span_empty]
    infer_instance
  have hspan : Directed (· ≤ ·) (fun i ↦ span {r i}) := by
    intro i j
    obtain ⟨k, hi, hj⟩ := hdir i j
    exact ⟨k, span_singleton_le_span_singleton.mpr hi,
      span_singleton_le_span_singleton.mpr hj⟩
  have hmem {x : R} (hx : x ∈ span (Set.range r)) : ∃ i, r i ∣ x := by
    rw [← submodule_span_eq, Submodule.span_range_eq_iSup] at hx
    obtain ⟨i, hi⟩ := Submodule.mem_iSup_of_directed _ hspan |>.mp hx
    exact ⟨i, mem_span_singleton.mp hi⟩
  refine Module.Flat.of_forall_isTrivialRelation fun {l f x} hfx ↦ ?_
  choose n hn using fun i ↦ hmem (x i).property
  obtain ⟨k, hk⟩ := hdir.finset_le (Finset.univ.image n)
  have hdiv (i : Fin l) : r k ∣ (x i : R) :=
    (hk (n i) (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩)).trans (hn i)
  choose b hb using hdiv
  refine ⟨1, fun i _ ↦ b i, fun _ ↦ ⟨r k, subset_span ⟨k, rfl⟩⟩, fun i ↦ ?_, fun _ ↦ ?_⟩
  · apply Subtype.ext
    simpa [mul_comm] using hb i
  · apply hreg k
    have h := congrArg (Subtype.val : span (Set.range r) → R) hfx
    simpa [Submodule.coe_sum, hb, smul_eq_mul, Finset.mul_sum,
      mul_left_comm, mul_assoc] using h

end Ideal

namespace Perfection

variable {R : Type*} [CommRing R]

/-- The ideal generated by compatible roots of a nonzerodivisor is flat. Neither primality
of the exponent nor a characteristic assumption on the ring is required. -/
theorem flat_span_range_of_isSMulRegular {p : ℕ} [NeZero p] (r : Perfection R p)
    (hreg : IsSMulRegular R (Perfection.coeffMonoidHom R p 0 r)) :
    Module.Flat R (Ideal.span (Set.range fun n ↦ Perfection.coeffMonoidHom R p n r)) := by
  apply Ideal.flat_span_range_of_directed_dvd
  · have hdvd {i j : ℕ} (hij : i ≤ j) :
        Perfection.coeffMonoidHom R p j r ∣ Perfection.coeffMonoidHom R p i r := by
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hij
      rw [← Perfection.coeffMonoidHom_pow_p_pow' r i k]
      exact dvd_pow_self _ (pow_ne_zero k (NeZero.ne p))
    exact fun i j ↦ ⟨max i j, hdvd (le_max_left i j), hdvd (le_max_right i j)⟩
  · intro n
    apply (IsSMulRegular.pow_iff (pow_pos (NeZero.pos p) n)).mp
    simpa only [Perfection.coeffMonoidHom_pow_p_pow_self] using hreg

end Perfection
