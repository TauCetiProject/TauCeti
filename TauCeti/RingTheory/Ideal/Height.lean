module

public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import Mathlib.RingTheory.UniqueFactorizationDomain.Ideal

/-!
# Height bounds and detection of units

In a local ring of finite Krull dimension `n + 1`, the maximal ideal is the only prime of height
greater than `n`. This complements Mathlib's `Ideal.height_eq_ringKrullDim_iff`.

In a Noetherian ring, an element is a unit if it belongs to no prime of height at most one.
Indeed, a nonunit generates a proper principal ideal, and a minimal prime over that ideal has
height at most one by Krull's principal ideal theorem. Applied to a discriminant, this detects
étaleness of a finite free algebra using only primes of height at most one. By the same theorem,
every nonzero prime of a Noetherian domain contains a prime of height one, namely a prime minimal
over a nonzero element; in particular a Noetherian domain which is not a field has a prime of
height one.

In a unique factorization domain, a prime ideal of height one is generated by a prime element.
Hence a prime containing two relatively prime elements has height at least two, and in a
Noetherian unique factorization domain two relatively prime elements generating a proper ideal
cut out a closed subset of codimension exactly two.

## Main results

* `Ideal.lt_height_iff_eq_maximalIdeal`: in a local ring of Krull dimension `n + 1`, a prime has
  height greater than `n` iff it is the maximal ideal.
* `Ideal.exists_le_isPrime_height_eq_one`: a nonzero prime of a Noetherian domain contains a
  prime of height one.
* `Ideal.exists_isPrime_height_eq_one_of_not_isField`: a Noetherian domain which is not a field
  has a prime of height one.
* `TauCeti.isUnit_iff_forall_notMem_of_height_le_one`: units in a Noetherian ring are detected
  by primes of height at most one.
* `Ideal.two_le_height_of_isRelPrime`: in a unique factorization domain, a prime containing two
  relatively prime elements has height at least two.
* `Ideal.height_span_pair_eq_two_of_isRelPrime`: in a Noetherian unique factorization domain,
  two relatively prime elements generating a proper ideal generate an ideal of height two.
-/

public section

namespace Ideal

section IsLocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- In a local ring of Krull dimension `n + 1`, a prime has height greater than `n` iff it is the
maximal ideal. -/
theorem lt_height_iff_eq_maximalIdeal {n : ℕ} (hdim : ringKrullDim R = n + 1) {I : Ideal R}
    [I.IsPrime] : n < I.height ↔ I = IsLocalRing.maximalIdeal R := by
  have : FiniteRingKrullDim R := finiteRingKrullDim_iff_ne_bot_and_top.mpr
    ⟨by simp [hdim], by
      rw [hdim, ← WithBot.coe_top]
      exact_mod_cast ENat.natCast_ne_top (n + 1)⟩
  rw [← height_eq_ringKrullDim_iff, hdim]
  refine ⟨fun h ↦ le_antisymm (hdim ▸ height_le_ringKrullDim_of_isPrime) ?_, fun h ↦ ?_⟩
  · exact_mod_cast Order.add_one_le_of_lt h
  · have h' : I.height = (n + 1 : ℕ) := by exact_mod_cast h
    exact h' ▸ by exact_mod_cast n.lt_succ_self

end IsLocalRing

/-- A nonzero prime `p` of a Noetherian domain contains a prime of height one: any prime minimal
over `(a)`, for a nonzero `a ∈ p`. -/
theorem exists_le_isPrime_height_eq_one {R : Type*} [CommRing R] [IsDomain R]
    [IsNoetherianRing R] (p : Ideal R) [p.IsPrime] (hp : p ≠ ⊥) :
    ∃ P ≤ p, P.IsPrime ∧ P.height = 1 := by
  obtain ⟨a, hap, ha⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp
  obtain ⟨P, hP, hPp⟩ := exists_minimalPrimes_le ((span_singleton_le_iff_mem p).mpr hap)
  -- Krull's principal ideal theorem gives `ht P ≤ 1`, and `a` is a nonzerodivisor, so `ht P ≥ 1`.
  exact ⟨P, hPp, hP.1.1, le_antisymm (height_le_one_of_isPrincipal_of_mem_minimalPrimes _ P hP)
    ((one_le_height_span_singleton_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero ha)).trans (height_mono hP.1.2))⟩

/-- A Noetherian domain which is not a field has a prime of height one. -/
theorem exists_isPrime_height_eq_one_of_not_isField {R : Type*} [CommRing R] [IsDomain R]
    [IsNoetherianRing R] (hR : ¬IsField R) : ∃ p : Ideal R, p.IsPrime ∧ p.height = 1 := by
  obtain ⟨P, hP0, _⟩ := Ring.not_isField_iff_exists_prime.mp hR
  obtain ⟨p, -, hp⟩ := exists_le_isPrime_height_eq_one P hP0
  exact ⟨p, hp⟩

section UniqueFactorizationMonoid

variable {R : Type*} [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R] {x y : R}

/-- In a unique factorization domain, a prime ideal containing two relatively prime elements has
height at least two. -/
theorem two_le_height_of_isRelPrime (h : IsRelPrime x y) {p : Ideal R} [p.IsPrime] (hx : x ∈ p)
    (hy : y ∈ p) : 2 ≤ p.height := by
  -- `p` contains a prime element `q`; since `q` cannot divide both `x` and `y`, the chain
  -- `⊥ < (q) < p` of primes has length two.
  have hp : p ≠ ⊥ := by
    rintro rfl
    rw [mem_bot] at hx hy
    exact not_isRelPrime_zero_zero (hx ▸ hy ▸ h)
  obtain ⟨q, hqp, hq⟩ := IsPrime.exists_mem_prime_of_ne_bot ‹_› hp
  have : (span {q}).IsPrime := (span_singleton_prime hq.ne_zero).mpr hq
  have hlt : span {q} < p := by
    refine lt_of_le_of_ne ((span_singleton_le_iff_mem _).mpr hqp) fun he ↦ hq.not_isUnit (h ?_ ?_)
    · exact mem_span_singleton.mp (he ▸ hx)
    · exact mem_span_singleton.mp (he ▸ hy)
  have hq₀ : ⊥ < span {q} := bot_lt_iff_ne_bot.mpr (by simpa using hq.ne_zero)
  have h₁ := height_add_one_le_of_lt_of_isPrime hq₀
  have h₂ := height_add_one_le_of_lt_of_isPrime hlt
  rw [height_bot, zero_add] at h₁
  calc (2 : ℕ∞) = 1 + 1 := one_add_one_eq_two.symm
    _ ≤ (span {q}).height + 1 := by gcongr
    _ ≤ p.height := h₂

/-- In a Noetherian unique factorization domain, two relatively prime elements generating a
proper ideal generate an ideal of height two. -/
theorem height_span_pair_eq_two_of_isRelPrime [IsNoetherianRing R] (h : IsRelPrime x y)
    (hxy : span {x, y} ≠ ⊤) : (span {x, y}).height = 2 := by
  classical
  refine le_antisymm ?_ ?_
  · have := height_span_le_card_of_span_ne_top (s := {x, y}) (by simpa using hxy)
    rw [Finset.coe_pair] at this
    exact this.trans (by exact_mod_cast Finset.card_le_two)
  · rw [height_eq_inf_minimalPrimes]
    refine le_iInf₂ fun p hp ↦ ?_
    have := hp.isPrime
    exact two_le_height_of_isRelPrime h (hp.le (subset_span (by simp)))
      (hp.le (subset_span (by simp)))

end UniqueFactorizationMonoid

end Ideal

namespace TauCeti

/-- An element of a Noetherian ring is a unit if and only if it belongs to no prime of height
at most one. -/
theorem isUnit_iff_forall_notMem_of_height_le_one {R : Type*} [CommRing R]
    [IsNoetherianRing R] (x : R) :
    IsUnit x ↔ ∀ (p : Ideal R) [p.IsPrime], p.height ≤ 1 → x ∉ p := by
  refine ⟨fun hx p _ _ ↦ p.notMem_of_isUnit hx, fun h ↦ ?_⟩
  by_contra hx
  obtain ⟨p, hp⟩ := (Ideal.span {x}).nonempty_minimalPrimes (by simpa using hx)
  have := hp.isPrime
  exact h p (Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ _ hp)
    (hp.le (Ideal.subset_span (Set.mem_singleton x)))

end TauCeti
