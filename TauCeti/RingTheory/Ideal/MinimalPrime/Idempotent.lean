module

public import TauCeti.RingTheory.Ideal.MinimalPrime.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Tactic.LinearCombination

/-!
# Idempotents isolating minimal-prime components

Distinct minimal primes are coprime when every maximal localization is a domain.
In a reduced ring with finitely many pairwise coprime minimal primes, each minimal prime
is generated by the complement of an idempotent. These results supply component factors
for reducing trace duality on a smooth algebra to its domain case.

## Main results

* `Ideal.isCoprime_of_mem_minimalPrimes`: local domains force distinct components apart.
* `Ideal.exists_isIdempotentElem_span_eq`: construct the component idempotent.
-/

public section

namespace Ideal

/-- Over a ring whose localizations at maximal ideals are domains, distinct minimal primes are
coprime: a maximal ideal containing both would contain two minimal primes of a local domain. -/
theorem isCoprime_of_mem_minimalPrimes {A : Type*} [CommRing A]
    (h : ∀ (m : Ideal A) [m.IsMaximal], IsDomain (Localization.AtPrime m)) {P Q : Ideal A}
    (hP : P ∈ minimalPrimes A) (hQ : Q ∈ minimalPrimes A) (hPQ : P ≠ Q) : IsCoprime P Q := by
  rw [Ideal.isCoprime_iff_sup_eq]
  by_contra hne
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
  have := h m
  have hq := RingHom.ker_isPrime (algebraMap A (Localization.AtPrime m))
  have key (p : Ideal A) (hp : p ∈ minimalPrimes A) (hpm : p ≤ m) :
      p = RingHom.ker (algebraMap A (Localization.AtPrime m)) := by
    have hqp : RingHom.ker (algebraMap A (Localization.AtPrime m)) ≤ p := by
      intro a ha
      obtain ⟨⟨s, hs⟩, hsa⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl _ a).1 ha
      have : s * a ∈ p := by rw [hsa]; exact p.zero_mem
      exact (hp.1.1.mem_or_mem this).resolve_left fun hsp ↦ hs (hpm hsp)
    exact le_antisymm (hp.2 ⟨hq, bot_le⟩ hqp) hqp
  exact hPQ ((key P hP (le_sup_left.trans hle)).trans (key Q hQ (le_sup_right.trans hle)).symm)

/-- In a reduced ring with finitely many, pairwise coprime minimal primes, every minimal prime is
generated by `1 - e` for an idempotent `e` (Chinese remainder theorem). -/
theorem exists_isIdempotentElem_span_eq {A : Type*} [CommRing A] [IsReduced A]
    (hfin : (minimalPrimes A).Finite)
    (hcop : ∀ P ∈ minimalPrimes A, ∀ Q ∈ minimalPrimes A, P ≠ Q → IsCoprime P Q)
    {P₀ : Ideal A} (hP₀ : P₀ ∈ minimalPrimes A) :
    ∃ e : A, IsIdempotentElem e ∧ Ideal.span {1 - e} = P₀ := by
  classical
  have hzero (x : A) (hx : ∀ P ∈ minimalPrimes A, x ∈ P) : x = 0 := by
    apply Ideal.injective_pi_quotient_mk_minimalPrimes A
    ext P
    change Ideal.Quotient.mk P.1 x = Ideal.Quotient.mk P.1 0
    simpa only [map_zero] using Ideal.Quotient.eq_zero_iff_mem.mpr (hx P.1 P.2)
  obtain ⟨a, ha, b, hb, hab⟩ := Ideal.isCoprime_iff_exists.1
    (Ideal.isCoprime_biInf (s := hfin.toFinset.erase P₀) (J := _root_.id) fun P hP ↦ hcop _ hP₀ P
      (hfin.mem_toFinset.1 (Finset.mem_of_mem_erase hP)) (Finset.ne_of_mem_erase hP).symm)
  have hbP (P : Ideal A) (hP : P ∈ minimalPrimes A) (hne : P ≠ P₀) : b ∈ P := by
    simp only [Submodule.mem_iInf, _root_.id] at hb
    exact hb P (Finset.mem_erase.2 ⟨hne, hfin.mem_toFinset.2 hP⟩)
  have hmem (x : A) (hx : x ∈ P₀) : x * b = 0 := hzero _ fun P hP ↦ by
    by_cases h : P = P₀
    · exact h ▸ Ideal.mul_mem_right _ _ hx
    · exact Ideal.mul_mem_left _ _ (hbP P hP h)
  refine ⟨b, ?_, le_antisymm ?_ fun x hx ↦ ?_⟩
  · have := hmem a ha
    change b * b = b
    linear_combination (-1 : A) * this + b * hab
  · rw [Ideal.span_le, Set.singleton_subset_iff,
      show 1 - b = a by linear_combination (-1 : A) * hab]
    exact ha
  · have := hmem x hx
    exact Ideal.mem_span_singleton'.2 ⟨x, by linear_combination -this⟩

end Ideal
