module

public import Mathlib.RingTheory.Ideal.MinimalPrime.Basic
public import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Tactic.LinearCombination

/-!
# Idempotents isolating minimal-prime components

In a reduced ring with finitely many pairwise coprime minimal primes, each minimal prime
is generated by the complement of an idempotent. These results supply component factors
for reducing trace duality on a smooth algebra to its domain case.

## Main results

* `TauCeti.exists_isIdempotentElem_span_singleton_one_sub_eq`: construct the component idempotent.
-/

public section

namespace TauCeti

/-- In a reduced ring with finitely many, pairwise coprime minimal primes, every minimal prime is
generated by `1 - e` for an idempotent `e` (Chinese remainder theorem). -/
theorem exists_isIdempotentElem_span_singleton_one_sub_eq {A : Type*} [CommRing A] [IsReduced A]
    (hfin : (minimalPrimes A).Finite)
    (hcop : ∀ P ∈ minimalPrimes A, ∀ Q ∈ minimalPrimes A, P ≠ Q → IsCoprime P Q)
    {P₀ : Ideal A} (hP₀ : P₀ ∈ minimalPrimes A) :
    ∃ e : A, IsIdempotentElem e ∧ Ideal.span {1 - e} = P₀ := by
  classical
  have hzero (x : A) (hx : ∀ P ∈ minimalPrimes A, x ∈ P) : x = 0 := by
    have hx' : x ∈ sInf (minimalPrimes A) := Ideal.mem_sInf.mpr hx
    rw [minimalPrimes, Ideal.sInf_minimalPrimes, Ideal.radical_bot_of_isReduced] at hx'
    exact hx'
  obtain ⟨a, ha, b, hb, hab⟩ := Ideal.isCoprime_iff_exists.1
    (Ideal.isCoprime_biInf (s := hfin.toFinset.erase P₀) (J := _root_.id) fun P hP ↦ hcop _ hP₀ P
      (hfin.mem_toFinset.1 (Finset.mem_of_mem_erase hP)) (Finset.ne_of_mem_erase hP).symm)
  have hbP (P : Ideal A) (hP : P ∈ minimalPrimes A) (hne : P ≠ P₀) : b ∈ P := by
    simp only [Submodule.mem_iInf, _root_.id] at hb
    exact hb P (Finset.mem_erase.2 ⟨hne, hfin.mem_toFinset.2 hP⟩)
  have hmem (x : A) (hx : x ∈ P₀) : x * b = 0 := hzero _ fun P hP ↦ by
    by_cases h : P = P₀
    · exact h ▸ Ideal.mul_mem_right _ _ hx
    · exact Ideal.mul_mem_left _ _ (hbP P hP h)
  have hab' : 1 - b = a := by linear_combination (-1 : A) * hab
  refine ⟨b, ?_, le_antisymm ?_ fun x hx ↦ ?_⟩
  · have := hmem a ha
    rw [isIdempotentElem_iff]
    linear_combination (-1 : A) * this + b * hab
  · rw [Ideal.span_le, Set.singleton_subset_iff, hab']
    exact ha
  · have := hmem x hx
    exact Ideal.mem_span_singleton'.2 ⟨x, by linear_combination -this⟩

end TauCeti
