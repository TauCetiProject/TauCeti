module

public import TauCeti.Algebra.Category.ModuleCat.ExtendScalars.Quotient
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Grading
public import TauCeti.RingTheory.Ideal.AssociatedGraded.SymmetricAlgebra

/-!
# Symmetric powers of the conormal module and the pieces of the associated graded ring

Let `I` be an ideal of a commutative ring `R`. The canonical map
`Sym_{R ⧸ I}(I ⧸ I²) → gr_I R` (`Ideal.AssociatedGraded.symmetricAlgebraHom`) preserves degrees,
so in each degree `n` it restricts to a map `Symⁿ_{R ⧸ I}(I ⧸ I²) → Iⁿ ⧸ Iⁿ⁺¹`
(`Ideal.AssociatedGraded.symmetricPowerToGradedPiece`). When the canonical map is bijective, as
it is for an ideal generated by a weakly regular sequence
(`RingTheory.Sequence.IsWeaklyRegular.isSymmetricAlgebra_ofCotangent`), so is each of these
degree-`n` maps.

The piece `Iⁿ ⧸ Iⁿ⁺¹` is also the extension of scalars of the `R`-module `Iⁿ` along
`R → R ⧸ I`, which is `Iⁿ ⧸ I • Iⁿ`; this is the form in which it appears as the pullback of the
power `Iⁿ` of an ideal sheaf to its closed subscheme. Hence for an ideal generated by a weakly
regular sequence the extension of scalars of `Iⁿ` is the `n`-th symmetric power of the conormal
module (`RingTheory.Sequence.IsWeaklyRegular.extendScalarsPowEquivSymmetricPower`).

## Main declarations

* `Ideal.AssociatedGraded.symmetricPowerToGradedPiece I n`: the `R`-linear map
  `Symⁿ_{R ⧸ I}(I ⧸ I²) → Iⁿ ⧸ Iⁿ⁺¹`, the degree-`n` part of `symmetricAlgebraHom`.
* `Ideal.AssociatedGraded.symmetricPowerToGradedPiece_bijective`: it is bijective when
  `symmetricAlgebraHom` is.
* `Ideal.smul_top_eq_comap_pow_succ`: inside `Iⁿ`, the submodule `I • Iⁿ` is `Iⁿ⁺¹`.
* `RingTheory.Sequence.IsWeaklyRegular.extendScalarsPowEquivSymmetricPower`: for an ideal
  generated by a weakly regular sequence, the `R ⧸ I`-linear isomorphism between the extension
  of scalars of `Iⁿ` along `R → R ⧸ I` and `Symⁿ_{R ⧸ I}(I ⧸ I²)`.

## References

* H. Matsumura, *Commutative Ring Theory*, Theorem 16.2 (i), for the regular case.
-/

public section

open scoped DirectSum

open TauCeti.SymmetricAlgebra

universe u

namespace Ideal

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- Inside the `R`-module `Iⁿ`, the submodule `I • Iⁿ` consists of the elements of `Iⁿ⁺¹`. -/
theorem smul_top_eq_comap_pow_succ (n : ℕ) :
    (I • ⊤ : Submodule R ↥(I ^ n)) = Submodule.comap (I ^ n).subtype (I ^ (n + 1)) := by
  refine Submodule.map_injective_of_injective (I ^ n).injective_subtype ?_
  rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_subtype, Submodule.map_comap_subtype,
    smul_eq_mul, ← pow_succ', inf_eq_right.mpr (Ideal.pow_le_pow_right n.le_succ)]

namespace AssociatedGraded

/-- The degree-`n` part `Symⁿ_{R ⧸ I}(I ⧸ I²) → Iⁿ ⧸ Iⁿ⁺¹` of the canonical map
`Sym_{R ⧸ I}(I ⧸ I²) → gr_I R`, as an `R`-linear map: the image of a homogeneous element of
degree `n` followed by the projection to the summand of degree `n`. -/
noncomputable def symmetricPowerToGradedPiece (n : ℕ) :
    homogeneousSubmodule (R ⧸ I) I.Cotangent n →ₗ[R] I.GradedPiece n :=
  DirectSum.component R ℕ I.GradedPiece n ∘ₗ
    ((symmetricAlgebraHom I).toLinearMap.restrictScalars R ∘ₗ
      (homogeneousSubmodule (R ⧸ I) I.Cotangent n).subtype.restrictScalars R)

variable {I}

/-- `symmetricPowerToGradedPiece` is the degree-`n` component of `symmetricAlgebraHom`. -/
theorem symmetricPowerToGradedPiece_apply {n : ℕ} (p : homogeneousSubmodule (R ⧸ I) I.Cotangent n) :
    symmetricPowerToGradedPiece I n p = symmetricAlgebraHom I p n :=
  (rfl)

/-- A homogeneous element of degree `n` is sent by `symmetricAlgebraHom` to the degree-`n` class
`symmetricPowerToGradedPiece I n p`. -/
theorem symmetricAlgebraHom_eq_of_symmetricPowerToGradedPiece {n : ℕ}
    (p : homogeneousSubmodule (R ⧸ I) I.Cotangent n) :
    symmetricAlgebraHom I p = DirectSum.of I.GradedPiece n (symmetricPowerToGradedPiece I n p) :=
  symmetricAlgebraHom_of_mem_homogeneousSubmodule p.property

/-- **In each degree, `Symⁿ_{R ⧸ I}(I ⧸ I²) → Iⁿ ⧸ Iⁿ⁺¹` is bijective when
`Sym_{R ⧸ I}(I ⧸ I²) → gr_I R` is.** Injectivity is inherited; for surjectivity, the degree-`n`
component of a preimage of a class of degree `n` is again a preimage, because the canonical map
sends homogeneous elements of degree `k` into the summand of degree `k`. -/
theorem symmetricPowerToGradedPiece_bijective (h : Function.Bijective (symmetricAlgebraHom I))
    (n : ℕ) : Function.Bijective (symmetricPowerToGradedPiece I n) := by
  refine ⟨fun p q hpq ↦ Subtype.ext (h.1 ?_), fun q ↦ ?_⟩
  · rw [symmetricAlgebraHom_eq_of_symmetricPowerToGradedPiece,
      symmetricAlgebraHom_eq_of_symmetricPowerToGradedPiece, hpq]
  · classical
    obtain ⟨p, hp⟩ := h.2 (DirectSum.of I.GradedPiece n q)
    refine ⟨DirectSum.decompose (homogeneousSubmodule (R ⧸ I) I.Cotangent) p n, ?_⟩
    rw [symmetricPowerToGradedPiece_apply]
    have hsum :=
      congrArg (fun p ↦ DirectSum.component R ℕ I.GradedPiece n (symmetricAlgebraHom I p))
      (DirectSum.sum_support_decompose (homogeneousSubmodule (R ⧸ I) I.Cotangent) p)
    simp only [map_sum] at hsum
    rw [hp, ← DirectSum.apply_eq_component, DirectSum.of_eq_same] at hsum
    simp only [← DirectSum.apply_eq_component] at hsum
    rw [← hsum, Finset.sum_eq_single n]
    · intro k _ hk
      rw [symmetricAlgebraHom_eq_of_symmetricPowerToGradedPiece]
      exact DirectSum.of_eq_of_ne _ _ _ hk.symm
    · intro hn
      rw [DFinsupp.notMem_support_iff.mp hn]
      simp

end AssociatedGraded

end Ideal

namespace RingTheory.Sequence.IsWeaklyRegular

open Ideal Ideal.AssociatedGraded

variable {R : Type u} [CommRing R] {rs : List R} {I : Ideal R}

/-- For an ideal generated by a weakly regular sequence, the canonical map
`Sym_{R ⧸ I}(I ⧸ I²) → gr_I R` is bijective. -/
theorem symmetricAlgebraHom_bijective (h : IsWeaklyRegular R rs) (hI : ofList rs = I) :
    Function.Bijective (symmetricAlgebraHom I) := by
  have := h.isSymmetricAlgebra_ofCotangent hI
  rwa [IsSymmetricAlgebra, ← symmetricAlgebraHom_def] at this

/-- **The pieces of the associated graded ring of a regular sequence are the symmetric powers of
the conormal module.** If the weakly regular sequence `rs` generates `I`, the extension of scalars
of `Iⁿ` along `R → R ⧸ I`, which is `Iⁿ ⧸ I • Iⁿ = Iⁿ ⧸ Iⁿ⁺¹`, is `Symⁿ_{R ⧸ I}(I ⧸ I²)`, by the
inverse of the degree-`n` part of `Sym_{R ⧸ I}(I ⧸ I²) ≅ gr_I R`. -/
noncomputable def extendScalarsPowEquivSymmetricPower (h : IsWeaklyRegular R rs)
    (hI : ofList rs = I) (n : ℕ) :
    (ModuleCat.extendScalars (Ideal.Quotient.mk I)).obj (ModuleCat.of R ↥(I ^ n)) ≃ₗ[R ⧸ I]
      homogeneousSubmodule (R ⧸ I) I.Cotangent n :=
  extendScalarsMkEquivQuotSMul I ↥(I ^ n) ≪≫ₗ
    (Submodule.quotEquivOfEq _ _ (smul_top_eq_comap_pow_succ I n) ≪≫ₗ
      (LinearEquiv.ofBijective _ (symmetricPowerToGradedPiece_bijective
        (symmetricAlgebraHom_bijective h hI) n)).symm).extendScalarsOfSurjective
      Ideal.Quotient.mk_surjective

end RingTheory.Sequence.IsWeaklyRegular
