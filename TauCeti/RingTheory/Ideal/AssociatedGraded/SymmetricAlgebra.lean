/-!
# The associated graded ring as a quotient of the symmetric algebra of the conormal module

Let `I` be an ideal of a commutative ring `R`. The conormal module `I ⧸ I²` is the degree-one
piece of the associated graded ring `gr_I R = ⨁ n, Iⁿ ⧸ Iⁿ⁺¹`, and `gr_I R` is generated by it
over its degree-zero piece `R ⧸ I`. Hence the universal property of the symmetric algebra gives a
canonical surjective, degree-preserving map of graded `R ⧸ I`-algebras
`Sym_{R ⧸ I}(I ⧸ I²) → gr_I R`, sending the product of the classes of `x₁, …, xₙ ∈ I` to the
class of `x₁ ⋯ xₙ` in degree `n`.

Geometrically, for the closed immersion `X = Spec (R ⧸ I) → Y = Spec R`, the relative spectrum
of `gr_I R` is the normal cone `C_{X/Y}` and that of `Sym(I ⧸ I²)` is the normal sheaf
`N_{X/Y}`, so this surjection is the closed embedding of cones `C_{X/Y} → N_{X/Y}` over `X`.
For an ideal generated by a weakly regular sequence it is an isomorphism, so the normal cone is
the normal bundle. In general it is not injective: for the origin in the dual numbers `K[ε]` the
square of the class of `ε` is a nonzero element of the kernel, so the normal cone is a proper
closed subcone of the normal sheaf `Spec K[t]`.

## Main definitions

* `Ideal.AssociatedGraded.ofCotangent I`: the `R ⧸ I`-linear inclusion of `I ⧸ I²` into `gr_I R`
  as its degree-one piece.
* `Ideal.AssociatedGraded.symmetricAlgebraHom I`: the canonical map
  `Sym_{R ⧸ I}(I ⧸ I²) →ₐ[R ⧸ I] gr_I R`.

## Main results

* `Ideal.AssociatedGraded.symmetricAlgebraHom_surjective`: the map is surjective.
* `Ideal.AssociatedGraded.symmetricAlgebraHom_of_mem_homogeneousSubmodule`: it sends the
  degree-`n` part of the symmetric algebra into the degree-`n` piece `Iⁿ ⧸ Iⁿ⁺¹`.
* `Ideal.AssociatedGraded.symmetricAlgebraHom_prod_eq_zero_iff`: the product of the classes of
  `x₁, …, xₙ ∈ I` lies in the kernel exactly when `x₁ ⋯ xₙ ∈ Iⁿ⁺¹`.
* `Ideal.AssociatedGraded.not_injective_symmetricAlgebraHom`: if `Sym_{R ⧸ I}(I ⧸ I²)` has no
  zero divisors, two elements of `I ∖ I²` whose product lies in `I³` witness a nonzero kernel.
* `RingTheory.Sequence.IsWeaklyRegular.isSymmetricAlgebra_ofCotangent`: for an ideal generated
  by a weakly regular sequence, `gr_I R` is the symmetric algebra of `I ⧸ I²` over `R ⧸ I`, so the
  map is an isomorphism.
* `DualNumber.not_injective_symmetricAlgebraHom_span_eps`: for the ideal `(ε)` of `K[ε]`, the
  map is not injective.

## References

* K. Behrend and B. Fantechi, *The intrinsic normal cone*, Invent. Math. 128 (1997), §1, for the
  normal cone and normal sheaf of a closed immersion and the closed embedding between them.
* H. Matsumura, *Commutative Ring Theory*, Theorem 16.2 (i), for the regular case.
* The Stacks project, Section 10.69 (quasi-regular sequences).
-/

public section

open scoped DirectSum

open TauCeti.SymmetricAlgebra

namespace Ideal

namespace AssociatedGraded

variable {R : Type*} [CommRing R]

section Cotangent

variable (I : Ideal R)

/-- The conormal module `I ⧸ I²` included into the associated graded ring `gr_I R` as its
degree-one piece `I¹ ⧸ I²`; it is linear over the degree-zero piece `R ⧸ I`. -/
noncomputable def ofCotangent : I.Cotangent →ₗ[R ⧸ I] I.AssociatedGraded :=
  LinearMap.extendScalarsOfSurjective Ideal.Quotient.mk_surjective <|
    Cotangent.lift (M := I.AssociatedGraded) (mk I 1 ∘ₗ Submodule.inclusion (pow_one I).ge)
      fun x y ↦ by
        rw [LinearMap.comp_apply, mk_eq_zero_iff, Submodule.coe_inclusion]
        exact (pow_two I).symm ▸ mul_mem_mul x.property y.property

variable {I}

/-- `ofCotangent` sends the class of `x ∈ I` to the degree-one class of `x`. -/
@[simp]
theorem ofCotangent_toCotangent (x : I) :
    ofCotangent I (I.toCotangent x) = mk I 1 ⟨x, by rw [pow_one]; exact x.property⟩ := by
  rw [ofCotangent, LinearMap.extendScalarsOfSurjective_apply, Cotangent.lift_toCotangent,
    LinearMap.comp_apply, Submodule.inclusion_apply]

/-- The inclusion of the conormal module `I ⧸ I²` into `gr_I R` is injective. -/
theorem ofCotangent_injective : Function.Injective (ofCotangent I) := by
  rw [injective_iff_map_eq_zero]
  intro c hc
  obtain ⟨x, rfl⟩ := I.toCotangent_surjective c
  rw [ofCotangent_toCotangent, mk_eq_zero_iff] at hc
  exact (I.toCotangent_eq_zero x).mpr hc

end Cotangent

section SymmetricAlgebra

variable (I : Ideal R)

/-- The canonical map `Sym_{R ⧸ I}(I ⧸ I²) → gr_I R` of `R ⧸ I`-algebras extending the inclusion
of the conormal module as the degree-one piece. On spectra over `Spec (R ⧸ I)` it is the closed
embedding of the normal cone of `Spec (R ⧸ I) → Spec R` into its normal sheaf. -/
noncomputable def symmetricAlgebraHom :
    SymmetricAlgebra (R ⧸ I) I.Cotangent →ₐ[R ⧸ I] I.AssociatedGraded :=
  SymmetricAlgebra.lift (R := R ⧸ I) (A := I.AssociatedGraded) (ofCotangent I)

variable {I}

/-- `symmetricAlgebraHom` is the lift of `ofCotangent` along the universal property of the
symmetric algebra. -/
theorem symmetricAlgebraHom_def :
    symmetricAlgebraHom I = SymmetricAlgebra.lift (R := R ⧸ I) (A := I.AssociatedGraded)
      (ofCotangent I) :=
  (rfl)

/-- `symmetricAlgebraHom` restricts to `ofCotangent` on the generators. -/
@[simp]
theorem symmetricAlgebraHom_ι (c : I.Cotangent) :
    symmetricAlgebraHom I (SymmetricAlgebra.ι (R ⧸ I) I.Cotangent c) = ofCotangent I c :=
  SymmetricAlgebra.lift_ι_apply _ c

/-- `symmetricAlgebraHom` sends the product of the classes of `x₁, …, xₙ ∈ I` in `I ⧸ I²` to the
class of `x₁ ⋯ xₙ` in degree `n`. -/
theorem symmetricAlgebraHom_prod (l : List I) :
    symmetricAlgebraHom I
        (l.map fun x ↦ SymmetricAlgebra.ι (R ⧸ I) I.Cotangent (I.toCotangent x)).prod =
      mk I l.length ⟨(l.map ((↑) : I → R)).prod, by
        simpa using TauCeti.Algebra.prod_map_mem_range_pow (Submodule.subtype I) l⟩ := by
  induction l with
  | nil => simp
  | cons x l ih =>
    simp only [List.map_cons, List.prod_cons, map_mul, symmetricAlgebraHom_ι,
      ofCotangent_toCotangent, ih, mk_mul_mk, List.length_cons]
    rw [mk_congr (Nat.add_comm 1 l.length)]

/-- The product of the classes of `x₁, …, xₙ ∈ I` in `I ⧸ I²` lies in the kernel of
`symmetricAlgebraHom` exactly when `x₁ ⋯ xₙ ∈ Iⁿ⁺¹`. -/
theorem symmetricAlgebraHom_prod_eq_zero_iff (l : List I) :
    symmetricAlgebraHom I
        (l.map fun x ↦ SymmetricAlgebra.ι (R ⧸ I) I.Cotangent (I.toCotangent x)).prod = 0 ↔
      (l.map ((↑) : I → R)).prod ∈ I ^ (l.length + 1) := by
  rw [symmetricAlgebraHom_prod, mk_eq_zero_iff]

/-- `symmetricAlgebraHom` is degree-preserving: it sends the degree-`n` part of the symmetric
algebra into the summand `Iⁿ ⧸ Iⁿ⁺¹` of `gr_I R`. -/
theorem symmetricAlgebraHom_of_mem_homogeneousSubmodule {n : ℕ}
    {p : SymmetricAlgebra (R ⧸ I) I.Cotangent}
    (hp : p ∈ homogeneousSubmodule (R ⧸ I) I.Cotangent n) :
    symmetricAlgebraHom I p = DirectSum.of I.GradedPiece n (symmetricAlgebraHom I p n) := by
  rw [symmetricAlgebraHom_def]
  refine SymmetricAlgebra.lift_apply_of_mem_homogeneousSubmodule (R ⧸ I) I.GradedPiece
    (fun r ↦ ?_) _ (fun c ↦ ?_) hp
  · obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [algebraMap_quotient_mk, DirectSum.algebraMap_apply, DirectSum.of_eq_same]
  · obtain ⟨y, rfl⟩ := I.toCotangent_surjective c
    rw [ofCotangent_toCotangent, mk_apply, DirectSum.of_eq_same]

/-- **`gr_I R` is generated in degree one.** The map `Sym_{R ⧸ I}(I ⧸ I²) → gr_I R` is
surjective; geometrically, the normal cone is a closed subcone of the normal sheaf. -/
theorem symmetricAlgebraHom_surjective : Function.Surjective (symmetricAlgebraHom I) := by
  have hI : I ≤ span (Set.range ((↑) : I → R)) := by
    rw [Subtype.range_coe, span_eq]
  have hcomp : (symmetricAlgebraHom I).comp
      (MvPolynomial.aeval fun x : I ↦ SymmetricAlgebra.ι (R ⧸ I) I.Cotangent (I.toCotangent x)) =
        mvPolynomialHom I (a := ((↑) : I → R)) fun x ↦ x.property :=
    MvPolynomial.algHom_ext fun x ↦ by simp
  have hsurj := mvPolynomialHom_surjective (a := ((↑) : I → R)) (fun x ↦ x.property) hI
  rw [← hcomp, AlgHom.coe_comp] at hsurj
  exact hsurj.of_comp

/-- **The normal cone can be a proper subcone of the normal sheaf.** Suppose that
`Sym_{R ⧸ I}(I ⧸ I²)` has no zero divisors, for instance when `R ⧸ I` has none and the conormal
module `I ⧸ I²` is free over it, as when `I` is maximal. If `x, y ∈ I` do not lie in `I²` but
`x * y ∈ I³`, then the product of their classes in `I ⧸ I²` is a nonzero element of the kernel of
`Sym_{R ⧸ I}(I ⧸ I²) → gr_I R`. -/
theorem not_injective_symmetricAlgebraHom
    [NoZeroDivisors (SymmetricAlgebra (R ⧸ I) I.Cotangent)] {x y : R} (hx : x ∈ I) (hy : y ∈ I)
    (hx₂ : x ∉ I ^ 2) (hy₂ : y ∉ I ^ 2) (hxy : x * y ∈ I ^ 3) :
    ¬ Function.Injective (symmetricAlgebraHom I) := by
  have hne (z : I) (hz : (z : R) ∉ I ^ 2) :
      SymmetricAlgebra.ι (R ⧸ I) I.Cotangent (I.toCotangent z) ≠ 0 := by
    rw [ne_eq, ← map_zero (SymmetricAlgebra.ι (R ⧸ I) I.Cotangent),
      (SymmetricAlgebra.ι_injective _ _).eq_iff, toCotangent_eq_zero]
    exact hz
  intro hinj
  refine mul_ne_zero (hne ⟨x, hx⟩ hx₂) (hne ⟨y, hy⟩ hy₂) (hinj ?_)
  have h :=
    (symmetricAlgebraHom_prod_eq_zero_iff [⟨x, hx⟩, ⟨y, hy⟩]).mpr (by simpa using hxy)
  simpa only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, map_zero]
    using h

end SymmetricAlgebra

end AssociatedGraded

end Ideal

namespace RingTheory.Sequence.IsWeaklyRegular

open Ideal Ideal.AssociatedGraded

variable {R : Type*} [CommRing R]

/-- **The normal cone of a regular sequence is the normal bundle.** If the weakly regular
sequence `rs` generates `I`, then `ofCotangent I` exhibits `gr_I R` as the symmetric algebra of
`I ⧸ I²` over `R ⧸ I`: the map `Sym_{R ⧸ I}(I ⧸ I²) → gr_I R` is bijective, and
`IsSymmetricAlgebra.equiv` is the resulting isomorphism `Sym_{R ⧸ I}(I ⧸ I²) ≃ₐ[R ⧸ I] gr_I R`. -/
theorem isSymmetricAlgebra_ofCotangent {rs : List R} (h : IsWeaklyRegular R rs) {I : Ideal R}
    (hI : ofList rs = I) :
    IsSymmetricAlgebra (R := R ⧸ I) (A := I.AssociatedGraded) (ofCotangent I) := by
  subst hI
  -- Through the basis of `I ⧸ I²` given by `rs`, the map is the polynomial comparison.
  exact .of_equiv
    ((SymmetricAlgebra.equivMvPolynomial h.cotangentBasis).trans (h.associatedGradedEquiv rfl))
    (h.cotangentBasis.ext fun i ↦ by
      rw [LinearMap.comp_apply, AlgEquiv.toLinearMap_apply, AlgEquiv.trans_apply,
        SymmetricAlgebra.equivMvPolynomial_ι_apply]
      simp)

end RingTheory.Sequence.IsWeaklyRegular

namespace DualNumber

open Ideal Ideal.AssociatedGraded

/-- For the origin in the dual numbers, the normal cone is a proper closed subcone of the normal
sheaf `Spec K[t]`: the map `Sym_K((ε) ⧸ (ε)²) → gr_{(ε)} K[ε]` kills the square of the class of
`ε`, which is nonzero. -/
theorem not_injective_symmetricAlgebraHom_span_eps (K : Type*) [Field K] :
    ¬ Function.Injective (symmetricAlgebraHom (span {ε} : Ideal K[ε])) := by
  have : (span {ε} : Ideal K[ε]).IsMaximal := isMaximal_span_singleton_eps
  let := Ideal.Quotient.field (span {ε} : Ideal K[ε])
  have hε : (ε : K[ε]) ∈ span {ε} := subset_span rfl
  have hε₂ : (ε : K[ε]) ∉ span {ε} ^ 2 := by
    rw [span_singleton_pow, eps_pow_two, span_singleton_eq_bot.mpr rfl, mem_bot]
    intro h
    simpa using congrArg TrivSqZeroExt.snd h
  exact not_injective_symmetricAlgebraHom hε hε hε₂ hε₂ (by simp [eps_mul_eps])

end DualNumber
