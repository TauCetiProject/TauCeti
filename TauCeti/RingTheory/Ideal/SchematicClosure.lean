module

public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.Localization.BaseChange
public import Mathlib.RingTheory.TensorProduct.Quotient
public import TauCeti.RingTheory.Ideal.ScalarTorsion

/-!
# Schematic closure of a closed subscheme of the generic fibre

Let `O` be a ring, `K` an `O`-algebra, `A` an `O`-algebra and `I` an ideal of `K ⊗[O] A`. Its
*closure ideal* `I^♮ = A ∩ I` is the preimage of `I` under `a ↦ 1 ⊗ a`, and `A ⧸ I^♮` is the
coordinate ring of the schematic closure in `Spec A` of the closed subscheme `V(I)` of the
generic fibre `Spec (K ⊗[O] A)`.

When `K` is a localization of `O`, every element of `K ⊗[O] A` has a multiple of the form
`1 ⊗ a`, so `I^♮` generates `I` and the generic fibre of `A ⧸ I^♮` is `(K ⊗[O] A) ⧸ I`. When `K`
is the fraction field, `A ⧸ I^♮` is torsion-free over `O`, hence flat over a Dedekind domain
(for instance a discrete valuation ring), and it is the unique torsion-free quotient of `A` with
generic fibre `(K ⊗[O] A) ⧸ I`. Its points with values in a torsion-free `O`-algebra `O'` are
the points of `Spec A` whose generic fibre lies in `V(I)`.

## Main definitions

* `TauCeti.SchematicClosure.closureIdeal`: the ideal `I^♮ = A ∩ I`.
* `TauCeti.SchematicClosure.closure`: the coordinate ring `A ⧸ I^♮` of the closure.
* `TauCeti.SchematicClosure.closureGenericFibre`: over a localization `K` of `O`, the
  isomorphism `K ⊗[O] (A ⧸ I^♮) ≃ₐ[K] (K ⊗[O] A) ⧸ I`.

## Main results

* `TauCeti.SchematicClosure.map_closureIdeal`: over a localization, `I^♮` generates `I`.
* `TauCeti.SchematicClosure.closure_flat`: over a Dedekind domain, `A ⧸ I^♮` is flat.
* `TauCeti.SchematicClosure.closure_unique`: a torsion-free quotient `A ⧸ J` with `K ⊗ J = I`
  has `J = I^♮`.
* `TauCeti.SchematicClosure.mem_closure_points`: a point with values in a torsion-free algebra
  kills `I^♮` iff its base change kills `I`.
* `TauCeti.SchematicClosure.closureIdeal_bot_eq_torsion`: the closure of the zero ideal is the
  scalar-torsion ideal of `A`.

## References

* F. Bruhat and J. Tits, *Groupes réductifs sur un corps local II*, Publ. Math. IHÉS 60
  (1984), 1.2.5–1.2.7.
* M. Kisin and G. Pappas, *Integral models of Shimura varieties with parahoric level
  structure*, Publ. Math. IHÉS 128 (2018), proof of Prop. 1.3.3.
-/

public section

open scoped TensorProduct nonZeroDivisors

namespace TauCeti.SchematicClosure

universe u v w x

open Algebra.TensorProduct

section Defs

variable {O : Type u} (K : Type v) {A : Type w}
variable [CommRing O] [CommRing K] [CommRing A] [Algebra O K] [Algebra O A]

/-- The closure ideal `I^♮ = A ∩ I` of an ideal `I` of the generic fibre `K ⊗[O] A`: the
preimage of `I` under `a ↦ 1 ⊗ a`. -/
def closureIdeal (I : Ideal (K ⊗[O] A)) : Ideal A :=
  I.comap (includeRight : A →ₐ[O] K ⊗[O] A)

/-- The closure ideal is the preimage of `I` under `a ↦ 1 ⊗ a`. -/
theorem closureIdeal_def (I : Ideal (K ⊗[O] A)) :
    closureIdeal K I = I.comap (includeRight : A →ₐ[O] K ⊗[O] A) :=
  (rfl)

variable {K} in
/-- Membership in the closure ideal: `a ∈ I^♮` iff `1 ⊗ a ∈ I`. -/
@[simp]
theorem mem_closureIdeal {I : Ideal (K ⊗[O] A)} {a : A} :
    a ∈ closureIdeal K I ↔ (1 : K) ⊗ₜ[O] a ∈ I :=
  Iff.rfl

/-- The coordinate ring `A ⧸ I^♮` of the schematic closure of `V(I)` in `Spec A`. -/
abbrev closure (I : Ideal (K ⊗[O] A)) : Type w :=
  A ⧸ closureIdeal K I

variable {K}

/-- Taking closures is monotone. -/
theorem closureIdeal_mono {I J : Ideal (K ⊗[O] A)} (h : I ≤ J) :
    closureIdeal K I ≤ closureIdeal K J :=
  Ideal.comap_mono h

/-- The ideal generated by `I^♮` in the generic fibre lies in `I`. -/
theorem map_closureIdeal_le (I : Ideal (K ⊗[O] A)) :
    (closureIdeal K I).map (includeRight : A →ₐ[O] K ⊗[O] A) ≤ I :=
  Ideal.map_comap_le

end Defs

section Localization

variable {O : Type u} {K : Type v} {A : Type w}
variable [CommRing O] [CommRing K] [CommRing A] [Algebra O K] [Algebra O A]
variable (M : Submonoid O) [IsLocalization M K]

include M in
/-- Over a localization `K` of `O`, a `K`-submodule containing `s • z` for some `s` in the
submonoid contains `z`. -/
private theorem mem_of_smul_mem {N : Type x} [AddCommGroup N] [Module K N] [Module O N]
    [IsScalarTower O K N] (p : Submodule K N) (s : M) {z : N} (hz : (s : O) • z ∈ p) :
    z ∈ p := by
  obtain ⟨u, hu⟩ := IsLocalization.map_units K s
  have hz' : z = ((u⁻¹ : Kˣ) : K) • ((s : O) • z) := by
    rw [← algebraMap_smul K (s : O) z, ← hu, smul_smul, Units.inv_mul, one_smul]
  rw [hz']
  exact p.smul_mem _ hz

/-- Over a localization `K` of `O`, every element of `K ⊗[O] A` has a multiple by an element of
the submonoid of the form `1 ⊗ a`. -/
theorem exists_smul_eq_one_tmul (y : K ⊗[O] A) :
    ∃ s : M, ∃ a : A, (s : O) • y = (1 : K) ⊗ₜ[O] a := by
  obtain ⟨⟨a, s⟩, h⟩ := IsLocalizedModule.surj M (TensorProduct.mk O K A 1) y
  exact ⟨s, a, h⟩

include M in
/-- Over a localization `K` of `O`, the closure ideal `I^♮` generates `I`. -/
theorem map_closureIdeal (I : Ideal (K ⊗[O] A)) :
    (closureIdeal K I).map (includeRight : A →ₐ[O] K ⊗[O] A) = I := by
  refine le_antisymm (map_closureIdeal_le I) fun y hy ↦ ?_
  obtain ⟨s, a, h⟩ := exists_smul_eq_one_tmul M y
  have ha : a ∈ closureIdeal K I := by
    rw [mem_closureIdeal, ← h]
    exact Submodule.smul_of_tower_mem I (s : O) hy
  refine (Submodule.restrictScalars_mem K _ y).mp (mem_of_smul_mem M _ s ?_)
  rw [Submodule.restrictScalars_mem, h]
  exact Ideal.mem_map_of_mem _ ha

variable (K) in
/-- Over a localization `K` of `O`, the generic fibre of the closure `A ⧸ I^♮` is
`(K ⊗[O] A) ⧸ I`: `k ⊗ (a mod I^♮) ↦ (k ⊗ a) mod I`. -/
noncomputable def closureGenericFibre (I : Ideal (K ⊗[O] A)) :
    K ⊗[O] closure K I ≃ₐ[K] (K ⊗[O] A) ⧸ I :=
  (tensorQuotientEquiv K A K (closureIdeal K I)).trans
    (Ideal.quotientEquivAlgOfEq K (map_closureIdeal M I))

variable (K) in
@[simp]
theorem closureGenericFibre_tmul (I : Ideal (K ⊗[O] A)) (k : K) (a : A) :
    closureGenericFibre K M I (k ⊗ₜ Ideal.Quotient.mk _ a) = Ideal.Quotient.mk I (k ⊗ₜ a) := by
  simp [closureGenericFibre]

include M in
/-- The generic fibre of the closure `A ⧸ I^♮` is `(K ⊗[O] A) ⧸ I`, by an isomorphism sending
`k ⊗ (a mod I^♮)` to `(k ⊗ a) mod I`. -/
theorem exists_closure_genericFibre (I : Ideal (K ⊗[O] A)) :
    ∃ e : K ⊗[O] closure K I ≃ₐ[K] (K ⊗[O] A) ⧸ I,
      ∀ (k : K) (a : A), e (k ⊗ₜ Ideal.Quotient.mk _ a) = Ideal.Quotient.mk I (k ⊗ₜ a) :=
  ⟨closureGenericFibre K M I, closureGenericFibre_tmul K M I⟩

end Localization

section FractionRing

variable {O : Type u} {K : Type v} {A : Type w}
variable [CommRing O] [CommRing K] [CommRing A] [Algebra O K] [Algebra O A]
variable [IsFractionRing O K]

/-- Over the fraction field, if `N` is torsion-free over `O` then `n ↦ 1 ⊗ n` is injective. -/
theorem eq_zero_of_one_tmul_eq_zero {N : Type x} [AddCommGroup N] [Module O N]
    [Module.IsTorsionFree O N] {n : N} (h : (1 : K) ⊗ₜ[O] n = 0) : n = 0 := by
  obtain ⟨s, hs⟩ := (IsLocalizedModule.eq_zero_iff O⁰ (TensorProduct.mk O K N 1)).mp h
  exact Module.IsTorsionFree.isSMulRegular (isRegular_iff_mem_nonZeroDivisors.mpr s.property)
    (show (s : O) • n = (s : O) • 0 by rw [smul_zero]; exact hs)

/-- The closure `A ⧸ I^♮` is torsion-free over `O`. -/
instance isTorsionFree_closure (I : Ideal (K ⊗[O] A)) :
    Module.IsTorsionFree O (closure K I) := by
  refine ⟨fun s hs x y hxy ↦ ?_⟩
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  simp only at hxy
  rw [← sub_eq_zero, ← smul_sub, ← map_sub, ← Ideal.Quotient.mk_eq_mk,
    ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hxy
  rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, mem_closureIdeal]
  refine mem_of_smul_mem O⁰ (I.restrictScalars K) ⟨s, hs.mem_nonZeroDivisors⟩ ?_
  rw [Submodule.restrictScalars_mem, ← TensorProduct.tmul_smul]
  exact hxy

/-- Over a Dedekind domain, for instance a discrete valuation ring, the closure `A ⧸ I^♮` is
flat over `O`. -/
theorem closure_flat [IsDedekindDomain O] (I : Ideal (K ⊗[O] A)) :
    Module.Flat O (closure K I) :=
  inferInstance

/-- **Uniqueness of the closure.** If `A ⧸ J` is torsion-free over `O` (for instance flat) and
`J` generates `I` in the generic fibre, then `J = I^♮`. -/
theorem closure_unique {I : Ideal (K ⊗[O] A)} {J : Ideal A}
    [Module.IsTorsionFree O (A ⧸ J)]
    (hJ : J.map (includeRight : A →ₐ[O] K ⊗[O] A) = I) : J = closureIdeal K I := by
  refine le_antisymm (hJ ▸ Ideal.le_comap_map) fun a ha ↦ ?_
  rw [mem_closureIdeal, ← hJ] at ha
  have h : (1 : K) ⊗ₜ[O] (Ideal.Quotient.mk J a) = 0 := by
    have := congrArg (tensorQuotientEquiv (R := O) K A K J).symm
      ((Ideal.Quotient.eq_zero_iff_mem).mpr ha)
    simpa using this
  exact Ideal.Quotient.eq_zero_iff_mem.mp (eq_zero_of_one_tmul_eq_zero h)

/-- **Points of the closure.** A point `f` of `Spec A` with values in an `O`-algebra `O'`
that is torsion-free over `O` kills `I^♮` iff its base change `K ⊗ f` kills `I`. -/
theorem mem_closure_points {O' : Type x} [CommRing O'] [Algebra O O']
    [Module.IsTorsionFree O O'] (I : Ideal (K ⊗[O] A)) (f : A →ₐ[O] O') :
    closureIdeal K I ≤ RingHom.ker f ↔
      I ≤ RingHom.ker (Algebra.TensorProduct.map (AlgHom.id K K) f) := by
  constructor
  · intro h y hy
    obtain ⟨s, a, hs⟩ := exists_smul_eq_one_tmul O⁰ y
    have ha : a ∈ closureIdeal K I := by
      rw [mem_closureIdeal, ← hs]
      exact Submodule.smul_of_tower_mem I (s : O) hy
    have hfa : f a = 0 := h ha
    rw [RingHom.mem_ker]
    refine (Submodule.mem_bot K).mp (mem_of_smul_mem O⁰ ⊥ s ?_)
    rw [Submodule.mem_bot, ← algebraMap_smul K, ← map_smul, algebraMap_smul, hs]
    simp [hfa]
  · intro h a ha
    exact eq_zero_of_one_tmul_eq_zero (K := K) (by simpa using h ha)

/-- Over the fraction field, the closure of the zero ideal is zero when `A` is torsion-free:
`Spec A` is the closure of its generic fibre. -/
@[simp]
theorem closureIdeal_bot [Module.IsTorsionFree O A] :
    closureIdeal K (⊥ : Ideal (K ⊗[O] A)) = ⊥ :=
  eq_bot_iff.mpr fun _ ha ↦ eq_zero_of_one_tmul_eq_zero ha

/-- **The closure of the zero ideal is the scalar torsion.** Over the fraction field, without
flatness, `I^♮` for `I = 0` is the scalar-torsion ideal of `A`. -/
theorem closureIdeal_bot_eq_scalarTorsionIdeal :
    closureIdeal K (⊥ : Ideal (K ⊗[O] A)) = scalarTorsionIdeal O A := by
  ext a
  rw [mem_closureIdeal, Ideal.mem_bot, mem_scalarTorsionIdeal]
  exact IsLocalizedModule.eq_zero_iff O⁰ (TensorProduct.mk O K A 1)

end FractionRing

end TauCeti.SchematicClosure
