module

public import Mathlib.RingTheory.Ideal.Span

/-!
# Principal ideals generated by integer casts

An integer `a : ℤ` and its nonnegative absolute value `a.natAbs : ℕ` differ at most by a sign, so
their casts into any ring `R` generate the same principal ideal.

## Main results

* `Ideal.span_intCast_eq_span_natAbs`: `Ideal.span {(a : R)} = Ideal.span {(a.natAbs : R)}` in any
  ring `R`, extending `Int.span_natAbs` from `ℤ` to arbitrary target rings.
-/

public section

namespace Ideal

/-- An integer cast and its `natAbs` generate the same principal ideal in any ring. -/
-- Not a `simp` lemma: parallel to `Int.span_natAbs`, rewriting `span {(a : R)}` would take
-- integer-cast normal-form lemmas (such as `Ideal.powerResidueSymbolIdeal_intCast_four`) out of
-- `simp` normal form.
theorem span_intCast_eq_span_natAbs {R : Type*} [Ring R] (a : ℤ) :
    span {(a : R)} = span {(a.natAbs : R)} := by
  obtain ⟨n, rfl | rfl⟩ := a.eq_nat_or_neg <;> simp

end Ideal
