module

public import TauCeti.RingTheory.Ideal.Extended
-- Private: the integrality of a nilpotent element and the module structure over a quotient ring
-- carried by a torsion module are used only inside proofs.
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
import Mathlib.Algebra.Module.Torsion.Basic

/-!
# Finite quotients by powers of an ideal spanned by algebra generators

Let `R` be a commutative `A`-algebra generated by a finite set `s`, and let `J = Ideal.span s` be
the ideal that the *same* set spans.  Then the quotient `R ⧸ J ^ n` is a finite `A`-module for
every `n`: the images of `s` generate it as an `A`-algebra and each of them is nilpotent, hence
integral over `A`, so the algebra they generate is a finite module
(`Algebra.finite_adjoin_of_finite_of_isIntegral`).

The point of the file is to carry that finiteness across to a *noncommutative* algebra.  If `B` is
an `R`-algebra which is finite as an `R`-module, and `J` is a two-sided ideal of `B` swallowing the
extension of an ideal `I` of `R` — for instance the two-sided ideal generated by the image of `s` —
then `B ⧸ J` is annihilated by `I`, hence a module over `R ⧸ I`, and module-finiteness composes:

`Module.Finite A (R ⧸ I) → Module.Finite A (B ⧸ J)`.

Combining the two gives `Ideal.finite_quotient_pow_of_algebraMap_mem`: a two-sided ideal of `B`
containing the image of a finite generating set of `R` has finite-module quotients by all of its
powers.  The motivating application is a universal enveloping algebra `U(L)` over a commutative
subalgebra `R` generated by finitely many central elements of the augmentation ideal: the quotient
of `U(L)` by any power of the two-sided ideal those elements generate is finite dimensional over
the base field.

## Main results

* `Ideal.finite_quotient_span_pow_of_adjoin_eq_top`: `R ⧸ Ideal.span s ^ n` is a finite `A`-module
  when the finite set `s` generates `R` as an `A`-algebra.
* `Ideal.finite_quotient_of_map_algebraMap_le`: finiteness of `R ⧸ I` transfers to `B ⧸ J` for a
  two-sided ideal `J` of `B` containing the extension of `I`.
* `Ideal.finite_quotient_pow_of_algebraMap_mem`: the combination of the two, for the powers of a
  two-sided ideal containing the image of a finite generating set.
-/

public section

namespace Ideal

section Commutative

variable {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]

/-- **A quotient by a power of the ideal spanned by a finite set of algebra generators is a finite
module.**  The images of the generators are nilpotent in `R ⧸ Ideal.span s ^ n`, hence integral
over `A`, and they generate the quotient as an `A`-algebra. -/
theorem finite_quotient_span_pow_of_adjoin_eq_top {s : Set R} (hs : s.Finite)
    (htop : Algebra.adjoin A s = ⊤) (n : ℕ) :
    Module.Finite A (R ⧸ Ideal.span s ^ n) := by
  set q : R →ₐ[A] R ⧸ Ideal.span s ^ n := Ideal.Quotient.mkₐ A _ with hq
  have hgen : Algebra.adjoin A (q '' s) = ⊤ := by
    rw [Algebra.adjoin_image, htop, Algebra.map_top, AlgHom.range_eq_top]
    exact Ideal.Quotient.mk_surjective
  have hint : ∀ y ∈ q '' s, IsIntegral A y := by
    rintro - ⟨x, hx, rfl⟩
    refine ⟨Polynomial.X ^ n, Polynomial.monic_X_pow n, ?_⟩
    rw [Polynomial.eval₂_X_pow, hq, ← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow (Ideal.subset_span hx) n)
  have hfin : Module.Finite A (Algebra.adjoin A (q '' s)) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral (hs.image _) hint
  rw [hgen] at hfin
  exact Module.Finite.equiv (Subalgebra.topEquiv (R := A)).toLinearEquiv

end Commutative

section Noncommutative

variable {A R B : Type*} [CommRing A] [CommRing R] [Ring B] [Algebra A R] [Algebra A B]
  [Algebra R B] [IsScalarTower A R B]

/-- **Module-finiteness of a quotient passes from the commutative base to a module-finite
algebra.**  If `B` is finite over the commutative ring `R` of central scalars and the two-sided
ideal `J` of `B` contains the extension of `I`, then `B ⧸ J` is annihilated by `I`, so it is a
module over `R ⧸ I` and inherits its finiteness over `A`. -/
theorem finite_quotient_of_map_algebraMap_le [Module.Finite R B] {I : Ideal R} {J : Ideal B}
    [J.IsTwoSided] (hIJ : I.map (algebraMap R B) ≤ J) (h : Module.Finite A (R ⧸ I)) :
    Module.Finite A (B ⧸ J) := by
  have : Module.Finite R (B ⧸ J) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ R J).toLinearMap Ideal.Quotient.mk_surjective
  have htor : Module.IsTorsionBySet R (B ⧸ J) (I : Set R) := by
    rw [Module.isTorsionBySet_iff_subset_annihilator]
    intro r hr
    rw [SetLike.mem_coe, Module.mem_annihilator]
    intro x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hsmul : r • (Ideal.Quotient.mk J b) = Ideal.Quotient.mk J (r • b) :=
      (Ideal.Quotient.mkₐ R J).toLinearMap.map_smul r b
    rw [hsmul, Ideal.Quotient.eq_zero_iff_mem, Algebra.smul_def, Algebra.commutes]
    exact Ideal.mul_mem_left _ _ (hIJ (Ideal.mem_map_of_mem _ hr))
  let _ := htor.module
  have := htor.isScalarTower (S := R)
  have : Module.Finite (R ⧸ I) (B ⧸ J) := Module.Finite.of_restrictScalars_finite R _ _
  have := htor.isScalarTower (S := A)
  exact Module.Finite.trans (R ⧸ I) (B ⧸ J)

/-- **Every power of a two-sided ideal containing a finite set of algebra generators of the central
scalars has a finite-module quotient.**  This is the form consumed downstream: `s` generates the
commutative ring `R` of central scalars as an `A`-algebra, `B` is finite over `R`, and the
two-sided ideal `J` of `B` contains the image of `s`. -/
theorem finite_quotient_pow_of_algebraMap_mem [Module.Finite R B] {s : Set R} (hs : s.Finite)
    (htop : Algebra.adjoin A s = ⊤) {J : Ideal B} [J.IsTwoSided]
    (hsJ : ∀ x ∈ s, algebraMap R B x ∈ J) (n : ℕ) :
    Module.Finite A (B ⧸ J ^ n) := by
  have hspan : (Ideal.span s).map (algebraMap R B) ≤ J := by
    rw [Ideal.map_span, Ideal.span_le]
    rintro - ⟨x, hx, rfl⟩
    exact hsJ x hx
  refine finite_quotient_of_map_algebraMap_le ?_
    (finite_quotient_span_pow_of_adjoin_eq_top hs htop n)
  rw [Ideal.map_algebraMap_pow]
  exact Ideal.pow_right_mono hspan n

end Noncommutative

end Ideal
