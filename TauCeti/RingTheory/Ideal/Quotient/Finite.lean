/-!
# Module-finite quotients by ideals

Let `R` be a commutative ring generated as an algebra over a commutative semiring `A` by a finite
set `s`, and let `J = Ideal.span s` be the ideal that the *same* set spans. Then `R ⧸ J ^ n` is
spanned as an `A`-module by the images of
the products of fewer than `n` elements of `s`: every element of `R` is an `A`-combination of
products of elements of `s`, and a product of `n` or more of them already lies in `J ^ n`.  That
spanning set is indexed by the tuples `Fin k → s` with `k < n`, a finite type as soon as `s` is
finite, so the quotient is a finite `A`-module.

Products also preserve module-finite quotients when the first factor ideal is finitely generated
over `R`. The filtration with successive quotients `I / IJ` and `R / I` proves this over a
commutative base semiring, without an invertibility or domain hypothesis.

Finiteness also transfers to a *noncommutative* algebra. If `B` is
an `R`-algebra and `J` is a two-sided ideal of `B` containing the
extension of an ideal `I` of `R` — for instance the two-sided ideal generated by the image of `s` —
then `B ⧸ J` is annihilated by `I`, hence an algebra over `R ⧸ I`. When `B ⧸ J` is finite as an
`R`-module, it is also finite over `R ⧸ I`, and module-finiteness composes:

`Module.Finite R (B ⧸ J) → Module.Finite A (R ⧸ I) → Module.Finite A (B ⧸ J)`.

Finiteness of `B` over `R` is a sufficient condition for the quotient-finiteness hypothesis.
Under that sufficient condition, combining the two gives
`TauCeti.finite_quotient_pow_of_algebraMap_mem`: a two-sided ideal of `B`
containing the image of a finite generating set of `R` has finite-module quotients by all of its
powers.  The motivating application is a universal enveloping algebra `U(L)` over a commutative
subalgebra `R` generated by finitely many central elements of the augmentation ideal: the quotient
of `U(L)` by any power of the two-sided ideal those elements generate is finite dimensional over
the base field.

## Main results

* `Ideal.finite_quotient_mul`: products preserve module-finite quotients when the first ideal
  is finitely generated over `R`.

* `TauCeti.span_range_prod_quotient_span_pow_eq_top`: **an explicit spanning set of
  `R ⧸ Ideal.span s ^ n`**, the images of the products of fewer than `n` elements of `s`.
* `TauCeti.finite_quotient_span_pow_of_adjoin_eq_top`: `R ⧸ Ideal.span s ^ n` is a finite
  `A`-module when the finite set `s` generates `R` as an `A`-algebra, because that spanning set is
  then finite.
* `TauCeti.finite_quotient_of_map_algebraMap_le`: finiteness of `R ⧸ I` over `A` transfers to
  `B ⧸ J` when `B ⧸ J` is finite over `R` and the two-sided ideal `J` contains the extension of `I`.
* `TauCeti.finite_quotient_pow_of_algebraMap_mem`: the combination of the two, for the powers of a
  two-sided ideal containing the image of a finite generating set, when `B` is finite over `R`.
-/

public section

namespace TauCeti

section Commutative

variable {A R : Type*} [CommSemiring A] [CommRing R] [Algebra A R]

/-- **A quotient by a power of the ideal spanned by a set of algebra generators is spanned by the
products of fewer than that many generators.**  The products of `n` or more elements of `s` lie in
`Ideal.span s ^ n`, so the images of the shorter products already span `R ⧸ Ideal.span s ^ n`.  The
spanning set is indexed by the tuples `Fin k → s` with `k < n`, which is a finite type whenever `s`
is finite. -/
theorem span_range_prod_quotient_span_pow_eq_top {s : Set R} (htop : Algebra.adjoin A s = ⊤)
    (n : ℕ) :
    Submodule.span A (Set.range fun f : (k : Fin n) × (Fin (k : ℕ) → s) =>
      Ideal.Quotient.mk (Ideal.span s ^ n) (∏ i, (f.2 i : R))) = ⊤ := by
  have key : ∀ y : R, Ideal.Quotient.mk (Ideal.span s ^ n) y ∈
      Submodule.span A (Set.range fun f : (k : Fin n) × (Fin (k : ℕ) → s) =>
        Ideal.Quotient.mk (Ideal.span s ^ n) (∏ i, (f.2 i : R))) := by
    intro y
    have hy : y ∈ Submodule.span A (Submonoid.closure s : Set R) := by
      rw [← Algebra.adjoin_eq_span, htop]; trivial
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨l, hl, rfl⟩ := Submonoid.exists_list_of_mem_closure hz
      rcases lt_or_ge l.length n with hlt | hge
      · exact Submodule.subset_span
          ⟨⟨⟨l.length, hlt⟩, fun i => ⟨l.get i, hl _ (List.get_mem l i)⟩⟩, by simp⟩
      · have hmem : l.prod ∈ Ideal.span s ^ n := by
          refine Ideal.pow_le_pow_right hge ?_
          have := Ideal.prod_mem_prod (s := (Finset.univ : Finset (Fin l.length)))
            (I := fun _ => Ideal.span s) (x := fun i => l.get i)
            (fun i _ => Ideal.subset_span (hl _ (List.get_mem l i)))
          simpa [Finset.prod_const, List.get_eq_getElem] using this
        simp [Ideal.Quotient.eq_zero_iff_mem.mpr hmem]
    | zero => simp
    | add a b ha hb iha ihb => simpa [map_add] using Submodule.add_mem _ iha ihb
    | smul c a _ ih =>
      have hsmul : Ideal.Quotient.mk (Ideal.span s ^ n) (c • a)
          = c • Ideal.Quotient.mk (Ideal.span s ^ n) a :=
        (Ideal.Quotient.mkₐ A (Ideal.span s ^ n)).toLinearMap.map_smul c a
      rw [hsmul]
      exact Submodule.smul_mem _ c ih
  rw [eq_top_iff]
  intro x _
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact key y

/-- **A quotient by a power of the ideal spanned by a finite set of algebra generators is a finite
module.**  The spanning set of `TauCeti.span_range_prod_quotient_span_pow_eq_top` is indexed by a
finite type when `s` is finite. -/
theorem finite_quotient_span_pow_of_adjoin_eq_top {s : Set R} (hs : s.Finite)
    (htop : Algebra.adjoin A s = ⊤) (n : ℕ) :
    Module.Finite A (R ⧸ Ideal.span s ^ n) := by
  have : Finite s := hs.to_subtype
  exact Module.finite_def.mpr (Submodule.fg_def.mpr
    ⟨_, Set.finite_range _, span_range_prod_quotient_span_pow_eq_top htop n⟩)

end Commutative

section Noncommutative

variable {A R B : Type*} [CommSemiring A] [CommRing R] [Ring B] [Algebra A R] [Algebra A B]
  [Algebra R B] [IsScalarTower A R B]

/-- **Module-finiteness of a quotient passes from the commutative base to a finite quotient
module.** If `B ⧸ J` is finite over the commutative ring `R` of central scalars and the two-sided
ideal `J` of `B` contains the extension of `I`, then `B ⧸ J` is an algebra over `R ⧸ I` and
is finite over `A` whenever `R ⧸ I` is finite over `A`. In particular, the quotient-finiteness
hypothesis holds when `B` is finite over `R`. -/
theorem finite_quotient_of_map_algebraMap_le {I : Ideal R} {J : Ideal B}
    [J.IsTwoSided] [Module.Finite R (B ⧸ J)]
    (hIJ : I.map (algebraMap R B) ≤ J) (h : Module.Finite A (R ⧸ I)) :
    Module.Finite A (B ⧸ J) := by
  -- Quotient scalar-tower setup adapted from `Algebra.trace_quotient_pow_mk` in
  -- `TauCeti.RingTheory.Trace.QuotientPow`.
  let _ : Algebra (R ⧸ I) (B ⧸ J) :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.mp hIJ)
  -- The structure map is `Ideal.quotientMap`, whose defining lift sends `mk I r` to
  -- `mk J (algebraMap R B r)`. This also defines the direct `R`-algebra map into `B ⧸ J`,
  -- so composing with `mk I` gives that map definitionally.
  have : IsScalarTower R (R ⧸ I) (B ⧸ J) := .of_algebraMap_eq' rfl
  have : Module.Finite (R ⧸ I) (B ⧸ J) := Module.Finite.of_restrictScalars_finite R _ _
  have : IsScalarTower A (R ⧸ I) (B ⧸ J) := .of_algebraMap_eq fun a ↦ by
    -- Both quotient structure maps are induced by the original algebra maps.
    exact congrArg (Ideal.Quotient.mk J) (IsScalarTower.algebraMap_apply A R B a)
  exact Module.Finite.trans (R ⧸ I) (B ⧸ J)

/-- **Every power of a two-sided ideal containing a finite set of algebra generators of the central
scalars has a finite-module quotient.**  This is the form consumed downstream: `s` generates the
commutative ring `R` of central scalars as an `A`-algebra, `B` is finite over `R`, and the
two-sided ideal `J` of `B` contains the image of `s`. -/
theorem finite_quotient_pow_of_algebraMap_mem [Module.Finite R B] {s : Set R} (hs : s.Finite)
    (htop : Algebra.adjoin A s = ⊤) {J : Ideal B} [J.IsTwoSided]
    (hsJ : ∀ x ∈ s, algebraMap R B x ∈ J) (n : ℕ) :
    Module.Finite A (B ⧸ J ^ n) := by
  have hspan : (Ideal.span s).map (algebraMap R B) ≤ J := by
    rw [Ideal.map_span, Ideal.span_le]
    rintro - ⟨x, hx, rfl⟩
    exact hsJ x hx
  refine finite_quotient_of_map_algebraMap_le ?_
    (finite_quotient_span_pow_of_adjoin_eq_top hs htop n)
  rw [Ideal.map_algebraMap_pow]
  exact Ideal.pow_right_mono hspan n

end Noncommutative

end TauCeti

open scoped TensorProduct

namespace Ideal

-- Extracted from the point-to-class surjectivity argument adapted from Chris Birkbeck's AINTLIB
-- (`github.com/CBirkbeck/AINTLIB`, `HasseWeil/Pic0/ToClassSurjective.lean`,
-- revision `dev/hasse-weil @ 513e83879e2f`, Apache-2.0).
/-- Products preserve module-finite quotients when the first factor ideal is finitely generated.
This does not require that factor to be invertible. -/
theorem finite_quotient_mul {A R : Type*} [CommSemiring A] [CommRing R] [Algebra A R]
    (I J : Ideal R) [Module.Finite R I] [Module.Finite A (R ⧸ I)]
    [Module.Finite A (R ⧸ J)] : Module.Finite A (R ⧸ I * J) := by
  let g : I →ₗ[R] R ⧸ I * J := (I * J).mkQ.comp I.subtype
  let N := LinearMap.range g
  have hN : N = Submodule.map (I * J).mkQ I := by
    dsimp only [N, g]
    rw [LinearMap.range_comp, Submodule.range_subtype]
  -- The kernel step is a base change of the finitely generated ideal.
  let eN : (R ⧸ J) ⊗[R] I ≃ₗ[R] N :=
    (TensorProduct.quotTensorEquivQuotSMul I J).trans
      ((Submodule.quotEquivOfEq _ _ (I.smul_top_eq_comap_mul J)).trans
        ((Submodule.quotEquivOfEq _ _ (by
          simp only [g, LinearMap.ker_comp, Submodule.ker_mkQ])).trans g.quotKerEquivRange))
  have : Module.Finite (R ⧸ J) ((R ⧸ J) ⊗[R] I) :=
    Module.Finite.base_change R (R ⧸ J) I
  have : Module.Finite A ((R ⧸ J) ⊗[R] I) :=
    Module.Finite.trans (R ⧸ J) ((R ⧸ J) ⊗[R] I)
  have : Module.Finite A N := Module.Finite.equiv (eN.restrictScalars A)
  -- The other filtration quotient is R / I.
  have eQ : ((R ⧸ I * J) ⧸ N) ≃ₗ[R] R ⧸ I := by
    rw [hN]
    exact Submodule.quotientQuotientEquivQuotient (I * J) I Ideal.mul_le_left
  have : Module.Finite A ((R ⧸ I * J) ⧸ N) :=
    Module.Finite.equiv (eQ.restrictScalars A).symm
  exact Module.Finite.of_restrictScalars_submodule_quotient N

end Ideal
