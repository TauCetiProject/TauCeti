module

public import Mathlib.Algebra.GroupWithZero.NonZeroDivisors
public import Mathlib.Algebra.Module.Submodule.Pointwise
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Data.ZMod.QuotientRing

/-!
# Regular elements modulo finite ideals

Let `R` be a commutative ring and `I` an ideal of `R` whose underlying set is finite (rather than
merely of finite index in `R`). If `a ∈ nonZeroDivisors R`, multiplication by `a` is an injective
endomorphism of the finite set `I`, hence surjective, so `a • I = I`. Consequently:

1. `I ≤ Ideal.span {a}` (`Ideal.le_span_singleton_of_finite`), so the Third Isomorphism Theorem
   identifies `(R ⧸ I) ⧸ Ideal.span {mk I a}` with `R ⧸ Ideal.span {a}`
   (`Ideal.quotientSpanSingletonQuotientEquivOfFinite`).
2. The image of `a` in `R ⧸ I` remains a non-zero-divisor
   (`Ideal.Quotient.mk_mem_nonZeroDivisors_of_finite`): if `a * r ∈ I = a • I`, then `a * r = a * y`
   for some `y ∈ I`, and cancelling `a` gives `r = y ∈ I`.

This applies to the finite torsion ideal killed when projecting an order inside a finite product of
domains onto its infinite factors. Finiteness of `I` itself is essential: in `ℤ`, the ideal `2ℤ`
has finite index (`ℤ ⧸ 2ℤ` is finite), yet `2 ∈ nonZeroDivisors ℤ` maps to `0` in `ℤ ⧸ 2ℤ`.

## Main results

* `Submodule.smul_eq_self_of_finite`: over a commutative semiring, an `M`-regular scalar fixes any
  finite submodule `N`, `a • N = N`.
* `Ideal.smul_eq_self_of_finite`, `Ideal.le_span_singleton_of_finite`: for a finite ideal `I` and
  `a ∈ nonZeroDivisors R`, `a • I = I` and `I ≤ Ideal.span {a}`.
* `Ideal.quotientSpanSingletonQuotientEquivOfFinite`: `(R ⧸ I) ⧸ (mk I a) ≃+* R ⧸ (a)` when `I` is
  finite and `a ∈ nonZeroDivisors R`.
* `Ideal.Quotient.mk_mem_nonZeroDivisors_of_finite`: a non-zero-divisor of `R` maps to a
  non-zero-divisor in `R ⧸ I` whenever `I` is finite as a set.
-/

public section

open scoped Pointwise

namespace Submodule

variable {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]

/-- If scalar multiplication by `a` is injective on `M` and `N` is a finite submodule of `M`, then
`a • N = N`: an injective self-map of the finite type `N` is surjective. -/
theorem smul_eq_self_of_finite (N : Submodule R M) [Finite N] {a : R}
    (ha : IsSMulRegular M a) : a • N = N := by
  refine le_antisymm ?_ fun y hy ↦ ?_
  · intro x hx
    obtain ⟨n, hn, rfl⟩ := Submodule.mem_smul_pointwise_iff_exists x a N |>.mp hx
    exact N.smul_mem a hn
  · have hinj : Function.Injective (fun x : N ↦ (⟨a • x.1, N.smul_mem a x.2⟩ : N)) :=
      fun x₁ x₂ h ↦ Subtype.ext (ha (congrArg Subtype.val h))
    obtain ⟨x, hx⟩ := Finite.surjective_of_injective hinj ⟨y, hy⟩
    exact Submodule.mem_smul_pointwise_iff_exists y a N |>.mpr ⟨x.1, x.2, congrArg Subtype.val hx⟩

end Submodule

namespace Ideal

variable {R : Type*} [CommRing R] (I : Ideal R) [Finite I]

/-- Multiplication by a non-zero-divisor fixes any finite ideal: `a • I = I`. -/
theorem smul_eq_self_of_finite {a : R} (ha : a ∈ nonZeroDivisors R) :
    a • I = I :=
  Submodule.smul_eq_self_of_finite I fun _ _ h ↦
    sub_eq_zero.mp (ha.1 _ (by rw [mul_sub, sub_eq_zero]; exact h))

/-- Every finite ideal is contained in the principal ideal generated by any non-zero-divisor. -/
theorem le_span_singleton_of_finite {a : R} (ha : a ∈ nonZeroDivisors R) :
    I ≤ Ideal.span {a} := by
  rw [← I.smul_eq_self_of_finite ha]
  intro x hx
  obtain ⟨y, _, rfl⟩ := Submodule.mem_smul_pointwise_iff_exists x a I |>.mp hx
  exact Ideal.mem_span_singleton.mpr ⟨y, rfl⟩

/-- When `I` is a finite ideal and `a ∈ nonZeroDivisors R`, `(R ⧸ I) ⧸ (mk I a)` is canonically
isomorphic to `R ⧸ (a)`, since `I ≤ (a)`. -/
noncomputable def quotientSpanSingletonQuotientEquivOfFinite {a : R}
    (ha : a ∈ nonZeroDivisors R) :
    ((R ⧸ I) ⧸ Ideal.span {Ideal.Quotient.mk I a}) ≃+* (R ⧸ Ideal.span {a}) :=
  (Ideal.quotEquivOfEq (by simp [Ideal.map_span])).trans
    (DoubleQuot.quotQuotEquivQuotOfLE (I.le_span_singleton_of_finite ha))

/-- `quotientSpanSingletonQuotientEquivOfFinite` maps the iterated quotient class of `r` to the
class of `r` modulo `(a)`. -/
@[simp]
theorem quotientSpanSingletonQuotientEquivOfFinite_mk {a : R} (ha : a ∈ nonZeroDivisors R)
    (r : R) :
    I.quotientSpanSingletonQuotientEquivOfFinite ha
        (Ideal.Quotient.mk _ (Ideal.Quotient.mk I r)) =
      Ideal.Quotient.mk (Ideal.span {a}) r :=
  (rfl)

/-- The inverse of `quotientSpanSingletonQuotientEquivOfFinite` maps the class of `r` modulo `(a)`
to the iterated quotient class of `r`. -/
@[simp]
theorem quotientSpanSingletonQuotientEquivOfFinite_symm_mk {a : R} (ha : a ∈ nonZeroDivisors R)
    (r : R) :
    (I.quotientSpanSingletonQuotientEquivOfFinite ha).symm
        (Ideal.Quotient.mk (Ideal.span {a}) r) =
      Ideal.Quotient.mk _ (Ideal.Quotient.mk I r) :=
  (I.quotientSpanSingletonQuotientEquivOfFinite ha).symm_apply_eq.mpr (rfl)

namespace Quotient

/-- **Regularity modulo a finite ideal.** A non-zero-divisor of `R` maps to a non-zero-divisor in
`R ⧸ I` whenever the ideal `I` is finite as a set. -/
theorem mk_mem_nonZeroDivisors_of_finite {a : R} (ha : a ∈ nonZeroDivisors R) :
    Ideal.Quotient.mk I a ∈ nonZeroDivisors (R ⧸ I) := by
  rw [mem_nonZeroDivisors_iff_left]
  intro x hx
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, ← I.smul_eq_self_of_finite ha] at hx
  obtain ⟨y, hy, hay⟩ := Submodule.mem_smul_pointwise_iff_exists (a * r) a I |>.mp hx
  have hry : r = y :=
    sub_eq_zero.mp (ha.1 _ (by rw [mul_sub, sub_eq_zero]; exact hay.symm))
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (hry ▸ hy)

end Quotient

end Ideal

section Counterexample

-- Finiteness of the ideal `I` itself cannot be weakened to finiteness of the quotient `R ⧸ I`:
-- `2ℤ` has finite index in `ℤ`, and `2 ∈ nonZeroDivisors ℤ`, yet `2` maps to `0 ∉ (ℤ ⧸ 2ℤ)⁰`.
example : (2 : ℤ) ∈ nonZeroDivisors ℤ ∧
    Finite (ℤ ⧸ Ideal.span {(2 : ℤ)}) ∧
    Ideal.Quotient.mk (Ideal.span {(2 : ℤ)}) 2 ∉
      nonZeroDivisors (ℤ ⧸ Ideal.span {(2 : ℤ)}) := by
  have : Fact (1 < 2) := ⟨by decide⟩
  have hcast : ((2 : ℕ) : ℤ) = 2 := rfl
  have hfin : Finite (ℤ ⧸ Ideal.span {(2 : ℤ)}) :=
    hcast.symm ▸ Finite.of_equiv (ZMod 2) (Int.quotientSpanNatEquivZMod 2).toEquiv.symm
  have : Nontrivial (ℤ ⧸ Ideal.span {(2 : ℤ)}) :=
    hcast ▸ (Int.quotientSpanNatEquivZMod 2).toEquiv.nontrivial
  refine ⟨mem_nonZeroDivisors_of_ne_zero (by decide), hfin, ?_⟩
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self 2)]
  exact zero_notMem_nonZeroDivisors

end Counterexample
