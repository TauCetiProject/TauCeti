public import Mathlib.RingTheory.Ideal.Over
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import TauCeti.Algebra.Module.SpanRank

/-!
# Operations on ideal quotients

If `I ≤ J` are ideals with `I` finitely generated, then `J.spanFinrank` is at most that of its image
in `R ⧸ I` plus that of `I`
(`Ideal.spanFinrank_le_spanFinrank_map_add_spanFinrank`). This is the generator-lifting step in the
proof of [Stacks Project, Lemma 10.106.7](https://stacks.math.columbia.edu/tag/00NU). The bound is
ported from T. Dupuy, T. Tucker and Z. Wang,
[pcfawd-formalization](https://github.com/tdupu/pcfawd-formalization) at commit
`9a20b3f351446d64e6015d704198bc71c7002008` (Apache-2.0),
`lean/Pcf/Bounding/PrincipalQuotientRegular.lean`, and generalizes its
`Pcf.spanFinrank_maximalIdeal_le_add_one_of_principal_kernel` from a principal kernel and the
maximal ideal of a local ring to any ideals `I ≤ J` with `I` finitely generated.

The algebra maps between quotients induced by algebra maps through `Ideal.quotientMapₐ` compose
like the algebra maps inducing them (`Ideal.quotientMapₐ_comp`).

For a principal quotient by a two-sided ideal `(x)` and an ideal `I` containing `x`, if the image of
`I` is generated by the images of a set, adjoining `x` to lifts of those quotient generators
recovers `I` (`Ideal.span_insert_eq_of_quotient`).

In the principal quotient `R ⧸ (1 - e)`, the image of `e` is `1`
(`TauCeti.Ideal.Quotient.mk_span_singleton_one_sub_self`); when `e` is idempotent this quotient is
the component of `R` cut out by `e`.

If `R / I → B / IB` is surjective, algebra maps from `B` to an algebra annihilated by `I`
are unique. This quotient extensionality lemma is used to construct compatible residue maps.
More generally, if every class modulo `J` is the class of an image under a map `f` into `S`, every
element of `S` is congruent modulo `J` to an image under `f`
(`Ideal.exists_sub_mem_of_surjective_quotient_mk_comp`); this applies whenever an induced map
`R ⧸ I → S ⧸ J` is surjective.

An action of a monoid by ring automorphisms preserving a two-sided ideal `I` descends to an action
on the quotient by `I` (`MonoidHom.quotientRingAut`), assembled from Mathlib's
`Ideal.quotientEquiv`.

If every class modulo a maximal ideal `m` comes from `f`, then `m.comap f` is maximal
(`Ideal.isMaximal_comap_of_surjective_quotient_mk_comp`).

For an element `p` of a commutative `R`-algebra `B`, the sequence `B → B → B ⧸ (p)`, whose first
map is multiplication by `p`, is exact (`Ideal.exact_mulLeft_mkₐ_span_singleton`).

A linear endomorphism commuting with multiplication by each element of a set `s` induces an
endomorphism of the quotient by `Ideal.span s` (`Ideal.exists_quotient_linearMap_of_map_mul`).
-/

public section

namespace Ideal

/-- `Ideal.quotientMapₐ` is functorial: the map induced by a composite of algebra maps is the
composite of the induced maps. -/
theorem quotientMapₐ_comp {R₁ A B C : Type*} [CommSemiring R₁] [Ring A] [Ring B] [Ring C]
    [Algebra R₁ A] [Algebra R₁ B] [Algebra R₁ C] {I : Ideal A} {J : Ideal B} (K : Ideal C)
    [I.IsTwoSided] [J.IsTwoSided] [K.IsTwoSided] (g : B →ₐ[R₁] C) (f : A →ₐ[R₁] B)
    (hg : J ≤ K.comap g) (hf : I ≤ J.comap f) :
    (quotientMapₐ K g hg).comp (quotientMapₐ J f hf) =
      quotientMapₐ K (g.comp f) (hf.trans (comap_mono hg)) :=
  Quotient.algHom_ext R₁ rfl

/-- Let `I` be an ideal containing `x`, with `(x)` two-sided. If the image of `I` in the principal
quotient `R ⧸ (x)` is generated by the images of a set, adjoining `x` to that set generates `I`. -/
theorem span_insert_eq_of_quotient {R : Type*} [Ring R] (I : Ideal R) {x : R}
    [(span {x} : Ideal R).IsTwoSided] (hmem : x ∈ I) (s : Set R)
    (himage : span ((Quotient.mk (span {x})) '' s) = I.map (Quotient.mk (span {x}))) :
    span (insert x s) = I := by
  -- Pull the image equality back along the quotient map; both sides absorb the kernel `(x)`.
  have h := congrArg (comap (Quotient.mk (span {x}))) himage
  rw [← map_span, comap_map_of_surjective _ Quotient.mk_surjective,
    comap_map_of_surjective _ Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot, mk_ker,
    sup_eq_left.mpr ((Submodule.span_singleton_le_iff_mem x I).mpr hmem)] at h
  rw [span_insert, sup_comm, h]

section CommRing

variable {R : Type*} [CommRing R]

/-- If `R / I → B / IB` is surjective, algebra maps from `B` to an algebra annihilated
by `I` are unique. -/
theorem algHom_ext_of_surjective_algebraMap_quotient (I : Ideal R)
    (B : Type*) [CommRing B] [Algebra R B]
    (hB : Function.Surjective (algebraMap (R ⧸ I) (B ⧸ I.map (algebraMap R B))))
    {S : Type*} [Semiring S] [Algebra R S]
    (hI : I ≤ RingHom.ker (algebraMap R S)) (f g : B →ₐ[R] S) : f = g := by
  have kills (a : B →ₐ[R] S) : ∀ b ∈ I.map (algebraMap R B), a b = 0 := by
    intro b hb
    apply (map_le_iff_le_comap.mpr ?_ : I.map (algebraMap R B) ≤
      RingHom.ker a.toRingHom) hb
    intro r hr
    simpa using hI hr
  let f' := Quotient.liftₐ _ f (kills f)
  let g' := Quotient.liftₐ _ g (kills g)
  have he : f' = g' := by
    apply AlgHom.ext
    intro b
    obtain ⟨r, rfl⟩ := hB b
    obtain ⟨r, rfl⟩ := Quotient.mk_surjective r
    simp [f', g']
  exact AlgHom.ext fun b ↦ congrArg (fun a ↦ a (Quotient.mk _ b)) he

/-- If every class modulo `J` is the class of an image under `f`, every element of `S` is
congruent modulo `J` to an image under `f`. If an induced map `A ⧸ I → S ⧸ J` is surjective,
compose its surjectivity with `Ideal.Quotient.mk_surjective` to obtain `hf`. -/
theorem exists_sub_mem_of_surjective_quotient_mk_comp {A S : Type*} [Ring S] {J : Ideal S}
    [J.IsTwoSided] {f : A → S} (hf : Function.Surjective (Quotient.mk J ∘ f)) (s : S) :
    ∃ a, s - f a ∈ J := by
  obtain ⟨a, ha⟩ := hf (Quotient.mk J s)
  exact ⟨a, Quotient.eq.mp ha.symm⟩

/-- If `I ≤ J` are ideals with `I` finitely generated, then `J.spanFinrank` is at most the sum
of the `spanFinrank`s of its image in `R ⧸ I` and `I`. For finitely generated `J`, this bounds
its number of generators; for non-finitely-generated `J`, `J.spanFinrank` is defined to be `0`.
This is the ideal form of `Submodule.spanFinrank_le_spanFinrank_map_mkQ_add_spanFinrank`. -/
theorem spanFinrank_le_spanFinrank_map_add_spanFinrank {I J : Ideal R} (hIJ : I ≤ J)
    (hI : I.FG) :
    J.spanFinrank ≤ (J.map (Quotient.mk I)).spanFinrank + I.spanFinrank := by
  have hmap : (J.map (Quotient.mk I)).restrictScalars R = Submodule.map I.mkQ J := by
    ext y
    simp [mem_map_iff_of_surjective _ Quotient.mk_surjective]
  have hrank : (Submodule.map I.mkQ J).spanFinrank = (J.map (Quotient.mk I)).spanFinrank := by
    rw [← hmap]
    exact Submodule.spanFinrank_restrictScalars_eq Quotient.mk_surjective _
  simpa [hrank] using
    Submodule.spanFinrank_le_spanFinrank_map_mkQ_add_spanFinrank hIJ hI

/-- If every class modulo a maximal ideal `m` is the image of an element under `f`, then
`m.comap f` is maximal: it is the kernel of the surjection from the source onto the field
`S ⧸ m`. Compare `Ideal.comap_isMaximal_of_surjective`, which asks `f` itself to be
surjective. -/
theorem isMaximal_comap_of_surjective_quotient_mk_comp {A S F : Type*} [Ring A] [CommRing S]
    [FunLike F A S] [RingHomClass F A S] (f : F) {m : Ideal S} [m.IsMaximal]
    (hf : Function.Surjective (Quotient.mk m ∘ f)) : (m.comap f).IsMaximal := by
  let := Quotient.field m
  have := RingHom.ker_isMaximal_of_surjective ((Quotient.mk m).comp (f : A →+* S)) hf
  rwa [← RingHom.comap_ker, mk_ker, comap_coe] at this

/-- A linear endomorphism commuting with multiplication by each element of a set `s` preserves the
ideal spanned by `s`, so it induces a compatible endomorphism of the quotient by that ideal. -/
theorem exists_quotient_linearMap_of_map_mul {k A : Type*} [CommSemiring k] [CommRing A]
    [Algebra k A] {s : Set A} (T : A →ₗ[k] A)
    (hmul : ∀ f ∈ s, ∀ x, T (f * x) = f * T x) :
    ∃ Q : (A ⧸ span s) →ₗ[k] (A ⧸ span s),
      ∀ x, Q (Quotient.mk _ x) = Quotient.mk _ (T x) := by
  have hT : ∀ x ∈ span s, T x ∈ span s := by
    intro x hx
    -- Generalize over the multiplier, since `T` commutes only with multiplication by `s`.
    suffices h : ∀ a, T (a * x) ∈ span s by simpa using h 1
    induction hx using Submodule.span_induction with
    | mem f hf =>
      intro a
      rw [mul_comm, hmul f hf]
      exact mul_mem_right _ _ (subset_span hf)
    | zero => simp
    | add x y _ _ hx hy => intro a; rw [mul_add, map_add]; exact add_mem (hx a) (hy a)
    | smul b x _ hx => intro a; rw [smul_eq_mul, ← mul_assoc]; exact hx (a * b)
  -- Descend `T` by hand: `Submodule.mapQ` would need `k` to be a ring.
  let Q : A ⧸ span s → A ⧸ span s := Quotient.map' T fun x y h ↦ by
    rw [Submodule.quotientRel_def] at h ⊢
    simpa using hT _ h
  have hQ (x : A) : Q (Quotient.mkₐ k (span s) x) = Quotient.mkₐ k (span s) (T x) := by
    simp only [Q, Quotient.mkₐ_eq_mk, ← Quotient.mk_eq_mk, ← Submodule.Quotient.mk''_eq_mk,
      Quotient.map'_mk'']
  refine ⟨{ toFun := Q, map_add' := ?_, map_smul' := ?_ }, fun x ↦ ?_⟩
  · intro x y
    obtain ⟨x, rfl⟩ := Quotient.mkₐ_surjective k (span s) x
    obtain ⟨y, rfl⟩ := Quotient.mkₐ_surjective k (span s) y
    simp only [← map_add, hQ]
  · intro c x
    obtain ⟨x, rfl⟩ := Quotient.mkₐ_surjective k (span s) x
    simp only [← map_smul, hQ, RingHom.id_apply]
  · simpa [Quotient.mkₐ_eq_mk] using hQ x

/-- The linear combination, with coefficients in `R ⧸ I`, of the classes in `S ⧸ IS` of elements
`b j` of `S`, evaluated at the classes of `c j`, is the class of `∑ j, c j * b j`. -/
theorem Quotient.linearCombination_mk_map_apply {S ι : Type*} [CommRing S] [Algebra R S]
    [Fintype ι] (I : Ideal R) (b : ι → S) (c : ι → R) :
    Fintype.linearCombination (R ⧸ I) (fun j ↦ Quotient.mk (I.map (algebraMap R S)) (b j))
        (fun j ↦ Quotient.mk I (c j)) =
      Quotient.mk (I.map (algebraMap R S)) (∑ j, algebraMap R S (c j) * b j) := by
  simp [Fintype.linearCombination_apply, map_sum, Algebra.smul_def]

end CommRing

/-- For an element `p` of a commutative `R`-algebra `B`, the sequence `B → B → B ⧸ (p)`, whose
first map is multiplication by `p`, is exact. -/
theorem exact_mulLeft_mkₐ_span_singleton {R B : Type*} [CommSemiring R] [CommRing B] [Algebra R B]
    (p : B) :
    Function.Exact (LinearMap.mulLeft R p) (Quotient.mkₐ R (span {p})).toLinearMap := by
  -- `B ⧸ (p)` is the quotient by the range of `toSpanSingleton B B p`, which is `mulLeft p`.
  have hexact := LinearMap.exact_map_mkQ_range (LinearMap.toSpanSingleton B B p)
  rw [LinearMap.range_toSpanSingleton] at hexact
  convert hexact using 1 <;> ext b
  · simp [mul_comm]
  · simp [Quotient.mkₐ_eq_mk, ← Quotient.mk_eq_mk]

end Ideal

namespace MonoidHom

variable {H : Type*} [Monoid H] {A : Type*} [Ring A] (a : H →* RingAut A) (I : Ideal A)
  [I.IsTwoSided] (hI : ∀ h, I.map (a h : A →+* A) = I)

/-- An action of a monoid `H` on a ring `A` by ring automorphisms that preserve a two-sided ideal
`I` descends to an action on `A ⧸ I`: the element `h` acts by `Ideal.quotientEquiv I I (a h)`,
which sends the class of `x` to the class of `a h x`. -/
def quotientRingAut : H →* RingAut (A ⧸ I) where
  toFun h := Ideal.quotientEquiv I I (a h) (hI h).symm
  map_one' := by
    ext x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp [RingAut.one_eq_refl]
  map_mul' g h := by
    ext x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp [RingAut.mul_apply]

/-- The descended action sends a residue class to the class of its image under `a h`. -/
@[simp]
theorem quotientRingAut_apply_mk (h : H) (x : A) :
    a.quotientRingAut I hI h (Ideal.Quotient.mk I x) = Ideal.Quotient.mk I (a h x) :=
  (rfl)

/-- The inverse descended action sends a residue class to the class of the inverse image. -/
@[simp]
theorem quotientRingAut_symm_apply_mk (h : H) (x : A) :
    (a.quotientRingAut I hI h).symm (Ideal.Quotient.mk I x) =
      Ideal.Quotient.mk I ((a h).symm x) :=
  (rfl)

end MonoidHom

namespace TauCeti.Ideal.Quotient

/-- In the principal quotient `R ⧸ (1 - e)`, the image of `e` is `1`. -/
@[simp]
theorem mk_span_singleton_one_sub_self {R : Type*} [CommRing R] (e : R) :
    Ideal.Quotient.mk (Ideal.span {1 - e}) e = 1 := by
  rw [← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq]
  exact Ideal.mem_span_singleton'.mpr ⟨-1, by ring⟩

end TauCeti.Ideal.Quotient
