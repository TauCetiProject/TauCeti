module

public import Mathlib.RingTheory.Ideal.Over
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import TauCeti.Algebra.Module.SpanRank

/-!
# Operations on ideal quotients

If `I ≤ J` are ideals with `I` finitely generated, then `J.spanFinrank` is at most that of its image
in `R ⧸ I` plus that of `I`
(`Ideal.spanFinrank_le_spanFinrank_map_add_spanFinrank`). This is the generator-lifting step in the
proof of [Stacks Project, Lemma 10.106.7](https://stacks.math.columbia.edu/tag/00NU). The bound is
ported from T. Dupuy, T. Tucker and Z. Wang,
[pcfawd-formalization](https://github.com/tdupu/pcfawd-formalization) at commit
`9a20b3f351446d64e6015d704198bc71c7002008` (Apache-2.0),
`lean/Pcf/Bounding/PrincipalQuotientRegular.lean`, and generalizes its
`Pcf.spanFinrank_maximalIdeal_le_add_one_of_principal_kernel` from a principal kernel and the
maximal ideal of a local ring to any ideals `I ≤ J` with `I` finitely generated.

For a principal quotient, if the image of an ideal is generated by the images of a set, adjoining
the kernel generator to lifts of those quotient generators recovers the original ideal.

In the principal quotient `R ⧸ (1 - e)`, the image of `e` is `1`
(`TauCeti.Ideal.Quotient.mk_span_singleton_one_sub_self`); when `e` is idempotent this quotient is
the component of `R` cut out by `e`.

If `R / I → B / IB` is surjective, algebra maps from `B` to an algebra annihilated by `I`
are unique. This quotient extensionality lemma is used to construct compatible residue maps.
-/

public section

namespace Ideal

variable {R : Type*} [CommRing R]

/-- If the image of an ideal in a principal quotient is generated by the images of a set,
adjoining the kernel generator to that set generates the original ideal. -/
theorem span_insert_eq_of_quotient (I : Ideal R) {x : R}
    (hmem : x ∈ I) (s : Set R)
    (himage : span ((Ideal.Quotient.mk (span {x})) '' s) =
      I.map (Ideal.Quotient.mk (span {x}))) :
    span (insert x s) = I := by
  have hmap : (span (insert x s)).map (Ideal.Quotient.mk (span {x})) =
      I.map (Ideal.Quotient.mk (span {x})) := by
    rw [map_span, Set.image_insert_eq, Ideal.Quotient.eq_zero_iff_mem.mpr
      (mem_span_singleton_self x), span_insert_zero, himage]
  have heq := (map_eq_iff_sup_ker_eq_of_surjective _ Ideal.Quotient.mk_surjective).mp hmap
  rw [Ideal.mk_ker, sup_of_le_left (span_mono (Set.singleton_subset_iff.mpr
    (Set.mem_insert x s))), sup_of_le_left
      ((span_singleton_le_iff_mem _).mpr hmem)] at heq
  exact heq

/-- If `R / I → B / IB` is surjective, algebra maps from `B` to an algebra annihilated
by `I` are unique. -/
theorem algHom_ext_of_surjective_algebraMap_quotient (I : Ideal R)
    (B : Type*) [CommRing B] [Algebra R B]
    (hB : Function.Surjective (algebraMap (R ⧸ I) (B ⧸ I.map (algebraMap R B))))
    {S : Type*} [Semiring S] [Algebra R S]
    (hI : I ≤ RingHom.ker (algebraMap R S)) (f g : B →ₐ[R] S) : f = g := by
  have kills (a : B →ₐ[R] S) : ∀ b ∈ I.map (algebraMap R B), a b = 0 := by
    intro b hb
    apply (Ideal.map_le_iff_le_comap.mpr ?_ : I.map (algebraMap R B) ≤
      RingHom.ker a.toRingHom) hb
    intro r hr
    simpa using hI hr
  let f' := Ideal.Quotient.liftₐ _ f (kills f)
  let g' := Ideal.Quotient.liftₐ _ g (kills g)
  have he : f' = g' := by
    apply AlgHom.ext
    intro b
    obtain ⟨r, rfl⟩ := hB b
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
    simp [f', g']
  exact AlgHom.ext fun b ↦ congrArg (fun a ↦ a (Ideal.Quotient.mk _ b)) he

/-- If `I ≤ J` are ideals with `I` finitely generated, then `J.spanFinrank` is at most the sum
of the `spanFinrank`s of its image in `R ⧸ I` and `I`. For finitely generated `J`, this bounds
its number of generators; for non-finitely-generated `J`, `J.spanFinrank` is defined to be `0`.
This is the ideal form of `Submodule.spanFinrank_le_spanFinrank_map_mkQ_add_spanFinrank`. -/
theorem spanFinrank_le_spanFinrank_map_add_spanFinrank {I J : Ideal R} (hIJ : I ≤ J)
    (hI : I.FG) :
    J.spanFinrank ≤ (J.map (Ideal.Quotient.mk I)).spanFinrank + I.spanFinrank := by
  have hmap : (J.map (Ideal.Quotient.mk I)).restrictScalars R = Submodule.map I.mkQ J := by
    ext y
    simp [mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective]
  have hrank : (Submodule.map I.mkQ J).spanFinrank = (J.map (Ideal.Quotient.mk I)).spanFinrank := by
    rw [← hmap]
    exact Submodule.spanFinrank_restrictScalars_eq Ideal.Quotient.mk_surjective _
  simpa [hrank] using
    Submodule.spanFinrank_le_spanFinrank_map_mkQ_add_spanFinrank hIJ hI

end Ideal

namespace TauCeti.Ideal.Quotient

/-- In the principal quotient `R ⧸ (1 - e)`, the image of `e` is `1`. -/
@[simp]
theorem mk_span_singleton_one_sub_self {R : Type*} [CommRing R] (e : R) :
    Ideal.Quotient.mk (Ideal.span {1 - e}) e = 1 := by
  rw [← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq]
  exact Ideal.mem_span_singleton'.mpr ⟨-1, by ring⟩

end TauCeti.Ideal.Quotient
