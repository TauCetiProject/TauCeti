module

public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Lifting generators from a principal quotient

If the image of an ideal in a principal quotient is generated by the images of a set, adjoining
the kernel generator to lifts of those quotient generators recovers the original ideal.

In the principal quotient `R ⧸ (1 - e)`, the image of `e` is `1`
(`TauCeti.Ideal.Quotient.mk_span_singleton_one_sub_self`); when `e` is idempotent this quotient is
the component of `R` cut out by `e`.
-/

public section

namespace Ideal

variable {R : Type*} [CommRing R]

/-- If the image of an ideal in a principal quotient is generated by the images of a set,
adjoining the kernel generator to that set generates the original ideal. -/
theorem span_insert_eq_of_quotient (I : Ideal R) {x : R}
    (hmem : x ∈ I) (s : Set R)
    (himage : span ((Ideal.Quotient.mk (span {x})) '' s) =
      I.map (Ideal.Quotient.mk (span {x}))) :
    span (insert x s) = I := by
  have hmap : (span (insert x s)).map (Ideal.Quotient.mk (span {x})) =
      I.map (Ideal.Quotient.mk (span {x})) := by
    rw [map_span, Set.image_insert_eq, Ideal.Quotient.eq_zero_iff_mem.mpr
      (mem_span_singleton_self x), span_insert_zero, himage]
  have heq := (map_eq_iff_sup_ker_eq_of_surjective _ Ideal.Quotient.mk_surjective).mp hmap
  rw [Ideal.mk_ker, sup_of_le_left (span_mono (Set.singleton_subset_iff.mpr
    (Set.mem_insert x s))), sup_of_le_left
      ((span_singleton_le_iff_mem _).mpr hmem)] at heq
  exact heq

end Ideal

namespace TauCeti.Ideal.Quotient

/-- In the principal quotient `R ⧸ (1 - e)`, the image of `e` is `1`. -/
@[simp]
theorem mk_span_singleton_one_sub_self {R : Type*} [CommRing R] (e : R) :
    Ideal.Quotient.mk (Ideal.span {1 - e}) e = 1 := by
  rw [← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq]
  exact Ideal.mem_span_singleton'.mpr ⟨-1, by ring⟩

end TauCeti.Ideal.Quotient
