module

public import Mathlib.RingTheory.Ideal.IsPrincipal
public import Mathlib.GroupTheory.Index
import Mathlib.Algebra.BigOperators.Associated

/-!
# Principal intersections and scalar indices

A nonzero principal ideal in a domain is a free module of rank one. Multiplication by `c`
on its additive group therefore has cokernel of order `Nat.card (R ⧸ Ideal.span {c})`.
This computes scalar indices on small principal neighbourhoods after linearisation.
Finite intersections of ideals generated by prime elements in a domain
also have a nonzero principal generator.
-/

public section

namespace Ideal

variable {R : Type*} [CommRing R] [IsDomain R]

/-- Multiplication by `c` on a nonzero principal ideal has the same cokernel index as
multiplication by `c` on the ring. No finiteness assumption is needed for this identity. -/
theorem index_range_smul (I : Ideal R) [I.IsPrincipal] (hI : I ≠ ⊥) (c : R) :
    (DistribSMul.toAddMonoidHom I c).range.index = Nat.card (R ⧸ span {c}) := by
  let e := (isoBaseOfIsPrincipal hI).symm
  have hr : (DistribSMul.toAddMonoidHom I c).range.map e.toAddEquiv.toAddMonoidHom =
      (span {c}).toAddSubgroup := by
    ext z
    constructor
    · rintro ⟨y, ⟨x, rfl⟩, rfl⟩
      exact mem_span_singleton.mpr ⟨e x, by simp [map_smul, smul_eq_mul]⟩
    · intro hz
      obtain ⟨x, rfl⟩ := mem_span_singleton.mp hz
      refine ⟨c • e.symm x, ⟨e.symm x, rfl⟩, ?_⟩
      simp [map_smul, smul_eq_mul]
  have hidx := AddSubgroup.index_map_of_bijective
    (f := e.toAddEquiv.toAddMonoidHom) e.toAddEquiv.bijective
    (DistribSMul.toAddMonoidHom I c).range
  rw [hr, AddSubgroup.index_eq_card] at hidx
  exact hidx.symm

/-- A finite intersection of ideals generated by prime elements in a domain
is generated by a nonzero element. -/
theorem exists_ne_zero_finsetInf_eq_span_singleton
    {R : Type*} [CommSemiring R] [IsDomain R] (b : Finset (Ideal R))
    (h : ∀ P ∈ b, ∃ π : R, Prime π ∧ P = Ideal.span {π}) :
    ∃ a : R, a ≠ 0 ∧ b.inf id = Ideal.span {a} := by
  classical
  choose π hπ hgen using fun P : b ↦ h P P.property
  have hsame (P Q : b) (hPQ : Associated (π P) (π Q)) : P = Q := by
    apply Subtype.ext
    rw [hgen P, hgen Q]
    exact Ideal.span_singleton_eq_span_singleton.mpr hPQ
  refine ⟨∏ P, π P, Finset.prod_ne_zero_iff.mpr (fun P _ ↦ (hπ P).ne_zero), ?_⟩
  ext x
  simp only [Submodule.mem_finsetInf, id_eq, Ideal.mem_span_singleton]
  constructor
  · intro hx
    rw [Finset.prod_eq_multiset_prod]
    apply Multiset.prod_primes_dvd x
    · intro p hp
      obtain ⟨P, _, rfl⟩ := Multiset.mem_map.mp hp
      exact hπ P
    · intro p hp
      obtain ⟨P, _, rfl⟩ := Multiset.mem_map.mp hp
      have := hx P P.property
      rwa [hgen P, Ideal.mem_span_singleton] at this
    · intro p
      rw [Multiset.countP_map, ← Finset.filter_val, Finset.card_val, Finset.card_le_one]
      intro P hP Q hQ
      exact hsame P Q ((Finset.mem_filter.mp hP).2.symm.trans (Finset.mem_filter.mp hQ).2)
  · intro hx P hP
    -- `hgen` is indexed by the subtype `b`; the annotation removes its projection to `P`.
    rw [show P = _ from hgen ⟨P, hP⟩, Ideal.mem_span_singleton]
    exact (Finset.dvd_prod_of_mem π (Finset.mem_univ ⟨P, hP⟩)).trans hx

end Ideal
