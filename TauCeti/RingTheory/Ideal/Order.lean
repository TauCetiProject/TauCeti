module

public import Mathlib.Data.ENat.Lattice
public import Mathlib.RingTheory.Filtration
public import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# Local order of an ideal

The order of an ideal in a local ring is the supremum of the natural numbers `n` for which
it is contained in the `n`-th power of the maximal ideal. Its value lies in `ℕ∞`.
The threshold characterization gives formulas for sums and generating families, including
empty families. No Noetherian hypothesis is needed for these formulas; Krull intersection
is needed to characterize infinite order by vanishing.

`Ideal.orderAt` applies this construction after localization at a prime. It is the local
algebraic order used in order-threshold loci of marked ideals, rather than the order of their
reduced supports. Multiplicativity is not asserted for arbitrary local rings.

This is the order convention of Bierstone–Milman, *Canonical desingularization in
characteristic zero by blowing up the maximum strata of a local invariant* (1997),
Remark 1.8 and §4.1.
-/

public section

namespace Ideal

open IsLocalRing

section Local

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- The order of an ideal in a local ring, with value `∞` if it lies in every power of
the maximal ideal. -/
noncomputable def localOrder (I : Ideal R) : ℕ∞ :=
  ⨆ (n : ℕ) (_ : I ≤ maximalIdeal R ^ n), (n : ℕ∞)

/-- The defining supremum for local ideal order. -/
theorem localOrder_def (I : Ideal R) :
    I.localOrder = ⨆ (n : ℕ) (_ : I ≤ maximalIdeal R ^ n), (n : ℕ∞) := (rfl)

/-- An ideal has order at least `n` exactly when it lies in the `n`-th maximal-ideal power. -/
@[simp]
theorem natCast_le_localOrder_iff (I : Ideal R) (n : ℕ) :
    (n : ℕ∞) ≤ I.localOrder ↔ I ≤ maximalIdeal R ^ n := by
  constructor
  · intro h
    cases n with
    | zero => simp
    | succ n =>
      have hlt : (n : ℕ∞) < I.localOrder := by
        simpa only [Nat.cast_add, Nat.cast_one, ENat.natCast_add_one_le_iff] using h
      obtain ⟨k, hk⟩ := lt_iSup_iff.mp hlt
      obtain ⟨hI, hk⟩ := lt_iSup_iff.mp hk
      exact hI.trans (Ideal.pow_le_pow_right (Nat.succ_le_of_lt (Nat.cast_lt.mp hk)))
  · intro h
    exact le_iSup_of_le n (le_iSup_of_le h le_rfl)

/-- Inclusion of ideals reverses their local orders. -/
theorem localOrder_anti {I J : Ideal R} (h : I ≤ J) : J.localOrder ≤ I.localOrder := by
  apply ENat.forall_natCast_le_iff_le.mp
  intro n hn
  exact (natCast_le_localOrder_iff I n).mpr
    (h.trans ((natCast_le_localOrder_iff J n).mp hn))

/-- Infinite order means containment in every maximal-ideal power, without a separation
hypothesis on the local ring. -/
theorem localOrder_eq_top_iff (I : Ideal R) :
    I.localOrder = ⊤ ↔ ∀ n : ℕ, I ≤ maximalIdeal R ^ n := by
  constructor
  · intro h n
    exact (natCast_le_localOrder_iff I n).mp (by simp [h])
  · intro h
    apply top_unique
    rw [← ENat.iSup_natCast]
    exact iSup_le fun n ↦ (natCast_le_localOrder_iff I n).mpr (h n)

/-- The zero ideal has infinite order, even without Noetherianity. -/
@[simp]
theorem localOrder_bot : (⊥ : Ideal R).localOrder = ⊤ :=
  (localOrder_eq_top_iff _).mpr fun _ ↦ bot_le

/-- The unit ideal has order zero. -/
@[simp]
theorem localOrder_top : (⊤ : Ideal R).localOrder = 0 := by
  apply le_antisymm _ zero_le
  apply le_of_not_gt
  intro h
  have hm : (⊤ : Ideal R) ≤ maximalIdeal R := by
    simpa using (natCast_le_localOrder_iff (⊤ : Ideal R) 1).mp
      (Order.one_le_iff_pos.mpr h)
  exact (maximalIdeal.isMaximal R).ne_top (top_unique hm)

/-- Order zero is equivalent to being the unit ideal. -/
@[simp]
theorem localOrder_eq_zero_iff (I : Ideal R) : I.localOrder = 0 ↔ I = ⊤ := by
  constructor
  · intro h
    by_contra hI
    have hn := (natCast_le_localOrder_iff I 1).mpr (by
      simpa using le_maximalIdeal hI)
    simp [h] at hn
  · rintro rfl
    exact localOrder_top

/-- The order of a sum is the smaller of the two orders. -/
@[simp]
theorem localOrder_sup (I J : Ideal R) :
    (I ⊔ J).localOrder = min I.localOrder J.localOrder := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  simp

/-- The order of an ideal generated by a family of ideals is the infimum of their orders. -/
@[simp]
theorem localOrder_iSup {ι : Sort*} (I : ι → Ideal R) :
    (⨆ i, I i).localOrder = ⨅ i, (I i).localOrder := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  simp

/-- The order of a generated ideal is the infimum of the orders of the principal ideals
of its generators. The empty infimum is `∞`. -/
theorem localOrder_span (s : Set R) :
    (span s).localOrder = ⨅ x ∈ s, (span {x}).localOrder := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  simp [span_le, Set.subset_def]

/-- The generator-order formula for an indexed family; in particular a finite family's
order is its minimum generator order. -/
theorem localOrder_span_range {ι : Type*} (f : ι → R) :
    (span (Set.range f)).localOrder = ⨅ i, (span {f i}).localOrder := by
  rw [span_range_eq_iSup, localOrder_iSup]

/-- Over a Noetherian local ring, only the zero ideal has infinite order. -/
@[simp]
theorem localOrder_eq_top_iff_eq_bot [IsNoetherianRing R] (I : Ideal R) :
    I.localOrder = ⊤ ↔ I = ⊥ := by
  rw [localOrder_eq_top_iff, ← le_iInf_iff,
    Ideal.iInf_pow_eq_bot_of_isLocalRing _ (maximalIdeal.isMaximal R).ne_top, le_bot_iff]

end Local

section AtPrime

variable {R : Type*} [CommRing R]

/-- The order of an ideal at a prime, computed in the local ring at that prime. -/
noncomputable def orderAt (I : Ideal R) (p : PrimeSpectrum R) : ℕ∞ :=
  (I.map (algebraMap R (Localization.AtPrime p.asIdeal))).localOrder

/-- Localizing the ideal computes its order at a prime. -/
theorem orderAt_def (I : Ideal R) (p : PrimeSpectrum R) :
    I.orderAt p = (I.map (algebraMap R (Localization.AtPrime p.asIdeal))).localOrder := (rfl)

/-- Order thresholds at a prime are exactly containment in powers of the localized
maximal ideal. -/
@[simp]
theorem natCast_le_orderAt_iff (I : Ideal R) (p : PrimeSpectrum R) (n : ℕ) :
    (n : ℕ∞) ≤ I.orderAt p ↔
      I.map (algebraMap R (Localization.AtPrime p.asIdeal)) ≤
        maximalIdeal (Localization.AtPrime p.asIdeal) ^ n :=
  natCast_le_localOrder_iff _ _

/-- Inclusion reverses orders at every prime. -/
theorem orderAt_anti {I J : Ideal R} (h : I ≤ J) (p : PrimeSpectrum R) :
    J.orderAt p ≤ I.orderAt p :=
  localOrder_anti (map_mono h)

/-- The zero ideal has infinite order at every prime. -/
@[simp]
theorem orderAt_bot (p : PrimeSpectrum R) : (⊥ : Ideal R).orderAt p = ⊤ := by
  simp [orderAt]

/-- The unit ideal has order zero at every prime. -/
@[simp]
theorem orderAt_top (p : PrimeSpectrum R) : (⊤ : Ideal R).orderAt p = 0 := by
  simp [orderAt, map_top]

/-- An ideal has positive order at a prime exactly when it is contained in that prime. -/
@[simp]
theorem one_le_orderAt_iff (I : Ideal R) (p : PrimeSpectrum R) :
    1 ≤ I.orderAt p ↔ I ≤ p.asIdeal := by
  simpa only [Nat.cast_one, pow_one, map_le_iff_le_comap,
    Localization.AtPrime.under_maximalIdeal] using
    natCast_le_orderAt_iff I p 1

/-- Order zero at a prime means that the ideal is not contained in that prime. -/
@[simp]
theorem orderAt_eq_zero_iff (I : Ideal R) (p : PrimeSpectrum R) :
    I.orderAt p = 0 ↔ ¬ I ≤ p.asIdeal := by
  rw [← one_le_orderAt_iff, Order.one_le_iff_ne_zero, not_not]

/-- The order of a sum at a prime is the smaller of the two orders. -/
@[simp]
theorem orderAt_sup (I J : Ideal R) (p : PrimeSpectrum R) :
    (I ⊔ J).orderAt p = min (I.orderAt p) (J.orderAt p) := by
  simp [orderAt, map_sup]

/-- At a prime, generator orders compute the ideal order, including for an empty family. -/
theorem orderAt_span_range {ι : Type*} (f : ι → R) (p : PrimeSpectrum R) :
    (span (Set.range f)).orderAt p = ⨅ i, (span {f i}).orderAt p := by
  simp only [orderAt, span_range_eq_iSup, map_iSup, localOrder_iSup]

end AtPrime

end Ideal
