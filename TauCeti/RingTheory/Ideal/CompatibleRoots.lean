module

public import Mathlib.RingTheory.Ideal.Operations
public import TauCeti.RingTheory.Perfection

/-!
# Ideals generated by compatible roots

Let `r : ℕ → R` satisfy `r (n + 1) ^ p = r n`, where `p ≥ 2`. The ideal generated by
the `r n` is an increasing union of principal ideals: an element belongs to it exactly when
some `r n` divides it. This ideal is idempotent, and the `k`-th powers of the roots still
generate it for every positive `k`. Discarding finitely many roots leaves it unchanged.

These are the algebraic properties of the root ideal used in almost mathematics. They require
neither a topology nor regularity of the roots, and apply even to compatible nilpotent roots.
The ideal is written as `Ideal.span (Set.range r)` throughout, using the existing ideal API.

## References

* O. Gabber and L. Ramero, *Almost ring theory*, §2.1, conditions (A) and (B).
* B. Bhatt, *Lecture notes for a class on perfectoid spaces*, §4.1, Example 4.1.3.
-/

public section

namespace TauCeti

variable {R : Type*} [CommSemiring R] {p : ℕ} {r : ℕ → R}

/-- The ideal of a compatible root sequence is the union of its principal root ideals. -/
theorem mem_span_range_compatible_roots_iff (hr : ∀ n, r (n + 1) ^ p = r n) {x : R} :
    x ∈ Ideal.span (Set.range r) ↔ ∃ n, r n ∣ x := by
  rw [Ideal.span_range_eq_iSup, Submodule.mem_iSup_of_directed]
  · simp only [Ideal.mem_span_singleton]
  · exact fun m n ↦ ⟨max m n,
      Ideal.span_singleton_le_span_singleton.mpr
        (dvd_of_compatible_roots hr (le_max_left m n)),
      Ideal.span_singleton_le_span_singleton.mpr
        (dvd_of_compatible_roots hr (le_max_right m n))⟩

/-- For every `k`, an element of the root ideal is divisible by the `k`-th power of some root. -/
theorem exists_pow_dvd_of_mem_span_range_compatible_roots (hp : 2 ≤ p)
    (hr : ∀ n, r (n + 1) ^ p = r n) {x : R}
    (hx : x ∈ Ideal.span (Set.range r)) (k : ℕ) : ∃ n, r n ^ k ∣ x := by
  obtain ⟨n, hn⟩ := (mem_span_range_compatible_roots_iff hr).mp hx
  have hpow : r (n + k) ^ p ^ k = r n := by
    simpa only [Perfection.coeffMonoidHom_mk] using
      Perfection.coeffMonoidHom_pow_p_pow' (⟨r, hr⟩ : Perfection R p) n k
  refine ⟨n + k, dvd_trans ?_ hn⟩
  rw [← hpow]
  exact pow_dvd_pow _ (Nat.le_of_lt (Nat.lt_pow_self (by omega)))

/-- Every positive power of the roots generates the same ideal as the roots themselves. -/
theorem span_range_pow_compatible_roots (hp : 2 ≤ p)
    (hr : ∀ n, r (n + 1) ^ p = r n) {k : ℕ} (hk : 0 < k) :
    Ideal.span (Set.range fun n ↦ r n ^ k) = Ideal.span (Set.range r) := by
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨n, rfl⟩
    exact Ideal.pow_mem_of_mem _ Ideal.mem_span_range_self k hk
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨n, rfl⟩
    obtain ⟨m, hm⟩ := exists_pow_dvd_of_mem_span_range_compatible_roots hp hr
      (Ideal.mem_span_range_self (x := n)) k
    exact Ideal.mem_of_dvd _ hm Ideal.mem_span_range_self

/-- The ideal generated by a compatible root sequence is idempotent, even when the roots
are zero divisors. -/
theorem isIdempotentElem_span_range_compatible_roots (hp : 2 ≤ p)
    (hr : ∀ n, r (n + 1) ^ p = r n) :
    IsIdempotentElem (Ideal.span (Set.range r)) := by
  apply le_antisymm Ideal.mul_le_left
  apply le_trans (span_range_pow_compatible_roots hp hr (by decide : 0 < 2)).ge
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨n, rfl⟩
  dsimp only
  rw [pow_two]
  exact Ideal.mul_mem_mul Ideal.mem_span_range_self Ideal.mem_span_range_self

/-- Removing an initial segment of a compatible root sequence does not change its ideal. -/
theorem span_range_compatible_roots_shift (hr : ∀ n, r (n + 1) ^ p = r n) (k : ℕ) :
    Ideal.span (Set.range fun n ↦ r (n + k)) = Ideal.span (Set.range r) := by
  apply le_antisymm
  · exact Ideal.span_mono (Set.range_subset_iff.mpr fun n ↦ Set.mem_range_self _)
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨n, rfl⟩
    exact Ideal.mem_of_dvd _ (dvd_of_compatible_roots hr (Nat.le_add_right n k))
      (Ideal.mem_span_range_self (x := n))

end TauCeti
