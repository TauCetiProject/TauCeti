/-!
# Fixed-point ideals of monoid actions on commutative rings

Let a monoid `Γ` act by ring endomorphisms on a commutative ring `A`. This file defines the
**fixed-point ideal** `TauCeti.MulSemiringAction.fixedPointIdeal Γ A`, the ideal of `A` generated by
all displacements `γ • a - a` for `γ : Γ` and `a : A`. A ring homomorphism (or `R`-algebra
homomorphism when `Γ` acts by `R`-algebra endomorphisms) kills `fixedPointIdeal Γ A` precisely when
it is `Γ`-invariant (`fixedPointIdeal_le_ker_iff`, `fixedPointIdeal_le_ker_algHom_iff`).

Geometrically, for `X = Spec A` over `Spec R`, the quotient `A ⧸ fixedPointIdeal Γ A` is the
coordinate ring of the closed subscheme `X^Γ` of fixed points of the induced action of `Γ` on `X`:
for every `R`-algebra `B`, its `B`-valued points are the `Γ`-invariant `B`-valued points of `X`
(`fixedPointQuotientAlgHomEquiv`). Unlike the subalgebra of invariants
`FixedPoints.subalgebra R A Γ` (which is the coordinate ring of the affine quotient `X / Γ`),
`A ⧸ fixedPointIdeal Γ A` cuts out a closed subscheme of `X`. Formation of `fixedPointIdeal`
commutes with arbitrary base change `R → S` (`fixedPointIdeal_rightTensor`,
`tensorQuotientFixedPointIdealAlgEquiv`), and when `Γ` is finite and `A` is finitely generated
(respectively finitely presented) over `R`, the fixed-point ideal is finitely generated
(`fg_fixedPointIdeal`) and its quotient is finitely presented
(`finitePresentation_quotient_fixedPointIdeal`).

This complements `TauCeti.Comodule.fixedPointIdeal` (for coactions of `MonoidAlgebra R M`, i.e.
actions of diagonalizable monoid schemes `D(M)`). Edixhoven's tame smoothness theorem for
`A ⧸ fixedPointIdeal Γ A` is proved in `TauCeti.RingTheory.Smooth.FixedPointIdeal`.

## Main definitions

* `TauCeti.MulSemiringAction.fixedPointIdeal Γ A`: the ideal of `A` generated by all displacements
  `γ • a - a`.
* `TauCeti.MulSemiringAction.fixedPointQuotientAlgHomEquiv R Γ A B`: the bijection between
  `R`-algebra maps `A ⧸ fixedPointIdeal Γ A →ₐ[R] B` and `Γ`-invariant `R`-algebra maps `A →ₐ[R] B`.
* `TauCeti.MulSemiringAction.tensorQuotientFixedPointIdealAlgEquiv R S A Γ`: base-change isomorphism
  `S ⊗[R] (A ⧸ fixedPointIdeal Γ A) ≃ₐ[S] (S ⊗[R] A) ⧸ fixedPointIdeal Γ (S ⊗[R] A)`.

## Main results

* `TauCeti.MulSemiringAction.fixedPointIdeal_le_ker_iff`: a ring homomorphism kills
  `fixedPointIdeal Γ A` if and only if it is `Γ`-invariant.
* `TauCeti.MulSemiringAction.fixedPointIdeal_eq_span_of_adjoin_eq_top`: when `s` generates `A` over
  `R`, the displacements of `s` already span `fixedPointIdeal Γ A`.
* `TauCeti.MulSemiringAction.fg_fixedPointIdeal` and
  `TauCeti.MulSemiringAction.finitePresentation_quotient_fixedPointIdeal`: finite generation of
  `fixedPointIdeal Γ A` and finite presentation of `A ⧸ fixedPointIdeal Γ A` for finite `Γ`.

## References

* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), Propositions 3.1
  and 3.4, pp. 293–295.
-/

public section

open scoped TensorProduct

namespace TauCeti.MulSemiringAction

section Basic

variable {Γ A : Type*} [Monoid Γ] [CommRing A] [MulSemiringAction Γ A]

variable (Γ A) in
/-- The **fixed-point ideal** of a monoid action by ring endomorphisms on a commutative ring `A`:
the ideal generated by all displacements `γ • a - a`. Geometrically, the quotient
`A ⧸ fixedPointIdeal Γ A` is the coordinate ring of the closed subscheme `(Spec A)^Γ` of fixed
points. -/
def fixedPointIdeal : Ideal A :=
  Ideal.span (⋃ γ : Γ, Set.range fun a : A ↦ γ • a - a)

/-- `fixedPointIdeal Γ A` is the ideal spanned by the union of all displacement ranges. -/
theorem fixedPointIdeal_eq_span (Γ A : Type*) [Monoid Γ] [CommRing A] [MulSemiringAction Γ A] :
    fixedPointIdeal Γ A = Ideal.span (⋃ γ : Γ, Set.range fun a : A ↦ γ • a - a) :=
  (rfl)

/-- `fixedPointIdeal Γ A` is the supremum over `γ : Γ` of the displacement ideals of `γ`. -/
theorem fixedPointIdeal_eq_iSup (Γ A : Type*) [Monoid Γ] [CommRing A] [MulSemiringAction Γ A] :
    fixedPointIdeal Γ A = ⨆ γ : Γ, Ideal.span (Set.range fun a : A ↦ γ • a - a) :=
  Ideal.span_iUnion _

/-- Every displacement `γ • a - a` lies in `fixedPointIdeal Γ A`. -/
theorem smul_sub_mem_fixedPointIdeal (γ : Γ) (a : A) :
    γ • a - a ∈ fixedPointIdeal Γ A :=
  Ideal.subset_span (Set.mem_iUnion.mpr ⟨γ, a, rfl⟩)

/-- `fixedPointIdeal Γ A` is the smallest ideal containing every displacement `γ • a - a`. -/
theorem fixedPointIdeal_le_iff {J : Ideal A} :
    fixedPointIdeal Γ A ≤ J ↔ ∀ (γ : Γ) (a : A), γ • a - a ∈ J := by
  rw [fixedPointIdeal_eq_span, Ideal.span_le, Set.iUnion_subset_iff]
  simp [Set.range_subset_iff]

/-- The fixed-point ideal is stable under the action of `Γ`. -/
theorem smul_mem_fixedPointIdeal {x : A} (hx : x ∈ fixedPointIdeal Γ A) (γ : Γ) :
    γ • x ∈ fixedPointIdeal Γ A := by
  simpa only [sub_add_cancel] using add_mem (smul_sub_mem_fixedPointIdeal γ x) hx

/-- Modulo `fixedPointIdeal Γ A`, every element equals its `Γ`-translates. -/
@[simp]
theorem quotientMk_fixedPointIdeal_smul (γ : Γ) (a : A) :
    Ideal.Quotient.mk (fixedPointIdeal Γ A) (γ • a) =
      Ideal.Quotient.mk (fixedPointIdeal Γ A) a :=
  Ideal.Quotient.eq.mpr (smul_sub_mem_fixedPointIdeal γ a)

/-- **Universal property for ring homomorphisms.** A ring homomorphism out of `A` into a semiring
`B` kills `fixedPointIdeal Γ A` if and only if it is invariant under every element of `Γ`. -/
theorem fixedPointIdeal_le_ker_iff {B : Type*} [Semiring B] (φ : A →+* B) :
    fixedPointIdeal Γ A ≤ RingHom.ker φ ↔ ∀ (γ : Γ) (a : A), φ (γ • a) = φ a := by
  rw [fixedPointIdeal_le_iff]
  refine forall₂_congr fun γ a ↦ ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · rw [RingHom.mem_ker] at h
    rw [← sub_add_cancel (γ • a) a, map_add, h, zero_add]
  · rw [RingHom.mem_ker, sub_eq_add_neg, map_add, h, ← map_add, add_neg_cancel, map_zero]

/-- The fixed-point ideal vanishes if and only if `Γ` acts trivially on `A`. -/
@[simp]
theorem fixedPointIdeal_eq_bot_iff :
    fixedPointIdeal Γ A = ⊥ ↔ ∀ (γ : Γ) (a : A), γ • a = a := by
  rw [eq_bot_iff, fixedPointIdeal_le_iff]
  simp [sub_eq_zero]

/-- A subsingleton monoid acts trivially, so its fixed-point ideal is `⊥`. -/
@[simp]
theorem fixedPointIdeal_eq_bot_of_subsingleton [Subsingleton Γ] :
    fixedPointIdeal Γ A = ⊥ :=
  fixedPointIdeal_eq_bot_iff.mpr fun γ a ↦ by rw [Subsingleton.elim γ 1, one_smul]

end Basic

section Algebra

variable {R Γ A : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
  [Monoid Γ] [MulSemiringAction Γ A] [SMulCommClass Γ R A]

/-- **Universal property for algebra homomorphisms.** An `R`-algebra map out of `A` kills
`fixedPointIdeal Γ A` if and only if it is fixed under precomposition with every `γ : Γ`. -/
theorem fixedPointIdeal_le_ker_algHom_iff {B : Type*} [Semiring B] [Algebra R B] (φ : A →ₐ[R] B) :
    fixedPointIdeal Γ A ≤ RingHom.ker φ ↔
      ∀ γ : Γ, φ.comp (MulSemiringAction.toAlgHom R A γ) = φ := by
  rw [← RingHom.ker_coe_toRingHom, fixedPointIdeal_le_ker_iff]
  exact forall_congr' fun γ ↦ ⟨fun h ↦ AlgHom.ext h, fun h a ↦ congr($h a)⟩

variable (R Γ A) in
/-- **Points of the fixed-point quotient.** `R`-algebra homomorphisms out of
`A ⧸ fixedPointIdeal Γ A` into `B` correspond bijectively to `Γ`-invariant `R`-algebra
homomorphisms `A →ₐ[R] B`. -/
def fixedPointQuotientAlgHomEquiv (B : Type*) [Semiring B] [Algebra R B] :
    (A ⧸ fixedPointIdeal Γ A →ₐ[R] B) ≃
      {φ : A →ₐ[R] B // ∀ γ : Γ, φ.comp (MulSemiringAction.toAlgHom R A γ) = φ} where
  toFun ψ := ⟨ψ.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal Γ A)), fun γ ↦ by
    ext a
    simp⟩
  invFun φ := Ideal.Quotient.liftₐ (fixedPointIdeal Γ A) φ.1 fun a ha ↦
    RingHom.mem_ker.mp ((fixedPointIdeal_le_ker_algHom_iff φ.1).mpr φ.2 ha)
  left_inv ψ := Ideal.Quotient.algHom_ext R rfl
  right_inv φ := Subtype.ext (Ideal.Quotient.liftₐ_comp _ _ _)

/-- Evaluating `fixedPointQuotientAlgHomEquiv` precomposes with the quotient map. -/
@[simp]
theorem fixedPointQuotientAlgHomEquiv_apply {B : Type*} [Semiring B] [Algebra R B]
    (ψ : A ⧸ fixedPointIdeal Γ A →ₐ[R] B) :
    (fixedPointQuotientAlgHomEquiv R Γ A B ψ : A →ₐ[R] B) =
      ψ.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal Γ A)) :=
  (rfl)

/-- Evaluating `(fixedPointQuotientAlgHomEquiv ...).symm` on a coset applies the invariant map. -/
@[simp]
theorem fixedPointQuotientAlgHomEquiv_symm_apply_mk {B : Type*} [Semiring B] [Algebra R B]
    (φ : {φ : A →ₐ[R] B // ∀ γ : Γ, φ.comp (MulSemiringAction.toAlgHom R A γ) = φ}) (a : A) :
    (fixedPointQuotientAlgHomEquiv R Γ A B).symm φ (Ideal.Quotient.mk (fixedPointIdeal Γ A) a) =
      φ.1 a :=
  (rfl)

/-- If a subset `s` generates `A` as an `R`-algebra, then the displacements `γ • x - x` for `x ∈ s`
already generate `fixedPointIdeal Γ A` as an ideal of `A`. -/
theorem fixedPointIdeal_eq_span_of_adjoin_eq_top {s : Set A} (hs : Algebra.adjoin R s = ⊤) :
    fixedPointIdeal Γ A = Ideal.span {y : A | ∃ γ : Γ, ∃ x ∈ s, γ • x - x = y} := by
  let J : Ideal A := Ideal.span {y : A | ∃ γ : Γ, ∃ x ∈ s, γ • x - x = y}
  refine le_antisymm (fixedPointIdeal_le_iff.mpr fun γ a ↦ ?_) (Ideal.span_le.mpr ?_)
  · have ha : a ∈ Algebra.adjoin R s := hs ▸ Algebra.mem_top
    induction ha using Algebra.adjoin_induction with
    | mem x hx => exact Ideal.subset_span ⟨γ, x, hx, rfl⟩
    | algebraMap r =>
      have hr : γ • algebraMap R A r = algebraMap R A r :=
        (MulSemiringAction.toAlgHom R A γ).commutes r
      simp [hr]
    | add x y _ _ hx hy =>
      rw [smul_add, add_sub_add_comm]
      exact add_mem hx hy
    | mul x y _ _ hx hy =>
      rw [smul_mul']
      exact J.mul_sub_mul_mem hx hy
  · rintro _ ⟨γ, x, _, rfl⟩
    exact smul_sub_mem_fixedPointIdeal γ x

variable (R Γ A) in
/-- If `Γ` is finite and `A` is a finite-type `R`-algebra, then `fixedPointIdeal Γ A` is a finitely
generated ideal of `A`. -/
theorem fg_fixedPointIdeal [Finite Γ] [Algebra.FiniteType R A] :
    (fixedPointIdeal Γ A).FG := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := A)
  rw [fixedPointIdeal_eq_span_of_adjoin_eq_top hs]
  have hrange : {y : A | ∃ γ : Γ, ∃ x ∈ (s : Set A), γ • x - x = y} =
      Set.range fun p : Γ × s ↦ p.1 • (p.2 : A) - p.2 := by
    ext y
    simp [Prod.exists]
  rw [hrange]
  exact Submodule.fg_def.mpr ⟨_, Set.finite_range _, rfl⟩

/-- If `Γ` is finite and `A` is finitely presented over `R`, then `A ⧸ fixedPointIdeal Γ A` is
finitely presented over `R`. -/
instance finitePresentation_quotient_fixedPointIdeal {R : Type*} [CommRing R]
    [Algebra R A] [SMulCommClass Γ R A] [Finite Γ] [Algebra.FinitePresentation R A] :
    Algebra.FinitePresentation R (A ⧸ fixedPointIdeal Γ A) :=
  Algebra.FinitePresentation.quotient (fg_fixedPointIdeal R Γ A)

end Algebra

section BaseChange

variable (R S A Γ : Type*) [CommRing S] [CommRing A] [Monoid Γ] [MulSemiringAction Γ A]

attribute [local instance] Algebra.TensorProduct.rightMulSemiringAction
attribute [local instance] Algebra.TensorProduct.rightMulSemiringAction_smulCommClass

/-- **Formation of the fixed-point ideal commutes with base change.** For `Γ` acting on `S ⊗[R] A`
through the right tensor factor, `fixedPointIdeal Γ (S ⊗[R] A)` is the extension of
`fixedPointIdeal Γ A` along `includeRight : A →ₐ[R] S ⊗[R] A`. -/
theorem fixedPointIdeal_rightTensor [CommSemiring R] [Algebra R S] [Algebra R A]
    [SMulCommClass Γ R A] :
    fixedPointIdeal Γ (S ⊗[R] A) =
      (fixedPointIdeal Γ A).map
        (Algebra.TensorProduct.includeRight (R := R) (A := S) (B := A)) := by
  let J := (fixedPointIdeal Γ A).map
    (Algebra.TensorProduct.includeRight (R := R) (A := S) (B := A))
  refine le_antisymm (fixedPointIdeal_le_iff.mpr fun γ z ↦ ?_) (Ideal.map_le_iff_le_comap.mpr ?_)
  · induction z using TensorProduct.inductionOn with
    | tmul s a =>
      have h : γ • (s ⊗ₜ[R] a) - s ⊗ₜ[R] a =
          (s ⊗ₜ[R] 1) * Algebra.TensorProduct.includeRight (γ • a - a) := by
        simp only [Algebra.TensorProduct.rightMulSemiringAction_smul_tmul,
          ← TensorProduct.tmul_sub, Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [h]
      exact J.mul_mem_left _ (Ideal.mem_map_of_mem _ (smul_sub_mem_fixedPointIdeal γ a))
    | add x y hx hy =>
      rw [smul_add, add_sub_add_comm]
      exact add_mem hx hy
  · refine fixedPointIdeal_le_iff.mpr fun γ a ↦ Ideal.mem_comap.mpr ?_
    simpa [TensorProduct.tmul_sub] using smul_sub_mem_fixedPointIdeal γ (1 ⊗ₜ[R] a : S ⊗[R] A)

variable [CommRing R] [Algebra R S] [Algebra R A] [SMulCommClass Γ R A]

/-- **Formation of the fixed-point quotient commutes with arbitrary base change.** -/
noncomputable def tensorQuotientFixedPointIdealAlgEquiv :
    S ⊗[R] (A ⧸ fixedPointIdeal Γ A) ≃ₐ[S] (S ⊗[R] A) ⧸ fixedPointIdeal Γ (S ⊗[R] A) :=
  (Algebra.TensorProduct.tensorQuotientEquiv (R := R) S A S (fixedPointIdeal Γ A)).trans
    (Ideal.quotientEquivAlgOfEq S (fixedPointIdeal_rightTensor R S A Γ).symm)

/-- `tensorQuotientFixedPointIdealAlgEquiv` sends `s ⊗ₜ mk a` to `mk (s ⊗ₜ a)`. -/
@[simp]
theorem tensorQuotientFixedPointIdealAlgEquiv_tmul (s : S) (a : A) :
    tensorQuotientFixedPointIdealAlgEquiv R S A Γ
        (s ⊗ₜ[R] Ideal.Quotient.mk (fixedPointIdeal Γ A) a) =
      Ideal.Quotient.mk (fixedPointIdeal Γ (S ⊗[R] A)) (s ⊗ₜ[R] a) :=
  (rfl)

/-- `(tensorQuotientFixedPointIdealAlgEquiv ...).symm` sends `mk (s ⊗ₜ a)` to `s ⊗ₜ mk a`. -/
@[simp]
theorem tensorQuotientFixedPointIdealAlgEquiv_symm_mk_tmul (s : S) (a : A) :
    (tensorQuotientFixedPointIdealAlgEquiv R S A Γ).symm
        (Ideal.Quotient.mk (fixedPointIdeal Γ (S ⊗[R] A)) (s ⊗ₜ[R] a)) =
      s ⊗ₜ[R] Ideal.Quotient.mk (fixedPointIdeal Γ A) a :=
  (rfl)

end BaseChange

end TauCeti.MulSemiringAction
