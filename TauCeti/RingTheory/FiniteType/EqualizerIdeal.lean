module

public import Mathlib.RingTheory.FinitePresentation

/-!
# Finite generation of equalizer ideals of algebra homomorphisms

Let `A` be an `R`-algebra generated by a subset `s`, and let `f g : A →ₐ[R] B` be `R`-algebra
homomorphisms into a commutative `R`-algebra `B`. Modulo the ideal `J` of `B` generated by the
differences `f x - g x` for `x ∈ s`, the two composites `A →ₐ[R] B ⧸ J` agree on `s`, hence on
`Algebra.adjoin R s = ⊤`. Therefore the ideal generated by all differences `f a - g a` (`a : A`)
already equals `J`.

When `A` is of finite type over `R`, it follows that the ideal generated by all differences
`f a - g a` is finitely generated, even when `B` is not Noetherian. The same holds for the
supremum of such difference ideals over a finite index type `ι`. Consequently, if `B` is of
finite presentation over `R`, the coequalizer quotient of `B` by a finite family of pairs of
morphisms from finite-type `R`-algebras is again of finite presentation over `R`.

## Main results

* `AlgHom.span_range_sub_eq_of_adjoin_eq_top`: if `s` generates `A` over `R`, the ideal of `B`
  spanned by all `f a - g a` equals the ideal spanned by `{f x - g x | x ∈ s}`.
* `AlgHom.fg_span_range_sub`: if `A` is of finite type over `R`, the ideal spanned by all
  `f a - g a` is finitely generated.
* `AlgHom.fg_iSup_span_range_sub`: the supremum over a finite index type of such difference ideals
  is finitely generated.
* `AlgHom.finitePresentation_quotient_span_range_sub` and
  `AlgHom.finitePresentation_quotient_iSup_span_range_sub`: quotienting a finitely presented
  `R`-algebra by one or finitely many such difference ideals preserves finite presentation.
-/

public section

namespace AlgHom

section FiniteType

variable {R A B : Type*} [CommSemiring R] [Semiring A] [Algebra R A] [CommRing B] [Algebra R B]

/-- If `s` generates `A` as an `R`-algebra, then for any two `R`-algebra homomorphisms
`f g : A →ₐ[R] B` into a commutative `R`-algebra `B`, the ideal of `B` generated by all
differences `f a - g a` is generated by the differences on `s`. -/
theorem span_range_sub_eq_of_adjoin_eq_top (f g : A →ₐ[R] B) {s : Set A}
    (hs : Algebra.adjoin R s = ⊤) :
    Ideal.span (Set.range fun a : A ↦ f a - g a) =
      Ideal.span ((fun a : A ↦ f a - g a) '' s) := by
  refine le_antisymm (Ideal.span_le.mpr ?_)
    (Ideal.span_mono (Set.image_subset_range (fun a : A ↦ f a - g a) s))
  rintro _ ⟨a, rfl⟩
  set J : Ideal B := Ideal.span ((fun x : A ↦ f x - g x) '' s)
  let π : B →ₐ[R] B ⧸ J := Ideal.Quotient.mkₐ R J
  have hle : (⊤ : Subalgebra R A) ≤ (π.comp f).equalizer (π.comp g) := by
    rw [← hs, Algebra.adjoin_le_iff]
    intro x hx
    rw [SetLike.mem_coe, mem_equalizer, comp_apply, comp_apply]
    exact Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨x, hx, rfl⟩)
  have hπ : π (f a) = π (g a) := mem_equalizer _ _ a |>.mp (hle Algebra.mem_top)
  exact (Ideal.Quotient.eq_zero_iff_mem (I := J)).mp (by
    rw [← Ideal.Quotient.mkₐ_eq_mk R, map_sub, sub_eq_zero]
    exact hπ)

/-- If `A` is of finite type over `R`, the ideal of `B` generated by all differences `f a - g a`
of two `R`-algebra homomorphisms `f g : A →ₐ[R] B` is finitely generated. -/
theorem fg_span_range_sub [Algebra.FiniteType R A] (f g : A →ₐ[R] B) :
    (Ideal.span (Set.range fun a : A ↦ f a - g a)).FG := by
  classical
  obtain ⟨s, hs⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra R A).FG)
  refine ⟨s.image fun a : A ↦ f a - g a, ?_⟩
  rw [Finset.coe_image, ← span_range_sub_eq_of_adjoin_eq_top f g hs]

/-- For a finite family of pairs of `R`-algebra homomorphisms out of finite-type `R`-algebras into
`B`, the supremum of their difference ideals in `B` is finitely generated. -/
theorem fg_iSup_span_range_sub {ι : Sort*} [_root_.Finite ι] {A : ι → Type*}
    [∀ i, Semiring (A i)] [∀ i, Algebra R (A i)] [∀ i, Algebra.FiniteType R (A i)]
    (f g : ∀ i, A i →ₐ[R] B) :
    (⨆ i, Ideal.span (Set.range fun a : A i ↦ f i a - g i a)).FG :=
  Submodule.fg_iSup _ fun i ↦ (f i).fg_span_range_sub (g i)

end FiniteType

section FinitePresentation

variable {R A B : Type*} [CommRing R] [Semiring A] [Algebra R A] [CommRing B] [Algebra R B]

/-- Quotienting a finitely presented `R`-algebra `B` by the coequalizer ideal of two `R`-algebra
homomorphisms out of a finite-type `R`-algebra produces a finitely presented `R`-algebra. -/
theorem finitePresentation_quotient_span_range_sub [Algebra.FiniteType R A]
    [Algebra.FinitePresentation R B] (f g : A →ₐ[R] B) :
    Algebra.FinitePresentation R (B ⧸ Ideal.span (Set.range fun a : A ↦ f a - g a)) :=
  Algebra.FinitePresentation.quotient (f.fg_span_range_sub g)

/-- Quotienting a finitely presented `R`-algebra `B` by the coequalizer ideal of a finite family of
pairs of `R`-algebra homomorphisms out of finite-type `R`-algebras produces a finitely presented
`R`-algebra. -/
theorem finitePresentation_quotient_iSup_span_range_sub {ι : Sort*} [_root_.Finite ι]
    {A : ι → Type*} [∀ i, Semiring (A i)] [∀ i, Algebra R (A i)] [∀ i, Algebra.FiniteType R (A i)]
    [Algebra.FinitePresentation R B] (f g : ∀ i, A i →ₐ[R] B) :
    Algebra.FinitePresentation R
      (B ⧸ ⨆ i, Ideal.span (Set.range fun a : A i ↦ f i a - g i a)) :=
  Algebra.FinitePresentation.quotient (fg_iSup_span_range_sub f g)

end FinitePresentation

end AlgHom
