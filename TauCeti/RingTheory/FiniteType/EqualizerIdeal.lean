module

public import Mathlib.RingTheory.FinitePresentation

/-!
# Finite generation of equalizer ideals of algebra homomorphisms

If `A` is generated over `R` by `s` and `f g : A →ₐ[R] B` are `R`-algebra homomorphisms into a
commutative `R`-algebra `B`, the ideal generated by all differences `f a - g a` equals the ideal
generated by `{f x - g x | x ∈ s}`. Hence finite type of `A` implies finite generation of single and
finitely-indexed difference ideals, and finite presentation of `B` passes to the quotient.

## Main results

* `AlgHom.span_range_sub_eq_of_adjoin_eq_top`, `AlgHom.fg_span_range_sub`,
  `AlgHom.finitePresentation_quotient_span_range_sub`: single pair `f g : A →ₐ[R] B`.
* `TauCeti.fg_iSup_span_range_sub`, `TauCeti.finitePresentation_quotient_iSup_span_range_sub`:
  finitely indexed families `f g : ∀ i, A i →ₐ[R] B`.
-/

public section

namespace AlgHom

section FiniteType

variable {R A B : Type*} [CommSemiring R] [Semiring A] [Algebra R A] [CommRing B] [Algebra R B]

/-- If `Algebra.adjoin R s = ⊤`, the ideal of all `f a - g a` is spanned by differences on `s`. -/
theorem span_range_sub_eq_of_adjoin_eq_top (f g : A →ₐ[R] B) {s : Set A}
    (hs : Algebra.adjoin R s = ⊤) :
    Ideal.span (Set.range fun a : A ↦ f a - g a) = Ideal.span ((fun a : A ↦ f a - g a) '' s) := by
  refine le_antisymm (Ideal.span_le.mpr ?_)
    (Ideal.span_mono (Set.image_subset_range (fun a : A ↦ f a - g a) s))
  rintro _ ⟨a, rfl⟩
  let π := Ideal.Quotient.mkₐ R (Ideal.span ((fun x : A ↦ f x - g x) '' s))
  have hle : (⊤ : Subalgebra R A) ≤ (π.comp f).equalizer (π.comp g) := by
    rw [← hs, Algebra.adjoin_le_iff]
    exact fun x hx ↦ Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨x, hx, rfl⟩)
  exact Ideal.Quotient.eq.mp ((mem_equalizer _ _ a).mp (hle Algebra.mem_top))

/-- If `A` is finite type over `R`, the ideal spanned by all `f a - g a` is finitely generated. -/
theorem fg_span_range_sub [Algebra.FiniteType R A] (f g : A →ₐ[R] B) :
    (Ideal.span (Set.range fun a : A ↦ f a - g a)).FG := by
  classical
  obtain ⟨s, hs⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra R A).FG)
  exact ⟨s.image fun a : A ↦ f a - g a, by
    rw [Finset.coe_image, ← span_range_sub_eq_of_adjoin_eq_top f g hs]⟩

end FiniteType

section FinitePresentation

variable {R A B : Type*} [CommRing R] [Semiring A] [Algebra R A] [CommRing B] [Algebra R B]

/-- Quotienting finitely presented `B` by the difference ideal of `f g` preserves FP. -/
theorem finitePresentation_quotient_span_range_sub [Algebra.FiniteType R A]
    [Algebra.FinitePresentation R B] (f g : A →ₐ[R] B) :
    Algebra.FinitePresentation R (B ⧸ Ideal.span (Set.range fun a : A ↦ f a - g a)) :=
  Algebra.FinitePresentation.quotient (f.fg_span_range_sub g)

end FinitePresentation

end AlgHom

namespace TauCeti

/-- For a finite family `f g` out of finite-type `R`-algebras, `⨆ i, ⟨f i a - g i a⟩` is FG. -/
theorem fg_iSup_span_range_sub {R B : Type*} [CommSemiring R] [CommRing B] [Algebra R B]
    {ι : Sort*} [Finite ι] {A : ι → Type*}
    [∀ i, Semiring (A i)] [∀ i, Algebra R (A i)] [∀ i, Algebra.FiniteType R (A i)]
    (f g : ∀ i, A i →ₐ[R] B) :
    (⨆ i, Ideal.span (Set.range fun a : A i ↦ f i a - g i a)).FG :=
  Submodule.fg_iSup _ fun i ↦ (f i).fg_span_range_sub (g i)

/-- Quotienting finitely presented `B` by a finite supremum of difference ideals preserves FP. -/
theorem finitePresentation_quotient_iSup_span_range_sub {R B : Type*} [CommRing R] [CommRing B]
    [Algebra R B] {ι : Sort*} [Finite ι] {A : ι → Type*}
    [∀ i, Semiring (A i)] [∀ i, Algebra R (A i)] [∀ i, Algebra.FiniteType R (A i)]
    [Algebra.FinitePresentation R B] (f g : ∀ i, A i →ₐ[R] B) :
    Algebra.FinitePresentation R
      (B ⧸ ⨆ i, Ideal.span (Set.range fun a : A i ↦ f i a - g i a)) :=
  Algebra.FinitePresentation.quotient (fg_iSup_span_range_sub f g)

end TauCeti
