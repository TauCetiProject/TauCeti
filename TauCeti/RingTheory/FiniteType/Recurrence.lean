module

public import Mathlib.RingTheory.FiniteType

/-!
# Finite generation from an eventual recurrence on a spanning family of submodules

Let `A` be an `R`-algebra, `(Aₙ)_{n ∈ ℕ}` a family of `R`-submodules whose sum is `A`, and `B`
an `R`-subalgebra of `A`. Suppose that, from some index `N` onward, `Aₙ₊₁ ⊆ B · Aₙ`. Then the
pieces of indices at most `N` span `A` as a `B`-module. Neither independence of the pieces nor
compatibility of multiplication with the indexing is used, so the family may be the pieces of
a direct-sum decomposition, such as a grading, or an exhaustive filtration. If the sum of these
pieces is a finite `R`-module, `A` is a finite `B`-module. If a submodule `U` gives the
recurrence and its sum with the initial pieces is finite over `R`, then `A` is of finite type
over `R`.

For section rings of divisors on curves, a function pencil gives the recurrence with `B`
the subalgebra generated by the two sections of the pencil, and the family is the grading by
degree. The result here converts that recurrence into finite generation without requiring
generation in degree one, or imposing a Noetherian hypothesis on the whole section ring.

## Main results

* `TauCeti.span_eq_top_of_le_mul`: the initial pieces span `A` over `B`.
* `TauCeti.finite_of_le_mul`: `A` is a finite `B`-module when the initial pieces are finite.
* `TauCeti.finiteType_of_le_mul`: `A` is of finite type when `U` and the initial pieces are finite.
-/

public section

namespace TauCeti

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R A]
    (𝒜 : ℕ → Submodule R A) (h𝒜 : ⨆ n, 𝒜 n = ⊤) (N : ℕ)
include h𝒜

/-- If every piece of a spanning family above index `N` lies in the product of `B` with the
preceding piece, the pieces of indices at most `N` span the whole algebra over `B`. -/
theorem span_eq_top_of_le_mul (B : Subalgebra R A)
    (hstep : ∀ n, N ≤ n → 𝒜 (n + 1) ≤ B.toSubmodule * 𝒜 n) :
    Submodule.span B (↑(⨆ i : Fin (N + 1), 𝒜 i) : Set A) = ⊤ := by
  let M := Submodule.span B (↑(⨆ i : Fin (N + 1), 𝒜 i) : Set A)
  have hinit (n : ℕ) (hn : n ≤ N) : 𝒜 n ≤ M.restrictScalars R := fun _ hx ↦
    Submodule.subset_span (le_iSup (fun i : Fin (N + 1) ↦ 𝒜 i) ⟨n, by omega⟩ hx)
  have hpiece (n : ℕ) : 𝒜 n ≤ M.restrictScalars R := by
    obtain hn | hn := le_total n N
    · exact hinit n hn
    induction n, hn using Nat.le_induction with
    | base => exact hinit N le_rfl
    | succ n hn ih =>
      exact (hstep n hn).trans <| Submodule.mul_le.mpr fun b hb x hx ↦
        M.smul_mem (⟨b, hb⟩ : B) (ih hx)
  rw [← Submodule.restrictScalars_eq_top_iff R, eq_top_iff, ← h𝒜]
  exact iSup_le hpiece

/-- An eventual recurrence `Aₙ₊₁ ⊆ B · Aₙ` on a spanning family makes the algebra finite over
`B`, provided the sum of the pieces of indices at most the recurrence threshold is finite
over `R`. -/
theorem finite_of_le_mul (B : Subalgebra R A)
    (hfinite : (⨆ i : Fin (N + 1), 𝒜 i).FG)
    (hstep : ∀ n, N ≤ n → 𝒜 (n + 1) ≤ B.toSubmodule * 𝒜 n) :
    Module.Finite B A :=
  .of_fg_top <| span_eq_top_of_le_mul 𝒜 h𝒜 N B hstep ▸ hfinite.span

/-- An eventual recurrence `Aₙ₊₁ ⊆ U · Aₙ` on a spanning family makes the algebra of finite
type, provided the sum of `U` and the initial pieces is finite over `R`.
The multiplying submodule need not be one of the pieces. -/
theorem finiteType_of_le_mul (U : Submodule R A)
    (hfinite : (U ⊔ ⨆ i : Fin (N + 1), 𝒜 i).FG)
    (hstep : ∀ n, N ≤ n → 𝒜 (n + 1) ≤ U * 𝒜 n) :
    Algebra.FiniteType R A := by
  obtain ⟨s, hs⟩ := hfinite
  let B := Algebra.adjoin R (s : Set A)
  -- `B` contains `U` and the initial pieces, as it contains their generators `s`.
  have hgen : U ⊔ (⨆ i : Fin (N + 1), 𝒜 i) ≤ B.toSubmodule :=
    hs ▸ Submodule.span_le.mpr Algebra.subset_adjoin
  have hspan := span_eq_top_of_le_mul 𝒜 h𝒜 N B fun n hn ↦
    (hstep n hn).trans (mul_le_mul_left (le_sup_left.trans hgen) (𝒜 n))
  refine ⟨s, top_unique fun x _ ↦ ?_⟩
  -- `x` is a `B`-linear combination of elements of the initial pieces, all of which lie in `B`.
  have hx : x ∈ Submodule.span B (↑(⨆ i : Fin (N + 1), 𝒜 i) : Set A) := hspan ▸ trivial
  exact Submodule.span_induction (fun _ hx ↦ le_sup_right.trans hgen hx) B.zero_mem
    (fun _ _ _ _ hx hy ↦ B.add_mem hx hy) (fun b _ _ hx ↦ B.mul_mem b.property hx) hx

end TauCeti
