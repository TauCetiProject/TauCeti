module

public import Mathlib.Algebra.Algebra.Subalgebra.Pi
public import Mathlib.RingTheory.FiniteType

/-!
# Finite products of finite-type algebras

A finite product of finitely generated `R`-subalgebras is finitely generated, generated by the
coordinate embeddings of `1` together with finite generating sets of the factors. Including `1`
in each coordinate supplies the orthogonal idempotents `Pi.single i 1`, from which every
coordinate scalar `Pi.single i (algebraMap R (A i) r) = r • Pi.single i 1` is recovered.

Consequently, `Algebra.FiniteType` is preserved by finite `Pi` types. Finiteness of the index
type is necessary: over any field `k`, `ℕ → k` has uncountable vector-space dimension, whereas
every finitely generated `k`-algebra has countable dimension.

## Main results

* `Subalgebra.FG.pi`: a `Pi` product over `Set.univ` of finitely generated subalgebras indexed by
  a finite type is finitely generated.
* `Algebra.FiniteType.pi`: a finite product `∀ i, A i` of finite-type `R`-algebras is of finite
  type over `R`.
-/

public section

/-- A finite product of finitely generated `R`-subalgebras is finitely generated. -/
theorem Subalgebra.FG.pi {R ι : Type*} [CommSemiring R] [Finite ι] {A : ι → Type*}
    [∀ i, Semiring (A i)] [∀ i, Algebra R (A i)] {S : ∀ i, Subalgebra R (A i)}
    (hS : ∀ i, (S i).FG) : (Subalgebra.pi Set.univ S).FG := by
  classical
  let _ := Fintype.ofFinite ι
  choose t ht using hS
  let gen : Finset (∀ i, A i) :=
    Finset.univ.biUnion fun i ↦ (insert 1 (t i)).image (Pi.single i)
  refine ⟨gen, le_antisymm ?_ ?_⟩
  · rw [Algebra.adjoin_le_iff]
    intro f hf j _
    rcases Finset.mem_biUnion.mp (Finset.mem_coe.mp hf) with ⟨i, -, hfi⟩
    rcases Finset.mem_image.mp hfi with ⟨y, hy, rfl⟩
    obtain rfl | hji := eq_or_ne j i
    · rw [Pi.single_eq_same]
      rcases Finset.mem_insert.mp hy with rfl | hyt
      · exact (S j).one_mem
      · exact (ht j ▸ Algebra.subset_adjoin hyt : y ∈ S j)
    · rw [Pi.single_eq_of_ne hji]
      exact (S j).zero_mem
  · set B := Algebra.adjoin R (gen : Set (∀ i, A i))
    have hle (i : ι) {y : A i} (hy : y ∈ S i) : Pi.single i y ∈ B := by
      refine Algebra.adjoin_mono ?_
        (Algebra.mem_adjoin_of_map_mul R (f := LinearMap.single R A i) (Pi.single_mul i)
          (ht i ▸ hy))
      rintro _ ⟨z, hz, rfl⟩
      have hz' : z ∈ insert 1 (t i) := by
        rcases hz with hzt | rfl
        · exact Finset.mem_insert_of_mem hzt
        · exact Finset.mem_insert_self 1 (t i)
      exact Finset.mem_coe.mpr
        (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, Finset.mem_image_of_mem _ hz'⟩)
    intro x hx
    exact Finset.univ_sum_single x ▸ B.sum_mem fun i _ ↦ hle i (hx i trivial)

/-- A finite product of finite-type `R`-algebras is of finite type over `R`. -/
instance Algebra.FiniteType.pi {R ι : Type*} [CommSemiring R] [Finite ι] {A : ι → Type*}
    [∀ i, Semiring (A i)] [∀ i, Algebra R (A i)] [∀ i, Algebra.FiniteType R (A i)] :
    Algebra.FiniteType R (∀ i, A i) :=
  ⟨Subalgebra.pi_top (R := R) (S := A) Set.univ ▸
    Subalgebra.FG.pi fun _ ↦ Algebra.FiniteType.out⟩
