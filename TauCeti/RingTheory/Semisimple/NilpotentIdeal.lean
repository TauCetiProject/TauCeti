module

public import Mathlib.RingTheory.SimpleModule.Basic
import Mathlib.RingTheory.Nilpotent.Basic

/-!
# Nil left ideals of a semisimple ring

A semisimple ring has no nonzero left ideal all of whose elements are nilpotent; in particular it
has no nonzero square-zero left ideal. This is the standard way a semisimple ring is used to rule
out a degenerate case: one produces a left ideal on which multiplication vanishes identically and
concludes that the ideal was zero all along.

The reason is that every left ideal of a semisimple ring is generated by an idempotent
(`IsSemisimpleRing.ideal_eq_span_idempotent`), and a nilpotent idempotent is zero.

The hypothesis is spelled out elementwise rather than as an equation between submodules, because
a left ideal of a noncommutative ring is a `Submodule R R` and carries no multiplication of its
own. A square-zero left ideal `I` meets it through `x ^ 2 = x * x = 0` for `x ∈ I`.

## Main results

* `Submodule.eq_bot_of_forall_isNilpotent`: a left ideal of a semisimple ring whose elements are
  all nilpotent is the zero ideal.
-/

public section

namespace Submodule

variable {R : Type*} [Ring R] [IsSemisimpleRing R]

/-- **A nil left ideal of a semisimple ring is zero.** In particular so is a square-zero left
ideal, one in which `x * y = 0` for all `x` and `y`. -/
theorem eq_bot_of_forall_isNilpotent {I : Submodule R R} (h : ∀ x ∈ I, IsNilpotent x) :
    I = ⊥ := by
  obtain ⟨e, he, rfl⟩ := IsSemisimpleRing.ideal_eq_span_idempotent I
  simpa using IsIdempotentElem.eq_zero_of_isNilpotent he (h e (Ideal.mem_span_singleton_self e))

end Submodule
