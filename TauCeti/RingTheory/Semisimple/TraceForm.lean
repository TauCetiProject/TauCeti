module

public import Mathlib.LinearAlgebra.Matrix.ToLinearEquiv
public import Mathlib.LinearAlgebra.Trace
public import Mathlib.RingTheory.SimpleModule.Basic
import TauCeti.RingTheory.Jacobson.FiniteOverArtinian

/-!
# The regular trace form and semisimplicity

A finite-dimensional algebra `A` over a field `K`, not necessarily commutative, carries the
**regular trace form** `(x, y) ↦ tr_K(z ↦ x y z)`, the trace of left multiplication by the product.
This file proves the trace-form criterion for semisimplicity:

* over any field, if the regular trace form is nondegenerate then `A` is semisimple;
* over a field of characteristic zero the converse holds, so there semisimplicity is exactly the
  nondegeneracy of the regular trace form.

The first statement holds because an element `x` of the Jacobson radical makes every `y x`
nilpotent, the radical being a nilpotent ideal, so the trace of left multiplication by `y x`
vanishes for every `y`. The second uses that the elements `x` with `tr(L_{yx}) = 0` for all `y`
form a left ideal, which in a semisimple ring is generated by an idempotent `e`. Left
multiplication by `e` is then an idempotent operator of trace `0`; in characteristic zero its
trace is its rank, so it is zero, and so is `e`.

In characteristic `p` the converse fails: the matrix algebra `Matrix (Fin p) (Fin p) 𝔽_p` is
simple, yet its regular trace form `(x, y) ↦ p · tr(x y)` vanishes identically.

Expanded in a basis, nondegeneracy is the nonvanishing of the Gram determinant of the trace form,
the discriminant of the algebra. This is how the criterion is used for algebras whose structure
constants depend on a parameter, such as the Brauer algebras: the discriminant is then a polynomial
in the parameter, and the algebra is semisimple wherever that polynomial does not vanish.

## Main results

* `TauCeti.trace_mulLeft_mul_eq_zero_of_mem_jacobson`: an element of the Jacobson radical is in
  the kernel of the regular trace form.
* `TauCeti.isSemisimpleRing_of_forall_trace_mulLeft_mul_eq_zero`: **a finite-dimensional algebra
  with nondegenerate regular trace form is semisimple.**
* `TauCeti.eq_zero_of_forall_trace_mulLeft_mul_eq_zero`: in characteristic zero, the regular
  trace form of a finite-dimensional semisimple algebra is nondegenerate.
* `TauCeti.isSemisimpleRing_iff_forall_trace_mulLeft_mul_eq_zero`: **in characteristic zero, a
  finite-dimensional algebra is semisimple exactly when its regular trace form is nondegenerate.**
* `TauCeti.isSemisimpleRing_iff_det_trace_mulLeft_ne_zero`: the same in terms of the Gram
  determinant of the trace form in a basis, with
  `TauCeti.isSemisimpleRing_of_det_trace_mulLeft_ne_zero` the implication valid over every field.

## References

* C. W. Curtis and I. Reiner, *Representation theory of finite groups and associative algebras*,
  Interscience (1962), §26.
* R. S. Pierce, *Associative algebras*, Graduate Texts in Mathematics 88, Springer (1982), §10.2.
-/

public section

open LinearMap Module

namespace TauCeti

variable {K A : Type*} [Field K] [Ring A] [Algebra K A]

variable (K A) in
/-- The trace of left multiplication, `a ↦ tr(L_a)`, as a linear functional. -/
private noncomputable def mulLeftTrace : A →ₗ[K] K where
  toFun a := trace K A (mulLeft K a)
  map_add' a b := by
    rw [← map_add]
    exact congrArg _ (LinearMap.ext fun z => add_mul a b z)
  map_smul' c a := by
    rw [RingHom.id_apply, smul_eq_mul, ← smul_eq_mul, ← map_smul]
    exact congrArg _ (LinearMap.ext fun z => smul_mul_assoc c a z)

private theorem mulLeftTrace_apply (a : A) : mulLeftTrace K A a = trace K A (mulLeft K a) := (rfl)

variable [FiniteDimensional K A]

/-- **An element of the Jacobson radical lies in the kernel of the regular trace form**: if `x` is
in the Jacobson radical of a finite-dimensional algebra, then `tr(L_{yx}) = 0` for every `y`. -/
theorem trace_mulLeft_mul_eq_zero_of_mem_jacobson {x : A} (hx : x ∈ Ring.jacobson A) (y : A) :
    trace K A (mulLeft K (y * x)) = 0 := by
  obtain ⟨m, hm⟩ := isNilpotent_jacobson (K := K) (A := A)
  have hyx : IsNilpotent (y * x) := by
    refine ⟨m, ?_⟩
    have hpow := Ideal.pow_mem_pow ((Ring.jacobson A).smul_mem y hx) m
    rwa [hm, Ideal.zero_eq_bot, Ideal.mem_bot, smul_eq_mul] at hpow
  have hL : IsNilpotent (mulLeft K (y * x)) := by
    obtain ⟨n, hn⟩ := hyx
    exact ⟨n, by rw [pow_mulLeft, hn, mulLeft_zero_eq_zero]⟩
  exact (isNilpotent_trace_of_isNilpotent hL).eq_zero

/-- **A finite-dimensional algebra whose regular trace form is nondegenerate is semisimple**: if
the only `x` with `tr(L_{yx}) = 0` for every `y` is `x = 0`, then `A` is semisimple. This holds
over every field. -/
theorem isSemisimpleRing_of_forall_trace_mulLeft_mul_eq_zero
    (h : ∀ x : A, (∀ y : A, trace K A (mulLeft K (y * x)) = 0) → x = 0) : IsSemisimpleRing A := by
  rw [isSemisimpleRing_iff_jacobson_eq_bot (K := K)]
  exact eq_bot_iff.mpr fun x hx =>
    (Submodule.mem_bot _).mpr (h x (trace_mulLeft_mul_eq_zero_of_mem_jacobson hx))

variable (K) in
/-- The kernel of the regular trace form, `{x | ∀ y, tr(L_{yx}) = 0}`, as a left ideal. -/
private def traceFormKer : Submodule A A where
  carrier := {x | ∀ y : A, trace K A (mulLeft K (y * x)) = 0}
  add_mem' {x x'} hx hx' y := by
    rw [← mulLeftTrace_apply, mul_add, map_add, mulLeftTrace_apply, mulLeftTrace_apply, hx y,
      hx' y, add_zero]
  zero_mem' y := by rw [← mulLeftTrace_apply, mul_zero, map_zero]
  smul_mem' c x hx y := by rw [smul_eq_mul, ← mul_assoc]; exact hx (y * c)

/-- **In characteristic zero, the regular trace form of a semisimple algebra is nondegenerate**:
if `tr(L_{yx}) = 0` for every `y`, then `x = 0`. -/
theorem eq_zero_of_forall_trace_mulLeft_mul_eq_zero [CharZero K] [IsSemisimpleRing A] {x : A}
    (h : ∀ y : A, trace K A (mulLeft K (y * x)) = 0) : x = 0 := by
  obtain ⟨e, he, hspan⟩ := IsSemisimpleRing.ideal_eq_span_idempotent (traceFormKer K (A := A))
  have hmem (z : A) : z ∈ traceFormKer K (A := A) ↔ ∃ a, a * e = z := by
    rw [hspan, Ideal.mem_span_singleton']
  obtain ⟨a, rfl⟩ := (hmem x).mp h
  -- left multiplication by `e` is idempotent with trace `tr(L_{1 e}) = 0`
  have hLe : IsIdempotentElem (mulLeft K e) := by
    rw [IsIdempotentElem, Module.End.mul_eq_comp, ← mulLeft_mul, he.eq]
  have htr : trace K A (mulLeft K e) = 0 := by
    simpa using (hmem e).mpr ⟨1, one_mul e⟩ 1
  have he0 : e = 0 := by
    simpa using congr($(hLe.eq_zero_of_trace_eq_zero htr) (1 : A))
  rw [he0, mul_zero]

/-- **The trace-form criterion for semisimplicity**: over a field of characteristic zero, a
finite-dimensional algebra is semisimple exactly when its regular trace form is nondegenerate,
that is, when `x = 0` is the only element with `tr(L_{yx}) = 0` for every `y`. -/
theorem isSemisimpleRing_iff_forall_trace_mulLeft_mul_eq_zero [CharZero K] :
    IsSemisimpleRing A ↔ ∀ x : A, (∀ y : A, trace K A (mulLeft K (y * x)) = 0) → x = 0 :=
  ⟨fun _ _ => eq_zero_of_forall_trace_mulLeft_mul_eq_zero,
    isSemisimpleRing_of_forall_trace_mulLeft_mul_eq_zero⟩

section Basis

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

omit [FiniteDimensional K A] [DecidableEq ι] in
/-- The regular trace form vanishes against `x` exactly when its Gram matrix in a basis kills the
coordinate vector of `x`. -/
private theorem forall_trace_mulLeft_mul_eq_zero_iff (b : Basis ι K A) (x : A) :
    (∀ y : A, trace K A (mulLeft K (y * x)) = 0) ↔
      (Matrix.of fun i j => trace K A (mulLeft K (b i * b j))).mulVec (b.equivFun x) = 0 := by
  -- the functional `y ↦ tr(L_{yx})` vanishes once it vanishes on the basis
  let f : A →ₗ[K] K := mulLeftTrace K A ∘ₗ mulRight K x
  have hf (y : A) : f y = trace K A (mulLeft K (y * x)) := (rfl)
  have hrow (i : ι) : f (b i) =
      (Matrix.of fun i j => trace K A (mulLeft K (b i * b j))).mulVec (b.equivFun x) i := by
    have hx : b i * x = ∑ j, b.equivFun x j • (b i * b j) := by
      conv_lhs => rw [← b.sum_equivFun x, Finset.mul_sum]
      simp_rw [mul_smul_comm]
    rw [hf, ← mulLeftTrace_apply, hx, map_sum]
    simp [Matrix.mulVec, dotProduct, mulLeftTrace_apply, mul_comm]
  constructor
  · intro h
    ext i
    rw [← hrow, hf, h, Pi.zero_apply]
  · intro h y
    have hf0 : f = 0 := b.ext fun i => by rw [hrow, h, Pi.zero_apply, LinearMap.zero_apply]
    rw [← hf, hf0, LinearMap.zero_apply]

omit [FiniteDimensional K A] in
/-- **An algebra is semisimple when the Gram determinant of its regular trace
form in some finite basis is nonzero.** This holds over every field. -/
theorem isSemisimpleRing_of_det_trace_mulLeft_ne_zero (b : Basis ι K A)
    (h : (Matrix.of fun i j => trace K A (mulLeft K (b i * b j))).det ≠ 0) :
    IsSemisimpleRing A :=
  have := Module.Finite.of_basis b
  isSemisimpleRing_of_forall_trace_mulLeft_mul_eq_zero fun x hx =>
    b.equivFun.map_eq_zero_iff.mp (Matrix.eq_zero_of_mulVec_eq_zero h
      ((forall_trace_mulLeft_mul_eq_zero_iff b x).mp hx))

omit [FiniteDimensional K A] in
/-- **The discriminant criterion for semisimplicity**: over a field of characteristic zero, an
algebra with a finite basis is semisimple exactly when the Gram determinant of its regular trace
form in a basis, `det (tr(L_{bᵢ bⱼ}))`, is nonzero. -/
theorem isSemisimpleRing_iff_det_trace_mulLeft_ne_zero [CharZero K] (b : Basis ι K A) :
    IsSemisimpleRing A ↔
      (Matrix.of fun i j => trace K A (mulLeft K (b i * b j))).det ≠ 0 := by
  have := Module.Finite.of_basis b
  refine ⟨fun _ hdet => ?_, isSemisimpleRing_of_det_trace_mulLeft_ne_zero b⟩
  obtain ⟨v, hv, hmul⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
  refine hv (b.equivFun.symm.injective ?_)
  rw [map_zero]
  refine eq_zero_of_forall_trace_mulLeft_mul_eq_zero
    ((forall_trace_mulLeft_mul_eq_zero_iff b _).mpr ?_)
  rwa [LinearEquiv.apply_symm_apply]

end Basis

end TauCeti
