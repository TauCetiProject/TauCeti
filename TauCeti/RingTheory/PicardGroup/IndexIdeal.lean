/-!
# The index ideal of a map of lines

For a linear map `f : L → N` of modules over a commutative semiring `R`, the **index ideal**
`f.indexIdeal` is the image of the evaluation map `Nᵛ ⊗ L → R`, `φ ⊗ x ↦ φ (f x)`: the ideal
spanned by the values of linear forms on `N` along `f`. For a map `R → R` it is the principal
ideal generated by `f 1`. So for a map of lines, that is of invertible modules, it is generated,
wherever both lines are trivial, by the scalar by which `f` acts; this scalar depends on the
trivializations only up to units.

The construction makes sense for arbitrary modules, and it includes zero maps, whose index ideal
is `0`. Its formation is invariant under isomorphisms of the source and of the target, and it
commutes with arbitrary base change when the target is projective.

If `f` is injective and `N` is invertible, the evaluation map is injective as well, so it
identifies `Nᵛ ⊗ L` with `f.indexIdeal`. When `L` is also invertible, the index ideal is then an
invertible ideal and `[L] = [f.indexIdeal] [N]` in the Picard group. Over a domain a nonzero
linear map out of an invertible module into a torsion-free module is injective, because in an
invertible module `ψ x • y = ψ y • x` for every linear form `ψ`; so these conclusions hold for
every nonzero map of lines over a domain.

## Main definitions

* `LinearMap.indexIdeal f`: the image of the evaluation map `Nᵛ ⊗ L → R`, `φ ⊗ x ↦ φ (f x)`.
* `LinearMap.indexIdealEquiv hf`: for injective `f` into an invertible module, the isomorphism
  `Nᵛ ⊗ L ≃ f.indexIdeal` induced by evaluation.

## Main results

* `LinearMap.indexIdeal_eq_span`, `LinearMap.mem_indexIdeal_iff`: the index ideal is spanned by
  the values `φ (f x)`, and its elements are the finite sums of such values.
* `LinearMap.indexIdeal_zero`, `LinearMap.indexIdeal_eq_bot_iff`: the zero map, and only the zero
  map into a projective module, has index ideal `0`.
* `LinearMap.indexIdeal_id_eq_top_iff`, `LinearMap.indexIdeal_id`: the identity of `L` has index
  ideal `R` exactly when `L` is a generator, in particular when `L` is invertible.
* `LinearMap.indexIdeal_comp_linearEquiv`, `LinearMap.indexIdeal_linearEquiv_comp`: invariance
  under isomorphisms of the source and of the target.
* `LinearMap.indexIdeal_eq_span_singleton`: for trivialized lines, the index ideal is generated by
  the scalar of `f`.
* `LinearMap.indexIdeal_baseChange`: base change extends the index ideal.
* `Module.Invertible.injective_of_ne_zero`: over a domain, a nonzero map out of an invertible module
  into a torsion-free module is injective.
* `LinearMap.invertible_indexIdeal`, `LinearMap.pic_mk_eq_mk_indexIdeal_mul_mk`: for an injective
  map of lines, the index ideal is invertible and `[L] = [f.indexIdeal] [N]` in `Pic R`.

## References

* C. A. Weibel, *The K-book: An introduction to algebraic K-theory*, Graduate Studies in
  Mathematics 145, American Mathematical Society, 2013, Chapter I, §3 (invertible modules and
  the Picard group).
-/

public section

noncomputable section

open Module TensorProduct

namespace LinearMap

section CommSemiring

variable {R L L' N N' : Type*} [CommSemiring R]
  [AddCommMonoid L] [Module R L] [AddCommMonoid L'] [Module R L']
  [AddCommMonoid N] [Module R N] [AddCommMonoid N'] [Module R N']

/-- The **index ideal** of a linear map `f : L → N`: the image of the evaluation map
`Nᵛ ⊗ L → R`, `φ ⊗ x ↦ φ (f x)`. It is the ideal spanned by the values of the linear forms on `N`
along `f` (`LinearMap.indexIdeal_eq_span`). For a map of lines it is the ideal generated, locally,
by the scalar of `f`. -/
def indexIdeal (f : L →ₗ[R] N) : Ideal R :=
  range (contractLeft R N ∘ₗ f.lTensor (Dual R N))

/-- The index ideal of `f` is, by definition, the range of the evaluation map. -/
theorem indexIdeal_def (f : L →ₗ[R] N) :
    f.indexIdeal = range (contractLeft R N ∘ₗ f.lTensor (Dual R N)) :=
  (rfl)

/-- The evaluation of a linear form on `N` along `f` lies in the index ideal of `f`. -/
@[simp]
theorem apply_mem_indexIdeal (f : L →ₗ[R] N) (φ : Dual R N) (x : L) :
    φ (f x) ∈ f.indexIdeal := by
  rw [indexIdeal_def]
  exact ⟨φ ⊗ₜ x, by simp⟩

/-- The index ideal of `f` is spanned by the values `φ (f x)` of the linear forms `φ` on `N`. -/
theorem indexIdeal_eq_span (f : L →ₗ[R] N) :
    f.indexIdeal = Ideal.span {r | ∃ (φ : Dual R N) (x : L), φ (f x) = r} := by
  rw [indexIdeal_def, range_eq_map, ← span_tmul_eq_top, Submodule.map_span, Ideal.span]
  congr 1
  ext r
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨_, ⟨φ, x, rfl⟩, rfl⟩
    exact ⟨φ, x, by simp⟩
  · rintro ⟨φ, x, rfl⟩
    exact ⟨φ ⊗ₜ x, ⟨φ, x, rfl⟩, by simp⟩

/-- The index ideal of `f` is contained in an ideal `I` exactly when every value `φ (f x)` of a
linear form `φ` on `N` lies in `I`. -/
theorem indexIdeal_le_iff (f : L →ₗ[R] N) {I : Ideal R} :
    f.indexIdeal ≤ I ↔ ∀ (φ : Dual R N) (x : L), φ (f x) ∈ I := by
  rw [indexIdeal_eq_span, Ideal.span_le]
  exact ⟨fun h φ x ↦ h ⟨φ, x, rfl⟩, by rintro h _ ⟨φ, x, rfl⟩; exact h φ x⟩

/-- **Elements of the index ideal**: they are the finite sums `∑ φᵢ (f xᵢ)` of values of linear
forms on `N` along `f`. -/
theorem mem_indexIdeal_iff (f : L →ₗ[R] N) {r : R} :
    r ∈ f.indexIdeal ↔
      ∃ (n : ℕ) (φ : Fin n → Dual R N) (x : Fin n → L), ∑ i, φ i (f (x i)) = r := by
  refine ⟨fun hr ↦ ?_, ?_⟩
  · rw [indexIdeal_eq_span, Ideal.span, Submodule.mem_span_set'] at hr
    obtain ⟨n, c, v, rfl⟩ := hr
    choose φ x hφx using fun i ↦ (v i).property
    exact ⟨n, fun i ↦ c i • φ i, x, by simp [hφx]⟩
  · rintro ⟨n, φ, x, rfl⟩
    exact Ideal.sum_mem _ fun i _ ↦ f.apply_mem_indexIdeal (φ i) (x i)

/-- The zero map has index ideal `0`. -/
@[simp]
theorem indexIdeal_zero : (0 : L →ₗ[R] N).indexIdeal = ⊥ :=
  le_bot_iff.mp <| (indexIdeal_le_iff _).mpr fun φ x ↦ by simp

/-- A linear map into a projective module has index ideal `0` exactly when it is zero: the linear
forms on a projective module separate its points. -/
theorem indexIdeal_eq_bot_iff [Projective R N] {f : L →ₗ[R] N} : f.indexIdeal = ⊥ ↔ f = 0 := by
  refine ⟨fun h ↦ ext fun x ↦ (forall_dual_apply_eq_zero_iff R (f x)).mp fun φ ↦ ?_,
    fun h ↦ h ▸ indexIdeal_zero⟩
  simpa [h] using f.apply_mem_indexIdeal φ x

/-- The identity of `L` has index ideal `R` exactly when `L` is a generator, that is, when the
values of the linear forms on `L` span `R`. -/
theorem indexIdeal_id_eq_top_iff :
    (id : L →ₗ[R] L).indexIdeal = ⊤ ↔ TauCeti.Module.IsGenerator R L := by
  rw [Ideal.eq_top_iff_one, mem_indexIdeal_iff, TauCeti.Module.isGenerator_iff_exists_sum_eq_one]
  simp

/-- The identity of an invertible module has index ideal `R`. -/
@[simp]
theorem indexIdeal_id [Module.Invertible R L] : (id : L →ₗ[R] L).indexIdeal = ⊤ := by
  rw [indexIdeal_def, lTensor_id, comp_id, range_eq_top]
  exact Module.Invertible.bijective.surjective

/-- The index ideal of a composite is contained in the index ideal of its left factor. -/
theorem indexIdeal_comp_le_left (g : N →ₗ[R] N') (f : L →ₗ[R] N) :
    (g ∘ₗ f).indexIdeal ≤ g.indexIdeal :=
  (indexIdeal_le_iff _).mpr fun φ x ↦ g.apply_mem_indexIdeal φ (f x)

/-- The index ideal of a composite is contained in the index ideal of its right factor. -/
theorem indexIdeal_comp_le_right (g : N →ₗ[R] N') (f : L →ₗ[R] N) :
    (g ∘ₗ f).indexIdeal ≤ f.indexIdeal :=
  (indexIdeal_le_iff _).mpr fun φ x ↦ f.apply_mem_indexIdeal (φ ∘ₗ g) x

/-- Precomposing with a surjective map does not change the index ideal. -/
theorem indexIdeal_comp_of_surjective (g : N →ₗ[R] N') {f : L →ₗ[R] N}
    (hf : Function.Surjective f) : (g ∘ₗ f).indexIdeal = g.indexIdeal := by
  refine le_antisymm (g.indexIdeal_comp_le_left f) ((indexIdeal_le_iff _).mpr fun φ y ↦ ?_)
  obtain ⟨x, rfl⟩ := hf y
  exact (g ∘ₗ f).apply_mem_indexIdeal φ x

/-- Postcomposing with a map that has a left inverse does not change the index ideal. -/
theorem indexIdeal_comp_of_comp_eq_id (f : L →ₗ[R] N) {e : N →ₗ[R] N'} {e' : N' →ₗ[R] N}
    (h : e' ∘ₗ e = id) : (e ∘ₗ f).indexIdeal = f.indexIdeal := by
  refine le_antisymm (e.indexIdeal_comp_le_right f) ((indexIdeal_le_iff _).mpr fun φ x ↦ ?_)
  simpa [← comp_apply (f := e'), h] using (e ∘ₗ f).apply_mem_indexIdeal (φ ∘ₗ e') x

/-- The index ideal is invariant under isomorphisms of the source. -/
@[simp]
theorem indexIdeal_comp_linearEquiv (f : L →ₗ[R] N) (e : L' ≃ₗ[R] L) :
    (f ∘ₗ e.toLinearMap).indexIdeal = f.indexIdeal :=
  f.indexIdeal_comp_of_surjective e.surjective

/-- The index ideal is invariant under isomorphisms of the target. -/
@[simp]
theorem indexIdeal_linearEquiv_comp (f : L →ₗ[R] N) (e : N ≃ₗ[R] N') :
    (e.toLinearMap ∘ₗ f).indexIdeal = f.indexIdeal :=
  f.indexIdeal_comp_of_comp_eq_id e.symm_comp

/-- A linear map `R → R` has as index ideal the principal ideal generated by its value at `1`. -/
theorem indexIdeal_eq_span_singleton_apply_one (f : R →ₗ[R] R) :
    f.indexIdeal = Ideal.span {f 1} := by
  refine le_antisymm ((indexIdeal_le_iff _).mpr fun φ x ↦ ?_) ?_
  · have h (g : R →ₗ[R] R) (y : R) : g y = y * g 1 := by
      rw [← smul_eq_mul, ← map_smul, smul_eq_mul, mul_one]
    rw [h φ (f x), h f x]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
  · rw [Ideal.span_singleton_le_iff_mem]
    exact f.apply_mem_indexIdeal id 1

/-- **The index ideal of a map of trivialized lines** is generated by the scalar of the map: if
`eL : R ≃ L` and `eN : N ≃ R` trivialize the source and the target, then `f.indexIdeal` is the
principal ideal generated by `eN (f (eL 1))`. -/
theorem indexIdeal_eq_span_singleton (f : L →ₗ[R] N) (eL : R ≃ₗ[R] L) (eN : N ≃ₗ[R] R) :
    f.indexIdeal = Ideal.span {eN (f (eL 1))} := by
  rw [← f.indexIdeal_linearEquiv_comp eN, ← indexIdeal_comp_linearEquiv _ eL,
    indexIdeal_eq_span_singleton_apply_one]
  simp

section BaseChange

variable (A : Type*) [CommSemiring A] [Algebra R A]

/-- If every linear form on a projective module `N` takes its value at `n` in `I`, then every
linear form on the base change `A ⊗ N` takes its value at `1 ⊗ n` in the extension of `I`: write
`n` in a dual basis of `N`. -/
private theorem apply_one_tmul_mem_map [Projective R N] {I : Ideal R} {n : N}
    (hn : ∀ φ : Dual R N, φ n ∈ I) (ψ : Dual A (A ⊗[R] N)) :
    ψ (1 ⊗ₜ n) ∈ I.map (algebraMap R A) := by
  obtain ⟨s, hs⟩ := Projective.out (R := R) (P := N)
  have hsum : (1 : A) ⊗ₜ[R] n = (s n).sum fun m c ↦ algebraMap R A c • (1 ⊗ₜ[R] m) := by
    conv_lhs => rw [← hs n, Finsupp.linearCombination_apply, Finsupp.sum, tmul_sum]
    simp [Finsupp.sum, tmul_smul, algebraMap_smul]
  rw [hsum, Finsupp.sum, map_sum]
  refine Ideal.sum_mem _ fun m _ ↦ ?_
  rw [map_smul, smul_eq_mul]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hn (Finsupp.lapply m ∘ₗ s)))

/-- **Base change extends the index ideal**: for a map `f` into a projective module and an
`R`-algebra `A`, the index ideal of `A ⊗ f` is the ideal of `A` generated by the index ideal of
`f`. -/
theorem indexIdeal_baseChange [Projective R N] (f : L →ₗ[R] N) :
    (f.baseChange A).indexIdeal = f.indexIdeal.map (algebraMap R A) := by
  refine le_antisymm ((indexIdeal_le_iff _).mpr fun ψ y ↦ ?_) ?_
  · induction y with
    | add y z hy hz => simpa only [map_add] using Ideal.add_mem _ hy hz
    | tmul a x =>
      rw [baseChange_tmul, ← mul_one a, ← smul_eq_mul, ← smul_tmul', map_smul, smul_eq_mul]
      exact Ideal.mul_mem_left _ _
        (apply_one_tmul_mem_map A (fun φ ↦ f.apply_mem_indexIdeal φ x) ψ)
  · rw [Ideal.map_le_iff_le_comap, indexIdeal_le_iff]
    intro φ x
    rw [Ideal.mem_comap, Algebra.algebraMap_eq_smul_one]
    simpa using (f.baseChange A).apply_mem_indexIdeal (φ.baseChange A) (1 ⊗ₜ x)

end BaseChange

section Invertible

variable [Module.Invertible R N] {f : L →ₗ[R] N}

/-- For an injective map into an invertible module, the evaluation map `Nᵛ ⊗ L → R` is
injective. -/
private theorem injective_contractLeft_comp_lTensor (hf : Function.Injective f) :
    Function.Injective (contractLeft R N ∘ₗ f.lTensor (Dual R N)) :=
  Module.Invertible.bijective.injective.comp
    ((Module.Invertible.lTensor_injective_iff (Dual R N)).mpr hf)

/-- For an injective map `f : L → N` into an invertible module, evaluation `φ ⊗ x ↦ φ (f x)`
identifies `Nᵛ ⊗ L` with the index ideal of `f`. -/
def indexIdealEquiv (hf : Function.Injective f) : Dual R N ⊗[R] L ≃ₗ[R] f.indexIdeal :=
  (LinearEquiv.ofInjective _ (injective_contractLeft_comp_lTensor hf)).trans
    (LinearEquiv.ofEq _ _ (indexIdeal_def f).symm)

/-- `LinearMap.indexIdealEquiv` is evaluation `φ ⊗ x ↦ φ (f x)`. -/
@[simp]
theorem coe_indexIdealEquiv_tmul (hf : Function.Injective f) (φ : Dual R N) (x : L) :
    (indexIdealEquiv hf (φ ⊗ₜ x) : R) = φ (f x) := by
  simp [indexIdealEquiv]

variable [Module.Invertible R L]

/-- The index ideal of an injective map of invertible modules is an invertible ideal. -/
theorem invertible_indexIdeal (hf : Function.Injective f) : Module.Invertible R f.indexIdeal :=
  .congr (indexIdealEquiv hf)

/-- **The Picard class of a line through an injective map**: for an injective map `f : L → N` of
invertible modules, `[L] = [f.indexIdeal] [N]` in the Picard group. -/
theorem pic_mk_eq_mk_indexIdeal_mul_mk (hf : Function.Injective f) :
    haveI := invertible_indexIdeal hf
    CommRing.Pic.mk R L = CommRing.Pic.mk R f.indexIdeal * CommRing.Pic.mk R N := by
  have := invertible_indexIdeal hf
  rw [CommRing.Pic.mk_eq_mk_iff.mpr ⟨(indexIdealEquiv hf).symm⟩, CommRing.Pic.mk_tensor,
    CommRing.Pic.mk_dual, mul_comm, mul_inv_cancel_left]

end Invertible

end CommSemiring

end LinearMap

namespace Module.Invertible

variable {R L N : Type*} [CommRing R] [IsDomain R] [AddCommGroup L] [Module R L]
  [Module.Invertible R L] [AddCommGroup N] [Module R N] [IsTorsionFree R N]

/-- **A nonzero map out of a line over a domain is injective**: over a domain, a nonzero linear map
from an invertible module into a torsion-free module, for instance another invertible module, is
injective. -/
theorem injective_of_ne_zero {f : L →ₗ[R] N} (hf : f ≠ 0) : Function.Injective f := by
  refine (injective_iff_map_eq_zero f).mpr fun x hx ↦ by_contra fun hx0 ↦ hf ?_
  obtain ⟨ψ, hψ⟩ := Projective.exists_dual_ne_zero R hx0
  refine LinearMap.ext fun y ↦ (smul_eq_zero.mp ?_).resolve_left hψ
  rw [← map_smul, apply_smul_eq_apply_smul, map_smul, hx, smul_zero]

end Module.Invertible
