/-!
# The index ideal of a map of lines

For a linear map `f : L → N` of modules over a commutative semiring `R`, the **index ideal**
`f.indexIdeal` is the image of the evaluation map

`N^∨ ⊗ L → R,   φ ⊗ x ↦ φ (f x)`,

that is, the ideal of finite sums of values `φ (f x)` (`LinearMap.mem_indexIdeal_iff`). The
definition makes sense for all modules and all maps, including the zero map, whose index ideal
is `0` (`LinearMap.indexIdeal_zero`).

When `L` and `N` are lines (invertible modules), the index ideal measures how far `f` is from
being an isomorphism. On the trivial line `R`, a map is multiplication by a scalar and its index
ideal is the ideal generated by that scalar (`LinearMap.indexIdeal_eq_span_singleton`); for
instance multiplication by `6` on `ℤ` has index ideal `(6)`, and the identity of any line has
index ideal `R` (`LinearMap.indexIdeal_id`); more generally the identity of a module has index
ideal `R` exactly when the module is a generator (`LinearMap.indexIdeal_id_eq_top_iff`). The
index ideal does not change when source or target is replaced by an isomorphic module
(`LinearMap.indexIdeal_comp_linearEquiv`, `LinearMap.indexIdeal_linearEquiv_comp`). For a
projective target its formation commutes with arbitrary base change
(`LinearMap.indexIdeal_baseChange`), so after a localization trivializing both lines it is
generated by the local scalar of `f`. The index ideal of a composite through a line is the product
of the index ideals (`LinearMap.indexIdeal_comp`).

If the index ideal of a map `f : L → N` of lines is itself invertible, the evaluation map
identifies `N^∨ ⊗ L` with it (`LinearMap.dualTensorEquivIndexIdeal`), so that
`[L] = [f.indexIdeal] [N]` in the Picard group (`LinearMap.pic_mk_eq_mk_indexIdeal_mul`). Over a
domain this applies to every nonzero `f`: a nonzero functional on a line is injective
(`Module.Invertible.injective_of_ne_zero`), so the index ideal is nonzero
(`LinearMap.indexIdeal_eq_bot_iff`) and is an invertible module
(`LinearMap.invertible_indexIdeal`). Over any commutative semiring the same holds for every
injective map of lines (`LinearMap.invertible_indexIdeal_of_injective`). This compares the
classes of two lines related by a nonzero map without choosing a basis of either.

## Main declarations

* `LinearMap.indexIdeal`: the image ideal of `φ ⊗ x ↦ φ (f x)`.
* `LinearMap.mem_indexIdeal_iff`: its elements are the finite sums `∑ φᵢ (f xᵢ)`.
* `LinearMap.indexIdeal_baseChange`: for a projective target, the index ideal commutes with
  arbitrary base change.
* `LinearMap.indexIdeal_comp`: multiplicativity under composition through a line.
* `LinearMap.dualTensorEquivIndexIdeal`: `N^∨ ⊗ L ≃ f.indexIdeal` when the index ideal of a map
  of lines is invertible.
* `LinearMap.pic_mk_eq_mk_indexIdeal_mul`: the Picard class identity `[L] = [f.indexIdeal] [N]`.
* `LinearMap.invertible_indexIdeal_of_injective`: an injective map of lines has an invertible
  index ideal.
* `LinearMap.invertible_indexIdeal`: over a domain, a nonzero map of lines has an invertible
  index ideal.

## References

* C. Weibel, *The K-book*, Chapter I, Section 3 (invertible modules and determinant lines),
  pp. 18–20.
-/

public section

noncomputable section

open Module TensorProduct

namespace LinearMap

section CommSemiring

variable {R L L' N N' P : Type*} [CommSemiring R]
  [AddCommMonoid L] [Module R L] [AddCommMonoid L'] [Module R L']
  [AddCommMonoid N] [Module R N] [AddCommMonoid N'] [Module R N']
  [AddCommMonoid P] [Module R P]

/-- The **index ideal** of a linear map `f : L → N`: the image of the evaluation map
`N^∨ ⊗ L → R`, `φ ⊗ x ↦ φ (f x)`. For a map of lines it is, locally, the ideal generated by the
scalar by which `f` acts. -/
def indexIdeal (f : L →ₗ[R] N) : Ideal R :=
  range (contractLeft R N ∘ₗ f.lTensor (Dual R N))

variable (f : L →ₗ[R] N)

/-- The defining formula of the index ideal, as the range of the evaluation map. -/
theorem indexIdeal_def : f.indexIdeal = range (contractLeft R N ∘ₗ f.lTensor (Dual R N)) :=
  (rfl)

/-- The value `φ (f x)` lies in the index ideal of `f`. -/
theorem apply_mem_indexIdeal (φ : Dual R N) (x : L) : φ (f x) ∈ f.indexIdeal := by
  rw [indexIdeal_def]
  exact ⟨φ ⊗ₜ x, by simp⟩

/-- The index ideal of `f` is contained in an ideal `I` exactly when every value `φ (f x)`
lies in `I`. -/
theorem indexIdeal_le_iff {I : Ideal R} : f.indexIdeal ≤ I ↔ ∀ φ : Dual R N, ∀ x, φ (f x) ∈ I := by
  refine ⟨fun h φ x ↦ h (f.apply_mem_indexIdeal φ x), fun h ↦ ?_⟩
  rw [indexIdeal_def]
  rintro _ ⟨t, rfl⟩
  induction t using TensorProduct.inductionOn with
  | tmul φ x => simpa using h φ x
  | add t₁ t₂ h₁ h₂ => simpa using I.add_mem h₁ h₂

/-- The index ideal of `f` is the ideal generated by the values `φ (f x)`. -/
theorem indexIdeal_eq_span :
    f.indexIdeal = Ideal.span (Set.range fun p : Dual R N × L ↦ p.1 (f p.2)) :=
  le_antisymm ((f.indexIdeal_le_iff).2 fun φ x ↦ Ideal.subset_span ⟨(φ, x), rfl⟩)
    (Ideal.span_le.2 <| Set.range_subset_iff.2 fun p ↦ f.apply_mem_indexIdeal p.1 p.2)

/-- The elements of the index ideal of `f` are the finite sums `∑ᵢ φᵢ (f xᵢ)`. -/
theorem mem_indexIdeal_iff {r : R} :
    r ∈ f.indexIdeal ↔
      ∃ (k : ℕ) (φ : Fin k → Dual R N) (x : Fin k → L), ∑ i, φ i (f (x i)) = r := by
  constructor
  · rw [indexIdeal_def]
    rintro ⟨t, rfl⟩
    obtain ⟨k, φ, x, rfl⟩ := TensorProduct.exists_sum_tmul_eq t
    exact ⟨k, φ, x, by simp⟩
  · rintro ⟨k, φ, x, rfl⟩
    exact Ideal.sum_mem _ fun i _ ↦ f.apply_mem_indexIdeal (φ i) (x i)

/-- The zero map has index ideal `0`. -/
@[simp]
theorem indexIdeal_zero : (0 : L →ₗ[R] N).indexIdeal = ⊥ :=
  le_bot_iff.1 <| (indexIdeal_le_iff _).2 fun φ x ↦ by simp

/-- Composing on the left can only shrink the index ideal. -/
theorem indexIdeal_comp_le (g : N →ₗ[R] P) : (g ∘ₗ f).indexIdeal ≤ f.indexIdeal :=
  (indexIdeal_le_iff _).2 fun ψ x ↦ f.apply_mem_indexIdeal (ψ ∘ₗ g) x

/-- Precomposing with a surjective map does not change the index ideal. In particular the index
ideal does not depend on the source up to isomorphism. -/
theorem indexIdeal_comp_of_surjective {g : L' →ₗ[R] L} (hg : Function.Surjective g) :
    (f ∘ₗ g).indexIdeal = f.indexIdeal := by
  refine le_antisymm ((indexIdeal_le_iff _).2 fun φ x ↦ f.apply_mem_indexIdeal φ (g x))
    ((f.indexIdeal_le_iff).2 fun φ x ↦ ?_)
  obtain ⟨y, rfl⟩ := hg x
  exact (f ∘ₗ g).apply_mem_indexIdeal φ y

/-- Composing with an isomorphism of targets does not change the index ideal. -/
@[simp]
theorem indexIdeal_linearEquiv_comp (e : N ≃ₗ[R] N') :
    (e.toLinearMap ∘ₗ f).indexIdeal = f.indexIdeal := by
  refine le_antisymm (f.indexIdeal_comp_le _) ((f.indexIdeal_le_iff).2 fun φ x ↦ ?_)
  simpa using (e.toLinearMap ∘ₗ f).apply_mem_indexIdeal (φ ∘ₗ e.symm.toLinearMap) x

/-- Precomposing with an isomorphism of sources does not change the index ideal. -/
@[simp]
theorem indexIdeal_comp_linearEquiv (e : L' ≃ₗ[R] L) :
    (f ∘ₗ e.toLinearMap).indexIdeal = f.indexIdeal :=
  f.indexIdeal_comp_of_surjective e.surjective

/-- The index ideal of an endomorphism of the trivial line `R` is generated by the scalar by
which it acts. -/
theorem indexIdeal_eq_span_singleton (g : R →ₗ[R] R) : g.indexIdeal = Ideal.span {g 1} := by
  refine le_antisymm ((g.indexIdeal_le_iff).2 fun φ x ↦ ?_) ?_
  · have h (h : R →ₗ[R] R) (y : R) : h y = y * h 1 := by
      rw [← smul_eq_mul, ← map_smul, smul_eq_mul, mul_one]
    rw [h φ, h g x, Ideal.mem_span_singleton]
    exact ⟨x * φ 1, by ring⟩
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    simpa using g.apply_mem_indexIdeal LinearMap.id 1

/-- The index ideal of a map into a projective module vanishes only for the zero map. -/
@[simp]
theorem indexIdeal_eq_bot_iff [Projective R N] : f.indexIdeal = ⊥ ↔ f = 0 := by
  refine ⟨fun h ↦ LinearMap.ext fun x ↦ ?_, fun h ↦ h ▸ indexIdeal_zero⟩
  refine (forall_dual_apply_eq_zero_iff R (f x)).1 fun φ ↦ ?_
  simpa [h] using f.apply_mem_indexIdeal φ x

/-- A surjective map onto an invertible module has index ideal `R`. -/
theorem indexIdeal_eq_top_of_surjective [Module.Invertible R N] (hf : Function.Surjective f) :
    f.indexIdeal = ⊤ :=
  f.indexIdeal_def ▸ range_eq_top.2 <| Module.Invertible.bijective.2.comp (lTensor_surjective _ hf)

/-- The identity of an invertible module has index ideal `R`. -/
@[simp]
theorem indexIdeal_id [Module.Invertible R L] : (LinearMap.id : L →ₗ[R] L).indexIdeal = ⊤ :=
  indexIdeal_eq_top_of_surjective _ Function.surjective_id

/-- The identity of `L` has index ideal `R` exactly when `L` is a generator, that is, when the
values of the linear forms on `L` span `R`. -/
theorem indexIdeal_id_eq_top_iff :
    (LinearMap.id : L →ₗ[R] L).indexIdeal = ⊤ ↔ TauCeti.Module.IsGenerator R L := by
  rw [Ideal.eq_top_iff_one, mem_indexIdeal_iff, TauCeti.Module.isGenerator_iff_exists_sum_eq_one]
  simp

/-- For a projective target, the index ideal commutes with arbitrary base change: the index ideal
of `A ⊗ f` is the extension of the index ideal of `f`. -/
theorem indexIdeal_baseChange (A : Type*) [CommSemiring A] [Algebra R A] [Projective R N] :
    (f.baseChange A).indexIdeal = f.indexIdeal.map (algebraMap R A) := by
  refine le_antisymm ((indexIdeal_le_iff _).2 fun ψ y ↦ ?_) ?_
  · induction y using TensorProduct.inductionOn with
    | tmul a x =>
      -- Expand `f x = ∑ⱼ φⱼ (f x) • bⱼ` by the dual basis lemma; each term contributes `φⱼ (f x)`.
      obtain ⟨k, b, φ, hb⟩ := TauCeti.exists_sum_dual_smul_eq_self (R := R) (f x)
      rw [baseChange_tmul, ← hb, tmul_sum, map_sum]
      refine Ideal.sum_mem _ fun j _ ↦ ?_
      rw [tmul_smul, map_smul_of_tower, Algebra.smul_def]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (f.apply_mem_indexIdeal (φ j) x))
    | add y₁ y₂ h₁ h₂ => simpa using add_mem h₁ h₂
  · rw [Ideal.map_le_iff_le_comap, indexIdeal_le_iff]
    intro φ x
    simpa [Dual.baseChange_apply_tmul, Algebra.algebraMap_eq_smul_one] using
      (f.baseChange A).apply_mem_indexIdeal (φ.baseChange A) (1 ⊗ₜ x)

/-- The index ideal is multiplicative for maps of lines: when `N` is invertible, the index ideal
of `g ∘ f` is the product of the index ideals of `g` and `f`. -/
theorem indexIdeal_comp [Module.Invertible R N] (g : N →ₗ[R] P) :
    (g ∘ₗ f).indexIdeal = g.indexIdeal * f.indexIdeal := by
  refine le_antisymm ((indexIdeal_le_iff _).2 fun ψ x ↦ ?_) ?_
  · -- Expand `f x = ∑ⱼ φⱼ (f x) • bⱼ` by the dual basis lemma.
    obtain ⟨k, b, φ, hb⟩ := TauCeti.exists_sum_dual_smul_eq_self (R := R) (f x)
    rw [comp_apply, ← hb, map_sum, map_sum]
    refine Ideal.sum_mem _ fun j _ ↦ ?_
    rw [map_smul, map_smul, smul_eq_mul, mul_comm (φ j (f x))]
    exact Ideal.mul_mem_mul (g.apply_mem_indexIdeal ψ (b j)) (f.apply_mem_indexIdeal (φ j) x)
  · rw [indexIdeal_eq_span g, indexIdeal_eq_span f, Ideal.span_mul_span, Ideal.span_le]
    rintro _ ⟨_, ⟨⟨ψ, n⟩, rfl⟩, _, ⟨⟨φ, x⟩, rfl⟩, rfl⟩
    -- In the line `N`, `φ (f x) • n = φ n • f x`.
    have h : ψ (g n) * φ (f x) = φ n * ψ (g (f x)) := by
      rw [mul_comm, ← smul_eq_mul, ← map_smul, ← map_smul,
        Module.Invertible.apply_smul_comm φ (f x) n, map_smul, map_smul, smul_eq_mul]
    dsimp only
    rw [SetLike.mem_coe, h]
    exact Ideal.mul_mem_left _ _ ((g ∘ₗ f).apply_mem_indexIdeal ψ x)

/-- An injective map of invertible modules has an invertible index ideal: the evaluation map
`N^∨ ⊗ L → R` is then injective, so it identifies the invertible module `N^∨ ⊗ L` with the index
ideal. Over a domain every nonzero map of lines is injective, see
`LinearMap.invertible_indexIdeal`. -/
theorem invertible_indexIdeal_of_injective [Module.Invertible R L] [Module.Invertible R N]
    (hf : Function.Injective f) : Module.Invertible R f.indexIdeal :=
  .congr (LinearEquiv.ofInjective (contractLeft R N ∘ₗ f.lTensor (Dual R N))
      (Module.Invertible.bijective.1.comp ((Module.Invertible.lTensor_injective_iff _).2 hf)) ≪≫ₗ
    .ofEq _ _ f.indexIdeal_def.symm)

section Invertible

variable [Module.Invertible R L] [Module.Invertible R N] [Module.Invertible R f.indexIdeal]

/-- For a map `f : L → N` of invertible modules whose index ideal is invertible, the evaluation
map `φ ⊗ x ↦ φ (f x)` identifies the invertible module `N^∨ ⊗ L` with the index ideal. Over a
domain this applies to every nonzero map of lines, see `LinearMap.invertible_indexIdeal`. -/
def dualTensorEquivIndexIdeal : Dual R N ⊗[R] L ≃ₗ[R] f.indexIdeal :=
  .ofBijective (codRestrict f.indexIdeal (contractLeft R N ∘ₗ f.lTensor (Dual R N))
      fun t ↦ f.indexIdeal_def ▸ mem_range_self _ t) <|
    Module.Invertible.bijective_of_surjective fun ⟨r, hr⟩ ↦ by
      obtain ⟨t, rfl⟩ := f.indexIdeal_def ▸ hr
      exact ⟨t, rfl⟩

/-- The equivalence `LinearMap.dualTensorEquivIndexIdeal` sends `φ ⊗ x` to `φ (f x)`. -/
@[simp]
theorem coe_dualTensorEquivIndexIdeal_tmul (φ : Dual R N) (x : L) :
    (f.dualTensorEquivIndexIdeal (φ ⊗ₜ x) : R) = φ (f x) :=
  (congrArg Subtype.val (LinearEquiv.ofBijective_apply _ _)).trans (by simp)

/-- For a map `f : L → N` of invertible modules whose index ideal is invertible (over a domain,
any nonzero `f`, see `LinearMap.invertible_indexIdeal`), `[L] = [f.indexIdeal] [N]` in the
Picard group. -/
theorem pic_mk_eq_mk_indexIdeal_mul :
    CommRing.Pic.mk R L = CommRing.Pic.mk R f.indexIdeal * CommRing.Pic.mk R N := by
  rw [← CommRing.Pic.mk_eq_mk_iff.2 ⟨f.dualTensorEquivIndexIdeal⟩, CommRing.Pic.mk_tensor,
    CommRing.Pic.mk_dual, mul_comm, mul_inv_cancel_left]

end Invertible

end CommSemiring

section IsDomain

variable {R L N : Type*} [CommSemiring R] [IsDomain R] [AddCommMonoid L] [Module R L]
  [AddCommMonoid N] [Module R N] [Module.Invertible R L] [Module.Invertible R N]
  (f : L →ₗ[R] N)

/-- Over a domain, the index ideal of a nonzero map of invertible modules is an invertible
module, isomorphic to `N^∨ ⊗ L` by the evaluation map `φ ⊗ x ↦ φ (f x)`. -/
theorem invertible_indexIdeal (hf : f ≠ 0) : Module.Invertible R f.indexIdeal := by
  have hinj := Module.Invertible.injective_of_ne_zero (M := Dual R N ⊗[R] L)
    (g := contractLeft R N ∘ₗ f.lTensor (Dual R N))
    fun h ↦ hf <| f.indexIdeal_eq_bot_iff.1 <| f.indexIdeal_def ▸ range_eq_bot.2 h
  exact f.invertible_indexIdeal_of_injective <|
    (Module.Invertible.lTensor_injective_iff _).1 (hinj.of_comp (f := contractLeft R N))

end IsDomain

end LinearMap
