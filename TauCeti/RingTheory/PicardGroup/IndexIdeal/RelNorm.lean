/-!
# The relative norm of an ideal as an index ideal

Let `R → S` be a finite injective map of Dedekind domains, so that `S` is a finite projective
`R`-module of rank `d = finrank R S`. An ideal `J` of `S` is also an `R`-module, and the inclusion
`J ↪ S` induces a map `⋀ᵈ_R J → ⋀ᵈ_R S` of top exterior powers, the determinant of the
inclusion. Its index ideal (`LinearMap.indexIdeal`) is the relative norm of `J`
(`Ideal.indexIdeal_exteriorPower_map_subtype_eq_relNorm`):

`ind (⋀ᵈ_R (J ↪ S)) = relNorm R J`.

This describes the relative ideal norm intrinsically, as the determinant of a lattice inclusion,
without choosing generators of `J` or bases. It includes `J = ⊥`, where both sides vanish.

The comparison is local on `R`. For a principal ideal `bB` of a finite free `A`-algebra `B`,
multiplication by `b` maps `B` onto `bB`, so the index ideal of the inclusion `bB ↪ B` is that of
multiplication by `b`, which acts on the top exterior power by its determinant `N_{B/A}(b)`
(`Ideal.indexIdeal_exteriorPower_map_subtype_span_singleton`). The index ideal of `J ↪ S`
commutes with localization at a submonoid of `R` (`Ideal.map_indexIdeal_exteriorPower_map_subtype`),
as does the relative norm (`Ideal.spanIntNorm_localization`). At a maximal ideal `P` of `R`, the
localization `S_P` is a semilocal Dedekind domain, hence a principal ideal domain, and it is free
over `R_P`; so `J S_P = b S_P` and both sides become the ideal generated by `N_{S_P/R_P}(b)`.

## Main results

* `Ideal.indexIdeal_exteriorPower_map_subtype_span_singleton`: for a principal ideal `bB` of a
  free `A`-algebra `B` of rank `d`, `ind (⋀ᵈ_A (bB ↪ B)) = (N_{B/A} b)`.
* `Ideal.map_indexIdeal_exteriorPower_map_subtype`: the index ideal of `⋀ⁿ_R (J ↪ S)` commutes
  with localization.
* `Ideal.indexIdeal_exteriorPower_map_subtype_eq_relNorm`: for a finite injective map of Dedekind
  domains, `ind (⋀ᵈ_R (J ↪ S)) = relNorm R J`.

## References

* C. Weibel, *The K-book*, Chapter I, Section 3 (invertible modules and determinant lines),
  pp. 18–20.
* J.-P. Serre, *Local Fields*, Chapter I, §5 (the norm of an ideal).
-/

public section

open Module

namespace Ideal

section Principal

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Module.Free A B]

/-- **Index ideal of a principal ideal.** For a principal ideal `bB` of a free `A`-algebra `B`,
the top exterior power of the inclusion `bB ↪ B` of `A`-modules has index ideal generated by the
norm of `b`. (If `B` has infinite rank, both sides are `A`: `finrank A B = 0` and the norm is
`1`.) -/
theorem indexIdeal_exteriorPower_map_subtype_span_singleton (b : B) :
    (exteriorPower.map (finrank A B) ((span {b}).subtype.restrictScalars A)).indexIdeal =
      span {Algebra.norm A b} := by
  nontriviality A
  rcases em' (Module.Finite A B) with hfin | hfin
  · -- In degree `0` every map induces an isomorphism `A ≃ A` of exterior powers.
    have : Module.Invertible A (⋀[A]^0 B) := .congr (exteriorPower.zeroEquiv A B).symm
    rw [finrank_of_not_finite hfin, Algebra.norm_eq_one_of_not_module_finite hfin,
      span_singleton_one]
    refine LinearMap.indexIdeal_eq_top_of_surjective _ fun x ↦
      ⟨(exteriorPower.zeroEquiv A _).symm (exteriorPower.zeroEquiv A B x),
        (exteriorPower.zeroEquiv A B).injective ?_⟩
    simpa using LinearMap.congr_fun (exteriorPower.zeroEquiv_naturality
      ((span {b}).subtype.restrictScalars A)) ((exteriorPower.zeroEquiv A _).symm
        (exteriorPower.zeroEquiv A B x))
  -- Multiplication by `b` maps `B` onto `bB`; followed by the inclusion it is `x ↦ b * x`, which
  -- acts on the top exterior power by its determinant `N(b)`.
  let f : B →ₗ[A] span {b} := ((LinearMap.mulLeft B b).codRestrict (span {b}) fun x ↦ by
    rw [LinearMap.mulLeft_apply]
    exact mul_mem_right x _ (mem_span_singleton_self b)).restrictScalars A
  have hf (x : B) : (f x : B) = b * x := by simp [f, LinearMap.mulLeft_apply]
  have hsurj : Function.Surjective f := fun ⟨y, hy⟩ ↦ by
    obtain ⟨x, rfl⟩ := mem_span_singleton.1 hy
    exact ⟨x, Subtype.ext (hf x)⟩
  have hcomp : (span {b}).subtype.restrictScalars A ∘ₗ f = Algebra.lmul A B b := by
    ext x
    simp [hf, Algebra.coe_lmul_eq_mul]
  have : Module.Invertible A (⋀[A]^(finrank A B) B) :=
    .congr (Module.finBasis A B).exteriorPowerFinrankEquiv.symm
  rw [← LinearMap.indexIdeal_comp_of_surjective _ (exteriorPower.map_surjective hsurj),
    ← exteriorPower.map_comp, hcomp, LinearMap.map_exteriorPower_finrank_eq_det_smul,
    ← Algebra.norm_apply, LinearMap.indexIdeal_smul, LinearMap.indexIdeal_id, mul_top]

end Principal

section Localization

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Projective R S]
  (M : Submonoid R) (Rₘ Sₘ : Type*) [CommRing Rₘ] [CommRing Sₘ] [Algebra R Rₘ] [Algebra S Sₘ]
  [Algebra Rₘ Sₘ] [Algebra R Sₘ] [IsScalarTower R Rₘ Sₘ] [IsScalarTower R S Sₘ]
  [IsLocalization M Rₘ] [IsLocalization (Algebra.algebraMapSubmonoid S M) Sₘ]

include M

/-- **The index ideal of an inclusion of ideals commutes with localization.** For an ideal `J`
of an `R`-algebra `S` which is projective as an `R`-module, the extension to a localization
`Rₘ = M⁻¹R` of the index ideal of `⋀ⁿ_R (J ↪ S)` is the index ideal of `⋀ⁿ_{Rₘ} (J_M ↪ S_M)`,
where `S_M = M⁻¹S` and `J_M` is the extension of `J` to `S_M`. -/
theorem map_indexIdeal_exteriorPower_map_subtype (J : Ideal S) (n : ℕ) :
    (exteriorPower.map n (J.subtype.restrictScalars R)).indexIdeal.map (algebraMap R Rₘ) =
      (exteriorPower.map n ((J.map (algebraMap S Sₘ)).subtype.restrictScalars Rₘ)).indexIdeal := by
  -- The localization maps `J → J_M` and `S → S_M` are base changes along `R → Rₘ`, so the
  -- exterior power of `J_M ↪ S_M` is the base change of that of `J ↪ S`.
  have := IsLocalizedModule.restrictScalars M (Algebra.idealMap Sₘ J)
  have hj := IsLocalizedModule.isBaseChange M Rₘ ((Algebra.idealMap Sₘ J).restrictScalars R)
  have hs := IsLocalizedModule.isBaseChange M Rₘ (IsScalarTower.toAlgHom R S Sₘ).toLinearMap
  have h := hj.exteriorPowerEquiv_naturality hs n (J.subtype.restrictScalars R)
    ((J.map (algebraMap S Sₘ)).subtype.restrictScalars Rₘ) (by ext; simp)
  rw [← LinearMap.indexIdeal_baseChange, ← LinearMap.indexIdeal_linearEquiv_comp _
    (hs.exteriorPowerEquiv n), ← h, LinearMap.indexIdeal_comp_linearEquiv]

end Localization

section Dedekind

variable {R S : Type*} [CommRing R] [IsDedekindDomain R] [CommRing S] [IsDedekindDomain S]
  [Algebra R S] [Module.Finite R S] [Module.IsTorsionFree R S]

section AtPrime

variable (P : Ideal R) [P.IsPrime]

local notation3 "Rₚ" => Localization.AtPrime P
local notation3 "Sₚ" => Localization (Algebra.algebraMapSubmonoid S P.primeCompl)

/-- The local case of `Ideal.indexIdeal_exteriorPower_map_subtype_eq_relNorm`: both sides have the
same extension to the localization `R_P` at a prime ideal `P`. -/
private theorem map_indexIdeal_exteriorPower_map_subtype_eq_map_relNorm (J : Ideal S) :
    (exteriorPower.map (finrank R S) (J.subtype.restrictScalars R)).indexIdeal.map
      (algebraMap R Rₚ) = (relNorm R J).map (algebraMap R Rₚ) := by
  -- A finite torsion-free module over a Dedekind domain is flat, hence projective.
  have : Module.FinitePresentation R S := Module.finitePresentation_of_finite R S
  have : Module.Projective R S := Module.Flat.projective_of_finitePresentation
  have hS := IsLocalizedModule.isBaseChange P.primeCompl Rₚ
    (IsScalarTower.toAlgHom R S Sₚ).toLinearMap
  rw [map_indexIdeal_exteriorPower_map_subtype P.primeCompl Rₚ Sₚ, ← hS.finrank_eq, ← spanNorm_eq,
    ← spanIntNorm_localization R J P.primeCompl P.primeCompl_le_nonZeroDivisors Sₚ, spanNorm_eq]
  -- `S_P` is semilocal, hence a principal ideal domain, and it is free over the local ring `R_P`.
  have := TauCeti.finite_maximalSpectrum_of_isIntegral_of_quasiFinite Rₚ (B := Sₚ)
  have : IsPrincipalIdealRing Sₚ := .of_finite_maximals <|
    (Set.finite_range MaximalSpectrum.asIdeal).subset fun I hI ↦ ⟨⟨I, hI⟩, rfl⟩
  have : Module.Free Rₚ Sₚ := Module.free_of_flat_of_isLocalRing
  -- So `J S_P = b S_P`, and both sides are generated by the norm of `b`.
  obtain ⟨b, hb⟩ := Submodule.IsPrincipal.principal (J.map (algebraMap S Sₚ))
  rw [hb, submodule_span_eq, indexIdeal_exteriorPower_map_subtype_span_singleton,
    relNorm_singleton, Algebra.intNorm_eq_norm]

end AtPrime

/-- **The relative norm is the index ideal of the determinant of the inclusion.** For a finite
injective map `R → S` of Dedekind domains of rank `d = finrank R S` and an ideal `J` of `S`, the
map `⋀ᵈ_R J → ⋀ᵈ_R S` of top exterior powers induced by the inclusion `J ↪ S` has index ideal the
relative norm of `J`. -/
theorem indexIdeal_exteriorPower_map_subtype_eq_relNorm (J : Ideal S) :
    (exteriorPower.map (finrank R S) (J.subtype.restrictScalars R)).indexIdeal = relNorm R J :=
  eq_of_localization_maximal fun P _ ↦ map_indexIdeal_exteriorPower_map_subtype_eq_map_relNorm P J

end Dedekind

end Ideal
