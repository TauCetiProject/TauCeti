module

public import TauCeti.Algebra.Group.ZMultiples
public import TauCeti.RingTheory.NovikovSeries.Functoriality
public import TauCeti.RingTheory.NovikovSeries.LeadingTerm
public import Mathlib.RingTheory.Localization.FractionRing

/-!
# Regularity of Novikov series supported on a subgroup

Inclusion of an arbitrary subgroup of exponents preserves and reflects nonzerodivisors.
No finite-index assumption is needed: restriction of coefficients is linear over the subgroup
Novikov ring, and translating a series by monomials detects each of its coefficients in such
a restriction.

In particular, over a domain, a nonzero series supported on the cyclic subgroup generated by
an exponent of nonzero period is a nonzerodivisor, even if the ambient exponent group has
torsion. Such series therefore remain nonzero in every field component of the total quotient
ring. This allows cancellation of one-variable series in identities obtained from finite
covers, without assuming that the whole Novikov ring is a domain.

## References

* M. Hutchings, *Reidemeister torsion in generalized Morse theory*, Forum Math. 14 (2002),
  §3 (one-variable series in the self-slide argument).
-/

public section

noncomputable section

namespace TauCeti.NovikovSeries

open scoped nonZeroDivisors

variable {R H : Type*} [AddCommGroup H] {N : H →+ ℝ}

section Subgroup

variable [CommSemiring R] {K : AddSubgroup H}

/-- Inclusion of a subgroup of exponents preserves nonzerodivisors. -/
theorem algebraMap_addSubgroup_mem_nonZeroDivisors
    {a : NovikovSeries R K (N.comp K.subtype)} (ha : a ∈ (NovikovSeries R K (N.comp K.subtype))⁰) :
    algebraMap _ (NovikovSeries R H N) a ∈ (NovikovSeries R H N)⁰ := by
  refine mem_nonZeroDivisors_iff_left.2 fun b hab => ?_
  ext h
  let res : NovikovSeries R H N →+ NovikovSeries R K (N.comp K.subtype) :=
    comap K.subtype (exists_period_rescale_subtype K)
    (by simp [K.subtype.ker_eq_bot K.subtype_injective])
  have hres : a * res (b * single (-h) 1) = 0 := by
    rw [← comap_subtype_algebraMap_mul, ← mul_assoc, hab, zero_mul, map_zero]
  have hz : res (b * single (-h) 1) = 0 := mem_nonZeroDivisors_iff_left.1 ha _ hres
  have hc := congrArg (fun x : NovikovSeries R K (N.comp K.subtype) => x.coeff 0) hz
  simpa [res, coeff_comap, coeff_mul_single] using hc

/-- Inclusion of a subgroup of exponents preserves and reflects nonzerodivisors. -/
@[simp]
theorem algebraMap_addSubgroup_mem_nonZeroDivisors_iff
    (a : NovikovSeries R K (N.comp K.subtype)) :
    algebraMap _ (NovikovSeries R H N) a ∈ (NovikovSeries R H N)⁰ ↔
      a ∈ (NovikovSeries R K (N.comp K.subtype))⁰ := by
  exact ⟨fun ha => mem_nonZeroDivisors_of_injective algebraMap_addSubgroup_injective ha,
    algebraMap_addSubgroup_mem_nonZeroDivisors⟩

/-- If the period map is injective on a subgroup, every nonzero series from that subgroup
is a nonzerodivisor in the ambient completion. -/
theorem algebraMap_addSubgroup_mem_nonZeroDivisors_of_injective_period [NoZeroDivisors R]
    (hN : Function.Injective (N.comp K.subtype))
    {a : NovikovSeries R K (N.comp K.subtype)} (ha : a ≠ 0) :
    algebraMap _ (NovikovSeries R H N) a ∈ (NovikovSeries R H N)⁰ := by
  let : UniqueSums K := UniqueSums.of_injective_addHom (N.comp K.subtype).toAddHom hN
    inferInstance
  exact algebraMap_addSubgroup_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero ha)

/-- A nonzero series supported on a subgroup on which periods are injective is a nonzerodivisor.
The ambient period map may have a kernel, and the ambient group may have torsion. -/
theorem mem_nonZeroDivisors_of_support_subset_of_injective_period [NoZeroDivisors R]
    (hN : Function.Injective (N.comp K.subtype)) {a : NovikovSeries R H N}
    (haK : a.support ⊆ (K : Set H)) (ha : a ≠ 0) : a ∈ (NovikovSeries R H N)⁰ := by
  obtain ⟨b, rfl⟩ := (mem_range_algebraMap_addSubgroup_iff a).2 haK
  exact algebraMap_addSubgroup_mem_nonZeroDivisors_of_injective_period hN
    (fun hb => ha (by rw [hb, map_zero]))

/-- A nonzero series in the variable `e^h`, for `N h ≠ 0`, is a nonzerodivisor. This includes
Laurent series with negative powers and does not require the ambient group to be torsion-free. -/
theorem mem_nonZeroDivisors_of_support_subset_zmultiples [NoZeroDivisors R] {h : H}
    (hh : N h ≠ 0) {a : NovikovSeries R H N}
    (haH : a.support ⊆ (AddSubgroup.zmultiples h : Set H)) (ha : a ≠ 0) :
    a ∈ (NovikovSeries R H N)⁰ := by
  exact mem_nonZeroDivisors_of_support_subset_of_injective_period
    (N.comp_zmultiples_subtype_injective hh) haH ha

end Subgroup

variable [CommRing R] {K : AddSubgroup H}

/-- The subgroup completion embeds into every nontrivial ring image of the ambient total
quotient ring if periods are injective on the subgroup and the ground ring has no zero divisors.
In particular it embeds into each field component. -/
theorem comp_algebraMap_addSubgroup_injective_of_injective_period [NoZeroDivisors R]
    (hN : Function.Injective (N.comp K.subtype))
    (Q : Type*) [CommRing Q] [Algebra (NovikovSeries R H N) Q]
    [IsFractionRing (NovikovSeries R H N) Q] {F : Type*} [Ring F] [Nontrivial F] (f : Q →+* F) :
    Function.Injective ((f.comp (algebraMap (NovikovSeries R H N) Q)).comp
      (algebraMap (NovikovSeries R K (N.comp K.subtype)) (NovikovSeries R H N))) := by
  apply (injective_iff_map_eq_zero _).2
  intro a ha
  by_contra ha0
  have hu := IsLocalization.map_units Q
    ⟨_, algebraMap_addSubgroup_mem_nonZeroDivisors_of_injective_period hN ha0⟩
  exact (hu.map f).ne_zero ha

/-- For an exponent of nonzero period, the cyclic subgroup completion embeds into every
nontrivial ring image of the ambient total quotient ring, in particular each field component. -/
theorem comp_algebraMap_zmultiples_injective [NoZeroDivisors R] {h : H} (hh : N h ≠ 0)
    (Q : Type*) [CommRing Q] [Algebra (NovikovSeries R H N) Q]
    [IsFractionRing (NovikovSeries R H N) Q] {F : Type*} [Ring F] [Nontrivial F] (f : Q →+* F) :
    Function.Injective ((f.comp (algebraMap (NovikovSeries R H N) Q)).comp
      (algebraMap (NovikovSeries R (AddSubgroup.zmultiples h)
        (N.comp (AddSubgroup.zmultiples h).subtype)) (NovikovSeries R H N))) := by
  exact comp_algebraMap_addSubgroup_injective_of_injective_period
    (N.comp_zmultiples_subtype_injective hh) Q f

end TauCeti.NovikovSeries
