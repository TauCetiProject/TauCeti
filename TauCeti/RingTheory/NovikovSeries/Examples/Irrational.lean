module

public import TauCeti.RingTheory.NovikovSeries.LeadingTerm
public import TauCeti.RingTheory.NovikovSeries.TopologicalRing
public import Mathlib.NumberTheory.Real.Irrational

/-!
# An irrational Novikov completion with an infinite period kernel

The period on `ℤ × ℤ × ℤ` is `(a,b,c) ↦ a + √2 * b`. Its kernel is precisely the
third coordinate axis. The series `(1 + e^(0,0,1)) ∑ₙ e^(n,0,0)` has infinite support,
but only two coefficients at its least period. Its support periods tend to infinity, and
its finite period truncations converge in the Novikov topology. The infinite sum uses the
monomial geometric-series construction of `NovikovSeries.TopologicalRing`.
-/

public section

noncomputable section

open Filter Function Set Topology

namespace TauCeti.NovikovSeries.IrrationalExample

/-- The irrational period with a third coordinate invisible to the period. -/
def period : (ℤ × ℤ × ℤ) →+ ℝ where
  toFun h := h.1 + Real.sqrt 2 * h.2.1
  map_zero' := by simp
  map_add' _ _ := by simp; ring

@[simp]
theorem period_apply (a b c : ℤ) : period (a, b, c) = a + Real.sqrt 2 * b :=
  (rfl)

/-- The second coordinate has genuinely irrational period. -/
theorem irrational_period : Irrational (period (0, 1, 0)) := by
  simpa using irrational_sqrt_two

/-- The irrationality of `√2` identifies the period kernel exactly. -/
theorem period_eq_zero_iff (h : ℤ × ℤ × ℤ) :
    period h = 0 ↔ h.1 = 0 ∧ h.2.1 = 0 := by
  rcases h with ⟨a, b, c⟩
  simp only [period_apply]
  constructor
  · intro h
    have hb : b = 0 := by
      by_contra hb
      exact (irrational_sqrt_two.mul_intCast hb).ne_int (-a) (by push_cast; linarith)
    simp_all
  · rintro ⟨rfl, rfl⟩
    simp

/-- The kernel is generated by the third coordinate vector. -/
theorem ker_period : period.ker = AddSubgroup.zmultiples (0, 0, (1 : ℤ)) := by
  ext ⟨a, b, c⟩
  simp only [AddMonoidHom.mem_ker, period_eq_zero_iff, AddSubgroup.mem_zmultiples_iff]
  constructor
  · rintro ⟨rfl, rfl⟩
    exact ⟨c, by simp⟩
  · rintro ⟨k, hk⟩
    simpa using congrArg (fun h : ℤ × ℤ × ℤ => (h.1, h.2.1)) hk.symm

/-- The ignored third coordinate makes this period noninjective. -/
theorem not_injective_period : ¬Injective period := by
  intro h
  have := h (a₁ := (0, 0, 0)) (a₂ := (0, 0, 1)) (by simp)
  norm_num at this

/-- Every integer occurs as the third coordinate of a kernel element. -/
theorem infinite_ker_period : (period.ker : Set (ℤ × ℤ × ℤ)).Infinite := by
  have hinj : Injective fun c : ℤ => ((0, 0, c) : ℤ × ℤ × ℤ) :=
    fun a b h => congrArg (fun x : ℤ × ℤ × ℤ => x.2.2) h
  refine (infinite_range_of_injective hinj).mono ?_
  rintro _ ⟨c, rfl⟩
  exact AddMonoidHom.mem_ker.2 (by simp)

private def geometric : NovikovSeries ℤ (ℤ × ℤ × ℤ) period :=
  ∑' n : ℕ, (single (1, 0, 0) 1 : NovikovSeries ℤ (ℤ × ℤ × ℤ) period) ^ n

private theorem summable_geometric :
    Summable fun n : ℕ =>
      (single (1, 0, 0) 1 : NovikovSeries ℤ (ℤ × ℤ × ℤ) period) ^ n :=
  (isTopologicallyNilpotent_single (by simp : 0 < period (1, 0, 0)) 1).summable_pow

open Classical in
private theorem coeff_geometric (h : ℤ × ℤ × ℤ) :
    geometric.coeff h = if ∃ n : ℕ, h = ((n : ℤ), 0, 0) then 1 else 0 := by
  let φ : NovikovSeries ℤ (ℤ × ℤ × ℤ) period →+ ℤ :=
    (Pi.evalAddMonoidHom _ h).comp coeffAddMonoidHom
  have hφeq : (φ : NovikovSeries ℤ (ℤ × ℤ × ℤ) period → ℤ) =
      fun a => a.coeff h := by
    funext a
    simp [φ]
  have hφ : Continuous φ := by
    rw [hφeq]
    exact (isLocallyConstant_coeff h).continuous
  have hsum := summable_geometric.hasSum.map φ hφ
  have heq : geometric.coeff h =
      ∑' n : ℕ, (single (n • (1, 0, 0)) 1 :
        NovikovSeries ℤ (ℤ × ℤ × ℤ) period).coeff h := by
    simpa only [φ, geometric, single_pow, one_pow, Function.comp_apply,
      AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply, coeffAddMonoidHom_apply]
      using hsum.tsum_eq.symm
  rw [heq]
  split_ifs with hh
  · obtain ⟨n, rfl⟩ := hh
    rw [tsum_eq_single n]
    · simp
    · intro m hm
      apply coeff_single_of_ne
      intro hmn
      have := congrArg Prod.fst hmn
      simp at this
      exact hm (by exact_mod_cast this.symm)
  · trans ∑' _ : ℕ, (0 : ℤ)
    · apply tsum_congr
      intro n
      apply coeff_single_of_ne
      intro hn
      exact hh ⟨n, by simpa using hn⟩
    · simp

/-- An infinite series with two coefficients at each nonnegative integral period. -/
def series : NovikovSeries ℤ (ℤ × ℤ × ℤ) period :=
  geometric + single (0, 0, 1) 1 * geometric

/-- The coefficients retain both exponents in each tied period fiber. -/
@[simp]
theorem coeff_series (a b c : ℤ) :
    series.coeff (a, b, c) = if 0 ≤ a ∧ b = 0 ∧ (c = 0 ∨ c = 1) then 1 else 0 := by
  simp only [series, coeff_add, coeff_single_mul, one_mul, coeff_geometric]
  have hex (d : ℤ) : (∃ n : ℕ, (a, b, d) = ((n : ℤ), 0, 0)) ↔
      0 ≤ a ∧ b = 0 ∧ d = 0 := by
    simp only [Prod.mk.injEq]
    constructor
    · rintro ⟨n, rfl, rfl, rfl⟩
      exact ⟨Int.natCast_nonneg n, rfl, rfl⟩
    · rintro ⟨ha, rfl, rfl⟩
      exact ⟨a.toNat, (Int.toNat_of_nonneg ha).symm, rfl, rfl⟩
  simp only [Prod.neg_mk, neg_zero, Prod.mk_add_mk, zero_add, hex]
  split_ifs <;> omega

/-- The support consists of two parallel nonnegative rays, one kernel unit apart. -/
theorem support_series :
    series.support = {h | 0 ≤ h.1 ∧ h.2.1 = 0 ∧ (h.2.2 = 0 ∨ h.2.2 = 1)} := by
  ext ⟨a, b, c⟩
  simp only [mem_support, coeff_series, Set.mem_ofPred_eq, ne_eq]
  split_ifs <;> omega

/-- The periods of this infinite support have least value zero. -/
theorem order_series : series.order = 0 := by
  refine order_eq_of_isLeast ⟨?_, ?_⟩
  · exact ⟨(0, 0, 0), by simp [support_series], by simp⟩
  · rintro _ ⟨⟨a, b, c⟩, hh, rfl⟩
    rw [support_series] at hh
    simp only [Set.mem_ofPred_eq] at hh
    have ha : (0 : ℝ) ≤ a := by exact_mod_cast hh.1
    simpa [hh.2.1] using ha

/-- Both tied coefficients survive in the group-ring leading term. -/
theorem leadingTerm_series :
    series.leadingTerm = AddMonoidAlgebra.single (0, 0, 0) 1 +
      AddMonoidAlgebra.single (0, 0, 1) 1 := by
  ext ⟨a, b, c⟩
  rw [coeff_leadingTerm, order_series]
  simp only [period_eq_zero_iff, coeff_series, AddMonoidAlgebra.coeff_add,
    AddMonoidAlgebra.coeff_single, Finsupp.add_apply, Finsupp.single_apply, Prod.mk.injEq]
  split_ifs <;> omega

/-- The leading support contains exactly two exponents, although the kernel is infinite. -/
theorem support_leadingTerm_series :
    series.leadingTerm.coeff.support = {(0, 0, 0), (0, 0, 1)} := by
  ext ⟨a, b, c⟩
  simp only [Finsupp.mem_support_iff, leadingTerm_series,
    AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_single, Finsupp.add_apply,
    Finsupp.single_apply, Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq]
  split_ifs <;> omega

/-- In particular the completed series is not a group-ring element. -/
theorem infinite_support_series : series.support.Infinite := by
  have hinj : Injective fun n : ℕ => (((n : ℤ), 0, 0) : ℤ × ℤ × ℤ) := by
    intro m n h
    have hmn : (m : ℤ) = n := congrArg Prod.fst h
    exact_mod_cast hmn
  refine (infinite_range_of_injective hinj).mono ?_
  rintro _ ⟨n, rfl⟩
  simp [support_series]

/-- Along either support ray, every real period cutoff is eventually exceeded. -/
theorem eventually_period_ge (C : ℝ) (c : ℤ) :
    ∀ᶠ n : ℕ in atTop, C ≤ period ((n : ℤ), 0, c) := by
  filter_upwards [eventually_ge_atTop ⌈C⌉₊] with n hn
  have hC : C ≤ (n : ℝ) := (Nat.le_ceil C).trans (by exact_mod_cast hn)
  simpa using hC

end TauCeti.NovikovSeries.IrrationalExample
