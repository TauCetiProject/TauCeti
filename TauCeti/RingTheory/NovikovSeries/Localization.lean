module

public import TauCeti.RingTheory.NovikovSeries.TopologicalRing
public import Mathlib.RingTheory.Localization.Basic

/-!
# Localization of the nonnegative Novikov subring along a period section

Let `H` be an additive monoid with period homomorphism `N : H →+ ℝ` admitting an additive right
inverse `ι : ℝ →+ H` (`∀ r, N (ι r) = r`). The nonnegative section monomials `single (ι r) 1`
(`0 ≤ r`) form a submonoid `TauCeti.NovikovSeries.periodSectionSubmonoid R hι` of
`TauCeti.NovikovSeries.nonnegSubring R N`, generated by the strictly positive ones (`0 < r`).

Over a commutative ring `R` and commutative `H`, `NovikovSeries R H N` is the localization of
`nonnegSubring R N` at `periodSectionSubmonoid R hι`
(`TauCeti.NovikovSeries.isLocalization_periodSectionSubmonoid`), giving the canonical
`nonnegSubring R N`-algebra equivalence `TauCeti.NovikovSeries.periodSectionLocalizationAlgEquiv`.
Specializing to `ι = AddMonoidHom.id ℝ` shows that `NovikovSeries R ℝ (AddMonoidHom.id ℝ)` is the
localization of its nonnegative subring at `TauCeti.NovikovSeries.realActionSubmonoid R`.

## Main definitions

* `TauCeti.NovikovSeries.nonnegPeriodSection`, `TauCeti.NovikovSeries.periodSectionSubmonoid`:
  the nonnegative section monomials `single (ι r) 1` (`0 ≤ r`) and their multiplicative submonoid.
* `TauCeti.NovikovSeries.periodSectionLocalizationAlgEquiv`: the canonical algebra isomorphism
  `Localization (periodSectionSubmonoid R hι) ≃ₐ[nonnegSubring R N] NovikovSeries R H N`.
* `TauCeti.NovikovSeries.realActionSubmonoid`: the submonoid `{single r 1 | 0 ≤ r}` of
  `nonnegSubring R (AddMonoidHom.id ℝ)`.

## Main results

* `TauCeti.NovikovSeries.periodSectionSubmonoid_eq_closure_pos`: equality with the submonoid
  generated by strictly positive section monomials.
* `TauCeti.NovikovSeries.isLocalization_periodSectionSubmonoid`: localization of
  `nonnegSubring R N` at `periodSectionSubmonoid R hι` recovers `NovikovSeries R H N`.
* `TauCeti.NovikovSeries.not_isUnit_nonnegPeriodSection_of_pos`: over a nontrivial ring, strictly
  positive section monomials are not units of `nonnegSubring R N`.
* `TauCeti.NovikovSeries.realActionSubmonoid_eq_closure_pos` and
  `TauCeti.NovikovSeries.isLocalization_realActionSubmonoid`: the real Novikov specialization.

## References

* K. Fukaya, Y.-G. Oh, H. Ohta, and K. Ono, *Lagrangian Intersection Floer Theory: Anomaly and
  Obstruction*, AMS/IP Studies in Advanced Mathematics 46, 2009, Chapter 2.
* H. Hofer and D. A. Salamon, *Floer homology and Novikov rings*, in *The Floer memorial
  volume*, Progr. Math. 133 (1995), 483–524.
-/

public section

noncomputable section

namespace TauCeti.NovikovSeries

section PeriodSection

section AddMonoid

variable {R H : Type*} [Ring R] [AddMonoid H] {N : H →+ ℝ} {ι : ℝ →+ H}

/-- For a right inverse `ι : ℝ →+ H` of `N` and `r ≥ 0`, the nonnegative section monomial
`single (ι r) 1` in `nonnegSubring R N`. -/
def nonnegPeriodSection (R : Type*) [Ring R] (hι : ∀ r, N (ι r) = r) {r : ℝ} (hr : 0 ≤ r) :
    nonnegSubring R N :=
  ⟨single (ι r) 1, single_mem_nonnegSubring (by rw [hι]; exact hr) 1⟩

@[simp]
theorem coe_nonnegPeriodSection (hι : ∀ r, N (ι r) = r) {r : ℝ} (hr : 0 ≤ r) :
    (nonnegPeriodSection R hι hr : NovikovSeries R H N) = single (ι r) 1 := (rfl)

@[simp]
theorem nonnegPeriodSection_zero (hι : ∀ r, N (ι r) = r) :
    nonnegPeriodSection R hι le_rfl = 1 :=
  Subtype.ext <| by simp [nonnegPeriodSection, single_zero_one]

@[simp]
theorem nonnegPeriodSection_mul (hι : ∀ r, N (ι r) = r) {r s : ℝ} (hr : 0 ≤ r) (hs : 0 ≤ s) :
    nonnegPeriodSection R hι hr * nonnegPeriodSection R hι hs =
      nonnegPeriodSection R hι (add_nonneg hr hs) :=
  Subtype.ext <| by simp [nonnegPeriodSection, map_add, single_mul_single]

/-- A section monomial of strictly positive weight lies in `posIdeal R N`. -/
theorem nonnegPeriodSection_mem_posIdeal (hι : ∀ r, N (ι r) = r) {r : ℝ} (hr : 0 < r) :
    nonnegPeriodSection R hι hr.le ∈ posIdeal R N :=
  single_mem_posIdeal (by rw [hι]; exact hr) 1

/-- Over a nontrivial ring, a strictly positive section monomial is not a unit of
`nonnegSubring R N`. -/
theorem not_isUnit_nonnegPeriodSection_of_pos [Nontrivial R] (hι : ∀ r, N (ι r) = r) {r : ℝ}
    (hr : 0 < r) : ¬ IsUnit (nonnegPeriodSection R hι hr.le) :=
  not_isUnit_of_mem_posIdeal (nonnegPeriodSection_mem_posIdeal hι hr)

/-- The multiplicative submonoid of `nonnegSubring R N` formed by the nonnegative section
monomials `{single (ι r) 1 | 0 ≤ r}`. -/
def periodSectionSubmonoid (R : Type*) [Ring R] (hι : ∀ r, N (ι r) = r) :
    Submonoid (nonnegSubring R N) where
  carrier := {a | ∃ (r : ℝ) (hr : 0 ≤ r), a = nonnegPeriodSection R hι hr}
  one_mem' := ⟨0, le_rfl, (nonnegPeriodSection_zero hι).symm⟩
  mul_mem' := by
    rintro _ _ ⟨r, hr, rfl⟩ ⟨s, hs, rfl⟩
    exact ⟨r + s, add_nonneg hr hs, nonnegPeriodSection_mul hι hr hs⟩

@[simp]
theorem mem_periodSectionSubmonoid (hι : ∀ r, N (ι r) = r) {a : nonnegSubring R N} :
    a ∈ periodSectionSubmonoid R hι ↔ ∃ (r : ℝ) (hr : 0 ≤ r), a = nonnegPeriodSection R hι hr :=
  Iff.rfl

theorem nonnegPeriodSection_mem_periodSectionSubmonoid (hι : ∀ r, N (ι r) = r) {r : ℝ}
    (hr : 0 ≤ r) : nonnegPeriodSection R hι hr ∈ periodSectionSubmonoid R hι :=
  ⟨r, hr, rfl⟩

/-- The submonoid of nonnegative section monomials coincides with the submonoid generated by the
strictly positive section monomials: `r = 0` contributes the identity `1`. -/
theorem periodSectionSubmonoid_eq_closure_pos (hι : ∀ r, N (ι r) = r) :
    periodSectionSubmonoid R hι =
      Submonoid.closure {a | ∃ (r : ℝ) (hr : 0 < r), a = nonnegPeriodSection R hι hr.le} := by
  refine le_antisymm ?_ (Submonoid.closure_le.2 fun _ ⟨r, hr, h⟩ => ⟨r, hr.le, h⟩)
  rintro _ ⟨r, hr, rfl⟩
  rcases hr.eq_or_lt with rfl | hpos
  · rw [nonnegPeriodSection_zero]; exact one_mem _
  · exact Submonoid.subset_closure ⟨r, hpos, rfl⟩

end AddMonoid

section CommRing

variable {R H : Type*} [AddCommMonoid H] {N : H →+ ℝ} [CommRing R] {ι : ℝ →+ H}

/-- **Localization of the nonnegative Novikov subring along a period section.** Whenever
`ι : ℝ →+ H` satisfies `∀ r, N (ι r) = r`, `NovikovSeries R H N` is the localization of
`nonnegSubring R N` at `periodSectionSubmonoid R hι`. -/
instance isLocalization_periodSectionSubmonoid (hι : ∀ r, N (ι r) = r) :
    IsLocalization (periodSectionSubmonoid R hι) (NovikovSeries R H N) := by
  rw [isLocalization_iff]
  refine ⟨?_, ?_, fun hxy => ⟨1, by simp [Subtype.ext hxy]⟩⟩
  · rintro ⟨_, r, hr, rfl⟩
    refine isUnit_iff_exists.2 ⟨single (ι (-r)) 1, ?_, ?_⟩ <;>
      simp [Algebra.algebraMap_ofSubsemiring_apply, single_mul_single, ← map_add, single_zero_one]
  · intro z
    obtain ⟨m, hm⟩ := exists_mem_periodFiltration z
    let r : ℝ := max (-m) 0
    have hr : 0 ≤ r := le_max_right _ _
    have hz : z * single (ι r) 1 ∈ nonnegSubring R N :=
      mem_nonnegSubring.2 <| mem_periodFiltration.1 <|
        antitone_periodFiltration (by rw [hι]; linarith [le_max_left (-m) 0])
          (mul_mem_periodFiltration hm (single_mem_periodFiltration (ι r) 1))
    exact ⟨(⟨z * single (ι r) 1, hz⟩,
      ⟨nonnegPeriodSection R hι hr, nonnegPeriodSection_mem_periodSectionSubmonoid hι hr⟩), rfl⟩

/-- The canonical `nonnegSubring R N`-algebra isomorphism from
`Localization (periodSectionSubmonoid R hι)` onto `NovikovSeries R H N`. -/
def periodSectionLocalizationAlgEquiv (R : Type*) [CommRing R] (hι : ∀ r, N (ι r) = r) :
    Localization (periodSectionSubmonoid R hι) ≃ₐ[nonnegSubring R N] NovikovSeries R H N :=
  Localization.algEquiv (periodSectionSubmonoid R hι) (NovikovSeries R H N)

theorem periodSectionLocalizationAlgEquiv_algebraMap (hι : ∀ r, N (ι r) = r)
    (a : nonnegSubring R N) :
    periodSectionLocalizationAlgEquiv R hι
      (algebraMap (nonnegSubring R N) (Localization (periodSectionSubmonoid R hι)) a) =
      (a : NovikovSeries R H N) :=
  (periodSectionLocalizationAlgEquiv R hι).commutes a

@[simp]
theorem periodSectionLocalizationAlgEquiv_mk' (hι : ∀ r, N (ι r) = r) (a : nonnegSubring R N)
    (s : periodSectionSubmonoid R hι) :
    periodSectionLocalizationAlgEquiv R hι
      (IsLocalization.mk' (Localization (periodSectionSubmonoid R hι)) a s) =
      IsLocalization.mk' (NovikovSeries R H N) a s :=
  Localization.algEquiv_mk' a s

@[simp]
theorem periodSectionLocalizationAlgEquiv_symm_mk' (hι : ∀ r, N (ι r) = r) (a : nonnegSubring R N)
    (s : periodSectionSubmonoid R hι) :
    (periodSectionLocalizationAlgEquiv R hι).symm (IsLocalization.mk' (NovikovSeries R H N) a s) =
      IsLocalization.mk' (Localization (periodSectionSubmonoid R hι)) a s :=
  Localization.algEquiv_symm_mk' a s

@[simp]
theorem periodSectionLocalizationAlgEquiv_mk (hι : ∀ r, N (ι r) = r) (a : nonnegSubring R N)
    {r : ℝ} (hr : 0 ≤ r) :
    periodSectionLocalizationAlgEquiv R hι (Localization.mk a
      ⟨nonnegPeriodSection R hι hr, nonnegPeriodSection_mem_periodSectionSubmonoid hι hr⟩) =
      (a : NovikovSeries R H N) * single (ι (-r)) 1 := by
  rw [periodSectionLocalizationAlgEquiv, Localization.algEquiv_mk, IsLocalization.mk'_eq_iff_eq_mul,
    Algebra.algebraMap_ofSubsemiring_apply, Algebra.algebraMap_ofSubsemiring_apply,
    coe_nonnegPeriodSection, mul_assoc, single_mul_single, ← map_add, neg_add_cancel, map_zero,
    mul_one, single_zero_one, mul_one]

@[simp]
theorem periodSectionLocalizationAlgEquiv_symm_coe (hι : ∀ r, N (ι r) = r)
    (a : nonnegSubring R N) :
    (periodSectionLocalizationAlgEquiv R hι).symm (a : NovikovSeries R H N) =
      algebraMap (nonnegSubring R N) (Localization (periodSectionSubmonoid R hι)) a :=
  (periodSectionLocalizationAlgEquiv R hι).symm_apply_eq.2
    (periodSectionLocalizationAlgEquiv_algebraMap hι a).symm

@[simp]
theorem periodSectionLocalizationAlgEquiv_symm_single_neg (hι : ∀ r, N (ι r) = r) {r : ℝ}
    (hr : 0 ≤ r) :
    (periodSectionLocalizationAlgEquiv R hι).symm (single (ι (-r)) 1) = Localization.mk 1
      ⟨nonnegPeriodSection R hι hr, nonnegPeriodSection_mem_periodSectionSubmonoid hι hr⟩ := by
  rw [AlgEquiv.symm_apply_eq, periodSectionLocalizationAlgEquiv_mk, OneMemClass.coe_one, one_mul]

theorem periodSectionLocalizationAlgEquiv_symm_mul_single_neg (hι : ∀ r, N (ι r) = r)
    (a : nonnegSubring R N) {r : ℝ} (hr : 0 ≤ r) :
    (periodSectionLocalizationAlgEquiv R hι).symm ((a : NovikovSeries R H N) * single (ι (-r)) 1) =
      Localization.mk a
        ⟨nonnegPeriodSection R hι hr, nonnegPeriodSection_mem_periodSectionSubmonoid hι hr⟩ :=
  (periodSectionLocalizationAlgEquiv R hι).symm_apply_eq.2
    (periodSectionLocalizationAlgEquiv_mk hι a hr).symm

end CommRing

end PeriodSection

/-! ### Localization of the nonnegative real Novikov subring -/

section Real

/-- The multiplicative submonoid `{single r 1 | 0 ≤ r}` of nonnegative real monomials in
`nonnegSubring R (AddMonoidHom.id ℝ)`. -/
def realActionSubmonoid (R : Type*) [Ring R] :
    Submonoid (nonnegSubring R (AddMonoidHom.id ℝ)) :=
  periodSectionSubmonoid R (N := AddMonoidHom.id ℝ) (ι := AddMonoidHom.id ℝ) fun _ => rfl

@[simp]
theorem mem_realActionSubmonoid {R : Type*} [Ring R] {a : nonnegSubring R (AddMonoidHom.id ℝ)} :
    a ∈ realActionSubmonoid R ↔
      ∃ (r : ℝ) (hr : 0 ≤ r), a = ⟨single r 1, single_mem_nonnegSubring hr 1⟩ :=
  Iff.rfl

/-- Every nonnegative real monomial `single r 1` (`0 ≤ r`) belongs to `realActionSubmonoid R`. -/
theorem single_mem_realActionSubmonoid {R : Type*} [Ring R] {r : ℝ} (hr : 0 ≤ r) :
    (⟨single r 1, single_mem_nonnegSubring hr 1⟩ : nonnegSubring R (AddMonoidHom.id ℝ)) ∈
      realActionSubmonoid R :=
  ⟨r, hr, rfl⟩

/-- `realActionSubmonoid R` equals the submonoid generated by the strictly positive real
monomials `{single r 1 | 0 < r}`. -/
theorem realActionSubmonoid_eq_closure_pos (R : Type*) [Ring R] :
    realActionSubmonoid R = Submonoid.closure {a : nonnegSubring R (AddMonoidHom.id ℝ) |
      ∃ (r : ℝ) (hr : 0 < r), a = ⟨single r 1, single_mem_nonnegSubring hr.le 1⟩} :=
  periodSectionSubmonoid_eq_closure_pos (N := AddMonoidHom.id ℝ) (ι := AddMonoidHom.id ℝ)
    fun _ => rfl

/-- Localizing `nonnegSubring R (AddMonoidHom.id ℝ)` at the nonnegative (equivalently, strictly
positive) real monomials recovers `NovikovSeries R ℝ (AddMonoidHom.id ℝ)`. -/
instance isLocalization_realActionSubmonoid (R : Type*) [CommRing R] :
    IsLocalization (realActionSubmonoid R) (NovikovSeries R ℝ (AddMonoidHom.id ℝ)) :=
  isLocalization_periodSectionSubmonoid (N := AddMonoidHom.id ℝ) (ι := AddMonoidHom.id ℝ)
    fun _ => rfl

end Real

end TauCeti.NovikovSeries
