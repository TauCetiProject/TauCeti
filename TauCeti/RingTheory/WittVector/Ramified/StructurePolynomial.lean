module

public import TauCeti.RingTheory.WittVector.Ramified.Ghost

import Mathlib.RingTheory.MvPolynomial.Expand
import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import TauCeti.RingTheory.MvPolynomial.RegularSequence

/-!
# Ramified Witt structure polynomials

Let `O` be a local ring with finite residue field of cardinality `q` and maximal ideal
generated by a nonzerodivisor `π`. For a polynomial `Φ` over `O`, the ramified Witt structure
polynomials are the unique family `s` over `O` whose `n`-th ghost applies `Φ` to the `n`-th
ghosts of the inputs.

The universal input algebra is a polynomial ring over `O`. Expansion by `q` lifts Frobenius on
this algebra modulo `π`, so Dwork's criterion constructs the structure polynomials there.
Evaluation gives the ghost identities in every `O`-algebra, including those with `π`-torsion.

The construction follows Fargues and Fontaine, *Courbes et fibrés vectoriels en théorie de
Hodge p-adique*, Astérisque 406 (2018), §1.2.1, Lemme 1.2.1. The API parallels Mathlib's
`wittStructureInt` and Tau Ceti's `BigWitt.wittStructure`.
-/

public section

namespace TauCeti

open IsLocalRing MvPolynomial

variable {O : Type*} [CommRing O] [IsLocalRing O] [Finite (ResidueField O)]
  {π : O} {ι : Type*}

local notation "q" => Nat.card (ResidueField O)

/-- Universal existence and uniqueness of the structure polynomials for a polynomial operation
on ramified ghosts. -/
theorem existsUnique_ramifiedGhost_eq_aeval (hπ : maximalIdeal O = Ideal.span {π})
    (hreg : π ∈ nonZeroDivisors O) (Φ : MvPolynomial ι O) :
    ∃! s : ℕ → MvPolynomial (ι × ℕ) O, ∀ n, ramifiedGhost π q n s =
      aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ X (i, k))) Φ := by
  let σ : MvPolynomial (ι × ℕ) O →ₐ[O] MvPolynomial (ι × ℕ) O := expand q
  have : Fintype (ResidueField O) := Fintype.ofFinite _
  have hker (r : O) : residue O r = 0 ↔ π ∣ r := by
    rw [residue_eq_zero_iff, hπ, Ideal.mem_span_singleton]
  have hσ (a : MvPolynomial (ι × ℕ) O) : C π ∣ σ a - a ^ q := by
    rw [C_dvd_iff_map_hom_eq_zero (residue O) π hker]
    simp [σ, Nat.card_eq_fintype_card, map_expand, FiniteField.MvPolynomial.expand_card]
  let y (n : ℕ) : MvPolynomial (ι × ℕ) O :=
    aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ X (i, k))) Φ
  have hq : C π ∣ (q : MvPolynomial (ι × ℕ) O) := by
    refine map_dvd C ((hker (q : O)).1 ?_)
    rw [map_natCast, Nat.card_eq_fintype_card]
    exact Nat.cast_card_eq_zero (ResidueField O)
  have hy (n : ℕ) : C π ^ (n + 1) ∣ y (n + 1) - σ (y n) := by
    rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq, ← Ideal.Quotient.mkₐ_eq_mk O]
    simp only [y, comp_aeval_apply]
    congr 2
    funext i
    exact Ideal.Quotient.eq.2 (Ideal.mem_span_singleton.2
      (pow_succ_dvd_ramifiedGhost_succ_sub hq σ hσ n (fun k ↦ X (i, k))))
  obtain ⟨s, hs⟩ := (exists_ramifiedGhost_natCard_residueField_eq_iff hπ.le σ hσ y).2 hy
  refine ⟨s, hs, fun t ht ↦ ramifiedGhost_injective ?_ (funext fun n ↦ (ht n).trans (hs n).symm)⟩
  exact isRegular_iff_mem_nonZeroDivisors.1 (isLeftRegular_iff_isRegular.1
    (isSMulRegular_C_iff.2 (isRegular_iff_mem_nonZeroDivisors.2 hreg).left.isSMulRegular))

/-- The `n`-th ramified Witt structure polynomial of `Φ`. Its variables `X (i, k)` represent
coordinate `k` of input `i`. -/
noncomputable def ramifiedWittStructure (hπ : maximalIdeal O = Ideal.span {π})
    (hreg : π ∈ nonZeroDivisors O) (Φ : MvPolynomial ι O) (n : ℕ) : MvPolynomial (ι × ℕ) O :=
  (existsUnique_ramifiedGhost_eq_aeval hπ hreg Φ).exists.choose n

variable (hπ : maximalIdeal O = Ideal.span {π}) (hreg : π ∈ nonZeroDivisors O)

/-- Taking the `n`-th ghost of the structure polynomials applies `Φ` to the `n`-th ghosts
of the universal inputs. -/
theorem ramifiedGhost_ramifiedWittStructure (Φ : MvPolynomial ι O) (n : ℕ) :
    ramifiedGhost π q n (ramifiedWittStructure hπ hreg Φ) =
      aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ X (i, k))) Φ :=
  (existsUnique_ramifiedGhost_eq_aeval hπ hreg Φ).exists.choose_spec n

/-- A polynomial family with the prescribed ghosts is the family of structure polynomials. -/
theorem eq_ramifiedWittStructure_of_ramifiedGhost_eq (Φ : MvPolynomial ι O)
    {s : ℕ → MvPolynomial (ι × ℕ) O}
    (hs : ∀ n, ramifiedGhost π q n s =
      aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ X (i, k))) Φ) :
    s = ramifiedWittStructure hπ hreg Φ :=
  (existsUnique_ramifiedGhost_eq_aeval hπ hreg Φ).unique hs
    (ramifiedGhost_ramifiedWittStructure hπ hreg Φ)

@[simp]
theorem ramifiedWittStructure_zero (Φ : MvPolynomial ι O) :
    ramifiedWittStructure hπ hreg Φ 0 = rename (fun i ↦ (i, 0)) Φ := by
  simpa [rename_eq_aeval, Function.comp_def] using
    ramifiedGhost_ramifiedWittStructure hπ hreg Φ 0

/-- A projection onto one input selects its corresponding coordinate. -/
@[simp]
theorem ramifiedWittStructure_X (i : ι) (n : ℕ) :
    ramifiedWittStructure hπ hreg (X i) n = X (i, n) :=
  (congrFun (eq_ramifiedWittStructure_of_ramifiedGhost_eq hπ hreg (X i)
    (s := fun k ↦ X (i, k)) (fun k ↦ by rw [aeval_X])) n).symm

/-- The ghost identity after evaluating the structure polynomials in an arbitrary coefficient
algebra. -/
theorem ramifiedGhost_aeval_ramifiedWittStructure {A : Type*} [CommRing A] [Algebra O A]
    (Φ : MvPolynomial ι O) (v : ι × ℕ → A) (n : ℕ) :
    ramifiedGhost π q n (fun k ↦ aeval v (ramifiedWittStructure hπ hreg Φ k)) =
      aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ v (i, k))) Φ := by
  have h := congrArg (aeval v) (ramifiedGhost_ramifiedWittStructure hπ hreg Φ n)
  rw [comp_aeval_apply] at h
  simpa only [map_ramifiedGhost, aeval_X] using h

/-- Substitution of polynomial operations on ramified Witt coordinates is computed by substituting
the corresponding structure polynomials. -/
theorem ramifiedWittStructure_aeval {κ : Type*} (f : κ → MvPolynomial ι O)
    (Φ : MvPolynomial κ O) (n : ℕ) :
    ramifiedWittStructure hπ hreg (aeval f Φ) n =
      aeval (fun ik : κ × ℕ ↦ ramifiedWittStructure hπ hreg (f ik.1) ik.2)
        (ramifiedWittStructure hπ hreg Φ n) := by
  symm
  refine congrFun (eq_ramifiedWittStructure_of_ramifiedGhost_eq hπ hreg (aeval f Φ)
    (s := fun k ↦ aeval _ (ramifiedWittStructure hπ hreg Φ k)) fun k ↦ ?_) n
  rw [ramifiedGhost_aeval_ramifiedWittStructure, comp_aeval_apply]
  simp only [ramifiedGhost_ramifiedWittStructure]

/-- When the uniformizer and residue cardinality are both `p`, the ramified structure
polynomials of an integer polynomial are the base changes of Mathlib's `p`-typical ones. -/
theorem ramifiedWittStructure_natCast_eq_map_wittStructureInt {p : ℕ} [Fact p.Prime]
    (hq : q = p) (hp : maximalIdeal O = Ideal.span {(p : O)})
    (hpreg : (p : O) ∈ nonZeroDivisors O) (Φ : MvPolynomial ι ℤ) (n : ℕ) :
    ramifiedWittStructure hp hpreg (map (Int.castRingHom O) Φ) n =
      map (Int.castRingHom O) (wittStructureInt p Φ n) := by
  symm
  refine congrFun (eq_ramifiedWittStructure_of_ramifiedGhost_eq hp hpreg _
    (s := fun k ↦ map (Int.castRingHom O) (wittStructureInt p Φ k)) fun k ↦ ?_) n
  have h := congrArg (map (σ := ι × ℕ) (Int.castRingHom O)) (wittStructureInt_prop p Φ k)
  rw [map_aeval_eq_aeval_map (Int.castRingHom O) _ (Subsingleton.elim _ _),
    map_aeval_eq_aeval_map (Int.castRingHom O) _ (Subsingleton.elim _ _),
    map_wittPolynomial] at h
  rw [hq]
  simp only [map_rename, map_wittPolynomial] at h
  simpa only [← ramifiedWittPolynomial_natCast_self,
    rename_eq_aeval, Function.comp_def, aeval_ramifiedWittPolynomial] using h

end TauCeti
