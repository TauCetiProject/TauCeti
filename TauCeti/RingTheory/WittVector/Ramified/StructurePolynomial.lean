/-!
# Ramified Witt structure polynomials

For a commutative ring `O`, regular `π` dividing `q`, and a lift of the `q`-th power map on
the universal input algebra, every polynomial operation `Φ` has a unique family of structure
polynomials whose `n`-th ghost applies `Φ` to the `n`-th ghosts of the inputs. The canonical
construction specializes to local rings with finite residue field of cardinality `q` and maximal
ideal generated by `π`.

The universal input algebra is a polynomial ring over `O`. In the finite-residue specialization,
expansion by `q` lifts Frobenius on this algebra modulo `π`, so Dwork's criterion constructs the
structure polynomials there.
Evaluation gives the ghost identities and dependence on input coordinates through `n` in every
`O`-algebra, including those with `π`-torsion. Coefficient transport identifies any prescribed-ghost
family with the canonical structure polynomials over the target coefficient ring.

The construction follows Fargues and Fontaine, *Courbes et fibrés vectoriels en théorie de
Hodge p-adique*, Astérisque 406 (2018), §1.2.1, Lemme 1.2.1. The API parallels Mathlib's
`wittStructureInt` and Tau Ceti's `BigWitt.wittStructure`.
-/

public section

namespace TauCeti

open IsLocalRing MvPolynomial

variable {O : Type*} [CommRing O] {π : O} {ι : Type*}

/-- Universal existence and uniqueness of structure polynomials over any coefficient ring
with regular `π`, `π ∣ q`, and a lift of the `q`-th power map on the universal input algebra. -/
theorem existsUnique_ramifiedGhost_eq_aeval_of_frobeniusLift {q : ℕ}
    (hreg : π ∈ nonZeroDivisors O) (hq : π ∣ (q : O))
    (σ : MvPolynomial (ι × ℕ) O →ₐ[O] MvPolynomial (ι × ℕ) O)
    (hσ : ∀ a, C π ∣ σ a - a ^ q) (Φ : MvPolynomial ι O) :
    ∃! s : ℕ → MvPolynomial (ι × ℕ) O, ∀ n, ramifiedGhost π q n s =
      aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ X (i, k))) Φ := by
  have hq' : C π ∣ (q : MvPolynomial (ι × ℕ) O) := by simpa using map_dvd C hq
  have hx (i : ι) := (exists_ramifiedGhost_eq_iff hq' σ hσ
    (fun n ↦ ramifiedGhost π q n (fun k ↦ X (i, k)))).1 ⟨_, fun _ ↦ rfl⟩
  let y (n : ℕ) : MvPolynomial (ι × ℕ) O :=
    aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ X (i, k))) Φ
  have hy (n : ℕ) : C π ^ (n + 1) ∣ y (n + 1) - σ (y n) := by
    rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq, ← Ideal.Quotient.mkₐ_eq_mk O]
    simp only [y, comp_aeval_apply]
    apply congrArg (fun v ↦ aeval v Φ)
    funext i
    exact Ideal.Quotient.eq.2 (Ideal.mem_span_singleton.2 (hx i n))
  obtain ⟨s, hs⟩ := (exists_ramifiedGhost_eq_iff hq' σ hσ y).2 hy
  refine ⟨s, hs, fun t ht ↦ ramifiedGhost_injective (q := q)
    (C_mem_nonZeroDivisors hreg) ?_⟩
  exact funext fun n ↦ (ht n).trans (hs n).symm

variable [IsLocalRing O] [Finite (ResidueField O)]

local notation "q" => Nat.card (ResidueField O)

/-- Universal existence and uniqueness of structure polynomials over a local ring whose
maximal ideal is generated by regular `π` and whose residue field is finite. -/
theorem existsUnique_ramifiedGhost_eq_aeval (hπ : maximalIdeal O = Ideal.span {π})
    (hreg : π ∈ nonZeroDivisors O) (Φ : MvPolynomial ι O) :
    ∃! s : ℕ → MvPolynomial (ι × ℕ) O, ∀ n, ramifiedGhost π q n s =
      aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ X (i, k))) Φ := by
  have : Fintype (ResidueField O) := Fintype.ofFinite _
  have hker (r : O) : residue O r = 0 ↔ π ∣ r := by
    rw [residue_eq_zero_iff, hπ, Ideal.mem_span_singleton]
  refine existsUnique_ramifiedGhost_eq_aeval_of_frobeniusLift hreg
    (dvd_natCard_residueField hπ.le) (expand q) (fun a ↦ ?_) Φ
  rw [C_dvd_iff_map_hom_eq_zero (residue O) π hker]
  simp [Nat.card_eq_fintype_card, map_expand, FiniteField.MvPolynomial.expand_card]

/-- The `n`-th ramified Witt structure polynomial of `Φ`. Its variables `X (i, k)` represent
coordinate `k` of input `i`. -/
noncomputable def ramifiedWittStructure (hπ : maximalIdeal O = Ideal.span {π})
    (hreg : π ∈ nonZeroDivisors O) (Φ : MvPolynomial ι O) (n : ℕ) : MvPolynomial (ι × ℕ) O :=
  (existsUnique_ramifiedGhost_eq_aeval hπ hreg Φ).exists.choose n

variable (hπ : maximalIdeal O = Ideal.span {π}) (hreg : π ∈ nonZeroDivisors O)

/-- Taking the `n`-th ghost of the structure polynomials applies `Φ` to the `n`-th ghosts
of the universal inputs. -/
theorem ramifiedGhost_ramifiedWittStructure (Φ : MvPolynomial ι O) (n : ℕ) :
    ramifiedGhost π q n (ramifiedWittStructure hπ hreg Φ) =
      aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ X (i, k))) Φ :=
  (existsUnique_ramifiedGhost_eq_aeval hπ hreg Φ).exists.choose_spec n

/-- A polynomial family with the prescribed ghosts is the family of structure polynomials. -/
theorem eq_ramifiedWittStructure_of_ramifiedGhost_eq (Φ : MvPolynomial ι O)
    {s : ℕ → MvPolynomial (ι × ℕ) O}
    (hs : ∀ n, ramifiedGhost π q n s =
      aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ X (i, k))) Φ) :
    s = ramifiedWittStructure hπ hreg Φ :=
  (existsUnique_ramifiedGhost_eq_aeval hπ hreg Φ).unique hs
    (ramifiedGhost_ramifiedWittStructure hπ hreg Φ)

/-- The zeroth structure polynomial applies the operation to the zeroth input coordinates. -/
@[simp]
theorem ramifiedWittStructure_zero (Φ : MvPolynomial ι O) :
    ramifiedWittStructure hπ hreg Φ 0 = rename (fun i ↦ (i, 0)) Φ := by
  simpa [rename_eq_aeval, Function.comp_def] using
    ramifiedGhost_ramifiedWittStructure hπ hreg Φ 0

/-- A projection onto one input selects its corresponding coordinate. -/
@[simp]
theorem ramifiedWittStructure_X (i : ι) (n : ℕ) :
    ramifiedWittStructure hπ hreg (X i) n = X (i, n) :=
  (congrFun (eq_ramifiedWittStructure_of_ramifiedGhost_eq hπ hreg (X i)
    (s := fun k ↦ X (i, k)) (fun k ↦ by rw [aeval_X])) n).symm

/-- The ghost identity after evaluating the structure polynomials in an arbitrary coefficient
algebra. -/
theorem ramifiedGhost_aeval_ramifiedWittStructure {A : Type*} [CommRing A] [Algebra O A]
    (Φ : MvPolynomial ι O) (v : ι × ℕ → A) (n : ℕ) :
    ramifiedGhost π q n (fun k ↦ aeval v (ramifiedWittStructure hπ hreg Φ k)) =
      aeval (fun i ↦ ramifiedGhost π q n (fun k ↦ v (i, k))) Φ := by
  have h := congrArg (aeval v) (ramifiedGhost_ramifiedWittStructure hπ hreg Φ n)
  rw [comp_aeval_apply] at h
  simpa only [map_ramifiedGhost, aeval_X] using h

/-- Transporting coefficients of any family with the prescribed ghosts gives the canonical
structure polynomials after coefficient transport. -/
theorem map_eq_ramifiedWittStructure {R : Type*} [CommRing R] {ρ : R}
    (f : R →+* O) (hρ : f ρ = π) (Φ : MvPolynomial ι R)
    {s : ℕ → MvPolynomial (ι × ℕ) R}
    (hs : ∀ n, ramifiedGhost ρ q n s =
      aeval (fun i ↦ ramifiedGhost ρ q n (fun k ↦ X (i, k))) Φ) (n : ℕ) :
    map f (s n) = ramifiedWittStructure hπ hreg (map f Φ) n := by
  have hmap (k : ℕ) (x : ℕ → MvPolynomial (ι × ℕ) R) :
      map f (ramifiedGhost ρ q k x) =
        ramifiedGhost π q k (fun j ↦ map f (x j)) := by
    simp [ramifiedGhost_def, hρ]
  refine congrFun (eq_ramifiedWittStructure_of_ramifiedGhost_eq hπ hreg (map f Φ)
    (s := fun k ↦ map f (s k)) fun k ↦ ?_) n
  rw [← hmap, hs, map_aeval_eq_aeval_map_map]
  simp only [hmap, map_X]

/-- Evaluating the `n`-th structure polynomial only uses input coordinates through `n`, even in
coefficient algebras with `π`-torsion. -/
theorem aeval_ramifiedWittStructure_eq_of_forall_le {A : Type*} [CommRing A] [Algebra O A]
    (Φ : MvPolynomial ι O) {v w : ι × ℕ → A} {n : ℕ}
    (h : ∀ i k, k ≤ n → v (i, k) = w (i, k)) :
    aeval v (ramifiedWittStructure hπ hreg Φ n) =
      aeval w (ramifiedWittStructure hπ hreg Φ n) := by
  let e : ι × ℕ → ι × ℕ := fun ik ↦ (ik.1, min ik.2 n)
  have he : rename e (ramifiedWittStructure hπ hreg Φ n) =
      ramifiedWittStructure hπ hreg Φ n := by
    refine eq_of_forall_le_ramifiedGhost_eq («q» := q) (C_mem_nonZeroDivisors hreg)
      (x := fun k ↦ rename e (ramifiedWittStructure hπ hreg Φ k))
      (fun k hk ↦ ?_) n le_rfl
    rw [← map_ramifiedGhost, ramifiedGhost_ramifiedWittStructure, comp_aeval_apply]
    apply congrArg (fun v ↦ aeval v Φ)
    funext i
    rw [map_ramifiedGhost]
    apply ramifiedGhost_congr
    intro j hj
    simp only [rename_X]
    rw [show e (i, j) = (i, j) by simp [e, Nat.min_eq_left (hj.trans hk)]]
  calc
    aeval v (ramifiedWittStructure hπ hreg Φ n) =
        aeval v (rename e (ramifiedWittStructure hπ hreg Φ n)) := congrArg (aeval v) he.symm
    _ = aeval w (rename e (ramifiedWittStructure hπ hreg Φ n)) := by
      rw [aeval_rename, aeval_rename]
      apply congrArg (fun u ↦ aeval u (ramifiedWittStructure hπ hreg Φ n))
      funext ik
      exact h ik.1 (min ik.2 n) (Nat.min_le_right _ _)
    _ = aeval w (ramifiedWittStructure hπ hreg Φ n) := congrArg (aeval w) he

/-- Substitution of polynomial operations on ramified Witt coordinates is computed by substituting
the corresponding structure polynomials. -/
theorem ramifiedWittStructure_aeval {κ : Type*} (f : κ → MvPolynomial ι O)
    (Φ : MvPolynomial κ O) (n : ℕ) :
    ramifiedWittStructure hπ hreg (aeval f Φ) n =
      aeval (fun ik : κ × ℕ ↦ ramifiedWittStructure hπ hreg (f ik.1) ik.2)
        (ramifiedWittStructure hπ hreg Φ n) := by
  symm
  refine congrFun (eq_ramifiedWittStructure_of_ramifiedGhost_eq hπ hreg (aeval f Φ)
    (s := fun k ↦ aeval _ (ramifiedWittStructure hπ hreg Φ k)) fun k ↦ ?_) n
  rw [ramifiedGhost_aeval_ramifiedWittStructure, comp_aeval_apply]
  simp only [ramifiedGhost_ramifiedWittStructure]

end TauCeti
