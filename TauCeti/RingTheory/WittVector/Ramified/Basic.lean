/-!
# Ramified Witt vectors

For a local ring `O` with finite residue field and maximal ideal generated by a nonzerodivisor
`π`, the ramified Witt vectors of an `O`-algebra `A` have carrier `ℕ → A`. The operations are
evaluations of the universal ramified Witt structure polynomials. Polynomial substitution gives
the ring laws over every `A`, including algebras with `π`-torsion.

The ramified ghost components are `O`-algebra homomorphisms, and an `O`-algebra map on
coefficients acts coordinatewise on Witt vectors. This is the arbitrary-algebra construction of
Fargues and Fontaine, *Courbes et fibrés vectoriels en théorie de Hodge p-adique*, §1.2.1.

The evaluation construction, local operation instances, ghost compatibility, and coordinatewise
maps follow the formal precedent of `TauCeti.RingTheory.WittVector.Big.Basic`. Here the ring
laws follow directly from substitution of the ramified structure polynomials.
-/

public section

namespace TauCeti

open IsLocalRing

/-- Ramified Witt vectors with parameter `π` and coordinates in `A`. The ramified Witt ring
operations are available when `π` is a regular generator of the maximal ideal of a local
coefficient ring with finite residue field. -/
@[ext]
structure RamifiedWittVector {O : Type*} (π : O) (A : Type*) where
  /-- The sequence of Witt coordinates. -/
  coeff : ℕ → A

namespace RamifiedWittVector

@[simp]
theorem coeff_mk {O A : Type*} {π : O} (x : ℕ → A) (n : ℕ) :
    (mk x : RamifiedWittVector π A).coeff n = x n :=
  (rfl)

open MvPolynomial

variable {O : Type*} [CommRing O] [IsLocalRing O] [Finite (ResidueField O)] {π : O}
  [Fact (maximalIdeal O = Ideal.span {π})] [Fact (π ∈ nonZeroDivisors O)]
  {A : Type*} [CommRing A] [Algebra O A] {ι κ : Type*}

local notation "W" => RamifiedWittVector π
local notation "q" => Nat.card (ResidueField O)

/-- Evaluate an ordinary polynomial operation using its ramified structure polynomials. -/
private noncomputable def peval (Φ : MvPolynomial ι O) (x : ι → W A) : W A :=
  ⟨fun n ↦ aeval (fun ik : ι × ℕ ↦ (x ik.1).coeff ik.2)
    (ramifiedWittStructure (Fact.out : maximalIdeal O = Ideal.span {π})
      (Fact.out : π ∈ nonZeroDivisors O) Φ n)⟩

private theorem peval_aeval (f : κ → MvPolynomial ι O) (Φ : MvPolynomial κ O)
    (x : ι → W A) :
    peval (aeval f Φ) x = peval Φ (fun i ↦ peval (f i) x) := by
  ext n
  simp only [peval, coeff_mk, ramifiedWittStructure_aeval, comp_aeval_apply]

private theorem peval_X (i : ι) (x : ι → W A) : peval (X i) x = x i := by
  ext n
  simp [peval]

/-- The vector obtained by evaluating the ramified structure polynomials of `C a`.
Each ghost component equals `algebraMap O A a`. -/
private noncomputable def constant (a : O) : W A :=
  peval (C a : MvPolynomial Empty O) Empty.elim

private theorem peval_C (a : O) (x : ι → W A) : peval (C a) x = constant a := by
  have h := peval_aeval (Empty.elim : Empty → MvPolynomial ι O) (C a) x
  rw [aeval_C] at h
  exact h.trans (congrArg (peval (C a)) (funext fun i ↦ i.elim))

noncomputable section RingConstruction

private abbrev instZeroAux : Zero (W A) := ⟨constant (0 : O)⟩
private abbrev instOneAux : One (W A) := ⟨constant (1 : O)⟩
private abbrev instAddAux : Add (W A) := ⟨fun x y ↦ peval (X 0 + X 1) ![x, y]⟩
private abbrev instMulAux : Mul (W A) := ⟨fun x y ↦ peval (X 0 * X 1) ![x, y]⟩
private abbrev instNegAux : Neg (W A) := ⟨fun x ↦ peval (-X ()) (fun _ ↦ x)⟩

attribute [local instance] instZeroAux instOneAux instAddAux instMulAux instNegAux

private theorem peval_add (Φ Ψ : MvPolynomial ι O) (x : ι → W A) :
    peval (Φ + Ψ) x = peval Φ x + peval Ψ x := by
  have h := peval_aeval ![Φ, Ψ] (X 0 + X 1) x
  rw [map_add, aeval_X, aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one] at h
  exact h.trans (congrArg (peval (X (0 : Fin 2) + X 1))
    (Matrix.comp_vec2 (fun Φ ↦ peval Φ x) Φ Ψ))

private theorem peval_mul (Φ Ψ : MvPolynomial ι O) (x : ι → W A) :
    peval (Φ * Ψ) x = peval Φ x * peval Ψ x := by
  have h := peval_aeval ![Φ, Ψ] (X 0 * X 1) x
  rw [map_mul, aeval_X, aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one] at h
  exact h.trans (congrArg (peval (X (0 : Fin 2) * X 1))
    (Matrix.comp_vec2 (fun Φ ↦ peval Φ x) Φ Ψ))

private theorem peval_neg (Φ : MvPolynomial ι O) (x : ι → W A) :
    peval (-Φ) x = -peval Φ x := by
  have h := peval_aeval (fun _ : Unit ↦ Φ) (-X ()) x
  rw [map_neg, aeval_X] at h
  exact h

private theorem peval_zero (x : ι → W A) : peval (0 : MvPolynomial ι O) x = 0 := by
  rw [← C_0, peval_C]
  rfl

private theorem peval_one (x : ι → W A) : peval (1 : MvPolynomial ι O) x = 1 := by
  rw [← C_1, peval_C]
  rfl

/-- The commutative ring structure given by the universal ramified structure polynomials. -/
@[instance_reducible]
noncomputable def instCommRing : CommRing (W A) := by
  refine CommRing.ofMinimalAxioms (R := W A) ?_ ?_ ?_ ?_ ?_ ?_ ?_
  · intro x y z
    simpa only [peval_add, peval_X, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] using
      congrArg (fun Φ ↦ peval Φ ![x, y, z]) (add_assoc (X 0) (X 1) (X 2))
  · intro x
    simpa only [peval_add, peval_zero, peval_X, Matrix.cons_val_zero] using
      congrArg (fun Φ ↦ peval Φ ![x]) (zero_add (X 0))
  · intro x
    simpa only [peval_add, peval_neg, peval_zero, peval_X, Matrix.cons_val_zero] using
      congrArg (fun Φ ↦ peval Φ ![x]) (neg_add_cancel (X 0))
  · intro x y z
    simpa only [peval_mul, peval_X, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] using
      congrArg (fun Φ ↦ peval Φ ![x, y, z]) (mul_assoc (X 0) (X 1) (X 2))
  · intro x y
    simpa only [peval_mul, peval_X, Matrix.cons_val_zero, Matrix.cons_val_one] using
      congrArg (fun Φ ↦ peval Φ ![x, y]) (mul_comm (X 0) (X 1))
  · intro x
    simpa only [peval_mul, peval_one, peval_X, Matrix.cons_val_zero] using
      congrArg (fun Φ ↦ peval Φ ![x]) (one_mul (X 0))
  · intro x y z
    simpa only [peval_add, peval_mul, peval_X, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] using
      congrArg (fun Φ ↦ peval Φ ![x, y, z]) (mul_add (X 0) (X 1) (X 2))

end RingConstruction

attribute [instance] instCommRing

/-- Polynomial evaluation as a ring homomorphism. -/
private noncomputable def pevalRingHom (x : ι → W A) : MvPolynomial ι O →+* W A where
  toFun Φ := peval Φ x
  map_zero' := peval_zero x
  map_one' := peval_one x
  map_add' Φ Ψ := peval_add Φ Ψ x
  map_mul' Φ Ψ := peval_mul Φ Ψ x

/-- The coefficient map evaluates the ramified structure polynomials of `C a`.
Each ghost component equals `algebraMap O A a`. -/
@[instance_reducible]
noncomputable def instAlgebra : Algebra O (W A) :=
  ((pevalRingHom (Empty.elim : Empty → W A)).comp C).toAlgebra

attribute [instance] instAlgebra

private theorem aeval_eq_peval (x : ι → W A) (Φ : MvPolynomial ι O) :
    aeval x Φ = peval Φ x := by
  let e : MvPolynomial ι O →ₐ[O] W A :=
    { pevalRingHom x with commutes' := fun a ↦ peval_C a x }
  have he : aeval x = e := by
    ext i : 1
    rw [aeval_X]
    exact (peval_X i x).symm
  exact DFunLike.congr_fun he Φ

/-- Polynomial operations in the ramified Witt algebra are calculated by the universal structure
polynomials on the input coordinates. -/
theorem coeff_aeval (x : ι → W A) (Φ : MvPolynomial ι O) (n : ℕ) :
    (aeval x Φ).coeff n = aeval (fun ik : ι × ℕ ↦ (x ik.1).coeff ik.2)
      (ramifiedWittStructure (Fact.out : maximalIdeal O = Ideal.span {π})
        (Fact.out : π ∈ nonZeroDivisors O) Φ n) := by
  rw [aeval_eq_peval]
  rfl

/-- Addition is evaluation of the ramified addition structure polynomials. -/
theorem add_coeff (x y : W A) (n : ℕ) :
    (x + y).coeff n = aeval (Function.uncurry ![x.coeff, y.coeff])
      (ramifiedWittStructure (Fact.out : maximalIdeal O = Ideal.span {π})
        (Fact.out : π ∈ nonZeroDivisors O) (X (0 : Fin 2) + X 1) n) := by
  rw [← Matrix.comp_vec2 coeff x y]
  have h := coeff_aeval ![x, y] (X 0 + X 1 : MvPolynomial (Fin 2) O) n
  rw [map_add, aeval_X, aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one] at h
  exact h

/-- Multiplication is evaluation of the ramified multiplication structure polynomials. -/
theorem mul_coeff (x y : W A) (n : ℕ) :
    (x * y).coeff n = aeval (Function.uncurry ![x.coeff, y.coeff])
      (ramifiedWittStructure (Fact.out : maximalIdeal O = Ideal.span {π})
        (Fact.out : π ∈ nonZeroDivisors O) (X (0 : Fin 2) * X 1) n) := by
  rw [← Matrix.comp_vec2 coeff x y]
  have h := coeff_aeval ![x, y] (X 0 * X 1 : MvPolynomial (Fin 2) O) n
  rw [map_mul, aeval_X, aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one] at h
  exact h

/-- Negation is evaluation of the ramified negation structure polynomials. -/
theorem neg_coeff (x : W A) (n : ℕ) :
    (-x).coeff n = aeval (fun ik : Unit × ℕ ↦ x.coeff ik.2)
      (ramifiedWittStructure (Fact.out : maximalIdeal O = Ideal.span {π})
        (Fact.out : π ∈ nonZeroDivisors O) (-X ()) n) := by
  simpa using coeff_aeval (fun _ : Unit ↦ x) (-X ()) n

/-- Subtraction is evaluation of the ramified subtraction structure polynomials. -/
theorem sub_coeff (x y : W A) (n : ℕ) :
    (x - y).coeff n = aeval (Function.uncurry ![x.coeff, y.coeff])
      (ramifiedWittStructure (Fact.out : maximalIdeal O = Ideal.span {π})
        (Fact.out : π ∈ nonZeroDivisors O) (X (0 : Fin 2) - X 1) n) := by
  rw [← Matrix.comp_vec2 coeff x y]
  have h := coeff_aeval ![x, y] (X 0 - X 1 : MvPolynomial (Fin 2) O) n
  rw [map_sub, aeval_X, aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one] at h
  exact h

/-- The scalar map is evaluation of the structure polynomials of the variable-free `C a`. -/
theorem algebraMap_coeff (a : O) (n : ℕ) :
    (algebraMap O (W A) a).coeff n = aeval (fun ik : Empty × ℕ ↦ ik.1.elim)
      (ramifiedWittStructure (Fact.out : maximalIdeal O = Ideal.span {π})
        (Fact.out : π ∈ nonZeroDivisors O) (C a : MvPolynomial Empty O) n) := by
  have h := coeff_aeval (Empty.elim : Empty → W A) (C a) n
  simpa only [aeval_C, Subsingleton.elim (fun ik : Empty × ℕ ↦ (ik.1.elim : W A).coeff ik.2)
    (fun ik : Empty × ℕ ↦ ik.1.elim)] using h

private theorem ramifiedGhost_aeval (n : ℕ) (Φ : MvPolynomial ι O) (x : ι → W A) :
    ramifiedGhost π q n (aeval x Φ).coeff =
      aeval (fun i ↦ ramifiedGhost π q n (x i).coeff) Φ := by
  rw [aeval_eq_peval]
  exact ramifiedGhost_aeval_ramifiedWittStructure _ _ _ _ _

/-- Compatibility with polynomial evaluation gives an algebra homomorphism.
Inlining keeps the resulting function computable when `g` is, even though the Witt operations
in its proof are noncomputable. -/
@[macro_inline]
private def algHomOfAeval {B : Type*} [CommRing B] [Algebra O B] (g : W A → B)
    (hg : ∀ {ι : Type} (Φ : MvPolynomial ι O) (x : ι → W A),
      g (aeval x Φ) = aeval (fun i ↦ g (x i)) Φ) : W A →ₐ[O] B where
  toFun := g
  map_zero' := by
    simpa only [map_zero] using
      hg (0 : MvPolynomial Empty O) (Empty.elim : Empty → W A)
  map_one' := by
    simpa only [map_one] using
      hg (1 : MvPolynomial Empty O) (Empty.elim : Empty → W A)
  map_add' x y := by
    have h := hg (X 0 + X 1 : MvPolynomial (Fin 2) O) ![x, y]
    simpa only [map_add, aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one] using h
  map_mul' x y := by
    have h := hg (X 0 * X 1 : MvPolynomial (Fin 2) O) ![x, y]
    simpa only [map_mul, aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one] using h
  commutes' a := by
    simpa only [aeval_C] using
      hg (C a : MvPolynomial Empty O) (Empty.elim : Empty → W A)

/-- The `n`-th ramified ghost component as an algebra homomorphism. -/
noncomputable def ghostComponent (n : ℕ) : W A →ₐ[O] A :=
  algHomOfAeval (fun x ↦ ramifiedGhost π q n x.coeff) (ramifiedGhost_aeval n)

theorem ghostComponent_apply (n : ℕ) (x : W A) :
    ghostComponent n x = ramifiedGhost π q n x.coeff :=
  (rfl)

@[simp]
theorem ghostComponent_zero (x : W A) : ghostComponent 0 x = x.coeff 0 := by
  rw [ghostComponent_apply, ramifiedGhost_zero]

/-- The zeroth coordinate of a sum is the sum of the zeroth coordinates. -/
@[simp]
theorem add_coeff_zero (x y : W A) : (x + y).coeff 0 = x.coeff 0 + y.coeff 0 := by
  simpa using (ghostComponent (π := π) (A := A) 0).map_add x y

/-- The zeroth coordinate of a product is the product of the zeroth coordinates. -/
@[simp]
theorem mul_coeff_zero (x y : W A) : (x * y).coeff 0 = x.coeff 0 * y.coeff 0 := by
  simpa using (ghostComponent (π := π) (A := A) 0).map_mul x y

/-- Negation negates the zeroth coordinate. -/
@[simp]
theorem neg_coeff_zero (x : W A) : (-x).coeff 0 = -x.coeff 0 := by
  simpa using (ghostComponent (π := π) (A := A) 0).map_neg x

/-- Subtraction subtracts the zeroth coordinates. -/
@[simp]
theorem sub_coeff_zero (x y : W A) : (x - y).coeff 0 = x.coeff 0 - y.coeff 0 := by
  simpa using (ghostComponent (π := π) (A := A) 0).map_sub x y

/-- The zeroth coordinate of a scalar is its image in the coefficient algebra. -/
@[simp]
theorem algebraMap_coeff_zero (a : O) :
    (algebraMap O (W A) a).coeff 0 = algebraMap O A a := by
  simpa only [ghostComponent_zero] using (ghostComponent (π := π) (A := A) 0).commutes a

/-- The algebra homomorphism sending a ramified Witt vector to its full ghost sequence. -/
noncomputable def ghostMap : W A →ₐ[O] (ℕ → A) :=
  AlgHom.pi ghostComponent

@[simp]
theorem ghostMap_apply (x : W A) (n : ℕ) : ghostMap x n = ghostComponent n x :=
  (rfl)

/-- Ramified ghosts determine the vector when `π` acts as a nonzerodivisor on the input algebra. -/
theorem ghostMap_injective (h : algebraMap O A π ∈ nonZeroDivisors A) :
    Function.Injective (ghostMap (π := π) (A := A)) := by
  intro x y hxy
  have heq (n : ℕ) : ramifiedGhost π q n x.coeff = ramifiedGhost π q n y.coeff := by
    simpa only [ghostMap_apply, ghostComponent_apply] using congrFun hxy n
  exact RamifiedWittVector.ext (ramifiedGhost_injective h (funext heq))

section Map

variable {B D : Type*} [CommRing B] [Algebra O B] [CommRing D] [Algebra O D]

private def mapFun (f : A →ₐ[O] B) (x : W A) : W B :=
  ⟨fun n ↦ f (x.coeff n)⟩

private theorem mapFun_aeval (f : A →ₐ[O] B) (Φ : MvPolynomial ι O) (x : ι → W A) :
    mapFun f (aeval x Φ) = aeval (fun i ↦ mapFun f (x i)) Φ := by
  ext n
  simp only [mapFun, coeff_mk, coeff_aeval, comp_aeval_apply]

/-- The algebra map on ramified Witt vectors induced by an algebra map on coefficients. -/
def map (f : A →ₐ[O] B) : W A →ₐ[O] W B :=
  algHomOfAeval (mapFun f) (mapFun_aeval f)

/-- A coefficient map acts on each Witt coordinate separately. -/
@[simp]
theorem coeff_map (f : A →ₐ[O] B) (x : W A) (n : ℕ) :
    (map f x).coeff n = f (x.coeff n) :=
  (rfl)

/-- The identity coefficient map induces the identity on ramified Witt vectors. -/
@[simp]
theorem map_id : map (π := π) (AlgHom.id O A) = AlgHom.id O (W A) := by
  ext x n
  simp

/-- The induced maps on ramified Witt vectors preserve composition. -/
@[simp]
theorem map_comp (f : A →ₐ[O] B) (g : B →ₐ[O] D) :
    map (π := π) (g.comp f) = (map g).comp (map f) := by
  ext x n
  simp

/-- Taking a ghost component commutes with an algebra map on coefficients. -/
@[simp]
theorem ghostComponent_map (f : A →ₐ[O] B) (x : W A) (n : ℕ) :
    ghostComponent n (map f x) = f (ghostComponent n x) := by
  rw [ghostComponent_apply, ghostComponent_apply, map_ramifiedGhost]
  exact ramifiedGhost_congr (fun i _ ↦ coeff_map f x i)

end Map

@[simp]
theorem zero_coeff (n : ℕ) : (0 : W A).coeff n = 0 := by
  have h : (0 : W O) = mk (fun _ ↦ 0) := by
    apply ghostMap_injective (by simpa using (Fact.out : π ∈ nonZeroDivisors O))
    rw [map_zero]
    funext k
    have hpow (m : ℕ) : (0 : O) ^ (q ^ m) = 0 :=
      zero_pow (pow_ne_zero _ Nat.card_pos.ne')
    simp [ghostComponent_apply, ramifiedGhost_def, hpow]
  rw [← map_zero (map (π := π) (Algebra.ofId O A)), h, coeff_map, coeff_mk, map_zero]

/-- The unit has zeroth Witt coordinate one and all other coordinates zero. -/
@[simp]
theorem one_coeff (n : ℕ) : (1 : W A).coeff n = (Pi.single 0 (1 : A) : ℕ → A) n := by
  have h : (1 : W O) = mk (Pi.single 0 1) := by
    apply ghostMap_injective (by simpa using (Fact.out : π ∈ nonZeroDivisors O))
    rw [map_one]
    funext k
    have hpow (m : ℕ) : (0 : O) ^ (q ^ m) = 0 :=
      zero_pow (pow_ne_zero _ Nat.card_pos.ne')
    simp [ghostComponent_apply, ramifiedGhost_def, Finset.sum_range_succ', hpow]
  rw [← map_one (map (π := π) (Algebra.ofId O A)), h, coeff_map, coeff_mk]
  by_cases hn : n = 0 <;> simp [hn]

end RamifiedWittVector

end TauCeti
