module

public import Mathlib.RingTheory.AdicCompletion.Topology
public import TauCeti.RingTheory.Huber.Adic
public import TauCeti.RingTheory.WittVector.Complete

/-!
# The `(p, [ϖ])`-adic topology on Witt vectors

For a commutative ring `R`, a prime `p`, and `ϖ : R`, let `I = (p, [ϖ])` in `W(R)`.  Since `I`
has two generators, its adic topology makes `W(R)` a Huber ring.  If `R` is perfect of
characteristic `p` and complete for the `(ϖ)`-adic topology, then
`WittVector.isAdicComplete_span_p_teichmuller` says that `W(R)` is `I`-adically complete.
Mathlib's comparison between adic and topological completeness then makes this Huber ring complete
and Hausdorff.

This is the topological-ring input for the construction of `A_inf = W(𝒪_F)`: after the ring of
integers `𝒪_F` has been shown `(ϖ)`-adically complete, the results here put the required complete
Hausdorff Huber topology on its Witt vectors.

## Main definitions

* `TauCeti.WittVector.adicIdeal`: the ideal `(p, [ϖ])` of `W(R)`.

## Main results

* `TauCeti.WittVector.isHuberRing_adicTopology`: the `(p, [ϖ])`-adic Witt-vector ring is Huber.
* `TauCeti.WittVector.completeSpace_and_t2Space_adicTopology`: under the perfectness and
  completeness hypotheses, that topology is complete and Hausdorff.

## References

* L. Fargues and J.-M. Fontaine, *Courbes et fibrés vectoriels en théorie de Hodge p-adique*,
  for the ring `A_inf` and its `(p, [ϖ])`-adic topology.
-/

public section

namespace TauCeti.WittVector

variable (p : ℕ) [Fact p.Prime] (R : Type*) [CommRing R]

/-- The ideal `(p, [ϖ])` in the ring of `p`-typical Witt vectors of `R`. -/
noncomputable def adicIdeal (ϖ : R) : Ideal (_root_.WittVector p R) :=
  Ideal.span {(p : _root_.WittVector p R), _root_.WittVector.teichmuller p ϖ}

/-- The `(p, [ϖ])`-ideal is the ideal generated by `p` and the Teichmüller lift of `ϖ`. -/
theorem adicIdeal_def (ϖ : R) :
    adicIdeal p R ϖ =
      Ideal.span {(p : _root_.WittVector p R), _root_.WittVector.teichmuller p ϖ} :=
  (rfl)

/-- The ideal `(p, [ϖ])` is finitely generated. -/
theorem adicIdeal_fg (ϖ : R) : (adicIdeal p R ϖ).FG :=
  Submodule.fg_span (by simp)

/-- Witt vectors equipped with their `(p, [ϖ])`-adic topology form a Huber ring. -/
theorem isHuberRing_adicTopology (ϖ : R) :
    letI := (adicIdeal p R ϖ).adicTopology
    Huber.IsHuberRing (_root_.WittVector p R) :=
  Huber.isHuberRing_adicTopology _ (adicIdeal_fg p R ϖ)

variable [CharP R p] [PerfectRing R p]

/-- If `R` is `(ϖ)`-adically complete, the `(p, [ϖ])`-adic topology on its Witt vectors is
complete and Hausdorff.

The algebraic completeness input is `WittVector.isAdicComplete_span_p_teichmuller`; this theorem
only identifies it with completeness and separatedness of the corresponding adic topology. -/
theorem completeSpace_and_t2Space_adicTopology (ϖ : R)
    [IsAdicComplete (Ideal.span {ϖ}) R] :
    letI : WithIdeal (_root_.WittVector p R) := ⟨adicIdeal p R ϖ⟩
    CompleteSpace (_root_.WittVector p R) ∧ T2Space (_root_.WittVector p R) := by
  let _ : WithIdeal (_root_.WittVector p R) := ⟨adicIdeal p R ϖ⟩
  apply (IsAdic.isAdicComplete_iff (I := adicIdeal p R ϖ) rfl).mp
  simpa only [adicIdeal] using
    (_root_.WittVector.isAdicComplete_span_p_teichmuller (p := p) ϖ)

end TauCeti.WittVector
