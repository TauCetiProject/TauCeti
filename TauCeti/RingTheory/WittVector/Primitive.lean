module

public import TauCeti.RingTheory.WittVector.Units
public import TauCeti.Topology.Algebra.TopologicallyNilpotent.Basic

/-!
# Primitive and distinguished Witt vectors

Let `S` be a commutative topological ring. A Witt vector `ξ = (ξ₀, ξ₁, …) : 𝕎 S` is
*distinguished* if its first Witt coordinate `ξ₁` is a unit of `S`, and *primitive of degree one*
if moreover its zeroth Witt coordinate `ξ₀` is topologically nilpotent. For `S = R⁺` the ring of
integral elements of a perfectoid Tate ring of characteristic `p`, the principal ideals of
`A_inf = 𝕎 R⁺` generated by primitive elements are the kernels of Fontaine's map `θ` for the
untilts of `R`; for instance `p` itself is primitive and corresponds to the untilt `R`.

Over a perfect ring of characteristic `p`, every Witt vector is `[ξ₀] + p u`, and `ξ₁ = u₀ ^ p`. So
`ξ` is distinguished exactly when it is `[ξ₀] + p u` with `u` a unit
(`WittVector.isDistinguished_iff_exists_unit`), and primitive exactly when moreover `ξ₀` is
topologically nilpotent (`WittVector.isPrimitive_iff_exists_unit`); this is the usual definition
of a primitive element of degree one.

The remaining results assume that `S` has characteristic `p`, that every topologically nilpotent
element of `S` lies in the Jacobson radical (for instance, `S` is adically complete with respect to
an open ideal, by `topologicalNilradical_le_jacobson_bot`), and that the topology of `S` is linear.
In characteristic `p` the first Witt coordinate of a product is `(x y)₁ = x₀ ^ p y₁ + y₀ ^ p x₁`
(`WittVector.mul_coeff_one`). Hence `p + [ϖ] α` is primitive for every topologically nilpotent `ϖ`
and every `α`, primitivity is invariant under multiplication by units, and a multiple of a
primitive element that is itself distinguished is a unit multiple. Over a perfect ring, every
primitive element is moreover a unit multiple of some `p + [ϖ] α`.

## Main definitions

* `WittVector.IsDistinguished ξ`: the first Witt coordinate of `ξ` is a unit.
* `WittVector.IsPrimitive ξ`: `ξ` is distinguished and its zeroth Witt coordinate is topologically
  nilpotent.

## Main results

* `WittVector.isDistinguished_iff_exists_unit`, `WittVector.isPrimitive_iff_exists_unit`: the
  Teichmüller form `ξ = [ξ₀] + p u` with `u` a unit.
* `WittVector.isPrimitive_natCast`: `p` is primitive, and
  `WittVector.not_isDistinguished_of_mem_span_p_sq`, `WittVector.not_isDistinguished_teichmuller`:
  over a nonzero ring no element of `(p ^ 2)` and no Teichmüller representative is.
* `WittVector.IsPrimitive.map`, `WittVector.IsPrimitive.frobenius`: functoriality and Frobenius.
* `WittVector.isPrimitive_p_add_teichmuller_mul`: `p + [ϖ] α` is primitive.
* `WittVector.isPrimitive_iff_exists_eq_unit_mul`: the primitive elements are exactly the unit
  multiples of the elements `p + [ϖ] α` with `ϖ` topologically nilpotent.
* `WittVector.isPrimitive_units_mul`: primitivity is invariant under multiplication by units.
* `WittVector.IsPrimitive.isUnit_of_eq_mul`: if `ξ` and `ξ' = y ξ` are primitive, `y` is a unit.

## References

* K. S. Kedlaya, R. Liu, *Relative `p`-adic Hodge theory: foundations*, Definition 3.2.3.
* K. S. Kedlaya, *Sheaves, stacks, and shtukas*, Definition 2.3.4, Remark 2.3.5 and
  Exercise 2.3.6.
* P. Scholze, *Étale cohomology of diamonds*, Definition 3.15.
* B. Bhatt, M. Morrow, P. Scholze, *Integral `p`-adic Hodge theory*, Remark 3.11.
-/

public section

namespace WittVector

variable {p : ℕ} {S : Type*} [CommRing S]

local notation "𝕎" => WittVector p

/-- A Witt vector is *distinguished* if its first Witt coordinate is a unit (Bhatt–Morrow–Scholze,
Remark 3.11). -/
def IsDistinguished (ξ : 𝕎 S) : Prop := IsUnit (ξ.coeff 1)

theorem isDistinguished_iff {ξ : 𝕎 S} : ξ.IsDistinguished ↔ IsUnit (ξ.coeff 1) := .rfl

/-- A Witt vector `ξ` over a topological ring is *primitive of degree one* if its zeroth Witt
coordinate is topologically nilpotent and its first Witt coordinate is a unit (Kedlaya–Liu,
Definition 3.2.3; Kedlaya, *Sheaves, stacks, and shtukas*, Definition 2.3.4). Over a perfect ring,
writing `ξ = ∑ pⁿ [xₙ]` in Teichmüller coordinates, the zeroth and first Witt coordinates are `x₀`
and `x₁ ^ p`, so the definition agrees with the one phrased in Teichmüller coordinates. -/
structure IsPrimitive [TopologicalSpace S] (ξ : 𝕎 S) : Prop where
  /-- The zeroth Witt coordinate of a primitive element is topologically nilpotent. -/
  isTopologicallyNilpotent_coeff_zero : IsTopologicallyNilpotent (ξ.coeff 0)
  /-- A primitive element is distinguished: its first Witt coordinate is a unit. -/
  isDistinguished : ξ.IsDistinguished

theorem isPrimitive_iff [TopologicalSpace S] {ξ : 𝕎 S} :
    ξ.IsPrimitive ↔ IsTopologicallyNilpotent (ξ.coeff 0) ∧ IsUnit (ξ.coeff 1) :=
  ⟨fun h ↦ ⟨h.1, h.2⟩, fun h ↦ ⟨h.1, h.2⟩⟩

/-- Over the zero ring every Witt vector is primitive. -/
theorem isPrimitive_of_subsingleton [TopologicalSpace S] [Subsingleton S] (ξ : 𝕎 S) :
    ξ.IsPrimitive :=
  ⟨Subsingleton.elim 0 (ξ.coeff 0) ▸ .zero, isUnit_of_subsingleton _⟩

variable [hp : Fact p.Prime]

/-- A ring homomorphism carries distinguished Witt vectors to distinguished Witt vectors. -/
theorem IsDistinguished.map {S' : Type*} [CommRing S'] {ξ : 𝕎 S} (h : ξ.IsDistinguished)
    (f : S →+* S') : (map f ξ).IsDistinguished := by
  rw [isDistinguished_iff, map_coeff]
  exact IsUnit.map f h

/-- A continuous ring homomorphism carries primitive Witt vectors to primitive Witt vectors. -/
theorem IsPrimitive.map [TopologicalSpace S] {S' : Type*} [CommRing S'] [TopologicalSpace S']
    {ξ : 𝕎 S} (h : ξ.IsPrimitive) {f : S →+* S'} (hf : Continuous f) : (map f ξ).IsPrimitive :=
  ⟨by rw [map_coeff]; exact h.1.map hf, h.2.map f⟩

/-- Over a nonzero ring, no Teichmüller representative is distinguished: its first Witt
coordinate vanishes. -/
theorem not_isDistinguished_teichmuller [Nontrivial S] (a : S) :
    ¬ (teichmuller p a).IsDistinguished := by
  rw [isDistinguished_iff, teichmuller_coeff_pos p a 1 one_pos]
  exact not_isUnit_zero

section CharP

variable [CharP S p]

/-- In characteristic `p`, `[a] + p u` is distinguished exactly when `u₀` is a unit. -/
theorem isDistinguished_teichmuller_add_p_mul_iff (a : S) (u : 𝕎 S) :
    (teichmuller p a + p * u).IsDistinguished ↔ IsUnit (u.coeff 0) := by
  rw [isDistinguished_iff, teichmuller_add_p_mul_coeff_succ, isUnit_pow_iff hp.out.ne_zero]

/-- In characteristic `p`, the Witt vector `p = (0, 1, 0, …)` is distinguished. -/
theorem isDistinguished_natCast : (p : 𝕎 S).IsDistinguished := by
  rw [isDistinguished_iff, coeff_p_one]
  exact isUnit_one

/-- In characteristic `p`, the Witt vector `p = (0, 1, 0, …)` is primitive. -/
theorem isPrimitive_natCast [TopologicalSpace S] : (p : 𝕎 S).IsPrimitive :=
  ⟨by rw [coeff_p_zero]; exact .zero, isDistinguished_natCast⟩

/-- Over a nonzero ring of characteristic `p`, no element of the ideal `(p ^ 2)` is distinguished:
its first Witt coordinate vanishes. In particular neither `p ^ 2` nor `0` is distinguished, and
`(p ^ 2)` has no primitive generator. -/
theorem not_isDistinguished_of_mem_span_p_sq [Nontrivial S] {ξ : 𝕎 S}
    (h : ξ ∈ Ideal.span {(p : 𝕎 S) ^ 2}) : ¬ ξ.IsDistinguished := by
  obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp h
  rw [isDistinguished_iff, mul_comm, mul_pow_charP_coeff_zero y one_lt_two]
  exact not_isUnit_zero

/-- In characteristic `p`, the Witt vector Frobenius carries primitive elements to primitive
elements: it raises every Witt coordinate to the `p`-th power. -/
theorem IsPrimitive.frobenius [TopologicalSpace S] {ξ : 𝕎 S} (h : ξ.IsPrimitive) :
    (frobenius ξ).IsPrimitive :=
  ⟨by rw [coeff_frobenius_charP]; exact h.1.pow hp.out.ne_zero, by
    rw [isDistinguished_iff, coeff_frobenius_charP]; exact h.2.pow p⟩

section Jacobson

variable [TopologicalSpace S] [IsLinearTopology S S]
  (hS : topologicalNilradical S ≤ (⊥ : Ideal S).jacobson)
include hS

/-- **Elements of the form `p + [ϖ] α` are primitive.** If `ϖ` is topologically nilpotent, then
`p + [ϖ] α` is primitive for every `α` (compare Scholze, *Étale cohomology of diamonds*,
Definition 3.15). -/
theorem isPrimitive_p_add_teichmuller_mul {ϖ : S} (hϖ : IsTopologicallyNilpotent ϖ)
    (α : 𝕎 S) : ((p : 𝕎 S) + teichmuller p ϖ * α).IsPrimitive := by
  obtain ⟨w, hw⟩ := exists_eq_teichmuller_add_verschiebung (teichmuller p ϖ * α)
  have hw₀ : w.coeff 0 = (teichmuller p ϖ * α).coeff 1 := by
    rw [hw, teichmuller_add_verschiebung_coeff_succ]
  have h : (p : 𝕎 S) + teichmuller p ϖ * α =
      teichmuller p ((teichmuller p ϖ * α).coeff 0) + verschiebung (1 + w) := by
    rw [map_add, ← map_one (frobenius (p := p) (R := S)), verschiebung_frobenius]
    linear_combination hw
  rw [h]
  refine ⟨?_, ?_⟩
  · rw [teichmuller_add_verschiebung_coeff_zero, mul_coeff_zero, teichmuller_coeff_zero]
    exact hϖ.mul_right _
  · rw [isDistinguished_iff, teichmuller_add_verschiebung_coeff_succ, ← constantCoeff_apply,
      map_add, map_one, constantCoeff_apply, hw₀, mul_coeff_one]
    simp only [teichmuller_coeff_pos p ϖ 1 one_pos, mul_zero, zero_mul, add_zero]
    exact ((hϖ.pow hp.out.ne_zero).mul_right _).isUnit_add_left hS isUnit_one

/-- **Primitivity is invariant under multiplication by units.** -/
theorem isPrimitive_units_mul (u : (𝕎 S)ˣ) {ξ : 𝕎 S} :
    (u * ξ : 𝕎 S).IsPrimitive ↔ ξ.IsPrimitive := by
  suffices H : ∀ (u : (𝕎 S)ˣ) {ξ : 𝕎 S}, ξ.IsPrimitive → (u * ξ : 𝕎 S).IsPrimitive from
    ⟨fun h ↦ by simpa using H u⁻¹ h, H u⟩
  intro u ξ h
  refine ⟨by rw [mul_coeff_zero]; exact h.1.mul_left _, ?_⟩
  rw [isDistinguished_iff, mul_coeff_one, CharP.cast_eq_zero, zero_mul, zero_mul, add_zero]
  exact ((h.1.pow hp.out.ne_zero).mul_right _).isUnit_add_left hS
    (((isUnit_iff_isUnit_coeff_zero.mp u.isUnit).pow p).mul h.2)

/-- **The unit criterion.** If `ξ` is primitive and a multiple `ξ' = y ξ` is distinguished, then `y`
is a unit (Kedlaya, *Sheaves, stacks, and shtukas*, Remark 2.3.5). -/
theorem IsPrimitive.isUnit_of_eq_mul {ξ ξ' y : 𝕎 S} (hξ : ξ.IsPrimitive)
    (hξ' : ξ'.IsDistinguished) (h : ξ' = y * ξ) : IsUnit y := by
  rw [isDistinguished_iff, h, mul_coeff_one, CharP.cast_eq_zero, zero_mul, zero_mul,
    add_zero] at hξ'
  have hy := ((hξ.1.pow hp.out.ne_zero).mul_right (-y.coeff 1)).isUnit_add_left hS hξ'
  rw [mul_neg, add_neg_cancel_right] at hy
  exact isUnit_iff_isUnit_coeff_zero.mpr <|
    (isUnit_pow_iff hp.out.ne_zero).mp (isUnit_of_mul_isUnit_left hy)

end Jacobson

variable [PerfectRing S p]

/-- **The Teichmüller form of a distinguished element.** Over a perfect ring of characteristic
`p`, `ξ` is distinguished exactly when `ξ = [ξ₀] + p u` for a unit `u`. -/
theorem isDistinguished_iff_exists_unit {ξ : 𝕎 S} :
    ξ.IsDistinguished ↔ ∃ u : (𝕎 S)ˣ, ξ = teichmuller p (ξ.coeff 0) + p * u := by
  refine ⟨fun h ↦ ?_, fun ⟨u, hu⟩ ↦ ?_⟩
  · obtain ⟨u, hu⟩ := exists_eq_teichmuller_add_p_mul ξ
    rw [hu, isDistinguished_teichmuller_add_p_mul_iff, ← isUnit_iff_isUnit_coeff_zero] at h
    exact ⟨h.unit, hu⟩
  · rw [hu, isDistinguished_teichmuller_add_p_mul_iff, ← isUnit_iff_isUnit_coeff_zero]
    exact u.isUnit

/-- **The Teichmüller form of a primitive element.** Over a perfect ring of characteristic `p`,
`ξ` is primitive exactly when `ξ₀` is topologically nilpotent and `ξ = [ξ₀] + p u` for a unit
`u`. -/
theorem isPrimitive_iff_exists_unit [TopologicalSpace S] {ξ : 𝕎 S} :
    ξ.IsPrimitive ↔ IsTopologicallyNilpotent (ξ.coeff 0) ∧
      ∃ u : (𝕎 S)ˣ, ξ = teichmuller p (ξ.coeff 0) + p * u := by
  rw [← isDistinguished_iff_exists_unit]
  exact ⟨fun h ↦ ⟨h.1, h.2⟩, fun h ↦ ⟨h.1, h.2⟩⟩

/-- A primitive element is a unit multiple of `p + [ξ₀] α`, with `ξ₀` topologically nilpotent:
if `ξ = [ξ₀] + p u` then `ξ = u (p + [ξ₀] u⁻¹)`. -/
theorem IsPrimitive.exists_eq_unit_mul [TopologicalSpace S] {ξ : 𝕎 S} (h : ξ.IsPrimitive) :
    ∃ (u : (𝕎 S)ˣ) (ϖ : S) (α : 𝕎 S),
      IsTopologicallyNilpotent ϖ ∧ ξ = u * ((p : 𝕎 S) + teichmuller p ϖ * α) := by
  obtain ⟨hξ, u, hu⟩ := isPrimitive_iff_exists_unit.mp h
  refine ⟨u, ξ.coeff 0, ↑u⁻¹, hξ, ?_⟩
  linear_combination hu - teichmuller p (ξ.coeff 0) * u.mul_inv

/-- **The primitive elements are the unit multiples of `p + [ϖ] α`**, for `ϖ` topologically
nilpotent and `α` arbitrary (Kedlaya, *Sheaves, stacks, and shtukas*, Exercise 2.3.6). -/
theorem isPrimitive_iff_exists_eq_unit_mul [TopologicalSpace S] [IsLinearTopology S S]
    (hS : topologicalNilradical S ≤ (⊥ : Ideal S).jacobson) {ξ : 𝕎 S} :
    ξ.IsPrimitive ↔ ∃ (u : (𝕎 S)ˣ) (ϖ : S) (α : 𝕎 S),
      IsTopologicallyNilpotent ϖ ∧ ξ = u * ((p : 𝕎 S) + teichmuller p ϖ * α) :=
  ⟨IsPrimitive.exists_eq_unit_mul, fun ⟨u, _, α, hϖ, h⟩ ↦
    h ▸ (isPrimitive_units_mul hS u).mpr (isPrimitive_p_add_teichmuller_mul hS hϖ α)⟩

end CharP

end WittVector
