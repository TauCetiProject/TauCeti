module

public import Mathlib.RingTheory.WittVector.Complete

/-!
# Reduction modulo `p` of quotients of Witt vectors

For a perfect ring `S` of characteristic `p` and an ideal `I` of `W(S)`, the zeroth Witt
coordinate induces an isomorphism
`(W(S) / I) / p ≃ S / constantCoeff(I)`.
In particular, for `I = (ξ)` the right side is `S / (ξ.coeff 0)`. Frobenius on this
reduction is surjective. These are the reduction and Frobenius calculations used to
recover the integral tilt of a quotient by a primitive Witt vector.

The construction uses Mathlib's `WittVector.ker_constantCoeff` and the first isomorphism
theorem. It does not require `I` to be primitive or principal.

## References

* K. S. Kedlaya, *Nonarchimedean geometry of Witt vectors and the tilting equivalence*,
  Arizona Winter School 2017, §2.3, Definition 2.3.14 and Remark 2.3.16.
* K. S. Kedlaya, R. Liu, *Relative p-adic Hodge theory II: Imperfect period rings*,
  Lemma 3.3.7.
-/

public section

namespace Ideal

open WittVector

variable {p : ℕ} [Fact p.Prime] {S : Type*} [CommRing S] [CharP S p] [PerfectRing S p]

/-- The zeroth-coordinate map on a Witt quotient has kernel generated by `p`. -/
theorem ker_quotientMap_wittVector_constantCoeff (I : Ideal (WittVector p S)) :
    RingHom.ker (Ideal.quotientMap (I.map constantCoeff) constantCoeff le_comap_map) =
      span {(p : WittVector p S ⧸ I)} := by
  have hI : I ≤ RingHom.ker
      ((Ideal.Quotient.mk (I.map constantCoeff)).comp constantCoeff) := by
    intro x hx
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hx)
  -- Lift the kernel computation to `W(S)`, where the preimage is `I + (p)`.
  rw [Ideal.quotientMap, Ideal.ker_quotient_lift _ hI,
    ← RingHom.comap_ker, Ideal.mk_ker,
    Ideal.comap_map_of_surjective _ (constantCoeff_surjective p)]
  -- The image of `I` vanishes in its own quotient.
  simp [← RingHom.ker_eq_comap_bot, ker_constantCoeff, Ideal.map_sup, Ideal.map_span]

/-- **Reduction modulo `p` of a Witt quotient.** For perfect `S` of characteristic `p`,
`(W(S) / I) / p` is canonically `S / constantCoeff(I)`. -/
noncomputable def wittVectorQuotientModPEquiv (I : Ideal (WittVector p S)) :
    (WittVector p S ⧸ I) ⧸ span {(p : WittVector p S ⧸ I)} ≃+*
      S ⧸ I.map constantCoeff :=
  (Ideal.quotEquivOfEq I.ker_quotientMap_wittVector_constantCoeff.symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (Ideal.quotientMap_surjective (constantCoeff_surjective p)))

/-- The reduction isomorphism sends a Witt vector to its zeroth coordinate. -/
@[simp]
theorem wittVectorQuotientModPEquiv_mk_mk (I : Ideal (WittVector p S)) (x : WittVector p S) :
    I.wittVectorQuotientModPEquiv (Ideal.Quotient.mk _ (Ideal.Quotient.mk I x)) =
      Ideal.Quotient.mk _ (x.coeff 0) := by
  simp [wittVectorQuotientModPEquiv]

/-- The inverse reduction isomorphism sends a scalar to its Teichmüller representative. -/
@[simp]
theorem wittVectorQuotientModPEquiv_symm_mk (I : Ideal (WittVector p S)) (s : S) :
    I.wittVectorQuotientModPEquiv.symm (Ideal.Quotient.mk _ s) =
      Ideal.Quotient.mk _ (Ideal.Quotient.mk I (teichmuller p s)) := by
  apply I.wittVectorQuotientModPEquiv.injective
  simp

/-- **Frobenius on the reduction of a Witt quotient is surjective.** This applies, in
particular, to the quotient by any primitive ideal used to construct an untilt. -/
theorem frobenius_wittVector_quotient_modP_surjective (I : Ideal (WittVector p S)) :
    Function.Surjective (fun x : (WittVector p S ⧸ I) ⧸ span {(p : WittVector p S ⧸ I)} ↦
      x ^ p) := by
  intro x
  obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (I.wittVectorQuotientModPEquiv x)
  refine ⟨I.wittVectorQuotientModPEquiv.symm
    (Ideal.Quotient.mk _ ((_root_.frobeniusEquiv S p).symm s)), ?_⟩
  apply I.wittVectorQuotientModPEquiv.injective
  rw [map_pow, RingEquiv.apply_symm_apply, ← map_pow,
    _root_.frobeniusEquiv_symm_pow_p, hs]

end Ideal
