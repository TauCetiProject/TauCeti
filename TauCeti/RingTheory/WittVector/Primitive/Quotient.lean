module

public import Mathlib.RingTheory.Localization.Ideal
public import TauCeti.RingTheory.AdicCompletion.Principal
public import TauCeti.RingTheory.AdicCompletion.Quotient
public import TauCeti.RingTheory.WittVector.Primitive.Basic

/-!
# The quotient of the Witt vectors by a distinguished element

Let `S` be a perfect ring of characteristic `p`, let `ϖ ∈ S`, and let `ξ = [ξ₀] + p u ∈ 𝕎 S` be
distinguished, with `ξ₀` in the radical of `(ϖ)`. For `S = R⁺` the ring of integral elements of
a perfectoid Tate ring of characteristic `p`, `ϖ` a pseudouniformiser and `ξ` primitive, the
quotient `A⁺ = 𝕎 S ⧸ (ξ)` is the ring of integral elements of the untilt of `R` along `(ξ)`, and
this file proves the properties of `A⁺` used to make the untilt a complete Tate ring.

* If `S` is `ϖ`-adically complete, then `A⁺` is `[ϖ]`-adically complete and separated. Indeed
  `𝕎 S` is `(p, [ϖ])`-adically, hence `[ϖ]`-adically, complete, and `ξ` is a nonzerodivisor
  modulo every power of `[ϖ]`. Since `p ≡ -u⁻¹ [ξ₀]` in `A⁺`, a power of `p` lies in `[ϖ] A⁺`,
  so `A⁺` is also `p`-adically complete.
* If `ϖ` divides `ξ₀`, then `p` itself lies in `[ϖ] A⁺`, so the `(p, [ϖ])`-adic and `[ϖ]`-adic
  topologies on `A⁺` coincide and `A⁺ ⧸ [ϖ] = 𝕎 S ⧸ (p, [ϖ]) = S ⧸ (ϖ)`.
* If `ϖ` is a nonzerodivisor, then `[ϖ]` is a nonzerodivisor on `A⁺`
  (`WittVector.IsDistinguished.mk_teichmuller_mem_nonZeroDivisors`), so
  `ξ 𝕎 S [1/[ϖ]] ∩ 𝕎 S = ξ 𝕎 S` and `A⁺` embeds into `𝕎 S [1/[ϖ]] ⧸ (ξ)`.

Every primitive element is a unit multiple of `p + [ϖ] α` with `ϖ` topologically nilpotent, whose
zeroth Witt coordinate is divisible by `ϖ`; so these results apply to every primitive ideal of
`𝕎 S` after a suitable choice of `ϖ`.

## Main results

* `WittVector.IsDistinguished.isAdicComplete_quotient`: `A⁺` is `[ϖ]`-adically complete.
* `WittVector.IsDistinguished.span_pair_teichmuller_eq`: `(ξ, [ϖ]) = (p, [ϖ])` when `ϖ ∣ ξ₀`.
* `WittVector.IsDistinguished.map_span_p_teichmuller`: the image of `(p, [ϖ])` in `A⁺` is
  `([ϖ])`.
* `WittVector.IsDistinguished.isAdicComplete_quotient_natCast`: `A⁺` is `p`-adically complete.
* `WittVector.IsDistinguished.quotientTeichmullerEquiv`: `A⁺ ⧸ ([ϖ]) ≃+* S ⧸ (ϖ)`.
* `WittVector.IsDistinguished.comap_map_algebraMap`: `ξ 𝕎 S [1/[ϖ]] ∩ 𝕎 S = ξ 𝕎 S`.

## References

* P. Scholze, *Étale cohomology of diamonds*, Lemma 3.14 and its proof.
* B. Bhatt, M. Morrow, P. Scholze, *Integral `p`-adic Hodge theory*, Lemma 3.2(ii).
-/

public section

namespace WittVector

open Ideal
open scoped nonZeroDivisors

variable {p : ℕ} [hp : Fact p.Prime] {S : Type*} [CommRing S] [CharP S p] [PerfectRing S p]
  {ϖ : S} {ξ : WittVector p S}

local notation "𝕎" => WittVector p

namespace IsDistinguished

/-- **The quotient by a distinguished element is `[ϖ]`-adically complete.** Over a perfect ring
`S` of characteristic `p` which is `ϖ`-adically complete, let `ξ` be distinguished with zeroth
Witt coordinate in the radical of `(ϖ)`. Then `𝕎 S ⧸ (ξ)` is complete and separated for the ideal
generated by the image of `[ϖ]`. -/
theorem isAdicComplete_quotient (hξ : ξ.IsDistinguished)
    (hξ₀ : ξ.coeff 0 ∈ (span {ϖ}).radical) [IsAdicComplete (span {ϖ}) S] :
    IsAdicComplete (span {Ideal.Quotient.mk (span {ξ}) (teichmuller p ϖ)}) (𝕎 S ⧸ span {ξ}) := by
  have : IsAdicComplete (span {teichmuller p ϖ}) (𝕎 S) :=
    .span_singleton_of_mem (I := span {(p : 𝕎 S), teichmuller p ϖ}) (subset_span (by simp))
  have h := IsAdicComplete.quotient_span_singleton (I := span {teichmuller p ϖ}) (ξ := ξ)
    fun n x hx ↦ by
      rw [span_singleton_pow, mem_span_singleton] at hx ⊢
      exact hξ.teichmuller_pow_dvd_of_dvd_mul hξ₀ hx
  rwa [map_span, Set.image_singleton] at h

/-- If `ξ = [ξ₀] + p u` is distinguished and `ϖ` divides `ξ₀`, then `(ξ, [ϖ]) = (p, [ϖ])`. -/
theorem span_pair_teichmuller_eq (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) :
    span {ξ, teichmuller p ϖ} = span {(p : 𝕎 S), teichmuller p ϖ} := by
  obtain ⟨u, hu⟩ := isDistinguished_iff_exists_unit.mp hξ
  obtain ⟨c, hc⟩ := hξ₀
  rw [hc, map_mul] at hu
  rw [hu, span_pair_right_mul_add, span_insert, span_singleton_mul_right_unit u.isUnit,
    ← span_insert]

/-- **The `(p, [ϖ])`-adic and `[ϖ]`-adic topologies agree on `𝕎 S ⧸ (ξ)`.** If `ξ` is
distinguished and `ϖ` divides `ξ₀`, then the image of `(p, [ϖ])` in `𝕎 S ⧸ (ξ)` is generated by
the image of `[ϖ]`. -/
theorem map_span_p_teichmuller (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) :
    (span {(p : 𝕎 S), teichmuller p ϖ}).map (Ideal.Quotient.mk (span {ξ})) =
      span {Ideal.Quotient.mk (span {ξ}) (teichmuller p ϖ)} := by
  rw [← hξ.span_pair_teichmuller_eq hξ₀, map_span, Set.image_pair, Ideal.Quotient.mk_singleton_self,
    span_insert_zero]

/-- **The quotient by a distinguished element is `p`-adically complete.** Over a perfect ring `S`
of characteristic `p` which is `ϖ`-adically complete, if `ξ` is distinguished with zeroth Witt
coordinate in the radical of `(ϖ)`, then `𝕎 S ⧸ (ξ)` is `p`-adically complete and separated. -/
theorem isAdicComplete_quotient_natCast (hξ : ξ.IsDistinguished)
    (hξ₀ : ξ.coeff 0 ∈ (span {ϖ}).radical) [IsAdicComplete (span {ϖ}) S] :
    IsAdicComplete (span {(p : 𝕎 S ⧸ span {ξ})}) (𝕎 S ⧸ span {ξ}) := by
  have := hξ.isAdicComplete_quotient hξ₀
  obtain ⟨m, hm⟩ := hξ₀
  obtain ⟨c, hc⟩ := mem_span_singleton.mp hm
  obtain ⟨u, hu⟩ := isDistinguished_iff_exists_unit.mp hξ
  -- In the quotient `p u = -[ξ₀]`, so `p ^ (m + 1)` is a unit multiple of `[ξ₀] ^ (m + 1)`, which
  -- is `[ϖ] [ξ₀ c]` because `ξ₀ ^ m = ϖ c`.
  have hξ' : Ideal.Quotient.mk (span {ξ}) (teichmuller p (ξ.coeff 0)) =
      -((p : 𝕎 S ⧸ span {ξ}) * Ideal.Quotient.mk (span {ξ}) ↑u) := by
    rw [eq_neg_iff_add_eq_zero, ← map_natCast (Ideal.Quotient.mk (span {ξ})), ← map_mul, ← map_add,
      ← hu, Ideal.Quotient.mk_singleton_self]
  have hdvd : Ideal.Quotient.mk (span {ξ}) (teichmuller p ϖ) ∣ (p : 𝕎 S ⧸ span {ξ}) ^ (m + 1) := by
    refine ⟨(-Ideal.Quotient.mk (span {ξ}) ↑u⁻¹) ^ (m + 1) *
      Ideal.Quotient.mk (span {ξ}) (teichmuller p (ξ.coeff 0 * c)), ?_⟩
    have hϖ : Ideal.Quotient.mk (span {ξ}) (teichmuller p ϖ) *
        Ideal.Quotient.mk (span {ξ}) (teichmuller p (ξ.coeff 0 * c)) =
        Ideal.Quotient.mk (span {ξ}) (teichmuller p (ξ.coeff 0)) ^ (m + 1) := by
      rw [← map_mul, ← map_mul, ← map_pow, ← map_pow, pow_succ, hc]
      congr 2
      ring
    have hu' : Ideal.Quotient.mk (span {ξ}) ↑u⁻¹ * Ideal.Quotient.mk (span {ξ}) ↑u = 1 := by
      rw [← map_mul, u.inv_mul, map_one]
    rw [mul_left_comm, hϖ, hξ', ← mul_pow]
    congr 1
    linear_combination -(p : 𝕎 S ⧸ span {ξ}) * hu'
  have : IsAdicComplete (span {(p : 𝕎 S ⧸ span {ξ})} ^ (m + 1)) (𝕎 S ⧸ span {ξ}) := by
    rw [span_singleton_pow]
    exact .span_singleton_of_dvd hdvd
  exact .of_pow_le_of_pow_le (k := m + 1) le_rfl
    ((pow_one _).trans_le (Ideal.pow_le_self m.succ_ne_zero))

private theorem span_le_ker_mk_comp_constantCoeff (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) :
    span {ξ} ≤ RingHom.ker ((Ideal.Quotient.mk (span {ϖ})).comp (constantCoeff : 𝕎 S →+* S)) := by
  rw [ker_mk_comp_constantCoeff, ← hξ.span_pair_teichmuller_eq hξ₀]
  exact span_mono (by simp)

/-- The map `𝕎 S ⧸ (ξ) → S ⧸ (ϖ)` induced by the zeroth Witt coordinate, when `ϖ ∣ ξ₀`. -/
private noncomputable def quotientMap (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) :
    𝕎 S ⧸ span {ξ} →+* S ⧸ span {ϖ} :=
  Ideal.Quotient.lift (span {ξ}) ((Ideal.Quotient.mk (span {ϖ})).comp constantCoeff)
    fun _ ha ↦ RingHom.mem_ker.mp (span_le_ker_mk_comp_constantCoeff hξ hξ₀ ha)

private theorem quotientMap_mk (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) (x : 𝕎 S) :
    quotientMap hξ hξ₀ (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (x.coeff 0) :=
  rfl

private theorem ker_quotientMap (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) :
    RingHom.ker (quotientMap hξ hξ₀) = span {Ideal.Quotient.mk (span {ξ}) (teichmuller p ϖ)} := by
  rw [quotientMap, Ideal.ker_quotient_lift _ (span_le_ker_mk_comp_constantCoeff hξ hξ₀),
    ker_mk_comp_constantCoeff, hξ.map_span_p_teichmuller hξ₀]

private theorem quotientMap_surjective (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) :
    Function.Surjective (quotientMap hξ hξ₀) :=
  Ideal.Quotient.lift_surjective_of_surjective _ _
    (Ideal.Quotient.mk_surjective.comp (constantCoeff_surjective (p := p)))

/-- **The reduction of `𝕎 S ⧸ (ξ)` modulo `[ϖ]`.** Over a perfect ring `S` of characteristic `p`,
if `ξ` is distinguished and `ϖ` divides `ξ₀`, then `(𝕎 S ⧸ (ξ)) ⧸ ([ϖ])` is `S ⧸ (ϖ)`, through the
zeroth Witt coordinate (`quotientTeichmullerEquiv_mk_mk`). -/
noncomputable def quotientTeichmullerEquiv (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) :
    (𝕎 S ⧸ span {ξ}) ⧸ span {Ideal.Quotient.mk (span {ξ}) (teichmuller p ϖ)} ≃+*
      S ⧸ span {ϖ} :=
  (quotEquivOfEq (ker_quotientMap hξ hξ₀).symm).trans
    (RingHom.quotientKerEquivOfSurjective (quotientMap_surjective hξ hξ₀))

/-- `quotientTeichmullerEquiv` is induced by the zeroth Witt coordinate. -/
@[simp]
theorem quotientTeichmullerEquiv_mk_mk (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0)
    (x : 𝕎 S) :
    hξ.quotientTeichmullerEquiv hξ₀ (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ x)) =
      Ideal.Quotient.mk _ (x.coeff 0) := by
  rw [quotientTeichmullerEquiv, RingEquiv.trans_apply, quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk, quotientMap_mk]

/-- The inverse of `quotientTeichmullerEquiv` sends the class of `a` to the class of the
Teichmüller representative `[a]`. -/
@[simp]
theorem quotientTeichmullerEquiv_symm_mk (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) (a : S) :
    (hξ.quotientTeichmullerEquiv hξ₀).symm (Ideal.Quotient.mk _ a) =
      Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (teichmuller p a)) := by
  rw [RingEquiv.symm_apply_eq, quotientTeichmullerEquiv_mk_mk, teichmuller_coeff_zero]

/-- **`ξ 𝕎 S [1/[ϖ]] ∩ 𝕎 S = ξ 𝕎 S`.** Over a perfect ring `S` of characteristic `p` and for a
nonzerodivisor `ϖ`, if `ξ` is distinguished with zeroth Witt coordinate in the radical of `(ϖ)`,
then the ideal generated by `ξ` in the localization `𝕎 S [1/[ϖ]]` contracts to `(ξ)`. -/
theorem comap_map_algebraMap (hξ : ξ.IsDistinguished) (hξ₀ : ξ.coeff 0 ∈ (span {ϖ}).radical)
    (hϖ : ϖ ∈ S⁰) (L : Type*) [CommRing L] [Algebra (𝕎 S) L]
    [IsLocalization.Away (teichmuller p ϖ) L] :
    ((span {ξ}).map (algebraMap (𝕎 S) L)).comap (algebraMap (𝕎 S) L) = span {ξ} := by
  refine le_antisymm (fun x hx ↦ ?_) le_comap_map
  obtain ⟨_, ⟨n, rfl⟩, hx⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
    (Submonoid.powers (teichmuller p ϖ)) L _ x).mp (mem_comap.mp hx)
  -- The image of `[ϖ] ^ n` is a nonzerodivisor in `𝕎 S ⧸ (ξ)`.
  have hreg := pow_mem (hξ.mk_teichmuller_mem_nonZeroDivisors hξ₀ hϖ) n
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_pow] at hx
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  exact mem_nonZeroDivisors_iff_left.mp hreg _ hx

end IsDistinguished

end WittVector
