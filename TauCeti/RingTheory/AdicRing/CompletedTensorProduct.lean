/-!
# The completed tensor product of adic rings

Let `B` and `C` be adic rings of finite ideal type which are algebras over a commutative ring
`A`, with chosen ideals of definition `I_B` and `I_C`. Let `J ⊆ B ⊗[A] C` be the ideal generated
by `I_B ⊗ 1` and `1 ⊗ I_C`. The *completed tensor product* `B ⊗̂_A C` is the `J`-adic completion
of `B ⊗[A] C`, with the adic topology of `J (B ⊗̂_A C)`.

The ring `B ⊗̂_A C` is an adic ring of finite ideal type. The maps `b ↦ b ⊗ 1` and `c ↦ 1 ⊗ c`
are continuous `A`-algebra homomorphisms `B → B ⊗̂_A C ← C`, and they are universal: a pair of
continuous `A`-algebra homomorphisms `B → D`, `C → D` into a complete Hausdorff linearly
topologised `A`-algebra `D` factors uniquely through a continuous `A`-algebra homomorphism
`B ⊗̂_A C → D`. In formal geometry the structure maps `A → B` and `A → C` are adic
homomorphisms of adic rings and `B ⊗̂_A C` is the coordinate ring of the fibre product
`Spf B ×_{Spf A} Spf C`; the construction and the results of this file use no topology on `A`.

The completion is formed with the chosen ideals of definition `TauCeti.IsAdicRing.ideal B` and
`TauCeti.IsAdicRing.ideal C`.

## Main definitions

* `TauCeti.AdicRing.CompletedTensorProduct.tensorIdeal A B C`: the ideal `J` of `B ⊗[A] C`
  generated by the ideals of definition of `B` and `C`.
* `TauCeti.AdicRing.CompletedTensorProduct A B C`: the completed tensor product `B ⊗̂_A C`, with
  the adic topology of `J (B ⊗̂_A C)`.
* `TauCeti.AdicRing.CompletedTensorProduct.inl`, `TauCeti.AdicRing.CompletedTensorProduct.inr`:
  the `A`-algebra homomorphisms `b ↦ b ⊗ 1` and `c ↦ 1 ⊗ c`.
* `TauCeti.AdicRing.CompletedTensorProduct.lift`: the continuous `A`-algebra homomorphism
  `B ⊗̂_A C → D` induced by continuous `A`-algebra homomorphisms `B → D` and `C → D`.

## Main results

* `TauCeti.AdicRing.CompletedTensorProduct.isAdicRing`: `B ⊗̂_A C` is an adic ring of finite
  ideal type.
* `TauCeti.AdicRing.CompletedTensorProduct.continuous_inl`,
  `TauCeti.AdicRing.CompletedTensorProduct.continuous_inr`: the two inclusions are continuous.
* `TauCeti.AdicRing.CompletedTensorProduct.denseRange_algebraMap`: the image of `B ⊗[A] C` is
  dense.
* `TauCeti.AdicRing.CompletedTensorProduct.algHom_ext`: continuous `A`-algebra homomorphisms
  out of `B ⊗̂_A C` into a Hausdorff ring agreeing on `B` and on `C` are equal.
* `TauCeti.AdicRing.CompletedTensorProduct.existsUnique_lift`: the universal property of
  `B ⊗̂_A C`.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique I*, Ch. 0, §7.7
  (7.7.1 and 7.7.6), and Ch. I, 10.7.
-/

public section

namespace TauCeti.AdicRing

open Filter Topology TensorProduct

variable (A B C : Type*) [CommRing A]
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsAdicRing B] [Algebra A B]
  [CommRing C] [TopologicalSpace C] [IsTopologicalRing C] [IsAdicRing C] [Algebra A C]

/-- The ideal of `B ⊗[A] C` generated by `I_B ⊗ 1` and `1 ⊗ I_C`, for the chosen ideals of
definition `I_B` of `B` and `I_C` of `C`. -/
noncomputable def CompletedTensorProduct.tensorIdeal : Ideal (B ⊗[A] C) :=
  (IsAdicRing.ideal B).map (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] C) ⊔
    (IsAdicRing.ideal C).map (Algebra.TensorProduct.includeRight : C →ₐ[A] B ⊗[A] C)

/-- The **completed tensor product** `B ⊗̂_A C` of adic rings: the completion of `B ⊗[A] C` along
the ideal generated by the chosen ideals of definition of `B` and `C`. -/
def CompletedTensorProduct : Type _ :=
  AdicCompletion (CompletedTensorProduct.tensorIdeal A B C) (B ⊗[A] C)

namespace CompletedTensorProduct

/-- The ideal `tensorIdeal A B C` is the supremum of the images of the chosen ideals of
definition of `B` and `C` under `b ↦ b ⊗ 1` and `c ↦ 1 ⊗ c`. -/
theorem tensorIdeal_def : tensorIdeal A B C =
    (IsAdicRing.ideal B).map (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] C) ⊔
      (IsAdicRing.ideal C).map (Algebra.TensorProduct.includeRight : C →ₐ[A] B ⊗[A] C) :=
  (rfl)

variable {A B C} in
/-- For `b` in the ideal of definition of `B`, the element `b ⊗ 1` lies in `tensorIdeal A B C`. -/
theorem tmul_one_mem_tensorIdeal {b : B} (hb : b ∈ IsAdicRing.ideal B) :
    b ⊗ₜ[A] (1 : C) ∈ tensorIdeal A B C :=
  Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hb)

variable {A B C} in
/-- For `c` in the ideal of definition of `C`, the element `1 ⊗ c` lies in `tensorIdeal A B C`. -/
theorem one_tmul_mem_tensorIdeal {c : C} (hc : c ∈ IsAdicRing.ideal C) :
    (1 : B) ⊗ₜ[A] c ∈ tensorIdeal A B C :=
  Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc)

/-- The ideal `I_B ⊗ 1 + 1 ⊗ I_C` is finitely generated. -/
theorem tensorIdeal_fg : (tensorIdeal A B C).FG :=
  Submodule.FG.sup ((IsAdicRing.ideal_spec B).1.map _) ((IsAdicRing.ideal_spec C).1.map _)

noncomputable instance : CommRing (CompletedTensorProduct A B C) :=
  inferInstanceAs (CommRing (AdicCompletion (tensorIdeal A B C) (B ⊗[A] C)))

noncomputable instance : Algebra (B ⊗[A] C) (CompletedTensorProduct A B C) :=
  inferInstanceAs (Algebra (B ⊗[A] C) (AdicCompletion (tensorIdeal A B C) (B ⊗[A] C)))

noncomputable instance : Algebra A (CompletedTensorProduct A B C) :=
  inferInstanceAs (Algebra A (AdicCompletion (tensorIdeal A B C) (B ⊗[A] C)))

instance : IsScalarTower A (B ⊗[A] C) (CompletedTensorProduct A B C) :=
  inferInstanceAs (IsScalarTower A (B ⊗[A] C) (AdicCompletion (tensorIdeal A B C) (B ⊗[A] C)))

/-- The completed tensor product carries the adic topology of the extension of the ideal
`I_B ⊗ 1 + 1 ⊗ I_C`. -/
noncomputable instance : WithIdeal (CompletedTensorProduct A B C) :=
  ⟨(tensorIdeal A B C).map (algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C))⟩

/-- The topology of `B ⊗̂_A C` is the adic topology of the extension of the ideal
`I_B ⊗ 1 + 1 ⊗ I_C`. -/
theorem isAdic :
    IsAdic ((tensorIdeal A B C).map (algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C))) :=
  rfl

/-- The completed tensor product of adic rings of finite ideal type is an adic ring of finite
ideal type, with ideal of definition `J (B ⊗̂_A C)`. -/
instance isAdicRing : IsAdicRing (CompletedTensorProduct A B C) :=
  ⟨⟨_, (tensorIdeal_fg A B C).map _, isAdic A B C,
    AdicCompletion.isAdicComplete_self _ (tensorIdeal_fg A B C)⟩⟩

/-- An element of `B ⊗[A] C` maps into the `n`-th power of the ideal of definition of
`B ⊗̂_A C` if and only if it lies in the `n`-th power of `I_B ⊗ 1 + 1 ⊗ I_C`. -/
@[simp]
theorem algebraMap_mem_pow_iff (n : ℕ) {x : B ⊗[A] C} :
    algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C) x ∈
        (tensorIdeal A B C).map (algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C)) ^ n ↔
      x ∈ tensorIdeal A B C ^ n := by
  rw [← Ideal.map_pow]
  exact AdicCompletion.algebraMap_mem_map_pow_iff (tensorIdeal_fg A B C) n

/-- The image of `B ⊗[A] C` in the completed tensor product is dense. -/
theorem denseRange_algebraMap :
    DenseRange (algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C)) :=
  letI : TopologicalSpace (AdicCompletion (tensorIdeal A B C) (B ⊗[A] C)) :=
    inferInstanceAs (TopologicalSpace (CompletedTensorProduct A B C))
  AdicCompletion.denseRange_algebraMap (tensorIdeal_fg A B C) (isAdic A B C)

/-- The left inclusion `b ↦ b ⊗ 1` into the completed tensor product. -/
noncomputable def inl : B →ₐ[A] CompletedTensorProduct A B C :=
  (IsScalarTower.toAlgHom A (B ⊗[A] C) _).comp Algebra.TensorProduct.includeLeft

/-- The right inclusion `c ↦ 1 ⊗ c` into the completed tensor product. -/
noncomputable def inr : C →ₐ[A] CompletedTensorProduct A B C :=
  (IsScalarTower.toAlgHom A (B ⊗[A] C) _).comp Algebra.TensorProduct.includeRight

/-- The left inclusion sends `b` to the image of `b ⊗ 1`. -/
theorem inl_apply (b : B) :
    inl A B C b = algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C) (b ⊗ₜ 1) :=
  (rfl)

/-- The right inclusion sends `c` to the image of `1 ⊗ c`. -/
theorem inr_apply (c : C) :
    inr A B C c = algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C) (1 ⊗ₜ c) :=
  (rfl)

/-- The image of `b ⊗ c` in the completed tensor product is `inl b * inr c`. -/
theorem algebraMap_tmul (b : B) (c : C) :
    algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C) (b ⊗ₜ c) = inl A B C b * inr A B C c := by
  rw [inl_apply, inr_apply, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

/-- The left inclusion `B → B ⊗̂_A C` is continuous. -/
theorem continuous_inl : Continuous (inl A B C) :=
  IsAdic.continuous_of_map_le_radical (f := (inl A B C).toRingHom) (IsAdicRing.ideal_spec B).2.1
    (isAdic A B C) (IsAdicRing.ideal_spec B).1 <| by
      refine le_trans ?_ Ideal.le_radical
      rw [AlgHom.toRingHom_eq_coe, inl, AlgHom.comp_toRingHom, ← Ideal.map_map]
      exact Ideal.map_mono le_sup_left

/-- The right inclusion `C → B ⊗̂_A C` is continuous. -/
theorem continuous_inr : Continuous (inr A B C) :=
  IsAdic.continuous_of_map_le_radical (f := (inr A B C).toRingHom) (IsAdicRing.ideal_spec C).2.1
    (isAdic A B C) (IsAdicRing.ideal_spec C).1 <| by
      refine le_trans ?_ Ideal.le_radical
      rw [AlgHom.toRingHom_eq_coe, inr, AlgHom.comp_toRingHom, ← Ideal.map_map]
      exact Ideal.map_mono le_sup_right

variable {A B C}

/-- Two continuous `A`-algebra homomorphisms out of the completed tensor product into a
Hausdorff ring are equal as soon as they agree on `B` and on `C`. -/
theorem algHom_ext {D : Type*} [Semiring D] [Algebra A D] [TopologicalSpace D] [T2Space D]
    {g₁ g₂ : CompletedTensorProduct A B C →ₐ[A] D} (hg₁ : Continuous g₁) (hg₂ : Continuous g₂)
    (hl : g₁.comp (inl A B C) = g₂.comp (inl A B C))
    (hr : g₁.comp (inr A B C) = g₂.comp (inr A B C)) :
    g₁ = g₂ := by
  have htensor : g₁.comp (IsScalarTower.toAlgHom A (B ⊗[A] C) _) =
      g₂.comp (IsScalarTower.toAlgHom A (B ⊗[A] C) _) :=
    Algebra.TensorProduct.ext hl hr
  exact AlgHom.ext <| congrFun <| (denseRange_algebraMap A B C).equalizer hg₁ hg₂
    congr(⇑$htensor)

section Lift

variable {D : Type*} [CommRing D] [UniformSpace D] [IsUniformAddGroup D] [IsTopologicalRing D]
  [IsLinearTopology D D] [CompleteSpace D] [T2Space D] [Algebra A D]

/-- The uniform structure on `B ⊗[A] C` induced from the completed tensor product; it is the
`J`-adic uniform structure. -/
private noncomputable abbrev uniformSpaceTensor : UniformSpace (B ⊗[A] C) :=
  UniformSpace.comap (algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C)) inferInstance

private theorem isUniformInducing_algebraMap :
    letI := uniformSpaceTensor (A := A) (B := B) (C := C)
    IsUniformInducing (algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C)) :=
  letI := uniformSpaceTensor (A := A) (B := B) (C := C)
  ⟨rfl⟩

omit [IsTopologicalRing D] [CompleteSpace D] [T2Space D] in
/-- The map `B ⊗[A] C → D` induced by continuous `A`-algebra homomorphisms `β : B → D` and
`γ : C → D` is uniformly continuous for the uniform structure induced from `B ⊗̂_A C`. -/
private theorem uniformContinuous_productMap {β : B →ₐ[A] D} {γ : C →ₐ[A] D}
    (hβ : Continuous β) (hγ : Continuous γ) :
    letI := uniformSpaceTensor (A := A) (B := B) (C := C)
    UniformContinuous (Algebra.TensorProduct.productMap β γ) := by
  let := uniformSpaceTensor (A := A) (B := B) (C := C)
  have : IsUniformAddGroup (B ⊗[A] C) := IsUniformAddGroup.comap _
  refine uniformContinuous_of_continuousAt_zero (Algebra.TensorProduct.productMap β γ) ?_
  rw [ContinuousAt, map_zero, isUniformInducing_algebraMap.isInducing.nhds_eq_comap, map_zero,
    ((isAdic A B C).hasBasis_nhds_zero.comap _).tendsto_iff IsLinearTopology.hasBasis_ideal]
  intro V hV
  -- some powers of `I_B` and `I_C` are carried into the open ideal `V` by `β` and `γ`
  obtain ⟨n, -, hn⟩ := (IsAdicRing.ideal_spec B).2.1.hasBasis_nhds_zero.mem_iff.mp
    (hβ.continuousAt.preimage_mem_nhds (by simpa using hV))
  obtain ⟨m, -, hm⟩ := (IsAdicRing.ideal_spec C).2.1.hasBasis_nhds_zero.mem_iff.mp
    (hγ.continuousAt.preimage_mem_nhds (by simpa using hV))
  refine ⟨n + m, trivial, fun x hx ↦ ?_⟩
  have hx : x ∈ tensorIdeal A B C ^ (n + m) := (algebraMap_mem_pow_iff A B C _).mp hx
  have hle : tensorIdeal A B C ^ (n + m) ≤ V.comap (Algebra.TensorProduct.productMap β γ) := by
    refine Ideal.sup_pow_add_le_pow_sup_pow.trans (sup_le ?_ ?_) <;>
      rw [← Ideal.map_pow, Ideal.map_le_iff_le_comap]
    · exact fun b hb ↦ by simpa using hn hb
    · exact fun c hc ↦ by simpa using hm hc
  exact hle hx

/-- The **universal property of the completed tensor product**: continuous `A`-algebra
homomorphisms `β : B → D` and `γ : C → D` into a complete Hausdorff linearly topologised
`A`-algebra induce a continuous `A`-algebra homomorphism `B ⊗̂_A C → D`. -/
noncomputable def lift (β : B →ₐ[A] D) (γ : C →ₐ[A] D) (hβ : Continuous β)
    (hγ : Continuous γ) : CompletedTensorProduct A B C →ₐ[A] D :=
  letI := uniformSpaceTensor (A := A) (B := B) (C := C)
  { IsDenseInducing.extendRingHom isUniformInducing_algebraMap (denseRange_algebraMap A B C)
      (uniformContinuous_productMap hβ hγ) with
    commutes' a := by
      rw [IsScalarTower.algebraMap_apply A (B ⊗[A] C) (CompletedTensorProduct A B C)]
      exact ((isUniformInducing_algebraMap.isDenseInducing (denseRange_algebraMap A B C)).extend_eq
        (uniformContinuous_productMap hβ hγ).continuous _).trans
          ((Algebra.TensorProduct.productMap β γ).commutes a) }

/-- The induced homomorphism `CompletedTensorProduct.lift β γ` is continuous. -/
theorem continuous_lift (β : B →ₐ[A] D) (γ : C →ₐ[A] D) (hβ : Continuous β)
    (hγ : Continuous γ) : Continuous (lift β γ hβ hγ) :=
  letI := uniformSpaceTensor (A := A) (B := B) (C := C)
  (uniformContinuous_uniformly_extend isUniformInducing_algebraMap (denseRange_algebraMap A B C)
    (uniformContinuous_productMap hβ hγ)).continuous

/-- On the image of `B ⊗[A] C`, the induced homomorphism `CompletedTensorProduct.lift β γ` is
`b ⊗ c ↦ β b * γ c`. -/
@[simp]
theorem lift_algebraMap (β : B →ₐ[A] D) (γ : C →ₐ[A] D) (hβ : Continuous β)
    (hγ : Continuous γ) (x : B ⊗[A] C) :
    lift β γ hβ hγ (algebraMap (B ⊗[A] C) (CompletedTensorProduct A B C) x) =
      Algebra.TensorProduct.productMap β γ x :=
  letI := uniformSpaceTensor (A := A) (B := B) (C := C)
  (isUniformInducing_algebraMap.isDenseInducing (denseRange_algebraMap A B C)).extend_eq
    (uniformContinuous_productMap hβ hγ).continuous x

/-- The induced homomorphism `CompletedTensorProduct.lift β γ` restricts to `β` on `B`. -/
@[simp]
theorem lift_inl (β : B →ₐ[A] D) (γ : C →ₐ[A] D) (hβ : Continuous β) (hγ : Continuous γ)
    (b : B) : lift β γ hβ hγ (inl A B C b) = β b := by
  rw [inl_apply, lift_algebraMap, Algebra.TensorProduct.productMap_left_apply]

/-- The induced homomorphism `CompletedTensorProduct.lift β γ` restricts to `γ` on `C`. -/
@[simp]
theorem lift_inr (β : B →ₐ[A] D) (γ : C →ₐ[A] D) (hβ : Continuous β) (hγ : Continuous γ)
    (c : C) : lift β γ hβ hγ (inr A B C c) = γ c := by
  rw [inr_apply, lift_algebraMap, Algebra.TensorProduct.productMap_right_apply]

/-- The induced homomorphism `CompletedTensorProduct.lift β γ` composed with the left inclusion
is `β`. -/
@[simp]
theorem lift_comp_inl (β : B →ₐ[A] D) (γ : C →ₐ[A] D) (hβ : Continuous β)
    (hγ : Continuous γ) : (lift β γ hβ hγ).comp (inl A B C) = β :=
  AlgHom.ext (lift_inl β γ hβ hγ)

/-- The induced homomorphism `CompletedTensorProduct.lift β γ` composed with the right
inclusion is `γ`. -/
@[simp]
theorem lift_comp_inr (β : B →ₐ[A] D) (γ : C →ₐ[A] D) (hβ : Continuous β)
    (hγ : Continuous γ) : (lift β γ hβ hγ).comp (inr A B C) = γ :=
  AlgHom.ext (lift_inr β γ hβ hγ)

/-- A continuous `A`-algebra homomorphism out of `B ⊗̂_A C` restricting to `β` on `B` and to `γ`
on `C` is `CompletedTensorProduct.lift β γ`. -/
theorem lift_unique {β : B →ₐ[A] D} {γ : C →ₐ[A] D} (hβ : Continuous β) (hγ : Continuous γ)
    {ψ : CompletedTensorProduct A B C →ₐ[A] D} (hψ : Continuous ψ)
    (hl : ψ.comp (inl A B C) = β) (hr : ψ.comp (inr A B C) = γ) :
    ψ = lift β γ hβ hγ :=
  algHom_ext hψ (continuous_lift β γ hβ hγ) (hl.trans (lift_comp_inl β γ hβ hγ).symm)
    (hr.trans (lift_comp_inr β γ hβ hγ).symm)

/-- The **universal property of the completed tensor product**: continuous `A`-algebra
homomorphisms `β : B → D` and `γ : C → D` into a complete Hausdorff linearly topologised
`A`-algebra factor uniquely through a continuous `A`-algebra homomorphism `B ⊗̂_A C → D`. -/
theorem existsUnique_lift (β : B →ₐ[A] D) (γ : C →ₐ[A] D) (hβ : Continuous β)
    (hγ : Continuous γ) :
    ∃! ψ : CompletedTensorProduct A B C →ₐ[A] D,
      Continuous ψ ∧ ψ.comp (inl A B C) = β ∧ ψ.comp (inr A B C) = γ :=
  ⟨lift β γ hβ hγ, ⟨continuous_lift β γ hβ hγ, lift_comp_inl β γ hβ hγ, lift_comp_inr β γ hβ hγ⟩,
    fun _ hψ ↦ lift_unique hβ hγ hψ.1 hψ.2.1 hψ.2.2⟩

end Lift

end CompletedTensorProduct

end TauCeti.AdicRing
