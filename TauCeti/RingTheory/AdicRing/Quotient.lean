module

public import TauCeti.RingTheory.AdicRing.Basic
public import TauCeti.Topology.Algebra.Nonarchimedean.Quotient
public import Mathlib.RingTheory.Ideal.Quotient.Noetherian

import TauCeti.RingTheory.AdicCompletion.Finite

/-!
# Quotients of noetherian complete adic rings

The quotient of a noetherian complete adic ring by any ideal is again a complete adic ring
with its quotient topology. For every ideal of definition `I` in the source, the ideal
generated by its image defines the quotient topology and the quotient is separated and
complete for that ideal. In particular every ideal in the source is closed.

This supplies the affine rings of closed formal subspaces: no additional separated completion
of the quotient is needed. The defining ideal in the quotient is specified using the original
ideal, rather than the arbitrary ideal selected by `IsAdicRing.ideal`.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique I*, Ch. 0,
  (7.3.5) and (7.3.6).
-/

public section

namespace TauCeti.IsAdicRing

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
  [IsAdicRing A] [IsNoetherianRing A]

/-- Every quotient of a noetherian complete adic ring is a complete adic ring for the
quotient topology. -/
instance (priority := 100) quotient (J : Ideal A) : IsAdicRing (A ⧸ J) := by
  obtain ⟨I, hfg, hI, hc⟩ := exists_isAdic (A := A)
  have : IsAdicComplete I A := hc
  have : IsAdicComplete I (A ⧸ J) := IsAdicComplete.of_finite I (A ⧸ J)
  refine ⟨I.map (Ideal.Quotient.mk J), hfg.map _,
    isAdic_map_of_isOpenQuotientMap hI _ (QuotientRing.isOpenQuotientMap_mk J), ?_⟩
  exact (IsAdicComplete.map_algebraMap_iff I (A ⧸ J)).mpr inferInstance

end TauCeti.IsAdicRing
