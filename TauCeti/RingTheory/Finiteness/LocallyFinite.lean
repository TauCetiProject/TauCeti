module

public import Mathlib.LinearAlgebra.DFinsupp
public import Mathlib.RingTheory.Noetherian.Basic
public import Mathlib.RingTheory.SimpleModule.Basic
public import TauCeti.Algebra.Module.Submodule.Finite

/-!
# Locally finite modules over an algebra

Let `A` be an algebra over a commutative ring `k`. An `A`-module `M` is *locally finite* over `k`
when every vector generates an `A`-submodule that is finitely generated over `k`. Over a field this
says that every cyclic `A`-submodule is finite-dimensional. Finite-dimensional modules are locally
finite, and so are arbitrary direct sums of them, but a locally finite module may have infinite
dimension. For a quantized enveloping algebra at a generic parameter, the locally finite modules
are exactly the direct sums of finite-dimensional simple modules.

Over a Noetherian base ring `k`, a module is locally finite as soon as it is the sum of some family
of `A`-submodules that are finitely generated over `k`. Local finiteness passes to
submodules, along injective linear maps and to direct sums. Every simple submodule of a locally
finite module, being generated by any of its nonzero vectors, is finitely generated over `k`. If
the `A`-submodules of a locally finite module that are finitely generated over `k` are all
semisimple, then the module is semisimple.

## Main definitions

* `TauCeti.IsLocallyFiniteModule k A M`: every cyclic `A`-submodule of `M` is finitely generated
  over `k`.

## Main results

* `TauCeti.IsLocallyFiniteModule.of_iSup_eq_top`: over a Noetherian ring, a sum of `A`-submodules
  that are finitely generated over `k` is locally finite.
* `TauCeti.IsLocallyFiniteModule.of_injective`: local finiteness passes along injective maps.
* `TauCeti.IsLocallyFiniteModule.dfinsupp`: a direct sum of locally finite modules is locally
  finite.
* `TauCeti.IsLocallyFiniteModule.finite_of_isSimpleModule`: a simple submodule of a locally finite
  module is finitely generated over `k`.
* `TauCeti.IsLocallyFiniteModule.isSemisimpleModule`: a locally finite module whose submodules
  that are finitely generated over `k` are semisimple is semisimple.
-/

public section

namespace TauCeti

open Submodule

variable (k A M : Type*) [CommRing k] [Ring A] [Algebra k A]
  [AddCommGroup M] [Module k M] [Module A M] [IsScalarTower k A M]

/-- An `A`-module `M` is locally finite over `k` when the cyclic `A`-submodule generated by each
vector is a finitely generated `k`-module. -/
class IsLocallyFiniteModule : Prop where
  finite_span_singleton (v : M) : Module.Finite k (span A {v})

variable {k A M}

/-- Local finiteness, phrased with finitely generated `k`-submodules. -/
theorem isLocallyFiniteModule_iff :
    IsLocallyFiniteModule k A M ↔ ∀ v : M, ((span A {v}).restrictScalars k).FG := by
  simp only [← finite_iff_fg_restrictScalars]
  exact ⟨fun h => h.1, fun h => ⟨h⟩⟩

namespace IsLocallyFiniteModule

/-- The cyclic submodule generated by a vector of a locally finite module is finitely generated
over `k`. -/
theorem fg_restrictScalars_span_singleton [IsLocallyFiniteModule k A M] (v : M) :
    ((span A {v}).restrictScalars k).FG :=
  isLocallyFiniteModule_iff.mp ‹_› v

/-- A module that is finitely generated over a Noetherian ring `k` is locally finite. -/
instance of_finite [IsNoetherianRing k] [Module.Finite k M] : IsLocallyFiniteModule k A M :=
  isLocallyFiniteModule_iff.mpr fun _ => IsNoetherian.noetherian _

/-- Local finiteness passes to a module that maps injectively into a locally finite one. -/
theorem of_injective {N : Type*} [AddCommGroup N] [Module k N] [Module A N] [IsScalarTower k A N]
    [IsLocallyFiniteModule k A M] (f : N →ₗ[A] M) (hf : Function.Injective f) :
    IsLocallyFiniteModule k A N := by
  refine isLocallyFiniteModule_iff.mpr fun v => ?_
  have h := fg_restrictScalars_span_singleton (k := k) (A := A) (f v)
  rw [← Set.image_singleton, ← map_span, restrictScalars_map] at h
  exact fg_of_fg_map_injective (f.restrictScalars k) hf h

/-- A submodule of a locally finite module is locally finite. -/
instance submodule [IsLocallyFiniteModule k A M] (N : Submodule A M) :
    IsLocallyFiniteModule k A N :=
  of_injective N.subtype N.injective_subtype

/-- Local finiteness is invariant under linear equivalence. -/
theorem of_linearEquiv {N : Type*} [AddCommGroup N] [Module k N] [Module A N]
    [IsScalarTower k A N] [IsLocallyFiniteModule k A M] (e : N ≃ₗ[A] M) :
    IsLocallyFiniteModule k A N :=
  of_injective e.toLinearMap e.injective

/-- Over a Noetherian ring `k`, an `A`-module that is the sum of a family of `A`-submodules
finitely generated over `k` is locally finite. -/
theorem of_iSup_eq_top [IsNoetherianRing k] {ι : Type*} {p : ι → Submodule A M}
    (hp : ∀ i, Module.Finite k (p i)) (htop : ⨆ i, p i = ⊤) : IsLocallyFiniteModule k A M := by
  refine isLocallyFiniteModule_iff.mpr fun v => ?_
  -- The vector lies in a finite sum of the `p i`, which is finitely generated over `k`.
  obtain ⟨s, hs⟩ := mem_iSup_iff_exists_finset.mp (htop ▸ mem_top : v ∈ ⨆ i, p i)
  have hfg : ((⨆ i ∈ s, p i).restrictScalars k).FG := by
    simp only [restrictScalars_iSup]
    exact fg_biSup s _ fun i _ => (finite_iff_fg_restrictScalars (p i)).mp (hp i)
  have : IsNoetherian k ((⨆ i ∈ s, p i).restrictScalars k) :=
    isNoetherian_of_fg_of_noetherian _ hfg
  exact FG.of_le_of_isNoetherian (restrictScalars_mono k ((span_singleton_le_iff_mem _ _).mpr hs))

/-- A direct sum of locally finite modules is locally finite. -/
instance dfinsupp [IsNoetherianRing k] {ι : Type*} (N : ι → Type*) [∀ i, AddCommGroup (N i)]
    [∀ i, Module k (N i)] [∀ i, Module A (N i)] [∀ i, IsScalarTower k A (N i)]
    [∀ i, IsLocallyFiniteModule k A (N i)] : IsLocallyFiniteModule k A (Π₀ i, N i) := by
  classical
  -- The images of the cyclic submodules of the summands are finite over `k` and span.
  refine of_iSup_eq_top (p := fun x : Σ i, N i => (span A {x.2}).map (DFinsupp.lsingle x.1))
    (fun x => ?_) ?_
  · rw [finite_iff_fg_restrictScalars, restrictScalars_map]
    exact (fg_restrictScalars_span_singleton x.2).map _
  · refine eq_top_iff.mpr ((DFinsupp.iSup_range_lsingle (R := A) (M := N)).ge.trans ?_)
    refine iSup_le fun i => ?_
    rintro _ ⟨y, rfl⟩
    exact mem_iSup_of_mem ⟨i, y⟩ (mem_map_of_mem (mem_span_singleton_self y))

/-- A simple submodule of a locally finite module is finitely generated over `k`, since it is
generated by any of its nonzero vectors. -/
theorem finite_of_isSimpleModule [IsLocallyFiniteModule k A M] (N : Submodule A M)
    [IsSimpleModule A N] : Module.Finite k N := by
  have := IsSimpleModule.nontrivial A N
  obtain ⟨v, hv⟩ := exists_ne (0 : N)
  have hN : span A {(v : M)} = N := by
    rw [← Submodule.map_subtype_span_singleton, IsSimpleModule.span_singleton_eq_top A hv,
      Submodule.map_top, Submodule.range_subtype]
  exact hN ▸ finite_span_singleton (k := k) (A := A) (v : M)

/-- A locally finite module whose `A`-submodules that are finite over `k` are all semisimple is
itself semisimple. -/
theorem isSemisimpleModule [IsLocallyFiniteModule k A M]
    (h : ∀ N : Submodule A M, Module.Finite k N → IsSemisimpleModule A N) :
    IsSemisimpleModule A M :=
  isSemisimpleModule_of_isSemisimpleModule_submodule'
    (fun v => h (span A {v}) (finite_span_singleton v))
    (eq_top_iff.mpr fun v _ => mem_iSup_of_mem v (mem_span_singleton_self v))

end IsLocallyFiniteModule

end TauCeti
