module

public import Mathlib.RingTheory.Smooth.NoetherianDescent
import Mathlib.RingTheory.Adjoin.FG

/-!
# Noetherian models of a smooth algebra and an element

Mathlib's `Algebra.Smooth.exists_subalgebra_fg` shows that a smooth `A`-algebra `B` is the base
change `A ⊗[A₀] B₀` of a smooth algebra `B₀` over a finitely generated `ℤ`-subalgebra `A₀` of
`A`. This file shows that the model can be chosen so that a given element `b ∈ B` comes from
`B₀`: write the image of `b` as a finite sum `∑ aᵢ ⊗ bᵢ` in `A ⊗[A₀] B₀` and base change the
model to the `A₀`-subalgebra of `A` generated by the coefficients `aᵢ`, which is again
noetherian.

Such a model reduces a statement about `b` over an arbitrary base ring `A` to a noetherian base,
for instance the regularity of `b` tested on the fibres of `B` over `A`.

## Main results

* `Algebra.Smooth.exists_isNoetherianRing_and_eq_one_tmul`: a smooth `A`-algebra `B` is the base
  change of a smooth algebra `B₀` over a noetherian ring, in such a way that a given `b ∈ B`
  is the image of `1 ⊗ b₀` for some `b₀ ∈ B₀`.
-/

public section

universe u

open TensorProduct

namespace Algebra.Smooth

/-- A smooth `A`-algebra `B` is the base change `A ⊗[A₀] B₀` of a smooth algebra `B₀` over a
noetherian ring `A₀`, in such a way that a given element `b ∈ B` corresponds to `1 ⊗ b₀` for
some `b₀ ∈ B₀`. -/
theorem exists_isNoetherianRing_and_eq_one_tmul {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] [Smooth A B] (b : B) :
    ∃ (A₀ B₀ : Type u) (_ : CommRing A₀) (_ : CommRing B₀) (_ : Algebra A₀ A)
      (_ : Algebra A₀ B₀), IsNoetherianRing A₀ ∧ Smooth A₀ B₀ ∧
        ∃ (e : B ≃ₐ[A] A ⊗[A₀] B₀) (b₀ : B₀), e b = 1 ⊗ₜ b₀ := by
  classical
  -- A model `B₁` over a finitely generated `ℤ`-subalgebra `A₁` of `A`, base changed to the
  -- `A₁`-subalgebra `A₀` generated by the coefficients of the image of `b`.
  obtain ⟨A₁, B₁, _, _, hA₁, _, ⟨e₁⟩⟩ := exists_subalgebra_fg ℤ A B
  obtain ⟨s, hs⟩ := TensorProduct.exists_finset (e₁ b)
  have : IsNoetherianRing A₁ := isNoetherianRing_of_fg hA₁
  let A₀ : Subalgebra A₁ A := adjoin A₁ ((s.image Prod.fst : Finset A) : Set A)
  have hmem (i : A × B₁) (hi : i ∈ s) : i.1 ∈ A₀ :=
    subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hi))
  refine ⟨A₀, A₀ ⊗[A₁] B₁, inferInstance, inferInstance, inferInstance, inferInstance,
    isNoetherianRing_of_fg (Subalgebra.fg_adjoin_finset _), inferInstance,
    e₁.trans (Algebra.TensorProduct.cancelBaseChange A₁ A₀ A A B₁).symm,
    ∑ i ∈ s.attach, (⟨i.1.1, hmem _ i.2⟩ : A₀) ⊗ₜ[A₁] i.1.2, ?_⟩
  rw [AlgEquiv.trans_apply, AlgEquiv.symm_apply_eq, hs]
  simp [tmul_sum, Algebra.smul_def, ← Finset.sum_attach s]

end Algebra.Smooth
