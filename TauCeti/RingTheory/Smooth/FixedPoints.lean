public import Mathlib.RingTheory.Smooth.Basic
public import TauCeti.Data.ZMod.MonoidHomEquiv

/-!
# Fixed-point ideals and Edixhoven's tame smoothness theorem

Let `R` be a commutative ring, `A` a commutative `R`-algebra, and `ρ : G →* (A ≃ₐ[R] A)` an action
of a monoid `G` on `A` by `R`-algebra automorphisms. The **fixed-point ideal**
`TauCeti.fixedPointIdeal ρ` is the ideal of `A` generated by all differences `ρ g a - a` for
`g : G` and `a : A`. An `R`-algebra homomorphism `f : A →ₐ[R] B` kills this ideal if and only if
`f ∘ ρ g = f` for every `g : G`, so the quotient `A ⧸ fixedPointIdeal ρ` corepresents the
subfunctor of `G`-fixed points of `Spec A` (`TauCeti.fixedPointQuotientHomEquiv`).

When `A` is of finite type over `R` and `G` is finite, the fixed-point ideal is generated by the
differences `ρ g s - s` as `s` ranges over a finite set of `R`-algebra generators of `A`, so it is
finitely generated over any base ring `R`, without any Noetherian hypothesis
(`TauCeti.fixedPointIdeal_fg`). Consequently, finite presentation passes from `A` to
`A ⧸ fixedPointIdeal ρ` (`TauCeti.finitePresentation_quotient_fixedPointIdeal`).

The main result is **Edixhoven's theorem** (`TauCeti.formallySmooth_quotient_fixedPointIdeal` and
`TauCeti.smooth_quotient_fixedPointIdeal`): if `G` is a finite group whose order is invertible in
`R` and `A` is formally smooth (respectively, smooth) over `R`, then `A ⧸ fixedPointIdeal ρ` is
formally smooth (respectively, smooth) over `R`. The proof verifies the infinitesimal lifting
criterion directly. Given a square-zero ideal `I` of an `R`-algebra `B` and a `G`-invariant point
`f₀ : A →ₐ[R] B ⧸ I`, formal smoothness of `A` supplies an arbitrary lift `φ : A →ₐ[R] B`. Each
defect `δ g a = φ (ρ g a) - φ a` lies in `I`, so because `I ^ 2 = ⊥` each `δ g` is a derivation
along `φ`. Averaging over `G` yields the perturbation `Δ a = |G|⁻¹ • ∑ g, δ g a ∈ I`, which is
again a derivation along `φ`; therefore `ψ a = φ a + Δ a = |G|⁻¹ • ∑ g, φ (ρ g a)` is a
`G`-invariant `R`-algebra homomorphism lifting `f₀`.

## Main definitions

* `TauCeti.fixedPointIdeal`: the ideal generated by all differences `ρ g a - a`.
* `TauCeti.fixedPointQuotientHomEquiv`: the universal property of `A ⧸ fixedPointIdeal ρ`
  identifying its `B`-points with the `G`-fixed `B`-points of `A`.
* `TauCeti.fixedPointQuotientEquivOfEqOne`: for the trivial action, the fixed-point quotient is
  isomorphic to `A`.
* `TauCeti.fixedPointQuotientEquiv`: an equivariant algebra equivalence induces an algebra
  equivalence of fixed-point quotients.
* `TauCeti.tensorSwapAction`: the `ℤ/2ℤ`-action on `A ⊗[R] A` swapping the two tensor factors.
* `TauCeti.fixedPointQuotientTensorSwapEquiv`: the fixed-point quotient of `A ⊗[R] A` under
  swapping the factors is canonically isomorphic to `A` (the diagonal).
* `TauCeti.reynoldsRetraction` and `TauCeti.reynoldsRetractionTensor`: when `G` is finite of
  invertible order in `R` and its invariants in `A` equal the image of an injective `R → A`, the
  averaging retraction `A →ₗ[R] R` and its tensor extension `A ⊗[R] M →ₗ[R] M`.

## Main results

* `TauCeti.fixedPointIdeal_le_iff` and `TauCeti.fixedPointIdeal_le_ker_iff`: universal property of
  the fixed-point ideal.
* `TauCeti.fixedPointIdeal_eq_iSup_of_closure_eq_top` and
  `TauCeti.fixedPointIdeal_eq_span_of_zpowers_eq_top`: generating sets of `G` suffice to generate
  the fixed-point ideal.
* `TauCeti.fixedPointIdeal_tensorSwapAction`: the fixed-point ideal of the swap action on
  `A ⊗[R] A` is the kernel of multiplication `A ⊗[R] A →ₐ[R] A`.
* `TauCeti.fixedPointIdeal_fg` and `TauCeti.finitePresentation_quotient_fixedPointIdeal`: finite
  generation of the fixed-point ideal and finite presentation of the fixed-point quotient.
* `TauCeti.formallySmooth_quotient_fixedPointIdeal`: formal smoothness of the fixed-point quotient
  of a formally smooth algebra under a finite group of invertible order.
* `TauCeti.smooth_quotient_fixedPointIdeal`: smoothness of the fixed-point quotient of a smooth
  algebra under a finite group of invertible order.
* `TauCeti.one_tmul_reynoldsRetractionTensor_of_fixed`: `G`-invariants in `A ⊗[R] M` are
  canonically identified with `M` via `m ↦ 1 ⊗ₜ m`.

## References

* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), Propositions
  3.1 and 3.4, pp. 293–295.
-/

public section

open scoped TensorProduct

namespace TauCeti

universe u v w x

section FixedPointIdeal

variable {R : Type u} {A : Type v} {G : Type w}
variable [CommRing R] [CommRing A] [Algebra R A] [Monoid G]

/-- The **fixed-point ideal** of an action `ρ : G →* (A ≃ₐ[R] A)` of a monoid on a commutative
`R`-algebra `A`: the ideal generated by all differences `ρ g a - a`. Geometrically, it cuts out
the closed fixed-point subscheme `(Spec A)^G` of `Spec A`. -/
def fixedPointIdeal (ρ : G →* (A ≃ₐ[R] A)) : Ideal A :=
  ⨆ g : G, Ideal.span (Set.range fun a : A ↦ ρ g a - a)

/-- The fixed-point ideal is the supremum of the ideals generated by `ρ g a - a` over `g : G`. -/
theorem fixedPointIdeal_eq_iSup (ρ : G →* (A ≃ₐ[R] A)) :
    fixedPointIdeal ρ = ⨆ g : G, Ideal.span (Set.range fun a : A ↦ ρ g a - a) :=
  (rfl)

/-- Every difference `ρ g a - a` lies in the fixed-point ideal. -/
theorem sub_mem_fixedPointIdeal (ρ : G →* (A ≃ₐ[R] A)) (g : G) (a : A) :
    ρ g a - a ∈ fixedPointIdeal ρ :=
  Submodule.mem_iSup_of_mem g (Ideal.subset_span ⟨a, rfl⟩)

/-- Universal property of the fixed-point ideal: it is the smallest ideal containing all
differences `ρ g a - a`. -/
theorem fixedPointIdeal_le_iff {ρ : G →* (A ≃ₐ[R] A)} {J : Ideal A} :
    fixedPointIdeal ρ ≤ J ↔ ∀ g a, ρ g a - a ∈ J := by
  rw [fixedPointIdeal_eq_iSup, iSup_le_iff]
  refine forall_congr' fun g ↦ ?_
  rw [Ideal.span_le, Set.range_subset_iff]
  rfl

/-- A ring homomorphism out of `A` kills the fixed-point ideal if and only if it is invariant under
every `ρ g`. -/
theorem fixedPointIdeal_le_ker_ringHom_iff {B : Type x} [Ring B] {F : Type*} [FunLike F A B]
    [RingHomClass F A B] {ρ : G →* (A ≃ₐ[R] A)} (f : F) :
    fixedPointIdeal ρ ≤ RingHom.ker f ↔ ∀ g a, f (ρ g a) = f a := by
  rw [fixedPointIdeal_le_iff]
  refine forall_congr' fun g ↦ forall_congr' fun a ↦ ?_
  rw [RingHom.mem_ker, map_sub, sub_eq_zero]

/-- An `R`-algebra homomorphism out of `A` kills the fixed-point ideal if and only if it is
invariant under the action of `G`. -/
theorem fixedPointIdeal_le_ker_iff {B : Type x} [CommRing B] [Algebra R B] {ρ : G →* (A ≃ₐ[R] A)}
    (f : A →ₐ[R] B) :
    fixedPointIdeal ρ ≤ RingHom.ker f ↔ ∀ g : G, f.comp (ρ g : A →ₐ[R] A) = f := by
  rw [fixedPointIdeal_le_ker_ringHom_iff f]
  refine forall_congr' fun g ↦ ?_
  rw [AlgHom.ext_iff]
  rfl

/-- The quotient map `A →ₐ[R] A ⧸ fixedPointIdeal ρ` is invariant under every `ρ g`. -/
@[simp]
theorem mk_fixedPointIdeal_comp (ρ : G →* (A ≃ₐ[R] A)) (g : G) :
    (Ideal.Quotient.mkₐ R (fixedPointIdeal ρ)).comp (ρ g : A →ₐ[R] A) =
      Ideal.Quotient.mkₐ R (fixedPointIdeal ρ) := by
  have h := (fixedPointIdeal_le_ker_iff (Ideal.Quotient.mkₐ R (fixedPointIdeal ρ))).mp
    (Ideal.Quotient.mkₐ_ker R (fixedPointIdeal ρ)).ge
  exact h g

/-- **Universal property of the fixed-point quotient**: `B`-points of `A ⧸ fixedPointIdeal ρ` are
canonically in bijection with `G`-fixed `B`-points of `A`. -/
def fixedPointQuotientHomEquiv (ρ : G →* (A ≃ₐ[R] A)) (B : Type x) [CommRing B] [Algebra R B] :
    (A ⧸ fixedPointIdeal ρ →ₐ[R] B) ≃ {f : A →ₐ[R] B // ∀ g : G, f.comp (ρ g : A →ₐ[R] A) = f}
    where
  toFun q := ⟨q.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal ρ)), fun g ↦ by
    rw [AlgHom.comp_assoc, mk_fixedPointIdeal_comp]⟩
  invFun f := Ideal.Quotient.liftₐ (fixedPointIdeal ρ) f.1 fun a ha ↦
    RingHom.mem_ker.mp ((fixedPointIdeal_le_ker_iff f.1).mpr f.2 ha)
  left_inv q := Ideal.Quotient.algHom_ext R (Ideal.Quotient.liftₐ_comp _ _ _)
  right_inv f := Subtype.ext (Ideal.Quotient.liftₐ_comp _ _ _)

/-- The forward direction of `fixedPointQuotientHomEquiv` precomposes with the quotient map. -/
@[simp]
theorem fixedPointQuotientHomEquiv_apply {B : Type x} [CommRing B] [Algebra R B]
    (ρ : G →* (A ≃ₐ[R] A)) (q : A ⧸ fixedPointIdeal ρ →ₐ[R] B) :
    (fixedPointQuotientHomEquiv ρ B q : A →ₐ[R] B) =
      q.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal ρ)) :=
  (rfl)

/-- The inverse of `fixedPointQuotientHomEquiv` evaluates on a quotient class via its
representative. -/
@[simp]
theorem fixedPointQuotientHomEquiv_symm_mk {B : Type x} [CommRing B] [Algebra R B]
    (ρ : G →* (A ≃ₐ[R] A))
    (f : {f : A →ₐ[R] B // ∀ g : G, f.comp (ρ g : A →ₐ[R] A) = f}) (a : A) :
    (fixedPointQuotientHomEquiv ρ B).symm f (Ideal.Quotient.mk (fixedPointIdeal ρ) a) = f.1 a :=
  (rfl)

/-- Composing the inverse of `fixedPointQuotientHomEquiv` with the quotient map recovers `f`. -/
@[simp]
theorem fixedPointQuotientHomEquiv_symm_comp_mk {B : Type x} [CommRing B] [Algebra R B]
    (ρ : G →* (A ≃ₐ[R] A))
    (f : {f : A →ₐ[R] B // ∀ g : G, f.comp (ρ g : A →ₐ[R] A) = f}) :
    ((fixedPointQuotientHomEquiv ρ B).symm f).comp (Ideal.Quotient.mkₐ R (fixedPointIdeal ρ)) =
      f.1 :=
  AlgHom.ext fun a ↦ fixedPointQuotientHomEquiv_symm_mk ρ f a

/-- The fixed-point ideal of the trivial action is zero. -/
@[simp]
theorem fixedPointIdeal_one :
    fixedPointIdeal (1 : G →* (A ≃ₐ[R] A)) = ⊥ := by
  refine le_antisymm (fixedPointIdeal_le_iff.mpr fun g a ↦ ?_) bot_le
  simp

/-- For the trivial action, the fixed-point quotient is canonically isomorphic to `A`. -/
def fixedPointQuotientEquivOfEqOne {ρ : G →* (A ≃ₐ[R] A)} (hρ : ρ = 1) :
    (A ⧸ fixedPointIdeal ρ) ≃ₐ[R] A :=
  (Ideal.quotientEquivAlgOfEq R (by rw [hρ, fixedPointIdeal_one])).trans
    (AlgEquiv.quotientBot R A)

/-- Under `fixedPointQuotientEquivOfEqOne`, a quotient class maps to its representative. -/
@[simp]
theorem fixedPointQuotientEquivOfEqOne_mk {ρ : G →* (A ≃ₐ[R] A)} (hρ : ρ = 1) (a : A) :
    fixedPointQuotientEquivOfEqOne hρ (Ideal.Quotient.mk (fixedPointIdeal ρ) a) = a :=
  (rfl)

/-- The inverse of `fixedPointQuotientEquivOfEqOne` is the quotient map. -/
@[simp]
theorem fixedPointQuotientEquivOfEqOne_symm {ρ : G →* (A ≃ₐ[R] A)} (hρ : ρ = 1) (a : A) :
    (fixedPointQuotientEquivOfEqOne hρ).symm a = Ideal.Quotient.mk (fixedPointIdeal ρ) a :=
  (rfl)

/-- An equivariant `R`-algebra equivalence carries the fixed-point ideal of the source action onto
the fixed-point ideal of the target action. -/
theorem map_fixedPointIdeal_of_equiv {B : Type x} [CommRing B] [Algebra R B]
    {ρ : G →* (A ≃ₐ[R] A)} {σ : G →* (B ≃ₐ[R] B)} (e : A ≃ₐ[R] B)
    (he : ∀ g a, e (ρ g a) = σ g (e a)) :
    (fixedPointIdeal ρ).map (e : A →+* B) = fixedPointIdeal σ := by
  refine le_antisymm ?_ ?_
  · rw [Ideal.map_le_iff_le_comap, fixedPointIdeal_le_iff]
    intro g a
    rw [Ideal.mem_comap, RingHom.coe_coe, map_sub, he]
    exact sub_mem_fixedPointIdeal σ g (e a)
  · rw [fixedPointIdeal_le_iff]
    intro g b
    have hmem : ρ g (e.symm b) - e.symm b ∈ fixedPointIdeal ρ :=
      sub_mem_fixedPointIdeal ρ g (e.symm b)
    have hmap := Ideal.mem_map_of_mem (e : A →+* B) hmem
    simpa [he] using hmap

/-- An equivariant `R`-algebra equivalence induces an `R`-algebra equivalence between fixed-point
quotients. -/
def fixedPointQuotientEquiv {B : Type x} [CommRing B] [Algebra R B]
    {ρ : G →* (A ≃ₐ[R] A)} {σ : G →* (B ≃ₐ[R] B)} (e : A ≃ₐ[R] B)
    (he : ∀ g a, e (ρ g a) = σ g (e a)) :
    (A ⧸ fixedPointIdeal ρ) ≃ₐ[R] (B ⧸ fixedPointIdeal σ) :=
  Ideal.quotientEquivAlg (fixedPointIdeal ρ) (fixedPointIdeal σ) e
    (map_fixedPointIdeal_of_equiv e he).symm

/-- `fixedPointQuotientEquiv` applies `e` to representatives. -/
@[simp]
theorem fixedPointQuotientEquiv_mk {B : Type x} [CommRing B] [Algebra R B]
    {ρ : G →* (A ≃ₐ[R] A)} {σ : G →* (B ≃ₐ[R] B)} (e : A ≃ₐ[R] B)
    (he : ∀ g a, e (ρ g a) = σ g (e a)) (a : A) :
    fixedPointQuotientEquiv e he (Ideal.Quotient.mk (fixedPointIdeal ρ) a) =
      Ideal.Quotient.mk (fixedPointIdeal σ) (e a) :=
  (rfl)

/-- The inverse of `fixedPointQuotientEquiv` applies `e.symm` to representatives. -/
@[simp]
theorem fixedPointQuotientEquiv_symm_mk {B : Type x} [CommRing B] [Algebra R B]
    {ρ : G →* (A ≃ₐ[R] A)} {σ : G →* (B ≃ₐ[R] B)} (e : A ≃ₐ[R] B)
    (he : ∀ g a, e (ρ g a) = σ g (e a)) (b : B) :
    (fixedPointQuotientEquiv e he).symm (Ideal.Quotient.mk (fixedPointIdeal σ) b) =
      Ideal.Quotient.mk (fixedPointIdeal ρ) (e.symm b) :=
  (rfl)

end FixedPointIdeal

section Generators

variable {R : Type u} {A : Type v} {G : Type w}
variable [CommRing R] [CommRing A] [Algebra R A]

/-- If a set `S` generates `G` as a monoid, then the fixed-point ideal of `ρ` is already generated
by the differences `ρ s a - a` for `s ∈ S`. -/
theorem fixedPointIdeal_eq_iSup_of_closure_eq_top [Monoid G] (ρ : G →* (A ≃ₐ[R] A))
    {S : Set G} (hS : Submonoid.closure S = ⊤) :
    fixedPointIdeal ρ = ⨆ s : S, Ideal.span (Set.range fun a : A ↦ ρ s.1 a - a) := by
  let J : Ideal A := ⨆ s : S, Ideal.span (Set.range fun a : A ↦ ρ s.1 a - a)
  refine le_antisymm ?_ (iSup_le fun s ↦ Ideal.span_le.mpr <| by
    rintro _ ⟨a, rfl⟩
    exact sub_mem_fixedPointIdeal ρ s.1 a)
  have hsub : Submonoid.closure S ≤
      { carrier := {g : G | (Ideal.Quotient.mkₐ R J).comp (ρ g : A →ₐ[R] A) =
          Ideal.Quotient.mkₐ R J}
        one_mem' := by ext a; simp
        mul_mem' := fun {g₁ g₂} hg₁ hg₂ ↦ by
          ext a
          have h1 := AlgHom.congr_fun hg₁ (ρ g₂ a)
          have h2 := AlgHom.congr_fun hg₂ a
          simpa [AlgHom.comp_apply, map_mul] using h1.trans h2 : Submonoid G } := by
    rw [Submonoid.closure_le]
    intro s hs
    ext a
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, Ideal.Quotient.mkₐ_eq_mk]
    rw [Ideal.Quotient.eq]
    exact Submodule.mem_iSup_of_mem ⟨s, hs⟩ (Ideal.subset_span ⟨a, rfl⟩)
  rw [fixedPointIdeal_le_iff]
  intro g a
  have hg : (Ideal.Quotient.mkₐ R J).comp (ρ g : A →ₐ[R] A) = Ideal.Quotient.mkₐ R J :=
    hsub (hS ▸ Submonoid.mem_top g)
  have hga := AlgHom.congr_fun hg a
  simpa only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq] using hga

/-- If a set `S` generates a group `G`, then the fixed-point ideal of `ρ` is already generated by
the differences `ρ s a - a` for `s ∈ S`. -/
theorem fixedPointIdeal_eq_iSup_of_subgroup_closure_eq_top [Group G] (ρ : G →* (A ≃ₐ[R] A))
    {S : Set G} (hS : Subgroup.closure S = ⊤) :
    fixedPointIdeal ρ = ⨆ s : S, Ideal.span (Set.range fun a : A ↦ ρ s.1 a - a) := by
  let J : Ideal A := ⨆ s : S, Ideal.span (Set.range fun a : A ↦ ρ s.1 a - a)
  refine le_antisymm ?_ (iSup_le fun s ↦ Ideal.span_le.mpr <| by
    rintro _ ⟨a, rfl⟩
    exact sub_mem_fixedPointIdeal ρ s.1 a)
  let K : Subgroup G :=
    { carrier := {g : G | (Ideal.Quotient.mkₐ R J).comp (ρ g : A →ₐ[R] A) =
        Ideal.Quotient.mkₐ R J}
      one_mem' := by ext a; simp
      mul_mem' := fun {g₁ g₂} hg₁ hg₂ ↦ by
        ext a
        have h1 := AlgHom.congr_fun hg₁ (ρ g₂ a)
        have h2 := AlgHom.congr_fun hg₂ a
        simpa [AlgHom.comp_apply, map_mul] using h1.trans h2
      inv_mem' := fun {g} hg ↦ by
        ext a
        have h1 := AlgHom.congr_fun hg ((ρ g⁻¹) a)
        have h2 : ρ g (ρ g⁻¹ a) = a := by
          rw [← AlgEquiv.mul_apply, ← map_mul, mul_inv_cancel, map_one, AlgEquiv.one_apply]
        simpa only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, h2] using h1.symm }
  have hsub : Subgroup.closure S ≤ K := by
    rw [Subgroup.closure_le]
    intro s hs
    ext a
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, Ideal.Quotient.mkₐ_eq_mk]
    rw [Ideal.Quotient.eq]
    exact Submodule.mem_iSup_of_mem ⟨s, hs⟩ (Ideal.subset_span ⟨a, rfl⟩)
  rw [fixedPointIdeal_le_iff]
  intro g a
  have hg : g ∈ K := hsub (hS ▸ Subgroup.mem_top g)
  have hga := AlgHom.congr_fun hg a
  simpa only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq] using hga

/-- If a group `G` is generated by a single element `g₀`, then the fixed-point ideal of `ρ` is
generated by the differences `ρ g₀ a - a`. -/
theorem fixedPointIdeal_eq_span_of_zpowers_eq_top [Group G] (ρ : G →* (A ≃ₐ[R] A))
    {g₀ : G} (hg₀ : Subgroup.zpowers g₀ = ⊤) :
    fixedPointIdeal ρ = Ideal.span (Set.range fun a : A ↦ ρ g₀ a - a) := by
  have hS : Subgroup.closure ({g₀} : Set G) = ⊤ := by
    rwa [← Subgroup.zpowers_eq_closure]
  rw [fixedPointIdeal_eq_iSup_of_subgroup_closure_eq_top ρ hS]
  refine le_antisymm (iSup_le fun ⟨s, hs⟩ ↦ ?_) (le_iSup_of_le ⟨g₀, Set.mem_singleton g₀⟩ le_rfl)
  rcases Set.mem_singleton_iff.mp hs with rfl
  exact le_rfl

/-- For an action of `ℤ/Nℤ` (written multiplicatively), the fixed-point ideal is generated by the
differences `ρ (ofAdd 1) a - a`. -/
theorem fixedPointIdeal_zmod {N : ℕ} (ρ : Multiplicative (ZMod N) →* (A ≃ₐ[R] A)) :
    fixedPointIdeal ρ = Ideal.span (Set.range fun a : A ↦ ρ (.ofAdd 1) a - a) :=
  fixedPointIdeal_eq_span_of_zpowers_eq_top ρ
    (eq_top_iff.mpr fun x _ ↦ Multiplicative.mem_zpowers_ofAdd_one x)

end Generators

section TensorSwap

variable (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A]

/-- The `ℤ/2ℤ`-action on `A ⊗[R] A` swapping the two tensor factors. -/
noncomputable def tensorSwapAction :
    Multiplicative (ZMod 2) →* (A ⊗[R] A ≃ₐ[R] A ⊗[R] A) :=
  (zmodMonoidHomEquiv 2 (A ⊗[R] A ≃ₐ[R] A ⊗[R] A)).symm
    ⟨Algebra.TensorProduct.comm R A A, by
      ext x
      induction x with
      | tmul a b => simp [sq]
      | add x y hx hy =>
        rw [sq, AlgEquiv.mul_apply, map_add, map_add, AlgEquiv.one_apply]
        simp only [sq, AlgEquiv.mul_apply, AlgEquiv.one_apply] at hx hy
        rw [hx, hy]⟩

/-- The generator of `tensorSwapAction` is `Algebra.TensorProduct.comm`. -/
@[simp]
theorem tensorSwapAction_ofAdd_one :
    tensorSwapAction R A (.ofAdd 1) = Algebra.TensorProduct.comm R A A :=
  zmodMonoidHomEquiv_symm_apply_ofAdd_one _

/-- **The fixed-point ideal of swapping the factors of `A ⊗[R] A` is the kernel of multiplication.**
Contravariantly, the fixed-point subscheme of the swap involution on `Spec A × Spec A` is the
diagonal `Spec A`, over any commutative base ring `R`. -/
theorem fixedPointIdeal_tensorSwapAction :
    fixedPointIdeal (tensorSwapAction R A) =
      RingHom.ker (Algebra.TensorProduct.lmul' R (S := A)) := by
  rw [fixedPointIdeal_zmod, tensorSwapAction_ofAdd_one]
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_le]
    rintro _ ⟨x, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, sub_eq_zero]
    induction x with
    | tmul a b => simp [mul_comm]
    | add x y hx hy => simp [hx, hy]
  · intro x hx
    rw [RingHom.mem_ker] at hx
    -- Every tensor `x` differs from `1 ⊗ lmul' x` by an element of the swap fixed-point ideal.
    have hdiff : ∀ y : A ⊗[R] A,
        y - (1 : A) ⊗ₜ[R] (Algebra.TensorProduct.lmul' R (S := A) y) ∈
          Ideal.span (Set.range fun t : A ⊗[R] A ↦ Algebra.TensorProduct.comm R A A t - t) := by
      intro y
      induction y with
      | tmul a b =>
        have hgen : (1 : A) ⊗ₜ[R] a - a ⊗ₜ[R] (1 : A) ∈
            Ideal.span (Set.range fun t : A ⊗[R] A ↦ Algebra.TensorProduct.comm R A A t - t) :=
          Ideal.subset_span ⟨a ⊗ₜ[R] (1 : A), by simp⟩
        have hmul := Ideal.mul_mem_left _ (-((1 : A) ⊗ₜ[R] b)) hgen
        have heq : -((1 : A) ⊗ₜ[R] b) * ((1 : A) ⊗ₜ[R] a - a ⊗ₜ[R] (1 : A)) =
            a ⊗ₜ[R] b - (1 : A) ⊗ₜ[R] (a * b) := by
          rw [mul_sub, neg_mul, neg_mul, Algebra.TensorProduct.tmul_mul_tmul,
            Algebra.TensorProduct.tmul_mul_tmul, one_mul, one_mul, mul_one, mul_comm b a]
          abel
        simpa [heq] using hmul
      | add y z hy hz =>
        have hadd := Submodule.add_mem _ hy hz
        simpa [map_add, TensorProduct.tmul_add, add_sub_add_comm] using hadd
    have hx' := hdiff x
    simpa [hx] using hx'

private theorem lmul'_surjective :
    Function.Surjective (Algebra.TensorProduct.lmul' R (S := A)) :=
  fun a ↦ ⟨a ⊗ₜ[R] 1, by simp⟩

/-- The fixed-point quotient of `A ⊗[R] A` under swapping the factors is canonically isomorphic to
`A` via multiplication. -/
noncomputable def fixedPointQuotientTensorSwapEquiv :
    (A ⊗[R] A ⧸ fixedPointIdeal (tensorSwapAction R A)) ≃ₐ[R] A :=
  (Ideal.quotientEquivAlgOfEq R (fixedPointIdeal_tensorSwapAction R A)).trans
    (Ideal.quotientKerAlgEquivOfSurjective (lmul'_surjective R A))

/-- `fixedPointQuotientTensorSwapEquiv` sends the class of `a ⊗ b` to `a * b`. -/
@[simp]
theorem fixedPointQuotientTensorSwapEquiv_mk (x : A ⊗[R] A) :
    fixedPointQuotientTensorSwapEquiv R A (Ideal.Quotient.mk _ x) =
      Algebra.TensorProduct.lmul' R (S := A) x := by
  rw [fixedPointQuotientTensorSwapEquiv, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk]
  exact Ideal.quotientKerAlgEquivOfSurjective_mk (lmul'_surjective R A) x

/-- The inverse of `fixedPointQuotientTensorSwapEquiv` sends `a` to the class of `a ⊗ₜ 1`. -/
@[simp]
theorem fixedPointQuotientTensorSwapEquiv_symm_apply (a : A) :
    (fixedPointQuotientTensorSwapEquiv R A).symm a =
      Ideal.Quotient.mk _ (a ⊗ₜ[R] (1 : A)) := by
  apply (fixedPointQuotientTensorSwapEquiv R A).injective
  simp

end TensorSwap

section FinitePresentation

variable {R : Type u} {A : Type v} {G : Type w}
variable [CommRing R] [CommRing A] [Algebra R A] [Monoid G]

/-- **Finite generation of the fixed-point ideal.** If `A` is a finite-type `R`-algebra and `G` is
a finite monoid acting on `A` by `R`-algebra automorphisms, then `fixedPointIdeal ρ` is finitely
generated (over any base ring `R`, without Noetherian hypotheses). -/
theorem fixedPointIdeal_fg [Algebra.FiniteType R A] [Finite G] (ρ : G →* (A ≃ₐ[R] A)) :
    (fixedPointIdeal ρ).FG := by
  classical
  have : Fintype G := Fintype.ofFinite G
  obtain ⟨S, hS⟩ := Algebra.FiniteType.out (R := R) (A := A)
  let gens : Finset A := (Finset.univ ×ˢ S).image fun p : G × A ↦ ρ p.1 p.2 - p.2
  refine ⟨gens, le_antisymm ?_ ?_⟩
  · rw [Ideal.span_le]
    intro x hx
    simp only [Finset.mem_coe, gens, Finset.mem_image, Finset.mem_product, Finset.mem_univ,
      true_and] at hx
    rcases hx with ⟨⟨g, s⟩, _, rfl⟩
    exact sub_mem_fixedPointIdeal ρ g s
  · rw [fixedPointIdeal_le_iff]
    intro g a
    have heq : (Ideal.Quotient.mkₐ R (Ideal.span (gens : Set A))).comp (ρ g : A →ₐ[R] A) =
        Ideal.Quotient.mkₐ R (Ideal.span (gens : Set A)) := by
      rw [← AlgHom.equalizer_eq_top, eq_top_iff, ← hS]
      refine AlgHom.adjoin_le_equalizer _ _ fun s hs ↦ ?_
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, Ideal.Quotient.mkₐ_eq_mk]
      rw [Ideal.Quotient.eq]
      refine Ideal.subset_span ?_
      simp only [Finset.mem_coe, gens, Finset.mem_image, Finset.mem_product, Finset.mem_univ,
        true_and]
      exact ⟨(g, s), hs, rfl⟩
    have ha := AlgHom.congr_fun heq a
    simpa only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq] using ha

/-- If `A` is finitely presented over `R` and `G` is a finite monoid acting on `A`, then the
fixed-point quotient `A ⧸ fixedPointIdeal ρ` is finitely presented over `R`. -/
theorem finitePresentation_quotient_fixedPointIdeal [Algebra.FinitePresentation R A] [Finite G]
    (ρ : G →* (A ≃ₐ[R] A)) :
    Algebra.FinitePresentation R (A ⧸ fixedPointIdeal ρ) :=
  Algebra.FinitePresentation.quotient (fixedPointIdeal_fg ρ)

end FinitePresentation

section Smoothness

variable {R : Type u} {A : Type v} {G : Type w}
variable [CommRing R] [CommRing A] [Algebra R A] [Group G]

/-- Averaging a lift `φ : A →ₐ[R] B` of a `G`-invariant point over a finite group `G` of invertible
order in `R` produces a `G`-invariant `R`-algebra homomorphism `A →ₐ[R] B` when the defects
`φ (ρ g a) - φ a` lie in a square-zero ideal `I`. -/
private noncomputable def averagedLift [Fintype G] (ρ : G →* (A ≃ₐ[R] A))
    (u : Rˣ) (hu : (u : R) = Fintype.card G)
    {B : Type x} [CommRing B] [Algebra R B] {I : Ideal B} (hI : I ^ 2 = ⊥)
    (φ : A →ₐ[R] B) (hφ : ∀ g a, φ (ρ g a) - φ a ∈ I) : A →ₐ[R] B :=
  have hmul_zero {x y : B} (hx : x ∈ I) (hy : y ∈ I) : x * y = 0 := by
    have hmem : x * y ∈ I ^ 2 := by
      rw [sq]
      exact Ideal.mul_mem_mul hx hy
    rwa [hI, Ideal.mem_bot] at hmem
  have hu_inv : (↑u⁻¹ : R) * (Fintype.card G : R) = 1 := by
    rw [← hu]
    exact u.inv_val
  let δ : G → A → B := fun g a ↦ φ (ρ g a) - φ a
  let Δ : A → B := fun a ↦ (↑u⁻¹ : R) • ∑ g : G, δ g a
  have hΔ_mem (a : A) : Δ a ∈ I := by
    dsimp only [Δ]
    rw [Algebra.smul_def]
    exact I.mul_mem_left _ (I.sum_mem fun g _ ↦ hφ g a)
  have havg_eq (a : A) : (↑u⁻¹ : R) • ∑ g : G, φ (ρ g a) = φ a + Δ a := by
    have hsum : ∑ g : G, φ (ρ g a) = (Fintype.card G : R) • φ a + ∑ g : G, δ g a := by
      calc ∑ g : G, φ (ρ g a)
          = ∑ g : G, (φ a + δ g a) := Finset.sum_congr rfl fun g _ ↦ by simp [δ]
        _ = (∑ _g : G, φ a) + ∑ g : G, δ g a := Finset.sum_add_distrib
        _ = (Fintype.card G : R) • φ a + ∑ g : G, δ g a := by
            rw [Finset.sum_const, Finset.card_univ, Nat.cast_smul_eq_nsmul]
    rw [hsum, smul_add, smul_smul, hu_inv, one_smul]
  have hδ_mul (g : G) (a b : A) : δ g (a * b) = φ a * δ g b + δ g a * φ b := by
    have h0 : δ g a * δ g b = 0 := hmul_zero (hφ g a) (hφ g b)
    have hcalc : δ g (a * b) = φ a * δ g b + δ g a * φ b + δ g a * δ g b := by
      dsimp only [δ]
      rw [map_mul, map_mul, map_mul]
      ring
    rw [hcalc, h0, add_zero]
  have hΔ_mul (a b : A) : Δ (a * b) = φ a * Δ b + Δ a * φ b := by
    dsimp only [Δ]
    calc (↑u⁻¹ : R) • ∑ g : G, δ g (a * b)
        = (↑u⁻¹ : R) • ∑ g : G, (φ a * δ g b + δ g a * φ b) := by
            congr 1
            exact Finset.sum_congr rfl fun g _ ↦ hδ_mul g a b
      _ = (↑u⁻¹ : R) • (φ a * ∑ g : G, δ g b + (∑ g : G, δ g a) * φ b) := by
            rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul]
      _ = φ a * ((↑u⁻¹ : R) • ∑ g : G, δ g b) + ((↑u⁻¹ : R) • ∑ g : G, δ g a) * φ b := by
            rw [smul_add, mul_smul_comm, smul_mul_assoc]
  { toFun := fun a ↦ (↑u⁻¹ : R) • ∑ g : G, φ (ρ g a)
    map_one' := by
      rw [havg_eq 1, map_one]
      have hΔ1 : Δ 1 = 0 := by simp [Δ, δ]
      rw [hΔ1, add_zero]
    map_mul' := fun a b ↦ by
      rw [havg_eq (a * b), havg_eq a, havg_eq b, map_mul, hΔ_mul]
      have h0 : Δ a * Δ b = 0 := hmul_zero (hΔ_mem a) (hΔ_mem b)
      calc φ a * φ b + (φ a * Δ b + Δ a * φ b)
          = (φ a + Δ a) * (φ b + Δ b) - Δ a * Δ b := by ring
        _ = (φ a + Δ a) * (φ b + Δ b) := by rw [h0, sub_zero]
    map_zero' := by simp
    map_add' := fun a b ↦ by
      simp [map_add, Finset.sum_add_distrib, smul_add]
    commutes' := fun r ↦ by
      rw [havg_eq, AlgHom.commutes]
      have hΔr : Δ (algebraMap R A r) = 0 := by simp [Δ, δ]
      rw [hΔr, add_zero] }

private theorem averagedLift_apply [Fintype G] (ρ : G →* (A ≃ₐ[R] A))
    (u : Rˣ) (hu : (u : R) = Fintype.card G)
    {B : Type x} [CommRing B] [Algebra R B] {I : Ideal B} (hI : I ^ 2 = ⊥)
    (φ : A →ₐ[R] B) (hφ : ∀ g a, φ (ρ g a) - φ a ∈ I) (a : A) :
    averagedLift ρ u hu hI φ hφ a = (↑u⁻¹ : R) • ∑ g : G, φ (ρ g a) :=
  rfl

/-- **Edixhoven's formal smoothness theorem** (Edixhoven, Prop. 3.4). Let `G` be a finite group
whose order is invertible in `R`, acting on a formally smooth `R`-algebra `A` by `R`-algebra
automorphisms. Then the fixed-point quotient `A ⧸ fixedPointIdeal ρ` is formally smooth over `R`.
-/
theorem formallySmooth_quotient_fixedPointIdeal [Algebra.FormallySmooth R A] [Finite G]
    (ρ : G →* (A ≃ₐ[R] A)) (hG : IsUnit (Nat.card G : R)) :
    Algebra.FormallySmooth R (A ⧸ fixedPointIdeal ρ) := by
  classical
  have : Fintype G := Fintype.ofFinite G
  have hcard : (hG.unit : R) = Fintype.card G := by
    rw [IsUnit.unit_spec, Nat.card_eq_fintype_card]
  refine Algebra.FormallySmooth.iff_comp_surjective.mpr fun B _ _ I hI f ↦ ?_
  let f₀ : A →ₐ[R] B ⧸ I := f.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal ρ))
  obtain ⟨φ, hφ⟩ := Algebra.FormallySmooth.comp_surjective R A I hI f₀
  have hφ_def : ∀ g a, φ (ρ g a) - φ a ∈ I := by
    intro g a
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, ← Ideal.Quotient.mkₐ_eq_mk R,
      ← AlgHom.comp_apply, ← AlgHom.comp_apply, hφ]
    have hinv : f₀ (ρ g a) = f₀ a := by
      have h := AlgHom.congr_fun (mk_fixedPointIdeal_comp ρ g) a
      simpa only [f₀, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom] using congrArg f h
    rw [hinv, sub_self]
  let ψ : A →ₐ[R] B := averagedLift ρ hG.unit hcard hI φ hφ_def
  have hψ_inv : fixedPointIdeal ρ ≤ RingHom.ker ψ := by
    rw [fixedPointIdeal_le_ker_iff]
    intro h
    ext a
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, ψ, averagedLift_apply]
    congr 1
    refine Fintype.sum_equiv (Equiv.mulRight h) _ _ fun g ↦ ?_
    simp [map_mul, AlgEquiv.mul_apply]
  refine ⟨Ideal.Quotient.liftₐ (fixedPointIdeal ρ) ψ
      fun a ha ↦ RingHom.mem_ker.mp (hψ_inv ha), Ideal.Quotient.algHom_ext R ?_⟩
  rw [AlgHom.comp_assoc, Ideal.Quotient.liftₐ_comp]
  ext a
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, ψ, averagedLift_apply]
  have hmk : ∀ g : G, Ideal.Quotient.mk I (φ (ρ g a)) = f₀ a := fun g ↦ by
    have hdiff : Ideal.Quotient.mk I (φ (ρ g a) - φ a) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (hφ_def g a)
    rw [map_sub, sub_eq_zero] at hdiff
    have hφa : Ideal.Quotient.mk I (φ a) = f₀ a := AlgHom.congr_fun hφ a
    exact hdiff.trans hφa
  rw [Algebra.smul_def, map_mul, map_sum, Finset.sum_congr rfl fun g _ ↦ hmk g,
    Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← map_natCast (algebraMap R (B ⧸ I)),
    ← Ideal.Quotient.mk_algebraMap, ← hcard, ← mul_assoc, ← map_mul, ← map_mul,
    ← Units.val_mul, inv_mul_cancel, Units.val_one, map_one, map_one, one_mul]
  rfl

/-- **Edixhoven's smoothness theorem** (Edixhoven, Prop. 3.4). Let `G` be a finite group whose
order is invertible in `R`, acting on a smooth `R`-algebra `A` by `R`-algebra automorphisms. Then
the fixed-point quotient `A ⧸ fixedPointIdeal ρ` is smooth over `R`. -/
theorem smooth_quotient_fixedPointIdeal [Algebra.Smooth R A] [Finite G]
    (ρ : G →* (A ≃ₐ[R] A)) (hG : IsUnit (Nat.card G : R)) :
    Algebra.Smooth R (A ⧸ fixedPointIdeal ρ) :=
  ⟨formallySmooth_quotient_fixedPointIdeal ρ hG, finitePresentation_quotient_fixedPointIdeal ρ⟩

end Smoothness

section Reynolds

variable {R : Type u} {A : Type v} {G : Type w}
variable [CommRing R] [CommRing A] [Algebra R A] [Group G]

private theorem reynoldsAverage_invariant [Fintype G] (ρ : G →* (A ≃ₐ[R] A))
    (hG : IsUnit (Nat.card G : R)) (a : A) (h : G) :
    ρ h ((↑hG.unit⁻¹ : R) • ∑ g : G, ρ g a) = (↑hG.unit⁻¹ : R) • ∑ g : G, ρ g a := by
  rw [map_smul, map_sum]
  congr 1
  refine Fintype.sum_equiv (Equiv.mulLeft h) _ _ fun g ↦ ?_
  simp [map_mul, AlgEquiv.mul_apply]

/-- The **Reynolds averaging retraction** `A →ₗ[R] R` of a tame action `ρ : G →* (A ≃ₐ[R] A)`
whose invariants equal the image of an injective structure map `R → A`. It sends `a` to the unique
element of `R` mapping to `|G|⁻¹ • ∑ g, ρ g a`. -/
noncomputable def reynoldsRetraction [Finite G] (ρ : G →* (A ≃ₐ[R] A))
    (hG : IsUnit (Nat.card G : R))
    (hinv : ∀ a : A, (∀ g : G, ρ g a = a) → a ∈ Set.range (algebraMap R A))
    (hinj : Function.Injective (algebraMap R A)) : A →ₗ[R] R :=
  letI : Fintype G := Fintype.ofFinite G
  let f : A → R := fun a ↦ Classical.choose (hinv _ (reynoldsAverage_invariant ρ hG a))
  have hf (a : A) : algebraMap R A (f a) = (↑hG.unit⁻¹ : R) • ∑ g : G, ρ g a :=
    Classical.choose_spec (hinv _ (reynoldsAverage_invariant ρ hG a))
  { toFun := f
    map_add' := fun a₁ a₂ ↦ hinj <| by
      rw [map_add, hf, hf, hf, ← smul_add, ← Finset.sum_add_distrib]
      congr 1
      exact Finset.sum_congr rfl fun g _ ↦ map_add (ρ g) a₁ a₂
    map_smul' := fun r a ↦ hinj <| by
      rw [RingHom.id_apply, smul_eq_mul, map_mul, hf, hf, ← Algebra.smul_def, smul_comm]
      congr 1
      rw [Finset.smul_sum]
      exact Finset.sum_congr rfl fun g _ ↦ map_smul (ρ g) r a }

/-- The image in `A` of `reynoldsRetraction` is the group average `|G|⁻¹ • ∑ g, ρ g a`. -/
theorem algebraMap_reynoldsRetraction [Fintype G] (ρ : G →* (A ≃ₐ[R] A))
    (hG : IsUnit (Nat.card G : R))
    (hinv : ∀ a : A, (∀ g : G, ρ g a = a) → a ∈ Set.range (algebraMap R A))
    (hinj : Function.Injective (algebraMap R A)) (a : A) :
    algebraMap R A (reynoldsRetraction ρ hG hinv hinj a) =
      (↑hG.unit⁻¹ : R) • ∑ g : G, ρ g a := by
  have h : algebraMap R A (reynoldsRetraction ρ hG hinv hinj a) =
      (↑hG.unit⁻¹ : R) • @Finset.sum G A _ (@Finset.univ G (Fintype.ofFinite G)) (fun g ↦ ρ g a) :=
    Classical.choose_spec
      (hinv _ (@reynoldsAverage_invariant _ _ _ _ _ _ _ (Fintype.ofFinite G) ρ hG a))
  rw [h]
  congr 1
  exact Finset.sum_congr (by ext; simp) fun _ _ ↦ rfl

/-- `reynoldsRetraction` is a left inverse to `algebraMap R A`. -/
@[simp]
theorem reynoldsRetraction_algebraMap [Finite G] (ρ : G →* (A ≃ₐ[R] A))
    (hG : IsUnit (Nat.card G : R))
    (hinv : ∀ a : A, (∀ g : G, ρ g a = a) → a ∈ Set.range (algebraMap R A))
    (hinj : Function.Injective (algebraMap R A)) (r : R) :
    reynoldsRetraction ρ hG hinv hinj (algebraMap R A r) = r := by
  have : Fintype G := Fintype.ofFinite G
  have hcard : (hG.unit : R) = Fintype.card G := by
    rw [IsUnit.unit_spec, Nat.card_eq_fintype_card]
  apply hinj
  rw [algebraMap_reynoldsRetraction]
  simp only [AlgEquiv.commutes, Finset.sum_const, Finset.card_univ, ← Nat.cast_smul_eq_nsmul R,
    smul_smul]
  rw [← hcard, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_smul]

/-- `reynoldsRetraction` maps `1` to `1`. -/
@[simp]
theorem reynoldsRetraction_one [Finite G] (ρ : G →* (A ≃ₐ[R] A))
    (hG : IsUnit (Nat.card G : R))
    (hinv : ∀ a : A, (∀ g : G, ρ g a = a) → a ∈ Set.range (algebraMap R A))
    (hinj : Function.Injective (algebraMap R A)) :
    reynoldsRetraction ρ hG hinv hinj 1 = 1 := by
  simpa only [map_one] using reynoldsRetraction_algebraMap ρ hG hinv hinj 1

/-- The `R`-linear retraction `A ⊗[R] M →ₗ[R] M` obtained by tensoring `reynoldsRetraction` with
an `R`-module `M`. -/
noncomputable def reynoldsRetractionTensor [Finite G] (ρ : G →* (A ≃ₐ[R] A))
    (hG : IsUnit (Nat.card G : R))
    (hinv : ∀ a : A, (∀ g : G, ρ g a = a) → a ∈ Set.range (algebraMap R A))
    (hinj : Function.Injective (algebraMap R A))
    (M : Type x) [AddCommGroup M] [Module R M] : A ⊗[R] M →ₗ[R] M :=
  (TensorProduct.lid R M).toLinearMap ∘ₗ
    LinearMap.rTensor M (reynoldsRetraction ρ hG hinv hinj)

/-- `reynoldsRetractionTensor` evaluates on pure tensors `a ⊗ₜ m` as `reynoldsRetraction a • m`. -/
@[simp]
theorem reynoldsRetractionTensor_tmul [Finite G] (ρ : G →* (A ≃ₐ[R] A))
    (hG : IsUnit (Nat.card G : R))
    (hinv : ∀ a : A, (∀ g : G, ρ g a = a) → a ∈ Set.range (algebraMap R A))
    (hinj : Function.Injective (algebraMap R A))
    (M : Type x) [AddCommGroup M] [Module R M] (a : A) (m : M) :
    reynoldsRetractionTensor ρ hG hinv hinj M (a ⊗ₜ[R] m) =
      reynoldsRetraction ρ hG hinv hinj a • m := by
  simp [reynoldsRetractionTensor]

/-- `reynoldsRetractionTensor` retracts `1 ⊗ₜ m` back to `m`. -/
theorem reynoldsRetractionTensor_one_tmul [Finite G] (ρ : G →* (A ≃ₐ[R] A))
    (hG : IsUnit (Nat.card G : R))
    (hinv : ∀ a : A, (∀ g : G, ρ g a = a) → a ∈ Set.range (algebraMap R A))
    (hinj : Function.Injective (algebraMap R A))
    (M : Type x) [AddCommGroup M] [Module R M] (m : M) :
    reynoldsRetractionTensor ρ hG hinv hinj M ((1 : A) ⊗ₜ[R] m) = m := by
  simp

/-- **Base-change invariance under a tame group action**: if an element `t ∈ A ⊗[R] M` is fixed
by every `ρ g ⊗ id_M`, then `t = 1 ⊗ₜ reynoldsRetractionTensor ... M t`. -/
theorem one_tmul_reynoldsRetractionTensor_of_fixed [Finite G] (ρ : G →* (A ≃ₐ[R] A))
    (hG : IsUnit (Nat.card G : R))
    (hinv : ∀ a : A, (∀ g : G, ρ g a = a) → a ∈ Set.range (algebraMap R A))
    (hinj : Function.Injective (algebraMap R A))
    {M : Type x} [AddCommGroup M] [Module R M] {t : A ⊗[R] M}
    (ht : ∀ g : G, LinearMap.rTensor M (ρ g).toLinearMap t = t) :
    (1 : A) ⊗ₜ[R] (reynoldsRetractionTensor ρ hG hinv hinj M t) = t := by
  have : Fintype G := Fintype.ofFinite G
  have hcard : (hG.unit : R) = Fintype.card G := by
    rw [IsUnit.unit_spec, Nat.card_eq_fintype_card]
  have hone (s : A ⊗[R] M) :
      (1 : A) ⊗ₜ[R] (reynoldsRetractionTensor ρ hG hinv hinj M s) =
        (↑hG.unit⁻¹ : R) • ∑ g : G, LinearMap.rTensor M (ρ g).toLinearMap s := by
    induction s with
    | tmul a m =>
      have hra := algebraMap_reynoldsRetraction ρ hG hinv hinj a
      calc (1 : A) ⊗ₜ[R] (reynoldsRetractionTensor ρ hG hinv hinj M (a ⊗ₜ[R] m))
          = (1 : A) ⊗ₜ[R] (reynoldsRetraction ρ hG hinv hinj a • m) := by simp
        _ = (reynoldsRetraction ρ hG hinv hinj a • (1 : A)) ⊗ₜ[R] m := by
            rw [TensorProduct.smul_tmul]
        _ = algebraMap R A (reynoldsRetraction ρ hG hinv hinj a) ⊗ₜ[R] m := by
            rw [Algebra.smul_def, mul_one]
        _ = ((↑hG.unit⁻¹ : R) • ∑ g : G, ρ g a) ⊗ₜ[R] m := by rw [hra]
        _ = (↑hG.unit⁻¹ : R) • ∑ g : G, (ρ g a) ⊗ₜ[R] m := by
            rw [← TensorProduct.smul_tmul', TensorProduct.sum_tmul]
        _ = (↑hG.unit⁻¹ : R) • ∑ g : G, LinearMap.rTensor M (ρ g).toLinearMap (a ⊗ₜ[R] m) := by
            simp
    | add s₁ s₂ hs₁ hs₂ =>
      simp only [map_add, TensorProduct.tmul_add, hs₁, hs₂, Finset.sum_add_distrib, smul_add]
  rw [hone t, Finset.sum_congr rfl fun g _ ↦ ht g, Finset.sum_const, Finset.card_univ,
    ← Nat.cast_smul_eq_nsmul R, smul_smul, ← hcard, ← Units.val_mul, inv_mul_cancel,
    Units.val_one, one_smul]

end Reynolds

end TauCeti
