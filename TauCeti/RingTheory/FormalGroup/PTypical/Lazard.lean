public import TauCeti.RingTheory.FormalGroup.PTypical.Basic

/-!
# Quillen's `p`-typicalization idempotent on the localized Lazard ring

Let `L` (`TauCeti.LazardRing`) be the Lazard ring classifying one-dimensional commutative formal
group laws, and let `S` be any localization of `L` at `TauCeti.LazardRing.coprimeSubmonoid p`, the
multiplicative submonoid generated by all primes `q ≠ p` (so `S ≅ L ⊗ ℤ_(p)`).

Every prime `q ≠ p` is a unit in `S`, so the base-changed universal formal group law `F_S` over `S`
admits Quillen's canonical strict `p`-typical coordinate change
`F_S.pTypicalCoord p _ • F_S`. By the universal property of the localized Lazard ring
(`TauCeti.LazardRing.liftLocalization`), this `p`-typical formal group law is classified by a
canonical ring endomorphism

  `quillenIdempotent p S : S →+* S`.

For a prime `p`, `quillenIdempotent p S` is a ring-homomorphism idempotent (`e ∘ e = e`), a ring
homomorphism `f : S →+* R` (into any ring `R` inverting primes `q ≠ p`) satisfies `f ∘ e = f` if
and only if `F_S.map f` is `p`-typical, and the subring image `(quillenIdempotent p S).range`
carries the universal `p`-typical formal group law classifying `p`-typical commutative formal group
laws over rings in which every prime `q ≠ p` is invertible (`TauCeti.LazardRing.liftPTypical`).

## Main definitions

* `TauCeti.LazardRing.coprimeSubmonoid`: the submonoid of `LazardRing` generated by
  `(q : LazardRing)` for primes `q ≠ p`.
* `TauCeti.LazardRing.liftLocalization`: universal property `S →+* R` of the `p`-localized Lazard
  ring for commutative formal group laws over rings inverting primes `q ≠ p`.
* `TauCeti.LazardRing.quillenIdempotent`: Quillen's multiplicative `p`-typicalization idempotent
  `S →+* S`.
* `TauCeti.LazardRing.universalPTypicalFormalGroup`: the universal `p`-typical formal group law
  over `(quillenIdempotent p S).range`.
* `TauCeti.LazardRing.liftPTypical`: universal property classifying `p`-typical formal group laws
  `{ F : FormalGroup R // ∃ (_ : F.IsComm), F.IsPTypical p } ≃
    ((quillenIdempotent p S).range →+* R)`.

## Main results

* `TauCeti.LazardRing.comp_quillenIdempotent_eq_self_iff`: `f.comp (quillenIdempotent p S) = f` if
  and only if `(F_S.map f).IsPTypical p`.
* `TauCeti.LazardRing.quillenIdempotent_comp_self`:
  `(quillenIdempotent p S).comp (quillenIdempotent p S) = quillenIdempotent p S`.
* `TauCeti.LazardRing.isPTypical_universalPTypicalFormalGroup` and
  `TauCeti.LazardRing.map_liftPTypical`: `universalPTypicalFormalGroup` is `p`-typical and
  classifies all `p`-typical commutative formal group laws over rings inverting primes `q ≠ p`.

## References

* D. Quillen, *On the formal group laws of unoriented and complex cobordism theory*, Bull. Amer.
  Math. Soc. 75 (1969), 1293–1298.
* [M. Hazewinkel, *Formal Groups and Applications*][hazewinkel1978], Chapter I §4.
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres*, Academic Press (1986),
  Appendix A2.1.25.
-/

public section

namespace TauCeti.LazardRing

/-- The multiplicative submonoid of `LazardRing` generated by all prime numbers `q ≠ p`, so that a
localization at `coprimeSubmonoid p` is `LazardRing` localized at `(p)`. -/
def coprimeSubmonoid (p : ℕ) : Submonoid LazardRing :=
  Submonoid.closure { x : LazardRing | ∃ q : ℕ, q.Prime ∧ q ≠ p ∧ (q : LazardRing) = x }

private theorem isPTypical_congr {R : Type*} [CommRing R] {F G : FormalGroup R}
    [F.IsComm] [G.IsComm] {p : ℕ} (h : F = G) :
    F.IsPTypical p ↔ G.IsPTypical p := by
  subst h
  rfl

/-- Every prime `q ≠ p` becomes a unit in a localization `S` of `LazardRing` at
`coprimeSubmonoid p`. -/
theorem isUnit_natCast_of_prime_ne (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] :
    ∀ q : ℕ, q.Prime → q ≠ p → IsUnit (q : S) :=
  fun q hq hne ↦ by
    have hm : (q : LazardRing) ∈ coprimeSubmonoid p := Submonoid.subset_closure ⟨q, hq, hne, rfl⟩
    simpa only [map_natCast] using IsLocalization.map_units S ⟨(q : LazardRing), hm⟩

/-- A ring homomorphism out of the `p`-localized Lazard ring `S` is determined by the base change of
the universal formal group law along it. -/
theorem hom_ext_localization (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] {R : Type*} [CommRing R] {f g : S →+* R}
    (h : (formalGroup.map (algebraMap LazardRing S)).map f =
      (formalGroup.map (algebraMap LazardRing S)).map g) :
    f = g := by
  apply IsLocalization.ringHom_ext (coprimeSubmonoid p)
  apply hom_ext
  simpa only [FormalGroup.map_comp] using h

private theorem isUnit_lift_coprimeSubmonoid (p : ℕ) {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → q ≠ p → IsUnit (q : R))
    (F : { F : FormalGroup R // F.IsComm }) (m : coprimeSubmonoid p) :
    IsUnit (lift F m) := by
  rcases m with ⟨m, hm⟩
  refine Submonoid.closure_induction (fun x hx ↦ ?_) (by simp)
    (fun x y _ _ hx hy ↦ by rw [map_mul]; exact hx.mul hy) hm
  rcases hx with ⟨q, hq, hne, rfl⟩
  simpa only [map_natCast] using hunit q hq hne

/-- **Universal property of the `p`-localized Lazard ring**: over a commutative ring `R` in which
every prime `q ≠ p` is invertible, commutative formal group laws over `R` correspond bijectively to
ring homomorphisms `S →+* R`. -/
noncomputable def liftLocalization (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → q ≠ p → IsUnit (q : R)) :
    { F : FormalGroup R // F.IsComm } ≃ (S →+* R) where
  toFun F :=
    IsLocalization.lift (M := coprimeSubmonoid p) (S := S)
      (isUnit_lift_coprimeSubmonoid p hunit F)
  invFun φ := ⟨(formalGroup.map (algebraMap LazardRing S)).map φ, inferInstance⟩
  left_inv F := Subtype.ext <| by
    rw [FormalGroup.map_comp, IsLocalization.lift_comp, map_lift]
  right_inv φ := hom_ext_localization p S <| by
    rw [FormalGroup.map_comp, IsLocalization.lift_comp, ← FormalGroup.map_comp]

@[simp]
theorem coe_liftLocalization_symm (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → q ≠ p → IsUnit (q : R)) (φ : S →+* R) :
    ((liftLocalization p S hunit).symm φ).1 =
      (formalGroup.map (algebraMap LazardRing S)).map φ :=
  (rfl)

@[simp]
theorem map_liftLocalization (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → q ≠ p → IsUnit (q : R)) (F : FormalGroup R) [F.IsComm] :
    (formalGroup.map (algebraMap LazardRing S)).map
        (liftLocalization p S hunit ⟨F, inferInstance⟩) = F :=
  congrArg Subtype.val ((liftLocalization p S hunit).left_inv ⟨F, inferInstance⟩)

/-- **Quillen's `p`-typicalization idempotent** on the `p`-localized Lazard ring `S`: the ring
endomorphism `S →+* S` classifying the canonical `p`-typical coordinate change
`F_S.pTypicalCoord p _ • F_S` of the localized universal formal group law `F_S`. -/
noncomputable def quillenIdempotent (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] : S →+* S :=
  let F_S : FormalGroup S := formalGroup.map (algebraMap LazardRing S)
  liftLocalization p S (isUnit_natCast_of_prime_ne p S)
    ⟨F_S.pTypicalCoord p (isUnit_natCast_of_prime_ne p S) • F_S, inferInstance⟩

/-- Base-changing the localized universal formal group law along `quillenIdempotent p S` produces
its canonical `p`-typical coordinate change. -/
theorem map_quillenIdempotent (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] :
    (formalGroup.map (algebraMap LazardRing S)).map (quillenIdempotent p S) =
      (formalGroup.map (algebraMap LazardRing S)).pTypicalCoord p
          (isUnit_natCast_of_prime_ne p S) •
        formalGroup.map (algebraMap LazardRing S) :=
  map_liftLocalization p S (isUnit_natCast_of_prime_ne p S) _

/-- For a prime `p`, base-changing the localized universal formal group law along
`quillenIdempotent p S` produces a `p`-typical formal group law. -/
theorem isPTypical_map_quillenIdempotent {p : ℕ} (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] (hp : p.Prime) :
    ((formalGroup.map (algebraMap LazardRing S)).map (quillenIdempotent p S)).IsPTypical p :=
  (isPTypical_congr (map_quillenIdempotent p S)).mpr <|
    FormalGroup.isPTypical_pTypicalCoord_smul _ hp (isUnit_natCast_of_prime_ne p S)

/-- **Characterization of homomorphisms factoring through Quillen's idempotent**: for a prime `p`
and a commutative ring `R` inverting primes `q ≠ p`, a ring homomorphism `f : S →+* R` satisfies
`f.comp (quillenIdempotent p S) = f` if and only if the classified formal group law
`(F_S).map f` is `p`-typical. -/
theorem comp_quillenIdempotent_eq_self_iff {p : ℕ} (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] {R : Type*} [CommRing R] (hp : p.Prime)
    (hunit : ∀ q : ℕ, q.Prime → q ≠ p → IsUnit (q : R)) (f : S →+* R) :
    f.comp (quillenIdempotent p S) = f ↔
      ((formalGroup.map (algebraMap LazardRing S)).map f).IsPTypical p := by
  refine ⟨fun hf ↦ ?_, fun hF ↦ ?_⟩
  · have heq :
        (formalGroup.map (algebraMap LazardRing S)).map f =
          ((formalGroup.map (algebraMap LazardRing S)).map (quillenIdempotent p S)).map f := by
      rw [← FormalGroup.map_comp, hf]
    exact (isPTypical_congr heq).mpr ((isPTypical_map_quillenIdempotent S hp).map f)
  · refine hom_ext_localization p S ?_
    rw [← FormalGroup.map_comp, map_quillenIdempotent, FormalGroup.map_smul,
      FormalGroup.map_pTypicalCoord _ f p (isUnit_natCast_of_prime_ne p S) hunit,
      (((formalGroup.map (algebraMap LazardRing S)).map f).pTypicalCoord_eq_one_iff hp hunit).mpr
        hF,
      one_smul]

/-- **Idempotence of Quillen's endomorphism**: for a prime `p`,
`(quillenIdempotent p S).comp (quillenIdempotent p S) = quillenIdempotent p S`. -/
@[simp]
theorem quillenIdempotent_comp_self {p : ℕ} (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] (hp : p.Prime) :
    (quillenIdempotent p S).comp (quillenIdempotent p S) = quillenIdempotent p S :=
  (comp_quillenIdempotent_eq_self_iff S hp (isUnit_natCast_of_prime_ne p S)
    (quillenIdempotent p S)).mpr (isPTypical_map_quillenIdempotent S hp)

private theorem rangeRestrict_comp_subtype_quillenIdempotent {p : ℕ} (S : Type*) [CommRing S]
    [Algebra LazardRing S] [IsLocalization (coprimeSubmonoid p) S] (hp : p.Prime) :
    (quillenIdempotent p S).rangeRestrict.comp (quillenIdempotent p S).range.subtype =
      RingHom.id (quillenIdempotent p S).range := by
  ext ⟨x, y, rfl⟩
  exact congrArg (fun f : S →+* S ↦ f y) (quillenIdempotent_comp_self S hp)

/-- The **universal `p`-typical formal group law** over the retract
`(quillenIdempotent p S).range` of the `p`-localized Lazard ring `S`. -/
noncomputable def universalPTypicalFormalGroup (p : ℕ) (S : Type*) [CommRing S]
    [Algebra LazardRing S] [IsLocalization (coprimeSubmonoid p) S] :
    FormalGroup (quillenIdempotent p S).range :=
  (formalGroup.map (algebraMap LazardRing S)).map (quillenIdempotent p S).rangeRestrict

instance (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] :
    (universalPTypicalFormalGroup p S).IsComm :=
  inferInstanceAs
    ((formalGroup.map (algebraMap LazardRing S)).map (quillenIdempotent p S).rangeRestrict).IsComm

theorem isPTypical_universalPTypicalFormalGroup {p : ℕ} (S : Type*) [CommRing S]
    [Algebra LazardRing S] [IsLocalization (coprimeSubmonoid p) S] (hp : p.Prime) :
    (universalPTypicalFormalGroup p S).IsPTypical p := by
  rw [← FormalGroup.isPTypical_map_iff (quillenIdempotent p S).range.subtype_injective]
  have heq :
      (universalPTypicalFormalGroup p S).map (quillenIdempotent p S).range.subtype =
        (formalGroup.map (algebraMap LazardRing S)).map (quillenIdempotent p S) := by
    rw [universalPTypicalFormalGroup, FormalGroup.map_comp]
    congr 1
  exact (isPTypical_congr heq).mpr (isPTypical_map_quillenIdempotent S hp)

/-- **Quillen's universal property for `p`-typical formal group laws**: for a prime `p` and any
commutative ring `R` in which every prime `q ≠ p` is invertible, `p`-typical commutative formal
group laws over `R` correspond bijectively to ring homomorphisms
`(quillenIdempotent p S).range →+* R`. -/
noncomputable def liftPTypical {p : ℕ} (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] {R : Type*} [CommRing R] (hp : p.Prime)
    (hunit : ∀ q : ℕ, q.Prime → q ≠ p → IsUnit (q : R)) :
    { F : FormalGroup R // ∃ (_ : F.IsComm), F.IsPTypical p } ≃
      ((quillenIdempotent p S).range →+* R) where
  toFun F :=
    (liftLocalization p S hunit ⟨F.1, F.2.1⟩).comp (quillenIdempotent p S).range.subtype
  invFun φ :=
    ⟨(universalPTypicalFormalGroup p S).map φ, inferInstance,
      (isPTypical_universalPTypicalFormalGroup S hp).map φ⟩
  left_inv F := by
    rcases F with ⟨F, hcomm, htyp⟩
    apply Subtype.ext
    let f : S →+* R := liftLocalization p S hunit ⟨F, hcomm⟩
    have hf : (formalGroup.map (algebraMap LazardRing S)).map f = F :=
      map_liftLocalization p S hunit F
    have hfe : f.comp (quillenIdempotent p S) = f :=
      (comp_quillenIdempotent_eq_self_iff S hp hunit f).mpr ((isPTypical_congr hf).mpr htyp)
    have hcomp :
        (f.comp (quillenIdempotent p S).range.subtype).comp
            (quillenIdempotent p S).rangeRestrict = f := by
      rw [RingHom.comp_assoc]
      exact hfe
    rw [universalPTypicalFormalGroup, FormalGroup.map_comp, hcomp, hf]
  right_inv φ := by
    have hlift :
        liftLocalization p S hunit
            ⟨(universalPTypicalFormalGroup p S).map φ, inferInstance⟩ =
          φ.comp (quillenIdempotent p S).rangeRestrict := by
      apply (liftLocalization p S hunit).symm.injective
      rw [Equiv.symm_apply_apply]
      apply Subtype.ext
      rw [coe_liftLocalization_symm, universalPTypicalFormalGroup, FormalGroup.map_comp]
    rw [hlift, RingHom.comp_assoc, rangeRestrict_comp_subtype_quillenIdempotent S hp,
      RingHom.comp_id]

@[simp]
theorem map_liftPTypical {p : ℕ} (S : Type*) [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] {R : Type*} [CommRing R] (hp : p.Prime)
    (hunit : ∀ q : ℕ, q.Prime → q ≠ p → IsUnit (q : R)) (F : FormalGroup R) [F.IsComm]
    (hF : F.IsPTypical p) :
    (universalPTypicalFormalGroup p S).map (liftPTypical S hp hunit ⟨F, inferInstance, hF⟩) = F :=
  congrArg Subtype.val ((liftPTypical S hp hunit).left_inv ⟨F, inferInstance, hF⟩)

end TauCeti.LazardRing
