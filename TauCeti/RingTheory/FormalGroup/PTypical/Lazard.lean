/-!
# Quillen's `p`-typicalization idempotent on localizations of the Lazard ring

Over the Lazard ring `L = TauCeti.LazardRing`, a ring homomorphism `f : L →+* R` classifies a
`p`-typical commutative formal group law if and only if `f` vanishes on
`LazardRing.pTypicalIdeal p`, the ideal generated by the coefficients of the Frobenius curves
`f_q T` (`q ≠ p` prime) of the universal formal group law `LazardRing.formalGroup`.

Now let `M : Submonoid ℤ` be any multiplicative submonoid of `ℤ`, and let `S` be any localization
of `LazardRing` at `Algebra.algebraMapSubmonoid LazardRing M` in which every prime `q ≠ p` is a
unit — for example, the localization `L_(p)` of `LazardRing` at the prime ideal `(p)` of `ℤ`
(`M = (Ideal.span {(p : ℤ)}).primeCompl`), or `L ⊗[ℤ] ℤ_(p)`, or `L ⊗[ℤ] ℚ`. Base-changing the
universal formal group law to `S` and applying Cartier–Quillen `p`-typicalization yields a
commutative `p`-typical formal group law over `S`, classified by a ring homomorphism `L →+* S`.
Because every ring homomorphism agrees with `algebraMap` on `ℤ`, this homomorphism sends `M` to
units in `S` and hence extends uniquely to **Quillen's `p`-typicalization ring endomorphism**

  `LazardRing.pTypicalEnd M p hunit : S →+* S`.

This endomorphism is idempotent (`e ∘ e = e`), fixes a ring homomorphism `φ : S →+* R` on the
right (`φ ∘ e = φ`) if and only if `φ` classifies a `p`-typical formal group law, satisfies
`e x - x ∈ (pTypicalIdeal p).map (algebraMap LazardRing S)` for all `x : S`, and has kernel equal
to `(pTypicalIdeal p).map (algebraMap LazardRing S)`. In particular, `e` exhibits the universal
`p`-typical quotient `S ⧸ (pTypicalIdeal p).map (algebraMap LazardRing S)` as a canonical ring
retract of `S`.

## Main definitions

* `TauCeti.LazardRing.pTypicalIdeal`: the ideal of `LazardRing` generated by the coefficients of
  `f_q T` for primes `q ≠ p`.
* `TauCeti.LazardRing.pTypicalEnd`: Quillen's idempotent `p`-typicalization ring endomorphism
  `S →+* S` on any localization `S` of `LazardRing` at `M : Submonoid ℤ` in which primes `q ≠ p`
  are units.
* `TauCeti.LazardRing.pTypicalEndAtPrime`: specialization of `pTypicalEnd` to localizations of
  `LazardRing` at `(Ideal.span {(p : ℤ)}).primeCompl` for a prime `p`.

## Main results

* `TauCeti.LazardRing.pTypicalIdeal_le_ker_iff`: `pTypicalIdeal p ≤ RingHom.ker f` if and only if
  `(formalGroup.map f).IsPTypical p`.
* `TauCeti.LazardRing.map_pTypicalEnd`: base-changing the universal formal group law over `S` along
  `pTypicalEnd` yields its `p`-typicalization.
* `TauCeti.LazardRing.comp_pTypicalEnd_eq_self_iff`: `φ.comp (pTypicalEnd M p hunit) = φ` if and
  only if `φ` classifies a `p`-typical formal group law.
* `TauCeti.LazardRing.pTypicalEnd_comp_pTypicalEnd` and
  `TauCeti.LazardRing.isIdempotentElem_pTypicalEnd`: Quillen's endomorphism is idempotent.
* `TauCeti.LazardRing.ker_pTypicalEnd` and `TauCeti.LazardRing.sub_mem_map_pTypicalIdeal`: the
  kernel of `pTypicalEnd` is `(pTypicalIdeal p).map (algebraMap LazardRing S)`, and `e x - x` lies
  in this ideal for every `x : S`.

## References

* D. Quillen, *On the formal group laws of unoriented and complex cobordism theory*, Bull. Amer.
  Math. Soc. 75 (1969), 1293–1298.
* [M. Hazewinkel, *Formal Groups and Applications*][hazewinkel1978], Chapter III, §16.4.
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres*, Academic Press (1986),
  Theorem 4.1.12 and Appendix A2.1.23.
-/

public section

noncomputable section

namespace TauCeti.LazardRing

open FormalGroup

variable {R S : Type*} [CommRing R] [CommRing S]

/-! ### The universal `p`-typical ideal in `LazardRing` -/

/-- The ideal of `LazardRing` generated by all coefficients of the Frobenius curves `f_q T` (for
primes `q ≠ p`) of the universal formal group law `LazardRing.formalGroup`. -/
def pTypicalIdeal (p : ℕ) : Ideal LazardRing :=
  Ideal.span
    {x : LazardRing | ∃ (q : ℕ) (hq : q.Prime) (_ : q ≠ p) (n : ℕ),
      PowerSeries.coeff n
        (formalGroup.frobeniusCurve q hq.ne_zero formalGroup.tautologicalCurve).toPowerSeries = x}

/-- A ring homomorphism `f : LazardRing →+* R` kills `pTypicalIdeal p` if and only if the formal
group law `formalGroup.map f` over `R` is `p`-typical. -/
theorem pTypicalIdeal_le_ker_iff (p : ℕ) (f : LazardRing →+* R) :
    pTypicalIdeal p ≤ RingHom.ker f ↔ (formalGroup.map f).IsPTypical p := by
  rw [pTypicalIdeal, Ideal.span_le, isPTypical_iff_tautologicalCurve, Curve.isPTypical_def]
  constructor
  · intro hf q hq hqp
    ext n
    rw [← map_tautologicalCurve, ← formalGroup.map_frobeniusCurve f q hq.ne_zero,
      Curve.toPowerSeries_map, PowerSeries.coeff_map, Curve.toPowerSeries_zero, map_zero,
      ← RingHom.mem_ker]
    exact hf ⟨q, hq, hqp, n, rfl⟩
  · rintro hF _ ⟨q, hq, hqp, n, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, ← PowerSeries.coeff_map, ← Curve.toPowerSeries_map,
      formalGroup.map_frobeniusCurve f q hq.ne_zero, map_tautologicalCurve, hF hq hqp,
      Curve.toPowerSeries_zero, map_zero]

/-- On the quotient `LazardRing ⧸ pTypicalIdeal p`, the universal formal group law becomes
`p`-typical. -/
@[simp]
theorem isPTypical_map_quotientMk_pTypicalIdeal (p : ℕ) :
    (formalGroup.map (Ideal.Quotient.mk (pTypicalIdeal p))).IsPTypical p :=
  (pTypicalIdeal_le_ker_iff p _).mp Ideal.mk_ker.symm.le

/-! ### Quillen's `p`-typicalization ring endomorphism -/

section Localization

variable [Algebra LazardRing S]

/-- **Quillen's `p`-typicalization ring endomorphism** on a localization `S` of `LazardRing` at a
submonoid `M : Submonoid ℤ` in which all primes `q ≠ p` are units: the unique ring endomorphism of
`S` extending the homomorphism `LazardRing →+* S` that classifies the `p`-typicalization of
`formalGroup.map (algebraMap LazardRing S)`. -/
def pTypicalEnd (M : Submonoid ℤ)
    [IsLocalization (Algebra.algebraMapSubmonoid LazardRing M) S] (p : ℕ)
    (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) : S →+* S :=
  IsLocalization.lift (M := Algebra.algebraMapSubmonoid LazardRing M)
    (g := lift ⟨(formalGroup.map (algebraMap LazardRing S)).pTypicalize p hunit, inferInstance⟩)
    fun y ↦ by
      obtain ⟨m, -, hm⟩ := y.2
      have hy : (y : LazardRing) = (m : LazardRing) := by simpa only [eq_intCast] using hm.symm
      simpa only [hy, map_intCast] using IsLocalization.map_units S y

variable (M : Submonoid ℤ) [IsLocalization (Algebra.algebraMapSubmonoid LazardRing M) S]

/-- On the image of `LazardRing` in `S`, `pTypicalEnd` agrees with the homomorphism classifying the
`p`-typicalization of `formalGroup.map (algebraMap LazardRing S)`. -/
@[simp]
theorem pTypicalEnd_algebraMap (p : ℕ) (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S))
    (x : LazardRing) :
    pTypicalEnd M p hunit (algebraMap LazardRing S x) =
      lift ⟨(formalGroup.map (algebraMap LazardRing S)).pTypicalize p hunit, inferInstance⟩ x :=
  IsLocalization.lift_eq _ x

/-- Composing `pTypicalEnd` with `algebraMap LazardRing S` yields the homomorphism classifying the
`p`-typicalization of `formalGroup.map (algebraMap LazardRing S)`. -/
@[simp]
theorem pTypicalEnd_comp_algebraMap (p : ℕ)
    (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) :
    (pTypicalEnd M p hunit).comp (algebraMap LazardRing S) =
      lift ⟨(formalGroup.map (algebraMap LazardRing S)).pTypicalize p hunit, inferInstance⟩ :=
  RingHom.ext (pTypicalEnd_algebraMap M p hunit)

/-- Base-changing the universal formal group law over `S` along `pTypicalEnd` produces its
`p`-typicalization. -/
theorem map_pTypicalEnd (p : ℕ) (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) :
    (formalGroup.map (algebraMap LazardRing S)).map (pTypicalEnd M p hunit) =
      (formalGroup.map (algebraMap LazardRing S)).pTypicalize p hunit := by
  rw [FormalGroup.map_comp, pTypicalEnd_comp_algebraMap, map_lift]

/-- A ring homomorphism `φ : S →+* R` satisfies `φ ∘ pTypicalEnd = φ` if and only if the formal
group law `(formalGroup.map (algebraMap LazardRing S)).map φ` over `R` is `p`-typical. -/
theorem comp_pTypicalEnd_eq_self_iff (p : ℕ)
    (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) (φ : S →+* R) :
    φ.comp (pTypicalEnd M p hunit) = φ ↔
      ((formalGroup.map (algebraMap LazardRing S)).map φ).IsPTypical p := by
  let FS : FormalGroup S := formalGroup.map (algebraMap LazardRing S)
  refine ⟨fun h ↦ ?_, fun hF ↦ ?_⟩
  · have hmap : ((FS.pTypicalize p hunit).map φ) = FS.map φ := by
      rw [← map_pTypicalEnd M p hunit, FormalGroup.map_comp, h]
    exact (isPTypical_congr hmap p).mp ((FS.isPTypical_pTypicalize p hunit).map φ)
  · refine IsLocalization.ringHom_ext (Algebra.algebraMapSubmonoid LazardRing M) <|
      hom_ext ?_
    rw [← FormalGroup.map_comp, ← FormalGroup.map_comp, ← FormalGroup.map_comp,
      map_pTypicalEnd, FS.map_pTypicalize φ p hunit, (FS.map φ).pTypicalize_eq_self _ hF]

/-- Quillen's `p`-typicalization ring endomorphism is idempotent (`e ∘ e = e`). -/
@[simp]
theorem pTypicalEnd_comp_pTypicalEnd (p : ℕ)
    (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) :
    (pTypicalEnd M p hunit).comp (pTypicalEnd M p hunit) = pTypicalEnd M p hunit := by
  rw [comp_pTypicalEnd_eq_self_iff, isPTypical_congr (map_pTypicalEnd M p hunit) p]
  exact (formalGroup.map (algebraMap LazardRing S)).isPTypical_pTypicalize p hunit

/-- Pointwise idempotence of `TauCeti.LazardRing.pTypicalEnd`. -/
@[simp]
theorem pTypicalEnd_pTypicalEnd (p : ℕ)
    (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) (x : S) :
    pTypicalEnd M p hunit (pTypicalEnd M p hunit x) = pTypicalEnd M p hunit x :=
  RingHom.congr_fun (pTypicalEnd_comp_pTypicalEnd M p hunit) x

/-- Quillen's `p`-typicalization ring endomorphism is an idempotent element in `S →+* S`. -/
theorem isIdempotentElem_pTypicalEnd (p : ℕ)
    (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) :
    IsIdempotentElem (pTypicalEnd M p hunit) :=
  pTypicalEnd_comp_pTypicalEnd M p hunit

/-- A ring homomorphism `φ : S →+* R` vanishes on `(pTypicalIdeal p).map (algebraMap LazardRing S)`
if and only if `φ ∘ pTypicalEnd = φ`. -/
theorem map_pTypicalIdeal_le_ker_iff (p : ℕ)
    (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) (φ : S →+* R) :
    (pTypicalIdeal p).map (algebraMap LazardRing S) ≤ RingHom.ker φ ↔
      φ.comp (pTypicalEnd M p hunit) = φ := by
  rw [Ideal.map_le_iff_le_comap, RingHom.comap_ker, pTypicalIdeal_le_ker_iff,
    isPTypical_congr (FormalGroup.map_comp formalGroup (algebraMap LazardRing S) φ).symm p,
    comp_pTypicalEnd_eq_self_iff]

/-- For every `x : S`, `pTypicalEnd x - x` lies in the extension of `pTypicalIdeal p` to `S`. -/
theorem sub_mem_map_pTypicalIdeal (p : ℕ)
    (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) (x : S) :
    pTypicalEnd M p hunit x - x ∈ (pTypicalIdeal p).map (algebraMap LazardRing S) := by
  let I : Ideal S := (pTypicalIdeal p).map (algebraMap LazardRing S)
  have hπ : (Ideal.Quotient.mk I).comp (pTypicalEnd M p hunit) = Ideal.Quotient.mk I :=
    (map_pTypicalIdeal_le_ker_iff M p hunit (Ideal.Quotient.mk I)).mp Ideal.mk_ker.symm.le
  rw [← Ideal.Quotient.eq, ← RingHom.comp_apply, hπ]

/-- The kernel of Quillen's `p`-typicalization endomorphism `pTypicalEnd` is the extension of
`pTypicalIdeal p` to `S`. -/
theorem ker_pTypicalEnd (p : ℕ) (hunit : ∀ ⦃q : ℕ⦄, q.Prime → q ≠ p → IsUnit (q : S)) :
    RingHom.ker (pTypicalEnd M p hunit) = (pTypicalIdeal p).map (algebraMap LazardRing S) := by
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · have hsub := sub_mem_map_pTypicalIdeal M p hunit x
    rw [RingHom.mem_ker.mp hx, zero_sub, neg_mem_iff] at hsub
    exact hsub
  · exact (map_pTypicalIdeal_le_ker_iff M p hunit _).mpr (pTypicalEnd_comp_pTypicalEnd M p hunit)

end Localization

/-! ### Specialization to localizations at `(p)` -/

section AtPrime

/-- In any localization `S` of `LazardRing` at the prime ideal `(p)` of `ℤ`, every prime `q ≠ p` is
invertible. -/
theorem isUnit_natCast_of_isLocalization_primeCompl (p : ℕ) [hp : Fact p.Prime]
    [Algebra LazardRing S]
    [IsLocalization (Algebra.algebraMapSubmonoid LazardRing (Ideal.span {(p : ℤ)}).primeCompl) S]
    ⦃q : ℕ⦄ (hq : q.Prime) (hqp : q ≠ p) : IsUnit (q : S) := by
  have hmem : (q : LazardRing) ∈
      Algebra.algebraMapSubmonoid LazardRing (Ideal.span {(p : ℤ)}).primeCompl := by
    refine ⟨(q : ℤ), ?_, by simp⟩
    rw [SetLike.mem_coe, Ideal.mem_primeCompl_iff, Ideal.mem_span_singleton,
      Int.natCast_dvd_natCast]
    intro hdvd
    exact hqp ((hq.dvd_iff_eq hp.out.ne_one).mp hdvd)
  simpa using IsLocalization.map_units S ⟨(q : LazardRing), hmem⟩

/-- Quillen's `p`-typicalization ring endomorphism on a localization `S` of `LazardRing` at the
prime ideal `(p)` of `ℤ` (such as `LazardRing ⊗[ℤ] ℤ_(p)`). -/
def pTypicalEndAtPrime (p : ℕ) [Fact p.Prime] [Algebra LazardRing S]
    [IsLocalization (Algebra.algebraMapSubmonoid LazardRing (Ideal.span {(p : ℤ)}).primeCompl) S] :
    S →+* S :=
  pTypicalEnd (Ideal.span {(p : ℤ)}).primeCompl p
    (isUnit_natCast_of_isLocalization_primeCompl p)

/-- `TauCeti.LazardRing.pTypicalEndAtPrime` is idempotent. -/
@[simp]
theorem pTypicalEndAtPrime_comp_pTypicalEndAtPrime (p : ℕ) [Fact p.Prime] [Algebra LazardRing S]
    [IsLocalization (Algebra.algebraMapSubmonoid LazardRing (Ideal.span {(p : ℤ)}).primeCompl) S] :
    (pTypicalEndAtPrime (S := S) p).comp (pTypicalEndAtPrime p) = pTypicalEndAtPrime p :=
  pTypicalEnd_comp_pTypicalEnd _ p _

end AtPrime

end TauCeti.LazardRing
