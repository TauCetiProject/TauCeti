module

public import TauCeti.RingTheory.FormalGroup.Araki
import TauCeti.RingTheory.FormalGroup.Hazewinkel.NSMul
import Mathlib.Algebra.CharP.Quotient

/-!
# Araki and Hazewinkel coefficients in characteristic `p`

The Araki coefficients of Hazewinkel's integral formal group law reduce to its
Hazewinkel parameters modulo `p`. This follows by comparing the recursive Araki
expansion with Ravenel's modulo-`p` formula for the Hazewinkel `p`-series.
-/

public section

open Finset
open PowerSeries (coeff)

namespace TauCeti

variable {R : Type*} [CommRing R] {p : ℕ} [hp : Fact p.Prime]

/-- In characteristic `p`, the positive Araki coefficients of Hazewinkel's integral
formal group law are its Hazewinkel parameters. -/
@[simp↓]
theorem arakiCoeff_hazewinkelIntegralFormalGroup_of_charP [CharP R p]
    (v : ℕ+ → R) (n : ℕ+) :
    (hazewinkelIntegralFormalGroup p v).arakiCoeff hp.out (n : ℕ) = v n := by
  induction n using PNat.strongInductionOn with
  | _ n ih =>
    let F := hazewinkelIntegralFormalGroup p v
    obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero n.ne_zero
    have hmn : m.succPNat = n := PNat.eq (by simpa using hm.symm)
    let s : F.Curve := ∑ i ∈ range m,
      F.monomialCurve (p ^ (i + 1)) (pow_ne_zero _ hp.out.ne_zero) (v i.succPNat)
    have hsum : (∑ j ∈ range (n : ℕ),
        F.monomialCurve (p ^ j) (pow_ne_zero _ hp.out.ne_zero) (F.arakiCoeff hp.out j)) = s := by
      rw [hm, sum_range_succ']
      simp only [FormalGroup.arakiCoeff_zero, CharP.cast_eq_zero R p,
        FormalGroup.monomialCurve_zero, add_zero]
      apply sum_congr rfl
      intro i hi
      congr 1
      apply ih i.succPNat
      rw [← PNat.coe_lt_coe, Nat.succPNat_coe, hm]
      exact Nat.succ_lt_succ (mem_range.mp hi)
    have hsum' : (∑ i ∈ range (n : ℕ),
        F.monomialCurve (p ^ (i + 1)) (pow_ne_zero _ hp.out.ne_zero) (v i.succPNat)) =
        s + F.monomialCurve (p ^ (n : ℕ)) (pow_ne_zero _ hp.out.ne_zero) (v n) := by
      rw [hm, sum_range_succ]
      simp only [hmn]
      rfl
    rw [FormalGroup.arakiCoeff_eq_coeff_sub_sum, hsum]
    have hcoeff (i : ℕ) (hi : i ≤ p ^ (n : ℕ)) :
        coeff i (p • F.tautologicalCurve).toPowerSeries =
          coeff i (s + F.monomialCurve (p ^ (n : ℕ))
            (pow_ne_zero _ hp.out.ne_zero) (v n)).toPowerSeries := by
      rw [FormalGroup.Curve.toPowerSeries_nsmul,
        FormalGroup.toPowerSeries_tautologicalCurve, PowerSeries.X_subst, ← hsum']
      exact coeff_nsmulSeries_hazewinkelIntegralFormalGroup_eq_of_charP p v
        (hi.trans_lt (Nat.pow_lt_pow_right hp.out.one_lt (Nat.lt_succ_self _)))
    rw [FormalGroup.Curve.coeff_sub_congr hcoeff (fun _ _ ↦ rfl), add_sub_cancel_left]
    simp

/-- The positive Araki coefficients of Hazewinkel's integral formal group law are
congruent to its Hazewinkel parameters modulo the principal ideal generated by `p`. -/
theorem natCast_dvd_arakiCoeff_hazewinkelIntegralFormalGroup_sub (v : ℕ+ → R) (n : ℕ+) :
    (p : R) ∣ (hazewinkelIntegralFormalGroup p v).arakiCoeff hp.out (n : ℕ) - v n := by
  by_cases hunit : IsUnit (p : R)
  · exact hunit.dvd
  let : CharP (R ⧸ Ideal.span {(p : R)}) p := CharP.quotient R p hunit
  rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero,
    FormalGroup.map_arakiCoeff]
  simp only [map_hazewinkelIntegralFormalGroup]
  exact arakiCoeff_hazewinkelIntegralFormalGroup_of_charP _ n

end TauCeti
