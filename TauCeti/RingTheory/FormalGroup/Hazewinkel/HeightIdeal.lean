/-!
# Height ideals, primality, and regular sequences for Hazewinkel's formal group law

Let `p` be a prime and let `F_v` (`TauCeti.hazewinkelIntegralFormalGroup p v`) be the specialization
of Hazewinkel's integral formal group law at a family `v = (v₁, v₂, …)` in a commutative ring `R`.
Because the nonlinear coefficients of `[p]_(F_v)(X)` below degree `pⁿ` lie in `(v₁, …, v_(n - 1))`
and the coefficient of `X^(pⁿ)` is congruent to `(1 - p^(pⁿ - 1)) vₙ` modulo `(v₁, …, v_(n - 1))`,
Landweber's height ideals `I_n(F_v)` (`FormalGroup.heightIdeal`) take the explicit generator form

  `I_n(F_v) = (p, v₁, …, v_(n - 1))`  (`n ≥ 1`),

with `coeff (pⁿ) [p]_(F_v) ≡ vₙ (mod I_n(F_v))` and `I_(n + 1)(F_v) = I_n(F_v) + (vₙ)`. The
increasing union `⨆ n, I_n(F_v)` is `(p, v₁, v₂, …)`.

Over a field `K` of characteristic `p`, this identifies the height of `F_v` directly from its
Hazewinkel parameters: `F_v` has height at least `n` iff `v₁ = ⋯ = v_(n - 1) = 0`, finite height `n`
iff `v₁ = ⋯ = v_(n - 1) = 0` and `vₙ ≠ 0`, and infinite height iff `v = 0`.

For the polynomial family `X : ℕ+ → MvPolynomial ℕ+ R` (covering both `R = ℤ`, where `F_X` is
`TauCeti.universalHazewinkelIntegralFormalGroup p`, and `R = ℤ_(p)`):
* Each height ideal `I_n(F_X)` (`n ≥ 1`), as well as `⨆ n, I_n(F_X)`, is the preimage along
  `R[v₁, v₂, …] → (R ⧸ (p))[v₁, v₂, …]` of a monomial prime ideal generated by indeterminates, hence
  is prime whenever `(p)` is prime in `R`.
* For every `n ≥ 1` and any commutative ring `R` (with no domain hypothesis), both `vₙ` and the
  `pⁿ`-th coefficient of `[p]_(F_X)` are non-zerodivisors on `R[v₁, v₂, …] ⧸ I_n(F_X)`. When `p` is
  regular on `R` and `(p) ≠ ⊤`, both `(p, v₁, …, vₙ)` and Landweber's `[p]`-series coefficient
  sequence `(p, coeff p [p]_(F_X), …, coeff (pⁿ) [p]_(F_X))` are regular sequences on
  `R[v₁, v₂, …]`.
* Pulling back along the classifying homomorphism `LazardRing →+* ℤ[v₁, v₂, …]` shows that the
  universal height ideals `I₀ < I₁ < I₂ < ⋯` in `TauCeti.LazardRing` form a strictly increasing
  chain of proper ideals whose union `⨆ n, I_n` remains proper.

## Main results

* `TauCeti.heightIdeal_hazewinkelIntegralFormalGroup`:
  `I_n(F_v) = (p) ⊔ (v₁, …, v_(n - 1))` for `n ≥ 1`.
* `TauCeti.coeff_pow_nsmulSeries_hazewinkelIntegralFormalGroup_sub_mem_heightIdeal`:
  `coeff (pⁿ) [p]_(F_v) - vₙ ∈ I_n(F_v)` for `n ≥ 1`.
* `TauCeti.height_hazewinkelIntegralFormalGroup_eq_natCast_iff`,
  `TauCeti.height_hazewinkelIntegralFormalGroup_eq_top_iff`: characterization of the height of `F_v`
  over a field of characteristic `p`.
* `TauCeti.isPrime_heightIdeal_hazewinkelIntegralFormalGroup_X`,
  `TauCeti.isPrime_heightIdeal_universalHazewinkelIntegralFormalGroup`: primality of `I_n`
  (`n ≥ 1`).
* `TauCeti.isSMulRegular_X_quotient_heightIdeal_hazewinkelIntegralFormalGroup_X`,
  `TauCeti.isRegular_natCast_cons_X_hazewinkelIntegralFormalGroup`,
  `TauCeti.isRegular_coeff_pow_nsmulSeries_hazewinkelIntegralFormalGroup_X`: regularity modulo `I_n`
  and Landweber regular sequences `(p, v₁, …, vₙ)` over `R[v₁, v₂, …]`.
* `TauCeti.LazardRing.strictMono_heightIdeal_formalGroup`,
  `TauCeti.LazardRing.iSup_heightIdeal_formalGroup_ne_top`: the universal height ideals in the
  Lazard ring are proper and strictly increasing.

## References

* M. Hazewinkel, *Constructing formal groups. I. The local one dimensional case*, J. Pure Appl.
  Algebra 9 (1977), 131–149.
* [M. Hazewinkel, *Formal Groups and Applications*][hazewinkel1978], Chapter I, §5.
* P. S. Landweber, *Homological properties of comodules over `MU_*(MU)` and `BP_*(BP)`*,
  Amer. J. Math. 98 (1976), 591–610.
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres*, Chapter 4 and
  Appendix A2.
-/

public section

noncomputable section

namespace TauCeti

section Ring

variable {R : Type*} [CommRing R] (p : ℕ) [hp : Fact p.Prime]

/-- For `n ≥ 1`, the difference between the coefficient of `X^(pⁿ)` in `[p]_(F_v)(X)` and `vₙ` lies
in `(p) ⊔ (v₁, …, v_(n - 1))`. -/
private theorem coeff_pow_nsmulSeries_sub_mem_span_sup (v : ℕ+ → R) (n : ℕ+) :
    PowerSeries.coeff (p ^ (n : ℕ)) ((hazewinkelIntegralFormalGroup p v).nsmulSeries p) - v n ∈
      Ideal.span {(p : R)} ⊔ Ideal.span (v '' {i : ℕ+ | (i : ℕ) < n}) := by
  have hsub :
      PowerSeries.coeff (p ^ (n : ℕ)) ((hazewinkelIntegralFormalGroup p v).nsmulSeries p) -
          (1 - (p : R) ^ (p ^ (n : ℕ) - 1)) * v n ∈
        Ideal.span {(p : R)} ⊔ Ideal.span (v '' {i : ℕ+ | (i : ℕ) < n}) :=
    Ideal.mem_sup_right (coeff_pow_nsmulSeries_hazewinkelIntegralFormalGroup_sub_mem_span p v n)
  have hpow : (p : R) ^ (p ^ (n : ℕ) - 1) * v n ∈
      Ideal.span {(p : R)} ⊔ Ideal.span (v '' {i : ℕ+ | (i : ℕ) < n}) := by
    refine Ideal.mem_sup_left (Ideal.mem_span_singleton.mpr ?_)
    have hlt : 1 < p ^ (n : ℕ) := Nat.one_lt_pow n.ne_zero hp.out.one_lt
    refine ⟨(p : R) ^ (p ^ (n : ℕ) - 2) * v n, ?_⟩
    rw [← mul_assoc, ← pow_succ']
    congr 2
    omega
  have hmem := Ideal.sub_mem _ hsub hpow
  convert hmem using 1
  ring

/-- **Generators of the height ideals of Hazewinkel's formal group law.** For `n ≥ 1`, the `n`-th
height ideal of `hazewinkelIntegralFormalGroup p v` is `(p, v₁, …, v_(n - 1))`. -/
theorem heightIdeal_hazewinkelIntegralFormalGroup (v : ℕ+ → R) {n : ℕ} (hn : 0 < n) :
    (hazewinkelIntegralFormalGroup p v).heightIdeal p n =
      Ideal.span {(p : R)} ⊔ Ideal.span (v '' {i : ℕ+ | (i : ℕ) < n}) := by
  induction n with
  | zero => omega
  | succ m ih =>
    rcases m.eq_zero_or_pos with rfl | hm
    · have hemp : {i : ℕ+ | (i : ℕ) < 1} = ∅ := by
        ext i
        simp
      rw [(hazewinkelIntegralFormalGroup p v).heightIdeal_one hp.out, hemp, Set.image_empty,
        Ideal.span_empty, sup_bot_eq]
    · obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hm.ne'
      let k' : ℕ+ := k.succPNat
      have hk' : (k' : ℕ) = k + 1 := Nat.succPNat_coe k
      have hmem :
          v k' - PowerSeries.coeff (p ^ (k + 1))
              ((hazewinkelIntegralFormalGroup p v).nsmulSeries p) ∈
            (hazewinkelIntegralFormalGroup p v).heightIdeal p (k + 1) := by
        rw [ih (Nat.succ_pos k), ← neg_sub, Ideal.neg_mem_iff]
        simpa only [hk'] using coeff_pow_nsmulSeries_sub_mem_span_sup p v k'
      rw [(hazewinkelIntegralFormalGroup p v).heightIdeal_succ_eq_sup_of_sub_mem hp.out hmem,
        ih (Nat.succ_pos k)]
      have hset : {i : ℕ+ | (i : ℕ) < k + 2} = insert k' {i : ℕ+ | (i : ℕ) < k + 1} := by
        ext i
        simp only [Set.mem_ofPred_eq, Set.mem_insert_iff, ← PNat.coe_inj, hk']
        omega
      rw [hset, Set.image_insert_eq, Ideal.span_insert, sup_assoc, sup_comm (Ideal.span {v k'})]

/-- **Hazewinkel's generator `vₙ` modulo `I_n`.** For every `n ≥ 1`, the coefficient of `X^(pⁿ)` in
`[p]_(F_v)(X)` agrees with `vₙ` modulo the `n`-th height ideal `I_n(F_v)`. -/
theorem coeff_pow_nsmulSeries_hazewinkelIntegralFormalGroup_sub_mem_heightIdeal
    (v : ℕ+ → R) (n : ℕ+) :
    PowerSeries.coeff (p ^ (n : ℕ)) ((hazewinkelIntegralFormalGroup p v).nsmulSeries p) - v n ∈
      (hazewinkelIntegralFormalGroup p v).heightIdeal p n := by
  rw [heightIdeal_hazewinkelIntegralFormalGroup p v n.pos]
  exact coeff_pow_nsmulSeries_sub_mem_span_sup p v n

/-- For `n ≥ 1`, adjoining `vₙ` to `I_n(F_v)` gives `I_(n + 1)(F_v)`. -/
theorem heightIdeal_hazewinkelIntegralFormalGroup_succ (v : ℕ+ → R) (n : ℕ+) :
    (hazewinkelIntegralFormalGroup p v).heightIdeal p ((n : ℕ) + 1) =
      (hazewinkelIntegralFormalGroup p v).heightIdeal p n ⊔ Ideal.span {v n} := by
  refine (hazewinkelIntegralFormalGroup p v).heightIdeal_succ_eq_sup_of_sub_mem hp.out ?_
  rw [← neg_sub, Ideal.neg_mem_iff]
  exact coeff_pow_nsmulSeries_hazewinkelIntegralFormalGroup_sub_mem_heightIdeal p v n

/-- The supremum of all height ideals of `hazewinkelIntegralFormalGroup p v` is `(p, v₁, v₂, …)`. -/
theorem iSup_heightIdeal_hazewinkelIntegralFormalGroup (v : ℕ+ → R) :
    ⨆ n, (hazewinkelIntegralFormalGroup p v).heightIdeal p n =
      Ideal.span {(p : R)} ⊔ Ideal.span (Set.range v) := by
  refine le_antisymm (iSup_le fun n ↦ ?_) (sup_le ?_ ?_)
  · rcases n.eq_zero_or_pos with rfl | hn
    · simp
    · rw [heightIdeal_hazewinkelIntegralFormalGroup p v hn]
      exact sup_le_sup_left (Ideal.span_mono (Set.image_subset_range _ _)) _
  · rw [← (hazewinkelIntegralFormalGroup p v).heightIdeal_one hp.out]
    exact le_iSup (fun n ↦ (hazewinkelIntegralFormalGroup p v).heightIdeal p n) 1
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    refine IsConcreteLE.le_iff.mp
      (le_iSup (fun n ↦ (hazewinkelIntegralFormalGroup p v).heightIdeal p n) ((i : ℕ) + 1)) ?_
    rw [heightIdeal_hazewinkelIntegralFormalGroup_succ p v i]
    exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)

/-- For `n ≥ 1`, the `n`-th height ideal of `universalHazewinkelIntegralFormalGroup p` over
`ℤ[v₁, v₂, …]` is `(p, v₁, …, v_(n - 1))`. -/
theorem heightIdeal_universalHazewinkelIntegralFormalGroup {n : ℕ} (hn : 0 < n) :
    (universalHazewinkelIntegralFormalGroup p).heightIdeal p n =
      Ideal.span {(p : MvPolynomial ℕ+ ℤ)} ⊔
        Ideal.span ((MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ ℤ) '' {i : ℕ+ | (i : ℕ) < n}) := by
  rw [← hazewinkelIntegralFormalGroup_X, heightIdeal_hazewinkelIntegralFormalGroup p _ hn]

/-- The supremum of the height ideals of `universalHazewinkelIntegralFormalGroup p` is the maximal
graded ideal `(p, v₁, v₂, …)` of `ℤ[v₁, v₂, …]`. -/
theorem iSup_heightIdeal_universalHazewinkelIntegralFormalGroup :
    ⨆ n, (universalHazewinkelIntegralFormalGroup p).heightIdeal p n =
      Ideal.span {(p : MvPolynomial ℕ+ ℤ)} ⊔
        Ideal.span (Set.range (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ ℤ)) := by
  rw [← hazewinkelIntegralFormalGroup_X, iSup_heightIdeal_hazewinkelIntegralFormalGroup]

/-- Over `ℤ[v₁, v₂, …]`, the coefficient of `X^(pⁿ)` in `[p]` agrees with `vₙ` modulo `I_n`. -/
theorem coeff_pow_nsmulSeries_universalHazewinkelIntegralFormalGroup_sub_mem_heightIdeal (n : ℕ+) :
    PowerSeries.coeff (p ^ (n : ℕ)) ((universalHazewinkelIntegralFormalGroup p).nsmulSeries p) -
        MvPolynomial.X n ∈
      (universalHazewinkelIntegralFormalGroup p).heightIdeal p n := by
  rw [← hazewinkelIntegralFormalGroup_X]
  exact coeff_pow_nsmulSeries_hazewinkelIntegralFormalGroup_sub_mem_heightIdeal p _ n

end Ring

/-! ### Height over fields of characteristic `p` -/

section Field

variable {K : Type*} [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]

/-- Over a field of characteristic `p`, the `n`-th height ideal of `F_v` is generated by
`v₁, …, v_(n - 1)` for every `n : ℕ`. -/
theorem heightIdeal_hazewinkelIntegralFormalGroup_of_charP (v : ℕ+ → K) (n : ℕ) :
    (hazewinkelIntegralFormalGroup p v).heightIdeal p n =
      Ideal.span (v '' {i : ℕ+ | (i : ℕ) < n}) := by
  rcases n.eq_zero_or_pos with rfl | hn
  · simp
  · rw [heightIdeal_hazewinkelIntegralFormalGroup p v hn, CharP.cast_eq_zero K p,
      Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq]

/-- Over a field of characteristic `p`, `hazewinkelIntegralFormalGroup p v` has height at least `n`
if and only if `vᵢ = 0` for all `1 ≤ i < n`. -/
theorem le_height_hazewinkelIntegralFormalGroup_iff (v : ℕ+ → K) {n : ℕ} :
    (n : ℕ∞) ≤ (hazewinkelIntegralFormalGroup p v).height p ↔
      ∀ i : ℕ+, (i : ℕ) < n → v i = 0 := by
  rw [← (hazewinkelIntegralFormalGroup p v).heightIdeal_eq_bot_iff_le_height,
    heightIdeal_hazewinkelIntegralFormalGroup_of_charP, Ideal.span_eq_bot]
  constructor
  · intro h i hi
    exact h (v i) ⟨i, hi, rfl⟩
  · rintro h _ ⟨i, hi, rfl⟩
    exact h i hi

/-- Over a field of characteristic `p`, `hazewinkelIntegralFormalGroup p v` has finite height
`n ≥ 1` if and only if `v₁ = ⋯ = v_(n - 1) = 0` and `vₙ ≠ 0`. -/
theorem height_hazewinkelIntegralFormalGroup_eq_natCast_iff (v : ℕ+ → K) (n : ℕ+) :
    (hazewinkelIntegralFormalGroup p v).height p = (n : ℕ) ↔
      (∀ i < n, v i = 0) ∧ v n ≠ 0 := by
  constructor
  · intro hh
    have hle : ((n : ℕ) : ℕ∞) ≤ (hazewinkelIntegralFormalGroup p v).height p := hh.ge
    have hnle : ¬ (((n : ℕ) + 1 : ℕ) : ℕ∞) ≤ (hazewinkelIntegralFormalGroup p v).height p := by
      rw [hh, Nat.cast_le]
      omega
    rw [le_height_hazewinkelIntegralFormalGroup_iff] at hle hnle
    refine ⟨hle, fun hvn ↦ hnle fun i hi ↦ ?_⟩
    rcases (Nat.lt_succ_iff.mp hi).lt_or_eq with hlt | heq
    · exact hle i hlt
    · exact PNat.coe_inj.mp heq ▸ hvn
  · rintro ⟨hle, hvn⟩
    have hle' : ((n : ℕ) : ℕ∞) ≤ (hazewinkelIntegralFormalGroup p v).height p :=
      (le_height_hazewinkelIntegralFormalGroup_iff p v).mpr hle
    have hlt : (hazewinkelIntegralFormalGroup p v).height p < (((n : ℕ) + 1 : ℕ) : ℕ∞) := by
      rw [← not_le, le_height_hazewinkelIntegralFormalGroup_iff]
      exact fun hall ↦ hvn (hall n (Nat.lt_succ_self _))
    cases hh : (hazewinkelIntegralFormalGroup p v).height p with
    | top => simp [hh] at hlt
    | coe m =>
      rw [hh] at hle' hlt
      exact_mod_cast le_antisymm (Nat.lt_succ_iff.mp (Nat.cast_lt.mp hlt)) (Nat.cast_le.mp hle')

/-- Over a field of characteristic `p`, `hazewinkelIntegralFormalGroup p v` has infinite height if
and only if `v = 0`. -/
theorem height_hazewinkelIntegralFormalGroup_eq_top_iff (v : ℕ+ → K) :
    (hazewinkelIntegralFormalGroup p v).height p = ⊤ ↔ v = 0 := by
  rw [← top_le_iff, ← ENat.forall_natCast_le_iff_le]
  simp only [le_top, forall_true_left, le_height_hazewinkelIntegralFormalGroup_iff, funext_iff,
    Pi.zero_apply]
  exact ⟨fun h i ↦ h ((i : ℕ) + 1) i (Nat.lt_succ_self _), fun h _ i _ ↦ h i⟩

end Field

/-! ### Primality, regularity, and the universal height filtration -/

section Polynomial

variable (p : ℕ) [hp : Fact p.Prime]

/-- If `(p)` is a prime ideal of `R` (for instance `R = ℤ` or `R = ℤ_(p)`), then for every `n ≥ 1`
the `n`-th height ideal of `hazewinkelIntegralFormalGroup p MvPolynomial.X` over `R[v₁, v₂, …]` is
prime. -/
theorem isPrime_heightIdeal_hazewinkelIntegralFormalGroup_X {R : Type*} [CommRing R]
    (hprime : (Ideal.span {(p : R)}).IsPrime) {n : ℕ} (hn : 0 < n) :
    ((hazewinkelIntegralFormalGroup p
      (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p n).IsPrime := by
  have : (Ideal.span {(p : R)}).IsPrime := hprime
  have hspan : Ideal.span {(p : MvPolynomial ℕ+ R)} =
      (Ideal.span {(p : R)}).map MvPolynomial.C := by
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  rw [heightIdeal_hazewinkelIntegralFormalGroup p _ hn, hspan,
    ← MvPolynomial.comap_map_quotient_mk_span_X_image]
  exact (MvPolynomial.span_X_image_isPrime _).comap _

/-- If `(p)` is a prime ideal of `R`, then the union `⨆ n, I_n` of the height ideals over
`R[v₁, v₂, …]` is prime. -/
theorem isPrime_iSup_heightIdeal_hazewinkelIntegralFormalGroup_X {R : Type*} [CommRing R]
    (hprime : (Ideal.span {(p : R)}).IsPrime) :
    (⨆ n, (hazewinkelIntegralFormalGroup p
      (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p n).IsPrime := by
  have : (Ideal.span {(p : R)}).IsPrime := hprime
  have hspan : Ideal.span {(p : MvPolynomial ℕ+ R)} =
      (Ideal.span {(p : R)}).map MvPolynomial.C := by
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  rw [iSup_heightIdeal_hazewinkelIntegralFormalGroup, ← Set.image_univ, hspan,
    ← MvPolynomial.comap_map_quotient_mk_span_X_image]
  exact (MvPolynomial.span_X_image_isPrime _).comap _

/-- For every `n ≥ 1`, the `n`-th height ideal `(p, v₁, …, v_(n - 1))` of
`universalHazewinkelIntegralFormalGroup p` over `ℤ[v₁, v₂, …]` is prime. -/
theorem isPrime_heightIdeal_universalHazewinkelIntegralFormalGroup {n : ℕ} (hn : 0 < n) :
    ((universalHazewinkelIntegralFormalGroup p).heightIdeal p n).IsPrime := by
  rw [← hazewinkelIntegralFormalGroup_X]
  exact isPrime_heightIdeal_hazewinkelIntegralFormalGroup_X p
    ((Ideal.span_singleton_prime (Nat.cast_ne_zero.mpr hp.out.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hp.out)) hn

/-- The supremum `⨆ n, I_n = (p, v₁, v₂, …)` of the height ideals of
`universalHazewinkelIntegralFormalGroup p` over `ℤ[v₁, v₂, …]` is prime. -/
theorem isPrime_iSup_heightIdeal_universalHazewinkelIntegralFormalGroup :
    (⨆ n, (universalHazewinkelIntegralFormalGroup p).heightIdeal p n).IsPrime := by
  rw [← hazewinkelIntegralFormalGroup_X]
  exact isPrime_iSup_heightIdeal_hazewinkelIntegralFormalGroup_X p
    ((Ideal.span_singleton_prime (Nat.cast_ne_zero.mpr hp.out.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hp.out))

/-- If `(p) ≠ ⊤` in `R`, then the supremum `⨆ n, I_n` of the height ideals over `R[v₁, v₂, …]` is a
proper ideal. -/
theorem iSup_heightIdeal_hazewinkelIntegralFormalGroup_X_ne_top {R : Type*} [CommRing R]
    (hptop : Ideal.span {(p : R)} ≠ ⊤) :
    ⨆ n, (hazewinkelIntegralFormalGroup p
      (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p n ≠ ⊤ := by
  have : Nontrivial (R ⧸ Ideal.span {(p : R)}) := Ideal.Quotient.nontrivial_iff.mpr hptop
  have hspan : Ideal.span {(p : MvPolynomial ℕ+ R)} =
      (Ideal.span {(p : R)}).map MvPolynomial.C := by
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  rw [iSup_heightIdeal_hazewinkelIntegralFormalGroup, ← Set.image_univ, hspan,
    ← MvPolynomial.comap_map_quotient_mk_span_X_image]
  intro htop
  rw [Ideal.eq_top_iff_one, Ideal.mem_comap, map_one, ← Ideal.eq_top_iff_one] at htop
  have hle : Ideal.span ((MvPolynomial.X :
        ℕ+ → MvPolynomial ℕ+ (R ⧸ Ideal.span {(p : R)})) '' Set.univ) ≤
      RingHom.ker MvPolynomial.constantCoeff := by
    rw [Ideal.span_le]
    rintro _ ⟨i, -, rfl⟩
    simp
  exact RingHom.ker_ne_top MvPolynomial.constantCoeff (top_le_iff.mp (htop ▸ hle))

/-- If `(p) ≠ ⊤` in `R`, then every height ideal `I_n` over `R[v₁, v₂, …]` is a proper ideal. -/
theorem heightIdeal_hazewinkelIntegralFormalGroup_X_ne_top {R : Type*} [CommRing R]
    (hptop : Ideal.span {(p : R)} ≠ ⊤) (n : ℕ) :
    (hazewinkelIntegralFormalGroup p
      (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p n ≠ ⊤ :=
  ne_top_of_le_ne_top (iSup_heightIdeal_hazewinkelIntegralFormalGroup_X_ne_top p hptop)
    (le_iSup (fun m ↦ (hazewinkelIntegralFormalGroup p
      (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p m) n)

/-- If `(p : R) ≠ 0` and `(p) ≠ ⊤` in `R`, then the height ideals `I₀ < I₁ < I₂ < ⋯` over
`R[v₁, v₂, …]` are strictly increasing. -/
theorem strictMono_heightIdeal_hazewinkelIntegralFormalGroup_X {R : Type*} [CommRing R]
    (hp0 : (p : R) ≠ 0) (hptop : Ideal.span {(p : R)} ≠ ⊤) :
    StrictMono ((hazewinkelIntegralFormalGroup p
      (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p) := by
  have : Nontrivial (R ⧸ Ideal.span {(p : R)}) := Ideal.Quotient.nontrivial_iff.mpr hptop
  have hspan : Ideal.span {(p : MvPolynomial ℕ+ R)} =
      (Ideal.span {(p : R)}).map MvPolynomial.C := by
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  refine strictMono_nat_of_lt_succ fun n ↦ ?_
  refine lt_of_le_of_ne
    ((hazewinkelIntegralFormalGroup p _).heightIdeal_mono n.le_succ) fun heq ↦ ?_
  rcases n with _ | m
  · rw [FormalGroup.heightIdeal_zero,
      (hazewinkelIntegralFormalGroup p _).heightIdeal_one hp.out] at heq
    have hmem : (p : MvPolynomial ℕ+ R) ∈ (⊥ : Ideal (MvPolynomial ℕ+ R)) :=
      heq.symm ▸ Ideal.mem_span_singleton_self _
    rw [Ideal.mem_bot, ← map_natCast MvPolynomial.C] at hmem
    exact hp0 (by simpa using congrArg MvPolynomial.constantCoeff hmem)
  · let m' : ℕ+ := m.succPNat
    have hm' : (m' : ℕ) = m + 1 := Nat.succPNat_coe m
    have hm2 : m + 2 = (m' : ℕ) + 1 := by omega
    have hin : (MvPolynomial.X m' : MvPolynomial ℕ+ R) ∈
        (hazewinkelIntegralFormalGroup p
          (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p (m + 2) := by
      rw [hm2, heightIdeal_hazewinkelIntegralFormalGroup_succ]
      exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
    rw [← heq, heightIdeal_hazewinkelIntegralFormalGroup p _ (Nat.succ_pos m), hspan,
      ← MvPolynomial.comap_map_quotient_mk_span_X_image, Ideal.mem_comap,
      MvPolynomial.map_X] at hin
    classical
    have hnot : m' ∉ {i : ℕ+ | (i : ℕ) < m + 1} := by simp [hm']
    rw [MvPolynomial.span_X_image_eq_ker_aeval_ite_mem, RingHom.mem_ker, MvPolynomial.aeval_X]
      at hin
    simp only [Set.mem_compl_iff, hnot, not_false_eq_true, ↓reduceIte] at hin
    exact MvPolynomial.X_ne_zero m' hin

/-- For every commutative ring `R` and `n : ℕ+`, the generator `X n` is regular on the quotient
`R[v₁, v₂, …] ⧸ I_n`. -/
theorem isSMulRegular_X_quotient_heightIdeal_hazewinkelIntegralFormalGroup_X
    (R : Type*) [CommRing R] (n : ℕ+) :
    IsSMulRegular
      (MvPolynomial ℕ+ R ⧸ (hazewinkelIntegralFormalGroup p
        (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p n)
      (MvPolynomial.X n : MvPolynomial ℕ+ R) := by
  have hspan : Ideal.span {(p : MvPolynomial ℕ+ R)} =
      (Ideal.span {(p : R)}).map MvPolynomial.C := by
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  rw [heightIdeal_hazewinkelIntegralFormalGroup p _ n.pos, hspan]
  exact MvPolynomial.isSMulRegular_X_quotient_map_C_sup_span_X_image _ _ (by simp)

/-- For every commutative ring `R` and `n : ℕ+`, the `pⁿ`-th coefficient of `[p]_(F_X)` is regular
on the quotient `R[v₁, v₂, …] ⧸ I_n`. -/
theorem isSMulRegular_coeff_nsmulSeries_quotient_heightIdeal_hazewinkelIntegralFormalGroup_X
    (R : Type*) [CommRing R] (n : ℕ+) :
    IsSMulRegular
      (MvPolynomial ℕ+ R ⧸ (hazewinkelIntegralFormalGroup p
        (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p n)
      (PowerSeries.coeff (p ^ (n : ℕ)) ((hazewinkelIntegralFormalGroup p
        (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).nsmulSeries p)) := by
  set I := (hazewinkelIntegralFormalGroup p
    (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).heightIdeal p n
  set a := PowerSeries.coeff (p ^ (n : ℕ)) ((hazewinkelIntegralFormalGroup p
    (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).nsmulSeries p)
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro f hf
  have hsub : (a - MvPolynomial.X n) * f ∈ I := Ideal.mul_mem_right f I
    (coeff_pow_nsmulSeries_hazewinkelIntegralFormalGroup_sub_mem_heightIdeal p _ n)
  have hxf : (MvPolynomial.X n : MvPolynomial ℕ+ R) • f ∈ I := by
    have := Ideal.sub_mem I hf hsub
    rwa [smul_eq_mul, sub_mul, sub_sub_cancel] at this
  exact (isSMulRegular_quotient_iff_mem_of_smul_mem I (MvPolynomial.X n)).mp
    (isSMulRegular_X_quotient_heightIdeal_hazewinkelIntegralFormalGroup_X p R n) f hxf

omit hp in
/-- **Landweber's regular sequence of Hazewinkel generators.** If `(p : R)` is regular on `R` and
`(p) ≠ ⊤` (for example `R = ℤ` or `R = ℤ_(p)`), then `(p, v₁, …, vₙ)` is a regular sequence on
`R[v₁, v₂, …]`. -/
theorem isRegular_natCast_cons_X_hazewinkelIntegralFormalGroup {R : Type*} [CommRing R]
    (hpreg : IsSMulRegular R (p : R)) (hptop : Ideal.span {(p : R)} ≠ ⊤) (n : ℕ) :
    RingTheory.Sequence.IsRegular (MvPolynomial ℕ+ R)
      ((p : MvPolynomial ℕ+ R) ::
        (List.range n).map fun i ↦ (MvPolynomial.X i.succPNat : MvPolynomial ℕ+ R)) := by
  have hnodup : ((List.range n).map Nat.succPNat).Nodup :=
    List.nodup_range.map Nat.succPNat_injective
  simpa only [map_natCast, List.map_map, Function.comp_def] using
    MvPolynomial.isRegular_C_cons_map_X hpreg hptop hnodup

/-- **Landweber's regular sequence of `[p]`-series coefficients.** If `(p : R)` is regular on `R`
and `(p) ≠ ⊤`, then `(p, coeff p [p]_(F_X), …, coeff (pⁿ) [p]_(F_X))` is a regular sequence on
`R[v₁, v₂, …]`. -/
theorem isRegular_coeff_pow_nsmulSeries_hazewinkelIntegralFormalGroup_X {R : Type*} [CommRing R]
    (hpreg : IsSMulRegular R (p : R)) (hptop : Ideal.span {(p : R)} ≠ ⊤) (n : ℕ) :
    RingTheory.Sequence.IsRegular (MvPolynomial ℕ+ R)
      ((List.range (n + 1)).map fun i ↦
        PowerSeries.coeff (p ^ i) ((hazewinkelIntegralFormalGroup p
          (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)).nsmulSeries p)) := by
  set F := hazewinkelIntegralFormalGroup p (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ R)
  set rs := (List.range (n + 1)).map fun i ↦ PowerSeries.coeff (p ^ i) (F.nsmulSeries p)
  have hspan (j : ℕ) (hj : j ≤ n + 1) : Ideal.ofList (rs.take j) = F.heightIdeal p j := by
    have htake : (List.range (n + 1)).take j = List.range j :=
      List.ext_getElem (by simp; omega) fun i _ _ ↦ by simp
    rw [F.heightIdeal_eq_span hp.out j, Ideal.ofList]
    simp only [rs, ← List.map_take, htake]
    congr 1
    ext x
    simp [Set.mem_image]
  refine ⟨⟨fun j hj ↦ ?_⟩, ?_⟩
  · have hj' : j < n + 1 := by simpa [rs] using hj
    rw [Ideal.smul_eq_mul, Ideal.mul_top, hspan j hj'.le]
    rcases j with _ | k
    · rw [FormalGroup.heightIdeal_zero, isSMulRegular_quotient_iff_mem_of_smul_mem]
      simp only [rs, List.getElem_map, List.getElem_range, pow_zero, F.coeff_one_nsmulSeries]
      intro f hf
      rw [Ideal.mem_bot] at hf ⊢
      have hpC : IsSMulRegular (MvPolynomial ℕ+ R) (p : MvPolynomial ℕ+ R) := by
        simpa only [map_natCast] using
          (MvPolynomial.isSMulRegular_C_iff (σ := ℕ+) (r := (p : R))).mpr hpreg
      exact hpC (hf.trans (smul_zero _).symm)
    · simp only [rs, List.getElem_map, List.getElem_range]
      have hreg :=
        isSMulRegular_coeff_nsmulSeries_quotient_heightIdeal_hazewinkelIntegralFormalGroup_X
          p R k.succPNat
      rwa [Nat.succPNat_coe, Nat.succ_eq_add_one] at hreg
  · rw [Ideal.smul_eq_mul, Ideal.mul_top, ne_comm]
    have hrs : rs.take (n + 1) = rs := List.take_of_length_le (by simp [rs])
    rw [← hrs, hspan (n + 1) le_rfl]
    exact heightIdeal_hazewinkelIntegralFormalGroup_X_ne_top p hptop (n + 1)

/-- Over `ℤ[v₁, v₂, …]`, `(p, v₁, …, vₙ)` is a regular sequence for every `n : ℕ`. -/
theorem isRegular_natCast_cons_X_int (n : ℕ) :
    RingTheory.Sequence.IsRegular (MvPolynomial ℕ+ ℤ)
      ((p : MvPolynomial ℕ+ ℤ) ::
        (List.range n).map fun i ↦ (MvPolynomial.X i.succPNat : MvPolynomial ℕ+ ℤ)) :=
  isRegular_natCast_cons_X_hazewinkelIntegralFormalGroup p
    (fun _ _ h ↦ mul_left_cancel₀ (Nat.cast_ne_zero.mpr hp.out.ne_zero) h)
    ((Ideal.span_singleton_prime (Nat.cast_ne_zero.mpr hp.out.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hp.out)).ne_top n

/-- Over `ℤ[v₁, v₂, …]`, the `[p]`-series coefficients
`(p, coeff p [p]_F, …, coeff (pⁿ) [p]_F)` of `universalHazewinkelIntegralFormalGroup p` form a
regular sequence for every `n : ℕ`. -/
theorem isRegular_coeff_pow_nsmulSeries_universalHazewinkelIntegralFormalGroup (n : ℕ) :
    RingTheory.Sequence.IsRegular (MvPolynomial ℕ+ ℤ)
      ((List.range (n + 1)).map fun i ↦
        PowerSeries.coeff (p ^ i)
          ((universalHazewinkelIntegralFormalGroup p).nsmulSeries p)) := by
  rw [← hazewinkelIntegralFormalGroup_X]
  exact isRegular_coeff_pow_nsmulSeries_hazewinkelIntegralFormalGroup_X p
    (fun _ _ h ↦ mul_left_cancel₀ (Nat.cast_ne_zero.mpr hp.out.ne_zero) h)
    ((Ideal.span_singleton_prime (Nat.cast_ne_zero.mpr hp.out.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hp.out)).ne_top n

end Polynomial

namespace LazardRing

variable (p : ℕ) [hp : Fact p.Prime]

/-- The supremum `⨆ n, I_n` of the height ideals of the universal formal group law over
`LazardRing` is a proper ideal. -/
theorem iSup_heightIdeal_formalGroup_ne_top :
    ⨆ n, formalGroup.heightIdeal p n ≠ ⊤ := by
  intro htop
  have hmap := congrArg
    (Ideal.map (lift
      ⟨hazewinkelIntegralFormalGroup p (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ ℤ),
        inferInstance⟩)) htop
  rw [Ideal.map_iSup, Ideal.map_top] at hmap
  simp only [FormalGroup.map_heightIdeal, map_lift] at hmap
  exact iSup_heightIdeal_hazewinkelIntegralFormalGroup_X_ne_top p
    ((Ideal.span_singleton_prime (Nat.cast_ne_zero.mpr hp.out.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hp.out)).ne_top hmap

/-- Every height ideal `I_n` of the universal formal group law over `LazardRing` is proper. -/
theorem heightIdeal_formalGroup_ne_top (n : ℕ) :
    formalGroup.heightIdeal p n ≠ ⊤ :=
  ne_top_of_le_ne_top (iSup_heightIdeal_formalGroup_ne_top p)
    (le_iSup (fun m ↦ formalGroup.heightIdeal p m) n)

/-- The height ideals `I₀ < I₁ < I₂ < ⋯` of the universal formal group law over `LazardRing` are
strictly increasing. -/
theorem strictMono_heightIdeal_formalGroup :
    StrictMono (formalGroup.heightIdeal p) := by
  have hstrict := strictMono_heightIdeal_hazewinkelIntegralFormalGroup_X p
    (R := ℤ) (Nat.cast_ne_zero.mpr hp.out.ne_zero)
    ((Ideal.span_singleton_prime (Nat.cast_ne_zero.mpr hp.out.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hp.out)).ne_top
  intro m n hmn
  refine lt_of_le_of_ne (formalGroup.heightIdeal_mono hmn.le) fun heq ↦ (hstrict hmn).ne ?_
  have hmap := congrArg
    (Ideal.map (lift
      ⟨hazewinkelIntegralFormalGroup p (MvPolynomial.X : ℕ+ → MvPolynomial ℕ+ ℤ),
        inferInstance⟩)) heq
  simpa only [FormalGroup.map_heightIdeal, map_lift] using hmap

