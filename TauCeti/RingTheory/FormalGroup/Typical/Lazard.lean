public import TauCeti.RingTheory.FormalGroup.CoordinateChange.Lazard
public import TauCeti.RingTheory.FormalGroup.Typical.Basic
public import TauCeti.RingTheory.GradedAlgebra.Localization

/-!
# Quillen's `p`-typicalization idempotent on the localized Lazard ring

Let `L = TauCeti.LazardRing` be the Lazard ring classifying commutative formal group laws, and for
`p : ℕ` let `M_p = TauCeti.LazardRing.coprimeSubmonoid p` be the multiplicative submonoid generated
by all primes `q` not dividing `p` (for `p` prime, the primes `q ≠ p`, so localizing `L` at `M_p`
is `L_{(p)} = L ⊗ ℤ_{(p)}`). In any localization `S` of `L` at `M_p`, every prime `q ∤ p` is a unit,
so the base change `F_S` of the universal formal group law admits Cartier's canonical
`p`-typicalization `F_S.typicalize p _`.

By the universal property of the localized Lazard ring (`TauCeti.LazardRing.localizedLift`), the
`p`-typicalized law `F_S.typicalize p _` is classified by a canonical ring endomorphism

  `e_p = TauCeti.LazardRing.typicalIdempotent p S : S →+* S`,

**Quillen's `p`-typicalization idempotent** (the algebraic avatar of the Brown–Peterson idempotent
on `MU_{(p)}`). Composing the classifying map of any commutative formal group law `F` over an
`M_p`-invertible ring `R` with `e_p` classifies `F.typicalize p _`; consequently, `f ∘ e_p = f` if
and only if the formal group law classified by `f` is `p`-typical, and `e_p ∘ e_p = e_p`.

Restricting `F_S` along `(typicalIdempotent p S).rangeRestrict` gives a `p`-typical formal group
law `TauCeti.LazardRing.typicalFormalGroup p S` over `(typicalIdempotent p S).range`
that is **universal** among `p`-typical commutative formal group laws over rings in which every
prime `q ∤ p` is invertible (`TauCeti.LazardRing.typicalLocalizedLift`). Furthermore, the canonical
strict coordinate `c_{F_S}⁻¹` yields a homomorphism `L[b₁, b₂, …] →+* S` intertwining the left unit
`η_L` with `algebraMap L S` and the right unit `η_R` with `e_p ∘ algebraMap L S`, and whenever `S`
carries a compatible `ℕ`-grading, `e_p` is a graded ring endomorphism.

## Main definitions

* `TauCeti.LazardRing.coprimeSubmonoid`: the multiplicative submonoid of `LazardRing` generated by
  all primes `(q : LazardRing)` with `q ∤ p`.
* `TauCeti.LazardRing.localizedLift`: universal property of any localization `S` of `LazardRing` at
  `coprimeSubmonoid p`.
* `TauCeti.LazardRing.typicalIdempotent`: Quillen's `p`-typicalization idempotent `e_p : S →+* S`.
* `TauCeti.LazardRing.typicalFormalGroup`: the universal `p`-typical formal group law over
  `(typicalIdempotent p S).range`.
* `TauCeti.LazardRing.typicalLocalizedLift`: universal property of `(typicalIdempotent p S).range`
  for `p`-typical commutative formal group laws.
* `TauCeti.LazardRing.typicalCoordinateHom`: the homomorphism `L[b₁, b₂, …] →+* S` classifying the
  canonical strict isomorphism from `F_S` to `F_S.typicalize p _`.
* `TauCeti.LazardRing.gradedTypicalIdempotent`: `typicalIdempotent p S` bundled as a graded ring
  endomorphism on any compatibly `ℕ`-graded localization `S`.

## Main results

* `TauCeti.LazardRing.localizedLift_comp_typicalIdempotent`: precomposing a classifying map with
  `typicalIdempotent p S` classifies `F.typicalize p _`.
* `TauCeti.LazardRing.comp_typicalIdempotent_eq_self_iff`: `f ∘ e_p = f` iff the classified formal
  group law is `p`-typical.
* `TauCeti.LazardRing.typicalIdempotent_comp_typicalIdempotent`: `e_p ∘ e_p = e_p`.
* `TauCeti.LazardRing.typicalCoordinateHom_comp_C`,
  `TauCeti.LazardRing.typicalCoordinateHom_comp_rightUnit`: `typicalCoordinateHom` connects
  `algebraMap L S` and `e_p ∘ algebraMap L S` along `(L, L[b₁, b₂, …])`.
* `TauCeti.LazardRing.typicalIdempotent_mem_graded`: `typicalIdempotent p S` preserves homogeneous
  degrees.

## References

* P. Cartier, *Modules associés à un groupe formel commutatif. Courbes typiques*, C. R. Acad. Sci.
  Paris Sér. A-B 265 (1967), A129–A132.
* D. Quillen, *On the formal group laws of unoriented and complex cobordism theory*, Bull. Amer.
  Math. Soc. 75 (1969), 1293–1298.
* [M. Hazewinkel, *Formal Groups and Applications*][hazewinkel1978], Chapter III, §16.
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres*, Academic Press (1986),
  Chapter 4, §1 and Appendix A2.1.
-/

public section

noncomputable section

open MvPolynomial

namespace TauCeti.LazardRing

/-! ### Localization of the Lazard ring away from primes not dividing `p` -/

/-- The multiplicative submonoid of `LazardRing` generated by all primes `(q : LazardRing)` not
dividing `p`. For `p` prime, localizing `LazardRing` at `coprimeSubmonoid p` inverts all primes
different from `p`. -/
def coprimeSubmonoid (p : ℕ) : Submonoid LazardRing :=
  Submonoid.closure ((Nat.cast : ℕ → LazardRing) '' {q : ℕ | q.Prime ∧ ¬ q ∣ p})

/-- Every prime `q` not dividing `p` belongs to `coprimeSubmonoid p`. -/
theorem natCast_mem_coprimeSubmonoid (p : ℕ) {q : ℕ} (hq : q.Prime) (hqp : ¬ q ∣ p) :
    (q : LazardRing) ∈ coprimeSubmonoid p :=
  Submonoid.subset_closure ⟨q, ⟨hq, hqp⟩, rfl⟩

/-- Every element of `coprimeSubmonoid p` is the cast of a natural number. -/
theorem exists_natCast_of_mem_coprimeSubmonoid {p : ℕ} {m : LazardRing}
    (hm : m ∈ coprimeSubmonoid p) : ∃ n : ℕ, (n : LazardRing) = m := by
  induction hm using Submonoid.closure_induction with
  | mem _ hx =>
    obtain ⟨q, _, rfl⟩ := hx
    exact ⟨q, rfl⟩
  | one => exact ⟨1, Nat.cast_one⟩
  | mul _ _ _ _ ha hb =>
    obtain ⟨a, rfl⟩ := ha
    obtain ⟨b, rfl⟩ := hb
    exact ⟨a * b, Nat.cast_mul a b⟩

/-- Every element of `coprimeSubmonoid p` is homogeneous of degree `0` in `LazardRing`. -/
theorem coprimeSubmonoid_le_grading_zero (p : ℕ) :
    (coprimeSubmonoid p : Set LazardRing) ⊆ grading 0 := fun _ hm ↦ by
  obtain ⟨n, rfl⟩ := exists_natCast_of_mem_coprimeSubmonoid hm
  exact SetLike.natCast_mem_graded grading n

section Localization

variable (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
  [IsLocalization (coprimeSubmonoid p) S]

/-- In any localization `S` of `LazardRing` at `coprimeSubmonoid p`, every prime `q` not dividing
`p` is invertible. -/
theorem isUnit_prime_of_isLocalization (q : ℕ) (hq : q.Prime) (hqp : ¬ q ∣ p) :
    IsUnit (q : S) := by
  simpa only [map_natCast] using
    IsLocalization.map_units S ⟨(q : LazardRing), natCast_mem_coprimeSubmonoid p hq hqp⟩

/-- If a commutative ring `R` receives a ring homomorphism from a localization of `LazardRing` at
`coprimeSubmonoid p`, then every prime `q` not dividing `p` is invertible in `R`. -/
theorem isUnit_prime_of_ringHom {R : Type*} [CommRing R] (f : S →+* R) (q : ℕ) (hq : q.Prime)
    (hqp : ¬ q ∣ p) : IsUnit (q : R) := by
  simpa only [map_natCast] using (isUnit_prime_of_isLocalization p S q hq hqp).map f

/-- Ring homomorphisms out of a localization `S` of `LazardRing` at `coprimeSubmonoid p` are
determined by the base change of `formalGroup.map (algebraMap LazardRing S)` along them. -/
theorem localizedHom_ext {S : Type*} [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] {R : Type*} [CommRing R] {f g : S →+* R}
    (h : (formalGroup.map (algebraMap LazardRing S)).map f =
      (formalGroup.map (algebraMap LazardRing S)).map g) : f = g := by
  refine IsLocalization.ringHom_ext (coprimeSubmonoid p) (hom_ext ?_)
  rwa [← FormalGroup.map_comp, ← FormalGroup.map_comp]

private theorem isUnit_lift_of_mem_coprimeSubmonoid {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R))
    (F : {F : FormalGroup R // F.IsComm}) (m : coprimeSubmonoid p) :
    IsUnit (lift F m) := by
  rcases m with ⟨m, hm⟩
  induction hm using Submonoid.closure_induction with
  | mem _ hx =>
    obtain ⟨q, ⟨hq, hqp⟩, rfl⟩ := hx
    simpa only [map_natCast] using hunit q hq hqp
  | one => simpa only [map_one] using isUnit_one
  | mul _ _ _ _ ha hb => simpa only [map_mul] using ha.mul hb

/-- **Universal property of the localized Lazard ring**: for any commutative ring `R` in which
every prime `q` not dividing `p` is invertible, commutative formal group laws over `R` correspond
bijectively to ring homomorphisms `S →+* R`. -/
def localizedLift {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R)) :
    {F : FormalGroup R // F.IsComm} ≃ (S →+* R) where
  toFun F := IsLocalization.lift (M := coprimeSubmonoid p)
    (isUnit_lift_of_mem_coprimeSubmonoid p hunit F)
  invFun f := ⟨(formalGroup.map (algebraMap LazardRing S)).map f, inferInstance⟩
  left_inv F := Subtype.ext <| by
    dsimp only
    rw [FormalGroup.map_comp, IsLocalization.lift_comp (M := coprimeSubmonoid p) (S := S), map_lift]
  right_inv f := localizedHom_ext p <| by
    dsimp only
    rw [FormalGroup.map_comp, IsLocalization.lift_comp (M := coprimeSubmonoid p) (S := S), map_lift]

/-- `localizedLift` restricts along `algebraMap LazardRing S` to `LazardRing.lift`. -/
@[simp]
theorem localizedLift_comp_algebraMap {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R))
    (F : {F : FormalGroup R // F.IsComm}) :
    (localizedLift p S hunit F).comp (algebraMap LazardRing S) = lift F := by
  rw [localizedLift, Equiv.coe_fn_mk]
  exact IsLocalization.lift_comp (M := coprimeSubmonoid p) (S := S) _

/-- On elements from `LazardRing`, `localizedLift` agrees with `LazardRing.lift`. -/
@[simp]
theorem localizedLift_algebraMap {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R))
    (F : {F : FormalGroup R // F.IsComm}) (x : LazardRing) :
    localizedLift p S hunit F (algebraMap LazardRing S x) = lift F x :=
  RingHom.congr_fun (localizedLift_comp_algebraMap p S hunit F) x

/-- The universal formal group law over `S` base-changes along `localizedLift p S hunit F` to
`F`. -/
theorem map_localizedLift {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R))
    (F : {F : FormalGroup R // F.IsComm}) :
    (formalGroup.map (algebraMap LazardRing S)).map (localizedLift p S hunit F) = F.1 := by
  rw [FormalGroup.map_comp, localizedLift_comp_algebraMap, map_lift]

/-- The formal group law classified by `f : S →+* R` is the base change of
`formalGroup.map (algebraMap LazardRing S)` along `f`. -/
@[simp]
theorem coe_localizedLift_symm {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R)) (f : S →+* R) :
    ((localizedLift p S hunit).symm f).1 = (formalGroup.map (algebraMap LazardRing S)).map f := by
  rw [localizedLift]
  rfl

/-! ### Quillen's `p`-typicalization idempotent and its fixed subring -/

/-- **Quillen's `p`-typicalization idempotent** `e_p : S →+* S` on any localization `S` of the
Lazard ring at `coprimeSubmonoid p`: the ring endomorphism classifying Cartier's canonical
`p`-typicalization of `formalGroup.map (algebraMap LazardRing S)`. -/
def typicalIdempotent : S →+* S :=
  localizedLift p S (isUnit_prime_of_isLocalization p S)
    ⟨(formalGroup.map (algebraMap LazardRing S)).typicalize p
      (isUnit_prime_of_isLocalization p S), inferInstance⟩

/-- Base-changing `formalGroup.map (algebraMap LazardRing S)` along `typicalIdempotent p S` yields
its canonical `p`-typicalization. -/
theorem map_typicalIdempotent :
    (formalGroup.map (algebraMap LazardRing S)).map (typicalIdempotent p S) =
      (formalGroup.map (algebraMap LazardRing S)).typicalize p
        (isUnit_prime_of_isLocalization p S) :=
  map_localizedLift p S _ _

/-- Restricting `typicalIdempotent p S` along `algebraMap LazardRing S` classifies the
`p`-typicalization of `formalGroup.map (algebraMap LazardRing S)`. -/
@[simp]
theorem typicalIdempotent_comp_algebraMap :
    (typicalIdempotent p S).comp (algebraMap LazardRing S) =
      lift ⟨(formalGroup.map (algebraMap LazardRing S)).typicalize p
        (isUnit_prime_of_isLocalization p S), inferInstance⟩ :=
  localizedLift_comp_algebraMap p S _ _

/-- The formal group law classified by `typicalIdempotent p S` is `p`-typical. -/
theorem isTypical_map_typicalIdempotent :
    ((formalGroup.map (algebraMap LazardRing S)).map (typicalIdempotent p S)).IsTypical p := by
  rw [FormalGroup.isTypical_congr (map_typicalIdempotent p S)]
  exact (formalGroup.map (algebraMap LazardRing S)).isTypical_typicalize p _

/-- Precomposing the classifying map of `F` with `typicalIdempotent p S` classifies Cartier's
`p`-typicalization `F.typicalize p hunit`. -/
theorem localizedLift_comp_typicalIdempotent {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R))
    (F : FormalGroup R) [F.IsComm] :
    (localizedLift p S hunit ⟨F, inferInstance⟩).comp (typicalIdempotent p S) =
      localizedLift p S hunit ⟨F.typicalize p hunit, inferInstance⟩ :=
  localizedHom_ext p <| by
    rw [← FormalGroup.map_comp, map_typicalIdempotent,
      (formalGroup.map (algebraMap LazardRing S)).map_typicalize _ p _ hunit,
      FormalGroup.typicalize_congr (map_localizedLift p S hunit ⟨F, inferInstance⟩) p hunit,
      map_localizedLift]

/-- A ring homomorphism `f : S →+* R` is invariant under precomposition with
`typicalIdempotent p S` if and only if the formal group law it classifies is `p`-typical. -/
@[simp]
theorem comp_typicalIdempotent_eq_self_iff {R : Type*} [CommRing R] (f : S →+* R) :
    f.comp (typicalIdempotent p S) = f ↔
      ((formalGroup.map (algebraMap LazardRing S)).map f).IsTypical p := by
  have hunit := isUnit_prime_of_ringHom p S f
  rw [← (localizedLift p S hunit).symm.injective.eq_iff, Subtype.ext_iff, coe_localizedLift_symm,
    coe_localizedLift_symm, ← FormalGroup.map_comp, map_typicalIdempotent,
    (formalGroup.map (algebraMap LazardRing S)).map_typicalize f p _ hunit,
    FormalGroup.typicalize_eq_self_iff]

/-- **Quillen's `p`-typicalization endomorphism is idempotent.** -/
@[simp]
theorem typicalIdempotent_comp_typicalIdempotent :
    (typicalIdempotent p S).comp (typicalIdempotent p S) = typicalIdempotent p S :=
  (comp_typicalIdempotent_eq_self_iff p S (typicalIdempotent p S)).mpr
    (isTypical_map_typicalIdempotent p S)

/-- Evaluating `typicalIdempotent p S` twice is the same as evaluating it once. -/
@[simp]
theorem typicalIdempotent_apply_typicalIdempotent (x : S) :
    typicalIdempotent p S (typicalIdempotent p S x) = typicalIdempotent p S x :=
  RingHom.congr_fun (typicalIdempotent_comp_typicalIdempotent p S) x

/-- An element of `S` is fixed by `typicalIdempotent p S` iff it lies in
`(typicalIdempotent p S).range`. -/
theorem typicalIdempotent_eq_self_iff_mem_range {x : S} :
    typicalIdempotent p S x = x ↔ x ∈ (typicalIdempotent p S).range :=
  ⟨fun hx ↦ ⟨x, hx⟩, fun ⟨y, hy⟩ ↦ hy ▸ typicalIdempotent_apply_typicalIdempotent p S y⟩

/-- `(typicalIdempotent p S).rangeRestrict` is a retraction of the subtype inclusion of
`(typicalIdempotent p S).range`. -/
@[simp]
theorem typicalIdempotent_rangeRestrict_comp_subtype :
    (typicalIdempotent p S).rangeRestrict.comp (typicalIdempotent p S).range.subtype =
      RingHom.id (typicalIdempotent p S).range := by
  ext ⟨_, ⟨y, rfl⟩⟩
  exact typicalIdempotent_apply_typicalIdempotent p S y

private theorem typicalIdempotent_subtype_comp_rangeRestrict :
    (typicalIdempotent p S).range.subtype.comp (typicalIdempotent p S).rangeRestrict =
      typicalIdempotent p S :=
  RingHom.ext (RingHom.coe_rangeRestrict (typicalIdempotent p S))

/-- The **universal `p`-typical formal group law** over the fixed subring
`(typicalIdempotent p S).range`, obtained by base-changing
`formalGroup.map (algebraMap LazardRing S)` along `(typicalIdempotent p S).rangeRestrict`. -/
def typicalFormalGroup : FormalGroup (typicalIdempotent p S).range :=
  (formalGroup.map (algebraMap LazardRing S)).map (typicalIdempotent p S).rangeRestrict

/-- Unfold `typicalFormalGroup p S` as the base change along
`(typicalIdempotent p S).rangeRestrict`. -/
theorem typicalFormalGroup_def :
    typicalFormalGroup p S =
      (formalGroup.map (algebraMap LazardRing S)).map (typicalIdempotent p S).rangeRestrict :=
  (rfl)

instance : (typicalFormalGroup p S).IsComm :=
  inferInstanceAs
    (((formalGroup.map (algebraMap LazardRing S)).map (typicalIdempotent p S).rangeRestrict).IsComm)

/-- Extending `typicalFormalGroup p S` from `(typicalIdempotent p S).range` back to `S` gives
`(formalGroup.map (algebraMap LazardRing S)).typicalize p _`. -/
@[simp]
theorem map_subtype_typicalFormalGroup :
    (typicalFormalGroup p S).map (typicalIdempotent p S).range.subtype =
      (formalGroup.map (algebraMap LazardRing S)).typicalize p
        (isUnit_prime_of_isLocalization p S) := by
  rw [typicalFormalGroup_def, FormalGroup.map_comp, typicalIdempotent_subtype_comp_rangeRestrict,
    map_typicalIdempotent]

/-- The formal group law `typicalFormalGroup p S` over `(typicalIdempotent p S).range` is
`p`-typical. -/
@[simp]
theorem isTypical_typicalFormalGroup : (typicalFormalGroup p S).IsTypical p := by
  rw [← (typicalFormalGroup p S).isTypical_map_iff_of_injective
      (φ := (typicalIdempotent p S).range.subtype) Subtype.val_injective,
    FormalGroup.isTypical_congr (map_subtype_typicalFormalGroup p S)]
  exact (formalGroup.map (algebraMap LazardRing S)).isTypical_typicalize p _

/-- **Universal property of the fixed subring `(typicalIdempotent p S).range`**: for any commutative
ring `R` in which every prime `q` not dividing `p` is invertible, `p`-typical commutative formal
group laws over `R` correspond bijectively to ring homomorphisms
`(typicalIdempotent p S).range →+* R`. -/
def typicalLocalizedLift {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R)) :
    {F : FormalGroup R // ∃ (_ : F.IsComm), F.IsTypical p} ≃
      ((typicalIdempotent p S).range →+* R) where
  toFun F := (localizedLift p S hunit ⟨F.1, F.2.1⟩).comp (typicalIdempotent p S).range.subtype
  invFun g :=
    ⟨(typicalFormalGroup p S).map g,
      ⟨inferInstance, (isTypical_typicalFormalGroup p S).map g⟩⟩
  left_inv F := Subtype.ext <| by
    dsimp only
    have : F.1.IsComm := F.2.1
    rw [← FormalGroup.map_comp, map_subtype_typicalFormalGroup,
      (formalGroup.map (algebraMap LazardRing S)).map_typicalize _ p _ hunit,
      FormalGroup.typicalize_congr (map_localizedLift p S hunit ⟨F.1, F.2.1⟩) p hunit,
      F.1.typicalize_eq_self p hunit F.2.2]
  right_inv g := by
    dsimp only
    have hg : localizedLift p S hunit ⟨(typicalFormalGroup p S).map g, inferInstance⟩ =
        g.comp (typicalIdempotent p S).rangeRestrict :=
      localizedHom_ext p <| by
        rw [map_localizedLift]
        dsimp only
        rw [typicalFormalGroup_def, FormalGroup.map_comp]
    rw [hg, RingHom.comp_assoc, typicalIdempotent_rangeRestrict_comp_subtype, RingHom.comp_id]

/-- Base-changing `typicalFormalGroup p S` along `typicalLocalizedLift p S hunit F` recovers `F`. -/
@[simp]
theorem map_typicalLocalizedLift {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R))
    (F : {F : FormalGroup R // ∃ (_ : F.IsComm), F.IsTypical p}) :
    (typicalFormalGroup p S).map (typicalLocalizedLift p S hunit F) = F.1 := by
  have h := congrArg Subtype.val ((typicalLocalizedLift p S hunit).left_inv F)
  rw [typicalLocalizedLift] at h ⊢
  exact h

/-- Extending `typicalLocalizedLift p S hunit F` along `(typicalIdempotent p S).rangeRestrict`
recovers the classifying map `localizedLift p S hunit ⟨F.1, F.2.1⟩` on `S`. -/
@[simp]
theorem typicalLocalizedLift_comp_rangeRestrict {R : Type*} [CommRing R]
    (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R))
    (F : {F : FormalGroup R // ∃ (_ : F.IsComm), F.IsTypical p}) :
    (typicalLocalizedLift p S hunit F).comp (typicalIdempotent p S).rangeRestrict =
      localizedLift p S hunit ⟨F.1, F.2.1⟩ := by
  have : F.1.IsComm := F.2.1
  rw [typicalLocalizedLift, Equiv.coe_fn_mk, RingHom.comp_assoc,
    typicalIdempotent_subtype_comp_rangeRestrict, (comp_typicalIdempotent_eq_self_iff p S _).mpr]
  rw [FormalGroup.isTypical_congr (map_localizedLift p S hunit ⟨F.1, F.2.1⟩)]
  exact F.2.2

/-! ### Compatibility with `(L, L[b₁, b₂, …])` and with grading -/

/-- The ring homomorphism `L[b₁, b₂, …] →+* S` classifying the universal formal group law over `S`
together with the inverse of its canonical Cartier typical coordinate. -/
def typicalCoordinateHom : MvPolynomial ℕ+ LazardRing →+* S :=
  coordinateChangeLift
    (⟨formalGroup.map (algebraMap LazardRing S), inferInstance⟩,
      ⟨((formalGroup.map (algebraMap LazardRing S)).typicalCoordinate p
        (isUnit_prime_of_isLocalization p S))⁻¹,
        (formalGroup.map (algebraMap LazardRing S)).inv_typicalCoordinate_mem_ker_linearCoeff p _⟩)

/-- Along the left unit `η_L = C`, `typicalCoordinateHom p S` restricts to
`algebraMap LazardRing S`. -/
@[simp]
theorem typicalCoordinateHom_comp_C :
    (typicalCoordinateHom p S).comp C = algebraMap LazardRing S := by
  rw [typicalCoordinateHom]
  refine (coordinateChangeLift_comp_C _).trans (hom_ext ?_)
  exact map_lift _

/-- Along the right unit `η_R`, `typicalCoordinateHom p S` restricts to
`typicalIdempotent p S ∘ algebraMap LazardRing S`. -/
@[simp]
theorem typicalCoordinateHom_comp_rightUnit :
    (typicalCoordinateHom p S).comp rightUnit =
      (typicalIdempotent p S).comp (algebraMap LazardRing S) := by
  rw [typicalCoordinateHom]
  refine (coordinateChangeLift_comp_rightUnit _).trans ?_
  rw [typicalIdempotent_comp_algebraMap]
  refine hom_ext ?_
  rw [map_lift, map_lift]
  exact ((formalGroup.map (algebraMap LazardRing S)).typicalize_def p _).symm

/-- **Quillen's `p`-typicalization idempotent preserves homogeneous degrees**: for any `ℕ`-grading
`ℬ` on `S` such that `algebraMap LazardRing S` maps `grading k` into `ℬ k`, `typicalIdempotent p S`
maps each `ℬ k` into `ℬ k`. -/
theorem typicalIdempotent_mem_graded {τ : Type*} [SetLike τ S] [AddSubgroupClass τ S]
    {ℬ : ℕ → τ} [GradedRing ℬ]
    (halg : ∀ ⦃k : ℕ⦄ ⦃x : LazardRing⦄, x ∈ grading k → algebraMap LazardRing S x ∈ ℬ k)
    {k : ℕ} {b : S} (hb : b ∈ ℬ k) : typicalIdempotent p S b ∈ ℬ k := by
  let f : grading →+*ᵍ ℬ :=
    { toRingHom := algebraMap LazardRing S
      map_mem := fun hx ↦ halg hx }
  have halg_inst : f.toRingHom.toAlgebra = ‹Algebra LazardRing S› :=
    Algebra.algebra_ext _ _ fun _ ↦ rfl
  have hloc : letI := f.toRingHom.toAlgebra; IsLocalization (coprimeSubmonoid p) S :=
    halg_inst.symm ▸ ‹IsLocalization (coprimeSubmonoid p) S›
  obtain ⟨a, ha, m, hbm⟩ :=
    f.exists_mem_mul_eq_of_isLocalization hloc (fun _ hm ↦ coprimeSubmonoid_le_grading_zero p hm) hb
  have hm_fix : typicalIdempotent p S (algebraMap LazardRing S m) = algebraMap LazardRing S m := by
    obtain ⟨n, hn⟩ := exists_natCast_of_mem_coprimeSubmonoid m.2
    rw [← hn, map_natCast, map_natCast]
  have hcoeff : ∀ d : Fin 2 →₀ ℕ,
      MvPowerSeries.coeff d (formalGroup.map (algebraMap LazardRing S)).toPowerSeries ∈
        ℬ (2 * (d.degree - 1)) :=
    (lift_mem_iff (.id ℕ) ⟨formalGroup.map (algebraMap LazardRing S), inferInstance⟩).mp
      fun _ _ hx ↦ by
        have halg_eq : lift ⟨formalGroup.map (algebraMap LazardRing S), inferInstance⟩ =
            algebraMap LazardRing S := hom_ext (map_lift _)
        rw [halg_eq]
        exact halg hx
  have ha' : typicalIdempotent p S (algebraMap LazardRing S a) ∈ ℬ k := by
    rw [← RingHom.comp_apply, typicalIdempotent_comp_algebraMap]
    exact (lift_mem_iff (.id ℕ) _).mpr
      ((formalGroup.map (algebraMap LazardRing S)).coeff_typicalize_mem 2 p _ hcoeff) ha
  have hmul : typicalIdempotent p S b * algebraMap LazardRing S m ∈ ℬ k := by
    rw [← hm_fix, ← map_mul]
    exact hbm ▸ ha'
  have hu0 : algebraMap LazardRing S m ∈ ℬ 0 :=
    halg (coprimeSubmonoid_le_grading_zero p m.2)
  have hdecomp : (DirectSum.decompose ℬ (typicalIdempotent p S b) k : S) *
      algebraMap LazardRing S m = typicalIdempotent p S b * algebraMap LazardRing S m := by
    rw [← DirectSum.coe_decompose_mul_of_right_mem_zero ℬ hu0,
      DirectSum.decompose_of_mem_same ℬ hmul]
  have hcancel := (IsLocalization.map_units S m).mul_right_cancel hdecomp
  rw [← hcancel]
  exact (DirectSum.decompose ℬ (typicalIdempotent p S b) k).2

/-- Quillen's `p`-typicalization idempotent bundled as a graded ring endomorphism `ℬ →+*ᵍ ℬ` on any
compatibly `ℕ`-graded localization `S` of `LazardRing` at `coprimeSubmonoid p`. -/
def gradedTypicalIdempotent {τ : Type*} [SetLike τ S] [AddSubgroupClass τ S]
    {ℬ : ℕ → τ} [GradedRing ℬ]
    (halg : ∀ ⦃k : ℕ⦄ ⦃x : LazardRing⦄, x ∈ grading k → algebraMap LazardRing S x ∈ ℬ k) :
    ℬ →+*ᵍ ℬ where
  toRingHom := typicalIdempotent p S
  map_mem hx := typicalIdempotent_mem_graded p S halg hx

/-- The underlying ring homomorphism of `gradedTypicalIdempotent p S halg` is
`typicalIdempotent p S`. -/
@[simp]
theorem toRingHom_gradedTypicalIdempotent {τ : Type*} [SetLike τ S] [AddSubgroupClass τ S]
    {ℬ : ℕ → τ} [GradedRing ℬ]
    (halg : ∀ ⦃k : ℕ⦄ ⦃x : LazardRing⦄, x ∈ grading k → algebraMap LazardRing S x ∈ ℬ k) :
    (gradedTypicalIdempotent p S halg).toRingHom = typicalIdempotent p S :=
  (rfl)

/-- `gradedTypicalIdempotent p S halg` is idempotent as a graded ring endomorphism. -/
@[simp]
theorem gradedTypicalIdempotent_comp_self {τ : Type*} [SetLike τ S] [AddSubgroupClass τ S]
    {ℬ : ℕ → τ} [GradedRing ℬ]
    (halg : ∀ ⦃k : ℕ⦄ ⦃x : LazardRing⦄, x ∈ grading k → algebraMap LazardRing S x ∈ ℬ k) :
    (gradedTypicalIdempotent p S halg).comp (gradedTypicalIdempotent p S halg) =
      gradedTypicalIdempotent p S halg :=
  GradedRingHom.ext fun x ↦ typicalIdempotent_apply_typicalIdempotent p S x

end Localization

