module

public import TauCeti.RingTheory.FormalGroup.CoordinateChange.HopfAlgebroid
public import TauCeti.RingTheory.FormalGroup.ExponentTwo.CoordinateChange

/-!
# The exponent-two ring as an invariant quotient of the Lazard ring

The universal formal group law of exponent two over `MO = ExponentTwoLazardRing` is commutative,
so it is classified by a ring homomorphism `π : L →+* MO` out of the Lazard ring
(`TauCeti.ExponentTwoLazardRing.ofLazardRing`). A homomorphism `f : L →+* R` factors through `π`
exactly when the formal group law it classifies has exponent two. This identifies `MO` with the
quotient of `L` by the coefficients of the `2`-series `[2](X)` of the universal formal group law:
`π` is surjective and its kernel is generated by those coefficients.

The quotient is compatible with strict coordinate changes. The homomorphism
`MvPolynomial.map π : L[b₁, b₂, …] →+* MO[b₁, b₂, …]` carries the universal strict coordinate to the
universal strict coordinate, and intertwines the left units, the right units and the counits of the
Hopf algebroids `(L, L[b₁, b₂, …])` and `(MO, MO[b₁, b₂, …])`. Consequently the kernel `I` of `π` is
an **invariant ideal** of `(L, L[b₁, b₂, …])`: its extensions along the left and the right unit
agree, `η_R(I) Γ = η_L(I) Γ` for `Γ = L[b₁, b₂, …]`. This is the condition under which the
structure maps of `(L, Γ)` descend to `(L/I, Γ/IΓ)`, and `Γ/IΓ = (L/I)[b₁, b₂, …]` is
`MO[b₁, b₂, …]`.

## Main definitions

* `TauCeti.ExponentTwoLazardRing.ofLazardRing`: the homomorphism `L →+* MO` classifying the
  universal formal group law of exponent two.

## Main results

* `TauCeti.ExponentTwoLazardRing.lift_comp_ofLazardRing`: a homomorphism out of `L` classifying a
  law of exponent two factors through `ofLazardRing`.
* `TauCeti.ExponentTwoLazardRing.ofLazardRing_surjective`,
  `TauCeti.ExponentTwoLazardRing.ker_ofLazardRing`: `MO` is the quotient of `L` by the ideal
  generated by the coefficients of the `2`-series of the universal formal group law.
* `TauCeti.ExponentTwoLazardRing.map_ofLazardRing_comp_rightUnit`,
  `TauCeti.ExponentTwoLazardRing.counit_comp_map_ofLazardRing`: `π` is compatible with the right
  units and the counits.
* `TauCeti.ExponentTwoLazardRing.map_rightUnit_ker_ofLazardRing`: the kernel of `π` is an
  invariant ideal of `(L, L[b₁, b₂, …])`.

## References

* D. Quillen, *On the formal group laws of unoriented and complex cobordism theory*, Bull. Amer.
  Math. Soc. 75 (1969).
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres*, Appendix A1.1
  (invariant ideals of Hopf algebroids) and A2.1.
-/

public section

noncomputable section

namespace TauCeti

namespace ExponentTwoLazardRing

variable {R : Type*} [CommRing R]

open MvPolynomial

/-- The homomorphism `π : L →+* MO` from the Lazard ring classifying the universal formal group law
of exponent two as a commutative formal group law. -/
def ofLazardRing : LazardRing →+* ExponentTwoLazardRing :=
  LazardRing.lift ⟨formalGroup, inferInstance⟩

/-- The universal formal group law of the Lazard ring base-changes along `ofLazardRing` to the
universal formal group law of exponent two. -/
@[simp]
theorem map_ofLazardRing : LazardRing.formalGroup.map ofLazardRing = formalGroup :=
  LazardRing.map_lift _

/-- **Homomorphisms out of `L` classifying laws of exponent two factor through `MO`**: if the
formal group law classified by `f : L →+* R` has exponent two, then `f` is `ofLazardRing`
followed by the homomorphism `MO →+* R` classifying that law. -/
theorem lift_comp_ofLazardRing (f : LazardRing →+* R)
    (hf : (LazardRing.formalGroup.map f).nsmulSeries 2 = 0) :
    (lift ⟨LazardRing.formalGroup.map f, inferInstance, hf⟩).comp ofLazardRing = f :=
  LazardRing.hom_ext <| by rw [← FormalGroup.map_comp, map_ofLazardRing, map_lift]

/-- **`MO` is a quotient of the Lazard ring**: the homomorphism `ofLazardRing : L →+* MO` is
surjective. -/
theorem ofLazardRing_surjective : Function.Surjective ofLazardRing := by
  -- The universal law of exponent two is the base change of a law of exponent two over the range
  -- `S` of `ofLazardRing`, so the identity of `MO` factors through `S`.
  let S := ofLazardRing.range
  have hS : S.subtype.comp ofLazardRing.rangeRestrict = ofLazardRing :=
    RingHom.ext (RingHom.coe_rangeRestrict ofLazardRing)
  have hF :
      (LazardRing.formalGroup.map ofLazardRing.rangeRestrict).map S.subtype = formalGroup := by
    rw [FormalGroup.map_comp, hS, map_ofLazardRing]
  have h2 : (LazardRing.formalGroup.map ofLazardRing.rangeRestrict).nsmulSeries 2 = 0 := by
    refine PowerSeries.map_injective S.subtype Subtype.val_injective ?_
    rw [FormalGroup.map_nsmulSeries, hF, nsmulSeries_two_formalGroup, map_zero]
  have hs : S.subtype.comp (lift ⟨_, inferInstance, h2⟩) = RingHom.id _ :=
    hom_ext <| by rw [← FormalGroup.map_comp, map_lift, hF, FormalGroup.map_id]
  intro x
  obtain ⟨y, hy⟩ := (lift ⟨_, inferInstance, h2⟩ x).2
  exact ⟨y, hy.trans (RingHom.congr_fun hs x)⟩

/-- **`MO` is the quotient of the Lazard ring by the `2`-series**: the kernel of
`ofLazardRing : L →+* MO` is the ideal generated by the coefficients of `[2](X)` for the universal
formal group law over `L`. -/
theorem ker_ofLazardRing : RingHom.ker ofLazardRing =
    Ideal.span
      (Set.range fun n : ℕ ↦ PowerSeries.coeff n (LazardRing.formalGroup.nsmulSeries 2)) := by
  set J := Ideal.span (Set.range fun n : ℕ ↦
    PowerSeries.coeff n (LazardRing.formalGroup.nsmulSeries 2))
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.span_le.mpr ?_)
  · -- The quotient map `L → L / J` classifies a law of exponent two, so it factors through `MO`.
    have hJ : (LazardRing.formalGroup.map (Ideal.Quotient.mk J)).nsmulSeries 2 = 0 := by
      ext n
      rw [← FormalGroup.map_nsmulSeries, PowerSeries.coeff_map, map_zero,
        Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span ⟨n, rfl⟩
    rw [← Ideal.mk_ker (I := J), RingHom.mem_ker, ← lift_comp_ofLazardRing _ hJ,
      RingHom.comp_apply, RingHom.mem_ker.mp hx, map_zero]
  · rintro _ ⟨n, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, ← PowerSeries.coeff_map, FormalGroup.map_nsmulSeries,
      map_ofLazardRing, nsmulSeries_two_formalGroup, map_zero]

/-- **`ofLazardRing` is compatible with the right units**: changing the coordinate of a law of
exponent two by a strict coordinate gives the same law in `(L, L[b₁, b₂, …])` and in
`(MO, MO[b₁, b₂, …])`. -/
theorem map_ofLazardRing_comp_rightUnit :
    (map ofLazardRing).comp LazardRing.rightUnit = rightUnit.comp ofLazardRing :=
  LazardRing.hom_ext <| by
    rw [LazardRing.map_comp_rightUnit, FormalCoordinate.map_map_universalStrictCoordinate,
      map_comp_C, ← FormalGroup.map_comp, ← FormalGroup.map_comp, map_ofLazardRing, map_rightUnit]

/-- `MvPolynomial.map ofLazardRing` agrees with `ofLazardRing` on the image of the right unit. -/
@[simp]
theorem map_ofLazardRing_rightUnit (r : LazardRing) :
    map ofLazardRing (LazardRing.rightUnit r) = rightUnit (ofLazardRing r) :=
  RingHom.congr_fun map_ofLazardRing_comp_rightUnit r

/-- **`ofLazardRing` is compatible with the counits.** -/
theorem counit_comp_map_ofLazardRing :
    counit.comp (map ofLazardRing) = ofLazardRing.comp LazardRing.counit :=
  ringHom_ext' (RingHom.ext fun r ↦ by simp) fun i ↦ by simp

/-- The counit of `MO[b₁, b₂, …]` after `MvPolynomial.map ofLazardRing` is `ofLazardRing` after the
counit of `L[b₁, b₂, …]`. -/
@[simp]
theorem counit_map_ofLazardRing (x : MvPolynomial ℕ+ LazardRing) :
    counit (map ofLazardRing x) = ofLazardRing (LazardRing.counit x) :=
  RingHom.congr_fun counit_comp_map_ofLazardRing x

/-- **The kernel of `L → MO` is an invariant ideal** of the Hopf algebroid `(L, L[b₁, b₂, …])`:
its extensions to `L[b₁, b₂, …]` along the right unit `η_R` and the left unit `η_L = C` agree. -/
theorem map_rightUnit_ker_ofLazardRing :
    (RingHom.ker ofLazardRing).map LazardRing.rightUnit = (RingHom.ker ofLazardRing).map C := by
  have h : (RingHom.ker ofLazardRing).map LazardRing.rightUnit ≤
      (RingHom.ker ofLazardRing).map C := by
    rw [← ker_map, Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.mem_ker, map_ofLazardRing_rightUnit, RingHom.mem_ker.mp hx,
      map_zero]
  -- The conjugation exchanges the two units, so applying it to `h` gives the reverse inclusion.
  refine le_antisymm h ?_
  have h' := Ideal.map_mono (f := LazardRing.conjugation) h
  rwa [Ideal.map_map, Ideal.map_map, LazardRing.conjugation_comp_rightUnit,
    LazardRing.conjugation_comp_C] at h'

end ExponentTwoLazardRing

end TauCeti
