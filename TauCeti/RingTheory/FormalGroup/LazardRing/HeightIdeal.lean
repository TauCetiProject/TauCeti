noncomputable section

open RingTheory.Sequence Pointwise

namespace TauCeti.LazardRing

/-! ### Homogeneity and properness -/

/-- Every height ideal `I_n` of the universal formal group law on the Lazard ring is homogeneous:
each coefficient of `[p](X)` is homogeneous of even degree. -/
theorem isHomogeneous_heightIdeal (p n : ℕ) :
    (formalGroup.heightIdeal p n).IsHomogeneous grading := by
  rw [FormalGroup.heightIdeal_def]
  refine Ideal.homogeneous_span grading _ ?_
  rintro _ ⟨k, -, rfl⟩
  exact ⟨2 * (k - 1), coeff_nsmulSeries_mem_grading p k⟩

/-- The supremum `⨆ n, I_n` of the height ideals of the universal formal group law is
homogeneous. -/
theorem isHomogeneous_iSup_heightIdeal (p : ℕ) :
    (⨆ n, formalGroup.heightIdeal p n).IsHomogeneous grading :=
  Ideal.IsHomogeneous.iSup (isHomogeneous_heightIdeal p)

/-- For `1 < p`, the supremum `⨆ n, I_n` of the height ideals on the Lazard ring is a proper ideal:
augmenting to `ℤ` and reducing modulo `p` sends the universal law to `𝔾ₐ` over `ZMod p`, whose
`p`-series vanishes. -/
theorem iSup_heightIdeal_ne_top {p : ℕ} (hp : 1 < p) :
    ⨆ n, formalGroup.heightIdeal p n ≠ ⊤ := by
  have : Fact (1 < p) := ⟨hp⟩
  let φ : LazardRing →+* ZMod p := (Int.castRingHom (ZMod p)).comp augmentation
  have hle : ⨆ n, formalGroup.heightIdeal p n ≤ RingHom.ker φ := by
    rw [FormalGroup.iSup_heightIdeal_le_ker_iff hp, ← FormalGroup.map_comp, map_augmentation]
    simp [FormalGroup.nsmulSeries_𝔾ₐ, ← map_natCast PowerSeries.C]
  exact ne_top_of_le_ne_top (RingHom.ker_ne_top φ) hle

/-- For `1 < p`, every height ideal `I_n` on the Lazard ring is proper. -/
theorem heightIdeal_ne_top {p : ℕ} (hp : 1 < p) (n : ℕ) :
    formalGroup.heightIdeal p n ≠ ⊤ :=
  ne_top_of_le_ne_top (iSup_heightIdeal_ne_top hp) (le_iSup (formalGroup.heightIdeal p) n)

/-! ### Reduction modulo `p` -/

/-- The surjective ring homomorphism `L →+* (ZMod p)[x₁, x₂, …]` reducing coefficients modulo `p`
under Lazard's isomorphism `L ≃ₐ[ℤ] ℤ[x₁, x₂, …]`. -/
def modPMvPolynomialHom (p : ℕ) : LazardRing →+* MvPolynomial ℕ+ (ZMod p) :=
  (MvPolynomial.map (Int.castRingHom (ZMod p))).comp mvPolynomialEquiv.symm.toRingEquiv.toRingHom

@[simp]
theorem modPMvPolynomialHom_mvPolynomialEquiv (p : ℕ) (q : MvPolynomial ℕ+ ℤ) :
    modPMvPolynomialHom p (mvPolynomialEquiv q) =
      MvPolynomial.map (Int.castRingHom (ZMod p)) q := by
  simp [modPMvPolynomialHom]

@[simp]
theorem modPMvPolynomialHom_generator (p : ℕ) (n : ℕ+) :
    modPMvPolynomialHom p (generator n) = MvPolynomial.X n := by
  simp [modPMvPolynomialHom]

/-- `modPMvPolynomialHom p` is surjective for every `p : ℕ`. -/
theorem surjective_modPMvPolynomialHom (p : ℕ) :
    Function.Surjective (modPMvPolynomialHom p) :=
  (MvPolynomial.map_surjective _ ZMod.intCast_surjective).comp mvPolynomialEquiv.symm.surjective

/-- The kernel of `modPMvPolynomialHom p` is the principal ideal `(p)` of the Lazard ring. -/
theorem ker_modPMvPolynomialHom (p : ℕ) :
    RingHom.ker (modPMvPolynomialHom p) = Ideal.span {(p : LazardRing)} := by
  rw [modPMvPolynomialHom, ← RingHom.comap_ker, MvPolynomial.ker_map, ZMod.ker_intCastRingHom,
    Ideal.map_span, Set.image_singleton, map_natCast]
  ext x
  simp only [Ideal.mem_comap, Ideal.mem_span_singleton]
  exact ⟨fun ⟨q, hq⟩ ↦ ⟨mvPolynomialEquiv q, by
      simpa using congrArg mvPolynomialEquiv hq⟩,
    fun ⟨y, hy⟩ ↦ ⟨mvPolynomialEquiv.symm y, by simp [hy]⟩⟩

/-- Quotienting the Lazard ring by `(p)` yields the polynomial ring `(ZMod p)[x₁, x₂, …]`. -/
def quotientSpanNatCastEquiv (p : ℕ) :
    (LazardRing ⧸ Ideal.span {(p : LazardRing)}) ≃+* MvPolynomial ℕ+ (ZMod p) :=
  (Ideal.quotEquivOfEq (ker_modPMvPolynomialHom p).symm).trans
    (RingHom.quotientKerEquivOfSurjective (surjective_modPMvPolynomialHom p))

@[simp]
theorem quotientSpanNatCastEquiv_mk (p : ℕ) (x : LazardRing) :
    quotientSpanNatCastEquiv p (Ideal.Quotient.mk _ x) = modPMvPolynomialHom p x :=
  (rfl)

@[simp]
theorem quotientSpanNatCastEquiv_symm_X (p : ℕ) (n : ℕ+) :
    (quotientSpanNatCastEquiv p).symm (MvPolynomial.X n) = Ideal.Quotient.mk _ (generator n) := by
  apply (quotientSpanNatCastEquiv p).injective
  simp

/-- For a prime `p`, `L ⧸ I₁ ≃+* (ZMod p)[x₁, x₂, …]`. -/
def quotientHeightIdealOneEquiv {p : ℕ} (hp : p.Prime) :
    (LazardRing ⧸ formalGroup.heightIdeal p 1) ≃+* MvPolynomial ℕ+ (ZMod p) :=
  (Ideal.quotEquivOfEq (formalGroup.heightIdeal_one hp)).trans (quotientSpanNatCastEquiv p)

@[simp]
theorem quotientHeightIdealOneEquiv_mk {p : ℕ} (hp : p.Prime) (x : LazardRing) :
    quotientHeightIdealOneEquiv hp (Ideal.Quotient.mk _ x) = modPMvPolynomialHom p x :=
  (rfl)

@[simp]
theorem quotientHeightIdealOneEquiv_symm_X {p : ℕ} (hp : p.Prime) (n : ℕ+) :
    (quotientHeightIdealOneEquiv hp).symm (MvPolynomial.X n) =
      Ideal.Quotient.mk _ (generator n) := by
  apply (quotientHeightIdealOneEquiv hp).injective
  simp

/-! ### Triangular change of polynomial generators modulo `p` -/

/-- Family of polynomials in `(ZMod p)[x₁, x₂, …]` replacing `X k` by the mod-`p` image of `v_j`
whenever `k + 1 = pʲ` with `j ≠ 0` satisfying `P j`, and keeping `X k` otherwise. -/
private def modPTriangularFamily (p : ℕ) (P : ℕ → Prop) (k : ℕ+) : MvPolynomial ℕ+ (ZMod p) :=
  open Classical in
  if ∃ j ≠ 0, P j ∧ (k : ℕ) + 1 = p ^ j then
    modPMvPolynomialHom p (PowerSeries.coeff ((k : ℕ) + 1) (formalGroup.nsmulSeries p))
  else
    MvPolynomial.X k

private theorem modPTriangularFamily_of_exists {p : ℕ} {P : ℕ → Prop} {k : ℕ+} {j : ℕ}
    (hj0 : j ≠ 0) (hP : P j) (hkj : (k : ℕ) + 1 = p ^ j) :
    modPTriangularFamily p P k =
      modPMvPolynomialHom p (PowerSeries.coeff (p ^ j) (formalGroup.nsmulSeries p)) := by
  dsimp only [modPTriangularFamily]
  split_ifs with h
  · rw [hkj]
  · exact False.elim (h ⟨j, hj0, hP, hkj⟩)

private theorem modPTriangularFamily_of_forall {p : ℕ} {P : ℕ → Prop} {k : ℕ+}
    (hk : ∀ j ≠ 0, P j → (k : ℕ) + 1 ≠ p ^ j) :
    modPTriangularFamily p P k = MvPolynomial.X k := by
  dsimp only [modPTriangularFamily]
  split_ifs with h
  · obtain ⟨j, hj0, hP, hkj⟩ := h
    exact False.elim (hk j hj0 hP hkj)
  · rfl

private theorem map_modPMvPolynomialHom_augmentationIdeal (p : ℕ) :
    augmentationIdeal.map (modPMvPolynomialHom p) = MvPolynomial.idealOfVars ℕ+ (ZMod p) := by
  rw [augmentationIdeal_eq_span_generator, Ideal.map_span, ← Set.range_comp,
    MvPolynomial.idealOfVars]
  simp [Function.comp_def]

/-- Because `v_j ≡ -x_(pʲ - 1)` modulo `(p) + I²` and `v_j` is homogeneous of positive weight
`2(pʲ - 1)`, `modPTriangularFamily p P` is triangular with respect to `<` on `ℕ+`. -/
private theorem isTriangular_modPTriangularFamily {p : ℕ} (hp : p.Prime) (P : ℕ → Prop) :
    MvPolynomial.IsTriangular (· < ·) (modPTriangularFamily p P) := by
  classical
  set w : ℕ+ → ℕ := fun k ↦ 2 * (k : ℕ)
  refine (MvPolynomial.isTriangular_of_isWeightedHomogeneous_sub_mem_sq
    (w := w) (fun k ↦ by positivity) ?_).mono fun m k hmk ↦ by
      simpa [w] using hmk
  intro k
  dsimp only [modPTriangularFamily]
  split_ifs with hk
  · refine ⟨-1, ?_, ?_⟩
    · -- Both `modPMvPolynomialHom p v_j` and `X k` have weight `2k`.
      have hgrad : PowerSeries.coeff ((k : ℕ) + 1) (formalGroup.nsmulSeries p) ∈ grading (w k) := by
        simpa [w] using coeff_nsmulSeries_mem_grading p ((k : ℕ) + 1)
      have hZ : (mvPolynomialEquiv.symm
          (PowerSeries.coeff ((k : ℕ) + 1) (formalGroup.nsmulSeries p))).IsWeightedHomogeneous
            w (w k) :=
        mvPolynomialEquiv_mem_grading_iff.mp (by simpa using hgrad)
      have hFp : (modPMvPolynomialHom p
          (PowerSeries.coeff ((k : ℕ) + 1) (formalGroup.nsmulSeries p))).IsWeightedHomogeneous
            w (w k) := by
        intro d hd
        refine hZ fun h0 ↦ hd ?_
        simp [modPMvPolynomialHom, MvPolynomial.coeff_map, h0]
      simpa using hFp.add (MvPolynomial.isWeightedHomogeneous_X (ZMod p) w k)
    · -- Modulo `(p)`, `v_j + x_k` lies in `augmentationIdeal ^ 2`, hence in `idealOfVars ^ 2`.
      obtain ⟨j, -, -, hkj⟩ := hk
      have hmem := Ideal.mem_map_of_mem (modPMvPolynomialHom p)
        (coeff_prime_pow_nsmulSeries_add_generator_mem hp hkj)
      have hspan0 : (Ideal.span {(p : LazardRing)}).map (modPMvPolynomialHom p) = ⊥ := by
        rw [Ideal.map_span, Set.image_singleton, map_natCast, CharP.cast_eq_zero,
          Ideal.span_singleton_eq_bot]
      rw [Ideal.map_sup, hspan0, bot_sup_eq, Ideal.map_pow,
        map_modPMvPolynomialHom_augmentationIdeal, map_add, modPMvPolynomialHom_generator,
        ← hkj] at hmem
      simpa using hmem
  · refine ⟨1, ?_, ?_⟩
    · simp [MvPolynomial.isWeightedHomogeneous_zero]
    · simp

/-- For any `n` and any predicate `P` holding on `[1, n)`, the image of `I_n` in `(ZMod p)[x₁, …]`
is generated by `modPTriangularFamily p P` on `{k | ∃ j, 1 ≤ j ∧ j < n ∧ k + 1 = pʲ}`. -/
private theorem map_modPMvPolynomialHom_heightIdeal {p : ℕ} (hp : p.Prime) (n : ℕ)
    {P : ℕ → Prop} (hP : ∀ j, 1 ≤ j → j < n → P j) :
    (formalGroup.heightIdeal p n).map (modPMvPolynomialHom p) =
      Ideal.span (modPTriangularFamily p P ''
        {k : ℕ+ | ¬ ∀ j, 1 ≤ j → j < n → (k : ℕ) + 1 ≠ p ^ j}) := by
  classical
  rw [formalGroup.heightIdeal_eq_span hp, Ideal.map_span]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨_, ⟨j, hj, rfl⟩, rfl⟩
    rw [Set.mem_Iio] at hj
    rcases eq_or_ne j 0 with rfl | hj0
    · simp
    · have hpj : 1 < p ^ j := Nat.one_lt_pow hj0 hp.one_lt
      let k : ℕ+ := ⟨p ^ j - 1, Nat.sub_pos_of_lt hpj⟩
      have hkj : (k : ℕ) + 1 = p ^ j := Nat.sub_add_cancel hpj.le
      have hks : k ∈ {k : ℕ+ | ¬ ∀ j, 1 ≤ j → j < n → (k : ℕ) + 1 ≠ p ^ j} := by
        simp only [Set.mem_ofPred_eq, not_forall, Classical.not_not]
        exact ⟨j, Nat.one_le_iff_ne_zero.mpr hj0, hj, hkj⟩
      have hfk := modPTriangularFamily_of_exists hj0
        (hP j (Nat.one_le_iff_ne_zero.mpr hj0) hj) hkj
      exact Ideal.subset_span ⟨k, hks, hfk⟩
  · rintro _ ⟨k, hk, rfl⟩
    simp only [Set.mem_ofPred_eq, not_forall, Classical.not_not] at hk
    obtain ⟨j, ⟨hj1, hjn, hkj⟩⟩ := hk
    have hj0 : j ≠ 0 := by omega
    rw [modPTriangularFamily_of_exists hj0 (hP j hj1 hjn) hkj]
    exact Ideal.subset_span ⟨_, ⟨j, hjn, rfl⟩, rfl⟩

private theorem comap_map_modPMvPolynomialHom_heightIdeal {p : ℕ} (hp : p.Prime) {n : ℕ}
    (hn : 1 ≤ n) :
    ((formalGroup.heightIdeal p n).map (modPMvPolynomialHom p)).comap (modPMvPolynomialHom p) =
      formalGroup.heightIdeal p n := by
  rw [Ideal.comap_map_of_surjective' _ (surjective_modPMvPolynomialHom p),
    ker_modPMvPolynomialHom, ← formalGroup.heightIdeal_one hp,
    sup_eq_left.mpr (FormalGroup.heightIdeal_mono hn)]

/-- The image of `I_∞ = ⨆ n, I_n` in `(ZMod p)[x₁, …]` is generated by `modPTriangularFamily` on
`{k | ¬ ∀ j ≠ 0, k + 1 ≠ pʲ}`. -/
private theorem map_modPMvPolynomialHom_iSup_heightIdeal {p : ℕ} (hp : p.Prime) :
    (⨆ n, formalGroup.heightIdeal p n).map (modPMvPolynomialHom p) =
      Ideal.span (modPTriangularFamily p (fun _ ↦ True) ''
        {k : ℕ+ | ¬ ∀ j ≠ 0, (k : ℕ) + 1 ≠ p ^ j}) := by
  classical
  rw [formalGroup.iSup_heightIdeal_eq_span hp, Ideal.map_span]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
    rcases eq_or_ne j 0 with rfl | hj0
    · simp
    · have hpj : 1 < p ^ j := Nat.one_lt_pow hj0 hp.one_lt
      let k : ℕ+ := ⟨p ^ j - 1, Nat.sub_pos_of_lt hpj⟩
      have hkj : (k : ℕ) + 1 = p ^ j := Nat.sub_add_cancel hpj.le
      have hks : k ∈ {k : ℕ+ | ¬ ∀ j ≠ 0, (k : ℕ) + 1 ≠ p ^ j} := by
        simp only [Set.mem_ofPred_eq, not_forall, Classical.not_not]
        exact ⟨j, hj0, hkj⟩
      exact Ideal.subset_span ⟨k, hks, modPTriangularFamily_of_exists hj0 trivial hkj⟩
  · rintro _ ⟨k, hk, rfl⟩
    simp only [Set.mem_ofPred_eq, not_forall, Classical.not_not] at hk
    obtain ⟨j, hj0, hkj⟩ := hk
    rw [modPTriangularFamily_of_exists hj0 (P := fun _ ↦ True) trivial hkj]
    exact Ideal.subset_span ⟨_, ⟨j, rfl⟩, rfl⟩

private theorem comap_map_modPMvPolynomialHom_iSup_heightIdeal {p : ℕ} (hp : p.Prime) :
    ((⨆ n, formalGroup.heightIdeal p n).map (modPMvPolynomialHom p)).comap
        (modPMvPolynomialHom p) =
      ⨆ n, formalGroup.heightIdeal p n := by
  rw [Ideal.comap_map_of_surjective' _ (surjective_modPMvPolynomialHom p),
    ker_modPMvPolynomialHom, ← formalGroup.heightIdeal_one hp,
    sup_eq_left.mpr (le_iSup (formalGroup.heightIdeal p) 1)]

/-! ### Explicit polynomial quotient presentations -/

/-- **Polynomial presentation of `L ⧸ I_n`.** For a prime `p` and `n ≥ 1`, the quotient of the
Lazard ring by the `n`-th height ideal `I_n = (p, v₁, …, v_(n-1))` is isomorphic to the polynomial
ring over `ZMod p` on the remaining Lazard generators `x_k` (`k + 1 ∉ {p, …, p^(n-1)}`). -/
def quotientHeightIdealEquiv {p : ℕ} (hp : p.Prime) {n : ℕ} (hn : 1 ≤ n) :
    (LazardRing ⧸ formalGroup.heightIdeal p n) ≃+*
      MvPolynomial {k : ℕ+ // ∀ j, 1 ≤ j → j < n → (k : ℕ) + 1 ≠ p ^ j} (ZMod p) :=
  let s : Set ℕ+ := {k : ℕ+ | ¬ ∀ j, 1 ≤ j → j < n → (k : ℕ) + 1 ≠ p ^ j}
  let J : Ideal (MvPolynomial ℕ+ (ZMod p)) := Ideal.span (modPTriangularFamily p (· < n) '' s)
  let ψ : LazardRing →+* (MvPolynomial ℕ+ (ZMod p) ⧸ J) :=
    (Ideal.Quotient.mk J).comp (modPMvPolynomialHom p)
  have hψ_surj : Function.Surjective ψ :=
    Ideal.Quotient.mk_surjective.comp (surjective_modPMvPolynomialHom p)
  have hker : RingHom.ker ψ = formalGroup.heightIdeal p n := by
    dsimp only [ψ, J, s]
    rw [← RingHom.comap_ker, Ideal.mk_ker,
      ← map_modPMvPolynomialHom_heightIdeal hp n fun _ _ hjn ↦ hjn,
      comap_map_modPMvPolynomialHom_heightIdeal hp hn]
  have heq : {k : ℕ+ // k ∉ s} ≃ {k : ℕ+ // ∀ j, 1 ≤ j → j < n → (k : ℕ) + 1 ≠ p ^ j} :=
    Equiv.subtypeEquivRight fun _ ↦ Classical.not_not
  (Ideal.quotEquivOfEq hker.symm).trans <|
    (RingHom.quotientKerEquivOfSurjective hψ_surj).trans <|
      (((isTriangular_modPTriangularFamily hp (· < n)).quotientSpanImageEquiv
        wellFounded_lt s).trans (MvPolynomial.renameEquiv (ZMod p) heq)).toRingEquiv

/-- On any remaining generator `x_k` (`k + 1 ∉ {p, …, p^(n-1)}`), `quotientHeightIdealEquiv` sends
the residue class of `x_k` to the variable `X ⟨k, hk⟩`. -/
@[simp]
theorem quotientHeightIdealEquiv_mk_generator {p : ℕ} (hp : p.Prime) {n : ℕ} (hn : 1 ≤ n)
    {k : ℕ+} (hk : ∀ j, 1 ≤ j → j < n → (k : ℕ) + 1 ≠ p ^ j) :
    quotientHeightIdealEquiv hp hn (Ideal.Quotient.mk _ (generator k)) =
      MvPolynomial.X ⟨k, hk⟩ := by
  let s : Set ℕ+ := {k : ℕ+ | ¬ ∀ j, 1 ≤ j → j < n → (k : ℕ) + 1 ≠ p ^ j}
  have hks : k ∉ s := fun h ↦ h hk
  have hfk : modPTriangularFamily p (· < n) k = MvPolynomial.X k :=
    modPTriangularFamily_of_forall fun j hj0 hjn ↦ hk j (Nat.one_le_iff_ne_zero.mpr hj0) hjn
  -- Unfold the composite `RingEquiv` on `Ideal.Quotient.mk` before rewriting with `hfk`.
  change MvPolynomial.renameEquiv (ZMod p) _
    ((isTriangular_modPTriangularFamily hp (· < n)).quotientSpanImageEquiv wellFounded_lt s
      (Ideal.Quotient.mk _ (modPMvPolynomialHom p (generator k)))) = _
  rw [modPMvPolynomialHom_generator, ← hfk,
    (isTriangular_modPTriangularFamily hp (· < n)).quotientSpanImageEquiv_mk_apply_of_notMem
      wellFounded_lt hks,
    MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
  exact congrArg MvPolynomial.X (Subtype.ext rfl)

@[simp]
theorem quotientHeightIdealEquiv_symm_X {p : ℕ} (hp : p.Prime) {n : ℕ} (hn : 1 ≤ n)
    (k : {k : ℕ+ // ∀ j, 1 ≤ j → j < n → (k : ℕ) + 1 ≠ p ^ j}) :
    (quotientHeightIdealEquiv hp hn).symm (MvPolynomial.X k) =
      Ideal.Quotient.mk _ (generator k.1) := by
  apply (quotientHeightIdealEquiv hp hn).injective
  rw [RingEquiv.apply_symm_apply, quotientHeightIdealEquiv_mk_generator hp hn k.2]

/-- **Polynomial presentation of `L ⧸ I_∞`.** For a prime `p`, the quotient of the Lazard ring by
`I_∞ = ⨆ n, I_n` is isomorphic to the polynomial ring over `ZMod p` on the Lazard generators `x_k`
with `k + 1` not a nontrivial power of `p`. -/
def quotientISupHeightIdealEquiv {p : ℕ} (hp : p.Prime) :
    (LazardRing ⧸ (⨆ n, formalGroup.heightIdeal p n)) ≃+*
      MvPolynomial {k : ℕ+ // ∀ j ≠ 0, (k : ℕ) + 1 ≠ p ^ j} (ZMod p) :=
  let s : Set ℕ+ := {k : ℕ+ | ¬ ∀ j ≠ 0, (k : ℕ) + 1 ≠ p ^ j}
  let J : Ideal (MvPolynomial ℕ+ (ZMod p)) :=
    Ideal.span (modPTriangularFamily p (fun _ ↦ True) '' s)
  let ψ : LazardRing →+* (MvPolynomial ℕ+ (ZMod p) ⧸ J) :=
    (Ideal.Quotient.mk J).comp (modPMvPolynomialHom p)
  have hψ_surj : Function.Surjective ψ :=
    Ideal.Quotient.mk_surjective.comp (surjective_modPMvPolynomialHom p)
  have hker : RingHom.ker ψ = ⨆ n, formalGroup.heightIdeal p n := by
    dsimp only [ψ, J, s]
    rw [← RingHom.comap_ker, Ideal.mk_ker, ← map_modPMvPolynomialHom_iSup_heightIdeal hp,
      comap_map_modPMvPolynomialHom_iSup_heightIdeal hp]
  have heq : {k : ℕ+ // k ∉ s} ≃ {k : ℕ+ // ∀ j ≠ 0, (k : ℕ) + 1 ≠ p ^ j} :=
    Equiv.subtypeEquivRight fun _ ↦ Classical.not_not
  (Ideal.quotEquivOfEq hker.symm).trans <|
    (RingHom.quotientKerEquivOfSurjective hψ_surj).trans <|
      (((isTriangular_modPTriangularFamily hp (fun _ ↦ True)).quotientSpanImageEquiv
        wellFounded_lt s).trans (MvPolynomial.renameEquiv (ZMod p) heq)).toRingEquiv

@[simp]
theorem quotientISupHeightIdealEquiv_mk_generator {p : ℕ} (hp : p.Prime)
    {k : ℕ+} (hk : ∀ j ≠ 0, (k : ℕ) + 1 ≠ p ^ j) :
    quotientISupHeightIdealEquiv hp (Ideal.Quotient.mk _ (generator k)) =
      MvPolynomial.X ⟨k, hk⟩ := by
  let s : Set ℕ+ := {k : ℕ+ | ¬ ∀ j ≠ 0, (k : ℕ) + 1 ≠ p ^ j}
  have hks : k ∉ s := fun h ↦ h hk
  have hfk : modPTriangularFamily p (fun _ ↦ True) k = MvPolynomial.X k :=
    modPTriangularFamily_of_forall fun j hj0 _ ↦ hk j hj0
  -- Unfold the composite `RingEquiv` on `Ideal.Quotient.mk` before rewriting with `hfk`.
  change MvPolynomial.renameEquiv (ZMod p) _
    ((isTriangular_modPTriangularFamily hp (fun _ ↦ True)).quotientSpanImageEquiv wellFounded_lt s
      (Ideal.Quotient.mk _ (modPMvPolynomialHom p (generator k)))) = _
  rw [modPMvPolynomialHom_generator, ← hfk,
    (isTriangular_modPTriangularFamily hp (fun _ ↦ True)).quotientSpanImageEquiv_mk_apply_of_notMem
      wellFounded_lt hks,
    MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
  exact congrArg MvPolynomial.X (Subtype.ext rfl)

@[simp]
theorem quotientISupHeightIdealEquiv_symm_X {p : ℕ} (hp : p.Prime)
    (k : {k : ℕ+ // ∀ j ≠ 0, (k : ℕ) + 1 ≠ p ^ j}) :
    (quotientISupHeightIdealEquiv hp).symm (MvPolynomial.X k) =
      Ideal.Quotient.mk _ (generator k.1) := by
  apply (quotientISupHeightIdealEquiv hp).injective
  rw [RingEquiv.apply_symm_apply, quotientISupHeightIdealEquiv_mk_generator hp k.2]

/-! ### Primality, strict monotonicity, and non-finite generation -/

/-- **Primality of the Lazard height ideals.** For every prime `p` and every `n : ℕ`, the height
ideal `I_n = (p, v₁, …, v_(n-1))` of the Lazard ring is prime. -/
theorem isPrime_heightIdeal {p : ℕ} (hp : p.Prime) (n : ℕ) :
    (formalGroup.heightIdeal p n).IsPrime := by
  rcases eq_or_ne n 0 with rfl | hn0
  · rw [FormalGroup.heightIdeal_zero]
    infer_instance
  · have : Fact p.Prime := ⟨hp⟩
    have hn : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn0
    rw [← comap_map_modPMvPolynomialHom_heightIdeal hp hn,
      map_modPMvPolynomialHom_heightIdeal hp n fun _ _ hjn ↦ hjn]
    have := (isTriangular_modPTriangularFamily hp (· < n)).isPrime_span_image wellFounded_lt
      {k : ℕ+ | ¬ ∀ j, 1 ≤ j → j < n → (k : ℕ) + 1 ≠ p ^ j}
    exact Ideal.IsPrime.comap (modPMvPolynomialHom p)

/-- **Primality of the infinite height ideal.** For every prime `p`, the ideal
`I_∞ = ⨆ n, I_n = (p, v₁, v₂, …)` of the Lazard ring is prime. -/
theorem isPrime_iSup_heightIdeal {p : ℕ} (hp : p.Prime) :
    (⨆ n, formalGroup.heightIdeal p n).IsPrime := by
  have : Fact p.Prime := ⟨hp⟩
  rw [← comap_map_modPMvPolynomialHom_iSup_heightIdeal hp,
    map_modPMvPolynomialHom_iSup_heightIdeal hp]
  have := (isTriangular_modPTriangularFamily hp (fun _ ↦ True)).isPrime_span_image wellFounded_lt
    {k : ℕ+ | ¬ ∀ j ≠ 0, (k : ℕ) + 1 ≠ p ^ j}
  exact Ideal.IsPrime.comap (modPMvPolynomialHom p)

/-- **Nontriviality of `v_n` modulo `I_n`.** For every prime `p` and every `n : ℕ`, the coefficient
`v_n` of `X^(pⁿ)` in `[p](X)` does not lie in the `n`-th height ideal `I_n` of the Lazard ring. -/
theorem coeff_prime_pow_nsmulSeries_notMem_heightIdeal {p : ℕ} (hp : p.Prime) (n : ℕ) :
    PowerSeries.coeff (p ^ n) (formalGroup.nsmulSeries p) ∉ formalGroup.heightIdeal p n := by
  rcases eq_or_ne n 0 with rfl | hn0
  · simp [hp.ne_zero]
  · have : Fact p.Prime := ⟨hp⟩
    have hpn : 1 < p ^ n := Nat.one_lt_pow hn0 hp.one_lt
    let k : ℕ+ := ⟨p ^ n - 1, Nat.sub_pos_of_lt hpn⟩
    have hkn : (k : ℕ) + 1 = p ^ n := Nat.sub_add_cancel hpn.le
    let s : Set ℕ+ := {m : ℕ+ | ¬ ∀ j, 1 ≤ j → j < n → (m : ℕ) + 1 ≠ p ^ j}
    have hnot_s : k ∉ s := by
      simp only [s, Set.mem_ofPred_eq, Classical.not_not]
      intro j _ hjn
      rw [hkn]
      exact ((Nat.pow_lt_pow_iff_right hp.one_lt).mpr hjn).ne'
    have hfk := modPTriangularFamily_of_exists hn0 (P := fun _ ↦ True) trivial hkn
    intro hmem
    have hmap := Ideal.mem_map_of_mem (modPMvPolynomialHom p) hmem
    rw [map_modPMvPolynomialHom_heightIdeal hp n fun _ _ _ ↦ trivial, ← hfk] at hmap
    exact (isTriangular_modPTriangularFamily hp (fun _ ↦ True)).notMem_span_image
      wellFounded_lt hnot_s hmap

/-- The height ideals `I₀ < I₁ < I₂ < …` of the Lazard ring form a strictly increasing chain. -/
theorem strictMono_heightIdeal {p : ℕ} (hp : p.Prime) :
    StrictMono (formalGroup.heightIdeal p) := by
  refine strictMono_nat_of_lt_succ fun n ↦
    lt_of_le_of_ne (FormalGroup.heightIdeal_mono n.le_succ) ?_
  intro hEq
  refine coeff_prime_pow_nsmulSeries_notMem_heightIdeal hp n ?_
  rw [hEq, formalGroup.heightIdeal_succ hp]
  exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)

/-- Distinct heights produce distinct height ideals on the Lazard ring. -/
theorem injective_heightIdeal {p : ℕ} (hp : p.Prime) :
    Function.Injective (formalGroup.heightIdeal p) :=
  (strictMono_heightIdeal hp).injective

/-- Every finite height ideal `I_n` is strictly contained in `I_∞ = ⨆ m, I_m`. -/
theorem heightIdeal_lt_iSup {p : ℕ} (hp : p.Prime) (n : ℕ) :
    formalGroup.heightIdeal p n < ⨆ m, formalGroup.heightIdeal p m :=
  (strictMono_heightIdeal hp n.lt_succ_self).trans_le (le_iSup (formalGroup.heightIdeal p) (n + 1))

/-- The infinite height ideal `I_∞ = (p, v₁, v₂, …)` of the Lazard ring is not finitely
generated. -/
theorem not_fg_iSup_heightIdeal {p : ℕ} (hp : p.Prime) :
    ¬ (⨆ n, formalGroup.heightIdeal p n).FG := by
  intro hfg
  obtain ⟨n, hn⟩ := Submodule.FG.stabilizes_of_iSup_eq hfg
    ⟨formalGroup.heightIdeal p, FormalGroup.heightIdeal_mono⟩ rfl
  exact (heightIdeal_lt_iSup hp n).ne' hn

/-! ### Landweber regularity of the Lazard ring -/

/-- Multiplication by `v_n` is injective on `L ⧸ I_n` for every prime `p` and every `n : ℕ`. -/
theorem isSMulRegular_quotient_heightIdeal {p : ℕ} (hp : p.Prime) (n : ℕ) :
    IsSMulRegular (LazardRing ⧸ formalGroup.heightIdeal p n)
      (PowerSeries.coeff (p ^ n) (formalGroup.nsmulSeries p)) := by
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro x hx
  rw [smul_eq_mul] at hx
  exact ((isPrime_heightIdeal hp n).mem_or_mem hx).resolve_left
    (coeff_prime_pow_nsmulSeries_notMem_heightIdeal hp n)

/-- **Landweber's regularity theorem on the Lazard ring.** For every prime `p` and every `n : ℕ`,
the sequence `[p, v₁, …, v_(n-1)]` is a regular sequence on the Lazard ring. -/
theorem isRegular_landweberSequence {p : ℕ} (hp : p.Prime) (n : ℕ) :
    IsRegular LazardRing (formalGroup.landweberSequence p n) := by
  rw [isRegular_iff, formalGroup.isWeaklyRegular_landweberSequence_iff hp LazardRing n,
    formalGroup.ofList_landweberSequence hp]
  refine ⟨fun i _ ↦ ?_, ?_⟩
  · have hEq : (formalGroup.heightIdeal p i • ⊤ : Submodule LazardRing LazardRing) =
        formalGroup.heightIdeal p i := by
      rw [smul_eq_mul, Ideal.mul_top]
    exact ((Submodule.quotEquivOfEq _ _ hEq).isSMulRegular_congr _).mpr
      (isSMulRegular_quotient_heightIdeal hp i)
  · rw [smul_eq_mul, Ideal.mul_top]
    exact (heightIdeal_ne_top hp.one_lt n).symm

/-- Any sequence `w₀, …, w_(n-1)` on the Lazard ring with `w_i ≡ v_i` modulo `I_i` (for instance,
truncations of Araki or Hazewinkel generators) is a regular sequence on `LazardRing`. -/
theorem isRegular_ofFn_of_sub_mem_heightIdeal {p : ℕ} (hp : p.Prime) {n : ℕ}
    {w : Fin n → LazardRing}
    (hw : ∀ i : Fin n, w i - PowerSeries.coeff (p ^ (i : ℕ)) (formalGroup.nsmulSeries p) ∈
      formalGroup.heightIdeal p i) :
    IsRegular LazardRing (List.ofFn w) :=
  (formalGroup.isRegular_ofFn_iff_landweberSequence hp LazardRing hw).mpr
    (isRegular_landweberSequence hp n)

/-- **The universal formal group law is Landweber regular on the Lazard ring.** -/
theorem isLandweberRegular : formalGroup.IsLandweberRegular LazardRing :=
  (FormalGroup.isLandweberRegular_def _ _).mpr
    fun _ hp n ↦ (isRegular_landweberSequence hp n).toIsWeaklyRegular

end TauCeti.LazardRing

namespace FormalGroup

/-- Every commutative formal group law `F` over `R` whose classifying homomorphism
`TauCeti.LazardRing.lift ⟨F, _⟩ : LazardRing →+* R` is flat is Landweber regular on `R`. -/
theorem isLandweberRegular_of_flat_lift {R : Type*} [CommRing R] (F : FormalGroup R) [F.IsComm]
    (hflat : (TauCeti.LazardRing.lift ⟨F, ‹_›⟩).Flat) :
    F.IsLandweberRegular R := by
  simpa [TauCeti.LazardRing.map_lift] using TauCeti.LazardRing.isLandweberRegular.map_of_flat hflat

end FormalGroup
