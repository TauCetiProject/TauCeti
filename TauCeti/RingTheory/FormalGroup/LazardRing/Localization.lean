module

public import Mathlib.RingTheory.Localization.Defs
public import TauCeti.RingTheory.FormalGroup.LazardRing.Basic

/-!
# Localization of the Lazard ring away from primes not dividing `p`

For `p : ℕ`, `TauCeti.LazardRing.coprimeSubmonoid p` is the submonoid of `TauCeti.LazardRing`
generated by primes `(q : LazardRing)` not dividing `p` (giving `L_{(p)} = L ⊗ ℤ_{(p)}` for prime
`p`). Its elements are casts of nonzero natural numbers coprime to `p`, hence homogeneous of degree
`0`. Any localization `S` at `coprimeSubmonoid p` inverts every prime `q ∤ p` and satisfies
`TauCeti.LazardRing.localizedLift`.

## Main definitions and results

* `TauCeti.LazardRing.coprimeSubmonoid`, `TauCeti.LazardRing.coprimeSubmonoid_le`,
  `TauCeti.LazardRing.mem_coprimeSubmonoid_iff`,
  `TauCeti.LazardRing.coprimeSubmonoid_subset_grading_zero`: the submonoid of primes `q ∤ p`, its
  characterization, and degree-`0` homogeneity.
* `TauCeti.LazardRing.localizedLift`, `TauCeti.LazardRing.localizedHom_ext`,
  `TauCeti.LazardRing.map_localizedLift`: universal property of any localization `S` of `LazardRing`
  at `coprimeSubmonoid p`.

## References

* M. Lazard, *Sur les groupes de Lie formels à un paramètre*, Bull. Soc. Math. France 83 (1955).
* D. Quillen, *On the formal group laws of unoriented and complex cobordism theory*, Bull. Amer.
  Math. Soc. 75 (1969), 1293–1298.
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres* (1986), Appendix A2.1.
-/

public section

noncomputable section

namespace TauCeti.LazardRing

/-- The submonoid of `LazardRing` generated by all primes `(q : LazardRing)` not dividing `p`. -/
def coprimeSubmonoid (p : ℕ) : Submonoid LazardRing :=
  Submonoid.closure ((Nat.cast : ℕ → LazardRing) '' {q : ℕ | q.Prime ∧ ¬ q ∣ p})

/-- Unfold `coprimeSubmonoid p` as the submonoid generated by primes not dividing `p`. -/
theorem coprimeSubmonoid_def (p : ℕ) :
    coprimeSubmonoid p =
      Submonoid.closure ((Nat.cast : ℕ → LazardRing) '' {q : ℕ | q.Prime ∧ ¬ q ∣ p}) := (rfl)

/-- A submonoid contains `coprimeSubmonoid p` iff it contains every prime `q ∤ p`. -/
theorem coprimeSubmonoid_le (p : ℕ) {M : Submonoid LazardRing} :
    coprimeSubmonoid p ≤ M ↔ ∀ q : ℕ, q.Prime → ¬ q ∣ p → (q : LazardRing) ∈ M := by
  rw [coprimeSubmonoid_def, Submonoid.closure_le, Set.image_subset_iff]
  exact ⟨fun h q hq hqp ↦ h ⟨hq, hqp⟩, fun h q ⟨hq, hqp⟩ ↦ h q hq hqp⟩

/-- Every prime `q` not dividing `p` belongs to `coprimeSubmonoid p`. -/
theorem natCast_mem_coprimeSubmonoid (p : ℕ) {q : ℕ} (hq : q.Prime) (hqp : ¬ q ∣ p) :
    (q : LazardRing) ∈ coprimeSubmonoid p := Submonoid.subset_closure ⟨q, ⟨hq, hqp⟩, rfl⟩

/-- `m ∈ coprimeSubmonoid p` iff `m` is the cast of a nonzero natural number coprime to `p`. -/
theorem mem_coprimeSubmonoid_iff {p : ℕ} {m : LazardRing} :
    m ∈ coprimeSubmonoid p ↔ ∃ n : ℕ, n ≠ 0 ∧ n.Coprime p ∧ (n : LazardRing) = m := by
  constructor
  · intro hm
    refine Submonoid.closure_induction
      (fun _ ⟨q, ⟨hq, hqp⟩, hqm⟩ ↦ ⟨q, hq.ne_zero, hq.coprime_iff_not_dvd.mpr hqp, hqm⟩)
      ⟨1, one_ne_zero, Nat.coprime_one_left p, Nat.cast_one⟩
      (fun _ _ _ _ ⟨a, ha0, hap, ha⟩ ⟨b, hb0, hbp, hb⟩ ↦
        ⟨a * b, mul_ne_zero ha0 hb0, hap.mul_left hbp, by rw [Nat.cast_mul, ha, hb]⟩) hm
  · rintro ⟨n, hn0, hnp, rfl⟩
    rw [← Nat.prod_primeFactorsList hn0, Nat.cast_list_prod]
    refine list_prod_mem fun _ hx ↦ ?_
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hx
    have hq' := Nat.prime_of_mem_primeFactorsList hq
    exact natCast_mem_coprimeSubmonoid p hq' (hq'.coprime_iff_not_dvd.mp
      (hnp.coprime_dvd_left (Nat.dvd_of_mem_primeFactorsList hq)))

/-- Every element of `coprimeSubmonoid p` is homogeneous of degree `0` in `LazardRing`. -/
theorem coprimeSubmonoid_subset_grading_zero (p : ℕ) :
    (coprimeSubmonoid p : Set LazardRing) ⊆ grading 0 := fun _ hm ↦ by
  obtain ⟨n, _, _, rfl⟩ := mem_coprimeSubmonoid_iff.mp hm
  exact SetLike.natCast_mem_graded grading n

section Localization

variable (p : ℕ) (S : Type*) [CommRing S] [Algebra LazardRing S]
  [IsLocalization (coprimeSubmonoid p) S]

/-- In any localization `S` at `coprimeSubmonoid p`, every prime `q ∤ p` is invertible. -/
theorem isUnit_prime_of_isLocalization (q : ℕ) (hq : q.Prime) (hqp : ¬ q ∣ p) :
    IsUnit (q : S) := by
  simpa only [map_natCast] using
    IsLocalization.map_units S ⟨(q : LazardRing), natCast_mem_coprimeSubmonoid p hq hqp⟩

/-- Any ring `R` receiving a homomorphism from `S` has every prime `q ∤ p` invertible. -/
theorem isUnit_prime_of_ringHom {R : Type*} [CommRing R] (f : S →+* R) (q : ℕ) (hq : q.Prime)
    (hqp : ¬ q ∣ p) : IsUnit (q : R) := by
  simpa only [map_natCast] using (isUnit_prime_of_isLocalization p S q hq hqp).map f

/-- Ring homomorphisms out of `S` are determined by the base change of
`formalGroup.map (algebraMap LazardRing S)` along them. -/
theorem localizedHom_ext {S : Type*} [CommRing S] [Algebra LazardRing S]
    [IsLocalization (coprimeSubmonoid p) S] {R : Type*} [CommRing R] {f g : S →+* R}
    (h : (formalGroup.map (algebraMap LazardRing S)).map f =
      (formalGroup.map (algebraMap LazardRing S)).map g) : f = g := by
  refine IsLocalization.ringHom_ext (coprimeSubmonoid p) (hom_ext ?_)
  rwa [← FormalGroup.map_comp, ← FormalGroup.map_comp]

section Lift

variable {R : Type*} [CommRing R] (hunit : ∀ q : ℕ, q.Prime → ¬ q ∣ p → IsUnit (q : R))
include hunit

private theorem isUnit_lift_of_mem_coprimeSubmonoid (F : {F : FormalGroup R // F.IsComm})
    (m : coprimeSubmonoid p) : IsUnit (lift F m) :=
  ((coprimeSubmonoid_le p (M := (IsUnit.submonoid R).comap (lift F).toMonoidHom)).mpr
    fun q hq hqp ↦ by simpa only [Submonoid.mem_comap, RingHom.toMonoidHom_eq_coe,
      MonoidHom.coe_ofClass, IsUnit.mem_submonoid_iff, map_natCast] using hunit q hq hqp) m.property

/-- **Universal property of the localized Lazard ring**: for any commutative ring `R` in which
every prime `q ∤ p` is invertible, commutative formal group laws over `R` correspond bijectively to
ring homomorphisms `S →+* R`. -/
def localizedLift : {F : FormalGroup R // F.IsComm} ≃ (S →+* R) where
  toFun F := IsLocalization.lift (M := coprimeSubmonoid p)
    (isUnit_lift_of_mem_coprimeSubmonoid p hunit F)
  invFun f := ⟨(formalGroup.map (algebraMap LazardRing S)).map f, inferInstance⟩
  left_inv F := Subtype.ext <| by
    dsimp only
    rw [FormalGroup.map_comp, IsLocalization.lift_comp (M := coprimeSubmonoid p) (S := S), map_lift]
  right_inv f := localizedHom_ext p <| by
    rw [FormalGroup.map_comp, IsLocalization.lift_comp (M := coprimeSubmonoid p) (S := S), map_lift]

/-- `localizedLift` restricts along `algebraMap LazardRing S` to `LazardRing.lift`. -/
@[simp]
theorem localizedLift_comp_algebraMap (F : {F : FormalGroup R // F.IsComm}) :
    (localizedLift p S hunit F).comp (algebraMap LazardRing S) = lift F := by
  rw [localizedLift, Equiv.coe_fn_mk]
  exact IsLocalization.lift_comp (M := coprimeSubmonoid p) (S := S) _

/-- On elements from `LazardRing`, `localizedLift` agrees with `LazardRing.lift`. -/
@[simp]
theorem localizedLift_algebraMap (F : {F : FormalGroup R // F.IsComm}) (x : LazardRing) :
    localizedLift p S hunit F (algebraMap LazardRing S x) = lift F x :=
  RingHom.congr_fun (localizedLift_comp_algebraMap p S hunit F) x

/-- Base-changing the universal law over `S` along `localizedLift p S hunit F` gives `F`. -/
theorem map_localizedLift (F : {F : FormalGroup R // F.IsComm}) :
    (formalGroup.map (algebraMap LazardRing S)).map (localizedLift p S hunit F) = F.val := by
  rw [FormalGroup.map_comp, localizedLift_comp_algebraMap, map_lift]

/-- The law classified by `f : S →+* R` is `(formalGroup.map (algebraMap LazardRing S)).map f`. -/
@[simp]
theorem coe_localizedLift_symm (f : S →+* R) :
    ((localizedLift p S hunit).symm f).val =
      (formalGroup.map (algebraMap LazardRing S)).map f := (rfl)

end Lift

end Localization

end TauCeti.LazardRing
