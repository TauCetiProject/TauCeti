import TauCeti.Algebra.GCDMonoid.Finset
import TauCeti.RingTheory.FormalGroup.SymmetricCocycle.SquareZero

/-!
# The indecomposables of the Lazard ring

The Lazard ring `L` is augmented over `ℤ` by the homomorphism `η : L →+* ℤ` classifying the
additive formal group law `X + Y`; it sends every coefficient `aᵢⱼ` of the universal formal group
law to `0`, and its kernel, the augmentation ideal `I`, is generated by the `aᵢⱼ`. The
*indecomposables* of `L` are the `ℤ`-module `Q(L) = I ⧸ I²` (`Ideal.Cotangent`). This file proves
**Lazard's computation of the indecomposables**: `Q(L)` is a free `ℤ`-module with one basis element
in each degree `2n`, `n ≥ 1`, the class of an explicit element `xₙ ∈ L₂ₙ`.

Modulo `I²` the coefficients of the universal formal group law have square zero, so its nonlinear
part is a symmetric additive 2-cocycle with coefficients in `L ⧸ I²`
(`FormalGroup.isSymmetricCocycleCoeff_coeff`). By the symmetric 2-cocycle lemma its homogeneous
part of degree `n + 1` is a multiple of the Lazard cocycle `C_{n+1}`, so modulo `I²` each
`a_{i, n+1-i}` is `((n + 1).choose i / d_{n+1}) • xₙ`, where `xₙ = ∑ cᵢ a_{i, n+1-i}` for integers
`cᵢ` with `∑ cᵢ ((n + 1).choose i / d_{n+1}) = 1`, which exist since these numbers are coprime.
Conversely, the formal group law `X + Y + ε C_{n+1}(X, Y)` over the dual numbers `ℤ[ε]`,
`ε² = 0`, is classified by a homomorphism `L →+* ℤ[ε]` that kills `I²` and every `xₘ` with `m ≠ n`
and sends `xₙ` to `ε`. Hence the classes of the `xₙ` are linearly independent.

This is the input to Lazard's theorem that `L` is a polynomial ring `ℤ[x₁, x₂, …]`: lifts of a
basis of the indecomposables of a connected graded ring generate it.

## Main definitions

* `TauCeti.LazardRing.augmentation`: the augmentation `L →+* ℤ`, classifying `X + Y`.
* `TauCeti.LazardRing.augmentationIdeal`: its kernel `I`.
* `TauCeti.LazardRing.generator n`: the element `xₙ ∈ L₂ₙ`.
* `TauCeti.LazardRing.cotangentBasis`: the basis `(xₙ mod I²)ₙ` of `Q(L) = I ⧸ I²` over `ℤ`.

## Main results

* `TauCeti.LazardRing.augmentationIdeal_eq_span`: `I` is generated by the coefficients `aᵢⱼ`.
* `TauCeti.LazardRing.generator_mem_grading`: `xₙ` has degree `2n`.
* `TauCeti.LazardRing.coeff_formalGroup_sub_nsmul_generator_mem_sq`: for `0 < i ≤ n`,
  `a_{i, n+1-i} ≡ ((n + 1).choose i / d_{n+1}) • xₙ` modulo `I²`.
* `TauCeti.LazardRing.cotangentBasis_apply`: the basis vectors are the classes of the `xₙ`.

## References

* M. Lazard, *Sur les groupes de Lie formels à un paramètre*, Bull. Soc. Math. France 83 (1955).
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres*, Appendix A2.1
  (the proof of Lazard's theorem A2.1.8).
* J. F. Adams, *Stable Homotopy and Generalised Homology*, Part II, §7.
-/

public section

noncomputable section

open MvPowerSeries Finsupp Finset

namespace TauCeti.LazardRing

/-! ### The augmentation -/

/-- The **augmentation** `L →+* ℤ` of the Lazard ring: the homomorphism classifying the additive
formal group law `X + Y`. It sends every coefficient `aᵢⱼ` of the universal formal group law
to `0`. -/
def augmentation : LazardRing →+* ℤ :=
  lift ⟨FormalGroup.𝔾ₐ, inferInstance⟩

/-- The augmentation sends a coefficient of the universal formal group law to the corresponding
coefficient of `X + Y`. -/
@[simp]
theorem augmentation_coeff_formalGroup (d : Fin 2 →₀ ℕ) :
    augmentation (coeff d formalGroup.toPowerSeries) = coeff d (X 0 + X 1 : MvPowerSeries _ ℤ) := by
  rw [← coeff_map, ← FormalGroup.map_toPowerSeries, augmentation, map_lift]
  rfl

/-- On polynomials in the `aᵢⱼ`, the augmentation is the constant coefficient. -/
@[simp]
theorem augmentation_mk (p : MvPolynomial (ℕ+ × ℕ+) ℤ) :
    augmentation (mk p) = MvPolynomial.constantCoeff p := by
  rw [← RingHom.comp_apply, augmentation, lift_comp_mk]
  refine RingHom.congr_fun (MvPolynomial.ringHom_ext (fun r ↦ by simp) fun ⟨i, j⟩ ↦ ?_) p
  simp [MvPowerSeries.coeff_X, Finsupp.ext_iff, Fin.forall_fin_two]

/-- The **augmentation ideal** `I` of the Lazard ring, the kernel of the augmentation. -/
def augmentationIdeal : Ideal LazardRing :=
  RingHom.ker augmentation

/-- An element lies in the augmentation ideal exactly when its augmentation vanishes. -/
theorem mem_augmentationIdeal {x : LazardRing} :
    x ∈ augmentationIdeal ↔ augmentation x = 0 :=
  RingHom.mem_ker

/-- The augmentation ideal is generated by the coefficients `aᵢⱼ` of the universal formal group
law. -/
theorem augmentationIdeal_eq_span :
    augmentationIdeal = Ideal.span (Set.range fun ij ↦ mk (MvPolynomial.X ij)) := by
  have hker : RingHom.ker (MvPolynomial.constantCoeff (σ := ℕ+ × ℕ+) (R := ℤ)) =
      MvPolynomial.idealOfVars _ ℤ := by
    ext p
    rw [RingHom.mem_ker, ← pow_one (MvPolynomial.idealOfVars _ ℤ),
      MvPolynomial.mem_pow_idealOfVars_iff', MvPolynomial.constantCoeff_eq]
    simp [Finsupp.degree_eq_zero_iff]
  have hcomp : augmentation.comp mk = MvPolynomial.constantCoeff :=
    RingHom.ext augmentation_mk
  rw [augmentationIdeal, ← Ideal.map_comap_of_surjective mk mk_surjective (RingHom.ker _),
    RingHom.comap_ker, hcomp, hker, MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp]
  rfl

/-- The coefficients `aᵢⱼ` of the universal formal group law lie in the augmentation ideal. -/
theorem mk_X_mem_augmentationIdeal (ij : ℕ+ × ℕ+) : mk (MvPolynomial.X ij) ∈ augmentationIdeal :=
  mem_augmentationIdeal.2 (by simp)

/-- The coefficients of the nonlinear part `F - X - Y` of the universal formal group law lie in
the augmentation ideal. -/
theorem coeff_formalGroup_sub_mem_augmentationIdeal (d : Fin 2 →₀ ℕ) :
    coeff d (formalGroup.toPowerSeries - (X 0 + X 1)) ∈ augmentationIdeal := by
  rw [mem_augmentationIdeal, map_sub, map_sub, augmentation_coeff_formalGroup]
  simp [MvPowerSeries.coeff_X]

/-! ### The generators -/

/-- Integers `cᵢ` with `∑_{0 < i < n} cᵢ (n.choose i / d_n) = 1`, for `n ≥ 2`. -/
private def bezout (n : ℕ) : ℕ → ℤ :=
  if h : 2 ≤ n then
    (exists_sum_natCast_mul_eq_one_of_gcd_eq_one (gcd_choose_div_lazardGcd_eq_one h)).choose
  else 0

private theorem sum_bezout {n : ℕ} (hn : 2 ≤ n) :
    ∑ i ∈ Icc 1 (n - 1), ((n.choose i / lazardGcd n : ℕ) : ℤ) * bezout n i = 1 := by
  simp only [bezout, hn, ↓reduceDIte]
  exact (exists_sum_natCast_mul_eq_one_of_gcd_eq_one
    (gcd_choose_div_lazardGcd_eq_one hn)).choose_spec

/-- The **generator** `xₙ` of the indecomposables of the Lazard ring in degree `2n`: the integral
combination `∑_{0 < i ≤ n} cᵢ a_{i, n+1-i}` of the coefficients of the universal formal group
law in total degree `n + 1`, for integers `cᵢ` with `∑ cᵢ ((n + 1).choose i / d_{n+1}) = 1`.
Only its class modulo the square of the augmentation ideal is determined by this property, and
that class is the `n`-th vector of `TauCeti.LazardRing.cotangentBasis`. -/
def generator (n : ℕ+) : LazardRing :=
  ∑ i ∈ Icc 1 (n : ℕ),
    bezout (n + 1) i • coeff (single 0 i + single 1 (n + 1 - i)) formalGroup.toPowerSeries

/-- The generator `xₙ` has degree `2n`. -/
theorem generator_mem_grading (n : ℕ+) : generator n ∈ grading (2 * n) := by
  refine sum_mem fun i hi ↦ Submodule.smul_of_tower_mem _ _ ?_
  rw [mem_Icc] at hi
  have h := coeff_formalGroup_mem_grading (single 0 i + single 1 ((n : ℕ) + 1 - i))
  rwa [map_add, Finsupp.degree_single, Finsupp.degree_single,
    show i + ((n : ℕ) + 1 - i) - 1 = n by omega] at h

/-- The generator `xₙ` lies in the augmentation ideal. -/
theorem generator_mem_augmentationIdeal (n : ℕ+) : generator n ∈ augmentationIdeal := by
  refine sum_mem fun i hi ↦ Submodule.smul_of_tower_mem _ _ ?_
  rw [mem_Icc] at hi
  have h := coeff_formalGroup ⟨i, hi.1⟩ ⟨n + 1 - i, by omega⟩
  rw [PNat.mk_coe, PNat.mk_coe] at h
  rw [h]
  exact mk_X_mem_augmentationIdeal _

/-! ### The indecomposables are generated by the classes of the generators -/

/-- **The coefficients of the universal formal group law modulo decomposables**: for `0 < i ≤ n`,
`a_{i, n+1-i} ≡ ((n + 1).choose i / d_{n+1}) • xₙ` modulo the square of the augmentation ideal. -/
theorem coeff_formalGroup_sub_nsmul_generator_mem_sq (n : ℕ+) {i : ℕ} (hi : 0 < i)
    (hin : i ≤ n) :
    coeff (single 0 i + single 1 (n + 1 - i)) formalGroup.toPowerSeries -
        ((n + 1 : ℕ).choose i / lazardGcd (n + 1)) • generator n ∈ augmentationIdeal ^ 2 := by
  set π := Ideal.Quotient.mk (augmentationIdeal ^ 2)
  -- Modulo `I²`, the universal formal group law has square-zero coefficients.
  have hF : ∀ d e, coeff d ((formalGroup.map π).toPowerSeries - (X 0 + X 1)) *
      coeff e ((formalGroup.map π).toPowerSeries - (X 0 + X 1)) = 0 := by
    have h : (formalGroup.map π).toPowerSeries - (X 0 + X 1) =
        map π (formalGroup.toPowerSeries - (X 0 + X 1)) := by
      simp [FormalGroup.map_toPowerSeries]
    intro d e
    rw [h, coeff_map, coeff_map, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, pow_two]
    exact Ideal.mul_mem_mul (coeff_formalGroup_sub_mem_augmentationIdeal d)
      (coeff_formalGroup_sub_mem_augmentationIdeal e)
  obtain ⟨r, hr⟩ := ((formalGroup.map π).isSymmetricCocycleCoeff_coeff hF (n + 1)).exists_eq_nsmul
  simp only [FormalGroup.map_toPowerSeries, coeff_map] at hr
  -- The class of `xₙ` is the multiple `r` of the Lazard cocycle.
  have hx : π (generator n) = r := by
    rw [generator, map_sum]
    calc ∑ j ∈ Icc 1 (n : ℕ), π (bezout (n + 1) j •
          coeff (single 0 j + single 1 (n + 1 - j)) formalGroup.toPowerSeries)
        = ∑ j ∈ Icc 1 (n : ℕ),
            (((n + 1 : ℕ).choose j / lazardGcd (n + 1) : ℕ) * bezout (n + 1) j : ℤ) • r := by
          refine sum_congr rfl fun j hj ↦ ?_
          rw [mem_Icc] at hj
          rw [map_zsmul, hr j hj.1 (by omega), ← Nat.cast_smul_eq_nsmul ℤ, smul_smul, mul_comm]
      _ = r := by
          have h := sum_bezout (n := (n : ℕ) + 1) (by omega)
          rw [Nat.add_sub_cancel] at h
          rw [← sum_smul, h, one_smul]
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_nsmul, hx, hr i hi (by omega), sub_self]

/-! ### Detecting the generators -/

/-- The Lazard cocycle `ε • C_{n+1}` over the dual numbers. -/
private abbrev dualCocycle (n : ℕ+) : MvPolynomial (Fin 2) (DualNumber ℤ) :=
  (DualNumber.eps : DualNumber ℤ) • lazardCocycle ((n : ℕ) + 1) (DualNumber ℤ)

private theorem isAddCocycle₂_dualCocycle (n : ℕ+) : (dualCocycle n).IsAddCocycle₂ :=
  (isAddCocycle₂_lazardCocycle _).smul _

private theorem constantCoeff_dualCocycle (n : ℕ+) :
    MvPolynomial.constantCoeff (dualCocycle n) = 0 := by
  simp [dualCocycle, MvPolynomial.constantCoeff_eq, coeff_lazardCocycle]

private theorem coeff_mul_coeff_dualCocycle (n : ℕ+) (d e : Fin 2 →₀ ℕ) :
    (dualCocycle n).coeff d * (dualCocycle n).coeff e = 0 := by
  simp only [dualCocycle, MvPolynomial.coeff_smul, smul_eq_mul]
  rw [mul_mul_mul_comm, DualNumber.eps_mul_eps, zero_mul]

/-- The homomorphism `L →+* ℤ[ε]` classifying the formal group law `X + Y + ε C_{n+1}(X, Y)`. -/
private def cocycleHom (n : ℕ+) : LazardRing →+* DualNumber ℤ :=
  lift ⟨(isAddCocycle₂_dualCocycle n).formalGroup (constantCoeff_dualCocycle n)
    (coeff_mul_coeff_dualCocycle n), (isAddCocycle₂_dualCocycle n).isComm_formalGroup _ _
      ((isSymmetric_lazardCocycle _).smul _)⟩

private theorem cocycleHom_coeff_formalGroup (n : ℕ+) (d : Fin 2 →₀ ℕ) :
    cocycleHom n (coeff d formalGroup.toPowerSeries) =
      coeff d (X 0 + X 1) +
        DualNumber.eps * (lazardCocycle ((n : ℕ) + 1) (DualNumber ℤ)).coeff d := by
  rw [← coeff_map, ← FormalGroup.map_toPowerSeries, cocycleHom, map_lift,
    MvPolynomial.IsAddCocycle₂.toPowerSeries_formalGroup, map_add, MvPolynomial.coeff_coe,
    MvPolynomial.coeff_smul, smul_eq_mul]

/-- The first component of `cocycleHom n` is the augmentation. -/
private theorem fst_cocycleHom (n : ℕ+) (x : LazardRing) :
    (cocycleHom n x).fst = augmentation x := by
  have : (TrivSqZeroExt.fstHom ℤ ℤ ℤ).toRingHom.comp (cocycleHom n) = augmentation := by
    refine hom_ext (FormalGroup.ext (MvPowerSeries.ext fun d ↦ ?_))
    simp only [FormalGroup.map_toPowerSeries, coeff_map, RingHom.comp_apply,
      cocycleHom_coeff_formalGroup, augmentation_coeff_formalGroup]
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, TrivSqZeroExt.fstHom_apply,
      TrivSqZeroExt.fst_mul, DualNumber.fst_eps, zero_mul, add_zero, map_add,
      MvPowerSeries.coeff_X]
    split_ifs <;> simp
  exact RingHom.congr_fun this x

/-- `cocycleHom n` kills the square of the augmentation ideal. -/
private theorem cocycleHom_eq_zero_of_mem (n : ℕ+) {x : LazardRing}
    (hx : x ∈ augmentationIdeal ^ 2) : cocycleHom n x = 0 := by
  rw [pow_two] at hx
  refine Submodule.mul_induction_on hx (fun y hy z hz ↦ ?_) fun y z hy hz ↦ by
    rw [map_add, hy, hz, add_zero]
  rw [mem_augmentationIdeal] at hy hz
  ext
  · rw [map_mul, TrivSqZeroExt.fst_mul, fst_cocycleHom, fst_cocycleHom, hy, hz, mul_zero,
      TrivSqZeroExt.fst_zero]
  · rw [map_mul, DualNumber.snd_mul, fst_cocycleHom, fst_cocycleHom, hy, hz, zero_mul, mul_zero,
      add_zero, TrivSqZeroExt.snd_zero]

/-- `cocycleHom n` detects the generator `xₙ` and kills the other generators. -/
private theorem snd_cocycleHom_generator (n m : ℕ+) :
    (cocycleHom n (generator m)).snd = if m = n then 1 else 0 := by
  rw [generator, map_sum, TrivSqZeroExt.snd_sum]
  have h (i : ℕ) (hi : i ∈ Icc 1 (m : ℕ)) :
      (cocycleHom n (bezout (m + 1) i •
        coeff (single 0 i + single 1 (m + 1 - i)) formalGroup.toPowerSeries)).snd =
      if m = n then ((n + 1 : ℕ).choose i / lazardGcd (n + 1) : ℕ) * bezout (n + 1) i else 0 := by
    rw [mem_Icc] at hi
    have hX : coeff (single 0 i + single 1 ((m : ℕ) + 1 - i))
        (X 0 + X 1 : MvPowerSeries (Fin 2) (DualNumber ℤ)) = 0 := by
      simp only [map_add, MvPowerSeries.coeff_X, Finsupp.ext_iff, Fin.forall_fin_two]
      have h₁ : ¬(i = 1 ∧ (m : ℕ) + 1 - i = 0) := by omega
      have h₂ : ¬(i = 0 ∧ (m : ℕ) + 1 - i = 1) := by omega
      simp [h₁, h₂]
    rw [map_zsmul, TrivSqZeroExt.snd_smul, cocycleHom_coeff_formalGroup, hX, zero_add,
      coeff_lazardCocycle]
    by_cases hmn : m = n
    · subst hmn
      simp [show i ≠ 0 by omega, show (m : ℕ) + 1 - i ≠ 0 by omega, show i + (m + 1 - i) = m + 1 by
        omega, mul_comm]
    · have hmn' : (m : ℕ) ≠ n := fun h ↦ hmn (PNat.coe_injective h)
      simp [hmn, show i + (m + 1 - i) ≠ n + 1 by omega]
  rw [sum_congr rfl h]
  split_ifs with hmn
  · subst hmn
    have h := sum_bezout (n := (m : ℕ) + 1) (by have := m.pos; omega)
    rwa [Nat.add_sub_cancel] at h
  · simp

/-! ### The basis of the indecomposables -/

/-- The classes of the generators `xₙ` are linearly independent in `I ⧸ I²`. -/
private theorem linearIndependent_toCotangent_generator :
    LinearIndependent ℤ fun n ↦
      augmentationIdeal.toCotangent ⟨generator n, generator_mem_augmentationIdeal n⟩ := by
  rw [linearIndependent_iff']
  intro s g hg n hn
  have hg' : augmentationIdeal.toCotangent
      (∑ i ∈ s, g i • ⟨generator i, generator_mem_augmentationIdeal i⟩) = 0 := by
    rw [map_sum]
    simpa only [map_zsmul] using hg
  have := congrArg TrivSqZeroExt.snd
    (cocycleHom_eq_zero_of_mem n ((augmentationIdeal.toCotangent_eq_zero _).1 hg'))
  simp only [Submodule.coe_sum, Submodule.coe_smul_of_tower, map_sum, map_zsmul,
    TrivSqZeroExt.snd_sum, TrivSqZeroExt.snd_smul, snd_cocycleHom_generator,
    TrivSqZeroExt.snd_zero] at this
  simpa [Finset.sum_ite_eq', hn] using this

/-- The classes of the generators `xₙ` span `I ⧸ I²` over `ℤ`. -/
private theorem span_toCotangent_generator :
    ⊤ ≤ Submodule.span ℤ (Set.range fun n ↦
      augmentationIdeal.toCotangent ⟨generator n, generator_mem_augmentationIdeal n⟩) := by
  set S := Submodule.span ℤ (Set.range fun n ↦
    augmentationIdeal.toCotangent ⟨generator n, generator_mem_augmentationIdeal n⟩)
  rintro z -
  obtain ⟨⟨x, hx⟩, rfl⟩ := augmentationIdeal.toCotangent_surjective z
  have hx' : x ∈ Ideal.span (Set.range fun ij ↦ mk (MvPolynomial.X ij)) :=
    augmentationIdeal_eq_span ▸ hx
  refine Submodule.span_induction
    (p := fun y _ ↦ ∀ h : y ∈ augmentationIdeal, augmentationIdeal.toCotangent ⟨y, h⟩ ∈ S)
    ?_ ?_ ?_ ?_ hx' hx
  · rintro _ ⟨⟨i, j⟩, rfl⟩ h
    -- `aᵢⱼ` is congruent to a multiple of `x_{i+j-1}` modulo `I²`.
    have hi := i.pos
    have hj := j.pos
    set n : ℕ+ := ⟨i + j - 1, by omega⟩
    have hmem := coeff_formalGroup_sub_nsmul_generator_mem_sq n hi (by simp [n]; omega)
    rw [show (n : ℕ) + 1 - i = j by simp [n]; omega, coeff_formalGroup] at hmem
    have h' := (augmentationIdeal.toCotangent_eq (x := ⟨_, h⟩)
      (y := ((n + 1 : ℕ).choose i / lazardGcd (n + 1)) •
        ⟨generator n, generator_mem_augmentationIdeal n⟩)).2 hmem
    rw [h', map_nsmul]
    exact Submodule.smul_of_tower_mem _ _ (Submodule.subset_span ⟨n, rfl⟩)
  · intro h
    rw [(Submodule.mk_eq_zero _ h).2 rfl, map_zero]
    exact S.zero_mem
  · intro y z hy' hz' hy hz h
    have hyI : y ∈ augmentationIdeal := augmentationIdeal_eq_span ▸ hy'
    have hzI : z ∈ augmentationIdeal := augmentationIdeal_eq_span ▸ hz'
    rw [show (⟨y + z, h⟩ : augmentationIdeal) = ⟨y, hyI⟩ + ⟨z, hzI⟩ from
      Subtype.ext (Submodule.coe_add (⟨y, hyI⟩ : augmentationIdeal) ⟨z, hzI⟩).symm, map_add]
    exact S.add_mem (hy hyI) (hz hzI)
  · intro c y hy' hy h
    have hyI : y ∈ augmentationIdeal := augmentationIdeal_eq_span ▸ hy'
    -- `c • y ≡ η(c) • y` modulo `I²`, since `c - η(c) ∈ I` for the augmentation `η`.
    have hc : c - (augmentation c : LazardRing) ∈ augmentationIdeal := by
      simp [mem_augmentationIdeal]
    have h' : augmentationIdeal.toCotangent ⟨c • y, h⟩ =
        augmentationIdeal.toCotangent (augmentation c • ⟨y, hyI⟩) := by
      rw [augmentationIdeal.toCotangent_eq, pow_two]
      convert Ideal.mul_mem_mul hc hyI using 1
      simp [sub_mul, zsmul_eq_mul]
    rw [h', map_zsmul]
    exact S.smul_mem _ (hy hyI)

/-- **Lazard's computation of the indecomposables of the Lazard ring.** The `ℤ`-module
`I ⧸ I²` of indecomposables of `L`, for `I` the augmentation ideal, is free with basis the classes
of the generators `xₙ ∈ L₂ₙ`, `n ≥ 1`. -/
def cotangentBasis : Module.Basis ℕ+ ℤ augmentationIdeal.Cotangent :=
  Module.Basis.mk linearIndependent_toCotangent_generator span_toCotangent_generator

/-- The `n`-th vector of the basis of the indecomposables is the class of the generator `xₙ`. -/
@[simp]
theorem cotangentBasis_apply (n : ℕ+) :
    cotangentBasis n =
      augmentationIdeal.toCotangent ⟨generator n, generator_mem_augmentationIdeal n⟩ :=
  Module.Basis.mk_apply _ _ n

end TauCeti.LazardRing
