/-!
# The height ideals of a formal group law

Let `F` be a formal group law over a commutative ring `R` and let `p` be a prime. The `n`-th
**height ideal** `I_n(F)` (`FormalGroup.heightIdeal`) is the ideal generated by the coefficients of
the `p`-series `[p]_F(X)` in degrees below `pⁿ`. Equivalently, a ring homomorphism `φ : R →+* S`
kills `I_n(F)` exactly when the `p`-series of the base change of `F` along `φ` vanishes to order
`pⁿ` (`FormalGroup.heightIdeal_le_ker_iff`), so `R ⧸ I_n(F)` is the universal quotient of `R` over
which `[p]_F` vanishes to order `pⁿ`. Over a field of characteristic `p` the height ideal `I_n`
is zero when the height of `F` is at least `n`, and the unit ideal otherwise
(`FormalGroup.heightIdeal_eq_bot_iff_le_height`, `FormalGroup.heightIdeal_eq_top_iff_height_lt`).

For commutative `F` these are Landweber's ideals `I_n = (v₀, v₁, …, v_(n-1))`: `I₀ = 0`, `I₁ = (p)`,
and `I_(n+1) = I_n + (v_n)`, where `v_n` is the coefficient of `X^(pⁿ)` in `[p]_F`
(`FormalGroup.heightIdeal_succ`). Only the class of `v_n` modulo `I_n` matters
(`FormalGroup.heightIdeal_succ_eq_sup_of_sub_mem`). The proof works over `R ⧸ (I_n + (v_n))`: there
`p = 0`, so the `p`-series of a commutative formal group law is either zero or has order a power
of `p` (`FormalGroup.exists_order_nsmulSeries_eq_pow`), and order greater than `pⁿ` then forces
order at least `p^(n+1)`.

The height ideals do not depend on the coordinate: isomorphic formal group laws have the same
height ideals (`TauCeti.FormalGroupIso.heightIdeal_eq`), and the height ideals commute with base
change (`FormalGroup.map_heightIdeal`). For the universal formal group law over the Lazard ring `L`
and the universal strict coordinate change over `L[b₁, b₂, …]`, this says that the height ideals of
`L` are invariant ideals of the Hopf algebroid `(L, L[b₁, b₂, …])`: their extensions along the left
and right units agree (`TauCeti.LazardRing.map_rightUnit_heightIdeal`, stated with the rest
of the Hopf algebroid in `TauCeti.RingTheory.FormalGroup.CoordinateChange.HopfAlgebroid`).
Through Quillen's identification of `L` with `MU_*`, these are the ideals `I_(p,n)` in the
hypothesis of Landweber's exact functor theorem.

The class of `v_n` modulo `I_n` does not depend on the coordinate either. Modulo `I_n(F) + I_n(G)`
both `p`-series begin in degree `pⁿ`, so a homomorphism `F → G` with linear coefficient `u`
relates their coefficients `a` and `b` of `X^(pⁿ)` by `b u^(pⁿ) ≡ u a`
(`TauCeti.FormalGroupHom.coeff_nsmulSeries_mul_coeff_one_pow_sub_mem_heightIdeal`), and a strict
isomorphism preserves the class of `v_n`
(`TauCeti.FormalGroupIso.coeff_nsmulSeries_sub_mem_heightIdeal_of_isStrict`). Over `L` this is the
congruence `η_R(v_n) ≡ η_L(v_n)` modulo `I_n`
(`TauCeti.LazardRing.rightUnit_sub_C_mem_map_heightIdeal`).

## Main definitions

* `FormalGroup.heightIdeal`: the ideal generated by the coefficients of `[p]_F` below degree `pⁿ`.

## Main results

* `FormalGroup.heightIdeal_le_ker_iff`: a ring homomorphism kills `I_n(F)` exactly when the
  `p`-series of the base change of `F` vanishes to order `pⁿ`.
* `FormalGroup.map_heightIdeal`: the height ideals commute with base change.
* `TauCeti.FormalGroupIso.heightIdeal_eq`: isomorphic formal group laws have the same height
  ideals.
* `TauCeti.FormalGroupIso.coeff_nsmulSeries_sub_mem_heightIdeal_of_isStrict`: strictly isomorphic
  formal group laws have the same coefficient `v_n` modulo `I_n`.
* `FormalGroup.heightIdeal_𝔾ₘ_eq_top` and `FormalGroup.heightIdeal_𝔾ₐ`: `I_n(𝔾ₘ)` is the unit
  ideal for `n ≥ 2`, while `I_n(𝔾ₐ) = (p)` for `n ≥ 1`.
* `FormalGroup.heightIdeal_succ`: `I_(n+1) = I_n + (v_n)` for commutative `F`.
* `FormalGroup.heightIdeal_one`: `I₁ = (p)` for commutative `F`.
* `FormalGroup.heightIdeal_eq_span`: `I_n = (v₀, …, v_(n-1))` for commutative `F`.
* `FormalGroup.heightIdeal_succ_eq_top_iff`: `I_(n+1) = R` for commutative `F` exactly when `v_n`
  is a unit modulo `I_n`.
* `FormalGroup.isWeaklyRegular_ofFn_coeff_nsmulSeries_iff_of_heightIdeal_succ_eq_top`: when
  `I_(n+1)(F) = R`, Landweber's sequence `(v₀, …, v_(m-1))` for `m ≥ n` is weakly regular on `M`
  iff `(v₀, …, v_(n-1))` is.
* `FormalGroup.heightIdeal_eq_bot_iff_le_height` and `FormalGroup.heightIdeal_eq_top_iff_height_lt`:
  over a field of characteristic `p`, `I_n = 0` when `F` has height at least `n`, and `I_n = K`
  otherwise.
* `FormalGroup.heightIdeal_eq_top_iff_forall_height_lt`: for `n ≥ 1`, `I_n(F) = R` exactly when
  every base change of `F` to a field of characteristic `p` has height less than `n`.

## References

* P. S. Landweber, *Homological properties of comodules over `MU_*(MU)` and `BP_*(BP)`*,
  Amer. J. Math. 98 (1976), 591–610.
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres*, Chapter 4.
-/

public section

namespace FormalGroup

variable {R S : Type*} [CommRing R] [CommRing S]

/-- The `n`-th **height ideal** of a formal group law `F` at `p`: the ideal generated by the
coefficients of the `p`-series `[p]_F(X)` in degrees below `pⁿ`, that is, the smallest ideal
modulo which `[p]_F` vanishes to order `pⁿ`. -/
noncomputable def heightIdeal (F : FormalGroup R) (p n : ℕ) : Ideal R :=
  Ideal.span ((fun k ↦ PowerSeries.coeff k (F.nsmulSeries p)) '' Set.Iio (p ^ n))

variable {F : FormalGroup R} {p : ℕ}

/-- The height ideal `I_n(F)` is contained in an ideal `I` exactly when the coefficients of `[p]_F`
below degree `pⁿ` lie in `I`. -/
theorem heightIdeal_le_iff {n : ℕ} {I : Ideal R} :
    F.heightIdeal p n ≤ I ↔ ∀ k < p ^ n, PowerSeries.coeff k (F.nsmulSeries p) ∈ I := by
  simp [heightIdeal, Ideal.span_le, Set.subset_def]

/-- The coefficients of `[p]_F` below degree `pⁿ` lie in the height ideal `I_n(F)`. -/
theorem coeff_nsmulSeries_mem_heightIdeal {n k : ℕ} (hk : k < p ^ n) :
    PowerSeries.coeff k (F.nsmulSeries p) ∈ F.heightIdeal p n :=
  heightIdeal_le_iff.mp le_rfl k hk

/-- **The universal property of the height ideal.** A ring homomorphism `φ` kills `I_n(F)` exactly
when the `p`-series of the base change of `F` along `φ` vanishes to order `pⁿ`. -/
theorem heightIdeal_le_ker_iff {n : ℕ} (φ : R →+* S) :
    F.heightIdeal p n ≤ RingHom.ker φ ↔ ((p ^ n : ℕ) : ℕ∞) ≤ ((F.map φ).nsmulSeries p).order := by
  simp only [heightIdeal_le_iff, RingHom.mem_ker, PowerSeries.nat_le_order_iff,
    coeff_nsmulSeries_map]

/-- The height ideal `I_n(F)` vanishes exactly when `[p]_F` vanishes to order `pⁿ`. -/
theorem heightIdeal_eq_bot_iff {n : ℕ} :
    F.heightIdeal p n = ⊥ ↔ ((p ^ n : ℕ) : ℕ∞) ≤ (F.nsmulSeries p).order := by
  simp only [← le_bot_iff, heightIdeal_le_iff, Ideal.mem_bot, PowerSeries.nat_le_order_iff]

/-- The zeroth height ideal is zero, since `[p]_F` has no constant term. -/
@[simp]
theorem heightIdeal_zero : F.heightIdeal p 0 = ⊥ := by
  rw [heightIdeal_eq_bot_iff, pow_zero, Nat.cast_one, Order.one_le_iff_ne_zero,
    PowerSeries.order_ne_zero_iff_constCoeff_eq_zero]
  exact F.constantCoeff_nsmulSeries p

/-- The height ideals increase with `n`. -/
theorem heightIdeal_mono : Monotone (F.heightIdeal p) := fun _ _ hmn ↦
  heightIdeal_le_iff.mpr fun _ hk ↦ by
    rcases p.eq_zero_or_pos with rfl | hp
    · simp
    · exact coeff_nsmulSeries_mem_heightIdeal (hk.trans_le (Nat.pow_le_pow_right hp hmn))

/-- The height ideals commute with base change. -/
@[simp]
theorem map_heightIdeal (φ : R →+* S) (n : ℕ) :
    (F.heightIdeal p n).map φ = (F.map φ).heightIdeal p n := by
  simp only [heightIdeal, Ideal.map_span, Set.image_image, coeff_nsmulSeries_map]

end FormalGroup

/-- **Coordinate independence of the height ideals**: isomorphic formal group laws have the same
height ideals. -/
theorem TauCeti.FormalGroupIso.heightIdeal_eq {R : Type*} [CommRing R] {F G : FormalGroup R}
    (e : FormalGroupIso F G) (p n : ℕ) : F.heightIdeal p n = G.heightIdeal p n := by
  suffices h : ∀ {F G : FormalGroup R}, FormalGroupIso F G → F.heightIdeal p n ≤ G.heightIdeal p n
    from le_antisymm (h e) (h e.symm)
  intro F G e
  rw [← Ideal.mk_ker (I := G.heightIdeal p n), FormalGroup.heightIdeal_le_ker_iff,
    (e.map _).order_nsmulSeries_eq, ← FormalGroup.heightIdeal_le_ker_iff, Ideal.mk_ker]

/-- **A homomorphism relates the coefficients `v_n` modulo the height ideals.** If `f` is a
homomorphism of formal group laws from `F` to `G` with linear coefficient `u`, and `a` and `b` are
the coefficients of `X^(pⁿ)` in `[p]_F` and `[p]_G`, then `b u^(pⁿ) ≡ u a` modulo
`I_n(F) + I_n(G)`. -/
theorem TauCeti.FormalGroupHom.coeff_nsmulSeries_mul_coeff_one_pow_sub_mem_heightIdeal
    {R : Type*} [CommRing R] {F G : FormalGroup R} (f : FormalGroupHom F G) (p n : ℕ) :
    PowerSeries.coeff (p ^ n) (G.nsmulSeries p) * PowerSeries.coeff 1 f.toPowerSeries ^ (p ^ n) -
        PowerSeries.coeff 1 f.toPowerSeries * PowerSeries.coeff (p ^ n) (F.nsmulSeries p) ∈
      F.heightIdeal p n ⊔ G.heightIdeal p n := by
  set I := F.heightIdeal p n ⊔ G.heightIdeal p n
  -- modulo `I`, both `p`-series vanish to order `pⁿ`
  have hle (H : FormalGroup R) (hH : H.heightIdeal p n ≤ I) :
      ((p ^ n : ℕ) : ℕ∞) ≤ ((H.map (Ideal.Quotient.mk I)).nsmulSeries p).order := by
    rwa [← FormalGroup.heightIdeal_le_ker_iff, Ideal.mk_ker]
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
  simpa [FormalGroup.coeff_nsmulSeries_map] using
    (f.map (Ideal.Quotient.mk I)).coeff_nsmulSeries_mul_coeff_one_pow_of_le_order p
      (hle F le_sup_left) (hle G le_sup_right)

/-- **Coordinate independence of `v_n` modulo `I_n`.** If `e` is a strict isomorphism of formal
group laws from `F` to `G`, then the coefficients of `X^(pⁿ)` in `[p]_F` and `[p]_G` agree modulo
the height ideal `I_n(F) = I_n(G)`. -/
theorem TauCeti.FormalGroupIso.coeff_nsmulSeries_sub_mem_heightIdeal_of_isStrict
    {R : Type*} [CommRing R] {F G : FormalGroup R} (e : FormalGroupIso F G) [e.IsStrict]
    (p n : ℕ) :
    PowerSeries.coeff (p ^ n) (G.nsmulSeries p) - PowerSeries.coeff (p ^ n) (F.nsmulSeries p) ∈
      F.heightIdeal p n := by
  have h := e.toHom.coeff_nsmulSeries_mul_coeff_one_pow_sub_mem_heightIdeal p n
  rwa [FormalGroupIso.IsStrict.coeff_one, one_pow, mul_one, one_mul, ← e.heightIdeal_eq,
    sup_idem] at h

namespace FormalGroup

variable {R : Type*} [CommRing R] {p : ℕ}

/-- The height ideals are unchanged by a change of coordinate `φ • F`. -/
@[simp]
theorem heightIdeal_smul (φ : TauCeti.FormalCoordinate R) (F : FormalGroup R) (n : ℕ) :
    (φ • F).heightIdeal p n = F.heightIdeal p n :=
  ((smulIso φ F).heightIdeal_eq p n).symm

/-- The height ideals of the multiplicative formal group law `X + Y + XY` from `I₂` on are the unit
ideal: the coefficient of `Xᵖ` in its `p`-series `(1 + X)ᵖ - 1` is `1`. -/
@[simp]
theorem heightIdeal_𝔾ₘ_eq_top (hp : 1 < p) {n : ℕ} (hn : 2 ≤ n) :
    (𝔾ₘ : FormalGroup R).heightIdeal p n = ⊤ := by
  have hn' : 1 < n := by omega
  rw [Ideal.eq_top_iff_one]
  convert coeff_nsmulSeries_mem_heightIdeal (F := (𝔾ₘ : FormalGroup R)) (k := p)
    (by simpa using Nat.pow_lt_pow_right hp hn')
  rw [nsmulSeries_𝔾ₘ, map_sub, add_comm, add_pow]
  simp [PowerSeries.coeff_X_pow, PowerSeries.coeff_one, (zero_lt_one.trans hp).ne']

/-- The height ideals `I_n` of the additive formal group law `X + Y` with `n ≥ 1` are all `(p)`:
its `p`-series `p X` has no coefficient beyond the linear one. -/
@[simp]
theorem heightIdeal_𝔾ₐ (hp : 1 < p) {n : ℕ} (hn : n ≠ 0) :
    (𝔾ₐ : FormalGroup R).heightIdeal p n = Ideal.span {(p : R)} := by
  refine le_antisymm (heightIdeal_le_iff.mpr fun k _ ↦ ?_) ?_
  · rw [nsmulSeries_𝔾ₐ, PowerSeries.coeff_natCast_mul, PowerSeries.coeff_X]
    split_ifs <;> simp
  · rw [Ideal.span_singleton_le_iff_mem]
    convert coeff_nsmulSeries_mem_heightIdeal (F := (𝔾ₐ : FormalGroup R)) (k := 1)
      (Nat.one_lt_pow hn hp) using 1
    simp

variable (F : FormalGroup R) [F.IsComm]

/-- **Landweber's recursion for the height ideals.** For a commutative formal group law `F` and a
prime `p`, `I_(n+1)(F) = I_n(F) + (v_n)`, where `v_n` is the coefficient of `X^(pⁿ)` in `[p]_F`. -/
theorem heightIdeal_succ (hp : p.Prime) (n : ℕ) :
    F.heightIdeal p (n + 1) =
      F.heightIdeal p n ⊔ Ideal.span {PowerSeries.coeff (p ^ n) (F.nsmulSeries p)} := by
  refine le_antisymm ?_ (sup_le (heightIdeal_mono n.le_succ)
    ((Ideal.span_singleton_le_iff_mem _).mpr
      (coeff_nsmulSeries_mem_heightIdeal (Nat.pow_lt_pow_right hp.one_lt n.lt_succ_self))))
  set J := F.heightIdeal p n ⊔ Ideal.span {PowerSeries.coeff (p ^ n) (F.nsmulSeries p)}
  have hJ (k : ℕ) (hk : k ≤ p ^ n) : PowerSeries.coeff k (F.nsmulSeries p) ∈ J := by
    rcases hk.lt_or_eq with hk | rfl
    · exact Ideal.mem_sup_left (coeff_nsmulSeries_mem_heightIdeal hk)
    · exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
  rw [← Ideal.mk_ker (I := J), heightIdeal_le_ker_iff]
  -- over `R ⧸ J`, the prime `p` vanishes, since it is the linear coefficient of `[p]_F`
  have hpJ : ((p : ℕ) : R ⧸ J) = 0 := by
    rw [← map_natCast (Ideal.Quotient.mk J), ← F.coeff_one_nsmulSeries p,
      Ideal.Quotient.eq_zero_iff_mem]
    exact hJ 1 (Nat.one_le_pow _ _ hp.pos)
  -- and the `p`-series vanishes to order `pⁿ + 1`
  have hord : ((p ^ n + 1 : ℕ) : ℕ∞) ≤ ((F.map (Ideal.Quotient.mk J)).nsmulSeries p).order := by
    refine PowerSeries.nat_le_order _ _ fun k hk ↦ ?_
    rw [coeff_nsmulSeries_map, Ideal.Quotient.eq_zero_iff_mem]
    exact hJ k (Nat.lt_succ_iff.mp hk)
  -- so its order, a power `p ^ h` of `p`, has `h > n`
  by_cases h0 : (F.map (Ideal.Quotient.mk J)).nsmulSeries p = 0
  · simp [h0]
  obtain ⟨h, -, hh⟩ := (F.map (Ideal.Quotient.mk J)).exists_order_nsmulSeries_eq_pow hp hpJ h0
  rw [hh, Nat.cast_le] at hord ⊢
  exact Nat.pow_le_pow_right hp.pos ((Nat.pow_lt_pow_iff_right hp.one_lt).mp hord)

/-- The recursion `I_(n+1) = I_n + (v_n)` holds for every lift `v` of `v_n` modulo `I_n`. -/
theorem heightIdeal_succ_eq_sup_of_sub_mem (hp : p.Prime) {n : ℕ} {v : R}
    (hv : v - PowerSeries.coeff (p ^ n) (F.nsmulSeries p) ∈ F.heightIdeal p n) :
    F.heightIdeal p (n + 1) = F.heightIdeal p n ⊔ Ideal.span {v} := by
  rw [F.heightIdeal_succ hp]
  refine le_antisymm (sup_le le_sup_left ?_) (sup_le le_sup_left ?_) <;>
    rw [Ideal.span_singleton_le_iff_mem]
  · exact sub_sub_cancel v (PowerSeries.coeff (p ^ n) (F.nsmulSeries p)) ▸
      Ideal.sub_mem _ (Ideal.mem_sup_right (Ideal.mem_span_singleton_self v))
        (Ideal.mem_sup_left hv)
  · exact sub_add_cancel v (PowerSeries.coeff (p ^ n) (F.nsmulSeries p)) ▸
      Ideal.add_mem _ (Ideal.mem_sup_left hv)
        (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))

/-- For a commutative formal group law and a prime `p`, the height ideal `I_(n+1)(F)` is the unit
ideal exactly when Landweber's generator `v_n`, the coefficient of `X^(pⁿ)` in `[p]_F`, is a unit
modulo `I_n(F)`. -/
theorem heightIdeal_succ_eq_top_iff (hp : p.Prime) (n : ℕ) :
    F.heightIdeal p (n + 1) = ⊤ ↔
      IsUnit (Ideal.Quotient.mk (F.heightIdeal p n)
        (PowerSeries.coeff (p ^ n) (F.nsmulSeries p))) := by
  rw [F.heightIdeal_succ hp, sup_comm, ← Ideal.Quotient.isUnit_mk_iff]

/-- The first height ideal is generated by `p`. -/
theorem heightIdeal_one (hp : p.Prime) : F.heightIdeal p 1 = Ideal.span {(p : R)} := by
  simpa using F.heightIdeal_succ hp 0

/-- **Landweber's generators.** `I_n(F) = (v₀, …, v_(n-1))`, where `v_i` is the coefficient of
`X^(pⁱ)` in `[p]_F`; in particular `v₀ = p`. -/
theorem heightIdeal_eq_span (hp : p.Prime) (n : ℕ) :
    F.heightIdeal p n =
      Ideal.span ((fun i ↦ PowerSeries.coeff (p ^ i) (F.nsmulSeries p)) '' Set.Iio n) := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hI : Set.Iio (n + 1) = insert n (Set.Iio n) := by
      ext; simp
    rw [F.heightIdeal_succ hp, ih, hI, Set.image_insert_eq, Ideal.span_insert, sup_comm]

/-- **Truncation of Landweber sequences when `I_(n+1)(F) = R`.** For a commutative formal group law
`F` with `I_(n+1)(F) = ⊤`, a prime `p`, an `R`-module `M`, and `m ≥ n`, the Landweber sequence
`(v₀, …, v_(m-1))` is weakly regular on `M` if and only if `(v₀, …, v_(n-1))` is: `v_n` is a unit
modulo `I_n(F) = (v₀, …, v_(n-1))`, so it acts regularly on `M ⧸ I_n(F) • ⊤` and kills the
remaining quotient. -/
theorem isWeaklyRegular_ofFn_coeff_nsmulSeries_iff_of_heightIdeal_succ_eq_top (hp : p.Prime)
    (M : Type*) [AddCommGroup M] [Module R M] {n m : ℕ} (hnm : n ≤ m)
    (hI : F.heightIdeal p (n + 1) = ⊤) :
    RingTheory.Sequence.IsWeaklyRegular M
        (List.ofFn fun i : Fin m ↦ PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p)) ↔
      RingTheory.Sequence.IsWeaklyRegular M
        (List.ofFn fun i : Fin n ↦ PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p)) := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnm
  have hsplit : (List.ofFn fun i : Fin (n + k) ↦
        PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p)) =
      (List.ofFn fun i : Fin n ↦ PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p)) ++
        List.ofFn fun j : Fin k ↦ PowerSeries.coeff (p ^ (n + j : ℕ)) (F.nsmulSeries p) := by
    rw [List.ofFn_add]
    simp
  have hspan : Ideal.ofList
      (List.ofFn fun i : Fin n ↦ PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p)) =
        F.heightIdeal p n := by
    rw [Ideal.ofList_ofFn, F.heightIdeal_eq_span hp n]
    congr 1
    ext x
    simp only [Set.mem_range, Set.mem_image, Set.mem_Iio]
    exact ⟨fun ⟨i, hi⟩ ↦ ⟨i, i.2, hi⟩, fun ⟨j, hj, hx⟩ ↦ ⟨⟨j, hj⟩, hx⟩⟩
  rw [hsplit, RingTheory.Sequence.isWeaklyRegular_append_iff, hspan]
  refine and_iff_left ?_
  rcases k with _ | k
  · exact RingTheory.Sequence.IsWeaklyRegular.nil R _
  · rw [List.ofFn_succ]
    simp only [Fin.val_zero]
    exact RingTheory.Sequence.IsWeaklyRegular.cons_of_isUnit_mk
      ((F.heightIdeal_succ_eq_top_iff hp n).mp hI) _

omit [F.IsComm] in
/-- The height ideals of a formal group law are finitely generated. -/
theorem heightIdeal_fg (n : ℕ) : (F.heightIdeal p n).FG :=
  Submodule.fg_span ((Set.finite_Iio (p ^ n)).image _)

end FormalGroup

namespace FormalGroup

section Field

variable {K : Type*} [Field K] (F : FormalGroup K) [F.IsComm] {p : ℕ} [CharP K p]

/-- Over a field of characteristic `p`, the height ideal `I_n(F)` is zero exactly when `F` has
height at least `n`. -/
theorem heightIdeal_eq_bot_iff_le_height {n : ℕ} : F.heightIdeal p n = ⊥ ↔ n ≤ F.height p := by
  rw [heightIdeal_eq_bot_iff]
  by_cases h0 : F.nsmulSeries p = 0
  · simp [h0, F.height_eq_top_iff.mpr h0]
  obtain hp | rfl := CharP.char_is_prime_or_zero K p
  · obtain ⟨h, -, hh⟩ := F.exists_order_nsmulSeries_eq_pow hp (CharP.cast_eq_zero K p) h0
    rw [hh, F.height_eq_natCast_iff.mpr hh, Nat.cast_le, Nat.cast_le,
      Nat.pow_le_pow_iff_right hp.one_lt]
  · exact absurd (by simp) h0

/-- Over a field of characteristic `p`, the height ideal `I_n(F)` is the unit ideal exactly when `F`
has height less than `n`. -/
theorem heightIdeal_eq_top_iff_height_lt {n : ℕ} : F.heightIdeal p n = ⊤ ↔ F.height p < n := by
  rw [← not_le, ← heightIdeal_eq_bot_iff_le_height]
  exact ⟨fun h hb ↦ bot_ne_top (hb.symm.trans h), (Ideal.eq_bot_or_top _).resolve_left⟩

end Field

universe u in
/-- **Fieldwise criterion for `I_n(F) = R`.** For `n ≥ 1` and a prime `p`, the `n`-th height ideal
of a commutative formal group law `F` over `R` is the unit ideal if and only if every base change
of `F` to a field of characteristic `p` has height strictly less than `n`. -/
theorem heightIdeal_eq_top_iff_forall_height_lt {R : Type u} [CommRing R] (F : FormalGroup R)
    [F.IsComm] {p : ℕ} (hp : p.Prime) {n : ℕ} (hn : 1 ≤ n) :
    F.heightIdeal p n = ⊤ ↔
      ∀ (K : Type u) [Field K] [CharP K p] (φ : R →+* K), (F.map φ).height p < n := by
  constructor
  · intro h K _ _ φ
    rw [← (F.map φ).heightIdeal_eq_top_iff_height_lt, ← F.map_heightIdeal, h, Ideal.map_top]
  · intro h
    by_contra hne
    obtain ⟨𝔪, h𝔪, hle⟩ := Ideal.exists_le_maximal (F.heightIdeal p n) hne
    let : Field (R ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    set π := Ideal.Quotient.mk 𝔪
    have hp0 : (p : R ⧸ 𝔪) = 0 := by
      rw [← map_natCast π, Ideal.Quotient.eq_zero_iff_mem]
      exact hle ((F.heightIdeal_mono (p := p) hn)
        ((F.heightIdeal_one hp) ▸ Ideal.mem_span_singleton_self _))
    have : CharP (R ⧸ 𝔪) p := ringChar.of_eq (CharP.ringChar_of_prime_eq_zero hp hp0)
    have htop : (F.map π).heightIdeal p n = ⊤ :=
      (F.map π).heightIdeal_eq_top_iff_height_lt.mpr (h (R ⧸ 𝔪) π)
    have hbot : (F.map π).heightIdeal p n ≤ ⊥ := by
      rw [← F.map_heightIdeal, Ideal.map_le_iff_le_comap, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      exact hle
    exact top_ne_bot (le_bot_iff.mp (htop ▸ hbot))

end FormalGroup
