/-!
# Landweber sequences and Landweber-regular modules for formal group laws

Let `F` be a formal group law over a commutative ring `R`. For a prime `p`, the coefficients
`v_i` of `X^(pⁱ)` in the `p`-series `[p]_F(X)` (with `v₀ = p`) generate the height ideals
`I_n(F) = (v₀, v₁, …, v_(n-1))` when `F` is commutative (`FormalGroup.heightIdeal_eq_span`).
Landweber's exact functor theorem asks that for every prime `p` and every `n`, the sequence
`(v₀, v₁, …, v_(n-1))` be weakly regular on an `R`-module `M`, that is, multiplication by `v_i`
be injective on `M ⧸ I_i(F) M` for every `i`.

This file packages the finite sequence `FormalGroup.landweberSequence F p n = [v₀, …, v_(n-1)]`
and the global module condition `FormalGroup.IsLandweberRegular F M`, and establishes their
foundational invariance and functoriality properties:

* **Independence of lifts.** Because `I_(i+1)(F) = I_i(F) + (w_i)` for any lift `w_i ≡ v_i`
  modulo `I_i(F)` (`FormalGroup.heightIdeal_succ_eq_sup_of_sub_mem`) and regularity on
  `M ⧸ I_i(F) M` depends only on the residue class modulo `I_i(F)`, weak regularity and regularity
  of `[w₀, …, w_(n-1)]` agree with those of `F.landweberSequence p n`
  (`FormalGroup.isWeaklyRegular_ofFn_iff_landweberSequence`,
  `FormalGroup.isRegular_ofFn_iff_landweberSequence`). This lets one replace `[p]_F` coefficients
  by Araki, Hazewinkel, or Hasse-invariant generators without changing regularity.
* **Isomorphism and coordinate invariance.** An isomorphism `e : FormalGroupIso F G` (not
  necessarily strict) has invertible linear coefficient `u`, and satisfies
  `v_i(G) u^(pⁱ) ≡ u v_i(F)` modulo `I_i(F) = I_i(G)`. Since `u` and `u^(pⁱ)` act as units on
  `M ⧸ I_i(F) M`, Landweber regularity is invariant under arbitrary formal group isomorphisms and
  coordinate changes (`TauCeti.FormalGroupIso.isWeaklyRegular_landweberSequence_iff`,
  `TauCeti.FormalGroupIso.isLandweberRegular_iff`).
* **Bounded height and standard formal groups.** Once `I_m(F) M = M`, all quotients `M ⧸ I_i(F) M`
  with `i ≥ m` vanish, so weak regularity of `F.landweberSequence p n` for all `n` reduces to
  `n = m`
  (`FormalGroup.forall_isWeaklyRegular_landweberSequence_iff_of_heightIdeal_smul_top_eq_top`).
  In particular, a module is Landweber regular for `𝔾ₘ` precisely when every prime acts
  injectively on it (`FormalGroup.isLandweberRegular_𝔾ₘ_iff`), and for `𝔾ₐ` precisely when every
  prime acts bijectively (`FormalGroup.isLandweberRegular_𝔾ₐ_iff`).
* **Flatness and base change.** Landweber regularity is preserved by tensoring with a flat module
  and by flat base change of rings and modules (`FormalGroup.IsLandweberRegular.lTensor`,
  `FormalGroup.IsLandweberRegular.of_flat_module`,
  `FormalGroup.IsLandweberRegular.of_flat_of_isBaseChange`).

## Main definitions

* `FormalGroup.landweberSequence`: the list `[v₀, v₁, …, v_(n-1)]` of `X^(pⁱ)`-coefficients of
  `[p]_F(X)` for `i < n`.
* `FormalGroup.IsLandweberRegular`: predicate that `F.landweberSequence p n` is weakly regular on
  `M` for every prime `p` and every `n : ℕ`.

## Main results

* `FormalGroup.ofList_landweberSequence`: for commutative `F` and prime `p`, the ideal generated by
  `F.landweberSequence p n` is `F.heightIdeal p n`.
* `FormalGroup.isWeaklyRegular_landweberSequence_iff`: weak regularity of
  `F.landweberSequence p n` is injectivity of `v_i` on `M ⧸ I_i(F) M` for all `i < n`.
* `FormalGroup.isWeaklyRegular_ofFn_iff_landweberSequence` and
  `FormalGroup.isRegular_ofFn_iff_landweberSequence`: replacing each `v_i` by any lift modulo
  `I_i(F)` preserves weak regularity and regularity.
* `TauCeti.FormalGroupIso.isWeaklyRegular_landweberSequence_iff` and
  `TauCeti.FormalGroupIso.isLandweberRegular_iff`: invariance under arbitrary formal group
  isomorphisms.
* `FormalGroup.IsLandweberRegular.of_flat_module` and `FormalGroup.IsLandweberRegular.of_flat`:
  stability under flat modules and flat algebras.
* `FormalGroup.isLandweberRegular_𝔾ₘ_iff` and `FormalGroup.isLandweberRegular_𝔾ₐ_iff`: explicit
  characterizations for the multiplicative and additive formal group laws.

## References

* P. S. Landweber, *Homological properties of comodules over `MU_*(MU)` and `BP_*(BP)`*,
  Amer. J. Math. 98 (1976), 591–610.
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres*, Chapter 4.
-/

public section

open RingTheory.Sequence Pointwise TensorProduct

namespace FormalGroup

section Basic

variable {R S : Type*} [CommRing R] [CommRing S]

/-- **Landweber's sequence** `[v₀, v₁, …, v_(n-1)]` of length `n` associated to a formal group law
`F` and a natural number `p`, where `v_i` is the coefficient of `X^(pⁱ)` in `[p]_F(X)` (so
`v₀ = p`). -/
noncomputable def landweberSequence (F : FormalGroup R) (p n : ℕ) : List R :=
  List.ofFn fun i : Fin n ↦ PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p)

theorem landweberSequence_def (F : FormalGroup R) (p n : ℕ) :
    F.landweberSequence p n =
      List.ofFn fun i : Fin n ↦ PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p) :=
  (rfl)

@[simp]
theorem length_landweberSequence (F : FormalGroup R) (p n : ℕ) :
    (F.landweberSequence p n).length = n := by
  simp [landweberSequence]

@[simp]
theorem getElem_landweberSequence (F : FormalGroup R) (p n : ℕ) (i : ℕ)
    (hi : i < (F.landweberSequence p n).length) :
    (F.landweberSequence p n)[i] = PowerSeries.coeff (p ^ i) (F.nsmulSeries p) := by
  simp [landweberSequence]

@[simp]
theorem landweberSequence_zero (F : FormalGroup R) (p : ℕ) :
    F.landweberSequence p 0 = [] :=
  (rfl)

theorem landweberSequence_succ (F : FormalGroup R) (p n : ℕ) :
    F.landweberSequence p (n + 1) =
      F.landweberSequence p n ++ [PowerSeries.coeff (p ^ n) (F.nsmulSeries p)] := by
  rw [landweberSequence, landweberSequence, List.ofFn_succ', List.concat_eq_append]
  rfl

@[simp]
theorem landweberSequence_one (F : FormalGroup R) (p : ℕ) :
    F.landweberSequence p 1 = [(p : R)] := by
  simp [landweberSequence]

theorem landweberSequence_two (F : FormalGroup R) (p : ℕ) :
    F.landweberSequence p 2 = [(p : R), PowerSeries.coeff p (F.nsmulSeries p)] := by
  simp [landweberSequence_succ]

@[simp]
theorem take_landweberSequence (F : FormalGroup R) (p m n : ℕ) :
    (F.landweberSequence p n).take m = F.landweberSequence p (min m n) :=
  List.ext_getElem (by simp) fun _ _ _ ↦ by simp

@[simp]
theorem map_landweberSequence (F : FormalGroup R) (φ : R →+* S) (p n : ℕ) :
    (F.landweberSequence p n).map φ = (F.map φ).landweberSequence p n :=
  List.ext_getElem (by simp) fun _ _ _ ↦ by simp [coeff_nsmulSeries_map]

/-- A formal group law `F` over `R` is **Landweber regular** on an `R`-module `M` if for every
prime `p` and every `n : ℕ`, the Landweber sequence `F.landweberSequence p n = [p, v₁, …, v_(n-1)]`
is a weakly regular sequence on `M`. -/
def IsLandweberRegular (F : FormalGroup R) (M : Type*) [AddCommGroup M] [Module R M] : Prop :=
  ∀ ⦃p : ℕ⦄, p.Prime → ∀ n : ℕ, IsWeaklyRegular M (F.landweberSequence p n)

theorem isLandweberRegular_def (F : FormalGroup R) (M : Type*) [AddCommGroup M] [Module R M] :
    F.IsLandweberRegular M ↔
      ∀ ⦃p : ℕ⦄, p.Prime → ∀ n : ℕ, IsWeaklyRegular M (F.landweberSequence p n) :=
  (Iff.rfl)

end Basic

section Comm

variable {R : Type*} [CommRing R] (F : FormalGroup R) [F.IsComm] {p : ℕ}

/-- Any sequence `w₀, …, w_(n-1)` congruent termwise to `v_i` modulo `I_i(F)` generates the height
ideal `I_n(F)`. -/
theorem ofList_ofFn_eq_heightIdeal_of_sub_mem (hp : p.Prime) {n : ℕ} {w : Fin n → R}
    (hw : ∀ i : Fin n, w i - PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p) ∈
      F.heightIdeal p i) :
    Ideal.ofList (List.ofFn w) = F.heightIdeal p n := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hlast := hw (Fin.last n)
    rw [Fin.val_last] at hlast
    rw [List.ofFn_succ', List.concat_eq_append, Ideal.ofList_append, Ideal.ofList_singleton,
      ih fun i ↦ hw i.castSucc, ← F.heightIdeal_succ_eq_sup_of_sub_mem hp hlast]

/-- For a commutative formal group law `F` and a prime `p`, the ideal generated by
`F.landweberSequence p n` is the height ideal `I_n(F)`. -/
@[simp]
theorem ofList_landweberSequence (hp : p.Prime) (n : ℕ) :
    Ideal.ofList (F.landweberSequence p n) = F.heightIdeal p n :=
  F.ofList_ofFn_eq_heightIdeal_of_sub_mem hp fun _ ↦ by simp

/-- **Lift-independent criterion for weak regularity.** If `w_i ≡ v_i` modulo `I_i(F)` for each
`i < n`, then `[w₀, …, w_(n-1)]` is weakly regular on `M` if and only if each `v_i` acts
injectively on `M ⧸ I_i(F) M`. -/
theorem isWeaklyRegular_ofFn_iff_of_sub_mem (hp : p.Prime) (M : Type*) [AddCommGroup M]
    [Module R M] {n : ℕ} {w : Fin n → R}
    (hw : ∀ i : Fin n, w i - PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p) ∈
      F.heightIdeal p i) :
    IsWeaklyRegular M (List.ofFn w) ↔
      ∀ i < n, IsSMulRegular (M ⧸ (F.heightIdeal p i • ⊤ : Submodule R M))
        (PowerSeries.coeff (p ^ i) (F.nsmulSeries p)) := by
  rw [isWeaklyRegular_iff]
  simp only [List.length_ofFn]
  refine forall_congr' fun i ↦ forall_congr' fun hi ↦ ?_
  have htake : (List.ofFn w).take i = List.ofFn fun j : Fin i ↦ w ⟨j, j.2.trans hi⟩ :=
    List.ext_getElem (by simp; omega) fun k _ _ ↦ by simp
  have hId : Ideal.ofList ((List.ofFn w).take i) = F.heightIdeal p i := by
    rw [htake]
    exact F.ofList_ofFn_eq_heightIdeal_of_sub_mem hp fun j ↦ hw ⟨j, j.2.trans hi⟩
  have hget : (List.ofFn w)[i]'(by simpa using hi) = w ⟨i, hi⟩ := by simp
  rw [hget, (Submodule.quotEquivOfEq _ _
    (congrArg (· • (⊤ : Submodule R M)) hId)).isSMulRegular_congr,
    (F.heightIdeal p i).isSMulRegular_quotient_smul_top_congr (hw ⟨i, hi⟩)]

/-- Weak regularity of `F.landweberSequence p n` on `M` is equivalent to regularity of `v_i` on
`M ⧸ I_i(F) M` for every `i < n`. -/
theorem isWeaklyRegular_landweberSequence_iff (hp : p.Prime) (M : Type*) [AddCommGroup M]
    [Module R M] (n : ℕ) :
    IsWeaklyRegular M (F.landweberSequence p n) ↔
      ∀ i < n, IsSMulRegular (M ⧸ (F.heightIdeal p i • ⊤ : Submodule R M))
        (PowerSeries.coeff (p ^ i) (F.nsmulSeries p)) :=
  F.isWeaklyRegular_ofFn_iff_of_sub_mem hp M fun _ ↦ by simp

/-- Replacing the coefficients `v_i` of `[p]_F` by any lifts `w_i ≡ v_i` modulo `I_i(F)` does not
change weak regularity on `M`. -/
theorem isWeaklyRegular_ofFn_iff_landweberSequence (hp : p.Prime) (M : Type*) [AddCommGroup M]
    [Module R M] {n : ℕ} {w : Fin n → R}
    (hw : ∀ i : Fin n, w i - PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p) ∈
      F.heightIdeal p i) :
    IsWeaklyRegular M (List.ofFn w) ↔ IsWeaklyRegular M (F.landweberSequence p n) :=
  (F.isWeaklyRegular_ofFn_iff_of_sub_mem hp M hw).trans
    (F.isWeaklyRegular_landweberSequence_iff hp M n).symm

/-- Replacing the coefficients `v_i` of `[p]_F` by any lifts `w_i ≡ v_i` modulo `I_i(F)` does not
change regularity on `M`. -/
theorem isRegular_ofFn_iff_landweberSequence (hp : p.Prime) (M : Type*) [AddCommGroup M]
    [Module R M] {n : ℕ} {w : Fin n → R}
    (hw : ∀ i : Fin n, w i - PowerSeries.coeff (p ^ (i : ℕ)) (F.nsmulSeries p) ∈
      F.heightIdeal p i) :
    IsRegular M (List.ofFn w) ↔ IsRegular M (F.landweberSequence p n) := by
  rw [isRegular_iff, isRegular_iff, F.isWeaklyRegular_ofFn_iff_landweberSequence hp M hw,
    F.ofList_ofFn_eq_heightIdeal_of_sub_mem hp hw, F.ofList_landweberSequence hp]

/-- For a commutative formal group law `F`, Landweber regularity on `M` is equivalent to
regularity of `v_n` on `M ⧸ I_n(F) M` for every prime `p` and every `n : ℕ`. -/
theorem isLandweberRegular_iff (M : Type*) [AddCommGroup M] [Module R M] :
    F.IsLandweberRegular M ↔
      ∀ ⦃p : ℕ⦄, p.Prime → ∀ n : ℕ,
        IsSMulRegular (M ⧸ (F.heightIdeal p n • ⊤ : Submodule R M))
          (PowerSeries.coeff (p ^ n) (F.nsmulSeries p)) := by
  refine forall₂_congr fun p hp ↦ ?_
  simp only [F.isWeaklyRegular_landweberSequence_iff hp M]
  exact ⟨fun h n ↦ h (n + 1) n n.lt_succ_self, fun h _ i _ ↦ h i⟩

/-- Once `I_m(F) M = M`, all quotients `M ⧸ I_i(F) M` for `i ≥ m` vanish, so weak regularity of
`F.landweberSequence p n` for all `n` reduces to `n = m`. -/
theorem forall_isWeaklyRegular_landweberSequence_iff_of_heightIdeal_smul_top_eq_top (hp : p.Prime)
    {M : Type*} [AddCommGroup M] [Module R M] {m : ℕ}
    (hm : F.heightIdeal p m • (⊤ : Submodule R M) = ⊤) :
    (∀ n : ℕ, IsWeaklyRegular M (F.landweberSequence p n)) ↔
      IsWeaklyRegular M (F.landweberSequence p m) := by
  refine ⟨fun h ↦ h m, fun hreg n ↦ (F.isWeaklyRegular_landweberSequence_iff hp M n).mpr ?_⟩
  intro i _
  rcases lt_or_ge i m with him | hmi
  · exact (F.isWeaklyRegular_landweberSequence_iff hp M m).mp hreg i him
  · have htop : F.heightIdeal p i • (⊤ : Submodule R M) = ⊤ :=
      top_unique (hm.symm.trans_le (Submodule.smul_mono_left (F.heightIdeal_mono hmi)))
    have : Subsingleton (M ⧸ (F.heightIdeal p i • ⊤ : Submodule R M)) :=
      Submodule.Quotient.subsingleton_iff.mpr htop
    exact fun _ _ _ ↦ Subsingleton.elim _ _

/-- If `I_m(F) = ⊤`, weak regularity of `F.landweberSequence p n` on `M` for all `n` is equivalent
to weak regularity at `n = m`. -/
theorem forall_isWeaklyRegular_landweberSequence_iff_of_heightIdeal_eq_top (hp : p.Prime)
    (M : Type*) [AddCommGroup M] [Module R M] {m : ℕ} (hm : F.heightIdeal p m = ⊤) :
    (∀ n : ℕ, IsWeaklyRegular M (F.landweberSequence p n)) ↔
      IsWeaklyRegular M (F.landweberSequence p m) :=
  F.forall_isWeaklyRegular_landweberSequence_iff_of_heightIdeal_smul_top_eq_top hp (by simp [hm])

end Comm

end FormalGroup

namespace TauCeti.FormalGroupIso

variable {R : Type*} [CommRing R] {F G : FormalGroup R}

/-- **Isomorphism invariance of Landweber's quotient condition.** Any isomorphism `e` between
formal group laws `F` and `G` (not necessarily strict) preserves regularity of the `X^(pⁿ)`
coefficient of `[p]` on `M ⧸ I_n M`. -/
theorem isSMulRegular_quotient_heightIdeal_iff (e : FormalGroupIso F G)
    (M : Type*) [AddCommGroup M] [Module R M] (p n : ℕ) :
    IsSMulRegular (M ⧸ (F.heightIdeal p n • ⊤ : Submodule R M))
        (PowerSeries.coeff (p ^ n) (F.nsmulSeries p)) ↔
      IsSMulRegular (M ⧸ (G.heightIdeal p n • ⊤ : Submodule R M))
        (PowerSeries.coeff (p ^ n) (G.nsmulSeries p)) := by
  have hu : IsUnit (PowerSeries.coeff 1 e.toHom.toPowerSeries) := e.isUnit_coeff_one
  have hmem := e.toHom.coeff_nsmulSeries_mul_coeff_one_pow_sub_mem_heightIdeal p n
  rw [← e.heightIdeal_eq p n, sup_idem,
    mul_comm (PowerSeries.coeff (p ^ n) (G.nsmulSeries p))] at hmem
  rw [← e.heightIdeal_eq p n]
  exact ((F.heightIdeal p n).isSMulRegular_quotient_smul_top_iff_of_mul_sub_mem
    (hu.pow (p ^ n)) hu hmem).symm

/-- **Isomorphism invariance of weak regularity.** Isomorphic commutative formal group laws have
the same weakly regular Landweber sequences on every module `M`. -/
theorem isWeaklyRegular_landweberSequence_iff (e : FormalGroupIso F G) [F.IsComm] [G.IsComm]
    {p : ℕ} (hp : p.Prime) (M : Type*) [AddCommGroup M] [Module R M] (n : ℕ) :
    IsWeaklyRegular M (F.landweberSequence p n) ↔ IsWeaklyRegular M (G.landweberSequence p n) := by
  rw [F.isWeaklyRegular_landweberSequence_iff hp M, G.isWeaklyRegular_landweberSequence_iff hp M]
  exact forall_congr' fun i ↦ imp_congr_right fun _ ↦ e.isSMulRegular_quotient_heightIdeal_iff M p i

/-- **Isomorphism invariance of regularity.** Isomorphic commutative formal group laws have the
same regular Landweber sequences on every module `M`. -/
theorem isRegular_landweberSequence_iff (e : FormalGroupIso F G) [F.IsComm] [G.IsComm]
    {p : ℕ} (hp : p.Prime) (M : Type*) [AddCommGroup M] [Module R M] (n : ℕ) :
    IsRegular M (F.landweberSequence p n) ↔ IsRegular M (G.landweberSequence p n) := by
  rw [isRegular_iff, isRegular_iff, e.isWeaklyRegular_landweberSequence_iff hp M n,
    F.ofList_landweberSequence hp, G.ofList_landweberSequence hp, e.heightIdeal_eq p n]

/-- **Isomorphism invariance of Landweber regularity.** Isomorphic commutative formal group laws
have the same Landweber-regular modules. -/
theorem isLandweberRegular_iff (e : FormalGroupIso F G) [F.IsComm] [G.IsComm]
    (M : Type*) [AddCommGroup M] [Module R M] :
    F.IsLandweberRegular M ↔ G.IsLandweberRegular M :=
  forall₂_congr fun _ hp ↦ forall_congr' (e.isWeaklyRegular_landweberSequence_iff hp M)

end TauCeti.FormalGroupIso

namespace FormalGroup

section Functoriality

variable {R S M N : Type*} [CommRing R] [CommRing S]
  [AddCommGroup M] [Module R M] [AddCommGroup N]

@[simp]
theorem isWeaklyRegular_landweberSequence_smul_iff (φ : TauCeti.FormalCoordinate R)
    (F : FormalGroup R) [F.IsComm] {p : ℕ} (hp : p.Prime) (n : ℕ) :
    IsWeaklyRegular M ((φ • F).landweberSequence p n) ↔
      IsWeaklyRegular M (F.landweberSequence p n) :=
  ((smulIso φ F).isWeaklyRegular_landweberSequence_iff hp M n).symm

@[simp]
theorem isRegular_landweberSequence_smul_iff (φ : TauCeti.FormalCoordinate R)
    (F : FormalGroup R) [F.IsComm] {p : ℕ} (hp : p.Prime) (n : ℕ) :
    IsRegular M ((φ • F).landweberSequence p n) ↔ IsRegular M (F.landweberSequence p n) :=
  ((smulIso φ F).isRegular_landweberSequence_iff hp M n).symm

@[simp]
theorem isLandweberRegular_smul_iff (φ : TauCeti.FormalCoordinate R)
    (F : FormalGroup R) [F.IsComm] :
    (φ • F).IsLandweberRegular M ↔ F.IsLandweberRegular M :=
  ((smulIso φ F).isLandweberRegular_iff M).symm

/-- For an `S`-module `N` over an `R`-algebra `S`, Landweber regularity of `N` for the base-changed
formal group law `F.map (algebraMap R S)` is equivalent to Landweber regularity of `N` as an
`R`-module for `F`. -/
theorem isLandweberRegular_map_algebraMap_iff [Algebra R S] [Module R N] [Module S N]
    [IsScalarTower R S N] (F : FormalGroup R) :
    (F.map (algebraMap R S)).IsLandweberRegular N ↔ F.IsLandweberRegular N := by
  simp only [IsLandweberRegular, ← map_landweberSequence, isWeaklyRegular_map_algebraMap_iff]

namespace IsLandweberRegular

/-- Landweber regularity is preserved across `R`-linear equivalences of modules. -/
theorem congr [Module R N] {F : FormalGroup R} (e : M ≃ₗ[R] N) :
    F.IsLandweberRegular M ↔ F.IsLandweberRegular N :=
  forall₂_congr fun _ _ ↦ forall_congr' fun n ↦ e.isWeaklyRegular_congr (F.landweberSequence _ n)

/-- Every subsingleton module is Landweber regular for any formal group law. -/
theorem of_subsingleton (F : FormalGroup R) [Subsingleton M] : F.IsLandweberRegular M := by
  intro p _ n
  rw [isWeaklyRegular_iff]
  intro i _
  have : Subsingleton (M ⧸ (Ideal.ofList ((F.landweberSequence p n).take i) • ⊤ :
      Submodule R M)) := inferInstance
  exact fun _ _ _ ↦ Subsingleton.elim _ _

/-- Tensoring on the left with a flat `R`-module preserves Landweber regularity. -/
theorem lTensor [Module R N] [Module.Flat R N] {F : FormalGroup R}
    (h : F.IsLandweberRegular M) : F.IsLandweberRegular (N ⊗[R] M) :=
  fun _ hp n ↦ (h hp n).isWeaklyRegular_lTensor

/-- Tensoring on the right with a flat `R`-module preserves Landweber regularity. -/
theorem rTensor [Module R N] [Module.Flat R N] {F : FormalGroup R}
    (h : F.IsLandweberRegular M) : F.IsLandweberRegular (M ⊗[R] N) :=
  fun _ hp n ↦ (h hp n).isWeaklyRegular_rTensor

/-- **Flat modules over a Landweber-regular ring are Landweber regular.** If `F` is Landweber
regular on `R` itself and `M` is a flat `R`-module, then `F` is Landweber regular on `M`. -/
theorem of_flat_module [Module.Flat R M] {F : FormalGroup R} (h : F.IsLandweberRegular R) :
    F.IsLandweberRegular M :=
  (congr (TensorProduct.rid R M)).mp h.lTensor

/-- **Flat base change for Landweber-regular modules.** If `S` is a flat `R`-algebra, `N` is the
base change of `M` to `S`, and `F` is Landweber regular on `M`, then `F.map (algebraMap R S)` is
Landweber regular on `N`. -/
theorem of_flat_of_isBaseChange [Algebra R S] [Module.Flat R S] [Module R N] [Module S N]
    [IsScalarTower R S N] {f : M →ₗ[R] N} (hf : IsBaseChange S f) {F : FormalGroup R}
    (h : F.IsLandweberRegular M) :
    (F.map (algebraMap R S)).IsLandweberRegular N := by
  intro p hp n
  rw [← map_landweberSequence]
  exact (h hp n).of_flat_of_isBaseChange hf

/-- **Flat base change for Landweber-regular rings.** If `F` is Landweber regular on `R` and `S` is
a flat `R`-algebra, then `F.map (algebraMap R S)` is Landweber regular on `S`. -/
theorem of_flat (S : Type*) [CommRing S] [Algebra R S] [Module.Flat R S] {F : FormalGroup R}
    (h : F.IsLandweberRegular R) :
    (F.map (algebraMap R S)).IsLandweberRegular S := by
  intro p hp n
  rw [← map_landweberSequence]
  exact (h hp n).of_flat

/-- Base change along a flat ring homomorphism `φ : R →+* S` preserves Landweber regularity. -/
theorem map_of_flat {F : FormalGroup R} {φ : R →+* S} (hφ : φ.Flat)
    (h : F.IsLandweberRegular R) :
    (F.map φ).IsLandweberRegular S := by
  algebraize [φ]
  exact h.of_flat S

end IsLandweberRegular

end Functoriality

section Examples

variable {R : Type*} [CommRing R]

/-- **Landweber regularity for the multiplicative formal group law `𝔾ₘ`.** An `R`-module `M` is
Landweber regular for `𝔾ₘ` if and only if multiplication by every prime `p` is injective on `M`
(that is, `M` has no prime torsion as an abelian group). -/
theorem isLandweberRegular_𝔾ₘ_iff (M : Type*) [AddCommGroup M] [Module R M] :
    (𝔾ₘ : FormalGroup R).IsLandweberRegular M ↔ ∀ ⦃p : ℕ⦄, p.Prime → IsSMulRegular M (p : R) := by
  refine forall₂_congr fun p hp ↦ ?_
  rw [(𝔾ₘ : FormalGroup R).forall_isWeaklyRegular_landweberSequence_iff_of_heightIdeal_eq_top
    hp M (heightIdeal_𝔾ₘ_eq_top hp.one_lt (le_refl 2)),
    landweberSequence_two, isWeaklyRegular_cons_iff, isWeaklyRegular_singleton_iff]
  have hcoeff : PowerSeries.coeff p ((𝔾ₘ : FormalGroup R).nsmulSeries p) = 1 := by
    rw [nsmulSeries_𝔾ₘ, map_sub, add_comm, add_pow]
    simp [PowerSeries.coeff_X_pow, PowerSeries.coeff_one, hp.ne_zero]
  rw [hcoeff]
  exact and_iff_left (isUnit_one.isSMulRegular _)

/-- **Landweber regularity for the additive formal group law `𝔾ₐ`.** An `R`-module `M` is
Landweber regular for `𝔾ₐ` if and only if for every prime `p`, multiplication by `p` on `M` is
injective and `p • M = M` (that is, `M` is uniquely divisible). -/
theorem isLandweberRegular_𝔾ₐ_iff (M : Type*) [AddCommGroup M] [Module R M] :
    (𝔾ₐ : FormalGroup R).IsLandweberRegular M ↔
      ∀ ⦃p : ℕ⦄, p.Prime → IsSMulRegular M (p : R) ∧ (p : R) • (⊤ : Submodule R M) = ⊤ := by
  rw [(𝔾ₐ : FormalGroup R).isLandweberRegular_iff M]
  refine forall₂_congr fun p hp ↦ ?_
  have hbot : (𝔾ₐ : FormalGroup R).heightIdeal p 0 • (⊤ : Submodule R M) = ⊥ := by simp
  refine ⟨fun h ↦ ?_, fun ⟨hreg, hdiv⟩ n ↦ ?_⟩
  · have h0 := h 0
    rw [pow_zero, coeff_one_nsmulSeries,
      (Submodule.quotEquivOfEqBot _ hbot).isSMulRegular_congr] at h0
    have h1 := h 1
    have hEq : (𝔾ₐ : FormalGroup R).heightIdeal p 1 • (⊤ : Submodule R M) =
        (p : R) • (⊤ : Submodule R M) := by
      rw [heightIdeal_𝔾ₐ hp.one_lt one_ne_zero, Submodule.ideal_span_singleton_smul]
    have hcoeff0 : PowerSeries.coeff p ((𝔾ₐ : FormalGroup R).nsmulSeries p) = 0 := by
      simp [nsmulSeries_𝔾ₐ, PowerSeries.coeff_X, hp.ne_one]
    rw [pow_one, hcoeff0, (Submodule.quotEquivOfEq _ _ hEq).isSMulRegular_congr] at h1
    have hsub : Subsingleton (M ⧸ ((p : R) • ⊤ : Submodule R M)) :=
      ⟨fun x y ↦ h1 (by simp)⟩
    exact ⟨h0, Submodule.Quotient.subsingleton_iff.mp hsub⟩
  · rcases eq_or_ne n 0 with rfl | hn
    · rwa [pow_zero, coeff_one_nsmulSeries,
        (Submodule.quotEquivOfEqBot _ hbot).isSMulRegular_congr]
    · rw [heightIdeal_𝔾ₐ hp.one_lt hn, Submodule.ideal_span_singleton_smul]
      have : Subsingleton (M ⧸ ((p : R) • ⊤ : Submodule R M)) :=
        Submodule.Quotient.subsingleton_iff.mpr hdiv
      exact fun _ _ _ ↦ Subsingleton.elim _ _

end Examples

end FormalGroup
