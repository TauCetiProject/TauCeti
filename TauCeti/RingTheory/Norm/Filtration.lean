module

public import Mathlib.RingTheory.Norm.Basic
import Mathlib.Algebra.Module.Torsion.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import TauCeti.RingTheory.Norm.Quotient

/-!
# The norm along the filtration by powers of an element

Let `V` be a finite-dimensional commutative algebra over a field `k`, and let `w ∈ V` satisfy
`w ^ e = 0`, with the annihilator of `w ^ (e - 1)` contained in `w V`. Then the filtration
`V ⊇ w V ⊇ w² V ⊇ ⋯ ⊇ wᵉ V = 0` has all its successive quotients isomorphic to `V ⧸ w V`,
compatibly with multiplication by elements of `V`. Since the determinant is multiplicative along
an invariant filtration, the norm of `v` over `k` is the `e`-th power of the norm of the class of
`v` in `V ⧸ w V`.

The basic example is `V = S ⧸ ϖᵉ S` for a discrete valuation ring `S` with uniformizer `ϖ`, which
is a finite algebra over the residue field `k` of a discrete valuation ring below `S` when `ϖᵉ S` is
the extension of the maximal ideal of that ring. Then `V ⧸ w V` is the residue field of `S`, and the
result computes the residue of a norm in a finite free extension of discrete valuation rings, with
no separability hypothesis on the residue field extension.

## Main results

* `TauCeti.Algebra.norm_eq_norm_mk_span_singleton_pow`: if `w ^ e = 0` and every `x` with
  `w ^ (e - 1) * x = 0` lies in `w V`, then `N_{V/k}(v) = N_{(V ⧸ w V)/k}(v mod w) ^ e`.

## References

* P. Gille, T. Szamuely, *Central Simple Algebras and Galois Cohomology*, Lemma 7.3.10.
-/

public section

open Ideal

namespace TauCeti.Algebra

universe u v

variable {k : Type u} [Field k]

/-- Multiplication by `w` identifies `V ⧸ ann(w)` with `w V`, compatibly with multiplication by `V`;
this is `Ideal.quotTorsionOfEquivSpanSingleton` read over `k`. -/
private theorem det_restrict_span_singleton {V : Type v} [CommRing V] [Algebra k V] (w v : V)
    (hL : (span {w} : Ideal V).restrictScalars k ≤
      ((span {w} : Ideal V).restrictScalars k).comap (Algebra.lmul k V v)) :
    LinearMap.det ((Algebra.lmul k V v).restrict hL) =
      Algebra.norm k (Ideal.Quotient.mk (Ideal.torsionOf V V w) v) := by
  let φ : (V ⧸ Ideal.torsionOf V V w) ≃ₗ[k] (span {w} : Ideal V).restrictScalars k :=
    (Ideal.quotTorsionOfEquivSpanSingleton V V w).restrictScalars k
  have hφ (x : V) : (φ (Ideal.Quotient.mk _ x) : V) = x * w :=
    congrArg Subtype.val (quotTorsionOfEquivSpanSingleton_apply_mk w x)
  rw [Algebra.norm_apply, ← LinearMap.det_conj _ φ]
  congr 1
  rw [← LinearMap.comp_assoc, LinearEquiv.eq_comp_toLinearMap_symm]
  refine LinearMap.ext fun y => ?_
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  apply Subtype.ext
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
    LinearMap.coe_restrict_apply, Algebra.coe_lmul_eq_mul, LinearMap.mul_apply', ← map_mul, hφ,
    mul_assoc]

/-- If `w ^ (e + 1) = 0` and the annihilator of `w ^ e` lies in `w V`, then in `V ⧸ ann(w)` the
annihilator of `w ^ (e - 1)` lies in the ideal generated by `w`. -/
private theorem mem_span_mk_torsionOf {V : Type v} [CommRing V] {w : V} {e : ℕ}
    (hw : w ^ (e + 1) = 0) (hker : ∀ x, w ^ (e + 1 - 1) * x = 0 → x ∈ span {w})
    (y : V ⧸ Ideal.torsionOf V V w)
    (hy : Ideal.Quotient.mk (Ideal.torsionOf V V w) w ^ (e - 1) * y = 0) :
    y ∈ span {Ideal.Quotient.mk (Ideal.torsionOf V V w) w} := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [← map_pow, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_torsionOf_iff] at hy
  rcases e with _ | e
  · -- Here `w = 0`, so `ann(w)` is everything and `V ⧸ ann(w)` is trivial.
    have hw0 : w = 0 := by simpa using hw
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr ((Ideal.mem_torsionOf_iff w x).mpr (by simp [hw0]))]
    exact zero_mem _
  · have hx : w ^ (e + 1) * x = 0 := by
      rw [← hy, Nat.add_sub_cancel]
      ring
    have := Ideal.mem_map_of_mem (Ideal.Quotient.mk (Ideal.torsionOf V V w))
      (hker x (by simpa using hx))
    rwa [Ideal.map_span, Set.image_singleton] at this

/-- **The norm along the filtration by powers of `w`.** Let `V` be a finite-dimensional commutative
`k`-algebra and `w ∈ V` an element with `w ^ e = 0` such that every `x` with `w ^ (e - 1) * x = 0`
lies in `w V`. Then the norm of `v ∈ V` over `k` is the `e`-th power of the norm of the class of `v`
in `V ⧸ w V`. -/
theorem norm_eq_norm_mk_span_singleton_pow (e : ℕ) {V : Type v} [CommRing V] [Algebra k V]
    [Module.Finite k V] {w : V} (hw : w ^ e = 0)
    (hker : ∀ x, w ^ (e - 1) * x = 0 → x ∈ span {w}) (v : V) :
    Algebra.norm k v = Algebra.norm k (Ideal.Quotient.mk (span {w}) v) ^ e := by
  induction e generalizing V with
  | zero =>
    have : Subsingleton V := subsingleton_of_zero_eq_one (by simpa using hw.symm)
    rw [Algebra.norm_apply, LinearMap.det_eq_one_of_subsingleton, pow_zero]
  | succ e ih =>
    -- The determinant of multiplication by `v` splits along `w V ⊆ V`; the quotient `V ⧸ w V`
    -- contributes one factor, and `w V ≃ V ⧸ ann(w)` satisfies the hypotheses with `e`.
    set I : Ideal V := span {w}
    set J : Ideal V := Ideal.torsionOf V V w
    have hJ (x : V) : x ∈ J ↔ x * w = 0 := Ideal.mem_torsionOf_iff w x
    have hL : I.restrictScalars k ≤ (I.restrictScalars k).comap (Algebra.lmul k V v) :=
      fun x hx => I.mul_mem_left v hx
    rw [Algebra.norm_apply, LinearMap.det_eq_det_mul_det _ _ hL, pow_succ]
    refine congrArg₂ (· * ·) ?_ ?_
    · have hw' : Ideal.Quotient.mk J w ^ e = 0 := by
        rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, hJ, ← pow_succ, hw]
      rw [det_restrict_span_singleton, ih hw' (mem_span_mk_torsionOf hw hker)]
      rcases Nat.eq_zero_or_pos e with rfl | he
      · simp
      -- For `e > 0`, `ann(w) ⊆ w V`, and `(V ⧸ J) ⧸ w (V ⧸ J) ≃ V ⧸ w V`.
      have hJI : J ≤ I := fun x hx => by
        apply hker
        rw [Nat.add_sub_cancel, ← Nat.sub_add_cancel he, pow_succ, mul_assoc, mul_comm w x,
          (hJ x).mp hx, mul_zero]
      have hspan : span {Ideal.Quotient.mk J w} = I.map (Ideal.Quotient.mkₐ k J) := by
        rw [Ideal.map_span, Set.image_singleton, Ideal.Quotient.mkₐ_eq_mk]
      rw [hspan, norm_mk_map_mkₐ_eq_norm (fun x => ⟨x, rfl⟩) (Ideal.Quotient.mkₐ k I)
        (Ideal.Quotient.mkₐ_surjective k I) (Ideal.Quotient.mkₐ_ker k I) hJI,
        Ideal.Quotient.mkₐ_eq_mk]
    · rw [Algebra.norm_apply,
        ← LinearMap.det_conj _ (Submodule.Quotient.restrictScalarsEquiv k I).symm]
      congr 1
      -- Both maps send the class of `x` to the class of `v * x`.
      exact Submodule.linearMap_qext _ rfl

end TauCeti.Algebra
