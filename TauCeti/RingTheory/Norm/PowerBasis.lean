module

public import Mathlib.RingTheory.Norm.Defs
public import Mathlib.RingTheory.PowerBasis
import TauCeti.RingTheory.PowerBasis

/-!
# Norm of a scalar minus a power basis generator

The norm of `a - θ` in an algebra generated by a power basis with generator `θ` is
obtained by evaluating the minimal polynomial of `θ` at `a`. This allows norm
computations by polynomial factorization, without a separability hypothesis. The comparison uses
`PowerBasis.charpoly_lmul_gen` and `LinearMap.eval_charpoly`.
-/

public section

/-- The norm of a scalar minus a power basis generator is the value of the generator's minimal
polynomial at that scalar. -/
theorem PowerBasis.norm_algebraMap_sub_gen {R S : Type*} [CommRing R] [Ring S] [Algebra R S]
    (pb : PowerBasis R S) (a : R) :
    Algebra.norm R (algebraMap R S a - pb.gen) = (minpoly R pb.gen).eval a := by
  have := Module.Free.of_basis pb.basis
  have := Module.Finite.of_basis pb.basis
  rw [← pb.charpoly_lmul_gen, LinearMap.eval_charpoly, Algebra.norm_apply, map_sub,
    (Algebra.lmul R S).commutes]
