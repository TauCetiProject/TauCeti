public import TauCeti.RingTheory.Norm.Projective

/-!
# Full sets of sections of finite locally free algebras

Let `B` be a commutative `A`-algebra which is finite projective as an `A`-module, so that
`Spec B → Spec A` is finite locally free, and let `s : ι → B →ₐ[A] A` be a family of sections.
This file shows that the points of `Spec A` over which `s` is a full set of sections form a closed
subscheme, without assuming that `B` is free over `A`.

The norm `Algebra.projectiveNorm` of a finite projective algebra is defined on every base change
`T ⊗[A] B`, free or not. A full set of sections satisfies the norm identity
`Norm_{T ⊗[A] B / T}(f) = ∏ i, sᵢ(f)` on every base change
(`IsFullSetOfSections.projectiveNorm_eq`), and conversely
(`isFullSetOfSections_iff_projectiveNorm_eq`). Choosing generators `b₁, …, bₙ` of `B` as an
`A`-module, every function on `Spec (T ⊗[A] B)` is a specialization of the generic
element `∑ j, Xⱼ ⊗ bⱼ` of `A[X₁, …, Xₙ] ⊗[A] B`, so the norm identity on all base changes is the
vanishing of the coefficients of a single polynomial, as in the proof of Katz–Mazur 1.9.1.

## Main definitions

* `TauCeti.normIdentityPolynomial b s`: the norm identity for the generic element `∑ j, Xⱼ ⊗ bⱼ`,
  a polynomial over `A` in the variables `Xⱼ`.
* `TauCeti.fullSetLocusIdeal s`: the ideal of `A` generated by its coefficients for a chosen
  generating family `b`. Its closed subscheme `Spec (A ⧸ fullSetLocusIdeal s)` is the full-set
  locus of `s`.

## Main results

* `TauCeti.isFullSetOfSections_iff_projectiveNorm_eq`: a family of sections of a finite projective
  algebra is a full set exactly when the norm identity holds on every base change.
* `TauCeti.fullSetLocusIdeal_eq_bot_iff`: `s` is a full set of sections exactly when its full-set
  locus is all of `Spec A`.
* `TauCeti.fullSetLocusIdeal_le_ker_iff`: **the full-set locus** (Katz–Mazur 1.9.1). The base
  change of `s` along `A → T` is a full set of sections exactly when `A → T` kills
  `fullSetLocusIdeal s`.
* `TauCeti.span_coeff_normIdentityPolynomial_le_ker_iff`: for any finite generating family `b`
  of `B`, the coefficients of `normIdentityPolynomial b s` vanish in `T` exactly when the base
  change of `s` to `T` is a full set of sections.
* `TauCeti.fullSetLocusIdeal_eq_span`: the ideal is generated by the coefficients of the
  norm-identity polynomial for any finite generating family of `B`.
* `TauCeti.fullSetLocusIdeal_fg`: the full-set locus ideal is finitely generated.
* `TauCeti.map_fullSetLocusIdeal_of_isPushout`: the full-set locus commutes with arbitrary base
  change.
* `TauCeti.fullSetLocusIdeal_eq_fullSetIdeal`: when `B` is free, it is the full-set ideal
  `TauCeti.fullSetIdeal` computed in a basis of `B`.

## References

* N. M. Katz, B. Mazur, *Arithmetic Moduli of Elliptic Curves*, Annals of Mathematics Studies
  108, Princeton University Press, 1985, §§1.8–1.9.
-/

public section

open TensorProduct MvPolynomial

namespace TauCeti

universe u v w

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
variable {ι : Type*} [Fintype ι]

section Projective

variable [Module.Finite A B] [Module.Projective A B]

variable {s : ι → B →ₐ[A] A}

/-- The norm identity defining a full set of sections of a finite projective algebra holds on every
base change `T ⊗[A] B`, free or not, for test algebras `T` in any universe. -/
theorem IsFullSetOfSections.projectiveNorm_eq (h : IsFullSetOfSections s) (T : Type w)
    [CommRing T] [Algebra A T] (f : T ⊗[A] B) :
    Algebra.projectiveNorm T f = ∏ i, (s i).sectionBaseChange T f := by
  let T' (P : Ideal A) [P.IsMaximal] := Localization (Algebra.algebraMapSubmonoid T P.primeCompl)
  refine Module.eq_of_localization_maximal T'
    (fun P ↦ (IsScalarTower.toAlgHom A T (T' P)).toLinearMap) _ _ fun P _ ↦ ?_
  rw [AlgHom.toLinearMap_apply, AlgHom.toLinearMap_apply]
  -- over the localization `T_P`, the base change of `B` is free and `projectiveNorm` is `norm`
  have : Module.Free (Localization.AtPrime P) (Localization.AtPrime P ⊗[A] B) :=
    Module.free_of_flat_of_isLocalRing
  have : Module.Free (T' P) (T' P ⊗[A] B) :=
    .of_equiv (Algebra.TensorProduct.cancelBaseChange A (Localization.AtPrime P) (T' P) (T' P)
      B).toLinearEquiv
  rw [← Algebra.projectiveNorm_rTensor, Algebra.projectiveNorm_eq_norm, h.norm_eq, map_prod]
  simp

/-- A family of sections of a finite projective algebra is a full set of sections if and only if
the norm identity `Norm_{T ⊗[A] B / T}(f) = ∏ i, sᵢ(f)` holds on every base change, with the norm
`Algebra.projectiveNorm` of the finite projective algebra `T ⊗[A] B` over `T`. -/
theorem isFullSetOfSections_iff_projectiveNorm_eq : IsFullSetOfSections s ↔
    ∀ (T : Type u) [CommRing T] [Algebra A T] (f : T ⊗[A] B),
      Algebra.projectiveNorm T f = ∏ i, (s i).sectionBaseChange T f :=
  ⟨fun h T _ _ f ↦ h.projectiveNorm_eq T f, fun h ↦ isFullSetOfSections_iff.2 fun T _ _ _ f ↦
    (Algebra.projectiveNorm_eq_norm T f).symm.trans (h T f)⟩

end Projective

/-! ### The full-set locus -/

section Locus

variable [Module.Finite A B] [Module.Projective A B]

/-- The *norm-identity polynomial* of a family of sections `s` with respect to a family `b`
generating `B`: the norm of the generic element `x = ∑ j, Xⱼ ⊗ bⱼ` of `A[X] ⊗[A] B` minus
`∏ i, sᵢ(x)`. -/
noncomputable def normIdentityPolynomial {κ : Type*} [Fintype κ] (b : κ → B)
    (s : ι → B →ₐ[A] A) : MvPolynomial κ A :=
  Algebra.projectiveNorm (MvPolynomial κ A) (∑ j, (X j : MvPolynomial κ A) ⊗ₜ[A] b j) -
    ∏ i, (s i).sectionBaseChange (MvPolynomial κ A) (∑ j, (X j : MvPolynomial κ A) ⊗ₜ[A] b j)

/-- Unfolding `normIdentityPolynomial`: it is the norm of the generic element `∑ j, Xⱼ ⊗ bⱼ` minus
the product of its values at the sections. -/
theorem normIdentityPolynomial_def {κ : Type*} [Fintype κ] (b : κ → B) (s : ι → B →ₐ[A] A) :
    normIdentityPolynomial b s =
      Algebra.projectiveNorm (MvPolynomial κ A) (∑ j, (X j : MvPolynomial κ A) ⊗ₜ[A] b j) -
        ∏ i, (s i).sectionBaseChange (MvPolynomial κ A)
          (∑ j, (X j : MvPolynomial κ A) ⊗ₜ[A] b j) :=
  (rfl)

/-- The coefficients of the norm-identity polynomial vanish in `T` exactly when the base change of
`s` to `T` is a full set of sections. -/
theorem span_coeff_normIdentityPolynomial_le_ker_iff {κ : Type*} [Fintype κ] {b : κ → B}
    (hb : Submodule.span A (Set.range b) = ⊤) (s : ι → B →ₐ[A] A) (T : Type w) [CommRing T]
    [Algebra A T] :
    Ideal.span (Set.range (normIdentityPolynomial b s).coeff) ≤ RingHom.ker (algebraMap A T) ↔
      IsFullSetOfSections fun i ↦ (s i).sectionBaseChange T := by
  -- the generic element over `T`
  set xT : MvPolynomial κ T ⊗[A] B := ∑ j, (X j : MvPolynomial κ T) ⊗ₜ[A] b j
  let φ : MvPolynomial κ A →ₐ[A] MvPolynomial κ T := MvPolynomial.mapAlgHom (Algebra.ofId A T)
  have hφ : Algebra.TensorProduct.rTensor B φ (∑ j, (X j : MvPolynomial κ A) ⊗ₜ[A] b j) = xT := by
    simp [φ, xT]
  have hmap : MvPolynomial.map (algebraMap A T) (normIdentityPolynomial b s) =
      Algebra.projectiveNorm (MvPolynomial κ T) xT -
        ∏ i, (s i).sectionBaseChange (MvPolynomial κ T) xT := by
    rw [← hφ, Algebra.projectiveNorm_rTensor, normIdentityPolynomial_def, map_sub, map_prod]
    simp only [AlgHom.sectionBaseChange_rTensor, φ, MvPolynomial.mapAlgHom_apply,
      Algebra.toRingHom_ofId]
  have hle : Ideal.span (Set.range (normIdentityPolynomial b s).coeff) ≤
      RingHom.ker (algebraMap A T) ↔
      MvPolynomial.map (algebraMap A T) (normIdentityPolynomial b s) = 0 := by
    rw [Ideal.span_le, Set.range_subset_iff, MvPolynomial.ext_iff]
    simp [MvPolynomial.coeff_map]
  rw [hle, hmap, sub_eq_zero]
  constructor
  · refine fun H ↦ isFullSetOfSections_iff.2 fun T' _ _ _ g ↦ ?_
    let : Algebra A T' := Algebra.compHom T' (algebraMap A T)
    have : IsScalarTower A T T' := .of_algebraMap_eq fun _ ↦ rfl
    -- write `g` as a specialization of the generic element over `T`
    let e := Algebra.TensorProduct.cancelBaseChange A T T' T' B
    obtain ⟨c, hc⟩ := TensorProduct.exists_eq_sum_tmul_of_span_eq_top hb (e g)
    let ψ : MvPolynomial κ T →ₐ[A] T' := (MvPolynomial.aeval c).restrictScalars A
    have hψ : Algebra.TensorProduct.rTensor B ψ xT = e g := by
      simp [ψ, xT, hc]
    rw [← Algebra.projectiveNorm_eq_norm, ← Algebra.projectiveNorm_eq_of_algEquiv e, ← hψ,
      Algebra.projectiveNorm_rTensor, H, map_prod]
    refine Finset.prod_congr rfl fun i _ ↦ ?_
    rw [AlgHom.sectionBaseChange_sectionBaseChange]
    exact (congrArg ((s i).sectionBaseChange T') hψ.symm).trans
      ((s i).sectionBaseChange_rTensor ψ xT) |>.symm
  · intro H
    have := H.projectiveNorm_eq (MvPolynomial κ T)
      ((Algebra.TensorProduct.cancelBaseChange A T (MvPolynomial κ T) (MvPolynomial κ T) B).symm xT)
    rw [Algebra.projectiveNorm_eq_of_algEquiv] at this
    simpa using this

/-- The ideal of the **full-set locus** of a family `s` of sections of a finite projective
`A`-algebra `B`: it is generated by the coefficients of the norm identity for the generic element
`∑ j, Xⱼ ⊗ bⱼ`, for a chosen finite family `b` generating `B`. The closed subscheme
`Spec (A ⧸ fullSetLocusIdeal s)` of `Spec A` is the locus over which `s` is a full set of sections
(`fullSetLocusIdeal_le_ker_iff`). It does not depend on the generators
(`fullSetLocusIdeal_eq_span`). -/
noncomputable def fullSetLocusIdeal (s : ι → B →ₐ[A] A) : Ideal A :=
  Ideal.span (Set.range (normIdentityPolynomial
    (Subtype.val : (Module.Finite.fg_top (R := A) (M := B)).choose → B) s).coeff)

/-- **The full-set locus** (Katz–Mazur 1.9.1). The base change of a family `s` of sections of a
finite projective algebra along `A → T` is a full set of sections if and only if `A → T` kills
`fullSetLocusIdeal s`, that is, `Spec T → Spec A` factors through
`Spec (A ⧸ fullSetLocusIdeal s)`. -/
theorem fullSetLocusIdeal_le_ker_iff (s : ι → B →ₐ[A] A) (T : Type w) [CommRing T]
    [Algebra A T] :
    fullSetLocusIdeal s ≤ RingHom.ker (algebraMap A T) ↔
      IsFullSetOfSections fun i ↦ (s i).sectionBaseChange T :=
  span_coeff_normIdentityPolynomial_le_ker_iff (by
    simpa using (Module.Finite.fg_top (R := A) (M := B)).choose_spec) s T

/-- The full-set locus ideal is contained in an ideal `J` of `A` if and only if `s` becomes a full
set of sections over `A ⧸ J`. -/
theorem fullSetLocusIdeal_le_iff (s : ι → B →ₐ[A] A) (J : Ideal A) :
    fullSetLocusIdeal s ≤ J ↔ IsFullSetOfSections fun i ↦ (s i).sectionBaseChange (A ⧸ J) := by
  rw [← fullSetLocusIdeal_le_ker_iff, Ideal.Quotient.algebraMap_eq, Ideal.mk_ker]

/-- The full-set locus ideal is generated by the coefficients of the norm-identity polynomial for
any finite family `b` generating `B`: it does not depend on the choice of generators. -/
theorem fullSetLocusIdeal_eq_span {κ : Type*} [Fintype κ] {b : κ → B}
    (hb : Submodule.span A (Set.range b) = ⊤) (s : ι → B →ₐ[A] A) :
    fullSetLocusIdeal s = Ideal.span (Set.range (normIdentityPolynomial b s).coeff) := by
  refine eq_of_forall_ge_iff fun J ↦ ?_
  rw [fullSetLocusIdeal_le_iff, ← span_coeff_normIdentityPolynomial_le_ker_iff hb,
    Ideal.Quotient.algebraMap_eq, Ideal.mk_ker]

/-- The full-set locus ideal is finitely generated, so the full-set locus is a closed subscheme of
finite presentation. -/
theorem fullSetLocusIdeal_fg (s : ι → B →ₐ[A] A) : (fullSetLocusIdeal s).FG :=
  -- the coefficient function of a polynomial is finitely supported
  Submodule.fg_span (Finsupp.finite_range _)

/-- The family `s` becomes a full set of sections on the full-set locus
`A ⧸ fullSetLocusIdeal s`. -/
theorem isFullSetOfSections_quotient_fullSetLocusIdeal (s : ι → B →ₐ[A] A) :
    IsFullSetOfSections fun i ↦ (s i).sectionBaseChange (A ⧸ fullSetLocusIdeal s) :=
  (fullSetLocusIdeal_le_iff s _).1 le_rfl

/-- A family of sections of a finite projective algebra is a full set of sections exactly when its
full-set locus is all of `Spec A`. -/
theorem fullSetLocusIdeal_eq_bot_iff (s : ι → B →ₐ[A] A) :
    fullSetLocusIdeal s = ⊥ ↔ IsFullSetOfSections s := by
  -- the structure map of `A` over itself is the identity, so its kernel is `⊥`
  have hker : RingHom.ker (algebraMap A A) = ⊥ := by
    rw [Algebra.algebraMap_self, ← RingHom.injective_iff_ker_eq_bot, RingHom.coe_id]
    exact Function.injective_id
  rw [← le_bot_iff, ← hker, fullSetLocusIdeal_le_ker_iff,
    isFullSetOfSections_sectionBaseChange_self_iff]

/-- **The full-set locus commutes with base change.** If `B'` is the base change of `B` along
`A → A'` and the sections `s'` of `B'` over `A'` extend the sections `s` of `B`, then the full-set
locus of `s'` is the inverse image of that of `s`. -/
theorem map_fullSetLocusIdeal_of_isPushout {A' B' : Type*} [CommRing A'] [CommRing B']
    [Algebra A A'] [Algebra A B'] [Algebra A' B'] [Algebra B B'] [IsScalarTower A A' B']
    [IsScalarTower A B B'] [Algebra.IsPushout A A' B B'] [Module.Finite A' B']
    [Module.Projective A' B'] (s : ι → B →ₐ[A] A) (s' : ι → B' →ₐ[A'] A')
    (hs : ∀ i b, s' i (algebraMap B B' b) = algebraMap A A' (s i b)) :
    (fullSetLocusIdeal s).map (algebraMap A A') = fullSetLocusIdeal s' := by
  refine eq_of_forall_ge_iff fun J ↦ ?_
  have hker : RingHom.ker (algebraMap A (A' ⧸ J)) = J.comap (algebraMap A A') := by
    rw [IsScalarTower.algebraMap_eq A A' (A' ⧸ J), ← RingHom.comap_ker,
      Ideal.Quotient.algebraMap_eq, Ideal.mk_ker]
  rw [Ideal.map_le_iff_le_comap, ← hker, fullSetLocusIdeal_le_ker_iff,
    ← isFullSetOfSections_sectionBaseChange_iff_of_isPushout hs, fullSetLocusIdeal_le_iff]

end Locus

section Free

variable [Module.Finite A B] [Module.Free A B]

/-- For `B` free of finite rank, the full-set locus of `s` is the full-set locus
`TauCeti.fullSetIdeal s` cut out by the coefficients of the norm identity in a basis of `B`. -/
theorem fullSetLocusIdeal_eq_fullSetIdeal (s : ι → B →ₐ[A] A) :
    fullSetLocusIdeal s = fullSetIdeal s := by
  refine eq_of_forall_ge_iff fun J ↦ ?_
  have hsec (i : ι) : AlgHom.liftEquiv A (A ⧸ J) B (A ⧸ J) ((Ideal.Quotient.mkₐ A J).comp (s i)) =
      (s i).sectionBaseChange (A ⧸ J) :=
    Algebra.TensorProduct.ext' fun t b ↦ by simp
  have hkerₐ : RingHom.ker (Ideal.Quotient.mkₐ A J) = J := by
    rw [AlgHom.ker_coe, Ideal.Quotient.mkₐ_ker]
  conv_rhs => rw [← hkerₐ]
  rw [fullSetLocusIdeal_le_iff, ← isFullSetOfSections_liftEquiv_comp_iff]
  simp only [hsec]

end Free

end TauCeti
