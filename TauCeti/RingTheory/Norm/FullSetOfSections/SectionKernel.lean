/-!
# Extending full sets of sections across principal section kernels

Over a local base `Spec A`, the inductive step of Katz–Mazur Theorem 1.8.3 (showing that `n`
sections of a smooth curve form a full set of sections of the sum of their divisors) splits off one
section `σ : B →ₐ[A] A` from the coordinate ring `B` of the divisor sum `D = [x₁] + D'`: the ideal
of `[x₁]` in `B` is generated by a single element `u` with `ker σ = (u)`, while the restriction map
`π : B →ₐ[A] B'` to the residual divisor `D'` has kernel `Ann(u)` (and conversely, Cayley–Hamilton
norm vanishing in `TauCeti/RingTheory/Norm/Quotient.lean` recovers divisor containment from a full
set of sections).

When `B'` is finite free over `A`, `π : B →ₐ[A] B'` is surjective, `ker σ = (u)`, and
`ker π = Ann(u)`, multiplication by `u` identifies `B'` with `ker σ` and `σ` splits
`0 → B' → B → A → 0`. After any base change `A → T`, multiplication by `f ∈ T ⊗[A] B` is block
upper-triangular on `(T ⊗[A] B') × T` with diagonal blocks `(1 ⊗ π)(f)` and `σ_T(f)`, giving
`Algebra.norm T f = σ_T(f) * Algebra.norm T ((1 ⊗ π)(f))` and extending any full set of sections of
`B'` by `σ`.

## Main results

* `TauCeti.moduleFree_and_moduleFinite_of_ker_span_singleton`: `B` inherits finite freeness over `A`
  from `B'` across `ker σ = (u)`, `ker π = Ann(u)`.
* `TauCeti.Algebra.norm_eq_mul_of_ker_span_singleton` and
  `TauCeti.IsFullSetOfSections.optionElim_of_ker_span_singleton`: multiplicativity of the norm and
  extension of a full set of sections across `ker σ = (u)`, `ker π = Ann(u)`.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, Annals of Mathematics Studies
  108, Princeton University Press, 1985, Theorem 1.8.3.
-/

public section

open TensorProduct

namespace TauCeti

section PrincipalKernel

variable {A B B' : Type*} [CommRing A] [CommRing B] [Algebra A B] [CommRing B'] [Algebra A B']

private noncomputable def mulSpanQuotEquiv {π : B →ₐ[A] B'} {u : B}
    (hkerπ : RingHom.ker π = (Ideal.span {u}).annihilator) :
    (B ⧸ RingHom.ker π) ≃ₗ[A] (Ideal.span ({u} : Set B)).restrictScalars A := by
  let μ : B →ₗ[A] (Ideal.span ({u} : Set B)).restrictScalars A :=
    (LinearMap.mulRight A u).codRestrict ((Ideal.span {u}).restrictScalars A) fun b ↦
      Ideal.mem_span_singleton.mpr ⟨b, mul_comm b u⟩
  have hμ (b : B) : (μ b : B) = b * u := rfl
  have hkerμ : LinearMap.ker μ = (RingHom.ker π).restrictScalars A := by
    ext b; simp [LinearMap.mem_ker, Subtype.ext_iff, hμ, hkerπ, Ideal.span, mul_comm]
  have hsurjμ : Function.Surjective μ := fun ⟨_, hx⟩ ↦
    let ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hx; ⟨b, Subtype.ext (hb ▸ mul_comm b u)⟩
  exact (Submodule.Quotient.restrictScalarsEquiv A (RingHom.ker π)).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _ hkerμ.symm ≪≫ₗ LinearMap.quotKerEquivOfSurjective μ hsurjμ

/-- When `π : B →ₐ[A] B'` is surjective with `ker π = Ann(u)`, multiplication by `u` descends to an
`A`-linear isomorphism `B' ≃ₗ[A] (u)`. -/
private noncomputable def mulSpanEquiv {π : B →ₐ[A] B'} (hπ : Function.Surjective π) {u : B}
    (hkerπ : RingHom.ker π = (Ideal.span {u}).annihilator) :
    B' ≃ₗ[A] (Ideal.span ({u} : Set B)).restrictScalars A :=
  (Ideal.quotientKerAlgEquivOfSurjective hπ).symm.toLinearEquiv ≪≫ₗ mulSpanQuotEquiv hkerπ

private lemma mul_coe_mulSpanEquiv {π : B →ₐ[A] B'} (hπ : Function.Surjective π) {u : B}
    (hkerπ : RingHom.ker π = (Ideal.span {u}).annihilator) (b : B) (y : B') :
    b * (mulSpanEquiv hπ hkerπ y : B) = (mulSpanEquiv hπ hkerπ (π b * y) : B) := by
  have hπ_apply (x : B) : (mulSpanEquiv hπ hkerπ (π x) : B) = x * u :=
    congrArg (fun q ↦ (mulSpanQuotEquiv hkerπ q : B))
      ((Ideal.quotientKerAlgEquivOfSurjective hπ).symm_apply_apply
        (Ideal.Quotient.mk (RingHom.ker π) x))
  obtain ⟨c, rfl⟩ := hπ y
  rw [← map_mul, hπ_apply, hπ_apply, mul_assoc]

private def kerProjSub (σ : B →ₐ[A] A) : B →ₗ[A] (RingHom.ker σ).restrictScalars A where
  toFun b := ⟨b - algebraMap A B (σ b), by simp [RingHom.mem_ker]⟩
  map_add' x y := Subtype.ext (by simp [sub_add_sub_comm])
  map_smul' r x := Subtype.ext (by simp [Algebra.smul_def, mul_sub])

@[simp]
private lemma coe_kerProjSub_apply (σ : B →ₐ[A] A) (b : B) :
    (kerProjSub σ b : B) = b - algebraMap A B (σ b) := rfl

section Split

variable {σ : B →ₐ[A] A} {π : B →ₐ[A] B'} (hπ : Function.Surjective π) {u : B}
  (hσ : RingHom.ker σ = Ideal.span {u}) (hkerπ : RingHom.ker π = (Ideal.span {u}).annihilator)
include hπ hσ hkerπ

private noncomputable def kerEquiv : B' ≃ₗ[A] (RingHom.ker σ).restrictScalars A :=
  mulSpanEquiv hπ hkerπ ≪≫ₗ LinearEquiv.ofEq _ _ (congrArg (Submodule.restrictScalars A) hσ.symm)

private noncomputable def kerIncl : B' →ₗ[A] B :=
  ((RingHom.ker σ).restrictScalars A).subtype.comp (kerEquiv hπ hσ hkerπ).toLinearMap

@[simp]
private lemma coe_kerEquiv_apply (y : B') :
    (kerEquiv hπ hσ hkerπ y : B) = kerIncl hπ hσ hkerπ y := rfl

private lemma kerIncl_eq_mulSpanEquiv (y : B') :
    kerIncl hπ hσ hkerπ y = (mulSpanEquiv hπ hkerπ y : B) := by simp [kerIncl, kerEquiv]

private noncomputable def kerProj : B →ₗ[A] B' :=
  (kerEquiv hπ hσ hkerπ).symm.toLinearMap.comp (kerProjSub σ)

private lemma splitBaseChangeEquiv_left_inv (T : Type*) [CommRing T] [Algebra A T] :
    (LinearMap.coprod ((kerIncl hπ hσ hkerπ).baseChange T) (Algebra.linearMap T (T ⊗[A] B))).comp
      (LinearMap.prod ((kerProj hπ hσ hkerπ).baseChange T) (σ.sectionBaseChange T).toLinearMap) =
        LinearMap.id := by
  have hφρ (b : B) : kerIncl hπ hσ hkerπ (kerProj hπ hσ hkerπ b) + algebraMap A B (σ b) = b := by
    have hval : (kerEquiv hπ hσ hkerπ (kerProj hπ hσ hkerπ b) : B) = b - algebraMap A B (σ b) :=
      (congrArg Subtype.val ((kerEquiv hπ hσ hkerπ).apply_symm_apply _)).trans
        (coe_kerProjSub_apply σ b)
    rw [← coe_kerEquiv_apply, hval, sub_add_cancel]
  refine LinearMap.ext fun x ↦ ?_
  induction x using TensorProduct.inductionOn with
  | tmul t b =>
    simp only [LinearMap.comp_apply, LinearMap.prod_apply, Function.prod_apply,
      LinearMap.coprod_apply, LinearMap.baseChange_tmul, AlgHom.toLinearMap_apply,
      AlgHom.sectionBaseChange_tmul, Algebra.linearMap_apply,
      Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      LinearMap.id_apply]
    rw [mul_comm t, ← Algebra.smul_def, TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
      ← TensorProduct.tmul_add, hφρ]
  | add x₁ x₂ hx₁ hx₂ => simp only [map_add, hx₁, hx₂]

private lemma splitBaseChangeEquiv_right_inv (T : Type*) [CommRing T] [Algebra A T] :
    (LinearMap.prod ((kerProj hπ hσ hkerπ).baseChange T) (σ.sectionBaseChange T).toLinearMap).comp
      (LinearMap.coprod ((kerIncl hπ hσ hkerπ).baseChange T) (Algebra.linearMap T (T ⊗[A] B))) =
        LinearMap.id := by
  have hσy (y : B') : σ (kerIncl hπ hσ hkerπ y) = 0 :=
    RingHom.mem_ker.mp (kerEquiv hπ hσ hkerπ y).2
  have hρφ (y : B') : kerProj hπ hσ hkerπ (kerIncl hπ hσ hkerπ y) = y := by
    refine (congrArg (kerEquiv hπ hσ hkerπ).symm (Subtype.ext ?_)).trans
      ((kerEquiv hπ hσ hkerπ).symm_apply_apply y)
    rw [coe_kerProjSub_apply, coe_kerEquiv_apply, hσy y, map_zero, sub_zero]
  have hρ1 : kerProj hπ hσ hkerπ 1 = 0 := by
    rw [kerProj, LinearMap.comp_apply, ← map_zero (kerEquiv hπ hσ hkerπ).symm]
    exact congrArg _ (Subtype.ext (by simp))
  have h1 (z : T ⊗[A] B') :
      (kerProj hπ hσ hkerπ).baseChange T ((kerIncl hπ hσ hkerπ).baseChange T z) = z := by
    induction z using TensorProduct.inductionOn with
    | tmul s y => simp [hρφ]
    | add z₁ z₂ hz₁ hz₂ => rw [map_add, map_add, hz₁, hz₂]
  have h3 (z : T ⊗[A] B') :
      σ.sectionBaseChange T ((kerIncl hπ hσ hkerπ).baseChange T z) = 0 := by
    induction z using TensorProduct.inductionOn with
    | tmul s y => simp [AlgHom.sectionBaseChange_tmul, hσy]
    | add z₁ z₂ hz₁ hz₂ => rw [map_add, map_add, hz₁, hz₂, add_zero]
  exact LinearMap.ext fun ⟨z, t⟩ ↦ Prod.ext (by simp [map_add, h1, hρ1]) (by simp [map_add, h3])

/-- The `T`-linear splitting `(T ⊗[A] B') × T ≃ₗ[T] T ⊗[A] B` induced by `σ : B →ₐ[A] A` and
`ker σ = (u)`, `ker π = Ann(u)`. -/
private noncomputable def splitBaseChangeEquiv (T : Type*) [CommRing T] [Algebra A T] :
    ((T ⊗[A] B') × T) ≃ₗ[T] T ⊗[A] B :=
  LinearEquiv.ofLinearMap
    (LinearMap.coprod ((kerIncl hπ hσ hkerπ).baseChange T) (Algebra.linearMap T (T ⊗[A] B)))
    (LinearMap.prod ((kerProj hπ hσ hkerπ).baseChange T) (σ.sectionBaseChange T).toLinearMap)
    (splitBaseChangeEquiv_left_inv hπ hσ hkerπ T)
    (splitBaseChangeEquiv_right_inv hπ hσ hkerπ T)

private lemma splitBaseChangeEquiv_apply {T : Type*} [CommRing T] [Algebra A T]
    (z : T ⊗[A] B') (t : T) :
    splitBaseChangeEquiv hπ hσ hkerπ T (z, t) =
      (kerIncl hπ hσ hkerπ).baseChange T z + algebraMap T (T ⊗[A] B) t := rfl

private lemma splitBaseChangeEquiv_symm_snd {T : Type*} [CommRing T] [Algebra A T]
    (x : T ⊗[A] B) :
    ((splitBaseChangeEquiv hπ hσ hkerπ T).symm x).2 = σ.sectionBaseChange T x := rfl

private lemma splitBaseChangeEquiv_conj_apply {T : Type*} [CommRing T] [Algebra A T]
    (f : T ⊗[A] B) (z : T ⊗[A] B') (t : T) :
    (splitBaseChangeEquiv hπ hσ hkerπ T).symm (f * splitBaseChangeEquiv hπ hσ hkerπ T (z, 0)) =
        (Algebra.TensorProduct.map (AlgHom.id T T) π f * z, 0) ∧
      ((splitBaseChangeEquiv hπ hσ hkerπ T).symm
        (f * splitBaseChangeEquiv hπ hσ hkerπ T (z, t))).2 = σ.sectionBaseChange T f * t := by
  let e := splitBaseChangeEquiv hπ hσ hkerπ T
  refine ⟨e.injective ?_, ?_⟩
  · rw [e.apply_symm_apply]
    simp only [e, splitBaseChangeEquiv_apply, map_zero, add_zero]
    induction f using TensorProduct.inductionOn with
    | tmul r b =>
      induction z using TensorProduct.inductionOn with
      | tmul s y =>
        simp only [Algebra.TensorProduct.tmul_mul_tmul, LinearMap.baseChange_tmul,
          Algebra.TensorProduct.map_tmul, AlgHom.id_apply, kerIncl_eq_mulSpanEquiv]
        exact congrArg ((r * s) ⊗ₜ[A] ·) (mul_coe_mulSpanEquiv hπ hkerπ b y)
      | add z₁ z₂ h₁ h₂ => simp [mul_add, h₁, h₂]
    | add f₁ f₂ h₁ h₂ => simp [add_mul, h₁, h₂]
  · have hσ_inl : σ.sectionBaseChange T (e (z, 0)) = 0 :=
      (splitBaseChangeEquiv_symm_snd hπ hσ hkerπ (e (z, 0))).symm.trans
        (congrArg Prod.snd (e.symm_apply_apply (z, 0)))
    have he_pair : e (z, t) = e (z, 0) + algebraMap T (T ⊗[A] B) t := by
      simp [e, splitBaseChangeEquiv_apply]
    rw [splitBaseChangeEquiv_symm_snd, he_pair, map_mul, map_add, hσ_inl, zero_add,
      AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]

/-- If `B'` is finite free over `A`, `σ : B →ₐ[A] A`, `π : B →ₐ[A] B'` is surjective,
`ker σ = (u)` and `ker π = Ann(u)`, then `B` is finite free over `A`. -/
theorem moduleFree_and_moduleFinite_of_ker_span_singleton [Module.Free A B'] [Module.Finite A B'] :
    Module.Free A B ∧ Module.Finite A B :=
  let e : ((A ⊗[A] B') × A) ≃ₗ[A] B :=
    splitBaseChangeEquiv hπ hσ hkerπ A ≪≫ₗ (Algebra.TensorProduct.lid A B).toLinearEquiv
  ⟨.of_equiv e, .equiv e⟩

/-- **Multiplicativity of the norm across a principal section kernel.** Suppose `B'` is finite free
over `A`, `σ : B →ₐ[A] A`, `π : B →ₐ[A] B'` is surjective, `ker σ = (u)` and `ker π = Ann(u)`.
Then for every `A`-algebra `T` and every `f ∈ T ⊗[A] B`, the norm of `f` over `T` is
`σ_T(f) * Algebra.norm T ((1 ⊗ π)(f))`. -/
theorem Algebra.norm_eq_mul_of_ker_span_singleton [Module.Free A B'] [Module.Finite A B']
    (T : Type*) [CommRing T] [Algebra A T] (f : T ⊗[A] B) :
    Algebra.norm T f =
      σ.sectionBaseChange T f *
        Algebra.norm T (Algebra.TensorProduct.map (AlgHom.id T T) π f) := by
  classical
  let e := splitBaseChangeEquiv hπ hσ hkerπ T
  let M : ((T ⊗[A] B') × T) →ₗ[T] (T ⊗[A] B') × T :=
    e.symm.toLinearMap ∘ₗ Algebra.lmul T (T ⊗[A] B) f ∘ₗ e.toLinearMap
  have hdet : LinearMap.det (Algebra.lmul T (T ⊗[A] B) f) = LinearMap.det M := by
    simpa [M] using (LinearMap.det_conj (Algebra.lmul T (T ⊗[A] B) f) e.symm).symm
  let b₁ := Module.Free.chooseBasis T (T ⊗[A] B')
  let b₂ : Module.Basis Unit T T := Module.Basis.singleton Unit T
  let b := b₁.prod b₂
  let f' := Algebra.TensorProduct.map (AlgHom.id T T) π f
  let A₁₁ := LinearMap.toMatrix b₁ b₁ (Algebra.lmul T (T ⊗[A] B') f')
  let A₁₂ := Matrix.of fun i (_ : Unit) ↦ b₁.repr (M (0, 1)).1 i
  let A₂₂ := LinearMap.toMatrix b₂ b₂ (Algebra.lmul T T (σ.sectionBaseChange T f))
  have hmat : LinearMap.toMatrix b b M = Matrix.fromBlocks A₁₁ A₁₂ 0 A₂₂ := by
    ext (i | _) (j | _)
    · simp [b, M, e, A₁₁, f', LinearMap.toMatrix_apply,
        (splitBaseChangeEquiv_conj_apply hπ hσ hkerπ f (b₁ j) 0).1]
    · simp [b, b₂, A₁₂, LinearMap.toMatrix_apply]
    · simp [b, M, e, LinearMap.toMatrix_apply,
        (splitBaseChangeEquiv_conj_apply hπ hσ hkerπ f (b₁ j) 0).1]
    · simp [b, b₂, M, e, A₂₂, LinearMap.toMatrix_apply,
        (splitBaseChangeEquiv_conj_apply hπ hσ hkerπ f 0 1).2]
  rw [Algebra.norm_apply, hdet, ← LinearMap.det_toMatrix b, hmat, Matrix.det_fromBlocks_zero₂₁,
    LinearMap.det_toMatrix b₁, LinearMap.det_toMatrix b₂, ← Algebra.norm_apply,
    ← Algebra.norm_apply, Algebra.norm_self, MonoidHom.id_apply, mul_comm]

/-- **Extending a full set of sections across a principal section kernel.** Suppose `B'` is finite
free over `A`, `σ : B →ₐ[A] A`, `π : B →ₐ[A] B'` is surjective, `ker σ = (u)` and `ker π = Ann(u)`.
If `s'` is a full set of sections of `B'` over `A`, then adjoining `σ` to `(s' i).comp π` produces
a full set of sections of `B` over `A`. -/
theorem IsFullSetOfSections.optionElim_of_ker_span_singleton {ι : Type*} [Fintype ι]
    [Module.Free A B'] [Module.Finite A B'] {s' : ι → B' →ₐ[A] A} (hs' : IsFullSetOfSections s') :
    IsFullSetOfSections (fun o : Option ι ↦ o.elim σ fun i ↦ (s' i).comp π) := by
  rw [isFullSetOfSections_iff]; intro T _ _ _ f
  rw [Algebra.norm_eq_mul_of_ker_span_singleton hπ hσ hkerπ T f, hs'.norm_eq T, Fintype.prod_option]
  refine congrArg (σ.sectionBaseChange T f * ·) (Finset.prod_congr rfl fun i _ ↦ ?_)
  induction f using TensorProduct.inductionOn with
  | tmul t b => simp [AlgHom.sectionBaseChange_tmul]
  | add x y hx hy => simp [map_add, hx, hy]

end Split

end PrincipalKernel

end TauCeti
