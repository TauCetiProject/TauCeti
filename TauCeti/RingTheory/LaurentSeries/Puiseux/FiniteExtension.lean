module

public import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed
public import TauCeti.FieldTheory.Galois.Cyclic
public import TauCeti.RingTheory.LaurentSeries.Level.Kummer
public import TauCeti.RingTheory.LaurentSeries.Puiseux.AlgClosure

/-!
# Finite extensions of the Laurent-series field

Let `K` be a field containing a primitive `n`-th root of unity for every `n > 0` (so of
characteristic zero). This file proves that the finite extensions of `K⸨X⸩` inside the Puiseux
field are exactly the ramified levels `K⸨t ^ (1 / e)⸩`, one for each degree `e`. When `K` is
moreover algebraically closed, every finite extension of `K⸨X⸩` of degree `e` is therefore
isomorphic over `K⸨X⸩` to the level `K⸨u⸩` with `u ^ e = X`.

A finite-dimensional intermediate field `E` of the Puiseux field is spanned by finitely many
Puiseux series, so it lies in a single level `n`. The level `n` is a Galois extension of `K⸨X⸩`
with cyclic Galois group `μₙ(K)`. A cyclic group has at most one subgroup of each index, so by the
Galois correspondence `E` is the unique intermediate field of level `n` of degree `[E : K⸨X⸩]`,
namely the level of that degree.

Consequently a Puiseux series `x` generates the level `[K⸨X⸩(x) : K⸨X⸩]`, it lies in level `n`
exactly when this degree divides `n`, and a root of a nonzero polynomial of degree `d` over
`K⸨X⸩` lies in level `d!`.

## Main results

* `TauCeti.puiseuxField.exists_le_level`: a finite-dimensional intermediate field of the Puiseux
  field lies in a single ramified level, over any field `K`.
* `TauCeti.puiseuxField.eq_level_of_finrank_eq`: an intermediate field of degree `e` is level `e`.
* `TauCeti.puiseuxField.finiteDimensional_iff_exists_eq_level`: the finite-dimensional
  intermediate fields are exactly the levels.
* `TauCeti.puiseuxField.adjoin_simple_eq_level`: `K⸨X⸩(x)` is the level of degree
  `[K⸨X⸩(x) : K⸨X⸩]`.
* `TauCeti.puiseuxField.mem_level_iff_finrank_adjoin_dvd`: `x` lies in level `n` exactly when
  `[K⸨X⸩(x) : K⸨X⸩]` divides `n`.
* `TauCeti.puiseuxField.mem_level_factorial_of_aeval_eq_zero`: a root of a nonzero polynomial of
  degree `d` lies in level `d!`.
* `TauCeti.LaurentSeries.Level.algEquivOfFinrankEq`: for `K` algebraically closed of
  characteristic zero, a chosen isomorphism over `K⸨X⸩` from a finite extension of degree `e` to
  the level `K⸨u⸩`, `u ^ e = X`.
* `TauCeti.LaurentSeries.Level.nonempty_algEquiv_iff`: a finite extension is isomorphic to level
  `e` exactly when its degree is `e`.
-/

public section

open IntermediateField Module Polynomial
open scoped LaurentSeries

namespace TauCeti.puiseuxField

variable {K : Type*} [Field K]

/-- A finite-dimensional intermediate field of the Puiseux field over `K⸨X⸩` lies in a single
ramified level. -/
theorem exists_le_level (E : IntermediateField K⸨X⸩ (puiseuxField K))
    [FiniteDimensional K⸨X⸩ E] : ∃ n : ℕ+, E ≤ level K n := by
  let b := finBasis K⸨X⸩ E
  obtain ⟨n, hn⟩ := exists_forall_mem_range_levelEmbedding fun i ↦ (b i : puiseuxField K)
  refine ⟨n, fun x hx ↦ ?_⟩
  lift x to E using hx
  rw [← b.sum_repr x, IntermediateField.coe_sum]
  exact sum_mem fun i _ ↦ smul_mem _ ((mem_level_iff K n _).mpr (hn i))

/-- The intermediate field generated by a Puiseux series has positive degree over `K⸨X⸩`. -/
private theorem finrank_adjoin_simple_pos (x : puiseuxField K) : 0 < finrank K⸨X⸩ K⸨X⸩⟮x⟯ :=
  have := adjoin.finiteDimensional ((isAlgebraic_laurentSeries K).isAlgebraic x).isIntegral
  finrank_pos

section RootsOfUnity

variable [∀ n : ℕ+, HasEnoughRootsOfUnity K n]

/-- If `K` contains all roots of unity, then an intermediate field of the Puiseux field of degree
`e` over `K⸨X⸩` is the level-`e` subfield `K⸨t ^ (1 / e)⸩`. -/
theorem eq_level_of_finrank_eq {E : IntermediateField K⸨X⸩ (puiseuxField K)} {e : ℕ+}
    (h : finrank K⸨X⸩ E = e) : E = level K e := by
  have : FiniteDimensional K⸨X⸩ E := .of_finrank_pos (h ▸ e.pos)
  obtain ⟨n, hn⟩ := exists_le_level E
  have he : e ∣ n := by
    rw [PNat.dvd_iff, ← h, ← level_finrank K n]
    exact finrank_dvd_of_le_right hn
  have hle := level_le_level_of_dvd K he
  have : FiniteDimensional K⸨X⸩ (level K n) := (levelPowerBasis K n).finite
  have : IsCyclic Gal(level K n/K⸨X⸩) := (levelGalEquivRootsOfUnity K n).isCyclic.mpr inferInstance
  -- Inside the cyclic Galois extension `level K n`, both fields have degree `e`, so they coincide.
  rw [← lift_restrict hn, ← lift_restrict hle]
  refine congrArg lift (eq_of_finrank_eq_of_isCyclic ?_)
  rw [← (restrictAlgEquiv hn).toLinearEquiv.finrank_eq,
    ← (restrictAlgEquiv hle).toLinearEquiv.finrank_eq, h, level_finrank]

/-- If `K` contains all roots of unity, then the finite-dimensional intermediate fields of the
Puiseux field over `K⸨X⸩` are exactly the ramified levels. -/
theorem finiteDimensional_iff_exists_eq_level (E : IntermediateField K⸨X⸩ (puiseuxField K)) :
    FiniteDimensional K⸨X⸩ E ↔ ∃ n : ℕ+, E = level K n := by
  refine ⟨fun _ ↦ ⟨_, eq_level_of_finrank_eq (PNat.toPNat'_coe finrank_pos).symm⟩, ?_⟩
  rintro ⟨n, rfl⟩
  exact (levelPowerBasis K n).finite

/-- If `K` contains all roots of unity, then the intermediate field generated by a Puiseux series
`x` is the level of degree `[K⸨X⸩(x) : K⸨X⸩]`. -/
theorem adjoin_simple_eq_level (x : puiseuxField K) :
    K⸨X⸩⟮x⟯ = level K (finrank K⸨X⸩ K⸨X⸩⟮x⟯).toPNat' :=
  eq_level_of_finrank_eq (PNat.toPNat'_coe (finrank_adjoin_simple_pos x)).symm

/-- If `K` contains all roots of unity, then a Puiseux series `x` lies in level `n` exactly when
the degree `[K⸨X⸩(x) : K⸨X⸩]` divides `n`. In particular this degree is the least level containing
`x`. -/
theorem mem_level_iff_finrank_adjoin_dvd {x : puiseuxField K} {n : ℕ+} :
    x ∈ level K n ↔ finrank K⸨X⸩ K⸨X⸩⟮x⟯ ∣ n := by
  rw [← adjoin_simple_le_iff]
  conv_lhs => rw [adjoin_simple_eq_level, level_le_level_iff, PNat.dvd_iff,
    PNat.toPNat'_coe (finrank_adjoin_simple_pos x)]

/-- If `K` contains all roots of unity, then a Puiseux series that is a root of a nonzero
polynomial of degree `d` over `K⸨X⸩` lies in level `d!`. Thus all roots of such a polynomial lie in
a common level. -/
theorem mem_level_factorial_of_aeval_eq_zero {p : K⸨X⸩[X]} (hp : p ≠ 0) {x : puiseuxField K}
    (hx : aeval x p = 0) : x ∈ level K p.natDegree.factorial.toPNat' := by
  have hint : IsIntegral K⸨X⸩ x := ((isAlgebraic_laurentSeries K).isAlgebraic x).isIntegral
  rw [mem_level_iff_finrank_adjoin_dvd, PNat.toPNat'_coe p.natDegree.factorial_pos,
    adjoin.finrank hint]
  exact Nat.dvd_factorial (minpoly.natDegree_pos hint)
    (natDegree_le_natDegree (minpoly.degree_le_of_ne_zero K⸨X⸩ x hp hx))

end RootsOfUnity

end TauCeti.puiseuxField

namespace TauCeti.LaurentSeries.Level

open puiseuxField

variable {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
  {L : Type*} [Field L] [Algebra K⸨X⸩ L]

/-- **Finite extensions of `K⸨X⸩`.** If `K` is algebraically closed of characteristic zero, then
every extension `L` of `K⸨X⸩` of degree `e` is isomorphic over `K⸨X⸩` to the ramified level
`K⸨u⸩`, `u ^ e = X`. The isomorphism is a chosen one: it is built from a chosen embedding of `L`
into the Puiseux field, whose image is the level-`e` subfield. -/
noncomputable def algEquivOfFinrankEq {e : ℕ+} (h : finrank K⸨X⸩ L = e) :
    L ≃ₐ[K⸨X⸩] Level K e :=
  have : FiniteDimensional K⸨X⸩ L := .of_finrank_pos (h ▸ e.pos)
  let φ : L →ₐ[K⸨X⸩] puiseuxField K := IsAlgClosed.lift
  φ.equivFieldRange.trans <| (equivOfEq <| eq_level_of_finrank_eq <|
    φ.equivFieldRange.toLinearEquiv.finrank_eq.symm.trans h).trans (levelEquiv K e).symm

/-- If `K` is algebraically closed of characteristic zero, then an extension of `K⸨X⸩` is
isomorphic over `K⸨X⸩` to the ramified level `K⸨u⸩`, `u ^ e = X`, exactly when it has degree
`e`. -/
theorem nonempty_algEquiv_iff {e : ℕ+} : Nonempty (L ≃ₐ[K⸨X⸩] Level K e) ↔ finrank K⸨X⸩ L = e :=
  ⟨fun ⟨f⟩ ↦ f.toLinearEquiv.finrank_eq.trans <|
    (levelEquiv K e).toLinearEquiv.finrank_eq.trans (level_finrank K e),
    fun h ↦ ⟨algEquivOfFinrankEq h⟩⟩

end TauCeti.LaurentSeries.Level
