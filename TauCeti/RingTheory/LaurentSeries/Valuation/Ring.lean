module

public import TauCeti.RingTheory.Huber.LaurentSeries
public import TauCeti.RingTheory.LaurentSeries.Basic

/-!
# The valuation ring of formal Laurent series

For a field `K`, the valuation integers in `K⸨X⸩` are the embedded power series
`LaurentSeries.powerSeries_as_subring K`. This file identifies their local-ring structure with
the `X`-adic structure of `K⟦X⟧`: the maximal ideal is generated by `X`, consists of the
series of positive order, and is the kernel of the constant-coefficient map. Consequently, the
residue field is canonically isomorphic to `K`, with the residue of a power series sent to its
constant coefficient.

## Main results

* `TauCeti.LaurentSeries.maximalIdeal_eq_idealOfDefinition`: the maximal ideal is the ideal `(X)`
  used as an ideal of definition for the Laurent-series topology.
* `TauCeti.LaurentSeries.mem_maximalIdeal_iff_orderTop_pos`: membership in the maximal ideal is
  equivalent to positive Laurent order.
* `TauCeti.LaurentSeries.constantCoeff`: the constant-coefficient homomorphism on the valuation
  ring, whose kernel is the maximal ideal.
* `TauCeti.LaurentSeries.residueFieldEquiv`: the residue field of the Laurent valuation ring is
  canonically isomorphic to the coefficient field.
-/

public section

open scoped LaurentSeries PowerSeries

namespace TauCeti.LaurentSeries

open _root_.LaurentSeries
open TauCeti.Huber.LaurentSeries

variable (K : Type*) [Field K]

/-- The embedded power-series ring is local, by transport from the usual local-ring structure on
`K⟦X⟧`. -/
noncomputable instance powerSeriesAsSubringIsLocalRing :
    IsLocalRing (powerSeries_as_subring K) :=
  (powerSeriesEquivSubring K).isLocalRing

/-- The maximal ideal of the Laurent valuation ring is the ideal `(X)` used as its ideal of
definition. -/
theorem maximalIdeal_eq_idealOfDefinition :
    IsLocalRing.maximalIdeal (powerSeries_as_subring K) = idealOfDefinition K := by
  rw [← IsLocalRing.map_ringEquiv_maximalIdeal (powerSeriesEquivSubring K),
    PowerSeries.maximalIdeal_eq_span_X, Ideal.map_span, idealOfDefinition_def]
  rw [Set.image_singleton]
  congr 2
  ext
  rw [coe_subringX, powerSeriesEquivSubring_coe_apply]

/-- An element of the Laurent valuation ring is in its maximal ideal exactly when its valuation
is strictly less than one. -/
theorem mem_maximalIdeal_iff_valuation_lt_one (f : powerSeries_as_subring K) :
    f ∈ IsLocalRing.maximalIdeal (powerSeries_as_subring K) ↔
      Valued.v (f : K⸨X⸩) < 1 := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    (integers_powerSeries_as_subring K).isUnit_iff_valuation_eq_one, ← ne_eq]
  exact ne_iff_lt_iff_le.mpr ((integers_powerSeries_as_subring K).map_le_one f)

/-- An element of the Laurent valuation ring is in its maximal ideal exactly when it has positive
Laurent order. This includes zero, whose `orderTop` is infinity. -/
theorem mem_maximalIdeal_iff_orderTop_pos (f : powerSeries_as_subring K) :
    f ∈ IsLocalRing.maximalIdeal (powerSeries_as_subring K) ↔
      0 < (f : K⸨X⸩).orderTop := by
  rw [mem_maximalIdeal_iff_valuation_lt_one]
  by_cases hf : (f : K⸨X⸩) = 0
  · simp [hf]
  · rw [valuation_eq_exp_neg_order hf, WithZero.exp_lt_one_iff, neg_lt_zero,
      HahnSeries.zero_lt_orderTop_iff hf]

/-- The constant-coefficient homomorphism on the Laurent valuation ring. -/
noncomputable def constantCoeff : powerSeries_as_subring K →+* K :=
  PowerSeries.constantCoeff.comp (powerSeriesEquivSubring K).symm.toRingHom

/-- The constant coefficient read through the power-series presentation equals the coefficient at
Laurent exponent zero. -/
@[simp]
theorem constantCoeff_apply (f : powerSeries_as_subring K) :
    constantCoeff K f = (f : K⸨X⸩).coeff 0 := by
  obtain ⟨g, rfl⟩ := (powerSeriesEquivSubring K).surjective f
  rw [constantCoeff, RingHom.comp_apply]
  -- The inverse equivalence is coerced to a ring homomorphism in `constantCoeff`; expose the
  -- equivalent application before using its inverse law.
  change PowerSeries.constantCoeff ((powerSeriesEquivSubring K).symm
      (powerSeriesEquivSubring K g)) = _
  rw [RingEquiv.symm_apply_apply, powerSeriesEquivSubring_coe_apply,
    ← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_coe]
  simp

/-- Every coefficient occurs as the constant coefficient of a Laurent valuation integer. -/
theorem constantCoeff_surj : Function.Surjective (constantCoeff K) := by
  intro c
  refine ⟨powerSeriesEquivSubring K (PowerSeries.C c), ?_⟩
  simp [constantCoeff]

/-- The kernel of the constant-coefficient map is the maximal ideal of the Laurent valuation
ring. -/
theorem ker_constantCoeff_eq_maximalIdeal :
    RingHom.ker (constantCoeff K) = IsLocalRing.maximalIdeal (powerSeries_as_subring K) := by
  ext f
  obtain ⟨g, rfl⟩ := (powerSeriesEquivSubring K).surjective f
  rw [RingHom.mem_ker, constantCoeff_apply, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    powerSeriesEquivSubring_coe_apply, PowerSeries.coeff_coe]
  simp [PowerSeries.isUnit_iff_constantCoeff]

/-- An element of the Laurent valuation ring belongs to its maximal ideal exactly when its
constant coefficient vanishes. -/
theorem mem_maximalIdeal_iff_constantCoeff_eq_zero (f : powerSeries_as_subring K) :
    f ∈ IsLocalRing.maximalIdeal (powerSeries_as_subring K) ↔ constantCoeff K f = 0 := by
  rw [← ker_constantCoeff_eq_maximalIdeal, RingHom.mem_ker]

/-- The residue field of the Laurent valuation ring is canonically the coefficient field. -/
noncomputable def residueFieldEquiv :
    IsLocalRing.ResidueField (powerSeries_as_subring K) ≃+* K :=
  (Ideal.quotEquivOfEq (ker_constantCoeff_eq_maximalIdeal K).symm).trans
    (RingHom.quotientKerEquivOfSurjective (constantCoeff_surj K))

/-- Under the residue-field equivalence, the residue of a valuation integer is its constant
coefficient. -/
@[simp]
theorem residueFieldEquiv_residue (f : powerSeries_as_subring K) :
    residueFieldEquiv K (IsLocalRing.residue _ f) = (f : K⸨X⸩).coeff 0 := by
  -- `ResidueField` is definitionally a quotient. Expose its quotient representative so the
  -- computation rules for the two quotient equivalences apply without unfolding their bodies.
  change residueFieldEquiv K (Ideal.Quotient.mk _ f) = _
  change (RingHom.quotientKerEquivOfSurjective (constantCoeff_surj K))
      (Ideal.quotEquivOfEq (ker_constantCoeff_eq_maximalIdeal K).symm
        (Ideal.Quotient.mk _ f)) = _
  rw [Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk,
    constantCoeff_apply]

/-- The inverse residue-field equivalence sends a coefficient to the residue of the corresponding
constant power series. -/
@[simp]
theorem residueFieldEquiv_symm_apply (c : K) :
    (residueFieldEquiv K).symm c =
      IsLocalRing.residue _ (powerSeriesEquivSubring K (PowerSeries.C c)) := by
  apply (residueFieldEquiv K).injective
  simp

end TauCeti.LaurentSeries
