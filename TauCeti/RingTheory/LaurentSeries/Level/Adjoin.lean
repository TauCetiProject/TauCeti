module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.RingTheory.Etale.Field
public import TauCeti.RingTheory.LaurentSeries.Level.Basis

/-!
# Ramified Laurent levels as radical extensions

For a field `K` and a positive integer `d`, the parameter `u` of the ramified Laurent level
`K⸨u⸩` satisfies `u ^ d = X`, where `X` is the parameter of the base Laurent field `K⸨X⸩`.
The power basis of the level shows that `T ^ d - X` is the minimal polynomial of `u`, hence is
irreducible over `K⸨X⸩`. Thus both the wrapped level and its actual image inside the Puiseux field
are obtained by adjoining this root, and they are separable — equivalently, formally étale — over
`K⸨X⸩` if and only if `d` is nonzero in `K`.

These identifications provide the radical-extension presentation and étaleness instances of finite
Puiseux levels needed in Kummer theory and for intrinsic continuous Kähler differentials.

## Main results

* `TauCeti.LaurentSeries.Level.minpoly_parameter`: the level parameter has minimal polynomial
  `T ^ d - X`.
* `TauCeti.LaurentSeries.irreducible_X_pow_sub_C_single`: `T ^ d - X` is irreducible over the
  Laurent-series field.
* `TauCeti.LaurentSeries.Level.isSeparable_iff` and
  `TauCeti.LaurentSeries.Level.formallyEtale_iff`: level `d` is separable, equivalently formally
  étale, over `K⸨X⸩` if and only if `d ≠ 0` in `K`.
* `TauCeti.puiseuxField.level_eq_adjoin`: the actual level-`d` subfield is generated by its
  distinguished parameter.
-/

public section

open Polynomial
open scoped LaurentSeries

namespace TauCeti.LaurentSeries

namespace Level

variable (K : Type*) [Field K] (d : ℕ+)

/-- The minimal polynomial of the level parameter `u` is `T ^ d - X`. -/
@[simp]
theorem minpoly_parameter :
    minpoly K⸨X⸩ (parameter K d) = X ^ (d : ℕ) - C (HahnSeries.single 1 1) := by
  symm
  apply minpoly.unique_of_degree_le_degree_minpoly
    (A := K⸨X⸩) (x := parameter K d) (monic_X_pow_sub_C _ d.ne_zero)
  · rw [map_sub, aeval_X_pow, aeval_C, sub_eq_zero, parameter_pow]
  · rw [degree_X_pow_sub_C d.pos, ← powerBasis_gen K d,
      (powerBasis K d).degree_minpoly, powerBasis_dim]

/-- The wrapped ramified level is generated over the base Laurent field by its parameter. -/
@[simp]
theorem adjoin_parameter_eq_top :
    IntermediateField.adjoin K⸨X⸩ ({parameter K d} : Set (Level K d)) = ⊤ := by
  rw [← powerBasis_gen]
  apply (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic
    (powerBasis K d).isIntegral_gen.isAlgebraic).mpr
  exact (powerBasis K d).adjoin_gen_eq_top

/-- The level parameter `u` is separable over `K⸨X⸩` if and only if `d` is nonzero in `K`. -/
theorem isSeparable_parameter_iff :
    IsSeparable K⸨X⸩ (parameter K d) ↔ ((d : ℕ) : K) ≠ 0 := by
  have hcast : ((d : ℕ) : K⸨X⸩) = 0 ↔ ((d : ℕ) : K) = 0 := by
    rw [← map_natCast (Algebra.algebraMap K K⸨X⸩)]
    exact map_eq_zero_iff _ (Algebra.algebraMap K K⸨X⸩).injective
  rw [IsSeparable, minpoly_parameter,
    X_pow_sub_C_separable_iff d.pos (HahnSeries.single_ne_zero one_ne_zero), ne_eq, hcast]

/-- Level `d` is separable over `K⸨X⸩` if and only if `d` is nonzero in `K`. -/
theorem isSeparable_iff :
    Algebra.IsSeparable K⸨X⸩ (Level K d) ↔ ((d : ℕ) : K) ≠ 0 := by
  rw [← isSeparable_parameter_iff]
  refine ⟨fun _ ↦ Algebra.IsSeparable.isSeparable K⸨X⸩ (parameter K d), fun h ↦ ?_⟩
  have : Algebra.IsSeparable K⸨X⸩ (IntermediateField.adjoin K⸨X⸩ {parameter K d}) :=
    (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K⸨X⸩ (Level K d)).mpr h
  exact Algebra.IsSeparable.of_algHom _ _
    (IntermediateField.topEquiv.symm.trans
      (IntermediateField.equivOfEq (adjoin_parameter_eq_top K d).symm)).toAlgHom

/-- When `d` is nonzero in `K`, the ramified level `K⸨u⸩` is separable over `K⸨X⸩`. -/
instance [NeZero ((d : ℕ) : K)] : Algebra.IsSeparable K⸨X⸩ (Level K d) :=
  (isSeparable_iff K d).mpr (NeZero.ne _)

/-- When `d` is nonzero in `K`, the ramified level `K⸨u⸩` is formally étale over `K⸨X⸩`. -/
instance [NeZero ((d : ℕ) : K)] : Algebra.FormallyEtale K⸨X⸩ (Level K d) :=
  Algebra.FormallyEtale.of_isSeparable K⸨X⸩ (Level K d)

/-- Level `d` is formally étale over `K⸨X⸩` if and only if `d` is nonzero in `K`. -/
theorem formallyEtale_iff :
    Algebra.FormallyEtale K⸨X⸩ (Level K d) ↔ ((d : ℕ) : K) ≠ 0 := by
  have : FiniteDimensional K⸨X⸩ (Level K d) := (powerBasis K d).finite
  rw [Algebra.FormallyEtale.iff_isSeparable, isSeparable_iff]

end Level

/-- The radical polynomial `T ^ d - X` is irreducible over the Laurent-series field. -/
theorem irreducible_X_pow_sub_C_single (K : Type*) [Field K] (d : ℕ+) :
    Irreducible (X ^ (d : ℕ) - C (HahnSeries.single 1 1) : K⸨X⸩[X]) := by
  rw [← Level.minpoly_parameter]
  rw [← Level.powerBasis_gen]
  exact minpoly.irreducible (Level.powerBasis K d).isIntegral_gen

end TauCeti.LaurentSeries

namespace TauCeti.puiseuxField

variable (K : Type*) [Field K] (d : ℕ+)

/-- The distinguished parameter of the actual level-`d` subfield of the Puiseux field. -/
noncomputable abbrev levelParameter : level K d := (levelPowerBasis K d).gen

/-- The actual level parameter is a `d`-th root of the base Laurent parameter. -/
theorem levelParameter_pow :
    levelParameter K d ^ (d : ℕ) =
      algebraMap K⸨X⸩ (level K d) (HahnSeries.single 1 1) := by
  rw [levelParameter, levelPowerBasis_gen, ← map_pow, LaurentSeries.Level.parameter_pow]
  exact (levelEquiv K d).commutes (HahnSeries.single 1 1)

/-- The level parameter `t ^ (1 / d)`, viewed in the Puiseux field, is a `d`-th root of the base
Laurent parameter. -/
theorem coe_levelParameter_pow :
    (levelParameter K d : puiseuxField K) ^ (d : ℕ) =
      algebraMap K⸨X⸩ (puiseuxField K) (HahnSeries.single 1 1) := by
  rw [← SubmonoidClass.coe_pow, levelParameter_pow]
  rfl

/-- The minimal polynomial of the actual level parameter is `T ^ d - X`. -/
theorem minpoly_levelParameter :
    minpoly K⸨X⸩ (levelParameter K d) =
      X ^ (d : ℕ) - C (HahnSeries.single 1 1) := by
  rw [levelParameter, levelPowerBasis_gen, minpoly.algEquiv_eq,
    LaurentSeries.Level.minpoly_parameter]

/-- Internally, the actual level is generated over the base Laurent field by its parameter. -/
theorem adjoin_levelParameter_eq_top :
    IntermediateField.adjoin K⸨X⸩ ({levelParameter K d} : Set (level K d)) = ⊤ := by
  apply (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic
    (levelPowerBasis K d).isIntegral_gen.isAlgebraic).mpr
  exact (levelPowerBasis K d).adjoin_gen_eq_top

/-- As intermediate fields of the Puiseux field, level `d` is obtained by adjoining its
distinguished parameter. -/
theorem level_eq_adjoin :
    level K d = IntermediateField.adjoin K⸨X⸩
      {((levelParameter K d : level K d) : TauCeti.puiseuxField K)} := by
  have h := congrArg IntermediateField.lift (adjoin_levelParameter_eq_top K d)
  rw [IntermediateField.lift_adjoin_simple, IntermediateField.lift_top] at h
  exact h.symm

/-- The actual level-`d` subfield is separable over `K⸨X⸩` if and only if `d` is nonzero in `K`. -/
theorem isSeparable_level_iff :
    Algebra.IsSeparable K⸨X⸩ (level K d) ↔ ((d : ℕ) : K) ≠ 0 := by
  rw [← LaurentSeries.Level.isSeparable_iff K d]
  exact ⟨fun _ ↦ Algebra.IsSeparable.of_algHom _ _ (levelEquiv K d).toAlgHom,
    fun _ ↦ Algebra.IsSeparable.of_algHom _ _ (levelEquiv K d).symm.toAlgHom⟩

/-- When `d` is nonzero in `K`, the actual level-`d` subfield is separable over `K⸨X⸩`. -/
instance [NeZero ((d : ℕ) : K)] : Algebra.IsSeparable K⸨X⸩ (level K d) :=
  (isSeparable_level_iff K d).mpr (NeZero.ne _)

/-- When `d` is nonzero in `K`, the actual level-`d` subfield is formally étale over `K⸨X⸩`. -/
instance [NeZero ((d : ℕ) : K)] : Algebra.FormallyEtale K⸨X⸩ (level K d) :=
  Algebra.FormallyEtale.of_isSeparable K⸨X⸩ (level K d)

end TauCeti.puiseuxField
