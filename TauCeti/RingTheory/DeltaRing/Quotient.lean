public import TauCeti.RingTheory.DeltaRing.Basic

/-!
# Quotients of δ-rings by δ-stable ideals

Let `A` be a `δ`-ring and `I` an ideal of `A`. If `δ` maps `I` into `I`, then `δ` descends to a
`δ`-structure on `A ⧸ I` making the quotient map a `δ`-map. Conversely, if some `δ`-structure on
`A ⧸ I` makes the quotient map a `δ`-map, then `δ` maps `I` into `I`, and that structure is the
descended one (Bhatt and Scholze, *Prisms and prismatic cohomology*, Lemma 2.9).

An ideal generated by a set `S` is `δ`-stable as soon as `δ s` lies in it for each generator `s`.
Hence the ideal `deltaStabilization p I` generated by all iterates `δ^[n] a` with `a ∈ I` is the
smallest `δ`-stable ideal containing `I`. The quotient `A ⧸ deltaStabilization p I` is the
universal `δ`-ring under `A` in which `I` vanishes: `δ`-maps out of it correspond to `δ`-maps out
of `A` whose kernel contains `I`. This is how `δ`-rings are presented by generators and relations,
for instance in the construction of prismatic envelopes.

## Main definitions

* `TauCeti.DeltaRing.quotient`: the `δ`-structure on `A ⧸ I` for a `δ`-stable ideal `I`.
* `TauCeti.DeltaRing.deltaStabilization`: the ideal generated by all `δ^[n] a` with `a ∈ I`.
* `TauCeti.DeltaRing.instDeltaRingQuotientDeltaStabilization`: the `δ`-structure on the universal
  `δ`-quotient `A ⧸ deltaStabilization p I`.
* `TauCeti.DeltaRing.deltaStabilizationLiftEquiv`: its universal property.

## Main results

* `TauCeti.DeltaRing.forall_delta_mem_span_iff`: an ideal is `δ`-stable once `δ` maps its
  generators into it.
* `TauCeti.DeltaRing.IsDeltaMap.delta_mem_ker`: kernels of `δ`-maps are `δ`-stable.
* `TauCeti.DeltaRing.deltaStabilization_le_iff`: `deltaStabilization p I ≤ J` if and only if
  `I ≤ J`, for a `δ`-stable ideal `J`.
* `TauCeti.DeltaRing.isDeltaMap_quotient_mk`: the quotient map is a `δ`-map.
* `TauCeti.DeltaRing.isDeltaMap_quotient_lift`: a `δ`-map killing `I` induces a `δ`-map on
  `A ⧸ I`.
* `TauCeti.DeltaRing.isDeltaMap_comp_quotient_mk_iff`: a ring map out of `A ⧸ I` is a `δ`-map if
  and only if its composite with the quotient map is.
* `TauCeti.DeltaRing.existsUnique_isDeltaMap_quotient_mk_iff`: there is a unique `δ`-structure on
  `A ⧸ I` making the quotient map a `δ`-map if and only if `δ` maps `I` into `I`. Uniqueness is
  `TauCeti.DeltaRing.eq_of_isDeltaMap_of_surjective`: at most one `δ`-structure on the target of a
  surjective ring homomorphism makes it a `δ`-map.

## References

* B. Bhatt and P. Scholze, *Prisms and prismatic cohomology*, Ann. of Math. 196 (2022), §2.1,
  Lemma 2.9 and Example 2.10.
-/

public section

namespace TauCeti

namespace DeltaRing

variable {p : ℕ} {A : Type*} [CommRing A]

section DeltaStable

variable {B : Type*} [CommRing B] [DeltaRing p A] {I : Ideal A}

/-- If `δ` maps `J` into `J`, then it maps the preimage of `J` under a `δ`-map into itself. -/
theorem IsDeltaMap.delta_mem_comap [DeltaRing p B] {f : A →+* B} (hf : IsDeltaMap p f)
    {J : Ideal B} (hJ : ∀ y ∈ J, delta p y ∈ J) : ∀ x ∈ J.comap f, delta p x ∈ J.comap f :=
  fun x hx => by
    rw [Ideal.mem_comap, hf.map_delta]
    exact hJ _ hx

/-- `δ` maps the kernel of a `δ`-map into itself. -/
theorem IsDeltaMap.delta_mem_ker [DeltaRing p B] {f : A →+* B} (hf : IsDeltaMap p f) :
    ∀ x ∈ RingHom.ker f, delta p x ∈ RingHom.ker f := by
  rw [RingHom.ker_eq_comap_bot]
  exact hf.delta_mem_comap fun y hy => by simp [(Submodule.mem_bot B).mp hy]

/-- `δ` maps the ideal generated by a set `S` into itself if and only if it maps `S` into it. -/
theorem forall_delta_mem_span_iff {S : Set A} :
    (∀ x ∈ Ideal.span S, delta p x ∈ Ideal.span S) ↔ ∀ s ∈ S, delta p s ∈ Ideal.span S := by
  refine ⟨fun h s hs => h s (Ideal.subset_span hs), fun h x hx => ?_⟩
  rcases eq_or_ne p 0 with rfl | hp
  · rw [delta_eq_zero_of_p_eq_zero rfl]
    exact zero_mem _
  induction hx using Submodule.span_induction with
  | mem s hs => exact h s hs
  | zero => simp
  | add x y hx _ hx' hy' =>
    rw [delta_add]
    exact add_mem (add_mem hx' hy') (addCorrection_mem_of_mem_left y hx)
  | smul a x hx hx' =>
    rw [smul_eq_mul, delta_mul]
    refine add_mem (add_mem (Ideal.mul_mem_left _ _ hx') ?_) (Ideal.mul_mem_left _ _ hx')
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hx p (Nat.pos_of_ne_zero hp))

end DeltaStable

section DeltaStabilization

variable [DeltaRing p A] {I J : Ideal A}

variable (p) in
/-- The `δ`-stabilization of an ideal `I`: the ideal generated by all iterates `δ^[n] a` with
`a ∈ I` and `n : ℕ`. It is the smallest ideal containing `I` that `δ` maps into itself
(`delta_mem_deltaStabilization` and `deltaStabilization_le_iff`). -/
def deltaStabilization (I : Ideal A) : Ideal A :=
  Ideal.span {x | ∃ a ∈ I, ∃ n : ℕ, (delta p)^[n] a = x}

/-- Every iterate of `δ` maps `I` into `deltaStabilization p I`. -/
theorem iterate_delta_mem_deltaStabilization {a : A} (ha : a ∈ I) (n : ℕ) :
    (delta p)^[n] a ∈ deltaStabilization p I :=
  Ideal.subset_span ⟨a, ha, n, rfl⟩

variable (p) in
/-- `I ≤ deltaStabilization p I`. -/
theorem le_deltaStabilization (I : Ideal A) : I ≤ deltaStabilization p I :=
  fun _ ha => iterate_delta_mem_deltaStabilization ha 0

/-- `δ` maps the `δ`-stabilization of an ideal into itself. -/
theorem delta_mem_deltaStabilization {x : A} (hx : x ∈ deltaStabilization p I) :
    delta p x ∈ deltaStabilization p I := by
  refine forall_delta_mem_span_iff.mpr ?_ x hx
  rintro _ ⟨a, ha, n, rfl⟩
  rw [← Function.iterate_succ_apply' (delta p)]
  exact iterate_delta_mem_deltaStabilization ha (n + 1)

/-- The `δ`-stabilization of `I` lies in an ideal `J` if and only if every iterate of `δ` maps
`I` into `J`. -/
theorem deltaStabilization_le_iff_forall_iterate :
    deltaStabilization p I ≤ J ↔ ∀ a ∈ I, ∀ n : ℕ, (delta p)^[n] a ∈ J := by
  refine ⟨fun h a ha n => h (iterate_delta_mem_deltaStabilization ha n), fun h =>
    Ideal.span_le.mpr ?_⟩
  rintro _ ⟨a, ha, n, rfl⟩
  exact h a ha n

/-- The `δ`-stabilization of `I` is the smallest ideal containing `I` that `δ` maps into
itself. -/
theorem deltaStabilization_le_iff (hJ : ∀ x ∈ J, delta p x ∈ J) :
    deltaStabilization p I ≤ J ↔ I ≤ J :=
  ⟨(le_deltaStabilization p I).trans, fun h => deltaStabilization_le_iff_forall_iterate.mpr
    fun _ ha n => Set.MapsTo.iterate (fun x hx => hJ x hx) n (h ha)⟩

/-- `δ`-stabilization is monotone. -/
@[gcongr]
theorem deltaStabilization_mono (h : I ≤ J) : deltaStabilization p I ≤ deltaStabilization p J :=
  (deltaStabilization_le_iff fun _ => delta_mem_deltaStabilization).mpr
    (h.trans (le_deltaStabilization p J))

/-- An ideal is its own `δ`-stabilization if and only if `δ` maps it into itself. -/
theorem deltaStabilization_eq_self_iff : deltaStabilization p I = I ↔ ∀ x ∈ I, delta p x ∈ I :=
  ⟨fun h => h ▸ fun _ => delta_mem_deltaStabilization, fun h =>
    le_antisymm ((deltaStabilization_le_iff h).mpr le_rfl) (le_deltaStabilization p I)⟩

/-- `δ`-stabilization is idempotent. -/
@[simp]
theorem deltaStabilization_deltaStabilization (I : Ideal A) :
    deltaStabilization p (deltaStabilization p I) = deltaStabilization p I :=
  deltaStabilization_eq_self_iff.mpr fun _ => delta_mem_deltaStabilization

variable (p A) in
/-- The `δ`-stabilization of the zero ideal is the zero ideal. -/
@[simp]
theorem deltaStabilization_bot : deltaStabilization p (⊥ : Ideal A) = ⊥ :=
  deltaStabilization_eq_self_iff.mpr fun x hx => by simp [(Submodule.mem_bot A).mp hx]

variable (p A) in
/-- The `δ`-stabilization of the unit ideal is the unit ideal. -/
@[simp]
theorem deltaStabilization_top : deltaStabilization p (⊤ : Ideal A) = ⊤ :=
  deltaStabilization_eq_self_iff.mpr fun _ _ => Submodule.mem_top

end DeltaStabilization

section Quotient

variable [DeltaRing p A] {I : Ideal A}

variable (I) in
/-- The `δ`-structure on `A ⧸ I` induced by `δ`, for an ideal `I` with `δ I ⊆ I` (Bhatt and
Scholze, *Prisms and prismatic cohomology*, Lemma 2.9). -/
@[instance_reducible]
def quotient (hI : ∀ x ∈ I, delta p x ∈ I) : DeltaRing p (A ⧸ I) where
  delta := Quotient.lift (fun a ↦ Ideal.Quotient.mk I (delta p a)) fun _ _ h ↦
    Ideal.Quotient.eq.mpr <| delta_sub_delta_mem hI <| Ideal.Quotient.eq.mp <| Quotient.sound h
  delta_zero := by
    rw [← map_zero (Ideal.Quotient.mk I)]
    exact congrArg (Ideal.Quotient.mk I) delta_zero
  delta_one := by
    rw [← map_one (Ideal.Quotient.mk I)]
    exact (congrArg (Ideal.Quotient.mk I) delta_one).trans (map_zero _)
  delta_add x y := by
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_add]
    exact (congrArg (Ideal.Quotient.mk I) (delta_add a b)).trans
      (by simp only [map_add, map_addCorrection]; rfl)
  delta_mul x y := by
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul]
    exact (congrArg (Ideal.Quotient.mk I) (delta_mul a b)).trans
      (by simp only [map_add, map_mul, map_pow, map_natCast]; rfl)

/-- The `δ`-operation of `quotient I hI` on the class of `x` is the class of `δ x`. -/
@[simp]
theorem delta_quotient_mk (hI : ∀ x ∈ I, delta p x ∈ I) (x : A) :
    @delta p (A ⧸ I) _ (quotient I hI) (Ideal.Quotient.mk I x) =
      Ideal.Quotient.mk I (delta p x) :=
  (rfl)

/-- The quotient map is a `δ`-map for `quotient I hI`. -/
theorem isDeltaMap_quotient_mk (hI : ∀ x ∈ I, delta p x ∈ I) :
    @IsDeltaMap p A _ (A ⧸ I) _ _ (quotient I hI) (Ideal.Quotient.mk I) :=
  letI := quotient I hI
  ⟨fun x => (delta_quotient_mk hI x).symm⟩

/-- The Frobenius of `quotient I hI` on the class of `x` is the class of `φ x`. -/
@[simp]
theorem frobenius_quotient_mk [Fact p.Prime] (hI : ∀ x ∈ I, delta p x ∈ I) (x : A) :
    @frobenius p (A ⧸ I) _ _ (quotient I hI) (Ideal.Quotient.mk I x) =
      Ideal.Quotient.mk I (frobenius p A x) := by
  let := quotient I hI
  rw [frobenius_apply, frobenius_apply, delta_quotient_mk, map_add, map_mul, map_pow,
    map_natCast]

/-- A `δ`-map `f : A →+* B` vanishing on `I` induces a `δ`-map `A ⧸ I →+* B` for
`quotient I hI`. -/
theorem isDeltaMap_quotient_lift {B : Type*} [CommRing B] [DeltaRing p B]
    (hI : ∀ x ∈ I, delta p x ∈ I) {f : A →+* B} (hf : IsDeltaMap p f) (hfI : ∀ a ∈ I, f a = 0) :
    @IsDeltaMap p (A ⧸ I) _ B _ (quotient I hI) _ (Ideal.Quotient.lift I f hfI) := by
  let := quotient I hI
  refine ⟨fun x => ?_⟩
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [delta_quotient_mk, Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk, hf.map_delta]

/-- A ring map `g` out of `A ⧸ I`, for an ideal `I` that `δ` maps into itself, is a `δ`-map for
`quotient I hI` if and only if its composite with the quotient map is a `δ`-map. -/
theorem isDeltaMap_comp_quotient_mk_iff {B : Type*} [CommRing B] [DeltaRing p B]
    (hI : ∀ x ∈ I, delta p x ∈ I) {g : A ⧸ I →+* B} :
    IsDeltaMap p (g.comp (Ideal.Quotient.mk I)) ↔
      @IsDeltaMap p (A ⧸ I) _ B _ (quotient I hI) _ g := by
  let := quotient I hI
  exact (isDeltaMap_quotient_mk hI).comp_iff_of_surjective Ideal.Quotient.mk_surjective

/-- If some `δ`-structure on `A ⧸ I` makes the quotient map a `δ`-map, then `δ` maps `I` into
`I`. -/
theorem delta_mem_of_isDeltaMap_quotient_mk {d : DeltaRing p (A ⧸ I)}
    (h : @IsDeltaMap p A _ (A ⧸ I) _ _ d (Ideal.Quotient.mk I)) {x : A} (hx : x ∈ I) :
    delta p x ∈ I := by
  rw [← Ideal.Quotient.eq_zero_iff_mem, h.map_delta, Ideal.Quotient.eq_zero_iff_mem.mpr hx,
    @delta_zero p _ _ d]

variable (I) in
/-- There is a unique `δ`-structure on `A ⧸ I` for which the quotient map is a `δ`-map if and only
if `δ` maps `I` into `I` (Bhatt and Scholze, *Prisms and prismatic cohomology*, Lemma 2.9). -/
theorem existsUnique_isDeltaMap_quotient_mk_iff :
    (∃! d : DeltaRing p (A ⧸ I), @IsDeltaMap p A _ (A ⧸ I) _ _ d (Ideal.Quotient.mk I)) ↔
      ∀ x ∈ I, delta p x ∈ I := by
  refine ⟨fun ⟨d, hd, _⟩ _ hx => delta_mem_of_isDeltaMap_quotient_mk hd hx, fun hI =>
    ⟨quotient I hI, isDeltaMap_quotient_mk hI, fun d hd =>
      eq_of_isDeltaMap_of_surjective Ideal.Quotient.mk_surjective hd (isDeltaMap_quotient_mk hI)⟩⟩

end Quotient

section UniversalQuotient

variable [DeltaRing p A] (I : Ideal A)

/-- The universal `δ`-ring under `A` in which `I` vanishes: the quotient of `A` by the
`δ`-stabilization of `I`, with its quotient `δ`-structure, so `δ` sends the class of `a` to the
class of `δ a` (`delta_mk_deltaStabilization`). Its universal property is
`deltaStabilizationLiftEquiv`. -/
instance instDeltaRingQuotientDeltaStabilization : DeltaRing p (A ⧸ deltaStabilization p I) :=
  quotient _ fun _ => delta_mem_deltaStabilization

/-- The quotient map `A → A ⧸ deltaStabilization p I` is a `δ`-map. -/
theorem isDeltaMap_mk_deltaStabilization :
    IsDeltaMap p (Ideal.Quotient.mk (deltaStabilization p I)) :=
  isDeltaMap_quotient_mk fun _ => delta_mem_deltaStabilization

/-- `δ` on `A ⧸ deltaStabilization p I` sends the class of `a` to the class of `δ a`. It is not a
`simp` lemma, since `simp` already rewrites its left-hand side with `delta_quotient_mk`. -/
theorem delta_mk_deltaStabilization (a : A) :
    delta p (Ideal.Quotient.mk (deltaStabilization p I) a) =
      Ideal.Quotient.mk (deltaStabilization p I) (delta p a) :=
  delta_quotient_mk (fun _ => delta_mem_deltaStabilization) a

variable {I} in
/-- The quotient map `A → A ⧸ deltaStabilization p I` sends every element of `I` to zero. -/
@[simp]
theorem mk_deltaStabilization_eq_zero {a : A} (ha : a ∈ I) :
    Ideal.Quotient.mk (deltaStabilization p I) a = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (le_deltaStabilization p I ha)

/-- The `δ`-structure on `A ⧸ deltaStabilization p I` is the only one making the quotient map a
`δ`-map. -/
theorem eq_instDeltaRingQuotientDeltaStabilization (d : DeltaRing p (A ⧸ deltaStabilization p I))
    (hd : @IsDeltaMap p A _ _ _ _ d (Ideal.Quotient.mk (deltaStabilization p I))) :
    d = instDeltaRingQuotientDeltaStabilization I :=
  eq_of_isDeltaMap_of_surjective Ideal.Quotient.mk_surjective hd
    (isDeltaMap_mk_deltaStabilization I)

variable (B : Type*) [CommRing B] [DeltaRing p B]

/-- The universal property of `A ⧸ deltaStabilization p I`: `δ`-maps out of it correspond, by
composition with the quotient map, to `δ`-maps `f : A → B` whose kernel contains `I`. -/
def deltaStabilizationLiftEquiv :
    {g : A ⧸ deltaStabilization p I →+* B // IsDeltaMap p g} ≃
      {f : A →+* B // IsDeltaMap p f ∧ I ≤ RingHom.ker f} where
  toFun g := ⟨g.val.comp (Ideal.Quotient.mk _),
    g.property.comp (isDeltaMap_mk_deltaStabilization I), fun a ha => by
      rw [RingHom.mem_ker, RingHom.comp_apply, mk_deltaStabilization_eq_zero ha, map_zero]⟩
  invFun f := ⟨Ideal.Quotient.lift _ f.val fun _ ha =>
      (deltaStabilization_le_iff f.property.1.delta_mem_ker).mpr f.property.2 ha,
    isDeltaMap_quotient_lift _ f.property.1 _⟩
  left_inv g := Subtype.ext <| Ideal.Quotient.ringHom_ext <| Ideal.Quotient.lift_comp_mk _ _ _
  right_inv f := Subtype.ext <| Ideal.Quotient.lift_comp_mk _ _ _

/-- The `δ`-map `A → B` attached to a `δ`-map `g` out of `A ⧸ deltaStabilization p I` is its
composite with the quotient map. -/
@[simp]
theorem coe_deltaStabilizationLiftEquiv_apply
    (g : {g : A ⧸ deltaStabilization p I →+* B // IsDeltaMap p g}) :
    (deltaStabilizationLiftEquiv I B g : A →+* B) =
      g.val.comp (Ideal.Quotient.mk (deltaStabilization p I)) :=
  (rfl)

/-- The `δ`-map out of `A ⧸ deltaStabilization p I` attached to `f` sends the class of `a` to
`f a`. -/
@[simp]
theorem deltaStabilizationLiftEquiv_symm_apply_mk
    (f : {f : A →+* B // IsDeltaMap p f ∧ I ≤ RingHom.ker f}) (a : A) :
    ((deltaStabilizationLiftEquiv I B).symm f : A ⧸ deltaStabilization p I →+* B)
      (Ideal.Quotient.mk (deltaStabilization p I) a) = f.val a :=
  (rfl)

end UniversalQuotient

