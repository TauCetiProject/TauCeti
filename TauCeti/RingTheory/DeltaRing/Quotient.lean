public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import TauCeti.RingTheory.DeltaRing.Basic

/-!
# `δ`-stable ideals and quotients of `δ`-rings

An ideal `I` of a `δ`-ring `A` is `δ`-stable if `δ x ∈ I` for every `x ∈ I`. Since
`δ (x + y) = δ x + δ y + addCorrection p x y` and the correction term lies in `I` as soon as `x`
does, `δ` then respects congruence modulo `I`, and the quotient `A ⧸ I` carries a unique
`δ`-structure for which the quotient map is a `δ`-map. Conversely the kernel of any `δ`-map is
`δ`-stable, so `I` is `δ`-stable exactly when such a structure on `A ⧸ I` exists. No hypothesis on
`p` or on the torsion of `A` is needed.

An ideal generated by a set `S` is `δ`-stable as soon as `δ s` lies in it for each generator `s`.
Hence the ideal `deltaStabilization p I` generated by all iterates `δ^[n] a` with `a ∈ I` is the
smallest `δ`-stable ideal containing `I`. The quotient `A ⧸ deltaStabilization p I` is the
universal `δ`-ring under `A` in which `I` vanishes: `δ`-maps out of it correspond to `δ`-maps out
of `A` whose kernel contains `I`. This is how `δ`-rings are presented by generators and relations,
for instance in the construction of prismatic envelopes.

## Main definitions

* `TauCeti.DeltaRing.IsDeltaStable`: the ideals `I` with `δ I ⊆ I`.
* `TauCeti.DeltaRing.deltaStabilization`: the ideal generated by all `δ^[n] a` with `a ∈ I`.
* `TauCeti.DeltaRing.quotient`: the `δ`-structure on `A ⧸ I` for a `δ`-stable ideal `I`.
* `TauCeti.DeltaRing.instDeltaRingQuotientDeltaStabilization`: the `δ`-structure on the universal
  `δ`-quotient `A ⧸ deltaStabilization p I`.
* `TauCeti.DeltaRing.deltaStabilizationLiftEquiv`: its universal property.

## Main results

* `TauCeti.DeltaRing.isDeltaStable_span_iff`: an ideal is `δ`-stable once `δ` maps its
  generators into it.
* `TauCeti.DeltaRing.IsDeltaMap.isDeltaStable_ker`: kernels of `δ`-maps are `δ`-stable.
* `TauCeti.DeltaRing.deltaStabilization_le_iff`: `deltaStabilization p I ≤ J` if and only if
  `I ≤ J`, for a `δ`-stable ideal `J`.
* `TauCeti.DeltaRing.isDeltaStable_iff_existsUnique`: `I` is `δ`-stable if and only if `A ⧸ I`
  has a unique `δ`-structure making the quotient map a `δ`-map.
* `TauCeti.DeltaRing.isDeltaMap_comp_quotient_mk_iff`: a ring map out of `A ⧸ I` is a `δ`-map if
  and only if its composite with the quotient map is.

## References

* B. Bhatt and P. Scholze, *Prisms and prismatic cohomology*, Ann. of Math. 196 (2022), §2.1,
  Lemma 2.9 and Example 2.10.
-/

public section

namespace TauCeti

namespace DeltaRing

variable {p : ℕ} {A : Type*} [CommRing A]

section IsDeltaStable

variable {B : Type*} [CommRing B] [DeltaRing p A] {I : Ideal A}

variable (p) in
/-- An ideal `I` of a `δ`-ring is `δ`-stable if `δ x ∈ I` for every `x ∈ I`. These are exactly the
ideals whose quotient inherits a `δ`-structure making the quotient map a `δ`-map
(`isDeltaStable_iff_existsUnique`). -/
structure IsDeltaStable (I : Ideal A) : Prop where
  /-- `δ` maps `I` into `I`. -/
  delta_mem {x : A} : x ∈ I → delta p x ∈ I

/-- The defining condition of `IsDeltaStable`. -/
theorem isDeltaStable_iff (I : Ideal A) : IsDeltaStable p I ↔ ∀ x ∈ I, delta p x ∈ I :=
  ⟨fun h _ hx => h.delta_mem hx, fun h => ⟨h _⟩⟩

variable (p A) in
/-- The zero ideal is `δ`-stable. -/
theorem isDeltaStable_bot : IsDeltaStable p (⊥ : Ideal A) :=
  ⟨fun hx => by simp [(Submodule.mem_bot A).mp hx]⟩

variable (p A) in
/-- The unit ideal is `δ`-stable. -/
theorem isDeltaStable_top : IsDeltaStable p (⊤ : Ideal A) :=
  ⟨fun _ => Submodule.mem_top⟩

/-- `δ` respects congruence modulo a `δ`-stable ideal. -/
theorem IsDeltaStable.delta_sub_delta_mem (hI : IsDeltaStable p I) {x y : A} (h : x - y ∈ I) :
    delta p x - delta p y ∈ I := by
  have e := delta_add (p := p) (x - y) y
  rw [sub_add_cancel] at e
  rw [e, add_right_comm, add_sub_cancel_right]
  exact add_mem (hI.delta_mem h) (addCorrection_mem_of_mem_left y h)

/-- A `δ`-stable ideal is stable under every iterate of `δ`. -/
theorem IsDeltaStable.iterate_delta_mem (hI : IsDeltaStable p I) {x : A} (hx : x ∈ I) (n : ℕ) :
    (delta p)^[n] x ∈ I := by
  induction n with
  | zero => exact hx
  | succ n ih =>
    rw [Function.iterate_succ_apply']
    exact hI.delta_mem ih

/-- The preimage of a `δ`-stable ideal under a `δ`-map is `δ`-stable. -/
theorem IsDeltaStable.comap [DeltaRing p B] {J : Ideal B} (hJ : IsDeltaStable p J)
    {f : A →+* B} (hf : IsDeltaMap p f) : IsDeltaStable p (J.comap f) :=
  ⟨fun {x} hx => by
    rw [Ideal.mem_comap, hf.map_delta]
    exact hJ.delta_mem hx⟩

/-- The kernel of a `δ`-map is `δ`-stable. -/
theorem IsDeltaMap.isDeltaStable_ker [DeltaRing p B] {f : A →+* B} (hf : IsDeltaMap p f) :
    IsDeltaStable p (RingHom.ker f) := by
  rw [RingHom.ker_eq_comap_bot]
  exact (isDeltaStable_bot p B).comap hf

/-- The ideal generated by a set `S` is `δ`-stable if and only if it contains `δ s` for every
`s ∈ S`. -/
theorem isDeltaStable_span_iff {S : Set A} :
    IsDeltaStable p (Ideal.span S) ↔ ∀ s ∈ S, delta p s ∈ Ideal.span S := by
  refine ⟨fun h s hs => h.delta_mem (Ideal.subset_span hs), fun h => ⟨fun {x} hx => ?_⟩⟩
  rcases eq_or_ne p 0 with rfl | hp
  · -- For `p = 0` the product rule applied to `x * 0` gives `δ x = 0`.
    rw [show delta 0 x = 0 by simpa using (delta_mul (p := 0) x 0).symm]
    exact zero_mem _
  induction hx using Submodule.span_induction with
  | mem s hs => exact h s hs
  | zero => simp
  | add x y hx _ hx' hy' =>
    rw [delta_add]
    exact add_mem (add_mem hx' hy') (addCorrection_mem_of_mem_left y hx)
  | smul a x hx hx' =>
    rw [smul_eq_mul, delta_mul]
    refine add_mem (add_mem (Ideal.mul_mem_left _ _ hx') ?_) (Ideal.mul_mem_left _ _ hx')
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hx p (Nat.pos_of_ne_zero hp))

end IsDeltaStable

section DeltaStabilization

variable [DeltaRing p A] {I J : Ideal A}

variable (p) in
/-- The `δ`-stabilization of an ideal `I`: the ideal generated by all iterates `δ^[n] a` with
`a ∈ I` and `n : ℕ`. It is the smallest `δ`-stable ideal containing `I`
(`isDeltaStable_deltaStabilization` and `deltaStabilization_le_iff`). -/
def deltaStabilization (I : Ideal A) : Ideal A :=
  Ideal.span {x | ∃ a ∈ I, ∃ n : ℕ, (delta p)^[n] a = x}

/-- The generators of `deltaStabilization p I`. -/
theorem deltaStabilization_def (I : Ideal A) :
    deltaStabilization p I = Ideal.span {x | ∃ a ∈ I, ∃ n : ℕ, (delta p)^[n] a = x} :=
  (rfl)

/-- Every iterate of `δ` maps `I` into `deltaStabilization p I`. -/
theorem iterate_delta_mem_deltaStabilization {a : A} (ha : a ∈ I) (n : ℕ) :
    (delta p)^[n] a ∈ deltaStabilization p I :=
  Ideal.subset_span ⟨a, ha, n, rfl⟩

variable (p) in
/-- `I ≤ deltaStabilization p I`. -/
theorem le_deltaStabilization (I : Ideal A) : I ≤ deltaStabilization p I :=
  fun _ ha => iterate_delta_mem_deltaStabilization ha 0

variable (p) in
/-- The `δ`-stabilization of an ideal is `δ`-stable. -/
theorem isDeltaStable_deltaStabilization (I : Ideal A) :
    IsDeltaStable p (deltaStabilization p I) := by
  refine isDeltaStable_span_iff.mpr ?_
  rintro _ ⟨a, ha, n, rfl⟩
  rw [← Function.iterate_succ_apply' (delta p)]
  exact iterate_delta_mem_deltaStabilization ha (n + 1)

/-- The `δ`-stabilization of `I` is the smallest `δ`-stable ideal containing `I`. -/
theorem deltaStabilization_le_iff (hJ : IsDeltaStable p J) :
    deltaStabilization p I ≤ J ↔ I ≤ J := by
  refine ⟨(le_deltaStabilization p I).trans, fun h => Ideal.span_le.mpr ?_⟩
  rintro _ ⟨a, ha, n, rfl⟩
  exact hJ.iterate_delta_mem (h ha) n

/-- `δ`-stabilization is monotone. -/
@[gcongr]
theorem deltaStabilization_mono (h : I ≤ J) : deltaStabilization p I ≤ deltaStabilization p J :=
  (deltaStabilization_le_iff (isDeltaStable_deltaStabilization p J)).mpr
    (h.trans (le_deltaStabilization p J))

/-- An ideal is its own `δ`-stabilization if and only if it is `δ`-stable. -/
theorem deltaStabilization_eq_self_iff : deltaStabilization p I = I ↔ IsDeltaStable p I :=
  ⟨fun h => h ▸ isDeltaStable_deltaStabilization p I, fun h =>
    le_antisymm ((deltaStabilization_le_iff h).mpr le_rfl) (le_deltaStabilization p I)⟩

/-- A `δ`-stable ideal is its own `δ`-stabilization. -/
alias ⟨_, IsDeltaStable.deltaStabilization_eq⟩ := deltaStabilization_eq_self_iff

/-- `δ`-stabilization is idempotent. -/
@[simp]
theorem deltaStabilization_deltaStabilization (I : Ideal A) :
    deltaStabilization p (deltaStabilization p I) = deltaStabilization p I :=
  (isDeltaStable_deltaStabilization p I).deltaStabilization_eq

variable (p A) in
/-- The `δ`-stabilization of the zero ideal is the zero ideal. -/
@[simp]
theorem deltaStabilization_bot : deltaStabilization p (⊥ : Ideal A) = ⊥ :=
  (isDeltaStable_bot p A).deltaStabilization_eq

variable (p A) in
/-- The `δ`-stabilization of the unit ideal is the unit ideal. -/
@[simp]
theorem deltaStabilization_top : deltaStabilization p (⊤ : Ideal A) = ⊤ :=
  (isDeltaStable_top p A).deltaStabilization_eq

end DeltaStabilization

section Quotient

variable {B : Type*} [CommRing B] [DeltaRing p A] {I : Ideal A}

/-- The function on `A ⧸ I` induced by `δ`, for a `δ`-stable ideal `I`. -/
private def quotientDeltaAux (hI : IsDeltaStable p I) : A ⧸ I → A ⧸ I :=
  Quotient.lift (fun a ↦ Ideal.Quotient.mk I (delta p a)) fun _ _ h ↦
    Ideal.Quotient.eq.mpr <| hI.delta_sub_delta_mem <| Ideal.Quotient.eq.mp <| Quotient.sound h

private theorem quotientDeltaAux_mk (hI : IsDeltaStable p I) (a : A) :
    quotientDeltaAux hI (Ideal.Quotient.mk I a) = Ideal.Quotient.mk I (delta p a) :=
  (rfl)

/-- The `δ`-structure on the quotient of a `δ`-ring by a `δ`-stable ideal `I`, with
`δ (mk I a) = mk I (δ a)` (`delta_quotient_mk`). It is the only `δ`-structure on `A ⧸ I` making
the quotient map a `δ`-map (`eq_quotient`). -/
@[instance_reducible]
def quotient (hI : IsDeltaStable p I) : DeltaRing p (A ⧸ I) where
  delta := quotientDeltaAux hI
  delta_zero := by rw [← map_zero (Ideal.Quotient.mk I), quotientDeltaAux_mk, delta_zero, map_zero]
  delta_one := by rw [← map_one (Ideal.Quotient.mk I), quotientDeltaAux_mk, delta_one, map_zero]
  delta_add x y := by
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_add (Ideal.Quotient.mk I) a b, quotientDeltaAux_mk, delta_add]
    simp only [quotientDeltaAux_mk, map_add, map_addCorrection]
  delta_mul x y := by
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul (Ideal.Quotient.mk I) a b, quotientDeltaAux_mk, delta_mul]
    simp only [quotientDeltaAux_mk, map_add, map_mul, map_pow, map_natCast]

/-- The quotient `δ`-structure sends the class of `a` to the class of `δ a`. -/
@[simp]
theorem delta_quotient_mk (hI : IsDeltaStable p I) (a : A) :
    (quotient hI).delta (Ideal.Quotient.mk I a) = Ideal.Quotient.mk I (delta p a) :=
  (rfl)

/-- The quotient map is a `δ`-map for the quotient `δ`-structure. -/
theorem isDeltaMap_quotient_mk (hI : IsDeltaStable p I) :
    letI := quotient hI; IsDeltaMap p (Ideal.Quotient.mk I) :=
  let := quotient hI
  ⟨fun a => (delta_quotient_mk hI a).symm⟩

/-- Every `δ`-structure on `A ⧸ I` making the quotient map a `δ`-map is the quotient
`δ`-structure. -/
theorem eq_quotient (hI : IsDeltaStable p I) (d : DeltaRing p (A ⧸ I))
    (hd : letI := d; IsDeltaMap p (Ideal.Quotient.mk I)) : d = quotient hI :=
  ext_of_surjective Ideal.Quotient.mk_surjective hd (isDeltaMap_quotient_mk hI)

/-- An ideal `I` of a `δ`-ring `A` is `δ`-stable if and only if `A ⧸ I` has a unique
`δ`-structure for which the quotient map is a `δ`-map (Bhatt and Scholze, *Prisms and prismatic
cohomology*, Lemma 2.9). -/
theorem isDeltaStable_iff_existsUnique :
    IsDeltaStable p I ↔
      ∃! d : DeltaRing p (A ⧸ I), letI := d; IsDeltaMap p (Ideal.Quotient.mk I) := by
  refine ⟨fun hI => ⟨quotient hI, isDeltaMap_quotient_mk hI, fun d hd => eq_quotient hI d hd⟩,
    fun ⟨d, hd, _⟩ => ?_⟩
  let := d
  rw [← Ideal.mk_ker (I := I)]
  exact IsDeltaMap.isDeltaStable_ker hd

/-- A ring map `g` out of the quotient by a `δ`-stable ideal is a `δ`-map if and only if its
composite with the quotient map is. -/
theorem isDeltaMap_comp_quotient_mk_iff [DeltaRing p B] (hI : IsDeltaStable p I)
    {g : A ⧸ I →+* B} :
    IsDeltaMap p (g.comp (Ideal.Quotient.mk I)) ↔ letI := quotient hI; IsDeltaMap p g := by
  let := quotient hI
  refine ⟨fun h => ⟨fun x => ?_⟩, fun h => h.comp (isDeltaMap_quotient_mk hI)⟩
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [delta_quotient_mk]
  exact h.map_delta a

/-- A `δ`-map vanishing on a `δ`-stable ideal `I` induces a `δ`-map out of `A ⧸ I`. -/
theorem isDeltaMap_quotient_lift [DeltaRing p B] (hI : IsDeltaStable p I) {f : A →+* B}
    (hf : IsDeltaMap p f) (hfI : ∀ a ∈ I, f a = 0) :
    letI := quotient hI; IsDeltaMap p (Ideal.Quotient.lift I f hfI) :=
  (isDeltaMap_comp_quotient_mk_iff hI).mp (by rwa [Ideal.Quotient.lift_comp_mk])

end Quotient

section UniversalQuotient

variable [DeltaRing p A] (I : Ideal A)

/-- The universal `δ`-ring under `A` in which `I` vanishes: the quotient of `A` by the
`δ`-stabilization of `I`, with its quotient `δ`-structure, so `δ` sends the class of `a` to the
class of `δ a` (`delta_quotient_mk`). Its universal property is `deltaStabilizationLiftEquiv`. -/
instance instDeltaRingQuotientDeltaStabilization : DeltaRing p (A ⧸ deltaStabilization p I) :=
  quotient (isDeltaStable_deltaStabilization p I)

/-- The quotient map `A → A ⧸ deltaStabilization p I` is a `δ`-map. -/
theorem isDeltaMap_mk_deltaStabilization :
    IsDeltaMap p (Ideal.Quotient.mk (deltaStabilization p I)) :=
  isDeltaMap_quotient_mk (isDeltaStable_deltaStabilization p I)

/-- The `δ`-structure on `A ⧸ deltaStabilization p I` is the only one making the quotient map a
`δ`-map. -/
theorem eq_instDeltaRingQuotientDeltaStabilization (d : DeltaRing p (A ⧸ deltaStabilization p I))
    (hd : letI := d; IsDeltaMap p (Ideal.Quotient.mk (deltaStabilization p I))) :
    d = instDeltaRingQuotientDeltaStabilization I :=
  eq_quotient (isDeltaStable_deltaStabilization p I) d hd

variable (B : Type*) [CommRing B] [DeltaRing p B]

/-- The universal property of `A ⧸ deltaStabilization p I`: `δ`-maps out of it correspond, by
composition with the quotient map, to `δ`-maps `f : A → B` whose kernel contains `I`. -/
def deltaStabilizationLiftEquiv :
    {g : A ⧸ deltaStabilization p I →+* B // IsDeltaMap p g} ≃
      {f : A →+* B // IsDeltaMap p f ∧ I ≤ RingHom.ker f} where
  toFun g := ⟨g.val.comp (Ideal.Quotient.mk _),
    g.property.comp (isDeltaMap_mk_deltaStabilization I), fun a ha => by
      rw [RingHom.mem_ker, RingHom.comp_apply,
        Ideal.Quotient.eq_zero_iff_mem.mpr (le_deltaStabilization p I ha), map_zero]⟩
  invFun f := ⟨Ideal.Quotient.lift _ f.val fun _ ha =>
      (deltaStabilization_le_iff f.property.1.isDeltaStable_ker).mpr f.property.2 ha,
    isDeltaMap_quotient_lift _ f.property.1 _⟩
  left_inv g := Subtype.ext <| Ideal.Quotient.ringHom_ext <| Ideal.Quotient.lift_comp_mk _ _ _
  right_inv f := Subtype.ext <| Ideal.Quotient.lift_comp_mk _ _ _

/-- The `δ`-map `A → B` attached to a `δ`-map `g` out of `A ⧸ deltaStabilization p I` is its
composite with the quotient map. -/
@[simp]
theorem coe_deltaStabilizationLiftEquiv_apply
    (g : {g : A ⧸ deltaStabilization p I →+* B // IsDeltaMap p g}) :
    (deltaStabilizationLiftEquiv I B g : A →+* B) =
      g.val.comp (Ideal.Quotient.mk (deltaStabilization p I)) :=
  (rfl)

/-- The `δ`-map out of `A ⧸ deltaStabilization p I` attached to `f` sends the class of `a` to
`f a`. -/
@[simp]
theorem deltaStabilizationLiftEquiv_symm_apply_mk
    (f : {f : A →+* B // IsDeltaMap p f ∧ I ≤ RingHom.ker f}) (a : A) :
    ((deltaStabilizationLiftEquiv I B).symm f : A ⧸ deltaStabilization p I →+* B)
      (Ideal.Quotient.mk (deltaStabilization p I) a) = f.val a :=
  (rfl)

end UniversalQuotient

