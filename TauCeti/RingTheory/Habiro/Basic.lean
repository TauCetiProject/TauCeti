import TauCeti.RingTheory.AdjoinRoot.Basic

/-!
# Cyclotomic index monoids, compatible quotient families, and finite quotients

For a commutative ring `R` and a set `S : Set ℕ` of root orders, the classical Habiro cyclotomic
completion `R[q]^S` is the inverse limit `lim←_{f ∈ Φ_S^*} R[q]/(f)`, where `Φ_S^*` is the
multiplicative submonoid of `R[q]` generated by the cyclotomic polynomials `Φ_n` for `n ∈ S`.
Because `Φ_S^*` consists of actual polynomials rather than formal exponent lists, coincident
cyclotomic polynomials (such as `Φ_1 = Φ_2` in characteristic two) automatically define the same
index, and order zero (`Φ_0 = 1`) leaves the indexing monoid unchanged.

This file defines the index monoid `TauCeti.Habiro.cycloIndex`, its canonical countable cofinal
chain `TauCeti.Habiro.cycloChain`, the subalgebra `TauCeti.Habiro.compatSubalgebra` of compatible
families in `∏ f : cycloIndex R S, AdjoinRoot f`, and the completion ring
`TauCeti.Habiro.CycloCompletion R S` together with its projections, canonical polynomial map, and
finite quotient structure. Every finite projection is surjective, multiplication by the image of
any index polynomial `f ∈ Φ_S^*` is injective on `R[q]^S` (without a domain assumption on `R`),
the kernel of projection modulo `f` is the principal ideal `(f)`, and the resulting quotient
`R[q]^S / (f)` is canonically isomorphic to `R[q]/(f)` compatibly with divisibility reductions.

## Main definitions

* `TauCeti.Habiro.cycloIndex`: the submonoid `Φ_S^*` of `R[X]` generated by `Φ_n` for `n ∈ S`.
* `TauCeti.Habiro.cycloChain`: the canonical countable cofinal chain
  `g_N = ∏_{n ∈ S, 1 ≤ n ≤ N} Φ_n ^ N` inside `cycloIndex R S`.
* `TauCeti.Habiro.compatSubalgebra`: the `R`-subalgebra of compatible families in
  `∀ f : cycloIndex R S, AdjoinRoot (f : R[X])`.
* `TauCeti.Habiro.CycloCompletion`: the classical cyclotomic completion `R[q]^S`, opaque over
  `compatSubalgebra R S`.
* `TauCeti.Habiro.CycloCompletion.proj`: the projection `R[q]^S →ₐ[R] AdjoinRoot f` at `f ∈ Φ_S^*`.
* `TauCeti.Habiro.CycloCompletion.fromPoly`: the canonical polynomial map `R[X] →ₐ[R] R[q]^S`.
* `TauCeti.Habiro.CycloCompletion.toPi`: the canonical `R`-algebra embedding of `R[q]^S` into the
  product `∀ f : cycloIndex R S, AdjoinRoot (f : R[X])`.
* `TauCeti.Habiro.CycloCompletion.quotientSpanEquiv`: the canonical `R`-algebra isomorphism
  `R[q]^S ⧸ (f) ≃ₐ[R] AdjoinRoot f` for each `f ∈ Φ_S^*`.

## Main results

* `TauCeti.Habiro.monic_of_mem_cycloIndex`: every element of `cycloIndex R S` is monic.
* `TauCeti.Habiro.exists_dvd_cycloChain` and `TauCeti.Habiro.exists_dvd_prod_cyclotomic_pow`:
  cofinality of `cycloChain R S` in general and of powers of `∏_{n ∈ U} Φ_n` for finite order sets.
* `TauCeti.Habiro.CycloCompletion.proj_surjective`: every finite projection is surjective.
* `TauCeti.Habiro.CycloCompletion.fromPoly_injective_iff`: `fromPoly R S` is injective iff `S`
  contains a positive order or `R` is subsingleton.
* `TauCeti.Habiro.CycloCompletion.not_isUnit_fromPoly_cyclotomic`: over a nontrivial ring, the
  image of `Φ_n` for positive `n ∈ S` is not a unit.
* `TauCeti.Habiro.CycloCompletion.isRegular_fromPoly`: multiplication by `fromPoly R S f` is
  injective on `R[q]^S` for every `f ∈ Φ_S^*`, over any commutative ring `R`.
* `TauCeti.Habiro.CycloCompletion.ker_proj_eq_span`: `ker (proj R S f) = Ideal.span {fromPoly f}`.
* `TauCeti.Habiro.CycloCompletion.exists_eq_fromPoly_add_mul`: every `h : R[q]^S` decomposes as
  `fromPoly R S b + fromPoly R S f * c`.
* `TauCeti.Habiro.CycloCompletion.algHomOfDvd_quotientSpanEquiv`: `quotientSpanEquiv` commutes with
  reduction along divisibility `f ∣ g`.

## References

* K. Habiro, *Cyclotomic completions of polynomial rings*, Publ. RIMS **40** (2004), 1127–1146,
  §§1, 3.1, 4, and proof of Theorem 6.1.
-/

public noncomputable section

open Polynomial

namespace TauCeti.Habiro

/-! ### The cyclotomic index monoid -/

section CycloIndex

variable (R : Type*) [CommRing R]

/-- The multiplicative submonoid `Φ_S^*` of `R[X]` generated by the cyclotomic polynomials
`Polynomial.cyclotomic n R` for `n ∈ S`. -/
def cycloIndex (S : Set ℕ) : Submonoid R[X] :=
  Submonoid.closure ((fun n => cyclotomic n R) '' S)

/-- Characterization of `cycloIndex R S` as the submonoid closure of `{Φ_n | n ∈ S}`. -/
theorem cycloIndex_eq_closure (S : Set ℕ) :
    cycloIndex R S = Submonoid.closure ((fun n => cyclotomic n R) '' S) :=
  (rfl)

variable {R}

/-- Each cyclotomic polynomial `Φ_n` with `n ∈ S` belongs to `cycloIndex R S`. -/
theorem cyclotomic_mem_cycloIndex {S : Set ℕ} {n : ℕ} (hn : n ∈ S) :
    cyclotomic n R ∈ cycloIndex R S :=
  Submonoid.subset_closure (Set.mem_image_of_mem _ hn)

/-- Induction principle for membership in `cycloIndex R S`. -/
@[elab_as_elim]
theorem cycloIndex_induction {S : Set ℕ} {p : R[X] → Prop}
    (cyclotomic : ∀ n ∈ S, p (cyclotomic n R)) (one : p 1)
    (mul : ∀ a b, a ∈ cycloIndex R S → b ∈ cycloIndex R S → p a → p b → p (a * b))
    {f : R[X]} (hf : f ∈ cycloIndex R S) : p f := by
  refine Submonoid.closure_induction ?_ one mul hf
  rintro _ ⟨n, hn, rfl⟩
  exact cyclotomic n hn

/-- Every polynomial in `cycloIndex R S` is monic. -/
theorem monic_of_mem_cycloIndex {S : Set ℕ} {f : R[X]} (hf : f ∈ cycloIndex R S) :
    f.Monic :=
  cycloIndex_induction (fun n _ => cyclotomic.monic n R) monic_one
    (fun _ _ _ _ ha hb => ha.mul hb) hf

/-- The index monoid is monotone in the set of root orders. -/
theorem cycloIndex_mono {S T : Set ℕ} (hST : S ⊆ T) :
    cycloIndex R S ≤ cycloIndex R T :=
  Submonoid.closure_mono (Set.image_mono hST)

variable (R)

/-- Including order `0` does not change `cycloIndex R S`, since `Φ_0 = 1`. -/
@[simp]
theorem cycloIndex_insert_zero (S : Set ℕ) :
    cycloIndex R (insert 0 S) = cycloIndex R S := by
  refine le_antisymm ?_ (cycloIndex_mono (Set.subset_insert 0 S))
  rw [cycloIndex, Submonoid.closure_le]
  rintro _ ⟨n, rfl | hn, rfl⟩
  · simp [cyclotomic_zero]
  · exact cyclotomic_mem_cycloIndex hn

/-- Removing order `0` does not change `cycloIndex R S`, since `Φ_0 = 1`. -/
@[simp]
theorem cycloIndex_sdiff_zero (S : Set ℕ) :
    cycloIndex R (S \ {0}) = cycloIndex R S := by
  by_cases h0 : (0 : ℕ) ∈ S
  · rw [← cycloIndex_insert_zero R (S \ {0}), Set.insert_sdiff_singleton,
      Set.insert_eq_of_mem h0]
  · rw [Set.sdiff_singleton_eq_self h0]

/-- The empty order set generates the trivial submonoid `{1}`. -/
@[simp]
theorem cycloIndex_empty : cycloIndex R ∅ = ⊥ := by
  simp [cycloIndex]

/-- An order set contained in `{0}` generates the trivial submonoid `{1}`. -/
theorem cycloIndex_eq_bot_of_subset_zero {S : Set ℕ} (hS : S ⊆ {0}) :
    cycloIndex R S = ⊥ := by
  rw [← cycloIndex_sdiff_zero, Set.sdiff_eq_empty.mpr hS, cycloIndex_empty]

/-- Over a nontrivial ring, `cycloIndex R S = ⊥` iff `S` contains no positive order. -/
theorem cycloIndex_eq_bot_iff [Nontrivial R] {S : Set ℕ} :
    cycloIndex R S = ⊥ ↔ S ⊆ {0} := by
  refine ⟨fun h n hn => ?_, cycloIndex_eq_bot_of_subset_zero R⟩
  by_contra hne
  have hpos : 0 < n := Nat.pos_of_ne_zero (Set.mem_singleton_iff.not.mp hne)
  have hmem : cyclotomic n R ∈ (⊥ : Submonoid R[X]) := h ▸ cyclotomic_mem_cycloIndex hn
  rw [Submonoid.mem_bot] at hmem
  have hdeg := degree_cyclotomic_pos n R hpos
  rw [hmem, degree_one] at hdeg
  exact lt_irrefl 0 hdeg

variable {R} in
/-- Transporting `cycloIndex R S` along a coefficient ring homomorphism yields `cycloIndex R' S`. -/
@[simp]
theorem map_cycloIndex {R' : Type*} [CommRing R'] (φ : R →+* R') (S : Set ℕ) :
    (cycloIndex R S).map (Polynomial.mapRingHom φ) = cycloIndex R' S := by
  simp only [cycloIndex, MonoidHom.map_mclosure, Set.image_image, Polynomial.coe_mapRingHom,
    Polynomial.map_cyclotomic]

variable {R} in
/-- Coefficient ring homomorphisms preserve membership in `cycloIndex`. -/
theorem map_mem_cycloIndex {R' : Type*} [CommRing R'] (φ : R →+* R') {S : Set ℕ}
    {f : R[X]} (hf : f ∈ cycloIndex R S) :
    f.map φ ∈ cycloIndex R' S := by
  rw [← map_cycloIndex φ S]
  exact ⟨f, hf, rfl⟩

/-- In characteristic two, `Φ_1 = Φ_2`, so `{1}` and `{2}` generate the same index monoid. -/
theorem cycloIndex_singleton_one_eq_two [CharP R 2] :
    cycloIndex R {1} = cycloIndex R {2} := by
  have h12 : cyclotomic 1 R = cyclotomic 2 R := by
    rw [cyclotomic_one, cyclotomic_two, sub_eq_add_neg, CharTwo.neg_eq]
  simp [cycloIndex, h12]

/-- The `N`-th element `∏_{n ∈ S, 1 ≤ n ≤ N} Φ_n ^ N` of the canonical countable cofinal chain
in `cycloIndex R S`. -/
def cycloChain (S : Set ℕ) (N : ℕ) : R[X] :=
  letI := Classical.decPred (· ∈ S)
  ∏ n ∈ (Finset.Icc 1 N).filter (· ∈ S), cyclotomic n R ^ N

/-- Explicit finite-product formula for `cycloChain R S N` with any decidability instance on
`· ∈ S`. -/
theorem cycloChain_eq_prod (S : Set ℕ) [DecidablePred (· ∈ S)] (N : ℕ) :
    cycloChain R S N = ∏ n ∈ (Finset.Icc 1 N).filter (· ∈ S), cyclotomic n R ^ N := by
  unfold cycloChain
  congr 1
  exact Finset.filter_congr_decidable _ _ _

/-- The `0`-th term of the canonical cofinal chain is `1`. -/
@[simp]
theorem cycloChain_zero (S : Set ℕ) : cycloChain R S 0 = 1 := by
  simp [cycloChain]

/-- Every term of the countable cofinal chain belongs to `cycloIndex R S`. -/
theorem cycloChain_mem (S : Set ℕ) (N : ℕ) : cycloChain R S N ∈ cycloIndex R S := by
  classical
  refine Submonoid.prod_mem _ fun n hn => ?_
  exact pow_mem (cyclotomic_mem_cycloIndex (Finset.mem_filter.mp hn).2) N

/-- For a positive order `n ∈ S` with `n ≤ N` and `k ≤ N`, `Φ_n ^ k` divides `cycloChain R S N`. -/
theorem cyclotomic_pow_dvd_cycloChain {S : Set ℕ} {n k N : ℕ} (hn : n ∈ S) (hpos : 0 < n)
    (hnN : n ≤ N) (hkN : k ≤ N) :
    cyclotomic n R ^ k ∣ cycloChain R S N := by
  classical
  rw [cycloChain_eq_prod]
  have hmem : n ∈ (Finset.Icc 1 N).filter (· ∈ S) :=
    Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hpos, hnN⟩, hn⟩
  exact (pow_dvd_pow _ hkN).trans (Finset.dvd_prod_of_mem _ hmem)

/-- The canonical cofinal chain is divisibility-monotone in its index. -/
theorem cycloChain_dvd_of_le (S : Set ℕ) {M N : ℕ} (hMN : M ≤ N) :
    cycloChain R S M ∣ cycloChain R S N := by
  classical
  have hsub : (Finset.Icc 1 M).filter (· ∈ S) ⊆ (Finset.Icc 1 N).filter (· ∈ S) :=
    Finset.filter_subset_filter _ (Finset.Icc_subset_Icc_right hMN)
  calc
    cycloChain R S M
      = ∏ n ∈ (Finset.Icc 1 M).filter (· ∈ S), cyclotomic n R ^ M := rfl
    _ ∣ ∏ n ∈ (Finset.Icc 1 M).filter (· ∈ S), cyclotomic n R ^ N :=
        Finset.prod_dvd_prod_of_dvd _ _ fun n _ => pow_dvd_pow _ hMN
    _ ∣ ∏ n ∈ (Finset.Icc 1 N).filter (· ∈ S), cyclotomic n R ^ N :=
        Finset.prod_dvd_prod_of_subset _ _ _ hsub

variable {R}

/-- Every element of `cycloIndex R S` divides some term of `cycloChain R S`. -/
theorem exists_dvd_cycloChain {S : Set ℕ} {f : R[X]} (hf : f ∈ cycloIndex R S) :
    ∃ N : ℕ, f ∣ cycloChain R S N := by
  classical
  refine cycloIndex_induction ?_ ⟨0, by simp⟩ ?_ hf
  · intro n hn
    rcases Nat.eq_zero_or_pos n with rfl | hpos
    · exact ⟨0, by simp [cyclotomic_zero]⟩
    · exact ⟨n, by simpa using cyclotomic_pow_dvd_cycloChain R hn hpos le_rfl hpos⟩
  · rintro a b - - ⟨M, hM⟩ ⟨N, hN⟩
    refine ⟨M + N, (mul_dvd_mul hM hN).trans ?_⟩
    have hsubM : (Finset.Icc 1 M).filter (· ∈ S) ⊆ (Finset.Icc 1 (M + N)).filter (· ∈ S) :=
      Finset.filter_subset_filter _ (Finset.Icc_subset_Icc_right (Nat.le_add_right M N))
    have hsubN : (Finset.Icc 1 N).filter (· ∈ S) ⊆ (Finset.Icc 1 (M + N)).filter (· ∈ S) :=
      Finset.filter_subset_filter _ (Finset.Icc_subset_Icc_right (Nat.le_add_left N M))
    have hmul :
        (∏ n ∈ (Finset.Icc 1 (M + N)).filter (· ∈ S), cyclotomic n R ^ M) *
          (∏ n ∈ (Finset.Icc 1 (M + N)).filter (· ∈ S), cyclotomic n R ^ N) =
          cycloChain R S (M + N) := by
      rw [← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl fun n _ => ?_
      rw [← pow_add]
    rw [← hmul]
    exact mul_dvd_mul
      (Finset.prod_dvd_prod_of_subset _ _ _ hsubM)
      (Finset.prod_dvd_prod_of_subset _ _ _ hsubN)

/-- For a finite order set `U : Finset ℕ`, the powers of `∏ n ∈ U, Φ_n` are cofinal in
`cycloIndex R (U : Set ℕ)`. -/
theorem exists_dvd_prod_cyclotomic_pow {U : Finset ℕ} {f : R[X]}
    (hf : f ∈ cycloIndex R (U : Set ℕ)) :
    ∃ N : ℕ, f ∣ (∏ n ∈ U, cyclotomic n R) ^ N := by
  refine cycloIndex_induction ?_ ⟨0, by simp⟩ ?_ hf
  · intro n hn
    exact ⟨1, by simpa using Finset.dvd_prod_of_mem (fun k => cyclotomic k R) hn⟩
  · rintro a b - - ⟨M, hM⟩ ⟨N, hN⟩
    exact ⟨M + N, by rw [pow_add]; exact mul_dvd_mul hM hN⟩

end CycloIndex

/-! ### Compatible quotient families and the cyclotomic completion -/

section Definition

variable (R : Type*) [CommRing R] (S : Set ℕ)

/-- The `R`-subalgebra of compatible quotient families in
`∀ f : cycloIndex R S, AdjoinRoot (f : R[X])`, cut out by the divisibility transition maps
`AdjoinRoot.algHomOfDvd`. -/
def compatSubalgebra :
    Subalgebra R (∀ f : cycloIndex R S, AdjoinRoot (f : R[X])) where
  carrier := {x | ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
    AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (x g) = x f}
  zero_mem' := fun _ _ _ => map_zero _
  one_mem' := fun _ _ _ => map_one _
  add_mem' := fun hx hy f g h => by simp only [Pi.add_apply, map_add, hx f g h, hy f g h]
  mul_mem' := fun hx hy f g h => by simp only [Pi.mul_apply, map_mul, hx f g h, hy f g h]
  algebraMap_mem' := fun r f g h => (AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h).commutes r

variable {R S} in
/-- Membership in `compatSubalgebra R S` is compatibility with all divisibility transitions. -/
@[simp]
theorem mem_compatSubalgebra_iff {x : ∀ f : cycloIndex R S, AdjoinRoot (f : R[X])} :
    x ∈ compatSubalgebra R S ↔
      ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
        AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (x g) = x f :=
  (Iff.rfl)

/-- The classical Habiro cyclotomic completion `R[q]^S = lim←_{f ∈ Φ_S^*} R[q]/(f)`, realized as
the subalgebra of compatible families in `∏ f : cycloIndex R S, AdjoinRoot f`. -/
def CycloCompletion : Type _ :=
  ↥(compatSubalgebra R S)

namespace CycloCompletion

instance instCommRing : CommRing (CycloCompletion R S) :=
  inferInstanceAs (CommRing (compatSubalgebra R S))

instance instAlgebra : Algebra R (CycloCompletion R S) :=
  inferInstanceAs (Algebra R (compatSubalgebra R S))

/-- Construct an element of `CycloCompletion R S` from a compatible family of residues. -/
def mk (val : ∀ f : cycloIndex R S, AdjoinRoot (f : R[X]))
    (compat : ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
      AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (val g) = val f) :
    CycloCompletion R S :=
  ⟨val, compat⟩

/-- The canonical projection `R[q]^S →ₐ[R] R[q]/(f)` at an index `f ∈ Φ_S^*`. -/
def proj (f : cycloIndex R S) : CycloCompletion R S →ₐ[R] AdjoinRoot (f : R[X]) :=
  (Pi.evalAlgHom R (fun g : cycloIndex R S => AdjoinRoot (g : R[X])) f).comp
    (compatSubalgebra R S).val

variable {R S}

/-- Evaluating a projection on an element constructed via `CycloCompletion.mk`. -/
@[simp]
theorem proj_mk (val : ∀ f : cycloIndex R S, AdjoinRoot (f : R[X]))
    (compat : ∀ (f g : cycloIndex R S) (h : (f : R[X]) ∣ g),
      AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (val g) = val f)
    (f : cycloIndex R S) :
    proj R S f (mk R S val compat) = val f :=
  (rfl)

/-- The projections of a completed element are compatible with divisibility transitions. -/
@[simp]
theorem map_proj {f g : cycloIndex R S} (h : (f : R[X]) ∣ g) (x : CycloCompletion R S) :
    AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h (proj R S g x) = proj R S f x :=
  x.2 f g h

/-- Composition of a projection with a divisibility transition equals the coarser projection. -/
@[simp]
theorem algHomOfDvd_comp_proj {f g : cycloIndex R S} (h : (f : R[X]) ∣ g) :
    (AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) h).comp (proj R S g) = proj R S f :=
  AlgHom.ext (map_proj h)

/-- Elements of `CycloCompletion R S` are equal iff all their finite projections agree. -/
@[ext]
theorem ext {x y : CycloCompletion R S} (h : ∀ f : cycloIndex R S, proj R S f x = proj R S f y) :
    x = y :=
  Subtype.ext (funext h)

/-- Reconstructing an element from its projections recovers the original element. -/
@[simp]
theorem mk_proj (x : CycloCompletion R S) :
    mk R S (fun f => proj R S f x) (fun _ _ h => map_proj h x) = x :=
  ext fun _ => rfl

variable (R S)

/-- The canonical `R`-algebra embedding of `CycloCompletion R S` into the product of finite
quotients. -/
def toPi : CycloCompletion R S →ₐ[R] (∀ f : cycloIndex R S, AdjoinRoot (f : R[X])) :=
  (compatSubalgebra R S).val

/-- The `f`-th coordinate of `toPi R S x` is `proj R S f x`. -/
@[simp]
theorem toPi_apply (x : CycloCompletion R S) (f : cycloIndex R S) :
    toPi R S x f = proj R S f x :=
  (rfl)

/-- The product embedding `toPi R S` is injective. -/
theorem toPi_injective : Function.Injective (toPi R S) :=
  Subtype.val_injective

/-- The range of `toPi R S` is the carrier of `compatSubalgebra R S`. -/
theorem range_toPi : Set.range (toPi R S) = (compatSubalgebra R S : Set _) :=
  Subtype.range_coe

/-- The canonical `R`-algebra map `R[X] →ₐ[R] CycloCompletion R S`. -/
def fromPoly : R[X] →ₐ[R] CycloCompletion R S where
  toFun p := mk R S (fun f => AdjoinRoot.mk (f : R[X]) p) fun f g h => by
    rw [AdjoinRoot.algHom_mk, AdjoinRoot.algHomOfDvd_root, AdjoinRoot.aeval_eq]
  map_one' := ext fun _ => by simp only [map_one, proj_mk]
  map_mul' _ _ := ext fun _ => by simp only [map_mul, proj_mk]
  map_zero' := ext fun _ => by simp only [map_zero, proj_mk]
  map_add' _ _ := ext fun _ => by simp only [map_add, proj_mk]
  commutes' _ := ext fun f => by
    rw [proj_mk, (proj R S f).commutes]
    exact (AdjoinRoot.mkₐ (f : R[X])).commutes _

/-- Projecting the image of a polynomial modulo `f` recovers `AdjoinRoot.mk f p`. -/
@[simp]
theorem proj_fromPoly (f : cycloIndex R S) (p : R[X]) :
    proj R S f (fromPoly R S p) = AdjoinRoot.mk (f : R[X]) p :=
  (rfl)

/-- Composing `proj R S f` with `fromPoly R S` is the canonical quotient map `AdjoinRoot.mkₐ`. -/
@[simp]
theorem proj_comp_fromPoly (f : cycloIndex R S) :
    (proj R S f).comp (fromPoly R S) = AdjoinRoot.mkₐ (f : R[X]) :=
  AlgHom.ext fun _ => rfl

/-- When `S ⊆ {0}`, the cyclotomic completion is the zero ring. -/
theorem subsingleton_of_subset_zero {S : Set ℕ} (hS : S ⊆ {0}) :
    Subsingleton (CycloCompletion R S) := by
  refine ⟨fun x y => ext fun f => ?_⟩
  have hf : (f : R[X]) = 1 :=
    Submonoid.mem_bot.mp ((cycloIndex_eq_bot_of_subset_zero R hS) ▸ f.2)
  have hsub : Subsingleton (AdjoinRoot (f : R[X])) := by
    refine subsingleton_of_zero_eq_one ?_
    rw [← map_one (AdjoinRoot.mk (f : R[X])), eq_comm, AdjoinRoot.mk_eq_zero, hf]
  exact Subsingleton.elim _ _

instance instSubsingletonEmpty : Subsingleton (CycloCompletion R ∅) :=
  subsingleton_of_subset_zero R (Set.empty_subset _)

/-- Every finite projection `R[q]^S → R[q]/(f)` is surjective. -/
theorem proj_surjective (f : cycloIndex R S) : Function.Surjective (proj R S f) := by
  intro y
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective y
  exact ⟨fromPoly R S p, proj_fromPoly R S f p⟩

/-- If `S` contains a positive order, the canonical polynomial map `fromPoly R S` is injective. -/
theorem fromPoly_injective {S : Set ℕ} (hS : ∃ n ∈ S, 0 < n) :
    Function.Injective (fromPoly R S) := by
  rcases subsingleton_or_nontrivial R with hsub | hnt
  · exact Function.injective_of_subsingleton _
  · obtain ⟨n, hn, hpos⟩ := hS
    refine (injective_iff_map_eq_zero (fromPoly R S)).mpr fun p hp => ?_
    by_contra hp0
    let k := p.natDegree + 1
    have hmem : cyclotomic n R ^ k ∈ cycloIndex R S :=
      pow_mem (cyclotomic_mem_cycloIndex hn) k
    have hmk : AdjoinRoot.mk (cyclotomic n R ^ k) p = 0 := by
      have := congrArg (proj R S ⟨cyclotomic n R ^ k, hmem⟩) hp
      rw [proj_fromPoly, map_zero] at this
      exact this
    have hdvd : cyclotomic n R ^ k ∣ p := AdjoinRoot.mk_eq_zero.mp hmk
    have hmonic : (cyclotomic n R ^ k).Monic := (cyclotomic.monic n R).pow k
    have hle : (cyclotomic n R ^ k).natDegree ≤ p.natDegree :=
      hmonic.natDegree_le_of_dvd hp0 hdvd
    rw [(cyclotomic.monic n R).natDegree_pow, natDegree_cyclotomic] at hle
    have htot : 1 ≤ n.totient := Nat.totient_pos.mpr hpos
    have hmul : k ≤ k * n.totient := Nat.le_mul_of_pos_right k htot
    omega

/-- The polynomial map `fromPoly R S` is injective iff `S` contains a positive order or `R` is
subsingleton. -/
theorem fromPoly_injective_iff (S : Set ℕ) :
    Function.Injective (fromPoly R S) ↔ (∃ n ∈ S, 0 < n) ∨ Subsingleton R := by
  constructor
  · intro hinj
    by_cases hpos : ∃ n ∈ S, 0 < n
    · exact Or.inl hpos
    · right
      have hsub0 : S ⊆ {0} := fun n hn => by
        by_contra hne
        exact hpos ⟨n, hn, Nat.pos_of_ne_zero (Set.mem_singleton_iff.not.mp hne)⟩
      have : Subsingleton (CycloCompletion R S) := subsingleton_of_subset_zero R hsub0
      have : Subsingleton R[X] := hinj.subsingleton
      exact Polynomial.C_injective.subsingleton
  · rintro (hpos | hsub)
    · exact fromPoly_injective R hpos
    · exact Function.injective_of_subsingleton _

/-- Over a nontrivial ring, the image of a positive-degree polynomial in `cycloIndex R S` is not
a unit in `CycloCompletion R S`. -/
theorem not_isUnit_fromPoly [Nontrivial R] (f : cycloIndex R S) (hdeg : 0 < (f : R[X]).natDegree) :
    ¬ IsUnit (fromPoly R S (f : R[X])) := by
  intro hu
  have hu0 : IsUnit (0 : AdjoinRoot (f : R[X])) := by
    simpa [AdjoinRoot.mk_self] using hu.map (proj R S f)
  have h10 : (1 : AdjoinRoot (f : R[X])) = 0 := (isUnit_zero_iff.mp hu0).symm
  rw [← map_one (AdjoinRoot.mk (f : R[X])), AdjoinRoot.mk_eq_zero] at h10
  have hle : (f : R[X]).natDegree ≤ (1 : R[X]).natDegree :=
    (monic_of_mem_cycloIndex f.2).natDegree_le_of_dvd one_ne_zero h10
  rw [natDegree_one] at hle
  omega

/-- Over a nontrivial ring, the image of `Φ_n` for a positive order `n ∈ S` is not a unit in
`CycloCompletion R S`. -/
theorem not_isUnit_fromPoly_cyclotomic [Nontrivial R] {n : ℕ} (hn : n ∈ S) (hpos : 0 < n) :
    ¬ IsUnit (fromPoly R S (cyclotomic n R)) := by
  refine not_isUnit_fromPoly R S ⟨cyclotomic n R, cyclotomic_mem_cycloIndex hn⟩ ?_
  rw [natDegree_cyclotomic]
  exact Nat.totient_pos.mpr hpos

/-! ### Finite quotient kernels and regularity -/

/-- Multiplication by `fromPoly R S f` is regular on `CycloCompletion R S` for every
`f : cycloIndex R S`, over any commutative ring `R`. -/
theorem isRegular_fromPoly (f : cycloIndex R S) : IsRegular (fromPoly R S (f : R[X])) := by
  have hleft : IsLeftRegular (fromPoly R S (f : R[X])) := by
    intro a b hab
    rw [← sub_eq_zero]
    have hz : fromPoly R S (f : R[X]) * (a - b) = 0 := by
      rw [mul_sub, sub_eq_zero]
      exact hab
    ext g
    rw [map_zero]
    obtain ⟨p, hp⟩ := AdjoinRoot.mk_surjective (proj R S (f * g) (a - b))
    have hfg : AdjoinRoot.mk ((f * g : cycloIndex R S) : R[X]) ((f : R[X]) * p) = 0 := by
      rw [map_mul, hp, ← proj_fromPoly R S (f * g) (f : R[X]), ← map_mul, hz, map_zero]
    obtain ⟨q, hq⟩ := AdjoinRoot.mk_eq_zero.mp hfg
    have hdvd : (g : R[X]) ∣ p :=
      ⟨q, (monic_of_mem_cycloIndex f.2).isRegular.left (by
        dsimp only
        rw [hq, Submonoid.coe_mul, mul_assoc])⟩
    have hred := map_proj (f := g) (g := f * g) (dvd_mul_left (g : R[X]) (f : R[X])) (a - b)
    rw [← hred, ← hp, AdjoinRoot.algHom_mk, AdjoinRoot.algHomOfDvd_root, AdjoinRoot.aeval_eq,
      AdjoinRoot.mk_eq_zero]
    exact hdvd
  exact ⟨hleft, fun a b hab => hleft (by simpa [mul_comm] using hab)⟩

/-- Multiplication by `fromPoly R S f` is injective on `CycloCompletion R S`. -/
theorem mul_fromPoly_injective (f : cycloIndex R S) :
    Function.Injective (fun x : CycloCompletion R S => fromPoly R S (f : R[X]) * x) :=
  (isRegular_fromPoly R S f).left

/-- The kernel of projection modulo `f` is the principal ideal generated by `fromPoly R S f`. -/
theorem ker_proj_eq_span (f : cycloIndex R S) :
    RingHom.ker (proj R S f).toRingHom = Ideal.span {fromPoly R S (f : R[X])} := by
  apply le_antisymm
  · intro h hh
    rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom] at hh
    rw [Ideal.mem_span_singleton]
    have hex : ∀ g : cycloIndex R S,
        ∃ q : R[X], AdjoinRoot.mk ((f * g : cycloIndex R S) : R[X]) ((f : R[X]) * q) =
          proj R S (f * g) h := by
      intro g
      obtain ⟨p, hp⟩ := AdjoinRoot.mk_surjective (proj R S (f * g) h)
      have hfp : AdjoinRoot.mk (f : R[X]) p = 0 := by
        have hred := map_proj (f := f) (g := f * g) (dvd_mul_right (f : R[X]) (g : R[X])) h
        rw [← hp, AdjoinRoot.algHom_mk, AdjoinRoot.algHomOfDvd_root, AdjoinRoot.aeval_eq, hh]
          at hred
        exact hred
      obtain ⟨q, rfl⟩ := AdjoinRoot.mk_eq_zero.mp hfp
      exact ⟨q, hp⟩
    let c : CycloCompletion R S :=
      mk R S (fun g => AdjoinRoot.mk (g : R[X]) (hex g).choose) fun g₁ g₂ hg => by
        rw [AdjoinRoot.algHom_mk, AdjoinRoot.algHomOfDvd_root, AdjoinRoot.aeval_eq,
          AdjoinRoot.mk_eq_mk]
        have hfg : ((f * g₁ : cycloIndex R S) : R[X]) ∣ ((f * g₂ : cycloIndex R S) : R[X]) :=
          mul_dvd_mul_left (f : R[X]) hg
        have hred := map_proj (f := f * g₁) (g := f * g₂) hfg h
        rw [← (hex g₂).choose_spec, ← (hex g₁).choose_spec, AdjoinRoot.algHom_mk,
          AdjoinRoot.algHomOfDvd_root, AdjoinRoot.aeval_eq, AdjoinRoot.mk_eq_mk, ← mul_sub] at hred
        obtain ⟨q, hq⟩ := hred
        exact ⟨q, (monic_of_mem_cycloIndex f.2).isRegular.left (by
          dsimp only
          rw [hq, Submonoid.coe_mul, mul_assoc])⟩
    refine ⟨c, ?_⟩
    ext g
    rw [map_mul, proj_fromPoly, proj_mk, ← map_mul]
    have hred := map_proj (f := g) (g := f * g) (dvd_mul_left (g : R[X]) (f : R[X])) h
    rw [← (hex g).choose_spec, AdjoinRoot.algHom_mk, AdjoinRoot.algHomOfDvd_root,
      AdjoinRoot.aeval_eq] at hred
    exact hred.symm
  · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, AlgHom.toRingHom_eq_coe,
      AlgHom.coe_toRingHom, proj_fromPoly, AdjoinRoot.mk_self]

/-- Every completed element decomposes as the image of a polynomial plus a multiple of `f`. -/
theorem exists_eq_fromPoly_add_mul (f : cycloIndex R S) (h : CycloCompletion R S) :
    ∃ (b : R[X]) (c : CycloCompletion R S), h = fromPoly R S b + fromPoly R S (f : R[X]) * c := by
  obtain ⟨b, hb⟩ := AdjoinRoot.mk_surjective (proj R S f h)
  have hker : h - fromPoly R S b ∈ RingHom.ker (proj R S f).toRingHom := by
    rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, map_sub, proj_fromPoly, hb,
      sub_self]
  rw [ker_proj_eq_span, Ideal.mem_span_singleton] at hker
  obtain ⟨c, hc⟩ := hker
  exact ⟨b, c, eq_add_of_sub_eq' hc⟩

/-- The canonical `R`-algebra isomorphism `CycloCompletion R S ⧸ (f) ≃ₐ[R] AdjoinRoot f`. -/
def quotientSpanEquiv (f : cycloIndex R S) :
    (CycloCompletion R S ⧸ Ideal.span {fromPoly R S (f : R[X])}) ≃ₐ[R] AdjoinRoot (f : R[X]) :=
  (Ideal.quotientEquivAlgOfEq R (ker_proj_eq_span R S f).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (proj_surjective R S f))

/-- `quotientSpanEquiv R S f` sends the quotient class of `x` to `proj R S f x`. -/
@[simp]
theorem quotientSpanEquiv_mk (f : cycloIndex R S) (x : CycloCompletion R S) :
    quotientSpanEquiv R S f (Ideal.Quotient.mk _ x) = proj R S f x :=
  (rfl)

/-- `quotientSpanEquiv R S f` sends the class of `fromPoly R S p` to `AdjoinRoot.mk f p`. -/
theorem quotientSpanEquiv_mk_fromPoly (f : cycloIndex R S) (p : R[X]) :
    quotientSpanEquiv R S f (Ideal.Quotient.mk _ (fromPoly R S p)) = AdjoinRoot.mk (f : R[X]) p :=
  (rfl)

/-- The inverse of `quotientSpanEquiv R S f` sends `AdjoinRoot.mk f p` to the class of
`fromPoly R S p`. -/
@[simp]
theorem quotientSpanEquiv_symm_mk (f : cycloIndex R S) (p : R[X]) :
    (quotientSpanEquiv R S f).symm (AdjoinRoot.mk (f : R[X]) p) =
      Ideal.Quotient.mk _ (fromPoly R S p) := by
  apply (quotientSpanEquiv R S f).injective
  rw [AlgEquiv.apply_symm_apply, quotientSpanEquiv_mk_fromPoly]

/-- Ideal inclusion for principal cyclotomic ideals induced by polynomial divisibility. -/
theorem span_fromPoly_le_of_dvd {f g : cycloIndex R S} (hfg : (f : R[X]) ∣ g) :
    Ideal.span {fromPoly R S (g : R[X])} ≤ Ideal.span {fromPoly R S (f : R[X])} := by
  rw [Ideal.span_singleton_le_span_singleton]
  exact map_dvd (fromPoly R S) hfg

/-- `quotientSpanEquiv` commutes with reduction to smaller divisors `f ∣ g`. -/
theorem algHomOfDvd_quotientSpanEquiv {f g : cycloIndex R S} (hfg : (f : R[X]) ∣ g)
    (q : CycloCompletion R S ⧸ Ideal.span {fromPoly R S (g : R[X])}) :
    AdjoinRoot.algHomOfDvd R (g : R[X]) (f : R[X]) hfg (quotientSpanEquiv R S g q) =
      quotientSpanEquiv R S f (Ideal.Quotient.factor (span_fromPoly_le_of_dvd R S hfg) q) := by
  refine Quotient.inductionOn' q fun x => ?_
  exact map_proj hfg x

end CycloCompletion

