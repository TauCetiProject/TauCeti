/-!
# The exceptional fibre of blowing up a node at its closed point

Let `A` be a local ring whose maximal ideal is generated by two elements `x, y` satisfying a
quadratic relation `a x² + b x y + y² = 0`, with `x` a nonzerodivisor and `𝔪` not principal. This
models the local ring at a node: by `TauCeti.exists_hypersurface_presentation_of_formallyUnramified`
the local ring there is `P ⧸ (f)` for a local ring `P` with two coordinates and `f` with
nondegenerate quadratic part `a s² + b s t + c t²`, and when `c` is a unit, dividing by `c` gives a
relation of the above shape. Let `A[𝔪/x]` be the affine blowup algebra of `𝔪` at `x`, the ring of
the chart `D₊(x)` of the blowup of `Spec A` at its closed point.

In `A[𝔪/x]` the fraction `w = y/x` satisfies `w² + b w + a = 0`, and `A[𝔪/x] = A + A w` is a
finite `A`-module. Its fibre over the closed point is therefore a quotient of
`κ[W] ⧸ (W² + b̄ W + ā)`, where `κ` is the residue field. It is the whole of it: if the fibre had
dimension at most one over `κ`, Nakayama's lemma would give `A[𝔪/x] = A`, so `y/x ∈ A` and
`𝔪 = (x)` would be principal. Hence

`κ ⊗[A] A[𝔪/x] ≃ κ[W] ⧸ (W² + b̄ W + ā)`,

a `κ`-algebra of dimension two, which is étale over `κ` when the discriminant `b² - 4a` is a unit.
Geometrically, `W` is the slope `y/x` of a tangent direction at the closed point, and the roots of
`W² + b̄ W + ā` are the slopes of the two lines of the tangent cone `a x² + b x y + y² = 0`, the
tangent directions of the two branches through the node. When `b² - 4a` is a unit they are
distinct, and rational over `κ` or conjugate over a separable quadratic extension of `κ`.

Since `y² = -x (a x + b y)` lies in `x 𝔪`, the chart `Spec A[𝔪/x]` is the whole blowup
(`TauCeti.AlgebraicGeometry.isIso_affineBlowupι_of_sq_mem`). Thus the inverse image of the closed
point in the blowup of `Spec A` at the closed point is finite étale of degree two over it.

## Main results

* `TauCeti.toSubmodule_affineBlowup_eq_span`: `A[𝔪/x]` is spanned over `A` by `1` and `y/x`.
* `TauCeti.finite_affineBlowup`: `A[𝔪/x]` is a finite `A`-module.
* `TauCeti.adjoinRootEquivTensorAffineBlowup`: the fibre `κ ⊗[A] A[𝔪/x]` is
  `κ[W] ⧸ (W² + b̄ W + ā)`, with `W` corresponding to `1 ⊗ y/x`.
* `TauCeti.finrank_tensor_affineBlowup`: this fibre has dimension two over `κ`.
* `TauCeti.etale_tensor_affineBlowup`: this fibre is étale over `κ` when `b² - 4a` is a unit.

## References

* [Stacks Project, Section 53.19, Tag 0C46](https://stacks.math.columbia.edu/tag/0C46): nodes of
  curves, defined by a nondegenerate quadratic form in two variables.
* [Stacks Project, Section 10.70, Tag 052P](https://stacks.math.columbia.edu/tag/052P): blowup
  algebras.
-/

public section

noncomputable section

open IsLocalRing Polynomial TensorProduct TauCeti.Localization

namespace TauCeti

variable {A : Type*} [CommRing A] {x y a b : A}
  (S : Type*) [CommRing S] [Algebra A S] [IsLocalization.Away x S]

/-- In the chart `A[𝔪/x]`, the relation `a x² + b x y + y² = 0` becomes the monic quadratic
relation `w² + b w + a = 0` for `w = y/x`. -/
theorem divBy_sq_add_mul_add_eq_zero (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0) :
    (divBy y x : S) ^ 2 + algebraMap A S b * divBy y x + algebraMap A S a = 0 := by
  have hu := (IsLocalization.Away.algebraMap_isUnit (S := S) x).pow 2
  refine hu.mul_left_cancel ?_
  have hxy := algebraMap_mul_divBy (S := S) y x
  have h := congr(algebraMap A S $hrel)
  simp only [map_add, map_mul, map_pow, map_zero] at h
  linear_combination (algebraMap A S x * divBy y x + algebraMap A S y +
    algebraMap A S b * algebraMap A S x) * hxy + h

variable {S} [IsLocalRing A]

private theorem mem_maximalIdeal_right (hm : maximalIdeal A = Ideal.span {x, y}) :
    y ∈ maximalIdeal A :=
  hm ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl)

/-- **The chart of the blowup is spanned by `1` and `y/x`.** If `𝔪 = (x, y)` and
`a x² + b x y + y² = 0`, the affine blowup algebra `A[𝔪/x]` is the `A`-submodule of the localization
spanned by `1` and `y/x`. -/
theorem toSubmodule_affineBlowup_eq_span (hm : maximalIdeal A = Ideal.span {x, y})
    (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0) :
    Subalgebra.toSubmodule ((maximalIdeal A).affineBlowup x S) =
      Submodule.span A {1, divBy y x} := by
  have hw := divBy_sq_add_mul_add_eq_zero S hrel
  -- The span of `1` and `w = y/x` is closed under multiplication, since `w² = -b w - a`.
  let M : Subalgebra A S := (Submodule.span A {1, (divBy y x : S)}).toSubalgebra
    (Submodule.subset_span (Set.mem_insert _ _)) fun u v hu hv ↦ by
      obtain ⟨p, q, rfl⟩ := Submodule.mem_span_pair.mp hu
      obtain ⟨p', q', rfl⟩ := Submodule.mem_span_pair.mp hv
      refine Submodule.mem_span_pair.mpr ⟨p * p' - q * q' * a, p * q' + q * p' - q * q' * b, ?_⟩
      simp only [Algebra.smul_def, map_sub, map_mul, map_add, mul_one]
      linear_combination -(algebraMap A S q * algebraMap A S q') * hw
  refine le_antisymm ?_ (Submodule.span_le.mpr ?_)
  · -- `A[𝔪/x]` is generated as an algebra by `x/x = 1` and `y/x`.
    have hB := Ideal.affineBlowup_eq_adjoin_of_span_eq (a := x) (S := S) hm.symm
    rw [Set.image_pair, divBy_self] at hB
    have hBM : (maximalIdeal A).affineBlowup x S ≤ M := by
      rw [hB, Algebra.adjoin_le_iff]
      exact Submodule.subset_span
    exact (Subalgebra.toSubmodule.le_iff_le.mpr hBM).trans_eq
      (Submodule.toSubalgebra_toSubmodule _ _ _)
  · rintro _ (rfl | rfl)
    · exact Subalgebra.one_mem _
    · exact Ideal.divBy_mem_affineBlowup (mem_maximalIdeal_right hm)

/-- **The chart of the blowup is finite.** If `𝔪 = (x, y)` and `a x² + b x y + y² = 0`, the affine
blowup algebra `A[𝔪/x]` is a finite `A`-module. -/
theorem finite_affineBlowup (hm : maximalIdeal A = Ideal.span {x, y})
    (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0) :
    Module.Finite A ((maximalIdeal A).affineBlowup x S) := by
  exact (Module.Finite.iff_fg (N := Subalgebra.toSubmodule
    ((maximalIdeal A).affineBlowup x S))).mpr
      (toSubmodule_affineBlowup_eq_span (S := S) hm hrel ▸ Submodule.fg_span (Set.toFinite _))

/-- The quadratic polynomial `W² + b̄ W + ā` over the residue field is monic. -/
private theorem monic_quadratic (a b : A) :
    (X ^ 2 + C (residue A b) * X + C (residue A a)).Monic := by
  monicity!

section Fiber

variable (hm : maximalIdeal A = Ideal.span {x, y}) (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0)
include hm hrel

omit hrel in
/-- The fraction `y/x` as an element of the affine blowup algebra `A[𝔪/x]`. -/
private def divByMem : (maximalIdeal A).affineBlowup x S :=
  ⟨divBy y x, Ideal.divBy_mem_affineBlowup (mem_maximalIdeal_right hm)⟩

/-- Every element of `A[𝔪/x]` is `p + q (y/x)` with `p, q ∈ A`. -/
private theorem exists_smul_add_smul_divByMem (u : (maximalIdeal A).affineBlowup x S) :
    ∃ p q : A, p • 1 + q • divByMem (S := S) hm = u := by
  have hu : (u : S) ∈ Subalgebra.toSubmodule ((maximalIdeal A).affineBlowup x S) := u.2
  rw [toSubmodule_affineBlowup_eq_span hm hrel] at hu
  obtain ⟨p, q, hpq⟩ := Submodule.mem_span_pair.mp hu
  exact ⟨p, q, Subtype.ext (by simpa [divByMem] using hpq)⟩

/-- The `κ`-algebra map `κ[W] ⧸ (W² + b̄ W + ā) → κ ⊗[A] A[𝔪/x]` sending `W` to `1 ⊗ y/x`. -/
private def fiberHom :
    AdjoinRoot (X ^ 2 + C (residue A b) * X + C (residue A a)) →ₐ[ResidueField A]
      ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId _ _) (1 ⊗ₜ divByMem hm) <| by
    have hw : divByMem (S := S) hm ^ 2 + algebraMap A _ b * divByMem hm +
        algebraMap A _ a = 0 :=
      Subtype.ext (by simpa [divByMem] using divBy_sq_add_mul_add_eq_zero S hrel)
    have key := congr(Algebra.TensorProduct.includeRight
      (R := A) (A := ResidueField A) $hw)
    simp only [map_add, map_mul, map_pow, AlgHom.commutes, map_zero,
      Algebra.TensorProduct.includeRight_apply] at key
    rw [← key]
    simp [← ResidueField.algebraMap_eq, ← IsScalarTower.algebraMap_apply]

private theorem fiberHom_root :
    fiberHom (S := S) hm hrel (AdjoinRoot.root _) = 1 ⊗ₜ divByMem hm :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

private theorem fiberHom_surjective : Function.Surjective (fiberHom (S := S) hm hrel) := by
  have := finite_affineBlowup (S := S) hm hrel
  have htop : Submodule.span A {1, divByMem (S := S) hm} = ⊤ :=
    eq_top_iff.mpr fun u _ ↦ by
      obtain ⟨p, q, rfl⟩ := exists_smul_add_smul_divByMem hm hrel u
      exact Submodule.mem_span_pair.mpr ⟨p, q, rfl⟩
  have hspan := (IsLocalRing.map_tensorProduct_mk_eq_top
    (N := Submodule.span A {1, divByMem (S := S) hm})).mpr htop
  rw [Submodule.map_span, Set.image_pair] at hspan
  intro z
  obtain ⟨p, q, rfl⟩ := Submodule.mem_span_pair.mp (hspan ▸ Submodule.mem_top (x := z))
  refine ⟨algebraMap A _ p + algebraMap A _ q * AdjoinRoot.root _, ?_⟩
  simp [fiberHom_root, TensorProduct.smul_tmul', Algebra.smul_def, ResidueField.algebraMap_eq]

/-- **The exceptional fibre of the chart has dimension two.** Let `𝔪 = (x, y)` be generated by a
nonzerodivisor `x` and an element `y` with `a x² + b x y + y² = 0`, and suppose that `𝔪` is not
principal. Then the fibre `κ ⊗[A] A[𝔪/x]` of the chart `A[𝔪/x]` of the blowup at the closed point
has dimension two over the residue field `κ`. -/
theorem finrank_tensor_affineBlowup (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) :
    Module.finrank (ResidueField A)
      (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S) = 2 := by
  have := finite_affineBlowup (S := S) hm hrel
  have hmon := monic_quadratic a b
  have : Module.Finite (ResidueField A) (AdjoinRoot
      (X ^ 2 + C (residue A b) * X + C (residue A a))) := hmon.finite_adjoinRoot
  refine le_antisymm ?_ ?_
  · -- `κ[W] ⧸ (W² + b̄ W + ā)` has dimension two and surjects onto the fibre.
    refine (LinearMap.finrank_le_finrank_of_surjective
      (f := (fiberHom (S := S) hm hrel).toLinearMap) (fiberHom_surjective hm hrel)).trans ?_
    rw [(AdjoinRoot.powerBasis' hmon).finrank, AdjoinRoot.powerBasis'_dim]
    compute_degree!
  · -- If the fibre had dimension at most one, it would be spanned by `1`, and by Nakayama's lemma
    -- so would `A[𝔪/x]`; then `y/x ∈ A` and `𝔪 = (x)` would be principal.
    by_contra! h
    have hone : Submodule.span (ResidueField A)
        {(1 : ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S)} = ⊤ := by
      rcases subsingleton_or_nontrivial (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S)
        with hs | hs
      · exact Subsingleton.elim _ _
      · refine Submodule.eq_top_of_finrank_eq ((finrank_span_singleton one_ne_zero).trans ?_)
        have := Module.finrank_pos (R := ResidueField A)
          (M := ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S)
        omega
    have hA : Submodule.span A {(1 : (maximalIdeal A).affineBlowup x S)} = ⊤ := by
      rw [← IsLocalRing.map_tensorProduct_mk_eq_top, Submodule.map_span, Set.image_singleton,
        ← Submodule.restrictScalars_span A (ResidueField A) Ideal.Quotient.mk_surjective]
      simpa [Algebra.TensorProduct.one_def] using hone
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp
      (hA ▸ Submodule.mem_top (x := divByMem (S := S) hm))
    have hr' : algebraMap A S r = divBy y x := by
      simpa [divByMem, Algebra.smul_def] using congr_arg Subtype.val hr
    have hyx : y = x * r := IsLocalization.injective S (Submonoid.powers_le.mpr hx) <| by
      rw [map_mul, hr', algebraMap_mul_divBy]
    refine hprin ⟨x, ?_⟩
    rw [hm, Set.pair_comm]
    exact Submodule.span_insert_eq_span (Ideal.mem_span_singleton'.mpr ⟨r, by rw [hyx, mul_comm]⟩)

/-- **The exceptional fibre of blowing up a node.** Let `𝔪 = (x, y)` be generated by a
nonzerodivisor `x` and an element `y` with `a x² + b x y + y² = 0`, and suppose that `𝔪` is not
principal. Then the fibre `κ ⊗[A] A[𝔪/x]` of the chart `A[𝔪/x]` of the blowup at the closed point
is `κ[W] ⧸ (W² + b̄ W + ā)`, with `W` corresponding to `1 ⊗ y/x`. -/
def adjoinRootEquivTensorAffineBlowup (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) :
    AdjoinRoot (X ^ 2 + C (residue A b) * X + C (residue A a)) ≃ₐ[ResidueField A]
      ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S :=
  have hmon := monic_quadratic a b
  have : Module.Free (ResidueField A) (AdjoinRoot
      (X ^ 2 + C (residue A b) * X + C (residue A a))) := hmon.free_adjoinRoot
  have : Module.Finite (ResidueField A) (AdjoinRoot
      (X ^ 2 + C (residue A b) * X + C (residue A a))) := hmon.finite_adjoinRoot
  have := finite_affineBlowup (S := S) hm hrel
  AlgEquiv.ofBijective (fiberHom hm hrel) <|
    OrzechProperty.bijective_of_surjective_of_finrank_le (fiberHom (S := S) hm hrel).toLinearMap
      (fiberHom_surjective hm hrel) <| by
        rw [finrank_tensor_affineBlowup hm hrel hx hprin, (AdjoinRoot.powerBasis' hmon).finrank,
          AdjoinRoot.powerBasis'_dim]
        compute_degree!

/-- The isomorphism `adjoinRootEquivTensorAffineBlowup` sends the root `W` to `1 ⊗ y/x`. -/
theorem adjoinRootEquivTensorAffineBlowup_root (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) {w : (maximalIdeal A).affineBlowup x S}
    (hw : (w : S) = divBy y x) :
    adjoinRootEquivTensorAffineBlowup (S := S) hm hrel hx hprin (AdjoinRoot.root _) = 1 ⊗ₜ w :=
  (fiberHom_root hm hrel).trans (congrArg _ (Subtype.ext hw.symm))

/-- **The exceptional fibre of blowing up a node is étale.** Let `𝔪 = (x, y)` with
`a x² + b x y + y² = 0`. If the discriminant `b² - 4a` is a unit, the fibre `κ ⊗[A] A[𝔪/x]` of the
chart `A[𝔪/x]` of the blowup at the closed point is étale over the residue field `κ`: it is a
quotient of the étale algebra `κ[W] ⧸ (W² + b̄ W + ā)`. -/
theorem etale_tensor_affineBlowup (hd : IsUnit (discrim a b 1)) :
    Algebra.Etale (ResidueField A) (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S) := by
  have hsep : (X ^ 2 + C (residue A b) * X + C (residue A a)).Separable := by
    have := separable_quadratic_of_isUnit_discrim (a := (1 : ResidueField A)) (b := residue A b)
      (c := residue A a) <| by
        convert hd.map (residue A) using 1
        simp only [discrim, map_sub, map_mul, map_pow, map_one, map_ofNat]
        ring
    simpa using this
  have := (monic_quadratic a b).isStandardEtale_adjoinRoot hsep
  have := finite_affineBlowup (S := S) hm hrel
  have : Algebra.FormallyUnramified (ResidueField A)
      (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S) :=
    .of_surjective (fiberHom hm hrel) (fiberHom_surjective hm hrel)
  have : Algebra.FormallyEtale (ResidueField A)
      (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S) :=
    .of_formallyUnramified_of_field _ _
  exact { finitePresentation := Algebra.FinitePresentation.of_finiteType.mp inferInstance }

end Fiber

end TauCeti
