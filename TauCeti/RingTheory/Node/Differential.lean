module

public import TauCeti.RingTheory.Node.Derivation
public import TauCeti.RingTheory.FittingIdeal.Basic

/-!
# Kähler differentials of the nodal equation

For `B = R[x,y]/(xy-a)`, the module of relative Kähler differentials is the quotient of
`B²` by the single relation `y dx + x dy`. This presentation describes the singularity
of the nodal equation in terms of a finite module and is the input to its first Fitting ideal.

## References

* Stacks Project, Section 10.131 (Differentials), Tag 00RM.
-/

public section

noncomputable section

namespace TauCeti.NodeAlgebra

open KaehlerDifferential

variable {R : Type*} [CommRing R] (a : R)

/-- The Jacobian relation vector `(y, x)` for the equation `xy = a`. -/
def differentialRelation : Fin 2 → NodeAlgebra R a := ![coord a 1, coord a 0]

/-- The module generated by `dx,dy` subject to `y dx + x dy = 0`. -/
abbrev PresentedDifferential :=
  (Fin 2 → NodeAlgebra R a) ⧸ (NodeAlgebra R a) ∙ differentialRelation a

private def differentialLinear :
    (Fin 2 → NodeAlgebra R a) →ₗ[NodeAlgebra R a] Ω[NodeAlgebra R a⁄R] where
  toFun u := u 0 • D R (NodeAlgebra R a) (coord a 0) + u 1 • D R (NodeAlgebra R a) (coord a 1)
  map_add' u v := by simp [add_smul, add_assoc, add_left_comm]
  map_smul' c u := by simp [smul_add, smul_smul]

private lemma differentialLinear_relation :
    differentialLinear a (differentialRelation a) = 0 := by
  simp [differentialLinear, differentialRelation]

/-- The canonical map from the Jacobian presentation to the Kähler differentials. -/
private def presentedToDifferential :
    PresentedDifferential a →ₗ[NodeAlgebra R a] Ω[NodeAlgebra R a⁄R] :=
  Submodule.liftQSpanSingleton (differentialRelation a) (differentialLinear a)
    (differentialLinear_relation a)

private def presentedBasis (i : Fin 2) : PresentedDifferential a :=
  Submodule.Quotient.mk (Pi.single i (1 : NodeAlgebra R a))

private lemma presentedBasis_relation :
    coord a 1 • presentedBasis a 0 + coord a 0 • presentedBasis a 1 = 0 := by
  have hvec : coord a 1 • Pi.single (0 : Fin 2) (1 : NodeAlgebra R a) +
      coord a 0 • Pi.single (1 : Fin 2) (1 : NodeAlgebra R a) =
        differentialRelation a := by
    funext i
    fin_cases i <;> simp [differentialRelation]
  calc
    _ = (Submodule.Quotient.mk
        (coord a 1 • Pi.single (0 : Fin 2) (1 : NodeAlgebra R a) +
          coord a 0 • Pi.single (1 : Fin 2) (1 : NodeAlgebra R a)) :
          PresentedDifferential a) := by simp [presentedBasis]
    _ = Submodule.Quotient.mk (differentialRelation a) := congrArg _ hvec
    _ = 0 := by rw [Submodule.Quotient.mk_eq_zero]; exact Submodule.mem_span_singleton_self _

private def presentedDerivation : Derivation R (NodeAlgebra R a) (PresentedDifferential a) :=
  (derivationEquivValues a).symm ⟨fun i ↦ presentedBasis a i,
    (mem_derivationValues_iff a _).2 (presentedBasis_relation a)⟩

/-- The universal map from Kähler differentials to the Jacobian presentation. -/
private def differentialToPresented : Ω[NodeAlgebra R a⁄R] →ₗ[NodeAlgebra R a]
    PresentedDifferential a :=
  (presentedDerivation a).liftKaehlerDifferential

@[simp]
private lemma presentedToDifferential_basis (i : Fin 2) :
    presentedToDifferential a (presentedBasis a i) =
      D R (NodeAlgebra R a) (coord a i) := by
  fin_cases i <;>
    simp [presentedToDifferential, presentedBasis, differentialLinear]

@[simp]
private lemma differentialToPresented_coord (i : Fin 2) :
    differentialToPresented a (D R (NodeAlgebra R a) (coord a i)) =
      presentedBasis a i := by
  simp [differentialToPresented, presentedDerivation]

private lemma presented_decompose (u : Fin 2 → NodeAlgebra R a) :
    (Submodule.Quotient.mk u : PresentedDifferential a) =
      u 0 • presentedBasis a 0 + u 1 • presentedBasis a 1 := by
  have hu : u = u 0 • Pi.single (0 : Fin 2) (1 : NodeAlgebra R a) +
      u 1 • Pi.single (1 : Fin 2) (1 : NodeAlgebra R a) := by
    funext i
    fin_cases i <;> simp
  conv_lhs => rw [hu]
  simp [presentedBasis]

/-- The Jacobian presentation of the relative Kähler differentials of `xy = a`. -/
def differentialEquivPresented : Ω[NodeAlgebra R a⁄R] ≃ₗ[NodeAlgebra R a]
    PresentedDifferential a := by
  refine LinearEquiv.ofLinearMap (differentialToPresented a) (presentedToDifferential a) ?_ ?_
  · apply LinearMap.ext
    intro z
    induction z using Submodule.Quotient.induction_on with
    | _ u =>
      rw [presented_decompose a u]
      simp [map_add, map_smul]
  · apply Derivation.liftKaehlerDifferential_unique
      ((presentedToDifferential a).comp (differentialToPresented a)) LinearMap.id
    apply derivation_ext a
    intro i
    simp [LinearMap.compDer]

/-- Under the presentation, the differential of a coordinate is its corresponding basis class. -/
@[simp]
theorem differentialEquivPresented_D_coord (i : Fin 2) :
    differentialEquivPresented a (D R (NodeAlgebra R a) (coord a i)) =
      Submodule.Quotient.mk (Pi.single i (1 : NodeAlgebra R a)) :=
  differentialToPresented_coord a i

/-- The inverse presentation map sends each basis class to the differential of its coordinate. -/
@[simp]
theorem differentialEquivPresented_symm_basis (i : Fin 2) :
    (differentialEquivPresented a).symm
        (Submodule.Quotient.mk (Pi.single i (1 : NodeAlgebra R a))) =
      D R (NodeAlgebra R a) (coord a i) :=
  presentedToDifferential_basis a i

/-- The first Fitting ideal of the nodal differentials is generated by the two coordinates. -/
@[simp]
theorem fittingIdeal_differential_one :
    fittingIdeal (NodeAlgebra R a) Ω[NodeAlgebra R a⁄R] 1 =
      Ideal.span {coord a 0, coord a 1} := by
  nontriviality (NodeAlgebra R a)
  rw [fittingIdeal_congr (differentialEquivPresented a) 1,
    fittingIdeal_eq_minorsIdeal_ker (Submodule.mkQ_surjective _),
    Submodule.ker_mkQ, Module.finrank_fin_fun]
  simp only [Nat.reduceSub]
  apply le_antisymm
  · apply Submodule.minorsIdeal_le_iff.mpr
    intro f v hv
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hv 0)
    rw [Matrix.det_fin_one, Matrix.of_apply, ← hc, map_smul]
    have hr : f 0 (differentialRelation a) =
        coord a 1 * f 0 (Pi.single 0 (1 : NodeAlgebra R a)) +
          coord a 0 * f 0 (Pi.single 1 (1 : NodeAlgebra R a)) := by
      have h : differentialRelation a =
          coord a 1 • Pi.single (0 : Fin 2) (1 : NodeAlgebra R a) +
            coord a 0 • Pi.single (1 : Fin 2) (1 : NodeAlgebra R a) := by
        funext i
        fin_cases i <;> simp [differentialRelation]
      rw [h]
      simp
    rw [hr]
    apply Ideal.mul_mem_left
    apply Ideal.add_mem
    · exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
    · exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  · apply Ideal.span_le.mpr
    rintro x (rfl | rfl)
    · simpa [differentialRelation, Matrix.det_fin_one] using
        (Submodule.det_mem_minorsIdeal (N := (NodeAlgebra R a) ∙ differentialRelation a)
          (p := 1) (fun _ ↦ LinearMap.proj 1)
          (v := fun _ ↦ differentialRelation a)
          (fun _ ↦ Submodule.mem_span_singleton_self _))
    · simpa [differentialRelation, Matrix.det_fin_one] using
        (Submodule.det_mem_minorsIdeal (N := (NodeAlgebra R a) ∙ differentialRelation a)
          (p := 1) (fun _ ↦ LinearMap.proj 0)
          (v := fun _ ↦ differentialRelation a)
          (fun _ ↦ Submodule.mem_span_singleton_self _))

end TauCeti.NodeAlgebra
