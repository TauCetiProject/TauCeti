module

public import TauCeti.RingTheory.Node.BaseChange
public import TauCeti.RingTheory.Node.JacobianLocus

/-!
# Base change of the Jacobian locus of a nodal chart

For the relative nodal equation `xy = a`, the first Fitting ideal of the module of
differentials is generated by the coordinates. Changing the coefficient ring therefore
identifies its scheme-theoretic Jacobian locus with that of the changed equation, even
when the base change is not flat. This is the affine calculation behind the base-change
property of the relative singular locus of a nodal family.

## Reference

* Stacks Project, Example 55.14.1, Tag 0CDC.
-/

public section

noncomputable section

namespace TauCeti.NodeAlgebra

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (a : R)

/-- Coefficient change carries the Jacobian ideal of `xy = a` onto the Jacobian ideal
of `xy = f(a)`. No flatness of the coefficient change is needed. -/
@[simp]
theorem map_jacobianIdeal :
    (jacobianIdeal a).map (map (S := S) a) =
      jacobianIdeal (algebraMap R S a) := by
  rw [jacobianIdeal_eq_span, jacobianIdeal_eq_span, Ideal.map_span]
  simp only [Set.image_insert_eq,
    Set.image_singleton, map_coord]

/-- The first Fitting ideal of the relative differentials of a nodal chart commutes
with arbitrary change of coefficients. -/
theorem map_fittingIdeal_differential_one :
    (fittingIdeal (NodeAlgebra R a) Ω[NodeAlgebra R a⁄R] 1).map (map (S := S) a) =
      fittingIdeal (NodeAlgebra S (algebraMap R S a))
        Ω[NodeAlgebra S (algebraMap R S a)⁄S] 1 := by
  rw [fittingIdeal_differential_one, fittingIdeal_differential_one]
  simpa only [jacobianIdeal_eq_span] using map_jacobianIdeal (S := S) a

end TauCeti.NodeAlgebra
