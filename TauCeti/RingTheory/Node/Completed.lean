/-!
# The completed node `R⟦X, Y⟧ ⧸ (XY - a)`

The algebra `CompletedNodeAlgebra R a = R⟦X, Y⟧ ⧸ (XY - a)` is the polynomial node
`TauCeti.NodeAlgebra R a = R[X, Y] ⧸ (XY - a)` completed in both variables. Over a discrete
valuation ring `R` with `a = p` or `a = π u`, it is the shape of local deformation rings of
nodal type, such as the unframed deformation ring `𝒪⟦T₁, T₂⟧ ⧸ (T₁T₂ - p)` of a weight-two
principal-series type.

We prove that over a discrete valuation ring `R` and for `a` a nonzero nonunit, this algebra is a
flat `R`-algebra and a domain. Completeness of `R` is not assumed. These properties are not
inherited formally from the polynomial node, since completion need not preserve being a domain.
For `R = ℤ_p` and `a = p` the ring is identified with a ring of two-sided series in
`TauCeti.AnnularRing.quotientEquiv`; the argument here works over every discrete valuation ring.

* When `a` lies in `𝔪_R` but not in `𝔪_R²`, for instance when `a` is a uniformizer, the element
  `XY - a` lies in the maximal ideal of the regular local ring `R⟦X, Y⟧` but not in its square, so
  the quotient is a regular local ring (`CompletedNodeAlgebra.isRegularLocalRing`), hence a
  domain. This holds over any regular local ring `R`.
* In general `a = u ϖ ^ e` for a uniformizer `ϖ`, a unit `u` and `e ≥ 1`. The substitution
  `X ↦ Sᵉ`, `Y ↦ u Tᵉ` sends `XY - a` to `u ((ST)ᵉ - ϖᵉ)`, a multiple of `ST - ϖ`, and so
  induces a map `R⟦X, Y⟧ ⧸ (XY - a) → R⟦S, T⟧ ⧸ (ST - ϖ)` into a regular local ring. Comparing
  coefficients along the diagonals of the exponent lattice shows that this map is injective,
  so `R⟦X, Y⟧ ⧸ (XY - a)` is a domain (`CompletedNodeAlgebra.isDomain`).
* Multiplication by a nonzero constant is injective on `R⟦X, Y⟧ ⧸ (XY - a)` whenever `a` is a
  nonunit, again by comparing coefficients. So the algebra is a torsion-free module
  (`CompletedNodeAlgebra.isTorsionFree`), hence flat over the Dedekind domain `R` by
  Mathlib's instance for torsion-free modules over Dedekind domains.

## Main definitions

* `TauCeti.CompletedNodeAlgebra R a`: the quotient `R⟦X, Y⟧ ⧸ (XY - a)`.

## Main results

* `TauCeti.CompletedNodeAlgebra.isRegularLocalRing`: over a regular local ring, for
  `a ∈ 𝔪_R \ 𝔪_R²`, the completed node is a regular local ring.
* `TauCeti.CompletedNodeAlgebra.isDomain`: over a discrete valuation ring, for a nonzero nonunit
  `a`, the completed node is a domain.
* `TauCeti.CompletedNodeAlgebra.isTorsionFree`: over a discrete valuation ring, the completed node
  is a torsion-free module for every `a`, so it is flat.

## References

* C. Khare, J.-P. Wintenberger, *Serre's modularity conjecture (II)*, Invent. Math. 178 (2009),
  §3.2.4, p. 24, for the rings `𝒪⟦T₁, T₂⟧ ⧸ (T₁T₂ - p)`.
-/

public section

noncomputable section

namespace TauCeti

open _root_.MvPowerSeries _root_.IsLocalRing

/-- The completed node `R⟦X, Y⟧ ⧸ (XY - a)`: the quotient of the power series ring in the two
variables `X 0` and `X 1` by the principal ideal generated by `X 0 * X 1 - a`. -/
abbrev CompletedNodeAlgebra (R : Type*) [CommRing R] (a : R) :=
  MvPowerSeries (Fin 2) R ⧸ Ideal.span {X 0 * X 1 - C a}

namespace CompletedNodeAlgebra

variable {R : Type*} [CommRing R]

/-- The exponent of the monomial `X 0 * X 1`. -/
private def diag : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1

@[simp]
private theorem diag_apply (i : Fin 2) : diag i = 1 := by
  fin_cases i <;> simp [diag]

private theorem diag_le_iff {n : Fin 2 →₀ ℕ} : diag ≤ n ↔ ∀ i, n i ≠ 0 := by
  simp [Finsupp.le_def, Nat.one_le_iff_ne_zero]

/-- The coefficients of a multiple of the nodal equation `X 0 * X 1 - a`. -/
private theorem coeff_nodeEquation_mul (a : R) (Q : MvPowerSeries (Fin 2) R)
    (n : Fin 2 →₀ ℕ) :
    coeff n ((X 0 * X 1 - C a) * Q) =
      (if diag ≤ n then coeff (n - diag) Q else 0) - a * coeff n Q := by
  rw [sub_mul, map_sub, X_def, X_def, monomial_mul_monomial, one_mul, ← diag,
    coeff_monomial_mul, one_mul, coeff_C_mul]

section TorsionFree

variable [IsDomain R]

/-- If `b` divides `a`, then multiplication by `b` is injective modulo `XY - a`: from
`b F = G (XY - a)` the coefficients of `G` along each diagonal are divisible by `b`. -/
private theorem mem_span_of_C_mul_mem_span {a b : R} (hb : b ≠ 0) (hba : b ∣ a)
    {F : MvPowerSeries (Fin 2) R} (hF : C b * F ∈ Ideal.span {X 0 * X 1 - C a}) :
    F ∈ Ideal.span {X 0 * X 1 - C a} := by
  obtain ⟨G, hG⟩ := Ideal.mem_span_singleton'.mp hF
  obtain ⟨c, rfl⟩ := hba
  obtain ⟨G', rfl⟩ : C b ∣ G := by
    refine (C_dvd_iff_dvd_coeff b G).mpr fun n ↦ ?_
    have h := congrArg (coeff (n + diag)) hG
    rw [mul_comm, coeff_nodeEquation_mul, ite_eq_left le_add_self, add_tsub_cancel_right,
      coeff_C_mul] at h
    exact ⟨coeff (n + diag) F + c * coeff (n + diag) G, by linear_combination h⟩
  have hC : (C b : MvPowerSeries (Fin 2) R) ≠ 0 := (map_ne_zero_iff _ C_injective).mpr hb
  exact Ideal.mem_span_singleton'.mpr ⟨G', mul_left_cancel₀ hC (by rw [← hG, mul_assoc])⟩

variable [IsDiscreteValuationRing R]

/-- For a nonunit `a` of a discrete valuation ring, multiplication by any nonzero constant is
injective modulo `XY - a`. -/
private theorem mem_span_of_C_mul_mem_span_of_not_isUnit {a b : R} (ha : ¬IsUnit a)
    (hb : b ≠ 0) {F : MvPowerSeries (Fin 2) R} (hF : C b * F ∈ Ideal.span {X 0 * X 1 - C a}) :
    F ∈ Ideal.span {X 0 * X 1 - C a} := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨k, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb hϖ
  have hϖa : ϖ ∣ a := by
    rw [← Ideal.mem_span_singleton, ← hϖ.maximalIdeal_eq]
    exact ha
  clear hb
  induction k generalizing F with
  | zero =>
    have h := Ideal.mul_mem_left _ (C ((v⁻¹ : Rˣ) : R)) hF
    rwa [← mul_assoc, ← map_mul, pow_zero, mul_one, Units.inv_mul, map_one, one_mul] at h
  | succ k ih =>
    refine ih (mem_span_of_C_mul_mem_span hϖ.ne_zero hϖa ?_)
    rwa [← mul_assoc, ← map_mul, mul_left_comm, ← pow_succ']

/-- **The completed node is torsion-free** over a discrete valuation ring, for every `a`; it is
therefore a flat `R`-module. When `a` is a unit the quotient is zero. -/
instance isTorsionFree (a : R) : Module.IsTorsionFree R (CompletedNodeAlgebra R a) := by
  by_cases ha : IsUnit a
  · have : Subsingleton (CompletedNodeAlgebra R a) := by
      refine Ideal.Quotient.subsingleton_iff.mpr (Ideal.span_singleton_eq_top.mpr ?_)
      rw [isUnit_iff_constantCoeff]
      simpa using ha.neg
    infer_instance
  refine .of_smul_eq_zero fun b x hbx ↦ or_iff_not_imp_left.mpr fun hb ↦ ?_
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [← Ideal.Quotient.mkₐ_eq_mk R, ← map_smul, Ideal.Quotient.mkₐ_eq_mk, smul_eq_C_mul,
    Ideal.Quotient.eq_zero_iff_mem] at hbx
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (mem_span_of_C_mul_mem_span_of_not_isUnit ha hb hbx)

end TorsionFree

section Regular

/-- **The completed node of a regular parameter is regular.** Over a regular local ring `R`, if
`a ∈ 𝔪_R \ 𝔪_R²`, then `R⟦X, Y⟧ ⧸ (XY - a)` is a regular local ring, hence a domain. -/
theorem isRegularLocalRing [IsRegularLocalRing R] {a : R} (ha : a ∈ maximalIdeal R)
    (ha2 : a ∉ maximalIdeal R ^ 2) : IsRegularLocalRing (CompletedNodeAlgebra R a) := by
  have hmap : Ideal.map (constantCoeff (σ := Fin 2) (R := R))
      (maximalIdeal (MvPowerSeries (Fin 2) R)) ≤
      maximalIdeal R := by
    rw [Ideal.map_le_iff_le_comap]
    intro f hf
    rw [Ideal.mem_comap, mem_maximalIdeal, mem_nonunits_iff, ← isUnit_iff_constantCoeff]
    exact hf
  have hcc : constantCoeff (X 0 * X 1 - C a : MvPowerSeries (Fin 2) R) = -a := by simp
  refine IsRegularLocalRing.quotient_span_singleton ?_ fun h ↦ ha2 ?_
  · rw [mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_constantCoeff, hcc, IsUnit.neg_iff]
    exact ha
  · have h' := Ideal.mem_map_of_mem (constantCoeff (σ := Fin 2) (R := R)) h
    rw [Ideal.map_pow] at h'
    have h'' := Ideal.pow_right_mono hmap 2 h'
    rwa [hcc, neg_mem_iff] at h''

end Regular

section Reduction

variable {ϖ : R} {e : ℕ} (he : e ≠ 0) (u : Rˣ)

/-- The substitution `X 0 ↦ (X 0) ^ e`, `X 1 ↦ u (X 1) ^ e`. -/
private def expandRescale : MvPowerSeries (Fin 2) R →ₐ[R] MvPowerSeries (Fin 2) R :=
  (expand e he).comp (rescaleAlgHom ![1, (u : R)])

private theorem coeff_expandRescale_nsmul (F : MvPowerSeries (Fin 2) R) (m : Fin 2 →₀ ℕ) :
    coeff (e • m) (expandRescale he u F) = (u : R) ^ m 1 * coeff m F := by
  simp [expandRescale, rescaleAlgHom_apply, Finsupp.prod_fintype]

private theorem coeff_expandRescale_of_not_dvd (F : MvPowerSeries (Fin 2) R)
    {n : Fin 2 →₀ ℕ} {i : Fin 2} (h : ¬e ∣ n i) : coeff n (expandRescale he u F) = 0 :=
  coeff_expand_of_not_dvd e he _ h

/-- The substitution sends `XY - u ϖᵉ` to `u ((XY)ᵉ - ϖᵉ)`, a multiple of `XY - ϖ`. -/
private theorem expandRescale_mem_span :
    expandRescale he u (X 0 * X 1 - C (u * ϖ ^ e)) ∈ Ideal.span {X 0 * X 1 - C ϖ} := by
  have hX (i : Fin 2) :
      rescaleAlgHom ![1, (u : R)] (X i) = C (![1, (u : R)] i) * X i := by
    rw [rescaleAlgHom, substAlgHom_apply, subst_X (HasSubst.smul_X _), Pi.smul_apply',
      smul_eq_C_mul]
  have hC (r : R) : expandRescale he u (C r) = C r := by
    rw [c_eq_algebraMap]
    exact AlgHom.commutes _ r
  have hX0 : expandRescale he u (X 0) = X 0 ^ e := by simp [expandRescale, hX]
  have hX1 : expandRescale he u (X 1) = C (u : R) * X 1 ^ e := by
    simp [expandRescale, hX, expand_C]
  have h : expandRescale he u (X 0 * X 1 - C (u * ϖ ^ e)) =
      C (u : R) * ((X 0 * X 1) ^ e - C ϖ ^ e) := by
    rw [map_sub, map_mul, hC, hX0, hX1, map_mul C, map_pow]
    ring
  rw [h]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton.mpr (sub_dvd_pow_sub_pow _ _ _))

variable {he u}

/-- Along a diagonal through `e • m`, the relation `F(Sᵉ, u Tᵉ) = (ST - ϖ) Q` forces
`ϖ ^ t Q_{e • m + t • (1, 1)} = Q_{e • m}` for `t < e`. -/
private theorem pow_mul_coeff_nsmul_add {F Q : MvPowerSeries (Fin 2) R}
    (hQ : expandRescale he u F = (X 0 * X 1 - C ϖ) * Q) (m : Fin 2 →₀ ℕ) :
    ∀ t, t < e → ϖ ^ t * coeff (e • m + t • diag) Q = coeff (e • m) Q
  | 0, _ => by simp
  | t + 1, ht => by
    have hdvd : ¬e ∣ (e • m + (t + 1) • diag) 0 := by
      simpa using (Nat.dvd_add_right (dvd_mul_right e (m 0))).not.mpr
        (Nat.not_dvd_of_pos_of_lt t.succ_pos ht)
    have h := congrArg (coeff (e • m + (t + 1) • diag)) hQ
    rw [coeff_expandRescale_of_not_dvd _ _ _ hdvd, coeff_nodeEquation_mul,
      ite_eq_left (diag_le_iff.mpr fun i ↦ by simp), succ_nsmul, ← add_assoc,
      add_tsub_cancel_right] at h
    rw [succ_nsmul, ← add_assoc, ← pow_mul_coeff_nsmul_add hQ m t (by omega)]
    linear_combination ϖ ^ t * h

/-- The coefficient of `F(Sᵉ, u Tᵉ) = (ST - ϖ) Q` at `e • m`, rewritten through
`pow_mul_coeff_nsmul_add`. -/
private theorem pow_mul_coeff_eq {F Q : MvPowerSeries (Fin 2) R}
    (hQ : expandRescale he u F = (X 0 * X 1 - C ϖ) * Q) (m : Fin 2 →₀ ℕ) :
    ϖ ^ (e - 1) * ((u : R) ^ m 1 * coeff m F) =
      (if diag ≤ m then coeff (e • (m - diag)) Q else 0) - ϖ ^ e * coeff (e • m) Q := by
  have h := congrArg (coeff (e • m)) hQ
  rw [coeff_expandRescale_nsmul, coeff_nodeEquation_mul] at h
  have hle : diag ≤ e • m ↔ diag ≤ m := by simp [diag_le_iff, he]
  rw [h, mul_sub, ← mul_assoc, ← pow_succ, Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr he)]
  congr 1
  simp only [hle]
  split_ifs with hm
  · have hsub : e • m - diag = e • (m - diag) + (e - 1) • diag := by
      ext i
      have hi : m i ≠ 0 := diag_le_iff.mp hm i
      obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hi
      obtain ⟨f, rfl⟩ := Nat.exists_eq_succ_of_ne_zero he
      simp only [Finsupp.tsub_apply, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul,
        diag_apply, hk, Nat.succ_sub_one, Nat.mul_succ]
      omega
    rw [hsub, pow_mul_coeff_nsmul_add hQ _ (e - 1) (by omega)]
  · simp

/-- **Injectivity of the substitution modulo the nodal equations.** If `F(Sᵉ, u Tᵉ)` is a multiple
of `ST - ϖ`, then `F` is a multiple of `XY - u ϖᵉ`. -/
private theorem mem_span_of_expandRescale_mem_span [IsDomain R] (hϖ : ϖ ≠ 0)
    {F : MvPowerSeries (Fin 2) R} (hF : expandRescale he u F ∈ Ideal.span {X 0 * X 1 - C ϖ}) :
    F ∈ Ideal.span {X 0 * X 1 - C (u * ϖ ^ e)} := by
  obtain ⟨Q, hQ⟩ := Ideal.mem_span_singleton'.mp hF
  replace hQ : expandRescale he u F = (X 0 * X 1 - C ϖ) * Q := by rw [← hQ, mul_comm]
  -- the multiple: the coefficients of `Q` at `e • m`, rescaled by powers of `u⁻¹`; a power
  -- series is its coefficient function, so `G` is given by its coefficients (`coeff_apply`)
  let G : MvPowerSeries (Fin 2) R := fun m ↦ ((u⁻¹ : Rˣ) : R) ^ (m 1 + 1) * coeff (e • m) Q
  have hG (m : Fin 2 →₀ ℕ) : coeff m G = ((u⁻¹ : Rˣ) : R) ^ (m 1 + 1) * coeff (e • m) Q :=
    coeff_apply G m
  refine mem_span_of_C_mul_mem_span (b := ϖ ^ (e - 1)) (pow_ne_zero _ hϖ)
    (Dvd.dvd.mul_left (pow_dvd_pow ϖ (Nat.sub_le e 1)) _)
    (Ideal.mem_span_singleton'.mpr ⟨G, ?_⟩)
  ext m
  have hif : (if diag ≤ m then coeff (m - diag) G else 0) =
      ((u⁻¹ : Rˣ) : R) ^ m 1 * (if diag ≤ m then coeff (e • (m - diag)) Q else 0) := by
    split_ifs with hm
    · rw [hG, Finsupp.tsub_apply, diag_apply,
        Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (diag_le_iff.mp hm 1))]
    · rw [mul_zero]
  have hu : (u : R) * ((u⁻¹ : Rˣ) : R) = 1 := u.mul_inv
  have hpow : ((u⁻¹ : Rˣ) : R) ^ m 1 * (u : R) ^ m 1 = 1 := by
    rw [← mul_pow, mul_comm, hu, one_pow]
  rw [mul_comm G, coeff_nodeEquation_mul, coeff_C_mul, hif, hG]
  linear_combination (-((u⁻¹ : Rˣ) : R) ^ m 1) * pow_mul_coeff_eq hQ m +
    (-(ϖ ^ e * ((u⁻¹ : Rˣ) : R) ^ m 1 * coeff (e • m) Q)) * hu +
    (ϖ ^ (e - 1) * coeff m F) * hpow

end Reduction

/-- **The completed node over a discrete valuation ring is a domain.** For a nonzero nonunit `a`
of a discrete valuation ring `R`, the ring `R⟦X, Y⟧ ⧸ (XY - a)` is a domain. Completeness of `R` is
not needed. -/
theorem isDomain [IsDomain R] [IsDiscreteValuationRing R] {a : R} (ha0 : a ≠ 0)
    (ha : ¬IsUnit a) : IsDomain (CompletedNodeAlgebra R a) := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨e, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0 hϖ
  have he : e ≠ 0 := by
    rintro rfl
    simp at ha
  have hϖ2 : ϖ ∉ maximalIdeal R ^ 2 := by
    rw [hϖ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton, pow_two]
    intro h
    exact hϖ.not_isUnit (isUnit_of_dvd_one
      ((mul_dvd_mul_iff_left hϖ.ne_zero).mp (by rwa [mul_one])))
  have := isRegularLocalRing (mem_maximalIdeal _ |>.mpr hϖ.not_isUnit) hϖ2
  let f := (Ideal.Quotient.mk (Ideal.span {X 0 * X 1 - C ϖ})).comp
    (expandRescale he u).toRingHom
  have hf (F : MvPowerSeries (Fin 2) R) (hF : F ∈ Ideal.span {X 0 * X 1 - C (u * ϖ ^ e)}) :
      f F = 0 := by
    obtain ⟨G, rfl⟩ := Ideal.mem_span_singleton'.mp hF
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, map_mul]
    exact Ideal.mul_mem_left _ _ (expandRescale_mem_span he u)
  refine Function.Injective.isDomain (Ideal.Quotient.lift _ f hf)
    (RingHom.lift_injective_of_ker_le_ideal _ hf fun F hF ↦ ?_)
  exact mem_span_of_expandRescale_mem_span hϖ.ne_zero
    (Ideal.Quotient.eq_zero_iff_mem.mp (RingHom.mem_ker.mp hF))

end CompletedNodeAlgebra

end TauCeti
