/-!
# Nodal relative curves are hypersurfaces in smooth relative surfaces

Let `S = R[x₁, …, x_{c+1}] ⧸ (g₁, …, g_c)` be presented over an arbitrary commutative ring `R`
with one more generator than relations, for instance a standard syntomic algebra of relative
dimension one. Suppose that the closed subscheme cut out by the first Fitting ideal of `Ω[S⁄R]`,
the singular locus, is unramified over `R`, as for a nodal relative curve. Then, Zariski locally
around every point, `S` is a hypersurface in a smooth relative surface: there are `a ∉ q`, an
`R`-algebra `W` that is standard smooth of relative dimension two, and `f ∈ W` with
`W ⧸ (f) ≅ S[1/a]`.

This is the form in which the Hessian criterion
`Module.Basis.forall_mem_and_det_hessian_notMem_of_formallyUnramified` and the chart
construction `Module.Basis.exists_etale_nodeAlgebra_hom_of_critical` apply to a nodal relative
curve: both start from a function on a smooth relative surface whose differentials have a basis.

The proof reads the Jacobian criterion through Fitting ideals. Since the singular locus is
unramified, `Fitt₂(Ω[S⁄R]) = S` (`TauCeti.fittingIdeal_kaehlerDifferential_two_eq_top`), and
`Fitt₂` is generated by the `(c - 1)`-minors of the Jacobian matrix
(`TauCeti.fittingIdeal_kaehlerDifferential_quotient_span_range`). So some such minor `a` does
not vanish at `q`. It uses all relations but one, `g_{s₀}`, and `c - 1` of the variables. Inverting
it, the relations other than `g_{s₀}` cut out a standard smooth algebra `W` of relative dimension
two (`Algebra.PreSubmersivePresentation.isStandardSmoothOfRelativeDimension_localizationAway`),
and `S[1/a]` is the quotient of `W` by `g_{s₀}`.

## Main results

* `Algebra.Presentation.exists_hypersurface_localizationAway_of_formallyUnramified`: a presented
  algebra with one more generator than relations and unramified singular locus is, near every
  prime, the quotient of a standard smooth relative surface by one equation.

## References

* [Stacks Project, Lemma 53.20.1, Tag 0C58](https://stacks.math.columbia.edu/tag/0C58): the
  singular-locus criterion and local structure of families of nodal curves.
* [Stacks Project, Tag 00T7](https://stacks.math.columbia.edu/tag/00T7): standard smooth algebras
  and the Jacobian criterion.
-/

public section

noncomputable section

open KaehlerDifferential MvPolynomial TauCeti

universe u v w t

namespace Algebra.Presentation

variable {R : Type u} {S : Type v} {ι : Type w} {σ : Type t} [CommRing R] [CommRing S]
  [Algebra R S] [Algebra.EssFiniteType R S]
  [Algebra.FormallyUnramified R (S ⧸ fittingIdeal S Ω[S⁄R] 1)] [Finite ι] [Finite σ]

/-- **A nodal relative curve is locally a hypersurface in a smooth relative surface.** Let `S`
have a presentation `P` over `R` with one more generator than relations, and suppose that the
singular locus `S ⧸ Fitt₁(Ω[S⁄R])` is unramified over `R`. Then around every prime `q` of `S`
there are `a ∉ q`, an `R`-algebra `W` which is standard smooth of relative dimension two (so
`Ω[W⁄R]` has a basis with two elements), and `f ∈ W` such that `W ⧸ (f) ≃ₐ[R] S[1/a]`.

The presentation needs at least one relation; one without relations can be enlarged by a new
generator `t` and the relation `t`. -/
theorem exists_hypersurface_localizationAway_of_formallyUnramified [Nonempty σ]
    (P : Presentation R S ι σ) (hP : Nat.card ι = 1 + Nat.card σ) (q : Ideal S) [q.IsPrime] :
    ∃ (W : Type (max u w)) (_ : CommRing W) (_ : Algebra R W)
      (_ : IsStandardSmoothOfRelativeDimension 2 R W) (_ : Module.Basis (Fin 2) W Ω[W⁄R])
      (f : W) (a : S), a ∉ q ∧ Nonempty ((W ⧸ Ideal.span {f}) ≃ₐ[R] Localization.Away a) := by
  classical
  have := Fintype.ofFinite ι
  have := Fintype.ofFinite σ
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card] at hP
  set m := Fintype.card ι - 2 with hm
  have hσ : Fintype.card σ = m + 1 := by
    have := Fintype.card_pos (α := σ)
    omega
  let M : Matrix ι σ (MvPolynomial ι R) := Matrix.of fun i j ↦ pderiv i (P.relation j)
  -- Since `Fitt₂(Ω[S⁄R]) = S`, some `m × m` minor of the Jacobian matrix does not vanish at `q`.
  obtain ⟨r, c, hrc⟩ : ∃ (r : Fin m → ι) (c : Fin m → σ),
      aeval P.val (M.submatrix r c).det ∉ q := by
    by_contra! h
    let e : (MvPolynomial ι R ⧸ Ideal.span (Set.range P.relation)) ≃ₐ[R] S :=
      (Ideal.quotientEquivAlgOfEq R P.span_range_relation_eq_ker).trans
        (P.quotientEquiv.restrictScalars R)
    have hfit := fittingIdeal_kaehlerDifferential_two_eq_top (R := R) (A := S)
    rw [fittingIdeal_kaehlerDifferential_eq_map_algEquiv e,
      fittingIdeal_kaehlerDifferential_quotient_span_range P.relation (mvPolynomialBasis R ι),
      Ideal.map_span, Ideal.map_span, ← hm] at hfit
    refine Ideal.IsPrime.ne_top ‹_› (top_le_iff.1 (hfit ▸ Ideal.span_le.2 ?_))
    rintro _ ⟨_, ⟨_, ⟨rc, rfl⟩, rfl⟩, rfl⟩
    convert h rc.1 rc.2 using 1
    simp [e, M, P.algebraMap_apply]
  -- The rows and columns of this minor are distinct, so it leaves out exactly one relation `s₀`.
  have hc : Function.Injective c := fun x y hxy ↦ by_contra fun hne ↦ hrc <| by
    rw [Matrix.det_zero_of_column_eq hne fun k ↦ by simp [hxy], map_zero]
    exact q.zero_mem
  have hr : Function.Injective r := fun x y hxy ↦ by_contra fun hne ↦ hrc <| by
    rw [Matrix.det_zero_of_row_eq hne (by ext k; simp [hxy]), map_zero]
    exact q.zero_mem
  obtain ⟨s₀, hs₀⟩ : ∃ s₀, ∀ s, s ∈ Set.range c ↔ s ≠ s₀ := by
    have : (Finset.univ.image c)ᶜ.card = 1 := by
      rw [Finset.card_compl, Finset.card_image_of_injective _ hc, Finset.card_univ,
        Fintype.card_fin, hσ, Nat.add_sub_cancel_left]
    obtain ⟨s₀, hs₀⟩ := Finset.card_eq_one.1 this
    refine ⟨s₀, fun s ↦ ?_⟩
    have := Finset.ext_iff.1 hs₀ s
    simp only [Finset.mem_compl, Finset.mem_image, Finset.mem_univ, true_and,
      Finset.mem_singleton] at this
    rw [Set.mem_range, ne_eq, ← this, not_not]
  -- The other relations cut out a relative surface, standard smooth where the minor is a unit.
  set J₀ := Ideal.span (Set.range (P.relation ∘ c))
  let P' := PreSubmersivePresentation.naive (v := P.relation ∘ c) r hr
  let W := Localization.Away P'.jacobian
  have hjm : P'.jacobiMatrix = M.submatrix r c := by
    ext i j
    simp [P', M]
  have hjac : P'.jacobian = Ideal.Quotient.mk J₀ (M.submatrix r c).det := by
    rw [P'.jacobian_eq_jacobiMatrix_det, hjm]
    -- The naive presentation carries the quotient algebra structure.
    rfl
  have hdim : P'.dimension = 2 := by
    simp only [Presentation.dimension, Nat.card_eq_fintype_card, Fintype.card_fin]
    omega
  have hW : IsStandardSmoothOfRelativeDimension 2 R W :=
    hdim ▸ P'.isStandardSmoothOfRelativeDimension_localizationAway W
  -- Cutting out the last relation `s₀` from the surface recovers `S`.
  set I : Ideal (MvPolynomial ι R ⧸ J₀) :=
    (Ideal.span {P.relation s₀}).map (Ideal.Quotient.mkₐ R J₀)
  have hJ : J₀ ⊔ Ideal.span {P.relation s₀} = P.ker := by
    rw [← P.span_range_relation_eq_ker, ← Ideal.span_union, Set.range_comp]
    congr 1
    ext p
    constructor
    · rintro (⟨_, ⟨j, rfl⟩, rfl⟩ | rfl) <;> exact ⟨_, rfl⟩
    · rintro ⟨s, rfl⟩
      by_cases hs : s = s₀
      · exact .inr (by rw [hs]; rfl)
      · exact .inl ⟨s, (hs₀ s).2 hs, rfl⟩
  let e₁ : ((MvPolynomial ι R ⧸ J₀) ⧸ I) ≃ₐ[R] S :=
    (DoubleQuot.quotQuotEquivQuotSupₐ R J₀ _).trans
      ((Ideal.quotientEquivAlgOfEq R hJ).trans (P.quotientEquiv.restrictScalars R))
  have he₁ (x : MvPolynomial ι R) :
      e₁ (Ideal.Quotient.mk I (Ideal.Quotient.mk J₀ x)) = aeval P.val x := by
    have h : DoubleQuot.quotQuotEquivQuotSupₐ R J₀ (Ideal.span {P.relation s₀})
        (Ideal.Quotient.mk I (Ideal.Quotient.mk J₀ x)) = Ideal.Quotient.mk _ x :=
      DoubleQuot.quotQuotEquivQuotSup_quotQuotMk _ _ x
    simp [e₁, h, P.algebraMap_apply]
  -- Localization commutes with the quotient by `s₀`, so `W ⧸ (s₀)` is `S` with the minor inverted.
  let f : W := algebraMap _ W (Ideal.Quotient.mk J₀ (P.relation s₀))
  have hf : Ideal.span {f} = I.map (algebraMap _ W) := by
    simp [I, f, Ideal.map_span]
  have : IsScalarTower R ((MvPolynomial ι R ⧸ J₀) ⧸ I) (W ⧸ I.map (algebraMap _ W)) :=
    IsScalarTower.of_algebraMap_eq (R := R) (S := (MvPolynomial ι R ⧸ J₀) ⧸ I)
      (A := W ⧸ I.map (algebraMap _ W)) fun x ↦ by
        rw [IsScalarTower.algebraMap_apply R (MvPolynomial ι R ⧸ J₀) ((MvPolynomial ι R ⧸ J₀) ⧸ I),
          Ideal.Quotient.algebraMap_eq, Ideal.Quotient.algebraMap_quotient_map_quotient,
          ← IsScalarTower.algebraMap_apply, Ideal.Quotient.mk_algebraMap]
  let eW : (W ⧸ Ideal.span {f}) ≃ₐ[R] Localization.Away (aeval P.val (M.submatrix r c).det) :=
    (Ideal.quotientEquivAlgOfEq R hf).trans (IsLocalization.algEquivOfAlgEquiv _ _ e₁
      (M := .powers (Ideal.Quotient.mk I P'.jacobian))
      (T := .powers (aeval P.val (M.submatrix r c).det)) (by
        rw [Submonoid.map_powers, hjac]
        exact congrArg _ (he₁ _)))
  -- `W` is nontrivial, since the minor is not nilpotent; so `Ω[W⁄R]` is free of rank two.
  have : Nontrivial (Localization.Away (aeval P.val (M.submatrix r c).det)) := by
    refine not_subsingleton_iff_nontrivial.1 fun h ↦ hrc ?_
    obtain ⟨n, hn⟩ := (IsLocalization.subsingleton_iff
      (M := .powers (aeval P.val (M.submatrix r c).det))).1 h
    refine ‹q.IsPrime›.mem_of_pow_mem n ?_
    simp [hn]
  have : Nontrivial W :=
    (eW.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {f}))).domain_nontrivial
  have := hW.isStandardSmooth
  exact ⟨W, inferInstance, inferInstance, hW, Module.finBasisOfFinrankEq W Ω[W⁄R]
    (Module.finrank_eq_of_rank_eq (IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential 2)),
    f, _, hrc, ⟨eW⟩⟩

end Algebra.Presentation
