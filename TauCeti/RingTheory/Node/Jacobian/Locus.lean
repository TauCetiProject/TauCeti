module

public import TauCeti.RingTheory.Node.Differential

/-!
# The Jacobian locus of a nodal chart

For the equation `xy = a`, the first Fitting ideal of the relative differentials is generated
by `x` and `y`. Its quotient is the base ring modulo `a`. Thus the closed subscheme cut out
by the Jacobian ideal is precisely the zero locus of the smoothing parameter, with no
assumption that the base is reduced or that `a` is a non-zero-divisor.

## References

* Stacks Project, Example 55.14.1, Tag 0CDC.
-/

public section

noncomputable section

namespace TauCeti.NodeAlgebra

variable {R : Type*} [CommRing R] (a : R)

/-- The ideal generated by the two coordinates in the nodal equation `xy = a`. -/
def jacobianIdeal : Ideal (NodeAlgebra R a) := Ideal.span {coord a 0, coord a 1}

/-- Each coordinate belongs to the Jacobian ideal. -/
@[simp]
theorem coord_mem_jacobianIdeal (i : Fin 2) : coord a i ∈ jacobianIdeal a := by
  fin_cases i <;> exact Ideal.subset_span (by simp)

private lemma algebraMap_a_mem_jacobianIdeal :
    algebraMap R (NodeAlgebra R a) a ∈ jacobianIdeal a := by
  rw [← coord_zero_mul_coord_one]
  exact Ideal.mul_mem_right _ _ (coord_mem_jacobianIdeal a 0)

private def evalZero : NodeAlgebra R a →ₐ[R] R ⧸ Ideal.span {a} :=
  lift a 0 0 (by simp)

private lemma evalZero_surjective : Function.Surjective (evalZero a) := by
  intro z
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact ⟨algebraMap R (NodeAlgebra R a) r, (evalZero a).commutes r⟩

private lemma jacobianIdeal_eq_ker_evalZero :
    jacobianIdeal a = RingHom.ker (evalZero a).toRingHom := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro z (rfl | rfl) <;> simp [evalZero]
  · have hbase : Ideal.span {a} ≤
        RingHom.ker (algebraMap R (NodeAlgebra R a ⧸ jacobianIdeal a)) := by
      apply Ideal.span_le.mpr
      rintro r rfl
      apply RingHom.mem_ker.mpr
      rw [← Ideal.Quotient.mk_algebraMap]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (algebraMap_a_mem_jacobianIdeal r)
    have hq : (Ideal.Quotient.mkₐ R (jacobianIdeal a)).comp (mk a) =
        (Algebra.ofId R _).comp (MvPolynomial.aeval (fun _ : Fin 2 => (0 : R))) := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i <;> simp only [AlgHom.comp_apply, MvPolynomial.aeval_X,
        map_zero, mk_X]
      all_goals
        rw [Ideal.Quotient.mkₐ_eq_mk]
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact coord_mem_jacobianIdeal a _
    have he : (evalZero a).comp (mk a) =
        (Ideal.Quotient.mkₐ R (Ideal.span {a})).comp
          (MvPolynomial.aeval (fun _ : Fin 2 => (0 : R))) := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i <;> simp [evalZero]
    intro z hz
    obtain ⟨p, rfl⟩ := mk_surjective a z
    have hp : MvPolynomial.aeval (fun _ : Fin 2 => (0 : R)) p ∈ Ideal.span {a} := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      exact (congrArg (fun f : MvPolynomial (Fin 2) R →ₐ[R] R ⧸ Ideal.span {a} => f p)
        he).symm.trans (RingHom.mem_ker.mp hz)
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have hqp : Ideal.Quotient.mk (jacobianIdeal a) (mk a p) =
        algebraMap R (NodeAlgebra R a ⧸ jacobianIdeal a)
          (MvPolynomial.aeval (fun _ : Fin 2 => (0 : R)) p) := by
      simpa only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Algebra.ofId_apply] using
        congrArg (fun f : MvPolynomial (Fin 2) R →ₐ[R]
          NodeAlgebra R a ⧸ jacobianIdeal a => f p) hq
    rw [hqp]
    exact RingHom.mem_ker.mp (hbase hp)

/-- The Jacobian quotient of `R[x,y]/(xy-a)` is canonically `R/(a)`. -/
def jacobianQuotientEquiv :
    (NodeAlgebra R a ⧸ jacobianIdeal a) ≃ₐ[R] R ⧸ Ideal.span {a} :=
  (Ideal.quotientEquivAlgOfEq R (jacobianIdeal_eq_ker_evalZero a)).trans
    (Ideal.quotientKerAlgEquivOfSurjective (evalZero_surjective a))

/-- The closed subscheme cut out by the first Fitting ideal of the relative differentials
has coordinate ring `R/(a)`. -/
def differentialFittingQuotientEquiv :
    (NodeAlgebra R a ⧸ fittingIdeal (NodeAlgebra R a) Ω[NodeAlgebra R a⁄R] 1) ≃ₐ[R]
      R ⧸ Ideal.span {a} := by
  have hfit : fittingIdeal (NodeAlgebra R a) Ω[NodeAlgebra R a⁄R] 1 =
      jacobianIdeal a := by
    exact fittingIdeal_differential_one a
  exact (Ideal.quotientEquivAlgOfEq R hfit).trans (jacobianQuotientEquiv a)

/-- Both coordinates vanish in the Jacobian quotient. -/
@[simp]
theorem jacobianQuotientEquiv_coord (i : Fin 2) :
    jacobianQuotientEquiv a (Ideal.Quotient.mk (jacobianIdeal a) (coord a i)) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr (coord_mem_jacobianIdeal a i)]
  exact map_zero _

/-- The inverse equivalence sends a base class to its image in the Jacobian quotient. -/
@[simp]
theorem jacobianQuotientEquiv_symm_mk (r : R) :
    (jacobianQuotientEquiv a).symm (Ideal.Quotient.mk (Ideal.span {a}) r) =
      Ideal.Quotient.mk (jacobianIdeal a) (algebraMap R (NodeAlgebra R a) r) := by
  simpa only [Ideal.Quotient.algebraMap_eq, ← Ideal.Quotient.mk_algebraMap] using
    (jacobianQuotientEquiv a).symm.commutes r

/-- Both coordinates vanish under the Fitting quotient equivalence. -/
@[simp]
theorem differentialFittingQuotientEquiv_coord (i : Fin 2) :
    differentialFittingQuotientEquiv a
      (Ideal.Quotient.mk (fittingIdeal (NodeAlgebra R a) Ω[NodeAlgebra R a⁄R] 1)
        (coord a i)) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr (by
    rw [fittingIdeal_differential_one]
    exact coord_mem_jacobianIdeal a i)]
  exact map_zero _

/-- The inverse Fitting quotient equivalence sends a base class to its image. -/
@[simp]
theorem differentialFittingQuotientEquiv_symm_mk (r : R) :
    (differentialFittingQuotientEquiv a).symm (Ideal.Quotient.mk (Ideal.span {a}) r) =
      Ideal.Quotient.mk (fittingIdeal (NodeAlgebra R a) Ω[NodeAlgebra R a⁄R] 1)
        (algebraMap R (NodeAlgebra R a) r) := by
  simpa only [Ideal.Quotient.algebraMap_eq, ← Ideal.Quotient.mk_algebraMap] using
    (differentialFittingQuotientEquiv a).symm.commutes r

end TauCeti.NodeAlgebra
