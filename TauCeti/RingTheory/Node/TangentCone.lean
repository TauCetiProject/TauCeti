/-!
# The tangent cone of a node

Let `P` be a regular local ring whose maximal ideal is generated by two coordinates `s₀, s₁` with
dual derivations `Dᵢ`, for instance the local ring at a closed point of a smooth surface over a
field, and let `A = P ⧸ (f)` for some `f ∈ 𝔪_P²` whose Hessian determinant is a unit. By
`TauCeti.exists_hypersurface_presentation_of_formallyUnramified`, the local ring at a node of a
nodal curve over a field is of this form. This file shows that `A` satisfies the hypotheses of
the computation in `TauCeti.RingTheory.Node.ExceptionalFiber`. Hence the fibre of the blowup of
`Spec A` at its closed point is an étale algebra of dimension two over the residue field `κ`: the
two tangent directions at the node, the directions of the two branches through it, form a finite
étale `κ`-scheme of degree two, which need not split over `κ`.

Write `f = a s₀² + b s₀ s₁ + c s₁²` (`Ideal.mem_span_pair_sq`). The Hessian condition says that
`b² - 4ac` is a unit (`TauCeti.isUnit_det_hessian_iff_isUnit_discrim`). A change of generators
makes the coefficient of the square of the second generator a unit: swap `s₀` and `s₁` when `a`
is a unit, and otherwise replace `s₀` by `s₀ + s₁`, since when `a, c ∈ 𝔪` the coefficient `b`
and hence `a - b + c` are units. Dividing by that coefficient gives the equation
`a x² + b x y + y²` with `b² - 4a` a unit
(`TauCeti.exists_eq_unit_mul_quadratic_of_isUnit_discrim`). The generator `x` is then a
nonzerodivisor of `A`: since `P` is regular, `(x)` is prime, and it does not contain
`a x² + b x y + y²` because it does not contain `y`
(`TauCeti.IsLocalRing.notMem_span_singleton_of_span_pair_eq_maximalIdeal` and
`TauCeti.IsRegularLocalRing.apply_mem_nonZeroDivisors_of_ker_eq_span`). The maximal ideal of `A`
is not principal, since `f ∈ 𝔪_P²` imposes no relation on the cotangent plane of `P`
(`TauCeti.IsLocalRing.not_isPrincipal_maximalIdeal_of_ker_le_sq`). Finally
`y² = -x (a x + b y)` lies in `x 𝔪_A`, so the chart `Spec A[𝔪/x]` is the whole blowup
(`TauCeti.AlgebraicGeometry.isIso_affineBlowupι_of_sq_mem`).

At a node, the regularity of `P` follows from `TauCeti.IsRegularLocalRing.of_formallySmooth`,
since the local ring `P` produced by
`TauCeti.exists_hypersurface_presentation_of_formallyUnramified` is formally smooth and essentially
of finite type over the base field.

## Main results

* `TauCeti.exists_quadratic_relation_of_isUnit_det_hessian`: generators `x, y` of `𝔪_A` with a
  relation `a x² + b x y + y² = 0`, `b² - 4a` a unit and `x` a nonzerodivisor, as required by
  `TauCeti.adjoinRootEquivTensorAffineBlowup` and `TauCeti.etale_tensor_affineBlowup`.
* `TauCeti.exists_etale_tensor_affineBlowup_of_isUnit_det_hessian`: the fibre of the blowup of
  `Spec A` at its closed point is an étale `κ`-algebra of dimension two.
* `TauCeti.exists_etale_tensor_affineBlowup_of_formallyUnramified` and
  `Algebra.Presentation.exists_etale_tensor_affineBlowup_of_formallyUnramified`: the same at a
  node, for a quotient of a formally smooth local ring and for a presented curve.

## References

* [Stacks Project, Section 53.19, Tag 0C46](https://stacks.math.columbia.edu/tag/0C46): nodes of
  curves, defined by a nondegenerate quadratic form in two variables.
* [Stacks Project, Section 10.70, Tag 052P](https://stacks.math.columbia.edu/tag/052P): blowup
  algebras.
-/

public section

noncomputable section

open IsLocalRing Module TensorProduct

namespace TauCeti

section PlaneCurve

variable {P A : Type*} [CommRing P] [CommRing A]

variable [IsRegularLocalRing P] [IsLocalRing A] {R : Type*} [CommSemiring R] [Algebra R P]
  {s : Fin 2 → P} {D : Fin 2 → Derivation R P P} {f : P}

/-- **A plane curve singularity with nondegenerate quadratic part.** Let `P` be a regular local
ring whose maximal ideal is generated by `s₀, s₁`, with derivations `Dᵢ` dual to them, and let
`A = P ⧸ (f)` for some `f ∈ 𝔪_P²` whose Hessian determinant is a unit. Then the maximal ideal
of `A` is generated by two elements `x, y` with `a x² + b x y + y² = 0` for some `a, b` with
`b² - 4a` a unit, `x` is a nonzerodivisor, and `𝔪_A` is not principal. -/
theorem exists_quadratic_relation_of_isUnit_det_hessian
    (hs : maximalIdeal P = Ideal.span (Set.range s))
    (hD : ∀ i j, D i (s j) = if i = j then 1 else 0) (hf : f ∈ maximalIdeal P ^ 2)
    (hH : IsUnit (hessian D f).det) (π : P →+* A) (hπ : Function.Surjective π)
    (hker : RingHom.ker π = Ideal.span {f}) :
    ∃ x y a b : A, maximalIdeal A = Ideal.span {x, y} ∧ x ∈ nonZeroDivisors A ∧
      ¬ (maximalIdeal A).IsPrincipal ∧ a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧
      IsUnit (discrim a b 1) := by
  have hs2 : Set.range s = {s 0, s 1} := Set.range_fin_two s
  have hsm (i : Fin 2) : s i ∈ maximalIdeal P := hs ▸ Ideal.subset_span ⟨i, rfl⟩
  -- The cotangent space of `P` is a plane, so no single element generates `𝔪_P` modulo `𝔪_P²`.
  have hne (z : P) (hz : z ∈ maximalIdeal P) :
      ¬ maximalIdeal P ≤ Ideal.span {z} ⊔ maximalIdeal P ^ 2 := fun h ↦ by
    have := card_le_card_of_le_span_sup_sq hsm hD (w := fun _ : Unit ↦ z) (fun _ ↦ hz)
      (by rwa [Set.range_const])
    simp at this
  -- Write `f = a s₀² + b s₀ s₁ + c s₁²`, and bring it to the form `e (a' x² + b' x y + y²)`.
  rw [hs, hs2] at hf
  obtain ⟨a, b, c, rfl⟩ := Ideal.mem_span_pair_sq.1 hf
  rw [← hs2, ← hs] at hf
  have hd : IsUnit (discrim a b c) := (isUnit_det_hessian_iff_isUnit_discrim hsm hD a b c).1 hH
  obtain ⟨x, y, a', b', e, he, hxy, hfe, hd'⟩ := exists_eq_unit_mul_quadratic_of_isUnit_discrim hd
  have hm : maximalIdeal P = Ideal.span {x, y} := by rw [hxy, hs, hs2]
  have hker' : RingHom.ker π = Ideal.span {a' * x ^ 2 + b' * x * y + y ^ 2} := by
    rw [hker, hfe, Ideal.span_singleton_mul_left_unit he]
  have hprin : ¬ (maximalIdeal P).IsPrincipal :=
    IsLocalRing.not_isPrincipal_maximalIdeal_of_ker_le_sq (π := RingHom.id P)
      Function.surjective_id
      (((RingHom.injective_iff_ker_eq_bot _).1 Function.injective_id).trans_le bot_le) hne
  have hmA : maximalIdeal A = Ideal.span {π x, π y} := by
    rw [← map_maximalIdeal_of_surjective π hπ, hm, Ideal.map_span, Set.image_pair]
  -- `x` is a regular parameter, and `a' x² + b' x y + y² ∉ (x)` since `(x)` is prime and does
  -- not contain `y`.
  have hxm := IsLocalRing.mem_maximalIdeal_of_span_pair_eq_maximalIdeal hm.symm
  have hx2 := IsLocalRing.notMem_sq_of_span_pair_eq_maximalIdeal hprin hm.symm
  have hg : a' * x ^ 2 + b' * x * y + y ^ 2 ∉ Ideal.span {x} := fun hg ↦
    IsLocalRing.notMem_span_singleton_of_span_pair_eq_maximalIdeal hprin hm.symm <|
      (IsRegularLocalRing.span_singleton_isPrime_of_notMem_sq hxm hx2).mem_of_pow_mem 2 <| by
        have hx : x * (a' * x + b' * y) ∈ Ideal.span {x} :=
          Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self x)
        simpa [show a' * x ^ 2 + b' * x * y + y ^ 2 - x * (a' * x + b' * y) = y ^ 2 by ring]
          using sub_mem hg hx
  refine ⟨π x, π y, π a', π b', hmA,
    IsRegularLocalRing.apply_mem_nonZeroDivisors_of_ker_eq_span hxm hx2 hg π hπ hker',
    ?_, ?_, ?_⟩
  · exact IsLocalRing.not_isPrincipal_maximalIdeal_of_ker_le_sq hπ
      (hker ▸ (Ideal.span_singleton_le_iff_mem _).2 hf) hne
  · have h := (RingHom.mem_ker (f := π)).1 (hker' ▸ Ideal.mem_span_singleton_self _)
    simpa only [map_add, map_mul, map_pow] using h
  · simpa only [discrim, map_sub, map_mul, map_pow, map_ofNat, map_one] using hd'.map π

/-- **The exceptional fibre of blowing up a plane curve singularity with nondegenerate quadratic
part.** Under the hypotheses of `TauCeti.exists_quadratic_relation_of_isUnit_det_hessian`, the
maximal ideal of `A` is generated by two elements `x, y` with `y² ∈ x 𝔪_A`, so that the chart
`Spec A[𝔪/x]` is the whole blowup of `Spec A` at its closed point, and the fibre
`κ ⊗[A] A[𝔪/x]` of this blowup over the closed point is an étale `κ`-algebra of dimension two. -/
theorem exists_etale_tensor_affineBlowup_of_isUnit_det_hessian
    (hs : maximalIdeal P = Ideal.span (Set.range s))
    (hD : ∀ i j, D i (s j) = if i = j then 1 else 0) (hf : f ∈ maximalIdeal P ^ 2)
    (hH : IsUnit (hessian D f).det) (π : P →+* A) (hπ : Function.Surjective π)
    (hker : RingHom.ker π = Ideal.span {f}) :
    ∃ x y : A, maximalIdeal A = Ideal.span {x, y} ∧ y ^ 2 ∈ Ideal.span {x} * maximalIdeal A ∧
      Module.finrank (ResidueField A)
        (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x (Localization.Away x)) = 2 ∧
      Algebra.Etale (ResidueField A)
        (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x (Localization.Away x)) := by
  obtain ⟨x, y, a, b, hm, hx, hprin, hrel, hd⟩ :=
    exists_quadratic_relation_of_isUnit_det_hessian hs hD hf hH π hπ hker
  refine ⟨x, y, hm, Ideal.mem_span_singleton_mul.2 ⟨-(a * x + b * y), ?_, by
      linear_combination -hrel⟩,
    finrank_tensor_affineBlowup hm hrel hx hprin, etale_tensor_affineBlowup hm hrel hd⟩
  rw [hm]
  exact neg_mem (add_mem (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
    (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))))

end PlaneCurve

section Node

open KaehlerDifferential

variable {K : Type*} [Field K]

/-- Transport `TauCeti.exists_etale_tensor_affineBlowup_of_isUnit_det_hessian` along a
`K`-algebra isomorphism `P ⧸ (f) ≃ A`, for `P` formally smooth with coordinates `y` whose
differentials form the basis `b`. -/
private theorem exists_etale_tensor_affineBlowup_of_algEquiv {P A : Type*} [CommRing P]
    [Algebra K P] [IsLocalRing P] [Algebra.EssFiniteType K P] [Algebra.FormallySmooth K P]
    [CommRing A] [Algebra K A] [IsLocalRing A] {y : Fin 2 → P} (b : Basis (Fin 2) P Ω[P⁄K])
    (hy : maximalIdeal P = Ideal.span (Set.range y)) (hb : ∀ j, b j = D K P (y j)) {f : P}
    (hf : f ∈ maximalIdeal P ^ 2)
    (hH : IsUnit (hessian (fun i ↦ (b.coord i).compDer (D K P)) f).det)
    (φ : (P ⧸ Ideal.span {f}) ≃ₐ[K] A) :
    ∃ x y : A, maximalIdeal A = Ideal.span {x, y} ∧ y ^ 2 ∈ Ideal.span {x} * maximalIdeal A ∧
      Module.finrank (ResidueField A)
        (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x (Localization.Away x)) = 2 ∧
      Algebra.Etale (ResidueField A)
        (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x (Localization.Away x)) := by
  have : IsRegularLocalRing P := IsRegularLocalRing.of_formallySmooth (R := K)
  exact exists_etale_tensor_affineBlowup_of_isUnit_det_hessian hy
    (fun i j ↦ by simp [← hb, Finsupp.single_apply, eq_comm]) hf hH
    ((φ : P ⧸ Ideal.span {f} →+* A).comp (Ideal.Quotient.mk _))
    (φ.surjective.comp Ideal.Quotient.mk_surjective)
    ((RingHom.ker_comp_of_injective _ φ.injective).trans (Ideal.mk_ker))

variable {Q A ι σ : Type*} [CommRing Q] [Algebra K Q] [IsLocalRing Q]
  [Algebra.EssFiniteType K Q] [Algebra.FormallySmooth K Q] [CommRing A] [Algebra K A]
  [IsLocalRing A] [Algebra.EssFiniteType K A] [Fintype ι] [Fintype σ]
  [Algebra.FormallyUnramified K (A ⧸ fittingIdeal A Ω[A⁄K] 1)]

/-- **The exceptional fibre of blowing up a node.** Let `A = Q ⧸ (g₁, …, g_c)` be as in
`TauCeti.exists_hypersurface_presentation_of_formallyUnramified`: `Q` is a local `K`-algebra,
essentially of finite type and formally smooth over a field `K`, with `Ω[Q⁄K]` free of rank
`c + 1`, and `A` is local with `A ⧸ Fitt₁(Ω[A⁄K])` unramified over `K` and `Fitt₁(Ω[A⁄K])` proper,
as at a node of a nodal curve over `K`. Then the maximal ideal of `A` is generated by two elements
`x, y` with `y² ∈ x 𝔪_A`, so that the chart `Spec A[𝔪/x]` is the whole blowup of `Spec A` at its
closed point, and the fibre `κ ⊗[A] A[𝔪/x]` of this blowup over the closed point is an étale
`κ`-algebra of dimension two. -/
theorem exists_etale_tensor_affineBlowup_of_formallyUnramified (b : Basis ι Q Ω[Q⁄K])
    (π : Q →ₐ[K] A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g)) (hσ : Fintype.card σ + 1 = Fintype.card ι)
    (hsing : fittingIdeal A Ω[A⁄K] 1 ≠ ⊤) :
    ∃ x y : A, maximalIdeal A = Ideal.span {x, y} ∧ y ^ 2 ∈ Ideal.span {x} * maximalIdeal A ∧
      Module.finrank (ResidueField A)
        (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x (Localization.Away x)) = 2 ∧
      Algebra.Etale (ResidueField A)
        (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x (Localization.Away x)) := by
  obtain ⟨s₀, _, y, b', _, hy, hb', hf2, hH, φ, -⟩ :=
    exists_hypersurface_presentation_of_formallyUnramified b π hπ hg hσ hsing
  exact exists_etale_tensor_affineBlowup_of_algEquiv b' hy hb' hf2 hH φ

end Node

end TauCeti

namespace Algebra.Presentation

open TauCeti KaehlerDifferential

variable {K S ι σ : Type*} [Field K] [CommRing S] [Algebra K S] [Algebra.EssFiniteType K S]
  [Fintype ι] [Fintype σ] [Algebra.FormallyUnramified K (S ⧸ fittingIdeal S Ω[S⁄K] 1)]

/-- **The exceptional fibre of blowing up a node of a presented curve.** Let
`S = K[x₁, …, x_{c+1}] ⧸ (f₁, …, f_c)` be presented over a field `K` by `c + 1` generators and `c`
relations, with `S ⧸ Fitt₁(Ω[S⁄K])` unramified over `K`, and let `q` be a prime of `S` containing
`Fitt₁(Ω[S⁄K])`. Then the maximal ideal of the local ring `S_q` is generated by two elements
`x, y` with `y² ∈ x 𝔪`, so that the chart `Spec S_q[𝔪/x]` is the whole blowup of `Spec S_q` at its
closed point, and the fibre `κ ⊗ S_q[𝔪/x]` of this blowup over the closed point is an étale
`κ`-algebra of dimension two. -/
theorem exists_etale_tensor_affineBlowup_of_formallyUnramified (P : Presentation K S ι σ)
    (hP : Fintype.card σ + 1 = Fintype.card ι) (q : Ideal S) [q.IsPrime]
    (hq : fittingIdeal S Ω[S⁄K] 1 ≤ q) :
    ∃ x y : Localization.AtPrime q, maximalIdeal (Localization.AtPrime q) = Ideal.span {x, y} ∧
      y ^ 2 ∈ Ideal.span {x} * maximalIdeal (Localization.AtPrime q) ∧
      Module.finrank (ResidueField (Localization.AtPrime q))
        (ResidueField (Localization.AtPrime q) ⊗[Localization.AtPrime q]
          (maximalIdeal (Localization.AtPrime q)).affineBlowup x (Localization.Away x)) = 2 ∧
      Algebra.Etale (ResidueField (Localization.AtPrime q))
        (ResidueField (Localization.AtPrime q) ⊗[Localization.AtPrime q]
          (maximalIdeal (Localization.AtPrime q)).affineBlowup x (Localization.Away x)) := by
  obtain ⟨s₀, _, y, b', _, hy, hb', hf2, hH, φ, -⟩ :=
    P.exists_hypersurface_presentation_of_formallyUnramified hP q hq
      (Localization.AtPrime (q.comap (algebraMap P.Ring S)))
  exact exists_etale_tensor_affineBlowup_of_algEquiv b' hy hb' hf2 hH φ

end Algebra.Presentation
