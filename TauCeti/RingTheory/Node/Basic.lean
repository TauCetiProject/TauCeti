/-!
# Smooth coordinate charts of the nodal equation

The algebra `NodeAlgebra R a = R[x,y]/(xy-a)` is the local model for smoothing a node.
Inverting either coordinate gives a standard smooth algebra of relative dimension one.
Consequently a prime at which at least one coordinate is nonzero belongs to the smooth
locus. These assertions hold over any commutative base ring.

For a discrete valuation ring and `a = πⁿ`, this supplies the smooth charts away from
the origin in the local model used to resolve nodal curves.

## References

* Stacks Project, Example 55.14.1, Tag 0CDC.
-/

public section

noncomputable section

namespace TauCeti

open MvPolynomial Algebra

/-- The coordinate algebra of the equation `xy = a` over `R`. -/
def NodeAlgebra (R : Type*) [CommRing R] (a : R) :=
  MvPolynomial (Fin 2) R ⧸ Ideal.span {X 0 * X 1 - C a}

namespace NodeAlgebra

variable {R : Type*} [CommRing R] (a : R)

instance : CommRing (NodeAlgebra R a) :=
  inferInstanceAs (CommRing (MvPolynomial (Fin 2) R ⧸ Ideal.span {X 0 * X 1 - C a}))

instance {S : Type*} [CommSemiring S] [Algebra S R] : Algebra S (NodeAlgebra R a) :=
  inferInstanceAs (Algebra S (MvPolynomial (Fin 2) R ⧸ Ideal.span {X 0 * X 1 - C a}))

instance {S T : Type*} [SMul S T] [CommSemiring S] [CommSemiring T]
    [Algebra S R] [Algebra T R] [IsScalarTower S T R] :
    IsScalarTower S T (NodeAlgebra R a) :=
  inferInstanceAs (IsScalarTower S T (MvPolynomial (Fin 2) R ⧸ Ideal.span {X 0 * X 1 - C a}))

/-- The quotient algebra map from polynomials to the nodal algebra. -/
def mk : MvPolynomial (Fin 2) R →ₐ[R] NodeAlgebra R a :=
  Ideal.Quotient.mkₐ R _

/-- Every element of the nodal algebra is represented by a polynomial. -/
lemma mk_surjective : Function.Surjective (mk a) :=
  Ideal.Quotient.mk_surjective

/-- The kernel of the quotient map is generated by the nodal equation. -/
@[simp]
lemma ker_mk : RingHom.ker (mk a : MvPolynomial (Fin 2) R →+* NodeAlgebra R a) =
    Ideal.span {X 0 * X 1 - C a} :=
  Ideal.mk_ker

/-- The two coordinate functions on `xy = a`. -/
def coord (i : Fin 2) : NodeAlgebra R a :=
  mk a (X i)

/-- The quotient map sends each polynomial variable to its coordinate function. -/
@[simp]
lemma mk_X (i : Fin 2) :
    mk a (X i) = coord a i := (rfl)

/-- The defining equation of the nodal algebra. -/
@[simp]
lemma coord_zero_mul_coord_one :
    coord a 0 * coord a 1 = algebraMap R (NodeAlgebra R a) a := by
  have h : mk a (X 0 * X 1 - C a) = 0 := by
    apply (RingHom.mem_ker (f := (mk a).toRingHom)).mp
    rw [AlgHom.toRingHom_eq_coe, ker_mk]
    exact Ideal.subset_span (Set.mem_singleton _)
  simpa only [map_sub, map_mul, mk_X, sub_eq_zero, ← algebraMap_eq,
    AlgHom.commutes] using h

private lemma aeval_eq_zero_of_mem {A : Type*} [CommSemiring A] [Algebra R A] (x y : A)
    (h : x * y = algebraMap R A a) (p : MvPolynomial (Fin 2) R)
    (hp : p ∈ Ideal.span {X 0 * X 1 - C a}) : aeval ![x, y] p = 0 := by
  have hker : Ideal.span {X (0 : Fin 2) * X 1 - C a} ≤
      RingHom.ker (aeval ![x, y]).toRingHom := by
    rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
    simp only [sub_eq_add_neg, ← map_neg C, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
      map_add, map_mul, aeval_X, aeval_C, Matrix.cons_val_zero,
      Matrix.cons_val_one, h]
    rw [← map_add, add_neg_cancel, map_zero]
  exact RingHom.mem_ker.mp (hker hp)

/-- Evaluate the nodal algebra at two elements satisfying its defining equation. -/
def lift {A : Type*} [CommSemiring A] [Algebra R A] (x y : A)
    (h : x * y = algebraMap R A a) : NodeAlgebra R a →ₐ[R] A :=
  Ideal.Quotient.liftₐ _ (aeval ![x, y]) (aeval_eq_zero_of_mem a x y h)

/-- Evaluation on a polynomial representative is polynomial evaluation at the two elements. -/
@[simp]
lemma lift_mk {A : Type*} [CommSemiring A] [Algebra R A] (x y : A)
    (h : x * y = algebraMap R A a) (p : MvPolynomial (Fin 2) R) :
    lift a x y h (mk a p) = aeval ![x, y] p :=
  AlgHom.congr_fun (Ideal.Quotient.liftₐ_comp _ _ (aeval_eq_zero_of_mem a x y h)) p

/-- Evaluation sends the first coordinate to the chosen first element. -/
lemma lift_coord_zero {A : Type*} [CommSemiring A] [Algebra R A] (x y : A)
    (h : x * y = algebraMap R A a) : lift a x y h (coord a 0) = x := by
  simp only [coord, lift_mk, aeval_X, Matrix.cons_val_zero]

/-- Evaluation sends the second coordinate to the chosen second element. -/
lemma lift_coord_one {A : Type*} [CommSemiring A] [Algebra R A] (x y : A)
    (h : x * y = algebraMap R A a) : lift a x y h (coord a 1) = y := by
  simp only [coord, lift_mk, aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero]

/-- The defining equation `xy = a`, written for either coordinate and the other one. -/
lemma coord_mul_coord_one_sub (i : Fin 2) :
    coord a i * coord a (1 - i) = algebraMap R (NodeAlgebra R a) a := by
  fin_cases i
  · exact coord_zero_mul_coord_one a
  · exact (mul_comm _ _).trans (coord_zero_mul_coord_one a)

/-- Evaluation sends each coordinate to the corresponding chosen element. -/
@[simp]
lemma lift_coord {A : Type*} [CommSemiring A] [Algebra R A] (x y : A)
    (h : x * y = algebraMap R A a) (i : Fin 2) : lift a x y h (coord a i) = ![x, y] i := by
  rw [← mk_X, lift_mk, aeval_X]

/-- Algebra maps out of the nodal algebra are determined by the two coordinates. -/
@[ext]
lemma hom_ext {A : Type*} [Semiring A] [Algebra R A]
    {f g : NodeAlgebra R a →ₐ[R] A}
    (h₀ : f (coord a 0) = g (coord a 0))
    (h₁ : f (coord a 1) = g (coord a 1)) : f = g := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i
  · exact h₀
  · exact h₁

/-- Equivalence between `R`-algebra homomorphisms `NodeAlgebra R a →ₐ[R] A` and pairs `(x, y)`
in `A` with `x * y = algebraMap R A a`. -/
def liftEquiv (A : Type*) [CommSemiring A] [Algebra R A] :
    (NodeAlgebra R a →ₐ[R] A) ≃ { p : A × A // p.1 * p.2 = algebraMap R A a } where
  toFun f := ⟨(f (coord a 0), f (coord a 1)), by
    rw [← map_mul, coord_zero_mul_coord_one, AlgHom.commutes]⟩
  invFun p := lift a p.val.1 p.val.2 p.property
  left_inv f := hom_ext a (lift_coord_zero a _ _ _) (lift_coord_one a _ _ _)
  right_inv p := Subtype.ext (Prod.ext (lift_coord_zero a _ _ _) (lift_coord_one a _ _ _))

@[simp] lemma liftEquiv_apply_fst {A : Type*} [CommSemiring A] [Algebra R A]
    (f : NodeAlgebra R a →ₐ[R] A) : ((liftEquiv a A f : A × A).1) = f (coord a 0) := (rfl)

@[simp] lemma liftEquiv_apply_snd {A : Type*} [CommSemiring A] [Algebra R A]
    (f : NodeAlgebra R a →ₐ[R] A) : ((liftEquiv a A f : A × A).2) = f (coord a 1) := (rfl)

@[simp] lemma liftEquiv_symm_apply {A : Type*} [CommSemiring A] [Algebra R A]
    (p : { p : A × A // p.1 * p.2 = algebraMap R A a }) :
    (liftEquiv a A).symm p = lift a p.val.1 p.val.2 p.property := (rfl)

/-- Ring homomorphisms out of the nodal algebra are determined by `R` and the two coordinates. -/
lemma ringHom_ext {A : Type*} [Semiring A] {q : R} {f g : NodeAlgebra R q →+* A}
    (hR : ∀ r : R, f (algebraMap R (NodeAlgebra R q) r) = g (algebraMap R (NodeAlgebra R q) r))
    (h₀ : f (coord q 0) = g (coord q 0)) (h₁ : f (coord q 1) = g (coord q 1)) : f = g := by
  refine Ideal.Quotient.ringHom_ext (MvPolynomial.ringHom_ext (fun r ↦ ?_) (fun i ↦ ?_))
  · have h := hR r; rwa [← (mk q).commutes r, MvPolynomial.algebraMap_eq] at h
  · fin_cases i <;> [exact h₀; exact h₁]

/-- Two `k`-algebra homomorphisms out of `NodeAlgebra B q` agree when they agree on `B`,
`coord q 0`, and `coord q 1`. -/
lemma algHom_ext_of_algebra {k B C : Type*} [CommSemiring k] [CommRing B] [Semiring C]
    [Algebra k B] [Algebra k C] {q : B} {f g : NodeAlgebra B q →ₐ[k] C}
    (hB : ∀ b : B, f (algebraMap B (NodeAlgebra B q) b) = g (algebraMap B (NodeAlgebra B q) b))
    (h0 : f (coord q 0) = g (coord q 0)) (h1 : f (coord q 1) = g (coord q 1)) : f = g :=
  AlgHom.toRingHom_injective (ringHom_ext hB h0 h1)

/-- Universal property of `NodeAlgebra R q` for ring homomorphisms: a ring map `φ : R →+* C` and
elements `x, y : C` satisfying `x * y = φ q` determine a unique ring homomorphism
`NodeAlgebra R q →+* C`. -/
def liftRingHom {C : Type*} [CommSemiring C] {q : R} (φ : R →+* C) (x y : C)
    (hxy : x * y = φ q) : NodeAlgebra R q →+* C :=
  letI : Algebra R C := φ.toAlgebra; (lift q x y hxy).toRingHom

/-- `liftRingHom` restricts on scalars to the given coefficient ring homomorphism. -/
@[simp] lemma liftRingHom_algebraMap {C : Type*} [CommSemiring C] {q : R} (φ : R →+* C)
    (x y : C) (hxy : x * y = φ q) (r : R) :
    liftRingHom φ x y hxy (algebraMap R (NodeAlgebra R q) r) = φ r := by
  let _ : Algebra R C := φ.toAlgebra; exact (lift q x y hxy).commutes r

/-- `liftRingHom` sends each coordinate to the corresponding chosen element. -/
@[simp] lemma liftRingHom_coord {C : Type*} [CommSemiring C] {q : R} (φ : R →+* C) (x y : C)
    (hxy : x * y = φ q) (i : Fin 2) : liftRingHom φ x y hxy (coord q i) = ![x, y] i := by
  let _ : Algebra R C := φ.toAlgebra; exact lift_coord q x y hxy i

/-- Functorial ring homomorphism `NodeAlgebra R q →+* NodeAlgebra S q'` along a ring homomorphism
`φ : R →+* S` sending `q` to `q'`. -/
def mapRingHom {S : Type*} [CommRing S] (φ : R →+* S) {q : R} {q' : S} (hq : φ q = q') :
    NodeAlgebra R q →+* NodeAlgebra S q' :=
  liftRingHom ((algebraMap S (NodeAlgebra S q')).comp φ) (coord q' 0) (coord q' 1) (by simp [hq])

/-- `mapRingHom` acts on constants via the underlying coefficient ring homomorphism. -/
@[simp] lemma mapRingHom_algebraMap {S : Type*} [CommRing S] (φ : R →+* S) {q : R} {q' : S}
    (hq : φ q = q') (r : R) :
    mapRingHom φ hq (algebraMap R (NodeAlgebra R q) r) = algebraMap S (NodeAlgebra S q') (φ r) :=
  liftRingHom_algebraMap _ _ _ _ r

/-- `mapRingHom` preserves each nodal coordinate. -/
@[simp] lemma mapRingHom_coord {S : Type*} [CommRing S] (φ : R →+* S) {q : R} {q' : S}
    (hq : φ q = q') (i : Fin 2) : mapRingHom φ hq (coord q i) = coord q' i := by
  fin_cases i <;> simp [mapRingHom]

/-- `mapRingHom` along the identity ring homomorphism is the identity. -/
@[simp] lemma mapRingHom_id (q : R) :
    mapRingHom (RingHom.id R) (rfl : RingHom.id R q = q) = RingHom.id _ :=
  ringHom_ext (fun _ ↦ by simp) (by simp) (by simp)

/-- Composition of `mapRingHom` along composable coefficient ring homomorphisms. -/
lemma mapRingHom_comp {S T : Type*} [CommRing S] [CommRing T] (ψ : S →+* T) (φ : R →+* S)
    {q : R} {q' : S} {q'' : T} (hq : φ q = q') (hq' : ψ q' = q'') :
    (mapRingHom ψ hq').comp (mapRingHom φ hq) =
      mapRingHom (ψ.comp φ) (by rw [RingHom.comp_apply, hq, hq']) :=
  ringHom_ext (fun _ ↦ by simp) (by simp) (by simp)

section MapAlg

variable {k B B' : Type*} [CommSemiring k] [CommRing B] [CommRing B'] [Algebra k B] [Algebra k B']

/-- Functorial `k`-algebra homomorphism `NodeAlgebra B q →ₐ[k] NodeAlgebra B' q'` along a
`k`-algebra homomorphism `φ : B →ₐ[k] B'` sending `q` to `q'`. -/
def mapAlgHom (φ : B →ₐ[k] B') {q : B} {q' : B'} (hq : φ q = q') :
    NodeAlgebra B q →ₐ[k] NodeAlgebra B' q' where
  toRingHom := mapRingHom φ.toRingHom hq
  commutes' r := by
    simp [IsScalarTower.algebraMap_apply k B (NodeAlgebra B q),
      IsScalarTower.algebraMap_apply k B' (NodeAlgebra B' q')]

@[simp] lemma toRingHom_mapAlgHom (φ : B →ₐ[k] B') {q : B} {q' : B'} (hq : φ q = q') :
    (mapAlgHom φ hq : NodeAlgebra B q →+* NodeAlgebra B' q') =
      mapRingHom φ.toRingHom hq := (rfl)

@[simp] lemma mapAlgHom_algebraMap (φ : B →ₐ[k] B') {q : B} {q' : B'} (hq : φ q = q')
    (b : B) :
    mapAlgHom φ hq (algebraMap B (NodeAlgebra B q) b) =
      algebraMap B' (NodeAlgebra B' q') (φ b) := mapRingHom_algebraMap φ.toRingHom hq b

@[simp] lemma mapAlgHom_coord (φ : B →ₐ[k] B') {q : B} {q' : B'} (hq : φ q = q') (i : Fin 2) :
    mapAlgHom φ hq (coord q i) = coord q' i := mapRingHom_coord φ.toRingHom hq i

@[simp] lemma mapAlgHom_id (q : B) :
    mapAlgHom (AlgHom.id k B) (rfl : AlgHom.id k B q = q) = AlgHom.id k (NodeAlgebra B q) :=
  AlgHom.toRingHom_injective (mapRingHom_id q)

lemma mapAlgHom_comp {B'' : Type*} [CommRing B''] [Algebra k B''] (ψ : B' →ₐ[k] B'')
    (φ : B →ₐ[k] B') {q : B} {q' : B'} {q'' : B''} (hq : φ q = q') (hq' : ψ q' = q'') :
    (mapAlgHom ψ hq').comp (mapAlgHom φ hq) =
      mapAlgHom (ψ.comp φ) (by rw [AlgHom.comp_apply, hq, hq']) :=
  AlgHom.toRingHom_injective (mapRingHom_comp ψ.toRingHom φ.toRingHom hq hq')

/-- Functorial `k`-algebra equivalence `NodeAlgebra B q ≃ₐ[k] NodeAlgebra B' q'` along a
`k`-algebra equivalence `φ : B ≃ₐ[k] B'` sending `q` to `q'`. -/
def mapAlgEquiv (φ : B ≃ₐ[k] B') {q : B} {q' : B'} (hq : φ q = q') :
    NodeAlgebra B q ≃ₐ[k] NodeAlgebra B' q' :=
  AlgEquiv.ofAlgHom (mapAlgHom (φ : B →ₐ[k] B') (by simpa using hq))
    (mapAlgHom (φ.symm : B' →ₐ[k] B) (by simpa using φ.symm_apply_eq.mpr hq.symm))
    (algHom_ext_of_algebra (fun _ ↦ by simp) (by simp) (by simp))
    (algHom_ext_of_algebra (fun _ ↦ by simp) (by simp) (by simp))

@[simp] lemma mapAlgEquiv_apply (φ : B ≃ₐ[k] B') {q : B} {q' : B'} (hq : φ q = q')
    (u : NodeAlgebra B q) : mapAlgEquiv φ hq u = mapRingHom φ.toRingHom (by simpa using hq) u :=
  AlgEquiv.ofAlgHom_apply _ _ _ _ u

@[simp] lemma mapAlgEquiv_symm (φ : B ≃ₐ[k] B') {q : B} {q' : B'} (hq : φ q = q') :
    (mapAlgEquiv φ hq).symm = mapAlgEquiv φ.symm (φ.symm_apply_eq.mpr hq.symm) :=
  AlgEquiv.ext fun u ↦ AlgEquiv.ofAlgHom_symm_apply _ _ _ _ u

@[simp] lemma mapAlgEquiv_refl (q : B) :
    mapAlgEquiv (AlgEquiv.refl : B ≃ₐ[k] B) (rfl : (AlgEquiv.refl : B ≃ₐ[k] B) q = q) =
      AlgEquiv.refl :=
  AlgEquiv.ext fun u ↦ (mapAlgEquiv_apply _ _ u).trans <| (RingHom.congr_fun
    (ringHom_ext (g := RingHom.id _) (fun _ ↦ by simp) (by simp) (by simp)) u).trans
    (congrFun AlgEquiv.coe_refl u).symm

lemma mapAlgEquiv_trans {B'' : Type*} [CommRing B''] [Algebra k B''] (φ : B ≃ₐ[k] B')
    (ψ : B' ≃ₐ[k] B'') {q : B} {q' : B'} {q'' : B''} (hq : φ q = q') (hq' : ψ q' = q'') :
    (mapAlgEquiv φ hq).trans (mapAlgEquiv ψ hq') =
      mapAlgEquiv (φ.trans ψ) (by rw [AlgEquiv.trans_apply, hq, hq']) :=
  AlgEquiv.ext fun u ↦ by
    simp [AlgEquiv.trans_apply, mapAlgEquiv_apply, ← RingHom.comp_apply, mapRingHom_comp]

end MapAlg

/-- The two coordinates generate the nodal algebra as an `R`-algebra. -/
lemma adjoin_range_coord : Algebra.adjoin R (Set.range (coord a)) = ⊤ := by
  have h : Set.range (coord a) = mk a '' Set.range X := by
    rw [← Set.range_comp]
    exact congrArg Set.range (funext fun i ↦ (mk_X a i).symm)
  rw [h, ← AlgHom.map_adjoin, MvPolynomial.adjoin_range_X, Algebra.map_top, AlgHom.range_eq_top]
  exact mk_surjective a

/-- The presentation of `R[x, y] ⧸ (xy - a)` by its two coordinates and the single relation
`xy - a`. -/
def presentation : Presentation R (NodeAlgebra R a) (Fin 2) Unit :=
  (Presentation.naive (v := fun _ : Unit ↦ X 0 * X 1 - C a)).ofAlgEquiv
    (Ideal.quotientEquivAlgOfEq R (by simp))

/-- The single relation of `NodeAlgebra.presentation` is `xy - a`. -/
@[simp]
lemma presentation_relation (r : Unit) : (presentation a).relation r = X 0 * X 1 - C a :=
  (Presentation.ofAlgEquiv_relation _ _ r).trans (Presentation.naive_relation_apply _ _ r)

/-- The nodal equation is an algebra of finite presentation over its coefficient ring. -/
instance : FinitePresentation R (NodeAlgebra R a) :=
  (presentation a).finitePresentation_of_isFinite

private def prePresentation (i : Fin 2) :
    PreSubmersivePresentation R (NodeAlgebra R a) (Fin 2) Unit where
  __ := presentation a
  map _ := 1 - i
  map_inj := Function.injective_of_subsingleton _

private lemma prePresentation_jacobian (i : Fin 2) :
    (prePresentation a i).jacobian = coord a i := by
  rw [PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, Matrix.det_unique]
  rw [PreSubmersivePresentation.jacobiMatrix_apply, Generators.algebraMap_apply]
  -- Identify the fields of the local `prePresentation` wrapper, which has no projection API.
  change aeval (presentation a).val
    (pderiv (1 - i) ((presentation a).relation ())) = coord a i
  have hderiv : pderiv (1 - i) (X 0 * X 1 - C a) = X i := by
    fin_cases i
    -- Normalize the two closed `Fin 2` subtractions before applying the derivative lemmas.
    · change pderiv 1 (X 0 * X 1 - C a) = X 0
      simp only [map_sub, pderiv_mul, pderiv_X_of_ne (by decide : (0 : Fin 2) ≠ 1),
        pderiv_X_self, pderiv_C, zero_mul, mul_one, zero_add, sub_zero]
    · change pderiv 0 (X 0 * X 1 - C a) = X 1
      simp only [map_sub, pderiv_mul, pderiv_X_of_ne (by decide : (1 : Fin 2) ≠ 0),
        pderiv_X_self, pderiv_C, one_mul, mul_zero, add_zero, sub_zero]
  rw [presentation_relation, hderiv, aeval_X]
  -- Identify the generator of the local presentation with its transported quotient class.
  change (Ideal.quotientEquivAlgOfEq R _)
    (Ideal.Quotient.mk _ (X i)) = coord a i
  rw [Ideal.quotientEquivAlgOfEq_mk]
  rfl

/-- Each coordinate chart of `xy = a` is standard smooth of relative dimension one. -/
theorem isStandardSmoothOfRelativeDimension_localizationAway_coord (i : Fin 2) :
    IsStandardSmoothOfRelativeDimension 1 R (Localization.Away (coord a i)) := by
  have : IsLocalization.Away (prePresentation a i).jacobian
      (Localization.Away (coord a i)) := by
    rw [prePresentation_jacobian]
    infer_instance
  simpa [Presentation.dimension] using
    (prePresentation a i).isStandardSmoothOfRelativeDimension_localizationAway
      (Localization.Away (coord a i))

/-- The complement of either coordinate's zero locus lies in the smooth locus of `xy = a`. -/
theorem basicOpen_coord_subset_smoothLocus (i : Fin 2) :
    (PrimeSpectrum.basicOpen (coord a i) : Set (PrimeSpectrum (NodeAlgebra R a))) ⊆
      Algebra.smoothLocus R (NodeAlgebra R a) := by
  have := (isStandardSmoothOfRelativeDimension_localizationAway_coord a i).isStandardSmooth
  exact Algebra.basicOpen_subset_smoothLocus_iff_smooth.mpr inferInstance

/-- A point of `xy = a` is smooth whenever at least one coordinate is outside its prime ideal. -/
theorem isSmoothAt_of_coord_notMem (p : Ideal (NodeAlgebra R a)) [p.IsPrime]
    (h : ∃ i, coord a i ∉ p) : Algebra.IsSmoothAt R p := by
  obtain ⟨i, hi⟩ := h
  exact basicOpen_coord_subset_smoothLocus a i
    ((PrimeSpectrum.mem_basicOpen _ ⟨p, inferInstance⟩).mpr hi)

/-- If the smoothing parameter is invertible, the whole nodal algebra is standard smooth
of relative dimension one. This includes `xy = 1` and `xy = a` over a field with `a ≠ 0`. -/
theorem isStandardSmoothOfRelativeDimension_of_isUnit (ha : IsUnit a) :
    IsStandardSmoothOfRelativeDimension 1 R (NodeAlgebra R a) := by
  have hx : IsUnit (coord a 0) := by
    have h := ha.map (algebraMap R (NodeAlgebra R a))
    rw [← coord_zero_mul_coord_one] at h
    exact isUnit_of_mul_isUnit_left h
  let P : SubmersivePresentation R (NodeAlgebra R a) (Fin 2) Unit :=
    { prePresentation a 0 with
      jacobian_isUnit := by rwa [prePresentation_jacobian] }
  exact P.isStandardSmoothOfRelativeDimension (by simp [Presentation.dimension])

end NodeAlgebra

end TauCeti
