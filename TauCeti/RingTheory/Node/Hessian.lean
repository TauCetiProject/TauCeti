module

public import TauCeti.RingTheory.Kaehler.Hypersurface
public import TauCeti.RingTheory.LocalRing.Hessian
public import TauCeti.RingTheory.Unramified.LocalRing

/-!
# The quadratic part of a hypersurface at a node

Let `P` be a local `K`-algebra with coordinates `x : ι → P` generating its maximal ideal `𝔪`,
whose differentials `dxᵢ` form a basis of `Ω[P⁄K]`: for instance the local ring of a smooth
surface at a point, with coordinates centred there. Let `f ∈ 𝔪`, so that `A = P ⧸ (f)` is the
local ring at a point of the hypersurface `f = 0`. With `n = |ι|`, the singular locus of `A` is
cut out by the `(n - 1)`-st Fitting ideal of `Ω[A⁄K]`, which is generated by the partial
derivatives `∂f/∂xᵢ` (`TauCeti.fittingIdeal_kaehlerDifferential_quotient_span_singleton`).

The scheme-theoretic criterion for a node asks that this singular locus be unramified over `K`
and pass through the closed point. This file shows that it forces the quadratic part of `f` to
be nondegenerate: `f ∈ 𝔪²`, and the Hessian determinant `det (∂²f/∂xᵢ∂xⱼ)` is a unit. More
precisely, the singular locus is the reduced closed point exactly when these two conditions hold.
For a plane curve, `n = 2`, and writing `f = a s² + b s t + c t²` with `a, b, c ∈ P`, the
second condition says that the discriminant `b² - 4ac` is a unit
(`TauCeti.isUnit_det_hessian_iff_isUnit_discrim`). Geometrically, the quadratic part of `f` then
cuts out two distinct lines in the tangent plane, possibly conjugate over a separable quadratic
extension of the residue field; they are the tangent directions of the two branches through the
node, which this file does not construct.

## Main results

* `TauCeti.comap_fittingIdeal_kaehlerDifferential_eq_maximalIdeal_iff`: the singular locus of the
  hypersurface `f = 0` is the reduced closed point exactly when `f ∈ 𝔪²` and the Hessian
  determinant of `f` is a unit.
* `TauCeti.mem_maximalIdeal_sq_and_isUnit_det_hessian_of_formallyUnramified`: over a field, if
  the singular locus of `f = 0` is unramified and contains the closed point, then `f ∈ 𝔪²` and
  the Hessian determinant of `f` is a unit.

## References

* [Stacks Project, Section 53.19, Tag 0C46](https://stacks.math.columbia.edu/tag/0C46): nodes of
  curves, defined by a nondegenerate quadratic form in two variables.
* [Stacks Project, Lemma 53.20.1, Tag 0C58](https://stacks.math.columbia.edu/tag/0C58): the
  singular-locus criterion for families of nodal curves.
-/

public section

noncomputable section

open IsLocalRing KaehlerDifferential

namespace TauCeti

variable {K P ι : Type*} [CommRing P] [IsLocalRing P] [Fintype ι] [DecidableEq ι] [Nonempty ι]
  {x : ι → P} {f : P}

/-- **The singular locus of a hypersurface at an ordinary double point.** If the differentials
`dxᵢ` of coordinates generating `𝔪` form a basis of `Ω[P⁄K]`, and `f ∈ 𝔪`, then the singular locus
of `P ⧸ (f)`, cut out by the `(|ι| - 1)`-st Fitting ideal of its differentials, is the reduced
closed point exactly when `f ∈ 𝔪²` and the Hessian determinant of `f` is a unit. -/
theorem comap_fittingIdeal_kaehlerDifferential_eq_maximalIdeal_iff [CommRing K] [Algebra K P]
    [Module.Finite (P ⧸ Ideal.span {f}) Ω[(P ⧸ Ideal.span {f})⁄K]]
    (b : Module.Basis ι P Ω[P⁄K]) (hx : maximalIdeal P = Ideal.span (Set.range x))
    (hb : ∀ i, b i = D K P (x i)) (hf : f ∈ maximalIdeal P) :
    (fittingIdeal (P ⧸ Ideal.span {f}) Ω[(P ⧸ Ideal.span {f})⁄K] (Fintype.card ι - 1)).comap
        (Ideal.Quotient.mk _) = maximalIdeal P ↔
      f ∈ maximalIdeal P ^ 2 ∧ IsUnit (hessian (fun i ↦ (b.coord i).compDer (D K P)) f).det := by
  have hD (i j : ι) : (b.coord i).compDer (D K P) (x j) = if i = j then 1 else 0 := by
    simp [← hb, Finsupp.single_apply, eq_comm]
  rw [← span_range_apply_sup_span_singleton_eq_maximalIdeal_iff hx hD hf,
    fittingIdeal_kaehlerDifferential_quotient_span_singleton f b,
    Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
    Ideal.mk_ker]
  simp

/-- **The quadratic part of `f` at a node is nondegenerate.** Over a field `K`, let the
differentials `dxᵢ` of coordinates generating `𝔪` form a basis of `Ω[P⁄K]`, and let `f ∈ 𝔪`. If
the singular locus of `P ⧸ (f)` is unramified over `K` and contains the closed point, then
`f ∈ 𝔪²` and the Hessian determinant of `f` is a unit. -/
theorem mem_maximalIdeal_sq_and_isUnit_det_hessian_of_formallyUnramified [Field K] [Algebra K P]
    [Algebra.EssFiniteType K P] (b : Module.Basis ι P Ω[P⁄K])
    (hx : maximalIdeal P = Ideal.span (Set.range x))
    (hb : ∀ i, b i = D K P (x i)) (hf : f ∈ maximalIdeal P)
    [Algebra.FormallyUnramified K ((P ⧸ Ideal.span {f}) ⧸
      fittingIdeal (P ⧸ Ideal.span {f}) Ω[(P ⧸ Ideal.span {f})⁄K] (Fintype.card ι - 1))]
    (hsing : fittingIdeal (P ⧸ Ideal.span {f}) Ω[(P ⧸ Ideal.span {f})⁄K] (Fintype.card ι - 1) ≠
      ⊤) :
    f ∈ maximalIdeal P ^ 2 ∧ IsUnit (hessian (fun i ↦ (b.coord i).compDer (D K P)) f).det := by
  set I := fittingIdeal (P ⧸ Ideal.span {f}) Ω[(P ⧸ Ideal.span {f})⁄K] (Fintype.card ι - 1)
  -- The singular locus is the quotient of `P` by the preimage of `I`.
  let g : P →ₐ[K] (P ⧸ Ideal.span {f}) ⧸ I :=
    (Ideal.Quotient.mkₐ K I).comp (Ideal.Quotient.mkₐ K (Ideal.span {f}))
  have hg : Function.Surjective g :=
    Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
  have hker : RingHom.ker g = I.comap (Ideal.Quotient.mk _) := by
    ext p
    simp [g, Ideal.Quotient.eq_zero_iff_mem]
  have : Algebra.FormallyUnramified K (P ⧸ RingHom.ker g) :=
    .of_equiv (Ideal.quotientKerAlgEquivOfSurjective hg).symm
  have hne : RingHom.ker g ≠ ⊤ := by
    rw [hker]
    exact fun h ↦ hsing (Ideal.comap_eq_top_iff.1 h)
  rw [← comap_fittingIdeal_kaehlerDifferential_eq_maximalIdeal_iff b hx hb hf, ← hker]
  exact Ideal.eq_maximalIdeal_of_formallyUnramified_quotient K hne

end TauCeti
