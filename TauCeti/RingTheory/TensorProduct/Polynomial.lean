module

public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.TensorProduct.Maps
import TauCeti.Algebra.Polynomial.AlgHom

/-!
# Tensor base change along polynomial evaluation

For an `R[X]`-algebra `A` (forming a scalar tower `R → R[X] → A`, not necessarily commutative) and
a scalar `a : R`, any surjective `R`-algebra map `φ : A →ₐ[R] C` sending the parameter
`algebraMap R[X] A X` to `algebraMap R C a` whose kernel is contained in the principal ideal
generated by `algebraMap R[X] A X - algebraMap R A a` identifies the base change `R ⊗[R[X]] A`
along evaluation `R[X] → R` at `a` with `C` (`AlgHom.baseChangeEvalEquivOfSurjective`).
-/

public section

open Polynomial
open scoped TensorProduct

namespace AlgHom

variable {R A C : Type*} [CommRing R] [Ring A] [Ring C]
  [Algebra R A] [Algebra R[X] A] [IsScalarTower R R[X] A] [Algebra R C]

/-- An `R`-algebra map `φ : A →ₐ[R] C` sending `algebraMap R[X] A X` to `a` promoted to a
homomorphism over `R[X]`, where `R[X]` acts on `C` by evaluation at `a`. -/
private noncomputable def evalParamAlgHom {a : R}
    (φ : A →ₐ[R] C) (hX : φ (algebraMap R[X] A Polynomial.X) = algebraMap R C a) :
    letI := Algebra.compHom C (Polynomial.evalRingHom a)
    A →ₐ[R[X]] C :=
  letI := Algebra.compHom C (Polynomial.evalRingHom a)
  letI : IsScalarTower R R[X] C := IsScalarTower.of_algebraMap_eq fun r ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  φ.toPolynomialAlgHom (by simpa [Algebra.compHom_algebraMap_apply] using hX)

/-- The tensor base-change comparison along evaluation at `a` induced by `φ`, before proving
bijectivity. -/
private noncomputable def baseChangeEvalAlgHom {a : R}
    (φ : A →ₐ[R] C) (hX : φ (algebraMap R[X] A Polynomial.X) = algebraMap R C a) :
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    (R ⊗[R[X]] A) →ₐ[R] C :=
  letI := Algebra.compHom R (Polynomial.evalRingHom a)
  letI := Algebra.compHom C (Polynomial.evalRingHom a)
  letI : IsScalarTower R[X] R C := IsScalarTower.of_algebraMap_eq fun p ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  AlgHom.liftEquiv R[X] R A C (evalParamAlgHom φ hX)

private theorem baseChangeEvalAlgHom_tmul {a : R}
    (φ : A →ₐ[R] C) (hX : φ (algebraMap R[X] A Polynomial.X) = algebraMap R C a)
    (r : R) (x : A) :
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    baseChangeEvalAlgHom φ hX (r ⊗ₜ[R[X]] x) = r • φ x := by
  let := Algebra.compHom R (Polynomial.evalRingHom a)
  let := Algebra.compHom C (Polynomial.evalRingHom a)
  let : IsScalarTower R[X] R C := IsScalarTower.of_algebraMap_eq fun p ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  exact (AlgHom.liftEquiv_tmul (evalParamAlgHom φ hX) r x).trans (by simp [evalParamAlgHom])

private theorem baseChangeEvalAlgHom_bijective {a : R}
    (φ : A →ₐ[R] C) (hX : φ (algebraMap R[X] A Polynomial.X) = algebraMap R C a)
    (hsurj : Function.Surjective φ)
    (hker : RingHom.ker φ ≤ Ideal.span {algebraMap R[X] A Polynomial.X - algebraMap R A a}) :
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    Function.Bijective (baseChangeEvalAlgHom φ hX) := by
  let := Algebra.compHom R (Polynomial.evalRingHom a)
  let : IsScalarTower R R[X] R := IsScalarTower.of_algebraMap_eq fun r ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  let i := (Algebra.TensorProduct.includeRight : A →ₐ[R[X]] R ⊗[R[X]] A).restrictScalars R
  have hi : Function.Surjective i :=
    Algebra.TensorProduct.includeRight_surjective _ fun r ↦
      ⟨Polynomial.C r, by simp [Algebra.compHom_algebraMap_apply]⟩
  have hfi (x : A) : baseChangeEvalAlgHom φ hX (i x) = φ x :=
    (baseChangeEvalAlgHom_tmul φ hX 1 x).trans (one_smul R _)
  have hix : i (algebraMap R[X] A Polynomial.X) = algebraMap R _ a := by
    simp [i, Algebra.compHom_algebraMap_apply, Algebra.TensorProduct.algebraMap_apply]
  refine ⟨(injective_iff_map_eq_zero _).mpr fun t ht ↦ ?_, fun c ↦ ?_⟩
  · obtain ⟨x, rfl⟩ := hi t
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp
      (hker (RingHom.mem_ker.mpr ((hfi x).symm.trans ht)))
    rw [← hq, map_mul, map_sub, hix, AlgHom.commutes, sub_self, mul_zero]
  · obtain ⟨x, hx⟩ := hsurj c
    exact ⟨i x, (hfi x).trans hx⟩

/-- Tensor base change of an `R[X]`-algebra `A` along evaluation `R[X] → R` at `a` is isomorphic
to `C` for any surjective `R`-algebra map `φ : A →ₐ[R] C` sending `algebraMap R[X] A X` to `a`
whose kernel lies in `Ideal.span {algebraMap R[X] A X - algebraMap R A a}`. -/
noncomputable def baseChangeEvalEquivOfSurjective {a : R}
    (φ : A →ₐ[R] C) (hX : φ (algebraMap R[X] A Polynomial.X) = algebraMap R C a)
    (hsurj : Function.Surjective φ)
    (hker : RingHom.ker φ ≤ Ideal.span {algebraMap R[X] A Polynomial.X - algebraMap R A a}) :
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    (R ⊗[R[X]] A) ≃ₐ[R] C :=
  AlgEquiv.ofBijective _ (baseChangeEvalAlgHom_bijective φ hX hsurj hker)

/-- The base-change comparison induced by `φ` sends a pure tensor `r ⊗ x` to `r • φ x`. -/
@[simp]
theorem baseChangeEvalEquivOfSurjective_tmul {a : R}
    (φ : A →ₐ[R] C) (hX : φ (algebraMap R[X] A Polynomial.X) = algebraMap R C a)
    (hsurj : Function.Surjective φ)
    (hker : RingHom.ker φ ≤ Ideal.span {algebraMap R[X] A Polynomial.X - algebraMap R A a})
    (r : R) (x : A) :
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    φ.baseChangeEvalEquivOfSurjective hX hsurj hker (r ⊗ₜ[R[X]] x) = r • φ x := by
  let := Algebra.compHom R (Polynomial.evalRingHom a)
  rw [baseChangeEvalEquivOfSurjective, AlgEquiv.ofBijective_apply, baseChangeEvalAlgHom_tmul]

/-- The inverse base-change comparison induced by `φ` sends `φ x` to `1 ⊗ x`. -/
@[simp]
theorem baseChangeEvalEquivOfSurjective_symm_apply {a : R}
    (φ : A →ₐ[R] C) (hX : φ (algebraMap R[X] A Polynomial.X) = algebraMap R C a)
    (hsurj : Function.Surjective φ)
    (hker : RingHom.ker φ ≤ Ideal.span {algebraMap R[X] A Polynomial.X - algebraMap R A a})
    (x : A) :
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    (φ.baseChangeEvalEquivOfSurjective hX hsurj hker).symm (φ x) = 1 ⊗ₜ[R[X]] x := by
  let := Algebra.compHom R (Polynomial.evalRingHom a)
  rw [AlgEquiv.symm_apply_eq, baseChangeEvalEquivOfSurjective_tmul, one_smul]

end AlgHom
