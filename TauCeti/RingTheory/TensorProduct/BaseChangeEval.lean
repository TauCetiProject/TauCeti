module

public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.TensorProduct.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import TauCeti.Algebra.Polynomial.AlgHom
import TauCeti.RingTheory.Ideal.Operations

/-!
# Tensor base change along polynomial evaluation

For an `R[X]`-algebra `A` (forming a scalar tower `R → R[X] → A`, not necessarily commutative) and
a scalar `a : R`, the canonical map `x ↦ 1 ⊗ₜ[R[X]] x` into `R ⊗[R[X]] A` (where `R` is an
`R[X]`-algebra via evaluation at `a`) is surjective
(`Algebra.TensorProduct.includeRight_surjective_evalRingHom`) and, when `A` is a ring, has kernel
generated by `algebraMap R[X] A X - algebraMap R A a`
(`Algebra.TensorProduct.ker_includeRight_evalRingHom`). Any `R`-algebra map `φ : A →ₐ[R] C`
sending `algebraMap R[X] A X` to `algebraMap R C a` induces an `R`-algebra homomorphism
`R ⊗[R[X]] A →ₐ[R] C` (`AlgHom.baseChangeEval`), which is an isomorphism when `φ` is surjective
and its kernel is contained in `Ideal.span {algebraMap R[X] A X - algebraMap R A a}`
(`AlgHom.baseChangeEvalEquivOfSurjective`).
-/

public section

open Polynomial
open scoped TensorProduct

namespace Algebra.TensorProduct

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R[X] A]

/-- The canonical map `x ↦ 1 ⊗ₜ[R[X]] x` into the evaluation base change `R ⊗[R[X]] A` is
surjective. -/
theorem includeRight_surjective_evalRingHom (a : R) :
    letI := Algebra.compHom R (evalRingHom a)
    Function.Surjective (includeRight : A →ₐ[R[X]] R ⊗[R[X]] A) := by
  let := Algebra.compHom R (evalRingHom a)
  intro t
  simpa only [includeRight_apply, TensorProduct.mk_apply] using
    TensorProduct.mk_surjective (R := R[X]) (S := R) (M := A)
      (fun r ↦ ⟨Polynomial.C r, by simp [Algebra.compHom_algebraMap_apply]⟩) t

end Algebra.TensorProduct

namespace AlgHom

variable {R A C : Type*}

section Semiring

variable [CommSemiring R] [Semiring A] [Algebra R[X] A]
  [Semiring C] [Algebra R A] [IsScalarTower R R[X] A] [Algebra R C]
  {a : R} (φ : A →ₐ[R] C) (hX : φ (algebraMap R[X] A X) = algebraMap R C a)

/-- The base-change homomorphism `(R ⊗[R[X]] A) →ₐ[R] C` along evaluation `R[X] → R` at `a`
induced by an `R`-algebra map `φ : A →ₐ[R] C` sending `algebraMap R[X] A X` to
`algebraMap R C a`. -/
noncomputable def baseChangeEval :
    letI := Algebra.compHom R (evalRingHom a)
    (R ⊗[R[X]] A) →ₐ[R] C :=
  letI := Algebra.compHom R (evalRingHom a)
  letI := Algebra.compHom C (evalRingHom a)
  letI : IsScalarTower R R[X] C := IsScalarTower.of_algebraMap_eq fun r ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  letI : IsScalarTower R[X] R C := IsScalarTower.of_algebraMap_eq fun p ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  AlgHom.liftEquiv R[X] R A C
    (φ.toPolynomialAlgHom (by simpa [Algebra.compHom_algebraMap_apply] using hX))

/-- The base-change homomorphism induced by `φ` sends a pure tensor `r ⊗ x` to `r • φ x`. -/
@[simp]
theorem baseChangeEval_tmul (r : R) (x : A) :
    letI := Algebra.compHom R (evalRingHom a)
    φ.baseChangeEval hX (r ⊗ₜ[R[X]] x) = r • φ x := by
  let := Algebra.compHom R (evalRingHom a)
  let := Algebra.compHom C (evalRingHom a)
  let : IsScalarTower R R[X] C := IsScalarTower.of_algebraMap_eq fun r ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  let : IsScalarTower R[X] R C := IsScalarTower.of_algebraMap_eq fun p ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  rw [baseChangeEval, AlgHom.liftEquiv_tmul, AlgHom.toPolynomialAlgHom_apply]

/-- The base-change homomorphism induced by `φ` is surjective if and only if `φ` is surjective. -/
theorem baseChangeEval_surjective_iff :
    letI := Algebra.compHom R (evalRingHom a)
    Function.Surjective (φ.baseChangeEval hX) ↔ Function.Surjective φ := by
  let := Algebra.compHom R (evalRingHom a)
  refine ⟨fun h c ↦ ?_, fun h c ↦ ?_⟩
  · obtain ⟨t, rfl⟩ := h c
    obtain ⟨x, rfl⟩ := Algebra.TensorProduct.includeRight_surjective_evalRingHom (A := A) a t
    exact ⟨x, by rw [Algebra.TensorProduct.includeRight_apply, baseChangeEval_tmul, one_smul]⟩
  · obtain ⟨x, rfl⟩ := h c
    exact ⟨1 ⊗ₜ[R[X]] x, by rw [baseChangeEval_tmul, one_smul]⟩

end Semiring

end AlgHom

namespace Algebra.TensorProduct

/-- The canonical map `x ↦ 1 ⊗ₜ[R[X]] x` into the evaluation base change `R ⊗[R[X]] A` has kernel
generated by `algebraMap R[X] A X - algebraMap R A a`. -/
theorem ker_includeRight_evalRingHom {R A : Type*} [CommRing R] [Ring A]
    [Algebra R A] [Algebra R[X] A] [IsScalarTower R R[X] A] (a : R) :
    letI := Algebra.compHom R (evalRingHom a)
    RingHom.ker (includeRight : A →ₐ[R[X]] R ⊗[R[X]] A) =
      Ideal.span {algebraMap R[X] A X - algebraMap R A a} := by
  let := Algebra.compHom R (evalRingHom a)
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.span_le.mpr ?_)
  · let I : Ideal A := Ideal.span {algebraMap R[X] A X - algebraMap R A a}
    have : I.IsTwoSided := Ideal.isTwoSided_span_of_subset_center <|
      Set.singleton_subset_iff.mpr <| Semigroup.mem_center_iff.mpr fun b ↦ by
        rw [mul_sub, sub_mul, Algebra.commutes, Algebra.commutes]
    have hmk : (Ideal.Quotient.mkₐ R I) (algebraMap R[X] A X) = algebraMap R (A ⧸ I) a := by
      rw [← sub_eq_zero, ← AlgHom.commutes (Ideal.Quotient.mkₐ R I) a, ← map_sub,
        Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span rfl
    have ht0 : (1 ⊗ₜ[R[X]] x : R ⊗[R[X]] A) = 0 := by
      simpa [includeRight_apply] using RingHom.mem_ker.mp hx
    have h0 := congrArg ((Ideal.Quotient.mkₐ R I).baseChangeEval hmk) ht0
    rwa [AlgHom.baseChangeEval_tmul, one_smul, map_zero, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem] at h0
  · rintro _ (rfl : _ = algebraMap R[X] A X - algebraMap R A a)
    let : IsScalarTower R R[X] R := IsScalarTower.of_algebraMap_eq fun r ↦ by
      simp [Algebra.compHom_algebraMap_apply]
    let i := (includeRight : A →ₐ[R[X]] R ⊗[R[X]] A).restrictScalars R
    change i (algebraMap R[X] A X - algebraMap R A a) = 0
    have hix : i (algebraMap R[X] A X) = algebraMap R _ a := by
      simp [i, Algebra.compHom_algebraMap_apply, algebraMap_apply]
    rw [map_sub, hix, AlgHom.commutes, sub_self]

end Algebra.TensorProduct

namespace AlgHom

section Ring

variable {R A C : Type*} [CommRing R] [Ring A] [Semiring C]
  [Algebra R A] [Algebra R[X] A] [IsScalarTower R R[X] A] [Algebra R C]
  {a : R} (φ : A →ₐ[R] C) (hX : φ (algebraMap R[X] A X) = algebraMap R C a)

/-- The base-change homomorphism induced by `φ` is injective if and only if `RingHom.ker φ` is
contained in the principal ideal generated by `algebraMap R[X] A X - algebraMap R A a`. -/
theorem baseChangeEval_injective_iff :
    letI := Algebra.compHom R (evalRingHom a)
    Function.Injective (φ.baseChangeEval hX) ↔
      RingHom.ker φ ≤ Ideal.span {algebraMap R[X] A X - algebraMap R A a} := by
  let := Algebra.compHom R (evalRingHom a)
  rw [← Algebra.TensorProduct.ker_includeRight_evalRingHom (R := R) (A := A) a,
    injective_iff_map_eq_zero]
  refine ⟨fun hinj x hx ↦ ?_, fun hker t ht ↦ ?_⟩
  · rw [RingHom.mem_ker, Algebra.TensorProduct.includeRight_apply]
    exact hinj _ (by simpa [baseChangeEval_tmul] using RingHom.mem_ker.mp hx)
  · obtain ⟨x, rfl⟩ := Algebra.TensorProduct.includeRight_surjective_evalRingHom (A := A) a t
    exact hker (by simpa [RingHom.mem_ker, Algebra.TensorProduct.includeRight_apply] using ht)

variable (hsurj : Function.Surjective φ)
  (hker : RingHom.ker φ ≤ Ideal.span {algebraMap R[X] A X - algebraMap R A a})

/-- Tensor base change of an `R[X]`-algebra `A` along evaluation `R[X] → R` at `a` is isomorphic
to `C` for any surjective `R`-algebra map `φ : A →ₐ[R] C` sending `algebraMap R[X] A X` to `a`
whose kernel lies in `Ideal.span {algebraMap R[X] A X - algebraMap R A a}`. -/
noncomputable def baseChangeEvalEquivOfSurjective :
    letI := Algebra.compHom R (evalRingHom a)
    (R ⊗[R[X]] A) ≃ₐ[R] C :=
  letI := Algebra.compHom R (evalRingHom a)
  AlgEquiv.ofBijective (φ.baseChangeEval hX)
    (⟨(φ.baseChangeEval_injective_iff hX).mpr hker,
      (φ.baseChangeEval_surjective_iff hX).mpr hsurj⟩ : Function.Bijective _)

/-- The underlying `R`-algebra homomorphism of `baseChangeEvalEquivOfSurjective` is
`baseChangeEval`. -/
@[simp]
theorem toAlgHom_baseChangeEvalEquivOfSurjective :
    letI := Algebra.compHom R (evalRingHom a)
    (φ.baseChangeEvalEquivOfSurjective hX hsurj hker).toAlgHom = φ.baseChangeEval hX :=
  AlgEquiv.toAlgHom_ofBijective _ _

/-- The base-change comparison induced by `φ` sends a pure tensor `r ⊗ x` to `r • φ x`. -/
@[simp]
theorem baseChangeEvalEquivOfSurjective_tmul (r : R) (x : A) :
    letI := Algebra.compHom R (evalRingHom a)
    φ.baseChangeEvalEquivOfSurjective hX hsurj hker (r ⊗ₜ[R[X]] x) = r • φ x := by
  let := Algebra.compHom R (evalRingHom a)
  rw [← AlgEquiv.coe_toAlgHom, toAlgHom_baseChangeEvalEquivOfSurjective, baseChangeEval_tmul]

/-- The inverse base-change comparison induced by `φ` sends `φ x` to `1 ⊗ x`. -/
@[simp]
theorem baseChangeEvalEquivOfSurjective_symm_apply (x : A) :
    letI := Algebra.compHom R (evalRingHom a)
    (φ.baseChangeEvalEquivOfSurjective hX hsurj hker).symm (φ x) = 1 ⊗ₜ[R[X]] x := by
  let := Algebra.compHom R (evalRingHom a)
  rw [AlgEquiv.symm_apply_eq, baseChangeEvalEquivOfSurjective_tmul, one_smul]

end Ring

end AlgHom
