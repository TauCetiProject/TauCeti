/-!
# Tensor products of algebras graded by groups with distinguished elements

Let `A` be graded by a family of submodules `Ag : G_A → Submodule R A` over a group `G_A`, and `B`
by `Bg : G_B → Submodule R B` over a group `G_B`, and let `l_A ∈ G_A` and `l_B ∈ G_B`. A pure
tensor `a ⊗ b` with `a ∈ Ag g` and `b ∈ Bg h` has the degree `(g, h)` in `G_A × G_B`, but this
grading does not make `d_A ⊗ 1 + 1 ⊗ d_B` homogeneous when `d_A` shifts degrees by `l_A` and `d_B`
by `l_B`: the two terms land in the degrees `(l_A g, h)` and `(g, l_B h)`. The remedy of Lipshitz,
Ozsváth and Thurston is to identify `l_A` with `l_B`: the grading group of `A ⊗ B` is the quotient
`G_A ×_λ G_B` of `G_A × G_B` by the subgroup generated by `(l_A, l_B⁻¹)`, which is normal when
`l_A` and `l_B` are central.

This file records that grading through its pullback to `G_A × G_B`. The part of degree `(g, h)`
(`TauCeti.tensorGradedPart Ag Bg l_A l_B (g, h)`) is spanned by the pure tensors `a ⊗ b` with
`a ∈ Ag (l_Aⁿ g)` and `b ∈ Bg (l_B⁻ⁿ h)` for some `n : ℤ`, so it depends only on the class of
`(g, h)` in `G_A ×_λ G_B` (`TauCeti.tensorGradedPart_eq_of_mul_inv_mem_zpowers`), and `(l_A, 1)`
and `(1, l_B)` shift it in the same way (`TauCeti.tensorGradedPart_mul_left_eq`). Working in
`G_A × G_B` lets modules over `A ⊗ B` keep grading sets with actions of `G_A × G_B`, such as
products of grading sets of modules over `A` and over `B`, on which `(l_A, l_B⁻¹)` need not act
trivially.

* **Products.** If both gradings are multiplicative and `l_A`, `l_B` are central, the parts are
  multiplicative (`TauCeti.mul_mem_tensorGradedPart`).
* **Differentials.** If `d_A` maps `Ag g` into `Ag (l_A g)` and `d_B` maps `Bg h` into
  `Bg (l_B h)`, the differential `d_A ⊗ 1 + 1 ⊗ d_B` of `A ⊗ B`
  (`TauCeti.ungradedTensorDifferential`) has the single degree `(l_A, 1)`
  (`TauCeti.ungradedTensorDifferential_mem_tensorGradedPart`), which is central when `l_A` is
  (`Set.center_prod`).
* **Homogeneous matrices.** Since the parts are invariant under `(l_A, l_B⁻¹)`, so are the
  matrices homogeneous for them (`TauCeti.homogeneousMatrices_tensorGradedPart_mul_left_eq`):
  a matrix of degree `(1, l_B) c` also has degree `(l_A, 1) c`. The Kronecker product `F ⊗ G` of
  homogeneous matrices over `A` and `B` is homogeneous of the product degree, for gradings of its
  rows and columns paired equivariantly into a `G_A × G_B`-set
  (`TauCeti.kroneckerTMul_mem_homogeneousMatrices`).

## Main definitions

* `TauCeti.tensorGradedPart Ag Bg l_A l_B`: the grading of `A ⊗ B` by `G_A × G_B` in which
  `(l_A, 1)` and `(1, l_B)` are identified.

## Main results

* `TauCeti.tensorGradedPart_eq_of_mul_inv_mem_zpowers`: the parts are constant on the classes of
  `G_A ×_λ G_B`.
* `TauCeti.mul_mem_tensorGradedPart`: the grading is multiplicative.
* `TauCeti.ungradedTensorDifferential_mem_tensorGradedPart`: `d_A ⊗ 1 + 1 ⊗ d_B` has degree
  `(l_A, 1)`.
* `TauCeti.kroneckerTMul_mem_homogeneousMatrices`: degrees of Kronecker products of homogeneous
  matrices.

## References

* R. Lipshitz, P. S. Ozsváth and D. P. Thurston, *Bimodules in bordered Heegaard Floer homology*,
  Geom. Topol. **19** (2015), 525–724, [arXiv:1003.0598](https://arxiv.org/abs/1003.0598), §2.5
  (the grading group `G_1 ×_λ G_2` of a tensor product of graded algebras).
-/

public section

open scoped TensorProduct Kronecker

namespace TauCeti

section Module

variable {R A B : Type*} [CommSemiring R] [AddCommMonoid A] [Module R A] [AddCommMonoid B]
  [Module R B] {GA GB : Type*} [Group GA] [Group GB]

/-- The part of degree `g` of the grading of `A ⊗ B` by `G_A × G_B` in which `(l_A, 1)` and
`(1, l_B)` are identified: the span of the pure tensors `a ⊗ b` with `a ∈ Ag (l_Aⁿ g.1)` and
`b ∈ Bg (l_B⁻ⁿ g.2)` for some `n : ℤ`. -/
def tensorGradedPart (Ag : GA → Submodule R A) (Bg : GB → Submodule R B) (lA : GA) (lB : GB)
    (g : GA × GB) : Submodule R (A ⊗[R] B) :=
  ⨆ n : ℤ, Submodule.map₂ (TensorProduct.mk R A B) (Ag (lA ^ n * g.1)) (Bg (lB ^ (-n) * g.2))

variable {Ag : GA → Submodule R A} {Bg : GB → Submodule R B} {lA : GA} {lB : GB}

theorem tensorGradedPart_def (g : GA × GB) :
    tensorGradedPart Ag Bg lA lB g =
      ⨆ n : ℤ, Submodule.map₂ (TensorProduct.mk R A B) (Ag (lA ^ n * g.1))
        (Bg (lB ^ (-n) * g.2)) :=
  (rfl)

/-- A pure tensor of elements of degrees `l_Aⁿ g.1` and `l_B⁻ⁿ g.2` has degree `g`. -/
theorem tmul_mem_tensorGradedPart_of_zpow (n : ℤ) {g : GA × GB} {a : A} {b : B}
    (ha : a ∈ Ag (lA ^ n * g.1)) (hb : b ∈ Bg (lB ^ (-n) * g.2)) :
    a ⊗ₜ[R] b ∈ tensorGradedPart Ag Bg lA lB g :=
  Submodule.mem_iSup_of_mem n (Submodule.apply_mem_map₂ (TensorProduct.mk R A B) ha hb)

/-- **Degrees of pure tensors.** A pure tensor of elements of degrees `g` and `h` has degree
`(g, h)`. -/
theorem tmul_mem_tensorGradedPart {g : GA} {h : GB} {a : A} {b : B} (ha : a ∈ Ag g)
    (hb : b ∈ Bg h) : a ⊗ₜ[R] b ∈ tensorGradedPart Ag Bg lA lB (g, h) :=
  tmul_mem_tensorGradedPart_of_zpow 0 (by rwa [zpow_zero, one_mul])
    (by rwa [neg_zero, zpow_zero, one_mul])

/-- A submodule contains the part of degree `g` exactly when it contains the pure tensors spanning
it. -/
theorem tensorGradedPart_le_iff {g : GA × GB} {p : Submodule R (A ⊗[R] B)} :
    tensorGradedPart Ag Bg lA lB g ≤ p ↔
      ∀ n : ℤ, ∀ a ∈ Ag (lA ^ n * g.1), ∀ b ∈ Bg (lB ^ (-n) * g.2), a ⊗ₜ[R] b ∈ p := by
  simp only [tensorGradedPart_def, iSup_le_iff, Submodule.map₂_le, TensorProduct.mk_apply]

/-- **The parts depend only on the class in `G_A ×_λ G_B`**: translating a degree by a power of
`(l_A, l_B⁻¹)` does not change its part. -/
theorem tensorGradedPart_zpow_mul_zpow_neg_mul (k : ℤ) (g : GA) (h : GB) :
    tensorGradedPart Ag Bg lA lB (lA ^ k * g, lB ^ (-k) * h) =
      tensorGradedPart Ag Bg lA lB (g, h) := by
  refine le_antisymm (tensorGradedPart_le_iff.2 fun n a ha b hb ↦ ?_)
    (tensorGradedPart_le_iff.2 fun n a ha b hb ↦ ?_)
  · exact tmul_mem_tensorGradedPart_of_zpow (n + k) (by convert ha using 2; group)
      (by convert hb using 2; group)
  · exact tmul_mem_tensorGradedPart_of_zpow (n - k) (by convert ha using 2; group)
      (by convert hb using 2; group)

/-- The parts are invariant under multiplication of the degree by `(l_A, l_B⁻¹)`. -/
private theorem tensorGradedPart_mk_inv_mul (g : GA × GB) :
    tensorGradedPart Ag Bg lA lB ((lA, lB⁻¹) * g) = tensorGradedPart Ag Bg lA lB g := by
  have h := tensorGradedPart_zpow_mul_zpow_neg_mul (Ag := Ag) (Bg := Bg) (lA := lA) (lB := lB)
    1 g.1 g.2
  rwa [zpow_one, zpow_neg, zpow_one] at h

/-- **The parts are constant on the cosets of `⟨(l_A, l_B⁻¹)⟩`**, that is on the classes of
`G_A ×_λ G_B`. -/
theorem tensorGradedPart_eq_of_mul_inv_mem_zpowers {g g' : GA × GB}
    (h : g' * g⁻¹ ∈ Subgroup.zpowers ((lA, lB⁻¹) : GA × GB)) :
    tensorGradedPart Ag Bg lA lB g' = tensorGradedPart Ag Bg lA lB g := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 h
  rw [← eq_mul_inv_iff_mul_eq.1 hk]
  have hpow : ((lA, lB⁻¹) : GA × GB) ^ k * g = (lA ^ k * g.1, lB ^ (-k) * g.2) := by
    ext <;> simp [zpow_neg, inv_zpow']
  rw [hpow, tensorGradedPart_zpow_mul_zpow_neg_mul]

/-- `(l_A, 1)` is `(l_A, l_B⁻¹) (1, l_B)`. -/
private theorem mk_one_mul_eq (lA : GA) (lB : GB) (g : GA × GB) :
    ((lA, 1) * g : GA × GB) = (lA, lB⁻¹) * ((1, lB) * g) := by
  ext <;> simp

/-- **`(l_A, 1)` and `(1, l_B)` act in the same way on the parts.** -/
theorem tensorGradedPart_mul_left_eq (g : GA × GB) :
    tensorGradedPart Ag Bg lA lB ((lA, 1) * g) = tensorGradedPart Ag Bg lA lB ((1, lB) * g) := by
  rw [mk_one_mul_eq lA lB, tensorGradedPart_mk_inv_mul]

end Module

section Algebra

variable {R A B : Type*} [CommSemiring R] [Semiring A] [Algebra R A] [Semiring B] [Algebra R B]
  {GA GB : Type*} [Group GA] [Group GB] {Ag : GA → Submodule R A} {Bg : GB → Submodule R B}
  {lA : GA} {lB : GB}

/-- **The grading is multiplicative.** If the gradings of `A` and `B` are multiplicative and `l_A`
and `l_B` are central, the product of elements of degrees `g` and `h` has degree `g * h`. -/
theorem mul_mem_tensorGradedPart
    (hA : ∀ {g h : GA} {a a' : A}, a ∈ Ag g → a' ∈ Ag h → a * a' ∈ Ag (g * h))
    (hB : ∀ {g h : GB} {b b' : B}, b ∈ Bg g → b' ∈ Bg h → b * b' ∈ Bg (g * h))
    (hlA : lA ∈ Subgroup.center GA) (hlB : lB ∈ Subgroup.center GB) {g h : GA × GB}
    {x y : A ⊗[R] B} (hx : x ∈ tensorGradedPart Ag Bg lA lB g)
    (hy : y ∈ tensorGradedPart Ag Bg lA lB h) : x * y ∈ tensorGradedPart Ag Bg lA lB (g * h) := by
  have key : tensorGradedPart Ag Bg lA lB g * tensorGradedPart Ag Bg lA lB h ≤
      tensorGradedPart Ag Bg lA lB (g * h) := by
    rw [tensorGradedPart_def g, tensorGradedPart_def h, Submodule.iSup_mul, iSup_le_iff]
    intro m
    rw [Submodule.mul_iSup, iSup_le_iff]
    intro n
    refine (Submodule.map₂_tmul_mul_le _ _ _ _).trans (Submodule.map₂_le.2 fun a ha b hb ↦ ?_)
    refine tmul_mem_tensorGradedPart_of_zpow (m + n) ?_ ?_
    · -- The central factor `l_Aⁿ` commutes past `g.1`.
      have hc : Commute g.1 (lA ^ n) :=
        Subgroup.mem_center_iff.mp (Subgroup.zpow_mem _ hlA n) g.1
      rw [Prod.fst_mul, zpow_add, ← hc.mul_mul_mul_comm]
      exact Submodule.mul_le.2 (fun _ ha _ ha' ↦ hA ha ha') ha
    · have hc : Commute g.2 (lB ^ (-n)) :=
        Subgroup.mem_center_iff.mp (Subgroup.zpow_mem _ hlB (-n)) g.2
      rw [Prod.snd_mul, neg_add, zpow_add, ← hc.mul_mul_mul_comm]
      exact Submodule.mul_le.2 (fun _ hb _ hb' ↦ hB hb hb') hb
  exact key (Submodule.mul_mem_mul hx hy)

/-- **Homogeneous matrices for the tensor grading.** A matrix over `A ⊗ B` is homogeneous of
degree `(l_A, 1) c` exactly when it is homogeneous of degree `(1, l_B) c`. -/
theorem homogeneousMatrices_tensorGradedPart_mul_left_eq {T X X' : Type*} [MulAction (GA × GB) T]
    (gr : X → T) (gr' : X' → T) (c : GA × GB) :
    homogeneousMatrices (tensorGradedPart Ag Bg lA lB) gr gr' ((lA, 1) * c) =
      homogeneousMatrices (tensorGradedPart Ag Bg lA lB) gr gr' ((1, lB) * c) := by
  rw [mk_one_mul_eq lA lB, homogeneousMatrices_mul_left_eq tensorGradedPart_mk_inv_mul]

/-- **Kronecker products of homogeneous matrices.** Let `T` be a `G_A`-set, `T'` a `G_B`-set, and
`π : T → T' → U` a map into a `G_A × G_B`-set with `π (g • t) (h • t') = (g, h) • π t t'`. If `F`
over `A` is homogeneous of degree `c` and `G` over `B` of degree `c'`, then `F ⊗ G` over `A ⊗ B`
is homogeneous of degree `(c, c')` for the gradings `(x, x') ↦ π (gr x) (gr' x')` of its rows and
columns. -/
theorem kroneckerTMul_mem_homogeneousMatrices {T T' U : Type*} [MulAction GA T] [MulAction GB T']
    [MulAction (GA × GB) U] {π : T → T' → U}
    (hπ : ∀ (g : GA) (h : GB) (t : T) (t' : T'), π (g • t) (h • t') = (g, h) • π t t')
    {X X₂ X' X₂' : Type*} {gr : X → T} {gr₂ : X₂ → T} {gr' : X' → T'} {gr₂' : X₂' → T'} {c : GA}
    {c' : GB} {F : Matrix X X₂ A} {G : Matrix X' X₂' B} (hF : F ∈ homogeneousMatrices Ag gr gr₂ c)
    (hG : G ∈ homogeneousMatrices Bg gr' gr₂' c') :
    F ⊗ₖₜ[R] G ∈ homogeneousMatrices (tensorGradedPart Ag Bg lA lB)
      (fun p ↦ π (gr p.1) (gr' p.2)) (fun p ↦ π (gr₂ p.1) (gr₂' p.2)) (c, c') := by
  refine mem_homogeneousMatrices_iff.2 ?_
  rintro ⟨x, x'⟩ ⟨y, y'⟩
  have hFG := Submodule.apply_mem_map₂ (TensorProduct.mk R A B)
    (mem_homogeneousMatrices_iff.1 hF x y) (mem_homogeneousMatrices_iff.1 hG x' y')
  simp_rw [Submodule.map₂_iSup_left, Submodule.map₂_iSup_right] at hFG
  rw [Matrix.kroneckerTMul_apply]
  refine (iSup_le fun g ↦ iSup_le fun h ↦ Submodule.map₂_le.2 fun a ha b hb ↦ ?_ : _ ≤ _) hFG
  refine Submodule.mem_iSup_of_mem ⟨(g.val, h.val), ?_⟩ (tmul_mem_tensorGradedPart ha hb)
  rw [← hπ, g.property, h.property, hπ]

end Algebra

section Differential

variable {R A B : Type*} [CommSemiring R] [AddCommMonoid A] [Module R A] [AddCommMonoid B]
  [Module R B] {GA GB : Type*} [Group GA] [Group GB] {Ag : GA → Submodule R A}
  {Bg : GB → Submodule R B} {lA : GA} {lB : GB}

/-- **The tensor differential is homogeneous.** If `d_A` maps `Ag g` into `Ag (l_A g)` and `d_B`
maps `Bg h` into `Bg (l_B h)`, then `d_A ⊗ 1 + 1 ⊗ d_B` maps the part of degree `g` into the part
of degree `(l_A, 1) g`, which is also the part of degree `(1, l_B) g`. -/
theorem ungradedTensorDifferential_mem_tensorGradedPart {dA : A →ₗ[R] A} {dB : B →ₗ[R] B}
    (hdA : ∀ {g : GA} {a : A}, a ∈ Ag g → dA a ∈ Ag (lA * g))
    (hdB : ∀ {h : GB} {b : B}, b ∈ Bg h → dB b ∈ Bg (lB * h)) {g : GA × GB} {x : A ⊗[R] B}
    (hx : x ∈ tensorGradedPart Ag Bg lA lB g) :
    ungradedTensorDifferential dA dB x ∈ tensorGradedPart Ag Bg lA lB ((lA, 1) * g) := by
  have key : tensorGradedPart Ag Bg lA lB g ≤
      (tensorGradedPart Ag Bg lA lB ((lA, 1) * g)).comap (ungradedTensorDifferential dA dB) := by
    refine tensorGradedPart_le_iff.2 fun n a ha b hb ↦ ?_
    rw [Submodule.mem_comap, ungradedTensorDifferential_tmul]
    -- `d_A a ⊗ b` keeps the index `n`; `a ⊗ d_B b` moves to the index `n - 1`.
    refine add_mem (tmul_mem_tensorGradedPart_of_zpow n ?_ ?_)
      (tmul_mem_tensorGradedPart_of_zpow (n - 1) ?_ ?_)
    · convert hdA ha using 2; simp only [Prod.fst_mul]; group
    · simpa only [Prod.snd_mul, one_mul] using hb
    · simpa only [Prod.fst_mul, ← mul_assoc, ← zpow_add_one, sub_add_cancel] using ha
    · convert hdB hb using 2; simp only [Prod.snd_mul, one_mul]; group
  exact key hx

end Differential

end TauCeti
