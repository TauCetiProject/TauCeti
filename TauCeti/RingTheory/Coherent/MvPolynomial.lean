/-!
# Coherence of multivariate polynomial rings

A polynomial ring `MvPolynomial σ R` in infinitely many variables over a nontrivial commutative ring
`R` is never Noetherian, yet when `R` is Noetherian (more generally, when every finite-variable
polynomial ring `MvPolynomial (Fin n) R` is coherent) `MvPolynomial σ R` is coherent for *every*
variable type `σ`. Every finitely generated ideal of `MvPolynomial σ R` is generated by polynomials
involving only finitely many variables, and extending a finitely presented ideal along the flat
variable-inclusion homomorphism preserves finite presentation.

## Main results

* `MvPolynomial.flat_rename`: for any injective map `f : τ → σ`, renaming variables gives a flat
  ring homomorphism `MvPolynomial τ R →+* MvPolynomial σ R`.
* `MvPolynomial.isCoherentRing_of_forall_fin`: if `MvPolynomial (Fin n) R` is coherent for every
  `n : ℕ`, then `MvPolynomial σ R` is coherent for every variable type `σ`.
* `MvPolynomial.isCoherentRing`: `MvPolynomial σ R` is coherent over every Noetherian commutative
  ring `R`, regardless of the cardinality of `σ`.
* `MvPolynomial.not_isNoetherianRing`, `MvPolynomial.isNoetherianRing_iff`: over a nontrivial
  commutative ring `R`, `MvPolynomial σ R` is Noetherian if and only if `R` is Noetherian and `σ`
  is finite.

## References

* N. Bourbaki, *Algèbre Commutative*, Ch. I, §2, Exercise 12(e).
* [The Stacks Project, Example 10.90.8, Tag 05CV](https://stacks.math.columbia.edu/tag/05CV).
-/

public section

namespace MvPolynomial

/-- Renaming variables along an injective map `f : τ → σ` defines a flat ring homomorphism
`MvPolynomial τ R →+* MvPolynomial σ R`. -/
theorem flat_rename {R σ τ : Type*} [CommRing R] {f : τ → σ} (hf : Function.Injective f) :
    (MvPolynomial.rename f : MvPolynomial τ R →ₐ[R] MvPolynomial σ R).toRingHom.Flat := by
  -- Split `σ` into `Set.range f` and its complement to realize `MvPolynomial σ R` as a polynomial
  -- algebra over `MvPolynomial τ R`, which is free and hence flat.
  classical
  let S₁ := {x : σ // x ∉ Set.range f}
  let e : S₁ ⊕ τ ≃ σ :=
    ((Equiv.refl S₁).sumCongr (Equiv.ofInjective f hf)).trans
      ((Equiv.sumComm S₁ _).trans (Equiv.sumCompl (· ∈ Set.range f)))
  let ψ : MvPolynomial S₁ (MvPolynomial τ R) ≃ₐ[R] MvPolynomial σ R :=
    (MvPolynomial.sumAlgEquiv R S₁ τ).symm.trans (MvPolynomial.renameEquiv R e)
  let φ₀ : MvPolynomial τ R →ₐ[R] MvPolynomial S₁ (MvPolynomial τ R) :=
    IsScalarTower.toAlgHom R (MvPolynomial τ R) (MvPolynomial S₁ (MvPolynomial τ R))
  have hφ₀ : φ₀.toRingHom.Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
  have heq : MvPolynomial.rename f = ψ.toAlgHom.comp φ₀ :=
    MvPolynomial.algHom_ext fun t ↦ by
      simp [ψ, φ₀, e, MvPolynomial.algebraMap_eq]
      rfl
  rw [heq]
  exact hφ₀.comp (RingHom.Flat.of_bijective ψ.bijective)

/-- If every finite-variable polynomial ring `MvPolynomial (Fin n) R` is coherent, then
`MvPolynomial σ R` is coherent for every variable type `σ` (Stacks, Example 10.90.8, Tag 05CV;
Bourbaki, *Algèbre Commutative*, Ch. I, §2, Exercise 12(e)). -/
@[stacks 05CV]
theorem isCoherentRing_of_forall_fin {R : Type*} [CommRing R]
    (hfin : ∀ n : ℕ, TauCeti.IsCoherentRing (MvPolynomial (Fin n) R)) (σ : Type*) :
    TauCeti.IsCoherentRing (MvPolynomial σ R) := by
  classical
  refine (TauCeti.isCoherentRing_iff_ideal_finitePresentation _).mpr fun I hI ↦ ?_
  obtain ⟨s, hs⟩ := hI
  -- Collect the finitely many variables occurring in `s` and extend from `MvPolynomial V R`.
  let V : Finset σ := s.biUnion MvPolynomial.vars
  have hcohV : TauCeti.IsCoherentRing (MvPolynomial V R) :=
    (RingEquiv.isCoherentRing_iff
      (MvPolynomial.renameEquiv R (Fintype.equivFin V).symm).toRingEquiv).mp
      (hfin (Fintype.card V))
  let ι : MvPolynomial V R →+* MvPolynomial σ R :=
    (MvPolynomial.rename ((↑) : V → σ) : MvPolynomial V R →ₐ[R] MvPolynomial σ R).toRingHom
  have hflat : ι.Flat := MvPolynomial.flat_rename Subtype.val_injective
  choose q hq using fun g : s ↦
    MvPolynomial.exists_rename_eq_of_vars_subset_range g.1 ((↑) : V → σ) Subtype.val_injective
      (by
        rw [Subtype.range_coe, Finset.coe_subset]
        exact Finset.subset_biUnion_of_mem MvPolynomial.vars g.2)
  let I₀ : Ideal (MvPolynomial V R) := Ideal.span (Set.range q)
  have hI₀_fg : I₀.FG := ⟨Finset.univ.image q, by simp [I₀]⟩
  have : Module.FinitePresentation (MvPolynomial V R) I₀ :=
    hcohV.finitePresentation_of_fg hI₀_fg
  have hmap : I₀.map ι = I := by
    rw [← hs]
    dsimp only [I₀]
    rw [Ideal.map_span, ← Set.range_comp]
    congr 1
    ext x
    simp only [Set.mem_range, Function.comp_apply, Subtype.exists]
    exact ⟨fun ⟨a, ha, hax⟩ ↦ (hq ⟨a, ha⟩ ▸ hax) ▸ ha, fun hx ↦ ⟨x, hx, hq ⟨x, hx⟩⟩⟩
  let _ : Algebra (MvPolynomial V R) (MvPolynomial σ R) := ι.toAlgebra
  have : Module.Flat (MvPolynomial V R) (MvPolynomial σ R) := hflat
  have hmap' : I₀.map (algebraMap (MvPolynomial V R) (MvPolynomial σ R)) = I := hmap
  exact .of_equiv <|
    LinearEquiv.ofBijective _ (Ideal.liftBaseChange_idealMap_bijective (MvPolynomial σ R) I₀) ≪≫ₗ
      LinearEquiv.ofEq _ _ hmap'

/-- Every polynomial ring `MvPolynomial σ R` in arbitrarily (possibly infinitely) many variables
over a Noetherian commutative ring `R` is a coherent ring (Stacks, Example 10.90.8, Tag 05CV). -/
@[stacks 05CV]
instance isCoherentRing {R σ : Type*} [CommRing R] [IsNoetherianRing R] :
    TauCeti.IsCoherentRing (MvPolynomial σ R) :=
  isCoherentRing_of_forall_fin (fun _ ↦ inferInstance) σ

/-- A polynomial ring in infinitely many variables over a nontrivial commutative ring is never
Noetherian. -/
theorem not_isNoetherianRing {R σ : Type*} [CommRing R] [Nontrivial R] [Infinite σ] :
    ¬ IsNoetherianRing (MvPolynomial σ R) := by
  -- Any finite generating set for `(X_i)_{i : σ}` misses some variable `X_i`.
  intro hnoeth
  classical
  let I : Ideal (MvPolynomial σ R) := Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R))
  obtain ⟨s, hs⟩ := (isNoetherianRing_iff_ideal_fg (MvPolynomial σ R)).mp hnoeth I
  let V : Finset σ := s.biUnion MvPolynomial.vars
  obtain ⟨i, hi⟩ := Infinite.exists_notMem_finset V
  have hI_const : I ≤ RingHom.ker (MvPolynomial.constantCoeff (R := R) (σ := σ)) := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    simp
  let ev : MvPolynomial σ R →+* R :=
    MvPolynomial.eval₂Hom (RingHom.id R) (fun j ↦ if j = i then 1 else 0)
  have hI_ev : I ≤ RingHom.ker ev := by
    rw [← hs, Submodule.span_le]
    intro g hg
    rw [SetLike.mem_coe, RingHom.mem_ker]
    have hg0 : MvPolynomial.constantCoeff g = 0 :=
      RingHom.mem_ker.mp (hI_const (hs ▸ Submodule.subset_span hg))
    have hvars : ∀ j ∈ g.vars, (if j = i then (1 : R) else 0) = 0 := by
      intro j hj
      simp only [ite_eq_right_iff]
      rintro rfl
      exact absurd (Finset.mem_biUnion.mpr ⟨g, hg, hj⟩) hi
    simpa [ev, hg0] using MvPolynomial.eval₂Hom_eq_constantCoeff_of_vars (RingHom.id R) hvars
  have hXi : ev (MvPolynomial.X i) = 0 :=
    RingHom.mem_ker.mp (hI_ev (Ideal.subset_span ⟨i, rfl⟩))
  simp [ev] at hXi

/-- Over a nontrivial commutative ring `R`, `MvPolynomial σ R` is Noetherian if and only if `R` is
Noetherian and `σ` is finite. -/
theorem isNoetherianRing_iff {R σ : Type*} [CommRing R] [Nontrivial R] :
    IsNoetherianRing (MvPolynomial σ R) ↔ IsNoetherianRing R ∧ Finite σ := by
  refine ⟨fun h ↦ ⟨?_, ?_⟩, fun ⟨_, _⟩ ↦ inferInstance⟩
  · exact isNoetherianRing_of_surjective (MvPolynomial σ R) R MvPolynomial.constantCoeff
      fun r ↦ ⟨MvPolynomial.C r, by simp⟩
  · by_contra hinf
    have : Infinite σ := not_finite_iff_infinite.mp hinf
    exact not_isNoetherianRing h

end MvPolynomial
