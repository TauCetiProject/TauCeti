/-!
# Coherence of multivariate polynomial rings

A polynomial ring `MvPolynomial σ R` in infinitely many variables over a nontrivial commutative ring
`R` is never Noetherian, yet when `R` is Noetherian (more generally, when every finite-variable
polynomial ring `MvPolynomial (Fin n) R` is coherent) `MvPolynomial σ R` is coherent for *every*
variable type `σ`. Every finitely generated ideal of `MvPolynomial σ R` is generated by polynomials
involving only finitely many variables, and extending a finitely presented ideal along the flat
variable-inclusion homomorphism (`MvPolynomial.flat_rename`) preserves finite presentation.

## Main results

* `MvPolynomial.isCoherentRing_of_forall_fin`: if `MvPolynomial (Fin n) R` is coherent for every
  `n : ℕ`, then `MvPolynomial σ R` is coherent for every variable type `σ`.
* `MvPolynomial.isCoherentRing`: `MvPolynomial σ R` is coherent over every Noetherian commutative
  ring `R`, regardless of the cardinality of `σ`.

## References

* N. Bourbaki, *Algèbre Commutative*, Ch. I, §2, Exercise 12(e).
* [The Stacks Project, Example 10.90.8, Tag 05CV](https://stacks.math.columbia.edu/tag/05CV).
-/

public section

namespace MvPolynomial

/-- If every finite-variable polynomial ring `MvPolynomial (Fin n) R` is coherent, then
`MvPolynomial σ R` is coherent for every variable type `σ` (Stacks, Example 10.90.8, Tag 05CV;
Bourbaki, *Algèbre Commutative*, Ch. I, §2, Exercise 12(e)). -/
@[stacks 05CV]
theorem isCoherentRing_of_forall_fin {R : Type*} [CommRing R]
    (hfin : ∀ n : ℕ, TauCeti.IsCoherentRing (MvPolynomial (Fin n) R)) (σ : Type*) :
    TauCeti.IsCoherentRing (MvPolynomial σ R) := by
  classical
  refine (TauCeti.isCoherentRing_iff_ideal_finitePresentation _).mpr fun I hI ↦ ?_
  obtain ⟨s, hs⟩ := hI
  -- Collect the finitely many variables occurring in `s` and extend from `MvPolynomial V R`.
  let V : Finset σ := s.biUnion MvPolynomial.vars
  have hcohV : TauCeti.IsCoherentRing (MvPolynomial V R) :=
    (RingEquiv.isCoherentRing_iff
      (MvPolynomial.renameEquiv R (Fintype.equivFin V).symm).toRingEquiv).mp
      (hfin (Fintype.card V))
  let ι : MvPolynomial V R →+* MvPolynomial σ R :=
    (MvPolynomial.rename ((↑) : V → σ) : MvPolynomial V R →ₐ[R] MvPolynomial σ R).toRingHom
  have hflat : ι.Flat := MvPolynomial.flat_rename Subtype.val_injective
  choose q hq using fun g : s ↦
    MvPolynomial.exists_rename_eq_of_vars_subset_range g.1 ((↑) : V → σ) Subtype.val_injective
      (by
        rw [Subtype.range_coe, Finset.coe_subset]
        exact Finset.subset_biUnion_of_mem MvPolynomial.vars g.2)
  let I₀ : Ideal (MvPolynomial V R) := Ideal.span (Set.range q)
  have hI₀_fg : I₀.FG := ⟨Finset.univ.image q, by simp [I₀]⟩
  have : Module.FinitePresentation (MvPolynomial V R) I₀ :=
    hcohV.finitePresentation_of_fg hI₀_fg
  have hmap : I₀.map ι = I := by
    rw [← hs]
    dsimp only [I₀]
    rw [Ideal.map_span, ← Set.range_comp]
    congr 1
    ext x
    simp only [Set.mem_range, Function.comp_apply, Subtype.exists]
    exact ⟨fun ⟨a, ha, hax⟩ ↦ (hq ⟨a, ha⟩ ▸ hax) ▸ ha, fun hx ↦ ⟨x, hx, hq ⟨x, hx⟩⟩⟩
  let _ : Algebra (MvPolynomial V R) (MvPolynomial σ R) := ι.toAlgebra
  have : Module.Flat (MvPolynomial V R) (MvPolynomial σ R) := by
    rwa [← RingHom.flat_algebraMap_iff, ι.algebraMap_toAlgebra]
  have hmap' : I₀.map (algebraMap (MvPolynomial V R) (MvPolynomial σ R)) = I := by
    rwa [ι.algebraMap_toAlgebra]
  exact .of_equiv <|
    LinearEquiv.ofBijective _ (Ideal.liftBaseChange_idealMap_bijective (MvPolynomial σ R) I₀) ≪≫ₗ
      LinearEquiv.ofEq _ _ hmap'

/-- Every polynomial ring `MvPolynomial σ R` in arbitrarily (possibly infinitely) many variables
over a Noetherian commutative ring `R` is a coherent ring (Stacks, Example 10.90.8, Tag 05CV). -/
@[stacks 05CV]
instance isCoherentRing {R σ : Type*} [CommRing R] [IsNoetherianRing R] :
    TauCeti.IsCoherentRing (MvPolynomial σ R) :=
  isCoherentRing_of_forall_fin (fun _ ↦ inferInstance) σ

end MvPolynomial
