module

public import TauCeti.FieldTheory.MatsumotoGroup
public import TauCeti.RingTheory.Valuation.Discrete.TameSymbol.Basic

/-!
# The tame symbol on the Matsumoto group

Let `v : F → ℤᵐ⁰` be a valuation on a field `F` with valuation ring `𝒪_v` and residue field
`k_v`. The tame symbol `∂_v{f, g}` is bimultiplicative and satisfies the Steinberg relation, so it
descends to a homomorphism `∂_v` from the Matsumoto group `(Fˣ ⊗ Fˣ) / ⟨x ⊗ y : x + y = 1⟩`,
the symbol presentation of `K₂` of `F`, to `k_vˣ` (the source written additively). This is the basic
residue map of `K₂` of a discretely valued field; the residue maps of Milnor K-theory in higher
degrees and the localization sequence in K-theory extend it.

The homomorphism is characterised by two normalisations. Fix `t ∈ Fˣ` of order one. Writing
`f = t ^ a u` and `g = t ^ b w` with `u`, `w` units of `𝒪_v`, bilinearity, antisymmetry and
`{t, t} = {t, -1}` give
`{f, g} = a b {t, -1} + b {u, t} - a {w, t} + {u, w}`.
Hence the Matsumoto group is generated by the symbols `{u, w}` and `{u, t}` with `u`, `w` units of
`𝒪_v` (`Valuation.closure_symbol_unitGroup_eq_top`), and a homomorphism out of it is determined by
its values on these. The tame symbol kills `{u, w}` and sends `{u, t}` to the residue of `u`, and
it is the only homomorphism doing so (`Valuation.eq_tameSymbolHom_iff`). Read on pairings, a
bimultiplicative Steinberg pairing `c` on `Fˣ` with values in `k_vˣ` that is trivial on pairs of
units and satisfies `c(u, t) = res u` is the tame symbol (`Valuation.tameSymbol_unique`).

When `v` is surjective the homomorphism is onto `k_vˣ`, since `∂_v{u, t} = res u` and every unit
of `k_v` is the residue of a unit of `𝒪_v`.

## Main definitions

* `Valuation.tameSymbolHom v`: the homomorphism `{f, g} ↦ ∂_v{f, g}` from the Matsumoto group of
  `F` to the units of the residue field, written additively.

## Main results

* `Valuation.tameSymbolHom_symbol`: its value on a Steinberg symbol is the tame symbol.
* `Valuation.tameSymbolHom_surjective`: it is surjective when `v` is.
* `Valuation.closure_symbol_unitGroup_eq_top`: the Matsumoto group is generated by the symbols
  `{u, w}` and `{u, t}`, for `u`, `w` units of the valuation ring and `t` of order one.
* `Valuation.eq_tameSymbolHom_iff`: the tame symbol is the unique homomorphism out of the
  Matsumoto group that vanishes on `{u, w}` and sends `{u, t}` to `res u`.
* `Valuation.tameSymbol_unique`: the same characterisation for bimultiplicative pairings.

## References

* C. Weibel, *The K-book*, Lemma III.6.3 and the discussion after Theorem III.6.1.
-/

public section

open scoped WithZero

open TauCeti TauCeti.MatsumotoGroup

namespace Valuation

variable {F : Type*} [Field F] (v : Valuation F ℤᵐ⁰)

/-- **The tame symbol as a homomorphism out of the Matsumoto group**: the homomorphism
`{f, g} ↦ ∂_v{f, g}`, induced by the bimultiplicative Steinberg pairing `Valuation.tameSymbol`.
The target is the unit group of the residue field, written additively. -/
noncomputable def tameSymbolHom :
    MatsumotoGroup F →+ Additive (IsLocalRing.ResidueField v.valuationSubring)ˣ :=
  liftOfBimultiplicative v.tameSymbol v.tameSymbol_mul_left v.tameSymbol_mul_right
    fun _ _ ↦ v.tameSymbol_of_add_eq_one

/-- The tame symbol homomorphism sends the Steinberg symbol `{f, g}` to `∂_v{f, g}`. -/
@[simp]
theorem tameSymbolHom_symbol (f g : Fˣ) :
    v.tameSymbolHom (symbol f g) = Additive.ofMul (v.tameSymbol f g) := by
  rw [tameSymbolHom, liftOfBimultiplicative_symbol]

/-- The tame symbol homomorphism vanishes on the symbol of two units of the valuation ring. -/
theorem tameSymbolHom_symbol_coe_coe (u w : v.valuationSubring.unitGroup) :
    v.tameSymbolHom (symbol u w) = 0 := by
  rw [tameSymbolHom_symbol, v.tameSymbol_of_ord_eq_zero
    ((v.mem_unitGroup_iff_ord_eq_zero _).1 u.property)
    ((v.mem_unitGroup_iff_ord_eq_zero _).1 w.property),
    ofMul_one]

/-- The tame symbol homomorphism sends `{u, t}` to the residue of `u`, for a unit `u` of the
valuation ring and `t` of order one. -/
theorem tameSymbolHom_symbol_coe_of_ord_eq_one (u : v.valuationSubring.unitGroup) {t : Fˣ}
    (ht : v.ord (t : F) = 1) :
    v.tameSymbolHom (symbol u t) =
      Additive.ofMul (v.valuationSubring.unitGroupToResidueFieldUnits u) := by
  rw [tameSymbolHom_symbol, v.tameSymbol_coe_left_of_ord_eq_one u ht]

/-- **The tame symbol is onto** the units of the residue field when `v` is surjective: a unit of
the residue field is the residue of a unit `u` of the valuation ring, and it is `∂_v{u, t}` for `t`
of order one. -/
theorem tameSymbolHom_surjective (hv : Function.Surjective v) :
    Function.Surjective v.tameSymbolHom := by
  intro x
  obtain ⟨t₀, ht₀⟩ := v.ord_surjective hv 1
  have ht₀0 : t₀ ≠ 0 := fun h ↦ by simp [h, ord_zero] at ht₀
  obtain ⟨u, hu⟩ := v.valuationSubring.surjective_unitGroupToResidueFieldUnits x.toMul
  exact ⟨symbol u (Units.mk0 t₀ ht₀0), by
    rw [v.tameSymbolHom_symbol_coe_of_ord_eq_one u (t := Units.mk0 t₀ ht₀0) ht₀, hu, ofMul_toMul]⟩

/-- **Generators of the Matsumoto group of a discretely valued field.** For `t` of order one, the
Matsumoto group is generated by the symbols `{u, w}` and `{u, t}` with `u`, `w` units of the
valuation ring. -/
theorem closure_symbol_unitGroup_eq_top {t : Fˣ} (ht : v.ord (t : F) = 1) :
    AddSubgroup.closure
      (Set.range (fun p : v.valuationSubring.unitGroup × v.valuationSubring.unitGroup ↦
        symbol (p.1 : Fˣ) p.2) ∪
      Set.range (fun u : v.valuationSubring.unitGroup ↦ symbol (u : Fˣ) t)) = ⊤ := by
  set H := AddSubgroup.closure
    (Set.range (fun p : v.valuationSubring.unitGroup × v.valuationSubring.unitGroup ↦
      symbol (p.1 : Fˣ) p.2) ∪
    Set.range (fun u : v.valuationSubring.unitGroup ↦ symbol (u : Fˣ) t))
  have huw (u w : v.valuationSubring.unitGroup) : symbol (u : Fˣ) w ∈ H :=
    AddSubgroup.subset_closure (Or.inl ⟨(u, w), rfl⟩)
  have hut (u : v.valuationSubring.unitGroup) : symbol (u : Fˣ) t ∈ H :=
    AddSubgroup.subset_closure (Or.inr ⟨u, rfl⟩)
  -- `{t, w} = -{w, t}` and `{t, t} = {t, -1} = -{-1, t}`.
  have htu (u : v.valuationSubring.unitGroup) : symbol t (u : Fˣ) ∈ H := by
    rw [symbol_swap]
    exact neg_mem (hut u)
  have htt : symbol t t ∈ H := by
    rw [symbol_self]
    exact htu ⟨-1, v.valuationSubring.neg_one_mem_unitGroup⟩
  -- Expand `{t ^ a u, t ^ b w}` by bilinearity.
  have hfg (f g : Fˣ) : symbol f g ∈ H := by
    rw [v.eq_zpow_mul_unitPart t ht f, v.eq_zpow_mul_unitPart t ht g, symbol_mul_left,
      symbol_mul_right, symbol_mul_right, symbol_zpow_left, symbol_zpow_left, symbol_zpow_right,
      symbol_zpow_right]
    exact add_mem (add_mem (zsmul_mem (zsmul_mem htt _) _) (zsmul_mem (htu _) _))
      (add_mem (zsmul_mem (hut _) _) (huw _ _))
  refine eq_top_iff.2 fun q _ ↦ ?_
  clear ‹q ∈ ⊤›
  induction q using MatsumotoGroup.induction_on with
  | symbol f g => exact hfg f g
  | add a b ha hb => exact add_mem ha hb

/-- Homomorphisms out of the Matsumoto group of a discretely valued field agree when they agree
on the symbols `{u, w}` and `{u, t}`, for `u`, `w` units of the valuation ring and `t` of order
one. -/
theorem matsumotoGroup_hom_ext {A : Type*} [AddMonoid A] {φ ψ : MatsumotoGroup F →+ A} {t : Fˣ}
    (ht : v.ord (t : F) = 1)
    (huw : ∀ u w : v.valuationSubring.unitGroup, φ (symbol u w) = ψ (symbol u w))
    (hut : ∀ u : v.valuationSubring.unitGroup, φ (symbol u t) = ψ (symbol u t)) : φ = ψ := by
  refine AddMonoidHom.eq_of_eqOn_dense (v.closure_symbol_unitGroup_eq_top ht) ?_
  rintro _ (⟨⟨u, w⟩, rfl⟩ | ⟨u, rfl⟩)
  exacts [huw u w, hut u]

/-- **Characterisation of the tame symbol.** For `t` of order one, a homomorphism `φ` from the
Matsumoto group to the units of the residue field is the tame symbol if and only if it vanishes on
the symbols `{u, w}` of two units of the valuation ring and sends `{u, t}` to the residue of `u`. -/
theorem eq_tameSymbolHom_iff {t : Fˣ} (ht : v.ord (t : F) = 1)
    (φ : MatsumotoGroup F →+ Additive (IsLocalRing.ResidueField v.valuationSubring)ˣ) :
    φ = v.tameSymbolHom ↔
      (∀ u w : v.valuationSubring.unitGroup, φ (symbol u w) = 0) ∧
        ∀ u : v.valuationSubring.unitGroup,
          φ (symbol u t) = Additive.ofMul (v.valuationSubring.unitGroupToResidueFieldUnits u) := by
  refine ⟨?_, fun ⟨huw, hut⟩ ↦ v.matsumotoGroup_hom_ext ht ?_ ?_⟩
  · rintro rfl
    exact ⟨v.tameSymbolHom_symbol_coe_coe, fun u ↦ v.tameSymbolHom_symbol_coe_of_ord_eq_one u ht⟩
  · intro u w
    rw [huw, tameSymbolHom_symbol_coe_coe]
  · intro u
    rw [hut, tameSymbolHom_symbol_coe_of_ord_eq_one _ _ ht]

/-- **Uniqueness of the tame symbol among Steinberg pairings.** Let `t` have order one. A pairing
`c` on `Fˣ` with values in the units of the residue field that is multiplicative in each argument,
satisfies the Steinberg relation `c(x, y) = 1` for `x + y = 1`, is trivial on pairs of units of
the valuation ring and sends `(u, t)` to the residue of `u`, is the tame symbol. -/
theorem tameSymbol_unique (c : Fˣ → Fˣ → (IsLocalRing.ResidueField v.valuationSubring)ˣ)
    (hl : ∀ f₁ f₂ g, c (f₁ * f₂) g = c f₁ g * c f₂ g)
    (hr : ∀ f g₁ g₂, c f (g₁ * g₂) = c f g₁ * c f g₂)
    (hc : ∀ x y : Fˣ, (x : F) + y = 1 → c x y = 1)
    (huw : ∀ u w : v.valuationSubring.unitGroup, c u w = 1) {t : Fˣ} (ht : v.ord (t : F) = 1)
    (hut : ∀ u : v.valuationSubring.unitGroup,
      c u t = v.valuationSubring.unitGroupToResidueFieldUnits u)
    (f g : Fˣ) : c f g = v.tameSymbol f g := by
  have hφ := (v.eq_tameSymbolHom_iff ht (liftOfBimultiplicative c hl hr hc)).2
    ⟨fun u w ↦ by rw [liftOfBimultiplicative_symbol, huw, ofMul_one],
      fun u ↦ by rw [liftOfBimultiplicative_symbol, hut]⟩
  have := DFunLike.congr_fun hφ (symbol f g)
  rwa [liftOfBimultiplicative_symbol, tameSymbolHom_symbol, EmbeddingLike.apply_eq_iff_eq] at this

end Valuation
