module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.RingTheory.Valuation.Basic
import TauCeti.Algebra.GroupWithZero.Range
import TauCeti.RingTheory.Valuation.ValueGroupTransport

/-!
# Surjective valuations

Normalized valuations, such as the `ℤᵐ⁰`-valued valuation of a place of a function field, are
surjective onto their target `Γ₀`. This file records consequences of surjectivity onto the
target that do not involve an additive order. The equality result goes through the value group
`v.valueGroup`: the subgroup of the units `Γ₀ˣ` of the target generated by the values of `v` that
are units, as opposed to the target itself. When `Γ₀` is a group with zero, these are exactly the
nonzero values. Surjectivity onto `Γ₀` makes the value group all of `Γ₀ˣ`, by
`MonoidWithZeroHom.valueGroup_eq_top_of_surjective` in `TauCeti.Algebra.GroupWithZero.Range`,
which also gives the converse between groups with zero, for instance for a valuation from a
division ring into an ordered group with zero. A surjective valuation is nontrivial exactly
when its target has an element other than `0` and `1`, for instance a unit other than `1`. Two
equivalent surjective valuations into a linearly ordered commutative group with zero whose units
form a cyclic group are equal, by the rigidity of equal cyclic value groups,
`Valuation.eq_of_isEquiv_of_valueGroup_eq` in `TauCeti.RingTheory.Valuation.ValueGroupTransport`.
For a surjective valuation from a field into a linearly ordered commutative group with zero `Γ₀`,
the valuation ring is a proper subring once `Γ₀ˣ` is nontrivial
(`Valuation.valuationSubring_ne_top_of_surjective` in
`TauCeti.RingTheory.Valuation.ValuationSubring`), and a discrete valuation ring once `Γ₀ˣ` is
moreover cyclic (`Valuation.valuationSubring_isDiscreteValuationRing_of_surjective` in
`TauCeti.RingTheory.Valuation.Discrete.IsDiscreteValuationRing`).

## Main results

* `Valuation.isNontrivial_iff_of_surjective`: a surjective valuation is nontrivial exactly when
  `Γ₀` has an element other than `0` and `1`.
* `Valuation.isNontrivial_of_surjective`: a surjective valuation is nontrivial when `Γ₀ˣ` is.
* `Valuation.eq_of_isEquiv_of_surjective`: two equivalent surjective valuations into a linearly
  ordered commutative group with zero `Γ₀` with `Γ₀ˣ` cyclic are equal.
-/

public section

open MonoidWithZeroHom

namespace Valuation

section Monoid

variable {Γ₀ : Type*} [LinearOrderedCommMonoidWithZero Γ₀] {R : Type*} [Ring R]

/-- **A surjective valuation is nontrivial exactly when `Γ₀` has an element other than `0` and
`1`.** Such an element need not be a unit: `Γ₀` may be the multiplicative submonoid
`{0} ∪ {2⁻ⁿ | n : ℕ}` of `ℝ≥0`, in which `1 / 2` is a nonzero nonunit. -/
theorem isNontrivial_iff_of_surjective {v : Valuation R Γ₀} (hv : Function.Surjective v) :
    v.IsNontrivial ↔ ∃ γ : Γ₀, γ ≠ 0 ∧ γ ≠ 1 :=
  (⟨fun h ↦ h.exists_val_nontrivial, fun h ↦ ⟨h⟩⟩ : v.IsNontrivial ↔ _).trans
    (hv.exists (p := fun γ ↦ γ ≠ 0 ∧ γ ≠ 1)).symm

/-- **A surjective valuation is nontrivial** once `Γ₀` has a unit other than `1`. Surjectivity is
the form the hypothesis usually arrives in — a place carries it by definition — while results
about valuation rings are stated for a nontrivial valuation, and this converts one to the
other. -/
theorem isNontrivial_of_surjective [Nontrivial Γ₀ˣ] {v : Valuation R Γ₀}
    (hv : Function.Surjective v) : v.IsNontrivial := by
  obtain ⟨γ, hγ⟩ := exists_ne (1 : Γ₀ˣ)
  have hγ1 : (γ : Γ₀) ≠ 1 := Units.val_eq_one.not.mpr hγ
  have : Nontrivial Γ₀ := ⟨_, _, hγ1⟩
  exact (isNontrivial_iff_of_surjective hv).mpr ⟨γ, γ.ne_zero, hγ1⟩

end Monoid

variable {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀]

section Ring

variable {R : Type*} [Ring R]

/-- **Equivalent surjective valuations are equal** when they take values in a linearly ordered
commutative group with zero `Γ₀` with `Γ₀ˣ` cyclic, for instance for normalized
`ℤᵐ⁰`-valuations. -/
theorem eq_of_isEquiv_of_surjective [IsCyclic Γ₀ˣ] {v w : Valuation R Γ₀}
    (hv : Function.Surjective v) (hw : Function.Surjective w) (h : v.IsEquiv w) : v = w :=
  eq_of_isEquiv_of_valueGroup_eq h <| by
    rw [v.valueGroup_eq_top_of_surjective hv, w.valueGroup_eq_top_of_surjective hw]

end Ring

end Valuation
