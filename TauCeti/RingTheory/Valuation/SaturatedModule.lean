/-!
# Modules saturated with respect to an ideal

Let `V` be a commutative ring, `m` an ideal of `V` and `M` a `V`-module. Multiplication gives a
`V`-linear map `M → Hom_V(m, M)`, `x ↦ (a ↦ a • x)`, and `M` is *`m`-saturated* when this map is
bijective: every `V`-linear map `m → M` is multiplication by a unique element of `M`. For the
maximal ideal `𝔪` of the valuation ring of a nonarchimedean field `K`, this is the hypothesis
under which Bhatt and Scholze show that bounded `V`-submodules of `K^r` are finite free, when `K`
is spherically complete with value group `ℝ_{>0}` (Lemma 6.14 and its proof). The open unit ball
`𝔪` itself is not `𝔪`-saturated.

## Main definitions

* `TauCeti.valuationSaturationMap V m M`: the multiplication map `M →ₗ[V] (m →ₗ[V] M)`.
* `TauCeti.IsValuationSaturated V m M`: the multiplication map is bijective.

## Main results

* `TauCeti.isValuationSaturated_iff`: every `V`-linear map `m → M` is multiplication by a unique
  element of `M`.
* `TauCeti.isValuationSaturated_congr`: saturation is invariant under linear equivalence.
* `TauCeti.isValuationSaturated_top`, `TauCeti.isValuationSaturated_bot_iff`: for `m = ⊤` every
  module is saturated, and for `m = ⊥` exactly the zero modules are.
* `TauCeti.isValuationSaturated_ideal_span_singleton_iff`: for a principal ideal generated by a
  nonzerodivisor `π`, saturation means that multiplication by `π` is bijective on `M`.
* `TauCeti.not_isValuationSaturated_ideal_self`: a nonzero proper ideal `m` of a domain is not
  `m`-saturated (as a `V`-module).
* `TauCeti.isValuationSaturated_maximalIdeal_self_iff`: a valuation domain is saturated with
  respect to its maximal ideal exactly when that ideal is not finitely generated.
* `TauCeti.isValuationSaturated_span_singleton`: over such a valuation domain, every cyclic
  submodule of a torsion-free module is saturated.

## References

* B. Bhatt and P. Scholze, *Projectivity of the Witt vector affine Grassmannian*,
  Invent. Math. 209 (2017), Lemma 6.14.
-/

public section

open IsLocalRing

namespace TauCeti

section Basic

variable (V : Type*) [CommRing V] (m : Ideal V) (M : Type*) [AddCommGroup M] [Module V M]

/-- The multiplication map `M → Hom_V(m, M)`, sending `x` to `a ↦ a • x`. -/
def valuationSaturationMap : M →ₗ[V] (m →ₗ[V] M) :=
  ((LinearMap.lsmul V M).comp m.subtype).flip

/-- A module `M` over `V` is `m`-saturated when the multiplication map `M → Hom_V(m, M)` is
bijective. Over a valuation domain whose maximal ideal `𝔪` is not finitely generated, the ring
and its cyclic torsion-free submodules are `𝔪`-saturated, while `𝔪` itself is not. -/
def IsValuationSaturated : Prop :=
  Function.Bijective (valuationSaturationMap V m M)

variable {V m M}

@[simp]
theorem valuationSaturationMap_apply (x : M) (a : m) :
    valuationSaturationMap V m M x a = (a : V) • x := by
  simp [valuationSaturationMap]

theorem isValuationSaturated_def :
    IsValuationSaturated V m M ↔ Function.Bijective (valuationSaturationMap V m M) :=
  Iff.rfl

/-- The multiplication map `M → Hom_V(m, M)` is injective exactly when no nonzero element of `M`
is killed by every element of `m`. -/
theorem valuationSaturationMap_injective_iff :
    Function.Injective (valuationSaturationMap V m M) ↔
      ∀ x : M, (∀ a ∈ m, a • x = 0) → x = 0 := by
  rw [injective_iff_map_eq_zero]
  refine forall_congr' fun x ↦ imp_congr_left ?_
  simp [LinearMap.ext_iff]

/-- `M` is `m`-saturated exactly when every `V`-linear map `m → M` is multiplication by a unique
element of `M`. -/
theorem isValuationSaturated_iff :
    IsValuationSaturated V m M ↔ ∀ f : m →ₗ[V] M, ∃! x : M, ∀ a : m, (a : V) • x = f a := by
  simp only [IsValuationSaturated, Function.bijective_iff_existsUnique, LinearMap.ext_iff,
    valuationSaturationMap_apply]

variable {N : Type*} [AddCommGroup N] [Module V N]

/-- Saturation is invariant under linear equivalence. -/
theorem isValuationSaturated_congr (e : M ≃ₗ[V] N) :
    IsValuationSaturated V m M ↔ IsValuationSaturated V m N := by
  have h : (e.congrRight : (m →ₗ[V] M) ≃ₗ[V] (m →ₗ[V] N)) ∘ valuationSaturationMap V m M =
      valuationSaturationMap V m N ∘ e := by
    ext x a
    simp
  rw [IsValuationSaturated, IsValuationSaturated, ← EquivLike.comp_bijective _ e.congrRight, h,
    EquivLike.bijective_comp]

/-- A zero module is saturated with respect to every ideal. -/
theorem isValuationSaturated_of_subsingleton [Subsingleton M] : IsValuationSaturated V m M :=
  ⟨Function.injective_of_subsingleton _, fun _ ↦ ⟨0, Subsingleton.elim _ _⟩⟩

variable (M) in
/-- Every module is saturated with respect to the unit ideal: `Hom_V(V, M) = M`. -/
theorem isValuationSaturated_top : IsValuationSaturated V ⊤ M := by
  refine isValuationSaturated_iff.2 fun f ↦ ⟨f ⟨1, trivial⟩, fun a ↦ ?_, fun x hx ↦ ?_⟩
  · rw [← map_smul]
    congr 1
    ext
    simp
  · simpa using hx ⟨1, trivial⟩

/-- Exactly the zero modules are saturated with respect to the zero ideal. -/
theorem isValuationSaturated_bot_iff : IsValuationSaturated V ⊥ M ↔ Subsingleton M := by
  refine ⟨fun h ↦ ?_, fun _ ↦ isValuationSaturated_of_subsingleton⟩
  refine ⟨fun x y ↦ ?_⟩
  have hzero : ∀ z : M, z = 0 := fun z ↦
    valuationSaturationMap_injective_iff.1 h.1 z fun a ha ↦ by simp [Ideal.mem_bot.1 ha]
  rw [hzero x, hzero y]

/-- For the principal ideal generated by a nonzerodivisor `π`, a module is saturated exactly when
multiplication by `π` is bijective on it. -/
theorem isValuationSaturated_ideal_span_singleton_iff {π : V} (hπ : π ∈ nonZeroDivisors V) :
    IsValuationSaturated V (Ideal.span {π}) M ↔ Function.Bijective (π • · : M → M) := by
  have h : Ideal.spanSingletonHomEquiv (M := M) hπ ∘ valuationSaturationMap V (Ideal.span {π}) M =
      (π • · : M → M) := by
    ext x
    simp
  rw [IsValuationSaturated, ← h, EquivLike.comp_bijective]

/-- A ring is saturated, as a module over itself, with respect to the principal ideal generated
by a nonzerodivisor `π` exactly when `π` is a unit. -/
theorem isValuationSaturated_ideal_span_singleton_self_iff {π : V} (hπ : π ∈ nonZeroDivisors V) :
    IsValuationSaturated V (Ideal.span {π}) V ↔ IsUnit π := by
  rw [isValuationSaturated_ideal_span_singleton_iff hπ]
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · obtain ⟨x, hx⟩ := h.2 1
    exact IsUnit.of_mul_eq_one x hx
  · simpa [smul_eq_mul] using (h.unit.mulLeft : V ≃ V).bijective

/-- A nonzero proper ideal `m` of a domain is not `m`-saturated (as a module over the domain): the
identity of `m` would be multiplication by an element of `m` acting as `1`. -/
theorem not_isValuationSaturated_ideal_self [IsDomain V] (hbot : m ≠ ⊥) (htop : m ≠ ⊤) :
    ¬ IsValuationSaturated V m m := by
  intro h
  obtain ⟨x, hx⟩ := h.2 LinearMap.id
  obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hbot
  have hax : a * x = a := by
    simpa using congrArg Subtype.val (LinearMap.congr_fun hx ⟨a, ha⟩)
  have hx1 : (x : V) = 1 := by
    simpa using mul_left_cancel₀ ha0 (hax.trans (mul_one a).symm)
  exact htop ((Ideal.eq_top_iff_one m).2 (hx1 ▸ x.2))

end Basic

section ValuationRing

variable {V : Type*} [CommRing V] [IsDomain V] [ValuationRing V]

/-- A valuation domain whose maximal ideal is not finitely generated is saturated with respect
to its maximal ideal. -/
theorem isValuationSaturated_maximalIdeal_self (hfg : ¬ (maximalIdeal V).FG) :
    IsValuationSaturated V (maximalIdeal V) V := by
  have hbot : maximalIdeal V ≠ ⊥ := fun h ↦ hfg (h ▸ Submodule.fg_bot)
  obtain ⟨b, hb, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hbot
  refine ⟨valuationSaturationMap_injective_iff.2 fun x hx ↦ ?_, fun f ↦ ?_⟩
  · exact (mul_eq_zero.1 (hx b hb)).resolve_left hb0
  -- `f` is `V`-linear, so `b * f a = a * f b` for all `a` in the maximal ideal.
  have hcomm (a : maximalIdeal V) : b * f a = a * f ⟨b, hb⟩ := by
    rw [← smul_eq_mul, ← map_smul, ← smul_eq_mul (a : V), ← map_smul]
    congr 1
    ext
    exact mul_comm _ _
  -- It suffices to show that `b` divides `f b`.
  suffices hdvd : b ∣ f ⟨b, hb⟩ by
    obtain ⟨x, hx⟩ := hdvd
    refine ⟨x, LinearMap.ext fun a ↦ ?_⟩
    rw [valuationSaturationMap_apply, smul_eq_mul]
    refine mul_left_cancel₀ hb0 ?_
    rw [hcomm a, hx]
    ring
  obtain h | ⟨u, hu⟩ := ValuationRing.dvd_total b (f ⟨b, hb⟩)
  · exact h
  by_cases hunit : IsUnit u
  · refine ⟨↑hunit.unit⁻¹, ?_⟩
    have h : f ⟨b, hb⟩ = f ⟨b, hb⟩ * u * ↑hunit.unit⁻¹ := by
      rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
    rw [h, ← hu]
  -- Otherwise `u` lies in the maximal ideal and generates it, contradicting `hfg`.
  have hfb : f ⟨b, hb⟩ ≠ 0 := fun h ↦ hb0 (by rw [hu, h, zero_mul])
  refine (hfg ⟨{u}, ?_⟩).elim
  rw [Finset.coe_singleton]
  refine le_antisymm (Ideal.span_le.2 (Set.singleton_subset_iff.2
    ((mem_maximalIdeal u).2 (mem_nonunits_iff.2 hunit)))) fun a ha ↦ ?_
  refine Ideal.mem_span_singleton'.2 ⟨f ⟨a, ha⟩, mul_left_cancel₀ hfb ?_⟩
  linear_combination hcomm ⟨a, ha⟩ - f ⟨a, ha⟩ * hu

/-- A valuation domain is saturated with respect to its maximal ideal exactly when that ideal is
not finitely generated. In particular a discrete valuation ring is not saturated. -/
theorem isValuationSaturated_maximalIdeal_self_iff :
    IsValuationSaturated V (maximalIdeal V) V ↔ ¬ (maximalIdeal V).FG := by
  refine ⟨fun h hfg ↦ ?_, isValuationSaturated_maximalIdeal_self⟩
  obtain ⟨π, hπ⟩ := (IsBezout.isPrincipal_of_FG _ hfg).principal
  rw [hπ, ← Ideal.span] at h
  by_cases hπ0 : π = 0
  · rw [hπ0, Ideal.span_singleton_eq_bot.2 rfl, isValuationSaturated_bot_iff] at h
    exact not_subsingleton V h
  · have hmem : π ∈ maximalIdeal V := by
      rw [hπ]
      exact Submodule.mem_span_singleton_self π
    exact mem_nonunits_iff.1 ((mem_maximalIdeal π).1 hmem)
      ((isValuationSaturated_ideal_span_singleton_self_iff
        (mem_nonZeroDivisors_of_ne_zero hπ0)).1 h)

/-- Over a valuation domain whose maximal ideal is not finitely generated, every cyclic submodule
of a torsion-free module is saturated with respect to the maximal ideal. For the fraction field
`K`, these are the principal lattices `a • V` in `K`, including `a = 0`. -/
theorem isValuationSaturated_span_singleton (hfg : ¬ (maximalIdeal V).FG)
    {M : Type*} [AddCommGroup M] [Module V M] [Module.IsTorsionFree V M] (x : M) :
    IsValuationSaturated V (maximalIdeal V) (V ∙ x) := by
  rcases eq_or_ne x 0 with rfl | hx
  · rw [Submodule.span_singleton_eq_bot.2 rfl]
    exact isValuationSaturated_of_subsingleton
  · exact (isValuationSaturated_congr (LinearEquiv.toSpanNonzeroSingleton V M x hx)).1
      (isValuationSaturated_maximalIdeal_self hfg)

end ValuationRing

end TauCeti
