/-!
# Extending a prime ideal along a map into a valuation ring

Let `f : V →+* W` be a ring homomorphism and `p` a prime ideal of `V`. This file studies the
extended ideal `p W = p.map f` and the primes of `W` lying over `p` when `V` and `W` are valuation
rings, and identifies the base changes of `V ⧸ p`, `V_p` and `κ(p)` along `f`.

In a valuation ring the ideals form a chain, so an ideal generated by the image of `p` has every
element divisible by the image of a single element of `p`. When moreover `V` is absolutely
integrally closed, every element of `p` has all its roots in `p`, which makes `p W` radical and
hence, if proper, prime. If also `ker f ≤ p`, then `p W` contracts to `p`. Among the ideals of `W`
contracting into `p` there is a greatest one `q`, and it is prime; it lies over `p` whenever `p W`
is proper. The primes `p W` and `q` need not coincide: for a field `V` inside a valuation domain
`W` and `p = 0`, the extension `p W` is zero whereas `q` is the maximal ideal of `W`.

The localization of `W` at the image of `V \ p`, that is `W ⊗[V] V_p`, is the localization of `W`
at `q`, and so the fibre `κ(p) ⊗[V] W` is `W_q ⧸ p W_q`. Together with Mathlib's
`Algebra.TensorProduct.quotIdealMapEquivTensorQuot`, identifying `W ⊗[V] (V ⧸ p)` with
`W ⧸ p W`, this describes the base change along `f` of the prime-splitting square
`V → V ⧸ p, V_p → κ(p)` in the case `ker f ≤ p`, `p W ≠ W`. This is what is needed to show
that this square remains a descent square after base change to a valuation ring.

## Main results

* `Ideal.mem_map_iff_exists_dvd`: for a map into a valuation ring, an element lies in `I.map f`
  if and only if it is divisible by the image of an element of `I`;
  `Ideal.mem_map_iff_exists_dvd_of_dvd_total` only asks that the images of elements of `I` be
  comparable for divisibility, as they are when the source is a valuation ring.
* `Ideal.IsRadical.isPrime_of_ne_top`: a proper radical ideal of a valuation ring is prime.
* `Ideal.isPrime_map_of_ne_top`: if `V` is absolutely integrally closed and `W` is a valuation
  domain, then a proper extension `p.map f` of a radical ideal `p`, such as a prime, is prime.
* `Ideal.comap_map_eq_self_of_ker_le_of_ne_top`: if `V` is a valuation ring, `W` is a domain,
  `ker f ≤ p` and `p.map f ≠ ⊤`, then `p.map f` contracts to `p`.
* `Ideal.exists_isGreatest_comap_le`, `Ideal.isPrime_of_isGreatest_comap_le` and
  `Ideal.comap_eq_of_isGreatest_comap_le`: the greatest ideal `q` contracting into `p`, its
  primality, and `q.comap f = p`; `Ideal.exists_isGreatest_isPrime_comap_eq` packages these as
  the existence of a largest prime over `p`. For a homomorphism of local rings and the maximal
  ideal of the source, `q` is the maximal ideal of the target
  (`Ideal.isGreatest_comap_le_maximalIdeal`).
* `IsLocalization.isLocalization_atPrime_of_isGreatest_comap_le`: a localization of `W` at the
  image of `V \ p` is a localization of `W` at `q`; in particular so is `W ⊗[V] V_p`
  (`IsLocalization.isLocalization_atPrime_tensorProduct_of_isGreatest_comap_le`).
* `Ideal.Fiber.algEquivQuotientLocalizationAtPrime`: the fibre `κ(p) ⊗[V] W` is isomorphic to
  `W_q ⧸ p W_q`.

## References

* B. Bhatt, A. Mathew, *The arc-topology*, Forum Math. Pi 9 (2021), Lemma 4.3.
-/

public section

open TauCeti

namespace Ideal

section PreValuationRing

variable {R S : Type*} [CommRing R] [CommRing S]

/-- If the images under `f` of any two elements of an ideal `I` are comparable for divisibility,
then an element lies in the extension `I.map f` if and only if it is divisible by `f a` for some
`a ∈ I`. This holds when the source or the target of `f` is a valuation ring. -/
theorem mem_map_iff_exists_dvd_of_dvd_total (f : R →+* S) {I : Ideal R}
    (h : ∀ a ∈ I, ∀ b ∈ I, f a ∣ f b ∨ f b ∣ f a) {x : S} :
    x ∈ I.map f ↔ ∃ a ∈ I, f a ∣ x := by
  refine ⟨fun hx ↦ ?_, fun ⟨a, ha, hax⟩ ↦ mem_of_dvd _ hax (mem_map_of_mem f ha)⟩
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, ha, rfl⟩ := hy
    exact ⟨a, ha, dvd_rfl⟩
  | zero => exact ⟨0, I.zero_mem, dvd_zero _⟩
  | add y z _ _ hy hz =>
    obtain ⟨a, ha, hay⟩ := hy
    obtain ⟨b, hb, hbz⟩ := hz
    rcases h a ha b hb with h | h
    · exact ⟨a, ha, dvd_add hay (h.trans hbz)⟩
    · exact ⟨b, hb, dvd_add (h.trans hay) hbz⟩
  | smul r y _ hy =>
    obtain ⟨a, ha, hay⟩ := hy
    exact ⟨a, ha, hay.mul_left r⟩

/-- For a ring homomorphism `f` into a valuation ring, an element lies in the extension
`I.map f` of an ideal `I` if and only if it is divisible by `f a` for some `a ∈ I`. -/
theorem mem_map_iff_exists_dvd [PreValuationRing S] (f : R →+* S) {I : Ideal R} {x : S} :
    x ∈ I.map f ↔ ∃ a ∈ I, f a ∣ x :=
  mem_map_iff_exists_dvd_of_dvd_total f fun _ _ _ _ ↦ ValuationRing.dvd_total _ _

variable [PreValuationRing S]

/-- In a valuation ring a proper radical ideal is prime. -/
theorem IsRadical.isPrime_of_ne_top {I : Ideal S} (hI : I.IsRadical) (htop : I ≠ ⊤) :
    I.IsPrime := by
  refine ⟨htop, fun {x y} hxy ↦ ?_⟩
  -- One of `x` and `y` divides the other, and then the square of the multiple lies in `I`.
  obtain ⟨c, rfl⟩ | ⟨c, rfl⟩ := ValuationRing.dvd_total x y
  · exact .inr (hI ⟨2, by simpa [pow_two, mul_assoc, mul_left_comm] using I.mul_mem_right c hxy⟩)
  · exact .inl (hI ⟨2, by simpa [pow_two, mul_assoc, mul_left_comm] using I.mul_mem_right c hxy⟩)

end PreValuationRing

variable {V W : Type*} [CommRing V] [CommRing W] (f : V →+* W)

/-- If `V` is absolutely integrally closed and `W` is a valuation domain, then the extension along
any `f : V →+* W` of a radical ideal of `V` is radical. -/
theorem isRadical_map [IsAbsolutelyIntegrallyClosed V] [IsDomain W] [ValuationRing W]
    {p : Ideal V} (hp : p.IsRadical) : (p.map f).IsRadical := by
  have := (ValuationRing.integers W (FractionRing W)).isIntegrallyClosed
  rintro x ⟨_ | n, hx⟩
  · rw [pow_zero] at hx
    simp [eq_top_of_isUnit_mem _ hx isUnit_one]
  -- If `f a ∣ x ^ (n + 1)` with `a ∈ p`, take `b` with `b ^ (n + 1) = a`; then `b ∈ p` and
  -- `f b ∣ x`, as `W` is integrally closed.
  obtain ⟨a, ha, hax⟩ := (mem_map_iff_exists_dvd f).mp hx
  obtain ⟨b, hba⟩ := IsAbsolutelyIntegrallyClosed.exists_pow_nat_eq a n.succ_pos
  refine (mem_map_iff_exists_dvd f).mpr ⟨b, hp ⟨n + 1, hba ▸ ha⟩, ?_⟩
  exact (IsIntegrallyClosed.pow_dvd_pow_iff n.succ_ne_zero).mp (by rwa [← map_pow, hba])

/-- If `V` is absolutely integrally closed and `W` is a valuation domain, then the extension along
any `f : V →+* W` of a radical ideal of `V`, for instance of a prime ideal, is prime as soon as it
is proper. -/
theorem isPrime_map_of_ne_top [IsAbsolutelyIntegrallyClosed V] [IsDomain W] [ValuationRing W]
    {p : Ideal V} (hp : p.IsRadical) (htop : p.map f ≠ ⊤) : (p.map f).IsPrime :=
  (isRadical_map f hp).isPrime_of_ne_top htop

/-- If `V` is a valuation ring, `W` is a domain, `p` is a prime of `V` containing the kernel of
`f : V →+* W` and the extension `p.map f` is proper, then `p.map f` contracts to `p`. -/
theorem comap_map_eq_self_of_ker_le_of_ne_top [PreValuationRing V] [IsDomain W] {p : Ideal V}
    [hp : p.IsPrime] (hker : RingHom.ker f ≤ p) (htop : p.map f ≠ ⊤) : (p.map f).comap f = p := by
  refine le_antisymm (fun a ha ↦ ?_) le_comap_map
  by_contra hap
  -- Write `f a = f b * w` with `b ∈ p`. As `a ∉ p`, `b = a * c` with `c ∈ p`; cancelling the
  -- nonzero `f a` shows that `f c` is a unit.
  obtain ⟨b, hb, w, hw⟩ := (mem_map_iff_exists_dvd_of_dvd_total f
    fun a _ b _ ↦ (ValuationRing.dvd_total a b).imp (map_dvd f) (map_dvd f)).mp (mem_comap.mp ha)
  obtain ⟨c, rfl⟩ := (ValuationRing.dvd_total a b).resolve_right fun h ↦ hap (p.mem_of_dvd h hb)
  have hc : c ∈ p := (hp.mem_or_mem hb).resolve_left hap
  have hfa : f a ≠ 0 := fun h ↦ hap (hker h)
  rw [map_mul, mul_assoc] at hw
  have h1 : f c * w = 1 := (mul_eq_left₀ hfa).mp hw.symm
  exact htop (eq_top_of_isUnit_mem _ (mem_map_of_mem f hc) (.of_mul_eq_one _ h1))

/-- If `W` is a valuation ring and the ideal `p` of `V` contains the kernel of `f : V →+* W`, then
among the ideals of `W` whose contraction is contained in `p` there is a greatest one. -/
theorem exists_isGreatest_comap_le [PreValuationRing W] (p : Ideal V)
    (hker : RingHom.ker f ≤ p) : ∃ q : Ideal W, IsGreatest {J : Ideal W | J.comap f ≤ p} q := by
  -- These ideals form a nonempty chain, so their supremum is their union.
  have := PreValuationRing.iff_ideal_total.mp ‹_›
  have hne : {J : Ideal W | J.comap f ≤ p}.Nonempty := ⟨⊥, hker⟩
  have hdir : DirectedOn (· ≤ ·) {J : Ideal W | J.comap f ≤ p} := fun I hI J hJ ↦
    (total_of (· ≤ ·) I J).elim (fun h ↦ ⟨J, hJ, h, le_rfl⟩) fun h ↦ ⟨I, hI, le_rfl, h⟩
  refine ⟨sSup _, fun x hx ↦ ?_, fun J hJ ↦ le_sSup hJ⟩
  obtain ⟨J, hJ, hxJ⟩ := (Submodule.mem_sSup_of_directed hne hdir).mp hx
  exact hJ hxJ

/-- The greatest ideal of `W` whose contraction along `f : V →+* W` is contained in a prime `p`
of `V` is prime. -/
theorem isPrime_of_isGreatest_comap_le {p : Ideal V} [p.IsPrime] {q : Ideal W}
    (hq : IsGreatest {J : Ideal W | J.comap f ≤ p} q) : q.IsPrime :=
  isPrime_of_maximally_disjoint q (p.primeCompl.map f)
    (disjoint_map_primeCompl_iff_comap_le.mpr hq.1)
    fun _ hJ hdisj ↦ hJ.not_ge (hq.2 (disjoint_map_primeCompl_iff_comap_le.mp hdisj))

/-- If `V` is a valuation ring, `W` is a domain, `p` is a prime of `V` and `p.map f ≠ ⊤`, then the
greatest ideal of `W` contracting into `p` along `f : V →+* W` lies over `p`. -/
theorem comap_eq_of_isGreatest_comap_le [PreValuationRing V] [IsDomain W] {p : Ideal V}
    [p.IsPrime] {q : Ideal W} (hq : IsGreatest {J : Ideal W | J.comap f ≤ p} q)
    (htop : p.map f ≠ ⊤) : q.comap f = p := by
  have h := comap_map_eq_self_of_ker_le_of_ne_top f ((comap_mono bot_le).trans hq.1) htop
  exact hq.1.antisymm (h.symm.le.trans (comap_mono (hq.2 h.le)))

/-- Let `f : V →+* W` be a map of valuation rings with `W` a domain, and `p` a prime of `V`
containing `ker f` with `p.map f ≠ ⊤`. Then there is a largest prime of `W` lying over `p`. -/
theorem exists_isGreatest_isPrime_comap_eq [PreValuationRing V] [IsDomain W] [PreValuationRing W]
    (p : Ideal V) [p.IsPrime] (hker : RingHom.ker f ≤ p) (htop : p.map f ≠ ⊤) :
    ∃ q : Ideal W, IsGreatest {Q : Ideal W | Q.IsPrime ∧ Q.comap f = p} q := by
  obtain ⟨q, hq⟩ := exists_isGreatest_comap_le f p hker
  exact ⟨q, ⟨isPrime_of_isGreatest_comap_le f hq, comap_eq_of_isGreatest_comap_le f hq htop⟩,
    fun Q hQ ↦ hq.2 hQ.2.le⟩

/-- For any homomorphism `f` of local rings, the maximal ideal of the target is the greatest ideal
contracting into the maximal ideal of the source. For instance, if `V` is a field inside a
local domain `W` and `p = 0`, then `p.map f = 0` while the greatest ideal of `W` contracting into
`p` is the maximal ideal of `W`. -/
theorem isGreatest_comap_le_maximalIdeal [IsLocalRing V] [IsLocalRing W] :
    IsGreatest {J : Ideal W | J.comap f ≤ IsLocalRing.maximalIdeal V}
      (IsLocalRing.maximalIdeal W) :=
  ⟨IsLocalRing.le_maximalIdeal (comap_ne_top f (IsLocalRing.maximalIdeal.isMaximal W).ne_top),
    fun J hJ ↦ IsLocalRing.le_maximalIdeal fun h ↦
    (IsLocalRing.maximalIdeal.isMaximal V).ne_top (top_le_iff.mp (by simpa [h] using hJ))⟩

end Ideal

namespace IsLocalization

variable {V W : Type*} [CommRing V] [CommRing W] [Algebra V W] {p : Ideal V} [p.IsPrime]
  {q : Ideal W} [q.IsPrime]

/-- Let `W` be an algebra over `V`, `p` a prime of `V` and `q` the greatest ideal of `W`
contracting into `p` (which is prime by `Ideal.isPrime_of_isGreatest_comap_le`). Then a
localization of `W` at the image of `V \ p` is a localization of `W` at `q`. -/
theorem isLocalization_atPrime_of_isGreatest_comap_le
    (hq : IsGreatest {J : Ideal W | J.comap (algebraMap V W) ≤ p} q) (S : Type*) [CommRing S]
    [Algebra W S] [IsLocalization (Algebra.algebraMapSubmonoid W p.primeCompl) S] :
    IsLocalization.AtPrime S q := by
  refine of_le (Algebra.algebraMapSubmonoid W p.primeCompl) _
    (fun t ht htq ↦ Set.disjoint_left.mp (Ideal.disjoint_map_primeCompl_iff_comap_le.mpr hq.1)
      htq ht) fun w hw ↦ ?_
  -- Otherwise `w` lies in a maximal ideal of `S`, whose contraction to `W` is an ideal disjoint
  -- from the image of `V \ p`, hence contained in `q`.
  by_contra hu
  obtain ⟨M, hM, hwM⟩ := exists_max_ideal_of_mem_nonunits hu
  have hdisj := ((isPrime_iff_isPrime_disjoint (Algebra.algebraMapSubmonoid W p.primeCompl) S
    M).mp hM.isPrime).2.symm
  exact hw (hq.2 (Ideal.disjoint_map_primeCompl_iff_comap_le.mp hdisj) hwM)

/-- Let `W` be a valuation ring over `V`, `p` a prime of `V` and `q` the greatest ideal of `W`
contracting into `p`. Then `W ⊗[V] V_p` is a localization of `W` at `q`. -/
theorem isLocalization_atPrime_tensorProduct_of_isGreatest_comap_le
    (hq : IsGreatest {J : Ideal W | J.comap (algebraMap V W) ≤ p} q) :
    IsLocalization.AtPrime (TensorProduct V W (Localization.AtPrime p)) q :=
  isLocalization_atPrime_of_isGreatest_comap_le hq _

end IsLocalization

namespace Ideal

variable {V W : Type*} [CommRing V] [CommRing W] [Algebra V W] (p : Ideal V) [p.IsPrime]
  {q : Ideal W} [q.IsPrime]

open IsLocalization in
/-- Let `W` be a valuation ring over `V`, `p` a prime of `V` and `q` the greatest ideal of `W`
contracting into `p`. Then the fibre `κ(p) ⊗[V] W` of `p` is isomorphic, as a `W`-algebra, to the
quotient `W_q ⧸ p W_q`. -/
noncomputable def Fiber.algEquivQuotientLocalizationAtPrime
    (hq : IsGreatest {J : Ideal W | J.comap (algebraMap V W) ≤ p} q) :
    letI : Algebra W (p.Fiber W) := Algebra.TensorProduct.rightAlgebra
    p.Fiber W ≃ₐ[W] Localization.AtPrime q ⧸
      (p.map (algebraMap V W)).map (algebraMap W (Localization.AtPrime q)) :=
  letI : Algebra W (p.Fiber W) := Algebra.TensorProduct.rightAlgebra
  haveI := isLocalization_atPrime_of_isGreatest_comap_le hq
    (Localization (Algebra.algebraMapSubmonoid W p.primeCompl))
  (Fiber.algEquivAux₁ p).trans <| quotientEquivAlg _ _ (IsLocalization.algEquiv q.primeCompl
    (Localization (Algebra.algebraMapSubmonoid W p.primeCompl)) (Localization.AtPrime q)) <| by
      simp only [map_map]
      congr 1
      ext
      simp

end Ideal
