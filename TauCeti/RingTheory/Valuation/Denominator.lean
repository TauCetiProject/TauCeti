/-!
# Denominators of values of an extended valuation and the integral normalisation

Let `v` be a real additive valuation on a ring `K` taking integer values on nonzero elements, such
as a discrete valuation normalised at a uniformiser, and let `w` be a real additive valuation on a
`K`-algebra `L` restricting to `v`. A value `w α = q` need not be an integer, and this file bounds
the denominator of a rational value `q` in two ways.

* If `e • w` takes integer values on the nonzero elements of `L`, then `q.den ∣ e`. For a finite
  extension of discretely valued fields, `e • w` is the integral normalisation of the valuation of
  `L` exactly when `e` is the ramification index, so the denominator of the base-normalised
  valuation of an element divides the ramification index.
* The powers `1, α, …, α ^ (q.den - 1)` are linearly independent over `K`, because the values of
  their nonzero multiples lie in the distinct classes `i * q + ℤ`. Hence `q.den ≤ [L : K]`. For an
  element of value `1 / e`, such as a uniformiser of the integral normalisation `e • w`, this is
  the inequality `e ≤ [L : K]` between the ramification index and the degree.

The same independence argument applies to a real value `t`: if no multiple `k * t` with
`0 < k < N` is an integer, the first `N` powers of an element of value `t` are linearly
independent. When `v π = 1` for some `π` and `L` is a division ring of finite dimension over `K`,
this rules out positive values of `w` below `1 / ([L : K] + 1)`, so the values of `w` on the
nonzero elements of `L` form a discrete subgroup of `ℝ` containing `1`. It is generated by `1 / e`
for a unique `e` with `0 < e ≤ [L : K]`: the valuation `w` is discrete, `e • w` is its integral
normalisation, restricting to `e • v` on `K`, and `e` is the ramification index.

No completeness and no hypothesis on the residue field is used.

## Main results

* `AddValuation.den_dvd_of_map_eq_ratCast`: if `e • w` is integer valued on nonzero elements, the
  denominator of every rational value of `w` divides `e`.
* `AddValuation.linearIndependent_pow_of_map_eq` and
  `AddValuation.linearIndependent_pow_of_map_eq_ratCast`: the first `N` powers of an element of
  value `t` are linearly independent over `K` when no `k * t` with `0 < k < N` is an integer; in
  particular the first `q.den` powers of an element of rational value `q` are.
* `AddValuation.den_le_finrank_of_map_eq_ratCast`: the denominator of a rational value of `w` is
  at most `[L : K]`.
* `AddValuation.le_finrank_of_map_eq_inv_natCast`: an element of value `1 / e` forces
  `e ≤ [L : K]`.
* `AddValuation.existsUnique_forall_map_eq_intCast_div`: over a finite extension, the values of
  `w` on nonzero elements are exactly the multiples of `1 / e` for a unique `e` with
  `0 < e ≤ [L : K]`, the ramification index.

## References

* J. Neukirch, *Algebraic Number Theory*, Grundlehren 322, Springer, 1999, Chapter II, §6, in
  particular Proposition 6.8.
* J.-P. Serre, *Local Fields*, Graduate Texts in Mathematics 67, Springer, 1979, Chapter I, §4 and
  Chapter II, §2.
-/

public section

namespace AddValuation

section Integral

variable {L : Type*} [Ring L] {w : AddValuation L (WithTop ℝ)}

/-- **Denominators of values divide the ramification index.** If `e • w` takes integer values on
the nonzero elements of `L`, the denominator of every rational value `w α = q` divides `e`. For a
valuation extending a base-normalised discrete valuation, `e • w` is the integral normalisation
when `e` is the ramification index. -/
theorem den_dvd_of_map_eq_ratCast {e : ℕ}
    (hL : ∀ y : L, y ≠ 0 → ∃ n : ℤ, w y = ((n / e : ℝ) : WithTop ℝ)) {α : L} {q : ℚ}
    (hα : w α = ((q : ℝ) : WithTop ℝ)) : q.den ∣ e := by
  rcases eq_or_ne e 0 with rfl | he
  · exact dvd_zero _
  have hα₀ : α ≠ 0 := by
    rintro rfl
    simp at hα
  obtain ⟨n, hn⟩ := hL α hα₀
  rw [hα, WithTop.coe_inj] at hn
  exact (Rat.den_dvd_iff_exists_eq_intCast_div he).2 ⟨n, by exact_mod_cast hn⟩

end Integral

section Extension

variable {K L : Type*} [CommRing K] [Ring L] [Algebra K L] {v : AddValuation K (WithTop ℝ)}
  {w : AddValuation L (WithTop ℝ)}

/-- If `w` restricts to a valuation `v` taking integer values on nonzero elements, `w α = t`, and
no multiple `k * t` with `0 < k < N` is an integer, the powers `α ^ i` for `i < N` are linearly
independent over `K`. The value of a nonzero multiple `a • α ^ i` is `v a + i * t`, and these lie in
distinct classes modulo `ℤ`. -/
theorem linearIndependent_pow_of_map_eq
    (hint : ∀ x : K, x ≠ 0 → ∃ n : ℤ, v x = ((n : ℝ) : WithTop ℝ))
    (hw : ∀ x, w (algebraMap K L x) = v x) {α : L} {t : ℝ} (hα : w α = (t : WithTop ℝ)) {N : ℕ}
    (hN : ∀ k : ℕ, 0 < k → k < N → ∀ n : ℤ, (k : ℝ) * t ≠ n) :
    LinearIndependent K fun i : Fin N ↦ α ^ (i : ℕ) := by
  have hval : ∀ (i : ℕ) (a : K), a ≠ 0 →
      ∃ n : ℤ, w (a • α ^ i) = (((n : ℝ) + i * t : ℝ) : WithTop ℝ) := fun i a ha ↦ by
    obtain ⟨n, hn⟩ := hint a ha
    refine ⟨n, ?_⟩
    rw [Algebra.smul_def, map_mul, hw, hn, map_pow, hα, ← WithTop.coe_nsmul, ← WithTop.coe_add,
      nsmul_eq_mul]
  refine w.toValuation.linearIndependent_of_map_smul_ne (fun i a ha ↦ ?_)
    fun i j hij a b ha hb ↦ ?_
  · obtain ⟨n, hn⟩ := hval i a ha
    rw [Ne, ← w.toValuation.map_zero, toValuation_apply, toValuation_apply, hn, map_zero]
    exact fun h ↦ WithTop.coe_ne_top (OrderDual.toDual.injective (Multiplicative.ofAdd.injective h))
  · obtain ⟨m, hm⟩ := hval i a ha
    obtain ⟨n, hn⟩ := hval j b hb
    rw [toValuation_apply, toValuation_apply, hm, hn]
    intro h
    have h' : ((m : ℝ) + (i : ℕ) * t : ℝ) = (n : ℝ) + (j : ℕ) * t :=
      WithTop.coe_inj.mp (OrderDual.toDual.injective (Multiplicative.ofAdd.injective h))
    -- The difference `(j - i) * t` of the two values is the integer `m - n`.
    have hi := i.isLt
    have hj := j.isLt
    rcases lt_or_gt_of_ne (Fin.val_ne_of_ne hij) with hlt | hlt
    · refine hN ((j : ℕ) - i) (by omega) (by omega) (m - n) ?_
      push_cast [hlt.le]
      linarith
    · refine hN ((i : ℕ) - j) (by omega) (by omega) (n - m) ?_
      push_cast [hlt.le]
      linarith

/-- If `w` restricts to a valuation `v` taking integer values on nonzero elements, and `w α = q`
is rational, the powers `α ^ i` for `i < q.den` are linearly independent over `K`. -/
theorem linearIndependent_pow_of_map_eq_ratCast
    (hint : ∀ x : K, x ≠ 0 → ∃ n : ℤ, v x = ((n : ℝ) : WithTop ℝ))
    (hw : ∀ x, w (algebraMap K L x) = v x) {α : L} {q : ℚ} (hα : w α = ((q : ℝ) : WithTop ℝ)) :
    LinearIndependent K fun i : Fin q.den ↦ α ^ (i : ℕ) := by
  refine linearIndependent_pow_of_map_eq hint hw hα fun k hk hkq n h ↦ ?_
  -- An integer multiple `k * q` forces `q.den ∣ k`, impossible for `0 < k < q.den`.
  have hdvd := Rat.den_dvd_of_intCast_eq_mul_intCast q (a := k) (a' := n) (by
    have : ((n : ℤ) : ℝ) = q * ((k : ℤ) : ℝ) := by push_cast; linarith
    exact_mod_cast this)
  have := Int.le_of_dvd (by omega) hdvd
  omega

variable [Module.Finite K L]

/-- If `w` restricts to a valuation `v` taking integer values on nonzero elements, the denominator
of a rational value of `w` is at most the degree `[L : K]`. -/
theorem den_le_finrank_of_map_eq_ratCast
    (hint : ∀ x : K, x ≠ 0 → ∃ n : ℤ, v x = ((n : ℝ) : WithTop ℝ))
    (hw : ∀ x, w (algebraMap K L x) = v x) {α : L} {q : ℚ} (hα : w α = ((q : ℝ) : WithTop ℝ)) :
    q.den ≤ Module.finrank K L := by
  rcases subsingleton_or_nontrivial K with hK | hK
  · -- the hypotheses are contradictory: `L` is trivial, so `α = 0` has value `⊤`
    rw [← one_smul K α, Subsingleton.elim (1 : K) 0, zero_smul, AddValuation.map_zero] at hα
    exact absurd hα (WithTop.top_ne_coe)
  simpa using (linearIndependent_pow_of_map_eq_ratCast hint hw hα).fintype_card_le_finrank

/-- **The ramification index is at most the degree.** If `w` restricts to a valuation `v` taking
integer values on nonzero elements and some element has value `1 / e`, then `e ≤ [L : K]`. When
`e • w` is the integral normalisation of the valuation of `L`, such an element is a uniformiser
and `e` is the ramification index. -/
theorem le_finrank_of_map_eq_inv_natCast
    (hint : ∀ x : K, x ≠ 0 → ∃ n : ℤ, v x = ((n : ℝ) : WithTop ℝ))
    (hw : ∀ x, w (algebraMap K L x) = v x) {ϖ : L} {e : ℕ}
    (hϖ : w ϖ = (((e : ℝ)⁻¹ : ℝ) : WithTop ℝ)) : e ≤ Module.finrank K L := by
  rcases Nat.eq_zero_or_pos e with rfl | he
  · exact Nat.zero_le _
  have h := den_le_finrank_of_map_eq_ratCast (q := (e : ℚ)⁻¹) hint hw
    (by rw [hϖ, Rat.cast_inv, Rat.cast_natCast])
  rwa [Rat.inv_natCast_den_of_pos he] at h

end Extension

section Normalization

variable {K L : Type*} [CommRing K] [DivisionRing L] [Algebra K L] {v : AddValuation K (WithTop ℝ)}
  {w : AddValuation L (WithTop ℝ)}

/-- The real values taken by `w` on the nonzero elements of `L`, as an additive subgroup of `ℝ`. -/
private def valueAddSubgroup (w : AddValuation L (WithTop ℝ)) : AddSubgroup ℝ where
  carrier := {t | ∃ y : L, y ≠ 0 ∧ w y = (t : WithTop ℝ)}
  zero_mem' := ⟨1, one_ne_zero, by simp⟩
  add_mem' := fun ⟨y, hy, ha⟩ ⟨z, hz, hb⟩ ↦
    ⟨y * z, mul_ne_zero hy hz, by rw [map_mul, ha, hb, WithTop.coe_add]⟩
  neg_mem' := fun ⟨y, hy, ha⟩ ↦
    ⟨y⁻¹, inv_ne_zero hy, by rw [map_inv, ha, WithTop.LinearOrderedAddCommGroup.coe_neg]⟩

/-- A real number lies in `valueAddSubgroup w` exactly when it is the value of a nonzero element. -/
private theorem mem_valueAddSubgroup {t : ℝ} :
    t ∈ valueAddSubgroup w ↔ ∃ y : L, y ≠ 0 ∧ w y = (t : WithTop ℝ) :=
  Iff.rfl

/-- An element of value `1 / e` under a valuation whose nonzero values are multiples of `1 / e'`
forces `e ∣ e'`. -/
private theorem dvd_of_map_eq_inv_natCast {e e' : ℕ} (he : 0 < e)
    (hL : ∀ y : L, y ≠ 0 → ∃ n : ℤ, w y = ((n / e' : ℝ) : WithTop ℝ)) {ϖ : L}
    (hϖ : w ϖ = (((e : ℝ)⁻¹ : ℝ) : WithTop ℝ)) : e ∣ e' := by
  have h := den_dvd_of_map_eq_ratCast (q := (e : ℚ)⁻¹) hL
    (by rw [hϖ, Rat.cast_inv, Rat.cast_natCast])
  rwa [Rat.inv_natCast_den_of_pos he] at h

variable [Module.Finite K L]

/-- **The integral normalisation of an extension of a discrete valuation.** Let `v` take integer
values on the nonzero elements of `K`, with `v π = 1` for some `π`, and let `w` restrict to `v`
on a division ring `L` of finite dimension over `K`. Then there is a unique `e`, satisfying
`0 < e ≤ [L : K]`, such that the values of `w` on the nonzero elements of `L` are exactly the
multiples of `1 / e`: they are all of the form `n / e`, and some element `ϖ` has value `1 / e`.
So `e • w` is an integer-valued valuation taking the value one at `ϖ` and restricting to `e • v`
on `K`, and `e` is the ramification index of `w` over `v`. -/
theorem existsUnique_forall_map_eq_intCast_div
    (hint : ∀ x : K, x ≠ 0 → ∃ n : ℤ, v x = ((n : ℝ) : WithTop ℝ)) {π : K} (hπ : v π = 1)
    (hw : ∀ x, w (algebraMap K L x) = v x) :
    ∃! e : ℕ, 0 < e ∧ e ≤ Module.finrank K L ∧
      (∃ ϖ : L, w ϖ = (((e : ℝ)⁻¹ : ℝ) : WithTop ℝ)) ∧
      ∀ y : L, y ≠ 0 → ∃ n : ℤ, w y = ((n / e : ℝ) : WithTop ℝ) := by
  have : Nontrivial K := ⟨⟨π, 0, fun h ↦ by simp [h] at hπ⟩⟩
  set G := valueAddSubgroup w
  have h1 : (1 : ℝ) ∈ G := mem_valueAddSubgroup.2
    ⟨algebraMap K L π, ne_of_apply_ne w (by rw [hw, hπ, map_zero]; exact WithTop.one_ne_top),
      by rw [hw, hπ, WithTop.coe_one]⟩
  -- If `0 < t < 1 / (n + 1)` were a value of `w`, with `n = [L : K]`, no multiple `k * t` with
  -- `0 < k ≤ n` would be an integer, so the `n + 1` powers of an element of value `t` would be
  -- linearly independent over `K`.
  have hdisj : Disjoint (G : Set ℝ) (Set.Ioo 0 (1 / (Module.finrank K L + 1))) := by
    rw [Set.disjoint_left]
    rintro t htG ⟨ht0, ht⟩
    obtain ⟨α, -, hα⟩ := mem_valueAddSubgroup.1 htG
    have hli := linearIndependent_pow_of_map_eq (N := Module.finrank K L + 1) hint hw hα
      fun k hk hkn m hm ↦ by
        have hkt : (k : ℝ) * t < 1 := by
          rw [lt_div_iff₀ (by positivity)] at ht
          have hk' : (k : ℝ) ≤ Module.finrank K L := by exact_mod_cast Nat.lt_succ_iff.mp hkn
          nlinarith
        have hm0 : (0 : ℝ) < m := hm ▸ mul_pos (by exact_mod_cast hk) ht0
        have hm1 : (1 : ℝ) ≤ m := by exact_mod_cast Int.cast_pos.mp hm0
        linarith
    simpa using hli.fintype_card_le_finrank
  -- So the values of `w` form a cyclic group, generated by its least positive element `g`, and
  -- `1 = k * g` for some positive integer `k`.
  have hbot : G ≠ ⊥ := fun h ↦ one_ne_zero ((AddSubgroup.mem_bot).1 (h ▸ h1))
  obtain ⟨g, hg⟩ := AddSubgroup.exists_isLeast_pos hbot (by positivity) hdisj
  have hG := AddSubgroup.zmultiples_eq_of_isLeast_mem_and_pos hg
  obtain ⟨⟨hgG, hg0⟩, -⟩ := hg
  obtain ⟨ϖ, -, hϖ⟩ := mem_valueAddSubgroup.1 hgG
  rw [← hG] at h1
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 h1
  rw [zsmul_eq_mul] at hk
  have hk0 : 0 < k := Int.cast_pos.mp (pos_of_mul_pos_left (hk ▸ one_pos) hg0.le)
  have hke : ((k.toNat : ℕ) : ℝ) = k := by exact_mod_cast Int.toNat_of_nonneg hk0.le
  have hge : g = ((k.toNat : ℕ) : ℝ)⁻¹ := by rw [hke]; exact eq_inv_of_mul_eq_one_right hk
  rw [hge] at hϖ
  have hall : ∀ y : L, y ≠ 0 → ∃ n : ℤ, w y = ((n / k.toNat : ℝ) : WithTop ℝ) := fun y hy ↦ by
    obtain ⟨t, ht⟩ := WithTop.ne_top_iff_exists.1 (w.ne_top_iff.2 hy)
    have htG : t ∈ G := mem_valueAddSubgroup.2 ⟨y, hy, ht.symm⟩
    rw [← hG] at htG
    obtain ⟨m, hm⟩ := AddSubgroup.mem_zmultiples_iff.1 htG
    exact ⟨m, by rw [← ht, ← hm, zsmul_eq_mul, hge, div_eq_mul_inv]⟩
  refine ⟨k.toNat, ⟨by omega, le_finrank_of_map_eq_inv_natCast hint hw hϖ, ⟨ϖ, hϖ⟩, hall⟩,
    fun e ⟨he, _, ⟨ϖ', hϖ'⟩, hall'⟩ ↦ ?_⟩
  exact Nat.dvd_antisymm (dvd_of_map_eq_inv_natCast he hall hϖ')
    (dvd_of_map_eq_inv_natCast (by omega) hall' hϖ)

end Normalization

end AddValuation

