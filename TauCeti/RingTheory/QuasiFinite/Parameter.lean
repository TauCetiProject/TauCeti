module

public import Mathlib.RingTheory.ZariskisMainTheorem
public import TauCeti.RingTheory.KrullDimension.Parameter

/-!
# Quasi-finite coordinates at closed points

A function on an affine curve whose zero fibre is finite defines a quasi-finite map to
the affine line at every point of that fibre. In particular, a closed point of an affine
curve admits such a coordinate over an arbitrary field, including a finite field.

The general criterion `Algebra.QuasiFiniteAt.of_quasiFinite_quotient` allows one to check
quasi-finiteness at a prime using a quasi-finite quotient by any ideal contained in the
extension of the contraction of that prime to the base.
It is useful for lifting coordinates from a special fibre.

## References

* The Stacks Project, Lemma 55.8.2, https://stacks.math.columbia.edu/tag/0C2T.
* Mathlib's `Algebra.QuasiFiniteAt.of_weaklyQuasiFiniteAt`, the algebraic Zariski main
  theorem identifying quasi-finiteness with isolation in a fibre.
-/

public section

open Polynomial

namespace Algebra.QuasiFiniteAt

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- A finite type algebra is quasi-finite at a prime `q` if its quotient by an ideal
contained in the extension of `q.under R` is quasi-finite over the base. -/
theorem of_quasiFinite_quotient [Algebra.FiniteType R A] (q : Ideal A) [q.IsPrime]
    (I : Ideal A) [Algebra.QuasiFinite R (A ⧸ I)]
    (hI : I ≤ (q.under R).map (algebraMap R A)) : Algebra.QuasiFiniteAt R q := by
  have : Algebra.QuasiFinite R (A ⧸ (q.under R).map (algebraMap R A)) :=
    .of_surjective_algHom (Ideal.Quotient.factorₐ R hI) (Ideal.Quotient.factor_surjective hI)
  have : Algebra.WeaklyQuasiFiniteAt R q := inferInstance
  exact .of_weaklyQuasiFiniteAt q

end Algebra.QuasiFiniteAt

namespace AlgHom

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A]

/-- A coordinate on a quotient with quasi-finite zero fibre lifts to a quasi-finite
coordinate at every prime `q` containing the lift `x` such that the kernel is contained in
the ideal generated by base elements vanishing at `q`. -/
theorem quasiFiniteAt_aeval [Algebra.FiniteType k A]
    {B : Type*} [CommRing B] [Algebra k B] (f : A →ₐ[k] B)
    (hf : Function.Surjective f) (x : A)
    [Algebra.QuasiFinite k (B ⧸ Ideal.span {f x})] (q : Ideal A) [q.IsPrime]
    (hx : x ∈ q) (hker : RingHom.ker f ≤ (q.under k).map (algebraMap k A)) :
    letI := (aeval (R := k) x).toAlgebra
    Algebra.QuasiFiniteAt k[X] q := by
  let := (aeval (R := k) x).toAlgebra
  have : IsScalarTower k k[X] A := IsScalarTower.of_algHom (aeval (R := k) x)
  have : Algebra.FiniteType k[X] A := .of_restrictScalars_finiteType k k[X] A
  let g := (Ideal.Quotient.mkₐ k (Ideal.span {f x})).comp f
  have hg : Function.Surjective g := Ideal.Quotient.mk_surjective.comp hf
  have : Algebra.QuasiFinite k (A ⧸ RingHom.ker g) :=
    (Algebra.QuasiFinite.iff_of_algEquiv (Ideal.quotientKerAlgEquivOfSurjective hg)).mpr ‹_›
  have : Algebra.QuasiFinite k[X] (A ⧸ RingHom.ker g) := .of_restrictScalars k _ _
  refine Algebra.QuasiFiniteAt.of_quasiFinite_quotient q (RingHom.ker g) ?_
  have hbase : (q.under k).map (algebraMap k A) ≤
      (q.under k[X]).map (algebraMap k[X] A) := by
    rw [← Ideal.under_under (A := k) (B := k[X]) q,
      IsScalarTower.algebraMap_eq k k[X] A, ← Ideal.map_map]
    exact Ideal.map_mono Ideal.map_comap_le
  have hX : X ∈ q.under k[X] := by
    simpa [Ideal.mem_comap, RingHom.algebraMap_toAlgebra] using hx
  have hxmap : x ∈ (q.under k[X]).map (algebraMap k[X] A) := by
    simpa [RingHom.algebraMap_toAlgebra] using
      Ideal.mem_map_of_mem (algebraMap k[X] A) hX
  have hkg : RingHom.ker g = Ideal.span {x} ⊔ RingHom.ker f := by
    rw [← AlgHom.comap_ker, AlgHom.ker_coe, Ideal.Quotient.mkₐ_ker, ← Set.image_singleton,
      ← Ideal.map_span]
    exact Ideal.comap_map_of_surjective' f hf _
  rw [hkg]
  exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hxmap) (hker.trans hbase)

end AlgHom

namespace Ideal

/-- A closed point of an affine curve over an Artinian ring admits a function vanishing there
which defines a quasi-finite map to the affine line at that point. -/
theorem exists_mem_quasiFiniteAt_aeval {k A : Type*} [CommRing k] [IsArtinianRing k] [CommRing A]
    [Algebra k A] [Algebra.FiniteType k A] [Ring.KrullDimLE 1 A]
    (m : Ideal A) [m.IsMaximal] :
    ∃ x ∈ m, letI := (Polynomial.aeval (R := k) x).toAlgebra
      Algebra.QuasiFiniteAt k[X] m := by
  obtain ⟨x, hxm, hx⟩ := m.exists_mem_finite_quotient_span_singleton (k := k)
  have : Algebra.QuasiFinite k (A ⧸ span {(AlgHom.id k A) x}) := by
    rw [AlgHom.id_apply]
    infer_instance
  exact ⟨x, hxm, (AlgHom.id k A).quasiFiniteAt_aeval
    Function.surjective_id x m hxm (by
      rw [(RingHom.injective_iff_ker_eq_bot _).mp Function.injective_id]
      exact bot_le)⟩

end Ideal
