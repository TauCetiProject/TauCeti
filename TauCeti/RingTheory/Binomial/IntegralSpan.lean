module

public import TauCeti.RingTheory.Binomial
public import Mathlib.Algebra.Group.Pointwise.Set.ListOfFn

/-!
# Ordered integral spanning for commuting binomial generators

For a finite commuting family `h`, the subring generated by all `(h i choose n)` is the
integral additive span of the ordered products with one binomial coefficient at each index.
In particular, multiplying two such products requires no new additive generators or rational
coefficients. This is the toral spanning statement for integral enveloping forms, including
all central toral directions.

The ambient ring need not be commutative: only the specified elements must commute. No linear
independence is asserted. A zero-length family gives the integral multiples of one, and repeated
or dependent arguments are allowed. Products use `List.ofFn`, so their order remains explicit
in a noncommutative ambient ring.

The proof uses the one-variable product formula in `TauCeti.RingTheory.Binomial` and the
additive-group product of commuting subrings.

## References

* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
-/

public section

open scoped Pointwise

variable {R : Type*} [Ring R] [BinomialRing R]

namespace TauCeti

private theorem toAddSubgroup_closure_list_ringChoose (l : List R)
    (hcomm : ∀ a ∈ l, ∀ b ∈ l, Commute a b) :
    (Subring.closure (⋃ a ∈ l, Set.range (Ring.choose a))).toAddSubgroup =
      AddSubgroup.closure ((l.map fun a => Set.range (Ring.choose a)).prod) := by
  induction l with
  | nil =>
      have hbase := Subring.toAddSubgroup_closure_of_one_mem_of_mul_mem
        (s := {(1 : R)}) (AddSubgroup.subset_closure (Set.mem_singleton 1))
        (by rintro x rfl y rfl; simp)
      rw [Subring.closure_singleton_one, Set.singleton_one] at hbase
      simpa using hbase
  | cons a l ih =>
      have htail : ∀ b ∈ l, ∀ c ∈ l, Commute b c :=
        fun b hb c hc => hcomm b (List.mem_cons_of_mem a hb) c (List.mem_cons_of_mem a hc)
      have hcentral : Subring.closure (⋃ b ∈ l, Set.range (Ring.choose b)) ≤
          Subring.centralizer (Set.range (Ring.choose a)) := by
        apply Subring.closure_le.2
        intro y hy
        simp only [Set.mem_iUnion, Set.mem_range] at hy
        obtain ⟨b, hb, n, rfl⟩ := hy
        apply Subring.mem_centralizer_iff.2
        rintro x ⟨m, rfl⟩
        exact ((hcomm a (by simp) b (by simp [hb])).ringChoose m n).eq
      have hcentral' : Subring.closure (Set.range (Ring.choose a)) ≤
          Subring.centralizer (Subring.closure (⋃ b ∈ l, Set.range (Ring.choose b))) := by
        apply Subring.closure_le.2
        intro x hx
        exact Subring.mem_centralizer_iff.2 fun y hy => (hcentral hy x hx).symm
      have hunion : (⋃ b ∈ a :: l, Set.range (Ring.choose b)) =
          Set.range (Ring.choose a) ∪ ⋃ b ∈ l, Set.range (Ring.choose b) := by
        ext x
        simp
      rw [hunion, Subring.closure_union, Subring.toAddSubgroup_sup_eq_mul _ _
        (fun x hx y hy => (hcentral' hx y hy).symm),
        toAddSubgroup_subringClosure_range_ringChoose, ih htail, ringChooseSpan_def,
        AddSubgroup.closure_mul_closure, List.map_cons, List.prod_cons]

/-- The subring generated by the binomial coefficients of a finite commuting family is,
as an additive group, exactly the integral span of its ordered binomial products.

There are no independence or characteristic-zero-field assumptions: the ambient binomial ring
can be noncommutative, and the family may be empty, repeated, or linearly dependent. -/
theorem toAddSubgroup_subringClosure_range_ringChoose_eq_closure_range_prod_ofFn
    {r : ℕ} (h : Fin r → R) (hcomm : ∀ i j, Commute (h i) (h j)) :
    (Subring.closure (Set.range fun p : Fin r × ℕ => Ring.choose (h p.1) p.2)).toAddSubgroup =
      AddSubgroup.closure
        (Set.range fun n : Fin r → ℕ => (List.ofFn fun i => Ring.choose (h i) (n i)).prod) := by
  have hunion : (⋃ a ∈ List.ofFn h, Set.range (Ring.choose a)) =
      Set.range (fun p : Fin r × ℕ => Ring.choose (h p.1) p.2) := by
    ext x
    simp only [Set.mem_iUnion, List.mem_ofFn, Set.mem_range, Prod.exists]
    constructor
    · rintro ⟨a, ⟨i, rfl⟩, n, rfl⟩
      exact ⟨i, n, rfl⟩
    · rintro ⟨i, n, rfl⟩
      exact ⟨h i, ⟨i, rfl⟩, n, rfl⟩
  have hprod : (List.ofFn fun i => Set.range (Ring.choose (h i))).prod =
      Set.range (fun n : Fin r → ℕ => (List.ofFn fun i => Ring.choose (h i) (n i)).prod) := by
    ext x
    rw [Set.mem_prod_list_ofFn]
    constructor
    · rintro ⟨f, hf⟩
      choose n hn using fun i => (f i).property
      refine ⟨n, ?_⟩
      simpa only [hn] using hf
    · rintro ⟨n, rfl⟩
      exact ⟨fun i => ⟨Ring.choose (h i) (n i), ⟨n i, rfl⟩⟩, rfl⟩
  rw [← hunion, toAddSubgroup_closure_list_ringChoose, List.map_ofFn, Function.comp_def, hprod]
  rintro a ha b hb
  obtain ⟨i, rfl⟩ := List.mem_ofFn.1 ha
  obtain ⟨j, rfl⟩ := List.mem_ofFn.1 hb
  exact hcomm i j

/-- Membership in the subring generated by a finite commuting family's binomial coefficients
is membership in the integral additive span of its ordered binomial products. -/
@[simp]
theorem mem_subringClosure_range_ringChoose_iff_mem_closure_range_prod_ofFn
    {r : ℕ} (h : Fin r → R)
    (hcomm : ∀ i j, Commute (h i) (h j)) {x : R} :
    x ∈ Subring.closure (Set.range fun p : Fin r × ℕ => Ring.choose (h p.1) p.2) ↔
      x ∈ AddSubgroup.closure
        (Set.range fun n : Fin r → ℕ => (List.ofFn fun i => Ring.choose (h i) (n i)).prod) := by
  rw [← Subring.mem_toAddSubgroup,
    toAddSubgroup_subringClosure_range_ringChoose_eq_closure_range_prod_ofFn h hcomm]

end TauCeti
