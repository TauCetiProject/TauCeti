module

public import TauCeti.RingTheory.Binomial
public import Mathlib.LinearAlgebra.TensorProduct.Basis
public import Mathlib.LinearAlgebra.TensorProduct.Tower
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# Scalar extension of the integral binomial algebra

The integral span of the binomial coefficients of an element is an algebra over `ℤ`.
Extending this algebra to a commutative ring `A` retains its integral multiplication
coefficients. If the binomial coefficients are integrally independent, their scalar extensions
form an `A`-basis. In particular this applies to the binomial polynomials in `ℚ[X]`.

This constructs the one-variable toral factor of an integral enveloping algebra over arbitrary
coefficients. The specialized symbols are tensors of integral elements, not factorial quotients
in `A`. No binomial-ring structure on `A` is asserted: in positive characteristic the specialized
algebra need not embed in a polynomial algebra over `A`.

The basis of binomial polynomials is supplied by
`TauCeti.RingTheory.Polynomial.Binomial.Basis`. The multiplication law is
`ringChoose_mul_ringChoose`; scalar extension uses `Module.Basis.baseChange`.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

noncomputable section

namespace TauCeti

open scoped TensorProduct

variable {R : Type*} [Ring R] [BinomialRing R]

/-- The integral algebra spanned by the binomial coefficients of `r`. -/
def ringChooseIntegralAlgebra (r : R) : Subalgebra ℤ R :=
  (ringChooseSpan r).toIntSubmodule.toSubalgebra
    (one_mem_ringChooseSpan r) (fun _ _ => mul_mem_ringChooseSpan r)

/-- Membership in the integral binomial algebra is membership in the integral binomial span. -/
@[simp]
theorem mem_ringChooseIntegralAlgebra {r x : R} :
    x ∈ ringChooseIntegralAlgebra r ↔ x ∈ ringChooseSpan r := Iff.rfl

/-- The underlying integral module of the binomial algebra is the binomial span. -/
@[simp]
theorem ringChooseIntegralAlgebra_toSubmodule (r : R) :
    (ringChooseIntegralAlgebra r).toSubmodule = (ringChooseSpan r).toIntSubmodule :=
  (rfl)

/-- The integral binomial algebra is the subalgebra generated by the binomial coefficients. -/
theorem ringChooseIntegralAlgebra_eq_adjoin (r : R) :
    ringChooseIntegralAlgebra r = Algebra.adjoin ℤ (Set.range (Ring.choose r)) := by
  apply le_antisymm
  · intro x hx
    have hle : ringChooseSpan r ≤
        (Algebra.adjoin ℤ (Set.range (Ring.choose r))).toSubring.toAddSubgroup := by
      rw [ringChooseSpan_le_iff]
      exact fun n => Algebra.subset_adjoin ⟨n, rfl⟩
    exact hle hx
  · exact Algebra.adjoin_le (Set.range_subset_iff.mpr (ringChoose_mem_ringChooseSpan r))

/-- The `n`th binomial coefficient, as an element of its integral algebra. -/
def ringChooseIntegral (r : R) (n : ℕ) : ringChooseIntegralAlgebra r :=
  ⟨Ring.choose r n, ringChoose_mem_ringChooseSpan r n⟩

@[simp]
theorem coe_ringChooseIntegral (r : R) (n : ℕ) :
    (ringChooseIntegral r n : R) = Ring.choose r n := (rfl)

@[simp]
theorem ringChooseIntegral_zero (r : R) : ringChooseIntegral r 0 = 1 := by
  ext
  simp

/-- The integral multiplication law before extending scalars. -/
theorem ringChooseIntegral_mul (r : R) (m n : ℕ) :
    ringChooseIntegral r m * ringChooseIntegral r n =
      ∑ ij ∈ Finset.antidiagonal n,
        (Nat.choose m ij.2 * Nat.choose (m + ij.1) m) • ringChooseIntegral r (m + ij.1) := by
  apply Subtype.ext
  simpa using ringChoose_mul_ringChoose r m n

/-- The binomial symbols span their integral algebra, without an independence hypothesis. -/
theorem span_ringChooseIntegral (r : R) :
    Submodule.span ℤ (Set.range (ringChooseIntegral r)) = ⊤ := by
  apply (Submodule.map_injective_of_injective
    (f := (ringChooseIntegralAlgebra r).val.toLinearMap) Subtype.val_injective)
  rw [Submodule.map_span, Submodule.map_top, ← Set.range_comp]
  simp only [Function.comp_def]
  ext x
  simp [LinearMap.mem_range]
  rfl

/-- An integrally independent binomial sequence is a basis of its integral algebra. -/
def ringChooseIntegralBasis {r : R}
    (h : LinearIndependent ℤ (fun n => Ring.choose r n)) :
    Module.Basis ℕ ℤ (ringChooseIntegralAlgebra r) :=
  (Module.Basis.span h).map
    ((LinearEquiv.ofEq _ _ (span_int_range_ringChoose r)).trans
      (ringChooseIntegralAlgebra r).toSubmoduleEquiv)

@[simp]
theorem ringChooseIntegralBasis_apply {r : R}
    (h : LinearIndependent ℤ (fun n => Ring.choose r n)) (n : ℕ) :
    ringChooseIntegralBasis h n = ringChooseIntegral r n := by
  apply Subtype.ext
  -- Both subtype transports preserve the underlying element of the ambient ring.
  exact Module.Basis.coe_span_apply h n

/-- Scalar extension of the integral binomial algebra to `A`. No binomial-ring structure on
`A` is required. -/
abbrev RingChooseSpecialization (A : Type*) [CommRing A] (r : R) :=
  A ⊗[ℤ] ringChooseIntegralAlgebra r

variable (A : Type*) [CommRing A]

/-- The specialized `n`th binomial symbol, defined by scalar extension, not division in `A`. -/
def ringChooseSpecialization (r : R) (n : ℕ) : RingChooseSpecialization A r :=
  1 ⊗ₜ[ℤ] ringChooseIntegral r n

/-- The specialized symbol is the pure tensor of the integral binomial coefficient. -/
theorem ringChooseSpecialization_def (r : R) (n : ℕ) :
    ringChooseSpecialization A r n = 1 ⊗ₜ[ℤ] ringChooseIntegral r n := (rfl)

@[simp]
theorem ringChooseSpecialization_zero (r : R) : ringChooseSpecialization A r 0 = 1 := by
  simp [ringChooseSpecialization, Algebra.TensorProduct.one_def]

/-- The multiplication coefficients remain integral after arbitrary scalar extension. -/
theorem ringChooseSpecialization_mul (r : R) (m n : ℕ) :
    ringChooseSpecialization A r m * ringChooseSpecialization A r n =
      ∑ ij ∈ Finset.antidiagonal n,
        (Nat.choose m ij.2 * Nat.choose (m + ij.1) m) •
          ringChooseSpecialization A r (m + ij.1) := by
  simp only [ringChooseSpecialization_def, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
    ringChooseIntegral_mul, TensorProduct.tmul_sum, TensorProduct.tmul_smul]

/-- The specialized symbols span over the new coefficient ring, even when the original
binomial sequence is dependent. -/
theorem span_ringChooseSpecialization (r : R) :
    Submodule.span A (Set.range (ringChooseSpecialization A r)) = ⊤ := by
  have h := congrArg (fun p : Submodule ℤ (ringChooseIntegralAlgebra r) => p.baseChange A)
    (span_ringChooseIntegral r)
  unfold ringChooseSpecialization
  simpa [← Set.range_comp, Function.comp_def] using h

/-- An integrally independent binomial sequence stays a basis after extension to any
commutative coefficient ring. -/
def ringChooseSpecializationBasis {r : R}
    (h : LinearIndependent ℤ (fun n => Ring.choose r n)) :
    Module.Basis ℕ A (RingChooseSpecialization A r) :=
  (ringChooseIntegralBasis h).baseChange A

@[simp]
theorem ringChooseSpecializationBasis_apply {r : R}
    (h : LinearIndependent ℤ (fun n => Ring.choose r n)) (n : ℕ) :
    ringChooseSpecializationBasis A h n = ringChooseSpecialization A r n := by
  simp [ringChooseSpecializationBasis, ringChooseSpecialization_def]

/-- Over a nonzero coefficient ring no specialized basis symbol vanishes, even when its
index factorial is zero in the coefficient ring. -/
theorem ringChooseSpecialization_ne_zero [Nontrivial A] {r : R}
    (h : LinearIndependent ℤ (fun n => Ring.choose r n)) (n : ℕ) :
    ringChooseSpecialization A r n ≠ 0 := by
  simpa using (ringChooseSpecializationBasis A h).ne_zero n

end TauCeti
