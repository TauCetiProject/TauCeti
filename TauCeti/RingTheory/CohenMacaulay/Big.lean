module

public import TauCeti.RingTheory.CohenMacaulay.RegularSequence
public import TauCeti.RingTheory.LocalRing.SystemOfParameters
public import Mathlib.RingTheory.RegularLocalRing.Defs
import TauCeti.RingTheory.RegularLocalRing.CohenMacaulay

/-!
# Big Cohen–Macaulay modules

Let `(R, 𝔪)` be a Noetherian local ring. An `R`-module `M`, not necessarily finite, is
*big Cohen–Macaulay* if some system of parameters `x₁, …, x_d` of `R` is a regular sequence on `M`:
each `xᵢ` is a nonzerodivisor on `M ⧸ (x₁, …, x_{i-1}) M`, and `M ≠ (x₁, …, x_d) M`. It is
*balanced* big Cohen–Macaulay if `M ≠ 𝔪 M` and every system of parameters is weakly regular on
`M`. Big Cohen–Macaulay algebras are the main tool in Hochster's homological conjectures: for
instance, the existence of a big Cohen–Macaulay algebra implies the direct summand theorem and the
monomial theorem.

Since a power of `𝔪` lies in the ideal generated by a system of parameters, the condition
`M ≠ (x₁, …, x_d) M` is the same as `M ≠ 𝔪 M`
(`TauCeti.IsSystemOfParameters.isRegular_iff`). So a balanced big Cohen–Macaulay module is
regular for every system of parameters, and is in particular big Cohen–Macaulay. No finiteness is
imposed on `M`; for a finite module both notions mean that `M` is a maximal Cohen–Macaulay module,
a nonzero Cohen–Macaulay module whose support has the dimension of `R`
(`Module.isBigCohenMacaulay_iff_isCohenMacaulay_and_supportDim_eq`). For instance, a
Cohen–Macaulay local ring, such as a regular local ring, is a balanced big Cohen–Macaulay module
over itself.

For modules that are not finite the two notions differ. Balanced big Cohen–Macaulay modules are
obtained from big Cohen–Macaulay ones by `𝔪`-adic completion.

On a big Cohen–Macaulay module or algebra, a system of parameters satisfies the monomial property
of regular sequences (`RingTheory.Sequence.IsRegular.not_prod_pow_smul_top_le` and
`RingTheory.Sequence.IsRegular.algebraMap_prod_pow_notMem_map_ofList`).

## Main definitions and results

* `Module.IsBigCohenMacaulay R M`: some system of parameters of `R` is `M`-regular.
* `Module.IsBalancedBigCohenMacaulay R M`: `M ≠ 𝔪 M` and every system of parameters of `R` is
  weakly `M`-regular.
* `TauCeti.IsSystemOfParameters.isRegular_iff`: a system of parameters is `M`-regular if and only
  if it is weakly `M`-regular and `M ≠ 𝔪 M`.
* `Module.IsBalancedBigCohenMacaulay.isRegular`: over a balanced big Cohen–Macaulay module every
  system of parameters is a regular sequence, and
  `Module.isBalancedBigCohenMacaulay_iff_forall_isRegular` is the converse.
* `Module.IsBalancedBigCohenMacaulay.isBigCohenMacaulay`: balanced big Cohen–Macaulay modules are
  big Cohen–Macaulay.
* `Module.isBalancedBigCohenMacaulay_iff_of_ringKrullDim_eq_zero`: over a local ring of dimension
  zero, such as a field, the balanced notion means `M ≠ 𝔪 M`, and
  `Module.isBigCohenMacaulay_iff_of_ringKrullDim_eq_zero` says the same for the big notion over a
  Noetherian local ring of dimension zero.
* `Module.IsCohenMacaulay.isRegular_of_isSystemOfParameters`: in a finite Cohen–Macaulay module of
  full dimension every system of parameters is a regular sequence.
* `Module.isBigCohenMacaulay_iff_isCohenMacaulay_and_supportDim_eq` and
  `Module.isBalancedBigCohenMacaulay_iff_isBigCohenMacaulay`: a finite module is (balanced) big
  Cohen–Macaulay if and only if it is a maximal Cohen–Macaulay module.
* `Module.IsCohenMacaulay.isBalancedBigCohenMacaulay_self`: a Cohen–Macaulay local ring is a
  balanced big Cohen–Macaulay module over itself; in particular so is a regular local ring.

## References

* Y. André, *La conjecture du facteur direct*, Publ. Math. IHÉS 127 (2018), Définition 4.1.1.
* B. Bhatt, L. Ma, Zs. Patakfalvi, K. Schwede, K. Tucker, J. Waldron, J. Witaszek,
  *Globally `+`-regular varieties and the minimal model program for threefolds in mixed
  characteristic*, §2.2.
* W. Bruns, J. Herzog, *Cohen–Macaulay rings*, §8.5.
* [Stacks Project, Proposition 10.103.4](https://stacks.math.columbia.edu/tag/00N6)
-/

public section

universe u v w

open IsLocalRing RingTheory.Sequence Ideal Pointwise TauCeti

namespace TauCeti.IsSystemOfParameters

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] {xs : List R}
  {M : Type v} [AddCommGroup M] [Module R M]

/-- A system of parameters `x₁, …, x_d` of a Noetherian local ring `(R, 𝔪)` is a regular sequence
on an `R`-module `M`, not necessarily finite, if and only if it is weakly `M`-regular and
`M ≠ 𝔪 M`: the condition `M ≠ (x₁, …, x_d) M` of a regular sequence only depends on the
radical `𝔪` of `(x₁, …, x_d)`. -/
theorem isRegular_iff (h : IsSystemOfParameters R xs) :
    IsRegular M xs ↔ IsWeaklyRegular M xs ∧ (⊤ : Submodule R M) ≠ maximalIdeal R • ⊤ :=
  (RingTheory.Sequence.isRegular_iff M xs).trans
    (and_congr_right' (not_congr (eq_comm.trans ((h.smul_top_eq_top_iff M).trans eq_comm))))

end TauCeti.IsSystemOfParameters

namespace Module

section Defs

variable (R : Type u) [CommRing R] [IsLocalRing R] (M : Type v) [AddCommGroup M] [Module R M]

/-- An `R`-module `M` over a local ring `R` is *big Cohen–Macaulay* if some system of parameters
of `R` is an `M`-regular sequence. The module need not be finite over `R`. André, Définition
4.1.1 (1). -/
def IsBigCohenMacaulay : Prop :=
  ∃ xs : List R, IsSystemOfParameters R xs ∧ IsRegular M xs

/-- An `R`-module `M` over a local ring `(R, 𝔪)` is *balanced big Cohen–Macaulay* if `M ≠ 𝔪 M`
and every system of parameters of `R` is weakly `M`-regular. The module need not be finite over
`R`. André, Définition 4.1.1 (2). -/
structure IsBalancedBigCohenMacaulay : Prop where
  /-- The quotient `M ⧸ 𝔪 M` is nonzero. -/
  top_ne_smul : (⊤ : Submodule R M) ≠ maximalIdeal R • ⊤
  /-- Every system of parameters is weakly regular. -/
  isWeaklyRegular : ∀ xs : List R, IsSystemOfParameters R xs → IsWeaklyRegular M xs

end Defs

variable {R : Type u} [CommRing R] [IsLocalRing R] {M : Type v} [AddCommGroup M] [Module R M]
  {N : Type w} [AddCommGroup N] [Module R N]

/-- Unfolds `Module.IsBigCohenMacaulay`. -/
theorem isBigCohenMacaulay_iff :
    IsBigCohenMacaulay R M ↔ ∃ xs : List R, IsSystemOfParameters R xs ∧ IsRegular M xs :=
  Iff.rfl

/-- A module on which a system of parameters is a regular sequence is big Cohen–Macaulay. -/
theorem IsBigCohenMacaulay.of_isRegular {xs : List R} (hxs : IsSystemOfParameters R xs)
    (h : IsRegular M xs) : IsBigCohenMacaulay R M :=
  ⟨xs, hxs, h⟩

/-- Unfolds `Module.IsBalancedBigCohenMacaulay`. -/
theorem isBalancedBigCohenMacaulay_iff : IsBalancedBigCohenMacaulay R M ↔
    (⊤ : Submodule R M) ≠ maximalIdeal R • ⊤ ∧
      ∀ xs : List R, IsSystemOfParameters R xs → IsWeaklyRegular M xs :=
  ⟨fun h ↦ ⟨h.top_ne_smul, h.isWeaklyRegular⟩, fun h ↦ ⟨h.1, h.2⟩⟩

/-- A big Cohen–Macaulay module is nonzero. -/
theorem IsBigCohenMacaulay.nontrivial (h : IsBigCohenMacaulay R M) : Nontrivial M := by
  obtain ⟨_, -, hreg⟩ := h
  exact hreg.nontrivial

/-- A balanced big Cohen–Macaulay module is nonzero. -/
theorem IsBalancedBigCohenMacaulay.nontrivial (h : IsBalancedBigCohenMacaulay R M) :
    Nontrivial M := by
  by_contra hM
  rw [not_nontrivial_iff_subsingleton] at hM
  exact h.top_ne_smul (le_antisymm (fun x _ ↦ Subsingleton.elim x 0 ▸ zero_mem _) le_top)

/-- Being big Cohen–Macaulay is invariant under linear equivalence. -/
theorem _root_.LinearEquiv.isBigCohenMacaulay_iff (e : M ≃ₗ[R] N) :
    IsBigCohenMacaulay R M ↔ IsBigCohenMacaulay R N :=
  exists_congr fun xs ↦ and_congr_right' (e.isRegular_congr xs)

/-- Being balanced big Cohen–Macaulay is invariant under linear equivalence. -/
theorem _root_.LinearEquiv.isBalancedBigCohenMacaulay_iff (e : M ≃ₗ[R] N) :
    IsBalancedBigCohenMacaulay R M ↔ IsBalancedBigCohenMacaulay R N := by
  have htop : (⊤ : Submodule R M) ≠ maximalIdeal R • ⊤ ↔
      (⊤ : Submodule R N) ≠ maximalIdeal R • ⊤ := by
    rw [← (Submodule.map_injective_of_injective e.injective).ne_iff, Submodule.map_smul'',
      Submodule.map_top, LinearEquiv.range]
  rw [Module.isBalancedBigCohenMacaulay_iff, Module.isBalancedBigCohenMacaulay_iff, htop]
  exact and_congr_right' (forall_congr' fun xs ↦ imp_congr_right fun _ ↦
    e.isWeaklyRegular_congr xs)

/-- Over a local ring of dimension zero, a module is balanced big Cohen–Macaulay if
and only if `M ≠ 𝔪 M`: the only system of parameters is the empty list. -/
theorem isBalancedBigCohenMacaulay_iff_of_ringKrullDim_eq_zero (h0 : ringKrullDim R = 0) :
    IsBalancedBigCohenMacaulay R M ↔ (⊤ : Submodule R M) ≠ maximalIdeal R • ⊤ := by
  refine ⟨fun h ↦ h.top_ne_smul, fun h ↦ ⟨h, fun xs hxs ↦ ?_⟩⟩
  rw [hxs.eq_nil_of_ringKrullDim_eq_zero h0]
  exact IsWeaklyRegular.nil R M

section Noetherian

variable [IsNoetherianRing R]

/-- Over a balanced big Cohen–Macaulay module, every system of parameters is a regular
sequence. -/
theorem IsBalancedBigCohenMacaulay.isRegular (h : IsBalancedBigCohenMacaulay R M) {xs : List R}
    (hxs : IsSystemOfParameters R xs) : IsRegular M xs :=
  hxs.isRegular_iff.2 ⟨h.isWeaklyRegular xs hxs, h.top_ne_smul⟩

/-- A balanced big Cohen–Macaulay module over a Noetherian local ring is big Cohen–Macaulay. -/
theorem IsBalancedBigCohenMacaulay.isBigCohenMacaulay (h : IsBalancedBigCohenMacaulay R M) :
    IsBigCohenMacaulay R M :=
  have ⟨xs, hxs⟩ := exists_isSystemOfParameters R
  ⟨xs, hxs, h.isRegular hxs⟩

/-- An `R`-module is balanced big Cohen–Macaulay if and only if every system of parameters of `R`
is a regular sequence on it. -/
theorem isBalancedBigCohenMacaulay_iff_forall_isRegular : IsBalancedBigCohenMacaulay R M ↔
    ∀ xs : List R, IsSystemOfParameters R xs → IsRegular M xs := by
  refine ⟨fun h _ hxs ↦ h.isRegular hxs, fun h ↦ ?_⟩
  obtain ⟨xs, hxs⟩ := exists_isSystemOfParameters R
  exact ⟨(hxs.isRegular_iff.1 (h xs hxs)).2, fun ys hys ↦ (h ys hys).toIsWeaklyRegular⟩

/-- An `R`-module is big Cohen–Macaulay if and only if `M ≠ 𝔪 M` and some system of parameters
of `R` is weakly regular on it. -/
theorem isBigCohenMacaulay_iff_exists_isWeaklyRegular : IsBigCohenMacaulay R M ↔
    (⊤ : Submodule R M) ≠ maximalIdeal R • ⊤ ∧
      ∃ xs : List R, IsSystemOfParameters R xs ∧ IsWeaklyRegular M xs := by
  refine ⟨fun ⟨xs, hxs, hreg⟩ ↦ ?_, fun ⟨hne, xs, hxs, hreg⟩ ↦
    ⟨xs, hxs, hxs.isRegular_iff.2 ⟨hreg, hne⟩⟩⟩
  obtain ⟨hw, hne⟩ := hxs.isRegular_iff.1 hreg
  exact ⟨hne, xs, hxs, hw⟩

/-- A big Cohen–Macaulay module satisfies `M ≠ 𝔪 M`. -/
theorem IsBigCohenMacaulay.top_ne_smul (h : IsBigCohenMacaulay R M) :
    (⊤ : Submodule R M) ≠ maximalIdeal R • ⊤ :=
  (isBigCohenMacaulay_iff_exists_isWeaklyRegular.1 h).1

/-- Over a Noetherian local ring of dimension zero, a module is big Cohen–Macaulay if and only if
`M ≠ 𝔪 M`. -/
theorem isBigCohenMacaulay_iff_of_ringKrullDim_eq_zero (h0 : ringKrullDim R = 0) :
    IsBigCohenMacaulay R M ↔ (⊤ : Submodule R M) ≠ maximalIdeal R • ⊤ := by
  refine ⟨fun h ↦ h.top_ne_smul, fun h ↦ ?_⟩
  exact ((isBalancedBigCohenMacaulay_iff_of_ringKrullDim_eq_zero h0).2 h).isBigCohenMacaulay

end Noetherian

/-- Over a field, a module is balanced big Cohen–Macaulay if and only if it is nonzero. -/
theorem isBalancedBigCohenMacaulay_iff_nontrivial {K : Type u} [Field K] {V : Type v}
    [AddCommGroup V] [Module K V] : IsBalancedBigCohenMacaulay K V ↔ Nontrivial V := by
  rw [isBalancedBigCohenMacaulay_iff_of_ringKrullDim_eq_zero (ringKrullDim_eq_zero_of_field K),
    maximalIdeal_eq_bot, Submodule.bot_smul]
  refine ⟨fun h ↦ (Submodule.nontrivial_iff K).1 ⟨⊤, ⊥, h⟩, fun _ ↦ ?_⟩
  have := (Submodule.nontrivial_iff K (M := V)).2 ‹_›
  exact top_ne_bot

section Finite

variable [IsNoetherianRing R] [Small.{v} R] [Module.Finite R M]

/-- In a finite Cohen–Macaulay module over a Noetherian local ring whose support has the dimension
of `R`, every system of parameters of `R` is a regular sequence. Stacks, Proposition 10.103.4
(00N6). -/
theorem IsCohenMacaulay.isRegular_of_isSystemOfParameters (hcm : IsCohenMacaulay R M)
    (hdim : supportDim R M = ringKrullDim R) {xs : List R} (hxs : IsSystemOfParameters R xs) :
    IsRegular M xs :=
  hcm.isRegular_of_le_radical (fun _ ↦ hxs.mem_maximalIdeal)
    (hxs.radical_ofList_eq.ge.trans (radical_mono le_sup_left)) (by rw [hdim, hxs.length_eq])

/-- **Finite big Cohen–Macaulay modules are maximal Cohen–Macaulay.** A finite module over a
Noetherian local ring is big Cohen–Macaulay if and only if it is Cohen–Macaulay and its support
has the dimension of `R`; the latter forces the module to be nonzero. -/
theorem isBigCohenMacaulay_iff_isCohenMacaulay_and_supportDim_eq : IsBigCohenMacaulay R M ↔
    IsCohenMacaulay R M ∧ supportDim R M = ringKrullDim R := by
  refine ⟨fun ⟨xs, hxs, hreg⟩ ↦ ?_, fun ⟨hcm, hdim⟩ ↦ ?_⟩
  · have := hreg.nontrivial
    -- The regular sequence `xs` of length `dim R` bounds the depth from below, and the depth is
    -- at most `dim Supp M ≤ dim R`.
    have hdepth : (xs.length : WithBot ℕ∞) ≤ depth (ModuleCat.of R M) := by
      rw [IsLocalRing.depth_eq_sSup_length_isRegular]
      exact WithBot.coe_le_coe.2 (le_sSup ⟨xs, hreg, fun _ ↦ hxs.mem_maximalIdeal, rfl⟩)
    have h1 := depth_le_supportDim (R := R) (M := M)
    have h2 := supportDim_le_ringKrullDim R M
    rw [hxs.length_eq] at hdepth
    refine ⟨isCohenMacaulay_iff_depth_eq.2 (le_antisymm h1 (h2.trans hdepth)),
      le_antisymm h2 (hdepth.trans h1)⟩
  · obtain ⟨xs, hxs⟩ := exists_isSystemOfParameters R
    exact ⟨xs, hxs, hcm.isRegular_of_isSystemOfParameters hdim hxs⟩

/-- A finite module over a Noetherian local ring is balanced big Cohen–Macaulay if and only if it
is big Cohen–Macaulay: in a nonzero finite Cohen–Macaulay module of full dimension every system of
parameters is a regular sequence. -/
theorem isBalancedBigCohenMacaulay_iff_isBigCohenMacaulay :
    IsBalancedBigCohenMacaulay R M ↔ IsBigCohenMacaulay R M := by
  refine ⟨fun h ↦ h.isBigCohenMacaulay, fun h ↦ ?_⟩
  obtain ⟨hcm, hdim⟩ := isBigCohenMacaulay_iff_isCohenMacaulay_and_supportDim_eq.1 h
  exact isBalancedBigCohenMacaulay_iff_forall_isRegular.2 fun _ hxs ↦
    hcm.isRegular_of_isSystemOfParameters hdim hxs

end Finite

/-- A Noetherian local ring that is Cohen–Macaulay over itself is a balanced big Cohen–Macaulay
module over itself: every system of parameters is a regular sequence. -/
theorem IsCohenMacaulay.isBalancedBigCohenMacaulay_self [IsNoetherianRing R]
    (h : IsCohenMacaulay R R) : IsBalancedBigCohenMacaulay R R :=
  isBalancedBigCohenMacaulay_iff_isBigCohenMacaulay.2 <|
    isBigCohenMacaulay_iff_isCohenMacaulay_and_supportDim_eq.2
      ⟨h, supportDim_self_eq_ringKrullDim R⟩

end Module

/-- A regular local ring is a balanced big Cohen–Macaulay module over itself. -/
theorem TauCeti.IsRegularLocalRing.isBalancedBigCohenMacaulay_self (R : Type u) [CommRing R]
    [IsRegularLocalRing R] : Module.IsBalancedBigCohenMacaulay R R :=
  IsRegularLocalRing.isCohenMacaulay.isBalancedBigCohenMacaulay_self
