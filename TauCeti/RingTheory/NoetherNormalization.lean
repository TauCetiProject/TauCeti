namespace AlgebraicIndependent

section Rows

variable {R A κ ι : Type*} [CommRing R] [CommRing A] [Algebra R A] [Fintype ι]

/-- If the linear combinations `y i = ∑ j, C i j • x j` are algebraically independent over `R`,
then the rows of `C` are `R`-linearly independent. -/
theorem linearIndependent_of_sum_smul {C : Matrix κ ι R} {x : ι → A}
    (hy : AlgebraicIndependent R fun i ↦ ∑ j, C i j • x j) :
    LinearIndependent R C := by
  have hlin : (fun i ↦ ∑ j, C i j • x j) = Fintype.linearCombination R x ∘ fun i ↦ C i :=
    funext fun i ↦ (Fintype.linearCombination_apply R x (C i)).symm
  exact (hlin ▸ hy.linearIndependent).of_comp (Fintype.linearCombination R x)

end Rows

section BaseChange

variable {R S A ι : Type*} [CommRing R] [CommRing S] [Algebra R S] [CommRing A] [Algebra R A]

private theorem aeval_one_tmul_toRingHom (y : ι → A) :
    (MvPolynomial.aeval fun i ↦ (1 ⊗ₜ[R] y i : S ⊗[R] A)).toRingHom =
      (Algebra.TensorProduct.map (AlgHom.id R S) (MvPolynomial.aeval y)).toRingHom.comp
        (MvPolynomial.algebraTensorAlgEquiv R S).symm.toRingHom := by
  refine MvPolynomial.ringHom_ext (fun s ↦ ?_) (fun i ↦ by simp)
  have hrhs : ((Algebra.TensorProduct.map (AlgHom.id R S) (MvPolynomial.aeval y)).toRingHom.comp
      (MvPolynomial.algebraTensorAlgEquiv R S).symm.toRingHom) (C s) =
      (Algebra.TensorProduct.map (AlgHom.id R S) (MvPolynomial.aeval y))
        ((MvPolynomial.algebraTensorAlgEquiv R S).symm (C s)) := rfl
  rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_C, hrhs, MvPolynomial.C_apply,
    MvPolynomial.algebraTensorAlgEquiv_symm_monomial, Algebra.TensorProduct.map_tmul,
    AlgHom.coe_id, id_eq, ← MvPolynomial.C_apply, map_one, map_one]
  rfl

/-- Algebraic independence of a family `y : ι → A` over `R` persists for `i ↦ 1 ⊗ₜ[R] y i` in
`S ⊗[R] A` along any flat `R`-algebra `S`. -/
theorem one_tmul [Module.Flat R S] {y : ι → A} (hy : AlgebraicIndependent R y) :
    AlgebraicIndependent S fun i ↦ (1 ⊗ₜ[R] y i : S ⊗[R] A) := by
  have heq : ⇑(MvPolynomial.aeval fun i ↦ (1 ⊗ₜ[R] y i : S ⊗[R] A)) =
      ⇑(Algebra.TensorProduct.map (AlgHom.id R S) (MvPolynomial.aeval y)) ∘
        ⇑(MvPolynomial.algebraTensorAlgEquiv R S).symm :=
    funext fun p ↦ RingHom.congr_fun (aeval_one_tmul_toRingHom y) p
  rw [algebraicIndependent_iff_injective_aeval, heq]
  have hinj : Function.Injective
      (Algebra.TensorProduct.map (AlgHom.id R S) (MvPolynomial.aeval y)) :=
    Module.Flat.lTensor_preserves_injective_linearMap (M := S)
      (MvPolynomial.aeval y).toLinearMap (algebraicIndependent_iff_injective_aeval.mp hy)
  exact hinj.comp (MvPolynomial.algebraTensorAlgEquiv R S).symm.injective

end BaseChange

end AlgebraicIndependent

namespace TauCeti

section ShearElimination

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] {n : ℕ}

/-- Evaluating `shearToPolynomial i a f` in an `R`-algebra `A` at base coordinates `y` and height
`t` agrees with evaluating `f` at the sheared tuple `i.insertNth t (fun j ↦ y j + a j • t)`. -/
private theorem eval₂_aeval_shearToPolynomial (f : MvPolynomial (Fin (n + 1)) R)
    (i : Fin (n + 1)) (a : Fin n → R) (y : Fin n → A) (t : A) :
    Polynomial.eval₂ (MvPolynomial.aeval y).toRingHom t (shearToPolynomial i a f) =
      MvPolynomial.aeval (i.insertNth t fun j ↦ y j + a j • t) f := by
  rw [shearToPolynomial_def, ← Polynomial.coe_eval₂RingHom, map_eval₂Hom]
  have hC : (Polynomial.eval₂RingHom (MvPolynomial.aeval y).toRingHom t).comp
      (Polynomial.C.comp C) = algebraMap R A := by
    ext r
    simp
  rw [hC, coe_eval₂Hom, ← aeval_def]
  refine congrArg (MvPolynomial.aeval · f) (funext fun k ↦ ?_)
  refine Fin.succAboveCases i ?_ (fun j ↦ ?_) k
  · simp
  · simp [Algebra.smul_def]

/-- **Linear shear elimination.** If `x : Fin (n + 1) → A` satisfies `aeval x f = 0` and the top
homogeneous component of `f` evaluates at `i.insertNth 1 a` to a unit in `R`, then `x i` is
integral over the `R`-subalgebra generated by `fun j ↦ x (i.succAbove j) - a j • x i`. -/
theorem isIntegral_shear_of_isUnit_eval {x : Fin (n + 1) → A}
    {f : MvPolynomial (Fin (n + 1)) R} (i : Fin (n + 1)) {a : Fin n → R}
    (hf : MvPolynomial.aeval x f = 0)
    (ha : IsUnit (eval (i.insertNth 1 a) (homogeneousComponent f.totalDegree f))) :
    IsIntegral (Algebra.adjoin R (Set.range fun j ↦ x (i.succAbove j) - a j • x i)) (x i) := by
  let z : Fin n → A := fun j ↦ x (i.succAbove j) - a j • x i
  let B : Subalgebra R A := Algebra.adjoin R (Set.range z)
  let zB : Fin n → B := fun j ↦ ⟨z j, Algebra.subset_adjoin ⟨j, rfl⟩⟩
  let Q : Polynomial B := (shearToPolynomial i a f).map (MvPolynomial.aeval zB).toRingHom
  let u : Bˣ := (ha.map (algebraMap R B)).unit
  refine ⟨Polynomial.C (↑u⁻¹ : B) * Q, ?_, ?_⟩
  · refine Polynomial.monic_of_natDegree_le_of_coeff_eq_one f.totalDegree
      ((Polynomial.natDegree_C_mul_le _ _).trans
        ((Polynomial.natDegree_map_le).trans (f.natDegree_shearToPolynomial_le i a))) ?_
    simp only [Q, Polynomial.coeff_C_mul, Polynomial.coeff_map,
      coeff_shearToPolynomial_totalDegree, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_C]
    exact u.inv_val
  · rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map]
    have hcomp :
        (algebraMap B A).comp (MvPolynomial.aeval zB : MvPolynomial (Fin n) R →ₐ[R] B).toRingHom =
          (MvPolynomial.aeval z : MvPolynomial (Fin n) R →ₐ[R] A).toRingHom := by
      refine MvPolynomial.ringHom_ext (fun r ↦ ?_) (fun j ↦ ?_) <;> simp [zB]
    have hpt : (i.insertNth (x i) fun j ↦ z j + a j • x i) = x := by
      funext k
      refine Fin.succAboveCases i ?_ (fun j ↦ ?_) k
      · simp
      · simp [z]
    rw [hcomp, eval₂_aeval_shearToPolynomial, hpt, hf, mul_zero]

private theorem subalgebra_val_finite (B : Subalgebra R A) [Module.Finite B A] :
    B.val.Finite := by
  have h : B.val.toRingHom = algebraMap B A := RingHom.ext fun _ ↦ rfl
  rw [AlgHom.Finite, h, RingHom.finite_algebraMap]
  infer_instance

private theorem finite_aeval_of_adjoin_eq_top {ι : Type*} {x : ι → A}
    (hx : Algebra.adjoin R (Set.range x) = ⊤) :
    (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A).Finite := by
  have hrange : (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A).range = ⊤ := by
    rw [← Algebra.adjoin_range_eq_range_aeval R x, hx]
  exact AlgHom.Finite.of_surjective _ fun a ↦ (MvPolynomial.aeval x).mem_range.mp
    (hrange ▸ (trivial : a ∈ (⊤ : Subalgebra R A)))

private theorem finite_of_adjoin_eq_top_of_isIntegral {ι : Type*} [Finite ι] {x : ι → A}
    (hx : Algebra.adjoin R (Set.range x) = ⊤) (B : Subalgebra R A)
    (hint : ∀ j, IsIntegral B (x j)) : Module.Finite B A := by
  classical
  cases nonempty_fintype ι
  have htop : (integralClosure B A).restrictScalars R = ⊤ :=
    top_unique (hx ▸ Algebra.adjoin_le (Set.range_subset_iff.mpr hint))
  have : Algebra.IsIntegral B A := ⟨fun y ↦ (mem_integralClosure_iff B A).mp <|
    (Subalgebra.mem_restrictScalars R).mp
      (htop ▸ (trivial : y ∈ (⊤ : Subalgebra R A)))⟩
  have : Algebra.FiniteType R A := ⟨⟨Finset.univ.image x, by simpa using hx⟩⟩
  have : Algebra.FiniteType B A := Algebra.FiniteType.of_restrictScalars_finiteType R B A
  exact Algebra.IsIntegral.finite

private theorem finite_aeval_of_adjoin_eq_top_of_isIntegral {ι κ : Type*} [Finite ι]
    {x : ι → A} (hx : Algebra.adjoin R (Set.range x) = ⊤) (z : κ → A)
    (hint : ∀ j, IsIntegral (MvPolynomial.aeval z : MvPolynomial κ R →ₐ[R] A).range (x j)) :
    (MvPolynomial.aeval z : MvPolynomial κ R →ₐ[R] A).Finite := by
  let φ : MvPolynomial κ R →ₐ[R] A := MvPolynomial.aeval z
  have : Module.Finite φ.range A := finite_of_adjoin_eq_top_of_isIntegral hx φ.range hint
  rw [← (MvPolynomial.aeval z : MvPolynomial κ R →ₐ[R] A).val_comp_rangeRestrict]
  exact (subalgebra_val_finite φ.range).comp
    (AlgHom.Finite.of_surjective _ φ.rangeRestrict_surjective)

/-- If `x : Fin (n + 1) → A` generates `A` as an `R`-algebra, `aeval x f = 0`, and the top
homogeneous component of `f` evaluates at `i.insertNth 1 a` to a unit in `R`, then `A` is a finite
module over `Algebra.adjoin R (Set.range fun j ↦ x (i.succAbove j) - a j • x i)`. -/
theorem finite_adjoin_shear_of_isUnit_eval {x : Fin (n + 1) → A}
    (hx : Algebra.adjoin R (Set.range x) = ⊤)
    {f : MvPolynomial (Fin (n + 1)) R} (i : Fin (n + 1)) {a : Fin n → R}
    (hf : MvPolynomial.aeval x f = 0)
    (ha : IsUnit (eval (i.insertNth 1 a) (homogeneousComponent f.totalDegree f))) :
    Module.Finite (Algebra.adjoin R (Set.range fun j ↦ x (i.succAbove j) - a j • x i)) A := by
  let z : Fin n → A := fun j ↦ x (i.succAbove j) - a j • x i
  let B : Subalgebra R A := Algebra.adjoin R (Set.range z)
  have hxi : IsIntegral B (x i) := isIntegral_shear_of_isUnit_eval i hf ha
  refine finite_of_adjoin_eq_top_of_isIntegral hx B (Fin.succAboveCases i hxi fun j ↦ ?_)
  have hz : IsIntegral B (z j) :=
    isIntegral_algebraMap (x := (⟨z j, Algebra.subset_adjoin ⟨j, rfl⟩⟩ : B))
  have hax : IsIntegral B (a j • x i) := by
    rw [Algebra.smul_def]
    exact (isIntegral_algebraMap (x := algebraMap R B (a j))).mul hxi
  simpa [z] using hz.add hax

/-- Over an infinite domain `R`, the top homogeneous component of any nonzero polynomial
`f : MvPolynomial (Fin (n + 1)) R` takes a nonzero value at `i.insertNth 1 a` for some
`a : Fin n → R`. -/
theorem exists_eval_insertNth_homogeneousComponent_ne_zero
    {R : Type*} [CommRing R] [IsDomain R] [Infinite R]
    {f : MvPolynomial (Fin (n + 1)) R} (hf : f ≠ 0) (i : Fin (n + 1)) :
    ∃ a : Fin n → R, eval (i.insertNth 1 a) (homogeneousComponent f.totalDegree f) ≠ 0 := by
  have hne : dehomogenize i (homogeneousComponent f.totalDegree f) ≠ 0 := fun h0 ↦
    f.homogeneousComponent_totalDegree_ne_zero hf <|
      dehomogenize_injOn i f.totalDegree (homogeneousComponent_isHomogeneous _ _)
        (isHomogeneous_zero _ _ _) (by simpa using h0)
  by_contra! hall
  refine hne (MvPolynomial.funext fun a ↦ ?_)
  simpa [eval_dehomogenize] using hall a

end ShearElimination

section BaseChange

variable {R S A κ ι : Type*} [CommRing R] [CommRing S] [Algebra R S] [CommRing A] [Algebra R A]

/-- Module-finiteness of `MvPolynomial.aeval y` over `R` persists for `i ↦ 1 ⊗ₜ[R] y i` in
`S ⊗[R] A` along any commutative `R`-algebra `S`. -/
theorem finite_aeval_one_tmul {y : κ → A}
    (hy : (MvPolynomial.aeval y : MvPolynomial κ R →ₐ[R] A).Finite) :
    (MvPolynomial.aeval (fun i ↦ (1 ⊗ₜ[R] y i : S ⊗[R] A)) :
      MvPolynomial κ S →ₐ[S] S ⊗[R] A).Finite := by
  rw [AlgHom.Finite, AlgebraicIndependent.aeval_one_tmul_toRingHom y]
  exact (RingHom.Finite.tensorProductMap (AlgHom.Finite.id R S) hy).comp
    (RingHom.Finite.of_surjective _ (MvPolynomial.algebraTensorAlgEquiv R S).symm.surjective)

/-- **Persistence of linear Noether normalization under flat base change.** If the linear
combinations `y i = ∑ j, C i j • x j` are algebraically independent over `R` and make `A`
module-finite over `MvPolynomial κ R`, then for any flat `R`-algebra `S` (in particular any field
extension when `R` is a field), the mapped matrix `C.map (algebraMap R S)` normalizes the
base-changed tuple `j ↦ 1 ⊗ₜ[R] x j` in `S ⊗[R] A`. -/
theorem algebraicIndependent_and_finite_sum_smul_tmul [Fintype ι] [Module.Flat R S]
    {C : Matrix κ ι R} {x : ι → A}
    (hind : AlgebraicIndependent R fun i ↦ ∑ j, C i j • x j)
    (hfin : (MvPolynomial.aeval (fun i ↦ ∑ j, C i j • x j) : MvPolynomial κ R →ₐ[R] A).Finite) :
    let y' : κ → S ⊗[R] A := fun i ↦ ∑ j, algebraMap R S (C i j) • (1 ⊗ₜ[R] x j)
    AlgebraicIndependent S y' ∧
      (MvPolynomial.aeval y' : MvPolynomial κ S →ₐ[S] S ⊗[R] A).Finite := by
  have hy' : (fun i ↦ ∑ j, algebraMap R S (C i j) • (1 ⊗ₜ[R] x j : S ⊗[R] A)) =
      fun i ↦ (1 ⊗ₜ[R] (∑ j, C i j • x j) : S ⊗[R] A) := by
    ext i
    rw [TensorProduct.tmul_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one,
      Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
  dsimp only
  rw [hy']
  exact ⟨hind.one_tmul, finite_aeval_one_tmul hfin⟩

end BaseChange

section LinearNormalization

universe u v

private theorem exists_linear_normalization_step {k : Type u} {A : Type v} [Field k] [Infinite k]
    [CommRing A] [Nontrivial A] [Algebra k A] {r : ℕ}
    (ih : ∀ {B : Type v} [CommRing B] [Nontrivial B] [Algebra k B] (z : Fin r → B),
      Algebra.adjoin k (Set.range z) = ⊤ →
      ∃ (d : ℕ) (_ : d ≤ r) (C : Matrix (Fin d) (Fin r) k),
        let y : Fin d → B := fun i ↦ ∑ j, C i j • z j
        AlgebraicIndependent k y ∧
          (MvPolynomial.aeval y : MvPolynomial (Fin d) k →ₐ[k] B).Finite)
    (x : Fin (r + 1) → A) (hx : Algebra.adjoin k (Set.range x) = ⊤)
    (hind : ¬ AlgebraicIndependent k x) :
    ∃ (d : ℕ) (_ : d ≤ r + 1) (C : Matrix (Fin d) (Fin (r + 1)) k),
      let y : Fin d → A := fun i ↦ ∑ j, C i j • x j
      AlgebraicIndependent k y ∧
        (MvPolynomial.aeval y : MvPolynomial (Fin d) k →ₐ[k] A).Finite := by
  rw [algebraicIndependent_iff] at hind
  push Not at hind
  obtain ⟨f, hf0, hfx⟩ := hind
  obtain ⟨a, ha⟩ := exists_eval_insertNth_homogeneousComponent_ne_zero hfx 0
  let z : Fin r → A := fun j ↦ x j.succ - a j • x 0
  let B : Subalgebra k A := Algebra.adjoin k (Set.range z)
  have : Module.Finite B A := finite_adjoin_shear_of_isUnit_eval hx 0 hf0 ha.isUnit
  let zB : Fin r → B := fun j ↦ ⟨z j, Algebra.subset_adjoin ⟨j, rfl⟩⟩
  have hzB : Algebra.adjoin k (Set.range zB) = ⊤ := by
    apply Subalgebra.map_injective (f := B.val) Subtype.val_injective
    rw [Algebra.map_top, Subalgebra.range_val, AlgHom.map_adjoin]
    exact congrArg _ (by ext w; simp [zB])
  obtain ⟨d, hdr, C', hind', hfin'⟩ := ih zB hzB
  let M : Matrix (Fin r) (Fin (r + 1)) k := Matrix.of fun l ↦ Fin.cons (-a l) (Pi.single l 1)
  let CM : Matrix (Fin d) (Fin (r + 1)) k := C' * M
  have hval (i : Fin d) : ∑ j, CM i j • x j = B.val (∑ l, C' i l • zB l) := by
    rw [map_sum]
    simp_rw [map_smul, Subalgebra.coe_val, zB, CM, Matrix.mul_apply, Finset.sum_smul, mul_smul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    rw [← Finset.smul_sum]
    refine congrArg (C' i l • ·) ?_
    rw [Fin.sum_univ_succ, Finset.sum_eq_single l
      (fun m _ hml ↦ by simp [M, Pi.single_eq_of_ne hml]) (fun hl ↦ absurd (Finset.mem_univ l) hl)]
    simp [M, z, sub_eq_add_neg, add_comm]
  have hval' : (fun i ↦ ∑ j, CM i j • x j) = B.val ∘ fun i ↦ ∑ l, C' i l • zB l := funext hval
  have hB_inj : Function.Injective B.val := Subtype.val_injective
  refine ⟨d, hdr.trans (Nat.le_succ r), CM, hval' ▸ hind'.map hB_inj.injOn, ?_⟩
  have hcomp : MvPolynomial.aeval (fun i ↦ ∑ j, CM i j • x j) =
      B.val.comp (MvPolynomial.aeval fun i ↦ ∑ l, C' i l • zB l) :=
    MvPolynomial.algHom_ext fun i ↦ by simpa using hval i
  exact hcomp ▸ (subalgebra_val_finite B).comp hfin'

/-- **Linear Noether normalization in prescribed generators.** Over an infinite field `k`, every
nontrivial commutative `k`-algebra `A` generated by a tuple `x : Fin n → A` admits `d ≤ n` and a
`d × n` matrix `C` over `k` such that the linear combinations `y i = ∑ j, C i j • x j` are
algebraically independent over `k`, the evaluation map `MvPolynomial (Fin d) k →ₐ[k] A` at `y` is
module-finite, and `ringKrullDim A = d`. Neither reducedness nor irreducibility of `A` is needed. -/
theorem exists_linear_normalization {k : Type u} {A : Type v} [Field k] [Infinite k]
    [CommRing A] [Nontrivial A] [Algebra k A]
    {n : ℕ} (x : Fin n → A) (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    ∃ (d : ℕ) (_ : d ≤ n) (C : Matrix (Fin d) (Fin n) k),
      let y : Fin d → A := fun i ↦ ∑ j, C i j • x j
      AlgebraicIndependent k y ∧
        (MvPolynomial.aeval y : MvPolynomial (Fin d) k →ₐ[k] A).Finite ∧
        ringKrullDim A = (d : WithBot ℕ∞) := by
  suffices hmain : ∃ (d : ℕ) (_ : d ≤ n) (C : Matrix (Fin d) (Fin n) k),
      let y : Fin d → A := fun i ↦ ∑ j, C i j • x j
      AlgebraicIndependent k y ∧
        (MvPolynomial.aeval y : MvPolynomial (Fin d) k →ₐ[k] A).Finite by
    obtain ⟨d, hdn, C, hind, hfin⟩ := hmain
    refine ⟨d, hdn, C, hind, hfin, ?_⟩
    simpa using ringKrullDim_eq_of_injective_of_isIntegral_mvPolynomial
      (MvPolynomial.aeval _).toRingHom hind hfin.to_isIntegral
  induction n generalizing A with
  | zero =>
    have hy : (fun i : Fin 0 ↦ ∑ j : Fin 0, (0 : Matrix (Fin 0) (Fin 0) k) i j • x j) = x :=
      funext fun i ↦ i.elim0
    exact ⟨0, le_rfl, 0, algebraicIndependent_empty_type_iff.mpr (algebraMap k A).injective,
      hy.symm ▸ finite_aeval_of_adjoin_eq_top hx⟩
  | succ r ih =>
    by_cases hind : AlgebraicIndependent k x
    · have hy : (fun i ↦ ∑ j, (1 : Matrix (Fin (r + 1)) (Fin (r + 1)) k) i j • x j) = x := by
        ext i
        simp [Matrix.one_apply]
      exact ⟨r + 1, le_rfl, 1, hy.symm ▸ hind, hy.symm ▸ finite_aeval_of_adjoin_eq_top hx⟩
    · exact exists_linear_normalization_step ih x hx hind

/-- **Linear Noether normalization for a finite index type.** Over an infinite field `k`, every
nontrivial commutative `k`-algebra `A` generated by a family `x : ι → A` indexed by a `Fintype`
admits `d ≤ Fintype.card ι` and a matrix `C : Matrix (Fin d) ι k` such that
`y i = ∑ j, C i j • x j` is algebraically independent over `k`, `MvPolynomial.aeval y` is
module-finite, and `ringKrullDim A = d`. -/
theorem exists_linear_normalization_of_fintype {k A ι : Type*} [Field k] [Infinite k]
    [CommRing A] [Nontrivial A] [Algebra k A] [Fintype ι]
    (x : ι → A) (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    ∃ (d : ℕ) (_ : d ≤ Fintype.card ι) (C : Matrix (Fin d) ι k),
      let y : Fin d → A := fun i ↦ ∑ j, C i j • x j
      AlgebraicIndependent k y ∧
        (MvPolynomial.aeval y : MvPolynomial (Fin d) k →ₐ[k] A).Finite ∧
        ringKrullDim A = (d : WithBot ℕ∞) := by
  let e : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι
  have hxe : Algebra.adjoin k (Set.range (x ∘ e.symm)) = ⊤ := by
    rwa [EquivLike.range_comp]
  obtain ⟨d, hdn, C₀, hind, hfin, hdim⟩ := exists_linear_normalization (x ∘ e.symm) hxe
  refine ⟨d, hdn, C₀.submatrix id e, ?_⟩
  have hsum : (fun i ↦ ∑ j, C₀.submatrix id e i j • x j) =
      fun i ↦ ∑ m, C₀ i m • (x ∘ e.symm) m := by
    ext i
    simp_rw [Matrix.submatrix_apply, id_eq, Function.comp_apply,
      ← e.sum_comp (fun m ↦ C₀ i m • x (e.symm m)), Equiv.symm_apply_apply]
  dsimp only
  rw [hsum]
  exact ⟨hind, hfin, hdim⟩

end LinearNormalization

section CounterexampleZModTwo

/-- The defining ideal `(X₀ X₁ (X₀ + X₁))` of the union of three lines through the origin over
`𝔽₂ = ZMod 2`. -/
private noncomputable abbrev threeLinesIdeal : Ideal (MvPolynomial (Fin 2) (ZMod 2)) :=
  Ideal.span {X 0 * X 1 * (X 0 + X 1)}

/-- The coordinate ring `𝔽₂[X₀, X₁] ⧸ (X₀ X₁ (X₀ + X₁))` of the union of three lines over `𝔽₂`. -/
private abbrev ThreeLinesQuot : Type :=
  MvPolynomial (Fin 2) (ZMod 2) ⧸ threeLinesIdeal

private noncomputable def threeLinesCoord (j : Fin 2) : ThreeLinesQuot :=
  Ideal.Quotient.mk threeLinesIdeal (X j)

@[simp]
private theorem lift_threeLinesCoord
    (f : MvPolynomial (Fin 2) (ZMod 2) →ₐ[ZMod 2] Polynomial (ZMod 2))
    (hf : ∀ p ∈ threeLinesIdeal, f p = 0) (j : Fin 2) :
    Ideal.Quotient.lift threeLinesIdeal (f : _ →+* _) hf (threeLinesCoord j) = f (X j) :=
  AlgHom.congr_fun (Ideal.Quotient.liftₐ_comp threeLinesIdeal f hf) (X j)

private theorem adjoin_threeLinesCoord :
    Algebra.adjoin (ZMod 2) (Set.range threeLinesCoord) = ⊤ := by
  rw [eq_top_iff]
  rintro q -
  obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
  induction P using MvPolynomial.induction_on with
  | C c => exact Subalgebra.algebraMap_mem _ c
  | add p₁ p₂ h₁ h₂ => exact Subalgebra.add_mem _ h₁ h₂
  | mul_X p₁ j h₁ => exact Subalgebra.mul_mem _ h₁ (Algebra.subset_adjoin ⟨j, rfl⟩)

/-- For each linear form on `(ZMod 2)²`, one of the three coordinate lines `(0, T)`, `(T, 0)`, or
`(T, T)` in `𝔽₂[T]` vanishes on both `(X₀ X₁ (X₀ + X₁))` and that linear form while mapping onto
`𝔽₂[T]`. -/
private theorem exists_surjective_algHom_zmod_two_killing_linear (c : Fin 2 → ZMod 2) :
    ∃ π : ThreeLinesQuot →ₐ[ZMod 2] Polynomial (ZMod 2),
      Function.Surjective π ∧ π (∑ j : Fin 2, c j • threeLinesCoord j) = 0 := by
  let v : Fin 3 → Fin 2 → Polynomial (ZMod 2) :=
    ![![0, Polynomial.X], ![Polynomial.X, 0], ![Polynomial.X, Polynomial.X]]
  have htwo : (Polynomial.X + Polynomial.X : Polynomial (ZMod 2)) = 0 := by
    rw [← two_smul (ZMod 2), show (2 : ZMod 2) = 0 by decide, zero_smul]
  have hkill_rel (m : Fin 3) :
      aeval (v m) (X 0 * X 1 * (X 0 + X 1) : MvPolynomial (Fin 2) (ZMod 2)) = 0 := by
    fin_cases m <;> simp [v, htwo]
  let π (m : Fin 3) : ThreeLinesQuot →ₐ[ZMod 2] Polynomial (ZMod 2) :=
    Ideal.Quotient.liftₐ threeLinesIdeal (aeval (v m)) fun p hp ↦ by
      rw [threeLinesIdeal, Ideal.mem_span_singleton] at hp
      rcases hp with ⟨q, rfl⟩
      simp [hkill_rel m]
  have hsurj (m : Fin 3) : Function.Surjective (π m) := fun P ↦ by
    refine ⟨Polynomial.aeval (threeLinesCoord (if m = 0 then 1 else 0)) P, ?_⟩
    rw [← Polynomial.aeval_algHom_apply]
    have hmX : π m (threeLinesCoord (if m = 0 then 1 else 0)) = Polynomial.X := by
      fin_cases m <;> simp [π, v]
    rw [hmX, Polynomial.aeval_X_left_apply]
  obtain ⟨m, hm⟩ : ∃ m : Fin 3, c 0 • v m 0 + c 1 • v m 1 = 0 := by
    have h01 : ∀ a : ZMod 2, a = 0 ∨ a = 1 := by decide
    rcases h01 (c 0) with hc0 | hc0 <;> rcases h01 (c 1) with hc1 | hc1
    · exact ⟨0, by simp [hc0, hc1]⟩
    · exact ⟨1, by simp [hc0, hc1, v]⟩
    · exact ⟨0, by simp [hc0, hc1, v]⟩
    · exact ⟨2, by simpa [hc0, hc1, v] using htwo⟩
  refine ⟨π m, hsurj m, ?_⟩
  rw [Fin.sum_univ_two, map_add, map_smul, map_smul]
  simpa [π] using hm

private theorem algebraicIndependent_quadratic_zmod_two :
    AlgebraicIndependent (ZMod 2)
      (fun _ : Fin 1 ↦ threeLinesCoord 0 ^ 2 + threeLinesCoord 0 * threeLinesCoord 1 +
        threeLinesCoord 1 ^ 2) := by
  let z : Fin 1 → ThreeLinesQuot :=
    fun _ ↦ threeLinesCoord 0 ^ 2 + threeLinesCoord 0 * threeLinesCoord 1 + threeLinesCoord 1 ^ 2
  let w : Fin 2 → Polynomial (ZMod 2) := ![Polynomial.X, 0]
  let π : ThreeLinesQuot →ₐ[ZMod 2] Polynomial (ZMod 2) :=
    Ideal.Quotient.liftₐ threeLinesIdeal (aeval w) fun p hp ↦ by
      rw [threeLinesIdeal, Ideal.mem_span_singleton] at hp
      rcases hp with ⟨q, rfl⟩
      simp [w]
  let e : MvPolynomial (Fin 1) (ZMod 2) →ₐ[ZMod 2] Polynomial (ZMod 2) :=
    MvPolynomial.aeval fun _ ↦ Polynomial.X
  have he_inj : Function.Injective e := by
    refine Function.LeftInverse.injective (g := Polynomial.aeval (X 0)) fun p ↦ ?_
    have hid : (Polynomial.aeval (X (0 : Fin 1))).comp e = AlgHom.id (ZMod 2) _ := by
      refine MvPolynomial.algHom_ext fun i ↦ ?_
      fin_cases i
      simp [e]
    exact AlgHom.congr_fun hid p
  have hcomp : π.comp (MvPolynomial.aeval z) = (Polynomial.expand (ZMod 2) 2).comp e := by
    refine MvPolynomial.algHom_ext fun i ↦ ?_
    fin_cases i
    simp [π, z, w, e, Polynomial.expand_X]
  have hinj : Function.Injective (π.comp (MvPolynomial.aeval z)) := by
    rw [hcomp, AlgHom.coe_comp]
    exact (Polynomial.expand_injective (by omega : 0 < 2)).comp he_inj
  exact Function.Injective.of_comp (f := π) hinj

private theorem isIntegral_cubic_of_mul_add_eq_zero {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] {u v : A} (hrel : u * v * (u + v) = 0) :
    let z : Fin 1 → A := fun _ ↦ u ^ 2 + u * v + v ^ 2
    IsIntegral (MvPolynomial.aeval z : MvPolynomial (Fin 1) R →ₐ[R] A).range u ∧
      IsIntegral (MvPolynomial.aeval z : MvPolynomial (Fin 1) R →ₐ[R] A).range v := by
  intro z
  let B : Subalgebra R A := (MvPolynomial.aeval z : MvPolynomial (Fin 1) R →ₐ[R] A).range
  have hzB : z 0 ∈ B := ⟨X 0, by simp [z]⟩
  have hmonic : (Polynomial.X ^ 3 - Polynomial.C (⟨z 0, hzB⟩ : B) * Polynomial.X).Monic := by
    refine Polynomial.monic_of_natDegree_le_of_coeff_eq_one 3
      ((Polynomial.natDegree_sub_le _ _).trans (max_le (Polynomial.natDegree_X_pow_le 3)
        ((Polynomial.natDegree_C_mul_le _ _).trans
          (Polynomial.natDegree_X_le.trans (by decide : 1 ≤ 3))))) ?_
    simp [Polynomial.coeff_X_pow]
  refine ⟨⟨_, hmonic, ?_⟩, ⟨_, hmonic, ?_⟩⟩ <;>
  · rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_mul,
      Polynomial.eval₂_C, Polynomial.eval₂_X, Subalgebra.algebraMap_apply]
    calc
      _ = -(u * v * (u + v)) := by dsimp [z]; ring
      _ = 0 := by rw [hrel, neg_zero]

private theorem finite_aeval_quadratic_zmod_two :
    (MvPolynomial.aeval
      (fun _ : Fin 1 ↦ threeLinesCoord 0 ^ 2 + threeLinesCoord 0 * threeLinesCoord 1 +
        threeLinesCoord 1 ^ 2) :
      MvPolynomial (Fin 1) (ZMod 2) →ₐ[ZMod 2] ThreeLinesQuot).Finite := by
  have hrel : threeLinesCoord 0 * threeLinesCoord 1 * (threeLinesCoord 0 + threeLinesCoord 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  obtain ⟨hu, hv⟩ := isIntegral_cubic_of_mul_add_eq_zero (R := ZMod 2) hrel
  refine finite_aeval_of_adjoin_eq_top_of_isIntegral adjoin_threeLinesCoord _ fun j ↦ ?_
  fin_cases j
  · exact hu
  · exact hv

/-- Over `𝔽₂ = ZMod 2`, the coordinate ring `A = 𝔽₂[X₀, X₁] ⧸ (X₀ X₁ (X₀ + X₁))` admits a
nonlinear Noether normalization generated by the quadratic element `x₀² + x₀ x₁ + x₁²`, and in
particular `A` is nontrivial and has Krull dimension `1`. -/
theorem algebraicIndependent_and_finite_quadratic_zmod_two :
    let I := Ideal.span ({X 0 * X 1 * (X 0 + X 1)} : Set (MvPolynomial (Fin 2) (ZMod 2)))
    let x : Fin 2 → MvPolynomial (Fin 2) (ZMod 2) ⧸ I := fun j ↦ Ideal.Quotient.mk I (X j)
    let z : Fin 1 → MvPolynomial (Fin 2) (ZMod 2) ⧸ I := fun _ ↦ x 0 ^ 2 + x 0 * x 1 + x 1 ^ 2
    AlgebraicIndependent (ZMod 2) z ∧
      (MvPolynomial.aeval z : MvPolynomial (Fin 1) (ZMod 2) →ₐ[ZMod 2] _).Finite ∧
      ringKrullDim (MvPolynomial (Fin 2) (ZMod 2) ⧸ I) = 1 := by
  refine ⟨algebraicIndependent_quadratic_zmod_two, finite_aeval_quadratic_zmod_two, ?_⟩
  simpa using ringKrullDim_eq_of_injective_of_isIntegral_mvPolynomial
    (MvPolynomial.aeval _).toRingHom algebraicIndependent_quadratic_zmod_two
    finite_aeval_quadratic_zmod_two.to_isIntegral

/-- **Failure of linear Noether normalization over a finite field.** For `k = ZMod 2`, the
nontrivial finitely generated `k`-algebra `A = k[X₀, X₁] ⧸ (X₀ X₁ (X₀ + X₁))` with coordinate
generators `x = (x₀, x₁)` admits no `d` and `C : Matrix (Fin d) (Fin 2) (ZMod 2)` making
`y i = ∑ j, C i j • x j` algebraically independent with `MvPolynomial.aeval y` module-finite. Thus
`[Infinite k]` cannot be omitted from `TauCeti.exists_linear_normalization`. -/
theorem not_exists_linear_normalization_zmod_two :
    let I := Ideal.span ({X 0 * X 1 * (X 0 + X 1)} : Set (MvPolynomial (Fin 2) (ZMod 2)))
    let x : Fin 2 → MvPolynomial (Fin 2) (ZMod 2) ⧸ I := fun j ↦ Ideal.Quotient.mk I (X j)
    Nontrivial (MvPolynomial (Fin 2) (ZMod 2) ⧸ I) ∧
      Algebra.adjoin (ZMod 2) (Set.range x) = ⊤ ∧
      ¬ ∃ (d : ℕ) (C : Matrix (Fin d) (Fin 2) (ZMod 2)),
        let y : Fin d → _ := fun i ↦ ∑ j, C i j • x j
        AlgebraicIndependent (ZMod 2) y ∧
          (MvPolynomial.aeval y : MvPolynomial (Fin d) (ZMod 2) →ₐ[ZMod 2] _).Finite := by
  obtain ⟨_, _, hdim⟩ := algebraicIndependent_and_finite_quadratic_zmod_two
  have hdim' : ringKrullDim ThreeLinesQuot = 1 := hdim
  have hnt : Nontrivial ThreeLinesQuot := by
    by_contra h
    rw [not_nontrivial_iff_subsingleton] at h
    have := ringKrullDim_eq_bot_of_subsingleton (R := ThreeLinesQuot)
    rw [hdim'] at this
    exact absurd this (by decide)
  refine ⟨hnt, adjoin_threeLinesCoord, ?_⟩
  rintro ⟨d, C, hind, hfin⟩
  have hd_eq : (d : WithBot ℕ∞) = 1 := by
    have hd' := ringKrullDim_eq_of_injective_of_isIntegral_mvPolynomial
      (MvPolynomial.aeval fun i ↦ ∑ j, C i j • threeLinesCoord j).toRingHom hind hfin.to_isIntegral
    simpa [ThreeLinesQuot, threeLinesIdeal, threeLinesCoord] using hd'.symm.trans hdim'
  have hd1 : d = 1 := by exact_mod_cast hd_eq
  subst hd1
  obtain ⟨π, hπ_surj, hπ_zero⟩ := exists_surjective_algHom_zmod_two_killing_linear (C 0)
  let φ : MvPolynomial (Fin 1) (ZMod 2) →ₐ[ZMod 2] Polynomial (ZMod 2) :=
    π.comp (MvPolynomial.aeval fun i ↦ ∑ j, C i j • threeLinesCoord j)
  have hφ_fin : φ.Finite := (AlgHom.Finite.of_surjective π hπ_surj).comp hfin
  have hφ_fac : (Algebra.ofId (ZMod 2) (Polynomial (ZMod 2))).comp
      (MvPolynomial.aeval (0 : Fin 1 → ZMod 2)) = φ := by
    refine MvPolynomial.algHom_ext fun i ↦ ?_
    fin_cases i
    simpa [φ] using hπ_zero.symm
  have hfin_k : (Algebra.ofId (ZMod 2) (Polynomial (ZMod 2))).Finite :=
    AlgHom.Finite.of_comp_finite (hφ_fac ▸ hφ_fin)
  have : Module.Finite (ZMod 2) (Polynomial (ZMod 2)) := RingHom.finite_algebraMap.mp hfin_k
  have : Finite (Polynomial (ZMod 2)) := Module.finite_of_finite (ZMod 2)
  exact not_finite (Polynomial (ZMod 2))

end CounterexampleZModTwo

end TauCeti
