section ShearElimination

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- If `f(x) = 0` for `x : Fin (n + 1) → A` and the top homogeneous component of `f` evaluated at
`i.insertNth 1 a` is a unit in `R`, then `x i` is integral over the `R`-subalgebra generated by the
sheared coordinates `fun j ↦ x (i.succAbove j) - a j • x i`. -/
theorem isIntegral_adjoin_sub_smul {n : ℕ} (x : Fin (n + 1) → A) (i : Fin (n + 1))
    (a : Fin n → R) {f : MvPolynomial (Fin (n + 1)) R} (hf : aeval x f = 0)
    (ha : IsUnit (eval (i.insertNth 1 a) (homogeneousComponent f.totalDegree f))) :
    IsIntegral (Algebra.adjoin R (Set.range fun j ↦ x (i.succAbove j) - a j • x i)) (x i) := by
  set z : Fin n → A := fun j ↦ x (i.succAbove j) - a j • x i
  set B : Subalgebra R A := Algebra.adjoin R (Set.range z)
  let zB : Fin n → B := fun j ↦ ⟨z j, Algebra.subset_adjoin ⟨j, rfl⟩⟩
  obtain ⟨u, hu⟩ := ha
  have hinv : (↑u⁻¹ : R) * eval (i.insertNth 1 a) (homogeneousComponent f.totalDegree f) = 1 := by
    rw [← hu, Units.inv_mul]
  let q : Polynomial (MvPolynomial (Fin n) R) :=
    Polynomial.C (C (↑u⁻¹ : R)) * shearToPolynomial i a f
  have hq : q.Monic := f.monic_C_mul_shearToPolynomial i a hinv
  refine ⟨q.map ↑(aeval (R := R) zB), hq.map _, ?_⟩
  rw [Polynomial.eval₂_map]
  have hcomp :
      (algebraMap B A).comp (↑(aeval (R := R) zB) : MvPolynomial (Fin n) R →+* B) =
        ↑(aeval (R := R) z) := by
    ext <;> simp [zB]
  have hpt : i.insertNth (x i) (fun j ↦ z j + a j • x i) = x := by
    funext k
    refine Fin.succAboveCases i ?_ (fun j ↦ ?_) k
    · simp
    · simp [z]
  dsimp only [q]
  rw [hcomp, Polynomial.eval₂_mul, Polynomial.eval₂_C, eval₂_aeval_shearToPolynomial, hpt, hf,
    mul_zero]

/-- Under the hypotheses of `isIntegral_adjoin_sub_smul`, every entry `x k` is integral over the
`R`-subalgebra generated by `fun j ↦ x (i.succAbove j) - a j • x i`. -/
theorem isIntegral_adjoin_sub_smul_apply {n : ℕ} (x : Fin (n + 1) → A) (i : Fin (n + 1))
    (a : Fin n → R) {f : MvPolynomial (Fin (n + 1)) R} (hf : aeval x f = 0)
    (ha : IsUnit (eval (i.insertNth 1 a) (homogeneousComponent f.totalDegree f)))
    (k : Fin (n + 1)) :
    IsIntegral (Algebra.adjoin R (Set.range fun j ↦ x (i.succAbove j) - a j • x i)) (x k) := by
  set z : Fin n → A := fun j ↦ x (i.succAbove j) - a j • x i
  set B : Subalgebra R A := Algebra.adjoin R (Set.range z)
  have hxi : IsIntegral B (x i) := isIntegral_adjoin_sub_smul x i a hf ha
  refine Fin.succAboveCases i hxi (fun j ↦ ?_) k
  have hz : IsIntegral B (z j) :=
    isIntegral_algebraMap (x := (⟨z j, Algebra.subset_adjoin ⟨j, rfl⟩⟩ : B))
  have hx_eq : x (i.succAbove j) = z j + algebraMap R B (a j) • x i := by
    simp [z]
  rw [hx_eq]
  exact hz.add (IsIntegral.smul _ hxi)

/-- If `x : Fin (n + 1) → A` generates `A` over `R`, `f(x) = 0`, and the top homogeneous component
of `f` is invertible at `i.insertNth 1 a`, then `A` is module-finite over the `R`-subalgebra
generated by the `n` sheared coordinates `fun j ↦ x (i.succAbove j) - a j • x i`. -/
theorem finite_adjoin_sub_smul_of_adjoin_eq_top {n : ℕ} {x : Fin (n + 1) → A}
    (hx : Algebra.adjoin R (Set.range x) = ⊤) (i : Fin (n + 1)) (a : Fin n → R)
    {f : MvPolynomial (Fin (n + 1)) R} (hf : aeval x f = 0)
    (ha : IsUnit (eval (i.insertNth 1 a) (homogeneousComponent f.totalDegree f))) :
    Module.Finite (Algebra.adjoin R (Set.range fun j ↦ x (i.succAbove j) - a j • x i)) A := by
  set B : Subalgebra R A := Algebra.adjoin R (Set.range fun j ↦ x (i.succAbove j) - a j • x i)
  have hadj : Algebra.adjoin B (Set.range x) = ⊤ := by
    rw [eq_top_iff]
    have hle : (⊤ : Subalgebra R A) ≤ (Algebra.adjoin B (Set.range x)).restrictScalars R := by
      rw [← hx]
      exact Algebra.adjoin_le fun y hy ↦ Algebra.subset_adjoin hy
    intro y _
    exact hle trivial
  refine ⟨?_⟩
  rw [← Algebra.top_toSubmodule, ← hadj]
  exact fg_adjoin_of_finite (Set.finite_range x) fun y hy ↦ by
    obtain ⟨k, rfl⟩ := hy
    exact isIntegral_adjoin_sub_smul_apply x i a hf ha k

/-- The `n × (n + 1)` shear elimination matrix sending `x` to the sheared coordinates
`fun j ↦ x (i.succAbove j) - a j • x i`. -/
private def shearElimMatrix {n : ℕ} (i : Fin (n + 1)) (a : Fin n → R) :
    Matrix (Fin n) (Fin (n + 1)) R :=
  fun j ↦ i.insertNth (-a j) (Pi.single j 1)

private theorem sum_shearElimMatrix_smul {n : ℕ} (i : Fin (n + 1)) (a : Fin n → R)
    (x : Fin (n + 1) → A) (j : Fin n) :
    ∑ k, shearElimMatrix i a j k • x k = x (i.succAbove j) - a j • x i := by
  rw [Fin.sum_univ_succAbove _ i]
  simp [shearElimMatrix, Pi.single_apply, sub_eq_add_neg, add_comm]

end ShearElimination

section InfiniteField

/-- **Linear Noether normalization in prescribed generators.** Let `A` be a nontrivial commutative
algebra over an infinite field `k`, generated over `k` by `x : Fin n → A`. Then there exist
`d ≤ n` and a matrix `C : Matrix (Fin d) (Fin n) k` such that the linear combinations
`y i = ∑ j, C i j • x j` are algebraically independent over `k`, `A` is a finite module over
`k[X_0, …, X_{d-1}]` via `MvPolynomial.aeval y`, and `ringKrullDim A = d`. -/
theorem exists_linear_normalization {k A : Type*} [Field k] [Infinite k]
    [CommRing A] [Nontrivial A] [Algebra k A]
    {n : ℕ} (x : Fin n → A) (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    ∃ (d : ℕ) (_ : d ≤ n) (C : Matrix (Fin d) (Fin n) k),
      let y : Fin d → A := fun i => ∑ j, C i j • x j
      AlgebraicIndependent k y ∧
        (MvPolynomial.aeval y : MvPolynomial (Fin d) k →ₐ[k] A).Finite ∧
        ringKrullDim A = (d : WithBot ℕ∞) := by
  induction n generalizing A with
  | zero =>
    refine ⟨0, le_rfl, 0, ?_⟩
    intro y
    have hy : AlgebraicIndependent k y :=
      algebraicIndependent_empty_type_iff.mpr (RingHom.injective (algebraMap k A))
    have hsurj : Function.Surjective (aeval y : MvPolynomial (Fin 0) k →ₐ[k] A) := by
      rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
      simpa [Set.range_eq_empty] using hx
    have hfin : (aeval y : MvPolynomial (Fin 0) k →ₐ[k] A).Finite :=
      AlgHom.Finite.of_surjective _ hsurj
    refine ⟨hy, hfin, ?_⟩
    simpa using ringKrullDim_eq_of_injective_of_isIntegral_mvPolynomial (aeval y).toRingHom hy
      hfin.to_isIntegral
  | succ n ih =>
    by_cases hxi : AlgebraicIndependent k x
    · refine ⟨n + 1, le_rfl, 1, ?_⟩
      intro y
      have hyx : y = x := by
        funext i
        simp [y, Matrix.one_apply]
      have hsurj : Function.Surjective (aeval y : MvPolynomial (Fin (n + 1)) k →ₐ[k] A) := by
        rw [hyx, ← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
        exact hx
      have hfin : (aeval y : MvPolynomial (Fin (n + 1)) k →ₐ[k] A).Finite :=
        AlgHom.Finite.of_surjective _ hsurj
      have hy : AlgebraicIndependent k y := hyx ▸ hxi
      refine ⟨hy, hfin, ?_⟩
      simpa using ringKrullDim_eq_of_injective_of_isIntegral_mvPolynomial (aeval y).toRingHom hy
        hfin.to_isIntegral
    · -- Choose a nonzero polynomial relation `f(x) = 0` and shear along coordinate `0`.
      obtain ⟨f, hf0, hfne⟩ : ∃ f : MvPolynomial (Fin (n + 1)) k, aeval x f = 0 ∧ f ≠ 0 := by
        simpa [algebraicIndependent_iff, not_forall] using hxi
      obtain ⟨a, ha⟩ := exists_eval_insertNth_homogeneousComponent_ne_zero (0 : Fin (n + 1)) hfne
      set z : Fin n → A := fun j ↦ x ((0 : Fin (n + 1)).succAbove j) - a j • x 0
      set B : Subalgebra k A := Algebra.adjoin k (Set.range z)
      have : Module.Finite B A := finite_adjoin_sub_smul_of_adjoin_eq_top hx 0 a hf0 ha.isUnit
      let zB : Fin n → B := fun j ↦ ⟨z j, Algebra.subset_adjoin ⟨j, rfl⟩⟩
      have hzB : Algebra.adjoin k (Set.range zB) = ⊤ := by
        apply Subalgebra.map_injective (f := B.val) Subtype.val_injective
        rw [Algebra.map_top, Subalgebra.range_val, AlgHom.map_adjoin]
        have hrange : B.val '' Set.range zB = Set.range z := by
          ext w
          simp [zB]
        rw [hrange]
      obtain ⟨d, hd, C₀, hy₀, hfin₀, -⟩ := ih zB hzB
      refine ⟨d, Nat.le_succ_of_le hd, C₀ * shearElimMatrix 0 a, ?_⟩
      intro y
      let yB : Fin d → B := fun i ↦ ∑ j, C₀ i j • zB j
      have hy_eq : y = B.val ∘ yB := by
        funext i
        dsimp [y, yB]
        change ∑ k_1, (C₀ * shearElimMatrix 0 a) i k_1 • x k_1 = B.val (∑ j, C₀ i j • zB j)
        rw [Matrix.sum_mul_smul, map_sum]
        refine Finset.sum_congr rfl fun j _ ↦ ?_
        rw [Subalgebra.val_apply, SetLike.val_smul, sum_shearElimMatrix_smul]
      have hy : AlgebraicIndependent k y := hy_eq ▸ hy₀.map' Subtype.val_injective
      have haeval : (aeval y : MvPolynomial (Fin d) k →ₐ[k] A).toRingHom =
          (algebraMap B A).comp (aeval yB).toRingHom := by
        rw [hy_eq]
        change (aeval (B.val ∘ yB)).toRingHom = (B.val.comp (aeval yB)).toRingHom
        congr 1
        ext i
        simp
      have hfin : (aeval y : MvPolynomial (Fin d) k →ₐ[k] A).Finite := by
        rw [AlgHom.Finite, haeval]
        exact (RingHom.finite_algebraMap.mpr ‹Module.Finite B A›).comp hfin₀
      refine ⟨hy, hfin, ?_⟩
      simpa using ringKrullDim_eq_of_injective_of_isIntegral_mvPolynomial (aeval y).toRingHom hy
        hfin.to_isIntegral

/-- **Linear Noether normalization for polynomial quotients.** Over an infinite field `k`, for any
proper ideal `I` of `MvPolynomial (Fin n) k`, there exist `d ≤ n` and a matrix
`C : Matrix (Fin d) (Fin n) k` such that the linear combinations of the residue classes of `X j`
are algebraically independent over `k`, make `MvPolynomial (Fin n) k ⧸ I` module-finite over
`MvPolynomial (Fin d) k`, and compute its Krull dimension `d`. -/
theorem exists_linear_normalization_quotient {k : Type*} [Field k] [Infinite k]
    {n : ℕ} (I : Ideal (MvPolynomial (Fin n) k)) (hI : I ≠ ⊤) :
    ∃ (d : ℕ) (_ : d ≤ n) (C : Matrix (Fin d) (Fin n) k),
      let y : Fin d → MvPolynomial (Fin n) k ⧸ I :=
        fun i ↦ ∑ j, C i j • Ideal.Quotient.mk I (X j)
      AlgebraicIndependent k y ∧
        (aeval y : MvPolynomial (Fin d) k →ₐ[k] MvPolynomial (Fin n) k ⧸ I).Finite ∧
        ringKrullDim (MvPolynomial (Fin n) k ⧸ I) = (d : WithBot ℕ∞) := by
  have : Nontrivial (MvPolynomial (Fin n) k ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  refine exists_linear_normalization (fun j ↦ Ideal.Quotient.mk I (X j)) ?_
  rw [eq_top_iff]
  rintro q -
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
  have hp : p ∈ (⊤ : Subalgebra k (MvPolynomial (Fin n) k)) := trivial
  rw [← adjoin_range_X] at hp
  have hmap : Ideal.Quotient.mkₐ k I p ∈
      (Algebra.adjoin k (Set.range X)).map (Ideal.Quotient.mkₐ k I) :=
    Subalgebra.mem_map.mpr ⟨p, hp, rfl⟩
  rw [AlgHom.map_adjoin] at hmap
  have hrange : Ideal.Quotient.mkₐ k I '' Set.range X =
      Set.range (fun j ↦ Ideal.Quotient.mk I (X j)) := by
    ext w
    simp
  rwa [hrange] at hmap

end InfiniteField

section BaseChange

/-- **Persistence of a linear Noether normalization under field extensions.** If `C : Matrix (Fin d)
(Fin n) k` linearly normalizes a `k`-algebra `A` in generators `x : Fin n → A` over an arbitrary
field `k` (not necessarily infinite), then for every field extension `K / k` the mapped matrix
`C.map (algebraMap k K)` linearly normalizes `K ⊗[k] A` in the base-changed generators
`fun j ↦ (1 : K) ⊗ₜ[k] x j`, and `ringKrullDim (K ⊗[k] A) = d`. -/
theorem linear_normalization_tensorProduct {k : Type*} (K : Type*) [Field k] [Field K]
    [Algebra k K] {A : Type*} [CommRing A] [Algebra k A] {d n : ℕ} (x : Fin n → A)
    (C : Matrix (Fin d) (Fin n) k)
    (hy : AlgebraicIndependent k fun i ↦ ∑ j, C i j • x j)
    (hfin : (aeval (fun i ↦ ∑ j, C i j • x j) : MvPolynomial (Fin d) k →ₐ[k] A).Finite) :
    let yK : Fin d → K ⊗[k] A :=
      fun i ↦ ∑ j, C.map (algebraMap k K) i j • ((1 : K) ⊗ₜ[k] x j)
    AlgebraicIndependent K yK ∧
      (aeval yK : MvPolynomial (Fin d) K →ₐ[K] K ⊗[k] A).Finite ∧
      ringKrullDim (K ⊗[k] A) = (d : WithBot ℕ∞) := by
  intro yK
  have hyK_eq : yK = fun i ↦ (1 : K) ⊗ₜ[k] ∑ j, C i j • x j :=
    funext (Matrix.sum_map_algebraMap_smul_one_tmul C x)
  have hyK : AlgebraicIndependent K yK := hyK_eq ▸ hy.baseChange K
  have hfinK : (aeval yK : MvPolynomial (Fin d) K →ₐ[K] K ⊗[k] A).Finite :=
    hyK_eq ▸ MvPolynomial.finite_aeval_one_tmul K hfin
  refine ⟨hyK, hfinK, ?_⟩
  simpa using ringKrullDim_eq_of_injective_of_isIntegral_mvPolynomial (aeval yK).toRingHom hyK
    hfinK.to_isIntegral

end BaseChange

section Counterexample

/-- Over `𝔽₂`, the cubic `L₀ * L₁ * (L₀ + L₁)` of any two linear forms in `X 0, X 1` is a scalar
multiple of `X 0 * X 1 * (X 0 + X 1)`. -/
private theorem zmod_two_linear_cubic_eq_smul (a₀ a₁ b₀ b₁ : ZMod 2) :
    let L₀ : MvPolynomial (Fin 2) (ZMod 2) := a₀ • X 0 + a₁ • X 1
    let L₁ : MvPolynomial (Fin 2) (ZMod 2) := b₀ • X 0 + b₁ • X 1
    L₀ * L₁ * (L₀ + L₁) =
      (a₀ * b₁ + a₁ * b₀) • (X 0 * X 1 * (X 0 + X 1) : MvPolynomial (Fin 2) (ZMod 2)) := by
  intro L₀ L₁
  have hc0 : a₀ * b₀ * (a₀ + b₀) = 0 := by fin_cases a₀ <;> fin_cases b₀ <;> decide
  have hc1 : a₁ * b₁ * (a₁ + b₁) = 0 := by fin_cases a₁ <;> fin_cases b₁ <;> decide
  have hc2 : a₀ * b₀ * (a₁ + b₁) + (a₀ * b₁ + a₁ * b₀) * (a₀ + b₀) = a₀ * b₁ + a₁ * b₀ := by
    fin_cases a₀ <;> fin_cases a₁ <;> fin_cases b₀ <;> fin_cases b₁ <;> decide
  have hc3 : a₁ * b₁ * (a₀ + b₀) + (a₀ * b₁ + a₁ * b₀) * (a₁ + b₁) = a₀ * b₁ + a₁ * b₀ := by
    fin_cases a₀ <;> fin_cases a₁ <;> fin_cases b₀ <;> fin_cases b₁ <;> decide
  simp only [L₀, L₁, smul_eq_C_mul]
  calc
    (C a₀ * X (0 : Fin 2) + C a₁ * X 1) * (C b₀ * X 0 + C b₁ * X 1) *
        (C a₀ * X 0 + C a₁ * X 1 + (C b₀ * X 0 + C b₁ * X 1)) =
      C (a₀ * b₀ * (a₀ + b₀)) * X 0 ^ 3 +
        C (a₀ * b₀ * (a₁ + b₁) + (a₀ * b₁ + a₁ * b₀) * (a₀ + b₀)) * (X 0 ^ 2 * X 1) +
        C (a₁ * b₁ * (a₀ + b₀) + (a₀ * b₁ + a₁ * b₀) * (a₁ + b₁)) * (X 0 * X 1 ^ 2) +
        C (a₁ * b₁ * (a₁ + b₁)) * X 1 ^ 3 := by
      simp only [map_add, map_mul]
      ring
    _ = C (a₀ * b₁ + a₁ * b₀) * (X 0 * X 1 * (X 0 + X 1)) := by
      rw [hc0, hc1, hc2, hc3, map_zero]
      ring

/-- In `Polynomial (ZMod 2)`, the indeterminate `Polynomial.X` is not integral over `ZMod 2`. -/
private theorem not_isIntegral_zmod_two_polynomial_X :
    ¬ IsIntegral (ZMod 2) (Polynomial.X : Polynomial (ZMod 2)) := by
  rintro ⟨P, hPmonic, hPeval⟩
  rw [Polynomial.algebraMap_eq, Polynomial.eval₂_C_X] at hPeval
  exact one_ne_zero (hPmonic.leadingCoeff.symm.trans (by simp [hPeval]))

/-- **Sharpness of `[Infinite k]` in linear Noether normalization.** Over `𝔽₂`, let
`I = Ideal.span {X 0 * X 1 * (X 0 + X 1)}` in `MvPolynomial (Fin 2) (ZMod 2)`, and let `x` be the
pair of coordinate residue classes in `A = MvPolynomial (Fin 2) (ZMod 2) ⧸ I`. Then `A` is
nontrivial and generated over `𝔽₂` by `x`, yet there exist no `d : ℕ` and no matrix
`C : Matrix (Fin d) (Fin 2) (ZMod 2)` whose linear combinations `y i = ∑ j, C i j • x j` are
algebraically independent over `𝔽₂` with `MvPolynomial.aeval y` integral (in particular, finite). -/
theorem not_exists_linear_normalization_zmod_two :
    let f : MvPolynomial (Fin 2) (ZMod 2) := X 0 * X 1 * (X 0 + X 1)
    let I : Ideal (MvPolynomial (Fin 2) (ZMod 2)) := Ideal.span {f}
    let x : Fin 2 → MvPolynomial (Fin 2) (ZMod 2) ⧸ I :=
      fun j ↦ Ideal.Quotient.mk I (X j)
    Nontrivial (MvPolynomial (Fin 2) (ZMod 2) ⧸ I) ∧
      Algebra.adjoin (ZMod 2) (Set.range x) = ⊤ ∧
      ¬ ∃ (d : ℕ) (C : Matrix (Fin d) (Fin 2) (ZMod 2)),
        let y : Fin d → MvPolynomial (Fin 2) (ZMod 2) ⧸ I := fun i ↦ ∑ j, C i j • x j
        AlgebraicIndependent (ZMod 2) y ∧
          (aeval y :
            MvPolynomial (Fin d) (ZMod 2) →ₐ[ZMod 2]
              MvPolynomial (Fin 2) (ZMod 2) ⧸ I).IsIntegral := by
  intro f I x
  have hf_ker : ∀ u : Fin 2 → ZMod 2,
      f ∈ RingHom.ker
        (aeval (fun j : Fin 2 ↦ Polynomial.C (u j) * Polynomial.X) :
          MvPolynomial (Fin 2) (ZMod 2) →ₐ[ZMod 2] Polynomial (ZMod 2)) := by
    intro u
    have hu_id : ∀ a b : ZMod 2, a * b * (a + b) = 0 := by decide
    have hu : u 0 * u 1 * (u 0 + u 1) = 0 := hu_id (u 0) (u 1)
    change aeval (fun j : Fin 2 ↦ Polynomial.C (u j) * Polynomial.X) f = 0
    simp only [f, map_mul, map_add, aeval_X]
    have hcalc :
        Polynomial.C (u 0) * Polynomial.X * (Polynomial.C (u 1) * Polynomial.X) *
            (Polynomial.C (u 0) * Polynomial.X + Polynomial.C (u 1) * Polynomial.X) =
          Polynomial.C (u 0 * u 1 * (u 0 + u 1)) * Polynomial.X ^ 3 := by
      simp only [map_mul, map_add]
      ring
    rw [hcalc, hu, map_zero, zero_mul]
  have hI (u : Fin 2 → ZMod 2) (p : MvPolynomial (Fin 2) (ZMod 2)) (hp : p ∈ I) :
      aeval (fun j ↦ Polynomial.C (u j) * Polynomial.X) p = 0 :=
    RingHom.mem_ker.mp (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (hf_ker u)) hp)
  let π (u : Fin 2 → ZMod 2) :
      MvPolynomial (Fin 2) (ZMod 2) ⧸ I →ₐ[ZMod 2] Polynomial (ZMod 2) :=
    Ideal.Quotient.liftₐ I (aeval fun j ↦ Polynomial.C (u j) * Polynomial.X) (hI u)
  have hπx (u : Fin 2 → ZMod 2) (j : Fin 2) :
      π u (x j) = Polynomial.C (u j) * Polynomial.X :=
    (AlgHom.congr_fun
      (Ideal.Quotient.liftₐ_comp (R₁ := ZMod 2) I
        (aeval fun k ↦ Polynomial.C (u k) * Polynomial.X) (hI u))
      (X j)).trans (aeval_X _ j)
  have hnt : Nontrivial (MvPolynomial (Fin 2) (ZMod 2) ⧸ I) :=
    (π ![1, 0]).toRingHom.domain_nontrivial
  have hadj : Algebra.adjoin (ZMod 2) (Set.range x) = ⊤ := by
    rw [eq_top_iff]
    rintro q -
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
    have hp : p ∈ (⊤ : Subalgebra (ZMod 2) (MvPolynomial (Fin 2) (ZMod 2))) := trivial
    rw [← adjoin_range_X] at hp
    have hmap : Ideal.Quotient.mkₐ (ZMod 2) I p ∈
        (Algebra.adjoin (ZMod 2) (Set.range X)).map (Ideal.Quotient.mkₐ (ZMod 2) I) :=
      Subalgebra.mem_map.mpr ⟨p, hp, rfl⟩
    rw [AlgHom.map_adjoin] at hmap
    have hrange : Ideal.Quotient.mkₐ (ZMod 2) I '' Set.range X = Set.range x := by
      ext w
      simp [x]
    rwa [hrange] at hmap
  refine ⟨hnt, hadj, ?_⟩
  rintro ⟨d, C, hy, hint⟩
  set y : Fin d → MvPolynomial (Fin 2) (ZMod 2) ⧸ I := fun i ↦ ∑ j, C i j • x j
  -- Helper: if some `u` has `(u 0 = 1 ∨ u 1 = 1)` and annihilates every row of `C`, then
  -- `Polynomial.X` would be integral over `ZMod 2`.
  have hline_contra (u : Fin 2 → ZMod 2) (hu_nz : u 0 = 1 ∨ u 1 = 1)
      (hu_orth : ∀ i : Fin d, C i 0 * u 0 + C i 1 * u 1 = 0) : False := by
    have hπy (i : Fin d) : π u (y i) = 0 := by
      dsimp only [y]
      rw [Fin.sum_univ_two, map_add, map_smul, map_smul, hπx, hπx]
      simp only [Algebra.smul_def, Polynomial.algebraMap_eq]
      have hlin :
          Polynomial.C (C i 0) * (Polynomial.C (u 0) * Polynomial.X) +
              Polynomial.C (C i 1) * (Polynomial.C (u 1) * Polynomial.X) =
            Polynomial.C (C i 0 * u 0 + C i 1 * u 1) * Polynomial.X := by
        simp only [map_add, map_mul]
        ring
      rw [hlin, hu_orth i, map_zero, zero_mul]
    have hX_mem : (Polynomial.X : Polynomial (ZMod 2)) ∈ Set.range (π u) := by
      rcases hu_nz with h0 | h1
      · exact ⟨x 0, by simp [hπx, h0]⟩
      · exact ⟨x 1, by simp [hπx, h1]⟩
    obtain ⟨w, hw⟩ := hX_mem
    obtain ⟨P, hPmonic, hPw⟩ := hint w
    -- Map `P` along `(π u).comp (aeval y) : MvPolynomial (Fin d) (ZMod 2) →ₐ[ZMod 2] (ZMod 2)[X]`,
    -- which factors through `ZMod 2` because `π u` kills every `y i`.
    let ε : MvPolynomial (Fin d) (ZMod 2) →+* ZMod 2 := eval 0
    have hπ_aeval (q : MvPolynomial (Fin d) (ZMod 2)) :
        π u (aeval y q) = Polynomial.C (ε q) := by
      have hhom :
          (π u).comp (aeval y) =
            (Algebra.ofId (ZMod 2) (Polynomial (ZMod 2))).comp (aeval 0) :=
        MvPolynomial.algHom_ext fun i ↦ by
          rw [AlgHom.comp_apply, AlgHom.comp_apply, aeval_X, aeval_X, hπy i, Pi.zero_apply,
            map_zero]
      simpa [ε, Polynomial.algebraMap_eq, aeval_eq_eval] using AlgHom.congr_fun hhom q
    refine not_isIntegral_zmod_two_polynomial_X ⟨P.map ε, hPmonic.map ε, ?_⟩
    rw [Polynomial.eval₂_map]
    have hcomp :
        (algebraMap (ZMod 2) (Polynomial (ZMod 2))).comp ε =
          (π u).toRingHom.comp (aeval y).toRingHom :=
      RingHom.ext fun q ↦ by simpa [Polynomial.algebraMap_eq] using (hπ_aeval q).symm
    have hw' : (π u).toRingHom w = Polynomial.X := hw
    rw [hcomp, ← hw', ← Polynomial.hom_eval₂, hPw, map_zero]
  have zmod2_eq_one : ∀ c : ZMod 2, c ≠ 0 → c = 1 := by decide
  rcases d with _ | _ | m
  · -- `d = 0`: the line `u = ![1, 0]` trivially annihilates all `0` rows of `C`.
    exact hline_contra ![1, 0] (Or.inl rfl) fun i ↦ i.elim0
  · -- `d = 1`: the single row `(C 0 0, C 0 1)` over `𝔽₂` annihilates one of the three lines.
    have hi0 (i : Fin 1) : i = 0 := Subsingleton.elim i 0
    by_cases h0 : C 0 0 = 0
    · exact hline_contra ![1, 0] (Or.inl rfl) fun i ↦ by
        rw [hi0 i]
        simp [h0]
    · by_cases h1 : C 0 1 = 0
      · exact hline_contra ![0, 1] (Or.inr rfl) fun i ↦ by
          rw [hi0 i]
          simp [h1]
      · exact hline_contra ![1, 1] (Or.inl rfl) fun i ↦ by
          rw [hi0 i, zmod2_eq_one _ h0, zmod2_eq_one _ h1]
          decide
  · -- `d = m + 2 ≥ 2`: the first two linear combinations satisfy the nonzero cubic
    -- `X 0 * X 1 * (X 0 + X 1)` in `MvPolynomial (Fin (m + 2)) (ZMod 2)`.
    let i₀ : Fin (m + 2) := 0
    let i₁ : Fin (m + 2) := 1
    let Q : MvPolynomial (Fin (m + 2)) (ZMod 2) := X i₀ * X i₁ * (X i₀ + X i₁)
    have hQ_eval : aeval y Q = 0 := by
      simp only [Q, y, map_mul, map_add, aeval_X, Fin.sum_univ_two]
      let mk : MvPolynomial (Fin 2) (ZMod 2) →ₐ[ZMod 2] MvPolynomial (Fin 2) (ZMod 2) ⧸ I :=
        Ideal.Quotient.mkₐ (ZMod 2) I
      change mk (C i₀ 0 • X 0 + C i₀ 1 • X 1) * mk (C i₁ 0 • X 0 + C i₁ 1 • X 1) *
        (mk (C i₀ 0 • X 0 + C i₀ 1 • X 1) + mk (C i₁ 0 • X 0 + C i₁ 1 • X 1)) = 0
      rw [← map_add, ← map_mul, ← map_mul, zmod_two_linear_cubic_eq_smul, map_smul]
      have hmk_f : mk f = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton f))
      change _ • mk f = 0
      rw [hmk_f, smul_zero]
    have hQ0 : Q = 0 := hy.eq_zero_of_aeval_eq_zero Q hQ_eval
    let v : Fin (m + 2) → Polynomial (ZMod 2) :=
      fun k ↦ if k = i₀ then 1 else if k = i₁ then Polynomial.X else 0
    have hi₀₁ : i₁ ≠ i₀ := Fin.ne_of_val_ne (by simp [i₀, i₁])
    have hvQ : (aeval v Q).coeff 1 = 1 := by
      simp [Q, v, hi₀₁, mul_add]
    rw [hQ0, map_zero, Polynomial.coeff_zero] at hvQ
    exact zero_ne_one hvQ

end Counterexample

end TauCeti
