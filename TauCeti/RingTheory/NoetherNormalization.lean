/-!
# Linear Noether normalization in prescribed generators

Given a nontrivial algebra `A` over an infinite field `k` generated by a prescribed finite tuple
`x₁, …, xₙ`, Noether's original 1926 normalization argument produces algebraically independent
elements `y₁, …, y_d` as **`k`-linear combinations** `yᵢ = ∑ⱼ Cᵢⱼ xⱼ` of the given generators over
which `A` is a finite module, with `d ≤ n` and `ringKrullDim A = d`. By contrast, Nagata's nonlinear
substitution `Xᵢ ↦ Xᵢ + X₁^{rⁱ}` (`exists_algebraicIndependent_isIntegral_of_fintype` in Mathlib)
works over arbitrary fields, including finite fields, at the cost of destroying linearity and
homogeneity in the given generators.

## Proof outline

1. **Unipotent linear shear (`linearShearMatrix`).** Over any commutative semiring `R`, for a
   vector `a : Fin r → R`, the matrix `linearShearMatrix a` fixes `X₀` and sends
   `X_{i+1} ↦ aᵢ X₀ + X_{i+1}`. After this linear substitution, viewing a polynomial
   `f : MvPolynomial (Fin (r + 1)) R` of total degree `D` as a univariate polynomial in `X₀` via
   `MvPolynomial.finSuccEquiv`, its degree in `X₀` is at most `D` and its `D`-th coefficient is
   `MvPolynomial.C (MvPolynomial.eval a (dehomogenize 0 (MvPolynomial.homogeneousComponent D f)))`
   (`coeff_totalDegree_finSuccEquiv_linearSubst_linearShearMatrix`).
2. **Nonvanishing on a Zariski open (`exists_eval_dehomogenize_homogeneousComponent_ne_zero`).**
   When `f ≠ 0`, its top homogeneous component is nonzero and dehomogenization in `X₀` is
   injective on forms of degree `D`, so over an infinite integral domain `R` there exists
   `a : Fin r → R` where the dehomogenized top form does not vanish.
3. **Monic elimination (`isIntegral_adjoin_of_isUnit_eval_dehomogenize`,
   `moduleFinite_adjoin_of_isUnit_eval_dehomogenize`).** Over any commutative ring `R`, whenever
   that scalar value is a unit of `R` and `MvPolynomial.aeval x f = 0`, scaling by its inverse
   yields a monic relation in `x 0` over the subalgebra generated by `zᵢ = x_{i+1} - aᵢ • x₀`,
   making `x 0` integral and `A` finite over `R[z₁, …, zᵣ]`.
4. **Iterative linear normalization (`exists_linear_normalization`).** Inducting on `n` over an
   infinite field `k` eliminates algebraic dependencies one variable at a time while composing the
   transition matrices, and `ringKrullDim_eq_of_injective_of_isIntegral_mvPolynomial` identifies
   `d` with `ringKrullDim A`. Row rank bounds (`card_le_of_algebraicIndependent_sum_smul`) and
   stability under flat or faithfully flat base change
   (`algebraicIndependent_sum_map_smul_one_tmul`, `aeval_sum_map_smul_one_tmul_finite`) hold
   uniformly for every normalizing matrix `C`.

## References

* E. Noether, *Der Endlichkeitssatz der Invarianten endlicher linearer Gruppen der
  Charakteristik p*, Nachr. Ges. Wiss. Göttingen (1926), 28–35.
* D. Eisenbud, *Commutative Algebra with a View Toward Algebraic Geometry*, Theorem 13.3.
* J. S. Milne, *Algebraic Geometry*, Lemma 2.43 and Theorem 2.44.
-/

public section

open scoped Matrix Polynomial TensorProduct

namespace TauCeti

section Shear

/-- The `(r + 1) × (r + 1)` unipotent shear matrix associated to `a : Fin r → R`, fixing coordinate
`0` and sending row `i.succ` to `Fin.cons (a i) (Pi.single i 1)`, so the induced linear
substitution on `MvPolynomial (Fin (r + 1)) R` sends `X 0 ↦ X 0` and
`X i.succ ↦ C (a i) * X 0 + X i.succ`. -/
def linearShearMatrix {R : Type*} [Zero R] [One R] {r : ℕ} (a : Fin r → R) :
    Matrix (Fin (r + 1)) (Fin (r + 1)) R :=
  Matrix.of (Fin.cons (Pi.single 0 1) fun i ↦ Fin.cons (a i) (Pi.single i 1))

@[simp]
theorem linearShearMatrix_zero_apply {R : Type*} [Zero R] [One R] {r : ℕ} (a : Fin r → R)
    (j : Fin (r + 1)) :
    linearShearMatrix a 0 j = if j = 0 then 1 else 0 := by
  simp [linearShearMatrix, Pi.single_apply]

@[simp]
theorem linearShearMatrix_succ_zero {R : Type*} [Zero R] [One R] {r : ℕ} (a : Fin r → R)
    (i : Fin r) :
    linearShearMatrix a i.succ 0 = a i := by
  simp [linearShearMatrix]

@[simp]
theorem linearShearMatrix_succ_succ {R : Type*} [Zero R] [One R] {r : ℕ} (a : Fin r → R)
    (i j : Fin r) :
    linearShearMatrix a i.succ j.succ = if j = i then 1 else 0 := by
  simp [linearShearMatrix, Pi.single_apply]

@[simp]
theorem linearShearMatrix_col_zero {R : Type*} [Zero R] [One R] {r : ℕ} (a : Fin r → R) :
    (linearShearMatrix a).col 0 = Fin.insertNth 0 1 a := by
  ext j
  refine Fin.cases ?_ (fun i ↦ ?_) j <;> simp

/-- Multiplying the first standard basis vector `Pi.single 0 1` by `linearShearMatrix a` inserts `1`
at index `0` in front of `a`. -/
theorem linearShearMatrix_mulVec_single_zero {R : Type*} [NonAssocSemiring R] {r : ℕ}
    (a : Fin r → R) :
    linearShearMatrix a *ᵥ Pi.single 0 1 = Fin.insertNth 0 1 a := by
  ext
  simp

/-- Over an `R`-algebra `A`, acting by `linearShearMatrix a` on `Fin.cons x₀ z` keeps `x₀` in slot
`0` and shifts `z i` by `a i • x₀` in slot `i.succ`. -/
theorem map_linearShearMatrix_mulVec_cons {R A : Type*} [CommSemiring R] [Semiring A]
    [Algebra R A] {r : ℕ} (a : Fin r → R) (x₀ : A) (z : Fin r → A) :
    (linearShearMatrix a).map (algebraMap R A) *ᵥ Fin.cons x₀ z =
      Fin.cons x₀ fun i ↦ a i • x₀ + z i := by
  ext j
  refine Fin.cases ?_ (fun i ↦ ?_) j
  · simp [Matrix.mulVec, dotProduct]
  · rw [Fin.cons_succ, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
    simp [Algebra.smul_def]

/-- Linear substitution commutes with extracting homogeneous components of every degree. -/
theorem homogeneousComponent_linearSubst {σ R : Type*} [Fintype σ] [CommSemiring R]
    (M : Matrix σ σ R) (d : ℕ) (f : MvPolynomial σ R) :
    MvPolynomial.homogeneousComponent d (MvPolynomial.linearSubst M f) =
      MvPolynomial.linearSubst M (MvPolynomial.homogeneousComponent d f) := by
  conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent f]
  rw [map_sum, map_sum, Finset.sum_eq_single d]
  · exact MvPolynomial.homogeneousComponent_eq_self
      ((MvPolynomial.homogeneousComponent_isHomogeneous d f).linearSubst M)
  · intro i _ hid
    simp [MvPolynomial.homogeneousComponent_of_mem
      ((MvPolynomial.homogeneousComponent_isHomogeneous i f).linearSubst M), hid.symm]
  · intro hd
    have hlt : f.totalDegree < d := by simp only [Finset.mem_range, not_lt] at hd; omega
    rw [MvPolynomial.homogeneousComponent_eq_zero d f hlt, map_zero, map_zero]

/-- A linear change of variables does not increase the total degree of a multivariate polynomial. -/
theorem totalDegree_linearSubst_le {σ R : Type*} [Fintype σ] [CommSemiring R]
    (M : Matrix σ σ R) (f : MvPolynomial σ R) :
    (MvPolynomial.linearSubst M f).totalDegree ≤ f.totalDegree := by
  rw [MvPolynomial.totalDegree]
  refine Finset.sup_le fun m hm ↦ ?_
  have hmdeg : (m.sum fun _ e ↦ e) = m.degree := by
    rw [Finsupp.degree_eq_sum, Finsupp.sum_fintype _ _ (by simp)]
  rw [hmdeg]
  by_contra! hlt
  have hzero : MvPolynomial.homogeneousComponent m.degree (MvPolynomial.linearSubst M f) = 0 := by
    rw [homogeneousComponent_linearSubst,
      MvPolynomial.homogeneousComponent_eq_zero m.degree f hlt, map_zero]
  have hcoeff := congrArg (fun p : MvPolynomial σ R ↦ p.coeff m) hzero
  exact MvPolynomial.mem_support_iff.mp hm
    (by simpa [MvPolynomial.coeff_homogeneousComponent] using hcoeff)

/-- Viewing `linearSubst (linearShearMatrix a) f` as a polynomial in `X₀` via `finSuccEquiv`, its
degree in `X₀` is bounded by `f.totalDegree`. -/
theorem natDegree_finSuccEquiv_linearSubst_linearShearMatrix_le {R : Type*} [CommSemiring R]
    {r : ℕ} (a : Fin r → R) (f : MvPolynomial (Fin (r + 1)) R) :
    (MvPolynomial.finSuccEquiv R r (MvPolynomial.linearSubst (linearShearMatrix a) f)).natDegree ≤
      f.totalDegree := by
  rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
  intro k hk
  by_contra hne
  have hle := MvPolynomial.totalDegree_coeff_finSuccEquiv_add_le
    (MvPolynomial.linearSubst (linearShearMatrix a) f) k hne
  have htot := totalDegree_linearSubst_le (linearShearMatrix a) f
  omega

/-- After substituting along `linearShearMatrix a`, the `f.totalDegree`-th coefficient in `X₀` is
the constant polynomial equal to the dehomogenized top homogeneous component of `f` evaluated at
`a`. -/
theorem coeff_totalDegree_finSuccEquiv_linearSubst_linearShearMatrix {R : Type*} [CommSemiring R]
    {r : ℕ} (a : Fin r → R) (f : MvPolynomial (Fin (r + 1)) R) :
    (MvPolynomial.finSuccEquiv R r
        (MvPolynomial.linearSubst (linearShearMatrix a) f)).coeff f.totalDegree =
      MvPolynomial.C (MvPolynomial.eval a
        (dehomogenize 0 (MvPolynomial.homogeneousComponent f.totalDegree f))) := by
  set D := f.totalDegree
  set q := MvPolynomial.linearSubst (linearShearMatrix a) f
  ext m
  rw [MvPolynomial.finSuccEquiv_coeff_coeff]
  by_cases hm : m = 0
  · subst hm
    have hcons : (0 : Fin r →₀ ℕ).cons D = Finsupp.single 0 D := by
      ext j; refine Fin.cases ?_ (fun _ ↦ ?_) j <;> simp
    have hdeg : (Finsupp.single (0 : Fin (r + 1)) D).degree = D := by simp
    have hhom : (MvPolynomial.linearSubst (linearShearMatrix a)
        (MvPolynomial.homogeneousComponent D f)).IsHomogeneous D :=
      (MvPolynomial.homogeneousComponent_isHomogeneous D f).linearSubst _
    have hch : (MvPolynomial.homogeneousComponent D q).coeff (Finsupp.single 0 D) =
        q.coeff (Finsupp.single 0 D) := by
      simp [MvPolynomial.coeff_homogeneousComponent, hdeg]
    rw [hcons, MvPolynomial.coeff_C, ite_eq_left_iff.mpr fun h ↦ absurd rfl h, ← hch,
      homogeneousComponent_linearSubst, hhom.coeff_single_eq_eval 0, MvPolynomial.eval_linearSubst,
      linearShearMatrix_mulVec_single_zero, ← eval_dehomogenize]
  · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h ↦ absurd h.symm hm]
    apply MvPolynomial.coeff_eq_zero_of_totalDegree_lt
    change q.totalDegree < (m.cons D).sum fun _ k ↦ k
    rw [Finsupp.sum_cons]
    have hmpos : 0 < (m.sum fun _ k ↦ k) := by
      rw [Nat.pos_iff_ne_zero]
      have hmdeg : (m.sum fun _ k ↦ k) = m.degree := by
        rw [Finsupp.degree_eq_sum, Finsupp.sum_fintype _ _ (by simp)]
      rw [hmdeg]
      simpa [Finsupp.degree_eq_zero_iff] using hm
    have htot : q.totalDegree ≤ D := totalDegree_linearSubst_le (linearShearMatrix a) f
    omega

/-- For a nonzero polynomial `f`, the dehomogenization at coordinate `0` of its top homogeneous
component is nonzero. -/
theorem dehomogenize_homogeneousComponent_totalDegree_ne_zero {R : Type*} [CommSemiring R]
    {r : ℕ} {f : MvPolynomial (Fin (r + 1)) R} (hf : f ≠ 0) :
    dehomogenize 0 (MvPolynomial.homogeneousComponent f.totalDegree f) ≠ 0 := by
  intro h0
  apply MvPolynomial.homogeneousComponent_totalDegree_ne_zero f hf
  exact dehomogenize_injOn 0 f.totalDegree
    (MvPolynomial.homogeneousComponent_isHomogeneous f.totalDegree f)
    (MvPolynomial.isHomogeneous_zero (Fin (r + 1)) R f.totalDegree)
    (by simpa using h0)

/-- Over an infinite integral domain `R`, for any nonzero polynomial `f` in `r + 1` variables there
exists a point `a : Fin r → R` at which the dehomogenized top homogeneous component of `f` takes a
nonzero value. -/
theorem exists_eval_dehomogenize_homogeneousComponent_ne_zero {R : Type*} [CommRing R] [IsDomain R]
    [Infinite R] {r : ℕ} {f : MvPolynomial (Fin (r + 1)) R} (hf : f ≠ 0) :
    ∃ a : Fin r → R,
      MvPolynomial.eval a (dehomogenize 0 (MvPolynomial.homogeneousComponent f.totalDegree f)) ≠
        0 := by
  by_contra! hall
  apply dehomogenize_homogeneousComponent_totalDegree_ne_zero hf
  exact MvPolynomial.funext fun a ↦ by simp [hall a]

end Shear

section Elimination

/-- Evaluating `finSuccEquiv R r (linearSubst (linearShearMatrix a) f)` at `x 0` with coefficients
mapped via `aeval z` (where `z i = x i.succ - a i • x 0`) recovers `aeval x f`. -/
private theorem eval₂_aeval_finSuccEquiv_linearSubst_linearShearMatrix {R A : Type*} [CommRing R]
    [CommRing A] [Algebra R A] {r : ℕ} (a : Fin r → R) (x : Fin (r + 1) → A)
    (f : MvPolynomial (Fin (r + 1)) R) :
    Polynomial.eval₂ (MvPolynomial.aeval fun i ↦ x i.succ - a i • x 0).toRingHom (x 0)
        (MvPolynomial.finSuccEquiv R r (MvPolynomial.linearSubst (linearShearMatrix a) f)) =
      MvPolynomial.aeval x f := by
  let z : Fin r → A := fun i ↦ x i.succ - a i • x 0
  let ψ : (MvPolynomial (Fin r) R)[X] →ₐ[R] A :=
    { Polynomial.eval₂RingHom (MvPolynomial.aeval z).toRingHom (x 0) with
      commutes' := fun c ↦ by simp [Polynomial.algebraMap_apply] }
  have hcomp : ψ.comp (MvPolynomial.finSuccEquiv R r).toAlgHom =
      MvPolynomial.aeval (Fin.cons (x 0) z) := by
    apply MvPolynomial.algHom_ext
    intro j
    refine Fin.cases ?_ (fun i ↦ ?_) j <;> simp [ψ, MvPolynomial.finSuccEquiv_apply]
  have hx' : (Fin.cons (x 0) fun i ↦ a i • x 0 + z i) = x := by
    ext j
    refine Fin.cases rfl (fun i ↦ ?_) j
    simp [z]
  change (ψ.comp (MvPolynomial.finSuccEquiv R r).toAlgHom)
    (MvPolynomial.linearSubst (linearShearMatrix a) f) = MvPolynomial.aeval x f
  rw [hcomp, MvPolynomial.aeval_linearSubst, map_linearShearMatrix_mulVec_cons, hx']

/-- Over any commutative ring `R`, if `MvPolynomial.aeval x f = 0` and the dehomogenized top
homogeneous component of `f` evaluates to a unit at `a : Fin r → R`, then `x 0` is integral over
the subalgebra generated by `i ↦ x i.succ - a i • x 0`. -/
theorem isIntegral_adjoin_of_isUnit_eval_dehomogenize {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] {r : ℕ} (x : Fin (r + 1) → A) {f : MvPolynomial (Fin (r + 1)) R}
    {a : Fin r → R} (hfx : MvPolynomial.aeval x f = 0)
    (hu : IsUnit
      (MvPolynomial.eval a (dehomogenize 0 (MvPolynomial.homogeneousComponent f.totalDegree f)))) :
    IsIntegral (Algebra.adjoin R (Set.range fun i : Fin r ↦ x i.succ - a i • x 0)) (x 0) := by
  let z : Fin r → A := fun i ↦ x i.succ - a i • x 0
  let B : Subalgebra R A := Algebra.adjoin R (Set.range z)
  let z' : Fin r → B := fun i ↦ ⟨z i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
  let D := f.totalDegree
  let q := MvPolynomial.finSuccEquiv R r (MvPolynomial.linearSubst (linearShearMatrix a) f)
  let Q : B[X] := q.map (MvPolynomial.aeval z').toRingHom
  let u : Bˣ := (hu.map (algebraMap R B)).unit
  refine ⟨Polynomial.C (↑u⁻¹ : B) * Q, ?_, ?_⟩
  · refine Polynomial.monic_of_natDegree_le_of_coeff_eq_one D ?_ ?_
    · exact (Polynomial.natDegree_C_mul_le _ _).trans
        (Polynomial.natDegree_map_le.trans
          (natDegree_finSuccEquiv_linearSubst_linearShearMatrix_le a f))
    · rw [Polynomial.coeff_C_mul, Polynomial.coeff_map,
        coeff_totalDegree_finSuccEquiv_linearSubst_linearShearMatrix]
      change (↑u⁻¹ : B) * MvPolynomial.aeval z' (MvPolynomial.C _) = 1
      rw [MvPolynomial.algHom_C]
      exact u.inv_mul
  · have hval : B.val.toRingHom.comp (MvPolynomial.aeval z').toRingHom =
        (MvPolynomial.aeval z : MvPolynomial (Fin r) R →ₐ[R] A).toRingHom := by
      have halg : B.val.comp (MvPolynomial.aeval z') =
          (MvPolynomial.aeval z : MvPolynomial (Fin r) R →ₐ[R] A) := by
        ext i; simp [z']
      exact congrArg AlgHom.toRingHom halg
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map,
      show (algebraMap B A).comp (MvPolynomial.aeval z').toRingHom =
        (MvPolynomial.aeval z : MvPolynomial (Fin r) R →ₐ[R] A).toRingHom from hval,
      eval₂_aeval_finSuccEquiv_linearSubst_linearShearMatrix, hfx, mul_zero]

/-- Under the hypotheses of `isIntegral_adjoin_of_isUnit_eval_dehomogenize`, if `x` generates `A`
as an `R`-algebra, then `A` is a finite module over the `R`-subalgebra generated by
`i ↦ x i.succ - a i • x 0`. -/
theorem moduleFinite_adjoin_of_isUnit_eval_dehomogenize {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] {r : ℕ} {x : Fin (r + 1) → A} {f : MvPolynomial (Fin (r + 1)) R}
    {a : Fin r → R} (hx : Algebra.adjoin R (Set.range x) = ⊤) (hfx : MvPolynomial.aeval x f = 0)
    (hu : IsUnit
      (MvPolynomial.eval a (dehomogenize 0 (MvPolynomial.homogeneousComponent f.totalDegree f)))) :
    Module.Finite (Algebra.adjoin R (Set.range fun i : Fin r ↦ x i.succ - a i • x 0)) A := by
  let z : Fin r → A := fun i ↦ x i.succ - a i • x 0
  let B : Subalgebra R A := Algebra.adjoin R (Set.range z)
  have hint : IsIntegral B (x 0) := isIntegral_adjoin_of_isUnit_eval_dehomogenize x hfx hu
  have hadj : Algebra.adjoin B ({x 0} : Set A) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    have htop : Algebra.adjoin R (Set.range x) ≤
        (Algebra.adjoin B ({x 0} : Set A)).restrictScalars R := by
      rw [Algebra.adjoin_le_iff, Set.range_subset_iff]
      intro j
      refine Fin.cases ?_ (fun i ↦ ?_) j
      · exact Algebra.subset_adjoin (Set.mem_singleton (x 0))
      · change x i.succ ∈ Algebra.adjoin B ({x 0} : Set A)
        have hz : z i ∈ Algebra.adjoin B ({x 0} : Set A) :=
          Subalgebra.algebraMap_mem _ (⟨z i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : B)
        have hx0 : a i • x 0 ∈ Algebra.adjoin B ({x 0} : Set A) := by
          rw [Algebra.smul_def]
          exact mul_mem
            (Subalgebra.algebraMap_mem _ (algebraMap R B (a i)))
            (Algebra.subset_adjoin (Set.mem_singleton (x 0)))
        simpa [z] using add_mem hz hx0
    exact htop (hx ▸ Algebra.mem_top)
  refine Module.Finite.of_fg_top ?_
  rw [← Algebra.top_toSubmodule (R := B) (A := A), ← hadj]
  exact hint.fg_adjoin_singleton

end Elimination

section Normalization

/-- The `r × (r + 1)` matrix sending a vector `x` to `i ↦ x i.succ - a i • x 0`. -/
private def elimMatrix {R : Type*} [Neg R] [Zero R] [One R] {r : ℕ} (a : Fin r → R) :
    Matrix (Fin r) (Fin (r + 1)) R :=
  Matrix.of fun i ↦ Fin.cons (-a i) (Pi.single i 1)

private theorem sum_elimMatrix_smul {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] {r : ℕ}
    (a : Fin r → R) (x : Fin (r + 1) → A) (i : Fin r) :
    ∑ j, elimMatrix a i j • x j = x i.succ - a i • x 0 := by
  rw [Fin.sum_univ_succ]
  simp [elimMatrix, Pi.single_apply, sub_eq_add_neg, add_comm]

private theorem sum_mul_elimMatrix_smul {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    {d r : ℕ} (C₀ : Matrix (Fin d) (Fin r) R) (a : Fin r → R) (x : Fin (r + 1) → A) (i : Fin d) :
    ∑ j, (C₀ * elimMatrix a) i j • x j =
      ∑ l, C₀ i l • (x l.succ - a l • x 0) := by
  simp only [Matrix.mul_apply, Finset.sum_smul, mul_smul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [← Finset.smul_sum, sum_elimMatrix_smul]

/-- When the given generators `x : Fin n → A` are already algebraically independent over `R`, the
identity matrix `1` linearly normalizes `A` over `R`. -/
private theorem normalization_of_algebraicIndependent {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] {n : ℕ} {x : Fin n → A} (hx : Algebra.adjoin R (Set.range x) = ⊤)
    (hind : AlgebraicIndependent R x) :
    let y : Fin n → A := fun i ↦ ∑ j, (1 : Matrix (Fin n) (Fin n) R) i j • x j
    AlgebraicIndependent R y ∧ (MvPolynomial.aeval y : MvPolynomial (Fin n) R →ₐ[R] A).Finite := by
  have hy : (fun i ↦ ∑ j, (1 : Matrix (Fin n) (Fin n) R) i j • x j) = x := by
    ext i; simp [Matrix.one_apply]
  refine ⟨hy.symm ▸ hind, ?_⟩
  rw [hy]
  apply RingHom.Finite.of_surjective
  change Function.Surjective (MvPolynomial.aeval x : MvPolynomial (Fin n) R →ₐ[R] A)
  rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
  exact hx

/-- Inductive core of linear Noether normalization over an infinite field. -/
private theorem exists_linear_normalization_aux {k : Type*} [Field k] [Infinite k] :
    ∀ {n : ℕ} {A : Type*} [CommRing A] [Nontrivial A] [Algebra k A] (x : Fin n → A),
      Algebra.adjoin k (Set.range x) = ⊤ →
      ∃ (d : ℕ) (_ : d ≤ n) (C : Matrix (Fin d) (Fin n) k),
        let y : Fin d → A := fun i ↦ ∑ j, C i j • x j
        AlgebraicIndependent k y ∧ (MvPolynomial.aeval y : MvPolynomial (Fin d) k →ₐ[k] A).Finite
  | 0, A, _, _, _, x, hx =>
    ⟨0, le_rfl, 1, normalization_of_algebraicIndependent hx
      (algebraicIndependent_empty_type_iff.mpr (algebraMap k A).injective)⟩
  | r + 1, A, _, _, _, x, hx => by
    classical
    by_cases hind : AlgebraicIndependent k x
    · exact ⟨r + 1, le_rfl, 1, normalization_of_algebraicIndependent hx hind⟩
    · obtain ⟨f, hf0, hfx⟩ : ∃ f : MvPolynomial (Fin (r + 1)) k,
          f ≠ 0 ∧ MvPolynomial.aeval x f = 0 := by
        unfold AlgebraicIndependent at hind
        rw [injective_iff_map_eq_zero] at hind
        push Not at hind
        obtain ⟨f, hfx, hf0⟩ := hind
        exact ⟨f, hf0, hfx⟩
      obtain ⟨a, ha⟩ := exists_eval_dehomogenize_homogeneousComponent_ne_zero hf0
      let z : Fin r → A := fun i ↦ x i.succ - a i • x 0
      let B : Subalgebra k A := Algebra.adjoin k (Set.range z)
      have : Module.Finite B A :=
        moduleFinite_adjoin_of_isUnit_eval_dehomogenize hx hfx ha.isUnit
      let z' : Fin r → B := fun i ↦ ⟨z i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
      have hz' : Algebra.adjoin k (Set.range z') = ⊤ := by
        apply Subalgebra.map_injective (f := B.val) Subtype.val_injective
        rw [AlgHom.map_adjoin, Algebra.map_top, B.range_val, ← Set.range_comp]
        rfl
      obtain ⟨d, hdn, C₀, hw_ind, hw_fin⟩ := exists_linear_normalization_aux z' hz'
      let w : Fin d → B := fun i ↦ ∑ l, C₀ i l • z' l
      have hyw : (fun i ↦ ∑ j, (C₀ * elimMatrix a) i j • x j) = B.val ∘ w := by
        ext i; simpa [w] using sum_mul_elimMatrix_smul C₀ a x i
      have hcomp :
          (MvPolynomial.aeval (B.val ∘ w) : MvPolynomial (Fin d) k →ₐ[k] A) =
            B.val.comp (MvPolynomial.aeval w) := by
        ext i; simp
      refine ⟨d, Nat.le_succ_of_le hdn, C₀ * elimMatrix a, ?_, ?_⟩
      · unfold AlgebraicIndependent
        rw [hyw, hcomp]
        exact Subtype.val_injective.comp hw_ind
      · change (MvPolynomial.aeval fun i ↦ ∑ j, (C₀ * elimMatrix a) i j • x j :
          MvPolynomial (Fin d) k →ₐ[k] A).toRingHom.Finite
        rw [hyw, congrArg AlgHom.toRingHom hcomp]
        exact RingHom.Finite.comp (RingHom.finite_algebraMap.mpr inferInstance) hw_fin

/-- **Linear Noether normalization in prescribed generators.** Over an infinite field `k`, any
nontrivial `k`-algebra `A` generated by `x₁, …, xₙ` admits `d ≤ n` algebraically independent
`k`-linear combinations `yᵢ = ∑ⱼ Cᵢⱼ • xⱼ` over which `A` is a finite module, with
`ringKrullDim A = d`. -/
theorem exists_linear_normalization {k A : Type*} [Field k] [Infinite k]
    [CommRing A] [Nontrivial A] [Algebra k A] {n : ℕ} (x : Fin n → A)
    (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    ∃ (d : ℕ) (_ : d ≤ n) (C : Matrix (Fin d) (Fin n) k),
      let y : Fin d → A := fun i ↦ ∑ j, C i j • x j
      AlgebraicIndependent k y ∧
        (MvPolynomial.aeval y : MvPolynomial (Fin d) k →ₐ[k] A).Finite ∧
        ringKrullDim A = (d : WithBot ℕ∞) := by
  obtain ⟨d, hdn, C, hy, hfin⟩ := exists_linear_normalization_aux x hx
  refine ⟨d, hdn, C, hy, hfin, ?_⟩
  simpa using ringKrullDim_eq_of_injective_of_isIntegral_mvPolynomial
    (MvPolynomial.aeval fun i ↦ ∑ j, C i j • x j : MvPolynomial (Fin d) k →ₐ[k] A).toRingHom
    hy hfin.to_isIntegral

/-- Over any nontrivial commutative ring `R`, if `ι`-many `R`-linear combinations of a `σ`-indexed
family `x` in an `R`-algebra are algebraically independent over `R`, then `card ι ≤ card σ`. -/
theorem card_le_of_algebraicIndependent_sum_smul {R A ι σ : Type*} [CommRing R] [Nontrivial R]
    [CommRing A] [Algebra R A] [Fintype ι] [Fintype σ] {x : σ → A} {C : Matrix ι σ R}
    (hy : AlgebraicIndependent R (fun i ↦ ∑ j, C i j • x j)) :
    Fintype.card ι ≤ Fintype.card σ := by
  simpa [Module.finrank_fintype_fun_eq_card] using
    hy.linearIndependent_of_sum_smul.fintype_card_le_finrank

/-- In `S ⊗[R] A`, forming linear combinations of `j ↦ 1 ⊗ₜ[R] x j` with the scalar-extended matrix
`C.map (algebraMap R S)` agrees with `1 ⊗ₜ[R] (∑ j, C i j • x j)`. -/
theorem sum_map_smul_one_tmul {R S A ι σ : Type*} [CommSemiring R] [CommSemiring S] [Algebra R S]
    [CommSemiring A] [Algebra R A] [Fintype σ] (C : Matrix ι σ R) (x : σ → A) (i : ι) :
    ∑ j, C.map (algebraMap R S) i j • (1 ⊗ₜ[R] x j : S ⊗[R] A) =
      1 ⊗ₜ[R] ∑ j, C i j • x j := by
  rw [TensorProduct.tmul_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [Matrix.map_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one,
    ← mul_one (algebraMap R S (C i j)), ← Algebra.smul_def, TensorProduct.smul_tmul]

/-- Flat base change `R → S` preserves algebraic independence of linear combinations
`i ↦ ∑ j, C i j • x j`. -/
theorem algebraicIndependent_sum_map_smul_one_tmul {R A ι σ : Type*} (S : Type*) [CommRing R]
    [CommRing S] [Algebra R S] [Module.Flat R S] [CommRing A] [Algebra R A] [Fintype σ]
    {x : σ → A} {C : Matrix ι σ R}
    (hy : AlgebraicIndependent R (fun i ↦ ∑ j, C i j • x j)) :
    AlgebraicIndependent S
      (fun i ↦ ∑ j, C.map (algebraMap R S) i j • (1 ⊗ₜ[R] x j : S ⊗[R] A)) := by
  simpa only [sum_map_smul_one_tmul] using hy.one_tmul S

/-- Faithfully flat base change `R → S` preserves and reflects algebraic independence of linear
combinations `i ↦ ∑ j, C i j • x j`. -/
theorem algebraicIndependent_sum_map_smul_one_tmul_iff {R S A ι σ : Type*} [CommRing R]
    [CommRing S] [Algebra R S] [Module.FaithfullyFlat R S] [CommRing A] [Algebra R A] [Fintype σ]
    {x : σ → A} {C : Matrix ι σ R} :
    AlgebraicIndependent S
        (fun i ↦ ∑ j, C.map (algebraMap R S) i j • (1 ⊗ₜ[R] x j : S ⊗[R] A)) ↔
      AlgebraicIndependent R (fun i ↦ ∑ j, C i j • x j) := by
  simpa only [sum_map_smul_one_tmul] using
    (algebraicIndependent_one_tmul_iff (R := R) (S := S) (y := fun i ↦ ∑ j, C i j • x j))

/-- Arbitrary base change `R → S` preserves finiteness of the evaluation map on linear combinations
`i ↦ ∑ j, C i j • x j`. -/
theorem aeval_sum_map_smul_one_tmul_finite {R S A ι σ : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [CommRing A] [Algebra R A] [Fintype σ] {x : σ → A} {C : Matrix ι σ R}
    (hfin : (MvPolynomial.aeval fun i ↦ ∑ j, C i j • x j : MvPolynomial ι R →ₐ[R] A).Finite) :
    (MvPolynomial.aeval
      (fun i ↦ ∑ j, C.map (algebraMap R S) i j • (1 ⊗ₜ[R] x j : S ⊗[R] A)) :
        MvPolynomial ι S →ₐ[S] S ⊗[R] A).Finite := by
  simpa only [sum_map_smul_one_tmul] using aeval_one_tmul_finite (S := S) hfin

end Normalization

