/-!
# Flatness and tensor products

Mathlib's `TensorProduct.map_injective_of_flat_flat` shows that the tensor product of two
injective linear maps is injective when the codomain of the first and the domain of the second
are flat. This file records the same statement for `Algebra.TensorProduct.map` of algebra
homomorphisms, so that it applies without first passing to the underlying linear maps.
It also identifies the kernel after tensoring an algebra map with a flat algebra, the analogue
of Mathlib's `Algebra.TensorProduct.lTensor_ker` with flatness in place of surjectivity.
For two algebra maps, flatness of the first codomain and the second kernel quotient similarly
identifies the tensor-product kernel with the ideal generated by the two kernels.

Finally, if `R → B` is a map of commutative semirings, `A` is a flat `B`-module, and `M` is a
`B`-module that is flat over `R`, then `A ⊗[B] M` is flat over `R`. A localization `B_q ⊗[B] M`
of an `R`-flat module over a ring is the typical case. Over semirings, flatness here means
mono-flatness, as in Mathlib's `Module.Flat`. In particular, for an ideal `J` of `B` with
`B ⧸ J` flat over `R`, `C ⧸ J C` is flat over `R` for every flat `B`-algebra `C`.

Two injectivity statements for tensoring with a module `M` over a ring are the diagram-chasing
steps of the local criterion for flatness. If `f.rTensor M` is injective and `F` is flat, then so
is `(f.rTensor F).rTensor M`. If `M ⧸ I M` is flat over `R ⧸ I`, then tensoring with `M` preserves
injectivity of maps between modules killed by `I`. If moreover `I ⊗[R] M → M` is injective, that
is `Tor₁ᴿ(R ⧸ I, M) = 0`, then `N ⊗[R] M → L ⊗[R] M` is injective whenever `L ⧸ N` is killed by a
power of `I`. Cover `L` by a free module `F` and let `G` be the preimage of `N`; for `G ⊇ I F`,
`I F ⊗ M → F ⊗ M` is injective because `F` is flat, and two diagram chases replace the long exact
`Tor` sequences of the textbook argument. Applied to `J ⧸ (J ⊓ Iⁿ)` inside `R ⧸ Iⁿ`, this shows
that the kernel of `J ⊗[R] M → M` comes from `(J ⊓ Iⁿ) ⊗[R] M`, the step of the local criterion
for flatness before the Artin–Rees lemma. For any ideal `P` in place of `Iⁿ`, the same conclusion
holds without the `Tor₁` hypothesis when `M ⧸ P M` is flat over `R ⧸ P`, since `J ⧸ (J ⊓ P)` and
`R ⧸ P` are both killed by `P`.

## Main results

* `Algebra.TensorProduct.map_injective_of_flat_flat`: the tensor product of two injective algebra
  homomorphisms is injective under the flatness hypotheses of
  `TensorProduct.map_injective_of_flat_flat`.
* `Algebra.TensorProduct.lTensor_ker_of_flat`: tensoring with a flat algebra carries kernels
  to their images under the right tensor inclusion.
* `Algebra.TensorProduct.map_ker_of_flat_flat`: the kernel of a tensor product of algebra maps
  is generated by their kernels when the first codomain and the second kernel quotient are flat.
* `Module.Flat.tensorProduct_of_flat`: if `A` is flat over `B` and `M` is flat over `R`, then
  `A ⊗[B] M` is flat over `R`.
* `Module.Flat.rTensor_rTensor_injective`: tensoring with a flat module preserves injectivity of
  `f.rTensor M`.
* `Ideal.rTensor_injective_of_isTorsionBySet`: if `M ⧸ I M` is flat over `R ⧸ I`, tensoring
  with `M` preserves injectivity of maps between modules killed by `I`.
* `Ideal.subtype_rTensor_injective_of_pow_smul_top_le`: if moreover `Tor₁ᴿ(R ⧸ I, M) = 0`, then
  `N ⊗[R] M → L ⊗[R] M` is injective whenever `I ^ n` kills `L ⧸ N`;
  `Ideal.subtype_rTensor_injective_of_smul_top_le` is the case `n = 1`.
* `Ideal.mem_range_rTensor_inclusion_inf_pow`: under the same hypotheses, the kernel of
  `J ⊗[R] M → M` comes from `(J ⊓ I ^ n) ⊗[R] M`.
* `Ideal.mem_range_rTensor_inclusion_inf_of_flat`: for an ideal `P` with `M ⧸ P M` flat over
  `R ⧸ P`, the kernel of `J ⊗[R] M → M` comes from `(J ⊓ P) ⊗[R] M`.
-/

public section

open scoped TensorProduct

namespace Algebra.TensorProduct

section Semiring

variable {R S A B C D : Type*} [CommSemiring R] [CommSemiring S] [Algebra R S]
variable [Semiring A] [Semiring B] [Semiring C] [Semiring D]
variable [Algebra R A] [Algebra R B] [Algebra R C] [Algebra R D]
variable [Algebra S A] [Algebra S B] [IsScalarTower R S A] [IsScalarTower R S B]

/-- The tensor product of two injective algebra homomorphisms is injective when the codomain of
the first and the domain of the second are flat. -/
theorem map_injective_of_flat_flat (f : A →ₐ[S] B) (g : C →ₐ[R] D)
    [Module.Flat R B] [Module.Flat R C]
    (hf : Function.Injective f) (hg : Function.Injective g) :
    Function.Injective (map f g) :=
  -- `map f g` is `TensorProduct.map` of the underlying `R`-linear maps by definition.
  _root_.TensorProduct.map_injective_of_flat_flat (f.toLinearMap.restrictScalars R)
    g.toLinearMap hf hg

end Semiring

section Ring

variable {R A B C : Type*} [CommRing R] [Ring A] [Ring B] [Ring C]
variable [Algebra R A] [Algebra R B] [Algebra R C]

/-- Tensoring an algebra map with a flat algebra carries its kernel to the ideal generated
by its image under the right tensor inclusion. -/
theorem lTensor_ker_of_flat [Module.Flat R A] (f : B →ₐ[R] C) :
    RingHom.ker (map (AlgHom.id R A) f) =
      (RingHom.ker f).map (includeRight : B →ₐ[R] A ⊗[R] B) := by
  rw [← Submodule.restrictScalars_inj R, Ideal.map_includeRight_eq]
  -- Restricted to `R`, `RingHom.ker` of `map (AlgHom.id R A) f` and of `f` are by definition the
  -- `LinearMap.ker` of `LinearMap.lTensor A f.toLinearMap` and of `f.toLinearMap`.
  exact (Module.Flat.lTensor_exact A f.toLinearMap.exact_subtype_ker_map).linearMap_ker_eq

variable {S D : Type*} [CommRing S] [Algebra R S] [Ring D] [Algebra R D]
variable [Algebra S A] [Algebra S B] [IsScalarTower R S A] [IsScalarTower R S B]

/-- The kernel of a tensor product of algebra maps is generated by their kernels when the
first codomain and the quotient of the second domain by its kernel are flat. -/
theorem map_ker_of_flat_flat (f : A →ₐ[S] B) (g : C →ₐ[R] D)
    [Module.Flat R B] [Module.Flat R (C ⧸ RingHom.ker g)] :
    RingHom.ker (map f g) =
      (RingHom.ker f).map (includeLeft : A →ₐ[R] A ⊗[R] C) ⊔
        (RingHom.ker g).map (includeRight : C →ₐ[R] A ⊗[R] C) := by
  let qf := Ideal.Quotient.mkₐ S (RingHom.ker f)
  let qg := Ideal.Quotient.mkₐ R (RingHom.ker g)
  have hf : (Ideal.kerLiftAlg f).comp qf = f := by
    ext a
    exact Ideal.kerLiftAlg_mk f a
  have hg : (Ideal.kerLiftAlg g).comp qg = g := by
    ext c
    exact Ideal.kerLiftAlg_mk g c
  have hinj : Function.Injective (map (Ideal.kerLiftAlg f) (Ideal.kerLiftAlg g)).toRingHom :=
    map_injective_of_flat_flat _ _ (Ideal.kerLiftAlg_injective f) (Ideal.kerLiftAlg_injective g)
  have hmap : map f g = (map (Ideal.kerLiftAlg f) (Ideal.kerLiftAlg g)).comp (map qf qg) := by
    rw [← map_comp, hf, hg]
  have hker : RingHom.ker (map f g) = RingHom.ker (map qf qg) := by
    rw [hmap, AlgHom.ker_coe, AlgHom.comp_toRingHom]
    exact RingHom.ker_comp_of_injective _ hinj
  have hkf : RingHom.ker qf = RingHom.ker f := Ideal.Quotient.mkₐ_ker (R₁ := S) _
  have hkg : RingHom.ker qg = RingHom.ker g := Ideal.Quotient.mkₐ_ker (R₁ := R) _
  rw [hker]
  simpa only [hkf, hkg] using
    map_ker qf qg (Ideal.Quotient.mkₐ_surjective S _) (Ideal.Quotient.mkₐ_surjective R _)

end Ring

end Algebra.TensorProduct

namespace Module

open TensorProduct

variable {R B M : Type*} [CommSemiring R] [CommSemiring B] [Algebra R B]
  [AddCommMonoid M] [Module R M] [Module B M] [IsScalarTower R B M]

/-- If `A` is a flat `B`-module and `M` is a `B`-module which is flat over `R`, then `A ⊗[B] M`
is flat over `R`. This holds for commutative semirings, with `Module.Flat` meaning mono-flatness.
Compare Mathlib's instance for `Module.Flat S (M ⊗[R] N)`, where the semiring `S`
acting on the left factor is an algebra over the base `R` of the tensor product rather than below
it. -/
theorem Flat.tensorProduct_of_flat (A : Type*) [AddCommMonoid A] [Module R A] [Module B A]
    [IsScalarTower R B A] [Flat B A] [Flat R M] : Flat R (A ⊗[B] M) := by
  rw [Flat.iff_lTensor_injectiveₛ]
  intro P _ _ N
  -- Through `(A ⊗[B] M) ⊗[R] N ≃ A ⊗[B] (M ⊗[R] N)`, the map is `A ⊗[B] (M ⊗[R] N ↪ M ⊗[R] P)`.
  have h : N.subtype.lTensor (A ⊗[B] M) =
      ((AlgebraTensorModule.assoc R B B A M P).symm.restrictScalars R).toLinearMap ∘ₗ
        ((AlgebraTensorModule.lTensor B M N.subtype).lTensor A).restrictScalars R ∘ₗ
        ((AlgebraTensorModule.assoc R B B A M N).restrictScalars R).toLinearMap := by
    refine TensorProduct.ext' fun x n ↦ ?_
    induction x with
    | tmul a m => simp
    | add x y hx hy => simp only [add_tmul, map_add, hx, hy]
  rw [h]
  simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, LinearMap.coe_restrictScalars,
    EquivLike.comp_injective, EquivLike.injective_comp]
  apply Flat.lTensor_preserves_injective_linearMap
  rw [AlgebraTensorModule.coe_lTensor]
  exact Flat.lTensor_preserves_injective_linearMap _ N.injective_subtype

/-- If `C` is a flat `B`-algebra and `J` is an ideal of `B` with `B ⧸ J` flat over `R`, then
`C ⧸ J C ≃ C ⊗[B] (B ⧸ J)` is flat over `R`. A localization `B_q ⧸ J B_q` is the typical
case. -/
theorem Flat.quotient_map_algebraMap {R B : Type*} [CommRing R] [CommRing B] [Algebra R B]
    (C : Type*) [CommRing C] [Algebra B C] [Algebra R C] [IsScalarTower R B C] [Flat B C]
    (J : Ideal B) [Flat R (B ⧸ J)] : Flat R (C ⧸ J.map (algebraMap B C)) := by
  have := Flat.tensorProduct_of_flat (R := R) (B := B) (M := B ⧸ J) C
  exact Flat.of_linearEquiv
    ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot C J).toLinearEquiv.restrictScalars R)

end Module

namespace Module

open TensorProduct LinearMap

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- If `f.rTensor M` is injective and `F` is flat, then `(f.rTensor F).rTensor M` is injective. -/
theorem Flat.rTensor_rTensor_injective {N P : Type*} [AddCommGroup N] [Module R N]
    [AddCommGroup P] [Module R P] (F : Type*) [AddCommGroup F] [Module R F] [Flat R F]
    {f : N →ₗ[R] P} (hf : Function.Injective (f.rTensor M)) :
    Function.Injective ((f.rTensor F).rTensor M) := by
  have h : (rightComm R P F M).toLinearMap ∘ₗ (f.rTensor F).rTensor M =
      ((f.rTensor M).rTensor F) ∘ₗ (rightComm R N F M).toLinearMap := by
    ext; simp
  have hY : Function.Injective ((f.rTensor M).rTensor F ∘ₗ (rightComm R N F M).toLinearMap) :=
    (Flat.rTensor_preserves_injective_linearMap _ hf).comp (rightComm R N F M).injective
  rw [← h, coe_comp] at hY
  exact hY.of_comp

end Module

namespace Ideal

open TensorProduct LinearMap

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- If `M ⧸ I M` is flat over `R ⧸ I`, tensoring with `M` preserves injectivity of maps between
modules killed by `I`. -/
theorem rTensor_injective_of_isTorsionBySet (I : Ideal R)
    [Module.Flat (R ⧸ I) (M ⧸ I • (⊤ : Submodule R M))] {K L : Type*} [AddCommGroup K]
    [Module R K] [AddCommGroup L] [Module R L] (hK : Module.IsTorsionBySet R K I)
    (hL : Module.IsTorsionBySet R L I) {f : K →ₗ[R] L} (hf : Function.Injective f) :
    Function.Injective (f.rTensor M) := by
  let _ := hK.module
  let _ := hL.module
  let A := R ⧸ I
  have hA : Function.Surjective (algebraMap R A) := Ideal.Quotient.mk_surjective
  let g : K →ₗ[A] L := f.extendScalarsOfSurjective hA
  have : Module.Flat A (A ⊗[R] M) := .of_linearEquiv
    ((quotTensorEquivQuotSMul M I).extendScalarsOfSurjective hA)
  let eK := AlgebraTensorModule.cancelBaseChange R A A K M
  let eL := AlgebraTensorModule.cancelBaseChange R A A L M
  have key (y : K ⊗[A] (A ⊗[R] M)) : f.rTensor M (eK y) = eL (g.rTensor _ y) := by
    induction y using TensorProduct.inductionOn with
    | add y z hy hz => simp only [map_add, hy, hz]
    | tmul k t =>
      induction t using TensorProduct.inductionOn with
      | add s t hs ht => simp only [tmul_add, map_add, hs, ht]
      | tmul a m =>
        simp only [eK, eL, AlgebraTensorModule.cancelBaseChange_tmul, rTensor_tmul]
        rw [← map_smul g]
        exact congrArg (· ⊗ₜ[R] m) (extendScalarsOfSurjective_apply hA f (a • k)).symm
  intro x y hxy
  obtain ⟨x, rfl⟩ := eK.surjective x
  obtain ⟨y, rfl⟩ := eK.surjective y
  rw [key, key, eL.injective.eq_iff] at hxy
  rw [Module.Flat.rTensor_preserves_injective_linearMap g hf hxy]

section

variable (I : Ideal R) [Module.Flat (R ⧸ I) (M ⧸ I • (⊤ : Submodule R M))]

/-- For a flat module `F`, a submodule `G ⊇ I F` has `G ⊗[R] M → F ⊗[R] M` injective. -/
private theorem subtype_rTensor_injective_of_flat
    (hI : Function.Injective (I.subtype.rTensor M))
    {F : Type*} [AddCommGroup F] [Module R F] [Module.Flat R F] {G : Submodule R F}
    (hIG : I • ⊤ ≤ G) : Function.Injective (G.subtype.rTensor M) := by
  -- The image of `I ⊗ F` in `F` is `I F ⊆ G`, and `G ⧸ I F` is a submodule of `F ⧸ I F`, a module
  -- killed by `I`.
  let φ : I ⊗[R] F →ₗ[R] F := (TensorProduct.lid R F).toLinearMap ∘ₗ I.subtype.rTensor F
  have hφ : range φ = I • ⊤ := I.subtype_rTensor_range F
  let μ : I ⊗[R] F →ₗ[R] G := φ.codRestrict G fun x ↦ hIG (hφ ▸ mem_range_self φ x)
  let K : Submodule R (F ⧸ (I • ⊤ : Submodule R F)) := G.map (I • ⊤ : Submodule R F).mkQ
  obtain ⟨q, hq, hμq, hqK⟩ := G.exists_exact_codRestrict_mkQ (I • ⊤) (f := μ) fun g ↦ by
    rw [← hφ]
    exact ⟨fun ⟨u, hu⟩ ↦ ⟨u, congr_arg Subtype.val hu⟩, fun ⟨u, hu⟩ ↦ ⟨u, Subtype.ext hu⟩⟩
  have hK : Module.IsTorsionBySet R K I := fun x i ↦
    Subtype.ext (Module.isTorsionBySet_quotient_ideal_smul F I (x := x.1) (a := i))
  have hKinj := I.rTensor_injective_of_isTorsionBySet (M := M) hK
    (Module.isTorsionBySet_quotient_ideal_smul F I) K.injective_subtype
  refine (injective_iff_map_eq_zero _).mpr fun t ht ↦ ?_
  have hqt : q.rTensor M t = 0 := hKinj <| by
    rw [← rTensor_comp_apply, map_zero, hqK, rTensor_comp_apply, ht, map_zero]
  obtain ⟨u, rfl⟩ := (rTensor_exact M hμq hq t).mp hqt
  have hu : φ.rTensor M u = 0 := by
    rw [← ht, ← rTensor_comp_apply, subtype_comp_codRestrict]
  have hφinj : Function.Injective (φ.rTensor M) := by
    rw [rTensor_comp, coe_comp]
    exact (LinearEquiv.rTensor M (TensorProduct.lid R F)).injective.comp
      (Module.Flat.rTensor_rTensor_injective F hI)
  rw [hφinj (hu.trans (map_zero _).symm), map_zero]

/-- If `L ⧸ N` is killed by `I`, then `N ⊗[R] M → L ⊗[R] M` is injective; the proof chases along
a flat module `F` mapping onto `L`. -/
private theorem subtype_rTensor_injective_of_surjective
    (hI : Function.Injective (I.subtype.rTensor M))
    {F L : Type*} [AddCommGroup F] [Module R F] [Module.Flat R F] [AddCommGroup L] [Module R L]
    {π : F →ₗ[R] L} (hπ : Function.Surjective π) {N : Submodule R L} (hN : I • ⊤ ≤ N) :
    Function.Injective (N.subtype.rTensor M) := by
  have hIG : I • ⊤ ≤ N.comap π := Submodule.map_le_iff_le_comap.mp <| by
    rw [Submodule.map_smul'']
    exact (Submodule.smul_mono le_rfl le_top).trans hN
  have hG := subtype_rTensor_injective_of_flat I hI hIG
  -- A diagram chase along `π`.
  let π' : N.comap π →ₗ[R] N := π.restrict fun _ hx ↦ hx
  have hπ' : Function.Surjective π' := fun n ↦
    let ⟨x, hx⟩ := hπ n
    ⟨⟨x, Submodule.mem_comap.mpr (hx ▸ n.2)⟩, Subtype.ext hx⟩
  have hsq : π ∘ₗ (N.comap π).subtype = N.subtype ∘ₗ π' := (subtype_comp_restrict _).symm
  refine (injective_iff_map_eq_zero _).mpr fun t ht ↦ ?_
  obtain ⟨s, rfl⟩ := rTensor_surjective M hπ' t
  have hs : π.rTensor M ((N.comap π).subtype.rTensor M s) = 0 := by
    rw [← rTensor_comp_apply, hsq, rTensor_comp_apply, ht]
  obtain ⟨u, hu⟩ := (rTensor_exact M (exact_subtype_ker_map π) hπ _).mp hs
  have hker : ker π ≤ N.comap π := fun x hx ↦
    Submodule.mem_comap.mpr (mem_ker.mp hx ▸ N.zero_mem)
  have hsu : s = (Submodule.inclusion hker).rTensor M u := hG <| by
    rw [← hu, ← rTensor_comp_apply, Submodule.subtype_comp_inclusion]
  rw [hsu, ← rTensor_comp_apply]
  have : π' ∘ₗ Submodule.inclusion hker = 0 := by
    ext x
    exact mem_ker.mp x.2
  rw [this, rTensor_zero, LinearMap.zero_apply]

/-- Let `M ⧸ I M` be flat over `R ⧸ I` and `I ⊗[R] M → M` injective. If `L ⧸ N` is killed by `I`,
then `N ⊗[R] M → L ⊗[R] M` is injective. -/
theorem subtype_rTensor_injective_of_smul_top_le
    (hI : Function.Injective (I.subtype.rTensor M))
    {L : Type*} [AddCommGroup L] [Module R L] {N : Submodule R L} (hN : I • ⊤ ≤ N) :
    Function.Injective (N.subtype.rTensor M) :=
  subtype_rTensor_injective_of_surjective I hI (π := Finsupp.linearCombination R id)
    (fun l ↦ ⟨Finsupp.single l 1, by simp⟩) hN

/-- Let `M ⧸ I M` be flat over `R ⧸ I` and `I ⊗[R] M → M` injective. If `L ⧸ N` is killed by
`I ^ n`, then `N ⊗[R] M → L ⊗[R] M` is injective. -/
theorem subtype_rTensor_injective_of_pow_smul_top_le
    (hI : Function.Injective (I.subtype.rTensor M))
    (n : ℕ) {L : Type*} [AddCommGroup L] [Module R L] {N : Submodule R L} (hN : I ^ n • ⊤ ≤ N) :
    Function.Injective (N.subtype.rTensor M) := by
  induction n generalizing N with
  | zero =>
    refine I.subtype_rTensor_injective_of_smul_top_le hI (le_trans ?_ hN)
    rw [pow_zero, Ideal.one_eq_top]
    exact Submodule.smul_mono_left le_top
  | succ n ih =>
    -- `N ⊆ N' = N + Iⁿ L ⊆ L`, where `I` kills `N' ⧸ N` and `Iⁿ` kills `L ⧸ N'`.
    set N' := N ⊔ I ^ n • ⊤
    have hle : N ≤ N' := le_sup_left
    have hN₀ : I • ⊤ ≤ N.comap N'.subtype := Submodule.smul_le.mpr fun i hi x _ ↦ by
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp x.2
      have hiz : i • z ∈ I ^ (n + 1) • (⊤ : Submodule R L) := by
        rw [pow_succ', Submodule.mul_smul]
        exact Submodule.smul_mem_smul hi hz
      simpa [← hyz] using N.add_mem (N.smul_mem i hy) (hN hiz)
    have h₀ := I.subtype_rTensor_injective_of_smul_top_le hI hN₀
    have hsub : N.subtype = N'.subtype ∘ₗ (N.comap N'.subtype).subtype ∘ₗ
        (Submodule.comapSubtypeEquivOfLe hle).symm.toLinearMap := by
      ext; simp
    rw [hsub, rTensor_comp, rTensor_comp, coe_comp, coe_comp]
    exact (ih le_sup_right).comp (h₀.comp (LinearEquiv.rTensor M _).injective)

/-- For ideals `J` and `P`, if `(J ⧸ (J ⊓ P)) ⊗[R] M → (R ⧸ P) ⊗[R] M` is injective, then every
element of the kernel of `J ⊗[R] M → M` comes from `(J ⊓ P) ⊗[R] M`. -/
private theorem mem_range_rTensor_inclusion_inf_of_injective {J P : Ideal R}
    (hN : Function.Injective ((Submodule.map P.mkQ J).subtype.rTensor M)) {t : J ⊗[R] M}
    (ht : J.subtype.rTensor M t = 0) :
    t ∈ range ((Submodule.inclusion (inf_le_left : J ⊓ P ≤ J)).rTensor M) := by
  obtain ⟨q, hq, hexact, hqN⟩ := Submodule.exists_exact_codRestrict_mkQ J P
    (f := Submodule.inclusion (inf_le_left : J ⊓ P ≤ J)) fun j ↦ by
      simp [Submodule.range_inclusion]
  refine (rTensor_exact M hexact hq t).mp (hN ?_)
  rw [← rTensor_comp_apply, map_zero, hqN, rTensor_comp_apply, ht, map_zero]

/-- Let `M ⧸ I M` be flat over `R ⧸ I` and `I ⊗[R] M → M` injective. For an ideal `J`, every
element of the kernel of `J ⊗[R] M → M` comes from `(J ⊓ I ^ n) ⊗[R] M`. -/
theorem mem_range_rTensor_inclusion_inf_pow (hI : Function.Injective (I.subtype.rTensor M))
    (n : ℕ) {J : Ideal R} {t : J ⊗[R] M} (ht : J.subtype.rTensor M t = 0) :
    t ∈ range ((Submodule.inclusion (inf_le_left : J ⊓ I ^ n ≤ J)).rTensor M) := by
  -- `J ⧸ (J ⊓ Iⁿ)` is a submodule of `R ⧸ Iⁿ`, a module killed by `Iⁿ`.
  let P := I ^ n
  let N : Submodule R (R ⧸ P) := Submodule.map P.mkQ J
  have hPN : P • ⊤ ≤ N := Submodule.smul_le.mpr fun r hr x _ ↦ by
    obtain ⟨x, rfl⟩ := P.mkQ_surjective x
    rw [← map_smul, Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero P).mpr
      (by simpa [smul_eq_mul] using P.mul_mem_right x hr)]
    exact N.zero_mem
  exact mem_range_rTensor_inclusion_inf_of_injective
    (I.subtype_rTensor_injective_of_pow_smul_top_le hI n hPN) ht

end

/-- Let `M ⧸ P M` be flat over `R ⧸ P`. For an ideal `J`, every element of the kernel of
`J ⊗[R] M → M` comes from `(J ⊓ P) ⊗[R] M`. -/
theorem mem_range_rTensor_inclusion_inf_of_flat (P : Ideal R)
    [Module.Flat (R ⧸ P) (M ⧸ P • (⊤ : Submodule R M))] {J : Ideal R} {t : J ⊗[R] M}
    (ht : J.subtype.rTensor M t = 0) :
    t ∈ range ((Submodule.inclusion (inf_le_left : J ⊓ P ≤ J)).rTensor M) := by
  -- `J ⧸ (J ⊓ P)` is a submodule of `R ⧸ P`, and both are killed by `P`.
  have hL : Module.IsTorsionBySet R (R ⧸ P) P :=
    (Module.isTorsionBySet_quotient_iff P _).mpr fun x _ hr ↦ P.mul_mem_right x hr
  have hN : Module.IsTorsionBySet R (Submodule.map P.mkQ J) P := fun x r ↦
    Subtype.ext (hL (x := x.1) (a := r))
  exact mem_range_rTensor_inclusion_inf_of_injective
    (P.rTensor_injective_of_isTorsionBySet hN hL (Submodule.injective_subtype _)) ht

end Ideal

namespace RingHom

open scoped nonZeroDivisors

/-- If `A` and `B` are flat domains over `R` and a ring map `ψ` out of `A ⊗[R] B` has kernel `P`
disjoint from the nonzerodivisors, then `ψ` is injective on both tensor factors. -/
theorem injective_comp_include_of_disjoint_nonZeroDivisors {R A B L : Type*} [CommRing R]
    [CommRing A] [CommRing B] [IsDomain A] [IsDomain B] [Algebra R A] [Algebra R B]
    [Module.Flat R A] [Module.Flat R B] [Ring L] (ψ : A ⊗[R] B →+* L) (P : Ideal (A ⊗[R] B))
    (hψ : ∀ x, ψ x = 0 ↔ x ∈ P)
    (hdisj : Disjoint (P : Set (A ⊗[R] B)) (nonZeroDivisors (A ⊗[R] B))) :
    Function.Injective (ψ.comp Algebra.TensorProduct.includeLeftRingHom) ∧
      Function.Injective
        (ψ.comp (Algebra.TensorProduct.includeRight : B →ₐ[R] A ⊗[R] B).toRingHom) := by
  refine ⟨(injective_iff_map_eq_zero _).mpr fun b hb ↦ by_contra fun hb0 ↦ ?_,
    (injective_iff_map_eq_zero _).mpr fun c hc ↦ by_contra fun hc0 ↦ ?_⟩
  · exact Set.disjoint_left.mp hdisj ((hψ _).mp hb)
      (Module.Flat.algebraMap_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hb0))
  · have hc' := Module.Flat.algebraMap_mem_nonZeroDivisors (A := B ⊗[R] A)
      (mem_nonZeroDivisors_of_ne_zero hc0)
    exact Set.disjoint_left.mp hdisj ((hψ _).mp hc)
      (mem_nonZeroDivisors_of_injective (f := Algebra.TensorProduct.comm R A B)
        (AlgEquiv.injective _) (by simpa using hc'))

end RingHom
