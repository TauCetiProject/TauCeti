public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.TensorProduct.Basic
import Mathlib.LinearAlgebra.TensorProduct.Quotient

/-!
# Flatness and tensor products

Mathlib's `TensorProduct.map_injective_of_flat_flat` shows that the tensor product of two
injective linear maps is injective when the codomain of the first and the domain of the second
are flat. This file records the same statement for `Algebra.TensorProduct.map` of algebra
homomorphisms, so that it applies without first passing to the underlying linear maps.
It also identifies the kernel after tensoring an algebra map with a flat algebra, the analogue
of Mathlib's `Algebra.TensorProduct.lTensor_ker` with flatness in place of surjectivity.
For two algebra maps, flatness of the first codomain and the second kernel quotient similarly
identifies the tensor-product kernel with the ideal generated by the two kernels.

Finally, if `R → B` is a map of commutative semirings, `A` is a flat `B`-module, and `M` is a
`B`-module that is flat over `R`, then `A ⊗[B] M` is flat over `R`. A localization `B_q ⊗[B] M`
of an `R`-flat module over a ring is the typical case. Over semirings, flatness here means
mono-flatness, as in Mathlib's `Module.Flat`.

Two injectivity statements for tensoring with a module `M` over a ring are the diagram-chasing
steps of the local criterion for flatness. If `f.rTensor M` is injective and `F` is flat, then so
is `(f.rTensor F).rTensor M`. If `M ⧸ I M` is flat over `R ⧸ I`, then tensoring with `M` preserves
injectivity of maps between modules killed by `I`.

## Main results

* `Algebra.TensorProduct.map_injective_of_flat_flat`: the tensor product of two injective algebra
  homomorphisms is injective under the flatness hypotheses of
  `TensorProduct.map_injective_of_flat_flat`.
* `Algebra.TensorProduct.lTensor_ker_of_flat`: tensoring with a flat algebra carries kernels
  to their images under the right tensor inclusion.
* `Algebra.TensorProduct.map_ker_of_flat_flat`: the kernel of a tensor product of algebra maps
  is generated by their kernels when the first codomain and the second kernel quotient are flat.
* `Module.Flat.tensorProduct_of_flat`: if `A` is flat over `B` and `M` is flat over `R`, then
  `A ⊗[B] M` is flat over `R`.
* `Module.Flat.rTensor_rTensor_injective`: tensoring with a flat module preserves injectivity of
  `f.rTensor M`.
* `Ideal.rTensor_injective_of_isTorsionBySet`: if `M ⧸ I M` is flat over `R ⧸ I`, tensoring
  with `M` preserves injectivity of maps between modules killed by `I`.
-/

public section

open scoped TensorProduct

namespace Algebra.TensorProduct

section Semiring

variable {R S A B C D : Type*} [CommSemiring R] [CommSemiring S] [Algebra R S]
variable [Semiring A] [Semiring B] [Semiring C] [Semiring D]
variable [Algebra R A] [Algebra R B] [Algebra R C] [Algebra R D]
variable [Algebra S A] [Algebra S B] [IsScalarTower R S A] [IsScalarTower R S B]

/-- The tensor product of two injective algebra homomorphisms is injective when the codomain of
the first and the domain of the second are flat. -/
theorem map_injective_of_flat_flat (f : A →ₐ[S] B) (g : C →ₐ[R] D)
    [Module.Flat R B] [Module.Flat R C]
    (hf : Function.Injective f) (hg : Function.Injective g) :
    Function.Injective (map f g) :=
  -- `map f g` is `TensorProduct.map` of the underlying `R`-linear maps by definition.
  _root_.TensorProduct.map_injective_of_flat_flat (f.toLinearMap.restrictScalars R)
    g.toLinearMap hf hg

end Semiring

section Ring

variable {R A B C : Type*} [CommRing R] [Ring A] [Ring B] [Ring C]
variable [Algebra R A] [Algebra R B] [Algebra R C]

/-- Tensoring an algebra map with a flat algebra carries its kernel to the ideal generated
by its image under the right tensor inclusion. -/
theorem lTensor_ker_of_flat [Module.Flat R A] (f : B →ₐ[R] C) :
    RingHom.ker (map (AlgHom.id R A) f) =
      (RingHom.ker f).map (includeRight : B →ₐ[R] A ⊗[R] B) := by
  rw [← Submodule.restrictScalars_inj R, Ideal.map_includeRight_eq]
  -- Restricted to `R`, `RingHom.ker` of `map (AlgHom.id R A) f` and of `f` are by definition the
  -- `LinearMap.ker` of `LinearMap.lTensor A f.toLinearMap` and of `f.toLinearMap`.
  exact (Module.Flat.lTensor_exact A f.toLinearMap.exact_subtype_ker_map).linearMap_ker_eq

variable {S D : Type*} [CommRing S] [Algebra R S] [Ring D] [Algebra R D]
variable [Algebra S A] [Algebra S B] [IsScalarTower R S A] [IsScalarTower R S B]

/-- The kernel of a tensor product of algebra maps is generated by their kernels when the
first codomain and the quotient of the second domain by its kernel are flat. -/
theorem map_ker_of_flat_flat (f : A →ₐ[S] B) (g : C →ₐ[R] D)
    [Module.Flat R B] [Module.Flat R (C ⧸ RingHom.ker g)] :
    RingHom.ker (map f g) =
      (RingHom.ker f).map (includeLeft : A →ₐ[R] A ⊗[R] C) ⊔
        (RingHom.ker g).map (includeRight : C →ₐ[R] A ⊗[R] C) := by
  let qf := Ideal.Quotient.mkₐ S (RingHom.ker f)
  let qg := Ideal.Quotient.mkₐ R (RingHom.ker g)
  have hf : (Ideal.kerLiftAlg f).comp qf = f := by
    ext a
    exact Ideal.kerLiftAlg_mk f a
  have hg : (Ideal.kerLiftAlg g).comp qg = g := by
    ext c
    exact Ideal.kerLiftAlg_mk g c
  have hinj : Function.Injective (map (Ideal.kerLiftAlg f) (Ideal.kerLiftAlg g)).toRingHom :=
    map_injective_of_flat_flat _ _ (Ideal.kerLiftAlg_injective f) (Ideal.kerLiftAlg_injective g)
  have hmap : map f g = (map (Ideal.kerLiftAlg f) (Ideal.kerLiftAlg g)).comp (map qf qg) := by
    rw [← map_comp, hf, hg]
  have hker : RingHom.ker (map f g) = RingHom.ker (map qf qg) := by
    rw [hmap, AlgHom.ker_coe, AlgHom.comp_toRingHom]
    exact RingHom.ker_comp_of_injective _ hinj
  have hkf : RingHom.ker qf = RingHom.ker f := Ideal.Quotient.mkₐ_ker (R₁ := S) _
  have hkg : RingHom.ker qg = RingHom.ker g := Ideal.Quotient.mkₐ_ker (R₁ := R) _
  rw [hker]
  simpa only [hkf, hkg] using
    map_ker qf qg (Ideal.Quotient.mkₐ_surjective S _) (Ideal.Quotient.mkₐ_surjective R _)

end Ring

end Algebra.TensorProduct

namespace Module

open TensorProduct

variable {R B M : Type*} [CommSemiring R] [CommSemiring B] [Algebra R B]
  [AddCommMonoid M] [Module R M] [Module B M] [IsScalarTower R B M]

/-- If `A` is a flat `B`-module and `M` is a `B`-module which is flat over `R`, then `A ⊗[B] M`
is flat over `R`. This holds for commutative semirings, with `Module.Flat` meaning mono-flatness.
Compare Mathlib's instance for `Module.Flat S (M ⊗[R] N)`, where the semiring `S`
acting on the left factor is an algebra over the base `R` of the tensor product rather than below
it. -/
theorem Flat.tensorProduct_of_flat (A : Type*) [AddCommMonoid A] [Module R A] [Module B A]
    [IsScalarTower R B A] [Flat B A] [Flat R M] : Flat R (A ⊗[B] M) := by
  rw [Flat.iff_lTensor_injectiveₛ]
  intro P _ _ N
  -- Through `(A ⊗[B] M) ⊗[R] N ≃ A ⊗[B] (M ⊗[R] N)`, the map is `A ⊗[B] (M ⊗[R] N ↪ M ⊗[R] P)`.
  have h : N.subtype.lTensor (A ⊗[B] M) =
      ((AlgebraTensorModule.assoc R B B A M P).symm.restrictScalars R).toLinearMap ∘ₗ
        ((AlgebraTensorModule.lTensor B M N.subtype).lTensor A).restrictScalars R ∘ₗ
        ((AlgebraTensorModule.assoc R B B A M N).restrictScalars R).toLinearMap := by
    refine TensorProduct.ext' fun x n ↦ ?_
    induction x with
    | tmul a m => simp
    | add x y hx hy => simp only [add_tmul, map_add, hx, hy]
  rw [h]
  simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, LinearMap.coe_restrictScalars,
    EquivLike.comp_injective, EquivLike.injective_comp]
  apply Flat.lTensor_preserves_injective_linearMap
  rw [AlgebraTensorModule.coe_lTensor]
  exact Flat.lTensor_preserves_injective_linearMap _ N.injective_subtype

end Module

namespace Module

open TensorProduct LinearMap

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- If `f.rTensor M` is injective and `F` is flat, then `(f.rTensor F).rTensor M` is injective. -/
theorem Flat.rTensor_rTensor_injective {N P : Type*} [AddCommGroup N] [Module R N]
    [AddCommGroup P] [Module R P] (F : Type*) [AddCommGroup F] [Module R F] [Flat R F]
    {f : N →ₗ[R] P} (hf : Function.Injective (f.rTensor M)) :
    Function.Injective ((f.rTensor F).rTensor M) := by
  have h : (rightComm R P F M).toLinearMap ∘ₗ (f.rTensor F).rTensor M =
      ((f.rTensor M).rTensor F) ∘ₗ (rightComm R N F M).toLinearMap := by
    ext; simp
  have hY : Function.Injective ((f.rTensor M).rTensor F ∘ₗ (rightComm R N F M).toLinearMap) :=
    (Flat.rTensor_preserves_injective_linearMap _ hf).comp (rightComm R N F M).injective
  rw [← h, coe_comp] at hY
  exact hY.of_comp

end Module

namespace Ideal

open TensorProduct LinearMap

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- If `M ⧸ I M` is flat over `R ⧸ I`, tensoring with `M` preserves injectivity of maps between
modules killed by `I`. -/
theorem rTensor_injective_of_isTorsionBySet (I : Ideal R)
    [Module.Flat (R ⧸ I) (M ⧸ I • (⊤ : Submodule R M))] {K L : Type*} [AddCommGroup K]
    [Module R K] [AddCommGroup L] [Module R L] (hK : Module.IsTorsionBySet R K I)
    (hL : Module.IsTorsionBySet R L I) {f : K →ₗ[R] L} (hf : Function.Injective f) :
    Function.Injective (f.rTensor M) := by
  let _ := hK.module
  let _ := hL.module
  let A := R ⧸ I
  have hA : Function.Surjective (algebraMap R A) := Ideal.Quotient.mk_surjective
  let g : K →ₗ[A] L := f.extendScalarsOfSurjective hA
  have : Module.Flat A (A ⊗[R] M) := .of_linearEquiv
    ((quotTensorEquivQuotSMul M I).extendScalarsOfSurjective hA)
  let eK := AlgebraTensorModule.cancelBaseChange R A A K M
  let eL := AlgebraTensorModule.cancelBaseChange R A A L M
  have key (y : K ⊗[A] (A ⊗[R] M)) : f.rTensor M (eK y) = eL (g.rTensor _ y) := by
    induction y using TensorProduct.inductionOn with
    | add y z hy hz => simp only [map_add, hy, hz]
    | tmul k t =>
      induction t using TensorProduct.inductionOn with
      | add s t hs ht => simp only [tmul_add, map_add, hs, ht]
      | tmul a m =>
        simp only [eK, eL, AlgebraTensorModule.cancelBaseChange_tmul, rTensor_tmul]
        rw [← map_smul g]
        exact congrArg (· ⊗ₜ[R] m) (extendScalarsOfSurjective_apply hA f (a • k)).symm
  intro x y hxy
  obtain ⟨x, rfl⟩ := eK.surjective x
  obtain ⟨y, rfl⟩ := eK.surjective y
  rw [key, key, eL.injective.eq_iff] at hxy
  rw [Module.Flat.rTensor_preserves_injective_linearMap g hf hxy]

end Ideal
