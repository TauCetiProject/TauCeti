module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import Mathlib.RingTheory.LocalRing.Basic

/-!
# Principal ideals with a nonzerodivisor generator descend along faithfully flat maps

Let `B` be a faithfully flat `A`-algebra which is a local ring. An ideal `J` of `A` is generated
by a nonzerodivisor of `A` if and only if its extension `JB` is generated by a nonzerodivisor of
`B` (`Module.FaithfullyFlat.exists_isSMulRegular_and_eq_span_singleton_iff`). Neither ring need be
noetherian, and `A` need not be local. The typical case is a flat local homomorphism of local
rings, for instance the map `𝒪_{X,x} ⟶ 𝒪_{Y,y}` on stalks of a flat morphism of schemes, which
is faithfully flat by Mathlib's `Module.FaithfullyFlat.of_flat_of_isLocalHom`. This is the
local algebra behind the descent of effective Cartier divisors along flat surjective morphisms.

Since `B` is local and `b` is a nonzerodivisor, some `a ∈ J` has image `b u` with `u` a unit:
otherwise `JB ⊆ b 𝔪_B`. Then `aB = JB`, so `J = (a)` because ideals of `A` are contracted from
`B` (Mathlib's `Ideal.comap_map_eq_self_of_faithfullyFlat`).
-/

public section

namespace Module.FaithfullyFlat

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- **Principal ideals with a nonzerodivisor generator, detected after faithfully flat
extension.** If `B` is a faithfully flat `A`-algebra which is a local ring, an ideal `J` of `A` is
generated by a nonzerodivisor of `A` if and only if its extension to `B` is generated by a
nonzerodivisor of `B`. -/
theorem exists_isSMulRegular_and_eq_span_singleton_iff [IsLocalRing B] [FaithfullyFlat A B]
    {J : Ideal A} :
    (∃ a : A, IsSMulRegular A a ∧ J = Ideal.span {a}) ↔
      ∃ b : B, IsSMulRegular B b ∧ J.map (algebraMap A B) = Ideal.span {b} := by
  refine ⟨fun ⟨a, ha, hJ⟩ ↦ ⟨algebraMap A B a, ha.of_flat, by
    rw [hJ, Ideal.map_span, Set.image_singleton]⟩, fun ⟨b, hb, hJ⟩ ↦ ?_⟩
  -- Some `a ∈ J` maps outside `b 𝔪_B`: otherwise `b ∈ JB ⊆ b 𝔪_B`, so `b = b m` with `m ∈ 𝔪_B`,
  -- and `m = 1` since `b` is a nonzerodivisor.
  obtain ⟨a, haJ, ha⟩ : ∃ a ∈ J,
      algebraMap A B a ∉ Ideal.span {b} * IsLocalRing.maximalIdeal B := by
    by_contra! h
    have hle : J.map (algebraMap A B) ≤ Ideal.span {b} * IsLocalRing.maximalIdeal B :=
      Ideal.map_le_iff_le_comap.mpr h
    obtain ⟨m, hm, hbm⟩ := Ideal.mem_span_singleton_mul.mp
      (hle (hJ ▸ Ideal.mem_span_singleton_self b))
    have : m = 1 := hb (by simpa using hbm)
    exact (IsLocalRing.mem_maximalIdeal _).mp (this ▸ hm) isUnit_one
  -- Its image is `b u` with `u` a unit, so it generates `JB`.
  obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp (hJ ▸ Ideal.mem_map_of_mem _ haJ)
  have hu' : IsUnit u := by
    by_contra h
    exact ha (Ideal.mem_span_singleton_mul.mpr
      ⟨u, (IsLocalRing.mem_maximalIdeal u).mpr h, by rw [← hu, mul_comm]⟩)
  have hab : IsSMulRegular B (algebraMap A B a) := by
    rw [← hu, mul_comm]
    exact hb.mul (hu'.isSMulRegular B)
  refine ⟨a, fun x y hxy ↦ FaithfulSMul.algebraMap_injective A B (hab ?_), ?_⟩
  · simpa using congrArg (algebraMap A B) hxy
  · rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := B) J,
      ← Ideal.comap_map_eq_self_of_faithfullyFlat (B := B) (Ideal.span {a}), hJ, Ideal.map_span,
      Set.image_singleton, ← hu, mul_comm, Ideal.span_singleton_mul_right_unit hu']

end Module.FaithfullyFlat
