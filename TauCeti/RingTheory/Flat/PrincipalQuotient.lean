/-!
# Principal ideals with flat quotient, detected on a fibre

Let `B` be an algebra over a commutative ring `R`, let `𝔪` be an ideal of `R` whose extension
`𝔪B` lies in the Jacobson radical of `B`, and let `I` be an ideal of `B` with `B ⧸ I` flat over
`R`. The typical case is a local homomorphism `R → B` of noetherian local rings with `𝔪` the
maximal ideal of `R`, so that `B ⧸ 𝔪B` is the local ring of the closed fibre.

This file proves that `I` is generated by a nonzerodivisor of `B` as soon as its image in the
fibre ring `B ⧸ 𝔪B` is, provided `B` is noetherian and flat over `R`
(`Module.Flat.exists_isSMulRegular_and_eq_span_singleton_iff`). The converse holds without the
noetherian and flatness hypotheses on `B`. Geometrically: for a flat morphism `X → S` of locally
noetherian schemes and a closed subscheme `D ⊆ X` flat over `S`, the subscheme `D` is an effective
Cartier divisor at a point `x` exactly when the fibre `D_s` is an effective Cartier divisor of
`X_s` at `x`. This is the local algebra behind the fibrewise criterion for relative effective
Cartier divisors.

The fibre ring can also be reached from the fibre over a prime `p` of `R`: for a prime `Q` of
`κ(p) ⊗[R] B` lying over the prime `q` of `B`, the local ring `(κ(p) ⊗[R] B)_Q` is
`B_q ⧸ p B_q` (Mathlib's `Ideal.Fiber.algEquivAux₂`), compatibly with the maps from `B`
(`Ideal.Fiber.algEquivAux₂_algebraMap_one_tmul`). So the criterion applies to the local rings of
the fibre ring at all its primes
(`Module.Flat.exists_isSMulRegular_and_map_eq_span_singleton_iff_fiber`), which is how it is
read off the local rings of the scheme-theoretic fibre `X ×_S Spec κ(s)`.

The proof has two independent halves.

* **Generation.** Flatness of `B ⧸ I` gives `I ∩ 𝔪B = 𝔪I`
  (`LinearMap.ker_inf_map_algebraMap_eq_mul_of_flat`, a restatement of Mathlib's
  `LinearMap.ker_inf_smul_top_eq_smul_of_flat` for ideals). Hence, if `f ∈ I` generates `I`
  modulo `𝔪B`, then `I ⊆ (f) + 𝔪I`, and Nakayama's lemma gives `I = (f)`
  (`Module.Flat.eq_of_le_sup`, which allows any ideal `J ≤ I` in place of `(f)`). Only finite
  generation of `I` is used here.
* **Regularity.** If `B` and `B ⧸ (f)` are flat over `R`, then so is `(f) ≅ B ⧸ Ann(f)`, so
  `Ann(f) ∩ 𝔪B = 𝔪 Ann(f)`. When `f` is a nonzerodivisor modulo `𝔪B`, every element of `Ann(f)`
  lies in `𝔪B`, so `Ann(f) = 𝔪 Ann(f)`, and Nakayama's lemma gives `Ann(f) = 0`
  (`Module.Flat.isSMulRegular_of_isSMulRegular_quotient_mk`). Here `Ann(f)` must be finitely
  generated, which is where noetherianity of `B` is used.

## Main results

* `Module.Flat.eq_of_le_sup`: an ideal with flat quotient, generated by a smaller ideal `J`
  modulo `𝔪B`, is equal to `J`.
* `Module.Flat.isSMulRegular_of_isSMulRegular_quotient_mk`: an element with flat quotient, a
  nonzerodivisor modulo `𝔪B`, is a nonzerodivisor.
* `Module.Flat.isSMulRegular_quotient_mk_of_quotient_span_singleton`: conversely, a nonzerodivisor
  with flat quotient remains one modulo `𝔪B`.
* `Module.Flat.exists_isSMulRegular_and_eq_span_singleton_iff`: the fibre criterion.
* `Module.Flat.exists_isSMulRegular_and_map_eq_span_singleton_iff_fiber`: the fibre criterion at a
  prime `q` of `B`, read off the local ring at a prime over `q` of the fibre `κ(p) ⊗[R] B`.

## References

* H. Matsumura, *Commutative Ring Theory*, §22, for the corollary of the local flatness criterion
  that a nonzerodivisor on the closed fibre of a flat module is a nonzerodivisor.
* The Stacks Project, *Divisors*, section *Relative effective Cartier divisors*, for the
  fibrewise criterion for relative effective Cartier divisors.
* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §1.2.
-/

public section

open TensorProduct

universe u v w

variable {R : Type u} {B : Type v} [CommRing R] [CommRing B] [Algebra R B] (𝔪 : Ideal R)

/-- If `g : B → N` is a surjective `B`-linear map onto a module that is flat over `R`, then its
kernel `K` satisfies `K ∩ 𝔪B = 𝔪K` for every ideal `𝔪` of `R`. This is Mathlib's
`LinearMap.ker_inf_smul_top_eq_smul_of_flat` stated for ideals of `B`. -/
theorem LinearMap.ker_inf_map_algebraMap_eq_mul_of_flat {N : Type w} [AddCommGroup N]
    [Module B N] [Module R N] [IsScalarTower R B N] [Module.Flat R N] (g : B →ₗ[B] N)
    (hg : Function.Surjective g) :
    LinearMap.ker g ⊓ 𝔪.map (algebraMap R B) = 𝔪.map (algebraMap R B) * LinearMap.ker g := by
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.mul_le_inf.trans_eq (inf_comm _ _))
  have hx' : x ∈ LinearMap.ker (g.restrictScalars R) ⊓ 𝔪 • ⊤ := by
    rw [Ideal.smul_top_eq_map, LinearMap.ker_restrictScalars, Submodule.mem_inf,
      Submodule.restrictScalars_mem, Submodule.restrictScalars_mem]
    exact Submodule.mem_inf.mp hx
  rwa [LinearMap.ker_inf_smul_top_eq_smul_of_flat 𝔪 _ hg, LinearMap.ker_restrictScalars,
    ← Ideal.smul_restrictScalars, Submodule.restrictScalars_mem, Ideal.smul_eq_mul] at hx'

namespace Module.Flat

variable {𝔪}

/-- **Generators of an ideal with flat quotient can be found on a fibre.** Let `𝔪B` lie in the
Jacobson radical of `B`, and let `I` be a finitely generated ideal of `B` with `B ⧸ I` flat over
`R`. If an ideal `J ≤ I` generates `I` modulo `𝔪B`, then `I = J`. -/
theorem eq_of_le_sup {I J : Ideal B} [Flat R (B ⧸ I)] (hI : I.FG)
    (hjac : 𝔪.map (algebraMap R B) ≤ (⊥ : Ideal B).jacobson) (hJI : J ≤ I)
    (hle : I ≤ J ⊔ 𝔪.map (algebraMap R B)) : I = J := by
  refine le_antisymm (Submodule.le_of_le_smul_of_le_jacobson_bot hI hjac fun x hx ↦ ?_) hJI
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp (hle hx)
  have hzI : z ∈ I := by simpa using I.sub_mem hx (hJI hy)
  refine Submodule.mem_sup.mpr ⟨y, hy, z, ?_, rfl⟩
  rw [Ideal.smul_eq_mul, ← Submodule.ker_mkQ I,
    ← LinearMap.ker_inf_map_algebraMap_eq_mul_of_flat 𝔪 _ (Submodule.mkQ_surjective I),
    Submodule.ker_mkQ]
  exact ⟨hzI, hz⟩

/-- **Regularity of an element with flat quotient can be tested on a fibre.** Let `B` be
noetherian and flat over `R`, with `𝔪B` in the Jacobson radical of `B`, and let `f ∈ B` with
`B ⧸ (f)` flat over `R`. If `f` is a nonzerodivisor modulo `𝔪B`, then `f` is a nonzerodivisor
on `B`. -/
theorem isSMulRegular_of_isSMulRegular_quotient_mk [IsNoetherianRing B] [Flat R B] {f : B}
    [Flat R (B ⧸ Ideal.span {f})] (hjac : 𝔪.map (algebraMap R B) ≤ (⊥ : Ideal B).jacobson)
    (hf : IsSMulRegular (B ⧸ 𝔪.map (algebraMap R B))
      (Ideal.Quotient.mk (𝔪.map (algebraMap R B)) f)) :
    IsSMulRegular B f := by
  -- Multiplication by `f`, as a surjection `g : B → (f)`, has kernel the annihilator of `f`.
  let g : B →ₗ[B] Ideal.span {f} := (LinearMap.mulLeft B f).codRestrict _
    fun b ↦ Ideal.mul_mem_right b _ (Ideal.mem_span_singleton_self f)
  have hg : Function.Surjective g := by
    rintro ⟨y, hy⟩
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    exact ⟨b, Subtype.ext (mul_comm f b)⟩
  -- The ideal `(f)` is flat over `R`, as the kernel of `B → B ⧸ (f)`.
  have : Flat R (Ideal.span {f}) :=
    Function.Exact.flat_left_of_injective_of_surjective
      (f := (Ideal.span {f}).subtype.restrictScalars R)
      (g := (Ideal.Quotient.mkₐ R (Ideal.span {f})).toLinearMap)
      (fun y ↦ by simp [Ideal.Quotient.eq_zero_iff_mem]) Subtype.val_injective
      Ideal.Quotient.mk_surjective
  have hker : LinearMap.ker g = ⊥ := by
    refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ (IsNoetherian.noetherian _)
      (fun x hx ↦ ?_) hjac
    have hfx : f * x = 0 := congrArg Subtype.val (LinearMap.mem_ker.mp hx)
    have hxJ : x ∈ 𝔪.map (algebraMap R B) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      refine hf ?_
      simp only [smul_eq_mul, mul_zero, ← map_mul, hfx, map_zero]
    rw [Ideal.smul_eq_mul, ← LinearMap.ker_inf_map_algebraMap_eq_mul_of_flat 𝔪 g hg]
    exact ⟨hx, hxJ⟩
  exact fun a b hab ↦ LinearMap.ker_eq_bot.mp hker (Subtype.ext hab)

variable (𝔪) in
/-- A nonzerodivisor `g` of `B` with `B ⧸ (g)` flat over `R` remains a nonzerodivisor modulo
`𝔪B`, for every ideal `𝔪` of `R`. This is the case `S = R ⧸ 𝔪` of
`Module.Flat.isSMulRegular_one_tmul_of_quotient_span_singleton`. -/
theorem isSMulRegular_quotient_mk_of_quotient_span_singleton {g : B} (hg : IsSMulRegular B g)
    [Flat R (B ⧸ Ideal.span {g})] :
    IsSMulRegular (B ⧸ 𝔪.map (algebraMap R B)) (Ideal.Quotient.mk (𝔪.map (algebraMap R B)) g) := by
  -- Transport along `B ⧸ 𝔪B ≅ B ⊗[R] (R ⧸ 𝔪) ≅ (R ⧸ 𝔪) ⊗[R] B`, which sends `g` to `1 ⊗ g`.
  let e := ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B 𝔪).restrictScalars R).trans
    (Algebra.TensorProduct.comm R B (R ⧸ 𝔪))
  have he : e (Ideal.Quotient.mk (𝔪.map (algebraMap R B)) g) = (1 : R ⧸ 𝔪) ⊗ₜ[R] g := by
    simp [e, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
  intro x y hxy
  apply e.injective
  apply isSMulRegular_one_tmul_of_quotient_span_singleton hg (R ⧸ 𝔪)
  simp only [smul_eq_mul] at hxy ⊢
  rw [← he, ← map_mul, ← map_mul, hxy]

/-- **The fibre criterion for principal ideals generated by a nonzerodivisor.** Let `B` be a
noetherian `R`-algebra, flat over `R`, with `𝔪B` in the Jacobson radical of `B`, and let `I` be an
ideal of `B` with `B ⧸ I` flat over `R`. Then `I` is generated by a nonzerodivisor of `B` if and
only if its image in `B ⧸ 𝔪B` is generated by a nonzerodivisor of `B ⧸ 𝔪B`. -/
theorem exists_isSMulRegular_and_eq_span_singleton_iff [IsNoetherianRing B] [Flat R B]
    {I : Ideal B} [Flat R (B ⧸ I)] (hjac : 𝔪.map (algebraMap R B) ≤ (⊥ : Ideal B).jacobson) :
    (∃ f : B, IsSMulRegular B f ∧ I = Ideal.span {f}) ↔
      ∃ g : B ⧸ 𝔪.map (algebraMap R B),
        IsSMulRegular (B ⧸ 𝔪.map (algebraMap R B)) g ∧
          I.map (Ideal.Quotient.mk (𝔪.map (algebraMap R B))) = Ideal.span {g} := by
  constructor
  · rintro ⟨f, hf, rfl⟩
    exact ⟨_, isSMulRegular_quotient_mk_of_quotient_span_singleton 𝔪 hf,
      by simp [Ideal.map_span]⟩
  · rintro ⟨g, hg, hIg⟩
    obtain ⟨f, hf, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp
      (hIg ▸ Ideal.mem_span_singleton_self g)
    -- Pull the fibre equality back along `B → B ⧸ 𝔪B`, whose comap of `(span {f}).map mk` is
    -- `𝔪B ⊔ span {f}` (`Ideal.comap_map_quotientMk`).
    have hmap : (Ideal.span {f}).map (Ideal.Quotient.mk (𝔪.map (algebraMap R B))) =
        I.map (Ideal.Quotient.mk (𝔪.map (algebraMap R B))) := by
      rw [hIg, Ideal.map_span, Set.image_singleton]
    have hle : I ≤ Ideal.span {f} ⊔ 𝔪.map (algebraMap R B) := by
      rw [sup_comm, ← Ideal.comap_map_quotientMk, hmap]
      exact Ideal.le_comap_map
    have hIf := eq_of_le_sup (IsNoetherian.noetherian I) hjac
      ((Ideal.span_singleton_le_iff_mem I).mpr hf) hle
    subst hIf
    exact ⟨f, isSMulRegular_of_isSMulRegular_quotient_mk hjac hg, rfl⟩

open Algebra.TensorProduct

/-- **The fibre criterion at a prime of the fibre ring.** Let `B` be a noetherian `R`-algebra,
flat over `R`, and let `J` be an ideal of `B` with `B ⧸ J` flat over `R`. Let `p` be a prime of
`R` and `Q` a prime of the fibre ring `κ(p) ⊗[R] B`, lying over the prime `q` of `B`. Then `J B_q`
is generated by a nonzerodivisor of `B_q` if and only if `J (κ(p) ⊗[R] B)_Q` is generated by a
nonzerodivisor of `(κ(p) ⊗[R] B)_Q`. -/
theorem exists_isSMulRegular_and_map_eq_span_singleton_iff_fiber [IsNoetherianRing B] [Flat R B]
    (p : Ideal R) [p.IsPrime] (J : Ideal B) [Flat R (B ⧸ J)] (Q : Ideal (p.Fiber B))
    [Q.IsPrime] :
    (∃ f : Localization.AtPrime (Q.comap includeRight),
        IsSMulRegular (Localization.AtPrime (Q.comap includeRight)) f ∧
          J.map (algebraMap B _) = Ideal.span {f}) ↔
      ∃ g : Localization.AtPrime Q, IsSMulRegular (Localization.AtPrime Q) g ∧
        (J.map (includeRight : B →ₐ[R] p.Fiber B)).map
          (algebraMap (p.Fiber B) (Localization.AtPrime Q)) = Ideal.span {g} := by
  let r := Q.comap (includeRight : B →ₐ[R] p.Fiber B)
  let Br := Localization.AtPrime r
  -- `B_r ⧸ J B_r ≅ B_r ⊗[B] (B ⧸ J)` is flat over `R`.
  have : Flat R (Br ⧸ J.map (algebraMap B Br)) := by
    have := Flat.tensorProduct_of_flat (R := R) (B := B) (M := B ⧸ J) Br
    exact Flat.of_linearEquiv
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot Br J).toLinearEquiv.restrictScalars R)
  -- As `r` lies over `p`, the ideal `p B_r` lies in the maximal ideal of `B_r`.
  have hjac : p.map (algebraMap R Br) ≤ (⊥ : Ideal Br).jacobson := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R B Br,
      IsLocalization.AtPrime.to_map_mem_maximal_iff Br r]
    rw [Ideal.over_def Q p] at ha
    simpa [r] using ha
  rw [exists_isSMulRegular_and_eq_span_singleton_iff (𝔪 := p) hjac]
  -- Transport along `(κ(p) ⊗[R] B)_Q ≅ B_r ⧸ p B_r`, which is compatible with the maps from `B`.
  let e : Localization.AtPrime Q ≃+* Br ⧸ p.map (algebraMap R Br) :=
    (Ideal.Fiber.algEquivAux₂ p Q).toRingEquiv.trans (Ideal.quotEquivOfEq (by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]))
  have he : (J.map (algebraMap B Br)).map (Ideal.Quotient.mk (p.map (algebraMap R Br))) =
      ((J.map (includeRight : B →ₐ[R] p.Fiber B)).map
        (algebraMap (p.Fiber B) (Localization.AtPrime Q))).map e := by
    rw [← Ideal.map_coe e, ← Ideal.map_coe (includeRight : B →ₐ[R] p.Fiber B), Ideal.map_map,
      Ideal.map_map, Ideal.map_map]
    congr 1
    ext b
    simp [e, Br, r, ← Ideal.Quotient.mk_algebraMap]
  rw [he]
  constructor
  · rintro ⟨g, hg, hIg⟩
    refine ⟨e.symm g, (TauCeti.isSMulRegular_map_iff e _).mp (by simpa using hg), ?_⟩
    have := congrArg (Ideal.comap e) hIg
    rwa [Ideal.comap_map_of_bijective _ e.bijective, ← Ideal.map_symm, Ideal.map_span,
      Set.image_singleton] at this
  · rintro ⟨g, hg, hIg⟩
    refine ⟨e g, (TauCeti.isSMulRegular_map_iff e _).mpr hg, ?_⟩
    rw [hIg, Ideal.map_span, Set.image_singleton]

end Module.Flat
