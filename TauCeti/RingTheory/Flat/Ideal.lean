/-!
# Ideal intersections and scalar divisibility in flat modules

Flat modules preserve binary intersections under the ideal action. In particular, if `(p) ∩ (q)`
is generated by `d`, simultaneous divisibility by `p` and `q` becomes divisibility by `d`.
The scalar ring can have zero divisors, and the module need not be faithful.

Central scalar images in a possibly noncommutative algebra give both divisibility
orientations and principal left-ideal intersections.

## References

* The Stacks Project, [Tag 00HK](https://stacks.math.columbia.edu/tag/00HK), the equational
  criterion for flatness, supplied by Mathlib.
-/

public section

open scoped Pointwise

namespace Module.Flat

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] [Flat R M]
  {p q d : R}

/-- Acting by the intersection of any two ideals on a flat module gives the intersection
of their actions. The ring and module need not be nontrivial or faithful. -/
theorem inf_smul_top (I J : Ideal R) :
    (I ⊓ J) • (⊤ : Submodule R M) = I • ⊤ ⊓ J • ⊤ := by
  classical
  -- Factor the finite relation between the two presentations through a finite free module.
  -- Its basis criterion detects membership in the intersection coefficientwise.
  apply le_antisymm
  · exact le_inf (Submodule.smul_mono inf_le_left le_rfl)
      (Submodule.smul_mono inf_le_right le_rfl)
  · intro z hz
    have hrep (L : Ideal R) :
        z ∈ L • (⊤ : Submodule R M) ↔
          ∃ a : M →₀ R, (∀ i, a i ∈ L) ∧ (a.sum fun i c ↦ c • i) = z := by
      simpa only [Set.range_id, Submodule.span_univ, exists_prop, id_eq] using
        Submodule.mem_ideal_smul_span_iff_exists_sum L (id : M → M) z
    obtain ⟨a, ha, haz⟩ := (hrep I).mp hz.1
    obtain ⟨b, hb, hbz⟩ := (hrep J).mp hz.2
    let S := a.support ∪ b.support
    let x := Fintype.linearCombination R (fun i : S ↦ (i : M))
    let u : S → R := fun i ↦ a i
    let v : S → R := fun i ↦ b i
    have hsum (c : M →₀ R) (hc : c.support ⊆ S) :
        x (fun i ↦ c i) = c.sum (fun i r ↦ r • i) := by
      dsimp only [x]
      rw [Fintype.linearCombination_apply]
      exact (Finset.sum_coe_sort S (fun i : M ↦ c i • i)).trans
        (Finsupp.sum_of_support_subset c hc (fun i r ↦ r • i) (by simp)).symm
    have hu : x u = z := (hsum a Finset.subset_union_left).trans haz
    have hv : x v = z := (hsum b Finset.subset_union_right).trans hbz
    have hrelation : x (u - v) = 0 := by rw [map_sub, hu, hv, sub_self]
    obtain ⟨k, f, g, hfactor, hzero⟩ :=
      exists_factorization_of_apply_eq_zero_of_free hrelation
    have heq : f u = f v := sub_eq_zero.mp (by simpa only [map_sub] using hzero)
    have hfu : f u ∈ I • (⊤ : Submodule R (Fin k →₀ R)) :=
      Submodule.smul_top_le_comap_smul_top I f
        ((Pi.basisFun R S).mem_smul_top_iff.mpr (by intro i; simpa [u] using ha i))
    have hfv : f v ∈ J • (⊤ : Submodule R (Fin k →₀ R)) :=
      Submodule.smul_top_le_comap_smul_top J f
        ((Pi.basisFun R S).mem_smul_top_iff.mpr (by intro i; simpa [v] using hb i))
    have hw : f u ∈ (I ⊓ J) • (⊤ : Submodule R (Fin k →₀ R)) :=
      Finsupp.basisSingleOne.mem_smul_top_iff.mpr fun i ↦
        ⟨Finsupp.basisSingleOne.mem_smul_top_iff.mp hfu i,
          Finsupp.basisSingleOne.mem_smul_top_iff.mp (heq.symm ▸ hfv) i⟩
    have hg := Submodule.smul_top_le_comap_smul_top (I ⊓ J) g hw
    have hgz : g (f u) = z := by rw [← LinearMap.comp_apply, ← hfactor, hu]
    exact hgz ▸ hg

/-- If `(p) ∩ (q) = (d)` in a commutative ring, the images of multiplication by `p` and
`q` on a flat module intersect in the image of multiplication by `d`. -/
theorem smul_top_inf_smul_top_eq_smul_top
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {d}) :
    p • (⊤ : Submodule R M) ⊓ q • ⊤ = d • ⊤ := by
  simpa only [h, Submodule.ideal_span_singleton_smul] using
    (inf_smul_top (M := M) (Ideal.span {p}) (Ideal.span {q})).symm

/-- Under `(p) ∩ (q) = (d)`, simultaneous scalar divisibility by `p` and `q` in a flat
module is scalar divisibility by `d`, with no regularity or faithfulness assumption. -/
theorem exists_smul_eq_iff
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {d}) (z : M) :
    (∃ t : M, d • t = z) ↔ (∃ m : M, p • m = z) ∧ ∃ n : M, q • n = z := by
  simpa only [Submodule.mem_inf, Submodule.mem_smul_pointwise_iff_exists,
    Submodule.mem_top, true_and] using
    (Submodule.ext_iff.mp (smul_top_inf_smul_top_eq_smul_top (M := M) h) z).symm

/-- A common scalar multiple in a flat module is a multiple of any generator `d` of
`(p) ∩ (q)`. Neither scalar has to be regular and the module need not be faithful. -/
theorem exists_smul_eq_of_smul_eq
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {d})
    {m n : M} (hmn : p • m = q • n) : ∃ t : M, d • t = p • m :=
  (exists_smul_eq_iff h (p • m)).mpr ⟨⟨m, rfl⟩, ⟨n, hmn.symm⟩⟩

/-- Over a commutative ring without zero divisors, `(p) ∩ (q) = (pq)` gives the same
intersection formula for powered scalar images in every flat module, including the zero ring. -/
theorem pow_smul_top_inf_pow_smul_top_eq_mul_smul_top [NoZeroDivisors R]
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {p * q}) (r s : ℕ) :
    p ^ r • (⊤ : Submodule R M) ⊓ q ^ s • ⊤ = (p ^ r * q ^ s) • ⊤ :=
  smul_top_inf_smul_top_eq_smul_top
    (Ideal.span_singleton_pow_inf_span_singleton_pow_eq_span_singleton_mul h r s)

/-- The powered scalar-image intersection also holds over rings with zero divisors when
`p` and `q` are regular and `(p) ∩ (q) = (pq)`. -/
theorem pow_smul_top_inf_pow_smul_top_eq_mul_smul_top_of_isSMulRegular
    (hp : IsSMulRegular R p) (hq : IsSMulRegular R q)
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {p * q}) (r s : ℕ) :
    p ^ r • (⊤ : Submodule R M) ⊓ q ^ s • ⊤ = (p ^ r * q ^ s) • ⊤ :=
  smul_top_inf_smul_top_eq_smul_top
    (Ideal.span_singleton_pow_inf_span_singleton_pow_eq_span_singleton_mul_of_isSMulRegular
      hp hq h r s)

section Algebra

variable {A : Type*} [Ring A] [Algebra R A] [Flat R A]

/-- Extension of ideals along the central scalar map of a flat, possibly noncommutative
algebra preserves binary intersections. -/
theorem map_algebraMap_inf (I J : Ideal R) :
    (I ⊓ J).map (algebraMap R A) = I.map (algebraMap R A) ⊓ J.map (algebraMap R A) := by
  apply Submodule.restrictScalars_injective R
  rw [Submodule.restrictScalars_inf, ← Ideal.smul_top_eq_restrictScalars_map,
    ← Ideal.smul_top_eq_restrictScalars_map, ← Ideal.smul_top_eq_restrictScalars_map]
  exact inf_smul_top (M := A) I J

/-- In a flat algebra, the images of `p` and `q` both divide an element exactly when the
image of `d` does, provided `(p) ∩ (q) = (d)` in the scalar ring. -/
theorem algebraMap_dvd_iff
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {d}) (z : A) :
    algebraMap R A d ∣ z ↔ algebraMap R A p ∣ z ∧ algebraMap R A q ∣ z := by
  simpa only [dvd_def, eq_comm, Algebra.smul_def] using exists_smul_eq_iff h z

/-- In a flat, possibly noncommutative algebra, the principal left ideals of the central
images of `p` and `q` intersect in that of `d`, provided `(p) ∩ (q) = (d)` in the scalar ring. -/
theorem span_algebraMap_inf_span_algebraMap
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {d}) :
    Ideal.span {algebraMap R A p} ⊓ Ideal.span {algebraMap R A q} =
      Ideal.span {algebraMap R A d} := by
  have hm := map_algebraMap_inf (A := A) (Ideal.span {p}) (Ideal.span {q})
  rw [h] at hm
  simpa only [Ideal.map_span, Set.image_singleton] using hm.symm

/-- Right divisibility by both central scalar images is right divisibility by a generator
of their scalar ideal intersection, in a flat algebra. -/
theorem algebraMap_rightDvd_iff
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {d}) (z : A) :
    algebraMap R A d ∣ᵣ z ↔ algebraMap R A p ∣ᵣ z ∧ algebraMap R A q ∣ᵣ z := by
  simpa only [Submodule.mem_inf, Ideal.mem_span_singleton', RightDvd, eq_comm] using
    (Submodule.ext_iff.mp (span_algebraMap_inf_span_algebraMap (A := A) h) z).symm

/-- The central principal left-ideal intersection persists under powers when the scalar
ring has no zero divisors and `(p) ∩ (q) = (pq)`. -/
theorem span_algebraMap_pow_inf_span_algebraMap_pow [NoZeroDivisors R]
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {p * q}) (r s : ℕ) :
    Ideal.span {algebraMap R A p ^ r} ⊓ Ideal.span {algebraMap R A q ^ s} =
      Ideal.span {algebraMap R A p ^ r * algebraMap R A q ^ s} := by
  simpa only [map_pow, map_mul] using span_algebraMap_inf_span_algebraMap (A := A)
    (Ideal.span_singleton_pow_inf_span_singleton_pow_eq_span_singleton_mul h r s)

/-- Powered central scalar left ideals have product intersection for regular `p` and `q`
with `(p) ∩ (q) = (pq)`, over a commutative scalar ring that may have zero divisors. -/
theorem span_algebraMap_pow_inf_span_algebraMap_pow_of_isSMulRegular
    (hp : IsSMulRegular R p) (hq : IsSMulRegular R q)
    (h : Ideal.span {p} ⊓ Ideal.span {q} = Ideal.span {p * q}) (r s : ℕ) :
    Ideal.span {algebraMap R A p ^ r} ⊓ Ideal.span {algebraMap R A q ^ s} =
      Ideal.span {algebraMap R A p ^ r * algebraMap R A q ^ s} := by
  simpa only [map_pow, map_mul] using span_algebraMap_inf_span_algebraMap (A := A)
    (Ideal.span_singleton_pow_inf_span_singleton_pow_eq_span_singleton_mul_of_isSMulRegular
      hp hq h r s)

end Algebra

end Module.Flat
