module

public import Mathlib.RingTheory.IsAdjoinRoot
public import Mathlib.RingTheory.LocalProperties.Exactness
public import Mathlib.RingTheory.LocalProperties.Submodule
public import Mathlib.RingTheory.Localization.BaseChange
public import Mathlib.RingTheory.LocalRing.Module
public import Mathlib.RingTheory.Spectrum.Prime.FreeLocus

/-!
# Monogenic finite flat algebras of constant rank are free

Let `S` be a commutative `R`-algebra generated by a single element `α`. If `S` is finite and flat
over `R` with constant rank `n` (that is, `Module.rankAtStalk S p = n` at every prime `p` of `R`),
then `1, α, …, α ^ (n - 1)` is an `R`-basis of `S`. In particular `S` is a free `R`-module, so
Mathlib's `IsAdjoinRootMonic.mkOfAdjoinEqTop'` applies and presents `S` as `R[X]` modulo a monic
polynomial of degree `n`.

A finite flat module of constant rank is in general only locally free. Being generated by one
element is what makes it globally free: after localizing at a maximal ideal `𝔪`, the algebra
`R_𝔪 ⊗[R] S` is free of rank `n` over the local ring `R_𝔪` and generated by `1 ⊗ α`, hence has
the power basis `(1 ⊗ α) ^ i`, `i < n`; linear independence and spanning of the powers `α ^ i`
are local on the maximal ideals of `R`. The rank hypothesis cannot be dropped: over `k × k`, the
algebra `k[ε] × k` is generated by `(ε, 0)` and is projective of ranks `2` and `1` on the two
points of the spectrum, hence not free.

## Main results

* `TauCeti.Module.linearIndependent_pow_of_adjoin_eq_top` and
  `TauCeti.Module.span_pow_of_adjoin_eq_top`: the powers `α ^ i`, `i < n`, are linearly
  independent and span `S`.
* `TauCeti.Module.free_of_adjoin_eq_top`: such an algebra is a free `R`-module.

## References

* The Stacks Project, *Hilbert scheme of points*, Section 44.2, Tag 0B94, for the
  parameterization of finite locally free quotients of `R[X]` by monic polynomials.
-/

public section

open TensorProduct

namespace TauCeti.Module

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S]
  [Module.Flat R S] {α : S} {n : ℕ}

/-- At a maximal ideal `P`, the powers `(1 ⊗ α) ^ i`, `i < n`, form a basis of the localization
`R_P ⊗[R] S` of a monogenic finite flat algebra of rank `n` at `P`. -/
private noncomputable def localizationBasis (hα : Algebra.adjoin R {α} = ⊤)
    (hn : ∀ p : PrimeSpectrum R, Module.rankAtStalk S p = n) (P : Ideal R) [P.IsMaximal] :
    Module.Basis (Fin n) (Localization.AtPrime P) (Localization.AtPrime P ⊗[R] S) :=
  haveI := Module.free_of_flat_of_isLocalRing (R := Localization.AtPrime P)
    (P := Localization.AtPrime P ⊗[R] S)
  have hα' : Algebra.adjoin (Localization.AtPrime P) {(1 : Localization.AtPrime P) ⊗ₜ[R] α} =
      ⊤ := by
    simpa using Algebra.TensorProduct.adjoin_one_tmul_image_eq_top
      (A := Localization.AtPrime P) {α} hα
  let h := IsAdjoinRootMonic.mkOfAdjoinEqTop' hα'
  h.basis.reindex <| finCongr <| h.finrank.symm.trans <|
    (Module.rankAtStalk_eq_finrank_tensorProduct ⟨P, inferInstance⟩).symm.trans (hn _)

private lemma localizationBasis_apply (hα : Algebra.adjoin R {α} = ⊤)
    (hn : ∀ p : PrimeSpectrum R, Module.rankAtStalk S p = n) (P : Ideal R) [P.IsMaximal]
    (i : Fin n) : localizationBasis hα hn P i =
      (1 : Localization.AtPrime P) ⊗ₜ[R] α ^ (i : ℕ) := by
  simp [localizationBasis, IsAdjoinRootMonic.basis_apply, IsAdjoinRootMonic.mkOfAdjoinEqTop'_root,
    Algebra.TensorProduct.tmul_pow]

/-- In an `R`-algebra generated by `α` which is finite flat of constant rank `n`, the powers
`α ^ i`, `i < n`, are linearly independent over `R`. -/
theorem linearIndependent_pow_of_adjoin_eq_top (hα : Algebra.adjoin R {α} = ⊤)
    (hn : ∀ p : PrimeSpectrum R, Module.rankAtStalk S p = n) :
    LinearIndependent R fun i : Fin n ↦ α ^ (i : ℕ) := by
  refine LinearIndependent.of_isLocalized_maximal (fun P _ ↦ Localization.AtPrime P)
    (fun P _ ↦ Localization.AtPrime P ⊗[R] S)
    (fun P _ ↦ TensorProduct.mk R (Localization.AtPrime P) S 1) _ fun P _ ↦ ?_
  convert (localizationBasis hα hn P).linearIndependent using 1
  ext i
  simp [localizationBasis_apply]

/-- An `R`-algebra generated by `α` which is finite flat of constant rank `n` is spanned by the
powers `α ^ i`, `i < n`. -/
theorem span_pow_of_adjoin_eq_top (hα : Algebra.adjoin R {α} = ⊤)
    (hn : ∀ p : PrimeSpectrum R, Module.rankAtStalk S p = n) :
    Submodule.span R (Set.range fun i : Fin n ↦ α ^ (i : ℕ)) = ⊤ := by
  refine Submodule.eq_top_of_localization_maximal (fun P _ ↦ Localization.AtPrime P)
    (fun P _ ↦ Localization.AtPrime P ⊗[R] S)
    (fun P _ ↦ TensorProduct.mk R (Localization.AtPrime P) S 1) _ fun P _ ↦ ?_
  rw [Submodule.localized'_span, ← Set.range_comp, ← (localizationBasis hα hn P).span_eq]
  congr 1
  ext i
  simp [localizationBasis_apply]

/-- An `R`-algebra generated by a single element which is finite flat of constant rank over `R`
is a free `R`-module. -/
theorem free_of_adjoin_eq_top (hα : Algebra.adjoin R {α} = ⊤)
    (hn : ∀ p : PrimeSpectrum R, Module.rankAtStalk S p = n) : Module.Free R S :=
  .of_basis <| .mk (linearIndependent_pow_of_adjoin_eq_top hα hn)
    (span_pow_of_adjoin_eq_top hα hn).ge

end TauCeti.Module
