public import Mathlib.RingTheory.Regular.IsSMulRegular

/-!
# Nonzerodivisors on the closed fibre of a flat module

Let `R → S` be a ring map of Noetherian rings, `𝔪` a maximal ideal of `R` with `𝔪S` in the
Jacobson radical of `S`, and `M` a finite `S`-module that is flat over `R`. The typical case is a
local homomorphism of Noetherian local rings, with `𝔪` the maximal ideal of `R`. If `y ∈ S` is a
nonzerodivisor on the closed fibre `M ⧸ 𝔪M`, then `y` is a nonzerodivisor on `M`, and `M ⧸ yM` is
again flat over `R` (Matsumura, Corollary to Theorem 22.5). Applied repeatedly, a regular sequence
on the closed fibre is a regular sequence on `M` whose successive quotients stay flat over `R`;
this is how depth behaves along flat local homomorphisms.

## Main results

* `Module.Flat.smul_mem_ideal_smul_top_iff`: for a flat `R`-module `M`, an ideal `J` and `a ∈ R`,
  the elements `v` with `a v ∈ J M` are those of `(J : a) M`; that is, colon ideals commute with
  flat modules.
* `Module.Flat.mem_smul_top_of_smul_mem_ideal_smul_top`: if `a ∉ J` and `𝔪 a ⊆ J` for a maximal
  ideal `𝔪`, multiplication by `a` embeds `M ⧸ 𝔪M` into `M ⧸ JM`.
* `Module.Flat.isSMulRegular_quotient_map_smul_top`: a nonzerodivisor on `M ⧸ 𝔪M` is a
  nonzerodivisor on `M ⧸ IM` for every ideal `I` of `R`.
* `Module.Flat.isSMulRegular_of_isSMulRegular_quotient_map_smul_top`: the case `I = 0`, so a
  nonzerodivisor on the closed fibre is a nonzerodivisor on `M`.
* `Module.Flat.flat_quotSMulTop_of_isSMulRegular_quotient_map_smul_top`: dividing by such an
  element keeps `M` flat over `R`.

## Implementation notes

For an ideal `J ⊇ 𝔪ⁿ` of `R` the regularity of `y` on `M ⧸ JM` follows by descending induction on
`J`: if `J ≠ R`, there is `a ∉ J` with `𝔪 a ⊆ J`, so `(J : a) = 𝔪`, and the colon formula for the
flat module `M` reduces `J` to the larger ideal `J + (a)`. Krull's intersection theorem for the
finite `S`-module `M ⧸ IM` then passes from the ideals `I + 𝔪ⁿ` to `I`. Flatness of `M ⧸ yM` is
checked with the equational criterion, using the regularity of `y` on `M ⧸ IM` for the ideal `I`
generated by the coefficients of a relation. This replaces the local criterion for flatness used
by Matsumura.

## References

* H. Matsumura, *Commutative Ring Theory*, Theorem 22.5 and its Corollary.
-/

public section

open Pointwise

/-- For an `R`-algebra `S`, an `S`-module `M` and an ideal `I` of `R`, the submodule `(I S) M` of
the `S`-module `M` is the submodule `I M` of the `R`-module `M`. -/
theorem Ideal.mem_map_smul_top_iff {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M] {I : Ideal R} {v : M} :
    v ∈ I.map (algebraMap R S) • (⊤ : Submodule S M) ↔ v ∈ I • (⊤ : Submodule R M) := by
  rw [← Submodule.restrictScalars_mem R, Ideal.smul_restrictScalars,
    Submodule.restrictScalars_top]

namespace Module.Flat

variable {R : Type*} [CommRing R]

section Colon

variable {M : Type*} [AddCommGroup M] [Module R M]

/-- An element of `J • ⊤` is a finite sum `∑ bᵢ uᵢ` with `bᵢ ∈ J`, indexed by a finite type. -/
private theorem exists_sum_of_mem_ideal_smul_top {J : Ideal R} {m : M}
    (hm : m ∈ J • (⊤ : Submodule R M)) :
    ∃ (s : Finset M) (c : M → R), (∀ u, c u ∈ J) ∧ ∑ u : s, c u • (u : M) = m := by
  rw [← Submodule.span_univ, ← Set.range_id] at hm
  obtain ⟨c, hcJ, hc⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum J id m).1 hm
  refine ⟨c.support, c, hcJ, ?_⟩
  rw [← hc, Finsupp.sum]
  exact Finset.sum_coe_sort c.support fun u ↦ c u • u

/-- **Colon ideals commute with flat modules.** For a flat `R`-module `M`, an ideal `J` and
`a ∈ R`, an element `v` satisfies `a v ∈ J M` exactly when `v ∈ (J : a) M`. -/
theorem smul_mem_ideal_smul_top_iff [Flat R M] {J : Ideal R} {a : R} {v : M} :
    a • v ∈ J • (⊤ : Submodule R M) ↔ v ∈ J.colon {a} • (⊤ : Submodule R M) := by
  refine ⟨fun hv ↦ ?_, fun hv ↦ ?_⟩
  · obtain ⟨s, c, hcJ, hc⟩ := exists_sum_of_mem_ideal_smul_top hv
    -- The relation `a • v - ∑ c u • u = 0` is trivial, as `M` is flat.
    let f : Option s → R := fun i ↦ i.elim a fun u ↦ -c u
    let x : Option s → M := fun i ↦ i.elim v fun u ↦ u
    have hrel : ∑ i, f i • x i = 0 := by
      rw [Fintype.sum_option]
      simp only [f, x, Option.elim_none, Option.elim_some, neg_smul, Finset.sum_neg_distrib, hc,
        add_neg_cancel]
    obtain ⟨k, A, z, hx, hA⟩ := isTrivialRelation_of_sum_smul_eq_zero hrel
    have hv := hx none
    simp only [x, Option.elim_none] at hv
    rw [hv]
    refine Submodule.sum_mem _ fun j _ ↦ Submodule.smul_mem_smul ?_ trivial
    -- Each coefficient `A none j` multiplies `a` into `J`.
    rw [Submodule.mem_colon_singleton, smul_eq_mul, mul_comm]
    have h := hA j
    rw [Fintype.sum_option, add_eq_zero_iff_eq_neg] at h
    simp only [f, Option.elim_none, Option.elim_some, neg_mul, Finset.sum_neg_distrib, neg_neg]
      at h
    rw [h]
    exact J.sum_mem fun u _ ↦ J.mul_mem_right _ (hcJ u)
  · refine Submodule.smul_induction_on hv (fun r hr w _ ↦ ?_) fun _ _ h₁ h₂ ↦ ?_
    · rw [smul_smul, mul_comm]
      exact Submodule.smul_mem_smul (by simpa using Submodule.mem_colon_singleton.1 hr) trivial
    · rw [smul_add]
      exact add_mem h₁ h₂

/-- Let `M` be a flat `R`-module, `𝔪` a maximal ideal and `a ∉ J` with `𝔪 a ⊆ J`, so that
`(J : a) = 𝔪`. If `a v ∈ J M`, then `v ∈ 𝔪 M`; that is, multiplication by `a` embeds `M ⧸ 𝔪M`
into `M ⧸ JM`. -/
theorem mem_smul_top_of_smul_mem_ideal_smul_top [Flat R M] {𝔪 J : Ideal R} [𝔪.IsMaximal]
    {a : R} (haJ : a ∉ J) (h𝔪a : ∀ r ∈ 𝔪, r * a ∈ J) {v : M}
    (hv : a • v ∈ J • (⊤ : Submodule R M)) : v ∈ 𝔪 • (⊤ : Submodule R M) := by
  have hcolon : J.colon {a} = 𝔪 := by
    refine (Ideal.IsMaximal.eq_of_le ‹_› (fun h ↦ haJ ?_) fun r hr ↦ ?_).symm
    · simpa using Submodule.mem_colon_singleton.1 ((Ideal.eq_top_iff_one _).1 h)
    · exact Submodule.mem_colon_singleton.2 (h𝔪a r hr)
  rwa [smul_mem_ideal_smul_top_iff, hcolon] at hv

end Colon

section FiberRegular

variable {S M : Type*} [CommRing S] [Algebra R S] [AddCommGroup M] [Module R M] [Module S M]
  [IsScalarTower R S M]

/-- An ideal `J ≠ R` containing a power of a maximal ideal `𝔪` contains `𝔪 a` for some `a ∉ J`. -/
private theorem exists_notMem_forall_mul_mem {𝔪 J : Ideal R} {n : ℕ} (hn : 𝔪 ^ n ≤ J)
    (hJ : J ≠ ⊤) : ∃ a ∉ J, ∀ r ∈ 𝔪, r * a ∈ J := by
  induction n with
  | zero => exact absurd (top_le_iff.1 (by simpa using hn)) hJ
  | succ n ih =>
    by_cases h : 𝔪 ^ n ≤ J
    · exact ih h
    obtain ⟨a, ha, haJ⟩ := Set.not_subset.1 h
    exact ⟨a, haJ, fun r hr ↦ hn (by rw [pow_succ']; exact Ideal.mul_mem_mul hr ha)⟩

variable [Flat R M] (𝔪 : Ideal R) [𝔪.IsMaximal] {y : S}

/-- If `y` is regular on `M ⧸ 𝔪M`, it is regular on `M ⧸ JM` for every ideal `J ⊇ 𝔪ⁿ`. -/
private theorem mem_smul_top_of_smul_mem_of_pow_le [IsNoetherianRing R]
    (hy : ∀ v : M, y • v ∈ 𝔪 • (⊤ : Submodule R M) → v ∈ 𝔪 • (⊤ : Submodule R M)) {n : ℕ}
    (J : Ideal R) (hn : 𝔪 ^ n ≤ J) (v : M) (hv : y • v ∈ J • (⊤ : Submodule R M)) :
    v ∈ J • (⊤ : Submodule R M) := by
  -- The submodules `J M` are stable under `y`.
  have hyJ (J : Ideal R) {w : M} (hw : w ∈ J • (⊤ : Submodule R M)) :
      y • w ∈ J • (⊤ : Submodule R M) := by
    rw [← Ideal.mem_map_smul_top_iff (S := S)] at hw ⊢
    exact Submodule.smul_of_tower_mem _ y hw
  induction J using WellFoundedGT.induction generalizing v with
  | ind J ih =>
  by_cases hJ : J = ⊤
  · simp [hJ]
  -- Choose `a ∉ J` with `𝔪 a ⊆ J`, so that `(J : a) = 𝔪`.
  obtain ⟨a, haJ, h𝔪a⟩ := exists_notMem_forall_mul_mem hn hJ
  -- By induction, `v ∈ (J + (a)) M`, so `v = j + a w` with `j ∈ J M`.
  have hlt : J < J ⊔ Ideal.span {a} :=
    lt_of_le_of_ne le_sup_left fun h ↦
      haJ (h ▸ Ideal.mem_sup_right (Ideal.mem_span_singleton_self a))
  have hv' := ih _ hlt (hn.trans hlt.le) v
    (Submodule.smul_mono_left le_sup_left hv)
  rw [Submodule.sup_smul, Submodule.ideal_span_singleton_smul, Submodule.mem_sup] at hv'
  obtain ⟨j, hj, aw, haw, rfl⟩ := hv'
  obtain ⟨w, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 haw
  -- Then `a (y w) ∈ J M`, so `y w ∈ 𝔪 M`, so `w ∈ 𝔪 M` and `a w ∈ J M`.
  have hayw : a • y • w ∈ J • (⊤ : Submodule R M) := by
    have := Submodule.sub_mem _ hv (hyJ J hj)
    rwa [smul_add, add_sub_cancel_left, smul_comm] at this
  have hw := hy w (mem_smul_top_of_smul_mem_ideal_smul_top haJ h𝔪a hayw)
  have haw : a • w ∈ (Ideal.span {a} * 𝔪) • (⊤ : Submodule R M) := by
    rw [Submodule.mul_smul]
    exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self a) hw
  exact add_mem hj <| Submodule.smul_mono_left
    (Ideal.span_singleton_mul_le_iff.2 fun r hr ↦ mul_comm a r ▸ h𝔪a r hr) haw

variable [IsNoetherianRing R] [IsNoetherianRing S] [Module.Finite S M]
  (hjac : 𝔪.map (algebraMap R S) ≤ (⊥ : Ideal S).jacobson)
  (hy : IsSMulRegular (M ⧸ 𝔪.map (algebraMap R S) • (⊤ : Submodule S M)) y)
include hjac hy

/-- Let `R → S` be a map of Noetherian rings, `𝔪` a maximal ideal of `R` with `𝔪S` in the Jacobson
radical of `S`, and `M` a finite `S`-module, flat over `R`. If `y ∈ S` is a nonzerodivisor on
`M ⧸ 𝔪M`, then it is a nonzerodivisor on `M ⧸ IM` for every ideal `I` of `R`. -/
theorem isSMulRegular_quotient_map_smul_top (I : Ideal R) :
    IsSMulRegular (M ⧸ I.map (algebraMap R S) • (⊤ : Submodule S M)) y := by
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem] at hy ⊢
  simp_rw [Ideal.mem_map_smul_top_iff] at hy
  intro v hv
  set N := I.map (algebraMap R S) • (⊤ : Submodule S M)
  -- For every `n`, `v ∈ (I + 𝔪ⁿ) M`, so the image of `v` in `M ⧸ IM` lies in `(𝔪S)ⁿ (M ⧸ IM)`.
  have hmem (n : ℕ) : N.mkQ v ∈ 𝔪.map (algebraMap R S) ^ n • (⊤ : Submodule S (M ⧸ N)) := by
    have h := mem_smul_top_of_smul_mem_of_pow_le 𝔪 hy (I ⊔ 𝔪 ^ n) le_sup_right v
      (Submodule.smul_mono_left le_sup_left (Ideal.mem_map_smul_top_iff.1 hv))
    rw [← Ideal.mem_map_smul_top_iff (S := S), Ideal.map_sup, Submodule.sup_smul,
      Ideal.map_pow] at h
    obtain ⟨i, hi, j, hj, rfl⟩ := Submodule.mem_sup.1 h
    rw [map_add, Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero N).2 hi, zero_add,
      ← Submodule.range_mkQ N, ← Submodule.map_top, ← Submodule.map_smul'']
    exact Submodule.mem_map_of_mem hj
  -- By Krull's intersection theorem, the image of `v` vanishes.
  have hbot := Ideal.iInf_pow_smul_eq_bot_of_le_jacobson _ hjac (M := M ⧸ N)
  have : N.mkQ v ∈ (⊥ : Submodule S (M ⧸ N)) := hbot ▸ Submodule.mem_iInf _ |>.2 hmem
  simpa using this

/-- **A nonzerodivisor on the closed fibre of a flat module is a nonzerodivisor.** Let `R → S` be a
map of Noetherian rings, `𝔪` a maximal ideal of `R` with `𝔪S` in the Jacobson radical of `S`, and
`M` a finite `S`-module, flat over `R`. If `y ∈ S` is a nonzerodivisor on `M ⧸ 𝔪M`, then it is a
nonzerodivisor on `M`. Matsumura, Corollary to Theorem 22.5. -/
theorem isSMulRegular_of_isSMulRegular_quotient_map_smul_top : IsSMulRegular M y := by
  have h := isSMulRegular_quotient_map_smul_top 𝔪 hjac hy ⊥
  rw [Ideal.map_bot, Submodule.bot_smul] at h
  exact (Submodule.quotEquivOfEqBot ⊥ rfl).isSMulRegular_congr y |>.1 h

/-- **Dividing by a nonzerodivisor on the closed fibre preserves flatness.** Let `R → S` be a map
of Noetherian rings, `𝔪` a maximal ideal of `R` with `𝔪S` in the Jacobson radical of `S`, and `M`
a finite `S`-module, flat over `R`. If `y ∈ S` is a nonzerodivisor on `M ⧸ 𝔪M`, then `M ⧸ yM` is
flat over `R`. Matsumura, Corollary to Theorem 22.5. -/
theorem flat_quotSMulTop_of_isSMulRegular_quotient_map_smul_top : Flat R (QuotSMulTop y M) := by
  refine of_forall_isTrivialRelation fun {l f x} hfx ↦ ?_
  -- Lift the relation `∑ fᵢ xᵢ = 0` to `∑ fᵢ mᵢ = y m₀` in `M`.
  choose m hm using fun i ↦ Submodule.Quotient.mk_surjective (y • (⊤ : Submodule S M)) (x i)
  have hsum : ∑ i, f i • m i ∈ y • (⊤ : Submodule S M) := by
    rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, map_sum]
    simp_rw [Submodule.mkQ_apply, Submodule.Quotient.mk_smul, hm]
    exact hfx
  obtain ⟨m₀, -, hm₀⟩ := Submodule.mem_smul_pointwise_iff_exists _ _ _ |>.1 hsum
  -- Then `m₀ ∈ IM` for the ideal `I` generated by the `fᵢ`, so `m₀ = ∑ fᵢ nᵢ`.
  set I := Ideal.span (Set.range f)
  have hmI : m₀ ∈ I • (⊤ : Submodule R M) := by
    have hreg := isSMulRegular_quotient_map_smul_top 𝔪 hjac hy I
    rw [isSMulRegular_quotient_iff_mem_of_smul_mem] at hreg
    refine Ideal.mem_map_smul_top_iff.1 (hreg m₀ (Ideal.mem_map_smul_top_iff.2 ?_))
    rw [hm₀]
    exact Submodule.sum_mem _ fun i _ ↦
      Submodule.smul_mem_smul (Ideal.subset_span ⟨i, rfl⟩) trivial
  obtain ⟨s, c, hcI, hc⟩ := exists_sum_of_mem_ideal_smul_top hmI
  choose d hd using fun u ↦ (Submodule.mem_span_range_iff_exists_fun R).1 (hcI u)
  set n : Fin l → M := fun i ↦ ∑ u : s, d u i • (u : M)
  have hn : ∑ i, f i • n i = m₀ := by
    rw [← hc]
    simp only [n, Finset.smul_sum, smul_smul, ← hd, Finset.sum_smul, smul_eq_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun u _ ↦ Finset.sum_congr rfl fun i _ ↦ by rw [mul_comm]
  -- The relation `∑ fᵢ (mᵢ - y nᵢ) = 0` in `M` is trivial, and so is its image in `M ⧸ yM`.
  have hrel : ∑ i, f i • (m i - y • n i) = 0 := by
    simp_rw [smul_sub, Finset.sum_sub_distrib, smul_comm (f _) y, ← Finset.smul_sum, hn, hm₀,
      sub_self]
  obtain ⟨k, A, z, hz, hA⟩ := isTrivialRelation_of_sum_smul_eq_zero hrel
  refine ⟨k, A, fun j ↦ Submodule.Quotient.mk (z j), fun i ↦ ?_, hA⟩
  have hzi : m i - y • n i = ∑ j, A i j • z j := hz i
  rw [← hm i, ← sub_add_cancel (m i) (y • n i), Submodule.Quotient.mk_add,
    (Submodule.Quotient.mk_eq_zero _).2 (Submodule.smul_mem_pointwise_smul _ y ⊤ trivial),
    add_zero, hzi, ← Submodule.mkQ_apply, map_sum]
  simp_rw [Submodule.mkQ_apply, Submodule.Quotient.mk_smul]

end FiberRegular

end Module.Flat
