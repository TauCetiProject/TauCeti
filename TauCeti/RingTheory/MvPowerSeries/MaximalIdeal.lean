/-!
# The ideal of variables, maximal ideal, and residue field of multivariate power series

For any semiring `R` and variable set `σ`, the constant embedding
`MvPowerSeries.C : R →+* MvPowerSeries σ R` is a local homomorphism (`MvPowerSeries.isLocalHom_C`);
over a ring `R`, `MvPowerSeries.constantCoeff : MvPowerSeries σ R →+* R` is also a local
homomorphism (`MvPowerSeries.isLocalHom_constantCoeff`), and `MvPowerSeries σ R`-length agrees with
`R`-length on every compatible module (`MvPowerSeries.length_eq_length`). Over a commutative local
ring `R`, pulling back `IsLocalRing.maximalIdeal R` along `constantCoeff` recovers
`IsLocalRing.maximalIdeal (MvPowerSeries σ R)` without any finiteness assumption on `σ`, and
`constantCoeff` and `C` induce inverse isomorphisms between the residue fields of
`MvPowerSeries σ R` and `R`.

When `σ` is finite, any power series of order at least `n + 1` over a semiring `R` decomposes as a
finite sum `∑ s, g s * X s` with `(n : ℕ∞) ≤ (g s).order`
(`MvPowerSeries.exists_eq_sum_mul_X_of_succ_le_order`), and the `n`-th power of the ideal generated
by the variables `X s` consists precisely of the power series of order at least `n`
(`MvPowerSeries.mem_span_range_X_pow_iff_le_order`), generalizing the polynomial statement
`MvPolynomial.mem_pow_idealOfVars_iff` and the univariate statement
`PowerSeries.ker_constantCoeff`. Over a field `K` in finitely many variables, the maximal ideal of
`MvPowerSeries σ K` is `Ideal.span (Set.range X)` and its `n`-th power is
`{f | (n : ℕ∞) ≤ f.order}`.

## Main definitions

* `MvPowerSeries.residueFieldRingEquiv`: the canonical ring isomorphism
  `IsLocalRing.ResidueField (MvPowerSeries σ R) ≃+* IsLocalRing.ResidueField R` for a commutative
  local ring `R`.
* `MvPowerSeries.residueFieldAlgEquiv`: the canonical `K`-algebra isomorphism
  `IsLocalRing.ResidueField (MvPowerSeries σ K) ≃ₐ[K] K` over a field `K`.

## Main results

* `MvPowerSeries.isLocalHom_C`, `MvPowerSeries.isLocalHom_constantCoeff`,
  `MvPowerSeries.isLocalHom_algebraMap`: `C`, `constantCoeff` (over a ring), and `algebraMap` from a
  local base homomorphism are local homomorphisms.
* `MvPowerSeries.length_eq_length`: over any ring `R`,
  `Module.length (MvPowerSeries σ R) M = Module.length R M` for any compatible module `M`.
* `MvPowerSeries.mem_span_range_X_pow_iff_le_order`,
  `MvPowerSeries.ker_constantCoeff_eq_span_range_X`: for `[Finite σ]` over a semiring `R`,
  `Ideal.span (Set.range X) ^ n = {f | (n : ℕ∞) ≤ f.order}` and
  `RingHom.ker constantCoeff = Ideal.span (Set.range X)`.
* `MvPowerSeries.maximalIdeal_eq_comap_constantCoeff`,
  `MvPowerSeries.maximalIdeal_eq_map_C_sup_span_range_X`,
  `MvPowerSeries.maximalIdeal_eq_span_range_X`,
  `MvPowerSeries.mem_maximalIdeal_pow_iff_le_order`: descriptions of the maximal ideal of
  `MvPowerSeries σ R` and its powers.
-/

public section

namespace MvPowerSeries

section LocalHom

variable {σ R : Type*}

/-- The constant embedding `R →+* MvPowerSeries σ R` is a local homomorphism over any semiring
`R`. -/
instance isLocalHom_C [Semiring R] : IsLocalHom (C (σ := σ) (R := R)) :=
  ⟨fun _ h ↦ by simpa using h.map (constantCoeff (σ := σ) (R := R))⟩

/-- The constant-coefficient homomorphism `MvPowerSeries σ R →+* R` is a local homomorphism: over a
ring `R`, a multivariate power series is a unit if and only if its constant coefficient is. -/
instance isLocalHom_constantCoeff [Ring R] : IsLocalHom (constantCoeff (σ := σ) (R := R)) :=
  ⟨fun _ ↦ isUnit_iff_constantCoeff.mpr⟩

/-- If `algebraMap R A` is a local homomorphism, then so is `algebraMap R (MvPowerSeries σ A)`. -/
instance isLocalHom_algebraMap {A : Type*} [CommSemiring R] [Semiring A] [Algebra R A]
    [IsLocalHom (algebraMap R A)] : IsLocalHom (algebraMap R (MvPowerSeries σ A)) := by
  refine ⟨fun r hr ↦ ?_⟩
  rw [algebraMap_apply] at hr
  exact isUnit_of_map_unit (algebraMap R A) r (isUnit_of_map_unit (C (σ := σ) (R := A)) _ hr)

end LocalHom

section SpanRangeX

variable {σ R : Type*} [Semiring R]

/-- Every power series in the left ideal generated by the variables has zero constant
coefficient. -/
theorem constantCoeff_eq_zero_of_mem_span_range_X {f : MvPowerSeries σ R}
    (hf : f ∈ Ideal.span (Set.range (X (σ := σ) (R := R)))) :
    constantCoeff f = 0 := by
  refine Submodule.span_induction ?_ (map_zero _) (fun _ _ _ _ h₁ h₂ ↦ ?_) (fun r _ _ h ↦ ?_) hf
  · rintro _ ⟨s, rfl⟩
    exact constantCoeff_X s
  · rw [map_add, h₁, h₂, add_zero]
  · rw [smul_eq_mul, map_mul, h, mul_zero]

/-- Every power series in the left ideal generated by the variables has order at least `1`. -/
theorem one_le_order_of_mem_span_range_X {f : MvPowerSeries σ R}
    (hf : f ∈ Ideal.span (Set.range (X (σ := σ) (R := R)))) :
    1 ≤ f.order :=
  one_le_order_iff_constCoeff_eq_zero.mpr (constantCoeff_eq_zero_of_mem_span_range_X hf)

/-- Every power series in the `n`-th power of the ideal generated by the variables has order at
least `n`. -/
theorem le_order_of_mem_span_range_X_pow (n : ℕ) {f : MvPowerSeries σ R}
    (hf : f ∈ Ideal.span (Set.range (X (σ := σ) (R := R))) ^ n) :
    (n : ℕ∞) ≤ f.order := by
  induction n generalizing f with
  | zero => exact _root_.zero_le
  | succ n ih =>
    rw [Submodule.pow_succ] at hf
    refine Submodule.mul_induction_on hf (fun g hg h hh ↦ ?_) (fun g h hg hh ↦ le_order_add hg hh)
    push_cast
    exact (add_le_add (ih hg) (one_le_order_of_mem_span_range_X hh)).trans le_order_mul

/-- Over a finite variable type `σ`, any power series `f` of order at least `n + 1` decomposes as
`∑ s, g s * X s` with `(n : ℕ∞) ≤ (g s).order` for each `s : σ`. -/
theorem exists_eq_sum_mul_X_of_succ_le_order [Fintype σ] {n : ℕ} {f : MvPowerSeries σ R}
    (hf : ((n + 1 : ℕ) : ℕ∞) ≤ f.order) :
    ∃ g : σ → MvPowerSeries σ R,
      (∀ s, (n : ℕ∞) ≤ (g s).order) ∧ f = ∑ s, g s * X s := by
  classical
  let _ : LinearOrder σ := LinearOrder.lift' (Fintype.equivFin σ) (Fintype.equivFin σ).injective
  let g : σ → MvPowerSeries σ R := fun s β ↦
    if ∀ t < s, β t = 0 then coeff (Finsupp.single s 1 + β) f else 0
  have hg (s : σ) (β : σ →₀ ℕ) :
      coeff β (g s) = if ∀ t < s, β t = 0 then coeff (Finsupp.single s 1 + β) f else 0 := rfl
  refine ⟨g, fun s ↦ nat_le_order fun β hβ ↦ ?_, ext fun γ ↦ ?_⟩
  · rw [hg]
    split_ifs
    · refine coeff_of_lt_order (lt_of_lt_of_le ?_ hf)
      rw [map_add, Finsupp.degree_single]
      exact_mod_cast (by omega : 1 + β.degree < n + 1)
    · rfl
  · rw [map_sum]
    rcases eq_or_ne γ 0 with rfl | hγ
    · have h1 : (1 : ℕ∞) ≤ f.order := (Nat.cast_le.mpr (Nat.le_add_left 1 n)).trans hf
      rw [coeff_zero_eq_constantCoeff_apply, one_le_order_iff_constCoeff_eq_zero.mp h1,
        Finset.sum_eq_zero fun s _ ↦ coeff_zero_mul_X (g s) s]
    · let hne : γ.support.Nonempty := Finsupp.support_nonempty_iff.mpr hγ
      let s₀ : σ := γ.support.min' hne
      have hs₀_le : Finsupp.single s₀ 1 ≤ γ := Finsupp.single_le_iff.mpr
        (Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp (Finset.min'_mem _ hne)))
      have hs₀_min (t : σ) (ht : t < s₀) : ((γ - Finsupp.single s₀ 1 : σ →₀ ℕ) t) = 0 := by
        rw [Finsupp.tsub_apply,
          Finsupp.notMem_support_iff.mp (fun hm ↦ ht.not_ge (Finset.min'_le _ t hm)), Nat.zero_sub]
      symm
      rw [Finset.sum_eq_single s₀ ?_ (fun hm ↦ absurd (Finset.mem_univ s₀) hm),
        ((g s₀).commute_X s₀).eq, X_def, coeff_monomial_mul, ite_eq_left hs₀_le, one_mul, hg,
        ite_eq_left hs₀_min, add_tsub_cancel_of_le hs₀_le]
      intro s _ hne_s
      rw [((g s).commute_X s).eq, X_def, coeff_monomial_mul]
      split_ifs with hs
      · rw [one_mul, hg, ite_eq_right]
        intro hmin
        rcases lt_or_gt_of_ne hne_s with hlt | hgt
        · have hs0 : γ s = 0 :=
            Finsupp.notMem_support_iff.mp fun hm ↦ hlt.not_ge (Finset.min'_le _ s hm)
          exact absurd (Finsupp.single_le_iff.mp hs) (by simp [hs0])
        · have hs₀0 := hmin s₀ hgt
          rw [Finsupp.tsub_apply, Finsupp.single_eq_of_ne hgt.ne, tsub_zero] at hs₀0
          exact Finsupp.mem_support_iff.mp (Finset.min'_mem _ hne) hs₀0
      · rfl

/-- Over a finite variable type `σ`, a power series lies in the `n`-th power of the ideal generated
by the variables if and only if its order is at least `n`. -/
theorem mem_span_range_X_pow_iff_le_order [Finite σ] (n : ℕ) {f : MvPowerSeries σ R} :
    f ∈ Ideal.span (Set.range (X (σ := σ) (R := R))) ^ n ↔ (n : ℕ∞) ≤ f.order := by
  refine ⟨le_order_of_mem_span_range_X_pow n, fun hf ↦ ?_⟩
  cases nonempty_fintype σ
  induction n generalizing f with
  | zero =>
    rw [Submodule.pow_zero, Ideal.one_eq_top]
    trivial
  | succ n ih =>
    obtain ⟨g, hg, rfl⟩ := exists_eq_sum_mul_X_of_succ_le_order hf
    rw [Submodule.pow_succ]
    exact sum_mem fun s _ ↦ Ideal.mul_mem_mul (ih (hg s)) (Ideal.subset_span ⟨s, rfl⟩)

/-- Over a finite variable type `σ`, a power series lies in the ideal generated by the variables if
and only if its constant coefficient is zero. -/
theorem mem_span_range_X_iff_constantCoeff_eq_zero [Finite σ] {f : MvPowerSeries σ R} :
    f ∈ Ideal.span (Set.range (X (σ := σ) (R := R))) ↔ constantCoeff f = 0 := by
  rw [← Submodule.pow_one (Ideal.span _), mem_span_range_X_pow_iff_le_order, Nat.cast_one,
    one_le_order_iff_constCoeff_eq_zero]

/-- Over a finite variable type `σ`, the kernel of `MvPowerSeries.constantCoeff` is the ideal
generated by the variables. -/
theorem ker_constantCoeff_eq_span_range_X [Finite σ] :
    RingHom.ker (constantCoeff (σ := σ) (R := R)) = Ideal.span (Set.range X) := by
  ext f
  rw [RingHom.mem_ker, mem_span_range_X_iff_constantCoeff_eq_zero]

end SpanRangeX

section LocalRing

open IsLocalRing

variable {σ R : Type*} [CommRing R] [IsLocalRing R]

/-- Over a commutative local ring `R`, the maximal ideal of `MvPowerSeries σ R` is the preimage of
`IsLocalRing.maximalIdeal R` under `MvPowerSeries.constantCoeff` (without any finiteness assumption
on `σ`). -/
theorem maximalIdeal_eq_comap_constantCoeff :
    maximalIdeal (MvPowerSeries σ R) = (maximalIdeal R).comap constantCoeff :=
  (maximalIdeal_comap (constantCoeff (σ := σ) (R := R))).symm

/-- A multivariate power series over a local ring lies in the maximal ideal if and only if its
constant coefficient lies in the maximal ideal of the coefficient ring. -/
theorem mem_maximalIdeal_iff_constantCoeff_mem {f : MvPowerSeries σ R} :
    f ∈ maximalIdeal (MvPowerSeries σ R) ↔ constantCoeff f ∈ maximalIdeal R := by
  rw [maximalIdeal_eq_comap_constantCoeff, Ideal.mem_comap]

/-- Each coordinate variable `X s` lies in the maximal ideal of `MvPowerSeries σ R`. -/
theorem X_mem_maximalIdeal (s : σ) :
    (X s : MvPowerSeries σ R) ∈ maximalIdeal (MvPowerSeries σ R) := by
  rw [mem_maximalIdeal_iff_constantCoeff_mem, constantCoeff_X]
  exact zero_mem _

/-- Over a commutative local ring `R` (with arbitrary variable type `σ`), any monomial whose total
degree is at least `n` lies in the `n`-th power of the maximal ideal of `MvPowerSeries σ R`. -/
theorem monomial_mem_maximalIdeal_pow_of_le_degree {n : ℕ} {α : σ →₀ ℕ} (hn : n ≤ α.degree)
    (r : R) :
    monomial α r ∈ maximalIdeal (MvPowerSeries σ R) ^ n := by
  induction n generalizing α with
  | zero =>
    rw [pow_zero, Ideal.one_eq_top]
    trivial
  | succ n ih =>
    have hα : α ≠ 0 := by
      rintro rfl
      simp at hn
    obtain ⟨s, hs⟩ := Finsupp.support_nonempty_iff.mpr hα
    have hsle : Finsupp.single s 1 ≤ α :=
      Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hs))
    have hdeg : n ≤ (α - Finsupp.single s 1).degree := by
      have hadd := congrArg Finsupp.degree (tsub_add_cancel_of_le hsle)
      rw [map_add, Finsupp.degree_single] at hadd
      omega
    have hmul : monomial (α - Finsupp.single s 1) r * X s = monomial α r := by
      rw [X_def, monomial_mul_monomial, mul_one, tsub_add_cancel_of_le hsle]
    rw [pow_succ, ← hmul]
    exact Ideal.mul_mem_mul (ih hdeg) (X_mem_maximalIdeal s)

/-- Over a commutative local ring `R` in finitely many variables, the maximal ideal of
`MvPowerSeries σ R` is generated by the image of `IsLocalRing.maximalIdeal R` under `C` together
with the variables `X s`. -/
theorem maximalIdeal_eq_map_C_sup_span_range_X [Finite σ] :
    maximalIdeal (MvPowerSeries σ R) = (maximalIdeal R).map C ⊔ Ideal.span (Set.range X) := by
  refine le_antisymm (fun f hf ↦ ?_)
    (sup_le (Ideal.map_le_iff_le_comap.mpr fun r hr ↦ ?_) (Ideal.span_le.mpr ?_))
  · rw [mem_maximalIdeal_iff_constantCoeff_mem] at hf
    have hsub : f - C (constantCoeff f) ∈ Ideal.span (Set.range X) := by
      rw [mem_span_range_X_iff_constantCoeff_eq_zero, map_sub, constantCoeff_C, sub_self]
    rw [← add_sub_cancel (C (constantCoeff f)) f]
    exact add_mem (Ideal.mem_sup_left (Ideal.mem_map_of_mem C hf)) (Ideal.mem_sup_right hsub)
  · rwa [Ideal.mem_comap, mem_maximalIdeal_iff_constantCoeff_mem, constantCoeff_C]
  · rintro _ ⟨s, rfl⟩
    exact X_mem_maximalIdeal s

variable (σ R) in
/-- The canonical ring isomorphism between the residue field of `MvPowerSeries σ R` and the residue
field of a commutative local ring `R`, induced by `constantCoeff` and `C`. -/
noncomputable def residueFieldRingEquiv :
    ResidueField (MvPowerSeries σ R) ≃+* ResidueField R where
  toFun := ResidueField.map (constantCoeff (σ := σ) (R := R))
  invFun := ResidueField.map (C (σ := σ) (R := R))
  left_inv x := by
    obtain ⟨f, rfl⟩ := residue_surjective x
    rw [ResidueField.map_residue, ResidueField.map_residue, ← sub_eq_zero, ← map_sub,
      residue_eq_zero_iff, mem_maximalIdeal_iff_constantCoeff_mem, map_sub, constantCoeff_C,
      sub_self]
    exact zero_mem _
  right_inv x := by
    obtain ⟨r, rfl⟩ := residue_surjective x
    simp
  map_mul' := map_mul _
  map_add' := map_add _

@[simp]
theorem residueFieldRingEquiv_residue (f : MvPowerSeries σ R) :
    residueFieldRingEquiv σ R (residue (MvPowerSeries σ R) f) = residue R (constantCoeff f) :=
  (rfl)

@[simp]
theorem residueFieldRingEquiv_symm_residue (r : R) :
    (residueFieldRingEquiv σ R).symm (residue R r) = residue (MvPowerSeries σ R) (C r) :=
  (rfl)

end LocalRing

section Field

open IsLocalRing

variable {σ K : Type*} [Field K]

/-- Over a field `K`, the kernel of `MvPowerSeries.constantCoeff` is the maximal ideal of
`MvPowerSeries σ K` (for arbitrary `σ`). -/
theorem ker_constantCoeff_eq_maximalIdeal :
    RingHom.ker (constantCoeff (σ := σ) (R := K)) = maximalIdeal (MvPowerSeries σ K) := by
  rw [maximalIdeal_eq_comap_constantCoeff, maximalIdeal_eq_bot, RingHom.ker_eq_comap_bot]

/-- Over a field `K`, a multivariate power series lies in the maximal ideal if and only if its
constant coefficient is zero. -/
theorem mem_maximalIdeal_iff_constantCoeff_eq_zero {f : MvPowerSeries σ K} :
    f ∈ maximalIdeal (MvPowerSeries σ K) ↔ constantCoeff f = 0 := by
  rw [← ker_constantCoeff_eq_maximalIdeal, RingHom.mem_ker]

/-- Over a field `K` (with arbitrary variable type `σ`), every power series in the `n`-th power of
the maximal ideal has order at least `n`. -/
theorem le_order_of_mem_maximalIdeal_pow (n : ℕ) {f : MvPowerSeries σ K}
    (hf : f ∈ maximalIdeal (MvPowerSeries σ K) ^ n) :
    (n : ℕ∞) ≤ f.order := by
  induction n generalizing f with
  | zero => exact _root_.zero_le
  | succ n ih =>
    rw [pow_succ] at hf
    refine Submodule.mul_induction_on hf (fun g hg h hh ↦ ?_) (fun g h hg hh ↦ le_order_add hg hh)
    push_cast
    exact (add_le_add (ih hg) (one_le_order_iff_constCoeff_eq_zero.mpr
      (mem_maximalIdeal_iff_constantCoeff_eq_zero.mp hh))).trans le_order_mul

/-- Over a field `K` in finitely many variables, the maximal ideal of `MvPowerSeries σ K` is the
ideal generated by the variables. -/
theorem maximalIdeal_eq_span_range_X [Finite σ] :
    maximalIdeal (MvPowerSeries σ K) = Ideal.span (Set.range X) := by
  rw [← ker_constantCoeff_eq_maximalIdeal, ker_constantCoeff_eq_span_range_X]

/-- Over a field `K` in finitely many variables, a multivariate power series lies in the `n`-th
power of the maximal ideal if and only if its order is at least `n`. -/
theorem mem_maximalIdeal_pow_iff_le_order [Finite σ] (n : ℕ) {f : MvPowerSeries σ K} :
    f ∈ maximalIdeal (MvPowerSeries σ K) ^ n ↔ (n : ℕ∞) ≤ f.order := by
  rw [maximalIdeal_eq_span_range_X, mem_span_range_X_pow_iff_le_order]

variable (σ K) in
/-- Over a field `K`, the residue field of `MvPowerSeries σ K` is canonically `K`-isomorphic to
`K` via `constantCoeff`. -/
noncomputable def residueFieldAlgEquiv :
    ResidueField (MvPowerSeries σ K) ≃ₐ[K] K where
  toFun := ResidueField.lift (constantCoeff (σ := σ) (R := K))
  invFun := algebraMap K (ResidueField (MvPowerSeries σ K))
  left_inv x := by
    obtain ⟨f, rfl⟩ := residue_surjective x
    rw [ResidueField.lift_residue_apply,
      IsScalarTower.algebraMap_apply K (MvPowerSeries σ K) (ResidueField (MvPowerSeries σ K)),
      ← c_eq_algebraMap, ResidueField.algebraMap_eq, ← sub_eq_zero, ← map_sub,
      residue_eq_zero_iff, mem_maximalIdeal_iff_constantCoeff_eq_zero, map_sub, constantCoeff_C,
      sub_self]
  right_inv c := by
    rw [IsScalarTower.algebraMap_apply K (MvPowerSeries σ K) _, ← c_eq_algebraMap,
      ResidueField.algebraMap_eq, ResidueField.lift_residue_apply, constantCoeff_C]
  map_mul' := map_mul _
  map_add' := map_add _
  commutes' c := by
    rw [IsScalarTower.algebraMap_apply K (MvPowerSeries σ K) _, ← c_eq_algebraMap,
      ResidueField.algebraMap_eq, ResidueField.lift_residue_apply, constantCoeff_C]
    rfl

@[simp]
theorem residueFieldAlgEquiv_residue (f : MvPowerSeries σ K) :
    residueFieldAlgEquiv σ K (residue (MvPowerSeries σ K) f) = constantCoeff f :=
  (rfl)

variable (σ K) in
/-- Over a field `K`, the residue field of `MvPowerSeries σ K` has length `1` over `K`. -/
@[simp]
theorem length_residueField :
    Module.length K (ResidueField (MvPowerSeries σ K)) = 1 := by
  rw [(residueFieldAlgEquiv σ K).toLinearEquiv.length_eq, Module.length_eq_one]

end Field

section Length

variable {σ R M : Type*} [Ring R] [AddCommGroup M] [Module R M]
  [Module (MvPowerSeries σ R) M] [IsScalarTower R (MvPowerSeries σ R) M]

/-- Restricting scalars from `MvPowerSeries σ R` to `R` preserves simplicity of modules. -/
theorem isSimpleModule_of_isSimpleModule_mvPowerSeries [hS : IsSimpleModule (MvPowerSeries σ R) M] :
    IsSimpleModule R M := by
  have hC (r : R) (x : M) : (C r : MvPowerSeries σ R) • x = r • x := by
    rw [← mul_one (C r), ← smul_eq_C_mul, smul_one_smul]
  refine isSimpleModule_iff_toSpanSingleton_surjective.mpr ⟨hS.nontrivial, fun x hx y ↦ ?_⟩
  have hker (f : MvPowerSeries σ R) (hf : constantCoeff f = 0) : f • x = 0 := by
    by_contra hfx
    obtain ⟨g, hg⟩ := (isSimpleModule_iff_toSpanSingleton_surjective.mp hS).2 (f • x) hfx x
    have hu : IsUnit (1 - g * f) := isUnit_iff_constantCoeff.mpr <| by
      rw [map_sub, map_one, map_mul, hf, mul_zero, sub_zero]
      exact isUnit_one
    have hzero : (1 - g * f) • x = 0 := by
      rw [LinearMap.toSpanSingleton_apply] at hg
      rw [sub_smul, one_smul, mul_smul, hg, sub_self]
    have hinv : (↑hu.unit⁻¹ : MvPowerSeries σ R) * (1 - g * f) = 1 := by
      simpa only [IsUnit.unit_spec] using Units.inv_mul hu.unit
    have hx0 := congrArg ((↑hu.unit⁻¹ : MvPowerSeries σ R) • ·) hzero
    rw [← mul_smul, hinv, one_smul, smul_zero] at hx0
    exact hx hx0
  obtain ⟨g, rfl⟩ := (isSimpleModule_iff_toSpanSingleton_surjective.mp hS).2 x hx y
  refine ⟨constantCoeff g, ?_⟩
  rw [LinearMap.toSpanSingleton_apply, LinearMap.toSpanSingleton_apply, ← hC, ← sub_eq_zero,
    ← sub_smul]
  exact hker (C (constantCoeff g) - g) (by simp)

/-- Over any ring `R` and variable type `σ`, the `MvPowerSeries σ R`-length of a compatible module
`M` equals its `R`-length. -/
theorem length_eq_length :
    Module.length (MvPowerSeries σ R) M = Module.length R M := by
  by_cases h : IsFiniteLength (MvPowerSeries σ R) M
  · obtain ⟨s, hs_bot, hs_top⟩ := isFiniteLength_iff_exists_compositionSeries.mp h
    rw [← Module.length_compositionSeries s hs_bot hs_top]
    suffices ∀ k, Module.length R (s k) = k by
      rw [← Fin.val_last s.length, ← this, ← RelSeries.last, hs_top]
      exact (Submodule.topEquiv.restrictScalars R).length_eq
    intro k
    induction k using Fin.induction with
    | zero =>
      rw [← RelSeries.head, hs_bot]
      simp
    | succ i ih =>
      have hstep := s.step i
      let f : s i.castSucc →ₗ[MvPowerSeries σ R] s i.succ := Submodule.inclusion hstep.le
      have : IsSimpleModule (MvPowerSeries σ R) (s i.succ ⧸ LinearMap.range f) := by
        rwa [Submodule.range_inclusion, ← covBy_iff_quot_is_simple hstep.le]
      have : IsSimpleModule R (s i.succ ⧸ LinearMap.range f) :=
        isSimpleModule_of_isSimpleModule_mvPowerSeries (σ := σ)
      have hlen := Module.length_eq_add_of_exact (f.restrictScalars R)
        (LinearMap.range (f.restrictScalars R)).mkQ (Submodule.inclusion_injective hstep.le)
        (Submodule.mkQ_surjective _) (LinearMap.exact_map_mkQ_range _)
      have hq : Module.length R (s i.succ ⧸ LinearMap.range (f.restrictScalars R)) = 1 := by
        rw [LinearMap.range_restrictScalars,
          (Submodule.Quotient.restrictScalarsEquiv R (LinearMap.range f)).length_eq,
          Module.length_eq_one_iff]
        infer_instance
      rw [hlen, ih, hq]
      push_cast
      rfl
  · have hR : ¬ IsFiniteLength R M := fun hR ↦ h (TauCeti.isFiniteLength_of_tower R hR)
    rw [← Module.length_ne_top_iff, not_ne_iff] at h hR
    rw [h, hR]

end Length

end MvPowerSeries
