/-!
# Initial exponents and diagrams of initial exponents of multivariate power series

For a monomial order `m : MonomialOrder σ` and a multivariate formal power series
`f : MvPowerSeries σ R`, the *initial exponent* `m.initialExp f : σ →₀ ℕ` is the `m`-least
exponent in the support of `f` (with `m.initialExp 0 = 0`), accompanied by the *initial
coefficient* `m.initialCoeff f` and *initial term* `m.initialTerm f`. Unlike the leading
monomial `MonomialOrder.degree` of a polynomial, which maximizes `m.toSyn` over a finite support,
`m.initialExp` minimizes `m.toSyn` over a possibly infinite support using the well-foundedness of
`m.syn`, generalizing the pure lexicographic valuation `MvPowerSeries.lexOrder` to an arbitrary
monomial order. For the graded lexicographic order `MonomialOrder.degLex`, the total degree of
`degLex.initialExp f` recovers the `ℕ∞`-valued order `MvPowerSeries.order f` of any nonzero series
(`MonomialOrder.degree_initialExp_degLex_eq_order`).

For an ideal `I` of `MvPowerSeries σ R`, Hironaka's *diagram of initial exponents*
`m.initialDiagram I : Set (σ →₀ ℕ)` is the set of initial exponents `m.initialExp f` of nonzero
elements `f ∈ I`. Because multiplying `f` on the left by `monomial β 1` translates its support by
`β` without requiring cancellation of coefficients, `m.initialDiagram I` is upward closed for the
componentwise order on `σ →₀ ℕ` over any semiring (`MonomialOrder.add_mem_initialDiagram`,
`MonomialOrder.isUpperSet_initialDiagram`). By well-foundedness of `σ →₀ ℕ`, `m.initialDiagram I`
is the union of the cones `Set.Ici α` of its minimal elements; when `σ` is finite, Dickson's lemma
(`Finsupp.wellQuasiOrderedLE`) makes the set of minimal vertices finite, bundled as
`m.initialDiagramVertices I : Finset (σ →₀ ℕ)`. For an ideal generated by pure monomials
`monomial α 1` (`α ∈ S`), the initial diagram is the union `⋃ α ∈ S, Set.Ici α`
(`MonomialOrder.initialDiagram_span_monomial`).

## Main definitions

* `MonomialOrder.initialExp`: the `m`-least exponent in `f.support`, or `0` for `f = 0`.
* `MonomialOrder.initialCoeff`: the coefficient `MvPowerSeries.coeff (m.initialExp f) f`.
* `MonomialOrder.initialTerm`: the monomial
  `MvPowerSeries.monomial (m.initialExp f) (m.initialCoeff f)`.
* `MonomialOrder.initialDiagram`: the diagram `D(I) = {m.initialExp f | f ∈ I, f ≠ 0}`.
* `MonomialOrder.initialDiagramVertices`: for `[Finite σ]`, the `Finset` of minimal vertices of
  `m.initialDiagram I` in the componentwise order on `σ →₀ ℕ`.

## Main results

* `MonomialOrder.isLeast_toSyn_support_iff_ne_zero_and_initialExp_eq`:
  `IsLeast (m.toSyn '' f.support) (m.toSyn α)` holds if and only if `f ≠ 0` and
  `m.initialExp f = α`.
* `MonomialOrder.initialExp_monomial_mul`, `MonomialOrder.initialExp_monomial_one_mul`,
  `MonomialOrder.initialExp_mul`: behaviour of `m.initialExp` (along with `m.initialCoeff` and
  `m.initialTerm`) under monomial shifts, scalar multiplication, addition, and multiplication.
* `MonomialOrder.degree_initialExp_degLex_eq_order`: for `f ≠ 0`,
  `((degLex.initialExp f).degree : ℕ∞) = f.order`.
* `MonomialOrder.add_mem_initialDiagram`, `MonomialOrder.isUpperSet_initialDiagram`: upward
  closure of `m.initialDiagram I`.
* `MonomialOrder.finite_minimal_initialDiagram`,
  `MonomialOrder.initialDiagram_eq_biUnion_initialDiagramVertices`: Dickson finiteness of minimal
  vertices and decomposition of `D(I)` into vertex cones.
* `MonomialOrder.initialDiagram_span_monomial`: the initial diagram of a monomial-generated ideal
  is the union of the cones of its generating exponents.

## References

* Edward Bierstone and Pierre D. Milman, *Canonical desingularization in characteristic zero by
  blowing up the maximum strata of a local invariant*, Invent. Math. 128 (1997), 207–302, §3,
  Diagram of initial exponents, Theorem 3.17 and Corollary 3.19, p. 238.
* Heisuke Hironaka, *Resolution of singularities of an algebraic variety over a field of
  characteristic zero. I*, Ann. of Math. (2) 79 (1964), 109–203.
-/

public section

open scoped MonomialOrder

namespace MonomialOrder

section InitialExp

variable {σ R : Type*} (m : MonomialOrder σ) [Semiring R]

open scoped Classical in
/-- The initial exponent of a multivariate power series `f` with respect to a monomial order `m`:
the exponent in `f.support` minimizing `m.toSyn`, or `0` when `f = 0`. -/
noncomputable def initialExp (f : MvPowerSeries σ R) : σ →₀ ℕ :=
  if h : (m.toSyn '' f.support).Nonempty then
    m.toSyn.symm (WellFoundedLT.min (m.toSyn '' f.support) h)
  else 0

/-- The coefficient of `f` at its initial exponent `m.initialExp f`. -/
noncomputable def initialCoeff (f : MvPowerSeries σ R) : R :=
  MvPowerSeries.coeff (m.initialExp f) f

/-- The initial monomial term `monomial (m.initialExp f) (m.initialCoeff f)` of `f`. -/
noncomputable def initialTerm (f : MvPowerSeries σ R) : MvPowerSeries σ R :=
  MvPowerSeries.monomial (m.initialExp f) (m.initialCoeff f)

theorem initialCoeff_def (f : MvPowerSeries σ R) :
    m.initialCoeff f = MvPowerSeries.coeff (m.initialExp f) f := (rfl)

theorem initialTerm_def (f : MvPowerSeries σ R) :
    m.initialTerm f = MvPowerSeries.monomial (m.initialExp f) (m.initialCoeff f) := (rfl)

@[simp]
theorem initialExp_zero : m.initialExp (0 : MvPowerSeries σ R) = 0 := by
  simp [initialExp]

@[simp, nontriviality]
theorem initialExp_of_subsingleton [Subsingleton R] (f : MvPowerSeries σ R) :
    m.initialExp f = 0 := by
  have hf : f = 0 := MvPowerSeries.ext fun _ ↦ Subsingleton.elim _ _
  rw [hf, initialExp_zero]

@[simp]
theorem initialCoeff_zero : m.initialCoeff (0 : MvPowerSeries σ R) = 0 := by
  simp [initialCoeff_def]

@[simp]
theorem initialTerm_zero : m.initialTerm (0 : MvPowerSeries σ R) = 0 := by
  simp [initialTerm_def]

/-- For a nonzero power series `f`, `m.toSyn (m.initialExp f)` is the least element of
`m.toSyn '' f.support`. -/
theorem isLeast_toSyn_initialExp {f : MvPowerSeries σ R} (hf : f ≠ 0) :
    IsLeast (m.toSyn '' f.support) (m.toSyn (m.initialExp f)) := by
  have hne : (m.toSyn '' f.support).Nonempty := (Function.support_nonempty_iff.mpr hf).image _
  have hdef : m.toSyn (m.initialExp f) = WellFoundedLT.min (m.toSyn '' f.support) hne := by
    simp [initialExp, hne]
  rw [hdef]
  exact ⟨WellFounded.min_mem _ _ hne, fun _ hx ↦ WellFoundedLT.min_le hx⟩

/-- `m.toSyn α` is the least element of `m.toSyn '' f.support` if and only if `f ≠ 0` and
`m.initialExp f = α`. -/
theorem isLeast_toSyn_support_iff_ne_zero_and_initialExp_eq {f : MvPowerSeries σ R}
    {α : σ →₀ ℕ} :
    IsLeast (m.toSyn '' f.support) (m.toSyn α) ↔ f ≠ 0 ∧ m.initialExp f = α := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · obtain ⟨_, ⟨β, hβ, _⟩⟩ := h.nonempty
    have hf : f ≠ 0 := Function.support_nonempty_iff.mp ⟨β, hβ⟩
    exact ⟨hf, m.toSyn.injective ((m.isLeast_toSyn_initialExp hf).unique h)⟩
  · rintro ⟨hf, rfl⟩
    exact m.isLeast_toSyn_initialExp hf

theorem initialExp_mem_support {f : MvPowerSeries σ R} (hf : f ≠ 0) :
    m.initialExp f ∈ f.support := by
  simpa only [Set.mem_image, EmbeddingLike.apply_eq_iff_eq, exists_eq_right] using
    (m.isLeast_toSyn_initialExp hf).1

theorem coeff_initialExp_ne_zero {f : MvPowerSeries σ R} (hf : f ≠ 0) :
    MvPowerSeries.coeff (m.initialExp f) f ≠ 0 :=
  MvPowerSeries.mem_support.mp (m.initialExp_mem_support hf)

@[simp]
theorem initialCoeff_eq_zero_iff {f : MvPowerSeries σ R} :
    m.initialCoeff f = 0 ↔ f = 0 := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ m.initialCoeff_zero⟩
  by_contra hf
  exact m.coeff_initialExp_ne_zero hf h

theorem initialCoeff_ne_zero_iff {f : MvPowerSeries σ R} :
    m.initialCoeff f ≠ 0 ↔ f ≠ 0 :=
  m.initialCoeff_eq_zero_iff.not

@[simp]
theorem initialTerm_eq_zero_iff {f : MvPowerSeries σ R} :
    m.initialTerm f = 0 ↔ f = 0 := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ m.initialTerm_zero⟩
  rw [← m.initialCoeff_eq_zero_iff]
  simpa only [initialTerm_def, MvPowerSeries.coeff_monomial_same, map_zero] using
    congrArg (MvPowerSeries.coeff (m.initialExp f)) h

theorem initialTerm_ne_zero_iff {f : MvPowerSeries σ R} :
    m.initialTerm f ≠ 0 ↔ f ≠ 0 :=
  m.initialTerm_eq_zero_iff.not

theorem initialExp_le_of_mem_support {f : MvPowerSeries σ R} {α : σ →₀ ℕ} (hα : α ∈ f.support) :
    m.initialExp f ≼[m] α := by
  have hf : f ≠ 0 := Function.support_nonempty_iff.mp ⟨α, hα⟩
  exact (m.isLeast_toSyn_initialExp hf).2 (Set.mem_image_of_mem _ hα)

theorem initialExp_le_of_coeff_ne_zero {f : MvPowerSeries σ R} {α : σ →₀ ℕ}
    (hα : MvPowerSeries.coeff α f ≠ 0) : m.initialExp f ≼[m] α :=
  m.initialExp_le_of_mem_support (MvPowerSeries.mem_support.mpr hα)

theorem coeff_eq_zero_of_lt_initialExp {f : MvPowerSeries σ R} {α : σ →₀ ℕ}
    (hα : α ≺[m] m.initialExp f) : MvPowerSeries.coeff α f = 0 := by
  by_contra hne
  exact (m.initialExp_le_of_coeff_ne_zero hne).not_gt hα

/-- Introduction rule for `m.initialExp`: if `coeff α f ≠ 0` and all strictly `m`-smaller
coefficients vanish, then `m.initialExp f = α`. -/
theorem initialExp_eq_of_coeff_ne_zero_of_forall_lt {f : MvPowerSeries σ R} {α : σ →₀ ℕ}
    (hα : MvPowerSeries.coeff α f ≠ 0)
    (hlt : ∀ β, β ≺[m] α → MvPowerSeries.coeff β f = 0) :
    m.initialExp f = α := by
  refine (m.isLeast_toSyn_support_iff_ne_zero_and_initialExp_eq.mp ⟨?_, ?_⟩).2
  · exact Set.mem_image_of_mem _ (MvPowerSeries.mem_support.mpr hα)
  · rintro _ ⟨β, hβ, rfl⟩
    by_contra! h
    exact MvPowerSeries.mem_support.mp hβ (hlt β h)

/-- For a nonzero power series `f`, `m.initialExp f = α` if and only if `coeff α f ≠ 0` and every
strictly `m`-smaller exponent has zero coefficient in `f`. -/
theorem initialExp_eq_iff {f : MvPowerSeries σ R} {α : σ →₀ ℕ} (hf : f ≠ 0) :
    m.initialExp f = α ↔
      MvPowerSeries.coeff α f ≠ 0 ∧ ∀ β, β ≺[m] α → MvPowerSeries.coeff β f = 0 := by
  refine ⟨?_, fun ⟨hα, hlt⟩ ↦ m.initialExp_eq_of_coeff_ne_zero_of_forall_lt hα hlt⟩
  rintro rfl
  exact ⟨m.coeff_initialExp_ne_zero hf, fun _ ↦ m.coeff_eq_zero_of_lt_initialExp⟩

theorem initialExp_monomial (α : σ →₀ ℕ) (c : R) [Decidable (c = 0)] :
    m.initialExp (MvPowerSeries.monomial α c) = if c = 0 then 0 else α := by
  split_ifs with hc
  · simp [hc]
  · refine m.initialExp_eq_of_coeff_ne_zero_of_forall_lt ?_ fun β hβ ↦ ?_
    · rwa [MvPowerSeries.coeff_monomial_same]
    · exact MvPowerSeries.coeff_monomial_ne (fun h ↦ hβ.ne (congrArg m.toSyn h)) c

@[simp]
theorem initialExp_monomial_of_ne_zero (α : σ →₀ ℕ) {c : R} (hc : c ≠ 0) :
    m.initialExp (MvPowerSeries.monomial α c) = α := by
  classical
  rw [m.initialExp_monomial, ite_eq_right hc]

@[simp]
theorem initialCoeff_monomial (α : σ →₀ ℕ) (c : R) :
    m.initialCoeff (MvPowerSeries.monomial α c) = c := by
  classical
  rw [initialCoeff_def, m.initialExp_monomial]
  split_ifs with hc
  · simp [hc]
  · exact MvPowerSeries.coeff_monomial_same α c

@[simp]
theorem initialTerm_monomial (α : σ →₀ ℕ) (c : R) :
    m.initialTerm (MvPowerSeries.monomial α c) = MvPowerSeries.monomial α c := by
  classical
  rw [initialTerm_def, m.initialExp_monomial, m.initialCoeff_monomial]
  split_ifs with hc <;> simp [hc]

@[simp]
theorem initialExp_initialTerm (f : MvPowerSeries σ R) :
    m.initialExp (m.initialTerm f) = m.initialExp f := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  · rw [initialTerm_def, m.initialExp_monomial_of_ne_zero _ (m.initialCoeff_ne_zero_iff.mpr hf)]

@[simp]
theorem initialCoeff_initialTerm (f : MvPowerSeries σ R) :
    m.initialCoeff (m.initialTerm f) = m.initialCoeff f := by
  rw [initialTerm_def, m.initialCoeff_monomial]

@[simp]
theorem initialTerm_initialTerm (f : MvPowerSeries σ R) :
    m.initialTerm (m.initialTerm f) = m.initialTerm f := by
  rw [initialTerm_def, m.initialExp_initialTerm, m.initialCoeff_initialTerm, ← initialTerm_def]

@[simp]
theorem initialExp_C (c : R) : m.initialExp (MvPowerSeries.C c : MvPowerSeries σ R) = 0 := by
  classical
  rw [← MvPowerSeries.monomial_zero_eq_C_apply, m.initialExp_monomial, ite_self]

@[simp]
theorem initialCoeff_C (c : R) : m.initialCoeff (MvPowerSeries.C c : MvPowerSeries σ R) = c := by
  rw [← MvPowerSeries.monomial_zero_eq_C_apply, m.initialCoeff_monomial]

@[simp]
theorem initialTerm_C (c : R) :
    m.initialTerm (MvPowerSeries.C c : MvPowerSeries σ R) = MvPowerSeries.C c := by
  rw [← MvPowerSeries.monomial_zero_eq_C_apply, m.initialTerm_monomial]

@[simp]
theorem initialExp_one : m.initialExp (1 : MvPowerSeries σ R) = 0 := by
  rw [← map_one MvPowerSeries.C, m.initialExp_C]

@[simp]
theorem initialCoeff_one : m.initialCoeff (1 : MvPowerSeries σ R) = 1 := by
  rw [← map_one MvPowerSeries.C, m.initialCoeff_C]

@[simp]
theorem initialTerm_one : m.initialTerm (1 : MvPowerSeries σ R) = 1 := by
  rw [← map_one MvPowerSeries.C, m.initialTerm_C]

@[simp]
theorem initialExp_X [Nontrivial R] (i : σ) :
    m.initialExp (MvPowerSeries.X i : MvPowerSeries σ R) = Finsupp.single i 1 := by
  rw [MvPowerSeries.X_def, m.initialExp_monomial_of_ne_zero _ one_ne_zero]

@[simp]
theorem initialCoeff_X (i : σ) : m.initialCoeff (MvPowerSeries.X i : MvPowerSeries σ R) = 1 := by
  rw [MvPowerSeries.X_def, m.initialCoeff_monomial]

@[simp]
theorem initialTerm_X (i : σ) :
    m.initialTerm (MvPowerSeries.X i : MvPowerSeries σ R) = MvPowerSeries.X i := by
  rw [MvPowerSeries.X_def, m.initialTerm_monomial]

@[simp]
theorem initialExp_X_pow [Nontrivial R] (i : σ) (k : ℕ) :
    m.initialExp ((MvPowerSeries.X i : MvPowerSeries σ R) ^ k) = Finsupp.single i k := by
  rw [MvPowerSeries.X_pow_eq, m.initialExp_monomial_of_ne_zero _ one_ne_zero]

@[simp]
theorem initialCoeff_X_pow (i : σ) (k : ℕ) :
    m.initialCoeff ((MvPowerSeries.X i : MvPowerSeries σ R) ^ k) = 1 := by
  rw [MvPowerSeries.X_pow_eq, m.initialCoeff_monomial]

@[simp]
theorem initialTerm_X_pow (i : σ) (k : ℕ) :
    m.initialTerm ((MvPowerSeries.X i : MvPowerSeries σ R) ^ k) = (MvPowerSeries.X i) ^ k := by
  rw [MvPowerSeries.X_pow_eq, m.initialTerm_monomial]

@[simp]
theorem initialExp_neg {S : Type*} [Ring S] (f : MvPowerSeries σ S) :
    m.initialExp (-f) = m.initialExp f := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  refine m.initialExp_eq_of_coeff_ne_zero_of_forall_lt ?_ fun β hβ ↦ ?_
  · simpa using m.coeff_initialExp_ne_zero hf
  · simp [m.coeff_eq_zero_of_lt_initialExp hβ]

@[simp]
theorem initialCoeff_neg {S : Type*} [Ring S] (f : MvPowerSeries σ S) :
    m.initialCoeff (-f) = -m.initialCoeff f := by
  rw [initialCoeff_def, m.initialExp_neg, map_neg, initialCoeff_def]

@[simp]
theorem initialTerm_neg {S : Type*} [Ring S] (f : MvPowerSeries σ S) :
    m.initialTerm (-f) = -m.initialTerm f := by
  rw [initialTerm_def, m.initialExp_neg, m.initialCoeff_neg, map_neg, ← initialTerm_def]

theorem coeff_mul_eq_zero_of_lt_add_initialExp {f g : MvPowerSeries σ R} {γ : σ →₀ ℕ}
    (hγ : γ ≺[m] m.initialExp f + m.initialExp g) :
    MvPowerSeries.coeff γ (f * g) = 0 := by
  classical
  rw [MvPowerSeries.coeff_mul]
  refine Finset.sum_eq_zero fun p hp ↦ ?_
  rw [Finset.mem_antidiagonal] at hp
  by_cases hp1 : p.1 ≺[m] m.initialExp f
  · rw [m.coeff_eq_zero_of_lt_initialExp hp1, zero_mul]
  · have hp2 : p.2 ≺[m] m.initialExp g := by
      by_contra! hge
      have hle : m.initialExp f + m.initialExp g ≼[m] γ := by
        rw [← hp, map_add, map_add]
        exact add_le_add (not_lt.mp hp1) hge
      exact hle.not_gt hγ
    rw [m.coeff_eq_zero_of_lt_initialExp hp2, mul_zero]

theorem coeff_add_initialExp_mul (f g : MvPowerSeries σ R) :
    MvPowerSeries.coeff (m.initialExp f + m.initialExp g) (f * g) =
      m.initialCoeff f * m.initialCoeff g := by
  classical
  rw [MvPowerSeries.coeff_mul,
    Finset.sum_eq_single (m.initialExp f, m.initialExp g) ?_ (by simp)]
  · rfl
  · rintro ⟨u, v⟩ huv hne
    rw [Finset.mem_antidiagonal] at huv
    by_cases hu : u ≺[m] m.initialExp f
    · rw [m.coeff_eq_zero_of_lt_initialExp hu, zero_mul]
    · have hv : v ≺[m] m.initialExp g := by
        have hle : m.initialExp f ≼[m] u := not_lt.mp hu
        rcases hle.eq_or_lt with heq | hlt
        · have hu_eq : u = m.initialExp f := m.toSyn.injective heq.symm
          have hv_eq : v = m.initialExp g := add_left_cancel (hu_eq ▸ huv)
          exact absurd (Prod.ext hu_eq hv_eq) hne
        · by_contra! hge
          have hsum : m.toSyn (m.initialExp f + m.initialExp g) < m.toSyn (u + v) := by
            rw [map_add, map_add]
            exact add_lt_add_of_lt_of_le hlt hge
          exact hsum.ne (congrArg m.toSyn huv.symm)
      rw [m.coeff_eq_zero_of_lt_initialExp hv, mul_zero]

/-- If `m.initialCoeff f * m.initialCoeff g ≠ 0`, then the initial exponent of `f * g` is the sum
of the initial exponents of `f` and `g`. -/
theorem initialExp_mul_of_mul_initialCoeff_ne_zero {f g : MvPowerSeries σ R}
    (h : m.initialCoeff f * m.initialCoeff g ≠ 0) :
    m.initialExp (f * g) = m.initialExp f + m.initialExp g :=
  m.initialExp_eq_of_coeff_ne_zero_of_forall_lt
    (by rwa [m.coeff_add_initialExp_mul])
    fun _ ↦ m.coeff_mul_eq_zero_of_lt_add_initialExp

/-- If `m.initialCoeff f * m.initialCoeff g ≠ 0`, then the initial coefficient of `f * g` is the
product of the initial coefficients of `f` and `g`. -/
theorem initialCoeff_mul_of_mul_initialCoeff_ne_zero {f g : MvPowerSeries σ R}
    (h : m.initialCoeff f * m.initialCoeff g ≠ 0) :
    m.initialCoeff (f * g) = m.initialCoeff f * m.initialCoeff g := by
  rw [initialCoeff_def, m.initialExp_mul_of_mul_initialCoeff_ne_zero h, m.coeff_add_initialExp_mul]

/-- If `m.initialCoeff f * m.initialCoeff g ≠ 0`, then the initial term of `f * g` is the product
of the initial terms of `f` and `g`. -/
theorem initialTerm_mul_of_mul_initialCoeff_ne_zero {f g : MvPowerSeries σ R}
    (h : m.initialCoeff f * m.initialCoeff g ≠ 0) :
    m.initialTerm (f * g) = m.initialTerm f * m.initialTerm g := by
  rw [initialTerm_def, initialTerm_def, initialTerm_def,
    m.initialExp_mul_of_mul_initialCoeff_ne_zero h,
    m.initialCoeff_mul_of_mul_initialCoeff_ne_zero h, MvPowerSeries.monomial_mul_monomial]

/-- Over a semiring without zero divisors, the initial exponent of a product of nonzero power
series is the sum of their initial exponents. -/
theorem initialExp_mul [NoZeroDivisors R] {f g : MvPowerSeries σ R} (hf : f ≠ 0) (hg : g ≠ 0) :
    m.initialExp (f * g) = m.initialExp f + m.initialExp g :=
  m.initialExp_mul_of_mul_initialCoeff_ne_zero <|
    mul_ne_zero (m.initialCoeff_ne_zero_iff.mpr hf) (m.initialCoeff_ne_zero_iff.mpr hg)

/-- Over a semiring without zero divisors, the initial coefficient of a product of power series is
the product of their initial coefficients. -/
@[simp]
theorem initialCoeff_mul [NoZeroDivisors R] (f g : MvPowerSeries σ R) :
    m.initialCoeff (f * g) = m.initialCoeff f * m.initialCoeff g := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  rcases eq_or_ne g 0 with rfl | hg
  · simp
  exact m.initialCoeff_mul_of_mul_initialCoeff_ne_zero <|
    mul_ne_zero (m.initialCoeff_ne_zero_iff.mpr hf) (m.initialCoeff_ne_zero_iff.mpr hg)

/-- Over a semiring without zero divisors, the initial term of a product of power series is the
product of their initial terms. -/
@[simp]
theorem initialTerm_mul [NoZeroDivisors R] (f g : MvPowerSeries σ R) :
    m.initialTerm (f * g) = m.initialTerm f * m.initialTerm g := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  rcases eq_or_ne g 0 with rfl | hg
  · simp
  exact m.initialTerm_mul_of_mul_initialCoeff_ne_zero <|
    mul_ne_zero (m.initialCoeff_ne_zero_iff.mpr hf) (m.initialCoeff_ne_zero_iff.mpr hg)

/-- Left multiplication by `monomial β c` shifts `m.initialExp f` by `β` whenever
`c * m.initialCoeff f ≠ 0`. -/
theorem initialExp_monomial_mul {β : σ →₀ ℕ} {c : R} {f : MvPowerSeries σ R}
    (h : c * m.initialCoeff f ≠ 0) :
    m.initialExp (MvPowerSeries.monomial β c * f) = β + m.initialExp f := by
  have hm : m.initialCoeff (MvPowerSeries.monomial β c) * m.initialCoeff f ≠ 0 := by
    rwa [m.initialCoeff_monomial]
  rw [m.initialExp_mul_of_mul_initialCoeff_ne_zero hm,
    m.initialExp_monomial_of_ne_zero β (left_ne_zero_of_mul h)]

theorem initialCoeff_monomial_mul {β : σ →₀ ℕ} {c : R} {f : MvPowerSeries σ R}
    (h : c * m.initialCoeff f ≠ 0) :
    m.initialCoeff (MvPowerSeries.monomial β c * f) = c * m.initialCoeff f := by
  have hm : m.initialCoeff (MvPowerSeries.monomial β c) * m.initialCoeff f ≠ 0 := by
    rwa [m.initialCoeff_monomial]
  rw [m.initialCoeff_mul_of_mul_initialCoeff_ne_zero hm, m.initialCoeff_monomial]

theorem initialTerm_monomial_mul {β : σ →₀ ℕ} {c : R} {f : MvPowerSeries σ R}
    (h : c * m.initialCoeff f ≠ 0) :
    m.initialTerm (MvPowerSeries.monomial β c * f) =
      MvPowerSeries.monomial β c * m.initialTerm f := by
  have hm : m.initialCoeff (MvPowerSeries.monomial β c) * m.initialCoeff f ≠ 0 := by
    rwa [m.initialCoeff_monomial]
  rw [m.initialTerm_mul_of_mul_initialCoeff_ne_zero hm, m.initialTerm_monomial]

/-- Right multiplication by `monomial β c` shifts `m.initialExp f` by `β` whenever
`m.initialCoeff f * c ≠ 0`. -/
theorem initialExp_mul_monomial {f : MvPowerSeries σ R} {β : σ →₀ ℕ} {c : R}
    (h : m.initialCoeff f * c ≠ 0) :
    m.initialExp (f * MvPowerSeries.monomial β c) = m.initialExp f + β := by
  have hm : m.initialCoeff f * m.initialCoeff (MvPowerSeries.monomial β c) ≠ 0 := by
    rwa [m.initialCoeff_monomial]
  rw [m.initialExp_mul_of_mul_initialCoeff_ne_zero hm,
    m.initialExp_monomial_of_ne_zero β (right_ne_zero_of_mul h)]

theorem initialCoeff_mul_monomial {f : MvPowerSeries σ R} {β : σ →₀ ℕ} {c : R}
    (h : m.initialCoeff f * c ≠ 0) :
    m.initialCoeff (f * MvPowerSeries.monomial β c) = m.initialCoeff f * c := by
  have hm : m.initialCoeff f * m.initialCoeff (MvPowerSeries.monomial β c) ≠ 0 := by
    rwa [m.initialCoeff_monomial]
  rw [m.initialCoeff_mul_of_mul_initialCoeff_ne_zero hm, m.initialCoeff_monomial]

theorem initialTerm_mul_monomial {f : MvPowerSeries σ R} {β : σ →₀ ℕ} {c : R}
    (h : m.initialCoeff f * c ≠ 0) :
    m.initialTerm (f * MvPowerSeries.monomial β c) =
      m.initialTerm f * MvPowerSeries.monomial β c := by
  have hm : m.initialCoeff f * m.initialCoeff (MvPowerSeries.monomial β c) ≠ 0 := by
    rwa [m.initialCoeff_monomial]
  rw [m.initialTerm_mul_of_mul_initialCoeff_ne_zero hm, m.initialTerm_monomial]

/-- Left multiplication by `monomial β 1` shifts the initial exponent of any nonzero power series
by `β`, without requiring cancellation in `R`. -/
theorem initialExp_monomial_one_mul (β : σ →₀ ℕ) {f : MvPowerSeries σ R} (hf : f ≠ 0) :
    m.initialExp (MvPowerSeries.monomial β (1 : R) * f) = β + m.initialExp f :=
  m.initialExp_monomial_mul (by rw [one_mul]; exact m.initialCoeff_ne_zero_iff.mpr hf)

@[simp]
theorem initialCoeff_monomial_one_mul (β : σ →₀ ℕ) (f : MvPowerSeries σ R) :
    m.initialCoeff (MvPowerSeries.monomial β (1 : R) * f) = m.initialCoeff f := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  · rw [m.initialCoeff_monomial_mul (by rw [one_mul]; exact m.initialCoeff_ne_zero_iff.mpr hf),
      one_mul]

@[simp]
theorem initialTerm_monomial_one_mul (β : σ →₀ ℕ) (f : MvPowerSeries σ R) :
    m.initialTerm (MvPowerSeries.monomial β (1 : R) * f) =
      MvPowerSeries.monomial β (1 : R) * m.initialTerm f := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  · exact m.initialTerm_monomial_mul (by rw [one_mul]; exact m.initialCoeff_ne_zero_iff.mpr hf)

/-- Right multiplication by `monomial β 1` shifts the initial exponent of any nonzero power series
by `β`. -/
theorem initialExp_mul_monomial_one {f : MvPowerSeries σ R} (hf : f ≠ 0) (β : σ →₀ ℕ) :
    m.initialExp (f * MvPowerSeries.monomial β (1 : R)) = m.initialExp f + β :=
  m.initialExp_mul_monomial (by rw [mul_one]; exact m.initialCoeff_ne_zero_iff.mpr hf)

@[simp]
theorem initialCoeff_mul_monomial_one (f : MvPowerSeries σ R) (β : σ →₀ ℕ) :
    m.initialCoeff (f * MvPowerSeries.monomial β (1 : R)) = m.initialCoeff f := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  · rw [m.initialCoeff_mul_monomial (by rw [mul_one]; exact m.initialCoeff_ne_zero_iff.mpr hf),
      mul_one]

@[simp]
theorem initialTerm_mul_monomial_one (f : MvPowerSeries σ R) (β : σ →₀ ℕ) :
    m.initialTerm (f * MvPowerSeries.monomial β (1 : R)) =
      m.initialTerm f * MvPowerSeries.monomial β (1 : R) := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  · exact m.initialTerm_mul_monomial (by rw [mul_one]; exact m.initialCoeff_ne_zero_iff.mpr hf)

theorem initialExp_smul_of_mul_initialCoeff_ne_zero {c : R} {f : MvPowerSeries σ R}
    (h : c * m.initialCoeff f ≠ 0) :
    m.initialExp (c • f) = m.initialExp f := by
  rw [MvPowerSeries.smul_eq_C_mul, ← MvPowerSeries.monomial_zero_eq_C_apply,
    m.initialExp_monomial_mul h, zero_add]

theorem initialCoeff_smul_of_mul_initialCoeff_ne_zero {c : R} {f : MvPowerSeries σ R}
    (h : c * m.initialCoeff f ≠ 0) :
    m.initialCoeff (c • f) = c • m.initialCoeff f := by
  rw [MvPowerSeries.smul_eq_C_mul, ← MvPowerSeries.monomial_zero_eq_C_apply,
    m.initialCoeff_monomial_mul h, smul_eq_mul]

theorem initialTerm_smul_of_mul_initialCoeff_ne_zero {c : R} {f : MvPowerSeries σ R}
    (h : c * m.initialCoeff f ≠ 0) :
    m.initialTerm (c • f) = c • m.initialTerm f := by
  rw [MvPowerSeries.smul_eq_C_mul, ← MvPowerSeries.monomial_zero_eq_C_apply,
    m.initialTerm_monomial_mul h, MvPowerSeries.monomial_zero_eq_C_apply,
    ← MvPowerSeries.smul_eq_C_mul]

/-- Over a semiring without zero divisors, scaling by a nonzero scalar `c` leaves `m.initialExp f`
unchanged. -/
theorem initialExp_smul [NoZeroDivisors R] {c : R} (hc : c ≠ 0) (f : MvPowerSeries σ R) :
    m.initialExp (c • f) = m.initialExp f := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  · exact m.initialExp_smul_of_mul_initialCoeff_ne_zero <|
      mul_ne_zero hc (m.initialCoeff_ne_zero_iff.mpr hf)

@[simp]
theorem initialCoeff_smul [NoZeroDivisors R] (c : R) (f : MvPowerSeries σ R) :
    m.initialCoeff (c • f) = c • m.initialCoeff f := by
  rw [MvPowerSeries.smul_eq_C_mul, m.initialCoeff_mul, m.initialCoeff_C, smul_eq_mul]

@[simp]
theorem initialTerm_smul [NoZeroDivisors R] (c : R) (f : MvPowerSeries σ R) :
    m.initialTerm (c • f) = c • m.initialTerm f := by
  rw [MvPowerSeries.smul_eq_C_mul, m.initialTerm_mul, m.initialTerm_C,
    ← MvPowerSeries.smul_eq_C_mul]

/-- Adding a series of strictly larger initial exponent leaves `m.initialExp` unchanged. -/
theorem initialExp_add_of_lt {f g : MvPowerSeries σ R} (hf : f ≠ 0)
    (hg : g ≠ 0 → m.initialExp f ≺[m] m.initialExp g) :
    m.initialExp (f + g) = m.initialExp f := by
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  refine m.initialExp_eq_of_coeff_ne_zero_of_forall_lt ?_ fun β hβ ↦ ?_
  · rw [map_add, m.coeff_eq_zero_of_lt_initialExp (hg hg0), add_zero]
    exact m.coeff_initialExp_ne_zero hf
  · rw [map_add, m.coeff_eq_zero_of_lt_initialExp hβ,
      m.coeff_eq_zero_of_lt_initialExp (hβ.trans (hg hg0)), add_zero]

theorem initialCoeff_add_of_lt {f g : MvPowerSeries σ R} (hf : f ≠ 0)
    (hg : g ≠ 0 → m.initialExp f ≺[m] m.initialExp g) :
    m.initialCoeff (f + g) = m.initialCoeff f := by
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  rw [initialCoeff_def, m.initialExp_add_of_lt hf hg, map_add,
    m.coeff_eq_zero_of_lt_initialExp (hg hg0), add_zero, ← initialCoeff_def]

theorem initialTerm_add_of_lt {f g : MvPowerSeries σ R} (hf : f ≠ 0)
    (hg : g ≠ 0 → m.initialExp f ≺[m] m.initialExp g) :
    m.initialTerm (f + g) = m.initialTerm f := by
  rw [initialTerm_def, m.initialExp_add_of_lt hf hg, m.initialCoeff_add_of_lt hf hg,
    ← initialTerm_def]

/-- Subtracting the initial term strictly increases `m.initialExp` whenever the difference is
nonzero. -/
theorem lt_initialExp_sub_initialTerm {S : Type*} [Ring S] {f : MvPowerSeries σ S}
    (h : f - m.initialTerm f ≠ 0) :
    m.initialExp f ≺[m] m.initialExp (f - m.initialTerm f) := by
  have hsub (β : σ →₀ ℕ) : MvPowerSeries.coeff β (f - m.initialTerm f) =
      MvPowerSeries.coeff β f -
        MvPowerSeries.coeff β (MvPowerSeries.monomial (m.initialExp f) (m.initialCoeff f)) := by
    rw [map_sub, initialTerm_def]
  have hle : m.initialExp f ≼[m] m.initialExp (f - m.initialTerm f) := by
    by_contra! hlt
    refine m.coeff_initialExp_ne_zero h ?_
    rw [hsub, m.coeff_eq_zero_of_lt_initialExp hlt,
      MvPowerSeries.coeff_monomial_ne (fun heq ↦ hlt.ne (congrArg m.toSyn heq)), sub_zero]
  refine hle.lt_of_ne fun heq ↦ m.coeff_initialExp_ne_zero h ?_
  have hexp : m.initialExp (f - m.initialTerm f) = m.initialExp f := m.toSyn.injective heq.symm
  rw [hsub, hexp, MvPowerSeries.coeff_monomial_same, initialCoeff_def, sub_self]

end InitialExp

/-- For a nonzero power series `f`, the total degree of its `degLex`-initial exponent equals its
`ℕ∞`-valued order `f.order`. -/
theorem degree_initialExp_degLex_eq_order {σ R : Type*} [Semiring R] [LinearOrder σ]
    [WellFoundedGT σ] {f : MvPowerSeries σ R} (hf : f ≠ 0) :
    ((degLex.initialExp f).degree : ℕ∞) = f.order := by
  refine le_antisymm ?_ (MvPowerSeries.order_le (degLex.coeff_initialExp_ne_zero hf))
  refine MvPowerSeries.nat_le_order fun d hd ↦ degLex.coeff_eq_zero_of_lt_initialExp ?_
  rw [degLex_lt_iff, Finsupp.DegLex.lt_iff]
  exact Or.inl hd

section InitialDiagram

variable {σ R : Type*} (m : MonomialOrder σ) [Semiring R]

/-- The diagram of initial exponents `D(I)` of an ideal `I` of `MvPowerSeries σ R` with respect to
a monomial order `m`: the set of initial exponents `m.initialExp f` of nonzero series `f ∈ I`. -/
def initialDiagram (I : Ideal (MvPowerSeries σ R)) : Set (σ →₀ ℕ) :=
  {α | ∃ f ∈ I, f ≠ 0 ∧ m.initialExp f = α}

theorem initialDiagram_def (I : Ideal (MvPowerSeries σ R)) :
    m.initialDiagram I = {α | ∃ f ∈ I, f ≠ 0 ∧ m.initialExp f = α} := (rfl)

theorem mem_initialDiagram_iff {I : Ideal (MvPowerSeries σ R)} {α : σ →₀ ℕ} :
    α ∈ m.initialDiagram I ↔ ∃ f ∈ I, f ≠ 0 ∧ m.initialExp f = α := (Iff.rfl)

theorem mem_initialDiagram_iff_exists_isLeast {I : Ideal (MvPowerSeries σ R)} {α : σ →₀ ℕ} :
    α ∈ m.initialDiagram I ↔ ∃ f ∈ I, IsLeast (m.toSyn '' f.support) (m.toSyn α) := by
  simp_rw [mem_initialDiagram_iff, m.isLeast_toSyn_support_iff_ne_zero_and_initialExp_eq]

theorem initialExp_mem_initialDiagram {I : Ideal (MvPowerSeries σ R)} {f : MvPowerSeries σ R}
    (hfI : f ∈ I) (hf : f ≠ 0) :
    m.initialExp f ∈ m.initialDiagram I :=
  ⟨f, hfI, hf, rfl⟩

/-- Any element of `I` whose support avoids `m.initialDiagram I` is zero. -/
theorem eq_zero_of_mem_of_forall_mem_support_notMem_initialDiagram {I : Ideal (MvPowerSeries σ R)}
    {f : MvPowerSeries σ R} (hfI : f ∈ I)
    (hsupp : ∀ α ∈ f.support, α ∉ m.initialDiagram I) :
    f = 0 := by
  by_contra hf
  exact hsupp (m.initialExp f) (m.initialExp_mem_support hf)
    (m.initialExp_mem_initialDiagram hfI hf)

@[simp]
theorem initialDiagram_bot : m.initialDiagram (⊥ : Ideal (MvPowerSeries σ R)) = ∅ := by
  ext α
  simp [mem_initialDiagram_iff]

@[simp]
theorem initialDiagram_eq_empty_iff {I : Ideal (MvPowerSeries σ R)} :
    m.initialDiagram I = ∅ ↔ I = ⊥ := by
  refine ⟨fun h ↦ (Submodule.eq_bot_iff _).mpr fun f hfI ↦ ?_, fun h ↦ by simp [h]⟩
  by_contra hf0
  have hmem : m.initialExp f ∈ m.initialDiagram I := m.initialExp_mem_initialDiagram hfI hf0
  rw [h] at hmem
  exact Set.notMem_empty _ hmem

@[simp, nontriviality]
theorem initialDiagram_of_subsingleton [Subsingleton R] (I : Ideal (MvPowerSeries σ R)) :
    m.initialDiagram I = ∅ := by
  ext α
  refine ⟨fun ⟨f, _, hf0, _⟩ ↦ False.elim (hf0 ?_), False.elim⟩
  exact MvPowerSeries.ext fun _ ↦ Subsingleton.elim _ _

@[simp]
theorem initialDiagram_top [Nontrivial R] :
    m.initialDiagram (⊤ : Ideal (MvPowerSeries σ R)) = Set.univ := by
  ext α
  refine ⟨fun _ ↦ trivial, fun _ ↦ ⟨MvPowerSeries.monomial α 1, trivial, ?_, ?_⟩⟩
  · intro h
    simpa using congrArg (MvPowerSeries.coeff α) h
  · exact m.initialExp_monomial_of_ne_zero α one_ne_zero

theorem initialDiagram_mono {I J : Ideal (MvPowerSeries σ R)} (h : I ≤ J) :
    m.initialDiagram I ⊆ m.initialDiagram J :=
  fun _ ⟨f, hfI, hf0, hexp⟩ ↦ ⟨f, h hfI, hf0, hexp⟩

/-- Over a division ring, `0` lies in the initial diagram of `I` if and only if `I = ⊤`. -/
@[simp]
theorem zero_mem_initialDiagram_iff_eq_top {K : Type*} [DivisionRing K]
    {I : Ideal (MvPowerSeries σ K)} :
    0 ∈ m.initialDiagram I ↔ I = ⊤ := by
  refine ⟨fun ⟨f, hfI, hf0, hexp⟩ ↦ ?_, fun h ↦ by simp [h]⟩
  have hc : MvPowerSeries.constantCoeff f ≠ 0 := by
    rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, ← hexp]
    exact m.coeff_initialExp_ne_zero hf0
  exact Ideal.eq_top_of_isUnit_mem I hfI (MvPowerSeries.isUnit_iff_constantCoeff.mpr hc.isUnit)

/-- The initial diagram `m.initialDiagram I` is closed under addition by arbitrary exponents. -/
theorem add_mem_initialDiagram {I : Ideal (MvPowerSeries σ R)} {α : σ →₀ ℕ}
    (hα : α ∈ m.initialDiagram I) (β : σ →₀ ℕ) :
    α + β ∈ m.initialDiagram I := by
  obtain ⟨f, hfI, hf0, rfl⟩ := hα
  refine ⟨MvPowerSeries.monomial β 1 * f, I.mul_mem_left _ hfI, ?_, ?_⟩
  · intro h
    have hc := congrArg (MvPowerSeries.coeff (β + m.initialExp f)) h
    rw [MvPowerSeries.coeff_add_monomial_mul, one_mul, map_zero] at hc
    exact m.coeff_initialExp_ne_zero hf0 hc
  · rw [m.initialExp_monomial_one_mul β hf0, add_comm]

/-- The initial diagram `m.initialDiagram I` is an upper set for the componentwise order on
`σ →₀ ℕ`. -/
theorem isUpperSet_initialDiagram (I : Ideal (MvPowerSeries σ R)) :
    IsUpperSet (m.initialDiagram I) := by
  intro α γ hle hα
  rw [← add_tsub_cancel_of_le hle]
  exact m.add_mem_initialDiagram hα (γ - α)

/-- Every exponent in `m.initialDiagram I` lies above a minimal element of `m.initialDiagram I`. -/
theorem exists_minimal_initialDiagram_le {I : Ideal (MvPowerSeries σ R)} {γ : σ →₀ ℕ}
    (hγ : γ ∈ m.initialDiagram I) :
    ∃ α ≤ γ, Minimal (· ∈ m.initialDiagram I) α :=
  exists_minimal_le_of_wellFoundedLT (· ∈ m.initialDiagram I) γ hγ

/-- `m.initialDiagram I` is the union of the cones `Set.Ici α` of its minimal vertices. -/
theorem initialDiagram_eq_biUnion_minimal (I : Ideal (MvPowerSeries σ R)) :
    m.initialDiagram I = ⋃ α ∈ {α | Minimal (· ∈ m.initialDiagram I) α}, Set.Ici α := by
  ext γ
  simp only [Set.mem_iUnion, Set.mem_ofPred_eq, Set.mem_Ici]
  exact ⟨fun hγ ↦ by
    obtain ⟨α, hle, hmin⟩ := m.exists_minimal_initialDiagram_le hγ
    exact ⟨α, hmin, hle⟩,
    fun ⟨α, hmin, hle⟩ ↦ m.isUpperSet_initialDiagram I hle hmin.prop⟩

/-- For finitely many variables `σ`, the minimal vertices of `m.initialDiagram I` form a finite
set by Dickson's lemma. -/
theorem finite_minimal_initialDiagram [Finite σ] (I : Ideal (MvPowerSeries σ R)) :
    {α : σ →₀ ℕ | Minimal (· ∈ m.initialDiagram I) α}.Finite :=
  WellQuasiOrderedLE.finite_of_isAntichain (setOfPred_minimal_antichain _)

/-- For finitely many variables `σ`, the `Finset` of minimal vertices of `m.initialDiagram I`
in the componentwise order on `σ →₀ ℕ`. -/
noncomputable def initialDiagramVertices [Finite σ] (I : Ideal (MvPowerSeries σ R)) :
    Finset (σ →₀ ℕ) :=
  (m.finite_minimal_initialDiagram I).toFinset

@[simp]
theorem mem_initialDiagramVertices_iff [Finite σ] {I : Ideal (MvPowerSeries σ R)} {α : σ →₀ ℕ} :
    α ∈ m.initialDiagramVertices I ↔ Minimal (· ∈ m.initialDiagram I) α :=
  Set.Finite.mem_toFinset _

theorem initialDiagramVertices_subset [Finite σ] (I : Ideal (MvPowerSeries σ R)) :
    (m.initialDiagramVertices I : Set (σ →₀ ℕ)) ⊆ m.initialDiagram I :=
  fun _ hα ↦ (m.mem_initialDiagramVertices_iff.mp hα).prop

/-- For finitely many variables `σ`, `m.initialDiagramVertices I` is an antichain for the
componentwise order on `σ →₀ ℕ`. -/
theorem isAntichain_initialDiagramVertices [Finite σ] (I : Ideal (MvPowerSeries σ R)) :
    IsAntichain (· ≤ ·) (m.initialDiagramVertices I : Set (σ →₀ ℕ)) := by
  intro α hα β hβ
  exact setOfPred_minimal_antichain _ (m.mem_initialDiagramVertices_iff.mp hα)
    (m.mem_initialDiagramVertices_iff.mp hβ)

/-- For finitely many variables `σ`, an exponent belongs to `m.initialDiagram I` if and only if it
lies above some vertex in `m.initialDiagramVertices I`. -/
theorem mem_initialDiagram_iff_exists_mem_initialDiagramVertices_le [Finite σ]
    {I : Ideal (MvPowerSeries σ R)} {γ : σ →₀ ℕ} :
    γ ∈ m.initialDiagram I ↔ ∃ α ∈ m.initialDiagramVertices I, α ≤ γ := by
  conv_lhs => rw [m.initialDiagram_eq_biUnion_minimal]
  simp

/-- For finitely many variables `σ`, `m.initialDiagram I` decomposes as the finite union of the
cones `Set.Ici α` over `α ∈ m.initialDiagramVertices I`. -/
theorem initialDiagram_eq_biUnion_initialDiagramVertices [Finite σ]
    (I : Ideal (MvPowerSeries σ R)) :
    m.initialDiagram I = ⋃ α ∈ m.initialDiagramVertices I, Set.Ici α := by
  ext γ
  simp only [Set.mem_iUnion, Set.mem_Ici, exists_prop,
    m.mem_initialDiagram_iff_exists_mem_initialDiagramVertices_le]

@[simp]
theorem initialDiagramVertices_bot [Finite σ] :
    m.initialDiagramVertices (⊥ : Ideal (MvPowerSeries σ R)) = ∅ := by
  ext α
  simp [Minimal]

@[simp]
theorem initialDiagramVertices_eq_empty_iff [Finite σ] {I : Ideal (MvPowerSeries σ R)} :
    m.initialDiagramVertices I = ∅ ↔ I = ⊥ := by
  refine ⟨fun h ↦ ?_, fun h ↦ by simp [h]⟩
  rw [← m.initialDiagram_eq_empty_iff, m.initialDiagram_eq_biUnion_initialDiagramVertices, h]
  simp

@[simp]
theorem initialDiagramVertices_top [Finite σ] [Nontrivial R] :
    m.initialDiagramVertices (⊤ : Ideal (MvPowerSeries σ R)) = {0} := by
  ext α
  simp only [m.mem_initialDiagramVertices_iff, m.initialDiagram_top, Minimal, Set.mem_univ,
    true_and, forall_true_left, Finset.mem_singleton]
  exact ⟨fun h ↦ le_zero_iff.mp (h _root_.zero_le), fun h _ _ ↦ h ▸ _root_.zero_le⟩

/-- Over a nontrivial semiring, the initial diagram of an ideal generated by pure monomials
`monomial α 1` (`α ∈ S`) is the union of the cones `Set.Ici α` for `α ∈ S`. -/
theorem initialDiagram_span_monomial [Nontrivial R] (S : Set (σ →₀ ℕ)) :
    m.initialDiagram (Ideal.span ((fun α ↦ MvPowerSeries.monomial α (1 : R)) '' S)) =
      ⋃ α ∈ S, Set.Ici α := by
  ext γ
  simp only [Set.mem_iUnion, Set.mem_Ici, exists_prop]
  refine ⟨fun ⟨f, hfI, hf0, hexp⟩ ↦ ?_, fun ⟨α, hαS, hle⟩ ↦ ?_⟩
  · subst hexp
    exact MvPowerSeries.exists_le_of_mem_span_monomial_of_coeff_ne_zero hfI
      (m.coeff_initialExp_ne_zero hf0)
  · have hmem : MvPowerSeries.monomial γ (1 : R) ∈
        Ideal.span ((fun α ↦ MvPowerSeries.monomial α (1 : R)) '' S) := by
      have hmul : MvPowerSeries.monomial (γ - α) (1 : R) * MvPowerSeries.monomial α (1 : R) =
          MvPowerSeries.monomial γ (1 : R) := by
        rw [MvPowerSeries.monomial_mul_monomial, tsub_add_cancel_of_le hle, one_mul]
      rw [← hmul]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨α, hαS, rfl⟩)
    refine ⟨MvPowerSeries.monomial γ 1, hmem, ?_, m.initialExp_monomial_of_ne_zero γ one_ne_zero⟩
    intro h
    simpa using congrArg (MvPowerSeries.coeff γ) h

/-- Over a nontrivial semiring, if `S` is an antichain of exponents, the minimal elements of the
initial diagram of the ideal generated by pure monomials `monomial β 1` (`β ∈ S`) are precisely the
elements of `S`. -/
theorem minimal_mem_initialDiagram_span_monomial_iff [Nontrivial R] {S : Set (σ →₀ ℕ)}
    (hS : IsAntichain (· ≤ ·) S) {α : σ →₀ ℕ} :
    Minimal (· ∈ m.initialDiagram
      (Ideal.span ((fun β ↦ MvPowerSeries.monomial β (1 : R)) '' S))) α ↔ α ∈ S := by
  rw [m.initialDiagram_span_monomial, ← coe_upperClosure]
  exact hS.minimal_mem_upperClosure_iff_mem

/-- For finitely many variables `σ` over a nontrivial semiring, if `s` is a finite antichain of
exponents, then the minimal diagram vertices of the ideal generated by pure monomials
`monomial β 1` (`β ∈ s`) are precisely `s`. -/
theorem initialDiagramVertices_span_monomial [Finite σ] [Nontrivial R] {s : Finset (σ →₀ ℕ)}
    (hs : IsAntichain (· ≤ ·) (s : Set (σ →₀ ℕ))) :
    m.initialDiagramVertices
      (Ideal.span ((fun β ↦ MvPowerSeries.monomial β (1 : R)) '' (s : Set (σ →₀ ℕ)))) = s := by
  ext α
  rw [m.mem_initialDiagramVertices_iff, m.minimal_mem_initialDiagram_span_monomial_iff hs,
    Finset.mem_coe]

end InitialDiagram

/-- Over a nontrivial commutative semiring, the initial diagram of the `k`-th power of the ideal of
variables in `MvPowerSeries σ S` consists of all exponents of total degree at least `k`. -/
theorem initialDiagram_pow_span_range_X {σ S : Type*} (m : MonomialOrder σ) [CommSemiring S]
    [Nontrivial S] (k : ℕ) :
    m.initialDiagram (Ideal.span (Set.range (MvPowerSeries.X (σ := σ) (R := S))) ^ k) =
      {α : σ →₀ ℕ | k ≤ α.degree} := by
  rw [MvPowerSeries.pow_span_range_X_eq_span_monomial, m.initialDiagram_span_monomial]
  ext γ
  simp only [Set.mem_iUnion, Set.mem_ofPred_eq, Set.mem_Ici, exists_prop]
  exact ⟨fun ⟨α, hdeg, hle⟩ ↦ hdeg ▸ Finsupp.degree_mono hle,
    fun hle ↦ let ⟨α, hle', hdeg⟩ := Finsupp.exists_le_degree_eq γ k hle; ⟨α, hdeg, hle'⟩⟩

/-- Over a field `K` in finitely many variables, the initial diagram of the `k`-th power of the
maximal ideal of `MvPowerSeries σ K` consists of all exponents of total degree at least `k`. -/
@[simp]
theorem initialDiagram_maximalIdeal_pow {σ K : Type*} (m : MonomialOrder σ) [Field K] [Finite σ]
    (k : ℕ) :
    m.initialDiagram (IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ k) =
      {α : σ →₀ ℕ | k ≤ α.degree} := by
  rw [MvPowerSeries.maximalIdeal_eq_span_range_X, m.initialDiagram_pow_span_range_X]

/-- Under graded lexicographic order in finitely many variables over a field `K`, truncating an
ideal `I` modulo `maximalIdeal ^ k` adds `{α | k ≤ α.degree}` to its initial diagram:
`degLex.initialDiagram (I ⊔ 𝔪 ^ k) = degLex.initialDiagram I ∪ {α | k ≤ α.degree}`. -/
@[simp]
theorem initialDiagram_degLex_sup_maximalIdeal_pow {σ K : Type*} [LinearOrder σ] [Finite σ]
    [Field K] (I : Ideal (MvPowerSeries σ K)) (k : ℕ) :
    degLex.initialDiagram (I ⊔ IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ k) =
      degLex.initialDiagram I ∪ {α : σ →₀ ℕ | k ≤ α.degree} := by
  refine Set.Subset.antisymm (fun α hα ↦ ?_) (Set.union_subset
    (degLex.initialDiagram_mono le_sup_left) ?_)
  · by_cases hk : k ≤ α.degree
    · exact Or.inr hk
    · left
      obtain ⟨h, hh, hh0, rfl⟩ := degLex.mem_initialDiagram_iff.mp hα
      obtain ⟨f, hfI, g, hg, rfl⟩ := Submodule.mem_sup.mp hh
      have hg_zero : ∀ γ, γ ≼[degLex] degLex.initialExp (f + g) → MvPowerSeries.coeff γ g = 0 :=
        fun γ hγ ↦ MvPowerSeries.mem_maximalIdeal_pow_iff.mp hg γ
          ((Finsupp.DegLex.monotone_degree hγ).trans_lt (not_le.mp hk))
      have hf_coeff : MvPowerSeries.coeff (degLex.initialExp (f + g)) f ≠ 0 := by
        have hne := degLex.coeff_initialExp_ne_zero hh0
        rwa [map_add, hg_zero _ le_rfl, add_zero] at hne
      have hf0 : f ≠ 0 := fun hf0 ↦ hf_coeff (by simp [hf0])
      refine ⟨f, hfI, hf0, degLex.initialExp_eq_of_coeff_ne_zero_of_forall_lt hf_coeff
        fun γ hγ ↦ ?_⟩
      have hfg := degLex.coeff_eq_zero_of_lt_initialExp hγ
      rwa [map_add, hg_zero γ hγ.le, add_zero] at hfg
  · rw [← degLex.initialDiagram_maximalIdeal_pow (K := K) k]
    exact degLex.initialDiagram_mono le_sup_right

end MonomialOrder

section Examples

open MonomialOrder

/-- Under graded lexicographic order, `X i + X j ^ 2` has initial exponent `single i 1` because
total degree `1` precedes total degree `2` regardless of how `i` and `j` compare. -/
example {σ R : Type*} [LinearOrder σ] [WellFoundedGT σ] [Semiring R] [Nontrivial R] (i j : σ) :
    degLex.initialExp (MvPowerSeries.X i + MvPowerSeries.X j ^ 2 : MvPowerSeries σ R) =
      Finsupp.single i 1 := by
  rw [degLex.initialExp_add_of_lt (MvPowerSeries.X_ne_zero i)]
  · exact degLex.initialExp_X i
  · intro _
    rw [degLex.initialExp_X, degLex.initialExp_X_pow, degLex_lt_iff, Finsupp.DegLex.lt_iff]
    exact Or.inl (by simp)

/-- In `R⟦X₀, X₁⟧` over a nontrivial semiring, the monomial ideal `(X₀², X₀ X₁)` has minimal
diagram vertices `{(2, 0), (1, 1)}`. -/
example {R : Type*} [Semiring R] [Nontrivial R] (m : MonomialOrder (Fin 2)) :
    m.initialDiagramVertices
      (Ideal.span {MvPowerSeries.X 0 ^ 2,
        MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) R)) =
      {Finsupp.single 0 2, Finsupp.single 0 1 + Finsupp.single 1 1} := by
  let s : Finset (Fin 2 →₀ ℕ) := {Finsupp.single 0 2, Finsupp.single 0 1 + Finsupp.single 1 1}
  have himg : ((fun β ↦ MvPowerSeries.monomial β (1 : R)) '' (s : Set (Fin 2 →₀ ℕ))) =
      {MvPowerSeries.X 0 ^ 2, MvPowerSeries.X 0 * MvPowerSeries.X 1} := by
    simp only [s, Finset.coe_insert, Finset.coe_singleton, Set.image_pair]
    rw [MvPowerSeries.X_pow_eq, MvPowerSeries.X_def 0, MvPowerSeries.X_def 1,
      MvPowerSeries.monomial_mul_monomial, one_mul]
  have hs : IsAntichain (· ≤ ·) (s : Set (Fin 2 →₀ ℕ)) := by
    rintro a ha b hb hne hle
    simp only [s, Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
      Set.mem_singleton_iff] at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    · exact hne rfl
    · have h0 := hle 0
      simp at h0
    · have h1 := hle 1
      simp at h1
    · exact hne rfl
  rw [← himg]
  exact m.initialDiagramVertices_span_monomial hs

end Examples
