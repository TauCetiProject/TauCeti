namespace MonomialOrder

section ComplementEquiv

variable {σ R : Type*} (ord : MonomialOrder σ) [Semiring R]

open scoped Classical in
private noncomputable def seriesOfComplement (I : Ideal (MvPowerSeries σ R))
    (g : {α : σ →₀ ℕ // α ∉ ord.initialDiagram I} → R) : MvPowerSeries σ R :=
  fun β ↦ if h : β ∉ ord.initialDiagram I then g ⟨β, h⟩ else 0

open scoped Classical in
private theorem coeff_seriesOfComplement (I : Ideal (MvPowerSeries σ R))
    (g : {α : σ →₀ ℕ // α ∉ ord.initialDiagram I} → R) (β : σ →₀ ℕ) :
    MvPowerSeries.coeff β (ord.seriesOfComplement I g) =
      if h : β ∉ ord.initialDiagram I then g ⟨β, h⟩ else 0 := (rfl)

/-- The `R`-submodule `ord.complementSubmodule I` of power series supported outside
`ord.initialDiagram I` is `R`-linearly isomorphic to the function space
`{α : σ →₀ ℕ // α ∉ ord.initialDiagram I} → R`. -/
noncomputable def complementSubmoduleEquivFun (I : Ideal (MvPowerSeries σ R)) :
    ord.complementSubmodule I ≃ₗ[R] ({α : σ →₀ ℕ // α ∉ ord.initialDiagram I} → R) where
  toFun f α := MvPowerSeries.coeff α.1 f.1
  map_add' f g := funext fun α ↦ map_add (MvPowerSeries.coeff α.1) f.1 g.1
  map_smul' c f := funext fun α ↦ by simp
  invFun g := ⟨ord.seriesOfComplement I g,
    ord.mem_complementSubmodule_iff.mpr fun β hβ hD ↦ by
      rw [MvPowerSeries.mem_support, ord.coeff_seriesOfComplement] at hβ
      simp [hD] at hβ⟩
  left_inv f := Subtype.ext <| MvPowerSeries.ext fun β ↦ by
    rw [Subtype.coe_mk, ord.coeff_seriesOfComplement]
    split_ifs with h
    · symm
      by_contra hne
      exact absurd h (ord.mem_complementSubmodule_iff.mp f.2 β (MvPowerSeries.mem_support.mpr hne))
    · rfl
  right_inv g := funext fun ⟨α, hα⟩ ↦ by
    dsimp only
    rw [ord.coeff_seriesOfComplement]
    simp [hα]

@[simp]
theorem complementSubmoduleEquivFun_apply (I : Ideal (MvPowerSeries σ R))
    (f : ord.complementSubmodule I) (α : {α : σ →₀ ℕ // α ∉ ord.initialDiagram I}) :
    ord.complementSubmoduleEquivFun I f α = MvPowerSeries.coeff α.1 f.1 := (rfl)

end ComplementEquiv

section MaximalIdealDiagram

variable {σ K : Type*} [Field K]

private theorem X_mem_maximalIdeal (i : σ) :
    (MvPowerSeries.X i : MvPowerSeries σ K) ∈ IsLocalRing.maximalIdeal (MvPowerSeries σ K) := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
    MvPowerSeries.constantCoeff_X]
  exact not_isUnit_zero

private theorem monomial_one_mem_maximalIdeal_pow (α : σ →₀ ℕ) :
    MvPowerSeries.monomial α (1 : K) ∈
      IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ α.degree := by
  refine Finsupp.induction_linear α ?_ ?_ ?_
  · simp
  · intro β γ hβ hγ
    rw [map_add, pow_add, ← one_mul (1 : K), ← MvPowerSeries.monomial_mul_monomial]
    exact Ideal.mul_mem_mul hβ hγ
  · intro i m
    rw [← MvPowerSeries.X_pow_eq, Finsupp.degree_single]
    exact Ideal.pow_mem_pow (X_mem_maximalIdeal i) m

private theorem natCast_le_order_of_mem_maximalIdeal_pow {g : MvPowerSeries σ K} {k : ℕ}
    (hg : g ∈ IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ k) :
    (k : ℕ∞) ≤ g.order := by
  induction k generalizing g with
  | zero => simp
  | succ k ih =>
    rw [pow_succ] at hg
    refine Submodule.mul_induction_on hg (fun a ha b hb ↦ ?_) (fun x y hx hy ↦ ?_)
    · have hb0 : MvPowerSeries.constantCoeff b = 0 := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          MvPowerSeries.isUnit_iff_constantCoeff, isUnit_iff_ne_zero, not_not] at hb
        exact hb
      have hb1 : (1 : ℕ∞) ≤ b.order := MvPowerSeries.one_le_order_iff_constCoeff_eq_zero.mpr hb0
      rw [Nat.cast_add, Nat.cast_one]
      exact (add_le_add (ih ha) hb1).trans MvPowerSeries.le_order_mul
    · exact MvPowerSeries.le_order_add hx hy

/-- Over a field `K`, adjoining the `k`-th power of the maximal ideal of `MvPowerSeries σ K` to an
ideal `I` adjoins all exponents of total degree at least `k` to `degLex.initialDiagram I`. -/
theorem initialDiagram_degLex_sup_maximalIdeal_pow [LinearOrder σ] [WellFoundedGT σ]
    (I : Ideal (MvPowerSeries σ K)) (k : ℕ) :
    degLex.initialDiagram (I ⊔ IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ k) =
      degLex.initialDiagram I ∪ {α : σ →₀ ℕ | k ≤ α.degree} := by
  ext α
  simp only [Set.mem_union, Set.mem_ofPred_eq, degLex.mem_initialDiagram_iff]
  refine ⟨fun ⟨h, hh, hh0, hexp⟩ ↦ ?_, ?_⟩
  · rcases le_or_gt k α.degree with hk | hk
    · exact Or.inr hk
    · obtain ⟨f, hf, g, hg, rfl⟩ := Submodule.mem_sup.mp hh
      have hgord : (k : ℕ∞) ≤ g.order := natCast_le_order_of_mem_maximalIdeal_pow hg
      have hg0 : ∀ β : σ →₀ ℕ, β ≼[degLex] α → MvPowerSeries.coeff β g = 0 := fun β hβα ↦ by
        have hdeg : β.degree ≤ α.degree := by
          by_contra! hgt
          exact hβα.not_gt (degLex_lt_iff.mpr (Finsupp.DegLex.lt_iff.mpr (Or.inl hgt)))
        exact MvPowerSeries.coeff_of_lt_order
          ((Nat.cast_lt.mpr (hdeg.trans_lt hk)).trans_le hgord)
      have hfα : MvPowerSeries.coeff α f ≠ 0 := by
        have hhα : MvPowerSeries.coeff α (f + g) ≠ 0 := by
          rw [← hexp]
          exact degLex.coeff_initialExp_ne_zero hh0
        rwa [map_add, hg0 α le_rfl, add_zero] at hhα
      have hf0 : f ≠ 0 := fun h0 ↦ hfα (by simp [h0])
      refine Or.inl ⟨f, hf, hf0, degLex.initialExp_eq_of_coeff_ne_zero_of_forall_lt hfα ?_⟩
      intro β hβlt
      have hhβ : MvPowerSeries.coeff β (f + g) = 0 :=
        degLex.coeff_eq_zero_of_lt_initialExp (hexp ▸ hβlt)
      rwa [map_add, hg0 β hβlt.le, add_zero] at hhβ
  · rintro (⟨f, hf, hf0, hexp⟩ | hk)
    · exact ⟨f, Ideal.mem_sup_left hf, hf0, hexp⟩
    · have hmem : MvPowerSeries.monomial α (1 : K) ∈
          I ⊔ IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ k :=
        Ideal.mem_sup_right (Ideal.pow_le_pow_right hk (monomial_one_mem_maximalIdeal_pow α))
      refine ⟨MvPowerSeries.monomial α 1, hmem, ?_,
        degLex.initialExp_monomial_of_ne_zero α one_ne_zero⟩
      intro h0
      simpa using congrArg (MvPowerSeries.coeff α) h0

end MaximalIdealDiagram

end MonomialOrder

namespace MvPowerSeries

/-- Over a field `K`, the length of any `(MvPowerSeries σ K)`-module `M` equals its `K`-vector
space length, because the residue field of `MvPowerSeries σ K` is canonically `K`. -/
theorem length_eq_length {σ K M : Type*} [Field K] [AddCommGroup M] [Module K M]
    [Module (MvPowerSeries σ K) M] [IsScalarTower K (MvPowerSeries σ K) M] :
    Module.length (MvPowerSeries σ K) M = Module.length K M := by
  have hsurj : Function.Surjective
      (algebraMap K (IsLocalRing.ResidueField (MvPowerSeries σ K))) := fun y ↦ by
    obtain ⟨f, rfl⟩ := IsLocalRing.residue_surjective y
    refine ⟨constantCoeff f, ?_⟩
    rw [IsScalarTower.algebraMap_apply K (MvPowerSeries σ K)
      (IsLocalRing.ResidueField (MvPowerSeries σ K)), ← c_eq_algebraMap,
      IsLocalRing.ResidueField.algebraMap_eq, ← sub_eq_zero, ← map_sub,
      IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      isUnit_iff_constantCoeff, map_sub, constantCoeff_C, sub_self]
    exact not_isUnit_zero
  have hres : Module.length (IsLocalRing.ResidueField K)
      (IsLocalRing.ResidueField (MvPowerSeries σ K)) = 1 := by
    rw [← Module.length_eq_of_surjective (M := IsLocalRing.ResidueField (MvPowerSeries σ K))
        (IsLocalRing.residue_surjective (R := K)),
      Module.length_eq_of_surjective (M := IsLocalRing.ResidueField (MvPowerSeries σ K)) hsurj,
      Module.length_eq_one]
  symm
  rw [IsLocalRing.length_restrictScalars K (MvPowerSeries σ K) M, hres, mul_one]

end MvPowerSeries

namespace TauCeti

section DegreeFinset

open scoped Classical in
private noncomputable def finsuppDegreeLeFinset (σ : Type*) [Fintype σ] (n : ℕ) :
    Finset (σ →₀ ℕ) :=
  (Finset.range (n + 1)).biUnion Finset.univ.finsuppAntidiag

open scoped Classical in
private theorem mem_finsuppDegreeLeFinset {σ : Type*} [Fintype σ] {n : ℕ} {α : σ →₀ ℕ} :
    α ∈ finsuppDegreeLeFinset σ n ↔ α.degree ≤ n := by
  simp only [finsuppDegreeLeFinset, Finset.mem_biUnion, Finset.mem_range,
    Finset.mem_finsuppAntidiag', Finset.subset_univ, and_true]
  exact ⟨fun ⟨d, hlt, hsum⟩ ↦ by
      have hdeg : α.degree = d := hsum
      exact hdeg ▸ Nat.le_of_lt_succ hlt,
    fun hle ↦ ⟨α.degree, Nat.lt_succ_of_le hle, rfl⟩⟩

open scoped Classical in
private theorem card_finsuppDegreeLeFinset (σ : Type*) [Fintype σ] (n : ℕ) :
    (finsuppDegreeLeFinset σ n).card = (Fintype.card σ + n).choose (Fintype.card σ) := by
  rw [finsuppDegreeLeFinset, Finset.card_biUnion]
  · simp_rw [Finset.card_finsuppAntidiag_nat_eq_multichoose, Finset.card_univ]
    rw [Nat.sum_range_multichoose, add_comm]
  · intro d₁ _ d₂ _ hne
    refine Finset.disjoint_left.mpr fun α h₁ h₂ ↦ hne ?_
    rw [Finset.mem_finsuppAntidiag'] at h₁ h₂
    exact h₁.1.symm.trans h₂.1

private theorem natCard_degree_le (σ : Type*) [Finite σ] (n : ℕ) :
    Nat.card {α : σ →₀ ℕ // α.degree ≤ n} = (Nat.card σ + n).choose (Nat.card σ) := by
  classical
  cases nonempty_fintype σ
  have hcongr : {α : σ →₀ ℕ // α.degree ≤ n} ≃ {α : σ →₀ ℕ // α ∈ finsuppDegreeLeFinset σ n} :=
    Equiv.subtypeEquivRight fun _ ↦ mem_finsuppDegreeLeFinset.symm
  rw [Nat.card_congr hcongr, Nat.card_eq_fintype_card, Fintype.card_coe,
    card_finsuppDegreeLeFinset, Nat.card_eq_fintype_card]

end DegreeFinset

section FormalHilbertSamuel

/-- **Bierstone–Milman Corollary 3.20**: over a field `K` in finitely many linearly ordered
variables `σ`, `localQuotientHilbertSamuel (MvPowerSeries σ K) I n` counts the exponents of total
degree at most `n` outside `degLex.initialDiagram I`. -/
theorem localQuotientHilbertSamuel_mvPowerSeries {σ K : Type*} [Field K] [Finite σ]
    [LinearOrder σ] (I : Ideal (MvPowerSeries σ K)) (n : ℕ) :
    localQuotientHilbertSamuel (MvPowerSeries σ K) I n =
      (Nat.card {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ MonomialOrder.degLex.initialDiagram I} : ℕ∞) := by
  set J : Ideal (MvPowerSeries σ K) := I ⊔ IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ (n + 1)
  have hmem : ∀ α : σ →₀ ℕ,
      α ∉ MonomialOrder.degLex.initialDiagram J ↔
        α.degree ≤ n ∧ α ∉ MonomialOrder.degLex.initialDiagram I := by
    intro α
    rw [MonomialOrder.initialDiagram_degLex_sup_maximalIdeal_pow]
    simp only [Set.mem_union, Set.mem_ofPred_eq, not_or, not_le, Nat.lt_succ_iff, and_comm]
  let idxEquiv : {α : σ →₀ ℕ // α ∉ MonomialOrder.degLex.initialDiagram J} ≃
      {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ MonomialOrder.degLex.initialDiagram I} :=
    Equiv.subtypeEquivRight hmem
  have hsub : {α : σ →₀ ℕ | α.degree ≤ n ∧ α ∉ MonomialOrder.degLex.initialDiagram I} ⊆
      {α : σ →₀ ℕ | α.degree ≤ n} := fun _ hα ↦ hα.1
  have hfin : Finite {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ MonomialOrder.degLex.initialDiagram I} :=
    ((Finsupp.finite_of_degree_le n).subset hsub).to_subtype
  set d := Nat.card {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ MonomialOrder.degLex.initialDiagram I}
  let finEquiv : {α : σ →₀ ℕ // α ∉ MonomialOrder.degLex.initialDiagram J} ≃ Fin d :=
    idxEquiv.trans (Finite.equivFin _)
  let linEquiv : (MvPowerSeries σ K ⧸ J) ≃ₗ[K] (Fin d → K) :=
    ((MonomialOrder.degLex.quotientEquivComplementSubmodule J).trans
      (MonomialOrder.degLex.complementSubmoduleEquivFun J)).trans
      (LinearEquiv.funCongrLeft K K finEquiv.symm)
  rw [localQuotientHilbertSamuel_def, MvPowerSeries.length_eq_length (K := K),
    linEquiv.length_eq, Module.length_eq_finrank, Module.finrank_fin_fun]

/-- Two ideals of `MvPowerSeries σ K` with the same graded lexicographic initial diagram have the
same Hilbert–Samuel function. -/
theorem localQuotientHilbertSamuel_eq_of_initialDiagram_eq {σ K : Type*} [Field K] [Finite σ]
    [LinearOrder σ] {I J : Ideal (MvPowerSeries σ K)}
    (h : MonomialOrder.degLex.initialDiagram I = MonomialOrder.degLex.initialDiagram J) :
    localQuotientHilbertSamuel (MvPowerSeries σ K) I =
      localQuotientHilbertSamuel (MvPowerSeries σ K) J := by
  ext n
  rw [localQuotientHilbertSamuel_mvPowerSeries, localQuotientHilbertSamuel_mvPowerSeries, h]

/-- For the zero ideal in `MvPowerSeries σ K` (`[Finite σ]`), the Hilbert–Samuel value at degree
`n` is `((Nat.card σ + n).choose (Nat.card σ) : ℕ∞)`. -/
@[simp]
theorem localQuotientHilbertSamuel_mvPowerSeries_bot (σ K : Type*) [Field K] [Finite σ] (n : ℕ) :
    localQuotientHilbertSamuel (MvPowerSeries σ K) ⊥ n =
      ((Nat.card σ + n).choose (Nat.card σ) : ℕ∞) := by
  let _ : LinearOrder σ := LinearOrder.lift' (Finite.equivFin σ) (Finite.equivFin σ).injective
  rw [localQuotientHilbertSamuel_mvPowerSeries]
  have hcongr : {α : σ →₀ ℕ //
      α.degree ≤ n ∧ α ∉ MonomialOrder.degLex.initialDiagram (⊥ : Ideal (MvPowerSeries σ K))} ≃
      {α : σ →₀ ℕ // α.degree ≤ n} :=
    Equiv.subtypeEquivRight fun _ ↦ by simp
  rw [Nat.card_congr hcongr, natCard_degree_le]

/-- In `MvPowerSeries (Fin d) K`, the Hilbert–Samuel value of `⊥` at degree `n` is
`((d + n).choose d : ℕ∞)`. -/
theorem localQuotientHilbertSamuel_mvPowerSeries_fin_bot (K : Type*) [Field K] (d n : ℕ) :
    localQuotientHilbertSamuel (MvPowerSeries (Fin d) K) ⊥ n = ((d + n).choose d : ℕ∞) := by
  rw [localQuotientHilbertSamuel_mvPowerSeries_bot, Nat.card_fin]

/-- For any subset `S : Set σ` of finitely many variables, the Hilbert–Samuel value of the
coordinate ideal `Ideal.span (MvPowerSeries.X '' S)` at degree `n` is
`((Nat.card ↥Sᶜ + n).choose (Nat.card ↥Sᶜ) : ℕ∞)`. -/
theorem localQuotientHilbertSamuel_mvPowerSeries_span_image_X {σ : Type*} (K : Type*) [Field K]
    [Finite σ] (S : Set σ) (n : ℕ) :
    localQuotientHilbertSamuel (MvPowerSeries σ K) (Ideal.span (MvPowerSeries.X '' S)) n =
      ((Nat.card ↥Sᶜ + n).choose (Nat.card ↥Sᶜ) : ℕ∞) := by
  classical
  let _ : LinearOrder σ := LinearOrder.lift' (Finite.equivFin σ) (Finite.equivFin σ).injective
  rw [localQuotientHilbertSamuel_mvPowerSeries]
  have hspan : (MvPowerSeries.X '' S : Set (MvPowerSeries σ K)) =
      (fun α ↦ MvPowerSeries.monomial α (1 : K)) '' ((fun i ↦ Finsupp.single i 1) '' S) := by
    ext f
    simp [MvPowerSeries.X_def]
  rw [hspan, MonomialOrder.degLex.initialDiagram_span_monomial]
  have hnotMem : ∀ α : σ →₀ ℕ,
      (α ∉ ⋃ β ∈ (fun i ↦ Finsupp.single i 1) '' S, Set.Ici β) ↔ ↑α.support ⊆ Sᶜ := fun α ↦ by
    simp only [Set.mem_iUnion, Set.mem_image, Set.mem_Ici, not_exists,
      Set.subset_compl_iff_disjoint_right, Set.disjoint_left, Finset.mem_coe,
      Finsupp.mem_support_iff]
    refine ⟨fun h i hi hS ↦ hi ?_, fun h i ⟨j, hj, hjEq⟩ hle ↦ ?_⟩
    · by_contra hne
      exact h (Finsupp.single i 1) ⟨i, hS, rfl⟩ fun k ↦ by
        rcases eq_or_ne k i with rfl | hki
        · simpa using Nat.one_le_iff_ne_zero.mpr hne
        · simp [hki]
    · subst hjEq
      have h0 : α j = 0 := not_not.mp fun hne ↦ h hne hj
      exact Nat.not_succ_le_zero 0 (by simpa [h0] using hle j)
  let e₁ : {α : σ →₀ ℕ //
      α.degree ≤ n ∧ α ∉ ⋃ β ∈ (fun i ↦ Finsupp.single i 1) '' S, Set.Ici β} ≃
      {α : {α : σ →₀ ℕ // ↑α.support ⊆ Sᶜ} // α.1.degree ≤ n} :=
    (Equiv.subtypeEquivRight fun α ↦ and_congr_right fun _ ↦ hnotMem α).trans
      ((Equiv.subtypeEquivRight fun _ ↦ and_comm).trans
        (Equiv.subtypeSubtypeEquivSubtypeInter _ _).symm)
  let e₂ : {α : {α : σ →₀ ℕ // ↑α.support ⊆ Sᶜ} // α.1.degree ≤ n} ≃
      {β : ↥Sᶜ →₀ ℕ // β.degree ≤ n} :=
    Equiv.subtypeEquiv (Finsupp.restrictSupportEquiv Sᶜ ℕ) fun α ↦ by
      have hdeg : ((Finsupp.restrictSupportEquiv Sᶜ ℕ).symm
          (Finsupp.restrictSupportEquiv Sᶜ ℕ α)).1.degree =
          (Finsupp.restrictSupportEquiv Sᶜ ℕ α).degree := by
        rw [Finsupp.restrictSupportEquiv_symm_apply_coe, Finsupp.extendDomain_eq_embDomain_subtype,
          Finsupp.embDomain_eq_mapDomain, Finsupp.degree_mapDomain]
      rw [Equiv.symm_apply_apply] at hdeg
      rw [hdeg]
  rw [Nat.card_congr (e₁.trans e₂), natCard_degree_le]

/-- For any variable `i : σ` in finitely many variables, the Hilbert–Samuel value of
`Ideal.span {MvPowerSeries.X i}` at degree `n` is
`((Nat.card σ - 1 + n).choose (Nat.card σ - 1) : ℕ∞)`. -/
@[simp]
theorem localQuotientHilbertSamuel_mvPowerSeries_span_X {σ : Type*} (K : Type*) [Field K]
    [Finite σ] (i : σ) (n : ℕ) :
    localQuotientHilbertSamuel (MvPowerSeries σ K) (Ideal.span {MvPowerSeries.X i}) n =
      ((Nat.card σ - 1 + n).choose (Nat.card σ - 1) : ℕ∞) := by
  have himg : ({MvPowerSeries.X i} : Set (MvPowerSeries σ K)) = MvPowerSeries.X '' {i} :=
    (Set.image_singleton).symm
  rw [himg, localQuotientHilbertSamuel_mvPowerSeries_span_image_X, Nat.card_coe_set_eq,
    Set.ncard_compl, Set.ncard_singleton]

/-- In the univariate power series ring `MvPowerSeries (Fin 1) K`, the Hilbert–Samuel value of
`Ideal.span {X 0 ^ k}` at degree `n` equals `(↑(min (n + 1) k) : ℕ∞)`. -/
theorem localQuotientHilbertSamuel_mvPowerSeries_span_X_pow (K : Type*) [Field K] (k n : ℕ) :
    localQuotientHilbertSamuel (MvPowerSeries (Fin 1) K)
        (Ideal.span {MvPowerSeries.X (0 : Fin 1) ^ k}) n = ↑(min (n + 1) k) := by
  rw [localQuotientHilbertSamuel_mvPowerSeries]
  have hspan : ({MvPowerSeries.X (0 : Fin 1) ^ k} : Set (MvPowerSeries (Fin 1) K)) =
      (fun α ↦ MvPowerSeries.monomial α (1 : K)) '' {Finsupp.single (0 : Fin 1) k} := by
    simp [MvPowerSeries.X_pow_eq]
  rw [hspan, MonomialOrder.degLex.initialDiagram_span_monomial, Set.biUnion_singleton]
  have hbij : {α : Fin 1 →₀ ℕ // α.degree ≤ n ∧ α ∉ Set.Ici (Finsupp.single 0 k)} ≃
      Fin (min (n + 1) k) :=
    { toFun := fun α ↦ ⟨α.1 0, by
        have hdeg : α.1.degree = α.1 0 := by simp [Finsupp.degree_eq_sum]
        have hnot : ¬ k ≤ α.1 0 := by
          intro hle
          refine α.2.2 fun i ↦ ?_
          fin_cases i
          simpa using hle
        omega⟩
      invFun := fun i ↦ ⟨Finsupp.single 0 i.1, by
        refine ⟨by simp [Nat.lt_succ_iff.mp (lt_of_lt_of_le i.2 (min_le_left _ _))], fun hle ↦ ?_⟩
        exact (lt_of_lt_of_le i.2 (min_le_right _ _)).not_ge (by simpa using hle 0)⟩
      left_inv := fun ⟨α, _⟩ ↦ Subtype.ext <| Finsupp.ext fun i ↦ by
        fin_cases i
        simp
      right_inv := fun i ↦ Fin.ext (by simp) }
  rw [Nat.card_congr hbij, Nat.card_fin]

end FormalHilbertSamuel

section Stabilization

private noncomputable def diagramHilbert {σ : Type*} (D : Set (σ →₀ ℕ)) (n : ℕ) : ℕ :=
  Nat.card {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ D}

private theorem diagramHilbert_anti {σ : Type*} [Finite σ] {D₁ D₂ : Set (σ →₀ ℕ)}
    (h : D₁ ⊆ D₂) (n : ℕ) :
    diagramHilbert D₂ n ≤ diagramHilbert D₁ n := by
  have hsub : {α : σ →₀ ℕ | α.degree ≤ n ∧ α ∉ D₁} ⊆ {α : σ →₀ ℕ | α.degree ≤ n} :=
    fun _ hα ↦ hα.1
  have : Finite {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ D₁} :=
    ((Finsupp.finite_of_degree_le n).subset hsub).to_subtype
  exact Nat.card_le_card_of_injective
    (fun α ↦ (⟨α.1, α.2.1, fun h₁ ↦ α.2.2 (h h₁)⟩ : {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ D₁}))
    (fun _ _ hEq ↦ Subtype.ext (Subtype.mk.inj hEq))

private theorem diagramHilbert_congr_of_degree_le {σ : Type*} {D₁ D₂ : Set (σ →₀ ℕ)} {n m : ℕ}
    (hmn : m ≤ n) (h : ∀ α : σ →₀ ℕ, α.degree ≤ n → (α ∈ D₁ ↔ α ∈ D₂)) :
    diagramHilbert D₁ m = diagramHilbert D₂ m :=
  Nat.card_congr <| Equiv.subtypeEquivRight fun α ↦
    and_congr_right fun hdeg ↦ not_congr (h α (hdeg.trans hmn))

/-- No sequence of upward-closed subsets `D j ⊆ (σ →₀ ℕ)` in finitely many variables can have
strictly lexicographically decreasing degree-bounded complement counts. -/
private theorem not_strictAnti_toLex_diagramHilbert {σ : Type*} [Finite σ]
    {D : ℕ → Set (σ →₀ ℕ)} (hD : ∀ j, IsUpperSet (D j)) :
    ¬ StrictAnti (fun j ↦ toLex (diagramHilbert (D j))) := by
  intro hanti
  let 𝓤 : Ultrafilter ℕ := Ultrafilter.of Filter.atTop
  let Dlim : Set (σ →₀ ℕ) := {α | ∀ᶠ j in (𝓤 : Filter ℕ), α ∈ D j}
  have hmem_iff : ∀ α : σ →₀ ℕ, ∀ᶠ j in (𝓤 : Filter ℕ), α ∈ D j ↔ α ∈ Dlim := fun α ↦ by
    rcases 𝓤.mem_or_compl_mem {j | α ∈ D j} with hmem | hcompl
    · exact Filter.Eventually.mono hmem fun _ hj ↦ ⟨fun _ ↦ hmem, fun _ ↦ hj⟩
    · have hnot : α ∉ Dlim := Ultrafilter.compl_mem_iff_notMem.mp hcompl
      exact Filter.Eventually.mono hcompl fun _ hj ↦ ⟨fun h ↦ False.elim (hj h),
        fun h ↦ False.elim (hnot h)⟩
  have hfin_deg : ∀ n : ℕ, ∀ᶠ j in (𝓤 : Filter ℕ),
      ∀ m ≤ n, diagramHilbert (D j) m = diagramHilbert Dlim m := fun n ↦ by
    have hall : ∀ᶠ j in (𝓤 : Filter ℕ), ∀ α ∈ {α : σ →₀ ℕ | α.degree ≤ n},
        α ∈ D j ↔ α ∈ Dlim :=
      (Finsupp.finite_of_degree_le n).eventually_all.mpr fun α _ ↦ hmem_iff α
    exact hall.mono fun j hj m hmn ↦ diagramHilbert_congr_of_degree_le hmn hj
  have hVfin : {α : σ →₀ ℕ | Minimal (· ∈ Dlim) α}.Finite :=
    WellQuasiOrderedLE.finite_of_isAntichain (setOfPred_minimal_antichain _)
  have hVev : ∀ᶠ j in (𝓤 : Filter ℕ), ∀ v ∈ {α : σ →₀ ℕ | Minimal (· ∈ Dlim) α}, v ∈ D j :=
    hVfin.eventually_all.mpr fun v hv ↦ hv.prop
  obtain ⟨j₀, hj₀⟩ := hVev.exists
  have hsub : Dlim ⊆ D j₀ := fun γ hγ ↦ by
    obtain ⟨v, hvle, hvmin⟩ := exists_minimal_le_of_wellFoundedLT (· ∈ Dlim) γ hγ
    exact hD j₀ hvle (hj₀ v hvmin)
  have hle₀ : toLex (diagramHilbert (D j₀)) ≤ toLex (diagramHilbert Dlim) :=
    Pi.toLex_monotone (diagramHilbert_anti hsub)
  have hlt₁ : toLex (diagramHilbert (D (j₀ + 1))) < toLex (diagramHilbert Dlim) :=
    (hanti (Nat.lt_succ_self j₀)).trans_le hle₀
  obtain ⟨n₁, heq₁, hlt_n₁⟩ := hlt₁
  have hgt_ev : ∀ᶠ j in (𝓤 : Filter ℕ), j₀ + 1 < j :=
    Ultrafilter.of_le Filter.atTop (Filter.eventually_gt_atTop (j₀ + 1))
  obtain ⟨j₂, hj₂_eq, hj₂_gt⟩ := (hfin_deg n₁ |>.and hgt_ev).exists
  have hlt₂ : toLex (diagramHilbert (D (j₀ + 1))) < toLex (diagramHilbert (D j₂)) :=
    ⟨n₁, fun m hm ↦ (heq₁ m hm).trans (hj₂_eq m hm.le).symm,
      lt_of_lt_of_eq hlt_n₁ (hj₂_eq n₁ le_rfl).symm⟩
  exact (hanti hj₂_gt).not_gt hlt₂

/-- For finitely many variables `σ`, any sequence of upward-closed subsets `D : ℕ → Set (σ →₀ ℕ)`
whose degree-bounded complement counts are lexicographically nonincreasing is eventually constant
in those counts. -/
theorem exists_forall_ge_card_degree_le_notMem_eq_of_isUpperSet {σ : Type*} [Finite σ]
    (D : ℕ → Set (σ →₀ ℕ)) (hD : ∀ j, IsUpperSet (D j))
    (hlex : ∀ j, toLex (fun n ↦ Nat.card {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ D (j + 1)}) ≤
      toLex (fun n ↦ Nat.card {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ D j})) :
    ∃ j₀, ∀ j, j₀ ≤ j →
      (fun n ↦ Nat.card {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ D j}) =
        (fun n ↦ Nat.card {α : σ →₀ ℕ // α.degree ≤ n ∧ α ∉ D j₀}) := by
  have hanti : Antitone (fun j ↦ toLex (diagramHilbert (D j))) :=
    antitone_nat_of_succ_le hlex
  by_contra! hnot
  have hstep : ∀ j₀, ∃ j, j₀ < j ∧
      toLex (diagramHilbert (D j)) < toLex (diagramHilbert (D j₀)) := fun j₀ ↦ by
    obtain ⟨j, hjle, hjne⟩ := hnot j₀
    have hjlt : j₀ < j := lt_of_le_of_ne hjle fun hEq ↦ hjne (hEq ▸ rfl)
    exact ⟨j, hjlt, lt_of_le_of_ne (hanti hjle) (toLex_inj.ne.mpr hjne)⟩
  let next (j : ℕ) : ℕ := Classical.choose (hstep j)
  have hnext : ∀ j, toLex (diagramHilbert (D (next j))) < toLex (diagramHilbert (D j)) :=
    fun j ↦ (Classical.choose_spec (hstep j)).2
  let subseq (k : ℕ) : ℕ := next^[k] 0
  have hstrict : StrictAnti (fun k ↦ toLex (diagramHilbert (D (subseq k)))) :=
    strictAnti_nat_of_succ_lt fun k ↦ by
      dsimp only [subseq]
      rw [Function.iterate_succ_apply']
      exact hnext (subseq k)
  exact not_strictAnti_toLex_diagramHilbert (fun k ↦ hD (subseq k)) hstrict

/-- **Lexicographic Hilbert–Samuel stabilization** over `MvPowerSeries σ K` (`[Finite σ]`): every
lexicographically nonincreasing sequence of Hilbert–Samuel functions realized by ideals in
`MvPowerSeries σ K` is eventually constant (Bierstone–Milman 1989, Theorem 5.2.1). -/
theorem exists_forall_ge_localQuotientHilbertSamuel_eq_of_lex {σ K : Type*} [Field K] [Finite σ]
    (I : ℕ → Ideal (MvPowerSeries σ K))
    (h : ∀ j, localQuotientHilbertSamuel (MvPowerSeries σ K) (I (j + 1)) =
        localQuotientHilbertSamuel (MvPowerSeries σ K) (I j) ∨
      Pi.Lex (· < ·) (· < ·)
        (localQuotientHilbertSamuel (MvPowerSeries σ K) (I (j + 1)))
        (localQuotientHilbertSamuel (MvPowerSeries σ K) (I j))) :
    ∃ j₀, ∀ j, j₀ ≤ j →
      localQuotientHilbertSamuel (MvPowerSeries σ K) (I j) =
        localQuotientHilbertSamuel (MvPowerSeries σ K) (I j₀) := by
  let _ : LinearOrder σ := LinearOrder.lift' (Finite.equivFin σ) (Finite.equivFin σ).injective
  let D : ℕ → Set (σ →₀ ℕ) := fun j ↦ MonomialOrder.degLex.initialDiagram (I j)
  have hval : ∀ j n, localQuotientHilbertSamuel (MvPowerSeries σ K) (I j) n =
      (diagramHilbert (D j) n : ℕ∞) := fun j n ↦
    localQuotientHilbertSamuel_mvPowerSeries (I j) n
  have hlex : ∀ j, toLex (diagramHilbert (D (j + 1))) ≤ toLex (diagramHilbert (D j)) := fun j ↦ by
    rcases h j with heq | ⟨m, hprev, hltm⟩
    · refine le_of_eq (toLex_inj.mpr (funext fun n ↦ ?_))
      exact Nat.cast_inj.mp ((hval (j + 1) n).symm.trans ((congr_fun heq n).trans (hval j n)))
    · refine le_of_lt ⟨m, fun k hk ↦ ?_, ?_⟩
      · exact Nat.cast_inj.mp ((hval (j + 1) k).symm.trans ((hprev k hk).trans (hval j k)))
      · exact Nat.cast_lt.mp ((hval (j + 1) m).symm ▸ (hval j m).symm ▸ hltm)
  obtain ⟨j₀, hj₀⟩ := exists_forall_ge_card_degree_le_notMem_eq_of_isUpperSet D
    (fun j ↦ MonomialOrder.degLex.isUpperSet_initialDiagram (I j)) hlex
  refine ⟨j₀, fun j hj ↦ funext fun n ↦ ?_⟩
  rw [hval j n, hval j₀ n]
  exact congrArg Nat.cast (congr_fun (hj₀ j hj) n)

/-- **Lexicographic Hilbert–Samuel stabilization** in `MvPowerSeries (Fin n) K`: every
lexicographically nonincreasing sequence of realized Hilbert–Samuel functions stabilizes. -/
theorem hsLexStabilization (K : Type*) [Field K] (n : ℕ)
    (I : ℕ → Ideal (MvPowerSeries (Fin n) K))
    (h : ∀ j, localQuotientHilbertSamuel _ (I (j + 1)) = localQuotientHilbertSamuel _ (I j) ∨
      Pi.Lex (· < ·) (· < ·) (localQuotientHilbertSamuel _ (I (j + 1)))
        (localQuotientHilbertSamuel _ (I j))) :
    ∃ j₀, ∀ j, j₀ ≤ j →
      localQuotientHilbertSamuel _ (I j) = localQuotientHilbertSamuel _ (I j₀) :=
  exists_forall_ge_localQuotientHilbertSamuel_eq_of_lex I h

/-- **Pointwise Hilbert–Samuel stabilization** over `MvPowerSeries σ K` (`[Finite σ]`): every
pointwise nonincreasing sequence of Hilbert–Samuel functions realized by ideals in
`MvPowerSeries σ K` is eventually constant. -/
theorem exists_forall_ge_localQuotientHilbertSamuel_eq_of_le {σ K : Type*} [Field K] [Finite σ]
    (I : ℕ → Ideal (MvPowerSeries σ K))
    (h : ∀ j n, localQuotientHilbertSamuel (MvPowerSeries σ K) (I (j + 1)) n ≤
      localQuotientHilbertSamuel (MvPowerSeries σ K) (I j) n) :
    ∃ j₀, ∀ j, j₀ ≤ j →
      localQuotientHilbertSamuel (MvPowerSeries σ K) (I j) =
        localQuotientHilbertSamuel (MvPowerSeries σ K) (I j₀) := by
  refine exists_forall_ge_localQuotientHilbertSamuel_eq_of_lex I fun j ↦ ?_
  rcases eq_or_lt_of_le (Pi.toLex_monotone (h j)) with heq | hlt
  · exact Or.inl (toLex_inj.mp heq)
  · exact Or.inr hlt

/-- **Pointwise Hilbert–Samuel stabilization** in `MvPowerSeries (Fin n) K`. -/
theorem hsPointwiseStabilization (K : Type*) [Field K] (n : ℕ)
    (I : ℕ → Ideal (MvPowerSeries (Fin n) K))
    (h : ∀ j ℓ, localQuotientHilbertSamuel _ (I (j + 1)) ℓ ≤
      localQuotientHilbertSamuel _ (I j) ℓ) :
    ∃ j₀, ∀ j, j₀ ≤ j →
      localQuotientHilbertSamuel _ (I j) = localQuotientHilbertSamuel _ (I j₀) :=
  exists_forall_ge_localQuotientHilbertSamuel_eq_of_le I h

end Stabilization

section Examples

/-- For `K⟦X⟧ ⧸ (X²)`, the Hilbert–Samuel function takes value `1` at `0` and `2` for every
`ℓ ≥ 1`. -/
example (K : Type*) [Field K] :
    localQuotientHilbertSamuel (MvPowerSeries (Fin 1) K)
        (Ideal.span {MvPowerSeries.X 0 ^ 2}) 0 = 1 ∧
      ∀ ℓ, 1 ≤ ℓ →
        localQuotientHilbertSamuel (MvPowerSeries (Fin 1) K)
          (Ideal.span {MvPowerSeries.X 0 ^ 2}) ℓ = 2 := by
  refine ⟨by simp [localQuotientHilbertSamuel_mvPowerSeries_span_X_pow], fun ℓ hℓ ↦ ?_⟩
  rw [localQuotientHilbertSamuel_mvPowerSeries_span_X_pow, min_eq_right (by omega)]
  rfl

/-- For `I_j = (X ^ max (N - j) 1) ⊆ K⟦X⟧`, the Hilbert–Samuel functions decrease in both orders
and stabilize at the constant function `1` of `K⟦X⟧ ⧸ (X)` for `j ≥ N`. -/
example (K : Type*) [Field K] (N : ℕ) :
    let I : ℕ → Ideal (MvPowerSeries (Fin 1) K) :=
      fun j ↦ Ideal.span {MvPowerSeries.X 0 ^ max (N - j) 1}
    (∀ j ℓ, localQuotientHilbertSamuel _ (I (j + 1)) ℓ ≤ localQuotientHilbertSamuel _ (I j) ℓ) ∧
      ∀ j, N ≤ j →
        localQuotientHilbertSamuel _ (I j) =
          localQuotientHilbertSamuel (MvPowerSeries (Fin 1) K)
            (Ideal.span {MvPowerSeries.X (0 : Fin 1)}) := by
  intro I
  refine ⟨fun j ℓ ↦ ?_, fun j hj ↦ ?_⟩
  · simp only [I, localQuotientHilbertSamuel_mvPowerSeries_span_X_pow, Nat.cast_le]
    omega
  · have hmax : max (N - j) 1 = 1 := by omega
    simp [I, hmax]

/-- In `K⟦X₀, X₁⟧`, the length-three fat point `I₁ = 𝔪²` (`H = (1, 3, 3, 3, …)`) and the smooth
line `I₂ = (X₀)` (`H = (1, 2, 3, 4, …)`) have pointwise incomparable Hilbert–Samuel functions, yet
`H(I₂)` is strictly lexicographically smaller than `H(I₁)`. -/
example (K : Type*) [Field K] :
    let I₁ : Ideal (MvPowerSeries (Fin 2) K) :=
      IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ 2
    let I₂ : Ideal (MvPowerSeries (Fin 2) K) := Ideal.span {MvPowerSeries.X 0}
    let H₁ := localQuotientHilbertSamuel (MvPowerSeries (Fin 2) K) I₁
    let H₂ := localQuotientHilbertSamuel (MvPowerSeries (Fin 2) K) I₂
    ¬ (H₂ ≤ H₁) ∧ ¬ (H₁ ≤ H₂) ∧ Pi.Lex (· < ·) (· < ·) H₂ H₁ := by
  intro I₁ I₂ H₁ H₂
  have hH₁ : ∀ n, 1 ≤ n → H₁ n = 3 := fun n hn ↦ by
    have hsup : I₁ ⊔ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ (n + 1) =
        ⊥ ⊔ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ (1 + 1) := by
      rw [bot_sup_eq]
      exact sup_eq_left.mpr (Ideal.pow_le_pow_right (by omega))
    have hlen : H₁ n = localQuotientHilbertSamuel (MvPowerSeries (Fin 2) K) ⊥ 1 := by
      dsimp only [H₁]
      rw [localQuotientHilbertSamuel_def, localQuotientHilbertSamuel_def, hsup]
    rw [hlen, localQuotientHilbertSamuel_mvPowerSeries_fin_bot]
    decide
  have hH₂ : ∀ n, H₂ n = (n + 1 : ℕ∞) := fun n ↦ by
    simp [H₂, I₂, Nat.add_comm 1 n]
  have hH₁_0 : H₁ 0 = 1 :=
    localQuotientHilbertSamuel_zero_of_ne_top
      (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top
        (Ideal.pow_le_self two_ne_zero))
  refine ⟨fun hle ↦ ?_, fun hle ↦ ?_, ⟨1, fun j hj ↦ ?_, ?_⟩⟩
  · have h3 := hle 3
    rw [hH₂ 3, hH₁ 3 (by omega)] at h3
    norm_num at h3
  · have h1 := hle 1
    rw [hH₁ 1 le_rfl, hH₂ 1] at h1
    norm_num at h1
  · obtain rfl : j = 0 := by omega
    rw [hH₂ 0, hH₁_0]
    norm_num
  · rw [hH₂ 1, hH₁ 1 le_rfl]
    norm_num

/-- Realizability as Hilbert–Samuel functions is essential for `hsLexStabilization`: the sequence
`f j ℓ = if j ≤ ℓ then 1 else 0` decreases strictly in the lexicographic order at every step and
never stabilizes, and for `j ≥ 1` none of its terms is realized by any ideal of `A`. -/
example (A : Type*) [CommRing A] [IsLocalRing A] :
    let f : ℕ → ℕ → ℕ∞ := fun j ℓ ↦ if j ≤ ℓ then 1 else 0
    (∀ j, Pi.Lex (· < ·) (· < ·) (f (j + 1)) (f j)) ∧
      (∀ j₀, f (j₀ + 1) ≠ f j₀) ∧
      ∀ j, 1 ≤ j → ∀ I : Ideal A, localQuotientHilbertSamuel A I ≠ f j := by
  intro f
  refine ⟨fun j ↦ ⟨j, fun m hm ↦ ?_, ?_⟩, fun j₀ hEq ↦ ?_, fun j hj I hEq ↦ ?_⟩
  · simp [f, Nat.not_le_of_lt hm, Nat.not_le_of_lt (Nat.lt_succ_of_lt hm)]
  · simp [f]
  · have h := congr_fun hEq j₀
    simp [f] at h
  · have h0 : localQuotientHilbertSamuel A I 0 = 0 := by
      simpa [f, Nat.not_le_of_lt hj] using congr_fun hEq 0
    have htop : I = ⊤ := localQuotientHilbertSamuel_eq_zero_iff.mp h0
    have hj_eq : localQuotientHilbertSamuel A I j = 1 := by
      simpa [f] using congr_fun hEq j
    rw [htop, localQuotientHilbertSamuel_top] at hj_eq
    exact zero_ne_one hj_eq

end Examples

end TauCeti
