/-!
# Monomial ideals and maximal ideals of multivariate power series

If a multivariate formal power series `f : MvPowerSeries σ R` lies in the left ideal generated by a
set of pure monomials `monomial α 1` (`α ∈ S`), then every exponent `γ` with `coeff γ f ≠ 0`
dominates some `α ∈ S` (`MvPowerSeries.exists_le_of_mem_span_monomial_of_coeff_ne_zero`). Unlike in
`MvPolynomial`, the converse can fail when both `σ` and `S` are infinite because `Ideal.span`
consists of finite linear combinations whereas a power series may have infinitely many nonzero
coefficients; however, finiteness of `S` suffices over any semiring
(`MvPowerSeries.mem_span_monomial_iff_of_finite`), as does finite `σ` for arbitrary `S` by Dickson's
lemma (`MvPowerSeries.mem_span_monomial_iff`).

In finitely many variables, the kernel of `constantCoeff` is the ideal spanned by the coordinate
variables (`MvPowerSeries.ker_constantCoeff`), and over a commutative semiring its `k`-th power is
spanned by the pure monomials of total degree `k`
(`MvPowerSeries.pow_span_range_X_eq_span_monomial`) and consists of all power series vanishing
below total degree `k` (`MvPowerSeries.mem_pow_span_range_X_iff`). Over a local commutative ring
`R`, the maximal ideal of `MvPowerSeries σ R` is the preimage of `maximalIdeal R` under
`constantCoeff` (`MvPowerSeries.maximalIdeal_eq_comap_constantCoeff`); over a field `K` in finitely
many variables, it equals `Ideal.span (Set.range X)` and its `k`-th power consists of series of
order at least `k` (`MvPowerSeries.maximalIdeal_eq_span_range_X`,
`MvPowerSeries.mem_maximalIdeal_pow_iff`, `MvPowerSeries.mem_maximalIdeal_pow_iff_le_order`).

## Main results

* `MvPowerSeries.exists_le_of_mem_span_monomial_of_coeff_ne_zero`,
  `MvPowerSeries.mem_span_monomial_iff_of_finite`, `MvPowerSeries.mem_span_monomial_iff`:
  coefficient characterization of monomial ideals in `MvPowerSeries σ R`.
* `MvPowerSeries.ker_constantCoeff`, `MvPowerSeries.pow_span_range_X_eq_span_monomial`,
  `MvPowerSeries.mem_pow_span_range_X_iff`: the ideal of variables and its powers.
* `MvPowerSeries.isLocalHom_constantCoeff`, `MvPowerSeries.isLocalHom_C`,
  `MvPowerSeries.isLocalHom_algebraMap`: locality of `constantCoeff`, `C`, and `algebraMap`.
* `MvPowerSeries.maximalIdeal_eq_comap_constantCoeff`,
  `MvPowerSeries.maximalIdeal_eq_ker_constantCoeff`, `MvPowerSeries.maximalIdeal_eq_span_range_X`,
  `MvPowerSeries.maximalIdeal_pow_eq_span_monomial`, `MvPowerSeries.mem_maximalIdeal_pow_iff`,
  `MvPowerSeries.mem_maximalIdeal_pow_iff_le_order`: the maximal ideal of `MvPowerSeries` and its
  powers.
-/

public section

namespace MvPowerSeries

section Semiring

variable {σ R : Type*} [Semiring R]

/-- If `f` lies in the left ideal generated by pure monomials `monomial α 1` (`α ∈ S`), then every
exponent `γ` with `coeff γ f ≠ 0` dominates some `α ∈ S`. -/
theorem exists_le_of_mem_span_monomial_of_coeff_ne_zero {S : Set (σ →₀ ℕ)} {f : MvPowerSeries σ R}
    (hf : f ∈ Ideal.span ((fun α ↦ monomial α (1 : R)) '' S)) {γ : σ →₀ ℕ}
    (hγ : coeff γ f ≠ 0) : ∃ α ∈ S, α ≤ γ := by
  classical
  refine Submodule.span_induction (p := fun f _ ↦ ∀ γ, coeff γ f ≠ 0 → ∃ α ∈ S, α ≤ γ)
    ?_ ?_ ?_ ?_ hf γ hγ
  · rintro _ ⟨α, hαS, rfl⟩ γ hγ
    exact ⟨α, hαS, (eq_of_coeff_monomial_ne_zero hγ).ge⟩
  · simp
  · intro g₁ g₂ _ _ ih₁ ih₂ γ hγ
    rw [map_add] at hγ
    by_cases h₁ : coeff γ g₁ = 0
    · rw [h₁, zero_add] at hγ
      exact ih₂ γ hγ
    · exact ih₁ γ h₁
  · intro r g _ ih γ hγ
    rw [smul_eq_mul, coeff_mul] at hγ
    obtain ⟨p, hp, hpne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hγ
    rw [Finset.mem_antidiagonal] at hp
    obtain ⟨α, hαS, hle⟩ := ih p.2 (right_ne_zero_of_mul hpne)
    exact ⟨α, hαS, hle.trans (hp ▸ le_add_left le_rfl)⟩

private theorem mem_span_monomial_finset {s : Finset (σ →₀ ℕ)} {f : MvPowerSeries σ R}
    (hf : ∀ γ, coeff γ f ≠ 0 → ∃ α ∈ s, α ≤ γ) :
    f ∈ Ideal.span ((fun α ↦ monomial α (1 : R)) '' (s : Set (σ →₀ ℕ))) := by
  classical
  induction s using Finset.induction_on generalizing f with
  | empty =>
    have hf0 : f = 0 := ext fun γ ↦ by
      by_contra hne
      obtain ⟨_, hmem, _⟩ := hf γ hne
      exact Finset.notMem_empty _ hmem
    simp [hf0]
  | insert a s ha ih =>
    let q : MvPowerSeries σ R :=
      fun δ ↦ if ∀ b ∈ s, ¬ b ≤ δ + a then coeff (δ + a) f else 0
    let r : MvPowerSeries σ R :=
      fun γ ↦ if ∃ b ∈ s, b ≤ γ then coeff γ f else 0
    have hcoeff_q (δ : σ →₀ ℕ) :
        coeff δ q = if ∀ b ∈ s, ¬ b ≤ δ + a then coeff (δ + a) f else 0 := rfl
    have hcoeff_r (γ : σ →₀ ℕ) :
        coeff γ r = if ∃ b ∈ s, b ≤ γ then coeff γ f else 0 := rfl
    have hf_eq : f = q * monomial a (1 : R) + r := by
      ext γ
      rw [map_add, coeff_mul_monomial, hcoeff_r]
      by_cases hs : ∃ b ∈ s, b ≤ γ
      · rw [ite_eq_left hs]
        split_ifs with haγ
        · rw [hcoeff_q, ite_eq_right (by simpa [tsub_add_cancel_of_le haγ] using hs), zero_mul,
            zero_add]
        · exact (zero_add _).symm
      · rw [ite_eq_right hs, add_zero]
        by_cases haγ : a ≤ γ
        · rw [ite_eq_left haγ, mul_one, hcoeff_q,
            ite_eq_left (by simpa [tsub_add_cancel_of_le haγ] using hs),
            tsub_add_cancel_of_le haγ]
        · rw [ite_eq_right haγ]
          by_contra hne
          obtain ⟨b, hb, hbγ⟩ := hf γ hne
          rcases Finset.mem_insert.mp hb with rfl | hbs
          · exact haγ hbγ
          · exact hs ⟨b, hbs, hbγ⟩
    have hr_mem : r ∈ Ideal.span ((fun α ↦ monomial α (1 : R)) '' (s : Set (σ →₀ ℕ))) := by
      refine ih fun γ hne ↦ ?_
      rw [hcoeff_r] at hne
      by_contra hnot
      exact hne (ite_eq_right hnot)
    rw [hf_eq, Finset.coe_insert, Set.image_insert_eq]
    exact add_mem
      (Ideal.mul_mem_left _ q (Ideal.subset_span (Set.mem_insert _ _)))
      (Ideal.span_mono (Set.subset_insert _ _) hr_mem)

/-- For a finite set `S` of exponents, `f` lies in the left ideal generated by pure monomials
`monomial α 1` (`α ∈ S`) if and only if every exponent `γ` with `coeff γ f ≠ 0` dominates some
`α ∈ S`. -/
theorem mem_span_monomial_iff_of_finite {S : Set (σ →₀ ℕ)} (hS : S.Finite)
    {f : MvPowerSeries σ R} :
    f ∈ Ideal.span ((fun α ↦ monomial α (1 : R)) '' S) ↔
      ∀ γ, coeff γ f ≠ 0 → ∃ α ∈ S, α ≤ γ := by
  refine ⟨fun hf _ ↦ exists_le_of_mem_span_monomial_of_coeff_ne_zero hf, fun hf ↦ ?_⟩
  simpa only [Set.Finite.coe_toFinset] using
    mem_span_monomial_finset (s := hS.toFinset) fun γ hγ ↦ by
      obtain ⟨α, hαS, hle⟩ := hf γ hγ
      exact ⟨α, hS.mem_toFinset.mpr hαS, hle⟩

/-- In finitely many variables `σ`, `f` lies in the left ideal generated by pure monomials
`monomial α 1` (`α ∈ S`) if and only if every exponent `γ` with `coeff γ f ≠ 0` dominates some
`α ∈ S`. -/
theorem mem_span_monomial_iff [Finite σ] {S : Set (σ →₀ ℕ)} {f : MvPowerSeries σ R} :
    f ∈ Ideal.span ((fun α ↦ monomial α (1 : R)) '' S) ↔
      ∀ γ, coeff γ f ≠ 0 → ∃ α ∈ S, α ≤ γ := by
  refine ⟨fun hf _ ↦ exists_le_of_mem_span_monomial_of_coeff_ne_zero hf, fun hf ↦ ?_⟩
  let M : Set (σ →₀ ℕ) := {α | Minimal (· ∈ S) α}
  have hMfin : M.Finite := WellQuasiOrderedLE.finite_of_isAntichain (setOfPred_minimal_antichain _)
  have hMS : M ⊆ S := fun _ hα ↦ hα.prop
  refine Ideal.span_mono (Set.image_mono hMS)
    ((mem_span_monomial_iff_of_finite hMfin).mpr fun γ hγ ↦ ?_)
  obtain ⟨α, hαS, hle⟩ := hf γ hγ
  obtain ⟨β, hβα, hβM⟩ := exists_minimal_le_of_wellFoundedLT (· ∈ S) α hαS
  exact ⟨β, hβM, hβα.trans hle⟩

/-- In finitely many variables, the kernel of `constantCoeff` is the left ideal generated by all
coordinate variables. -/
theorem ker_constantCoeff [Finite σ] :
    RingHom.ker (constantCoeff (σ := σ) (R := R)) = Ideal.span (Set.range X) := by
  have hrange : (Set.range (X (σ := σ) (R := R))) =
      (fun α ↦ monomial α (1 : R)) '' Set.range (fun i : σ ↦ Finsupp.single i 1) := by
    ext g
    simp [X_def]
  ext f
  rw [RingHom.mem_ker, ← coeff_zero_eq_constantCoeff_apply, hrange, mem_span_monomial_iff]
  refine ⟨fun h0 γ hγ ↦ ?_, fun h ↦ ?_⟩
  · have hγ0 : γ ≠ 0 := fun heq ↦ hγ (heq ▸ h0)
    obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.mpr hγ0
    refine ⟨Finsupp.single i 1, ⟨i, rfl⟩, ?_⟩
    rw [Finsupp.single_le_iff]
    exact Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi)
  · by_contra hne
    obtain ⟨_, ⟨i, rfl⟩, hle⟩ := h 0 hne
    have h1 := hle i
    simp at h1

end Semiring

section CommSemiring

variable {σ R : Type*} [CommSemiring R]

/-- Over a commutative semiring, the `k`-th power of the ideal generated by all variables in
`MvPowerSeries σ R` is generated by the pure monomials `monomial α 1` of total degree `k`. -/
theorem pow_span_range_X_eq_span_monomial (k : ℕ) :
    Ideal.span (Set.range (X (σ := σ) (R := R))) ^ k =
      Ideal.span ((fun α ↦ monomial α (1 : R)) '' {α : σ →₀ ℕ | α.degree = k}) := by
  let φ : MvPolynomial σ R →+* MvPowerSeries σ R := MvPolynomial.coeToMvPowerSeries.ringHom
  have hX : (MvPolynomial.idealOfVars σ R).map φ = Ideal.span (Set.range X) := by
    rw [MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp]
    simp [φ, Function.comp_def]
  rw [← hX, ← Ideal.map_pow, MvPolynomial.pow_idealOfVars_eq_span, Ideal.map_span,
    Set.image_image]
  congr 1
  ext f
  simp [φ, MvPolynomial.coe_monomial]

/-- In finitely many variables over a commutative semiring, `f` belongs to the `k`-th power of the
ideal of variables if and only if all coefficients of total degree strictly below `k` vanish. -/
theorem mem_pow_span_range_X_iff [Finite σ] {k : ℕ} {f : MvPowerSeries σ R} :
    f ∈ Ideal.span (Set.range (X (σ := σ) (R := R))) ^ k ↔
      ∀ α : σ →₀ ℕ, α.degree < k → coeff α f = 0 := by
  rw [pow_span_range_X_eq_span_monomial, mem_span_monomial_iff]
  have hex (γ : σ →₀ ℕ) : (∃ α ∈ {α : σ →₀ ℕ | α.degree = k}, α ≤ γ) ↔ k ≤ γ.degree :=
    ⟨fun ⟨α, hdeg, hle⟩ ↦ hdeg ▸ Finsupp.degree_mono hle,
      fun hle ↦ let ⟨α, hle', hdeg⟩ := Finsupp.exists_le_degree_eq γ k hle; ⟨α, hdeg, hle'⟩⟩
  simp_rw [hex]
  exact ⟨fun h α hlt ↦ by_contra fun hne ↦ (h α hne).not_gt hlt,
    fun h α hne ↦ not_lt.mp fun hlt ↦ hne (h α hlt)⟩

end CommSemiring

section LocalRing

/-- `constantCoeff : MvPowerSeries σ R →+* R` is a local homomorphism. -/
instance isLocalHom_constantCoeff {σ R : Type*} [Ring R] :
    IsLocalHom (constantCoeff (σ := σ) (R := R)) :=
  ⟨fun _ ↦ isUnit_iff_constantCoeff.mpr⟩

/-- `C : R →+* MvPowerSeries σ R` is a local homomorphism. -/
instance isLocalHom_C {σ R : Type*} [Ring R] : IsLocalHom (C (σ := σ) (R := R)) :=
  ⟨fun a ha ↦ by simpa only [constantCoeff_C] using isUnit_iff_constantCoeff.mp ha⟩

instance isLocalHom_algebraMap {σ R A : Type*} [CommSemiring R] [Ring A] [Algebra R A]
    [IsLocalHom (algebraMap R A)] :
    IsLocalHom (algebraMap R (MvPowerSeries σ A)) where
  map_nonunit r hr := by
    rw [algebraMap_apply] at hr
    exact isUnit_of_map_unit (algebraMap R A) r (isUnit_of_map_unit C _ hr)

/-- Over a local commutative ring `R`, the maximal ideal of `MvPowerSeries σ R` is the preimage of
`maximalIdeal R` under `constantCoeff`. -/
theorem maximalIdeal_eq_comap_constantCoeff {σ R : Type*} [CommRing R] [IsLocalRing R] :
    IsLocalRing.maximalIdeal (MvPowerSeries σ R) =
      (IsLocalRing.maximalIdeal R).comap constantCoeff := by
  ext f
  simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    isUnit_iff_constantCoeff]

/-- Over a field `K`, the maximal ideal of `MvPowerSeries σ K` is the kernel of `constantCoeff`. -/
theorem maximalIdeal_eq_ker_constantCoeff {σ K : Type*} [Field K] :
    IsLocalRing.maximalIdeal (MvPowerSeries σ K) = RingHom.ker constantCoeff := by
  rw [maximalIdeal_eq_comap_constantCoeff, IsLocalRing.maximalIdeal_eq_bot,
    RingHom.ker_eq_comap_bot]

/-- Over a field `K`, a power series belongs to `maximalIdeal (MvPowerSeries σ K)` if and only if
its constant coefficient vanishes. -/
theorem mem_maximalIdeal_iff_constantCoeff_eq_zero {σ K : Type*} [Field K]
    {f : MvPowerSeries σ K} :
    f ∈ IsLocalRing.maximalIdeal (MvPowerSeries σ K) ↔ constantCoeff f = 0 := by
  rw [maximalIdeal_eq_ker_constantCoeff, RingHom.mem_ker]

/-- Over a field `K` in finitely many variables, the maximal ideal of `MvPowerSeries σ K` is
generated by the coordinate variables `X i`. -/
theorem maximalIdeal_eq_span_range_X {σ K : Type*} [Field K] [Finite σ] :
    IsLocalRing.maximalIdeal (MvPowerSeries σ K) = Ideal.span (Set.range X) := by
  rw [maximalIdeal_eq_ker_constantCoeff, ker_constantCoeff]

/-- Over a field `K` in finitely many variables, the `k`-th power of the maximal ideal of
`MvPowerSeries σ K` is generated by the pure monomials `monomial α 1` of total degree `k`. -/
theorem maximalIdeal_pow_eq_span_monomial {σ K : Type*} [Field K] [Finite σ] (k : ℕ) :
    IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ k =
      Ideal.span ((fun α ↦ monomial α (1 : K)) '' {α : σ →₀ ℕ | α.degree = k}) := by
  rw [maximalIdeal_eq_span_range_X, pow_span_range_X_eq_span_monomial]

/-- Over a field `K` in finitely many variables, `f` lies in the `k`-th power of the maximal ideal
if and only if every coefficient of total degree `< k` vanishes. -/
theorem mem_maximalIdeal_pow_iff {σ K : Type*} [Field K] [Finite σ] {k : ℕ}
    {f : MvPowerSeries σ K} :
    f ∈ IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ k ↔
      ∀ α : σ →₀ ℕ, α.degree < k → coeff α f = 0 := by
  rw [maximalIdeal_eq_span_range_X, mem_pow_span_range_X_iff]

/-- Over a field `K` in finitely many variables, `f` lies in the `k`-th power of the maximal ideal
if and only if `(k : ℕ∞) ≤ f.order`. -/
theorem mem_maximalIdeal_pow_iff_le_order {σ K : Type*} [Field K] [Finite σ] {k : ℕ}
    {f : MvPowerSeries σ K} :
    f ∈ IsLocalRing.maximalIdeal (MvPowerSeries σ K) ^ k ↔ (k : ℕ∞) ≤ f.order := by
  rw [mem_maximalIdeal_pow_iff]
  exact ⟨nat_le_order, fun hk α hlt ↦ coeff_of_lt_order ((Nat.cast_lt.mpr hlt).trans_le hk)⟩

end LocalRing

end MvPowerSeries
