/-!
# Ideals and local order of multivariate power series

In finitely many variables, the powers of the ideal generated by the variables consist exactly
of the series of at least that total-degree order. Over a field this ideal is the maximal ideal,
so local ideal order is the infimum of the total-degree orders of its elements. For an ideal
generated by a family, it is the infimum of the orders of the generators, including an empty
family. These comparisons identify local algebraic order with formal coordinate order.

The order convention follows Bierstone–Milman, *Canonical desingularization in characteristic
zero by blowing up the maximum strata of a local invariant* (1997), Remark 1.8 and
Corollary 3.20. The comparison uses Mathlib's `MvPowerSeries.toAdicCompletionAlgEquiv` and
`AdicCompletion.pow_smul_top_eq_ker_eval`, rather than constructing formal division anew.
The transport of the variable ideal follows Mathlib's power-series `IsAdicComplete` instance
in `Mathlib/RingTheory/AdicCompletion/Completeness.lean`.

## Monomial ideals and coefficientwise ideal products

If a multivariate formal power series `f : MvPowerSeries σ R` lies in the left ideal generated by a
set of pure monomials `monomial α 1` (`α ∈ S`), then every exponent `γ` with `coeff γ f ≠ 0`
dominates some `α ∈ S` (`MvPowerSeries.exists_le_of_mem_span_monomial_of_coeff_ne_zero`). This is
the forward direction of `MvPolynomial.mem_ideal_span_monomial_image` over an arbitrary semiring
`R`. Unlike in `MvPolynomial`, the converse can fail for infinitely many variables and generators
because `Ideal.span` consists of finite linear combinations whereas a power series may have
infinitely many nonzero coefficients; however, finiteness of `S` suffices, as does finite `σ` for
arbitrary `S` by Dickson's lemma.

Coefficientwise ideal membership is also preserved under multiplication of multivariate power
series: if the coefficients of `f` lie in an ideal `I` and those of `g` lie in `J`, then the
coefficients of `f * g` lie in `I * J` (`MvPowerSeries.coeff_mul_mem_mul`). In particular, `f * g`
vanishes when `I * J = ⊥` (`MvPowerSeries.mul_eq_zero_of_coeff_mem`), and multiplying on the left
by an arbitrary series preserves membership of coefficients in any left ideal
(`MvPowerSeries.coeff_mul_mem_of_right`).

## Main results

* `MvPowerSeries.mem_pow_span_range_X_iff_le_order`: variable-ideal powers consist of series
  of at least the given total-degree order in finitely many variables.
* `MvPowerSeries.mem_span_range_X_iff`: membership in the finite-variable ideal is equivalent
  to vanishing constant coefficient.
* `MvPowerSeries.maximalIdeal_eq_ker_constantCoeff`: over a field, the maximal ideal is the
  kernel of the constant-coefficient map.
* `MvPowerSeries.bijective_algebraMap_residueField`: over a field `k`, the residue field is `k`.
* `MvPowerSeries.finrank_residueField`: over a field `k`, the residue field has dimension one.
* `MvPowerSeries.maximalIdeal_eq_span_range_X`: in finitely many variables over a field,
  the maximal ideal is generated by the variables.
* `MvPowerSeries.localOrder_span_singleton`: over a field in finitely many variables,
  a principal ideal's local order is its generator's total-degree order.
* `MvPowerSeries.localOrder_span_range_eq_iInf_order`: over a field in finitely many variables,
  a generated ideal's local order is the infimum of its generators' total-degree orders.
* `Ideal.localOrder_eq_iInf_mvPowerSeries_order`: over a field in finitely many variables,
  an ideal's local order is the infimum of its elements' total-degree orders.
* `MvPowerSeries.exists_le_of_mem_span_monomial_of_coeff_ne_zero`: every exponent in the support of
  an element of `Ideal.span ((fun α ↦ monomial α 1) '' S)` lies above some `α ∈ S`.
* `MvPowerSeries.coeff_mul_mem_mul`: if the coefficients of `f` lie in `I` and those of `g` lie in
  `J`, then the coefficients of `f * g` lie in `I * J`.
* `MvPowerSeries.mul_eq_zero_of_coeff_mem`: if `I * J = ⊥`, then the product of a series with
  coefficients in `I` and a series with coefficients in `J` vanishes.
* `MvPowerSeries.coeff_mul_mem_of_right`: if every coefficient of `g` lies in a left ideal `I`,
  then so does every coefficient of `f * g`.
* `MvPowerSeries.basisComp`, `MvPowerSeries.eq_sum_smul_liftOfSurjective`,
  `MvPowerSeries.basisComp_eq_map_of_eq_sum_smul`, `MvPowerSeries.map_eq_of_sum_smul_eq`,
  `MvPowerSeries.sum_smul_eq_of_map_eq`, `MvPowerSeries.basisComp_subst`: coefficientwise basis
  decomposition and lifting of multivariate power series with coefficients in an ideal `I`
  equipped with a compatible `k`-basis.
-/

public section

namespace MvPowerSeries

section Semiring

variable {σ R : Type*} [Semiring R]

/-- If `f` lies in the left ideal generated by pure monomials `monomial α 1` (`α ∈ S`), then every
exponent `γ` with `coeff γ f ≠ 0` dominates some `α ∈ S`. -/
theorem exists_le_of_mem_span_monomial_of_coeff_ne_zero {S : Set (σ →₀ ℕ)} {f : MvPowerSeries σ R}
    (hf : f ∈ Ideal.span ((fun α ↦ monomial α (1 : R)) '' S)) {γ : σ →₀ ℕ}
    (hγ : coeff γ f ≠ 0) : ∃ α ∈ S, α ≤ γ := by
  classical
  refine Submodule.span_induction (p := fun f _ ↦ ∀ γ, coeff γ f ≠ 0 → ∃ α ∈ S, α ≤ γ)
    ?_ ?_ ?_ ?_ hf γ hγ
  · rintro _ ⟨α, hαS, rfl⟩ γ hγ
    exact ⟨α, hαS, (eq_of_coeff_monomial_ne_zero hγ).ge⟩
  · simp
  · intro g₁ g₂ _ _ ih₁ ih₂ γ hγ
    rw [map_add] at hγ
    by_cases h₁ : coeff γ g₁ = 0
    · rw [h₁, zero_add] at hγ
      exact ih₂ γ hγ
    · exact ih₁ γ h₁
  · intro r g _ ih γ hγ
    rw [smul_eq_mul, coeff_mul] at hγ
    obtain ⟨p, hp, hpne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hγ
    rw [Finset.mem_antidiagonal] at hp
    obtain ⟨α, hαS, hle⟩ := ih p.2 (right_ne_zero_of_mul hpne)
    exact ⟨α, hαS, hle.trans (hp ▸ le_add_left le_rfl)⟩

/-- If every coefficient of `f` lies in an ideal `I` and every coefficient of `g` lies in an ideal
`J`, then every coefficient of `f * g` lies in `I * J`. -/
theorem coeff_mul_mem_mul {I J : Ideal R} {f g : MvPowerSeries σ R}
    (hf : ∀ d, coeff d f ∈ I) (hg : ∀ d, coeff d g ∈ J) (d : σ →₀ ℕ) :
    coeff d (f * g) ∈ I * J := by
  classical
  rw [coeff_mul]
  exact Ideal.sum_mem _ fun pq _ ↦ Ideal.mul_mem_mul (hf pq.1) (hg pq.2)

/-- If `I * J = ⊥`, every coefficient of `f` lies in `I`, and every coefficient of `g` lies in `J`,
then `f * g = 0`. -/
theorem mul_eq_zero_of_coeff_mem {I J : Ideal R} (hIJ : I * J = ⊥) {f g : MvPowerSeries σ R}
    (hf : ∀ d, coeff d f ∈ I) (hg : ∀ d, coeff d g ∈ J) : f * g = 0 := by
  ext d
  rw [map_zero, ← Ideal.mem_bot, ← hIJ]
  exact coeff_mul_mem_mul hf hg d

/-- If every coefficient of `g` lies in a left ideal `I`, then every coefficient of `f * g` lies
in `I`. -/
theorem coeff_mul_mem_of_right {I : Ideal R} {f g : MvPowerSeries σ R}
    (hg : ∀ d, coeff d g ∈ I) (d : σ →₀ ℕ) : coeff d (f * g) ∈ I := by
  classical
  rw [coeff_mul]
  exact Ideal.sum_mem I fun pq _ ↦ I.mul_mem_left _ (hg pq.2)

end Semiring

section Basis

variable {σ A k ι : Type*}

/-- Given a `k`-basis `b` of an ideal `I ≤ A` and a power series `f : MvPowerSeries σ A` with all
coefficients in `I`, the `i`-th coordinate series `basisComp b hf i : MvPowerSeries σ k` has `d`-th
coefficient equal to the `i`-th coordinate of `coeff d f` in `b`. -/
noncomputable def basisComp [Semiring A] [Semiring k] {I : Ideal A} [Module k I]
    (b : Module.Basis ι k I) {f : MvPowerSeries σ A} (hf : ∀ d, coeff d f ∈ I) (i : ι) :
    MvPowerSeries σ k :=
  fun d ↦ b.coord i ⟨coeff d f, hf d⟩

/-- The coefficients of `basisComp b hf i` are the `b`-coordinates of the coefficients of `f`. -/
@[simp]
theorem coeff_basisComp [Semiring A] [Semiring k] {I : Ideal A} [Module k I]
    (b : Module.Basis ι k I) {f : MvPowerSeries σ A} (hf : ∀ d, coeff d f ∈ I) (i : ι)
    (d : σ →₀ ℕ) :
    coeff d (basisComp b hf i) = b.coord i ⟨coeff d f, hf d⟩ := by
  rfl

/-- `basisComp` is independent of the coefficientwise ideal-membership proof and respects equality
of series. -/
theorem basisComp_congr [Semiring A] [Semiring k] {I : Ideal A} [Module k I]
    (b : Module.Basis ι k I) {f₁ f₂ : MvPowerSeries σ A} {hf₁ : ∀ d, coeff d f₁ ∈ I}
    {hf₂ : ∀ d, coeff d f₂ ∈ I} (h : f₁ = f₂) (i : ι) :
    basisComp b hf₁ i = basisComp b hf₂ i := by
  subst h; rfl

/-- `basisComp` commutes with addition of power series with coefficients in `I`. -/
theorem basisComp_add [Semiring A] [Semiring k] {I : Ideal A} [Module k I]
    (b : Module.Basis ι k I) {f g : MvPowerSeries σ A} (hf : ∀ d, coeff d f ∈ I)
    (hg : ∀ d, coeff d g ∈ I) (i : ι) :
    basisComp b (f := f + g) (fun d ↦ by rw [map_add]; exact I.add_mem (hf d) (hg d)) i =
      basisComp b hf i + basisComp b hg i := by
  ext d
  have hadd : (⟨coeff d (f + g), by rw [map_add]; exact I.add_mem (hf d) (hg d)⟩ : I) =
      ⟨coeff d f, hf d⟩ + ⟨coeff d g, hg d⟩ := Subtype.ext (map_add _ f g)
  rw [map_add, coeff_basisComp, coeff_basisComp, coeff_basisComp, hadd, map_add]

/-- A power series with coefficients in `I` decomposes as
`∑ i, (b i : A) • liftOfSurjective hπ (basisComp b hf i)` when the `k`-module structure on `I` is
compatible with `π : A →+* k`. -/
theorem eq_sum_smul_liftOfSurjective [CommSemiring A] [Semiring k] {π : A →+* k}
    (hπ : Function.Surjective π) {I : Ideal A} [Module k I]
    (hsmul : ∀ (a : A) (y : I), ((π a • y : I) : A) = a * y.val) [Fintype ι]
    (b : Module.Basis ι k I) {f : MvPowerSeries σ A} (hf : ∀ d, coeff d f ∈ I) :
    f = ∑ i, (b i : A) • liftOfSurjective hπ (basisComp b hf i) := by
  ext d
  have hrepr : coeff d f = ∑ i, ((b.repr ⟨coeff d f, hf d⟩ i • b i : I) : A) := by
    simpa only [Submodule.coe_sum] using (congrArg Subtype.val (b.sum_repr ⟨coeff d f, hf d⟩)).symm
  rw [hrepr, map_sum]
  exact Finset.sum_congr rfl fun i _ ↦ by
    rw [coeff_smul, mul_comm, ← hsmul, ← coeff_map, map_liftOfSurjective,
      coeff_basisComp, Module.Basis.coord_apply]

/-- If `f = ∑ j, (b j : A) • gA j`, then the `i`-th basis component of `f` is
`MvPowerSeries.map π (gA i)`. -/
theorem basisComp_eq_map_of_eq_sum_smul [CommSemiring A] [Semiring k] {π : A →+* k}
    {I : Ideal A} [Module k I] (hsmul : ∀ (a : A) (y : I), ((π a • y : I) : A) = a * y.val)
    [Fintype ι] (b : Module.Basis ι k I) {f : MvPowerSeries σ A} (hf : ∀ d, coeff d f ∈ I)
    (gA : ι → MvPowerSeries σ A) (hsum : f = ∑ j, (b j : A) • gA j) (i : ι) :
    basisComp b hf i = MvPowerSeries.map π (gA i) := by
  classical
  ext d
  have hmem : (⟨coeff d f, hf d⟩ : I) = ∑ j, π (coeff d (gA j)) • b j := Subtype.ext <| by
    rw [Subtype.coe_mk, hsum, map_sum, Submodule.coe_sum]
    exact Finset.sum_congr rfl fun j _ ↦ by rw [coeff_smul, mul_comm, hsmul]
  rw [coeff_basisComp, coeff_map, hmem, map_sum]
  simp [Module.Basis.coord_apply, b.repr_self, Finsupp.single_apply]

/-- Linear independence of `b` descends to `MvPowerSeries.map π`: an equality
`∑ j, (b j : A) • gA j = ∑ j, (b j : A) • hA j` forces `map π (gA i) = map π (hA i)` for every
`i`. -/
theorem map_eq_of_sum_smul_eq [CommSemiring A] [Semiring k] {π : A →+* k} {I : Ideal A}
    [Module k I] (hsmul : ∀ (a : A) (y : I), ((π a • y : I) : A) = a * y.val) [Fintype ι]
    (b : Module.Basis ι k I) {gA hA : ι → MvPowerSeries σ A}
    (heq : ∑ j, (b j : A) • gA j = ∑ j, (b j : A) • hA j) (i : ι) :
    MvPowerSeries.map π (gA i) = MvPowerSeries.map π (hA i) := by
  have hmem (d : σ →₀ ℕ) : coeff d (∑ j, (b j : A) • gA j) ∈ I := by
    rw [map_sum]
    exact Ideal.sum_mem _ fun j _ ↦ by
      rw [coeff_smul]; exact I.mul_mem_right _ (b j).property
  rw [← basisComp_eq_map_of_eq_sum_smul hsmul b hmem gA rfl i,
    basisComp_eq_map_of_eq_sum_smul hsmul b hmem hA heq i]

/-- Conversely, if `MvPowerSeries.map π (gA i) = MvPowerSeries.map π (hA i)` for every `i`, then
`∑ j, (v j : A) • gA j = ∑ j, (v j : A) • hA j` for any `v : ι → I`. -/
theorem sum_smul_eq_of_map_eq [CommSemiring A] [Semiring k] {π : A →+* k} {I : Ideal A}
    [Module k I] (hsmul : ∀ (a : A) (y : I), ((π a • y : I) : A) = a * y.val) [Fintype ι]
    (v : ι → I) {gA hA : ι → MvPowerSeries σ A}
    (hmap : ∀ i, MvPowerSeries.map π (gA i) = MvPowerSeries.map π (hA i)) :
    ∑ j, (v j : A) • gA j = ∑ j, (v j : A) • hA j := by
  ext d; rw [map_sum, map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  have hd : π (coeff d (gA j)) = π (coeff d (hA j)) := by
    simpa [coeff_map] using congrArg (coeff d) (hmap j)
  rw [coeff_smul, coeff_smul, mul_comm (v j : A), mul_comm (v j : A),
    ← hsmul, ← hsmul, hd]

/-- `basisComp` commutes with substitution: the `i`-th basis component of `f.subst a` is the
`i`-th basis component of `f` substituted with `fun s ↦ MvPowerSeries.map π (a s)`. -/
theorem basisComp_subst {τ : Type*} [CommRing A] [CommRing k] {π : A →+* k}
    (hπ : Function.Surjective π) {I : Ideal A} [Module k I]
    (hsmul : ∀ (a : A) (y : I), ((π a • y : I) : A) = a * y.val) [Finite ι]
    (b : Module.Basis ι k I) {f : MvPowerSeries σ A} (hf : ∀ d, coeff d f ∈ I)
    {a : σ → MvPowerSeries τ A} (ha : HasSubst a) (i : ι) :
    basisComp b (coeff_subst_mem_of_coeff_mem ha hf) i =
      (basisComp b hf i).subst (fun s ↦ MvPowerSeries.map π (a s)) := by
  let := Fintype.ofFinite ι
  rw [basisComp_eq_map_of_eq_sum_smul hsmul b _
      (fun j ↦ (liftOfSurjective hπ (basisComp b hf j)).subst a) ?_ i,
    map_subst ha, map_liftOfSurjective]
  conv_lhs => rw [eq_sum_smul_liftOfSurjective hπ hsmul b hf]
  rw [← coe_substAlgHom ha, map_sum]
  exact Finset.sum_congr rfl fun j _ ↦ map_smul (substAlgHom ha) (b j : A) _

end Basis

section CommRing

variable {σ R : Type*} [Finite σ] [CommRing R]

/-- The formal power-series completion equivalence carries the variable ideal to the
extension of the polynomial variable ideal in its adic completion. -/
theorem map_toAdicCompletionAlgEquiv_span_range_X :
    (Ideal.span (Set.range X) : Ideal (MvPowerSeries σ R)).map
        (toAdicCompletionAlgEquiv σ R).toRingEquiv =
      (MvPolynomial.idealOfVars σ R).map (algebraMap (MvPolynomial σ R)
        (AdicCompletion (MvPolynomial.idealOfVars σ R) (MvPolynomial σ R))) := by
  simp_rw [MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp]
  congr 2
  ext i
  simp [AdicCompletion.algebraMap_apply, ← MvPolynomial.coe_X, toAdicCompletion_coe]

/-- The `n`-th power of the ideal of variables consists of the series of order at least `n`.
Finiteness of the variable type ensures these are algebraic ideal powers, not just their
closures. No field or Noetherian hypothesis on the coefficient ring is needed. -/
@[simp]
theorem mem_pow_span_range_X_iff_le_order {f : MvPowerSeries σ R} {n : ℕ} :
    f ∈ (Ideal.span (Set.range X) : Ideal (MvPowerSeries σ R)) ^ n ↔
      (n : ℕ∞) ≤ f.order := by
  let e := (toAdicCompletionAlgEquiv σ R).toRingEquiv
  -- Transport the ideal power to the extension of the polynomial variable ideal.
  rw [← Ideal.apply_mem_of_equiv_iff (f := e), Ideal.map_pow,
    map_toAdicCompletionAlgEquiv_span_range_X, ← Ideal.map_pow]
  -- View this extension as a submodule, where it is the kernel of the completion projection.
  rw [← Submodule.restrictScalars_mem (MvPolynomial σ R), ← Ideal.smul_top_eq_map,
    AdicCompletion.pow_smul_top_eq_ker_eval (MvPolynomial.fg_idealOfVars σ R)]
  -- Membership in that kernel means the nth completion coordinate vanishes.
  rw [LinearMap.mem_ker, AdicCompletion.eval_apply]
  -- The completion projection is the quotient class of the total-degree truncation.
  simp only [e, AlgEquiv.coe_toRingEquiv, toAdicCompletionAlgEquiv_apply,
    toAdicCompletion_apply_eq_mk_truncTotal]
  rw [Ideal.Quotient.eq_zero_iff_mem]
  -- Polynomial ideal-power membership is vanishing of coefficients below total degree n.
  simp only [Ideal.smul_eq_mul, Ideal.mul_top, MvPolynomial.mem_pow_idealOfVars_iff']
  constructor
  · intro h
    exact nat_le_order fun d hd ↦ by simpa [coeff_truncTotal _ hd] using h d hd
  · intro h d hd
    rw [coeff_truncTotal _ hd]
    exact coeff_of_lt_order ((Nat.cast_lt.mpr hd).trans_le h)

/-- A formal series in finitely many variables belongs to the variable ideal exactly when
its constant coefficient vanishes. -/
@[simp]
theorem mem_span_range_X_iff {f : MvPowerSeries σ R} :
    f ∈ (Ideal.span (Set.range X) : Ideal (MvPowerSeries σ R)) ↔ constantCoeff f = 0 := by
  simpa only [pow_one, Nat.cast_one, one_le_order_iff_constCoeff_eq_zero] using
    (mem_pow_span_range_X_iff_le_order (f := f) (n := 1))

end CommRing

section Field

variable {σ k : Type*} [Field k]

/-- In a formal power-series ring over a field, the maximal ideal is the kernel of the
constant-coefficient map, independently of the number of variables. -/
theorem maximalIdeal_eq_ker_constantCoeff :
    IsLocalRing.maximalIdeal (MvPowerSeries σ k) = RingHom.ker constantCoeff := by
  ext f
  simp [IsLocalRing.mem_maximalIdeal, isUnit_iff_constantCoeff]

/-- The residue field of a formal power-series ring over a field `k` is `k`: every series is
congruent to its constant coefficient modulo the maximal ideal. -/
theorem bijective_algebraMap_residueField :
    Function.Bijective (algebraMap k (IsLocalRing.ResidueField (MvPowerSeries σ k))) := by
  refine ⟨(algebraMap k _).injective, fun x ↦ ?_⟩
  obtain ⟨f, rfl⟩ := IsLocalRing.residue_surjective x
  refine ⟨constantCoeff f, ?_⟩
  rw [IsScalarTower.algebraMap_apply k (MvPowerSeries σ k), IsLocalRing.ResidueField.algebraMap_eq,
    ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff, maximalIdeal_eq_ker_constantCoeff]
  simp [← c_eq_algebraMap]

/-- A formal power-series ring over a field `k` has residue field of dimension one over `k`. -/
theorem finrank_residueField :
    Module.finrank k (IsLocalRing.ResidueField (MvPowerSeries σ k)) = 1 :=
  (AlgEquiv.ofBijective (Algebra.ofId k _)
    bijective_algebraMap_residueField).toLinearEquiv.finrank_eq.symm.trans (Module.finrank_self k)

variable [Finite σ]

/-- In finitely many variables over a field, the maximal ideal is generated by the variables. -/
theorem maximalIdeal_eq_span_range_X :
    IsLocalRing.maximalIdeal (MvPowerSeries σ k) = Ideal.span (Set.range X) := by
  ext f
  rw [maximalIdeal_eq_ker_constantCoeff, RingHom.mem_ker, mem_span_range_X_iff]

/-- Maximal-ideal powers in a finite-variable formal chart measure total-degree order. -/
@[simp]
theorem mem_maximalIdeal_pow_iff_le_order {f : MvPowerSeries σ k} {n : ℕ} :
    f ∈ IsLocalRing.maximalIdeal (MvPowerSeries σ k) ^ n ↔ (n : ℕ∞) ≤ f.order := by
  rw [maximalIdeal_eq_span_range_X, mem_pow_span_range_X_iff_le_order]

/-- The order of the principal ideal generated by a formal series is its total-degree order. -/
@[simp]
theorem localOrder_span_singleton (f : MvPowerSeries σ k) :
    (Ideal.span {f}).localOrder = f.order := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  rw [Ideal.natCast_le_localOrder_iff, Ideal.span_singleton_le_iff_mem,
    mem_maximalIdeal_pow_iff_le_order]

/-- Generator orders compute local ideal order in a finite-variable formal chart. In
particular, a finite generating family's order is its minimum, and an empty family's is `∞`. -/
@[simp]
theorem localOrder_span_range_eq_iInf_order {ι : Type*} (f : ι → MvPowerSeries σ k) :
    (Ideal.span (Set.range f)).localOrder = ⨅ i, (f i).order := by
  simp [Ideal.localOrder_span_range]

-- The generators' orders take a minimum, not a sum, even when both are nonzero.
example : (Ideal.span {(X (0 : Fin 2) : MvPowerSeries (Fin 2) k) ^ 3,
    X (1 : Fin 2) ^ 5}).localOrder = 3 := by
  simp [Ideal.span_insert, X_pow_eq, order_monomial_of_ne_zero one_ne_zero,
    show (3 : ℕ∞) ≤ 5 by decide]

end Field

end MvPowerSeries

namespace Ideal

/-- The local order of an ideal in a finite-variable formal chart over a field is the
infimum of the total-degree orders of its elements. -/
theorem localOrder_eq_iInf_mvPowerSeries_order {σ k : Type*} [Finite σ] [Field k]
    (J : Ideal (MvPowerSeries σ k)) :
    J.localOrder = ⨅ f : J, (f : MvPowerSeries σ k).order := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  simp only [natCast_le_localOrder_iff, le_iInf_iff]
  exact ⟨fun h f ↦ MvPowerSeries.mem_maximalIdeal_pow_iff_le_order.mp (h f.property),
    fun h f hf ↦ MvPowerSeries.mem_maximalIdeal_pow_iff_le_order.mpr (h ⟨f, hf⟩)⟩

end Ideal
