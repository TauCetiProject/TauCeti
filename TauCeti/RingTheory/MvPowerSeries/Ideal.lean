/-!
# Ideals and local order of multivariate power series

In finitely many variables, the powers of the ideal generated by the variables consist exactly
of the series of at least that total-degree order. Over a field this ideal is the maximal ideal,
so local ideal order is the infimum of the total-degree orders of its elements. For an ideal
generated by a family, it is the infimum of the orders of the generators, including an empty
family. These comparisons identify local algebraic order with formal coordinate order.

The order convention follows Bierstone–Milman, *Canonical desingularization in characteristic
zero by blowing up the maximum strata of a local invariant* (1997), Remark 1.8 and
Corollary 3.20. The comparison uses Mathlib's `MvPowerSeries.toAdicCompletionAlgEquiv` and
`AdicCompletion.pow_smul_top_eq_ker_eval`, rather than constructing formal division anew.
The transport of the variable ideal follows Mathlib's power-series `IsAdicComplete` instance
in `Mathlib/RingTheory/AdicCompletion/Completeness.lean`.

## Monomial ideals

If a multivariate formal power series `f : MvPowerSeries σ R` lies in the left ideal generated by a
set of pure monomials `monomial α 1` (`α ∈ S`), then every exponent `γ` with `coeff γ f ≠ 0`
dominates some `α ∈ S` (`MvPowerSeries.exists_le_of_mem_span_monomial_of_coeff_ne_zero`). This is
the forward direction of `MvPolynomial.mem_ideal_span_monomial_image` over an arbitrary semiring
`R`. Unlike in `MvPolynomial`, the converse can fail for infinitely many variables and generators
because `Ideal.span` consists of finite linear combinations whereas a power series may have
infinitely many nonzero coefficients; however, finiteness of `S` suffices, as does finite `σ` for
arbitrary `S` by Dickson's lemma.

## Main results

* `MvPowerSeries.mem_pow_span_range_X_iff_le_order`: variable-ideal powers consist of series
  of at least the given total-degree order in finitely many variables.
* `MvPowerSeries.mem_span_range_X_iff`: membership in the finite-variable ideal is equivalent
  to vanishing constant coefficient.
* `MvPowerSeries.maximalIdeal_eq_ker_constantCoeff`: over a field, the maximal ideal is the
  kernel of the constant-coefficient map.
* `MvPowerSeries.maximalIdeal_eq_span_range_X`: in finitely many variables over a field,
  the maximal ideal is generated by the variables.
* `MvPowerSeries.localOrder_span_singleton`: over a field in finitely many variables,
  a principal ideal's local order is its generator's total-degree order.
* `MvPowerSeries.localOrder_span_range_eq_iInf_order`: over a field in finitely many variables,
  a generated ideal's local order is the infimum of its generators' total-degree orders.
* `Ideal.localOrder_eq_iInf_mvPowerSeries_order`: over a field in finitely many variables,
  an ideal's local order is the infimum of its elements' total-degree orders.
* `MvPowerSeries.exists_le_of_mem_span_monomial_of_coeff_ne_zero`: every exponent in the support of
  an element of `Ideal.span ((fun α ↦ monomial α 1) '' S)` lies above some `α ∈ S`.
-/

public section

namespace MvPowerSeries

section Semiring

variable {σ R : Type*} [Semiring R]

/-- If `f` lies in the left ideal generated by pure monomials `monomial α 1` (`α ∈ S`), then every
exponent `γ` with `coeff γ f ≠ 0` dominates some `α ∈ S`. -/
theorem exists_le_of_mem_span_monomial_of_coeff_ne_zero {S : Set (σ →₀ ℕ)} {f : MvPowerSeries σ R}
    (hf : f ∈ Ideal.span ((fun α ↦ monomial α (1 : R)) '' S)) {γ : σ →₀ ℕ}
    (hγ : coeff γ f ≠ 0) : ∃ α ∈ S, α ≤ γ := by
  classical
  refine Submodule.span_induction (p := fun f _ ↦ ∀ γ, coeff γ f ≠ 0 → ∃ α ∈ S, α ≤ γ)
    ?_ ?_ ?_ ?_ hf γ hγ
  · rintro _ ⟨α, hαS, rfl⟩ γ hγ
    exact ⟨α, hαS, (eq_of_coeff_monomial_ne_zero hγ).ge⟩
  · simp
  · intro g₁ g₂ _ _ ih₁ ih₂ γ hγ
    rw [map_add] at hγ
    by_cases h₁ : coeff γ g₁ = 0
    · rw [h₁, zero_add] at hγ
      exact ih₂ γ hγ
    · exact ih₁ γ h₁
  · intro r g _ ih γ hγ
    rw [smul_eq_mul, coeff_mul] at hγ
    obtain ⟨p, hp, hpne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hγ
    rw [Finset.mem_antidiagonal] at hp
    obtain ⟨α, hαS, hle⟩ := ih p.2 (right_ne_zero_of_mul hpne)
    exact ⟨α, hαS, hle.trans (hp ▸ le_add_left le_rfl)⟩

end Semiring

section CommRing

variable {σ R : Type*} [Finite σ] [CommRing R]

/-- The formal power-series completion equivalence carries the variable ideal to the
extension of the polynomial variable ideal in its adic completion. -/
theorem map_toAdicCompletionAlgEquiv_span_range_X :
    (Ideal.span (Set.range X) : Ideal (MvPowerSeries σ R)).map
        (toAdicCompletionAlgEquiv σ R).toRingEquiv =
      (MvPolynomial.idealOfVars σ R).map (algebraMap (MvPolynomial σ R)
        (AdicCompletion (MvPolynomial.idealOfVars σ R) (MvPolynomial σ R))) := by
  simp_rw [MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp]
  congr 2
  ext i
  simp [AdicCompletion.algebraMap_apply, ← MvPolynomial.coe_X, toAdicCompletion_coe]

/-- The `n`-th power of the ideal of variables consists of the series of order at least `n`.
Finiteness of the variable type ensures these are algebraic ideal powers, not just their
closures. No field or Noetherian hypothesis on the coefficient ring is needed. -/
@[simp]
theorem mem_pow_span_range_X_iff_le_order {f : MvPowerSeries σ R} {n : ℕ} :
    f ∈ (Ideal.span (Set.range X) : Ideal (MvPowerSeries σ R)) ^ n ↔
      (n : ℕ∞) ≤ f.order := by
  let e := (toAdicCompletionAlgEquiv σ R).toRingEquiv
  -- Transport the ideal power to the extension of the polynomial variable ideal.
  rw [← Ideal.apply_mem_of_equiv_iff (f := e), Ideal.map_pow,
    map_toAdicCompletionAlgEquiv_span_range_X, ← Ideal.map_pow]
  -- View this extension as a submodule, where it is the kernel of the completion projection.
  rw [← Submodule.restrictScalars_mem (MvPolynomial σ R), ← Ideal.smul_top_eq_map,
    AdicCompletion.pow_smul_top_eq_ker_eval (MvPolynomial.fg_idealOfVars σ R)]
  -- Membership in that kernel means the nth completion coordinate vanishes.
  rw [LinearMap.mem_ker, AdicCompletion.eval_apply]
  -- The completion projection is the quotient class of the total-degree truncation.
  simp only [e, AlgEquiv.coe_toRingEquiv, toAdicCompletionAlgEquiv_apply,
    toAdicCompletion_apply_eq_mk_truncTotal]
  rw [Ideal.Quotient.eq_zero_iff_mem]
  -- Polynomial ideal-power membership is vanishing of coefficients below total degree n.
  simp only [Ideal.smul_eq_mul, Ideal.mul_top, MvPolynomial.mem_pow_idealOfVars_iff']
  constructor
  · intro h
    exact nat_le_order fun d hd ↦ by simpa [coeff_truncTotal _ hd] using h d hd
  · intro h d hd
    rw [coeff_truncTotal _ hd]
    exact coeff_of_lt_order ((Nat.cast_lt.mpr hd).trans_le h)

/-- A formal series in finitely many variables belongs to the variable ideal exactly when
its constant coefficient vanishes. -/
@[simp]
theorem mem_span_range_X_iff {f : MvPowerSeries σ R} :
    f ∈ (Ideal.span (Set.range X) : Ideal (MvPowerSeries σ R)) ↔ constantCoeff f = 0 := by
  simpa only [pow_one, Nat.cast_one, one_le_order_iff_constCoeff_eq_zero] using
    (mem_pow_span_range_X_iff_le_order (f := f) (n := 1))

end CommRing

section Field

variable {σ k : Type*} [Field k]

/-- In a formal power-series ring over a field, the maximal ideal is the kernel of the
constant-coefficient map, independently of the number of variables. -/
theorem maximalIdeal_eq_ker_constantCoeff :
    IsLocalRing.maximalIdeal (MvPowerSeries σ k) = RingHom.ker constantCoeff := by
  ext f
  simp [IsLocalRing.mem_maximalIdeal, isUnit_iff_constantCoeff]

variable [Finite σ]

/-- In finitely many variables over a field, the maximal ideal is generated by the variables. -/
theorem maximalIdeal_eq_span_range_X :
    IsLocalRing.maximalIdeal (MvPowerSeries σ k) = Ideal.span (Set.range X) := by
  ext f
  rw [maximalIdeal_eq_ker_constantCoeff, RingHom.mem_ker, mem_span_range_X_iff]

/-- Maximal-ideal powers in a finite-variable formal chart measure total-degree order. -/
@[simp]
theorem mem_maximalIdeal_pow_iff_le_order {f : MvPowerSeries σ k} {n : ℕ} :
    f ∈ IsLocalRing.maximalIdeal (MvPowerSeries σ k) ^ n ↔ (n : ℕ∞) ≤ f.order := by
  rw [maximalIdeal_eq_span_range_X, mem_pow_span_range_X_iff_le_order]

/-- The order of the principal ideal generated by a formal series is its total-degree order. -/
@[simp]
theorem localOrder_span_singleton (f : MvPowerSeries σ k) :
    (Ideal.span {f}).localOrder = f.order := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  rw [Ideal.natCast_le_localOrder_iff, Ideal.span_singleton_le_iff_mem,
    mem_maximalIdeal_pow_iff_le_order]

/-- Generator orders compute local ideal order in a finite-variable formal chart. In
particular, a finite generating family's order is its minimum, and an empty family's is `∞`. -/
@[simp]
theorem localOrder_span_range_eq_iInf_order {ι : Type*} (f : ι → MvPowerSeries σ k) :
    (Ideal.span (Set.range f)).localOrder = ⨅ i, (f i).order := by
  simp [Ideal.localOrder_span_range]

-- The generators' orders take a minimum, not a sum, even when both are nonzero.
example : (Ideal.span {(X (0 : Fin 2) : MvPowerSeries (Fin 2) k) ^ 3,
    X (1 : Fin 2) ^ 5}).localOrder = 3 := by
  simp [Ideal.span_insert, X_pow_eq, order_monomial_of_ne_zero one_ne_zero,
    show (3 : ℕ∞) ≤ 5 by decide]

end Field

end MvPowerSeries

namespace Ideal

/-- The local order of an ideal in a finite-variable formal chart over a field is the
infimum of the total-degree orders of its elements. -/
theorem localOrder_eq_iInf_mvPowerSeries_order {σ k : Type*} [Finite σ] [Field k]
    (J : Ideal (MvPowerSeries σ k)) :
    J.localOrder = ⨅ f : J, (f : MvPowerSeries σ k).order := by
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  simp only [natCast_le_localOrder_iff, le_iInf_iff]
  exact ⟨fun h f ↦ MvPowerSeries.mem_maximalIdeal_pow_iff_le_order.mp (h f.property),
    fun h f hf ↦ MvPowerSeries.mem_maximalIdeal_pow_iff_le_order.mpr (h ⟨f, hf⟩)⟩

end Ideal
