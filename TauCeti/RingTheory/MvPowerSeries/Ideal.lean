module

public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.MvPowerSeries.Basic

/-!
# Monomial ideals of multivariate power series

If a multivariate formal power series `f : MvPowerSeries σ R` lies in the left ideal generated by a
set of pure monomials `monomial α 1` (`α ∈ S`), then every exponent `γ` with `coeff γ f ≠ 0`
dominates some `α ∈ S` (`MvPowerSeries.exists_le_of_mem_span_monomial_of_coeff_ne_zero`). This is
the forward direction of `MvPolynomial.mem_ideal_span_monomial_image` over an arbitrary semiring
`R`. Unlike in `MvPolynomial`, the converse can fail for infinitely many variables and generators
because `Ideal.span` consists of finite linear combinations whereas a power series may have
infinitely many nonzero coefficients; however, finiteness of `S` suffices, as does finite `σ` for
arbitrary `S` by Dickson's lemma.

## Main results

* `MvPowerSeries.exists_le_of_mem_span_monomial_of_coeff_ne_zero`: every exponent in the support of
  an element of `Ideal.span ((fun α ↦ monomial α 1) '' S)` lies above some `α ∈ S`.
-/

public section

namespace MvPowerSeries

variable {σ R : Type*} [Semiring R]

/-- If `f` lies in the left ideal generated by pure monomials `monomial α 1` (`α ∈ S`), then every
exponent `γ` with `coeff γ f ≠ 0` dominates some `α ∈ S`. -/
theorem exists_le_of_mem_span_monomial_of_coeff_ne_zero {S : Set (σ →₀ ℕ)} {f : MvPowerSeries σ R}
    (hf : f ∈ Ideal.span ((fun α ↦ monomial α (1 : R)) '' S)) {γ : σ →₀ ℕ}
    (hγ : coeff γ f ≠ 0) : ∃ α ∈ S, α ≤ γ := by
  classical
  refine Submodule.span_induction (p := fun f _ ↦ ∀ γ, coeff γ f ≠ 0 → ∃ α ∈ S, α ≤ γ)
    ?_ ?_ ?_ ?_ hf γ hγ
  · rintro _ ⟨α, hαS, rfl⟩ γ hγ
    exact ⟨α, hαS, (eq_of_coeff_monomial_ne_zero hγ).ge⟩
  · simp
  · intro g₁ g₂ _ _ ih₁ ih₂ γ hγ
    rw [map_add] at hγ
    by_cases h₁ : coeff γ g₁ = 0
    · rw [h₁, zero_add] at hγ
      exact ih₂ γ hγ
    · exact ih₁ γ h₁
  · intro r g _ ih γ hγ
    rw [smul_eq_mul, coeff_mul] at hγ
    obtain ⟨p, hp, hpne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hγ
    rw [Finset.mem_antidiagonal] at hp
    obtain ⟨α, hαS, hle⟩ := ih p.2 (right_ne_zero_of_mul hpne)
    exact ⟨α, hαS, hle.trans (hp ▸ le_add_left le_rfl)⟩

end MvPowerSeries
