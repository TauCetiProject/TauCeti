/-!
# Tate algebras are regular at their maximal ideals

Over a complete nonarchimedean field `K`, every maximal ideal `M` of the Tate algebra
`K⟨X₁, …, Xₙ⟩` is generated by `n` elements. Since `M` has height `n`
(`Ideal.height_eq_natCard_of_isMaximal_isRestricted_subring`), Krull's height theorem shows that
`n` is the least number of generators, and the localization of `K⟨X₁, …, Xₙ⟩` at `M` is a regular
local ring of dimension `n`. Regularity of Tate algebras is one of the inputs to the excellence of
affinoid algebras.

The proof is by induction on the number of variables, writing `K⟨X, Y⟩` as the univariate Tate
algebra `K⟨X⟩⟨Y⟩`. Choose a nonzero `f ∈ M` and make it distinguished in `Y` by an automorphism.

* Weierstrass division by `f` shows that an ideal of `K⟨X⟩⟨Y⟩` containing `f` is generated by its
  polynomials (`TauCeti.PowerSeries.IsDistinguished.map_comap_polynomialToRestricted`): Weierstrass
  preparation writes `f` as a unit times a monic polynomial, and dividing by `f` leaves a
  polynomial remainder.
* So `M` is generated by the ideal `P` of polynomials in `K⟨X⟩[Y]` that it contains. The
  contraction `p` of `M` to `K⟨X⟩` is maximal, since `K⟨X⟩⟨Y⟩ ⧸ (f)` is finite over `K⟨X⟩`, so `P`
  needs at most one generator more than `p`
  (`Polynomial.spanFinrank_le_spanFinrank_comap_C_add_one`).
  By induction `p` is generated by `n` elements, so `M` is generated by `n + 1`.

## Main results

* `Ideal.spanFinrank_eq_natCard_of_isMaximal_isRestricted_subring`: every maximal ideal of the
  Tate algebra in the variables `σ` is minimally generated by `Nat.card σ` elements.
* `TauCeti.MvPowerSeries.isRegularLocalRing_localization_atPrime_of_isMaximal_isRestricted_subring`:
  the localization of the Tate algebra at a maximal ideal is a regular local ring.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §§5.2.1–5.2.2,
  for Weierstrass division and preparation.
* B. Conrad, *Irreducible components of rigid spaces*, Ann. Inst. Fourier 49 (1999), §1.1, for
  the regularity of Tate algebras as an input to excellence.
* The induction on the number of variables follows the proof of
  `Ideal.height_eq_natCard_of_isMaximal_isRestricted_subring`.
-/

public section

namespace TauCeti.MvPowerSeries

open _root_.MvPowerSeries

variable {K : Type*} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

local notation "Tate " σ:max => IsRestricted.subring (R := K) (fun _ : σ ↦ 1)

/-- The inductive step: if every maximal ideal of `K⟨X⟩` is generated by `n` elements, where `n`
is the number of variables, then every maximal ideal of `K⟨X, Y⟩` is generated by `n + 1`
elements. -/
private theorem spanFinrank_le_natCard_option {σ : Type*} [Finite σ]
    (IH : ∀ (p : Ideal (Tate σ)) [p.IsMaximal], p.spanFinrank ≤ Nat.card σ)
    (M : Ideal (Tate (Option σ))) [M.IsMaximal] : M.spanFinrank ≤ Nat.card (Option σ) := by
  rcases eq_or_ne M ⊥ with rfl | hM
  · simp
  -- Transport `M` to `K⟨X⟩⟨Y⟩` along a change of variables making some `f ∈ M` distinguished.
  obtain ⟨f, hfM, hf⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hM
  obtain ⟨e, s, hd, hu⟩ := exists_algEquiv_isDistinguished_isUnit f hf
  let R := Tate σ
  let S := PowerSeries.IsRestricted.subring (R := R) 1
  let E : Tate (Option σ) ≃+* S :=
    (e : Tate (Option σ) ≃+* Tate (Option σ)).trans Huber.restrictedOptionEquiv
  let g : S := E f
  rw [← Ideal.spanFinrank_map_eq_of_ringEquiv E M]
  set N : Ideal S := M.map E
  have hgN : g ∈ N := Ideal.mem_map_of_mem E hfM
  -- `N` is generated by the ideal `P` of polynomials it contains.
  let φ : Polynomial R →+* S := PowerSeries.polynomialToRestricted (R := R) 1
  let P : Ideal (Polynomial R) := N.comap φ
  have hNP : P.map φ = N := hd.map_comap_polynomialToRestricted zero_lt_one hu hgN
  have hφC : φ.comp Polynomial.C = algebraMap R S := by
    rw [← Polynomial.algebraMap_eq]
    exact (PowerSeries.polynomialToRestricted (R := R) 1).comp_algebraMap
  -- `S ⧸ (g)` is finite over `R`, so the contraction of `N` to `R` is maximal.
  have : N.IsMaximal := Ideal.map_isMaximal_of_equiv E
  have : (P.comap Polynomial.C).IsMaximal := by
    simpa only [P, Ideal.comap_comap, hφC] using
      hd.isMaximal_comap_algebraMap zero_lt_one hu hgN
  -- So `P` needs at most one generator more than `p`, which needs at most `n` by induction.
  have : IsNoetherianRing R := isNoetherianRing_isRestricted_subring
  rw [← hNP, Finite.card_option]
  refine (Ideal.spanFinrank_map_le_of_fg φ (IsNoetherian.noetherian P)).trans <|
    (Polynomial.spanFinrank_le_spanFinrank_comap_C_add_one P ‹_›
      (IsNoetherian.noetherian _)).trans ?_
  gcongr
  exact IH _

/-- Every maximal ideal of the Tate algebra in the variables `σ` is generated by `Nat.card σ`
elements. -/
private theorem spanFinrank_le_natCard_of_isMaximal {σ : Type*} [Finite σ]
    (M : Ideal (Tate σ)) [M.IsMaximal] : M.spanFinrank ≤ Nat.card σ := by
  revert M
  induction σ using Finite.induction_empty_option with
  | of_equiv e H =>
    intro M _
    let e' : Tate _ ≃+* Tate _ := (IsRestricted.renameAlgEquiv (R := K) e fun _ ↦ 1).toRingEquiv
    have := H (M.comap e')
    rwa [← Ideal.map_symm, Ideal.spanFinrank_map_eq_of_ringEquiv, Nat.card_congr e] at this
  | h_empty =>
    intro M _
    -- Without variables, the Tate algebra is a quotient of the field `K`, so `M` is zero.
    rw [← Ideal.map_comap_of_surjective _ algebraMap_isRestrictedSubring_surjective M,
      Ideal.eq_bot_of_prime (M.comap (algebraMap K (Tate PEmpty))), Ideal.map_bot]
    simp
  | h_option IH => exact spanFinrank_le_natCard_option IH

/-- **Generators of maximal ideals of Tate algebras.** Over a complete nonarchimedean field, every
maximal ideal of the Tate algebra `K⟨X₁, …, Xₙ⟩` is generated by `n` elements, and by no fewer,
since it has height `n`. -/
@[simp]
theorem _root_.Ideal.spanFinrank_eq_natCard_of_isMaximal_isRestricted_subring {σ : Type*}
    [Finite σ] (M : Ideal (Tate σ)) [M.IsMaximal] : M.spanFinrank = Nat.card σ := by
  have : IsNoetherianRing (Tate σ) := isNoetherianRing_isRestricted_subring
  refine le_antisymm (spanFinrank_le_natCard_of_isMaximal M) ?_
  have := M.height_le_spanFinrank Ideal.IsPrime.ne_top'
  rw [Ideal.height_eq_natCard_of_isMaximal_isRestricted_subring] at this
  exact_mod_cast this

/-- **Tate algebras are regular at their maximal ideals.** Over a complete nonarchimedean field,
the localization of the Tate algebra `K⟨X₁, …, Xₙ⟩` at a maximal ideal is a regular local ring of
dimension `n`: its maximal ideal is generated by `n` elements. -/
instance isRegularLocalRing_localization_atPrime_of_isMaximal_isRestricted_subring {σ : Type*}
    [Finite σ] (M : Ideal (Tate σ)) [M.IsMaximal] :
    IsRegularLocalRing (Localization.AtPrime M) := by
  have : IsNoetherianRing (Tate σ) := isNoetherianRing_isRestricted_subring
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [← Localization.AtPrime.map_eq_maximalIdeal,
    IsLocalization.AtPrime.ringKrullDim_eq_height M (Localization.AtPrime M),
    Ideal.height_eq_natCard_of_isMaximal_isRestricted_subring]
  have := Ideal.spanFinrank_map_le_of_fg (algebraMap (Tate σ) (Localization.AtPrime M))
    (IsNoetherian.noetherian M)
  rw [Ideal.spanFinrank_eq_natCard_of_isMaximal_isRestricted_subring] at this
  exact_mod_cast this

end TauCeti.MvPowerSeries
