module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.KrullDimension
public import TauCeti.RingTheory.PowerSeries.Weierstrass.Quotient
