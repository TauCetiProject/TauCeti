module

public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Height
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import TauCeti.RingTheory.MvPowerSeries.Rescale

/-!
# Coordinate ideals of restricted power series

For a set `s` of variables, the *coordinate ideal* of the ring `R⟨c⁻¹X⟩` of restricted power
series is the ideal generated by the variables `Xᵢ` with `i ∈ s`, written here as the extension
`(Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted c)` of the corresponding ideal of
polynomials. For a finite `s` and nonzero radii at the variables of `s`, a restricted series lies
in it exactly when each of its monomials involves some `Xᵢ` with `i ∈ s`, as for polynomials
(`MvPolynomial.mem_ideal_span_X_image`). The point is that the quotient of such a series by `Xᵢ`
is again restricted (`MvPowerSeries.IsRestricted.of_X_mul`).

Consequently the coordinate ideals are prime over a normed domain, they grow strictly with `s`,
and the coordinate ideal of a finite `s` has height `s.ncard` once the restricted series form a
noetherian ring, as they do in finitely many variables at positive radii over a complete
nonarchimedean field (`TauCeti.MvPowerSeries.isNoetherianRing_isRestricted_subring`). In `n`
variables the ideals `(X₀, …, X_{i-1})`, `0 ≤ i ≤ n`, form a chain of primes of length `n`
(`TauCeti.MvPowerSeries.strictMono_map_span_X_image_setOf_lt`), whose last term has height `n`,
the Krull dimension of the Tate algebra `K⟨X₁, …, Xₙ⟩`.

The nonzero radii matter: with `c i = 0` and `c j = 1`, the series `Σₙ Xᵢ Xⱼⁿ` is restricted, but
its quotient `Σₙ Xⱼⁿ` by `Xᵢ` is not, so it does not lie in the ideal generated by `Xᵢ`.

## Main results

* `TauCeti.MvPowerSeries.mk_X_dvd_iff`: `Xᵢ` divides a restricted series exactly when its
  coefficients vanish at the exponents not involving `Xᵢ`.
* `TauCeti.MvPowerSeries.mem_map_span_X_image_iff`: the coefficient criterion for membership in
  a coordinate ideal, whose forward direction
  `TauCeti.MvPowerSeries.exists_mem_ne_zero_of_mem_map_span_X_image` holds for every `s`.
* `TauCeti.MvPowerSeries.map_span_X_image_isPrime`: coordinate ideals are prime over a domain.
* `TauCeti.MvPowerSeries.strictMono_map_span_X_image`: coordinate ideals grow strictly with the
  set of variables.
* `TauCeti.MvPowerSeries.height_map_span_X_image`: the coordinate ideal of a finite set `s` has
  height `s.ncard` in a noetherian ring of restricted series.
* `TauCeti.MvPowerSeries.strictMono_map_span_X_image_setOf_lt`: the coordinate ideals
  `(X₀, …, X_{i-1})`, `0 ≤ i ≤ n`, strictly increase with `i`.
-/

public section

namespace TauCeti.MvPowerSeries

open _root_.MvPowerSeries

variable {σ R : Type*} [NormedCommRing R] [IsUltrametricDist R] {c : σ → ℝ}

/-- The variable `Xᵢ` divides a restricted series, among restricted series at polyradii with
`c i ≠ 0`, exactly when the coefficients of the series vanish at the exponents not involving
`Xᵢ`. This is `MvPowerSeries.X_dvd_iff` inside the restricted series. -/
theorem mk_X_dvd_iff {i : σ} (hc : c i ≠ 0) {f : IsRestricted.subring (R := R) c} :
    (⟨X i, isRestricted_X c i⟩ : IsRestricted.subring (R := R) c) ∣ f ↔
      ∀ t : σ →₀ ℕ, t i = 0 → coeff t (f : MvPowerSeries σ R) = 0 := by
  rw [← _root_.MvPowerSeries.X_dvd_iff]
  refine ⟨fun ⟨g, hg⟩ ↦ ⟨g, by rw [hg, Subring.coe_mul]⟩, fun ⟨g, hg⟩ ↦ ?_⟩
  have hgr : IsRestricted c g := IsRestricted.of_X_mul hc (hg ▸ f.property)
  exact ⟨⟨g, hgr⟩, Subtype.ext hg⟩

/-- Coordinate ideals grow with the set of variables. -/
theorem monotone_map_span_X_image :
    Monotone fun s : Set σ ↦
      (Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted (R := R) c) :=
  fun _ _ h ↦ Ideal.map_mono (Ideal.span_mono (Set.image_mono h))

/-- The variable `Xᵢ` lies in the coordinate ideal of every set of variables containing `i`. -/
theorem X_mem_map_span_X_image {s : Set σ} {i : σ} (hi : i ∈ s) :
    (⟨X i, isRestricted_X c i⟩ : IsRestricted.subring (R := R) c) ∈
      (Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted c) := by
  rw [← polynomialToRestricted_X]
  exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, hi, rfl⟩)

/-- Setting the variables of `s` to zero, as a ring homomorphism from restricted series to
formal power series. -/
private noncomputable def evalZeroOn (s : Set σ) :
    IsRestricted.subring (R := R) c →+* _root_.MvPowerSeries σ R :=
  (rescale (sᶜ.indicator 1)).comp (IsRestricted.subring c).subtype

private theorem coeff_evalZeroOn_of_forall {s : Set σ} {t : σ →₀ ℕ} (ht : ∀ j ∈ s, t j = 0)
    (f : IsRestricted.subring (R := R) c) :
    coeff t (evalZeroOn s f) = coeff t (f : _root_.MvPowerSeries σ R) := by
  classical
  simp only [evalZeroOn, RingHom.comp_apply, coeff_rescale_indicator_compl, eq_true ht,
    ↓reduceIte, Subring.subtype_apply]

private theorem coeff_evalZeroOn_of_exists {s : Set σ} {t : σ →₀ ℕ} (ht : ∃ j ∈ s, t j ≠ 0)
    (f : IsRestricted.subring (R := R) c) : coeff t (evalZeroOn s f) = 0 := by
  classical
  obtain ⟨j, hj, htj⟩ := ht
  have h : ¬∀ j ∈ s, t j = 0 := fun h ↦ htj (h j hj)
  simp only [evalZeroOn, RingHom.comp_apply, coeff_rescale_indicator_compl, eq_false h,
    ↓reduceIte]

/-- If setting the variables of `s` to zero kills a restricted series, then each of its monomials
involves one of these variables. -/
private theorem exists_mem_ne_zero_of_evalZeroOn_eq_zero {s : Set σ}
    {f : IsRestricted.subring (R := R) c} (hf : evalZeroOn s f = 0) (t : σ →₀ ℕ)
    (ht : coeff t (f : _root_.MvPowerSeries σ R) ≠ 0) : ∃ i ∈ s, t i ≠ 0 := by
  by_contra! h
  exact ht (by rw [← coeff_evalZeroOn_of_forall h, hf, map_zero])

/-- The variables of `s` generate an ideal killed by setting them to zero. -/
private theorem map_span_X_image_le_ker (s : Set σ) :
    (Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted (R := R) c) ≤
      RingHom.ker (evalZeroOn s) := by
  rw [Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨i, hi, rfl⟩, rfl⟩
  classical
  rw [SetLike.mem_coe, RingHom.mem_ker]
  ext t
  by_cases ht : ∃ j ∈ s, t j ≠ 0
  · rw [coeff_evalZeroOn_of_exists ht, map_zero]
  · have ht' : t ≠ Finsupp.single i 1 := fun h ↦ ht ⟨i, hi, by simp [h]⟩
    rw [coeff_evalZeroOn_of_forall (by simpa using ht), coe_polynomialToRestricted,
      MvPolynomial.coe_X, coeff_X, map_zero]
    simp [ht']

/-- Every monomial of a restricted series in the ideal generated by the variables `Xᵢ`, `i ∈ s`,
involves one of these variables. Unlike `TauCeti.MvPowerSeries.mem_map_span_X_image_iff`, this
direction holds for every set `s` and all polyradii. -/
theorem exists_mem_ne_zero_of_mem_map_span_X_image {s : Set σ}
    {f : IsRestricted.subring (R := R) c}
    (hf : f ∈ (Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted c)) (t : σ →₀ ℕ)
    (ht : coeff t (f : _root_.MvPowerSeries σ R) ≠ 0) : ∃ i ∈ s, t i ≠ 0 :=
  exists_mem_ne_zero_of_evalZeroOn_eq_zero (map_span_X_image_le_ker s hf) t ht

/-- **Membership in a coordinate ideal.** For a finite set `s` of variables with nonzero radii, a
restricted series lies in the ideal generated by the variables `Xᵢ`, `i ∈ s`, exactly when each of
its monomials involves one of these variables. This is the restricted analogue of
`MvPolynomial.mem_ideal_span_X_image`. -/
theorem mem_map_span_X_image_iff {s : Set σ} (hs : s.Finite) (hc : ∀ i ∈ s, c i ≠ 0)
    {f : IsRestricted.subring (R := R) c} :
    f ∈ (Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted c) ↔
      ∀ t : σ →₀ ℕ, coeff t (f : _root_.MvPowerSeries σ R) ≠ 0 → ∃ i ∈ s, t i ≠ 0 := by
  refine ⟨exists_mem_ne_zero_of_mem_map_span_X_image, ?_⟩
  induction s, hs using Set.Finite.induction_on generalizing f with
  | empty =>
    intro hf
    have : f = 0 := Subtype.ext <| ext fun t ↦ by
      by_contra ht
      simpa using hf t ht
    simp [this]
  | @insert i s hi _ ih =>
    intro hf
    -- Split `f` into its part `g` free of `Xᵢ`, and the rest, which `Xᵢ` divides.
    set g : IsRestricted.subring (R := R) c :=
      ⟨evalZeroOn {i} f, f.property.rescale_indicator_compl {i}⟩
    have hgs : g ∈ (Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted c) := by
      refine ih (fun j hj ↦ hc j (Set.mem_insert_of_mem i hj)) fun t ht ↦ ?_
      by_cases hti : t i = 0
      · obtain ⟨j, hj, htj⟩ :=
          hf t (by rwa [← coeff_evalZeroOn_of_forall (s := {i}) (by simpa using hti)])
        rcases hj with rfl | hj
        · exact absurd hti htj
        · exact ⟨j, hj, htj⟩
      · exact absurd (coeff_evalZeroOn_of_exists ⟨i, rfl, hti⟩ f) ht
    obtain ⟨q, hq⟩ := (mk_X_dvd_iff (hc i (Set.mem_insert i s)) (f := f - g)).mpr fun t ht ↦ by
      rw [AddSubgroupClass.coe_sub, map_sub, coeff_evalZeroOn_of_forall (by simpa using ht),
        sub_self]
    rw [← sub_add_cancel f g, hq]
    exact add_mem (Ideal.mul_mem_right _ _ (X_mem_map_span_X_image (Set.mem_insert i s)))
      (monotone_map_span_X_image (Set.subset_insert i s) hgs)

/-- For a finite set of variables with nonzero radii, the coordinate ideal is the kernel of
setting these variables to zero. -/
private theorem map_span_X_image_eq_ker {s : Set σ} (hs : s.Finite) (hc : ∀ i ∈ s, c i ≠ 0) :
    (Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted (R := R) c) =
      RingHom.ker (evalZeroOn s) :=
  le_antisymm (map_span_X_image_le_ker s) fun _ hf ↦
    (mem_map_span_X_image_iff hs hc).mpr
      (exists_mem_ne_zero_of_evalZeroOn_eq_zero (RingHom.mem_ker.mp hf))

/-- **Coordinate ideals are prime.** Over a normed domain, the ideal of restricted series
generated by the variables `Xᵢ`, `i ∈ s`, is prime whenever their radii are nonzero; `s` may be
infinite. This is the restricted analogue of `MvPolynomial.span_X_image_isPrime`. -/
theorem map_span_X_image_isPrime [IsDomain R] {s : Set σ} (hc : ∀ i ∈ s, c i ≠ 0) :
    ((Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted (R := R) c)).IsPrime := by
  classical
  -- Finitely many variables: the ideal is the kernel of a map to a domain.
  have hfin {s' : Set σ} (hs' : s'.Finite) (hs's : s' ⊆ s) :
      ((Ideal.span (MvPolynomial.X '' s')).map (polynomialToRestricted (R := R) c)).IsPrime := by
    rw [map_span_X_image_eq_ker hs' fun i hi ↦ hc i (hs's hi)]
    exact RingHom.ker_isPrime _
  refine ⟨fun h ↦ ?_, fun {f g} hfg ↦ ?_⟩
  · -- The coordinate ideal of `s` misses `1`, since setting the variables to zero keeps `1`.
    have h1 := map_span_X_image_le_ker (R := R) (c := c) s ((Ideal.eq_top_iff_one _).mp h)
    exact one_ne_zero (by rwa [RingHom.mem_ker, map_one] at h1)
  · -- A product in the ideal already lies in the coordinate ideal of finitely many variables.
    rw [Ideal.map_span, Set.image_image] at hfg
    obtain ⟨T, hTs, hT⟩ := Submodule.mem_span_finite_of_mem_span hfg
    obtain ⟨s', hs's, rfl⟩ := Finset.subset_set_image_iff.mp hTs
    have hle := monotone_map_span_X_image (R := R) (c := c) hs's
    have hfg' : f * g ∈ (Ideal.span (MvPolynomial.X '' (s' : Set σ))).map
        (polynomialToRestricted (R := R) c) := by
      rwa [Ideal.map_span, Set.image_image, ← Finset.coe_image]
    exact ((hfin s'.finite_toSet hs's).mem_or_mem hfg').imp (hle ·) (hle ·)

/-- **Coordinate ideals grow strictly with the set of variables.** Over a nontrivial ring, if
`s ⊂ s'`, then the ideal of restricted series generated by the variables of `s` is strictly
smaller than the one generated by the variables of `s'`. -/
theorem strictMono_map_span_X_image [Nontrivial R] :
    StrictMono fun s : Set σ ↦
      (Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted (R := R) c) := by
  intro s s' hss'
  refine lt_of_le_not_ge (monotone_map_span_X_image hss'.subset) fun h ↦ ?_
  -- A variable `Xᵢ` with `i ∈ s' \ s` would lie in the coordinate ideal of `s`.
  obtain ⟨i, hi', hi⟩ := Set.exists_of_ssubset hss'
  obtain ⟨j, hj, hji⟩ := exists_mem_ne_zero_of_mem_map_span_X_image
    (h (X_mem_map_span_X_image hi')) (Finsupp.single i 1) (by simp)
  rw [Finsupp.single_apply_ne_zero] at hji
  exact hi (hji.1 ▸ hj)

/-- Over a normed domain, the coordinate ideal of a finite set `s` of variables with nonzero radii
has height at least `s.ncard`: the coordinate ideals of the subsets of `s` contain a chain of
primes of that length. -/
theorem ncard_le_height_map_span_X_image [IsDomain R] {s : Set σ} (hs : s.Finite)
    (hc : ∀ i ∈ s, c i ≠ 0) :
    (s.ncard : ℕ∞) ≤
      ((Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted (R := R) c)).height := by
  induction s, hs using Set.Finite.induction_on with
  | empty => simp
  | @insert i s hi hs ih =>
    have hc' : ∀ j ∈ s, c j ≠ 0 := fun j hj ↦ hc j (Set.mem_insert_of_mem i hj)
    have := map_span_X_image_isPrime (R := R) hc
    have := map_span_X_image_isPrime (R := R) hc'
    have hlt : (Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted (R := R) c) <
        (Ideal.span (MvPolynomial.X '' insert i s)).map (polynomialToRestricted c) :=
      strictMono_map_span_X_image (Set.ssubset_insert hi)
    rw [Set.ncard_insert_of_notMem hi hs, Nat.cast_add, Nat.cast_one]
    calc ((s.ncard : ℕ) : ℕ∞) + 1
        ≤ ((Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted (R := R) c)).height +
          1 := by gcongr; exact ih hc'
      _ ≤ _ := Ideal.height_add_one_le_of_lt_of_isPrime hlt

/-- **Heights of coordinate ideals.** If the restricted series over a normed domain form a
noetherian ring, as they do in finitely many variables at positive radii over a complete
nonarchimedean field (`TauCeti.MvPowerSeries.isNoetherianRing_isRestricted_subring`), then the
ideal generated by the variables of a finite set `s` with nonzero radii has height `s.ncard`. -/
theorem height_map_span_X_image [IsDomain R] [IsNoetherianRing (IsRestricted.subring (R := R) c)]
    {s : Set σ} (hs : s.Finite) (hc : ∀ i ∈ s, c i ≠ 0) :
    ((Ideal.span (MvPolynomial.X '' s)).map (polynomialToRestricted (R := R) c)).height =
      s.ncard := by
  refine le_antisymm ?_ (ncard_le_height_map_span_X_image hs hc)
  rw [Ideal.map_span, Set.image_image]
  have hne := (map_span_X_image_isPrime (R := R) hc).ne_top
  rw [Ideal.map_span, Set.image_image] at hne
  exact (Ideal.height_span_le_ncard_of_span_ne_top (hs.image _) hne).trans
    (Nat.cast_le.mpr (Set.ncard_image_le hs))

/-- **The chain of coordinate primes.** In `n` variables, the coordinate ideals
`(X₀, …, X_{i-1})`, `0 ≤ i ≤ n`, strictly increase with `i`, from `0` to the ideal of all the
variables. Over a normed domain at nonzero radii they are prime
(`TauCeti.MvPowerSeries.map_span_X_image_isPrime`), so they form a chain of prime ideals of length
`n`. -/
theorem strictMono_map_span_X_image_setOf_lt [Nontrivial R] {n : ℕ} {c : Fin n → ℝ} :
    StrictMono fun i : Fin (n + 1) ↦
      (Ideal.span (MvPolynomial.X '' {j : Fin n | (j : ℕ) < i})).map
        (polynomialToRestricted (R := R) c) := by
  intro i i' hii'
  rw [Fin.lt_def] at hii'
  have hi : (i : ℕ) < n := hii'.trans_le (Nat.lt_succ_iff.mp i'.isLt)
  refine strictMono_map_span_X_image (ssubset_of_subset_not_subset (fun j hj ↦ ?_) fun h ↦ ?_)
  · simp only [Set.mem_ofPred_eq] at hj ⊢
    exact hj.trans hii'
  · -- The variable `Xᵢ` is among the generators for `i'` but not for `i`.
    have hmem : (⟨i, hi⟩ : Fin n) ∈ {j : Fin n | (j : ℕ) < i} := h (by simpa using hii')
    simp at hmem

end TauCeti.MvPowerSeries
