module

public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.ClosedIdeal
public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.Nullstellensatz
import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.Polynomial
import TauCeti.Topology.Algebra.Module.FiniteDimension

/-!
# Maximal ideals of Tate algebras are generated by polynomials

Let `K` be a complete nontrivially normed ultrametric field and `T = K{X/c}` the algebra of
restricted power series in finitely many variables at positive polyradii `c`. If `I` is an ideal of
`T` with `T ⧸ I` finite-dimensional over `K`, then `I` is generated by the polynomials it contains,
and every residue class modulo `I` contains a polynomial:

```text
I = (I ∩ K[X]) T,      K[X] ⧸ (I ∩ K[X]) ≃ₐ[K] T ⧸ I.
```

Over the unit polyradius every maximal ideal `m` of `Tₙ = K⟨X₁, …, Xₙ⟩` has a residue field finite
over `K` (`TauCeti.MvPowerSeries.finite_quotient_of_isMaximal`), so `m ∩ K[X]` is a maximal ideal
of the polynomial ring, `m` is generated by finitely many polynomials, and `m` is determined by
`m ∩ K[X]`.

Both statements are consequences of the topology of `T`. Every ideal of `T` is closed
(`TauCeti.MvPowerSeries.isClosed_ideal_isRestrictedSubring`) and the polynomials are dense
(`TauCeti.MvPowerSeries.denseRange_polynomialToRestricted`), so a closed subspace of finite
codimension meets them in a dense subspace of itself (`Submodule.closure_inf_eq_of_dense`) and
together with them spans `T` (`Submodule.sup_eq_top_of_dense`).

## Main results

* `Ideal.map_comap_polynomialToRestricted_of_finite`: an ideal of finite codimension is generated
  by the polynomials it contains.
* `Ideal.polynomialQuotientAlgEquiv`: for such an ideal `I`, the comparison
  `K[X] ⧸ (I ∩ K[X]) ≃ₐ[K] T ⧸ I`.
* `Ideal.exists_finset_span_polynomialToRestricted_eq_of_finite`: such an ideal is generated by
  finitely many polynomials.
* `Ideal.isMaximal_comap_polynomialToRestricted`: the polynomials in a maximal ideal of `Tₙ` form
  a maximal ideal of `K[X]`.
* `Ideal.map_comap_polynomialToRestricted_of_isMaximal`: every maximal ideal of `Tₙ` is generated
  by the polynomials it contains.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §7.1.1.
-/

public section

namespace Ideal

open MvPowerSeries TauCeti.MvPowerSeries

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {σ : Type*} [Finite σ]

section FiniteCodimension

variable {c : σ → ℝ} [∀ i, Fact (0 < c i)]

variable (I : Ideal (IsRestricted.subring (R := K) c))
  [Module.Finite K (IsRestricted.subring c ⧸ I)]

/-- Modulo an ideal of finite codimension, every restricted series is congruent to a polynomial. -/
theorem quotientMkₐ_comp_polynomialToRestricted_surjective :
    Function.Surjective ((Ideal.Quotient.mkₐ K I).comp (polynomialToRestricted (R := K) c)) := by
  have := Module.Finite.equiv (Submodule.Quotient.restrictScalarsEquiv K I).symm
  intro y
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
  have htop := Submodule.sup_eq_top_of_dense (S := I.restrictScalars K)
    (D := (polynomialToRestricted (R := K) c).toLinearMap.range)
    (isClosed_ideal_isRestrictedSubring I) denseRange_polynomialToRestricted
  obtain ⟨g, hg, _, ⟨p, rfl⟩, hgp⟩ := Submodule.mem_sup.mp (htop ▸ Submodule.mem_top (x := f))
  refine ⟨p, ?_⟩
  rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, ← hgp, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
  simpa using I.neg_mem hg

/-- **An ideal of finite codimension is generated by its polynomials.** If `T ⧸ I` is
finite-dimensional over `K`, then `I` is generated by `I ∩ K[X]`. -/
theorem map_comap_polynomialToRestricted_of_finite :
    (I.comap (polynomialToRestricted (R := K) c)).map (polynomialToRestricted (R := K) c) = I := by
  have := Module.Finite.equiv (Submodule.Quotient.restrictScalarsEquiv K I).symm
  refine (Ideal.map_comap_le).antisymm fun f hf ↦ ?_
  -- `I ∩ K[X]` is dense in `I`, and the ideal it generates is closed.
  have hsub : ((I.restrictScalars K ⊓ (polynomialToRestricted (R := K) c).toLinearMap.range :
      Submodule K _) : Set (IsRestricted.subring (R := K) c)) ⊆
        (I.comap (polynomialToRestricted (R := K) c)).map (polynomialToRestricted (R := K) c) := by
    rintro _ ⟨hgI, p, rfl⟩
    exact Ideal.mem_map_of_mem _ (Ideal.mem_comap.mpr hgI)
  rw [← SetLike.mem_coe, ← (isClosed_ideal_isRestrictedSubring _).closure_eq]
  refine closure_mono hsub ?_
  rwa [Submodule.closure_inf_eq_of_dense (S := I.restrictScalars K)
    (D := (polynomialToRestricted (R := K) c).toLinearMap.range)
    (isClosed_ideal_isRestrictedSubring I) denseRange_polynomialToRestricted]

/-- An ideal of finite codimension is generated by finitely many polynomials. -/
theorem exists_finset_span_polynomialToRestricted_eq_of_finite :
    ∃ s : Finset (MvPolynomial σ K), Ideal.span (polynomialToRestricted (R := K) c '' s) = I := by
  obtain ⟨s, hs⟩ := IsNoetherian.noetherian (I.comap (polynomialToRestricted (R := K) c))
  rw [Ideal.submodule_span_eq] at hs
  refine ⟨s, ?_⟩
  rw [← Ideal.map_span, hs, map_comap_polynomialToRestricted_of_finite]

/-- For an ideal `I` of finite codimension, the polynomials modulo `I ∩ K[X]` are the restricted
series modulo `I`. -/
noncomputable def polynomialQuotientAlgEquiv :
    (MvPolynomial σ K ⧸ I.comap (polynomialToRestricted (R := K) c)) ≃ₐ[K]
      IsRestricted.subring (R := K) c ⧸ I :=
  AlgEquiv.ofBijective (Ideal.quotientMapₐ I (polynomialToRestricted (R := K) c) le_rfl)
    ⟨Ideal.quotientMap_injective, fun y ↦ by
      obtain ⟨p, hp⟩ := quotientMkₐ_comp_polynomialToRestricted_surjective I y
      exact ⟨Ideal.Quotient.mk _ p, hp⟩⟩

/-- The comparison `K[X] ⧸ (I ∩ K[X]) ≃ₐ[K] T ⧸ I` sends the class of a polynomial to the class of
the corresponding restricted series. -/
@[simp]
theorem polynomialQuotientAlgEquiv_mk (p : MvPolynomial σ K) :
    polynomialQuotientAlgEquiv I (Ideal.Quotient.mk _ p) =
      Ideal.Quotient.mk I (polynomialToRestricted (R := K) c p) :=
  (rfl)

/-- If a maximal ideal `I` has a residue field finite over `K`, the polynomials in `I` form a
maximal ideal of `K[X]`. -/
theorem isMaximal_comap_polynomialToRestricted_of_finite [I.IsMaximal] :
    (I.comap (polynomialToRestricted (R := K) c)).IsMaximal := by
  have hker : RingHom.ker ((Ideal.Quotient.mkₐ K I).comp (polynomialToRestricted (R := K) c)) =
      I.comap (polynomialToRestricted (R := K) c) := by
    ext p
    simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
  let := Ideal.Quotient.field I
  exact hker ▸ RingHom.ker_isMaximal_of_surjective _
    (quotientMkₐ_comp_polynomialToRestricted_surjective I)

end FiniteCodimension

section Maximal

variable (m : Ideal (IsRestricted.subring (R := K) (fun _ : σ ↦ (1 : ℝ)))) [m.IsMaximal]

/-- The polynomials in a maximal ideal `m` of `K⟨X₁, …, Xₙ⟩` form a maximal ideal of `K[X]`. -/
theorem isMaximal_comap_polynomialToRestricted :
    (m.comap (polynomialToRestricted (R := K) (fun _ : σ ↦ (1 : ℝ)))).IsMaximal :=
  have := finite_quotient_of_isMaximal m
  isMaximal_comap_polynomialToRestricted_of_finite m

/-- **Maximal ideals of Tate algebras are generated by polynomials.** Every maximal ideal `m` of
`K⟨X₁, …, Xₙ⟩` is generated by `m ∩ K[X]`. -/
theorem map_comap_polynomialToRestricted_of_isMaximal :
    (m.comap (polynomialToRestricted (R := K) (fun _ : σ ↦ (1 : ℝ)))).map
      (polynomialToRestricted (R := K) (fun _ : σ ↦ (1 : ℝ))) = m :=
  have := finite_quotient_of_isMaximal m
  map_comap_polynomialToRestricted_of_finite m

end Maximal

end Ideal
