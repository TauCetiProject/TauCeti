module

public import Mathlib.RingTheory.AdjoinRoot
public import TauCeti.RingTheory.FrobeniusAlgebra.Basic

/-!
# The truncated polynomial algebra is a symmetric Frobenius algebra

For a field `k` and `n > 0`, the truncated polynomial algebra `k[X]/(Xⁿ)` carries a symmetric
Frobenius functional: the coefficient of `X^(n-1)`, read off the canonical representative of degree
less than `n`. It is a trace because the algebra is commutative, and it is nondegenerate because
multiplying an element by a power of `X` shifts its leading coefficient into degree `n - 1`.

The algebra is realised as `AdjoinRoot (X ^ n)`, which is by definition the quotient of `k[X]` by
the ideal generated by `Xⁿ`; its element `AdjoinRoot.root (X ^ n)` is the residue class of `X`.

No restriction on the characteristic of `k` is needed.

## Main definitions

* `TauCeti.truncatedPolynomialFunctional`: the coefficient of `X^(n-1)` on `k[X]/(Xⁿ)`.
* `TauCeti.truncatedPolynomialFrobenius`: it is a symmetric Frobenius functional.
-/

public section

namespace TauCeti

open Polynomial

variable (k : Type*) [Field k] (n : ℕ)

/-- The coefficient of `X^(n-1)`, as a linear functional on `k[X]/(Xⁿ)`: it reads that coefficient
off the canonical representative of degree less than `n`. -/
noncomputable def truncatedPolynomialFunctional :
    AdjoinRoot (X ^ n : k[X]) →ₗ[k] k :=
  (Polynomial.lcoeff k (n - 1)).comp (AdjoinRoot.modByMonicHom (monic_X_pow n))

variable {k n}

/-- The functional reads the coefficient of `X^(n-1)` off any representative, not only off the
canonical one of degree less than `n`: the discarded multiples of `Xⁿ` have no coefficient below
degree `n`. -/
theorem truncatedPolynomialFunctional_mk (hn : 0 < n) (p : k[X]) :
    truncatedPolynomialFunctional k n (AdjoinRoot.mk _ p) = p.coeff (n - 1) := by
  have hlt : ¬ n ≤ n - 1 := by omega
  simp only [truncatedPolynomialFunctional, LinearMap.comp_apply,
    AdjoinRoot.modByMonicHom_mk, Polynomial.lcoeff_apply]
  rw [modByMonic_eq_sub_mul_div p (X ^ n : k[X]), coeff_sub, mul_comm, coeff_mul_X_pow']
  simp [hlt]

/-- The functional picks out the socle: it is `1` on `X^(n-1)` and `0` on every other power of
`X`. -/
theorem truncatedPolynomialFunctional_root_pow (hn : 0 < n) (i : ℕ) :
    truncatedPolynomialFunctional k n (AdjoinRoot.root (X ^ n : k[X]) ^ i)
      = if i = n - 1 then 1 else 0 := by
  rw [← AdjoinRoot.mk_X, ← map_pow, truncatedPolynomialFunctional_mk hn, coeff_X_pow]
  simp [eq_comm]

/-- The pairing of the coefficient functional is nondegenerate: multiplying a nonzero element of
degree `d < n` by `X^(n-1-d)` moves its leading coefficient into degree `n - 1`. -/
theorem truncatedPolynomialFunctional_left_nondegenerate (hn : 0 < n)
    (a : AdjoinRoot (X ^ n : k[X]))
    (ha : ∀ b, truncatedPolynomialFunctional k n (a * b) = 0) : a = 0 := by
  obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective a
  set p : k[X] := q %ₘ (X ^ n : k[X]) with hpdef
  have hmk : AdjoinRoot.mk (X ^ n : k[X]) p = AdjoinRoot.mk (X ^ n : k[X]) q := by
    rw [hpdef, ← AdjoinRoot.modByMonicHom_mk (monic_X_pow n) q]
    exact AdjoinRoot.mk_leftInverse (monic_X_pow n) _
  rw [← hmk]
  by_contra hne
  have hp0 : p ≠ 0 := fun h => hne (by rw [h, map_zero])
  have hdeg : p.natDegree < n := by
    have := degree_modByMonic_lt q (monic_X_pow (R := k) n)
    rw [degree_X_pow, ← hpdef] at this
    exact natDegree_lt_iff_degree_lt hp0 |>.2 (by exact_mod_cast this)
  obtain ⟨t, ht⟩ : ∃ t, n - 1 = p.natDegree + t := ⟨n - 1 - p.natDegree, by omega⟩
  have key := ha (AdjoinRoot.mk (X ^ n : k[X]) (X ^ t))
  rw [← hmk, ← map_mul, truncatedPolynomialFunctional_mk hn, ht, coeff_mul_X_pow] at key
  exact leadingCoeff_ne_zero.2 hp0 key

variable (k) in
/-- **The truncated polynomial algebra `k[X]/(Xⁿ)` is a symmetric Frobenius algebra** for `n > 0`,
with the coefficient of `X^(n-1)` as its Frobenius functional. -/
noncomputable def truncatedPolynomialFrobenius (hn : 0 < n) :
    SymmetricFrobeniusFunctional k (AdjoinRoot (X ^ n : k[X])) :=
  SymmetricFrobeniusFunctional.ofLeftNondegenerate (truncatedPolynomialFunctional k n)
    (fun a b => by rw [mul_comm]) (truncatedPolynomialFunctional_left_nondegenerate hn)

variable (k) in
@[simp]
theorem truncatedPolynomialFrobenius_functional (hn : 0 < n) :
    (truncatedPolynomialFrobenius k hn).functional = truncatedPolynomialFunctional k n :=
  SymmetricFrobeniusFunctional.ofLeftNondegenerate_functional _ _ _

end TauCeti
