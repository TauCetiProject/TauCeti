public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
public import Mathlib.RingTheory.Localization.FractionRing
import Mathlib.RingTheory.Algebraic.Integral

/-!
# Finite-dimensionality of a fraction field over an intermediate field

Let `S` be finite as a module over `R`, and let `L` be a fraction field of `S`. Then `L` is
finite-dimensional over *any* intermediate field `K`, that is, any field sitting in a tower
`R → K → L`. Mathlib proves this only for the concrete `FractionRing R` and `FractionRing S`;
the statement here is about abstract fraction fields and an arbitrary intermediate field.

## Main results

* `TauCeti.IsFractionRing.finiteDimensional_of_finite`: `L` is finite-dimensional over `K`.

## Implementation notes

The `K`-subalgebra `A` of `L` generated by the image of `S` is spanned over `K` by the image of a
finite `R`-generating set of `S`, so it is a finite `K`-module and its elements are integral over
`K`. Hence `A` contains the inverse of each of its nonzero elements, and since every element of
`L` is a quotient of elements of the image of `S`, `A` is all of `L`.

## References

* [Stacks: Lemma 10.161.5 (tag 032I)](https://stacks.math.columbia.edu/tag/032I)
-/

public section

namespace TauCeti

/-- For `B` integral over `A`, the fraction field `L` of `B` is spanned by `B` over any field `K`
between `A` and `L`. -/
theorem span_range_algebraMap_eq_top {A B L : Type*} (K : Type*) [CommRing A] [Field K]
    [Algebra A K] [CommRing B] [Algebra A B] [Field L] [Algebra B L] [IsFractionRing B L]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L]
    [Algebra.IsIntegral A B] :
    Submodule.span K (Set.range (algebraMap B L)) = ⊤ := by
  let S : Subalgebra K L := Algebra.adjoin K (Set.range (algebraMap B L))
  have hS : Subalgebra.toSubmodule S = Submodule.span K (Set.range (algebraMap B L)) := by
    rw [Algebra.adjoin_eq_span, ← MonoidHom.coe_mrange, Submonoid.closure_eq]
  rw [← hS, eq_top_iff]
  intro x _
  obtain ⟨β, γ, -, rfl⟩ := IsFractionRing.div_surjective (A := B) x
  have hγS : algebraMap B L γ ∈ S := Algebra.subset_adjoin ⟨γ, rfl⟩
  have hγK : IsAlgebraic K (algebraMap B L γ) :=
    (((Algebra.IsIntegral.isIntegral (R := A) γ).map (IsScalarTower.toAlgHom A B L)).tower_top
      (A := K)).isAlgebraic
  rw [div_eq_mul_inv]
  exact S.mul_mem (Algebra.subset_adjoin ⟨β, rfl⟩)
    (Subalgebra.inv_mem_of_algebraic S (x := ⟨_, hγS⟩) hγK)

/-- A fraction field `L` of a ring `S` that is finite as an `R`-module is finite-dimensional
over any intermediate field `K`, that is, any field with `R → K → L`.

This is the content of Stacks, Lemma 10.161.5 (tag 032I), under weaker hypotheses: `K` need not
be a fraction field of `R`, and `R` is only a commutative semiring. No explicit `IsDomain S`
hypothesis is needed, since `IsFractionRing S L` with `L` a field already forces `S` to be a
domain. -/
theorem IsFractionRing.finiteDimensional_of_finite (R S K L : Type*) [CommSemiring R] [CommRing S]
    [Algebra R S] [Module.Finite R S]
    [Field K] [Field L] [Algebra R K] [Algebra S L] [IsFractionRing S L]
    [Algebra K L] [Algebra R L] [IsScalarTower R K L] [IsScalarTower R S L] :
    FiniteDimensional K L := by
  obtain ⟨t, ht⟩ := Module.finite_def.mp ‹Module.Finite R S›
  -- `A` is the `K`-subalgebra of `L` generated by the image of `S`.
  set A := Algebra.adjoin K (Set.range (algebraMap S L))
  -- As a `K`-module, `A` is spanned by the image of a finite `R`-generating set of `S`, since the
  -- image of `S` is closed under multiplication and lies in the `R`-span of that image.
  have hfg : A.toSubmodule.FG := by
    suffices A.toSubmodule = Submodule.span K (algebraMap S L '' t) from
      this ▸ Submodule.fg_span (t.finite_toSet.image _)
    refine le_antisymm ((Algebra.adjoin_toSubmodule_le K).mpr ?_)
      (Submodule.span_le.mpr ((Set.image_subset_range _ _).trans Algebra.subset_adjoin))
    rw [← MonoidHom.coe_mrange, Submonoid.closure_eq]
    rintro _ ⟨x, rfl⟩
    exact Submodule.span_subset_span R K _
      (Submodule.map_mem_span_algebraMap_image x _ (ht ▸ Submodule.mem_top))
  -- Every element of `A` is integral over `K`, so `A` contains the inverses of its nonzero
  -- elements; as `L` is a fraction field of `S`, this makes `A` all of `L`.
  have htop : A = ⊤ := eq_top_iff.mpr fun z _ ↦ by
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := S) z
    have hb : algebraMap S L b ∈ A := Algebra.subset_adjoin ⟨b, rfl⟩
    rw [div_eq_mul_inv]
    exact A.mul_mem (Algebra.subset_adjoin ⟨a, rfl⟩) <| Algebra.adjoin_le
      (Set.singleton_subset_iff.mpr hb) (IsIntegral.of_mem_of_fg A hfg _ hb).inv_mem_adjoin
  rw [htop, Algebra.top_toSubmodule] at hfg
  exact Module.finite_def.mpr hfg

end TauCeti

end
