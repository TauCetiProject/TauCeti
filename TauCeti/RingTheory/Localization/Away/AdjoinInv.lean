module

public import Mathlib.RingTheory.Localization.Integral

/-!
# Inverting a unit in an adjoined subalgebra and in its integral closure

Let `B` be a commutative `R`-algebra and `u` a unit of `B`. Inside `B`, the subalgebra
`R[u, u⁻¹]` generated by `u` and `u⁻¹` is the localization of `R[u]` away from `u`, and the
integral closure of `R[u, u⁻¹]` in `B` is the localization away from `u` of the integral closure
of `R[u]` in `B`. Concretely, an element `x` of `B` is integral over `R[u, u⁻¹]` exactly when
`uⁿ x` is integral over `R[u]` for some `n`.

These are the chart comparisons of the normalization of the projective line in `B` along `u`:
its two affine charts are the integral closures of `R[u]` and `R[u⁻¹]`, and both localize to the
integral closure of `R[u, u⁻¹] = R[u⁻¹, u]`, along which they are glued. No hypothesis on `R` or
`B` is needed: all three rings are subrings of `B`, in which `u` is already invertible.

The localization statements accept any algebra structure between the two subrings that is
compatible with their inclusions into `B`, as Mathlib's `IsLocalization.Away.integralClosure`
does.

## Main definitions

* `Units.integralClosureAdjoinGen`: the unit `u` as an element of the integral closure of `R[u]`
  in `B`, the element the integral closures below are localized away from.

## Main results

* `Units.isLocalization_away_adjoin_insert_inv`: `R[u, u⁻¹]` is the localization of `R[u]`
  away from `u`.
* `Units.exists_isIntegral_adjoin_pow_mul`: if `x` is integral over `R[u, u⁻¹]`, then `uⁿ x` is
  integral over `R[u]` for some `n`; `Units.isIntegral_adjoin_insert_inv_iff` is the resulting
  characterization.
* `Units.isLocalization_away_integralClosure_adjoin_insert_inv`: the integral closure of
  `R[u, u⁻¹]` in `B` is the localization away from `u` of the integral closure of `R[u]` in `B`;
  `Units.isLocalization_away_inv_integralClosure_adjoin_insert_inv` is the same statement for
  the integral closure of `R[u⁻¹]`, away from `u⁻¹`.

The localization of the integral closures is Mathlib's `IsLocalization.Away.integralClosure`
(integral closure commutes with localization away from one element), applied with `B` as its own
localization away from the unit `u`. Mathlib's
`IsIntegral.exists_multiple_integral_of_isLocalization` gives the integrality statements
`Units.exists_isIntegral_adjoin_pow_mul` and `Units.isIntegral_adjoin_insert_inv_iff`.

## References

* The Stacks Project, Section 10.36 (finite and integral ring extensions): integral closure
  commutes with localization.
-/

public section

namespace Units

open Algebra Pointwise

variable {B : Type*} [CommRing B] (u : Bˣ)

/-! ### The subalgebra generated by a unit and its inverse -/

section Adjoin

variable {R : Type*} [CommSemiring R] [Algebra R B]

/-- `R[u]` lies in `R[u, u⁻¹]`. -/
theorem adjoin_singleton_le_adjoin_insert_inv :
    adjoin R {(u : B)} ≤ adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)} :=
  adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))

/-- **Every element of `R[u, u⁻¹]` becomes an element of `R[u]` after multiplying by a power of
`u`.** -/
theorem exists_pow_mul_mem_adjoin_singleton {x : B}
    (hx : x ∈ adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) :
    ∃ n : ℕ, (u : B) ^ n * x ∈ adjoin R {(u : B)} := by
  have hs : (u : B) • ({(u : B), ((u⁻¹ : Bˣ) : B)} : Set B) ⊆ (adjoin R {(u : B)} : Set B) := by
    rintro _ ⟨_, (rfl | rfl), rfl⟩
    · simpa [smul_eq_mul, ← sq] using pow_mem (self_mem_adjoin_singleton R (u : B)) 2
    · simp [smul_eq_mul]
  obtain ⟨n, hn⟩ := pow_smul_mem_of_smul_subset_of_mem_adjoin (u : B) _ _ hs hx
    (self_mem_adjoin_singleton R _)
  exact ⟨n, by simpa [smul_eq_mul] using hn n le_rfl⟩

/-- **`R[u, u⁻¹]` is the localization of `R[u]` away from `u`**, for any algebra structure of
`R[u, u⁻¹]` over `R[u]` compatible with their inclusions into `B`. -/
theorem isLocalization_away_adjoin_insert_inv
    [Algebra (adjoin R {(u : B)}) (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)})]
    [IsScalarTower (adjoin R {(u : B)}) (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B] :
    IsLocalization.Away (⟨u, self_mem_adjoin_singleton R _⟩ : adjoin R {(u : B)})
      (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) := by
  -- The structure map is the inclusion, as one sees after composing with `B`.
  have hcoe (y : adjoin R {(u : B)}) :
      ((algebraMap (adjoin R {(u : B)}) (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) y :
        adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) : B) = y :=
    (IsScalarTower.algebraMap_apply (adjoin R {(u : B)}) (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)})
      B y).symm
  refine IsLocalization.Away.mk _ ?_ (fun c ↦ ?_) fun y z h ↦ ⟨0, ?_⟩
  · refine IsUnit.of_mul_eq_one ⟨_, subset_adjoin (Set.mem_insert_of_mem _ rfl)⟩ ?_
    exact Subtype.ext (by simp [hcoe])
  · obtain ⟨n, hn⟩ := exists_pow_mul_mem_adjoin_singleton u c.property
    exact ⟨n, ⟨_, hn⟩, Subtype.ext (by simp [hcoe, mul_comm])⟩
  · simpa [hcoe] using congrArg Subtype.val h

/-- The subalgebra generated by `u⁻¹` and its inverse is the one generated by `u` and `u⁻¹`. -/
theorem adjoin_inv_insert_inv :
    adjoin R {((u⁻¹ : Bˣ) : B), (((u⁻¹)⁻¹ : Bˣ) : B)} = adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)} := by
  rw [inv_inv, Set.pair_comm]

end Adjoin

/-! ### Integral closures -/

section IntegralClosure

variable {R : Type*} [CommRing R] [Algebra R B]

variable (R) in
/-- The unit `u`, as an element of the integral closure of `R[u]` in `B`. Applied to `u⁻¹` it is
`u⁻¹` in the integral closure of `R[u⁻¹]`. -/
def integralClosureAdjoinGen : integralClosure (adjoin R {(u : B)}) B :=
  ⟨u, isIntegral_algebraMap (x := (⟨u, self_mem_adjoin_singleton R _⟩ : adjoin R {(u : B)}))⟩

@[simp]
theorem coe_integralClosureAdjoinGen : (u.integralClosureAdjoinGen R : B) = u :=
  (rfl)

/-- `R[u, u⁻¹]` as an algebra over `R[u]` through the inclusion, for the proofs below. -/
private local instance : Algebra (adjoin R {(u : B)}) (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) :=
  (Subalgebra.inclusion (adjoin_singleton_le_adjoin_insert_inv u)).toAlgebra

private local instance :
    IsScalarTower (adjoin R {(u : B)}) (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B :=
  .of_algebraMap_eq fun _ ↦ rfl

/-- **An element integral over `R[u, u⁻¹]` becomes integral over `R[u]` after multiplying by a
power of `u`.** -/
theorem exists_isIntegral_adjoin_pow_mul {x : B}
    (hx : IsIntegral (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) x) :
    ∃ n : ℕ, IsIntegral (adjoin R {(u : B)}) ((u : B) ^ n * x) := by
  have := isLocalization_away_adjoin_insert_inv (R := R) u
  obtain ⟨⟨_, n, rfl⟩, hn⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
    (Submonoid.powers (⟨u, self_mem_adjoin_singleton R _⟩ : adjoin R {(u : B)})) _ hx
  exact ⟨n, by simpa [Submonoid.smul_def, Algebra.smul_def] using hn⟩

/-- **An element is integral over `R[u, u⁻¹]` exactly when `uⁿ` times it is integral over `R[u]`
for some `n`.** -/
theorem isIntegral_adjoin_insert_inv_iff {x : B} :
    IsIntegral (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) x ↔
      ∃ n : ℕ, IsIntegral (adjoin R {(u : B)}) ((u : B) ^ n * x) := by
  refine ⟨exists_isIntegral_adjoin_pow_mul u, fun ⟨n, hn⟩ ↦ ?_⟩
  have hinv : IsIntegral (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) (((u⁻¹ : Bˣ) : B) ^ n) :=
    (isIntegral_algebraMap (x := (⟨_, subset_adjoin (Set.mem_insert_of_mem _ rfl)⟩ :
      adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}))).pow n
  have := hinv.mul (hn.tower_top (A := adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}))
  rwa [← mul_assoc, ← mul_pow, Units.inv_mul, one_pow, one_mul] at this

/-- **The integral closure of `R[u, u⁻¹]` in `B` is the localization away from `u` of the integral
closure of `R[u]` in `B`**, for any algebra structure between the two integral closures compatible
with their inclusions into `B`. -/
theorem isLocalization_away_integralClosure_adjoin_insert_inv
    [Algebra (integralClosure (adjoin R {(u : B)}) B)
      (integralClosure (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B)]
    [IsScalarTower (integralClosure (adjoin R {(u : B)}) B)
      (integralClosure (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B) B] :
    IsLocalization.Away (u.integralClosureAdjoinGen R)
      (integralClosure (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B) := by
  have : IsScalarTower (adjoin R {(u : B)}) (integralClosure (adjoin R {(u : B)}) B)
      (integralClosure (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B) :=
    .of_algebraMap_eq fun y ↦ Subtype.ext <|
      IsScalarTower.algebraMap_apply (integralClosure (adjoin R {(u : B)}) B)
        (integralClosure (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B) B
          (algebraMap (adjoin R {(u : B)}) (integralClosure (adjoin R {(u : B)}) B) y)
  have := isLocalization_away_adjoin_insert_inv (R := R) u
  -- `u` is already a unit of `B`, so `B` is its own localization away from `u`.
  have : IsLocalization.Away (algebraMap (adjoin R {(u : B)}) B
      (⟨u, self_mem_adjoin_singleton R _⟩ : adjoin R {(u : B)})) B :=
    IsLocalization.away_of_isUnit_of_bijective B u.isUnit Function.bijective_id
  exact IsLocalization.Away.integralClosure (S := B) (Sf := B)
    (⟨u, self_mem_adjoin_singleton R _⟩ : adjoin R {(u : B)})

/-! ### The chart of `u⁻¹`

Since `R[u⁻¹, (u⁻¹)⁻¹] = R[u, u⁻¹]`, the statements above applied to `u⁻¹` describe the same
integral closure from the side of `R[u⁻¹]`. -/

/-- **An element is integral over `R[u, u⁻¹]` exactly when `u⁻ⁿ` times it is integral over
`R[u⁻¹]` for some `n`.** -/
theorem isIntegral_adjoin_insert_inv_iff_inv {x : B} :
    IsIntegral (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) x ↔
      ∃ n : ℕ, IsIntegral (adjoin R {((u⁻¹ : Bˣ) : B)}) (((u⁻¹ : Bˣ) : B) ^ n * x) := by
  rw [← isIntegral_adjoin_insert_inv_iff u⁻¹, adjoin_inv_insert_inv]

/-- **The integral closure of `R[u, u⁻¹]` in `B` is the localization away from `u⁻¹` of the
integral closure of `R[u⁻¹]` in `B`**, for any algebra structure between the two integral closures
compatible with their inclusions into `B`. -/
theorem isLocalization_away_inv_integralClosure_adjoin_insert_inv
    [Algebra (integralClosure (adjoin R {((u⁻¹ : Bˣ) : B)}) B)
      (integralClosure (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B)]
    [IsScalarTower (integralClosure (adjoin R {((u⁻¹ : Bˣ) : B)}) B)
      (integralClosure (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B) B] :
    IsLocalization.Away (u⁻¹.integralClosureAdjoinGen R)
      (integralClosure (adjoin R {(u : B), ((u⁻¹ : Bˣ) : B)}) B) := by
  -- Transport the statement for `u⁻¹` along `R[u⁻¹, (u⁻¹)⁻¹] = R[u, u⁻¹]`.
  have key : ∀ S : Subalgebra R B, adjoin R {((u⁻¹ : Bˣ) : B), (((u⁻¹)⁻¹ : Bˣ) : B)} = S →
      ∀ [Algebra (integralClosure (adjoin R {((u⁻¹ : Bˣ) : B)}) B) (integralClosure S B)]
        [IsScalarTower (integralClosure (adjoin R {((u⁻¹ : Bˣ) : B)}) B)
          (integralClosure S B) B],
      IsLocalization.Away (u⁻¹.integralClosureAdjoinGen R) (integralClosure S B) := by
    rintro S rfl _ _
    exact isLocalization_away_integralClosure_adjoin_insert_inv u⁻¹
  exact key _ (adjoin_inv_insert_inv u)

end IntegralClosure

end Units
