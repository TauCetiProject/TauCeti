/-!
# Units of a localization away from prime elements

In an integral domain `R`, inverting a prime element `p` creates no units beyond scalar units and
integer powers of `p`, and more generally inverting a finite product `∏ i ∈ s, p i` of primes
creates only units generated by `Rˣ` and the inverted primes. No factoriality assumption on `R` is
needed: prime cancellation (`Finset.dvd_pow_prod_iff_of_prime` and
`Finset.prod_pow_associated_iff_of_prime`) suffices.

## Main definitions

* `IsLocalization.Away.unitOfDvd`: a divisor `g` of `x` as a unit of a localization away from `x`.
* `IsLocalization.Away.unit`: `x` itself as a unit of a localization away from `x`.
* `IsLocalization.Away.awayProdUnitsHom`: the homomorphism `Rˣ × (s → Multiplicative ℤ) →* Sˣ`
  for a localization `S` away from `∏ i ∈ s, p i`.
* `IsLocalization.Away.awayProdUnitsMulEquiv`: the multiplicative equivalence
  `Rˣ × (s → Multiplicative ℤ) ≃* Sˣ` when the `p i` (`i ∈ s`) are pairwise non-associated primes
  in a domain.
* `IsLocalization.Away.awayUnitsHom` and `IsLocalization.Away.awayUnitsMulEquiv`: the single-prime
  specializations `Rˣ × Multiplicative ℤ →* Sˣ` and `Rˣ × Multiplicative ℤ ≃* Sˣ`.

## Main results

* `Prime.isUnit_of_isUnit_away_of_not_dvd`: an element not divisible by a prime `p` that becomes a
  unit after inverting `p` is already a unit.
* `IsLocalization.Away.awayProdUnitsHom_surjective`: for any finite family of primes (allowing
  associates or repetitions), `Rˣ` and the `p i` (`i ∈ s`) generate `Sˣ`.
* `IsLocalization.Away.isUnit_iff_exists_unit_zpow`: in a localization away from a prime `p`, every
  unit has the form `u * p ^ m` with `u : Rˣ` and `m : ℤ`.
-/

public section

namespace Prime

variable {R S : Type*} [CommSemiring R] [IsDomain R] [CommSemiring S] [Algebra R S]
  {p x : R} [IsLocalization.Away p S]

/-- Inverting a prime element can only make its multiples into new units. -/
theorem isUnit_of_isUnit_away_of_not_dvd (hp : Prime p)
    (hx : IsUnit (algebraMap R S x)) (hpx : ¬p ∣ x) : IsUnit x := by
  obtain ⟨n, hn⟩ := (IsLocalization.Away.algebraMap_isUnit_iff (S := S) p).mp hx
  obtain ⟨i, _, hi⟩ := (dvd_prime_pow hp n).mp hn
  by_cases hi0 : i = 0
  · exact associated_one_iff_isUnit.mp (by simpa [hi0] using hi)
  · exact (hpx ((dvd_pow_self p hi0).trans hi.dvd')).elim

end Prime

namespace IsLocalization.Away

section Unit

variable {R : Type*} [CommSemiring R] (S : Type*) [CommSemiring S] [Algebra R S]
  (x : R) [IsLocalization.Away x S]

/-- A divisor `g` of `x` as a unit in a localization `S` away from `x`. -/
noncomputable def unitOfDvd {g : R} (hg : g ∣ x) : Sˣ :=
  (isUnit_of_dvd x hg).unit

@[simp]
theorem val_unitOfDvd {g : R} (hg : g ∣ x) :
    (unitOfDvd S x hg : S) = algebraMap R S g :=
  IsUnit.unit_spec _

/-- The inverted element `x` as a unit in a localization `S` away from `x`. -/
noncomputable def unit : Sˣ :=
  (algebraMap_isUnit x).unit

@[simp]
theorem val_unit : (unit S x : S) = algebraMap R S x :=
  IsUnit.unit_spec _

@[simp]
theorem val_inv_unit : (↑(unit S x)⁻¹ : S) = invSelf x :=
  (unit S x).mul_right_inj.mp (by simp)

@[simp]
theorem unitOfDvd_rfl : unitOfDvd S x dvd_rfl = unit S x :=
  Units.ext (by simp)

/-- Integer powers of `IsLocalization.Away.unit S x` coerce to `selfZPow x S`. -/
theorem val_unit_zpow (m : ℤ) :
    ((unit S x ^ m : Sˣ) : S) = selfZPow x S m := by
  induction m using Int.induction_on with
  | zero => simp
  | succ i ih =>
    rw [zpow_add_one, Units.val_mul, ih, selfZPow_add, val_unit,
      selfZPow_of_nonneg x S zero_le_one, Int.natAbs_one, pow_one]
  | pred i ih =>
    refine (unit S x).mul_left_inj.mp ?_
    rw [← Units.val_mul, sub_eq_add_neg, zpow_add, zpow_neg_one, mul_assoc, inv_mul_cancel,
      mul_one, ih, val_unit, ← pow_one (algebraMap R S x), ← Int.natAbs_one,
      ← selfZPow_of_nonneg x S zero_le_one, ← selfZPow_add, neg_add_cancel_right]

end Unit

section ProdPrime

variable {ι R : Type*} [CommSemiring R] (S : Type*) [CommSemiring S] [Algebra R S]

/-- The group homomorphism `Rˣ × (s → Multiplicative ℤ) →* Sˣ` sending `(u, m)` to the product of
the scalar unit `u` and the integer powers `p i ^ m i` in a localization `S` away from
`∏ i ∈ s, p i`. -/
noncomputable def awayProdUnitsHom (s : Finset ι) (p : ι → R)
    [IsLocalization.Away (∏ i ∈ s, p i) S] :
    Rˣ × (s → Multiplicative ℤ) →* Sˣ where
  toFun um := Units.map (algebraMap R S : R →* S) um.1 *
    ∏ i ∈ s.attach, unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ (um.2 i).toAdd
  map_one' := by simp
  map_mul' _ _ := by simp [zpow_add, Finset.prod_mul_distrib, mul_mul_mul_comm]

@[simp]
theorem awayProdUnitsHom_apply (s : Finset ι) (p : ι → R)
    [IsLocalization.Away (∏ i ∈ s, p i) S] (u : Rˣ) (m : s → Multiplicative ℤ) :
    awayProdUnitsHom S s p (u, m) = Units.map (algebraMap R S : R →* S) u *
      ∏ i ∈ s.attach, unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ (m i).toAdd :=
  (rfl)

/-- On trivial prime exponents, `awayProdUnitsHom` embeds `Rˣ` along `algebraMap R S`. -/
theorem awayProdUnitsHom_one_right (s : Finset ι) (p : ι → R)
    [IsLocalization.Away (∏ i ∈ s, p i) S] (u : Rˣ) :
    awayProdUnitsHom S s p (u, 1) = Units.map (algebraMap R S : R →* S) u := by
  simp

variable [IsDomain R]

/-- In a domain, inverting a finite product `∏ i ∈ s, p i` of primes yields a unit group generated
by `Rˣ` and the inverted primes `p i` (`i ∈ s`), even if some factors are associated. -/
theorem awayProdUnitsHom_surjective (s : Finset ι) {p : ι → R}
    [IsLocalization.Away (∏ i ∈ s, p i) S] (hp : ∀ i ∈ s, Prime (p i)) :
    Function.Surjective (awayProdUnitsHom S s p) := by
  intro w
  obtain ⟨n, a, hwa⟩ := surj (∏ i ∈ s, p i) (w : S)
  have ha_unit : IsUnit (algebraMap R S a) := by
    rw [← hwa]
    exact w.isUnit.mul (algebraMap_pow_isUnit (∏ i ∈ s, p i) n)
  obtain ⟨k, hk⟩ := (algebraMap_isUnit_iff (∏ i ∈ s, p i)).mp ha_unit
  obtain ⟨c, -, ha_assoc⟩ := (s.dvd_pow_prod_iff_of_prime hp k).mp hk
  obtain ⟨u, hu⟩ := ha_assoc.symm
  refine ⟨(u, fun i ↦ Multiplicative.ofAdd ((c i : ℤ) - n)), ?_⟩
  let vn : Sˣ := ∏ i ∈ s.attach, unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ n
  -- Multiply both sides in `Sˣ` by `vn = (∏ i ∈ s, p i) ^ n` to clear negative exponents.
  refine mul_right_cancel (b := vn) (Units.ext ?_)
  have hvn : (vn : S) = algebraMap R S (∏ i ∈ s, p i) ^ n := by
    rw [Units.coe_prod]
    simp only [Units.val_pow_eq_pow_val, val_unitOfDvd]
    rw [Finset.prod_attach s fun i ↦ algebraMap R S (p i) ^ n, Finset.prod_pow, map_prod]
  rw [awayProdUnitsHom_apply, mul_assoc, ← Finset.prod_mul_distrib]
  simp only [toAdd_ofAdd]
  have hexp : ∀ i ∈ s.attach,
      unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ ((c i : ℤ) - n) *
        unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ n =
      unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ c i.1 := fun i _ ↦ by
    rw [← zpow_natCast, ← zpow_add, sub_add_cancel, zpow_natCast]
  rw [Finset.prod_congr rfl hexp, Units.val_mul, Units.val_mul, hvn, hwa, ← hu, map_mul,
    Units.coe_prod]
  simp only [Units.val_pow_eq_pow_val, val_unitOfDvd, Units.coe_map, MonoidHom.coe_ofClass]
  rw [Finset.prod_attach s fun i ↦ algebraMap R S (p i) ^ c i, map_prod, mul_comm]
  simp [map_pow]

/-- When the primes `p i` (`i ∈ s`) are pairwise non-associated, `awayProdUnitsHom` is injective:
the scalar unit and integer exponents of a unit in `S` are uniquely determined. -/
theorem awayProdUnitsHom_injective (s : Finset ι) {p : ι → R}
    [IsLocalization.Away (∏ i ∈ s, p i) S] (hp : ∀ i ∈ s, Prime (p i))
    (hpair : (s : Set ι).Pairwise fun i j ↦ ¬Associated (p i) (p j)) :
    Function.Injective (awayProdUnitsHom S s p) := by
  classical
  rw [injective_iff_map_eq_one]
  rintro ⟨u, m⟩ hum
  have hprod_ne : ∏ i ∈ s, p i ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i hi ↦ (hp i hi).ne_zero
  have hinj : Function.Injective (algebraMap R S) :=
    IsLocalization.injectiveₛ (M := .powers (∏ i ∈ s, p i)) S fun _ ⟨k, hk⟩ ↦
      hk ▸ ⟨mul_right_injective₀ (pow_ne_zero k hprod_ne),
        mul_left_injective₀ (pow_ne_zero k hprod_ne)⟩
  let pos (i : ι) : ℕ := if hi : i ∈ s then (m ⟨i, hi⟩).toAdd.toNat else 0
  let neg (i : ι) : ℕ := if hi : i ∈ s then (-(m ⟨i, hi⟩).toAdd).toNat else 0
  -- Clearing negative exponents turns `hum` into an association of prime-power products in `R`.
  have hrel : (∏ i ∈ s, p i ^ pos i) * u = ∏ i ∈ s, p i ^ neg i := by
    apply hinj
    have hmul := congrArg
      (fun v : Sˣ ↦ (v * ∏ i ∈ s.attach,
        unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ neg i.1 : Sˣ).val) hum
    simp only [awayProdUnitsHom_apply, one_mul, mul_assoc] at hmul
    rw [← Finset.prod_mul_distrib] at hmul
    have hexp : ∀ i ∈ s.attach,
        unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ (m i).toAdd *
          unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ neg i.1 =
        unitOfDvd S (∏ j ∈ s, p j) (Finset.dvd_prod_of_mem p i.2) ^ pos i.1 := fun i _ ↦ by
      have hz : (m i).toAdd + (neg i.1 : ℤ) = (pos i.1 : ℤ) := by
        simp only [pos, neg, i.2, ↓reduceDIte, Subtype.eta]
        omega
      rw [← zpow_natCast, ← zpow_add, hz, zpow_natCast]
    rw [Finset.prod_congr rfl hexp, Units.val_mul, Units.coe_prod, Units.coe_prod] at hmul
    simp only [Units.val_pow_eq_pow_val, val_unitOfDvd, Units.coe_map,
      MonoidHom.coe_ofClass] at hmul
    rw [Finset.prod_attach s fun i ↦ algebraMap R S (p i) ^ pos i,
      Finset.prod_attach s fun i ↦ algebraMap R S (p i) ^ neg i] at hmul
    simpa [mul_comm] using hmul
  have heq := (s.prod_pow_associated_iff_of_prime hp hpair).mp ⟨u, hrel⟩
  have hm : m = 1 := by
    ext i
    have hi := heq i.1 i.2
    simp only [pos, neg, i.2, ↓reduceDIte, Subtype.eta] at hi
    change (m i).toAdd = 0
    omega
  subst hm
  simp only [awayProdUnitsHom_one_right] at hum
  exact Prod.ext (Units.ext (hinj (by simpa using congrArg Units.val hum))) rfl

/-- For pairwise non-associated primes `p i` (`i ∈ s`) in a domain `R`, the units of a localization
`S` away from `∏ i ∈ s, p i` decompose uniquely as a unit of `R` times integer powers of the
`p i`. -/
noncomputable def awayProdUnitsMulEquiv (s : Finset ι) {p : ι → R}
    [IsLocalization.Away (∏ i ∈ s, p i) S] (hp : ∀ i ∈ s, Prime (p i))
    (hpair : (s : Set ι).Pairwise fun i j ↦ ¬Associated (p i) (p j)) :
    Rˣ × (s → Multiplicative ℤ) ≃* Sˣ :=
  MulEquiv.ofBijective (awayProdUnitsHom S s p)
    ⟨awayProdUnitsHom_injective S s hp hpair, awayProdUnitsHom_surjective S s hp⟩

@[simp]
theorem awayProdUnitsMulEquiv_apply (s : Finset ι) {p : ι → R}
    [IsLocalization.Away (∏ i ∈ s, p i) S] (hp : ∀ i ∈ s, Prime (p i))
    (hpair : (s : Set ι).Pairwise fun i j ↦ ¬Associated (p i) (p j))
    (u : Rˣ) (m : s → Multiplicative ℤ) :
    awayProdUnitsMulEquiv S s hp hpair (u, m) = awayProdUnitsHom S s p (u, m) :=
  (rfl)

end ProdPrime

section SinglePrime

variable {R : Type*} [CommSemiring R] (S : Type*) [CommSemiring S] [Algebra R S]

/-- The group homomorphism `Rˣ × Multiplicative ℤ →* Sˣ` sending `(u, m)` to `u * x ^ m` in a
localization `S` away from `x`. -/
noncomputable def awayUnitsHom (x : R) [IsLocalization.Away x S] :
    Rˣ × Multiplicative ℤ →* Sˣ where
  toFun um := Units.map (algebraMap R S : R →* S) um.1 * unit S x ^ um.2.toAdd
  map_one' := by simp
  map_mul' _ _ := by simp [zpow_add, mul_mul_mul_comm]

@[simp]
theorem awayUnitsHom_apply (x : R) [IsLocalization.Away x S] (u : Rˣ) (m : Multiplicative ℤ) :
    awayUnitsHom S x (u, m) = Units.map (algebraMap R S : R →* S) u * unit S x ^ m.toAdd :=
  (rfl)

variable [IsDomain R]

private theorem awayUnitsHom_bijective {p : R} [IsLocalization.Away p S] (hp : Prime p) :
    Function.Bijective (awayUnitsHom S p) := by
  have : IsLocalization.Away (∏ _ ∈ ({()} : Finset Unit), p) S := by
    simpa using ‹IsLocalization.Away p S›
  let φ : Rˣ × Multiplicative ℤ ≃ Rˣ × (({()} : Finset Unit) → Multiplicative ℤ) :=
    Equiv.prodCongr (.refl Rˣ) (Equiv.funUnique ({()} : Finset Unit) (Multiplicative ℤ)).symm
  have hcomp : ⇑(awayUnitsHom S p) =
      ⇑(awayProdUnitsMulEquiv S ({()} : Finset Unit) (p := fun _ ↦ p)
        (by simpa using hp) (by simp)) ∘ ⇑φ := by
    ext ⟨u, m⟩ : 1
    simp only [Function.comp_apply, φ, Equiv.prodCongr_apply, Prod.map_apply,
      awayProdUnitsMulEquiv_apply, awayProdUnitsHom_apply, awayUnitsHom_apply]
    have hsingleton : ({()} : Finset Unit).attach = {⟨(), Finset.mem_singleton_self ()⟩} := by
      ext ⟨⟨⟩, _⟩
      simp
    rw [hsingleton, Finset.prod_singleton, Equiv.funUnique_symm_apply]
    exact congrArg (Units.map (algebraMap R S : R →* S) u * · ^ m.toAdd) (Units.ext (by simp))
  rw [hcomp]
  exact (awayProdUnitsMulEquiv S ({()} : Finset Unit) _ _).bijective.comp φ.bijective

/-- In a domain `R`, the units of a localization `S` away from a prime `p` are canonically
isomorphic to `Rˣ × Multiplicative ℤ`: every unit has the unique form `u * p ^ m` with `u : Rˣ` and
`m : ℤ`. -/
noncomputable def awayUnitsMulEquiv {p : R} [IsLocalization.Away p S] (hp : Prime p) :
    Rˣ × Multiplicative ℤ ≃* Sˣ :=
  MulEquiv.ofBijective (awayUnitsHom S p) (awayUnitsHom_bijective S hp)

@[simp]
theorem awayUnitsMulEquiv_apply {p : R} [IsLocalization.Away p S] (hp : Prime p)
    (u : Rˣ) (m : Multiplicative ℤ) :
    awayUnitsMulEquiv S hp (u, m) = awayUnitsHom S p (u, m) :=
  (rfl)

/-- In a localization `S` of a domain `R` away from a prime `p`, an element is a unit if and only
if it has the form `u * p ^ m` for some `u : Rˣ` and `m : ℤ`. -/
theorem isUnit_iff_exists_unit_zpow {p : R} [IsLocalization.Away p S] (hp : Prime p) {y : S} :
    IsUnit y ↔ ∃ (u : Rˣ) (m : ℤ), algebraMap R S u * ((unit S p ^ m : Sˣ) : S) = y := by
  refine ⟨fun hy ↦ ?_, fun ⟨u, m, hy⟩ ↦
    hy ▸ (u.isUnit.map (algebraMap R S)).mul (unit S p ^ m).isUnit⟩
  obtain ⟨⟨u, m⟩, hum⟩ := (awayUnitsMulEquiv S hp).surjective hy.unit
  refine ⟨u, m.toAdd, ?_⟩
  simpa using congrArg Units.val hum

end SinglePrime

end IsLocalization.Away
