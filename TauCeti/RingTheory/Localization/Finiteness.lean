module

public import Mathlib.RingTheory.Localization.Finiteness
public import TauCeti.RingTheory.Localization.AtPrime.FractionRing

/-!
# Finiteness and clearing denominators under localization

Pulling Mathlib's `multiple_mem_span_of_mem_localization_span` back along an injective linear map
clears denominators in a localized span; conversely, the localizing elements act invertibly on the
modules, including lifts of a basis along an injective algebra map, to subalgebras generated by
a set via `Algebra.adjoin_eq_span`, and to subalgebras generated over a fraction field inside an
extension of prime localizations.

Finiteness of a module is local on `Spec R` (Mathlib's `Module.Finite.of_localizationSpan`). In
the form recorded here, it suffices to find, around every closed point of `Spec R`, a basic open
`D(r)` over which the module is finite.

## Main results

* `LinearMap.apply_mem_span_image_iff_exists_smul_mem_span`: an injective linear map sends an
  element into the localized span of the image of a set if and only if a multiple of that element
  by a denominator lies in the original span.
* `AlgHom.apply_mem_adjoin_image_iff_exists_smul_mem_adjoin`: an injective algebra homomorphism
  sends an element into the subalgebra generated over a localization by the image of a set if and
  only if a multiple of that element by a denominator lies in the original generated subalgebra.
* `TauCeti.Localization.AtPrime.exists_mul_mem_adjoin`: in commuting domain/fraction-ring squares
  `B → L` and `B₁ → E` with primes `Q` over `P`, any element of `Localization.AtPrime Q` whose image
  in `E` lies in `L[s]` lands in `(Localization.AtPrime P)[s]` after multiplication by a nonzero
  element of `Localization.AtPrime P`.
* `Module.Finite.of_forall_isMaximal_exists_notMem`: a module is finite as soon as every maximal
  ideal `q` avoids some `r` such that the localization `M_r` is a finite `R_r`-module.
-/

public section

namespace LinearMap

variable {A K B L : Type*} [CommSemiring A] [CommSemiring K] [Algebra A K]
  [AddCommMonoid B] [AddCommMonoid L] [Module A B] [Module A L] [Module K L]
  [IsScalarTower A K L]

/-- An injective linear map sends `x` into the span over a localization of the image of `s` if
and only if a multiple of `x` by an element of the localizing submonoid lies in the original span
of `s`. -/
theorem apply_mem_span_image_iff_exists_smul_mem_span {f : B →ₗ[A] L} (hf : Function.Injective f)
    (M : Submonoid A) [IsLocalization M K] {s : Set B} {x : B} :
    f x ∈ Submodule.span K (f '' s) ↔ ∃ a ∈ M, a • x ∈ Submodule.span A s := by
  refine ⟨fun hx ↦ ?_, fun ⟨a, ha, hax⟩ ↦ ?_⟩
  · obtain ⟨⟨a, ha⟩, hax⟩ := multiple_mem_span_of_mem_localization_span M K (f '' s) (f x) hx
    refine ⟨a, ha, (Submodule.apply_mem_span_image_iff_mem_span hf).mp ?_⟩
    simpa only [map_smul, Submonoid.smul_def] using hax
  · have h := Submodule.span_le_restrictScalars A K (f '' s)
      (Submodule.apply_mem_span_image_of_mem_span f hax)
    rw [Submodule.restrictScalars_mem, map_smul, ← algebraMap_smul K a (f x)] at h
    exact (Submodule.smul_mem_iff_of_isUnit _ (IsLocalization.map_units K ⟨a, ha⟩)).mp h

end LinearMap

namespace AlgHom

variable {A K B L : Type*} [CommSemiring A] [CommSemiring K] [Algebra A K]
  [Semiring B] [Semiring L] [Algebra A B] [Algebra A L] [Algebra K L]
  [IsScalarTower A K L]

/-- An injective `A`-algebra homomorphism `f : B →ₐ[A] L` sends `x` into the subalgebra generated
over a localization `K` of `A` at `M` by `f '' s` if and only if a multiple of `x` by an element
of `M` lies in `Algebra.adjoin A s`. -/
theorem apply_mem_adjoin_image_iff_exists_smul_mem_adjoin (f : B →ₐ[A] L)
    (hf : Function.Injective f) (M : Submonoid A) [IsLocalization M K] {s : Set B} {x : B} :
    f x ∈ Algebra.adjoin K (f '' s) ↔ ∃ a ∈ M, a • x ∈ Algebra.adjoin A s := by
  have himg : f.toLinearMap '' (Submonoid.closure s : Set B) =
      (Submonoid.closure (f '' s) : Set L) := by
    simpa [AlgHom.coe_toLinearMap] using
      congrArg (SetLike.coe : Submonoid L → Set L) (MonoidHom.map_mclosure (f : B →* L) s)
  rw [← Subalgebra.mem_toSubmodule, Algebra.adjoin_eq_span, ← himg, ← AlgHom.coe_toLinearMap]
  simpa only [← Algebra.adjoin_eq_span, Subalgebra.mem_toSubmodule] using
    LinearMap.apply_mem_span_image_iff_exists_smul_mem_span (f := f.toLinearMap) (K := K) hf M
      (s := Submonoid.closure s) (x := x)

end AlgHom

namespace TauCeti.Localization.AtPrime

variable {B L B₁ E : Type*} [CommRing B] [IsDomain B] [CommRing L] [Algebra B L]
  [IsFractionRing B L] [CommRing B₁] [IsDomain B₁] [Algebra B B₁]
  [CommRing E] [Algebra B E] [Algebra L E] [Algebra B₁ E]
  [IsScalarTower B L E] [IsScalarTower B B₁ E] [IsFractionRing B₁ E]

/-- Let `B → B₁` be an extension of domains with fraction rings `L` and `E` forming a commuting
square, and let `Q` be a prime of `B₁` lying over a prime `P` of `B`. If the image in `E` of
`c : Localization.AtPrime Q` lies in the `L`-subalgebra generated by the image of `s : Set B₁`, then
multiplying `c` by a nonzero element of `Localization.AtPrime P` places it in the
`Localization.AtPrime P`-subalgebra generated by the image of `s`. -/
theorem exists_mul_mem_adjoin (P : Ideal B) [P.IsPrime] (Q : Ideal B₁) [Q.IsPrime] [Q.LiesOver P]
    {s : Set B₁} {c : Localization.AtPrime Q}
    (hc : algebraMap (Localization.AtPrime Q) E c ∈ Algebra.adjoin L (algebraMap B₁ E '' s)) :
    letI := Localization.AtPrime.algebraOfLiesOver P Q
    ∃ t : Localization.AtPrime P, t ≠ 0 ∧
      algebraMap (Localization.AtPrime P) (Localization.AtPrime Q) t * c ∈
        Algebra.adjoin (Localization.AtPrime P)
          (algebraMap B₁ (Localization.AtPrime Q) '' s) := by
  let := Localization.AtPrime.algebraOfLiesOver P Q
  have : IsScalarTower B (Localization.AtPrime Q) E := .to₁₃₄ B B₁ (Localization.AtPrime Q) E
  let j : Localization.AtPrime Q →ₐ[B] E := IsScalarTower.toAlgHom B (Localization.AtPrime Q) E
  have hj : Function.Injective j := IsFractionRing.injective (Localization.AtPrime Q) E
  have himg : j '' (algebraMap B₁ (Localization.AtPrime Q) '' s) = algebraMap B₁ E '' s := by
    rw [← Set.image_comp]
    exact Set.image_congr fun b _ ↦
      (IsScalarTower.algebraMap_apply B₁ (Localization.AtPrime Q) E b).symm
  have hc' : j.toLinearMap c ∈
      Submodule.span L (j.toLinearMap ''
        (Submonoid.closure (algebraMap B₁ (Localization.AtPrime Q) '' s) : Set _)) := by
    rw [← himg, ← Subalgebra.mem_toSubmodule, Algebra.adjoin_eq_span,
      ← MonoidHom.map_mclosure j, Submonoid.coe_map, ← AlgHom.coe_toLinearMap] at hc
    exact hc
  obtain ⟨a, ha, hac⟩ :=
    (LinearMap.apply_mem_span_image_iff_exists_smul_mem_span hj (nonZeroDivisors B)).mp hc'
  rw [← Algebra.adjoin_eq_span, Subalgebra.mem_toSubmodule, Algebra.smul_def,
    IsScalarTower.algebraMap_apply B (Localization.AtPrime P) (Localization.AtPrime Q)] at hac
  refine ⟨algebraMap B (Localization.AtPrime P) a,
    (map_ne_zero_iff _ (IsLocalization.injective _ P.primeCompl_le_nonZeroDivisors)).mpr
      (mem_nonZeroDivisors_iff_ne_zero.mp ha), ?_⟩
  exact Algebra.adjoin_le (R := B)
    (S := (Algebra.adjoin (Localization.AtPrime P)
      (algebraMap B₁ (Localization.AtPrime Q) '' s)).restrictScalars B)
    (fun _ hx ↦ Algebra.subset_adjoin hx) hac

end TauCeti.Localization.AtPrime

namespace Module.Finite

variable {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]

/-- **Finiteness is local around closed points.** If every maximal ideal `q` of `R` avoids an
element `r` such that the localization `M_r` is a finite `R_r`-module, then `M` is a finite
`R`-module. -/
theorem of_forall_isMaximal_exists_notMem
    (H : ∀ q : Ideal R, q.IsMaximal →
      ∃ r ∉ q, Module.Finite (Localization.Away r) (LocalizedModule.Away r M)) :
    Module.Finite R M := by
  -- The elements `r` with `M_r` finite generate the unit ideal: no maximal ideal contains them.
  refine of_localizationSpan
    {r | Module.Finite (Localization.Away r) (LocalizedModule.Away r M)} ?_ fun r ↦ r.property
  by_contra h
  obtain ⟨q, hq, hle⟩ := Ideal.exists_le_maximal _ h
  obtain ⟨r, hrq, hr⟩ := H q hq
  exact hrq (hle (Ideal.subset_span hr))

end Module.Finite

end
