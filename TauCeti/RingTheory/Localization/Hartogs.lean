public import TauCeti.RingTheory.Localization.AsSubring
public import TauCeti.RingTheory.Regular.RegularSequence
public import TauCeti.RingTheory.SerreCondition.Normal

/-!
# Algebraic Hartogs intersections of principal localizations

Inside the fraction field `K` of a commutative ring `A`, an element `z : K` belongs to the
intersection `⋂_i A[1 / a_i]` of principal localizations precisely when the ideal `I` generated by
the `a_i` lies in the radical of the denominator ideal `Algebra.denIdeal K z`. Whenever `I` (or its
radical) contains a length-two weakly `A`-regular sequence `[u, v]`, powers of `u` and `v` both
clear the denominator of `z`, forcing `z ∈ A` by
`RingTheory.Sequence.IsWeaklyRegular.mem_range_algebraMap_of_pow_mul_mem`.

Over a Noetherian ring `A`, local depth at least two at every prime containing `I` produces such a
weakly regular sequence (`TauCeti.exists_isWeaklyRegular_of_le_depth_localizedModule`), yielding
`⋂_i A[1 / a_i] = A` inside `K`. Under Serre's condition `(S_2)` — and in particular for any
Noetherian integrally closed domain — it suffices that the basic opens `D(a_i)` cover all primes of
height one.

## Main results

* `TauCeti.mem_range_algebraMap_of_isWeaklyRegular_mem_radical_denIdeal` and
  `TauCeti.mem_range_algebraMap_of_two_le_depth_of_le_radical_denIdeal`: denominator-ideal criteria
  for an element of a total ring of fractions to lie in the base ring.
* `Localization.subalgebra.iInf_ofField_powers_eq_bot_of_isWeaklyRegular`: if the radical of
  `Ideal.span (Set.range a)` contains a weakly regular pair, then `⋂_i A[1 / a_i] = A` inside `K`.
* `Localization.subalgebra.iInf_ofField_powers_eq_bot_of_two_le_depth`: algebraic Hartogs for
  principal localizations when `depth A_p ≥ 2` at all primes `p` containing every `a_i`.
* `Localization.subalgebra.iInf_ofField_powers_eq_bot_of_satisfiesSerreS_two` and
  `Localization.subalgebra.iInf_ofField_powers_eq_bot_of_isIntegrallyClosed`: the `(S_2)` and
  normal Noetherian cases when no height-one prime contains every `a_i`.

## References

* [Stacks Project, Lemma 31.5.11 (0E9I)](https://stacks.math.columbia.edu/tag/0E9I)
-/

public section

open IsLocalRing RingTheory.Sequence

open scoped nonZeroDivisors

namespace TauCeti

section FractionRing

variable {A K : Type*} [CommRing A] [CommRing K] [Algebra A K] [IsFractionRing A K]

/-- If `[u, v]` is a weakly `A`-regular sequence whose entries lie in the radical of the
denominator ideal of `z : K`, then `z` belongs to the image of `A` in `K`. -/
theorem mem_range_algebraMap_of_isWeaklyRegular_mem_radical_denIdeal {u v : A}
    (hreg : IsWeaklyRegular A [u, v]) {z : K}
    (hu : u ∈ (Algebra.denIdeal K z).radical) (hv : v ∈ (Algebra.denIdeal K z).radical) :
    z ∈ (algebraMap A K).range := by
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hu
  obtain ⟨j, hj⟩ := Ideal.mem_radical_iff.mp hv
  obtain ⟨a, ha⟩ := (Algebra.mem_denIdeal_iff K).mp hn
  obtain ⟨b, hb⟩ := (Algebra.mem_denIdeal_iff K).mp hj
  exact hreg.mem_range_algebraMap_of_pow_mul_mem ⟨a, ha.symm⟩ ⟨b, hb.symm⟩

/-- **Algebraic Hartogs for a total ring of fractions.** Over a Noetherian ring `A`, if an ideal
`I` lies in the radical of `Algebra.denIdeal K z` and `depth A_p ≥ 2` at every prime `p ≥ I`, then
`z` belongs to the image of `A` in `K`. -/
theorem mem_range_algebraMap_of_two_le_depth_of_le_radical_denIdeal [IsNoetherianRing A]
    {I : Ideal A} {z : K} (hI : I ≤ (Algebra.denIdeal K z).radical)
    (hdepth : ∀ (p : Ideal A) [p.IsPrime], I ≤ p →
      2 ≤ depth (ModuleCat.of (Localization.AtPrime p) (Localization.AtPrime p))) :
    z ∈ (algebraMap A K).range := by
  obtain ⟨rs, hlen, hmem, hreg⟩ :=
    exists_isWeaklyRegular_of_le_depth_localizedModule (M := A) I 2 fun p _ hp ↦ by
      rw [p.depth_localizedModule_self]
      exact hdepth p hp
  obtain ⟨u, v, rfl⟩ : ∃ u v, rs = [u, v] := by
    rcases rs with _ | ⟨u, _ | ⟨v, _ | _⟩⟩ <;> simp at hlen
    exact ⟨u, v, rfl⟩
  exact mem_range_algebraMap_of_isWeaklyRegular_mem_radical_denIdeal hreg
    (hI (hmem u (by simp))) (hI (hmem v (by simp)))

end FractionRing

end TauCeti

namespace Localization.subalgebra

variable {A K : Type*} [CommRing A] [Field K] [Algebra A K] [IsFractionRing A K]

/-- If the radical of the ideal generated by `a : ι → A` contains a length-two weakly `A`-regular
sequence, then the principal localizations `A[1 / a_i]` intersect in `A` inside `K`. -/
theorem iInf_ofField_powers_eq_bot_of_isWeaklyRegular {ι : Type*} (a : ι → A)
    (ha : ∀ i, Submonoid.powers (a i) ≤ A⁰) {u v : A}
    (hreg : IsWeaklyRegular A [u, v])
    (hu : u ∈ (Ideal.span (Set.range a)).radical)
    (hv : v ∈ (Ideal.span (Set.range a)).radical) :
    (⨅ i, ofField K (Submonoid.powers (a i)) (ha i)) = ⊥ := by
  refine eq_bot_iff.mpr fun z hz ↦ Algebra.mem_bot.mpr ?_
  have hrad : (Ideal.span (Set.range a)).radical ≤ (Algebra.denIdeal K z).radical :=
    Ideal.radical_le_radical_iff.mpr ((mem_iInf_ofField_powers_iff_span_le_radical a ha).mp hz)
  exact TauCeti.mem_range_algebraMap_of_isWeaklyRegular_mem_radical_denIdeal hreg
    (hrad hu) (hrad hv)

/-- **Algebraic Hartogs for principal localizations inside the fraction field.** Over a Noetherian
ring `A`, if `depth A_p ≥ 2` at every prime `p` containing all `a_i`, then `⋂_i A[1 / a_i] = A`
inside `K`. -/
theorem iInf_ofField_powers_eq_bot_of_two_le_depth [IsNoetherianRing A] {ι : Type*} (a : ι → A)
    (ha : ∀ i, Submonoid.powers (a i) ≤ A⁰)
    (hdepth : ∀ (p : Ideal A) [p.IsPrime], (∀ i, a i ∈ p) →
      2 ≤ depth (ModuleCat.of (Localization.AtPrime p) (Localization.AtPrime p))) :
    (⨅ i, ofField K (Submonoid.powers (a i)) (ha i)) = ⊥ := by
  refine eq_bot_iff.mpr fun z hz ↦ Algebra.mem_bot.mpr ?_
  refine TauCeti.mem_range_algebraMap_of_two_le_depth_of_le_radical_denIdeal
    ((mem_iInf_ofField_powers_iff_span_le_radical a ha).mp hz) fun p _ hp ↦ ?_
  exact hdepth p fun i ↦ hp (Ideal.subset_span ⟨i, rfl⟩)

/-- Over a Noetherian ring `A` satisfying `(S_2)`, if no height-one prime contains every `a_i`,
then the principal localizations `A[1 / a_i]` intersect in `A` inside `K`. -/
theorem iInf_ofField_powers_eq_bot_of_satisfiesSerreS_two [IsNoetherianRing A]
    (hS₂ : Module.SatisfiesSerreS 2 A A) {ι : Type*} (a : ι → A)
    (ha : ∀ i, Submonoid.powers (a i) ≤ A⁰)
    (hcover : ∀ p : Ideal A, p.IsPrime → p.height = 1 → ∃ i, a i ∉ p) :
    (⨅ i, ofField K (Submonoid.powers (a i)) (ha i)) = ⊥ := by
  refine eq_bot_iff.mpr fun z hz ↦ Algebra.mem_bot.mpr <|
    hS₂.mem_range_algebraMap_of_forall_height_eq_one fun P hP hP1 ↦ ?_
  obtain ⟨i, hi⟩ := hcover P hP hP1
  obtain ⟨n, hn⟩ := (mem_ofField_powers_iff (a i) (ha i)).mp (Algebra.mem_iInf.mp hz i)
  exact ⟨a i ^ n, mt (hP.mem_of_pow_mem n) hi, by rwa [map_pow]⟩

/-- Over a Noetherian integrally closed domain `A`, if no height-one prime contains every `a_i`,
then the principal localizations `A[1 / a_i]` intersect in `A` inside `K`. -/
theorem iInf_ofField_powers_eq_bot_of_isIntegrallyClosed [IsNoetherianRing A]
    [IsIntegrallyClosed A] {ι : Type*} (a : ι → A) (ha : ∀ i, Submonoid.powers (a i) ≤ A⁰)
    (hcover : ∀ p : Ideal A, p.IsPrime → p.height = 1 → ∃ i, a i ∉ p) :
    (⨅ i, ofField K (Submonoid.powers (a i)) (ha i)) = ⊥ := by
  have : IsDomain A := (IsFractionRing.injective A K).isDomain
  exact iInf_ofField_powers_eq_bot_of_satisfiesSerreS_two
    TauCeti.satisfiesSerreS_two_of_isIntegrallyClosed a ha hcover

end Localization.subalgebra
