/-!
# Algebraic Hartogs intersections of principal localizations

Inside a total ring of fractions `K` of a commutative ring `A`, an element `z : K` belongs to an
intersection `⋂_i B_i` of embedded principal localizations `B_i ≃ₐ[A] A[1 / a_i]` precisely when the
ideal `I` generated by the `a_i` lies in the radical of the denominator ideal `Algebra.denIdeal K z`
(`TauCeti.IsLocalization.mem_iInf_subalgebra_powers_iff_span_range_le_radical_denIdeal`). Whenever
`I` (or its radical) contains a length-two weakly `A`-regular sequence `[u, v]`, powers of `u` and
`v` both clear the denominator of `z`, forcing `z ∈ A` by
`RingTheory.Sequence.IsWeaklyRegular.mem_range_algebraMap_of_pow_mul_mem`.

Over a Noetherian ring `A`, local depth at least two at every prime containing `I` produces such a
weakly regular sequence (`TauCeti.exists_isWeaklyRegular_of_le_depth_localizedModule`), yielding
`⋂_i B_i = ⊥` inside `K`. Under Serre's condition `(S_2)` — and in particular for any Noetherian
integrally closed domain — it suffices that the basic opens `D(a_i)` cover all primes of height one.
`Localization.subalgebra` and `Localization.subalgebra.ofField` supply the required `IsLocalization`
instances automatically.

## Main results

* `RingTheory.Sequence.IsWeaklyRegular.mem_range_algebraMap_of_mem_radical_denIdeal` and
  `TauCeti.mem_range_algebraMap_of_two_le_depth_of_le_radical_denIdeal`: denominator-ideal criteria
  for an element of a total ring of fractions to lie in the base ring.
* `TauCeti.IsLocalization.iInf_subalgebra_powers_eq_bot_of_isWeaklyRegular`: if the radical of
  `Ideal.span (Set.range a)` contains a weakly regular pair, then `⋂_i B_i = ⊥` inside `K`.
* `TauCeti.IsLocalization.iInf_subalgebra_powers_eq_bot_of_two_le_depth`: algebraic Hartogs for
  embedded principal localizations when `depth A_p ≥ 2` at all primes `p` containing every `a_i`.
* `TauCeti.IsLocalization.iInf_subalgebra_powers_eq_bot_of_satisfiesSerreS_two` and
  `TauCeti.IsLocalization.iInf_subalgebra_powers_eq_bot_of_isIntegrallyClosed`: the `(S_2)` and
  normal Noetherian domain cases when no height-one prime contains every `a_i`.

## References

* [Stacks Project, Lemma 31.5.11 (0E9I)](https://stacks.math.columbia.edu/tag/0E9I)
-/

public section

open IsLocalRing RingTheory.Sequence

section IsWeaklyRegular

variable {A K : Type*} [CommRing A] [CommRing K] [Algebra A K] [IsFractionRing A K]

/-- If `[u, v]` is a weakly `A`-regular sequence whose entries lie in the radical of the
denominator ideal of `z : K`, then `z` belongs to the image of `A` in `K`. -/
theorem RingTheory.Sequence.IsWeaklyRegular.mem_range_algebraMap_of_mem_radical_denIdeal {u v : A}
    (hreg : IsWeaklyRegular A [u, v]) {z : K}
    (hu : u ∈ (Algebra.denIdeal K z).radical) (hv : v ∈ (Algebra.denIdeal K z).radical) :
    z ∈ (algebraMap A K).range := by
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hu
  obtain ⟨j, hj⟩ := Ideal.mem_radical_iff.mp hv
  obtain ⟨a, ha⟩ := (Algebra.mem_denIdeal_iff K).mp hn
  obtain ⟨b, hb⟩ := (Algebra.mem_denIdeal_iff K).mp hj
  exact hreg.mem_range_algebraMap_of_pow_mul_mem ⟨a, ha.symm⟩ ⟨b, hb.symm⟩

end IsWeaklyRegular

namespace TauCeti

section FractionRing

variable {A K : Type*} [CommRing A] [CommRing K] [Algebra A K] [IsFractionRing A K]

/-- **Algebraic Hartogs for a total ring of fractions.** Over a Noetherian ring `A`, if an ideal
`I` lies in the radical of `Algebra.denIdeal K z` and `depth A_p ≥ 2` at every prime `p ≥ I`, then
`z` belongs to the image of `A` in `K`. -/
theorem mem_range_algebraMap_of_two_le_depth_of_le_radical_denIdeal [IsNoetherianRing A]
    {I : Ideal A} {z : K} (hI : I ≤ (Algebra.denIdeal K z).radical)
    (hdepth : ∀ (p : Ideal A) [p.IsPrime], I ≤ p →
      2 ≤ depth (ModuleCat.of (Localization.AtPrime p) (Localization.AtPrime p))) :
    z ∈ (algebraMap A K).range := by
  obtain ⟨rs, hlen, hmem, hreg⟩ :=
    exists_isWeaklyRegular_of_le_depth_localizedModule (M := A) I 2 fun p _ hp ↦ by
      rw [p.depth_localizedModule_self]
      exact hdepth p hp
  obtain ⟨u, v, rfl⟩ : ∃ u v, rs = [u, v] := by
    rcases rs with _ | ⟨u, _ | ⟨v, _ | _⟩⟩ <;> simp at hlen
    exact ⟨u, v, rfl⟩
  exact hreg.mem_range_algebraMap_of_mem_radical_denIdeal
    (hI (hmem u (by simp))) (hI (hmem v (by simp)))

end FractionRing

namespace IsLocalization

variable {A K : Type*} [CommRing A] [CommRing K] [Algebra A K] [IsFractionRing A K]

/-- If the radical of the ideal generated by `a : ι → A` contains a length-two weakly `A`-regular
sequence, then any family of embedded principal localizations `B_i` at `a_i` intersects in the
coefficient image inside a total ring of fractions `K`. -/
theorem iInf_subalgebra_powers_eq_bot_of_isWeaklyRegular {ι : Type*} (a : ι → A)
    (B : ι → Subalgebra A K) [∀ i, IsLocalization (Submonoid.powers (a i)) (B i)] {u v : A}
    (hreg : IsWeaklyRegular A [u, v])
    (hu : u ∈ (Ideal.span (Set.range a)).radical)
    (hv : v ∈ (Ideal.span (Set.range a)).radical) :
    (⨅ i, B i) = ⊥ := by
  refine eq_bot_iff.mpr fun z hz ↦ Algebra.mem_bot.mpr ?_
  have hrad : (Ideal.span (Set.range a)).radical ≤ (Algebra.denIdeal K z).radical :=
    Ideal.radical_le_radical_iff.mpr
      ((mem_iInf_subalgebra_powers_iff_span_range_le_radical_denIdeal a B z).mp hz)
  exact hreg.mem_range_algebraMap_of_mem_radical_denIdeal (hrad hu) (hrad hv)

/-- **Algebraic Hartogs for embedded principal localizations.** Over a Noetherian ring `A` with
total ring of fractions `K`, if `depth A_p ≥ 2` at every prime `p` containing all `a_i`, then any
family of embedded principal localizations `B_i` at `a_i` intersects in `⊥` inside `K`. -/
theorem iInf_subalgebra_powers_eq_bot_of_two_le_depth [IsNoetherianRing A] {ι : Type*} (a : ι → A)
    (B : ι → Subalgebra A K) [∀ i, IsLocalization (Submonoid.powers (a i)) (B i)]
    (hdepth : ∀ (p : Ideal A) [p.IsPrime], (∀ i, a i ∈ p) →
      2 ≤ depth (ModuleCat.of (Localization.AtPrime p) (Localization.AtPrime p))) :
    (⨅ i, B i) = ⊥ := by
  refine eq_bot_iff.mpr fun z hz ↦ Algebra.mem_bot.mpr ?_
  refine mem_range_algebraMap_of_two_le_depth_of_le_radical_denIdeal
    ((mem_iInf_subalgebra_powers_iff_span_range_le_radical_denIdeal a B z).mp hz) fun p _ hp ↦ ?_
  exact hdepth p fun i ↦ hp (Ideal.subset_span ⟨i, rfl⟩)

/-- Over a Noetherian ring `A` satisfying `(S_2)` with total ring of fractions `K`, if no height-one
prime contains every `a_i`, then any family of embedded principal localizations `B_i` at `a_i`
intersects in `⊥` inside `K`. -/
theorem iInf_subalgebra_powers_eq_bot_of_satisfiesSerreS_two [IsNoetherianRing A]
    (hS₂ : Module.SatisfiesSerreS 2 A A) {ι : Type*} (a : ι → A)
    (B : ι → Subalgebra A K) [∀ i, IsLocalization (Submonoid.powers (a i)) (B i)]
    (hcover : ∀ p : Ideal A, p.IsPrime → p.height = 1 → ∃ i, a i ∉ p) :
    (⨅ i, B i) = ⊥ := by
  refine eq_bot_iff.mpr fun z hz ↦ Algebra.mem_bot.mpr <|
    hS₂.mem_range_algebraMap_of_forall_height_eq_one fun P hP hP1 ↦ ?_
  obtain ⟨i, hi⟩ := hcover P hP hP1
  obtain ⟨n, hn⟩ := (mem_subalgebra_iff_exists_pow_mul_mem_range (a i) (B i) z).mp
    (Algebra.mem_iInf.mp hz i)
  exact ⟨a i ^ n, mt (hP.mem_of_pow_mem n) hi, by rwa [map_pow]⟩

/-- Over a Noetherian integrally closed domain `A` with total ring of fractions `K`, if no
height-one prime contains every `a_i`, then any family of embedded principal localizations `B_i` at
`a_i` intersects in `⊥` inside `K`. -/
theorem iInf_subalgebra_powers_eq_bot_of_isIntegrallyClosed [IsDomain A] [IsNoetherianRing A]
    [IsIntegrallyClosed A] {ι : Type*} (a : ι → A)
    (B : ι → Subalgebra A K) [∀ i, IsLocalization (Submonoid.powers (a i)) (B i)]
    (hcover : ∀ p : Ideal A, p.IsPrime → p.height = 1 → ∃ i, a i ∉ p) :
    (⨅ i, B i) = ⊥ :=
  iInf_subalgebra_powers_eq_bot_of_satisfiesSerreS_two
    satisfiesSerreS_two_of_isIntegrallyClosed a B hcover

end IsLocalization

end TauCeti
