/-!
# Ideals that become principal in an away localization

If `r • I ≤ (t)` for an element `t` of an ideal `I`, then `I` and `(t)` agree after inverting
`r`. This is how a local equation of an ideal is read off from a relation holding up to a
multiplier, as produced by Nakayama's lemma.

## Main results

* `Ideal.map_eq_span_singleton_of_isUnit`: if `f r` is a unit for a ring homomorphism `f`,
  then `r • I ≤ (t)` and `t ∈ I` imply that `I` generates `(f t)` after applying `f`.
* `Ideal.map_algebraMap_away_eq_span_singleton`: if `r • I ≤ (t)` and `t ∈ I`, then `I`
  generates `(t)` in the localization away from `r`.
* `Ideal.exists_notMem_smul_le_span_singleton_of_map_eq`: over a Noetherian ring, an ideal which
  becomes principal, generated by a nonzerodivisor, in the localization at a prime `P` satisfies
  such a relation, with a multiplier `r ∉ P` which also kills the annihilator of the generator;
* `IsLocalization.Away.isSMulRegular_algebraMap`: an element whose annihilator is killed by `r`
  becomes a nonzerodivisor after inverting `r`.

Together they spread a local equation of an ideal at a prime, given by a nonzerodivisor, to a
local equation by a nonzerodivisor on a basic open neighbourhood, which is how an ideal sheaf
whose stalks are principal is shown to be an effective Cartier divisor.
-/

public section

open scoped Pointwise

namespace Ideal

/-- If `f r` is a unit, `r • I ≤ (t)`, and `t ∈ I`, then `I` generates the principal ideal
`(f t)` after applying the ring homomorphism `f`. -/
theorem map_eq_span_singleton_of_isUnit {B B' : Type*} [CommSemiring B] [CommSemiring B']
    (f : B →+* B') {I : Ideal B} {r t : B} (ht : t ∈ I) (h : r • I ≤ Ideal.span {t})
    (hr : IsUnit (f r)) :
    I.map f = Ideal.span {f t} := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun i hi ↦ ?_) ?_
  · obtain ⟨b, hb⟩ :=
      Ideal.mem_span_singleton'.mp (h (Submodule.smul_mem_pointwise_smul i r I hi))
    rw [Ideal.mem_comap, ← Ideal.unit_mul_mem_iff_mem _ hr, ← map_mul, ← smul_eq_mul, ← hb,
      map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ ht

/-- If `r • I ≤ (t)` for some `t ∈ I`, then `I` generates the principal ideal `(t)` in the
localization away from `r`. -/
theorem map_algebraMap_away_eq_span_singleton {B B' : Type*} [CommSemiring B]
    [CommSemiring B'] [Algebra B B'] {I : Ideal B} {r t : B} [IsLocalization.Away r B']
    (ht : t ∈ I) (h : r • I ≤ Ideal.span {t}) :
    I.map (algebraMap B B') = Ideal.span {algebraMap B B' t} :=
  map_eq_span_singleton_of_isUnit (algebraMap B B') ht h
    (IsLocalization.Away.algebraMap_isUnit (S := B') r)

variable {A : Type*} [CommRing A]

/-- **Spreading out a local equation.** Let `A` be a Noetherian ring, `P` a prime ideal and `S`
the localization of `A` at `P`. If an ideal `q` generates in `S` the principal ideal of the image
of `a`, and that image is a nonzerodivisor, then some `r ∉ P` satisfies `r • q ≤ (a)` and kills
every element killed by `a`. -/
theorem exists_notMem_smul_le_span_singleton_of_map_eq [IsNoetherianRing A] {P : Ideal A}
    [P.IsPrime] (S : Type*) [CommRing S] [Algebra A S] [IsLocalization.AtPrime S P] {q : Ideal A}
    {a : A} (hq : q.map (algebraMap A S) = span {algebraMap A S a})
    (hreg : IsSMulRegular S (algebraMap A S a)) :
    ∃ r ∉ P, r • q ≤ span {a} ∧ ∀ b, a * b = 0 → r * b = 0 := by
  -- A finite module each of whose elements is killed by an element outside `P` is killed by a
  -- single element outside `P`.
  have key (M : Type _) [AddCommGroup M] [Module A M] [Module.Finite A M]
      (h : ∀ m : M, ∃ r ∉ P, r • m = 0) : ∃ r ∉ P, ∀ m : M, r • m = 0 := by
    have hP := (Module.notMem_support_iff' (p := ⟨P, inferInstance⟩)).mpr h
    rw [Module.mem_support_iff_of_finite, IsConcreteLE.not_le_iff_exists] at hP
    obtain ⟨r, hr, hrP⟩ := hP
    exact ⟨r, hrP, Module.mem_annihilator.mp hr⟩
  -- Every element of `q` lands in `(a)` after multiplication by an element outside `P`.
  obtain ⟨r₁, hr₁P, hr₁⟩ := key (q ⧸ Submodule.comap q.subtype (span {a})) <| by
    intro m
    obtain ⟨⟨b, hb⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ m
    obtain ⟨c, hc⟩ := mem_span_singleton'.mp (hq ▸ mem_map_of_mem (algebraMap A S) hb)
    obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl c
    dsimp only at hc
    have hrs : algebraMap A S (r * a) = algebraMap A S (s * b) := by
      rw [map_mul, map_mul, ← hc, ← IsLocalization.mk'_spec' S r s]
      ring
    obtain ⟨u, hu⟩ := (IsLocalization.eq_iff_exists P.primeCompl S).mp hrs
    refine ⟨u * s, P.primeCompl.mul_mem u.2 s.2, ?_⟩
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
      Submodule.subtype_apply, SetLike.val_smul, smul_eq_mul, mem_span_singleton']
    exact ⟨u * r, by linear_combination hu⟩
  -- Every element killed by `a` is killed by an element outside `P`.
  obtain ⟨r₂, hr₂P, hr₂⟩ := key (span {a}).annihilator <| by
    rintro ⟨b, hb⟩
    rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul] at hb
    have hb' : algebraMap A S b = 0 := isSMulRegular_iff_right_eq_zero_of_smul.mp hreg _ <| by
      rw [smul_eq_mul, ← map_mul, mul_comm a b, hb, map_zero]
    obtain ⟨u, hu⟩ := (IsLocalization.map_eq_zero_iff P.primeCompl S b).mp hb'
    exact ⟨u, u.2, Subtype.ext hu⟩
  refine ⟨r₁ * r₂, fun h ↦ (‹P.IsPrime›.mem_or_mem h).elim hr₁P hr₂P, fun x hx ↦ ?_, fun b hb ↦ ?_⟩
  · obtain ⟨b, hb, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hx
    have := hr₁ (Submodule.Quotient.mk ⟨b, hb⟩)
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
      Submodule.subtype_apply, SetLike.val_smul, smul_eq_mul] at this
    rw [smul_eq_mul, mul_comm r₁, mul_assoc]
    exact mul_mem_left _ _ this
  · have h₂ : r₂ * b = 0 := by
      simpa using congrArg Subtype.val (hr₂ ⟨b, by
        rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul, mul_comm, hb]⟩)
    rw [mul_assoc, h₂, mul_zero]

end Ideal

namespace IsLocalization.Away

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- If `r` kills every element killed by `a`, then the image of `a` is a nonzerodivisor in the
localization away from `r`. -/
theorem isSMulRegular_algebraMap {r a : A} [IsLocalization.Away r B]
    (h : ∀ b, a * b = 0 → r * b = 0) : IsSMulRegular B (algebraMap A B a) := by
  refine IsSMulRegular.of_right_eq_zero_of_smul fun y hy ↦ ?_
  obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers r) y
  rw [smul_eq_mul, IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mk'_eq_zero_iff] at hy
  obtain ⟨⟨_, n, rfl⟩, hn⟩ := hy
  rw [IsLocalization.mk'_eq_zero_iff]
  refine ⟨⟨r ^ (n + 1), n + 1, rfl⟩, ?_⟩
  have := h (r ^ n * c) (by linear_combination hn)
  linear_combination this

end IsLocalization.Away
