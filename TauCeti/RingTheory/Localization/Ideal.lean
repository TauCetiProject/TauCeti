module

public import Mathlib.Algebra.Module.Submodule.Pointwise
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Noetherian.Defs
import Mathlib.Algebra.GroupWithZero.Action.Regular
import Mathlib.RingTheory.Localization.Ideal

/-!
# Ideals that become principal in an away localization

If `r • I ≤ (t)` for an element `t` of an ideal `I`, then `I` and `(t)` agree after inverting
`r`. This is how a local equation of an ideal is read off from a relation holding up to a
multiplier, as produced by Nakayama's lemma.

Conversely, let `A` be the localization of a noetherian ring `R` at a submonoid `S`, typically
the local ring at a prime. If an ideal `I` of `R` generates in `A` a principal ideal with a
nonzerodivisor generator, then the same holds after inverting a single element `r ∈ S`, with a
generator taken from `I` (`IsLocalization.exists_away_isSMulRegular_and_map_eq_span_singleton`).
Geometrically, an ideal sheaf on a locally noetherian scheme whose stalk at `x` is generated by a
nonzerodivisor is generated by a nonzerodivisor on a basic open neighbourhood of `x`.

## Main results

* `Ideal.map_eq_span_singleton_of_isUnit`: if `f r` is a unit for a ring homomorphism `f`,
  then `r • I ≤ (t)` and `t ∈ I` imply that `I` generates `(f t)` after applying `f`.
* `Ideal.map_algebraMap_away_eq_span_singleton`: if `r • I ≤ (t)` and `t ∈ I`, then `I`
  generates `(t)` in the localization away from `r`.
* `Submodule.exists_mem_smul_le_of_fg`: if each element of a finitely generated submodule `N` is
  carried into `P` by some element of `S`, then a single element of `S` carries `N` into `P`.
* `IsLocalization.isSMulRegular_algebraMap_iff`: the image of `a` in `S⁻¹R` is a nonzerodivisor
  exactly when every element killed by `a` is killed by some element of `S`.
* `IsLocalization.exists_away_isSMulRegular_and_map_eq_span_singleton`: a principal ideal with
  a nonzerodivisor generator in `S⁻¹R` is already so after inverting one element of `S`.

## References

* The Stacks Project, *Divisors*, Section *Effective Cartier divisors*: on a locally noetherian
  scheme, effective Cartier divisors are detected on local rings.
-/

public section

open scoped Pointwise

namespace Ideal

/-- If `f r` is a unit, `r • I ≤ (t)`, and `t ∈ I`, then `I` generates the principal ideal
`(f t)` after applying the ring homomorphism `f`. -/
theorem map_eq_span_singleton_of_isUnit {B B' : Type*} [CommSemiring B] [CommSemiring B']
    (f : B →+* B') {I : Ideal B} {r t : B} (ht : t ∈ I) (h : r • I ≤ Ideal.span {t})
    (hr : IsUnit (f r)) :
    I.map f = Ideal.span {f t} := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun i hi ↦ ?_) ?_
  · obtain ⟨b, hb⟩ :=
      Ideal.mem_span_singleton'.mp (h (Submodule.smul_mem_pointwise_smul i r I hi))
    rw [Ideal.mem_comap, ← Ideal.unit_mul_mem_iff_mem _ hr, ← map_mul, ← smul_eq_mul, ← hb,
      map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ ht

/-- If `r • I ≤ (t)` for some `t ∈ I`, then `I` generates the principal ideal `(t)` in the
localization away from `r`. -/
theorem map_algebraMap_away_eq_span_singleton {B B' : Type*} [CommSemiring B]
    [CommSemiring B'] [Algebra B B'] {I : Ideal B} {r t : B} [IsLocalization.Away r B']
    (ht : t ∈ I) (h : r • I ≤ Ideal.span {t}) :
    I.map (algebraMap B B') = Ideal.span {algebraMap B B' t} :=
  map_eq_span_singleton_of_isUnit (algebraMap B B') ht h
    (IsLocalization.Away.algebraMap_isUnit (S := B') r)

end Ideal

namespace Submodule

/-- If every element of a finitely generated submodule `N` is carried into `P` by some element of
a submonoid `S`, then a single element of `S` carries all of `N` into `P`. -/
theorem exists_mem_smul_le_of_fg {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]
    (S : Submonoid R) {N P : Submodule R M} (hN : N.FG) (h : ∀ x ∈ N, ∃ s ∈ S, s • x ∈ P) :
    ∃ s ∈ S, s • N ≤ P := by
  classical
  obtain ⟨t, rfl⟩ := hN
  choose! c hcS hc using fun x (hx : x ∈ t) ↦ h x (subset_span hx)
  refine ⟨∏ x ∈ t, c x, prod_mem fun x hx ↦ hcS x hx, ?_⟩
  rw [smul_span, span_le, Set.smul_set_subset_iff]
  intro x hx
  rw [← Finset.prod_erase_mul t c hx, mul_smul]
  exact P.smul_mem _ (hc x hx)

end Submodule

namespace IsLocalization

variable {R : Type*} [CommRing R] (S : Submonoid R) {A : Type*} [CommRing A] [Algebra R A]
  [IsLocalization S A]

/-- The image of `a` in the localization `S⁻¹R` is a nonzerodivisor exactly when every element of
`R` killed by `a` is killed by some element of `S`. -/
theorem isSMulRegular_algebraMap_iff {a : R} :
    IsSMulRegular A (algebraMap R A a) ↔ ∀ x : R, a * x = 0 → ∃ s ∈ S, s * x = 0 := by
  rw [isSMulRegular_iff_right_eq_zero_of_smul]
  constructor
  · intro h x hx
    obtain ⟨s, hs⟩ := (map_eq_zero_iff S A x).mp
      (h _ (by rw [smul_eq_mul, ← map_mul, hx, map_zero]))
    exact ⟨s, s.2, hs⟩
  · intro h y hy
    obtain ⟨⟨x, s⟩, rfl⟩ := mk'_surjective S y
    rw [smul_eq_mul, mul_mk'_eq_mk'_of_mul, mk'_eq_zero_iff] at hy
    obtain ⟨t, ht⟩ := hy
    obtain ⟨u, hu, hux⟩ := h (t * x) (by rw [mul_left_comm, ht])
    rw [mk'_eq_zero_iff]
    exact ⟨⟨u, hu⟩ * t, by rw [Submonoid.coe_mul, mul_assoc, hux]⟩

/-- **Spreading out a principal ideal with a nonzerodivisor generator.** Let `A` be the
localization of a noetherian ring `R` at a submonoid `S`, and let `I` be an ideal of `R` whose
extension to `A` is generated by a nonzerodivisor of `A`. Then there are `r ∈ S` and `t ∈ I` such
that, in every localization of `R` away from `r`, the image of `t` is a nonzerodivisor generating
the extension of `I`. -/
theorem exists_away_isSMulRegular_and_map_eq_span_singleton [IsNoetherianRing R] {I : Ideal R}
    {y : A} (hy : IsSMulRegular A y) (hI : I.map (algebraMap R A) = Ideal.span {y}) :
    ∃ r ∈ S, ∃ t ∈ I, ∀ (B : Type*) [CommRing B] [Algebra R B] [IsLocalization.Away r B],
      IsSMulRegular B (algebraMap R B t) ∧
        I.map (algebraMap R B) = Ideal.span {algebraMap R B t} := by
  -- Write `y = t / s` with `t ∈ I` and `s ∈ S`; then `t / 1` is also a generator.
  obtain ⟨⟨⟨t, htI⟩, s⟩, hyt⟩ :=
    (mem_map_algebraMap_iff S A).mp (hI ▸ Ideal.mem_span_singleton_self y)
  have hs : IsUnit (algebraMap R A s) := map_units A s
  have ht : IsSMulRegular A (algebraMap R A t) := hyt ▸ hy.mul (hs.isSMulRegular A)
  have hIt : I.map (algebraMap R A) = (Ideal.span {t}).map (algebraMap R A) := by
    rw [Ideal.map_span, Set.image_singleton, ← hyt, Ideal.span_singleton_mul_right_unit hs, hI]
  -- One element `r₁ ∈ S` kills the annihilator of `t`, which is finitely generated.
  obtain ⟨r₁, hr₁, h₁⟩ := Submodule.exists_mem_smul_le_of_fg S (P := ⊥)
    (IsNoetherian.noetherian (Ideal.span {t}).annihilator) fun x hx ↦ by
      rw [Ideal.span, Submodule.mem_annihilator_span_singleton, smul_eq_mul, mul_comm] at hx
      obtain ⟨u, hu, hux⟩ := (isSMulRegular_algebraMap_iff S).mp ht x hx
      exact ⟨u, hu, by rwa [smul_eq_mul, Submodule.mem_bot]⟩
  -- One element `r₂ ∈ S` carries `I`, which is finitely generated, into `(t)`.
  obtain ⟨r₂, hr₂, h₂⟩ := Submodule.exists_mem_smul_le_of_fg S (P := Ideal.span {t})
    (IsNoetherian.noetherian I) fun x hx ↦
      (algebraMap_mem_map_algebraMap_iff S A (Ideal.span {t}) x).mp
        (hIt ▸ Ideal.mem_map_of_mem _ hx)
  refine ⟨r₁ * r₂, mul_mem hr₁ hr₂, t, htI, fun B _ _ _ ↦ ⟨?_, ?_⟩⟩
  · refine (isSMulRegular_algebraMap_iff (.powers (r₁ * r₂))).mpr fun x hx ↦
      ⟨r₁ * r₂, Submonoid.mem_powers _, ?_⟩
    have hx' : x ∈ (Ideal.span {t}).annihilator := by
      rw [Ideal.span, Submodule.mem_annihilator_span_singleton, smul_eq_mul, mul_comm, hx]
    have := h₁ (Submodule.smul_mem_pointwise_smul x r₁ _ hx')
    rw [Submodule.mem_bot, smul_eq_mul] at this
    rw [mul_right_comm, this, zero_mul]
  · refine Ideal.map_eq_span_singleton_of_isUnit _ htI h₂ 
      (isUnit_of_mul_isUnit_right (x := algebraMap R B r₁) ?_)
    rw [← map_mul]
    exact IsLocalization.Away.algebraMap_isUnit (r₁ * r₂)

end IsLocalization
