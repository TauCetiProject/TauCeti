module

public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Localizations of principal ideal rings

Every ideal `J` of a localization `S` of a commutative ring `R` is generated by its contraction
`J ∩ R`. So if every ideal of `R` is principal, then `J` is generated by the image of a generator
of `J ∩ R`, and `S` is again a principal ideal ring. For instance `ℤ[1/m]` is a principal ideal
domain, so the structure theorem for finitely generated modules over a principal ideal domain
applies to `ℤ[1/m]`-modules.

## Main results

* `IsLocalization.isPrincipalIdealRing`: a localization of a principal ideal ring is a principal
  ideal ring.
-/

public section

namespace IsLocalization

variable {R : Type*} [CommRing R] (M : Submonoid R) (S : Type*) [CommRing S] [Algebra R S]
  [IsLocalization M S]

include M in
/-- **A localization of a principal ideal ring is a principal ideal ring.** An ideal of the
localization is generated by the image of a generator of its contraction. -/
theorem isPrincipalIdealRing [IsPrincipalIdealRing R] : IsPrincipalIdealRing S where
  principal J := by
    refine ⟨algebraMap R S (Submodule.IsPrincipal.generator (J.under R)), ?_⟩
    have h := map_under M S J
    rw [← Ideal.span_singleton_generator (J.under R), Ideal.map_span, Set.image_singleton] at h
    exact h.symm

end IsLocalization

/-- A localization of a principal ideal ring, such as `ℤ[1/m] = Localization.Away m`, is a
principal ideal ring. -/
instance Localization.isPrincipalIdealRing {R : Type*} [CommRing R] [IsPrincipalIdealRing R]
    (M : Submonoid R) : IsPrincipalIdealRing (Localization M) :=
  IsLocalization.isPrincipalIdealRing M (Localization M)
