module

public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Localizations of principal ideal rings

Every ideal `J` of a localization `S` of `R` is generated by its contraction to `R`
(`IsLocalization.map_under`). If `R` is a principal ideal ring, that contraction is principal, and
so is `J`. Thus every localization of a principal ideal ring is a principal ideal ring. For
instance `ℤ[1/2] = Localization.Away (2 : ℤ)` is a principal ideal domain, so the structure theorem
for finitely generated modules over a principal ideal domain applies to `ℤ[1/2]`-modules.

## Main results

* `IsLocalization.isPrincipalIdealRing`: a localization of a principal ideal ring is a principal
  ideal ring.
* `Localization.isPrincipalIdealRing`: the same for `Localization M`, as an instance.
-/

public section

namespace IsLocalization

/-- **A localization of a principal ideal ring is a principal ideal ring**: an ideal of the
localization is generated by the image of a generator of its contraction. -/
theorem isPrincipalIdealRing {R : Type*} [CommRing R] [IsPrincipalIdealRing R] (M : Submonoid R)
    (S : Type*) [CommRing S] [Algebra R S] [IsLocalization M S] : IsPrincipalIdealRing S where
  principal J := by
    rw [← IsLocalization.map_under M S J,
      ← (IsPrincipalIdealRing.principal (J.under R)).span_singleton_generator,
      Ideal.map_span, Set.image_singleton]
    exact ⟨_, rfl⟩

end IsLocalization

/-- The localization of a principal ideal ring at a submonoid is a principal ideal ring. -/
instance Localization.isPrincipalIdealRing {R : Type*} [CommRing R] [IsPrincipalIdealRing R]
    (M : Submonoid R) : IsPrincipalIdealRing (Localization M) :=
  IsLocalization.isPrincipalIdealRing M _
