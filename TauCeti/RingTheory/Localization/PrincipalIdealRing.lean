module

public import Mathlib.RingTheory.Localization.Ideal

/-!
# Localizations of principal ideal rings

Every ideal `J` of a localization `S` of `R` is generated by its contraction to `R`
(`IsLocalization.map_under`). So if every ideal of `R` is principal, so is every ideal of `S`:
a localization of a principal ideal ring is a principal ideal ring
(`IsLocalization.isPrincipalIdealRing`). For instance `ℤ[1/m]` is a principal ideal domain,
and the structure theorem for finitely generated modules applies to it.
-/

public section

namespace IsLocalization

variable {R : Type*} [CommSemiring R] (M : Submonoid R) (S : Type*) [CommSemiring S] [Algebra R S]
  [IsLocalization M S]

include M in
/-- **A localization of a principal ideal ring is a principal ideal ring**: an ideal of the
localization is generated by the image of a generator of its contraction. -/
theorem isPrincipalIdealRing [IsPrincipalIdealRing R] : IsPrincipalIdealRing S := by
  refine ⟨fun J ↦ ?_⟩
  rw [← IsLocalization.map_under M S J]
  obtain ⟨a, ha⟩ := (IsPrincipalIdealRing.principal (J.under R)).principal
  exact ⟨algebraMap R S a, by rw [ha, Ideal.submodule_span_eq, Ideal.map_span,
    Set.image_singleton, Ideal.submodule_span_eq]⟩

end IsLocalization
