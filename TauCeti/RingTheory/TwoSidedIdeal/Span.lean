module

public import Mathlib.RingTheory.Jacobson.Radical
public import TauCeti.RingTheory.TwoSidedIdeal.Full
import TauCeti.RingTheory.Jacobson.MulOpposite

/-!
# Two-sided spans and generation modulo the radical

In a ring, the two-sided ideal spanned by a set `s` is the additive subgroup generated by the
products `a * x * b` with `x ∈ s` (Mathlib's `TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure`).
So an additive subgroup contains `TwoSidedIdeal.span s` exactly when it contains every such product.
This is how fullness of an idempotent `e`, `TwoSidedIdeal.span {e} = ⊤`, is used: to show that `1`
lies in an additive subgroup it suffices to show that every `a * e * b` does.

A surjective ring homomorphism with kernel contained in the Jacobson radical reflects
generation of the whole ring as a two-sided ideal. In particular, fullness of an element
can be checked in a quotient by an ideal contained in the radical, such as the radical
quotient itself, where idempotents are easier to select.

## Main results

* `TauCeti.TwoSidedIdeal.coe_span_subset_addSubgroup_iff`: an additive subgroup contains the
  two-sided ideal spanned by `s` if and only if it contains every product `a * x * b` with `x ∈ s`.
* `RingHom.twoSidedIdeal_span_image_eq_top_iff`: generation as a two-sided ideal is detected
  by a surjective map whose kernel lies in the Jacobson radical.
-/

public section

namespace TauCeti

namespace TwoSidedIdeal

variable {R : Type*} [Ring R]

/-- An additive subgroup contains the two-sided ideal spanned by `s` if and only if it contains
every product `a * x * b` with `x ∈ s`. -/
theorem coe_span_subset_addSubgroup_iff {s : Set R} {H : AddSubgroup R} :
    (_root_.TwoSidedIdeal.span s : Set R) ⊆ H ↔ ∀ a, ∀ x ∈ s, ∀ b, a * x * b ∈ H := by
  refine ⟨fun h a x hx b ↦ h ?_, fun h z hz ↦ ?_⟩
  · exact _root_.TwoSidedIdeal.mul_mem_right _ _ _
      (_root_.TwoSidedIdeal.mul_mem_left _ _ _ (_root_.TwoSidedIdeal.subset_span hx))
  · rw [SetLike.mem_coe, _root_.TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hz
    refine (AddSubgroup.closure_le H).2 ?_ hz
    rintro _ ⟨_, ⟨a, -, x, hx, rfl⟩, b, -, rfl⟩
    exact h a x hx b

end TwoSidedIdeal

end TauCeti

namespace RingHom

variable {R S : Type*} [Ring R] [Ring S]

/-- Generation as a two-sided ideal is reflected by a surjective ring map whose kernel lies
in the Jacobson radical. In particular, fullness can be checked modulo the radical. -/
theorem twoSidedIdeal_span_image_eq_top_iff (f : R →+* S) (hf : Function.Surjective f)
    (hker : RingHom.ker f ≤ Ring.jacobson R) (s : Set R) :
    TwoSidedIdeal.span (f '' s) = ⊤ ↔ TwoSidedIdeal.span s = ⊤ := by
  let : RingHomSurjective f := ⟨hf⟩
  constructor
  · intro hs
    let J := TwoSidedIdeal.span s
    have hle : TwoSidedIdeal.span (f '' s) ≤ (J.asIdeal.map f).toTwoSided := by
      apply TwoSidedIdeal.span_le.mpr
      rintro _ ⟨x, hx, rfl⟩
      exact (Ideal.mem_toTwoSided).mpr (Ideal.mem_map_of_mem f
        ((TwoSidedIdeal.mem_asIdeal).mpr (TwoSidedIdeal.subset_span hx)))
    have h1 : (1 : S) ∈ J.asIdeal.map f :=
      (Ideal.mem_toTwoSided).mp (hle (hs ▸ TwoSidedIdeal.mem_top S))
    obtain ⟨a, ha, hfa⟩ := (Ideal.mem_map_iff_of_surjective f hf).mp h1
    have hrad : a - 1 ∈ Ring.jacobson R := hker (by simp [RingHom.mem_ker, hfa])
    have hu : IsUnit a := by
      simpa [add_comm] using
        (TauCeti.Ring.mem_jacobson_iff_isUnit_one_add_mul_left.mp hrad) 1
    have hJ : J.asIdeal = ⊤ := J.asIdeal.eq_top_of_isUnit_mem ha hu
    apply TwoSidedIdeal.eq_top
    exact (TwoSidedIdeal.mem_asIdeal).mp (hJ ▸ Submodule.mem_top)
  · exact TwoSidedIdeal.span_image_eq_top f

end RingHom
