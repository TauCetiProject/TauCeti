module

public import Mathlib.RingTheory.TwoSidedIdeal.Operations
public import TauCeti.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-!
# Two-sided ideals spanned by homogeneous elements

A relation ideal of a noncommutative graded ring is presented as `TwoSidedIdeal.span` of a set of
relators, and it is homogeneous as soon as those relators are. The proof is a span induction
that runs on the componentwise absorption lemmas `Ideal.proj_mul_mem_left` and
`Ideal.proj_mul_mem_right`.

Homogeneity itself is stated through Mathlib's `Ideal.IsHomogeneous`, applied to the underlying
one-sided ideal `TwoSidedIdeal.asIdeal`, which is where the quotient by a two-sided ideal is
formed.

## Main results

* `TwoSidedIdeal.homogeneous_span`: **a two-sided ideal spanned by homogeneous elements is
  homogeneous.**
* `TwoSidedIdeal.mem_span_asIdeal_and_mem_iff_of_subset`: for a two-sided ideal generated in a
  single degree `d`, its degree-`n` slice is spanned by homogeneous left and right multiples of
  total degree `n`.

## References

Mathlib's `Ideal.homogeneous_span` is the one-sided statement that `TwoSidedIdeal.homogeneous_span`
extends from `Ideal.span` to `TwoSidedIdeal.span`.
-/

public section

variable {ι σ A : Type*}

namespace TwoSidedIdeal

variable [Ring A] [SetLike σ A] [AddSubmonoidClass σ A] (𝒜 : ι → σ)
  [DecidableEq ι] [AddMonoid ι] [GradedRing 𝒜]

/-- **A two-sided ideal spanned by homogeneous elements is homogeneous.** This supplies the
homogeneity condition needed to descend a grading to a relation quotient. -/
theorem homogeneous_span {s : Set A} (hs : ∀ x ∈ s, SetLike.IsHomogeneousElem 𝒜 x) :
    (span s).asIdeal.IsHomogeneous 𝒜 := by
  suffices h : ∀ x ∈ span s, ∀ i, GradedRing.proj 𝒜 i x ∈ (span s).asIdeal from
    fun i x hx => by simpa only [GradedRing.proj_apply] using h x (mem_asIdeal.1 hx) i
  intro x hx
  induction hx using span_induction with
  | mem y hy =>
    intro i
    simpa only [one_mul] using Ideal.mul_homogeneous_element_mem_of_mem 𝒜 1 y (hs y hy)
      (mem_asIdeal.2 (subset_span hy)) i
  | zero => intro i; rw [map_zero]; exact Ideal.zero_mem _
  | add y z _ _ ihy ihz => intro i; rw [map_add]; exact Ideal.add_mem _ (ihy i) (ihz i)
  | neg y _ ihy => intro i; rw [map_neg]; exact (Ideal.neg_mem_iff _).2 (ihy i)
  | left_absorb a y _ ihy => exact Ideal.proj_mul_mem_left 𝒜 ihy a
  | right_absorb b y _ ihy => exact Ideal.proj_mul_mem_right 𝒜 ihy b

/-- For a two-sided ideal generated by elements of degree `d` in an `ℕ`-graded algebra, an element
of degree `n` belongs to the ideal if and only if it lies in the `R`-span of homogeneous products
`x * g * y` with `g ∈ s`, `x ∈ 𝒜 i`, `y ∈ 𝒜 j`, and `i + d + j = n`. -/
theorem mem_span_asIdeal_and_mem_iff_of_subset {R A : Type*} [CommSemiring R] [Ring A]
    [Algebra R A] (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] {s : Set A} {d n : ℕ}
    (hs : ∀ g ∈ s, g ∈ 𝒜 d) {z : A} :
    (z ∈ (span s).asIdeal ∧ z ∈ 𝒜 n) ↔
      z ∈ Submodule.span R {w | ∃ (i j : ℕ) (x y g : A),
        i + d + j = n ∧ x ∈ 𝒜 i ∧ y ∈ 𝒜 j ∧ g ∈ s ∧ w = x * g * y} := by
  classical
  let P : Submodule R A := Submodule.span R {w | ∃ (i j : ℕ) (x y g : A),
    i + d + j = n ∧ x ∈ 𝒜 i ∧ y ∈ 𝒜 j ∧ g ∈ s ∧ w = x * g * y}
  have hneg_one : (-1 : A) ∈ 𝒜 0 := by
    have h : (DirectSum.decompose 𝒜 (-1 : A) 0 : A) + 1 = 0 := by
      calc (DirectSum.decompose 𝒜 (-1 : A) 0 : A) + 1
          = (DirectSum.decompose 𝒜 (-1 : A) 0 : A) + (DirectSum.decompose 𝒜 (1 : A) 0 : A) := by
            rw [DirectSum.decompose_of_mem_same 𝒜 SetLike.GradedOne.one_mem]
        _ = (DirectSum.decompose 𝒜 (-1 + 1 : A) 0 : A) := by
            rw [DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add]
        _ = 0 := by simp
    rw [← eq_neg_iff_add_eq_zero.mpr h]
    exact SetLike.coe_mem _
  have neg_mem_𝒜 : ∀ {k : ℕ} {a : A}, a ∈ 𝒜 k → -a ∈ 𝒜 k := fun {k a} ha => by
    simpa using SetLike.GradedMul.mul_mem hneg_one ha
  have neg_mem_P : ∀ {w : A}, w ∈ P → -w ∈ P := fun {w} hw => by
    induction hw using Submodule.span_induction with
    | mem _ hw =>
      obtain ⟨i, j, x, y, g, hij, hx, hy, hg, rfl⟩ := hw
      have heq : -(x * g * y) = (-x) * g * y := by rw [neg_mul, neg_mul]
      rw [heq]
      exact Submodule.subset_span ⟨i, j, -x, y, g, hij, neg_mem_𝒜 hx, hy, hg, rfl⟩
    | zero => simp
    | add _ _ _ _ ha hb => simpa [neg_add, add_comm] using P.add_mem ha hb
    | smul r _ _ ha => simpa [smul_neg] using P.smul_mem r ha
  constructor
  · rintro ⟨hzI, hzdeg⟩
    let H : AddSubgroup A :=
      { carrier := {w | GradedRing.proj 𝒜 n w ∈ P}
        zero_mem' := by simp
        add_mem' := fun ha hb => by simp only [Set.mem_ofPred_eq, map_add]; exact P.add_mem ha hb
        neg_mem' := fun ha => by simp only [Set.mem_ofPred_eq, map_neg]; exact neg_mem_P ha }
    have hsub : (span s : Set A) ⊆ H := by
      intro w hw
      rw [SetLike.mem_coe, mem_span_iff_mem_addSubgroup_closure] at hw
      refine (AddSubgroup.closure_le H).2 ?_ hw
      rintro _ ⟨_, ⟨x, -, g, hg, rfl⟩, y, -, rfl⟩
      change GradedRing.proj 𝒜 n (x * g * y) ∈ P
      rw [mul_assoc, GradedRing.proj_apply, DirectSum.decompose_mul,
        DirectSum.coe_mul_apply_eq_sum_antidiagonal]
      refine Submodule.sum_mem P fun ij hij => ?_
      rw [DirectSum.coe_decompose_mul_of_left_mem 𝒜 ij.2 (hs g hg)]
      split_ifs with hd
      · rw [← mul_assoc]
        refine Submodule.subset_span ⟨ij.1, ij.2 - d, _, _, g, ?_,
          SetLike.coe_mem _, SetLike.coe_mem _, hg, rfl⟩
        have hsum : ij.1 + ij.2 = n := Finset.mem_antidiagonal.mp hij
        omega
      · rw [mul_zero]
        exact P.zero_mem
    have hproj : GradedRing.proj 𝒜 n z ∈ P := hsub (mem_asIdeal.mp hzI)
    rwa [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hzdeg] at hproj
  · intro hz
    induction hz using Submodule.span_induction with
    | mem _ hw =>
      obtain ⟨i, j, x, y, g, hij, hx, hy, hg, rfl⟩ := hw
      refine ⟨mem_asIdeal.mpr (mul_mem_right _ _ _ (mul_mem_left _ _ _ (subset_span hg))), ?_⟩
      exact hij ▸ SetLike.mul_mem_graded (SetLike.mul_mem_graded hx (hs g hg)) hy
    | zero => exact ⟨Ideal.zero_mem _, (𝒜 n).zero_mem⟩
    | add _ _ _ _ hx hy => exact ⟨Ideal.add_mem _ hx.1 hy.1, (𝒜 n).add_mem hx.2 hy.2⟩
    | smul r w _ hw =>
      exact ⟨Algebra.smul_def r w ▸ Ideal.mul_mem_left _ _ hw.1, (𝒜 n).smul_mem r hw.2⟩

end TwoSidedIdeal
