module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
import Mathlib.FieldTheory.Finite.Basic
import Mathlib.RingTheory.RootsOfUnity.Minpoly
import TauCeti.RingTheory.PowerBasis

/-!
# Adjoining a primitive root of unity adjoins all of them

The `n`-th roots of unity in a domain are exactly the powers of a primitive one, so adjoining a
single primitive `n`-th root of unity already produces a subalgebra containing every `n`-th root
of unity. For a field extension, the same holds for the generated intermediate field. The additive
retraction from `ℤ[ζ]` to `ℤ` lets cyclotomic coefficients descend to integral coefficients in
induction arguments.

## Main results

* `IsPrimitiveRoot.mem_algebraAdjoin_of_pow_eq_one`: an `n`-th root of unity lies in the subalgebra
  generated by a primitive `n`-th root of unity.
* `IsPrimitiveRoot.mem_adjoin_of_pow_eq_one`: the analogous intermediate-field statement.
* `IsPrimitiveRoot.adjoin_eq_top_of_natCard_sub_one`: a primitive `(q - 1)`-st root of unity of a
  finite field with `q` elements generates it as an algebra.
* `IsPrimitiveRoot.exists_additive_retraction`: the subalgebra generated by a primitive root of
  unity retracts additively onto `ℤ`.
-/

public section

namespace TauCeti

/-- Every `n`-th root of unity in a domain lies in the subalgebra generated by a primitive
`n`-th root of unity, being one of its powers. -/
theorem _root_.IsPrimitiveRoot.mem_algebraAdjoin_of_pow_eq_one {R S : Type*} [CommSemiring R]
    [CommRing S] [IsDomain S] [Algebra R S] {n : ℕ} [NeZero n] {ζ : S}
    (hζ : IsPrimitiveRoot ζ n) {μ : S} (hμ : μ ^ n = 1) :
    μ ∈ Algebra.adjoin R ({ζ} : Set S) := by
  obtain ⟨i, -, rfl⟩ := hζ.eq_pow_of_pow_eq_one hμ
  exact Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton ζ)) i

/-- **A primitive `(q - 1)`-st root of unity generates a finite field with `q` elements**, as an
algebra over any commutative semiring: every nonzero element is one of its powers. -/
theorem _root_.IsPrimitiveRoot.adjoin_eq_top_of_natCard_sub_one {R F : Type*} [CommSemiring R]
    [Field F] [Finite F] [Algebra R F] {ζ : F} (hζ : IsPrimitiveRoot ζ (Nat.card F - 1)) :
    Algebra.adjoin R ({ζ} : Set F) = ⊤ := by
  have : NeZero (Nat.card F - 1) := ⟨Nat.sub_ne_zero_of_lt Finite.one_lt_card⟩
  have := Fintype.ofFinite F
  refine eq_top_iff.2 fun y _ ↦ ?_
  rcases eq_or_ne y 0 with rfl | hy
  · exact zero_mem _
  exact hζ.mem_algebraAdjoin_of_pow_eq_one (by
    rw [Nat.card_eq_fintype_card]
    exact FiniteField.pow_card_sub_one_eq_one y hy)

/-- The subalgebra generated by a primitive `n`-th root of unity in a characteristic-zero domain
admits an additive retraction onto `ℤ` that sends `1` to `1`. -/
theorem _root_.IsPrimitiveRoot.exists_additive_retraction {S : Type*} [CommRing S] [IsDomain S]
    [CharZero S] {n : ℕ} [NeZero n] {ζ : S} (hζ : IsPrimitiveRoot ζ n) :
    ∃ t : Algebra.adjoin ℤ ({ζ} : Set S) →+ ℤ, t 1 = 1 := by
  let _ : IsIntegrallyClosed ℤ := GCDMonoid.toIsIntegrallyClosed
  let pb : PowerBasis ℤ (Algebra.adjoin ℤ ({ζ} : Set S)) :=
    Algebra.adjoin.powerBasis' (hζ.isIntegral (NeZero.pos n))
  obtain ⟨t, ht⟩ := pb.exists_linearMap_apply_one
  exact ⟨t.toAddMonoidHom, ht⟩

/-- Every `n`-th root of unity of a field extension `K` of `F` lies in the intermediate field
generated over `F` by a primitive `n`-th root of unity, being one of its powers. -/
theorem _root_.IsPrimitiveRoot.mem_adjoin_of_pow_eq_one {F K : Type*} [Field F] [Field K]
    [Algebra F K] {n : ℕ} [NeZero n] {ζ : K} (hζ : IsPrimitiveRoot ζ n) {μ : K}
    (hμ : μ ^ n = 1) : μ ∈ IntermediateField.adjoin F ({ζ} : Set K) := by
  obtain ⟨i, -, rfl⟩ := hζ.eq_pow_of_pow_eq_one hμ
  exact pow_mem (IntermediateField.subset_adjoin F _ (Set.mem_singleton ζ)) i

end TauCeti
