module

public import Mathlib.RingTheory.Ideal.IdempotentFG
public import Mathlib.RingTheory.Jacobson.Ideal
public import Mathlib.RingTheory.Unramified.Basic

/-!
# The diagonal of an unramified algebra

For an essentially finite type, formally unramified algebra `S` over `R`, the kernel of the
multiplication map `S ⊗[R] S → S` is generated by an idempotent. This is the algebraic form of
the fact that the diagonal of an unramified morphism of affine schemes is both open and closed.

Consequently, two algebra maps `f, g : S → T` become equal after any further map inverting the
complement of the image of this idempotent under `f ⊗ g`. If they agree modulo an ideal in the
Jacobson radical of `T`, then they agree already in `T`. In particular, residue sections over a
henselian pair have at most one lift, without any completeness or nilpotence hypothesis.

## References

* [Stacks Project, Tag 02FL](https://stacks.math.columbia.edu/tag/02FL)
* The Stacks Project, Lemma 15.11.5 (uniqueness of sections over a henselian pair).
* `exists_isIdempotentElem_ker_lmul_eq_span` extracts, as a standalone statement, the
  idempotent-generator step at the start of the proof of Mathlib's
  `Algebra.FormallyUnramified.exists_algEquiv_prod`, and follows the same argument.
-/

public section

open scoped TensorProduct

namespace TauCeti.Algebra.FormallyUnramified

/-- The kernel of multiplication on the self-tensor product of an essentially finite type,
formally unramified algebra is generated by an idempotent.

This is the first step of the proof of Mathlib's `Algebra.FormallyUnramified.exists_algEquiv_prod`,
stated on its own. -/
theorem exists_isIdempotentElem_ker_lmul_eq_span (R S : Type*) [CommRing R] [CommRing S]
    [Algebra R S] [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S] :
    ∃ e : S ⊗[R] S, IsIdempotentElem e ∧
      RingHom.ker (Algebra.TensorProduct.lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom =
        Ideal.span {e} :=
  (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg R S)).mp <|
    (Ideal.cotangent_subsingleton_iff _).mp <| inferInstanceAs <| Subsingleton Ω[S⁄R]

/-- If the kernel of multiplication `S ⊗[R] S → S` is contained in the ideal generated by an
idempotent `e`, then two algebra maps `f, g : S → T` agree after composing with any map `h` that
inverts `1 - (f ⊗ g) e`. The target of `h` need not be commutative. -/
theorem comp_eq_comp_of_isUnit_one_sub_productMap {R S T U : Type*}
    [CommSemiring R] [CommRing S] [CommRing T] [Ring U]
    [Algebra R S] [Algebra R T] [Algebra R U] {e : S ⊗[R] S} (he : IsIdempotentElem e)
    (hker : RingHom.ker (Algebra.TensorProduct.lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom ≤
      Ideal.span {e})
    (f g : S →ₐ[R] T) (h : T →ₐ[R] U)
    (hu : IsUnit (h (1 - Algebra.TensorProduct.productMap f g e))) :
    h.comp f = h.comp g := by
  ext b
  rw [AlgHom.comp_apply, AlgHom.comp_apply, ← sub_eq_zero, ← map_sub]
  -- `f b - g b` is the image of `b ⊗ 1 - 1 ⊗ b`, a multiple of `e`.
  have hdiff : f b - g b = Algebra.TensorProduct.productMap f g (b ⊗ₜ[R] 1 - 1 ⊗ₜ[R] b) := by
    simp
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp
    (hker (by simp : b ⊗ₜ[R] 1 - 1 ⊗ₜ[R] b ∈ RingHom.ker _))
  rw [hdiff, ← ha, map_mul, map_mul]
  -- The idempotent image of `e` vanishes once its complement is invertible.
  suffices h (Algebra.TensorProduct.productMap f g e) = 0 by rw [this, mul_zero]
  have hidem : IsIdempotentElem (h (Algebra.TensorProduct.productMap f g e)) := (he.map _).map h
  exact hu.mul_left_eq_zero.mp (by simpa only [map_sub, map_one] using hidem.mul_one_sub_self)

/-- If two maps agree modulo an ideal, their product map sends the kernel of multiplication
into that ideal. -/
theorem productMap_mem_of_comp_eq {R S T : Type*} [CommSemiring R] [CommSemiring S] [CommRing T]
    [Algebra R S] [Algebra R T]
    {e : S ⊗[R] S} (he : Algebra.TensorProduct.lmul' R e = 0) (J : Ideal T)
    {f g : S →ₐ[R] T}
    (hfg : (Ideal.Quotient.mkₐ R J).comp f = (Ideal.Quotient.mkₐ R J).comp g) :
    Algebra.TensorProduct.productMap f g e ∈ J := by
  have hp : (Ideal.Quotient.mkₐ R J).comp (Algebra.TensorProduct.productMap f g) =
      ((Ideal.Quotient.mkₐ R J).comp f).comp (Algebra.TensorProduct.lmul' R) := by
    ext s
    · simp
    · simpa using DFunLike.congr_fun hfg.symm s
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  have h := DFunLike.congr_fun hp e
  simpa only [AlgHom.comp_apply, he, map_zero, Ideal.Quotient.mkₐ_eq_mk] using h

/-- Maps out of an essentially finite type unramified algebra are determined modulo any ideal
contained in the target's Jacobson radical. -/
theorem ext_of_quotient_eq (R S : Type*) [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S]
    {T : Type*} [CommRing T] [Algebra R T] (J : Ideal T) (hJ : J ≤ Ideal.jacobson ⊥)
    {f g : S →ₐ[R] T}
    (hfg : (Ideal.Quotient.mkₐ R J).comp f = (Ideal.Quotient.mkₐ R J).comp g) :
    f = g := by
  obtain ⟨e, he, hker⟩ := exists_isIdempotentElem_ker_lmul_eq_span R S
  have hpe := productMap_mem_of_comp_eq
    (RingHom.mem_ker.mp (hker ▸ Ideal.mem_span_singleton_self e)) J hfg
  have hu : IsUnit (1 - Algebra.TensorProduct.productMap f g e) := by
    apply Ideal.isUnit_of_sub_one_mem_jacobson_bot
    simpa only [sub_sub_cancel_left] using hJ (J.neg_mem hpe)
  simpa only [AlgHom.id_comp] using comp_eq_comp_of_isUnit_one_sub_productMap he hker.le f g
    (AlgHom.id R T) hu

end TauCeti.Algebra.FormallyUnramified
