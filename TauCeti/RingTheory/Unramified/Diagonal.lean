module

public import Mathlib.RingTheory.Ideal.IdempotentFG
public import Mathlib.RingTheory.Unramified.Basic

/-!
# The diagonal of an unramified algebra

For an essentially finite type, formally unramified algebra `S` over `R`, the kernel of the
multiplication map `S ⊗[R] S → S` is generated by an idempotent. This is the algebraic form of
the fact that the diagonal of an unramified morphism of affine schemes is both open and closed.

Consequently, two algebra maps `f, g : S → T` become equal after any further map inverting the
complement of the image of this idempotent under `f ⊗ g`.

## References

* [Stacks Project, Tag 02FL](https://stacks.math.columbia.edu/tag/02FL)
* `exists_isIdempotentElem_ker_lmul_eq_span` extracts, as a standalone statement, the
  idempotent-generator step at the start of the proof of Mathlib's
  `Algebra.FormallyUnramified.exists_algEquiv_prod`, and follows the same argument.
-/

public section

open scoped TensorProduct

namespace TauCeti.Algebra.FormallyUnramified

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

variable (R S) in
/-- The kernel of multiplication on the self-tensor product of an essentially finite type,
formally unramified algebra is generated by an idempotent.

This is the first step of the proof of Mathlib's `Algebra.FormallyUnramified.exists_algEquiv_prod`,
stated on its own. -/
theorem exists_isIdempotentElem_ker_lmul_eq_span [Algebra.EssFiniteType R S]
    [Algebra.FormallyUnramified R S] :
    ∃ e : S ⊗[R] S, IsIdempotentElem e ∧
      RingHom.ker (Algebra.TensorProduct.lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom =
        Ideal.span {e} :=
  (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg R S)).mp <|
    (Ideal.cotangent_subsingleton_iff _).mp <| inferInstanceAs <| Subsingleton Ω[S⁄R]

/-- If an idempotent `e` generates the kernel of multiplication `S ⊗[R] S → S`, then two algebra
maps `f, g : S → T` agree after composing with any map `h` that inverts `1 - (f ⊗ g) e`. -/
theorem comp_eq_comp_of_isUnit_one_sub_productMap {T U : Type*} [CommRing T] [CommRing U]
    [Algebra R T] [Algebra R U] {e : S ⊗[R] S} (he : IsIdempotentElem e)
    (hker : RingHom.ker (Algebra.TensorProduct.lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom ≤
      Ideal.span {e})
    (f g : S →ₐ[R] T) (h : T →ₐ[R] U)
    (hu : IsUnit (h (1 - Algebra.TensorProduct.productMap f g e))) :
    h.comp f = h.comp g := by
  ext b
  rw [AlgHom.comp_apply, AlgHom.comp_apply, ← sub_eq_zero, ← map_sub]
  -- `f b - g b` is the image of `b ⊗ 1 - 1 ⊗ b`, a multiple of `e`.
  have hdiff : f b - g b = Algebra.TensorProduct.productMap f g (b ⊗ₜ[R] 1 - 1 ⊗ₜ[R] b) := by
    simp
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp
    (hker (by simp : b ⊗ₜ[R] 1 - 1 ⊗ₜ[R] b ∈ RingHom.ker _))
  rw [hdiff, ← ha, map_mul, map_mul]
  -- The idempotent image of `e` vanishes once its complement is invertible.
  suffices h (Algebra.TensorProduct.productMap f g e) = 0 by rw [this, mul_zero]
  have hidem : IsIdempotentElem (h (Algebra.TensorProduct.productMap f g e)) := (he.map _).map h
  refine hu.mul_left_eq_zero.mp ?_
  rw [map_sub, map_one, mul_sub, mul_one, hidem.eq, sub_self]

end TauCeti.Algebra.FormallyUnramified
