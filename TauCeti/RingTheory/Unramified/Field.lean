module

public import Mathlib.RingTheory.Unramified.Field

/-!
# Base change of an unramified algebra to a field

If `S` is a formally unramified `R`-algebra of essentially finite type and `K` is a field with an
`R`-algebra structure, then `K ⊗[R] S` is a finite reduced `K`-algebra, in particular an Artinian
reduced ring, and so is `S ⊗[R] K` via the commutativity isomorphism. For `K` the fraction field of
a domain `R` this is the generic fibre of `S`. Consequently, every field receiving a surjective
`K`-algebra homomorphism from `K ⊗[R] S` is a finite separable extension of `K`.

## Main results

* `TauCeti.Algebra.FormallyUnramified.finite_field_tensorProduct`,
  `isArtinianRing_field_tensorProduct` and `isReduced_field_tensorProduct`: `K ⊗[R] S` is finite
  over `K`, Artinian and reduced (registered as instances).
* `TauCeti.Algebra.FormallyUnramified.isSemisimpleRing_field_tensorProduct`: `K ⊗[R] S` is a
  semisimple ring, so each of its ideals is generated by an idempotent (registered as an instance).
* `TauCeti.Algebra.FormallyUnramified.isArtinianRing_tensorProduct_field` and
  `isReduced_tensorProduct_field`: `S ⊗[R] K` is Artinian and reduced (registered as instances).
* `AlgHom.finiteDimensional_and_isSeparable_of_surjective` and
  `AlgHom.finiteDimensional_and_isSeparable_of_surjective_of_isSeparable`: every field quotient of
  `K ⊗[R] S` (in particular, of `K ⊗[K₀] L` for a finite separable extension `L / K₀`) is finite
  and separable over `K`.

## References

* Ported from T. Dupuy, T. Tucker and Z. Wang,
  [pcfawd-formalization](https://github.com/tdupu/pcfawd-formalization) at commit
  `9a20b3f351446d64e6015d704198bc71c7002008` (Apache-2.0),
  `lean/Pcf/Stacks/Common/EtaleNormal.lean`: the instances for `S ⊗[R] K` generalize its
  `Pcf.Stacks.isArtinianRing_isReduced_tensor_fractionRing_of_etale` from étale algebras and the
  fraction field of a domain to unramified algebras and any field.
-/

public section

open scoped TensorProduct

namespace TauCeti.Algebra.FormallyUnramified

variable {R S K : Type*} [CommRing R] [CommRing S] [Algebra R S] [Algebra.FormallyUnramified R S]
  [Algebra.EssFiniteType R S] [Field K] [Algebra R K]

/-- The base change `K ⊗[R] S` of an unramified algebra to a field is a finite `K`-algebra. -/
instance finite_field_tensorProduct : Module.Finite K (K ⊗[R] S) :=
  Algebra.FormallyUnramified.finite_of_free K _

/-- The base change `K ⊗[R] S` of an unramified algebra to a field is an Artinian ring. -/
instance isArtinianRing_field_tensorProduct : IsArtinianRing (K ⊗[R] S) :=
  IsArtinianRing.of_finite K _

/-- The base change `K ⊗[R] S` of an unramified algebra to a field is a reduced ring. -/
instance isReduced_field_tensorProduct : IsReduced (K ⊗[R] S) :=
  Algebra.FormallyUnramified.isReduced_of_field K _

/-- The base change `K ⊗[R] S` of an unramified algebra to a field is a semisimple ring, being
Artinian and reduced. -/
instance isSemisimpleRing_field_tensorProduct : IsSemisimpleRing (K ⊗[R] S) :=
  IsArtinianRing.isSemisimpleRing_of_isReduced _

/-- The base change `S ⊗[R] K` of an unramified algebra to a field is an Artinian ring. -/
instance isArtinianRing_tensorProduct_field : IsArtinianRing (S ⊗[R] K) :=
  (Algebra.TensorProduct.comm R S K).toRingEquiv.symm.isArtinianRing

/-- The base change `S ⊗[R] K` of an unramified algebra to a field is a reduced ring. -/
instance isReduced_tensorProduct_field : IsReduced (S ⊗[R] K) := by
  let e := (Algebra.TensorProduct.comm R S K).toRingEquiv
  exact isReduced_of_injective e.toRingHom e.injective

end TauCeti.Algebra.FormallyUnramified

namespace AlgHom

/-- Every field quotient of the base change `K ⊗[R] S` of a formally unramified `R`-algebra of
essentially finite type to a field `K` is a finite separable extension of `K`. -/
theorem finiteDimensional_and_isSeparable_of_surjective {R S K E : Type*} [CommRing R]
    [CommRing S] [Algebra R S] [Algebra.FormallyUnramified R S] [Algebra.EssFiniteType R S]
    [Field K] [Algebra R K] [Field E] [Algebra K E] (φ : K ⊗[R] S →ₐ[K] E)
    (hφ : Function.Surjective φ) :
    FiniteDimensional K E ∧ Algebra.IsSeparable K E := by
  have : FiniteDimensional K E := Module.Finite.of_surjective φ.toLinearMap hφ
  have : Algebra.FormallyUnramified K E := .of_surjective φ hφ
  exact ⟨‹_›, (Algebra.FormallyUnramified.iff_isSeparable K E).mp ‹_›⟩

/-- Every field quotient of `K ⊗[K₀] L` for a finite separable field extension `L / K₀` is a finite
separable extension of `K`. -/
theorem finiteDimensional_and_isSeparable_of_surjective_of_isSeparable {K₀ L K E : Type*}
    [Field K₀] [Field L] [Algebra K₀ L] [FiniteDimensional K₀ L] [Algebra.IsSeparable K₀ L]
    [Field K] [Algebra K₀ K] [Field E] [Algebra K E] (φ : K ⊗[K₀] L →ₐ[K] E)
    (hφ : Function.Surjective φ) :
    FiniteDimensional K E ∧ Algebra.IsSeparable K E :=
  have := Algebra.FormallyUnramified.of_isSeparable K₀ L
  φ.finiteDimensional_and_isSeparable_of_surjective hφ

end AlgHom
