module

public import Mathlib.RingTheory.DedekindDomain.Basic
public import Mathlib.RingTheory.LocalRing.Quotient
public import Mathlib.RingTheory.RingHom.Unramified
public import Mathlib.RingTheory.Unramified.LocalRing
public import TauCeti.RingTheory.LocalRing.Localization

/-!
# Unramifiedness of a local algebra at its maximal ideal

`Algebra.IsUnramifiedAt R q` is formal unramifiedness over `R` of the localization of the ambient
algebra at the prime `q`. When the ambient algebra `S` is already local and `q` is its maximal
ideal, that localization is `S` itself, because every element outside the maximal ideal is
already a unit. This file records the resulting equivalence, which is what lets a formal
unramifiedness statement about a local ring be read by Mathlib's unramified-locus API, and
conversely.

When the maximal ideal of `S` is generated by that of `R` — as it is for a formally unramified
extension, by `Algebra.FormallyUnramified.map_maximalIdeal` — reduction modulo it loses no
generators: the residues of a subset of `S` span the residue field of `S` over that of `R`
exactly when the subset spans `S` over `R`. This is Mathlib's
`IsLocalRing.quotient_span_eq_top_iff_span_eq_top` read through that generation, and the
module-level companion of Mathlib's `IsLocalRing.adjoin_residue_eq_top_iff_adjoin_eq_top`, which
says the same for generation as an algebra by a single element.

Over a field, an unramified local algebra is a field. Hence a proper ideal of a local algebra
essentially of finite type over a field, with formally unramified quotient, is the maximal ideal.
More generally, over a local ring of dimension at most one, an unramified local algebra which is a
domain but not a field contains the base: a nonzero kernel would be a nonzero prime, hence equal to
the maximal ideal of the base, whose image generates the maximal ideal of the algebra; that image
is zero, so the algebra would be a field. Over a discrete valuation ring this makes the algebra
torsion-free, hence flat, which is what makes an unramified point over a regular point of
codimension one étale.

For an `R`-algebra `S` and primes `q` of `S` and `p = q ∩ R` of `R`, the local homomorphism
`R_p → S_q` is formally unramified iff `S` is unramified over `R` at `q`. Stalk maps of morphisms of
affine schemes are such local homomorphisms, so this is how unramifiedness is read off from a stalk.

## Main results

* `TauCeti.isUnramifiedAt_maximalIdeal_iff`: a local `R`-algebra is unramified at its maximal
  ideal exactly when it is formally unramified over `R`.
* `TauCeti.IsLocalRing.span_residue_image_eq_top_iff_span_eq_top`: if the maximal ideal of a
  module-finite local extension is generated by that of the base, then the residues of a subset
  span the residue extension exactly when the subset spans.
* `Ideal.eq_maximalIdeal_of_formallyUnramified_quotient`: over a field `K`, a proper ideal of a
  local `K`-algebra essentially of finite type, with quotient formally unramified over `K`, is the
  maximal ideal.
* `Algebra.FormallyUnramified.faithfulSMul_of_not_isField`: an unramified local algebra which is a
  domain but not a field, over a local ring of dimension at most one, is a faithful algebra.
* `Localization.formallyUnramified_localRingHom_iff`: the local homomorphism `R_p → S_q` is formally
  unramified iff `S` is unramified over `R` at `q`.
-/

public section

namespace TauCeti

variable (R S : Type*) [CommRing R] [CommRing S] [Algebra R S] [IsLocalRing S]

/-- A local `R`-algebra is unramified at its maximal ideal exactly when it is formally unramified
over `R`: localizing a local ring at its maximal ideal inverts only units. -/
theorem isUnramifiedAt_maximalIdeal_iff :
    Algebra.IsUnramifiedAt R (IsLocalRing.maximalIdeal S) ↔ Algebra.FormallyUnramified R S :=
  (Algebra.FormallyUnramified.iff_of_equiv
    (IsLocalRing.algEquivLocalizationAtMaximalIdeal R S)).symm

section ResidueSpan

variable {R S} [IsLocalRing R] [IsLocalHom (algebraMap R S)] [Module.Finite R S]

/-- **A subset of a finite local extension spans it exactly when its residues span the residue
extension**, provided the maximal ideal of `S` is generated by the maximal ideal of `R` — as it is
when `S` is formally unramified over `R`, by `Algebra.FormallyUnramified.map_maximalIdeal`. -/
theorem IsLocalRing.span_residue_image_eq_top_iff_span_eq_top
    (h : (IsLocalRing.maximalIdeal R).map (algebraMap R S) = IsLocalRing.maximalIdeal S)
    {s : Set S} :
    Submodule.span (IsLocalRing.ResidueField R) (IsLocalRing.residue S '' s) = ⊤ ↔
      Submodule.span R s = ⊤ := by
  -- This is Mathlib's `IsLocalRing.quotient_span_eq_top_iff_span_eq_top` read through `h`.
  -- Both spans descend to `R`-spans, since `R → ResidueField R` is surjective. That removes the
  -- ideal from the scalars, so the hypothesis can be rewritten in the ideal indexing the quotient.
  have H := IsLocalRing.quotient_span_eq_top_iff_span_eq_top (R := R) s
  rw [← Submodule.restrictScalars_eq_top_iff (S := R),
    Submodule.restrictScalars_span R _ Ideal.Quotient.mk_surjective] at H
  rw [h] at H
  rwa [← Submodule.restrictScalars_eq_top_iff (S := R),
    Submodule.restrictScalars_span R (IsLocalRing.ResidueField R)
      (by exact IsLocalRing.residue_surjective)]

end ResidueSpan

section Field

variable {K A : Type*} [Field K] [CommRing A] [Algebra K A] [IsLocalRing A]
  [Algebra.EssFiniteType K A]

variable (K) in
/-- **An unramified quotient of a local algebra is its residue field.** A proper ideal of the
local `K`-algebra `A` whose quotient is unramified over `K` is the maximal ideal. -/
theorem _root_.Ideal.eq_maximalIdeal_of_formallyUnramified_quotient {I : Ideal A}
    [Algebra.FormallyUnramified K (A ⧸ I)] (h : I ≠ ⊤) : I = IsLocalRing.maximalIdeal A := by
  have : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr h
  have : IsLocalRing (A ⧸ I) := .of_surjective' _ Ideal.Quotient.mk_surjective
  -- An unramified local algebra over a field is a field.
  have hB : IsLocalRing.maximalIdeal (A ⧸ I) = ⊥ := by
    rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := K),
      IsLocalRing.maximalIdeal_eq_bot, Ideal.map_bot]
  have hmax : (IsLocalRing.maximalIdeal (A ⧸ I)).comap (Ideal.Quotient.mk I) =
      IsLocalRing.maximalIdeal A :=
    IsLocalRing.eq_maximalIdeal
      (Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective)
  rw [← hmax, hB, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]

end Field

end TauCeti

namespace Algebra.FormallyUnramified

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [IsLocalRing R] [IsLocalRing S]
  [IsLocalHom (algebraMap R S)] [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S]

/-- **An unramified local domain over a local ring of dimension at most one is faithful.** Let
`R` be a local ring of dimension at most one and `S` a local `R`-algebra, essentially of finite
type and formally unramified, with `R → S` local. If `S` is a domain but not a field, then
`R → S` is injective. Over a Dedekind domain, for instance a discrete valuation ring, `S` is then
torsion-free and hence flat over `R`. -/
theorem faithfulSMul_of_not_isField [Ring.DimensionLEOne R] [IsDomain S] (hS : ¬IsField S) :
    FaithfulSMul R S := by
  refine (faithfulSMul_iff_algebraMap_injective R S).mpr <|
    (RingHom.injective_iff_ker_eq_bot _).mpr ?_
  -- A nonzero kernel is a nonzero prime, hence the maximal ideal of `R`. As `S` is unramified,
  -- the maximal ideal of `R` generates that of `S`, which would then be zero.
  by_contra hker
  have hmax := Ring.DimensionLEOne.maximalOfPrime hker (RingHom.ker_isPrime (algebraMap R S))
  refine hS (IsLocalRing.isField_iff_maximalIdeal_eq.mpr ?_)
  rw [← map_maximalIdeal (R := R), ← IsLocalRing.eq_maximalIdeal hmax,
    Ideal.map_eq_bot_iff_le_ker]

end Algebra.FormallyUnramified

namespace Localization

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The local homomorphism `R_p → S_q` at primes `q` over `p` is formally unramified iff `S` is
unramified over `R` at `q`. -/
theorem formallyUnramified_localRingHom_iff (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime]
    (h : p = q.comap (algebraMap R S)) :
    (localRingHom p q (algebraMap R S) h).FormallyUnramified ↔ Algebra.IsUnramifiedAt R q := by
  have : q.LiesOver p := ⟨h⟩
  let := AtPrime.algebraOfLiesOver p q
  refine RingHom.formallyUnramified_algebraMap.trans
    ⟨fun _ ↦ Algebra.FormallyUnramified.comp R (Localization.AtPrime p) _,
      fun _ ↦ .of_restrictScalars R _ _⟩

end Localization
