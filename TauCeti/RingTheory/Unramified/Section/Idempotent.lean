module

public import TauCeti.RingTheory.Unramified.Diagonal
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Idempotents
public import Mathlib.RingTheory.Jacobson.Ideal

/-!
# Sections of unramified algebras

A section of an essentially finite type, formally unramified algebra selects an open-and-closed
component. Its kernel is generated by the complement of an idempotent, and the section is
localization at that idempotent. Two maps from such an algebra agree if they agree modulo an
ideal in the Jacobson radical of their target. In particular, residue sections over a henselian
pair have at most one lift, without any completeness or nilpotence hypothesis.

The diagonal idempotent is supplied by `exists_isIdempotentElem_ker_lmul_eq_span`.

## References

* The Stacks Project, Tag 02FL (the diagonal of an unramified morphism).
* The Stacks Project, Lemma 15.11.5 (uniqueness of sections over a henselian pair).
-/

public section

open scoped TensorProduct

namespace TauCeti.Algebra.FormallyUnramified

variable {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
  [Algebra R S] [Algebra R T]
  [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S]

variable (R S) in
/-- A section of an essentially finite type unramified algebra selects an idempotent component.
The kernel is generated by the complement of the selector, which maps to one. -/
theorem exists_isIdempotentElem_ker_eq_span (σ : S →ₐ[R] R) :
    ∃ e : S, IsIdempotentElem e ∧ σ e = 1 ∧
      RingHom.ker σ = Ideal.span {1 - e} := by
  obtain ⟨d, hd, hker⟩ := exists_isIdempotentElem_ker_lmul_eq_span R S
  let g : S →ₐ[R] S := (Algebra.ofId R S).comp σ
  let p : S ⊗[R] S →ₐ[R] S := Algebra.TensorProduct.productMap g (AlgHom.id R S)
  have hσp : σ.comp p = σ.comp (Algebra.TensorProduct.lmul' R) := by
    ext s <;> simp [p, g]
  have hdker : Algebra.TensorProduct.lmul' R d = 0 :=
    RingHom.mem_ker.mp (hker ▸ Ideal.mem_span_singleton_self d)
  have hσd : σ (p d) = 0 := by
    have h := DFunLike.congr_fun hσp d
    simpa only [AlgHom.comp_apply, hdker, map_zero] using h
  refine ⟨1 - p d, (hd.map p).one_sub, by simp [hσd], ?_⟩
  rw [sub_sub_cancel]
  apply le_antisymm
  · intro s hs
    have hdiff : s - g s ∈ Ideal.span {p d} := by
      have hm : 1 ⊗ₜ[R] s - s ⊗ₜ[R] 1 ∈
          RingHom.ker (Algebra.TensorProduct.lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom := by
        simp
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (hker ▸ hm)
      have h := congrArg p ha
      simp only [map_mul] at h
      have hp : p (1 ⊗ₜ[R] s - s ⊗ₜ[R] 1) = s - g s := by simp [p]
      rw [hp] at h
      exact Ideal.mem_span_singleton'.mpr ⟨p a, h⟩
    have hσs : σ s = 0 := RingHom.mem_ker.mp hs
    simpa [g, hσs] using hdiff
  · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hσd)

variable (R S) in
/-- A section is localization at its idempotent selector. The algebra structure on the target
is the one induced by the section, not the original structure map `R → S`. -/
theorem exists_isIdempotentElem_isLocalizationAway (σ : S →ₐ[R] R) :
    ∃ e : S, IsIdempotentElem e ∧ σ e = 1 ∧
      let _ := σ.toRingHom.toAlgebra
      IsLocalization.Away e R := by
  obtain ⟨e, he, hσe, hker⟩ := exists_isIdempotentElem_ker_eq_span R S σ
  refine ⟨e, he, hσe, ?_⟩
  let _ := σ.toRingHom.toAlgebra
  exact IsLocalization.away_of_isIdempotentElem he hker
    (fun r ↦ ⟨algebraMap R S r, σ.commutes r⟩)

variable (R S) in
/-- A section splits an essentially finite type unramified algebra as a product. The first
projection is the specified section, and the other factor is the complementary component. -/
theorem exists_algEquiv_prod_of_section (σ : S →ₐ[R] R) :
    ∃ (e : S) (_ : IsIdempotentElem e) (E : S ≃ₐ[R] R × (S ⧸ Ideal.span {e})),
      ∀ s, E s = (σ s, Ideal.Quotient.mk _ s) := by
  obtain ⟨e, he, _, hker⟩ := exists_isIdempotentElem_ker_eq_span R S σ
  have hσ : Function.Surjective σ := fun r ↦ ⟨algebraMap R S r, σ.commutes r⟩
  let q : (S ⧸ Ideal.span {1 - e}) ≃ₐ[R] R :=
    ((Ideal.span {1 - e}).quotientEquivAlgOfEq R hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hσ)
  have hq (s : S) : q (Ideal.Quotient.mk _ s) = σ s := by
    dsimp only [q]
    rw [AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk,
      Ideal.quotientKerAlgEquivOfSurjective_mk]
  let p := AlgEquiv.prodQuotientOfIsIdempotentElem R he.one_sub he (by simp)
    (by simp [sub_mul, he.eq])
  refine ⟨e, he, p.trans (AlgEquiv.prodCongr q (AlgEquiv.refl)), ?_⟩
  intro s
  ext
  · simpa [p] using hq s
  · simp [p]

variable (R S) in
/-- Maps out of an essentially finite type unramified algebra are determined modulo any ideal
contained in the target's Jacobson radical. -/
theorem ext_of_quotient_eq (J : Ideal T) (hJ : J ≤ Ideal.jacobson ⊥)
    {f g : S →ₐ[R] T}
    (hfg : (Ideal.Quotient.mkₐ R J).comp f = (Ideal.Quotient.mkₐ R J).comp g) :
    f = g := by
  obtain ⟨e, he, hker⟩ := exists_isIdempotentElem_ker_lmul_eq_span R S
  let p : S ⊗[R] S →ₐ[R] T := Algebra.TensorProduct.productMap f g
  have hp : (Ideal.Quotient.mkₐ R J).comp p =
      ((Ideal.Quotient.mkₐ R J).comp f).comp (Algebra.TensorProduct.lmul' R) := by
    ext s
    · simp [p]
    · simpa [p] using DFunLike.congr_fun hfg.symm s
  have heker : Algebra.TensorProduct.lmul' R e = 0 :=
    RingHom.mem_ker.mp (hker ▸ Ideal.mem_span_singleton_self e)
  have hpe : p e ∈ J := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have h := DFunLike.congr_fun hp e
    simpa only [AlgHom.comp_apply, heker, map_zero, Ideal.Quotient.mkₐ_eq_mk] using h
  have hu : IsUnit (1 - p e) := by
    apply Ideal.isUnit_of_sub_one_mem_jacobson_bot
    simpa only [sub_sub_cancel_left] using hJ (J.neg_mem hpe)
  simpa only [AlgHom.id_comp] using comp_eq_comp_of_isUnit_one_sub_productMap he hker.le f g
    (AlgHom.id R T) hu

end TauCeti.Algebra.FormallyUnramified
