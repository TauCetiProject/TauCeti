module

public import TauCeti.RingTheory.Unramified.Diagonal
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Idempotents

/-!
# Sections of unramified algebras

A section of an essentially finite type, formally unramified algebra selects an open-and-closed
component. Its kernel is generated by the complement of an idempotent, and the section is
localization at that idempotent. The same selector also gives a product decomposition into
the section component and its complement.

The diagonal idempotent is supplied by `exists_isIdempotentElem_ker_lmul_eq_span`.

## References

* The Stacks Project, Tag 02FL (the diagonal of an unramified morphism).
-/

public section

open scoped TensorProduct

namespace TauCeti.Algebra.FormallyUnramified

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

variable (R S) in
/-- A section of an essentially finite type unramified algebra selects an idempotent component.
The kernel is generated by the complement of the selector, which maps to one. -/
theorem exists_isIdempotentElem_ker_eq_span [Algebra.EssFiniteType R S]
    [Algebra.FormallyUnramified R S] (σ : S →ₐ[R] R) :
    ∃ e : S, IsIdempotentElem e ∧ σ e = 1 ∧
      RingHom.ker σ = Ideal.span {1 - e} := by
  obtain ⟨d, hd, hker⟩ := exists_isIdempotentElem_ker_lmul_eq_span R S
  let g : S →ₐ[R] S := (Algebra.ofId R S).comp σ
  let p : S ⊗[R] S →ₐ[R] S := Algebra.TensorProduct.productMap g (AlgHom.id R S)
  have hσp : σ.comp p = σ.comp (Algebra.TensorProduct.lmul' R) := by
    ext s <;> simp [p, g]
  have hdker : Algebra.TensorProduct.lmul' R d = 0 :=
    RingHom.mem_ker.mp (hker ▸ Ideal.mem_span_singleton_self d)
  have hσd : σ (p d) = 0 := by
    have h := DFunLike.congr_fun hσp d
    simpa only [AlgHom.comp_apply, hdker, map_zero] using h
  refine ⟨1 - p d, (hd.map p).one_sub, by simp [hσd], ?_⟩
  rw [sub_sub_cancel]
  apply le_antisymm
  · intro s hs
    have hdiff : s - g s ∈ Ideal.span {p d} := by
      have hm : 1 ⊗ₜ[R] s - s ⊗ₜ[R] 1 ∈
          RingHom.ker (Algebra.TensorProduct.lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom := by
        simp
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (hker ▸ hm)
      have h := congrArg p ha
      simp only [map_mul] at h
      have hp : p (1 ⊗ₜ[R] s - s ⊗ₜ[R] 1) = s - g s := by simp [p]
      rw [hp] at h
      exact Ideal.mem_span_singleton'.mpr ⟨p a, h⟩
    have hσs : σ s = 0 := RingHom.mem_ker.mp hs
    simpa [g, hσs] using hdiff
  · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hσd)

/-- A section is localization at any idempotent selector whose complement generates its kernel.
The algebra structure on the target is the one induced by the section. -/
theorem isLocalizationAway_of_ker_eq_span (σ : S →ₐ[R] R) {e : S}
    (he : IsIdempotentElem e) (hker : RingHom.ker σ = Ideal.span {1 - e}) :
    let _ := σ.toRingHom.toAlgebra
    IsLocalization.Away e R := by
  let _ := σ.toRingHom.toAlgebra
  exact IsLocalization.away_of_isIdempotentElem he hker
    (fun r ↦ ⟨algebraMap R S r, σ.commutes r⟩)

/-- An idempotent selector whose complement generates the kernel of a section splits the algebra
as a product. The first factor is the section component, and the second is its complement. -/
noncomputable def prodOfKerEqSpan (σ : S →ₐ[R] R) {e : S}
    (he : IsIdempotentElem e) (hker : RingHom.ker σ = Ideal.span {1 - e}) :
    S ≃ₐ[R] R × (S ⧸ Ideal.span {e}) :=
  let hσ : Function.Surjective σ := fun r ↦ ⟨algebraMap R S r, σ.commutes r⟩
  let q : (S ⧸ Ideal.span {1 - e}) ≃ₐ[R] R :=
    ((Ideal.span {1 - e}).quotientEquivAlgOfEq R hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hσ)
  let p := AlgEquiv.prodQuotientOfIsIdempotentElem R he.one_sub he (by simp)
    (by simp [sub_mul, he.eq])
  p.trans (AlgEquiv.prodCongr q (AlgEquiv.refl))

/-- The product decomposition has the given section and quotient map as its projections. -/
@[simp]
theorem prodOfKerEqSpan_apply (σ : S →ₐ[R] R) {e : S}
    (he : IsIdempotentElem e) (hker : RingHom.ker σ = Ideal.span {1 - e}) (s : S) :
    prodOfKerEqSpan σ he hker s = (σ s, Ideal.Quotient.mk _ s) := by
  ext
  · simp only [prodOfKerEqSpan, AlgEquiv.trans_apply, AlgEquiv.prodCongr_apply,
      Equiv.prodCongr_apply, EquivLike.coe_coe, AlgEquiv.coe_trans, AlgEquiv.coe_refl, Prod.map_fst,
      AlgEquiv.prodQuotientOfIsIdempotentElem_apply_fst, Function.comp_apply,
      Ideal.quotientEquivAlgOfEq_mk]
    exact Ideal.quotientKerAlgEquivOfSurjective_mk _ s
  · simp [prodOfKerEqSpan]

end TauCeti.Algebra.FormallyUnramified
