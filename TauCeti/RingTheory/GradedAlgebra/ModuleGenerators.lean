module

public import Mathlib.LinearAlgebra.Dimension.Finite
public import TauCeti.Algebra.Module.GradedModule.Nakayama
public import TauCeti.RingTheory.GradedAlgebra.Homogeneous.Quotient
import Mathlib.LinearAlgebra.Basis.VectorSpace

/-!
# Lifting module generators from a homogeneous quotient

Let `B` be a homogeneous subalgebra of an `ℕ`-graded algebra `A`, and let `I` be the ideal
generated by its positive-degree homogeneous elements. Homogeneous elements whose classes span
`A / I` over the coefficient ring generate `A` as a `B`-module. Over a field, a finite-dimensional
quotient therefore gives a finite homogeneous generating family whose classes are a basis.

This is the module form of graded Nakayama used to construct minimal homogeneous presentations
over invariant subalgebras. It does not assert that the lifted generators are linearly independent
over `B`.

Generation uses `TauCeti.InternalGrading.eq_top_of_piece_le_sup_positive_smul_top`. The
homogeneous quotient basis is Mathlib's `DirectSum.IsInternal.collectedBasis`.
-/

public section

open DirectSum

namespace Subalgebra

section CommSemiring

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
  (B : Subalgebra R A) (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
  (hB : SetLike.IsHomogeneous 𝒜 B)

include hB in
/-- A family homogeneous for the ambient grading spans a homogeneous module over a homogeneous
subalgebra. -/
theorem isHomogeneous_span {ι : Type*} (b : ι → A)
    (hb : ∀ i, ∃ n, b i ∈ 𝒜 n) :
    SetLike.IsHomogeneous 𝒜 (Submodule.span B (Set.range b)) := by
  classical
  intro n x hx
  obtain ⟨m, c, g, hcg⟩ := Submodule.mem_span_set'.1 hx
  rw [← hcg, ← GradedAlgebra.proj_apply, map_sum]
  refine Submodule.sum_mem _ fun i _ ↦ ?_
  obtain ⟨j, hj⟩ := (g i).2
  obtain ⟨d, hd⟩ := hb j
  simp only [Subalgebra.smul_def, smul_eq_mul]
  rw [← hj, GradedAlgebra.proj_apply, coe_decompose_mul_of_right_mem 𝒜 n hd]
  split_ifs
  · exact (Submodule.span B (Set.range b)).smul_mem
      ⟨_, hB _ (c i).2⟩ (Submodule.subset_span ⟨j, rfl⟩)
  · exact zero_mem _

end CommSemiring

variable {R A : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
  (B : Subalgebra R A) (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
  (hB : SetLike.IsHomogeneous 𝒜 B)

include hB in
/-- Homogeneous lifts of a spanning family modulo the ideal generated by the positive-degree
elements of `B` generate the ambient algebra as a `B`-module. -/
theorem span_eq_top_of_span_quotient_eq_top {ι : Type*} (b : ι → A)
    (hb : ∀ i, ∃ n, b i ∈ 𝒜 n)
    (hq : Submodule.span R (Set.range fun i ↦ Ideal.Quotient.mk
      (Ideal.span {x | x ∈ B ∧ ∃ n, 0 < n ∧ x ∈ 𝒜 n}) (b i)) = ⊤) :
    Submodule.span B (Set.range b) = ⊤ := by
  classical
  let I := Ideal.span {x | x ∈ B ∧ ∃ n, 0 < n ∧ x ∈ 𝒜 n}
  let U := Submodule.span B (Set.range b)
  have hU := B.isHomogeneous_span 𝒜 hB b hb
  have hmod (x : A) : ∃ u ∈ U, x - u ∈ I := by
    have hq' : Ideal.Quotient.mk I x ∈
        (Submodule.span R (Set.range b)).map (Ideal.Quotient.mkₐ R I).toLinearMap := by
      rw [Submodule.map_span, ← Set.range_comp]
      exact hq.symm ▸ Submodule.mem_top
    obtain ⟨u, hu, hux⟩ := hq'
    refine ⟨u, Submodule.span_le_restrictScalars R B _ hu, ?_⟩
    exact Ideal.Quotient.eq.mp hux.symm
  let 𝓑 (n : ℕ) : Submodule R B := (𝒜 n).comap B.val.toLinearMap
  let G := TauCeti.InternalGrading.ofDecomposition 𝒜
  have : SetLike.GradedSMul 𝓑 G.piece := by
    dsimp only [G]
    rw [TauCeti.InternalGrading.ofDecomposition_piece]
    exact ⟨fun _ _ _ _ ha hx => SetLike.GradedMul.mul_mem ha hx⟩
  apply TauCeti.InternalGrading.eq_top_of_piece_le_sup_positive_smul_top 𝓑 U
    ((TauCeti.InternalGrading.isHomogeneous_ofDecomposition_piece_iff 𝒜
      (U.restrictScalars R)).mpr hU) 0 (fun p hp => (Nat.not_lt_zero p hp).elim)
  intro n x _
  obtain ⟨u, hu, hz⟩ := hmod x
  refine Submodule.mem_sup.mpr ⟨u, hu, x - u, ?_, add_sub_cancel _ _⟩
  obtain ⟨m, c, g, hcg⟩ := Submodule.mem_span_set'.1 hz
  rw [← hcg]
  refine Submodule.sum_mem _ fun i _ => ?_
  obtain ⟨hgB, d, hd, hgd⟩ := (g i).2
  have hg : (⟨g i, hgB⟩ : B) ∈ ⨆ (n : ℕ) (_ : 0 < n), 𝓑 n :=
    Submodule.mem_iSup_of_mem d (Submodule.mem_iSup_of_mem hd hgd)
  simpa only [Subalgebra.smul_def, smul_eq_mul, mul_comm] using
    Submodule.smul_mem_smul hg (Submodule.mem_top (x := c i) (R := R))

end Subalgebra

namespace TauCeti.GradedAlgebra

universe u

variable {K : Type*} {A : Type u} [Field K] [CommRing A] [Algebra K A]
  (𝒜 : ℕ → Submodule K A) [GradedAlgebra 𝒜]
  (B : Subalgebra K A) (hB : SetLike.IsHomogeneous 𝒜 B)

include hB in
/-- A finite-dimensional quotient by the positive-degree elements of a homogeneous subalgebra
has homogeneous basis lifts which form a finite generating family over that subalgebra. -/
theorem exists_homogeneous_generators_of_finite_quotient
    [Module.Finite K (A ⧸ Ideal.span {x | x ∈ B ∧ ∃ n, 0 < n ∧ x ∈ 𝒜 n})] :
    ∃ (ι : Type u) (_ : Finite ι) (b : ι → A) (d : ι → ℕ),
      (∀ i, b i ∈ 𝒜 (d i)) ∧
      LinearIndependent K (fun i ↦ Ideal.Quotient.mk
        (Ideal.span {x | x ∈ B ∧ ∃ n, 0 < n ∧ x ∈ 𝒜 n}) (b i)) ∧
      Submodule.span K (Set.range fun i ↦ Ideal.Quotient.mk
        (Ideal.span {x | x ∈ B ∧ ∃ n, 0 < n ∧ x ∈ 𝒜 n}) (b i)) = ⊤ ∧
      Submodule.span B (Set.range b) = ⊤ := by
  classical
  let I := Ideal.span {x | x ∈ B ∧ ∃ n, 0 < n ∧ x ∈ 𝒜 n}
  have hI : I.IsHomogeneous 𝒜 :=
    Ideal.homogeneous_span 𝒜 _ fun _ ⟨_, n, _, hn⟩ ↦ ⟨n, hn⟩
  let P := quotientPiece 𝒜 I
  let v (n : ℕ) := Module.Free.chooseBasis K (P n)
  let q := (isInternal_quotientPiece 𝒜 I hI).collectedBasis v
  have hq (i) : q i ∈ P i.1 :=
    (isInternal_quotientPiece 𝒜 I hI).collectedBasis_mem v i
  choose b hb hbq using fun i ↦ (mem_quotientPiece_iff 𝒜 I).1 (hq i)
  have heq : (fun i ↦ Ideal.Quotient.mk I (b i)) = q := funext hbq
  have : Finite (Σ n, Module.Free.ChooseBasisIndex K (P n)) :=
    q.linearIndependent.finite
  refine ⟨_, this, b, fun i ↦ i.1, hb, ?_, ?_, ?_⟩
  · exact heq.symm ▸ q.linearIndependent
  · exact heq.symm ▸ q.span_eq
  · exact B.span_eq_top_of_span_quotient_eq_top 𝒜 hB b (fun i ↦ ⟨_, hb i⟩)
      (heq.symm ▸ q.span_eq)

end TauCeti.GradedAlgebra
