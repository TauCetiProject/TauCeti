import TauCeti.RingTheory.GradedAlgebra.Generators

/-!
# Graded supercommutativity from generators

In an internally `ι`-graded `R`-algebra `A` generated by a homogeneous family `e : S → A` with
degrees `deg : S → ι` (or by the image of a degree-`0` linear map `g : V →ₗ[R] A` from a spanned
`ι`-graded module `(V, 𝒱)`), biadditive scalar-twisted commutation relations
`e t₁ * e t₂ = s (deg t₁) (deg t₂) • (e t₂ * e t₁)` between generators propagate to all
homogeneous elements `a ∈ 𝒜 i` and `b ∈ 𝒜 j` without requiring `A` to be a ring or `ι` to be
commutative.

## Main results

* `TauCeti.mul_eq_smul_mul_right_of_adjoin_range_eq_top` and
  `TauCeti.mul_eq_smul_mul_right_of_adjoin_range_eq_top_of_isHomogeneous`: scalar-twisted
  commutation of an element `a : A` with homogeneous generators extends to all homogeneous right
  factors.
* `TauCeti.mul_eq_smul_mul_left_of_adjoin_range_eq_top` and
  `TauCeti.mul_eq_smul_mul_left_of_adjoin_range_eq_top_of_isHomogeneous`: scalar-twisted
  commutation of homogeneous generators with an element `b : A` extends to all homogeneous left
  factors.
* `TauCeti.mul_eq_smul_mul_of_adjoin_range_eq_top` and
  `TauCeti.mul_eq_smul_mul_of_adjoin_range_eq_top_of_isHomogeneous`: biadditive scalar-twisted
  commutation on homogeneous generators extends to all pairs of homogeneous elements.

## References

* J. Pardon, *Contact homology and virtual fundamental cycles*, equation (1.1), for graded Koszul
  commutation relations in free supercommutative algebras.
-/

public section

namespace TauCeti

section Generators

variable {R A M ι : Type*} [CommSemiring R] [Semiring A] [Algebra R A]
  [DecidableEq ι] [AddMonoid ι] {𝒜 : ι → Submodule R A} [GradedAlgebra 𝒜]
  [Monoid M] [DistribMulAction M A] [IsScalarTower M A A] [SMulCommClass M A A]
  [SMulCommClass R M A]

/-- If `a : A` satisfies `a * e s = c (deg s) • (e s * a)` for every member of an
algebra-generating family `e : S → A` with `e s ∈ 𝒜 (deg s)`, and `c : ι → M` is multiplicative,
then `a * b = c j • (b * a)` for every `b ∈ 𝒜 j`. -/
theorem mul_eq_smul_mul_right_of_adjoin_range_eq_top {S : Type*} {a : A} {c : ι → M}
    (hc0 : c 0 = 1) (hc : ∀ j₁ j₂, c (j₁ + j₂) = c j₁ * c j₂)
    (e : S → A) (deg : S → ι) (hadj : Algebra.adjoin R (Set.range e) = ⊤)
    (hhom : ∀ s, e s ∈ 𝒜 (deg s)) (hcomm : ∀ s, a * e s = c (deg s) • (e s * a))
    {j : ι} {b : A} (hb : b ∈ 𝒜 j) :
    a * b = c j • (b * a) := by
  let ℬ : ι → Submodule R A := fun k ↦
    { carrier := {b : A | a * b = c k • (b * a)}
      add_mem' := fun {b₁ b₂} hb₁ hb₂ ↦ by
        simp only [Set.mem_ofPred_eq] at hb₁ hb₂ ⊢
        rw [mul_add, add_mul, smul_add, hb₁, hb₂]
      zero_mem' := by simp
      smul_mem' := fun r {b} hb ↦ by
        simp only [Set.mem_ofPred_eq] at hb ⊢
        rw [Algebra.mul_smul_comm, Algebra.smul_mul_assoc, hb, smul_comm] }
  have hmem : ∀ {k b}, b ∈ ℬ k ↔ a * b = c k • (b * a) := fun {_ _} ↦ by simp [ℬ]
  refine hmem.1 <| GradedAlgebra.grade_le_of_adjoin_eq_top 𝒜 (ℬ := ℬ)
    (hmem.2 (by simp [hc0]))
    (fun {_ _ _ _} _ hb₁ _ hb₂ ↦ hmem.2 <| by
      rw [hc]
      exact mul_mul_eq_smul_of_mul_eq_smul_right (hmem.1 hb₁) (hmem.1 hb₂))
    hadj ?_ j hb
  rintro _ ⟨s, rfl⟩
  exact le_iSup (fun k ↦ 𝒜 k ⊓ ℬ k) (deg s) ⟨hhom s, hmem.2 (hcomm s)⟩

/-- If `b : A` satisfies `e s * b = c (deg s) • (b * e s)` for every member of an
algebra-generating family `e : S → A` with `e s ∈ 𝒜 (deg s)`, and `c : ι → M` satisfies
`c (i₁ + i₂) = c i₂ * c i₁`, then `a * b = c i • (b * a)` for every `a ∈ 𝒜 i`. -/
theorem mul_eq_smul_mul_left_of_adjoin_range_eq_top {S : Type*} {b : A} {c : ι → M}
    (hc0 : c 0 = 1) (hc : ∀ i₁ i₂, c (i₁ + i₂) = c i₂ * c i₁)
    (e : S → A) (deg : S → ι) (hadj : Algebra.adjoin R (Set.range e) = ⊤)
    (hhom : ∀ s, e s ∈ 𝒜 (deg s)) (hcomm : ∀ s, e s * b = c (deg s) • (b * e s))
    {i : ι} {a : A} (ha : a ∈ 𝒜 i) :
    a * b = c i • (b * a) := by
  let ℬ : ι → Submodule R A := fun k ↦
    { carrier := {a : A | a * b = c k • (b * a)}
      add_mem' := fun {a₁ a₂} ha₁ ha₂ ↦ by
        simp only [Set.mem_ofPred_eq] at ha₁ ha₂ ⊢
        rw [add_mul, mul_add, smul_add, ha₁, ha₂]
      zero_mem' := by simp
      smul_mem' := fun r {a} ha ↦ by
        simp only [Set.mem_ofPred_eq] at ha ⊢
        rw [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, ha, smul_comm] }
  have hmem : ∀ {k a}, a ∈ ℬ k ↔ a * b = c k • (b * a) := fun {_ _} ↦ by simp [ℬ]
  refine hmem.1 <| GradedAlgebra.grade_le_of_adjoin_eq_top 𝒜 (ℬ := ℬ)
    (hmem.2 (by simp [hc0]))
    (fun {_ _ _ _} _ ha₁ _ ha₂ ↦ hmem.2 <| by
      rw [hc]
      exact mul_mul_eq_smul_of_mul_eq_smul_left (hmem.1 ha₁) (hmem.1 ha₂))
    hadj ?_ i ha
  rintro _ ⟨s, rfl⟩
  exact le_iSup (fun k ↦ 𝒜 k ⊓ ℬ k) (deg s) ⟨hhom s, hmem.2 (hcomm s)⟩

/-- **Graded supercommutativity from a generating family.** If an algebra-generating family
`e : S → A` has homogeneous images `e t ∈ 𝒜 (deg t)` obeying
`e t₁ * e t₂ = s (deg t₁) (deg t₂) • (e t₂ * e t₁)` for a biadditive commutation factor
`s : ι → ι → M`, then `a * b = s i j • (b * a)` for all `a ∈ 𝒜 i` and `b ∈ 𝒜 j`. -/
theorem mul_eq_smul_mul_of_adjoin_range_eq_top {S : Type*} {s : ι → ι → M}
    (hs_zero_right : ∀ i, s i 0 = 1)
    (hs_add_right : ∀ i j₁ j₂, s i (j₁ + j₂) = s i j₁ * s i j₂)
    (hs_zero_left : ∀ j, s 0 j = 1)
    (hs_add_left : ∀ i₁ i₂ j, s (i₁ + i₂) j = s i₂ j * s i₁ j)
    (e : S → A) (deg : S → ι) (hadj : Algebra.adjoin R (Set.range e) = ⊤)
    (hhom : ∀ t, e t ∈ 𝒜 (deg t))
    (hcomm : ∀ t₁ t₂, e t₁ * e t₂ = s (deg t₁) (deg t₂) • (e t₂ * e t₁))
    {i j : ι} {a b : A} (ha : a ∈ 𝒜 i) (hb : b ∈ 𝒜 j) :
    a * b = s i j • (b * a) :=
  mul_eq_smul_mul_left_of_adjoin_range_eq_top (𝒜 := 𝒜) (c := fun k ↦ s k j) (hs_zero_left j)
    (fun i₁ i₂ ↦ hs_add_left i₁ i₂ j) e deg hadj hhom
    (fun t₁ ↦ mul_eq_smul_mul_right_of_adjoin_range_eq_top (𝒜 := 𝒜) (hs_zero_right (deg t₁))
      (hs_add_right (deg t₁)) e deg hadj hhom (fun t₂ ↦ hcomm t₁ t₂) hb)
    ha

end Generators

section IsHomogeneous

variable {R A M ι V : Type*} [CommSemiring R] [Semiring A] [Algebra R A]
  [DecidableEq ι] [AddMonoid ι] {𝒜 : ι → Submodule R A} [GradedAlgebra 𝒜]
  [Monoid M] [DistribMulAction M A] [IsScalarTower M A A] [SMulCommClass M A A]
  [SMulCommClass R M A] [AddCommMonoid V] [Module R V] {𝒱 : ι → Submodule R V}

/-- If `a : A` satisfies `a * g y = c j • (g y * a)` for every homogeneous generator `y ∈ 𝒱 j`,
where `g : V →ₗ[R] A` is degree-`0` with algebra-generating image, `𝒱` spans `V`, and `c : ι → M`
is multiplicative, then `a * b = c j • (b * a)` for every `b ∈ 𝒜 j`. -/
theorem mul_eq_smul_mul_right_of_adjoin_range_eq_top_of_isHomogeneous {a : A} {c : ι → M}
    (hc0 : c 0 = 1) (hc : ∀ j₁ j₂, c (j₁ + j₂) = c j₁ * c j₂)
    {g : V →ₗ[R] A} (hadj : Algebra.adjoin R (Set.range g) = ⊤) (h𝒱 : ⨆ i, 𝒱 i = ⊤)
    (hg : LinearMap.IsHomogeneous g 𝒱 𝒜 0)
    (hcomm : ∀ {j : ι} {y : V}, y ∈ 𝒱 j → a * g y = c j • (g y * a))
    {j : ι} {b : A} (hb : b ∈ 𝒜 j) :
    a * b = c j • (b * a) :=
  mul_eq_smul_mul_right_of_adjoin_range_eq_top (𝒜 := 𝒜) hc0 hc
    (fun x : (i : ι) × 𝒱 i ↦ g x.2.val) Sigma.fst
    (TauCeti.Algebra.adjoin_range_sigma_eq_top hadj h𝒱)
    (fun x ↦ by simpa only [add_zero] using hg.map_mem x.2.property) (fun x ↦ hcomm x.2.property) hb

/-- If `b : A` satisfies `g x * b = c i • (b * g x)` for every homogeneous generator `x ∈ 𝒱 i`,
where `g : V →ₗ[R] A` is degree-`0` with algebra-generating image, `𝒱` spans `V`, and `c : ι → M`
satisfies `c (i₁ + i₂) = c i₂ * c i₁`, then `a * b = c i • (b * a)` for every `a ∈ 𝒜 i`. -/
theorem mul_eq_smul_mul_left_of_adjoin_range_eq_top_of_isHomogeneous {b : A} {c : ι → M}
    (hc0 : c 0 = 1) (hc : ∀ i₁ i₂, c (i₁ + i₂) = c i₂ * c i₁)
    {g : V →ₗ[R] A} (hadj : Algebra.adjoin R (Set.range g) = ⊤) (h𝒱 : ⨆ i, 𝒱 i = ⊤)
    (hg : LinearMap.IsHomogeneous g 𝒱 𝒜 0)
    (hcomm : ∀ {i : ι} {x : V}, x ∈ 𝒱 i → g x * b = c i • (b * g x))
    {i : ι} {a : A} (ha : a ∈ 𝒜 i) :
    a * b = c i • (b * a) :=
  mul_eq_smul_mul_left_of_adjoin_range_eq_top (𝒜 := 𝒜) hc0 hc
    (fun x : (i : ι) × 𝒱 i ↦ g x.2.val) Sigma.fst
    (TauCeti.Algebra.adjoin_range_sigma_eq_top hadj h𝒱)
    (fun x ↦ by simpa only [add_zero] using hg.map_mem x.2.property) (fun x ↦ hcomm x.2.property) ha

/-- **Graded supercommutativity from a homogeneous linear generator map.** If a degree-`0` linear
map `g : V →ₗ[R] A` has algebra-generating image, `𝒱` spans `V`, and homogeneous generators obey
`g x * g y = s i j • (g y * g x)` for a biadditive commutation factor `s : ι → ι → M`, then
`a * b = s i j • (b * a)` for all `a ∈ 𝒜 i` and `b ∈ 𝒜 j`. -/
theorem mul_eq_smul_mul_of_adjoin_range_eq_top_of_isHomogeneous {s : ι → ι → M}
    (hs_zero_right : ∀ i, s i 0 = 1)
    (hs_add_right : ∀ i j₁ j₂, s i (j₁ + j₂) = s i j₁ * s i j₂)
    (hs_zero_left : ∀ j, s 0 j = 1)
    (hs_add_left : ∀ i₁ i₂ j, s (i₁ + i₂) j = s i₂ j * s i₁ j)
    {g : V →ₗ[R] A} (hadj : Algebra.adjoin R (Set.range g) = ⊤) (h𝒱 : ⨆ i, 𝒱 i = ⊤)
    (hg : LinearMap.IsHomogeneous g 𝒱 𝒜 0)
    (hcomm : ∀ {i j : ι} {x y : V}, x ∈ 𝒱 i → y ∈ 𝒱 j → g x * g y = s i j • (g y * g x))
    {i j : ι} {a b : A} (ha : a ∈ 𝒜 i) (hb : b ∈ 𝒜 j) :
    a * b = s i j • (b * a) :=
  mul_eq_smul_mul_of_adjoin_range_eq_top (𝒜 := 𝒜) hs_zero_right hs_add_right hs_zero_left
    hs_add_left (fun x : (i : ι) × 𝒱 i ↦ g x.2.val) Sigma.fst
    (TauCeti.Algebra.adjoin_range_sigma_eq_top hadj h𝒱)
    (fun x ↦ by simpa only [add_zero] using hg.map_mem x.2.property)
    (fun x y ↦ hcomm x.2.property y.2.property) ha hb

end IsHomogeneous

end TauCeti
