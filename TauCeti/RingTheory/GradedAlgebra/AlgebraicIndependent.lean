module

public import Mathlib.RingTheory.AlgebraicIndependent.Defs
public import Mathlib.RingTheory.GradedAlgebra.Basic
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import TauCeti.RingTheory.GradedAlgebra.HilbertSeries

/-!
# Degrees of homogeneous algebraically independent elements

Let `A = ⨁ₙ 𝒜 n` be an `ℕ`-graded algebra over a commutative ring `R`, and let `g j ∈ 𝒜 (e j)` be
homogeneous elements. A homogeneous element of degree `n` of the subalgebra generated by the `g j`
is a polynomial in those `g j` of degree at most `n` alone
(`TauCeti.GradedAlgebra.mem_adjoin_image_of_mem_adjoin_range`): it is the evaluation of the
weight-`n` component of any polynomial expressing it, and a monomial of weight `n` only involves
variables of weight at most `n`.

Consequently, over a domain, if algebraically independent homogeneous elements `f i ∈ 𝒜 (d i)` lie
in the subalgebra generated by the `g j`, then for every `n` there are at most as many `f i` of
degree at most `n` as there are `g j` of degree at most `n`
(`TauCeti.GradedAlgebra.card_filter_le_le_card_filter_le`): the `f i` of degree at most `n` are
algebraically independent elements of a quotient of the polynomial ring on the `g j` of degree at
most `n`, whose transcendence degree is the number of those `g j`.

The main application compares two polynomial algebras `A ⊆ B` with homogeneous generators: after
sorting, each generator of `B` has degree at most that of the corresponding generator of `A`. For
the invariants `Sym(V*)^G ⊆ Sym(V*)^H` of a finite group and of its subgroup generated by
pseudoreflections, this is the key step in the converse of the Chevalley–Shephard–Todd theorem.

## Main results

* `TauCeti.GradedAlgebra.mem_adjoin_image_of_mem_adjoin_range`: a homogeneous element of degree `n`
  of the subalgebra generated by homogeneous elements `g j` is generated by the `g j` of degree at
  most `n`.
* `TauCeti.GradedAlgebra.card_filter_le_le_card_filter_le`: algebraically independent homogeneous
  elements in the subalgebra generated by homogeneous elements `g j` include, in each degree range
  `≤ n`, at most as many elements as there are `g j` in that range.

## References

* R. P. Stanley, *Invariants of finite groups and their applications to combinatorics*,
  Bull. Amer. Math. Soc. (N.S.) **1** (1979), 475–511, Section 4.
-/

public section

open MvPolynomial

namespace TauCeti.GradedAlgebra

variable {R A κ : Type*} [CommRing R] [CommRing A] [Algebra R A] (𝒜 : ℕ → Submodule R A)
  [GradedAlgebra 𝒜] {g : κ → A} {e : κ → ℕ}

/-- **Homogeneous elements of a subalgebra generated by homogeneous elements.** If `g j ∈ 𝒜 (e j)`,
then every element of degree `n` of the subalgebra generated by the `g j` is generated by the `g j`
of degree at most `n`. -/
theorem mem_adjoin_image_of_mem_adjoin_range (hg : ∀ j, g j ∈ 𝒜 (e j)) {x : A}
    (hx : x ∈ Algebra.adjoin R (Set.range g)) {n : ℕ} (hxn : x ∈ 𝒜 n) :
    x ∈ Algebra.adjoin R (g '' {j | e j ≤ n}) := by
  rw [Algebra.adjoin_range_eq_range_aeval] at hx
  obtain ⟨φ, rfl⟩ := (AlgHom.mem_range _).1 hx
  -- `x` is the evaluation of the weight-`n` component of `φ`, whose variables have weight `≤ n`.
  have hφ : weightedHomogeneousComponent e n φ ∈ supported R {j | e j ≤ n} := by
    classical
    refine mem_supported.2 fun j hj ↦ ?_
    obtain ⟨m, hm, hjm⟩ := (mem_vars_iff_mem_support j).1 hj
    rw [mem_support_iff, coeff_weightedHomogeneousComponent] at hm
    split_ifs at hm with hw
    · exact hw ▸ Finsupp.le_weight_of_ne_zero' e (Finsupp.mem_support_iff.1 hjm)
    · exact absurd rfl hm
  rw [supported_eq_adjoin_X] at hφ
  have hmem : aeval g (weightedHomogeneousComponent e n φ) ∈
      (Algebra.adjoin R (X '' {j | e j ≤ n})).map (aeval g) :=
    Subalgebra.mem_map.2 ⟨_, hφ, rfl⟩
  rw [← Algebra.adjoin_image, ← Set.image_comp] at hmem
  simpa only [AlgHom.coe_toRingHom, Function.comp_def, aeval_X,
    aeval_weightedHomogeneousComponent 𝒜 hg, DirectSum.decompose_of_mem_same 𝒜 hxn] using hmem

/-- **Counting algebraically independent homogeneous elements by degree.** Over a domain, let
`f i ∈ 𝒜 (d i)` be algebraically independent homogeneous elements of the subalgebra generated by
finitely many homogeneous elements `g j ∈ 𝒜 (e j)`. Then for every `n` there are at most as many
`f i` of degree at most `n` as there are `g j` of degree at most `n`. -/
theorem card_filter_le_le_card_filter_le [IsDomain R] {ι : Type*} [Fintype ι] [Fintype κ]
    {f : ι → A} {d : ι → ℕ} (hf : ∀ i, f i ∈ 𝒜 (d i)) (hind : AlgebraicIndependent R f)
    (hg : ∀ j, g j ∈ 𝒜 (e j)) (hfg : ∀ i, f i ∈ Algebra.adjoin R (Set.range g)) (n : ℕ) :
    Finset.card {i | d i ≤ n} ≤ Finset.card {j | e j ≤ n} := by
  -- Each `f i` of degree at most `n` is a polynomial in the `g j` of degree at most `n`.
  have key (i : {i // d i ≤ n}) :
      ∃ q : MvPolynomial {j // e j ≤ n} R, aeval (fun j : {j // e j ≤ n} ↦ g j) q = f i := by
    have := Algebra.adjoin_mono
      (Set.image_mono (Set.ofPred_subset_ofPred.2 fun j hj ↦ hj.trans i.2))
      (mem_adjoin_image_of_mem_adjoin_range 𝒜 hg (hfg i) (hf i))
    rwa [Set.image_eq_range, Algebra.adjoin_range_eq_range_aeval] at this
  choose q hq using key
  -- These polynomials are algebraically independent, so there are at most as many as variables.
  have hqind : AlgebraicIndependent R q :=
    .of_comp (aeval fun j : {j // e j ≤ n} ↦ g j) <| by
      convert hind.comp Subtype.val Subtype.val_injective using 1
      ext i
      exact hq i
  have := hqind.lift_cardinalMk_le_trdeg
  rw [MvPolynomial.trdeg_of_isDomain] at this
  simpa [Fintype.card_subtype] using this

end TauCeti.GradedAlgebra
