module

public import TauCeti.RingTheory.GradedAlgebra.CoeffSubalgebra.Basic
public import TauCeti.RingTheory.Ideal.Operations
public import TauCeti.Algebra.Polynomial.LinearFactor
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# The fibres at units of a filtered coefficient algebra

For an increasing multiplicative family `M` of submodules of an associative algebra `B` and a
unit `a` of the base ring, evaluation at `a` on `coeffSubalgebra M` has kernel generated by
`X - a`. If the filtration is exhaustive, the quotient is therefore `B`, and so is the tensor
base change along evaluation `R[X] → R` at `a`. The algebra `B` need not be commutative.

This is the specialization at a unit of the Rees construction; see J. Dixmier,
*Enveloping Algebras*, for filtered enveloping algebras and their Rees algebras.
-/

public section

open Polynomial
open scoped TensorProduct

namespace TauCeti.coeffSubalgebra

variable {R B : Type*} [CommRing R] [Ring B] [Algebra R B]
variable (M : ℕ → Submodule R B) [SetLike.GradedMonoid M] (h1 : (1 : B) ∈ M 1)

/-- The ideal generated by the central element `X - a` is two-sided. -/
instance span_X_sub_algebraMap_isTwoSided (a : R) :
    (Ideal.span {X M h1 - algebraMap R (coeffSubalgebra M) a}).IsTwoSided := by
  apply Ideal.isTwoSided_span_of_subset_center
  rintro c (rfl : c = X M h1 - algebraMap R _ a)
  exact Semigroup.mem_center_iff.mpr fun b ↦
    ((commute_X M h1 b).sub_left (Algebra.commute_algebraMap_left a b)).symm.eq

/-- The ideal generated by the central element `X - 1` is two-sided. -/
instance span_X_sub_one_isTwoSided : (Ideal.span {X M h1 - 1}).IsTwoSided := by
  simpa using span_X_sub_algebraMap_isTwoSided M h1 1

/-- An element vanishing at a unit `a` is a multiple of `X - a` within the filtered algebra. -/
private theorem exists_mul_X_sub_algebraMap_eq (hM : Monotone M) {a : R} (ha : IsUnit a)
    (p : coeffSubalgebra M) (hp : eval M a p = 0) :
    ∃ q : coeffSubalgebra M, q * (X M h1 - algebraMap R _ a) = p := by
  classical
  let c := algebraMap R B a
  let q := (p : B[X]) /ₘ (Polynomial.X - C c)
  have hrem : (p : B[X]) %ₘ (Polynomial.X - C c) = 0 :=
    modByMonic_X_sub_C_eq_zero (Algebra.commute_algebraMap_left a)
      ((eval_apply M a p).symm.trans hp)
  have hq : (Polynomial.X - C c) * q = (p : B[X]) := by
    have he := modByMonic_add_div (p : B[X]) (Polynomial.X - C c)
    rwa [hrem, zero_add] at he
  -- The coefficient recurrence `a qₙ = qₙ₋₁ - pₙ` keeps every quotient coefficient filtered.
  have hmem : q ∈ coeffSubalgebra M := by
    rw [mem_coeffSubalgebra_iff]
    intro n
    have hp' := mem_coeffSubalgebra_iff.mp p.2
    have hsmul {n : ℕ} {b : B} (hb : a • b ∈ M n) : b ∈ M n := by
      simpa [smul_smul] using Submodule.smul_mem _ ha.unit⁻¹.val hb
    induction n with
    | zero =>
      have hc := congrArg (fun f : B[X] ↦ f.coeff 0) hq
      simp only [sub_mul, coeff_sub, Polynomial.X_mul, coeff_mul_X_zero, coeff_C_mul,
        zero_sub, c, ← Algebra.smul_def] at hc
      exact hsmul (by rw [← neg_neg (a • _), hc]; exact neg_mem (hp' 0))
    | succ n ih =>
      have hc := congrArg (fun f : B[X] ↦ f.coeff (n + 1)) hq
      simp only [sub_mul, coeff_sub, Polynomial.X_mul, coeff_mul_X, coeff_C_mul, c,
        ← Algebra.smul_def] at hc
      exact hsmul (by rw [← sub_sub_cancel (q.coeff n) (a • _), hc]
                      exact sub_mem (hM (Nat.le_succ n) ih) (hp' (n + 1)))
  refine ⟨⟨q, hmem⟩, Subtype.ext ?_⟩
  rw [← hq, Subalgebra.coe_mul, Subalgebra.coe_sub, coe_X, Subalgebra.coe_algebraMap, mul_sub,
    sub_mul, Polynomial.X_mul, ← Algebra.commutes, Polynomial.algebraMap_apply]

/-- Evaluation at a unit `a` has kernel exactly the principal ideal generated by `X - a`. -/
theorem ker_eval (hM : Monotone M) {a : R} (ha : IsUnit a) :
    RingHom.ker (eval M a) = Ideal.span {X M h1 - algebraMap R _ a} := by
  apply le_antisymm
  · intro p hp
    exact Ideal.mem_span_singleton'.mpr (exists_mul_X_sub_algebraMap_eq M h1 hM ha p hp)
  · apply Ideal.span_le.mpr
    rintro p (rfl : p = X M h1 - algebraMap R _ a)
    simp [RingHom.mem_ker]

/-- Evaluation at a unit is surjective when the filtration is exhaustive. -/
theorem eval_surjective (hex : (⨆ n, M n) = ⊤) {a : R} (ha : IsUnit a) :
    Function.Surjective (eval M a) := by
  have hrange : (⨆ n, M n) ≤ LinearMap.range (eval M a).toLinearMap := by
    refine iSup_le fun n b hb ↦
      ⟨monomial M n ((ha.unit⁻¹ ^ n : Rˣ) • b) (Submodule.smul_mem _ _ hb), ?_⟩
    simp [Units.smul_def, Algebra.smul_def, ← map_pow, mul_assoc, ← map_mul, ← mul_pow,
      Algebra.commutes]
  rw [hex, top_le_iff] at hrange
  exact LinearMap.range_eq_top.mp hrange

/-- The quotient of `coeffSubalgebra M` by `X - a`, for a unit `a`, is `B` when the filtration
is exhaustive and increasing. -/
noncomputable def quotientSpanXSubAlgebraMapEquiv (hM : Monotone M) (hex : (⨆ n, M n) = ⊤)
    {a : R} (ha : IsUnit a) :
    (coeffSubalgebra M ⧸ Ideal.span {X M h1 - algebraMap R _ a}) ≃ₐ[R] B :=
  (Ideal.quotientEquivAlgOfEq R (ker_eval M h1 hM ha).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (eval_surjective M hex ha))

/-- The quotient comparison is evaluation at `a` on representatives. -/
@[simp]
theorem quotientSpanXSubAlgebraMapEquiv_mk (hM : Monotone M) (hex : (⨆ n, M n) = ⊤)
    {a : R} (ha : IsUnit a) (p : coeffSubalgebra M) :
    quotientSpanXSubAlgebraMapEquiv M h1 hM hex ha (Ideal.Quotient.mk _ p) = eval M a p := by
  simp [quotientSpanXSubAlgebraMapEquiv]

/-- The inverse quotient comparison sends the value at `a` of a representative to its class. -/
@[simp]
theorem quotientSpanXSubAlgebraMapEquiv_symm_eval (hM : Monotone M) (hex : (⨆ n, M n) = ⊤)
    {a : R} (ha : IsUnit a) (p : coeffSubalgebra M) :
    (quotientSpanXSubAlgebraMapEquiv M h1 hM hex ha).symm (eval M a p) =
      Ideal.Quotient.mk _ p := by
  rw [AlgEquiv.symm_apply_eq, quotientSpanXSubAlgebraMapEquiv_mk]

/-- Evaluation at `a` as a homomorphism of algebras over the parameter ring, where the
parameter acts on `B` by evaluation at `a`. -/
private noncomputable def evalParamAlgHom (a : R) :
    letI := algebra M h1
    letI := Algebra.compHom B (Polynomial.evalRingHom a)
    coeffSubalgebra M →ₐ[R[X]] B :=
  letI := algebra M h1
  letI := Algebra.compHom B (Polynomial.evalRingHom a)
  { __ := (eval M a).toRingHom
    commutes' p := by simp [Algebra.compHom_algebraMap_apply] }

/-- The tensor base-change comparison along evaluation at `a`, before it is shown bijective. -/
private noncomputable def baseChangeEvalAlgHom (a : R) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    (R ⊗[R[X]] coeffSubalgebra M) →ₐ[R] B :=
  letI := algebra M h1
  letI := Algebra.compHom R (Polynomial.evalRingHom a)
  letI := Algebra.compHom B (Polynomial.evalRingHom a)
  letI : IsScalarTower R[X] R B := IsScalarTower.of_algebraMap_eq fun p ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  AlgHom.liftEquiv R[X] R (coeffSubalgebra M) B (evalParamAlgHom M h1 a)

private theorem baseChangeEvalAlgHom_tmul (a r : R) (p : coeffSubalgebra M) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    baseChangeEvalAlgHom M h1 a (r ⊗ₜ[R[X]] p) = r • eval M a p := by
  let := algebra M h1
  let := Algebra.compHom R (Polynomial.evalRingHom a)
  let := Algebra.compHom B (Polynomial.evalRingHom a)
  let : IsScalarTower R[X] R B := IsScalarTower.of_algebraMap_eq fun p ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  exact AlgHom.liftEquiv_tmul (evalParamAlgHom M h1 a) r p

private theorem baseChangeEvalAlgHom_bijective (hM : Monotone M) (hex : (⨆ n, M n) = ⊤)
    {a : R} (ha : IsUnit a) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    Function.Bijective (baseChangeEvalAlgHom M h1 a) := by
  let := algebra M h1
  let := Algebra.compHom R (Polynomial.evalRingHom a)
  let : IsScalarTower R R[X] R := IsScalarTower.of_algebraMap_eq fun r ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  let : IsScalarTower R R[X] (coeffSubalgebra M) := isScalarTower M h1
  let i := (Algebra.TensorProduct.includeRight : coeffSubalgebra M →ₐ[R[X]]
    R ⊗[R[X]] coeffSubalgebra M).restrictScalars R
  have hi : Function.Surjective i :=
    Algebra.TensorProduct.includeRight_surjective _ fun r ↦
      ⟨C r, by simp [Algebra.compHom_algebraMap_apply]⟩
  have hfi (p : coeffSubalgebra M) : baseChangeEvalAlgHom M h1 a (i p) = eval M a p :=
    (baseChangeEvalAlgHom_tmul M h1 a 1 p).trans (one_smul R _)
  have hix : i (X M h1) = algebraMap R _ a := by
    have he := (Algebra.TensorProduct.includeRight : coeffSubalgebra M →ₐ[R[X]]
      R ⊗[R[X]] coeffSubalgebra M).commutes Polynomial.X
    simpa [i, Algebra.compHom_algebraMap_apply, Algebra.TensorProduct.algebraMap_apply] using he
  refine ⟨?_, ?_⟩
  · apply (injective_iff_map_eq_zero _).mpr
    intro x hx
    obtain ⟨p, rfl⟩ := hi x
    obtain ⟨q, hq⟩ := exists_mul_X_sub_algebraMap_eq M h1 hM ha p ((hfi p).symm.trans hx)
    rw [← hq, map_mul, map_sub, hix, AlgHom.commutes, sub_self, mul_zero]
  · intro b
    obtain ⟨p, hp⟩ := eval_surjective M hex ha b
    exact ⟨i p, (hfi p).trans hp⟩

/-- Base change along evaluation `R[X] → R` at a unit `a` recovers `B`.
The parameter action on the left tensor factor is evaluation at `a`. -/
noncomputable def baseChangeEvalEquiv (hM : Monotone M) (hex : (⨆ n, M n) = ⊤)
    {a : R} (ha : IsUnit a) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    (R ⊗[R[X]] coeffSubalgebra M) ≃ₐ[R] B :=
  AlgEquiv.ofBijective _ (baseChangeEvalAlgHom_bijective M h1 hM hex ha)

/-- The base-change comparison sends a pure tensor to scalar multiplication of its value
at `a`. -/
@[simp]
theorem baseChangeEvalEquiv_tmul (hM : Monotone M) (hex : (⨆ n, M n) = ⊤)
    {a : R} (ha : IsUnit a) (r : R) (p : coeffSubalgebra M) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    baseChangeEvalEquiv M h1 hM hex ha (r ⊗ₜ[R[X]] p) = r • eval M a p :=
  baseChangeEvalAlgHom_tmul M h1 a r p

/-- The inverse base-change comparison sends the value at `a` of `p` to `1 ⊗ p`. -/
@[simp]
theorem baseChangeEvalEquiv_symm_eval (hM : Monotone M) (hex : (⨆ n, M n) = ⊤)
    {a : R} (ha : IsUnit a) (p : coeffSubalgebra M) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom a)
    (baseChangeEvalEquiv M h1 hM hex ha).symm (eval M a p) = 1 ⊗ₜ[R[X]] p := by
  let := algebra M h1
  let := Algebra.compHom R (Polynomial.evalRingHom a)
  rw [AlgEquiv.symm_apply_eq, baseChangeEvalEquiv_tmul, one_smul]

end TauCeti.coeffSubalgebra
