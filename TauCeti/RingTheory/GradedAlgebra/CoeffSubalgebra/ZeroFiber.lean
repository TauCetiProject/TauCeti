module

public import TauCeti.RingTheory.GradedAlgebra.CoeffSubalgebra.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# The zero fibre of a filtered coefficient algebra

For a multiplicative family `M` of submodules of an associative algebra `B` with `1 ∈ M 1`,
any surjective `R`-algebra homomorphism `φ : coeffSubalgebra M →ₐ[R] S` whose kernel is generated
by the parameter `X` induces an `R`-algebra isomorphism
`R ⊗[R[X]] coeffSubalgebra M ≃ₐ[R] S` for the base change along evaluation at `0 : R`. The
algebras `B` and `S` need not be commutative.

## Main definitions

* `TauCeti.coeffSubalgebra.baseChangeEvalZeroEquiv`: the `R`-algebra isomorphism
  `(R ⊗[R[X]] coeffSubalgebra M) ≃ₐ[R] S` associated to a surjective homomorphism with kernel
  generated by `X`.

## Main results

* `TauCeti.coeffSubalgebra.baseChangeEvalZeroEquiv_tmul` and
  `TauCeti.coeffSubalgebra.baseChangeEvalZeroEquiv_symm_apply`: the forward and inverse action of
  the zero-fiber comparison.
-/

public section

open Polynomial
open scoped TensorProduct

namespace TauCeti.coeffSubalgebra

variable {R B S : Type*} [CommRing R] [Ring B] [Algebra R B] [Ring S] [Algebra R S]
variable (M : ℕ → Submodule R B) [SetLike.GradedMonoid M] (h1 : (1 : B) ∈ M 1)

/-- Lift a homomorphism `φ : coeffSubalgebra M →ₐ[R] S` annihilating `X` to an `R[X]`-algebra
homomorphism, where `R[X]` acts on `S` by evaluation at `0`. -/
private noncomputable def evalZeroParamAlgHom
    (φ : coeffSubalgebra M →ₐ[R] S) (hX : φ (X M h1) = 0) :
    letI := algebra M h1
    letI := Algebra.compHom S (Polynomial.evalRingHom (0 : R))
    coeffSubalgebra M →ₐ[R[X]] S :=
  letI := algebra M h1
  letI := Algebra.compHom S (Polynomial.evalRingHom (0 : R))
  { __ := φ.toRingHom
    commutes' p := by
      have hcomm : φ.toRingHom.comp (algebraMap R[X] (coeffSubalgebra M)) =
          algebraMap R[X] S := by
        refine Polynomial.ringHom_ext' (RingHom.ext fun r ↦ ?_) ?_
        · let := isScalarTower M h1
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            Algebra.compHom_algebraMap_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C]
          rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply R R[X],
            AlgHom.commutes]
        · simpa [Algebra.compHom_algebraMap_apply, algebraMap_X] using hX
      exact RingHom.congr_fun hcomm p }

/-- The tensor base-change map along evaluation at `0` induced by `φ`, before proving
bijectivity. -/
private noncomputable def baseChangeEvalZeroAlgHom
    (φ : coeffSubalgebra M →ₐ[R] S) (hX : φ (X M h1) = 0) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (R ⊗[R[X]] coeffSubalgebra M) →ₐ[R] S :=
  letI := algebra M h1
  letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  letI := Algebra.compHom S (Polynomial.evalRingHom (0 : R))
  letI : IsScalarTower R[X] R S := IsScalarTower.of_algebraMap_eq fun p ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  AlgHom.liftEquiv R[X] R (coeffSubalgebra M) S (evalZeroParamAlgHom M h1 φ hX)

private theorem baseChangeEvalZeroAlgHom_tmul
    (φ : coeffSubalgebra M →ₐ[R] S) (hX : φ (X M h1) = 0)
    (r : R) (p : coeffSubalgebra M) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    baseChangeEvalZeroAlgHom M h1 φ hX (r ⊗ₜ[R[X]] p) = r • φ p := by
  let := algebra M h1
  let := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  let := Algebra.compHom S (Polynomial.evalRingHom (0 : R))
  let : IsScalarTower R[X] R S := IsScalarTower.of_algebraMap_eq fun p ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  exact AlgHom.liftEquiv_tmul (evalZeroParamAlgHom M h1 φ hX) r p

private theorem baseChangeEvalZeroAlgHom_bijective
    (φ : coeffSubalgebra M →ₐ[R] S) (hsurj : Function.Surjective φ)
    (hker : RingHom.ker φ = Ideal.span {X M h1}) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    letI hX : φ (X M h1) = 0 := RingHom.mem_ker.mp (hker.symm ▸ Ideal.subset_span rfl)
    Function.Bijective (baseChangeEvalZeroAlgHom M h1 φ hX) := by
  let := algebra M h1
  let := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  have hX : φ (X M h1) = 0 := RingHom.mem_ker.mp (hker.symm ▸ Ideal.subset_span rfl)
  let : IsScalarTower R R[X] R := IsScalarTower.of_algebraMap_eq fun r ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  let : IsScalarTower R R[X] (coeffSubalgebra M) := isScalarTower M h1
  let i := (Algebra.TensorProduct.includeRight : coeffSubalgebra M →ₐ[R[X]]
    R ⊗[R[X]] coeffSubalgebra M).restrictScalars R
  have hi : Function.Surjective i :=
    Algebra.TensorProduct.includeRight_surjective _ fun r ↦
      ⟨C r, by simp [Algebra.compHom_algebraMap_apply]⟩
  have hfi (p : coeffSubalgebra M) : baseChangeEvalZeroAlgHom M h1 φ hX (i p) = φ p :=
    (baseChangeEvalZeroAlgHom_tmul M h1 φ hX 1 p).trans (one_smul R _)
  have hiX : i (X M h1) = 0 := by
    have he := (Algebra.TensorProduct.includeRight : coeffSubalgebra M →ₐ[R[X]]
      R ⊗[R[X]] coeffSubalgebra M).commutes Polynomial.X
    simpa [i, Algebra.compHom_algebraMap_apply, Algebra.TensorProduct.algebraMap_apply,
      algebraMap_X] using he
  refine ⟨(injective_iff_map_eq_zero _).mpr fun x hx ↦ ?_, fun s ↦ ?_⟩
  · obtain ⟨p, rfl⟩ := hi x
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp (by rwa [← hker, RingHom.mem_ker, ← hfi])
    rw [← hq, map_mul, hiX, mul_zero]
  · obtain ⟨p, rfl⟩ := hsurj s
    exact ⟨i p, hfi p⟩

/-- Base change along evaluation `R[X] → R` at `0` recovers the quotient of `coeffSubalgebra M`
by `(X)`, whenever `φ : coeffSubalgebra M →ₐ[R] S` is surjective with kernel `(X)`. -/
noncomputable def baseChangeEvalZeroEquiv
    (φ : coeffSubalgebra M →ₐ[R] S) (hsurj : Function.Surjective φ)
    (hker : RingHom.ker φ = Ideal.span {X M h1}) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (R ⊗[R[X]] coeffSubalgebra M) ≃ₐ[R] S :=
  AlgEquiv.ofBijective _ (baseChangeEvalZeroAlgHom_bijective M h1 φ hsurj hker)

/-- The zero-fiber comparison sends a pure tensor `r ⊗ p` to `r • φ p`. -/
@[simp]
theorem baseChangeEvalZeroEquiv_tmul
    (φ : coeffSubalgebra M →ₐ[R] S) (hsurj : Function.Surjective φ)
    (hker : RingHom.ker φ = Ideal.span {X M h1}) (r : R) (p : coeffSubalgebra M) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    baseChangeEvalZeroEquiv M h1 φ hsurj hker (r ⊗ₜ[R[X]] p) = r • φ p :=
  baseChangeEvalZeroAlgHom_tmul M h1 φ
    (RingHom.mem_ker.mp (hker.symm ▸ Ideal.subset_span rfl)) r p

/-- The inverse zero-fiber comparison sends `φ p` to `1 ⊗ p`. -/
@[simp]
theorem baseChangeEvalZeroEquiv_symm_apply
    (φ : coeffSubalgebra M →ₐ[R] S) (hsurj : Function.Surjective φ)
    (hker : RingHom.ker φ = Ideal.span {X M h1}) (p : coeffSubalgebra M) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
    (baseChangeEvalZeroEquiv M h1 φ hsurj hker).symm (φ p) = 1 ⊗ₜ[R[X]] p := by
  let := algebra M h1
  let := Algebra.compHom R (Polynomial.evalRingHom (0 : R))
  rw [AlgEquiv.symm_apply_eq, baseChangeEvalZeroEquiv_tmul, one_smul]

end TauCeti.coeffSubalgebra
