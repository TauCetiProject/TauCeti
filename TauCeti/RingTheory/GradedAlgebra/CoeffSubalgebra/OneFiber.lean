module

public import TauCeti.RingTheory.GradedAlgebra.CoeffSubalgebra.Basic
public import TauCeti.RingTheory.Ideal.Operations
public import Mathlib.Algebra.Polynomial.Div
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# The fibre at one of a filtered coefficient algebra

For an increasing multiplicative family `M` of submodules of an associative algebra `B`,
evaluation at one on `coeffSubalgebra M` has kernel generated by `X - 1`.
If the filtration is exhaustive, the quotient is therefore `B`.
The coefficient algebra need not be commutative. Tensor base change along evaluation at one
also recovers `B`, using Mathlib's `AlgHom.liftEquiv` and
`Algebra.TensorProduct.includeRight_surjective`.

This is the specialization at one of the Rees construction; see J. Dixmier,
*Enveloping Algebras*, for filtered enveloping algebras and their Rees algebras.
-/

public section

open Polynomial
open scoped TensorProduct

namespace TauCeti.coeffSubalgebra

variable {R B : Type*} [CommRing R] [Ring B] [Algebra R B]
variable (M : ℕ → Submodule R B) [SetLike.GradedMonoid M] (h1 : (1 : B) ∈ M 1)

/-- The ideal generated by the central element `X - 1` is two-sided. -/
instance span_X_sub_one_isTwoSided : (Ideal.span {X M h1 - 1}).IsTwoSided := by
  apply Ideal.isTwoSided_span_of_subset_center
  rintro a (rfl : a = X M h1 - 1)
  exact Semigroup.mem_center_iff.mpr fun b ↦ ((commute_X M h1 b).sub_left (.one_left b)).symm.eq

/-- An element vanishing at one is a multiple of `X - 1` within the filtered algebra. -/
private theorem exists_mul_X_sub_one_eq (hM : Monotone M) (p : coeffSubalgebra M)
    (hp : evalOne M p = 0) :
    ∃ q : coeffSubalgebra M, q * (X M h1 - 1) = p := by
  classical
  let q := (p : B[X]) /ₘ (Polynomial.X - 1)
  have hrem : (p : B[X]) %ₘ (Polynomial.X - 1) = 0 := by
    nontriviality B
    have hd := degree_modByMonic_lt (p : B[X]) (monic_X_sub_C (1 : B))
    have hc : (p : B[X]) %ₘ (Polynomial.X - 1) =
        C (((p : B[X]) %ₘ (Polynomial.X - 1)).coeff 0) := by
      apply eq_C_of_degree_le_zero
      rw [degree_X_sub_C] at hd
      simp only [C_1] at hd
      cases he : ((p : B[X]) %ₘ (Polynomial.X - 1)).degree with
      | bot => simp
      | coe n => simp_all
    have he := congrArg (fun f : B[X] ↦ f.eval 1)
      (modByMonic_add_div (p : B[X]) (Polynomial.X - 1))
    rw [hc] at he
    have hp' : (p : B[X]).eval 1 = 0 := (evalOne_apply p).symm.trans hp
    have hz : ((p : B[X]) %ₘ (Polynomial.X - 1)).coeff 0 = 0 := by
      simpa [eval_sub, eval_add, sub_mul, Polynomial.X_mul, eval_mul_X, hp'] using he
    rw [hc, hz, C_0]
  have hq : (Polynomial.X - 1) * q = (p : B[X]) := by
    have he := modByMonic_add_div (p : B[X]) (Polynomial.X - 1)
    rw [hrem, zero_add] at he
    exact he
  -- The coefficient recurrence expresses each quotient coefficient using earlier filtered terms.
  have hmem : q ∈ coeffSubalgebra M := by
    rw [mem_coeffSubalgebra_iff]
    intro n
    induction n with
    | zero =>
      have hc := congrArg (fun f : B[X] ↦ f.coeff 0) hq
      have heq : q.coeff 0 = -(p : B[X]).coeff 0 := by
        simpa [sub_mul] using congrArg Neg.neg hc
      rw [heq]
      exact neg_mem ((mem_coeffSubalgebra_iff.mp p.2) 0)
    | succ n ih =>
      have hc := congrArg (fun f : B[X] ↦ f.coeff (n + 1)) hq
      have heq : q.coeff (n + 1) = q.coeff n - (p : B[X]).coeff (n + 1) := by
        have hc' : q.coeff n - q.coeff (n + 1) = (p : B[X]).coeff (n + 1) := by
          simpa [sub_mul] using hc
        exact eq_sub_iff_add_eq.mpr (by simpa [add_comm] using
          (sub_eq_iff_eq_add.mp hc').symm)
      rw [heq]
      exact sub_mem (hM (Nat.le_succ n) ih) ((mem_coeffSubalgebra_iff.mp p.2) (n + 1))
  refine ⟨⟨q, hmem⟩, Subtype.ext ?_⟩
  simpa [sub_mul, mul_sub, Polynomial.X_mul] using hq

/-- Evaluation at one has kernel exactly the principal ideal generated by `X - 1`. -/
theorem ker_evalOne (hM : Monotone M) :
    RingHom.ker (evalOne M) = Ideal.span {X M h1 - 1} := by
  apply le_antisymm
  · intro p hp
    exact Ideal.mem_span_singleton'.mpr (exists_mul_X_sub_one_eq M h1 hM p hp)
  · apply Ideal.span_le.mpr
    rintro p (rfl : p = X M h1 - 1)
    simp [RingHom.mem_ker]

/-- The fibre at one of an exhaustive increasing filtered algebra is its coefficient algebra. -/
noncomputable def quotientXSubOneEquiv (hM : Monotone M) (hex : (⨆ n, M n) = ⊤) :
    (coeffSubalgebra M ⧸ (Ideal.span {X M h1 - 1})) ≃ₐ[R] B :=
  (Ideal.quotientEquivAlgOfEq R (ker_evalOne M h1 hM).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (evalOne_surjective M hex))

/-- The quotient comparison is evaluation at one on representatives. -/
@[simp]
theorem quotientXSubOneEquiv_mk (hM : Monotone M) (hex : (⨆ n, M n) = ⊤)
    (p : coeffSubalgebra M) :
    quotientXSubOneEquiv M h1 hM hex (Ideal.Quotient.mk _ p) = evalOne M p := by
  simp [quotientXSubOneEquiv]

/-- Base change along evaluation `R[X] → R` at one recovers the coefficient algebra.
The parameter action on the left tensor factor is evaluation at one. -/
noncomputable def baseChangeOneEquiv (hM : Monotone M) (hex : (⨆ n, M n) = ⊤) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom (1 : R))
    (R ⊗[R[X]] coeffSubalgebra M) ≃ₐ[R] B := by
  letI := algebra M h1
  letI := Algebra.compHom R (Polynomial.evalRingHom (1 : R))
  letI := Algebra.compHom B (Polynomial.evalRingHom (1 : R))
  letI : IsScalarTower R R[X] R := IsScalarTower.of_algebraMap_eq fun r ↦ by
    simp [Algebra.compHom_algebraMap_apply]
  letI : IsScalarTower R R[X] (coeffSubalgebra M) := isScalarTower M h1
  letI : IsScalarTower R[X] R B := IsScalarTower.of_algebraMap_eq fun p ↦ rfl
  let e : coeffSubalgebra M →ₐ[R[X]] B :=
    { __ := (evalOne M).toRingHom
      commutes' p := by
        simp [evalOne_eq_eval, eval_algebraMap, Algebra.compHom_algebraMap_apply] }
  let f := AlgHom.liftEquiv R[X] R (coeffSubalgebra M) B e
  let i := (Algebra.TensorProduct.includeRight : coeffSubalgebra M →ₐ[R[X]]
    R ⊗[R[X]] coeffSubalgebra M).restrictScalars R
  have hi : Function.Surjective i :=
    Algebra.TensorProduct.includeRight_surjective _ fun r ↦
      ⟨C r, by simp [Algebra.compHom_algebraMap_apply]⟩
  have hfi (p : coeffSubalgebra M) : f (i p) = evalOne M p := by
    exact AlgHom.liftEquiv_tmul e 1 p |>.trans (one_smul R _)
  have hix : i (X M h1) = 1 := by
    have he := (Algebra.TensorProduct.includeRight : coeffSubalgebra M →ₐ[R[X]]
      R ⊗[R[X]] coeffSubalgebra M).commutes Polynomial.X
    simpa [i, Algebra.compHom_algebraMap_apply, ← Algebra.TensorProduct.one_def] using he
  refine AlgEquiv.ofBijective f ⟨?_, ?_⟩
  · apply (injective_iff_map_eq_zero f).mpr
    intro x hx
    obtain ⟨p, rfl⟩ := hi x
    obtain ⟨q, hq⟩ := exists_mul_X_sub_one_eq M h1 hM p ((hfi p).symm.trans hx)
    rw [← hq, map_mul, map_sub, hix, map_one, sub_self, mul_zero]
  · intro b
    obtain ⟨p, hp⟩ := evalOne_surjective M hex b
    exact ⟨i p, (hfi p).trans hp⟩

/-- The base-change comparison sends a pure tensor to scalar multiplication of its value at one. -/
@[simp]
theorem baseChangeOneEquiv_tmul (hM : Monotone M) (hex : (⨆ n, M n) = ⊤)
    (r : R) (p : coeffSubalgebra M) :
    letI := algebra M h1
    letI := Algebra.compHom R (Polynomial.evalRingHom (1 : R))
    baseChangeOneEquiv M h1 hM hex (r ⊗ₜ[R[X]] p) = r • evalOne M p :=
  (rfl)

end TauCeti.coeffSubalgebra
