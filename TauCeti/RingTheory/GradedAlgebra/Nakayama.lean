module

public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-!
# The graded Nakayama lemma for generators

Let `A = ⨁ₙ Aₙ` be an `ℕ`-graded commutative algebra, with irrelevant ideal `A₊ = ⨁_{n > 0} Aₙ`.
The **graded Nakayama lemma** says that homogeneous elements of positive degree whose classes span
the indecomposables `A₊ ⧸ A₊²` generate `A` as an algebra over its degree-zero part `A₀`. No
finiteness hypothesis is needed: the grading replaces the Jacobson-radical condition of the local
Nakayama lemma.

The proof is an induction on the degree. A homogeneous element `x` of degree `d > 0` is a
combination `∑ cᵢ sᵢ` of the given generators modulo `A₊²`. Keeping only the degree-`d`
components, `x = ∑ (cᵢ)_{d - deg sᵢ} sᵢ + ∑_{0 < i < d} yᵢ zᵢ` with each `yᵢ, zᵢ` homogeneous of
degree smaller than `d`, so `x` is generated by the `sᵢ` and elements of smaller degree.

For example, lifts of a basis of the indecomposables of the Lazard ring generate it, which is the
first half of Lazard's theorem that it is a polynomial ring.

## Main results

* `TauCeti.GradedAlgebra.adjoin_eq_top_of_irrelevant_le_span_sup_sq`: if a set `s` of homogeneous
  elements of positive degree satisfies `A₊ ≤ (s) + A₊²`, then `s` generates `A` over `A₀`.

## References

* J. F. Adams, *Stable Homotopy and Generalised Homology*, Part II, §7 (the use for the
  Lazard ring).
* D. C. Ravenel, *Complex Cobordism and Stable Homotopy Groups of Spheres*, Appendix A2.1.
-/

public section

open DirectSum HomogeneousIdeal

namespace TauCeti.GradedAlgebra

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]

/-- **The graded Nakayama lemma.** In an `ℕ`-graded commutative algebra `A`, a set `s` of
homogeneous elements of positive degree whose ideal, together with the square of the irrelevant
ideal `A₊`, contains `A₊` generates `A` as an algebra over its degree-zero part `A₀`. Equivalently,
homogeneous elements of positive degree whose classes span the indecomposables `A₊ ⧸ A₊²` generate
`A` over `A₀`. -/
theorem adjoin_eq_top_of_irrelevant_le_span_sup_sq {s : Set A}
    (hs : ∀ x ∈ s, ∃ n, 0 < n ∧ x ∈ 𝒜 n)
    (h : (irrelevant 𝒜).toIdeal ≤ Ideal.span s ⊔ (irrelevant 𝒜).toIdeal ^ 2) :
    Algebra.adjoin (𝒜 0) s = ⊤ := by
  classical
  choose! deg hdeg using hs
  set B := Algebra.adjoin (𝒜 0) s
  -- Every homogeneous element lies in `B`, by strong induction on its degree.
  have key (d : ℕ) : ∀ x ∈ 𝒜 d, x ∈ B := by
    induction d using Nat.strong_induction_on with
    | _ d ih =>
    intro x hxd
    rcases Nat.eq_zero_or_pos d with rfl | hd
    · exact Subalgebra.algebraMap_mem B (⟨x, hxd⟩ : 𝒜 0)
    -- The degree-`d` component of an element of `B` of degree smaller than `d`.
    have hlt {m : ℕ} (y : A) (hm : m < d) : (decompose 𝒜 y m : A) ∈ B :=
      ih m hm _ (SetLike.coe_mem _)
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1 (h (mem_irrelevant_of_mem 𝒜 hd hxd))
    rw [← decompose_of_mem_same 𝒜 hxd, ← GradedAlgebra.proj_apply, ← hab, map_add]
    refine B.add_mem ?_ ?_
    · -- The part `∑ cᵢ sᵢ` in the ideal generated by `s`.
      obtain ⟨n, c, g, hcg⟩ := Submodule.mem_span_set'.1 ha
      rw [← hcg, map_sum]
      refine B.sum_mem fun i _ ↦ ?_
      obtain ⟨hpos, hmem⟩ := hdeg _ (g i).2
      rw [GradedAlgebra.proj_apply, smul_eq_mul, coe_decompose_mul_of_right_mem 𝒜 d hmem]
      split_ifs
      · exact B.mul_mem (hlt _ (by omega)) (Algebra.subset_adjoin (g i).2)
      · exact B.zero_mem
    · -- The part in `A₊²`: products of two elements of `A₊`.
      rw [pow_two] at hb
      refine Submodule.mul_induction_on hb (fun y hy z hz ↦ ?_) fun y z hy hz ↦ ?_
      · rw [GradedAlgebra.proj_apply, decompose_mul, coe_mul_apply_eq_sum_antidiagonal]
        refine B.sum_mem fun ij hij ↦ ?_
        rw [Finset.mem_antidiagonal] at hij
        -- Elements of `A₊` have no degree-zero component.
        have hy₀ : (decompose 𝒜 y 0 : A) = 0 := by
          rw [← GradedRing.proj_apply]; exact (mem_irrelevant_iff 𝒜 y).1 hy
        have hz₀ : (decompose 𝒜 z 0 : A) = 0 := by
          rw [← GradedRing.proj_apply]; exact (mem_irrelevant_iff 𝒜 z).1 hz
        rcases Nat.eq_zero_or_pos ij.1 with h₁ | h₁
        · rw [h₁, hy₀, zero_mul]
          exact B.zero_mem
        rcases Nat.eq_zero_or_pos ij.2 with h₂ | h₂
        · rw [h₂, hz₀, mul_zero]
          exact B.zero_mem
        exact B.mul_mem (hlt _ (by omega)) (hlt _ (by omega))
      · rw [map_add]
        exact B.add_mem hy hz
  rw [_root_.eq_top_iff]
  intro x _
  rw [← sum_support_decompose 𝒜 x]
  exact B.sum_mem fun n _ ↦ key n _ (SetLike.coe_mem _)

end TauCeti.GradedAlgebra
