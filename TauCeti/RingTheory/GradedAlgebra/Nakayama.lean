/-!
# The graded Nakayama lemma for generators

Let `A` be a commutative semiring graded by `𝒜 : ℕ → σ`, and let `A₊ = ⨁_{n > 0} 𝒜 n` be its
irrelevant ideal. If a set `s` of homogeneous elements of positive degree generates `A₊` modulo
`A₊²`, that is, if the classes of the elements of `s` generate the indecomposables `A₊ ⧸ A₊²`, then
`s` generates `A` as an algebra over the degree-zero part `𝒜 0`.

The proof is by strong induction on the degree. A homogeneous element `x` of degree `n > 0` is a
combination `∑ rᵢ tᵢ` with each `tᵢ` either an element of `s` or a product `a b` of homogeneous
elements of positive degree. Keeping only the degree-`n` components replaces each coefficient
`rᵢ` by a homogeneous element of degree smaller than `n`, and each product `a b` that contributes
has factors of degree smaller than `n`.

For a connected graded ring, such as the Lazard ring, this reduces generation by a family of
homogeneous elements to a computation of the indecomposables.

## Main results

* `TauCeti.GradedAlgebra.adjoin_eq_top_of_irrelevant_le`: homogeneous elements of positive degree
  generating the irrelevant ideal modulo its square generate the graded ring over its degree-zero
  part.
* `TauCeti.GradedAlgebra.subalgebra_eq_top_of_irrelevant_le`: for a graded `R`-algebra, a
  subalgebra containing the degree-zero part and such generators is everything.
* `TauCeti.GradedAlgebra.adjoin_eq_top_of_irrelevant_le_of_mem_bot`: when the degree-zero part
  consists of scalars, such generators generate the graded algebra as an `R`-algebra.
* `TauCeti.GradedAlgebra.surjective_aeval_of_irrelevant_le`: in that case, evaluation of
  polynomials at such a family of generators is surjective.

## References

* J. F. Adams, *Stable Homotopy and Generalised Homology*, Part II, §7.
-/

public section

open DirectSum Pointwise

namespace TauCeti.GradedAlgebra

section GradedRing

variable {A σ : Type*} [CommSemiring A] [SetLike σ A] [AddSubmonoidClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- **The graded Nakayama lemma for generators.** If a set `s` of homogeneous elements of positive
degree generates the irrelevant ideal `A₊` of an `ℕ`-graded commutative semiring modulo `A₊²`, then
`s` generates the semiring as an algebra over its degree-zero part. -/
theorem adjoin_eq_top_of_irrelevant_le {s : Set A} (hs : ∀ x ∈ s, ∃ i, 0 < i ∧ x ∈ 𝒜 i)
    (h : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
      Ideal.span s ⊔ (HomogeneousIdeal.irrelevant 𝒜).toIdeal ^ 2) :
    Algebra.adjoin (𝒜 0) s = ⊤ := by
  classical
  set S := Algebra.adjoin (𝒜 0) s
  -- The irrelevant ideal and its square are generated by `s` and by the products of homogeneous
  -- elements of positive degree.
  set T : Set A := s ∪ (⋃ i > 0, (𝒜 i : Set A)) * ⋃ i > 0, (𝒜 i : Set A)
  have hspan : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span T := by
    rw [Ideal.span_union, ← Ideal.span_mul_span, ← HomogeneousIdeal.irrelevant_eq_span, ← pow_two]
    exact h
  -- Every homogeneous element of degree `n` lies in `S`, by strong induction on `n`.
  have key (n : ℕ) : ∀ x ∈ 𝒜 n, x ∈ S := by
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro x hx
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · exact Subalgebra.algebraMap_mem S (⟨x, hx⟩ : 𝒜 0)
    -- The degree-`n` component of `r t`, for `t ∈ T`, lies in `S`.
    have hT (r t : A) (ht : t ∈ T) : (decompose 𝒜 (r * t) n : A) ∈ S := by
      obtain ⟨d, hd, htd, htS⟩ : ∃ d, 0 < d ∧ t ∈ 𝒜 d ∧ (d ≤ n → t ∈ S) := by
        rcases ht with ht | ⟨a, ha, b, hb, rfl⟩
        · obtain ⟨d, hd, htd⟩ := hs t ht
          exact ⟨d, hd, htd, fun _ ↦ Algebra.subset_adjoin ht⟩
        · simp only [Set.mem_iUnion, SetLike.mem_coe] at ha hb
          obtain ⟨i, hi, ha⟩ := ha
          obtain ⟨j, hj, hb⟩ := hb
          exact ⟨i + j, by omega, SetLike.mul_mem_graded ha hb, fun hij ↦
            S.mul_mem (ih i (by omega) a ha) (ih j (by omega) b hb)⟩
      rw [coe_decompose_mul_of_right_mem 𝒜 n htd]
      split_ifs with hdn
      · exact S.mul_mem (ih _ (by omega) _ (SetLike.coe_mem _)) (htS hdn)
      · exact S.zero_mem
    obtain ⟨m, c, g, hcg⟩ := Submodule.mem_span_set'.1
      (hspan (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 hn hx))
    rw [← decompose_of_mem_same 𝒜 hx, ← GradedRing.proj_apply, ← hcg, map_sum]
    exact S.sum_mem fun i _ ↦ hT _ _ (g i).2
  refine top_unique fun x _ ↦ ?_
  rw [← sum_support_decompose 𝒜 x]
  exact S.sum_mem fun n _ ↦ key n _ (SetLike.coe_mem _)

end GradedRing

section GradedAlgebra

open HomogeneousIdeal

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]

/-- **Graded Nakayama for algebras.** Let `s` consist of homogeneous elements of positive degree
which generate the irrelevant ideal `A₊` modulo `A₊ ^ 2`. Then every subalgebra containing the
degree-zero part and `s` is the whole algebra. -/
theorem subalgebra_eq_top_of_irrelevant_le (B : Subalgebra R A) (hB : ∀ x ∈ 𝒜 0, x ∈ B)
    {s : Set A} (hsB : s ⊆ B) (hs : ∀ x ∈ s, ∃ n, 0 < n ∧ x ∈ 𝒜 n)
    (h : (irrelevant 𝒜).toIdeal ≤ Ideal.span s ⊔ (irrelevant 𝒜).toIdeal ^ 2) : B = ⊤ := by
  rw [_root_.eq_top_iff]
  rintro x -
  have hx : x ∈ Algebra.adjoin (𝒜 0) s := adjoin_eq_top_of_irrelevant_le 𝒜 hs h ▸ trivial
  induction hx using Algebra.adjoin_induction with
  | mem x hx => exact hsB hx
  | algebraMap r => exact hB _ r.2
  | add x y _ _ hx hy => exact B.add_mem hx hy
  | mul x y _ _ hx hy => exact B.mul_mem hx hy

/-- **Graded Nakayama for connected graded algebras.** If the degree-zero part of `A` consists of
scalars, homogeneous elements of positive degree which generate the irrelevant ideal `A₊` modulo
`A₊ ^ 2` generate `A` as an `R`-algebra. -/
theorem adjoin_eq_top_of_irrelevant_le_of_mem_bot (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra R A))
    {s : Set A} (hs : ∀ x ∈ s, ∃ n, 0 < n ∧ x ∈ 𝒜 n)
    (h : (irrelevant 𝒜).toIdeal ≤ Ideal.span s ⊔ (irrelevant 𝒜).toIdeal ^ 2) :
    Algebra.adjoin R s = ⊤ :=
  subalgebra_eq_top_of_irrelevant_le 𝒜 _ (fun x hx ↦ bot_le (a := Algebra.adjoin R s) (h𝒜 x hx))
    Algebra.subset_adjoin hs h

/-- If the degree-zero part of `A` consists of scalars, evaluation of polynomials at a family of
homogeneous elements of positive degree which generate the irrelevant ideal modulo its square is
surjective. -/
theorem surjective_aeval_of_irrelevant_le (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra R A)) {ι : Type*}
    {f : ι → A} (hf : ∀ i, ∃ n, 0 < n ∧ f i ∈ 𝒜 n)
    (h : (irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range f) ⊔ (irrelevant 𝒜).toIdeal ^ 2) :
    Function.Surjective (MvPolynomial.aeval (R := R) f) := by
  rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
  exact adjoin_eq_top_of_irrelevant_le_of_mem_bot 𝒜 h𝒜 (Set.forall_mem_range.2 hf) h

end GradedAlgebra

end TauCeti.GradedAlgebra
