public import Mathlib.RingTheory.GradedAlgebra.Basic
import TauCeti.RingTheory.GradedAlgebra.Basic

/-!
# Generation in degree one

Let `A = ⨁ₙ Aₙ` be an `ℕ`-graded `R`-algebra generated by `A₀ ∪ A₁`, that is, by `A₁` as an
algebra over `A₀`. Then every homogeneous element of positive degree is a sum of products of
elements of `A₁` alone: since `A₀ · A₁ ⊆ A₁`, a product of elements of `A₀` and of `n ≥ 1`
elements of `A₁` is a product of `n` elements of `A₁`.

This is the algebra behind the surjectivity in positive degrees of the map `Sym_R A₁ → A` for a
graded algebra generated in degree one, whose degree-zero part is only the image of `R`.

If `A` is merely of finite type over `R`, it is generated over `A₀` by finitely many homogeneous
elements of positive degree, and those of degree one span `A₁` over `A₀`. Hence `A₁` is a finite
`R`-module as soon as `A₀` is: the finiteness input for embedding `Proj A` into the projective
space of `A₁`.

## Main statements

* `TauCeti.GradedAlgebra.adjoin_grade_zero_union_grade_one_eq_top_iff`: `A₀ ∪ A₁` generates `A`
  as an `R`-algebra if and only if `A₁` generates `A` as an `A₀`-algebra.
* `TauCeti.GradedAlgebra.mem_closure_grade_one`: if `A₁` generates `A` over `A₀`, then every
  element of `Aₙ` with `n > 0` lies in the subsemiring generated by `A₁`.
* `TauCeti.GradedAlgebra.mem_span_inter_grade_one`: if homogeneous elements `s` of positive degree
  generate `A` over `A₀`, then `A₁` is spanned over `A₀` by the elements of `s` of degree one.
* `TauCeti.GradedAlgebra.finite_grade_one`: if `A` is of finite type over `R` and `A₀` is a finite
  `R`-module, then so is `A₁`.

## References

* [The Stacks Project, Lemma 27.11.3 (01N0)](https://stacks.math.columbia.edu/tag/01N0)
-/

public section

namespace TauCeti.GradedAlgebra

open DirectSum

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]

/-- **Generation in degree one, over `R` or over `A₀`.** `A₀ ∪ A₁` generates `A` as an `R`-algebra
if and only if `A₁` generates `A` as an `A₀`-algebra. -/
theorem adjoin_grade_zero_union_grade_one_eq_top_iff :
    Algebra.adjoin R ((𝒜 0 : Set A) ∪ 𝒜 1) = ⊤ ↔ Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤ := by
  rw [← (Subalgebra.restrictScalars_injective R).eq_iff (a := Algebra.adjoin (𝒜 0) _) (b := ⊤),
    Subalgebra.restrictScalars_top, Algebra.Subalgebra.restrictScalars_adjoin, Algebra.adjoin_union]
  -- The image of `𝒜 0` in `A` is the `R`-subalgebra it generates.
  congr! 2
  refine le_antisymm (Algebra.adjoin_le fun x hx ↦ ⟨⟨x, hx⟩, rfl⟩) ?_
  rintro _ ⟨x, rfl⟩
  exact Algebra.subset_adjoin x.2

/-- For an element `x` of the subalgebra generated by `A₀ ∪ A₁`, the products of the homogeneous
components of `x` of positive degree with elements of `A₀` are sums of products of elements of
degree one. -/
private theorem mul_decompose_mem_closure {x : A}
    (hx : x ∈ Algebra.adjoin R ((𝒜 0 : Set A) ∪ 𝒜 1)) {n : ℕ} (hn : 0 < n) {a : A}
    (ha : a ∈ 𝒜 0) : a * (decompose 𝒜 x n : A) ∈ Subsemiring.closure (𝒜 1 : Set A) := by
  classical
  induction hx using Algebra.adjoin_induction generalizing n a with
  | mem x hx =>
    rcases hx with hx | hx
    · rw [decompose_of_mem_ne 𝒜 hx hn.ne, mul_zero]
      exact zero_mem _
    · by_cases h1 : n = 1
      · subst h1
        rw [decompose_of_mem_same 𝒜 hx]
        exact Subsemiring.subset_closure (by simpa using SetLike.GradedMul.mul_mem ha hx)
      · rw [decompose_of_mem_ne 𝒜 hx (Ne.symm h1), mul_zero]
        exact zero_mem _
  | algebraMap r =>
    rw [decompose_of_mem_ne 𝒜 (SetLike.algebraMap_mem_graded 𝒜 r) hn.ne, mul_zero]
    exact zero_mem _
  | add x y _ _ hx hy =>
    rw [decompose_add, add_apply, Submodule.coe_add, mul_add]
    exact add_mem (hx hn ha) (hy hn ha)
  | mul x y _ _ hx hy =>
    rw [decompose_mul, coe_mul_apply_eq_sum_antidiagonal, Finset.mul_sum]
    refine sum_mem fun ⟨i, j⟩ hij ↦ ?_
    rw [Finset.mem_antidiagonal] at hij
    rcases Nat.eq_zero_or_pos i with rfl | hi
    · rw [← mul_assoc]
      exact hy (by omega) (by simpa using SetLike.GradedMul.mul_mem ha (decompose 𝒜 x 0).2)
    · rcases Nat.eq_zero_or_pos j with rfl | hj
      · rw [mul_comm (decompose 𝒜 x i : A), ← mul_assoc]
        exact hx hi (by simpa using SetLike.GradedMul.mul_mem ha (decompose 𝒜 y 0).2)
      · rw [← mul_assoc]
        exact mul_mem (hx hi ha) (by simpa using hy hj (SetLike.GradedOne.one_mem (A := 𝒜)))

/-- **A graded algebra generated in degree one is generated by `A₁` in positive degrees.** If `A`
is generated over `𝒜 0` by `𝒜 1`, then every homogeneous element of positive degree is a sum of
products of elements of degree one. -/
theorem mem_closure_grade_one {n : ℕ} (hn : 0 < n)
    (htop : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) {x : A} (hx : x ∈ 𝒜 n) :
    x ∈ Subsemiring.closure (𝒜 1 : Set A) := by
  have hx' : x ∈ Algebra.adjoin R ((𝒜 0 : Set A) ∪ 𝒜 1) := by
    rw [(adjoin_grade_zero_union_grade_one_eq_top_iff 𝒜).mpr htop]
    trivial
  simpa [decompose_of_mem_same 𝒜 hx] using
    mul_decompose_mem_closure 𝒜 hx' hn (SetLike.GradedOne.one_mem (A := 𝒜))

/-- A product of homogeneous elements of positive degree is homogeneous; it is `1` if its degree
is zero, and it is one of the factors if its degree is one. -/
private theorem exists_mem_grade_of_mem_closure {s : Set A} (hs : ∀ x ∈ s, ∃ n ≠ 0, x ∈ 𝒜 n) {m : A}
    (hm : m ∈ Submonoid.closure s) : ∃ d, m ∈ 𝒜 d ∧ (d = 0 → m = 1) ∧ (d = 1 → m ∈ s) := by
  induction hm using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨n, hn, hxn⟩ := hs x hx
    exact ⟨n, hxn, fun h ↦ absurd h hn, fun _ ↦ hx⟩
  | one => exact ⟨0, SetLike.GradedOne.one_mem, fun _ ↦ rfl, fun h ↦ absurd h zero_ne_one⟩
  | mul x y _ _ hx hy =>
    obtain ⟨d, hxd, hx0, hx1⟩ := hx
    obtain ⟨e, hye, hy0, hy1⟩ := hy
    refine ⟨d + e, SetLike.GradedMul.mul_mem hxd hye, fun h ↦ ?_, fun h ↦ ?_⟩
    · rw [hx0 (by omega), hy0 (by omega), one_mul]
    · obtain ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ : d = 0 ∧ e = 1 ∨ d = 1 ∧ e = 0 := by omega
      · rw [hx0 rfl, one_mul]
        exact hy1 rfl
      · rw [hy0 rfl, mul_one]
        exact hx1 rfl

/-- If `𝒜 0` and homogeneous elements `s` of positive degree generate `A`, then the elements of `s`
of degree one span `𝒜 1` over `𝒜 0`. -/
theorem mem_span_inter_grade_one {s : Set A} (hs : ∀ x ∈ s, ∃ n ≠ 0, x ∈ 𝒜 n)
    (htop : Algebra.adjoin (𝒜 0) s = ⊤) {x : A} (hx : x ∈ 𝒜 1) :
    x ∈ Submodule.span (𝒜 0) (s ∩ 𝒜 1) := by
  have hx' : x ∈ Submodule.span (𝒜 0) (Submonoid.closure s : Set A) := by
    rw [← Algebra.adjoin_eq_span, htop]
    trivial
  rw [← decompose_of_mem_same 𝒜 hx]
  clear hx
  induction hx' using Submodule.span_induction with
  | mem m hm =>
    obtain ⟨d, hmd, -, hd1⟩ := exists_mem_grade_of_mem_closure 𝒜 hs hm
    by_cases h : d = 1
    · subst h
      rw [decompose_of_mem_same 𝒜 hmd]
      exact Submodule.subset_span ⟨hd1 rfl, hmd⟩
    · rw [decompose_of_mem_ne 𝒜 hmd h]
      exact zero_mem _
  | zero => simp
  | add y z _ _ hy hz =>
    rw [decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact add_mem hy hz
  | smul c y _ hy =>
    rw [Algebra.smul_def, SetLike.GradeZero.algebraMap_apply,
      coe_decompose_mul_of_left_mem_zero 𝒜 c.2]
    exact Submodule.smul_mem _ c hy

/-- The degree-one part of a graded algebra of finite type over `R` whose degree-zero part is
finite over `R` is finite over `R`. -/
theorem finite_grade_one [Algebra.FiniteType R A] [Module.Finite R (𝒜 0)] :
    Module.Finite R (𝒜 1) := by
  obtain ⟨s, hs, hdeg⟩ := exists_finset_adjoin_eq_top_and_mem_grade_ne_zero 𝒜
  have key : (Submodule.span (𝒜 0) ((s : Set A) ∩ 𝒜 1)).restrictScalars R = 𝒜 1 := by
    refine le_antisymm (fun x hx ↦ ?_) fun x hx ↦ mem_span_inter_grade_one 𝒜 hdeg hs hx
    induction hx using Submodule.span_induction with
    | mem y hy => exact hy.2
    | zero => exact zero_mem _
    | add y z _ _ hy hz => exact add_mem hy hz
    | smul c y _ hy =>
      rw [Algebra.smul_def]
      simpa using SetLike.GradedMul.mul_mem c.2 hy
  rw [Module.Finite.iff_fg, ← key]
  exact (Submodule.fg_span (s.finite_toSet.inter_of_left _)).restrictScalars

end TauCeti.GradedAlgebra
