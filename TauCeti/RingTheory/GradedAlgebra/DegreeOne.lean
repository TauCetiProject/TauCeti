module

public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.Data.Finset.NatAntidiagonal
public import Mathlib.RingTheory.GradedAlgebra.Basic
import TauCeti.RingTheory.GradedAlgebra.Basic

/-!
# Generation in degree one

Let `A = ⨁ₙ Aₙ` be an `ℕ`-graded `R`-algebra generated by `A₀ ∪ A₁`, that is, by `A₁` as an
algebra over `A₀`. Then every homogeneous element of positive degree lies in the `R`-subalgebra
generated by `A₁` alone: since `A₀ · A₁ ⊆ A₁`, a product of elements of `A₀` and of `n ≥ 1`
elements of `A₁` is a product of `n` elements of `A₁`.

This is the algebra behind the surjectivity in positive degrees of the map `Sym_R A₁ → A` for a
graded algebra generated in degree one, whose degree-zero part is only the image of `R`.

## Main statements

* `TauCeti.GradedAlgebra.mem_adjoin_grade_one_of_adjoin_grade_zero_union_grade_one_eq_top`: if
  `A₀ ∪ A₁` generates `A` as an `R`-algebra, then `Aₙ ⊆ R[A₁]` for every `n > 0`.
* `TauCeti.GradedAlgebra.adjoin_grade_zero_union_grade_one_eq_top_iff`: `A₀ ∪ A₁` generates `A`
  as an `R`-algebra if and only if `A₁` generates `A` as an `A₀`-algebra.

## References

* [The Stacks Project, Lemma 27.11.3 (01N0)](https://stacks.math.columbia.edu/tag/01N0)
-/

public section

namespace TauCeti.GradedAlgebra

open DirectSum

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]

/-- For an element `x` of the subalgebra generated by `A₀ ∪ A₁`, the products of the homogeneous
components of `x` of positive degree with elements of `A₀` lie in the subalgebra generated by
`A₁`. -/
private theorem mul_decompose_mem_adjoin {x : A}
    (hx : x ∈ Algebra.adjoin R ((𝒜 0 : Set A) ∪ 𝒜 1)) {n : ℕ} (hn : 0 < n) {a : A}
    (ha : a ∈ 𝒜 0) : a * (decompose 𝒜 x n : A) ∈ Algebra.adjoin R (𝒜 1 : Set A) := by
  classical
  induction hx using Algebra.adjoin_induction generalizing n a with
  | mem x hx =>
    rcases hx with hx | hx
    · rw [decompose_of_mem_ne 𝒜 hx hn.ne, mul_zero]
      exact zero_mem _
    · by_cases h1 : n = 1
      · subst h1
        rw [decompose_of_mem_same 𝒜 hx]
        exact Algebra.subset_adjoin (by simpa using SetLike.GradedMul.mul_mem ha hx)
      · rw [decompose_of_mem_ne 𝒜 hx (Ne.symm h1), mul_zero]
        exact zero_mem _
  | algebraMap r =>
    rw [decompose_of_mem_ne 𝒜 (SetLike.algebraMap_mem_graded 𝒜 r) hn.ne, mul_zero]
    exact zero_mem _
  | add x y _ _ hx hy =>
    rw [decompose_add, add_apply, Submodule.coe_add, mul_add]
    exact add_mem (hx hn ha) (hy hn ha)
  | mul x y _ _ hx hy =>
    rw [decompose_mul, coe_mul_apply_eq_sum_antidiagonal, Finset.mul_sum]
    refine sum_mem fun ⟨i, j⟩ hij ↦ ?_
    rw [Finset.mem_antidiagonal] at hij
    rcases Nat.eq_zero_or_pos i with rfl | hi
    · rw [← mul_assoc]
      exact hy (by omega) (by simpa using SetLike.GradedMul.mul_mem ha (decompose 𝒜 x 0).2)
    · rcases Nat.eq_zero_or_pos j with rfl | hj
      · rw [mul_comm (decompose 𝒜 x i : A), ← mul_assoc]
        exact hx hi (by simpa using SetLike.GradedMul.mul_mem ha (decompose 𝒜 y 0).2)
      · rw [← mul_assoc]
        exact mul_mem (hx hi ha) (by simpa using hy hj (SetLike.GradedOne.one_mem (A := 𝒜)))

/-- **A graded algebra generated in degree one is generated by `A₁` in positive degrees.** If
`A₀ ∪ A₁` generates `A` as an `R`-algebra, then every homogeneous element of positive degree lies
in the `R`-subalgebra generated by `A₁`. -/
theorem mem_adjoin_grade_one_of_adjoin_grade_zero_union_grade_one_eq_top
    (h : Algebra.adjoin R ((𝒜 0 : Set A) ∪ 𝒜 1) = ⊤) {n : ℕ} (hn : 0 < n) {x : A}
    (hx : x ∈ 𝒜 n) : x ∈ Algebra.adjoin R (𝒜 1 : Set A) := by
  simpa [decompose_of_mem_same 𝒜 hx] using
    mul_decompose_mem_adjoin 𝒜 (h ▸ Algebra.mem_top : x ∈ _) hn (SetLike.GradedOne.one_mem (A := 𝒜))

/-- **Generation in degree one, over `R` or over `A₀`.** `A₀ ∪ A₁` generates `A` as an `R`-algebra
if and only if `A₁` generates `A` as an `A₀`-algebra. -/
theorem adjoin_grade_zero_union_grade_one_eq_top_iff :
    Algebra.adjoin R ((𝒜 0 : Set A) ∪ 𝒜 1) = ⊤ ↔ Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤ := by
  rw [← (Subalgebra.restrictScalars_injective R).eq_iff (a := Algebra.adjoin (𝒜 0) _) (b := ⊤),
    Subalgebra.restrictScalars_top, Algebra.Subalgebra.restrictScalars_adjoin, Algebra.adjoin_union]
  -- The image of `𝒜 0` in `A` is the `R`-subalgebra it generates.
  congr! 2
  refine le_antisymm (Algebra.adjoin_le fun x hx ↦ ⟨⟨x, hx⟩, rfl⟩) ?_
  rintro _ ⟨x, rfl⟩
  exact Algebra.subset_adjoin x.2

end TauCeti.GradedAlgebra
