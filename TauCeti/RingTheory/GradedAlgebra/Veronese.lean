/-!
# Veronese subrings of finitely generated graded algebras

Let `A = ⨁ₙ 𝒜 n` be an `ℕ`-graded commutative `R`-algebra which is generated over its degree-zero
part `𝒜 0` by finitely many homogeneous elements of positive degree. Then for every sufficiently
divisible `e > 0` the Veronese subring `⨁ₘ 𝒜 (m e)` is generated by its degree-one part `𝒜 e`:

`𝒜 (m e) = (𝒜 e) ^ m` for every `m ≥ 1`,

as `R`-submodules of `A`. Explicitly, if `s` is a finite set of homogeneous generators whose
degrees divide `h`, this holds for every multiple `e` of `h` with `#s · h ≤ e`.

The reason is a pigeonhole count. A monomial in the generators of degree greater than `#s · h`
contains some generator `x` at least `h / deg x` times, so it is divisible by a monomial
`x ^ (h / deg x)` of degree `h`. Hence `𝒜 (h + N) = 𝒜 h · 𝒜 N` once `N ≥ #s · h`, and iterating
splits a component of degree `m e` into `m` components of degree `e`.

If a graded algebra `B` over a ring `B₀` is generated by its degree-one part, then `Proj B` is a
closed subscheme of the projective space `Proj (Sym_{B₀} M)` for any `B₀`-module `M` mapping onto
a set of degree-one generators (`AlgebraicGeometry.Proj.isClosedImmersion_map_gradedLift`). When
`B` is finitely generated over `B₀`, `M` can be taken finite, so this projective space is of
finite type over `Spec B₀`. Passing to a Veronese subring reduces a finitely generated graded
algebra, such as the section ring of a divisor on a curve, to this case.

## Main results

* `TauCeti.GradedAlgebra.grade_add_eq_mul_of_card_mul_le`: `𝒜 (e + N) = 𝒜 e · 𝒜 N` when `h ∣ e`
  and `#s · h ≤ N`.
* `TauCeti.GradedAlgebra.grade_mul_eq_pow_of_card_mul_le`: `𝒜 (m e) = (𝒜 e) ^ m` for `m ≠ 0`, when
  `h ∣ e` and `#s · h ≤ e`.
* `TauCeti.GradedAlgebra.exists_grade_mul_eq_pow`: for a graded algebra of finite type over `𝒜 0`,
  some `e > 0` satisfies `𝒜 (m e') = (𝒜 e') ^ m` for every multiple `e'` of `e` and every
  `m ≠ 0`.

## References

* A. Grothendieck, *Éléments de géométrie algébrique II*, Publ. Math. IHÉS 8 (1961), §2.1.
* N. Bourbaki, *Commutative Algebra*, Chapter III, §1.
-/

public section

open DirectSum

namespace TauCeti.GradedAlgebra

variable {R A : Type*}

section CommSemiring

variable [CommSemiring R] [CommSemiring A] [Algebra R A] {𝒜 : ℕ → Submodule R A}
  {s : Finset A} {deg : A → ℕ} {h : ℕ}

/-- **The pigeonhole step.** Let the elements of `s` have degrees `deg x` dividing `h > 0`. A
monomial `∏ x ^ c x` in the elements of `s` of degree `h + N`, with `N ≥ #s · h`, lies in
`𝒜 h · 𝒜 N`: some `x` occurs with `c x · deg x ≥ h`, so the monomial is divisible by
`x ^ (h / deg x)`, of degree `h`. -/
private theorem prod_pow_mem_grade_mul [SetLike.GradedMonoid 𝒜] (hdeg : ∀ x ∈ s, x ∈ 𝒜 (deg x))
    (hh : 0 < h) (hdvd : ∀ x ∈ s, deg x ∣ h) {N : ℕ} (hN : s.card * h ≤ N) {c : A → ℕ}
    (hc : ∑ x ∈ s, c x • deg x = h + N) : ∏ x ∈ s, x ^ c x ∈ 𝒜 h * 𝒜 N := by
  classical
  -- Some generator `i` occurs at least `h / deg i` times.
  obtain ⟨i, hi, hle⟩ : ∃ i ∈ s, h ≤ c i * deg i := by
    by_contra! hlt
    have : ∑ x ∈ s, c x • deg x ≤ ∑ _x ∈ s, h :=
      Finset.sum_le_sum fun x hx ↦ (hlt x hx).le
    rw [Finset.sum_const, smul_eq_mul] at this
    omega
  obtain ⟨q, hq⟩ := hdvd i hi
  have hdeg_pos : 0 < deg i := Nat.pos_of_ne_zero fun h0 ↦ by simp [h0] at hq; omega
  have hqc : q ≤ c i := by
    rw [hq, mul_comm] at hle
    exact Nat.le_of_mul_le_mul_right hle hdeg_pos
  -- Split off `i ^ q` from the monomial.
  have hprod : ∏ x ∈ s, x ^ c x =
      i ^ q * (i ^ (c i - q) * ∏ x ∈ s.erase i, x ^ c x) := by
    rw [← mul_assoc, ← pow_add, Nat.add_sub_cancel' hqc]
    exact (Finset.mul_prod_erase s (fun x ↦ x ^ c x) hi).symm
  have hsum := hc
  rw [← Finset.add_sum_erase s _ hi, smul_eq_mul] at hsum
  have hsplit : (c i - q) * deg i + q * deg i = c i * deg i := by
    rw [← add_mul, Nat.sub_add_cancel hqc]
  rw [hprod]
  refine Submodule.mul_mem_mul ?_ ?_
  · have := SetLike.pow_mem_graded q (hdeg i hi)
    rwa [smul_eq_mul, mul_comm, ← hq] at this
  · have hrest := SetLike.mul_mem_graded (SetLike.pow_mem_graded (c i - q) (hdeg i hi))
      (SetLike.prod_pow_mem_graded 𝒜 deg (fun x ↦ x) (F := s.erase i) c
        fun x hx ↦ hdeg x (Finset.mem_of_mem_erase hx))
    have hqd : q * deg i = h := by rw [hq, mul_comm]
    convert hrest using 2
    rw [smul_eq_mul]
    omega

variable [GradedAlgebra 𝒜]

/-- The degree-`(h + N)` component of an element of the monoid generated by `s` lies in
`𝒜 h · 𝒜 N`, when `N ≥ #s · h`. -/
private theorem decompose_mem_grade_mul_of_mem_closure (hdeg : ∀ x ∈ s, x ∈ 𝒜 (deg x))
    (hh : 0 < h) (hdvd : ∀ x ∈ s, deg x ∣ h) {N : ℕ} (hN : s.card * h ≤ N) {μ : A}
    (hμ : μ ∈ Submonoid.closure (s : Set A)) : (decompose 𝒜 μ (h + N) : A) ∈ 𝒜 h * 𝒜 N := by
  classical
  obtain ⟨l, hl, rfl⟩ := Submonoid.exists_multiset_of_mem_closure hμ
  rw [Finset.prod_multiset_count_of_subset l s fun x hx ↦ hl x (Multiset.mem_toFinset.mp hx)]
  have hmem := SetLike.prod_pow_mem_graded 𝒜 deg (fun x ↦ x) (fun x ↦ l.count x) hdeg
  by_cases hd : ∑ x ∈ s, l.count x • deg x = h + N
  · rw [decompose_of_mem_same 𝒜 (hd ▸ hmem)]
    exact prod_pow_mem_grade_mul hdeg hh hdvd hN hd
  · rw [decompose_of_mem_ne 𝒜 hmem hd]
    exact zero_mem _

/-- **A step in degree `h`**: if `A` is generated over `𝒜 0` by a finite set `s` of homogeneous
elements whose degrees divide `h > 0`, then `𝒜 (h + N) = 𝒜 h · 𝒜 N` for every `N ≥ #s · h`. -/
private theorem grade_add_eq_mul_of_card_mul_le_of_dvd_self
    (hs : Algebra.adjoin (𝒜 0) (s : Set A) = ⊤) (hdeg : ∀ x ∈ s, x ∈ 𝒜 (deg x)) (hh : 0 < h)
    (hdvd : ∀ x ∈ s, deg x ∣ h) {N : ℕ} (hN : s.card * h ≤ N) :
    𝒜 (h + N) = 𝒜 h * 𝒜 N := by
  refine le_antisymm (fun a ha ↦ ?_) (mul_le_grade_add 𝒜 h N)
  have hspan : a ∈ Subalgebra.toSubmodule (Algebra.adjoin (𝒜 0) (s : Set A)) := by
    simp [hs]
  rw [Algebra.adjoin_eq_span] at hspan
  rw [← decompose_of_mem_same 𝒜 ha]
  clear ha
  induction hspan using Submodule.span_induction with
  | mem μ hμ => exact decompose_mem_grade_mul_of_mem_closure hdeg hh hdvd hN hμ
  | zero => simp
  | add x y _ _ hx hy =>
    rw [decompose_add, add_apply, Submodule.coe_add]
    exact add_mem hx hy
  | smul c x _ hx =>
    -- Multiplication by an element of degree zero preserves `𝒜 h · 𝒜 N`.
    rw [Algebra.smul_def, SetLike.GradeZero.algebraMap_apply,
      coe_decompose_mul_of_left_mem_zero 𝒜 c.2]
    have : (c : A) * _ ∈ 𝒜 0 * (𝒜 h * 𝒜 N) := Submodule.mul_mem_mul c.2 hx
    rw [← mul_assoc] at this
    have hle : 𝒜 0 * 𝒜 h * 𝒜 N ≤ 𝒜 h * 𝒜 N :=
      mul_le_mul' (by simpa using mul_le_grade_add 𝒜 0 h) le_rfl
    exact hle this

/-- **Splitting off a component of degree `e`.** Let `A` be generated over `𝒜 0` by a finite set
`s` of homogeneous elements whose degrees divide `h`. If `h ∣ e` and `N ≥ #s · h`, then
`𝒜 (e + N) = 𝒜 e · 𝒜 N`. -/
theorem grade_add_eq_mul_of_card_mul_le (hs : Algebra.adjoin (𝒜 0) (s : Set A) = ⊤)
    (hdeg : ∀ x ∈ s, x ∈ 𝒜 (deg x)) (hdvd : ∀ x ∈ s, deg x ∣ h) {e N : ℕ}
    (he : h ∣ e) (hN : s.card * h ≤ N) : 𝒜 (e + N) = 𝒜 e * 𝒜 N := by
  refine le_antisymm ?_ (mul_le_grade_add 𝒜 e N)
  obtain ⟨c, rfl⟩ := he
  induction c with
  | zero =>
    intro a ha
    simpa using Submodule.mul_mem_mul (SetLike.one_mem_graded 𝒜) (by simpa using ha)
  | succ c ih =>
    -- If `h = 0` then `e = 0`, and the claim is the base case.
    rcases Nat.eq_zero_or_pos h with rfl | hh
    · simpa using ih
    rw [mul_add_one, add_comm (h * c), add_assoc,
      grade_add_eq_mul_of_card_mul_le_of_dvd_self hs hdeg hh hdvd (hN.trans (Nat.le_add_left _ _))]
    calc 𝒜 h * 𝒜 (h * c + N) ≤ 𝒜 h * (𝒜 (h * c) * 𝒜 N) := mul_le_mul' le_rfl ih
      _ = 𝒜 h * 𝒜 (h * c) * 𝒜 N := (mul_assoc _ _ _).symm
      _ ≤ 𝒜 (h + h * c) * 𝒜 N := mul_le_mul' (mul_le_grade_add 𝒜 h (h * c)) le_rfl

/-- **The Veronese subring in degree `e` is generated in degree one.** Let `A` be generated over
`𝒜 0` by a finite set `s` of homogeneous elements whose degrees divide `h`. If `h ∣ e` and
`#s · h ≤ e`, then `𝒜 (m e) = (𝒜 e) ^ m` for every `m ≠ 0`. -/
theorem grade_mul_eq_pow_of_card_mul_le (hs : Algebra.adjoin (𝒜 0) (s : Set A) = ⊤)
    (hdeg : ∀ x ∈ s, x ∈ 𝒜 (deg x)) (hdvd : ∀ x ∈ s, deg x ∣ h) {e : ℕ}
    (he : h ∣ e) (hse : s.card * h ≤ e) {m : ℕ} (hm : m ≠ 0) : 𝒜 (m * e) = 𝒜 e ^ m := by
  induction m with
  | zero => exact absurd rfl hm
  | succ m ih =>
    rcases eq_or_ne m 0 with rfl | hm0
    · simp
    rw [pow_succ', ← ih hm0, add_one_mul, add_comm,
      grade_add_eq_mul_of_card_mul_le hs hdeg hdvd he
        (hse.trans (Nat.le_mul_of_pos_left e (Nat.pos_of_ne_zero hm0)))]

variable (𝒜) in
/-- **Veronese subrings of a graded algebra of finite type are eventually generated in degree
one** (EGA II, §2.1). If `A` is a finitely generated algebra over `𝒜 0`, then there is
`e > 0` such that for every multiple `e'` of `e`, `𝒜 (m e') = (𝒜 e') ^ m` for all `m ≠ 0`. -/
theorem exists_grade_mul_eq_pow [Algebra.FiniteType (𝒜 0) A] :
    ∃ e, 0 < e ∧ ∀ ⦃e'⦄, e ∣ e' → ∀ ⦃m⦄, m ≠ 0 → 𝒜 (m * e') = 𝒜 e' ^ m := by
  obtain ⟨s, hs, hpos⟩ := exists_finset_adjoin_eq_top_and_mem_grade_ne_zero 𝒜
  choose! deg hdeg0 hdeg using hpos
  set h := ∏ x ∈ s, deg x
  have hh : 0 < h := Nat.pos_of_ne_zero (Finset.prod_ne_zero_iff.mpr hdeg0)
  refine ⟨(s.card + 1) * h, Nat.mul_pos s.card.succ_pos hh, fun e' he' m hm ↦ ?_⟩
  -- The degree-zero component is closed under multiplication and contains one.
  rcases Nat.eq_zero_or_pos e' with rfl | he'0
  · exact grade_mul_eq_pow_of_card_mul_le (h := 0) hs hdeg (fun _ _ ↦ dvd_zero _) dvd_rfl
      (by simp) hm
  refine grade_mul_eq_pow_of_card_mul_le hs hdeg (fun x hx ↦ Finset.dvd_prod_of_mem deg hx)
    ((Dvd.intro_left _ rfl).trans he') ?_ hm
  calc s.card * h ≤ (s.card + 1) * h := Nat.mul_le_mul_right h (Nat.le_succ _)
    _ ≤ e' := Nat.le_of_dvd he'0 he'

end CommSemiring

end TauCeti.GradedAlgebra
