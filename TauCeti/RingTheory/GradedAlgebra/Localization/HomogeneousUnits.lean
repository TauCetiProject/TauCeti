/-!
# Homogeneous units of a localization away from a homogeneous element

Let `A` be a commutative algebra graded by an additive group `ι` through `𝒜`, and let `f ∈ 𝒜 e`.
Localizing away from `f` keeps the grading in every degree (`awayGrading 𝒜 hf`), and inverts `f`,
so the degree `e` becomes the degree of a homogeneous unit. This file computes the degrees of the
homogeneous units of `Localization.Away f`.

In general, every homogeneous unit of `A` remains a homogeneous unit of `A_f`, and every
homogeneous divisor of `f` (in particular `f` itself) becomes a homogeneous unit of its degree.
More generally, a fraction `a / f ^ n` with `a` homogeneous is a unit exactly when `a` divides a
power of `f`, so the degree group is generated by the degrees of the homogeneous divisors of the
powers of `f` (`homogeneousUnitDegrees_awayGrading`). In the boundary cases `f = 0` and `f` a unit,
this gives `⊤` (`homogeneousUnitDegrees_awayGrading_of_eq_zero`) and `homogeneousUnitDegrees 𝒜`
(`homogeneousUnitDegrees_awayGrading_of_isUnit`). When `A` is cancellative and `f` is a product of
homogeneous primes `p j` of degrees `d j`, a homogeneous divisor of a power of `f` is a homogeneous
unit times a product of the `p j`, so the degree group is generated by the degrees of the
homogeneous units of `A` and the `d j` (`homogeneousUnitDegrees_awayGrading_of_eq_prod`); for `f`
itself prime of degree `e`, it is generated by those and `e`
(`homogeneousUnitDegrees_awayGrading_of_prime`).

For `ι = ℤ`, a grading of `A` is a `𝔾_m`-action on `Spec A`, and `Spec A_f` is the invariant open
subscheme `D(f)`; the quotient of `ℤ` by these degrees is the group `ShiftClassGroup` of shifts of
`A_f` up to graded isomorphism. Primality cannot be dropped: in `k[x]` with `x` of degree `1`, the
element `x ^ 2` has degree `2`, but `x = x ^ 3 / x ^ 2` is a unit of degree `1` after inverting it.

## Main results

* `TauCeti.GradedAlgebra.homogeneousUnitDegrees_le_homogeneousUnitDegrees_awayGrading` and
  `TauCeti.GradedAlgebra.mem_homogeneousUnitDegrees_awayGrading_of_dvd`: containment of original
  homogeneous unit degrees and degrees of homogeneous divisors of `f`.
* `TauCeti.GradedAlgebra.awayUnitOfDvd_self_zpow_mem_awayGrading`,
  `TauCeti.GradedAlgebra.awayUnitOfDvd_zpow_mem_awayGrading`, and
  `TauCeti.GradedAlgebra.prod_awayUnitOfDvd_zpow_mem_awayGrading`: degrees of integer powers and
  products of integer powers of inverted homogeneous elements and divisors in `awayGrading 𝒜 hf`.
* `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_eq_zero` and
  `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_isUnit`: boundary cases `f = 0` (`⊤`)
  and `f` a unit (`homogeneousUnitDegrees 𝒜`).
* `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading`: the degrees of the homogeneous
  units of `A_f` are generated by the degrees of the homogeneous divisors of powers of `f`.
* `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_eq_prod`: for `f` a product of
  homogeneous primes in a cancellative ring, they are generated by the homogeneous unit degrees of
  `A` and the degrees of the prime factors.
* `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_prime`: for `f` a homogeneous prime
  of degree `e`, they are generated by the homogeneous unit degrees of `A` and `e`.
-/

public section

namespace TauCeti.GradedAlgebra

section Semiring

variable {ι R A : Type*} [AddCommGroup ι] [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ι → Submodule R A) [SetLike.GradedMonoid 𝒜] {f : A} {e : ι} (hf : f ∈ 𝒜 e)

/-- Every homogeneous unit degree of `𝒜` remains a homogeneous unit degree of
`awayGrading 𝒜 hf`. -/
theorem homogeneousUnitDegrees_le_homogeneousUnitDegrees_awayGrading :
    homogeneousUnitDegrees 𝒜 ≤ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  homogeneousUnitDegrees_le_iff.mpr fun u _ hu ↦
    mem_homogeneousUnitDegrees_of_mem
      (u := Units.map (algebraMap A (Localization.Away f) : A →* _) u)
      (algebraMap_mem_awayGrading hu)

/-- Every homogeneous divisor `g ∈ 𝒜 d` of `f` becomes a homogeneous unit in
`Localization.Away f`, so `d ∈ homogeneousUnitDegrees (awayGrading 𝒜 hf)`. -/
theorem mem_homogeneousUnitDegrees_awayGrading_of_dvd {g : A} {d : ι} (hg : g ∈ 𝒜 d)
    (hdvd : g ∣ f) : d ∈ homogeneousUnitDegrees (awayGrading 𝒜 hf) := by
  have hu : IsUnit (algebraMap A (Localization.Away f) g) :=
    IsLocalization.Away.isUnit_of_dvd (S := Localization.Away f) f hdvd
  exact mem_homogeneousUnitDegrees_of_mem (u := hu.unit)
    (by simpa [IsUnit.unit_spec] using algebraMap_mem_awayGrading (hf := hf) hg)

/-- The degree `e` of `f` itself belongs to `homogeneousUnitDegrees (awayGrading 𝒜 hf)`. -/
theorem mem_homogeneousUnitDegrees_awayGrading_self :
    e ∈ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  mem_homogeneousUnitDegrees_awayGrading_of_dvd 𝒜 hf hf dvd_rfl

/-- All integer multiples of the degree `e` of `f` lie in
`homogeneousUnitDegrees (awayGrading 𝒜 hf)`. -/
theorem zmultiples_le_homogeneousUnitDegrees_awayGrading :
    AddSubgroup.zmultiples e ≤ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  AddSubgroup.zmultiples_le.mpr (mem_homogeneousUnitDegrees_awayGrading_self 𝒜 hf)

/-- Localizing away from `0` collapses `Localization.Away f` to the zero ring, so every degree is
the degree of a homogeneous unit. -/
theorem homogeneousUnitDegrees_awayGrading_of_eq_zero (hf0 : f = 0) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) = ⊤ := by
  have : Subsingleton (Localization.Away f) :=
    IsLocalization.subsingleton (M := Submonoid.powers f) (S := Localization.Away f)
      ⟨1, by simp [hf0]⟩
  exact homogeneousUnitDegrees_eq_top_of_subsingleton

/-- The degrees of the homogeneous units of the localization `A_f` at a homogeneous element `f`
are generated by the degrees of the homogeneous elements of `A` dividing a power of `f`: a fraction
`a / f ^ n` is a unit exactly when `a` divides a power of `f`. -/
theorem homogeneousUnitDegrees_awayGrading :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      AddSubgroup.closure {d | ∃ a ∈ 𝒜 d, ∃ n : ℕ, a ∣ f ^ n} := by
  refine le_antisymm ?_ ?_
  · rw [homogeneousUnitDegrees_le_iff]
    intro u d hu
    obtain ⟨n, a, ha, hu⟩ := mem_awayGrading_iff.mp hu
    -- `u = a / f ^ n` is a unit, so `a` maps to a unit of `A_f`, and hence divides a power of `f`.
    have hunit : IsUnit (algebraMap A (Localization.Away f) a) :=
      TauCeti.Localization.isUnit_mk_iff.mp (hu ▸ u.isUnit)
    obtain ⟨N, hN⟩ := (IsLocalization.Away.algebraMap_isUnit_iff f).mp hunit
    -- `d = (d + n • e) - n • e`, with `a` of degree `d + n • e` and `f` of degree `e`.
    have hmem {c : ι} {b : A} (hb : b ∈ 𝒜 c) {m : ℕ} (hbm : b ∣ f ^ m) :
        c ∈ AddSubgroup.closure {d | ∃ a ∈ 𝒜 d, ∃ n : ℕ, a ∣ f ^ n} :=
      AddSubgroup.subset_closure ⟨b, hb, m, hbm⟩
    simpa using sub_mem (hmem ha hN) (nsmul_mem (hmem hf (m := 1) (by rw [pow_one])) n)
  · rw [AddSubgroup.closure_le]
    rintro d ⟨a, ha, n, hdvd⟩
    have hunit : IsUnit (algebraMap A (Localization.Away f) a) :=
      (IsLocalization.Away.algebraMap_isUnit_iff f).mpr ⟨n, hdvd⟩
    exact mem_homogeneousUnitDegrees_of_mem (u := hunit.unit)
      (by simpa [hunit.unit_spec] using algebraMap_mem_awayGrading (hf := hf) ha)

/-- Localizing away from a homogeneous unit `f` does not enlarge `homogeneousUnitDegrees`. -/
theorem homogeneousUnitDegrees_awayGrading_of_isUnit (hu : IsUnit f) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) = homogeneousUnitDegrees 𝒜 := by
  refine le_antisymm ?_ (homogeneousUnitDegrees_le_homogeneousUnitDegrees_awayGrading 𝒜 hf)
  rw [homogeneousUnitDegrees_awayGrading, AddSubgroup.closure_le]
  rintro d ⟨a, ha, n, hdvd⟩
  have ha_unit : IsUnit a := isUnit_of_dvd_unit hdvd (hu.pow n)
  exact mem_homogeneousUnitDegrees_of_mem (u := ha_unit.unit)
    (by simpa [ha_unit.unit_spec] using ha)

@[simp]
theorem homogeneousUnitDegrees_awayGrading_one (h1 : (1 : A) ∈ 𝒜 (0 : ι)) :
    homogeneousUnitDegrees (awayGrading 𝒜 h1) = homogeneousUnitDegrees 𝒜 :=
  homogeneousUnitDegrees_awayGrading_of_isUnit 𝒜 h1 isUnit_one

/-- An integer power `f ^ m` of `f ∈ 𝒜 e` as a unit of `Localization.Away f` has degree
`m • e`. -/
theorem awayUnitOfDvd_self_zpow_mem_awayGrading (m : ℤ) :
    ((TauCeti.Localization.awayUnitOfDvd (Localization.Away f) (dvd_rfl : f ∣ f) ^ m :
        (Localization.Away f)ˣ) : Localization.Away f) ∈
      awayGrading 𝒜 hf (m • e) :=
  (TauCeti.Localization.awayUnitOfDvd (Localization.Away f)
      (dvd_rfl : f ∣ f)).val_zpow_mem_graded_of_val_inv_mem
    (by simpa using algebraMap_mem_awayGrading (hf := hf) hf)
    (by simpa using invSelf_mem_awayGrading) m

end Semiring

section GradedAlgebra

variable {ι R A : Type*} [AddCommGroup ι] [DecidableEq ι] [CommSemiring R] [CommSemiring A]
  [Algebra R A] (𝒜 : ι → Submodule R A) [GradedAlgebra 𝒜] {f : A} {e : ι} (hf : f ∈ 𝒜 e)

/-- An integer power `g ^ m` of a homogeneous divisor `g ∈ 𝒜 d` of `f` in `Localization.Away f`
has degree `m • d`. -/
theorem awayUnitOfDvd_zpow_mem_awayGrading {g : A} {d : ι} (hg : g ∈ 𝒜 d) (h : g ∣ f) (m : ℤ) :
    ((TauCeti.Localization.awayUnitOfDvd (Localization.Away f) h ^ m :
        (Localization.Away f)ˣ) : Localization.Away f) ∈
      awayGrading 𝒜 hf (m • d) :=
  (TauCeti.Localization.awayUnitOfDvd (Localization.Away f) h).val_zpow_mem_graded
    (by simpa using algebraMap_mem_awayGrading (hf := hf) hg) m

/-- A product of integer powers `∏ j : s, p j ^ m j` of homogeneous divisors `p j ∈ 𝒜 (d j)` of
`f` in `Localization.Away f` has degree `∑ j : s, m j • d j`. -/
theorem prod_awayUnitOfDvd_zpow_mem_awayGrading {J : Type*} (s : Finset J)
    {p : J → A} {d : J → ι} (hp : ∀ j ∈ s, p j ∈ 𝒜 (d j)) (hpf : ∀ j ∈ s, p j ∣ f)
    (m : s → ℤ) :
    ((∏ j : s,
        TauCeti.Localization.awayUnitOfDvd (Localization.Away f) (hpf j j.property) ^ m j :
        (Localization.Away f)ˣ) : Localization.Away f) ∈
      awayGrading 𝒜 hf (∑ j : s, m j • d j) := by
  rw [Units.coe_prod]
  exact SetLike.prod_mem_graded (awayGrading 𝒜 hf) (fun j : s ↦ m j • d j) _ fun j _ ↦
    awayUnitOfDvd_zpow_mem_awayGrading 𝒜 hf (hp j j.property) (hpf j j.property) (m j)

end GradedAlgebra

section Cancel

variable {ι R A : Type*} [AddCommGroup ι] [DecidableEq ι] [CommSemiring R] [CommSemiring A]
  [IsCancelMulZero A] [Algebra R A] (𝒜 : ι → Submodule R A) [GradedAlgebra 𝒜]

/-- Inverting a product `f` of homogeneous primes `p j` of degrees `d j` in a cancellative graded
ring: the degrees of the homogeneous units of `A_f` are generated by those of `A` and the `d j`. -/
theorem homogeneousUnitDegrees_awayGrading_of_eq_prod {f : A} {e : ι} (hf : f ∈ 𝒜 e)
    {J : Type*} (t : Finset J) {p : J → A} {d : J → ι} (hp : ∀ j ∈ t, p j ∈ 𝒜 (d j))
    (hprime : ∀ j ∈ t, Prime (p j)) (hft : f = ∏ j ∈ t, p j) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.closure (d '' t) := by
  rcases subsingleton_or_nontrivial A with hA | hA
  · simp
  rw [homogeneousUnitDegrees_awayGrading]
  refine le_antisymm ?_ (sup_le ?_ ?_)
  · rw [AddSubgroup.closure_le]
    rintro c ⟨a, ha, n, hdvd⟩
    rw [hft] at hdvd
    obtain ⟨m, -, hassoc⟩ := (t.dvd_prod_primes_pow_iff hprime n).mp hdvd
    have hm_mem : ∏ j ∈ t, p j ^ m j ∈ 𝒜 (∑ j ∈ t, m j • d j) :=
      SetLike.prod_pow_mem_graded 𝒜 d p m hp
    have ha0 : a ≠ 0 := hassoc.ne_zero_iff.mpr <|
      Finset.prod_ne_zero_iff.mpr fun j hj ↦ pow_ne_zero (m j) (hprime j hj).ne_zero
    have hsub : (∑ j ∈ t, m j • d j) - c ∈ homogeneousUnitDegrees 𝒜 :=
      sub_mem_homogeneousUnitDegrees_of_associated hm_mem ha ha0 hassoc
    have hsum : ∑ j ∈ t, m j • d j ∈ AddSubgroup.closure (d '' t) :=
      sum_mem fun j hj ↦ nsmul_mem (AddSubgroup.subset_closure (Set.mem_image_of_mem d hj)) (m j)
    simpa using sub_mem (AddSubgroup.mem_sup_right hsum) (AddSubgroup.mem_sup_left hsub)
  · rw [homogeneousUnitDegrees_le_iff]
    exact fun u c hu ↦ AddSubgroup.subset_closure ⟨u, hu, 0, by simp⟩
  · rw [AddSubgroup.closure_le]
    rintro _ ⟨j, hj, rfl⟩
    exact AddSubgroup.subset_closure
      ⟨p j, hp j hj, 1, by simpa [hft] using Finset.dvd_prod_of_mem p hj⟩

/-- Inverting a homogeneous prime `f` of degree `e` in a cancellative graded ring: the degrees of
the homogeneous units of `A_f` are generated by those of `A` and `e`. -/
theorem homogeneousUnitDegrees_awayGrading_of_prime {f : A} {e : ι} (hf : f ∈ 𝒜 e)
    (hprime : Prime f) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e := by
  rw [homogeneousUnitDegrees_awayGrading_of_eq_prod 𝒜 hf {()} (p := fun _ ↦ f) (d := fun _ ↦ e)
    (by simpa using hf) (by simpa using hprime) (by simp), AddSubgroup.zmultiples_eq_closure]
  simp

end Cancel

end TauCeti.GradedAlgebra
