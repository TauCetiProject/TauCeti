/-!
# Homogeneous units of a localization away from a homogeneous element

Let `A` be a commutative algebra graded by an additive group `ι` through `𝒜`, and let `f ∈ 𝒜 e`.
Localizing away from `f` keeps the grading in every degree (`awayGrading 𝒜 hf`), and inverts `f`,
so the degree `e` becomes the degree of a homogeneous unit. This file computes the degrees of the
homogeneous units of `Localization.Away f`.

In general, a fraction `a / f ^ n` with `a` homogeneous is a unit exactly when `a` divides a power
of `f`, so the degree group is generated by the degrees of the homogeneous divisors of the powers
of `f` (`homogeneousUnitDegrees_awayGrading`). In particular, `homogeneousUnitDegrees 𝒜` embeds
into `homogeneousUnitDegrees (awayGrading 𝒜 hf)`, every homogeneous divisor of `f` contributes its
degree, and `awayGrading` at any nonzero power `f ^ k` has the same homogeneous unit degrees as
`awayGrading` at `f` (`homogeneousUnitDegrees_awayGrading_pow`).

When `f` is regular (`IsLeftRegular f`) and associated to a finite product `∏ i ∈ s, p i` of
homogeneous primes `p i ∈ 𝒜 (e i)` (not necessarily distinct), every homogeneous divisor of a power
of `f` is a homogeneous unit times a product of powers of the `p i`, so the degree group is
generated by `homogeneousUnitDegrees 𝒜` and the `e i`
(`homogeneousUnitDegrees_awayGrading_of_associated_prod`). For a regular homogeneous prime `f` of
degree `e`, or any nonzero power `f ^ k` of it, the degree group is
`homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e`
(`homogeneousUnitDegrees_awayGrading_of_prime`, `homogeneousUnitDegrees_awayGrading_of_prime_pow`).

For `ι = ℤ`, a grading of `A` is a `𝔾_m`-action on `Spec A`, and `Spec A_f` is the invariant open
subscheme `D(f)`; the quotient of `ℤ` by these degrees is the group `ShiftClassGroup` of shifts of
`A_f` up to graded isomorphism. Primality cannot be dropped: in `k[x]` with `x` of degree `1`, the
element `x ^ 2` has degree `2`, but `x = x ^ 3 / x ^ 2` is a unit of degree `1` after inverting it.
When `f ∈ 𝒜 e` is a regular prime and `homogeneousUnitDegrees 𝒜 ≤ AddSubgroup.zmultiples e`, the
shift class group is `ZMod e.natAbs` (`TauCeti.shiftClassGroupAwayGradingPrimeEquiv`). Whenever
`PrimeSpectrum.basicOpen f` is preconnected (in particular when `PrimeSpectrum A` is
preirreducible), every compatible `ℤ`-grading of the free rank-one module over `Localization.Away f`
is classified by a unique shift class
(`TauCeti.GradedAlgebra.existsUnique_shiftClass_awayGrading_of_isPreconnected`,
`TauCeti.GradedAlgebra.existsUnique_shiftClass_awayGrading_of_preirreducible`).

## Main definitions

* `TauCeti.shiftClassGroupAwayGradingPrimeEquiv`: identification of
  `ShiftClassGroup (awayGrading 𝒜 hf)` with `ZMod e.natAbs` when `f ∈ 𝒜 e` is a regular prime and
  `homogeneousUnitDegrees 𝒜 ≤ AddSubgroup.zmultiples e`.

## Main results

* `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading`: the degrees of the homogeneous
  units of `A_f` are generated by the degrees of the homogeneous divisors of powers of `f`.
* `TauCeti.GradedAlgebra.homogeneousUnitDegrees_le_awayGrading`,
  `TauCeti.GradedAlgebra.mem_homogeneousUnitDegrees_awayGrading_of_dvd`, and
  `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading_pow`: basic monotonicity and
  power-invariance of `homogeneousUnitDegrees (awayGrading 𝒜 hf)`.
* `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_associated_prod`: for `f` regular
  and associated to a finite product of homogeneous primes, they are generated by the homogeneous
  unit degrees of `A` and the degrees of the prime factors.
* `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_prime` and
  `TauCeti.GradedAlgebra.homogeneousUnitDegrees_awayGrading_of_prime_pow`: the single-prime and
  prime-power cases.
* `TauCeti.GradedAlgebra.existsUnique_shiftClass_awayGrading_of_isPreconnected` and
  `TauCeti.GradedAlgebra.existsUnique_shiftClass_awayGrading_of_preirreducible`: classification of
  compatible rank-one `ℤ`-gradings on `Localization.Away f`.
-/

public section

open DirectSum

namespace TauCeti.GradedAlgebra

section Semiring

variable {ι R A : Type*} [AddCommGroup ι] [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ι → Submodule R A) [SetLike.GradedMonoid 𝒜] {f : A} {e : ι} (hf : f ∈ 𝒜 e)

/-- The degrees of the homogeneous units of the localization `A_f` at a homogeneous element `f`
are generated by the degrees of the homogeneous elements of `A` dividing a power of `f`: a fraction
`a / f ^ n` is a unit exactly when `a` divides a power of `f`. -/
theorem homogeneousUnitDegrees_awayGrading :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      AddSubgroup.closure {d | ∃ a ∈ 𝒜 d, ∃ n : ℕ, a ∣ f ^ n} := by
  refine le_antisymm ?_ ?_
  · rw [homogeneousUnitDegrees_le_iff]
    intro u d hu
    obtain ⟨n, a, ha, hu⟩ := mem_awayGrading_iff.mp hu
    -- `u = a / f ^ n` is a unit, so `a = u * f ^ n` is a unit of `A_f`, and divides a power of `f`.
    have hunit : IsUnit (algebraMap A (Localization.Away f) a) := by
      rw [← IsLocalization.mk'_spec (Localization.Away f) a (Submonoid.pow f n),
        ← Localization.mk_eq_mk', ← hu]
      exact u.isUnit.mul (IsLocalization.map_units _ (Submonoid.pow f n))
    obtain ⟨N, hN⟩ := (IsLocalization.Away.algebraMap_isUnit_iff f).mp hunit
    -- `d = (d + n • e) - n • e`, with `a` of degree `d + n • e` and `f` of degree `e`.
    have hmem {c : ι} {b : A} (hb : b ∈ 𝒜 c) {m : ℕ} (hbm : b ∣ f ^ m) :
        c ∈ AddSubgroup.closure {d | ∃ a ∈ 𝒜 d, ∃ n : ℕ, a ∣ f ^ n} :=
      AddSubgroup.subset_closure ⟨b, hb, m, hbm⟩
    simpa using sub_mem (hmem ha hN) (nsmul_mem (hmem hf (m := 1) (by rw [pow_one])) n)
  · rw [AddSubgroup.closure_le]
    rintro d ⟨a, ha, n, hdvd⟩
    have hunit : IsUnit (algebraMap A (Localization.Away f) a) :=
      (IsLocalization.Away.algebraMap_isUnit_iff f).mpr ⟨n, hdvd⟩
    exact mem_homogeneousUnitDegrees_of_mem (u := hunit.unit) (algebraMap_mem_awayGrading ha)

/-- Homogeneous units of `A` remain homogeneous units of the same degree in `Localization.Away f`.
-/
theorem homogeneousUnitDegrees_le_awayGrading :
    homogeneousUnitDegrees 𝒜 ≤ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  homogeneousUnitDegrees_le_iff.mpr fun u _ hu ↦
    mem_homogeneousUnitDegrees_of_mem (u := Units.map (algebraMap A _).toMonoidHom u)
      (algebraMap_mem_awayGrading hu)

/-- Any homogeneous divisor of `f` becomes a homogeneous unit in `Localization.Away f`, so its
degree lies in `homogeneousUnitDegrees (awayGrading 𝒜 hf)`. -/
theorem mem_homogeneousUnitDegrees_awayGrading_of_dvd {g : A} {d : ι} (hg : g ∈ 𝒜 d)
    (hgdvd : g ∣ f) : d ∈ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  mem_homogeneousUnitDegrees_of_mem (u := (IsLocalization.Away.isUnit_of_dvd f hgdvd).unit)
    (algebraMap_mem_awayGrading hg)

/-- The degree of `f` lies in `homogeneousUnitDegrees (awayGrading 𝒜 hf)`. -/
theorem mem_homogeneousUnitDegrees_awayGrading :
    e ∈ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  mem_homogeneousUnitDegrees_awayGrading_of_dvd 𝒜 hf hf dvd_rfl

/-- Inverting a nonzero power `f ^ k` of a homogeneous element `f ∈ 𝒜 e` yields the same
homogeneous unit degrees as inverting `f`. -/
theorem homogeneousUnitDegrees_awayGrading_pow {k : ℕ} (hk : k ≠ 0) :
    homogeneousUnitDegrees (awayGrading 𝒜 (SetLike.pow_mem_graded k hf)) =
      homogeneousUnitDegrees (awayGrading 𝒜 hf) := by
  rw [homogeneousUnitDegrees_awayGrading, homogeneousUnitDegrees_awayGrading]
  congr 1
  ext d
  refine ⟨fun ⟨a, ha, n, hn⟩ ↦ ⟨a, ha, k * n, by rwa [pow_mul]⟩,
    fun ⟨a, ha, n, hn⟩ ↦ ⟨a, ha, n, hn.trans ?_⟩⟩
  rw [← pow_mul]
  exact pow_dvd_pow f (Nat.le_mul_of_pos_left n (Nat.pos_of_ne_zero hk))

end Semiring

section PrimeProd

variable {ι R A : Type*} [AddCommGroup ι] [DecidableEq ι] [CommSemiring R] [CommSemiring A]
  [Algebra R A] (𝒜 : ι → Submodule R A) [GradedAlgebra 𝒜]

/-- If `f ∈ 𝒜 e₀` is regular and associated to a finite product `∏ i ∈ s, p i` of homogeneous
primes `p i ∈ 𝒜 (e i)` (not necessarily distinct), then the homogeneous unit degrees of
`Localization.Away f` are generated by `homogeneousUnitDegrees 𝒜` together with the `e i` for
`i ∈ s`. -/
theorem homogeneousUnitDegrees_awayGrading_of_associated_prod {β : Type*}
    {s : Finset β} {p : β → A} {e : β → ι} {f : A} {e₀ : ι}
    (hf : f ∈ 𝒜 e₀) (hp : ∀ i ∈ s, Prime (p i)) (hmem : ∀ i ∈ s, p i ∈ 𝒜 (e i))
    (hassoc : Associated f (∏ i ∈ s, p i)) (hreg : IsLeftRegular f) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.closure (e '' (s : Set β)) := by
  refine le_antisymm ?_ (sup_le (homogeneousUnitDegrees_le_awayGrading 𝒜 hf) ?_)
  · rw [homogeneousUnitDegrees_awayGrading, AddSubgroup.closure_le]
    rintro d ⟨a, ha, n, hdvd⟩
    obtain ⟨k, -, u, hu⟩ :=
      TauCeti.exists_associated_finsetProd_pow_of_dvd_pow hp hassoc hreg hdvd
    have hpk_mem : ∏ i ∈ s, p i ^ k i ∈ 𝒜 (∑ i ∈ s, k i • e i) :=
      SetLike.prod_mem_graded 𝒜 (fun i ↦ k i • e i) (fun i ↦ p i ^ k i)
        fun i hi ↦ SetLike.pow_mem_graded (k i) (hmem i hi)
    have hau : (∏ i ∈ s, p i ^ k i) * (u⁻¹ : Aˣ) = a := by
      rw [← hu, mul_assoc, Units.mul_inv, mul_one]
    have hpk_reg : IsLeftRegular (∏ i ∈ s, p i ^ k i) :=
      (hreg.pow n).of_dvd (dvd_trans ⟨(u⁻¹ : Aˣ), hau.symm⟩ hdvd)
    have hu_mem : ((u⁻¹ : Aˣ) : A) ∈ 𝒜 (d - ∑ i ∈ s, k i • e i) := by
      refine mem_of_mul_mem_add_of_isLeftRegular 𝒜 hpk_mem hpk_reg ?_
      rwa [hau, add_sub_cancel]
    have hsum : ∑ i ∈ s, k i • e i ∈ AddSubgroup.closure (e '' (s : Set β)) :=
      sum_mem fun i hi ↦
        nsmul_mem (AddSubgroup.subset_closure (Set.mem_image_of_mem e hi)) (k i)
    rw [← sub_add_cancel d (∑ i ∈ s, k i • e i)]
    exact add_mem (AddSubgroup.mem_sup_left (mem_homogeneousUnitDegrees_of_mem hu_mem))
      (AddSubgroup.mem_sup_right hsum)
  · rw [AddSubgroup.closure_le]
    rintro _ ⟨i, hi, rfl⟩
    exact mem_homogeneousUnitDegrees_awayGrading_of_dvd 𝒜 hf (hmem i hi)
      ((Finset.dvd_prod_of_mem p hi).trans hassoc.symm.dvd)

/-- Inverting a regular homogeneous prime `f ∈ 𝒜 e` adjoins `e` to `homogeneousUnitDegrees 𝒜`. -/
theorem homogeneousUnitDegrees_awayGrading_of_prime {f : A} {e : ι}
    (hf : f ∈ 𝒜 e) (hprime : Prime f) (hreg : IsLeftRegular f) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e := by
  have h := homogeneousUnitDegrees_awayGrading_of_associated_prod 𝒜 hf
    (s := {()}) (p := fun _ ↦ f) (e := fun _ ↦ e)
    (fun _ _ ↦ hprime) (fun _ _ ↦ hf) (by simp) hreg
  simpa [AddSubgroup.zmultiples_eq_closure] using h

/-- Inverting a nonzero power `f ^ k` of a regular homogeneous prime `f ∈ 𝒜 e` still adjoins `e`
(not merely `k • e`) to `homogeneousUnitDegrees 𝒜`, since `f` itself becomes a unit of degree `e`.
-/
theorem homogeneousUnitDegrees_awayGrading_of_prime_pow {f : A} {e : ι} {k : ℕ}
    (hf : f ∈ 𝒜 e) (hprime : Prime f) (hreg : IsLeftRegular f) (hk : k ≠ 0) :
    homogeneousUnitDegrees (awayGrading 𝒜 (SetLike.pow_mem_graded k hf)) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e := by
  rw [homogeneousUnitDegrees_awayGrading_pow 𝒜 hf hk,
    homogeneousUnitDegrees_awayGrading_of_prime 𝒜 hf hprime hreg]

end PrimeProd

section Connected

variable {R A τ : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
  (𝒜 : ℤ → Submodule R A) [GradedAlgebra 𝒜]

/-- Over a `ℤ`-graded ring `A`, whenever `PrimeSpectrum.basicOpen f` is preconnected for a
homogeneous element `f ∈ 𝒜 e`, `PrimeSpectrum (Localization.Away f)` is preconnected, so every
compatible `ℤ`-grading of the free rank-one module over `Localization.Away f` is graded-isomorphic
to a shift `A_f(d)` if and only if `d` represents a unique class in
`TauCeti.ShiftClassGroup (awayGrading 𝒜 hf)`. -/
theorem existsUnique_shiftClass_awayGrading_of_isPreconnected {f : A} {e : ℤ} (hf : f ∈ 𝒜 e)
    [SetLike τ (Localization.Away f)] [AddSubmonoidClass τ (Localization.Away f)]
    (ℳ : ℤ → τ) [Decomposition ℳ] [SetLike.GradedSMul (awayGrading 𝒜 hf) ℳ]
    (hconn : IsPreconnected (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A))) :
    ∃! c : ShiftClassGroup (awayGrading 𝒜 hf),
      ∀ d : ℤ,
        (∃ φ : Localization.Away f ≃ₗ[Localization.Away f] Localization.Away f,
          ∀ n x, φ x ∈ ℳ n ↔ x ∈ awayGrading 𝒜 hf (n + d)) ↔
        (d : ShiftClassGroup (awayGrading 𝒜 hf)) = c := by
  have : PreconnectedSpace (PrimeSpectrum (Localization.Away f)) :=
    (PrimeSpectrum.preconnectedSpace_iff_isPreconnected_basicOpen
      (Localization.Away f) f).mpr hconn
  exact existsUnique_shiftClass_of_connected (awayGrading 𝒜 hf) ℳ

/-- Over a `ℤ`-graded ring `A` with preirreducible prime spectrum, every localization
`Localization.Away f` at a homogeneous element `f ∈ 𝒜 e` has preirreducible (hence preconnected)
prime spectrum, so every compatible `ℤ`-grading of the free rank-one module over
`Localization.Away f` is graded-isomorphic to a shift `A_f(d)` if and only if `d` represents a
unique class in `TauCeti.ShiftClassGroup (awayGrading 𝒜 hf)`. -/
theorem existsUnique_shiftClass_awayGrading_of_preirreducible
    [PreirreducibleSpace (PrimeSpectrum A)] {f : A} {e : ℤ} (hf : f ∈ 𝒜 e)
    [SetLike τ (Localization.Away f)] [AddSubmonoidClass τ (Localization.Away f)]
    (ℳ : ℤ → τ) [Decomposition ℳ] [SetLike.GradedSMul (awayGrading 𝒜 hf) ℳ] :
    ∃! c : ShiftClassGroup (awayGrading 𝒜 hf),
      ∀ d : ℤ,
        (∃ φ : Localization.Away f ≃ₗ[Localization.Away f] Localization.Away f,
          ∀ n x, φ x ∈ ℳ n ↔ x ∈ awayGrading 𝒜 hf (n + d)) ↔
        (d : ShiftClassGroup (awayGrading 𝒜 hf)) = c := by
  have : PreirreducibleSpace (PrimeSpectrum (Localization.Away f)) :=
    (PrimeSpectrum.localization_away_isOpenEmbedding (Localization.Away f) f).preirreducibleSpace
  exact existsUnique_shiftClass_of_connected (awayGrading 𝒜 hf) ℳ

end Connected

end TauCeti.GradedAlgebra

namespace TauCeti

open TauCeti.GradedAlgebra

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ℤ → Submodule R A) [GradedAlgebra 𝒜]

/-- When `f ∈ 𝒜 e` is a regular prime in a `ℤ`-graded algebra `A` whose homogeneous unit degrees
all lie in `AddSubgroup.zmultiples e`, the shift class group of `Localization.Away f` is
`ZMod e.natAbs`. -/
noncomputable def shiftClassGroupAwayGradingPrimeEquiv {f : A} {e : ℤ} (hf : f ∈ 𝒜 e)
    (hprime : Prime f) (hreg : IsLeftRegular f)
    (hle : homogeneousUnitDegrees 𝒜 ≤ AddSubgroup.zmultiples e) :
    ShiftClassGroup (awayGrading 𝒜 hf) ≃+ ZMod e.natAbs :=
  ShiftClassGroup.equivZMod <| by
    rw [homogeneousUnitDegrees_awayGrading_of_prime 𝒜 hf hprime hreg, sup_eq_right.mpr hle]

/-- The identification of `ShiftClassGroup (awayGrading 𝒜 hf)` with `ZMod e.natAbs` sends the
class of a shift `d` to `d mod |e|`. -/
@[simp]
theorem shiftClassGroupAwayGradingPrimeEquiv_mk {f : A} {e : ℤ} (hf : f ∈ 𝒜 e)
    (hprime : Prime f) (hreg : IsLeftRegular f)
    (hle : homogeneousUnitDegrees 𝒜 ≤ AddSubgroup.zmultiples e) (d : ℤ) :
    shiftClassGroupAwayGradingPrimeEquiv 𝒜 hf hprime hreg hle d = d :=
  ShiftClassGroup.equivZMod_mk _ d

end TauCeti
