module

public import Mathlib.Data.ZMod.QuotientGroup
public import TauCeti.RingTheory.GradedAlgebra.Homogeneous.Units
public import TauCeti.RingTheory.GradedAlgebra.Localization.Away
import TauCeti.Algebra.Prime.Finset

/-!
# Homogeneous unit degrees of a graded localization

Let `A` be a commutative `R`-algebra graded by an additive abelian group `ι` through
`𝒜 : ι → Submodule R A`, and let `f ∈ 𝒜 e`. Localizing away from `f` enlarges the subgroup of
homogeneous unit degrees: every homogeneous unit of `A` and every homogeneous divisor of `f`
becomes a homogeneous unit of `Localization.Away f`.

When `A` is a domain and `f = ∏ i ∈ s, p i` is a finite product of homogeneous prime elements of
degrees `e i`, no other homogeneous units appear: every unit of `A_f` is a fraction `a / f ^ n`
whose numerator divides a power of `f`, hence is a unit of `A` times a product of powers of the
`p i`. Extracting the homogeneous degree of that unit factor shows that the homogeneous unit
degrees of `awayGrading 𝒜 hf` are generated by `homogeneousUnitDegrees 𝒜` together with the
degrees `e i`. In particular, for a single homogeneous prime `f ∈ 𝒜 e`, the subgroup is
`homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e`, and when `ι = ℤ` and
`homogeneousUnitDegrees 𝒜 = ⊥`, the shift class group of `Localization.Away f` is `ZMod |e|`.

## Main definitions

* `TauCeti.shiftClassGroupAwayGradingPrimeEquiv`: for a `ℤ`-graded domain with
  `homogeneousUnitDegrees 𝒜 = ⊥` and a homogeneous prime `f ∈ 𝒜 e`, the additive equivalence
  `ShiftClassGroup (awayGrading 𝒜 hf) ≃+ ZMod e.natAbs`.

## Main results

* `TauCeti.homogeneousUnitDegrees_le_awayGrading`: every homogeneous unit degree of `A` stays a
  homogeneous unit degree of `Localization.Away f`.
* `TauCeti.mem_homogeneousUnitDegrees_awayGrading_of_dvd`: the degree of any homogeneous divisor of
  `f` lies in `homogeneousUnitDegrees (awayGrading 𝒜 hf)`.
* `TauCeti.homogeneousUnitDegrees_awayGrading_prod_prime`: in a graded domain, inverting a product
  of homogeneous primes `p i ∈ 𝒜 (e i)` adjoins `e '' s` to `homogeneousUnitDegrees 𝒜`.
* `TauCeti.homogeneousUnitDegrees_awayGrading_prime`: in a graded domain, inverting a single
  homogeneous prime `f ∈ 𝒜 e` adjoins `AddSubgroup.zmultiples e` to `homogeneousUnitDegrees 𝒜`.
-/

public section

namespace TauCeti

open TauCeti.GradedAlgebra

section Semiring

variable {ι R A : Type*} [AddCommGroup ι] [CommSemiring R] [CommSemiring A] [Algebra R A]
  {𝒜 : ι → Submodule R A} [SetLike.GradedMonoid 𝒜] {f : A} {e : ι} (hf : f ∈ 𝒜 e)

/-- The homogeneous unit degrees of `A` are contained in those of `Localization.Away f`. -/
theorem homogeneousUnitDegrees_le_awayGrading :
    homogeneousUnitDegrees 𝒜 ≤ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  homogeneousUnitDegrees_le_iff.mpr fun u _ hu ↦
    mem_homogeneousUnitDegrees_of_mem (u := Units.map (algebraMap A _).toMonoidHom u)
      (algebraMap_mem_awayGrading hu)

/-- The degree of a homogeneous divisor of `f` is a homogeneous unit degree of
`Localization.Away f`. -/
theorem mem_homogeneousUnitDegrees_awayGrading_of_dvd {p : A} {d : ι} (hp : p ∈ 𝒜 d)
    (hdvd : p ∣ f) : d ∈ homogeneousUnitDegrees (awayGrading 𝒜 hf) := by
  have hu : IsUnit (algebraMap A (Localization.Away f) p) :=
    isUnit_of_dvd_unit (map_dvd _ hdvd) (IsLocalization.Away.algebraMap_isUnit f)
  exact mem_homogeneousUnitDegrees_of_mem (u := hu.unit) (algebraMap_mem_awayGrading hp)

/-- The degree of `f` itself is a homogeneous unit degree of `Localization.Away f`. -/
theorem mem_homogeneousUnitDegrees_awayGrading_self :
    e ∈ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  mem_homogeneousUnitDegrees_awayGrading_of_dvd hf hf dvd_rfl

end Semiring

section Domain

variable {ι R A : Type*} [AddCommGroup ι] [DecidableEq ι] [CommSemiring R] [CommSemiring A]
  [IsDomain A] [Algebra R A] (𝒜 : ι → Submodule R A) [GradedAlgebra 𝒜]

/-- Every homogeneous unit of `Localization.Away (∏ i ∈ s, p i)` (with each `p i ∈ 𝒜 (e i)` prime
in a graded domain) has degree in `homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.closure (e '' s)`. -/
private theorem mem_sup_closure_of_mem_awayGrading_prod_prime {κ : Type*} {s : Finset κ}
    {p : κ → A} {e : κ → ι} (hf : (∏ i ∈ s, p i) ∈ 𝒜 (∑ i ∈ s, e i))
    (hp : ∀ i ∈ s, Prime (p i)) (hmem : ∀ i ∈ s, p i ∈ 𝒜 (e i))
    {u : (Localization.Away (∏ i ∈ s, p i))ˣ} {deg : ι}
    (hu : (u : Localization.Away (∏ i ∈ s, p i)) ∈ awayGrading 𝒜 hf deg) :
    deg ∈ homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.closure (e '' s) := by
  obtain ⟨n, a, ha, hua⟩ := mem_awayGrading_iff.mp hu
  -- Clearing the denominator `f ^ n` shows `a` becomes a unit in `A_f`, so `a ∣ f ^ m`.
  have ha_eq : algebraMap A (Localization.Away (∏ i ∈ s, p i)) a =
      (u : Localization.Away (∏ i ∈ s, p i)) * algebraMap A _ ((∏ i ∈ s, p i) ^ n) := by
    have hspec := IsLocalization.mk'_spec (Localization.Away (∏ i ∈ s, p i)) a
      (Submonoid.pow (∏ i ∈ s, p i) n)
    rw [← Localization.mk_eq_mk'_apply, ← hua] at hspec
    exact hspec.symm
  have ha_unit : IsUnit (algebraMap A (Localization.Away (∏ i ∈ s, p i)) a) := by
    rw [ha_eq, map_pow]
    exact u.isUnit.mul ((IsLocalization.Away.algebraMap_isUnit _).pow n)
  obtain ⟨m, hm⟩ := (IsLocalization.Away.algebraMap_isUnit_iff
    (S := Localization.Away (∏ i ∈ s, p i)) (∏ i ∈ s, p i)).mp ha_unit
  rw [← Finset.prod_pow] at hm
  -- Factor `a` as a product of powers of the primes `p i` times a unit `v` of `A`.
  obtain ⟨k, -, v, hv⟩ := (dvd_finsetProd_prime_pow_iff hp (fun _ ↦ m)).mp hm
  set P : A := ∏ i ∈ s, p i ^ k i
  set degP : ι := ∑ i ∈ s, k i • e i
  have hP_mem : P ∈ 𝒜 degP :=
    SetLike.prod_mem_graded 𝒜 (fun i ↦ k i • e i) (fun i ↦ p i ^ k i)
      fun i hi ↦ SetLike.pow_mem_graded (k i) (hmem i hi)
  have hP_ne : P ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun i hi ↦ pow_ne_zero (k i) (hp i hi).ne_zero
  have ha_P : P * ((v⁻¹ : Aˣ) : A) = a := by
    rw [← hv, mul_assoc, Units.mul_inv, mul_one]
  have hv_mem : ((v⁻¹ : Aˣ) : A) ∈ 𝒜 (deg + n • ∑ i ∈ s, e i - degP) :=
    GradedAlgebra.mem_of_mul_mem_add_of_isLeftRegular 𝒜 hP_mem
      (fun _ _ h ↦ mul_left_cancel₀ hP_ne h)
      (by rwa [ha_P, add_sub_cancel])
  have hdeg_v : deg + n • ∑ i ∈ s, e i - degP ∈ homogeneousUnitDegrees 𝒜 :=
    mem_homogeneousUnitDegrees_of_mem hv_mem
  have hdeg_P : degP ∈ AddSubgroup.closure (e '' s) :=
    sum_mem fun i hi ↦ nsmul_mem (AddSubgroup.subset_closure (Set.mem_image_of_mem e hi)) (k i)
  have hdeg_f : n • ∑ i ∈ s, e i ∈ AddSubgroup.closure (e '' s) :=
    nsmul_mem (sum_mem fun i hi ↦ AddSubgroup.subset_closure (Set.mem_image_of_mem e hi)) n
  have hdeg_eq : deg = (deg + n • ∑ i ∈ s, e i - degP) + degP - n • ∑ i ∈ s, e i := by abel
  rw [hdeg_eq]
  exact sub_mem (add_mem (AddSubgroup.mem_sup_left hdeg_v) (AddSubgroup.mem_sup_right hdeg_P))
    (AddSubgroup.mem_sup_right hdeg_f)

/-- **Homogeneous unit degrees of a localization at a product of homogeneous primes.** In a graded
domain, inverting `f = ∏ i ∈ s, p i` with each `p i ∈ 𝒜 (e i)` prime enlarges the subgroup of
homogeneous unit degrees precisely by the subgroup generated by the degrees `e i`. -/
theorem homogeneousUnitDegrees_awayGrading_prod_prime {κ : Type*} {s : Finset κ} {p : κ → A}
    {e : κ → ι} {f : A} {d : ι} (hf : f ∈ 𝒜 d) (hf_eq : f = ∏ i ∈ s, p i)
    (hp : ∀ i ∈ s, Prime (p i)) (hmem : ∀ i ∈ s, p i ∈ 𝒜 (e i)) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.closure (e '' s) := by
  subst hf_eq
  have hf_sum : (∏ i ∈ s, p i) ∈ 𝒜 (∑ i ∈ s, e i) := SetLike.prod_mem_graded 𝒜 e p hmem
  have hf_ne : (∏ i ∈ s, p i) ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i hi ↦ (hp i hi).ne_zero
  -- Since `f ≠ 0` lies in both `𝒜 d` and `𝒜 (∑ i ∈ s, e i)`, the two degrees coincide.
  have hd : d = ∑ i ∈ s, e i := by
    by_contra hne
    have h0 := DirectSum.decompose_of_mem_ne 𝒜 hf_sum (Ne.symm hne)
    rw [DirectSum.decompose_of_mem_same 𝒜 hf] at h0
    exact hf_ne h0
  subst hd
  refine le_antisymm ?_ ?_
  · exact homogeneousUnitDegrees_le_iff.mpr fun _ _ hu ↦
      mem_sup_closure_of_mem_awayGrading_prod_prime 𝒜 hf hp hmem hu
  · refine sup_le (homogeneousUnitDegrees_le_awayGrading hf) ?_
    rw [AddSubgroup.closure_le]
    rintro _ ⟨i, hi, rfl⟩
    exact mem_homogeneousUnitDegrees_awayGrading_of_dvd hf (hmem i hi)
      (Finset.dvd_prod_of_mem p hi)

/-- **Homogeneous unit degrees of a localization at a homogeneous prime.** In a graded domain,
inverting a homogeneous prime `f ∈ 𝒜 e` adjoins the multiples of `e` to
`homogeneousUnitDegrees 𝒜`. -/
theorem homogeneousUnitDegrees_awayGrading_prime {f : A} {e : ι} (hf : f ∈ 𝒜 e) (hp : Prime f) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e := by
  rw [homogeneousUnitDegrees_awayGrading_prod_prime 𝒜 hf (s := {()})
    (p := fun _ : Unit ↦ f) (e := fun _ : Unit ↦ e) (by simp) (by simpa using hp)
    (by simpa using hf)]
  simp [AddSubgroup.zmultiples_eq_closure]

end Domain

section ShiftClassGroup

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [IsDomain A] [Algebra R A]
  (𝒜 : ℤ → Submodule R A) [GradedAlgebra 𝒜]

/-- For a `ℤ`-graded domain whose homogeneous units have degree `0` only, inverting a homogeneous
prime `f ∈ 𝒜 e` gives shift class group `ZMod |e|`. -/
noncomputable def shiftClassGroupAwayGradingPrimeEquiv (h𝒜 : homogeneousUnitDegrees 𝒜 = ⊥)
    {f : A} {e : ℤ} (hf : f ∈ 𝒜 e) (hp : Prime f) :
    ShiftClassGroup (awayGrading 𝒜 hf) ≃+ ZMod e.natAbs :=
  (QuotientAddGroup.quotientAddEquivOfEq
    (by rw [homogeneousUnitDegrees_awayGrading_prime 𝒜 hf hp, h𝒜, bot_sup_eq])).trans
    (Int.quotientZMultiplesEquivZMod e)

/-- The identification of `ShiftClassGroup (awayGrading 𝒜 hf)` with `ZMod |e|` sends the class of
a shift `d` to `d mod |e|`. -/
@[simp]
theorem shiftClassGroupAwayGradingPrimeEquiv_mk (h𝒜 : homogeneousUnitDegrees 𝒜 = ⊥)
    {f : A} {e : ℤ} (hf : f ∈ 𝒜 e) (hp : Prime f) (d : ℤ) :
    shiftClassGroupAwayGradingPrimeEquiv 𝒜 h𝒜 hf hp d = d :=
  (rfl)

end ShiftClassGroup

end TauCeti
