module

public import Mathlib.Data.ZMod.QuotientGroup
public import TauCeti.RingTheory.GradedAlgebra.Homogeneous.Generator
public import TauCeti.RingTheory.GradedAlgebra.Localization.Away
import TauCeti.RingTheory.GradedAlgebra.Homogeneous.Maps
import TauCeti.RingTheory.Localization.Away.Units

/-!
# Homogeneous unit degrees of graded localizations

Let `A` be a commutative `R`-algebra graded by an additive commutative group `ι` via `𝒜`, and
let `f ∈ 𝒜 e`. Under the localization grading `TauCeti.GradedAlgebra.awayGrading 𝒜 hf` on
`Localization.Away f`, every homogeneous unit of `A` remains a homogeneous unit of the same degree,
and every homogeneous divisor of `f` becomes a homogeneous unit.

When `A` is cancellative (`IsCancelMulZero A`) and `f` is associated to a finite product
`∏ i ∈ s, p i` of homogeneous primes `p i ∈ 𝒜 (e i)` (not necessarily distinct), every unit
of `Localization.Away f` is, after clearing a power of `f`, a unit of `A` times a product of powers
of the `p i`. Consequently, the subgroup of homogeneous unit degrees of `Localization.Away f` is
generated by `homogeneousUnitDegrees 𝒜` together with the degrees `e i` for `i ∈ s`.

In particular:
* For a homogeneous prime `f ∈ 𝒜 e`, the homogeneous unit degrees of `Localization.Away f` are
  `homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e`. When `ι = ℤ` and
  `homogeneousUnitDegrees 𝒜 = ⊥`, the shift class group is `ZMod e.natAbs`.
* For a nonzero power `f ^ k` of a homogeneous prime `f ∈ 𝒜 e`, the homogeneous unit degrees
  are still `homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e` (generated by `e`, not
  `k • e`), because `f` itself becomes a unit of degree `e` upon inverting `f ^ k`.
* Over a domain `A`, `PrimeSpectrum (Localization.Away f)` is preconnected (even for `f = 0`), so
  every compatible `ℤ`-grading of the free rank-one module over `Localization.Away f` is
  classified by a unique element of `ShiftClassGroup (awayGrading 𝒜 hf)`.

## Main definitions

* `TauCeti.shiftClassGroupAwayPrimeEquiv`: identification of `ShiftClassGroup (awayGrading 𝒜 hf)`
  with `ZMod e.natAbs` when `f ∈ 𝒜 e` is prime and `homogeneousUnitDegrees 𝒜 = ⊥`.

## Main results

* `TauCeti.homogeneousUnitDegrees_le_awayGrading`: `homogeneousUnitDegrees 𝒜` embeds into
  `homogeneousUnitDegrees (awayGrading 𝒜 hf)`.
* `TauCeti.mem_homogeneousUnitDegrees_awayGrading_of_dvd`: any homogeneous divisor of `f`
  contributes its degree to `homogeneousUnitDegrees (awayGrading 𝒜 hf)`.
* `TauCeti.homogeneousUnitDegrees_awayGrading_of_associated_prod`: homogeneous unit degrees of
  `awayGrading 𝒜 hf` when `f` is associated to a finite product of homogeneous primes.
* `TauCeti.homogeneousUnitDegrees_awayGrading_prime` and
  `TauCeti.homogeneousUnitDegrees_awayGrading_prime_pow`: the single-prime and prime-power cases.
* `TauCeti.GradedAlgebra.existsUnique_shiftClass_awayGrading_of_isDomain`: classification of
  compatible rank-one `ℤ`-gradings on `Localization.Away f` for a domain `A`.
-/

public section

open DirectSum TauCeti.GradedAlgebra

namespace TauCeti

section GradedMonoid

variable {ι R A : Type*} [AddCommGroup ι] [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ι → Submodule R A) [SetLike.GradedMonoid 𝒜] {f : A} {e : ι} (hf : f ∈ 𝒜 e)

/-- Homogeneous units of `A` remain homogeneous units of the same degree in `Localization.Away f`.
-/
theorem homogeneousUnitDegrees_le_awayGrading :
    homogeneousUnitDegrees 𝒜 ≤ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  homogeneousUnitDegrees_le_iff.mpr fun u _ hu ↦
    mem_homogeneousUnitDegrees_of_mem (u := Units.map (algebraMap A _).toMonoidHom u)
      (algebraMap_mem_awayGrading hu)

/-- Any homogeneous divisor of `f` becomes a homogeneous unit in `Localization.Away f`, so its
degree lies in `homogeneousUnitDegrees (awayGrading 𝒜 hf)`. -/
theorem mem_homogeneousUnitDegrees_awayGrading_of_dvd {g : A} {d : ι} (hg : g ∈ 𝒜 d)
    (hgdvd : g ∣ f) : d ∈ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  mem_homogeneousUnitDegrees_of_mem (u := (IsLocalization.Away.isUnit_of_dvd f hgdvd).unit)
    (algebraMap_mem_awayGrading hg)

/-- The degree of `f` lies in `homogeneousUnitDegrees (awayGrading 𝒜 hf)`. -/
theorem mem_homogeneousUnitDegrees_awayGrading :
    e ∈ homogeneousUnitDegrees (awayGrading 𝒜 hf) :=
  mem_homogeneousUnitDegrees_awayGrading_of_dvd 𝒜 hf hf dvd_rfl

end GradedMonoid

section PrimeProd

variable {ι R A : Type*} [AddCommGroup ι] [DecidableEq ι] [CommSemiring R] [CommSemiring A]
  [IsCancelMulZero A] [Algebra R A] (𝒜 : ι → Submodule R A) [GradedAlgebra 𝒜]

/-- If `f ∈ 𝒜 e₀` is associated to a finite product `∏ i ∈ s, p i` of homogeneous primes
`p i ∈ 𝒜 (e i)` (not necessarily distinct), then the homogeneous unit degrees of
`Localization.Away f` are generated by `homogeneousUnitDegrees 𝒜` together with the `e i` for
`i ∈ s`. -/
theorem homogeneousUnitDegrees_awayGrading_of_associated_prod {β : Type*}
    {s : Finset β} {p : β → A} {e : β → ι} {f : A} {e₀ : ι}
    (hf : f ∈ 𝒜 e₀) (hp : ∀ i ∈ s, Prime (p i)) (hmem : ∀ i ∈ s, p i ∈ 𝒜 (e i))
    (hassoc : Associated f (∏ i ∈ s, p i)) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.closure (e '' (s : Set β)) := by
  rcases subsingleton_or_nontrivial A with _ | _
  · have h01 : (0 : Localization.Away f) = 1 := by
      rw [← map_zero (algebraMap A _), ← map_one (algebraMap A _), Subsingleton.elim (0 : A) 1]
    have : Subsingleton (Localization.Away f) := subsingleton_of_zero_eq_one h01
    simp
  · refine le_antisymm ?_ (sup_le (homogeneousUnitDegrees_le_awayGrading 𝒜 hf) ?_)
    · rw [homogeneousUnitDegrees_le_iff]
      intro x d hx
      obtain ⟨u, k, n, hmul⟩ :=
        (IsLocalization.Away.isUnit_iff_exists_mul_pow_eq_finsetProd f hp hassoc).mp x.isUnit
      have hprod_ne : ∏ i ∈ s, p i ≠ 0 :=
        Finset.prod_ne_zero_iff.mpr fun i hi ↦ (hp i hi).ne_zero
      have hf_ne : f ≠ 0 := fun h0 ↦ hprod_ne (by simpa [h0] using hassoc.symm)
      have hinj : Function.Injective (awayGradedAlgHom 𝒜 hf) := by
        rw [coe_awayGradedAlgHom]
        exact IsLocalization.injectiveₛ (Localization.Away f) (M := Submonoid.powers f)
          fun _ ⟨m, hm⟩ ↦ hm ▸ ⟨mul_right_injective₀ (pow_ne_zero m hf_ne),
            mul_left_injective₀ (pow_ne_zero m hf_ne)⟩
      -- Clearing `f ^ n` pulls the homogeneity condition back to `A`.
      have ha_away : awayGradedAlgHom 𝒜 hf (u * ∏ i ∈ s, p i ^ k i) ∈
          awayGrading 𝒜 hf (d + n • e₀) := by
        rw [coe_awayGradedAlgHom, ← hmul]
        exact SetLike.mul_mem_graded hx (algebraMap_mem_awayGrading (SetLike.pow_mem_graded n hf))
      have ha_mem : (u : A) * ∏ i ∈ s, p i ^ k i ∈ 𝒜 (d + n • e₀) :=
        (Graded.map_mem_iff_of_injective (awayGradedAlgHom 𝒜 hf) hinj).mp ha_away
      have hpk_mem : ∏ i ∈ s, p i ^ k i ∈ 𝒜 (∑ i ∈ s, k i • e i) :=
        SetLike.prod_mem_graded 𝒜 (fun i ↦ k i • e i) (fun i ↦ p i ^ k i)
          fun i hi ↦ SetLike.pow_mem_graded (k i) (hmem i hi)
      have hpk_reg : IsLeftRegular (∏ i ∈ s, p i ^ k i) :=
        mul_right_injective₀ (Finset.prod_ne_zero_iff.mpr fun i hi ↦
          pow_ne_zero (k i) (hp i hi).ne_zero)
      have hu_mem : (u : A) ∈ 𝒜 (d + n • e₀ - ∑ i ∈ s, k i • e i) := by
        refine TauCeti.GradedAlgebra.mem_of_mul_mem_add_of_isLeftRegular 𝒜 hpk_mem hpk_reg ?_
        rwa [mul_comm, add_sub_cancel]
      -- The associate unit relating `f` and `∏ i ∈ s, p i` accounts for `∑ e i - e₀`.
      have hprod_mem : ∏ i ∈ s, p i ∈ 𝒜 (∑ i ∈ s, e i) :=
        SetLike.prod_mem_graded 𝒜 e p hmem
      obtain ⟨v, hv⟩ := hassoc
      have hv_mem : (v : A) ∈ 𝒜 (∑ i ∈ s, e i - e₀) := by
        refine TauCeti.GradedAlgebra.mem_of_mul_mem_add_of_isLeftRegular 𝒜 hf
          (mul_right_injective₀ hf_ne) ?_
        rwa [hv, add_sub_cancel]
      have h1 : d + n • e₀ - ∑ i ∈ s, k i • e i ∈ homogeneousUnitDegrees 𝒜 :=
        mem_homogeneousUnitDegrees_of_mem hu_mem
      have h2 : ∑ i ∈ s, e i - e₀ ∈ homogeneousUnitDegrees 𝒜 :=
        mem_homogeneousUnitDegrees_of_mem hv_mem
      have h3 :
          ∑ i ∈ s, ((k i : ℤ) - n) • e i ∈ AddSubgroup.closure (e '' (s : Set β)) :=
        sum_mem fun i hi ↦ zsmul_mem (AddSubgroup.subset_closure (Set.mem_image_of_mem e hi)) _
      have hd_eq :
          d = ((d + n • e₀ - ∑ i ∈ s, k i • e i) + n • (∑ i ∈ s, e i - e₀)) +
            ∑ i ∈ s, ((k i : ℤ) - n) • e i := by
        simp only [sub_smul, natCast_zsmul, Finset.sum_sub_distrib, smul_sub, Finset.smul_sum]
        abel
      rw [hd_eq]
      exact add_mem (AddSubgroup.mem_sup_left (add_mem h1 (nsmul_mem h2 n)))
        (AddSubgroup.mem_sup_right h3)
    · rw [AddSubgroup.closure_le]
      rintro _ ⟨i, hi, rfl⟩
      exact mem_homogeneousUnitDegrees_awayGrading_of_dvd 𝒜 hf (hmem i hi)
        ((Finset.dvd_prod_of_mem p hi).trans hassoc.symm.dvd)

/-- Inverting a homogeneous prime `f ∈ 𝒜 e` adjoins `e` to `homogeneousUnitDegrees 𝒜`. -/
theorem homogeneousUnitDegrees_awayGrading_prime {f : A} {e : ι}
    (hf : f ∈ 𝒜 e) (hprime : Prime f) :
    homogeneousUnitDegrees (awayGrading 𝒜 hf) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e := by
  have h := homogeneousUnitDegrees_awayGrading_of_associated_prod 𝒜 hf
    (s := {()}) (p := fun _ ↦ f) (e := fun _ ↦ e)
    (fun _ _ ↦ hprime) (fun _ _ ↦ hf) (by simp)
  simpa [AddSubgroup.zmultiples_eq_closure] using h

/-- Inverting a nonzero power `f ^ k` of a homogeneous prime `f ∈ 𝒜 e` still adjoins `e` (not
merely `k • e`) to `homogeneousUnitDegrees 𝒜`, since `f` itself becomes a unit of degree `e`.
-/
theorem homogeneousUnitDegrees_awayGrading_prime_pow {f : A} {e : ι} {k : ℕ}
    (hf : f ∈ 𝒜 e) (hprime : Prime f) (hk : k ≠ 0) :
    homogeneousUnitDegrees (awayGrading 𝒜 (SetLike.pow_mem_graded k hf)) =
      homogeneousUnitDegrees 𝒜 ⊔ AddSubgroup.zmultiples e := by
  have hassoc : Associated (f ^ k) (∏ _i ∈ Finset.range k, f) := by simp
  rw [homogeneousUnitDegrees_awayGrading_of_associated_prod 𝒜 (SetLike.pow_mem_graded k hf)
    (s := Finset.range k) (p := fun _ ↦ f) (e := fun _ ↦ e)
    (fun _ _ ↦ hprime) (fun _ _ ↦ hf) hassoc]
  have himg : (fun _ : ℕ ↦ e) '' (Finset.range k : Set ℕ) = {e} :=
    Set.Nonempty.image_const (Finset.coe_nonempty.mpr (Finset.nonempty_range_iff.mpr hk)) e
  rw [himg, AddSubgroup.zmultiples_eq_closure]

end PrimeProd

section ShiftClassGroup

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [IsCancelMulZero A] [Algebra R A]
  (𝒜 : ℤ → Submodule R A) [GradedAlgebra 𝒜]

/-- When a `ℤ`-graded cancellative algebra `A` has only degree-zero homogeneous units and
`f ∈ 𝒜 e` is prime, the shift class group of `Localization.Away f` is `ZMod e.natAbs`. -/
noncomputable def shiftClassGroupAwayPrimeEquiv (hbot : homogeneousUnitDegrees 𝒜 = ⊥)
    {f : A} {e : ℤ} (hf : f ∈ 𝒜 e) (hprime : Prime f) :
    ShiftClassGroup (awayGrading 𝒜 hf) ≃+ ZMod e.natAbs :=
  (QuotientAddGroup.quotientAddEquivOfEq (by
    rw [homogeneousUnitDegrees_awayGrading_prime 𝒜 hf hprime, hbot, bot_sup_eq])).trans
    (Int.quotientZMultiplesEquivZMod e)

/-- The identification of `ShiftClassGroup (awayGrading 𝒜 hf)` with `ZMod e.natAbs` sends the
class of a shift `d` to `d mod |e|`. -/
@[simp]
theorem shiftClassGroupAwayPrimeEquiv_mk (hbot : homogeneousUnitDegrees 𝒜 = ⊥)
    {f : A} {e : ℤ} (hf : f ∈ 𝒜 e) (hprime : Prime f) (d : ℤ) :
    shiftClassGroupAwayPrimeEquiv 𝒜 hbot hf hprime d = d := by
  rfl

end ShiftClassGroup

end TauCeti

namespace TauCeti.GradedAlgebra

variable {R A τ : Type*} [CommSemiring R] [CommRing A] [IsDomain A] [Algebra R A]
  (𝒜 : ℤ → Submodule R A) [GradedAlgebra 𝒜]

/-- Over a `ℤ`-graded domain `A`, every localization `Localization.Away f` at a homogeneous
element `f ∈ 𝒜 e` has preconnected prime spectrum (including `f = 0`), so every compatible
`ℤ`-grading of the free rank-one module over `Localization.Away f` is graded-isomorphic to a
shift `A_f(d)` if and only if `d` represents a unique class in
`TauCeti.ShiftClassGroup (awayGrading 𝒜 hf)`. -/
theorem existsUnique_shiftClass_awayGrading_of_isDomain {f : A} {e : ℤ} (hf : f ∈ 𝒜 e)
    [SetLike τ (Localization.Away f)] [AddSubmonoidClass τ (Localization.Away f)]
    (ℳ : ℤ → τ) [Decomposition ℳ] [SetLike.GradedSMul (awayGrading 𝒜 hf) ℳ] :
    ∃! c : ShiftClassGroup (awayGrading 𝒜 hf),
      ∀ d : ℤ,
        (∃ φ : Localization.Away f ≃ₗ[Localization.Away f] Localization.Away f,
          ∀ n x, φ x ∈ ℳ n ↔ x ∈ awayGrading 𝒜 hf (n + d)) ↔
        (d : ShiftClassGroup (awayGrading 𝒜 hf)) = c := by
  have : PreconnectedSpace (PrimeSpectrum (Localization.Away f)) := by
    by_cases hf0 : f = 0
    · subst hf0
      have : Subsingleton (Localization.Away (0 : A)) :=
        IsLocalization.subsingleton (S := Localization.Away (0 : A))
          (Submonoid.mem_powers (0 : A))
      infer_instance
    · have := Localization.Away.isDomain hf0
      infer_instance
  exact existsUnique_shiftClass_of_connected (awayGrading 𝒜 hf) ℳ

end TauCeti.GradedAlgebra
