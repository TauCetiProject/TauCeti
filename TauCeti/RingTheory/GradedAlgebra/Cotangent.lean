/-!
# The cotangent space of the irrelevant ideal and polynomial presentations

Let `A` be an `ℕ`-graded commutative `R`-algebra with irrelevant ideal `A₊`, the elements with
zero constant term. By the graded Nakayama lemma
`TauCeti.GradedAlgebra.adjoin_eq_top_of_irrelevant_le`, homogeneous elements of positive degree
that generate `A₊` modulo `A₊ ^ 2` generate `A` as an algebra over its degree-zero part, so every
`R`-subalgebra containing them and the degree-zero part is everything. Consequently, when the
degree-zero part consists of scalars, homogeneous lifts of a spanning family of the cotangent
space `A₊ ⧸ A₊ ^ 2` generate `A` as an `R`-algebra, and the evaluation map from the polynomial
ring on these lifts is surjective. Unlike the local Nakayama lemma, no finiteness hypothesis is
needed: an induction on the degree replaces it.

Over a field `k`, the cotangent space thus bounds the Krull dimension: if it has finite dimension
`n`, then `dim A ≤ n`. When equality holds, `A` is a polynomial algebra on `n` homogeneous
generators of positive degree. Indeed, the evaluation map from a polynomial ring in `n`
variables is then a surjection onto a ring of the same dimension, and a nonzero kernel would
contain a nonzerodivisor of the polynomial ring, lowering the dimension.

This is the last step of the commutative-algebra proof that the invariants of a finite group
generated by pseudoreflections form a polynomial algebra: once the invariant algebra is known to
be regular at its irrelevant ideal, of dimension `dim V`, its cotangent space has dimension
`dim V`, and the result here produces a basic system of homogeneous invariants.

## Main results

* `TauCeti.GradedAlgebra.span_image_toCotangent_irrelevant_eq_top`: the cotangent space of `A₊`
  is spanned by the images of homogeneous elements of positive degree.
* `TauCeti.GradedAlgebra.bijective_aeval_of_irrelevant_le`: over a field, `Nat.card ι` such
  generators, with `Nat.card ι ≤ dim A`, are algebraically independent and generate `A`.
* `TauCeti.GradedAlgebra.ringKrullDim_le_finrank_cotangent`: over a field, the dimension of `A`
  is at most the dimension of the cotangent space of `A₊`.
* `TauCeti.GradedAlgebra.exists_bijective_aeval_of_finrank_cotangent_le`: if moreover the
  dimension of the cotangent space is at most `dim A`, then `A` is a polynomial algebra on that
  many homogeneous generators of positive degree.

## References

* W. Bruns, J. Herzog, *Cohen–Macaulay Rings*, Cambridge Studies in Advanced Mathematics 39,
  Cambridge University Press (1993), § 1.5, for graded rings and the graded Nakayama lemma.
* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  § 18, for its use in the polynomiality of invariants of reflection groups.
-/

public section

open DirectSum HomogeneousIdeal Pointwise

namespace TauCeti.GradedAlgebra

section CommRing

variable {R A : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
  (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]

/-- The cotangent space `A₊ ⧸ A₊ ^ 2` of the irrelevant ideal is spanned over the coefficients by
the images of the homogeneous elements of positive degree. -/
theorem span_image_toCotangent_irrelevant_eq_top :
    Submodule.span R ((irrelevant 𝒜).toIdeal.toCotangent ''
      {x | ∃ n, 0 < n ∧ (x : A) ∈ 𝒜 n}) = ⊤ := by
  classical
  refine eq_top_iff.2 fun y _ ↦ ?_
  obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective _ y
  -- Split `x` into its homogeneous components, all of positive degree.
  have hcomp (n : ℕ) : (decompose 𝒜 (x : A) n : A) ∈ (irrelevant 𝒜).toIdeal :=
    (irrelevant 𝒜).isHomogeneous n x.2
  have hx : x = ∑ n ∈ (decompose 𝒜 (x : A)).support, ⟨_, hcomp n⟩ :=
    Subtype.ext <| by
      rw [Submodule.coe_sum]
      exact (sum_support_decompose 𝒜 (x : A)).symm
  rw [hx, map_sum]
  refine Submodule.sum_mem _ fun n hn ↦ Submodule.subset_span ⟨_, ⟨n, ?_, SetLike.coe_mem _⟩, rfl⟩
  refine Nat.pos_of_ne_zero fun hn0 ↦ DFinsupp.mem_support_iff.1 hn ?_
  subst hn0
  -- Membership in `𝒜₊` says that the degree-zero projection vanishes.
  have h0 := (mem_irrelevant_iff 𝒜 (x : A)).1 x.2
  rw [GradedRing.proj_apply] at h0
  exact Subtype.ext h0

end CommRing

section Field

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A]
  (𝒜 : ℕ → Submodule k A) [GradedAlgebra 𝒜]

/-- **Polynomial presentation of a connected graded algebra.** Let the degree-zero part of `A`
consist of scalars, and let `f` be a finite family of homogeneous elements of positive degree
generating the irrelevant ideal `A₊` modulo `A₊ ^ 2`. If the number of elements is at most the
Krull dimension of `A`, then `f` is algebraically independent and generates `A`: evaluation at
`f` is an isomorphism from the polynomial ring. -/
theorem bijective_aeval_of_irrelevant_le (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra k A)) {ι : Type*}
    [Finite ι] {f : ι → A} (hf : ∀ i, ∃ n, 0 < n ∧ f i ∈ 𝒜 n)
    (h : (irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range f) ⊔ (irrelevant 𝒜).toIdeal ^ 2)
    (hdim : (Nat.card ι : WithBot ℕ∞) ≤ ringKrullDim A) :
    Function.Bijective (MvPolynomial.aeval (R := k) f) := by
  have hpoly : ringKrullDim (MvPolynomial ι k) = Nat.card ι := by simp
  have := FiniteRingKrullDim.of_ringKrullDim_eq_natCast hpoly
  have hsurj := surjective_aeval_of_irrelevant_le 𝒜 h𝒜 hf h
  exact ⟨(MvPolynomial.aeval f).toRingHom.injective_of_surjective_of_ringKrullDim_le hsurj
    (hpoly ▸ hdim), hsurj⟩

variable [Module.Finite k (irrelevant 𝒜).toIdeal.Cotangent]

/-- Homogeneous elements of positive degree whose images form a basis of the cotangent space
of the irrelevant ideal. -/
private theorem exists_homogeneous_span_toCotangent_eq_top :
    ∃ f : Fin (Module.finrank k (irrelevant 𝒜).toIdeal.Cotangent) → (irrelevant 𝒜).toIdeal,
      (∀ i, ∃ n, 0 < n ∧ (f i : A) ∈ 𝒜 n) ∧
        Submodule.span k (Set.range ((irrelevant 𝒜).toIdeal.toCotangent ∘ f)) = ⊤ := by
  set I := (irrelevant 𝒜).toIdeal
  set S := I.toCotangent '' {x | ∃ n, 0 < n ∧ (x : A) ∈ 𝒜 n}
  have hg := Submodule.exists_fun_fin_finrank_span_eq k S
  rw [span_image_toCotangent_irrelevant_eq_top, finrank_top] at hg
  obtain ⟨g, hgS, hspan, -⟩ := hg
  choose x hx hxg using hgS
  refine ⟨x, hx, ?_⟩
  rwa [← funext hxg] at hspan

/-- Over a field, the Krull dimension of a connected graded algebra is at most the dimension of
the cotangent space `A₊ ⧸ A₊ ^ 2` of its irrelevant ideal, when the latter is finite. -/
theorem ringKrullDim_le_finrank_cotangent (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra k A)) :
    ringKrullDim A ≤ Module.finrank k (irrelevant 𝒜).toIdeal.Cotangent := by
  obtain ⟨f, hf, hspan⟩ := exists_homogeneous_span_toCotangent_eq_top 𝒜
  have hsurj := surjective_aeval_of_irrelevant_le (R := k) (f := fun i ↦ (f i : A)) 𝒜 h𝒜 hf
    ((irrelevant 𝒜).toIdeal.le_span_sup_sq_of_span_toCotangent_eq_top
      (Submodule.span_eq_top_of_span_eq_top k A _ hspan))
  refine (ringKrullDim_le_of_surjective (MvPolynomial.aeval _).toRingHom hsurj).trans ?_
  -- Unfolding `toIdeal_irrelevant` would change the type of the cotangent space in the goal,
  -- leaving its module instance ill-typed.
  simp [-toIdeal_irrelevant]

/-- **A connected graded algebra with cotangent space of the right dimension is polynomial.** Let
`A` be a graded algebra over a field `k` whose degree-zero part consists of scalars, and suppose
that the cotangent space `A₊ ⧸ A₊ ^ 2` of the irrelevant ideal has finite dimension `n ≤ dim A`.
Then `A` is a polynomial algebra on `n` homogeneous generators of positive degree. -/
theorem exists_bijective_aeval_of_finrank_cotangent_le
    (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra k A))
    (hdim : (Module.finrank k (irrelevant 𝒜).toIdeal.Cotangent : WithBot ℕ∞) ≤
      ringKrullDim A) :
    ∃ f : Fin (Module.finrank k (irrelevant 𝒜).toIdeal.Cotangent) → A,
      (∀ i, ∃ n, 0 < n ∧ f i ∈ 𝒜 n) ∧ Function.Bijective (MvPolynomial.aeval (R := k) f) := by
  obtain ⟨f, hf, hspan⟩ := exists_homogeneous_span_toCotangent_eq_top 𝒜
  refine ⟨fun i ↦ f i, hf, bijective_aeval_of_irrelevant_le 𝒜 h𝒜 hf
    ((irrelevant 𝒜).toIdeal.le_span_sup_sq_of_span_toCotangent_eq_top
      (Submodule.span_eq_top_of_span_eq_top k A _ hspan)) ?_⟩
  rwa [Nat.card_eq_fintype_card, Fintype.card_fin]

end Field

end TauCeti.GradedAlgebra
