/-!
# The degrees of homogeneous polynomial generators are intrinsic

Let `A` be an `ℕ`-graded commutative algebra over a commutative ring `R`, with irrelevant ideal
`A₊`, and let `f : ι → A` be homogeneous elements, `fᵢ` of degree `dᵢ > 0`, such that evaluation
`R[Xᵢ | i ∈ ι] → A`, `Xᵢ ↦ fᵢ`, is an isomorphism: `A` is a polynomial algebra on the `fᵢ`.
The generators are far from unique, but their degrees are determined by `A` and its grading.
For `n > 0`, the classes of the generators of degree `n` form a basis of

`𝒜 n ⧸ (𝒜 n ∩ A₊ ^ 2)`,

the degree-`n` part of the cotangent space `A₊ ⧸ A₊ ^ 2`. So the number of generators of degree
`n` is the rank of this free `R`-module, which does not mention the `fᵢ`. In particular, when
`R` is nontrivial, two finite systems of homogeneous polynomial generators of positive degree
have the same multiset of degrees. Positivity is automatic when the degree-zero part of `A`
consists of scalars: an algebraically independent element of degree zero would be a scalar.

Spanning only uses that the `fᵢ` generate `A`: a monomial in them is a scalar, a single
generator, or a product of at least two elements of `A₊`, and the degree-`n` projection keeps
`A₊ ^ 2`, a homogeneous ideal. Linear independence uses that they are algebraically independent:
pulled back to the polynomial ring, `A₊` is the ideal of polynomials with zero constant term,
and `A₊ ^ 2` the ideal of polynomials with no terms of total degree below two.

The application in view is invariant theory: by the Chevalley–Shephard–Todd theorem, the
invariants of a finite group generated by pseudoreflections form a polynomial algebra on
homogeneous generators, the basic invariants, and their degrees are invariants of the group.

## Main results

* `TauCeti.GradedAlgebra.pos_of_algebraicIndependent`: in a connected graded algebra,
  algebraically independent homogeneous elements have positive degree.
* `TauCeti.GradedAlgebra.projZeroRingHom_aeval`: the degree-zero part of a polynomial in
  homogeneous elements of positive degree is its constant coefficient.
* `TauCeti.GradedAlgebra.span_range_mk_eq_top_of_surjective_aeval` and
  `TauCeti.GradedAlgebra.linearIndependent_mk_of_bijective_aeval`: the generators of degree
  `n > 0` give a basis of `𝒜 n ⧸ (𝒜 n ∩ A₊ ^ 2)`.
* `TauCeti.GradedAlgebra.finrank_quotient_eq_natCard_of_bijective_aeval`: the number of
  generators of degree `n > 0` is the rank of `𝒜 n ⧸ (𝒜 n ∩ A₊ ^ 2)`.
* `TauCeti.GradedAlgebra.map_univ_eq_of_bijective_aeval`: two finite systems of homogeneous
  polynomial generators of positive degree have the same multiset of degrees.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  § 18.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge Studies in Advanced
  Mathematics 29, Cambridge University Press (1990), § 3.7.
-/

public section

open DirectSum HomogeneousIdeal MvPolynomial

namespace TauCeti.GradedAlgebra

variable {R A ι : Type*} [CommRing R] [CommRing A] [Algebra R A]
  (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] {f : ι → A} {d : ι → ℕ}

omit [GradedAlgebra 𝒜] in
/-- In a graded algebra whose degree-zero part consists of scalars, algebraically independent
homogeneous elements have positive degree: one of degree zero would be a scalar. -/
theorem pos_of_algebraicIndependent [Nontrivial R] (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra R A))
    (hf : ∀ i, f i ∈ 𝒜 (d i)) (hind : AlgebraicIndependent R f) (i : ι) : 0 < d i := by
  refine Nat.pos_of_ne_zero fun h ↦ ?_
  obtain ⟨c, hc⟩ := Algebra.mem_bot.1 (h𝒜 _ (h ▸ hf i))
  exact hind.transcendental i (hc ▸ isAlgebraic_algebraMap c)

/-- The degree-zero part of a polynomial in homogeneous elements of positive degree is its
constant coefficient. -/
theorem projZeroRingHom_aeval (hd : ∀ i, 0 < d i) (hf : ∀ i, f i ∈ 𝒜 (d i))
    (p : MvPolynomial ι R) :
    GradedRing.projZeroRingHom 𝒜 (aeval f p) = algebraMap R A (constantCoeff p) := by
  have : (GradedRing.projZeroRingHom 𝒜).comp (aeval f).toRingHom =
      (algebraMap R A).comp constantCoeff := by
    refine MvPolynomial.ringHom_ext (fun c ↦ ?_) (fun i ↦ ?_)
    · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_C,
        constantCoeff_C, GradedRing.projZeroRingHom_apply]
      exact decompose_of_mem_same 𝒜 (SetLike.algebraMap_mem_graded 𝒜 c)
    · simp [decompose_of_mem_ne 𝒜 (hf i) (hd i).ne']
  exact congr($this p)

/-- A monomial in homogeneous elements of positive degree is `1`, a single one of them, or the
product of at least two elements of `A₊`. -/
private theorem aeval_monomial_eq_one_or (hd : ∀ i, 0 < d i) (hf : ∀ i, f i ∈ 𝒜 (d i))
    (m : ι →₀ ℕ) :
    aeval f (monomial m (1 : R)) = 1 ∨ (∃ i, aeval f (monomial m (1 : R)) = f i) ∨
      aeval f (monomial m (1 : R)) ∈ (irrelevant 𝒜).toIdeal ^ 2 := by
  rcases eq_or_ne m 0 with rfl | hm
  · simp
  -- Split off one variable: `Xᵐ = Xᵐ' * Xᵢ`.
  obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.2 hm
  obtain ⟨m', rfl⟩ : ∃ m', m = m' + Finsupp.single i 1 :=
    le_iff_exists_add'.1 (Finsupp.single_le_iff.2 (Nat.one_le_iff_ne_zero.2
      (Finsupp.mem_support_iff.1 hi)))
  rw [monomial_add_single, pow_one, map_mul, aeval_X]
  rcases eq_or_ne m' 0 with rfl | hm'
  · exact .inr (.inl ⟨i, by simp⟩)
  refine .inr (.inr ?_)
  rw [pow_two]
  refine Ideal.mul_mem_mul ?_ (mem_irrelevant_of_mem 𝒜 (hd i) (hf i))
  rw [toIdeal_irrelevant, RingHom.mem_ker, projZeroRingHom_aeval 𝒜 hd hf]
  classical simp [constantCoeff_monomial, hm']

/-- **Homogeneous polynomial generators span the graded cotangent space.** If homogeneous
elements `fᵢ` of positive degrees `dᵢ` generate `A` as a `R`-algebra, then for `n > 0` the classes
of those of degree `n` span `𝒜 n ⧸ (𝒜 n ∩ A₊ ^ 2)`. -/
theorem span_range_mk_eq_top_of_surjective_aeval (hd : ∀ i, 0 < d i) (hf : ∀ i, f i ∈ 𝒜 (d i))
    (hsurj : Function.Surjective (aeval (R := R) f)) {n : ℕ} (hn : 0 < n) :
    Submodule.span R (Set.range fun i : {i // d i = n} ↦
      (Submodule.Quotient.mk ⟨f i, by simpa only [i.2] using hf i⟩ :
        𝒜 n ⧸ Submodule.comap (𝒜 n).subtype
          (((irrelevant 𝒜).toIdeal ^ 2).restrictScalars R))) = ⊤ := by
  set N := Submodule.comap (𝒜 n).subtype (((irrelevant 𝒜).toIdeal ^ 2).restrictScalars R)
  set S := Submodule.span R (Set.range fun i : {i // d i = n} ↦
    (Submodule.Quotient.mk ⟨f i, by simpa only [i.2] using hf i⟩ : 𝒜 n ⧸ N))
  -- The degree-`n` component, read in the quotient. It kills `A₊ ^ 2`, a homogeneous ideal.
  let π : A →ₗ[R] 𝒜 n ⧸ N :=
    N.mkQ ∘ₗ DirectSum.component R ℕ (fun i ↦ 𝒜 i) n ∘ₗ (decomposeLinearEquiv 𝒜).toLinearMap
  have hπ (a : A) : π a = Submodule.Quotient.mk (decompose 𝒜 a n) := rfl
  have hπ0 {a : A} (ha : (decompose 𝒜 a n : A) ∈ (irrelevant 𝒜).toIdeal ^ 2) : π a = 0 := by
    rwa [hπ, Submodule.Quotient.mk_eq_zero]
  have hI : ((irrelevant 𝒜).toIdeal ^ 2).IsHomogeneous 𝒜 := by
    rw [pow_two]
    exact (irrelevant 𝒜).isHomogeneous.mul (irrelevant 𝒜).isHomogeneous
  have hπS (p : MvPolynomial ι R) : π (aeval f p) ∈ S := by
    induction p using MvPolynomial.induction_on' with
    | monomial m c =>
      rw [← mul_one c, ← smul_eq_mul, ← smul_monomial, map_smul, map_smul]
      refine S.smul_mem c ?_
      rcases aeval_monomial_eq_one_or 𝒜 hd hf m with h | ⟨i, h⟩ | h
      · rw [h, hπ0 (by
          rw [decompose_of_mem_ne 𝒜 SetLike.GradedOne.one_mem hn.ne]; exact zero_mem _)]
        exact S.zero_mem
      · rw [h]
        by_cases hi : d i = n
        · refine Submodule.subset_span ⟨⟨i, hi⟩, ?_⟩
          rw [hπ]
          exact congrArg _ (Subtype.ext (decompose_of_mem_same 𝒜 (hi ▸ hf i)).symm)
        · rw [hπ0 (by rw [decompose_of_mem_ne 𝒜 (hf i) hi]; exact zero_mem _)]
          exact S.zero_mem
      · rw [hπ0 (hI n h)]
        exact S.zero_mem
    | add p q hp hq => rw [map_add, map_add]; exact S.add_mem hp hq
  refine eq_top_iff.2 fun x _ ↦ ?_
  induction x using Submodule.Quotient.induction_on with | H a =>
  obtain ⟨p, hp⟩ := hsurj a
  convert hπS p
  rw [hp, hπ]
  exact congrArg _ (Subtype.ext (decompose_of_mem_same 𝒜 a.2).symm)

/-- **Homogeneous polynomial generators are independent in the graded cotangent space.** If `A`
is the polynomial algebra on homogeneous elements `fᵢ` of positive degrees `dᵢ`, then for every
`n` the classes of those of degree `n` in `𝒜 n ⧸ (𝒜 n ∩ A₊ ^ 2)` are linearly independent. -/
theorem linearIndependent_mk_of_bijective_aeval (hd : ∀ i, 0 < d i) (hf : ∀ i, f i ∈ 𝒜 (d i))
    (hbij : Function.Bijective (aeval (R := R) f)) (n : ℕ) :
    LinearIndependent R fun i : {i // d i = n} ↦
      (Submodule.Quotient.mk ⟨f i, by simpa only [i.2] using hf i⟩ :
        𝒜 n ⧸ Submodule.comap (𝒜 n).subtype
          (((irrelevant 𝒜).toIdeal ^ 2).restrictScalars R)) := by
  classical
  let e := AlgEquiv.ofBijective (aeval (R := R) f) hbij
  -- Pulled back to the polynomial ring, `A₊` consists of polynomials without constant term.
  have hI : (irrelevant 𝒜).toIdeal ≤ (idealOfVars ι R).comap e.symm := by
    intro a ha
    rw [Ideal.mem_comap, ← pow_one (idealOfVars ι R), mem_pow_idealOfVars_iff']
    intro m hm
    obtain rfl : m = 0 := (Finsupp.degree_eq_zero_iff m).1 (Nat.lt_one_iff.1 hm)
    have h0 := projZeroRingHom_aeval 𝒜 hd hf (e.symm a)
    rw [show aeval f (e.symm a) = a from e.apply_symm_apply a] at h0
    rw [toIdeal_irrelevant, RingHom.mem_ker, h0] at ha
    rw [← constantCoeff_eq]
    -- `R → A` is injective, as the composite of `C` and the injective `aeval f`.
    refine C_injective ι R (hbij.1 ?_)
    rw [aeval_C, ha, map_zero, map_zero]
  -- So the coefficient of `Xⱼ` vanishes on `A₊ ^ 2`.
  let ℓ : A →ₗ[R] ι → R := LinearMap.pi fun j ↦
    (MvPolynomial.lcoeff R (Finsupp.single j 1)) ∘ₗ e.symm.toLinearMap
  have hℓ {a : A} (ha : a ∈ (irrelevant 𝒜).toIdeal ^ 2) : ℓ a = 0 := by
    have := Ideal.le_comap_pow (e.symm : A →+* MvPolynomial ι R) 2
      (Ideal.pow_right_mono hI 2 ha)
    rw [Ideal.mem_comap, mem_pow_idealOfVars_iff'] at this
    ext j
    exact this _ (by simp)
  let L := (Submodule.comap (𝒜 n).subtype (((irrelevant 𝒜).toIdeal ^ 2).restrictScalars R)).liftQ
    (ℓ ∘ₗ (𝒜 n).subtype) fun a ha ↦
    hℓ ((Submodule.restrictScalars_mem R _ _).1 (Submodule.mem_comap.1 ha))
  have hX (i : ι) : e.symm (f i) = X i := e.symm_apply_eq.2 (by simp [e])
  refine LinearIndependent.of_comp L ?_
  convert (Pi.linearIndependent_single_one ι R).comp _ Subtype.val_injective with i
  ext j
  -- The quotient in the statement carries the module instances found by elaboration, which
  -- agree with those of `liftQ` only up to unfolding, so `Submodule.liftQ_apply` is applied by
  -- unification rather than by rewriting.
  refine (congrFun (Submodule.liftQ_apply _ _ _) _).trans ?_
  simp [ℓ, hX, coeff_X, Pi.single_apply, Finsupp.single_left_inj one_ne_zero, eq_comm]

/-- **The number of homogeneous polynomial generators of each degree is intrinsic.** If `A` is
the polynomial algebra on homogeneous elements `fᵢ` of positive degrees `dᵢ`, then for `n > 0` the
number of `fᵢ` of degree `n` is the rank of `𝒜 n ⧸ (𝒜 n ∩ A₊ ^ 2)`, the degree-`n` part of
the cotangent space `A₊ ⧸ A₊ ^ 2`. -/
theorem finrank_quotient_eq_natCard_of_bijective_aeval [Nontrivial R] (hd : ∀ i, 0 < d i)
    (hf : ∀ i, f i ∈ 𝒜 (d i)) (hbij : Function.Bijective (aeval (R := R) f)) {n : ℕ}
    (hn : 0 < n) :
    Module.finrank R (𝒜 n ⧸ Submodule.comap (𝒜 n).subtype
      (((irrelevant 𝒜).toIdeal ^ 2).restrictScalars R)) = Nat.card {i // d i = n} :=
  Module.finrank_eq_nat_card_basis <|
    Module.Basis.mk (linearIndependent_mk_of_bijective_aeval 𝒜 hd hf hbij n)
      (span_range_mk_eq_top_of_surjective_aeval 𝒜 hd hf hbij.2 hn).ge

/-- **The degrees of homogeneous polynomial generators are intrinsic.** If `A` is the polynomial
algebra on homogeneous elements `fᵢ` of positive degrees `dᵢ`, and also on homogeneous elements `gⱼ`
of positive degrees `eⱼ`, both finite families, then the multisets of degrees `{dᵢ}` and `{eⱼ}`
coincide. When the degree-zero part of `A` consists of scalars, positivity of the degrees is
automatic (`TauCeti.GradedAlgebra.pos_of_algebraicIndependent`). -/
theorem map_univ_eq_of_bijective_aeval [Nontrivial R] [Fintype ι] {κ : Type*} [Fintype κ]
    {g : κ → A} {e : κ → ℕ} (hd : ∀ i, 0 < d i) (he : ∀ j, 0 < e j) (hf : ∀ i, f i ∈ 𝒜 (d i))
    (hg : ∀ j, g j ∈ 𝒜 (e j)) (hfb : Function.Bijective (aeval (R := R) f))
    (hgb : Function.Bijective (aeval (R := R) g)) :
    Finset.univ.val.map d = Finset.univ.val.map e := by
  classical
  ext n
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [(hd _).ne', (he _).ne']
  -- Both counts are the rank of `𝒜 n ⧸ (𝒜 n ∩ A₊ ^ 2)`.
  have h := (finrank_quotient_eq_natCard_of_bijective_aeval 𝒜 hd hf hfb hn).symm.trans
    (finrank_quotient_eq_natCard_of_bijective_aeval 𝒜 he hg hgb hn)
  simp only [Nat.card_eq_fintype_card, Fintype.card_subtype] at h
  simpa [Multiset.count_map, ← Finset.filter_val, eq_comm] using h

end TauCeti.GradedAlgebra
