/-!
# Homogeneous units of weighted polynomial rings and their prime localizations

Let `MvPolynomial σ R` be graded by weights `w : σ → ι` through
`MvPolynomial.weightedHomogeneousSubmodule R w`. Because `MvPolynomial.constantCoeff` is a ring
homomorphism, every unit of `MvPolynomial σ R` over a nontrivial commutative semiring `R` has a
unit — hence nonzero — constant term, so any weighted-homogeneous unit must have degree `0`. Thus
`homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥`, and the shift class group of a
weighted polynomial ring is canonically `ι`.

Over a domain `R`, localizing `MvPolynomial σ R` away from a weighted-homogeneous prime `f` of
degree `e` (such as a coordinate variable `X i` of weight `w i`) yields homogeneous unit degrees
`AddSubgroup.zmultiples e`, and for integer weights `w : σ → ℤ` identifies the shift class group of
`Localization.Away f` with `ZMod e.natAbs`. More generally, inverting a positive power `p ^ m` of a
weighted-homogeneous prime `p` of degree `e` still produces `AddSubgroup.zmultiples e` rather than
`AddSubgroup.zmultiples (m • e)`, and inverting a finite product `∏ j ∈ s, g j` of
weighted-homogeneous primes of degrees `e j` produces the subgroup generated by the `e j`.

## Main definitions

* `TauCeti.shiftClassGroupWeightedHomogeneousSubmoduleEquiv`:
  `ShiftClassGroup (weightedHomogeneousSubmodule R w) ≃+ ι`.
* `TauCeti.shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleEquiv` and
  `TauCeti.shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleXEquiv`: for integer weights
  `w : σ → ℤ` and a prime `f` of weight `e` (in particular `f = X i` of weight `w i`), the shift
  class group of `Localization.Away f` is `ZMod |e|`.

## Main results

* `MvPolynomial.IsWeightedHomogeneous.of_isUnit`: over a reduced commutative ring, every unit of
  `MvPolynomial σ R` is weighted-homogeneous of degree `0`.
* `TauCeti.homogeneousUnitDegrees_weightedHomogeneousSubmodule`: over a nontrivial commutative
  semiring, `homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥`.
* `TauCeti.homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime`,
  `TauCeti.homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_pow_of_prime`, and
  `TauCeti.homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_prod_of_prime`:
  homogeneous unit degrees of localizations of `MvPolynomial σ R` away from a weighted-homogeneous
  prime, prime power, or finite product of primes, with specializations to `X i` and `∏ i ∈ s, X i`.
-/

public section

namespace MvPolynomial.IsWeightedHomogeneous

/-- Over a reduced commutative ring, every unit of `MvPolynomial σ R` is a constant scalar `C r`,
hence weighted-homogeneous of degree `0` for any weight function `w`. -/
theorem of_isUnit {σ M R : Type*} [AddCommMonoid M] [CommRing R] [IsReduced R] (w : σ → M)
    {u : MvPolynomial σ R} (hu : IsUnit u) : IsWeightedHomogeneous w u 0 := by
  obtain ⟨r, -, rfl⟩ := isUnit_iff_eq_C_of_isReduced.mp hu
  exact isWeightedHomogeneous_C w r

end MvPolynomial.IsWeightedHomogeneous

namespace TauCeti

open MvPolynomial _root_.TauCeti.GradedAlgebra

attribute [local instance] MvPolynomial.WeightedHomogeneousSubmodule.gradedMonoid

section WeightedPolynomial

variable {σ ι : Type*} [AddCommGroup ι] (R : Type*) [CommSemiring R] [Nontrivial R] (w : σ → ι)

/-- **Homogeneous unit degrees of a weighted polynomial ring.** Over a nontrivial commutative
semiring `R`, every unit of `MvPolynomial σ R` has a unit (hence nonzero) constant coefficient, so
every weighted-homogeneous unit has degree `0`. -/
@[simp]
theorem homogeneousUnitDegrees_weightedHomogeneousSubmodule :
    homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥ := by
  rw [eq_bot_iff]
  refine homogeneousUnitDegrees_le_iff.mpr fun u d hu ↦ AddSubgroup.mem_bot.mpr ?_
  have hc : (u : MvPolynomial σ R).coeff 0 ≠ 0 := by
    simpa [constantCoeff_eq] using (u.isUnit.map (constantCoeff : MvPolynomial σ R →+* R)).ne_zero
  simpa using (hu hc).symm

/-- For a nontrivial commutative semiring `R`, the shift class group of `MvPolynomial σ R` with
weights `w : σ → ι` is canonically `ι`. -/
noncomputable def shiftClassGroupWeightedHomogeneousSubmoduleEquiv :
    ShiftClassGroup (weightedHomogeneousSubmodule R w) ≃+ ι :=
  shiftClassGroupEquivOfEqBot (homogeneousUnitDegrees_weightedHomogeneousSubmodule R w)

@[simp]
theorem shiftClassGroupWeightedHomogeneousSubmoduleEquiv_mk (d : ι) :
    shiftClassGroupWeightedHomogeneousSubmoduleEquiv R w
      (d : ShiftClassGroup (weightedHomogeneousSubmodule R w)) = d :=
  shiftClassGroupEquivOfEqBot_mk (homogeneousUnitDegrees_weightedHomogeneousSubmodule R w) d

@[simp]
theorem shiftClassGroupWeightedHomogeneousSubmoduleEquiv_symm_apply (d : ι) :
    (shiftClassGroupWeightedHomogeneousSubmoduleEquiv R w).symm d = d :=
  shiftClassGroupEquivOfEqBot_symm_apply
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule R w) d

end WeightedPolynomial

section AwayPrime

variable {σ ι R : Type*} [AddCommGroup ι] [CommSemiring R] [IsCancelAdd R] [IsCancelMulZero R]
  (w : σ → ι)

omit [IsCancelAdd R] [IsCancelMulZero R] in
private theorem nontrivial_of_prime_mvPolynomial {f : MvPolynomial σ R} (hprime : Prime f) :
    Nontrivial R :=
  ⟨⟨0, 1, fun h01 ↦ hprime.ne_zero <| by
    have : Subsingleton R := subsingleton_of_zero_eq_one h01
    exact Subsingleton.elim f 0⟩⟩

/-- **Homogeneous unit degrees after inverting a weighted-homogeneous prime.** In
`MvPolynomial σ R` over a cancellative coefficient semiring, inverting a prime `f` of weight `e`
produces homogeneous unit degrees `AddSubgroup.zmultiples e`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime
    {f : MvPolynomial σ R} {e : ι} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hprime : Prime f) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples e := by
  classical
  have := nontrivial_of_prime_mvPolynomial hprime
  let := MvPolynomial.weightedGradedAlgebra R w
  exact homogeneousUnitDegrees_awayGrading_eq_zmultiples_of_prime
    (weightedHomogeneousSubmodule R w) hf
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule R w) hprime

/-- Inverting a positive power `p ^ m` (`m ≠ 0`) of a weighted-homogeneous prime `p` of weight `e`
yields homogeneous unit degrees `AddSubgroup.zmultiples e` (generated by `e`, not `m • e`). -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_pow_of_prime
    {p : MvPolynomial σ R} {e : ι} (hp : p ∈ weightedHomogeneousSubmodule R w e)
    (hprime : Prime p) {m : ℕ} (hm : m ≠ 0)
    (hf : p ^ m ∈ weightedHomogeneousSubmodule R w (m • e) := SetLike.pow_mem_graded m hp) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples e := by
  rw [homogeneousUnitDegrees_awayGrading_pow (weightedHomogeneousSubmodule R w) hp hm hf,
    homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime w hp hprime]

/-- **Homogeneous unit degrees after inverting a product of weighted-homogeneous primes.** Over a
domain `R`, inverting `∏ j ∈ s, g j` with each `g j` prime of weight `e j` produces homogeneous unit
degrees `⨆ j ∈ s, AddSubgroup.zmultiples (e j)`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_prod_of_prime [Nontrivial R]
    {J : Type*} {s : Finset J} {g : J → MvPolynomial σ R} {e : J → ι}
    (hg : ∀ j ∈ s, g j ∈ weightedHomogeneousSubmodule R w (e j))
    (hprime : ∀ j ∈ s, Prime (g j))
    (hf : ∏ j ∈ s, g j ∈ weightedHomogeneousSubmodule R w (∑ j ∈ s, e j) :=
      SetLike.prod_mem_graded (weightedHomogeneousSubmodule R w) e g hg) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      ⨆ j ∈ s, AddSubgroup.zmultiples (e j) := by
  classical
  let := MvPolynomial.weightedGradedAlgebra R w
  rw [homogeneousUnitDegrees_awayGrading_prod_of_prime (weightedHomogeneousSubmodule R w)
    hg hprime hf, homogeneousUnitDegrees_weightedHomogeneousSubmodule R w, bot_sup_eq]

/-- Closure form of `homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_prod_of_prime`:
inverting `∏ j ∈ s, g j` produces the subgroup generated by `{e j | j ∈ s}`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_prod_eq_closure_of_prime
    [Nontrivial R] {J : Type*} {s : Finset J} {g : J → MvPolynomial σ R} {e : J → ι}
    (hg : ∀ j ∈ s, g j ∈ weightedHomogeneousSubmodule R w (e j))
    (hprime : ∀ j ∈ s, Prime (g j))
    (hf : ∏ j ∈ s, g j ∈ weightedHomogeneousSubmodule R w (∑ j ∈ s, e j) :=
      SetLike.prod_mem_graded (weightedHomogeneousSubmodule R w) e g hg) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.closure (e '' (s : Set J)) := by
  classical
  let := MvPolynomial.weightedGradedAlgebra R w
  exact homogeneousUnitDegrees_awayGrading_prod_eq_closure_of_prime
    (weightedHomogeneousSubmodule R w) (homogeneousUnitDegrees_weightedHomogeneousSubmodule R w)
    hg hprime hf

end AwayPrime

section ShiftClassGroup

variable {σ R : Type*} [CommSemiring R] [IsCancelAdd R] [IsCancelMulZero R] (w : σ → ℤ)

/-- For integer weights `w : σ → ℤ` and a weighted-homogeneous prime `f` of weight `e`, the shift
class group of `Localization.Away f` is `ZMod |e|`. -/
noncomputable def shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleEquiv
    {f : MvPolynomial σ R} {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hprime : Prime f) :
    ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hf) ≃+ ZMod e.natAbs :=
  letI := MvPolynomial.weightedGradedAlgebra R w
  haveI := nontrivial_of_prime_mvPolynomial hprime
  shiftClassGroupAwayGradingEquiv (weightedHomogeneousSubmodule R w) hf
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule R w) hprime

@[simp]
theorem shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleEquiv_mk
    {f : MvPolynomial σ R} {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hprime : Prime f) (d : ℤ) :
    shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleEquiv w hf hprime
      (d : ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hf)) = d :=
  letI := MvPolynomial.weightedGradedAlgebra R w
  haveI := nontrivial_of_prime_mvPolynomial hprime
  shiftClassGroupAwayGradingEquiv_mk (weightedHomogeneousSubmodule R w) hf
    (homogeneousUnitDegrees_weightedHomogeneousSubmodule R w) hprime d

end ShiftClassGroup

section CoordinateHyperplanes

variable {σ : Type*} (R : Type*) [CommRing R] [IsDomain R]

section AnyGroup

variable {ι : Type*} [AddCommGroup ι] (w : σ → ι)

/-- Inverting a coordinate variable `X i` of weight `w i` in `MvPolynomial σ R` over a domain `R`
gives homogeneous unit degrees `AddSubgroup.zmultiples (w i)`. -/
@[simp]
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_X (i : σ)
    (hx : (X i : MvPolynomial σ R) ∈ weightedHomogeneousSubmodule R w (w i) :=
      (mem_weightedHomogeneousSubmodule R w (w i) (X i)).mpr
        (isWeightedHomogeneous_X (R := R) w i)) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hx) =
      AddSubgroup.zmultiples (w i) :=
  homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_of_prime w hx prime_X

/-- Inverting `(X i) ^ m` (`m ≠ 0`) in `MvPolynomial σ R` over a domain `R` produces homogeneous
unit degrees `AddSubgroup.zmultiples (w i)`, generated by `w i` rather than `m • w i`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_X_pow (i : σ) {m : ℕ}
    (hm : m ≠ 0)
    (hf : (X i : MvPolynomial σ R) ^ m ∈ weightedHomogeneousSubmodule R w (m • w i) :=
      SetLike.pow_mem_graded m ((mem_weightedHomogeneousSubmodule R w (w i) (X i)).mpr
        (isWeightedHomogeneous_X (R := R) w i))) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples (w i) :=
  homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_pow_of_prime w
    ((mem_weightedHomogeneousSubmodule R w (w i) (X i)).mpr
      (isWeightedHomogeneous_X (R := R) w i))
    prime_X hm hf

/-- Inverting a product `∏ i ∈ s, X i` of coordinate variables in `MvPolynomial σ R` over a domain
`R` produces homogeneous unit degrees `⨆ i ∈ s, AddSubgroup.zmultiples (w i)`. -/
theorem homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_prod_X (s : Finset σ)
    (hf : ∏ i ∈ s, (X i : MvPolynomial σ R) ∈ weightedHomogeneousSubmodule R w (∑ i ∈ s, w i) :=
      SetLike.prod_mem_graded (weightedHomogeneousSubmodule R w) w X fun i _ ↦
        (mem_weightedHomogeneousSubmodule R w (w i) (X i)).mpr
          (isWeightedHomogeneous_X (R := R) w i)) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      ⨆ i ∈ s, AddSubgroup.zmultiples (w i) :=
  homogeneousUnitDegrees_awayGrading_weightedHomogeneousSubmodule_prod_of_prime w
    (fun i _ ↦ (mem_weightedHomogeneousSubmodule R w (w i) (X i)).mpr
      (isWeightedHomogeneous_X (R := R) w i))
    (fun _ _ ↦ prime_X) hf

end AnyGroup

section IntWeights

variable (w : σ → ℤ)

/-- For integer weights `w : σ → ℤ` over a domain `R`, the shift class group on the complement of
the coordinate hyperplane `X i = 0` is `ZMod |w i|`. -/
noncomputable def shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleXEquiv (i : σ)
    (hx : (X i : MvPolynomial σ R) ∈ weightedHomogeneousSubmodule R w (w i) :=
      (mem_weightedHomogeneousSubmodule R w (w i) (X i)).mpr
        (isWeightedHomogeneous_X (R := R) w i)) :
    ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hx) ≃+ ZMod (w i).natAbs :=
  shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleEquiv w hx prime_X

@[simp]
theorem shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleXEquiv_mk (i : σ)
    (hx : (X i : MvPolynomial σ R) ∈ weightedHomogeneousSubmodule R w (w i)) (d : ℤ) :
    shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleXEquiv R w i hx
      (d : ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hx)) = d :=
  shiftClassGroupAwayGradingWeightedHomogeneousSubmoduleEquiv_mk w hx prime_X d

end IntWeights

end CoordinateHyperplanes

