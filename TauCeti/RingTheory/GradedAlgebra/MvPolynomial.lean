/-!
# Homogeneous units of weighted polynomial rings and their localizations

Let `R` be a nontrivial commutative semiring, `σ` a variable type, and `w : σ → M` a weight
function into an additive commutative group `M`. Every unit of `MvPolynomial σ R` has invertible,
hence nonzero, constant coefficient in weight `0`, so any weighted-homogeneous unit must have
weight `0`: `homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥`, without any positivity
assumption on `w` or domain assumption on `R`. Consequently the shift class group of a weighted
polynomial ring is canonically `M`.

Now let `R` be an integral domain (more generally, a cancellative commutative semiring that is a
domain, so `MvPolynomial σ R` is a domain). Localizing `MvPolynomial σ R` away from a prime
polynomial `f` yields unit group `Rˣ × Multiplicative ℤ`, every unit having the form `C c * f ^ m`
with `c ∈ Rˣ` and `m ∈ ℤ`. When `f` is weighted homogeneous of weight `e`, the homogeneous unit
degrees of `awayGrading (weightedHomogeneousSubmodule R w) hf` are `AddSubgroup.zmultiples e`; for
`M = ℤ`, the shift class group is `ZMod |e|`. More generally, for a finite product
`f = ∏ j ∈ s, p j` of weighted-homogeneous primes `p j` of weights `d j`, the homogeneous unit
degrees are generated by `d '' s`.

## Main definitions

* `MvPolynomial.awayPrimeUnitsMulEquiv`: the unit group equivalence
  `Rˣ × Multiplicative ℤ ≃* Sˣ` for a localization `S` of `MvPolynomial σ R` away from a prime `f`.
* `MvPolynomial.awayProdPrimesUnitsMulEquiv`: the unit group equivalence
  `Rˣ × (s → Multiplicative ℤ) ≃* Sˣ` for a localization away from a product of pairwise
  non-associated primes in `MvPolynomial σ R`.
* `TauCeti.shiftClassGroupWeightedEquiv`: the equivalence
  `ShiftClassGroup (weightedHomogeneousSubmodule R w) ≃+ M`.
* `TauCeti.shiftClassGroupWeightedAwayPrimeEquiv`: the equivalence
  `ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hf) ≃+ ZMod e.natAbs` for
  integer weights.

## Main results

* `TauCeti.homogeneousUnitDegrees_weighted`: for any weights `w : σ → M` over a nontrivial
  commutative semiring `R`, `homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥`.
* `TauCeti.homogeneousUnitDegrees_away_prime`: localizing away from a weighted-homogeneous prime `f`
  of weight `e` gives `AddSubgroup.zmultiples e`.
* `TauCeti.homogeneousUnitDegrees_away_prod_primes`: localizing away from a finite product of
  weighted-homogeneous primes of weights `d j` gives `AddSubgroup.closure (d '' s)`.
-/

public section

namespace MvPolynomial

section AwayUnits

variable {σ R : Type*} [CommSemiring R] [IsCancelAdd R] [IsDomain R]

/-- Over a domain `R`, the units of a localization `S` of `MvPolynomial σ R` away from a prime
polynomial `f` are canonically `Rˣ × Multiplicative ℤ`, sending `(c, m)` to `C c * f ^ m`. -/
noncomputable def awayPrimeUnitsMulEquiv (S : Type*) [CommSemiring S]
    [Algebra (MvPolynomial σ R) S] {f : MvPolynomial σ R} (hprime : Prime f)
    [IsLocalization.Away f S] :
    Rˣ × Multiplicative ℤ ≃* Sˣ :=
  ((unitsMulEquivOfNoZeroDivisors σ R).prodCongr (MulEquiv.refl (Multiplicative ℤ))).trans
    (hprime.awayUnitsMulEquiv S)

@[simp]
theorem coe_awayPrimeUnitsMulEquiv_apply (S : Type*) [CommSemiring S]
    [Algebra (MvPolynomial σ R) S] {f : MvPolynomial σ R} (hprime : Prime f)
    [IsLocalization.Away f S] (c : Rˣ) (m : Multiplicative ℤ) :
    ((awayPrimeUnitsMulEquiv S hprime (c, m) : Sˣ) : S) =
      algebraMap (MvPolynomial σ R) S (C (c : R)) *
        ((TauCeti.Localization.awayUnit S f ^ m.toAdd : Sˣ) : S) := by
  have hprod :
      (unitsMulEquivOfNoZeroDivisors σ R).prodCongr (MulEquiv.refl (Multiplicative ℤ)) (c, m) =
        (unitsMulEquivOfNoZeroDivisors σ R c, m) :=
    rfl
  rw [awayPrimeUnitsMulEquiv, MulEquiv.trans_apply, hprod, hprime.coe_awayUnitsMulEquiv_apply,
    coe_unitsMulEquivOfNoZeroDivisors]

/-- Every unit of a localization `S` of `MvPolynomial σ R` away from a prime `f` has the form
`C c * f ^ m` with `c : Rˣ` and `m : ℤ`. -/
theorem isUnit_away_prime_iff {S : Type*} [CommSemiring S] [Algebra (MvPolynomial σ R) S]
    {f : MvPolynomial σ R} (hprime : Prime f) [IsLocalization.Away f S] {y : S} :
    IsUnit y ↔
      ∃ (c : Rˣ) (m : ℤ),
        algebraMap (MvPolynomial σ R) S (C (c : R)) *
            ((TauCeti.Localization.awayUnit S f ^ m : Sˣ) : S) = y := by
  rw [hprime.isUnit_away_iff (S := S)]
  refine ⟨fun ⟨u, m, hy⟩ ↦ ?_,
    fun ⟨c, m, hy⟩ ↦ ⟨unitsMulEquivOfNoZeroDivisors σ R c, m, by simpa using hy⟩⟩
  let c : Rˣ := (unitsMulEquivOfNoZeroDivisors σ R).symm u
  have hc := congrArg Units.val ((unitsMulEquivOfNoZeroDivisors σ R).apply_symm_apply u)
  rw [coe_unitsMulEquivOfNoZeroDivisors σ R c] at hc
  exact ⟨c, m, by rwa [hc]⟩

/-- Over a domain `R`, the units of a localization `S` of `MvPolynomial σ R` away from a product
`∏ j ∈ s, p j` of pairwise non-associated prime polynomials are canonically
`Rˣ × (s → Multiplicative ℤ)`. -/
noncomputable def awayProdPrimesUnitsMulEquiv {J : Type*} (S : Type*) [CommSemiring S]
    [Algebra (MvPolynomial σ R) S] (s : Finset J) {p : J → MvPolynomial σ R}
    (hp : ∀ j ∈ s, Prime (p j))
    (hs : (s : Set J).Pairwise fun i j ↦ ¬Associated (p i) (p j))
    [IsLocalization.Away (∏ j ∈ s, p j) S] :
    Rˣ × (s → Multiplicative ℤ) ≃* Sˣ :=
  ((unitsMulEquivOfNoZeroDivisors σ R).prodCongr
    (MulEquiv.refl (s → Multiplicative ℤ))).trans
    (TauCeti.Localization.awayUnitsMulEquivProdPrimes S s hp hs)

@[simp]
theorem coe_awayProdPrimesUnitsMulEquiv_apply {J : Type*} (S : Type*) [CommSemiring S]
    [Algebra (MvPolynomial σ R) S] (s : Finset J) {p : J → MvPolynomial σ R}
    (hp : ∀ j ∈ s, Prime (p j))
    (hs : (s : Set J).Pairwise fun i j ↦ ¬Associated (p i) (p j))
    [IsLocalization.Away (∏ j ∈ s, p j) S] (c : Rˣ) (m : s → Multiplicative ℤ) :
    ((awayProdPrimesUnitsMulEquiv S s hp hs (c, m) : Sˣ) : S) =
      algebraMap (MvPolynomial σ R) S (C (c : R)) *
        ((∏ j : s,
          TauCeti.Localization.awayUnitOfDvd S (Finset.dvd_prod_of_mem p j.2) ^
            (m j).toAdd : Sˣ) : S) := by
  have hprod :
      (unitsMulEquivOfNoZeroDivisors σ R).prodCongr (MulEquiv.refl (s → Multiplicative ℤ)) (c, m) =
        (unitsMulEquivOfNoZeroDivisors σ R c, m) :=
    rfl
  rw [awayProdPrimesUnitsMulEquiv, MulEquiv.trans_apply, hprod,
    TauCeti.Localization.awayUnitsMulEquivProdPrimes_apply, Units.val_mul, Units.coe_map,
    MonoidHom.coe_ofClass, coe_unitsMulEquivOfNoZeroDivisors]

end AwayUnits

end MvPolynomial

namespace TauCeti

open MvPolynomial TauCeti.GradedAlgebra

attribute [local instance] MvPolynomial.WeightedHomogeneousSubmodule.gradedMonoid
  MvPolynomial.weightedGradedAlgebra

section Weighted

variable {σ M R : Type*} [CommSemiring R] [Nontrivial R] [AddCommGroup M]

/-- For any weights `w : σ → M` on a multivariate polynomial ring over a nontrivial commutative
semiring `R`, the only degree of a weighted-homogeneous unit is `0`. -/
@[simp]
theorem homogeneousUnitDegrees_weighted (w : σ → M) :
    homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥ := by
  rw [eq_bot_iff, homogeneousUnitDegrees_le_iff]
  intro u d hu
  rw [mem_weightedHomogeneousSubmodule] at hu
  rw [AddSubgroup.mem_bot]
  -- The constant coefficient of a unit is a unit of `R`, hence nonzero of weight `0`.
  have h0 : (u : MvPolynomial σ R).coeff 0 ≠ 0 := (u.isUnit.map constantCoeff).ne_zero
  simpa using (hu h0).symm

/-- Because `homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥`, the shift class group
of a weighted polynomial ring over a nontrivial commutative semiring is canonically the weight
group `M`. -/
noncomputable def shiftClassGroupWeightedEquiv (w : σ → M) :
    ShiftClassGroup (weightedHomogeneousSubmodule R w) ≃+ M :=
  (QuotientAddGroup.quotientAddEquivOfEq (homogeneousUnitDegrees_weighted w)).trans
    QuotientAddGroup.quotientBot

@[simp]
theorem shiftClassGroupWeightedEquiv_mk (w : σ → M) (d : M) :
    shiftClassGroupWeightedEquiv (R := R) w (QuotientAddGroup.mk d) = d :=
  (rfl)

end Weighted

section AwayPrime

variable {σ M R : Type*} [CommSemiring R] [IsCancelAdd R] [IsDomain R] [AddCommGroup M]

/-- **Homogeneous unit degrees of a weighted polynomial ring localized at a prime.** Over a domain
`R`, inverting a prime weighted-homogeneous polynomial `f` of weight `e` produces homogeneous unit
degrees `AddSubgroup.zmultiples e`. -/
theorem homogeneousUnitDegrees_away_prime {w : σ → M} {f : MvPolynomial σ R} {e : M}
    (hf : f ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime f) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples e := by
  classical
  exact homogeneousUnitDegrees_awayGrading_of_prime_of_eq_bot hf hprime
    (homogeneousUnitDegrees_weighted w)

/-- **Homogeneous unit degrees of a weighted polynomial ring localized at a product of primes.**
Over a domain `R`, inverting a product `∏ j ∈ s, p j` of weighted-homogeneous primes `p j` of
weights `d j` produces the subgroup of `M` generated by `d '' s`. -/
theorem homogeneousUnitDegrees_away_prod_primes {J : Type*} {w : σ → M} {s : Finset J}
    {p : J → MvPolynomial σ R} {d : J → M} {e : M}
    (hp_mem : ∀ j ∈ s, p j ∈ weightedHomogeneousSubmodule R w (d j))
    (hp_prime : ∀ j ∈ s, Prime (p j))
    (hf : (∏ j ∈ s, p j) ∈ weightedHomogeneousSubmodule R w e) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.closure (d '' (s : Set J)) := by
  classical
  exact homogeneousUnitDegrees_awayGrading_prod_primes_of_eq_bot hp_mem hp_prime hf
    (homogeneousUnitDegrees_weighted w)

end AwayPrime

section IntWeights

variable {σ R : Type*} [CommSemiring R] [IsCancelAdd R] [IsDomain R]

/-- For integer weights `w : σ → ℤ` over a domain `R` and a weighted-homogeneous prime `f` of
weight `e`, the shift class group of `(MvPolynomial σ R)_f` is canonically `ZMod |e|`. -/
noncomputable def shiftClassGroupWeightedAwayPrimeEquiv {w : σ → ℤ}
    {f : MvPolynomial σ R} {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hprime : Prime f) :
    ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hf) ≃+ ZMod e.natAbs :=
  shiftClassGroupAwayPrimeEquiv hf hprime (homogeneousUnitDegrees_weighted w)

@[simp]
theorem shiftClassGroupWeightedAwayPrimeEquiv_mk {w : σ → ℤ}
    {f : MvPolynomial σ R} {e : ℤ} (hf : f ∈ weightedHomogeneousSubmodule R w e)
    (hprime : Prime f) (d : ℤ) :
    shiftClassGroupWeightedAwayPrimeEquiv hf hprime (QuotientAddGroup.mk d) = d :=
  shiftClassGroupAwayPrimeEquiv_mk hf hprime (homogeneousUnitDegrees_weighted w) d

end IntWeights

end TauCeti
