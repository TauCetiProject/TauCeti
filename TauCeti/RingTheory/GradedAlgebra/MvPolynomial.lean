module

public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import TauCeti.RingTheory.GradedAlgebra.Localization.Units

/-!
# Homogeneous unit degrees of weighted polynomial rings

Give the variables `σ` of `MvPolynomial σ R` arbitrary weights `w : σ → ι` in an additive abelian
group `ι`, inducing the grading `MvPolynomial.weightedHomogeneousSubmodule R w`. Because the
constant term homomorphism `MvPolynomial.constantCoeff` maps every unit of `MvPolynomial σ R` to a
unit of `R`, a weighted-homogeneous unit over a nontrivial commutative semiring `R` has a nonzero
constant coefficient and therefore degree `0`. Thus `homogeneousUnitDegrees` is `⊥` for every
choice of weights (no positivity assumption is needed), and `ShiftClassGroup` is `ι`.

Over a domain `R`, localizing `MvPolynomial σ R` away from a weighted-homogeneous prime `f` of
weight `e` yields `homogeneousUnitDegrees = AddSubgroup.zmultiples e`, and for `ι = ℤ` the shift
class group is `ZMod |e|`. More generally, localizing away from a finite product `∏ i ∈ s, p i` of
weighted-homogeneous primes of weights `e i` yields the subgroup generated by `e '' s`.

## Main definitions

* `TauCeti.shiftClassGroupWeightedEquiv`: the additive equivalence
  `ShiftClassGroup (MvPolynomial.weightedHomogeneousSubmodule R w) ≃+ ι`.
* `TauCeti.shiftClassGroupAwayPrimeEquiv`: for `w : σ → ℤ` and a weighted-homogeneous prime `f` of
  weight `e`, the additive equivalence
  `ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hf) ≃+ ZMod e.natAbs`.

## Main results

* `TauCeti.homogeneousUnitDegrees_weighted`: over any nontrivial commutative semiring and any
  weights `w : σ → ι`, the homogeneous unit degrees of `MvPolynomial σ R` are `⊥`.
* `TauCeti.homogeneousUnitDegrees_away_prod_prime`: inverting a product of weighted-homogeneous
  primes of weights `e i` yields `AddSubgroup.closure (e '' s)`.
* `TauCeti.homogeneousUnitDegrees_away_prime`: inverting a single weighted-homogeneous prime of
  weight `e` yields `AddSubgroup.zmultiples e`.
-/

public section

namespace TauCeti

open MvPolynomial TauCeti.GradedAlgebra

attribute [local instance] MvPolynomial.WeightedHomogeneousSubmodule.gradedMonoid

section Semiring

variable {σ ι R : Type*} [AddCommGroup ι] [CommSemiring R] [Nontrivial R]

/-- **Homogeneous unit degrees of a weighted polynomial ring.** Over any nontrivial commutative
semiring and any weights `w : σ → ι`, every weighted-homogeneous unit has a nonzero constant term
and therefore degree `0`. -/
@[simp]
theorem homogeneousUnitDegrees_weighted (w : σ → ι) :
    homogeneousUnitDegrees (weightedHomogeneousSubmodule R w) = ⊥ := by
  rw [eq_bot_iff, homogeneousUnitDegrees_le_iff]
  intro u d hu
  have h0 : (u : MvPolynomial σ R).coeff 0 ≠ 0 := by
    rw [← constantCoeff_eq]
    exact (u.isUnit.map (constantCoeff (σ := σ) (R := R))).ne_zero
  rw [AddSubgroup.mem_bot, ← hu h0, map_zero]

/-- For a weighted polynomial ring over a nontrivial commutative semiring, the shift class group is
the weight group `ι`. -/
noncomputable def shiftClassGroupWeightedEquiv (R : Type*) [CommSemiring R] [Nontrivial R]
    (w : σ → ι) : ShiftClassGroup (weightedHomogeneousSubmodule R w) ≃+ ι :=
  (QuotientAddGroup.quotientAddEquivOfEq (homogeneousUnitDegrees_weighted w)).trans
    QuotientAddGroup.quotientBot

/-- The identification of the shift class group of a weighted polynomial ring with `ι` sends the
class of `d` to `d`. -/
@[simp]
theorem shiftClassGroupWeightedEquiv_mk (R : Type*) [CommSemiring R] [Nontrivial R]
    (w : σ → ι) (d : ι) : shiftClassGroupWeightedEquiv R w d = d :=
  (rfl)

end Semiring

section Domain

variable {σ ι R : Type*} [AddCommGroup ι] [CommSemiring R] [IsCancelAdd R] [IsDomain R]

/-- Inverting a finite product of weighted-homogeneous primes `p i` of weights `e i` in a weighted
polynomial ring over a domain yields the subgroup of `ι` generated by `e '' s`. -/
theorem homogeneousUnitDegrees_away_prod_prime (w : σ → ι) {κ : Type*} {s : Finset κ}
    {p : κ → MvPolynomial σ R} {e : κ → ι} {f : MvPolynomial σ R} {d : ι}
    (hf : f ∈ weightedHomogeneousSubmodule R w d) (hf_eq : f = ∏ i ∈ s, p i)
    (hp : ∀ i ∈ s, Prime (p i)) (hmem : ∀ i ∈ s, p i ∈ weightedHomogeneousSubmodule R w (e i)) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.closure (e '' s) := by
  classical
  let : GradedAlgebra (weightedHomogeneousSubmodule R w) := weightedGradedAlgebra R w
  rw [homogeneousUnitDegrees_awayGrading_prod_prime (weightedHomogeneousSubmodule R w) hf hf_eq
    hp hmem, homogeneousUnitDegrees_weighted w, bot_sup_eq]

/-- **Inverting a weighted-homogeneous prime.** For any weights `w : σ → ι` and any
weighted-homogeneous prime `f` of weight `e` over a domain, the homogeneous unit degrees of
`Localization.Away f` are the multiples of `e`. -/
theorem homogeneousUnitDegrees_away_prime (w : σ → ι) {f : MvPolynomial σ R} {e : ι}
    (hf : f ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime f) :
    homogeneousUnitDegrees (awayGrading (weightedHomogeneousSubmodule R w) hf) =
      AddSubgroup.zmultiples e := by
  classical
  let : GradedAlgebra (weightedHomogeneousSubmodule R w) := weightedGradedAlgebra R w
  rw [homogeneousUnitDegrees_awayGrading_prime (weightedHomogeneousSubmodule R w) hf hprime,
    homogeneousUnitDegrees_weighted w, bot_sup_eq]

end Domain

section ShiftClassGroup

variable {σ R : Type*} [CommSemiring R] [IsCancelAdd R] [IsDomain R]

/-- Inverting a weighted-homogeneous prime `f` of `ℤ`-weight `e` in `MvPolynomial σ R` yields shift
class group `ZMod |e|`. -/
noncomputable def shiftClassGroupAwayPrimeEquiv (w : σ → ℤ) {f : MvPolynomial σ R} {e : ℤ}
    (hf : f ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime f) :
    ShiftClassGroup (awayGrading (weightedHomogeneousSubmodule R w) hf) ≃+ ZMod e.natAbs :=
  let : GradedAlgebra (weightedHomogeneousSubmodule R w) := weightedGradedAlgebra R w
  shiftClassGroupAwayGradingPrimeEquiv _ (homogeneousUnitDegrees_weighted w) hf hprime

/-- The identification of the shift class group of `Localization.Away f` with `ZMod |e|` sends the
class of a shift `d` to `d mod |e|`. -/
@[simp]
theorem shiftClassGroupAwayPrimeEquiv_mk (w : σ → ℤ) {f : MvPolynomial σ R} {e : ℤ}
    (hf : f ∈ weightedHomogeneousSubmodule R w e) (hprime : Prime f) (d : ℤ) :
    shiftClassGroupAwayPrimeEquiv w hf hprime d = d := by
  let : GradedAlgebra (weightedHomogeneousSubmodule R w) := weightedGradedAlgebra R w
  exact shiftClassGroupAwayGradingPrimeEquiv_mk _ (homogeneousUnitDegrees_weighted w) hf hprime d

end ShiftClassGroup

end TauCeti
