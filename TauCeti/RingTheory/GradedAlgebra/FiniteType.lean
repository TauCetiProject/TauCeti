module

public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.GradedAlgebra.Basic
public import Mathlib.RingTheory.Noetherian.Defs

/-!
# Finite generation of graded subalgebras with ideal contraction

Let `S` be a Noetherian `ℕ`-graded `k`-algebra whose degree-zero part consists of scalars, and let
`B` be a `k`-subalgebra of `S`. Suppose `B` contains the homogeneous components of its elements,
and that every ideal `J` of `B` is recovered from its extension: `J S ∩ B = J`. Then `B` is a
finitely generated `k`-algebra.

This is Hilbert's argument for the finite generation of rings of invariants. The ideal of `S`
generated by the positive-degree homogeneous elements of `B` is generated by finitely many of them,
`f₁, …, fᵣ`. A homogeneous element of `B` of positive degree `d` lies in this ideal, so by ideal
contraction it is a combination `∑ bᵢ fᵢ` with `bᵢ ∈ B`; keeping only the degree-`d` components,
the coefficients become homogeneous elements of `B` of degree smaller than `d`, and induction on
the degree shows that `B` is generated by `f₁, …, fᵣ`.

For the invariants of a linearly reductive group acting on a polynomial ring, ideal contraction is
supplied by exactness of invariants, in place of the Reynolds operator of the classical argument.

## Main results

* `Subalgebra.fg_of_decompose_mem_of_comap_map_le`: a subalgebra closed under homogeneous
  components and with ideal contraction is finitely generated.

## References

* D. Hilbert, *Über die Theorie der algebraischen Formen*, Math. Ann. **36** (1890).
* S. Mukai, *An Introduction to Invariants and Moduli*, Cambridge University Press (2003),
  Theorem 4.51.
-/

public section

open DirectSum

namespace Subalgebra

variable {k S : Type*} [CommSemiring k] [CommSemiring S] [Algebra k S] [IsNoetherianRing S]
  (𝒜 : ℕ → Submodule k S) [GradedAlgebra 𝒜]

/-- **Hilbert's finiteness argument.** In a Noetherian `ℕ`-graded algebra whose degree-zero part
consists of scalars, a subalgebra containing the homogeneous components of its elements, and
recovering each of its ideals from the ideal it generates, is finitely generated. -/
theorem fg_of_decompose_mem_of_comap_map_le (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra k S))
    (B : Subalgebra k S) (hBdecompose : ∀ x ∈ B, ∀ n, (decompose 𝒜 x n : S) ∈ B)
    (hBideal : ∀ J : Ideal B, (J.map (algebraMap B S)).comap (algebraMap B S) ≤ J) :
    B.FG := by
  classical
  -- Finitely many positive-degree homogeneous elements of `B` generate the ideal of `S` generated
  -- by all of them.
  let G : Set S := {x | x ∈ B ∧ ∃ n, 0 < n ∧ x ∈ 𝒜 n}
  obtain ⟨t, htG, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset G).1
    (IsNoetherian.noetherian (Ideal.span G))
  have htB (g : S) (hg : g ∈ t) : g ∈ B := (htG hg).1
  choose! deg hdeg using fun g (hg : g ∈ t) ↦ (htG hg).2
  -- The contraction of the ideal generated by `t`.
  let J : Ideal B := Ideal.span ((↑) ⁻¹' (t : Set S))
  have hJ : J.map (algebraMap B S) = Ideal.span (t : Set S) := by
    rw [Ideal.map_span]
    congr 1
    ext x
    exact ⟨fun ⟨y, hy, hyx⟩ ↦ hyx ▸ hy, fun hx ↦ ⟨⟨x, htB x hx⟩, hx, rfl⟩⟩
  -- Every homogeneous element of `B` lies in the subalgebra generated by `t`.
  have key (d : ℕ) : ∀ x ∈ B, x ∈ 𝒜 d → x ∈ Algebra.adjoin k (t : Set S) := by
    induction d using Nat.strong_induction_on with
    | _ d ih =>
    intro x hxB hxd
    rcases Nat.eq_zero_or_pos d with rfl | hd
    · exact (bot_le : (⊥ : Subalgebra k S) ≤ _) (h𝒜 x hxd)
    have hxJ : (⟨x, hxB⟩ : B) ∈ J := hBideal J (by
      rw [Ideal.mem_comap, hJ]
      exact (hspan ▸ Ideal.subset_span ⟨hxB, d, hd, hxd⟩ : x ∈ Submodule.span S (t : Set S)))
    obtain ⟨n, c, g, hcg⟩ := Submodule.mem_span_set'.1 hxJ
    have hx : x = ∑ i, (c i : S) * ((g i : B) : S) := by
      simpa using (congrArg Subtype.val hcg).symm
    -- Keep only the degree-`d` component of `∑ cᵢ gᵢ`.
    rw [← decompose_of_mem_same 𝒜 hxd, ← GradedAlgebra.proj_apply, hx, map_sum]
    refine Subalgebra.sum_mem _ fun i _ ↦ ?_
    have hgt : ((g i : B) : S) ∈ t := (g i).2
    obtain ⟨hpos, hmem⟩ := hdeg _ hgt
    rw [GradedAlgebra.proj_apply, coe_decompose_mul_of_right_mem 𝒜 d hmem]
    split_ifs with hle
    · exact Subalgebra.mul_mem _
        (ih _ (by omega) _ (hBdecompose _ (c i).2 _) (SetLike.coe_mem _))
        (Algebra.subset_adjoin hgt)
    · exact Subalgebra.zero_mem _
  refine Subalgebra.fg_def.2 ⟨t, t.finite_toSet,
    le_antisymm (Algebra.adjoin_le fun g hg ↦ htB g hg) fun x hx ↦ ?_⟩
  rw [← sum_support_decompose 𝒜 x]
  exact Subalgebra.sum_mem _ fun n _ ↦ key n _ (hBdecompose x hx n) (SetLike.coe_mem _)

end Subalgebra
