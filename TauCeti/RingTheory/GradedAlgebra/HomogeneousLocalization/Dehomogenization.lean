module

public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
public import TauCeti.RingTheory.GradedAlgebra.Homogeneous.Quotient
public import TauCeti.RingTheory.GradedAlgebra.HomogeneousLocalization.Basic
public import TauCeti.RingTheory.MvPolynomial.Dehomogenization
import Mathlib.RingTheory.MvPolynomial.Ideal
import TauCeti.RingTheory.MvPolynomial.Homogeneous

/-!
# Standard charts of the quotient of a polynomial ring by a homogeneous ideal

Let `I` be a homogeneous ideal of `R[X₀, …, Xₙ]`, graded by total degree, and let
`A = R[X₀, …, Xₙ] ⧸ I` with the induced grading (`HomogeneousIdeal.quotientGrading`). The
standard affine chart `D₊(Xᵢ)` of `Proj A` is the spectrum of the degree-zero part `A_(Xᵢ)` of the
localization of `A` away from the class of `Xᵢ`. This file identifies `A_(Xᵢ)` with the
dehomogenized ring

`R[Y₀, …, Yₙ₋₁] ⧸ I|_{Xᵢ = 1}`,

the quotient of the polynomial ring in the remaining coordinates by the image of `I` under
`TauCeti.dehomogenize i`, which sets `Xᵢ = 1` and renames the other coordinates in increasing
order. The fraction `p / Xᵢᵐ` corresponds to the class of `p` with `Xᵢ` set to `1`, and the
fraction `Xⱼ / Xᵢ` to the class of the corresponding coordinate. For a plane curve `G = 0` and
`i = 2`, the chart ring is `R[X, Y] ⧸ (G(X, Y, 1))`, the coordinate ring of the affine equation.

The classes of the coordinates generate the irrelevant ideal of `A`, so the charts `D₊(Xᵢ)` cover
`Proj A`, and `A` is of finite type over its degree-zero part. The degree-zero part is a quotient
of `R`, hence integral over `R`, which makes `Proj A` proper over `Spec R`.

## Main definitions

* `HomogeneousIdeal.awayEquivDehomogenize I i`: the isomorphism of `R`-algebras
  `A_(Xᵢ) ≃ₐ[R] R[Y₀, …, Yₙ₋₁] ⧸ I|_{Xᵢ = 1}`.

## Main results

* `HomogeneousIdeal.awayEquivDehomogenize_mk`: the isomorphism sends `p / Xᵢᵐ` to the class of
  `p` with `Xᵢ` set to `1`.
* `HomogeneousIdeal.awayEquivDehomogenize_symm_mk_X`: its inverse sends the class of the `j`-th
  remaining coordinate to `X_{i.succAbove j} / Xᵢ`.
* `HomogeneousIdeal.irrelevant_le_span_range_mk_X`: the irrelevant ideal of `A` lies in the ideal
  generated by the classes of the coordinates.
* `HomogeneousIdeal.surjective_algebraMap_quotientGrading_zero`: the degree-zero part of `A` is the
  image of `R`.

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Proposition II.2.5.
* W. Fulton, *Algebraic Curves*, Chapter 4, Section 3, for the dehomogenization of the ideal of a
  projective variety.
-/

public section

open MvPolynomial HomogeneousLocalization

attribute [local instance] MvPolynomial.gradedAlgebra

namespace HomogeneousIdeal

variable {R : Type*} [CommRing R] {n : ℕ}
  (I : HomogeneousIdeal (homogeneousSubmodule (Fin (n + 1)) R))

/-- The class of each coordinate `Xⱼ` has degree one. -/
theorem mk_X_mem_quotientGrading (j : Fin (n + 1)) :
    Ideal.Quotient.mk I.toIdeal (X j) ∈ I.quotientGrading 1 :=
  TauCeti.GradedAlgebra.mk_mem_quotientPiece _ _ (isHomogeneous_X R j)

/-- The degree-zero part of the quotient is the image of the constants. -/
theorem surjective_algebraMap_quotientGrading_zero :
    Function.Surjective (algebraMap R (I.quotientGrading 0)) := by
  intro x
  obtain ⟨p, hp, hpx⟩ := (TauCeti.GradedAlgebra.mem_quotientPiece_iff _ _).mp x.2
  rw [mem_homogeneousSubmodule, ← totalDegree_zero_iff_isHomogeneous,
    totalDegree_eq_zero_iff_eq_C] at hp
  refine ⟨p.coeff 0, Subtype.ext ?_⟩
  rw [← hpx, hp]
  simp [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (n + 1)) R)
    (MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal)]

/-- The degree-zero part of the quotient is integral over `R`, being the image of `R`. -/
instance : Algebra.IsIntegral R (I.quotientGrading 0) :=
  Algebra.isIntegral_of_surjective I.surjective_algebraMap_quotientGrading_zero

/-- The irrelevant ideal of the quotient lies in the ideal generated by the classes of the
coordinates, so the standard charts `D₊(Xⱼ)` cover its `Proj`. -/
theorem irrelevant_le_span_range_mk_X :
    (HomogeneousIdeal.irrelevant I.quotientGrading).toIdeal ≤
      Ideal.span (Set.range fun j ↦ Ideal.Quotient.mk I.toIdeal (X j)) := by
  rw [HomogeneousIdeal.irrelevant_eq_span, Ideal.span_le]
  intro x hx
  simp only [Set.mem_iUnion, SetLike.mem_coe] at hx
  obtain ⟨m, hm, hx⟩ := hx
  obtain ⟨q, hq, rfl⟩ := (TauCeti.GradedAlgebra.mem_quotientPiece_iff _ _).mp hx
  have hqX : q ∈ idealOfVars (Fin (n + 1)) R := by
    simpa only [pow_one] using (mem_pow_idealOfVars_iff 1 q).mpr fun s hs ↦ by
      rw [Finsupp.degree_eq_weight_one]
      exact (hq (mem_support_iff.mp hs)).symm ▸ hm
  have := Ideal.mem_map_of_mem (Ideal.Quotient.mk I.toIdeal) hqX
  rwa [idealOfVars, Ideal.map_span, ← Set.range_comp] at this

/-- The quotient is of finite type over its degree-zero part, being generated by the classes of
the coordinates even over `R`. -/
instance : Algebra.FiniteType (I.quotientGrading 0) (MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal) :=
  -- `R` acts on the quotient through the degree-zero part, by left multiplication.
  haveI : IsScalarTower R (I.quotientGrading 0) (MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal) :=
    ⟨fun r a x ↦ smul_mul_assoc r (a : MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal) x⟩
  .of_restrictScalars_finiteType R _ _

variable (i : Fin (n + 1))

/-- Dehomogenization at `Xᵢ` on the quotient: the map
`R[X₀, …, Xₙ] ⧸ I → R[Y₀, …, Yₙ₋₁] ⧸ I|_{Xᵢ = 1}` induced by `TauCeti.dehomogenize i`. -/
private noncomputable def quotientDehomogenize :
    MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal →ₐ[R]
      MvPolynomial (Fin n) R ⧸ I.toIdeal.map (TauCeti.dehomogenize i) :=
  Ideal.quotientMapₐ _ (TauCeti.dehomogenize i) Ideal.le_comap_map

private theorem quotientDehomogenize_mk (p : MvPolynomial (Fin (n + 1)) R) :
    I.quotientDehomogenize i (Ideal.Quotient.mk _ p) =
      Ideal.Quotient.mk _ (TauCeti.dehomogenize i p) :=
  (rfl)

private theorem isUnit_quotientDehomogenize_mk_X_self :
    IsUnit (I.quotientDehomogenize i (Ideal.Quotient.mk _ (X i))) := by
  rw [quotientDehomogenize_mk, TauCeti.dehomogenize_X, Fin.insertNth_apply_same, map_one]
  exact isUnit_one

/-- Dehomogenization on the chart: `a / Xᵢᵐ ↦ a|_{Xᵢ = 1}`. -/
private noncomputable def awayToDehomogenize :
    Away I.quotientGrading (Ideal.Quotient.mk I.toIdeal (X i)) →+*
      MvPolynomial (Fin n) R ⧸ I.toIdeal.map (TauCeti.dehomogenize i) :=
  Away.lift I.quotientGrading (I.quotientDehomogenize i).toRingHom
    (I.isUnit_quotientDehomogenize_mk_X_self i)

private theorem awayToDehomogenize_mk {m : ℕ} {a : MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal}
    (ha : a ∈ I.quotientGrading (m • 1)) :
    I.awayToDehomogenize i (Away.mk I.quotientGrading (I.mk_X_mem_quotientGrading i) m a ha) =
      I.quotientDehomogenize i a := by
  have hu : (I.isUnit_quotientDehomogenize_mk_X_self i).unit = 1 :=
    Units.ext ((I.quotientDehomogenize_mk i _).trans (by simp))
  rw [awayToDehomogenize, Away.lift_mk, hu, one_pow, inv_one, Units.val_one, mul_one,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe]

private theorem awayToDehomogenize_algebraMap (r : R) :
    I.awayToDehomogenize i (algebraMap R _ r) = algebraMap R _ r := by
  -- the algebra map of `A_(Xᵢ)` factors through the degree-zero part of the quotient
  refine (Away.lift_algebraMap _ _ (algebraMap R (I.quotientGrading 0) r)).trans ?_
  rw [SetLike.GradeZero.coe_algebraMap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes]

/-- The fraction `Xⱼ / Xᵢ` in `A_(Xᵢ)`. -/
private noncomputable def awayCoord (j : Fin (n + 1)) :
    Away I.quotientGrading (Ideal.Quotient.mk I.toIdeal (X i)) :=
  Away.mk I.quotientGrading (I.mk_X_mem_quotientGrading i) 1 (Ideal.Quotient.mk _ (X j))
    (by simpa using I.mk_X_mem_quotientGrading j)

private theorem awayCoord_self : I.awayCoord i i = 1 := by
  apply val_injective
  rw [awayCoord, Away.val_mk, val_one, Localization.mk_eq_mk', IsLocalization.mk'_eq_iff_eq_mul]
  simp

/-- Evaluating a homogeneous polynomial `p` of degree `m` at the fractions `Xⱼ / Xᵢ` gives the
fraction `p / Xᵢᵐ`. -/
private theorem aeval_awayCoord {m : ℕ} {p : MvPolynomial (Fin (n + 1)) R}
    (hp : p ∈ homogeneousSubmodule (Fin (n + 1)) R m) :
    aeval (I.awayCoord i) p =
      Away.mk I.quotientGrading (I.mk_X_mem_quotientGrading i) m (Ideal.Quotient.mk _ p)
        (by simpa using TauCeti.GradedAlgebra.mk_mem_quotientPiece _ I.toIdeal hp) := by
  apply val_injective
  let L := Localization.Away (Ideal.Quotient.mk I.toIdeal (X i))
  -- the inverse of `Xᵢ` in the full localization
  let a : L := Localization.mk 1 ⟨Ideal.Quotient.mk I.toIdeal (X i), 1, pow_one _⟩
  have hcoord : (algebraMap (Away I.quotientGrading (Ideal.Quotient.mk I.toIdeal (X i))) L) ∘
      I.awayCoord i = fun j ↦ a * ((algebraMap (MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal) L) ∘
        fun j ↦ Ideal.Quotient.mk I.toIdeal (X j)) j := by
    ext j
    rw [Function.comp_apply, HomogeneousLocalization.algebraMap_apply, awayCoord, Away.val_mk,
      Function.comp_apply, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul]
    congr 1 <;> simp
  have hbase : (algebraMap (Away I.quotientGrading (Ideal.Quotient.mk I.toIdeal (X i))) L).comp
      (algebraMap R _) = (algebraMap (MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal) L).comp
        (algebraMap R _) :=
    (IsScalarTower.algebraMap_eq R _ L).symm.trans (IsScalarTower.algebraMap_eq R _ L)
  have hmk : eval₂ (algebraMap R _) (fun j ↦ Ideal.Quotient.mk I.toIdeal (X j)) p =
      Ideal.Quotient.mk _ p :=
    -- `Ideal.Quotient.mkₐ` is `Ideal.Quotient.mk` as an algebra map, determined by the variables
    (DFunLike.congr_fun (aeval_unique (Ideal.Quotient.mkₐ R I.toIdeal)) p).symm
  rw [aeval_def, ← HomogeneousLocalization.algebraMap_apply, eval₂_comp_left, hbase, hcoord,
    ((mem_homogeneousSubmodule m p).mp hp).eval₂_const_mul, ← eval₂_comp_left, hmk, Away.val_mk,
    ← Localization.mk_one_eq_algebraMap, Localization.mk_pow, Localization.mk_mul]
  congr 1
  · simp
  · exact Subtype.ext (by simp)

/-- Inserting `Xᵢ / Xᵢ = 1` among the fractions `Xⱼ / Xᵢ`, `j ≠ i`, gives all the fractions. -/
private theorem insertNth_awayCoord_comp_succAbove :
    i.insertNth 1 (I.awayCoord i ∘ i.succAbove) = I.awayCoord i :=
  Fin.insertNth_eq_iff.mpr ⟨(I.awayCoord_self i).symm, rfl⟩

/-- Evaluating the dehomogenization of a polynomial `p` at the fractions `Xⱼ / Xᵢ`, `j ≠ i`, is
evaluating `p` at all the fractions `Xⱼ / Xᵢ`, since `Xᵢ / Xᵢ = 1`. -/
private theorem aeval_awayCoord_succAbove_dehomogenize (p : MvPolynomial (Fin (n + 1)) R) :
    aeval (I.awayCoord i ∘ i.succAbove) (TauCeti.dehomogenize i p) = aeval (I.awayCoord i) p := by
  rw [TauCeti.aeval_dehomogenize, insertNth_awayCoord_comp_succAbove]

/-- Every element of `I` vanishes at the fractions `Xⱼ / Xᵢ`: each homogeneous component of it
lies in `I` and gives the fraction `0 / Xᵢᵐ`. -/
private theorem aeval_awayCoord_eq_zero {p : MvPolynomial (Fin (n + 1)) R} (hp : p ∈ I.toIdeal) :
    aeval (I.awayCoord i) p = 0 := by
  rw [← sum_homogeneousComponent p, map_sum]
  refine Finset.sum_eq_zero fun m _ ↦ ?_
  rw [I.aeval_awayCoord i (homogeneousComponent_mem m p)]
  apply val_injective
  rw [Away.val_mk, val_zero, Ideal.Quotient.eq_zero_iff_mem.mpr
    (homogeneousComponent_mem_of_mem I.isHomogeneous hp m), Localization.mk_zero]

/-- Homogenization: `R[Y₀, …, Yₙ₋₁] ⧸ I|_{Xᵢ = 1} → A_(Xᵢ)`, sending the `j`-th coordinate to
`X_{i.succAbove j} / Xᵢ`. -/
private noncomputable def dehomogenizeToAway :
    (MvPolynomial (Fin n) R ⧸ I.toIdeal.map (TauCeti.dehomogenize i)) →ₐ[R]
      Away I.quotientGrading (Ideal.Quotient.mk I.toIdeal (X i)) :=
  Ideal.Quotient.liftₐ _ (aeval (I.awayCoord i ∘ i.succAbove)) fun p hp ↦ by
    have : I.toIdeal ≤ (RingHom.ker (aeval (I.awayCoord i ∘ i.succAbove))).comap
        (TauCeti.dehomogenize i) := fun q hq ↦ by
      rw [Ideal.mem_comap, RingHom.mem_ker, aeval_awayCoord_succAbove_dehomogenize]
      exact I.aeval_awayCoord_eq_zero i hq
    exact (Ideal.map_le_iff_le_comap.mpr this) hp

private theorem dehomogenizeToAway_mk (p : MvPolynomial (Fin n) R) :
    I.dehomogenizeToAway i (Ideal.Quotient.mk _ p) = aeval (I.awayCoord i ∘ i.succAbove) p :=
  Ideal.Quotient.liftₐ_apply _ _ _ _

private theorem awayToDehomogenize_comp_dehomogenizeToAway :
    (I.awayToDehomogenize i).comp (I.dehomogenizeToAway i).toRingHom = RingHom.id _ := by
  refine Ideal.Quotient.ringHom_ext (MvPolynomial.ringHom_ext (fun r ↦ ?_) fun j ↦ ?_)
  · simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [dehomogenizeToAway_mk, aeval_C, awayToDehomogenize_algebraMap, ← MvPolynomial.algebraMap_eq,
      Ideal.Quotient.mk_algebraMap]
  · simp [dehomogenizeToAway_mk, awayCoord, awayToDehomogenize_mk, quotientDehomogenize_mk]

private theorem dehomogenizeToAway_comp_awayToDehomogenize :
    (I.dehomogenizeToAway i).toRingHom.comp (I.awayToDehomogenize i) = RingHom.id _ := by
  ext z
  obtain ⟨m, a, ha, rfl⟩ := Away.mk_surjective I.quotientGrading (I.mk_X_mem_quotientGrading i) z
  obtain ⟨p, hp, rfl⟩ := (TauCeti.GradedAlgebra.mem_quotientPiece_iff _ _).mp ha
  rw [smul_eq_mul, mul_one] at hp
  rw [RingHom.comp_apply, awayToDehomogenize_mk, quotientDehomogenize_mk, AlgHom.toRingHom_eq_coe,
    RingHom.coe_coe, dehomogenizeToAway_mk, aeval_awayCoord_succAbove_dehomogenize,
    I.aeval_awayCoord i hp, RingHom.id_apply]

/-- **The standard chart `D₊(Xᵢ)`.** The degree-zero part `A_(Xᵢ)` of the localization of
`A = R[X₀, …, Xₙ] ⧸ I` away from the class of `Xᵢ` is the dehomogenized ring
`R[Y₀, …, Yₙ₋₁] ⧸ I|_{Xᵢ = 1}`, the image of `I` under `TauCeti.dehomogenize i`. -/
noncomputable def awayEquivDehomogenize :
    Away I.quotientGrading (Ideal.Quotient.mk I.toIdeal (X i)) ≃ₐ[R]
      MvPolynomial (Fin n) R ⧸ I.toIdeal.map (TauCeti.dehomogenize i) :=
  (AlgEquiv.ofAlgHom (I.dehomogenizeToAway i)
    { I.awayToDehomogenize i with commutes' := I.awayToDehomogenize_algebraMap i }
    (AlgHom.ext fun z ↦ congr($(I.dehomogenizeToAway_comp_awayToDehomogenize i) z))
    (AlgHom.ext fun z ↦ congr($(I.awayToDehomogenize_comp_dehomogenizeToAway i) z))).symm

/-- `awayEquivDehomogenize` sends the fraction `p / Xᵢᵐ` to the class of `p` with `Xᵢ` set to
`1`. -/
@[simp]
theorem awayEquivDehomogenize_mk {m : ℕ} {p : MvPolynomial (Fin (n + 1)) R}
    (hp : Ideal.Quotient.mk I.toIdeal p ∈ I.quotientGrading (m • 1)) :
    I.awayEquivDehomogenize i
        (Away.mk I.quotientGrading (I.mk_X_mem_quotientGrading i) m _ hp) =
      Ideal.Quotient.mk _ (TauCeti.dehomogenize i p) :=
  I.awayToDehomogenize_mk i hp

/-- The inverse of `awayEquivDehomogenize` sends the class of the `j`-th remaining coordinate to
the fraction `X_{i.succAbove j} / Xᵢ`. -/
@[simp]
theorem awayEquivDehomogenize_symm_mk_X (j : Fin n) :
    (I.awayEquivDehomogenize i).symm (Ideal.Quotient.mk _ (X j)) =
      Away.mk I.quotientGrading (I.mk_X_mem_quotientGrading i) 1
        (Ideal.Quotient.mk _ (X (i.succAbove j)))
        (by simpa using I.mk_X_mem_quotientGrading (i.succAbove j)) :=
  (I.dehomogenizeToAway_mk i (X j)).trans (aeval_X _ _)

end HomogeneousIdeal
