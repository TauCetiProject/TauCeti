/-!
# Graded supercommutativity from algebra generators

In an internally `ι`-graded `R`-algebra `A` generated by the image of a degree-`0` linear map
`g : V →ₗ[R] A` from a spanned `ι`-graded module `(V, 𝒱)`, scalar-twisted commutation relations
between homogeneous generators propagate to all homogeneous elements of `A`.

Specifically, if `M` is a monoid acting compatibly on `A` and `s : ι → ι → M` is biadditive into
the multiplication of `M` (for instance `s p q = (-1) ^ (p * q)` over `ℤ` or `ZMod 2`), then
`g x * g y = s i j • (g y * g x)` for all `x ∈ 𝒱 i` and `y ∈ 𝒱 j` implies
`a * b = s i j • (b * a)` for all `a ∈ 𝒜 i` and `b ∈ 𝒜 j`. This unifies the supercommutativity
proofs for `TauCeti.SignedSym` and `TauCeti.ParitySignedSym` without requiring `A` to be a ring or
`ι` to be commutative.

## Main results

* `TauCeti.mul_eq_smul_mul_right_of_adjoin_range_eq_top`: scalar-twisted commutation of an element
  `a : A` with homogeneous generators extends to all homogeneous right factors.
* `TauCeti.mul_eq_smul_mul_left_of_adjoin_range_eq_top`: scalar-twisted commutation of homogeneous
  generators with an element `b : A` extends to all homogeneous left factors.
* `TauCeti.mul_eq_smul_mul_of_adjoin_range_eq_top`: biadditive scalar-twisted commutation on
  homogeneous generators extends to all pairs of homogeneous elements.

## References

* J. Pardon, *Contact homology and virtual fundamental cycles*, equation (1.1), for graded Koszul
  commutation relations in free supercommutative algebras.
-/

public section

namespace TauCeti

section Supercommutativity

variable {R A M ι V : Type*} [CommSemiring R] [Semiring A] [Algebra R A]
  [DecidableEq ι] [AddMonoid ι] {𝒜 : ι → Submodule R A} [GradedAlgebra 𝒜]
  [Monoid M] [DistribMulAction M A] [IsScalarTower M A A] [SMulCommClass M A A]
  [SMulCommClass R M A] [AddCommMonoid V] [Module R V] {𝒱 : ι → Submodule R V}

/-- If `a : A` satisfies `a * g y = c j • (g y * a)` for every homogeneous generator `y ∈ 𝒱 j`,
where `g : V →ₗ[R] A` is degree-`0` with algebra-generating image, `𝒱` spans `V`, and `c : ι → M`
is multiplicative, then `a * b = c j • (b * a)` for every `b ∈ 𝒜 j`. -/
theorem mul_eq_smul_mul_right_of_adjoin_range_eq_top {a : A} {c : ι → M}
    (hc0 : c 0 = 1) (hc : ∀ j₁ j₂, c (j₁ + j₂) = c j₁ * c j₂)
    {g : V →ₗ[R] A} (hadj : Algebra.adjoin R (Set.range g) = ⊤) (h𝒱 : ⨆ i, 𝒱 i = ⊤)
    (hg : LinearMap.IsHomogeneous g 𝒱 𝒜 0)
    (hcomm : ∀ {j : ι} {y : V}, y ∈ 𝒱 j → a * g y = c j • (g y * a))
    {j : ι} {b : A} (hb : b ∈ 𝒜 j) :
    a * b = c j • (b * a) := by
  let ℬ : ι → Submodule R A := fun k ↦
    { carrier := {b : A | a * b = c k • (b * a)}
      add_mem' := fun {b₁ b₂} hb₁ hb₂ ↦ by
        simp only [Set.mem_ofPred_eq] at hb₁ hb₂ ⊢
        rw [mul_add, add_mul, smul_add, hb₁, hb₂]
      zero_mem' := by simp
      smul_mem' := fun r {b} hb ↦ by
        simp only [Set.mem_ofPred_eq] at hb ⊢
        rw [Algebra.mul_smul_comm, Algebra.smul_mul_assoc, hb, smul_comm] }
  have hmem : ∀ {k b}, b ∈ ℬ k ↔ a * b = c k • (b * a) := fun {_ _} ↦ by simp [ℬ]
  exact hmem.1 <| GradedAlgebra.grade_le_of_adjoin_range_eq_top 𝒜 (ℬ := ℬ)
    (hmem.2 (by simp [hc0]))
    (fun {_ _ _ _} _ hb₁ _ hb₂ ↦ hmem.2 <| by
      rw [hc]
      exact mul_mul_eq_smul_of_mul_eq_smul_right (hmem.1 hb₁) (hmem.1 hb₂))
    hadj h𝒱 (fun hx ↦ by simpa only [add_zero] using hg.map_mem hx)
    (fun hx ↦ hmem.2 (hcomm hx)) j hb

/-- If `b : A` satisfies `g x * b = c i • (b * g x)` for every homogeneous generator `x ∈ 𝒱 i`,
where `g : V →ₗ[R] A` is degree-`0` with algebra-generating image, `𝒱` spans `V`, and `c : ι → M`
satisfies `c (i₁ + i₂) = c i₂ * c i₁`, then `a * b = c i • (b * a)` for every `a ∈ 𝒜 i`. -/
theorem mul_eq_smul_mul_left_of_adjoin_range_eq_top {b : A} {c : ι → M}
    (hc0 : c 0 = 1) (hc : ∀ i₁ i₂, c (i₁ + i₂) = c i₂ * c i₁)
    {g : V →ₗ[R] A} (hadj : Algebra.adjoin R (Set.range g) = ⊤) (h𝒱 : ⨆ i, 𝒱 i = ⊤)
    (hg : LinearMap.IsHomogeneous g 𝒱 𝒜 0)
    (hcomm : ∀ {i : ι} {x : V}, x ∈ 𝒱 i → g x * b = c i • (b * g x))
    {i : ι} {a : A} (ha : a ∈ 𝒜 i) :
    a * b = c i • (b * a) := by
  let ℬ : ι → Submodule R A := fun k ↦
    { carrier := {a : A | a * b = c k • (b * a)}
      add_mem' := fun {a₁ a₂} ha₁ ha₂ ↦ by
        simp only [Set.mem_ofPred_eq] at ha₁ ha₂ ⊢
        rw [add_mul, mul_add, smul_add, ha₁, ha₂]
      zero_mem' := by simp
      smul_mem' := fun r {a} ha ↦ by
        simp only [Set.mem_ofPred_eq] at ha ⊢
        rw [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, ha, smul_comm] }
  have hmem : ∀ {k a}, a ∈ ℬ k ↔ a * b = c k • (b * a) := fun {_ _} ↦ by simp [ℬ]
  exact hmem.1 <| GradedAlgebra.grade_le_of_adjoin_range_eq_top 𝒜 (ℬ := ℬ)
    (hmem.2 (by simp [hc0]))
    (fun {_ _ _ _} _ ha₁ _ ha₂ ↦ hmem.2 <| by
      rw [hc]
      exact mul_mul_eq_smul_of_mul_eq_smul_left (hmem.1 ha₁) (hmem.1 ha₂))
    hadj h𝒱 (fun hx ↦ by simpa only [add_zero] using hg.map_mem hx)
    (fun hx ↦ hmem.2 (hcomm hx)) i ha

/-- **Graded supercommutativity from generators.** If a degree-`0` linear map `g : V →ₗ[R] A` has
algebra-generating image, `𝒱` spans `V`, and homogeneous generators obey
`g x * g y = s i j • (g y * g x)` for a biadditive commutation factor `s : ι → ι → M`, then
`a * b = s i j • (b * a)` for all `a ∈ 𝒜 i` and `b ∈ 𝒜 j`. -/
theorem mul_eq_smul_mul_of_adjoin_range_eq_top {s : ι → ι → M}
    (hs_zero_right : ∀ i, s i 0 = 1)
    (hs_add_right : ∀ i j₁ j₂, s i (j₁ + j₂) = s i j₁ * s i j₂)
    (hs_zero_left : ∀ j, s 0 j = 1)
    (hs_add_left : ∀ i₁ i₂ j, s (i₁ + i₂) j = s i₂ j * s i₁ j)
    {g : V →ₗ[R] A} (hadj : Algebra.adjoin R (Set.range g) = ⊤) (h𝒱 : ⨆ i, 𝒱 i = ⊤)
    (hg : LinearMap.IsHomogeneous g 𝒱 𝒜 0)
    (hcomm : ∀ {i j : ι} {x y : V}, x ∈ 𝒱 i → y ∈ 𝒱 j → g x * g y = s i j • (g y * g x))
    {i j : ι} {a b : A} (ha : a ∈ 𝒜 i) (hb : b ∈ 𝒜 j) :
    a * b = s i j • (b * a) :=
  mul_eq_smul_mul_left_of_adjoin_range_eq_top (𝒜 := 𝒜) (hs_zero_left j)
    (fun i₁ i₂ ↦ hs_add_left i₁ i₂ j) hadj h𝒱 hg
    (fun {i' _} hx ↦ mul_eq_smul_mul_right_of_adjoin_range_eq_top (𝒜 := 𝒜) (hs_zero_right i')
      (hs_add_right i') hadj h𝒱 hg (fun hy ↦ hcomm hx hy) hb)
    ha

end Supercommutativity

end TauCeti
