/-!
# Hilbert series of graded polynomial algebras

Let `A = ⨁ₙ 𝒜 n` be an `ℕ`-graded algebra over a commutative ring `R`, and let `f i ∈ 𝒜 (d i)`
be homogeneous elements such that `R[Xᵢ] → A`, `Xᵢ ↦ f i`, is bijective: `A` is a polynomial
algebra on the homogeneous generators `f i`. Giving the variable `Xᵢ` the weight `d i`, this
evaluation is an isomorphism of graded algebras, so the degree-`n` piece `𝒜 n` is the image of the
weighted homogeneous polynomials of weight `n`, and it is free on the monomials `∏ᵢ Xᵢ ^ e i` with
`∑ᵢ e i * d i = n`. When the generators are finitely many, of positive degrees, the Hilbert series
of `A` is therefore

`∑ₙ rank (𝒜 n) tⁿ = ∏ᵢ (1 - t ^ d i)⁻¹`

(`PowerSeries.mk_natCard_weight_mul_prod_one_sub_X_pow`). Since this product determines the
multiset of the positive integers `d i` (`Multiset.eq_of_prod_map_one_sub_X_pow_eq`), the
multiset of degrees of a homogeneous polynomial generating system does not depend on the system:
the generators of such a presentation are not canonical, but their degrees are. For a connected
grading (`𝒜 0` is the scalars) the degrees of such generators are automatically positive.

The main example is the algebra of invariant polynomials of a finite group generated by
pseudoreflections, whose homogeneous polynomial generators are its basic invariants; their degrees
are the degrees of the group.

## Main results

* `TauCeti.GradedAlgebra.aeval_weightedHomogeneousComponent`: evaluation at homogeneous elements
  carries weighted homogeneous components to homogeneous components.
* `TauCeti.GradedAlgebra.map_aeval_weightedHomogeneousSubmodule`: the weighted homogeneous
  polynomials of weight `n` map onto `𝒜 n` under a surjective evaluation at homogeneous elements.
* `TauCeti.GradedAlgebra.finrank_eq_natCard_weight`: for a polynomial presentation,
  `Module.finrank (𝒜 n)` equals `Nat.card` of the exponent vectors of weight `n`; when there are
  infinitely many such vectors both sides are `0`.
* `TauCeti.GradedAlgebra.ne_zero_of_injective_aeval`: in a connected graded algebra, algebraically
  independent homogeneous elements have positive degrees.
* `TauCeti.GradedAlgebra.mk_finrank_mul_prod_one_sub_X_pow`: the Hilbert series of a graded
  polynomial algebra on generators of positive degrees `d i` is `∏ᵢ (1 - t ^ d i)⁻¹`.
* `TauCeti.GradedAlgebra.map_univ_eq_of_bijective_aeval`: any two homogeneous polynomial
  generating systems of positive degrees have the same multiset of degrees.

## References

* R. P. Stanley, *Invariants of finite groups and their applications to combinatorics*,
  Bull. Amer. Math. Soc. (N.S.) **1** (1979), 475–511, Section 3.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  Section 3.7.
-/

public section

open MvPolynomial

namespace TauCeti.GradedAlgebra

variable {R A ι : Type*} [CommRing R] [CommRing A] [Algebra R A] (𝒜 : ℕ → Submodule R A)
  [GradedAlgebra 𝒜] {f : ι → A} {d : ι → ℕ}

/-- **Evaluation at homogeneous elements is graded.** If `f i ∈ 𝒜 (d i)`, then evaluating at `f`
the weighted homogeneous component of weight `n` of a polynomial `φ`, for the weights `d`, gives
the degree-`n` component of the evaluation of `φ`. -/
theorem aeval_weightedHomogeneousComponent (hf : ∀ i, f i ∈ 𝒜 (d i)) (φ : MvPolynomial ι R)
    (n : ℕ) :
    aeval f (weightedHomogeneousComponent d n φ) = DirectSum.decompose 𝒜 (aeval f φ) n := by
  classical
  -- Evaluation is a homomorphism of graded algebras for the weighted grading.
  let := weightedGradedAlgebra R d
  let F : weightedHomogeneousSubmodule R d →ₐᵍ[R] 𝒜 :=
    ⟨aeval f, fun hφ ↦ (mem_weightedHomogeneousSubmodule ..).1 hφ |>.aeval_mem hf⟩
  calc aeval f (weightedHomogeneousComponent d n φ)
      = F (DirectSum.decompose (weightedHomogeneousSubmodule R d) φ n) := by
        -- `DirectSum.decompose` unfolds to the `decompose'` field of `weightedDecomposition`.
        rw [← weightedDecomposition.decompose'_apply]
        rfl
    _ = DirectSum.decompose 𝒜 (F φ) n :=
      map_directSumDecompose (weightedHomogeneousSubmodule R d) 𝒜 F

/-- If evaluation at homogeneous elements `f i ∈ 𝒜 (d i)` is surjective, it maps the polynomials
that are weighted homogeneous of weight `n` for the weights `d` onto `𝒜 n`. -/
theorem map_aeval_weightedHomogeneousSubmodule (hf : ∀ i, f i ∈ 𝒜 (d i))
    (hsurj : Function.Surjective (aeval (R := R) f)) (n : ℕ) :
    (weightedHomogeneousSubmodule R d n).map (aeval f).toLinearMap = 𝒜 n := by
  refine le_antisymm (Submodule.map_le_iff_le_comap.2 fun φ hφ ↦ hφ.aeval_mem hf) fun x hx ↦ ?_
  -- The weight-`n` component of a preimage of `x` maps to the degree-`n` component of `x`.
  obtain ⟨φ, rfl⟩ := hsurj x
  exact ⟨weightedHomogeneousComponent d n φ, weightedHomogeneousComponent_mem d φ n,
    (aeval_weightedHomogeneousComponent 𝒜 hf φ n).trans (DirectSum.decompose_of_mem_same 𝒜 hx)⟩

/-- **Dimensions of a graded polynomial algebra.** If evaluation at homogeneous elements
`f i ∈ 𝒜 (d i)` is bijective, then `Module.finrank (𝒜 n)` equals `Nat.card` of the exponent
vectors `e` of weight `∑ᵢ e i * d i = n`. When there are infinitely many such vectors, `𝒜 n` has
an infinite basis and both sides are `0`. -/
theorem finrank_eq_natCard_weight [Nontrivial R] (hf : ∀ i, f i ∈ 𝒜 (d i))
    (hbij : Function.Bijective (aeval (R := R) f)) (n : ℕ) :
    Module.finrank R (𝒜 n) = Nat.card {e : ι →₀ ℕ // Finsupp.weight d e = n} := by
  rw [← map_aeval_weightedHomogeneousSubmodule 𝒜 hf hbij.2,
    ← (Submodule.equivMapOfInjective _ hbij.1 _).finrank_eq,
    weightedHomogeneousSubmodule_eq_finsupp_supported,
    (AddMonoidAlgebra.supportedEquivFinsupp _).finrank_eq,
    Module.finrank_eq_nat_card_basis (Finsupp.basisSingleOne)]
  -- The coercion of `{e | weight d e = n}` to a type is the subtype `{e // weight d e = n}`.
  rfl

omit [GradedAlgebra 𝒜] in
/-- **Generators of a connected graded algebra have positive degrees.** If the degree-zero part of
`A` consists of scalars, then a homogeneous element of degree zero is not algebraically independent
of the others: if evaluation at `f i ∈ 𝒜 (d i)` is injective, every `d i` is nonzero. -/
theorem ne_zero_of_injective_aeval [Nontrivial R] (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra R A))
    (hf : ∀ i, f i ∈ 𝒜 (d i)) (hinj : Function.Injective (aeval (R := R) f)) (i : ι) :
    d i ≠ 0 := by
  intro hi
  obtain ⟨r, hr⟩ := Algebra.mem_bot.1 (h𝒜 _ (hi ▸ hf i))
  have h : X i = C r := hinj (by rw [aeval_X, aeval_C, hr])
  classical
  simpa [coeff_X, coeff_C, eq_comm (a := (0 : ι →₀ ℕ))] using
    congrArg (fun p : MvPolynomial ι R ↦ p.coeff (Finsupp.single i 1)) h

variable [Fintype ι]

/-- **The Hilbert series of a graded polynomial algebra.** If evaluation at homogeneous elements
`f i ∈ 𝒜 (d i)` of positive degrees is bijective, the Hilbert series `∑ₙ rank (𝒜 n) tⁿ` of `A`
(with coefficients cast into any commutative ring `S`) is the inverse of `∏ᵢ (1 - t ^ d i)`. -/
theorem mk_finrank_mul_prod_one_sub_X_pow [Nontrivial R] (S : Type*) [CommRing S]
    (hf : ∀ i, f i ∈ 𝒜 (d i)) (hbij : Function.Bijective (aeval (R := R) f))
    (hd : ∀ i, d i ≠ 0) :
    PowerSeries.mk (fun n ↦ (Module.finrank R (𝒜 n) : S)) *
      ∏ i, (1 - PowerSeries.X ^ d i) = 1 := by
  simp_rw [finrank_eq_natCard_weight 𝒜 hf hbij]
  exact PowerSeries.mk_natCard_weight_mul_prod_one_sub_X_pow hd

/-- **The degrees of a graded polynomial algebra are intrinsic.** If `A` is a polynomial algebra
on homogeneous generators `f i ∈ 𝒜 (d i)` and also on homogeneous generators `f' j ∈ 𝒜 (d' j)`,
all of positive degree, then the two families have the same multiset of degrees. -/
theorem map_univ_eq_of_bijective_aeval [Nontrivial R] {κ : Type*} [Fintype κ] {f' : κ → A}
    {d' : κ → ℕ} (hf : ∀ i, f i ∈ 𝒜 (d i)) (hbij : Function.Bijective (aeval (R := R) f))
    (hd : ∀ i, d i ≠ 0) (hf' : ∀ j, f' j ∈ 𝒜 (d' j))
    (hbij' : Function.Bijective (aeval (R := R) f')) (hd' : ∀ j, d' j ≠ 0) :
    Finset.univ.val.map d = Finset.univ.val.map d' :=
  Multiset.map_univ_eq_of_natCard_weight_eq hd hd' fun n ↦ by
    rw [← finrank_eq_natCard_weight 𝒜 hf hbij, finrank_eq_natCard_weight 𝒜 hf' hbij']

end TauCeti.GradedAlgebra
