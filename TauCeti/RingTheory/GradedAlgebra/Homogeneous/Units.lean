/-!
# Homogeneous units of a graded ring and shift classes

Let `A` be a ring graded by an additive group `ι`, with grading `𝒜`. The degrees of the
homogeneous units of `A` form a subgroup `homogeneousUnitDegrees 𝒜` of `ι`, and the quotient
`ShiftClassGroup 𝒜` classifies the shifts `A(d)` of the graded `A`-module `A` up to graded
isomorphism. Here `A(d)` is `A` with the grading `n ↦ 𝒜 (n + d)`.

For `ι = ℤ`, a `ℤ`-grading of a commutative ring `A` is a `𝔾_m`-action on `Spec A`, and `A(d)` is
the module of sections of the trivial line bundle twisted by the character `t ↦ t ^ d`. The shift
class group is then the group of such twisted trivial line bundles up to equivariant isomorphism.

More generally, a second grading `ℳ` of `A`, compatible with `𝒜` in the sense that
`𝒜 i • ℳ j ≤ ℳ (i + j)`, makes `A` a graded `A`-module. If `ℳ` has a homogeneous generator, a unit
`u ∈ ℳ c`, then multiplication by `u` identifies `ℳ` with the shift `A(-c)`; conversely every
grading graded-isomorphic to a shift has such a generator.

## Main definitions

* `TauCeti.homogeneousUnitDegrees 𝒜`: the subgroup of `ι` generated by the degrees of the
  homogeneous units.
* `TauCeti.ShiftClassGroup 𝒜`: the quotient of `ι` by `homogeneousUnitDegrees 𝒜`.

## Main results

* `Units.val_inv_mem_graded`: the inverse of a homogeneous unit of degree `d` is homogeneous of
  degree `-d`.
* `TauCeti.mem_homogeneousUnitDegrees_iff`: a degree lies in `homogeneousUnitDegrees 𝒜` if and
  only if it is the degree of a homogeneous unit.
* `TauCeti.mul_mem_iff_of_isUnit_mem` and `TauCeti.eq_map_mulLeft_of_isUnit_mem`: a compatible
  grading `ℳ` with a unit `u ∈ ℳ c` is the image of the shift `A(-c)` under multiplication by `u`.
* `TauCeti.exists_linearEquiv_iff_exists_isUnit_mem`: a compatible grading is graded-isomorphic to
  the shift `A(d)` if and only if it has a unit in degree `-d`.
* `TauCeti.sub_mem_homogeneousUnitDegrees_iff` and `TauCeti.ShiftClassGroup.mk_eq_mk_iff`: the
  shifts `A(d)` and `A(e)` are graded-isomorphic if and only if `d - e ∈ homogeneousUnitDegrees 𝒜`.

The group-algebra and Laurent-polynomial examples, `TauCeti.homogeneousUnitDegrees_gradeBy` and
`TauCeti.shiftClassGroupLaurentPolynomialEquiv`, are in `TauCeti.Algebra.MonoidAlgebra.Grading`
and `TauCeti.Algebra.Polynomial.Laurent.Units`.

-/

public section

open DirectSum

section Inverse

variable {ι A σ : Type*} [DecidableEq ι] [AddGroup ι] [Semiring A] [SetLike σ A]
  [AddSubmonoidClass σ A] {𝒜 : ι → σ} [GradedRing 𝒜]

/-- In a ring graded by an additive group, the inverse of a homogeneous unit of degree `d` is
homogeneous of degree `-d`. -/
theorem Units.val_inv_mem_graded (u : Aˣ) {d : ι} (hu : (u : A) ∈ 𝒜 d) :
    ((u⁻¹ : Aˣ) : A) ∈ 𝒜 (-d) :=
  TauCeti.GradedAlgebra.mem_of_mul_mem_add_of_isLeftRegular 𝒜 hu u.isRegular.left
    (by rw [Units.mul_inv, add_neg_cancel]; exact SetLike.one_mem_graded 𝒜)

end Inverse

namespace TauCeti

section Degrees

variable {ι A σ : Type*} [AddGroup ι] [Monoid A] [SetLike σ A]

/-- The degrees of the homogeneous units of a graded ring: the subgroup of the degree group
generated by the degrees `d` such that some unit lies in `𝒜 d`. For a grading by a group, every
element of this subgroup is itself the degree of a homogeneous unit
(`mem_homogeneousUnitDegrees_iff`). -/
def homogeneousUnitDegrees (𝒜 : ι → σ) : AddSubgroup ι :=
  AddSubgroup.closure {d | ∃ u : Aˣ, (u : A) ∈ 𝒜 d}

variable {𝒜 : ι → σ}

/-- The degree of a homogeneous unit lies in `homogeneousUnitDegrees 𝒜`. -/
theorem mem_homogeneousUnitDegrees_of_mem {u : Aˣ} {d : ι} (hu : (u : A) ∈ 𝒜 d) :
    d ∈ homogeneousUnitDegrees 𝒜 :=
  AddSubgroup.subset_closure ⟨u, hu⟩

/-- `homogeneousUnitDegrees 𝒜` is the smallest subgroup containing the degree of every
homogeneous unit. -/
theorem homogeneousUnitDegrees_le_iff {H : AddSubgroup ι} :
    homogeneousUnitDegrees 𝒜 ≤ H ↔ ∀ (u : Aˣ) (d : ι), (u : A) ∈ 𝒜 d → d ∈ H := by
  rw [homogeneousUnitDegrees, AddSubgroup.closure_le]
  exact ⟨fun h u d hu ↦ h ⟨u, hu⟩, fun h d ⟨u, hu⟩ ↦ h u d hu⟩

end Degrees

section GradedRing

variable {ι A σ : Type*} [DecidableEq ι] [AddGroup ι] [Semiring A] [SetLike σ A]
  [AddSubmonoidClass σ A] {𝒜 : ι → σ}

omit [DecidableEq ι] in
/-- Over the zero ring every degree is the degree of a homogeneous unit, since `1 = 0` lies in
every graded piece. -/
@[simp]
theorem homogeneousUnitDegrees_eq_top_of_subsingleton [Subsingleton A] :
    homogeneousUnitDegrees 𝒜 = ⊤ :=
  eq_top_iff.mpr fun d _ ↦
    mem_homogeneousUnitDegrees_of_mem (u := 1) <| by
      rw [Units.val_one, ← Subsingleton.elim (0 : A) 1]
      exact zero_mem (𝒜 d)

variable [GradedRing 𝒜]

/-- In a ring graded by an additive group, a degree lies in `homogeneousUnitDegrees 𝒜` if and only
if it is the degree of a homogeneous unit: products and inverses of homogeneous units are
homogeneous units, so the generating set is already a subgroup. -/
theorem mem_homogeneousUnitDegrees_iff {d : ι} :
    d ∈ homogeneousUnitDegrees 𝒜 ↔ ∃ u : Aˣ, (u : A) ∈ 𝒜 d := by
  refine ⟨fun h ↦ ?_, fun ⟨u, hu⟩ ↦ mem_homogeneousUnitDegrees_of_mem hu⟩
  induction h using AddSubgroup.closure_induction with
  | mem _ hd => exact hd
  | zero => exact ⟨1, SetLike.one_mem_graded 𝒜⟩
  | add d e _ _ hd he =>
    obtain ⟨u, hu⟩ := hd
    obtain ⟨v, hv⟩ := he
    exact ⟨u * v, by simpa using SetLike.mul_mem_graded hu hv⟩
  | neg d _ hd =>
    obtain ⟨u, hu⟩ := hd
    exact ⟨u⁻¹, u.val_inv_mem_graded hu⟩

end GradedRing

/-- The shift classes of a graded ring: the degree group modulo the degrees of the homogeneous
units. The shifts `A(d)` and `A(e)` of the graded module `A` are graded-isomorphic exactly when
`d` and `e` have the same class (`ShiftClassGroup.mk_eq_mk_iff`). -/
abbrev ShiftClassGroup {ι A σ : Type*} [AddCommGroup ι] [Monoid A] [SetLike σ A] (𝒜 : ι → σ) :
    Type _ :=
  ι ⧸ homogeneousUnitDegrees 𝒜

section Shift

variable {ι A σ σM : Type*} [DecidableEq ι] [Semiring A] [SetLike σ A] [AddSubmonoidClass σ A]
  [SetLike σM A]

section AddGroup

variable [AddGroup ι] (𝒜 : ι → σ) [GradedRing 𝒜] (ℳ : ι → σM)

/-- **Shift classification.** Let `ℳ` be a grading of `A`, viewed as a graded module over `A`
graded by `𝒜`, with a homogeneous generator: a unit `u ∈ ℳ c`. Then `x * u ∈ ℳ n` if and only if
`x ∈ 𝒜 (n - c)`, so that multiplication by `u` carries the shift `A(-c)` isomorphically onto `ℳ`. -/
theorem mul_mem_iff_of_isUnit_mem [AddSubmonoidClass σM A] [Decomposition ℳ]
    [SetLike.GradedSMul 𝒜 ℳ] {u : A} (hu : IsUnit u) {c : ι} (hmem : u ∈ ℳ c) {n : ι} {x : A} :
    x * u ∈ ℳ n ↔ x ∈ 𝒜 (n - c) := by
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · -- The degree-`n` part of `x * u` for `ℳ` is the degree-`(n - c)` part of `x` for `𝒜`,
    -- multiplied by `u`; cancelling the unit `u` identifies `x` with that homogeneous part.
    have h := DirectSum.coe_decompose_smul_add_of_right_mem 𝒜 ℳ (a := x) (i := n - c) hmem
    rw [smul_eq_mul, sub_add_cancel, decompose_of_mem_same ℳ hx, smul_eq_mul,
      hu.isRegular.right.eq_iff] at h
    exact h ▸ (decompose 𝒜 x (n - c)).2
  · simpa using SetLike.GradedSMul.smul_mem (B := ℳ) hx hmem

/-- Linear form of the shift classification: a grading `ℳ` of `A` compatible with `𝒜` with a
homogeneous unit `u ∈ ℳ c` is the image of the shift `A(-c)` under multiplication by `u`. -/
theorem exists_linearEquiv_of_isUnit_mem [AddSubmonoidClass σM A] [Decomposition ℳ]
    [SetLike.GradedSMul 𝒜 ℳ] {u : A} (hu : IsUnit u) {c : ι} (hmem : u ∈ ℳ c) :
    ∃ φ : A ≃ₗ[A] A, ∀ n x, φ x ∈ ℳ n ↔ x ∈ 𝒜 (n - c) := by
  obtain ⟨v, rfl⟩ := hu
  exact ⟨v.mulRightLinearEquiv A, fun n x ↦ mul_mem_iff_of_isUnit_mem 𝒜 ℳ v.isUnit hmem⟩

variable {𝒜 ℳ}

/-- A graded isomorphism from a shift `A(d)` onto a grading `ℳ` of `A` sends `1` to a homogeneous
generator of `ℳ`: a unit of degree `-d`. -/
theorem _root_.LinearEquiv.isUnit_apply_one_and_apply_one_mem {d : ι} (φ : A ≃ₗ[A] A)
    (hφ : ∀ n x, φ x ∈ ℳ n ↔ x ∈ 𝒜 (n + d)) : IsUnit (φ 1) ∧ φ 1 ∈ ℳ (-d) := by
  -- `Module.End A A ≃+* Aᵐᵒᵖ` sends an endomorphism to its value at `1`.
  refine ⟨(((Module.End.isUnit_iff φ.toLinearMap).2 φ.bijective).map
    (RingEquiv.moduleEndSelf A).symm).unop, (hφ _ _).mpr ?_⟩
  rw [neg_add_cancel]
  exact SetLike.one_mem_graded 𝒜

variable (𝒜 ℳ)

/-- A grading `ℳ` of `A` compatible with `𝒜` is graded-isomorphic to the shift `A(d)`, whose
degree-`n` piece is `𝒜 (n + d)`, if and only if it has a homogeneous generator of degree `-d`: a
unit lying in `ℳ (-d)`. -/
theorem exists_linearEquiv_iff_exists_isUnit_mem [AddSubmonoidClass σM A] [Decomposition ℳ]
    [SetLike.GradedSMul 𝒜 ℳ] {d : ι} :
    (∃ φ : A ≃ₗ[A] A, ∀ n x, φ x ∈ ℳ n ↔ x ∈ 𝒜 (n + d)) ↔ ∃ u : A, IsUnit u ∧ u ∈ ℳ (-d) := by
  refine ⟨fun ⟨φ, hφ⟩ ↦ ⟨φ 1, φ.isUnit_apply_one_and_apply_one_mem hφ⟩, fun ⟨u, hu, hmem⟩ ↦ ?_⟩
  obtain ⟨φ, hφ⟩ := exists_linearEquiv_of_isUnit_mem 𝒜 ℳ hu hmem
  exact ⟨φ, fun n x ↦ by rw [hφ, sub_neg_eq_add]⟩

end AddGroup

section AddCommGroup

variable [AddCommGroup ι] (𝒜 : ι → σ) [GradedRing 𝒜]

/-- **Classification of shifts.** The shifts `A(d)` and `A(e)` of the graded module `A`, with
degree-`n` pieces `𝒜 (n + d)` and `𝒜 (n + e)`, are graded-isomorphic if and only if `d - e` is
the degree of a homogeneous unit. -/
theorem sub_mem_homogeneousUnitDegrees_iff {d e : ι} :
    d - e ∈ homogeneousUnitDegrees 𝒜 ↔
      ∃ φ : A ≃ₗ[A] A, ∀ n x, φ x ∈ 𝒜 (n + e) ↔ x ∈ 𝒜 (n + d) := by
  refine ⟨fun h ↦ ?_, fun ⟨φ, hφ⟩ ↦ ?_⟩
  · -- Multiplication by a unit of degree `e - d` carries `A(d)` onto `A(e)`.
    obtain ⟨u, hu⟩ := mem_homogeneousUnitDegrees_iff.mp (neg_mem h)
    rw [neg_sub] at hu
    obtain ⟨φ, hφ⟩ := exists_linearEquiv_of_isUnit_mem 𝒜 𝒜 u.isUnit hu
    exact ⟨φ, fun n x ↦ by rw [hφ (n + e), show n + e - (e - d) = n + d by abel]⟩
  · -- The image of `1` is a unit of degree `e - d`.
    obtain ⟨hu, hmem⟩ := φ.isUnit_apply_one_and_apply_one_mem (ℳ := fun n ↦ 𝒜 (n + e)) hφ
    rw [← neg_mem_iff, neg_sub]
    exact mem_homogeneousUnitDegrees_of_mem (u := hu.unit) (by simpa [neg_add_eq_sub] using hmem)

/-- The shifts `A(d)` and `A(e)` are graded-isomorphic exactly when `d` and `e` have the same
shift class. -/
theorem ShiftClassGroup.mk_eq_mk_iff {d e : ι} :
    (d : ShiftClassGroup 𝒜) = e ↔ ∃ φ : A ≃ₗ[A] A, ∀ n x, φ x ∈ 𝒜 (n + e) ↔ x ∈ 𝒜 (n + d) := by
  rw [QuotientAddGroup.eq, ← sub_mem_homogeneousUnitDegrees_iff, ← neg_mem_iff, neg_add_rev,
    neg_neg, neg_add_eq_sub]

end AddCommGroup

end Shift

section Commutative

variable {ι R A : Type*} [DecidableEq ι] [AddGroup ι] [CommSemiring R] [CommSemiring A]
  [Algebra R A] (𝒜 ℳ : ι → Submodule R A) [GradedAlgebra 𝒜] [Decomposition ℳ]
  [SetLike.GradedSMul 𝒜 ℳ]

/-- **Shift classification**, submodule form. If a grading `ℳ` of a commutative algebra `A`,
compatible with the grading `𝒜`, has a homogeneous unit `u ∈ ℳ c`, then `ℳ n = u • 𝒜 (n - c)` for
every `n`: the graded module `(A, ℳ)` is the shift `A(-c)`. -/
theorem eq_map_mulLeft_of_isUnit_mem {u : A} (hu : IsUnit u) {c : ι} (hmem : u ∈ ℳ c) (n : ι) :
    ℳ n = (𝒜 (n - c)).map (LinearMap.mulLeft R u) := by
  ext x
  rw [Submodule.mem_map]
  constructor
  · intro hx
    obtain ⟨v, rfl⟩ := hu
    refine ⟨x * ↑v⁻¹, (mul_mem_iff_of_isUnit_mem 𝒜 ℳ v.isUnit hmem).mp ?_, ?_⟩
    · simpa using hx
    · simp [mul_left_comm]
  · rintro ⟨a, ha, rfl⟩
    rw [LinearMap.mulLeft_apply, mul_comm]
    exact (mul_mem_iff_of_isUnit_mem 𝒜 ℳ hu hmem).mpr ha

end Commutative

end TauCeti
