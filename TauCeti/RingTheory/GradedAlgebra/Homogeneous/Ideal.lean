module

public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-!
# Homogeneous left ideals generated by a degree-zero element

The left ideal `Ae` generated by an element `e` of degree zero in a graded ring is homogeneous.
This is the homogeneity witness for the left ideal `Af` generated by a degree-zero idempotent `f`,
which `TauCeti.GradedModuleCat.ofIdeal` turns into a projective graded module.

## Main results

* `Ideal.isHomogeneous_span_singleton_of_mem_zero`: the left ideal generated by an element of
  degree zero is homogeneous.
-/

public section

namespace Ideal

variable {ι σ A : Type*} [Semiring A] [DecidableEq ι] [AddMonoid ι] [SetLike σ A]
  [AddSubmonoidClass σ A] (𝒜 : ι → σ) [GradedRing 𝒜]

/-- The left ideal generated by an element of degree zero is homogeneous. This is the homogeneity
witness for `Af` at a degree-zero idempotent `f`. -/
theorem isHomogeneous_span_singleton_of_mem_zero {e : A} (he₀ : e ∈ 𝒜 0) :
    (Ideal.span {e}).IsHomogeneous 𝒜 :=
  Ideal.homogeneous_span 𝒜 _ fun _ hx => ⟨0, (Set.mem_singleton_iff.1 hx) ▸ he₀⟩

end Ideal
