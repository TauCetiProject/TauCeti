module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Field.Equiv

/-!
# Homogeneous ideals: generators and componentwise absorption

The left ideal `Ae` generated by a homogeneous element `e` of a graded ring is homogeneous.
This is the homogeneity witness for the left ideal `Af` generated by a degree-zero idempotent `f`,
which `TauCeti.GradedModuleCat.ofIdeal` turns into a projective graded module.

This file also proves the absorption lemmas for componentwise membership: if every homogeneous
component of `x` lies in an ideal, then so does every homogeneous component of `a * x`, and, when
the ideal is two-sided, of `x * a`.

Finally, in a connected `ℕ`-graded algebra, whose degree-zero part consists of the scalars, every
element is its constant term plus an element of the irrelevant ideal. So the scalars map onto
`A ⧸ A₊`, and over a field the irrelevant ideal is maximal.

## Main results

* `Ideal.isHomogeneous_span_singleton`: the left ideal generated by a homogeneous element is
  homogeneous.
* `Ideal.proj_mul_mem_left` and `Ideal.proj_mul_mem_right`: the absorption lemmas. The right one
  asks the ideal to be two-sided, through `Ideal.IsTwoSided`.
* `TauCeti.GradedAlgebra.exists_sub_algebraMap_mem_irrelevant`: in a connected graded algebra
  every element is a scalar plus an element of the irrelevant ideal.
* `TauCeti.GradedAlgebra.surjective_algebraMap_quotient_irrelevant`: in a connected graded algebra
  the scalars map onto `A ⧸ A₊`.
* `TauCeti.GradedAlgebra.isMaximal_toIdeal_irrelevant`: the irrelevant ideal of a nontrivial
  connected graded algebra over a field is maximal.

## Implementation notes

Mathlib's `Ideal.mul_homogeneous_element_mem_of_mem` supplies the homogeneous case of
`Ideal.proj_mul_mem_left`, where the homogeneous factor is on the right. Its mirror image
`Ideal.homogeneous_element_mul_mem_of_mem`, with the homogeneous factor on the left, is the one
place two-sidedness is used.

## References

The proof of `Ideal.homogeneous_element_mul_mem_of_mem` is adapted from Mathlib's proof of
`Ideal.mul_homogeneous_element_mem_of_mem`, with the two factors swapped.
-/

public section

open DirectSum

namespace Ideal

variable {ι σ A : Type*} [Semiring A] [DecidableEq ι] [AddMonoid ι] [SetLike σ A]
  [AddSubmonoidClass σ A] (𝒜 : ι → σ) [GradedRing 𝒜]

/-- The left ideal generated by a homogeneous element is homogeneous. This is the homogeneity
witness for `Af` at a degree-zero idempotent `f`. -/
theorem isHomogeneous_span_singleton {e : A} (he : SetLike.IsHomogeneousElem 𝒜 e) :
    (Ideal.span {e}).IsHomogeneous 𝒜 :=
  Ideal.homogeneous_span 𝒜 _ fun _ hx => (Set.mem_singleton_iff.1 hx) ▸ he

variable {I : Ideal A}

/-- **Left absorption of componentwise membership**: if every homogeneous component of `x` lies in
an ideal, so does every homogeneous component of `a * x`. -/
theorem proj_mul_mem_left {x : A} (hx : ∀ i, GradedRing.proj 𝒜 i x ∈ I) (a : A) (j : ι) :
    GradedRing.proj 𝒜 j (a * x) ∈ I := by
  classical
  rw [← sum_support_decompose 𝒜 x, Finset.mul_sum, map_sum]
  refine I.sum_mem fun l _ => mul_homogeneous_element_mem_of_mem 𝒜 a _ ⟨l, SetLike.coe_mem _⟩ ?_ j
  simpa only [GradedRing.proj_apply] using hx l

/-- The homogeneous components of `x * a`, for `x` a homogeneous element of a two-sided ideal,
lie in that ideal. This is the mirror image of `Ideal.mul_homogeneous_element_mem_of_mem`. -/
theorem homogeneous_element_mul_mem_of_mem [I.IsTwoSided] {x : A}
    (hx : SetLike.IsHomogeneousElem 𝒜 x) (hxI : x ∈ I) (a : A) (j : ι) :
    GradedRing.proj 𝒜 j (x * a) ∈ I := by
  classical
  rw [← sum_support_decompose 𝒜 a, Finset.mul_sum, map_sum]
  refine I.sum_mem fun l _ => ?_
  obtain ⟨i, hi⟩ := hx
  rw [GradedRing.proj_apply, decompose_of_mem 𝒜 (SetLike.GradedMul.mul_mem hi (SetLike.coe_mem _)),
    coe_of_apply]
  split_ifs
  · exact I.mul_mem_right _ hxI
  · exact I.zero_mem

/-- **Right absorption of componentwise membership**: if every homogeneous component of `x` lies in
a two-sided ideal, so does every homogeneous component of `x * a`. -/
theorem proj_mul_mem_right [I.IsTwoSided] {x : A} (hx : ∀ i, GradedRing.proj 𝒜 i x ∈ I) (a : A)
    (j : ι) : GradedRing.proj 𝒜 j (x * a) ∈ I := by
  classical
  rw [← sum_support_decompose 𝒜 x, Finset.sum_mul, map_sum]
  refine I.sum_mem fun l _ => homogeneous_element_mul_mem_of_mem 𝒜 ⟨l, SetLike.coe_mem _⟩ ?_ a j
  simpa only [GradedRing.proj_apply] using hx l

end Ideal

namespace TauCeti.GradedAlgebra

open HomogeneousIdeal

/-- In a connected graded algebra, whose degree-zero part consists of the scalars, every element
is a scalar plus an element of the irrelevant ideal. -/
theorem exists_sub_algebraMap_mem_irrelevant {R A : Type*} [CommSemiring R] [CommRing A]
    [Algebra R A] (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
    (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra R A)) (a : A) :
    ∃ c : R, a - algebraMap R A c ∈ irrelevant 𝒜 := by
  obtain ⟨c, hc⟩ := Algebra.mem_bot.1 (h𝒜 _ (decompose 𝒜 a 0).2)
  refine ⟨c, ?_⟩
  rw [mem_irrelevant_iff, map_sub, hc, GradedRing.proj_apply,
    GradedRing.proj_apply, decompose_of_mem_same 𝒜 (decompose 𝒜 a 0).2, sub_self]

/-- In a connected graded algebra the scalars map onto `A ⧸ A₊`: every element is its constant
term modulo `A₊`. -/
theorem surjective_algebraMap_quotient_irrelevant {R A : Type*} [CommSemiring R] [CommRing A]
    [Algebra R A] (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
    (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra R A)) :
    Function.Surjective (algebraMap R (A ⧸ (irrelevant 𝒜).toIdeal)) := by
  intro y
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨c, hc⟩ := exists_sub_algebraMap_mem_irrelevant 𝒜 h𝒜 a
  exact ⟨c, (Ideal.Quotient.eq.2 hc).symm⟩

/-- The irrelevant ideal of a nontrivial connected graded algebra over a field is maximal, since
the quotient `A ⧸ A₊` is the field `k`. -/
theorem isMaximal_toIdeal_irrelevant {k A : Type*} [Field k] [CommRing A] [Nontrivial A]
    [Algebra k A] (𝒜 : ℕ → Submodule k A) [GradedAlgebra 𝒜]
    (h𝒜 : ∀ x ∈ 𝒜 0, x ∈ (⊥ : Subalgebra k A)) :
    (irrelevant 𝒜).toIdeal.IsMaximal := by
  -- `1` has degree-zero component `1 ≠ 0`, so `A₊ ≠ ⊤` and `A ⧸ A₊` is nontrivial.
  have hne : (irrelevant 𝒜).toIdeal ≠ ⊤ := fun h ↦ by
    have h1 : (1 : A) ∈ irrelevant 𝒜 := by
      rw [← HomogeneousIdeal.mem_iff, h]
      exact Submodule.mem_top
    rw [mem_irrelevant_iff, GradedRing.proj_apply,
      decompose_of_mem_same 𝒜 SetLike.GradedOne.one_mem] at h1
    exact one_ne_zero h1
  have := Ideal.Quotient.nontrivial_iff.2 hne
  exact Ideal.Quotient.maximal_of_isField _ <| MulEquiv.isField (Field.toIsField k)
    (RingEquiv.ofBijective (algebraMap k (A ⧸ (irrelevant 𝒜).toIdeal))
      ⟨(algebraMap k _).injective,
        surjective_algebraMap_quotient_irrelevant 𝒜 h𝒜⟩).symm.toMulEquiv

end TauCeti.GradedAlgebra
