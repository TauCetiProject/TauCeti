module

public import Mathlib.Algebra.Algebra.Operations
public import Mathlib.Algebra.DirectSum.Decomposition
public import Mathlib.RingTheory.FiniteType

/-!
# Finite generation from an eventual recurrence on a direct-sum decomposition

Let `A` be an `R`-algebra with an `ℕ`-indexed direct-sum decomposition into `R`-submodules
and `B` an `R`-subalgebra of `A`. Suppose that, from some index `N` onward, every piece
satisfies `Aₙ₊₁ ⊆ B · Aₙ`. Then the pieces of indices at most `N` span `A` as a `B`-module.
Multiplication need not respect the decomposition. If the sum of these pieces is a finite
`R`-module, `A` is a finite `B`-module. If a submodule `U` gives the recurrence and its sum
with the initial pieces is finite over `R`, then `A` is of finite type over `R`.

For section rings of divisors on curves, a function pencil gives the recurrence with `B`
the subalgebra generated by the two sections of the pencil. The result here converts that
recurrence into finite generation without requiring generation in degree one, or imposing
a Noetherian hypothesis on the whole section ring.
-/

public section

namespace TauCeti.GradedAlgebra

open DirectSum

variable {R A : Type*} [CommSemiring R]

section Semiring

variable [Semiring A] [Algebra R A]
    (𝒜 : ℕ → Submodule R A) [DirectSum.Decomposition 𝒜] (B : Subalgebra R A) (N : ℕ)

/-- If every piece above index `N` is obtained from the preceding one by multiplication
with elements of `B`, the pieces of indices at most `N` span the whole algebra over `B`. -/
theorem span_eq_top_of_le_mul
    (hstep : ∀ n, N ≤ n → 𝒜 (n + 1) ≤ B.toSubmodule * 𝒜 n) :
    Submodule.span B (↑(⨆ i : Fin (N + 1), 𝒜 i) : Set A) = ⊤ := by
  classical
  let M := Submodule.span B (↑(⨆ i : Fin (N + 1), 𝒜 i) : Set A)
  have hpiece (n : ℕ) : 𝒜 n ≤ M.restrictScalars R := by
    induction n using Nat.strong_induction_on with
    | h n ih =>
      by_cases hn : n ≤ N
      · intro x hx
        exact Submodule.subset_span ((le_iSup (fun i : Fin (N + 1) ↦ 𝒜 i)
          ⟨n, by omega⟩) hx)
      · have hn0 : n ≠ 0 := by omega
        obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn0
        refine (hstep m (by omega)).trans ?_
        apply Submodule.mul_le.mpr
        intro b hb x hx
        exact M.smul_mem (⟨b, hb⟩ : B) (ih m (by omega) hx)
  apply top_unique
  intro x _
  rw [← sum_support_decompose 𝒜 x]
  exact Submodule.sum_mem _ fun n _ ↦ hpiece n (SetLike.coe_mem _)

/-- An eventual recurrence `Aₙ₊₁ ⊆ B · Aₙ` makes the decomposed algebra finite over `B`,
provided the sum of its pieces of indices at most the recurrence threshold is finite over `R`. -/
theorem finite_of_le_mul
    (hfinite : (⨆ i : Fin (N + 1), 𝒜 i).FG)
    (hstep : ∀ n, N ≤ n → 𝒜 (n + 1) ≤ B.toSubmodule * 𝒜 n) :
    Module.Finite B A := by
  apply Module.Finite.of_fg_top
  rw [← span_eq_top_of_le_mul 𝒜 B N hstep]
  exact hfinite.span

end Semiring

variable [Semiring A] [Algebra R A]
    (𝒜 : ℕ → Submodule R A) [DirectSum.Decomposition 𝒜] (N : ℕ)

/-- An eventual recurrence `Aₙ₊₁ ⊆ U · Aₙ` makes the whole decomposed algebra of finite type,
provided the sum of `U` and the initial pieces is finite over `R`.
The multiplying submodule need not be a piece of the decomposition. -/
theorem finiteType_of_le_mul (U : Submodule R A)
    (hfinite : (U ⊔ ⨆ i : Fin (N + 1), 𝒜 i).FG)
    (hstep : ∀ n, N ≤ n → 𝒜 (n + 1) ≤ U * 𝒜 n) :
    Algebra.FiniteType R A := by
  obtain ⟨s, hs⟩ := hfinite
  let B := Algebra.adjoin R (s : Set A)
  have hgen : U ⊔ (⨆ i : Fin (N + 1), 𝒜 i) ≤ B.toSubmodule := by
    rw [← hs]
    exact Submodule.span_le.mpr Algebra.subset_adjoin
  have hUB : U ≤ B.toSubmodule := le_sup_left.trans hgen
  have hinit : (⨆ i : Fin (N + 1), 𝒜 i) ≤ B.toSubmodule := le_sup_right.trans hgen
  have hspan := span_eq_top_of_le_mul 𝒜 B N fun n hn ↦
    (hstep n hn).trans (mul_le_mul_left hUB (𝒜 n))
  refine ⟨s, top_unique ?_⟩
  intro x _
  have hx : x ∈ Submodule.span B (↑(⨆ i : Fin (N + 1), 𝒜 i) : Set A) := by
    rw [hspan]
    trivial
  exact Submodule.span_induction (fun _ hx ↦ hinit hx) B.zero_mem
    (fun _ _ _ _ hx hy ↦ B.add_mem hx hy)
    (fun b _ _ hx ↦ B.mul_mem b.property hx) hx

end TauCeti.GradedAlgebra
