module

public import TauCeti.RingTheory.AdicCompletion.Pow

/-!
# Completeness for a principal subideal

An `I`-adically complete module is `(r)`-adically complete whenever `r ∈ I`. No Noetherian,
finiteness or torsion hypothesis is needed. In particular, completeness for a parameter `π`
implies completeness for any multiple of `π`, even when their powers are not cofinal.
This allows the passage from pseudouniformiser-adic to `p`-adic completeness in integral rings.

The key point is to sum every tail of a series `∑ rⁿ • cₙ` in the `I`-adic filtration.
Factoring out `rᴺ` from the tail proves divisibility of the remainder; this does not assume
that principal submodules are closed in the `I`-adic topology.

## References

* The Stacks Project, Tag 090T, for the corresponding completeness theorem for finitely
  generated subideals.
-/

public section

open AdicCompletion Finset

variable {R : Type*} [CommRing R] {I : Ideal R} {M : Type*} [AddCommGroup M] [Module R M]

/-- In an `I`-adically complete module, a series with terms `rⁿ • cₙ`, where `r ∈ I`, has a sum
whose remainder after `n` terms belongs to `(r)ⁿ M`. -/
theorem IsAdicComplete.exists_smodEq_sum_range [IsAdicComplete I M] {r : R} (hr : r ∈ I)
    (c : ℕ → M) : ∃ L : M, ∀ n,
      (∑ j ∈ range n, r ^ j • c j) ≡ L [SMOD (Ideal.span {r} ^ n • ⊤ : Submodule R M)] := by
  let s (k n : ℕ) : M := ∑ j ∈ range n, r ^ j • c (k + j)
  have hc (k : ℕ) : IsAdicCauchy I M (s k) := by
    rw [isAdicCauchy_iff]
    intro n
    rw [SModEq.sub_mem]
    simp only [s, sum_range_succ, sub_add_cancel_left]
    exact Submodule.neg_mem _ (Submodule.smul_mem_smul (Ideal.pow_mem_pow hr n) trivial)
  -- Sum every shifted series, so the remainder can be factored without a closedness claim.
  choose L hL using fun k ↦ IsPrecomplete.prec' (I := I) (s k) (hc k)
  have hsplit (n m : ℕ) : s 0 (n + m) = s 0 n + r ^ n • s n m := by
    simp only [s, sum_range_add, smul_sum, zero_add, pow_add, mul_smul]
  -- Uniqueness of the I-adic limit identifies the sum with its finite head plus its tail.
  have htail (n : ℕ) : L 0 = s 0 n + r ^ n • L n := by
    apply (IsHausdorff.eq_iff_smodEq (I := I)).mpr
    intro m
    have h := (hL 0 (n + m)).mono
      (Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_add_left m n)))
    rw [hsplit] at h
    exact h.symm.trans ((SModEq.refl (s 0 n)).add ((hL n m).smul (r ^ n)))
  refine ⟨L 0, fun n ↦ ?_⟩
  rw [htail n, SModEq.sub_mem]
  simp only [s, zero_add, sub_add_cancel_left]
  exact Submodule.neg_mem _ (Submodule.smul_mem_smul
    (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n) trivial)

/-- An `I`-adically complete module is complete for the principal ideal generated by any
`r ∈ I`. Unlike cofinality of filtrations, this requires no power of `I` to lie in `(r)`. -/
theorem IsAdicComplete.span_singleton_of_mem [IsAdicComplete I M] {r : R} (hr : r ∈ I) :
    IsAdicComplete (Ideal.span {r}) M where
  toIsHausdorff := IsHausdorff.of_le (I.span_singleton_le_iff_mem.mpr hr)
  toIsPrecomplete := by
    classical
    refine ⟨fun f hf ↦ ?_⟩
    have hd (n : ℕ) : ∃ c : M, r ^ n • c = f (n + 1) - f n := by
      have h := SModEq.sub_mem.mp (hf (Nat.le_succ n)).symm
      simpa only [Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul,
        Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and] using h
    choose c hc using hd
    obtain ⟨L, hL⟩ := IsAdicComplete.exists_smodEq_sum_range hr c
    have htel (n : ℕ) : ∑ j ∈ range n, r ^ j • c j = f n - f 0 := by
      simp only [hc]
      exact sum_range_sub f n
    refine ⟨L + f 0, fun n ↦ ?_⟩
    have h := (hL n).add (SModEq.refl (f 0))
    simpa only [htel, sub_add_cancel] using h

/-- Completeness for `π` implies completeness for every multiple of `π`. -/
theorem IsAdicComplete.span_singleton_of_dvd {π r : R}
    [IsAdicComplete (Ideal.span {π}) M] (h : π ∣ r) :
    IsAdicComplete (Ideal.span {r}) M :=
  .span_singleton_of_mem (Ideal.mem_span_singleton.mpr h)
