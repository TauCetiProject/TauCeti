module

public import TauCeti.RingTheory.AdicCompletion.Finite

/-!
# Completeness of a quotient by a regular element

Let `R` be a ring which is `I`-adically complete and separated, and let `ξ ∈ R` be a
nonzerodivisor modulo every power of `I`: whenever `ξ x ∈ Iⁿ`, also `x ∈ Iⁿ`. Then the quotient
`R ⧸ (ξ)` is again `I`-adically complete and separated.

Precompleteness passes to every quotient ring. Separatedness needs the regularity of `ξ`: if
`y - ξ aₙ ∈ Iⁿ` for every `n`, then `ξ (aₙ - aₙ₊₁) ∈ Iⁿ`, so the `aₙ` form an `I`-adic Cauchy
sequence, and its limit `a` satisfies `y = ξ a`. In other words, the principal ideal `(ξ)` is
closed in the `I`-adic topology.

This applies to the quotient `W(R⁺) ⧸ (ξ)` of the Witt vectors of a perfect ring by a
distinguished element, the ring of integral elements of an untilt, with `I` generated by the
Teichmüller representative of a pseudouniformiser.

## Main results

* `IsHausdorff.quotient_span_singleton`: `R ⧸ (ξ)` is `I`-adically separated.
* `IsAdicComplete.quotient_span_singleton`: `R ⧸ (ξ)` is `I`-adically complete.

## References

* P. Scholze, *Étale cohomology of diamonds*, proof of Lemma 3.14, where completeness of
  `W(R⁺) ⧸ (ξ)` is used.
-/

public section

open AdicCompletion Ideal

variable {R : Type*} [CommRing R] {I : Ideal R} {ξ : R}

/-- **The quotient by a regular element is separated.** If `R` is `I`-adically complete and
separated and `ξ` is a nonzerodivisor modulo every power of `I`, then `R ⧸ (ξ)` is separated for
the image of `I`. -/
theorem IsHausdorff.quotient_span_singleton [IsAdicComplete I R]
    (h : ∀ (n : ℕ) (x : R), ξ * x ∈ I ^ n → x ∈ I ^ n) :
    IsHausdorff (I.map (Ideal.Quotient.mk (span {ξ}))) (R ⧸ span {ξ}) := by
  refine ⟨fun x hx ↦ ?_⟩
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  -- For every `n`, some `aₙ` has `y - ξ aₙ ∈ Iⁿ`.
  have hy (n : ℕ) : ∃ a : R, y - ξ * a ∈ I ^ n := by
    have := hx n
    rw [SModEq.zero, smul_eq_mul, mul_top, ← Ideal.map_pow, mem_quotient_iff_mem_sup,
      Submodule.mem_sup] at this
    obtain ⟨i, hi, _, hz, rfl⟩ := this
    obtain ⟨a, rfl⟩ := mem_span_singleton'.mp hz
    exact ⟨a, by rwa [mul_comm, add_sub_cancel_right]⟩
  choose a ha using hy
  -- The `aₙ` form an `I`-adic Cauchy sequence, since `ξ (aₙ - aₙ₊₁) ∈ Iⁿ`.
  have hcauchy : IsAdicCauchy I R a := by
    refine (isAdicCauchy_iff _ _ a).mpr fun n ↦ ?_
    rw [SModEq.sub_mem, smul_eq_mul, mul_top]
    refine h n _ ?_
    convert sub_mem (pow_le_pow_right n.le_succ (ha (n + 1))) (ha n) using 1
    ring
  obtain ⟨L, hL⟩ := IsPrecomplete.prec inferInstance hcauchy
  -- The limit `L` satisfies `y = ξ L`, since `y - ξ L = (y - ξ aₙ) + ξ (aₙ - L)`.
  have hyL : y = ξ * L := by
    refine (IsHausdorff.eq_iff_smodEq (I := I)).mpr fun n ↦ ?_
    have hn := hL n
    rw [SModEq.sub_mem, smul_eq_mul, mul_top] at hn ⊢
    convert add_mem (ha n) (mul_mem_left _ ξ hn) using 1
    ring
  rw [hyL, Ideal.Quotient.eq_zero_iff_mem]
  exact mem_span_singleton.mpr (dvd_mul_right ξ L)

/-- **The quotient by a regular element is complete.** If `R` is `I`-adically complete and
separated and `ξ` is a nonzerodivisor modulo every power of `I`, then `R ⧸ (ξ)` is complete and
separated for the image of `I`. -/
theorem IsAdicComplete.quotient_span_singleton [IsAdicComplete I R]
    (h : ∀ (n : ℕ) (x : R), ξ * x ∈ I ^ n → x ∈ I ^ n) :
    IsAdicComplete (I.map (Ideal.Quotient.mk (span {ξ}))) (R ⧸ span {ξ}) where
  toIsHausdorff := .quotient_span_singleton h
  toIsPrecomplete := by
    have := IsPrecomplete.of_finite I (R ⧸ span {ξ})
    rwa [← IsPrecomplete.map_algebraMap_iff (S := R ⧸ span {ξ}),
      Ideal.Quotient.algebraMap_eq] at this
