module

public import Mathlib.Algebra.Divisibility.Prod
public import Mathlib.RingTheory.AdicCompletion.Functoriality

/-!
# Adic completeness of products

For an ideal `I` of a commutative ring `R` and a family of `R`-modules `M i`, the product `∀ i, M i`
is `I`-adically Hausdorff as soon as every factor is. If the family is finite, the analogous result
holds for adic precompleteness and completeness. In particular a finite free module `Fin n → R`
over an `I`-adically complete ring is `I`-adically complete, which is what the complete Nakayama
lemma (`surjective_of_mkQ_comp_surjective`) requires of the source of a map out of a finite free
module. For a principal ideal `(π)`, the `(π)`-adic filtration of a product `ι → R` is read off
coordinatewise: `x ∈ (π)^n • ⊤` exactly when `π ^ n` divides every coordinate of `x`. Hence
`π`-adic limits and separation of coordinate families can be stated with divisibility alone.

For a product `∀ i, A i` of different rings and a principal ideal `(π)`, with `π = (π i)`,
congruence modulo `(π) ^ n` is again coordinatewise, so the product is `π`-adically Hausdorff,
precomplete or complete as soon as every factor `A i` is so for `(π i)`, with no finiteness
assumption on the index type. In particular a product of `p`-adically complete rings is
`p`-adically complete.

## Main results

* `TauCeti.mem_span_singleton_pow_smul_top_iff`: membership in `(π)^n • ⊤` on a product module is
  coordinatewise divisibility by `π ^ n`.
* `AdicCompletion.pi_of`: the product of the completions of the factors receives the canonical
  map from the product as the product of the canonical maps.
* `IsHausdorff.pi`: adic Hausdorffness passes to products.
* `IsPrecomplete.pi`, `IsAdicComplete.pi`: adic precompleteness and completeness pass to finite
  products.
* `AdicCompletion.map_inl_map_fst_add_map_inr_map_snd`: an element of the completion of a binary
  product `M × N` is the sum of the images of its completed components.
* `TauCeti.exists_forall_pow_dvd_sub`: a `π`-adically Cauchy sequence of coordinate families over a
  precomplete ring has a limit.
* `TauCeti.eq_zero_of_forall_pow_dvd`: over a Hausdorff ring, a coordinate family divisible by every
  power of `π` vanishes.
* `TauCeti.sModEq_span_singleton_pow_iff`: congruence modulo `(π) ^ n` is divisibility by `π ^ n`.
* `TauCeti.sModEq_span_singleton_pow_pi_iff`: in a product of rings, congruence modulo `(π) ^ n`
  is coordinatewise congruence modulo `(π i) ^ n`.
* `IsHausdorff.pi_span_singleton`, `IsPrecomplete.pi_span_singleton`,
  `IsAdicComplete.pi_span_singleton`: `π`-adic Hausdorffness, precompleteness and completeness
  pass to arbitrary products of rings.
* `IsAdicComplete.pi_span_natCast`: the instance for the ideal generated by a natural number.
-/

public section

open AdicCompletion

namespace TauCeti

/-- On a product module, membership in `(π)^n • ⊤` is coordinatewise divisibility by `π ^ n`. -/
theorem mem_span_singleton_pow_smul_top_iff {R : Type*} [CommSemiring R] {ι : Type*} (π : R)
    (x : ι → R) (n : ℕ) :
    x ∈ ((Ideal.span {π}) ^ n • ⊤ : Submodule R (ι → R)) ↔ ∀ i, π ^ n ∣ x i := by
  rw [Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists]
  constructor
  · rintro ⟨y, -, rfl⟩ i
    exact ⟨y i, rfl⟩
  · intro h
    choose y hy using h
    exact ⟨y, Submodule.mem_top, funext fun i ↦ (hy i).symm⟩

end TauCeti

variable {R : Type*} [CommRing R] (I : Ideal R) {ι : Type*} (M : ι → Type*)
  [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]

/-- The canonical map from a product to its adic completion, followed by the comparison map
`AdicCompletion.pi` to the product of the completions, is the product of the canonical maps of the
factors. -/
@[simp]
theorem AdicCompletion.pi_of (x : ∀ i, M i) (j : ι) :
    AdicCompletion.pi I M (of I (∀ i, M i) x) j = of I (M j) (x j) := by
  simp [AdicCompletion.pi, map_of]

/-- A product of `I`-adically Hausdorff modules is `I`-adically Hausdorff. -/
instance IsHausdorff.pi [∀ i, IsHausdorff I (M i)] : IsHausdorff I (∀ i, M i) := by
  refine of_injective_iff.mp fun x y hxy ↦ _root_.funext fun j ↦ (of_injective I (M j)) ?_
  rw [← pi_of, ← pi_of, hxy]

/-- A finite product of `I`-adically precomplete modules is `I`-adically precomplete. -/
instance IsPrecomplete.pi [Finite ι] [∀ i, IsPrecomplete I (M i)] : IsPrecomplete I (∀ i, M i) := by
  classical
  have := Fintype.ofFinite ι
  refine of_surjective_iff.mp fun y ↦ ?_
  choose x hx using fun j ↦ of_surjective I (M j) (AdicCompletion.pi I M y j)
  refine ⟨x, (piEquivOfFintype I M).injective (_root_.funext fun j ↦ ?_)⟩
  rw [piEquivOfFintype_apply, piEquivOfFintype_apply, pi_of, hx]

/-- A finite product of `I`-adically complete modules is `I`-adically complete. -/
instance IsAdicComplete.pi [Finite ι] [∀ i, IsAdicComplete I (M i)] :
    IsAdicComplete I (∀ i, M i) where

/-- An element of the adic completion of a binary product `M × N` is the sum of the images of its
two completed components, under the completed inclusions. -/
theorem AdicCompletion.map_inl_map_fst_add_map_inr_map_snd {M N : Type*} [AddCommGroup M]
    [Module R M] [AddCommGroup N] [Module R N] (z : AdicCompletion I (M × N)) :
    map I (LinearMap.inl R M N) (map I (LinearMap.fst R M N) z) +
      map I (LinearMap.inr R M N) (map I (LinearMap.snd R M N) z) = z := by
  have h : LinearMap.inl R M N ∘ₗ LinearMap.fst R M N + LinearMap.inr R M N ∘ₗ
      LinearMap.snd R M N = LinearMap.id := by
    ext <;> simp
  rw [map_comp_apply, map_comp_apply, ← LinearMap.add_apply, ← map_add, h, map_id,
    LinearMap.id_apply]

namespace TauCeti

/-- **Limits of coordinate families.** Over a `π`-adically precomplete ring, a sequence of
coordinate families whose consecutive terms are congruent modulo `π ^ m` has a limit, congruent to
the `m`-th term modulo `π ^ m`. -/
theorem exists_forall_pow_dvd_sub (π : R) [IsPrecomplete (Ideal.span {π}) R]
    (x : ℕ → ι → R) (hx : ∀ m i, π ^ m ∣ x (m + 1) i - x m i) :
    ∃ L : ι → R, ∀ m i, π ^ m ∣ L i - x m i := by
  have hmem (m : ℕ) (r : R) : r ∈ ((Ideal.span {π}) ^ m • ⊤ : Ideal R) ↔ π ^ m ∣ r := by
    rw [Ideal.smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  have hcauchy {m m' : ℕ} (hm : m ≤ m') (i : ι) : π ^ m ∣ x m' i - x m i := by
    induction m', hm using Nat.le_induction with
    | base => simp
    | succ m' hm ih =>
      rw [← sub_add_sub_cancel]
      exact dvd_add ((pow_dvd_pow π hm).trans (hx m' i)) ih
  choose L hL using fun i ↦ IsPrecomplete.prec (I := Ideal.span {π}) inferInstance
    (f := (x · i)) fun hm ↦ by rw [SModEq.sub_mem, hmem, dvd_sub_comm]; exact hcauchy hm i
  exact ⟨L, fun m i ↦ dvd_sub_comm.mp ((hmem m _).1 (SModEq.sub_mem.1 (hL i m)))⟩

/-- Over a `π`-adically Hausdorff ring, a coordinate family whose coordinates are divisible by
every power of `π` vanishes. -/
theorem eq_zero_of_forall_pow_dvd (π : R) [IsHausdorff (Ideal.span {π}) R] {x : ι → R}
    (hx : ∀ m i, π ^ m ∣ x i) : x = 0 :=
  IsHausdorff.haus (I := Ideal.span {π}) inferInstance x fun m ↦ by
    rw [SModEq.zero, mem_span_singleton_pow_smul_top_iff]
    exact hx m

end TauCeti

section PrincipalPi

namespace TauCeti

/-- Congruence modulo `(π) ^ n` is divisibility of the difference by `π ^ n`. -/
theorem sModEq_span_singleton_pow_iff {R : Type*} [CommRing R] (π a b : R) (n : ℕ) :
    a ≡ b [SMOD (Ideal.span {π} ^ n • ⊤ : Ideal R)] ↔ π ^ n ∣ a - b := by
  rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton]

variable {ι : Type*} {A : ι → Type*} [∀ i, CommRing (A i)]

/-- In a product of rings, congruence modulo `(π) ^ n` is coordinatewise congruence modulo
`(π i) ^ n`. -/
theorem sModEq_span_singleton_pow_pi_iff (π a b : ∀ i, A i) (n : ℕ) :
    a ≡ b [SMOD (Ideal.span {π} ^ n • ⊤ : Ideal (∀ i, A i))] ↔
      ∀ i, a i ≡ b i [SMOD (Ideal.span {π i} ^ n • ⊤ : Ideal (A i))] := by
  simp only [sModEq_span_singleton_pow_iff, pi_dvd_iff, Pi.pow_apply, Pi.sub_apply]

end TauCeti

variable {ι : Type*} {A : ι → Type*} [∀ i, CommRing (A i)]

/-- A product of rings `A i`, each `π i`-adically Hausdorff, is `π`-adically Hausdorff. Unlike
`IsHausdorff.pi`, the factors are different rings, each with its own principal ideal. -/
theorem IsHausdorff.pi_span_singleton (π : ∀ i, A i)
    [∀ i, IsHausdorff (Ideal.span {π i}) (A i)] : IsHausdorff (Ideal.span {π}) (∀ i, A i) :=
  ⟨fun x hx ↦ _root_.funext fun i ↦ IsHausdorff.haus (I := Ideal.span {π i}) inferInstance (x i)
    fun n ↦ (TauCeti.sModEq_span_singleton_pow_pi_iff π x 0 n).mp (hx n) i⟩

/-- A product of rings `A i`, each `π i`-adically precomplete, is `π`-adically precomplete. The
ideal must be principal, but the index type is arbitrary. -/
theorem IsPrecomplete.pi_span_singleton (π : ∀ i, A i)
    [∀ i, IsPrecomplete (Ideal.span {π i}) (A i)] :
    IsPrecomplete (Ideal.span {π}) (∀ i, A i) := by
  -- a Cauchy sequence converges coordinatewise, and the coordinatewise congruences assemble
  -- because `(π) ^ n` is principal
  refine ⟨fun f hf ↦ ?_⟩
  choose L hL using fun i ↦ IsPrecomplete.prec (I := Ideal.span {π i}) inferInstance
    (f := (f · i)) fun hmn ↦ (TauCeti.sModEq_span_singleton_pow_pi_iff π _ _ _).mp (hf hmn) i
  exact ⟨L, fun n ↦ (TauCeti.sModEq_span_singleton_pow_pi_iff π _ _ n).mpr fun i ↦ hL i n⟩

/-- A product of rings `A i`, each `π i`-adically complete, is `π`-adically complete, for an
arbitrary index type. -/
theorem IsAdicComplete.pi_span_singleton (π : ∀ i, A i)
    [∀ i, IsAdicComplete (Ideal.span {π i}) (A i)] :
    IsAdicComplete (Ideal.span {π}) (∀ i, A i) where
  toIsHausdorff := .pi_span_singleton π
  toIsPrecomplete := .pi_span_singleton π

/-- A product of rings, each complete for the ideal generated by the natural number `n`, is
complete for the ideal generated by `n`. -/
instance IsAdicComplete.pi_span_natCast (n : ℕ)
    [∀ i, IsAdicComplete (Ideal.span {(n : A i)}) (A i)] :
    IsAdicComplete (Ideal.span {(n : ∀ i, A i)}) (∀ i, A i) :=
  .pi_span_singleton fun i ↦ (n : A i)

end PrincipalPi
