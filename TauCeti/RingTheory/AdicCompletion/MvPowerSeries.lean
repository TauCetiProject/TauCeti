module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.MvPowerSeries.Basic
import Mathlib.RingTheory.AdicCompletion.Completeness
import Mathlib.RingTheory.MvPowerSeries.Trunc
import TauCeti.RingTheory.AdicCompletion.AlgHom
import TauCeti.RingTheory.AdicCompletion.Surjective
import TauCeti.RingTheory.MvPolynomial.Ideal.Basic
import TauCeti.RingTheory.MvPowerSeries.Ideal

/-!
# Completions which are formal power series rings

Let `A` be a commutative ring with an ideal `𝔪` generated by finitely many elements `z i`, and
suppose that every element of `A` is congruent modulo `𝔪` to a constant `c r`, for a ring
homomorphism `c : k →+* A`. A ring homomorphism `T : A →+* k⟦X_i⟧` sending `c r` to the constant
series `r` and each `z i` to the variable `X i` then identifies the quotients `A ⧸ 𝔪 ^ n` with
the quotients of `k⟦X_i⟧` by the powers of the ideal of the variables. Since `k⟦X_i⟧` is complete
for that ideal, the `𝔪`-adic completion of `A` is `k⟦X_i⟧`.

Germs of holomorphic functions with their Taylor series are the motivating example: there `T` is
injective but far from surjective, and only the quotients by the powers of `𝔪` agree.

The polynomials in the `z i` play the role of the Taylor polynomials. They exhaust `A` modulo
every power of `𝔪` by `Ideal.mk_map_pow_comp_surjective`.

## Main results

* `TauCeti.comap_pow_span_range_X`: the preimage under `T` of the `n`-th power of the ideal of the
  variables is `𝔪 ^ n`.
* `TauCeti.quotientMap_pow_span_range_X_bijective`: `T` induces isomorphisms of the quotients by
  the powers of `𝔪` and of the ideal of the variables.
* `TauCeti.adicCompletionEquivMvPowerSeries`: the resulting isomorphism of the `𝔪`-adic
  completion of `A` with `k⟦X_i⟧`, extending `T` (`TauCeti.adicCompletionEquivMvPowerSeries_of`).
-/

public section

open MvPowerSeries

namespace TauCeti

variable {k A ι : Type*} [CommRing k] [CommRing A]
  {T : A →+* MvPowerSeries ι k} {c : k →+* A} {z : ι → A} {𝔪 : Ideal A}

section

variable (hTc : T.comp c = MvPowerSeries.C) (hTz : ∀ i, T (z i) = X i)
  (h𝔪 : Ideal.span (Set.range z) = 𝔪)

include hTz h𝔪 in
/-- The ideal `𝔪` generated by the `z i` maps onto the ideal of the variables. -/
private theorem map_eq_span_range_X : 𝔪.map T = Ideal.span (Set.range X) := by
  rw [← h𝔪, Ideal.map_span, ← Set.range_comp]
  exact congrArg _ (Set.ext fun _ ↦ by simp [hTz])

include hTz h𝔪 in
/-- The powers of `𝔪` map into the powers of the ideal of the variables. -/
theorem pow_le_comap_pow_span_range_X (n : ℕ) :
    𝔪 ^ n ≤ (Ideal.span (Set.range X) ^ n).comap T := by
  rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow, map_eq_span_range_X hTz h𝔪]

include hTc hTz in
/-- Evaluating polynomials at the `z i` and then applying `T` is the inclusion of polynomials
into power series. -/
private theorem comp_eval₂Hom :
    T.comp (MvPolynomial.eval₂Hom c z) = MvPolynomial.coeToMvPowerSeries.ringHom :=
  MvPolynomial.ringHom_ext (fun r ↦ by simpa using congr($hTc r)) fun i ↦ by simp [hTz]

include hTc hTz h𝔪 in
/-- **The preimage of the powers of the ideal of the variables.** If `T` sends the constants
`c r` to the constant series and the generators `z i` of `𝔪` to the variables, and every element
of `A` is congruent modulo `𝔪` to a constant, then an element of `A` is sent into the `n`-th power
of the ideal of the variables exactly when it lies in `𝔪 ^ n`. -/
theorem comap_pow_span_range_X [Finite ι] (hc : Function.Surjective ((Ideal.Quotient.mk 𝔪).comp c))
    (n : ℕ) : (Ideal.span (Set.range X) ^ n).comap T = 𝔪 ^ n := by
  refine le_antisymm (fun a ha ↦ ?_) (pow_le_comap_pow_span_range_X hTz h𝔪 n)
  set ψ := MvPolynomial.eval₂Hom c z
  have hψ : (MvPolynomial.idealOfVars ι k).map ψ = 𝔪 :=
    h𝔪 ▸ MvPolynomial.map_eval₂Hom_idealOfVars c z
  -- Modulo `𝔪 ^ n`, `a` is a polynomial `p` in the `z i`.
  have h₁ : Function.Surjective
      ((Ideal.Quotient.mk ((MvPolynomial.idealOfVars ι k).map ψ)).comp ψ) := by
    rw [hψ]
    intro y
    obtain ⟨r, hr⟩ := hc y
    exact ⟨MvPolynomial.C r, by simpa [ψ] using hr⟩
  have hsurj := Ideal.mk_map_pow_comp_surjective h₁ n
  rw [hψ] at hsurj
  obtain ⟨p, hp⟩ := hsurj (Ideal.Quotient.mk _ a)
  rw [RingHom.comp_apply, Ideal.Quotient.eq] at hp
  -- Its power series, the image of `a` minus an element of the `n`-th power, has order `≥ n`.
  have hTp : (p : MvPowerSeries ι k) ∈ Ideal.span (Set.range X) ^ n := by
    have := add_mem (pow_le_comap_pow_span_range_X hTz h𝔪 n hp) ha
    rwa [sub_add_cancel, Ideal.mem_comap, ← RingHom.comp_apply, comp_eval₂Hom hTc hTz] at this
  -- So `p` has no monomial of total degree below `n`, and `ψ p ∈ 𝔪 ^ n`.
  have hp' : p ∈ MvPolynomial.idealOfVars ι k ^ n := by
    rw [mem_pow_span_range_X_iff_le_order] at hTp
    rw [MvPolynomial.mem_pow_idealOfVars_iff']
    intro d hd
    simpa using coeff_of_lt_order (f := (p : MvPowerSeries ι k)) ((Nat.cast_lt.2 hd).trans_le hTp)
  have hψp : ψ p ∈ 𝔪 ^ n := by
    rw [← hψ, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hp'
  simpa using sub_mem hψp hp

include hTc hTz in
/-- Modulo the `n`-th power of the ideal of the variables, every power series is the image of an
element of `A`: the image of its truncation in total degree below `n`. -/
theorem mk_pow_span_range_X_comp_surjective [Finite ι] (n : ℕ) :
    Function.Surjective ((Ideal.Quotient.mk (Ideal.span (Set.range X) ^ n)).comp T) := by
  intro y
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
  refine ⟨MvPolynomial.eval₂Hom c z (truncTotal n f), Ideal.Quotient.eq.2 ?_⟩
  rw [← RingHom.comp_apply, comp_eval₂Hom hTc hTz, MvPolynomial.coeToMvPowerSeries.ringHom_apply,
    mem_pow_span_range_X_iff_le_order]
  refine nat_le_order fun d hd ↦ ?_
  simp [coeff_truncTotal _ hd]

include hTc hTz h𝔪 in
/-- **The quotients agree.** `T` induces isomorphisms `A ⧸ 𝔪 ^ n ≃ k⟦X_i⟧ ⧸ (X_i) ^ n`. -/
theorem quotientMap_pow_span_range_X_bijective [Finite ι]
    (hc : Function.Surjective ((Ideal.Quotient.mk 𝔪).comp c)) (n : ℕ) :
    Function.Bijective (Ideal.quotientMap (Ideal.span (Set.range X) ^ n) T
      (pow_le_comap_pow_span_range_X hTz h𝔪 n)) := by
  refine ⟨Ideal.quotientMap_injective' (comap_pow_span_range_X hTc hTz h𝔪 hc n).le, fun y ↦ ?_⟩
  obtain ⟨a, ha⟩ := mk_pow_span_range_X_comp_surjective hTc hTz n y
  exact ⟨Ideal.Quotient.mk _ a, by simpa using ha⟩

/-- **The completion is the power series ring.** If `T : A →+* k⟦X_i⟧` sends the constants `c r`
to the constant series and the generators `z i` of `𝔪` to the variables, and every element of
`A` is congruent modulo `𝔪` to a constant, then `T` extends to an isomorphism of the `𝔪`-adic
completion of `A` with `k⟦X_i⟧`. -/
noncomputable def adicCompletionEquivMvPowerSeries [Finite ι]
    (hc : Function.Surjective ((Ideal.Quotient.mk 𝔪).comp c)) :
    AdicCompletion 𝔪 A ≃+* MvPowerSeries ι k :=
  letI := T.toAlgebra
  (RingEquiv.ofBijective _ (AdicCompletion.mapₐ_bijective (f := Algebra.ofId A _)
      (Ideal.map_le_iff_le_comap.1 (map_eq_span_range_X hTz h𝔪).le)
      fun n ↦ quotientMap_pow_span_range_X_bijective hTc hTz h𝔪 hc n)).trans
    (AdicCompletion.ofAlgEquiv (Ideal.span (Set.range X))).symm.toRingEquiv

/-- The isomorphism `adicCompletionEquivMvPowerSeries` extends `T` along the canonical map
`A → AdicCompletion 𝔪 A`. -/
@[simp]
theorem adicCompletionEquivMvPowerSeries_of [Finite ι]
    (hc : Function.Surjective ((Ideal.Quotient.mk 𝔪).comp c)) (a : A) :
    adicCompletionEquivMvPowerSeries hTc hTz h𝔪 hc (AdicCompletion.of 𝔪 A a) = T a := by
  simp [adicCompletionEquivMvPowerSeries, RingHom.algebraMap_toAlgebra]

/-- Modulo the `n`-th power of the ideal of the variables, the isomorphism
`adicCompletionEquivMvPowerSeries` is the isomorphism of quotients induced by `T`. -/
@[simp]
theorem mk_adicCompletionEquivMvPowerSeries [Finite ι]
    (hc : Function.Surjective ((Ideal.Quotient.mk 𝔪).comp c)) (n : ℕ)
    (x : AdicCompletion 𝔪 A) :
    Ideal.Quotient.mk (Ideal.span (Set.range X) ^ n)
        (adicCompletionEquivMvPowerSeries hTc hTz h𝔪 hc x) =
      Ideal.quotientMap _ T (pow_le_comap_pow_span_range_X hTz h𝔪 n)
        (AdicCompletion.evalₐ 𝔪 n x) := by
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ 𝔪 n x)
  simp [adicCompletionEquivMvPowerSeries, ← ha, RingHom.algebraMap_toAlgebra]

end

end TauCeti
