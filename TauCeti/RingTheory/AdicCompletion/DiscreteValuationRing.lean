module

public import TauCeti.RingTheory.AdicCompletion.Regular.Basic
public import TauCeti.RingTheory.AdicCompletion.LocalRing
public import TauCeti.RingTheory.RegularLocalRing.Basic

/-!
# Completion of a discrete valuation ring

Completing a discrete valuation ring at its maximal ideal preserves regularity and dimension one,
so the completion is again a discrete valuation ring.

More generally, completing at any maximal ideal generated by a regular element gives a discrete
valuation domain. The original ring need not be Noetherian, local or separated. This applies to
the completions used to construct de Rham period rings.

## Provenance

`AdicCompletion.exists_associated_pow_of_isMaximal_span`,
`AdicCompletion.isDomain_of_isMaximal_span` and
`AdicCompletion.isDiscreteValuationRing_of_isMaximal_span` adapt the factorization argument of
`New.Period.BdRPlus.exists_associated_xi_pow` and the domain and discrete valuation instances in
`src/Lib/PadicHodge/PeriodRings/CrystallineRings.lean` in grh-lean
(https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic, PBC).
The formulation for any regular principal maximal ideal is new here.

## References

* J.-M. Fontaine, *Le corps des périodes p-adiques*, Astérisque 223 (1994), §§1.5.1–1.5.2, p. 71.
-/

public section

open Ideal IsLocalRing

namespace TauCeti.AdicCompletion

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- The maximal-ideal completion of a discrete valuation ring is a discrete valuation ring. -/
instance : IsDiscreteValuationRing (AdicCompletion (maximalIdeal R) R) :=
  IsRegularLocalRing.isDiscreteValuationRing_iff_ringKrullDim_eq_one.mpr
    ((ringKrullDim_eq le_rfl).trans (IsDiscreteValuationRing.ringKrullDim_eq_one R))

end TauCeti.AdicCompletion

namespace AdicCompletion

variable {R : Type*} [CommRing R] {r : R}

/-- In the completion at a principal maximal ideal, the nonunits are precisely the multiples
of its generator. -/
theorem isUnit_iff_not_dvd_of_isMaximal_span [(span {r}).IsMaximal]
    (x : AdicCompletion (span {r}) R) :
    IsUnit x ↔ ¬algebraMap R (AdicCompletion (span {r}) R) r ∣ x := by
  let I := span {r}
  have hm := isMaximal_map_of_le I I le_rfl (Submodule.fg_span_singleton r)
  have hc := isAdicComplete_self I (Submodule.fg_span_singleton r)
  have := isLocalRing_of_isAdicComplete_maximal (I.map (algebraMap R (AdicCompletion I R)))
  apply not_iff_not.mp
  rw [not_not, ← mem_nonunits_iff, ← mem_maximalIdeal, ← eq_maximalIdeal hm, map_span,
    Set.image_singleton, mem_span_singleton]

/-- Every nonzero element of the completion at a principal maximal ideal is associated to a
power of its generator. -/
theorem exists_associated_pow_of_isMaximal_span [(span {r}).IsMaximal]
    {x : AdicCompletion (span {r}) R} (hx : x ≠ 0) :
    ∃ n : ℕ, Associated (algebraMap R (AdicCompletion (span {r}) R) r ^ n) x := by
  have hc := isAdicComplete_self (span {r}) (Submodule.fg_span_singleton r)
  rw [map_span, Set.image_singleton] at hc
  let t := algebraMap R (AdicCompletion (span {r}) R) r
  have hfin : FiniteMultiplicity t x := by
    apply FiniteMultiplicity.not_iff_forall.not_right.mpr
    intro h
    apply hx
    exact IsHausdorff.haus (I := span {t}) inferInstance x fun n ↦ by
      simpa only [SModEq.zero, smul_eq_mul, Ideal.mul_top,
        span_singleton_pow, mem_span_singleton] using h n
  obtain ⟨u, hu, hnu⟩ := hfin.exists_eq_pow_mul_and_not_dvd
  refine ⟨multiplicity t x, ?_⟩
  have hassoc := associated_mul_unit_right (t ^ multiplicity t x) u
    ((isUnit_iff_not_dvd_of_isMaximal_span u).mpr hnu)
  rwa [← hu] at hassoc

/-- Completing at a maximal ideal generated by a nonzerodivisor produces a domain, even when
the original ring is not Noetherian or separated. -/
theorem isDomain_of_isMaximal_span [(span {r}).IsMaximal] (hr : IsRegular r) :
    IsDomain (AdicCompletion (span {r}) R) := by
  have : Nontrivial (AdicCompletion (span {r}) R) :=
    (evalOneₐ (span {r})).toRingHom.domain_nontrivial
  have hreg := hr.adicCompletion
  have : NoZeroDivisors (AdicCompletion (span {r}) R) := by
    refine ⟨fun {x y} hxy ↦ ?_⟩
    by_contra! h
    obtain ⟨m, hm⟩ := exists_associated_pow_of_isMaximal_span h.1
    obtain ⟨n, hn⟩ := exists_associated_pow_of_isMaximal_span h.2
    have hz := (hm.mul_mul hn).eq_zero_iff.mpr hxy
    rw [← pow_add] at hz
    exact (hreg.pow (m + n)).ne_zero hz
  exact NoZeroDivisors.to_isDomain _

/-- The completion at a regular principal maximal ideal is a discrete valuation ring. -/
theorem isDiscreteValuationRing_of_isMaximal_span [(span {r}).IsMaximal]
    (hr : IsRegular r) :
    let := isDomain_of_isMaximal_span hr
    IsDiscreteValuationRing (AdicCompletion (span {r}) R) := by
  let := isDomain_of_isMaximal_span hr
  have hm := isMaximal_map_of_le (span {r}) (span {r}) le_rfl (Submodule.fg_span_singleton r)
  rw [map_span, Set.image_singleton] at hm
  have hp : Prime (algebraMap R (AdicCompletion (span {r}) R) r) :=
    (span_singleton_prime (hr.adicCompletion.ne_zero)).mp hm.isPrime
  exact .ofHasUnitMulPowIrreducibleFactorization
    ⟨_, hp.irreducible, fun hx ↦ exists_associated_pow_of_isMaximal_span hx⟩

end AdicCompletion
