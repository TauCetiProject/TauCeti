module

public import Mathlib.RingTheory.AdicCompletion.Functoriality
public import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# Surjectivity of an algebra map by successive approximation

Mathlib's `surjective_of_mk_map_comp_surjective` reduces surjectivity of a ring map `ψ : R → B`
from an `IR`-adically precomplete ring to surjectivity of its reduction modulo `IR.map ψ`. Here it
is applied to an algebra map whose reduction is generated by a family of elements: if `ψ` carries
`IR` onto `J` and its reduction hits a family of `A`-algebra generators of `B ⧸ J`, then `ψ` is
surjective.

## Main results

* `surjective_of_isPrecomplete_of_lifts_generators`: the criterion above.
-/

public section

/-- **Surjectivity from successive approximation.** Let `ψ : R → B` be an `A`-algebra map, and
suppose `R` is `IR`-adically precomplete, `B` is `J`-adically separated, and `ψ` carries `IR` onto
`J`. If `f : A[X i] → B ⧸ J` is a surjective `A`-algebra map and each `f (X i)` is the class of
`ψ (x i)` for some `x i : R`, then `ψ` is surjective. -/
theorem surjective_of_isPrecomplete_of_lifts_generators {A B R : Type*} [CommRing A] [CommRing B]
    [CommRing R] [Algebra A B] [Algebra A R] {ψ : R →+* B}
    (hψA : ψ.comp (algebraMap A R) = algebraMap A B) {IR : Ideal R} {J : Ideal B}
    (hmap : IR.map ψ = J) [IsPrecomplete IR R] [IsHausdorff (IR.map ψ) B] {ι : Type*}
    {f : MvPolynomial ι A →ₐ[A] B ⧸ J} (hf : Function.Surjective f) {x : ι → R}
    (hx : ∀ i, Ideal.Quotient.mk J (ψ (x i)) = f (MvPolynomial.X i)) :
    Function.Surjective ψ := by
  refine surjective_of_mk_map_comp_surjective (I := IR) ψ ?_
  rw [hmap]
  -- the reduction of `ψ` is an `A`-algebra map whose range contains the generators
  let ψA : R →ₐ[A] B := { ψ with commutes' := RingHom.congr_fun hψA }
  let q := (Ideal.Quotient.mkₐ A J).comp ψA
  have hle : Algebra.adjoin A (Set.range fun i ↦ f (MvPolynomial.X i)) ≤ q.range :=
    Algebra.adjoin_le <| by
      rintro _ ⟨i, rfl⟩
      exact ⟨x i, hx i⟩
  intro y
  obtain ⟨p, rfl⟩ := hf y
  have hp : f p ∈ Algebra.adjoin A (Set.range fun i ↦ f (MvPolynomial.X i)) := by
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact ⟨p, (RingHom.congr_fun (congrArg AlgHom.toRingHom (MvPolynomial.aeval_unique f))
      p).symm⟩
  obtain ⟨x, hx⟩ := hle hp
  exact ⟨x, by simpa [q, ψA] using hx⟩
