module

public import Mathlib.RingTheory.AdicCompletion.Functoriality
public import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# Surjectivity of an algebra map by successive approximation

Mathlib's `surjective_of_mk_map_comp_surjective` reduces surjectivity of a ring map `ψ : R → B`
from an `IR`-adically precomplete ring to surjectivity of its reduction modulo `IR.map ψ`. Here it
is applied to an algebra map whose reduction is generated by a family of elements: if `ψ` carries
`IR` onto `J` and its reduction hits a family of `A`-algebra generators of `B ⧸ J`, then `ψ` is
surjective.

The successive approximation step itself, in ring form: if every element of `A` is congruent
modulo `J.map f` to an element of the image of `f : R →+* A`, then the same holds modulo every
power `(J.map f) ^ n`. It iterates Mathlib's
`AdicCompletion.exists_smodEq_pow_smul_top_and_smodEq_pow_add_one_smul_top`.

## Main results

* `TauCeti.surjective_of_isPrecomplete_of_lifts_generators`: the criterion above.
* `Ideal.mk_map_pow_comp_surjective`: lifting congruences modulo `J.map f` to its powers.
-/

public section

namespace Ideal

/-- **Lifting congruences to powers of an extended ideal.** If every element of `A` is congruent
modulo `J.map f` to an element of the image of `f : R →+* A`, then it is so modulo every power
`(J.map f) ^ n`. This is the ring form of `AdicCompletion.exists_smodEq_pow_add_one_smul`, iterated
through `AdicCompletion.exists_smodEq_pow_smul_top_and_smodEq_pow_add_one_smul_top`. -/
theorem mk_map_pow_comp_surjective {R A : Type*} [CommRing R] [CommRing A] {f : R →+* A}
    {J : Ideal R} (h : Function.Surjective ((Quotient.mk (J.map f)).comp f)) (n : ℕ) :
    Function.Surjective ((Quotient.mk (J.map f ^ n)).comp f) := by
  let := f.toAlgebra
  have hf : algebraMap R A = f := RingHom.algebraMap_toAlgebra f
  have hmem (k : ℕ) (a : A) : a ∈ (J ^ k • ⊤ : Submodule R A) ↔ a ∈ J.map f ^ k := by
    rw [smul_top_eq_map, Submodule.restrictScalars_mem, Ideal.map_pow, hf]
  have h' : Function.Surjective (Submodule.mkQ (J • ⊤) ∘ₗ Algebra.linearMap R A) := by
    intro y
    obtain ⟨a, rfl⟩ := Submodule.mkQ_surjective _ y
    obtain ⟨r, hr⟩ := h (Quotient.mk _ a)
    refine ⟨r, ?_⟩
    rw [LinearMap.comp_apply, Algebra.linearMap_apply, hf, Submodule.mkQ_apply,
      Submodule.mkQ_apply, Submodule.Quotient.eq, ← pow_one J, hmem, pow_one]
    exact Quotient.eq.1 hr
  have key (n : ℕ) (a : A) : ∃ r, f r - a ∈ J.map f ^ n := by
    induction n with
    | zero => exact ⟨0, by simp⟩
    | succ n ih =>
      obtain ⟨r, hr⟩ := ih
      rw [← hf] at hr
      obtain ⟨r', -, hr'⟩ :=
        AdicCompletion.exists_smodEq_pow_smul_top_and_smodEq_pow_add_one_smul_top h' (x := r)
          (SModEq.sub_mem.2 ((hmem n _).2 hr))
      rw [SModEq.sub_mem, hmem, Algebra.linearMap_apply, hf] at hr'
      exact ⟨r', hr'⟩
  intro y
  obtain ⟨a, rfl⟩ := Quotient.mk_surjective y
  exact (key n a).imp fun _ hr ↦ Quotient.eq.2 hr

end Ideal

namespace TauCeti

/-- **Surjectivity from successive approximation.** Let `ψ : R → B` be an `A`-algebra map, and
suppose `R` is `IR`-adically precomplete, `B` is `J`-adically separated, and `ψ` carries `IR` onto
`J`. If `f : A[X i] → B ⧸ J` is a surjective `A`-algebra map and each `f (X i)` is the class of
`ψ (x i)` for some `x i : R`, then `ψ` is surjective. -/
theorem surjective_of_isPrecomplete_of_lifts_generators {A B R : Type*} [CommRing A] [CommRing B]
    [CommRing R] [Algebra A B] [Algebra A R] {ψ : R →+* B}
    (hψA : ψ.comp (algebraMap A R) = algebraMap A B) {IR : Ideal R} {J : Ideal B}
    (hmap : IR.map ψ = J) [IsPrecomplete IR R] [IsHausdorff (IR.map ψ) B] {ι : Type*}
    {f : MvPolynomial ι A →ₐ[A] B ⧸ J} (hf : Function.Surjective f) {x : ι → R}
    (hx : ∀ i, Ideal.Quotient.mk J (ψ (x i)) = f (MvPolynomial.X i)) :
    Function.Surjective ψ := by
  refine surjective_of_mk_map_comp_surjective (I := IR) ψ ?_
  rw [hmap]
  -- the reduction of `ψ` is an `A`-algebra map whose range contains the generators
  let ψA : R →ₐ[A] B := { ψ with commutes' := RingHom.congr_fun hψA }
  let q := (Ideal.Quotient.mkₐ A J).comp ψA
  have hle : Algebra.adjoin A (Set.range fun i ↦ f (MvPolynomial.X i)) ≤ q.range :=
    Algebra.adjoin_le <| by
      rintro _ ⟨i, rfl⟩
      exact ⟨x i, hx i⟩
  intro y
  obtain ⟨p, rfl⟩ := hf y
  have hp : f p ∈ Algebra.adjoin A (Set.range fun i ↦ f (MvPolynomial.X i)) := by
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact ⟨p, (RingHom.congr_fun (congrArg AlgHom.toRingHom (MvPolynomial.aeval_unique f))
      p).symm⟩
  obtain ⟨x, hx⟩ := hle hp
  exact ⟨x, by simpa [q, ψA] using hx⟩

end TauCeti
