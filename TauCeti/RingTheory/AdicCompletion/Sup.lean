module

public import TauCeti.RingTheory.AdicCompletion.Principal

/-!
# Completeness along a sum of ideals

A module that is `J₁`-adically and `J₂`-adically precomplete is `(J₁ ⊔ J₂)`-adically
precomplete. No finiteness hypothesis is needed: a power `(J₁ ⊔ J₂) ^ (2 n)` lies in
`J₁ ^ n ⊔ J₂ ^ n`, so the consecutive differences of a `(J₁ ⊔ J₂)`-adic Cauchy sequence split, along
a subsequence, into a `J₁`-adically and a `J₂`-adically convergent series.

Separatedness does not pass to the larger ideal `J₁ ⊔ J₂` in this way, but it does pass to every
smaller ideal. Together with the principal case `IsAdicComplete.span_singleton_of_mem`, this gives
the completeness theorem for finitely generated subideals: an `I`-adically complete module is
`J`-adically complete for every finitely generated `J ≤ I`. For instance, in mixed characteristic
`A_inf = W(O_C♭)` is complete for the ideal generated by any two of its nonunits: it is
`(p, [ϖ])`-adically complete for every nonunit `ϖ` of `O_C♭`, and any two nonunits of `A_inf` lie in
a common such ideal.

## Main results

* `IsPrecomplete.sup`: precompleteness passes from `J₁` and `J₂` to `J₁ ⊔ J₂`.
* `IsAdicComplete.of_fg_le`: an `I`-adically complete module is `J`-adically complete for every
  finitely generated ideal `J ≤ I`.
* `IsAdicComplete.span_pair_of_mem`: an `I`-adically complete module is `(r, s)`-adically complete
  for all `r, s ∈ I`.

## References

* The Stacks Project, Tag 090T.
-/

public section

open Finset

variable {R : Type*} [CommRing R] {I J₁ J₂ : Ideal R} {M : Type*} [AddCommGroup M] [Module R M]

/-- **Precompleteness along a sum of ideals.** A module that is `J₁`-adically and `J₂`-adically
precomplete is `(J₁ ⊔ J₂)`-adically precomplete. -/
instance IsPrecomplete.sup [IsPrecomplete J₁ M] [IsPrecomplete J₂ M] :
    IsPrecomplete (J₁ ⊔ J₂) M := by
  refine ⟨fun f hf ↦ ?_⟩
  -- Along the subsequence `f (2 n)`, consecutive differences lie in
  -- `(J₁ ⊔ J₂) ^ (2 n) M ≤ J₁ ^ n M + J₂ ^ n M`.
  have hd (n : ℕ) : ∃ x ∈ (J₁ ^ n • ⊤ : Submodule R M), ∃ y ∈ (J₂ ^ n • ⊤ : Submodule R M),
      x + y = f (2 * (n + 1)) - f (2 * n) := by
    have h := SModEq.sub_mem.mp (hf (show 2 * n ≤ 2 * (n + 1) by omega)).symm
    have hle : (J₁ ⊔ J₂) ^ (2 * n) • (⊤ : Submodule R M) ≤ J₁ ^ n • ⊤ ⊔ J₂ ^ n • ⊤ := by
      rw [← Submodule.sup_smul, two_mul]
      exact Submodule.smul_mono_left Ideal.sup_pow_add_le_pow_sup_pow
    exact Submodule.mem_sup.mp (hle h)
  choose x hx y hy hxy using hd
  -- Sum the two series separately, in the `J₁`-adic and the `J₂`-adic topology: partial sums of
  -- a series whose `k`-th term lies in `J ^ k M` are `J`-adically Cauchy.
  have hcauchy {J : Ideal R} {z : ℕ → M} (hz : ∀ k, z k ∈ (J ^ k • ⊤ : Submodule R M)) {m n : ℕ}
      (hmn : m ≤ n) :
      (∑ k ∈ range m, z k) ≡ ∑ k ∈ range n, z k [SMOD (J ^ m • ⊤ : Submodule R M)] := by
    rw [SModEq.sub_mem, ← sum_range_add_sum_Ico z hmn, sub_add_cancel_left, neg_mem_iff]
    exact Submodule.sum_mem _ fun k hk ↦
      Submodule.smul_mono_left (Ideal.pow_le_pow_right (mem_Ico.mp hk).1) (hz k)
  obtain ⟨A, hA⟩ := IsPrecomplete.prec' (I := J₁) _ fun h ↦ hcauchy hx h
  obtain ⟨B, hB⟩ := IsPrecomplete.prec' (I := J₂) _ fun h ↦ hcauchy hy h
  have htel (n : ℕ) : f (2 * n) = f 0 + ∑ k ∈ range n, x k + ∑ k ∈ range n, y k := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [sum_range_succ, sum_range_succ, sub_eq_iff_eq_add.mp (hxy n).symm, ih]
      abel
  refine ⟨f 0 + A + B, fun n ↦ ?_⟩
  have hmono {J : Ideal R} (hJ : J ≤ J₁ ⊔ J₂) :
      (J ^ n • ⊤ : Submodule R M) ≤ (J₁ ⊔ J₂) ^ n • ⊤ :=
    Submodule.smul_mono_left (Ideal.pow_right_mono hJ n)
  refine (hf (show n ≤ 2 * n by omega)).trans ?_
  rw [htel]
  exact ((SModEq.refl (f 0)).add ((hA n).mono (hmono le_sup_left))).add
    ((hB n).mono (hmono le_sup_right))

/-- **Completeness for finitely generated subideals** (Stacks, Tag 090T). An `I`-adically complete
module is `J`-adically complete for every finitely generated ideal `J ≤ I`. -/
theorem IsAdicComplete.of_fg_le [IsAdicComplete I M] {J : Ideal R} (hJ : J.FG) (hJI : J ≤ I) :
    IsAdicComplete J M := by
  classical
  refine { toIsHausdorff := .of_le hJI, toIsPrecomplete := ?_ }
  -- Precompleteness along `(a) ⊔ J'` follows from the principal case and induction.
  obtain ⟨s, rfl⟩ := hJ
  induction s using Finset.induction_on with
  | empty =>
    rw [coe_empty, Ideal.span_empty]
    infer_instance
  | insert a s _ ih =>
    rw [coe_insert, Ideal.span_insert] at hJI ⊢
    have := IsAdicComplete.span_singleton_of_mem (M := M)
      (hJI (Ideal.mem_sup_left (Ideal.mem_span_singleton_self a)))
    have := ih (le_sup_right.trans hJI)
    infer_instance

/-- An `I`-adically complete module is `(r, s)`-adically complete for all `r, s ∈ I`. -/
theorem IsAdicComplete.span_pair_of_mem [IsAdicComplete I M] {r s : R} (hr : r ∈ I)
    (hs : s ∈ I) : IsAdicComplete (Ideal.span {r, s}) M := by
  classical
  exact .of_fg_le ⟨{r, s}, by simp⟩ (Ideal.span_le.mpr (Set.insert_subset hr (by simpa using hs)))
