module

public import TauCeti.RingTheory.AdicCompletion.DiscreteValuationRing
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import TauCeti.RingTheory.DiscreteValuationRing.ValuedFractionField

import TauCeti.RingTheory.AdicCompletion.Algebra
import TauCeti.RingTheory.DiscreteValuationRing.MinimalPrime
import TauCeti.RingTheory.Valuation.AdicSeparated

/-!
# The completed generic field of an affine lift

Let `A` be a commutative ring and let `π` generate a prime ideal. The maximal ideal of the
localization at `(π)` is principal, so its completion is local, complete, and has residue field
canonically isomorphic to the fraction field of `A ⧸ (π)`.

If `A` is Noetherian and `π` is a nonzerodivisor, the localization is a discrete valuation ring,
even when `A` itself is not a domain. Its maximal-ideal completion is the valuation ring of the
completed generic field, obtained by inverting `π`. The field is complete for the normalized
discrete valuation.

For a smooth affine lift of an integral curve over a discrete valuation ring, this is the
completed generic field appearing in the study of differential equations. In particular, the
residue field of the lift of the affine line is the rational function field. The canonical map
from the coefficient field extends the structural map of the coefficient ring.

## References

* [N. Tsuzuki, *Minimal slope conjecture of F-isocrystals*](https://arxiv.org/abs/1910.03871v3),
  §3.1.
-/

public section

open IsLocalRing

namespace TauCeti.AdicCompletion

variable {A : Type*} [CommRing A] (π : A) [(Ideal.span {π}).IsPrime]

/-- The local ring at the generic point of the special fibre cut out by `π`. -/
abbrev genericLocalRing := Localization.AtPrime (Ideal.span {π})

/-- The integral ring of the completed generic field: the maximal-ideal completion of `A_(π)`. -/
abbrev completedGenericIntegers :=
  AdicCompletion (maximalIdeal (genericLocalRing π)) (genericLocalRing π)

/-- The maximal ideal of the generic local ring is generated by the image of `π`. -/
theorem maximalIdeal_genericLocalRing :
    maximalIdeal (genericLocalRing π) =
      Ideal.span {algebraMap A (genericLocalRing π) π} := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_span, Set.image_singleton]

/-- The maximal ideal of the generic local ring is finitely generated, so that the adic-completion
API for finitely generated ideals applies to the completed generic ring. -/
theorem fg_maximalIdeal_genericLocalRing :
    (maximalIdeal (genericLocalRing π)).FG := by
  rw [maximalIdeal_genericLocalRing]
  exact Submodule.fg_span_singleton _

/-- The completion at the principal maximal ideal is local without a Noetherian hypothesis. -/
instance : IsLocalRing (completedGenericIntegers π) :=
  _root_.AdicCompletion.isLocalRing_of_fg (fg_maximalIdeal_genericLocalRing π)

/-- The completion map is local without a Noetherian hypothesis. -/
instance : IsLocalHom (algebraMap (genericLocalRing π) (completedGenericIntegers π)) :=
  _root_.AdicCompletion.algebraMap_isLocalHom_of_fg (fg_maximalIdeal_genericLocalRing π)

/-- The original parameter generates the maximal ideal of the completed generic ring. -/
theorem maximalIdeal_completedGenericIntegers :
    maximalIdeal (completedGenericIntegers π) =
      Ideal.span {algebraMap A (completedGenericIntegers π) π} := by
  rw [_root_.AdicCompletion.maximalIdeal_eq_map_of_fg
    (fg_maximalIdeal_genericLocalRing π)]
  exact (congrArg (Ideal.map
    (algebraMap (genericLocalRing π) (completedGenericIntegers π)))
    (maximalIdeal_genericLocalRing π)).trans (by
      rw [Ideal.map_span, Set.image_singleton]
      rfl)

/-- Every element of the completed generic ring is congruent modulo the maximal ideal to the image
of an element of the generic local ring. -/
theorem exists_sub_algebraMap_mem_maximalIdeal_completedGenericIntegers
    (x : completedGenericIntegers π) :
    ∃ y : genericLocalRing π, x - algebraMap _ _ y ∈ maximalIdeal (completedGenericIntegers π) := by
  obtain ⟨y, hy⟩ := _root_.AdicCompletion.exists_sub_algebraMap_mem_map_pow
    (fg_maximalIdeal_genericLocalRing π) 1 x
  rw [pow_one, ← _root_.AdicCompletion.maximalIdeal_eq_map_of_fg
    (fg_maximalIdeal_genericLocalRing π)] at hy
  exact ⟨y, hy⟩

/-- The completed generic ring is separated and complete for its maximal ideal. -/
instance isAdicComplete_maximalIdeal_completedGenericIntegers :
    IsAdicComplete (maximalIdeal (completedGenericIntegers π)) (completedGenericIntegers π) :=
  _root_.AdicCompletion.isAdicComplete_of_fg (fg_maximalIdeal_genericLocalRing π)

/-- The completed generic ring is separated and complete for its `π`-adic filtration. -/
theorem isAdicComplete_completedGenericIntegers :
    IsAdicComplete (Ideal.span {algebraMap A (completedGenericIntegers π) π})
      (completedGenericIntegers π) := by
  rw [← maximalIdeal_completedGenericIntegers]
  exact isAdicComplete_maximalIdeal_completedGenericIntegers π

/-- The residue field of the completed generic ring is the function field of the original
special fibre. -/
noncomputable def completedGenericResidueEquiv :
    ResidueField (completedGenericIntegers π) ≃+* FractionRing (A ⧸ Ideal.span {π}) :=
  (RingEquiv.ofBijective
    (ResidueField.map (algebraMap (genericLocalRing π) (completedGenericIntegers π)))
    (_root_.AdicCompletion.residueField_map_bijective_of_fg
      (fg_maximalIdeal_genericLocalRing π))).symm.trans
      (FractionRing.algEquiv (A ⧸ Ideal.span {π}) (Ideal.span {π}).ResidueField).symm.toRingEquiv

/-- The canonical residue-field identification agrees with reduction of the original affine ring. -/
@[simp]
theorem completedGenericResidueEquiv_residue_algebraMap (a : A) :
    completedGenericResidueEquiv π
      (residue (completedGenericIntegers π) (algebraMap A (completedGenericIntegers π) a)) =
        algebraMap (A ⧸ Ideal.span {π}) (FractionRing (A ⧸ Ideal.span {π}))
          (Ideal.Quotient.mk _ a) := by
  apply (FractionRing.algEquiv (A ⧸ Ideal.span {π}) (Ideal.span {π}).ResidueField).injective
  dsimp only [completedGenericResidueEquiv, RingEquiv.trans_apply]
  rw [AlgEquiv.coe_toRingEquiv, AlgEquiv.apply_symm_apply, AlgEquiv.commutes,
    Ideal.algebraMap_quotient_residueField_mk]
  apply (RingEquiv.ofBijective
    (ResidueField.map (algebraMap (genericLocalRing π) (completedGenericIntegers π)))
    (_root_.AdicCompletion.residueField_map_bijective_of_fg
      (fg_maximalIdeal_genericLocalRing π))).symm_apply_eq.mpr
  rw [IsScalarTower.algebraMap_apply A (genericLocalRing π) (completedGenericIntegers π)]
  exact (ResidueField.map_residue _ (algebraMap A (genericLocalRing π) a)).symm

variable [IsNoetherianRing A]

/-- The generic local ring is regular when its defining parameter is a nonzerodivisor. -/
theorem isRegularLocalRing_genericLocalRing (hπ : π ∈ nonZeroDivisors A) :
    IsRegularLocalRing (genericLocalRing π) := by
  apply TauCeti.isRegularLocalRing_of_mem_minimalPrimes (𝔭 := Ideal.span {π}) _ hπ
  simp [Ideal.minimalPrimes_eq_subsingleton_self]

/-- The completion of the generic local ring is regular, hence a domain. -/
theorem isRegularLocalRing_completedGenericIntegers (hπ : π ∈ nonZeroDivisors A) :
    IsRegularLocalRing (completedGenericIntegers π) := by
  let := isRegularLocalRing_genericLocalRing π hπ
  infer_instance

/-- The generic local ring is a discrete valuation ring with uniformizer `π`. -/
theorem isDiscreteValuationRing_genericLocalRing (hπ : π ∈ nonZeroDivisors A) :
    letI := isRegularLocalRing_genericLocalRing π hπ
    IsDiscreteValuationRing (genericLocalRing π) := by
  let := isRegularLocalRing_genericLocalRing π hπ
  apply TauCeti.isDiscreteValuationRing_of_mem_minimalPrimes (𝔭 := Ideal.span {π}) _ hπ
  simp [Ideal.minimalPrimes_eq_subsingleton_self]

/-- The ring of integers of the completed generic field is a discrete valuation ring. -/
theorem isDiscreteValuationRing_completedGenericIntegers (hπ : π ∈ nonZeroDivisors A) :
    letI := isRegularLocalRing_completedGenericIntegers π hπ
    IsDiscreteValuationRing (completedGenericIntegers π) := by
  let := isRegularLocalRing_genericLocalRing π hπ
  let := isDiscreteValuationRing_genericLocalRing π hπ
  infer_instance

/-- The image of `π` is a uniformizer in the completed generic ring. -/
theorem irreducible_completedGenericIntegers (hπ : π ∈ nonZeroDivisors A) :
    Irreducible (algebraMap A (completedGenericIntegers π) π) := by
  let := isRegularLocalRing_completedGenericIntegers π hπ
  let := isDiscreteValuationRing_completedGenericIntegers π hπ
  rw [IsDiscreteValuationRing.irreducible_iff_uniformizer, maximalIdeal_completedGenericIntegers]

/-- The fraction field of the completed generic ring. The nonzerodivisor hypothesis ensures
that this particular completion is a domain and therefore gives a field structure. -/
noncomputable def completedGenericField (hπ : π ∈ nonZeroDivisors A) :=
  let _ := isRegularLocalRing_completedGenericIntegers π hπ
  FractionRing (completedGenericIntegers π)

noncomputable instance (hπ : π ∈ nonZeroDivisors A) : Field (completedGenericField π hπ) := by
  let := isRegularLocalRing_completedGenericIntegers π hπ
  exact inferInstanceAs (Field (FractionRing (completedGenericIntegers π)))

noncomputable instance (hπ : π ∈ nonZeroDivisors A) {R : Type*} [CommSemiring R]
    [Algebra R (completedGenericIntegers π)] : Algebra R (completedGenericField π hπ) :=
  inferInstanceAs (Algebra R (FractionRing (completedGenericIntegers π)))

instance (hπ : π ∈ nonZeroDivisors A) :
    IsFractionRing (completedGenericIntegers π) (completedGenericField π hπ) :=
  inferInstanceAs (IsFractionRing (completedGenericIntegers π)
    (FractionRing (completedGenericIntegers π)))

instance (hπ : π ∈ nonZeroDivisors A) {R : Type*} [CommSemiring R]
    [Algebra R (completedGenericIntegers π)] :
    IsScalarTower R (completedGenericIntegers π) (completedGenericField π hπ) :=
  inferInstanceAs (IsScalarTower R (completedGenericIntegers π)
    (FractionRing (completedGenericIntegers π)))

/-- Inverting the parameter in the completed generic ring gives its fraction field. -/
theorem isLocalizationAway_completedGenericField (hπ : π ∈ nonZeroDivisors A) :
    IsLocalization.Away (algebraMap A (completedGenericIntegers π) π)
      (completedGenericField π hπ) := by
  let := isRegularLocalRing_completedGenericIntegers π hπ
  let := isDiscreteValuationRing_completedGenericIntegers π hπ
  let := isAdicComplete_completedGenericIntegers π
  exact TauCeti.PreValuationRing.isLocalization_away_of_isFractionRing
    (irreducible_completedGenericIntegers π hπ).ne_zero _

section Valuation

open scoped WithZero

/-- The completed generic field carries the normalized valuation of its integral ring. -/
noncomputable instance (hπ : π ∈ nonZeroDivisors A) :
    Valued (completedGenericField π hπ) ℤᵐ⁰ := by
  let := isRegularLocalRing_completedGenericIntegers π hπ
  let := isDiscreteValuationRing_completedGenericIntegers π hπ
  exact Valued.mk' ((IsDiscreteValuationRing.maximalIdeal
    (completedGenericIntegers π)).valuation (completedGenericField π hπ))

instance (hπ : π ∈ nonZeroDivisors A) :
    (Valued.v : Valuation (completedGenericField π hπ) ℤᵐ⁰).IsRankOneDiscrete := by
  let := isRegularLocalRing_completedGenericIntegers π hπ
  let := isDiscreteValuationRing_completedGenericIntegers π hπ
  exact inferInstanceAs (((IsDiscreteValuationRing.maximalIdeal
    (completedGenericIntegers π)).valuation (completedGenericField π hπ)).IsRankOneDiscrete)

/-- The original parameter has additive valuation one in the completed generic field. -/
theorem valuation_completedGenericField_algebraMap (hπ : π ∈ nonZeroDivisors A) :
    Valued.v (algebraMap A (completedGenericField π hπ) π) = WithZero.exp (-1 : ℤ) := by
  let := isRegularLocalRing_completedGenericIntegers π hπ
  let := isDiscreteValuationRing_completedGenericIntegers π hπ
  rw [IsScalarTower.algebraMap_apply A (completedGenericIntegers π)]
  let m := IsDiscreteValuationRing.maximalIdeal (completedGenericIntegers π)
  exact (m.valuation_of_algebraMap (K := completedGenericField π hπ) _).trans
    (m.intValuation_singleton (irreducible_completedGenericIntegers π hπ).ne_zero
      (maximalIdeal_completedGenericIntegers π))

/-- The integral completion maps onto the valuation ring of the completed generic field. -/
theorem completedGenericField_integers (hπ : π ∈ nonZeroDivisors A) :
    (Valued.v : Valuation (completedGenericField π hπ) ℤᵐ⁰).Integers
      (completedGenericIntegers π) := by
  let := isRegularLocalRing_completedGenericIntegers π hπ
  let := isDiscreteValuationRing_completedGenericIntegers π hπ
  exact ⟨IsFractionRing.injective _ _,
    (IsDiscreteValuationRing.maximalIdeal (completedGenericIntegers π)).valuation_le_one,
    fun _ ↦ IsDiscreteValuationRing.exists_lift_of_le_one⟩

/-- The completed generic field is complete in its discrete valuation topology. -/
instance (hπ : π ∈ nonZeroDivisors A) : CompleteSpace (completedGenericField π hπ) := by
  let := isRegularLocalRing_completedGenericIntegers π hπ
  let := isDiscreteValuationRing_completedGenericIntegers π hπ
  let v := (IsDiscreteValuationRing.maximalIdeal (completedGenericIntegers π)).valuation
    (completedGenericField π hπ)
  have heq : v.IsEquiv v := fun _ _ ↦ Iff.rfl
  exact (WithVal.uniformEquiv (w := v) rfl heq).completeSpace_iff.mp
    (TauCeti.IsDiscreteValuationRing.completeSpace_withVal_of_isAdicComplete
      (completedGenericField π hπ))

end Valuation

section Coefficients

variable {O K : Type*} [CommRing O] [CommRing K] [Algebra O A] [Algebra O K]
  (ϖ : O) [(Ideal.span {algebraMap O A ϖ}).IsPrime]
  (hϖ : algebraMap O A ϖ ∈ nonZeroDivisors A) [IsLocalization.Away ϖ K]

/-- The coefficient localization maps to the actual completed generic field of the affine lift.
In particular, this embeds the fraction field of a discrete valuation coefficient ring when
`ϖ` is its uniformizer. -/
noncomputable def completedGenericFieldScalarHom :
    K →ₐ[O] completedGenericField (algebraMap O A ϖ) hϖ := by
  let := isRegularLocalRing_completedGenericIntegers (algebraMap O A ϖ) hϖ
  apply IsLocalization.Away.liftAlgHom ϖ
    (f := Algebra.ofId O (completedGenericField (algebraMap O A ϖ) hϖ))
  apply isUnit_iff_ne_zero.mpr
  rw [Algebra.ofId_apply, IsScalarTower.algebraMap_apply O
    (completedGenericIntegers (algebraMap O A ϖ))
    (completedGenericField (algebraMap O A ϖ) hϖ)]
  rw [ne_eq, IsFractionRing.to_map_eq_zero_iff]
  rw [IsScalarTower.algebraMap_apply O A (completedGenericIntegers (algebraMap O A ϖ))]
  exact (irreducible_completedGenericIntegers (algebraMap O A ϖ) hϖ).ne_zero

end Coefficients

end TauCeti.AdicCompletion
