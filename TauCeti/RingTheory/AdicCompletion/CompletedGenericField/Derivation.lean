module

public import TauCeti.RingTheory.AdicCompletion.CompletedGenericField.Basic
public import TauCeti.RingTheory.Derivation.AdicCompletion
import TauCeti.RingTheory.Derivation.Localization

/-!
# Derivations of the completed generic field

Let `A` be a commutative `R`-algebra and `π ∈ A` an element generating a prime ideal, with
generic local ring `A_(π)`, its completion `Ô` and, when `π` is a nonzerodivisor of a Noetherian
`A`, the completed generic field `E = Ô[1/π]`. Every `R`-derivation `D` of `A_(π)` extends to an
`R`-derivation of `Ô` and then to an `R`-derivation of `E`; the extension to `E` maps `Ô` into
itself. Both extensions are unique: a derivation of `Ô` is determined by its values on `A`, and so
is a derivation of `E` mapping the valuation ring into itself.

For a smooth affine lift `A` of a curve over a discrete valuation ring with uniformizer `π`, and
`x ∈ A` reducing to a generically étale coordinate, the differentials of `A_(π)` are generated by
`dx`; the derivation `d / dx` of `A_(π)` therefore extends to the completed generic field, where it
is the derivation of the generic differential modules and of their Taylor expansions. A derivation
of `A` itself first extends to `A_(π)` by `Derivation.extendOfIsLocalization`.

Extending to a completion requires no continuity hypothesis on `D`: by the Leibniz rule every
derivation maps the `(n + 1)`-st power of an ideal into its `n`-th power
(`Derivation.adicCompletion`). Uniqueness on the field does require a condition. For
`A = ℤ_(p)` and `π = p` the completed generic field is `ℚ_[p]`, which is transcendental over `ℚ`, so
it has nonzero derivations vanishing on `A`; none of them maps the valuation ring `ℤ_[p]` into
itself.

## Main definitions

* `TauCeti.AdicCompletion.completedGenericIntegersDerivation`: the extension of a derivation of
  `A_(π)` to the completion `Ô`.
* `TauCeti.AdicCompletion.completedGenericFieldDerivation`: its extension to the completed generic
  field.

## Main results

* `TauCeti.AdicCompletion.completedGenericIntegersDerivation_algebraMap` and
  `TauCeti.AdicCompletion.completedGenericFieldDerivation_algebraMap_genericLocalRing`: the
  extensions extend `D`.
* `TauCeti.AdicCompletion.completedGenericFieldDerivation_algebraMap`: the derivation of `E`
  restricts to the derivation of `Ô`.
* `TauCeti.AdicCompletion.completedGenericIntegers_derivation_ext`: a derivation of `Ô` is
  determined by its values on `A`.
* `TauCeti.AdicCompletion.completedGenericField_derivation_ext`: a derivation of `E` mapping the
  valuation ring into itself is determined by its values on `A`.

## References

* [N. Tsuzuki, *Minimal slope conjecture of F-isocrystals*](https://arxiv.org/abs/1910.03871v3),
  §3.1.
-/

public section

open IsLocalRing

namespace TauCeti.AdicCompletion

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] (π : A) [(Ideal.span {π}).IsPrime]

section Integers

/-- The extension of an `R`-derivation of the generic local ring `A_(π)` to its completion: the
derivation `Derivation.adicCompletion` of the maximal-ideal completion, as a derivation of the ring
`completedGenericIntegers π` with values in itself. -/
noncomputable def completedGenericIntegersDerivation
    (D : Derivation R (genericLocalRing π) (genericLocalRing π)) :
    Derivation R (completedGenericIntegers π) (completedGenericIntegers π) :=
  D.adicCompletion (maximalIdeal (genericLocalRing π))

/-- The extension of `D` to the completion agrees with `D` on the generic local ring. -/
@[simp]
theorem completedGenericIntegersDerivation_algebraMap
    (D : Derivation R (genericLocalRing π) (genericLocalRing π)) (x : genericLocalRing π) :
    completedGenericIntegersDerivation π D
        (algebraMap (genericLocalRing π) (completedGenericIntegers π) x) =
      algebraMap (genericLocalRing π) (completedGenericIntegers π) (D x) := by
  simp only [completedGenericIntegersDerivation, _root_.AdicCompletion.algebraMap_apply,
    Algebra.algebraMap_self, RingHom.id_apply]
  exact Derivation.adicCompletion_of _ D x

/-- An `R`-derivation of the completed generic ring is determined by its values on `A`. -/
theorem completedGenericIntegers_derivation_ext
    {D₁ D₂ : Derivation R (completedGenericIntegers π) (completedGenericIntegers π)}
    (h : ∀ a : A, D₁ (algebraMap A (completedGenericIntegers π) a) =
      D₂ (algebraMap A (completedGenericIntegers π) a)) : D₁ = D₂ := by
  refine Derivation.adicCompletion_ext _ (fg_maximalIdeal_genericLocalRing π) fun x ↦ ?_
  -- both derivations agree on the localization `A_(π)` of `A`
  have hloc := IsLocalization.eq_of_leibniz (Ideal.span {π}).primeCompl
    (T := genericLocalRing π)
    (δ₁ := D₁.compAlgebraMap (genericLocalRing π)) (δ₂ := D₂.compAlgebraMap (genericLocalRing π))
    (fun x y ↦ Derivation.leibniz _ x y) (fun x y ↦ Derivation.leibniz _ x y) fun a ↦ by
      simpa only [Derivation.compAlgebraMap_apply, ← IsScalarTower.algebraMap_apply] using h a
  have hx := congrFun hloc x
  simp only [Derivation.compAlgebraMap_apply, _root_.AdicCompletion.algebraMap_apply,
    Algebra.algebraMap_self, RingHom.id_apply] at hx
  exact hx

/-- The extension of `D` to the completion is the only derivation of the completed generic ring
agreeing with `D` on `A`. -/
theorem eq_completedGenericIntegersDerivation
    (D : Derivation R (genericLocalRing π) (genericLocalRing π))
    {D' : Derivation R (completedGenericIntegers π) (completedGenericIntegers π)}
    (h : ∀ a : A, D' (algebraMap A (completedGenericIntegers π) a) =
      algebraMap (genericLocalRing π) (completedGenericIntegers π)
        (D (algebraMap A (genericLocalRing π) a))) :
    D' = completedGenericIntegersDerivation π D :=
  completedGenericIntegers_derivation_ext π fun a ↦ by
    rw [h, IsScalarTower.algebraMap_apply A (genericLocalRing π) (completedGenericIntegers π),
      completedGenericIntegersDerivation_algebraMap]

end Integers

section Field

variable [IsNoetherianRing A] (hπ : π ∈ nonZeroDivisors A)

/-- The extension of an `R`-derivation of the generic local ring `A_(π)` to the completed generic
field. It maps the valuation ring into itself, where it is
`TauCeti.AdicCompletion.completedGenericIntegersDerivation`. -/
noncomputable def completedGenericFieldDerivation
    (D : Derivation R (genericLocalRing π) (genericLocalRing π)) :
    Derivation R (completedGenericField π hπ) (completedGenericField π hπ) :=
  ((Algebra.linearMap (completedGenericIntegers π) (completedGenericField π hπ)).compDer
    (completedGenericIntegersDerivation π D)).extendOfIsLocalization
      (nonZeroDivisors (completedGenericIntegers π))

/-- On the valuation ring, the derivation of the completed generic field is the derivation of the
completed generic ring. -/
@[simp]
theorem completedGenericFieldDerivation_algebraMap
    (D : Derivation R (genericLocalRing π) (genericLocalRing π))
    (x : completedGenericIntegers π) :
    completedGenericFieldDerivation π hπ D
        (algebraMap (completedGenericIntegers π) (completedGenericField π hπ) x) =
      algebraMap (completedGenericIntegers π) (completedGenericField π hπ)
        (completedGenericIntegersDerivation π D x) := by
  simp [completedGenericFieldDerivation]

/-- The derivation of the completed generic field agrees with `D` on the generic local ring. -/
@[simp]
theorem completedGenericFieldDerivation_algebraMap_genericLocalRing
    (D : Derivation R (genericLocalRing π) (genericLocalRing π)) (x : genericLocalRing π) :
    completedGenericFieldDerivation π hπ D
        (algebraMap (genericLocalRing π) (completedGenericField π hπ) x) =
      algebraMap (genericLocalRing π) (completedGenericField π hπ) (D x) := by
  simp only [IsScalarTower.algebraMap_apply (genericLocalRing π) (completedGenericIntegers π)
    (completedGenericField π hπ), completedGenericFieldDerivation_algebraMap,
    completedGenericIntegersDerivation_algebraMap]

/-- The derivation of the completed generic field maps the valuation ring into itself. -/
theorem valuation_completedGenericFieldDerivation_le_one
    (D : Derivation R (genericLocalRing π) (genericLocalRing π)) {x : completedGenericField π hπ}
    (hx : Valued.v x ≤ 1) : Valued.v (completedGenericFieldDerivation π hπ D x) ≤ 1 := by
  obtain ⟨y, rfl⟩ := (completedGenericField_integers π hπ).exists_of_le_one hx
  rw [completedGenericFieldDerivation_algebraMap]
  exact (completedGenericField_integers π hπ).map_le_one _

/-- The values on the valuation ring of a derivation of the completed generic field mapping the
valuation ring into itself, as elements of the valuation ring. -/
private noncomputable def restrictIntegersFun (D : Derivation R (completedGenericField π hπ)
    (completedGenericField π hπ)) (hD : ∀ x, Valued.v x ≤ 1 → Valued.v (D x) ≤ 1)
    (x : completedGenericIntegers π) : completedGenericIntegers π :=
  ((completedGenericField_integers π hπ).exists_of_le_one
    (hD _ ((completedGenericField_integers π hπ).map_le_one x))).choose

private theorem algebraMap_restrictIntegersFun (D : Derivation R (completedGenericField π hπ)
    (completedGenericField π hπ)) (hD : ∀ x, Valued.v x ≤ 1 → Valued.v (D x) ≤ 1)
    (x : completedGenericIntegers π) :
    algebraMap _ (completedGenericField π hπ) (restrictIntegersFun π hπ D hD x) =
      D (algebraMap _ (completedGenericField π hπ) x) :=
  ((completedGenericField_integers π hπ).exists_of_le_one
    (hD _ ((completedGenericField_integers π hπ).map_le_one x))).choose_spec

/-- The restriction to the valuation ring of a derivation of the completed generic field mapping
the valuation ring into itself. -/
private noncomputable def restrictIntegers (D : Derivation R (completedGenericField π hπ)
    (completedGenericField π hπ)) (hD : ∀ x, Valued.v x ≤ 1 → Valued.v (D x) ≤ 1) :
    Derivation R (completedGenericIntegers π) (completedGenericIntegers π) where
  toFun := restrictIntegersFun π hπ D hD
  map_add' x y := (completedGenericField_integers π hπ).hom_inj (by
    simp only [algebraMap_restrictIntegersFun, map_add])
  map_smul' r x := (completedGenericField_integers π hπ).hom_inj (by
    simp only [algebraMap_restrictIntegersFun, RingHom.id_apply, Algebra.smul_def, map_mul,
      ← IsScalarTower.algebraMap_apply, Derivation.leibniz, Derivation.map_algebraMap, mul_zero,
      add_zero])
  map_one_eq_zero' := (completedGenericField_integers π hπ).hom_inj (by
    simp only [LinearMap.coe_mk, AddHom.coe_mk, algebraMap_restrictIntegersFun, map_one,
      Derivation.map_one_eq_zero, map_zero])
  leibniz' x y := (completedGenericField_integers π hπ).hom_inj (by
    simp only [LinearMap.coe_mk, AddHom.coe_mk, algebraMap_restrictIntegersFun, map_mul,
      Derivation.leibniz, map_add, smul_eq_mul])

private theorem algebraMap_restrictIntegers (D : Derivation R (completedGenericField π hπ)
    (completedGenericField π hπ)) (hD : ∀ x, Valued.v x ≤ 1 → Valued.v (D x) ≤ 1)
    (x : completedGenericIntegers π) :
    algebraMap _ (completedGenericField π hπ) (restrictIntegers π hπ D hD x) =
      D (algebraMap _ (completedGenericField π hπ) x) :=
  algebraMap_restrictIntegersFun π hπ D hD x
/-- An `R`-derivation of the completed generic field mapping the valuation ring into itself is
determined by its values on `A`. -/
theorem completedGenericField_derivation_ext
    {D₁ D₂ : Derivation R (completedGenericField π hπ) (completedGenericField π hπ)}
    (hD₁ : ∀ x, Valued.v x ≤ 1 → Valued.v (D₁ x) ≤ 1)
    (hD₂ : ∀ x, Valued.v x ≤ 1 → Valued.v (D₂ x) ≤ 1)
    (h : ∀ a : A, D₁ (algebraMap A (completedGenericField π hπ) a) =
      D₂ (algebraMap A (completedGenericField π hπ) a)) : D₁ = D₂ := by
  -- the restrictions to the valuation ring agree on `A`, hence everywhere
  have hint : restrictIntegers π hπ D₁ hD₁ = restrictIntegers π hπ D₂ hD₂ :=
    completedGenericIntegers_derivation_ext π fun a ↦ (completedGenericField_integers π hπ).hom_inj
      (by simpa only [algebraMap_restrictIntegers, ← IsScalarTower.algebraMap_apply] using h a)
  -- and the field is the fraction field of the valuation ring
  refine Derivation.ext <| congrFun <| IsLocalization.eq_of_leibniz
    (nonZeroDivisors (completedGenericIntegers π)) (fun x y ↦ D₁.leibniz x y)
    (fun x y ↦ D₂.leibniz x y) fun x ↦ ?_
  rw [← algebraMap_restrictIntegers π hπ D₁ hD₁, ← algebraMap_restrictIntegers π hπ D₂ hD₂, hint]

/-- The derivation of the completed generic field extending `D` is the only derivation mapping
the valuation ring into itself and agreeing with `D` on `A`. -/
theorem eq_completedGenericFieldDerivation
    (D : Derivation R (genericLocalRing π) (genericLocalRing π))
    {D' : Derivation R (completedGenericField π hπ) (completedGenericField π hπ)}
    (hD' : ∀ x, Valued.v x ≤ 1 → Valued.v (D' x) ≤ 1)
    (h : ∀ a : A, D' (algebraMap A (completedGenericField π hπ) a) =
      algebraMap (genericLocalRing π) (completedGenericField π hπ)
        (D (algebraMap A (genericLocalRing π) a))) :
    D' = completedGenericFieldDerivation π hπ D :=
  completedGenericField_derivation_ext π hπ hD'
    (fun _ ↦ valuation_completedGenericFieldDerivation_le_one π hπ D) fun a ↦ by
      rw [h, IsScalarTower.algebraMap_apply A (completedGenericIntegers π)
          (completedGenericField π hπ),
        IsScalarTower.algebraMap_apply A (genericLocalRing π) (completedGenericIntegers π),
        completedGenericFieldDerivation_algebraMap, completedGenericIntegersDerivation_algebraMap,
        ← IsScalarTower.algebraMap_apply]

end Field

end TauCeti.AdicCompletion
