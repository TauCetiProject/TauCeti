module

public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
import TauCeti.RingTheory.AdicCompletion.Algebra
import TauCeti.RingTheory.AdicCompletion.Noetherian
import TauCeti.RingTheory.Flat.LocalCriterion

/-!
# Flatness of the completion of an unramified-maximal-ideal local algebra

Let `R` be a Noetherian local ring and `S` a flat local `R`-algebra whose maximal ideal is
generated by `maximalIdeal R`, without assuming that `S` itself is Noetherian. Because
`maximalIdeal S` is finitely generated and `S ⧸ maximalIdeal S` is a field, the completion
`AdicCompletion (maximalIdeal S) S` is a Noetherian local ring. Modulo `maximalIdeal R ^ n`,
this completion agrees with `S ⧸ maximalIdeal S ^ n = S ⧸ maximalIdeal R ^ n S`, which is flat
over `R ⧸ maximalIdeal R ^ n`. By the infinitesimal local criterion for flatness
(`Module.Flat.of_forall_flat_quotient_pow`), `AdicCompletion (maximalIdeal S) S` is flat — hence
faithfully flat — over `R`.

This applies both to the pointed étale colimit underlying strict henselization before its own
Noetherianity is established and to local extensions with arbitrary residue field extensions
(*ÉGA III*, Chap. 0, 10.3.1), where `S` has infinite transcendence or inseparable residue degree.

## Main results

* `AdicCompletion.maximalIdeal_eq_map_base_of_map_maximalIdeal_eq` and
  `AdicCompletion.isLocalHom_algebraMap_base_of_map_maximalIdeal_eq`: the maximal ideal of
  `AdicCompletion (maximalIdeal S) S` is generated by `maximalIdeal R`, and `R → AdicCompletion` is
  a local homomorphism.
* `AdicCompletion.flat_of_map_maximalIdeal_eq`: `AdicCompletion (maximalIdeal S) S` is flat over
  `R`.
* `AdicCompletion.faithfullyFlat_of_map_maximalIdeal_eq`: `AdicCompletion (maximalIdeal S) S` is
  faithfully flat over `R`.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique III*, Chapitre 0,
  Proposition 10.3.1.
* [Stacks Project, Lemma 10.99.8](https://stacks.math.columbia.edu/tag/0523).
-/

public section

open IsLocalRing

namespace AdicCompletion

variable {R S : Type*} [CommRing R] [IsLocalRing R] [CommRing S] [IsLocalRing S] [Algebra R S]

/-- When `(maximalIdeal R).FG` and `maximalIdeal R` generates `maximalIdeal S`, the maximal ideal
of `AdicCompletion (maximalIdeal S) S` is also generated by `maximalIdeal R`. -/
theorem maximalIdeal_eq_map_base_of_map_maximalIdeal_eq (hR : (maximalIdeal R).FG)
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    let _ := AdicCompletion.isLocalRing_of_fg (h ▸ hR.map (algebraMap R S))
    maximalIdeal (AdicCompletion (maximalIdeal S) S) =
      (maximalIdeal R).map (algebraMap R (AdicCompletion (maximalIdeal S) S)) := by
  intro _
  have hfg : (maximalIdeal S).FG := h ▸ hR.map (algebraMap R S)
  rw [AdicCompletion.maximalIdeal_eq_map_of_fg hfg,
    IsScalarTower.algebraMap_eq R S (AdicCompletion (maximalIdeal S) S), ← Ideal.map_map, h]

/-- When `(maximalIdeal R).FG` and `maximalIdeal R` generates `maximalIdeal S`, the structure map
`R → AdicCompletion (maximalIdeal S) S` is a local homomorphism. -/
theorem isLocalHom_algebraMap_base_of_map_maximalIdeal_eq (hR : (maximalIdeal R).FG)
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    IsLocalHom (algebraMap R (AdicCompletion (maximalIdeal S) S)) := by
  have := AdicCompletion.isLocalRing_of_fg (h ▸ hR.map (algebraMap R S))
  exact ((local_hom_tfae _).out 1 3).mpr
    (maximalIdeal_eq_map_base_of_map_maximalIdeal_eq hR h).ge

/-- If `R` is a Noetherian local ring and `S` is a flat local `R`-algebra with
`(maximalIdeal R).map (algebraMap R S) = maximalIdeal S`, then the completion
`AdicCompletion (maximalIdeal S) S` is flat over `R`, without assuming `S` is Noetherian. -/
theorem flat_of_map_maximalIdeal_eq [IsNoetherianRing R] [Module.Flat R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    Module.Flat R (AdicCompletion (maximalIdeal S) S) := by
  set J := maximalIdeal S
  set C := AdicCompletion J S
  have hfg : J.FG := h ▸ (maximalIdeal R).fg_of_isNoetherianRing.map _
  have : IsNoetherianRing C := IsLocalRing.isNoetherianRing_adicCompletion_of_fg hfg
  refine Module.Flat.of_forall_flat_quotient_pow (S := C) (I := maximalIdeal R) ?_ fun n ↦ ?_
  · have := AdicCompletion.isAdicComplete_self J hfg
    rw [IsScalarTower.algebraMap_eq R S C, ← Ideal.map_map, h, Ideal.jacobson_bot]
    exact IsAdicComplete.le_jacobson _
  · set P := maximalIdeal R ^ n
    have hPC : (P • ⊤ : Submodule R C) = ((J ^ n).map (algebraMap S C)).restrictScalars R := by
      rw [Ideal.smul_top_eq_map, IsScalarTower.algebraMap_eq R S C, ← Ideal.map_map,
        Ideal.map_pow, h]
    have hPS : (P • ⊤ : Submodule R S) = (J ^ n).restrictScalars R := by
      rw [Ideal.smul_top_eq_map, Ideal.map_pow, h]
    let e : (C ⧸ (P • ⊤ : Submodule R C)) ≃ₗ[R] S ⧸ (P • ⊤ : Submodule R S) :=
      (Submodule.quotEquivOfEq _ _ hPC ≪≫ₗ Submodule.Quotient.restrictScalarsEquiv R _ ≪≫ₗ
        (AdicCompletion.quotientMapPowAlgEquiv hfg n).toLinearEquiv.restrictScalars R) ≪≫ₗ
      (Submodule.quotEquivOfEq _ _ hPS ≪≫ₗ
        Submodule.Quotient.restrictScalarsEquiv R _).symm
    exact .of_linearEquiv (e.extendScalarsOfSurjective Ideal.Quotient.mk_surjective)

/-- Under the hypotheses of `AdicCompletion.flat_of_map_maximalIdeal_eq`, the completion
`AdicCompletion (maximalIdeal S) S` is faithfully flat over `R`. -/
theorem faithfullyFlat_of_map_maximalIdeal_eq [IsNoetherianRing R] [Module.Flat R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    Module.FaithfullyFlat R (AdicCompletion (maximalIdeal S) S) := by
  have hR : (maximalIdeal R).FG := (maximalIdeal R).fg_of_isNoetherianRing
  have := AdicCompletion.isLocalRing_of_fg (h ▸ hR.map (algebraMap R S))
  have := isLocalHom_algebraMap_base_of_map_maximalIdeal_eq hR h
  have := flat_of_map_maximalIdeal_eq h
  exact Module.FaithfullyFlat.of_flat_of_isLocalHom

end AdicCompletion
