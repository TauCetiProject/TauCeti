/-!
# Flatness of the completion of an algebra along an extended ideal

Let `R` be a Noetherian commutative ring and `S` a flat `R`-algebra. Given ideals `I` of `R` and
`J` of `S` with `I.map (algebraMap R S) = J` and `S ⧸ J` Noetherian — without assuming that `S`
itself is Noetherian — `J` is finitely generated, so the completion `AdicCompletion J S` is
Noetherian (`Ideal.isNoetherianRing_adicCompletion_of_fg`). Modulo `I ^ n`, this completion agrees
with `S ⧸ J ^ n = S ⧸ I ^ n S`, which is flat over `R ⧸ I ^ n`. By the infinitesimal local
criterion for flatness (`Module.Flat.of_forall_flat_quotient_pow`), `AdicCompletion J S` is flat
over `R`.

When `R` and `S` are local rings and `(maximalIdeal R).map (algebraMap R S) = maximalIdeal S`, the
quotient `S ⧸ maximalIdeal S` is a field, so `AdicCompletion (maximalIdeal S) S` is flat — hence
faithfully flat — over `R`. This generalizes `TauCeti.StrictHenselization.flat_adicCompletion` in
`TauCeti/RingTheory/StrictHenselization/Noetherian.lean` from the pointed étale colimit to
arbitrary flat algebras, covering in particular local extensions with arbitrary residue field
extensions (*ÉGA III*, Chap. 0, 10.3.1), where `S` may have infinite transcendence or inseparable
residue degree.

## Main results

* `TauCeti.AdicCompletion.flat_of_map_eq`: if `R` is Noetherian, `S` is flat over `R`,
  `I.map (algebraMap R S) = J`, and `S ⧸ J` is Noetherian, then `AdicCompletion J S` is flat
  over `R`.
* `TauCeti.AdicCompletion.maximalIdeal_eq_map_base_of_map_maximalIdeal_eq` and
  `TauCeti.AdicCompletion.isLocalHom_algebraMap_base_of_map_maximalIdeal_eq`: the maximal ideal of
  `AdicCompletion (maximalIdeal S) S` is generated by `maximalIdeal R`, and `R → AdicCompletion` is
  a local homomorphism.
* `TauCeti.AdicCompletion.flat_of_map_maximalIdeal_eq`: `AdicCompletion (maximalIdeal S) S` is flat
  over `R`.
* `TauCeti.AdicCompletion.faithfullyFlat_of_map_maximalIdeal_eq`:
  `AdicCompletion (maximalIdeal S) S` is faithfully flat over `R`.

## References

* H. Matsumura, *Commutative Ring Theory*, Theorem 22.3 (the local criterion for flatness).
* [Stacks Project, Tag 00MK](https://stacks.math.columbia.edu/tag/00MK).
* [Stacks Project, Tag 06LJ](https://stacks.math.columbia.edu/tag/06LJ).
* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique III*, Chapitre 0,
  Proposition 10.3.1.
-/

public section

open IsLocalRing

namespace TauCeti.AdicCompletion

/-- If `R` is a Noetherian ring, `S` is a flat `R`-algebra, `I.map (algebraMap R S) = J`, and
`S ⧸ J` is Noetherian, then `AdicCompletion J S` is flat over `R`, without assuming `S` itself is
Noetherian. Adapted from the pointed étale colimit argument in
`TauCeti/RingTheory/StrictHenselization/Noetherian.lean`. -/
theorem flat_of_map_eq {R S : Type*} [CommRing R] [IsNoetherianRing R] [CommRing S] [Algebra R S]
    [Module.Flat R S] {I : Ideal R} {J : Ideal S} [IsNoetherianRing (S ⧸ J)]
    (h : I.map (algebraMap R S) = J) :
    Module.Flat R (_root_.AdicCompletion J S) := by
  set C := _root_.AdicCompletion J S
  have hfg : J.FG := h ▸ I.fg_of_isNoetherianRing.map _
  have : IsNoetherianRing C := Ideal.isNoetherianRing_adicCompletion_of_fg J hfg
  refine Module.Flat.of_forall_flat_quotient_pow (S := C) (I := I) ?_ fun n ↦ ?_
  · have := _root_.AdicCompletion.isAdicComplete_self J hfg
    rw [IsScalarTower.algebraMap_eq R S C, ← Ideal.map_map, h, Ideal.jacobson_bot]
    exact IsAdicComplete.le_jacobson _
  · set P := I ^ n
    have hPC : (P • ⊤ : Submodule R C) = ((J ^ n).map (algebraMap S C)).restrictScalars R := by
      rw [Ideal.smul_top_eq_map, IsScalarTower.algebraMap_eq R S C, ← Ideal.map_map,
        Ideal.map_pow, h]
    have hPS : (P • ⊤ : Submodule R S) = (J ^ n).restrictScalars R := by
      rw [Ideal.smul_top_eq_map, Ideal.map_pow, h]
    let e : (C ⧸ (P • ⊤ : Submodule R C)) ≃ₗ[R] S ⧸ (P • ⊤ : Submodule R S) :=
      (Submodule.quotEquivOfEq _ _ hPC ≪≫ₗ Submodule.Quotient.restrictScalarsEquiv R _ ≪≫ₗ
        (_root_.AdicCompletion.quotientMapPowAlgEquiv hfg n).toLinearEquiv.restrictScalars R) ≪≫ₗ
      (Submodule.quotEquivOfEq _ _ hPS ≪≫ₗ
        Submodule.Quotient.restrictScalarsEquiv R _).symm
    exact .of_linearEquiv (e.extendScalarsOfSurjective Ideal.Quotient.mk_surjective)

section LocalRing

variable {R S : Type*} [CommRing R] [IsLocalRing R] [CommRing S] [IsLocalRing S] [Algebra R S]

/-- When `(maximalIdeal R).FG` and `maximalIdeal R` generates `maximalIdeal S`, the maximal ideal
of `AdicCompletion (maximalIdeal S) S` is also generated by `maximalIdeal R`. -/
theorem maximalIdeal_eq_map_base_of_map_maximalIdeal_eq (hR : (maximalIdeal R).FG)
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    let _ := _root_.AdicCompletion.isLocalRing_of_fg (h ▸ hR.map (algebraMap R S))
    maximalIdeal (_root_.AdicCompletion (maximalIdeal S) S) =
      (maximalIdeal R).map (algebraMap R (_root_.AdicCompletion (maximalIdeal S) S)) := by
  intro _
  have hfg : (maximalIdeal S).FG := h ▸ hR.map (algebraMap R S)
  rw [_root_.AdicCompletion.maximalIdeal_eq_map_of_fg hfg,
    IsScalarTower.algebraMap_eq R S (_root_.AdicCompletion (maximalIdeal S) S), ← Ideal.map_map, h]

/-- When `(maximalIdeal R).FG` and `maximalIdeal R` generates `maximalIdeal S`, the structure map
`R → AdicCompletion (maximalIdeal S) S` is a local homomorphism. -/
theorem isLocalHom_algebraMap_base_of_map_maximalIdeal_eq (hR : (maximalIdeal R).FG)
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    IsLocalHom (algebraMap R (_root_.AdicCompletion (maximalIdeal S) S)) := by
  have := _root_.AdicCompletion.isLocalRing_of_fg (h ▸ hR.map (algebraMap R S))
  exact ((local_hom_tfae _).out 1 3).mpr
    (maximalIdeal_eq_map_base_of_map_maximalIdeal_eq hR h).ge

/-- If `R` is a Noetherian local ring and `S` is a flat local `R`-algebra with
`(maximalIdeal R).map (algebraMap R S) = maximalIdeal S`, then the completion
`AdicCompletion (maximalIdeal S) S` is flat over `R`, without assuming `S` is Noetherian.
Generalizes the pointed étale colimit flatness step in
`TauCeti/RingTheory/StrictHenselization/Noetherian.lean`. -/
theorem flat_of_map_maximalIdeal_eq [IsNoetherianRing R] [Module.Flat R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    Module.Flat R (_root_.AdicCompletion (maximalIdeal S) S) := by
  let _ := Ideal.Quotient.field (maximalIdeal S)
  exact flat_of_map_eq h

/-- Under the hypotheses of `TauCeti.AdicCompletion.flat_of_map_maximalIdeal_eq`, the completion
`AdicCompletion (maximalIdeal S) S` is faithfully flat over `R`. -/
theorem faithfullyFlat_of_map_maximalIdeal_eq [IsNoetherianRing R] [Module.Flat R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    Module.FaithfullyFlat R (_root_.AdicCompletion (maximalIdeal S) S) := by
  have hR : (maximalIdeal R).FG := (maximalIdeal R).fg_of_isNoetherianRing
  have := _root_.AdicCompletion.isLocalRing_of_fg (h ▸ hR.map (algebraMap R S))
  have := isLocalHom_algebraMap_base_of_map_maximalIdeal_eq hR h
  have := flat_of_map_maximalIdeal_eq h
  exact Module.FaithfullyFlat.of_flat_of_isLocalHom

end LocalRing

end TauCeti.AdicCompletion
