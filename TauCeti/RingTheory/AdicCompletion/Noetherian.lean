/-!
# Noetherianity of adically complete rings and of adic completions

A ring `R` that is `I`-adically complete for a finitely generated ideal `I` is Noetherian as soon
as `R ⧸ I` is. Consequently the adic completion of a Noetherian ring is Noetherian, and more
generally the completion along a finitely generated ideal `I` is Noetherian when `R ⧸ I` is. These
are the noetherianity inputs for adic rings of finite ideal type and for rings of definition of
Huber rings, where completions of Noetherian rings appear throughout.

The complete-ring criterion supplies the Noetherian rings of definition needed when constructing
adic rings, while its completion specialization applies directly to completions of Noetherian
rings and to finitely generated ideals with Noetherian quotient.

## Main results

* `Ideal.isNoetherianRing_of_isAdicComplete`: an `I`-adically complete ring with `I`
  finitely generated and `R ⧸ I` Noetherian is Noetherian.
* `Ideal.isNoetherianRing_adicCompletion_of_fg`: the completion along a finitely generated ideal
  `I` is Noetherian when `R ⧸ I` is.
* `Ideal.isNoetherianRing_adicCompletion`: the adic completion of a Noetherian ring is Noetherian.
* `Ideal.isNoetherianRing_of_isAdicComplete_of_denseRange`: an `I`-adically complete ring with
  separately continuous addition and `I` finitely generated and open is Noetherian as soon as it
  receives a ring map with dense range from a Noetherian semiring. This is the form used for
  topological completions.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique I*, Ch. 0, 7.2.6 and
  7.2.12.
* M. F. Atiyah, I. G. Macdonald, *Introduction to Commutative Algebra*, Chapter 10.
-/

public section

open MvPolynomial

variable {R : Type*} [CommRing R] {I : Ideal R}

namespace TauCeti

/-- Successive approximation in a complete ring: if every element of `J ∩ I ^ n` agrees modulo
`I ^ (n + 1)` with a combination of the `g i` whose coefficients lie in `I ^ (n - D)`, then the
`g i` generate `J`. -/
private theorem le_span_of_forall_exists_sub_mem_pow [IsAdicComplete I R] {ι : Type*} [Fintype ι]
    (g : ι → R) {J : Ideal R} (D : ℕ)
    (h : ∀ n, ∀ x ∈ J ⊓ I ^ n, ∃ c : ι → R, (∀ i, c i ∈ I ^ (n - D)) ∧
      x - ∑ i, c i * g i ∈ J ⊓ I ^ (n + 1)) :
    J ≤ Ideal.span (Set.range g) := by
  intro x hx
  choose c hc hrem using fun n (y : ↥(J ⊓ I ^ n)) ↦ h n y.1 y.2
  -- The remainders after `n` correction steps, and the accumulated coefficients.
  let y : ∀ n, ↥(J ⊓ I ^ n) := fun n ↦
    Nat.rec ⟨x, hx, by simp⟩ (fun n yn ↦ ⟨yn.1 - ∑ i, c n yn i * g i, hrem n yn⟩) n
  let s : ℕ → ι → R := fun k i ↦ ∑ n ∈ Finset.range k, c n (y n) i
  have hs (k : ℕ) : x - ∑ i, s k i * g i = (y k).1 := by
    induction k with
    | zero => simp [s, y]
    | succ k ih =>
      simp only [s, Finset.sum_range_succ, add_mul, Finset.sum_add_distrib, ← sub_sub]
      rw [ih]
  have hsub (i : ι) {m k : ℕ} (hmk : m ≤ k) : s k i - s m i ∈ I ^ (m - D) := by
    have hsum : s k i - s m i = ∑ n ∈ Finset.Ico m k, c n (y n) i := by
      simpa only [s] using (Finset.sum_Ico_eq_sub (fun n ↦ c n (y n) i) hmk).symm
    rw [hsum]
    refine Ideal.sum_mem _ fun n hn ↦ Ideal.pow_le_pow_right ?_ (hc n (y n) i)
    have := (Finset.mem_Ico.mp hn).1
    omega
  have hcauchy (i : ι) {m k : ℕ} (hmk : m ≤ k) :
      s (m + D) i ≡ s (k + D) i [SMOD (I ^ m • ⊤ : Submodule R R)] := by
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top, ← neg_mem_iff, neg_sub]
    simpa using hsub i (Nat.add_le_add_right hmk D)
  choose L hL using fun i ↦ IsPrecomplete.prec inferInstance (hcauchy i)
  have hx : x - ∑ i, L i * g i = 0 := by
    refine IsHausdorff.haus' (I := I) _ fun k ↦ ?_
    rw [SModEq.sub_mem, sub_zero, smul_eq_mul, Ideal.mul_top]
    have hLk (i : ι) : s (k + D) i - L i ∈ I ^ k := by
      simpa [SModEq.sub_mem] using hL i k
    have : x - ∑ i, L i * g i = (y (k + D)).1 + ∑ i, (s (k + D) i - L i) * g i := by
      rw [← hs (k + D)]
      simp [sub_mul, Finset.sum_sub_distrib]
    rw [this]
    exact add_mem (Ideal.pow_le_pow_right (Nat.le_add_right k D) (y (k + D)).2.2)
      (Ideal.sum_mem _ fun i _ ↦ Ideal.mul_mem_right _ _ (hLk i))
  rw [sub_eq_zero] at hx
  rw [hx, Ideal.mem_span_range_iff_exists_fun]
  exact ⟨L, rfl⟩

variable {σ : Type*} (f : σ → R) (J : Ideal R)

/-- Homogeneous polynomials whose value at `f` lies in `J + I ^ (n + 1)`, where `n` is the degree
and `I` is the ideal generated by `f`: lifts of the initial forms of elements of `J`. -/
private def initialForms : Set (MvPolynomial σ R) :=
  {p | ∃ n, p.IsHomogeneous n ∧ aeval f p ∈ J ⊔ Ideal.span (Set.range f) ^ (n + 1)}

/-- The lifts of initial forms generate a finitely generated ideal when `σ` is finite and
`R ⧸ (f)` is Noetherian: the ideal contains the extension of `(f)`, and the quotient by that
extension is a polynomial ring over `R ⧸ (f)`. -/
private theorem fg_span_initialForms [Finite σ]
    [IsNoetherianRing (R ⧸ Ideal.span (Set.range f))] :
    (Ideal.span (initialForms f J)).FG := by
  set I := Ideal.span (Set.range f)
  have hKS : Ideal.map C I ≤ Ideal.span (initialForms f J) :=
    Ideal.map_le_iff_le_comap.mpr fun a ha ↦
      Ideal.subset_span ⟨0, isHomogeneous_C _ a, Ideal.mem_sup_right (by simpa using ha)⟩
  have : IsNoetherianRing (MvPolynomial σ R ⧸ Ideal.map C I) :=
    isNoetherianRing_of_ringEquiv _ (quotientEquivQuotientMvPolynomial I).toRingEquiv
  refine Ideal.fg_of_fg_map_of_fg_inf_ker_of_surjective (f := Ideal.Quotient.mk (Ideal.map C I))
    ((isNoetherianRing_iff_ideal_fg _).mp this _) ?_ Ideal.Quotient.mk_surjective
  rw [Ideal.mk_ker, inf_eq_right.mpr hKS]
  exact Ideal.FG.map (Submodule.fg_span (Set.finite_range f)) C

/-- One reduction step: if finitely many lifts of initial forms `t`, of degrees `d t` and with
values congruent to `g t ∈ J` modulo `I ^ (d t + 1)`, generate all lifts of initial forms, then an
element of `J ∩ I ^ n` is a combination of the `g t` modulo `I ^ (n + 1)`, with coefficients in
`I ^ (n - D)` for any bound `D` of the degrees. -/
private theorem exists_sub_mem_pow_succ {T : Finset (MvPolynomial σ R)}
    (hST : Ideal.span (initialForms f J) = Ideal.span T) {d : T → ℕ}
    (hd : ∀ t : T, (t : MvPolynomial σ R).IsHomogeneous (d t)) {g : T → R} (hgJ : ∀ t, g t ∈ J)
    (hge : ∀ t : T, aeval f (t : MvPolynomial σ R) - g t ∈ Ideal.span (Set.range f) ^ (d t + 1))
    {D : ℕ} (hD : ∀ t, d t ≤ D) (n : ℕ) (x : R) (hx : x ∈ J ⊓ Ideal.span (Set.range f) ^ n) :
    ∃ c : T → R, (∀ t, c t ∈ Ideal.span (Set.range f) ^ (n - D)) ∧
      x - ∑ t, c t * g t ∈ J ⊓ Ideal.span (Set.range f) ^ (n + 1) := by
  set I := Ideal.span (Set.range f) with hIf
  have hmem (m : ℕ) (q : MvPolynomial σ R) : aeval f (homogeneousComponent m q) ∈ I ^ m := by
    rw [hIf, Ideal.span_pow_eq_map_homogeneousSubmodule]
    exact Submodule.mem_map_of_mem (homogeneousComponent_mem m q)
  obtain ⟨p, hp, rfl⟩ : ∃ p ∈ homogeneousSubmodule σ R n, aeval f p = x := by
    simpa [hIf, Ideal.span_pow_eq_map_homogeneousSubmodule] using hx.2
  have hpT : p ∈ Ideal.span (Set.range ((↑) : T → MvPolynomial σ R)) := by
    rw [Subtype.range_coe_subtype, Finset.setOfPred_mem, ← hST]
    exact Ideal.subset_span ⟨n, hp, Ideal.mem_sup_left hx.1⟩
  obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hpT
  -- The coefficient of `g t` is the value of the degree-`(n - d t)` component of `a t`.
  let c (t : T) : R := if d t ≤ n then aeval f (homogeneousComponent (n - d t) (a t)) else 0
  have hc (t : T) : c t * (aeval f (t : MvPolynomial σ R) - g t) ∈ I ^ (n + 1) := by
    by_cases ht : d t ≤ n
    · simp only [c, ht, ↓reduceIte]
      have hn : n + 1 = n - d t + (d t + 1) := by omega
      rw [hn, pow_add]
      exact Ideal.mul_mem_mul (hmem _ _) (hge t)
    · simp [c, ht]
  have hpc : aeval f p = ∑ t, c t * aeval f (t : MvPolynomial σ R) := by
    have : p = ∑ t : T, homogeneousComponent n (a t * (t : MvPolynomial σ R)) := by
      rw [← map_sum, ha, homogeneousComponent_eq_self ((mem_homogeneousSubmodule n p).mp hp)]
    rw [this, map_sum]
    refine Finset.sum_congr rfl fun t _ ↦ ?_
    rw [(hd t).homogeneousComponent_mul_right]
    split_ifs <;> simp [c, *]
  refine ⟨c, fun t ↦ ?_, ?_, ?_⟩
  · by_cases ht : d t ≤ n
    · simp only [c, ht, ↓reduceIte]
      exact Ideal.pow_le_pow_right (by have := hD t; omega) (hmem _ _)
    · simp [c, ht]
  · exact sub_mem hx.1 (Ideal.sum_mem _ fun t _ ↦ Ideal.mul_mem_left _ _ (hgJ t))
  · rw [hpc, ← Finset.sum_sub_distrib]
    exact Ideal.sum_mem _ fun t _ ↦ by simpa [mul_sub] using hc t

end TauCeti

namespace Ideal

/-- **Noetherianity of complete rings.** A ring that is `I`-adically complete for a finitely
generated ideal `I` is Noetherian as soon as `R ⧸ I` is Noetherian. -/
theorem isNoetherianRing_of_isAdicComplete (I : Ideal R) (hI : I.FG) [IsAdicComplete I R]
    [IsNoetherianRing (R ⧸ I)] : IsNoetherianRing R := by
  rw [isNoetherianRing_iff_ideal_fg]
  intro J
  obtain ⟨r, f, rfl⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
  obtain ⟨T, hTS, hST⟩ :=
    (Submodule.fg_span_iff_fg_span_finset_subset _).mp (TauCeti.fg_span_initialForms f J)
  -- Each generator `t` has a degree `d t` and a value congruent to some `g t ∈ J`.
  have hT (t : T) : ∃ d, (t : MvPolynomial (Fin r) R).IsHomogeneous d ∧
      ∃ g ∈ J, aeval f (t : MvPolynomial (Fin r) R) - g ∈ Ideal.span (Set.range f) ^ (d + 1) := by
    obtain ⟨d, hd, hmem⟩ := hTS t.2
    obtain ⟨g, hg, e, he, hge⟩ := Submodule.mem_sup.mp hmem
    exact ⟨d, hd, g, hg, by rwa [← hge, add_sub_cancel_left]⟩
  choose d hd g hgJ hge using hT
  have hJ : J ≤ Ideal.span (Set.range g) :=
    TauCeti.le_span_of_forall_exists_sub_mem_pow (I := Ideal.span (Set.range f)) g
      (Finset.univ.sup d) (TauCeti.exists_sub_mem_pow_succ f J hST hd hgJ hge fun t ↦
        Finset.le_sup (Finset.mem_univ t))
  rw [le_antisymm hJ (Ideal.span_le.mpr (Set.range_subset_iff.mpr hgJ))]
  exact Submodule.fg_span (Set.finite_range g)

variable (I)

/-- The adic completion along a finitely generated ideal `I` is Noetherian as soon as `R ⧸ I` is:
it is complete for the extended ideal `I • R̂`, with quotient `R̂ ⧸ I • R̂ ≃ R ⧸ I`. -/
theorem isNoetherianRing_adicCompletion_of_fg (hI : I.FG) [IsNoetherianRing (R ⧸ I)] :
    IsNoetherianRing (AdicCompletion I R) := by
  have := AdicCompletion.isAdicComplete_self I hI
  have : IsNoetherianRing (AdicCompletion I R ⧸ I.map (algebraMap R (AdicCompletion I R))) :=
    isNoetherianRing_of_ringEquiv _
      ((Ideal.quotEquivOfEq (AdicCompletion.ker_evalOneₐ_eq_map I hI)).symm.trans
        (RingHom.quotientKerEquivOfSurjective (AdicCompletion.evalOneₐ_surjective I))).symm
  exact Ideal.isNoetherianRing_of_isAdicComplete
    (I.map (algebraMap R (AdicCompletion I R))) (hI.map _)

/-- The adic completion of a Noetherian ring along any ideal is Noetherian. -/
instance isNoetherianRing_adicCompletion [IsNoetherianRing R] :
    IsNoetherianRing (AdicCompletion I R) :=
  isNoetherianRing_adicCompletion_of_fg I (IsNoetherian.noetherian I)

variable {I} in
/-- **Noetherianity of complete rings with a dense Noetherian subsemiring.** A ring with separately
continuous addition that is `I`-adically complete for a finitely generated open ideal `I` is
Noetherian as soon as it receives a ring homomorphism with dense range from a Noetherian
semiring. -/
theorem isNoetherianRing_of_isAdicComplete_of_denseRange [TopologicalSpace R]
    [SeparatelyContinuousAdd R] (hI : I.FG) (hIo : IsOpen (I : Set R)) [IsAdicComplete I R]
    {A : Type*} [Semiring A] [IsNoetherianRing A] {f : A →+* R} (hf : DenseRange f) :
    IsNoetherianRing R := by
  have hsurj : Function.Surjective ((Ideal.Quotient.mk I).comp f) := by
    refine Ideal.Quotient.mk_surjective.forall.mpr fun y ↦ ?_
    -- the coset `y + I` is open and nonempty, so it meets the dense range of `f`
    have hU : IsOpen {z : R | z - y ∈ I} := by
      simp_rw [sub_eq_add_neg]
      exact hIo.preimage (continuous_add_const (-y))
    obtain ⟨a, ha⟩ := hf.exists_mem_open hU ⟨y, by simp⟩
    exact ⟨a, Ideal.Quotient.eq.mpr ha⟩
  have := isNoetherianRing_of_surjective A (R ⧸ I) _ hsurj
  exact isNoetherianRing_of_isAdicComplete I hI

end Ideal
