/-!
# Regular systems of parameters adapted to a regular quotient

For a regular local ring with regular quotient by an arbitrary ideal, construct a minimal
generating family of the maximal ideal whose initial segment generates that ideal.
This gives local equations for a regular quotient as part of a minimal system of parameters,
including the zero ideal and zero-dimensional cases.

## Main results

* `Ideal.exists_regularSystem_of_quotient`: the full generating family,
  including the zero-ideal and zero-dimensional cases;
* `Ideal.spanFinrank_add_spanFinrank_maximalIdeal_quotient`: for a regular quotient of a
  Noetherian local ring, the ideal and the maximal ideal of the quotient together need exactly
  as many generators as the maximal ideal;
* `Ideal.exists_eq_span_singleton_of_height_eq_one`: a height-one ideal whose quotient is again
  regular is generated by a single element of `𝔪 \ 𝔪²`;
* `Ideal.isPrincipal_of_height_eq_one`: such an ideal is principal.

The parameter-selection input is `Ideal.exists_mem_notMem_maximalIdeal_sq_of_quotient` in
`TauCeti.RingTheory.RegularLocalRing.Basic`.

## References

* [Stacks Project, Lemma 10.106.4](https://stacks.math.columbia.edu/tag/00NR).
-/

public section

open IsLocalRing Ideal Pointwise IsRegularLocalRing

universe u

namespace Ideal

section Noetherian

private theorem spanFinrank_add_spanFinrank_maximalIdeal_quotient_le (dimension : ℕ) :
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R],
    (maximalIdeal R).spanFinrank = dimension →
    ∀ (I : Ideal R) [IsRegularLocalRing (R ⧸ I)],
    I.spanFinrank + (maximalIdeal (R ⧸ I)).spanFinrank ≤ (maximalIdeal R).spanFinrank := by
  induction dimension using Nat.strong_induction_on with
  | ind dimension induction =>
    intro R _ _ _ hdimension I _
    have hfg := (maximalIdeal R).fg_of_isNoetherianRing
    have hI : I ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp inferInstance
    by_cases hsq : I ≤ maximalIdeal R ^ 2
    · -- Then `R` is regular, with the same embedding dimension as `R ⧸ I`, so `I = 0`.
      have hemb : (maximalIdeal (R ⧸ I)).spanFinrank = (maximalIdeal R).spanFinrank := by
        rw [← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
        exact TauCeti.IsLocalRing.spanFinrank_map_maximalIdeal_quotient_of_le_sq hfg hsq
      have : IsRegularLocalRing R := .of_spanFinrank_maximalIdeal_le _ <| by
        rw [← hemb, spanFinrank_maximalIdeal]
        exact ringKrullDim_quotient_le I
      obtain rfl : I = ⊥ := by
        by_contra hbot
        obtain ⟨parameter, hmem, hsquare⟩ := exists_mem_notMem_maximalIdeal_sq_of_quotient I hbot
        exact hsquare (hsq hmem)
      simp [hemb]
    -- Otherwise divide out by an element of `I \ 𝔪²`, which drops the embedding dimension.
    obtain ⟨parameter, hmem, hsquare⟩ := Set.not_subset.mp hsq
    have hle : span {parameter} ≤ I := (span_singleton_le_iff_mem _).mpr hmem
    set q := Ideal.Quotient.mk (span {parameter})
    have : Nontrivial (R ⧸ span {parameter}) :=
      Ideal.Quotient.nontrivial_iff.mpr (ne_top_of_le_ne_top hI hle)
    have : IsLocalRing (R ⧸ span {parameter}) := .of_surjective' q Ideal.Quotient.mk_surjective
    let e := DoubleQuot.quotQuotEquivQuotOfLE hle
    have : IsRegularLocalRing ((R ⧸ span {parameter}) ⧸ I.map q) := .of_ringEquiv e.symm
    have hdrop := TauCeti.IsLocalRing.spanFinrank_map_maximalIdeal_quotient_add_one_le hfg
      (le_maximalIdeal hI hmem) hsquare
    rw [map_maximalIdeal_of_surjective q Ideal.Quotient.mk_surjective] at hdrop
    have hind := induction _ (by omega) (R ⧸ span {parameter}) rfl (I.map q)
    have hemb : (maximalIdeal ((R ⧸ span {parameter}) ⧸ I.map q)).spanFinrank =
        (maximalIdeal (R ⧸ I)).spanFinrank := by
      have := ringKrullDim_eq_of_ringEquiv e
      rw [← spanFinrank_maximalIdeal, ← spanFinrank_maximalIdeal] at this
      exact_mod_cast this
    have hgen : I.spanFinrank ≤ (I.map q).spanFinrank + 1 :=
      (spanFinrank_le_spanFinrank_map_add_spanFinrank hle (Submodule.fg_span_singleton _)).trans
        (Nat.add_le_add_left ((Submodule.spanFinrank_span_le_ncard_of_finite
          (Set.finite_singleton _)).trans (Set.ncard_singleton _).le) _)
    omega

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- If `R ⧸ I` is a regular local ring, then the numbers of generators of `I` and of the maximal
ideal of `R ⧸ I` add up to the number of generators of the maximal ideal of `R`. -/
theorem spanFinrank_add_spanFinrank_maximalIdeal_quotient (I : Ideal R)
    [IsRegularLocalRing (R ⧸ I)] :
    I.spanFinrank + (maximalIdeal (R ⧸ I)).spanFinrank = (maximalIdeal R).spanFinrank := by
  refine le_antisymm (spanFinrank_add_spanFinrank_maximalIdeal_quotient_le _ R rfl I) ?_
  have hI : I ≤ maximalIdeal R := le_maximalIdeal (Ideal.Quotient.nontrivial_iff.mp inferInstance)
  rw [add_comm, ← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
  exact spanFinrank_le_spanFinrank_map_add_spanFinrank hI I.fg_of_isNoetherianRing

end Noetherian

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

private theorem exists_regularSystem_aux (dimension : ℕ) :
    ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R],
    (maximalIdeal R).spanFinrank = dimension →
    ∀ (I : Ideal R) [IsRegularLocalRing (R ⧸ I)],
    ∃ size count : ℕ, ∃ generators : Fin size → R,
      count ≤ size ∧ span (Set.range generators) = maximalIdeal R ∧
      (maximalIdeal R).spanFinrank = size ∧
      I = span (generators '' {index | (index : ℕ) < count}) := by
  classical
  induction dimension using Nat.strong_induction_on with
  | ind dimension induction =>
    intro R _ _ hdimension I _
    by_cases hzero : I = ⊥
    · obtain ⟨generators, hspan⟩ :=
        (Submodule.FG.spanFinrank_le_iff_exists_fin_generating_family
          (maximalIdeal R).fg_of_isNoetherianRing _).mp le_rfl
      exact ⟨_, 0, generators, Nat.zero_le _, hspan, rfl, by simp [hzero]⟩
    obtain ⟨parameter, hmem, hsquare⟩ := exists_mem_notMem_maximalIdeal_sq_of_quotient I hzero
    have hmax : parameter ∈ maximalIdeal R :=
      le_maximalIdeal (Ideal.Quotient.nontrivial_iff.mp inferInstance) hmem
    have hparameter : parameter ≠ 0 := fun heq ↦ hsquare (heq ▸ (zero_mem _))
    let quotient := R ⧸ span {parameter}
    let quotientMap := Ideal.Quotient.mk (span {parameter})
    have : IsRegularLocalRing quotient :=
      TauCeti.IsRegularLocalRing.quotient_span_singleton hmax hsquare
    have hle : span {parameter} ≤ I := (span_singleton_le_iff_mem _).mpr hmem
    have : IsRegularLocalRing (quotient ⧸ I.map quotientMap) :=
      .of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hle).symm
    have hdrop : (maximalIdeal quotient).spanFinrank + 1 = (maximalIdeal R).spanFinrank :=
      TauCeti.IsRegularLocalRing.spanFinrank_maximalIdeal_quotient_span_singleton_add_one hparameter
    obtain ⟨size, count, generators, hcount, hspan, hsize, hideal⟩ :=
      induction (maximalIdeal quotient).spanFinrank (by omega) quotient rfl
        (I.map quotientMap)
    choose lifts hlifts using fun index ↦ Ideal.Quotient.mk_surjective (generators index)
    have hcomp : quotientMap ∘ lifts = generators := funext hlifts
    refine ⟨size + 1, count + 1, Fin.cons parameter lifts, Nat.add_le_add_right hcount 1,
      ?_, by omega, ?_⟩
    · rw [Fin.range_cons]
      apply span_insert_eq_of_quotient _ hmax
      rw [← Set.range_comp, hcomp, hspan]
      exact (map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective).symm
    · simp only [Order.lt_add_one_iff, Fin.image_cons_le_eq_insert]
      symm
      apply span_insert_eq_of_quotient _ hmem
      rw [← Set.image_comp, hcomp, ← hideal]

/-- A regular quotient is cut out by an initial segment of a regular system of parameters.
The family has exactly the embedding dimension many entries and generates the maximal ideal.
No dimension or generating-family hypothesis is imposed on the ideal. -/
@[stacks 00NR]
theorem exists_regularSystem_of_quotient (I : Ideal R)
    [IsRegularLocalRing (R ⧸ I)] :
    ∃ size count : ℕ, ∃ generators : Fin size → R,
      count ≤ size ∧ span (Set.range generators) = maximalIdeal R ∧
      (maximalIdeal R).spanFinrank = size ∧
      I = span (generators '' {index | (index : ℕ) < count}) :=
  exists_regularSystem_aux _ R rfl I

/-- **A height-one ideal with regular quotient is generated by one parameter.** Let `R` be a
regular local ring and let `p` be an ideal of height one with `R ⧸ p` again a regular local ring.
Then `p` is generated by a single element of `𝔪 \ 𝔪²`, where `𝔪` is the maximal ideal of `R`.
(Such a `p` is automatically prime, since `R ⧸ p` is a domain.)

This is the codimension-one case of `Ideal.exists_regularSystem_of_quotient`. -/
@[stacks 00NR "(codimension one)"]
theorem exists_eq_span_singleton_of_height_eq_one {p : Ideal R}
    [IsRegularLocalRing (R ⧸ p)] (h1 : p.height = 1) :
    ∃ x ∈ maximalIdeal R, x ∉ maximalIdeal R ^ 2 ∧ p = span {x} := by
  have : p.IsPrime :=
    (Quotient.isDomain_iff_prime p).mp TauCeti.IsRegularLocalRing.isDomain
  obtain ⟨x, hxp, hx2⟩ :=
    exists_mem_notMem_maximalIdeal_sq_of_quotient p (ne_bot_of_height_eq_one h1)
  have hxm : x ∈ maximalIdeal R := le_maximalIdeal_of_isPrime p hxp
  have hxprime : Prime x :=
    (span_singleton_prime <| by rintro rfl; exact hx2 (zero_mem _)).mp
      (TauCeti.IsRegularLocalRing.span_singleton_isPrime_of_notMem_sq hxm hx2)
  exact ⟨x, hxm, hx2, eq_span_singleton_of_height_eq_one h1 hxp hxprime⟩

/-- **A height-one ideal with regular quotient is principal.** See
`Ideal.exists_eq_span_singleton_of_height_eq_one` for the generator in `𝔪 \ 𝔪²`. -/
@[stacks 00NR "(codimension one)"]
theorem isPrincipal_of_height_eq_one {p : Ideal R} [IsRegularLocalRing (R ⧸ p)]
    (h1 : p.height = 1) : p.IsPrincipal :=
  let ⟨x, _, _, hx⟩ := exists_eq_span_singleton_of_height_eq_one h1
  ⟨x, hx⟩

end Ideal
