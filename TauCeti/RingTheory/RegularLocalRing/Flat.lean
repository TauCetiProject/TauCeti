module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Unramified.LocalRing
public import TauCeti.RingTheory.KrullDimension.Fiber
public import TauCeti.RingTheory.LocalRing.MaximalIdeal.Flat

import Mathlib.RingTheory.Flat.Localization
import TauCeti.RingTheory.Ideal.Quotient.Operations

/-!
# Regularity along flat homomorphisms

Let `R → S` be a flat local homomorphism of Noetherian local rings. If `R` and the closed fibre
`S ⧸ 𝔪_R S` are regular, then so is `S`: the maximal ideal of `S` is generated by the images of
generators of `𝔪_R` together with lifts of generators of the maximal ideal of `S ⧸ 𝔪_R S`, and by
the dimension formula `dim S = dim R + dim S ⧸ 𝔪_R S` there are at most `dim S` of these. Applied
at every prime, regularity ascends from a regular ring `R` to a flat Noetherian `R`-algebra whose
fibres `κ(p) ⊗[R] S` are regular rings, for instance to a Noetherian regular algebra in the sense
of `TauCeti.Excellence.RegularAlgebraMap`.

When the maximal ideal of `R` generates the maximal ideal of `S`, so that the closed fibre is a
field, `R` is regular if and only if `S` is: the maximal ideals of `R` and `S` need the same number
of generators, and `R` and `S` have the same Krull dimension. The descent of regularity applies for
instance to the completion of a Noetherian local ring. Formally unramified local homomorphisms
essentially of finite type satisfy this hypothesis on the maximal ideals, so regularity ascends
along local homomorphisms of this kind which are flat, such as the localizations of étale algebras
at primes. This is the local input for showing that an algebra smooth over a regular ring is
regular.

## Main declarations

* `TauCeti.IsRegularLocalRing.of_flat_of_quotient_map_maximalIdeal`: regularity ascends along a
  flat local homomorphism of Noetherian local rings with regular closed fibre;
* `TauCeti.IsRegularRing.of_flat_of_isRegularRing_fiber`: a flat Noetherian algebra with regular
  fibres over a regular ring is a regular ring;
* `TauCeti.isRegularLocalRing_iff_of_flat_of_map_maximalIdeal_eq`: along a flat homomorphism of
  Noetherian local rings with `𝔪_R S = 𝔪_S`, the target is regular if and only if the source is;
* `TauCeti.IsRegularLocalRing.of_flat_of_map_maximalIdeal_eq`: regularity ascends along such a
  homomorphism;
* `TauCeti.IsRegularLocalRing.of_flat_of_formallyUnramified`: the same for a flat, formally
  unramified local homomorphism essentially of finite type.

## References

* H. Matsumura, *Commutative Ring Theory*, Theorem 23.7.
-/

public section

namespace TauCeti

open _root_.IsLocalRing

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- Along a flat homomorphism of Noetherian local rings under which the maximal ideal of the
source generates the maximal ideal of the target, the target is regular if and only if the source
is. -/
theorem isRegularLocalRing_iff_of_flat_of_map_maximalIdeal_eq [IsLocalRing R] [IsNoetherianRing R]
    [IsLocalRing S] [IsNoetherianRing S] [Module.Flat R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    _root_.IsRegularLocalRing S ↔ _root_.IsRegularLocalRing R := by
  rw [isRegularLocalRing_iff, isRegularLocalRing_iff,
    IsLocalRing.spanFinrank_maximalIdeal_eq_of_flat_of_map_maximalIdeal_eq h,
    ringKrullDim_eq_of_flat_of_map_maximalIdeal_eq h]

namespace IsRegularLocalRing

/-- Regularity ascends along a flat homomorphism of Noetherian local rings under which the maximal
ideal of the source generates the maximal ideal of the target. -/
theorem of_flat_of_map_maximalIdeal_eq [IsRegularLocalRing R] [IsLocalRing S]
    [IsNoetherianRing S] [Module.Flat R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    IsRegularLocalRing S :=
  (isRegularLocalRing_iff_of_flat_of_map_maximalIdeal_eq h).mpr ‹_›

/-- Regularity ascends along a flat, formally unramified local homomorphism essentially of finite
type between Noetherian local rings. -/
theorem of_flat_of_formallyUnramified [IsRegularLocalRing R] [IsLocalRing S]
    [IsNoetherianRing S] [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S] :
    IsRegularLocalRing S :=
  of_flat_of_map_maximalIdeal_eq (Algebra.FormallyUnramified.map_maximalIdeal (R := R))

/-- **Regularity ascends along flat local homomorphisms with regular closed fibre.** If `R → S` is a
flat local homomorphism of Noetherian local rings such that `R` and the closed fibre `S ⧸ 𝔪_R S`
are regular, then `S` is regular. Matsumura, Theorem 23.7 (ii). -/
theorem of_flat_of_quotient_map_maximalIdeal [IsRegularLocalRing R] [IsLocalRing S]
    [IsNoetherianRing S] [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    [IsRegularLocalRing (S ⧸ (maximalIdeal R).map (algebraMap R S))] :
    IsRegularLocalRing S := by
  set I := (maximalIdeal R).map (algebraMap R S)
  -- `𝔪_S` needs at most as many generators as `I = 𝔪_R S` and the maximal ideal of `S ⧸ I`
  -- together, and `I` at most as many as `𝔪_R`; by the dimension formula these numbers add up
  -- to `dim S`.
  have hle : I ≤ maximalIdeal S :=
    Ideal.map_le_iff_le_comap.mpr (maximalIdeal_comap (algebraMap R S)).ge
  have hS := Ideal.spanFinrank_le_spanFinrank_map_add_spanFinrank hle (IsNoetherian.noetherian I)
  have hI : I.spanFinrank ≤ (maximalIdeal R).spanFinrank :=
    Ideal.spanFinrank_map_le_of_fg _ (IsNoetherian.noetherian _)
  rw [map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective] at hS
  refine .of_spanFinrank_maximalIdeal_le S ?_
  rw [ringKrullDim_eq_ringKrullDim_add_ringKrullDim_quotient_map_maximalIdeal (R := R),
    ← _root_.IsRegularLocalRing.spanFinrank_maximalIdeal (R := R),
    ← _root_.IsRegularLocalRing.spanFinrank_maximalIdeal (R := S ⧸ I), add_comm]
  exact_mod_cast hS.trans (Nat.add_le_add_left hI _)

end IsRegularLocalRing

/-- **Regularity ascends along flat homomorphisms with regular fibres.** If `S` is a flat
Noetherian algebra over a regular ring `R` and every fibre `κ(p) ⊗[R] S` is a regular ring, then
`S` is a regular ring. -/
theorem IsRegularRing.of_flat_of_isRegularRing_fiber [IsRegularRing R] [IsNoetherianRing S]
    [Module.Flat R S] (h : ∀ (p : Ideal R) [p.IsPrime], IsRegularRing (p.Fiber S)) :
    IsRegularRing S := by
  refine isRegularRing_iff.mpr fun Q _ ↦ ?_
  -- Write `Q` as the prime of `S` below a prime `q` of the fibre over `P = Q ∩ R`.
  obtain ⟨P, _, _⟩ : ∃ P : Ideal R, P.IsPrime ∧ Q.LiesOver P :=
    ⟨Q.under R, inferInstance, ⟨rfl⟩⟩
  obtain ⟨q, rfl⟩ : ∃ q : PrimeSpectrum (P.Fiber S),
      q.asIdeal.comap Algebra.TensorProduct.includeRight = Q :=
    ⟨_, congr($((PrimeSpectrum.primesOverOrderIsoFiber R S P).symm_apply_apply
      ⟨Q, ‹_›, ‹_›⟩).1)⟩
  set Q := q.asIdeal.comap Algebra.TensorProduct.includeRight
  let := Localization.AtPrime.algebraOfLiesOver P Q
  have : IsLocalHom (algebraMap (Localization.AtPrime P) (Localization.AtPrime Q)) := by
    rw [RingHom.algebraMap_toAlgebra]
    exact Localization.isLocalHom_localRingHom _ _ _ Ideal.LiesOver.over
  -- The closed fibre of `R_P → S_Q` is the local ring of the fibre `κ(P) ⊗[R] S` at `q`.
  have := h P
  let e : Localization.AtPrime q.asIdeal ≃+* Localization.AtPrime Q ⧸
      (IsLocalRing.maximalIdeal (Localization.AtPrime P)).map
        (algebraMap (Localization.AtPrime P) (Localization.AtPrime Q)) :=
    (Ideal.Fiber.algEquivAux₂ P q.asIdeal).toRingEquiv.trans (Ideal.quotEquivOfEq (by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P, Ideal.map_map, Ideal.map_map,
        ← IsScalarTower.algebraMap_eq, ← IsScalarTower.algebraMap_eq]))
  -- `e` reaches `Localization.AtPrime q.asIdeal` through Mathlib's `OreLocalization` instances;
  -- rebuilding it against the expected type selects the `CommRing` instances.
  have := IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime q.asIdeal)
    { toEquiv := e.toEquiv, map_mul' := e.map_mul, map_add' := e.map_add }
  exact IsRegularLocalRing.of_flat_of_quotient_map_maximalIdeal (R := Localization.AtPrime P)

end TauCeti
