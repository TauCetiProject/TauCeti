/-!
# Regularity along flat homomorphisms

Let `R → S` be a local homomorphism of Noetherian local rings satisfying going down, for instance
a flat one. If `R` and the closed fibre `S ⧸ 𝔪_R S` are regular, then so is `S`: the maximal ideal
of `S` is generated by the images of generators of `𝔪_R` together with lifts of generators of the
maximal ideal of `S ⧸ 𝔪_R S`, and by the dimension formula `dim S = dim R + dim S ⧸ 𝔪_R S` there
are at most `dim S` of these. Applied
at every prime, regularity ascends from a regular ring `R` to a flat Noetherian `R`-algebra whose
fibres `κ(p) ⊗[R] S` are regular rings, for instance to a Noetherian regular algebra in the sense
of `TauCeti.Excellence.RegularAlgebraMap`.

When `R → S` is moreover flat and the maximal ideal of `R` generates the maximal ideal of `S`, so
that the closed fibre is a field, `R` is regular if and only if `S` is: the maximal ideals of `R`
and `S` need the same number of generators, and `R` and `S` have the same Krull dimension. The
descent of regularity applies for instance to the completion of a Noetherian local ring. Formally
unramified local homomorphisms essentially of finite type satisfy this hypothesis on the maximal
ideals, so regularity ascends along local homomorphisms of this kind which are flat, such as the
localizations of étale algebras at primes. This is the local input for showing that an algebra
smooth over a regular ring is regular.

Conversely, if `S` is a regular local ring, flat over a local ring `R`, and the structure map
`R → S` has an `R`-algebra retraction `σ : S → R`, then the closed fibre `S ⧸ 𝔪_R S` is regular.
Geometrically, this is the closed fibre through the image of the closed point under a section of
`Spec S → Spec R`. Here `R ≅ S ⧸ ker σ` is regular by descent, so `ker σ` needs `dim S - dim R`
generators, and their images generate the maximal ideal of the closed fibre, since
`𝔪_S = ker σ + 𝔪_R S`. By Krull's height theorem, the closed fibre has dimension at least
`dim S - dim R`.

## Main declarations

* `TauCeti.IsRegularLocalRing.of_hasGoingDown_of_quotient_map_maximalIdeal`: regularity ascends
  along a local homomorphism of Noetherian local rings with going down, for instance a flat one,
  with regular closed fibre;
* `TauCeti.IsRegularRing.of_flat_of_isRegularRing_fiber`: a flat Noetherian algebra with regular
  fibres over a regular ring is a regular ring;
* `TauCeti.isRegularLocalRing_iff_of_flat_of_map_maximalIdeal_eq`: along a flat homomorphism of
  Noetherian local rings with `𝔪_R S = 𝔪_S`, the target is regular if and only if the source is;
* `TauCeti.IsRegularLocalRing.of_flat_of_map_maximalIdeal_eq`: regularity ascends along such a
  homomorphism;
* `TauCeti.IsRegularLocalRing.of_flat_of_formallyUnramified`: the same for a flat, formally
  unramified local homomorphism essentially of finite type;
* `TauCeti.IsRegularLocalRing.quotient_map_maximalIdeal_of_algHom`: the closed fibre of a flat
  regular local algebra with an algebra retraction to the base is regular.

## References

* H. Matsumura, *Commutative Ring Theory*, Theorem 23.7.
-/

public section

namespace TauCeti

open _root_.IsLocalRing

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- Along a flat homomorphism of Noetherian local rings under which the maximal ideal of the
source generates the maximal ideal of the target, the target is regular if and only if the source
is. -/
theorem isRegularLocalRing_iff_of_flat_of_map_maximalIdeal_eq [IsLocalRing R]
    [IsLocalRing S] [IsNoetherianRing S] [Module.Flat R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    _root_.IsRegularLocalRing S ↔ _root_.IsRegularLocalRing R := by
  have : IsLocalHom (algebraMap R S) := ((local_hom_tfae (algebraMap R S)).out 1 3).mpr h.le
  refine ⟨fun hS ↦ IsRegularLocalRing.of_flat_of_isLocalHom (S := S), fun hR ↦ ?_⟩
  have := hR
  have : IsNoetherianRing R := inferInstance
  have key : _root_.IsRegularLocalRing S ↔ _root_.IsRegularLocalRing R := by
    rw [isRegularLocalRing_iff, isRegularLocalRing_iff,
      IsLocalRing.spanFinrank_maximalIdeal_eq_of_flat_of_map_maximalIdeal_eq h,
      ringKrullDim_eq_of_hasGoingDown_of_map_maximalIdeal_eq h]
  exact key.mpr hR

namespace IsRegularLocalRing

/-- Regularity ascends along a flat homomorphism of Noetherian local rings under which the maximal
ideal of the source generates the maximal ideal of the target. -/
theorem of_flat_of_map_maximalIdeal_eq [IsRegularLocalRing R] [IsLocalRing S]
    [IsNoetherianRing S] [Module.Flat R S]
    (h : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S) :
    IsRegularLocalRing S :=
  (isRegularLocalRing_iff_of_flat_of_map_maximalIdeal_eq h).mpr ‹_›

/-- Regularity ascends along a flat, formally unramified local homomorphism essentially of finite
type between Noetherian local rings. -/
theorem of_flat_of_formallyUnramified [IsRegularLocalRing R] [IsLocalRing S]
    [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S] :
    IsRegularLocalRing S :=
  have := Algebra.EssFiniteType.isNoetherianRing R S
  of_flat_of_map_maximalIdeal_eq (Algebra.FormallyUnramified.map_maximalIdeal (R := R))

/-- **Regularity ascends along local homomorphisms with going down and regular closed fibre.** If
`R → S` is a local homomorphism of Noetherian local rings satisfying going down, for instance a
flat one, such that `R` and the closed fibre `S ⧸ 𝔪_R S` are regular, then `S` is regular.
Matsumura, Theorem 23.7 (ii), where the homomorphism is assumed flat. -/
theorem of_hasGoingDown_of_quotient_map_maximalIdeal [IsRegularLocalRing R] [IsLocalRing S]
    [IsNoetherianRing S] [Algebra.HasGoingDown R S]
    [IsRegularLocalRing (S ⧸ (maximalIdeal R).map (algebraMap R S))] :
    IsRegularLocalRing S := by
  set I := (maximalIdeal R).map (algebraMap R S)
  -- The closed fibre is nonzero, so `I` is proper, hence contained in the maximal ideal.
  have hI : I ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp inferInstance
  have : IsLocalHom (algebraMap R S) :=
    ((local_hom_tfae (algebraMap R S)).out 1 3).mpr (le_maximalIdeal hI)
  -- `I = 𝔪_R S` needs at most as many generators as `𝔪_R`, that is `dim R` of them, and by the
  -- dimension formula `dim S ⧸ I + dim R = dim S`.
  refine I.isRegularLocalRing_of_quotient_of_spanFinrank_le
    (Ideal.spanFinrank_map_le_of_fg _ (IsNoetherian.noetherian _)) ?_
  rw [ringKrullDim_eq_ringKrullDim_add_ringKrullDim_quotient_map_maximalIdeal R (S := S),
    ← _root_.IsRegularLocalRing.spanFinrank_maximalIdeal (R := R), add_comm]

/-- **The closed fibre through a section is regular.** If `S` is a regular local ring, flat over a
local ring `R`, and `σ : S →ₐ[R] R` is a retraction of the structure map, then the closed fibre
`S ⧸ 𝔪_R S` is a regular local ring. -/
theorem quotient_map_maximalIdeal_of_algHom [IsRegularLocalRing S] [IsLocalRing R]
    [Module.Flat R S] (σ : S →ₐ[R] R) :
    IsRegularLocalRing (S ⧸ (maximalIdeal R).map (algebraMap R S)) := by
  have : IsLocalHom (algebraMap R S) := ⟨fun r hr ↦ by simpa using hr.map σ⟩
  have hσ : Function.Surjective σ := fun r ↦ ⟨algebraMap R S r, σ.commutes r⟩
  have : IsLocalHom σ.toRingHom := IsLocalHom.of_surjective _ hσ
  have : IsRegularLocalRing R := of_flat_of_isLocalHom (S := S)
  -- `S ⧸ ker σ ≅ R` is regular, so `ker σ` needs `dim S - dim R` generators.
  set p := RingHom.ker (σ : S →+* R)
  let e := RingHom.quotientKerEquivOfSurjective (f := (σ : S →+* R)) hσ
  have : IsRegularLocalRing (S ⧸ p) := .of_ringEquiv e.symm
  have hp := p.spanFinrank_add_spanFinrank_maximalIdeal_quotient
  have hdim : (maximalIdeal (S ⧸ p)).spanFinrank = (maximalIdeal R).spanFinrank := by
    have := ringKrullDim_eq_of_ringEquiv e
    rw [← _root_.IsRegularLocalRing.spanFinrank_maximalIdeal,
      ← _root_.IsRegularLocalRing.spanFinrank_maximalIdeal] at this
    exact_mod_cast this
  -- The maximal ideal of the closed fibre is generated by the image of `ker σ`, since
  -- `𝔪_S = ker σ + 𝔪_R S`.
  set I := (maximalIdeal R).map (algebraMap R S)
  have hIm : I ≤ maximalIdeal S := map_maximalIdeal_le _
  have : Nontrivial (S ⧸ I) :=
    Ideal.Quotient.nontrivial_iff.mpr (ne_top_of_le_ne_top (maximalIdeal.isMaximal S).ne_top hIm)
  have : IsLocalRing (S ⧸ I) := .of_surjective' _ Ideal.Quotient.mk_surjective
  have hm : maximalIdeal S ≤ p ⊔ I := fun a ha ↦ by
    rw [← sub_add_cancel a (algebraMap R S (σ a))]
    refine add_mem (Ideal.mem_sup_left (by simp [p])) (Ideal.mem_sup_right ?_)
    exact Ideal.mem_map_of_mem _ (map_nonunit σ.toRingHom _ ha)
  have hmI : maximalIdeal (S ⧸ I) = p.map (Ideal.Quotient.mk I) := by
    rw [← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
    refine le_antisymm ?_ (Ideal.map_mono (le_maximalIdeal (RingHom.ker_ne_top _)))
    refine (Ideal.map_mono hm).trans ?_
    rw [Ideal.map_sup, Ideal.map_quotient_self, sup_bot_eq]
  have hμ : (maximalIdeal (S ⧸ I)).spanFinrank ≤ p.spanFinrank :=
    hmI ▸ Ideal.spanFinrank_map_le_of_fg _ p.fg_of_isNoetherianRing
  have hμI : I.spanFinrank ≤ (maximalIdeal R).spanFinrank :=
    Ideal.spanFinrank_map_le_of_fg _ (maximalIdeal R).fg_of_isNoetherianRing
  -- By Krull's height theorem, `dim S ≤ dim S ⧸ I + μ(I)`.
  have hkrull := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank I
    (by rwa [ringJacobson_eq_maximalIdeal])
  rw [← _root_.IsRegularLocalRing.spanFinrank_maximalIdeal (R := S)] at hkrull
  refine _root_.IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_
  rw [← ENat.WithBot.add_le_add_natCast_right_iff (c := I.spanFinrank)]
  exact le_trans (by exact_mod_cast (by omega)) hkrull

end IsRegularLocalRing

/-- **Regularity ascends along flat homomorphisms with regular fibres.** If `S` is a flat
Noetherian algebra over a regular ring `R` and every fibre `κ(p) ⊗[R] S` is a regular ring, then
`S` is a regular ring. -/
theorem IsRegularRing.of_flat_of_isRegularRing_fiber [IsRegularRing R] [IsNoetherianRing S]
    [Module.Flat R S] (h : ∀ (p : Ideal R) [p.IsPrime], IsRegularRing (p.Fiber S)) :
    IsRegularRing S := by
  refine isRegularRing_iff.mpr fun Q _ ↦ ?_
  -- Write `Q` as the prime of `S` below a prime `q` of the fibre over `P = Q ∩ R`.
  obtain ⟨P, _, _⟩ : ∃ P : Ideal R, P.IsPrime ∧ Q.LiesOver P :=
    ⟨Q.under R, inferInstance, ⟨rfl⟩⟩
  obtain ⟨q, rfl⟩ : ∃ q : PrimeSpectrum (P.Fiber S),
      q.asIdeal.comap Algebra.TensorProduct.includeRight = Q :=
    ⟨_, congr($((PrimeSpectrum.primesOverOrderIsoFiber R S P).symm_apply_apply
      ⟨Q, ‹_›, ‹_›⟩).1)⟩
  set Q := q.asIdeal.comap Algebra.TensorProduct.includeRight
  let := Localization.AtPrime.algebraOfLiesOver P Q
  have : IsLocalHom (algebraMap (Localization.AtPrime P) (Localization.AtPrime Q)) := by
    rw [RingHom.algebraMap_toAlgebra]
    exact Localization.isLocalHom_localRingHom _ _ _ Ideal.LiesOver.over
  -- The closed fibre of `R_P → S_Q` is the local ring of the fibre `κ(P) ⊗[R] S` at `q`.
  have := h P
  let e : Localization.AtPrime q.asIdeal ≃+* Localization.AtPrime Q ⧸
      (IsLocalRing.maximalIdeal (Localization.AtPrime P)).map
        (algebraMap (Localization.AtPrime P) (Localization.AtPrime Q)) :=
    (Ideal.Fiber.localizationAlgEquivQuotient P q.asIdeal).toRingEquiv.trans
      (Ideal.quotEquivOfEq (by rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P, Ideal.map_map,
        ← IsScalarTower.algebraMap_eq]))
  -- `e` reaches `Localization.AtPrime q.asIdeal` through Mathlib's `OreLocalization` instances;
  -- rebuilding it against the expected type selects the `CommRing` instances.
  have := IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime q.asIdeal)
    { toEquiv := e.toEquiv, map_mul' := e.map_mul, map_add' := e.map_add }
  exact IsRegularLocalRing.of_hasGoingDown_of_quotient_map_maximalIdeal
    (R := Localization.AtPrime P)

end TauCeti
