/-!
# Regular local rings with formally smooth residue field are formally smooth

Let `k` be a field and `S` a regular local `k`-algebra, essentially of finite type, whose residue
field `κ` is formally smooth over `k`. Then `S` is formally smooth over `k`. The residue field
condition holds when `κ` is a separably generated extension of `k`, for instance a finite
separable one, and always when `k` is perfect (`TauCeti.formallySmooth_of_perfectField`).

It cannot be dropped: for an odd prime `p` and `k = 𝔽_p(t)`, the local ring `S` of the curve
`y ^ 2 = x ^ p - t` at its point `y = 0` is a discrete valuation ring, its maximal ideal being
generated by `y`, but `S` is not formally smooth over `k`, since `2 y dy = 0` while `dy ≠ 0`, so
that `Ω[S⁄k]` is not free; its residue field `k(t ^ (1 / p))` is purely inseparable over `k`.

Geometrically, a regular scheme locally of finite type over a perfect field is smooth. The
converse, that a formally smooth local algebra essentially of finite type over a field is regular,
is `TauCeti.IsRegularLocalRing.of_formallySmooth`.

The proof is the Jacobian criterion. Write `S = P ⧸ I` with `P` a localization of a polynomial
ring over `k`, so that `P` is a regular local ring, formally smooth over `k` with free
differentials. Since `S` is regular, `I` is generated by part of a minimal system of generators
`x₁, …, xₙ` of the maximal ideal `𝔪` of `P` (`Ideal.exists_regularSystem_of_quotient`), and these
are linearly independent modulo `𝔪²` (`TauCeti.IsLocalRing.mem_maximalIdeal_of_sum_mul_mem_sq`).
Since `κ` is formally smooth over `k`, the conormal map `𝔪 ⧸ 𝔪² → κ ⊗[P] Ω[P⁄k]` is injective,
so the differentials of the generators of `I` are linearly independent in `κ ⊗[P] Ω[P⁄k]`: this
is the Jacobian criterion `TauCeti.formallySmooth_of_ker_eq_span_of_sum_mul_mem_sq`.

## Main results

* `TauCeti.formallySmooth_of_isRegularLocalRing_of_surjective`: a regular local quotient `S` of a
  regular local ring `P` formally smooth over `R`, with finite differentials, is formally smooth
  over `R` when its residue field is.
* `TauCeti.formallySmooth_of_isRegularLocalRing`: a regular local algebra essentially of finite
  type over a field `k`, with residue field formally smooth over `k`, is formally smooth over `k`.

## References

* The Stacks Project, Section 10.140, *Smooth algebras over fields*.
-/

public section

open IsLocalRing

namespace TauCeti

section Quotient

variable {R P S : Type*} [CommRing R] [CommRing P] [CommRing S] [Algebra R P] [Algebra P S]
  [Algebra R S] [IsScalarTower R P S]

/-- **A regular quotient of a formally smooth regular local ring is formally smooth**, if its
residue field is. Let `P` be a regular local ring, formally smooth over `R` with finitely
generated differentials, and let `P → S` be surjective with `S` a regular local ring whose residue
field is formally smooth over `R`. Then `S` is formally smooth over `R`. -/
theorem formallySmooth_of_isRegularLocalRing_of_surjective [IsRegularLocalRing P]
    [IsRegularLocalRing S] [Algebra.FormallySmooth R P] [Module.Finite P Ω[P⁄R]]
    [Algebra.FormallySmooth R (ResidueField S)] (hsurj : Function.Surjective (algebraMap P S)) :
    Algebra.FormallySmooth R S := by
  classical
  -- `S ≅ P ⧸ I` is regular, so `I` is generated by part of a minimal generating family of `𝔪_P`.
  let I := RingHom.ker (algebraMap P S)
  have : IsRegularLocalRing (P ⧸ I) :=
    .of_ringEquiv (RingHom.quotientKerEquivOfSurjective hsurj).symm
  obtain ⟨size, count, gen, -, hspan, hrank, hI⟩ := Ideal.exists_regularSystem_of_quotient I
  let τ := {i : Fin size // (i : ℕ) < count}
  refine formallySmooth_of_ker_eq_span_of_sum_mul_mem_sq hsurj (g := fun t : τ ↦ gen t) ?_
    fun c hc t ↦ ?_
  · refine hI.trans (congrArg Ideal.span ?_)
    ext
    simp [τ]
  -- Extend `c` by zero to all the generators of `𝔪_P`.
  let c' : Fin size → P := fun i ↦ if h : (i : ℕ) < count then c ⟨i, h⟩ else 0
  have hc' : ∑ i, c' i * gen i = ∑ t : τ, c t * gen t := by
    rw [← Fintype.sum_subtype_add_sum_subtype (fun i : Fin size ↦ (i : ℕ) < count)]
    refine (add_eq_left.mpr (Finset.sum_eq_zero fun i _ ↦ by simp [c', i.2])).trans ?_
    exact Finset.sum_congr rfl fun i _ ↦ by simp [c', i.2]
  simpa [c', t.2] using
    IsLocalRing.mem_maximalIdeal_of_sum_mul_mem_sq hspan hrank (c := c') (hc' ▸ hc) t.1

end Quotient

section Field

variable {k S : Type*} [Field k] [CommRing S] [Algebra k S]

/-- **A regular local ring over a field with formally smooth residue field is formally smooth.**
Let `S` be a regular local algebra, essentially of finite type over a field `k`, whose residue
field is formally smooth over `k`, for instance because `k` is perfect. Then `S` is formally smooth
over `k`. -/
theorem formallySmooth_of_isRegularLocalRing [Algebra.EssFiniteType k S] [IsRegularLocalRing S]
    [Algebra.FormallySmooth k (ResidueField S)] : Algebra.FormallySmooth k S := by
  -- `S` is the localization of a finite type subalgebra `T` at the prime `q = 𝔪_S ∩ T`.
  let T := Algebra.EssFiniteType.subalgebra k S
  let q := (maximalIdeal S).comap (algebraMap T S)
  have := Algebra.EssFiniteType.isLocalization_atPrime_subalgebra k S
  -- `T` is a quotient of a polynomial ring `Q`; localize `Q` at the prime `q'` above `q`.
  obtain ⟨n, φ, hφ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : Algebra.FiniteType k T)
  let Q := MvPolynomial (Fin n) k
  let q' := q.comap φ
  let P := Localization.AtPrime q'
  have hunit (y : q'.primeCompl) : IsUnit ((algebraMap T S).comp φ.toRingHom y) :=
    not_not.mp ((mem_maximalIdeal _).not.mp y.2)
  let ψ : P →+* S := IsLocalization.lift hunit
  let := ψ.toAlgebra
  have hψ : (algebraMap P S).comp (algebraMap Q P) = (algebraMap T S).comp φ.toRingHom :=
    IsLocalization.lift_comp hunit
  have : IsScalarTower k P S := .of_algebraMap_eq fun a ↦ by
    simpa [IsScalarTower.algebraMap_apply k Q P] using
      (RingHom.congr_fun hψ (algebraMap k Q a)).symm
  have hsurj : Function.Surjective (algebraMap P S) := by
    intro s
    obtain ⟨⟨t, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl s
    obtain ⟨a, rfl⟩ := hφ t
    obtain ⟨b, hb⟩ := hφ u
    have hb' : b ∈ q'.primeCompl := fun h ↦ u.2 (hb ▸ h)
    refine ⟨IsLocalization.mk' P a ⟨b, hb'⟩, ?_⟩
    have hc (c : Q) : algebraMap T S (φ c) = algebraMap P S (algebraMap Q P c) :=
      (RingHom.congr_fun hψ c).symm
    rw [IsLocalization.eq_mk'_iff_mul_eq, ← hb, hc, hc, ← map_mul,
      IsLocalization.mk'_spec]
  have : Algebra.FormallySmooth k P := .comp k Q P
  exact formallySmooth_of_isRegularLocalRing_of_surjective hsurj

end Field

end TauCeti
