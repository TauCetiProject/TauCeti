module

public import Mathlib.RingTheory.UniqueFactorizationDomain.Kaplansky
public import TauCeti.RingTheory.RegularLocalRing.Basic

/-!
# Regular local rings of dimension at most two are factorial

A regular local ring of dimension at most two is a unique factorization domain. In dimension zero
and one it is a field or a discrete valuation ring. In dimension two, the quotient `R ⧸ (x)` by a
parameter `x ∈ 𝔪 \ 𝔪²` is a discrete valuation ring, and the following elementary argument shows
that every prime `𝔮` of `R` not containing `x` is principal. Since `𝔮` is prime and `x ∉ 𝔮`, the
kernel `𝔮 ∩ (x)` of `𝔮 → R ⧸ (x)` is `x 𝔮`. The image of `𝔮` is principal in the principal ideal
ring `R ⧸ (x)`, generated by the image of some `f ∈ 𝔮`, so `𝔮 = (f) + x 𝔮` and Nakayama's lemma
gives `𝔮 = (f)`. Every nonzero prime then contains a prime element: `x` if it contains `x`, and
its generator otherwise. Kaplansky's criterion concludes.

This is the dimension-two case of the Auslander–Buchsbaum theorem that every regular local ring
is factorial, and it is the case needed for regular surfaces, such as a regular model of a curve
over a discrete valuation ring. There, every height-one prime of a local ring is principal, so
that the integral curves on the surface, in particular the irreducible components of the special
fibre, are effective Cartier divisors.

## Main results

* `Ideal.IsPrime.isPrincipal_of_isPrincipal_map_quotient_span_singleton`: a finitely generated
  prime `𝔮` not containing an element `x` of the Jacobson radical is principal as soon as its image
  in `R ⧸ (x)` is;
* `UniqueFactorizationMonoid.of_isPrincipalIdealRing_quotient_span_singleton`: a Noetherian domain
  with an element `x` of its Jacobson radical such that `R ⧸ (x)` is a principal ideal domain is a
  unique factorization domain;
* `TauCeti.IsRegularLocalRing.uniqueFactorizationMonoid`: a regular local ring of Krull dimension
  at most two is a unique factorization domain.

## References

* [The Stacks Project, Tag 0AG0](https://stacks.math.columbia.edu/tag/0AG0), the general statement
  that a regular local ring is a unique factorization domain, proved there through the
  Auslander–Buchsbaum formula.
* H. Matsumura, *Commutative Ring Theory*, Section 20, for the general statement, and
  I. Kaplansky, *Commutative Rings*, for the criterion by prime elements in prime ideals, which is
  Mathlib's `UniqueFactorizationMonoid.iff_exists_prime_mem_of_isPrime`.
-/

public section

open Ideal IsLocalRing

variable {R : Type*} [CommRing R]

/-- **A prime is principal if its image modulo a radical element is.** Let `x` be an element of
the Jacobson radical of `R` and `𝔮` a finitely generated prime ideal not containing `x`. If the
image of `𝔮` in `R ⧸ (x)` is principal, then `𝔮` is principal. -/
theorem Ideal.IsPrime.isPrincipal_of_isPrincipal_map_quotient_span_singleton {q : Ideal R}
    (hq : q.IsPrime) (hfg : q.FG) {x : R} (hx : x ∈ (⊥ : Ideal R).jacobson) (hxq : x ∉ q)
    (h : (q.map (Ideal.Quotient.mk (span {x}))).IsPrincipal) : q.IsPrincipal := by
  obtain ⟨g, hg⟩ := h
  obtain ⟨f, hfq, rfl⟩ := (mem_map_iff_of_surjective _ Quotient.mk_surjective).mp
    (hg ▸ Submodule.mem_span_singleton_self _ : _ ∈ q.map (Quotient.mk (span {x})))
  refine ⟨f, le_antisymm (Submodule.le_of_le_smul_of_le_jacobson_bot hfg
    ((span_singleton_le_iff_mem _).mpr hx) fun a ha ↦ ?_) ((span_singleton_le_iff_mem _).mpr hfq)⟩
  -- The image of `a` is a multiple `r f` of the generator, so `a - r f = x b`, and `b ∈ q`.
  have hma := mem_map_of_mem (Quotient.mk (span {x})) ha
  rw [hg] at hma
  obtain ⟨r', hr⟩ := mem_span_singleton'.mp hma
  obtain ⟨r, rfl⟩ := Quotient.mk_surjective r'
  rw [← map_mul, Quotient.eq, mem_span_singleton'] at hr
  obtain ⟨b, hb⟩ := hr
  have hbq : b ∈ q := by
    refine (hq.mem_or_mem (?_ : b * x ∈ q)).resolve_right hxq
    rw [hb]
    exact q.sub_mem (q.mul_mem_left r hfq) ha
  have hab : a = r * f + -(x * b) := by rw [mul_comm x b, hb]; ring
  rw [hab, Submodule.mem_sup]
  exact ⟨r * f, mem_span_singleton'.mpr ⟨r, rfl⟩, -(x * b),
    Submodule.neg_mem _ (Submodule.smul_mem_smul (mem_span_singleton_self x) hbq), rfl⟩

/-- **A domain is factorial if it is a principal ideal domain modulo a radical element.** Let `R`
be a Noetherian domain and `x` an element of its Jacobson radical such that `R ⧸ (x)` is a principal
ideal domain. Then `R` is a unique factorization domain. -/
theorem UniqueFactorizationMonoid.of_isPrincipalIdealRing_quotient_span_singleton [IsDomain R]
    [IsNoetherianRing R] {x : R} (hx : x ∈ (⊥ : Ideal R).jacobson) [IsDomain (R ⧸ span {x})]
    [IsPrincipalIdealRing (R ⧸ span {x})] : UniqueFactorizationMonoid R := by
  by_cases hx0 : x = 0
  · -- Modulo `x = 0` the ring is `R` itself, a principal ideal domain.
    subst hx0
    let e := (quotEquivOfEq (span_singleton_eq_bot.mpr rfl)).trans (RingEquiv.quotientBot R)
    have : IsPrincipalIdealRing R := IsPrincipalIdealRing.of_surjective e.toRingHom e.surjective
    infer_instance
  have hxprime : Prime x :=
    (span_singleton_prime hx0).mp ((Quotient.isDomain_iff_prime _).mp inferInstance)
  refine iff_exists_prime_mem_of_isPrime.mpr fun q hq0 hq ↦ ?_
  by_cases hxq : x ∈ q
  · exact ⟨x, hxq, hxprime⟩
  obtain ⟨f, (hf : q = span {f})⟩ := hq.isPrincipal_of_isPrincipal_map_quotient_span_singleton
    (IsNoetherian.noetherian q) hx hxq (IsPrincipalIdealRing.principal _)
  refine ⟨f, hf ▸ mem_span_singleton_self f, (span_singleton_prime ?_).mp (hf ▸ hq)⟩
  rintro rfl
  exact hq0 (by simpa using hf)

namespace TauCeti.IsRegularLocalRing

variable [IsRegularLocalRing R]

/-- **A regular local ring of dimension at most two is a unique factorization domain.** -/
@[stacks 0AG0 "(dimension at most two)"]
theorem uniqueFactorizationMonoid (h : ringKrullDim R ≤ 2) : UniqueFactorizationMonoid R := by
  by_cases hR : IsField R
  · let := hR.toField
    infer_instance
  -- Outside the field case, Nakayama's lemma gives a parameter `x ∈ 𝔪 \ 𝔪²`.
  obtain ⟨x, hxm, hx2⟩ := IsConcreteLE.exists_of_lt ((maximalIdeal_sq_lt_maximalIdeal R).mpr hR)
  have hx0 : x ≠ 0 := by
    rintro rfl
    exact hx2 (zero_mem _)
  have := quotient_span_singleton hxm hx2
  -- Dividing by the nonzerodivisor `x` lowers the dimension by one.
  have hdim : ringKrullDim (R ⧸ span {x}) + 1 ≤ 1 + 1 := by
    rw [ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim
      (IsSMulRegular.of_ne_zero hx0) hxm]
    exact h
  have := valuationRing_of_ringKrullDim_le_one (R := R ⧸ span {x})
    (ENat.WithBot.add_le_add_one_right_iff.mp hdim)
  exact UniqueFactorizationMonoid.of_isPrincipalIdealRing_quotient_span_singleton
    (x := x) (by rwa [jacobson_eq_maximalIdeal ⊥ bot_ne_top])

end TauCeti.IsRegularLocalRing
