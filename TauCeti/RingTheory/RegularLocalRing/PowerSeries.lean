/-!
# Power series over a regular local ring

Let `(R, 𝔪)` be a Noetherian local ring. The ring of formal power series `R⟦X⟧` is again a
Noetherian local ring, whose maximal ideal is the preimage of `𝔪` under the constant coefficient,
generated by `X` together with generators of `𝔪`. This file computes its Krull dimension,

```text
dim R⟦X⟧ = dim R + 1,
```

and deduces that `R⟦X⟧` is regular whenever `R` is: a regular system of parameters of `R`
together with `X` is one of `R⟦X⟧`.

The case of a discrete valuation ring `O` with uniformizer `ϖ` is the Iwasawa algebra
`Λ = O⟦T⟧`: it is a regular local ring of dimension two, with maximal ideal `(ϖ, T)`. This is the
ring-theoretic starting point of the structure theory of finitely generated `Λ`-modules. No
completeness of `O` and no finiteness of its residue field is needed for this.

## Main results

* `TauCeti.PowerSeries.maximalIdeal_eq_comap_constantCoeff`: the maximal ideal of `R⟦X⟧` consists
  of the series whose constant coefficient lies in `𝔪`.
* `TauCeti.PowerSeries.maximalIdeal_eq_span_insert_X`: generators of `𝔪` together with `X`
  generate the maximal ideal of `R⟦X⟧`.
* `TauCeti.PowerSeries.ringKrullDim_of_isNoetherianRing_of_isLocalRing`: for a Noetherian local
  ring `R`, `dim R⟦X⟧ = dim R + 1`.
* `TauCeti.PowerSeries.isRegularLocalRing`: power series over a regular local ring form a regular
  local ring.
* `TauCeti.PowerSeries.ringKrullDim_of_isDiscreteValuationRing` and
  `TauCeti.PowerSeries.maximalIdeal_eq_span_C_X`: over a discrete valuation ring with uniformizer
  `ϖ`, the power series ring has dimension two and maximal ideal `(ϖ, X)`.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, 2nd ed., Springer (2008),
  (5.3.6).
* H. Matsumura, *Commutative Ring Theory*, §14 and §15.
* The generation of ideals of `R⟦X⟧` from their constant coefficients, used for the maximal ideal
  and its generators here, is Mathlib's `Mathlib.RingTheory.PowerSeries.Ideal`, by Riccardo
  Brasca, Anthony Fernandes and Marc Robin.
-/

public section

namespace TauCeti

namespace PowerSeries

open _root_.PowerSeries IsLocalRing Ideal

variable {R : Type*} [CommRing R]

/-- The kernel of the constant coefficient map on `R⟦X⟧` is the ideal generated by `X`. -/
theorem ker_constantCoeff : RingHom.ker (constantCoeff (R := R)) = span {X} := by
  ext f
  simp [mem_span_singleton, X_dvd_iff]

/-- The constant coefficient is a local homomorphism: a power series is a unit exactly when its
constant coefficient is. -/
instance isLocalHom_constantCoeff : IsLocalHom (constantCoeff (R := R)) :=
  ⟨fun _ ↦ isUnit_iff_constantCoeff.mpr⟩

section IsLocalRing

variable [IsLocalRing R]

/-- The maximal ideal of `R⟦X⟧` over a local ring `R` consists of the series whose constant
coefficient lies in the maximal ideal of `R`. -/
theorem maximalIdeal_eq_comap_constantCoeff :
    maximalIdeal R⟦X⟧ = (maximalIdeal R).comap constantCoeff := by
  ext f
  simp only [mem_maximalIdeal, mem_nonunits_iff, mem_comap, isUnit_iff_constantCoeff]

/-- Over a local ring, the variable lies in the maximal ideal of the power series ring. -/
theorem X_mem_maximalIdeal : (X : R⟦X⟧) ∈ maximalIdeal R⟦X⟧ := by
  simp [maximalIdeal_eq_comap_constantCoeff]

/-- The constant coefficients of the series in the maximal ideal of `R⟦X⟧` form the maximal ideal
of `R`. -/
@[simp]
theorem map_constantCoeff_maximalIdeal :
    (maximalIdeal R⟦X⟧).map constantCoeff = maximalIdeal R := by
  rw [maximalIdeal_eq_comap_constantCoeff, map_comap_of_surjective _ constantCoeff_surj]

/-- If `S` generates the maximal ideal of a local ring `R`, then `X` together with the constant
series `C s`, `s ∈ S`, generate the maximal ideal of `R⟦X⟧`. -/
theorem maximalIdeal_eq_span_insert_X {S : Set R} (hS : span S = maximalIdeal R) :
    maximalIdeal R⟦X⟧ = span (insert X (C '' S)) :=
  eq_span_insert_X_of_X_mem_of_span_eq X_mem_maximalIdeal
    (hS.trans map_constantCoeff_maximalIdeal.symm)

/-- The maximal ideal of `R⟦X⟧` needs at most one generator more than that of `R`. -/
theorem spanFinrank_maximalIdeal_le :
    (maximalIdeal R⟦X⟧).spanFinrank ≤ (maximalIdeal R).spanFinrank + 1 := by
  simpa using spanFinrank_le_spanFinrank_map_constantCoeff_add_one_of_X_mem
    (X_mem_maximalIdeal (R := R))

/-- The constant coefficient induces a bijection of residue fields. -/
theorem bijective_residueFieldMap_constantCoeff :
    Function.Bijective (IsLocalRing.ResidueField.map (constantCoeff (R := R))) := by
  refine ⟨(IsLocalRing.ResidueField.map _).injective, fun x ↦ ?_⟩
  obtain ⟨r, rfl⟩ := residue_surjective x
  exact ⟨residue _ (C r), by simp⟩

/-- The residue field of `R⟦X⟧` is the residue field of `R`, through the constant coefficient. -/
noncomputable def residueFieldEquiv : ResidueField R⟦X⟧ ≃+* ResidueField R :=
  .ofBijective _ bijective_residueFieldMap_constantCoeff

/-- The residue field equivalence takes the residue class of `f` to that of its constant
coefficient. -/
@[simp]
theorem _root_.PowerSeries.residueFieldEquiv_residue (f : R⟦X⟧) :
    residueFieldEquiv (residue R⟦X⟧ f) = residue R (constantCoeff f) := by
  rw [residueFieldEquiv, RingEquiv.ofBijective_apply, IsLocalRing.ResidueField.map_residue]

/-- The inverse of the residue field equivalence takes the residue class of `r` to that of the
constant series `C r`. -/
@[simp]
theorem residueFieldEquiv_symm_residue (r : R) :
    residueFieldEquiv.symm (residue R r) = residue R⟦X⟧ (C r) := by
  rw [RingEquiv.symm_apply_eq, residueFieldEquiv_residue, constantCoeff_C]

/-- A finite residue field passes to the power series ring. -/
instance [Finite (ResidueField R)] : Finite (ResidueField R⟦X⟧) :=
  .of_equiv _ residueFieldEquiv.symm.toEquiv

variable [IsNoetherianRing R]

/-- **The dimension of a power series ring.** Over a Noetherian local ring `R`, adjoining a
formal power series variable raises the Krull dimension by exactly one. -/
theorem ringKrullDim_of_isNoetherianRing_of_isLocalRing :
    ringKrullDim R⟦X⟧ = ringKrullDim R + 1 := by
  -- `X` is a non-zero-divisor in the maximal ideal, so it cuts the dimension down by one, and
  -- the quotient by `X` is `R` through the constant coefficient
  have hX : (X : R⟦X⟧) ∈ nonZeroDivisors R⟦X⟧ := MvPowerSeries.X_mem_nonZeroDivisors
  rw [← ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors hX
    X_mem_maximalIdeal, ← ker_constantCoeff,
    ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective constantCoeff_surj)]

end IsLocalRing

/-- **Power series over a regular local ring form a regular local ring.** A regular system of
parameters of `R` together with `X` is one of `R⟦X⟧` (`maximalIdeal_eq_span_insert_X`). -/
instance isRegularLocalRing [IsRegularLocalRing R] : IsRegularLocalRing R⟦X⟧ := by
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_
  rw [ringKrullDim_of_isNoetherianRing_of_isLocalRing,
    ← IsRegularLocalRing.spanFinrank_maximalIdeal]
  exact_mod_cast spanFinrank_maximalIdeal_le

section IsDiscreteValuationRing

variable [IsDomain R] [IsDiscreteValuationRing R]

/-- The power series ring over a discrete valuation ring has Krull dimension two. It is a regular
local ring by `isRegularLocalRing`. -/
theorem ringKrullDim_of_isDiscreteValuationRing : ringKrullDim R⟦X⟧ = 2 := by
  rw [ringKrullDim_of_isNoetherianRing_of_isLocalRing,
    IsDiscreteValuationRing.ringKrullDim_eq_one, one_add_one_eq_two]

/-- Over a discrete valuation ring with uniformizer `ϖ`, the maximal ideal of the power series
ring is `(ϖ, X)`; these two elements form a regular system of parameters. -/
theorem maximalIdeal_eq_span_C_X {ϖ : R} (hϖ : Irreducible ϖ) :
    maximalIdeal R⟦X⟧ = span {C ϖ, X} := by
  rw [maximalIdeal_eq_span_insert_X (S := {ϖ}) hϖ.maximalIdeal_eq.symm, Set.image_singleton,
    Set.pair_comm]

end IsDiscreteValuationRing

end PowerSeries

end TauCeti
