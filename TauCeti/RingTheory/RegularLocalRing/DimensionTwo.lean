/-!
# Regular local rings of dimension two

Let `A` be a regular local ring of dimension two and let `x, y` generate its maximal ideal. Then
`A ⧸ (x)` is a discrete valuation ring with uniformizer the image of `y`, so a finite module on
which `x, y` is a weakly regular sequence is free: modulo `x` it is a torsion-free finite module
over a principal ideal domain, and freeness lifts along the regular element `x`.

Applied to a prime `𝔭 ≠ 𝔪`, this shows that `𝔭` is a free `A`-module, hence principal. Every
nonzero prime ideal therefore contains a prime element (for `𝔪`, a regular parameter), and
Kaplansky's criterion shows that `A` is a unique factorization domain. In particular `A` is
integrally closed. This is the dimension-two case of the theorem of Auslander and Buchsbaum that
regular local rings are factorial; it supplies the normality of the base needed for going down
from finite algebras over a two-dimensional regular local ring.

The same criterion shows that the dual `N* = Hom(N, A)` of a finite module is free: a regular
sequence `x, y` on `A` stays weakly regular on `Hom(N, A)`. Hence over a regular local ring of
dimension at most two every finite reflexive module is free. This is the step of the structure
theory of finitely generated modules over such rings, for instance over the Iwasawa algebra
`O⟦T⟧`, that handles the torsion-free part.

## Main results

* `TauCeti.IsRegularLocalRing.free_of_isWeaklyRegular`: a finite module on which a pair
  generating the maximal ideal is weakly regular is free.
* `TauCeti.IsRegularLocalRing.isPrincipal_of_ne_maximalIdeal`: a prime ideal other than the
  maximal ideal is principal.
* `TauCeti.IsRegularLocalRing.uniqueFactorizationMonoid_of_ringKrullDim_le_two`: a regular local
  ring of dimension at most two is a unique factorization domain.
* `TauCeti.IsRegularLocalRing.free_dual`: over a regular local ring of dimension at most two, the
  dual of a finite module is free.
* `TauCeti.IsRegularLocalRing.free_of_isReflexive`: over a regular local ring of dimension at most
  two, a finite reflexive module is free.

## References

* [The Stacks Project, Lemma 10.106.5](https://stacks.math.columbia.edu/tag/00NS), lifting
  freeness along a regular element.
* H. Matsumura, *Commutative Ring Theory*, Theorem 20.3 (Auslander–Buchsbaum): regular local
  rings are unique factorization domains.
* Kaplansky's criterion, `UniqueFactorizationMonoid.iff_exists_prime_mem_of_isPrime` in Mathlib.
* [The Stacks Project, Lemma 15.24.10](https://stacks.math.columbia.edu/tag/0AV5), the depth of a
  module of homomorphisms.
-/

public section

open IsLocalRing Ideal RingTheory.Sequence TauCeti.IsLocalRing Module

namespace TauCeti.IsRegularLocalRing

variable {A : Type*} [CommRing A] [IsRegularLocalRing A]

/-- The maximal ideal of a two-dimensional regular local ring needs exactly two generators. -/
theorem spanFinrank_maximalIdeal_eq_two (hdim : ringKrullDim A = 2) :
    (maximalIdeal A).spanFinrank = 2 := by
  have h := _root_.IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
  rw [hdim] at h
  exact_mod_cast h

/-- The maximal ideal of a two-dimensional regular local ring is generated by two elements. -/
theorem exists_span_pair_eq_maximalIdeal (hdim : ringKrullDim A = 2) :
    ∃ x y : A, span {x, y} = maximalIdeal A := by
  classical
  obtain ⟨s, hcard, hspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank (maximalIdeal A).fg_of_isNoetherianRing
  obtain ⟨x, y, _, rfl⟩ :=
    Finset.card_eq_two.mp (hcard.trans (spanFinrank_maximalIdeal_eq_two hdim))
  exact ⟨x, y, by simpa using hspan⟩

/-- Over a two-dimensional regular local ring, a finite module is free as soon as some pair
generating the maximal ideal is a weakly regular sequence on it. -/
theorem free_of_isWeaklyRegular {M : Type*} [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hdim : ringKrullDim A = 2) {x y : A} (hxy : span {x, y} = maximalIdeal A)
    (hM : IsWeaklyRegular M [x, y]) : Module.Free A M := by
  have hxm := mem_maximalIdeal_of_span_pair_eq_maximalIdeal hxy
  have hx2 := notMem_sq_of_span_pair_eq_maximalIdeal hdim hxy
  have hx0 := ne_zero_of_span_pair_eq_maximalIdeal hdim hxy
  -- The quotient by `x` is a discrete valuation ring with uniformizer the image of `y`.
  let Q := A ⧸ span {x}
  have : IsRegularLocalRing Q := quotient_span_singleton hxm hx2
  have : IsDiscreteValuationRing Q :=
    isDiscreteValuationRing_iff_ringKrullDim_eq_one.mpr
      (TauCeti.ringKrullDim_quotient_span_singleton_eq_one hdim hxm
        (mem_nonZeroDivisors_of_ne_zero hx0))
  have hπ : Irreducible (Ideal.Quotient.mk (span {x}) y) := by
    rw [IsDiscreteValuationRing.irreducible_iff_uniformizer,
      ← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective, ← hxy, Ideal.map_span,
      Set.image_insert_eq, Set.image_singleton,
      Ideal.Quotient.eq_zero_iff_mem.mpr (mem_span_singleton_self x), span_insert_zero]
  obtain ⟨hxreg, hyreg⟩ := (isWeaklyRegular_cons_iff M x [y]).mp hM
  have hπreg : IsSMulRegular (QuotSMulTop x M) (Ideal.Quotient.mk (span {x}) y) := by
    rw [← Ideal.Quotient.algebraMap_eq, isSMulRegular_algebraMap_iff]
    exact (isWeaklyRegular_singleton_iff _ _).mp hyreg
  -- Every nonzero scalar of `Q` is a unit times a power of the regular uniformizer.
  have : Module.IsTorsionFree Q (QuotSMulTop x M) := by
    constructor
    intro q hq
    obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hq.ne_zero hπ
    exact (u.isSMulRegular _).mul (hπreg.pow n)
  have : Module.Finite Q (QuotSMulTop x M) := Module.Finite.of_restrictScalars_finite A Q _
  have : Module.FinitePresentation A M := Module.finitePresentation_of_finite A M
  exact (Module.free_quotSMulTop_iff_free A M
    (by rwa [jacobson_eq_maximalIdeal ⊥ bot_ne_top]) hxreg).mp inferInstance

/-- In a regular local ring of dimension at most two, every prime ideal other than the maximal
ideal is principal. In dimension two such a prime is a free module, since a pair generating the
maximal ideal is regular on it. -/
theorem isPrincipal_of_ne_maximalIdeal (hdim : ringKrullDim A ≤ 2) {p : Ideal A} [p.IsPrime]
    (hp : p ≠ maximalIdeal A) : p.IsPrincipal := by
  rcases hdim.lt_or_eq with hlt | hdim
  · have := valuationRing_of_ringKrullDim_le_one (Order.le_of_lt_succ hlt)
    exact IsPrincipalIdealRing.principal p
  obtain ⟨x, y, hxy⟩ := exists_span_pair_eq_maximalIdeal hdim
  have hxm := mem_maximalIdeal_of_span_pair_eq_maximalIdeal hxy
  have hx2 := notMem_sq_of_span_pair_eq_maximalIdeal hdim hxy
  have hx0 := ne_zero_of_span_pair_eq_maximalIdeal hdim hxy
  have hprime : (span {x}).IsPrime := span_singleton_isPrime_of_notMem_sq hxm hx2
  have hy := notMem_span_singleton_of_span_pair_eq_maximalIdeal hdim hxy
  -- `p` does not contain both parameters, since it is not the maximal ideal.
  have hxy_p : x ∉ p ∨ y ∉ p := by
    by_contra! h
    refine hp ((maximalIdeal.isMaximal A).eq_of_le ‹p.IsPrime›.ne_top ?_).symm
    rw [← hxy, span_le]
    rintro z (rfl | rfl | _) <;> simp_all
  have hreg : IsWeaklyRegular p [x, y] := by
    refine (isWeaklyRegular_cons_iff p x [y]).mpr ⟨fun a b hab ↦ ?_, ?_⟩
    · exact Subtype.ext (mul_left_cancel₀ hx0 (congrArg Subtype.val hab))
    refine (isWeaklyRegular_singleton_iff _ _).mpr
      (TauCeti.isSMulRegular_quotSMulTop_iff.mpr fun a c hc ↦ ?_)
    rw [Submodule.mem_smul_pointwise_iff_exists]
    have hc' : x * c = y * a := congrArg Subtype.val hc
    -- `y a ∈ (x)` and `(x)` is prime, so `a = x d`; then `c = y d`, and `d ∈ p`.
    have hya : y * (a : A) ∈ span {x} := mem_span_singleton'.mpr ⟨c, by rw [mul_comm, hc']⟩
    obtain ⟨d, hd⟩ := mem_span_singleton'.mp ((hprime.mem_or_mem hya).resolve_left hy)
    have hcd : (c : A) = y * d := mul_left_cancel₀ hx0 (by rw [hc', ← hd]; ring)
    have hdp : d ∈ p := by
      rcases hxy_p with h | h
      · exact (‹p.IsPrime›.mem_or_mem (by rw [mul_comm, hd]; exact a.2)).resolve_left h
      · exact (‹p.IsPrime›.mem_or_mem (hcd ▸ c.2)).resolve_left h
    exact ⟨⟨d, hdp⟩, Submodule.mem_top, Subtype.ext (by simp [← hd, mul_comm])⟩
  have : Module.Free A p := free_of_isWeaklyRegular hdim hxy hreg
  exact (Submodule.rank_le_one_iff_isPrincipal p).mp
    ((Submodule.rank_le p).trans_eq (Module.rank_self A))

/-- **A regular local ring of dimension at most two is a unique factorization domain.** In
dimension at most one it is a field or a discrete valuation ring. In dimension two every nonzero
prime ideal contains a prime element, a regular parameter for the maximal ideal and a generator
for every other prime, so Kaplansky's criterion applies. -/
theorem uniqueFactorizationMonoid_of_ringKrullDim_le_two (hdim : ringKrullDim A ≤ 2) :
    UniqueFactorizationMonoid A := by
  rcases hdim.lt_or_eq with hlt | hdim
  · have := valuationRing_of_ringKrullDim_le_one (Order.le_of_lt_succ hlt)
    infer_instance
  refine UniqueFactorizationMonoid.iff_exists_prime_mem_of_isPrime.mpr fun p hp0 hp ↦ ?_
  by_cases hpm : p = maximalIdeal A
  · obtain ⟨x, y, hxy⟩ := exists_span_pair_eq_maximalIdeal hdim
    have hxm := mem_maximalIdeal_of_span_pair_eq_maximalIdeal hxy
    exact ⟨x, hpm ▸ hxm, (span_singleton_prime (ne_zero_of_span_pair_eq_maximalIdeal hdim hxy)).mp
      (span_singleton_isPrime_of_notMem_sq hxm (notMem_sq_of_span_pair_eq_maximalIdeal hdim hxy))⟩
  · obtain ⟨f, rfl⟩ := (isPrincipal_of_ne_maximalIdeal hdim.le hpm).principal
    have hf0 : f ≠ 0 := by rintro rfl; simp at hp0
    exact ⟨f, mem_span_singleton_self f, (span_singleton_prime hf0).mp hp⟩

/-- Over a regular local ring of dimension at most two, the dual `Hom(N, A)` of a finite module `N`
is free. In dimension two a regular system of parameters `x, y` is a regular sequence on `A`, so
it is weakly regular on `Hom(N, A)`; in smaller dimension `A` is a principal ideal domain. -/
theorem free_dual (hdim : ringKrullDim A ≤ 2) (N : Type*) [AddCommGroup N] [Module A N]
    [Module.Finite A N] : Module.Free A (Dual A N) := by
  rcases hdim.lt_or_eq with hlt | hdim
  · have := valuationRing_of_ringKrullDim_le_one (Order.le_of_lt_succ hlt)
    infer_instance
  obtain ⟨x, y, hxy⟩ := exists_span_pair_eq_maximalIdeal hdim
  have hreg : IsRegular A [x, y] := isRegular_of_ofList_eq_maximalIdeal
    (by simpa [ofList_cons, ofList_singleton, ← span_insert] using hxy)
    (by simp [spanFinrank_maximalIdeal_eq_two hdim])
  exact free_of_isWeaklyRegular hdim hxy (hreg.toIsWeaklyRegular.linearMap (by simp))

/-- **Reflexive modules are free in dimension two.** Over a regular local ring of dimension at
most two, a finite reflexive module is free, being isomorphic to the dual of its dual. -/
theorem free_of_isReflexive (hdim : ringKrullDim A ≤ 2) (N : Type*) [AddCommGroup N] [Module A N]
    [Module.Finite A N] [IsReflexive A N] : Module.Free A N :=
  have := free_dual hdim (Dual A N)
  .of_equiv (evalEquiv A N).symm

end TauCeti.IsRegularLocalRing
