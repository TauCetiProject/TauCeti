module

public import Mathlib.RingTheory.KrullDimension.Regular
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.Regular.RegularSequence
public import TauCeti.RingTheory.Ideal.Quotient.Operations

/-!
# Regularity lifts along a regular quotient

Let `R` be a Noetherian local ring and `x₁, …, x_r` a regular sequence in its maximal ideal `𝔪`.
If `R ⧸ (x₁, …, x_r)` is a regular local ring, then so is `R` (Stacks, Lemma 10.106.7 (00NU)).
The case `r = 1` is used in the proof of Abhyankar's lemma for a regular divisor: the local rings
of a scheme along a regular divisor are regular. Globally, if `x` is a nonzerodivisor of a
Noetherian ring `R` with `R ⧸ (x)` regular, then `R` is regular at every prime containing `x`, since
`R_P ⧸ (x)` is a localization of `R ⧸ (x)`.

## Main results

* `Ideal.isRegularLocalRing_of_quotient_of_spanFinrank_le`: if `R ⧸ I` is a regular
  local ring, `I` needs at most `n` generators and `dim (R ⧸ I) + n ≤ dim R`, then `R` is a
  regular local ring.
* `TauCeti.IsRegularLocalRing.of_quotient_isRegular`: if `rs` is a regular sequence in a
  Noetherian local ring `R` and `R ⧸ Ideal.ofList rs` is a regular local ring, then `R` is a
  regular local ring.
* `TauCeti.IsRegularLocalRing.of_quotient_nonZeroDivisor`: the case of one nonzerodivisor `x` in
  the maximal ideal.
* `TauCeti.IsRegularLocalRing.localization_of_quotient_nonZeroDivisor`: for a nonzerodivisor `x`
  of a Noetherian ring `R` and a prime `P` of `R ⧸ (x)` at which `R ⧸ (x)` is regular, `R` is
  regular at the preimage of `P`.
* `TauCeti.IsRegularLocalRing.localization_of_isRegularRing_quotient`: if moreover `R ⧸ (x)` is a
  regular ring, then `R` is regular at every prime containing `x`.

## References

* [Stacks Project, Lemma 10.106.7](https://stacks.math.columbia.edu/tag/00NU).
* Ported from T. Dupuy, T. Tucker and Z. Wang,
  [pcfawd-formalization](https://github.com/tdupu/pcfawd-formalization) at commit
  `9a20b3f351446d64e6015d704198bc71c7002008` (Apache-2.0),
  `lean/Pcf/Bounding/PrincipalQuotientRegular.lean`: `of_quotient_nonZeroDivisor` is its
  `Pcf.isRegularLocalRing_of_quotient_nonZeroDivisor`. The regular-sequence form
  `of_quotient_isRegular` extends the same argument to sequences of any length.
-/

public section

namespace Ideal

open IsLocalRing RingTheory.Sequence

universe u

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- **Regularity lifts along a quotient of the expected dimension.** Let `I` be an ideal of a
Noetherian local ring `R` with `R ⧸ I` regular local (so `I ≤ 𝔪`). If `I` is generated by at
most `n` elements and `dim (R ⧸ I) + n ≤ dim R`, then `R` is regular local.
The two theorems `TauCeti.IsRegularLocalRing.of_quotient_isRegular` and
`TauCeti.IsRegularLocalRing.of_quotient_nonZeroDivisor` are the cases where `I` is generated by a
regular sequence. -/
theorem isRegularLocalRing_of_quotient_of_spanFinrank_le (I : Ideal R)
    [IsRegularLocalRing (R ⧸ I)] {n : ℕ} (hn : I.spanFinrank ≤ n)
    (hdim : ringKrullDim (R ⧸ I) + n ≤ ringKrullDim R) : IsRegularLocalRing R := by
  have hI : I ≤ maximalIdeal R :=
    le_maximalIdeal (Ideal.Quotient.nontrivial_iff.mp inferInstance)
  have hgen : (maximalIdeal R).spanFinrank ≤ (maximalIdeal (R ⧸ I)).spanFinrank + n := by
    have h := Ideal.spanFinrank_le_spanFinrank_map_add_spanFinrank hI
      I.fg_of_isNoetherianRing
    rw [map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective] at h
    omega
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  calc ((maximalIdeal R).spanFinrank : WithBot ℕ∞)
      ≤ ((maximalIdeal (R ⧸ I)).spanFinrank : WithBot ℕ∞) + n := by exact_mod_cast hgen
    _ = ringKrullDim (R ⧸ I) + n := by rw [IsRegularLocalRing.spanFinrank_maximalIdeal]
    _ ≤ ringKrullDim R := hdim

end Ideal

namespace TauCeti

namespace IsRegularLocalRing

open _root_.IsLocalRing _root_.Ideal RingTheory.Sequence

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- **Regularity lifts along a regular sequence.** If `rs` is a regular sequence in a Noetherian
local ring `R` and `R ⧸ (rs)` is a regular local ring, then `R` is a regular local ring. Stacks,
Lemma 10.106.7 (00NU), second sentence. -/
@[stacks 00NU "regular sequence form"]
theorem of_quotient_isRegular {rs : List R} (hrs : IsRegular R rs)
    [IsRegularLocalRing (R ⧸ ofList rs)] : IsRegularLocalRing R := by
  exact isRegularLocalRing_of_quotient_of_spanFinrank_le (ofList rs)
    (Submodule.spanFinrank_span_list_le_length rs)
    (ringKrullDim_add_length_eq_ringKrullDim_of_isRegular rs hrs).le

variable (R) in
/-- **Regularity lifts along a nonzerodivisor.** A Noetherian local ring with a nonzerodivisor `x`
in the maximal ideal such that `R ⧸ (x)` is a regular local ring is a regular local ring. Stacks,
Lemma 10.106.7 (00NU), first sentence. -/
@[stacks 00NU]
theorem of_quotient_nonZeroDivisor {x : R} (hx : x ∈ maximalIdeal R) (hreg : x ∈ nonZeroDivisors R)
    [IsRegularLocalRing (R ⧸ Ideal.span {x})] : IsRegularLocalRing R := by
  have hn : (Ideal.span {x}).spanFinrank ≤ 1 := by
    simpa using Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton x)
  have hdim : ringKrullDim (R ⧸ Ideal.span {x}) + 1 = ringKrullDim R :=
    ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors hreg hx
  exact isRegularLocalRing_of_quotient_of_spanFinrank_le (Ideal.span {x}) hn
    (by exact_mod_cast hdim.le)

omit [IsLocalRing R] in
/-- **Regularity lifts along a nonzerodivisor, at a prime.** Let `x` be a nonzerodivisor of a
Noetherian ring `R` and `P` a prime of `R ⧸ (x)` at which `R ⧸ (x)` is regular. Then `R` is
regular at the preimage of `P`, a prime containing `x`. -/
theorem localization_of_quotient_nonZeroDivisor {x : R} (hx : x ∈ nonZeroDivisors R)
    (P : Ideal (R ⧸ span {x})) [P.IsPrime] [IsRegularLocalRing (Localization.AtPrime P)] :
    IsRegularLocalRing (Localization.AtPrime (P.comap (Ideal.Quotient.mk (span {x})))) := by
  set Q := P.comap (Ideal.Quotient.mk (span {x}))
  set B := Localization.AtPrime Q
  have hxm : algebraMap R B x ∈ maximalIdeal B := by
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff _ Q]
    simp [Q, Ideal.Quotient.eq_zero_iff_mem.mpr (mem_span_singleton_self x)]
  have hxreg : algebraMap R B x ∈ nonZeroDivisors B :=
    IsLocalization.map_nonZeroDivisors_le Q.primeCompl B ⟨x, hx, rfl⟩
  -- `B ⧸ (x)` is the localization of `R ⧸ (x)` at `P`
  have hspan : (span {x}).map (algebraMap R B) = span {algebraMap R B x} := by
    rw [Ideal.map_span, Set.image_singleton]
  have hloc : IsLocalization P.primeCompl (B ⧸ (span {x}).map (algebraMap R B)) := by
    rw [← P.map_primeCompl_comap_of_surjective _ Ideal.Quotient.mk_surjective]
    exact (inferInstance : IsLocalization (Algebra.algebraMapSubmonoid (R ⧸ span {x}) Q.primeCompl)
      (B ⧸ (span {x}).map (algebraMap R B)))
  have : IsRegularLocalRing (B ⧸ span {algebraMap R B x}) :=
    .of_ringEquiv ((IsLocalization.algEquiv P.primeCompl _
      (Localization.AtPrime P)).toRingEquiv.symm.trans (quotientEquivAlgOfEq R hspan).toRingEquiv)
  exact of_quotient_nonZeroDivisor B hxm hxreg

omit [IsLocalRing R] in
/-- **Regularity lifts along a nonzerodivisor with regular quotient.** If `x` is a nonzerodivisor
of a Noetherian ring `R` and `R ⧸ (x)` is a regular ring, then `R` is regular at every prime
containing `x`. -/
theorem localization_of_isRegularRing_quotient {x : R} (hx : x ∈ nonZeroDivisors R)
    [IsRegularRing (R ⧸ span {x})] (P : Ideal R) [P.IsPrime] (hxP : x ∈ P) :
    IsRegularLocalRing (Localization.AtPrime P) := by
  -- `P` is the preimage of the prime `P ⧸ (x)` of `R ⧸ (x)`
  obtain ⟨P', _, rfl⟩ : ∃ P' : Ideal (R ⧸ span {x}), P'.IsPrime ∧
      P'.comap (Ideal.Quotient.mk _) = P :=
    ⟨P.map (Ideal.Quotient.mk _), map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      (by rwa [mk_ker, span_singleton_le_iff_mem]), by
        rw [comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, mk_ker,
          sup_eq_left.mpr ((span_singleton_le_iff_mem P).mpr hxP)]⟩
  exact localization_of_quotient_nonZeroDivisor hx P'

end IsRegularLocalRing

end TauCeti
