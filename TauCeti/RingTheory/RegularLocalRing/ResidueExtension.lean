module

public import TauCeti.RingTheory.LocalRing.ResidueField.Completion
public import TauCeti.RingTheory.RegularLocalRing.Basic
import TauCeti.RingTheory.RegularLocalRing.Flat

/-!
# Regularity of completed residue-field extensions

Over a regular local ring `R` and any field extension `L` of `ResidueField R`, the completed
residue-field extension `TauCeti.IsLocalRing.CompletedResidueExtension R L` is flat over `R` and
its maximal ideal is generated by `maximalIdeal R`. Regularity therefore ascends from `R` to
`CompletedResidueExtension R L` (and in particular `CompletedResidueExtension R L` is an integral
domain via `IsRegularLocalRing.isDomain`).

## Main results

* `TauCeti.IsLocalRing.CompletedResidueExtension.instIsRegularLocalRing`: when `R` is a regular
  local ring, so is `CompletedResidueExtension R L`.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique III*, Chapitre 0,
  Proposition 10.3.1.
-/

public section

universe u v

open IsLocalRing

namespace TauCeti.IsLocalRing.CompletedResidueExtension

/-- When `R` is a regular local ring, `CompletedResidueExtension R L` is a regular local ring
(and hence an integral domain via `IsRegularLocalRing.isDomain`). -/
instance instIsRegularLocalRing (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (L : Type v) [Field L] [Algebra (ResidueField R) L] :
    IsRegularLocalRing (CompletedResidueExtension R L) :=
  IsRegularLocalRing.of_flat_of_map_maximalIdeal_eq (maximalIdeal_eq_map R L).symm

end TauCeti.IsLocalRing.CompletedResidueExtension
