/-!
# Regular local rings are domains

A Noetherian local ring `R` is regular (`IsRegularLocalRing`) when its maximal ideal `𝔪` can be
generated by `dim R` elements. This file proves that a regular local ring is an integral domain.
Consequently the local rings of a regular scheme are domains, which is what makes a connected
regular scheme irreducible, and a regular local ring of dimension one is a discrete valuation
ring, so that the local rings of a regular curve at its codimension-one points are discrete
valuation rings.

The proof is by induction on `d = dim R`. If `d = 0` then `𝔪 = 0` and `R` is a field. If
`d > 0`, prime avoidance gives `x ∈ 𝔪 \ 𝔪²` lying in no minimal prime of `R`. Then `R ⧸ (x)` has
dimension `d - 1`, and its maximal ideal needs one generator fewer, since `x` can replace one of a
minimal system of generators of `𝔪`. So `R ⧸ (x)` is regular of dimension `d - 1`, hence a domain
by induction, i.e. `(x)` is prime. A minimal prime `P ⊆ (x)` does not contain `x`, so `P = x P`,
and Nakayama's lemma gives `P = 0`.

## Main declarations

* `IsRegularLocalRing.isDomain`: a regular local ring is an integral domain;
* `IsRegularLocalRing.quotient_span_singleton`: for `x ∈ 𝔪 \ 𝔪²`, the quotient `R ⧸ (x)` is
  again a regular local ring;
* `IsRegularLocalRing.isDiscreteValuationRing_iff_ringKrullDim_eq_one`: a regular local ring is
  a discrete valuation ring exactly when it has dimension one.

Along the way, for a Noetherian local ring:

* `IsLocalRing.spanFinrank_map_maximalIdeal_quotient_add_one_le`: for `x ∈ 𝔪 \ 𝔪²`, the maximal
  ideal of `R ⧸ (x)` needs at least one generator fewer than `𝔪`;
* `IsLocalRing.exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes`: in positive dimension
  there is `x ∈ 𝔪 \ 𝔪²` outside every minimal prime;
* `ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_notMem_minimalPrimes`: for
  `x ∈ 𝔪` outside every minimal prime, `dim R ⧸ (x) + 1 = dim R`.

## References

* [The Stacks Project, Lemma 10.106.2](https://stacks.math.columbia.edu/tag/00NP) and
  [Lemma 10.106.3](https://stacks.math.columbia.edu/tag/00NQ).
* M. F. Atiyah and I. G. Macdonald, *Introduction to Commutative Algebra*, Lemma 11.23.
-/

public section

universe u

open IsLocalRing Ideal Pointwise

variable {R : Type u} [CommRing R]

namespace IsLocalRing

variable [IsLocalRing R]

/-- If `x ∈ 𝔪 \ 𝔪²`, then the image of `𝔪` in `R ⧸ (x)`, which is the maximal ideal of `R ⧸ (x)`,
needs at least one generator fewer than `𝔪`: some coefficient of `x` in a minimal system of
generators of `𝔪` is a unit, so `x` can replace the corresponding generator. -/
theorem spanFinrank_map_maximalIdeal_quotient_add_one_le (hfg : (maximalIdeal R).FG) {x : R}
    (hxm : x ∈ maximalIdeal R) (hx : x ∉ maximalIdeal R ^ 2) :
    ((maximalIdeal R).map (Ideal.Quotient.mk (span {x}))).spanFinrank + 1 ≤
      (maximalIdeal R).spanFinrank := by
  classical
  obtain ⟨s, hcard, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank hfg
  obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.mp (hspan ▸ hxm)
  -- some coefficient of `x` is a unit, since otherwise `x ∈ 𝔪²`
  obtain ⟨i, hi, hfi⟩ : ∃ i ∈ s, IsUnit (f i) := by
    by_contra! h
    refine hx (hf ▸ Ideal.sum_mem _ fun i hi ↦ ?_)
    rw [pow_two, smul_eq_mul]
    exact mul_mem_mul (not_not.mp (mt notMem_maximalIdeal.mp (h i hi)))
      (hspan ▸ Submodule.subset_span hi)
  set q := Ideal.Quotient.mk (span {x})
  have hmap : (maximalIdeal R).map q = span ((s.erase i).image q : Set (R ⧸ span {x})) := by
    apply le_antisymm
    · rw [← hspan, Ideal.map_span, Ideal.span_le]
      rintro _ ⟨j, hj, rfl⟩
      by_cases hji : j = i
      · subst hji
        have h0 : q (f j) * q j + ∑ a ∈ s.erase j, q (f a • a) = 0 := by
          rw [← map_mul, ← smul_eq_mul, ← map_sum, ← map_add,
            Finset.add_sum_erase _ (fun a ↦ f a • a) hj, hf]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (mem_span_singleton_self x)
        have hu : IsUnit (q (f j)) := hfi.map q
        have : q j = ↑hu.unit⁻¹ * -∑ a ∈ s.erase j, q (f a • a) := by
          rw [← eq_neg_of_add_eq_zero_left h0, ← mul_assoc, IsUnit.val_inv_mul, one_mul]
        rw [this]
        refine Ideal.mul_mem_left _ _ (neg_mem (Ideal.sum_mem _ fun a ha ↦ ?_))
        rw [smul_eq_mul, map_mul]
        exact Ideal.mul_mem_left _ _
          (subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem q ha)))
      · exact subset_span (Finset.mem_coe.mpr
          (Finset.mem_image_of_mem q (Finset.mem_erase.mpr ⟨hji, hj⟩)))
    · rw [Ideal.span_le]
      rintro _ hj
      simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe] at hj
      obtain ⟨j, hj, rfl⟩ := hj
      exact mem_map_of_mem q (hspan ▸ Submodule.subset_span (Finset.mem_of_mem_erase hj))
  rw [hmap, ← hcard, ← Finset.card_erase_add_one hi, add_le_add_iff_right]
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet _)).trans ?_
  rw [Set.ncard_coe_finset]
  exact Finset.card_image_le

/-- In a Noetherian local ring of positive dimension, by prime avoidance there is an element of
the maximal ideal which lies neither in its square nor in any minimal prime. -/
theorem exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes [IsNoetherianRing R]
    (h : 0 < ringKrullDim R) :
    ∃ x ∈ maximalIdeal R, x ∉ maximalIdeal R ^ 2 ∧ ∀ p ∈ minimalPrimes R, x ∉ p := by
  by_contra! H
  have hsub : (maximalIdeal R : Set R) ⊆ ⋃ i ∈ insert (maximalIdeal R ^ 2) (minimalPrimes R),
      (i : Set R) := by
    intro x hx
    by_cases hx2 : x ∈ maximalIdeal R ^ 2
    · exact Set.mem_biUnion (Set.mem_insert _ _) hx2
    · obtain ⟨p, hp, hxp⟩ := H x hx hx2
      exact Set.mem_biUnion (Set.mem_insert_of_mem _ hp) hxp
  obtain ⟨i, hi, hmi⟩ := (subset_union_prime_finite
    ((minimalPrimes.finite_of_isNoetherianRing R).insert _) (f := id)
    (maximalIdeal R ^ 2) (maximalIdeal R ^ 2)
    fun (i : Ideal R) hi hi₁ _ ↦
      IsMinimalPrime.isPrime ((Set.mem_insert_iff.mp hi).resolve_left hi₁)).mp hsub
  rcases Set.mem_insert_iff.mp hi with rfl | hi
  · -- `𝔪 = 𝔪²` forces `𝔪 = 0` by Krull's intersection theorem, so `R` is a field
    have hidem : IsIdempotentElem (maximalIdeal R) :=
      le_antisymm mul_le_right (pow_two (maximalIdeal R) ▸ hmi)
    rcases (isIdempotentElem_iff_eq_bot_or_top_of_isLocalRing _).mp hidem with hm | hm
    · rw [ringKrullDim_eq_zero_of_isField (isField_iff_maximalIdeal_eq.mpr hm)] at h
      exact h.false
    · exact (maximalIdeal.isMaximal R).ne_top hm
  · -- `𝔪` would be a minimal prime, hence of height zero
    obtain rfl : i = maximalIdeal R :=
      le_antisymm (le_maximalIdeal (IsMinimalPrime.isPrime hi).ne_top) hmi
    rw [← maximalIdeal_height_eq_ringKrullDim, height_eq_zero_iff.mpr hi] at h
    exact h.false

end IsLocalRing

/-- In a Noetherian local ring, for `x` in the maximal ideal outside every minimal prime,
`dim R ⧸ (x) + 1 = dim R`. -/
@[stacks 0B52 "the equality case"]
theorem ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_notMem_minimalPrimes
    [IsLocalRing R] [IsNoetherianRing R] {x : R} (hxm : x ∈ maximalIdeal R)
    (hmin : ∀ p ∈ minimalPrimes R, x ∉ p) :
    ringKrullDim (R ⧸ span {x}) + 1 = ringKrullDim R := by
  have h : span {x} = x • (⊤ : Ideal R) := by simp [← Submodule.ideal_span_singleton_smul]
  have hann : Module.annihilator R R = ⊥ :=
    Module.annihilator_eq_bot.mpr ((faithfulSMul_iff_algebraMap_injective R R).mpr fun _ _ h ↦ h)
  rw [ringKrullDim_eq_of_ringEquiv (quotientEquivAlgOfEq R h).toRingEquiv,
    ← Module.supportDim_quotient_eq_ringKrullDim, ← Module.supportDim_self_eq_ringKrullDim]
  exact Module.supportDim_quotSMulTop_succ_eq_of_notMem_minimalPrimes_of_mem_maximalIdeal
    (by rwa [hann]) hxm

namespace IsRegularLocalRing

variable [IsRegularLocalRing R]

/-- Cancellation of `+ 1` against a natural number in `WithBot ℕ∞`. -/
private lemma eq_of_add_one_eq {d : WithBot ℕ∞} {n : ℕ} (h : d + 1 = ((n + 1 : ℕ) : WithBot ℕ∞)) :
    d = n := by
  induction d using WithBot.recBotCoe with
  | bot => exact absurd h (by rw [WithBot.bot_add]; exact WithBot.bot_ne_coe)
  | coe d =>
    induction d using ENat.recTopCoe with
    | top => exact absurd h (by norm_cast; rw [top_add]; exact ENat.top_ne_natCast _)
    | coe d => norm_cast at h ⊢; omega

/-- The induction step: for `x ∈ 𝔪 \ 𝔪²` outside every minimal prime, `R ⧸ (x)` is regular. -/
private lemma quotient_aux {x : R} (hxm : x ∈ maximalIdeal R) (hx : x ∉ maximalIdeal R ^ 2)
    (hmin : ∀ p ∈ minimalPrimes R, x ∉ p) :
    IsRegularLocalRing (R ⧸ span {x}) := by
  have : Nontrivial (R ⧸ span {x}) := Ideal.Quotient.nontrivial_iff.mpr fun h ↦
    (maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (h ▸ (span_singleton_le_iff_mem _).mpr hxm))
  have := IsLocalRing.of_surjective' (Ideal.Quotient.mk (span {x})) Ideal.Quotient.mk_surjective
  apply of_spanFinrank_maximalIdeal_le
  have h₁ := spanFinrank_map_maximalIdeal_quotient_add_one_le
    (maximalIdeal R).fg_of_isNoetherianRing hxm hx
  rw [map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective] at h₁
  have h₂ :=
    ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_notMem_minimalPrimes hxm hmin
  rw [← spanFinrank_maximalIdeal (R := R)] at h₂
  obtain ⟨k, hk⟩ : ∃ k, (maximalIdeal R).spanFinrank = k + 1 :=
    ⟨_, (Nat.succ_pred_eq_of_pos (by omega)).symm⟩
  rw [hk] at h₁ h₂
  rw [eq_of_add_one_eq h₂]
  exact_mod_cast (by omega : (maximalIdeal (R ⧸ span {x})).spanFinrank ≤ k)

/-- A regular local ring of dimension `n` is a domain, by induction on `n`. -/
private theorem isDomain_of_ringKrullDim_eq (n : ℕ) :
    ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R], ringKrullDim R = n → IsDomain R := by
  induction n with
  | zero =>
    intro R _ _ h
    have hm : maximalIdeal R = ⊥ :=
      (Submodule.spanFinrank_eq_zero_iff_eq_bot (maximalIdeal R).fg_of_isNoetherianRing).mp
        (by exact_mod_cast (spanFinrank_maximalIdeal (R := R)).trans h)
    exact (isField_iff_maximalIdeal_eq.mpr hm).isDomain
  | succ n ih =>
    intro R _ _ h
    obtain ⟨x, hxm, hx, hmin⟩ :=
      exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes (R := R)
        (by rw [h]; exact_mod_cast n.succ_pos)
    have := quotient_aux hxm hx hmin
    have hdim : ringKrullDim (R ⧸ span {x}) = n := by
      have := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_notMem_minimalPrimes
        hxm hmin
      exact eq_of_add_one_eq (this.trans h)
    have hprime : (span {x}).IsPrime := (Quotient.isDomain_iff_prime (span {x})).mp (ih _ hdim)
    -- a minimal prime `P ⊆ (x)` satisfies `P = x P`, hence vanishes by Nakayama's lemma
    obtain ⟨P, hP, hPx⟩ := exists_minimalPrimes_le (bot_le : ⊥ ≤ span {x})
    have hPprime : P.IsPrime := IsMinimalPrime.isPrime hP
    have hP0 : P = ⊥ := by
      refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (span {x}) P
        P.fg_of_isNoetherianRing (fun y hy ↦ ?_) ?_
      · obtain ⟨z, rfl⟩ := mem_span_singleton'.mp (hPx hy)
        have hz : z ∈ P := (hPprime.mem_or_mem hy).resolve_right (hmin P hP)
        rw [mul_comm, ← smul_eq_mul]
        exact Submodule.smul_mem_smul (mem_span_singleton_self x) hz
      · rw [jacobson_eq_maximalIdeal ⊥ bot_ne_top, span_singleton_le_iff_mem]
        exact hxm
    have : (⊥ : Ideal R).IsPrime := hP0 ▸ hPprime
    exact IsDomain.of_bot_isPrime R

/-- **A regular local ring is an integral domain.** -/
@[stacks 00NP]
instance (priority := 100) isDomain : IsDomain R :=
  isDomain_of_ringKrullDim_eq _ R (spanFinrank_maximalIdeal (R := R)).symm

/-- If `R` is a regular local ring and `x ∈ 𝔪 \ 𝔪²`, then `R ⧸ (x)` is a regular local ring. Its
dimension is `dim R - 1`, by Mathlib's
`ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors`, as `x ≠ 0` in
the domain `R`. -/
@[stacks 00NQ "(2), for one generator"]
theorem quotient_span_singleton {x : R} (hxm : x ∈ maximalIdeal R)
    (hx : x ∉ maximalIdeal R ^ 2) : IsRegularLocalRing (R ⧸ span {x}) := by
  refine quotient_aux hxm hx fun p hp hxp ↦ hx ?_
  rw [IsDomain.minimalPrimes_eq_singleton_bot, Set.mem_singleton_iff] at hp
  rw [show x = 0 by simpa [hp] using hxp]
  exact zero_mem _

/-- A regular local ring is a discrete valuation ring exactly when it has dimension one. -/
theorem isDiscreteValuationRing_iff_ringKrullDim_eq_one :
    IsDiscreteValuationRing R ↔ ringKrullDim R = 1 := by
  refine ⟨fun _ ↦ IsDiscreteValuationRing.ringKrullDim_eq_one R, fun h ↦ ?_⟩
  rw [← finrank_CotangentSpace_eq_one_iff]
  have := (iff_finrank_cotangentSpace R).mp inferInstance
  rw [h] at this
  exact_mod_cast this

end IsRegularLocalRing
