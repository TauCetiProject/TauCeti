/-!
# Rational fractions of affinoid algebras

Let `A` be a normed algebra, `g ∈ A` and `f = (f₁, …, fₘ)` a family in `A`. The rational fraction
algebra is

`A⟨f/g⟩ = A⟨X₁, …, Xₘ⟩ ⧸ (g Xᵢ - fᵢ)`,

the quotient of the Gauss-normed algebra of unit-radius restricted series by the ideal
`TauCeti.rationalIdeal g f`. The class of `Xᵢ` is the ratio `fᵢ/g`. When `g, f₁, …, fₘ` generate
the unit ideal, `A⟨f/g⟩` is the coordinate ring of the rational domain
`{x ∈ Sp A : |fᵢ(x)| ≤ |g(x)|}`; this file develops the algebra only.

When `A` is affinoid, so is `A⟨f/g⟩`. If `g, f₁, …, fₘ` generate the unit ideal of `A`, then `g`
becomes a unit in `A⟨f/g⟩`, each ratio `fᵢ/g` is power-bounded for the quotient topology, and
`A⟨f/g⟩` has the universal property of the rational localisation among completely normed
affinoid algebras: `K`-algebra maps `A⟨f/g⟩ → B` correspond to `K`-algebra maps `φ : A → B` for
which `φ g` is a unit and every `φ fᵢ / φ g` is power-bounded. No continuity is assumed, since
algebra maps between affinoid algebras are automatically continuous; the extension is continuous
for the quotient topology of `A⟨f/g⟩`.

Without the unit-ideal hypothesis the denominator need not become invertible: for `g = 0` and
`f = 0` the ideal is zero, and `A⟨0/0⟩ = A⟨X⟩`
(`TauCeti.RationalFraction.not_isUnit_algebraMap_zero`).
Weierstrass fractions `A⟨f⟩` are the case `g = 1`.

## Main definitions

* `TauCeti.rationalIdeal g f`: the ideal of `A⟨X₁, …, Xₘ⟩` generated by the `g Xᵢ - fᵢ`.
* `TauCeti.RationalFraction g f`: the rational fraction algebra `A⟨f/g⟩`.
* `TauCeti.RationalFraction.ratio g f i`: the class of `Xᵢ`, written `fᵢ/g`.
* `TauCeti.RationalFraction.lift`: the `K`-algebra map `A⟨f/g⟩ → B` extending `φ : A → B` and
  sending `fᵢ/g` to a power-bounded `bᵢ` with `φ g * bᵢ = φ fᵢ`.

## Main results

* `TauCeti.RationalFraction.isAffinoidAlgebra`: `A⟨f/g⟩` is affinoid when `A` is.
* `TauCeti.RationalFraction.algebraMap_mul_ratio`: `g · (fᵢ/g) = fᵢ` in `A⟨f/g⟩`.
* `TauCeti.RationalFraction.isUnit_algebraMap`: `g` is a unit of `A⟨f/g⟩` when
  `(g, f₁, …, fₘ) = A`.
* `TauCeti.RationalFraction.isPowerBounded_ratio`: each `fᵢ/g` is power-bounded.
* `TauCeti.RationalFraction.continuous_lift`: the extension is continuous.
* `TauCeti.RationalFraction.algHom_ext`: maps out of `A⟨f/g⟩` are determined on `A`.
* `TauCeti.RationalFraction.existsUnique_algHom`: the universal property.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §§6.1.4 and
  7.2.2.
-/

public section

namespace TauCeti

open _root_.MvPowerSeries TauCeti.MvPowerSeries TauCeti.Huber

variable {A : Type*} [NormedCommRing A] [IsUltrametricDist A] {m : ℕ}

/-- The ideal of `A⟨X₁, …, Xₘ⟩` generated by the elements `g Xᵢ - fᵢ`, whose quotient is the
rational fraction algebra `A⟨f/g⟩`. -/
noncomputable def rationalIdeal (g : A) (f : Fin m → A) :
    Ideal (IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1)) :=
  Ideal.span (Set.range fun i ↦
    algebraMap A _ g * ⟨X i, isRestricted_X _ i⟩ - algebraMap A _ (f i))

/-- `rationalIdeal g f` is the ideal spanned by the `g Xᵢ - fᵢ`. -/
theorem rationalIdeal_eq_span (g : A) (f : Fin m → A) :
    rationalIdeal g f = Ideal.span (Set.range fun i ↦
      algebraMap A _ g * ⟨X i, isRestricted_X _ i⟩ - algebraMap A _ (f i)) := (rfl)

/-- **The rational fraction algebra** `A⟨f/g⟩ = A⟨X₁, …, Xₘ⟩ ⧸ (g Xᵢ - fᵢ)`. It carries the
quotient ring, algebra and topology structures of `Ideal.Quotient`. -/
noncomputable abbrev RationalFraction (g : A) (f : Fin m → A) :=
  IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1) ⧸ rationalIdeal g f

namespace RationalFraction

/-- The ratio `fᵢ/g` in `A⟨f/g⟩`: the class of the variable `Xᵢ`. -/
noncomputable def ratio (g : A) (f : Fin m → A) (i : Fin m) : RationalFraction g f :=
  Ideal.Quotient.mk _ ⟨X i, isRestricted_X _ i⟩

variable {g : A} {f : Fin m → A}

/-- The ratio `fᵢ/g` is the class of `Xᵢ`. -/
@[simp]
theorem mk_X (i : Fin m) :
    Ideal.Quotient.mk (rationalIdeal g f) ⟨X i, isRestricted_X _ i⟩ = ratio g f i := (rfl)

/-- **`g · (fᵢ/g) = fᵢ`** in the rational fraction algebra. -/
@[simp]
theorem algebraMap_mul_ratio (i : Fin m) :
    algebraMap A (RationalFraction g f) g * ratio g f i = algebraMap A _ (f i) := by
  rw [← sub_eq_zero, ← Ideal.Quotient.mk_algebraMap, ← Ideal.Quotient.mk_algebraMap, ← mk_X,
    ← map_mul, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨i, rfl⟩

/-- **The denominator becomes a unit.** If `g, f₁, …, fₘ` generate the unit ideal of `A`, then `g`
is a unit of `A⟨f/g⟩`. -/
theorem isUnit_algebraMap (h : Ideal.span (insert g (Set.range f)) = ⊤) :
    IsUnit (algebraMap A (RationalFraction g f) g) := by
  rw [← Ideal.span_singleton_eq_top, eq_top_iff, ← Ideal.map_top (algebraMap A _), ← h,
    Ideal.map_span, Ideal.span_le]
  rintro _ ⟨x, hx | ⟨i, rfl⟩, rfl⟩
  · rw [hx]
    exact Ideal.mem_span_singleton_self _
  · rw [← algebraMap_mul_ratio i]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

/-- If `g, f₁, …, fₘ` generate the unit ideal of `A`, then `fᵢ/g` is `fᵢ` times the inverse of
`g` in `A⟨f/g⟩`. -/
theorem ratio_eq_algebraMap_mul_inverse (h : Ideal.span (insert g (Set.range f)) = ⊤)
    (i : Fin m) :
    ratio g f i = algebraMap A _ (f i) * Ring.inverse (algebraMap A (RationalFraction g f) g) := by
  rw [← algebraMap_mul_ratio i, mul_comm, ← mul_assoc,
    Ring.inverse_mul_cancel (algebraMap A (RationalFraction g f) g) (isUnit_algebraMap h),
    one_mul]

/-- Without the unit-ideal hypothesis the denominator need not become a unit: for `g = 0` and
`f = 0` the ideal `rationalIdeal 0 0` is zero, and `0` is not a unit of the nonzero algebra
`A⟨0/0⟩ = A⟨X₁, …, Xₘ⟩`. -/
theorem not_isUnit_algebraMap_zero [Nontrivial A] :
    ¬IsUnit (algebraMap A (RationalFraction (0 : A) (0 : Fin m → A)) 0) := by
  have h : rationalIdeal (0 : A) (0 : Fin m → A) = ⊥ := by
    simp [rationalIdeal_eq_span]
  have : Nontrivial (RationalFraction (0 : A) (0 : Fin m → A)) :=
    Ideal.Quotient.nontrivial_iff.mpr (h ▸ bot_ne_top)
  simp

/-- Each ratio `fᵢ/g` is power-bounded for the quotient topology of `A⟨f/g⟩`. -/
theorem isPowerBounded_ratio (i : Fin m) : IsPowerBounded (ratio g f i) := by
  -- Each ratio is the quotient image of a power-bounded variable.
  have hX := isPowerBounded_X (R := A) i
  exact hX.quotientMk (rationalIdeal g f)

section Affinoid

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [NormedAlgebra K A] [CompleteSpace A] (hA : IsAffinoidAlgebra K A)

include hA in
/-- **Rational fractions of an affinoid algebra are affinoid**, being quotients of the affinoid
algebra `A⟨X₁, …, Xₘ⟩`. -/
theorem isAffinoidAlgebra (g : A) (f : Fin m → A) :
    IsAffinoidAlgebra K (RationalFraction g f) :=
  (hA.isRestricted_subring (τ := Fin m)).quotient _

variable {B : Type*} [NormedCommRing B] [NormedAlgebra K B] [IsUltrametricDist B]
  [CompleteSpace B] (hB : IsAffinoidAlgebra K B)

/-- **The extension of `φ : A → B` to `A⟨f/g⟩` sending `fᵢ/g` to `bᵢ`**, for affinoid algebras
`A` and `B` with complete ultrametric algebra norms and power-bounded `b₁, …, bₘ ∈ B` satisfying
`φ g * bᵢ = φ fᵢ`. -/
noncomputable def lift (φ : A →ₐ[K] B) {b : Fin m → B} (hb : ∀ i, IsPowerBounded (b i))
    (hφ : ∀ i, φ g * b i = φ (f i)) : RationalFraction g f →ₐ[K] B :=
  -- Descend restrictedLift to the quotient: it kills every relation g Xᵢ - fᵢ.
  Ideal.Quotient.liftₐ _ (hA.restrictedLift hB φ hb) fun _ hx ↦ RingHom.mem_ker.mp <|
    Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; simp [hφ]) hx

variable (φ : A →ₐ[K] B) {b : Fin m → B} (hb : ∀ i, IsPowerBounded (b i))
  (hφ : ∀ i, φ g * b i = φ (f i))

/-- `lift` extends `φ` on `A`. -/
@[simp]
theorem lift_algebraMap (a : A) :
    lift hA hB φ hb hφ (algebraMap A (RationalFraction g f) a) = φ a := by
  rw [← Ideal.Quotient.mk_algebraMap]
  exact IsAffinoidAlgebra.restrictedLift_algebraMap hA hB φ hb a

/-- `lift` sends each ratio `fᵢ/g` to `bᵢ`. -/
@[simp]
theorem lift_ratio (i : Fin m) : lift hA hB φ hb hφ (ratio g f i) = b i :=
  IsAffinoidAlgebra.restrictedLift_X hA hB φ hb i

/-- `lift` is continuous for the quotient topology of `A⟨f/g⟩`. -/
theorem continuous_lift : Continuous (lift hA hB φ hb hφ) :=
  have := (hA.isRestricted_subring (τ := Fin m)).isNoetherianRing
  Ideal.Quotient.continuous_lift _ (hB.continuous_algHom (hA.restrictedLift hB φ hb)) _

include hA hB in
/-- **`K`-algebra maps out of `A⟨f/g⟩` are determined on `A`** when `g, f₁, …, fₘ` generate the
unit ideal: the image of `fᵢ/g` is then forced to be `φ fᵢ · (φ g)⁻¹`. No continuity is assumed. -/
theorem algHom_ext (h : Ideal.span (insert g (Set.range f)) = ⊤)
    {ψ₁ ψ₂ : RationalFraction g f →ₐ[K] B}
    (hC : ∀ a, ψ₁ (algebraMap A _ a) = ψ₂ (algebraMap A _ a)) : ψ₁ = ψ₂ := by
  refine Ideal.Quotient.algHom_ext K (IsAffinoidAlgebra.algHom_ext_isRestricted_subring hA hB
    (fun a ↦ ?_) fun i ↦ ?_)
  · simpa [← Ideal.Quotient.mk_algebraMap] using hC a
  · have hu := (isUnit_algebraMap h).map (ψ₁ : RationalFraction g f →+* B)
    have h₁ := congrArg ψ₁ (algebraMap_mul_ratio (g := g) (f := f) i)
    have h₂ := congrArg ψ₂ (algebraMap_mul_ratio (g := g) (f := f) i)
    rw [map_mul] at h₁ h₂
    rw [hC, hC, ← h₂] at h₁
    exact hu.mul_left_cancel ((hC g).symm ▸ h₁)

include hA hB in
/-- The image of a ratio `fᵢ/g` under any `K`-algebra map `A⟨f/g⟩ → B` into a completely normed
affinoid algebra is power-bounded. No continuity is assumed. -/
theorem isPowerBounded_map_ratio (ψ : RationalFraction g f →ₐ[K] B) (i : Fin m) :
    IsPowerBounded (ψ (ratio g f i)) := by
  have := (hA.isRestricted_subring (τ := Fin m)).isNoetherianRing
  have := IsTateRing.of_normedAlgebra K (IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1))
  have := IsTateRing.of_normedAlgebra K B
  let ψ' := ψ.comp (Ideal.Quotient.mkₐ K (rationalIdeal g f))
  have hX := isPowerBounded_X (R := A) i
  have hψ' := (hB.continuous_algHom ψ').continuousAt (x := 0)
  exact IsPowerBounded.map_of_isTateRing (f := (ψ' : _ →+* B)) hX hψ'

include hA hB in
/-- **The universal property of the rational fraction algebra.** Let `A` and `B` be affinoid
algebras with complete ultrametric algebra norms, and let `g, f₁, …, fₘ` generate the unit ideal of
`A`. A `K`-algebra map `φ : A → B` extends to a `K`-algebra map `A⟨f/g⟩ → B` if and only if `φ g`
is a unit and every `φ fᵢ · (φ g)⁻¹` is power-bounded, and the extension is then unique. -/
theorem existsUnique_algHom (h : Ideal.span (insert g (Set.range f)) = ⊤) (φ : A →ₐ[K] B) :
    (∃! ψ : RationalFraction g f →ₐ[K] B, ∀ a, ψ (algebraMap A _ a) = φ a) ↔
      IsUnit (φ g) ∧ ∀ i, IsPowerBounded (φ (f i) * Ring.inverse (φ g)) := by
  refine ⟨fun ⟨ψ, hψ, _⟩ ↦ ?_, fun ⟨hg, hb⟩ ↦ ?_⟩
  · have hu : IsUnit (φ g) := hψ g ▸ (isUnit_algebraMap h).map ψ
    refine ⟨hu, fun i ↦ ?_⟩
    have hi : φ g * ψ (ratio g f i) = φ (f i) := by
      rw [← hψ, ← hψ, ← map_mul, algebraMap_mul_ratio]
    rw [← hi, mul_comm (φ g), mul_assoc, Ring.mul_inverse_cancel _ hu, mul_one]
    exact isPowerBounded_map_ratio hA hB ψ i
  · have hφ (i : Fin m) : φ g * (φ (f i) * Ring.inverse (φ g)) = φ (f i) := by
      rw [mul_comm, mul_assoc, Ring.inverse_mul_cancel _ hg, mul_one]
    exact ⟨lift hA hB φ hb hφ, lift_algebraMap hA hB φ hb hφ, fun ψ hψ ↦
      algHom_ext hA hB h fun a ↦ by rw [hψ, lift_algebraMap]⟩

end Affinoid

end RationalFraction

end TauCeti
