/-!
# Tensor products of affinoid algebras

Let `A` be an affinoid algebra over a complete nonarchimedean field `K`, carrying a complete
ultrametric algebra norm, and let `B = A⟨X₁, …, Xₘ⟩ ⧸ I` and `C = A⟨Y₁, …, Yₖ⟩ ⧸ J` be presented
by ideals of Gauss-normed restricted series over `A`. Their affinoid tensor product is

`B ⊗̂_A C = A⟨X₁, …, Xₘ, Y₁, …, Yₖ⟩ ⧸ (I, J)`,

where `(I, J)` is generated by `I` in the variables `X` and by `J` in the variables `Y`. Here the
`m + k` variables are indexed by `Fin (m + k)`: `Xᵢ` is the variable `Fin.castAdd k i` and `Yⱼ`
is the variable `Fin.natAdd m j`.

This file constructs `TauCeti.AffinoidTensor I J`, its two coprojections, and proves that it is the
pushout of `B ← A → C` among completely normed affinoid algebras: a pair of `A`-algebra maps
`B → D` and `C → D` into an affinoid `D` factors uniquely through `B ⊗̂_A C`. No continuity is
assumed, since algebra maps into affinoid algebras are automatically continuous; the factorisation
is continuous for the quotient topology. Finally, the algebraic tensor product `B ⊗[A] C` has dense
image in `B ⊗̂_A C`, because the polynomials in the variables `X` and `Y` are dense in the
restricted series. Density does not make `B ⊗̂_A C` a completion of `B ⊗[A] C`.

## Main definitions

* `TauCeti.affinoidTensorIdeal I J`: the ideal `(I, J)` of `A⟨X₁, …, Xₘ, Y₁, …, Yₖ⟩`.
* `TauCeti.AffinoidTensor I J`: the affinoid tensor product `A⟨X, Y⟩ ⧸ (I, J)`.
* `TauCeti.AffinoidTensor.inl`, `TauCeti.AffinoidTensor.inr`: the coprojections from
  `A⟨X⟩ ⧸ I` and `A⟨Y⟩ ⧸ J`.
* `TauCeti.AffinoidTensor.lift`: the map `B ⊗̂_A C → D` induced by `A`-algebra maps `B → D` and
  `C → D` into an affinoid algebra.

## Main results

* `TauCeti.AffinoidTensor.isAffinoidAlgebra`: `B ⊗̂_A C` is affinoid.
* `TauCeti.AffinoidTensor.lift_comp_inl`, `TauCeti.AffinoidTensor.lift_comp_inr` and
  `TauCeti.AffinoidTensor.algHom_ext`: the universal property of the pushout, summarised in
  `TauCeti.AffinoidTensor.existsUnique_algHom`.
* `TauCeti.AffinoidTensor.continuous_lift`: the induced map is continuous.
* `TauCeti.AffinoidTensor.denseRange_productMap`: the algebraic tensor product `B ⊗[A] C` has
  dense image.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §§6.1.1
  and 7.1.
-/

public section

namespace TauCeti

open _root_.MvPowerSeries TauCeti.MvPowerSeries TauCeti.Huber

variable {A : Type*} [NormedCommRing A] [IsUltrametricDist A] {m k : ℕ}
  (I : Ideal (IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1)))
  (J : Ideal (IsRestricted.subring (R := A) (fun _ : Fin k ↦ 1)))

/-- The ideal `(I, J)` of `A⟨X₁, …, Xₘ, Y₁, …, Yₖ⟩` generated by `I` in the first `m` variables
and by `J` in the last `k` variables. -/
noncomputable def affinoidTensorIdeal :
    Ideal (IsRestricted.subring (R := A) (fun _ : Fin (m + k) ↦ 1)) :=
  I.map (restrictedRename (Fin.castAddEmb k)) ⊔ J.map (restrictedRename (Fin.natAddEmb m))

/-- **The affinoid tensor product** `(A⟨X⟩ ⧸ I) ⊗̂_A (A⟨Y⟩ ⧸ J) = A⟨X, Y⟩ ⧸ (I, J)`, in the
variables `X₁, …, Xₘ, Y₁, …, Yₖ` indexed by `Fin (m + k)`. It carries the quotient ring, algebra
and topology structures of `Ideal.Quotient`. -/
noncomputable abbrev AffinoidTensor :=
  IsRestricted.subring (R := A) (fun _ : Fin (m + k) ↦ 1) ⧸ affinoidTensorIdeal I J

namespace AffinoidTensor

/-- The left coprojection `A⟨X⟩ ⧸ I → A⟨X, Y⟩ ⧸ (I, J)`, induced by `Xᵢ ↦ Xᵢ`. -/
noncomputable def inl : (_ ⧸ I) →ₐ[A] AffinoidTensor I J :=
  Ideal.quotientMapₐ _ (restrictedRename (Fin.castAddEmb k))
    (Ideal.map_le_iff_le_comap.mp le_sup_left)

/-- The right coprojection `A⟨Y⟩ ⧸ J → A⟨X, Y⟩ ⧸ (I, J)`, induced by `Yⱼ ↦ Yⱼ`. -/
noncomputable def inr : (_ ⧸ J) →ₐ[A] AffinoidTensor I J :=
  Ideal.quotientMapₐ _ (restrictedRename (Fin.natAddEmb m))
    (Ideal.map_le_iff_le_comap.mp le_sup_right)

/-- The left coprojection is induced by renaming `Xᵢ` to the variable `Fin.castAdd k i`. -/
@[simp]
theorem inl_mk (f : IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1)) :
    inl I J (Ideal.Quotient.mk I f) =
      Ideal.Quotient.mk (affinoidTensorIdeal I J) (restrictedRename (Fin.castAddEmb k) f) := (rfl)

/-- The right coprojection is induced by renaming `Yⱼ` to the variable `Fin.natAdd m j`. -/
@[simp]
theorem inr_mk (f : IsRestricted.subring (R := A) (fun _ : Fin k ↦ 1)) :
    inr I J (Ideal.Quotient.mk J f) =
      Ideal.Quotient.mk (affinoidTensorIdeal I J) (restrictedRename (Fin.natAddEmb m) f) := (rfl)

/-- **The algebraic tensor product is dense in the affinoid tensor product**: the image of
`(A⟨X⟩ ⧸ I) ⊗[A] (A⟨Y⟩ ⧸ J)` under the product of the coprojections is dense in
`A⟨X, Y⟩ ⧸ (I, J)`. -/
theorem denseRange_productMap :
    DenseRange (Algebra.TensorProduct.productMap (inl I J) (inr I J)) := by
  let q := (Ideal.Quotient.mkₐ A (affinoidTensorIdeal I J)).comp
    (polynomialToRestricted (R := A) (fun _ : Fin (m + k) ↦ (1 : ℝ)))
  -- The classes of polynomials are dense, and each variable lies in the image of a coprojection.
  have hq : DenseRange q :=
    Ideal.Quotient.mk_surjective.denseRange.comp denseRange_polynomialToRestricted
      continuous_quot_mk
  have hle : q.range ≤ (Algebra.TensorProduct.productMap (inl I J) (inr I J)).range := by
    rw [← Algebra.map_top, ← MvPolynomial.adjoin_range_X, AlgHom.map_adjoin,
      Algebra.adjoin_le_iff, Algebra.TensorProduct.productMap_range]
    rintro _ ⟨_, ⟨l, rfl⟩, rfl⟩
    refine Fin.addCases (fun i ↦ Algebra.mem_sup_left ?_) (fun j ↦ Algebra.mem_sup_right ?_) l
    · exact ⟨Ideal.Quotient.mk I ⟨X i, isRestricted_X _ i⟩, by simp [q]⟩
    · exact ⟨Ideal.Quotient.mk J ⟨X j, isRestricted_X _ j⟩, by simp [q]⟩
  exact hq.mono fun _ hx ↦ hle hx

section Affinoid

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [NormedAlgebra K A] [CompleteSpace A] (hA : IsAffinoidAlgebra K A)

include hA in
/-- **The affinoid tensor product of affinoid algebras is affinoid**, being a quotient of the
affinoid algebra `A⟨X₁, …, Xₘ, Y₁, …, Yₖ⟩`. -/
theorem isAffinoidAlgebra : IsAffinoidAlgebra K (AffinoidTensor I J) :=
  (hA.isRestricted_subring (τ := Fin (m + k))).quotient _

variable {D : Type*} [NormedCommRing D] [NormedAlgebra K D] [IsUltrametricDist D]
  [CompleteSpace D] [Algebra A D] [IsScalarTower K A D] (hD : IsAffinoidAlgebra K D)

include hA hD in
/-- `A`-algebra maps from `A⟨X₁, …, Xₙ⟩` to a completely normed affinoid `A`-algebra agreeing on
the variables are equal. -/
private theorem restricted_algHom_ext {n : ℕ}
    {ψ₁ ψ₂ : IsRestricted.subring (R := A) (fun _ : Fin n ↦ 1) →ₐ[A] D}
    (hX : ∀ i, ψ₁ ⟨X i, isRestricted_X _ i⟩ = ψ₂ ⟨X i, isRestricted_X _ i⟩) : ψ₁ = ψ₂ :=
  AlgHom.restrictScalars_injective K <|
    hA.algHom_ext_isRestricted_subring hD (fun a ↦ by simp) hX

variable (φ : (_ ⧸ I) →ₐ[A] D) (ψ : (_ ⧸ J) →ₐ[A] D)

/-- The images in `D` of the variables `X₁, …, Xₘ, Y₁, …, Yₖ`. -/
private noncomputable def images : Fin (m + k) → D :=
  Fin.append (fun i ↦ φ (Ideal.Quotient.mk I ⟨X i, isRestricted_X _ i⟩))
    fun j ↦ ψ (Ideal.Quotient.mk J ⟨X j, isRestricted_X _ j⟩)

include hA hD in
private theorem isPowerBounded_images (l : Fin (m + k)) : IsPowerBounded (images I J φ ψ l) :=
  Fin.addCases
    (fun i ↦ by simpa [images] using hA.isPowerBounded_map_mk_X hD (φ.restrictScalars K) i)
    (fun j ↦ by simpa [images] using hA.isPowerBounded_map_mk_X hD (ψ.restrictScalars K) j) l

/-- The `A`-algebra map `A⟨X, Y⟩ → D` sending the variables to their images under `φ` and `ψ`. -/
private noncomputable def liftRestricted :
    IsRestricted.subring (R := A) (fun _ : Fin (m + k) ↦ 1) →ₐ[A] D :=
  { hA.restrictedLift hD (IsScalarTower.toAlgHom K A D) (isPowerBounded_images I J hA hD φ ψ) with
    commutes' := IsAffinoidAlgebra.restrictedLift_algebraMap hA hD _ _ }

private theorem liftRestricted_X (l : Fin (m + k)) :
    liftRestricted I J hA hD φ ψ ⟨X l, isRestricted_X _ l⟩ = images I J φ ψ l :=
  IsAffinoidAlgebra.restrictedLift_X hA hD _ _ l

private theorem liftRestricted_comp_castAdd :
    (liftRestricted I J hA hD φ ψ).comp (restrictedRename (Fin.castAddEmb k)) =
      φ.comp (Ideal.Quotient.mkₐ A I) :=
  restricted_algHom_ext hA hD fun i ↦ by simp [liftRestricted_X, images]

private theorem liftRestricted_comp_natAdd :
    (liftRestricted I J hA hD φ ψ).comp (restrictedRename (Fin.natAddEmb m)) =
      ψ.comp (Ideal.Quotient.mkₐ A J) :=
  restricted_algHom_ext hA hD fun j ↦ by simp [liftRestricted_X, images]

private theorem le_ker_liftRestricted :
    affinoidTensorIdeal I J ≤ RingHom.ker (liftRestricted I J hA hD φ ψ) := by
  refine sup_le (Ideal.map_le_iff_le_comap.mpr fun f hf ↦ ?_)
    (Ideal.map_le_iff_le_comap.mpr fun f hf ↦ ?_) <;>
    rw [Ideal.mem_comap, RingHom.mem_ker]
  · have h := congr($(liftRestricted_comp_castAdd I J hA hD φ ψ) f)
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.mpr hf, map_zero] at h
    simpa using h
  · have h := congr($(liftRestricted_comp_natAdd I J hA hD φ ψ) f)
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.mpr hf, map_zero] at h
    simpa using h

/-- **The map out of the affinoid tensor product** induced by `A`-algebra maps
`φ : A⟨X⟩ ⧸ I → D` and `ψ : A⟨Y⟩ ⧸ J → D` into a completely normed affinoid algebra `D`. No
continuity is assumed. -/
noncomputable def lift : AffinoidTensor I J →ₐ[A] D :=
  Ideal.Quotient.liftₐ _ (liftRestricted I J hA hD φ ψ) fun _ hx ↦
    le_ker_liftRestricted I J hA hD φ ψ hx

/-- `lift` restricts to `φ` along the left coprojection. -/
@[simp]
theorem lift_comp_inl : (lift I J hA hD φ ψ).comp (inl I J) = φ :=
  Ideal.Quotient.algHom_ext A (liftRestricted_comp_castAdd I J hA hD φ ψ)

/-- `lift` restricts to `ψ` along the right coprojection. -/
@[simp]
theorem lift_comp_inr : (lift I J hA hD φ ψ).comp (inr I J) = ψ :=
  Ideal.Quotient.algHom_ext A (liftRestricted_comp_natAdd I J hA hD φ ψ)

/-- `lift` agrees with `φ` on the image of the left coprojection. -/
@[simp]
theorem lift_inl (x : _ ⧸ I) : lift I J hA hD φ ψ (inl I J x) = φ x :=
  congr($(lift_comp_inl I J hA hD φ ψ) x)

/-- `lift` agrees with `ψ` on the image of the right coprojection. -/
@[simp]
theorem lift_inr (x : _ ⧸ J) : lift I J hA hD φ ψ (inr I J x) = ψ x :=
  congr($(lift_comp_inr I J hA hD φ ψ) x)

/-- `lift` is continuous for the quotient topology of `A⟨X, Y⟩ ⧸ (I, J)`. -/
theorem continuous_lift : Continuous (lift I J hA hD φ ψ) :=
  have := (hA.isRestricted_subring (τ := Fin (m + k))).isNoetherianRing
  Ideal.Quotient.continuous_lift _
    (hD.continuous_algHom ((liftRestricted I J hA hD φ ψ).restrictScalars K)) _

include hA hD in
/-- **`A`-algebra maps out of the affinoid tensor product are determined by the coprojections.**
Two `A`-algebra maps `A⟨X, Y⟩ ⧸ (I, J) → D` into a completely normed affinoid algebra agreeing
after composition with `inl` and with `inr` are equal. No continuity is assumed. -/
theorem algHom_ext {χ₁ χ₂ : AffinoidTensor I J →ₐ[A] D}
    (hl : χ₁.comp (inl I J) = χ₂.comp (inl I J)) (hr : χ₁.comp (inr I J) = χ₂.comp (inr I J)) :
    χ₁ = χ₂ := by
  refine Ideal.Quotient.algHom_ext A (restricted_algHom_ext hA hD fun l ↦ ?_)
  refine Fin.addCases (fun i ↦ ?_) (fun j ↦ ?_) l
  · simpa using congr($hl (Ideal.Quotient.mk I ⟨X i, isRestricted_X _ i⟩))
  · simpa using congr($hr (Ideal.Quotient.mk J ⟨X j, isRestricted_X _ j⟩))

include hA hD in
/-- **The universal property of the affinoid tensor product.** For `A`-algebra maps
`φ : A⟨X⟩ ⧸ I → D` and `ψ : A⟨Y⟩ ⧸ J → D` into a completely normed affinoid algebra `D`, there is
exactly one `A`-algebra map `A⟨X, Y⟩ ⧸ (I, J) → D` restricting to `φ` and `ψ` along the
coprojections, namely `TauCeti.AffinoidTensor.lift`. -/
theorem existsUnique_algHom :
    ∃! χ : AffinoidTensor I J →ₐ[A] D, χ.comp (inl I J) = φ ∧ χ.comp (inr I J) = ψ :=
  ⟨lift I J hA hD φ ψ, ⟨lift_comp_inl I J hA hD φ ψ, lift_comp_inr I J hA hD φ ψ⟩,
    fun _ ⟨hl, hr⟩ ↦ algHom_ext I J hA hD (by rw [hl, lift_comp_inl])
      (by rw [hr, lift_comp_inr])⟩

end Affinoid

end AffinoidTensor

end TauCeti
