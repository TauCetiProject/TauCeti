import TauCeti.RingTheory.Huber.Normed
import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.Polynomial

/-!
# Small perturbations of affinoid generators

Let `φ : A → B` be a `K`-algebra map of affinoid algebras with complete ultrametric algebra norms.
Power-bounded elements `b₁, …, bₖ ∈ B` form a *system of affinoid generators of `B` over `A`* when
the extension `A⟨X₁, …, Xₖ⟩ → B` of `φ` sending `Xᵢ` to `bᵢ`
(`TauCeti.IsAffinoidAlgebra.restrictedLift`) is surjective. This file shows that such systems are
stable under small perturbations: there is `δ > 0` such that any power-bounded `y₁, …, yₖ` with
`‖yᵢ - bᵢ‖ < δ` again form a system of affinoid generators. Consequently, if `φ` has dense image,
then the image of `φ` contains a system of affinoid generators of `B` over `A`.

The proof compares the two extensions as continuous `K`-linear maps. Both agree with `φ` on
`A`, and on a polynomial `p` they are `p(b)` and `p(y)`. All monomials in the `bᵢ` and `yᵢ` lie in
one open bounded subring of `B`, and there the difference of two monomials lies in the ideal
generated by the `bᵢ - yᵢ`. Hence the operator norm of the difference is at most a constant times
`max ‖yᵢ - bᵢ‖`. A continuous linear map close enough in operator norm to a surjection between
Banach spaces is again surjective, by the open mapping theorem.

## Main results

* `TauCeti.IsAffinoidAlgebra.exists_pos_forall_surjective_restrictedLift`: a system of affinoid
  generators stays one under every perturbation of norm less than some `δ > 0`.
* `TauCeti.IsAffinoidAlgebra.exists_surjective_restrictedLift_of_denseRange`: if `φ` has dense
  image, some `φ f₁, …, φ fₖ` form a system of affinoid generators of `B` over `A`.

## References

* S. Bosch, *Lectures on Formal and Rigid Geometry*, Lecture Notes in Math. 2105, Springer,
  2014, §4.2, Remark 6 and Proposition 7.
-/

public section

namespace TauCeti.IsAffinoidAlgebra

open _root_.MvPowerSeries TauCeti.MvPowerSeries

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {A : Type*} [NormedCommRing A] [NormedAlgebra K A] [IsUltrametricDist A] [CompleteSpace A]
  (hA : IsAffinoidAlgebra K A) {B : Type*} [NormedCommRing B] [NormedAlgebra K B]
  [IsUltrametricDist B] [CompleteSpace B] (hB : IsAffinoidAlgebra K B) {k : ℕ}

/-- Two extensions of `φ : A → B` to `A⟨X₁, …, Xₖ⟩`, at families `b` and `y` lying in a subring of
`B` bounded in norm by `N` with `‖yᵢ - bᵢ‖ ≤ δ`, differ by at most `C * N * δ` times the Gauss
norm, where `C` bounds `φ`. On polynomials this is `norm_prod_pow_sub_prod_pow_le` applied to each
monomial; it extends by density. -/
private theorem norm_restrictedLift_sub_restrictedLift_le (φ : A →ₐ[K] B) {C : ℝ} (hC : 0 ≤ C)
    (hφ : ∀ a, ‖φ a‖ ≤ C * ‖a‖) {B₀ : Subring B} {N δ : ℝ} (hN0 : 0 ≤ N)
    (hN : ∀ x ∈ B₀, ‖x‖ ≤ N) (hδ : 0 ≤ δ) {b y : Fin k → B} (hb : ∀ i, Huber.IsPowerBounded (b i))
    (hy : ∀ i, Huber.IsPowerBounded (y i)) (hbB₀ : ∀ i, b i ∈ B₀) (hyB₀ : ∀ i, y i ∈ B₀)
    (hyb : ∀ i, ‖y i - b i‖ ≤ δ) (h : IsRestricted.subring (R := A) (fun _ : Fin k ↦ 1)) :
    ‖restrictedLift hA hB φ hy h - restrictedLift hA hB φ hb h‖ ≤ C * N * δ * ‖h‖ := by
  have := (hA.isRestricted_subring (τ := Fin k)).isNoetherianRing
  refine (denseRange_polynomialToRestricted (c := fun _ : Fin k ↦ (1 : ℝ))).induction_on h
    (isClosed_le ((hB.continuous_algHom _).sub (hB.continuous_algHom _)).norm (by fun_prop))
    fun p ↦ ?_
  rw [restrictedLift_polynomialToRestricted, restrictedLift_polynomialToRestricted,
    MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, ← Finset.sum_sub_distrib]
  simp_rw [← mul_sub]
  refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (by positivity) fun d _ ↦ ?_
  -- each coefficient is bounded by the Gauss norm
  have hcoeff : ‖p.coeff d‖ ≤ ‖polynomialToRestricted (fun _ ↦ 1) p‖ := by
    simpa [coe_polynomialToRestricted] using norm_coeff_le_norm (polynomialToRestricted _ p) d
  calc ‖φ (p.coeff d) * _‖ ≤ ‖φ (p.coeff d)‖ * ‖_‖ := norm_mul_le _ _
    _ ≤ C * ‖polynomialToRestricted (fun _ ↦ 1) p‖ * (N * δ) :=
        mul_le_mul ((hφ _).trans (mul_le_mul_of_nonneg_left hcoeff hC))
          (norm_prod_pow_sub_prod_pow_le hN0 hN hδ hyB₀ hbB₀ hyb d.support d) (norm_nonneg _)
          (by positivity)
    _ = _ := by ring

/-- **Affinoid generators survive small perturbations.** Let `φ : A → B` be a `K`-algebra map of
affinoid algebras with complete ultrametric algebra norms, and let power-bounded `b₁, …, bₖ ∈ B`
be affinoid generators of `B` over `A`: the extension `A⟨X₁, …, Xₖ⟩ → B` of `φ` sending `Xᵢ` to
`bᵢ` is surjective. Then for some `δ > 0`, every power-bounded family `y` with `‖yᵢ - bᵢ‖ < δ`
for all `i` is again a system of affinoid generators of `B` over `A`. -/
theorem exists_pos_forall_surjective_restrictedLift (φ : A →ₐ[K] B) {b : Fin k → B}
    (hb : ∀ i, Huber.IsPowerBounded (b i))
    (hsurj : Function.Surjective (restrictedLift hA hB φ hb)) :
    ∃ δ > 0, ∀ (y : Fin k → B) (hy : ∀ i, Huber.IsPowerBounded (y i)),
      (∀ i, ‖y i - b i‖ < δ) → Function.Surjective (restrictedLift hA hB φ hy) := by
  classical
  have := hA.isNoetherianRing
  have := (hA.isRestricted_subring (τ := Fin k)).isNoetherianRing
  -- algebra maps out of `A` and `A⟨X⟩` are continuous `K`-linear maps
  let L (ψ : IsRestricted.subring (R := A) (fun _ : Fin k ↦ 1) →ₐ[K] B) :
      IsRestricted.subring (R := A) (fun _ : Fin k ↦ 1) →L[K] B :=
    ⟨ψ.toLinearMap, hB.continuous_algHom ψ⟩
  let φL : A →L[K] B := ⟨φ.toLinearMap, hB.continuous_algHom φ⟩
  -- the open mapping theorem gives a right inverse of `restrictedLift` of bounded growth
  obtain ⟨R, hR⟩ := (L (restrictedLift hA hB φ hb)).exists_nonlinearRightInverse_of_surjective
    (LinearMap.range_eq_top.mpr hsurj)
  have hT : ∀ t ∈ Finset.univ.image b, Huber.IsPowerBounded t := by simpa using hb
  obtain ⟨B₀, r, N, hr, hN0, hT₀, hball, hN⟩ :=
    Huber.exists_subring_ball_subset_forall_norm_le K hT
  have hbB₀ (i : Fin k) : b i ∈ B₀ := hT₀ (by simp)
  have hφN : 0 ≤ ‖φL‖ * N := mul_nonneg (norm_nonneg _) hN0
  have hR0 : (0 : ℝ) < R.nnNorm := hR
  refine ⟨min r ((R.nnNorm : ℝ)⁻¹ / (‖φL‖ * N + 1)), lt_min hr (by positivity),
    fun y hy hyb ↦ ?_⟩
  set δ := min r ((R.nnNorm : ℝ)⁻¹ / (‖φL‖ * N + 1))
  have hyB₀ (i : Fin k) : y i ∈ B₀ := by
    simpa using B₀.add_mem (hbB₀ i)
      (hball (mem_ball_zero_iff.mpr ((hyb i).trans_le (min_le_left _ _))))
  -- the difference is smaller in operator norm than the reciprocal bound of the right inverse
  have hlt : ‖L (restrictedLift hA hB φ hy) - L (restrictedLift hA hB φ hb)‖ <
      (R.nnNorm : ℝ)⁻¹ := by
    refine ((L _ - L _).opNorm_le_bound (by positivity) fun h ↦
      norm_restrictedLift_sub_restrictedLift_le hA hB φ (norm_nonneg φL) φL.le_opNorm hN0 hN
        (by positivity) hb hy hbB₀ hyB₀ (fun i ↦ (hyb i).le) h).trans_lt ?_
    calc ‖φL‖ * N * δ ≤ ‖φL‖ * N * ((R.nnNorm : ℝ)⁻¹ / (‖φL‖ * N + 1)) :=
          mul_le_mul_of_nonneg_left (min_le_right _ _) hφN
      _ < (R.nnNorm : ℝ)⁻¹ := by
          rw [mul_div_assoc', div_lt_iff₀ (by positivity)]
          nlinarith [inv_pos.mpr hR0]
  exact (L (restrictedLift hA hB φ hb)).surjective_of_norm_sub_lt_inv_rightInverse
    (L (restrictedLift hA hB φ hy)) R hlt

/-- **A map with dense image contains affinoid generators.** Let `φ : A → B` be a `K`-algebra
map of affinoid algebras with complete ultrametric algebra norms whose image is dense. Then there
are `f₁, …, fₖ ∈ A` whose images are power-bounded and form a system of affinoid generators of `B`
over `A`: the extension `A⟨X₁, …, Xₖ⟩ → B` of `φ` sending `Xᵢ` to `φ fᵢ` is surjective. -/
theorem exists_surjective_restrictedLift_of_denseRange {φ : A →ₐ[K] B}
    (hφ : DenseRange φ) :
    ∃ (k : ℕ) (f : Fin k → A) (hf : ∀ i, Huber.IsPowerBounded (φ (f i))),
      Function.Surjective (restrictedLift hA hB φ hf) := by
  obtain ⟨k, β, hβ, hβφ⟩ := exists_surjective_algHom_isRestricted_subring hA hB φ
  have := (hA.isRestricted_subring (τ := Fin k)).isNoetherianRing
  -- the images `bᵢ` of the variables are power-bounded affinoid generators
  have hb (i : Fin k) : Huber.IsPowerBounded (β ⟨X i, isRestricted_X _ i⟩) :=
    hB.isPowerBounded_map β (isPowerBounded_X i)
  have hβlift : β = restrictedLift hA hB φ hb :=
    algHom_ext_isRestricted_subring hA hB (fun a ↦ by rw [hβφ, restrictedLift_algebraMap])
      fun i ↦ by rw [restrictedLift_X]
  obtain ⟨δ, hδ, hpert⟩ := exists_pos_forall_surjective_restrictedLift hA hB φ hb (hβlift ▸ hβ)
  -- approximate each `bᵢ` by some `φ fᵢ` to within `min δ 1`
  choose f hf using fun i ↦ hφ.exists_dist_lt (β ⟨X i, isRestricted_X _ i⟩) (lt_min hδ one_pos)
  have hf' (i : Fin k) : ‖φ (f i) - β ⟨X i, isRestricted_X _ i⟩‖ < min δ 1 := by
    rw [← dist_eq_norm, dist_comm]
    exact hf i
  have hfb (i : Fin k) : Huber.IsPowerBounded (φ (f i)) := by
    simpa using (hb i).add
      (Huber.IsPowerBounded.of_norm_le_one ((hf' i).le.trans (min_le_right _ _)))
  exact ⟨k, f, hfb, hpert _ hfb fun i ↦ (hf' i).trans_le (min_le_left _ _)⟩

end TauCeti.IsAffinoidAlgebra
