/-!
# Laurent fractions of affinoid algebras

Let `A` be a normed algebra and let `f = (f₁, …, f_r)` and `g = (g₁, …, g_s)` be families in `A`.
The Laurent fraction algebra is

`A⟨f, g⁻¹⟩ = A⟨X₁, …, X_r, Y₁, …, Y_s⟩ ⧸ (Xᵢ - fᵢ, gⱼ Yⱼ - 1)`,

the quotient of the Gauss-normed algebra of unit-radius restricted series by the ideal
`TauCeti.laurentFractionIdeal f g`. The variables are indexed by `Fin (r + s)`: `Xᵢ` is the variable
`Fin.castAdd s i` and `Yⱼ` is the variable `Fin.natAdd r j`. In `A⟨f, g⁻¹⟩` the class of `Xᵢ` is
`fᵢ`, every `gⱼ` is a unit, and the class of `Yⱼ` is its inverse. When `A` is affinoid,
`A⟨f, g⁻¹⟩` is the coordinate ring of the Laurent domain
`{x ∈ Sp A : |fᵢ(x)| ≤ 1, |gⱼ(x)| ≥ 1}`; this file develops the algebra.

When `A` is affinoid, so is `A⟨f, g⁻¹⟩`, and it has the universal property of the Laurent
localisation among completely normed affinoid algebras: `K`-algebra maps `A⟨f, g⁻¹⟩ → B`
correspond to `K`-algebra maps `φ : A → B` for which every `φ fᵢ` is power-bounded and every
`φ gⱼ` is a unit with power-bounded inverse. No continuity is assumed, since algebra maps between
affinoid algebras are automatically continuous. Unlike the rational fraction algebra
`TauCeti.RationalFraction`, no unit-ideal hypothesis is needed: the relations `gⱼ Yⱼ = 1` invert
the `gⱼ` outright.

The case `s = 0` presents the Weierstrass fraction `A⟨f⟩`, and the case `r = 0` the Laurent
fraction `A⟨g⁻¹⟩`.

## Main definitions

* `TauCeti.laurentFractionIdeal f g`: the ideal of `A⟨X₁, …, X_r, Y₁, …, Y_s⟩` generated by the
  `Xᵢ - fᵢ` and the `gⱼ Yⱼ - 1`.
* `TauCeti.LaurentFraction f g`: the Laurent fraction algebra `A⟨f, g⁻¹⟩`.
* `TauCeti.LaurentFraction.lift`: the `K`-algebra map `A⟨f, g⁻¹⟩ → B` extending `φ : A → B`
  and sending `gⱼ⁻¹` to `bⱼ`, where `φ gⱼ * bⱼ = 1`.

## Main results

* `TauCeti.LaurentFraction.isUnit_algebraMap`: each `gⱼ` is a unit of `A⟨f, g⁻¹⟩`.
* `TauCeti.LaurentFraction.isPowerBounded_algebraMap` and
  `TauCeti.LaurentFraction.isPowerBounded_inverse_algebraMap`: each `fᵢ` and each `gⱼ⁻¹` is
  power-bounded in `A⟨f, g⁻¹⟩`.
* `TauCeti.LaurentFraction.isAffinoidAlgebra`: `A⟨f, g⁻¹⟩` is affinoid when `A` is.
* `TauCeti.LaurentFraction.algHom_ext`: maps out of `A⟨f, g⁻¹⟩` are determined on `A`.
* `TauCeti.LaurentFraction.existsUnique_algHom`: the universal property.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §§6.1.4 and
  7.2.2.
-/

public section

namespace TauCeti

open _root_.MvPowerSeries TauCeti.MvPowerSeries TauCeti.Huber

variable {A : Type*} [NormedCommRing A] [IsUltrametricDist A] {r s : ℕ}

/-- The ideal of `A⟨X₁, …, X_r, Y₁, …, Y_s⟩` generated by the elements `Xᵢ - fᵢ` and
`gⱼ Yⱼ - 1`, whose quotient is the Laurent fraction algebra `A⟨f, g⁻¹⟩`. The variables are indexed
by `Fin (r + s)`, with `Xᵢ` the variable `Fin.castAdd s i` and `Yⱼ` the variable
`Fin.natAdd r j`. -/
noncomputable def laurentFractionIdeal (f : Fin r → A) (g : Fin s → A) :
    Ideal (IsRestricted.subring (R := A) (fun _ : Fin (r + s) ↦ 1)) :=
  Ideal.span (Set.range fun i ↦
      ⟨X (Fin.castAdd s i), isRestricted_X _ _⟩ - algebraMap A _ (f i)) ⊔
    Ideal.span (Set.range fun j ↦
      algebraMap A _ (g j) * ⟨X (Fin.natAdd r j), isRestricted_X _ _⟩ - 1)

/-- `laurentFractionIdeal f g` is generated by the `Xᵢ - fᵢ` together with the `gⱼ Yⱼ - 1`. -/
theorem laurentFractionIdeal_def (f : Fin r → A) (g : Fin s → A) :
    laurentFractionIdeal f g =
      Ideal.span (Set.range fun i ↦
          ⟨X (Fin.castAdd s i), isRestricted_X _ _⟩ - algebraMap A _ (f i)) ⊔
        Ideal.span (Set.range fun j ↦
          algebraMap A _ (g j) * ⟨X (Fin.natAdd r j), isRestricted_X _ _⟩ - 1) :=
  (rfl)

/-- **The Laurent fraction algebra** `A⟨f, g⁻¹⟩ = A⟨X₁, …, X_r, Y₁, …, Y_s⟩ ⧸ (Xᵢ - fᵢ, gⱼ Yⱼ - 1)`.
It carries the quotient ring, algebra and topology structures of `Ideal.Quotient`. -/
noncomputable abbrev LaurentFraction (f : Fin r → A) (g : Fin s → A) :=
  IsRestricted.subring (R := A) (fun _ : Fin (r + s) ↦ 1) ⧸ laurentFractionIdeal f g

namespace LaurentFraction

variable {f : Fin r → A} {g : Fin s → A}

/-- The class of the variable `Xᵢ` in `A⟨f, g⁻¹⟩` is `fᵢ`. -/
@[simp]
theorem mk_X_castAdd (i : Fin r) :
    Ideal.Quotient.mk (laurentFractionIdeal f g) ⟨X (Fin.castAdd s i), isRestricted_X _ _⟩ =
      algebraMap A _ (f i) := by
  rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq]
  exact Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩)

/-- **`gⱼ · Yⱼ = 1`** in the Laurent fraction algebra. -/
theorem algebraMap_mul_mk_X_natAdd (j : Fin s) :
    algebraMap A (LaurentFraction f g) (g j) *
      Ideal.Quotient.mk (laurentFractionIdeal f g) ⟨X (Fin.natAdd r j), isRestricted_X _ _⟩ =
        1 := by
  rw [← Ideal.Quotient.mk_algebraMap, ← map_mul, ← map_one (Ideal.Quotient.mk _),
    Ideal.Quotient.eq]
  exact Ideal.mem_sup_right (Ideal.subset_span ⟨j, rfl⟩)

/-- **Each `gⱼ` becomes a unit** in `A⟨f, g⁻¹⟩`. No hypothesis on `f` or `g` is needed. -/
theorem isUnit_algebraMap (j : Fin s) : IsUnit (algebraMap A (LaurentFraction f g) (g j)) :=
  IsUnit.of_mul_eq_one _ (algebraMap_mul_mk_X_natAdd j)

/-- The class of the variable `Yⱼ` in `A⟨f, g⁻¹⟩` is the inverse of `gⱼ`. -/
@[simp]
theorem mk_X_natAdd (j : Fin s) :
    Ideal.Quotient.mk (laurentFractionIdeal f g) ⟨X (Fin.natAdd r j), isRestricted_X _ _⟩ =
      Ring.inverse (algebraMap A (LaurentFraction f g) (g j)) := by
  have h := (Ring.inverse_mul_eq_iff_eq_mul _ 1 _ (isUnit_algebraMap (f := f) (g := g) j)).mpr
    (algebraMap_mul_mk_X_natAdd (f := f) j).symm
  rwa [mul_one, eq_comm] at h

/-- **`gⱼ · gⱼ⁻¹ = 1`** in the Laurent fraction algebra. -/
@[simp]
theorem algebraMap_mul_inverse_algebraMap (j : Fin s) :
    algebraMap A (LaurentFraction f g) (g j) * Ring.inverse (algebraMap A _ (g j)) = 1 :=
  Ring.mul_inverse_cancel _ (isUnit_algebraMap j)

/-- **`gⱼ⁻¹ · gⱼ = 1`** in the Laurent fraction algebra. -/
@[simp]
theorem inverse_algebraMap_mul_algebraMap (j : Fin s) :
    Ring.inverse (algebraMap A (LaurentFraction f g) (g j)) * algebraMap A _ (g j) = 1 :=
  Ring.inverse_mul_cancel _ (isUnit_algebraMap j)

/-- Each `fᵢ` is power-bounded for the quotient topology of `A⟨f, g⁻¹⟩`. -/
theorem isPowerBounded_algebraMap (i : Fin r) :
    IsPowerBounded (algebraMap A (LaurentFraction f g) (f i)) :=
  mk_X_castAdd (g := g) i ▸ (isPowerBounded_X (R := A) _).quotientMk _

/-- The inverse of each `gⱼ` is power-bounded for the quotient topology of `A⟨f, g⁻¹⟩`. -/
theorem isPowerBounded_inverse_algebraMap (j : Fin s) :
    IsPowerBounded (Ring.inverse (algebraMap A (LaurentFraction f g) (g j))) :=
  mk_X_natAdd (f := f) j ▸ (isPowerBounded_X (R := A) _).quotientMk _

section Affinoid

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [NormedAlgebra K A] [CompleteSpace A] (hA : IsAffinoidAlgebra K A)

include hA in
/-- **Laurent fractions of an affinoid algebra are affinoid**, being quotients of the affinoid
algebra `A⟨X₁, …, X_r, Y₁, …, Y_s⟩`. -/
theorem isAffinoidAlgebra (f : Fin r → A) (g : Fin s → A) :
    IsAffinoidAlgebra K (LaurentFraction f g) :=
  (hA.isRestricted_subring (τ := Fin (r + s))).quotient _

variable {B : Type*} [NormedCommRing B] [NormedAlgebra K B] [IsUltrametricDist B]
  [CompleteSpace B] (hB : IsAffinoidAlgebra K B)

/-- **The extension of `φ : A → B` to `A⟨f, g⁻¹⟩` sending `gⱼ⁻¹` to `bⱼ`**, for affinoid
algebras `A` and `B` with complete ultrametric algebra norms, power-bounded `φ f₁, …, φ f_r`, and
power-bounded `b₁, …, b_s ∈ B` satisfying `φ gⱼ * bⱼ = 1`. -/
noncomputable def lift (φ : A →ₐ[K] B) (hf : ∀ i, IsPowerBounded (φ (f i))) {b : Fin s → B}
    (hb : ∀ j, IsPowerBounded (b j)) (hφ : ∀ j, φ (g j) * b j = 1) :
    LaurentFraction f g →ₐ[K] B :=
  -- Descend restrictedLift, sending `Xᵢ ↦ φ fᵢ` and `Yⱼ ↦ bⱼ`, to the quotient.
  Ideal.Quotient.liftₐ _
    (hA.restrictedLift hB φ (b := Fin.append (φ ∘ f) b)
      (Fin.addCases (by simpa using hf) (by simpa using hb)))
    fun _ hx ↦ RingHom.mem_ker.mp <| (laurentFractionIdeal_def f g).trans_le
      (sup_le (Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; simp))
        (Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; simp [hφ]))) hx

variable (φ : A →ₐ[K] B) (hf : ∀ i, IsPowerBounded (φ (f i))) {b : Fin s → B}
  (hb : ∀ j, IsPowerBounded (b j)) (hφ : ∀ j, φ (g j) * b j = 1)

/-- `lift` extends `φ` on `A`. -/
@[simp]
theorem lift_algebraMap (a : A) :
    lift hA hB φ hf hb hφ (algebraMap A (LaurentFraction f g) a) = φ a := by
  rw [← Ideal.Quotient.mk_algebraMap]
  exact IsAffinoidAlgebra.restrictedLift_algebraMap hA hB φ _ a

/-- `lift` sends the inverse of each `gⱼ` to `bⱼ`. -/
@[simp]
theorem lift_inverse_algebraMap (j : Fin s) :
    lift hA hB φ hf hb hφ (Ring.inverse (algebraMap A (LaurentFraction f g) (g j))) = b j := by
  rw [← mk_X_natAdd (f := f)]
  exact (IsAffinoidAlgebra.restrictedLift_X hA hB φ _ _).trans (Fin.append_right _ _ j)

/-- `lift` is continuous for the quotient topology of `A⟨f, g⁻¹⟩`. -/
theorem continuous_lift : Continuous (lift hA hB φ hf hb hφ) :=
  have := (hA.isRestricted_subring (τ := Fin (r + s))).isNoetherianRing
  Ideal.Quotient.continuous_lift _ (hB.continuous_algHom (hA.restrictedLift hB φ _)) _

include hA hB in
/-- **`K`-algebra maps out of `A⟨f, g⁻¹⟩` are determined on `A`**: the image of each variable is
forced, being the image of `fᵢ` or the inverse of the image of `gⱼ`. No continuity is assumed. -/
theorem algHom_ext {ψ₁ ψ₂ : LaurentFraction f g →ₐ[K] B}
    (hC : ∀ a, ψ₁ (algebraMap A _ a) = ψ₂ (algebraMap A _ a)) : ψ₁ = ψ₂ := by
  refine Ideal.Quotient.algHom_ext K (IsAffinoidAlgebra.algHom_ext_isRestricted_subring hA hB
    (fun a ↦ by simpa [← Ideal.Quotient.mk_algebraMap] using hC a) fun k ↦ ?_)
  refine Fin.addCases (fun i ↦ ?_) (fun j ↦ ?_) k
  · simpa using hC (f i)
  · -- Both images of `Yⱼ` are inverses of the common image of `gⱼ`.
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, mk_X_natAdd]
    have hu := isUnit_algebraMap (f := f) (g := g) j
    rw [hu.map_ringInverse, hu.map_ringInverse, hC]

include hA hB in
/-- **The universal property of the Laurent fraction algebra.** Let `A` and `B` be affinoid
algebras with complete ultrametric algebra norms. A `K`-algebra map `φ : A → B` extends to a
`K`-algebra map `A⟨f, g⁻¹⟩ → B` if and only if every `φ fᵢ` is power-bounded and every `φ gⱼ`
is a unit with power-bounded inverse, and the extension is then unique. -/
theorem existsUnique_algHom (φ : A →ₐ[K] B) :
    (∃! ψ : LaurentFraction f g →ₐ[K] B, ∀ a, ψ (algebraMap A _ a) = φ a) ↔
      (∀ i, IsPowerBounded (φ (f i))) ∧
        ∀ j, IsUnit (φ (g j)) ∧ IsPowerBounded (Ring.inverse (φ (g j))) := by
  -- Images of the variables of `A⟨X, Y⟩` are power-bounded, by automatic continuity.
  have := (hA.isRestricted_subring (τ := Fin (r + s))).isNoetherianRing
  have hX (ψ : LaurentFraction f g →ₐ[K] B) (k : Fin (r + s)) :=
    hB.isPowerBounded_map (ψ.comp (Ideal.Quotient.mkₐ K _)) (isPowerBounded_X (R := A) k)
  refine ⟨fun ⟨ψ, hψ, _⟩ ↦ ⟨fun i ↦ ?_, fun j ↦ ?_⟩, fun ⟨hf, hg⟩ ↦ ?_⟩
  · simpa [hψ] using hX ψ (Fin.castAdd s i)
  · have hu : IsUnit (φ (g j)) := hψ (g j) ▸ (isUnit_algebraMap (f := f) (g := g) j).map ψ
    refine ⟨hu, ?_⟩
    rw [← hψ, ← (isUnit_algebraMap (f := f) (g := g) j).map_ringInverse]
    simpa using hX ψ (Fin.natAdd r j)
  · have hφ (j : Fin s) : φ (g j) * Ring.inverse (φ (g j)) = 1 :=
      Ring.mul_inverse_cancel _ (hg j).1
    exact ⟨lift hA hB φ hf (fun j ↦ (hg j).2) hφ, lift_algebraMap hA hB φ hf _ hφ,
      fun ψ hψ ↦ algHom_ext hA hB fun a ↦ by rw [hψ, lift_algebraMap]⟩

end Affinoid

end LaurentFraction

end TauCeti
