module

public import TauCeti.RingTheory.Affinoid.Restricted
public import Mathlib.RingTheory.TensorProduct.Maps

import TauCeti.Topology.Algebra.Ring.Ideal

/-!
# The affinoid pushout `A⟨X, Y⟩ ⧸ (I, J)`

Let `A` be an affinoid algebra over a complete nonarchimedean field `K`, carrying a complete
ultrametric algebra norm, and let `B = A⟨X₁, …, Xₘ⟩ ⧸ I` and `C = A⟨Y₁, …, Yₙ⟩ ⧸ J` be affinoid
`A`-algebras presented by restricted series. This file constructs the affinoid algebra

`A⟨X, Y⟩ ⧸ (I, J) = A⟨X₁, …, Xₘ, Y₁, …, Yₙ⟩ ⧸ (I, J)`,

where `I` and `J` are carried along the inclusions of the variables, as
`TauCeti.AffinoidPushout I J`, with its `A`-algebra maps from `B` and from `C`. It proves that
this is the pushout of `B` and `C` over `A` for maps into affinoid algebras: two `K`-algebra maps
`B → E` and `C → E` into a completely normed affinoid algebra `E` which agree on `A` factor
through exactly one `K`-algebra map `A⟨X, Y⟩ ⧸ (I, J) → E`, and that map is continuous for the
quotient topology. The algebraic tensor product `B ⊗[A] C` maps to `A⟨X, Y⟩ ⧸ (I, J)` with dense
image.

No continuity is assumed on the given maps. Algebra maps out of `A⟨X⟩` into a completely normed
affinoid algebra are automatically continuous, so the images of the variables are
power-bounded and the universal property of restricted series over `A`,
`TauCeti.IsAffinoidAlgebra.existsUnique_algHom_isRestricted_subring`, applies to them.

## Main definitions

* `TauCeti.pushoutIdeal I J`: the ideal `(I, J)` of `A⟨X₁, …, Xₘ, Y₁, …, Yₙ⟩`.
* `TauCeti.AffinoidPushout I J`: the quotient `A⟨X, Y⟩ ⧸ (I, J)`.
* `TauCeti.AffinoidPushout.inl`, `TauCeti.AffinoidPushout.inr`: the `A`-algebra maps from
  `A⟨X⟩ ⧸ I` and from `A⟨Y⟩ ⧸ J`.
* `TauCeti.AffinoidPushout.lift`: the `K`-algebra map induced by a compatible pair of maps.

## Main results

* `TauCeti.AffinoidPushout.isAffinoidAlgebra`: `A⟨X, Y⟩ ⧸ (I, J)` is affinoid.
* `TauCeti.AffinoidPushout.algHom_ext`: maps out of the pushout are determined by their
  compositions with `inl` and `inr`.
* `TauCeti.AffinoidPushout.existsUnique_algHom`: the universal property of the pushout.
* `TauCeti.AffinoidPushout.denseRange_productMap`: the image of `B ⊗[A] C` is dense.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §6.1.1.
-/

public section

namespace TauCeti

open _root_.MvPowerSeries TauCeti.MvPowerSeries

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {A : Type*} [NormedCommRing A] [NormedAlgebra K A] [IsUltrametricDist A] [CompleteSpace A]
  {m n : ℕ}

/-- The ideal `(I, J)` of `A⟨X₁, …, Xₘ, Y₁, …, Yₙ⟩` generated by an ideal `I` of `A⟨X₁, …, Xₘ⟩`
and an ideal `J` of `A⟨Y₁, …, Yₙ⟩`. The variable `Xᵢ` is the variable of index `i` and `Yⱼ` is
the variable of index `m + j`. -/
noncomputable def pushoutIdeal (I : Ideal (IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1)))
    (J : Ideal (IsRestricted.subring (R := A) (fun _ : Fin n ↦ 1))) :
    Ideal (IsRestricted.subring (R := A) (fun _ : Fin (m + n) ↦ 1)) :=
  I.map (restrictedRename (Fin.castAdd n)) ⊔ J.map (restrictedRename (Fin.natAdd m))

/-- `pushoutIdeal I J` is generated by the images of `I` and of `J`. -/
theorem pushoutIdeal_def (I : Ideal (IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1)))
    (J : Ideal (IsRestricted.subring (R := A) (fun _ : Fin n ↦ 1))) :
    pushoutIdeal I J =
      I.map (restrictedRename (Fin.castAdd n)) ⊔ J.map (restrictedRename (Fin.natAdd m)) :=
  (rfl)

/-- **The affinoid pushout** `A⟨X, Y⟩ ⧸ (I, J)` of `A⟨X₁, …, Xₘ⟩ ⧸ I` and `A⟨Y₁, …, Yₙ⟩ ⧸ J`
over `A`. It carries the quotient ring, `K`-algebra and `A`-algebra structures, and the quotient
topology. -/
abbrev AffinoidPushout (I : Ideal (IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1)))
    (J : Ideal (IsRestricted.subring (R := A) (fun _ : Fin n ↦ 1))) :=
  IsRestricted.subring (R := A) (fun _ : Fin (m + n) ↦ 1) ⧸ pushoutIdeal I J

namespace AffinoidPushout

variable (I : Ideal (IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1)))
  (J : Ideal (IsRestricted.subring (R := A) (fun _ : Fin n ↦ 1)))

/-- The `A`-algebra map `A⟨X⟩ ⧸ I → A⟨X, Y⟩ ⧸ (I, J)` induced by the inclusion of the variables
`X₁, …, Xₘ`. -/
noncomputable def inl :
    IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1) ⧸ I →ₐ[A] AffinoidPushout I J :=
  Ideal.quotientMapₐ _ (restrictedRename (Fin.castAdd n))
    (Ideal.map_le_iff_le_comap.mp le_sup_left)

/-- The `A`-algebra map `A⟨Y⟩ ⧸ J → A⟨X, Y⟩ ⧸ (I, J)` induced by the inclusion of the variables
`Y₁, …, Yₙ`. -/
noncomputable def inr :
    IsRestricted.subring (R := A) (fun _ : Fin n ↦ 1) ⧸ J →ₐ[A] AffinoidPushout I J :=
  Ideal.quotientMapₐ _ (restrictedRename (Fin.natAdd m))
    (Ideal.map_le_iff_le_comap.mp le_sup_right)

/-- `inl` is induced by the inclusion of the variables `X₁, …, Xₘ`. -/
@[simp]
theorem inl_mk (f : IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1)) :
    inl I J (Ideal.Quotient.mk I f) =
      Ideal.Quotient.mk (pushoutIdeal I J) (restrictedRename (Fin.castAdd n) f) := by
  simp [inl]

/-- `inr` is induced by the inclusion of the variables `Y₁, …, Yₙ`. -/
@[simp]
theorem inr_mk (f : IsRestricted.subring (R := A) (fun _ : Fin n ↦ 1)) :
    inr I J (Ideal.Quotient.mk J f) =
      Ideal.Quotient.mk (pushoutIdeal I J) (restrictedRename (Fin.natAdd m) f) := by
  simp [inr]

/-- **The affinoid pushout is affinoid.** -/
theorem isAffinoidAlgebra (hA : IsAffinoidAlgebra K A) :
    IsAffinoidAlgebra K (AffinoidPushout I J) :=
  (hA.isRestricted_subring (τ := Fin (m + n))).quotient _

variable {I J}

variable (hA : IsAffinoidAlgebra K A) {E : Type*} [NormedCommRing E] [NormedAlgebra K E]
  [IsUltrametricDist E] [CompleteSpace E] (hE : IsAffinoidAlgebra K E)
  (β : IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1) ⧸ I →ₐ[K] E)
  (γ : IsRestricted.subring (R := A) (fun _ : Fin n ↦ 1) ⧸ J →ₐ[K] E)

/-- The images in `E` of the variables `X₁, …, Xₘ, Y₁, …, Yₙ` under `β` and `γ`. -/
private noncomputable def liftVars : Fin (m + n) → E :=
  Fin.append (fun i ↦ β (Ideal.Quotient.mk I ⟨X i, isRestricted_X _ i⟩))
    (fun j ↦ γ (Ideal.Quotient.mk J ⟨X j, isRestricted_X _ j⟩))

include hA hE in
private theorem isPowerBounded_liftVars (k : Fin (m + n)) :
    Huber.IsPowerBounded (liftVars β γ k) := by
  have := (hA.isRestricted_subring (τ := Fin m)).isNoetherianRing
  have := (hA.isRestricted_subring (τ := Fin n)).isNoetherianRing
  refine Fin.addCases (fun i ↦ ?_) (fun j ↦ ?_) k
  · simpa [liftVars] using
      hE.isPowerBounded_map (β.comp (Ideal.Quotient.mkₐ K I)) (isPowerBounded_X i)
  · simpa [liftVars] using
      hE.isPowerBounded_map (γ.comp (Ideal.Quotient.mkₐ K J)) (isPowerBounded_X j)

/-- The `K`-algebra map `A⟨X, Y⟩ → E` extending `β` on `A` and sending the variables to the
images of the variables under `β` and `γ`. -/
private noncomputable def liftRestricted :
    IsRestricted.subring (R := A) (fun _ : Fin (m + n) ↦ 1) →ₐ[K] E :=
  IsAffinoidAlgebra.restrictedLift hA hE (β.comp (IsScalarTower.toAlgHom K A _))
    (isPowerBounded_liftVars hA hE β γ)

include hE in
private theorem liftRestricted_comp_inl :
    (liftRestricted hA hE β γ).comp ((restrictedRename (Fin.castAdd n)).restrictScalars K) =
      β.comp (Ideal.Quotient.mkₐ K I) := by
  refine IsAffinoidAlgebra.algHom_ext_isRestricted_subring hA hE (fun a ↦ ?_) (fun i ↦ ?_)
  · simp [liftRestricted, Ideal.Quotient.mk_algebraMap]
  · simp [liftRestricted, liftVars]

variable {β γ}

include hE in
private theorem liftRestricted_comp_inr
    (h : ∀ a, β (algebraMap A _ a) = γ (algebraMap A _ a)) :
    (liftRestricted hA hE β γ).comp ((restrictedRename (Fin.natAdd m)).restrictScalars K) =
      γ.comp (Ideal.Quotient.mkₐ K J) := by
  refine IsAffinoidAlgebra.algHom_ext_isRestricted_subring hA hE (fun a ↦ ?_) (fun j ↦ ?_)
  · simp [liftRestricted, Ideal.Quotient.mk_algebraMap, h]
  · simp [liftRestricted, liftVars]

include hE in
private theorem pushoutIdeal_le_ker_liftRestricted
    (h : ∀ a, β (algebraMap A _ a) = γ (algebraMap A _ a)) :
    pushoutIdeal I J ≤ RingHom.ker (liftRestricted hA hE β γ) := by
  refine sup_le (Ideal.map_le_iff_le_comap.mpr fun f hf ↦ ?_)
    (Ideal.map_le_iff_le_comap.mpr fun f hf ↦ ?_)
  · rw [Ideal.mem_comap, RingHom.mem_ker]
    simpa [Ideal.Quotient.eq_zero_iff_mem.mpr hf] using
      congr($(liftRestricted_comp_inl hA hE β γ) f)
  · rw [Ideal.mem_comap, RingHom.mem_ker]
    simpa [Ideal.Quotient.eq_zero_iff_mem.mpr hf] using
      congr($(liftRestricted_comp_inr hA hE h) f)

variable (β γ)

/-- **The map out of the affinoid pushout** `A⟨X, Y⟩ ⧸ (I, J) → E` induced by `K`-algebra maps
`β : A⟨X⟩ ⧸ I → E` and `γ : A⟨Y⟩ ⧸ J → E` into a completely normed affinoid algebra which agree
on `A`. It is the unique such map with `lift ∘ inl = β` and `lift ∘ inr = γ`. -/
noncomputable def lift (h : ∀ a, β (algebraMap A _ a) = γ (algebraMap A _ a)) :
    AffinoidPushout I J →ₐ[K] E :=
  Ideal.Quotient.liftₐ _ (liftRestricted hA hE β γ) fun _ hx ↦
    pushoutIdeal_le_ker_liftRestricted hA hE h hx

variable (h : ∀ a, β (algebraMap A _ a) = γ (algebraMap A _ a))

private theorem lift_mk (f : IsRestricted.subring (R := A) (fun _ : Fin (m + n) ↦ 1)) :
    lift hA hE β γ h (Ideal.Quotient.mk _ f) = liftRestricted hA hE β γ f :=
  Ideal.Quotient.lift_mk _ _ _

/-- `lift` restricts to `β` along `inl`. -/
@[simp]
theorem lift_inl (x : IsRestricted.subring (R := A) (fun _ : Fin m ↦ 1) ⧸ I) :
    lift hA hE β γ h (inl I J x) = β x := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  simpa [lift_mk] using congr($(liftRestricted_comp_inl hA hE β γ) f)

/-- `lift` restricts to `γ` along `inr`. -/
@[simp]
theorem lift_inr (y : IsRestricted.subring (R := A) (fun _ : Fin n ↦ 1) ⧸ J) :
    lift hA hE β γ h (inr I J y) = γ y := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
  simpa [lift_mk] using congr($(liftRestricted_comp_inr hA hE h) f)

/-- `lift` is continuous for the quotient topology on `A⟨X, Y⟩ ⧸ (I, J)`. -/
theorem continuous_lift : Continuous (lift hA hE β γ h) := by
  have := (hA.isRestricted_subring (τ := Fin (m + n))).isNoetherianRing
  -- the underlying function of `lift`, an `Ideal.Quotient.liftₐ`, is that of the
  -- `Ideal.Quotient.lift` of the automatically continuous `liftRestricted`
  exact Ideal.Quotient.continuous_lift _
    (hE.continuous_algHom (liftRestricted hA hE β γ))
    fun _ hx ↦ pushoutIdeal_le_ker_liftRestricted hA hE h hx

include hA hE in
/-- **`K`-algebra maps out of the affinoid pushout are determined by `inl` and `inr`.** Two
`K`-algebra maps `A⟨X, Y⟩ ⧸ (I, J) → E` into a completely normed affinoid algebra which agree on
the images of `A⟨X⟩ ⧸ I` and of `A⟨Y⟩ ⧸ J` are equal. No continuity is assumed. -/
theorem algHom_ext {δ₁ δ₂ : AffinoidPushout I J →ₐ[K] E}
    (hl : ∀ x, δ₁ (inl I J x) = δ₂ (inl I J x)) (hr : ∀ y, δ₁ (inr I J y) = δ₂ (inr I J y)) :
    δ₁ = δ₂ := by
  refine Ideal.Quotient.algHom_ext K
    (IsAffinoidAlgebra.algHom_ext_isRestricted_subring hA hE (fun a ↦ ?_) (fun k ↦ ?_))
  · simpa using hl (algebraMap A _ a)
  · refine Fin.addCases (fun i ↦ ?_) (fun j ↦ ?_) k
    · simpa using hl (Ideal.Quotient.mk I ⟨X i, isRestricted_X _ i⟩)
    · simpa using hr (Ideal.Quotient.mk J ⟨X j, isRestricted_X _ j⟩)

include hA hE h in
/-- **The universal property of the affinoid pushout.** Let `A` and `E` be affinoid algebras
with complete ultrametric algebra norms. Two `K`-algebra maps `β : A⟨X⟩ ⧸ I → E` and
`γ : A⟨Y⟩ ⧸ J → E` which agree on `A` factor through exactly one `K`-algebra map
`A⟨X, Y⟩ ⧸ (I, J) → E`, namely `TauCeti.AffinoidPushout.lift`. -/
theorem existsUnique_algHom :
    ∃! δ : AffinoidPushout I J →ₐ[K] E, (∀ x, δ (inl I J x) = β x) ∧ ∀ y, δ (inr I J y) = γ y :=
  ⟨lift hA hE β γ h, ⟨lift_inl hA hE β γ h, lift_inr hA hE β γ h⟩, fun _ ⟨hl, hr⟩ ↦
    algHom_ext hA hE (fun x ↦ by rw [hl, lift_inl]) (fun y ↦ by rw [hr, lift_inr])⟩

variable (I J) in
/-- **The algebraic tensor product is dense in the affinoid pushout.** The `A`-algebra map
`(A⟨X⟩ ⧸ I) ⊗[A] (A⟨Y⟩ ⧸ J) → A⟨X, Y⟩ ⧸ (I, J)` induced by `inl` and `inr` has dense image for
the quotient topology. -/
theorem denseRange_productMap :
    DenseRange (Algebra.TensorProduct.productMap (inl I J) (inr I J)) := by
  let S := (Algebra.TensorProduct.productMap (inl I J) (inr I J)).range
  -- the preimage of `S` in `A⟨X, Y⟩` is a subalgebra containing every variable
  let T := S.comap (Ideal.Quotient.mkₐ A (pushoutIdeal I J))
  have hX (k : Fin (m + n)) : (⟨X k, isRestricted_X _ k⟩ : IsRestricted.subring _) ∈ T := by
    refine Fin.addCases (fun i ↦ ⟨Ideal.Quotient.mk I ⟨X i, isRestricted_X _ i⟩ ⊗ₜ 1, ?_⟩)
      (fun j ↦ ⟨1 ⊗ₜ Ideal.Quotient.mk J ⟨X j, isRestricted_X _ j⟩, ?_⟩) k <;> simp
  -- hence it contains every monomial, and these span a dense subgroup
  have hmono : AddSubgroup.closure ((fun x : (Fin (m + n) →₀ ℕ) × A ↦
      (⟨monomial x.1 x.2, isRestricted_monomial _ x.1 x.2⟩ : IsRestricted.subring _)) ''
        (Set.univ ×ˢ Set.univ)) ≤ T.toSubring.toAddSubgroup := by
    refine AddSubgroup.closure_le _ |>.mpr ?_
    rintro _ ⟨⟨t, a⟩, -, rfl⟩
    dsimp only
    rw [SetLike.mem_coe, Subring.mem_toAddSubgroup, Subalgebra.mem_toSubring,
      mk_monomial_eq_algebraMap_mul_prod]
    exact T.mul_mem (T.algebraMap_mem a) (prod_mem fun k _ ↦ pow_mem (hX k) _)
  refine (((Ideal.Quotient.mk_surjective (I := pushoutIdeal I J)).denseRange.dense_image
    continuous_quot_mk (dense_closure_monomial dense_univ)).mono ?_)
  rintro _ ⟨f, hf, rfl⟩
  exact hmono hf

end AffinoidPushout

end TauCeti
