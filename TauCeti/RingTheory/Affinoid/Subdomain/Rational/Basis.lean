public import TauCeti.RingTheory.Affinoid.Subdomain.Cover

/-!
# The family of rational domains of a classical affinoid spectrum

Let `A` be an affinoid algebra over a complete nonarchimedean field `K`. A set `U ⊆ Sp A` of
classical points is a *rational domain* (`TauCeti.IsRationalDomain`) if it is of the form

`R(f/g) = {x ∈ Sp A : |g(x)| ≠ 0, |fᵢ(x)| ≤ |g(x)| for all i}`

for elements `g, f₁, …, fₘ` generating the unit ideal of `A`. Following [BGR, §7.2.3], this file
shows that `Sp A` and `∅` are rational domains, and that rational domains are stable under finite
intersections and under inverse images along algebra maps of affinoid algebras.

The intersection is explicit. Put `ĝ = (g, f₁, …, fₘ)` and `ĝ' = (g', f'₁, …, f'ₙ)`. Then

`R(f/g) ∩ R(f'/g') = R(F/(g g'))`, with `F = (ĝᵢ ĝ'ⱼ)ᵢⱼ`,

where the numerators `F` are all products of an entry of `ĝ` with an entry of `ĝ'`
(`TauCeti.rationalInterNumerator`). They include the denominator `g g'` itself, which does not
change the domain. This is the classical form of the identity for adic rational subsets,
`TauCeti.ValuationSpectrum.rationalSubset_inter`. The ideal generated by `F` is the product of the
ideals generated by `ĝ` and `ĝ'`, so `F` again generates the unit ideal, and the rational fraction
algebra `A⟨F/(g g')⟩` represents the intersection as an affinoid subdomain. Such algebras are the
intersection algebras in the Čech complex of a rational cover.

The inverse image of `R(f/g)` along `φ : A → B` is the rational domain `R(φ f/φ g)` of `B`, since
absolute values at classical points are unchanged by pulling points back.

## Main definitions

* `TauCeti.rationalInterNumerator g f g' f'`: the numerators `ĝᵢ ĝ'ⱼ` of `R(f/g) ∩ R(f'/g')`.
* `TauCeti.IsRationalDomain K U`: `U` is a rational domain of `Sp A`.

## Main results

* `TauCeti.IsAffinoidAlgebra.rationalDomain_inter_rationalDomain`:
  `R(f/g) ∩ R(f'/g') = R(F/(g g'))`.
* `TauCeti.IsAffinoidAlgebra.preimage_maximalSpectrumComap_rationalDomain`: the inverse image of
  `R(f/g)` along `φ` is `R(φ f/φ g)`.
* `TauCeti.RationalFraction.isAffinoidSubdomainMap_inter`: `A → A⟨F/(g g')⟩` represents
  `R(f/g) ∩ R(f'/g')`.
* `TauCeti.IsRationalDomain.univ`, `TauCeti.IsRationalDomain.empty`,
  `TauCeti.IsRationalDomain.inter`, `TauCeti.IsRationalDomain.iInter`,
  `TauCeti.IsRationalDomain.preimage`: `Sp A` and `∅` are rational domains, and rational domains
  are stable under finite intersections and inverse images.
* `TauCeti.IsRationalDomain.exists_isAffinoidSubdomainMap`: every rational domain is an affinoid
  subdomain, represented by a rational fraction algebra.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §7.2.3.
* [T. Wedhorn, *Adic Spaces*][wedhorn_adic], Remark 7.30(5), for the adic analogue.
-/

public section

namespace TauCeti

open scoped Pointwise

variable {K : Type*} [NontriviallyNormedField K]

section Numerators

variable {A : Type*} [CommRing A] {m n : ℕ}

/-- The numerators of the intersection `R(f/g) ∩ R(f'/g')` of two rational domains: with
`ĝ = (g, f₁, …, fₘ)` and `ĝ' = (g', f'₁, …, f'ₙ)`, the family of all products `ĝᵢ ĝ'ⱼ`, indexed
through `finProdFinEquiv`. The intersection is the rational domain with these numerators and the
denominator `g g'` (`TauCeti.IsAffinoidAlgebra.rationalDomain_inter_rationalDomain`). -/
def rationalInterNumerator (g : A) (f : Fin m → A) (g' : A) (f' : Fin n → A) :
    Fin ((m + 1) * (n + 1)) → A :=
  fun k ↦ (Fin.cons g f : Fin (m + 1) → A) (finProdFinEquiv.symm k).1 *
    (Fin.cons g' f' : Fin (n + 1) → A) (finProdFinEquiv.symm k).2

@[simp]
theorem rationalInterNumerator_finProdFinEquiv (g : A) (f : Fin m → A) (g' : A)
    (f' : Fin n → A) (i : Fin (m + 1)) (j : Fin (n + 1)) :
    rationalInterNumerator g f g' f' (finProdFinEquiv (i, j)) =
      (Fin.cons g f : Fin (m + 1) → A) i * (Fin.cons g' f' : Fin (n + 1) → A) j := by
  simp [rationalInterNumerator]

/-- The numerators of `R(f/g) ∩ R(f'/g')` are the pointwise products of the entries of
`(g, f₁, …, fₘ)` and of `(g', f'₁, …, f'ₙ)`. -/
theorem range_rationalInterNumerator (g : A) (f : Fin m → A) (g' : A) (f' : Fin n → A) :
    Set.range (rationalInterNumerator g f g' f') =
      insert g (Set.range f) * insert g' (Set.range f') := by
  rw [← Fin.range_cons, ← Fin.range_cons, ← Set.image2_mul, Set.image2_range]
  exact finProdFinEquiv.symm.surjective.range_comp fun p ↦
    (Fin.cons g f : Fin (m + 1) → A) p.1 * (Fin.cons g' f' : Fin (n + 1) → A) p.2

/-- If `g, f₁, …, fₘ` and `g', f'₁, …, f'ₙ` generate the unit ideal, so do `g g'` and the
numerators `ĝᵢ ĝ'ⱼ` of `R(f/g) ∩ R(f'/g')`. -/
theorem span_insert_rationalInterNumerator_eq_top {g : A} {f : Fin m → A} {g' : A}
    {f' : Fin n → A} (h : Ideal.span (insert g (Set.range f)) = ⊤)
    (h' : Ideal.span (insert g' (Set.range f')) = ⊤) :
    Ideal.span (insert (g * g') (Set.range (rationalInterNumerator g f g' f'))) = ⊤ := by
  have hmem : g * g' ∈ Set.range (rationalInterNumerator g f g' f') :=
    ⟨finProdFinEquiv (0, 0), by simp⟩
  rw [Set.insert_eq_of_mem hmem, range_rationalInterNumerator, ← Ideal.span_mul_span, h, h',
    Ideal.top_mul]

end Numerators

variable (K) in
/-- **Rational domains.** A set `U` of classical points of `A` is a rational domain if
`U = R(f/g)` for elements `g, f₁, …, fₘ` of `A` generating the unit ideal. For an affinoid
algebra, rational domains are affinoid subdomains
(`TauCeti.IsRationalDomain.exists_isAffinoidSubdomainMap`), and they are stable under finite
intersections and inverse images. -/
def IsRationalDomain {A : Type*} [CommRing A] [Algebra K A] (U : Set (MaximalSpectrum A)) :
    Prop :=
  ∃ (m : ℕ) (g : A) (f : Fin m → A),
    Ideal.span (insert g (Set.range f)) = ⊤ ∧ U = rationalDomain K g f

/-- `U` is a rational domain iff `U = R(f/g)` for some `g, f₁, …, fₘ` generating the unit
ideal. -/
theorem isRationalDomain_iff {A : Type*} [CommRing A] [Algebra K A]
    {U : Set (MaximalSpectrum A)} :
    IsRationalDomain K U ↔ ∃ (m : ℕ) (g : A) (f : Fin m → A),
      Ideal.span (insert g (Set.range f)) = ⊤ ∧ U = rationalDomain K g f :=
  Iff.rfl

/-- `R(f/g)` is a rational domain when `g, f₁, …, fₘ` generate the unit ideal. -/
theorem isRationalDomain_rationalDomain {A : Type*} [CommRing A] [Algebra K A] {m : ℕ} {g : A}
    {f : Fin m → A} (h : Ideal.span (insert g (Set.range f)) = ⊤) :
    IsRationalDomain K (rationalDomain K g f) :=
  ⟨m, g, f, h, rfl⟩

namespace IsRationalDomain

variable {A : Type*} [CommRing A] [Algebra K A] {U V : Set (MaximalSpectrum A)}

/-- The whole classical spectrum is the rational domain `R(∅/1)`. -/
theorem univ : IsRationalDomain K (Set.univ : Set (MaximalSpectrum A)) := by
  refine ⟨0, 1, Fin.elim0, ?_, ?_⟩
  · exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert _ _)) isUnit_one
  · ext x
    simp

/-- The empty set is a rational domain: `R(c/1) = ∅` for a scalar `c` with `1 < ‖c‖`. -/
theorem empty : IsRationalDomain K (∅ : Set (MaximalSpectrum A)) := by
  obtain ⟨c, hc⟩ := NormedField.exists_one_lt_norm K
  refine ⟨1, 1, fun _ ↦ algebraMap K A c, ?_, (rationalDomain_one_algebraMap_eq_empty hc).symm⟩
  exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert _ _)) isUnit_one

end IsRationalDomain

variable [IsUltrametricDist K] [CompleteSpace K]

namespace IsAffinoidAlgebra

variable {A : Type*} [CommRing A] [Algebra K A] {m n : ℕ}

/-- **Intersections of rational domains.** For an affinoid algebra `A`,
`R(f/g) ∩ R(f'/g') = R(F/(g g'))`, where `F` consists of the products `ĝᵢ ĝ'ⱼ` of the entries
of `ĝ = (g, f₁, …, fₘ)` and `ĝ' = (g', f'₁, …, f'ₙ)`. -/
theorem rationalDomain_inter_rationalDomain (hA : IsAffinoidAlgebra K A) (g : A)
    (f : Fin m → A) (g' : A) (f' : Fin n → A) :
    rationalDomain K g f ∩ rationalDomain K g' f' =
      rationalDomain K (g * g') (rationalInterNumerator g f g' f') := by
  ext x
  simp only [Set.mem_inter_iff, mem_rationalDomain, hA.pointNorm_mul, ne_eq, mul_eq_zero, not_or]
  constructor
  · rintro ⟨⟨hg, hf⟩, hg', hf'⟩
    refine ⟨⟨hg, hg'⟩, fun k ↦ ?_⟩
    obtain ⟨⟨i, j⟩, rfl⟩ := finProdFinEquiv.surjective k
    rw [rationalInterNumerator_finProdFinEquiv, hA.pointNorm_mul]
    -- Every entry of `ĝ` is bounded by `|g(x)|`, and every entry of `ĝ'` by `|g'(x)|`.
    exact mul_le_mul (Fin.cases le_rfl hf i) (Fin.cases le_rfl hf' j) (pointNorm_nonneg _)
      (pointNorm_nonneg _)
  · rintro ⟨⟨hg, hg'⟩, h⟩
    have hg₀ := lt_of_le_of_ne (pointNorm_nonneg g) (Ne.symm hg)
    have hg'₀ := lt_of_le_of_ne (pointNorm_nonneg g') (Ne.symm hg')
    refine ⟨⟨hg, fun i ↦ ?_⟩, hg', fun j ↦ ?_⟩
    · -- The numerator `fᵢ g'` gives `|fᵢ(x)| |g'(x)| ≤ |g(x)| |g'(x)|`.
      have hi := h (finProdFinEquiv (i.succ, 0))
      rw [rationalInterNumerator_finProdFinEquiv, hA.pointNorm_mul] at hi
      exact le_of_mul_le_mul_right (by simpa using hi) hg'₀
    · -- The numerator `g f'ⱼ` gives `|g(x)| |f'ⱼ(x)| ≤ |g(x)| |g'(x)|`.
      have hj := h (finProdFinEquiv (0, j.succ))
      rw [rationalInterNumerator_finProdFinEquiv, hA.pointNorm_mul] at hj
      exact le_of_mul_le_mul_left (by simpa using hj) hg₀

variable {B : Type*} [CommRing B] [Algebra K B]

/-- **Inverse images of rational domains.** For a `K`-algebra map `φ : A → B` into an affinoid
algebra, the inverse image of `R(f/g) ⊆ Sp A` under `Sp B → Sp A` is the rational domain
`R(φ f/φ g)` of `B`. -/
@[simp]
theorem preimage_maximalSpectrumComap_rationalDomain (hB : IsAffinoidAlgebra K B)
    (φ : A →ₐ[K] B) (g : A) (f : Fin m → A) :
    hB.maximalSpectrumComap φ ⁻¹' rationalDomain K g f = rationalDomain K (φ g) (φ ∘ f) := by
  ext x
  simp

end IsAffinoidAlgebra

namespace RationalFraction

variable {A : Type*} [NormedCommRing A] [IsUltrametricDist A] [NormedAlgebra K A]
  [CompleteSpace A] {m n : ℕ} {g : A} {f : Fin m → A} {g' : A} {f' : Fin n → A}

/-- **The intersection algebra of two rational domains.** If `g, f₁, …, fₘ` and
`g', f'₁, …, f'ₙ` generate the unit ideal of the affinoid algebra `A`, the rational fraction
algebra `A⟨F/(g g')⟩` with the numerators `F = (ĝᵢ ĝ'ⱼ)` of
`TauCeti.rationalInterNumerator` represents `R(f/g) ∩ R(f'/g')` as an affinoid subdomain. -/
theorem isAffinoidSubdomainMap_inter (hA : IsAffinoidAlgebra K A)
    (h : Ideal.span (insert g (Set.range f)) = ⊤)
    (h' : Ideal.span (insert g' (Set.range f')) = ⊤) :
    IsAffinoidSubdomainMap
      (IsScalarTower.toAlgHom K A (RationalFraction (g * g') (rationalInterNumerator g f g' f')))
      (rationalDomain K g f ∩ rationalDomain K g' f') := by
  rw [hA.rationalDomain_inter_rationalDomain]
  exact isAffinoidSubdomainMap hA (span_insert_rationalInterNumerator_eq_top h h')

end RationalFraction

namespace IsRationalDomain

variable {A : Type*} [CommRing A] [Algebra K A] {U V : Set (MaximalSpectrum A)}

/-- The intersection of two rational domains of an affinoid algebra is a rational domain. -/
theorem inter (hA : IsAffinoidAlgebra K A) (hU : IsRationalDomain K U)
    (hV : IsRationalDomain K V) : IsRationalDomain K (U ∩ V) := by
  obtain ⟨m, g, f, h, rfl⟩ := hU
  obtain ⟨n, g', f', h', rfl⟩ := hV
  rw [hA.rationalDomain_inter_rationalDomain]
  exact isRationalDomain_rationalDomain (span_insert_rationalInterNumerator_eq_top h h')

/-- A finite intersection of rational domains of an affinoid algebra is a rational domain. The
empty intersection is the whole spectrum. -/
theorem iInter (hA : IsAffinoidAlgebra K A) {ι : Type*} [Finite ι]
    {U : ι → Set (MaximalSpectrum A)} (hU : ∀ i, IsRationalDomain K (U i)) :
    IsRationalDomain K (⋂ i, U i) := by
  classical
  have := Fintype.ofFinite ι
  suffices ∀ s : Finset ι, IsRationalDomain K (⋂ i ∈ s, U i) by
    simpa using this Finset.univ
  intro s
  induction s using Finset.induction_on with
  | empty => simpa using univ
  | insert i s _ ih => simpa [Finset.set_biInter_insert] using (hU i).inter hA ih

/-- The inverse image of a rational domain of `A` along a `K`-algebra map `φ : A → B` into an
affinoid algebra is a rational domain of `B`: the inverse image of `R(f/g)` is `R(φ f/φ g)`. -/
theorem preimage {B : Type*} [CommRing B] [Algebra K B] (hB : IsAffinoidAlgebra K B)
    (φ : A →ₐ[K] B) (hU : IsRationalDomain K U) :
    IsRationalDomain K (hB.maximalSpectrumComap φ ⁻¹' U) := by
  obtain ⟨m, g, f, h, rfl⟩ := hU
  rw [hB.preimage_maximalSpectrumComap_rationalDomain]
  refine isRationalDomain_rationalDomain ?_
  rw [Set.range_comp, ← Set.image_insert_eq, ← Ideal.map_span, h, Ideal.map_top]

/-- **Rational domains are affinoid subdomains.** Every rational domain `U` of an affinoid
algebra `A` with a complete ultrametric algebra norm is represented as an affinoid subdomain by
the structure map `A → A⟨f/g⟩` of a rational fraction algebra with `U = R(f/g)`. -/
theorem exists_isAffinoidSubdomainMap {A : Type*} [NormedCommRing A] [IsUltrametricDist A]
    [NormedAlgebra K A] [CompleteSpace A] (hA : IsAffinoidAlgebra K A)
    {U : Set (MaximalSpectrum A)} (hU : IsRationalDomain K U) :
    ∃ (m : ℕ) (g : A) (f : Fin m → A),
      IsAffinoidSubdomainMap (IsScalarTower.toAlgHom K A (RationalFraction g f)) U := by
  obtain ⟨m, g, f, h, rfl⟩ := hU
  exact ⟨m, g, f, RationalFraction.isAffinoidSubdomainMap hA h⟩

end IsRationalDomain

end TauCeti
