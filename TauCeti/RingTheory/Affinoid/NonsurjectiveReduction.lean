/-!
# A surjection of Tate algebras which is not surjective on reductions

Let `K` be a complete nonarchimedean field and `ϖ ∈ K` with `0 < |ϖ| < 1`. Substituting
`T ↦ U²` and `S ↦ ϖ U` gives a surjective `K`-algebra map

`φ : K⟨T, S⟩ → K⟨U⟩`

with kernel `(S² - ϖ² T)`. It is surjective because every restricted series in `U` is
`g₀(U²) + U g₁(U²)`, and `U = φ(ϖ⁻¹ S)`. Its kernel is no larger than `(S² - ϖ² T)` because
`S / ϖ` is power-bounded in `K⟨T, S⟩ ⧸ (S² - ϖ² T)`, its square being `T`, so `U ↦ S / ϖ` defines
an inverse. Thus `φ` identifies the affinoid algebra `K⟨T, S⟩ ⧸ (S² - ϖ² T)` with `K⟨U⟩`, and this
presentation exhibits two phenomena of the reduction theory of affinoid algebras.

First, a surjective homomorphism of affinoid algebras need not induce a surjection on canonical
reductions `A° / A°°`. The coefficient of `U` in `φ f` is `ϖ` times the coefficient of `S` in
`f`, so no reduction of a power-bounded `f` is the class of `U`. (On reductions `φ` sends `T` to
`U²` and `S` to `0`.)

Second, the presentation ring `B = φ(K⟨T, S⟩°)`, the image of the Gauss unit ball, is an open
bounded subring of `K⟨U⟩` which is strictly smaller than the power-bounded subring: the variable
`U = S / ϖ` is power-bounded but does not lie in `B`. Correspondingly `B ⧸ ϖ B` is not reduced,
since the class of `S = ϖ U` is a nonzero element whose square is `ϖ (ϖ U²) ∈ ϖ B`. This shows
that the reducedness hypothesis of
`TauCeti.IsAffinoidAlgebra.mem_iff_supSeminorm_le_one_of_isReduced_quotient` cannot be dropped,
while `U` is still integral over `B`, as
`AlgHom.isIntegral_map_unitClosedBall_iff_supSeminorm_le_one` requires.

## Main definitions

* `TauCeti.MvPowerSeries.restrictedSquareSubst ϖ`: the map `K⟨T, S⟩ → K⟨U⟩`, `T ↦ U²`,
  `S ↦ ϖ U`.

## Main results

* `TauCeti.MvPowerSeries.restrictedSquareSubst_surjective`: the map is surjective for `ϖ ≠ 0`.
* `TauCeti.MvPowerSeries.ker_restrictedSquareSubst`: its kernel is generated by `S² - ϖ² T`.
* `TauCeti.MvPowerSeries.not_surjective_reductionMap_restrictedSquareSubst`: for `|ϖ| < 1` it is
  not surjective on canonical reductions.
* `TauCeti.MvPowerSeries.X_notMem_map_restrictedSquareSubst_unitClosedBall`: the power-bounded
  variable `U` does not lie in the presentation ring `B`.
* `TauCeti.MvPowerSeries.isOpen_map_restrictedSquareSubst_unitClosedBall` and
  `TauCeti.MvPowerSeries.isBounded_map_restrictedSquareSubst_unitClosedBall`: `B` is an open
  bounded subring.
* `TauCeti.MvPowerSeries.not_isReduced_map_restrictedSquareSubst_unitClosedBall_quotient`:
  `B ⧸ ϖ B` is not reduced.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §§6.3.1 and
  6.3.4.
-/

public section

namespace TauCeti.MvPowerSeries

open _root_.MvPowerSeries TauCeti.Huber

variable {K : Type*} [NontriviallyNormedField K]

local notation "Tate " σ:max => IsRestricted.subring (R := K) (fun _ : σ ↦ 1)

/-- The polynomials `U²` and `ϖ U` substituted for `T` and `S`. -/
private noncomputable def squarePolys (ϖ : K) : Fin 2 → MvPolynomial (Fin 1) K :=
  ![MvPolynomial.X 0 ^ 2, MvPolynomial.C ϖ * MvPolynomial.X 0]

private theorem constantCoeff_squarePolys (ϖ : K) (s : Fin 2) :
    (squarePolys ϖ s).constantCoeff = 0 := by
  fin_cases s <;> simp [squarePolys]

private theorem norm_coeff_squarePolys_le {ϖ : K} (hϖ : ‖ϖ‖ ≤ 1) :
    ∀ s t, ‖(squarePolys ϖ s).coeff t‖ ≤ 1 := by
  refine Fin.forall_fin_two.mpr ⟨fun t ↦ ?_, fun t ↦ ?_⟩
  · simp only [squarePolys, Matrix.cons_val_zero, MvPolynomial.coeff_X_pow]
    split_ifs <;> simp
  · simp only [squarePolys, Matrix.cons_val_one, Matrix.cons_val_fin_one,
      MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X, norm_mul]
    split_ifs <;> simp [hϖ]

variable [IsUltrametricDist K]

variable (ϖ : K) (hϖ : ‖ϖ‖ ≤ 1)

/-- The `K`-algebra map `K⟨T, S⟩ → K⟨U⟩` substituting `U²` for `T = X 0` and `ϖ U` for
`S = X 1`. For `ϖ ≠ 0` it is surjective (`restrictedSquareSubst_surjective`), and for
`|ϖ| < 1` it is not surjective on canonical reductions
(`not_surjective_reductionMap_restrictedSquareSubst`). -/
noncomputable def restrictedSquareSubst : Tate (Fin 2) →ₐ[K] Tate (Fin 1) :=
  restrictedSubst (squarePolys ϖ) (constantCoeff_squarePolys ϖ) (norm_coeff_squarePolys_le hϖ)

/-- `restrictedSquareSubst` sends `T` to `U²`. -/
@[simp]
theorem restrictedSquareSubst_X_zero :
    restrictedSquareSubst ϖ hϖ ⟨X 0, isRestricted_X _ 0⟩ =
      (⟨X 0, isRestricted_X _ 0⟩ : Tate (Fin 1)) ^ 2 := by
  apply Subtype.ext
  rw [restrictedSquareSubst, coe_restrictedSubst,
    subst_X (hasSubst_coe (constantCoeff_squarePolys ϖ))]
  simp [squarePolys]

/-- `restrictedSquareSubst` sends `S` to `ϖ U`. -/
@[simp]
theorem restrictedSquareSubst_X_one :
    restrictedSquareSubst ϖ hϖ ⟨X 1, isRestricted_X _ 1⟩ =
      ϖ • (⟨X 0, isRestricted_X _ 0⟩ : Tate (Fin 1)) := by
  apply Subtype.ext
  rw [restrictedSquareSubst, coe_restrictedSubst,
    subst_X (hasSubst_coe (constantCoeff_squarePolys ϖ))]
  simp [squarePolys, smul_eq_C_mul]

/-- `restrictedSquareSubst` does not increase Gauss norms. -/
theorem norm_restrictedSquareSubst_le (f : Tate (Fin 2)) :
    ‖restrictedSquareSubst ϖ hϖ f‖ ≤ ‖f‖ :=
  norm_restrictedSubst_le _ _ _ f

/-- **The coefficient of `U`.** The coefficient of `U` in `φ f` is `ϖ` times the coefficient of
`S` in `f`: the only monomial `T^i S^j` with `2 i + j = 1` is `S`. -/
theorem coeff_restrictedSquareSubst_single_zero_one (f : Tate (Fin 2)) :
    coeff (Finsupp.single 0 1) (restrictedSquareSubst ϖ hϖ f : MvPowerSeries (Fin 1) K) =
      ϖ * coeff (Finsupp.single 1 1) (f : MvPowerSeries (Fin 2) K) := by
  have ha := hasSubst_coe (constantCoeff_squarePolys ϖ)
  -- The monomial `T^(d 0) S^(d 1)` is sent to `ϖ^(d 1) U^(2 d 0 + d 1)`.
  have hprod (d : Fin 2 →₀ ℕ) :
      (d.prod fun s e ↦ ((squarePolys ϖ s : MvPolynomial (Fin 1) K) :
        MvPowerSeries (Fin 1) K) ^ e) = C (ϖ ^ d 1) * X 0 ^ (2 * d 0 + d 1) := by
    rw [Finsupp.prod_fintype _ _ (fun _ ↦ pow_zero _), Fin.prod_univ_two]
    simp only [squarePolys, Matrix.cons_val_zero, Matrix.cons_val_one, MvPolynomial.coe_pow,
      MvPolynomial.coe_mul, MvPolynomial.coe_C, MvPolynomial.coe_X, mul_pow, map_pow,
      pow_add, pow_mul]
    ring
  simp only [restrictedSquareSubst, coe_restrictedSubst]
  rw [coeff_subst ha, finsum_eq_single _ (Finsupp.single 1 1)]
  · rw [hprod, coeff_C_mul, coeff_X_pow]
    simp [mul_comm]
  · intro d hd
    have hne : Finsupp.single (0 : Fin 1) 1 ≠ Finsupp.single 0 (2 * d 0 + d 1) := by
      intro h
      have h1 : 1 = 2 * d 0 + d 1 := by simpa using congr($h 0)
      refine hd (Finsupp.ext fun i ↦ ?_)
      fin_cases i <;> simp <;> omega
    simp only [hprod, coeff_C_mul, coeff_X_pow, hne, ite_false, mul_zero, smul_zero]

/-- For `|ϖ| < 1`, the coefficient of `U` in `φ f` has norm less than one whenever `‖f‖ ≤ 1`. -/
theorem norm_coeff_restrictedSquareSubst_single_zero_one_lt {ϖ : K} (hϖ : ‖ϖ‖ < 1)
    {f : Tate (Fin 2)} (hf : ‖f‖ ≤ 1) :
    ‖coeff (Finsupp.single 0 1) (restrictedSquareSubst ϖ hϖ.le f : MvPowerSeries (Fin 1) K)‖ <
      1 := by
  rw [coeff_restrictedSquareSubst_single_zero_one, norm_mul]
  exact (mul_le_of_le_one_right (norm_nonneg _) ((norm_coeff_le_norm _ _).trans hf)).trans_lt hϖ

/-- **`restrictedSquareSubst` is surjective** when `ϖ ≠ 0`: a restricted series in `U` is
`g₀(U²) + U g₁(U²)`, where `g₀(U²)` and `g₁(U²)` are the images of `g₀(T)` and `g₁(T)`, and
`U` is the image of `ϖ⁻¹ S`. -/
theorem restrictedSquareSubst_surjective (hϖ0 : ϖ ≠ 0) :
    Function.Surjective (restrictedSquareSubst ϖ hϖ) := by
  classical
  rw [← AlgHom.range_eq_top, eq_top_iff]
  intro g _
  set R := (restrictedSquareSubst ϖ hϖ).range
  have hU : (⟨X 0, isRestricted_X _ 0⟩ : Tate (Fin 1)) ∈ R := by
    refine (AlgHom.mem_range _).mpr ⟨ϖ⁻¹ • ⟨X 1, isRestricted_X _ 1⟩, ?_⟩
    rw [map_smul, restrictedSquareSubst_X_one, smul_smul, inv_mul_cancel₀ hϖ0, one_smul]
  have ht : ∀ i : Fin 1, (fun _ ↦ (1 : ℝ)) i ^ 2 = (fun _ ↦ (1 : ℝ)) i := fun _ ↦ one_pow 2
  -- The expansion `g(U) ↦ g(U²)` factors through the substitution `U ↦ T`.
  have hexp (h : Tate (Fin 1)) : restrictedExpand 2 two_ne_zero ht h ∈ R := by
    let b : Fin 1 → MvPolynomial (Fin 2) K := fun _ ↦ MvPolynomial.X 0
    have hb₀ (i : Fin 1) : (b i).constantCoeff = 0 := by simp [b]
    have hb₁ (i : Fin 1) (t : Fin 2 →₀ ℕ) : ‖(b i).coeff t‖ ≤ 1 := by
      simp only [b, MvPolynomial.coeff_X]
      split_ifs <;> simp
    refine (AlgHom.mem_range _).mpr ⟨restrictedSubst b hb₀ hb₁ h, Subtype.ext ?_⟩
    simp only [restrictedSquareSubst, coe_restrictedSubst, coe_restrictedExpand, expand,
      coe_substAlgHom]
    rw [subst_comp_subst_apply (hasSubst_coe hb₀) (hasSubst_coe (constantCoeff_squarePolys ϖ))]
    congr 1
    funext s
    rw [Fin.fin_one_eq_zero s, MvPolynomial.coe_X,
      subst_X (hasSubst_coe (constantCoeff_squarePolys ϖ))]
    simp [squarePolys]
  rw [← sum_monomial_mul_restrictedExpand_restrictedExpandComponent two_ne_zero ht g]
  refine R.sum_mem fun ν _ ↦ R.mul_mem ?_ (hexp _)
  -- Each monomial `U^ν` with `ν < 2` is a power of `U`.
  have hν : Finsupp.equivFunOnFinite.symm (Fin.val ∘ ν) =
      Finsupp.single (0 : Fin 1) (ν 0 : ℕ) := by
    refine Finsupp.unique_ext ?_
    rw [Fin.default_eq_zero, Finsupp.single_eq_same, Finsupp.coe_equivFunOnFinite_symm]
    rfl
  convert R.pow_mem hU (ν 0) using 1
  apply Subtype.ext
  rw [SubmonoidClass.coe_pow, X_pow_eq, hν]

section Kernel

variable [CompleteSpace K]

/-- **The kernel of `restrictedSquareSubst`.** For `ϖ ≠ 0` the kernel is generated by
`S² - ϖ² T`, so `restrictedSquareSubst` identifies `K⟨T, S⟩ ⧸ (S² - ϖ² T)` with `K⟨U⟩`. In the
quotient, `S / ϖ` is power-bounded because its square is `T`, so `U ↦ S / ϖ` extends to an
algebra map `K⟨U⟩ → K⟨T, S⟩ ⧸ (S² - ϖ² T)` through which the quotient map factors. -/
theorem ker_restrictedSquareSubst (hϖ0 : ϖ ≠ 0) :
    RingHom.ker (restrictedSquareSubst ϖ hϖ) =
      Ideal.span {(⟨X 1, isRestricted_X _ 1⟩ : Tate (Fin 2)) ^ 2 -
        ϖ ^ 2 • ⟨X 0, isRestricted_X _ 0⟩} := by
  set I := Ideal.span {(⟨X 1, isRestricted_X _ 1⟩ : Tate (Fin 2)) ^ 2 -
    ϖ ^ 2 • ⟨X 0, isRestricted_X _ 0⟩}
  refine le_antisymm (fun F hF ↦ ?_) ((Ideal.span_le).mpr ?_)
  swap
  · rw [Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_sub, map_pow, map_smul,
      restrictedSquareSubst_X_one, restrictedSquareSubst_X_zero, smul_pow, sub_self]
  have hB := (isAffinoidAlgebra_tate (K := K) (σ := Fin 2)).quotient I
  set π := Ideal.Quotient.mkₐ K I
  set x := ϖ⁻¹ • π ⟨X 1, isRestricted_X _ 1⟩
  have hx : x ^ 2 = π ⟨X 0, isRestricted_X _ 0⟩ := by
    have hI : π ((⟨X 1, isRestricted_X _ 1⟩ : Tate (Fin 2)) ^ 2 -
        ϖ ^ 2 • ⟨X 0, isRestricted_X _ 0⟩) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [map_sub, map_pow, map_smul, sub_eq_zero] at hI
    rw [smul_pow, hI, smul_smul, ← mul_pow, inv_mul_cancel₀ hϖ0, one_pow, one_smul]
  -- `x = S / ϖ` is power-bounded, since `|x|sup ^ 2 = |T|sup ≤ 1`.
  have hxb : IsPowerBounded x := by
    refine (IsAffinoidAlgebra.isPowerBounded_iff_supSeminorm_le_one (K := K)
      (A := Tate (Fin 2) ⧸ I) hB).mpr ?_
    have h := isAffinoidAlgebra_tate.supSeminorm_map_le hB π ⟨X 0, isRestricted_X _ 0⟩
    rw [← hx, hB.supSeminorm_pow x two_ne_zero, supSeminorm_eq_norm] at h
    exact (pow_le_one_iff_of_nonneg (supSeminorm_nonneg x) two_ne_zero).mp (h.trans (by simp))
  let ψ := IsAffinoidAlgebra.restrictedLift (K := K) (B := Tate (Fin 2) ⧸ I)
    isAffinoidAlgebra_self hB
    (Algebra.ofId K (Tate (Fin 2) ⧸ I)) (b := fun _ : Fin 1 ↦ x) fun _ ↦ hxb
  have hψ : ψ.comp (restrictedSquareSubst ϖ hϖ) = π := by
    refine IsAffinoidAlgebra.algHom_ext_isRestricted_subring (K := K) (B := Tate (Fin 2) ⧸ I)
      isAffinoidAlgebra_self hB (fun a ↦ by simp) fun i ↦ ?_
    fin_cases i
    · simp [ψ, hx]
    · simp [ψ, x, smul_smul, mul_inv_cancel₀ hϖ0]
  rw [RingHom.mem_ker] at hF
  have h := congr($hψ F)
  rw [AlgHom.comp_apply, hF, map_zero] at h
  exact Ideal.Quotient.eq_zero_iff_mem.mp h.symm

end Kernel

section Reduction

variable [CompleteSpace K]

/-- **A surjection which is not surjective on reductions.** For `|ϖ| < 1` the homomorphism of
canonical reductions induced by `restrictedSquareSubst` is not surjective: no reduction of a
power-bounded series in `T` and `S` is the class of `U`. -/
theorem not_surjective_reductionMap_restrictedSquareSubst (hϖ : ‖ϖ‖ < 1) :
    ¬ Function.Surjective ((restrictedSquareSubst ϖ hϖ.le).reductionMap isAffinoidAlgebra_tate
      isAffinoidAlgebra_tate) := by
  intro h
  obtain ⟨x, hx⟩ := h (Ideal.Quotient.mk _
    ⟨⟨X 0, isRestricted_X _ 0⟩, mem_powerBoundedSubring.mpr (isPowerBounded_X 0)⟩)
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [AlgHom.reductionMap_mk, Ideal.Quotient.eq, mem_topologicallyNilpotentIdeal] at hx
  have hlt : ‖restrictedSquareSubst ϖ hϖ.le F - ⟨X 0, isRestricted_X _ 0⟩‖ < 1 := by
    simpa using isAffinoidAlgebra_tate.isTopologicallyNilpotent_iff_supSeminorm_lt_one.mp hx
  have hF : ‖(F : Tate (Fin 2))‖ ≤ 1 := by
    simp [← Subring.mem_unitClosedBall, ← powerBoundedSubring_eq_unitClosedBall]
  -- Compare the coefficients of `U`: `c - 1` with `|c| < 1` has norm one.
  have hc := norm_coeff_restrictedSquareSubst_single_zero_one_lt hϖ hF
  have hcoeff := (norm_coeff_le_norm (restrictedSquareSubst ϖ hϖ.le F - ⟨X 0, isRestricted_X _ 0⟩)
    (Finsupp.single 0 1)).trans_lt hlt
  rw [AddSubgroupClass.coe_sub, map_sub, coeff_X] at hcoeff
  simp only [↓reduceIte] at hcoeff
  rw [norm_sub_rev] at hcoeff
  have := IsUltrametricDist.norm_add_le_max
    (coeff (Finsupp.single 0 1) (restrictedSquareSubst ϖ hϖ.le F : MvPowerSeries (Fin 1) K))
    (1 - coeff (Finsupp.single 0 1) (restrictedSquareSubst ϖ hϖ.le F : MvPowerSeries (Fin 1) K))
  rw [add_sub_cancel, norm_one] at this
  exact (this.trans_lt (max_lt hc hcoeff)).false

end Reduction

section PresentationRing

/-- **The variable `U` is not in the presentation ring.** For `|ϖ| < 1` the power-bounded variable
`U = S / ϖ` does not lie in the image of the Gauss unit ball of `K⟨T, S⟩`. -/
theorem X_notMem_map_restrictedSquareSubst_unitClosedBall (hϖ : ‖ϖ‖ < 1) :
    (⟨X 0, isRestricted_X _ 0⟩ : Tate (Fin 1)) ∉
      (Subring.unitClosedBall (Tate (Fin 2))).map (restrictedSquareSubst ϖ hϖ.le).toRingHom := by
  rintro ⟨F, hF, hFU⟩
  have h :=
    norm_coeff_restrictedSquareSubst_single_zero_one_lt hϖ (Subring.mem_unitClosedBall.mp hF)
  rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at hFU
  simp only [hFU, coeff_X, ↓reduceIte, norm_one, lt_self_iff_false] at h

/-- The presentation ring `restrictedSquareSubst ϖ (K⟨T, S⟩°)` is bounded. -/
theorem isBounded_map_restrictedSquareSubst_unitClosedBall :
    IsBounded (((Subring.unitClosedBall (Tate (Fin 2))).map
      (restrictedSquareSubst ϖ hϖ).toRingHom : Subring (Tate (Fin 1))) : Set (Tate (Fin 1))) := by
  refine (isBounded_closedBall_zero 1).subset ?_
  rintro _ ⟨F, hF, rfl⟩
  rw [mem_closedBall_zero_iff]
  exact (norm_restrictedSquareSubst_le ϖ hϖ F).trans (Subring.mem_unitClosedBall.mp hF)

/-- For `ϖ ≠ 0`, the presentation ring `restrictedSquareSubst ϖ (K⟨T, S⟩°)` is open, by the
open mapping theorem. -/
theorem isOpen_map_restrictedSquareSubst_unitClosedBall [CompleteSpace K] (hϖ0 : ϖ ≠ 0) :
    IsOpen (((Subring.unitClosedBall (Tate (Fin 2))).map
      (restrictedSquareSubst ϖ hϖ).toRingHom : Subring (Tate (Fin 1))) : Set (Tate (Fin 1))) := by
  have := (isAffinoidAlgebra_tate (K := K) (σ := Fin 2)).isNoetherianRing
  rw [Subring.coe_map]
  exact (isAffinoidAlgebra_tate.isOpenQuotientMap _
    (restrictedSquareSubst_surjective ϖ hϖ hϖ0)).isOpenMap _ (Subring.isOpen_unitClosedBall _)

/-- **The presentation ring has a nonreduced quotient.** For `0 < |ϖ| < 1`, in the image `B` of
the Gauss unit ball of `K⟨T, S⟩` the quotient `B ⧸ ϖ B` is not reduced: the class of
`S = ϖ U` is nonzero, since `U ∉ B`, but its square `ϖ (ϖ U²)` vanishes. -/
theorem not_isReduced_map_restrictedSquareSubst_unitClosedBall_quotient (hϖ0 : ϖ ≠ 0)
    (hϖ : ‖ϖ‖ < 1) :
    ¬ IsReduced ((Subring.unitClosedBall (Tate (Fin 2))).map
      (restrictedSquareSubst ϖ hϖ.le).toRingHom ⧸ Ideal.span
        {(⟨algebraMap K (Tate (Fin 1)) ϖ, algebraMap K (Tate (Fin 2)) ϖ,
          Subring.mem_unitClosedBall.mpr (by simpa using hϖ.le),
          (restrictedSquareSubst ϖ hϖ.le).commutes ϖ⟩ :
          (Subring.unitClosedBall (Tate (Fin 2))).map
            (restrictedSquareSubst ϖ hϖ.le).toRingHom)}) := by
  set B := (Subring.unitClosedBall (Tate (Fin 2))).map (restrictedSquareSubst ϖ hϖ.le).toRingHom
  set φ := restrictedSquareSubst ϖ hϖ.le
  set w : B := ⟨algebraMap K (Tate (Fin 1)) ϖ, algebraMap K (Tate (Fin 2)) ϖ,
    Subring.mem_unitClosedBall.mpr (by simpa using hϖ.le), φ.commutes ϖ⟩
  have hmem {F : Tate (Fin 2)} (hF : ‖F‖ ≤ 1) : φ F ∈ B :=
    ⟨F, Subring.mem_unitClosedBall.mpr hF, rfl⟩
  have hS : ‖(⟨X 1, isRestricted_X _ 1⟩ : Tate (Fin 2))‖ ≤ 1 := by simp
  -- The class of `S = ϖ U` and the element `ϖ U² = φ (ϖ T)` of `B`.
  set s : B := ⟨φ ⟨X 1, isRestricted_X _ 1⟩, hmem hS⟩
  set t : B := ⟨φ (ϖ • ⟨X 0, isRestricted_X _ 0⟩), hmem (by simpa [norm_smul] using hϖ.le)⟩
  intro hred
  have hnil : IsNilpotent (Ideal.Quotient.mk (Ideal.span {w}) s) := by
    refine ⟨2, ?_⟩
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
    refine ⟨t, Subtype.ext ?_⟩
    simp only [s, t, w, φ, Subring.coe_mul, SubmonoidClass.coe_pow, map_smul,
      restrictedSquareSubst_X_zero, restrictedSquareSubst_X_one, Algebra.algebraMap_eq_smul_one]
    rw [smul_pow, smul_mul_smul_comm, mul_one, sq ϖ]
  have hs := hred.eq_zero _ hnil
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hs
  obtain ⟨b, hb⟩ := hs
  have hbU : (b : Tate (Fin 1)) = ⟨X 0, isRestricted_X _ 0⟩ := by
    have h := congr(($hb : Tate (Fin 1)))
    simp only [s, w, φ, Subring.coe_mul, restrictedSquareSubst_X_one,
      Algebra.algebraMap_eq_smul_one, mul_smul_one] at h
    exact smul_right_injective _ hϖ0 h
  exact X_notMem_map_restrictedSquareSubst_unitClosedBall ϖ hϖ (hbU ▸ b.2)

end PresentationRing

