/-!
# The Hessian of an element of a local ring

Let `P` be a local ring whose maximal ideal `𝔪` is generated by finitely many coordinates
`x : ι → P`, and let `D : ι → Derivation R P P` be dual derivations, `Dᵢ xⱼ = δᵢⱼ`. For instance
`P` is the local ring at a point of a smooth variety, with étale coordinates centred there and
the partial derivatives along them. The *Hessian* of `f ∈ P` is the matrix `(Dᵢ Dⱼ f)`.

For `f ∈ 𝔪²`, its residue modulo `𝔪` is the polar matrix `Q + Qᵀ` of the quadratic part
`f ≡ Σ Qₖₗ xₖ xₗ (mod 𝔪³)` (`TauCeti.residue_hessian_sum_mul_mul`). This file proves the
criterion for this quadratic part to be nondegenerate in terms of the partial derivatives: the
partial derivatives `Dⱼ f` generate `𝔪` exactly when the Hessian determinant is a unit
(`TauCeti.span_range_apply_eq_maximalIdeal_iff_isUnit_det_hessian`). Consequently the Jacobian
ideal `(f, D₁ f, …, Dₙ f)` is the maximal ideal exactly when `f ∈ 𝔪²` and the quadratic part of
`f` is nondegenerate (`TauCeti.span_range_apply_sup_span_singleton_eq_maximalIdeal_iff`). For a
nonzero `f` in the local ring at a closed point of a smooth `n`-dimensional variety, with `x` local
coordinates there, this ideal cuts out the singular locus of the hypersurface `f = 0`, and the
criterion says that this locus is the reduced closed point exactly when the hypersurface has an
ordinary double point there. For two coordinates, the nondegeneracy of `a s² + b s t + c t²` is
the condition that its discriminant `b² - 4ac` be a unit
(`TauCeti.isUnit_det_hessian_iff_isUnit_discrim`), in every characteristic; the coordinates `s, t`
need only lie in `𝔪` for this.

## Main definitions

* `TauCeti.hessian D f`: the matrix `(Dᵢ (Dⱼ f))`.

## Main results

* `TauCeti.mem_maximalIdeal_sq_iff_forall_apply_mem`: an element `f ∈ 𝔪` lies in `𝔪²` exactly
  when all its partial derivatives lie in `𝔪`.
* `TauCeti.maximalIdeal_le_span_range_apply_sup_iff_isUnit_det_hessian`: for `f ∈ 𝔪²`, the
  partial derivatives of `f` span the cotangent space `𝔪/𝔪²` exactly when the Hessian
  determinant is a unit.
* `TauCeti.span_range_apply_eq_maximalIdeal_iff_isUnit_det_hessian`: the same, in the form
  `(D₁ f, …, Dₙ f) = 𝔪`.
* `TauCeti.span_range_apply_sup_span_singleton_eq_maximalIdeal_iff`: for `f ∈ 𝔪`, the Jacobian
  ideal `(f, D₁ f, …, Dₙ f)` is `𝔪` exactly when `f ∈ 𝔪²` and the Hessian determinant is a unit.
* `TauCeti.residue_hessian_sum_mul_mul`: modulo `𝔪`, the Hessian of `Σ Qₖₗ xₖ xₗ` is `Q + Qᵀ`.
* `TauCeti.isUnit_det_hessian_iff_isUnit_discrim`: the Hessian of `a s² + b s t + c t²` has unit
  determinant exactly when `b² - 4ac` is a unit.

## References

* [Stacks Project, Section 53.19, Tag 0C46](https://stacks.math.columbia.edu/tag/0C46): nodes of
  curves, defined by a nondegenerate quadratic form in two variables.
-/

public section

noncomputable section

open IsLocalRing

namespace TauCeti

variable {R P ι : Type*} [CommSemiring R] [CommRing P] [Algebra R P]

/-- The Hessian matrix `(Dᵢ (Dⱼ f))` of `f` with respect to a family of derivations `D`. -/
def hessian (D : ι → Derivation R P P) (f : P) : Matrix ι ι P :=
  Matrix.of fun i j ↦ D i (D j f)

@[simp]
theorem hessian_apply (D : ι → Derivation R P P) (f : P) (i j : ι) :
    hessian D f i j = D i (D j f) := (rfl)

variable [IsLocalRing P] [DecidableEq ι] {x : ι → P} {D : ι → Derivation R P P}

/-- The partial derivative `Dⱼ` of `Σ cᵢ xᵢ` is `cⱼ` modulo the maximal ideal. -/
private theorem apply_sum_mul_sub_mem [Fintype ι]
    (hx : maximalIdeal P = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) (c : ι → P) (j : ι) :
    D j (∑ i, c i * x i) - c j ∈ maximalIdeal P := by
  have hsum : D j (∑ i, c i * x i) - c j = ∑ i, x i * D j (c i) := by
    simp [map_sum, Derivation.leibniz, hD, Finset.sum_add_distrib]
  rw [hsum]
  exact sum_mem fun i _ ↦ Ideal.mul_mem_right _ _ (hx ▸ Ideal.subset_span ⟨i, rfl⟩)

/-- **First-order Taylor expansion.** An element `g ∈ 𝔪` agrees with `Σ (Dᵢ g) xᵢ` modulo
`𝔪²`. -/
theorem sub_sum_apply_mul_mem_maximalIdeal_sq [Fintype ι]
    (hx : maximalIdeal P = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {g : P} (hg : g ∈ maximalIdeal P) :
    g - ∑ i, D i g * x i ∈ maximalIdeal P ^ 2 := by
  rw [hx, Ideal.mem_span_range_iff_exists_fun] at hg
  obtain ⟨c, rfl⟩ := hg
  rw [← Finset.sum_sub_distrib, pow_two]
  refine sum_mem fun i _ ↦ ?_
  rw [← sub_mul, ← neg_sub, neg_mul]
  refine neg_mem (Ideal.mul_mem_mul (apply_sum_mul_sub_mem hx hD c i) ?_)
  exact hx ▸ Ideal.subset_span ⟨i, rfl⟩

/-- An element `f ∈ 𝔪` lies in `𝔪²` exactly when all its partial derivatives `Dᵢ f` lie in
`𝔪`. -/
theorem mem_maximalIdeal_sq_iff_forall_apply_mem [Finite ι]
    (hx : maximalIdeal P = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {f : P} (hf : f ∈ maximalIdeal P) :
    f ∈ maximalIdeal P ^ 2 ↔ ∀ i, D i f ∈ maximalIdeal P := by
  have := Fintype.ofFinite ι
  refine ⟨fun h i ↦ (D i).apply_mem_of_mem_sq h, fun h ↦ ?_⟩
  have hsum : ∑ i, D i f * x i ∈ maximalIdeal P ^ 2 := sum_mem fun i _ ↦
    pow_two (maximalIdeal P) ▸ Ideal.mul_mem_mul (h i) (hx ▸ Ideal.subset_span ⟨i, rfl⟩)
  simpa using add_mem (sub_sum_apply_mul_mem_maximalIdeal_sq hx hD hf) hsum

variable [Fintype ι]

/-- **The Hessian criterion for a nondegenerate quadratic part.** For `f ∈ 𝔪²`, the partial
derivatives `Dⱼ f` span the cotangent space `𝔪/𝔪²` exactly when the Hessian determinant is a
unit. -/
theorem maximalIdeal_le_span_range_apply_sup_iff_isUnit_det_hessian
    (hx : maximalIdeal P = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {f : P} (hf : f ∈ maximalIdeal P ^ 2) :
    maximalIdeal P ≤ Ideal.span (Set.range fun j ↦ D j f) ⊔ maximalIdeal P ^ 2 ↔
      IsUnit (hessian D f).det := by
  have hxm (i : ι) : x i ∈ maximalIdeal P := hx ▸ Ideal.subset_span ⟨i, rfl⟩
  have hDf (j : ι) : D j f ∈ maximalIdeal P := (D j).apply_mem_of_mem_sq hf
  constructor
  · intro h
    -- Write each coordinate as `xₖ = Σⱼ Cⱼₖ Dⱼ f + mₖ` with `mₖ ∈ 𝔪²`.
    have hC (k : ι) : ∃ c : ι → P, x k - ∑ j, c j * D j f ∈ maximalIdeal P ^ 2 := by
      obtain ⟨y, hy, m, hm, hym⟩ := Submodule.mem_sup.1 (h (hxm k))
      obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.1 hy
      exact ⟨c, by rwa [← hym, add_sub_cancel_left]⟩
    choose C hC using hC
    -- Differentiating, `δᵢₖ = Dᵢ xₖ ≡ Σⱼ (Dᵢ Dⱼ f) Cⱼₖ` modulo `𝔪`, so `H C ≡ 1`.
    have hmul : (hessian D f * Matrix.of fun j k ↦ C k j).map (residue P) = 1 := by
      ext i k
      rw [Matrix.map_apply, ← Matrix.map_one (residue P) (map_zero _) (map_one _),
        Matrix.map_apply, ← sub_eq_zero, ← map_sub, residue_eq_zero_iff, Matrix.one_apply,
        ← hD i k]
      have hsum : D i (∑ j, C k j * D j f) - (hessian D f * Matrix.of fun j k ↦ C k j) i k =
          ∑ j, D j f * D i (C k j) := by
        simp [Matrix.mul_apply, map_sum, Derivation.leibniz, Finset.sum_add_distrib, mul_comm]
      have h1 : D i (x k) - D i (∑ j, C k j * D j f) ∈ maximalIdeal P := by
        rw [← map_sub]
        exact (D i).apply_mem_of_mem_sq (hC k)
      have h2 : ∑ j, D j f * D i (C k j) ∈ maximalIdeal P :=
        sum_mem fun j _ ↦ Ideal.mul_mem_right _ _ (hDf j)
      have hsplit : (hessian D f * Matrix.of fun j k ↦ C k j) i k - D i (x k) =
          -((D i (x k) - D i (∑ j, C k j * D j f)) +
            (D i (∑ j, C k j * D j f) - (hessian D f * Matrix.of fun j k ↦ C k j) i k)) := by
        ring
      rw [hsplit, hsum]
      exact neg_mem (add_mem h1 h2)
    rw [← residue_ne_zero_iff_isUnit, RingHom.map_det]
    intro h0
    have := congrArg Matrix.det hmul
    rw [RingHom.mapMatrix_apply] at h0
    rw [Matrix.map_mul, Matrix.det_mul, h0, zero_mul, Matrix.det_one] at this
    exact zero_ne_one this
  · intro hdet
    -- With `C = H⁻¹`, each coordinate is `xₖ ≡ Σⱼ Cⱼₖ Dⱼ f` modulo `𝔪²`.
    set H := hessian D f
    refine hx.le.trans (Ideal.span_le.2 ?_)
    rintro _ ⟨k, rfl⟩
    refine Submodule.mem_sup.2 ⟨∑ j, H⁻¹ j k * D j f,
      Ideal.mem_span_range_iff_exists_fun.2 ⟨_, rfl⟩, x k - ∑ j, H⁻¹ j k * D j f, ?_,
      add_sub_cancel _ _⟩
    have hexp : x k - ∑ j, H⁻¹ j k * D j f =
        -∑ j, H⁻¹ j k * (D j f - ∑ i, D i (D j f) * x i) := by
      have hHC : ∑ i, (H * H⁻¹) i k * x i = x k := by
        simp [Matrix.mul_nonsing_inv _ hdet, Matrix.one_apply]
      simp only [Matrix.mul_apply, Finset.sum_mul] at hHC
      rw [Finset.sum_comm] at hHC
      simp only [mul_sub, Finset.sum_sub_distrib, Finset.mul_sum, neg_sub, ← hHC]
      congr 1
      refine Finset.sum_congr rfl fun j _ ↦ Finset.sum_congr rfl fun i _ ↦ ?_
      simp only [H, hessian_apply]
      ring
    rw [hexp]
    exact neg_mem (sum_mem fun j _ ↦ Ideal.mul_mem_left _ _
      (sub_sum_apply_mul_mem_maximalIdeal_sq hx hD (hDf j)))

/-- For `f ∈ 𝔪²`, the partial derivatives `Dⱼ f` generate the maximal ideal exactly when the
Hessian determinant of `f` is a unit. -/
theorem span_range_apply_eq_maximalIdeal_iff_isUnit_det_hessian
    (hx : maximalIdeal P = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {f : P} (hf : f ∈ maximalIdeal P ^ 2) :
    Ideal.span (Set.range fun j ↦ D j f) = maximalIdeal P ↔ IsUnit (hessian D f).det := by
  rw [← maximalIdeal_le_span_range_apply_sup_iff_isUnit_det_hessian hx hD hf]
  refine ⟨fun h ↦ h ▸ le_sup_left, fun h ↦ le_antisymm ?_ ?_⟩
  · exact Ideal.span_le.2 <| Set.range_subset_iff.2 fun j ↦ (D j).apply_mem_of_mem_sq hf
  · -- Nakayama's lemma, for the finitely generated maximal ideal.
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := maximalIdeal P)
      (hx ▸ Submodule.fg_span (Set.finite_range x))
      (jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge ?_
    simpa [smul_eq_mul, pow_two] using h

/-- **The Jacobian ideal of a nondegenerate quadratic singularity.** For `f ∈ 𝔪`, the ideal
`(f, D₁ f, …, Dₙ f)` is the maximal ideal exactly when `f ∈ 𝔪²` and the Hessian determinant of
`f` is a unit. -/
theorem span_range_apply_sup_span_singleton_eq_maximalIdeal_iff
    (hx : maximalIdeal P = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {f : P} (hf : f ∈ maximalIdeal P) :
    Ideal.span (Set.range fun j ↦ D j f) ⊔ Ideal.span {f} = maximalIdeal P ↔
      f ∈ maximalIdeal P ^ 2 ∧ IsUnit (hessian D f).det := by
  constructor
  · intro h
    have hf2 : f ∈ maximalIdeal P ^ 2 := (mem_maximalIdeal_sq_iff_forall_apply_mem hx hD hf).2
      fun j ↦ h ▸ Ideal.mem_sup_left (Ideal.subset_span ⟨j, rfl⟩)
    refine ⟨hf2, (maximalIdeal_le_span_range_apply_sup_iff_isUnit_det_hessian hx hD hf2).1 ?_⟩
    exact h.symm.le.trans (sup_le_sup_left ((Ideal.span_singleton_le_iff_mem _).2 hf2) _)
  · rintro ⟨hf2, hdet⟩
    rw [(span_range_apply_eq_maximalIdeal_iff_isUnit_det_hessian hx hD hf2).2 hdet]
    exact sup_eq_left.2 ((Ideal.span_singleton_le_iff_mem _).2 hf)

/-- **The Hessian of a quadratic form is its polar matrix.** Modulo the maximal ideal, the
Hessian of `Σₖ Σₗ Qₖₗ xₖ xₗ` is `Q + Qᵀ`. -/
theorem residue_hessian_sum_mul_mul (hx : ∀ i, x i ∈ maximalIdeal P)
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) (Q : Matrix ι ι P) (i j : ι) :
    residue P (hessian D (∑ k, ∑ l, Q k l * x k * x l) i j) = residue P (Q i j + Q j i) := by
  have hxr (k : ι) : residue P (x k) = 0 := (residue_eq_zero_iff _).2 (hx k)
  -- Differentiating twice, only the terms in which both derivatives fall on coordinates survive.
  have hterm (k l : ι) : residue P (D i (D j (Q k l * x k * x l))) =
      residue P (Q k l) * ((if i = k then 1 else 0) * (if j = l then 1 else 0) +
        (if i = l then 1 else 0) * (if j = k then 1 else 0)) := by
    simp only [Derivation.leibniz, smul_eq_mul, map_add, map_mul, hD, hxr]
    split_ifs <;> simp [mul_add]
  simp only [hessian_apply, map_sum, hterm, mul_add, Finset.sum_add_distrib, mul_ite, mul_one,
    mul_zero, Finset.sum_ite_irrel, Finset.sum_const_zero, Finset.sum_ite_eq, Finset.mem_univ,
    ite_true, map_add]

/-- **The node condition in two variables.** For `s = x 0`, `t = x 1` in `𝔪` with dual
derivations `D`, the Hessian of `a s² + b s t + c t²` has unit determinant exactly when the
discriminant `b² - 4ac` is a unit. -/
theorem isUnit_det_hessian_iff_isUnit_discrim {x : Fin 2 → P} {D : Fin 2 → Derivation R P P}
    (hx : ∀ i, x i ∈ maximalIdeal P)
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) (a b c : P) :
    IsUnit (hessian D (a * x 0 ^ 2 + b * x 0 * x 1 + c * x 1 ^ 2)).det ↔
      IsUnit (discrim a b c) := by
  have hf : a * x 0 ^ 2 + b * x 0 * x 1 + c * x 1 ^ 2 =
      ∑ k, ∑ l, !![a, b; 0, c] k l * x k * x l := by
    simp [Fin.sum_univ_two]
    ring
  have h := residue_hessian_sum_mul_mul hx hD !![a, b; 0, c]
  rw [← hf] at h
  have h00 := h 0 0
  have h01 := h 0 1
  have h10 := h 1 0
  have h11 := h 1 1
  simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.empty_val', Matrix.cons_val_fin_one, add_zero, zero_add] at h00 h01 h10 h11
  rw [← residue_ne_zero_iff_isUnit, ← residue_ne_zero_iff_isUnit, Matrix.det_fin_two, map_sub,
    map_mul, map_mul, h00, h01, h10, h11, discrim]
  simp only [map_add, map_sub, map_mul, map_pow, map_ofNat]
  exact ⟨fun h hc ↦ h (by linear_combination -hc), fun h hc ↦ h (by linear_combination -hc)⟩

end TauCeti
