module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import Mathlib.RingTheory.Flat.Localization
public import Mathlib.RingTheory.LocalRing.ResidueField.Defs
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# Faithfully flat extensions with infinite residue field

Every local ring `R` has a faithfully flat local extension with infinite residue field
(`IsLocalRing.exists_faithfullyFlat_infinite_residueField`): the localization `R[X]_{𝔪[X]}` of the
polynomial ring at the prime ideal generated by the maximal ideal `𝔪` of `R`. Its residue field
contains the distinct powers of `X`. This is the standard device for reducing statements about
local rings to the case of an infinite residue field, where general position arguments apply.
-/

public section

universe u

open Polynomial

namespace IsLocalRing

variable (R : Type u) [CommRing R] [IsLocalRing R]

/-- **A faithfully flat extension with infinite residue field.** Every local ring `R` has a
faithfully flat `R`-algebra `R'` which is a local ring with infinite residue field, namely
`R[X]_{𝔪[X]}`. -/
theorem exists_faithfullyFlat_infinite_residueField :
    ∃ (R' : Type u) (_ : CommRing R') (_ : IsLocalRing R') (_ : Algebra R R'),
      Module.FaithfullyFlat R R' ∧ Infinite (ResidueField R') := by
  let P : Ideal R[X] := (maximalIdeal R).map C
  let R' := Localization.AtPrime P
  -- a polynomial maps into the maximal ideal of `R'` exactly when its coefficients lie in `𝔪`
  have hmem (f : R[X]) : algebraMap R[X] R' f ∈ maximalIdeal R' ↔ ∀ n, f.coeff n ∈ maximalIdeal R :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff R' P f).trans Ideal.mem_map_C_iff
  have : Module.Flat R R' := .trans R R[X] R'
  have : IsLocalHom (algebraMap R R') := by
    refine ⟨fun r hr ↦ by_contra fun hr' ↦ ?_⟩
    refine (maximalIdeal.isMaximal R').ne_top (Ideal.eq_top_of_isUnit_mem _ ?_ hr)
    rw [IsScalarTower.algebraMap_apply R R[X] R', hmem]
    intro n
    rw [Polynomial.algebraMap_eq, coeff_C]
    split_ifs
    · exact (mem_maximalIdeal r).mpr hr'
    · exact zero_mem _
  refine ⟨R', inferInstance, inferInstance, inferInstance, .of_flat_of_isLocalHom, ?_⟩
  -- the residues of the powers of `X` are distinct
  refine .of_injective (fun n : ℕ ↦ residue R' (algebraMap R[X] R' (X ^ n))) fun m n hmn ↦ ?_
  by_contra hne
  have hsub := sub_eq_zero.mpr hmn
  rw [← map_sub, residue_eq_zero_iff, ← map_sub, hmem] at hsub
  simpa [coeff_X_pow, hne] using hsub m

end IsLocalRing
