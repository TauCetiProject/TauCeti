/-!
# The Hilbert–Samuel function of a local ring and its quotients

For a commutative local ring `(A, 𝔪)` and an ideal `I : Ideal A`, the local quotient
Hilbert–Samuel function `TauCeti.localQuotientHilbertSamuel A I : ℕ → ℕ∞` sends a jet cutoff `n` to
the `A`-module length

`length_A (A ⧸ (I ⊔ 𝔪 ^ (n + 1)))`.

Specializing to `I = ⊥` recovers the intrinsic local Hilbert–Samuel function
`TauCeti.localHilbertSamuel A : ℕ → ℕ∞`, `n ↦ length_A (A ⧸ 𝔪 ^ (n + 1))`. Measuring by `A`-module
length rather than vector-space dimension over a ground field normalizes the degree-zero value at
any proper ideal to `1` (`TauCeti.localQuotientHilbertSamuel_zero_of_ne_top`), even when the
residue field has nontrivial extension degree over a base field
(`TauCeti.localHilbertSamuel_of_field`), while assigning `0` in every degree to the unit ideal
`I = ⊤` (`TauCeti.localQuotientHilbertSamuel_top`).

When `A` is Noetherian, every value `localQuotientHilbertSamuel A I n` is finite
(`TauCeti.localQuotientHilbertSamuel_lt_top`), and maximal-adic completion preserves the entire
function (`TauCeti.localQuotientHilbertSamuel_adicCompletion`,
`TauCeti.localHilbertSamuel_adicCompletion`) as a special case of flat local extensions whose
maximal ideal is generated by that of the base (`TauCeti.localQuotientHilbertSamuel_map_of_flat`).

## Main definitions

* `TauCeti.localQuotientHilbertSamuel`: `n ↦ Module.length A (A ⧸ (I ⊔ maximalIdeal A ^ (n + 1)))`.
* `TauCeti.localHilbertSamuel`: `localQuotientHilbertSamuel A ⊥`, the Hilbert–Samuel function of
  `A`.

## Main results

* `TauCeti.localQuotientHilbertSamuel_eq_zero_iff`,
  `TauCeti.localQuotientHilbertSamuel_zero_of_ne_top`: vanishing detects `I = ⊤`, and every proper
  ideal has degree-zero value `1`.
* `TauCeti.localQuotientHilbertSamuel_anti`, `TauCeti.localQuotientHilbertSamuel_mono`: antitonicity
  in the ideal and monotonicity in the jet order.
* `TauCeti.localQuotientHilbertSamuel_comap_of_surjective`,
  `TauCeti.localHilbertSamuel_quotient`: compatibility with surjective local homomorphisms and
  agreement of `localQuotientHilbertSamuel A I` with `localHilbertSamuel (A ⧸ I)`.
* `TauCeti.localQuotientHilbertSamuel_lt_top`: finiteness over a Noetherian local ring.
* `TauCeti.localQuotientHilbertSamuel_map_of_flat`,
  `TauCeti.localQuotientHilbertSamuel_adicCompletion`,
  `TauCeti.localHilbertSamuel_adicCompletion`: invariance along unramified flat local extensions and
  maximal-adic completion.

## References

* Edward Bierstone and Pierre D. Milman, *Canonical desingularization in characteristic zero by
  blowing up the maximum strata of a local invariant*, Invent. Math. 128 (1997), 207–302,
  Remarks 1.3, Corollary 3.20, Theorem 9.2, and Lemma 9.3.
* Hideyuki Matsumura, *Commutative Ring Theory*, Cambridge University Press (1986), §13.
-/

public section

open IsLocalRing

namespace TauCeti

section Basic

variable {A : Type*} [CommRing A] [IsLocalRing A]

/-- The Hilbert–Samuel function of the quotient `A ⧸ I` of a local ring `(A, 𝔪)`, sending `n : ℕ`
to `Module.length A (A ⧸ (I ⊔ 𝔪 ^ (n + 1)))`. For `I = ⊤` every value is `0`. -/
noncomputable def localQuotientHilbertSamuel (A : Type*) [CommRing A] [IsLocalRing A]
    (I : Ideal A) (n : ℕ) : ℕ∞ :=
  Module.length A (A ⧸ (I ⊔ maximalIdeal A ^ (n + 1)))

theorem localQuotientHilbertSamuel_def (A : Type*) [CommRing A] [IsLocalRing A]
    (I : Ideal A) (n : ℕ) :
    localQuotientHilbertSamuel A I n =
      Module.length A (A ⧸ (I ⊔ maximalIdeal A ^ (n + 1))) := (rfl)

/-- The Hilbert–Samuel function `n ↦ Module.length A (A ⧸ 𝔪 ^ (n + 1))` of a local ring `(A, 𝔪)`. -/
noncomputable def localHilbertSamuel (A : Type*) [CommRing A] [IsLocalRing A] (n : ℕ) : ℕ∞ :=
  localQuotientHilbertSamuel A ⊥ n

theorem localHilbertSamuel_def (A : Type*) [CommRing A] [IsLocalRing A] (n : ℕ) :
    localHilbertSamuel A n = localQuotientHilbertSamuel A ⊥ n := (rfl)

theorem localHilbertSamuel_eq_length (A : Type*) [CommRing A] [IsLocalRing A] (n : ℕ) :
    localHilbertSamuel A n = Module.length A (A ⧸ maximalIdeal A ^ (n + 1)) := by
  rw [localHilbertSamuel_def, localQuotientHilbertSamuel_def, bot_sup_eq]

@[simp]
theorem localQuotientHilbertSamuel_bot (A : Type*) [CommRing A] [IsLocalRing A] :
    localQuotientHilbertSamuel A ⊥ = localHilbertSamuel A := (rfl)

@[simp]
theorem localQuotientHilbertSamuel_top (A : Type*) [CommRing A] [IsLocalRing A] (n : ℕ) :
    localQuotientHilbertSamuel A ⊤ n = 0 := by
  rw [localQuotientHilbertSamuel_def, top_sup_eq, Module.length_eq_zero_iff,
    Submodule.Quotient.subsingleton_iff]

private theorem sup_maximalIdeal_pow_eq_top_iff {I : Ideal A} {k : ℕ} (hk : k ≠ 0) :
    I ⊔ maximalIdeal A ^ k = ⊤ ↔ I = ⊤ := by
  refine ⟨fun h ↦ ?_, fun h ↦ by simp [h]⟩
  have h1 : (1 : A) ∈ I ⊔ maximalIdeal A := by
    have hle : I ⊔ maximalIdeal A ^ k ≤ I ⊔ maximalIdeal A :=
      sup_le_sup_left (Ideal.pow_le_self hk) I
    exact hle (h ▸ Submodule.mem_top)
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1
  have ha_eq : a = 1 - b := eq_sub_of_add_eq hab
  have hu : IsUnit a := by
    rw [ha_eq, ← notMem_maximalIdeal]
    intro hmem
    exact (maximalIdeal.isMaximal A).ne_top
      (Ideal.eq_top_of_isUnit_mem _ (add_sub_cancel b 1 ▸ add_mem hb hmem) isUnit_one)
  exact Ideal.eq_top_of_isUnit_mem I ha hu

@[simp]
theorem localQuotientHilbertSamuel_eq_zero_iff {I : Ideal A} {n : ℕ} :
    localQuotientHilbertSamuel A I n = 0 ↔ I = ⊤ := by
  rw [localQuotientHilbertSamuel_def, Module.length_eq_zero_iff,
    Submodule.Quotient.subsingleton_iff, sup_maximalIdeal_pow_eq_top_iff (Nat.succ_ne_zero n)]

theorem localQuotientHilbertSamuel_pos_iff {I : Ideal A} {n : ℕ} :
    0 < localQuotientHilbertSamuel A I n ↔ I ≠ ⊤ :=
  pos_iff_ne_zero.trans localQuotientHilbertSamuel_eq_zero_iff.not

@[simp]
theorem localHilbertSamuel_pos (A : Type*) [CommRing A] [IsLocalRing A] (n : ℕ) :
    0 < localHilbertSamuel A n :=
  localQuotientHilbertSamuel_pos_iff.mpr bot_ne_top

/-- For any proper ideal `I` of a local ring `A`, `localQuotientHilbertSamuel A I 0 = 1`, since
`I ≤ maximalIdeal A` and `A ⧸ maximalIdeal A` is a simple `A`-module. -/
theorem localQuotientHilbertSamuel_zero_of_ne_top {I : Ideal A} (hI : I ≠ ⊤) :
    localQuotientHilbertSamuel A I 0 = 1 := by
  rw [localQuotientHilbertSamuel_def, zero_add, pow_one,
    sup_eq_right.mpr (le_maximalIdeal hI), Ideal.length_quotient_eq_one]

@[simp]
theorem localHilbertSamuel_zero (A : Type*) [CommRing A] [IsLocalRing A] :
    localHilbertSamuel A 0 = 1 :=
  localQuotientHilbertSamuel_zero_of_ne_top bot_ne_top

/-- Over any field `K`, `localHilbertSamuel K n = 1` for every `n : ℕ`, regardless of the degree of
`K` over any subfield. -/
@[simp]
theorem localHilbertSamuel_of_field (K : Type*) [Field K] (n : ℕ) :
    localHilbertSamuel K n = 1 := by
  rw [localHilbertSamuel_eq_length, maximalIdeal_eq_bot, ← Ideal.zero_eq_bot,
    zero_pow (Nat.succ_ne_zero n), Ideal.zero_eq_bot, Ideal.length_quotient_eq_one]

/-- Enlarging the ideal `I` decreases `localQuotientHilbertSamuel A I` pointwise. -/
theorem localQuotientHilbertSamuel_anti {I J : Ideal A} (h : I ≤ J) :
    localQuotientHilbertSamuel A J ≤ localQuotientHilbertSamuel A I :=
  fun _ ↦ length_quotient_anti (sup_le_sup_right h _)

/-- `localQuotientHilbertSamuel A I` is monotone in the jet cutoff `n`. -/
theorem localQuotientHilbertSamuel_mono (A : Type*) [CommRing A] [IsLocalRing A] (I : Ideal A) :
    Monotone (localQuotientHilbertSamuel A I) :=
  fun _ _ hmn ↦ length_quotient_anti
    (sup_le_sup_left (Ideal.pow_le_pow_right (Nat.succ_le_succ hmn)) I)

/-- `localHilbertSamuel A` is monotone in the jet cutoff `n`. -/
theorem localHilbertSamuel_mono (A : Type*) [CommRing A] [IsLocalRing A] :
    Monotone (localHilbertSamuel A) :=
  localQuotientHilbertSamuel_mono A ⊥

/-- Every quotient Hilbert–Samuel function is bounded above pointwise by `localHilbertSamuel A`. -/
theorem localQuotientHilbertSamuel_le_localHilbertSamuel (A : Type*) [CommRing A] [IsLocalRing A]
    (I : Ideal A) :
    localQuotientHilbertSamuel A I ≤ localHilbertSamuel A :=
  localQuotientHilbertSamuel_anti (A := A) (I := ⊥) (J := I) bot_le

end Basic

section SurjectiveAndEquiv

variable {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]

/-- Along a surjective homomorphism `π : A →+* B` of local rings, pulling back an ideal `J` of `B`
preserves `localQuotientHilbertSamuel`. -/
theorem localQuotientHilbertSamuel_comap_of_surjective {π : A →+* B}
    (hπ : Function.Surjective π) (J : Ideal B) :
    localQuotientHilbertSamuel A (J.comap π) = localQuotientHilbertSamuel B J := by
  ext n
  rw [localQuotientHilbertSamuel_def, localQuotientHilbertSamuel_def]
  have hmap : (J.comap π ⊔ maximalIdeal A ^ (n + 1)).map π = J ⊔ maximalIdeal B ^ (n + 1) := by
    rw [Ideal.map_sup, Ideal.map_comap_of_surjective π hπ, Ideal.map_pow,
      map_maximalIdeal_of_surjective π hπ]
  have hcomap : (J ⊔ maximalIdeal B ^ (n + 1)).comap π =
      J.comap π ⊔ maximalIdeal A ^ (n + 1) := by
    rw [← hmap, Ideal.comap_map_of_surjective' π hπ, sup_eq_left]
    exact le_sup_of_le_left (RingHom.ker_eq_comap_bot π ▸ Ideal.comap_mono bot_le)
  let φ : (A ⧸ (J.comap π ⊔ maximalIdeal A ^ (n + 1))) →ₛₗ[π]
      (B ⧸ (J ⊔ maximalIdeal B ^ (n + 1))) :=
    { toFun := Ideal.quotientMap (J ⊔ maximalIdeal B ^ (n + 1)) π hcomap.ge
      map_add' := map_add _
      map_smul' a x := by
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact map_mul (Ideal.quotientMap (J ⊔ maximalIdeal B ^ (n + 1)) π hcomap.ge)
          (Ideal.Quotient.mk _ a) (Ideal.Quotient.mk _ y) }
  have : RingHomSurjective π := ⟨hπ⟩
  exact LinearMap.length_eq_of_bijective φ
    ⟨Ideal.quotientMap_injective' (H := hcomap.ge) hcomap.le,
      Ideal.quotientMap_surjective (H := hcomap.ge) hπ⟩

/-- When `A ⧸ I` is a local ring (i.e. `I ≠ ⊤`), its intrinsic Hilbert–Samuel function agrees with
`localQuotientHilbertSamuel A I`. -/
@[simp]
theorem localHilbertSamuel_quotient (I : Ideal A) [IsLocalRing (A ⧸ I)] :
    localHilbertSamuel (A ⧸ I) = localQuotientHilbertSamuel A I := by
  rw [← localQuotientHilbertSamuel_bot,
    ← localQuotientHilbertSamuel_comap_of_surjective Ideal.Quotient.mk_surjective ⊥,
    ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]

/-- Along a bijective homomorphism `f : A →+* B` of local rings, pushing forward an ideal preserves
`localQuotientHilbertSamuel`. -/
theorem localQuotientHilbertSamuel_map_of_bijective {f : A →+* B}
    (hf : Function.Bijective f) (I : Ideal A) :
    localQuotientHilbertSamuel B (I.map f) = localQuotientHilbertSamuel A I := by
  rw [← localQuotientHilbertSamuel_comap_of_surjective hf.2 (I.map f),
    Ideal.comap_map_of_bijective f hf]

/-- Bijective ring homomorphisms between local rings preserve `localHilbertSamuel`. -/
theorem localHilbertSamuel_eq_of_bijective {f : A →+* B} (hf : Function.Bijective f) :
    localHilbertSamuel A = localHilbertSamuel B := by
  rw [← localQuotientHilbertSamuel_bot, ← localQuotientHilbertSamuel_bot B,
    ← localQuotientHilbertSamuel_map_of_bijective hf ⊥, Ideal.map_bot]

end SurjectiveAndEquiv

section Noetherian

variable {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]

/-- Over a Noetherian local ring `(A, 𝔪)`, every quotient `A ⧸ (I ⊔ 𝔪 ^ (n + 1))` has finite
`A`-length, including when `I = ⊤`. -/
theorem isFiniteLength_quotient_sup_maximalIdeal_pow (A : Type*) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] (I : Ideal A) (n : ℕ) :
    IsFiniteLength A (A ⧸ (I ⊔ maximalIdeal A ^ (n + 1))) := by
  rw [← Module.length_ne_top_iff, ← lt_top_iff_ne_top]
  exact (length_quotient_anti le_sup_right).trans_lt
    (lt_top_iff_ne_top.mpr (Module.length_ne_top_iff.mpr
      (isFiniteLength_quotient_maximalIdeal_pow (n + 1))))

theorem localQuotientHilbertSamuel_lt_top (A : Type*) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] (I : Ideal A) (n : ℕ) :
    localQuotientHilbertSamuel A I n < ⊤ :=
  lt_top_iff_ne_top.mpr <| Module.length_ne_top_iff.mpr <|
    isFiniteLength_quotient_sup_maximalIdeal_pow A I n

theorem localQuotientHilbertSamuel_ne_top (A : Type*) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] (I : Ideal A) (n : ℕ) :
    localQuotientHilbertSamuel A I n ≠ ⊤ :=
  (localQuotientHilbertSamuel_lt_top A I n).ne

theorem localHilbertSamuel_lt_top (A : Type*) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (n : ℕ) :
    localHilbertSamuel A n < ⊤ :=
  localQuotientHilbertSamuel_lt_top A ⊥ n

theorem localHilbertSamuel_ne_top (A : Type*) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (n : ℕ) :
    localHilbertSamuel A n ≠ ⊤ :=
  localQuotientHilbertSamuel_ne_top A ⊥ n

@[simp]
theorem natCast_toNat_localQuotientHilbertSamuel (A : Type*) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] (I : Ideal A) (n : ℕ) :
    ((localQuotientHilbertSamuel A I n).toNat : ℕ∞) = localQuotientHilbertSamuel A I n :=
  ENat.natCast_toNat (localQuotientHilbertSamuel_ne_top A I n)

@[simp]
theorem natCast_toNat_localHilbertSamuel (A : Type*) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] (n : ℕ) :
    ((localHilbertSamuel A n).toNat : ℕ∞) = localHilbertSamuel A n :=
  ENat.natCast_toNat (localHilbertSamuel_ne_top A n)

end Noetherian

section FlatAndCompletion

/-- Along a flat local algebra `A → B` such that `(maximalIdeal A).map (algebraMap A B) =
maximalIdeal B`, extending `I` to `B` preserves `localQuotientHilbertSamuel`. -/
theorem localQuotientHilbertSamuel_map_of_flat {A B : Type*} [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] [Algebra A B] [Module.Flat A B]
    (hm : (maximalIdeal A).map (algebraMap A B) = maximalIdeal B) (I : Ideal A) :
    localQuotientHilbertSamuel B (I.map (algebraMap A B)) =
      localQuotientHilbertSamuel A I := by
  have : IsLocalHom (algebraMap A B) :=
    ((IsLocalRing.local_hom_tfae (algebraMap A B)).out 1 3).mpr hm.le
  ext n
  rw [localQuotientHilbertSamuel_def, localQuotientHilbertSamuel_def]
  have hmap : (I ⊔ maximalIdeal A ^ (n + 1)).map (algebraMap A B) =
      I.map (algebraMap A B) ⊔ maximalIdeal B ^ (n + 1) := by
    rw [Ideal.map_sup, Ideal.map_pow, hm]
  rw [← hmap,
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B
      (I ⊔ maximalIdeal A ^ (n + 1))).toLinearEquiv.length_eq,
    IsLocalRing.length_baseChange A B (A ⧸ (I ⊔ maximalIdeal A ^ (n + 1))),
    hm, Ideal.length_quotient_eq_one (maximalIdeal B), mul_one]

/-- Along a flat local algebra `A → B` with `(maximalIdeal A).map (algebraMap A B) =
maximalIdeal B`, `localHilbertSamuel B = localHilbertSamuel A`. -/
theorem localHilbertSamuel_eq_of_flat {A B : Type*} [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] [Algebra A B] [Module.Flat A B]
    (hm : (maximalIdeal A).map (algebraMap A B) = maximalIdeal B) :
    localHilbertSamuel B = localHilbertSamuel A := by
  rw [← localQuotientHilbertSamuel_bot, ← localQuotientHilbertSamuel_bot A,
    ← localQuotientHilbertSamuel_map_of_flat hm ⊥, Ideal.map_bot]

/-- Maximal-adic completion of a Noetherian local ring preserves `localQuotientHilbertSamuel` for
every ideal `I : Ideal A`. -/
@[simp]
theorem localQuotientHilbertSamuel_adicCompletion (A : Type*) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] (I : Ideal A) :
    localQuotientHilbertSamuel (AdicCompletion (maximalIdeal A) A)
        (I.map (algebraMap A (AdicCompletion (maximalIdeal A) A))) =
      localQuotientHilbertSamuel A I :=
  localQuotientHilbertSamuel_map_of_flat AdicCompletion.maximalIdeal_eq_map.symm I

/-- Maximal-adic completion of a Noetherian local ring preserves `localHilbertSamuel`. -/
@[simp]
theorem localHilbertSamuel_adicCompletion (A : Type*) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] :
    localHilbertSamuel (AdicCompletion (maximalIdeal A) A) = localHilbertSamuel A :=
  localHilbertSamuel_eq_of_flat AdicCompletion.maximalIdeal_eq_map.symm

end FlatAndCompletion

end TauCeti

namespace RingEquiv

variable {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]

/-- Ring isomorphisms of local rings preserve `TauCeti.localQuotientHilbertSamuel`. -/
theorem localQuotientHilbertSamuel_map (e : A ≃+* B) (I : Ideal A) :
    TauCeti.localQuotientHilbertSamuel B (I.map (e : A →+* B)) =
      TauCeti.localQuotientHilbertSamuel A I :=
  TauCeti.localQuotientHilbertSamuel_map_of_bijective (f := (e : A →+* B)) e.bijective I

/-- Ring isomorphisms of local rings preserve `TauCeti.localHilbertSamuel`. -/
theorem localHilbertSamuel_eq (e : A ≃+* B) :
    TauCeti.localHilbertSamuel A = TauCeti.localHilbertSamuel B :=
  TauCeti.localHilbertSamuel_eq_of_bijective (f := (e : A →+* B)) e.bijective

end RingEquiv
