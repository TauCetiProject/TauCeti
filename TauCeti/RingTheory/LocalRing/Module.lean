/-!
# Generators of modules over a local ring

Over a local ring `R`, a free module of rank one is generated by a single element of any
spanning set. For instance, if `Ω[A⁄k]` is free of rank one over a local ring `A`, then it is
generated by a single differential `d a`. This is how a free module of differentials of rank
one at a point of a curve gives a local coordinate whose differential generates it.

More generally, a family of `n` elements of a free module of rank `n` whose coordinates are
linearly independent over the residue field is a basis. Applied to the differentials of a local
ring, this changes coordinates.

A finite module `M` over a local ring `(R, 𝔪, k)` is the quotient of `R ^ μ`, with `μ` the
dimension of `k ⊗ M`, by a submodule of `𝔪 • R ^ μ`: lifting a `k`-basis of `k ⊗ M` gives
generators of `M` (Nakayama) whose relations all have coefficients in `𝔪`. Iterating such minimal
covers is how minimal free resolutions are built.

Over a possibly noncommutative local ring with Jacobson radical `J`, the ideal of nonunits, an
element of a projective module `M` is unimodular, that is some linear functional takes the value
`1` at it, exactly when it lies outside `J • M`. By Nakayama's lemma a finitely generated nonzero
`M` has such an element among any set of generators, and it spans a free direct summand.
Splitting off these summands one at a time shows that `M` is free.

## Main results

* `TauCeti.IsLocalRing.exists_mem_span_singleton_eq_top_of_finrank_eq_one`: a free module of
  rank one over a local ring is spanned by one element of any spanning set.
* `TauCeti.IsLocalRing.exists_basis_of_linearIndependent_residue_coord`: a family of `n`
  elements of a free module of rank `n` whose coordinates have linearly independent residues is a
  basis.
* `TauCeti.IsLocalRing.exists_surjective_ker_le_maximalIdeal_smul`: a finite module over a local
  ring `(R, 𝔪, k)` is a quotient of `R ^ dim_k (k ⊗ M)` by a submodule of `𝔪 • R ^ dim_k (k ⊗ M)`.
* `TauCeti.IsLocalRing.exists_linearMap_quotient_eq_one`: an element of a module `M` outside
  `𝔪 • M` is sent to `1` by a linear map `M → R ⧸ 𝔪`.
* `Module.isUnimodular_iff_notMem_jacobson_smul_top`: over a possibly noncommutative local ring,
  an element of a projective module `M` is unimodular exactly when it lies outside `J • M`.
* `Module.free_of_projective_of_isLocalRing`: a finitely generated projective module over a
  possibly noncommutative local ring is free, for any `AddCommMonoid` module.

## References

* The Stacks Project, Lemma 10.20.1 (00DV), for Nakayama's lemma in the form used here.
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter I, Lemma 2.2: finitely generated projective modules over a
  possibly noncommutative local ring are free.
-/

public section

open scoped TensorProduct

namespace TauCeti.IsLocalRing

variable {R M : Type*} [CommRing R] [_root_.IsLocalRing R] [AddCommGroup M] [Module R M]

/-- **A free module of rank one over a local ring is generated by one element of any spanning
set**: if `M` is free of rank one over the local ring `R` and `s` spans `M`, then some `m ∈ s`
spans `M`. -/
theorem exists_mem_span_singleton_eq_top_of_finrank_eq_one [Module.Free R M]
    (h : Module.finrank R M = 1) {s : Set M} (hs : Submodule.span R s = ⊤) :
    ∃ m ∈ s, Submodule.span R {m} = ⊤ := by
  obtain ⟨e⟩ := Module.nonempty_linearEquiv_of_finrank_eq_one h
  -- The coordinates `e.symm '' s` span the unit ideal of `R`, so they do not all lie in the
  -- maximal ideal: some `m ∈ s` has a unit coordinate, and then `m` spans `M`.
  have hspan : Submodule.span R (e.symm '' s) = ⊤ := by
    rw [Submodule.span_image_linearEquiv, hs, Submodule.map_top, LinearEquiv.range]
  obtain ⟨_, ⟨m, hm, rfl⟩, hu⟩ := Set.not_subset.mp fun hle ↦
    (_root_.IsLocalRing.maximalIdeal.isMaximal R).ne_top <|
      eq_top_iff.mpr (hspan ▸ Submodule.span_le.mpr hle)
  rw [SetLike.mem_coe, _root_.IsLocalRing.notMem_maximalIdeal] at hu
  exact ⟨m, hm, (Submodule.span_singleton_eq_top_iff R m).mpr fun v ↦
    ⟨e.symm v * hu.unit⁻¹, e.symm.injective (by simp [mul_assoc])⟩⟩

-- Adapted from roed-math/TauCeti-w2-fresh, lookahead/StableReduction/relative-ampleness,
-- commit efa6fc8f3735.
/-- **An element generates a module with one-dimensional fibre exactly when it does not vanish
in the fibre.** If `M` is a finite module over the local ring `R` with residue field `k` and
`k ⊗ M` is one-dimensional over `k`, for instance if `M` is free of rank one, then `m` spans `M` if
and only if `1 ⊗ m` is nonzero in `k ⊗ M`. -/
theorem span_singleton_eq_top_iff_one_tmul_ne_zero [Module.Finite R M]
    (h : Module.finrank (_root_.IsLocalRing.ResidueField R)
      (_root_.IsLocalRing.ResidueField R ⊗[R] M) = 1) (m : M) :
    Submodule.span R {m} = ⊤ ↔ (1 : _root_.IsLocalRing.ResidueField R) ⊗ₜ[R] m ≠ 0 := by
  -- By Nakayama, `m` spans `M` exactly when `1 ⊗ m` spans the one-dimensional fibre.
  rw [← _root_.IsLocalRing.map_tensorProduct_mk_eq_top, Submodule.map_span, Set.image_singleton,
    ← Submodule.restrictScalars_span R _ _root_.IsLocalRing.residue_surjective,
    Submodule.restrictScalars_eq_top_iff, TensorProduct.mk_apply]
  refine ⟨fun hs h0 ↦ ?_, fun h0 ↦ (finrank_eq_one_iff_of_ne_zero _ h0).mp h⟩
  have := Module.nontrivial_of_finrank_eq_succ h
  rw [h0, Submodule.span_zero_singleton] at hs
  exact bot_ne_top hs

/-- **A family with linearly independent residues is a basis.** If `M` has a basis `b` indexed by
`ι`, and `v` is a family of `|ι|` elements whose coordinates in `b`, read in the residue field,
are linearly independent, then `v` is a basis of `M`. -/
theorem exists_basis_of_linearIndependent_residue_coord {ι κ : Type*} [Fintype ι] [Fintype κ]
    (b : Module.Basis ι R M) {v : κ → M} (hcard : Fintype.card κ = Fintype.card ι)
    (h : LinearIndependent (_root_.IsLocalRing.ResidueField R)
      fun k i ↦ _root_.IsLocalRing.residue R (b.coord i (v k))) :
    ∃ b' : Module.Basis κ R M, ∀ k, b' k = v k := by
  classical
  let e : κ ≃ ι := Fintype.equivOfCardEq hcard
  -- The matrix of the family `v` in the basis `b`, with columns reindexed by `ι`.
  let A : Matrix ι ι R := Matrix.of fun i j ↦ b.coord i (v (e.symm j))
  have hA : IsUnit A.det := by
    have : IsUnit (A.map (_root_.IsLocalRing.residue R)) := by
      rw [← Matrix.linearIndependent_col_iff_isUnit]
      exact h.comp e.symm e.symm.injective
    rw [Matrix.isUnit_iff_isUnit_det, ← RingHom.mapMatrix_apply, ← RingHom.map_det] at this
    exact isUnit_of_map_unit (_root_.IsLocalRing.residue R) _ this
  refine ⟨(b.map (Matrix.toLinearEquiv b A hA)).reindex e.symm, fun k ↦ ?_⟩
  simp [A, Matrix.toLin_self, Module.Basis.sum_repr]

variable (R M) in
/-- **Minimal generators of a finite module over a local ring.** If `M` is a finite module over a
local ring `(R, 𝔪, k)`, then `M` is the image of a surjection `R ^ μ → M`, with `μ = dim_k (k ⊗ M)`
the minimal number of generators of `M`, whose kernel is contained in `𝔪 • R ^ μ`. -/
theorem exists_surjective_ker_le_maximalIdeal_smul [Module.Finite R M] :
    ∃ f : (Fin (Module.finrank (_root_.IsLocalRing.ResidueField R)
        (_root_.IsLocalRing.ResidueField R ⊗[R] M)) → R) →ₗ[R] M,
      Function.Surjective f ∧ LinearMap.ker f ≤ _root_.IsLocalRing.maximalIdeal R • ⊤ := by
  classical
  let b := Module.finBasis (_root_.IsLocalRing.ResidueField R)
    (_root_.IsLocalRing.ResidueField R ⊗[R] M)
  choose v hv using fun j ↦ TensorProduct.mk_surjective R M (_root_.IsLocalRing.ResidueField R)
    Ideal.Quotient.mk_surjective (b j)
  refine ⟨Fintype.linearCombination R v, ?_, fun x hx ↦ ?_⟩
  · rw [← LinearMap.range_eq_top, Fintype.range_linearCombination]
    exact _root_.IsLocalRing.span_eq_top_of_tmul_eq_basis v b hv
  -- A relation among the `v j` maps to a relation among the basis vectors `1 ⊗ v j` of `k ⊗ M`,
  -- whose coefficients are the residues of its coordinates; so these coordinates lie in `𝔪`.
  have hx' : ∑ j, _root_.IsLocalRing.residue R (x j) • b j = 0 := by
    simp_rw [← hv, TensorProduct.mk_apply, ← _root_.IsLocalRing.ResidueField.algebraMap_eq,
      algebraMap_smul, ← TensorProduct.tmul_smul, ← TensorProduct.tmul_sum]
    rw [← Fintype.linearCombination_apply, LinearMap.mem_ker.mp hx, TensorProduct.tmul_zero]
  have hres := Fintype.linearIndependent_iff.mp b.linearIndependent _ hx'
  rw [pi_eq_sum_univ x]
  exact Submodule.sum_mem _ fun j _ ↦ Submodule.smul_mem_smul
    ((_root_.IsLocalRing.residue_eq_zero_iff _).mp (hres j)) Submodule.mem_top

universe u v in
/-- A finite module over a local ring is a quotient of a finite free module, with free module in
the universe of the module, by a submodule contained in `𝔪 • ⊤`. -/
theorem exists_surjective_ker_le_maximalIdeal_smul_shrink {R : Type u} [CommRing R]
    [_root_.IsLocalRing R] [Small.{v} R] (M : Type v) [AddCommGroup M] [Module R M]
    [Module.Finite R M] :
    ∃ (n : ℕ) (g : (Fin n → Shrink.{v} R) →ₗ[R] M),
      Function.Surjective g ∧ LinearMap.ker g ≤ _root_.IsLocalRing.maximalIdeal R • ⊤ := by
  obtain ⟨f, hf, hfker⟩ := exists_surjective_ker_le_maximalIdeal_smul R M
  -- Precompose `f` with the coordinatewise linear equivalence `Shrink R ≃ₗ[R] R`, whose index
  -- type is read off from the domain of `f`.
  refine ⟨_, f ∘ₗ (LinearEquiv.piCongrRight fun _ ↦ Shrink.linearEquiv.{v} R R).toLinearMap,
    hf.comp (LinearEquiv.surjective _), ?_⟩
  rw [LinearMap.ker_comp, Submodule.comap_equiv_eq_map_symm]
  refine (Submodule.map_mono hfker).trans ?_
  rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]

/-- **An element of a module over a local ring outside `𝔪 • M` is sent to `1` by a linear map to
the residue field**, since its class in the vector space `M ⧸ 𝔪 • M` is nonzero. -/
theorem exists_linearMap_quotient_eq_one {m : M}
    (hm : m ∉ _root_.IsLocalRing.maximalIdeal R • (⊤ : Submodule R M)) :
    ∃ r : M →ₗ[R] R ⧸ _root_.IsLocalRing.maximalIdeal R, r m = 1 := by
  let : Field (R ⧸ _root_.IsLocalRing.maximalIdeal R) := Ideal.Quotient.field _
  have hx : (Submodule.Quotient.mk m : M ⧸ _root_.IsLocalRing.maximalIdeal R • (⊤ : Submodule R M))
      ≠ 0 := by
    rwa [Ne, Submodule.Quotient.mk_eq_zero]
  obtain ⟨φ, hφ⟩ :=
    Module.Projective.exists_dual_eq_one (R ⧸ _root_.IsLocalRing.maximalIdeal R) hx
  exact ⟨(φ.restrictScalars R) ∘ₗ Submodule.mkQ _, hφ⟩

/-- A scalar killing a nonzero element lies in the maximal ideal, since a unit kills only zero.
This holds for any distributive action of a local semiring on an additive monoid, in particular
for a module over a local ring. -/
theorem mem_maximalIdeal_of_smul_eq_zero {R M : Type*} [CommSemiring R] [_root_.IsLocalRing R]
    [AddMonoid M] [DistribMulAction R M] {m : M} (hm : m ≠ 0) {r : R} (h : r • m = 0) :
    r ∈ _root_.IsLocalRing.maximalIdeal R := by
  by_contra hr
  exact hm (((_root_.IsLocalRing.notMem_maximalIdeal.mp hr).smul_eq_zero).mp h)

end TauCeti.IsLocalRing

namespace Module

section Noncommutative

variable {R : Type*} [Ring R] [IsLocalRing R]

/-- In a projective module over a possibly noncommutative local ring, an element is unimodular,
that is some linear functional takes the value `1` at it, exactly when it lies outside
`J • M` for the Jacobson radical `J` of `R`, the ideal of nonunits. -/
theorem isUnimodular_iff_notMem_jacobson_smul_top {M : Type*} [AddCommMonoid M] [Module R M]
    [Module.Projective R M] {m : M} :
    IsUnimodular R m ↔ m ∉ Ring.jacobson R • (⊤ : Submodule R M) := by
  rw [isUnimodular_iff, ← forall_dual_apply_mem_iff, not_forall]
  refine ⟨fun ⟨φ, hφ⟩ ↦ ⟨φ, by simp [hφ, TauCeti.IsLocalRing.mem_jacobson_iff_not_isUnit]⟩,
    fun ⟨φ, hφ⟩ ↦ ?_⟩
  -- `φ m` is a unit `u`; rescaling `φ` on the right by `u⁻¹` gives the value `1`.
  obtain ⟨u, hu⟩ := not_not.mp (TauCeti.IsLocalRing.mem_jacobson_iff_not_isUnit.not.mp hφ)
  exact ⟨LinearMap.toSpanSingleton R R (↑u⁻¹ : R) ∘ₗ φ, by simp [← hu]⟩

/-- A projective module over a local ring spanned by at most `n` elements is free. -/
private theorem free_of_span_finset_eq_top (n : ℕ) :
    ∀ {M : Type*} [AddCommGroup M] [Module R M] [Module.Projective R M] (s : Finset M),
      s.card ≤ n → Submodule.span R (s : Set M) = ⊤ → Module.Free R M := by
  -- Induction on `n`: by Nakayama's lemma some generator `p` lies outside `J • M`, so it spans a
  -- free summand `R`; its complement is projective and spanned by the projections of the other
  -- generators.
  classical
  induction n with
  | zero =>
    intro M _ _ _ s hs hspan
    rw [Finset.card_eq_zero.mp (Nat.le_zero.mp hs), Finset.coe_empty, Submodule.span_empty]
      at hspan
    have : Subsingleton M :=
      (Submodule.subsingleton_iff R).mp (subsingleton_iff_bot_eq_top.mp hspan)
    infer_instance
  | succ n ih =>
    intro M _ _ _ s hs hspan
    rcases subsingleton_or_nontrivial M with _ | _
    · infer_instance
    obtain ⟨p, hps, hp⟩ : ∃ p ∈ s, p ∉ Ring.jacobson R • (⊤ : Submodule R M) := by
      by_contra! h
      have hle : Submodule.span R (s : Set M) ≤ Ring.jacobson R • ⊤ := Submodule.span_le.mpr h
      rw [hspan] at hle
      exact (Submodule.FG.jacobson_smul_lt top_ne_bot ⟨s, hspan⟩).not_ge hle
    obtain ⟨φ, hφ⟩ := isUnimodular_iff.mp (isUnimodular_iff_notMem_jacobson_smul_top.mpr hp)
    -- `M ≃ ker φ × R`, and `ker φ` is spanned by the images of `s.erase p` under the projection.
    let e := LinearMap.kerProdEquivOfApplyEqOne hφ
    let π : M →ₗ[R] LinearMap.ker φ := LinearMap.fst R _ R ∘ₗ e.symm.toLinearMap
    have hπ : Function.Surjective π := Prod.fst_surjective.comp e.symm.surjective
    have hπp : π p = 0 := Subtype.ext (by simp [π, e, hφ])
    have : Module.Projective R (LinearMap.ker φ) :=
      .of_split (LinearMap.ker φ).subtype π (LinearMap.ext fun x ↦ Subtype.ext (by simp [π, e]))
    have : Module.Free R (LinearMap.ker φ) := by
      refine ih ((s.erase p).image π) (Finset.card_image_le.trans ?_) ?_
      · rw [Finset.card_erase_of_mem hps]
        omega
      · -- `π` maps `span s = M` onto `ker φ`, and dropping `p` loses nothing since `π p = 0`.
        rw [eq_top_iff, ← LinearMap.range_eq_top.mpr hπ, LinearMap.range_eq_map, ← hspan,
          Submodule.map_span_le]
        intro x hx
        by_cases hxp : x = p
        · simp [hxp, hπp]
        · exact Submodule.subset_span <| Finset.mem_coe.mpr <|
            Finset.mem_image_of_mem π (Finset.mem_erase.mpr ⟨hxp, Finset.mem_coe.mp hx⟩)
    exact .of_equiv e

/-- **Finitely generated projective modules over a local ring are free**, for a possibly
noncommutative local ring and any `AddCommMonoid` module. For a commutative local ring this is
also `Module.free_of_flat_of_isLocalRing`. -/
theorem free_of_projective_of_isLocalRing {M : Type*} [AddCommMonoid M] [Module R M]
    [Module.Finite R M] [Module.Projective R M] : Module.Free R M :=
  let _ := Module.addCommMonoidToAddCommGroup R (M := M)
  let ⟨s, hs⟩ := Module.Finite.fg_top (R := R) (M := M)
  free_of_span_finset_eq_top s.card s le_rfl hs

end Noncommutative

end Module
