module

public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import TauCeti.RingTheory.LocalRing.ResidueField.Extension
import TauCeti.RingTheory.AdicCompletion.Flat.LocalRing
import TauCeti.RingTheory.AdicCompletion.LocalRing

/-!
# Completed local extensions with prescribed residue field extension

Completing `TauCeti.IsLocalRing.ResidueExtension R L` along its maximal ideal produces a complete
faithfully flat Noetherian local `R`-algebra `CompletedResidueExtension R L` over any Noetherian
local ring `R` and any field extension `L` of `ResidueField R` (*ÉGA III*, Chap. 0, Proposition
10.3.1, completion remark). Its maximal ideal is generated by `maximalIdeal R` and its residue
field is canonically `ResidueField R`-isomorphic to `L`.

## Main definitions and results

* `TauCeti.IsLocalRing.CompletedResidueExtension R L`: the maximal-ideal completion of
  `ResidueExtension R L`.
* `TauCeti.IsLocalRing.CompletedResidueExtension.instIsNoetherianRing`,
  `TauCeti.IsLocalRing.CompletedResidueExtension.instIsLocalRing`,
  `TauCeti.IsLocalRing.CompletedResidueExtension.instIsAdicComplete`: over a Noetherian local base
  `R`, `CompletedResidueExtension R L` is a Noetherian complete local ring.
* `TauCeti.IsLocalRing.CompletedResidueExtension.maximalIdeal_eq_map`: over a Noetherian local base
  `R`, the maximal ideal of `CompletedResidueExtension R L` is generated by `maximalIdeal R`.
* `TauCeti.IsLocalRing.CompletedResidueExtension.instFlat`,
  `TauCeti.IsLocalRing.CompletedResidueExtension.instFaithfullyFlat`: over a Noetherian local base
  `R`, `CompletedResidueExtension R L` is flat and faithfully flat over `R`.
* `TauCeti.IsLocalRing.CompletedResidueExtension.residueFieldEquiv`: canonical `ResidueField R`-
  algebra isomorphism `ResidueField (CompletedResidueExtension R L) ≃ₐ[ResidueField R] L`, together
  with `@[simp]` lemmas `residueFieldEquiv_map`, `residueFieldEquiv_residue_algebraMap`, and
  `residueFieldEquiv_symm_apply`.
* `TauCeti.IsLocalRing.CompletedResidueExtension.instIsAlgClosedResidueField`: when `L` is
  algebraically closed, so is `ResidueField (CompletedResidueExtension R L)`.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique III*, Chapitre 0,
  Proposition 10.3.1.
-/

public section

noncomputable section

universe u v

open IsLocalRing

namespace TauCeti.IsLocalRing

/-- The maximal-ideal adic completion of `ResidueExtension R L`. Over a Noetherian local ring `R`
this is a complete Noetherian faithfully flat local `R`-algebra with residue field `L` and maximal
ideal generated by `maximalIdeal R`. -/
abbrev CompletedResidueExtension (R : Type u) [CommRing R] [IsLocalRing R]
    (L : Type v) [Field L] [Algebra (ResidueField R) L] : Type (max u v) :=
  AdicCompletion (maximalIdeal (ResidueExtension R L)) (ResidueExtension R L)

namespace CompletedResidueExtension

variable (R : Type u) [CommRing R] [IsLocalRing R]
variable (L : Type v) [Field L] [Algebra (ResidueField R) L]

/-- If `maximalIdeal R` is finitely generated, `CompletedResidueExtension R L` is Noetherian. -/
theorem isNoetherianRing_of_fg (hR : (maximalIdeal R).FG) :
    IsNoetherianRing (CompletedResidueExtension R L) :=
  IsLocalRing.isNoetherianRing_adicCompletion_of_fg (ResidueExtension.maximalIdeal_fg R L hR)

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is Noetherian. -/
instance instIsNoetherianRing [IsNoetherianRing R] :
    IsNoetherianRing (CompletedResidueExtension R L) :=
  isNoetherianRing_of_fg R L (maximalIdeal R).fg_of_isNoetherianRing

/-- If `maximalIdeal R` is finitely generated, `CompletedResidueExtension R L` is a local ring. -/
theorem isLocalRing_of_fg (hR : (maximalIdeal R).FG) :
    IsLocalRing (CompletedResidueExtension R L) :=
  AdicCompletion.isLocalRing_of_fg (ResidueExtension.maximalIdeal_fg R L hR)

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is a local ring. -/
instance instIsLocalRing [IsNoetherianRing R] :
    IsLocalRing (CompletedResidueExtension R L) :=
  isLocalRing_of_fg R L (maximalIdeal R).fg_of_isNoetherianRing

/-- Over a Noetherian local base `R`, the completion map from `ResidueExtension R L` is local. -/
instance instIsLocalHom_residueExtension [IsNoetherianRing R] :
    IsLocalHom (algebraMap (ResidueExtension R L) (CompletedResidueExtension R L)) :=
  AdicCompletion.algebraMap_isLocalHom_of_fg
    (ResidueExtension.maximalIdeal_fg R L (maximalIdeal R).fg_of_isNoetherianRing)

/-- Over a Noetherian local base `R`, the maximal ideal of `CompletedResidueExtension R L` is
generated by `maximalIdeal R`. -/
theorem maximalIdeal_eq_map [IsNoetherianRing R] :
    maximalIdeal (CompletedResidueExtension R L) =
      (maximalIdeal R).map (algebraMap R (CompletedResidueExtension R L)) :=
  TauCeti.AdicCompletion.maximalIdeal_eq_map_base_of_map_maximalIdeal_eq
    (maximalIdeal R).fg_of_isNoetherianRing (ResidueExtension.maximalIdeal_eq_map R L).symm

/-- Over a Noetherian local base `R`, the structure map `R → CompletedResidueExtension R L` is a
local homomorphism. -/
instance instIsLocalHom [IsNoetherianRing R] :
    IsLocalHom (algebraMap R (CompletedResidueExtension R L)) :=
  TauCeti.AdicCompletion.isLocalHom_algebraMap_base_of_map_maximalIdeal_eq
    (maximalIdeal R).fg_of_isNoetherianRing (ResidueExtension.maximalIdeal_eq_map R L).symm

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is adically complete with
respect to its maximal ideal. -/
instance instIsAdicComplete [IsNoetherianRing R] :
    IsAdicComplete (maximalIdeal (CompletedResidueExtension R L))
      (CompletedResidueExtension R L) :=
  AdicCompletion.isAdicComplete_of_fg
    (ResidueExtension.maximalIdeal_fg R L (maximalIdeal R).fg_of_isNoetherianRing)

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is flat over `R`. -/
instance instFlat [IsNoetherianRing R] :
    Module.Flat R (CompletedResidueExtension R L) :=
  TauCeti.AdicCompletion.flat_of_map_maximalIdeal_eq
    (ResidueExtension.maximalIdeal_eq_map R L).symm

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is faithfully flat over `R`.
-/
instance instFaithfullyFlat [IsNoetherianRing R] :
    Module.FaithfullyFlat R (CompletedResidueExtension R L) :=
  Module.FaithfullyFlat.of_flat_of_isLocalHom

/-- Canonical `ResidueField R`-algebra isomorphism
`ResidueField (CompletedResidueExtension R L) ≃ₐ[ResidueField R] L`. -/
def residueFieldEquiv [IsNoetherianRing R] :
    ResidueField (CompletedResidueExtension R L) ≃ₐ[ResidueField R] L :=
  (TauCeti.AdicCompletion.residueFieldAlgEquivOfFG R
    (ResidueExtension.maximalIdeal_fg R L (maximalIdeal R).fg_of_isNoetherianRing)).symm.trans
    (ResidueExtension.residueFieldEquiv R L)

/-- `residueFieldEquiv R L` commutes with `ResidueExtension.residueFieldEquiv R L` along the
residue field map induced by completion. -/
@[simp]
theorem residueFieldEquiv_map [IsNoetherianRing R]
    (x : ResidueField (ResidueExtension R L)) :
    residueFieldEquiv R L
        (ResidueField.map (algebraMap (ResidueExtension R L) (CompletedResidueExtension R L)) x) =
      ResidueExtension.residueFieldEquiv R L x := by
  simp [residueFieldEquiv]

/-- Evaluating `residueFieldEquiv R L` on the residue class of an element coming from
`ResidueExtension R L` agrees with `ResidueExtension.residueFieldEquiv R L`. -/
@[simp]
theorem residueFieldEquiv_residue_algebraMap [IsNoetherianRing R] (a : ResidueExtension R L) :
    residueFieldEquiv R L
        (residue (CompletedResidueExtension R L)
          (algebraMap (ResidueExtension R L) (CompletedResidueExtension R L) a)) =
      ResidueExtension.residueFieldEquiv R L (residue (ResidueExtension R L) a) := by
  rw [← ResidueField.map_residue, residueFieldEquiv_map]

/-- The inverse of `residueFieldEquiv R L` pushes `(ResidueExtension.residueFieldEquiv R L).symm`
forward along the completion map on residue fields. -/
@[simp]
theorem residueFieldEquiv_symm_apply [IsNoetherianRing R] (x : L) :
    (residueFieldEquiv R L).symm x =
      ResidueField.map (algebraMap (ResidueExtension R L) (CompletedResidueExtension R L))
        ((ResidueExtension.residueFieldEquiv R L).symm x) :=
  (residueFieldEquiv R L).injective
    (by rw [AlgEquiv.apply_symm_apply, residueFieldEquiv_map, AlgEquiv.apply_symm_apply])

/-- When `L` is algebraically closed, so is `ResidueField (CompletedResidueExtension R L)`. -/
instance instIsAlgClosedResidueField [IsNoetherianRing R] [IsAlgClosed L] :
    IsAlgClosed (ResidueField (CompletedResidueExtension R L)) :=
  IsAlgClosed.of_ringEquiv _ _
    (TauCeti.AdicCompletion.residueFieldEquivOfFG
      (ResidueExtension.maximalIdeal_fg R L (maximalIdeal R).fg_of_isNoetherianRing))

end CompletedResidueExtension

end TauCeti.IsLocalRing
