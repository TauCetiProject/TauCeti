/-!
# Flat local extensions with prescribed residue field extension

Let `R` be a local ring with maximal ideal `𝔪` and residue field `k`, and let `L` be any field
extension of `k`. Following Grothendieck and Dieudonné (*ÉGA III*, Chap. 0, Proposition 10.3.1),
this file constructs a faithfully flat local `R`-algebra `ResidueExtension R L` such that `𝔪`
generates the maximal ideal of `ResidueExtension R L` and the residue field of
`ResidueExtension R L` is isomorphic to `L` as a `k`-algebra. Neither Noetherianity of `R` nor
algebraicity, finiteness, or separability of `L / k` is assumed.

The construction proceeds in two stages:

1. **Purely transcendental stage.** Choosing a transcendence basis `s` of `L` over `k`, we localize
   the polynomial ring `MvPolynomial s R` at the prime ideal `𝔪[s]` generated by `𝔪`. Because `s`
   is algebraically independent over `k`, `𝔪[s]` is the kernel of evaluation into `L`, so `L`
   becomes an algebraic extension of the residue field of this localization.
2. **Algebraic Zorn stage.** Over a local ring whose residue field has `L` as an algebraic
   extension, we apply Zorn's lemma to flat integral quotients `MvPolynomial c R ⧸ I` (`c ⊆ L`)
   whose evaluation into `L` has kernel generated by `𝔪`. Every such quotient is automatically a
   local ring because its image in `L` is an algebraic `k`-subalgebra of a field, hence a field,
   and integrality forces uniqueness of the maximal ideal. Chains pass to the union by the
   equational criterion for flatness, and a stage missing `a ∈ L` extends by `AdjoinRoot g` for a
   monic lift `g` of the minimal polynomial of `a` over its residue field.

## Main definitions and results

* `TauCeti.IsLocalRing.ResidueExtension R L`: a local `R`-algebra realizing the residue field
  extension `L / ResidueField R`.
* `TauCeti.IsLocalRing.ResidueExtension.instFlat`,
  `TauCeti.IsLocalRing.ResidueExtension.instFaithfullyFlat`: `ResidueExtension R L` is flat and
  faithfully flat over `R`.
* `TauCeti.IsLocalRing.ResidueExtension.maximalIdeal_eq_map`: the maximal ideal of
  `ResidueExtension R L` is generated by `maximalIdeal R`.
* `TauCeti.IsLocalRing.ResidueExtension.residueFieldEquiv`: `ResidueField R`-algebra isomorphism
  `ResidueField (ResidueExtension R L) ≃ₐ[ResidueField R] L`.
* `TauCeti.IsLocalRing.ResidueExtension.instIsAlgClosedResidueField`: when `L` is algebraically
  closed, so is `ResidueField (ResidueExtension R L)`.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique III*, Chapitre 0,
  Proposition 10.3.1.
-/

public section

noncomputable section

universe u v w

open IsLocalRing Polynomial

namespace TauCeti.IsLocalRing

/-! ### Stage 1: Purely transcendental localization -/

section Transcendental

variable (R : Type u) [CommRing R] [IsLocalRing R]
variable {L : Type v} [Field L] [Algebra (ResidueField R) L]
variable {σ : Type w} (ι : σ → L)

/-- Evaluation `MvPolynomial σ R →+* L` sending scalars through `residue R` and variables via `ι`.
-/
private def mvEval : MvPolynomial σ R →+* L :=
  MvPolynomial.eval₂Hom ((algebraMap (ResidueField R) L).comp (residue R)) ι

private lemma mvEval_eq_comp :
    mvEval R ι = (MvPolynomial.aeval ι).toRingHom.comp (MvPolynomial.map (residue R)) := by
  ext <;> simp [mvEval]

/-- Prime kernel of `mvEval R ι`. -/
private abbrev kerMvEval : Ideal (MvPolynomial σ R) :=
  RingHom.ker (mvEval R ι)

private instance : (kerMvEval R ι).IsPrime :=
  RingHom.ker_isPrime _

/-- When `ι` is algebraically independent over `ResidueField R`, the kernel of `mvEval R ι` is
generated by `maximalIdeal R`. -/
private lemma kerMvEval_eq_map_maximalIdeal (hι : AlgebraicIndependent (ResidueField R) ι) :
    kerMvEval R ι = (maximalIdeal R).map MvPolynomial.C := by
  rw [kerMvEval, mvEval_eq_comp, ← RingHom.comap_ker]
  have hker : RingHom.ker (MvPolynomial.aeval ι).toRingHom = ⊥ :=
    (RingHom.injective_iff_ker_eq_bot _).mp hι
  rw [hker, ← RingHom.ker_eq_comap_bot, MvPolynomial.ker_map, ker_residue]

/-- The localization of `MvPolynomial σ R` at the prime kernel of `mvEval R ι`. -/
private abbrev TranscendentalExt :=
  Localization.AtPrime (kerMvEval R ι)

private instance : Module.Flat R (TranscendentalExt R ι) :=
  Module.Flat.trans R (MvPolynomial σ R) (TranscendentalExt R ι)

private lemma transcendentalExt_maximalIdeal_eq_map
    (hι : AlgebraicIndependent (ResidueField R) ι) :
    maximalIdeal (TranscendentalExt R ι) =
      (maximalIdeal R).map (algebraMap R (TranscendentalExt R ι)) := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal]
  refine (congrArg (Ideal.map (algebraMap (MvPolynomial σ R) (TranscendentalExt R ι)))
    (kerMvEval_eq_map_maximalIdeal R ι hι)).trans ?_
  rw [Ideal.map_map, ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_eq]

/-- Evaluation `TranscendentalExt R ι →+* L` induced by universal property of localization. -/
private def transcendentalExtToField : TranscendentalExt R ι →+* L :=
  IsLocalization.lift (M := (kerMvEval R ι).primeCompl) (g := mvEval R ι) fun y ↦
    IsUnit.mk0 _ (mt RingHom.mem_ker.mpr (Ideal.mem_primeCompl_iff.mp y.property))

private instance : IsLocalHom (transcendentalExtToField R ι) :=
  IsLocalization.AtPrime.isLocalHom_lift (kerMvEval R ι) _ <| by
    rw [maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot]

/-- `L` as an algebra over `ResidueField (TranscendentalExt R ι)`. -/
private abbrev transcendentalExtResidueAlgebra :
    Algebra (ResidueField (TranscendentalExt R ι)) L :=
  (ResidueField.lift (transcendentalExtToField R ι)).toAlgebra

private lemma transcendentalExt_isScalarTower
    [IsLocalHom (algebraMap R (TranscendentalExt R ι))] :
    let _ := transcendentalExtResidueAlgebra R ι
    IsScalarTower (ResidueField R) (ResidueField (TranscendentalExt R ι)) L := by
  intro _
  refine IsScalarTower.of_algebraMap_eq fun x ↦ ?_
  obtain ⟨r, rfl⟩ := residue_surjective x
  rw [RingHom.algebraMap_toAlgebra, ResidueField.algebraMap_residue,
    ResidueField.lift_residue_apply,
    IsScalarTower.algebraMap_apply R (MvPolynomial σ R) (TranscendentalExt R ι),
    transcendentalExtToField, IsLocalization.lift_eq]
  simp [mvEval, MvPolynomial.algebraMap_eq]

/-- When `ι` is a transcendence basis of `L` over `ResidueField R`, `L` is algebraic over the
residue field of `TranscendentalExt R ι`. -/
private lemma transcendentalExt_isAlgebraic (hι : IsTranscendenceBasis (ResidueField R) ι) :
    let _ := transcendentalExtResidueAlgebra R ι
    Algebra.IsAlgebraic (ResidueField (TranscendentalExt R ι)) L := by
  intro _
  have _ : IsLocalHom (algebraMap R (TranscendentalExt R ι)) :=
    ((local_hom_tfae _).out 1 3).mpr (transcendentalExt_maximalIdeal_eq_map R ι hι.1).ge
  have _ := transcendentalExt_isScalarTower R ι
  refine (hι.isAlgebraic_iff (S := ResidueField (TranscendentalExt R ι))).mpr fun i ↦ ?_
  have hi : ι i = algebraMap (ResidueField (TranscendentalExt R ι)) L
      (residue _ (algebraMap (MvPolynomial σ R) _ (MvPolynomial.X i))) := by
    rw [RingHom.algebraMap_toAlgebra, ResidueField.lift_residue_apply,
      transcendentalExtToField, IsLocalization.lift_eq]
    simp [mvEval]
  rw [hi]
  exact isAlgebraic_algebraMap _

end Transcendental

/-! ### Stage 2: Algebraic Zorn construction -/

section Algebraic

variable (R : Type w) [CommRing R] [IsLocalRing R]
variable (L : Type v) [Field L] [Algebra (ResidueField R) L]

/-- Poset of flat integral quotients `MvPolynomial c R ⧸ I` (`c ⊆ L`) whose evaluation into `L`
has kernel generated over `I` by `maximalIdeal R`. -/
private structure AlgStage where
  carrier : Set L
  ideal : Ideal (MvPolynomial carrier R)
  le_ker : ideal ≤ RingHom.ker (mvEval R ((↑) : carrier → L))
  ker_le : RingHom.ker (mvEval R ((↑) : carrier → L)) ≤
    ideal ⊔ (maximalIdeal R).map MvPolynomial.C
  flat : Module.Flat R (MvPolynomial carrier R ⧸ ideal)
  isIntegral : Algebra.IsIntegral R (MvPolynomial carrier R ⧸ ideal)

namespace AlgStage

variable {R L}

/-- Quotient ring attached to an algebraic stage. -/
private abbrev Quot (s : AlgStage R L) := MvPolynomial s.carrier R ⧸ s.ideal

private instance (s : AlgStage R L) : Module.Flat R s.Quot := s.flat
private instance (s : AlgStage R L) : Algebra.IsIntegral R s.Quot := s.isIntegral

/-- Evaluation from `s.Quot` into `L`. -/
private def evalQuot (s : AlgStage R L) : s.Quot →+* L :=
  Ideal.Quotient.lift s.ideal (mvEval R ((↑) : s.carrier → L)) fun _ ha ↦
    RingHom.mem_ker.mp (s.le_ker ha)

@[simp]
private lemma evalQuot_mk (s : AlgStage R L) (p : MvPolynomial s.carrier R) :
    s.evalQuot (Ideal.Quotient.mk s.ideal p) = mvEval R ((↑) : s.carrier → L) p :=
  Ideal.Quotient.lift_mk s.ideal _ _

@[simp]
private lemma evalQuot_algebraMap (s : AlgStage R L) (r : R) :
    s.evalQuot (algebraMap R s.Quot r) = algebraMap (ResidueField R) L (residue R r) := by
  rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, evalQuot_mk]
  simp [mvEval]

private lemma ker_evalQuot_eq_map_maximalIdeal (s : AlgStage R L) :
    RingHom.ker s.evalQuot = (maximalIdeal R).map (algebraMap R s.Quot) := by
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.map_le_iff_le_comap.mpr fun r hr ↦ ?_)
  · obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨q, hq, m, hm, rfl⟩ := Submodule.mem_sup.mp (s.ker_le hx)
    rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hq, zero_add]
    have hmap : ((maximalIdeal R).map MvPolynomial.C).map (Ideal.Quotient.mk s.ideal) =
        (maximalIdeal R).map (algebraMap R s.Quot) := by
      rw [Ideal.map_map, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_comp_algebraMap]
    rw [← hmap]
    exact Ideal.mem_map_of_mem _ hm
  · rw [Ideal.mem_comap, RingHom.mem_ker, evalQuot_algebraMap,
      (residue_eq_zero_iff r).mpr hr, map_zero]

private lemma range_evalQuot (s : AlgStage R L) :
    Set.range s.evalQuot = (Algebra.adjoin (ResidueField R) s.carrier : Set L) := by
  have hsurj : Function.Surjective (Ideal.Quotient.mk s.ideal) := Ideal.Quotient.mk_surjective
  have h1 : Set.range s.evalQuot = Set.range (mvEval R ((↑) : s.carrier → L)) := by
    rw [← hsurj.range_comp, ← RingHom.coe_comp, evalQuot, Ideal.Quotient.lift_comp_mk]
  have h2 : Function.Surjective (MvPolynomial.map (residue R) :
      MvPolynomial s.carrier R →+* MvPolynomial s.carrier (ResidueField R)) :=
    MvPolynomial.map_surjective _ residue_surjective
  rw [h1, mvEval_eq_comp, RingHom.coe_comp, h2.range_comp, AlgHom.toRingHom_eq_coe,
    AlgHom.coe_toRingHom, ← AlgHom.coe_range, ← Algebra.adjoin_eq_range]

/-- When `L` is algebraic over `ResidueField R`, `(maximalIdeal R).map (algebraMap R s.Quot)` is
maximal in `s.Quot`. -/
private lemma isMaximal_map_maximalIdeal_quot [Algebra.IsAlgebraic (ResidueField R) L]
    (s : AlgStage R L) :
    ((maximalIdeal R).map (algebraMap R s.Quot)).IsMaximal := by
  let Ks : Subalgebra (ResidueField R) L := Algebra.adjoin (ResidueField R) s.carrier
  let _ : Field Ks := (Subalgebra.isField_of_algebraic Ks).toField
  let ψ₀ : s.Quot →+* Ks := s.evalQuot.codRestrict Ks.toSubring fun x ↦ by
    rw [Subalgebra.mem_toSubring, ← SetLike.mem_coe, ← range_evalQuot]
    exact ⟨x, rfl⟩
  have hsurj : Function.Surjective ψ₀ := fun y ↦ by
    have hy : (y : L) ∈ Set.range s.evalQuot := by
      rw [range_evalQuot]
      exact y.property
    obtain ⟨x, hx⟩ := hy
    exact ⟨x, Subtype.ext hx⟩
  have hker : RingHom.ker ψ₀ = (maximalIdeal R).map (algebraMap R s.Quot) := by
    rw [← ker_evalQuot_eq_map_maximalIdeal]
    ext x
    simp [ψ₀, Subtype.ext_iff]
  exact hker ▸ RingHom.ker_isMaximal_of_surjective ψ₀ hsurj

/-- When `L` is algebraic over `ResidueField R`, `s.Quot` is a local ring. -/
private instance instIsLocalRingQuot [Algebra.IsAlgebraic (ResidueField R) L] (s : AlgStage R L) :
    IsLocalRing s.Quot :=
  have hmax := s.isMaximal_map_maximalIdeal_quot
  .of_unique_max_ideal ⟨_, hmax, fun _ hM ↦
    (hmax.eq_of_le hM.ne_top (map_maximalIdeal_le_of_isMaximal hM)).symm⟩

private lemma maximalIdeal_quot_eq_map [Algebra.IsAlgebraic (ResidueField R) L]
    (s : AlgStage R L) :
    maximalIdeal s.Quot = (maximalIdeal R).map (algebraMap R s.Quot) :=
  (eq_maximalIdeal s.isMaximal_map_maximalIdeal_quot).symm

/-- Partial order on `AlgStage R L`: inclusion of carriers with compatible ideals. -/
private instance : PartialOrder (AlgStage R L) where
  le s₁ s₂ := ∃ h : s₁.carrier ⊆ s₂.carrier,
    s₂.ideal.comap (MvPolynomial.rename (Set.inclusion h)).toRingHom = s₁.ideal
  le_refl s := ⟨Set.Subset.rfl, by
    simp [Set.inclusion_eq_id, MvPolynomial.rename_id]⟩
  le_trans s₁ s₂ s₃ := by
    rintro ⟨h₁₂, hi₁₂⟩ ⟨h₂₃, hi₂₃⟩
    refine ⟨h₁₂.trans h₂₃, ?_⟩
    simp only [← hi₁₂, ← hi₂₃, Ideal.comap_comap, AlgHom.toRingHom_eq_coe,
      ← AlgHom.comp_toRingHom, MvPolynomial.rename_comp_rename, Set.inclusion_comp_inclusion]
  le_antisymm := by
    rintro ⟨c₁, I₁, h1, h2, h3, h4⟩ ⟨c₂, I₂, g1, g2, g3, g4⟩ ⟨h₁₂, hi₁₂⟩ ⟨h₂₁, _⟩
    obtain rfl : c₁ = c₂ := Set.Subset.antisymm h₁₂ h₂₁
    have hI : I₂ = I₁ := by
      simpa [Set.inclusion_eq_id, MvPolynomial.rename_id] using hi₁₂
    subst hI
    rfl

private lemma mem_ideal_iff_of_le {s₁ s₂ : AlgStage R L} (h : s₁ ≤ s₂)
    (p : MvPolynomial s₁.carrier R) :
    MvPolynomial.rename (Set.inclusion h.choose) p ∈ s₂.ideal ↔ p ∈ s₁.ideal :=
  Ideal.ext_iff.mp h.choose_spec p

/-- Base stage with empty carrier and zero ideal, isomorphic to `R`. -/
private def base : AlgStage R L := by
  let e := (AlgEquiv.quotientBot R (MvPolynomial (∅ : Set L) R)).trans
    (MvPolynomial.isEmptyAlgEquiv R (∅ : Set L))
  refine
    { carrier := ∅
      ideal := ⊥
      le_ker := bot_le
      ker_le := fun p hp ↦ ?_
      flat := Module.Flat.of_linearEquiv e.toLinearEquiv
      isIntegral := ⟨fun x ↦ by
        simpa using (isIntegral_algebraMap (x := e x)).map e.symm⟩ }
  rw [MvPolynomial.eq_C_of_isEmpty p] at hp ⊢
  rw [RingHom.mem_ker] at hp
  simp only [mvEval, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
    map_eq_zero_iff _ (algebraMap (ResidueField R) L).injective, residue_eq_zero_iff] at hp
  exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hp)

/-! #### Chain upper bounds -/

/-- Union of carriers along a set of stages. -/
private abbrev chainCarrier (C : Set (AlgStage R L)) : Set L :=
  ⋃ s ∈ C, s.carrier

private lemma carrier_subset_chainCarrier {C : Set (AlgStage R L)} {s : AlgStage R L}
    (hs : s ∈ C) : s.carrier ⊆ chainCarrier C :=
  Set.subset_biUnion_of_mem (u := AlgStage.carrier) hs

/-- Over a nonempty chain `C` of stages, every finite subset of `chainCarrier C` lies in the
carrier of a single stage in `C`. -/
private lemma exists_mem_chain_of_finset {C : Set (AlgStage R L)} (hC : IsChain (· ≤ ·) C)
    (hne : C.Nonempty) (F : Finset (chainCarrier C)) :
    ∃ s ∈ C, ∀ u ∈ F, (u : L) ∈ s.carrier := by
  classical
  induction F using Finset.induction with
  | empty =>
    obtain ⟨s, hs⟩ := hne
    exact ⟨s, hs, by simp⟩
  | @insert u F _ ih =>
    obtain ⟨s₁, hs₁, hF⟩ := ih
    obtain ⟨s₂, hs₂, hu⟩ := Set.mem_iUnion₂.mp u.property
    rcases hC.total hs₁ hs₂ with h12 | h21
    · refine ⟨s₂, hs₂, fun v hv ↦ ?_⟩
      rcases Finset.mem_insert.mp hv with rfl | hv
      · exact hu
      · exact h12.choose (hF v hv)
    · refine ⟨s₁, hs₁, fun v hv ↦ ?_⟩
      rcases Finset.mem_insert.mp hv with rfl | hv
      · exact h21.choose hu
      · exact hF v hv

/-- Every polynomial over `chainCarrier C` comes by variable inclusion from some stage in `C`. -/
private lemma exists_rename_of_chain {C : Set (AlgStage R L)} (hC : IsChain (· ≤ ·) C)
    (hne : C.Nonempty) (p : MvPolynomial (chainCarrier C) R) :
    ∃ (s : AlgStage R L) (hs : s ∈ C) (q : MvPolynomial s.carrier R),
      MvPolynomial.rename (Set.inclusion (carrier_subset_chainCarrier hs)) q = p := by
  classical
  obtain ⟨s, hs, hvars⟩ := exists_mem_chain_of_finset hC hne p.vars
  have hsub := carrier_subset_chainCarrier hs
  obtain ⟨q, hq⟩ := MvPolynomial.exists_rename_eq_of_vars_subset_range p (Set.inclusion hsub)
    (Set.inclusion_injective hsub) fun u hu ↦ ⟨⟨u.val, hvars u hu⟩, rfl⟩
  exact ⟨s, hs, q, hq⟩

/-- Ideal over `chainCarrier C` of a nonempty chain. -/
private def chainIdeal {C : Set (AlgStage R L)} (hC : IsChain (· ≤ ·) C) (hne : C.Nonempty) :
    Ideal (MvPolynomial (chainCarrier C) R) where
  carrier := {p | ∃ (s : AlgStage R L) (hs : s ∈ C) (q : MvPolynomial s.carrier R),
    q ∈ s.ideal ∧ MvPolynomial.rename (Set.inclusion (carrier_subset_chainCarrier hs)) q = p}
  zero_mem' := by
    obtain ⟨s, hs⟩ := hne
    exact ⟨s, hs, 0, s.ideal.zero_mem, map_zero _⟩
  add_mem' := by
    rintro _ _ ⟨s₁, hs₁, q₁, hq₁, rfl⟩ ⟨s₂, hs₂, q₂, hq₂, rfl⟩
    rcases hC.total hs₁ hs₂ with h12 | h21
    · refine ⟨s₂, hs₂, MvPolynomial.rename (Set.inclusion h12.choose) q₁ + q₂,
        add_mem ((mem_ideal_iff_of_le h12 q₁).mpr hq₁) hq₂, by simp [MvPolynomial.rename_rename]⟩
    · refine ⟨s₁, hs₁, q₁ + MvPolynomial.rename (Set.inclusion h21.choose) q₂,
        add_mem hq₁ ((mem_ideal_iff_of_le h21 q₂).mpr hq₂), by simp [MvPolynomial.rename_rename]⟩
  smul_mem' := by
    rintro f _ ⟨s₁, hs₁, q₁, hq₁, rfl⟩
    obtain ⟨s₂, hs₂, q₂, rfl⟩ := exists_rename_of_chain hC hne f
    rcases hC.total hs₁ hs₂ with h12 | h21
    · refine ⟨s₂, hs₂, q₂ * MvPolynomial.rename (Set.inclusion h12.choose) q₁,
        s₂.ideal.mul_mem_left _ ((mem_ideal_iff_of_le h12 q₁).mpr hq₁),
        by simp [MvPolynomial.rename_rename]⟩
    · refine ⟨s₁, hs₁, MvPolynomial.rename (Set.inclusion h21.choose) q₂ * q₁,
        s₁.ideal.mul_mem_left _ hq₁, by simp [MvPolynomial.rename_rename]⟩

private lemma comap_chainIdeal {C : Set (AlgStage R L)} (hC : IsChain (· ≤ ·) C)
    (hne : C.Nonempty) {s : AlgStage R L} (hs : s ∈ C) :
    (chainIdeal hC hne).comap
      (MvPolynomial.rename (Set.inclusion (carrier_subset_chainCarrier hs))).toRingHom =
      s.ideal := by
  ext p
  simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
  refine ⟨fun hp ↦ ?_, fun hp ↦ ⟨s, hs, p, hp, rfl⟩⟩
  obtain ⟨t, ht, q, hq, heq⟩ := hp
  rcases hC.total hs ht with hst | hts
  · have hinj := MvPolynomial.rename_injective (R := R) _
      (Set.inclusion_injective (carrier_subset_chainCarrier ht))
    have hpq : MvPolynomial.rename (Set.inclusion hst.choose) p = q :=
      hinj (by simpa [MvPolynomial.rename_rename] using heq.symm)
    exact (mem_ideal_iff_of_le hst p).mp (hpq.symm ▸ hq)
  · have hinj := MvPolynomial.rename_injective (R := R) _
      (Set.inclusion_injective (carrier_subset_chainCarrier hs))
    have hqp : MvPolynomial.rename (Set.inclusion hts.choose) q = p :=
      hinj (by simpa [MvPolynomial.rename_rename] using heq)
    exact hqp ▸ (mem_ideal_iff_of_le hts q).mpr hq

/-- Canonical `R`-algebra map from a stage quotient in `C` to the chain colimit quotient. -/
private def chainQuotHom {C : Set (AlgStage R L)} (hC : IsChain (· ≤ ·) C) (hne : C.Nonempty)
    {s : AlgStage R L} (hs : s ∈ C) :
    s.Quot →ₐ[R] MvPolynomial (chainCarrier C) R ⧸ chainIdeal hC hne :=
  Ideal.Quotient.liftₐ s.ideal
    ((Ideal.Quotient.mkₐ R (chainIdeal hC hne)).comp
      (MvPolynomial.rename (Set.inclusion (carrier_subset_chainCarrier hs))))
    fun f hf ↦ by
      rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact ⟨s, hs, f, hf, rfl⟩

@[simp]
private lemma chainQuotHom_mk {C : Set (AlgStage R L)} (hC : IsChain (· ≤ ·) C)
    (hne : C.Nonempty) {s : AlgStage R L} (hs : s ∈ C) (f : MvPolynomial s.carrier R) :
    chainQuotHom hC hne hs (Ideal.Quotient.mk s.ideal f) =
      Ideal.Quotient.mk (chainIdeal hC hne)
        (MvPolynomial.rename (Set.inclusion (carrier_subset_chainCarrier hs)) f) := by
  rw [← Ideal.Quotient.mkₐ_eq_mk R, ← AlgHom.comp_apply, chainQuotHom,
    Ideal.Quotient.liftₐ_comp, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]

/-- Flatness of the chain colimit quotient, via the equational criterion. -/
private lemma flat_chainIdeal {C : Set (AlgStage R L)} (hC : IsChain (· ≤ ·) C)
    (hne : C.Nonempty) :
    Module.Flat R (MvPolynomial (chainCarrier C) R ⧸ chainIdeal hC hne) := by
  classical
  refine Module.Flat.of_forall_isTrivialRelation fun {n} r x hrel ↦ ?_
  choose p hp using fun i ↦ Ideal.Quotient.mk_surjective (x i)
  obtain ⟨s, hs, hvars⟩ :=
    exists_mem_chain_of_finset hC hne (Finset.univ.biUnion fun i ↦ (p i).vars)
  have hsub := carrier_subset_chainCarrier hs
  have hp_mem (i : Fin n) : ∀ u ∈ (p i).vars, (u : L) ∈ s.carrier := fun u hu ↦
    hvars u (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hu⟩)
  choose q hq using fun i ↦ MvPolynomial.exists_rename_eq_of_vars_subset_range (p i)
    (Set.inclusion hsub) (Set.inclusion_injective hsub) fun u hu ↦ ⟨⟨u.val, hp_mem i u hu⟩, rfl⟩
  let j := chainQuotHom hC hne hs
  have hj_inj : Function.Injective j := by
    rw [← AlgHom.coe_toRingHom, RingHom.injective_iff_ker_eq_bot]
    ext z
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [RingHom.mem_ker, AlgHom.coe_toRingHom, chainQuotHom_mk, Ideal.mem_bot,
      Ideal.Quotient.eq_zero_iff_mem, Ideal.Quotient.eq_zero_iff_mem,
      ← comap_chainIdeal hC hne hs, Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
  have hqx (i : Fin n) : j (Ideal.Quotient.mk s.ideal (q i)) = x i := by
    rw [chainQuotHom_mk, hq, hp]
  have hrel_s : ∑ i, r i • Ideal.Quotient.mk s.ideal (q i) = 0 :=
    hj_inj (by rw [map_zero, map_sum]; simpa [hqx] using hrel)
  obtain ⟨m, c, y, hy⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel_s
  refine ⟨m, c, fun k ↦ j (y k), fun i ↦ ?_, hy.2⟩
  have hyi : Ideal.Quotient.mk s.ideal (q i) = ∑ k, c i k • y k := hy.1 i
  rw [← hqx, hyi, map_sum]
  simp

/-- Upper bound stage of a nonempty chain. -/
private def chainSup {C : Set (AlgStage R L)} (hC : IsChain (· ≤ ·) C) (hne : C.Nonempty) :
    AlgStage R L where
  carrier := chainCarrier C
  ideal := chainIdeal hC hne
  le_ker := by
    rintro _ ⟨s, hs, q, hq, rfl⟩
    have hq0 : mvEval R ((↑) : s.carrier → L) q = 0 := s.le_ker hq
    rw [RingHom.mem_ker]
    simpa [mvEval, MvPolynomial.eval₂_rename] using hq0
  ker_le := by
    intro p hp
    obtain ⟨s, hs, q, rfl⟩ := exists_rename_of_chain hC hne p
    have hq : q ∈ RingHom.ker (mvEval R ((↑) : s.carrier → L)) := by
      rw [RingHom.mem_ker] at hp ⊢
      simpa [mvEval, MvPolynomial.eval₂_rename] using hp
    obtain ⟨f, hf, m, hm, rfl⟩ := Submodule.mem_sup.mp (s.ker_le hq)
    rw [map_add]
    refine add_mem (Ideal.mem_sup_left ⟨s, hs, f, hf, rfl⟩) (Ideal.mem_sup_right ?_)
    have hsub := carrier_subset_chainCarrier hs
    have hC_map : ((maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial s.carrier R)).map
        (MvPolynomial.rename (Set.inclusion hsub)).toRingHom =
        (maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (chainCarrier C) R) := by
      rw [Ideal.map_map]
      congr 1
      ext r
      simp
    rw [← hC_map]
    exact Ideal.mem_map_of_mem _ hm
  flat := flat_chainIdeal hC hne
  isIntegral := ⟨fun z ↦ by
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨s, hs, q, rfl⟩ := exists_rename_of_chain hC hne p
    exact (Algebra.IsIntegral.isIntegral (R := R) (Ideal.Quotient.mk s.ideal q)).map
      (chainQuotHom hC hne hs)⟩

private lemma le_chainSup {C : Set (AlgStage R L)} (hC : IsChain (· ≤ ·) C)
    (hne : C.Nonempty) {s : AlgStage R L} (hs : s ∈ C) :
    s ≤ chainSup hC hne :=
  ⟨carrier_subset_chainCarrier hs, comap_chainIdeal hC hne hs⟩

/-! #### Adjoining one missing algebraic element -/

private instance instIsLocalHomEvalQuot [Algebra.IsAlgebraic (ResidueField R) L]
    (s : AlgStage R L) : IsLocalHom s.evalQuot :=
  ⟨fun x hx ↦ by
    by_contra hnu
    have hmem : x ∈ maximalIdeal s.Quot := (mem_maximalIdeal x).mpr hnu
    rw [maximalIdeal_quot_eq_map, ← ker_evalQuot_eq_map_maximalIdeal, RingHom.mem_ker] at hmem
    exact hx.ne_zero hmem⟩

/-- Residue field algebra structure `Algebra (ResidueField s.Quot) L` induced by `s.evalQuot`. -/
private instance instQuotResidueAlgebra [Algebra.IsAlgebraic (ResidueField R) L]
    (s : AlgStage R L) : Algebra (ResidueField s.Quot) L :=
  (ResidueField.lift s.evalQuot).toAlgebra

private lemma evalQuot_eq_comp_residue [Algebra.IsAlgebraic (ResidueField R) L]
    (s : AlgStage R L) :
    s.evalQuot = (algebraMap (ResidueField s.Quot) L).comp (residue s.Quot) := by
  rw [instQuotResidueAlgebra, RingHom.algebraMap_toAlgebra]
  exact (ResidueField.lift_comp_residue s.evalQuot).symm

private lemma isIntegral_over_quotResidueField [Algebra.IsAlgebraic (ResidueField R) L]
    (s : AlgStage R L) (a : L) :
    IsIntegral (ResidueField s.Quot) a := by
  obtain ⟨p, hp0, hpa⟩ := Algebra.IsAlgebraic.isAlgebraic (R := ResidueField R) a
  have : IsLocalHom (algebraMap R s.Quot) :=
    ((local_hom_tfae (algebraMap R s.Quot)).out 1 3).mpr (maximalIdeal_quot_eq_map s).ge
  let φ : ResidueField R →+* ResidueField s.Quot := ResidueField.map (algebraMap R s.Quot)
  have hcomp : (algebraMap (ResidueField s.Quot) L).comp φ = algebraMap (ResidueField R) L := by
    ext x
    obtain ⟨r, rfl⟩ := residue_surjective x
    rw [RingHom.comp_apply, ResidueField.map_residue, ← RingHom.comp_apply,
      ← evalQuot_eq_comp_residue, evalQuot_algebraMap]
  have halg : IsAlgebraic (ResidueField s.Quot) a :=
    ⟨p.map φ, map_ne_zero hp0, by rw [aeval_def, eval₂_map, hcomp, ← aeval_def, hpa]⟩
  exact halg.isIntegral

/-- Presentation map `MvPolynomial ↥(insert a s.carrier) R →ₐ[R] AdjoinRoot g` extending the
variables of `s.carrier` by sending `a` to `AdjoinRoot.root g`. -/
private def insertPresentation {s : AlgStage R L} (a : L) (g : s.Quot[X]) :
    MvPolynomial ↥(insert a s.carrier) R →ₐ[R] AdjoinRoot g :=
  MvPolynomial.aeval fun x ↦ by
    classical
    exact if hx : (x : L) ∈ s.carrier then
      algebraMap s.Quot (AdjoinRoot g) (Ideal.Quotient.mk s.ideal (MvPolynomial.X ⟨x.val, hx⟩))
    else
      AdjoinRoot.root g

private lemma insertPresentation_rename {s : AlgStage R L} (a : L) (g : s.Quot[X])
    (p : MvPolynomial s.carrier R) :
    insertPresentation a g
        (MvPolynomial.rename (Set.inclusion (Set.subset_insert a s.carrier)) p) =
      algebraMap s.Quot (AdjoinRoot g) (Ideal.Quotient.mk s.ideal p) := by
  induction p using MvPolynomial.induction_on with
  | C r =>
    rw [MvPolynomial.algHom_C, AlgHom.commutes, ← MvPolynomial.algebraMap_eq,
      Ideal.Quotient.mk_algebraMap, ← IsScalarTower.algebraMap_apply]
  | add f₁ f₂ ih₁ ih₂ => simp [map_add, ih₁, ih₂]
  | mul_X f x ih =>
    rw [map_mul, map_mul, ih, MvPolynomial.rename_X, insertPresentation, MvPolynomial.aeval_X]
    have hx : ((Set.inclusion (Set.subset_insert a s.carrier) x :
        ↥(insert a s.carrier)) : L) ∈ s.carrier := x.property
    rw [dite_eq_left_of_eq_true (eq_true hx)]
    have hx_eq : (⟨(Set.inclusion (Set.subset_insert a s.carrier) x : L), hx⟩ : s.carrier) = x :=
      rfl
    rw [hx_eq, ← map_mul, ← map_mul]

private lemma insertPresentation_surjective {s : AlgStage R L} {a : L} (ha : a ∉ s.carrier)
    (g : s.Quot[X]) :
    Function.Surjective (insertPresentation a g) := by
  intro b
  obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective b
  induction P using Polynomial.induction_on' with
  | add P₁ P₂ ih₁ ih₂ =>
    obtain ⟨f₁, hf₁⟩ := ih₁
    obtain ⟨f₂, hf₂⟩ := ih₂
    exact ⟨f₁ + f₂, by rw [map_add, hf₁, hf₂, map_add]⟩
  | monomial n q =>
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective q
    refine ⟨MvPolynomial.rename (Set.inclusion (Set.subset_insert a s.carrier)) f *
        MvPolynomial.X (⟨a, Set.mem_insert a s.carrier⟩ : ↥(insert a s.carrier)) ^ n, ?_⟩
    rw [map_mul, map_pow, insertPresentation_rename, ← Polynomial.C_mul_X_pow_eq_monomial,
      map_mul, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, ← AdjoinRoot.algebraMap_eq]
    simp only [insertPresentation, MvPolynomial.aeval_X, dite_eq_right_of_eq_false (eq_false ha)]

/-- Evaluation `AdjoinRoot g →+* L` sending `root g` to `a`, compatible with `insertPresentation`.
-/
private lemma exists_adjoinRoot_eval [Algebra.IsAlgebraic (ResidueField R) L]
    (s : AlgStage R L) (a : L) {g : s.Quot[X]}
    (hgmap : g.map (residue s.Quot) = minpoly (ResidueField s.Quot) a) :
    ∃ ψB : AdjoinRoot g →+* L,
      ψB.comp (insertPresentation a g).toRingHom =
        mvEval R ((↑) : ↥(insert a s.carrier) → L) := by
  have hg_eval : eval₂ s.evalQuot a g = 0 := by
    rw [evalQuot_eq_comp_residue, ← eval₂_map, hgmap, ← aeval_def, minpoly.aeval]
  refine ⟨AdjoinRoot.lift s.evalQuot a hg_eval, ?_⟩
  apply MvPolynomial.ringHom_ext
  · intro r
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.algHom_C]
    rw [IsScalarTower.algebraMap_apply R s.Quot (AdjoinRoot g), AdjoinRoot.algebraMap_eq,
      AdjoinRoot.lift_of, evalQuot_algebraMap]
    simp [mvEval]
  · intro x
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      insertPresentation, MvPolynomial.aeval_X]
    split_ifs with hx
    · rw [AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of, evalQuot_mk]
      simp [mvEval]
    · have hxa : (x : L) = a := (Set.mem_insert_iff.mp x.property).resolve_right hx
      simp [mvEval, hxa]

private lemma ker_insertPresentation_le [Algebra.IsAlgebraic (ResidueField R) L]
    (s : AlgStage R L) {a : L} (ha : a ∉ s.carrier) {g : s.Quot[X]} (hg : g.Monic)
    (hgmap : g.map (residue s.Quot) = minpoly (ResidueField s.Quot) a)
    (hirr : Irreducible (g.map (residue s.Quot))) :
    RingHom.ker (mvEval R ((↑) : ↥(insert a s.carrier) → L)) ≤
      RingHom.ker (insertPresentation a g) ⊔ (maximalIdeal R).map MvPolynomial.C := by
  have : IsLocalRing (AdjoinRoot g) := hg.isLocalRing_adjoinRoot hirr
  obtain ⟨ψB, hψB_comp⟩ := exists_adjoinRoot_eval s a hgmap
  have hmaxB : maximalIdeal (AdjoinRoot g) =
      (maximalIdeal R).map (algebraMap R (AdjoinRoot g)) := by
    rw [AdjoinRoot.maximalIdeal_eq_map hirr, maximalIdeal_quot_eq_map, Ideal.map_map,
      ← IsScalarTower.algebraMap_eq]
  intro p hp
  have hπp : insertPresentation a g p ∈ maximalIdeal (AdjoinRoot g) :=
    le_maximalIdeal (RingHom.ker_ne_top ψB) (by
      rw [RingHom.mem_ker, ← AlgHom.coe_toRingHom, ← RingHom.comp_apply,
        ← AlgHom.toRingHom_eq_coe, hψB_comp, ← RingHom.mem_ker]
      exact hp)
  have hmap_eq : ((maximalIdeal R).map
      (MvPolynomial.C : R →+* MvPolynomial ↥(insert a s.carrier) R)).map
      (insertPresentation a g).toRingHom = maximalIdeal (AdjoinRoot g) := by
    rw [hmaxB, Ideal.map_map]
    congr 1
    ext r
    exact (insertPresentation a g).commutes r
  rw [← hmap_eq] at hπp
  obtain ⟨m, hm, hm_eq⟩ :=
    (Ideal.mem_map_iff_of_surjective (insertPresentation a g).toRingHom
      (insertPresentation_surjective ha g)).mp hπp
  have hdiff : p - m ∈ RingHom.ker (insertPresentation a g) := by
    rw [RingHom.mem_ker, map_sub]
    exact sub_eq_zero.mpr hm_eq.symm
  simpa using add_mem (Ideal.mem_sup_left hdiff) (Ideal.mem_sup_right hm)

/-- Given a stage `s` and `a ∉ s.carrier`, `s` strictly extends to `insert a s.carrier` by
adjoining a root of a monic lift of `minpoly (ResidueField s.Quot) a`. -/
private lemma exists_gt_of_notMem [Algebra.IsAlgebraic (ResidueField R) L]
    (s : AlgStage R L) {a : L} (ha : a ∉ s.carrier) :
    ∃ s' : AlgStage R L, s ≤ s' ∧ a ∈ s'.carrier := by
  have hint : IsIntegral (ResidueField s.Quot) a := s.isIntegral_over_quotResidueField a
  obtain ⟨g, hgmap, -, hg⟩ := lifts_and_degree_eq_and_monic
    (Polynomial.map_surjective _ residue_surjective (minpoly (ResidueField s.Quot) a))
    (minpoly.monic hint)
  have hirr : Irreducible (g.map (residue s.Quot)) := hgmap ▸ minpoly.irreducible hint
  have : IsLocalRing (AdjoinRoot g) := hg.isLocalRing_adjoinRoot hirr
  have : IsLocalHom (algebraMap s.Quot (AdjoinRoot g)) := AdjoinRoot.isLocalHom_algebraMap hirr
  have : Module.Finite s.Quot (AdjoinRoot g) := (AdjoinRoot.powerBasis' hg).finite
  have : Module.Free s.Quot (AdjoinRoot g) := hg.free_adjoinRoot
  have : Module.FaithfullyFlat s.Quot (AdjoinRoot g) := .of_flat_of_isLocalHom
  have : Module.Flat R (AdjoinRoot g) := .trans R s.Quot (AdjoinRoot g)
  have : Algebra.IsIntegral R (AdjoinRoot g) :=
    have : Algebra.IsIntegral s.Quot (AdjoinRoot g) := Algebra.IsIntegral.of_finite _ _
    Algebra.IsIntegral.trans s.Quot
  let π := insertPresentation a g
  let e := Ideal.quotientKerAlgEquivOfSurjective (insertPresentation_surjective ha g)
  obtain ⟨ψB, hψB_comp⟩ := exists_adjoinRoot_eval s a hgmap
  refine ⟨
    { carrier := insert a s.carrier
      ideal := RingHom.ker π
      le_ker := fun p hp ↦ by
        rw [RingHom.mem_ker, ← hψB_comp, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe, RingHom.mem_ker.mp hp, map_zero]
      ker_le := ker_insertPresentation_le s ha hg hgmap hirr
      flat := Module.Flat.of_linearEquiv e.toLinearEquiv
      isIntegral := ⟨fun z ↦ by
        have hz := (Algebra.IsIntegral.isIntegral (R := R) (e z)).map e.symm
        rwa [AlgEquiv.symm_apply_apply] at hz⟩ },
    ⟨Set.subset_insert a s.carrier, ?_⟩, Set.mem_insert a s.carrier⟩
  ext f
  simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, RingHom.mem_ker,
    π, insertPresentation_rename]
  rw [map_eq_zero_iff _ (FaithfulSMul.algebraMap_injective s.Quot (AdjoinRoot g)),
    Ideal.Quotient.eq_zero_iff_mem]

/-- A maximal stage exists and has carrier `Set.univ`. -/
private lemma exists_maximal_univ [Algebra.IsAlgebraic (ResidueField R) L] :
    ∃ s : AlgStage R L, s.carrier = Set.univ := by
  obtain ⟨m, -, hm⟩ := zorn_le₀ (Set.univ : Set (AlgStage R L)) fun C _ hC ↦ by
    rcases C.eq_empty_or_nonempty with rfl | hne
    · exact ⟨base, trivial, by simp⟩
    · exact ⟨chainSup hC hne, trivial, fun z hz ↦ le_chainSup hC hne hz⟩
  refine ⟨m, Set.eq_univ_iff_forall.mpr fun a ↦ by_contra fun ha ↦ ?_⟩
  obtain ⟨s', hle, ha'⟩ := exists_gt_of_notMem m ha
  have hle' : s' ≤ m := hm trivial hle
  exact ha (hle'.choose ha')

end AlgStage

end Algebraic

/-! ### Assembling `ResidueExtension R L` -/

section ResidueExtension

variable (R : Type u) [CommRing R] [IsLocalRing R]
variable (L : Type v) [Field L] [Algebra (ResidueField R) L]

/-- Chosen transcendence basis of `L` over `ResidueField R`. -/
private def chosenTrBasis : Set L :=
  (exists_isTranscendenceBasis (ResidueField R) L).choose

private lemma chosenTrBasis_spec :
    IsTranscendenceBasis (ResidueField R) ((↑) : chosenTrBasis R L → L) :=
  (exists_isTranscendenceBasis (ResidueField R) L).choose_spec

/-- The intermediate purely transcendental local ring `R_tr : Type (max u v)`. -/
private abbrev TrBase : Type (max u v) :=
  TranscendentalExt R ((↑) : chosenTrBasis R L → L)

private instance : IsLocalHom (algebraMap R (TrBase R L)) :=
  ((local_hom_tfae _).out 1 3).mpr
    (transcendentalExt_maximalIdeal_eq_map R _ (chosenTrBasis_spec R L).1).ge

private instance : Algebra (ResidueField (TrBase R L)) L :=
  transcendentalExtResidueAlgebra R ((↑) : chosenTrBasis R L → L)

private instance : Algebra.IsAlgebraic (ResidueField (TrBase R L)) L :=
  transcendentalExt_isAlgebraic R ((↑) : chosenTrBasis R L → L) (chosenTrBasis_spec R L)

/-- Chosen full-carrier algebraic stage over `TrBase R L`. -/
private def chosenAlgStage : AlgStage (TrBase R L) L :=
  (AlgStage.exists_maximal_univ (R := TrBase R L) (L := L)).choose

private lemma chosenAlgStage_carrier :
    (chosenAlgStage R L).carrier = Set.univ :=
  (AlgStage.exists_maximal_univ (R := TrBase R L) (L := L)).choose_spec

/-- A faithfully flat local `R`-algebra whose maximal ideal is generated by `maximalIdeal R` and
whose residue field is isomorphic to `L` over `ResidueField R` (*ÉGA III*, Chap. 0, 10.3.1). -/
def ResidueExtension : Type (max u v) :=
  (chosenAlgStage R L).Quot
deriving CommRing, Algebra R

namespace ResidueExtension

/-- Internal `R`-algebra equivalence between `ResidueExtension R L` and the underlying stage
quotient. -/
private def equivQuot : ResidueExtension R L ≃ₐ[R] (chosenAlgStage R L).Quot where
  toFun := id
  invFun := id
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

/-- `ResidueExtension R L` is a local ring. -/
instance instIsLocalRing : IsLocalRing (ResidueExtension R L) :=
  (equivQuot R L).symm.toRingEquiv.isLocalRing

/-- The maximal ideal of `ResidueExtension R L` is generated by `maximalIdeal R`. -/
theorem maximalIdeal_eq_map :
    maximalIdeal (ResidueExtension R L) =
      (maximalIdeal R).map (algebraMap R (ResidueExtension R L)) := by
  let e : (chosenAlgStage R L).Quot →ₐ[R] ResidueExtension R L := (equivQuot R L).symm.toAlgHom
  rw [← map_maximalIdeal_of_surjective e.toRingHom (equivQuot R L).symm.surjective,
    AlgStage.maximalIdeal_quot_eq_map,
    transcendentalExt_maximalIdeal_eq_map R ((↑) : chosenTrBasis R L → L)
      (chosenTrBasis_spec R L).1,
    Ideal.map_map, Ideal.map_map, RingHom.comp_assoc,
    ← IsScalarTower.algebraMap_eq R (TrBase R L) (chosenAlgStage R L).Quot,
    AlgHom.toRingHom_eq_coe, e.comp_algebraMap]

/-- If `maximalIdeal R` is finitely generated, then so is `maximalIdeal (ResidueExtension R L)`. -/
theorem maximalIdeal_fg (h : (maximalIdeal R).FG) :
    (maximalIdeal (ResidueExtension R L)).FG := by
  rw [maximalIdeal_eq_map]
  exact h.map _

/-- The structure map `R → ResidueExtension R L` is a local homomorphism. -/
instance instIsLocalHom : IsLocalHom (algebraMap R (ResidueExtension R L)) :=
  ((local_hom_tfae (algebraMap R (ResidueExtension R L))).out 1 3).mpr
    (maximalIdeal_eq_map R L).ge

/-- `ResidueExtension R L` is flat over `R`. -/
instance instFlat : Module.Flat R (ResidueExtension R L) :=
  have : Module.Flat R (chosenAlgStage R L).Quot :=
    Module.Flat.trans R (TrBase R L) (chosenAlgStage R L).Quot
  Module.Flat.of_linearEquiv (equivQuot R L).toLinearEquiv

/-- `ResidueExtension R L` is faithfully flat over `R`. -/
instance instFaithfullyFlat : Module.FaithfullyFlat R (ResidueExtension R L) :=
  Module.FaithfullyFlat.of_flat_of_isLocalHom

/-- The stage evaluation `(chosenAlgStage R L).evalQuot` is surjective onto `L`. -/
private lemma toFieldHom_surjective :
    Function.Surjective (chosenAlgStage R L).evalQuot := by
  rw [← Set.range_eq_univ, AlgStage.range_evalQuot, chosenAlgStage_carrier, Algebra.adjoin_univ]
  exact Set.eq_univ_of_forall fun _ ↦ trivial

/-- `(chosenAlgStage R L).evalQuot` restricts on `R` to
`algebraMap (ResidueField R) L ∘ residue R`. -/
private lemma toFieldHom_algebraMap (r : R) :
    (chosenAlgStage R L).evalQuot (algebraMap R (chosenAlgStage R L).Quot r) =
      algebraMap (ResidueField R) L (residue R r) := by
  rw [IsScalarTower.algebraMap_apply R (TrBase R L) (chosenAlgStage R L).Quot,
    AlgStage.evalQuot_algebraMap]
  have _ := transcendentalExt_isScalarTower R ((↑) : chosenTrBasis R L → L)
  rw [← ResidueField.algebraMap_residue (R := R) (S := TrBase R L) r]
  exact (IsScalarTower.algebraMap_apply
    (ResidueField R) (ResidueField (TrBase R L)) L (residue R r)).symm

/-- Canonical `ResidueField R`-algebra isomorphism
`ResidueField (ResidueExtension R L) ≃ₐ[ResidueField R] L`. -/
def residueFieldEquiv : ResidueField (ResidueExtension R L) ≃ₐ[ResidueField R] L := by
  let _ : Algebra R L := ((algebraMap (ResidueField R) L).comp (residue R)).toAlgebra
  have : IsScalarTower R (ResidueField R) L := .of_algebraMap_eq' rfl
  let ψ : ResidueExtension R L →ₐ[R] L :=
    { (chosenAlgStage R L).evalQuot.comp (equivQuot R L).toAlgHom.toRingHom with
      commutes' := fun r ↦ by
        simp [toFieldHom_algebraMap, RingHom.algebraMap_toAlgebra] }
  have hψ : Function.Surjective ψ :=
    (toFieldHom_surjective R L).comp (equivQuot R L).surjective
  exact (residueFieldAlgEquivOfSurjective (ψ := ψ) hψ).extendScalarsOfSurjective
    residue_surjective

/-- When `L` is algebraically closed, so is `ResidueField (ResidueExtension R L)`. -/
instance instIsAlgClosedResidueField [IsAlgClosed L] :
    IsAlgClosed (ResidueField (ResidueExtension R L)) :=
  ⟨fun p ↦ by
    let e := (residueFieldEquiv R L).toRingEquiv
    simpa [Polynomial.map_map] using
      IsAlgClosed.splits_domain (f := e.symm.toRingHom) (p.map e.toRingHom)⟩

end ResidueExtension

end ResidueExtension

