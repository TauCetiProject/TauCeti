module

public import Mathlib.RingTheory.LocalRing.ResidueField.Fiber
import Mathlib.RingTheory.Ideal.Quotient.Noetherian
import Mathlib.RingTheory.Localization.Submodule

/-!
# The local rings of the fibre ring

For a prime `p` of `R` and a prime `Q` of the fibre ring `κ(p) ⊗[R] B` lying over the prime `q`
of `B`, Mathlib's `Ideal.Fiber.algEquivAux₂` identifies the local ring `(κ(p) ⊗[R] B)_Q` with
`B_q ⧸ p B_q`. This file records that this identification is compatible with the maps from `B`.
It also records that the fibre ring of a Noetherian algebra is Noetherian.

## Main results

* `Ideal.Fiber.algEquivAux₂_algebraMap_one_tmul`: `Ideal.Fiber.algEquivAux₂` sends `1 ⊗ b` to the
  class of `b`.
* `Ideal.Fiber.map_map_quotient_mk_eq_map_fiber`: the same identification carries the ideal
  generated by an ideal `J` of `B` in `(κ(p) ⊗[R] B)_Q` to the ideal generated by `J` in
  `B_q ⧸ p B_q`.
* `Ideal.Fiber.map_le_maximalIdeal`: the ideal `p B_q` lies in the maximal ideal of `B_q`.
* `Ideal.Fiber.isNoetherianRing`: if `B` is Noetherian, so is the fibre ring `κ(p) ⊗[R] B`.
-/

public section

universe u v

variable {R : Type u} {B : Type v} [CommRing R] [CommRing B] [Algebra R B]

namespace Ideal.Fiber

open Algebra.TensorProduct

variable (p : Ideal R) [p.IsPrime]

/-- The isomorphism `(κ(p) ⊗[R] B)_Q ≃ B_q ⧸ p B_q` of `Ideal.Fiber.algEquivAux₂`, where `q` is
the prime of `B` under `Q`, is compatible with the maps from `B`: it sends `1 ⊗ b` to the class
of `b`. -/
@[simp]
theorem algEquivAux₂_algebraMap_one_tmul (Q : Ideal (p.Fiber B)) [Q.IsPrime] (b : B) :
    algEquivAux₂ p Q (algebraMap _ (Localization.AtPrime Q) ((1 : p.ResidueField) ⊗ₜ[R] b)) =
      algebraMap B (Localization.AtPrime (Q.comap includeRight) ⧸ _) b := by
  -- `algEquivAux₂` is the restriction of scalars to `R` of a composite of `B`-algebra
  -- isomorphisms; unfold it and use that each factor commutes with the maps from `B`.
  let : Algebra B (p.Fiber B) := rightAlgebra
  unfold algEquivAux₂
  simp only [AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply]
  rw [← AlgEquiv.restrictScalars_apply B, ← right_algebraMap_apply,
    ← IsScalarTower.algebraMap_apply, AlgEquiv.commutes, AlgEquiv.commutes]

/-- Let `Q` be a prime of the fibre ring `κ(p) ⊗[R] B`, lying over the prime `r` of `B`. The
isomorphism `(κ(p) ⊗[R] B)_Q ≃ B_r ⧸ p B_r` of `Ideal.Fiber.localizationAlgEquivQuotient` carries
the ideal generated by an ideal `J` of `B` on the left to the ideal generated by `J` on the
right. -/
theorem map_map_quotient_mk_eq_map_fiber (J : Ideal B) (Q : Ideal (p.Fiber B)) [Q.IsPrime]
    [Algebra (Localization.AtPrime p) (Localization.AtPrime (Q.comap includeRight))]
    [IsScalarTower R (Localization.AtPrime p) (Localization.AtPrime (Q.comap includeRight))] :
    (J.map (algebraMap B (Localization.AtPrime (Q.comap includeRight)))).map
        (Ideal.Quotient.mk (p.map (algebraMap R (Localization.AtPrime (Q.comap includeRight))))) =
      ((J.map (includeRight : B →ₐ[R] p.Fiber B)).map
        (algebraMap (p.Fiber B) (Localization.AtPrime Q))).map
          (localizationAlgEquivQuotient p Q).toRingEquiv := by
  let e : Localization.AtPrime Q ≃+* Localization.AtPrime (Q.comap includeRight) ⧸
      p.map (algebraMap R (Localization.AtPrime (Q.comap includeRight))) :=
    (localizationAlgEquivQuotient p Q).toRingEquiv
  -- Name the isomorphism as a ring isomorphism, so that `Ideal.map_coe` applies to it.
  change _ = Ideal.map e _
  rw [← Ideal.map_coe e, ← Ideal.map_coe (includeRight : B →ₐ[R] p.Fiber B), Ideal.map_map,
    Ideal.map_map, Ideal.map_map]
  congr 1
  ext b
  simp [e, localizationAlgEquivQuotient, ← Ideal.Quotient.mk_algebraMap]

/-- Let `Q` be a prime of the fibre ring `κ(p) ⊗[R] B`, lying over the prime `r` of `B`. Since `r`
lies over `p`, the ideal `p B_r` lies in the maximal ideal of the local ring `B_r`. -/
theorem map_le_maximalIdeal (Q : Ideal (p.Fiber B)) [Q.IsPrime] :
    p.map (algebraMap R (Localization.AtPrime (Q.comap includeRight))) ≤
      IsLocalRing.maximalIdeal (Localization.AtPrime (Q.comap includeRight)) := by
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R B,
    IsLocalization.AtPrime.to_map_mem_maximal_iff _ (Q.comap includeRight)]
  rw [Ideal.over_def Q p] at ha
  simpa using ha

/-- The fibre ring `κ(p) ⊗[R] B` of a Noetherian `R`-algebra `B` is Noetherian, being the quotient
`B_p ⧸ p B_p` of a localization of `B` (`Ideal.Fiber.algEquivQuotient`). -/
instance isNoetherianRing [IsNoetherianRing B] : IsNoetherianRing (p.Fiber B) :=
  let : Algebra B (p.Fiber B) := rightAlgebra
  isNoetherianRing_of_ringEquiv _ (algEquivQuotient p).symm.toRingEquiv

end Ideal.Fiber
