module

public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Systems of parameters of a local ring

A *system of parameters* of a local ring `(R, 𝔪)` of Krull dimension `d` is a list
`x₁, …, x_d` of exactly `d` elements generating an ideal with radical `𝔪`, that is, an
`𝔪`-primary ideal (Matsumura, §14). Its entries lie in `𝔪`.
Over a Noetherian local ring a system of parameters always exists: by Krull's height theorem the
maximal ideal is minimal over an ideal generated by `ht 𝔪 = d` elements (Stacks,
Proposition 10.60.9 (00KQ)).

Systems of parameters are the sequences that big Cohen–Macaulay modules are required to be
regular on. The comparison used there is `TauCeti.IsSystemOfParameters.smul_top_eq_top_iff`: since
a power of `𝔪` lies in `(x₁, …, x_d)`, a module `M` satisfies `(x₁, …, x_d) M = M` exactly when
`𝔪 M = M`. This holds for every module, finite or not.

## Main definitions and results

* `TauCeti.IsSystemOfParameters R xs`: the list `xs` is a system of parameters of the local ring
  `R`.
* `TauCeti.IsSystemOfParameters.mem_maximalIdeal`: the entries of a system of parameters lie in
  the maximal ideal.
* `TauCeti.IsSystemOfParameters.exists_pow_le`: over a Noetherian local ring a power of the
  maximal ideal lies in the ideal generated by a system of parameters.
* `TauCeti.IsSystemOfParameters.smul_top_eq_top_iff`: for every module `M`,
  `(x₁, …, x_d) M = M` if and only if `𝔪 M = M`.
* `TauCeti.exists_isSystemOfParameters`: a Noetherian local ring has a system of parameters.
* `TauCeti.isSystemOfParameters_nil_iff` and
  `TauCeti.IsSystemOfParameters.eq_nil_of_ringKrullDim_eq_zero`: the empty list is a system of
  parameters exactly in dimension zero, where it is the only one.

## References

* [Stacks Project, Proposition 10.60.9](https://stacks.math.columbia.edu/tag/00KQ)
* H. Matsumura, *Commutative Ring Theory*, §14.
-/

public section

open IsLocalRing Ideal Pointwise

namespace TauCeti

variable (R : Type*) [CommRing R] [IsLocalRing R]

/-- A list `xs = [x₁, …, x_d]` is a *system of parameters* of the local ring `(R, 𝔪)` if its
length is the Krull dimension of `R` and the ideal `(x₁, …, x_d)` has radical `𝔪`, that is, it
is `𝔪`-primary. Matsumura, §14. -/
structure IsSystemOfParameters (xs : List R) : Prop where
  /-- The number of parameters is the Krull dimension. -/
  length_eq : (xs.length : WithBot ℕ∞) = ringKrullDim R
  /-- The parameters generate an ideal whose radical is the maximal ideal. -/
  radical_ofList_eq : (ofList xs).radical = maximalIdeal R

variable {R}

/-- Unfolds `TauCeti.IsSystemOfParameters`. -/
theorem isSystemOfParameters_iff (xs : List R) : IsSystemOfParameters R xs ↔
    (xs.length : WithBot ℕ∞) = ringKrullDim R ∧ (ofList xs).radical = maximalIdeal R :=
  ⟨fun h ↦ ⟨h.length_eq, h.radical_ofList_eq⟩, fun h ↦ ⟨h.1, h.2⟩⟩

namespace IsSystemOfParameters

variable {xs : List R}

/-- The ideal generated by a system of parameters lies in the maximal ideal. -/
theorem ofList_le_maximalIdeal (h : IsSystemOfParameters R xs) : ofList xs ≤ maximalIdeal R :=
  h.radical_ofList_eq ▸ le_radical

/-- The entries of a system of parameters lie in the maximal ideal. -/
theorem mem_maximalIdeal (h : IsSystemOfParameters R xs) {x : R} (hx : x ∈ xs) :
    x ∈ maximalIdeal R :=
  h.ofList_le_maximalIdeal (subset_span hx)

/-- A permutation of a system of parameters is a system of parameters. -/
theorem perm (h : IsSystemOfParameters R xs) {ys : List R} (hp : xs.Perm ys) :
    IsSystemOfParameters R ys := by
  have hof : ofList ys = ofList xs := by
    simp only [ofList, hp.mem_iff]
  exact ⟨hp.length_eq ▸ h.length_eq, hof ▸ h.radical_ofList_eq⟩

/-- Over a Noetherian local ring some power of the maximal ideal lies in the ideal generated by a
system of parameters. -/
theorem exists_pow_le [IsNoetherianRing R] (h : IsSystemOfParameters R xs) :
    ∃ n : ℕ, maximalIdeal R ^ n ≤ ofList xs :=
  exists_pow_le_of_le_radical_of_fg h.radical_ofList_eq.ge (IsNoetherian.noetherian _)

/-- **Nakayama-free comparison of `𝔪 M` with `(x₁, …, x_d) M`.** For a system of parameters
`x₁, …, x_d` of a Noetherian local ring `(R, 𝔪)` and an arbitrary `R`-module `M`, not necessarily
finite, `(x₁, …, x_d) M = M` if and only if `𝔪 M = M`. -/
theorem smul_top_eq_top_iff [IsNoetherianRing R] (h : IsSystemOfParameters R xs)
    (M : Type*) [AddCommGroup M] [Module R M] :
    ofList xs • (⊤ : Submodule R M) = ⊤ ↔ maximalIdeal R • (⊤ : Submodule R M) = ⊤ := by
  refine ⟨fun hx ↦ top_le_iff.1 (hx.ge.trans (Submodule.smul_mono_left h.ofList_le_maximalIdeal)),
    fun hm ↦ ?_⟩
  obtain ⟨n, hn⟩ := h.exists_pow_le
  have hpow : ∀ k : ℕ, maximalIdeal R ^ k • (⊤ : Submodule R M) = ⊤ := by
    intro k
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ', Submodule.mul_smul, ih, hm]
  exact top_le_iff.1 ((hpow n).ge.trans (Submodule.smul_mono_left hn))

/-- In a local ring of dimension zero the only system of parameters is the empty list. -/
theorem eq_nil_of_ringKrullDim_eq_zero (h : IsSystemOfParameters R xs)
    (h0 : ringKrullDim R = 0) : xs = [] := by
  have := h.length_eq
  rw [h0] at this
  exact List.eq_nil_of_length_eq_zero (by exact_mod_cast this)

end IsSystemOfParameters

/-- The empty list is a system of parameters exactly when the local ring has dimension zero. -/
@[simp]
theorem isSystemOfParameters_nil_iff :
    IsSystemOfParameters R ([] : List R) ↔ ringKrullDim R = 0 := by
  refine ⟨fun h ↦ by simpa using h.length_eq.symm, fun h0 ↦ ⟨by simp [h0], ?_⟩⟩
  have : Ring.KrullDimLE 0 R := (ringKrullDimZero_iff_ringKrullDim_eq_zero).2 h0
  simpa [ofList, nilradical] using Ring.KrullDimLE.nilradical_eq_maximalIdeal (R := R)

variable (R) in
/-- **Existence of systems of parameters.** A Noetherian local ring has a system of parameters:
by Krull's height theorem its maximal ideal is minimal over an ideal generated by `dim R`
elements. Stacks, Proposition 10.60.9 (00KQ). -/
@[stacks 00KQ "existence of a system of parameters"]
theorem exists_isSystemOfParameters [IsNoetherianRing R] :
    ∃ xs : List R, IsSystemOfParameters R xs := by
  classical
  obtain ⟨s, hmin, hcard⟩ := exists_finset_card_eq_height_of_isNoetherianRing (maximalIdeal R)
  have hof : ofList s.toList = span (s : Set R) := by simp [ofList]
  refine ⟨s.toList, ⟨?_, ?_⟩⟩
  · rw [Finset.length_toList, ← maximalIdeal_height_eq_ringKrullDim, ← hcard]
    norm_cast
  · rw [hof]
    refine le_antisymm ((radical_mono hmin.1.2).trans_eq (maximalIdeal.isMaximal R).isPrime.radical)
      fun x hx ↦ ?_
    rw [radical_eq_sInf, Submodule.mem_sInf]
    rintro p ⟨hsp, hp⟩
    have hpm : p ≤ maximalIdeal R := le_maximalIdeal hp.ne_top
    exact (hmin.2 ⟨hp, hsp⟩ hpm) hx

end TauCeti
