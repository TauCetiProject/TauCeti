public import TauCeti.RingTheory.LocalRing.Hessian

/-!
# Local coordinates and minimal presentations

Let `Q` be a local ring whose maximal ideal `𝔪` is generated by coordinates `x : ι → Q`, with
dual derivations `Dᵢ xⱼ = δᵢⱼ`. The *gradient* of `a ∈ Q` is the residue of `(D₁ a, …, Dₙ a)`.
By the first-order Taylor expansion, an element `a ∈ 𝔪` lies in `𝔪²` exactly when its gradient
vanishes, so on `𝔪 / 𝔪²` the gradient is an isomorphism onto `κⁿ`. This file uses it to change
coordinates, to pass to quotients by some of the coordinates, and to put a quotient of `Q` in
minimal form.

Over a ring `K`, say that `x` is a coordinate system of the local `K`-algebra `Q` if `x` generates
`𝔪` and the differentials `dxᵢ` form a basis of `Ω[Q⁄K]`; the dual derivations are then the
coordinate functions of this basis. This is the setting of
`TauCeti.mem_maximalIdeal_sq_and_isUnit_det_hessian_of_formallyUnramified`, for instance the local
ring at a closed point of a smooth variety with separable residue field.

For a local quotient `A = Q ⧸ (g₁, …, g_m)` with `e = dim_κ 𝔪_A / 𝔪_A²`, some `n - e` of the
relations `g_s` together with `e` further elements generate `𝔪`. Dividing out by those `n - e`
relations gives a local ring `P` with a coordinate system of `e` elements, and the remaining
relations lie in `𝔪_P²`. This is a minimal presentation of `A`. When `m = n - e + 1`,
as for the local ring at a point of a complete intersection curve in affine `n`-space with
`e = 2`, a single relation `f` remains and `A ≅ P ⧸ (f)` is a plane curve singularity, to which
`TauCeti.mem_maximalIdeal_sq_and_isUnit_det_hessian_of_formallyUnramified` applies.

## Main results

* `TauCeti.maximalIdeal_eq_span_range_of_span_eq_top`: elements of `𝔪` whose gradients span `κⁿ`
  generate `𝔪`.
* `TauCeti.exists_basis_kaehlerDifferential_of_linearIndependent`: if the gradients of `n`
  elements are linearly independent, their differentials form a basis of `Ω[Q⁄K]`.
* `TauCeti.exists_basis_kaehlerDifferential_quotient`: the differentials of `Q ⧸ (zᵢ : i ∈ S)` have
  a basis given by the differentials of the remaining `zⱼ`, for any `z` whose differentials form a
  basis of `Ω[Q⁄K]`.
* `TauCeti.exists_minimal_presentation`: the minimal presentation of a quotient of `Q`.
* `TauCeti.exists_hypersurface_presentation`: a quotient of `Q` by `n - e + 1` relations is a
  hypersurface in a local ring with `e` coordinates.

## References

* [Stacks Project, Tag 00RU](https://stacks.math.columbia.edu/tag/00RU): the conormal sequence.
* [Stacks Project, Section 53.19, Tag 0C46](https://stacks.math.columbia.edu/tag/0C46): nodes of
  curves, plane curve singularities defined by a nondegenerate quadratic form.
-/

public section

noncomputable section

open IsLocalRing KaehlerDifferential Module

namespace TauCeti

section Gradient

variable {R Q ι κ : Type*} [CommSemiring R] [CommRing Q] [Algebra R Q] [IsLocalRing Q]
  [DecidableEq ι] {x : ι → Q} {D : ι → Derivation R Q Q}

/-- If the gradient of `a ∈ 𝔪` is a combination of the gradients of elements `wₖ ∈ 𝔪`, then `a`
is a combination of the `wₖ` modulo `𝔪²`. -/
theorem mem_span_range_sup_maximalIdeal_sq [Finite ι] [Finite κ]
    (hx : maximalIdeal Q = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {w : κ → Q}
    (hw : ∀ k, w k ∈ maximalIdeal Q) {a : Q} (ha : a ∈ maximalIdeal Q)
    (h : (fun i ↦ residue Q (D i a)) ∈ Submodule.span (ResidueField Q)
      (Set.range fun k i ↦ residue Q (D i (w k)))) :
    a ∈ Ideal.span (Set.range w) ⊔ maximalIdeal Q ^ 2 := by
  have := Fintype.ofFinite κ
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 h
  choose c' hc' using fun k ↦ residue_surjective (c k)
  have hspan : ∑ k, c' k * w k ∈ Ideal.span (Set.range w) :=
    Ideal.sum_mem _ fun k _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
  have hm : ∑ k, c' k * w k ∈ maximalIdeal Q :=
    Ideal.sum_mem _ fun k _ ↦ Ideal.mul_mem_left _ _ (hw k)
  have hsq : a - ∑ k, c' k * w k ∈ maximalIdeal Q ^ 2 := by
    rw [mem_maximalIdeal_sq_iff_forall_apply_mem hx hD (sub_mem ha hm)]
    intro i
    have hci := congr_fun hc i
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at hci
    rw [← residue_eq_zero_iff]
    simp [Derivation.leibniz, (residue_eq_zero_iff _).2 (hw _), hc', hci]
  simpa using Submodule.add_mem_sup hspan hsq

omit [DecidableEq ι] in
/-- The gradient of an element of the ideal generated by `wₖ ∈ 𝔪` is a combination of the
gradients of the `wₖ`, a partial converse of `TauCeti.mem_span_range_sup_maximalIdeal_sq`. -/
theorem residue_apply_mem_span_range_of_mem_span {w : κ → Q} (hw : ∀ k, w k ∈ maximalIdeal Q)
    {a : Q} (ha : a ∈ Ideal.span (Set.range w)) :
    (fun i ↦ residue Q (D i a)) ∈ Submodule.span (ResidueField Q)
      (Set.range fun k i ↦ residue Q (D i (w k))) := by
  induction ha using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨k, rfl⟩ := ha
    exact Submodule.subset_span ⟨k, rfl⟩
  | zero =>
    simp only [map_zero]
    exact zero_mem _
  | add a a' _ _ h h' =>
    simp only [map_add]
    exact add_mem h h'
  | smul r a ha h =>
    have ha' : residue Q a = 0 :=
      (residue_eq_zero_iff a).2 (Ideal.span_le.2 (Set.range_subset_iff.2 hw) ha)
    convert Submodule.smul_mem _ (residue Q r) h using 1
    ext i
    simp [Derivation.leibniz, ha']

/-- **Nakayama's lemma in coordinates.** Elements of `𝔪` whose gradients span `κⁿ` generate
`𝔪`. -/
theorem maximalIdeal_eq_span_range_of_span_eq_top [Finite ι] [Finite κ]
    (hx : maximalIdeal Q = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {w : κ → Q}
    (hw : ∀ k, w k ∈ maximalIdeal Q)
    (h : Submodule.span (ResidueField Q) (Set.range fun k i ↦ residue Q (D i (w k))) = ⊤) :
    maximalIdeal Q = Ideal.span (Set.range w) := by
  refine le_antisymm ?_ (Ideal.span_le.2 (Set.range_subset_iff.2 hw))
  refine Submodule.le_of_le_smul_of_le_jacobson_bot
    (hx ▸ Submodule.fg_span (Set.finite_range x)) (jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge ?_
  intro a ha
  rw [smul_eq_mul, ← sq]
  exact mem_span_range_sup_maximalIdeal_sq hx hD hw ha (h ▸ Submodule.mem_top)

end Gradient

section Kaehler

variable {K Q : Type*} [CommRing K] [CommRing Q] [Algebra K Q]

/-- **Change of coordinates.** If `Ω[Q⁄K]` has a basis `b` indexed by `ι`, and `w` is a family of
`|ι|` elements whose gradients, the residues of their coordinates in `b`, are linearly
independent, then the differentials `dwₖ` form a basis of `Ω[Q⁄K]`. -/
theorem exists_basis_kaehlerDifferential_of_linearIndependent {ι κ : Type*} [IsLocalRing Q]
    [Fintype ι] [Fintype κ] (b : Basis ι Q Ω[Q⁄K]) {w : κ → Q}
    (hcard : Fintype.card κ = Fintype.card ι)
    (h : LinearIndependent (ResidueField Q) fun k i ↦ residue Q (b.coord i (D K Q (w k)))) :
    ∃ b' : Basis κ Q Ω[Q⁄K], ∀ k, b' k = D K Q (w k) := by
  classical
  let e : κ ≃ ι := Fintype.equivOfCardEq hcard
  -- The matrix of the differentials `dwₖ` in the basis `b`, with columns reindexed by `ι`.
  let M : Matrix ι ι Q := Matrix.of fun i j ↦ b.coord i (D K Q (w (e.symm j)))
  have hM : IsUnit M.det := by
    have : IsUnit (M.map (residue Q)) := by
      rw [← Matrix.linearIndependent_col_iff_isUnit]
      exact h.comp e.symm e.symm.injective
    rw [Matrix.isUnit_iff_isUnit_det, ← RingHom.mapMatrix_apply, ← RingHom.map_det] at this
    exact isUnit_of_map_unit (residue Q) _ this
  refine ⟨(b.map (Matrix.toLinearEquiv b M hM)).reindex e.symm, fun k ↦ ?_⟩
  simp [M, Matrix.toLin_self, Basis.sum_repr]

/-- **Quotient by some coordinates.** If the differentials of `z : κ₁ ⊕ κ₂ → Q` form a basis of
`Ω[Q⁄K]`, then the differentials of the remaining elements `z (inr j)` form a basis of the
differentials of `Q ⧸ (z (inl i) : i ∈ κ₁)`. -/
theorem exists_basis_kaehlerDifferential_quotient {κ₁ κ₂ : Type*}
    (b : Basis (κ₁ ⊕ κ₂) Q Ω[Q⁄K]) {z : κ₁ ⊕ κ₂ → Q} (hb : ∀ k, b k = D K Q (z k)) :
    ∃ b' : Basis κ₂ (Q ⧸ Ideal.span (Set.range (z ∘ Sum.inl)))
        Ω[(Q ⧸ Ideal.span (Set.range (z ∘ Sum.inl)))⁄K],
      ∀ j, b' j = D K _ (Ideal.Quotient.mk _ (z (.inr j))) := by
  classical
  set J := Ideal.span (Set.range (z ∘ Sum.inl))
  set v : κ₂ → Ω[(Q ⧸ J)⁄K] := fun j ↦ D K _ (Ideal.Quotient.mk J (z (.inr j)))
  -- The coordinate derivations along the remaining coordinates preserve `J`.
  have hJ (j : κ₂) (a : Q) (ha : a ∈ J) : (b.coord (.inr j)).compDer (D K Q) a ∈ J := by
    induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨i, rfl⟩ := ha
      simp [← hb]
    | zero => simp
    | add a a' _ _ h h' => simpa using add_mem h h'
    | smul r a ha h =>
      rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact add_mem (Ideal.mul_mem_left _ _ h) (Ideal.mul_mem_right _ _ ha)
  have hd (j : κ₂) (a : Q) (ha : Ideal.Quotient.mkₐ K J a = 0) :
      Ideal.Quotient.mkₐ K J ((b.coord (.inr j)).compDer (D K Q) a) = 0 := by
    simp only [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at ha ⊢
    exact hJ j a ha
  -- They descend to derivations of `Q ⧸ J`, dual to the differentials of the remaining `z`.
  let δ (j : κ₂) : Derivation K (Q ⧸ J) (Q ⧸ J) :=
    Derivation.liftOfSurjective (Ideal.Quotient.mkₐ_surjective K J) (hd j)
  have hδ (j : κ₂) (k : κ₁ ⊕ κ₂) :
      (δ j).liftKaehlerDifferential (D K _ (Ideal.Quotient.mk J (z k))) =
        if k = .inr j then 1 else 0 := by
    rw [Derivation.liftKaehlerDifferential_comp_D, ← Ideal.Quotient.mkₐ_eq_mk K]
    simp only [δ]
    rw [Derivation.liftOfSurjective_apply]
    simp [← hb, Finsupp.single_apply]
  have hli : LinearIndependent (Q ⧸ J) v := by
    rw [linearIndependent_iff']
    intro s c hc j hj
    have := congrArg (δ j).liftKaehlerDifferential hc
    simp only [map_sum, map_smul, v, hδ, Sum.inr.injEq, smul_eq_mul, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq', hj, ite_true, map_zero] at this
    exact this
  have hsp : ⊤ ≤ Submodule.span (Q ⧸ J) (Set.range v) := by
    rw [← span_range_derivation, Submodule.span_le]
    rintro _ ⟨p, rfl⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective p
    have ha : D K Q a ∈ Submodule.span Q (Set.range b) := b.mem_span _
    have hmap : ∀ ω ∈ Submodule.span Q (Set.range b),
        map K K Q (Q ⧸ J) ω ∈ (Submodule.span (Q ⧸ J) (Set.range v)).restrictScalars Q := by
      intro ω hω
      induction hω using Submodule.span_induction with
      | mem ω hω =>
        obtain ⟨k, rfl⟩ := hω
        rw [hb, map_D]
        rcases k with i | j
        · have hz : Ideal.Quotient.mk J (z (.inl i)) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨i, rfl⟩)
          simp [Ideal.Quotient.algebraMap_eq, hz]
        · exact Submodule.subset_span ⟨j, rfl⟩
      | zero => simp
      | add ω ω' _ _ h h' => simpa using add_mem h h'
      | smul r ω _ h => simpa using Submodule.smul_of_tower_mem _ r h
    simpa [map_D, Ideal.Quotient.algebraMap_eq] using hmap _ ha
  exact ⟨Basis.mk hli hsp, fun j ↦ Basis.mk_apply _ _ _⟩

end Kaehler

section Presentation

/-- Lifts to `Q` of a basis of the cotangent space of a quotient `A` of `Q` span `𝔪_Q` modulo
`ker π + 𝔪_Q²`, and are linearly independent modulo it. -/
private theorem exists_lift_finBasis_cotangentSpace {Q A : Type*} [CommRing Q] [IsLocalRing Q]
    [CommRing A] [IsLocalRing A] (hfg : (maximalIdeal Q).FG) (π : Q →+* A)
    (hπ : Function.Surjective π) :
    ∃ y : Fin (finrank (ResidueField A) (CotangentSpace A)) → Q,
      (∀ j, y j ∈ maximalIdeal Q) ∧
      (∀ a ∈ maximalIdeal Q, a ∈ Ideal.span (Set.range y) ⊔ (RingHom.ker π ⊔ maximalIdeal Q ^ 2)) ∧
      ∀ c : Fin (finrank (ResidueField A) (CotangentSpace A)) → Q,
        ∑ j, c j * y j ∈ RingHom.ker π ⊔ maximalIdeal Q ^ 2 → ∀ j, c j ∈ maximalIdeal Q := by
  set e := finrank (ResidueField A) (CotangentSpace A)
  set I := RingHom.ker π
  have hπ𝔪 : (maximalIdeal Q).map π = maximalIdeal A := map_maximalIdeal_of_surjective π hπ
  have : IsLocalHom π := .of_surjective π hπ
  have : Module.Finite A (maximalIdeal A) := Module.Finite.iff_fg.2 (hπ𝔪 ▸ hfg.map π)
  have : Module.Finite A (CotangentSpace A) :=
    .of_surjective _ (maximalIdeal A).toCotangent_surjective
  have : Module.Finite (ResidueField A) (CotangentSpace A) :=
    .of_restrictScalars_finite A _ _
  let bA := Module.finBasisOfFinrankEq (ResidueField A) (CotangentSpace A) rfl
  choose m hm using fun j ↦ (maximalIdeal A).toCotangent_surjective (bA j)
  choose y hy using fun j ↦ hπ (m j : A)
  have hy𝔪 (j : Fin e) : y j ∈ maximalIdeal Q := by
    rw [← maximalIdeal_comap π, Ideal.mem_comap, hy]
    exact (m j).2
  have hsum𝔪 (c : Fin e → Q) : π (∑ j, c j * y j) ∈ maximalIdeal A :=
    hπ𝔪 ▸ Ideal.mem_map_of_mem π (Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_left _ _ (hy𝔪 j))
  have hcot (c : Fin e → Q) : (maximalIdeal A).toCotangent ⟨_, hsum𝔪 c⟩ =
      ∑ j, residue A (π (c j)) • bA j := by
    have : (⟨_, hsum𝔪 c⟩ : maximalIdeal A) = ∑ j, π (c j) • m j := by
      ext
      simp [hy]
    rw [this, map_sum]
    simp [hm, ← ResidueField.algebraMap_eq, algebraMap_smul]
  have hsq (a : Q) : π a ∈ maximalIdeal A ^ 2 ↔ a ∈ I ⊔ maximalIdeal Q ^ 2 := by
    rw [← hπ𝔪, ← Ideal.map_pow, ← Ideal.mem_comap, Ideal.comap_map_of_surjective _ hπ,
      ← RingHom.ker_eq_comap_bot, sup_comm]
  -- The `yⱼ` together with `I` span `𝔪` modulo `𝔪²` ...
  have hcov (a : Q) (ha : a ∈ maximalIdeal Q) :
      a ∈ Ideal.span (Set.range y) ⊔ (I ⊔ maximalIdeal Q ^ 2) := by
    have haA : π a ∈ maximalIdeal A := hπ𝔪 ▸ Ideal.mem_map_of_mem π ha
    choose c hc using fun j ↦ (residue_surjective.comp hπ) (bA.repr
      ((maximalIdeal A).toCotangent ⟨_, haA⟩) j)
    have hspan : ∑ j, c j * y j ∈ Ideal.span (Set.range y) :=
      Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
    have hrest : a - ∑ j, c j * y j ∈ I ⊔ maximalIdeal Q ^ 2 := by
      have hmem : π (a - ∑ j, c j * y j) ∈ maximalIdeal A :=
        (map_sub π _ _) ▸ sub_mem haA (hsum𝔪 c)
      rw [← hsq, ← Ideal.toCotangent_eq_zero _ ⟨_, hmem⟩]
      have : (⟨_, hmem⟩ : maximalIdeal A) = ⟨_, haA⟩ - ⟨_, hsum𝔪 c⟩ :=
        Subtype.ext (map_sub π _ _)
      rw [this, map_sub, hcot]
      simp only [Function.comp_apply] at hc
      simp [hc, Basis.sum_repr]
    simpa using Submodule.add_mem_sup hspan hrest
  -- ... and are linearly independent modulo `I + 𝔪²`.
  have hind (c : Fin e → Q) (hc : ∑ j, c j * y j ∈ I ⊔ maximalIdeal Q ^ 2) (j : Fin e) :
      c j ∈ maximalIdeal Q := by
    rw [← hsq, ← Ideal.toCotangent_eq_zero _ ⟨_, hsum𝔪 c⟩, hcot] at hc
    have := (Fintype.linearIndependent_iff.1 bA.linearIndependent _ hc) j
    rw [residue_eq_zero_iff, ← Ideal.mem_comap, maximalIdeal_comap] at this
    exact this
  exact ⟨y, hy𝔪, hcov, hind⟩


variable {K Q A ι σ : Type*} [CommRing K] [CommRing Q] [Algebra K Q] [IsLocalRing Q]
  [Fintype ι] [CommRing A] [IsLocalRing A]

/-- **Minimal presentation of a quotient of a local ring with coordinates.** Let the
differentials `dxᵢ` of generators `x : ι → Q` of `𝔪` form a basis of `Ω[Q⁄K]`, and let
`A = Q ⧸ (g_s : s ∈ σ)` be a quotient with cotangent space `𝔪_A / 𝔪_A²` of dimension `e`.
Then there are `n - e` of the relations, indexed by `T ⊆ σ`, and `e` elements `y : Fin e → Q`,
which together generate `𝔪`, such that `P = Q ⧸ (g_s : s ∈ T)` has the coordinate system `y`: the
differentials `dyⱼ` form a basis of `Ω[P⁄K]`. All relations lie in `(g_s : s ∈ T) + 𝔪²`, so `A`
is the quotient of `P` by relations in `𝔪_P²`. -/
theorem exists_minimal_presentation [Finite σ] (b : Basis ι Q Ω[Q⁄K]) {x : ι → Q}
    (hx : maximalIdeal Q = Ideal.span (Set.range x)) (hb : ∀ i, b i = D K Q (x i))
    (π : Q →+* A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g)) :
    ∃ (T : Set σ) (y : Fin (finrank (ResidueField A) (CotangentSpace A)) → Q)
      (b' : Basis (Fin (finrank (ResidueField A) (CotangentSpace A))) (Q ⧸ Ideal.span (g '' T))
        Ω[(Q ⧸ Ideal.span (g '' T))⁄K]),
      T.ncard + finrank (ResidueField A) (CotangentSpace A) = Fintype.card ι ∧
      maximalIdeal Q = Ideal.span (g '' T) ⊔ Ideal.span (Set.range y) ∧
      (∀ j, b' j = D K _ (Ideal.Quotient.mk _ (y j))) ∧
      ∀ s, g s ∈ Ideal.span (g '' T) ⊔ maximalIdeal Q ^ 2 := by
  classical
  set e := finrank (ResidueField A) (CotangentSpace A)
  -- The coordinate derivations and the gradient.
  set δ : ι → Derivation K Q Q := fun i ↦ (b.coord i).compDer (D K Q)
  have hD (i j : ι) : δ i (x j) = if i = j then 1 else 0 := by
    simp [δ, ← hb, Finsupp.single_apply, eq_comm]
  set grad : Q → ι → ResidueField Q := fun a i ↦ residue Q (δ i a)
  have hg𝔪 (s : σ) : g s ∈ maximalIdeal Q :=
    le_maximalIdeal (RingHom.ker_ne_top π) (hg ▸ Ideal.subset_span ⟨s, rfl⟩)
  -- Lifts `y` of a basis of the cotangent space of `A`.
  obtain ⟨y, hy𝔪, hcov, hind⟩ :=
    exists_lift_finBasis_cotangentSpace (hx ▸ Submodule.fg_span (Set.finite_range x)) π hπ
  -- Choose relations `g_s`, `s ∈ T`, whose gradients form a basis of the span `W` of all of them.
  obtain ⟨τ, a, ha, hspanW, hliW⟩ := exists_linearIndependent' (ResidueField Q) (grad ∘ g)
  set T : Set σ := Set.range a
  have : Fintype T := Fintype.ofFinite T
  have hliT : LinearIndependent (ResidueField Q) fun t : T ↦ grad (g t) :=
    (linearIndepOn_range_iff ha _).2 hliW
  set W := Submodule.span (ResidueField Q) (Set.range (grad ∘ g))
  have hWT : Submodule.span (ResidueField Q) (Set.range fun t : T ↦ grad (g t)) = W := by
    rw [← hspanW, Set.range_comp, Set.image_eq_range]
    rfl
  -- The gradient of a combination of the `yⱼ`.
  have hgrad (c : Fin e → Q) : grad (∑ j, c j * y j) = ∑ j, residue Q (c j) • grad (y j) := by
    ext i
    simp [grad, Derivation.leibniz, (residue_eq_zero_iff _).2 (hy𝔪 _)]
  have hindW (c : Fin e → ResidueField Q) (hc : ∑ j, c j • grad (y j) ∈ W) : c = 0 := by
    choose c' hc' using fun j ↦ residue_surjective (c j)
    have hm : ∑ j, c' j * y j ∈ maximalIdeal Q :=
      Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_left _ _ (hy𝔪 j)
    simp only [← hc'] at hc
    have hgW : grad (∑ j, c' j * y j) ∈ W := by
      rw [hgrad]
      exact hc
    have := mem_span_range_sup_maximalIdeal_sq hx hD hg𝔪 hm hgW
    rw [← hg] at this
    ext j
    rw [Pi.zero_apply, ← hc', residue_eq_zero_iff]
    exact hind c' this j
  -- The new coordinates: the chosen relations together with `y`.
  set z : T ⊕ Fin e → Q := Sum.elim (fun t ↦ g t) y
  have hz𝔪 (k : T ⊕ Fin e) : z k ∈ maximalIdeal Q := by
    rcases k with t | j
    · exact hg𝔪 t
    · exact hy𝔪 j
  have hliz : LinearIndependent (ResidueField Q) (grad ∘ z) := by
    have : grad ∘ z = Sum.elim (fun t : T ↦ grad (g t)) (grad ∘ y) := by
      ext (t | j) <;> rfl
    rw [this]
    refine hliT.sum_type (Fintype.linearIndependent_iff.2 fun c hc ↦ ?_) ?_
    · exact congr_fun (hindW c (hc ▸ zero_mem W)) 
    · rw [hWT, Submodule.disjoint_def]
      intro v hvW hv
      obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hv
      simp [hindW c hvW]
  have hspz : Submodule.span (ResidueField Q) (Set.range (grad ∘ z)) = ⊤ := by
    rw [eq_top_iff, ← (Pi.basisFun (ResidueField Q) ι).span_eq, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    have hxi : grad (x i) = Pi.basisFun (ResidueField Q) ι i := by
      ext i'
      simp [grad, hD, Pi.single_apply]
    have hadd (a a' : Q) : grad (a + a') = grad a + grad a' := by
      ext
      simp [grad]
    have hWS : W ≤ Submodule.span (ResidueField Q) (Set.range (grad ∘ z)) :=
      hWT ▸ Submodule.span_mono (by rintro _ ⟨t, rfl⟩; exact ⟨.inl t, rfl⟩)
    have hYS : Submodule.span (ResidueField Q) (Set.range (grad ∘ y)) ≤
        Submodule.span (ResidueField Q) (Set.range (grad ∘ z)) :=
      Submodule.span_mono (by rintro _ ⟨j, rfl⟩; exact ⟨.inr j, rfl⟩)
    obtain ⟨u, hu, v, hv, huv⟩ :=
      Submodule.mem_sup.1 (hcov (x i) (hx ▸ Ideal.subset_span ⟨i, rfl⟩))
    obtain ⟨v₁, hv₁, v₂, hv₂, rfl⟩ := Submodule.mem_sup.1 hv
    have h₂ : grad v₂ = 0 := by
      ext i'
      simp [grad, (residue_eq_zero_iff _).2 ((δ i').apply_mem_of_mem_sq hv₂)]
    rw [← hxi, ← huv, hadd, hadd, h₂, add_zero]
    exact add_mem (hYS (residue_apply_mem_span_range_of_mem_span hy𝔪 hu))
      (hWS (residue_apply_mem_span_range_of_mem_span hg𝔪 (hg ▸ hv₁)))
  -- There are `n` new coordinates, so their differentials form a basis of `Ω[Q⁄K]`.
  have hcard : Fintype.card (T ⊕ Fin e) = Fintype.card ι := by
    have := Module.finrank_eq_card_basis (Basis.mk hliz hspz.ge)
    rw [Module.finrank_fintype_fun_eq_card] at this
    exact this.symm
  obtain ⟨b₂, hb₂⟩ := exists_basis_kaehlerDifferential_of_linearIndependent b hcard hliz
  have hrange : Set.range (z ∘ Sum.inl) = g '' T := by
    rw [Set.image_eq_range]
    rfl
  have key := exists_basis_kaehlerDifferential_quotient b₂ hb₂
  rw [hrange] at key
  obtain ⟨b', hb'⟩ := key
  refine ⟨T, y, b', ?_, ?_, fun j ↦ hb' j, fun s ↦ ?_⟩
  · rw [Fintype.card_sum, Fintype.card_fin] at hcard
    rw [← Nat.card_coe_set_eq, Nat.card_eq_fintype_card, hcard]
  · rw [maximalIdeal_eq_span_range_of_span_eq_top hx hD hz𝔪 hspz, Set.Sum.elim_range,
      Ideal.span_union, ← Set.image_eq_range]
  · have hgs : (fun i ↦ residue Q (δ i (g s))) ∈
        Submodule.span (ResidueField Q) (Set.range fun t : T ↦ grad (g t)) :=
      hWT ▸ Submodule.subset_span ⟨s, rfl⟩
    have := mem_span_range_sup_maximalIdeal_sq hx hD (w := fun t : T ↦ g t) (fun t ↦ hg𝔪 t)
      (hg𝔪 s) hgs
    rwa [← Set.image_eq_range] at this

/-- **A quotient by `n - e + 1` relations is a hypersurface.** In the setting of
`TauCeti.exists_minimal_presentation`, suppose that `A = Q ⧸ (g_s : s ∈ σ)` has a cotangent
space of dimension `e` and that there are `n - e + 1` relations. Then all relations but one,
`g_{s₀}`, cut out a local ring `P = Q ⧸ (g_s : s ≠ s₀)` with the coordinate system `y : Fin e → Q`,
and `A = P ⧸ (g_{s₀})` with `g_{s₀} ∈ 𝔪_P²`. For a complete intersection curve with a
two-dimensional cotangent space, such as a node, this exhibits `A` as a plane curve
singularity. -/
theorem exists_hypersurface_presentation [Fintype σ] (b : Basis ι Q Ω[Q⁄K]) {x : ι → Q}
    (hx : maximalIdeal Q = Ideal.span (Set.range x)) (hb : ∀ i, b i = D K Q (x i))
    (π : Q →+* A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g))
    (hσ : Fintype.card σ + finrank (ResidueField A) (CotangentSpace A) = Fintype.card ι + 1) :
    ∃ (s₀ : σ) (y : Fin (finrank (ResidueField A) (CotangentSpace A)) → Q)
      (b' : Basis (Fin (finrank (ResidueField A) (CotangentSpace A)))
        (Q ⧸ Ideal.span (g '' {s₀}ᶜ)) Ω[(Q ⧸ Ideal.span (g '' {s₀}ᶜ))⁄K]),
      maximalIdeal Q = Ideal.span (g '' {s₀}ᶜ) ⊔ Ideal.span (Set.range y) ∧
      (∀ j, b' j = D K _ (Ideal.Quotient.mk _ (y j))) ∧
      RingHom.ker π = Ideal.span (g '' {s₀}ᶜ) ⊔ Ideal.span {g s₀} ∧
      g s₀ ∈ Ideal.span (g '' {s₀}ᶜ) ⊔ maximalIdeal Q ^ 2 := by
  obtain ⟨T, y, b', hT, hy, hb', hgT⟩ := exists_minimal_presentation b hx hb π hπ hg
  -- Exactly one relation is left over.
  have hTc : Tᶜ.ncard = 1 := by
    have := Set.ncard_add_ncard_compl T
    rw [Nat.card_eq_fintype_card] at this
    omega
  obtain ⟨s₀, hs₀⟩ := Set.ncard_eq_one.1 hTc
  obtain rfl : T = {s₀}ᶜ := by rw [← hs₀, compl_compl]
  refine ⟨s₀, y, b', hy, hb', ?_, hgT s₀⟩
  rw [hg, ← Ideal.span_union, ← Set.image_singleton, ← Set.image_union, Set.compl_union_self,
    Set.image_univ]

end Presentation

end TauCeti
