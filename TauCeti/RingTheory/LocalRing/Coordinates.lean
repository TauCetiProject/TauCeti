/-!
# Local coordinates and minimal presentations

Let `Q` be a local ring whose maximal ideal `𝔪` is generated by coordinates `x : ι → Q`, with
dual derivations `Dᵢ xⱼ = δᵢⱼ`. The *gradient* of `a ∈ Q` is the residue of `(D₁ a, …, Dₙ a)`.
By the first-order Taylor expansion, an element `a ∈ 𝔪` lies in `𝔪²` exactly when its gradient
vanishes, so on `𝔪 / 𝔪²` the gradient is an isomorphism onto `κⁿ`. This file uses it to change
coordinates and to put a quotient of `Q` in minimal form.

Over a ring `K`, say that `x` is a coordinate system of the local `K`-algebra `Q` if `x` generates
`𝔪` and the differentials `dxᵢ` form a basis of `Ω[Q⁄K]`; the dual derivations are then the
coordinate functions of this basis. This is the setting of
`TauCeti.mem_maximalIdeal_sq_and_isUnit_det_hessian_of_formallyUnramified`, for instance the local
ring at a closed point of a smooth variety with separable residue field.

Coordinate systems exist whenever `Ω[Q⁄K]` is free of finite rank, `𝔪` is finitely generated and
the residue field is formally étale over `K`, for instance finite separable over a field `K`: by
the conormal sequence, `𝔪 / 𝔪²` is then the fibre of `Ω[Q⁄K]` at the closed point, and lifts to
`𝔪` of the basis of this fibre are coordinates.

For a local quotient `A = Q ⧸ (g₁, …, g_m)` with `e = dim_κ 𝔪_A / 𝔪_A²`, some `n - e` of the
relations `g_s` together with `e` further elements generate `𝔪`. Dividing out by those `n - e`
relations gives a local ring `P` with a coordinate system of `e` elements, and the remaining
relations lie in `𝔪_P²`. This is a minimal presentation of `A`. When `m = n - e + 1`,
as for the local ring at a point of a complete intersection curve in affine `n`-space with
`e = 2`, a single relation `f` remains and `A ≅ P ⧸ (f)` is a plane curve singularity, to which
`TauCeti.mem_maximalIdeal_sq_and_isUnit_det_hessian_of_formallyUnramified` applies.

## Main results

* `TauCeti.maximalIdeal_eq_span_range_of_span_eq_top`: elements of `𝔪` whose gradients span `κⁿ`
  generate `𝔪`.
* `TauCeti.span_residue_apply_eq_top_of_le_span_sup_sq`: conversely, elements of `𝔪` that span
  `𝔪` modulo `𝔪²` have gradients spanning `κⁿ`.
* `TauCeti.linearIndependent_residue_apply_sum_elim`: completing elements with independent
  gradients by elements independent modulo them and `𝔪²` keeps the gradients independent.
* `TauCeti.exists_coordinates`: a coordinate system exists when `Ω[Q⁄K]` has a finite basis, `𝔪`
  is finitely generated and the residue field is formally étale over `K`.
* `TauCeti.exists_minimal_presentation`: the minimal presentation of a quotient of `Q`.
* `TauCeti.exists_hypersurface_presentation`: a quotient of `Q` by `n - e + 1` relations is a
  hypersurface in a local ring with `e` coordinates.

## References

* [Stacks Project, Tag 00RU](https://stacks.math.columbia.edu/tag/00RU): the conormal sequence.
* [Stacks Project, Tag 031I](https://stacks.math.columbia.edu/tag/031I): the conormal sequence of a
  formally smooth quotient is split exact on the left.
* [Stacks Project, Section 53.19, Tag 0C46](https://stacks.math.columbia.edu/tag/0C46): nodes of
  curves, plane curve singularities defined by a nondegenerate quadratic form.
-/

public section

noncomputable section

open IsLocalRing KaehlerDifferential Module TensorProduct

namespace TauCeti

section Gradient

variable {R Q ι κ : Type*} [CommSemiring R] [CommRing Q] [Algebra R Q] [IsLocalRing Q]
  [DecidableEq ι] {x : ι → Q} {D : ι → Derivation R Q Q}

omit [DecidableEq ι] in
/-- The gradient of `a * b` with `b ∈ 𝔪` is the residue of `a` times the gradient of `b`. -/
theorem residue_apply_mul_of_mem (a : Q) {b : Q} (hb : b ∈ maximalIdeal Q) :
    (fun i ↦ residue Q (D i (a * b))) = residue Q a • fun i ↦ residue Q (D i b) := by
  ext i
  simp [Derivation.leibniz, (residue_eq_zero_iff _).2 hb]

omit [DecidableEq ι] in
/-- The gradient of a combination `∑ cₖ wₖ` of elements `wₖ ∈ 𝔪` is the combination of their
gradients with coefficients the residues of the `cₖ`. -/
theorem residue_apply_sum_mul [Fintype κ] (c : κ → Q) {w : κ → Q}
    (hw : ∀ k, w k ∈ maximalIdeal Q) :
    (fun i ↦ residue Q (D i (∑ k, c k * w k))) =
      ∑ k, residue Q (c k) • fun i ↦ residue Q (D i (w k)) := by
  ext i
  simp [Derivation.leibniz, (residue_eq_zero_iff _).2 (hw _)]

omit [DecidableEq ι] in
/-- The gradient vanishes on `𝔪²`. -/
theorem residue_apply_eq_zero_of_mem_sq {a : Q} (ha : a ∈ maximalIdeal Q ^ 2) :
    (fun i ↦ residue Q (D i a)) = 0 := by
  ext i
  exact (residue_eq_zero_iff _).2 ((D i).apply_mem_of_mem_sq ha)

/-- If the gradient of `a ∈ 𝔪` is a combination of the gradients of elements `wₖ ∈ 𝔪`, then `a`
is a combination of the `wₖ` modulo `𝔪²`. -/
theorem mem_span_range_sup_maximalIdeal_sq [Finite ι] [Finite κ]
    (hx : maximalIdeal Q = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {w : κ → Q}
    (hw : ∀ k, w k ∈ maximalIdeal Q) {a : Q} (ha : a ∈ maximalIdeal Q)
    (h : (fun i ↦ residue Q (D i a)) ∈ Submodule.span (ResidueField Q)
      (Set.range fun k i ↦ residue Q (D i (w k)))) :
    a ∈ Ideal.span (Set.range w) ⊔ maximalIdeal Q ^ 2 := by
  have := Fintype.ofFinite κ
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 h
  obtain ⟨c', rfl⟩ := residue_surjective.comp_left c
  have hspan : ∑ k, c' k * w k ∈ Ideal.span (Set.range w) :=
    Ideal.sum_mem _ fun k _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
  have hm : ∑ k, c' k * w k ∈ maximalIdeal Q :=
    Ideal.sum_mem _ fun k _ ↦ Ideal.mul_mem_left _ _ (hw k)
  have hsq : a - ∑ k, c' k * w k ∈ maximalIdeal Q ^ 2 := by
    rw [mem_maximalIdeal_sq_iff_forall_apply_mem hx hD (sub_mem ha hm)]
    intro i
    have := congr_fun (residue_apply_sum_mul (D := D) c' hw) i
    simp only [Function.comp_apply] at hc
    rw [← residue_eq_zero_iff, map_sub, map_sub, sub_eq_zero, this]
    exact (congr_fun hc i).symm
  simpa using Submodule.add_mem_sup hspan hsq

omit [DecidableEq ι] in
/-- The gradient of an element of the ideal generated by `wₖ ∈ 𝔪` is a combination of the
gradients of the `wₖ`, a partial converse of `TauCeti.mem_span_range_sup_maximalIdeal_sq`. -/
theorem residue_apply_mem_span_range_of_mem_span {w : κ → Q} (hw : ∀ k, w k ∈ maximalIdeal Q)
    {a : Q} (ha : a ∈ Ideal.span (Set.range w)) :
    (fun i ↦ residue Q (D i a)) ∈ Submodule.span (ResidueField Q)
      (Set.range fun k i ↦ residue Q (D i (w k))) := by
  induction ha using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨k, rfl⟩ := ha
    exact Submodule.subset_span ⟨k, rfl⟩
  | zero =>
    simp only [map_zero]
    exact zero_mem _
  | add a a' _ _ h h' =>
    simp only [map_add]
    exact add_mem h h'
  | smul r a ha h =>
    rw [smul_eq_mul, residue_apply_mul_of_mem r (Ideal.span_le.2 (Set.range_subset_iff.2 hw) ha)]
    exact Submodule.smul_mem _ _ h

/-- **Nakayama's lemma in coordinates.** Elements of `𝔪` whose gradients span `κⁿ` generate
`𝔪`. -/
theorem maximalIdeal_eq_span_range_of_span_eq_top [Finite ι] [Finite κ]
    (hx : maximalIdeal Q = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {w : κ → Q}
    (hw : ∀ k, w k ∈ maximalIdeal Q)
    (h : Submodule.span (ResidueField Q) (Set.range fun k i ↦ residue Q (D i (w k))) = ⊤) :
    maximalIdeal Q = Ideal.span (Set.range w) := by
  refine le_antisymm ?_ (Ideal.span_le.2 (Set.range_subset_iff.2 hw))
  refine Submodule.le_of_le_smul_of_le_jacobson_bot
    (hx ▸ Submodule.fg_span (Set.finite_range x)) (jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge ?_
  intro a ha
  rw [smul_eq_mul, ← sq]
  exact mem_span_range_sup_maximalIdeal_sq hx hD hw ha (h ▸ Submodule.mem_top)

/-- Elements of `𝔪` that span `𝔪` modulo `𝔪²` have gradients spanning `κⁿ`, the converse of
`TauCeti.maximalIdeal_eq_span_range_of_span_eq_top`. -/
theorem span_residue_apply_eq_top_of_le_span_sup_sq [Finite ι]
    (hx : ∀ i, x i ∈ maximalIdeal Q)
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {w : κ → Q}
    (hw : ∀ k, w k ∈ maximalIdeal Q)
    (h : maximalIdeal Q ≤ Ideal.span (Set.range w) ⊔ maximalIdeal Q ^ 2) :
    Submodule.span (ResidueField Q) (Set.range fun k i ↦ residue Q (D i (w k))) = ⊤ := by
  rw [eq_top_iff, ← (Pi.basisFun (ResidueField Q) ι).span_eq, Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.1 (h (hx i))
  have hxi : (fun i' ↦ residue Q (D i' (x i))) = Pi.basisFun (ResidueField Q) ι i := by
    ext i'
    simp [hD, Pi.single_apply]
  have hgrad : (fun i' ↦ residue Q (D i' (x i))) = fun i' ↦ residue Q (D i' u) := by
    ext i'
    simp [← huv, congr_fun (residue_apply_eq_zero_of_mem_sq (D := D) hv) i']
  rw [← hxi, hgrad]
  exact residue_apply_mem_span_range_of_mem_span hw hu

/-- Let `wₖ ∈ 𝔪` have linearly independent gradients, and let `yⱼ ∈ 𝔪` be linearly independent
modulo `(wₖ) + 𝔪²`: a combination `∑ cⱼ yⱼ` lies in `(wₖ) + 𝔪²` only if every `cⱼ ∈ 𝔪`. Then the
gradients of the `wₖ` and the `yⱼ` together are linearly independent. -/
theorem linearIndependent_residue_apply_sum_elim {κ' : Type*} [Finite ι] [Finite κ]
    [Fintype κ'] (hx : maximalIdeal Q = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {w : κ → Q} {y : κ' → Q}
    (hw : ∀ k, w k ∈ maximalIdeal Q) (hy : ∀ j, y j ∈ maximalIdeal Q)
    (hli : LinearIndependent (ResidueField Q) fun k i ↦ residue Q (D i (w k)))
    (hind : ∀ c : κ' → Q, ∑ j, c j * y j ∈ Ideal.span (Set.range w) ⊔ maximalIdeal Q ^ 2 →
      ∀ j, c j ∈ maximalIdeal Q) :
    LinearIndependent (ResidueField Q) (Sum.elim (fun k i ↦ residue Q (D i (w k)))
      fun j i ↦ residue Q (D i (y j))) := by
  -- A combination of the gradients of the `yⱼ` in the span of those of the `wₖ` is trivial.
  have key (c : κ' → ResidueField Q) (hc : ∑ j, c j • (fun i ↦ residue Q (D i (y j))) ∈
      Submodule.span (ResidueField Q) (Set.range fun k i ↦ residue Q (D i (w k)))) : c = 0 := by
    obtain ⟨c', rfl⟩ := residue_surjective.comp_left c
    have hm : ∑ j, c' j * y j ∈ maximalIdeal Q :=
      Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_left _ _ (hy j)
    simp only [Function.comp_apply, ← residue_apply_sum_mul c' hy] at hc
    ext j
    simpa [residue_eq_zero_iff] using hind c' (mem_span_range_sup_maximalIdeal_sq hx hD hw hm hc) j
  refine hli.sum_type (Fintype.linearIndependent_iff.2 fun c hc ↦
    congr_fun (key c (hc ▸ zero_mem _))) ?_
  rw [Submodule.disjoint_def]
  intro v hvw hv
  obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hv
  simp [key c hvw]

end Gradient

section Existence

variable {K Q ι : Type*} [CommRing K] [CommRing Q] [Algebra K Q] [IsLocalRing Q] [Finite ι]

/-- **Existence of coordinates.** Let `Q` be a local `K`-algebra whose maximal ideal `𝔪` is finitely
generated, whose differentials `Ω[Q⁄K]` have a basis indexed by `ι`, and whose residue field is
formally étale over `K`. Then there are `x : ι → Q` generating `𝔪` whose differentials `dxᵢ` form a
basis of `Ω[Q⁄K]`. -/
theorem exists_coordinates [Algebra.FormallyEtale K (ResidueField Q)]
    (hfg : (maximalIdeal Q).FG) (b : Basis ι Q Ω[Q⁄K]) :
    ∃ (x : ι → Q) (b' : Basis ι Q Ω[Q⁄K]),
      maximalIdeal Q = Ideal.span (Set.range x) ∧ ∀ i, b' i = D K Q (x i) := by
  classical
  have := Fintype.ofFinite ι
  have hker : RingHom.ker (algebraMap Q (ResidueField Q)) = maximalIdeal Q := by
    rw [ResidueField.algebraMap_eq, ker_residue]
  -- The conormal map `𝔪/𝔪² → κ ⊗[Q] Ω[Q⁄K]` is bijective.
  have hbij := kerCotangentToTensor_bijective_of_formallyEtale (R := K) (P := Q)
    (S := ResidueField Q) residue_surjective
  let bκ := Algebra.TensorProduct.basis (ResidueField Q) b
  have hrepr (ω : Ω[Q⁄K]) (i : ι) :
      bκ.repr ((1 : ResidueField Q) ⊗ₜ ω) i = residue Q (b.repr ω i) := by
    simp [bκ, ResidueField.algebraMap_eq]
  -- Lift the basis of the fibre `κ ⊗[Q] Ω[Q⁄K]` to elements of `𝔪`.
  have hlift (i : ι) : ∃ x ∈ maximalIdeal Q, (1 : ResidueField Q) ⊗ₜ D K Q x = bκ i := by
    obtain ⟨c, hc⟩ := hbij.2 (bκ i)
    obtain ⟨m, rfl⟩ := Ideal.toCotangent_surjective _ c
    exact ⟨m, hker ▸ m.2, by rwa [kerCotangentToTensor_toCotangent] at hc⟩
  choose x hx𝔪 hxb using hlift
  have hδ (k i : ι) : residue Q (b.repr (D K Q (x k)) i) = if k = i then 1 else 0 := by
    rw [← hrepr, hxb, bκ.repr_self, Finsupp.single_apply]
  -- The differentials `dxᵢ` reduce to the basis of the fibre, so they form a basis.
  obtain ⟨b', hb'⟩ := IsLocalRing.exists_basis_of_linearIndependent_residue_coord b rfl
    (v := fun k ↦ D K Q (x k)) <| by
      convert (Pi.basisFun (ResidueField Q) ι).linearIndependent with k i
      simp only [Basis.coord_apply, hδ, Pi.basisFun_apply, Pi.single_apply, eq_comm]
  refine ⟨x, b', le_antisymm ?_ (Ideal.span_le.2 (Set.range_subset_iff.2 hx𝔪)), hb'⟩
  -- Every `a ∈ 𝔪` agrees with a combination of the `xᵢ` modulo `𝔪²`, by injectivity of the
  -- conormal map; Nakayama's lemma concludes.
  refine Submodule.le_of_le_smul_of_le_jacobson_bot hfg (jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge
    fun a ha ↦ ?_
  choose c hc using fun i ↦ residue_surjective (bκ.repr (1 ⊗ₜ D K Q a) i)
  have hmem : a - ∑ i, c i * x i ∈ RingHom.ker (algebraMap Q (ResidueField Q)) :=
    hker ▸ sub_mem ha (Ideal.sum_mem _ fun i _ ↦ Ideal.mul_mem_left _ _ (hx𝔪 i))
  have hzero : (RingHom.ker (algebraMap Q (ResidueField Q))).toCotangent ⟨_, hmem⟩ = 0 := by
    refine hbij.1 ?_
    rw [kerCotangentToTensor_toCotangent, map_zero]
    refine bκ.repr.injective (Finsupp.ext fun i ↦ ?_)
    rw [hrepr, map_zero, Finsupp.coe_zero, Pi.zero_apply, map_sub, map_sub, Finsupp.sub_apply,
      map_sub]
    simp [Derivation.leibniz, (residue_eq_zero_iff _).2 (hx𝔪 _), hδ, hc, hrepr]
  replace hzero : a - ∑ i, c i * x i ∈ maximalIdeal Q ^ 2 := by
    rw [← hker]
    exact (Ideal.toCotangent_eq_zero _ _).1 hzero
  rw [smul_eq_mul, ← sq]
  have : ∑ i, c i * x i ∈ Ideal.span (Set.range x) :=
    Ideal.sum_mem _ fun i _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  simpa using Submodule.add_mem_sup this hzero

end Existence

section Presentation

variable {K Q A ι σ : Type*} [CommRing K] [CommRing Q] [Algebra K Q] [IsLocalRing Q]
  [Fintype ι] [CommRing A] [IsLocalRing A]

/-- **Minimal presentation of a quotient of a local ring with coordinates.** Let the
differentials `dxᵢ` of generators `x : ι → Q` of `𝔪` form a basis of `Ω[Q⁄K]`, and let
`A = Q ⧸ (g_s : s ∈ σ)` be a quotient with cotangent space `𝔪_A / 𝔪_A²` of dimension `e`.
Then there are `n - e` of the relations, indexed by `T ⊆ σ`, and `e` elements `y : Fin e → Q`,
which together generate `𝔪`, such that `P = Q ⧸ (g_s : s ∈ T)` is a local ring with the
coordinate system `y`: the images of the `yⱼ` generate `𝔪_P` and their differentials form a basis
of `Ω[P⁄K]`. All relations lie in `𝔪_P²`, so `A` is the quotient of `P` by relations in `𝔪_P²`. -/
theorem exists_minimal_presentation [Finite σ] (b : Basis ι Q Ω[Q⁄K]) {x : ι → Q}
    (hx : maximalIdeal Q = Ideal.span (Set.range x)) (hb : ∀ i, b i = D K Q (x i))
    (π : Q →+* A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g)) :
    ∃ (T : Set σ) (_ : IsLocalRing (Q ⧸ Ideal.span (g '' T)))
      (y : Fin (finrank (ResidueField A) (CotangentSpace A)) → Q)
      (b' : Basis (Fin (finrank (ResidueField A) (CotangentSpace A))) (Q ⧸ Ideal.span (g '' T))
        Ω[(Q ⧸ Ideal.span (g '' T))⁄K]),
      T.ncard + finrank (ResidueField A) (CotangentSpace A) = Fintype.card ι ∧
      maximalIdeal Q = Ideal.span (g '' T) ⊔ Ideal.span (Set.range y) ∧
      maximalIdeal (Q ⧸ Ideal.span (g '' T)) =
        Ideal.span (Set.range (Ideal.Quotient.mk _ ∘ y)) ∧
      (∀ j, b' j = D K _ (Ideal.Quotient.mk _ (y j))) ∧
      ∀ s, Ideal.Quotient.mk _ (g s) ∈ maximalIdeal (Q ⧸ Ideal.span (g '' T)) ^ 2 := by
  classical
  set e := finrank (ResidueField A) (CotangentSpace A)
  -- The coordinate derivations and the gradient.
  set δ : ι → Derivation K Q Q := fun i ↦ (b.coord i).compDer (D K Q)
  have hD (i j : ι) : δ i (x j) = if i = j then 1 else 0 := by
    simp [δ, ← hb, Finsupp.single_apply, eq_comm]
  set grad : Q → ι → ResidueField Q := fun a i ↦ residue Q (δ i a)
  have hg𝔪 (s : σ) : g s ∈ maximalIdeal Q :=
    le_maximalIdeal (RingHom.ker_ne_top π) (hg ▸ Ideal.subset_span ⟨s, rfl⟩)
  -- Lifts `y` of a basis of the cotangent space of `A`.
  obtain ⟨y, hy𝔪, hcov, hind⟩ := IsLocalRing.exists_lift_finBasis_cotangentSpace
    (hx ▸ Submodule.fg_span (Set.finite_range x)) hπ
  -- Relations `g ∘ a` whose gradients form a basis of the span of the gradients of all of them.
  obtain ⟨τ, a, ha, hspan, hli⟩ := exists_linearIndependent' (ResidueField Q) (grad ∘ g)
  have := Finite.of_injective a ha
  have := Fintype.ofFinite τ
  -- Together with `y`, they are new coordinates: their gradients form a basis of `κⁿ`.
  have hga : Ideal.span (Set.range (g ∘ a)) ≤ RingHom.ker π :=
    hg ▸ Ideal.span_mono (Set.range_comp_subset_range a g)
  have hliz : LinearIndependent (ResidueField Q) (grad ∘ Sum.elim (g ∘ a) y) := by
    rw [Sum.comp_elim]
    exact linearIndependent_residue_apply_sum_elim hx hD (fun t ↦ hg𝔪 (a t)) hy𝔪 hli
      fun c hc ↦ hind c (sup_le_sup_right hga _ hc)
  have hspz : Submodule.span (ResidueField Q) (Set.range (grad ∘ Sum.elim (g ∘ a) y)) = ⊤ := by
    have hcov' : maximalIdeal Q ≤ Ideal.span (Set.range (Sum.elim g y)) ⊔ maximalIdeal Q ^ 2 := by
      rwa [Set.Sum.elim_range, Ideal.span_union, sup_comm (Ideal.span _), sup_assoc, ← hg]
    rw [eq_top_iff, ← span_residue_apply_eq_top_of_le_span_sup_sq
      (fun i ↦ hx ▸ Ideal.subset_span ⟨i, rfl⟩) hD (Sum.forall.2 ⟨hg𝔪, hy𝔪⟩) hcov',
      Submodule.span_le]
    rintro _ ⟨s | j, rfl⟩
    · have hs : grad (g s) ∈ Submodule.span (ResidueField Q) (Set.range (grad ∘ g ∘ a)) :=
        hspan ▸ Submodule.subset_span ⟨s, rfl⟩
      refine Submodule.span_mono ?_ hs
      rintro _ ⟨t, rfl⟩
      exact ⟨.inl t, rfl⟩
    · exact Submodule.subset_span ⟨.inr j, rfl⟩
  -- There are `n` new coordinates, so their differentials form a basis of `Ω[Q⁄K]` ...
  have hcard : Fintype.card (τ ⊕ Fin e) = Fintype.card ι := by
    have := Module.finrank_eq_card_basis (Basis.mk hliz hspz.ge)
    rw [Module.finrank_fintype_fun_eq_card] at this
    exact this.symm
  obtain ⟨b₂, hb₂⟩ :=
    IsLocalRing.exists_basis_of_linearIndependent_residue_coord b hcard (v := fun k ↦
      D K Q (Sum.elim (g ∘ a) y k)) hliz
  -- ... and those of `y` form a basis of the differentials of `P = Q ⧸ (g ∘ a)`.
  have key := exists_basis_kaehlerDifferential_quotient b₂ hb₂
  rw [Sum.elim_comp_inl, Set.range_comp] at key
  obtain ⟨b', hb'⟩ := key
  have h𝔪 : maximalIdeal Q = Ideal.span (g '' Set.range a) ⊔ Ideal.span (Set.range y) := by
    rw [maximalIdeal_eq_span_range_of_span_eq_top hx hD (Sum.forall.2 ⟨fun t ↦ hg𝔪 (a t), hy𝔪⟩)
      hspz, Set.Sum.elim_range, Ideal.span_union, Set.range_comp]
  have : Nontrivial (Q ⧸ Ideal.span (g '' Set.range a)) := Ideal.Quotient.nontrivial_iff.2
    (ne_top_of_le_ne_top (RingHom.ker_ne_top π) (hg ▸ Ideal.span_mono (Set.image_subset_range _ _)))
  have : IsLocalRing (Q ⧸ Ideal.span (g '' Set.range a)) :=
    .of_surjective' _ Ideal.Quotient.mk_surjective
  refine ⟨Set.range a, this, y, b', ?_, h𝔪, IsLocalRing.maximalIdeal_quotient_eq_span_range h𝔪,
    fun j ↦ hb' j, fun s ↦ ?_⟩
  · rw [Fintype.card_sum, Fintype.card_fin] at hcard
    rw [Set.ncard_range_of_injective ha, Nat.card_eq_fintype_card, hcard]
  · -- Every relation lies in `(g ∘ a) + 𝔪²`, since its gradient lies in the span of theirs.
    rw [IsLocalRing.apply_mem_maximalIdeal_sq_iff Ideal.Quotient.mk_surjective, Ideal.mk_ker,
      ← Set.range_comp]
    exact mem_span_range_sup_maximalIdeal_sq hx hD (fun t ↦ hg𝔪 (a t)) (hg𝔪 s)
      (hspan ▸ Submodule.subset_span ⟨s, rfl⟩)

/-- **A quotient by `n - e + 1` relations is a hypersurface.** In the setting of
`TauCeti.exists_minimal_presentation`, suppose that `A = Q ⧸ (g_s : s ∈ σ)` has a cotangent
space of dimension `e` and that there are `n - e + 1` relations. Then all relations but one,
`g_{s₀}`, cut out a local ring `P = Q ⧸ (g_s : s ≠ s₀)` with the coordinate system `y : Fin e → Q`,
the image `f` of `g_{s₀}` in `P` lies in `𝔪_P²`, and `π` induces `P ⧸ (f) ≅ A`. For a complete
intersection curve with a two-dimensional cotangent space, such as a node, this exhibits `A` as a
plane curve singularity. -/
theorem exists_hypersurface_presentation [Fintype σ] (b : Basis ι Q Ω[Q⁄K]) {x : ι → Q}
    (hx : maximalIdeal Q = Ideal.span (Set.range x)) (hb : ∀ i, b i = D K Q (x i))
    (π : Q →+* A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g))
    (hσ : Fintype.card σ + finrank (ResidueField A) (CotangentSpace A) = Fintype.card ι + 1) :
    ∃ (s₀ : σ) (_ : IsLocalRing (Q ⧸ Ideal.span (g '' {s₀}ᶜ)))
      (y : Fin (finrank (ResidueField A) (CotangentSpace A)) → Q)
      (b' : Basis (Fin (finrank (ResidueField A) (CotangentSpace A)))
        (Q ⧸ Ideal.span (g '' {s₀}ᶜ)) Ω[(Q ⧸ Ideal.span (g '' {s₀}ᶜ))⁄K]),
      maximalIdeal Q = Ideal.span (g '' {s₀}ᶜ) ⊔ Ideal.span (Set.range y) ∧
      maximalIdeal (Q ⧸ Ideal.span (g '' {s₀}ᶜ)) =
        Ideal.span (Set.range (Ideal.Quotient.mk _ ∘ y)) ∧
      (∀ j, b' j = D K _ (Ideal.Quotient.mk _ (y j))) ∧
      Ideal.Quotient.mk _ (g s₀) ∈ maximalIdeal (Q ⧸ Ideal.span (g '' {s₀}ᶜ)) ^ 2 ∧
      ∃ φ : (Q ⧸ Ideal.span (g '' {s₀}ᶜ)) ⧸ Ideal.span {Ideal.Quotient.mk _ (g s₀)} ≃+* A,
        ∀ q, φ (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ q)) = π q := by
  obtain ⟨T, hT, y, b', hcard, hy, hy', hb', hgT⟩ := exists_minimal_presentation b hx hb π hπ hg
  -- Exactly one relation is left over.
  have hTc : Tᶜ.ncard = 1 := by
    have := Set.ncard_add_ncard_compl T
    rw [Nat.card_eq_fintype_card] at this
    omega
  obtain ⟨s₀, hs₀⟩ := Set.ncard_eq_one.1 hTc
  obtain rfl : T = {s₀}ᶜ := by rw [← hs₀, compl_compl]
  have hker : Ideal.span (g '' {s₀}ᶜ) ⊔ Ideal.span {g s₀} = RingHom.ker π := by
    have : g '' {s₀}ᶜ ∪ {g s₀} = Set.range g := by
      simpa [Set.image_union] using congrArg (g '' ·) (Set.compl_union_self {s₀})
    rw [hg, ← this, Ideal.span_union]
  have hmap : Ideal.span {Ideal.Quotient.mk (Ideal.span (g '' {s₀}ᶜ)) (g s₀)} =
      (Ideal.span {g s₀}).map (Ideal.Quotient.mk _) := by
    simp [Ideal.map_span]
  refine ⟨s₀, hT, y, b', hy, hy', hb', hgT s₀, (Ideal.quotEquivOfEq hmap).trans
    ((DoubleQuot.quotQuotEquivQuotSup _ _).trans ((Ideal.quotEquivOfEq hker).trans
      (RingHom.quotientKerEquivOfSurjective hπ))), fun q ↦ ?_⟩
  -- Each of the composed isomorphisms sends the class of `q` to the class of `q`.
  have h := DoubleQuot.quotQuotEquivQuotSup_quotQuotMk (Ideal.span (g '' {s₀}ᶜ))
    (Ideal.span {g s₀}) q
  rw [DoubleQuot.quotQuotMk, RingHom.comp_apply] at h
  simp only [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk, h,
    RingHom.quotientKerEquivOfSurjective_apply_mk]

end Presentation

end TauCeti
