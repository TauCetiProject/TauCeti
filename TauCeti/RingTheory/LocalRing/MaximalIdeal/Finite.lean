module

public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
import Mathlib.RingTheory.Finiteness.Basic
import Mathlib.RingTheory.LocalRing.Quotient

/-!
# Maximal ideals in finite extensions of local rings

For a module-finite algebra `R → S` of commutative local rings, the quotient `S ⧸ 𝔪(R) S` is a
finite-dimensional algebra over the residue field `R ⧸ 𝔪(R)`, hence Artinian, so some positive
power of the maximal ideal `𝔪(S)` vanishes in `S ⧸ 𝔪(R) S`.

## Main results

* `TauCeti.IsLocalRing.exists_maximalIdeal_pow_le_map`: some positive power of `𝔪(S)` lies in
  `𝔪(R) S`.
-/

public section

open _root_.IsLocalRing

namespace TauCeti.IsLocalRing

/-- The maximal ideal of `S` is nilpotent modulo the ideal generated by the maximal ideal of `R`:
some positive power of `𝔪(S)` lies in `𝔪(R) S`. For discrete valuation rings the exponent that
works is the ramification index. -/
theorem exists_maximalIdeal_pow_le_map {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing R]
    [IsLocalRing S] [Algebra R S] [Module.Finite R S] :
    ∃ N ≥ 1, maximalIdeal S ^ N ≤ (maximalIdeal R).map (algebraMap R S) := by
  have : Module.Finite R (S ⧸ (maximalIdeal R).map (algebraMap R S)) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ R _).toLinearMap Ideal.Quotient.mk_surjective
  have : Module.Finite (R ⧸ maximalIdeal R) (S ⧸ (maximalIdeal R).map (algebraMap R S)) :=
    Module.Finite.of_restrictScalars_finite R _ _
  have : IsArtinianRing (R ⧸ maximalIdeal R) :=
    letI := Ideal.Quotient.field (maximalIdeal R)
    inferInstance
  have : IsArtinianRing (S ⧸ (maximalIdeal R).map (algebraMap R S)) :=
    IsArtinianRing.of_finite (R ⧸ maximalIdeal R) _
  obtain ⟨n, hn⟩ :=
    _root_.IsLocalRing.exists_maximalIdeal_pow_le_of_isArtinianRing_quotient
      (R := S) (I := (maximalIdeal R).map (algebraMap R S))
  exact ⟨max n 1, le_max_right n 1, (Ideal.pow_le_pow_right (le_max_left n 1)).trans hn⟩

end TauCeti.IsLocalRing
