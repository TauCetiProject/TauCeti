/-!
# Local rings whose maximal ideal is generated by one or two elements

Let `R` be a local ring whose maximal ideal is generated by `ϖ`, for instance a valuation ring
with a uniformizer. Then divisibility by `ϖ` describes the maximal ideal and the units, and if
`R` is Noetherian, it has dimension at most one. If `ϖ` is nilpotent, then `R` is automatically
Noetherian, its only prime ideal being the maximal one; this holds more generally whenever the
maximal ideal is finitely generated and consists of nilpotent elements.

Consequently, if the maximal ideal of `R` is generated by `x, y` but is not principal, as when
`R` is Noetherian of dimension two, then neither element generates it alone, and by Nakayama's
lemma each lies outside the square of the maximal ideal.

Writing `𝔪` for the maximal ideal generated by `ϖ`, every element outside `𝔪 ^ n` is a unit times
`ϖ ^ a` with `a < n`. Consequently the colon ideal `(𝔪 ^ j : ϖ ^ (j - i))` is `𝔪 ^ i` for `i ≤ j`
as long as `ϖ ^ (j - 1)` is nonzero, and if `ϖ` is nilpotent every ideal is a power of `𝔪`. For
a principal Artinian local ring of length `k`, such as `ℤ ⧸ p ^ k`, the ideals are thus the
`𝔪 ^ i` with `i ≤ k`, and multiplication by `ϖ ^ (j - i)` is injective from `R ⧸ 𝔪 ^ i` to
`R ⧸ 𝔪 ^ j` for `i ≤ j ≤ k`.

## Main results

* `TauCeti.IsLocalRing.mem_maximalIdeal_iff_dvd`: the maximal ideal consists of the multiples of
  `ϖ`.
* `TauCeti.IsLocalRing.mem_maximalIdeal_pow_iff_dvd`: `maximalIdeal R ^ n` consists of the
  multiples of `ϖ ^ n`.
* `TauCeti.IsLocalRing.isUnit_iff_not_dvd`: the units are the elements not divisible by `ϖ`.
* `TauCeti.IsLocalRing.isUnit_add_of_dvd`: a unit plus a multiple of `ϖ` is a unit.
* `TauCeti.IsLocalRing.isNoetherianRing_of_fg_of_le_nilradical`: a local ring whose maximal ideal
  is finitely generated and contained in the nilradical is Noetherian.
* `TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent`: a local ring whose maximal ideal is
  generated by a nilpotent element is Noetherian.
* `TauCeti.IsLocalRing.exists_isUnit_mul_pow_eq_of_notMem`: an element outside `𝔪 ^ n` is a unit
  multiple of `ϖ ^ a` for some `a < n`.
* `TauCeti.IsLocalRing.maximalIdeal_pow_colon_pow`: `(𝔪 ^ j : ϖ ^ (j - i)) = 𝔪 ^ i` for `i ≤ j`
  with `ϖ ^ (j - 1) ≠ 0`.
* `TauCeti.IsLocalRing.exists_eq_maximalIdeal_pow`: if `ϖ` is nilpotent, every ideal is a power of
  the maximal ideal.
* `IsLocalRing.ringKrullDim_le_one_of_isPrincipal_maximalIdeal`: a Noetherian local ring with
  principal maximal ideal has dimension at most one.
* `IsLocalRing.not_isPrincipal_maximalIdeal_of_one_lt_ringKrullDim`: so the maximal ideal of a
  Noetherian local ring of dimension greater than one is not principal.
* `TauCeti.IsLocalRing.notMem_sq_of_span_pair_eq_maximalIdeal`: in a local ring with
  non-principal maximal ideal, each element of a pair generating the maximal ideal lies outside
  its square.
-/

public section

namespace TauCeti.IsLocalRing

open _root_.IsLocalRing

/-- In a local ring whose maximal ideal is generated by `ϖ`, membership in the maximal ideal is
divisibility by `ϖ`. -/
theorem mem_maximalIdeal_iff_dvd {R : Type*} [CommSemiring R] [IsLocalRing R] {ϖ : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ}) {z : R} : z ∈ maximalIdeal R ↔ ϖ ∣ z := by
  rw [hϖ, Ideal.mem_span_singleton]

/-- In a local ring whose maximal ideal is generated by `ϖ`, the generator `ϖ` lies in the maximal
ideal. -/
theorem mem_maximalIdeal_of_eq_span {R : Type*} [CommSemiring R] [IsLocalRing R] {ϖ : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ}) : ϖ ∈ maximalIdeal R :=
  (mem_maximalIdeal_iff_dvd hϖ).mpr dvd_rfl

/-- In a local ring whose maximal ideal is generated by `ϖ`, membership in `maximalIdeal R ^ n`
is divisibility by `ϖ ^ n`. -/
theorem mem_maximalIdeal_pow_iff_dvd {R : Type*} [CommSemiring R] [IsLocalRing R] {ϖ : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ}) {z : R} {n : ℕ} :
    z ∈ maximalIdeal R ^ n ↔ ϖ ^ n ∣ z := by
  rw [hϖ, Ideal.span_singleton_pow, Ideal.mem_span_singleton]

/-- In a local ring whose maximal ideal is generated by `ϖ`, an element is a unit exactly when it
is not divisible by `ϖ`. -/
theorem isUnit_iff_not_dvd {R : Type*} [CommSemiring R] [IsLocalRing R] {ϖ : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ}) {z : R} : IsUnit z ↔ ¬ ϖ ∣ z := by
  rw [← mem_maximalIdeal_iff_dvd hϖ, mem_maximalIdeal, mem_nonunits_iff, not_not]

/-- In a local ring whose maximal ideal is generated by `ϖ`, a unit plus a multiple of `ϖ` is a
unit. -/
theorem isUnit_add_of_dvd {R : Type*} [CommRing R] [IsLocalRing R] {ϖ : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ}) {a b : R} (ha : IsUnit a) (hb : ϖ ∣ b) :
    IsUnit (a + b) := by
  rw [isUnit_iff_not_dvd hϖ] at ha ⊢
  exact fun hd ↦ ha (by simpa using dvd_sub hd hb)

/-- A local ring whose maximal ideal is finitely generated and contained in the nilradical is
Noetherian. -/
theorem isNoetherianRing_of_fg_of_le_nilradical {R : Type*} [CommRing R] [IsLocalRing R]
    (hfg : (maximalIdeal R).FG) (hn : maximalIdeal R ≤ nilradical R) : IsNoetherianRing R :=
  -- Every prime ideal contains the nilradical, so it is the finitely generated maximal ideal.
  .of_prime fun P hP ↦ by
    rwa [le_antisymm (le_maximalIdeal hP.ne_top) (hn.trans (nilradical_le_prime P))]

/-- A local ring whose maximal ideal is generated by a nilpotent element `ϖ` is Noetherian. -/
theorem isNoetherianRing_of_isNilpotent {R : Type*} [CommRing R] [IsLocalRing R] {ϖ : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ}) (hn : IsNilpotent ϖ) : IsNoetherianRing R :=
  isNoetherianRing_of_fg_of_le_nilradical (hϖ ▸ ⟨{ϖ}, by simp⟩) <| by
    rw [hϖ, Ideal.span_singleton_le_iff_mem]
    exact mem_nilradical.mpr hn

section Powers

section CommSemiring

variable {R : Type*} [CommSemiring R] [IsLocalRing R] {ϖ : R}

/-- In a local ring whose maximal ideal is generated by `ϖ`, an element outside
`maximalIdeal R ^ n` is a unit multiple of `ϖ ^ a` for some `a < n`. -/
theorem exists_isUnit_mul_pow_eq_of_notMem (hϖ : maximalIdeal R = Ideal.span {ϖ}) {x : R}
    {n : ℕ} (hx : x ∉ maximalIdeal R ^ n) : ∃ u a, IsUnit u ∧ a < n ∧ u * ϖ ^ a = x := by
  induction n with
  | zero => simp at hx
  | succ n ih =>
    by_cases h : x ∈ maximalIdeal R ^ n
    · obtain ⟨u, rfl⟩ := (mem_maximalIdeal_pow_iff_dvd hϖ).mp h
      refine ⟨u, n, (isUnit_iff_not_dvd hϖ).mpr ?_, n.lt_succ_self, mul_comm _ _⟩
      rintro ⟨v, rfl⟩
      exact hx ((mem_maximalIdeal_pow_iff_dvd hϖ).mpr ⟨v, by ring⟩)
    · obtain ⟨u, a, hu, ha, hx⟩ := ih h
      exact ⟨u, a, hu, ha.trans n.lt_succ_self, hx⟩

/-- **Ideals of a local ring with nilpotent principal maximal ideal.** If the maximal ideal is
generated by a nilpotent element `ϖ`, as in an Artinian local principal ideal ring, every ideal is
a power of the maximal ideal. -/
theorem exists_eq_maximalIdeal_pow (hϖ : maximalIdeal R = Ideal.span {ϖ}) (hn : IsNilpotent ϖ)
    (I : Ideal R) : ∃ n, I = maximalIdeal R ^ n := by
  classical
  have hex : ∃ n, ϖ ^ n ∈ I := hn.imp fun _ h ↦ by simp [h]
  refine ⟨Nat.find hex, le_antisymm (fun x hx ↦ ?_) ?_⟩
  · by_contra hxn
    obtain ⟨u, a, hu, ha, rfl⟩ := exists_isUnit_mul_pow_eq_of_notMem hϖ hxn
    exact Nat.find_min hex ha ((Ideal.unit_mul_mem_iff_mem I hu).mp hx)
  · rw [hϖ, Ideal.span_singleton_pow, Ideal.span_singleton_le_iff_mem]
    exact Nat.find_spec hex

end CommSemiring

variable {R : Type*} [CommRing R] [IsLocalRing R] {ϖ : R}

/-- If `ϖ` lies in the maximal ideal of a local ring and `ϖ ^ j` divides `ϖ ^ n` for some
`n < j`, then `ϖ ^ n = 0`. -/
theorem pow_eq_zero_of_pow_dvd_pow (hϖ : ϖ ∈ maximalIdeal R) {n j : ℕ} (hnj : n < j)
    (h : ϖ ^ j ∣ ϖ ^ n) : ϖ ^ n = 0 := by
  obtain ⟨c, hc⟩ := h
  have hu : IsUnit (1 - ϖ ^ (j - n) * c) :=
    isUnit_one_sub_self_of_mem_nonunits _ <| (mem_maximalIdeal _).mp <|
      Ideal.mul_mem_right c _ (Ideal.pow_mem_of_mem _ hϖ _ (by omega))
  refine (hu.mul_left_eq_zero).mp ?_
  rw [← pow_mul_pow_sub ϖ hnj.le] at hc
  linear_combination hc

/-- **Colon ideals of powers of a principal maximal ideal.** In a local ring whose maximal ideal
`𝔪` is generated by `ϖ`, multiplication by `ϖ ^ (j - i)` detects `𝔪 ^ i` inside `𝔪 ^ j`:
`(𝔪 ^ j : ϖ ^ (j - i)) = 𝔪 ^ i` for `i ≤ j`, as long as `ϖ ^ (j - 1) ≠ 0`. If `ϖ ^ k = 0` and
`ϖ ^ (k - 1) ≠ 0`, this covers every `j ≤ k`. -/
theorem maximalIdeal_pow_colon_pow (hϖ : maximalIdeal R = Ideal.span {ϖ}) {i j : ℕ}
    (hij : i ≤ j) (hj : ϖ ^ (j - 1) ≠ 0) :
    (maximalIdeal R ^ j).colon {ϖ ^ (j - i)} = maximalIdeal R ^ i := by
  have hϖm := mem_maximalIdeal_of_eq_span hϖ
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.pow_le_colon_singleton_pow hϖm hij)
  by_contra hxi
  obtain ⟨u, a, hu, ha, rfl⟩ := exists_isUnit_mul_pow_eq_of_notMem hϖ hxi
  rw [Submodule.mem_colon_singleton, smul_eq_mul, mem_maximalIdeal_pow_iff_dvd hϖ] at hx
  replace hx : ϖ ^ j ∣ ϖ ^ (a + (j - i)) := by
    simpa [mul_assoc, hu.dvd_mul_left, ← pow_add] using hx
  have h0 := pow_eq_zero_of_pow_dvd_pow hϖm (by omega) hx
  exact hj (pow_eq_zero_of_le (by omega) h0)

end Powers

end TauCeti.IsLocalRing

namespace IsLocalRing

/-- A Noetherian local ring whose maximal ideal is principal has dimension at most one. -/
theorem ringKrullDim_le_one_of_isPrincipal_maximalIdeal {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (h : (maximalIdeal R).IsPrincipal) : ringKrullDim R ≤ 1 := by
  obtain ⟨u, hu⟩ := h
  refine (ringKrullDim_le_spanFinrank_maximalIdeal R).trans ?_
  rw [hu]
  exact_mod_cast (Submodule.spanFinrank_span_le_encard {u}).trans_eq (Set.encard_singleton u)

/-- The maximal ideal of a Noetherian local ring of dimension greater than one is not
principal. -/
theorem not_isPrincipal_maximalIdeal_of_one_lt_ringKrullDim {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] (hdim : 1 < ringKrullDim R) :
    ¬ (maximalIdeal R).IsPrincipal := fun h ↦
  (ringKrullDim_le_one_of_isPrincipal_maximalIdeal h).not_gt hdim

end IsLocalRing

namespace TauCeti.IsLocalRing

open _root_.IsLocalRing Ideal

section CommSemiring

variable {R : Type*} [CommSemiring R] [IsLocalRing R]

/-- The first element of a pair generating the maximal ideal lies in the maximal ideal. -/
theorem mem_maximalIdeal_of_span_pair_eq_maximalIdeal {x y : R}
    (hxy : span {x, y} = maximalIdeal R) : x ∈ maximalIdeal R :=
  hxy ▸ subset_span (Set.mem_insert x {y})

/-- If the maximal ideal is not principal, neither element of a pair generating it generates it
alone. -/
theorem notMem_span_singleton_of_span_pair_eq_maximalIdeal
    (hprin : ¬ (maximalIdeal R).IsPrincipal) {x y : R} (hxy : span {x, y} = maximalIdeal R) :
    y ∉ span {x} := fun hy ↦ hprin ⟨x, by
  rw [← hxy, span_insert, sup_eq_left.mpr ((span_singleton_le_iff_mem _).mpr hy)]⟩

/-- If the maximal ideal is not principal, each element of a pair generating it is nonzero. -/
theorem ne_zero_of_span_pair_eq_maximalIdeal (hprin : ¬ (maximalIdeal R).IsPrincipal) {x y : R}
    (hxy : span {x, y} = maximalIdeal R) : x ≠ 0 := fun h ↦
  notMem_span_singleton_of_span_pair_eq_maximalIdeal hprin (Set.pair_comm x y ▸ hxy)
    (h ▸ zero_mem _)

end CommSemiring

/-- In a local ring whose maximal ideal is not principal, each element of a pair
generating the maximal ideal does not lie in the square of the maximal ideal: its image in the
cotangent space `maximalIdeal R / maximalIdeal R ^ 2` is nonzero. -/
theorem notMem_sq_of_span_pair_eq_maximalIdeal {R : Type*} [CommRing R] [IsLocalRing R]
    (hprin : ¬ (maximalIdeal R).IsPrincipal) {x y : R} (hxy : span {x, y} = maximalIdeal R) :
    x ∉ maximalIdeal R ^ 2 := fun hx ↦ by
  -- By Nakayama's lemma `y` alone would generate the maximal ideal.
  have hle : maximalIdeal R ≤ span {y} := by
    refine Submodule.le_of_le_smul_of_le_jacobson (hxy ▸ Submodule.fg_span (Set.toFinite _))
      (ringJacobson_eq_maximalIdeal R).ge ?_
    rw [smul_eq_mul, ← pow_two]
    calc maximalIdeal R = span {x} ⊔ span {y} := by rw [← span_insert, hxy]
      _ ≤ maximalIdeal R ^ 2 ⊔ span {y} :=
        sup_le_sup_right ((span_singleton_le_iff_mem _).mpr hx) _
      _ = span {y} ⊔ maximalIdeal R ^ 2 := sup_comm _ _
  have hyx : span {y, x} = maximalIdeal R := by rw [Set.pair_comm, hxy]
  exact notMem_span_singleton_of_span_pair_eq_maximalIdeal hprin hyx
    (hle (mem_maximalIdeal_of_span_pair_eq_maximalIdeal hxy))

end TauCeti.IsLocalRing
