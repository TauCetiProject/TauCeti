/-!
# Finite étale extensions of a local ring with prescribed residue field

Let `R` be a local ring with maximal ideal `𝔪` and residue field `k`, and let `g : R[X]` be a
monic polynomial with reduction `ḡ : k[X]`.

* If `ḡ` is separable, so is `g`. Hence `R[X] ⧸ (g)` is étale over `R`.
* If `ḡ` is irreducible, then `𝔪` generates a maximal ideal of `R[X] ⧸ (g)`, because the quotient
  by it is `k[X] ⧸ (ḡ)`. As `R[X] ⧸ (g)` is finite over `R`, every maximal ideal contains `𝔪`.
  So `R[X] ⧸ (g)` is a local ring with maximal ideal `𝔪 (R[X] ⧸ (g))`, and `R → R[X] ⧸ (g)`
  is a local homomorphism.

Taking `ḡ` to be the minimal polynomial of a primitive element, every finite separable extension
`l / k` is the residue field of a finite étale local `R`-algebra. This is a converse to Mathlib's
`IsLocalRing.exists_adjoin_eq_top`, by which every finite étale local extension of `R` is
generated by a single element. Over a discrete valuation ring such extensions are again discrete
valuation rings, with the same uniformizer; see `TauCeti.RingTheory.DiscreteValuationRing.Etale`.

## Main results

* `TauCeti.IsLocalRing.map_maximalIdeal_le_of_isMaximal`: in an integral extension of a local ring,
  every maximal ideal contains the extension of the maximal ideal.
* `Polynomial.Monic.separable_of_separable_map_residue`: a monic polynomial over a local ring whose
  reduction is separable is separable.
* `AdjoinRoot.isMaximal_map_maximalIdeal`: if the reduction of `g` is irreducible, the maximal
  ideal of `R` generates a maximal ideal of `R[X] ⧸ (g)`.
* `Polynomial.Monic.isLocalRing_adjoinRoot`: if moreover `g` is monic, `R[X] ⧸ (g)` is local.
* `AdjoinRoot.maximalIdeal_eq_map`, `AdjoinRoot.isLocalHom_algebraMap`: its maximal ideal is
  generated by that of `R`, and `R → R[X] ⧸ (g)` is a local homomorphism.
* `TauCeti.IsLocalRing.exists_etale_residueField_algEquiv`: every finite separable extension of
  the residue field is the residue field of a finite étale local extension of `R`.

## References

* [J.-P. Serre, *Corps Locaux*][serre1968], Chapter III, §5: unramified extensions with a
  prescribed residue extension, obtained by lifting the minimal polynomial of a primitive element.
-/

public section

open Polynomial IsLocalRing

universe u

variable {R : Type u} [CommRing R]

variable [IsLocalRing R] {g : R[X]}

/-- In an integral extension of a local ring `R`, every maximal ideal lies over the maximal ideal
of `R`, so it contains the ideal generated by the maximal ideal of `R`. -/
theorem TauCeti.IsLocalRing.map_maximalIdeal_le_of_isMaximal {S : Type*} [CommRing S]
    [Algebra R S] [Algebra.IsIntegral R S] {M : Ideal S} (hM : M.IsMaximal) :
    (maximalIdeal R).map (algebraMap R S) ≤ M := by
  have hunder : (M.under R).IsMaximal := Ideal.isMaximal_under_of_isIntegral_of_isMaximal M
  rw [← IsLocalRing.eq_maximalIdeal hunder]
  exact Ideal.map_comap_le

/-- The class of a polynomial with all coefficients in the maximal ideal of `R` lies in the ideal
of `R[X] ⧸ (g)` generated by that maximal ideal. -/
private theorem AdjoinRoot.mk_mem_map_maximalIdeal {p : R[X]} (hp : p.map (residue R) = 0) :
    AdjoinRoot.mk g p ∈ (maximalIdeal R).map (algebraMap R (AdjoinRoot g)) := by
  have hC : p ∈ (maximalIdeal R).map (C : R →+* R[X]) := by
    rw [Ideal.mem_map_C_iff]
    intro n
    rw [← residue_eq_zero_iff, ← coeff_map, hp, coeff_zero]
  rw [AdjoinRoot.algebraMap_eq, AdjoinRoot.of, ← Ideal.map_map]
  exact Ideal.mem_map_of_mem _ hC

/-- **A monic lift of a separable polynomial over the residue field is separable.** If `g` is a
monic polynomial over a local ring whose reduction to the residue field is separable, then `g` is
coprime to its derivative. -/
theorem Polynomial.Monic.separable_of_separable_map_residue (hg : g.Monic)
    (hsep : (g.map (residue R)).Separable) : g.Separable := by
  -- It suffices that the derivative of `g` is a unit modulo `g`.
  suffices hunit : IsUnit (AdjoinRoot.mk g (derivative g)) by
    obtain ⟨v, hv⟩ := hunit.exists_right_inv
    obtain ⟨b, rfl⟩ := AdjoinRoot.mk_surjective v
    rw [← map_mul, ← sub_eq_zero, ← map_one (AdjoinRoot.mk g), ← map_sub,
      AdjoinRoot.mk_eq_zero] at hv
    obtain ⟨a, ha⟩ := hv
    exact ⟨-a, b, by linear_combination ha⟩
  -- Otherwise it lies in a maximal ideal `M`, which contains `𝔪`, and a Bézout relation for
  -- the reduction of `g` lifts to one modulo `𝔪`, putting `1` in `M`.
  by_contra hunit
  obtain ⟨M, hM, hmem⟩ := Ideal.exists_le_maximal _
    ((Ideal.span_singleton_ne_top hunit) : Ideal.span {AdjoinRoot.mk g (derivative g)} ≠ ⊤)
  obtain ⟨a', b', hab'⟩ := (separable_def' _).mp hsep
  obtain ⟨a, rfl⟩ := Polynomial.map_surjective _ residue_surjective a'
  obtain ⟨b, rfl⟩ := Polynomial.map_surjective _ residue_surjective b'
  have : Module.Finite R (AdjoinRoot g) := (AdjoinRoot.powerBasis' hg).finite
  have hM' : AdjoinRoot.mk g (a * g + b * derivative g - 1) ∈ M := by
    refine TauCeti.IsLocalRing.map_maximalIdeal_le_of_isMaximal hM
      (AdjoinRoot.mk_mem_map_maximalIdeal ?_)
    rw [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul,
      ← derivative_map, hab', Polynomial.map_one, sub_self]
  have hder : AdjoinRoot.mk g (derivative g) ∈ M :=
    hmem (Ideal.mem_span_singleton_self _)
  apply hM.ne_top
  rw [Ideal.eq_top_iff_one]
  have h1 : (1 : AdjoinRoot g) = AdjoinRoot.mk g b * AdjoinRoot.mk g (derivative g) -
      AdjoinRoot.mk g (a * g + b * derivative g - 1) := by
    simp [AdjoinRoot.mk_self]
  rw [h1]
  exact M.sub_mem (M.mul_mem_left _ hder) hM'

/-- If the reduction `ḡ` of `g` to the residue field `k` is irreducible, then the maximal ideal of
`R` generates a maximal ideal of `R[X] ⧸ (g)`: it is the kernel of the reduction map onto the field
`k[X] ⧸ (ḡ)`. -/
theorem AdjoinRoot.isMaximal_map_maximalIdeal (hirr : Irreducible (g.map (residue R))) :
    ((maximalIdeal R).map (algebraMap R (AdjoinRoot g))).IsMaximal := by
  have : Fact (Irreducible (g.map (residue R))) := ⟨hirr⟩
  let φ := AdjoinRoot.map (residue R) g (g.map (residue R)) dvd_rfl
  have hφ : Function.Surjective φ := AdjoinRoot.map_surjective residue_surjective dvd_rfl
  suffices h : RingHom.ker φ = (maximalIdeal R).map (algebraMap R (AdjoinRoot g)) from
    h ▸ RingHom.ker_isMaximal_of_surjective φ hφ
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.map_le_iff_le_comap.mpr fun r hr ↦ ?_)
  · -- If `ḡ` divides the reduction `p̄` of `p`, say `p̄ = ḡ q̄`, then `p - g q` has all its
    -- coefficients in the maximal ideal.
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective x
    rw [RingHom.mem_ker, AdjoinRoot.map_mk, AdjoinRoot.mk_eq_zero] at hx
    obtain ⟨q', hq'⟩ := hx
    obtain ⟨q, rfl⟩ := Polynomial.map_surjective _ residue_surjective q'
    have hp : AdjoinRoot.mk g p = AdjoinRoot.mk g (p - g * q) := by simp
    rw [hp]
    exact AdjoinRoot.mk_mem_map_maximalIdeal (by simp [Polynomial.map_sub, Polynomial.map_mul, hq'])
  · simp [φ, (residue_eq_zero_iff r).mpr hr]

/-- **Adjoining a root of a monic lift of an irreducible residue polynomial gives a local ring.**
If `g` is monic and its reduction to the residue field is irreducible, then `R[X] ⧸ (g)` is a
local ring. -/
theorem Polynomial.Monic.isLocalRing_adjoinRoot (hg : g.Monic)
    (hirr : Irreducible (g.map (residue R))) : IsLocalRing (AdjoinRoot g) :=
  have : Module.Finite R (AdjoinRoot g) := (AdjoinRoot.powerBasis' hg).finite
  have hmax := AdjoinRoot.isMaximal_map_maximalIdeal hirr
  .of_unique_max_ideal ⟨_, hmax, fun _ hM ↦
    (hmax.eq_of_le hM.ne_top (TauCeti.IsLocalRing.map_maximalIdeal_le_of_isMaximal hM)).symm⟩

/-- If `R[X] ⧸ (g)` is local and the reduction of `g` is irreducible, its maximal ideal is
generated by the maximal ideal of `R`. -/
theorem AdjoinRoot.maximalIdeal_eq_map [IsLocalRing (AdjoinRoot g)]
    (hirr : Irreducible (g.map (residue R))) :
    maximalIdeal (AdjoinRoot g) = (maximalIdeal R).map (algebraMap R (AdjoinRoot g)) :=
  (IsLocalRing.eq_maximalIdeal (AdjoinRoot.isMaximal_map_maximalIdeal hirr)).symm

/-- If `R[X] ⧸ (g)` is local and the reduction of `g` is irreducible, then `R → R[X] ⧸ (g)` is a
local homomorphism. -/
theorem AdjoinRoot.isLocalHom_algebraMap [IsLocalRing (AdjoinRoot g)]
    (hirr : Irreducible (g.map (residue R))) : IsLocalHom (algebraMap R (AdjoinRoot g)) :=
  ((local_hom_TFAE (algebraMap R (AdjoinRoot g))).out 1 3).mpr
    (AdjoinRoot.maximalIdeal_eq_map hirr).ge

namespace TauCeti.IsLocalRing

/-- **Every finite separable extension of the residue field lifts to a finite étale extension.**
For a local ring `R` with residue field `k` and a finite separable field extension `L / k`, there
is a finite étale `R`-algebra `S` which is a local ring, with `R → S` a local homomorphism, and
whose residue field is isomorphic to `L` as a `k`-algebra. One may take `S = R[X] ⧸ (g)` for a
monic lift `g` of the minimal polynomial of a primitive element of `L / k`. -/
theorem exists_etale_residueField_algEquiv (R : Type u) [CommRing R] [IsLocalRing R]
    (L : Type*) [Field L] [Algebra (ResidueField R) L] [FiniteDimensional (ResidueField R) L]
    [Algebra.IsSeparable (ResidueField R) L] :
    ∃ (S : Type u) (_ : CommRing S) (_ : IsLocalRing S) (_ : Algebra R S)
      (_ : IsLocalHom (algebraMap R S)),
      Module.Finite R S ∧ Algebra.Etale R S ∧
        Nonempty (ResidueField S ≃ₐ[ResidueField R] L) := by
  obtain ⟨α, hα⟩ := Field.exists_primitive_element (ResidueField R) L
  have hint : IsIntegral (ResidueField R) α := .of_finite _ _
  -- Lift the minimal polynomial of `α` to a monic polynomial `g` over `R`.
  obtain ⟨g, hgmap, -, hg⟩ := lifts_and_degree_eq_and_monic
    (map_surjective _ residue_surjective (minpoly (ResidueField R) α)) (minpoly.monic hint)
  have hirr : Irreducible (g.map (residue R)) := hgmap ▸ minpoly.irreducible hint
  have hsep : (g.map (residue R)).Separable := hgmap ▸ Algebra.IsSeparable.isSeparable _ α
  let _ : IsLocalRing (AdjoinRoot g) := hg.isLocalRing_adjoinRoot hirr
  let _ : IsLocalHom (algebraMap R (AdjoinRoot g)) := AdjoinRoot.isLocalHom_algebraMap hirr
  have : Algebra.IsStandardEtale R (AdjoinRoot g) :=
    hg.isStandardEtale_adjoinRoot (hg.separable_of_separable_map_residue hsep)
  refine ⟨AdjoinRoot g, inferInstance, inferInstance, inferInstance, inferInstance,
    (AdjoinRoot.powerBasis' hg).finite, inferInstance, ⟨?_⟩⟩
  -- The map `R[X] ⧸ (g) → L` sending the root to `α` is surjective with kernel the maximal
  -- ideal, so it identifies the residue field with `L`.
  let ψ : AdjoinRoot g →+* L := AdjoinRoot.lift ((algebraMap (ResidueField R) L).comp (residue R))
    α (by rw [← eval₂_map, hgmap, ← aeval_def, minpoly.aeval])
  have hψ : Function.Surjective ψ := by
    intro y
    have hy : y ∈ (⊤ : Subalgebra (ResidueField R) L) := Algebra.mem_top
    rw [← IntermediateField.top_toSubalgebra, ← hα,
      IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic,
      Algebra.adjoin_singleton_eq_range_aeval] at hy
    obtain ⟨p, rfl⟩ := hy
    obtain ⟨q, rfl⟩ := map_surjective _ residue_surjective p
    exact ⟨AdjoinRoot.mk g q, by simp [ψ, AdjoinRoot.lift_mk, aeval_def, eval₂_map]⟩
  have hker : RingHom.ker ψ = maximalIdeal (AdjoinRoot g) :=
    IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective ψ hψ)
  have : IsLocalHom ψ := ⟨fun x hx ↦ IsLocalRing.notMem_maximalIdeal.mp <| by
    rw [← hker, RingHom.mem_ker]
    exact hx.ne_zero⟩
  have hlift : Function.Surjective (ResidueField.lift ψ) := fun y ↦ by
    obtain ⟨s, rfl⟩ := hψ y
    exact ⟨residue _ s, ResidueField.lift_residue_apply ψ s⟩
  refine AlgEquiv.ofRingEquiv
    (f := RingEquiv.ofBijective (ResidueField.lift ψ) ⟨(ResidueField.lift ψ).injective, hlift⟩)
    fun x ↦ ?_
  obtain ⟨r, rfl⟩ := residue_surjective x
  rw [ResidueField.algebraMap_residue]
  refine (ResidueField.lift_residue_apply ψ (algebraMap R _ r)).trans ?_
  rw [AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of, RingHom.comp_apply]

end TauCeti.IsLocalRing
