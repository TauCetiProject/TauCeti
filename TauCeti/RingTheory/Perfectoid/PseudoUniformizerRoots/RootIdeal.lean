module

public import TauCeti.RingTheory.Huber.RootIdeal
public import TauCeti.RingTheory.Perfectoid.PseudoUniformizerRoots.Basic

/-!
# The root ideal of a pseudouniformiser with compatible roots

Let `R` be a nonarchimedean topological ring and `ϖ` a pseudouniformiser of `R` with compatible
`p`-power roots. Every root `ϖ ^ (1 / p ^ n)` is topologically nilpotent, so the roots form a
compatible system in any ring of integral elements `R⁺`. In a Huber ring, the ideal `R°°` of
topologically nilpotent elements of `R°` is generated by the roots `ϖ ^ (1 / p ^ n)`.

## Main definitions

* `TauCeti.Perfectoid.PseudoUniformizerRoots.rootsIn`: the roots as a compatible system in a
  ring of integral elements `R⁺`.

## Main results

* `TauCeti.Perfectoid.PseudoUniformizerRoots.topologicallyNilpotentIdeal_eq_span_range_rootPB`:
  `R°°` is generated by the roots `ϖ ^ (1 / p ^ n)`.

## References

* P. Scholze, *Étale cohomology of diamonds*, §3, Definition 3.21 and its preamble.
* B. Bhatt, *Lecture notes for a class on perfectoid spaces*, Lemma 3.1.3(2).
-/

public section

open TauCeti.Huber

namespace TauCeti.Perfectoid.PseudoUniformizerRoots

variable {p : ℕ} {R : Type*} [CommRing R] [TopologicalSpace R] [NonarchimedeanRing R] [NeZero p]
  (ϖ : PseudoUniformizerRoots p R)

/-- The roots `ϖ ^ (1 / p ^ n)` as a compatible system in a ring of integral elements `R⁺`. -/
def rootsIn {Rplus : Subring R} (h : IsRingOfIntegralElements Rplus) : Perfection Rplus p :=
  ⟨fun n ↦ ⟨ϖ.root n,
      h.mem_of_isTopologicallyNilpotent (ϖ.isPseudoUniformizer_root n).isTopologicallyNilpotent⟩,
    fun n ↦ Subtype.ext (by simp [root_succ_pow])⟩

/-- The coordinates of the compatible system in `R⁺` are the roots. -/
@[simp]
theorem coe_coeffMonoidHom_rootsIn {Rplus : Subring R} (h : IsRingOfIntegralElements Rplus)
    (n : ℕ) : (Perfection.coeffMonoidHom Rplus p n (ϖ.rootsIn h) : R) = ϖ.root n :=
  (rfl)

/-- Every coordinate of the compatible system in `R⁺` is a pseudouniformiser. -/
theorem isPseudoUniformizer_coeffMonoidHom_rootsIn {Rplus : Subring R}
    (h : IsRingOfIntegralElements Rplus) (n : ℕ) :
    IsPseudoUniformizer (Perfection.coeffMonoidHom Rplus p n (ϖ.rootsIn h) : R) :=
  ϖ.isPseudoUniformizer_root n

/-- **`R°°` is the root ideal of `ϖ`**: in a Huber ring, the topologically nilpotent elements of
`R°` form the ideal generated by the roots `ϖ ^ (1 / p ^ n)`. -/
theorem topologicallyNilpotentIdeal_eq_span_range_rootPB [IsHuberRing R] (hp : 2 ≤ p) :
    topologicallyNilpotentIdeal R = Ideal.span (Set.range ϖ.rootPB) := by
  rw [topologicallyNilpotentIdeal_eq_span_range hp ϖ.rootsPB
    (ϖ.isPseudoUniformizer_coeffMonoidHom_rootsPB 0)]
  simp only [coeffMonoidHom_rootsPB]

end TauCeti.Perfectoid.PseudoUniformizerRoots
