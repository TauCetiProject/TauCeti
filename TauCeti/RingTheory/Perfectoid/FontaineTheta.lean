module

public import Mathlib.RingTheory.Perfectoid.FontaineTheta
public import Mathlib.RingTheory.WittVector.Complete
public import TauCeti.RingTheory.Perfection

/-!
# The kernel of Fontaine's map in characteristic `p`

Let `A` be a reduced ring of characteristic `p`. Then `p = 0` in `A`, so `A` is trivially
`p`-adically complete, `A ⧸ p = A`, and the tilt `A♭ = PreTilt A p` is the perfection of `A`.
Mathlib's Fontaine map `θ : W(A♭) → A` (`WittVector.fontaineTheta`) sends a Witt vector to the
zeroth coordinate of its zeroth Witt component. Since `A` is reduced, an element of `A♭` vanishes
when its zeroth coordinate does, and since `A♭` is perfect, a Witt vector over `A♭` with vanishing
zeroth component is divisible by `p`. Hence the kernel of `θ` is the principal ideal `(p)`.

This is the characteristic-`p` case of the principal kernel of `θ` required in the definition of
integral perfectoid rings (Bhatt–Morrow–Scholze, *Integral p-adic Hodge theory*, Definition 3.5),
and shows that perfect rings of characteristic `p` satisfy it: for such `A`, `A♭ ≅ A` and `θ` is
reduction modulo `p` on the Witt vectors of `A`.

## Main results

* `WittVector.fontaineTheta_eq_zero_iff`: `θ x = 0` exactly when the zeroth component of `x`
  vanishes.
* `WittVector.ker_fontaineTheta_eq_span_p`: the kernel of `θ` is generated by `p`.

## References

* B. Bhatt, M. Morrow, P. Scholze, *Integral p-adic Hodge theory*, §3.2, Definition 3.5.
-/

public section

open Ideal

namespace WittVector

variable {A : Type*} [CommRing A] {p : ℕ} [Fact p.Prime] [CharP A p] [IsReduced A]
  [Fact ¬IsUnit (p : A)] [IsAdicComplete (span {(p : A)}) A]

/-- **Fontaine's map in characteristic `p`.** For a reduced ring `A` of characteristic `p`,
`θ : W(A♭) → A` vanishes exactly on the Witt vectors with vanishing zeroth component. -/
theorem fontaineTheta_eq_zero_iff (x : WittVector p (PreTilt A p)) :
    fontaineTheta A p x = 0 ↔ x.coeff 0 = 0 := by
  -- `p = 0` in `A`, so reduction modulo `p` is injective and `A ⧸ p ≅ A` is reduced
  have hp : span {(p : A)} = ⊥ := by simp
  have : IsReduced (ModP A p) :=
    isReduced_of_injective ((quotEquivOfEq hp).trans (RingEquiv.quotientBot A))
      (RingEquiv.injective _)
  -- `A ⧸ p` is reduced, so `x.coeff 0 ∈ A♭` vanishes with its zeroth coordinate
  rw [← PreTilt.coeff_eq_zero_iff 0, ← mk_fontaineTheta, Quotient.eq_zero_iff_mem, hp, mem_bot]

/-- **The kernel of Fontaine's map in characteristic `p` is `(p)`.** For a reduced ring `A` of
characteristic `p`, the kernel of `θ : W(A♭) → A` is generated by `p`; in particular it is
principal, as the definition of integral perfectoid rings requires. -/
theorem ker_fontaineTheta_eq_span_p :
    RingHom.ker (fontaineTheta A p) = span {(p : WittVector p (PreTilt A p))} := by
  ext x
  rw [RingHom.mem_ker, fontaineTheta_eq_zero_iff, mem_span_p_iff_coeff_zero_eq_zero]

end WittVector
