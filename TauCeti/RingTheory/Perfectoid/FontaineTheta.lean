/-!
# The kernel of Fontaine's map

This file determines the kernel of Mathlib's Fontaine map `θ : W(A♭) → A`
(`WittVector.fontaineTheta`, where `A♭ = PreTilt A p`) in two settings:

1. **Characteristic `p`:** when `A` is a reduced ring of characteristic `p`, `p = 0` in `A`,
   `A ⧸ p = A`, `A♭` is the perfection of `A`, and `θ` sends a Witt vector to the zeroth coordinate
   of its zeroth Witt component. Since `A` is reduced, an element of `A♭` vanishes when its zeroth
   coordinate does, so `ker θ = (p)`.
2. **Regular `π`-adic setting** (Scholze, *Étale cohomology of diamonds*, Lemma 3.14;
   Bhatt–Morrow–Scholze, *Integral `p`-adic Hodge theory*, Lemma 3.10 and Remark 3.11): let `A` be
   `π`-adically complete for a nonzerodivisor `π` with `π ^ p ∣ p` and bijective relative Frobenius
   `A ⧸ (π) → A ⧸ (π ^ p)`. When `π = ϖ.untilt` for `ϖ : A♭`, approximating `-p` modulo `π p` by
   untilts produces `α : W(A♭)` such that `ξ := p + [ϖ] α` lies in `ker θ`. Equipping `A♭` with its
   `(ϖ)`-adic topology makes `ξ` primitive, hence distinguished and a nonzerodivisor of `W(A♭)`.
   Repeated division using `(ξ, [ϖ]) = (p, [ϖ])` and `[ϖ]`-adic separatedness of `W(A♭) ⧸ (ξ)`
   shows `ker θ = (ξ)`. More generally, a `π` without pre-chosen `p`-power roots is associated to
   some `ϖ.untilt`, and an element `ξ' ∈ ker θ` generates `ker θ` if and only if `ξ'` is
   distinguished.

## Main results

* `WittVector.fontaineTheta_eq_zero_iff`, `WittVector.ker_fontaineTheta_eq_span_p`: in a reduced
  ring of characteristic `p`, `θ x = 0 ↔ x.coeff 0 = 0` and `ker θ = (p)`.
* `WittVector.surjective_fontaineTheta_of_frobeniusModPow_surjective`: `θ` is surjective when `A`
  is `π`-adically complete with `π ^ p ∣ p` and surjective Frobenius `A ⧸ (π) → A ⧸ (π ^ p)`.
* `WittVector.isPrimitive_p_add_teichmuller_mul_of_isAdic`,
  `WittVector.isDistinguished_p_add_teichmuller_mul_of_isAdicComplete`: over an `I`-adically
  complete ring `S` of characteristic `p` with `ϖ ∈ I`, `p + [ϖ] α` is primitive (for the `I`-adic
  topology) and hence distinguished.
* `WittVector.exists_teichmuller_mul_ker_fontaineTheta`: when `ϖ.untilt ∈ A⁰` has
  `ϖ.untilt ^ p ∣ p`, `A` is `(ϖ.untilt)`-adically complete, and relative Frobenius is bijective,
  `ker θ = (p + [ϖ] α)` for some `α : W(A♭)` with `p + [ϖ] α` distinguished and a nonzerodivisor.
* `WittVector.exists_isDistinguished_mem_nonZeroDivisors_ker_fontaineTheta`: the same for an
  arbitrary nonzerodivisor `π : A` with `π ^ p ∣ p`, `[IsAdicComplete (span {π}) A]`, and bijective
  relative Frobenius.
* `WittVector.ker_fontaineTheta_eq_span_iff_isDistinguished`: under the same hypotheses, an element
  `ξ' ∈ ker θ` generates `ker θ` if and only if `ξ'` is distinguished.

## References

* B. Bhatt, M. Morrow, P. Scholze, *Integral `p`-adic Hodge theory*, Definition 3.5, Lemma 3.10,
  and Remark 3.11.
* P. Scholze, *Étale cohomology of diamonds*, Lemma 3.14.
-/

public section

open Ideal
open scoped nonZeroDivisors

namespace WittVector

section CharP

variable {A : Type*} [CommRing A] {p : ℕ} [Fact p.Prime] [CharP A p] [IsReduced A]
  [Fact ¬IsUnit (p : A)] [IsAdicComplete (span {(p : A)}) A]

/-- **Fontaine's map in characteristic `p`.** For a reduced ring `A` of characteristic `p`,
`θ : W(A♭) → A` vanishes exactly on the Witt vectors with vanishing zeroth component. -/
theorem fontaineTheta_eq_zero_iff (x : WittVector p (PreTilt A p)) :
    fontaineTheta A p x = 0 ↔ x.coeff 0 = 0 := by
  -- `p = 0` in `A`, so reduction modulo `p` is injective and `A ⧸ p ≅ A` is reduced
  have hp : span {(p : A)} = ⊥ := by simp
  have : IsReduced (ModP A p) :=
    isReduced_of_injective ((quotEquivOfEq hp).trans (RingEquiv.quotientBot A))
      (RingEquiv.injective _)
  -- `A ⧸ p` is reduced, so `x.coeff 0 ∈ A♭` vanishes with its zeroth coordinate
  rw [← PreTilt.coeff_eq_zero_iff 0, ← mk_fontaineTheta, Quotient.eq_zero_iff_mem, hp, mem_bot]

/-- **The kernel of Fontaine's map in characteristic `p` is `(p)`.** For a reduced ring `A` of
characteristic `p`, the kernel of `θ : W(A♭) → A` is generated by `p`; in particular it is
principal, as the definition of integral perfectoid rings requires. -/
theorem ker_fontaineTheta_eq_span_p :
    RingHom.ker (fontaineTheta A p) = span {(p : WittVector p (PreTilt A p))} := by
  ext x
  rw [RingHom.mem_ker, fontaineTheta_eq_zero_iff, mem_span_p_iff_coeff_zero_eq_zero]

end CharP

section AdicDistinguished

variable {p : ℕ} [Fact p.Prime] {S : Type*} [CommRing S] [CharP S p]

/-- In an `I`-adically complete ring `S` whose topology is `I`-adic, the topological nilradical
lies in the Jacobson radical. -/
private theorem topologicalNilradical_le_jacobson_of_isAdic {I : Ideal S}
    [TopologicalSpace S] [IsLinearTopology S S] (hI : IsAdic I) [IsAdicComplete I S] :
    topologicalNilradical S ≤ Ring.jacobson S := by
  rw [← Ideal.jacobson_bot]
  refine topologicalNilradical_le_jacobson_bot (by simpa using hI.isOpen_pow 1) ?_
  rw [Ideal.jacobson_bot]
  exact IsAdicComplete.le_jacobson I

/-- Over an `I`-adically complete ring `S` of characteristic `p` equipped with the `I`-adic
topology, every Witt vector of the form `p + [ϖ] α` with `ϖ ∈ I` is primitive. -/
theorem isPrimitive_p_add_teichmuller_mul_of_isAdic {I : Ideal S} [TopologicalSpace S]
    [IsLinearTopology S S] (hI : IsAdic I) [IsAdicComplete I S] {ϖ : S} (hϖ : ϖ ∈ I)
    (α : WittVector p S) :
    ((p : WittVector p S) + teichmuller p ϖ * α).IsPrimitive :=
  isPrimitive_p_add_teichmuller_mul (topologicalNilradical_le_jacobson_of_isAdic hI)
    (hI.isTopologicallyNilpotent_of_mem hϖ) α

/-- **Elements of the form `p + [ϖ] α` are distinguished.** Over a `ϖ`-adically complete ring `S`
of characteristic `p`, `p + [ϖ] α` is distinguished for every `α : W(S)`. -/
theorem isDistinguished_p_add_teichmuller_mul_of_isAdicComplete (ϖ : S)
    [IsAdicComplete (span {ϖ}) S] (α : WittVector p S) :
    ((p : WittVector p S) + teichmuller p ϖ * α).IsDistinguished := by
  let _ : WithIdeal S := ⟨span {ϖ}⟩
  exact (isPrimitive_p_add_teichmuller_mul_of_isAdic (I := span {ϖ}) rfl
    (mem_span_singleton_self ϖ) α).isDistinguished

end AdicDistinguished

section Regular

variable {A : Type*} [CommRing A] {p : ℕ} [hp : Fact p.Prime] [Fact ¬IsUnit (p : A)]
  [IsAdicComplete (span {(p : A)}) A]

local notation "A♭" => PreTilt A p

/-- **Surjectivity of Fontaine's `θ` from relative Frobenius.** If `A` is `π`-adically complete
with `π ^ p ∣ p` and surjective relative Frobenius `A ⧸ (π) → A ⧸ (π ^ p)`, then
`fontaineTheta A p` is surjective. -/
theorem surjective_fontaineTheta_of_frobeniusModPow_surjective {π : A}
    {hdvd : π ^ p ∣ (p : A)} [IsAdicComplete (span {π}) A]
    (hsurj : Function.Surjective (TauCeti.frobeniusModPow p hdvd)) :
    Function.Surjective (fontaineTheta A p) := by
  have hs_mul :=
    TauCeti.exists_mul_dvd_sub_pow ((TauCeti.frobeniusModPow_surjective_iff hdvd).mp hsurj)
  refine surjective_fontaineTheta ((TauCeti.surjective_frobenius_modP_iff A).mpr fun a ↦ ?_)
  exact (hs_mul a).imp fun _ ↦ (dvd_mul_left (p : A) π).trans

/-- Approximating `-p` modulo `ϖ.untilt * p` by an untilt produces `α : W(A♭)` such that
`p + [ϖ] α ∈ ker θ`. -/
private theorem exists_ker_p_add_teichmuller_mul {ϖ : A♭} {hdvd : ϖ.untilt ^ p ∣ (p : A)}
    [IsAdicComplete (span {ϖ.untilt}) A] (hreg : ϖ.untilt ∈ A⁰)
    (hbij : Function.Bijective (TauCeti.frobeniusModPow p hdvd)) :
    ∃ α : WittVector p A♭,
      (p : WittVector p A♭) + teichmuller p ϖ * α ∈ RingHom.ker (fontaineTheta A p) := by
  have hs := (TauCeti.frobeniusModPow_surjective_iff hdvd).mp hbij.2
  obtain ⟨f, c, hc⟩ := PreTilt.exists_mul_natCast_dvd_sub_untilt hdvd hs (-(p : A))
  have hdvd1 : ϖ.untilt ∣ (p : A) := (dvd_pow_self _ hp.out.ne_zero).trans hdvd
  have hf_dvd : ϖ.untilt ∣ f.untilt := by
    have hfeq : f.untilt = -(p : A) - ϖ.untilt * (p : A) * c := by linear_combination -hc
    rw [hfeq]
    exact dvd_sub (dvd_neg.mpr hdvd1) ((hdvd1.mul_left ϖ.untilt).mul_right c)
  obtain ⟨g, rfl⟩ := (PreTilt.dvd_iff_untilt_dvd hreg hbij.1).mpr hf_dvd
  obtain ⟨w, hw⟩ := surjective_fontaineTheta_of_frobeniusModPow_surjective hbij.2 c
  refine ⟨teichmuller p g + (p : WittVector p A♭) * w, ?_⟩
  rw [RingHom.mem_ker, map_add, map_natCast, map_mul, map_add, map_mul, map_natCast,
    fontaineTheta_teichmuller, fontaineTheta_teichmuller, hw]
  have hfg : (ϖ * g).untilt = ϖ.untilt * g.untilt := map_mul PreTilt.untilt ϖ g
  linear_combination -hc - hfg

/-- One `[ϖ]`-division step inside `ker θ`: if `ξ ∈ ker θ` is distinguished with `ϖ ∣ ξ.coeff 0`,
then every `x ∈ ker θ` satisfies `x ≡ [ϖ] y (mod ξ)` for some `y ∈ ker θ`. -/
private theorem ker_fontaineTheta_div_step {ϖ : A♭} {hdvd : ϖ.untilt ^ p ∣ (p : A)}
    (hreg : ϖ.untilt ∈ A⁰) (hinj : Function.Injective (TauCeti.frobeniusModPow p hdvd))
    {ξ : WittVector p A♭} (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0)
    (hker : ξ ∈ RingHom.ker (fontaineTheta A p)) (x : RingHom.ker (fontaineTheta A p)) :
    ∃ y : RingHom.ker (fontaineTheta A p),
      (x : WittVector p A♭) - teichmuller p ϖ * (y : WittVector p A♭) ∈ span {ξ} := by
  have hdvd1 : ϖ.untilt ∣ (p : A) := (dvd_pow_self _ hp.out.ne_zero).trans hdvd
  have hx0 : PreTilt.coeff 0 ((x : WittVector p A♭).coeff 0) = 0 := by
    rw [← mk_fontaineTheta, RingHom.mem_ker.mp x.2, map_zero]
  have hp_dvd : (p : A) ∣ ((x : WittVector p A♭).coeff 0).untilt := by
    rw [← mem_span_singleton, ← Ideal.Quotient.eq_zero_iff_mem, PreTilt.mk_untilt_eq_coeff_zero]
    exact hx0
  have hϖ_dvd : ϖ ∣ (x : WittVector p A♭).coeff 0 :=
    (PreTilt.dvd_iff_untilt_dvd hreg hinj).mpr (hdvd1.trans hp_dvd)
  have hx_mem : (x : WittVector p A♭) ∈ span {ξ, teichmuller p ϖ} := by
    rw [hξ.span_pair_teichmuller_eq hξ₀, mem_span_p_teichmuller_iff]
    exact hϖ_dvd
  obtain ⟨u, y, huy⟩ := mem_span_pair.mp hx_mem
  have hy_ker : y ∈ RingHom.ker (fontaineTheta A p) := by
    have hθ := congrArg (fontaineTheta A p) huy
    rw [RingHom.mem_ker.mp x.2, map_add, map_mul, RingHom.mem_ker.mp hker, mul_zero, zero_add,
      map_mul, fontaineTheta_teichmuller, mul_comm] at hθ
    exact RingHom.mem_ker.mpr ((mul_left_mem_nonZeroDivisors_eq_zero_iff hreg).mp hθ)
  refine ⟨⟨y, hy_ker⟩, mem_span_singleton.mpr ⟨u, ?_⟩⟩
  linear_combination -huy

/-- If `ξ ∈ ker θ` is distinguished with `ϖ ∣ ξ.coeff 0`, then every element of `ker θ` is
divisible by `ξ`, since its image in the `[ϖ]`-adically Hausdorff quotient `W(A♭) ⧸ (ξ)` is
divisible by `[ϖ] ^ n` for all `n`. -/
private theorem ker_fontaineTheta_le_span {ϖ : A♭} {hdvd : ϖ.untilt ^ p ∣ (p : A)}
    [IsAdicComplete (span {ϖ.untilt}) A] (hreg : ϖ.untilt ∈ A⁰)
    (hinj : Function.Injective (TauCeti.frobeniusModPow p hdvd))
    {ξ : WittVector p A♭} (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0)
    (hker : ξ ∈ RingHom.ker (fontaineTheta A p)) :
    RingHom.ker (fontaineTheta A p) ≤ span {ξ} := by
  have hdvd1 : ϖ.untilt ∣ (p : A) := (dvd_pow_self _ hp.out.ne_zero).trans hdvd
  have : IsAdicComplete (span {ϖ}) A♭ := PreTilt.isAdicComplete_span_singleton hdvd1
  choose F hF using ker_fontaineTheta_div_step hreg hinj hξ hξ₀ hker
  let t : WittVector p A♭ ⧸ span {ξ} := Ideal.Quotient.mk (span {ξ}) (teichmuller p ϖ)
  have : IsAdicComplete (span {t}) (WittVector p A♭ ⧸ span {ξ}) :=
    hξ.isAdicComplete_quotient (Ideal.le_radical (mem_span_singleton.mpr hξ₀))
  intro x hx
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  refine IsHausdorff.haus' (I := span {t}) _ fun n ↦ ?_
  have hpow (k : ℕ) (z : RingHom.ker (fontaineTheta A p)) :
      Ideal.Quotient.mk (span {ξ}) (z : WittVector p A♭) =
        t ^ k * Ideal.Quotient.mk (span {ξ}) (F^[k] z : WittVector p A♭) := by
    induction k generalizing z with
    | zero => simp
    | succ k ih =>
      have h1 : Ideal.Quotient.mk (span {ξ}) (z : WittVector p A♭) =
          t * Ideal.Quotient.mk (span {ξ}) (F z : WittVector p A♭) := by
        rw [← map_mul, Ideal.Quotient.eq]
        exact hF z
      rw [h1, Function.iterate_succ_apply, ih (F z), pow_succ', mul_assoc]
  rw [smul_eq_mul, mul_top, SModEq.zero, span_singleton_pow, mem_span_singleton]
  exact ⟨_, hpow n ⟨x, hx⟩⟩

/-- **Generator of `ker θ` of the form `p + [ϖ] α`** (Scholze, *Étale cohomology of diamonds*,
Lemma 3.14; Bhatt–Morrow–Scholze, Lemma 3.10). Let `ϖ : PreTilt A p` be such that `ϖ.untilt` is a
nonzerodivisor of `A` with `ϖ.untilt ^ p ∣ p`, `A` is `(ϖ.untilt)`-adically complete, and relative
Frobenius `A ⧸ (ϖ.untilt) → A ⧸ (ϖ.untilt ^ p)` is bijective. Then there exists
`α : W(PreTilt A p)` such that `ξ := p + [ϖ] α` is distinguished, is a nonzerodivisor of
`W(PreTilt A p)`, and generates `ker (fontaineTheta A p)`. -/
theorem exists_teichmuller_mul_ker_fontaineTheta {ϖ : A♭} {hdvd : ϖ.untilt ^ p ∣ (p : A)}
    [IsAdicComplete (span {ϖ.untilt}) A] (hreg : ϖ.untilt ∈ A⁰)
    (hbij : Function.Bijective (TauCeti.frobeniusModPow p hdvd)) :
    ∃ α : WittVector p A♭,
      ((p : WittVector p A♭) + teichmuller p ϖ * α).IsDistinguished ∧
        (p : WittVector p A♭) + teichmuller p ϖ * α ∈ (WittVector p A♭)⁰ ∧
        RingHom.ker (fontaineTheta A p) = span {(p : WittVector p A♭) + teichmuller p ϖ * α} := by
  have hdvd1 : ϖ.untilt ∣ (p : A) := (dvd_pow_self _ hp.out.ne_zero).trans hdvd
  have : IsAdicComplete (span {ϖ}) A♭ := PreTilt.isAdicComplete_span_singleton hdvd1
  obtain ⟨α, hker⟩ := exists_ker_p_add_teichmuller_mul hreg hbij
  have hξ : ((p : WittVector p A♭) + teichmuller p ϖ * α).IsDistinguished :=
    isDistinguished_p_add_teichmuller_mul_of_isAdicComplete ϖ α
  have hξ₀_dvd : ϖ ∣ ((p : WittVector p A♭) + teichmuller p ϖ * α).coeff 0 :=
    mem_span_p_teichmuller_iff.mp
      (add_mem (subset_span (by simp)) (mul_mem_right _ _ (subset_span (by simp))))
  have hξ_reg : (p : WittVector p A♭) + teichmuller p ϖ * α ∈ (WittVector p A♭)⁰ :=
    hξ.mem_nonZeroDivisors (Ideal.le_radical (mem_span_singleton.mpr hξ₀_dvd))
      (PreTilt.mem_nonZeroDivisors_of_untilt hreg)
  refine ⟨α, hξ, hξ_reg, le_antisymm (ker_fontaineTheta_le_span hreg hbij.1 hξ hξ₀_dvd hker) ?_⟩
  exact span_le.mpr (Set.singleton_subset_iff.mpr hker)

/-- Transport `(π)`-adic completeness, regularity, and bijectivity of relative Frobenius along an
associated element `ϖ : PreTilt A p` obtained from `PreTilt.exists_associated_untilt`. -/
private theorem exists_untilt_of_frobeniusModPow_bijective {π : A} {hdvd : π ^ p ∣ (p : A)}
    [IsAdicComplete (span {π}) A] (hreg : π ∈ A⁰)
    (hbij : Function.Bijective (TauCeti.frobeniusModPow p hdvd)) :
    ∃ (ϖ : A♭) (hdvd' : ϖ.untilt ^ p ∣ (p : A)),
      IsAdicComplete (span {ϖ.untilt}) A ∧ ϖ.untilt ∈ A⁰ ∧
        Function.Bijective (TauCeti.frobeniusModPow p hdvd') := by
  have hs := (TauCeti.frobeniusModPow_surjective_iff hdvd).mp hbij.2
  obtain ⟨ϖ, -, hassoc⟩ := PreTilt.exists_associated_untilt hdvd hs
  have hspan : span {ϖ.untilt} = span {π} :=
    le_antisymm (span_le.mpr (Set.singleton_subset_iff.mpr (mem_span_singleton.mpr hassoc.dvd)))
      (span_le.mpr (Set.singleton_subset_iff.mpr (mem_span_singleton.mpr hassoc.symm.dvd)))
  have hc : IsAdicComplete (span {ϖ.untilt}) A := hspan ▸ inferInstance
  have hdvd' : ϖ.untilt ^ p ∣ (p : A) := (pow_dvd_pow_of_dvd hassoc.symm.dvd p).trans hdvd
  have hinj' : Function.Injective (TauCeti.frobeniusModPow p hdvd') :=
    (TauCeti.frobeniusModPow_injective_iff hdvd').mpr fun y hy ↦
      hassoc.symm.dvd.trans
        (((TauCeti.frobeniusModPow_injective_iff hdvd).mp hbij.1) y
          ((pow_dvd_pow_of_dvd hassoc.dvd p).trans hy))
  have hsurj' : Function.Surjective (TauCeti.frobeniusModPow p hdvd') :=
    (TauCeti.frobeniusModPow_surjective_iff hdvd').mpr fun x ↦
      (hs x).imp fun _ ↦ (pow_dvd_pow_of_dvd hassoc.symm.dvd p).trans
  obtain ⟨u, hu⟩ := hassoc
  have hreg' : ϖ.untilt ∈ A⁰ := hu ▸ mul_mem hreg u.isUnit.mem_nonZeroDivisors
  exact ⟨ϖ, hdvd', hc, hreg', hinj', hsurj'⟩

/-- **Regular distinguished generator of `ker θ`** (Bhatt–Morrow–Scholze, *Integral `p`-adic Hodge
theory*, Lemma 3.10). If `A` is `π`-adically complete for a nonzerodivisor `π` with `π ^ p ∣ p` and
bijective relative Frobenius `A ⧸ (π) → A ⧸ (π ^ p)`, then `ker (fontaineTheta A p)` is generated
by a distinguished nonzerodivisor of `W(PreTilt A p)`. -/
theorem exists_isDistinguished_mem_nonZeroDivisors_ker_fontaineTheta {π : A}
    {hdvd : π ^ p ∣ (p : A)} [IsAdicComplete (span {π}) A] (hreg : π ∈ A⁰)
    (hbij : Function.Bijective (TauCeti.frobeniusModPow p hdvd)) :
    ∃ ξ : WittVector p A♭,
      ξ.IsDistinguished ∧ ξ ∈ (WittVector p A♭)⁰ ∧
        RingHom.ker (fontaineTheta A p) = span {ξ} := by
  obtain ⟨ϖ, hdvd', hc, hreg', hbij'⟩ := exists_untilt_of_frobeniusModPow_bijective hreg hbij
  obtain ⟨α, hξ, hξ_reg, hker⟩ := exists_teichmuller_mul_ker_fontaineTheta hreg' hbij'
  exact ⟨_, hξ, hξ_reg, hker⟩

/-- **Characterisation of generators of `ker θ` by distinguishedness** (Bhatt–Morrow–Scholze,
*Integral `p`-adic Hodge theory*, Remark 3.11; Scholze, *Étale cohomology of diamonds*,
Lemma 3.14). Under the hypotheses of
`exists_isDistinguished_mem_nonZeroDivisors_ker_fontaineTheta`, an element
`ξ' ∈ ker (fontaineTheta A p)` generates `ker (fontaineTheta A p)` if and only if `ξ'` is
distinguished. -/
theorem ker_fontaineTheta_eq_span_iff_isDistinguished {π : A} {hdvd : π ^ p ∣ (p : A)}
    [IsAdicComplete (span {π}) A] (hreg : π ∈ A⁰)
    (hbij : Function.Bijective (TauCeti.frobeniusModPow p hdvd))
    {ξ' : WittVector p A♭} (hξ' : ξ' ∈ RingHom.ker (fontaineTheta A p)) :
    RingHom.ker (fontaineTheta A p) = span {ξ'} ↔ ξ'.IsDistinguished := by
  obtain ⟨ϖ, hdvd', hc, hreg', hbij'⟩ := exists_untilt_of_frobeniusModPow_bijective hreg hbij
  obtain ⟨α, -, hξ_reg, hker⟩ := exists_teichmuller_mul_ker_fontaineTheta hreg' hbij'
  let ξ : WittVector p A♭ := (p : WittVector p A♭) + teichmuller p ϖ * α
  have hdvd1 : ϖ.untilt ∣ (p : A) := (dvd_pow_self _ hp.out.ne_zero).trans hdvd'
  have : IsAdicComplete (span {ϖ}) A♭ := PreTilt.isAdicComplete_span_singleton hdvd1
  let _ : WithIdeal A♭ := ⟨span {ϖ}⟩
  have hJac := topologicalNilradical_le_jacobson_of_isAdic (I := span {ϖ}) rfl
  have hprim : ξ.IsPrimitive :=
    isPrimitive_p_add_teichmuller_mul_of_isAdic (I := span {ϖ}) rfl (mem_span_singleton_self ϖ) α
  have hker' : RingHom.ker (fontaineTheta A p) = span {ξ} := hker
  rw [hker']
  refine ⟨fun hspan ↦ ?_, fun hdist ↦ ?_⟩
  · obtain ⟨y, hy⟩ := mem_span_singleton.mp (by rw [← hspan]; exact mem_span_singleton_self ξ)
    obtain ⟨z, hz⟩ := mem_span_singleton.mp (by rw [hspan]; exact mem_span_singleton_self ξ')
    have h1 : ξ * (z * y) = ξ * 1 := by linear_combination -hy - hz * y
    have hzy : z * y = 1 := (mul_cancel_left_mem_nonZeroDivisors hξ_reg).mp h1
    let u : (WittVector p A♭)ˣ := Units.mkOfMulEqOne z y hzy
    have huξ : ξ' = ↑u * ξ := by rw [Units.val_mkOfMulEqOne, mul_comm, ← hz]
    exact (huξ ▸ (isPrimitive_units_mul hJac u).mpr hprim).isDistinguished
  · obtain ⟨y, hy⟩ := mem_span_singleton.mp (by rwa [← hker'])
    have hy_unit : IsUnit y := hprim.isUnit_of_eq_mul hJac hdist (by rw [mul_comm, ← hy])
    rw [hy, span_singleton_mul_right_unit hy_unit]

end Regular

end WittVector
