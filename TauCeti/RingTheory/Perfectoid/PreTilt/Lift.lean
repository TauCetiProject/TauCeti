/-!
# Ring homomorphisms from a perfect ring into a tilt

Let `A` be a `p`-adically complete ring in which `p` is not a unit, with tilt
`A♭ = PreTilt A p` and Fontaine's map `θ_A : W(A♭) → A`, and let `k` be a perfect ring of
characteristic `p`. Then `f ↦ θ_A ∘ W(f)` is a bijection from ring homomorphisms `k → A♭` to ring
homomorphisms `W(k) → A` (`PreTilt.wittVectorHomEquiv`).

Both sides are ring homomorphisms `k → A ⧸ p` in disguise. A ring homomorphism from the perfect ring
`k` to `A ⧸ p` lifts uniquely to the perfection `A♭` of `A ⧸ p` (`Perfection.lift`), and to a ring
homomorphism `W(k) → A` (`TauCeti.WittVector.adicLiftEquiv`). The two lifts are matched by `θ_A`,
since `θ_A ∘ W(f)` reduces modulo `p` to the zeroth coordinate of `f`, applied to the zeroth Witt
coordinate. The inverse sends `g : W(k) → A` to the map `x ↦ f x` whose sharp is `g [x]`
(`PreTilt.untilt_wittVectorHomEquiv_symm_apply`).

In other words, `k ↦ W(k)` from perfect rings of characteristic `p` is left adjoint to
`A ↦ A♭` on `p`-adically complete rings.

For a second `p`-adically complete ring `B` in which `p` is not a unit, the case `k = A♭` with
target `B` detects which ring homomorphisms `g : A♭ → B♭` are tilts. If `θ_A` is surjective with
kernel generated by `ξ`, then `g` is the tilt of a ring homomorphism `A → B` exactly when
`θ_B (W(g) ξ) = 0` (`PreTilt.exists_map_eq_iff`): `θ_B ∘ W(g)` then factors through `θ_A` as some
`h`, and `h♭ = g` because both have the same image under the bijection. Over a fixed nonzero
integral perfectoid base, this makes tilting fully faithful on algebras whose maps of tilts are
compatible with the tilts of the structure maps (`PreTilt.algHomEquiv`).

Over a `p`-adically complete base `R`, regarded as a `W(R♭)`-algebra through `θ_R`, and for a
perfect `R♭`-algebra `k`, the bijection restricts to ring homomorphisms `k → A♭` compatible with
`R♭ → k` and with the tilt of `R → A` on one side, and `W(R♭)`-algebra homomorphisms `W(k) → A` on
the other; by the universal property of base change these are the `R`-algebra homomorphisms
`R ⊗_{W(R♭)} W(k) → A` (`PreTilt.wittVectorAlgHomEquiv`).

## Main definitions

* `PreTilt.wittVectorHomEquiv p k A`: the bijection `(k →+* A♭) ≃ (W(k) →+* A)`,
  `f ↦ θ_A ∘ W(f)`.
* `PreTilt.wittVectorAlgHomEquiv p k A R`: over a `p`-adically complete base `R` and for a perfect
  `R♭`-algebra `k`, the bijection from ring homomorphisms `k → A♭` compatible with the tilt of
  `R → A` to `R`-algebra homomorphisms `R ⊗_{W(R♭)} W(k) → A`.

## Main results

* `PreTilt.wittVectorHomEquiv_apply`: the bijection is `f ↦ θ_A ∘ W(f)`.
* `PreTilt.untilt_wittVectorHomEquiv_symm_apply`,
  `PreTilt.coeff_zero_wittVectorHomEquiv_symm_apply`: the inverse sends `g` to the map whose
  values have sharp `g [x]`, and zeroth coordinate `g [x]` modulo `p`.
* `PreTilt.exists_map_eq_iff`: if `θ_A` is surjective with kernel `(ξ)`, a ring homomorphism
  `g : A♭ → B♭` is a tilt exactly when `θ_B (W(g) ξ) = 0`.
* `PreTilt.wittVectorAlgHomEquiv_apply_tmul`,
  `PreTilt.untilt_wittVectorAlgHomEquiv_symm_apply`: the bijection over a base sends `f` to
  `r ⊗ w ↦ r • θ_A (W(f) w)`, and its inverse sends `g` to the map whose values have sharp
  `g (1 ⊗ [x])`.

## References

* B. Bhatt, M. Morrow, P. Scholze, *Integral p-adic Hodge theory*, Lemma 3.2 and §3.2.
* P. Scholze, *Perfectoid spaces*, Theorem 5.2.
* `grh-lean`, https://github.com/lsernau/grh-lean, file
  `src/Lib/PadicComparison/Descent/TestCovers.lean` (declaration
  `New.Variety.theta_comp_bijective`, the same bijection for the rings of `p`-adic tests);
  Apache 2.0, Copyright 2026 Anthropic, PBC.
-/

public section

open Ideal _root_.WittVector

namespace PreTilt

variable {p : ℕ} [hp : Fact p.Prime] {k : Type*} [CommRing k] [CharP k p] [PerfectRing k p]
  {A : Type*} [CommRing A] [Fact ¬IsUnit (p : A)]

local notation "𝕎" => WittVector p

variable [IsAdicComplete (span {(p : A)}) A]

/-- The ring homomorphism `k →+* A♭` lifting `g [x]` modulo `p`: the perfection lift of the
reduction modulo `p` of `g : W(k) →+* A`. -/
private noncomputable def wittVectorHomInv (g : 𝕎 k →+* A) : k →+* PreTilt A p :=
  (equivPerfection : PreTilt A p ≃+* _).symm.toRingHom.comp <|
    Perfection.lift p k (ModP A p)
      ((TauCeti.WittVector.adicLiftEquiv _ (mem_span_singleton_self (p : A))).symm g)

private theorem coeff_zero_wittVectorHomInv (g : 𝕎 k →+* A) (x : k) :
    coeff 0 (wittVectorHomInv g x) = Ideal.Quotient.mk _ (g (teichmuller p x)) := by
  set φ := (TauCeti.WittVector.adicLiftEquiv _ (mem_span_singleton_self (p : A))).symm g
  -- the zeroth coordinate of the perfection lift of `φ` is `φ`
  have hφ := RingHom.congr_fun ((Perfection.lift p k (ModP A p)).symm_apply_apply φ) x
  rw [Perfection.lift_symm_apply, RingHom.comp_apply] at hφ
  rw [wittVectorHomInv, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
    coeff_equivPerfection_symm, hφ, TauCeti.WittVector.adicLiftEquiv_symm_apply]

private theorem untilt_wittVectorHomInv (g : 𝕎 k →+* A) (x : k) :
    (wittVectorHomInv g x).untilt = g (teichmuller p x) := by
  set φ := (TauCeti.WittVector.adicLiftEquiv _ (mem_span_singleton_self (p : A))).symm g
  have hg : g = TauCeti.WittVector.adicLift _ φ := by
    rw [← TauCeti.WittVector.adicLiftEquiv_apply (mem_span_singleton_self (p : A)),
      Equiv.apply_symm_apply]
  rw [wittVectorHomInv, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
    untilt_equivPerfection_symm]
  conv_rhs => rw [hg, TauCeti.WittVector.adicLift_teichmuller]

variable (p k A) in
/-- **The universal property of the tilt** with respect to perfect rings: for a perfect ring `k`
of characteristic `p` and a `p`-adically complete ring `A` in which `p` is not a unit, ring
homomorphisms `f : k →+* A♭` correspond to ring homomorphisms `W(k) →+* A` by `f ↦ θ_A ∘ W(f)`
(`wittVectorHomEquiv_apply`). The inverse sends `g` to the map whose values have sharp `g [x]`
(`untilt_wittVectorHomEquiv_symm_apply`). -/
noncomputable def wittVectorHomEquiv : (k →+* PreTilt A p) ≃ (𝕎 k →+* A) where
  toFun f := (fontaineTheta A p).comp (WittVector.map f)
  invFun := wittVectorHomInv
  left_inv f := Perfection.hom_ext p fun x ↦ (by
    rw [coeff_zero_wittVectorHomInv, RingHom.comp_apply, map_teichmuller,
      fontaineTheta_teichmuller, mk_untilt_eq_coeff_zero] :
    coeff 0 (wittVectorHomInv ((fontaineTheta A p).comp (WittVector.map f)) x) = coeff 0 (f x))
  right_inv g := ringHom_ext_teichmuller fun x ↦ by
    rw [RingHom.comp_apply, map_teichmuller, fontaineTheta_teichmuller, untilt_wittVectorHomInv]

@[simp]
theorem wittVectorHomEquiv_apply (f : k →+* PreTilt A p) :
    wittVectorHomEquiv p k A f = (fontaineTheta A p).comp (WittVector.map f) :=
  (rfl)

/-- The inverse of `wittVectorHomEquiv` sends `g : W(k) →+* A` to the map `k →+* A♭` whose value
at `x` has sharp `g [x]`. -/
@[simp]
theorem untilt_wittVectorHomEquiv_symm_apply (g : 𝕎 k →+* A) (x : k) :
    ((wittVectorHomEquiv p k A).symm g x).untilt = g (teichmuller p x) :=
  untilt_wittVectorHomInv g x

/-- The inverse of `wittVectorHomEquiv` sends `g : W(k) →+* A` to the map `k →+* A♭` whose value
at `x` has zeroth coordinate `g [x]` modulo `p`. -/
@[simp]
theorem coeff_zero_wittVectorHomEquiv_symm_apply (g : 𝕎 k →+* A) (x : k) :
    coeff 0 ((wittVectorHomEquiv p k A).symm g x) = Ideal.Quotient.mk _ (g (teichmuller p x)) :=
  coeff_zero_wittVectorHomInv g x

section Tilt

variable {B : Type*} [CommRing B] [Fact ¬IsUnit (p : B)] [IsAdicComplete (span {(p : B)}) B]

/-- **Fullness of tilting.** If `θ_A` is surjective with kernel generated by `ξ`, a ring
homomorphism `g : A♭ → B♭` is the tilt of a ring homomorphism `A → B` exactly when `θ_B` kills the
image of `ξ` under `W(g)`. -/
theorem exists_map_eq_iff (hθ : Function.Surjective (fontaineTheta A p)) {ξ : 𝕎 (PreTilt A p)}
    (hξ : RingHom.ker (fontaineTheta A p) = span {ξ}) (g : PreTilt A p →+* PreTilt B p) :
    (∃ h : A →+* B, map p h = g) ↔ fontaineTheta B p (WittVector.map g ξ) = 0 := by
  have hξmem : ξ ∈ RingHom.ker (fontaineTheta A p) := hξ ▸ mem_span_singleton_self ξ
  refine ⟨?_, fun hg ↦ ?_⟩
  · rintro ⟨h, rfl⟩
    rw [theta_natural, RingHom.mem_ker.mp hξmem, map_zero]
  -- `θ_B ∘ W(g)` kills `ker θ_A = (ξ)`, so it factors through the surjection `θ_A`.
  let ψ := wittVectorHomEquiv p (PreTilt A p) B g
  have hker : RingHom.ker (fontaineTheta A p) ≤ RingHom.ker ψ := by
    rw [hξ, span_singleton_le_iff_mem, RingHom.mem_ker]
    simpa only [ψ, wittVectorHomEquiv_apply, RingHom.comp_apply] using hg
  let h := (fontaineTheta A p).liftOfSurjective hθ ⟨ψ, hker⟩
  refine ⟨h, (wittVectorHomEquiv p (PreTilt A p) B).injective ?_⟩
  rw [wittVectorHomEquiv_apply, theta_natural_comp]
  exact (fontaineTheta A p).liftOfSurjective_comp hθ ⟨ψ, hker⟩

end Tilt

section Base

/-! ### Over a base

Let `R` be a `p`-adically complete ring in which `p` is not a unit, `A` an `R`-algebra which is
also `p`-adically complete with `p` not a unit, and `k` a perfect `R♭`-algebra. Regard `R` as a
`W(R♭)`-algebra through `θ_R`, `A` through `R`, and `W(k)` through `W(R♭) → W(k)`. Then
`wittVectorHomEquiv` matches the ring homomorphisms `k → A♭` compatible with `R♭ → k` and
`R♭ → A♭` with the `W(R♭)`-algebra homomorphisms `W(k) → A`, hence with the `R`-algebra
homomorphisms `R ⊗_{W(R♭)} W(k) → A`. -/

open scoped TensorProduct

variable {R : Type*} [CommRing R] [Fact ¬IsUnit (p : R)] [IsAdicComplete (span {(p : R)}) R]
  [Algebra (PreTilt R p) k] [Algebra (WittVector p (PreTilt R p)) R]
  [Algebra (WittVector p (PreTilt R p)) (WittVector p k)] [Algebra R A]
  [Algebra (WittVector p (PreTilt R p)) A] [IsScalarTower (WittVector p (PreTilt R p)) R A]

/-- A ring homomorphism `f : k → A♭` is compatible with `R♭ → k` and the tilt `R♭ → A♭` of the
structure map exactly when `θ_A ∘ W(f) : W(k) → A` is a `W(R♭)`-algebra homomorphism. -/
private theorem wittVectorHomEquiv_comp_algebraMap_eq_iff
    (hR : algebraMap (𝕎 (PreTilt R p)) R = fontaineTheta R p)
    (hk : algebraMap (𝕎 (PreTilt R p)) (𝕎 k) = WittVector.map (algebraMap (PreTilt R p) k))
    (f : k →+* PreTilt A p) :
    (wittVectorHomEquiv p k A f).comp (algebraMap (𝕎 (PreTilt R p)) (𝕎 k)) =
        algebraMap (𝕎 (PreTilt R p)) A ↔
      f.comp (algebraMap (PreTilt R p) k) = map p (algebraMap R A) := by
  -- Both sides of the first equation are images under `wittVectorHomEquiv p R♭ A`.
  have hA : algebraMap (𝕎 (PreTilt R p)) A =
      wittVectorHomEquiv p (PreTilt R p) A (map p (algebraMap R A)) := by
    rw [IsScalarTower.algebraMap_eq (𝕎 (PreTilt R p)) R A, hR, wittVectorHomEquiv_apply,
      theta_natural_comp]
  rw [hA, hk, wittVectorHomEquiv_apply, RingHom.comp_assoc, ← WittVector.map_comp,
    ← wittVectorHomEquiv_apply, (wittVectorHomEquiv p (PreTilt R p) A).injective.eq_iff]

variable (p k A R) in
/-- **The universal property of the tilt over a base.** Let `R` and `A` be `p`-adically complete
rings in which `p` is not a unit, `A` an `R`-algebra and `k` a perfect `R♭`-algebra of
characteristic `p`, with `R` and `W(k)` regarded as `W(R♭)`-algebras through `θ_R` and
`W(R♭) → W(k)`. Then ring homomorphisms
`f : k → A♭` compatible with `R♭ → k` and the tilt `R♭ → A♭` of the structure map correspond to
`R`-algebra homomorphisms `R ⊗_{W(R♭)} W(k) → A`, by `f ↦ (r ⊗ w ↦ r • θ_A (W(f) w))`
(`wittVectorAlgHomEquiv_apply_tmul`). -/
noncomputable def wittVectorAlgHomEquiv
    (hR : algebraMap (𝕎 (PreTilt R p)) R = fontaineTheta R p)
    (hk : algebraMap (𝕎 (PreTilt R p)) (𝕎 k) = WittVector.map (algebraMap (PreTilt R p) k)) :
    {f : k →+* PreTilt A p // f.comp (algebraMap (PreTilt R p) k) = map p (algebraMap R A)} ≃
      (R ⊗[𝕎 (PreTilt R p)] 𝕎 k →ₐ[R] A) :=
  ((wittVectorHomEquiv p k A).subtypeEquiv
      (q := fun g ↦ g.comp (algebraMap (𝕎 (PreTilt R p)) (𝕎 k)) = algebraMap _ A)
      (fun f ↦ (wittVectorHomEquiv_comp_algebraMap_eq_iff hR hk f).symm) |>.trans
    { toFun g := (⟨g.val, RingHom.congr_fun g.property⟩ : 𝕎 k →ₐ[𝕎 (PreTilt R p)] A)
      invFun g := ⟨g, g.comp_algebraMap⟩
      left_inv _ := rfl
      right_inv _ := rfl }).trans
    (AlgHom.liftEquiv (𝕎 (PreTilt R p)) R (𝕎 k) A)

/-- `wittVectorAlgHomEquiv` sends `f` to the map `r ⊗ w ↦ r • θ_A (W(f) w)`. -/
@[simp]
theorem wittVectorAlgHomEquiv_apply_tmul
    (hR : algebraMap (𝕎 (PreTilt R p)) R = fontaineTheta R p)
    (hk : algebraMap (𝕎 (PreTilt R p)) (𝕎 k) = WittVector.map (algebraMap (PreTilt R p) k))
    (f : {f : k →+* PreTilt A p // f.comp (algebraMap (PreTilt R p) k) = map p (algebraMap R A)})
    (r : R) (w : 𝕎 k) :
    wittVectorAlgHomEquiv p k A R hR hk f (r ⊗ₜ w) =
      r • fontaineTheta A p (WittVector.map f.val w) :=
  (rfl)

/-- The inverse of `wittVectorAlgHomEquiv` sends `g` to the map `k → A♭` whose value at `x` has
sharp `g (1 ⊗ [x])`. -/
@[simp]
theorem untilt_wittVectorAlgHomEquiv_symm_apply
    (hR : algebraMap (𝕎 (PreTilt R p)) R = fontaineTheta R p)
    (hk : algebraMap (𝕎 (PreTilt R p)) (𝕎 k) = WittVector.map (algebraMap (PreTilt R p) k))
    (g : R ⊗[𝕎 (PreTilt R p)] 𝕎 k →ₐ[R] A) (x : k) :
    (((wittVectorAlgHomEquiv p k A R hR hk).symm g).val x).untilt = g (1 ⊗ₜ teichmuller p x) :=
  untilt_wittVectorHomEquiv_symm_apply _ x

end Base

end PreTilt
