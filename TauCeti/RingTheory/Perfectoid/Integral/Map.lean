module

public import TauCeti.RingTheory.Perfectoid.Integral.Tilt
public import TauCeti.RingTheory.Perfectoid.PreTilt.Map

/-!
# Maps of integral perfectoid rings and `A_inf`

Let `f : A →+* B` be a ring homomorphism between nonzero integral perfectoid rings
(`TauCeti.Perfectoid.IsIntegralPerfectoid`), with tilts `A♭ = PreTilt A p`, `B♭ = PreTilt B p`,
the induced map of tilts `f♭ = PreTilt.map p f` and the induced map
`A_inf(f) = W(f♭) : W(A♭) → W(B♭)`. This file shows how `A_inf(f)` interacts with Fontaine's maps
`θ_A : W(A♭) → A` and `θ_B : W(B♭) → B`.

* **Generators of `ker θ`.** For every `f`, `W(f♭)` carries a generator `ξ` of `ker θ_A` to a
  generator of `ker θ_B`: `W(f♭) ξ` lies in `ker θ_B` by naturality of `θ`, and it is distinguished
  because `ξ` is, and the distinguished elements of `ker θ_B` are its generators. Hence `W(f♭)` maps
  `ker θ_A` onto a generating set of `ker θ_B`.
* **Surjections.** Now let `f` be surjective. Choose a generator `ξ` of `ker θ_A`; then `ξ₀♯` and
  `(f♭ ξ₀)♯` are unit multiples of `p`, `A♭` is `ξ₀`-adically complete and `B♭` is
  `f♭ ξ₀`-adically separated. Modulo `f♭ ξ₀`, every element of `B♭` is congruent to the image of an
  element of `A♭`, because `B♭ ⧸ (f♭ ξ₀) ≅ B ⧸ p` is a quotient of `A ⧸ p ≅ A♭ ⧸ ξ₀`. By
  completeness, `f♭` and hence `W(f♭)` are surjective. Then `W(f♭)` maps `ker θ_A` onto `ker θ_B`,
  and `W(A♭)` surjects onto the fibre product `W(B♭) ×_B A`.
* **The kernel of `A_inf(f)`.** Let `K = ker W(f♭)`. Then `θ_A` maps `K` onto `ker f`, and
  `K ∩ ker θ_A = (ker θ_A) K`, because `W(f♭) ξ` is a nonzerodivisor of `W(B♭)`. Together, `θ_A`
  induces an isomorphism `K ⧸ ξ K ≅ ker f`.

These are the identities used to show that fibre products of integral perfectoid rings along a
surjection are integral perfectoid.

## Main results

* `WittVector.ker_fontaineTheta_eq_span_map`: `W(f♭)` carries a generator of `ker θ_A` to a
  generator of `ker θ_B`.
* `WittVector.map_ker_fontaineTheta`: the ideal generated by `W(f♭) (ker θ_A)` is `ker θ_B`.
* `PreTilt.map_surjective`: for surjective `f`, the map of tilts `f♭` is surjective; so is
  `W(f♭)`, by `WittVector.map_surjective`.
* `WittVector.exists_map_eq_and_fontaineTheta_eq`: for surjective `f`, `W(A♭)` surjects onto the
  fibre product `W(B♭) ×_B A`.
* `WittVector.map_fontaineTheta_ker_map`: for surjective `f`, `θ_A (ker W(f♭)) = ker f`.
* `WittVector.ker_map_inf_ker_fontaineTheta`: `ker W(f♭) ∩ ker θ_A = (ker θ_A) (ker W(f♭))`.

## References

* K. Česnavičius, P. Scholze, *Purity for flat cohomology*, Proposition 2.1.4 and its proof.
* B. Bhatt, M. Morrow, P. Scholze, *Integral `p`-adic Hodge theory*, Remark 3.11.
-/

public section

open Ideal TauCeti.Perfectoid

variable {p : ℕ} [Fact p.Prime] {A B : Type*} [CommRing A] [CommRing B]
  [IsIntegralPerfectoid p A] [IsIntegralPerfectoid p B] [Fact ¬IsUnit (p : A)]
  [Fact ¬IsUnit (p : B)]

namespace WittVector

/-- **`A_inf(f)` preserves generators of `ker θ`.** For a ring homomorphism `f : A →+* B` of
nonzero integral perfectoid rings and a generator `g` of `ker θ_A`, the image `W(f♭) g` generates
`ker θ_B`. -/
theorem ker_fontaineTheta_eq_span_map (f : A →+* B) {g : WittVector p (PreTilt A p)}
    (hg : RingHom.ker (fontaineTheta A p) = span {g}) :
    RingHom.ker (fontaineTheta B p) = span {map (PreTilt.map p f) g} := by
  have hgk : g ∈ RingHom.ker (fontaineTheta A p) := hg ▸ mem_span_singleton_self g
  refine (IsIntegralPerfectoid.ker_fontaineTheta_eq_span_iff_isDistinguished ?_).mpr
    ((IsIntegralPerfectoid.isDistinguished_of_ker_fontaineTheta_eq_span hg).map _)
  rw [RingHom.mem_ker, theta_natural, RingHom.mem_ker.mp hgk, map_zero]

/-- **`A_inf(f)` maps `ker θ_A` to generators of `ker θ_B`.** For a ring homomorphism
`f : A →+* B` of nonzero integral perfectoid rings, the ideal generated by the image of `ker θ_A`
under `W(f♭)` is `ker θ_B`. When `f` is surjective, so is `W(f♭)` (`PreTilt.map_surjective`), and
then `W(f♭)` maps `ker θ_A` onto `ker θ_B` (`Ideal.mem_map_iff_of_surjective`;
Česnavičius–Scholze, *Purity for flat cohomology*, (2.1.4.1)). -/
theorem map_ker_fontaineTheta (f : A →+* B) :
    (RingHom.ker (fontaineTheta A p)).map (map (PreTilt.map p f)) =
      RingHom.ker (fontaineTheta B p) := by
  obtain ⟨g, -, hg⟩ :=
    IsIntegralPerfectoid.exists_isDistinguished_ker_fontaineTheta_eq_span (p := p) (A := A)
  rw [hg, map_span, Set.image_singleton, ker_fontaineTheta_eq_span_map f hg]

/-- **The kernel of `A_inf(f)` meets `ker θ_A` in `(ker θ_A) (ker A_inf(f))`.** For a ring
homomorphism `f : A →+* B` of nonzero integral perfectoid rings, if `ξ y` lies in the kernel of
`W(f♭)` for a generator `ξ` of `ker θ_A`, then so does `y`, because `W(f♭) ξ` generates `ker θ_B`
and is therefore a nonzerodivisor of `W(B♭)`. -/
theorem ker_map_inf_ker_fontaineTheta (f : A →+* B) :
    RingHom.ker (map (PreTilt.map p f)) ⊓ RingHom.ker (fontaineTheta A p) =
      RingHom.ker (fontaineTheta A p) * RingHom.ker (map (PreTilt.map p f)) := by
  refine le_antisymm (fun x hx ↦ ?_) (by rw [inf_comm]; exact mul_le_inf)
  obtain ⟨g, -, hg⟩ :=
    IsIntegralPerfectoid.exists_isDistinguished_ker_fontaineTheta_eq_span (p := p) (A := A)
  have hreg := IsIntegralPerfectoid.mem_nonZeroDivisors_of_ker_fontaineTheta_eq_span
    (ker_fontaineTheta_eq_span_map f hg)
  obtain ⟨hxK, hxθ⟩ := Submodule.mem_inf.mp hx
  rw [hg] at hxθ ⊢
  obtain ⟨y, rfl⟩ := mem_span_singleton'.mp hxθ
  have hy : y ∈ RingHom.ker (map (PreTilt.map p f)) := by
    rw [RingHom.mem_ker, map_mul] at hxK
    exact (mul_right_mem_nonZeroDivisors_eq_zero_iff hreg).mp hxK
  rw [mul_comm y g]
  exact mul_mem_mul (mem_span_singleton_self g) hy

end WittVector

namespace PreTilt

/-- **The tilt of a surjection of integral perfectoid rings is surjective.** If `f : A →+* B` is
a surjective ring homomorphism of nonzero integral perfectoid rings, then the induced map of tilts
`f♭ : A♭ → B♭` is surjective (Česnavičius–Scholze, *Purity for flat cohomology*, proof of
Proposition 2.1.4). Consequently `W(f♭)` is surjective, by `WittVector.map_surjective`. -/
theorem map_surjective {f : A →+* B} (hf : Function.Surjective f) :
    Function.Surjective (map p f) := by
  obtain ⟨g, -, hg⟩ :=
    IsIntegralPerfectoid.exists_isDistinguished_ker_fontaineTheta_eq_span (p := p) (A := A)
  have hg' := WittVector.ker_fontaineTheta_eq_span_map f hg
  have := IsIntegralPerfectoid.isAdicComplete_span_coeff_zero hg
  have hB := IsIntegralPerfectoid.isAdicComplete_span_coeff_zero hg'
  rw [WittVector.map_coeff] at hB
  -- `B♭` is separated for the image of the ideal `(g₀)` of `A♭`.
  have : IsHausdorff ((span {g.coeff 0}).map (map p f)) (PreTilt B p) := by
    rw [map_span, Set.image_singleton]
    infer_instance
  refine surjective_of_mk_map_comp_surjective (I := span {g.coeff 0}) _ fun y ↦ ?_
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  -- Lift `y♯` to `a ∈ A` and `a` modulo `p` to `x ∈ A♭`; then `f♭ x ≡ y` modulo `f♭ g₀`, as the
  -- sharp map identifies `B♭ ⧸ (f♭ g₀)` with `B ⧸ ((f♭ g₀)♯)` and `(f♭ g₀)♯ ∣ p`.
  obtain ⟨a, ha⟩ := hf y.untilt
  obtain ⟨x, hx⟩ :=
    IsIntegralPerfectoid.coeff_surjective (p := p) 0 (Ideal.Quotient.mk (span {(p : A)}) a)
  have hpx : (p : A) ∣ x.untilt - a := by
    rw [← mem_span_singleton, ← Ideal.Quotient.eq, mk_untilt_eq_coeff_zero, hx]
  have hdvdA := (IsIntegralPerfectoid.associated_untilt_coeff_zero hg).dvd
  have hdvd : (map p f (g.coeff 0)).untilt ∣ (p : B) := by
    simpa [untilt_natural] using map_dvd f hdvdA
  refine ⟨x, ?_⟩
  rw [RingHom.comp_apply, Ideal.Quotient.eq, map_span, Set.image_singleton, ← Ideal.Quotient.eq]
  refine (quotientSpanEquiv hdvd).injective ?_
  rw [quotientSpanEquiv_mk, quotientSpanEquiv_mk, Ideal.Quotient.eq, mem_span_singleton,
    untilt_natural, untilt_natural, ← ha, ← map_sub]
  exact map_dvd f (hdvdA.trans hpx)

end PreTilt

namespace WittVector

/-- **`A_inf(A)` surjects onto the fibre product `A_inf(B) ×_B A`** for a surjection
`f : A →+* B` of nonzero integral perfectoid rings (Česnavičius–Scholze, *Purity for flat
cohomology*, (2.1.4.1)): if `θ_B w = f a`, then some `v : W(A♭)` has `W(f♭) v = w` and
`θ_A v = a`. -/
theorem exists_map_eq_and_fontaineTheta_eq {f : A →+* B} (hf : Function.Surjective f)
    {w : WittVector p (PreTilt B p)} {a : A} (h : fontaineTheta B p w = f a) :
    ∃ v, map (PreTilt.map p f) v = w ∧ fontaineTheta A p v = a := by
  obtain ⟨v, rfl⟩ := IsIntegralPerfectoid.surjective_fontaineTheta (p := p) a
  -- `W(f♭) v - w` lies in `ker θ_B`, which is the image of `ker θ_A` as `W(f♭)` is surjective.
  have hw : map (PreTilt.map p f) v - w ∈ (RingHom.ker (fontaineTheta A p)).map
      (map (PreTilt.map p f)) := by
    rw [map_ker_fontaineTheta, RingHom.mem_ker, map_sub, theta_natural, h, sub_self]
  obtain ⟨k, hk, hkv⟩ :=
    (mem_map_iff_of_surjective _ (map_surjective _ (PreTilt.map_surjective hf))).mp hw
  refine ⟨v - k, by rw [map_sub, hkv, sub_sub_cancel], ?_⟩
  rw [map_sub, RingHom.mem_ker.mp hk, sub_zero]

/-- **`θ_A` maps the kernel of `A_inf(f)` onto `ker f`** for a surjection `f : A →+* B` of
nonzero integral perfectoid rings. With `WittVector.ker_map_inf_ker_fontaineTheta`, this says that
`θ_A` induces `ker W(f♭) ⧸ ξ ker W(f♭) ≅ ker f` for a generator `ξ` of `ker θ_A`
(Česnavičius–Scholze, *Purity for flat cohomology*, Proposition 2.1.4). -/
theorem map_fontaineTheta_ker_map {f : A →+* B} (hf : Function.Surjective f) :
    (RingHom.ker (map (PreTilt.map p f))).map (fontaineTheta A p) = RingHom.ker f := by
  refine le_antisymm (map_le_iff_le_comap.mpr fun x hx ↦ ?_) fun a ha ↦ ?_
  · rw [mem_comap, RingHom.mem_ker, ← theta_natural, RingHom.mem_ker.mp hx, map_zero]
  · obtain ⟨v, hv, rfl⟩ := exists_map_eq_and_fontaineTheta_eq hf
      (w := (0 : WittVector p (PreTilt B p))) (by rw [map_zero, RingHom.mem_ker.mp ha])
    exact mem_map_of_mem _ (RingHom.mem_ker.mpr hv)

end WittVector
