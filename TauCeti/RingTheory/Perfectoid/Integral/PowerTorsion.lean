module

public import TauCeti.RingTheory.Perfectoid.Integral.Tilt
public import TauCeti.RingTheory.WittVector.Primitive.Torsion

/-!
# The `p`-power torsion of an integral perfectoid ring is killed by `p`

Let `A` be an integral perfectoid ring (`TauCeti.Perfectoid.IsIntegralPerfectoid`). This file
shows that `A[p^∞] = A[p]`: every element of `A` killed by some power of `p` is already killed by
`p`. No torsion-freeness is assumed; `A` may have `p`-torsion and zero divisors, and may be the
zero ring.

For nonzero `A`, Fontaine's map `θ : W(A♭) → A` is surjective and its kernel is generated by a
distinguished element `ξ`, one whose first Witt coordinate is a unit
(`TauCeti.Perfectoid.IsIntegralPerfectoid.exists_isDistinguished_ker_fontaineTheta_eq_span`).
So `A` is a quotient `W(A♭) ⧸ (ξ)` of the Witt vectors of the perfect ring `A♭`, and the statement
is the corresponding bound for such quotients,
`WittVector.IsDistinguished.dvd_p_mul_of_dvd_p_pow_mul`.

The bound is uniform: it does not depend on `A`. This is what makes the `p`-power torsion of an
arbitrary product of integral perfectoid rings bounded.

## Main results

* `TauCeti.Perfectoid.IsIntegralPerfectoid.natCast_mul_eq_zero_of_natCast_pow_mul_eq_zero`: if
  `p ^ n x = 0` in `A`, then `p x = 0`.
* `TauCeti.Perfectoid.IsIntegralPerfectoid.natCast_pow_mul_eq_zero_iff`: for `n ≠ 0`,
  `p ^ n x = 0` if and only if `p x = 0`.
* `TauCeti.Perfectoid.IsIntegralPerfectoid.torsion'_powers_natCast_eq_torsionBy`: the
  `p`-power torsion submodule of `A` is its `p`-torsion submodule.

## References

* B. Bhatt, M. Morrow, P. Scholze, *Topological Hochschild homology and integral p-adic Hodge
  theory*, Proposition 4.19(3) and its proof.
* B. Bhatt, M. Morrow, P. Scholze, *Integral p-adic Hodge theory*, Remark 3.11.
-/

public section

namespace TauCeti.Perfectoid.IsIntegralPerfectoid

open Ideal

variable {p : ℕ} [Fact p.Prime] {A : Type*} [CommRing A] [IsIntegralPerfectoid p A]

/-- **The `p`-power torsion of an integral perfectoid ring is killed by `p`**
(Bhatt–Morrow–Scholze, *Topological Hochschild homology and integral p-adic Hodge theory*,
Proposition 4.19(3)). If `p ^ n x = 0` in an integral perfectoid ring `A`, then `p x = 0`. -/
theorem natCast_mul_eq_zero_of_natCast_pow_mul_eq_zero {x : A} {n : ℕ}
    (h : (p : A) ^ n * x = 0) : (p : A) * x = 0 := by
  cases subsingleton_or_nontrivial A with
  | inl _ => exact Subsingleton.elim _ _
  | inr _ =>
    have : Fact ¬IsUnit (p : A) := ⟨not_isUnit_natCast⟩
    obtain ⟨ξ, hξ, hker⟩ := exists_isDistinguished_ker_fontaineTheta_eq_span (p := p) (A := A)
    -- Write `x = θ w`. Then `θ (p ^ n w) = 0`, so `ξ ∣ p ^ n w`, hence `ξ ∣ p w`.
    obtain ⟨w, rfl⟩ := surjective_fontaineTheta (p := p) x
    have hw : ξ ∣ (p : WittVector p (PreTilt A p)) ^ n * w := by
      rw [← mem_span_singleton, ← hker, RingHom.mem_ker, map_mul, map_pow, map_natCast, h]
    have hpw := hξ.dvd_p_mul_of_dvd_p_pow_mul hw
    rwa [← mem_span_singleton, ← hker, RingHom.mem_ker, map_mul, map_natCast] at hpw

/-- In an integral perfectoid ring, for `n ≠ 0`, an element is killed by `p ^ n` if and only if it
is killed by `p`. -/
theorem natCast_pow_mul_eq_zero_iff {x : A} {n : ℕ} (hn : n ≠ 0) :
    (p : A) ^ n * x = 0 ↔ (p : A) * x = 0 :=
  ⟨natCast_mul_eq_zero_of_natCast_pow_mul_eq_zero, fun h ↦ by
    rw [← Nat.succ_pred_eq_of_ne_zero hn, pow_succ, mul_assoc, h, mul_zero]⟩

/-- **`A[p^∞] = A[p]` for an integral perfectoid ring `A`.** The submodule of elements of `A`
killed by some power of `p` is the submodule of elements killed by `p`. -/
theorem torsion'_powers_natCast_eq_torsionBy :
    Submodule.torsion' A A (Submonoid.powers (p : A)) = Submodule.torsionBy A A (p : A) := by
  ext x
  simp only [Submodule.mem_torsion'_iff, Submodule.mem_torsionBy_iff, smul_eq_mul]
  exact ⟨fun ⟨⟨_, n, rfl⟩, hx⟩ ↦ natCast_mul_eq_zero_of_natCast_pow_mul_eq_zero hx,
    fun hx ↦ ⟨⟨p, 1, pow_one _⟩, hx⟩⟩

end TauCeti.Perfectoid.IsIntegralPerfectoid
