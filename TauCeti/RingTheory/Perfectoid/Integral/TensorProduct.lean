module

public import TauCeti.RingTheory.Perfectoid.Integral.Map

import TauCeti.RingTheory.TensorProduct.LiftEquiv

/-!
# An integral perfectoid algebra is the base change of its `A_inf`

Let `R → S` be an algebra map of nonzero integral perfectoid rings, with tilts `R♭`, `S♭` and
Fontaine's maps `θ_R : W(R♭) → R`, `θ_S : W(S♭) → S`. Regard `R` as a `W(R♭)`-algebra through
`θ_R`, and `W(S♭)` as a `W(R♭)`-algebra through `W(R♭) → W(S♭)`, the Witt vectors of the tilt of
the structure map. Then

`R ⊗_{W(R♭)} W(S♭) ≃ S`, `r ⊗ w ↦ r • θ_S w`,

as `R`-algebras (`TauCeti.PreTilt.tensorWittVectorEquiv`), induced by `θ_S` regarded as a
`W(R♭)`-algebra homomorphism (`WittVector.fontaineThetaAlgHom`). Indeed `θ_R` is
surjective, so `R` is the quotient of `W(R♭)` by `ker θ_R` and the left side is the quotient of
`W(S♭)` by the ideal generated by the image of `ker θ_R`. That ideal is `ker θ_S`: a generator
`ξ` of `ker θ_R` is distinguished, so its image is a distinguished element of `ker θ_S`, hence a
generator (`WittVector.ker_fontaineTheta_eq_span_map`). Finally `θ_S` is surjective. The
isomorphism is natural in `S`: for an `R`-algebra map `h : S → S'`, `h` carries `r • θ_S w`, the
image of `r ⊗ w`, to `r • θ_{S'} (W(h♭) w)`, the image of `r ⊗ W(h♭) w`, where `W(h♭)` is the
`W(R♭)`-algebra homomorphism `WittVector.mapTiltAlgHom`
(`TauCeti.PreTilt.tensorWittVectorEquiv_comp_map`).

For `R = O_C`, the ring of integers of `ℂ_p`, with `W(R♭) = A_inf` and `ker θ_R = (ξ)`, this is
the isomorphism `O_C ⊗_{A_inf} W(S♭) ≅ S` by which an `O_C`-algebra `S` is recovered from its tilt.
Together with the universal property of the tilt over a base
(`TauCeti.PreTilt.wittVectorAlgHomEquiv`), for a perfect `O_C♭`-algebra `b` and a `p`-adically
complete `O_C`-algebra `A` in which `p` is not a unit, the `O_C`-algebra homomorphisms
`O_C ⊗_{A_inf} W(b) → A` correspond to the ring homomorphisms `b → A♭` compatible with
`O_C♭ → b` and with the tilt `O_C♭ → A♭` of the structure map.

## Main definitions

* `TauCeti.PreTilt.tensorWittVectorEquiv`: the `R`-algebra isomorphism `R ⊗_{W(R♭)} W(S♭) ≃ S`.

## Main results

* `TauCeti.PreTilt.tensorWittVectorEquiv_tmul`: it sends `r ⊗ w` to `r • θ_S w`.
* `TauCeti.PreTilt.tensorWittVectorEquiv_symm_fontaineTheta`: its inverse sends `θ_S w` to `1 ⊗ w`.
* `TauCeti.PreTilt.tensorWittVectorEquiv_comp_map`: it is natural in `S`.

## References

* B. Bhatt, M. Morrow, P. Scholze, *Integral p-adic Hodge theory*, Lemma 3.10 and Remark 3.11.
* P. Scholze, *Perfectoid spaces*, Theorem 5.2 (the tilting equivalence).
* `grh-lean`, https://github.com/lsernau/grh-lean, file
  `src/Lib/PadicComparison/Descent/TestCovers.lean` (declarations `New.Variety.PadicTest.ker_theta`
  and `New.Variety.PadicTest.thetaIso`, the same isomorphism for the rings of `p`-adic tests over
  `O_C`); Apache 2.0, Copyright 2026 Anthropic, PBC.
-/

public section

open Ideal _root_.WittVector TauCeti.Perfectoid
open scoped TensorProduct

namespace TauCeti.PreTilt

variable {p : ℕ} [Fact p.Prime] {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [IsIntegralPerfectoid p R] [IsIntegralPerfectoid p S] [Fact ¬IsUnit (p : R)]
  [Fact ¬IsUnit (p : S)] [Algebra (WittVector p (PreTilt R p)) R]
  [Algebra (WittVector p (PreTilt R p)) (WittVector p (PreTilt S p))]
  [Algebra (WittVector p (PreTilt R p)) S] [IsScalarTower (WittVector p (PreTilt R p)) R S]

variable (p R S) in
/-- **An integral perfectoid algebra is the base change of its `A_inf`.** For an algebra map
`R → S` of nonzero integral perfectoid rings, with `R` and `W(S♭)` regarded as `W(R♭)`-algebras
through `θ_R` and through the Witt vectors of the tilt of the structure map, the map
`r ⊗ w ↦ r • θ_S w` is an `R`-algebra isomorphism `R ⊗_{W(R♭)} W(S♭) ≃ S`
(`tensorWittVectorEquiv_tmul`). -/
noncomputable def tensorWittVectorEquiv
    (hR : algebraMap (WittVector p (PreTilt R p)) R = fontaineTheta R p)
    (hS : algebraMap (WittVector p (PreTilt R p)) (WittVector p (PreTilt S p)) =
      WittVector.map (PreTilt.map p (algebraMap R S))) :
    R ⊗[WittVector p (PreTilt R p)] WittVector p (PreTilt S p) ≃ₐ[R] S :=
  .ofBijective (AlgHom.liftEquiv _ R _ S (fontaineThetaAlgHom hR hS)) <|
    AlgHom.liftEquiv_bijective_of_ker_le_map _
      (hR ▸ IsIntegralPerfectoid.surjective_fontaineTheta)
      (by rw [← AlgHom.coe_toRingHom, coe_fontaineThetaAlgHom]
          exact IsIntegralPerfectoid.surjective_fontaineTheta (p := p) (A := S)) <| by
        -- `ker θ_S` is generated by the image of `ker θ_R`.
        rw [← RingHom.ker_coe_toRingHom, coe_fontaineThetaAlgHom, hR, hS, map_ker_fontaineTheta]

/-- `tensorWittVectorEquiv` sends `r ⊗ w` to `r • θ_S w`. -/
@[simp]
theorem tensorWittVectorEquiv_tmul
    (hR : algebraMap (WittVector p (PreTilt R p)) R = fontaineTheta R p)
    (hS : algebraMap (WittVector p (PreTilt R p)) (WittVector p (PreTilt S p)) =
      WittVector.map (PreTilt.map p (algebraMap R S)))
    (r : R) (w : WittVector p (PreTilt S p)) :
    tensorWittVectorEquiv p R S hR hS (r ⊗ₜ w) = r • fontaineTheta S p w := by
  rw [tensorWittVectorEquiv, AlgEquiv.ofBijective_apply, AlgHom.liftEquiv_tmul,
    fontaineThetaAlgHom_apply]

/-- The inverse of `tensorWittVectorEquiv` sends `θ_S w` to `1 ⊗ w`. -/
@[simp]
theorem tensorWittVectorEquiv_symm_fontaineTheta
    (hR : algebraMap (WittVector p (PreTilt R p)) R = fontaineTheta R p)
    (hS : algebraMap (WittVector p (PreTilt R p)) (WittVector p (PreTilt S p)) =
      WittVector.map (PreTilt.map p (algebraMap R S)))
    (w : WittVector p (PreTilt S p)) :
    (tensorWittVectorEquiv p R S hR hS).symm (fontaineTheta S p w) = 1 ⊗ₜ w := by
  rw [AlgEquiv.symm_apply_eq, tensorWittVectorEquiv_tmul, one_smul]

/-- **Naturality of `tensorWittVectorEquiv` in `S`.** For an `R`-algebra homomorphism `h : S → S'`,
the square formed by `R ⊗ W(h♭)`, `h` and the two isomorphisms commutes. -/
theorem tensorWittVectorEquiv_comp_map {S' : Type*} [CommRing S'] [Algebra R S']
    [IsIntegralPerfectoid p S'] [Fact ¬IsUnit (p : S')]
    [Algebra (WittVector p (PreTilt R p)) (WittVector p (PreTilt S' p))]
    [Algebra (WittVector p (PreTilt R p)) S'] [IsScalarTower (WittVector p (PreTilt R p)) R S']
    (hR : algebraMap (WittVector p (PreTilt R p)) R = fontaineTheta R p)
    (hS : algebraMap (WittVector p (PreTilt R p)) (WittVector p (PreTilt S p)) =
      WittVector.map (PreTilt.map p (algebraMap R S)))
    (hS' : algebraMap (WittVector p (PreTilt R p)) (WittVector p (PreTilt S' p)) =
      WittVector.map (PreTilt.map p (algebraMap R S')))
    (h : S →ₐ[R] S') :
    (tensorWittVectorEquiv p R S' hR hS' : _ →ₐ[R] S').comp
        (Algebra.TensorProduct.map (AlgHom.id R R) (mapTiltAlgHom hS hS' h)) =
      h.comp (tensorWittVectorEquiv p R S hR hS) :=
  Algebra.TensorProduct.ext' fun r w ↦ by
    simp only [AlgHom.comp_apply, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
      AlgEquiv.coe_toAlgHom, tensorWittVectorEquiv_tmul, mapTiltAlgHom_apply, map_smul]
    -- `θ_{S'} ∘ W(h♭) = h ∘ θ_S`, applied to `w`.
    rw [theta_natural, AlgHom.coe_toRingHom]

end TauCeti.PreTilt
