module

public import TauCeti.RingTheory.Perfectoid.Integral.Map
public import TauCeti.RingTheory.Perfectoid.PreTilt.Lift

import TauCeti.RingTheory.WittVector.MapEquiv

/-!
# Tilting integral perfectoid algebras is fully faithful

Let `A` be a ring whose Fontaine map `θ_A : W(A♭) → A` is surjective with kernel generated by
`ξ`, for instance a nonzero integral perfectoid ring (`TauCeti.Perfectoid.IsIntegralPerfectoid`),
and let `B` be a `p`-adically complete ring in which `p` is not a unit. This file compares ring
homomorphisms `h : A → B` with their tilts `h♭ = PreTilt.map p h : A♭ → B♭`.

* **Faithfulness.** `h` is determined by `h♭`, because `h ∘ θ_A = θ_B ∘ W(h♭)` and `θ_A` is onto
  (`PreTilt.map_eq_map_iff`).
* **Fullness.** A ring homomorphism `g : A♭ → B♭` is the tilt of some `h` exactly when
  `θ_B (W(g) ξ) = 0` (`PreTilt.exists_map_eq_iff`). Indeed `θ_B ∘ W(g)` then kills
  `ker θ_A = (ξ)`, so it factors through `θ_A` as some `h`; and `h♭ = g`, since both have the same
  image `θ_B ∘ W(h♭) = h ∘ θ_A = θ_B ∘ W(g)` under the bijection `f ↦ θ_B ∘ W(f)` out of the perfect
  ring `A♭` (`PreTilt.wittVectorHomEquiv`).
* **Over a base.** Let `R → A` and `R → B` be algebras over a nonzero integral perfectoid ring `R`,
  with `A` nonzero integral perfectoid. A generator `ξ` of `ker θ_R` maps to a generator of
  `ker θ_A` (`WittVector.ker_fontaineTheta_eq_span_map`), and `θ_B` kills the image of `ξ` under
  `W(g)` for every `g` compatible with the tilts of the structure maps. So `h ↦ h♭` is a bijection
  from `R`-algebra homomorphisms `A → B` to ring homomorphisms `A♭ → B♭` compatible with the tilts
  of the structure maps (`PreTilt.algHomEquiv`).

For `R = O_C`, the ring of integers of `ℂ_p`, and `A`, `B` products of `p`-adically complete
absolutely integrally closed valuation rings (integral perfectoid by
`TauCeti.Perfectoid.IsIntegralPerfectoid.of_isAbsolutelyIntegrallyClosed`), this says that tilting
is fully faithful on such `O_C`-algebras.

## Main definitions

* `PreTilt.algHomEquiv`: for `R`-algebras `A` and `B` over an integral perfectoid `R`, with `A`
  integral perfectoid, the bijection `h ↦ h♭` from `A →ₐ[R] B` to ring homomorphisms `A♭ → B♭`
  compatible with the tilts of the structure maps.

## Main results

* `PreTilt.map_eq_map_iff`: if `θ_A` is surjective, `h₁♭ = h₂♭` only if `h₁ = h₂`.
* `PreTilt.exists_map_eq_iff`: if `θ_A` is surjective with kernel `(ξ)`, a ring homomorphism
  `g : A♭ → B♭` is a tilt exactly when `θ_B (W(g) ξ) = 0`.
* `PreTilt.exists_map_eq_and_comp_eq`: over a nonzero integral perfectoid `R`, a ring homomorphism
  `g : A♭ → B♭` with `g ∘ f♭ = f'♭` is the tilt of some `h` with `h ∘ f = f'`.

## References

* B. Bhatt, M. Morrow, P. Scholze, *Integral p-adic Hodge theory*, Lemma 3.10 and Remark 3.11.
* P. Scholze, *Perfectoid spaces*, Theorem 5.2 (the tilting equivalence).
* `grh-lean`, https://github.com/lsernau/grh-lean, file
  `src/Lib/PadicComparison/Descent/TestCovers.lean` (the instances `tilt.Full` and `tilt.Faithful`
  for `p`-adic tests); Apache 2.0, Copyright 2026 Anthropic, PBC.
-/

public section

open Ideal _root_.WittVector TauCeti.Perfectoid

namespace PreTilt

variable {p : ℕ} [Fact p.Prime] {R A B : Type*} [CommRing A] [CommRing B] [Fact ¬IsUnit (p : A)]
  [Fact ¬IsUnit (p : B)] [IsAdicComplete (span {(p : A)}) A] [IsAdicComplete (span {(p : B)}) B]

local notation "𝕎" => WittVector p

/-- **Tilting is faithful on rings with surjective Fontaine map.** If `θ_A` is surjective, for
instance if `A` is integral perfectoid, two ring homomorphisms `A → B` with the same tilt are
equal. -/
theorem map_eq_map_iff (hθ : Function.Surjective (fontaineTheta A p)) {h₁ h₂ : A →+* B} :
    map p h₁ = map p h₂ ↔ h₁ = h₂ := by
  refine ⟨fun h ↦ (RingHom.cancel_right hθ).mp ?_, fun h ↦ h ▸ rfl⟩
  rw [← theta_natural_comp, ← theta_natural_comp, h]

/-- **Fullness of tilting.** If `θ_A` is surjective with kernel generated by `ξ`, a ring
homomorphism `g : A♭ → B♭` is the tilt of a ring homomorphism `A → B` exactly when `θ_B` kills the
image of `ξ` under `W(g)`. -/
theorem exists_map_eq_iff (hθ : Function.Surjective (fontaineTheta A p)) {ξ : 𝕎 (PreTilt A p)}
    (hξ : RingHom.ker (fontaineTheta A p) = span {ξ}) (g : PreTilt A p →+* PreTilt B p) :
    (∃ h : A →+* B, map p h = g) ↔ fontaineTheta B p (WittVector.map g ξ) = 0 := by
  have hξmem : ξ ∈ RingHom.ker (fontaineTheta A p) := hξ ▸ mem_span_singleton_self ξ
  refine ⟨?_, fun hg ↦ ?_⟩
  · rintro ⟨h, rfl⟩
    rw [theta_natural, RingHom.mem_ker.mp hξmem, map_zero]
  -- `θ_B ∘ W(g)` kills `ker θ_A = (ξ)`, so it factors through the surjection `θ_A`.
  let ψ := wittVectorHomEquiv p (PreTilt A p) B g
  have hker : RingHom.ker (fontaineTheta A p) ≤ RingHom.ker ψ := by
    rw [hξ, span_singleton_le_iff_mem, RingHom.mem_ker]
    simpa only [ψ, wittVectorHomEquiv_apply, RingHom.comp_apply] using hg
  let h := (fontaineTheta A p).liftOfSurjective hθ ⟨ψ, hker⟩
  refine ⟨h, (wittVectorHomEquiv p (PreTilt A p) B).injective ?_⟩
  rw [wittVectorHomEquiv_apply, theta_natural_comp]
  exact (fontaineTheta A p).liftOfSurjective_comp hθ ⟨ψ, hker⟩

variable [CommRing R] [IsIntegralPerfectoid p R] [Fact ¬IsUnit (p : R)]
  [IsIntegralPerfectoid p A]

omit [IsAdicComplete (span {(p : A)}) A] in
/-- **Fullness of tilting over an integral perfectoid base.** Let `f : R → A` and `f' : R → B`
be ring homomorphisms from a nonzero integral perfectoid ring `R`, with `A` nonzero integral
perfectoid. A ring homomorphism `g : A♭ → B♭` with `g ∘ f♭ = f'♭` is the tilt of a ring
homomorphism `h : A → B` with `h ∘ f = f'`. -/
theorem exists_map_eq_and_comp_eq (f : R →+* A) (f' : R →+* B)
    {g : PreTilt A p →+* PreTilt B p} (hg : g.comp (map p f) = map p f') :
    ∃ h : A →+* B, map p h = g ∧ h.comp f = f' := by
  obtain ⟨ξ, -, hξ⟩ :=
    IsIntegralPerfectoid.exists_isDistinguished_ker_fontaineTheta_eq_span (p := p) (A := R)
  have hξ0 : fontaineTheta R p ξ = 0 := RingHom.mem_ker.mp (hξ ▸ mem_span_singleton_self ξ)
  -- `W(g)` carries the generator `W(f♭) ξ` of `ker θ_A` to `W(f'♭) ξ ∈ ker θ_B`.
  obtain ⟨h, hh⟩ := (exists_map_eq_iff IsIntegralPerfectoid.surjective_fontaineTheta
    (ker_fontaineTheta_eq_span_map f hξ) g).mpr <| by
      rw [← RingHom.comp_apply (WittVector.map g), ← WittVector.map_comp, hg, theta_natural, hξ0,
        map_zero]
  refine ⟨h, hh, (map_eq_map_iff (B := B)
    (IsIntegralPerfectoid.surjective_fontaineTheta (p := p) (A := R))).mp ?_⟩
  rw [PreTilt.map_comp, hh, hg]

variable [Algebra R A] [Algebra R B]

omit [IsAdicComplete (span {(p : A)}) A] in
/-- The `R`-algebra homomorphism `A → B` whose tilt is a given ring homomorphism `A♭ → B♭`
compatible with the tilts of the structure maps. -/
private noncomputable def algHomOfMap
    (g : {g : PreTilt A p →+* PreTilt B p //
      g.comp (map p (algebraMap R A)) = map p (algebraMap R B)}) : A →ₐ[R] B :=
  .mk' (exists_map_eq_and_comp_eq _ _ g.property).choose fun r x ↦ by
    rw [Algebra.smul_def, Algebra.smul_def, map_mul,
      ← RingHom.comp_apply _ (algebraMap R A),
      (exists_map_eq_and_comp_eq _ _ g.property).choose_spec.2]

omit [IsAdicComplete (span {(p : A)}) A] in
private theorem map_algHomOfMap
    (g : {g : PreTilt A p →+* PreTilt B p //
      g.comp (map p (algebraMap R A)) = map p (algebraMap R B)}) :
    map p (algHomOfMap g : A →+* B) = g :=
  (exists_map_eq_and_comp_eq _ _ g.property).choose_spec.1

omit [IsAdicComplete (span {(p : A)}) A] in
variable (p R A B) in
/-- **Tilting is fully faithful over an integral perfectoid base.** For algebras `A` and `B` over
a nonzero integral perfectoid ring `R`, with `A` nonzero integral perfectoid and `B` `p`-adically
complete, `h ↦ h♭` is a bijection from `R`-algebra homomorphisms `A → B` to ring homomorphisms
`A♭ → B♭` compatible with the tilts of the structure maps. -/
noncomputable def algHomEquiv : (A →ₐ[R] B) ≃
    {g : PreTilt A p →+* PreTilt B p //
      g.comp (map p (algebraMap R A)) = map p (algebraMap R B)} where
  toFun h := ⟨map p h, by rw [← PreTilt.map_comp, h.comp_algebraMap]⟩
  invFun := algHomOfMap
  left_inv h := AlgHom.toRingHom_injective <|
    (map_eq_map_iff IsIntegralPerfectoid.surjective_fontaineTheta).mp (map_algHomOfMap _)
  right_inv g := Subtype.ext (map_algHomOfMap g)

omit [IsAdicComplete (span {(p : A)}) A] in
@[simp]
theorem coe_algHomEquiv_apply (h : A →ₐ[R] B) :
    (algHomEquiv p R A B h : PreTilt A p →+* PreTilt B p) = map p h :=
  (rfl)

omit [IsAdicComplete (span {(p : A)}) A] in
/-- The inverse of `algHomEquiv` sends `g` to the `R`-algebra homomorphism whose tilt is `g`. -/
@[simp]
theorem map_algHomEquiv_symm_apply
    (g : {g : PreTilt A p →+* PreTilt B p //
      g.comp (map p (algebraMap R A)) = map p (algebraMap R B)}) :
    map p ((algHomEquiv p R A B).symm g : A →+* B) = g :=
  congrArg Subtype.val ((algHomEquiv p R A B).apply_symm_apply g)

end PreTilt
