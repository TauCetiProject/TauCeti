module

public import TauCeti.RingTheory.Ideal.Quotient.Radical
public import TauCeti.RingTheory.Perfect.FrobeniusRootIdeal
public import TauCeti.RingTheory.Perfectoid.Integral.Basic

/-!
# Quotients of perfect rings of characteristic `p`

Let `R` be a perfect ring of characteristic `p` and `I` an ideal of `R`. Frobenius on the quotient
`R ⧸ I` is surjective (`Function.Surjective.surjective_pow`), so `R ⧸ I` is semiperfect. It is
integral perfectoid exactly when `I` is radical (`isIntegralPerfectoid_quotient_iff_isRadical`):
in characteristic `p` the integral perfectoid rings are the perfect rings, and the quotient by a
nonradical ideal has nilpotents. This includes `I = ⊤`, whose quotient is the zero ring.

The quotient `R ⧸ √I` is the universal integral perfectoid quotient of `R ⧸ I`: it is integral
perfectoid, and every ring homomorphism from `R ⧸ I` to an integral perfectoid ring factors
uniquely through it (`bijective_comp_factor_radical`). The target need not have characteristic
`p` in advance: a ring homomorphism from `R ⧸ I` forces `p = 0` in it, and an integral perfectoid
ring in which `p` vanishes is reduced. This is the characteristic `p` case of the computation of
the perfectoidization of a semiperfectoid ring (Bhatt–Scholze, Theorem 7.4).

For a principal ideal `(f)`, the radical is the Frobenius-root ideal generated by all
`p ^ n`-th roots of `f`. So the universal integral perfectoid quotient of `R ⧸ (f)` is the quotient
by the ideal of all roots of `f` (`bijective_comp_factor_frobeniusRootIdeal`): the quotient
`R ⧸ (f)` is perfectoid only when `(f)` is radical, while killing `f` in a perfectoid ring kills all
its roots.

## Main results

* `TauCeti.Perfectoid.isIntegralPerfectoid_quotient_iff_isRadical`: for a perfect ring `R` of
  characteristic `p`, `R ⧸ I` is integral perfectoid if and only if `I` is radical.
* `TauCeti.Perfectoid.isIntegralPerfectoid_quotient_radical`,
  `TauCeti.Perfectoid.isIntegralPerfectoid_quotient_frobeniusRootIdeal`: `R ⧸ √I` and the quotient
  by a Frobenius-root ideal are integral perfectoid.
* `TauCeti.Perfectoid.bijective_comp_factor_radical`: for an ideal `I` containing `p`, every ring
  homomorphism from `R ⧸ I` to an integral perfectoid ring factors uniquely through `R ⧸ √I`.
* `TauCeti.Perfectoid.bijective_comp_factor_frobeniusRootIdeal`: every ring homomorphism from
  `R ⧸ (f)` to an integral perfectoid ring factors uniquely through the quotient by the
  Frobenius-root ideal of `f`.

## References

* B. Bhatt, M. Morrow, P. Scholze, *Integral p-adic Hodge theory*, Example 3.15.
* B. Bhatt, P. Scholze, *Prisms and prismatic cohomology*, Theorem 7.4 and its proof.
-/

public section

namespace TauCeti.Perfectoid

variable {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R]

/-- For an ideal `I` containing `p`, every ring homomorphism from `R ⧸ I` to an integral perfectoid
ring factors uniquely through `R ⧸ √I`: precomposition with the projection `R ⧸ I → R ⧸ √I` is a
bijection. When `R` is perfect of characteristic `p`, `R ⧸ √I` is itself integral perfectoid
(`isIntegralPerfectoid_quotient_radical`), so it is the universal integral perfectoid quotient of
`R ⧸ I`. -/
theorem bijective_comp_factor_radical {I : Ideal R} (hpI : (p : R) ∈ I) (T : Type*) [CommRing T]
    [IsIntegralPerfectoid p T] :
    Function.Bijective fun g : R ⧸ I.radical →+* T ↦
      g.comp (Ideal.Quotient.factor I.le_radical) := by
  refine ⟨fun g₁ g₂ h ↦
    (RingHom.cancel_right (Ideal.Quotient.factor_surjective I.le_radical)).mp h, fun f ↦ ?_⟩
  -- a homomorphism from `R ⧸ I` forces `p = 0` in `T`, so `T` is reduced
  have : IsReduced T := IsIntegralPerfectoid.isReduced_of_natCast_eq_zero (p := p) <| by
    rw [← map_natCast f, ← map_natCast (Ideal.Quotient.mk I),
      Ideal.Quotient.eq_zero_iff_mem.mpr hpI, map_zero]
  exact (Ideal.Quotient.bijective_comp_factor_radical I T).2 f

variable [CharP R p] [PerfectRing R p]

/-- **Quotients of perfect rings that are integral perfectoid.** For a perfect ring `R` of
characteristic `p`, the quotient `R ⧸ I` is integral perfectoid if and only if `I` is radical. This
includes `I = ⊤`, whose quotient is the zero ring. -/
@[simp]
theorem isIntegralPerfectoid_quotient_iff_isRadical {I : Ideal R} :
    IsIntegralPerfectoid p (R ⧸ I) ↔ I.IsRadical := by
  rw [isIntegralPerfectoid_iff_perfectRing_of_natCast_eq_zero (by
    rw [← map_natCast (Ideal.Quotient.mk I), CharP.cast_eq_zero, map_zero]),
    Ideal.Quotient.perfectRing_iff_isRadical]

/-- For a perfect ring `R` of characteristic `p`, the quotient `R ⧸ √I` is integral perfectoid. -/
instance isIntegralPerfectoid_quotient_radical (I : Ideal R) :
    IsIntegralPerfectoid p (R ⧸ I.radical) :=
  isIntegralPerfectoid_quotient_iff_isRadical.mpr I.radical_isRadical

/-- For a perfect ring `R` of characteristic `p`, the quotient by the Frobenius-root ideal of `f`,
generated by all `p ^ n`-th roots of `f`, is integral perfectoid. -/
instance isIntegralPerfectoid_quotient_frobeniusRootIdeal (f : R) :
    IsIntegralPerfectoid p (R ⧸ frobeniusRootIdeal R p f) := by
  rw [frobeniusRootIdeal_eq_radical]
  infer_instance

/-- For a perfect ring `R` of characteristic `p` and `f ∈ R`, every ring homomorphism from
`R ⧸ (f)` to an integral perfectoid ring factors uniquely through the quotient by the
Frobenius-root ideal of `f`, which is integral perfectoid
(`isIntegralPerfectoid_quotient_frobeniusRootIdeal`). -/
theorem bijective_comp_factor_frobeniusRootIdeal (f : R) (T : Type*) [CommRing T]
    [IsIntegralPerfectoid p T] :
    Function.Bijective fun g : R ⧸ frobeniusRootIdeal R p f →+* T ↦
      g.comp (Ideal.Quotient.factor ((Ideal.span_singleton_le_iff_mem _).mpr
        (self_mem_frobeniusRootIdeal f))) := by
  -- transport `bijective_comp_factor_radical` along `frobeniusRootIdeal_eq_radical`
  have key : ∀ (J : Ideal R) (_ : J = (Ideal.span {f}).radical) (h : Ideal.span {f} ≤ J),
      Function.Bijective fun g : R ⧸ J →+* T ↦ g.comp (Ideal.Quotient.factor h) := by
    rintro _ rfl -
    exact bijective_comp_factor_radical (by rw [CharP.cast_eq_zero]; exact zero_mem _) T
  exact key _ (frobeniusRootIdeal_eq_radical f) _

end TauCeti.Perfectoid
