/-! ### Continuity of the sharp map -/

section Sharp

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [TopologicalSpace R]
  [IsTopologicalRing R] [IsTateRing R] (P : Pair R) (J : Ideal (WittVector p P.plus))

variable {p P J}

/-- Two multiplicative maps out of `R` agree as soon as they agree on `P.plus`. -/
private theorem monoidWithZeroHom_ext_plus {M : Type*} [CommMonoidWithZero M]
    {f g : R →*₀ M} (h : ∀ a : P.plus, f a = g a) : f = g := by
  ext x
  obtain ⟨ϖ, hϖ⟩ := P.isRingOfIntegralElements.exists_isPseudoUniformizer
  obtain ⟨n, hn⟩ := exists_mul_pow_mem_of_isTopologicallyNilpotent
    hϖ.isTopologicallyNilpotent P.isRingOfIntegralElements.isOpen x
  have hunit : IsUnit (f (ϖ : R) ^ n) := (hϖ.isUnit.map f).pow n
  have hfeq : f (ϖ : R) ^ n = g (ϖ : R) ^ n := by rw [h ϖ]
  refine hunit.mul_right_cancel ?_
  calc f x * f (ϖ : R) ^ n
    _ = f (x * (ϖ : R) ^ n) := by rw [map_mul, map_pow]
    _ = g (x * (ϖ : R) ^ n) := h ⟨x * (ϖ : R) ^ n, hn⟩
    _ = g x * f (ϖ : R) ^ n := by rw [map_mul, map_pow, hfeq]

section ContinuousSharp

variable [CharP R p] [PerfectRing R p]

/-- **Continuity of the sharp map**: if `R` is a perfect Tate ring of characteristic `p` and `p` is
topologically nilpotent in `untilt p P J`, then `sharp p P J : R →*₀ untilt p P J` is
continuous. -/
theorem continuous_sharp_of_isTopologicallyNilpotent
    (hp : IsTopologicallyNilpotent (p : untilt p P J)) :
    Continuous (sharp p P J) := by
  obtain ⟨ϖ, hϖ⟩ := P.isRingOfIntegralElements.exists_isPseudoUniformizer
  set π₀ : WittVector p P.plus ⧸ J := Ideal.Quotient.mk J (teichmuller p ϖ)
  have hbasis := hasBasis_nhds_zero (J := J) hϖ
  have hπ_unit : IsUnit (algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) π₀) :=
    (isPseudoUniformizer_algebraMap (J := J) hϖ).isUnit
  -- Integral uniform estimate: `ϖ ^ M ∣ a - b` puts `sharp a - sharp b` in `π ^ N A⁺`.
  have hint (N : ℕ) : ∃ M : ℕ, ∀ a b : P.plus, ϖ ^ M ∣ a - b →
      sharp p P J a - sharp p P J b ∈ awayNhd π₀ (untilt p P J) N := by
    obtain ⟨d, hd⟩ := Filter.eventually_atTop.mp
      (hp.eventually_mem (hbasis.mem_of_mem (i := N) trivial))
    refine ⟨N * p ^ d, fun a b hab ↦ ?_⟩
    set w : WittVector p P.plus := teichmuller p a - teichmuller p b
    have hcoeff (i : ℕ) : ϖ ^ (N * p ^ d) ∣ w.coeff i := by
      let q := Ideal.Quotient.mk (Ideal.span {ϖ ^ (N * p ^ d)})
      have hqab : q a = q b := Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr hab)
      have hmap : WittVector.map q w = 0 := by
        rw [map_sub, map_teichmuller, map_teichmuller, hqab, sub_self]
      have hi : q (w.coeff i) = 0 := by
        simpa [WittVector.map_coeff] using congrArg (WittVector.coeff · i) hmap
      exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hi)
    have htc (i : ℕ) (hi : i < d) : ϖ ^ N ∣ w.teichmullerCoeff i := by
      have hdiv : (ϖ ^ (N * p ^ (d - i))) ^ p ^ i ∣ (w.teichmullerCoeff i) ^ p ^ i := by
        rw [teichmullerCoeff_pow, ← pow_mul, mul_assoc, ← pow_add, Nat.sub_add_cancel hi.le]
        exact hcoeff i
      have h1 : ϖ ^ (N * p ^ (d - i)) ∣ w.teichmullerCoeff i := by
        change iterateFrobeniusEquiv P.plus p i (ϖ ^ (N * p ^ (d - i))) ∣
          iterateFrobeniusEquiv P.plus p i (w.teichmullerCoeff i) at hdiv
        exact (map_dvd_iff (iterateFrobeniusEquiv P.plus p i)).mp hdiv
      exact (pow_dvd_pow ϖ (Nat.le_mul_of_pos_right N (pow_pos (Fact.out : p.Prime).pos _))).trans
        h1
    obtain ⟨b₀, hb₀⟩ := exists_eq_sum_teichmullerCoeff_add_pow_mul w d
    have hsharp_sub : sharp p P J a - sharp p P J b =
        algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) (Ideal.Quotient.mk J w) := by
      rw [sharp_apply, sharp_apply, ← map_sub, ← map_sub]
    rw [hsharp_sub, hb₀, map_add, map_add, map_sum, map_sum]
    refine add_mem (sum_mem fun i hi ↦ ?_) ?_
    · obtain ⟨c, hc⟩ := htc i (Finset.mem_range.mp hi)
      have hteich : teichmuller p (w.teichmullerCoeff i) =
          teichmuller p ϖ ^ N * teichmuller p c := by
        rw [hc, map_mul, map_pow]
      rw [hteich, mul_assoc, map_mul, map_pow]
      exact mem_awayNhd.mpr ⟨_, rfl⟩
    · rw [map_mul, map_pow, map_natCast, map_mul, map_pow, map_natCast, mul_comm]
      have hpd := hd d le_rfl
      simpa using algebraMap_pow_mul_mul_mem_awayNhd (k := 0) (Ideal.Quotient.mk J b₀) hpd
  -- Reduce continuity at an arbitrary `x₀ : R` to the integral estimate by clearing denominators.
  refine continuous_iff_continuousAt.mpr fun x₀ ↦ ?_
  rw [ContinuousAt, ← tendsto_sub_nhds_zero_iff, hbasis.tendsto_right_iff]
  intro r _
  obtain ⟨k, hk⟩ := exists_mul_pow_mem_of_isTopologicallyNilpotent
    hϖ.isTopologicallyNilpotent P.isRingOfIntegralElements.isOpen x₀
  obtain ⟨M, hM⟩ := hint (r + k)
  let V : Set R := ((hϖ.isUnit.pow M).unit : R) • (P.plus : Set R)
  have hV : V ∈ 𝓝 (0 : R) := by
    refine (P.isRingOfIntegralElements.isOpen.smul (hϖ.isUnit.pow M).unit).mem_nhds ?_
    exact ⟨0, P.plus.zero_mem, by simp⟩
  have hmem : (fun x : R ↦ x - x₀) ⁻¹' V ∈ 𝓝 x₀ :=
    (continuous_id.sub continuous_const).continuousAt.preimage_mem_nhds (by simpa using hV)
  filter_upwards [hmem] with x hx
  obtain ⟨c, hc, hxc⟩ := Set.mem_smul_set.mp hx
  have hxk : x * (ϖ : R) ^ k ∈ P.plus := by
    have heq : x * (ϖ : R) ^ k = x₀ * (ϖ : R) ^ k + (ϖ : R) ^ M * c * (ϖ : R) ^ k := by
      have hxc' : (ϖ : R) ^ M * c = x - x₀ := by simpa [smul_eq_mul] using hxc
      linear_combination -hxc' * (ϖ : R) ^ k
    rw [heq]
    exact P.plus.add_mem hk (P.plus.mul_mem (P.plus.mul_mem (P.plus.pow_mem ϖ.property M) hc)
      (P.plus.pow_mem ϖ.property k))
  let a : P.plus := ⟨x * (ϖ : R) ^ k, hxk⟩
  let b : P.plus := ⟨x₀ * (ϖ : R) ^ k, hk⟩
  have hdvd : ϖ ^ M ∣ a - b := by
    refine ⟨⟨c, hc⟩ * ϖ ^ k, Subtype.ext ?_⟩
    have hxc' : (ϖ : R) ^ M * c = x - x₀ := by simpa [smul_eq_mul] using hxc
    simp only [AddSubgroupClass.coe_sub, Subring.coe_mul, Subring.coe_pow, a, b]
    linear_combination -hxc' * (ϖ : R) ^ k
  obtain ⟨d, hd⟩ := mem_awayNhd.mp (hM a b hdvd)
  refine mem_awayNhd.mpr ⟨d, ?_⟩
  apply (hπ_unit.pow k).mul_right_cancel
  calc algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) (π₀ ^ r * d) *
        algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) π₀ ^ k
    _ = algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) (π₀ ^ (r + k) * d) := by
        simp only [map_mul, map_pow, π₀, pow_add]
        ring
    _ = sharp p P J a - sharp p P J b := hd
    _ = (sharp p P J x - sharp p P J x₀) *
          algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) π₀ ^ k := by
        have hϖs : sharp p P J (ϖ : R) =
            algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) π₀ :=
          sharp_apply ϖ
        change sharp p P J (x * (ϖ : R) ^ k) - sharp p P J (x₀ * (ϖ : R) ^ k) = _
        rw [map_mul, map_mul, map_pow, hϖs, ← sub_mul]

/-- In the untilt along a primitive element `ξ`, `p` is topologically nilpotent. -/
theorem isTopologicallyNilpotent_natCast {ξ : WittVector p P.plus} (hξ : ξ.IsPrimitive) :
    IsTopologicallyNilpotent (p : untilt p P (Ideal.span {ξ})) := by
  obtain ⟨ϖ, hϖ⟩ := P.isRingOfIntegralElements.exists_isPseudoUniformizer
  obtain ⟨n, c, hc⟩ := P.plus.exists_dvd_pow_of_isTopologicallyNilpotent
    P.isRingOfIntegralElements.isOpen hϖ.isUnit
    (hξ.isTopologicallyNilpotent_coeff_zero.map (φ := P.plus.subtype) continuous_subtypeVal)
  obtain ⟨u, hu⟩ := isDistinguished_iff_exists_unit.mp hξ.isDistinguished
  set J := Ideal.span {ξ}
  have hξ' : Ideal.Quotient.mk J (teichmuller p (ξ.coeff 0)) =
      -((p : WittVector p P.plus ⧸ J) * Ideal.Quotient.mk J ↑u) := by
    rw [eq_neg_iff_add_eq_zero, ← map_natCast (Ideal.Quotient.mk J), ← map_mul, ← map_add,
      ← hu, Ideal.Quotient.mk_singleton_self]
  have hdvd : Ideal.Quotient.mk J (teichmuller p ϖ) ∣ (p : WittVector p P.plus ⧸ J) ^ (n + 1) := by
    refine ⟨(-Ideal.Quotient.mk J ↑u⁻¹) ^ (n + 1) *
      Ideal.Quotient.mk J (teichmuller p (ξ.coeff 0 * c)), ?_⟩
    have hϖc : Ideal.Quotient.mk J (teichmuller p ϖ) *
        Ideal.Quotient.mk J (teichmuller p (ξ.coeff 0 * c)) =
        Ideal.Quotient.mk J (teichmuller p (ξ.coeff 0)) ^ (n + 1) := by
      rw [← map_mul, ← map_mul, ← map_pow, ← map_pow, pow_succ, hc]
      congr 2
      ring
    have hu' : Ideal.Quotient.mk J ↑u⁻¹ * Ideal.Quotient.mk J ↑u = 1 := by
      rw [← map_mul, u.inv_mul, map_one]
    rw [mul_left_comm, hϖc, hξ', ← mul_pow]
    congr 1
    linear_combination -(p : WittVector p P.plus ⧸ J) * hu'
  obtain ⟨d, hd⟩ := hdvd
  have hpow : (p : untilt p P J) ^ (n + 1) =
      algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) (Ideal.Quotient.mk J (teichmuller p ϖ)) *
        algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) d := by
    rw [← map_mul, ← hd, map_pow, map_natCast]
  refine IsTopologicallyNilpotent.of_pow n.succ_ne_zero ?_
  rw [hpow, mul_comm]
  exact (isBounded_untiltPlus.isPowerBounded_of_mem
    (mem_untiltPlus.mpr ⟨d, rfl⟩)).isTopologicallyNilpotent_mul
    (isPseudoUniformizer_algebraMap hϖ).isTopologicallyNilpotent

end ContinuousSharp

end Sharp

/-! ### Functoriality -/

section Map

variable {p : ℕ} [Fact p.Prime] {R S : Type*} [CommRing R] [TopologicalSpace R]
  [IsTopologicalRing R] [IsHuberRing R] [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
  [IsHuberRing S] {P : Pair R} {Q : Pair S} {J : Ideal (WittVector p P.plus)}
  {J' : Ideal (WittVector p Q.plus)}

/-- **Functoriality of the untilt**: a ring homomorphism `f : R →+* S` carrying `P.plus` into
`Q.plus` with `J ≤ J'.comap (WittVector.map f⁺)` induces a ring homomorphism
`untilt p P J →+* untilt p Q J'`, for arbitrary ideals `J` and `J'`. -/
noncomputable def map (f : R →+* S) (hfplus : ∀ x ∈ P.plus, f x ∈ Q.plus)
    (hJ : J ≤ J'.comap (WittVector.map (f.restrict P.plus Q.plus hfplus))) :
    untilt p P J →+* untilt p Q J' :=
  let g : WittVector p P.plus ⧸ J →+* WittVector p Q.plus ⧸ J' :=
    Ideal.Quotient.lift J ((Ideal.Quotient.mk J').comp (WittVector.map (f.restrict _ _ hfplus)))
      fun _ ha ↦ Ideal.Quotient.eq_zero_iff_mem.mpr (hJ ha)
  IsLocalization.lift (M := (untiltDenominators p P).map (Ideal.Quotient.mk J))
    (g := (algebraMap (WittVector p Q.plus ⧸ J') (untilt p Q J')).comp g) <| by
    rintro ⟨_, _, hx, rfl⟩
    obtain ⟨a, ha, rfl⟩ := mem_untiltDenominators.mp hx
    change IsUnit (algebraMap (WittVector p Q.plus ⧸ J') (untilt p Q J')
      (Ideal.Quotient.mk J' (WittVector.map (f.restrict _ _ hfplus) (teichmuller p a))))
    rw [map_teichmuller]
    exact IsLocalization.map_units (untilt p Q J')
      ⟨Ideal.Quotient.mk J' (teichmuller p (f.restrict P.plus Q.plus hfplus a)),
        Submonoid.mem_map_of_mem _ (mem_untiltDenominators.mpr
          ⟨f.restrict P.plus Q.plus hfplus a, ha.map f, rfl⟩)⟩

/-- `untilt.map` commutes with the canonical map from `𝕎 R⁺`. -/
@[simp]
theorem map_algebraMap (f : R →+* S) (hfplus : ∀ x ∈ P.plus, f x ∈ Q.plus)
    (hJ : J ≤ J'.comap (WittVector.map (f.restrict P.plus Q.plus hfplus)))
    (w : WittVector p P.plus) :
    map f hfplus hJ (algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) (Ideal.Quotient.mk J w)) =
      algebraMap (WittVector p Q.plus ⧸ J') (untilt p Q J')
        (Ideal.Quotient.mk J' (WittVector.map (f.restrict P.plus Q.plus hfplus) w)) := by
  simp [map]

/-- `untilt.map` carries `untiltPlus` into `untiltPlus`. -/
theorem map_mem_untiltPlus (f : R →+* S) (hfplus : ∀ x ∈ P.plus, f x ∈ Q.plus)
    (hJ : J ≤ J'.comap (WittVector.map (f.restrict P.plus Q.plus hfplus)))
    {x : untilt p P J} (hx : x ∈ untiltPlus p P J) :
    map f hfplus hJ x ∈ untiltPlus p Q J' := by
  obtain ⟨a, rfl⟩ := mem_untiltPlus.mp hx
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [map_algebraMap]
  exact mem_untiltPlus.mpr ⟨_, rfl⟩

/-- `untilt.map` intertwines the sharp maps on `P.plus`. -/
@[simp]
theorem map_sharpPlus (f : R →+* S) (hfplus : ∀ x ∈ P.plus, f x ∈ Q.plus)
    (hJ : J ≤ J'.comap (WittVector.map (f.restrict P.plus Q.plus hfplus))) (a : P.plus) :
    map f hfplus hJ (sharpPlus p P J a) =
      sharpPlus p Q J' (f.restrict P.plus Q.plus hfplus a) := by
  rw [sharpPlus_apply, sharpPlus_apply, algebraMap_apply, algebraMap_apply, map_algebraMap,
    map_teichmuller]

/-- `untilt.map` is the identity on the identity ring homomorphism. -/
@[simp]
theorem map_id (hJ : J ≤ J.comap (WittVector.map ((RingHom.id R).restrict P.plus P.plus
    fun _ hx ↦ hx))) :
    map (RingHom.id R) (fun _ hx ↦ hx) hJ = RingHom.id (untilt p P J) := by
  apply IsLocalization.ringHom_ext ((untiltDenominators p P).map (Ideal.Quotient.mk J))
  ext w
  simp only [RingHom.comp_apply, RingHom.id_apply, map_algebraMap]
  have hid : (RingHom.id R).restrict P.plus P.plus (fun _ hx ↦ hx) = RingHom.id P.plus := rfl
  rw [hid, WittVector.map_id, RingHom.id_apply]

/-- `untilt.map` respects composition of ring homomorphisms. -/
theorem map_comp {T : Type*} [CommRing T] [TopologicalSpace T] [IsTopologicalRing T]
    [IsHuberRing T] {P' : Pair T} {J'' : Ideal (WittVector p P'.plus)}
    (f : R →+* S) (hfplus : ∀ x ∈ P.plus, f x ∈ Q.plus)
    (hJ : J ≤ J'.comap (WittVector.map (f.restrict P.plus Q.plus hfplus)))
    (g : S →+* T) (hgplus : ∀ x ∈ Q.plus, g x ∈ P'.plus)
    (hJ' : J' ≤ J''.comap (WittVector.map (g.restrict Q.plus P'.plus hgplus))) :
    (map g hgplus hJ').comp (map f hfplus hJ) =
      map (g.comp f) (fun _ hx ↦ hgplus _ (hfplus _ hx)) (fun w hw ↦ by
        have hcomp : WittVector.map (p := p) ((g.comp f).restrict P.plus P'.plus
            fun _ hx ↦ hgplus _ (hfplus _ hx)) =
            (WittVector.map (g.restrict Q.plus P'.plus hgplus)).comp
              (WittVector.map (f.restrict P.plus Q.plus hfplus)) := by
          ext n
          simp
        rw [Ideal.mem_comap, hcomp, RingHom.comp_apply]
        exact hJ' (hJ hw)) := by
  apply IsLocalization.ringHom_ext ((untiltDenominators p P).map (Ideal.Quotient.mk J))
  ext w
  simp only [RingHom.comp_apply, map_algebraMap]
  congr 2

end Map

section TateMap

variable {p : ℕ} [Fact p.Prime] {R S : Type*} [CommRing R] [TopologicalSpace R]
  [IsTopologicalRing R] [IsTateRing R] [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
  [IsTateRing S] {P : Pair R} {Q : Pair S} {J : Ideal (WittVector p P.plus)}
  {J' : Ideal (WittVector p Q.plus)}

/-- `untilt.map` intertwines `sharp` on `R`. -/
@[simp]
theorem map_sharp (f : R →+* S) (hfplus : ∀ x ∈ P.plus, f x ∈ Q.plus)
    (hJ : J ≤ J'.comap (WittVector.map (f.restrict P.plus Q.plus hfplus))) (x : R) :
    map f hfplus hJ (sharp p P J x) = sharp p Q J' (f x) := by
  have heq : (map f hfplus hJ).toMonoidWithZeroHom.comp (sharp p P J) =
      (sharp p Q J').comp f.toMonoidWithZeroHom :=
    monoidWithZeroHom_ext_plus (P := P) fun a ↦ by
      simp only [MonoidWithZeroHom.comp_apply, RingHom.coe_toMonoidWithZeroHom, sharp_coe]
      exact (map_sharpPlus f hfplus hJ a).trans (sharp_coe _).symm
  exact congrFun (congrArg DFunLike.coe heq) x

/-- **Continuity of `untilt.map`**: for a continuous plus-preserving ring homomorphism between
Tate rings with `J ≤ J'.comap (𝕎 f⁺)`, the induced map on untilts is continuous, for arbitrary
ideals `J` and `J'`. -/
theorem continuous_map (f : R →+* S) (hf : Continuous f) (hfplus : ∀ x ∈ P.plus, f x ∈ Q.plus)
    (hJ : J ≤ J'.comap (WittVector.map (f.restrict P.plus Q.plus hfplus))) :
    Continuous (map f hfplus hJ) := by
  refine continuous_of_continuousAt_zero (map f hfplus hJ).toAddMonoidHom ?_
  obtain ⟨ϖ, hϖ⟩ := P.isRingOfIntegralElements.exists_isPseudoUniformizer
  have hϖ' : IsPseudoUniformizer ((f.restrict P.plus Q.plus hfplus ϖ : Q.plus) : S) :=
    hϖ.map hf
  rw [ContinuousAt, map_zero,
    (hasBasis_nhds_zero (J := J) hϖ).tendsto_iff (hasBasis_nhds_zero (J := J') hϖ')]
  refine fun n _ ↦ ⟨n, trivial, fun x hx ↦ ?_⟩
  obtain ⟨a, rfl⟩ := mem_awayNhd.mp hx
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective a
  refine mem_awayNhd.mpr ⟨Ideal.Quotient.mk J' (WittVector.map (f.restrict _ _ hfplus) w), ?_⟩
  change _ = map f hfplus hJ _
  simp only [map_mul, map_pow, map_algebraMap, map_teichmuller]

end TateMap

/-! ### Quotients along a primitive element -/

section Quotient

variable {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R] [TopologicalSpace R]
  [IsTopologicalRing R] [IsTateRing R] [CharP R p] [PerfectRing R p] {P : Pair R}
  {ξ : WittVector p P.plus}

/-- `quotientEquivUntiltPlus` carries the class of `[a]` to `sharp a`. -/
@[simp]
theorem quotientEquivUntiltPlus_mk_teichmuller (hξ : ξ.IsPrimitive) (a : P.plus) :
    quotientEquivUntiltPlus hξ (Ideal.Quotient.mk (Ideal.span {ξ}) (teichmuller p a)) =
      ⟨sharp p P (Ideal.span {ξ}) a, sharp_mem_untiltPlus a⟩ :=
  Subtype.ext ((coe_quotientEquivUntiltPlus_apply hξ _).trans (sharp_apply a).symm)

/-- The inverse of `quotientSharpEquiv` sends the class of `a` to the class of `sharp a`. -/
@[simp]
theorem quotientSharpEquiv_symm_mk (hξ : ξ.IsPrimitive) {ϖ : P.plus} (hξ₀ : ϖ ∣ ξ.coeff 0)
    (a : P.plus) :
    (quotientSharpEquiv hξ hξ₀).symm (Ideal.Quotient.mk (Ideal.span {ϖ}) a) =
      Ideal.Quotient.mk _ ⟨sharp p P (Ideal.span {ξ}) a, sharp_mem_untiltPlus a⟩ := by
  rw [RingEquiv.symm_apply_eq, quotientSharpEquiv_mk_sharp]

end Quotient

/-! ### Recovery along `(p)` -/

section PRecovery

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [TopologicalSpace R]
  [IsTopologicalRing R] [IsTateRing R] [CharP R p] [PerfectRing R p] (P : Pair R)

/-- **Recovery of `R` from the untilt along `(p)`**: for a perfect Tate ring `R` of characteristic
`p`, `untilt p P (Ideal.span {p}) ≃+* R` as rings, specialising `untilt.spanPEquiv`. -/
noncomputable def pRecovery :
    untilt p P (Ideal.span {(p : WittVector p P.plus)}) ≃+* R :=
  let hϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec
  letI := P.plus.isLocalizationAway_of_isOpen P.isRingOfIntegralElements.isOpen _
    hϖ.isTopologicallyNilpotent hϖ.isUnit
  spanPEquiv hϖ R

/-- `pRecovery` sends the class of a Witt vector `w` to its zeroth coordinate. -/
@[simp]
theorem pRecovery_algebraMap (w : WittVector p P.plus) :
    pRecovery p P (algebraMap (WittVector p P.plus ⧸ Ideal.span {(p : WittVector p P.plus)})
      (untilt p P (Ideal.span {(p : WittVector p P.plus)})) (Ideal.Quotient.mk _ w)) =
      (w.coeff 0 : R) := by
  have hϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec
  have := P.plus.isLocalizationAway_of_isOpen P.isRingOfIntegralElements.isOpen _
    hϖ.isTopologicallyNilpotent hϖ.isUnit
  rw [← algebraMap_apply]
  exact spanPEquiv_algebraMap hϖ R w

/-- `pRecovery` is left-inverse to `sharp`. -/
@[simp]
theorem pRecovery_sharp (x : R) :
    pRecovery p P (sharp p P (Ideal.span {(p : WittVector p P.plus)}) x) = x := by
  have heq : ((pRecovery p P).toRingHom.toMonoidWithZeroHom.comp
      (sharp p P (Ideal.span {(p : WittVector p P.plus)}))) = MonoidWithZeroHom.id R :=
    monoidWithZeroHom_ext_plus (P := P) fun a ↦ by
      simp only [MonoidWithZeroHom.comp_apply, RingHom.coe_toMonoidWithZeroHom,
        MonoidWithZeroHom.id_apply, sharp_apply]
      change pRecovery p P _ = _
      rw [pRecovery_algebraMap, teichmuller_coeff_zero]
  exact congrFun (congrArg DFunLike.coe heq) x

/-- The inverse of `pRecovery` is `sharp` along `(p)`. -/
@[simp]
theorem pRecovery_symm_apply (x : R) :
    (pRecovery p P).symm x = sharp p P (Ideal.span {(p : WittVector p P.plus)}) x :=
  (pRecovery p P).injective (by rw [RingEquiv.apply_symm_apply, pRecovery_sharp])

/-- Under `pRecovery`, `untiltPlus` corresponds to `P.plus`. -/
theorem mem_untiltPlus_pRecovery_iff
    {x : untilt p P (Ideal.span {(p : WittVector p P.plus)})} :
    x ∈ untiltPlus p P (Ideal.span {(p : WittVector p P.plus)}) ↔ pRecovery p P x ∈ P.plus := by
  constructor
  · intro hx
    obtain ⟨a, rfl⟩ := mem_untiltPlus.mp hx
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [pRecovery_algebraMap]
    exact (w.coeff 0).property
  · intro hx
    have hsymm := (pRecovery p P).symm_apply_apply x
    rw [pRecovery_symm_apply] at hsymm
    rw [← hsymm]
    change sharp p P (Ideal.span {(p : WittVector p P.plus)})
      ((⟨pRecovery p P x, hx⟩ : P.plus) : R) ∈ _
    exact sharp_mem_untiltPlus _

/-- **`pRecovery` is a homeomorphism** whenever `R` is uniform (in particular whenever `R` is a
perfect complete Hausdorff Tate ring of characteristic `p`). -/
theorem isHomeomorph_pRecovery [IsUniform R] : IsHomeomorph (pRecovery p P) := by
  obtain ⟨ϖ, hϖ⟩ := P.isRingOfIntegralElements.exists_isPseudoUniformizer
  let D : PairOfDefinition R := PairOfDefinition.ofIsPseudoUniformizer P.plus
    P.isRingOfIntegralElements.isOpen P.isRingOfIntegralElements.isBounded hϖ ϖ.property
  have hbasis_A := hasBasis_nhds_zero (J := Ideal.span {(p : WittVector p P.plus)}) hϖ
  have hcont_symm : Continuous (pRecovery p P).symm := by
    have heq : ⇑(pRecovery p P).symm = ⇑(sharp p P (Ideal.span {(p : WittVector p P.plus)})) :=
      funext (pRecovery_symm_apply p P)
    rw [heq]
    exact continuous_sharp WittVector.isPrimitive_p
  have hcont : Continuous (pRecovery p P) := by
    refine continuous_of_continuousAt_zero (pRecovery p P).toAddMonoidHom ?_
    rw [ContinuousAt, map_zero, hbasis_A.tendsto_iff (hϖ.hasBasis_nhds_zero D)]
    refine fun n _ ↦ ⟨n, trivial, fun x hx ↦ ?_⟩
    obtain ⟨a, rfl⟩ := mem_awayNhd.mp hx
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective a
    change pRecovery p P _ ∈ _
    rw [map_mul, map_pow, map_mul, map_pow, pRecovery_algebraMap, pRecovery_algebraMap,
      teichmuller_coeff_zero]
    refine ⟨(w.coeff 0 : R), ?_, rfl⟩
    rw [PairOfDefinition.ofIsPseudoUniformizer_ringOfDefinition]
    exact (w.coeff 0).property
  exact (Homeomorph.mk (pRecovery p P).toEquiv hcont hcont_symm).isHomeomorph

end PRecovery

end TauCeti.Perfectoid.untilt
