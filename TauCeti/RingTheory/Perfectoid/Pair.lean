module

public import TauCeti.RingTheory.Perfectoid.Integral
public import TauCeti.RingTheory.Perfectoid.Plus

/-!
# Fontaine's map and integral perfectoid structure on perfectoid Huber pairs

Let `R` be a complete Hausdorff perfectoid Tate ring at a prime `p` and `R⁺ ⊆ R°` any ring of
integral elements (or `P : Huber.Pair R` a Huber pair on `R`). Combining the pseudouniformiser
root-extraction and relative-Frobenius results on `R⁺` (`TauCeti.RingTheory.Perfectoid.Plus`) with
the regular `π`-adic analysis of Fontaine's map `θ : W(R⁺♭) → R⁺`
(`TauCeti.RingTheory.Perfectoid.FontaineTheta`) and the relative-Frobenius criterion for integral
perfectoid rings (`IsIntegralPerfectoid.of_bijective_frobeniusModPow`), this file establishes:

* every ring of integral elements `R⁺` of `R` (in particular `R°` and `P.plus` for any
  `P : Huber.Pair R`) is an integral perfectoid ring (the forward implication of
  Bhatt–Morrow–Scholze, *Integral `p`-adic Hodge theory*, Lemma 3.20), hence `p`-adically complete
  and separated;
* Fontaine's map `θ : W(P.plus♭) → P.plus` is surjective (Scholze, *Étale cohomology of diamonds*,
  Lemma 3.14(i));
* `ker θ` is generated by a distinguished nonzerodivisor `ξ ∈ W(P.plus♭)`, of the explicit shape
  `p + [ϖ] α` whenever `ϖ : PreTilt P.plus p` untilts to a pseudouniformiser with
  `ϖ.untilt ^ p ∣ p` in `P.plus`, and an element `ξ' ∈ ker θ` generates `ker θ` if and only if `ξ'`
  is distinguished (Scholze, *Étale cohomology of diamonds*, Lemma 3.14(ii);
  Bhatt–Morrow–Scholze, *Integral `p`-adic Hodge theory*, Lemma 3.10 and Remark 3.11).

None of these results assumes a base perfectoid field, a domain hypothesis, or a restriction on the
characteristic of `R`.

## Main results

* `TauCeti.Huber.IsRingOfIntegralElements.isIntegralPerfectoid`: every ring of integral elements of
  a perfectoid Tate ring is an integral perfectoid ring.
* `TauCeti.Perfectoid.isIntegralPerfectoid_powerBoundedSubring`,
  `TauCeti.Perfectoid.isIntegralPerfectoid_plus`: `IsIntegralPerfectoid` instances on `R°` and on
  `P.plus` for any `P : Huber.Pair R` (automatically providing `p`-adic completeness via
  `IsIntegralPerfectoid.isAdicComplete_span_natCast`).
* `TauCeti.Perfectoid.frobenius_surjective_plus`: the `p`-th power map on `ModP P.plus p` is
  surjective, including when `R` is the zero ring.
* `TauCeti.Perfectoid.surjective_fontaineTheta_of_isPerfectoidTateRing`: Fontaine's map
  `θ : W(P.plus♭) → P.plus` is surjective.
* `TauCeti.Huber.IsRingOfIntegralElements.exists_ker_fontaineTheta_eq_span_p_add_teichmuller_mul`,
  `TauCeti.Perfectoid.exists_regular_generator_ker_fontaineTheta`: `ker θ` has a distinguished
  nonzerodivisor generator in `W(P.plus♭)`.
* `TauCeti.Perfectoid.ker_fontaineTheta_eq_span_iff_isDistinguished`,
  `TauCeti.Perfectoid.ker_fontaineTheta`: generators of `ker θ` are characterised among elements of
  `ker θ` by `WittVector.IsDistinguished`.

## References

* P. Scholze, *Étale cohomology of diamonds*, Lemma 3.14.
* B. Bhatt, M. Morrow, P. Scholze, *Integral `p`-adic Hodge theory*, Lemma 3.10, Remark 3.11, and
  Lemma 3.20.
-/

public section

open Ideal TauCeti.Huber TauCeti.Perfectoid
open scoped nonZeroDivisors

namespace TauCeti.Huber.IsRingOfIntegralElements

variable {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] {Rplus : Subring R}

/-- Package `(π)`-adic completeness, regularity in `Rplus`, and bijectivity of relative Frobenius
for any pseudouniformiser `π ∈ Rplus` with `π ^ p ∣ p`. -/
private theorem adic_frobenius_of_isPseudoUniformizer (hplus : IsRingOfIntegralElements Rplus)
    {π : Rplus} (hπ : IsPseudoUniformizer (π : R)) (hdvd : π ^ p ∣ (p : Rplus)) :
    IsAdicComplete (span {π}) Rplus ∧ π ∈ Rplus⁰ ∧ Function.Bijective (frobeniusModPow p hdvd) := by
  have := IsPerfectoidTateRing.isUniform p (R := R)
  exact ⟨hplus.isAdicComplete_span_singleton π hπ,
    mem_nonZeroDivisors_of_injective Rplus.subtype_injective hπ.isUnit.mem_nonZeroDivisors,
    hplus.bijective_frobeniusModPow hπ hdvd⟩

/-- Produce a pseudouniformiser `π ∈ Rplus` with `π ^ p ∣ p` together with `(π)`-adic completeness,
regularity in `Rplus`, and bijectivity of relative Frobenius. -/
private theorem exists_adic_frobenius (hplus : IsRingOfIntegralElements Rplus) :
    ∃ (π : Rplus) (hdvd : π ^ p ∣ (p : Rplus)),
      IsAdicComplete (span {π}) Rplus ∧ π ∈ Rplus⁰ ∧
        Function.Bijective (frobeniusModPow p hdvd) := by
  have := IsPerfectoidTateRing.isUniform p (R := R)
  obtain ⟨π, hπ, c, hc, -⟩ := hplus.exists_pseudoUniformizer_natCast_eq_pow_mul (p := p)
  exact ⟨π, ⟨c, hc⟩, hplus.adic_frobenius_of_isPseudoUniformizer hπ ⟨c, hc⟩⟩

/-- **Every ring of integral elements of a perfectoid Tate ring is integral perfectoid**
(forward direction of Bhatt–Morrow–Scholze, *Integral `p`-adic Hodge theory*, Lemma 3.20). This
holds unconditionally, including for products with zero divisors and for the zero ring. -/
theorem isIntegralPerfectoid (hplus : IsRingOfIntegralElements Rplus) :
    IsIntegralPerfectoid p Rplus := by
  obtain ⟨π, hdvd, hc, hreg, hbij⟩ := hplus.exists_adic_frobenius (p := p)
  exact .of_bijective_frobeniusModPow hreg hbij

section FontaineTheta

variable [Fact ¬IsUnit (p : Rplus)] [IsAdicComplete (span {(p : Rplus)}) Rplus]

/-- If `ϖ : PreTilt Rplus p` untilts to a pseudouniformiser of `R` with `ϖ.untilt ^ p ∣ p` in
`Rplus`, then `ker θ` is generated by a distinguished nonzerodivisor of the form `p + [ϖ] α`
(Scholze, *Étale cohomology of diamonds*, Lemma 3.14(ii)). -/
theorem exists_ker_fontaineTheta_eq_span_p_add_teichmuller_mul
    (hplus : IsRingOfIntegralElements Rplus) {ϖ : PreTilt Rplus p}
    (hϖ : IsPseudoUniformizer (ϖ.untilt : R)) (hdvd : ϖ.untilt ^ p ∣ (p : Rplus)) :
    ∃ α : WittVector p (PreTilt Rplus p),
      ((p : WittVector p (PreTilt Rplus p)) + WittVector.teichmuller p ϖ * α).IsDistinguished ∧
        (p : WittVector p (PreTilt Rplus p)) + WittVector.teichmuller p ϖ * α ∈
          (WittVector p (PreTilt Rplus p))⁰ ∧
        RingHom.ker (WittVector.fontaineTheta Rplus p) =
          span {(p : WittVector p (PreTilt Rplus p)) + WittVector.teichmuller p ϖ * α} := by
  obtain ⟨hc, hreg, hbij⟩ := hplus.adic_frobenius_of_isPseudoUniformizer hϖ hdvd
  exact WittVector.exists_ker_fontaineTheta_eq_span_p_add_teichmuller_mul hreg hbij

/-- For any ring of integral elements `R⁺` of a perfectoid Tate ring, `ker θ` is generated by a
distinguished nonzerodivisor of `W(PreTilt Rplus p)`. -/
theorem exists_isDistinguished_mem_nonZeroDivisors_ker_fontaineTheta
    (hplus : IsRingOfIntegralElements Rplus) :
    ∃ ξ : WittVector p (PreTilt Rplus p),
      ξ.IsDistinguished ∧ ξ ∈ (WittVector p (PreTilt Rplus p))⁰ ∧
        RingHom.ker (WittVector.fontaineTheta Rplus p) = span {ξ} := by
  obtain ⟨π, hdvd, hc, hreg, hbij⟩ := hplus.exists_adic_frobenius (p := p)
  exact WittVector.exists_isDistinguished_mem_nonZeroDivisors_ker_fontaineTheta hreg hbij

/-- An element `ξ ∈ ker θ` generates `ker θ` on a ring of integral elements `R⁺` of a perfectoid
Tate ring if and only if `ξ` is distinguished. -/
theorem ker_fontaineTheta_eq_span_iff_isDistinguished (hplus : IsRingOfIntegralElements Rplus)
    {ξ : WittVector p (PreTilt Rplus p)} (hξ : ξ ∈ RingHom.ker (WittVector.fontaineTheta Rplus p)) :
    RingHom.ker (WittVector.fontaineTheta Rplus p) = span {ξ} ↔ ξ.IsDistinguished := by
  obtain ⟨π, hdvd, hc, hreg, hbij⟩ := hplus.exists_adic_frobenius (p := p)
  exact WittVector.ker_fontaineTheta_eq_span_iff_isDistinguished hreg hbij hξ

end FontaineTheta

end TauCeti.Huber.IsRingOfIntegralElements

namespace TauCeti.Perfectoid

variable {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R]

/-- The power-bounded subring `R°` of a perfectoid Tate ring is an integral perfectoid ring. -/
instance isIntegralPerfectoid_powerBoundedSubring :
    IsIntegralPerfectoid p (powerBoundedSubring R) :=
  (isRingOfIntegralElements_powerBoundedSubring R).isIntegralPerfectoid

/-- The ring of integral elements `P.plus` of any Huber pair on a perfectoid Tate ring is an
integral perfectoid ring. In particular, `IsIntegralPerfectoid.isAdicComplete_span_natCast`
automatically provides `IsAdicComplete (span {(p : P.plus)}) P.plus`. -/
instance isIntegralPerfectoid_plus (P : Huber.Pair R) : IsIntegralPerfectoid p P.plus :=
  P.isRingOfIntegralElements.isIntegralPerfectoid

/-- The `p`-th power map on `ModP P.plus p` is surjective for every Huber pair `P` on a perfectoid
Tate ring, including when `R` is the zero ring. -/
theorem frobenius_surjective_plus (P : Huber.Pair R) :
    Function.Surjective fun x : ModP P.plus p ↦ x ^ p :=
  (P.isRingOfIntegralElements.isIntegralPerfectoid (p := p)).frobenius_surjective

/-- **Fontaine's `θ` is surjective on `P.plus`** (Scholze, *Étale cohomology of diamonds*,
Lemma 3.14(i)). `p`-adic completeness of `P.plus` is synthesized automatically from
`isIntegralPerfectoid_plus`. -/
theorem surjective_fontaineTheta_of_isPerfectoidTateRing (P : Huber.Pair R)
    [Fact ¬IsUnit (p : P.plus)] :
    Function.Surjective (WittVector.fontaineTheta P.plus p) :=
  IsIntegralPerfectoid.surjective_fontaineTheta

/-- **Regular distinguished generator of `ker θ` on `P.plus`** (Scholze, *Étale cohomology of
diamonds*, Lemma 3.14(ii); Bhatt–Morrow–Scholze, Lemma 3.10). For any Huber pair `P` on a
perfectoid Tate ring, `ker (WittVector.fontaineTheta P.plus p)` is generated by a distinguished
nonzerodivisor of `W(PreTilt P.plus p)`. -/
theorem exists_regular_generator_ker_fontaineTheta (P : Huber.Pair R)
    [Fact ¬IsUnit (p : P.plus)] :
    ∃ ξ : WittVector p (PreTilt P.plus p),
      ξ.IsDistinguished ∧ ξ ∈ (WittVector p (PreTilt P.plus p))⁰ ∧
        RingHom.ker (WittVector.fontaineTheta P.plus p) = span {ξ} :=
  P.isRingOfIntegralElements.exists_isDistinguished_mem_nonZeroDivisors_ker_fontaineTheta

/-- **Characterisation of generators of `ker θ` on `P.plus`** (Scholze, *Étale cohomology of
diamonds*, Lemma 3.14(ii); Bhatt–Morrow–Scholze, Remark 3.11). An element `ξ ∈ ker θ` generates
`ker (WittVector.fontaineTheta P.plus p)` if and only if `ξ` is distinguished. -/
theorem ker_fontaineTheta_eq_span_iff_isDistinguished (P : Huber.Pair R)
    [Fact ¬IsUnit (p : P.plus)] {ξ : WittVector p (PreTilt P.plus p)}
    (hξ : ξ ∈ RingHom.ker (WittVector.fontaineTheta P.plus p)) :
    RingHom.ker (WittVector.fontaineTheta P.plus p) = span {ξ} ↔ ξ.IsDistinguished :=
  P.isRingOfIntegralElements.ker_fontaineTheta_eq_span_iff_isDistinguished hξ

/-- **Principal distinguished kernel of Fontaine's `θ` on `P.plus`** (Scholze, *Étale cohomology of
diamonds*, Lemma 3.14(ii)). The kernel of `θ : W(PreTilt P.plus p) → P.plus` is principal,
generated by a distinguished Witt vector, and an element of `ker θ` generates `ker θ` if and only
if it is distinguished. -/
theorem ker_fontaineTheta (P : Huber.Pair R) [Fact ¬IsUnit (p : P.plus)] :
    (∃ ξ : WittVector p (PreTilt P.plus p),
        ξ.IsDistinguished ∧ RingHom.ker (WittVector.fontaineTheta P.plus p) = span {ξ}) ∧
      ∀ ξ ∈ RingHom.ker (WittVector.fontaineTheta P.plus p),
        RingHom.ker (WittVector.fontaineTheta P.plus p) = span {ξ} ↔ ξ.IsDistinguished := by
  obtain ⟨ξ, hξ, -, hker⟩ := exists_regular_generator_ker_fontaineTheta (p := p) P
  exact ⟨⟨ξ, hξ, hker⟩, fun _ h ↦ ker_fontaineTheta_eq_span_iff_isDistinguished P h⟩

end TauCeti.Perfectoid
