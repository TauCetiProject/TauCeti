module

public import TauCeti.RingTheory.Perfectoid.Integral.Tilt
public import TauCeti.RingTheory.WittVector.Frobenius

/-!
# The Frobenius-shifted Fontaine map

Let `A` be a `p`-adically complete ring in which `p` is not a unit, with tilt `A♭ = PreTilt A p`.
Since `A♭` is a perfect ring of characteristic `p`, the Witt vector Frobenius `φ` of `W(A♭)` is an
automorphism. The *Frobenius-shifted Fontaine map* is

  `θ' = θ ∘ φ⁻¹ : W(A♭) → A`

(usually written `θ` with a tilde), where `θ` is Mathlib's Fontaine map
(`WittVector.fontaineTheta`). It sends a Teichmüller representative `[a]` to `(a ^ (1 / p))♯`
rather than to `a♯`, and its kernel is `φ(ker θ)`. When
`A` is integral perfectoid, `θ'` is surjective, its kernel is principal, and an element of `ker θ'`
generates it exactly when it is distinguished; if `ξ` generates `ker θ`, then `φ(ξ)` generates
`ker θ'`.

For `A = O_C` and the cyclotomic period elements `μ = [ε] - 1` and `ξ' = φ(ξ)`, the two maps
differ on `μ`: `θ(μ) = 0`, while `θ'(μ) = ζ_p - 1` with `ζ_p = (ε ^ (1 / p))♯`; and `θ'(ξ') = 0`,
while `θ(ξ') = p`; accordingly `ker θ'` is generated by `ξ'` rather than `ξ`
(`TauCeti.WittVector.ker_fontaineThetaTilde_eq_span_cyclotomicXiTilde`). Base change of
`A_inf`-cohomology along `θ` gives de Rham cohomology, and along `θ'` the Hodge–Tate complex.

## Main definitions

* `TauCeti.WittVector.fontaineThetaTilde A p`: the ring map `θ' = θ ∘ φ⁻¹ : W(A♭) → A`.

## Main results

* `TauCeti.WittVector.fontaineThetaTilde_frobenius`: `θ' (φ x) = θ x`.
* `TauCeti.WittVector.fontaineThetaTilde_teichmuller`: `θ' [a] = (a ^ (1 / p))♯`.
* `TauCeti.WittVector.surjective_fontaineThetaTilde_iff`: `θ'` is surjective exactly when `θ` is.
* `TauCeti.WittVector.ker_fontaineThetaTilde`: `ker θ' = φ(ker θ)`, and
  `TauCeti.WittVector.ker_fontaineThetaTilde_eq_span_frobenius`: if `ker θ = (ξ)`, then
  `ker θ' = (φ(ξ))`.
* `TauCeti.Perfectoid.IsIntegralPerfectoid.surjective_fontaineThetaTilde`,
  `TauCeti.Perfectoid.IsIntegralPerfectoid.isPrincipal_ker_fontaineThetaTilde`,
  `TauCeti.Perfectoid.IsIntegralPerfectoid.ker_fontaineThetaTilde_eq_span_iff_isDistinguished`:
  for an integral perfectoid ring, `θ'` is surjective, `ker θ'` is principal, and its generators are
  its distinguished elements.

## References

* B. Bhatt, M. Morrow, P. Scholze, *Integral `p`-adic Hodge theory*, §3.1, Lemmas 3.2–3.4 and
  the discussion following Lemma 3.2.
-/

public section

open Ideal _root_.WittVector

namespace TauCeti.WittVector

variable (A : Type*) [CommRing A] (p : ℕ) [Fact p.Prime] [Fact ¬IsUnit (p : A)]
  [IsAdicComplete (span {(p : A)}) A]

local notation "A♭" => PreTilt A p

local notation "𝕎" => _root_.WittVector p

/-- The *Frobenius-shifted Fontaine map* `θ' = θ ∘ φ⁻¹ : W(A♭) → A`, the composite of the inverse
of the Witt vector Frobenius of the perfect ring `A♭` with Fontaine's map
`θ = WittVector.fontaineTheta A p` (Bhatt–Morrow–Scholze, §3.1). It sends `[a]` to
`(a ^ (1 / p))♯` (`fontaineThetaTilde_teichmuller`), and its kernel is `φ(ker θ)`
(`ker_fontaineThetaTilde`). -/
noncomputable def fontaineThetaTilde : 𝕎 A♭ →+* A :=
  (fontaineTheta A p).comp (frobeniusEquiv p A♭).symm.toRingHom

variable {A p}

/-- The defining formula `θ' x = θ (φ⁻¹ x)`. -/
theorem fontaineThetaTilde_apply (x : 𝕎 A♭) :
    fontaineThetaTilde A p x = fontaineTheta A p ((frobeniusEquiv p A♭).symm x) :=
  (rfl)

/-- `θ' (φ x) = θ x`. -/
@[simp]
theorem fontaineThetaTilde_frobenius (x : 𝕎 A♭) :
    fontaineThetaTilde A p (frobenius x) = fontaineTheta A p x := by
  rw [fontaineThetaTilde_apply, ← _root_.WittVector.frobeniusEquiv_apply,
    RingEquiv.symm_apply_apply]

/-- `θ' ∘ φ = θ`. -/
theorem fontaineThetaTilde_comp_frobenius :
    (fontaineThetaTilde A p).comp (frobenius : 𝕎 A♭ →+* 𝕎 A♭) = fontaineTheta A p :=
  RingHom.ext fun x ↦ by rw [RingHom.comp_apply, fontaineThetaTilde_frobenius]

/-- `θ' [a] = (a ^ (1 / p))♯`, whereas `θ [a] = a♯` (`WittVector.fontaineTheta_teichmuller`). -/
@[simp]
theorem fontaineThetaTilde_teichmuller (a : A♭) :
    fontaineThetaTilde A p (teichmuller p a) = ((_root_.frobeniusEquiv A♭ p).symm a).untilt := by
  rw [fontaineThetaTilde_apply, frobeniusEquiv_symm_teichmuller, fontaineTheta_teichmuller]

/-- `θ'` is surjective exactly when Fontaine's map `θ` is. -/
theorem surjective_fontaineThetaTilde_iff :
    Function.Surjective (fontaineThetaTilde A p) ↔ Function.Surjective (fontaineTheta A p) :=
  EquivLike.surjective_comp (frobeniusEquiv p A♭).symm (fontaineTheta A p)

/-- `φ x` lies in `ker θ'` exactly when `x` lies in `ker θ`. -/
theorem frobenius_mem_ker_fontaineThetaTilde_iff {x : 𝕎 A♭} :
    frobenius x ∈ RingHom.ker (fontaineThetaTilde A p) ↔ x ∈ RingHom.ker (fontaineTheta A p) := by
  rw [RingHom.mem_ker, RingHom.mem_ker, fontaineThetaTilde_frobenius]

/-- **The kernel of `θ'` is `φ(ker θ)`.** -/
theorem ker_fontaineThetaTilde :
    RingHom.ker (fontaineThetaTilde A p) =
      (RingHom.ker (fontaineTheta A p)).map (frobenius : 𝕎 A♭ →+* 𝕎 A♭) := by
  rw [← fontaineThetaTilde_comp_frobenius, ← RingHom.comap_ker,
    map_comap_of_surjective _ (frobenius_bijective p A♭).2]

/-- If `ξ` generates the kernel of `θ`, then `φ(ξ)` generates the kernel of `θ'`. -/
theorem ker_fontaineThetaTilde_eq_span_frobenius {ξ : 𝕎 A♭}
    (h : RingHom.ker (fontaineTheta A p) = span {ξ}) :
    RingHom.ker (fontaineThetaTilde A p) = span {frobenius ξ} := by
  rw [ker_fontaineThetaTilde, h, map_span, Set.image_singleton]

/-- `ker θ' = (φ(ξ))` exactly when `ker θ = (ξ)`. -/
theorem ker_fontaineThetaTilde_eq_span_frobenius_iff {ξ : 𝕎 A♭} :
    RingHom.ker (fontaineThetaTilde A p) = span {frobenius ξ} ↔
      RingHom.ker (fontaineTheta A p) = span {ξ} := by
  refine ⟨fun h ↦ ?_, ker_fontaineThetaTilde_eq_span_frobenius⟩
  have hb := frobenius_bijective p A♭
  rw [ker_fontaineThetaTilde, ← Set.image_singleton, ← map_span] at h
  rw [← comap_map_of_bijective _ hb (I := RingHom.ker (fontaineTheta A p)), h,
    comap_map_of_bijective _ hb]

end TauCeti.WittVector

namespace TauCeti.Perfectoid.IsIntegralPerfectoid

open TauCeti.WittVector

variable {p : ℕ} [Fact p.Prime] {A : Type*} [CommRing A] [IsIntegralPerfectoid p A]
  [Fact ¬IsUnit (p : A)]

/-- The Frobenius-shifted Fontaine map `θ' : W(A♭) → A` of an integral perfectoid ring is
surjective. -/
theorem surjective_fontaineThetaTilde : Function.Surjective (fontaineThetaTilde A p) :=
  surjective_fontaineThetaTilde_iff.mpr surjective_fontaineTheta

/-- **Generators of `ker θ'` are the distinguished elements of `ker θ'`.** For an integral
perfectoid ring, an element of the kernel of `θ' = θ ∘ φ⁻¹` generates it if and only if its first
Witt coordinate is a unit; this is the Frobenius twist of
`ker_fontaineTheta_eq_span_iff_isDistinguished`. -/
theorem ker_fontaineThetaTilde_eq_span_iff_isDistinguished {ξ : WittVector p (PreTilt A p)}
    (hξ : ξ ∈ RingHom.ker (fontaineThetaTilde A p)) :
    RingHom.ker (fontaineThetaTilde A p) = span {ξ} ↔ ξ.IsDistinguished := by
  obtain ⟨η, rfl⟩ := (frobenius_bijective p (PreTilt A p)).2 ξ
  rw [frobenius_mem_ker_fontaineThetaTilde_iff] at hξ
  rw [ker_fontaineThetaTilde_eq_span_frobenius_iff, isDistinguished_frobenius_iff,
    ker_fontaineTheta_eq_span_iff_isDistinguished hξ]

/-- `ker θ'` has a distinguished generator, namely `φ(ξ)` for a distinguished generator `ξ` of
`ker θ`. -/
theorem exists_isDistinguished_ker_fontaineThetaTilde_eq_span :
    ∃ g : WittVector p (PreTilt A p),
      g.IsDistinguished ∧ RingHom.ker (fontaineThetaTilde A p) = span {g} := by
  obtain ⟨g, hg, hker⟩ := exists_isDistinguished_ker_fontaineTheta_eq_span (p := p) (A := A)
  exact ⟨frobenius g, isDistinguished_frobenius_iff.mpr hg,
    ker_fontaineThetaTilde_eq_span_frobenius hker⟩

/-- The kernel of the Frobenius-shifted Fontaine map of an integral perfectoid ring is principal. -/
theorem isPrincipal_ker_fontaineThetaTilde : (RingHom.ker (fontaineThetaTilde A p)).IsPrincipal :=
  have ⟨g, _, hg⟩ := exists_isDistinguished_ker_fontaineThetaTilde_eq_span (p := p) (A := A)
  ⟨⟨g, hg⟩⟩

end TauCeti.Perfectoid.IsIntegralPerfectoid
