module

public import Mathlib.RingTheory.Localization.Algebra
public import Mathlib.Topology.Algebra.Algebra.Equiv
public import TauCeti.RingTheory.Huber.LocalizationTopology.Away
public import TauCeti.RingTheory.WittVector.Primitive.Quotient

/-!
# The untilt along an ideal of the Witt vectors

Let `S` be a commutative ring, `ϖ ∈ S` and `J` an ideal of the Witt vectors `𝕎 S`. The *untilt*
of `S` along `J` with respect to `ϖ` is the ring

`A = (𝕎 S ⧸ J)[1/π]`, where `π` is the class of the Teichmüller representative `[ϖ]`,

with its `π`-adic topology: the image `A⁺` of `A₀ = 𝕎 S ⧸ J` is open, and the images `πⁿ A₀`
of the powers of `(π)` are a basis of neighbourhoods of zero. It is a Tate ring with
pseudouniformiser `π`, and it is the quotient `𝕎 S [1/[ϖ]] ⧸ J` of the ring of Witt vectors with
`[ϖ]` inverted, through the map `θ_J` induced by `𝕎 S → 𝕎 S ⧸ J`. The multiplicative map
`x ↦ x♯ = θ_J([x])` sends `ϖ` to `π`. The construction only depends on the radical of `(ϖ)`.

The case of interest is that of a perfectoid Tate pair `(R, R⁺)` of characteristic `p`, with
`S = R⁺`, `ϖ` a pseudouniformiser and `J` a primitive ideal: then `A` is the untilt of `(R, R⁺)`
along `J`, which is a perfectoid Tate ring with tilt `R` by Scholze's *Étale cohomology of
diamonds*, Theorem 3.17; that theorem is not proved here. For `J = (p)` one recovers
`S[1/ϖ] = R` itself. This file proves the properties of the construction that need no perfectoid
hypothesis: if
`S` is perfect of characteristic `p`, `ϖ` is a nonzerodivisor for which `S` is `ϖ`-adically
complete, and `J = (ξ)` for a distinguished `ξ` whose zeroth Witt coordinate lies in the radical of
`(ϖ)` (for instance a primitive `ξ`), then `A₀` embeds into `A` as the subring `A⁺`, the untilt is
complete and Hausdorff, and, if `ϖ` divides the zeroth coordinate of `ξ`, `A⁺ ⧸ (ϖ♯) ≃ S ⧸ (ϖ)`.

## Main definitions

* `TauCeti.Perfectoid.untilt p ϖ J`: the untilt `(𝕎 S ⧸ J)[1/[ϖ]]`, with its `π`-adic topology.
* `TauCeti.Perfectoid.untiltPlus p ϖ J`: the open bounded subring `A⁺`, the image of `𝕎 S ⧸ J`.
* `TauCeti.Perfectoid.untilt.sharp`: the multiplicative map `S → A`, `x ↦ θ_J([x])`.
* `TauCeti.Perfectoid.untilt.theta`: the surjection `θ_J : 𝕎 S [1/[ϖ]] → A`, with kernel
  generated by `J` (`TauCeti.Perfectoid.untilt.ker_theta`), and the resulting isomorphism
  `TauCeti.Perfectoid.untilt.quotientMapEquiv : 𝕎 S [1/[ϖ]] ⧸ J ≃+* A`.
* `TauCeti.Perfectoid.untilt.congr`: the isomorphism of untilts for two elements `ϖ`, `ϖ'` with
  the same radical, as topological algebras over `𝕎 S ⧸ J`.
* `TauCeti.Perfectoid.untilt.spanPEquiv`: for perfect `S` of characteristic `p`, the untilt along
  `(p)` is `S[1/ϖ]`.
* `TauCeti.Perfectoid.untilt.quotEquiv`: `A⁺ ⧸ (ϖ♯) ≃+* S ⧸ (ϖ)` for `J = (ξ)` distinguished.

## Main results

* `TauCeti.Perfectoid.untilt.hasBasis_nhds_zero`: the neighbourhoods `πⁿ A₀` of zero.
* `TauCeti.Perfectoid.untilt.instIsTateRing`, `TauCeti.Perfectoid.untilt.isPseudoUniformizer_sharp`:
  the untilt is a Tate ring with pseudouniformiser `ϖ♯`.
* `TauCeti.Perfectoid.isOpen_untiltPlus`, `TauCeti.Perfectoid.isBounded_untiltPlus`: `A⁺` is
  open and bounded.
* `TauCeti.Perfectoid.untilt.algebraMap_injective`: `𝕎 S ⧸ (ξ) → A` is injective, so
  `𝕎 S ⧸ (ξ) ≃+* A⁺` (`TauCeti.Perfectoid.untilt.quotientEquivUntiltPlus`).
* `TauCeti.Perfectoid.untilt.t2Space`, `TauCeti.Perfectoid.untilt.completeSpace`: the untilt
  along a distinguished element is Hausdorff and complete.

## References

* P. Scholze, *Étale cohomology of diamonds*, Lemma 3.14 and Theorem 3.17 and its proof.
* P. Scholze, J. Weinstein, *Berkeley lectures on `p`-adic geometry*, Theorem 6.2.11.
* K. S. Kedlaya, *Sheaves, stacks, and shtukas*, Remark 2.3.3 and Theorem 2.3.9.
-/

public section

open Filter Topology TauCeti.Huber
open WittVector (teichmuller)
open scoped nonZeroDivisors

namespace TauCeti.Perfectoid

variable (p : ℕ) [Fact p.Prime] {S : Type*} [CommRing S]

local notation "𝕎" => WittVector p

variable (ϖ : S) (J : Ideal (WittVector p S))

/-- The *untilt* of `S` along an ideal `J` of `𝕎 S` with respect to `ϖ ∈ S`: the localization
`(𝕎 S ⧸ J)[1/π]` of `𝕎 S ⧸ J` away from the class `π` of the Teichmüller representative `[ϖ]`. It
carries the `π`-adic topology `TauCeti.Perfectoid.untilt.instTopologicalSpace`. For a perfectoid
Tate pair `(R, R⁺)` of characteristic `p`, `S = R⁺`, a pseudouniformiser `ϖ` and a primitive ideal
`J`, this is the untilt of `(R, R⁺)` along `J`. -/
@[expose] def untilt : Type _ :=
  Localization.Away (Ideal.Quotient.mk J (teichmuller p ϖ))

namespace untilt

noncomputable instance instCommRing : CommRing (untilt p ϖ J) :=
  inferInstanceAs (CommRing (Localization.Away (Ideal.Quotient.mk J (teichmuller p ϖ))))

noncomputable instance instAlgebraQuotient : Algebra (𝕎 S ⧸ J) (untilt p ϖ J) :=
  inferInstanceAs (Algebra (𝕎 S ⧸ J) (Localization.Away (Ideal.Quotient.mk J (teichmuller p ϖ))))

noncomputable instance instAlgebra : Algebra (𝕎 S) (untilt p ϖ J) :=
  inferInstanceAs (Algebra (𝕎 S) (Localization.Away (Ideal.Quotient.mk J (teichmuller p ϖ))))

instance instIsScalarTower : IsScalarTower (𝕎 S) (𝕎 S ⧸ J) (untilt p ϖ J) :=
  inferInstanceAs
    (IsScalarTower (𝕎 S) (𝕎 S ⧸ J) (Localization.Away (Ideal.Quotient.mk J (teichmuller p ϖ))))

/-- The untilt is a localization of `𝕎 S ⧸ J` away from the class of `[ϖ]`. -/
instance isLocalization :
    IsLocalization.Away (Ideal.Quotient.mk J (teichmuller p ϖ)) (untilt p ϖ J) :=
  inferInstanceAs (IsLocalization.Away (Ideal.Quotient.mk J (teichmuller p ϖ))
    (Localization.Away (Ideal.Quotient.mk J (teichmuller p ϖ))))

/-- The image of a Witt vector in the untilt is the image of its class modulo `J`. -/
theorem algebraMap_apply (a : 𝕎 S) :
    algebraMap (𝕎 S) (untilt p ϖ J) a =
      algebraMap (𝕎 S ⧸ J) (untilt p ϖ J) (Ideal.Quotient.mk J a) :=
  IsScalarTower.algebraMap_apply _ _ _ a

/-- Every element of `J` vanishes in the untilt. -/
theorem algebraMap_eq_zero_of_mem {a : 𝕎 S} (ha : a ∈ J) :
    algebraMap (𝕎 S) (untilt p ϖ J) a = 0 := by
  rw [algebraMap_apply, Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]

/-! ### The topology -/

/-- The `π`-adic topology on the untilt: the neighbourhoods of zero have basis `πⁿ A₀`
(`TauCeti.Perfectoid.untilt.hasBasis_nhds_zero`), where `A₀ = 𝕎 S ⧸ J` and `π` is the class of
`[ϖ]`. -/
noncomputable instance instTopologicalSpace : TopologicalSpace (untilt p ϖ J) :=
  awayTopology (Ideal.Quotient.mk J (teichmuller p ϖ)) (untilt p ϖ J)

/-- The neighbourhoods of zero of the untilt have basis the images `πⁿ A₀` of the ideals `(πⁿ)`
of `A₀ = 𝕎 S ⧸ J`, where `π` is the class of `[ϖ]`. -/
theorem hasBasis_nhds_zero :
    (𝓝 (0 : untilt p ϖ J)).HasBasis (fun _ : ℕ ↦ True)
      fun n ↦ (awayNhd (Ideal.Quotient.mk J (teichmuller p ϖ)) (untilt p ϖ J) n :
        Set (untilt p ϖ J)) :=
  hasBasis_nhds_zero_awayTopology

instance instIsTopologicalRing : IsTopologicalRing (untilt p ϖ J) :=
  isTopologicalRing_awayTopology

instance instNonarchimedeanRing : NonarchimedeanRing (untilt p ϖ J) :=
  nonarchimedeanRing_awayTopology

/-- The uniform structure of the untilt: that of its additive topological group. -/
noncomputable instance instUniformSpace : UniformSpace (untilt p ϖ J) :=
  IsTopologicalAddGroup.rightUniformSpace (untilt p ϖ J)

instance instIsUniformAddGroup : IsUniformAddGroup (untilt p ϖ J) :=
  isUniformAddGroup_of_addCommGroup

/-- **The untilt is a Tate ring**, with pair of definition `(A⁺, π A⁺)`. -/
instance instIsTateRing : IsTateRing (untilt p ϖ J) :=
  isTateRing_of_hasBasis (hasBasis_nhds_zero p ϖ J)

end untilt

/-- The subring `A⁺` of the untilt: the image of `𝕎 S ⧸ J` in `(𝕎 S ⧸ J)[1/[ϖ]]`. It is open and
bounded, and for a primitive ideal `J` of `𝕎 R⁺` it is the plus ring of the untilt of `(R, R⁺)`
along `J`. -/
noncomputable def untiltPlus : Subring (untilt p ϖ J) :=
  (algebraMap (𝕎 S ⧸ J) (untilt p ϖ J)).range

variable {p ϖ J} in
/-- An element of the untilt lies in `A⁺` exactly when it is the image of a Witt vector. -/
theorem mem_untiltPlus {x : untilt p ϖ J} :
    x ∈ untiltPlus p ϖ J ↔ ∃ a : 𝕎 S, algebraMap (𝕎 S) (untilt p ϖ J) a = x := by
  refine ⟨fun ⟨a, ha⟩ ↦ ?_, fun ⟨a, ha⟩ ↦ ⟨Ideal.Quotient.mk J a, ?_⟩⟩
  · obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    exact ⟨a, by rw [untilt.algebraMap_apply, ha]⟩
  · rw [← ha, untilt.algebraMap_apply]

/-- The image of every Witt vector lies in `A⁺`. -/
theorem algebraMap_mem_untiltPlus (a : 𝕎 S) :
    algebraMap (𝕎 S) (untilt p ϖ J) a ∈ untiltPlus p ϖ J :=
  mem_untiltPlus.mpr ⟨a, rfl⟩

/-- `A⁺` is open in the untilt. -/
theorem isOpen_untiltPlus : IsOpen (untiltPlus p ϖ J : Set (untilt p ϖ J)) :=
  isOpen_range_algebraMap_of_hasBasis (untilt.hasBasis_nhds_zero p ϖ J)

/-- `A⁺` is bounded in the untilt. -/
theorem isBounded_untiltPlus : IsBounded (untiltPlus p ϖ J : Set (untilt p ϖ J)) :=
  isBounded_range_algebraMap_of_hasBasis (untilt.hasBasis_nhds_zero p ϖ J)

/-- Every element of `A⁺` is power-bounded. -/
theorem untiltPlus_le_powerBoundedSubring :
    untiltPlus p ϖ J ≤ powerBoundedSubring (untilt p ϖ J) := fun _ hx ↦
  mem_powerBoundedSubring.mpr ((isBounded_untiltPlus p ϖ J).isPowerBounded_of_mem hx)

namespace untilt

/-! ### The sharp map -/

/-- The *sharp map* `S → A`, `x ↦ x♯ = θ_J([x])`: the image of the Teichmüller representative.
It is multiplicative but not additive. -/
noncomputable def sharp : S →* untilt p ϖ J :=
  (algebraMap (𝕎 S) (untilt p ϖ J) : 𝕎 S →* untilt p ϖ J).comp (teichmuller p)

/-- `x♯` is the image of the Teichmüller representative `[x]`. -/
theorem sharp_apply (x : S) :
    sharp p ϖ J x = algebraMap (𝕎 S) (untilt p ϖ J) (teichmuller p x) :=
  (rfl)

/-- Every `x♯` lies in `A⁺`. -/
theorem sharp_mem_untiltPlus (x : S) : sharp p ϖ J x ∈ untiltPlus p ϖ J :=
  algebraMap_mem_untiltPlus p ϖ J _

/-- `ϖ♯` is the image `π` of the class of `[ϖ]`. -/
theorem sharp_self :
    sharp p ϖ J ϖ =
      algebraMap (𝕎 S ⧸ J) (untilt p ϖ J) (Ideal.Quotient.mk J (teichmuller p ϖ)) :=
  algebraMap_apply p ϖ J _

/-- **`ϖ♯` is a pseudouniformiser** of the untilt. -/
theorem isPseudoUniformizer_sharp : IsPseudoUniformizer (sharp p ϖ J ϖ) := by
  rw [sharp_self]
  exact isPseudoUniformizer_algebraMap_of_hasBasis (hasBasis_nhds_zero p ϖ J)

/-! ### Fontaine's map `θ_J` -/

section Theta

variable (L : Type*) [CommRing L] [Algebra (WittVector p S) L]
  [IsLocalization.Away (teichmuller p ϖ) L]

/-- Fontaine's map `θ_J : 𝕎 S [1/[ϖ]] → (𝕎 S ⧸ J)[1/[ϖ]]`, induced by the quotient map
`𝕎 S → 𝕎 S ⧸ J`. Here `L` is any localization of `𝕎 S` away from `[ϖ]`. -/
noncomputable def theta : L →+* untilt p ϖ J :=
  IsLocalization.Away.map L (untilt p ϖ J) (Ideal.Quotient.mk J) (teichmuller p ϖ)

/-- `θ_J` extends the map `𝕎 S → A`. -/
@[simp]
theorem theta_algebraMap (a : 𝕎 S) :
    theta p ϖ J L (algebraMap (𝕎 S) L a) = algebraMap (𝕎 S) (untilt p ϖ J) a := by
  rw [theta, IsLocalization.Away.map, IsLocalization.map_eq, algebraMap_apply]

/-- `θ_J` is surjective. -/
theorem theta_surjective : Function.Surjective (theta p ϖ J L) :=
  IsLocalization.map_surjective_of_surjective _ _ _ Ideal.Quotient.mk_surjective

/-- **The kernel of `θ_J`** is the ideal generated by `J` in `𝕎 S [1/[ϖ]]`. -/
theorem ker_theta : RingHom.ker (theta p ϖ J L) = J.map (algebraMap (𝕎 S) L) := by
  rw [theta, IsLocalization.Away.map,
    IsLocalization.ker_map (untilt p ϖ J) _ (Submonoid.map_powers _ _), Ideal.mk_ker]

/-- **The untilt is `𝕎 S [1/[ϖ]] ⧸ J`**: `θ_J` identifies the quotient of `𝕎 S [1/[ϖ]]` by the
ideal generated by `J` with `(𝕎 S ⧸ J)[1/[ϖ]]`. -/
noncomputable def quotientMapEquiv : L ⧸ J.map (algebraMap (𝕎 S) L) ≃+* untilt p ϖ J :=
  (Ideal.quotEquivOfEq (ker_theta p ϖ J L).symm).trans
    (RingHom.quotientKerEquivOfSurjective (theta_surjective p ϖ J L))

/-- `quotientMapEquiv` is induced by `θ_J`. -/
@[simp]
theorem quotientMapEquiv_mk (x : L) :
    quotientMapEquiv p ϖ J L (Ideal.Quotient.mk _ x) = theta p ϖ J L x :=
  (rfl)

end Theta

/-! ### Independence of `ϖ` -/

section Congr

variable {p ϖ J} {ϖ' : S}

/-- If `ϖ'` divides a power of `ϖ`, then the class of `[ϖ']` is a unit of the untilt for `ϖ`. -/
private theorem isUnit_algebraMap_mk_teichmuller (h : ϖ ∈ (Ideal.span {ϖ'}).radical) :
    IsUnit (algebraMap (𝕎 S ⧸ J) (untilt p ϖ J) (Ideal.Quotient.mk J (teichmuller p ϖ'))) := by
  obtain ⟨n, hn⟩ := h
  refine isUnit_of_dvd_unit (map_dvd _ (map_dvd _ (map_dvd (teichmuller p)
    (Ideal.mem_span_singleton.mp hn)))) ?_
  rw [map_pow, map_pow, map_pow]
  exact (IsLocalization.Away.algebraMap_isUnit _).pow n

/-- The untilt for `ϖ` is a localization away from the product of the classes of `[ϖ]` and
`[ϖ']`, when `ϖ'` divides a power of `ϖ`. -/
private theorem isLocalization_mul (h : ϖ ∈ (Ideal.span {ϖ'}).radical) :
    IsLocalization.Away (Ideal.Quotient.mk J (teichmuller p ϖ) *
      Ideal.Quotient.mk J (teichmuller p ϖ')) (untilt p ϖ J) :=
  IsLocalization.Away.mul_of_isUnit _ _ (isUnit_algebraMap_mk_teichmuller h)

/-- If `ϖ'` divides a power of `ϖ`, a homomorphism of `𝕎 S ⧸ J`-algebras from the untilt for `ϖ`
to the untilt for `ϖ'` is continuous. -/
private theorem continuous_of_mem_radical (h : ϖ ∈ (Ideal.span {ϖ'}).radical)
    (f : untilt p ϖ J →ₐ[𝕎 S ⧸ J] untilt p ϖ' J) : Continuous f := by
  obtain ⟨k, hk⟩ := h
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hk
  refine continuous_of_continuousAt_zero f.toRingHom ?_
  rw [ContinuousAt, map_zero]
  refine ((hasBasis_nhds_zero p ϖ J).tendsto_iff (hasBasis_nhds_zero p ϖ' J)).mpr
    fun n _ ↦ ⟨k * n, trivial, fun x hx ↦ ?_⟩
  obtain ⟨a, rfl⟩ := mem_awayNhd.mp hx
  -- `[ϖ] ^ (k n) = [c] ^ n [ϖ'] ^ n`, so `π ^ (k n) A₀ ⊆ π' ^ n A₀`.
  refine mem_awayNhd.mpr ⟨Ideal.Quotient.mk J (teichmuller p c) ^ n * a, ?_⟩
  rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes, ← mul_assoc, ← mul_pow,
    ← map_mul, ← map_mul, mul_comm ϖ' c, hc, map_pow, map_pow, pow_mul]

/-- **The untilt does not depend on the choice of `ϖ`** up to the radical of `(ϖ)`: if `(ϖ)` and
`(ϖ')` have the same radical, for instance if `ϖ` and `ϖ'` are pseudouniformisers of a Tate ring
in a ring of integral elements `S`, then the untilts for `ϖ` and `ϖ'` are canonically isomorphic
as topological algebras over `𝕎 S ⧸ J`. -/
noncomputable def congr (h : (Ideal.span {ϖ}).radical = (Ideal.span {ϖ'}).radical) :
    untilt p ϖ J ≃A[𝕎 S ⧸ J] untilt p ϖ' J :=
  have h₁ : ϖ ∈ (Ideal.span {ϖ'}).radical := h ▸ Ideal.le_radical (Ideal.mem_span_singleton_self ϖ)
  have h₂ : ϖ' ∈ (Ideal.span {ϖ}).radical :=
    h ▸ Ideal.le_radical (Ideal.mem_span_singleton_self ϖ')
  have := isLocalization_mul (J := J) h₁
  have : IsLocalization.Away (Ideal.Quotient.mk J (teichmuller p ϖ) *
      Ideal.Quotient.mk J (teichmuller p ϖ')) (untilt p ϖ' J) :=
    mul_comm (Ideal.Quotient.mk J (teichmuller p ϖ')) (Ideal.Quotient.mk J (teichmuller p ϖ)) ▸
      isLocalization_mul (J := J) h₂
  let e := IsLocalization.algEquiv (Submonoid.powers (Ideal.Quotient.mk J (teichmuller p ϖ) *
    Ideal.Quotient.mk J (teichmuller p ϖ'))) (untilt p ϖ J) (untilt p ϖ' J)
  { e with
    continuous_toFun := continuous_of_mem_radical h₁ e.toAlgHom
    continuous_invFun := continuous_of_mem_radical h₂ e.symm.toAlgHom }

/-- `untilt.congr` is the identity on the image of `𝕎 S`. -/
@[simp]
theorem congr_algebraMap (h : (Ideal.span {ϖ}).radical = (Ideal.span {ϖ'}).radical) (a : 𝕎 S) :
    congr h (algebraMap (𝕎 S) (untilt p ϖ J) a) = algebraMap (𝕎 S) (untilt p ϖ' J) a := by
  rw [algebraMap_apply, algebraMap_apply]
  exact (congr h).commutes _

end Congr

/-! ### The untilt along `(p)` -/

section SpanP

variable [CharP S p] [PerfectRing S p] (L : Type*) [CommRing L] [Algebra S L]
  [IsLocalization.Away ϖ L]

/-- **The untilt along `(p)` is `S[1/ϖ]`**: for perfect `S` of characteristic `p`, reduction of
the zeroth Witt coordinate identifies `𝕎 S ⧸ (p)` with `S`, and hence the untilt along `(p)` with
any localization `L` of `S` away from `ϖ`. -/
noncomputable def spanPEquiv : untilt p ϖ (Ideal.span {(p : 𝕎 S)}) ≃+* L :=
  IsLocalization.ringEquivOfRingEquiv (M := Submonoid.powers
      (Ideal.Quotient.mk (Ideal.span {(p : 𝕎 S)}) (teichmuller p ϖ))) (T := Submonoid.powers ϖ)
    (untilt p ϖ (Ideal.span {(p : 𝕎 S)})) L WittVector.quotientPEquiv <| by
      rw [Submonoid.map_powers]
      rfl

/-- `spanPEquiv` sends `x♯` to `x`. -/
@[simp]
theorem spanPEquiv_sharp (x : S) :
    spanPEquiv p ϖ L (sharp p ϖ _ x) = algebraMap S L x := by
  have h := WittVector.quotientPEquiv_mk (teichmuller p x)
  simp only [Submodule.Quotient.quot_mk_eq_mk, Ideal.Quotient.mk_eq_mk] at h
  rw [sharp_apply, algebraMap_apply, spanPEquiv, IsLocalization.ringEquivOfRingEquiv_eq, h,
    WittVector.constantCoeff_apply, WittVector.teichmuller_coeff_zero]

end SpanP

/-! ### The untilt along a distinguished element -/

section Distinguished

variable [CharP S p] [PerfectRing S p] {p ϖ} {ξ : WittVector p S}

/-- **`𝕎 S ⧸ (ξ)` embeds into the untilt** along a distinguished `ξ` whose zeroth Witt coordinate
lies in the radical of `(ϖ)`, for a nonzerodivisor `ϖ`: the class of `[ϖ]` is a nonzerodivisor of
`𝕎 S ⧸ (ξ)`. -/
theorem algebraMap_injective (hξ : ξ.IsDistinguished) (hξ₀ : ξ.coeff 0 ∈ (Ideal.span {ϖ}).radical)
    (hϖ : ϖ ∈ S⁰) :
    Function.Injective (algebraMap (𝕎 S ⧸ Ideal.span {ξ}) (untilt p ϖ (Ideal.span {ξ}))) :=
  IsLocalization.injective _
    (Submonoid.powers_le.mpr (hξ.mk_teichmuller_mem_nonZeroDivisors hξ₀ hϖ))

/-- **`A⁺ = 𝕎 S ⧸ (ξ)`** for the untilt along a distinguished `ξ` whose zeroth Witt coordinate lies
in the radical of `(ϖ)`, for a nonzerodivisor `ϖ`. -/
noncomputable def quotientEquivUntiltPlus (hξ : ξ.IsDistinguished)
    (hξ₀ : ξ.coeff 0 ∈ (Ideal.span {ϖ}).radical) (hϖ : ϖ ∈ S⁰) :
    𝕎 S ⧸ Ideal.span {ξ} ≃+* untiltPlus p ϖ (Ideal.span {ξ}) :=
  RingEquiv.ofBijective (algebraMap (𝕎 S ⧸ Ideal.span {ξ}) _).rangeRestrict
    ⟨(algebraMap_injective hξ hξ₀ hϖ).codRestrict _, RingHom.rangeRestrict_surjective _⟩

/-- `quotientEquivUntiltPlus` is the map to the untilt. -/
@[simp]
theorem coe_quotientEquivUntiltPlus_apply (hξ : ξ.IsDistinguished)
    (hξ₀ : ξ.coeff 0 ∈ (Ideal.span {ϖ}).radical) (hϖ : ϖ ∈ S⁰) (a : 𝕎 S ⧸ Ideal.span {ξ}) :
    (quotientEquivUntiltPlus hξ hξ₀ hϖ a : untilt p ϖ (Ideal.span {ξ})) =
      algebraMap (𝕎 S ⧸ Ideal.span {ξ}) _ a :=
  (rfl)

/-- **The untilt along a distinguished element is Hausdorff**, when `S` is `ϖ`-adically complete
for a nonzerodivisor `ϖ` and the zeroth Witt coordinate of `ξ` lies in the radical of `(ϖ)`. -/
theorem t2Space (hξ : ξ.IsDistinguished) (hξ₀ : ξ.coeff 0 ∈ (Ideal.span {ϖ}).radical)
    (hϖ : ϖ ∈ S⁰) [IsAdicComplete (Ideal.span {ϖ}) S] :
    T2Space (untilt p ϖ (Ideal.span {ξ})) :=
  have := hξ.isAdicComplete_quotient hξ₀
  t2Space_of_hasBasis (hasBasis_nhds_zero p ϖ _) (hξ.mk_teichmuller_mem_nonZeroDivisors hξ₀ hϖ)

/-- **The untilt along a distinguished element is complete**, when `S` is `ϖ`-adically complete
for a nonzerodivisor `ϖ` and the zeroth Witt coordinate of `ξ` lies in the radical of `(ϖ)`. -/
theorem completeSpace (hξ : ξ.IsDistinguished) (hξ₀ : ξ.coeff 0 ∈ (Ideal.span {ϖ}).radical)
    (hϖ : ϖ ∈ S⁰) [IsAdicComplete (Ideal.span {ϖ}) S] :
    CompleteSpace (untilt p ϖ (Ideal.span {ξ})) :=
  have := hξ.isAdicComplete_quotient hξ₀
  completeSpace_of_hasBasis (hasBasis_nhds_zero p ϖ _)
    (hξ.mk_teichmuller_mem_nonZeroDivisors hξ₀ hϖ)

/-- **`A⁺ ⧸ (ϖ♯) ≃+* S ⧸ (ϖ)`** for the untilt along a distinguished `ξ` such that `ϖ` divides the
zeroth Witt coordinate of `ξ`, for a nonzerodivisor `ϖ`. It is induced by the zeroth Witt
coordinate (`TauCeti.Perfectoid.untilt.quotEquiv_mk`). -/
noncomputable def quotEquiv (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) (hϖ : ϖ ∈ S⁰) :
    untiltPlus p ϖ (Ideal.span {ξ}) ⧸
        Ideal.span {(⟨sharp p ϖ _ ϖ, sharp_mem_untiltPlus p ϖ _ ϖ⟩ :
          untiltPlus p ϖ (Ideal.span {ξ}))} ≃+*
      S ⧸ Ideal.span {ϖ} :=
  have hξ₀' : ξ.coeff 0 ∈ (Ideal.span {ϖ}).radical :=
    Ideal.le_radical (Ideal.mem_span_singleton.mpr hξ₀)
  (Ideal.quotientEquiv _ _ (quotientEquivUntiltPlus hξ hξ₀' hϖ) (by
      rw [Ideal.map_span, Set.image_singleton, RingEquiv.coe_toRingHom]
      exact congrArg (fun x ↦ Ideal.span {x}) (Subtype.ext ((sharp_self p ϖ _).trans
        (coe_quotientEquivUntiltPlus_apply hξ hξ₀' hϖ _).symm)))).symm.trans
    (hξ.quotientTeichmullerEquiv hξ₀)

/-- `quotEquiv` sends the class of the image of a Witt vector `a` to the class of its zeroth Witt
coordinate. -/
@[simp]
theorem quotEquiv_mk (hξ : ξ.IsDistinguished) (hξ₀ : ϖ ∣ ξ.coeff 0) (hϖ : ϖ ∈ S⁰) (a : 𝕎 S) :
    quotEquiv hξ hξ₀ hϖ
        (Ideal.Quotient.mk _ ⟨algebraMap (𝕎 S) _ a, algebraMap_mem_untiltPlus p ϖ _ a⟩) =
      Ideal.Quotient.mk _ (a.coeff 0) := by
  have hξ₀' : ξ.coeff 0 ∈ (Ideal.span {ϖ}).radical :=
    Ideal.le_radical (Ideal.mem_span_singleton.mpr hξ₀)
  have ha : (⟨algebraMap (𝕎 S) _ a, algebraMap_mem_untiltPlus p ϖ _ a⟩ :
      untiltPlus p ϖ (Ideal.span {ξ})) =
      quotientEquivUntiltPlus hξ hξ₀' hϖ (Ideal.Quotient.mk _ a) :=
    Subtype.ext (algebraMap_apply p ϖ _ a)
  rw [ha, quotEquiv, RingEquiv.trans_apply, Ideal.quotientEquiv_symm_mk,
    RingEquiv.symm_apply_apply, WittVector.IsDistinguished.quotientTeichmullerEquiv_mk_mk]

end Distinguished

end untilt

end TauCeti.Perfectoid
