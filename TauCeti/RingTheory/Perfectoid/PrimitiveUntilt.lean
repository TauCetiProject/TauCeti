/-!
# The untilt of a Huber pair along an ideal of `𝕎 R⁺`

Let `(R, R⁺)` be a Huber pair and `J` an ideal of the Witt vectors `𝕎 R⁺`. The *untilt* of
`(R, R⁺)` along `J` is the ring `A = (𝕎 R⁺ ⧸ J)[1/[ϖ]]`, where `ϖ ∈ R⁺` is a pseudouniformiser
of `R` and `[ϖ]` its Teichmüller representative, with the topology in which the image `A⁺` of
`𝕎 R⁺ ⧸ J` is open and carries its `[ϖ]`-adic topology. When `(R, R⁺)` is a perfectoid Tate pair
of characteristic `p` and `J` is generated by a primitive element `ξ`, Scholze shows that
`(A, A⁺)` is a perfectoid Tate pair with tilt `(R, R⁺)`, and that every perfectoid Tate pair
with tilt `(R, R⁺)` arises in this way (*Étale cohomology of diamonds*, Theorem 3.17); for
instance `J = (p)` gives back `(R, R⁺)`, and `R = ℂ_p♭`, `J = (p - [p♭])` gives `(ℂ_p, 𝒪_{ℂ_p})`.
This file constructs `A` and `A⁺`, makes `A` a Tate ring in which `A⁺` is open and bounded when
`R` is a Tate ring, and proves that `A` is complete and Hausdorff for `J = (ξ)` when `R` is a
perfect complete Hausdorff Tate ring of characteristic `p` and `ξ` is primitive.

To make the ring independent of a choice of `ϖ`, `TauCeti.Perfectoid.untilt p P J` is defined as
the localisation of `𝕎 R⁺ ⧸ J` at the classes of the Teichmüller representatives `[a]` of all
`a ∈ R⁺` which are units of `R`. Every such `a` divides a power of any pseudouniformiser `ϖ ∈ R⁺`,
so this is a localisation of `𝕎 R⁺ ⧸ J` away from the class of `[ϖ]`, for every pseudouniformiser
`ϖ ∈ R⁺` (`TauCeti.Perfectoid.untilt.isLocalizationAway`). For a Tate ring `R` the untilt carries
the `[ϖ]`-adic topology `TauCeti.Huber.awayTopology` for one such `ϖ`; the neighbourhoods of zero
then have basis `[ϖ]ⁿ A⁺` for every pseudouniformiser `ϖ ∈ R⁺`
(`TauCeti.Perfectoid.untilt.hasBasis_nhds_zero`), so the topology does not depend on the choice.
It makes the untilt a Tate ring in which `A⁺` is open and bounded and the class of `[ϖ]` is a
pseudouniformiser.

If `R` is a perfect complete Hausdorff Tate ring of characteristic `p` and `J = (ξ)` with `ξ`
primitive, then `R⁺` is perfect and `ϖ`-adically complete, and the class of `[ϖ]` is a
nonzerodivisor of `𝕎 R⁺ ⧸ (ξ)`, for which this quotient is adically complete
(`WittVector.IsDistinguished.isAdicComplete_quotient`). Hence `𝕎 R⁺ ⧸ (ξ)` embeds into the
untilt, and the untilt is Hausdorff and complete.

## Main definitions

* `TauCeti.Perfectoid.untiltDenominators p P`: the Teichmüller representatives of the elements
  of `R⁺` that are units of `R`.
* `TauCeti.Perfectoid.untilt p P J`: the untilt of `P` along `J`.
* `TauCeti.Perfectoid.untiltPlus p P J`: its subring `A⁺`, the image of `𝕎 R⁺ ⧸ J`.

## Main results

* `TauCeti.Perfectoid.untilt.isLocalizationAway`: the untilt is `(𝕎 R⁺ ⧸ J)[1/[ϖ]]` for every
  pseudouniformiser `ϖ ∈ R⁺`.
* `TauCeti.Perfectoid.untilt.hasBasis_nhds_zero`: the neighbourhoods of zero have basis
  `[ϖ]ⁿ A⁺`, for every pseudouniformiser `ϖ ∈ R⁺`.
* `TauCeti.Perfectoid.untilt.instIsTateRing`: for a Tate ring `R`, the untilt is a Tate ring,
  with `TauCeti.Perfectoid.untilt.isOpen_untiltPlus`,
  `TauCeti.Perfectoid.untilt.isBounded_untiltPlus` and
  `TauCeti.Perfectoid.untilt.isPseudoUniformizer_algebraMap`.
* `TauCeti.Perfectoid.untilt.algebraMap_injective`: for `R` a perfect Tate ring of
  characteristic `p` and primitive `ξ`, `𝕎 R⁺ ⧸ (ξ)` embeds into the untilt along `(ξ)`.
* `TauCeti.Perfectoid.untilt.t2Space`, `TauCeti.Perfectoid.untilt.completeSpace`: for `R` a
  perfect complete Hausdorff Tate ring of characteristic `p` and primitive `ξ`, the untilt along
  `(ξ)` is Hausdorff and complete.

## References

* P. Scholze, *Étale cohomology of diamonds*, Theorem 3.17 and its proof.
* P. Scholze and J. Weinstein, *Berkeley lectures on `p`-adic geometry*, Theorem 6.2.11.
* K. S. Kedlaya, *Sheaves, stacks, and shtukas*, Theorem 2.3.9.
-/

public section

open Filter Topology TauCeti.Huber WittVector
open scoped nonZeroDivisors

namespace TauCeti.Perfectoid

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R]

local notation "𝕎" => WittVector p

section Topology

variable [TopologicalSpace R] [IsTopologicalRing R]

section Carrier

variable [IsHuberRing R] (P : Pair R)

/-- The denominators of the untilt: the Teichmüller representatives `[a] ∈ 𝕎 R⁺` of the elements
`a ∈ R⁺` which are units of `R`. -/
noncomputable def untiltDenominators : Submonoid (𝕎 P.plus) :=
  ((IsUnit.submonoid R).comap P.plus.subtype).map (teichmuller p)

variable {p P} in
@[simp]
theorem mem_untiltDenominators {x : 𝕎 P.plus} :
    x ∈ untiltDenominators p P ↔ ∃ a : P.plus, IsUnit (a : R) ∧ teichmuller p a = x := by
  simp [untiltDenominators, IsUnit.mem_submonoid_iff]

-- The local notation `𝕎` is not used in `variable` commands, where it does not elaborate.
variable (J : Ideal (WittVector p P.plus))

/-- **The untilt of a Huber pair `(R, R⁺)` along an ideal `J` of `𝕎 R⁺`**: the localisation of
`𝕎 R⁺ ⧸ J` at the classes of the Teichmüller representatives of the elements of `R⁺` which are
units of `R`. It is `(𝕎 R⁺ ⧸ J)[1/[ϖ]]` for every pseudouniformiser `ϖ ∈ R⁺`
(`TauCeti.Perfectoid.untilt.isLocalizationAway`). -/
def untilt : Type _ :=
  Localization ((untiltDenominators p P).map (Ideal.Quotient.mk J))

namespace untilt

noncomputable instance instCommRing : CommRing (untilt p P J) :=
  inferInstanceAs (CommRing (Localization ((untiltDenominators p P).map (Ideal.Quotient.mk J))))

noncomputable instance instAlgebra : Algebra (𝕎 P.plus ⧸ J) (untilt p P J) :=
  inferInstanceAs
    (Algebra (𝕎 P.plus ⧸ J) (Localization ((untiltDenominators p P).map (Ideal.Quotient.mk J))))

instance instIsLocalization :
    IsLocalization ((untiltDenominators p P).map (Ideal.Quotient.mk J)) (untilt p P J) :=
  inferInstanceAs (IsLocalization _
    (Localization ((untiltDenominators p P).map (Ideal.Quotient.mk J))))

variable {p P J}

/-- **The untilt is `(𝕎 R⁺ ⧸ J)[1/[ϖ]]`** for every pseudouniformiser `ϖ ∈ R⁺` of `R`. -/
theorem isLocalizationAway {ϖ : P.plus} (hϖ : IsPseudoUniformizer (ϖ : R)) :
    IsLocalization.Away (Ideal.Quotient.mk J (teichmuller p ϖ)) (untilt p P J) := by
  refine (IsLocalization.iff_of_le_of_exists_dvd (M := Submonoid.powers _)
    (N := (untiltDenominators p P).map (Ideal.Quotient.mk J)) ?_ ?_).mpr inferInstance
  · exact Submonoid.powers_le.mpr
      (Submonoid.mem_map_of_mem _ (mem_untiltDenominators.mpr ⟨ϖ, hϖ.isUnit, rfl⟩))
  · rintro _ ⟨_, hx, rfl⟩
    obtain ⟨a, ha, rfl⟩ := mem_untiltDenominators.mp hx
    obtain ⟨n, c, hc⟩ := P.plus.exists_dvd_pow_of_isTopologicallyNilpotent
      P.isRingOfIntegralElements.isOpen ha hϖ.isTopologicallyNilpotent
    refine ⟨_, ⟨n, rfl⟩, Ideal.Quotient.mk J (teichmuller p c), ?_⟩
    dsimp only
    rw [← map_pow, ← map_pow, hc, map_mul, map_mul]

end untilt

/-- **The subring `A⁺` of the untilt**: the image of `𝕎 R⁺ ⧸ J`. For a Tate ring `R` it is open
and bounded (`TauCeti.Perfectoid.untilt.isOpen_untiltPlus`,
`TauCeti.Perfectoid.untilt.isBounded_untiltPlus`); it is not claimed here to be integrally closed
in the untilt, which can fail for general `J`. -/
noncomputable def untiltPlus : Subring (untilt p P J) :=
  (algebraMap (𝕎 P.plus ⧸ J) (untilt p P J)).range

variable {p P J} in
@[simp]
theorem mem_untiltPlus {x : untilt p P J} :
    x ∈ untiltPlus p P J ↔ ∃ a : 𝕎 P.plus ⧸ J, algebraMap _ _ a = x :=
  RingHom.mem_range

end Carrier

namespace untilt

variable {p} [IsTateRing R] {P : Pair R} {J : Ideal (WittVector p P.plus)}

/-- For a unit `s` and a topologically nilpotent `t` of `R` in `R⁺`, every neighbourhood
`[s]ᵐ A⁺` contains some `[t]ᵏ A⁺`. -/
private theorem exists_awayNhd_subset {s t : P.plus} (hs : IsUnit (s : R))
    (ht : IsTopologicallyNilpotent (t : R)) (m : ℕ) :
    ∃ k, (awayNhd (Ideal.Quotient.mk J (teichmuller p t)) (untilt p P J) k : Set (untilt p P J)) ⊆
      awayNhd (Ideal.Quotient.mk J (teichmuller p s)) (untilt p P J) m := by
  obtain ⟨k, c, hc⟩ := P.plus.exists_dvd_pow_of_isTopologicallyNilpotent
    P.isRingOfIntegralElements.isOpen (a := s ^ m) (by simpa using hs.pow m) ht
  refine ⟨k, fun x hx ↦ ?_⟩
  obtain ⟨a, rfl⟩ := mem_awayNhd.mp hx
  refine mem_awayNhd.mpr ⟨Ideal.Quotient.mk J (teichmuller p c) * a, ?_⟩
  rw [← mul_assoc, ← map_pow, ← map_pow, ← map_mul, ← map_mul, ← hc, map_pow, map_pow]

variable (p P J) in
/-- **The topology of the untilt**: the `[ϖ]`-adic topology `TauCeti.Huber.awayTopology` on
`(𝕎 R⁺ ⧸ J)[1/[ϖ]]`, for a pseudouniformiser `ϖ ∈ R⁺` chosen by
`TauCeti.Huber.IsRingOfIntegralElements.exists_isPseudoUniformizer`. It does not depend on
the choice (`TauCeti.Perfectoid.untilt.hasBasis_nhds_zero`). -/
noncomputable instance instTopologicalSpace : TopologicalSpace (untilt p P J) :=
  @awayTopology _ _
    (Ideal.Quotient.mk J (teichmuller p
      P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose))
    (untilt p P J) _ _
    (isLocalizationAway (ϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose)
      P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec)

-- Here and in the instances below, the arguments of the `awayTopology` lemmas are given
-- explicitly: unification has to unfold `instTopologicalSpace` to `awayTopology`, which it does
-- not do while the pseudouniformiser is still a metavariable.
/-- The defining basis of the neighbourhoods of zero of the untilt, for the chosen
pseudouniformiser. -/
private theorem hasBasis_nhds_zero_choose :
    (𝓝 (0 : untilt p P J)).HasBasis (fun _ : ℕ ↦ True) fun n ↦
      (awayNhd (Ideal.Quotient.mk J (teichmuller p
        P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose))
        (untilt p P J) n : Set (untilt p P J)) :=
  @hasBasis_nhds_zero_awayTopology _ _ _ (untilt p P J) _ _
    (isLocalizationAway (ϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose)
      P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec)

/-- **The neighbourhoods of zero of the untilt have basis `[ϖ]ⁿ A⁺`**, for every
pseudouniformiser `ϖ ∈ R⁺` of `R`. In particular the topology of the untilt does not depend on
the choice of a pseudouniformiser. -/
theorem hasBasis_nhds_zero {ϖ : P.plus} (hϖ : IsPseudoUniformizer (ϖ : R)) :
    (𝓝 (0 : untilt p P J)).HasBasis (fun _ : ℕ ↦ True) fun n ↦
      (awayNhd (Ideal.Quotient.mk J (teichmuller p ϖ)) (untilt p P J) n : Set (untilt p P J)) :=
  have hϖ₀ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec
  hasBasis_nhds_zero_choose.to_hasBasis
    (fun m _ ↦ (exists_awayNhd_subset hϖ₀.isUnit hϖ.isTopologicallyNilpotent m).imp
      fun _ h ↦ ⟨trivial, h⟩)
    fun m _ ↦ (exists_awayNhd_subset hϖ.isUnit hϖ₀.isTopologicallyNilpotent m).imp
      fun _ h ↦ ⟨trivial, h⟩

variable (p P J)

/-- The untilt is a topological ring. -/
instance instIsTopologicalRing : IsTopologicalRing (untilt p P J) :=
  @isTopologicalRing_awayTopology _ _ _ (untilt p P J) _ _
    (isLocalizationAway (ϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose)
      P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec)

/-- The untilt is a nonarchimedean ring. -/
instance instNonarchimedeanRing : NonarchimedeanRing (untilt p P J) :=
  @nonarchimedeanRing_awayTopology _ _ _ (untilt p P J) _ _
    (isLocalizationAway (ϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose)
      P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec)

/-- **The untilt is a Tate ring**, with pair of definition `A⁺` and the class of `[ϖ]`. -/
instance instIsTateRing : IsTateRing (untilt p P J) :=
  haveI := isLocalizationAway (J := J)
    (ϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose)
    P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec
  isTateRing_of_hasBasis hasBasis_nhds_zero_choose

/-- The uniform structure of the untilt: that of its additive topological group. -/
noncomputable instance instUniformSpace : UniformSpace (untilt p P J) :=
  IsTopologicalAddGroup.rightUniformSpace (untilt p P J)

/-- The untilt is a uniform additive group for `TauCeti.Perfectoid.untilt.instUniformSpace`. -/
instance instIsUniformAddGroup : IsUniformAddGroup (untilt p P J) :=
  isUniformAddGroup_of_addCommGroup

variable {p P J}

/-- The ring `A⁺` is open in the untilt. -/
theorem isOpen_untiltPlus : IsOpen (untiltPlus p P J : Set (untilt p P J)) :=
  isOpen_range_algebraMap_of_hasBasis hasBasis_nhds_zero_choose

/-- The ring `A⁺` is bounded in the untilt. -/
theorem isBounded_untiltPlus : IsBounded (untiltPlus p P J : Set (untilt p P J)) :=
  isBounded_range_algebraMap_of_hasBasis hasBasis_nhds_zero_choose

/-- The class of the Teichmüller representative of a pseudouniformiser `ϖ ∈ R⁺` of `R` is a
pseudouniformiser of the untilt. -/
theorem isPseudoUniformizer_algebraMap {ϖ : P.plus} (hϖ : IsPseudoUniformizer (ϖ : R)) :
    IsPseudoUniformizer
      (algebraMap (𝕎 P.plus ⧸ J) (untilt p P J) (Ideal.Quotient.mk J (teichmuller p ϖ))) :=
  haveI := isLocalizationAway (J := J) hϖ
  isPseudoUniformizer_algebraMap_of_hasBasis (hasBasis_nhds_zero hϖ)

end untilt

end Topology

/-! ### Untilts along primitive elements -/

namespace untilt

section Primitive

variable {p} [TopologicalSpace R] [IsTopologicalRing R] [IsTateRing R] [CharP R p]
  [PerfectRing R p] {P : Pair R} {ξ : WittVector p P.plus}

omit [Fact p.Prime] [CharP R p] [PerfectRing R p] in
/-- The zeroth Witt coordinate of a primitive element lies in the radical of `(ϖ)`, for every
pseudouniformiser `ϖ ∈ R⁺`. -/
private theorem coeff_zero_mem_radical (hξ : ξ.IsPrimitive) {ϖ : P.plus}
    (hϖ : IsPseudoUniformizer (ϖ : R)) : ξ.coeff 0 ∈ (Ideal.span {ϖ}).radical := by
  obtain ⟨n, hn⟩ := P.plus.exists_dvd_pow_of_isTopologicallyNilpotent
    P.isRingOfIntegralElements.isOpen hϖ.isUnit
    (hξ.isTopologicallyNilpotent_coeff_zero.map (φ := P.plus.subtype) continuous_subtype_val)
  exact ⟨n, Ideal.mem_span_singleton.mpr hn⟩

/-- The class of `[ϖ]` is a nonzerodivisor of `𝕎 R⁺ ⧸ (ξ)` for primitive `ξ`. -/
private theorem mk_teichmuller_mem_nonZeroDivisors (hξ : ξ.IsPrimitive) {ϖ : P.plus}
    (hϖ : IsPseudoUniformizer (ϖ : R)) :
    Ideal.Quotient.mk (Ideal.span {ξ}) (teichmuller p ϖ) ∈ (𝕎 P.plus ⧸ Ideal.span {ξ})⁰ :=
  hξ.isDistinguished.mk_teichmuller_mem_nonZeroDivisors (coeff_zero_mem_radical hξ hϖ)
    (comap_nonZeroDivisors_le_of_injective (f := P.plus.subtype) Subtype.val_injective
      hϖ.isUnit.mem_nonZeroDivisors)

/-- **`𝕎 R⁺ ⧸ (ξ)` embeds into the untilt** along a primitive element `ξ`, for `R` a perfect Tate
ring of characteristic `p`: the class of `[ϖ]` is a nonzerodivisor. -/
theorem algebraMap_injective (hξ : ξ.IsPrimitive) :
    Function.Injective (algebraMap (𝕎 P.plus ⧸ Ideal.span {ξ}) (untilt p P (Ideal.span {ξ}))) :=
  have hϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec
  haveI := isLocalizationAway (J := Ideal.span {ξ}) hϖ
  IsLocalization.injective (M := Submonoid.powers _) _
    (Submonoid.powers_le.mpr (mk_teichmuller_mem_nonZeroDivisors hξ hϖ))

end Primitive

section Complete

variable {p} [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R]
  [CompleteSpace R] [T2Space R] [CharP R p] [PerfectRing R p] {P : Pair R}
  {ξ : WittVector p P.plus}

/-- For a pseudouniformiser `ϖ ∈ R⁺`, the quotient `𝕎 R⁺ ⧸ (ξ)` is adically complete for the
class of `[ϖ]`. -/
private theorem isAdicComplete_quotient (hξ : ξ.IsPrimitive) {ϖ : P.plus}
    (hϖ : IsPseudoUniformizer (ϖ : R)) :
    IsAdicComplete (Ideal.span {Ideal.Quotient.mk (Ideal.span {ξ}) (teichmuller p ϖ)})
      (𝕎 P.plus ⧸ Ideal.span {ξ}) :=
  haveI := IsUniform.of_perfectRing (R := R) p
  haveI := P.isRingOfIntegralElements.isAdicComplete_span_singleton ϖ hϖ
  hξ.isDistinguished.isAdicComplete_quotient (coeff_zero_mem_radical hξ hϖ)

/-- **The untilt along a primitive element is Hausdorff**, for `R` a perfect complete Hausdorff
Tate ring of characteristic `p`. -/
theorem t2Space (hξ : ξ.IsPrimitive) : T2Space (untilt p P (Ideal.span {ξ})) :=
  have hϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec
  haveI := isLocalizationAway (J := Ideal.span {ξ}) hϖ
  haveI := isAdicComplete_quotient hξ hϖ
  t2Space_of_hasBasis (hasBasis_nhds_zero hϖ)
    (mk_teichmuller_mem_nonZeroDivisors hξ hϖ)

/-- **The untilt along a primitive element is complete**, for `R` a perfect complete Hausdorff
Tate ring of characteristic `p`. -/
theorem completeSpace (hξ : ξ.IsPrimitive) : CompleteSpace (untilt p P (Ideal.span {ξ})) :=
  have hϖ := P.isRingOfIntegralElements.exists_isPseudoUniformizer.choose_spec
  haveI := isLocalizationAway (J := Ideal.span {ξ}) hϖ
  haveI := isAdicComplete_quotient hξ hϖ
  completeSpace_of_hasBasis (hasBasis_nhds_zero hϖ)
    (mk_teichmuller_mem_nonZeroDivisors hξ hϖ)

end Complete

end untilt

end TauCeti.Perfectoid
