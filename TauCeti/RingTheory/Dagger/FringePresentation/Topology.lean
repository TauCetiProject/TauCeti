module

public import TauCeti.RingTheory.Dagger.FringePresentation.Basic
public import TauCeti.RingTheory.Dagger.GaussNorm
public import Mathlib.Analysis.LocallyConvex.WithSeminorms
public import Mathlib.Topology.Algebra.Ring.Ideal
public import Mathlib.Topology.Algebra.Module.Basic

/-!
# The fringe topology of a presentation

For a fringe presentation `P` of an algebra `A`, give each stage `A_ρ` its quotient
Gauss topology. The presentation's fringe topology on `A` is generated by all
ultrametric seminorms whose pullbacks to every stage are continuous. This is the
finest topology generated by ultrametric seminorms for which all stage maps are
continuous. A linear map to an ultrametric seminormed space is continuous exactly
when its composites with all stage maps are continuous.

The construction is attached to the presentation. Independence of presentations
requires a comparison of the continuous maps between their stages; it is not
asserted here. No Hausdorffness or completeness is built into the definition.

## References

* E. Grosse-Klönne, *Rigid analytic spaces with overconvergent structure sheaf*,
  J. reine angew. Math. 519 (2000), §4.2.
-/

public section

namespace TauCeti.Dagger.FringePresentation

open Filter Topology

variable {K A : Type*} [NormedField K] [IsUltrametricDist K]
  [CommRing A] [Algebra K A] (P : FringePresentation K A)

/-- The quotient Gauss topology on a fringe stage. -/
instance stageTopology (ρ : Set.Ioc (1 : ℝ) P.radius) : TopologicalSpace (P.stage ρ) := by
  letI (_ : Fin P.n) : Fact (0 < (ρ : ℝ)) := ⟨zero_lt_one.trans ρ.2.1⟩
  exact inferInstanceAs (TopologicalSpace (_ ⧸ P.stageIdeal ρ))

/-- A fringe stage is a topological additive group for its quotient Gauss topology. -/
instance stageIsTopologicalAddGroup (ρ : Set.Ioc (1 : ℝ) P.radius) :
    IsTopologicalAddGroup (P.stage ρ) := by
  let (_ : Fin P.n) : Fact (0 < (ρ : ℝ)) := ⟨zero_lt_one.trans ρ.2.1⟩
  exact inferInstanceAs (IsTopologicalAddGroup (_ ⧸ P.stageIdeal ρ))

/-- Restriction to a smaller radius is continuous for the quotient Gauss topologies. -/
theorem continuous_stageMap {ρ ρ' : Set.Ioc (1 : ℝ) P.radius} (h : ρ ≤ ρ') :
    Continuous (P.stageMap h) := by
  have posRadius : ∀ _ : Fin P.n, Fact (0 < (ρ : ℝ)) := fun _ ↦ ⟨zero_lt_one.trans ρ.2.1⟩
  have posRadius' : ∀ _ : Fin P.n, Fact (0 < (ρ' : ℝ)) := fun _ ↦ ⟨zero_lt_one.trans ρ'.2.1⟩
  apply (P.stageIdeal ρ').isQuotientMap_mkQ.continuous_iff.mpr
  have heq : (P.stageMap h) ∘ (P.stageIdeal ρ').mkQ =
      (P.stageIdeal ρ).mkQ ∘ TauCeti.MvPowerSeries.restrictedRadiusHom
        (fun _ ↦ zero_le_one.trans ρ.2.1.le) (fun _ ↦ h) := by
    funext f
    exact P.stageMap_mk h f
  rw [heq]
  exact (P.stageIdeal ρ).continuous_mkQ.comp
    (@TauCeti.MvPowerSeries.continuous_restrictedRadiusHom (Fin P.n) K _ _
      (fun _ ↦ (ρ : ℝ)) (fun _ ↦ (ρ' : ℝ))
      (fun _ ↦ zero_le_one.trans ρ.2.1.le) (fun _ ↦ h) posRadius posRadius')

/-- The ultrametric seminorms on `A` continuous on every stage of `P`. -/
def fringeSeminorms : Set (Seminorm K A) :=
  {q | IsNonarchimedean q ∧ ∀ ρ, Continuous fun x ↦ q (P.ofStage ρ x)}

/-- Membership in the defining seminorm family means ultrametricity and continuity
on every quotient stage. -/
@[simp]
theorem mem_fringeSeminorms_iff (q : Seminorm K A) :
    q ∈ P.fringeSeminorms ↔
      IsNonarchimedean q ∧ ∀ ρ, Continuous fun x ↦ q (P.ofStage ρ x) :=
  Iff.rfl

/-- The fringe topology of a presentation, generated by its stagewise continuous
ultrametric seminorms. The stages have their quotient Gauss topologies. -/
@[instance_reducible]
def fringeTopology : TopologicalSpace A :=
  (SeminormFamily.moduleFilterBasis (fun q : P.fringeSeminorms ↦ q.val)).topology

/-- The defining seminorm family generates the presentation's fringe topology. -/
theorem withSeminorms_fringeTopology :
    letI := P.fringeTopology
    WithSeminorms (fun q : P.fringeSeminorms ↦ q.val) := by
  let := P.fringeTopology
  exact ⟨rfl⟩

/-- Addition and negation are continuous for the fringe topology. -/
theorem isTopologicalAddGroup_fringeTopology :
    letI := P.fringeTopology
    IsTopologicalAddGroup A := by
  let := P.fringeTopology
  exact P.withSeminorms_fringeTopology.isTopologicalAddGroup

/-- Scalar multiplication is jointly continuous for the fringe topology. -/
theorem continuousSMul_fringeTopology :
    letI := P.fringeTopology
    ContinuousSMul K A := by
  let := P.fringeTopology
  exact P.withSeminorms_fringeTopology.continuousSMul

/-- Every stage maps continuously into the algebra with its fringe topology. -/
theorem continuous_ofStage (ρ : Set.Ioc (1 : ℝ) P.radius) :
    letI := P.fringeTopology
    Continuous (P.ofStage ρ) := by
  let := P.fringeTopology
  apply WithSeminorms.continuous_of_continuous_comp P.withSeminorms_fringeTopology
    (P.ofStage ρ).toLinearMap
  exact fun q ↦ q.property.2 ρ

/-- An ultrametric seminorm is fringe-continuous iff it is continuous on every stage. -/
theorem continuous_seminorm_iff (q : Seminorm K A) (hq : IsNonarchimedean q) :
    letI := P.fringeTopology
    Continuous q ↔ ∀ ρ, Continuous fun x ↦ q (P.ofStage ρ x) := by
  let := P.fringeTopology
  constructor
  · exact fun h ρ ↦ h.comp (P.continuous_ofStage ρ)
  · intro h
    exact P.withSeminorms_fringeTopology.continuous_seminorm ⟨q, hq, h⟩

/-- A neighborhood contains a finite intersection of translated positive-radius balls
of stagewise continuous ultrametric seminorms. -/
theorem mem_nhds_fringeTopology_iff (a : A) (U : Set A) :
    letI := P.fringeTopology
    U ∈ 𝓝 a ↔ ∃ (s : Finset P.fringeSeminorms) (r : ℝ),
      0 < r ∧ (s.sup fun q ↦ q.val).ball a r ⊆ U := by
  let := P.fringeTopology
  exact P.withSeminorms_fringeTopology.mem_nhds_iff a U

/-- The fringe topology is finer than every topology generated by ultrametric seminorms
for which all stage maps are continuous. -/
theorem fringeTopology_le {ι : Type*} (q : ι → Seminorm K A)
    (hq : ∀ i, IsNonarchimedean (q i)) (t : TopologicalSpace A)
    (ht : @WithSeminorms K A ι _ _ _ q t)
    (hstage : ∀ ρ, @Continuous _ _ _ t (P.ofStage ρ)) :
    P.fringeTopology ≤ t := by
  suffices @Continuous A A P.fringeTopology t id from continuous_id_iff_le.mp this
  -- The source and target are the same algebra, but carry different topologies.
  apply @WithSeminorms.continuous_of_continuous_comp K K A A ι _ _ _ _ _ _ _ _ q
    P.fringeTopology P.isTopologicalAddGroup_fringeTopology t ht LinearMap.id
  intro i
  exact (P.continuous_seminorm_iff (q i) (hq i)).2
    fun ρ ↦ (ht.continuous_seminorm i).comp (hstage ρ)

/-- A linear map to an ultrametric seminormed space is fringe-continuous exactly when
it is continuous on every stage. Completeness of the target is not required. -/
theorem continuous_linearMap_iff {E : Type*} [SeminormedAddCommGroup E]
    [NormedSpace K E] [IsUltrametricDist E] (f : A →ₗ[K] E) :
    letI := P.fringeTopology
    Continuous f ↔ ∀ ρ, Continuous (f.comp (P.ofStage ρ).toLinearMap) := by
  let := P.fringeTopology
  let := P.isTopologicalAddGroup_fringeTopology
  constructor
  · exact fun h ρ ↦ h.comp (P.continuous_ofStage ρ)
  · intro h
    apply WithSeminorms.continuous_of_continuous_comp (norm_withSeminorms K E) f
    intro _
    apply (P.continuous_seminorm_iff ((normSeminorm K E).comp f) ?_).2
    · exact fun ρ ↦ continuous_norm.comp (h ρ)
    · intro x y
      simpa using IsUltrametricDist.norm_add_le_max (f x) (f y)

end TauCeti.Dagger.FringePresentation
