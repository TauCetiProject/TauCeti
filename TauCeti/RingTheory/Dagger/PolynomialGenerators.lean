module

public import TauCeti.RingTheory.Dagger.NoetherNormalization
import Mathlib.RingTheory.Nakayama
import Mathlib.RingTheory.Polynomial.Basic
import TauCeti.RingTheory.Ideal.Quotient.Integral
import TauCeti.RingTheory.Ideal.Quotient.Operations

/-!
# Maximal ideals of Monsky–Washnitzer algebras are generated by polynomials

Let `K` be a complete ultrametric normed field and `W = K⟨X⟩†` the Monsky–Washnitzer algebra of
overconvergent power series in finitely many variables. If `I` is an ideal of `W` with `W ⧸ I`
integral over `K`, for instance finite-dimensional, then `I` is generated by the polynomials it
contains:

```text
I = (I ∩ K[X]) W.
```

Every maximal ideal `m` of `W` has a residue field finite over `K`
(`TauCeti.Dagger.washnitzerAlgebra.finite_quotient_of_isMaximal`), so `m ∩ K[X]` is a maximal
ideal of the polynomial ring and generates `m`. In particular `m` is generated by finitely many
polynomials and is determined by `m ∩ K[X]`.

The proof is algebraic. Write `𝔞 = (I ∩ K[X]) W ⊆ I`. Every class modulo an ideal with integral
quotient contains a polynomial, by Weierstrass division
(`TauCeti.Dagger.washnitzerAlgebra.surjective_mkₐ_comp_ofMvPolynomial`).

* Applied modulo `I * I`, this gives `I ≤ 𝔞 ⊔ I * I`: an element of `I` differs from a
  polynomial by an element of `I * I`, and that polynomial then lies in `I`.
* Applied modulo `I * m'` for a maximal ideal `m'` containing `𝔞`, it gives
  `I ≤ 𝔞 ⊔ I * m' ≤ m'`. Hence `I` lies in the Jacobson radical of `𝔞`.

Since `W` is noetherian, `I` is finitely generated, and Nakayama's lemma
(`Submodule.sup_eq_sup_smul_of_le_smul_of_le_jacobson`) gives `I ≤ 𝔞`.

## Main results

* `Ideal.map_comap_ofMvPolynomial_of_isIntegral`: an ideal with quotient integral over `K` is
  generated by the polynomials it contains.
* `Ideal.exists_finset_span_ofMvPolynomial_eq_of_isIntegral`: such an ideal is generated by
  finitely many polynomials.
* `Ideal.isMaximal_comap_ofMvPolynomial`: the polynomials in a maximal ideal of `W` form a
  maximal ideal of `K[X]`.
* `Ideal.map_comap_ofMvPolynomial_of_isMaximal`: every maximal ideal of `W` is generated by the
  polynomials it contains.

## References

* E. Grosse-Klönne, *Rigid analytic spaces with overconvergent structure sheaf*,
  J. reine angew. Math. 519 (2000), §1, Proposition 1.5 and its proof.

The Tate-algebra counterpart is `Ideal.map_comap_polynomialToRestricted_of_isMaximal`, proved there
from the closedness of ideals and the density of polynomials. The argument here uses Nakayama's
lemma instead, and needs no topology on `W` beyond Weierstrass division.
-/

public section

namespace Ideal

open TauCeti TauCeti.Dagger washnitzerAlgebra

variable {K : Type*} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {σ : Type*} [Finite σ]

local notation "W" => washnitzerAlgebra σ K

/-- If `W ⧸ (I * J)` is integral over `K`, then every element of `I` is a polynomial lying in `I`
plus an element of `I * J`. -/
private theorem le_map_comap_ofMvPolynomial_sup_mul {I J : Ideal W}
    (hIJ : ∀ f : W, IsIntegral K (Ideal.Quotient.mk (I * J) f)) :
    I ≤ (I.comap (ofMvPolynomial σ K)).map (ofMvPolynomial σ K) ⊔ I * J := by
  have : Algebra.IsIntegral K (W ⧸ I * J) := ⟨fun x ↦ by
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact hIJ f⟩
  intro f hf
  obtain ⟨p, hp⟩ := surjective_mkₐ_comp_ofMvPolynomial (I * J) (Ideal.Quotient.mk _ f)
  rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq] at hp
  -- `ofMvPolynomial p = (ofMvPolynomial p - f) + f` lies in `I`.
  have hpI : ofMvPolynomial σ K p ∈ I := by
    have h := I.add_mem (Ideal.mul_le_left hp) hf
    rwa [sub_add_cancel] at h
  rw [← sub_sub_cancel (ofMvPolynomial σ K p) f]
  exact Submodule.sub_mem_sup (Ideal.mem_map_of_mem _ (Ideal.mem_comap.mpr hpI)) hp

/-- If `W ⧸ I` is integral over `K`, then `I` lies in every maximal ideal containing the
polynomials of `I`. -/
private theorem le_of_map_comap_ofMvPolynomial_le {I m : Ideal W} [Algebra.IsIntegral K (W ⧸ I)]
    [m.IsMaximal] (h : (I.comap (ofMvPolynomial σ K)).map (ofMvPolynomial σ K) ≤ m) :
    I ≤ m := by
  have : Module.Finite K (W ⧸ m) := finite_quotient_of_isMaximal (AlgHom.Finite.id K W) m
  -- Modulo `I * m`, every element of `I` is a polynomial in `I`, hence in `m`.
  exact (le_map_comap_ofMvPolynomial_sup_mul (I := I) (J := m) fun f ↦
    isIntegral_quotient_mul_of_isIntegral_quotient f (Algebra.IsIntegral.isIntegral _)
      (Algebra.IsIntegral.isIntegral _)).trans (sup_le h Ideal.mul_le_right)

/-- **An ideal with integral quotient is generated by its polynomials.** If `K⟨X⟩† ⧸ I` is
integral over `K`, for instance finite-dimensional, then `I` is generated by `I ∩ K[X]`. -/
theorem map_comap_ofMvPolynomial_of_isIntegral (I : Ideal W) [Algebra.IsIntegral K (W ⧸ I)] :
    (I.comap (ofMvPolynomial σ K)).map (ofMvPolynomial σ K) = I := by
  set 𝔞 := (I.comap (ofMvPolynomial σ K)).map (ofMvPolynomial σ K)
  refine Ideal.map_comap_le.antisymm ?_
  have hjac : I ≤ 𝔞.jacobson := le_sInf fun m hm ↦
    have : m.IsMaximal := hm.2
    le_of_map_comap_ofMvPolynomial_le hm.1
  -- Modulo `I * I` every element of `I` is a polynomial in `I`, so `I ≤ 𝔞 ⊔ I • I`.
  have hsq : I ≤ 𝔞 ⊔ I • I := by
    rw [Ideal.smul_eq_mul]
    exact le_map_comap_ofMvPolynomial_sup_mul fun f ↦
      isIntegral_quotient_mul_of_isIntegral_quotient f (Algebra.IsIntegral.isIntegral _)
        (Algebra.IsIntegral.isIntegral _)
  have hNak := Submodule.sup_eq_sup_smul_of_le_smul_of_le_jacobson (IsNoetherian.noetherian I)
    hjac hsq
  rw [Ideal.smul_eq_mul] at hNak
  exact le_sup_right.trans (hNak.trans_le (sup_le le_rfl Ideal.mul_le_left))

/-- An ideal of `K⟨X⟩†` with quotient integral over `K` is generated by finitely many
polynomials. -/
theorem exists_finset_span_ofMvPolynomial_eq_of_isIntegral (I : Ideal W)
    [Algebra.IsIntegral K (W ⧸ I)] :
    ∃ s : Finset (MvPolynomial σ K), Ideal.span (ofMvPolynomial σ K '' s) = I := by
  obtain ⟨s, hs⟩ := IsNoetherian.noetherian (I.comap (ofMvPolynomial σ K))
  rw [Ideal.submodule_span_eq] at hs
  refine ⟨s, ?_⟩
  rw [← Ideal.map_span, hs, map_comap_ofMvPolynomial_of_isIntegral]

/-- The polynomials in a maximal ideal `m` of `K⟨X⟩†` form a maximal ideal of `K[X]`. -/
theorem isMaximal_comap_ofMvPolynomial (m : Ideal W) [m.IsMaximal] :
    (m.comap (ofMvPolynomial σ K)).IsMaximal :=
  have : Module.Finite K (W ⧸ m) := finite_quotient_of_isMaximal (AlgHom.Finite.id K W) m
  isMaximal_comap_of_surjective_quotient_mk_comp _ <| by
    simpa only [AlgHom.coe_comp, Ideal.Quotient.mkₐ_eq_mk] using
      surjective_mkₐ_comp_ofMvPolynomial m

/-- **Maximal ideals of Monsky–Washnitzer algebras are generated by polynomials.** Every maximal
ideal `m` of `K⟨X₁, …, Xₙ⟩†` is generated by `m ∩ K[X]`. -/
theorem map_comap_ofMvPolynomial_of_isMaximal (m : Ideal W) [m.IsMaximal] :
    (m.comap (ofMvPolynomial σ K)).map (ofMvPolynomial σ K) = m :=
  have : Module.Finite K (W ⧸ m) := finite_quotient_of_isMaximal (AlgHom.Finite.id K W) m
  map_comap_ofMvPolynomial_of_isIntegral m

end Ideal
