module

public import TauCeti.RingTheory.Affinoid.MaximalSpectrum
public import TauCeti.RingTheory.Dagger.NoetherNormalization
public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.ClosedIdeal

import Mathlib.Analysis.Normed.Module.FiniteDimension
import TauCeti.Topology.Algebra.Ring.MaximalIdeals

/-!
# Maximal ideals of the Monsky–Washnitzer algebra and of the Tate algebra

Let `K` be a complete nontrivially normed ultrametric field, `T = K⟨X₁, …, Xₙ⟩` the Tate algebra
and `W = K⟨X₁, …, Xₙ⟩†` the Monsky–Washnitzer algebra, a dense subalgebra of `T`. This file shows
that `W` and `T` have the same classical points: contraction `m ↦ m ∩ W` is a bijection from the
maximal ideals of `T` onto those of `W`, whose inverse is extension `n ↦ n T`, and it preserves
residue fields, `W ⧸ (m ∩ W) ≅ T ⧸ m`.

The proof combines three facts.

* A proper ideal of `W` generates a proper ideal of `T`. Indeed `toTate` is a local homomorphism
  with dense image and the units of the complete ring `T` are open, so
  `Ideal.map_ne_top_of_denseRange` applies.
* Every ideal `J` of `T` is closed, so `T ⧸ J` is a normed `K`-space. If `W ⧸ (J ∩ W)` is finite
  over `K`, its image in `T ⧸ J` is a finite-dimensional, hence closed, subspace containing the
  dense image of `W`; so `W ⧸ (J ∩ W) → T ⧸ J` is bijective.
* Residue fields of `W` (`TauCeti.Dagger.washnitzerAlgebra.finite_quotient_of_isMaximal`) and of
  `T` (`TauCeti.IsAffinoidAlgebra.comap_isMaximal`) are finite over `K`.

## Main results

* `TauCeti.Dagger.washnitzerAlgebra.bijective_quotientMap_toTate_of_finite`: for an ideal `J` of
  `T` with `W ⧸ (J ∩ W)` finite over `K`, the induced map `W ⧸ (J ∩ W) → T ⧸ J` is bijective.
* `TauCeti.Dagger.washnitzerAlgebra.bijective_quotientMap_toTate`: in particular the residue
  fields of `W` at `m ∩ W` and of `T` at `m` agree, for every maximal ideal `m` of `T`.
* `TauCeti.Dagger.washnitzerAlgebra.isMaximal_map_toTate`: a maximal ideal `n` of `W` generates a
  maximal ideal of `T`, with `n T ∩ W = n` (`comap_map_toTate_of_isMaximal`); conversely every
  maximal ideal of `T` is generated by its contraction (`map_comap_toTate_of_isMaximal`).
* `TauCeti.Dagger.washnitzerAlgebra.existsUnique_isMaximal_comap`: every maximal ideal of `W` is
  the contraction of exactly one maximal ideal of `T`, and
  `TauCeti.Dagger.washnitzerAlgebra.bijective_maximalSpectrumComap_toTate`: contraction is a
  bijection of maximal spectra.

## References

* E. Grosse-Klönne, *Rigid analytic spaces with overconvergent structure sheaf*,
  J. reine angew. Math. 519 (2000), §1, Proposition 1.5 and its proof.
-/

public section

namespace TauCeti.Dagger.washnitzerAlgebra

open _root_.MvPowerSeries

variable {K σ : Type*}

local notation "W " σ:max => washnitzerAlgebra σ K
local notation "T " σ:max => IsRestricted.subring (R := K) (fun _ : σ ↦ (1 : ℝ))

section NormedField

variable [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- The ideal of the Tate algebra generated by a maximal ideal `n` of the Monsky–Washnitzer
algebra contracts back to `n`. -/
theorem comap_map_toTate_of_isMaximal (n : Ideal (W σ)) [hn : n.IsMaximal] :
    (n.map (toTate σ K)).comap (toTate σ K) = n :=
  (hn.eq_of_le (Ideal.comap_ne_top _ (Ideal.map_ne_top_of_denseRange Units.isOpen
    denseRange_toTate hn.ne_top)) Ideal.le_comap_map).symm

end NormedField

variable [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [Finite σ]

/-- **Finite quotients of the Monsky–Washnitzer algebra are quotients of the Tate algebra.** If
`J` is an ideal of the Tate algebra `T` whose contraction to `W` has a quotient finite over `K`,
then the induced map `W ⧸ (J ∩ W) → T ⧸ J` is bijective. -/
theorem bijective_quotientMap_toTate_of_finite (J : Ideal (T σ))
    [Module.Finite K (W σ ⧸ J.comap (toTate σ K))] :
    Function.Bijective (Ideal.quotientMapₐ J (toTate σ K) le_rfl) := by
  refine ⟨Ideal.quotientMap_injective, fun y ↦ ?_⟩
  let q := Ideal.quotientMapₐ J (toTate σ K) le_rfl
  -- The range of `q` is a finite-dimensional, hence closed, subspace of the Hausdorff
  -- topological `K`-vector space `T ⧸ J`, and it contains the dense image of `W`.
  have : ContinuousSMul K (T σ ⧸ J) := continuousSMul_of_algebraMap K (T σ ⧸ J) <| by
    rw [IsScalarTower.algebraMap_eq K (T σ) (T σ ⧸ J), RingHom.coe_comp,
      Ideal.Quotient.algebraMap_eq]
    exact continuous_quot_mk.comp (continuous_algebraMap K (T σ))
  have hclosed : IsClosed (LinearMap.range q.toLinearMap : Set (T σ ⧸ J)) :=
    Submodule.closed_of_finiteDimensional _
  have hdense : DenseRange (Ideal.Quotient.mk J ∘ toTate σ K) :=
    (Ideal.Quotient.mk_surjective (I := J)).denseRange.comp denseRange_toTate
      continuous_quotient_mk'
  have hsub : Set.range (Ideal.Quotient.mk J ∘ toTate σ K) ⊆
      (LinearMap.range q.toLinearMap : Set (T σ ⧸ J)) := by
    rintro _ ⟨f, rfl⟩
    exact ⟨Ideal.Quotient.mk _ f, rfl⟩
  exact (closure_minimal hsub hclosed) (hdense.closure_range ▸ Set.mem_univ y)

/-- **Residue fields of the Tate algebra are residue fields of the Monsky–Washnitzer algebra.**
For a maximal ideal `m` of the Tate algebra, the induced map `W ⧸ (m ∩ W) → T ⧸ m` is bijective. -/
theorem bijective_quotientMap_toTate (m : Ideal (T σ)) [m.IsMaximal] :
    Function.Bijective (Ideal.quotientMapₐ m (toTate σ K) le_rfl) := by
  have : (m.comap (toTate σ K)).IsMaximal := isAffinoidAlgebra_tate.comap_isMaximal _ m
  have : Module.Finite K (W σ ⧸ m.comap (toTate σ K)) :=
    finite_quotient_of_isMaximal (AlgHom.Finite.id K (W σ)) _
  exact bijective_quotientMap_toTate_of_finite m

/-- **A maximal ideal of the Monsky–Washnitzer algebra generates a maximal ideal of the Tate
algebra.** -/
theorem isMaximal_map_toTate (n : Ideal (W σ)) [hn : n.IsMaximal] :
    (n.map (toTate σ K)).IsMaximal := by
  set J := n.map (toTate σ K)
  have hJ : J.comap (toTate σ K) = n := comap_map_toTate_of_isMaximal n
  have : (J.comap (toTate σ K)).IsMaximal := hJ ▸ hn
  have : Module.Finite K (W σ ⧸ J.comap (toTate σ K)) :=
    finite_quotient_of_isMaximal (AlgHom.Finite.id K (W σ)) _
  -- `T ⧸ J` is isomorphic to the field `W ⧸ n`.
  let e := RingEquiv.ofBijective _ (bijective_quotientMap_toTate_of_finite J)
  exact Ideal.Quotient.maximal_of_isField J (e.symm.toMulEquiv.isField
    ((Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp ‹_›))

/-- **A maximal ideal of the Tate algebra is generated by its contraction** to the
Monsky–Washnitzer algebra. -/
theorem map_comap_toTate_of_isMaximal (m : Ideal (T σ)) [hm : m.IsMaximal] :
    (m.comap (toTate σ K)).map (toTate σ K) = m :=
  have : (m.comap (toTate σ K)).IsMaximal := isAffinoidAlgebra_tate.comap_isMaximal _ m
  (isMaximal_map_toTate _).eq_of_le hm.ne_top Ideal.map_comap_le

/-- **Maximal ideals of the Monsky–Washnitzer algebra.** Every maximal ideal `n` of `W` is the
contraction of exactly one maximal ideal of the Tate algebra, namely `n T`. -/
theorem existsUnique_isMaximal_comap (n : Ideal (W σ)) [n.IsMaximal] :
    ∃! m : Ideal (T σ), m.IsMaximal ∧ m.comap (toTate σ K) = n := by
  refine ⟨n.map (toTate σ K), ⟨isMaximal_map_toTate n, comap_map_toTate_of_isMaximal n⟩, ?_⟩
  rintro m ⟨hm, rfl⟩
  exact (map_comap_toTate_of_isMaximal m).symm

/-- **The Tate algebra and the Monsky–Washnitzer algebra have the same classical points**:
contraction of maximal ideals along `W → T` is a bijection of maximal spectra. -/
theorem bijective_maximalSpectrumComap_toTate :
    Function.Bijective (isAffinoidAlgebra_tate.maximalSpectrumComap (toTate σ K)) := by
  refine ⟨fun x y hxy ↦ ?_, fun n ↦ ?_⟩
  · have hxy := congrArg MaximalSpectrum.asIdeal hxy
    simp only [IsAffinoidAlgebra.maximalSpectrumComap_asIdeal] at hxy
    ext1
    rw [← map_comap_toTate_of_isMaximal x.asIdeal, ← map_comap_toTate_of_isMaximal y.asIdeal, hxy]
  · refine ⟨⟨_, isMaximal_map_toTate n.asIdeal⟩, MaximalSpectrum.ext ?_⟩
    simpa using comap_map_toTate_of_isMaximal n.asIdeal

end TauCeti.Dagger.washnitzerAlgebra
