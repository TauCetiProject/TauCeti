/-!
# Monsky–Washnitzer algebras are regular at their maximal ideals

Over a complete ultrametric normed field `K`, every maximal ideal `M` of the Monsky–Washnitzer
algebra `W = K⟨X₁, …, Xₙ⟩†` of overconvergent power series has height `n` and is generated by `n`
elements. Hence `W` is equidimensional of dimension `n`, and its localization at `M` is a regular
local ring of dimension `n`. These are the local statements behind the regularity of `W` in
Grosse-Klönne's comparison of `W` with the Tate algebra.

Both statements are proved by induction on the number of variables, writing `K⟨X, Y⟩†` for the
algebra in one more variable `Y`. A nonzero maximal ideal `M` of `K⟨X, Y⟩†` contains a nonzero
series, which a triangular change of variables makes distinguished in `Y`; by Weierstrass
preparation `M` then contains the evaluation at `Y` of a Weierstrass polynomial `ω ∈ K⟨X⟩†[Y]`,
monic and distinguished at unit radius. Weierstrass division identifies `K⟨X, Y⟩† ⧸ (ω)` with
`K⟨X⟩†[Y] ⧸ (ω)` (`TauCeti.Dagger.washnitzerAlgebra.polynomialQuotientEquiv`).

* *Heights.* `K⟨X⟩†[Y] ⧸ (ω)` is finite free over `K⟨X⟩†`, so going down holds for it. The image
  of `M` lies over a maximal ideal of `K⟨X⟩†`, of height `n` by induction, so it has height at
  least `n`; quotienting by the non-zero-divisor `ω` lowers heights by one, so `M` has height at
  least `n + 1`. The reverse bound is the Krull dimension
  `TauCeti.Dagger.washnitzerAlgebra.ringKrullDim_eq_natCard`.
* *Generators.* Division by `ω` shows that `M` is generated by the ideal `P` of polynomials in
  `K⟨X⟩†[Y]` it contains. Since `K⟨X⟩†` is a Jacobson ring, the contraction of the maximal ideal
  `P` to `K⟨X⟩†` is maximal, so `P` needs at most one generator more than that contraction, which
  needs at most `n` by induction.

## Main results

* `Ideal.height_eq_natCard_of_isMaximal_washnitzerAlgebra`: every maximal ideal of `K⟨X⟩†` in the
  variables `σ` has height `Nat.card σ`.
* `Ideal.spanFinrank_eq_natCard_of_isMaximal_washnitzerAlgebra`: every maximal ideal of `K⟨X⟩†`
  in the variables `σ` is minimally generated by `Nat.card σ` elements.
* `TauCeti.Dagger.washnitzerAlgebra.ringKrullDim_localization_atPrime_of_isMaximal`: the
  localization of `K⟨X⟩†` at a maximal ideal has Krull dimension `Nat.card σ`.
* `TauCeti.Dagger.washnitzerAlgebra.isRegularLocalRing_localization_atPrime_of_isMaximal`: that
  localization is a regular local ring.

## References

* E. Grosse-Klönne, *Rigid analytic spaces with overconvergent structure sheaf*,
  J. reine angew. Math. 519 (2000), §1, Proposition 1.5 and its proof.

The two inductions follow their Tate-algebra counterparts
`Ideal.height_eq_natCard_of_isMaximal_isRestricted_subring` and
`Ideal.spanFinrank_eq_natCard_of_isMaximal_isRestricted_subring`, using overconvergent
Weierstrass preparation and division in place of division in a complete Tate algebra.
-/

public section

namespace TauCeti.Dagger.washnitzerAlgebra

open _root_.MvPowerSeries

variable {K : Type*} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

local notation "W " σ:max => washnitzerAlgebra σ K
local notation "Tate " σ:max => IsRestricted.subring (R := K) (fun _ : σ ↦ (1 : ℝ))

/-- After a change of variables, a nonzero ideal of `K⟨X, Y⟩†` contains the evaluation at `Y` of
a monic polynomial `ω ∈ K⟨X⟩†[Y]` which is distinguished at unit radius. -/
private theorem exists_polynomialToOption_mem {σ : Type*} [Finite σ] (M : Ideal (W (Option σ)))
    (hM : M ≠ ⊥) : ∃ (E : W (Option σ) ≃+* W (Option σ)) (s : ℕ) (ω : Polynomial (W σ)),
      PowerSeries.IsDistinguished 1 s (ω.map (toTate σ K).toRingHom : PowerSeries (Tate σ)) ∧
        ω.IsMonicOfDegree s ∧ E (polynomialToOption ω) ∈ M := by
  obtain ⟨f, hfM, hf⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hM
  obtain ⟨α, hα, s, hd, hu⟩ := exists_triangularEquiv_isDistinguished_isUnit f hf
  let e := triangularEquiv (R := K) α hα
  obtain ⟨u, ω, hu', hm, hfac⟩ := exists_isUnit_isMonicOfDegree_mul_polynomialToOption_eq hd hu
  rw [← hfac, map_mul, map_mul, Subring.coe_mul,
    restrictedOptionEquiv_toTate_polynomialToOption] at hd
  refine ⟨e.toRingEquiv.symm, s, ω, hd.of_isUnit_mul one_pos
    ((hu'.map (toTate _ K)).map restrictedOptionEquiv.toRingHom), hm, ?_⟩
  have hω : polynomialToOption ω = ↑hu'.unit⁻¹ * e f := by
    rw [← hfac, ← mul_assoc, IsUnit.val_inv_mul, one_mul]
  rw [hω, map_mul, AlgEquiv.toRingEquiv_symm, AlgEquiv.coe_toRingEquiv, e.symm_apply_apply]
  exact M.mul_mem_left _ hfM

open scoped nonZeroDivisors in
/-- The inductive step for heights: if every maximal ideal of `K⟨X⟩†` has height at least the
number `n` of variables, then every maximal ideal of `K⟨X, Y⟩†` has height at least `n + 1`. -/
private theorem natCard_add_one_le_height_option {σ : Type*} [Finite σ]
    (IH : ∀ (p : Ideal (W σ)) [p.IsMaximal], Nat.card σ ≤ p.height)
    (M : Ideal (W (Option σ))) [M.IsMaximal] : Nat.card (Option σ) ≤ M.height := by
  -- `M ≠ 0`, since `K⟨X, Y⟩†` has positive dimension and so is not a field.
  have hM : M ≠ ⊥ := by
    rintro rfl
    have := ringKrullDim_eq_zero_of_isField (Ring.isField_iff_maximal_bot.mpr ‹_›)
    rw [ringKrullDim_eq_natCard, Finite.card_option] at this
    exact Nat.succ_ne_zero (Nat.card σ) (by exact_mod_cast this)
  obtain ⟨E, s, ω, hd, hm, hωM⟩ := exists_polynomialToOption_mem M hM
  let N : Ideal (W (Option σ)) := M.comap E
  have : N.IsMaximal := Ideal.comap_isMaximal_of_surjective E E.surjective
  -- `K⟨X, Y⟩† ⧸ (ω) ≅ K⟨X⟩†[Y] ⧸ (ω)` is finite free over `K⟨X⟩†`, so it is integral with going
  -- down; as `ω` is a non-zero-divisor, `N` has height at least one more than some maximal ideal
  -- of `K⟨X⟩†`.
  have : Module.Free (W σ) (AdjoinRoot ω) := hm.monic.free_adjoinRoot
  have : Module.Finite (W σ) (AdjoinRoot ω) := hm.monic.finite_adjoinRoot
  have : Algebra.IsIntegral (W σ) (AdjoinRoot ω) := Algebra.IsIntegral.of_finite _ _
  have hg : polynomialToOption ω ∈ (W (Option σ))⁰ :=
    mem_nonZeroDivisors_of_ne_zero fun h ↦ hm.ne_zero (polynomialToOption_injective (by simpa))
  obtain ⟨p, _, hp⟩ := N.exists_isMaximal_height_add_one_le_of_ringEquiv_quotient (R := W σ)
    (Ideal.mem_comap.mpr hωM) hg (polynomialQuotientEquiv hd hm).toRingEquiv
  rw [← RingEquiv.height_comap E M, Finite.card_option, Nat.cast_add, Nat.cast_one]
  exact le_trans (by gcongr; exact IH p) hp

/-- The inductive step for generators: if every maximal ideal of `K⟨X⟩†` is generated by `n`
elements, where `n` is the number of variables, then every maximal ideal of `K⟨X, Y⟩†` is
generated by `n + 1` elements. -/
private theorem spanFinrank_le_natCard_option {σ : Type*} [Finite σ]
    (IH : ∀ (p : Ideal (W σ)) [p.IsMaximal], p.spanFinrank ≤ Nat.card σ)
    (M : Ideal (W (Option σ))) [M.IsMaximal] : M.spanFinrank ≤ Nat.card (Option σ) := by
  rcases eq_or_ne M ⊥ with rfl | hM
  · simp
  obtain ⟨E, s, ω, hd, hm, hωM⟩ := exists_polynomialToOption_mem M hM
  rw [← Ideal.map_comap_of_surjective E E.surjective M, Ideal.spanFinrank_map_eq_of_ringEquiv]
  set N : Ideal (W (Option σ)) := M.comap E
  have : N.IsMaximal := Ideal.comap_isMaximal_of_surjective E E.surjective
  have hωN : polynomialToOption ω ∈ N := Ideal.mem_comap.mpr hωM
  -- Every series is congruent modulo `ω ∈ N` to a polynomial in `Y`, so `N` is generated by
  -- the ideal `P` of polynomials it contains, and `K⟨X⟩†[Y] ⧸ P ≅ K⟨X, Y⟩† ⧸ N`.
  let φ : Polynomial (W σ) →+* W (Option σ) := polynomialToOption
  let P : Ideal (Polynomial (W σ)) := N.comap φ
  have hNP : P.map φ = N := by
    refine le_antisymm Ideal.map_comap_le fun f hf ↦ ?_
    obtain ⟨q, r, -, rfl⟩ := exists_mul_add_polynomialToOption_eq hd hm f
    have hr : r ∈ P := by
      simpa [P, φ] using N.sub_mem hf (N.mul_mem_left q hωN)
    exact Ideal.add_mem _
      (Ideal.mul_mem_left _ q (Ideal.mem_map_of_mem φ (Ideal.mem_comap.mpr hωN)))
      (Ideal.mem_map_of_mem φ hr)
  have hsurj : Function.Surjective ((Ideal.Quotient.mk N).comp φ) := fun x ↦ by
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨q, r, -, rfl⟩ := exists_mul_add_polynomialToOption_eq hd hm f
    refine ⟨r, Ideal.Quotient.eq.mpr ?_⟩
    simpa [φ] using N.neg_mem (N.mul_mem_left q hωN)
  have : P.IsMaximal := by
    let := Ideal.Quotient.field N
    have hker : P = RingHom.ker ((Ideal.Quotient.mk N).comp φ) := by
      ext r
      simp [P, RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
    exact hker ▸ RingHom.ker_isMaximal_of_surjective _ hsurj
  -- As `K⟨X⟩†` is a Jacobson ring, `P` lies over a maximal ideal `p` of `K⟨X⟩†`; so `P` needs at
  -- most one generator more than `p`, which needs at most `n` by induction.
  have hP := Polynomial.isMaximal_comap_C_of_isJacobsonRing P
  rw [← hNP, Finite.card_option]
  refine (Ideal.spanFinrank_map_le_of_fg φ (IsNoetherian.noetherian P)).trans <|
    (Polynomial.spanFinrank_le_spanFinrank_comap_C_add_one P hP
      (IsNoetherian.noetherian _)).trans ?_
  gcongr
  exact IH _

/-- Every maximal ideal of `K⟨X⟩†` in the variables `σ` is generated by `Nat.card σ` elements. -/
private theorem spanFinrank_le_natCard_of_isMaximal {σ : Type*} [Finite σ]
    (M : Ideal (W σ)) [M.IsMaximal] : M.spanFinrank ≤ Nat.card σ := by
  revert M
  induction σ using Finite.induction_empty_option with
  | of_equiv e H =>
    intro M _
    let e' : W _ ≃+* W _ := (renameAlgEquiv (R := K) e).toRingEquiv
    have := H (M.comap e')
    rwa [← Ideal.map_symm, Ideal.spanFinrank_map_eq_of_ringEquiv, Nat.card_congr e] at this
  | h_empty =>
    intro M _
    -- Without variables, `K⟨X⟩†` is a quotient of the field `K`, so `M` is zero.
    rw [← Ideal.map_comap_of_surjective _ algebraMap_surjective M,
      Ideal.eq_bot_of_prime (M.comap (algebraMap K (W PEmpty))), Ideal.map_bot]
    simp
  | h_option IH => exact spanFinrank_le_natCard_option IH

end TauCeti.Dagger.washnitzerAlgebra

namespace Ideal

open TauCeti.Dagger

variable {K : Type*} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- **Heights of maximal ideals of Monsky–Washnitzer algebras.** Over a complete ultrametric
normed field, every maximal ideal of `K⟨X₁, …, Xₙ⟩†` has height `n`, its Krull dimension. -/
@[simp]
theorem height_eq_natCard_of_isMaximal_washnitzerAlgebra {σ : Type*} [Finite σ]
    (M : Ideal (washnitzerAlgebra σ K)) [M.IsMaximal] : M.height = Nat.card σ := by
  refine le_antisymm ?_ ?_
  · have := Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top' (I := M))
    rw [washnitzerAlgebra.ringKrullDim_eq_natCard] at this
    exact_mod_cast this
  revert M
  induction σ using Finite.induction_empty_option with
  | of_equiv e H =>
    intro M _
    let e' : washnitzerAlgebra _ K ≃+* washnitzerAlgebra _ K :=
      (washnitzerAlgebra.renameAlgEquiv (R := K) e).toRingEquiv
    have := H (M.comap e')
    rwa [RingEquiv.height_comap, Nat.card_congr e] at this
  | h_empty => simp
  | h_option IH => exact washnitzerAlgebra.natCard_add_one_le_height_option IH

/-- **Generators of maximal ideals of Monsky–Washnitzer algebras.** Over a complete ultrametric
normed field, every maximal ideal of `K⟨X₁, …, Xₙ⟩†` is generated by `n` elements, and by no
fewer, since it has height `n`. -/
@[simp]
theorem spanFinrank_eq_natCard_of_isMaximal_washnitzerAlgebra {σ : Type*} [Finite σ]
    (M : Ideal (washnitzerAlgebra σ K)) [M.IsMaximal] : M.spanFinrank = Nat.card σ := by
  refine le_antisymm (washnitzerAlgebra.spanFinrank_le_natCard_of_isMaximal M) ?_
  have := M.height_le_spanFinrank Ideal.IsPrime.ne_top'
  rw [height_eq_natCard_of_isMaximal_washnitzerAlgebra] at this
  exact_mod_cast this

end Ideal

namespace TauCeti.Dagger.washnitzerAlgebra

variable {K : Type*} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- **Monsky–Washnitzer algebras are equidimensional.** The localization of `K⟨X₁, …, Xₙ⟩†` at
any maximal ideal has Krull dimension `n`. -/
@[simp]
theorem ringKrullDim_localization_atPrime_of_isMaximal {σ : Type*} [Finite σ]
    (M : Ideal (washnitzerAlgebra σ K)) [M.IsMaximal] :
    ringKrullDim (Localization.AtPrime M) = Nat.card σ := by
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height M (Localization.AtPrime M),
    Ideal.height_eq_natCard_of_isMaximal_washnitzerAlgebra]
  norm_cast

/-- **Monsky–Washnitzer algebras are regular at their maximal ideals.** Over a complete ultrametric
normed field, the localization of `K⟨X₁, …, Xₙ⟩†` at a maximal ideal is a regular local ring of
dimension `n`: its maximal ideal is generated by `n` elements. -/
instance isRegularLocalRing_localization_atPrime_of_isMaximal {σ : Type*} [Finite σ]
    (M : Ideal (washnitzerAlgebra σ K)) [M.IsMaximal] :
    IsRegularLocalRing (Localization.AtPrime M) := by
  apply M.isRegularLocalRing_localization_atPrime_of_spanFinrank_le_height
  simp

end TauCeti.Dagger.washnitzerAlgebra
