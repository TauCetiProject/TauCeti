public import Mathlib.RingTheory.TensorProduct.Finite
public import TauCeti.RingTheory.Dagger.DaggerAlgebra.WeakCompleteness
public import TauCeti.RingTheory.Dagger.FiniteExtension

/-!
# The dagger tensor product of dagger algebras

Let `K` be a complete nontrivially normed ultrametric field, and let `A₁`, `A₂` be `K`-dagger
algebras which are algebras over a common commutative ring `B`. The *dagger tensor product*
`A₁ ⊗†_B A₂` is the pushout of `B → A₁` and `B → A₂` in the category of `K`-dagger algebras.
The algebraic tensor product `A₁ ⊗[B] A₂` is in general not a dagger algebra: already
`K⟨X⟩† ⊗[K] K⟨Y⟩†` is a proper subalgebra of `K⟨X, Y⟩†`. The dagger tensor product replaces it.

## Construction

Choose presentations `π₁ : W_{σ₁} ↠ A₁` and `π₂ : W_{σ₂} ↠ A₂` by Monsky–Washnitzer algebras
(here the chosen minimal presentations `TauCeti.Dagger.presentation`). Then
`A₁ ⊗†_B A₂ = W_{σ₁ ⊕ σ₂} ⧸ J`, where `J` is generated by the differences `f - g` of a series
`f` in the first block of variables and a series `g` in the second block whose images
`π₁ f ∈ A₁` and `π₂ g ∈ A₂` come from the same element of `B`. Taking that element to be `0`
shows that `J` contains both presentation kernels.

The universal property rests on weak completeness of the target
(`TauCeti.Dagger.washnitzerAlgebra.lift`). Given `K`-algebra homomorphisms `u₁ : A₁ → C` and
`u₂ : A₂ → C` into a dagger algebra `C` that agree on `B`, the elements `u₁ (π₁ Xᵢ)` and
`u₂ (π₂ Yⱼ)` have supremum seminorm at most `1`, so there is a unique homomorphism
`W_{σ₁ ⊕ σ₂} → C` sending the variables to them. Restricted to either block of variables it is
`u₁ ∘ π₁`, resp. `u₂ ∘ π₂`, since homomorphisms into a dagger algebra are determined by the
variables (`TauCeti.Dagger.washnitzerAlgebra.algHom_ext`). Hence it kills `J`. No continuity is
imposed anywhere.

## Main definitions

* `TauCeti.Dagger.DaggerTensorProduct K B A₁ A₂`: the dagger tensor product `A₁ ⊗†_B A₂`, a
  `K`-dagger algebra, the quotient of `W_{σ₁ ⊕ σ₂}` by
  `TauCeti.Dagger.DaggerTensorProduct.relIdeal`.
* `TauCeti.Dagger.DaggerTensorProduct.inl`, `TauCeti.Dagger.DaggerTensorProduct.inr`: the
  inclusions of `A₁` and `A₂`.
* `TauCeti.Dagger.DaggerTensorProduct.lift`: the homomorphism `A₁ ⊗†_B A₂ → C` into a dagger
  algebra induced by two homomorphisms agreeing on `B`, and
  `TauCeti.Dagger.DaggerTensorProduct.liftEquiv`: the universal property as an equivalence.
* `TauCeti.Dagger.DaggerTensorProduct.map`: functoriality in the diagram `A₁ ← B → A₂`.
* `TauCeti.Dagger.DaggerTensorProduct.washnitzerAlgebraEquiv`: `W_{σ₁} ⊗†_K W_{σ₂} ≃ W_{σ₁ ⊕ σ₂}`.
* `TauCeti.Dagger.DaggerTensorProduct.ofTensorProduct`: the comparison map
  `A₁ ⊗[B] A₂ → A₁ ⊗†_B A₂`, and `TauCeti.Dagger.DaggerTensorProduct.tensorProductAlgEquiv`: it
  is an isomorphism when `A₁ ⊗[B] A₂` is already a dagger algebra.

## Main results

* `TauCeti.Dagger.DaggerTensorProduct.inl_algebraMap`: the two inclusions agree on `B`.
* `TauCeti.Dagger.DaggerTensorProduct.lift_inl`, `TauCeti.Dagger.DaggerTensorProduct.lift_inr`,
  `TauCeti.Dagger.DaggerTensorProduct.algHom_ext`: the universal property of the pushout.
* `TauCeti.Dagger.DaggerTensorProduct.map_id`, `TauCeti.Dagger.DaggerTensorProduct.map_comp`.

## References

* E. Grosse-Klönne, *Rigid analytic spaces with overconvergent structure sheaf*,
  J. reine angew. Math. 519 (2000), §1, 1.16.
* K. S. Kedlaya, *Finiteness of rigid cohomology with coefficients*, Duke Math. J. 134 (2006),
  §2.3, Definition 2.3.8.
-/

public section

namespace TauCeti.Dagger

open washnitzerAlgebra (X rename rename_X)

open scoped TensorProduct

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]

local notation "W " σ:max => washnitzerAlgebra σ K

section Relations

variable (B : Type*) [CommRing B]
  {A₁ : Type*} [CommRing A₁] [Algebra K A₁] [Algebra B A₁]
  {A₂ : Type*} [CommRing A₂] [Algebra K A₂] [Algebra B A₂]
  {σ₁ σ₂ : Type*} [Finite σ₁] [Finite σ₂]

/-- The **relations of the dagger tensor product** for presentations `π₁ : W_{σ₁} → A₁` and
`π₂ : W_{σ₂} → A₂`: the ideal of `K⟨X, Y⟩† = W_{σ₁ ⊕ σ₂}` generated by the differences `f - g` of a
series `f` in the first block of variables and a series `g` in the second block whose images
`π₁ f` and `π₂ g` come from the same element of `B`. -/
noncomputable def DaggerTensorProduct.relIdeal (π₁ : W σ₁ →ₐ[K] A₁) (π₂ : W σ₂ →ₐ[K] A₂) :
    Ideal (W (σ₁ ⊕ σ₂)) :=
  Ideal.span {p | ∃ f g b, π₁ f = algebraMap B A₁ b ∧ π₂ g = algebraMap B A₂ b ∧
    rename Sum.inl f - rename Sum.inr g = p}

variable {B}

private theorem rename_inl_mem_relIdeal {π₁ : W σ₁ →ₐ[K] A₁} (π₂ : W σ₂ →ₐ[K] A₂) {f : W σ₁}
    (hf : π₁ f = 0) : rename Sum.inl f ∈ DaggerTensorProduct.relIdeal B π₁ π₂ :=
  Ideal.subset_span ⟨f, 0, 0, by simp [hf], by simp, by simp⟩

private theorem rename_inr_mem_relIdeal (π₁ : W σ₁ →ₐ[K] A₁) {π₂ : W σ₂ →ₐ[K] A₂} {g : W σ₂}
    (hg : π₂ g = 0) : rename Sum.inr g ∈ DaggerTensorProduct.relIdeal B π₁ π₂ := by
  have : rename Sum.inl (0 : W σ₁) - rename Sum.inr g ∈ DaggerTensorProduct.relIdeal B π₁ π₂ :=
    Ideal.subset_span ⟨0, g, 0, by simp, by simp [hg], rfl⟩
  simpa using neg_mem this

variable {C : Type*} [CommRing C] [Algebra K C] [IsDaggerAlgebra K C]

/-- The homomorphism `W_{σ₁ ⊕ σ₂} → C` sending the variables to the images of the variables
under `u₁ ∘ π₁` and `u₂ ∘ π₂`. -/
private noncomputable def liftW (π₁ : W σ₁ →ₐ[K] A₁) (π₂ : W σ₂ →ₐ[K] A₂) (u₁ : A₁ →ₐ[K] C)
    (u₂ : A₂ →ₐ[K] C) : W (σ₁ ⊕ σ₂) →ₐ[K] C :=
  washnitzerAlgebra.lift (Sum.elim (fun i ↦ u₁ (π₁ (X σ₁ K i))) fun j ↦ u₂ (π₂ (X σ₂ K j))) fun
    | .inl i => washnitzerAlgebra.supSeminorm_apply_X_le_one (u₁.comp π₁) i
    | .inr j => washnitzerAlgebra.supSeminorm_apply_X_le_one (u₂.comp π₂) j

private theorem liftW_rename_inl (π₁ : W σ₁ →ₐ[K] A₁) (π₂ : W σ₂ →ₐ[K] A₂) (u₁ : A₁ →ₐ[K] C)
    (u₂ : A₂ →ₐ[K] C) (f : W σ₁) : liftW π₁ π₂ u₁ u₂ (rename Sum.inl f) = u₁ (π₁ f) := by
  have : (liftW π₁ π₂ u₁ u₂).comp (rename Sum.inl) = u₁.comp π₁ :=
    washnitzerAlgebra.algHom_ext fun i ↦ by simp [liftW]
  exact AlgHom.congr_fun this f

private theorem liftW_rename_inr (π₁ : W σ₁ →ₐ[K] A₁) (π₂ : W σ₂ →ₐ[K] A₂) (u₁ : A₁ →ₐ[K] C)
    (u₂ : A₂ →ₐ[K] C) (g : W σ₂) : liftW π₁ π₂ u₁ u₂ (rename Sum.inr g) = u₂ (π₂ g) := by
  have : (liftW π₁ π₂ u₁ u₂).comp (rename Sum.inr) = u₂.comp π₂ :=
    washnitzerAlgebra.algHom_ext fun i ↦ by simp [liftW]
  exact AlgHom.congr_fun this g

private theorem liftW_eq_zero_of_mem_relIdeal (π₁ : W σ₁ →ₐ[K] A₁) (π₂ : W σ₂ →ₐ[K] A₂)
    {u₁ : A₁ →ₐ[K] C} {u₂ : A₂ →ₐ[K] C}
    (h : ∀ b : B, u₁ (algebraMap B A₁ b) = u₂ (algebraMap B A₂ b))
    {p : W (σ₁ ⊕ σ₂)} (hp : p ∈ DaggerTensorProduct.relIdeal B π₁ π₂) :
    liftW π₁ π₂ u₁ u₂ p = 0 := by
  refine Ideal.span_le (I := RingHom.ker (liftW π₁ π₂ u₁ u₂)).mpr ?_ hp
  rintro _ ⟨f, g, b, hf, hg, rfl⟩
  simp [liftW_rename_inl, liftW_rename_inr, hf, hg, h]

end Relations

variable (K) (B : Type*) [CommRing B]
  (A₁ : Type*) [CommRing A₁] [Algebra K A₁] [Algebra B A₁] [IsDaggerAlgebra K A₁]
  (A₂ : Type*) [CommRing A₂] [Algebra K A₂] [Algebra B A₂] [IsDaggerAlgebra K A₂]

/-- The **dagger tensor product** `A₁ ⊗†_B A₂` of two `K`-dagger algebras over a common ring
`B`: the pushout of `B → A₁` and `B → A₂` in the category of `K`-dagger algebras. It is
constructed as the quotient of `K⟨X, Y⟩†`, in the variables of the chosen presentations of `A₁`
and `A₂`, by the relations identifying the two images of every element of `B`. -/
@[expose]
def DaggerTensorProduct : Type _ :=
  W (Fin (presentationDim K A₁) ⊕ Fin (presentationDim K A₂)) ⧸
    DaggerTensorProduct.relIdeal B (presentation K A₁) (presentation K A₂)

namespace DaggerTensorProduct

noncomputable instance : CommRing (DaggerTensorProduct K B A₁ A₂) :=
  Ideal.Quotient.commRing _

noncomputable instance : Algebra K (DaggerTensorProduct K B A₁ A₂) :=
  Ideal.Quotient.algebra K

/-- The dagger tensor product of two dagger algebras is a dagger algebra. -/
instance : IsDaggerAlgebra K (DaggerTensorProduct K B A₁ A₂) :=
  IsDaggerAlgebra.quotient (A := W (Fin (presentationDim K A₁) ⊕ Fin (presentationDim K A₂))) _

/-- The quotient map from `K⟨X, Y⟩†` onto the dagger tensor product. -/
private noncomputable def mkₐ :
    W (Fin (presentationDim K A₁) ⊕ Fin (presentationDim K A₂)) →ₐ[K]
      DaggerTensorProduct K B A₁ A₂ :=
  Ideal.Quotient.mkₐ K _

variable {K B A₁ A₂} in
private theorem mkₐ_eq_mkₐ_iff {p q : W (Fin (presentationDim K A₁) ⊕ Fin (presentationDim K A₂))} :
    mkₐ K B A₁ A₂ p = mkₐ K B A₁ A₂ q ↔
      p - q ∈ relIdeal B (presentation K A₁) (presentation K A₂) :=
  Ideal.Quotient.eq

variable {K B A₁ A₂} in
private theorem algHom_ext_mkₐ {C : Type*} [CommRing C] [Algebra K C]
    {φ ψ : DaggerTensorProduct K B A₁ A₂ →ₐ[K] C}
    (h : φ.comp (mkₐ K B A₁ A₂) = ψ.comp (mkₐ K B A₁ A₂)) : φ = ψ :=
  Ideal.Quotient.algHom_ext K h

/-- The inclusion `A₁ → A₁ ⊗†_B A₂` of the first factor. -/
noncomputable def inl : A₁ →ₐ[K] DaggerTensorProduct K B A₁ A₂ :=
  (presentation K A₁).liftOfSurjective (presentation_surjective K A₁)
    ((mkₐ K B A₁ A₂).comp (rename Sum.inl)) fun _ hf ↦
      Ideal.Quotient.eq_zero_iff_mem.mpr (rename_inl_mem_relIdeal (presentation K A₂) hf)

/-- The inclusion `A₂ → A₁ ⊗†_B A₂` of the second factor. -/
noncomputable def inr : A₂ →ₐ[K] DaggerTensorProduct K B A₁ A₂ :=
  (presentation K A₂).liftOfSurjective (presentation_surjective K A₂)
    ((mkₐ K B A₁ A₂).comp (rename Sum.inr)) fun _ hg ↦
      Ideal.Quotient.eq_zero_iff_mem.mpr (rename_inr_mem_relIdeal (presentation K A₁) hg)

variable {K B A₁ A₂}

private theorem inl_presentation (f : W (Fin (presentationDim K A₁))) :
    inl K B A₁ A₂ (presentation K A₁ f) = mkₐ K B A₁ A₂ (rename Sum.inl f) :=
  AlgHom.liftOfSurjective_apply _ _ _ _ f

private theorem inr_presentation (g : W (Fin (presentationDim K A₂))) :
    inr K B A₁ A₂ (presentation K A₂ g) = mkₐ K B A₁ A₂ (rename Sum.inr g) :=
  AlgHom.liftOfSurjective_apply _ _ _ _ g

/-- The two inclusions agree on the image of `B`. -/
theorem inl_algebraMap (b : B) :
    inl K B A₁ A₂ (algebraMap B A₁ b) = inr K B A₁ A₂ (algebraMap B A₂ b) := by
  obtain ⟨f, hf⟩ := presentation_surjective K A₁ (algebraMap B A₁ b)
  obtain ⟨g, hg⟩ := presentation_surjective K A₂ (algebraMap B A₂ b)
  rw [← hf, ← hg, inl_presentation, inr_presentation, mkₐ_eq_mkₐ_iff]
  exact Ideal.subset_span ⟨f, g, b, hf, hg, rfl⟩

/-- The two inclusions agree on `B`, as ring homomorphisms. -/
theorem inl_comp_algebraMap :
    (inl K B A₁ A₂).toRingHom.comp (algebraMap B A₁) =
      (inr K B A₁ A₂).toRingHom.comp (algebraMap B A₂) :=
  RingHom.ext inl_algebraMap

section Lift

variable {C : Type*} [CommRing C] [Algebra K C] [IsDaggerAlgebra K C]

/-- **The universal property of the dagger tensor product.** Two `K`-algebra homomorphisms
`u₁ : A₁ → C` and `u₂ : A₂ → C` into a dagger algebra which agree on `B` induce a homomorphism
`A₁ ⊗†_B A₂ → C`. No continuity is assumed. -/
noncomputable def lift (u₁ : A₁ →ₐ[K] C) (u₂ : A₂ →ₐ[K] C)
    (h : ∀ b : B, u₁ (algebraMap B A₁ b) = u₂ (algebraMap B A₂ b)) :
    DaggerTensorProduct K B A₁ A₂ →ₐ[K] C :=
  Ideal.Quotient.liftₐ _ (liftW (presentation K A₁) (presentation K A₂) u₁ u₂) fun _ hp ↦
    liftW_eq_zero_of_mem_relIdeal _ _ h hp

private theorem lift_mkₐ (u₁ : A₁ →ₐ[K] C) (u₂ : A₂ →ₐ[K] C)
    (h : ∀ b : B, u₁ (algebraMap B A₁ b) = u₂ (algebraMap B A₂ b))
    (p : W (Fin (presentationDim K A₁) ⊕ Fin (presentationDim K A₂))) :
    lift u₁ u₂ h (mkₐ K B A₁ A₂ p) = liftW (presentation K A₁) (presentation K A₂) u₁ u₂ p :=
  Ideal.Quotient.liftₐ_apply _ _ _ _

@[simp]
theorem lift_inl (u₁ : A₁ →ₐ[K] C) (u₂ : A₂ →ₐ[K] C)
    (h : ∀ b : B, u₁ (algebraMap B A₁ b) = u₂ (algebraMap B A₂ b)) (a : A₁) :
    lift u₁ u₂ h (inl K B A₁ A₂ a) = u₁ a := by
  obtain ⟨f, rfl⟩ := presentation_surjective K A₁ a
  rw [inl_presentation, lift_mkₐ, liftW_rename_inl]

@[simp]
theorem lift_inr (u₁ : A₁ →ₐ[K] C) (u₂ : A₂ →ₐ[K] C)
    (h : ∀ b : B, u₁ (algebraMap B A₁ b) = u₂ (algebraMap B A₂ b)) (a : A₂) :
    lift u₁ u₂ h (inr K B A₁ A₂ a) = u₂ a := by
  obtain ⟨g, rfl⟩ := presentation_surjective K A₂ a
  rw [inr_presentation, lift_mkₐ, liftW_rename_inr]

@[simp]
theorem lift_comp_inl (u₁ : A₁ →ₐ[K] C) (u₂ : A₂ →ₐ[K] C)
    (h : ∀ b : B, u₁ (algebraMap B A₁ b) = u₂ (algebraMap B A₂ b)) :
    (lift u₁ u₂ h).comp (inl K B A₁ A₂) = u₁ :=
  AlgHom.ext (lift_inl u₁ u₂ h)

@[simp]
theorem lift_comp_inr (u₁ : A₁ →ₐ[K] C) (u₂ : A₂ →ₐ[K] C)
    (h : ∀ b : B, u₁ (algebraMap B A₁ b) = u₂ (algebraMap B A₂ b)) :
    (lift u₁ u₂ h).comp (inr K B A₁ A₂) = u₂ :=
  AlgHom.ext (lift_inr u₁ u₂ h)

/-- Homomorphisms from the dagger tensor product into a dagger algebra are determined by their
restrictions to the two factors. -/
@[ext]
theorem algHom_ext {φ ψ : DaggerTensorProduct K B A₁ A₂ →ₐ[K] C}
    (h₁ : φ.comp (inl K B A₁ A₂) = ψ.comp (inl K B A₁ A₂))
    (h₂ : φ.comp (inr K B A₁ A₂) = ψ.comp (inr K B A₁ A₂)) : φ = ψ := by
  refine algHom_ext_mkₐ (washnitzerAlgebra.algHom_ext fun k ↦ ?_)
  rcases k with i | j
  · rw [AlgHom.comp_apply, AlgHom.comp_apply, ← rename_X Sum.inl, ← inl_presentation]
    exact AlgHom.congr_fun h₁ _
  · rw [AlgHom.comp_apply, AlgHom.comp_apply, ← rename_X Sum.inr, ← inr_presentation]
    exact AlgHom.congr_fun h₂ _

theorem lift_unique {u₁ : A₁ →ₐ[K] C} {u₂ : A₂ →ₐ[K] C}
    {h : ∀ b : B, u₁ (algebraMap B A₁ b) = u₂ (algebraMap B A₂ b)}
    (φ : DaggerTensorProduct K B A₁ A₂ →ₐ[K] C) (h₁ : φ.comp (inl K B A₁ A₂) = u₁)
    (h₂ : φ.comp (inr K B A₁ A₂) = u₂) : φ = lift u₁ u₂ h :=
  algHom_ext (by rw [h₁, lift_comp_inl]) (by rw [h₂, lift_comp_inr])

@[simp]
theorem lift_comp_inl_inr (φ : DaggerTensorProduct K B A₁ A₂ →ₐ[K] C) :
    lift (φ.comp (inl K B A₁ A₂)) (φ.comp (inr K B A₁ A₂))
      (fun b ↦ by simp [inl_algebraMap]) = φ :=
  (lift_unique φ rfl rfl).symm

variable (K B A₁ A₂ C) in
/-- **The universal property of the dagger tensor product**, as an equivalence: homomorphisms
`A₁ ⊗†_B A₂ → C` into a dagger algebra are the pairs of homomorphisms `A₁ → C`, `A₂ → C`
agreeing on `B`. -/
noncomputable def liftEquiv :
    {u : (A₁ →ₐ[K] C) × (A₂ →ₐ[K] C) //
      ∀ b : B, u.fst (algebraMap B A₁ b) = u.snd (algebraMap B A₂ b)}
      ≃ (DaggerTensorProduct K B A₁ A₂ →ₐ[K] C) where
  toFun u := lift u.val.fst u.val.snd u.property
  invFun φ := ⟨(φ.comp (inl K B A₁ A₂), φ.comp (inr K B A₁ A₂)), fun b ↦ by
    simp [inl_algebraMap]⟩
  left_inv u := by ext <;> simp
  right_inv φ := by simp

@[simp]
theorem liftEquiv_apply
    (u : {u : (A₁ →ₐ[K] C) × (A₂ →ₐ[K] C) //
      ∀ b : B, u.fst (algebraMap B A₁ b) = u.snd (algebraMap B A₂ b)}) :
    liftEquiv K B A₁ A₂ C u = lift u.val.fst u.val.snd u.property :=
  (rfl)

@[simp]
theorem liftEquiv_symm_apply (φ : DaggerTensorProduct K B A₁ A₂ →ₐ[K] C) :
    ((liftEquiv K B A₁ A₂ C).symm φ : (A₁ →ₐ[K] C) × (A₂ →ₐ[K] C)) =
      (φ.comp (inl K B A₁ A₂), φ.comp (inr K B A₁ A₂)) :=
  (rfl)

end Lift

section Map

variable {B' : Type*} [CommRing B']
  {A₁' : Type*} [CommRing A₁'] [Algebra K A₁'] [Algebra B' A₁'] [IsDaggerAlgebra K A₁']
  {A₂' : Type*} [CommRing A₂'] [Algebra K A₂'] [Algebra B' A₂'] [IsDaggerAlgebra K A₂']

/-- **Functoriality of the dagger tensor product.** A morphism of diagrams `A₁ ← B → A₂` to
`A₁' ← B' → A₂'`, consisting of a ring homomorphism `ψ : B → B'` and `K`-algebra homomorphisms
`φ₁ : A₁ → A₁'`, `φ₂ : A₂ → A₂'` compatible with the structure maps, induces
`A₁ ⊗†_B A₂ → A₁' ⊗†_{B'} A₂'`. -/
noncomputable def map (ψ : B →+* B') (φ₁ : A₁ →ₐ[K] A₁') (φ₂ : A₂ →ₐ[K] A₂')
    (h₁ : ∀ b, φ₁ (algebraMap B A₁ b) = algebraMap B' A₁' (ψ b))
    (h₂ : ∀ b, φ₂ (algebraMap B A₂ b) = algebraMap B' A₂' (ψ b)) :
    DaggerTensorProduct K B A₁ A₂ →ₐ[K] DaggerTensorProduct K B' A₁' A₂' :=
  lift ((inl K B' A₁' A₂').comp φ₁) ((inr K B' A₁' A₂').comp φ₂) fun b ↦ by
    simp [h₁, h₂, inl_algebraMap]

@[simp]
theorem map_inl (ψ : B →+* B') (φ₁ : A₁ →ₐ[K] A₁') (φ₂ : A₂ →ₐ[K] A₂')
    (h₁ : ∀ b, φ₁ (algebraMap B A₁ b) = algebraMap B' A₁' (ψ b))
    (h₂ : ∀ b, φ₂ (algebraMap B A₂ b) = algebraMap B' A₂' (ψ b)) (a : A₁) :
    map ψ φ₁ φ₂ h₁ h₂ (inl K B A₁ A₂ a) = inl K B' A₁' A₂' (φ₁ a) :=
  lift_inl _ _ _ a

@[simp]
theorem map_inr (ψ : B →+* B') (φ₁ : A₁ →ₐ[K] A₁') (φ₂ : A₂ →ₐ[K] A₂')
    (h₁ : ∀ b, φ₁ (algebraMap B A₁ b) = algebraMap B' A₁' (ψ b))
    (h₂ : ∀ b, φ₂ (algebraMap B A₂ b) = algebraMap B' A₂' (ψ b)) (a : A₂) :
    map ψ φ₁ φ₂ h₁ h₂ (inr K B A₁ A₂ a) = inr K B' A₁' A₂' (φ₂ a) :=
  lift_inr _ _ _ a

@[simp]
theorem map_id :
    map (RingHom.id B) (AlgHom.id K A₁) (AlgHom.id K A₂) (fun _ ↦ rfl) (fun _ ↦ rfl) =
      AlgHom.id K (DaggerTensorProduct K B A₁ A₂) := by
  ext <;> simp [map]

theorem map_comp {B'' : Type*} [CommRing B'']
    {A₁'' : Type*} [CommRing A₁''] [Algebra K A₁''] [Algebra B'' A₁''] [IsDaggerAlgebra K A₁'']
    {A₂'' : Type*} [CommRing A₂''] [Algebra K A₂''] [Algebra B'' A₂''] [IsDaggerAlgebra K A₂'']
    (ψ : B →+* B') (φ₁ : A₁ →ₐ[K] A₁') (φ₂ : A₂ →ₐ[K] A₂')
    (h₁ : ∀ b, φ₁ (algebraMap B A₁ b) = algebraMap B' A₁' (ψ b))
    (h₂ : ∀ b, φ₂ (algebraMap B A₂ b) = algebraMap B' A₂' (ψ b))
    (ψ' : B' →+* B'') (φ₁' : A₁' →ₐ[K] A₁'') (φ₂' : A₂' →ₐ[K] A₂'')
    (h₁' : ∀ b, φ₁' (algebraMap B' A₁' b) = algebraMap B'' A₁'' (ψ' b))
    (h₂' : ∀ b, φ₂' (algebraMap B' A₂' b) = algebraMap B'' A₂'' (ψ' b)) :
    (map ψ' φ₁' φ₂' h₁' h₂').comp (map ψ φ₁ φ₂ h₁ h₂) =
      map (ψ'.comp ψ) (φ₁'.comp φ₁) (φ₂'.comp φ₂) (fun b ↦ by simp [h₁, h₁'])
        (fun b ↦ by simp [h₂, h₂']) := by
  ext <;> simp

end Map

section WashnitzerAlgebra

variable (σ₁ σ₂ : Type*) [Finite σ₁] [Finite σ₂]

/-- **The dagger tensor product of Monsky–Washnitzer algebras.**
`K⟨X⟩† ⊗†_K K⟨Y⟩† ≃ K⟨X, Y⟩†`, sending `Xᵢ ⊗ 1` to `Xᵢ` and `1 ⊗ Yⱼ` to `Yⱼ`. -/
noncomputable def washnitzerAlgebraEquiv :
    DaggerTensorProduct K K (W σ₁) (W σ₂) ≃ₐ[K] W (σ₁ ⊕ σ₂) :=
  AlgEquiv.ofAlgHom (lift (rename Sum.inl) (rename Sum.inr) fun c ↦ by simp)
    (washnitzerAlgebra.lift
      (Sum.elim (fun i ↦ inl K K (W σ₁) (W σ₂) (X σ₁ K i))
        fun j ↦ inr K K (W σ₁) (W σ₂) (X σ₂ K j)) fun
      | .inl i => washnitzerAlgebra.supSeminorm_apply_X_le_one (inl K K (W σ₁) (W σ₂)) i
      | .inr j => washnitzerAlgebra.supSeminorm_apply_X_le_one (inr K K (W σ₁) (W σ₂)) j)
    (washnitzerAlgebra.algHom_ext fun k ↦ by rcases k with i | j <;> simp)
    (algHom_ext (washnitzerAlgebra.algHom_ext fun i ↦ by simp)
      (washnitzerAlgebra.algHom_ext fun j ↦ by simp))

@[simp]
theorem washnitzerAlgebraEquiv_inl_X (i : σ₁) :
    washnitzerAlgebraEquiv σ₁ σ₂ (inl K K (W σ₁) (W σ₂) (X σ₁ K i)) = X (σ₁ ⊕ σ₂) K (.inl i) := by
  rw [washnitzerAlgebraEquiv, AlgEquiv.ofAlgHom_apply, lift_inl, rename_X]

@[simp]
theorem washnitzerAlgebraEquiv_inr_X (j : σ₂) :
    washnitzerAlgebraEquiv σ₁ σ₂ (inr K K (W σ₁) (W σ₂) (X σ₂ K j)) = X (σ₁ ⊕ σ₂) K (.inr j) := by
  rw [washnitzerAlgebraEquiv, AlgEquiv.ofAlgHom_apply, lift_inr, rename_X]

@[simp]
theorem washnitzerAlgebraEquiv_symm_X_inl (i : σ₁) :
    (washnitzerAlgebraEquiv σ₁ σ₂).symm (X (σ₁ ⊕ σ₂) K (.inl i)) =
      inl K K (W σ₁) (W σ₂) (X σ₁ K i) := by
  rw [washnitzerAlgebraEquiv, AlgEquiv.ofAlgHom_symm_apply, washnitzerAlgebra.lift_X, Sum.elim_inl]

@[simp]
theorem washnitzerAlgebraEquiv_symm_X_inr (j : σ₂) :
    (washnitzerAlgebraEquiv σ₁ σ₂).symm (X (σ₁ ⊕ σ₂) K (.inr j)) =
      inr K K (W σ₁) (W σ₂) (X σ₂ K j) := by
  rw [washnitzerAlgebraEquiv, AlgEquiv.ofAlgHom_symm_apply, washnitzerAlgebra.lift_X, Sum.elim_inr]

end WashnitzerAlgebra

section TensorProduct

variable [SMulCommClass B K A₁]

variable (K B A₁ A₂) in
/-- The comparison map `A₁ ⊗[B] A₂ → A₁ ⊗†_B A₂` from the algebraic tensor product, sending
`a₁ ⊗ a₂` to `inl a₁ * inr a₂`. Here `A₁ ⊗[B] A₂` is a `K`-algebra through `A₁`. -/
noncomputable def ofTensorProduct : A₁ ⊗[B] A₂ →ₐ[K] DaggerTensorProduct K B A₁ A₂ :=
  letI : Algebra B (DaggerTensorProduct K B A₁ A₂) :=
    ((inl K B A₁ A₂).toRingHom.comp (algebraMap B A₁)).toAlgebra
  { Algebra.TensorProduct.lift (S := B) ⟨(inl K B A₁ A₂).toRingHom, fun _ ↦ rfl⟩
      ⟨(inr K B A₁ A₂).toRingHom, fun b ↦ (inl_algebraMap b).symm⟩ fun _ _ ↦ .all _ _ with
    commutes' c := by simp [Algebra.TensorProduct.algebraMap_apply] }

@[simp]
theorem ofTensorProduct_tmul (a₁ : A₁) (a₂ : A₂) :
    ofTensorProduct K B A₁ A₂ (a₁ ⊗ₜ[B] a₂) = inl K B A₁ A₂ a₁ * inr K B A₁ A₂ a₂ := by
  simp only [ofTensorProduct, AlgHom.coe_mk]
  -- The goal is `Algebra.TensorProduct.lift_tmul`, stated for the `Algebra B` structure on the
  -- target that `ofTensorProduct` installs locally. That instance is not in scope here, so the
  -- lemma cannot be applied by name, and restating it with a `let` times out in unification;
  -- `lift` computes on pure tensors by definition, so `rfl` closes the goal.
  rfl

end TensorProduct

section TensorProductEquiv

variable [Algebra K B] [IsScalarTower K B A₁] [IsScalarTower K B A₂]

variable (K B A₁ A₂) in
/-- **The dagger tensor product when the algebraic one is a dagger algebra.** If `A₁ ⊗[B] A₂` is
already a `K`-dagger algebra, for instance when `A₂` is finite over `B`
(`TauCeti.Dagger.IsDaggerAlgebra.tensorProduct_of_finite`), then the comparison map
`A₁ ⊗[B] A₂ → A₁ ⊗†_B A₂` is an isomorphism. -/
noncomputable def tensorProductAlgEquiv [IsDaggerAlgebra K (A₁ ⊗[B] A₂)] :
    A₁ ⊗[B] A₂ ≃ₐ[K] DaggerTensorProduct K B A₁ A₂ :=
  AlgEquiv.ofAlgHom (ofTensorProduct K B A₁ A₂)
    (lift Algebra.TensorProduct.includeLeft
      ((Algebra.TensorProduct.includeRight : A₂ →ₐ[B] A₁ ⊗[B] A₂).restrictScalars K) fun b ↦ by
        simp [Algebra.TensorProduct.tmul_one_eq_one_tmul])
    (algHom_ext (by ext; simp) (by ext; simp))
    (AlgHom.ext fun x ↦ by
      induction x with
      | tmul a₁ a₂ => simp
      | add x y hx hy => simp_all)

@[simp]
theorem tensorProductAlgEquiv_apply [IsDaggerAlgebra K (A₁ ⊗[B] A₂)] (x : A₁ ⊗[B] A₂) :
    tensorProductAlgEquiv K B A₁ A₂ x = ofTensorProduct K B A₁ A₂ x :=
  (rfl)

@[simp]
theorem tensorProductAlgEquiv_symm_inl [IsDaggerAlgebra K (A₁ ⊗[B] A₂)] (a : A₁) :
    (tensorProductAlgEquiv K B A₁ A₂).symm (inl K B A₁ A₂ a) = a ⊗ₜ 1 := by
  simp [tensorProductAlgEquiv]

@[simp]
theorem tensorProductAlgEquiv_symm_inr [IsDaggerAlgebra K (A₁ ⊗[B] A₂)] (a : A₂) :
    (tensorProductAlgEquiv K B A₁ A₂).symm (inr K B A₁ A₂ a) = 1 ⊗ₜ a := by
  simp [tensorProductAlgEquiv]

end TensorProductEquiv

end DaggerTensorProduct

