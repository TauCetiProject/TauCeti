module

public import TauCeti.RingTheory.Dagger.DaggerAlgebra
public import TauCeti.RingTheory.Dagger.MaximalSpectrum

/-!
# The completion of a dagger algebra

Let `A` be a `K`-dagger algebra, presented as `A ≅ W_n ⧸ I` by the chosen presentation
`TauCeti.Dagger.presentation K A`, where `W_n = K⟨X₁, …, Xₙ⟩†` is the Monsky–Washnitzer algebra.
Its *completion* is the affinoid algebra `Â = T_n ⧸ I T_n`, the quotient of the Tate algebra
`T_n = K⟨X₁, …, Xₙ⟩` by the ideal generated by `I`, and the *completion map* `τ : A → Â` is induced
by the inclusion `W_n ⊆ T_n`. The completion is the affinoid algebra whose rigid space
`Sp(Â)` underlies the affinoid dagger space of `A`. With the quotient topology of `T_n`, the image
of `τ` is dense in `Â`, since `W_n` is dense in `T_n`.

This file shows that `A` and `Â` have the same classical points, with the same residue fields.
Contraction along `τ` is a bijection from the maximal ideals of `Â` onto those of `A`, and
`A ⧸ (m ∩ A) → Â ⧸ m` is an isomorphism for every maximal ideal `m` of `Â`. This is the dagger
algebra form of the corresponding statement for `W_n ⊆ T_n`, proved in
`TauCeti.RingTheory.Dagger.MaximalSpectrum`. Indeed a maximal ideal of `Â` is `M ⧸ I T_n` for a
maximal ideal `M` of `T_n` containing `I T_n`. Then `M ∩ W_n` contains `I` because
`I T_n ⊆ M`, and since `M = (M ∩ W_n) T_n` and `(M ∩ W_n) T_n ∩ W_n = M ∩ W_n`, the map
`M ↦ M ∩ W_n` is a bijection between the maximal ideals of `T_n` containing `I T_n` and the
maximal ideals of `W_n` containing `I`. Consequently an element of `A` is a unit as soon as its
image in `Â` is one: otherwise it lies in a maximal ideal of `A`, and hence its image lies in the
maximal ideal of `Â` above it.

## Main definitions

* `TauCeti.Dagger.completion K A`: the completion `Â = T_n ⧸ I T_n` of a dagger algebra `A`.
* `TauCeti.Dagger.toCompletion K A`: the completion map `τ : A →ₐ[K] Â`.

## Main results

* `TauCeti.Dagger.isAffinoidAlgebra_completion`: the completion is an affinoid algebra.
* `TauCeti.Dagger.denseRange_toCompletion`: the image of `A` is dense in its completion.
* `TauCeti.Dagger.completion_existsUnique_isMaximal_comap`: every maximal ideal of `A` is the
  contraction of exactly one maximal ideal of `Â`, and
  `TauCeti.Dagger.maximalSpectrumComap_toCompletion_bijective`: contraction is a bijection of
  maximal spectra.
* `TauCeti.Dagger.quotientMap_toCompletion_bijective`: the residue fields of `A` and `Â` at
  corresponding maximal ideals agree.
* `TauCeti.Dagger.isUnit_iff_isUnit_completion`: an element of `A` is a unit iff its image in `Â`
  is a unit.

## References

* E. Grosse-Klönne, *Rigid analytic spaces with overconvergent structure sheaf*,
  J. reine angew. Math. 519 (2000), §1.2 and Theorem 1.7 (1).
-/

public section

namespace TauCeti.Dagger

open _root_.MvPowerSeries

section Defs

variable (K : Type*) [NormedField K] [IsUltrametricDist K] (A : Type*) [CommRing A] [Algebra K A]
  [IsDaggerAlgebra K A]

/-- The **completion** `Â = T_n ⧸ I T_n` of a dagger algebra `A ≅ W_n ⧸ I`: the quotient of the
Tate algebra `T_n = K⟨X₁, …, Xₙ⟩` by the ideal generated by the kernel `I` of the chosen
presentation `W_n ↠ A`, with `n = presentationDim K A`. -/
abbrev completion : Type _ :=
  IsRestricted.subring (R := K) (fun _ : Fin (presentationDim K A) ↦ (1 : ℝ)) ⧸
    (RingHom.ker (presentation K A)).map (washnitzerAlgebra.toTate (Fin (presentationDim K A)) K)

/-- The **completion map** `τ : A → Â` of a dagger algebra, induced by the inclusion `W_n ⊆ T_n`
of the Monsky–Washnitzer algebra into the Tate algebra. -/
noncomputable def toCompletion : A →ₐ[K] completion K A :=
  (Ideal.quotientMapₐ _ (washnitzerAlgebra.toTate _ K) Ideal.le_comap_map).comp
    (Ideal.quotientKerAlgEquivOfSurjective (presentation_surjective K A)).symm.toAlgHom

variable {K A}

/-- The completion map sends the image of a series `f ∈ W_n` under the chosen presentation to the
class of `f` in `Â = T_n ⧸ I T_n`. -/
@[simp]
theorem toCompletion_presentation (f : washnitzerAlgebra (Fin (presentationDim K A)) K) :
    toCompletion K A (presentation K A f) =
      Ideal.Quotient.mk _ (washnitzerAlgebra.toTate _ K f) := by
  simp [toCompletion]

/-- The completion of a dagger algebra is an affinoid algebra. -/
theorem isAffinoidAlgebra_completion : IsAffinoidAlgebra K (completion K A) :=
  isAffinoidAlgebra_tate.quotient _

/-- **A dagger algebra is dense in its completion**, for the quotient topology of the Tate
algebra on `Â = T_n ⧸ I T_n`. -/
theorem denseRange_toCompletion : DenseRange (toCompletion K A) :=
  (Ideal.Quotient.mk_surjective.denseRange.comp washnitzerAlgebra.denseRange_toTate
    continuous_quot_mk).mono <| by
    rintro _ ⟨f, rfl⟩
    exact ⟨presentation K A f, toCompletion_presentation f⟩

/-- Pulling an ideal of `Â` back to `W_n` through `A` agrees with pulling it back through `T_n`. -/
private theorem comap_presentation_comap_toCompletion (J : Ideal (completion K A)) :
    (J.comap (toCompletion K A)).comap (presentation K A) =
      (J.comap (Ideal.Quotient.mk _)).comap (washnitzerAlgebra.toTate _ K) := by
  ext f
  simp

end Defs

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {A : Type*} [CommRing A] [Algebra K A] [IsDaggerAlgebra K A]

variable (K) in
/-- **Maximal ideals of a dagger algebra and of its completion.** Every maximal ideal `m` of a
dagger algebra `A` is the contraction of exactly one maximal ideal of its completion `Â`. -/
theorem completion_existsUnique_isMaximal_comap (m : Ideal A) [m.IsMaximal] :
    ∃! m' : Ideal (completion K A), m'.IsMaximal ∧ m'.comap (toCompletion K A) = m := by
  set p := presentation K A
  set N := m.comap p
  have : N.IsMaximal := Ideal.comap_isMaximal_of_surjective _ (presentation_surjective K A)
  set M := N.map (washnitzerAlgebra.toTate _ K)
  have hM : M.IsMaximal := washnitzerAlgebra.isMaximal_map_toTate N
  -- `M` contains `I T_n`, so it is the preimage of the maximal ideal `M ⧸ I T_n` of `Â`.
  have hIM : (RingHom.ker p).map (washnitzerAlgebra.toTate _ K) ≤ M :=
    Ideal.map_mono (Ideal.ker_le_comap p)
  have hcomap : (M.map (Ideal.Quotient.mk _)).comap (Ideal.Quotient.mk _) = M :=
    Ideal.comap_map_mk hIM
  -- A maximal ideal `m'` of `Â` lies over `m` iff its preimage in `T_n` is `M`.
  have key (m' : Ideal (completion K A)) [m'.IsMaximal] :
      m'.comap (toCompletion K A) = m ↔ m'.comap (Ideal.Quotient.mk _) = M := by
    have : (m'.comap (Ideal.Quotient.mk _)).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
    rw [← (Ideal.comap_injective_of_surjective p (presentation_surjective K A)).eq_iff,
      comap_presentation_comap_toCompletion]
    refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
    · rw [← washnitzerAlgebra.map_comap_toTate_of_isMaximal (m'.comap _), h]
    · rw [h, washnitzerAlgebra.comap_map_toTate_of_isMaximal]
  have hmax : (M.map (Ideal.Quotient.mk _) : Ideal (completion K A)).IsMaximal :=
    (Ideal.map_eq_top_or_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective hM).resolve_left
      fun h ↦ hM.ne_top (by rw [← hcomap, h, Ideal.comap_top])
  refine ⟨M.map (Ideal.Quotient.mk _), ⟨hmax, (key _).2 hcomap⟩, ?_⟩
  rintro m' ⟨hm', hm'm⟩
  rw [← Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective m', (key m').1 hm'm]

/-- **A dagger algebra and its completion have the same classical points**: contraction of
maximal ideals along `τ : A → Â` is a bijection of maximal spectra. -/
theorem maximalSpectrumComap_toCompletion_bijective :
    Function.Bijective
      (isAffinoidAlgebra_completion.maximalSpectrumComap (toCompletion K A)) := by
  refine ⟨fun x y hxy ↦ ?_, fun m ↦ ?_⟩
  · have hxy := congrArg MaximalSpectrum.asIdeal hxy
    simp only [IsAffinoidAlgebra.maximalSpectrumComap_asIdeal] at hxy
    have : (x.asIdeal.comap (toCompletion K A)).IsMaximal :=
      isAffinoidAlgebra_completion.comap_isMaximal _ x.asIdeal
    exact MaximalSpectrum.ext <| (completion_existsUnique_isMaximal_comap K _).unique
      ⟨x.isMaximal, rfl⟩ ⟨y.isMaximal, hxy.symm⟩
  · obtain ⟨m', ⟨hm', hm'm⟩, -⟩ := completion_existsUnique_isMaximal_comap K m.asIdeal
    exact ⟨⟨m', hm'⟩, MaximalSpectrum.ext (by simpa using hm'm)⟩

/-- **Residue fields of a dagger algebra and of its completion agree.** For a maximal ideal `m`
of the completion `Â`, the induced map `A ⧸ (m ∩ A) → Â ⧸ m` is bijective. -/
theorem quotientMap_toCompletion_bijective (m : Ideal (completion K A)) [m.IsMaximal] :
    Function.Bijective (Ideal.quotientMapₐ m (toCompletion K A) le_rfl) := by
  refine ⟨Ideal.quotientMap_injective, fun x ↦ ?_⟩
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective x
  -- The residue field of `T_n` at `M = m ∩ T_n` is a residue field of `W_n`.
  set M := m.comap (Ideal.Quotient.mk _)
  have : M.IsMaximal := Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
  obtain ⟨w, hw⟩ := (washnitzerAlgebra.quotientMap_toTate_bijective M).2 (Ideal.Quotient.mk M t)
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective w
  refine ⟨Ideal.Quotient.mk _ (presentation K A f), ?_⟩
  rw [Ideal.quotient_map_mkₐ, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq]
  rw [Ideal.quotient_map_mkₐ, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq] at hw
  simpa [M] using hw

variable (K) in
/-- **Units of a dagger algebra are detected on its completion**: an element `a` of `A` is a unit
iff its image `τ a` in the completion is a unit. -/
theorem isUnit_iff_isUnit_completion {a : A} : IsUnit a ↔ IsUnit (toCompletion K A a) := by
  refine ⟨fun h ↦ h.map _, fun h ↦ by_contra fun ha ↦ ?_⟩
  obtain ⟨m, hm, ham⟩ := exists_max_ideal_of_mem_nonunits ha
  obtain ⟨m', ⟨hm', hm'm⟩, -⟩ := completion_existsUnique_isMaximal_comap K m
  exact hm'.ne_top <| Ideal.eq_top_of_isUnit_mem _ (by rwa [← Ideal.mem_comap, hm'm]) h

end TauCeti.Dagger
