/-!
# Rational localisation of dagger algebras

Let `K` be a complete nontrivially normed ultrametric field, `A` a `K`-dagger algebra and
`g, f₁, …, fₘ ∈ A`. The *rational localisation* of `A` is the dagger algebra

`A⟨f/g⟩† = A⟨X₁, …, Xₘ⟩† ⧸ (g Xᵢ - fᵢ)`,

where `A⟨X₁, …, Xₘ⟩† = A ⊗†_K K⟨X₁, …, Xₘ⟩†` is the relative overconvergent polydisc, a dagger
tensor product (`TauCeti.Dagger.DaggerTensorProduct`). The class of `Xᵢ` is the ratio `fᵢ/g`.
When `g, f₁, …, fₘ` generate the unit ideal, `g` becomes a unit of `A⟨f/g⟩†`.

The rational localisation is not the algebraic localisation `A[1/g]`: in the Laurent localisation
`W₁⟨1/X⟩†` of `W₁ = K⟨X⟩†`, the coordinate ring of the dagger annulus `|X| = 1`, the element
`X - a = X (1 - a/X)` is a unit for every `a ∈ K` with `0 < |a| < 1`, whereas `X - a` is not a unit
of `W₁[1/X]`.

## Universal property

Let `g, f₁, …, fₘ` generate the unit ideal of `A`. A `K`-algebra homomorphism `φ : A → C` into a
dagger algebra extends to `A⟨f/g⟩†`, necessarily uniquely, if and only if `|φ fᵢ (y)| ≤ |φ g (y)|`
at every classical point `y` of `C` and for every `i`; that is, if and only if the induced map
`Sp C → Sp A` lands in the rational domain `R(f/g) = {x : |fᵢ(x)| ≤ |g(x)|}`. No continuity is
imposed. The condition is pointwise, not a comparison `|φ fᵢ|sup ≤ |φ g|sup` of supremum
seminorms: for `φ = id` on `W₁`, `g = X` and `f₁ = π` with `0 < |π| < 1`, one has
`|π|sup = |π| ≤ 1 = |X|sup`, but the condition fails at the origin, and indeed `X` is not a unit of
`W₁`.

The proof rests on weak completeness (`TauCeti.Dagger.washnitzerAlgebra.lift`) and on the
description of the absolute values of a dagger algebra through its affinoid completion. If `φ g`
is a unit and each `bᵢ = φ fᵢ · (φ g)⁻¹` has supremum seminorm at most `1`, the homomorphism
`A ⊗†_K K⟨X⟩† → C` given by `φ` and by `Xᵢ ↦ bᵢ` kills every `g Xᵢ - fᵢ`. Conversely, `φ g` becomes
a unit and the image of `Xᵢ` is forced to be `bᵢ`, an element of supremum seminorm at most `1`. The
pointwise condition is equivalent: since `g, f₁, …, fₘ` have no common zero, it forces `φ g` to
vanish nowhere, hence to be a unit of `C`, and `|bᵢ(y)| = |φ fᵢ(y)| / |φ g(y)|`.

## Main definitions

* `TauCeti.Dagger.RationalLocalization K g f`: the rational localisation `A⟨f/g⟩†`, a
  `K`-dagger algebra.
* `TauCeti.Dagger.RationalLocalization.of`: the structure map `A → A⟨f/g⟩†`.
* `TauCeti.Dagger.RationalLocalization.ratio`: the ratio `fᵢ/g`, the class of `Xᵢ`.
* `TauCeti.Dagger.RationalLocalization.lift`: the homomorphism `A⟨f/g⟩† → C` extending `φ` and
  sending `fᵢ/g` to an element `bᵢ` of supremum seminorm at most `1` with `φ g * bᵢ = φ fᵢ`.

## Main results

* `TauCeti.Dagger.RationalLocalization.isUnit_of`: `g` is a unit of `A⟨f/g⟩†`.
* `TauCeti.Dagger.RationalLocalization.algHom_ext`: homomorphisms out of `A⟨f/g⟩†` into a dagger
  algebra are determined on `A`.
* `TauCeti.Dagger.RationalLocalization.existsUnique_algHom`: the universal property, with the
  condition that `φ g` is a unit and `|φ fᵢ · (φ g)⁻¹|sup ≤ 1`.
* `TauCeti.Dagger.RationalLocalization.existsUnique_algHom_iff_forall_pointNorm_le`: the universal
  property, with the pointwise condition `|φ fᵢ (y)| ≤ |φ g (y)|`.
* `TauCeti.Dagger.RationalLocalization.pointNorm_of_le`: `|fᵢ(x)| ≤ |g(x)|` at every classical
  point `x` of `A⟨f/g⟩†`, so `Sp A⟨f/g⟩† → Sp A` lands in the rational domain `R(f/g)`.

## References

* E. Grosse-Klönne, *Rigid analytic spaces with overconvergent structure sheaf*,
  J. reine angew. Math. 519 (2000), §1, 1.18.
* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §7.2.3 (the
  affinoid statement).
-/

public section

namespace TauCeti.Dagger

open washnitzerAlgebra (X)

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {A : Type*} [CommRing A] [Algebra K A] [IsDaggerAlgebra K A] {m : ℕ}

local notation "W " σ:max => washnitzerAlgebra σ K

/-- The relative overconvergent polydisc `A⟨X₁, …, Xₘ⟩† = A ⊗†_K K⟨X₁, …, Xₘ⟩†`. -/
local notation "P" => DaggerTensorProduct K K A (W (Fin m))

namespace RationalLocalization

variable (K) in
/-- The ideal of `A⟨X₁, …, Xₘ⟩† = A ⊗†_K K⟨X₁, …, Xₘ⟩†` generated by the elements `g Xᵢ - fᵢ`,
whose quotient is the rational localisation `A⟨f/g⟩†`. -/
noncomputable def relIdeal (g : A) (f : Fin m → A) : Ideal P :=
  Ideal.span (Set.range fun i ↦ DaggerTensorProduct.inl K K A (W (Fin m)) g *
    DaggerTensorProduct.inr K K A (W (Fin m)) (X (Fin m) K i) -
      DaggerTensorProduct.inl K K A (W (Fin m)) (f i))

end RationalLocalization

variable (K) in
/-- **The rational localisation** `A⟨f/g⟩† = A⟨X₁, …, Xₘ⟩† ⧸ (g Xᵢ - fᵢ)` of a dagger algebra `A`
at `g, f₁, …, fₘ`, where `A⟨X₁, …, Xₘ⟩† = A ⊗†_K K⟨X₁, …, Xₘ⟩†`. When `g, f₁, …, fₘ` generate the
unit ideal, it represents the rational domain `R(f/g)` among dagger algebras
(`TauCeti.Dagger.RationalLocalization.existsUnique_algHom_iff_forall_pointNorm_le`). -/
@[expose]
def RationalLocalization (g : A) (f : Fin m → A) : Type _ :=
  P ⧸ RationalLocalization.relIdeal K g f

namespace RationalLocalization

variable {g : A} {f : Fin m → A}

noncomputable instance : CommRing (RationalLocalization K g f) :=
  Ideal.Quotient.commRing _

noncomputable instance : Algebra K (RationalLocalization K g f) :=
  Ideal.Quotient.algebra K

/-- The rational localisation of a dagger algebra is a dagger algebra. -/
instance : IsDaggerAlgebra K (RationalLocalization K g f) :=
  IsDaggerAlgebra.quotient (A := P) _

/-- The quotient map from `A⟨X₁, …, Xₘ⟩†` onto the rational localisation. -/
private noncomputable def mkₐ : P →ₐ[K] RationalLocalization K g f :=
  Ideal.Quotient.mkₐ K _

private theorem mkₐ_relation (i : Fin m) :
    mkₐ (g := g) (f := f) (DaggerTensorProduct.inl K K A (W (Fin m)) g *
      DaggerTensorProduct.inr K K A (W (Fin m)) (X (Fin m) K i)) =
        mkₐ (DaggerTensorProduct.inl K K A (W (Fin m)) (f i)) :=
  Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨i, rfl⟩)

private theorem algHom_ext_mkₐ {C : Type*} [CommRing C] [Algebra K C]
    {ψ₁ ψ₂ : RationalLocalization K g f →ₐ[K] C}
    (h : ψ₁.comp (mkₐ (g := g) (f := f)) = ψ₂.comp mkₐ) : ψ₁ = ψ₂ :=
  Ideal.Quotient.algHom_ext K h

variable (K g f) in
/-- The structure map `A → A⟨f/g⟩†`. -/
noncomputable def of : A →ₐ[K] RationalLocalization K g f :=
  mkₐ.comp (DaggerTensorProduct.inl K K A (W (Fin m)))

variable (K g f) in
/-- The ratio `fᵢ/g` in `A⟨f/g⟩†`: the class of the variable `Xᵢ`. -/
noncomputable def ratio (i : Fin m) : RationalLocalization K g f :=
  mkₐ (DaggerTensorProduct.inr K K A (W (Fin m)) (X (Fin m) K i))

/-- **`g · (fᵢ/g) = fᵢ`** in the rational localisation. -/
@[simp]
theorem of_mul_ratio (i : Fin m) : of K g f g * ratio K g f i = of K g f (f i) := by
  rw [of, ratio, AlgHom.comp_apply, ← map_mul, mkₐ_relation, AlgHom.comp_apply]

/-- **The denominator becomes a unit.** If `g, f₁, …, fₘ` generate the unit ideal of `A`, then `g`
is a unit of `A⟨f/g⟩†`. -/
theorem isUnit_of (h : Ideal.span (insert g (Set.range f)) = ⊤) : IsUnit (of K g f g) := by
  rw [← Ideal.span_singleton_eq_top, eq_top_iff, ← Ideal.map_top (of K g f), ← h, Ideal.map_span,
    Ideal.span_le]
  rintro _ ⟨a, ha | ⟨i, rfl⟩, rfl⟩
  · exact ha ▸ Ideal.mem_span_singleton_self _
  · rw [← of_mul_ratio]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

/-- If `g, f₁, …, fₘ` generate the unit ideal of `A`, then `fᵢ/g` is `fᵢ` times the inverse of `g`
in `A⟨f/g⟩†`. -/
theorem ratio_eq_of_mul_inverse (h : Ideal.span (insert g (Set.range f)) = ⊤) (i : Fin m) :
    ratio K g f i = of K g f (f i) * Ring.inverse (of K g f g) := by
  rw [← of_mul_ratio, mul_comm, ← mul_assoc, Ring.inverse_mul_cancel _ (isUnit_of h), one_mul]

/-- The image of a ratio `fᵢ/g` under any `K`-algebra homomorphism into a dagger algebra has
supremum seminorm at most `1`. In particular `|(fᵢ/g)(x)| ≤ 1` at every classical point `x` of
`A⟨f/g⟩†`. -/
theorem supSeminorm_map_ratio_le_one {C : Type*} [CommRing C] [Algebra K C] [IsDaggerAlgebra K C]
    (ψ : RationalLocalization K g f →ₐ[K] C) (i : Fin m) :
    supSeminorm K (ψ (ratio K g f i)) ≤ 1 :=
  -- By definition `fᵢ/g` is the image of the variable `Xᵢ` of `K⟨X⟩†`.
  washnitzerAlgebra.supSeminorm_apply_X_le_one
    ((ψ.comp mkₐ).comp (DaggerTensorProduct.inr K K A (W (Fin m)))) i

section Lift

variable {C : Type*} [CommRing C] [Algebra K C] [IsDaggerAlgebra K C]

/-- The homomorphism `A⟨X₁, …, Xₘ⟩† → C` given by `φ` on `A` and by `Xᵢ ↦ bᵢ`. -/
private noncomputable def liftP (φ : A →ₐ[K] C) {b : Fin m → C}
    (hb : ∀ i, supSeminorm K (b i) ≤ 1) : P →ₐ[K] C :=
  DaggerTensorProduct.lift φ (washnitzerAlgebra.lift b hb) fun c ↦ by
    rw [AlgHom.commutes, AlgHom.commutes]

/-- **The extension of `φ : A → C` to `A⟨f/g⟩†` sending `fᵢ/g` to `bᵢ`**, for a dagger algebra
`C` and elements `b₁, …, bₘ ∈ C` with `|bᵢ|sup ≤ 1` and `φ g * bᵢ = φ fᵢ`. No continuity is
assumed. -/
noncomputable def lift (φ : A →ₐ[K] C) {b : Fin m → C} (hb : ∀ i, supSeminorm K (b i) ≤ 1)
    (hφ : ∀ i, φ g * b i = φ (f i)) : RationalLocalization K g f →ₐ[K] C :=
  Ideal.Quotient.liftₐ _ (liftP φ hb) fun _ hx ↦ RingHom.mem_ker.mp <|
    (Ideal.span_le (I := RingHom.ker (liftP φ hb)).mpr (by
      rintro _ ⟨i, rfl⟩
      simp [liftP, hφ])) hx

variable (φ : A →ₐ[K] C) {b : Fin m → C} (hb : ∀ i, supSeminorm K (b i) ≤ 1)
  (hφ : ∀ i, φ g * b i = φ (f i))

private theorem lift_mkₐ (x : P) : lift φ hb hφ (mkₐ x) = liftP φ hb x :=
  Ideal.Quotient.lift_mk _ _ _

/-- `lift` extends `φ` on `A`. -/
@[simp]
theorem lift_of (a : A) : lift φ hb hφ (of K g f a) = φ a :=
  (lift_mkₐ φ hb hφ _).trans (DaggerTensorProduct.lift_inl _ _ _ a)

/-- `lift` extends `φ` on `A`, as homomorphisms. -/
@[simp]
theorem lift_comp_of : (lift φ hb hφ).comp (of K g f) = φ :=
  AlgHom.ext (lift_of φ hb hφ)

/-- `lift` sends each ratio `fᵢ/g` to `bᵢ`. -/
@[simp]
theorem lift_ratio (i : Fin m) : lift φ hb hφ (ratio K g f i) = b i :=
  (lift_mkₐ φ hb hφ _).trans <| (DaggerTensorProduct.lift_inr _ _ _ _).trans
    (washnitzerAlgebra.lift_X b hb i)

end Lift

variable {C : Type*} [CommRing C] [Algebra K C] [IsDaggerAlgebra K C]

/-- **Homomorphisms out of `A⟨f/g⟩†` into a dagger algebra are determined on `A`** when
`g, f₁, …, fₘ` generate the unit ideal: the image of `fᵢ/g` is then forced to be
`φ fᵢ · (φ g)⁻¹`. No continuity is assumed. -/
theorem algHom_ext (h : Ideal.span (insert g (Set.range f)) = ⊤)
    {ψ₁ ψ₂ : RationalLocalization K g f →ₐ[K] C}
    (hψ : ψ₁.comp (of K g f) = ψ₂.comp (of K g f)) : ψ₁ = ψ₂ := by
  refine algHom_ext_mkₐ (DaggerTensorProduct.algHom_ext hψ
    (washnitzerAlgebra.algHom_ext fun i ↦ ?_))
  -- The goal is `ψ₁ (fᵢ/g) = ψ₂ (fᵢ/g)`, by definition of `ratio`. Both images solve
  -- `ψ₂ (g) * y = ψ₂ (fᵢ)`, and `ψ₂ (g)` is a unit.
  have hof (a : A) : ψ₁ (of K g f a) = ψ₂ (of K g f a) := AlgHom.congr_fun hψ a
  have h₁ := congrArg ψ₁ (of_mul_ratio (K := K) (g := g) (f := f) i)
  have h₂ := congrArg ψ₂ (of_mul_ratio (K := K) (g := g) (f := f) i)
  rw [map_mul, hof, hof] at h₁
  rw [map_mul] at h₂
  exact ((isUnit_of h).map ψ₂).mul_left_cancel (h₁.trans h₂.symm)

/-- **The universal property of the rational localisation.** Let `g, f₁, …, fₘ` generate the unit
ideal of a dagger algebra `A`. A `K`-algebra homomorphism `φ : A → C` into a dagger algebra extends
to `A⟨f/g⟩†` if and only if `φ g` is a unit and every `φ fᵢ · (φ g)⁻¹` has supremum seminorm at
most `1`, and the extension is then unique. -/
theorem existsUnique_algHom (h : Ideal.span (insert g (Set.range f)) = ⊤) (φ : A →ₐ[K] C) :
    (∃! ψ : RationalLocalization K g f →ₐ[K] C, ψ.comp (of K g f) = φ) ↔
      IsUnit (φ g) ∧ ∀ i, supSeminorm K (φ (f i) * Ring.inverse (φ g)) ≤ 1 := by
  refine ⟨fun ⟨ψ, hψ, _⟩ ↦ ?_, fun ⟨hg, hb⟩ ↦ ?_⟩
  · subst hψ
    refine ⟨(isUnit_of h).map ψ, fun i ↦ ?_⟩
    rw [AlgHom.comp_apply, AlgHom.comp_apply, ← (isUnit_of h).map_ringInverse ψ, ← map_mul,
      ← ratio_eq_of_mul_inverse h]
    exact supSeminorm_map_ratio_le_one ψ i
  · have hφ (i : Fin m) : φ g * (φ (f i) * Ring.inverse (φ g)) = φ (f i) := by
      rw [mul_comm, mul_assoc, Ring.inverse_mul_cancel _ hg, mul_one]
    exact ⟨lift φ hb hφ, lift_comp_of φ hb hφ, fun ψ hψ ↦
      algHom_ext h (by rw [hψ, lift_comp_of])⟩

/-- **The universal property of the rational localisation, pointwise.** Let `g, f₁, …, fₘ` generate
the unit ideal of a dagger algebra `A`. A `K`-algebra homomorphism `φ : A → C` into a dagger algebra
extends to `A⟨f/g⟩†` if and only if `|φ fᵢ (y)| ≤ |φ g (y)|` at every classical point `y` of `C`
and for every `i`, and the extension is then unique. -/
theorem existsUnique_algHom_iff_forall_pointNorm_le (h : Ideal.span (insert g (Set.range f)) = ⊤)
    (φ : A →ₐ[K] C) :
    (∃! ψ : RationalLocalization K g f →ₐ[K] C, ψ.comp (of K g f) = φ) ↔
      ∀ y : MaximalSpectrum C, ∀ i, pointNorm K y (φ (f i)) ≤ pointNorm K y (φ g) := by
  rw [existsUnique_algHom h]
  refine ⟨fun ⟨hg, hb⟩ y i ↦ ?_, fun hle ↦ ?_⟩
  · exact (IsDaggerAlgebra.supSeminorm_mul_inverse_le_one_iff (K := K) hg).mp (hb i) y
  -- At a zero `y` of `φ g`, every `φ fᵢ` vanishes too, so `φ` would map the unit ideal into `y`.
  have hg : IsUnit (φ g) := by
    refine (IsDaggerAlgebra.isUnit_iff_forall_pointNorm_ne_zero (K := K)).mpr fun y hy ↦ ?_
    have hmem : Ideal.map φ (Ideal.span (insert g (Set.range f))) ≤ y.asIdeal := by
      rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨a, ha | ⟨i, rfl⟩, rfl⟩
      · exact (IsDaggerAlgebra.pointNorm_eq_zero_iff (K := K)).mp (ha ▸ hy)
      · exact (IsDaggerAlgebra.pointNorm_eq_zero_iff (K := K)).mp
          (le_antisymm ((hle y i).trans_eq hy) (pointNorm_nonneg _))
    rw [h, Ideal.map_top] at hmem
    exact y.isMaximal.ne_top (top_le_iff.mp hmem)
  exact ⟨hg, fun i ↦
    (IsDaggerAlgebra.supSeminorm_mul_inverse_le_one_iff (K := K) hg).mpr fun y ↦ hle y i⟩

/-- **The classical points of `A⟨f/g⟩†` lie over the rational domain**: `|fᵢ(x)| ≤ |g(x)|` at
every classical point `x` of `A⟨f/g⟩†`, since `fᵢ = g · (fᵢ/g)` there and `|(fᵢ/g)(x)| ≤ 1`.
Together with `isUnit_of`, this says that `Sp A⟨f/g⟩† → Sp A` lands in `R(f/g)`. -/
theorem pointNorm_of_le (x : MaximalSpectrum (RationalLocalization K g f)) (i : Fin m) :
    pointNorm K x (of K g f (f i)) ≤ pointNorm K x (of K g f g) := by
  rw [← of_mul_ratio, IsDaggerAlgebra.pointNorm_mul]
  refine mul_le_of_le_one_right (pointNorm_nonneg _) ?_
  exact (IsDaggerAlgebra.pointNorm_le_supSeminorm x _).trans
    (supSeminorm_map_ratio_le_one (AlgHom.id K _) i)

end RationalLocalization

end TauCeti.Dagger
