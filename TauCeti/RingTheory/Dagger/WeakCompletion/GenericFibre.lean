/-!
# The generic fibre of a weak completion

Let `K` be a complete ultrametric field with valuation ring `K°`, let `π ∈ K°` satisfy
`0 < ‖π‖ < 1`, and let `S` be a finitely generated `K°`-algebra with Monsky–Washnitzer weak
completion `S†`. The *generic fibre* of `S†` is the `K`-algebra

```text
A† = K ⊗[K°] S†.
```

For a smooth `K°`-algebra `S`, the de Rham cohomology of `A†` is the Monsky–Washnitzer cohomology
of the reduction of `S`; this file supplies the dagger-algebra structure of `A†` that such a
comparison is built on.

Choose generators `x : σ → S` of `S` with relation ideal `I = ker (O[X_σ] → S)`. Base change of
the integral presentation `K°⟨X_σ⟩† ↠ S†` (`evalIntWashnitzerAlgebra`) along `K° → K`, read through
`K ⊗[K°] K°⟨X_σ⟩† ≃ K⟨X_σ⟩†` (`intWashnitzerAlgebra.scalarExtensionEquiv`), gives a surjection
`K⟨X_σ⟩† ↠ A†` (`evalWashnitzerAlgebra`). Its kernel is the extension of the integral kernel, by
right exactness of the tensor product (`ker_evalWashnitzerAlgebra`). Hence `A†` is a dagger algebra
(`isDaggerAlgebra_genericFibre`). When `K°` is noetherian (for instance when `K` is discretely
valued) the integral kernel is `I · K°⟨X_σ⟩†` (`ker_evalIntWashnitzerAlgebra`), so

```text
A† ≃ K⟨X_σ⟩† ⧸ I · K⟨X_σ⟩†   and   Â† ≃ K⟨X_σ⟩ ⧸ I · K⟨X_σ⟩,
```

the second for the affinoid completion (`genericFibrePresentationAlgEquiv`,
`genericFibreCompletionEquiv`). Elements of `S†` have supremum seminorm at most one in `A†`
(`supSeminorm_one_tmul_le_one`), and `S† → A†` is injective when `S` is flat over `K°`
(`includeRight_injective_of_flat`).

## Main definitions

* `TauCeti.Dagger.weakCompletion.genericFibre K π S`: the generic fibre `K ⊗[O] S†`.
* `TauCeti.Dagger.weakCompletion.evalWashnitzerAlgebra`: evaluation `K⟨X_σ⟩† →ₐ[K] K ⊗[K°] S†`
  of overconvergent series at a finite family of elements of `S`.
* `TauCeti.Dagger.weakCompletion.genericFibrePresentationAlgEquiv`: the presentation
  `K⟨X_σ⟩† ⧸ I · K⟨X_σ⟩† ≃ₐ[K] K ⊗[K°] S†`.
* `TauCeti.Dagger.weakCompletion.genericFibreCompletionEquiv`: the completion of the generic fibre
  is `K⟨X_σ⟩ ⧸ I · K⟨X_σ⟩`.

## Main results

* `TauCeti.Dagger.weakCompletion.evalWashnitzerAlgebra_surjective` and
  `TauCeti.Dagger.weakCompletion.ker_evalWashnitzerAlgebra`: evaluation at generators is
  surjective, with kernel generated by the kernel of the integral presentation.
* `TauCeti.Dagger.weakCompletion.isDaggerAlgebra_genericFibre`: the generic fibre of a weak
  completion is a dagger algebra.
* `TauCeti.Dagger.weakCompletion.supSeminorm_one_tmul_le_one`: the image of `S†` lies in the unit
  ball of the supremum seminorm.
* `TauCeti.Dagger.weakCompletion.includeRight_injective_of_flat`: for `S` flat over `K°`, the map
  `S† → K ⊗[K°] S†` is injective.

## References

* M. van der Put, *The cohomology of Monsky and Washnitzer*, Mém. Soc. Math. France 23 (1986),
  §2, (2.1)–(2.2).
* E. Grosse-Klönne, *Finiteness of de Rham cohomology in rigid analysis*, Duke Math. J. 113
  (2002), Introduction.
-/

public section

namespace TauCeti.Dagger.weakCompletion

open _root_.MvPowerSeries
open scoped TensorProduct

section General

variable {O : Type*} [CommRing O] (K : Type*) [CommRing K] [Algebra O K] (π : O)
  (S : Type*) [CommRing S] [Algebra O S] [Algebra.FiniteType O S]

/-- The **generic fibre** `A† = K ⊗[O] S†` of the weak completion of a finitely generated
`O`-algebra `S`. For `O` the valuation ring of a complete ultrametric field `K` and
`0 < ‖π‖ < 1`, it is a `K`-dagger algebra (`isDaggerAlgebra_genericFibre`). -/
abbrev genericFibre : Type _ :=
  K ⊗[O] weakCompletion π S

end General

section NontriviallyNormedField

variable {K S σ : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [CommRing S] [Algebra (Subring.unitClosedBall K) S]
  [Algebra.FiniteType (Subring.unitClosedBall K) S] [Finite σ]

local notation "O" => Subring.unitClosedBall K
local notation "T " α:max => IsRestricted.subring (R := K) (fun _ : α ↦ (1 : ℝ))

/-- Evaluation of overconvergent series at a finite family `x` of elements of `S`, with values in
the generic fibre `K ⊗[K°] S†`: the base change to `K` of `evalIntWashnitzerAlgebra`, read through
`K ⊗[K°] K°⟨X_σ⟩† ≃ K⟨X_σ⟩†`. -/
noncomputable def evalWashnitzerAlgebra {π : O} (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1)
    (x : σ → S) : washnitzerAlgebra σ K →ₐ[K] genericFibre K π S :=
  (Algebra.TensorProduct.lTensor (S := K) K (evalIntWashnitzerAlgebra hπ hπ1 x)).comp
    (intWashnitzerAlgebra.scalarExtensionEquiv σ K).symm.toAlgHom

/-- On integral overconvergent series, evaluation in the generic fibre is integral evaluation
followed by `z ↦ 1 ⊗ z`. -/
@[simp]
theorem evalWashnitzerAlgebra_toWashnitzerAlgebra {π : O} (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1)
    (x : σ → S) (g : intWashnitzerAlgebra σ K) :
    evalWashnitzerAlgebra hπ hπ1 x (intWashnitzerAlgebra.toWashnitzerAlgebra σ K g) =
      1 ⊗ₜ evalIntWashnitzerAlgebra hπ hπ1 x g := by
  simp [evalWashnitzerAlgebra]

/-- Evaluation in the generic fibre sends the variable `Xᵢ` to `1 ⊗ xᵢ`. -/
@[simp]
theorem evalWashnitzerAlgebra_X {π : O} (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1) (x : σ → S)
    (i : σ) :
    evalWashnitzerAlgebra hπ hπ1 x (washnitzerAlgebra.X σ K i) = 1 ⊗ₜ of π S (x i) := by
  have hX : washnitzerAlgebra.X σ K i = intWashnitzerAlgebra.toWashnitzerAlgebra σ K
      (intWashnitzerAlgebra.ofMvPolynomial σ K (MvPolynomial.X i)) :=
    Subtype.ext (by simp)
  simp [hX]

/-- Evaluation in the generic fibre at a generating family of `S` is surjective. -/
theorem evalWashnitzerAlgebra_surjective {π : O} (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1)
    (x : σ → S) (hx : Algebra.adjoin O (Set.range x) = ⊤) :
    Function.Surjective (evalWashnitzerAlgebra hπ hπ1 x) := by
  rw [evalWashnitzerAlgebra, AlgHom.coe_comp]
  exact (LinearMap.lTensor_surjective K (evalIntWashnitzerAlgebra_surjective hπ hπ1 x hx)).comp
    (intWashnitzerAlgebra.scalarExtensionEquiv σ K).symm.surjective

/-- **The kernel of the generic-fibre presentation.** At a generating family of `S`, the kernel of
`K⟨X_σ⟩† ↠ K ⊗[K°] S†` is generated by the kernel of the integral presentation
`K°⟨X_σ⟩† ↠ S†`. -/
theorem ker_evalWashnitzerAlgebra {π : O} (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1) (x : σ → S)
    (hx : Algebra.adjoin O (Set.range x) = ⊤) :
    RingHom.ker (evalWashnitzerAlgebra hπ hπ1 x) =
      (RingHom.ker (evalIntWashnitzerAlgebra hπ hπ1 x)).map
        (intWashnitzerAlgebra.toWashnitzerAlgebra σ K) := by
  let e := intWashnitzerAlgebra.scalarExtensionEquiv σ K
  -- The base change `K ⊗ K°⟨X⟩† → K ⊗ S†` of the integral presentation, as an `O`-algebra map.
  let φ := Algebra.TensorProduct.lTensor (S := O) K (evalIntWashnitzerAlgebra hπ hπ1 x)
  have hker : RingHom.ker (evalWashnitzerAlgebra hπ hπ1 x) =
      (RingHom.ker φ).map (e.toRingEquiv : _ →+* washnitzerAlgebra σ K) := by
    rw [Ideal.map_comap_of_equiv]
    ext f
    rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.mem_ker]
    -- `evalWashnitzerAlgebra` is `lTensor K evalIntWashnitzerAlgebra` after `e.symm`; the
    -- `K`-linear and `O`-linear versions of `lTensor` have the same underlying function.
    rfl
  have he : (e.toRingEquiv : _ →+* washnitzerAlgebra σ K).comp
      (Algebra.TensorProduct.includeRight : intWashnitzerAlgebra σ K →ₐ[O] K ⊗[O] _).toRingHom =
      intWashnitzerAlgebra.toWashnitzerAlgebra σ K := by
    ext g
    simp [e]
  rw [hker, Algebra.TensorProduct.lTensor_ker _ (evalIntWashnitzerAlgebra_surjective hπ hπ1 x hx)]
  exact (Ideal.map_map _ _).trans (congrArg (Ideal.map · _) he)

/-- Over a noetherian valuation ring `K°`, the kernel of `K⟨X_σ⟩† ↠ K ⊗[K°] S†` at a generating
family `x` is `I · K⟨X_σ⟩†`, for `I` the ideal of polynomial relations among the `xᵢ`. -/
theorem ker_evalWashnitzerAlgebra_eq_map_ker_aeval [IsNoetherianRing O] {π : O} (hπ : π ≠ 0)
    (hπ1 : ‖(π : K)‖ < 1) (x : σ → S) (hx : Algebra.adjoin O (Set.range x) = ⊤) :
    RingHom.ker (evalWashnitzerAlgebra hπ hπ1 x) =
      ((RingHom.ker (MvPolynomial.aeval x)).map (intWashnitzerAlgebra.ofMvPolynomial σ K)).map
        (intWashnitzerAlgebra.toWashnitzerAlgebra σ K) := by
  rw [ker_evalWashnitzerAlgebra hπ hπ1 x hx, ker_evalIntWashnitzerAlgebra hπ hπ1 x hx]

variable (K S) in
/-- **The generic fibre of a weak completion is a dagger algebra.** For `π ∈ K°` with
`0 < ‖π‖ < 1` and a finitely generated `K°`-algebra `S`, `K ⊗[K°] S†` is a quotient of a
Monsky–Washnitzer algebra in finitely many variables. -/
theorem isDaggerAlgebra_genericFibre {π : O} (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1) :
    IsDaggerAlgebra K (genericFibre K π S) := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := O) (A := S)
  have hx : Algebra.adjoin O (Set.range ((↑) : s → S)) = ⊤ := by
    simpa only [Subtype.range_coe_subtype, Finset.setOfPred_mem] using hs
  exact IsDaggerAlgebra.of_surjective_washnitzerAlgebra _
    (evalWashnitzerAlgebra_surjective hπ hπ1 _ hx)

/-- **Presentation of the generic fibre.** Over a noetherian valuation ring `K°`, a finite
generating family `x` of `S` with relation ideal `I = ker (aeval x)` presents the generic fibre as
`K⟨X_σ⟩† ⧸ I · K⟨X_σ⟩† ≃ₐ[K] K ⊗[K°] S†`, sending `Xᵢ` to `1 ⊗ xᵢ`. -/
noncomputable def genericFibrePresentationAlgEquiv [IsNoetherianRing O] {π : O} (hπ : π ≠ 0)
    (hπ1 : ‖(π : K)‖ < 1) (x : σ → S) (hx : Algebra.adjoin O (Set.range x) = ⊤) :
    (washnitzerAlgebra σ K ⧸
      ((RingHom.ker (MvPolynomial.aeval x)).map (intWashnitzerAlgebra.ofMvPolynomial σ K)).map
        (intWashnitzerAlgebra.toWashnitzerAlgebra σ K)) ≃ₐ[K] genericFibre K π S :=
  (Ideal.quotientEquivAlgOfEq K
    (ker_evalWashnitzerAlgebra_eq_map_ker_aeval hπ hπ1 x hx).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (evalWashnitzerAlgebra_surjective hπ hπ1 x hx))

/-- The presentation of the generic fibre sends the class of `f` to its evaluation. -/
@[simp]
theorem genericFibrePresentationAlgEquiv_mk [IsNoetherianRing O] {π : O} (hπ : π ≠ 0)
    (hπ1 : ‖(π : K)‖ < 1) (x : σ → S) (hx : Algebra.adjoin O (Set.range x) = ⊤)
    (f : washnitzerAlgebra σ K) :
    genericFibrePresentationAlgEquiv hπ hπ1 x hx (Ideal.Quotient.mk _ f) =
      evalWashnitzerAlgebra hπ hπ1 x f := by
  simp [genericFibrePresentationAlgEquiv]

/-- The inverse presentation sends the evaluation of `f` to the class of `f`. -/
@[simp]
theorem genericFibrePresentationAlgEquiv_symm_evalWashnitzerAlgebra [IsNoetherianRing O] {π : O}
    (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1) (x : σ → S) (hx : Algebra.adjoin O (Set.range x) = ⊤)
    (f : washnitzerAlgebra σ K) :
    (genericFibrePresentationAlgEquiv hπ hπ1 x hx).symm (evalWashnitzerAlgebra hπ hπ1 x f) =
      Ideal.Quotient.mk _ f := by
  rw [AlgEquiv.symm_apply_eq, genericFibrePresentationAlgEquiv_mk]

/-- **The completion of the generic fibre.** Over a noetherian valuation ring `K°`, a finite
generating family `x` of `S` with relation ideal `I = ker (aeval x)` identifies the affinoid
completion of the dagger algebra `K ⊗[K°] S†` with `K⟨X_σ⟩ ⧸ I · K⟨X_σ⟩`, compatibly with the
evaluation of overconvergent series. The dagger structure is supplied by
`isDaggerAlgebra_genericFibre`. -/
noncomputable def genericFibreCompletionEquiv [IsNoetherianRing O] {π : O}
    [IsDaggerAlgebra K (genericFibre K π S)] (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1) (x : σ → S)
    (hx : Algebra.adjoin O (Set.range x) = ⊤) :
    completion K (genericFibre K π S) ≃A[K]
      T σ ⧸ (((RingHom.ker (MvPolynomial.aeval x)).map
        (intWashnitzerAlgebra.ofMvPolynomial σ K)).map
          (intWashnitzerAlgebra.toWashnitzerAlgebra σ K)).map (washnitzerAlgebra.toTate σ K) :=
  ((evalWashnitzerAlgebra hπ hπ1 x).daggerPresentationCompletionContinuousAlgEquiv
    (evalWashnitzerAlgebra_surjective hπ hπ1 x hx)).trans <|
    IsAffinoidAlgebra.toContinuousAlgEquiv (K := K)
      (A := T σ ⧸ (RingHom.ker (evalWashnitzerAlgebra hπ hπ1 x)).map (washnitzerAlgebra.toTate σ K))
      (B := T σ ⧸ (((RingHom.ker (MvPolynomial.aeval x)).map
        (intWashnitzerAlgebra.ofMvPolynomial σ K)).map
          (intWashnitzerAlgebra.toWashnitzerAlgebra σ K)).map (washnitzerAlgebra.toTate σ K))
      (isAffinoidAlgebra_tate.quotient _)
      (Ideal.quotientEquivAlgOfEq K (congrArg (Ideal.map (washnitzerAlgebra.toTate σ K))
        (ker_evalWashnitzerAlgebra_eq_map_ker_aeval hπ hπ1 x hx)))

/-- The completion of the generic fibre sends the completion of the evaluation of `f` to the class
of `f` in the Tate algebra. -/
@[simp]
theorem genericFibreCompletionEquiv_toCompletion [IsNoetherianRing O] {π : O}
    [IsDaggerAlgebra K (genericFibre K π S)] (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1) (x : σ → S)
    (hx : Algebra.adjoin O (Set.range x) = ⊤) (f : washnitzerAlgebra σ K) :
    genericFibreCompletionEquiv hπ hπ1 x hx
      (toCompletion K (genericFibre K π S) (evalWashnitzerAlgebra hπ hπ1 x f)) =
      Ideal.Quotient.mk _ (washnitzerAlgebra.toTate σ K f) := by
  simp [genericFibreCompletionEquiv]

/-- The inverse completion comparison sends the class of `f` in the Tate algebra to the
completion of the evaluation of `f`. -/
@[simp]
theorem genericFibreCompletionEquiv_symm_mk_toTate [IsNoetherianRing O] {π : O}
    [IsDaggerAlgebra K (genericFibre K π S)] (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1) (x : σ → S)
    (hx : Algebra.adjoin O (Set.range x) = ⊤) (f : washnitzerAlgebra σ K) :
    (genericFibreCompletionEquiv hπ hπ1 x hx).symm
      (Ideal.Quotient.mk _ (washnitzerAlgebra.toTate σ K f)) =
      toCompletion K (genericFibre K π S) (evalWashnitzerAlgebra hπ hπ1 x f) := by
  rw [ContinuousAlgEquiv.symm_apply_eq, genericFibreCompletionEquiv_toCompletion]

/-- **The weak completion lies in the unit ball of the generic fibre.** Every `z ∈ S†` has
supremum seminorm at most one in `K ⊗[K°] S†`. -/
theorem supSeminorm_one_tmul_le_one {π : O} (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1)
    (z : weakCompletion π S) : supSeminorm K ((1 : K) ⊗ₜ[O] z) ≤ 1 := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := O) (A := S)
  have hx : Algebra.adjoin O (Set.range ((↑) : s → S)) = ⊤ := by
    simpa only [Subtype.range_coe_subtype, Finset.setOfPred_mem] using hs
  obtain ⟨g, rfl⟩ := evalIntWashnitzerAlgebra_surjective hπ hπ1 _ hx z
  rw [← evalWashnitzerAlgebra_toWashnitzerAlgebra hπ hπ1]
  exact (washnitzerAlgebra.supSeminorm_map_le_norm
    (evalWashnitzerAlgebra_surjective hπ hπ1 _ hx) _).trans
    (intWashnitzerAlgebra.norm_toWashnitzerAlgebra_le_one g)

end NontriviallyNormedField

section NormedField

variable {K S : Type*} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [CommRing S] [Algebra (Subring.unitClosedBall K) S]
  [Algebra.FiniteType (Subring.unitClosedBall K) S]

local notation "O" => Subring.unitClosedBall K

/-- For `S` flat over a noetherian valuation ring `K°`, the weak completion embeds into its
generic fibre: `z ↦ 1 ⊗ z` is injective on `S†`. -/
theorem includeRight_injective_of_flat [IsNoetherianRing O] [Module.Flat O S]
    {π : O} (hπ : π ≠ 0) (hπ1 : ‖(π : K)‖ < 1) :
    Function.Injective
      (Algebra.TensorProduct.includeRight : weakCompletion π S →ₐ[O] genericFibre K π S) :=
  have := flat_of_flat_unitClosedBall (S := S) hπ hπ1
  Algebra.TensorProduct.includeRight_injective Subtype.val_injective

end NormedField

end TauCeti.Dagger.weakCompletion
