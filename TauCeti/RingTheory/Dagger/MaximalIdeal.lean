/-!
# Maximal ideals of the Monsky–Washnitzer algebra and of the Tate algebra

Let `K` be a complete ultrametric normed field, `W = K⟨X⟩†` the Monsky–Washnitzer algebra in
finitely many variables and `T = K⟨X⟩` the Tate algebra, with the dense inclusion
`toTate : W → T`. This file shows that `toTate` induces a bijection between the maximal ideals
of `T` and those of `W`, by contraction `m ↦ m ∩ W`, and that it preserves residue fields.
These are the classical points of an affinoid dagger polydisc and of its completion. The
comparison of ideals of finite codimension uses a nontrivially normed field, so that
finite-dimensional subspaces are closed.

* An ideal `I` of `W` with `I T = T` is already `W`. If `1` is a combination of elements of `I`
  with coefficients in `T`, approximating the coefficients in `W` gives an element `u ∈ I` with
  `‖1 - u‖ < 1`. It is a unit of `T`, hence of `W` by the unit criterion.
* For an ideal `I` of `T` of finite codimension over `K`, for instance a maximal ideal by the
  Nullstellensatz, `W ⧸ (I ∩ W) → T ⧸ I` is bijective and `I` is generated by `I ∩ W`. Every
  ideal of `T` is closed, and `W` is dense in `T`; a dense subspace meets every coset of a
  closed subspace of finite codimension, and is dense in that subspace.

Together, `m ↦ m ∩ W` is injective on maximal ideals of `T`, with maximal image, and every
maximal ideal `n` of `W` arises this way from a maximal ideal containing `n T ≠ T`.

## Main results

* `TauCeti.Dagger.washnitzerAlgebra.map_toTate_eq_top_iff`: `I T = T` iff `I = W`.
* `TauCeti.Dagger.washnitzerAlgebra.quotientMapₐ_toTate_bijective`: for an ideal `I` of `T` of
  finite codimension, `W ⧸ (I ∩ W) → T ⧸ I` is bijective.
* `TauCeti.Dagger.washnitzerAlgebra.map_comap_toTate`: such an ideal is generated by `I ∩ W`.
* `TauCeti.Dagger.washnitzerAlgebra.isMaximal_comap_toTate`: `m ∩ W` is maximal for every
  maximal ideal `m` of `T`.
* `TauCeti.Dagger.washnitzerAlgebra.existsUnique_isMaximal_comap`: every maximal ideal of `W` is
  `m ∩ W` for exactly one maximal ideal `m` of `T`.

## References

* E. Grosse-Klönne, *Rigid analytic spaces with overconvergent structure sheaf*,
  J. reine angew. Math. 519 (2000), Proposition 1.5.
-/

public section

namespace TauCeti.Dagger.washnitzerAlgebra

open _root_.MvPowerSeries

section Faithful

variable {σ K : Type*} [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- **Faithfulness of `W → T` on ideals.** Over a complete ultrametric normed field, an ideal of
the Monsky–Washnitzer algebra generates the unit ideal of the Tate algebra only if it is the unit
ideal. -/
theorem map_toTate_eq_top_iff {I : Ideal (washnitzerAlgebra σ K)} :
    I.map (toTate σ K) = ⊤ ↔ I = ⊤ := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ Ideal.map_top _⟩
  -- The extension `I T` lies in the closure of the image of `I`: that closure is an additive
  -- subgroup, and is stable under multiplication by `closure W = T` because `W * I ⊆ I`.
  let G := (I.toAddSubgroup.map (toTate σ K).toRingHom.toAddMonoidHom).topologicalClosure
  have h1 : (1 : IsRestricted.subring (R := K) (fun _ : σ ↦ (1 : ℝ))) ∈ G := by
    refine Submodule.span_induction (p := fun x _ ↦ x ∈ G) (fun _ hx ↦ subset_closure hx)
      G.zero_mem (fun _ _ _ _ ↦ G.add_mem) (fun a y _ hy ↦ ?_) (h ▸ Submodule.mem_top (x := 1))
    refine map_mem_closure₂ continuous_mul (denseRange_toTate a) hy ?_
    rintro _ ⟨w, rfl⟩ _ ⟨u, hu, rfl⟩
    exact ⟨w * u, I.mul_mem_left w hu, map_mul (toTate σ K) w u⟩
  obtain ⟨_, ⟨u, hu, rfl⟩, hlt⟩ := Metric.mem_closure_iff.1 h1 1 one_pos
  rw [dist_eq_norm] at hlt
  have hunit : IsUnit (toTate σ K u) := by simpa using (Units.oneSub _ hlt).isUnit
  exact Ideal.eq_top_of_isUnit_mem I hu ((isUnit_toTate_iff u).1 hunit)

end Faithful

section Maximal

variable {σ K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K]

local notation "T" => IsRestricted.subring (R := K) (fun _ : σ ↦ (1 : ℝ))

private theorem finiteDimensional_quotient_restrictScalars (I : Ideal T)
    [Module.Finite K (T ⧸ I)] : FiniteDimensional K (T ⧸ I.restrictScalars K) :=
  Module.Finite.equiv (Submodule.Quotient.restrictScalarsEquiv K I).symm

/-- The image of `W` is dense in the Tate algebra, as a `K`-subspace. -/
private theorem dense_range_toTate :
    Dense (LinearMap.range (toTate σ K).toLinearMap : Set T) := by
  rw [LinearMap.coe_range, AlgHom.coe_toLinearMap]
  exact denseRange_toTate

variable [CompleteSpace K] [Finite σ]

/-- The ideal `I`, viewed as a closed `K`-subspace of the Tate algebra. -/
private theorem isClosed_restrictScalars (I : Ideal T) :
    IsClosed ((I.restrictScalars K : Submodule K T) : Set T) :=
  TauCeti.MvPowerSeries.isClosed_ideal_isRestrictedSubring I

/-- **Residue algebras of `W` and `T` agree.** For an ideal `I` of the Tate algebra in finitely
many variables of finite codimension over `K`, the inclusion `W → T` induces a bijection
`W ⧸ (I ∩ W) → T ⧸ I`. -/
theorem quotientMapₐ_toTate_bijective (I : Ideal T) [Module.Finite K (T ⧸ I)] :
    Function.Bijective (Ideal.quotientMapₐ (I := I.comap (toTate σ K)) I (toTate σ K) le_rfl) := by
  have := finiteDimensional_quotient_restrictScalars I
  refine ⟨Ideal.quotientMap_injective, fun y ↦ ?_⟩
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  have hx := (Submodule.sup_eq_top_of_dense (isClosed_restrictScalars I) dense_range_toTate).ge
    (Submodule.mem_top (x := x))
  obtain ⟨s, hs, _, ⟨w, rfl⟩, rfl⟩ := Submodule.mem_sup.1 hx
  refine ⟨Ideal.Quotient.mk _ w, ?_⟩
  rw [Ideal.quotient_map_mkₐ, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq]
  simpa using I.neg_mem hs

/-- **An ideal of finite codimension is generated by its overconvergent elements.** For an ideal
`I` of the Tate algebra in finitely many variables of finite codimension over `K`, the extension
of `I ∩ W` to the Tate algebra is `I`. -/
theorem map_comap_toTate (I : Ideal T) [Module.Finite K (T ⧸ I)] :
    (I.comap (toTate σ K)).map (toTate σ K) = I := by
  have := finiteDimensional_quotient_restrictScalars I
  refine le_antisymm Ideal.map_comap_le fun x hx ↦ ?_
  -- `I` is the closure of `I ∩ W`, and the extension of `I ∩ W` is a closed ideal containing it.
  have hcl := Submodule.closure_inf_eq_of_dense (isClosed_restrictScalars I) dense_range_toTate
  rw [← SetLike.mem_coe, ← (TauCeti.MvPowerSeries.isClosed_ideal_isRestrictedSubring _).closure_eq]
  refine closure_mono ?_ (hcl.ge hx)
  rintro _ ⟨hxI, w, rfl⟩
  exact Ideal.mem_map_of_mem _ (Ideal.mem_comap.2 hxI)

/-- **Contractions of maximal ideals are maximal.** For a maximal ideal `m` of the Tate algebra
in finitely many variables, `m ∩ W` is a maximal ideal of the Monsky–Washnitzer algebra. -/
theorem isMaximal_comap_toTate (m : Ideal T) [m.IsMaximal] :
    (m.comap (toTate σ K)).IsMaximal := by
  have := TauCeti.MvPowerSeries.finite_quotient_of_isMaximal m
  refine (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).2 ?_
  exact MulEquiv.isField ((Ideal.Quotient.maximal_ideal_iff_isField_quotient m).1 ‹_›)
    (AlgEquiv.ofBijective _ (quotientMapₐ_toTate_bijective m)).toMulEquiv

/-- **Maximal ideals of `W` and `T` correspond.** Every maximal ideal `n` of the
Monsky–Washnitzer algebra in finitely many variables is `m ∩ W` for exactly one maximal ideal
`m` of the Tate algebra. -/
theorem existsUnique_isMaximal_comap (n : Ideal (washnitzerAlgebra σ K)) [n.IsMaximal] :
    ∃! m : Ideal T, m.IsMaximal ∧ m.comap (toTate σ K) = n := by
  obtain ⟨m, hm, hnm⟩ := Ideal.exists_le_maximal (n.map (toTate σ K))
    (map_toTate_eq_top_iff.not.2 (Ideal.IsMaximal.ne_top ‹_›))
  have hcomap : m.comap (toTate σ K) = n :=
    ((Ideal.IsMaximal.eq_of_le ‹_› (Ideal.comap_ne_top _ hm.ne_top)
      (Ideal.map_le_iff_le_comap.1 hnm))).symm
  refine ⟨m, ⟨hm, hcomap⟩, fun m' ⟨hm', hcomap'⟩ ↦ ?_⟩
  have := TauCeti.MvPowerSeries.finite_quotient_of_isMaximal m
  have := TauCeti.MvPowerSeries.finite_quotient_of_isMaximal m'
  rw [← map_comap_toTate m, ← map_comap_toTate m', hcomap, hcomap']

end Maximal

end TauCeti.Dagger.washnitzerAlgebra
