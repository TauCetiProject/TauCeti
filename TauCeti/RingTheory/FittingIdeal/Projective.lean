module

public import Mathlib.RingTheory.LocalProperties.Projective
public import Mathlib.RingTheory.Localization.BaseChange
public import TauCeti.RingTheory.FittingIdeal.BaseChange
public import TauCeti.RingTheory.FittingIdeal.LocalRing
public import TauCeti.RingTheory.FittingIdeal.Matrix
public import TauCeti.RingTheory.Idempotents.Connected.Spectrum
public import TauCeti.RingTheory.LocalRing.Module

/-!
# Fitting ideals of projective modules

A finitely presented module is projective exactly when all its Fitting ideals are idempotent.
Equivalently, by `Ideal.isIdempotentElem_iff_of_fg`, each Fitting ideal is generated by an
idempotent element.

The argument is local. The Fitting ideals of a finitely presented module are finitely generated
(`TauCeti.fittingIdeal_fg`), and they commute with localization. A finitely generated idempotent
ideal of a local ring is `⊥` or `⊤`. Over a local ring `R` with residue field `κ`, a finite module
`M` all of whose Fitting ideals are `⊥` or `⊤` is free: lifting a basis of `κ ⊗[R] M` gives a
surjection `φ : R ^ μ → M` with `μ = dim_κ κ ⊗[R] M`, and `Fitt_{μ - 1}(M) ≤ 𝔪` is the ideal of
coordinates of the relations `ker φ`, so it is `⊥` and `φ` is an isomorphism. Conversely a free
module of rank `r` has `Fitt_k = ⊥` for `k < r` and `Fitt_k = ⊤` for `k ≥ r`.

The criterion turns the projectivity of a finitely presented module into a statement about ideals;
this is how one shows that a finitely presented module over a perfect ring of characteristic `p`
with a Frobenius-semilinear automorphism is projective
(`TauCeti.projective_of_addEquiv_iterateFrobenius`).

## Main results

* `TauCeti.fittingIdeal_eq_bot_or_eq_top_of_free`: the Fitting ideals of a finite free module are
  `⊥` or `⊤`.
* `TauCeti.free_iff_forall_fittingIdeal_eq_bot_or_eq_top`: over a local ring, a finite module is
  free exactly when each of its Fitting ideals is `⊥` or `⊤`.
* `TauCeti.projective_iff_forall_isIdempotentElem_fittingIdeal`: a finitely presented module is
  projective exactly when each of its Fitting ideals is idempotent.

## References

* [Stacks Project, Tag 07Z6](https://stacks.math.columbia.edu/tag/07Z6): Fitting ideals and their
  relation to finite locally free modules.
-/

public section

noncomputable section

open Function LinearMap Module IsLocalRing TensorProduct

namespace TauCeti

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- The Fitting ideals of a finite free module are `⊥` or `⊤`. -/
theorem fittingIdeal_eq_bot_or_eq_top_of_free [Module.Free R M] [Module.Finite R M] (k : ℕ) :
    fittingIdeal R M k = ⊥ ∨ fittingIdeal R M k = ⊤ := by
  rcases lt_or_ge k (finrank R M) with hk | hk
  · exact Or.inl (fittingIdeal_eq_bot_of_lt_finrank hk)
  · exact Or.inr (fittingIdeal_eq_top_of_surjective (φ := LinearMap.id) surjective_id hk)

section IsLocalRing

variable [IsLocalRing R] [Module.Finite R M]

/-- Over a local ring, a finite module whose Fitting ideals are all `⊥` or `⊤` is free. -/
theorem free_of_forall_fittingIdeal_eq_bot_or_eq_top
    (h : ∀ k, fittingIdeal R M k = ⊥ ∨ fittingIdeal R M k = ⊤) : Module.Free R M := by
  set μ := finrank (ResidueField R) (ResidueField R ⊗[R] M)
  obtain ⟨φ, hφ, -⟩ := IsLocalRing.exists_surjective_ker_le_maximalIdeal_smul (R := R) (M := M)
  -- The relations of `φ` vanish, since their coordinates generate `Fitt_{μ - 1}(M) ≤ 𝔪`.
  have hker : ker φ = ⊥ := by
    rcases Nat.eq_zero_or_pos μ with hμ | hμ
    · have : Subsingleton (Fin μ → R) := by rw [hμ]; infer_instance
      exact Subsingleton.elim _ _
    have hle : fittingIdeal R M (μ - 1) ≤ maximalIdeal R := by
      have := fittingIdeal_le_maximalIdeal_pow (R := R) (M := M) (μ - 1)
      rwa [show μ - (μ - 1) = 1 by omega, pow_one] at this
    have hbot : fittingIdeal R M (μ - 1) = ⊥ := (h _).resolve_right fun htop ↦
      (maximalIdeal.isMaximal R).ne_top (top_le_iff.1 (htop ▸ hle))
    rw [fittingIdeal_eq_minorsIdeal_ker hφ, finrank_fin_fun, show μ - (μ - 1) = 1 by omega]
      at hbot
    refine eq_bot_iff.2 fun x hx ↦ (Submodule.mem_bot R).2 <| funext fun i ↦ ?_
    simpa [hbot] using (LinearMap.proj i : (Fin μ → R) →ₗ[R] R).apply_mem_minorsIdeal_one hx
  exact Module.Free.of_equiv (LinearEquiv.ofBijective φ ⟨ker_eq_bot.1 hker, hφ⟩)

/-- **Fitting ideals detect freeness over a local ring**: a finite module over a local ring is
free exactly when each of its Fitting ideals is `⊥` or `⊤`. -/
theorem free_iff_forall_fittingIdeal_eq_bot_or_eq_top :
    Module.Free R M ↔ ∀ k, fittingIdeal R M k = ⊥ ∨ fittingIdeal R M k = ⊤ :=
  ⟨fun _ ↦ fittingIdeal_eq_bot_or_eq_top_of_free, free_of_forall_fittingIdeal_eq_bot_or_eq_top⟩

end IsLocalRing

/-- **Fitting ideals detect projectivity**: a finitely presented module is projective exactly
when each of its Fitting ideals is idempotent, that is, generated by an idempotent element. -/
theorem projective_iff_forall_isIdempotentElem_fittingIdeal [Module.FinitePresentation R M] :
    Module.Projective R M ↔ ∀ k, IsIdempotentElem (fittingIdeal R M k) := by
  -- The Fitting ideals commute with localization, which is a base change.
  have hloc (P : Ideal R) [P.IsPrime] (k : ℕ) :
      fittingIdeal (Localization.AtPrime P) (LocalizedModule P.primeCompl M) k =
        (fittingIdeal R M k).map (algebraMap R (Localization.AtPrime P)) :=
    (IsLocalizedModule.isBaseChange P.primeCompl (Localization.AtPrime P)
      (LocalizedModule.mkLinearMap P.primeCompl M)).fittingIdeal_eq_map k
  refine ⟨fun _ k ↦ ?_, fun h ↦ Module.projective_of_localization_maximal fun P _ ↦ ?_⟩
  · -- Idempotence is a local property, and the localizations of `M` are free.
    refine Ideal.eq_of_localization_maximal fun P _ ↦ ?_
    have : Module.Free (Localization.AtPrime P) (LocalizedModule P.primeCompl M) :=
      Module.free_of_flat_of_isLocalRing
    rw [Ideal.map_mul, ← hloc]
    rcases fittingIdeal_eq_bot_or_eq_top_of_free
      (R := Localization.AtPrime P) (M := LocalizedModule P.primeCompl M) k with h | h <;>
      simp [h]
  · -- At a maximal ideal, the Fitting ideals are finitely generated and idempotent, hence
    -- `⊥` or `⊤`, so the localization of `M` is free.
    let Rₚ := Localization.AtPrime P
    let Mₚ := LocalizedModule P.primeCompl M
    have hfg (k : ℕ) : (fittingIdeal Rₚ Mₚ k).FG := fittingIdeal_fg k
    have : Module.Free Rₚ Mₚ := free_of_forall_fittingIdeal_eq_bot_or_eq_top fun k ↦ by
      refine or_iff_not_imp_right.2 (Ideal.eq_bot_of_isIdempotentElem_of_ne_top (hfg k) ?_)
      rw [IsIdempotentElem, hloc, ← Ideal.map_mul, (h k).eq]
    infer_instance

end TauCeti
