module

public import TauCeti.RingTheory.FittingIdeal.Basic

/-!
# The Fitting ideal of a square presentation

The zeroth Fitting ideal of the cokernel of an endomorphism of a finite free module is
principal, generated by its determinant. This connects determinant formulas for invariants
with invariants defined using presentations, without choosing a basis in the statement.
For a square presentation matrix, the corresponding formulas use its matrix determinant.

## References

* [Stacks Project, Tag 07Z6](https://stacks.math.columbia.edu/tag/07Z6), Lemma 15.8.2
  (Fitting ideals computed from a presentation matrix).
-/

public section

noncomputable section

open Module Submodule

namespace LinearMap

variable {R F : Type*} [CommRing R] [AddCommGroup F] [Module R F]
  [Module.Free R F] [Module.Finite R F]

/-- The maximal minors of the image of an endomorphism of a finite free module generate
the principal ideal of its determinant. -/
@[simp]
theorem minorsIdeal_range_finrank_eq_span_det (φ : F →ₗ[R] F) :
    (LinearMap.range φ).minorsIdeal (Module.finrank R F) = Ideal.span {φ.det} := by
  classical
  nontriviality R
  let b := Module.finBasis R F
  refine le_antisymm (Submodule.minorsIdeal_le_iff.mpr ?_) (Ideal.span_le.mpr ?_)
  · intro f v hv
    -- Factor a maximal minor through `φ` by choosing preimages of its vectors.
    choose w hw using hv
    let ω : F [⋀^Fin (finrank R F)]→ₗ[R] R :=
      Matrix.detRowAlternating.compLinearMap (LinearMap.pi f)
    have hdet : (Matrix.of fun i j => f j (v i)).det = φ.det * ω w := by
      have hscale := congr($(AlternatingMap.compLinearMap_eq_det_smul b ω φ) w)
      rw [AlternatingMap.compLinearMap_apply, AlternatingMap.smul_apply, smul_eq_mul] at hscale
      simpa only [ω, AlternatingMap.compLinearMap_apply, Matrix.detRowAlternating_pi_apply,
        hw] using hscale
    rw [hdet]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  · rintro _ (rfl : _ = φ.det)
    have hmatrix : (Matrix.of fun i j => b.coord j (φ (b i))) =
        (LinearMap.toMatrix b b φ).transpose := by
      ext i j
      simp [LinearMap.toMatrix_apply]
    have h := Submodule.det_mem_minorsIdeal (N := LinearMap.range φ)
      (fun j => b.coord j) (v := fun i => φ (b i)) (fun i => ⟨b i, rfl⟩)
    rwa [hmatrix, Matrix.det_transpose, LinearMap.det_toMatrix] at h

/-- The zeroth Fitting ideal of a square finite free presentation is generated by the
determinant of its relation endomorphism. -/
theorem fittingIdeal_zero_eq_span_det_of_ker_eq_range (φ : F →ₗ[R] F)
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    {π : F →ₗ[R] M} (hπ : Function.Surjective π) (h : ker π = range φ) :
    TauCeti.fittingIdeal R M 0 = Ideal.span {φ.det} := by
  rw [TauCeti.fittingIdeal_eq_minorsIdeal_ker hπ, h, Nat.sub_zero,
    φ.minorsIdeal_range_finrank_eq_span_det]

/-- The zeroth Fitting ideal of the cokernel of a finite free endomorphism is generated by
its determinant. -/
@[simp]
theorem fittingIdeal_coker_zero_eq_span_det (φ : F →ₗ[R] F) :
    TauCeti.fittingIdeal R (F ⧸ LinearMap.range φ) 0 = Ideal.span {φ.det} := by
  exact φ.fittingIdeal_zero_eq_span_det_of_ker_eq_range
    (Submodule.mkQ_surjective (LinearMap.range φ)) (Submodule.ker_mkQ _)

end LinearMap

namespace Matrix

variable {R ι : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]

/-- The zeroth Fitting ideal of a module presented by a square matrix is generated by
the determinant of that matrix. -/
theorem fittingIdeal_zero_eq_span_det_of_ker_eq_range (A : Matrix ι ι R)
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    {π : (ι → R) →ₗ[R] M} (hπ : Function.Surjective π)
    (h : LinearMap.ker π = LinearMap.range A.mulVecLin) :
    TauCeti.fittingIdeal R M 0 = Ideal.span {A.det} := by
  rw [LinearMap.fittingIdeal_zero_eq_span_det_of_ker_eq_range _ hπ h,
    ← Matrix.toLin'_apply', LinearMap.det_toLin']

/-- The zeroth Fitting ideal of the cokernel of a square matrix is generated by its determinant. -/
-- The priority selects the matrix determinant ahead of the general endomorphism formula.
@[simp 1050]
theorem fittingIdeal_coker_zero_eq_span_det (A : Matrix ι ι R) :
    TauCeti.fittingIdeal R ((ι → R) ⧸ LinearMap.range A.mulVecLin) 0 = Ideal.span {A.det} := by
  exact A.fittingIdeal_zero_eq_span_det_of_ker_eq_range
    (Submodule.mkQ_surjective _) (Submodule.ker_mkQ _)

end Matrix
