module

public import TauCeti.RingTheory.FittingIdeal.Basic

/-!
# The Fitting ideal of a square presentation

The zeroth Fitting ideal of the cokernel of an endomorphism of a finite free module is
principal, generated by its determinant. This connects determinant formulas for invariants
with invariants defined using presentations, without choosing a basis in the statement.
For a square presentation matrix, the corresponding formulas use its matrix determinant.

More generally, the maximal minors of any submodule `N` of a free module `F` of finite rank are
generated by the determinants, in a fixed basis of `F`, of families in `N`. By Cramer's rule each
such determinant multiplies `F` into `N`, so the zeroth Fitting ideal of a finite module
annihilates it.

## Main results

* `LinearMap.fittingIdeal_coker_zero_eq_span_det`: `Fitt₀(coker φ) = (det φ)`.
* `Submodule.minorsIdeal_eq_span_det`: the maximal minors of `N` are generated by the basis
  determinants of families in `N`.
* `Submodule.minorsIdeal_finrank_le_colon`: the maximal minors of `N` multiply `F` into `N`.
* `TauCeti.fittingIdeal_zero_le_annihilator`: `Fitt₀(M) ≤ Ann(M)`.

## References

* [Stacks Project, Tag 07Z6](https://stacks.math.columbia.edu/tag/07Z6), Lemma 15.8.2
  (Fitting ideals computed from a presentation matrix).
* [Stacks Project, Tag 07ZA](https://stacks.math.columbia.edu/tag/07ZA), Lemma 15.8.4 (6)
  (the zeroth Fitting ideal annihilates the module).
-/

public section

noncomputable section

open Module Submodule

namespace Submodule

variable {R F : Type*} [CommRing R] [AddCommGroup F] [Module R F]

/-- The `p × p` minors of a submodule `N` of a module with a basis `b` of size `p` generate the
same ideal as the `b`-determinants of families in `N`. -/
theorem minorsIdeal_eq_span_det {p : ℕ} (b : Basis (Fin p) R F) (N : Submodule R F) :
    N.minorsIdeal p = Ideal.span {r | ∃ v : Fin p → F, (∀ i, v i ∈ N) ∧ b.det v = r} := by
  refine le_antisymm (minorsIdeal_le_iff.2 fun f v hv ↦ ?_) (Ideal.span_le.2 ?_)
  · -- A minor is a top-degree alternating form evaluated at `v`, so a multiple of `b.det v`.
    let ω : F [⋀^Fin p]→ₗ[R] R := Matrix.detRowAlternating.compLinearMap (LinearMap.pi f)
    have hdet : (Matrix.of fun i j => f j (v i)).det = b.det v * ω b := by
      have h := congr($(AlternatingMap.eq_basis_det_smulRight b ω) v)
      rw [AlternatingMap.smulRight_apply, smul_eq_mul] at h
      simpa only [ω, AlternatingMap.compLinearMap_apply, Matrix.detRowAlternating_pi_apply]
        using h
    rw [hdet]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨v, hv, rfl⟩)
  · rintro _ ⟨v, hv, rfl⟩
    have hmatrix : (Matrix.of fun i j => b.coord j (v i)) = (b.toMatrix v).transpose := by
      ext i j
      simp [Basis.toMatrix_apply]
    have h := det_mem_minorsIdeal (fun j => b.coord j) hv
    rwa [hmatrix, Matrix.det_transpose, ← Basis.det_apply] at h

end Submodule

namespace LinearMap

variable {R F : Type*} [CommRing R] [AddCommGroup F] [Module R F]
  [Module.Free R F] [Module.Finite R F]

/-- The maximal minors of the image of an endomorphism of a finite free module generate
the principal ideal of its determinant. -/
@[simp]
theorem minorsIdeal_range_finrank_eq_span_det (φ : F →ₗ[R] F) :
    (LinearMap.range φ).minorsIdeal (Module.finrank R F) = Ideal.span {φ.det} := by
  nontriviality R
  let b := Module.finBasis R F
  rw [Submodule.minorsIdeal_eq_span_det b]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · -- A family in the range of `φ` is the image of a family whose determinant scales by `det φ`.
    rintro _ ⟨v, hv, rfl⟩
    choose w hw using hv
    rw [show v = φ ∘ w from funext fun i ↦ (hw i).symm, SetLike.mem_coe, Basis.det_comp]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · rintro _ (rfl : _ = φ.det)
    exact Ideal.subset_span ⟨φ ∘ b, fun i ↦ mem_range_self φ (b i), by
      rw [Basis.det_comp, Basis.det_self, mul_one]⟩

/-- The zeroth Fitting ideal of a square finite free presentation is generated by the
determinant of its relation endomorphism. -/
theorem fittingIdeal_zero_eq_span_det_of_ker_eq_range (φ : F →ₗ[R] F)
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    {π : F →ₗ[R] M} (hπ : Function.Surjective π) (h : ker π = range φ) :
    TauCeti.fittingIdeal R M 0 = Ideal.span {φ.det} := by
  rw [TauCeti.fittingIdeal_eq_minorsIdeal_ker hπ, h, Nat.sub_zero,
    φ.minorsIdeal_range_finrank_eq_span_det]

/-- The zeroth Fitting ideal of the cokernel of a finite free endomorphism is generated by
its determinant. -/
@[simp]
theorem fittingIdeal_coker_zero_eq_span_det (φ : F →ₗ[R] F) :
    TauCeti.fittingIdeal R (F ⧸ LinearMap.range φ) 0 = Ideal.span {φ.det} := by
  exact φ.fittingIdeal_zero_eq_span_det_of_ker_eq_range
    (Submodule.mkQ_surjective (LinearMap.range φ)) (Submodule.ker_mkQ _)

end LinearMap

namespace Submodule

variable {R F : Type*} [CommRing R] [AddCommGroup F] [Module R F]

/-- The maximal minors of a submodule `N` of a free module of finite rank multiply the whole
module into `N`. -/
theorem minorsIdeal_finrank_le_colon [Module.Free R F] [Module.Finite R F] (N : Submodule R F) :
    N.minorsIdeal (finrank R F) ≤ N.colon Set.univ := by
  nontriviality R
  let b := Module.finBasis R F
  rw [minorsIdeal_eq_span_det b, Ideal.span_le]
  rintro _ ⟨v, hv, rfl⟩
  refine mem_colon.2 fun x _ ↦ ?_
  -- `b.det v` is the determinant of the endomorphism sending `b i` to `v i`, whose range is the
  -- span of the `v i`.
  have hdet : b.det v = LinearMap.det (b.constr ℕ v) := by
    rw [Basis.det_apply, Basis.toMatrix_eq_toMatrix_constr, LinearMap.det_toMatrix]
  have hrange : LinearMap.range (b.constr ℕ v) ≤ N := by
    rw [Basis.constr_range]
    exact span_le.2 (Set.range_subset_iff.2 hv)
  exact hdet ▸ hrange ((b.constr ℕ v).det_smul_mem_range x)

end Submodule

namespace TauCeti

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]

/-- The zeroth Fitting ideal of a finite module annihilates it. -/
theorem fittingIdeal_zero_le_annihilator : fittingIdeal R M 0 ≤ Module.annihilator R M := by
  obtain ⟨n, φ, hφ⟩ := Module.Finite.exists_fin' R M
  rw [fittingIdeal_eq_minorsIdeal_ker hφ, Nat.sub_zero]
  refine (minorsIdeal_finrank_le_colon _).trans fun r hr ↦ Module.mem_annihilator.2 fun m ↦ ?_
  obtain ⟨x, rfl⟩ := hφ m
  rw [← map_smul]
  exact mem_colon.1 hr x trivial

end TauCeti

namespace Matrix

variable {R ι : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]

/-- The zeroth Fitting ideal of a module presented by a square matrix is generated by
the determinant of that matrix. -/
theorem fittingIdeal_zero_eq_span_det_of_ker_eq_range (A : Matrix ι ι R)
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    {π : (ι → R) →ₗ[R] M} (hπ : Function.Surjective π)
    (h : LinearMap.ker π = LinearMap.range A.mulVecLin) :
    TauCeti.fittingIdeal R M 0 = Ideal.span {A.det} := by
  rw [LinearMap.fittingIdeal_zero_eq_span_det_of_ker_eq_range _ hπ h,
    ← Matrix.toLin'_apply', LinearMap.det_toLin']

/-- The zeroth Fitting ideal of the cokernel of a square matrix is generated by its determinant. -/
-- The priority selects the matrix determinant ahead of the general endomorphism formula.
@[simp 1050]
theorem fittingIdeal_coker_zero_eq_span_det (A : Matrix ι ι R) :
    TauCeti.fittingIdeal R ((ι → R) ⧸ LinearMap.range A.mulVecLin) 0 = Ideal.span {A.det} := by
  exact A.fittingIdeal_zero_eq_span_det_of_ker_eq_range
    (Submodule.mkQ_surjective _) (Submodule.ker_mkQ _)

end Matrix
