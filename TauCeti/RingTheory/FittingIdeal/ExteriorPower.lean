module

public import Mathlib.LinearAlgebra.ExteriorPower.Basic
public import TauCeti.RingTheory.FittingIdeal.Basic

import TauCeti.LinearAlgebra.Matrix.Compound
import TauCeti.RingTheory.FittingIdeal.Determinant

/-!
# Fitting ideals annihilate exterior-power cokernels

For a finite `R`-module `M` over a commutative ring `R`, a submodule `N ≤ M`, and any `r : ℕ`,
the zeroth Fitting ideal `TauCeti.fittingIdeal R (M ⧸ N) 0` annihilates the cokernel of the natural
map `exteriorPower.map r N.subtype : ⋀[R]^r N →ₗ[R] ⋀[R]^r M`.

For `r = 1` this recovers `Fitt₀(M ⧸ N) ≤ Ann_R(M ⧸ N)`
(`TauCeti.fittingIdeal_zero_le_annihilator`). For `r ≥ 2`, `Ann_R(M ⧸ N)` itself does *not* in
general annihilate `coker(⋀^r N → ⋀^r M)`: for `M = ℤ²` and `N = 2ℤ²` with `r = 2`,
`Ann_ℤ(M ⧸ N) = (2)` fails to annihilate `coker(⋀^2 N → ⋀^2 M) ≅ ℤ/4ℤ`, whereas
`Fitt₀(M ⧸ N) = (4)` annihilates it (proved as a negative control at the end of this file).

## Proof idea

Choose a surjection `π : F →ₗ[R] M` from a finite free `R`-module `F` and set `K = N.comap π`, the
kernel of the composite surjection `N.mkQ ∘ₗ π : F →ₗ[R] M ⧸ N`. Then `Fitt₀(M ⧸ N)` is the ideal
`K.minorsIdeal (finrank R F)` of maximal minors of `K`, generated by basis determinants `b.det v`
of families `v` in `K`. Each family `v` defines an endomorphism `φ : F →ₗ[R] F` factoring through
`K`, and higher Cramer's rule (`LinearMap.det_smul_mem_range_exteriorPower_map`) shows that
`det φ = b.det v` multiplies `⋀[R]^r F` into `range (exteriorPower.map r K.subtype)`. Pushing
forward along the surjective map `exteriorPower.map r π : ⋀[R]^r F →ₗ[R] ⋀[R]^r M` lands inside
`range (exteriorPower.map r N.subtype)`.

## Main results

* `Submodule.minorsIdeal_finrank_le_colon_exteriorPower`: the maximal minors of a submodule `N` of
  a finite free module `F` multiply `⋀[R]^r F` into
  `LinearMap.range (exteriorPower.map r N.subtype)`.
* `TauCeti.smul_mem_range_exteriorPower_map_of_mem_fittingIdeal`: elements of
  `TauCeti.fittingIdeal R (M ⧸ N) 0` multiply `⋀[R]^r M` into
  `LinearMap.range (exteriorPower.map r N.subtype)`.
* `TauCeti.fittingIdeal_le_annihilator_exteriorPower_cokernel`: `Fitt₀(M ⧸ N)` annihilates
  `↥(⋀[R]^r M) ⧸ LinearMap.range (exteriorPower.map r N.subtype)` (Dasgupta–Kakde, Lemma 3.9).
* `LinearMap.fittingIdeal_coker_le_annihilator_exteriorPower_coker`: the linear-map form for any
  `f : P →ₗ[R] M` into a finite `R`-module `M`.

## Implementation notes

Dasgupta–Kakde state Lemma 3.9 assuming `M` is finitely presented, `N` is finitely generated, and
`r ≥ 1`. Because `TauCeti.fittingIdeal` is defined for every finite module via arbitrary generating
families of the presentation kernel, only `[Module.Finite R M]` is needed here, with no hypotheses
on `N` or `r`.

## References

* [S. Dasgupta and M. Kakde, *On the Brumer–Stark conjecture*, Lemma 3.9][dasguptakakde2023]
-/

public section

open Module Submodule

namespace Submodule

/-- The maximal minors of a submodule `N` of a finite free module `F` multiply `⋀[R]^r F` into
`LinearMap.range (exteriorPower.map r N.subtype)`. -/
theorem minorsIdeal_finrank_le_colon_exteriorPower {R F : Type*} [CommRing R] [AddCommGroup F]
    [Module R F] [Module.Free R F] [Module.Finite R F] (N : Submodule R F) (r : ℕ) :
    N.minorsIdeal (finrank R F) ≤
      (LinearMap.range (exteriorPower.map r N.subtype)).colon Set.univ := by
  nontriviality R
  let b := Module.finBasis R F
  rw [minorsIdeal_eq_span_det b, Ideal.span_le]
  rintro _ ⟨v, hv, rfl⟩
  refine mem_colon.2 fun z _ ↦ ?_
  -- Factor `b.constr ℕ v : F →ₗ[R] F` through `N` and apply determinant control on `⋀[R]^r F`.
  let ψ : F →ₗ[R] N := b.constr ℕ fun i ↦ ⟨v i, hv i⟩
  have hcomp : N.subtype ∘ₗ ψ = b.constr ℕ v :=
    b.ext fun i ↦ by simp [ψ]
  have hdet : b.det v = LinearMap.det (N.subtype ∘ₗ ψ) := by
    rw [hcomp, Basis.det_apply, Basis.toMatrix_eq_toMatrix_constr, LinearMap.det_toMatrix]
  obtain ⟨w, hw⟩ := (N.subtype ∘ₗ ψ).det_smul_mem_range_exteriorPower_map r z
  refine ⟨exteriorPower.map r ψ w, ?_⟩
  rw [← LinearMap.comp_apply, ← exteriorPower.map_comp, hdet]
  exact hw

end Submodule

namespace TauCeti

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]

/-- Every element of `TauCeti.fittingIdeal R (M ⧸ N) 0` multiplies every element of `⋀[R]^r M`
into `LinearMap.range (exteriorPower.map r N.subtype)`. -/
theorem smul_mem_range_exteriorPower_map_of_mem_fittingIdeal (N : Submodule R M) (r : ℕ)
    {a : R} (ha : a ∈ fittingIdeal R (M ⧸ N) 0) (z : ⋀[R]^r M) :
    a • z ∈ LinearMap.range (exteriorPower.map r N.subtype) := by
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' R M
  have hsurj : Function.Surjective (N.mkQ ∘ₗ π) := (Submodule.mkQ_surjective N).comp hπ
  have hker : LinearMap.ker (N.mkQ ∘ₗ π) = N.comap π := by
    rw [LinearMap.ker_comp, Submodule.ker_mkQ]
  rw [fittingIdeal_eq_minorsIdeal_ker hsurj, Nat.sub_zero, hker] at ha
  let K : Submodule R (Fin n → R) := N.comap π
  let πK : K →ₗ[R] N := (π ∘ₗ K.subtype).codRestrict N fun x ↦ x.prop
  have hcomm : N.subtype ∘ₗ πK = π ∘ₗ K.subtype := by
    ext x
    rfl
  obtain ⟨y, rfl⟩ := exteriorPower.map_surjective hπ z
  obtain ⟨u, hu⟩ := mem_colon.1 (K.minorsIdeal_finrank_le_colon_exteriorPower r ha) y trivial
  refine ⟨exteriorPower.map r πK u, ?_⟩
  rw [← LinearMap.comp_apply, ← exteriorPower.map_comp, hcomm, exteriorPower.map_comp,
    LinearMap.comp_apply, hu, map_smul]

/-- **Fitting ideals annihilate exterior-power cokernels** (Dasgupta–Kakde, Lemma 3.9). For a
finite `R`-module `M`, a submodule `N ≤ M`, and any `r : ℕ`, the zeroth Fitting ideal of `M ⧸ N`
annihilates the cokernel of `exteriorPower.map r N.subtype : ⋀[R]^r N →ₗ[R] ⋀[R]^r M`. -/
theorem fittingIdeal_le_annihilator_exteriorPower_cokernel (N : Submodule R M) (r : ℕ) :
    fittingIdeal R (M ⧸ N) 0 ≤
      Module.annihilator R (↥(⋀[R]^r M) ⧸ LinearMap.range (exteriorPower.map r N.subtype)) := by
  intro a ha
  refine Module.mem_annihilator.2 fun q ↦ ?_
  induction q using Submodule.Quotient.induction_on with
  | H z =>
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
    exact smul_mem_range_exteriorPower_map_of_mem_fittingIdeal N r ha z

end TauCeti

namespace LinearMap

/-- **Linear-map form of exterior-power cokernel annihilation.** For any linear map `f : P →ₗ[R] M`
into a finite `R`-module `M` and any `r : ℕ`, the zeroth Fitting ideal of `M ⧸ LinearMap.range f`
annihilates the cokernel of `exteriorPower.map r f : ⋀[R]^r P →ₗ[R] ⋀[R]^r M`. -/
theorem fittingIdeal_coker_le_annihilator_exteriorPower_coker {R P M : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [AddCommGroup M] [Module R M] [Module.Finite R M]
    (f : P →ₗ[R] M) (r : ℕ) :
    TauCeti.fittingIdeal R (M ⧸ LinearMap.range f) 0 ≤
      Module.annihilator R (↥(⋀[R]^r M) ⧸ LinearMap.range (exteriorPower.map r f)) := by
  have hsurj : Function.Surjective f.rangeRestrict := fun ⟨_, x, hx⟩ ↦ ⟨x, Subtype.ext hx⟩
  have hrange :
      LinearMap.range (exteriorPower.map r f) =
        LinearMap.range (exteriorPower.map r (LinearMap.range f).subtype) := by
    have hf : f = (LinearMap.range f).subtype ∘ₗ f.rangeRestrict := rfl
    conv_lhs => rw [hf]
    rw [exteriorPower.map_comp,
      LinearMap.range_comp_of_range_eq_top _
        (LinearMap.range_eq_top.mpr (exteriorPower.map_surjective hsurj))]
  rw [hrange]
  exact TauCeti.fittingIdeal_le_annihilator_exteriorPower_cokernel (LinearMap.range f) r

end LinearMap

section Examples

-- Negative control: for `M = Fin 2 → ℤ` and `N = range (2 • id)`, `M ⧸ N ≅ (ℤ/2ℤ)²` is
-- annihilated by `2`, and `4 ∈ Fitt₀(M ⧸ N)` annihilates `coker(⋀^2 N → ⋀^2 M)`, whereas `2`
-- does NOT annihilate `coker(⋀^2 N → ⋀^2 M)`.
example :
    let M := Fin 2 → ℤ
    let φ : M →ₗ[ℤ] M := (2 : ℤ) • LinearMap.id
    let N : Submodule ℤ M := LinearMap.range φ
    (2 : ℤ) ∈ Module.annihilator ℤ (M ⧸ N) ∧
      (4 : ℤ) ∈ Module.annihilator ℤ
        (↥(⋀[ℤ]^2 M) ⧸ LinearMap.range (exteriorPower.map 2 N.subtype)) ∧
      (2 : ℤ) ∉ Module.annihilator ℤ
        (↥(⋀[ℤ]^2 M) ⧸ LinearMap.range (exteriorPower.map 2 N.subtype)) := by
  intro M φ N
  have hdet : LinearMap.det φ = 4 := by
    dsimp only [φ, M]
    rw [LinearMap.det_smul, LinearMap.det_id, Module.finrank_fin_fun]
    rfl
  refine ⟨?_, ?_, ?_⟩
  · refine Module.mem_annihilator.2 fun q ↦ ?_
    induction q using Submodule.Quotient.induction_on with
    | H x =>
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
      exact ⟨x, by simp [φ]⟩
  · apply TauCeti.fittingIdeal_le_annihilator_exteriorPower_cokernel N 2
    rw [LinearMap.fittingIdeal_coker_zero_eq_span_det φ, hdet]
    exact Ideal.subset_span rfl
  · intro hmem
    let b := Pi.basisFun ℤ (Fin 2)
    let ω : ⋀[ℤ]^2 M := exteriorPower.ιMulti ℤ 2 ⇑b
    have hq := Module.mem_annihilator.1 hmem (Submodule.Quotient.mk ω)
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hq
    obtain ⟨u, hu⟩ := hq
    -- Map along `N.subtype` factors through `φ = 2 • id`, so `exteriorPower.map 2 φ = 4 • id`.
    have hsurj : Function.Surjective φ.rangeRestrict := fun ⟨_, x, hx⟩ ↦ ⟨x, Subtype.ext hx⟩
    obtain ⟨v, rfl⟩ := exteriorPower.map_surjective hsurj u
    have hf : N.subtype ∘ₗ φ.rangeRestrict = φ := rfl
    have hφ : exteriorPower.map 2 N.subtype (exteriorPower.map 2 φ.rangeRestrict v) =
        (4 : ℤ) • v := by
      rw [← LinearMap.comp_apply, ← exteriorPower.map_comp, hf,
        b.map_exteriorPower_top_eq_det_smul φ, hdet, LinearMap.smul_apply, LinearMap.id_apply]
    rw [hφ] at hu
    have hval := congrArg b.exteriorPowerTopEquiv hu
    simp only [map_smul, ω, Module.Basis.exteriorPowerTopEquiv_apply_ιMulti, b.det_self,
      smul_eq_mul, mul_one] at hval
    omega

end Examples
