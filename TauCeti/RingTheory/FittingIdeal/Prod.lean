module

public import Mathlib.LinearAlgebra.Basis.Prod
public import TauCeti.RingTheory.FittingIdeal.Determinant

/-!
# The zeroth Fitting ideal of a product

For finite modules `M` and `N` over a commutative ring, `Fitt₀(M × N) = Fitt₀(M) * Fitt₀(N)`.
Presenting `M` and `N` as quotients of free modules `F` and `G` of ranks `m` and `n`, the
relations of `M × N` are the product `K × L` of the relations of `M` and of `N`, and the statement
is the corresponding identity for the ideals of maximal minors: those of `K × L` in `F × G` are
the products of those of `K` in `F` and those of `L` in `G`.

A block-diagonal family gives the inclusion `⊇`. For `⊆`, expand a family in `K × L` along the
splitting of each of its members into its two components. A family in which exactly `m` members
lie in `F × 0` is block diagonal up to a permutation, so its determinant is a product of
determinants of families in `K` and in `L`; in any other family, either more than `m` members lie
in `F × 0` or more than `n` lie in `0 × G`, and its determinant vanishes. This argument takes the
place of a Laplace expansion along the first `m` coordinates.

The product formula computes the standard example separating the zeroth Fitting ideal from the
annihilator, which contains it by `TauCeti.fittingIdeal_zero_le_annihilator`: over `ℤ`,
`Fitt₀(ℤ/2 × ℤ/2) = (4)` while the annihilator of `ℤ/2 × ℤ/2` is `(2)`.

## Main results

* `Submodule.minorsIdeal_prod_finrank`: the maximal minors of `K × L` in `F × G` are the products
  of the maximal minors of `K` in `F` and of `L` in `G`.
* `TauCeti.fittingIdeal_prod_zero`: `Fitt₀(M × N) = Fitt₀(M) * Fitt₀(N)`.

## References

* [Stacks Project, Tag 07ZA](https://stacks.math.columbia.edu/tag/07ZA), Lemma 15.8.4 (2)
-/

public section

noncomputable section

open Function LinearMap Module

open scoped Pointwise

namespace Submodule

variable {R F G : Type*} [CommRing R] [AddCommGroup F] [Module R F] [AddCommGroup G] [Module R G]

/-- The determinant, in a product basis, of a family in `K × L` lies in the ideal generated by
the products of the determinants of families in `K` and of families in `L`. -/
private theorem prod_det_mem_span_mul {m n : ℕ} (bF : Basis (Fin m) R F) (bG : Basis (Fin n) R G)
    {K : Submodule R F} {L : Submodule R G} {u : Fin m ⊕ Fin n → F × G}
    (hu : ∀ i, u i ∈ K.prod L) :
    (bF.prod bG).det u ∈ Ideal.span ({r | ∃ v : Fin m → F, (∀ i, v i ∈ K) ∧ bF.det v = r} *
      {r | ∃ v : Fin n → G, (∀ i, v i ∈ L) ∧ bG.det v = r}) := by
  classical
  -- Split each member of the family into its two components.
  let s : Fin m ⊕ Fin n → Set (F × G) := fun i ↦ {inl R F G (u i).1, inr R F G (u i).2}
  have hs (i : Fin m ⊕ Fin n) : u i ∈ span R (s i) := by
    rw [← Prod.fst_add_snd (u i)]
    exact add_mem (subset_span (by simp [s])) (subset_span (by simp [s]))
  refine span_le.2 ?_ ((bF.prod bG).det.toMultilinearMap.map_mem_span_image_pi s hs)
  rintro _ ⟨w, hw, rfl⟩
  have hw' (i : Fin m ⊕ Fin n) : w i = inl R F G (u i).1 ∨ w i = inr R F G (u i).2 := hw i trivial
  -- `P i` records that the `i`-th member of the expanded family lies in `F × 0`.
  let P : Fin m ⊕ Fin n → Prop := fun i ↦ w i = inl R F G (u i).1
  have hcard : (Finset.univ.filter P).card + (Finset.univ.filter (¬P ·)).card = m + n := by
    simp [Finset.card_filter_add_card_filter_not]
  have hinl (x : F) : inl R F G x ∈ span R (Set.range (inl R F G ∘ bF)) := by
    rw [Set.range_comp, span_image, bF.span_eq, map_top]
    exact mem_range_self _ x
  have hinr (y : G) : inr R F G y ∈ span R (Set.range (inr R F G ∘ bG)) := by
    rw [Set.range_comp, span_image, bG.span_eq, map_top]
    exact mem_range_self _ y
  rcases lt_trichotomy (Finset.univ.filter P).card m with hlt | heq | hgt
  · -- More than `n` members lie in `0 × G`, which is spanned by `n` vectors.
    rw [SetLike.mem_coe, AlternatingMap.coe_multilinearMap,
      (bF.prod bG).det.map_eq_zero_of_mem_span (t := Finset.univ.filter (¬P ·))
        (inr R F G ∘ bG) (by omega) fun i hi ↦ by
        rw [(hw' i).resolve_left (Finset.mem_filter.1 hi).2]
        exact hinr _]
    exact zero_mem _
  · -- Exactly `m` members lie in `F × 0`: permute them to the front.
    let e₁ : Fin m ≃ {i // P i} :=
      (Fintype.equivFinOfCardEq (by rw [Fintype.card_subtype, heq])).symm
    let e₂ : Fin n ≃ {i // ¬P i} :=
      (Fintype.equivFinOfCardEq (by rw [Fintype.card_subtype]; omega)).symm
    let σ : Equiv.Perm (Fin m ⊕ Fin n) := (e₁.sumCongr e₂).trans (Equiv.sumCompl P)
    have hσ : w ∘ σ = Sum.elim (inl R F G ∘ fun k ↦ (u (σ (.inl k))).1)
        (inr R F G ∘ fun l ↦ (u (σ (.inr l))).2) := by
      ext1 (k | l)
      · simp only [σ, comp_apply, Equiv.trans_apply, Equiv.sumCongr_apply, Sum.map_inl,
          Equiv.sumCompl_apply_inl, Sum.elim_inl]
        exact (e₁ k).2
      · simp only [σ, comp_apply, Equiv.trans_apply, Equiv.sumCongr_apply, Sum.map_inr,
          Equiv.sumCompl_apply_inr, Sum.elim_inr]
        exact (hw' _).resolve_left (e₂ l).2
    have h := (bF.prod bG).det.map_perm w σ
    rw [hσ, Basis.prod_det_sumElim] at h
    have hdet : (bF.prod bG).det w = Equiv.Perm.sign σ •
        (bF.det (fun k ↦ (u (σ (.inl k))).1) * bG.det (fun l ↦ (u (σ (.inr l))).2)) := by
      rw [h, smul_smul, Int.units_mul_self, one_smul]
    rw [SetLike.mem_coe, AlternatingMap.coe_multilinearMap, hdet, Units.smul_def]
    refine zsmul_mem (Ideal.subset_span (Set.mul_mem_mul ?_ ?_)) _
    exacts [⟨_, fun k ↦ (mem_prod.1 (hu _)).1, rfl⟩, ⟨_, fun l ↦ (mem_prod.1 (hu _)).2, rfl⟩]
  · -- More than `m` members lie in `F × 0`, which is spanned by `m` vectors.
    rw [SetLike.mem_coe, AlternatingMap.coe_multilinearMap,
      (bF.prod bG).det.map_eq_zero_of_mem_span (inl R F G ∘ bF) hgt fun i hi ↦ by
        rw [(Finset.mem_filter.1 hi).2]
        exact hinl _]
    exact zero_mem _

variable [Free R F] [Module.Finite R F] [Free R G] [Module.Finite R G]

/-- The maximal minors of a product `K × L` of submodules of free modules `F` and `G` of finite
rank are the products of the maximal minors of `K` and of `L`. -/
theorem minorsIdeal_prod_finrank (K : Submodule R F) (L : Submodule R G) :
    (K.prod L).minorsIdeal (finrank R F + finrank R G) =
      K.minorsIdeal (finrank R F) * L.minorsIdeal (finrank R G) := by
  nontriviality R
  let bF := finBasis R F
  let bG := finBasis R G
  let B := (bF.prod bG).reindex finSumFinEquiv
  rw [minorsIdeal_eq_span_det B, minorsIdeal_eq_span_det bF, minorsIdeal_eq_span_det bG,
    Ideal.span_mul_span]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ ⟨u, hu, rfl⟩
    rw [SetLike.mem_coe, Basis.det_reindex]
    exact prod_det_mem_span_mul bF bG fun i ↦ hu _
  · -- A block-diagonal family realises each product of determinants.
    rintro _ ⟨_, ⟨a, ha, rfl⟩, _, ⟨b, hb, rfl⟩, rfl⟩
    refine Ideal.subset_span ⟨Sum.elim (inl R F G ∘ a) (inr R F G ∘ b) ∘ finSumFinEquiv.symm,
      fun i ↦ ?_, ?_⟩
    · obtain ⟨i | i, rfl⟩ := finSumFinEquiv.surjective i <;> simp [ha, hb]
    · rw [Basis.det_reindex, comp_assoc, Equiv.symm_comp_self, comp_id, Basis.prod_det_sumElim]

end Submodule

namespace TauCeti

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]

variable (R M) in
/-- The zeroth Fitting ideal of a product of finite modules is the product of their zeroth
Fitting ideals: `Fitt₀(M × N) = Fitt₀(M) * Fitt₀(N)`. -/
@[simp]
theorem fittingIdeal_prod_zero (N : Type*) [AddCommGroup N] [Module R N] [Module.Finite R N] :
    fittingIdeal R (M × N) 0 = fittingIdeal R M 0 * fittingIdeal R N 0 := by
  nontriviality R
  obtain ⟨m, φ, hφ⟩ := Module.Finite.exists_fin' R M
  obtain ⟨n, ψ, hψ⟩ := Module.Finite.exists_fin' R N
  rw [fittingIdeal_eq_minorsIdeal_ker hφ, fittingIdeal_eq_minorsIdeal_ker hψ,
    fittingIdeal_eq_minorsIdeal_ker (φ := φ.prodMap ψ) (hφ.prodMap hψ), ker_prodMap,
    finrank_prod, Nat.sub_zero, Nat.sub_zero, Nat.sub_zero, Submodule.minorsIdeal_prod_finrank]

-- Over `ℤ`, `Fitt₀(ℤ/2 × ℤ/2) = (4)` while the annihilator of `ℤ/2 × ℤ/2` is `(2)`: the
-- containment `fittingIdeal_zero_le_annihilator` can be strict.
example : fittingIdeal ℤ ((ℤ ⧸ Ideal.span {(2 : ℤ)}) × (ℤ ⧸ Ideal.span {(2 : ℤ)})) 0 =
      Ideal.span {4} ∧
    Module.annihilator ℤ ((ℤ ⧸ Ideal.span {(2 : ℤ)}) × (ℤ ⧸ Ideal.span {(2 : ℤ)})) =
      Ideal.span {2} := by
  refine ⟨?_, ?_⟩
  · rw [fittingIdeal_prod_zero, fittingIdeal_quotient_zero,
      Ideal.span_singleton_mul_span_singleton]
    norm_num
  · rw [Module.annihilator_prod, Ideal.annihilator_quotient, inf_idem]

end TauCeti
