module

public import TauCeti.RingTheory.FittingIdeal.Generators
public import Mathlib.LinearAlgebra.FreeModule.PID

/-!
# Minor ideals in diagonal bases

For a submodule generated by scalar multiples of a basis, its ideal of size-`p` minors
is generated by products of `p` distinct diagonal coefficients. Applying this to
Mathlib's Smith bases computes the minor ideals of a full-rank submodule over a PID.
These ideals retain all row and column choices, unlike the principal minors appearing
in a characteristic polynomial. Over a discrete valuation ring their valuations give
the lattice Hodge heights.

The diagonal coefficients need not be ordered by divisibility. Thus the formula uses
all distinct selections, rather than asserting that an arbitrary Smith basis orders
the invariant factors.

## References

* K. S. Kedlaya, *A little p-adic numerical analysis*, §3, Theorem 16.
-/

public section

open Module

open Submodule

namespace Module.Basis

variable {R M ι : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- The minor ideal of a diagonally generated submodule is generated by the products
of distinct diagonal coefficients. The basis and its index type may be infinite. -/
theorem minorsIdeal_span_smul (b : Basis ι R M) (d : ι → R) (p : ℕ) :
    (span R (Set.range fun i ↦ d i • b i)).minorsIdeal p =
      Ideal.span (Set.range fun e : Fin p ↪ ι ↦ ∏ i, d (e i)) := by
  classical
  rw [minorsIdeal_span, TauCeti.minorsIdealOfSet_def]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨f, v, hv, rfl⟩
    choose a ha using hv
    obtain rfl : v = fun i ↦ d (a i) • b (a i) := (funext ha).symm
    by_cases hinj : Function.Injective a
    · have hfactor : (Matrix.of fun i j ↦ f j (d (a i) • b (a i))).det =
          (∏ i, d (a i)) * (Matrix.of fun i j ↦ f j (b (a i))).det := by
        simpa only [map_smul, smul_eq_mul, Matrix.of_apply] using
          Matrix.det_mul_column (fun i ↦ d (a i)) (Matrix.of fun i j ↦ f j (b (a i)))
      rw [hfactor]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨⟨a, hinj⟩, rfl⟩)
    · obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.mp hinj
      rw [Matrix.det_zero_of_row_eq hne (funext fun k ↦ by simp only [Matrix.of_apply, hij])]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro _ ⟨e, rfl⟩
    have hdet : (Matrix.of fun i j ↦ (b.coord (e j)) (d (e i) • b (e i))).det =
        ∏ i, d (e i) := by
      have hmatrix : (Matrix.of fun i j ↦ (b.coord (e j)) (d (e i) • b (e i))) =
          Matrix.diagonal (fun i ↦ d (e i)) := by
        ext i j
        by_cases hij : i = j
        · subst j
          simp [Matrix.diagonal]
        · simp [Matrix.diagonal, hij, Finsupp.single_apply]
      rw [hmatrix, Matrix.det_diagonal]
    exact Ideal.subset_span ⟨fun j ↦ b.coord (e j), fun i ↦ d (e i) • b (e i),
      fun i ↦ ⟨e i, rfl⟩, hdet⟩

end Module.Basis

namespace Submodule

variable {R M ι : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- Compute minor ideals from any pair of bases in which a submodule inclusion is diagonal.
No PID assumption or divisibility ordering of the coefficients is needed. -/
theorem minorsIdeal_eq_span_diagonal_products (N : Submodule R M)
    (b : Basis ι R M) (c : Basis ι R N) (d : ι → R)
    (h : ∀ i, (c i : M) = d i • b i) (p : ℕ) :
    N.minorsIdeal p = Ideal.span (Set.range fun e : Fin p ↪ ι ↦ ∏ i, d (e i)) := by
  have hspan : span R (Set.range fun i ↦ d i • b i) = N := by
    simpa only [map_span, ← Set.range_comp, Function.comp_def, subtype_apply,
      map_top, range_subtype, h] using congrArg (map N.subtype) c.span_eq
  rw [← hspan, b.minorsIdeal_span_smul]

variable [IsDomain R] [IsPrincipalIdealRing R] [Finite ι]

/-- The size-`p` minor ideal of a full-rank submodule of a finite free module is generated
by products of `p` distinct coefficients of Mathlib's Smith normal form. -/
theorem minorsIdeal_eq_span_smithNormalForm_products (N : Submodule R M) (b : Basis ι R M)
    (h : Module.finrank R N = Module.finrank R M) (p : ℕ) :
    N.minorsIdeal p = Ideal.span (Set.range fun e : Fin p ↪ ι ↦
      ∏ i, N.smithNormalFormCoeffs b h (e i)) :=
  N.minorsIdeal_eq_span_diagonal_products (N.smithNormalFormTopBasis b h)
    (N.smithNormalFormBotBasis b h) _ (N.smithNormalFormBotBasis_def b h) p

end Submodule
