module

public import TauCeti.RingTheory.FittingIdeal.Content
public import Mathlib.RingTheory.LocalRing.Module

/-!
# Fitting ideals over a local ring

Let `M` be a finite module over a local ring `R` with maximal ideal `𝔪` and residue field `κ`,
and let `μ = dim_κ κ ⊗[R] M` be the minimal number of generators of `M`. Presenting `M` by a
minimal set of generators, every relation has all its coordinates in `𝔪`, so every `p × p`
minor of the relations lies in `𝔪 ^ p`. Hence

`Fitt_k(M) ≤ 𝔪 ^ (μ - k)`.

In particular, if `Fitt_k(M)` is not contained in `𝔪²`, then `M` is generated by `k + 1`
elements. For the module of differentials of a curve this bounds the embedding dimension at a
point where the singular locus, cut out by the first Fitting ideal, is reduced.

## Main results

* `TauCeti.fittingIdeal_le_maximalIdeal_pow`: over a local ring,
  `Fitt_k(M) ≤ 𝔪 ^ (dim_κ κ ⊗[R] M - k)`.

## References

* [Stacks Project, Tag 07ZA](https://stacks.math.columbia.edu/tag/07ZA): Fitting ideals and
  their basic properties.
-/

public section

noncomputable section

open Function LinearMap Module IsLocalRing TensorProduct

namespace TauCeti

variable {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M] [Module R M]
  [Module.Finite R M]

/-- **Fitting ideals over a local ring.** If `M` needs `μ = dim_κ κ ⊗[R] M` generators, then
its `k`-th Fitting ideal lies in `𝔪 ^ (μ - k)`. -/
theorem fittingIdeal_le_maximalIdeal_pow (k : ℕ) :
    fittingIdeal R M k ≤
      maximalIdeal R ^ (finrank (ResidueField R) (ResidueField R ⊗[R] M) - k) := by
  set μ := finrank (ResidueField R) (ResidueField R ⊗[R] M)
  -- Lift a basis of `κ ⊗[R] M` to a family `v` in `M`; by Nakayama it generates `M`.
  let b := Module.finBasis (ResidueField R) (ResidueField R ⊗[R] M)
  have hmk : Surjective (TensorProduct.mk R (ResidueField R) M 1) :=
    TensorProduct.mk_surjective R M (ResidueField R) residue_surjective
  choose v hv using fun i ↦ hmk (b i)
  let φ : (Fin μ → R) →ₗ[R] M := Fintype.linearCombination R v
  have hφ : Surjective φ := by
    rw [← range_eq_top, Fintype.range_linearCombination]
    exact span_eq_top_of_tmul_eq_basis v b hv
  rw [fittingIdeal_eq_minorsIdeal_ker hφ, finrank_fin_fun]
  refine (Submodule.minorsIdeal_le_minorsIdeal_one_pow _ _).trans
    (Ideal.pow_right_mono ?_ _)
  -- The relations vanish in `κ ⊗[R] Rᵘ`, since `κ ⊗ φ` is a surjection between spaces of
  -- the same dimension `μ`.
  have hker : RingHom.ker (algebraMap R (ResidueField R)) = maximalIdeal R := by
    rw [ResidueField.algebraMap_eq, ker_residue]
  rw [← hker,
    (TensorProduct.isBaseChange R (Fin μ → R) (ResidueField R)).minorsIdeal_one_le_ker_iff]
  intro x hx
  have hinj : Injective (φ.baseChange (ResidueField R)) := by
    refine (injective_iff_surjective_of_finrank_eq_finrank ?_).2
      (φ.lTensor_surjective _ hφ)
    rw [Module.finrank_baseChange, finrank_fin_fun]
  refine hinj ?_
  simp [mem_ker.1 hx]

end TauCeti
