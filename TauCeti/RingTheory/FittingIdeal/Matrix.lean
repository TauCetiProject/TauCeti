module

public import TauCeti.RingTheory.FittingIdeal.Generators
public import TauCeti.LinearAlgebra.Matrix.Charpoly.Reverse

/-!
# Matrix minors and characteristic coefficients

The minor ideals of the range of a matrix are generated by all square submatrix
determinants, allowing independent row and column choices. Each coefficient of
`det (1 - X A)` belongs to the corresponding minor ideal. Consequently, computing
the latter in Smith bases bounds the characteristic coefficients without confusing
principal minors with all minors. This is the algebraic input to the lattice
Hodge–Newton inequality.

## References

* K. S. Kedlaya, *A little p-adic numerical analysis*, §3, Theorem 16.
-/

public section

namespace Matrix

open LinearMap Module

variable {R m n : Type*} [CommRing R] [Fintype n]

/-- Every square submatrix determinant belongs to the corresponding minor ideal of
the range. Row and column selections are independent and may repeat indices. -/
theorem det_submatrix_mem_minorsIdeal_range (A : Matrix m n R) {p : ℕ}
    (r : Fin p → m) (c : Fin p → n) :
    (A.submatrix r c).det ∈ (range A.mulVecLin).minorsIdeal p := by
  have h := Submodule.det_mem_minorsIdeal (N := range A.mulVecLin)
    (fun j ↦ LinearMap.proj (r j)) (v := fun i ↦ A.col (c i))
    (fun i ↦ by rw [A.range_mulVecLin]; exact Submodule.subset_span ⟨c i, rfl⟩)
  have heq : (Matrix.of fun i j ↦
      (LinearMap.proj (R := R) (φ := fun _ : m ↦ R) (r j)) (A.col (c i))) =
      (A.submatrix r c)ᵀ := by
    ext i j
    simp
  simpa only [heq, det_transpose] using h

variable [Finite m]

/-- The size-`p` minor ideal of a matrix range is generated by all size-`p` submatrix
determinants, not merely by principal minors. Repeated indices contribute zero. -/
theorem minorsIdeal_range_eq_span_det_submatrix (A : Matrix m n R) (p : ℕ) :
    (range A.mulVecLin).minorsIdeal p = Ideal.span
      (Set.range fun rc : (Fin p → m) × (Fin p → n) ↦ (A.submatrix rc.1 rc.2).det) := by
  classical
  let := Fintype.ofFinite m
  apply le_antisymm
  · rw [A.range_mulVecLin, Submodule.minorsIdeal_span, TauCeti.minorsIdealOfSet_def]
    apply Ideal.span_le.mpr
    rintro _ ⟨f, v, hv, rfl⟩
    choose c hc using hv
    obtain rfl : v = fun i ↦ A.col (c i) := (funext hc).symm
    have hf (i) : f i ∈ Submodule.span R (Set.range (Pi.basisFun R m).dualBasis) := by
      rw [Basis.span_eq]
      trivial
    have h := TauCeti.det_mem_of_mem_span
      (fun j ↦ Dual.eval R (m → R) (A.col (c j))) hf
      (I := Ideal.span (Set.range fun rc : (Fin p → m) × (Fin p → n) ↦
        (A.submatrix rc.1 rc.2).det)) ?_
    · have heq : (Matrix.of fun i j ↦
          (Dual.eval R (m → R) (A.col (c j))) (f i)) =
          (Matrix.of fun i j ↦ f j (A.col (c i)))ᵀ := by
        ext i j
        simp
      rw [heq, det_transpose] at h
      exact h
    · intro w hw
      choose r hr using hw
      obtain rfl : w = fun i ↦ (Pi.basisFun R m).dualBasis (r i) := (funext hr).symm
      have heq : (Matrix.of fun i j ↦
          (Dual.eval R (m → R) (A.col (c j))) ((Pi.basisFun R m).dualBasis (r i))) =
          A.submatrix r c := by
        ext i j
        simp
      rw [heq]
      exact Ideal.subset_span ⟨(r, c), rfl⟩
  · exact Ideal.span_le.mpr (by rintro _ ⟨⟨r, c⟩, rfl⟩; exact
      A.det_submatrix_mem_minorsIdeal_range r c)

omit [Finite m] in
/-- The coefficient of `X^p` in `det (1 - X A)` belongs to the ideal of size-`p`
minors of the range. This includes the constant term and coefficients beyond the dimension. -/
theorem coeff_charpolyRev_mem_minorsIdeal_range [DecidableEq n] (A : Matrix n n R) (p : ℕ) :
    A.charpolyRev.coeff p ∈ (range A.mulVecLin).minorsIdeal p := by
  classical
  rw [coeff_charpolyRev]
  apply Ideal.mul_mem_left
  apply Submodule.sum_mem
  intro s hs
  have hcard : s.card = p := (Finset.mem_powersetCard.mp hs).2
  let e : Fin (Fintype.card s) ≃ s := (Fintype.equivFin s).symm
  have h := A.det_submatrix_mem_minorsIdeal_range (fun i ↦ (e i).val) (fun i ↦ (e i).val)
  have hdet : (A.submatrix (fun i ↦ (e i).val) (fun i ↦ (e i).val)).det =
      (A.submatrix (Subtype.val : s → n) Subtype.val).det := by
    simpa only [submatrix_submatrix, Function.comp_def] using
      det_submatrix_equiv_self e (A.submatrix (Subtype.val : s → n) Subtype.val)
  simpa only [hdet, Fintype.card_coe, hcard] using h

end Matrix
