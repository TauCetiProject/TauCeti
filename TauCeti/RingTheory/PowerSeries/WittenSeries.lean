/-!
# The characteristic series of the Witten genus and its logarithm

Over a `ℚ`-algebra `A`, the characteristic power series of the Witten genus is

`Q(x, q) = (x / 2) / sinh (x / 2) · ∏_{n ≥ 1} (1 - qⁿ)² / ((1 - qⁿ eˣ) (1 - qⁿ e⁻ˣ))`,

a power series in `x` whose coefficients are power series in `q`. Its `q⁰`-part is the Â series
`TauCeti.aHatSeries`, and its logarithm is a generating function of Eisenstein series:

`log Q(x, q) = ∑_{k ≥ 1} 2 G₂ₖ(q) x²ᵏ / (2k)!`, with
`G₂ₖ(q) = -B₂ₖ / (4k) + ∑_{n ≥ 1} σ₂ₖ₋₁(n) qⁿ`

the Bernoulli-normalized Eisenstein series `TauCeti.eisensteinGSeries`. Thus `G₂(0) = -1/24` and
`G₄(0) = 1/240`. For a Spin manifold of dimension `4k` with vanishing first Pontryagin class the
factor `G₂` drops out of the genus, and the remaining `G₂ₖ`, `k ≥ 2`, are level-one modular
forms; this is how the Witten genus of such a manifold becomes a modular form of weight `2k`.

## The two variables

Elements of `A⟦X⟧⟦X⟧` are power series in two variables, an inner and an outer one
(`PowerSeries.swap` exchanges them). The infinite product is formed with `q` outer and `x` inner:
the `n`-th factor `TauCeti.wittenFactor A n`, for `qⁿ⁺¹`, agrees with `1` modulo `qⁿ⁺¹`, so the
product `TauCeti.wittenQProduct A` converges coefficientwise in `q`
(`TauCeti.hasProd_wittenFactor`). The denominators are inverted by the geometric series
`∑ₘ eᵐˣ qᵐⁿ` and `∑ₘ e⁻ᵐˣ qᵐⁿ`, so no inverses are needed. The series
`TauCeti.wittenSeries A` itself has `x` outer and `q` inner, which is the form in which it is
evaluated on Pontryagin roots, and its logarithm `PowerSeries.logOf` is taken in `x`.

## The logarithm

The logarithm of `Â` is computed in `TauCeti.logOf_aHatSeries`. The logarithmic derivative of
the `n`-th factor in `x` is `∑ₘ (eᵐˣ - e⁻ᵐˣ) qᵐⁿ`, so its logarithm is
`∑ₘ (eᵐˣ + e⁻ᵐˣ - 2) qᵐⁿ / m`, whose `x²ᵏ`-coefficient is `2 ∑ₘ m²ᵏ⁻¹ qᵐⁿ / (2k)!`.
The `q^N`-coefficients of the logarithm of the infinite product only involve the first `N`
factors, by `PowerSeries.coeff_logOf_sub_mem` applied to the ideal generated by `q^(N+1)`. Summing
over the factors `n ∣ N` gives the divisor sum `σ₂ₖ₋₁(N)`.

## Main definitions

* `TauCeti.wittenFactor A n`: `(1 - qⁿ⁺¹)² / ((1 - qⁿ⁺¹ eˣ) (1 - qⁿ⁺¹ e⁻ˣ))`, with `q` outer.
* `TauCeti.wittenQProduct A`: the product of the factors, with `q` outer.
* `TauCeti.wittenSeries A`: the characteristic series `Q(x, q)`, with `x` outer.

## Main results

* `TauCeti.wittenFactor_mul_one_sub_mul_one_sub`: the factors are the displayed quotients.
* `TauCeti.hasProd_wittenFactor`: the product converges coefficientwise.
* `TauCeti.map_constantCoeff_wittenSeries`: `Q(x, 0) = (x / 2) / sinh (x / 2)`.
* `TauCeti.coeff_logOf_wittenSeries`: the `xʲ`-coefficient of `log Q` is
  `(1 + (-1)ʲ) Gⱼ(q) / j!` for `j ≥ 1`.
* `TauCeti.coeff_two_mul_logOf_wittenSeries`: the `x²ᵏ`-coefficient of `log Q` is
  `2 G₂ₖ(q) / (2k)!` for `k ≥ 1`.
* `TauCeti.coeff_logOf_wittenSeries_of_odd`: the odd coefficients of `log Q` vanish.

## References

* E. Witten, *The index of the Dirac operator in loop space*, in *Elliptic Curves and Modular
  Forms in Algebraic Topology*, Lecture Notes in Math. 1326, Springer (1988), 161–181.
* D. Zagier, *Note on the Landweber–Stong elliptic genus*, ibid., 216–224.
* M. Ando, M. J. Hopkins, C. Rezk, *Multiplicative orientations of KO-theory and of the spectrum
  of topological modular forms*, preprint (2010), Proposition 10.9.
-/

public section

open Finset Nat PowerSeries
open scoped ArithmeticFunction.sigma

namespace TauCeti

variable (A : Type*) [CommRing A] [Algebra ℚ A]

/-! ### The factors of the product, with `q` outer -/

omit [Algebra ℚ A] in
/-- The geometric series `∑ₘ rᵐ qᵐ⁽ⁿ⁺¹⁾`, with `q` outer, which inverts `1 - r qⁿ⁺¹`. -/
private noncomputable def geomSeries (n : ℕ) (r : A⟦X⟧) : A⟦X⟧⟦X⟧ :=
  expand (n + 1) n.succ_ne_zero (mk fun m ↦ r ^ m)

omit [Algebra ℚ A] in
private theorem geomSeries_mul (n : ℕ) (r : A⟦X⟧) :
    geomSeries A n r * (1 - C r * X ^ (n + 1)) = 1 :=
  expand_mk_pow_mul_one_sub_C_mul_X_pow_eq_one _ _ r

/-- The factor `(1 - qⁿ⁺¹)² / ((1 - qⁿ⁺¹ eˣ) (1 - qⁿ⁺¹ e⁻ˣ))` of the characteristic series of the
Witten genus, as a power series in the outer variable `q` whose coefficients are power series in
`x`. The two denominators are inverted by the geometric series `∑ₘ eᵐˣ qᵐ⁽ⁿ⁺¹⁾` and
`∑ₘ e⁻ᵐˣ qᵐ⁽ⁿ⁺¹⁾`; `TauCeti.wittenFactor_mul_one_sub_mul_one_sub` proves that the factor is the
displayed quotient. -/
noncomputable def wittenFactor (n : ℕ) : A⟦X⟧⟦X⟧ :=
  (1 - X ^ (n + 1)) ^ 2 * geomSeries A n (exp A) * geomSeries A n (rescale (-1) (exp A))

/-- **The factors are the displayed quotients**: the `n`-th factor times
`(1 - qⁿ⁺¹ eˣ) (1 - qⁿ⁺¹ e⁻ˣ)` is `(1 - qⁿ⁺¹)²`. -/
theorem wittenFactor_mul_one_sub_mul_one_sub (n : ℕ) :
    wittenFactor A n * ((1 - C (exp A) * X ^ (n + 1)) *
      (1 - C (rescale (-1) (exp A)) * X ^ (n + 1))) = (1 - X ^ (n + 1)) ^ 2 := by
  rw [wittenFactor]
  linear_combination (1 - X ^ (n + 1)) ^ 2 *
      (geomSeries A n (rescale (-1) (exp A)) * (1 - C (rescale (-1) (exp A)) * X ^ (n + 1))) *
        geomSeries_mul A n (exp A) +
    (1 - X ^ (n + 1)) ^ 2 * geomSeries_mul A n (rescale (-1) (exp A))

/-- The `n`-th factor agrees with `1` modulo `qⁿ⁺¹`. -/
theorem X_pow_dvd_wittenFactor_sub_one (n : ℕ) : X ^ (n + 1) ∣ wittenFactor A n - 1 := by
  set u : A⟦X⟧⟦X⟧ := X ^ (n + 1)
  set Γ := geomSeries A n (exp A)
  set Γ' := geomSeries A n (rescale (-1) (exp A))
  set e := C (exp A)
  set e' := C (rescale (-1) (exp A))
  have h₁ : Γ * (1 - e * u) = 1 := geomSeries_mul A n (exp A)
  have h₂ : Γ' * (1 - e' * u) = 1 := geomSeries_mul A n (rescale (-1) (exp A))
  -- `Γ = 1 + u Γ e` and `Γ' = 1 + u Γ' e'`
  refine ⟨u - 2 + (1 - u) ^ 2 * (Γ * e + Γ' * e' + u * (Γ * e) * (Γ' * e')), ?_⟩
  rw [wittenFactor]
  linear_combination (1 - u) ^ 2 * Γ' * h₁ + (1 - u) ^ 2 * (1 + u * Γ * e) * h₂

/-! ### The product, with `q` outer -/

/-- The product `∏_{n ≥ 1} (1 - qⁿ)² / ((1 - qⁿ eˣ) (1 - qⁿ e⁻ˣ))`, as a power series in the
outer variable `q`. Its `qᵐ`-coefficient is that of the product of the first `m` factors, since
the others agree with `1` modulo `qᵐ⁺¹`; `TauCeti.hasProd_wittenFactor` shows that it is the limit
of the finite products. -/
noncomputable def wittenQProduct : A⟦X⟧⟦X⟧ :=
  mk fun m ↦ coeff m (∏ n ∈ range m, wittenFactor A n)

/-- The `qᵐ`-coefficient of the product is that of the product of the first `M` factors, for any
`M ≥ m`. -/
theorem coeff_wittenQProduct_of_le {m M : ℕ} (h : m ≤ M) :
    coeff m (wittenQProduct A) = coeff m (∏ n ∈ range M, wittenFactor A n) := by
  rw [wittenQProduct, coeff_mk, coeff_prod_eq_coeff_prod_of_X_pow_dvd_sub_one
    (range_subset_range.2 h)]
  intro n hn
  simp only [mem_sdiff, mem_range, not_lt] at hn
  exact (pow_dvd_pow X (by omega)).trans (X_pow_dvd_wittenFactor_sub_one A n)

open scoped PowerSeries.WithPiTopology in
/-- **The product converges**: for any topology on `A`, `TauCeti.wittenQProduct A` is the
infinite product of the factors in the coefficientwise topology. -/
theorem hasProd_wittenFactor [TopologicalSpace A] :
    HasProd (wittenFactor A) (wittenQProduct A) := by
  refine WithPiTopology.hasProd_of_X_pow_dvd_sub_one (fun m ↦ range m) fun m n hn ↦ ?_
  simp only [mem_range, not_lt] at hn
  exact (pow_dvd_pow X (by omega)).trans (X_pow_dvd_wittenFactor_sub_one A n)

/-! ### The factors with `x` outer -/

omit [Algebra ℚ A] in
/-- With `x` outer, the geometric series `∑ₘ rᵐ qᵐ⁽ⁿ⁺¹⁾` inverts `1 - qⁿ⁺¹ r`. -/
private theorem swap_geomSeries_mul (n : ℕ) (r : A⟦X⟧) :
    swap (geomSeries A n r) * (1 - map C r * C X ^ (n + 1)) = 1 := by
  simpa using congrArg swap (geomSeries_mul A n r)

omit [Algebra ℚ A] in
/-- If `r' = c r` in `x`, the derivative in `x` of `G = ∑ₘ rᵐ qᵐ⁽ⁿ⁺¹⁾` is `c G (G - 1)`. -/
private theorem derivative_swap_geomSeries (n : ℕ) {r : A⟦X⟧} {c : A}
    (hr : d⁄dX r = C c * r) :
    d⁄dX (swap (geomSeries A n r)) =
      C (C c) * swap (geomSeries A n r) * (swap (geomSeries A n r) - 1) := by
  have h := swap_geomSeries_mul A n r
  have he : d⁄dX (map C r) = C (C c) * map C r := by rw [derivative_map, hr, map_mul, map_C]
  have hd : d⁄dX (swap (geomSeries A n r)) * (1 - map C r * C X ^ (n + 1)) -
      swap (geomSeries A n r) * (C (C c) * map C r * C X ^ (n + 1)) = 0 := by
    have := congrArg (d⁄dX) h
    simp only [Derivation.leibniz, map_sub, Derivation.map_one_eq_zero, he, smul_eq_mul,
      Derivation.leibniz_pow, derivative_C] at this
    linear_combination this
  linear_combination
    (-d⁄dX (swap (geomSeries A n r)) - C (C c) * swap (geomSeries A n r)) * h +
      swap (geomSeries A n r) * hd

private theorem swap_wittenFactor (n : ℕ) :
    swap (wittenFactor A n) = (1 - C X ^ (n + 1)) ^ 2 * swap (geomSeries A n (exp A)) *
      swap (geomSeries A n (rescale (-1) (exp A))) := by
  simp [wittenFactor]

/-- With `x` outer, each factor has constant coefficient `1`: it is `1` at `x = 0`. -/
@[simp]
theorem constantCoeff_swap_wittenFactor (n : ℕ) :
    constantCoeff (swap (wittenFactor A n)) = 1 := by
  have h₁ := congrArg constantCoeff (swap_geomSeries_mul A n (exp A))
  have h₂ := congrArg constantCoeff (swap_geomSeries_mul A n (rescale (-1) (exp A)))
  simp only [map_mul, map_sub, map_one, map_pow, constantCoeff_C, constantCoeff_map,
    constantCoeff_exp, constantCoeff_rescale, one_mul] at h₁ h₂
  rw [swap_wittenFactor, map_mul, map_mul, map_pow, map_sub, map_one, map_pow, constantCoeff_C]
  linear_combination
    (1 - X ^ (n + 1)) * constantCoeff (swap (geomSeries A n (rescale (-1) (exp A)))) * h₁ + h₂

/-- The logarithm in `x` of the `n`-th factor is `∑ₘ (eᵐˣ + e⁻ᵐˣ - 2) qᵐ⁽ⁿ⁺¹⁾ / m`, written
through its logarithmic derivative `∑ₘ (eᵐˣ - e⁻ᵐˣ) qᵐ⁽ⁿ⁺¹⁾`. -/
private theorem logOf_swap_wittenFactor (n : ℕ) :
    logOf (swap (wittenFactor A n)) = mk fun j ↦ (j : ℚ)⁻¹ • coeff (j - 1)
      (swap (geomSeries A n (exp A)) - swap (geomSeries A n (rescale (-1) (exp A)))) := by
  rw [logOf_eq_mk_iff (constantCoeff_swap_wittenFactor A n), swap_wittenFactor]
  set G := swap (geomSeries A n (exp A))
  set G' := swap (geomSeries A n (rescale (-1) (exp A)))
  have hmk : (mk fun j ↦ coeff (j + 1 - 1) (G - G')) = G - G' := by ext; simp
  have hG : d⁄dX G = C (C 1) * G * (G - 1) :=
    derivative_swap_geomSeries A n (by rw [derivative_exp, map_one, one_mul])
  have hG' : d⁄dX G' = C (C (-1)) * G' * (G' - 1) :=
    derivative_swap_geomSeries A n (by rw [derivative_rescale, derivative_exp])
  rw [hmk]
  simp only [Derivation.leibniz, Derivation.leibniz_pow, map_sub, Derivation.map_one_eq_zero,
    derivative_C, smul_eq_mul, hG, hG', map_one, map_neg]
  ring

/-- The `qᴺ`-coefficient of the `xʲ`-coefficient (`j ≥ 1`) of the logarithm of the `n`-th
factor is `(1 + (-1)ʲ) mʲ⁻¹ / j!` if `N = m (n + 1)`, and `0` if `n + 1` does not divide `N`. -/
theorem coeff_coeff_logOf_swap_wittenFactor (n : ℕ) {j : ℕ} (hj : j ≠ 0) (N : ℕ) :
    coeff N (coeff j (logOf (swap (wittenFactor A n)))) =
      if n + 1 ∣ N then
        algebraMap ℚ A ((1 + (-1) ^ j) * ((N / (n + 1) : ℕ) : ℚ) ^ (j - 1) / j !)
      else 0 := by
  obtain ⟨i, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hj
  rw [logOf_swap_wittenFactor, coeff_mk, coeff_smul, map_sub, map_sub, coeff_coeff_swap,
    coeff_coeff_swap, geomSeries, geomSeries, coeff_expand, coeff_expand]
  split_ifs
  · simp only [coeff_mk, ← map_pow, exp_pow_eq_rescale_exp, rescale_rescale, coeff_rescale,
      coeff_exp, add_tsub_cancel_right, Algebra.smul_def, mul_neg, mul_one,
      ← map_natCast (algebraMap ℚ A), ← map_neg, ← map_pow, ← map_mul, ← map_sub]
    congr 1
    push_cast [Nat.factorial_succ]
    field_simp
    ring
  · simp

/-- The `qᴺ`-coefficient of the `xʲ`-coefficient (`j ≥ 1`) of the logarithm of the product of the
first `N` factors is `(1 + (-1)ʲ) σⱼ₋₁(N) / j!`. -/
private theorem coeff_coeff_logOf_swap_prod_wittenFactor {j : ℕ} (hj : j ≠ 0) (N : ℕ) :
    coeff N (coeff j (logOf (swap (∏ n ∈ range N, wittenFactor A n)))) =
      algebraMap ℚ A ((1 + (-1) ^ j) / j ! * σ (j - 1) N) := by
  rw [map_prod, logOf_prod fun n _ ↦ constantCoeff_swap_wittenFactor A n, map_sum, map_sum]
  simp_rw [coeff_coeff_logOf_swap_wittenFactor A _ hj, ← map_zero (algebraMap ℚ A),
    ← apply_ite (algebraMap ℚ A), ← map_sum]
  congr 1
  rcases eq_or_ne N 0 with rfl | hN
  · simp
  -- the factors `n + 1 ∣ N` contribute: reindex by the divisors `N / (n + 1)` of `N`
  rw [ArithmeticFunction.sigma_apply, ← sum_div_divisors, ← filter_dvd_eq_divisors hN, sum_filter,
    sum_range_succ']
  simp only [zero_dvd_iff, hN, ↓reduceIte, add_zero]
  push_cast
  rw [mul_sum]
  refine sum_congr rfl fun n _ ↦ ?_
  split_ifs <;> ring

/-! ### The characteristic series and its logarithm -/

/-- With `x` outer, the product has constant coefficient `1`. -/
@[simp]
theorem constantCoeff_swap_wittenQProduct : constantCoeff (swap (wittenQProduct A)) = 1 := by
  ext m
  rw [coeff_constantCoeff_swap, coeff_wittenQProduct_of_le A le_rfl, ← coeff_constantCoeff_swap,
    map_prod, map_prod, prod_eq_one fun n _ ↦ constantCoeff_swap_wittenFactor A n]

/-- The `qᴺ`-coefficient of the `xʲ`-coefficient (`j ≥ 1`) of the logarithm in `x` of the product
is `(1 + (-1)ʲ) σⱼ₋₁(N) / j!`. -/
theorem coeff_coeff_logOf_swap_wittenQProduct {j : ℕ} (hj : j ≠ 0) (N : ℕ) :
    coeff N (coeff j (logOf (swap (wittenQProduct A)))) =
      algebraMap ℚ A ((1 + (-1) ^ j) / j ! * σ (j - 1) N) := by
  have hP : constantCoeff (swap (∏ n ∈ range N, wittenFactor A n)) = 1 := by
    rw [map_prod, map_prod, prod_eq_one fun n _ ↦ constantCoeff_swap_wittenFactor A n]
  -- modulo `q^(N+1)`, the product agrees with the product of its first `N` factors
  have h := coeff_logOf_sub_mem (I := Ideal.span {X ^ (N + 1)})
    (constantCoeff_swap_wittenQProduct A) hP (fun i ↦ Ideal.mem_span_singleton.2 <|
      X_pow_dvd_iff.2 fun m hm ↦ by
        rw [map_sub, coeff_coeff_swap, coeff_coeff_swap,
          coeff_wittenQProduct_of_le A (by omega : m ≤ N), sub_self]) j
  rw [Ideal.mem_span_singleton, X_pow_dvd_iff] at h
  rw [← coeff_coeff_logOf_swap_prod_wittenFactor A hj N, ← sub_eq_zero, ← map_sub]
  exact h N (by omega)

/-- The **characteristic series of the Witten genus**
`Q(x, q) = (x / 2) / sinh (x / 2) · ∏_{n ≥ 1} (1 - qⁿ)² / ((1 - qⁿ eˣ) (1 - qⁿ e⁻ˣ))`, as a power
series in the outer variable `x` whose coefficients are power series in `q`. -/
noncomputable def wittenSeries : A⟦X⟧⟦X⟧ :=
  map C (aHatSeries A) * swap (wittenQProduct A)

theorem wittenSeries_def : wittenSeries A = map C (aHatSeries A) * swap (wittenQProduct A) :=
  (rfl)

/-- The characteristic series has constant coefficient `1` in `x`. -/
@[simp]
theorem constantCoeff_wittenSeries : constantCoeff (wittenSeries A) = 1 := by
  rw [wittenSeries_def, map_mul, constantCoeff_swap_wittenQProduct, mul_one, constantCoeff_map,
    constantCoeff_aHatSeries, map_one]

/-- At `q = 0` the characteristic series is the Â series: `Q(x, 0) = (x / 2) / sinh (x / 2)`. -/
@[simp]
theorem map_constantCoeff_wittenSeries : map constantCoeff (wittenSeries A) = aHatSeries A := by
  have h₁ : map constantCoeff (swap (wittenQProduct A)) = 1 := by
    ext j
    rw [coeff_map, ← coeff_zero_eq_constantCoeff_apply, coeff_coeff_swap, wittenQProduct, coeff_mk]
    simp
  have h₂ : map constantCoeff (map C (aHatSeries A)) = aHatSeries A := by
    ext
    simp
  rw [wittenSeries_def, map_mul, h₁, h₂, mul_one]

/-- The logarithm in `x` of the characteristic series is the logarithm of the Â series plus that
of the product. -/
theorem logOf_wittenSeries :
    logOf (wittenSeries A) = map C (logOf (aHatSeries A)) + logOf (swap (wittenQProduct A)) := by
  have hÂ : constantCoeff (map C (aHatSeries A)) = 1 := by
    rw [constantCoeff_map, constantCoeff_aHatSeries, map_one]
  rw [wittenSeries_def, logOf_mul hÂ (constantCoeff_swap_wittenQProduct A),
    map_logOf _ (constantCoeff_aHatSeries A)]

/-- **The logarithm of the characteristic series of the Witten genus**: for `j ≥ 1`, the
`xʲ`-coefficient of `log Q(x, q)` is `(1 + (-1)ʲ) Gⱼ(q) / j!`. -/
theorem coeff_logOf_wittenSeries {j : ℕ} (hj : j ≠ 0) :
    coeff j (logOf (wittenSeries A)) = ((1 + (-1) ^ j) / j ! : ℚ) • eisensteinGSeries A j := by
  ext N
  rw [logOf_wittenSeries, map_add, map_add, coeff_coeff_logOf_swap_wittenQProduct A hj, coeff_map,
    coeff_C, logOf_aHatSeries, coeff_mk, coeff_smul, coeff_eisensteinGSeries]
  rcases eq_or_ne N 0 with rfl | hN
  · -- the constant term in `q` comes from the Â series
    simp only [↓reduceIte, ArithmeticFunction.sigma_apply, divisors_zero, sum_empty, cast_zero,
      mul_zero, map_zero, add_zero, Algebra.smul_def]
    rw [← map_mul]
    split_ifs with h1
    · simp [h1]
    congr 1
    rcases Nat.even_or_odd j with he | ho
    · rw [he.neg_one_pow]
      field_simp
      ring
    · rw [ho.neg_one_pow, bernoulli_eq_zero_of_odd ho (by omega)]
      simp
  · simp [hN, Algebra.smul_def]

/-- **`log Q = ∑_{k ≥ 1} 2 G₂ₖ(q) x²ᵏ / (2k)!`**: for `k ≥ 1`, the `x²ᵏ`-coefficient of the
logarithm of the characteristic series of the Witten genus is `2 G₂ₖ(q) / (2k)!`. -/
theorem coeff_two_mul_logOf_wittenSeries {k : ℕ} (hk : k ≠ 0) :
    coeff (2 * k) (logOf (wittenSeries A)) =
      (2 / (2 * k) ! : ℚ) • eisensteinGSeries A (2 * k) := by
  rw [coeff_logOf_wittenSeries A (by omega), (even_two_mul k).neg_one_pow]
  norm_num

/-- The odd coefficients of the logarithm of the characteristic series vanish: `Q` is even
in `x`. -/
theorem coeff_logOf_wittenSeries_of_odd {j : ℕ} (hj : Odd j) :
    coeff j (logOf (wittenSeries A)) = 0 := by
  rw [coeff_logOf_wittenSeries A (by rintro rfl; simp at hj), hj.neg_one_pow]
  simp

end TauCeti
