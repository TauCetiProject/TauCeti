module

public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.PowerSeries.Inverse

import Mathlib.RingTheory.PowerSeries.Trunc
import TauCeti.RingTheory.RegularLocalRing.PowerSeries

/-!
# Adic completeness of power series rings

For an ideal `I` of a commutative ring `R`, let `I⟦X⟧ = I.comap constantCoeff` be the ideal of
`R⟦X⟧` of the series whose constant coefficient lies in `I`; it is generated by `I` and `X`. Its
powers are described coefficientwise:

  `f ∈ I⟦X⟧ ^ N ↔ ∀ k, coeff k f ∈ I ^ (N - k)`,

so the `k`-th coefficient of an element of `I⟦X⟧ ^ N` is `I`-adically small once `N` is large
compared to `k`, while the high coefficients are unconstrained. It follows that `R⟦X⟧` is
`I⟦X⟧`-adically Hausdorff, precomplete or complete when `R` is `I`-adically so: a Cauchy sequence
of series converges coefficientwise. For a local ring `R`, the ideal `𝔪⟦X⟧` is the maximal ideal
of `R⟦X⟧`, so `R⟦X⟧` is complete for its maximal ideal when `R` is. For instance the Iwasawa
algebra `O⟦T⟧` over a complete discrete valuation ring is complete for its maximal ideal
`(ϖ, T)`, which is not visible from the `X`-adic completeness of `R⟦X⟧` alone.

## Main results

* `PowerSeries.mem_comap_constantCoeff_pow_iff`: `f ∈ I⟦X⟧ ^ N` exactly when
  `coeff k f ∈ I ^ (N - k)` for every `k`.
* `PowerSeries.isHausdorff_comap_constantCoeff`, `PowerSeries.isPrecomplete_comap_constantCoeff`,
  `PowerSeries.isAdicComplete_comap_constantCoeff`: `R⟦X⟧` inherits `I`-adic Hausdorffness,
  precompleteness and completeness from `R`.
* `PowerSeries.isAdicComplete_maximalIdeal`: over a local ring complete for its maximal ideal, the
  power series ring is complete for its maximal ideal.
-/

public section

open IsLocalRing

namespace PowerSeries

variable {R : Type*} [CommRing R] (I : Ideal R)

/-- **Powers of `I⟦X⟧` coefficientwise.** A power series lies in the `N`-th power of the ideal of
series with constant coefficient in `I` exactly when its `k`-th coefficient lies in
`I ^ (N - k)` for every `k`. -/
theorem mem_comap_constantCoeff_pow_iff {N : ℕ} {f : R⟦X⟧} :
    f ∈ I.comap constantCoeff ^ N ↔ ∀ k, coeff k f ∈ I ^ (N - k) := by
  constructor
  · intro hf
    induction N generalizing f with
    | zero => simp
    | succ N ih =>
      rw [pow_succ] at hf
      refine Submodule.mul_induction_on hf (fun a ha b hb k ↦ ?_)
        (fun a b ha hb k ↦ by rw [map_add]; exact add_mem (ha k) (hb k))
      rw [coeff_mul]
      refine Ideal.sum_mem _ fun ij hij ↦ ?_
      rw [Finset.mem_antidiagonal] at hij
      -- The second factor has constant coefficient in `I` and arbitrary higher coefficients.
      have hb' : coeff ij.2 b ∈ I ^ (1 - ij.2) := by
        rcases Nat.eq_zero_or_pos ij.2 with h | h
        · simpa [h] using hb
        · simp [Nat.sub_eq_zero_of_le h]
      refine Ideal.pow_le_pow_right (show N + 1 - k ≤ (N - ij.1) + (1 - ij.2) by omega) ?_
      rw [pow_add]
      exact Ideal.mul_mem_mul (ih ha ij.1) hb'
  · intro hf
    have hC : I.map C ≤ I.comap constantCoeff :=
      Ideal.map_le_iff_le_comap.mpr fun a ha ↦ by simpa using ha
    have hX : (X : R⟦X⟧) ∈ I.comap constantCoeff := by simp
    -- Split `f` into its first `N` monomials and a multiple of `X ^ N`.
    rw [eq_X_pow_mul_shift_add_trunc N f, ← Polynomial.eval₂_C_X_eq_coe, eval₂_trunc_eq_sum_range]
    refine add_mem (Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow hX N))
      (Ideal.sum_mem _ fun k hk ↦ ?_)
    -- The `k`-th monomial is a product of an element of `I ^ (N - k)` and `X ^ k`.
    rw [← Nat.sub_add_cancel (Finset.mem_range.mp hk).le, pow_add]
    refine Ideal.mul_mem_mul (Ideal.pow_right_mono hC _ ?_) (Ideal.pow_mem_pow hX k)
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem C (hf k)

/-- If `R` is `I`-adically Hausdorff, then `R⟦X⟧` is Hausdorff for the ideal of series with
constant coefficient in `I`. -/
theorem isHausdorff_comap_constantCoeff [IsHausdorff I R] :
    IsHausdorff (I.comap constantCoeff) R⟦X⟧ := by
  refine ⟨fun f hf ↦ ext fun k ↦ IsHausdorff.haus ‹_› _ fun n ↦ ?_⟩
  simp only [SModEq.zero, smul_eq_mul, Ideal.mul_top, mem_comap_constantCoeff_pow_iff] at hf ⊢
  simpa using hf (n + k) k

/-- If `R` is `I`-adically precomplete, then `R⟦X⟧` is precomplete for the ideal of series with
constant coefficient in `I`: a Cauchy sequence converges coefficientwise. -/
theorem isPrecomplete_comap_constantCoeff [IsPrecomplete I R] :
    IsPrecomplete (I.comap constantCoeff) R⟦X⟧ := by
  refine ⟨fun f hf ↦ ?_⟩
  simp only [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] at hf ⊢
  -- The `k`-th coefficients, read from index `k` on, form an `I`-adic Cauchy sequence.
  have (k : ℕ) : ∃ L : R, ∀ n, coeff k (f (n + k)) - L ∈ I ^ n := by
    obtain ⟨L, hL⟩ := IsPrecomplete.prec ‹_› (f := fun n ↦ coeff k (f (n + k)))
      fun {m n} hmn ↦ by
        rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top, ← map_sub]
        simpa using (mem_comap_constantCoeff_pow_iff I).mp
          (hf (show m + k ≤ n + k by omega)) k
    exact ⟨L, fun n ↦ by simpa [SModEq.sub_mem] using hL n⟩
  choose L hL using this
  refine ⟨mk L, fun n ↦ (mem_comap_constantCoeff_pow_iff I).mpr fun k ↦ ?_⟩
  rcases le_or_gt k n with h | h
  · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le' h
    simpa using hL k j
  · simp [Nat.sub_eq_zero_of_le h.le]

/-- If `R` is `I`-adically complete, then `R⟦X⟧` is complete for the ideal of series with
constant coefficient in `I`. -/
theorem isAdicComplete_comap_constantCoeff [IsAdicComplete I R] :
    IsAdicComplete (I.comap constantCoeff) R⟦X⟧ :=
  { isHausdorff_comap_constantCoeff I, isPrecomplete_comap_constantCoeff I with }

/-- **Power series over a complete local ring are complete.** If a local ring `R` is complete for
its maximal ideal, then so is `R⟦X⟧`. -/
instance isAdicComplete_maximalIdeal [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R] :
    IsAdicComplete (maximalIdeal R⟦X⟧) R⟦X⟧ := by
  rw [TauCeti.PowerSeries.maximalIdeal_eq_comap_constantCoeff]
  exact isAdicComplete_comap_constantCoeff _

end PowerSeries
