module

public import Mathlib.LinearAlgebra.Charpoly.Basic
public import Mathlib.RingTheory.PowerBasis
public import Mathlib.RingTheory.PowerSeries.WeierstrassPreparation

import TauCeti.RingTheory.AdjoinRoot.Minpoly
import TauCeti.RingTheory.PowerBasis

/-!
# Multiplication by `X` on a quotient of a power series ring

Let `A` be a commutative ring, complete for an ideal `I`, and let `g = f * h` be a Weierstrass
factorization in `A⟦X⟧`: `f` a polynomial distinguished at `I` and `h` a unit. Mathlib identifies
`A[X] ⧸ (f)` with `A⟦X⟧ ⧸ (g)` (`PowerSeries.IsWeierstrassFactorizationAt.algEquivQuotient`). Since
`f` is monic, `A[X] ⧸ (f)` is free over `A` with power basis `1, X, …, X ^ (deg f - 1)`, and this
file transports that structure to `A⟦X⟧ ⧸ (g)`:

* `A⟦X⟧ ⧸ (g)` is free of rank `deg f` over `A`, with power basis the classes of
  `1, X, …, X ^ (deg f - 1)`;
* the minimal polynomial over `A` of the class of `X` is `f`;
* multiplication by `X` on `A⟦X⟧ ⧸ (g)` has characteristic polynomial `f`.

Over a complete local ring and for a series `g` whose reduction modulo the maximal ideal is
nonzero, the factorization is Mathlib's `PowerSeries.weierstrassDistinguished`, so multiplication
by `X` on `A⟦X⟧ ⧸ (g)` has characteristic polynomial the distinguished factor of `g`. This is the
form in which the structure theory of modules over the Iwasawa algebra `O⟦T⟧` reads the
distinguished polynomial of a torsion module `O⟦T⟧ ⧸ (g)` off the action of `T`
(NSW (5.3.1)–(5.3.4)): `O⟦T⟧ ⧸ (g)` is free over `O` of rank the degree of the distinguished
factor of `g`, and `T` acts on it with characteristic polynomial that distinguished factor.

## Main definitions

* `PowerSeries.IsWeierstrassFactorizationAt.powerBasis`: the power basis of `A⟦X⟧ ⧸ (g)` over `A`
  generated by the class of `X`.

## Main results

* `PowerSeries.IsWeierstrassFactorizationAt.finrank_quotient`: `A⟦X⟧ ⧸ (g)` has rank `deg f`.
* `PowerSeries.IsWeierstrassFactorizationAt.minpoly_mk_X`: the minimal polynomial of the class of
  `X` is `f`.
* `PowerSeries.IsWeierstrassFactorizationAt.charpoly_lmul_mk_X`: multiplication by `X` on
  `A⟦X⟧ ⧸ (g)` has characteristic polynomial `f`.
* `PowerSeries.charpoly_lmul_mk_X_eq_weierstrassDistinguished`: over a complete local ring, it is
  the distinguished factor `PowerSeries.weierstrassDistinguished g`.
* `Polynomial.IsDistinguishedAt.isWeierstrassFactorizationAt`: a distinguished polynomial is its
  own Weierstrass factorization, so the results apply to `A⟦X⟧ ⧸ (f)` for distinguished `f`.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, second edition, (5.3.1)–
  (5.3.4).
* L. Washington, *Introduction to Cyclotomic Fields*, second edition, GTM 83, §7.1.
-/

public section

namespace PowerSeries

variable {A : Type*} [CommRing A] {I : Ideal A}

/-- A polynomial distinguished at `I` is its own Weierstrass factorization, with unit `1`. -/
theorem _root_.Polynomial.IsDistinguishedAt.isWeierstrassFactorizationAt {f : Polynomial A}
    (hf : f.IsDistinguishedAt I) : (f : A⟦X⟧).IsWeierstrassFactorizationAt f 1 I :=
  ⟨hf, isUnit_one, (mul_one _).symm⟩

namespace IsWeierstrassFactorizationAt

variable {g : A⟦X⟧} {f : Polynomial A} {h : A⟦X⟧} (H : g.IsWeierstrassFactorizationAt f h I)
  [IsAdicComplete I A]
include H

/-- For a Weierstrass factorization `g = f * h`, the power basis of `A⟦X⟧ ⧸ (g)` over `A`
generated by the class of `X`: the classes of `1, X, …, X ^ (deg f - 1)` form a basis. It is the
monic power basis of `A[X] ⧸ (f)` transported along `algEquivQuotient`. -/
noncomputable def powerBasis : PowerBasis A (A⟦X⟧ ⧸ Ideal.span {g}) :=
  -- `AdjoinRoot f` is by definition `A[X] ⧸ (f)`, the domain of `algEquivQuotient`.
  (AdjoinRoot.powerBasis' H.isDistinguishedAt.monic).map H.algEquivQuotient

/-- The power basis of `A⟦X⟧ ⧸ (g)` has dimension the degree of `f`. -/
@[simp]
theorem powerBasis_dim : H.powerBasis.dim = f.natDegree := (rfl)

/-- The power basis of `A⟦X⟧ ⧸ (g)` is generated by the class of `X`. -/
@[simp]
theorem powerBasis_gen : H.powerBasis.gen = Ideal.Quotient.mk _ X := by
  have hX : H.algEquivQuotient (Ideal.Quotient.mk (Ideal.span {f}) Polynomial.X) =
      Ideal.Quotient.mk _ X := by
    simp
  -- The generator is the image of `AdjoinRoot.root f = AdjoinRoot.mk f Polynomial.X`, and
  -- `AdjoinRoot.mk f` is by definition the quotient map `A[X] → A[X] ⧸ (f)`.
  exact (congrArg H.algEquivQuotient (AdjoinRoot.mk_X (f := f)).symm).trans hX

/-- For a Weierstrass factorization `g = f * h`, the quotient `A⟦X⟧ ⧸ (g)` is a free `A`-module. -/
theorem free_quotient : Module.Free A (A⟦X⟧ ⧸ Ideal.span {g}) :=
  .of_basis H.powerBasis.basis

/-- For a Weierstrass factorization `g = f * h`, the quotient `A⟦X⟧ ⧸ (g)` is a finitely generated
`A`-module. -/
theorem finite_quotient : Module.Finite A (A⟦X⟧ ⧸ Ideal.span {g}) :=
  H.powerBasis.finite

/-- For a Weierstrass factorization `g = f * h` over a nontrivial ring, the quotient `A⟦X⟧ ⧸ (g)`
is free of rank the degree of `f`. -/
theorem finrank_quotient [Nontrivial A] :
    Module.finrank A (A⟦X⟧ ⧸ Ideal.span {g}) = f.natDegree :=
  H.powerBasis.finrank

/-- For a Weierstrass factorization `g = f * h`, the minimal polynomial over `A` of the class of
`X` in `A⟦X⟧ ⧸ (g)` is the distinguished polynomial `f`. -/
theorem minpoly_mk_X : minpoly A (Ideal.Quotient.mk (Ideal.span {g}) X) = f := by
  rw [← H.powerBasis_gen]
  exact (minpoly.algEquiv_eq H.algEquivQuotient (AdjoinRoot.root f)).trans
    (AdjoinRoot.minpoly_root_of_monic H.isDistinguishedAt.monic)

/-- For a Weierstrass factorization `g = f * h`, multiplication by `X` on `A⟦X⟧ ⧸ (g)` has
characteristic polynomial the distinguished polynomial `f`. The quotient is free and finite over
`A` by `free_quotient` and `finite_quotient`. -/
theorem charpoly_lmul_mk_X [Module.Free A (A⟦X⟧ ⧸ Ideal.span {g})]
    [Module.Finite A (A⟦X⟧ ⧸ Ideal.span {g})] :
    (Algebra.lmul A (A⟦X⟧ ⧸ Ideal.span {g}) (Ideal.Quotient.mk _ X)).charpoly = f := by
  rw [← H.powerBasis_gen, PowerBasis.charpoly_lmul_gen, H.powerBasis_gen, H.minpoly_mk_X]

end IsWeierstrassFactorizationAt

/-- Over a complete local ring, for a power series `g` with nonzero reduction modulo the maximal
ideal, multiplication by `X` on `A⟦X⟧ ⧸ (g)` has characteristic polynomial the distinguished
factor `PowerSeries.weierstrassDistinguished g` of `g`. -/
theorem charpoly_lmul_mk_X_eq_weierstrassDistinguished [IsLocalRing A]
    [IsAdicComplete (IsLocalRing.maximalIdeal A) A] {g : A⟦X⟧}
    (hg : g.map (IsLocalRing.residue A) ≠ 0) [Module.Free A (A⟦X⟧ ⧸ Ideal.span {g})]
    [Module.Finite A (A⟦X⟧ ⧸ Ideal.span {g})] :
    (Algebra.lmul A (A⟦X⟧ ⧸ Ideal.span {g}) (Ideal.Quotient.mk _ X)).charpoly =
      g.weierstrassDistinguished hg :=
  (g.isWeierstrassFactorization_weierstrassDistinguished_weierstrassUnit hg).charpoly_lmul_mk_X

end PowerSeries
