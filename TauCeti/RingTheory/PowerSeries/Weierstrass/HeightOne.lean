public import TauCeti.RingTheory.PowerSeries.Weierstrass.DiscreteValuationRing

/-!
# The prime elements and height-one primes of `O⟦X⟧`

Let `O` be a discrete valuation ring with uniformiser `ϖ`, complete for its maximal ideal `𝔪`.
The power series ring `Λ = O⟦X⟧` is a noetherian unique factorisation domain (Mathlib's instance
for power series over a principal ideal domain), so its height-one primes are exactly the ideals
generated by its prime elements. Weierstrass preparation with a uniformiser power writes every
nonzero series as `C (ϖ ^ m) * u * P` with `u` a unit and `P` a distinguished polynomial, and this
determines the prime elements: up to units they are `ϖ` and the irreducible distinguished
polynomials. Consequently the height-one primes of `Λ` are `(ϖ)` and the ideals `(F)` for `F`
an irreducible distinguished polynomial. This is the list of primes over which the structure
theory of finitely generated `Λ`-modules, and the characteristic ideal of a torsion module, are
built.

The comparison between polynomials and power series runs through Mathlib's identification
`A[X] ⧸ (g) ≃ A⟦X⟧ ⧸ (g)` for a polynomial `g` distinguished at an ideal `I` of an `I`-adically
complete ring `A`: such a `g` is prime in `A[X]` exactly when it is prime in `A⟦X⟧`.

No finiteness of the residue field of `O` is needed.

## Main results

* `Polynomial.IsDistinguishedAt.isPrime_span_coe_iff` and
  `Polynomial.IsDistinguishedAt.prime_coe_iff`: a distinguished polynomial over an adically
  complete ring is prime as a power series if and only if it is prime as a polynomial.
* `PowerSeries.prime_iff_of_isDiscreteValuationRing`: the prime elements of `O⟦X⟧` are the
  associates of `C ϖ` and of the irreducible distinguished polynomials.
* `PowerSeries.height_eq_one_iff_of_isDiscreteValuationRing`: the height-one primes of `O⟦X⟧`
  are `(ϖ)` and the ideals `(F)` with `F` irreducible and distinguished.

## References

* J. Neukirch, A. Schmidt and K. Wingberg, *Cohomology of Number Fields*, second edition,
  Chapter V, §3, on the ring `O⟦T⟧` and its height-one primes.
* L. Washington, *Introduction to Cyclotomic Fields*, second edition, GTM 83, §13.2, on the
  prime ideals of `ℤ_p⟦T⟧`.
-/

public section

open IsLocalRing
open scoped Polynomial PowerSeries

namespace Polynomial.IsDistinguishedAt

variable {A : Type*} [CommRing A] {g : A[X]} {I : Ideal A}

/-- A polynomial distinguished at `I`, over an `I`-adically complete ring, generates a prime ideal
of power series if and only if it generates a prime ideal of polynomials. -/
theorem isPrime_span_coe_iff (H : g.IsDistinguishedAt I) [IsAdicComplete I A] :
    (Ideal.span {(g : PowerSeries A)}).IsPrime ↔ (Ideal.span {g}).IsPrime := by
  rw [← Ideal.Quotient.isDomain_iff_prime, ← Ideal.Quotient.isDomain_iff_prime]
  exact (MulEquiv.isDomain_iff H.algEquivQuotient.toMulEquiv).symm

/-- A polynomial distinguished at `I`, over an `I`-adically complete ring, is a prime element of
the power series ring if and only if it is a prime element of the polynomial ring. -/
theorem prime_coe_iff (H : g.IsDistinguishedAt I) [IsAdicComplete I A] :
    Prime (g : PowerSeries A) ↔ Prime g := by
  rcases subsingleton_or_nontrivial A with _ | _
  · simp [Subsingleton.elim g 0]
  have hg : g ≠ 0 := H.monic.ne_zero
  rw [← Ideal.span_singleton_prime hg,
    ← Ideal.span_singleton_prime (Polynomial.coe_eq_zero_iff.not.2 hg), H.isPrime_span_coe_iff]

end Polynomial.IsDistinguishedAt

namespace PowerSeries

variable {O : Type*} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  [IsAdicComplete (maximalIdeal O) O] {ϖ : O}

/-- **The prime elements of `O⟦X⟧`.** Over a discrete valuation ring `O` with uniformiser `ϖ`,
complete for its maximal ideal, a power series is prime if and only if it is associated to `C ϖ`
or to an irreducible polynomial distinguished at the maximal ideal. -/
theorem prime_iff_of_isDiscreteValuationRing (hϖ : Irreducible ϖ) {f : O⟦X⟧} :
    Prime f ↔ Associated (C ϖ) f ∨ ∃ F : O[X], F.IsDistinguishedAt (maximalIdeal O) ∧
      Irreducible F ∧ Associated (F : O⟦X⟧) f := by
  have hϖ' : Prime (C ϖ) := prime_C_iff.2 hϖ.prime
  refine ⟨fun hf ↦ ?_, ?_⟩
  · obtain ⟨m, P, u, -, -, hP, rfl⟩ := exists_pow_mul_distinguished_mul_unit hϖ hf.ne_zero
    rcases m with _ | m
    · -- With no uniformiser factor, `f` is the polynomial `P` up to the unit `u`.
      have hPf : Associated (P : O⟦X⟧) (C (ϖ ^ 0) * u * P) :=
        ⟨u, by rw [pow_zero, map_one, one_mul, mul_comm]⟩
      exact .inr ⟨P, hP, (hP.prime_coe_iff.1 (hPf.prime_iff.2 hf)).irreducible, hPf⟩
    · -- Otherwise `C ϖ` divides the irreducible series `f`, so they are associated.
      refine .inl (hϖ'.irreducible.associated_of_dvd hf.irreducible ⟨C (ϖ ^ m) * u * P, ?_⟩)
      rw [pow_succ', map_mul]
      ring
  · rintro (h | ⟨F, hF, hFirr, h⟩)
    · exact h.prime hϖ'
    · exact h.prime (hF.prime_coe_iff.2 hFirr.prime)

/-- **The height-one primes of `O⟦X⟧`.** Over a discrete valuation ring `O` with uniformiser `ϖ`,
complete for its maximal ideal, a prime ideal of `O⟦X⟧` has height one if and only if it is
generated by `C ϖ` or by an irreducible polynomial distinguished at the maximal ideal. -/
theorem height_eq_one_iff_of_isDiscreteValuationRing (hϖ : Irreducible ϖ) (𝔭 : Ideal O⟦X⟧)
    [𝔭.IsPrime] :
    𝔭.height = 1 ↔ 𝔭 = Ideal.span {C ϖ} ∨ ∃ F : O[X], F.IsDistinguishedAt (maximalIdeal O) ∧
      Irreducible F ∧ 𝔭 = Ideal.span {(F : O⟦X⟧)} := by
  constructor
  · intro h
    -- A height-one prime of the factorial ring `O⟦X⟧` is generated by a prime element.
    obtain ⟨f, hf𝔭, hf⟩ :=
      Ideal.IsPrime.exists_mem_prime_of_ne_bot ‹_› (𝔭.ne_bot_of_height_eq_one h)
    rw [𝔭.eq_span_singleton_of_height_eq_one h hf𝔭 hf]
    simp_rw [Ideal.span_singleton_eq_span_singleton]
    exact ((prime_iff_of_isDiscreteValuationRing hϖ).1 hf).imp Associated.symm
      fun ⟨F, hF, hirr, hFf⟩ ↦ ⟨F, hF, hirr, hFf.symm⟩
  · -- A prime element generates an ideal of height one, by Krull's principal ideal theorem.
    intro h
    obtain ⟨f, hf, rfl⟩ : ∃ f : O⟦X⟧, Prime f ∧ 𝔭 = Ideal.span {f} := by
      rcases h with rfl | ⟨F, hF, hirr, rfl⟩
      · exact ⟨_, (prime_iff_of_isDiscreteValuationRing hϖ).2 (.inl .rfl), rfl⟩
      · exact ⟨_, (prime_iff_of_isDiscreteValuationRing hϖ).2 (.inr ⟨F, hF, hirr, .rfl⟩), rfl⟩
    exact Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero hf.ne_zero) hf.not_isUnit

end PowerSeries
