module

public import TauCeti.RingTheory.PowerSeries.Weierstrass.Preparation
public import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# The ideals of the ring of restricted power series in one variable

Over a complete nonarchimedean field `K` and at a positive radius `c`, the power series restricted
at `c` form the subring `PowerSeries.IsRestricted.subring c` of `K⟦X⟧`: the Tate algebra of the
closed disc of radius `c`, which is the usual `K⟨X⟩` when `c = 1`. This file determines its
ideals. Every ideal is principal, so the ring is noetherian, and a nonzero ideal is generated by
a monic polynomial.

Weierstrass division is the Euclidean algorithm behind this. A nonzero restricted series is
distinguished of exactly one degree at `c`, and dividing by an element of an ideal whose
distinguished degree is least leaves a remainder that is a polynomial of degree smaller still; such
a remainder lies in the ideal only if it vanishes. Weierstrass preparation then replaces the
generator by a monic polynomial of the same degree.

Noetherianity of the Tate algebra in several variables is proved by induction on their number,
the inductive step dividing with coefficients in the Tate algebra of one variable fewer. The
one-variable case proved here is the base of that induction.

## Main results

* `TauCeti.PowerSeries.IsDistinguished.span_singleton_eq_of_forall_le` and
  `TauCeti.PowerSeries.IsDistinguished.le_of_mem_span_singleton`: an element of an ideal whose
  distinguished degree is least generates that ideal, and conversely a generator has least
  distinguished degree.
* `TauCeti.PowerSeries.isPrincipalIdealRing_isRestricted_subring`: every ideal of the ring of
  restricted power series is principal. Being a subring of `K⟦X⟧` over a field, the ring is also
  an integral domain, so it is a principal ideal domain.
* `TauCeti.PowerSeries.isNoetherianRing_isRestricted_subring`: the ring is noetherian.
* `TauCeti.PowerSeries.exists_isMonicOfDegree_span_singleton_eq`: a nonzero ideal is generated by
  a monic polynomial, distinguished of its own degree.

## References

* Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*, §5.2.6, the noetherianity of the Tate
  algebra in any number of variables, of which the one-variable case is proved here, and §5.2.2,
  Theorem 1, the Weierstrass preparation theorem behind the monic generator.
-/

public section

namespace TauCeti.PowerSeries

section NormedCommRing

variable {R : Type*} [NormedCommRing R] [IsUltrametricDist R] [NormMulClass R] {c : ℝ}
  {s t : ℕ}

/-- **A generator has least distinguished degree.** A nonzero multiple of `f` inside the ring of
series restricted at a positive radius is distinguished of a degree at least that of `f`, because
distinguished degrees add along a product. This is the converse of
`TauCeti.PowerSeries.IsDistinguished.span_singleton_eq_of_forall_le`: together the two say that
the distinguished degree of a generator of an ideal is the least one occurring in that ideal. -/
theorem IsDistinguished.le_of_mem_span_singleton (hc : 0 < c)
    {f g : PowerSeries.IsRestricted.subring (R := R) c}
    (hf : IsDistinguished c s (f : PowerSeries R))
    (hg : IsDistinguished c t (g : PowerSeries R)) (hmem : g ∈ Ideal.span {f}) :
    s ≤ t := by
  obtain ⟨k, rfl⟩ := Ideal.mem_span_singleton.mp hmem
  have hcoe : ((f * k : PowerSeries.IsRestricted.subring (R := R) c) : PowerSeries R)
      = (f : PowerSeries R) * (k : PowerSeries R) := by simp
  have hk0 : (k : PowerSeries R) ≠ 0 := fun h ↦ hg.ne_zero (by rw [hcoe, h, mul_zero])
  obtain ⟨j, hj⟩ := exists_isDistinguished hc k.2 hk0
  have hmul : IsDistinguished c (s + j)
      ((f * k : PowerSeries.IsRestricted.subring (R := R) c) : PowerSeries R) := by
    rw [hcoe]; exact hf.mul hj hc
  have := hg.unique hmul
  omega

end NormedCommRing

section Field

variable {K : Type*} [NormedField K] [IsUltrametricDist K] [CompleteSpace K] {c : ℝ} {s : ℕ}

/-- **An element of least distinguished degree generates.** If `f` lies in an ideal `I` of the ring
of series restricted at a positive radius `c`, is distinguished of degree `s`, and no member of `I`
is distinguished of a smaller degree, then `f` generates `I`. Dividing a member of `I` by `f`
leaves a remainder in `I` of strictly smaller distinguished degree, so the remainder vanishes. -/
theorem IsDistinguished.span_singleton_eq_of_forall_le (hc : 0 < c)
    {I : Ideal (PowerSeries.IsRestricted.subring (R := K) c)}
    {f : PowerSeries.IsRestricted.subring (R := K) c} (hfI : f ∈ I)
    (hf : IsDistinguished c s (f : PowerSeries K))
    (hmin : ∀ g ∈ I, ∀ t, IsDistinguished c t (g : PowerSeries K) → s ≤ t) :
    Ideal.span {f} = I := by
  refine le_antisymm (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hfI)) fun g hg ↦ ?_
  obtain ⟨q, r, hr, hqr⟩ := hf.exists_mul_add_eq_subring hc g
  have hrI : r ∈ I := by
    have hrsub : r = g - q * f := by rw [← hqr]; ring
    rw [hrsub]
    exact sub_mem hg (I.mul_mem_left _ hfI)
  have hr0 : r = 0 := by
    by_contra hne
    have hne' : (r : PowerSeries K) ≠ 0 := by simpa using hne
    obtain ⟨t, ht⟩ := exists_isDistinguished hc r.2 hne'
    exact ht.coeff_ne_zero (hr t (hmin r hrI t ht))
  rw [← hqr, hr0, add_zero]
  exact Ideal.mem_span_singleton.mpr ⟨q, mul_comm q f⟩

/-- **The ring of restricted power series in one variable is a principal ideal ring.** Over a
complete nonarchimedean field and at a positive radius, every ideal of the ring of restricted
series is generated by one element: a member of least distinguished degree. Being a subring of
`K⟦X⟧` over a field, the ring is also an integral domain, so it is a principal ideal domain. -/
theorem isPrincipalIdealRing_isRestricted_subring (hc : 0 < c) :
    IsPrincipalIdealRing (PowerSeries.IsRestricted.subring (R := K) c) := by
  classical
  refine ⟨fun I ↦ ?_⟩
  rcases eq_or_ne I ⊥ with rfl | hI
  · exact ⟨⟨0, by simp⟩⟩
  obtain ⟨g₀, hg₀I, hg₀⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
  have hex : ∃ t, ∃ g ∈ I, IsDistinguished c t (g : PowerSeries K) := by
    obtain ⟨t, ht⟩ := exists_isDistinguished hc g₀.2 (by simpa using hg₀)
    exact ⟨t, g₀, hg₀I, ht⟩
  obtain ⟨f, hfI, hf⟩ := Nat.find_spec hex
  exact ⟨⟨f, (IsDistinguished.span_singleton_eq_of_forall_le hc hfI hf
    fun g hgI t ht ↦ Nat.find_le ⟨g, hgI, ht⟩).symm⟩⟩

/-- **The ring of restricted power series in one variable is noetherian**, over a complete
nonarchimedean field and at a positive radius. -/
theorem isNoetherianRing_isRestricted_subring (hc : 0 < c) :
    IsNoetherianRing (PowerSeries.IsRestricted.subring (R := K) c) :=
  have := isPrincipalIdealRing_isRestricted_subring (K := K) (c := c) hc
  PrincipalIdealRing.isNoetherianRing

/-- **A nonzero ideal of the ring of restricted power series is generated by a monic polynomial.**
Over a complete nonarchimedean field and at a positive radius `c`, a nonzero ideal has a generator
`g` whose underlying series is a monic polynomial `ω`, distinguished of its own degree `n`; by
`TauCeti.PowerSeries.IsDistinguished.le_of_mem_span_singleton`, `n` is then the least
distinguished degree occurring in the ideal. -/
theorem exists_isMonicOfDegree_span_singleton_eq (hc : 0 < c)
    {I : Ideal (PowerSeries.IsRestricted.subring (R := K) c)} (hI : I ≠ ⊥) :
    ∃ (g : PowerSeries.IsRestricted.subring (R := K) c) (ω : Polynomial K) (n : ℕ),
      ω.IsMonicOfDegree n ∧ IsDistinguished c n (ω : PowerSeries K) ∧
        (g : PowerSeries K) = (ω : PowerSeries K) ∧ Ideal.span {g} = I := by
  have := isPrincipalIdealRing_isRestricted_subring (K := K) (c := c) hc
  obtain ⟨f, hf⟩ := (IsPrincipalIdealRing.principal I).principal
  have hf0 : (f : PowerSeries K) ≠ 0 := fun h ↦
    hI (hf.trans (Ideal.span_singleton_eq_bot.mpr (by simpa using h)))
  obtain ⟨n, hn⟩ := exists_isDistinguished hc f.2 hf0
  obtain ⟨e, ω, he, hω, heω⟩ := hn.exists_isUnit_isMonicOfDegree_mul_eq hc f.2
  have hωmem : ((ω : PowerSeries K)).IsRestricted c :=
    isRestricted_of_forall_coeff_eq_zero (n := ω.natDegree + 1) fun m hm ↦ by
      rw [Polynomial.coeff_coe]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
  refine ⟨⟨(ω : PowerSeries K), hωmem⟩, ω, n, hω,
    IsDistinguished.of_isUnit_mul (by rw [heω]; exact hn) hc he, rfl, ?_⟩
  -- as above, the coercion of the product reduces to the product `heω` equates with `↑f`
  have hfactor : e * ⟨(ω : PowerSeries K), hωmem⟩ = f := Subtype.ext heω
  rw [← Ideal.span_singleton_mul_left_unit he, hfactor]
  exact hf.symm

end Field

end TauCeti.PowerSeries
