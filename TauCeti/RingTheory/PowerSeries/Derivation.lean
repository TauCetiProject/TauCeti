module

public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.PowerSeries.Derivative
import Mathlib.Algebra.Polynomial.Derivation
import Mathlib.RingTheory.AdicCompletion.Completeness
import Mathlib.RingTheory.PowerSeries.Trunc
import TauCeti.RingTheory.Derivation.Ideal

/-!
# Derivations of formal power series

Let `R` be a commutative ring and `M` an `R⟦X⟧`-module which is Hausdorff for the `X`-adic
topology, for instance `R⟦X⟧` itself. This file shows that every `R`-derivation `D : R⟦X⟧ → M`
is determined by its value at `X`, namely `D f = f' • D X`, so that `m ↦ (f ↦ f' • m)` is an
`R⟦X⟧`-linear equivalence between `M` and `Derivation R R⟦X⟧ M`. In particular every derivation
of `R⟦X⟧` is a power-series multiple `a • d⁄dX` of the formal derivative. This holds in every
characteristic and needs no continuity hypothesis.

Although `R⟦X⟧` is not generated by `X` as an `R`-algebra, the value `D X` controls `D` through
truncation. If `D X = 0`, then `D` vanishes on polynomials, and writing
`f = X ^ (n + 1) * g + trunc (n + 1) f` gives `D f = D (X ^ (n + 1) * g)`, which lies in
`X ^ n • M` by the Leibniz rule (`Derivation.apply_mem_pow_smul_top_of_mem_pow_succ`). As this
holds for every `n`, `D f = 0` by the Hausdorff property. The same Leibniz estimate shows that
every derivation is `X`-adically continuous (`Derivation.continuous_adic`).

This parallels Mathlib's `Polynomial.derivation_ext` and `Polynomial.mkDerivationEquiv` for
derivations of `R[X]`.

## Main results

* `PowerSeries.derivation_ext`: derivations of `R⟦X⟧` into an `X`-adically Hausdorff module that
  agree at `X` are equal.
* `PowerSeries.mkDerivation`: the derivation `f ↦ f' • m` taking the value `m` at `X`.
* `PowerSeries.mkDerivationEquiv`: the `R⟦X⟧`-linear equivalence between `M` and
  `Derivation R R⟦X⟧ M`, inverse to evaluation at `X`.
* `Derivation.apply_eq_derivative_smul`: `D f = f' • D X`.
* `Derivation.eq_smul_derivative`: every derivation of `R⟦X⟧` is `D X • d⁄dX`.
-/

public section

namespace PowerSeries

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R⟦X⟧ M] [Module R M]
  [IsScalarTower R R⟦X⟧ M]

/-- Two derivations of `R⟦X⟧` into an `X`-adically Hausdorff module which agree at `X` are
equal. -/
theorem derivation_ext [IsHausdorff (Ideal.span {(X : R⟦X⟧)}) M] {D₁ D₂ : Derivation R R⟦X⟧ M}
    (h : D₁ X = D₂ X) : D₁ = D₂ := by
  -- the difference `D₁ - D₂` vanishes at `X`; it suffices that such a derivation vanishes
  suffices key : ∀ D : Derivation R R⟦X⟧ M, D X = 0 → ∀ f, D f = 0 by
    ext f
    simpa [sub_eq_zero] using key (D₁ - D₂) (by simp [h]) f
  intro D hD f
  refine IsHausdorff.haus (I := Ideal.span {(X : R⟦X⟧)}) inferInstance _ fun n ↦ ?_
  rw [SModEq.zero, eq_X_pow_mul_shift_add_trunc (n + 1) f, map_add]
  refine add_mem (D.apply_mem_pow_smul_top_of_mem_pow_succ ?_) ?_
  · rw [Ideal.span_singleton_pow]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · -- `D` vanishes on the polynomial `trunc (n + 1) f`, by the chain rule for polynomials
    rw [← Polynomial.eval₂_C_X_eq_coe, ← algebraMap_eq, ← Polynomial.aeval_def,
      D.comp_aeval_eq, hD, smul_zero]
    exact zero_mem _

variable (R) in
/-- The derivation of `R⟦X⟧` taking the value `m` at `X`, namely `f ↦ f' • m`. -/
noncomputable def mkDerivation : M →ₗ[R⟦X⟧] Derivation R R⟦X⟧ M where
  toFun m := (LinearMap.toSpanSingleton R⟦X⟧ M m).compDer d⁄dX
  map_add' _ _ := by ext; simp
  map_smul' _ _ := by
    ext
    exact smul_comm _ _ _

theorem mkDerivation_apply (m : M) (f : R⟦X⟧) : mkDerivation R m f = d⁄dX f • m := (rfl)

@[simp]
theorem mkDerivation_X (m : M) : mkDerivation R m X = m := by simp [mkDerivation_apply]

@[simp]
theorem mkDerivation_one : mkDerivation R (1 : R⟦X⟧) = d⁄dX := by
  ext f
  simp [mkDerivation_apply]

variable (R M) in
/-- For an `X`-adically Hausdorff `R⟦X⟧`-module `M`, `PowerSeries.mkDerivation` is an
`R⟦X⟧`-linear equivalence between `M` and the derivations `R⟦X⟧ → M`, inverse to evaluation
at `X`. -/
noncomputable def mkDerivationEquiv [IsHausdorff (Ideal.span {(X : R⟦X⟧)}) M] :
    M ≃ₗ[R⟦X⟧] Derivation R R⟦X⟧ M :=
  .symm
    { invFun := mkDerivation R
      toFun D := D X
      map_add' _ _ := rfl
      map_smul' _ _ := rfl
      left_inv _ := derivation_ext <| mkDerivation_X _
      right_inv := mkDerivation_X }

variable [IsHausdorff (Ideal.span {(X : R⟦X⟧)}) M]

@[simp]
theorem mkDerivationEquiv_apply (m : M) : mkDerivationEquiv R M m = mkDerivation R m := (rfl)

@[simp]
theorem mkDerivationEquiv_symm_apply (D : Derivation R R⟦X⟧ M) :
    (mkDerivationEquiv R M).symm D = D X := (rfl)

end PowerSeries

namespace Derivation

open PowerSeries

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R⟦X⟧ M] [Module R M]
  [IsScalarTower R R⟦X⟧ M]

/-- A derivation `D` of `R⟦X⟧` into an `X`-adically Hausdorff module is determined by its value
at `X`: `D f = f' • D X`. -/
theorem apply_eq_derivative_smul [IsHausdorff (Ideal.span {(X : R⟦X⟧)}) M]
    (D : Derivation R R⟦X⟧ M) (f : R⟦X⟧) : D f = d⁄dX f • D X :=
  (DFunLike.congr_fun (derivation_ext (D₂ := mkDerivation R (D X)) (by simp)) f).trans
    (mkDerivation_apply _ _)

/-- Every derivation of `R⟦X⟧` is the multiple `D X • d⁄dX` of the formal derivative. -/
theorem eq_smul_derivative (D : Derivation R R⟦X⟧ R⟦X⟧) : D = D X • d⁄dX :=
  derivation_ext <| by simp

end Derivation
