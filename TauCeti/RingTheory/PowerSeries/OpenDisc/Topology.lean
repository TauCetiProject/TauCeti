public import Mathlib.Topology.Algebra.IsUniformGroup.Constructions

/-!
# The Gauss topology on series on an open disc

For an ultrametric normed ring `R` and a positive radius `R₀`, the algebra of series on the
open disc carries the topology of the Gauss norms at all radii `0 < r < R₀`. Convergence is
convergence in each of these norms, rather than convergence of individual coefficients.
The resulting uniform ring is Hausdorff and is complete when `R` is complete.

Restriction embeds the algebra into the product of the smaller closed-disc algebras. Its
image consists of the families with the same formal coefficients at every radius. This
description proves completeness without choosing a sequence of radii or a single norm.
Convergence may also be tested along any family of radii tending to the boundary, so a
cofinal sequence yields the same topology. Polynomial truncations converge in this topology,
and coefficient maps are uniformly continuous.

## References

* P. Colmez, *Fonctions d'une variable p-adique*, Astérisque 330 (2010), §I.4.
-/

public section

open Filter PowerSeries
open scoped Topology

namespace TauCeti.PowerSeries.OnOpenDisc

variable {R : Type*} [NormedRing R] [IsUltrametricDist R] {R₀ : ℝ}

-- Supply the positivity witness used by the Gauss-norm instances on each closed disc.
local instance radius_pos (r : Set.Ioo (0 : ℝ) R₀) : Fact (0 < (r : ℝ)) := ⟨r.2.1⟩

/-- Restriction of an open-disc series to a smaller positive closed disc. -/
noncomputable def restrict (r : Set.Ioo (0 : ℝ) R₀) :
    OnOpenDisc.subring R R₀ →+* IsRestricted.subring (R := R) (r : ℝ) :=
  Subring.inclusion fun _ hf ↦ onOpenDisc_iff.mp (OnOpenDisc.mem_subring.mp hf) _ r.2.1 r.2.2

/-- Restriction leaves the underlying formal series unchanged. -/
@[simp]
theorem coe_restrict (r : Set.Ioo (0 : ℝ) R₀) (f : OnOpenDisc.subring R R₀) :
    (restrict r f : R⟦X⟧) = f :=
  Subring.coe_inclusion _ f

/-- Restriction of an open-disc series to all smaller positive closed discs at once. -/
noncomputable def restrictFamily :
    OnOpenDisc.subring R R₀ →+* ∀ r : Set.Ioo (0 : ℝ) R₀, IsRestricted.subring (R := R) (r : ℝ) :=
  RingHom.pi restrict

/-- Each component of the family of restrictions is the restriction to that radius. -/
@[simp]
theorem restrictFamily_apply (f : OnOpenDisc.subring R R₀) (r : Set.Ioo (0 : ℝ) R₀) :
    restrictFamily f r = restrict r f :=
  (rfl)

/-- The uniformity generated by all smaller positive-radius Gauss norms. -/
noncomputable instance uniformSpace : UniformSpace (OnOpenDisc.subring R R₀) :=
  UniformSpace.comap (restrictFamily (R := R) (R₀ := R₀))
    (inferInstanceAs (UniformSpace
      (∀ r : Set.Ioo (0 : ℝ) R₀, IsRestricted.subring (R := R) (r : ℝ))))

/-- The Gauss uniformity is induced by the family of closed-disc restrictions. -/
theorem isUniformInducing_restrictFamily :
    IsUniformInducing (restrictFamily (R := R) (R₀ := R₀)) :=
  ⟨rfl⟩

/-- Restriction to any smaller closed disc is uniformly continuous for the Gauss uniformities. -/
theorem uniformContinuous_restrict (r : Set.Ioo (0 : ℝ) R₀) :
    UniformContinuous (restrict (R := R) r) :=
  (Pi.uniformContinuous_proj _ r).comp isUniformInducing_restrictFamily.uniformContinuous

/-- Convergence on the open disc is convergence in every smaller positive-radius Gauss norm. -/
theorem tendsto_iff {ι : Type*} {l : Filter ι}
    {f : ι → OnOpenDisc.subring R R₀} {g : OnOpenDisc.subring R R₀} :
    Tendsto f l (𝓝 g) ↔ ∀ r : Set.Ioo (0 : ℝ) R₀,
      Tendsto (fun i ↦ restrict r (f i)) l (𝓝 (restrict r g)) := by
  rw [isUniformInducing_restrictFamily.isInducing.tendsto_nhds_iff, tendsto_pi_nhds]
  rfl

/-- Convergence can be tested at any cofinal family of smaller positive radii. -/
theorem tendsto_iff_of_cofinal_radius {ι κ : Type*}
    {ρ : ι → Set.Ioo (0 : ℝ) R₀} (hρ : ∀ r : Set.Ioo (0 : ℝ) R₀, ∃ i, (r : ℝ) ≤ ρ i)
    {F : Filter κ} {f : κ → OnOpenDisc.subring R R₀} {g : OnOpenDisc.subring R R₀} :
    Tendsto f F (𝓝 g) ↔ ∀ i, Tendsto (fun j ↦ restrict (ρ i) (f j)) F (𝓝 (restrict (ρ i) g)) := by
  refine ⟨fun h i ↦ tendsto_iff.mp h (ρ i), fun h ↦ tendsto_iff.mpr fun r ↦ ?_⟩
  obtain ⟨i, hi⟩ := hρ r
  let φ := TauCeti.PowerSeries.restrictedRadiusHom (R := R) r.2.1.le hi
  have hc : Continuous φ := TauCeti.PowerSeries.continuous_restrictedRadiusHom r.2.1.le hi
  have heq (a : OnOpenDisc.subring R R₀) : φ (restrict (ρ i) a) = restrict r a := by
    apply Subtype.ext
    simp only [φ, TauCeti.PowerSeries.coe_restrictedRadiusHom, coe_restrict]
  simpa only [Function.comp_def, heq] using (hc.tendsto (restrict (ρ i) g)).comp (h i)

/-- A map into the open-disc algebra is continuous exactly when each restriction is continuous. -/
theorem continuous_iff {X : Type*} [TopologicalSpace X] {f : X → OnOpenDisc.subring R R₀} :
    Continuous f ↔ ∀ r : Set.Ioo (0 : ℝ) R₀, Continuous fun x ↦ restrict r (f x) := by
  rw [isUniformInducing_restrictFamily.isInducing.continuous_iff, continuous_pi_iff]
  rfl

/-- A map into the open-disc algebra is uniformly continuous exactly when each restriction is. -/
theorem uniformContinuous_iff {X : Type*} [UniformSpace X]
    {f : X → OnOpenDisc.subring R R₀} :
    UniformContinuous f ↔ ∀ r : Set.Ioo (0 : ℝ) R₀,
      UniformContinuous fun x ↦ restrict r (f x) := by
  rw [isUniformInducing_restrictFamily.uniformContinuous_iff, uniformContinuous_pi]
  rfl

instance : IsUniformAddGroup (OnOpenDisc.subring R R₀) :=
  isUniformInducing_restrictFamily.isUniformAddGroup restrictFamily

instance : IsTopologicalRing (OnOpenDisc.subring R R₀) where
  continuous_mul := continuous_iff.mpr fun r ↦ by
    simp only [map_mul]
    exact continuous_mul.comp
      (((uniformContinuous_restrict r).continuous.comp continuous_fst).prodMk
        ((uniformContinuous_restrict r).continuous.comp continuous_snd))

/-- Polynomial truncations converge in every smaller-radius Gauss norm simultaneously. -/
theorem tendsto_polynomialHom_trunc (f : OnOpenDisc.subring R R₀) :
    Tendsto (fun n ↦ OnOpenDisc.polynomialHom (R₀ := R₀) ((f : R⟦X⟧).trunc n)) atTop (𝓝 f) := by
  refine tendsto_iff.mpr fun r ↦ ?_
  convert TauCeti.PowerSeries.tendsto_trunc_atTop (restrict r f) using 1
  · ext n : 1
    apply Subtype.ext
    simp only [coe_restrict, OnOpenDisc.coe_polynomialHom]

/-- Polynomials are dense for the topology of all smaller-radius Gauss norms. -/
theorem denseRange_polynomialHom : DenseRange (OnOpenDisc.polynomialHom (R := R) (R₀ := R₀)) :=
  fun f ↦ mem_closure_of_tendsto (tendsto_polynomialHom_trunc f)
    (.of_forall fun _ ↦ Set.mem_range_self _)

variable [Fact (0 < R₀)]

private noncomputable def baseRadius : Set.Ioo (0 : ℝ) R₀ :=
  ⟨R₀ / 2, half_pos Fact.out, half_lt_self Fact.out⟩

/-- The family of smaller-disc restrictions determines an open-disc series. -/
theorem restrictFamily_injective :
    Function.Injective (restrictFamily (R := R) (R₀ := R₀)) := by
  intro f g h
  exact Subtype.ext (congrArg (fun h ↦ (h baseRadius : R⟦X⟧)) h)

/-- Closed-disc restrictions embed the open-disc algebra uniformly into their product. -/
theorem isUniformEmbedding_restrictFamily :
    IsUniformEmbedding (restrictFamily (R := R) (R₀ := R₀)) :=
  ⟨isUniformInducing_restrictFamily, restrictFamily_injective⟩

instance : T2Space (OnOpenDisc.subring R R₀) :=
  isUniformEmbedding_restrictFamily.isEmbedding.t2Space

/-- Each coefficient is uniformly continuous for the open-disc Gauss uniformity. -/
theorem uniformContinuous_coeff (n : ℕ) :
    UniformContinuous fun f : OnOpenDisc.subring R R₀ ↦ coeff n (f : R⟦X⟧) := by
  have h := TauCeti.PowerSeries.uniformContinuous_coeff
    (R := R) (c := (baseRadius (R₀ := R₀) : ℝ)) n
  exact h.comp (uniformContinuous_restrict baseRadius)

/-- The restriction image consists exactly of families with radius-independent coefficients. -/
theorem range_restrictFamily :
    Set.range (restrictFamily (R := R) (R₀ := R₀)) =
      {g | ∀ r s : Set.Ioo (0 : ℝ) R₀, ∀ n : ℕ,
        coeff n (g r : R⟦X⟧) = coeff n (g s : R⟦X⟧)} := by
  ext g
  refine ⟨?_, fun hg ↦ ?_⟩
  · rintro ⟨f, rfl⟩
    intro r s n
    simp only [restrictFamily_apply, coe_restrict]
  · have heq (r) : (g r : R⟦X⟧) = (g baseRadius : R⟦X⟧) := PowerSeries.ext (hg r baseRadius)
    refine ⟨⟨(g baseRadius : R⟦X⟧),
      OnOpenDisc.mem_subring.mpr (onOpenDisc_iff.mpr (fun r hr hrR ↦ ?_))⟩, ?_⟩
    · rw [← heq ⟨r, hr, hrR⟩]
      exact (g ⟨r, hr, hrR⟩).2
    · funext r
      exact Subtype.ext (heq r).symm

/-- Coefficient-compatible families form a closed subset of the product of closed-disc algebras. -/
theorem isClosed_range_restrictFamily :
    IsClosed (Set.range (restrictFamily (R := R) (R₀ := R₀))) := by
  rw [range_restrictFamily]
  simp only [Set.ofPred_forall]
  refine isClosed_iInter fun r ↦ isClosed_iInter fun s ↦ isClosed_iInter fun n ↦ ?_
  have h (s : Set.Ioo (0 : ℝ) R₀) : Continuous fun g :
      (∀ r : Set.Ioo (0 : ℝ) R₀, IsRestricted.subring (R := R) (r : ℝ)) ↦
      coeff n (g s : R⟦X⟧) := by
    exact (TauCeti.PowerSeries.uniformContinuous_coeff n).continuous.comp (continuous_apply s)
  exact isClosed_eq (h r) (h s)

/-- The open-disc algebra with all smaller-radius Gauss norms is complete over complete
coefficients. -/
instance [CompleteSpace R] : CompleteSpace (OnOpenDisc.subring R R₀) :=
  isUniformInducing_restrictFamily.completeSpace isClosed_range_restrictFamily.isComplete

end TauCeti.PowerSeries.OnOpenDisc
