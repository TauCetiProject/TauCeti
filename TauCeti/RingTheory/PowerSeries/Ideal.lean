/-!
# Kernels of the coefficient maps of power series

The kernel of the constant coefficient `R⟦X⟧ →+* R` is the ideal `(X)`, and the constant
coefficient is a local homomorphism: a power series is a unit exactly when its constant
coefficient is. Since `C : R →+* R⟦X⟧` is injective, `R⟦X⟧` inherits characteristic `p` and
characteristic zero from `R`.

For a ring homomorphism `f : R →+* S` with finitely generated kernel, the kernel of the induced
map `R⟦X⟧ →+* S⟦X⟧` is the extension of `ker f` along the constant embedding `C`. This is the
one-variable form of `MvPowerSeries.ker_map_of_fg`.

Applied to the quotient map `R → R ⧸ (r)`, whose kernel is principal, this identifies
`R⟦X⟧ ⧸ (r)` with `(R ⧸ (r))⟦X⟧`. Hence a constant series `C r` is a prime element of `R⟦X⟧`
exactly when `r` is a prime element of `R`, as for polynomials (`Polynomial.prime_C_iff`). Over a
local domain with a prime `ϖ`, a series with nonzero reduction modulo the maximal ideal is not
divisible by `C ϖ`, so it acts injectively on `R⟦X⟧ ⧸ (ϖ ^ m)`.

A series whose coefficients lie in an ideal `J` has square zero modulo any ideal containing
`J * J`. For a finitely generated ideal `I`, the same kernel computation describes `I.map C` and
its powers `(I.map C) ^ k` by their coefficients and shows that `I.map C` is prime when `I` is.

## Main results

* `PowerSeries.ker_constantCoeff`, `PowerSeries.ker_constantCoeffAlgHom`,
  `PowerSeries.quotientSpanXAlgEquiv`: the constant coefficient, as an `R`-algebra homomorphism
  `R⟦X⟧ →ₐ[R] R`, has kernel `(X)`, giving the `R`-algebra isomorphism `R⟦X⟧ ⧸ (X) ≃ₐ[R] R`.
* `PowerSeries.isLocalHom_constantCoeff`: the constant coefficient is a local homomorphism.
* `PowerSeries.instCharP`, `PowerSeries.instCharZero`: `R⟦X⟧` inherits characteristic from `R`.
* `PowerSeries.ker_map_of_fg`: `ker (map f) = (ker f).map C` when `ker f` is finitely generated.
* `PowerSeries.mem_map_C_iff_of_fg`, `PowerSeries.mem_map_C_pow_iff_of_fg`,
  `PowerSeries.mem_span_C_pow_iff`, `PowerSeries.map_mem_span_C_pow`,
  `PowerSeries.isPrime_map_C_of_fg`: coefficientwise characterization of `I.map C`, its powers,
  and principal constant powers `(C r) ^ k`, plus functoriality and primality.
* `PowerSeries.prime_C_iff`: `C r` is prime in `R⟦X⟧` if and only if `r` is prime in `R`.
* `PowerSeries.torsionBy_quotient_span_C_pow_eq_bot`: a series with nonzero reduction modulo the
  maximal ideal has no nonzero torsion on `R⟦X⟧ ⧸ (ϖ ^ m)` for a prime `ϖ` of a local domain.
* `PowerSeries.sq_map_mk_eq_zero_of_coeff_mem`: a series with coefficients in `J` squares to zero
  in `(R ⧸ K)⟦X⟧` when `J * J ≤ K`.
-/

public section

namespace PowerSeries

section ConstantCoeff

variable {R : Type*}

/-- The kernel of the constant coefficient map on `R⟦X⟧` is the ideal generated by `X`. -/
theorem ker_constantCoeff [CommSemiring R] :
    RingHom.ker (constantCoeff (R := R)) = Ideal.span {X} := by
  ext f
  simp [Ideal.mem_span_singleton, X_dvd_iff]

/-- The kernel of `PowerSeries.constantCoeffAlgHom` is the ideal generated by `X`. -/
theorem ker_constantCoeffAlgHom [CommSemiring R] :
    RingHom.ker (constantCoeffAlgHom R : R⟦X⟧ →ₐ[R] R) = Ideal.span {X} := by
  rw [← RingHom.ker_coe_toRingHom, constantCoeffAlgHom_toRingHom, ker_constantCoeff]

/-- The constant coefficient induces an `R`-algebra isomorphism `R⟦X⟧ ⧸ (X) ≃ₐ[R] R`. -/
noncomputable def quotientSpanXAlgEquiv (R : Type*) [CommRing R] :
    (R⟦X⟧ ⧸ Ideal.span {(X : R⟦X⟧)}) ≃ₐ[R] R :=
  (Ideal.quotientEquivAlgOfEq R ker_constantCoeffAlgHom.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (f := (constantCoeffAlgHom R : R⟦X⟧ →ₐ[R] R))
      fun r ↦ ⟨C r, by simp⟩)

/-- `PowerSeries.quotientSpanXAlgEquiv` sends the class of `f` to its constant coefficient. -/
@[simp]
theorem quotientSpanXAlgEquiv_mk [CommRing R] (f : R⟦X⟧) :
    quotientSpanXAlgEquiv R (Ideal.Quotient.mk _ f) = constantCoeff f := by
  rw [quotientSpanXAlgEquiv, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk]
  exact (Ideal.quotientKerAlgEquivOfSurjective_mk _ f).trans (constantCoeffAlgHom_apply f)

/-- The inverse of `PowerSeries.quotientSpanXAlgEquiv` sends `r : R` to the class of `C r`. -/
@[simp]
theorem quotientSpanXAlgEquiv_symm_apply [CommRing R] (r : R) :
    (quotientSpanXAlgEquiv R).symm r = Ideal.Quotient.mk _ (C r) := by
  rw [AlgEquiv.symm_apply_eq, quotientSpanXAlgEquiv_mk, constantCoeff_C]

/-- The constant coefficient is a local homomorphism: a power series is a unit exactly when its
constant coefficient is. -/
instance isLocalHom_constantCoeff [Ring R] : IsLocalHom (constantCoeff (R := R)) :=
  ⟨fun _ ↦ isUnit_iff_constantCoeff.mpr⟩

/-- Power series over a semiring of characteristic `p` have characteristic `p`. -/
instance instCharP [Semiring R] (p : ℕ) [CharP R p] : CharP R⟦X⟧ p :=
  charP_of_injective_ringHom C_injective p

/-- Power series over a characteristic-zero semiring have characteristic zero. -/
instance instCharZero [Semiring R] [CharZero R] : CharZero R⟦X⟧ :=
  charZero_of_injective_ringHom C_injective

end ConstantCoeff

variable {R S : Type*} [CommRing R] [CommRing S]

/-- If `f : R →+* S` has finitely generated kernel, the kernel of the coefficientwise map
`R⟦X⟧ →+* S⟦X⟧` is the extension of `ker f` along the constant embedding. -/
theorem ker_map_of_fg (f : R →+* S) (hf : (RingHom.ker f).FG) :
    RingHom.ker (map f) = (RingHom.ker f).map C := by
  -- `PowerSeries.map` is `MvPowerSeries.map` over `Unit`, and `C` is `MvPowerSeries.C`.
  rw [map, MvPowerSeries.ker_map_of_fg _ hf]
  rfl

/-- For a finitely generated ideal `I`, a power series lies in the extension `I.map C` iff all of
its coefficients lie in `I`. -/
theorem mem_map_C_iff_of_fg {I : Ideal R} (hI : I.FG) {f : R⟦X⟧} :
    f ∈ I.map C ↔ ∀ n, coeff n f ∈ I := by
  rw [← Ideal.mk_ker (I := I), ← ker_map_of_fg _ (by rwa [Ideal.mk_ker]), RingHom.mem_ker,
    PowerSeries.ext_iff]
  simp [Ideal.Quotient.eq_zero_iff_mem]

/-- For a finitely generated ideal `I`, a power series lies in `(I.map C) ^ k` iff all of its
coefficients lie in `I ^ k`. -/
theorem mem_map_C_pow_iff_of_fg {I : Ideal R} (hI : I.FG) (k : ℕ) {f : R⟦X⟧} :
    f ∈ I.map C ^ k ↔ ∀ n, coeff n f ∈ I ^ k := by
  rw [← Ideal.map_pow, mem_map_C_iff_of_fg (hI.pow (n := k))]

/-- A power series lies in `Ideal.span {C r} ^ k` iff every coefficient lies in
`Ideal.span {r} ^ k`. -/
theorem mem_span_C_pow_iff (r : R) (k : ℕ) {f : R⟦X⟧} :
    f ∈ Ideal.span {C r} ^ k ↔ ∀ n, coeff n f ∈ Ideal.span {r} ^ k := by
  simp only [Ideal.span_singleton_pow, ← map_pow, Ideal.mem_span_singleton, C_dvd_iff_dvd_coeff]

/-- Coefficientwise change of base ring maps `Ideal.span {C r} ^ k` into
`Ideal.span {C (φ r)} ^ k`. -/
theorem map_mem_span_C_pow (φ : R →+* S) {r : R} {k : ℕ} {f : R⟦X⟧}
    (hf : f ∈ Ideal.span {C r} ^ k) :
    map φ f ∈ Ideal.span {C (φ r)} ^ k := by
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hf ⊢
  obtain ⟨q, rfl⟩ := hf
  exact ⟨map φ q, by rw [map_mul, map_pow, map_C]⟩

/-- The extension `I.map C` of a finitely generated prime ideal `I` of `R` is a prime ideal of
`R⟦X⟧`: it is the kernel of `R⟦X⟧ → (R ⧸ I)⟦X⟧`, whose target is a domain. -/
theorem isPrime_map_C_of_fg {I : Ideal R} [I.IsPrime] (hI : I.FG) :
    (I.map (C : R →+* R⟦X⟧)).IsPrime := by
  rw [← Ideal.mk_ker (I := I), ← ker_map_of_fg _ (by rwa [Ideal.mk_ker])]
  exact RingHom.ker_isPrime _

/-- A constant power series `C r` is a prime element of `R⟦X⟧` if and only if `r` is a prime
element of `R`. -/
theorem prime_C_iff {r : R} : Prime (C r) ↔ Prime r := by
  refine ⟨comap_prime C constantCoeff constantCoeff_C, fun hr ↦ ?_⟩
  have hspan : (Ideal.span {r}).IsPrime := (Ideal.span_singleton_prime hr.ne_zero).2 hr
  have hker : RingHom.ker (map (Ideal.Quotient.mk (Ideal.span {r}))) = Ideal.span {C r} := by
    rw [ker_map_of_fg _ (by rw [Ideal.mk_ker]; exact ⟨{r}, by simp⟩), Ideal.mk_ker,
      Ideal.map_span, Set.image_singleton]
  refine (Ideal.span_singleton_prime ((map_ne_zero_iff C C_injective).2 hr.ne_zero)).1 ?_
  exact hker ▸ RingHom.ker_isPrime _

/-- Over a local domain `R` with a prime `ϖ`, a power series `g` with nonzero reduction modulo the
maximal ideal acts injectively on `R⟦X⟧ ⧸ (ϖ ^ m)`. In Iwasawa theory these are the vertical
blocks of an elementary module. -/
theorem torsionBy_quotient_span_C_pow_eq_bot [IsDomain R] [IsLocalRing R] {ϖ : R} (hϖ : Prime ϖ)
    {g : R⟦X⟧} (hg : g.map (IsLocalRing.residue R) ≠ 0) (m : ℕ) :
    Submodule.torsionBy R⟦X⟧ (R⟦X⟧ ⧸ Ideal.span {C (ϖ ^ m)}) g = ⊥ := by
  rw [← isSMulRegular_iff_torsionBy_eq_bot, map_pow]
  refine (prime_C_iff.2 hϖ).isSMulRegular_quotient_span_pow (fun ⟨k, hk⟩ ↦ hg ?_) m
  -- `ϖ` lies in the maximal ideal, so `C ϖ * k` reduces to zero.
  rw [hk, map_mul, map_C, (IsLocalRing.residue_eq_zero_iff ϖ).2 hϖ.not_isUnit, map_zero, zero_mul]

/-- A series whose coefficients lie in an ideal `J` squares to zero in `(R ⧸ K)⟦X⟧` for any ideal
`K` containing `J * J`. -/
theorem sq_map_mk_eq_zero_of_coeff_mem {J K : Ideal R} (hJK : J * J ≤ K) {f : R⟦X⟧}
    (hf : ∀ n, coeff n f ∈ J) : (f.map (Ideal.Quotient.mk K)) ^ 2 = 0 := by
  ext n
  rw [sq, ← map_mul, coeff_map, map_zero, Ideal.Quotient.eq_zero_iff_mem]
  exact hJK (coeff_mul_mem_ideal_mul_ideal_of_coeff_mem_ideal' hf hf n)

end PowerSeries
