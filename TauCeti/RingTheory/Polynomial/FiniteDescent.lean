module

public import Mathlib.Algebra.Algebra.RestrictScalars
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.LinearAlgebra.FreeModule.Finite.Basic
public import Mathlib.RingTheory.PolynomialAlgebra
public import TauCeti.LinearAlgebra.Basis.Algebra
import Mathlib.Algebra.Polynomial.Lifts

/-!
# Descent of finite free algebras over a polynomial ring

A finite free algebra over `K[X]`, with a specified basis, is obtained by extension of constants
from a finite free algebra over `k₀[X]`, where `k₀` is a finitely generated intermediate field
of `K/k`. The same basis descends, as do any finitely many specified algebra elements. In
particular, choosing `k = ℚ` descends the finite bases and multiplication tables of affine
finite-map charts while retaining their rank and their scalar-extension diagram.

The coefficient field is generated by coefficients of the coordinate polynomials of the unit,
basis products, and specified elements. The algebra model is the span of the original basis
over the smaller polynomial ring. This construction uses Mathlib's `Polynomial.lifts` API,
`Module.Basis.restrictScalars`, and `IsBaseChange.of_basis`.
-/

public section

open Polynomial

attribute [local instance] Polynomial.algebra

namespace Module.Basis

variable {k K B ι : Type*} [Field k] [Field K] [Algebra k K] [CommRing B]
  [Algebra K[X] B] [Finite ι]

/-- A finite free algebra over `K[X]` descends, together with its chosen basis and any finite
set of elements, to the polynomial ring over a finitely generated intermediate field of
`K/k`. The polynomial action on the model is the restriction of the original `K[X]` action. -/
theorem exists_intermediateField_fg_subalgebra_basis (b : Basis ι K[X] B) (s : Finset B) :
    ∃ L : IntermediateField k K, L.FG ∧
      let _ : Algebra L[X] B := Algebra.restrictScalars L[X] K[X] B
      let _ : IsScalarTower L[X] K[X] B := IsScalarTower.of_algebraMap_eq' rfl
      ∃ C : Subalgebra L[X] B, ∃ c : Basis ι L[X] C,
        (∀ i, (c i : B) = b i) ∧ (∀ x ∈ s, x ∈ C) ∧
          Algebra.IsPushout L[X] K[X] C B := by
  classical
  let _ := Fintype.ofFinite ι
  let t : Finset K[X] :=
    (Finset.univ.image fun i ↦ b.repr 1 i) ∪
      (Finset.univ.image fun ijl : ι × ι × ι ↦ b.repr (b ijl.1 * b ijl.2.1) ijl.2.2) ∪
      (s.biUnion fun x ↦ Finset.univ.image fun i ↦ b.repr x i)
  let a : Finset K := t.biUnion fun p ↦ p.coeffs
  let L : IntermediateField k K := IntermediateField.adjoin k (a : Set K)
  let : Algebra L[X] B := Algebra.restrictScalars L[X] K[X] B
  have : IsScalarTower L[X] K[X] B := IsScalarTower.of_algebraMap_eq' rfl
  have hpoly (p : K[X]) (hp : p ∈ t) : p ∈ Set.range (algebraMap L[X] K[X]) := by
    apply (lifts_iff_set_range p).mp
    apply (lifts_iff_coeffs_subset_range p).mpr
    intro x hx
    refine ⟨⟨x, IntermediateField.subset_adjoin k (a : Set K) ?_⟩, rfl⟩
    exact Finset.mem_biUnion.mpr ⟨p, hp, by simpa using hx⟩
  have h₁ (i : ι) : b.repr 1 i ∈ Set.range (algebraMap L[X] K[X]) :=
    hpoly _ (by simp [t])
  have hmul (i j l : ι) : b.repr (b i * b j) l ∈ Set.range (algebraMap L[X] K[X]) :=
    hpoly _ (by
      apply Finset.mem_union_left
      apply Finset.mem_union_right
      exact Finset.mem_image.mpr ⟨(i, j, l), Finset.mem_univ _, rfl⟩)
  obtain ⟨C, c, hC, hc, hbase⟩ := b.exists_subalgebra_basis_of_repr_mem h₁ hmul
  refine ⟨L, IntermediateField.fg_adjoin_finset a, C, c, hc, ?_, hbase⟩
  intro x hx
  have hspan : x ∈ C.toSubmodule := by
    rw [hC]
    apply (b.mem_span_iff_repr_mem L[X] x).mpr
    intro i
    apply hpoly
    exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr
      ⟨x, hx, Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩⟩)
  exact hspan

end Module.Basis
