module

public import Mathlib.RingTheory.IsAdjoinRoot
public import TauCeti.RingTheory.Flat.Monogenic
public import TauCeti.RingTheory.Polynomial.Monic.OfCoeff

/-!
# Coefficient charts for finite flat quotients of the polynomial ring

An ideal of `R[X]` whose quotient is finite free of rank `n` has a unique monic generator of
degree `n`. The same holds when the quotient is only finite flat of constant rank `n`, that is,
finite locally free of rank `n`, because a quotient of `R[X]` is generated by the class of `X`,
and a monogenic finite flat algebra of constant rank is free
(`TauCeti.Module.free_of_adjoin_eq_top`). Thus these ideals are parameterized by `n` lower
coefficients. Extension of ideals along a homomorphism between nontrivial commutative rings acts
coordinatewise on this chart, including over rings with nilpotents and when roots collide.
Degree zero corresponds to the unit ideal.

This is the affine algebra used to parameterize finite divisors on the relative affine line:
the closed subscheme of such a divisor is finite locally free over the base, not necessarily
free. The monogenic presentation is Mathlib's `IsAdjoinRootMonic.mkOfAdjoinEqTop'`.

## References

* The Stacks Project, *Hilbert scheme of points*, Section 44.2, Tag 0B94.
-/

public section

open Polynomial

namespace Ideal

variable {R : Type*} [CommRing R]

/-- The quotient `R[X] ⧸ I` is generated as an `R`-algebra by the class of `X`. -/
lemma adjoin_quotient_mk_X_eq_top (I : Ideal R[X]) :
    Algebra.adjoin R {Ideal.Quotient.mk I X} = ⊤ := by
  rw [← Ideal.Quotient.mkₐ_eq_mk R, ← Set.image_singleton, ← AlgHom.map_adjoin, adjoin_X,
    Algebra.map_top, AlgHom.range_eq_top]
  exact Ideal.Quotient.mkₐ_surjective R I

variable [Nontrivial R]

/-- A finite free polynomial quotient has a unique monic defining equation, of degree equal
to its rank. No domain or Noetherian assumption on the coefficient ring is needed. -/
theorem existsUnique_monic_span_of_free_quotient (I : Ideal R[X])
    [Module.Finite R (R[X] ⧸ I)] [Module.Free R (R[X] ⧸ I)] :
    ∃! p : R[X], p.Monic ∧ p.natDegree = Module.finrank R (R[X] ⧸ I) ∧
      Ideal.span {p} = I := by
  let x := Ideal.Quotient.mk I (X : R[X])
  have he : aeval x = Ideal.Quotient.mkₐ R I := by
    ext
    simp [x]
  have hx : Algebra.adjoin R {x} = ⊤ := I.adjoin_quotient_mk_X_eq_top
  let h := IsAdjoinRootMonic.mkOfAdjoinEqTop' hx
  have hspan : Ideal.span {minpoly R x} = I := by
    rw [← h.ker_map]
    ext q
    rw [RingHom.mem_ker]
    simp only [h, IsAdjoinRootMonic.mkOfAdjoinEqTop'_map, he,
      Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
  refine ⟨minpoly R x, ⟨h.monic, h.finrank.symm, hspan⟩, ?_⟩
  rintro q ⟨hq, hdeg, hqI⟩
  apply eq_of_monic_of_dvd_of_natDegree_le h.monic hq
  · rw [← Ideal.mem_span_singleton, hspan, ← hqI]
    exact Ideal.subset_span (Set.mem_singleton q)
  · rw [hdeg, h.finrank]

/-- A finite flat polynomial quotient of constant rank `n`, that is, a finite locally free
quotient of rank `n`, has a unique monic defining equation, of degree `n`. -/
theorem existsUnique_monic_span_of_flat_quotient (I : Ideal R[X]) [Module.Finite R (R[X] ⧸ I)]
    [Module.Flat R (R[X] ⧸ I)] {n : ℕ}
    (hn : ∀ p : PrimeSpectrum R, Module.rankAtStalk (R[X] ⧸ I) p = n) :
    ∃! p : R[X], p.Monic ∧ p.natDegree = n ∧ Ideal.span {p} = I := by
  have := TauCeti.Module.free_of_adjoin_eq_top I.adjoin_quotient_mk_X_eq_top hn
  obtain ⟨P, hP⟩ := Ideal.exists_maximal R
  have hrank : Module.finrank R (R[X] ⧸ I) = n := by
    simpa using hn ⟨P, hP.isPrime⟩
  simpa only [hrank] using I.existsUnique_monic_span_of_free_quotient

end Ideal

namespace TauCeti.Polynomial

variable (R : Type*) [CommRing R] [Nontrivial R] (n : ℕ)

/-- Lower coefficients parameterize precisely the ideals with finite flat quotient of constant
rank `n`, equivalently with finite locally free quotient of rank `n`. The ideal of a tuple `c` is
generated by `X^n + ∑ i, c i * X^i`, and its quotient is even free. -/
noncomputable def coeffEquivFiniteFlatIdeal :
    (Fin n → R) ≃ {I : Ideal R[X] // Module.Finite R (R[X] ⧸ I) ∧
      Module.Flat R (R[X] ⧸ I) ∧ ∀ p : PrimeSpectrum R, Module.rankAtStalk (R[X] ⧸ I) p = n} := by
  apply Equiv.ofBijective (fun c ↦ ⟨Ideal.span {monicOfCoeff c},
    (monic_monicOfCoeff c).finite_adjoinRoot,
    have : Module.Free R (R[X] ⧸ Ideal.span {monicOfCoeff c}) :=
      (monic_monicOfCoeff c).free_adjoinRoot
    ⟨inferInstance, fun p ↦ by
      rw [Module.rankAtStalk_eq_finrank_of_free]
      exact (finrank_quotient_span_eq_natDegree' (monic_monicOfCoeff c)).trans
        (natDegree_monicOfCoeff c)⟩⟩)
  constructor
  · intro c d h
    have hI : Ideal.span {monicOfCoeff c} = Ideal.span {monicOfCoeff d} :=
      congrArg Subtype.val h
    have hp : monicOfCoeff d = monicOfCoeff c := by
      apply eq_of_monic_of_dvd_of_natDegree_le
        (monic_monicOfCoeff c) (monic_monicOfCoeff d)
      · rw [← Ideal.mem_span_singleton, hI]
        exact Ideal.subset_span (Set.mem_singleton _)
      · simp
    exact (monicOfCoeff_inj c d).mp hp.symm
  · rintro ⟨I, hfinite, hflat, hrank⟩
    let := hfinite
    let := hflat
    obtain ⟨p, ⟨hp, hdeg, hI⟩, -⟩ := I.existsUnique_monic_span_of_flat_quotient hrank
    refine ⟨fun i ↦ p.coeff i, Subtype.ext ?_⟩
    simpa only [monicOfCoeff_coeff hp hdeg] using hI

/-- The forward coefficient chart is the ideal generated by its monic polynomial. -/
@[simp]
lemma coeffEquivFiniteFlatIdeal_apply (c : Fin n → R) :
    (coeffEquivFiniteFlatIdeal R n c).1 = Ideal.span {monicOfCoeff c} :=
  (rfl)

/-- The inverse chart recovers the lower coefficients of any monic defining equation. -/
lemma coeffEquivFiniteFlatIdeal_symm_apply
    (I : {I : Ideal R[X] // Module.Finite R (R[X] ⧸ I) ∧
      Module.Flat R (R[X] ⧸ I) ∧ ∀ p : PrimeSpectrum R, Module.rankAtStalk (R[X] ⧸ I) p = n})
    {p : R[X]} (hp : p.Monic) (hdeg : p.natDegree = n) (hI : Ideal.span {p} = I.1) :
    (coeffEquivFiniteFlatIdeal R n).symm I = fun i : Fin n ↦ p.coeff i := by
  apply (coeffEquivFiniteFlatIdeal R n).injective
  apply Subtype.ext
  simp only [Equiv.apply_symm_apply, coeffEquivFiniteFlatIdeal_apply,
    monicOfCoeff_coeff hp hdeg, hI]

/-- Extension along a homomorphism between nontrivial commutative rings acts coordinatewise
on the ideal chart. -/
-- The left-hand side already simplifies via `coeffEquivFiniteFlatIdeal_apply`, so a simp
-- attribute here would fail `simpNF`.
lemma map_coeffEquivFiniteFlatIdeal {S : Type*} [CommRing S] [Nontrivial S]
    (φ : R →+* S) (c : Fin n → R) :
    ((coeffEquivFiniteFlatIdeal R n c).1).map (Polynomial.mapRingHom φ) =
      (coeffEquivFiniteFlatIdeal S n (fun i ↦ φ (c i))).1 := by
  simp [Ideal.map_span, Set.image_singleton]

end TauCeti.Polynomial
