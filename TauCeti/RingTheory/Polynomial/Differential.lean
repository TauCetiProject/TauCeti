module

public import Mathlib.RingTheory.Adjoin.Polynomial.Basic
public import Mathlib.RingTheory.Kaehler.Polynomial
public import Mathlib.RingTheory.Unramified.Locus

/-!
# Differentials over a singly generated polynomial subalgebra

For any commutative ring `R` and `f : R[X]`, the relative cotangent module of
`R[X]` over `R[f]` is `R[X] / (derivative f)`. We allow a subalgebra `S` together
with an equality `Algebra.adjoin R {f} = S`, so the presentation also applies to
subalgebras originally defined by invariant equations, without transporting their
cotangent modules. Taking `S = Algebra.adjoin R {f}` and the equality `rfl` gives
the usual presentation. Its annihilator and unramified locus retain the full
derivative ideal, including over coefficient rings of positive characteristic.

The construction uses Mathlib's `KaehlerDifferential.polynomial_D_apply`,
`Derivation.liftKaehlerDifferential`, and the polynomial chain rule.
-/

public section

noncomputable section

open Polynomial

/-- The polynomial differential formula remains valid after enlarging the base ring
in a scalar tower. -/
theorem KaehlerDifferential.polynomial_D_apply_of_tower
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Algebra S R[X]] [IsScalarTower R S R[X]] (p : R[X]) :
    KaehlerDifferential.D S R[X] p =
      Polynomial.derivative p • KaehlerDifferential.D S R[X] Polynomial.X := by
  simpa using congrArg (KaehlerDifferential.map R S R[X] R[X])
    (KaehlerDifferential.polynomial_D_apply R p)

namespace Polynomial

variable {R : Type*} [CommRing R] {S : Subalgebra R R[X]} (f : R[X])
    (hS : Algebra.adjoin R {f} = S)

include hS

private theorem differential_relation :
    derivative f • KaehlerDifferential.D S R[X] X = 0 := by
  let a : S := ⟨f, hS ▸ Algebra.subset_adjoin (Set.mem_singleton f)⟩
  have h := (KaehlerDifferential.D S R[X]).map_algebraMap a
  rw [Subalgebra.algebraMap_apply, KaehlerDifferential.polynomial_D_apply_of_tower] at h
  exact h

private def quotientDerivative :
    Derivation S R[X] (R[X] ⧸ Ideal.span {derivative f}) := by
  let I : Ideal R[X] := Ideal.span {derivative f}
  let D : Derivation R R[X] (R[X] ⧸ I) := I.mkQ.compDer derivative'
  have hzero (a : S) : D a = 0 := by
    have ha : (a : R[X]) ∈ Algebra.adjoin R {f} := by
      simpa only [hS] using a.property
    rw [Algebra.adjoin_singleton_eq_range_aeval] at ha
    obtain ⟨q, hq⟩ := ha
    -- The range witness uses a ring-hom coercion; expose algebra evaluation for the chain rule.
    change aeval f q = (a : R[X]) at hq
    have hmem : derivative (a : R[X]) ∈ I := by
      rw [← hq, ← comp_eq_aeval, derivative_comp]
      exact I.mul_mem_right _ (Ideal.subset_span rfl)
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem
  exact
    { toFun := D
      map_add' := D.map_add
      map_smul' := fun a p ↦ by
        simp only [Algebra.smul_def, D.leibniz, Subalgebra.algebraMap_apply,
          RingHom.id_apply, hzero, smul_zero, add_zero]
        exact (IsScalarTower.algebraMap_smul R[X] a (D p)).symm
      map_one_eq_zero' := D.map_one_eq_zero
      leibniz' := D.leibniz }

private theorem quotientDerivative_apply (p : R[X]) :
    quotientDerivative f hS p = Ideal.Quotient.mk (Ideal.span {derivative f}) (derivative p) :=
  rfl

private def differentialFromQuotient :
    (R[X] ⧸ Ideal.span {derivative f}) →ₗ[R[X]] Ω[R[X]⁄S] :=
  Submodule.liftQSpanSingleton (derivative f)
    (LinearMap.toSpanSingleton R[X] _ (KaehlerDifferential.D S R[X] X))
    (differential_relation f hS)

private theorem differentialFromQuotient_mk (p : R[X]) :
    differentialFromQuotient f hS (Ideal.Quotient.mk (Ideal.span {derivative f}) p) =
      p • KaehlerDifferential.D S R[X] X := by
  exact Submodule.liftQSpanSingleton_apply _ _ _ p

/-- The relative cotangent module over a subalgebra generated by `f` is the quotient
by `derivative f`. The class of `1` corresponds to `dX`. -/
def kaehlerDifferentialEquivOfAdjoinEq :
    Ω[R[X]⁄S] ≃ₗ[R[X]] R[X] ⧸ Ideal.span {derivative f} := by
  let F := (quotientDerivative f hS).liftKaehlerDifferential
  let H := differentialFromQuotient f hS
  refine LinearEquiv.ofLinearMap F H ?_ ?_
  · apply LinearMap.ext
    intro p
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective p
    simp only [LinearMap.comp_apply, LinearMap.id_apply, F, H,
      differentialFromQuotient_mk, map_smul,
      Derivation.liftKaehlerDifferential_comp_D, quotientDerivative_apply,
      derivative_X, map_one]
    exact (Algebra.algebraMap_eq_smul_one p).symm
  · apply Derivation.liftKaehlerDifferential_unique
    ext p
    simp only [Derivation.coe_comp, Derivation.coeFn_coe, LinearMap.restrictScalars_apply,
      LinearMap.comp_apply, LinearMap.id_apply, F,
      Derivation.liftKaehlerDifferential_comp_D, quotientDerivative_apply, H,
      differentialFromQuotient_mk]
    exact (KaehlerDifferential.polynomial_D_apply_of_tower p).symm

/-- The cotangent presentation sends a universal differential to the derivative class. -/
@[simp]
theorem kaehlerDifferentialEquivOfAdjoinEq_D (p : R[X]) :
    kaehlerDifferentialEquivOfAdjoinEq f hS (KaehlerDifferential.D S R[X] p) =
      Ideal.Quotient.mk (Ideal.span {derivative f}) (derivative p) :=
  (quotientDerivative f hS).liftKaehlerDifferential_comp_D p

/-- The inverse presentation sends a polynomial class to its multiple of `dX`. -/
@[simp]
theorem kaehlerDifferentialEquivOfAdjoinEq_symm_mk (p : R[X]) :
    (kaehlerDifferentialEquivOfAdjoinEq f hS).symm
        (Ideal.Quotient.mk (Ideal.span {derivative f}) p) =
      p • KaehlerDifferential.D S R[X] X := by
  -- The inverse of ofLinearMap is its supplied inverse map; no computation lemma is provided.
  change differentialFromQuotient f hS _ = _
  exact differentialFromQuotient_mk f hS p

/-- The annihilator of the relative differentials over `R[f]` is exactly `(f')`. -/
theorem annihilator_kaehlerDifferential_of_adjoin_eq :
    Module.annihilator R[X] Ω[R[X]⁄S] = Ideal.span {derivative f} := by
  rw [(kaehlerDifferentialEquivOfAdjoinEq f hS).annihilator_eq,
    Ideal.annihilator_quotient]

/-- The map from `R[f]` to `R[X]` is unramified precisely where `f'` is invertible. -/
theorem unramifiedLocus_of_adjoin_eq :
    Algebra.unramifiedLocus S R[X] =
      (PrimeSpectrum.basicOpen (derivative f) : Set (PrimeSpectrum R[X])) := by
  rw [Algebra.unramifiedLocus_eq_compl_support,
    (kaehlerDifferentialEquivOfAdjoinEq f hS).support_eq, Module.support_eq_zeroLocus,
    Ideal.annihilator_quotient, PrimeSpectrum.zeroLocus_span,
    PrimeSpectrum.basicOpen_eq_zeroLocus_compl]

end Polynomial
