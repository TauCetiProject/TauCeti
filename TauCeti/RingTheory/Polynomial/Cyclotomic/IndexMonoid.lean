/-!
# The monoid of cyclotomic products

For a ring `R` and a set `S` of orders, `TauCeti.cycloIndex R S` is the submonoid of `R[X]`
generated by the cyclotomic polynomials `cyclotomic n R` with `n ∈ S`. It is the indexing system
of the cyclotomic completion `R[q]^S = lim R[q]/(f)`, `f ∈ cycloIndex R S`, of Habiro: the
transition maps of that completion run along divisibility of indices.

The index set consists of actual polynomials, not of exponent vectors: two products that are equal
as polynomials are the same index. This matters in positive characteristic, where distinct orders
can give the same cyclotomic polynomial; in characteristic two, `cyclotomic 1 = cyclotomic 2`, so
the systems for `{1}` and `{2}` coincide. Order zero contributes nothing, since
`cyclotomic 0 R = 1`.

Ordered by divisibility the index set is directed (the product of two indices is a common
multiple) and has the countable cofinal chain `TauCeti.cycloChain R S N`, the product of
`cyclotomic n R ^ N` over the orders `1 ≤ n ≤ N` in `S`. For a finite set `s` of orders the powers
of `∏ n ∈ s, cyclotomic n R` are already cofinal.

## Main definitions

* `TauCeti.cycloIndex R S`: the submonoid of `R[X]` generated by `cyclotomic n R`, `n ∈ S`.
* `TauCeti.cycloChain R S N`: the product of `cyclotomic n R ^ N` over `n ∈ S` with `1 ≤ n ≤ N`,
  and `TauCeti.cycloChainIndex R S N`, the same polynomial as an element of `cycloIndex R S`.
* `TauCeti.cycloProd R hS`: for finite `S`, the product `∏ n ∈ S, cyclotomic n R`, whose powers
  are cofinal in `cycloIndex R S`.

## Main results

* `TauCeti.cycloIndex_le_iff`: the universal property of the generated submonoid.
* `TauCeti.mem_cycloIndex_iff`: the indices are the finite products of cyclotomic powers of
  orders in `S`.
* `TauCeti.monic_of_mem_cycloIndex`: every index is monic.
* `TauCeti.cycloIndex_monotone`, `TauCeti.map_cycloIndex`: monotonicity in `S` and transport along a
  coefficient ring homomorphism.
* `TauCeti.exists_dvd_cycloChain`: every index divides some member of the cofinal chain.
* `TauCeti.exists_dvd_prod_cyclotomic_pow`, `TauCeti.exists_dvd_cycloProd_pow`: for finite `s`,
  every index divides a power of `∏ n ∈ s, cyclotomic n R`.
* `TauCeti.cycloIndex.directed_dvd`, `TauCeti.directed_dvd_cycloProd_pow`: the indices, and for
  finite `S` the powers of `cycloProd R hS`, are directed for divisibility.
* `TauCeti.cycloIndex_eq_bot_iff_subsingleton_or`: over any commutative ring the index monoid is
  trivial exactly when `R` is the zero ring or every order in `S` is zero.

## References

* K. Habiro, *Cyclotomic completions of polynomial rings*, Publ. RIMS Kyoto Univ. 40 (2004),
  §3.1.
-/

public section

open Polynomial

namespace TauCeti

section Ring

variable (R : Type*) [Ring R] {R' : Type*} [Ring R'] {S T : Set ℕ} {n : ℕ} {f : R[X]}

/-- The submonoid of `R[X]` generated by the cyclotomic polynomials `cyclotomic n R`, `n ∈ S`.
It indexes the cyclotomic completion `R[q]^S`. Its elements are polynomials, so two products of
cyclotomic polynomials that agree as polynomials are the same index. -/
noncomputable def cycloIndex (S : Set ℕ) : Submonoid R[X] :=
  Submonoid.closure ((fun n ↦ cyclotomic n R) '' S)

theorem cycloIndex_def (S : Set ℕ) :
    cycloIndex R S = Submonoid.closure ((fun n ↦ cyclotomic n R) '' S) := by
  rw [cycloIndex]

variable {R}

theorem cyclotomic_mem_cycloIndex (hn : n ∈ S) : cyclotomic n R ∈ cycloIndex R S :=
  Submonoid.subset_closure ⟨n, hn, rfl⟩

theorem cyclotomic_pow_mem_cycloIndex (hn : n ∈ S) (k : ℕ) :
    cyclotomic n R ^ k ∈ cycloIndex R S :=
  pow_mem (cyclotomic_mem_cycloIndex hn) k

/-- A submonoid contains `cycloIndex R S` exactly when it contains every generator. -/
theorem cycloIndex_le_iff {M : Submonoid R[X]} :
    cycloIndex R S ≤ M ↔ ∀ n ∈ S, cyclotomic n R ∈ M := by
  simp [cycloIndex_def, Submonoid.closure_le, Set.subset_def]

/-- Induction on an index: a property of polynomials holding for `1` and for every generator, and
closed under multiplication, holds for every index. -/
@[elab_as_elim]
theorem cycloIndex_induction {motive : (f : R[X]) → f ∈ cycloIndex R S → Prop}
    (one : motive 1 (one_mem _))
    (gen : ∀ n (hn : n ∈ S), motive (cyclotomic n R) (cyclotomic_mem_cycloIndex hn))
    (mul : ∀ f g hf hg, motive f hf → motive g hg → motive (f * g) (mul_mem hf hg))
    (hf : f ∈ cycloIndex R S) : motive f hf := by
  have key (x : R[X]) (hx : x ∈ Submonoid.closure ((fun n ↦ cyclotomic n R) '' S)) :
      motive x (cycloIndex_def R S ▸ hx) := by
    induction hx using Submonoid.closure_induction with
    | mem x hx =>
      obtain ⟨n, hn, rfl⟩ := hx
      exact gen n hn
    | one => exact one
    | mul x y _ _ ihx ihy => exact mul x y _ _ ihx ihy
  exact key f (cycloIndex_def R S ▸ hf)

/-- Every cyclotomic index is monic. -/
theorem monic_of_mem_cycloIndex (hf : f ∈ cycloIndex R S) : f.Monic := by
  induction hf using cycloIndex_induction with
  | one => exact monic_one
  | gen n _ => exact cyclotomic.monic n R
  | mul f g _ _ hf hg => exact hf.mul hg

theorem cycloIndex_monotone : Monotone (cycloIndex R) :=
  fun _ _ hST ↦ Submonoid.closure_mono (Set.image_mono hST)

/-- If every order in `S` is zero, the only index is `1`, as `cyclotomic 0 R = 1`. -/
theorem cycloIndex_eq_bot_of_subset_zero (hS : S ⊆ {0}) : cycloIndex R S = ⊥ :=
  le_bot_iff.mp <| cycloIndex_le_iff.mpr fun n hn ↦ by
    rw [hS hn, cyclotomic_zero]
    exact one_mem _

/-- With no orders the only index is the polynomial `1`. -/
@[simp]
theorem cycloIndex_empty : cycloIndex R ∅ = ⊥ :=
  cycloIndex_eq_bot_of_subset_zero (Set.empty_subset _)

/-- Over a nonzero ring, the index monoid is trivial exactly when every order in `S` is zero. -/
theorem cycloIndex_eq_bot_iff [Nontrivial R] : cycloIndex R S = ⊥ ↔ S ⊆ {0} := by
  refine ⟨fun h n hn ↦ ?_, cycloIndex_eq_bot_of_subset_zero⟩
  have hmem : cyclotomic n R ∈ (⊥ : Submonoid R[X]) := h ▸ cyclotomic_mem_cycloIndex hn
  by_contra h0
  exact cyclotomic_ne_one (Nat.pos_of_ne_zero h0) (Submonoid.mem_bot.mp hmem)

/-- Changing coefficients along a ring homomorphism carries the index monoid over `R` onto the index
monoid over `R'`. -/
@[simp]
theorem map_cycloIndex (φ : R →+* R') (S : Set ℕ) :
    (cycloIndex R S).map (mapRingHom φ) = cycloIndex R' S := by
  rw [cycloIndex_def, cycloIndex_def, MonoidHom.map_mclosure, ← Set.image_comp]
  congr 2
  ext n
  simp [map_cyclotomic]

theorem map_mem_cycloIndex (φ : R →+* R') (hf : f ∈ cycloIndex R S) :
    f.map φ ∈ cycloIndex R' S :=
  map_cycloIndex φ S ▸ Submonoid.mem_map_of_mem (mapRingHom φ) hf

end Ring

section CommRing

variable {R : Type*} [CommRing R] {S : Set ℕ} {f : R[X]}

/-- The indices are the finite products `∏ cyclotomic n R ^ e n` over exponent vectors `e`
supported in `S`. -/
theorem mem_cycloIndex_iff :
    f ∈ cycloIndex R S ↔
      ∃ e : ℕ →₀ ℕ, ↑e.support ⊆ S ∧ f = e.prod fun n k ↦ cyclotomic n R ^ k := by
  classical
  refine ⟨fun hf ↦ ?_, ?_⟩
  · rw [cycloIndex_def, Set.image_eq_range] at hf
    obtain ⟨a, rfl⟩ := Submonoid.exists_finsupp_of_mem_closure_range _ _ hf
    refine ⟨a.mapDomain Subtype.val, fun n hn ↦ ?_, ?_⟩
    · obtain ⟨m, -, rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hn)
      exact m.property
    · exact (Finsupp.prod_mapDomain_index (h := fun n k ↦ cyclotomic n R ^ k) (fun _ ↦ pow_zero _)
        fun _ _ _ ↦ pow_add _ _ _).symm
  · rintro ⟨e, he, rfl⟩
    exact Submonoid.prod_mem _ fun n hn ↦ cyclotomic_pow_mem_cycloIndex (he hn) _

variable (R) in
/-- The `N`-th member `∏_{n ∈ S, 1 ≤ n ≤ N} cyclotomic n R ^ N` of the countable cofinal chain of
cyclotomic indices. -/
noncomputable def cycloChain (S : Set ℕ) (N : ℕ) : R[X] :=
  open scoped Classical in ∏ n ∈ Finset.Icc 1 N with n ∈ S, cyclotomic n R ^ N

theorem cycloChain_def (S : Set ℕ) [DecidablePred (· ∈ S)] (N : ℕ) :
    cycloChain R S N = ∏ n ∈ Finset.Icc 1 N with n ∈ S, cyclotomic n R ^ N := by
  rw [cycloChain]
  congr 1
  exact Finset.filter_congr_decidable _ _ _

theorem cycloChain_mem_cycloIndex (S : Set ℕ) (N : ℕ) : cycloChain R S N ∈ cycloIndex R S := by
  classical
  rw [cycloChain_def]
  exact Submonoid.prod_mem _ fun n hn ↦
    cyclotomic_pow_mem_cycloIndex (Finset.mem_filter.mp hn).2 N

@[simp]
theorem cycloChain_zero (S : Set ℕ) : cycloChain R S 0 = 1 := by
  classical
  simp [cycloChain_def]

/-- `cyclotomic n R ^ k` divides the `N`-th member of the chain once `n ∈ S` and
`1 ≤ n ≤ N`, `k ≤ N`. -/
theorem cyclotomic_pow_dvd_cycloChain {n k N : ℕ} (hn : n ∈ S) (h1 : 1 ≤ n) (hnN : n ≤ N)
    (hk : k ≤ N) : cyclotomic n R ^ k ∣ cycloChain R S N := by
  classical
  rw [cycloChain_def]
  exact (pow_dvd_pow _ hk).trans
    (Finset.dvd_prod_of_mem _ (Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨h1, hnN⟩, hn⟩))

/-- The product of two members of the chain divides the member indexed by the sum. -/
theorem cycloChain_mul_dvd (S : Set ℕ) (M N : ℕ) :
    cycloChain R S M * cycloChain R S N ∣ cycloChain R S (M + N) := by
  classical
  simp only [cycloChain_def, pow_add, Finset.prod_mul_distrib]
  refine mul_dvd_mul ?_ ?_ <;> refine Finset.prod_dvd_prod_of_subset _ _ _ ?_ <;>
    exact Finset.filter_subset_filter _ (Finset.Icc_subset_Icc_right (by omega))

/-- The chain is increasing for divisibility. -/
theorem cycloChain_dvd_cycloChain (S : Set ℕ) {M N : ℕ} (h : M ≤ N) :
    cycloChain R S M ∣ cycloChain R S N := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  exact (dvd_mul_right _ _).trans (cycloChain_mul_dvd S M k)

/-- The chain is cofinal: every cyclotomic index divides one of its members. -/
theorem exists_dvd_cycloChain (hf : f ∈ cycloIndex R S) : ∃ N, f ∣ cycloChain R S N := by
  induction hf using cycloIndex_induction with
  | one => exact ⟨0, one_dvd _⟩
  | gen n hn =>
    rcases Nat.eq_zero_or_pos n with rfl | hpos
    · exact ⟨0, by simp⟩
    · exact ⟨n, by simpa using cyclotomic_pow_dvd_cycloChain hn hpos le_rfl hpos⟩
  | mul f g _ _ hf hg =>
    obtain ⟨M, hM⟩ := hf
    obtain ⟨N, hN⟩ := hg
    exact ⟨M + N, (mul_dvd_mul hM hN).trans (cycloChain_mul_dvd S M N)⟩

/-- For a finite set `s` of orders, every index divides a power of `∏ n ∈ s, cyclotomic n R`. -/
theorem exists_dvd_prod_cyclotomic_pow {s : Finset ℕ} (hf : f ∈ cycloIndex R s) :
    ∃ k, f ∣ (∏ n ∈ s, cyclotomic n R) ^ k := by
  induction hf using cycloIndex_induction with
  | one => exact ⟨0, by simp⟩
  | gen n hn => exact ⟨1, by simpa using Finset.dvd_prod_of_mem _ hn⟩
  | mul f g _ _ hf hg =>
    obtain ⟨k, hk⟩ := hf
    obtain ⟨l, hl⟩ := hg
    exact ⟨k + l, pow_add (∏ n ∈ s, cyclotomic n R) k l ▸ mul_dvd_mul hk hl⟩

end CommRing

section Supplements

variable {R R' : Type*} [CommRing R] [CommRing R'] {S T : Set ℕ}

/-- Finite products of powers of cyclotomic polynomials with orders in `S` belong to
`cycloIndex R S`. -/
theorem prod_cyclotomic_pow_mem_cycloIndex {ι : Type*} (s : Finset ι) (n : ι → ℕ) (e : ι → ℕ)
    (hn : ∀ i ∈ s, n i ∈ S) : (∏ i ∈ s, cyclotomic (n i) R ^ e i) ∈ cycloIndex R S :=
  prod_mem fun i hi ↦ cyclotomic_pow_mem_cycloIndex (hn i hi) (e i)

/-- Every index in `cycloIndex R S` is monic as a polynomial in `R[X]`. -/
theorem cycloIndex.monic (f : cycloIndex R S) : (f : R[X]).Monic :=
  monic_of_mem_cycloIndex f.property

/-- Every polynomial in `cycloIndex R S` is a regular element of `R[X]`. -/
theorem isRegular_of_mem_cycloIndex {f : R[X]} (hf : f ∈ cycloIndex R S) : IsRegular f :=
  (monic_of_mem_cycloIndex hf).isRegular

/-- `cycloIndex_monotone` in the form used by `gcongr`. -/
@[gcongr]
theorem cycloIndex_mono (hTS : T ⊆ S) : cycloIndex R T ≤ cycloIndex R S :=
  cycloIndex_monotone hTS

/-- Adjoining order `0` does not change `cycloIndex R S`, since `cyclotomic 0 R = 1`. -/
@[simp]
theorem cycloIndex_insert_zero (S : Set ℕ) : cycloIndex R (insert 0 S) = cycloIndex R S := by
  refine le_antisymm (cycloIndex_le_iff.mpr ?_) (cycloIndex_mono (Set.subset_insert 0 S))
  rintro n (rfl | hn)
  · simp [cyclotomic_zero]
  · exact cyclotomic_mem_cycloIndex hn

/-- Removing order `0` does not change `cycloIndex R S`, since `cyclotomic 0 R = 1`. -/
@[simp]
theorem cycloIndex_sdiff_singleton_zero (S : Set ℕ) :
    cycloIndex R (S \ {0}) = cycloIndex R S := by
  refine le_antisymm (cycloIndex_mono Set.sdiff_subset) (cycloIndex_le_iff.mpr fun n hn ↦ ?_)
  rcases eq_or_ne n 0 with rfl | hn0
  · simp [cyclotomic_zero]
  · exact cyclotomic_mem_cycloIndex ⟨hn, hn0⟩

@[simp]
theorem cycloIndex_singleton_zero : cycloIndex R {0} = ⊥ :=
  cycloIndex_eq_bot_of_subset_zero subset_rfl

/-- Over an arbitrary commutative ring, `cycloIndex R S` is trivial if and only if `R` is
subsingleton or `S` contains no positive orders. -/
theorem cycloIndex_eq_bot_iff_subsingleton_or :
    cycloIndex R S = ⊥ ↔ Subsingleton R ∨ S ⊆ {0} := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · rcases subsingleton_or_nontrivial R with hR | hR
    · exact Or.inl hR
    · exact Or.inr (cycloIndex_eq_bot_iff.mp h)
  · rintro (hR | hS)
    · exact Subsingleton.elim _ _
    · exact cycloIndex_eq_bot_of_subset_zero hS

/-- In characteristic two, `cyclotomic 1 R = cyclotomic 2 R`, so `{1}` and `{2}` generate the same
cyclotomic index monoid. -/
theorem cycloIndex_singleton_one_eq_singleton_two [CharP R 2] :
    cycloIndex R {1} = cycloIndex R {2} := by
  simp only [cycloIndex_def, Set.image_singleton, cyclotomic_one, cyclotomic_two,
    CharTwo.sub_eq_add]

/-- Every index in `cycloIndex R' S` is the base change of an index in `cycloIndex R S`. -/
theorem exists_map_eq_of_mem_cycloIndex (φ : R →+* R') {f' : R'[X]}
    (hf' : f' ∈ cycloIndex R' S) : ∃ f : cycloIndex R S, (f : R[X]).map φ = f' := by
  rw [← map_cycloIndex φ S, Submonoid.mem_map] at hf'
  rcases hf' with ⟨f, hf, rfl⟩
  exact ⟨⟨f, hf⟩, rfl⟩

/-- The members of `cycloIndex R S` form a directed family for divisibility: any two indices
divide a common index, namely their product. -/
theorem cycloIndex.directed_dvd : Directed (· ∣ ·) (fun f : cycloIndex R S ↦ (f : R[X])) :=
  fun f g ↦ ⟨f * g, dvd_mul_right (f : R[X]) g, dvd_mul_left (g : R[X]) f⟩

variable (R) in
/-- `cycloChain R S N` bundled as an element of `cycloIndex R S`. -/
noncomputable def cycloChainIndex (S : Set ℕ) (N : ℕ) : cycloIndex R S :=
  ⟨cycloChain R S N, cycloChain_mem_cycloIndex S N⟩

@[simp]
theorem coe_cycloChainIndex (S : Set ℕ) (N : ℕ) :
    (cycloChainIndex R S N : R[X]) = cycloChain R S N :=
  (rfl)

@[simp]
theorem cycloChainIndex_zero (S : Set ℕ) : cycloChainIndex R S 0 = 1 :=
  Subtype.ext (cycloChain_zero S)

/-- `cycloChain` commutes with coefficient ring homomorphisms. -/
@[simp]
theorem map_cycloChain (φ : R →+* R') (S : Set ℕ) (N : ℕ) :
    (cycloChain R S N).map φ = cycloChain R' S N := by
  classical
  simp [cycloChain_def, Polynomial.map_prod, Polynomial.map_cyclotomic]

/-- Enlarging the order set `S` produces a multiple in `cycloChain` at every level `N`. -/
theorem cycloChain_dvd_of_subset (hTS : T ⊆ S) (N : ℕ) :
    cycloChain R T N ∣ cycloChain R S N := by
  classical
  rw [cycloChain_def, cycloChain_def]
  exact Finset.prod_dvd_prod_of_subset _ _ _ fun n hn ↦ by
    rw [Finset.mem_filter] at hn ⊢
    exact ⟨hn.1, hTS hn.2⟩

variable (R) in
/-- For a finite order set `S`, the product `∏_{n ∈ S} cyclotomic n R`. -/
noncomputable def cycloProd (hS : S.Finite) : R[X] :=
  ∏ n ∈ hS.toFinset, cyclotomic n R

variable (R) in
theorem cycloProd_def (hS : S.Finite) : cycloProd R hS = ∏ n ∈ hS.toFinset, cyclotomic n R :=
  (rfl)

@[simp]
theorem cycloProd_empty (hS : (∅ : Set ℕ).Finite) : cycloProd R hS = 1 := by
  simp [cycloProd_def]

@[simp]
theorem cycloProd_singleton {n : ℕ} (hS : ({n} : Set ℕ).Finite) :
    cycloProd R hS = cyclotomic n R := by
  simp [cycloProd_def]

/-- `cycloProd` commutes with coefficient ring homomorphisms. -/
@[simp]
theorem map_cycloProd (φ : R →+* R') (hS : S.Finite) :
    (cycloProd R hS).map φ = cycloProd R' hS := by
  simp [cycloProd_def, Polynomial.map_prod, Polynomial.map_cyclotomic]

/-- Every generator `cyclotomic n R` with `n ∈ S` divides `cycloProd R hS`. -/
theorem cyclotomic_dvd_cycloProd (hS : S.Finite) {n : ℕ} (hn : n ∈ S) :
    cyclotomic n R ∣ cycloProd R hS :=
  Finset.dvd_prod_of_mem _ (hS.mem_toFinset.mpr hn)

variable (R) in
/-- `cycloProd R hS` belongs to `cycloIndex R S`. -/
theorem cycloProd_mem_cycloIndex (hS : S.Finite) : cycloProd R hS ∈ cycloIndex R S :=
  prod_mem fun _ hn ↦ cyclotomic_mem_cycloIndex (hS.mem_toFinset.mp hn)

/-- When `S` is finite, the powers of `cycloProd R hS` are cofinal in `cycloIndex R S`. -/
theorem exists_dvd_cycloProd_pow (hS : S.Finite) {f : R[X]} (hf : f ∈ cycloIndex R S) :
    ∃ k : ℕ, f ∣ cycloProd R hS ^ k := by
  rw [← hS.coe_toFinset] at hf
  exact exists_dvd_prod_cyclotomic_pow hf

variable (R) in
/-- The powers of `cycloProd R hS` form a directed family for divisibility. -/
theorem directed_dvd_cycloProd_pow (hS : S.Finite) :
    Directed (· ∣ ·) (fun k : ℕ ↦ cycloProd R hS ^ k) := fun k l ↦
  ⟨max k l, pow_dvd_pow _ (le_max_left k l), pow_dvd_pow _ (le_max_right k l)⟩

end Supplements

/-! ### Examples -/

/-- In characteristic two the order-one and order-two generators coincide, so the index monoids for
`{1}` and `{2}` are equal. -/
example : cycloIndex (ZMod 2) {1} = cycloIndex (ZMod 2) {2} := by
  have h : cyclotomic 1 (ZMod 2) = cyclotomic 2 (ZMod 2) := by
    rw [cyclotomic_one, cyclotomic_two, CharTwo.sub_eq_add]
  simp [cycloIndex_def, h]

/-- Coefficient transport sends each integral generator to the corresponding rational one. -/
example (n : ℕ) (hn : n ∈ ({1, 2} : Set ℕ)) :
    (cyclotomic n ℤ).map (Int.castRingHom ℚ) ∈ cycloIndex ℚ {1, 2} := by
  rw [map_cyclotomic_int]
  exact cyclotomic_mem_cycloIndex hn

end TauCeti
