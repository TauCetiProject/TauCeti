/-!
# Factorial polynomials and their cyclotomic factorization

For a commutative ring `R` and `N : ℕ`, the factorial polynomial

`P_N = ∏_{i=1}^N (1 - X ^ i) ∈ R[X]`, with `P_0 = 1`,

is the specialization `(q; q)_N` of the finite multiplicative Pochhammer symbol. Its ideals
`(P_N)` form a cofinal chain among the ideals generated by products of cyclotomic polynomials,
which makes the factorial polynomials the natural precision parameter for Habiro's cyclotomic
completion `lim_N R[q] / (P_N)` and the normalizing basis of its factorial expansions
`∑ a_n(q) P_n(q)`.

The key identity is the signed cyclotomic factorization

`(-1) ^ N P_N = ∏_{d=1}^N Φ_d ^ ⌊N / d⌋`,

obtained by multiplying the factorizations `X ^ i - 1 = ∏_{d ∣ i} Φ_d` for `1 ≤ i ≤ N`; the
exponent `⌊N / d⌋` counts the multiples of `d` in `[1, N]`. It holds over every commutative
ring, including the zero ring and rings of positive characteristic. The sign is the one that makes
`(-1) ^ N P_N` monic, as needed for monic division.

## Main results

* `TauCeti.factorialPoly`: the factorial polynomial `P_N`, with `factorialPoly_succ`
  (`P_{N+1} = P_N (1 - X ^ (N + 1))`), `map_factorialPoly`, `coeff_zero_factorialPoly`,
  and `factorialPoly_dvd_factorialPoly` (`P_M ∣ P_N` for `M ≤ N`).
* `TauCeti.neg_one_pow_mul_factorialPoly`: `(-1) ^ N P_N = ∏_{d=1}^N Φ_d ^ ⌊N / d⌋`.
* `TauCeti.monic_neg_one_pow_mul_factorialPoly`, `TauCeti.leadingCoeff_factorialPoly`,
  `TauCeti.natDegree_factorialPoly`: `(-1) ^ N P_N` is monic, `P_N` has leading coefficient
  `(-1) ^ N`, and over a nontrivial ring `P_N` has degree `N (N + 1) / 2`.
* `TauCeti.cyclotomic_pow_dvd_factorialPoly`: `Φ_d ^ ⌊N / d⌋ ∣ P_N`.
* `TauCeti.prod_cyclotomic_pow_dvd_factorialPoly`: `∏_{d ∈ s} Φ_d ^ e_d ∣ P_N` as soon as
  `d e_d ≤ N` for every `d ∈ s`.
* `TauCeti.exists_dvd_factorialPoly`: every element of the multiplicative monoid generated by
  the cyclotomic polynomials divides some `P_N`; conversely
  `TauCeti.neg_one_pow_mul_factorialPoly_mem_closure` puts the monic associate of each `P_N` in
  that monoid. Thus the ideals `(P_N)` are cofinal among the cyclotomic ideals.
* `TauCeti.X_pow_sub_one_pow_dvd_factorialPoly`: `(X ^ m - 1) ^ k ∣ P_N` for `0 < m` and
  `m k ≤ N`.
* `TauCeti.cyclotomic_pow_dvd_factorialPoly_iff`: in characteristic zero the multiplicities are
  sharp, `Φ_d ^ k ∣ P_N ↔ k ≤ ⌊N / d⌋` for `0 < d`. This fails in positive
  characteristic: over `ZMod 2`, `Φ_1 = Φ_2` and `Φ_1 ^ 3 ∣ P_2`.

## References

* K. Habiro, *Cyclotomic completions of polynomial rings*, Publ. Res. Inst. Math. Sci. 40
  (2004), §1 and Proposition 7.1.
-/

public section

open Polynomial

namespace TauCeti

variable (R : Type*) [CommRing R]

/-- The factorial polynomial `P_N = ∏_{i=1}^N (1 - X ^ i)`, with `P_0 = 1`. It is the
specialization `(q; q)_N` of the multiplicative Pochhammer symbol. -/
noncomputable def factorialPoly (N : ℕ) : R[X] :=
  ∏ i ∈ Finset.range N, (1 - X ^ (i + 1))

/-- The defining product of `P_N`. -/
theorem factorialPoly_eq_prod (N : ℕ) :
    factorialPoly R N = ∏ i ∈ Finset.range N, (1 - X ^ (i + 1)) := (rfl)

/-- `P_0 = 1`. -/
@[simp]
theorem factorialPoly_zero : factorialPoly R 0 = 1 := by
  simp [factorialPoly_eq_prod]

/-- The recursion `P_{N+1} = P_N (1 - X ^ (N + 1))`. -/
theorem factorialPoly_succ (N : ℕ) :
    factorialPoly R (N + 1) = factorialPoly R N * (1 - X ^ (N + 1)) := by
  simp [factorialPoly_eq_prod, Finset.prod_range_succ]

/-- `P_1 = 1 - X`. -/
@[simp]
theorem factorialPoly_one : factorialPoly R 1 = 1 - X := by
  simp [factorialPoly_succ]

variable {R} in
/-- Factorial polynomials commute with coefficient ring homomorphisms. -/
@[simp]
theorem map_factorialPoly {S : Type*} [CommRing S] (f : R →+* S) (N : ℕ) :
    (factorialPoly R N).map f = factorialPoly S N := by
  simp [factorialPoly_eq_prod, Polynomial.map_prod]

/-- `P_N(0) = 1`. -/
@[simp]
theorem eval_zero_factorialPoly (N : ℕ) : (factorialPoly R N).eval 0 = 1 := by
  simp [factorialPoly_eq_prod, eval_prod]

/-- The constant coefficient of `P_N` is `1`. -/
@[simp]
theorem coeff_zero_factorialPoly (N : ℕ) : (factorialPoly R N).coeff 0 = 1 := by
  simp [coeff_zero_eq_eval_zero]

/-- Over a nontrivial ring, `P_N ≠ 0`. -/
theorem factorialPoly_ne_zero [Nontrivial R] (N : ℕ) : factorialPoly R N ≠ 0 := fun h => by
  simpa [h] using coeff_zero_factorialPoly R N

/-- `P_M ∣ P_N` for `M ≤ N`. -/
theorem factorialPoly_dvd_factorialPoly {M N : ℕ} (h : M ≤ N) :
    factorialPoly R M ∣ factorialPoly R N := by
  simp only [factorialPoly_eq_prod]
  exact Finset.prod_dvd_prod_of_subset _ _ _ (Finset.range_subset_range.2 h)

/-- The sign `(-1) ^ N` turns `P_N` into the product `∏_{i=1}^N (X ^ i - 1)`. -/
theorem neg_one_pow_mul_factorialPoly_eq_prod (N : ℕ) :
    (-1) ^ N * factorialPoly R N = ∏ i ∈ Finset.range N, (X ^ (i + 1) - 1 : R[X]) := by
  have h := Finset.pow_card_mul_prod (s := Finset.range N) (f := fun i => (1 - X ^ (i + 1) : R[X]))
    (b := -1)
  rw [Finset.card_range] at h
  rw [factorialPoly_eq_prod, h]
  exact Finset.prod_congr rfl fun _ _ => by ring

/-- The associate `(-1) ^ N P_N` of the factorial polynomial is monic. -/
theorem monic_neg_one_pow_mul_factorialPoly (N : ℕ) :
    ((-1) ^ N * factorialPoly R N).Monic := by
  rw [neg_one_pow_mul_factorialPoly_eq_prod]
  exact monic_prod_of_monic _ _ fun i _ => monic_X_pow_sub_one (Nat.succ_ne_zero i)

/-- **Signed cyclotomic factorization** of the factorial polynomial:
`(-1) ^ N P_N = ∏_{d=1}^N Φ_d ^ ⌊N / d⌋`. -/
theorem neg_one_pow_mul_factorialPoly (N : ℕ) :
    (-1) ^ N * factorialPoly R N =
      ∏ d ∈ Finset.Icc 1 N, cyclotomic d R ^ (N / d) := by
  induction N with
  | zero => simp
  | succ N ih =>
    -- Splitting `⌊(N + 1) / d⌋ = ⌊N / d⌋ + [d ∣ N + 1]` peels off `X ^ (N + 1) - 1`.
    have hdiv : ∏ d ∈ Finset.Icc 1 (N + 1), cyclotomic d R ^ (if d ∣ N + 1 then 1 else 0) =
        X ^ (N + 1) - 1 := by
      rw [← prod_cyclotomic_eq_X_pow_sub_one N.succ_pos,
        ← Nat.filter_dvd_eq_divisors N.succ_ne_zero, Finset.prod_filter]
      refine Finset.prod_subset_one_on_sdiff (fun d hd => ?_) (fun d hd => ?_) (fun d _ => ?_)
      · simp only [Finset.mem_Icc, Finset.mem_range] at hd ⊢
        omega
      · simp only [Finset.mem_sdiff, Finset.mem_Icc, Finset.mem_range] at hd
        obtain rfl : d = 0 := by omega
        simp
      · split_ifs <;> simp
    have hN : ∏ d ∈ Finset.Icc 1 (N + 1), cyclotomic d R ^ (N / d) =
        ∏ d ∈ Finset.Icc 1 N, cyclotomic d R ^ (N / d) := by
      rw [← Finset.insert_Icc_right_eq_Icc_add_one (by omega), Finset.prod_insert (by simp),
        Nat.div_eq_of_lt (Nat.lt_add_one N), pow_zero, one_mul]
    rw [factorialPoly_succ, pow_succ, mul_mul_mul_comm, ih]
    simp_rw [Nat.succ_div, pow_add, Finset.prod_mul_distrib, hN, hdiv]
    ring

/-- Divisibility of `P_N` is divisibility of its cyclotomic product, since the sign is a unit. -/
private theorem dvd_factorialPoly_iff {p : R[X]} {N : ℕ} :
    p ∣ factorialPoly R N ↔ p ∣ ∏ d ∈ Finset.Icc 1 N, cyclotomic d R ^ (N / d) := by
  rw [← neg_one_pow_mul_factorialPoly, ((isUnit_neg_one (α := R[X])).pow N).dvd_mul_left]

/-- `Φ_d ^ ⌊N / d⌋` divides `P_N`; for `d = 0` and `d > N` the power is `1`. -/
theorem cyclotomic_pow_dvd_factorialPoly (d N : ℕ) :
    cyclotomic d R ^ (N / d) ∣ factorialPoly R N := by
  rw [dvd_factorialPoly_iff]
  by_cases hd : d ∈ Finset.Icc 1 N
  · exact Finset.dvd_prod_of_mem _ hd
  · have : N / d = 0 := by
      rcases Nat.eq_zero_or_pos d with rfl | hd0
      · simp
      · exact Nat.div_eq_of_lt (by simp only [Finset.mem_Icc, not_and, not_le] at hd; omega)
    simp [this]

/-- A finite product of cyclotomic powers `∏_{d ∈ s} Φ_d ^ e_d` divides `P_N` whenever
`d e_d ≤ N` for every `d ∈ s`. -/
theorem prod_cyclotomic_pow_dvd_factorialPoly (s : Finset ℕ) (e : ℕ → ℕ) {N : ℕ}
    (h : ∀ d ∈ s, d * e d ≤ N) :
    ∏ d ∈ s, cyclotomic d R ^ e d ∣ factorialPoly R N := by
  classical
  rw [dvd_factorialPoly_iff]
  -- Only the orders `d ≥ 1` with `e_d ≠ 0` contribute, and these all lie in `[1, N]`.
  set t := s.filter fun d => d ≠ 0 ∧ e d ≠ 0
  have hst : ∏ d ∈ s, cyclotomic d R ^ e d = ∏ d ∈ t, cyclotomic d R ^ e d := by
    refine (Finset.prod_subset (Finset.filter_subset _ s) fun d hds hdt => ?_).symm
    simp only [Finset.mem_filter, not_and, not_not, hds, true_implies] at hdt
    by_cases hd : d = 0
    · simp [hd]
    · simp [hdt hd]
  have htN : t ⊆ Finset.Icc 1 N := fun d hd => by
    simp only [t, Finset.mem_filter] at hd
    have := h d hd.1
    have : d ≤ d * e d := Nat.le_mul_of_pos_right d (Nat.pos_of_ne_zero hd.2.2)
    simp only [Finset.mem_Icc]
    omega
  rw [hst]
  refine (Finset.prod_dvd_prod_of_dvd _ _ fun d hd => pow_dvd_pow _ ?_).trans
    (Finset.prod_dvd_prod_of_subset _ _ _ htN)
  simp only [t, Finset.mem_filter] at hd
  exact (Nat.le_div_iff_mul_le (Nat.pos_of_ne_zero hd.2.1)).2 (by linarith [h d hd.1])

variable {R} in
/-- **Factorial cofinality.** Every product of cyclotomic polynomials divides some factorial
polynomial `P_N`. -/
theorem exists_dvd_factorialPoly {f : R[X]}
    (hf : f ∈ Submonoid.closure (Set.range fun n => cyclotomic n R)) :
    ∃ N, f ∣ factorialPoly R N := by
  obtain ⟨e, rfl⟩ := Submonoid.exists_finsupp_of_mem_closure_range _ f hf
  refine ⟨∑ d ∈ e.support, d * e d, ?_⟩
  exact prod_cyclotomic_pow_dvd_factorialPoly R e.support e fun d hd =>
    Finset.single_le_sum (f := fun d => d * e d) (fun _ _ => Nat.zero_le _) hd

/-- The monic associate `(-1) ^ N P_N` of the factorial polynomial is a product of cyclotomic
polynomials. -/
theorem neg_one_pow_mul_factorialPoly_mem_closure (N : ℕ) :
    (-1) ^ N * factorialPoly R N ∈ Submonoid.closure (Set.range fun n => cyclotomic n R) := by
  rw [neg_one_pow_mul_factorialPoly]
  exact Submonoid.prod_mem _ fun d _ =>
    Submonoid.pow_mem _ (Submonoid.subset_closure (Set.mem_range_self d)) _

/-- `(X ^ m - 1) ^ k` divides `P_N` for `0 < m` and `m k ≤ N`: every cyclotomic factor `Φ_d`
of `X ^ m - 1` has `d k ≤ m k`. -/
theorem X_pow_sub_one_pow_dvd_factorialPoly {m k N : ℕ} (hm : 0 < m) (h : m * k ≤ N) :
    ((X : R[X]) ^ m - 1) ^ k ∣ factorialPoly R N := by
  rw [← prod_cyclotomic_eq_X_pow_sub_one hm, ← Finset.prod_pow]
  refine prod_cyclotomic_pow_dvd_factorialPoly R _ (fun _ => k) fun d hd => ?_
  exact (Nat.mul_le_mul_right k (Nat.divisor_le hd)).trans h

/-- `P_N` has leading coefficient `(-1) ^ N`. -/
@[simp]
theorem leadingCoeff_factorialPoly (N : ℕ) : (factorialPoly R N).leadingCoeff = (-1) ^ N := by
  have hsq : ((-1 : R[X]) ^ N) * (-1) ^ N = 1 := by rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
  rw [← one_mul (factorialPoly R N), ← hsq, mul_assoc,
    leadingCoeff_mul_monic (monic_neg_one_pow_mul_factorialPoly R N), ← C_1, ← C_neg, ← C_pow,
    leadingCoeff_C]

/-- Over a nontrivial ring, `P_N` has degree `N (N + 1) / 2`. -/
@[simp]
theorem natDegree_factorialPoly [Nontrivial R] (N : ℕ) :
    (factorialPoly R N).natDegree = N * (N + 1) / 2 := by
  have hdeg : ((-1) ^ N * factorialPoly R N).natDegree = N * (N + 1) / 2 := by
    -- The factors `X ^ (i + 1) - 1` are monic of degree `i + 1`; sum these with Gauss's formula.
    rw [neg_one_pow_mul_factorialPoly_eq_prod,
      natDegree_prod_of_monic _ _ fun i _ => monic_X_pow_sub_one (Nat.succ_ne_zero i),
      Finset.sum_congr rfl fun i _ => by rw [← C_1, natDegree_X_pow_sub_C],
      ← add_zero (∑ _ ∈ _, _), ← Finset.sum_range_succ' (fun i => i) N, Finset.sum_range_id,
      Nat.add_sub_cancel, mul_comm]
  rcases neg_one_pow_eq_or R[X] N with h | h <;> rw [h] at hdeg
  · rwa [one_mul] at hdeg
  · rwa [neg_one_mul, natDegree_neg] at hdeg

/-- Over `ℚ`, distinct cyclotomic polynomials are coprime, so the exponent of `Φ_d` in `P_N` is
exactly `⌊N / d⌋`. -/
private theorem cyclotomic_pow_dvd_factorialPoly_rat_iff {d k N : ℕ} (hd : 0 < d) :
    cyclotomic d ℚ ^ k ∣ factorialPoly ℚ N ↔ k ≤ N / d := by
  refine ⟨fun h => ?_, fun h =>
    (pow_dvd_pow _ h).trans (cyclotomic_pow_dvd_factorialPoly ℚ d N)⟩
  rw [dvd_factorialPoly_iff] at h
  -- Split off the factor `Φ_d ^ ⌊N / d⌋`, which is `1` when `d > N`.
  have hsplit : ∏ d' ∈ Finset.Icc 1 N, cyclotomic d' ℚ ^ (N / d') =
      cyclotomic d ℚ ^ (N / d) *
        ∏ d' ∈ (Finset.Icc 1 N).erase d, cyclotomic d' ℚ ^ (N / d') := by
    by_cases hdN : d ∈ Finset.Icc 1 N
    · exact (Finset.mul_prod_erase _ _ hdN).symm
    · rw [Finset.erase_eq_of_notMem hdN, Nat.div_eq_of_lt (by simp at hdN; omega), pow_zero,
        one_mul]
  have hcop : IsCoprime (cyclotomic d ℚ ^ k)
      (∏ d' ∈ (Finset.Icc 1 N).erase d, cyclotomic d' ℚ ^ (N / d')) :=
    IsCoprime.prod_right fun d' hd' =>
      ((cyclotomic.isCoprime_rat (Finset.ne_of_mem_erase hd').symm).pow)
  rw [hsplit] at h
  exact (pow_dvd_pow_iff (cyclotomic_ne_zero d ℚ)
    (not_isUnit_of_degree_pos _ (degree_cyclotomic_pos d ℚ hd))).1
    (hcop.dvd_of_dvd_mul_right h)

/-- Both polynomials come from `ℤ[X]` and the divisor is monic, so over a ring of characteristic
zero the divisibility `Φ_d ^ k ∣ P_N` is decided over `ℤ`. -/
private theorem cyclotomic_pow_dvd_factorialPoly_iff_int [CharZero R] (d k N : ℕ) :
    cyclotomic d R ^ k ∣ factorialPoly R N ↔ cyclotomic d ℤ ^ k ∣ factorialPoly ℤ N := by
  rw [← map_dvd_map (Int.castRingHom R) Int.cast_injective ((cyclotomic.monic d ℤ).pow k),
    Polynomial.map_pow, map_cyclotomic, map_factorialPoly]

/-- **Sharpness of the cyclotomic multiplicities** in characteristic zero: for `0 < d`,
`Φ_d ^ k ∣ P_N` if and only if `k ≤ ⌊N / d⌋`. -/
theorem cyclotomic_pow_dvd_factorialPoly_iff [CharZero R] {d k N : ℕ} (hd : 0 < d) :
    cyclotomic d R ^ k ∣ factorialPoly R N ↔ k ≤ N / d := by
  rw [cyclotomic_pow_dvd_factorialPoly_iff_int, ← cyclotomic_pow_dvd_factorialPoly_iff_int ℚ,
    cyclotomic_pow_dvd_factorialPoly_rat_iff hd]

/-! ### Checks -/

example : factorialPoly ℤ 2 = 1 - X - X ^ 2 + X ^ 3 := by
  simp only [factorialPoly_succ, factorialPoly_zero]
  ring

example : factorialPoly ℤ 3 = 1 - X - X ^ 2 + X ^ 4 + X ^ 5 - X ^ 6 := by
  simp only [factorialPoly_succ, factorialPoly_zero]
  ring

example : -factorialPoly ℤ 3 = cyclotomic 1 ℤ ^ 3 * cyclotomic 2 ℤ * cyclotomic 3 ℤ := by
  have h := neg_one_pow_mul_factorialPoly ℤ 3
  rw [Finset.prod_Icc_succ_top (by norm_num), Finset.prod_Icc_succ_top (by norm_num),
    Finset.Icc_self, Finset.prod_singleton] at h
  norm_num at h ⊢
  exact h

example : cyclotomic 3 ℤ ^ 2 ∣ factorialPoly ℤ 6 :=
  (cyclotomic_pow_dvd_factorialPoly_iff ℤ (by norm_num)).2 (by norm_num)

example : ¬cyclotomic 3 ℤ ^ 2 ∣ factorialPoly ℤ 5 := by
  rw [cyclotomic_pow_dvd_factorialPoly_iff ℤ (by norm_num)]
  norm_num

end TauCeti
