module

public import Mathlib.RingTheory.Polynomial.IsIntegral

import TauCeti.Algebra.Module.Submodule.MultiplierRing

/-!
# Integrality from a monic quadratic relation

In a commutative algebra, a root of a monic quadratic with integral coefficients is integral; this
is a case of Mathlib's `IsIntegral.of_aeval_monic_of_isIntegral_coeff`. The criterion here extends
this to noncommutative algebras, provided that the two coefficients commute with each other. The
root itself need not commute with the coefficients.

## Main results

* `IsIntegral.of_sq_add_mul_add_eq_zero`: if `y ^ 2 + b * y + c = 0` with `b` and `c` integral over
  `R` and commuting with each other, then `y` is integral over `R`. The algebra need not be
  commutative, and `y` need not commute with `b` or `c`.

The relation is stated as an equation rather than through `Polynomial.aeval`, which is the form a
caller actually holds: a change-of-variables identity or a curve equation, rearranged by
`linear_combination`.

## Implementation notes

The subalgebra `S` generated by `b` and `c` is commutative because `b` and `c` commute. Since it
is commutative and generated by finitely many elements that are integral over `R`, Mathlib's
`fg_adjoin_of_finite` makes it a finitely generated `R`-module. Right multiplication
by `y` maps the finitely generated `R`-module `M = S + S * y`, which contains `1`, into itself. In
the opposite algebra this says that `op y` is a left multiplier of the image of `M`, so
`Submodule.isIntegral_of_mem_multiplierRing` (Cayley–Hamilton) makes `op y` integral over `R`. A
monic relation for `op y` is one for `y`.

## Applications

For a Weierstrass equation over `R`, read in a commutative `R`-algebra, the equation is monic
quadratic in `y`. When `x` is integral over `R`, its remaining coefficients are integral as well,
so this criterion proves integrality of `y`. It also applies to the quadratic relations for `s` and
`t` in a change of variables between integral Weierstrass models.

## Provenance

The commutative case was first proved inside
`WeierstrassCurve.isIntegral_y_of_equation_of_isIntegral_x` in
`TauCeti/AlgebraicGeometry/EllipticCurve/Integrality.lean`.
-/

public section

open Polynomial

open scoped IsMulCommutative in
/-- **If `y ^ 2 + b * y + c = 0` with `b` and `c` integral over `R` and commuting with each other,
then `y` is integral over `R`.**
`y`, `b` and `c` live in an arbitrary `R`-algebra `A`, which need not be commutative, and `y`
need not commute with `b` or `c`. The relation is an equation in `A` rather than a statement about
`Polynomial.aeval`, so a caller supplies whatever identity it already holds. -/
theorem IsIntegral.of_sq_add_mul_add_eq_zero {R A : Type*} [CommRing R] [Ring A] [Algebra R A]
    {b c y : A} (hb : IsIntegral R b) (hc : IsIntegral R c) (hbc : Commute b c)
    (h : y ^ 2 + b * y + c = 0) : IsIntegral R y := by
  -- The subalgebra `S` generated by `b` and `c` is commutative because `b` and `c` commute.
  let S := Algebra.adjoin R {b, c}
  have : IsMulCommutative S :=
    Algebra.isMulCommutative_adjoin R (Set.pairwise_pair_of_symm_of_refl.mpr hbc)
  have hbS : b ∈ S := Algebra.subset_adjoin (by simp)
  have hcS : c ∈ S := Algebra.subset_adjoin (by simp)
  -- Being commutative and generated by two integral elements, `S` is finite over `R`.
  have hS : (Subalgebra.toSubmodule S).FG := by
    have := fg_adjoin_of_finite (R := R)
      ((Set.toFinite {b, c}).preimage Subtype.val_injective.injOn) fun x hx ↦ by
        rw [← isIntegral_algHom_iff S.val Subtype.val_injective]
        obtain hx | hx := hx <;> simp_all
    rw [Algebra.adjoin_adjoin_coe_preimage] at this
    simpa only [← Subalgebra.map_toSubmodule, Algebra.map_top, Subalgebra.range_val] using
      this.map S.val.toLinearMap
  -- Right multiplication by `y` preserves the finitely generated `R`-module `M = S + S * y`.
  let M := Subalgebra.toSubmodule S ⊔ (Subalgebra.toSubmodule S).map (LinearMap.mulRight R y)
  have hM : ∀ m ∈ M, m * y ∈ M := by
    intro m hm
    obtain ⟨s, hs, _, ⟨t, ht, rfl⟩, rfl⟩ := Submodule.mem_sup.mp hm
    have hy : y * y = -c - b * y := by
      rw [← pow_two]; exact eq_sub_of_add_eq (eq_neg_of_add_eq_zero_left h)
    have : (s + t * y) * y = -(t * c) + (s - t * b) * y := by
      simp only [add_mul, sub_mul, mul_sub, mul_neg, mul_assoc, hy]; abel
    rw [LinearMap.mulRight_apply, this]
    exact Submodule.add_mem_sup (neg_mem (S.mul_mem ht hcS))
      ⟨_, sub_mem hs (S.mul_mem ht hbS), rfl⟩
  -- In `Aᵐᵒᵖ`, `op y` is a left multiplier of the image `N` of `M`, which contains `1`, so it is
  -- integral over `R`; its monic relation is one for `y`.
  let N : Submodule R Aᵐᵒᵖ := M.map (MulOpposite.opLinearEquiv R).toLinearMap
  have hN : ∀ z ∈ N, MulOpposite.op y * z ∈ N := by
    rintro _ ⟨m, hm, rfl⟩
    exact ⟨m * y, hM m hm, rfl⟩
  obtain ⟨p, hp, hpy⟩ : IsIntegral R (MulOpposite.op y) :=
    Submodule.isIntegral_of_mem_multiplierRing (M := N) ((hS.sup (hS.map _)).map _)
      ⟨1, Submodule.mem_sup_left S.one_mem, rfl⟩ (AddSubgroup.mem_multiplierRing.mpr hN)
  refine ⟨p, hp, ?_⟩
  rw [← aeval_def] at hpy ⊢
  rwa [aeval_op_apply, MulOpposite.op_eq_zero_iff] at hpy

end
