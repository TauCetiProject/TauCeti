module

public import Mathlib.RingTheory.Polynomial.IsIntegral

/-!
# Integrality from a monic quadratic relation

Mathlib's `IsIntegral.of_aeval_monic_of_isIntegral_coeff` takes a monic polynomial and asks for
each coefficient to be integral. Applying it to a quadratic means writing the polynomial out,
discharging the degree computation, and answering the coefficient obligation index by index — the
same half-dozen lines every time.

## Main results

* `IsIntegral.of_sq_add_mul_add_eq_zero`: if `y ^ 2 + b * y + c = 0` with `b` and `c` integral over
  `R` and `b` commuting with `y`, then `y` is integral over `R`. The algebra need not be
  commutative.

The relation is stated as an equation rather than through `Polynomial.aeval`, which is the form a
caller actually holds: a change-of-variables identity or a curve equation, rearranged by
`linear_combination`.

## Applications

For a Weierstrass equation over `R`, the equation is monic quadratic in `y`. When `x` is integral
over `R`, its remaining coefficients are integral as well, so this criterion proves integrality
of `y`. It also applies to the quadratic relations for `s` and `t` in a change of variables between
integral Weierstrass models.

## Provenance

The argument comes from the proof of
`WeierstrassCurve.isIntegral_y_of_equation_of_isIntegral_x` in
`TauCeti/AlgebraicGeometry/EllipticCurve/Integrality.lean`.
-/

public section

open Polynomial

open scoped IsMulCommutative in
attribute [local instance] Polynomial.algebra in
/-- **If `y ^ 2 + b * y + c = 0` with `b` and `c` integral over `R` and `b` commuting with `y`,
then `y` is integral over `R`.**
`y`, `b` and `c` live in an arbitrary `R`-algebra `A`, which need not be commutative, and the
relation is an equation in `A` rather than a statement about `Polynomial.aeval`, so a caller
supplies whatever identity it already holds. -/
theorem IsIntegral.of_sq_add_mul_add_eq_zero {R A : Type*} [CommRing R] [Ring A] [Algebra R A]
    {b c y : A} (hb : IsIntegral R b) (hc : IsIntegral R c) (hby : Commute b y)
    (h : y ^ 2 + b * y + c = 0) : IsIntegral R y := by
  nontriviality A
  -- Work in the subalgebra `S` generated by `b` and `y`: it is commutative and contains `c`.
  let S := Algebra.adjoin R {b, y}
  have : IsMulCommutative S :=
    Algebra.isMulCommutative_adjoin R (Set.pairwise_pair_of_symm_of_refl.mpr hby)
  have hbS : b ∈ S := Algebra.subset_adjoin (by simp)
  have hyS : y ∈ S := Algebra.subset_adjoin (by simp)
  have hcS : c ∈ S := by
    rw [eq_neg_of_add_eq_zero_right h]
    exact neg_mem (add_mem (pow_mem hyS 2) (mul_mem hbS hyS))
  -- Integrality over `R` is the same in `S` as in `A`.
  have hS (x : S) : IsIntegral R x ↔ IsIntegral R (x : A) :=
    (isIntegral_algHom_iff S.val Subtype.val_injective).symm
  refine (hS ⟨y, hyS⟩).1 ?_
  -- `IsIntegral.of_aeval_monic_of_isIntegral_coeff` for `X ^ 2 + (C b * X + C c)` over `S`.
  have hdeg : (X ^ 2 + (C ⟨b, hbS⟩ * X + C ⟨c, hcS⟩) : S[X]).natDegree = 2 := by
    simpa only [C_1, one_mul, add_assoc] using
      natDegree_quadratic (b := (⟨b, hbS⟩ : S)) (c := ⟨c, hcS⟩) (one_ne_zero : (1 : S) ≠ 0)
  refine .of_aeval_monic_of_isIntegral_coeff (monic_X_pow_add degree_linear_lt)
    (hdeg ▸ two_ne_zero) ?_ fun i ↦ ?_
  · -- `y` is a root of this polynomial: the relation `h`, read in `S`.
    have hroot : eval ⟨y, hyS⟩ (X ^ 2 + (C ⟨b, hbS⟩ * X + C ⟨c, hcS⟩) : S[X]) = 0 :=
      Subtype.ext (by simpa [← add_assoc] using h)
    rw [hroot]
    exact isIntegral_zero
  · -- The polynomial is integral over `R[X]`, hence so are its coefficients over `R`.
    have hC {a : S} (ha : IsIntegral R (a : A)) : IsIntegral R[X] (C a) :=
      (((hS a).2 ha).map (CAlgHom (R := R))).tower_top
    have hX : IsIntegral R[X] (X : S[X]) := by
      simpa using isIntegral_algebraMap (R := R[X]) (A := S[X]) (x := X)
    exact ((hX.pow 2).add (((hC hb).mul hX).add (hC hc))).coeff i

end
