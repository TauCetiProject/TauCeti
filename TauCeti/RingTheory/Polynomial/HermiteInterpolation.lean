/-!
# Hermite interpolation

Given nodes `a : ι → R` and multiplicities `m : ι → ℕ`, the *Hasse jets* of a polynomial `f` are
the values `(hasseDeriv k f).eval (a i)` for `k < m i`: the first `m i` Taylor coefficients of `f`
at `a i`. Hermite interpolation says that when the node differences `a i - a j` (`i ≠ j`) are units
(in particular, over a field with distinct nodes), these `M = ∑ i, m i` values can be prescribed
arbitrarily and determine `f` uniquely among the polynomials of degree below `M`. This generalises
Lagrange interpolation (`Lagrange.funEquivDegreeLT`, every `m i = 1`) to arbitrary multiplicities,
including `0`, and to Hasse rather than ordinary derivatives, so that it holds in every
characteristic.

The kernel of the unrestricted jet map `TauCeti.hasseJet a m` on `R[X]` is the ideal generated by
`P = ∏ i, (X - C (a i)) ^ m i`: at one node this is Taylor's formula
(`Polynomial.X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero`), and the factors are pairwise
coprime. Over an integral domain the same divisibility criterion holds for any injective nodes,
giving injectivity of `TauCeti.hermiteJet a m`. When the node differences are units, the Chinese
remainder theorem identifies `R[X] ⧸ (P) ≃+* ∀ i, R[X] ⧸ ((X - C (a i)) ^ m i)`
(`TauCeti.hermiteQuotientEquiv`), followed by the local Taylor coordinates
`TauCeti.taylorJetQuotientEquiv` to give
`TauCeti.hasseJetQuotientEquiv : R[X] ⧸ (P) ≃ₗ[R] ∀ i, Fin (m i) → R`. Restriction to polynomials
of degree below `M` yields the Hermite interpolation linear equivalence `TauCeti.hermiteJetEquiv`
and its dual basis `TauCeti.hermiteBasis`.

## Main definitions

* `TauCeti.hasseJet a m`: the `R`-linear map `R[X] →ₗ[R] ∀ i, Fin (m i) → R` sending `f` to its
  Hasse jets `(hasseDeriv k f).eval (a i)`.
* `TauCeti.hermiteJet a m`: its restriction to `Polynomial.degreeLT R (∑ i, m i)`.
* `TauCeti.ordinaryHermiteJet a m`: the ordinary-derivative jet map
  `f ↦ ((derivative^[k] f).eval (a i))_{i, k < m i}` on `degreeLT R (∑ i, m i)`.
* `TauCeti.hermiteQuotientEquiv`: the Chinese remainder isomorphism
  `R[X] ⧸ (∏ i, (X - C (a i)) ^ m i) ≃+* ∀ i, R[X] ⧸ ((X - C (a i)) ^ m i)`.
* `TauCeti.hasseJetQuotientEquiv`: the `R`-linear equivalence
  `R[X] ⧸ (∏ i, (X - C (a i)) ^ m i) ≃ₗ[R] ∀ i, Fin (m i) → R`.
* `TauCeti.hermiteJetEquiv`: Hermite interpolation as a linear equivalence
  `degreeLT R (∑ i, m i) ≃ₗ[R] ∀ i, Fin (m i) → R`; its inverse sends a jet datum to its
  interpolation polynomial.
* `TauCeti.hermiteBasis`: the basis of `degreeLT R (∑ i, m i)` dual to the Hasse jets.

## Main results

* `TauCeti.prod_X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero`: over an integral domain, for
  injective nodes, `(∏ i, (X - C (a i)) ^ m i) ∣ f` iff all Hasse jets `(hasseDeriv k f).eval (a i)`
  with `k < m i` vanish (admitting `f = 0`);
  `prod_X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero_of_pairwise_isUnit_sub` is the
  commutative-ring form.
* `TauCeti.hasseJetQuotientEquiv_eq_taylorJetQuotientEquiv` and
  `TauCeti.hermiteJet_eq_taylorJetQuotientEquiv`: the jet map factors through the quotient by
  `∏ i, (X - C (a i)) ^ m i`, the Chinese remainder isomorphism, and the local Taylor coordinates.
* `TauCeti.hermiteJet_injective`, `TauCeti.ker_hasseJet`: over an integral domain, for injective
  nodes, `hermiteJet a m` is injective and `ker (hasseJet a m)` is generated by
  `∏ i, (X - C (a i)) ^ m i`.
* `TauCeti.hermiteJet_bijective` and `TauCeti.existsUnique_hermite_interpolation`: over a field,
  for injective nodes, the Hermite jet map is bijective and every jet datum has a unique
  interpolating polynomial of degree below `∑ i, m i`; the `_of_pairwise_isUnit_sub` versions hold
  over any commutative ring.
* `TauCeti.eq_hermiteJetEquiv_symm_iff`, `TauCeti.map_hermiteJetEquiv_symm`: uniqueness
  characterization and naturality of the interpolation polynomial under ring homomorphisms.
* `TauCeti.sum_eval_hasseDeriv_smul_hermiteBasis`: expansion
  `f = ∑_{i, k} D^[k] f (a i) • b_{i, k}`.
* `TauCeti.ordinaryHermiteJet_injective`, `TauCeti.ordinaryHermiteJet_bijective`, and
  `TauCeti.ordinaryHermiteJet_bijective_of_pairwise_isUnit_sub`: injectivity (when `k ! ≠ 0`) and
  bijectivity (when `k !` is a unit) of the ordinary-derivative jet map.

## References

* H. Iwaniec and E. Kowalski, *Analytic Number Theory*, AMS Colloquium Publications 53 (2004),
  §11.6: the Hasse derivatives as Taylor coefficients, pp. 282–283, and the multiplicity
  criterion through Hasse derivatives, Lemma 11.16, pp. 283–284.
-/

public section

noncomputable section

open Finset Function Polynomial
open scoped Nat

namespace TauCeti

variable {ι R S K : Type*}

section Semiring

variable [Semiring R]

/-- The Hasse jet map at the nodes `a i` with multiplicities `m i`: the `R`-linear map sending a
polynomial `f` to its Hasse jets `(hasseDeriv k f).eval (a i)` of the orders `k < m i`. A node
with `m i = 0` contributes no coordinate. -/
def hasseJet (a : ι → R) (m : ι → ℕ) : R[X] →ₗ[R] ∀ i, Fin (m i) → R :=
  LinearMap.pi fun i => taylorJet (a i) (m i)

@[simp]
theorem hasseJet_apply (a : ι → R) (m : ι → ℕ) (f : R[X]) (i : ι) (k : Fin (m i)) :
    hasseJet a m f i k = (hasseDeriv k f).eval (a i) := by
  simp [hasseJet]

/-- Taking Hasse jets commutes with mapping coefficients and nodes by a ring homomorphism. -/
theorem hasseJet_map [Semiring S] (ψ : R →+* S) (a : ι → R) (m : ι → ℕ) (f : R[X]) :
    hasseJet (ψ ∘ a) m (f.map ψ) = fun i k => ψ (hasseJet a m f i k) := by
  ext i k
  simp only [hasseJet_apply, Function.comp_apply, hasseDeriv_map, eval_map, eval₂_hom]

/-- The Hasse jet map vanishes at `f` iff every Hasse derivative of order `k < m i` vanishes at
`a i`. -/
theorem hasseJet_eq_zero_iff_forall (a : ι → R) (m : ι → ℕ) (f : R[X]) :
    hasseJet a m f = 0 ↔ ∀ i, ∀ k < m i, (hasseDeriv k f).eval (a i) = 0 := by
  simp only [funext_iff, hasseJet_apply, Pi.zero_apply]
  exact ⟨fun h i k hk => h i ⟨k, hk⟩, fun h i k => h i k k.isLt⟩

variable [Fintype ι]

/-- The Hermite jet map: the Hasse jet map `hasseJet a m` restricted to polynomials of degree below
`∑ i, m i`. -/
def hermiteJet (a : ι → R) (m : ι → ℕ) :
    degreeLT R (∑ i, m i) →ₗ[R] ∀ i, Fin (m i) → R :=
  (hasseJet a m).domRestrict _

@[simp]
theorem hermiteJet_apply (a : ι → R) (m : ι → ℕ) (f : degreeLT R (∑ i, m i)) (i : ι)
    (k : Fin (m i)) : hermiteJet a m f i k = (hasseDeriv k (f : R[X])).eval (a i) := by
  simp [hermiteJet]

/-- The Hermite jet map is the restriction of the unrestricted Hasse jet map. -/
theorem hermiteJet_eq_hasseJet (a : ι → R) (m : ι → ℕ) (f : degreeLT R (∑ i, m i)) :
    hermiteJet a m f = hasseJet a m f := by
  ext i k
  simp

/-- The Hermite jet map commutes with mapping coefficients and nodes by a ring homomorphism. -/
theorem hermiteJet_map [Semiring S] (ψ : R →+* S) (a : ι → R) (m : ι → ℕ)
    (f : degreeLT R (∑ i, m i)) :
    hermiteJet (ψ ∘ a) m ⟨(f : R[X]).map ψ, map_mem_degreeLT ψ f.property⟩ =
      fun i k => ψ (hermiteJet a m f i k) := by
  rw [hermiteJet_eq_hasseJet, hermiteJet_eq_hasseJet]
  exact hasseJet_map ψ a m f

/-- The jet map built from ordinary derivatives, `f ↦ ((derivative^[k] f).eval (a i))_{i, k < m i}`,
on polynomials of degree below `∑ i, m i`. -/
def ordinaryHermiteJet (a : ι → R) (m : ι → ℕ) :
    degreeLT R (∑ i, m i) →ₗ[R] ∀ i, Fin (m i) → R :=
  LinearMap.pi fun i => LinearMap.pi fun k =>
    leval (a i) ∘ₗ (derivative ^ (k : ℕ)) ∘ₗ (degreeLT R (∑ i, m i)).subtype

@[simp]
theorem ordinaryHermiteJet_apply (a : ι → R) (m : ι → ℕ) (f : degreeLT R (∑ i, m i)) (i : ι)
    (k : Fin (m i)) :
    ordinaryHermiteJet a m f i k = (derivative^[k] (f : R[X])).eval (a i) := by
  simp [ordinaryHermiteJet, pow_apply_eq_iterate]

/-- The ordinary jets are the Hasse jets scaled by `k !`. -/
theorem ordinaryHermiteJet_eq_factorial_mul (a : ι → R) (m : ι → ℕ) (f : degreeLT R (∑ i, m i))
    (i : ι) (k : Fin (m i)) :
    ordinaryHermiteJet a m f i k = (k ! : R) * hermiteJet a m f i k := by
  rw [ordinaryHermiteJet_apply, ← factorial_smul_hasseDeriv]
  simp [nsmul_eq_mul]

end Semiring

section CommRing

variable [CommRing R] {a : ι → R}

/-- The Hasse jet map is surjective when the differences of the nodes are units: every family of
Hasse jets of orders `k < m i` at the nodes `a i` is attained by a polynomial. -/
theorem hasseJet_surjective [Finite ι] (ha : Pairwise fun i j => IsUnit (a i - a j))
    (m : ι → ℕ) : Surjective (hasseJet a m) := by
  intro c
  choose p hp using fun i => taylorJet_surjective (a i) (m i) (c i)
  obtain ⟨g, hg⟩ := Ideal.exists_forall_sub_mem_ideal
    (I := fun i => Ideal.span {(X - C (a i)) ^ m i})
    (fun _ _ hij => (Ideal.isCoprime_span_singleton_iff _ _).2
      (isCoprime_X_sub_C_of_isUnit_sub (ha hij)).pow) p
  refine ⟨g, funext fun i => ?_⟩
  have h : taylorJet (a i) (m i) (g - p i) = 0 :=
    taylorJet_eq_zero_iff.2 (Ideal.mem_span_singleton.1 (hg i))
  rw [map_sub, sub_eq_zero] at h
  simpa [hasseJet, h] using hp i

variable [Fintype ι]

/-- **The kernel of the jet map** over a commutative ring: when the differences of the nodes are
units, `∏ i, (X - C (a i)) ^ m i` divides `f` iff all Hasse jets `(hasseDeriv k f).eval (a i)`
with `k < m i` vanish. -/
theorem prod_X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero_of_pairwise_isUnit_sub
    (ha : Pairwise fun i j => IsUnit (a i - a j)) (m : ι → ℕ) (f : R[X]) :
    (∏ i, (X - C (a i)) ^ m i) ∣ f ↔ ∀ i, ∀ k < m i, (hasseDeriv k f).eval (a i) = 0 := by
  simp_rw [← X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero]
  exact ⟨fun h i => (dvd_prod_of_mem _ (mem_univ i)).trans h,
    Fintype.prod_dvd_of_coprime fun _ _ hij => (isCoprime_X_sub_C_of_isUnit_sub (ha hij)).pow⟩

/-- When the differences of the nodes are units, the Hasse jets of `f` vanish iff
`∏ i, (X - C (a i)) ^ m i` divides `f`. -/
theorem hasseJet_eq_zero_iff_of_pairwise_isUnit_sub
    (ha : Pairwise fun i j => IsUnit (a i - a j)) (m : ι → ℕ) (f : R[X]) :
    hasseJet a m f = 0 ↔ (∏ i, (X - C (a i)) ^ m i) ∣ f :=
  (hasseJet_eq_zero_iff_forall a m f).trans
    (prod_X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero_of_pairwise_isUnit_sub ha m f).symm

variable (ha : Pairwise fun i j => IsUnit (a i - a j)) (m : ι → ℕ)
include ha

/-- The kernel of the Hasse jet map is the ideal generated by `∏ i, (X - C (a i)) ^ m i`, when the
differences of the nodes are units. -/
theorem ker_hasseJet_of_pairwise_isUnit_sub :
    LinearMap.ker (hasseJet a m) = (Ideal.span {∏ i, (X - C (a i)) ^ m i}).restrictScalars R := by
  ext f
  simp [Ideal.mem_span_singleton, hasseJet_eq_zero_iff_of_pairwise_isUnit_sub ha m f]

/-- **Chinese remainder theorem** for the product `∏ i, (X - C (a i)) ^ m i`, when the differences
of the nodes are units. -/
def hermiteQuotientEquiv :
    R[X] ⧸ Ideal.span {∏ i, (X - C (a i)) ^ m i} ≃+*
      ((i : ι) → R[X] ⧸ Ideal.span {(X - C (a i)) ^ m i}) :=
  (Ideal.quotEquivOfEq
      (Ideal.iInf_span_singleton fun _ _ hij =>
        (isCoprime_X_sub_C_of_isUnit_sub (ha hij)).pow).symm).trans <|
    Ideal.quotientInfRingEquivPiQuotient _ fun _ _ hij =>
      (Ideal.isCoprime_span_singleton_iff _ _).2 (isCoprime_X_sub_C_of_isUnit_sub (ha hij)).pow

@[simp]
theorem hermiteQuotientEquiv_mk (f : R[X]) (i : ι) :
    hermiteQuotientEquiv ha m (Ideal.Quotient.mk _ f) i = Ideal.Quotient.mk _ f := by
  rw [hermiteQuotientEquiv, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk]
  exact Ideal.quotientInfRingEquivPiQuotient_mk_apply _ _ _

/-- The jet space is linearly equivalent to `R[X] ⧸ (∏ i, (X - C (a i)) ^ m i)` when the
differences of the nodes are units: the Hasse jet map identifies the two. -/
def hasseJetQuotientEquiv :
    (R[X] ⧸ Ideal.span {∏ i, (X - C (a i)) ^ m i}) ≃ₗ[R] ∀ i, Fin (m i) → R :=
  (Submodule.Quotient.restrictScalarsEquiv R _).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _ (ker_hasseJet_of_pairwise_isUnit_sub ha m).symm ≪≫ₗ
      (hasseJet a m).quotKerEquivOfSurjective (hasseJet_surjective ha m)

@[simp]
theorem hasseJetQuotientEquiv_mk (f : R[X]) :
    hasseJetQuotientEquiv ha m (Ideal.Quotient.mk _ f) = hasseJet a m f := by
  simp only [← Ideal.Quotient.mk_eq_mk, hasseJetQuotientEquiv, LinearEquiv.trans_apply,
    Submodule.Quotient.restrictScalarsEquiv_symm_mk, Submodule.quotEquivOfEq_mk,
    LinearMap.quotKerEquivOfSurjective_apply_mk]

/-- The inverse quotient equivalence sends the jets of a polynomial to its residue class. -/
@[simp]
theorem hasseJetQuotientEquiv_symm_hasseJet (f : R[X]) :
    (hasseJetQuotientEquiv ha m).symm (hasseJet a m f) = Ideal.Quotient.mk _ f := by
  rw [LinearEquiv.symm_apply_eq, hasseJetQuotientEquiv_mk]

/-- On `R[X] ⧸ (∏ i, (X - C (a i)) ^ m i)`, the quotient jet equivalence factors as the Chinese
remainder isomorphism followed by the local Taylor coordinates at each node. -/
theorem hasseJetQuotientEquiv_eq_taylorJetQuotientEquiv
    (q : R[X] ⧸ Ideal.span {∏ i, (X - C (a i)) ^ m i}) (i : ι) :
    hasseJetQuotientEquiv ha m q i =
      taylorJetQuotientEquiv (a i) (m i) (hermiteQuotientEquiv ha m q i) := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective q
  rw [hasseJetQuotientEquiv_mk, hermiteQuotientEquiv_mk, taylorJetQuotientEquiv_mk]
  ext k
  simp

/-- The Hermite jet map is the composite of the projection to `R[X] ⧸ (∏ i, (X - C (a i)) ^ m i)`,
the Chinese remainder isomorphism, and the local Taylor coordinates. -/
theorem hermiteJet_eq_taylorJetQuotientEquiv (f : degreeLT R (∑ i, m i)) (i : ι) :
    hermiteJet a m f i =
      taylorJetQuotientEquiv (a i) (m i)
        (hermiteQuotientEquiv ha m (Ideal.Quotient.mk _ (f : R[X])) i) := by
  rw [hermiteJet_eq_hasseJet, ← hasseJetQuotientEquiv_mk ha m,
    hasseJetQuotientEquiv_eq_taylorJetQuotientEquiv]

/-- Hermite interpolation as a linear equivalence, when the differences of the nodes are units: a
polynomial of degree below `∑ i, m i` is determined by its Hasse jets of the orders `k < m i` at
the nodes `a i`, and every jet datum is attained. -/
def hermiteJetEquiv : degreeLT R (∑ i, m i) ≃ₗ[R] ∀ i, Fin (m i) → R :=
  LinearEquiv.ofEq _ _ (by nontriviality R; rw [natDegree_prod_X_sub_C_pow]) ≪≫ₗ
    AdjoinRoot.degreeLTEquiv (monic_prod_X_sub_C_pow univ a m) ≪≫ₗ
      (quotientSpanEquivAdjoinRoot _).symm ≪≫ₗ hasseJetQuotientEquiv ha m

@[simp]
theorem hermiteJetEquiv_apply (f : degreeLT R (∑ i, m i)) :
    hermiteJetEquiv ha m f = hermiteJet a m f := by
  simp only [hermiteJetEquiv, LinearEquiv.trans_apply, AdjoinRoot.degreeLTEquiv_apply,
    LinearEquiv.coe_ofEq_apply]
  rw [← quotientSpanEquivAdjoinRoot_mk, LinearEquiv.symm_apply_apply,
    hasseJetQuotientEquiv_mk, hermiteJet_eq_hasseJet]

/-- The Hermite interpolation polynomial realizes the prescribed Hasse jet datum. -/
@[simp]
theorem hermiteJet_hermiteJetEquiv_symm (c : ∀ i, Fin (m i) → R) :
    hermiteJet a m ((hermiteJetEquiv ha m).symm c) = c := by
  rw [← hermiteJetEquiv_apply ha m, LinearEquiv.apply_symm_apply]

/-- Interpolation recovers a polynomial of degree below `∑ i, m i` from its Hasse jets. -/
@[simp]
theorem hermiteJetEquiv_symm_hermiteJet (f : degreeLT R (∑ i, m i)) :
    (hermiteJetEquiv ha m).symm (hermiteJet a m f) = f := by
  rw [LinearEquiv.symm_apply_eq, hermiteJetEquiv_apply]

/-- **Hermite interpolation** over a commutative ring: when the differences of the nodes are units,
the Hermite jet map on the polynomials of degree below `∑ i, m i` is bijective. -/
theorem hermiteJet_bijective_of_pairwise_isUnit_sub : Bijective (hermiteJet a m) :=
  _root_.funext (hermiteJetEquiv_apply ha m) ▸ (hermiteJetEquiv ha m).bijective

/-- The Hermite interpolation polynomial of the jet datum `c` has the Hasse jets `c`. -/
@[simp]
theorem eval_hasseDeriv_hermiteJetEquiv_symm (c : ∀ i, Fin (m i) → R) (i : ι) (k : Fin (m i)) :
    (hasseDeriv k ((hermiteJetEquiv ha m).symm c : R[X])).eval (a i) = c i k := by
  have h := congr_fun (congr_fun (hermiteJet_hermiteJetEquiv_symm ha m c) i) k
  rwa [hermiteJet_apply] at h

/-- The Hermite interpolation polynomial of a jet datum has degree below `∑ i, m i`. -/
theorem degree_hermiteJetEquiv_symm_lt (c : ∀ i, Fin (m i) → R) :
    ((hermiteJetEquiv ha m).symm c : R[X]).degree < (∑ i, m i : ℕ) :=
  mem_degreeLT.1 ((hermiteJetEquiv ha m).symm c).property

/-- The characteristic property of Hermite interpolation: the interpolation polynomial of the jet
datum `c` is the unique polynomial of degree below `∑ i, m i` whose Hasse jet of order `k < m i`
at `a i` is `c i k`. -/
theorem eq_hermiteJetEquiv_symm_iff {f : R[X]} {c : ∀ i, Fin (m i) → R} :
    f = (hermiteJetEquiv ha m).symm c ↔
      f.degree < (∑ i, m i : ℕ) ∧ ∀ i (k : Fin (m i)), (hasseDeriv k f).eval (a i) = c i k := by
  refine ⟨?_, fun ⟨hf, hc⟩ => ?_⟩
  · rintro rfl
    exact ⟨degree_hermiteJetEquiv_symm_lt ha m c, eval_hasseDeriv_hermiteJetEquiv_symm ha m c⟩
  · have hf' : f ∈ degreeLT R (∑ i, m i) := mem_degreeLT.2 hf
    rw [← Subtype.coe_mk f hf', Subtype.coe_inj, LinearEquiv.eq_symm_apply]
    ext i k
    rw [hermiteJetEquiv_apply, hermiteJet_apply]
    exact hc i k

/-- Every jet datum has a unique interpolating polynomial of degree below `∑ i, m i`, when the
differences of the nodes are units. -/
theorem existsUnique_hermite_interpolation_of_pairwise_isUnit_sub (c : ∀ i, Fin (m i) → R) :
    ∃! f : R[X], f ∈ degreeLT R (∑ i, m i) ∧
      ∀ i (k : Fin (m i)), (hasseDeriv k f).eval (a i) = c i k :=
  ⟨(hermiteJetEquiv ha m).symm c,
    ⟨((hermiteJetEquiv ha m).symm c).property, eval_hasseDeriv_hermiteJetEquiv_symm ha m c⟩,
    fun _ ⟨hf, hc⟩ => (eq_hermiteJetEquiv_symm_iff ha m).2 ⟨mem_degreeLT.1 hf, hc⟩⟩

/-- Hermite interpolation commutes with ring homomorphisms: the interpolation polynomial of the
image of a jet datum at the image nodes is the image of the interpolation polynomial. In
particular, for a field extension, the interpolation polynomial of data in the smaller field has
coefficients there. -/
theorem map_hermiteJetEquiv_symm [CommRing S] (ψ : R →+* S) (c : ∀ i, Fin (m i) → R) :
    ((hermiteJetEquiv ha m).symm c : R[X]).map ψ =
      (hermiteJetEquiv (a := ψ ∘ a)
        (fun _ _ hij => by simpa [← map_sub] using (ha hij).map ψ) m).symm
        fun i k => ψ (c i k) := by
  refine (eq_hermiteJetEquiv_symm_iff _ m).2
    ⟨degree_map_le.trans_lt (degree_hermiteJetEquiv_symm_lt ha m c), fun i k => ?_⟩
  rw [Function.comp_apply, hasseDeriv_map, eval_map, eval₂_hom,
    eval_hasseDeriv_hermiteJetEquiv_symm]

/-- The Hermite basis of the polynomials of degree below `∑ i, m i`, when the differences of the
nodes are units: the basis whose coordinates are the Hasse jets `(hasseDeriv k f).eval (a i)`. -/
def hermiteBasis : Module.Basis ((i : ι) × Fin (m i)) R (degreeLT R (∑ i, m i)) :=
  (Pi.basis fun i => Pi.basisFun R (Fin (m i))).map (hermiteJetEquiv ha m).symm

/-- Each Hermite basis polynomial interpolates a standard basis vector of the jet space. -/
theorem hermiteBasis_apply [DecidableEq ι] (x : (i : ι) × Fin (m i)) :
    hermiteBasis ha m x = (hermiteJetEquiv ha m).symm (Pi.single x.1 (Pi.single x.2 1)) := by
  simp only [hermiteBasis, Module.Basis.map_apply, Pi.basis_apply, Pi.basisFun_apply]

@[simp]
theorem hermiteBasis_repr (f : degreeLT R (∑ i, m i)) (x : (i : ι) × Fin (m i)) :
    (hermiteBasis ha m).repr f x = (hasseDeriv x.2 (f : R[X])).eval (a x.1) := by
  simp [hermiteBasis]

/-- The Hermite basis vector `b_{i, k}` has jet `1` at `(i, k)` and `0` elsewhere. -/
@[simp]
theorem hermiteJet_hermiteBasis [DecidableEq ι] (x : (i : ι) × Fin (m i)) :
    hermiteJet a m (hermiteBasis ha m x) =
      Pi.single (M := fun i => Fin (m i) → R) x.1 (Pi.single x.2 1) := by
  rw [hermiteBasis_apply, hermiteJet_hermiteJetEquiv_symm]

/-- The pointwise Hasse jets of the Hermite basis polynomials are the Kronecker deltas. -/
@[simp]
theorem eval_hasseDeriv_hermiteBasis [DecidableEq ι] (x : (i : ι) × Fin (m i)) (j : ι)
    (l : Fin (m j)) :
    (hasseDeriv l (hermiteBasis ha m x : R[X])).eval (a j) =
      if x = ⟨j, l⟩ then 1 else 0 := by
  rw [← hermiteBasis_repr ha m _ ⟨j, l⟩, Module.Basis.repr_self, Finsupp.single_apply]

/-- Every polynomial of degree below `∑ i, m i` is the combination of the Hermite basis with its
Hasse jets at the nodes as coefficients. -/
theorem sum_eval_hasseDeriv_smul_hermiteBasis {f : R[X]} (hf : f.degree < (∑ i, m i : ℕ)) :
    ∑ x : (i : ι) × Fin (m i),
      (hasseDeriv x.2 f).eval (a x.1) • (hermiteBasis ha m x : R[X]) = f := by
  simpa using congr_arg Subtype.val ((hermiteBasis ha m).sum_repr ⟨f, mem_degreeLT.2 hf⟩)

/-- Hermite interpolation with ordinary derivatives over a commutative ring: when the differences
of the nodes are units and `k !` is a unit for every order `k < m i`, the ordinary-derivative jet
map is bijective. -/
theorem ordinaryHermiteJet_bijective_of_pairwise_isUnit_sub
    (hm : ∀ i, ∀ k < m i, IsUnit (k ! : R)) : Bijective (ordinaryHermiteJet a m) := by
  let e : (∀ i, Fin (m i) → R) ≃ₗ[R] ∀ i, Fin (m i) → R :=
    LinearEquiv.piCongrRight fun i =>
      LinearEquiv.piCongrRight fun k => LinearEquiv.smulOfUnit (hm i k k.isLt).unit
  have h : ⇑(ordinaryHermiteJet a m) = ⇑e ∘ ⇑(hermiteJet a m) := by
    ext f i k
    rw [Function.comp_apply, ordinaryHermiteJet_eq_factorial_mul]
    simp [e, LinearEquiv.smulOfUnit, Units.smul_def]
  rw [h]
  exact e.bijective.comp (hermiteJet_bijective_of_pairwise_isUnit_sub ha m)

end CommRing

section NoZeroDivisors

variable [CommRing R] [NoZeroDivisors R] [Fintype ι] {a : ι → R}

/-- **The kernel of the jet map** over an integral domain: for injective nodes,
`∏ i, (X - C (a i)) ^ m i` divides `f` iff all Hasse jets `(hasseDeriv k f).eval (a i)` with
`k < m i` vanish. -/
theorem prod_X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero (ha : Injective a) (m : ι → ℕ)
    (f : R[X]) :
    (∏ i, (X - C (a i)) ^ m i) ∣ f ↔ ∀ i, ∀ k < m i, (hasseDeriv k f).eval (a i) = 0 := by
  nontriviality R
  let ψ := algebraMap R (FractionRing R)
  have hψ : Injective ψ := IsFractionRing.injective R (FractionRing R)
  rw [← map_dvd_map ψ hψ (monic_prod_X_sub_C_pow univ a m)]
  simp only [Polynomial.map_prod, Polynomial.map_pow, Polynomial.map_sub, map_X, map_C]
  rw [prod_X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero_of_pairwise_isUnit_sub
    (a := fun i => ψ (a i)) (fun _ _ hij => (sub_ne_zero.2 ((hψ.comp ha).ne hij)).isUnit) m]
  simp only [hasseDeriv_map, eval_map, eval₂_hom, map_eq_zero_iff _ hψ]

/-- Over an integral domain, for injective nodes, the Hasse jets of `f` vanish iff
`∏ i, (X - C (a i)) ^ m i` divides `f`. -/
theorem hasseJet_eq_zero_iff (ha : Injective a) (m : ι → ℕ) (f : R[X]) :
    hasseJet a m f = 0 ↔ (∏ i, (X - C (a i)) ^ m i) ∣ f :=
  (hasseJet_eq_zero_iff_forall a m f).trans
    (prod_X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero ha m f).symm

/-- Over an integral domain, for injective nodes, the kernel of the Hasse jet map is the ideal
generated by `∏ i, (X - C (a i)) ^ m i`. -/
theorem ker_hasseJet (ha : Injective a) (m : ι → ℕ) :
    LinearMap.ker (hasseJet a m) = (Ideal.span {∏ i, (X - C (a i)) ^ m i}).restrictScalars R := by
  ext f
  simp [Ideal.mem_span_singleton, hasseJet_eq_zero_iff ha m f]

/-- Over an integral domain, for injective nodes, the Hermite jet map is injective. -/
theorem hermiteJet_injective (ha : Injective a) (m : ι → ℕ) : Injective (hermiteJet a m) := by
  nontriviality R
  refine (injective_iff_map_eq_zero _).2 fun f hf => ?_
  have hdvd : (∏ i, (X - C (a i)) ^ m i) ∣ (f : R[X]) :=
    (hasseJet_eq_zero_iff ha m f).1 (hermiteJet_eq_hasseJet a m f ▸ hf)
  refine Subtype.ext (eq_zero_of_dvd_of_degree_lt hdvd ?_)
  rw [degree_eq_natDegree (monic_prod_X_sub_C_pow univ a m).ne_zero, natDegree_prod_X_sub_C_pow]
  exact mem_degreeLT.1 f.property

/-- Over an integral domain, for injective nodes, the ordinary-derivative jet map is injective when
`k ! ≠ 0` in `R` for every order `k < m i`. -/
theorem ordinaryHermiteJet_injective (ha : Injective a) (m : ι → ℕ)
    (hm : ∀ i, ∀ k < m i, (k ! : R) ≠ 0) : Injective (ordinaryHermiteJet a m) := by
  refine (injective_iff_map_eq_zero _).2 fun f hf => ?_
  refine (injective_iff_map_eq_zero _).1 (hermiteJet_injective ha m) f ?_
  ext i k
  have h := congr_fun (congr_fun hf i) k
  rw [ordinaryHermiteJet_eq_factorial_mul, Pi.zero_apply, Pi.zero_apply, mul_eq_zero] at h
  exact h.resolve_left (hm i k k.isLt)

end NoZeroDivisors

section Field

variable [Field K] [Fintype ι] {a : ι → K}

/-- **Hermite interpolation** over a field: for injective nodes and arbitrary multiplicities, the
Hermite jet map on the polynomials of degree below `∑ i, m i` is bijective. -/
theorem hermiteJet_bijective (ha : Injective a) (m : ι → ℕ) : Bijective (hermiteJet a m) :=
  hermiteJet_bijective_of_pairwise_isUnit_sub
    (fun _ _ hij => (sub_ne_zero.2 (ha.ne hij)).isUnit) m

/-- Every jet datum over a field with injective nodes has a unique interpolating polynomial of
degree below `∑ i, m i`. -/
theorem existsUnique_hermite_interpolation (ha : Injective a) (m : ι → ℕ)
    (c : ∀ i, Fin (m i) → K) :
    ∃! f : K[X], f ∈ degreeLT K (∑ i, m i) ∧
      ∀ i (k : Fin (m i)), (hasseDeriv k f).eval (a i) = c i k :=
  existsUnique_hermite_interpolation_of_pairwise_isUnit_sub
    (fun _ _ hij => (sub_ne_zero.2 (ha.ne hij)).isUnit) m c

/-- Over a field with injective nodes, when every `k !` with `k < m i` is a unit, the
ordinary-derivative jet map is bijective. -/
theorem ordinaryHermiteJet_bijective (ha : Injective a) (m : ι → ℕ)
    (hm : ∀ i, ∀ k < m i, IsUnit (k ! : K)) : Bijective (ordinaryHermiteJet a m) :=
  ordinaryHermiteJet_bijective_of_pairwise_isUnit_sub
    (fun _ _ hij => (sub_ne_zero.2 (ha.ne hij)).isUnit) m hm

end Field

/-! ### Checks -/

section Examples

/-- One node `c` of multiplicity `2`: `c₀ + c₁ X ↦ (c₀ + c₁ c, c₁)`. -/
example (c c₀ c₁ : ℚ) (h : C c₀ + C c₁ * X ∈ degreeLT ℚ (∑ i, ![2] i)) :
    hermiteJet ![c] ![2] ⟨_, h⟩ 0 ⟨0, by simp⟩ = c₀ + c₁ * c ∧
      hermiteJet ![c] ![2] ⟨_, h⟩ 0 ⟨1, by simp⟩ = c₁ := by
  rw [hermiteJet_apply, hermiteJet_apply]
  simp

/-- Simple nodes `0, 1`: `c₀ + c₁ X ↦ (c₀, c₀ + c₁)`, the values at the nodes. -/
example (c₀ c₁ : ℚ) (h : C c₀ + C c₁ * X ∈ degreeLT ℚ (∑ i, ![1, 1] i)) :
    hermiteJet ![0, 1] ![1, 1] ⟨_, h⟩ 0 ⟨0, by simp⟩ = c₀ ∧
      hermiteJet ![0, 1] ![1, 1] ⟨_, h⟩ 1 ⟨0, by simp⟩ = c₀ + c₁ := by
  rw [hermiteJet_apply, hermiteJet_apply]
  simp

/-- No nodes: the map from the zero space to the one-point space is bijective. -/
example : Bijective (hermiteJet (![] : Fin 0 → ℚ) ![]) :=
  hermiteJet_bijective (injective_of_subsingleton _) _

/-- A repeated node: `X ↦ (0, 0)`, so injectivity of the nodes is necessary. -/
example : ¬ Injective (hermiteJet ![(0 : ℚ), 0] ![1, 1]) := by
  intro h
  have hX : (X : ℚ[X]) ∈ degreeLT ℚ (∑ i, ![1, 1] i) := by
    simp [mem_degreeLT]
  refine X_ne_zero (congrArg Subtype.val (@h ⟨X, hX⟩ 0 ?_))
  ext i k
  rw [hermiteJet_apply, map_zero, Pi.zero_apply, Pi.zero_apply]
  fin_cases i <;> fin_cases k <;> simp

/-- A node of multiplicity `0` contributes nothing: at `(5, 0)` with multiplicities `(0, 3)`, the
jets at `0` read off the coefficients of `c₀ + c₁ X + c₂ X²`. -/
example (c₀ c₁ c₂ : ℚ)
    (h : C c₀ + C c₁ * X + C c₂ * X ^ 2 ∈ degreeLT ℚ (∑ i, ![0, 3] i)) :
    hermiteJet ![5, 0] ![0, 3] ⟨_, h⟩ 1 ⟨0, by simp⟩ = c₀ ∧
      hermiteJet ![5, 0] ![0, 3] ⟨_, h⟩ 1 ⟨1, by simp⟩ = c₁ ∧
      hermiteJet ![5, 0] ![0, 3] ⟨_, h⟩ 1 ⟨2, by simp⟩ = c₂ := by
  rw [hermiteJet_apply, hermiteJet_apply, hermiteJet_apply]
  simp only [Matrix.cons_val_one, Matrix.cons_val_zero, ← taylor_coeff, taylor_zero']
  simp

/-- In characteristic `2` the ordinary jet of order `2` of `X²` at `0` vanishes, while the Hasse
jet is `1`. -/
example (h : (X ^ 2 : (ZMod 2)[X]) ∈ degreeLT (ZMod 2) (∑ i, ![3] i)) :
    ordinaryHermiteJet ![0] ![3] ⟨_, h⟩ 0 ⟨2, by simp⟩ = 0 ∧
      hermiteJet ![0] ![3] ⟨_, h⟩ 0 ⟨2, by simp⟩ = 1 := by
  refine ⟨?_, ?_⟩
  · rw [ordinaryHermiteJet_eq_factorial_mul]
    exact zero_mul _
  · rw [hermiteJet_apply]
    simpa using eval_hasseDeriv_X_sub_C_pow (0 : ZMod 2) 2 2

/-- In characteristic `2` the ordinary jet map with one node of multiplicity `3` is not injective:
it kills `X²`, so the unit hypothesis on the factorials is necessary. -/
example : ¬ Injective (ordinaryHermiteJet ![(0 : ZMod 2)] ![3]) := by
  intro h
  have hX : (X ^ 2 : (ZMod 2)[X]) ∈ degreeLT (ZMod 2) (∑ i, ![3] i) := by
    rw [mem_degreeLT]
    compute_degree!
  have h0 : (X ^ 2 : (ZMod 2)[X]) = 0 := by
    refine congrArg Subtype.val (@h ⟨_, hX⟩ 0 ?_)
    ext i k
    rw [ordinaryHermiteJet_apply, map_zero, Pi.zero_apply, Pi.zero_apply]
    fin_cases i
    fin_cases k <;> simp [CharTwo.add_self_eq_zero]
  have := congrArg (fun p : (ZMod 2)[X] => p.coeff 2) h0
  simp only [coeff_X_pow_self, coeff_zero] at this
  exact absurd this (by decide)

/-- `X² ∤ X`: the jet of order `1` of `X` at `0` is `1`. -/
example : ¬ (∏ i : Fin 1, (X - C (![(0 : ℚ)] i)) ^ ![2] i) ∣ X := by
  rw [prod_X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero (injective_of_subsingleton _)]
  intro h
  simpa [hasseDeriv_one'] using h 0 1 (by simp)

/-- `X (X - 1) ∣ X² - X` over `ℤ`. -/
example : (∏ i : Fin 2, (X - C (![(0 : ℤ), 1] i)) ^ ![1, 1] i) ∣ X ^ 2 - X := by
  rw [prod_X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero (by decide)]
  intro i k hk
  fin_cases i <;> simp_all

/-- Worked example over `ℤ`: since `1 - 0 = 1` is a unit in `ℤ`, Hermite interpolation holds over
`ℤ` itself, and `1 - X²` is the unique polynomial of degree below `3` with `f(0) = 1`, `f'(0) = 0`,
and `f(1) = 0`. -/
example (f : ℤ[X]) (hf : f ∈ degreeLT ℤ 3) (h₀ : f.eval 0 = 1) (h₁ : (derivative f).eval 0 = 0)
    (h₂ : f.eval 1 = 0) : f = 1 - X ^ 2 := by
  have ha : Pairwise fun i j : Fin 2 => IsUnit (![(0 : ℤ), 1] i - ![(0 : ℤ), 1] j) := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all
  have hM : ∑ i, ![2, 1] i = 3 := rfl
  have hg : (1 - X ^ 2 : ℤ[X]) ∈ degreeLT ℤ (∑ i, ![2, 1] i) := by
    rw [hM, mem_degreeLT]
    compute_degree!
  refine congrArg Subtype.val ((hermiteJet_bijective_of_pairwise_isUnit_sub ha ![2, 1]).1
    (a₁ := ⟨f, hM ▸ hf⟩) (a₂ := ⟨_, hg⟩) ?_)
  ext i k
  rw [hermiteJet_apply, hermiteJet_apply]
  fin_cases i <;> fin_cases k <;> simp [h₀, h₁, h₂]

/-- Over `ℤ`, injectivity holds even when node differences are not units (such as `0` and `2`). -/
example : Injective (hermiteJet ![(0 : ℤ), 2] ![1, 1]) :=
  hermiteJet_injective (by decide) ![1, 1]

end Examples

end TauCeti
