/-!
# Hermite interpolation

For nodes `a : ι → K` and multiplicities `m : ι → ℕ` with `M = ∑ i, m i`, the Hermite jet map
sends a polynomial of degree below `M` to its Hasse jets `D^[k] f (a i)` for `k < m i`. Over a
field with distinct nodes it is a linear equivalence, in every characteristic: the inverse sends
a jet datum to its Hermite interpolation polynomial. The kernel of the unrestricted jet map is the
ideal generated by `P = ∏ i, (X - C (a i)) ^ m i`, and the jet map factors through the
Chinese remainder isomorphism `K[X] ⧸ (P) ≃ ∏ i, K[X] ⧸ ((X - C (a i)) ^ m i)` followed by the
local Taylor coordinates `TauCeti.taylorJetQuotientEquiv`.

## Main definitions

* `TauCeti.hermiteJet a m : degreeLT R M →ₗ[R] (i : ι) → Fin (m i) → R`.
* `TauCeti.hermiteModulus a m = ∏ i, (X - C (a i)) ^ m i`.
* `TauCeti.hermiteQuotientEquiv`: the Chinese remainder isomorphism
  `K[X] ⧸ (P) ≃+* ∀ i, K[X] ⧸ ((X - C (a i)) ^ m i)`.
* `TauCeti.hermiteJetEquiv m ha` and the dual basis `TauCeti.hermiteBasis m ha`.
* `TauCeti.ordinaryHermiteJet a m`, the jets `D^k f (a i)` built from ordinary derivatives.

## Main statements

* `TauCeti.hermiteModulus_dvd_iff_forall_eval_hasseDeriv_eq_zero`: for distinct nodes, `P ∣ f`
  iff the jets `D^[k] f (a i)` with `k < m i` all vanish; this admits `f = 0`.
* `TauCeti.hermiteJet_eq_taylorJetQuotientEquiv`: the Hermite jet map is the projection to
  `K[X] ⧸ (P)`, followed by the Chinese remainder isomorphism and the local Taylor coordinates.
* `TauCeti.hermiteJet_bijective` and `TauCeti.existsUnique_hermite_interpolation`.
* `TauCeti.sum_hermiteJet_smul_hermiteBasis`: `f = ∑_{i,k} D^[k] f (a i) • b_{i,k}`.
* `TauCeti.hermiteJet_map` and `TauCeti.hermiteJetEquiv_symm_map`: naturality under a change
  of coefficients; the interpolation polynomial of `K`-valued data has coefficients in `K`.
* `TauCeti.ordinaryHermiteJet_bijective`: when `k !` is a unit for every `k < m i`.

## References

* H. Iwaniec and E. Kowalski, *Analytic Number Theory*, Lemma 11.16 and the remark on Taylor
  coefficients, pp. 282–284.
-/

public section

noncomputable section

open Finset Function Polynomial

namespace TauCeti

section CommRing

variable {R S : Type*} [CommRing R] [CommRing S] {ι : Type*} [Fintype ι]

/-- The Hermite jet map `f ↦ (D^[k] f (a i))_{i, k < m i}` on polynomials of degree below
`∑ i, m i`. -/
def hermiteJet (a : ι → R) (m : ι → ℕ) :
    degreeLT R (∑ i, m i) →ₗ[R] (i : ι) → Fin (m i) → R :=
  (LinearMap.pi fun i => taylorJet (a i) (m i)) ∘ₗ (degreeLT R (∑ i, m i)).subtype

@[simp]
theorem hermiteJet_apply (a : ι → R) (m : ι → ℕ) (f : degreeLT R (∑ i, m i)) (i : ι)
    (k : Fin (m i)) : hermiteJet a m f i k = (hasseDeriv k (f : R[X])).eval (a i) := by
  simp [hermiteJet]

/-- The Hermite modulus `∏ i, (X - C (a i)) ^ m i`. -/
def hermiteModulus (a : ι → R) (m : ι → ℕ) : R[X] :=
  ∏ i, (X - C (a i)) ^ m i

theorem hermiteModulus_def (a : ι → R) (m : ι → ℕ) :
    hermiteModulus a m = ∏ i, (X - C (a i)) ^ m i := by
  rw [hermiteModulus]

/-- The Hermite modulus is monic. -/
theorem monic_hermiteModulus (a : ι → R) (m : ι → ℕ) : (hermiteModulus a m).Monic :=
  monic_prod_of_monic _ _ fun i _ => (monic_X_sub_C (a i)).pow (m i)

/-- The Hermite modulus has degree `∑ i, m i`. -/
theorem natDegree_hermiteModulus [Nontrivial R] (a : ι → R) (m : ι → ℕ) :
    (hermiteModulus a m).natDegree = ∑ i, m i := by
  rw [hermiteModulus_def, natDegree_prod_of_monic _ _ fun i _ => (monic_X_sub_C (a i)).pow (m i)]
  simp [(monic_X_sub_C _).natDegree_pow]

/-- The Hermite jet map commutes with a change of coefficients. -/
theorem hermiteJet_map (φ : R →+* S) (a : ι → R) (m : ι → ℕ) (f : degreeLT R (∑ i, m i)) :
    hermiteJet (φ ∘ a) m ⟨(f : R[X]).map φ, map_mem_degreeLT φ f.2⟩ =
      fun i k => φ (hermiteJet a m f i k) := by
  ext i k
  rw [hermiteJet_apply, hermiteJet_apply]
  exact (congrArg (Polynomial.eval (φ (a i))) (hasseDeriv_map φ k (f : R[X]))).trans
    ((eval_map _ _).trans (eval₂_hom _ _))

/-- The jet map built from ordinary derivatives, `f ↦ (D^k f (a i))_{i, k < m i}`. -/
def ordinaryHermiteJet (a : ι → R) (m : ι → ℕ) :
    degreeLT R (∑ i, m i) →ₗ[R] (i : ι) → Fin (m i) → R :=
  LinearMap.pi fun i => LinearMap.pi fun k =>
    leval (a i) ∘ₗ (derivative ^ (k : ℕ)) ∘ₗ (degreeLT R (∑ i, m i)).subtype

/-- The coordinates of the ordinary jet map are the iterated derivatives at the nodes. -/
@[simp]
theorem ordinaryHermiteJet_apply (a : ι → R) (m : ι → ℕ) (f : degreeLT R (∑ i, m i)) (i : ι)
    (k : Fin (m i)) :
    ordinaryHermiteJet a m f i k = (derivative^[k] (f : R[X])).eval (a i) := by
  simp [ordinaryHermiteJet, pow_apply_eq_iterate]

open scoped Nat in
/-- The ordinary jets are the Hasse jets scaled by `k !`. -/
theorem ordinaryHermiteJet_eq_factorial_mul (a : ι → R) (m : ι → ℕ) (f : degreeLT R (∑ i, m i))
    (i : ι) (k : Fin (m i)) :
    ordinaryHermiteJet a m f i k = (k ! : R) * hermiteJet a m f i k := by
  rw [ordinaryHermiteJet_apply, ← factorial_smul_hasseDeriv]
  simp [nsmul_eq_mul]

end CommRing

section Field

variable {K L : Type*} [Field K] [Field L] {ι : Type*} [Fintype ι] {a : ι → K} {m : ι → ℕ}

/-- **Multiplicity criterion.** For distinct nodes, `∏ i, (X - C (a i)) ^ m i` divides `f` if and
only if all Hasse jets `D^[k] f (a i)` with `k < m i` vanish. -/
theorem hermiteModulus_dvd_iff_forall_eval_hasseDeriv_eq_zero (ha : Injective a) (m : ι → ℕ)
    (f : K[X]) : hermiteModulus a m ∣ f ↔ ∀ i, ∀ k < m i, (hasseDeriv k f).eval (a i) = 0 := by
  simp_rw [← X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero]
  refine ⟨fun h i => (Finset.dvd_prod_of_mem _ (Finset.mem_univ i)).trans h,
    fun h => Finset.prod_dvd_of_coprime ?_ fun i _ => h i⟩
  exact fun i _ j _ hij => ((pairwise_coprime_X_sub_C ha hij).pow)

/-- For distinct nodes the ideal of the Hermite modulus is the intersection of the ideals of its
factors. -/
theorem span_hermiteModulus (ha : Injective a) (m : ι → ℕ) :
    Ideal.span {hermiteModulus a m} = ⨅ i, Ideal.span {(X - C (a i)) ^ m i} :=
  (Ideal.iInf_span_singleton fun _ _ hij => (pairwise_coprime_X_sub_C ha hij).pow).symm

/-- **Chinese remainder theorem** for the Hermite modulus. -/
def hermiteQuotientEquiv (ha : Injective a) (m : ι → ℕ) :
    K[X] ⧸ Ideal.span {hermiteModulus a m} ≃+*
      ((i : ι) → K[X] ⧸ Ideal.span {(X - C (a i)) ^ m i}) :=
  (Ideal.quotEquivOfEq (span_hermiteModulus ha m)).trans <|
    Ideal.quotientInfRingEquivPiQuotient _ fun _ _ hij =>
      (Ideal.isCoprime_span_singleton_iff _ _).2 (pairwise_coprime_X_sub_C ha hij).pow

@[simp]
theorem hermiteQuotientEquiv_mk (ha : Injective a) (m : ι → ℕ) (f : K[X]) (i : ι) :
    hermiteQuotientEquiv ha m (Ideal.Quotient.mk _ f) i = Ideal.Quotient.mk _ f := by
  rw [hermiteQuotientEquiv, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk]
  exact Ideal.quotientInfRingEquivPiQuotient_mk_apply _ _ _

/-- The Hermite jet map is the composite of the projection to `K[X] ⧸ (P)`, the Chinese remainder
isomorphism and the local Taylor coordinates. -/
theorem hermiteJet_eq_taylorJetQuotientEquiv (ha : Injective a) (f : degreeLT K (∑ i, m i))
    (i : ι) :
    hermiteJet a m f i =
      taylorJetQuotientEquiv (a i) (m i) (hermiteQuotientEquiv ha m (Ideal.Quotient.mk _ f) i) := by
  rw [hermiteQuotientEquiv_mk, taylorJetQuotientEquiv_mk]
  ext k
  simp

/-- For distinct nodes the Hermite jet map is injective. -/
theorem hermiteJet_injective (ha : Injective a) (m : ι → ℕ) : Injective (hermiteJet a m) := by
  refine (injective_iff_map_eq_zero _).2 fun f hf => ?_
  have hdvd : hermiteModulus a m ∣ (f : K[X]) :=
    (hermiteModulus_dvd_iff_forall_eval_hasseDeriv_eq_zero ha m f).2 fun i k hk => by
      simpa using congr_fun (congr_fun hf i) ⟨k, hk⟩
  refine Subtype.ext (eq_zero_of_dvd_of_degree_lt hdvd ?_)
  rw [degree_eq_natDegree (monic_hermiteModulus a m).ne_zero, natDegree_hermiteModulus]
  exact mem_degreeLT.1 f.2

/-- The source and the target of the Hermite jet map have the same dimension. -/
theorem finrank_degreeLT_eq_finrank_pi (m : ι → ℕ) :
    Module.finrank K (degreeLT K (∑ i, m i)) = Module.finrank K ((i : ι) → Fin (m i) → K) := by
  simp [(degreeLTEquiv K _).finrank_eq, Module.finrank_pi_fintype]


/-- **Hermite interpolation.** For distinct nodes the Hermite jet map is bijective. -/
theorem hermiteJet_bijective (ha : Injective a) (m : ι → ℕ) : Bijective (hermiteJet a m) :=
  ⟨hermiteJet_injective ha m, (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (finrank_degreeLT_eq_finrank_pi m)).1 (hermiteJet_injective ha m)⟩

/-- The Hermite jet map as a linear equivalence; its inverse sends a jet datum to its Hermite
interpolation polynomial. -/
def hermiteJetEquiv (m : ι → ℕ) (ha : Injective a) :
    degreeLT K (∑ i, m i) ≃ₗ[K] (i : ι) → Fin (m i) → K :=
  LinearEquiv.ofBijective _ (hermiteJet_bijective ha m)

@[simp]
theorem hermiteJetEquiv_apply (m : ι → ℕ) (ha : Injective a) (f : degreeLT K (∑ i, m i)) :
    hermiteJetEquiv m ha f = hermiteJet a m f :=
  LinearEquiv.ofBijective_apply _ _

/-- The Hermite interpolation polynomial of a jet datum has that datum as its jets. -/
@[simp]
theorem hermiteJet_hermiteJetEquiv_symm (m : ι → ℕ) (ha : Injective a)
    (c : (i : ι) → Fin (m i) → K) : hermiteJet a m ((hermiteJetEquiv m ha).symm c) = c :=
  (hermiteJetEquiv m ha).apply_symm_apply c

/-- Every jet datum has a unique interpolating polynomial of degree below `∑ i, m i`. -/
theorem existsUnique_hermite_interpolation (ha : Injective a) (c : (i : ι) → Fin (m i) → K) :
    ∃! f : K[X], f ∈ degreeLT K (∑ i, m i) ∧
      ∀ i (k : Fin (m i)), (hasseDeriv k f).eval (a i) = c i k := by
  refine ⟨(hermiteJetEquiv m ha).symm c, ⟨Submodule.coe_mem _, fun i k => ?_⟩, ?_⟩
  · simpa using congr_fun (congr_fun (hermiteJet_hermiteJetEquiv_symm m ha c) i) k
  · rintro g ⟨hg, hgc⟩
    have : (⟨g, hg⟩ : degreeLT K (∑ i, m i)) = (hermiteJetEquiv m ha).symm c :=
      (hermiteJetEquiv m ha).eq_symm_apply.2 <| funext fun i => funext fun k => by
        simpa using hgc i k
    exact congrArg Subtype.val this

/-- The basis of `degreeLT K (∑ i, m i)` dual to the Hermite jet coordinates. -/
def hermiteBasis (m : ι → ℕ) (ha : Injective a) :
    Module.Basis ((i : ι) × Fin (m i)) K (degreeLT K (∑ i, m i)) :=
  (Pi.basis fun i => Pi.basisFun K (Fin (m i))).map (hermiteJetEquiv m ha).symm

@[simp]
theorem hermiteBasis_repr (m : ι → ℕ) (ha : Injective a) (f : degreeLT K (∑ i, m i))
    (x : (i : ι) × Fin (m i)) : (hermiteBasis m ha).repr f x = hermiteJet a m f x.1 x.2 := by
  simp [hermiteBasis]

/-- The Hermite basis vector `b_{i,k}` has jet `1` at `(i, k)` and `0` elsewhere. -/
@[simp]
theorem hermiteJet_hermiteBasis [DecidableEq ι] (m : ι → ℕ) (ha : Injective a)
    (x : (i : ι) × Fin (m i)) :
    hermiteJet a m (hermiteBasis m ha x) =
      Pi.single (M := fun i => Fin (m i) → K) x.1 (Pi.single x.2 1) := by
  rw [← hermiteJetEquiv_apply m ha, hermiteBasis, Module.Basis.map_apply,
    LinearEquiv.apply_symm_apply]
  simp

/-- Expansion of a polynomial of degree below `∑ i, m i` in the Hermite basis. -/
theorem sum_hermiteJet_smul_hermiteBasis (m : ι → ℕ) (ha : Injective a)
    (f : degreeLT K (∑ i, m i)) :
    ∑ x, hermiteJet a m f x.1 x.2 • hermiteBasis m ha x = f := by
  simpa using (hermiteBasis m ha).sum_repr f

/-- The interpolation polynomial of `K`-valued data at `K`-rational nodes is the same over a field
extension: it has coefficients in `K`. -/
theorem hermiteJetEquiv_symm_map (m : ι → ℕ) (ha : Injective a) (φ : K →+* L)
    (c : (i : ι) → Fin (m i) → K) :
    ((hermiteJetEquiv m (φ.injective.comp ha)).symm (fun i k => φ (c i k)) : L[X]) =
      ((hermiteJetEquiv m ha).symm c : K[X]).map φ := by
  set f := (hermiteJetEquiv m ha).symm c
  have hf : hermiteJet a m f = c := hermiteJet_hermiteJetEquiv_symm m ha c
  have h : hermiteJetEquiv m (φ.injective.comp ha)
      ⟨(f : K[X]).map φ, map_mem_degreeLT φ f.2⟩ = fun i k => φ (c i k) := by
    rw [hermiteJetEquiv_apply, hermiteJet_map, hf]
  rw [← h, LinearEquiv.symm_apply_apply]

open scoped Nat in
/-- When every `k !` with `k < m i` is a unit, the ordinary-derivative jet map is bijective. -/
theorem ordinaryHermiteJet_bijective (ha : Injective a) (m : ι → ℕ)
    (hm : ∀ i, ∀ k < m i, IsUnit (k ! : K)) : Bijective (ordinaryHermiteJet a m) := by
  have hinj : Injective (ordinaryHermiteJet a m) := by
    refine (injective_iff_map_eq_zero _).2 fun f hf => hermiteJet_injective ha m ?_
    ext i k
    have := congr_fun (congr_fun hf i) k
    rw [ordinaryHermiteJet_eq_factorial_mul] at this
    simpa using (hm i k k.2).mul_right_eq_zero.1 this
  exact ⟨hinj, (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (finrank_degreeLT_eq_finrank_pi m)).1 hinj⟩

end Field

/-! ### Checks -/

section Examples

/-- One node `c` of multiplicity `2`: `c₀ + c₁ X ↦ (c₀ + c₁ c, c₁)`. -/
example (c c₀ c₁ : ℚ) (h : C c₀ + C c₁ * X ∈ degreeLT ℚ (∑ i, ![2] i)) :
    hermiteJet ![c] ![2] ⟨_, h⟩ 0 ⟨0, by simp⟩ = c₀ + c₁ * c ∧
      hermiteJet ![c] ![2] ⟨_, h⟩ 0 ⟨1, by simp⟩ = c₁ := by
  rw [hermiteJet_apply, hermiteJet_apply]
  simp

/-- Simple nodes `0, 1`: `c₀ + c₁ X ↦ (c₀, c₀ + c₁)`, the values at the nodes. -/
example (c₀ c₁ : ℚ) (h : C c₀ + C c₁ * X ∈ degreeLT ℚ (∑ i, ![1, 1] i)) :
    hermiteJet ![0, 1] ![1, 1] ⟨_, h⟩ 0 ⟨0, by simp⟩ = c₀ ∧
      hermiteJet ![0, 1] ![1, 1] ⟨_, h⟩ 1 ⟨0, by simp⟩ = c₀ + c₁ := by
  rw [hermiteJet_apply, hermiteJet_apply]
  simp

/-- No nodes: the map from the zero space to the one-point space is bijective. -/
example : Bijective (hermiteJet (![] : Fin 0 → ℚ) ![]) :=
  hermiteJet_bijective (injective_of_subsingleton _) _

/-- A repeated node: `X ↦ (0, 0)`, so injectivity of the nodes is necessary. -/
example : ¬ Injective (hermiteJet ![(0 : ℚ), 0] ![1, 1]) := by
  intro h
  have hX : (X : ℚ[X]) ∈ degreeLT ℚ (∑ i, ![1, 1] i) := by
    simp [mem_degreeLT]
  refine X_ne_zero (congrArg Subtype.val (@h ⟨X, hX⟩ 0 ?_))
  ext i k
  rw [hermiteJet_apply, map_zero, Pi.zero_apply, Pi.zero_apply]
  fin_cases i <;> fin_cases k <;> simp

/-- In characteristic `2` the ordinary jet of order `2` of `X²` at `0` vanishes, while the Hasse
jet is `1`. -/
example (h : (X ^ 2 : (ZMod 2)[X]) ∈ degreeLT (ZMod 2) (∑ i, ![3] i)) :
    ordinaryHermiteJet ![0] ![3] ⟨_, h⟩ 0 ⟨2, by simp⟩ = 0 ∧
      hermiteJet ![0] ![3] ⟨_, h⟩ 0 ⟨2, by simp⟩ = 1 := by
  refine ⟨?_, ?_⟩
  · rw [ordinaryHermiteJet_eq_factorial_mul]
    exact zero_mul _
  · rw [hermiteJet_apply]
    simpa using eval_hasseDeriv_X_sub_C_pow (0 : ZMod 2) 2 2

/-- In characteristic `2` the ordinary jet map with one node of multiplicity `3` is not injective:
it kills `X²`, so the unit hypothesis on the factorials is necessary. -/
example : ¬ Injective (ordinaryHermiteJet ![(0 : ZMod 2)] ![3]) := by
  intro h
  have hX : (X ^ 2 : (ZMod 2)[X]) ∈ degreeLT (ZMod 2) (∑ i, ![3] i) := by
    rw [mem_degreeLT]
    compute_degree!
  have h0 : (X ^ 2 : (ZMod 2)[X]) = 0 := by
    refine congrArg Subtype.val (@h ⟨_, hX⟩ 0 ?_)
    ext i k
    rw [ordinaryHermiteJet_apply, map_zero, Pi.zero_apply, Pi.zero_apply]
    fin_cases i
    fin_cases k <;> simp [CharTwo.add_self_eq_zero]
  have := congrArg (fun p : (ZMod 2)[X] => p.coeff 2) h0
  simp only [coeff_X_pow_self, coeff_zero] at this
  exact absurd this (by decide)

/-- `X² ∤ X`: the jet of order `1` of `X` at `0` is `1`. -/
example : ¬ hermiteModulus ![(0 : ℚ)] ![2] ∣ X := by
  rw [hermiteModulus_dvd_iff_forall_eval_hasseDeriv_eq_zero (injective_of_subsingleton _)]
  intro h
  simpa [hasseDeriv_one'] using h 0 1 (by simp)

/-- `X (X - 1) ∣ X² - X`. -/
example : hermiteModulus ![(0 : ℚ), 1] ![1, 1] ∣ X ^ 2 - X := by
  rw [hermiteModulus_dvd_iff_forall_eval_hasseDeriv_eq_zero (by decide)]
  intro i k hk
  fin_cases i <;> simp_all

/-- Worked example: `1 - X²` is the only polynomial of degree below `3` with `f(0) = 1`,
`f'(0) = 0` and `f(1) = 0`. -/
example (f : ℚ[X]) (hf : f ∈ degreeLT ℚ 3) (h₀ : f.eval 0 = 1) (h₁ : (derivative f).eval 0 = 0)
    (h₂ : f.eval 1 = 0) : f = 1 - X ^ 2 := by
  have hM : ∑ i, ![2, 1] i = 3 := rfl
  have hg : (1 - X ^ 2 : ℚ[X]) ∈ degreeLT ℚ (∑ i, ![2, 1] i) := by
    rw [hM, mem_degreeLT]
    compute_degree!
  refine congrArg Subtype.val (hermiteJet_injective (a := ![(0 : ℚ), 1]) (by decide) ![2, 1]
    (a₁ := ⟨f, hM ▸ hf⟩) (a₂ := ⟨_, hg⟩) ?_)
  ext i k
  rw [hermiteJet_apply, hermiteJet_apply]
  fin_cases i <;> fin_cases k <;> simp [h₀, h₁, h₂]

end Examples

end TauCeti
