module

public import Mathlib.Topology.CompactOpen
public import Mathlib.Topology.Convenient.HomSpace
public import Mathlib.Topology.Homeomorph.Lemmas

/-!
# Products with locally compact spaces and compact-open comparisons for generated spaces

`TopCat` fails to be cartesian closed because quotient maps need not be preserved by products with
non-locally-compact spaces and compact-open evaluation fails to be continuous in general. Spaces
generated by `X : ι → Type u` repair this by refining binary products to
`WithGeneratedByTopology X (Y × Z)` and mapping spaces to
`WithGeneratedByTopology X (ContinuousMapGeneratedBy X Y T)`.

When every `X i` is locally compact and every `X i × X j` is `X`-generated:
* `Y × Z` of `X`-generated spaces is already `X`-generated when one factor is locally compact
  (`Topology.IsGeneratedBy.prod_of_locallyCompactSpace_left` and `right`), making the counit a
  homeomorphism (`Topology.WithGeneratedByTopology.prodHomeomorphOfLocallyCompactLeft` and `Right`).
* `Topology.ContinuousMapGeneratedBy X Y T` is compared with `C(Y, T)` via
  `ContinuousMap.toContinuousMapGeneratedBy`, `equivContinuousMap`, and
  `Topology.ContinuousMapGeneratedBy.generatedByHomeomorphContinuousMap`.

## References

* R. H. Fox, *On topologies for function spaces*, Bull. Amer. Math. Soc. 51 (1945), 429–432.
* J. H. C. Whitehead, *Note on a theorem due to Borsuk*, Bull. Amer. Math. Soc. 54 (1948),
  1125–1132.
* R. M. Vogt, *Convenient categories of topological spaces for homotopy theory*, Arch. Math.
  (Basel) 22 (1971), 545–555.
* M. Escardó, J. Lawson and A. Simpson, *Comparing Cartesian closed categories of (core) compactly
  generated spaces*, Topology Appl. 143 (2004), 105–145.
-/

public section

universe t u v v' v''

open Topology

section Product

variable {ι : Type t} (X : ι → Type u) [∀ i, TopologicalSpace (X i)]

namespace Topology.IsGeneratedBy

/-- The canonical evaluation map from the disjoint union of all continuous test maps `X i → Y`
into `Y`. -/
def sigmaEval (Y : Type v) [TopologicalSpace Y] (p : (f : (i : ι) × C(X i, Y)) × X f.1) : Y :=
  p.1.2 p.2

theorem sigmaEval_def (Y : Type v) [TopologicalSpace Y] :
    sigmaEval X Y = fun p : (f : (i : ι) × C(X i, Y)) × X f.1 ↦ p.1.2 p.2 := (rfl)
@[simp] theorem sigmaEval_apply {Y : Type v} [TopologicalSpace Y] (i : ι) (f : C(X i, Y))
    (x : X i) : sigmaEval X Y ⟨⟨i, f⟩, x⟩ = f x := (rfl)

/-- The canonical evaluation map out of the sigma space of continuous test maps is continuous. -/
@[continuity, fun_prop] theorem continuous_sigmaEval (Y : Type v) [TopologicalSpace Y] :
    Continuous (sigmaEval X Y) := continuous_sigma fun ⟨_, f⟩ ↦ f.continuous

/-- For an `X`-generated space `Y`, `sigmaEval X Y` coinduces the topology of `Y`. -/
theorem isCoinducing_sigmaEval (Y : Type v) [TopologicalSpace Y] [IsGeneratedBy X Y] :
    IsCoinducing (sigmaEval X Y) where
  eq_coinduced := (generatedBy_eq (X := X) (Y := Y)).symm.trans <|
    (TopologicalSpace.generatedBy_eq_coinduced X).trans <| by rw [sigmaEval_def]

/-- When at least one test space `X i` is nonempty, `sigmaEval X Y` is surjective. -/
theorem sigmaEval_surjective (Y : Type v) [TopologicalSpace Y] (hX : ∃ i, Nonempty (X i)) :
    Function.Surjective (sigmaEval X Y) := by
  obtain ⟨i₀, ⟨x₀⟩⟩ := hX; exact fun y ↦ ⟨⟨⟨i₀, ContinuousMap.const (X i₀) y⟩, x₀⟩, rfl⟩

/-- When at least one test space `X i` is nonempty and `Y` is `X`-generated, `sigmaEval X Y` is a
quotient map. -/
theorem isQuotientMap_sigmaEval (Y : Type v) [TopologicalSpace Y] [IsGeneratedBy X Y]
    (hX : ∃ i, Nonempty (X i)) : IsQuotientMap (sigmaEval X Y) :=
  ⟨isCoinducing_sigmaEval X Y, sigmaEval_surjective X Y hX⟩

/-- When every test space `X i` is empty, every `X`-generated space carries the discrete
topology. -/
theorem discreteTopology_of_forall_isEmpty {Y : Type v} [TopologicalSpace Y] [IsGeneratedBy X Y]
    (hX : ∀ i, IsEmpty (X i)) : DiscreteTopology Y :=
  discreteTopology_iff_forall_isOpen.2 fun U ↦ (isOpen_iff X).2 fun i f ↦ by
    have := hX i; rw [Set.eq_empty_of_isEmpty (f ⁻¹' U)]; exact isOpen_empty

variable {X}

/-- **Whitehead product theorem for generated spaces (left locally compact factor).**
Suppose every test space `X i` is locally compact and every pairwise product `X i × X j` is
`X`-generated. If `Y` and `Z` are `X`-generated and `Y` is locally compact, then the ordinary
product `Y × Z` is `X`-generated. -/
theorem prod_of_locallyCompactSpace_left
    [∀ i, LocallyCompactSpace (X i)] [∀ i j, IsGeneratedBy X (X i × X j)]
    {Y : Type v} [TopologicalSpace Y] [IsGeneratedBy X Y] [LocallyCompactSpace Y]
    {Z : Type v'} [TopologicalSpace Z] [IsGeneratedBy X Z] : IsGeneratedBy X (Y × Z) := by
  by_cases hX : ∃ i, Nonempty (X i)
  · constructor
    have htest : ∀ (i : ι) (f : C(X i, Y)) (j : ι) (g : C(X j, Z)), Continuous (fun p : X i × X j ↦
        (WithGeneratedByTopology.equiv (X := X) (Y := Y × Z)).symm (f p.1, g p.2)) := by
      intro i f j g; rw [continuous_iff X]; intro k r
      have hfg : Continuous (fun p : X i × X j ↦ (f p.1, g p.2)) := by fun_prop
      exact (equiv_symm_comp_continuous_iff X
        (fun w : X k ↦ (f (r w).1, g (r w).2))).2 (hfg.comp r.continuous)
    have hmid : ∀ (j : ι) (g : C(X j, Z)), Continuous (fun p : Y × X j ↦
        (WithGeneratedByTopology.equiv (X := X) (Y := Y × Z)).symm (p.1, g p.2)) := fun j g ↦
      (isQuotientMap_sigmaEval X Y hX).continuous_lift_prod_left <|
        Homeomorph.sigmaProdDistrib.symm.isQuotientMap.continuous_iff.2 <|
          continuous_sigma fun ⟨i, f⟩ ↦ htest i f j g
    exact (isQuotientMap_sigmaEval X Z hX).continuous_lift_prod_right <|
      ((Homeomorph.prodComm _ _).trans
        Homeomorph.sigmaProdDistrib).symm.isQuotientMap.continuous_iff.2 <|
        continuous_sigma fun ⟨j, g⟩ ↦ (hmid j g).comp continuous_swap
  · push Not at hX
    have := discreteTopology_of_forall_isEmpty X (Y := Y) hX
    have := discreteTopology_of_forall_isEmpty X (Y := Z) hX
    exact iff_le_generatedBy.2 (DiscreteTopology.eq_bot (α := Y × Z) ▸ bot_le)

/-- **Whitehead product theorem for generated spaces (right locally compact factor).**
Suppose every test space `X i` is locally compact and every pairwise product `X i × X j` is
`X`-generated. If `Y` and `Z` are `X`-generated and `Z` is locally compact, then the ordinary
product `Y × Z` is `X`-generated. -/
theorem prod_of_locallyCompactSpace_right
    [∀ i, LocallyCompactSpace (X i)] [∀ i j, IsGeneratedBy X (X i × X j)]
    {Y : Type v} [TopologicalSpace Y] [IsGeneratedBy X Y]
    {Z : Type v'} [TopologicalSpace Z] [IsGeneratedBy X Z] [LocallyCompactSpace Z] :
    IsGeneratedBy X (Y × Z) :=
  have : IsGeneratedBy X (Z × Y) := prod_of_locallyCompactSpace_left (X := X)
  (Homeomorph.prodComm Z Y).isQuotientMap.isGeneratedBy

end Topology.IsGeneratedBy

namespace Topology.WithGeneratedByTopology

variable [∀ i, LocallyCompactSpace (X i)] [∀ i j, IsGeneratedBy X (X i × X j)]
  {Y : Type v} [TopologicalSpace Y] [IsGeneratedBy X Y]
  {Z : Type v'} [TopologicalSpace Z] [IsGeneratedBy X Z]

/-- Suppose `[∀ i, LocallyCompactSpace (X i)]` and `[∀ i j, IsGeneratedBy X (X i × X j)]`. When `Y`
and `Z` are `X`-generated and `Y` is locally compact, the counit
`WithGeneratedByTopology X (Y × Z) → Y × Z` is a homeomorphism. -/
def prodHomeomorphOfLocallyCompactLeft (Y : Type v) [TopologicalSpace Y] [IsGeneratedBy X Y]
    [LocallyCompactSpace Y] (Z : Type v') [TopologicalSpace Z] [IsGeneratedBy X Z] :
    WithGeneratedByTopology X (Y × Z) ≃ₜ Y × Z :=
  have : IsGeneratedBy X (Y × Z) := IsGeneratedBy.prod_of_locallyCompactSpace_left
  IsGeneratedBy.homeomorph

@[simp] theorem prodHomeomorphOfLocallyCompactLeft_apply [LocallyCompactSpace Y]
    (p : WithGeneratedByTopology X (Y × Z)) :
    prodHomeomorphOfLocallyCompactLeft X Y Z p = equiv p := (rfl)
@[simp] theorem prodHomeomorphOfLocallyCompactLeft_symm_apply [LocallyCompactSpace Y] (p : Y × Z) :
    (prodHomeomorphOfLocallyCompactLeft X Y Z).symm p = equiv.symm p := (rfl)

/-- Suppose `[∀ i, LocallyCompactSpace (X i)]` and `[∀ i j, IsGeneratedBy X (X i × X j)]`. When `Y`
and `Z` are `X`-generated and `Z` is locally compact, the counit
`WithGeneratedByTopology X (Y × Z) → Y × Z` is a homeomorphism. -/
def prodHomeomorphOfLocallyCompactRight (Y : Type v) [TopologicalSpace Y] [IsGeneratedBy X Y]
    (Z : Type v') [TopologicalSpace Z] [IsGeneratedBy X Z] [LocallyCompactSpace Z] :
    WithGeneratedByTopology X (Y × Z) ≃ₜ Y × Z :=
  have : IsGeneratedBy X (Y × Z) := IsGeneratedBy.prod_of_locallyCompactSpace_right
  IsGeneratedBy.homeomorph

@[simp] theorem prodHomeomorphOfLocallyCompactRight_apply [LocallyCompactSpace Z]
    (p : WithGeneratedByTopology X (Y × Z)) :
    prodHomeomorphOfLocallyCompactRight X Y Z p = equiv p := (rfl)
@[simp] theorem prodHomeomorphOfLocallyCompactRight_symm_apply [LocallyCompactSpace Z] (p : Y × Z) :
    (prodHomeomorphOfLocallyCompactRight X Y Z).symm p = equiv.symm p := (rfl)

end Topology.WithGeneratedByTopology

end Product

section HomSpace

variable {ι : Type t} {X : ι → Type u} [∀ i, TopologicalSpace (X i)]
  {Y : Type v} [TopologicalSpace Y] {T : Type v''} [TopologicalSpace T]

namespace ContinuousMap

/-- View an ordinary continuous map `f : C(Y, T)` as an `X`-continuous map. -/
def toContinuousMapGeneratedBy (f : C(Y, T)) (X : ι → Type u) [∀ i, TopologicalSpace (X i)] :
    Topology.ContinuousMapGeneratedBy X Y T where
  toFun := f
  prop := f.continuous.continuousGeneratedBy

@[simp] theorem toContinuousMapGeneratedBy_apply (f : C(Y, T)) (y : Y) :
    f.toContinuousMapGeneratedBy X y = f y := (rfl)

/-- The canonical inclusion from the compact-open mapping space `C(Y, T)` into
`ContinuousMapGeneratedBy X Y T` is continuous. -/
@[continuity, fun_prop] theorem continuous_toContinuousMapGeneratedBy :
    Continuous (fun f : C(Y, T) ↦ f.toContinuousMapGeneratedBy X) :=
  Topology.ContinuousMapGeneratedBy.continuous_iff.2 fun _ g ↦ ContinuousMap.continuous_precomp g

end ContinuousMap

namespace Topology.ContinuousMapGeneratedBy

instance instNontrivial [Nonempty Y] [Nontrivial T] :
    Nontrivial (ContinuousMapGeneratedBy X Y T) := by
  obtain ⟨y₀⟩ := ‹Nonempty Y›; obtain ⟨t₁, t₂, ht⟩ := exists_pair_ne T
  exact ⟨(ContinuousMap.const Y t₁).toContinuousMapGeneratedBy X,
    (ContinuousMap.const Y t₂).toContinuousMapGeneratedBy X,
    fun h ↦ ht (by simpa using congr($h y₀))⟩

variable [IsGeneratedBy X Y]

/-- When `Y` is `X`-generated, every `X`-continuous map `Y → T` is genuinely continuous. -/
def toContinuousMap (g : ContinuousMapGeneratedBy X Y T) : C(Y, T) where
  toFun := g
  continuous_toFun := (IsGeneratedBy.continuous_iff X g).2 g.prop

@[simp] theorem toContinuousMap_apply (g : ContinuousMapGeneratedBy X Y T) (y : Y) :
    g.toContinuousMap y = g y := (rfl)
@[simp] theorem toContinuousMap_toContinuousMapGeneratedBy (f : C(Y, T)) :
    (f.toContinuousMapGeneratedBy X).toContinuousMap = f := by ext; rfl
@[simp] theorem toContinuousMapGeneratedBy_toContinuousMap (g : ContinuousMapGeneratedBy X Y T) :
    g.toContinuousMap.toContinuousMapGeneratedBy X = g := by ext; rfl

/-- When `Y` is `X`-generated, `ContinuousMapGeneratedBy X Y T` has the exact same elements as
`C(Y, T)`. -/
def equivContinuousMap : ContinuousMapGeneratedBy X Y T ≃ C(Y, T) where
  toFun := toContinuousMap
  invFun f := f.toContinuousMapGeneratedBy X
  left_inv := toContinuousMapGeneratedBy_toContinuousMap
  right_inv := toContinuousMap_toContinuousMapGeneratedBy

@[simp] theorem equivContinuousMap_apply (g : ContinuousMapGeneratedBy X Y T) :
    equivContinuousMap g = g.toContinuousMap := (rfl)
@[simp] theorem equivContinuousMap_symm_apply (f : C(Y, T)) :
    (equivContinuousMap (X := X)).symm f = f.toContinuousMapGeneratedBy X := (rfl)

variable [∀ i, LocallyCompactSpace (X i)] [∀ i j, IsGeneratedBy X (X i × X j)]

/-- Suppose `[∀ i, LocallyCompactSpace (X i)]` and `[∀ i j, IsGeneratedBy X (X i × X j)]`. For any
`X`-generated source `Y` (with no local compactness or Hausdorffness assumption on `Y`), the
`X`-generated refinements `WithGeneratedByTopology X (ContinuousMapGeneratedBy X Y T)` and
`WithGeneratedByTopology X C(Y, T)` are homeomorphic via `equivContinuousMap`. -/
def generatedByHomeomorphContinuousMap :
    WithGeneratedByTopology X (ContinuousMapGeneratedBy X Y T) ≃ₜ
      WithGeneratedByTopology X C(Y, T) where
  toEquiv := WithGeneratedByTopology.equiv.trans
    (equivContinuousMap.trans WithGeneratedByTopology.equiv.symm)
  continuous_toFun := (WithGeneratedByTopology.continuous_from_iff _).2 fun i f ↦ by
    simp only [Equiv.toFun_as_coe, Equiv.coe_trans, Function.comp_def, Equiv.apply_symm_apply]
    refine (IsGeneratedBy.equiv_symm_comp_continuous_iff X
      (fun x : X i ↦ equivContinuousMap (f x))).2 ?_
    have hf := (continuousGeneratedBy_iff_uncurry _).1 f.continuous.continuousGeneratedBy
    have : IsGeneratedBy X (X i × Y) := IsGeneratedBy.prod_of_locallyCompactSpace_left
    exact (ContinuousMap.curry ⟨fun p : X i × Y ↦ f p.1 p.2, (IsGeneratedBy.continuous_iff X _).2
      fun _ r ↦ (hf (ContinuousMap.fst.comp r) (ContinuousMap.snd.comp r)).comp
        (continuous_id.prodMk continuous_id)⟩).continuous
  continuous_invFun := (WithGeneratedByTopology.continuous_from_iff _).2 fun _ f ↦ by
    simp only [Equiv.invFun_as_coe, Equiv.symm_trans_apply, Equiv.symm_symm, Function.comp_def,
      Equiv.apply_symm_apply]
    exact (IsGeneratedBy.equiv_symm_comp_continuous_iff X
      (fun x ↦ (equivContinuousMap (X := X)).symm (f x))).2
      (ContinuousMap.continuous_toContinuousMapGeneratedBy.comp f.continuous)

@[simp] theorem generatedByHomeomorphContinuousMap_apply
    (g : WithGeneratedByTopology X (ContinuousMapGeneratedBy X Y T)) :
    WithGeneratedByTopology.equiv (generatedByHomeomorphContinuousMap g) =
      (WithGeneratedByTopology.equiv g).toContinuousMap := (rfl)
@[simp] theorem generatedByHomeomorphContinuousMap_symm_apply
    (f : WithGeneratedByTopology X C(Y, T)) :
    WithGeneratedByTopology.equiv (generatedByHomeomorphContinuousMap.symm f) =
      (WithGeneratedByTopology.equiv f).toContinuousMapGeneratedBy X := (rfl)

end Topology.ContinuousMapGeneratedBy

end HomSpace
