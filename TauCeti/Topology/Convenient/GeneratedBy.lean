module

public import Mathlib.Topology.Convenient.Category

/-!
# Maps from generated spaces

A topological space `Y` is generated by a family of spaces `X` (Mathlib's `IsGeneratedBy X Y`)
when its topology is coinduced by all continuous maps from the spaces `X i`. An empty space has
only one topology, so it is generated by every family (`TauCeti.instIsGeneratedByOfIsEmpty`). In
particular every empty space is delta-generated. Generation by a family is invariant under
homeomorphism (`Topology.IsGeneratedBy.of_homeomorph`, `Topology.isGeneratedBy_congr`).

A continuous map from a generated space lifts uniquely through the generated-topology
counit on its target (`ContinuousMap.toGeneratedBy`). The source's generation hypothesis is
retained explicitly, as required for parameter families into a refined mapping space. The counit
is a homeomorphism—and the categorical counit in `TopCat` is an isomorphism—if and only if the
space is generated by the family (`Topology.WithGeneratedByTopology.isHomeomorph_counit_iff`,
`GeneratedByTopCat.isIso_adjCounit_app_iff`).
-/

public section

namespace TauCeti

/-- **An empty space is generated by any family of spaces**: it has only one topology. -/
instance instIsGeneratedByOfIsEmpty {ι : Type*} (X : ι → Type*)
    [∀ i, TopologicalSpace (X i)] (Y : Type*) [TopologicalSpace Y] [IsEmpty Y] :
    Topology.IsGeneratedBy X Y :=
  Topology.IsGeneratedBy.iff_le_generatedBy.2 fun U _ ↦ by simp [Set.eq_empty_of_isEmpty U]

end TauCeti

namespace Topology

/-- Generation by a family of spaces transfers along a homeomorphism. -/
theorem IsGeneratedBy.of_homeomorph {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] [IsGeneratedBy G X] (e : X ≃ₜ Y) :
    IsGeneratedBy G Y :=
  e.isQuotientMap.isGeneratedBy

/-- Homeomorphic spaces are generated by the same families of spaces. -/
theorem isGeneratedBy_congr {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] (e : X ≃ₜ Y) :
    IsGeneratedBy G X ↔ IsGeneratedBy G Y :=
  ⟨fun _ ↦ IsGeneratedBy.of_homeomorph e, fun _ ↦ IsGeneratedBy.of_homeomorph e.symm⟩

end Topology

namespace Topology.WithGeneratedByTopology

/-- The continuous counit from the generated refinement to the original space. -/
def counit {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : Type*) [TopologicalSpace X] : C(WithGeneratedByTopology G X, X) :=
  ⟨equiv, continuous_equiv⟩

@[simp]
theorem counit_apply {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    {X : Type*} [TopologicalSpace X] (x : WithGeneratedByTopology G X) :
    counit G X x = equiv x :=
  (rfl)

/-- The generated-topology counit is a homeomorphism if and only if the space is generated by the
family. -/
theorem isHomeomorph_counit_iff {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : Type*) [TopologicalSpace X] :
    IsHomeomorph (counit G X) ↔ IsGeneratedBy G X :=
  ⟨fun h ↦ ⟨equiv.continuous_symm_iff.2 h.isOpenMap⟩,
    fun _ ↦ (IsGeneratedBy.homeomorph (X := G) (Y := X)).isHomeomorph⟩

instance {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    {X : Type*} [TopologicalSpace X] [T2Space X] :
    T2Space (WithGeneratedByTopology G X) :=
  T2Space.of_injective_continuous equiv.injective continuous_equiv

instance {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    {X : Type*} [TopologicalSpace X] [h : Small.{w} X] :
    Small.{w} (WithGeneratedByTopology G X) :=
  h

end Topology.WithGeneratedByTopology

namespace GeneratedByTopCat

open CategoryTheory Limits

/-- The underlying continuous map of the categorical counit is the generated-topology counit. -/
@[simp]
theorem adjCounit_app_hom {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : TopCat) :
    ((adjCounit (X := G)).app X).hom = Topology.WithGeneratedByTopology.counit G X :=
  (rfl)

/-- The categorical counit at `X` is an isomorphism in `TopCat` if and only if `X` is generated
by the family `G`. -/
theorem isIso_adjCounit_app_iff {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : TopCat) :
    IsIso ((adjCounit (X := G)).app X) ↔ Topology.IsGeneratedBy G X := by
  rw [TopCat.isIso_iff_isHomeomorph]
  exact Topology.WithGeneratedByTopology.isHomeomorph_counit_iff G X

/-- On a space already generated by `G`, the categorical counit is an isomorphism. -/
instance instIsIsoAdjCounitApp {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    (X : TopCat) [Topology.IsGeneratedBy G X] :
    IsIso ((adjCounit (X := G)).app X) :=
  (isIso_adjCounit_app_iff G X).2 inferInstance

noncomputable instance instCreatesColimitsOfSizeToTopCat {ι : Type*} {G : ι → Type*}
    [∀ i, TopologicalSpace (G i)] :
    CreatesColimitsOfSize.{w', v'} (toTopCat.{v} (X := G)) :=
  comonadicCreatesColimits _

instance {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)] [UnivLE.{v', v}] :
    HasLimitsOfSize.{w', v'} (GeneratedByTopCat.{v} G) :=
  hasLimits_of_coreflective toTopCat

instance {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)] [UnivLE.{v', v}] :
    HasColimitsOfSize.{w', v'} (GeneratedByTopCat.{v} G) :=
  hasColimits_of_coreflective toTopCat

end GeneratedByTopCat

namespace ContinuousMap

open Topology

variable {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
  {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] [IsGeneratedBy G X]

/-- Lift a continuous map from a generated source to the generated refinement of its target. -/
def toGeneratedBy (f : C(X, Y)) (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    [IsGeneratedBy G X] : C(X, WithGeneratedByTopology G Y) :=
  ⟨WithGeneratedByTopology.equiv.symm ∘ f,
    (IsGeneratedBy.equiv_symm_comp_continuous_iff (X := G) f).2 f.continuous⟩

@[simp]
theorem toGeneratedBy_apply (f : C(X, Y)) (x : X) :
    f.toGeneratedBy G x = WithGeneratedByTopology.equiv.symm (f x) :=
  (rfl)

/-- Composing the lifted map with the counit recovers the original map. -/
@[simp]
theorem equiv_comp_toGeneratedBy (f : C(X, Y)) :
    (WithGeneratedByTopology.counit G Y).comp (f.toGeneratedBy G) = f := by
  ext x
  exact WithGeneratedByTopology.equiv.apply_symm_apply (f x)

/-- A map to the generated refinement is recovered by lifting its composite with the counit. -/
@[simp]
theorem toGeneratedBy_equiv_comp (f : C(X, WithGeneratedByTopology G Y)) :
    ((WithGeneratedByTopology.counit G Y).comp f).toGeneratedBy G = f := by
  ext x
  exact WithGeneratedByTopology.equiv.symm_apply_apply (f x)

end ContinuousMap
