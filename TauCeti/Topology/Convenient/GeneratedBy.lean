module

public import Mathlib.Topology.CompactOpen
public import Mathlib.Topology.Convenient.Category
import Mathlib.Topology.Homeomorph.Lemmas

/-!
# Maps and products for generated spaces

A topological space `Y` is generated by a family of spaces `X` (Mathlib's `IsGeneratedBy X Y`)
when its topology is coinduced by all continuous maps from the spaces `X i`. An empty space has
only one topology, so it is generated by every family (`TauCeti.instIsGeneratedByOfIsEmpty`). In
particular every empty space is delta-generated.

A continuous map from a generated space lifts uniquely through the generated-topology
counit on its target (`ContinuousMap.toGeneratedBy`), and the counit is a homeomorphism (hence a
categorical isomorphism in `TopCat`) if and only if the target is already generated by the family
(`Topology.WithGeneratedByTopology.isHomeomorph_counit_iff`,
`GeneratedByTopCat.isIso_adjCounit_app_iff`).

When `Y` is locally compact, `G`-generated, and every product `G i × Y` with a generator is
`G`-generated, currying through `C(Y, -)` shows that `X × Y` is `G`-generated whenever `X` is
(`Topology.IsGeneratedBy.prod_right`), and more generally that refining `X × Y` agrees up to
homeomorphism with refining `X` alone and taking the ordinary product with `Y`
(`Topology.WithGeneratedByTopology.prodRightHomeomorph`).

## References

* R. M. Vogt, *Convenient categories of topological spaces for homotopy theory*, Math. Z. 119
  (1971), 11–28.
* M. Escardó, J. Lawson, and A. Simpson, *Comparing Cartesian closed categories of (core)
  compactly generated spaces*, Topology Appl. 143 (2004), 105–145.
-/

public section

namespace TauCeti

/-- **An empty space is generated by any family of spaces**: it has only one topology. -/
instance instIsGeneratedByOfIsEmpty {ι : Type*} (X : ι → Type*)
    [∀ i, TopologicalSpace (X i)] (Y : Type*) [TopologicalSpace Y] [IsEmpty Y] :
    Topology.IsGeneratedBy X Y :=
  Topology.IsGeneratedBy.iff_le_generatedBy.2 fun U _ ↦ by simp [Set.eq_empty_of_isEmpty U]

end TauCeti

namespace Topology.WithGeneratedByTopology

/-- The continuous counit from the generated refinement to the original space. -/
def counit {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : Type*) [TopologicalSpace X] : C(WithGeneratedByTopology G X, X) :=
  ⟨equiv, continuous_equiv⟩

@[simp]
theorem counit_apply {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    {X : Type*} [TopologicalSpace X] (x : WithGeneratedByTopology G X) :
    counit G X x = equiv x :=
  (rfl)

/-- The generated-topology counit is a homeomorphism if and only if the space is generated by the
family. -/
theorem isHomeomorph_counit_iff {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : Type*) [TopologicalSpace X] :
    IsHomeomorph (counit G X) ↔ IsGeneratedBy G X := by
  change IsHomeomorph (equiv (X := G) (Y := X)) ↔ IsGeneratedBy G X
  rw [Equiv.isHomeomorph_iff, isGeneratedBy_iff, and_iff_right continuous_equiv]

end Topology.WithGeneratedByTopology

namespace Topology.IsGeneratedBy

/-- The continuous map underlying `IsGeneratedBy.homeomorph` is `WithGeneratedByTopology.counit`. -/
@[simp]
theorem toContinuousMap_homeomorph {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    {X : Type*} [TopologicalSpace X] [IsGeneratedBy G X] :
    (homeomorph (X := G) (Y := X) : C(WithGeneratedByTopology G X, X)) =
      WithGeneratedByTopology.counit G X := (rfl)

end Topology.IsGeneratedBy

namespace GeneratedByTopCat

/-- The underlying continuous map of the categorical counit is the generated-topology counit. -/
@[simp]
theorem adjCounit_app_hom {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : TopCat) :
    ((adjCounit (X := G)).app X).hom = Topology.WithGeneratedByTopology.counit G X :=
  (rfl)

/-- The categorical counit at `X` is an isomorphism in `TopCat` if and only if `X` is generated by
`G`. -/
theorem isIso_adjCounit_app_iff {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : TopCat) :
    CategoryTheory.IsIso ((adjCounit (X := G)).app X) ↔ Topology.IsGeneratedBy G X :=
  (TopCat.isIso_iff_isHomeomorph _).trans
    (Topology.WithGeneratedByTopology.isHomeomorph_counit_iff G X)

end GeneratedByTopCat

namespace ContinuousMap

open Topology

variable {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
  {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] [IsGeneratedBy G X]

/-- Lift a continuous map from a generated source to the generated refinement of its target. -/
def toGeneratedBy (f : C(X, Y)) (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    [IsGeneratedBy G X] : C(X, WithGeneratedByTopology G Y) :=
  ⟨WithGeneratedByTopology.equiv.symm ∘ f,
    (IsGeneratedBy.equiv_symm_comp_continuous_iff (X := G) f).2 f.continuous⟩

@[simp]
theorem toGeneratedBy_apply (f : C(X, Y)) (x : X) :
    f.toGeneratedBy G x = WithGeneratedByTopology.equiv.symm (f x) :=
  (rfl)

/-- Composing the lifted map with the counit recovers the original map. -/
@[simp]
theorem equiv_comp_toGeneratedBy (f : C(X, Y)) :
    (WithGeneratedByTopology.counit G Y).comp (f.toGeneratedBy G) = f := by
  ext x
  exact WithGeneratedByTopology.equiv.apply_symm_apply (f x)

/-- A map to the generated refinement is recovered by lifting its composite with the counit. -/
@[simp]
theorem toGeneratedBy_equiv_comp (f : C(X, WithGeneratedByTopology G Y)) :
    ((WithGeneratedByTopology.counit G Y).comp f).toGeneratedBy G = f := by
  ext x
  exact WithGeneratedByTopology.equiv.symm_apply_apply (f x)

end ContinuousMap

namespace Topology.IsGeneratedBy

variable {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]

/-- If `Y` is locally compact, `G`-generated, and its product with every generator `G i` is
`G`-generated, then `X × Y` is `G`-generated whenever `X` is. -/
theorem prod_right {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [IsGeneratedBy G X] [IsGeneratedBy G Y] [LocallyCompactSpace Y]
    [∀ i, IsGeneratedBy G (G i × Y)] : IsGeneratedBy G (X × Y) where
  continuous_equiv_symm := by
    let e := (WithGeneratedByTopology.equiv (X := G) (Y := X × Y)).symm
    have he (x : X) : Continuous fun y : Y ↦ e (x, y) := (continuous_iff G _).2 fun _ q ↦
      (equiv_symm_comp_continuous_iff (X := G) fun s ↦ (x, q s)).2 (by fun_prop)
    refine ContinuousMap.continuous_uncurry_of_continuous ⟨fun x ↦ ⟨_, he x⟩, ?_⟩
    exact (continuous_iff G _).2 fun i f ↦ (ContinuousMap.curry ⟨_,
      (equiv_symm_comp_continuous_iff (X := G) fun p : G i × Y ↦ (f p.1, p.2)).2
        (by fun_prop)⟩).continuous

/-- If `X` is locally compact, `G`-generated, and `G i × X` is `G`-generated for every generator
`G i`, then `X × Y` is `G`-generated whenever `Y` is. -/
theorem prod_left {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [IsGeneratedBy G X] [IsGeneratedBy G Y] [LocallyCompactSpace X]
    [∀ i, IsGeneratedBy G (G i × X)] : IsGeneratedBy G (X × Y) :=
  have : IsGeneratedBy G (Y × X) := prod_right
  (Homeomorph.prodComm Y X).isQuotientMap.isGeneratedBy

end Topology.IsGeneratedBy

namespace Topology.WithGeneratedByTopology

variable {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]

/-- Refining a product `X × Y` with a locally compact `G`-generated factor `Y` (whose products
`G i × Y` with all generators are `G`-generated) agrees up to homeomorphism with refining `X`
alone and taking the ordinary product with `Y`. -/
@[expose]
def prodRightHomeomorph (X Y : Type*) [TopologicalSpace X] [TopologicalSpace Y]
    [IsGeneratedBy G Y] [LocallyCompactSpace Y] [∀ i, IsGeneratedBy G (G i × Y)] :
    WithGeneratedByTopology G (X × Y) ≃ₜ WithGeneratedByTopology G X × Y where
  toFun p := (equiv.symm (equiv p).1, (equiv p).2)
  invFun p := equiv.symm (equiv p.1, p.2)
  left_inv p := by simp
  right_inv p := by simp
  continuous_toFun := by
    exact (((ContinuousMap.fst.comp (counit G (X × Y))).toGeneratedBy G).continuous).prodMk
      (ContinuousMap.snd.comp (counit G (X × Y))).continuous
  continuous_invFun := by
    have : IsGeneratedBy G (WithGeneratedByTopology G X × Y) := IsGeneratedBy.prod_right
    exact (((counit G X).prodMap (.id Y)).toGeneratedBy G).continuous

@[simp]
theorem prodRightHomeomorph_apply {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [IsGeneratedBy G Y] [LocallyCompactSpace Y] [∀ i, IsGeneratedBy G (G i × Y)]
    (p : WithGeneratedByTopology G (X × Y)) :
    prodRightHomeomorph G X Y p = (equiv.symm (equiv p).1, (equiv p).2) := (rfl)

@[simp]
theorem prodRightHomeomorph_symm_apply {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [IsGeneratedBy G Y] [LocallyCompactSpace Y] [∀ i, IsGeneratedBy G (G i × Y)]
    (p : WithGeneratedByTopology G X × Y) :
    (prodRightHomeomorph G X Y).symm p = equiv.symm (equiv p.1, p.2) := (rfl)

/-- Refining a product `X × Y` with a locally compact `G`-generated left factor `X` (whose products
`G i × X` with all generators are `G`-generated) agrees up to homeomorphism with taking the
ordinary product of `X` with the refinement of `Y`. -/
@[expose]
def prodLeftHomeomorph (X Y : Type*) [TopologicalSpace X] [TopologicalSpace Y]
    [IsGeneratedBy G X] [LocallyCompactSpace X] [∀ i, IsGeneratedBy G (G i × X)] :
    WithGeneratedByTopology G (X × Y) ≃ₜ X × WithGeneratedByTopology G Y where
  toFun p := ((equiv p).1, equiv.symm (equiv p).2)
  invFun p := equiv.symm (p.1, equiv p.2)
  left_inv p := by simp
  right_inv p := by simp
  continuous_toFun := by
    exact ((ContinuousMap.fst.comp (counit G (X × Y))).continuous).prodMk
      ((ContinuousMap.snd.comp (counit G (X × Y))).toGeneratedBy G).continuous
  continuous_invFun := by
    have : IsGeneratedBy G (X × WithGeneratedByTopology G Y) := IsGeneratedBy.prod_left
    exact (((ContinuousMap.id X).prodMap (counit G Y)).toGeneratedBy G).continuous

@[simp]
theorem prodLeftHomeomorph_apply {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [IsGeneratedBy G X] [LocallyCompactSpace X] [∀ i, IsGeneratedBy G (G i × X)]
    (p : WithGeneratedByTopology G (X × Y)) :
    prodLeftHomeomorph G X Y p = ((equiv p).1, equiv.symm (equiv p).2) := (rfl)

@[simp]
theorem prodLeftHomeomorph_symm_apply {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [IsGeneratedBy G X] [LocallyCompactSpace X] [∀ i, IsGeneratedBy G (G i × X)]
    (p : X × WithGeneratedByTopology G Y) :
    (prodLeftHomeomorph G X Y).symm p = equiv.symm (p.1, equiv p.2) := (rfl)

end Topology.WithGeneratedByTopology
