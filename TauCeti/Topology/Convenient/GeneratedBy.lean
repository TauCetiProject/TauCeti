module

public import Mathlib.Topology.Convenient.Category

/-!
# Maps from generated spaces and properties of the generated refinement

A topological space `Y` is generated by a family of spaces `X` (Mathlib's `IsGeneratedBy X Y`)
when its topology is coinduced by all continuous maps from the spaces `X i`. An empty space has
only one topology, so it is generated by every family (`TauCeti.instIsGeneratedByOfIsEmpty`). In
particular every empty space is delta-generated.

`Topology.WithGeneratedByTopology G X` preserves emptiness, nontriviality, and `T2Space`, and
`(GeneratedByTopCat.adjCounit (X := G)).app Y` is an isomorphism in `TopCat` iff `Y` is
`G`-generated (`GeneratedByTopCat.isIso_adjCounit_app_iff`). A continuous map from a generated space
lifts uniquely through the counit on its target (`ContinuousMap.toGeneratedBy`).

For any generating family `X`, `Topology.IsGeneratedBy.sigmaEval X Y` evaluates all continuous test
maps `X i → Y` on the disjoint union of their domains; it coinduces the topology of every
`X`-generated space `Y`, and is a quotient map whenever some `X i` is nonempty
(`Topology.IsGeneratedBy.isQuotientMap_sigmaEval`). If every `X i` is empty, every `X`-generated
space is discrete (`Topology.IsGeneratedBy.discreteTopology_of_forall_isEmpty`).
-/

public section

namespace TauCeti

/-- **An empty space is generated by any family of spaces**: it has only one topology. -/
instance instIsGeneratedByOfIsEmpty {ι : Type*} (X : ι → Type*)
    [∀ i, TopologicalSpace (X i)] (Y : Type*) [TopologicalSpace Y] [IsEmpty Y] :
    Topology.IsGeneratedBy X Y :=
  Topology.IsGeneratedBy.iff_le_generatedBy.2 fun U _ ↦ by simp [Set.eq_empty_of_isEmpty U]

end TauCeti

namespace Topology.IsGeneratedBy

section SigmaEval

variable {ι : Type*} (X : ι → Type*) [∀ i, TopologicalSpace (X i)]

/-- The canonical evaluation map from the disjoint union of all continuous test maps `X i → Y`
into `Y`. -/
def sigmaEval (Y : Type*) [TopologicalSpace Y] (p : (f : (i : ι) × C(X i, Y)) × X f.1) : Y :=
  p.1.2 p.2

theorem sigmaEval_def (Y : Type*) [TopologicalSpace Y] :
    sigmaEval X Y = fun p : (f : (i : ι) × C(X i, Y)) × X f.1 ↦ p.1.2 p.2 := (rfl)

@[simp] theorem sigmaEval_apply {Y : Type*} [TopologicalSpace Y] (i : ι) (f : C(X i, Y))
    (x : X i) : sigmaEval X Y ⟨⟨i, f⟩, x⟩ = f x := (rfl)

/-- The canonical evaluation map out of the sigma space of continuous test maps is continuous. -/
@[continuity, fun_prop] theorem continuous_sigmaEval (Y : Type*) [TopologicalSpace Y] :
    Continuous (sigmaEval X Y) := continuous_sigma fun ⟨_, f⟩ ↦ f.continuous

/-- For an `X`-generated space `Y`, `sigmaEval X Y` coinduces the topology of `Y`. -/
theorem isCoinducing_sigmaEval (Y : Type*) [TopologicalSpace Y] [IsGeneratedBy X Y] :
    IsCoinducing (sigmaEval X Y) where
  eq_coinduced := (generatedBy_eq (X := X) (Y := Y)).symm.trans <|
    (TopologicalSpace.generatedBy_eq_coinduced X).trans <| by rw [sigmaEval_def]

/-- When at least one test space `X i` is nonempty, `sigmaEval X Y` is surjective. -/
theorem sigmaEval_surjective (Y : Type*) [TopologicalSpace Y] (hX : ∃ i, Nonempty (X i)) :
    Function.Surjective (sigmaEval X Y) := by
  obtain ⟨i₀, ⟨x₀⟩⟩ := hX; exact fun y ↦ ⟨⟨⟨i₀, ContinuousMap.const (X i₀) y⟩, x₀⟩, rfl⟩

/-- When at least one test space `X i` is nonempty and `Y` is `X`-generated, `sigmaEval X Y` is a
quotient map. -/
theorem isQuotientMap_sigmaEval (Y : Type*) [TopologicalSpace Y] [IsGeneratedBy X Y]
    (hX : ∃ i, Nonempty (X i)) : IsQuotientMap (sigmaEval X Y) :=
  ⟨isCoinducing_sigmaEval X Y, sigmaEval_surjective X Y hX⟩

/-- When every test space `X i` is empty, every `X`-generated space carries the discrete
topology. -/
theorem discreteTopology_of_forall_isEmpty {Y : Type*} [TopologicalSpace Y] [IsGeneratedBy X Y]
    (hX : ∀ i, IsEmpty (X i)) : DiscreteTopology Y :=
  discreteTopology_iff_forall_isOpen.2 fun U ↦ (isOpen_iff X).2 fun i f ↦ by
    have := hX i; rw [Set.eq_empty_of_isEmpty (f ⁻¹' U)]; exact isOpen_empty

end SigmaEval

end Topology.IsGeneratedBy

namespace Topology.WithGeneratedByTopology

instance instIsEmpty {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    {X : Type*} [TopologicalSpace X] [IsEmpty X] : IsEmpty (WithGeneratedByTopology G X) :=
  equiv.isEmpty
instance instNontrivial {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    {X : Type*} [TopologicalSpace X] [Nontrivial X] : Nontrivial (WithGeneratedByTopology G X) :=
  equiv.nontrivial

/-- Refining a Hausdorff space `X` to its `G`-generated topology preserves `T2Space`. -/
instance instT2Space {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    {X : Type*} [TopologicalSpace X] [T2Space X] : T2Space (WithGeneratedByTopology G X) :=
  .of_injective_continuous (equiv (X := G) (Y := X)).injective (continuous_equiv (X := G) (Y := X))

/-- The continuous counit from the generated refinement to the original space. -/
def counit {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : Type*) [TopologicalSpace X] : C(WithGeneratedByTopology G X, X) :=
  ⟨equiv, continuous_equiv⟩

@[simp]
theorem counit_apply {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    {X : Type*} [TopologicalSpace X] (x : WithGeneratedByTopology G X) :
    counit G X x = equiv x :=
  (rfl)

end Topology.WithGeneratedByTopology

namespace GeneratedByTopCat

open CategoryTheory Topology

/-- The underlying continuous map of the categorical counit is the generated-topology counit. -/
@[simp]
theorem adjCounit_app_hom {ι : Type*} (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    (X : TopCat) :
    ((adjCounit (X := G)).app X).hom = Topology.WithGeneratedByTopology.counit G X :=
  (rfl)

/-- If `Y` is `G`-generated, `(adjCounit (X := G)).app Y` is an isomorphism in `TopCat`. -/
instance isIso_adjCounit_app {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    (Y : TopCat) [IsGeneratedBy G Y] : IsIso ((adjCounit (X := G)).app Y) := by
  have h : (adjCounit (X := G)).app Y =
      (TopCat.isoOfHomeo (IsGeneratedBy.homeomorph (X := G) (Y := Y))).hom := by ext; rfl
  rw [h]; infer_instance

/-- `(adjCounit (X := G)).app Y` is an isomorphism in `TopCat` iff `Y` is `G`-generated. -/
theorem isIso_adjCounit_app_iff {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
    (Y : TopCat) : IsIso ((adjCounit (X := G)).app Y) ↔ IsGeneratedBy G Y := by
  refine ⟨fun _ ↦ ?_, fun _ ↦ inferInstance⟩
  have : IsGeneratedBy G ((TopCat.toGeneratedByTopCat (X := G) ⋙ toTopCat).obj Y) :=
    ((TopCat.toGeneratedByTopCat (X := G)).obj Y).property
  exact (TopCat.homeoOfIso (asIso ((adjCounit (X := G)).app Y))).isQuotientMap.isGeneratedBy

end GeneratedByTopCat

namespace ContinuousMap

open Topology

variable {ι : Type*} {G : ι → Type*} [∀ i, TopologicalSpace (G i)]
  {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] [IsGeneratedBy G X]

/-- Lift a continuous map from a generated source to the generated refinement of its target. -/
def toGeneratedBy (f : C(X, Y)) (G : ι → Type*) [∀ i, TopologicalSpace (G i)]
    [IsGeneratedBy G X] : C(X, WithGeneratedByTopology G Y) :=
  ⟨WithGeneratedByTopology.equiv.symm ∘ f,
    (IsGeneratedBy.equiv_symm_comp_continuous_iff (X := G) f).2 f.continuous⟩

@[simp]
theorem toGeneratedBy_apply (f : C(X, Y)) (x : X) :
    f.toGeneratedBy G x = WithGeneratedByTopology.equiv.symm (f x) :=
  (rfl)

/-- Composing the lifted map with the counit recovers the original map. -/
@[simp]
theorem equiv_comp_toGeneratedBy (f : C(X, Y)) :
    (WithGeneratedByTopology.counit G Y).comp (f.toGeneratedBy G) = f := by
  ext x
  exact WithGeneratedByTopology.equiv.apply_symm_apply (f x)

/-- A map to the generated refinement is recovered by lifting its composite with the counit. -/
@[simp]
theorem toGeneratedBy_equiv_comp (f : C(X, WithGeneratedByTopology G Y)) :
    ((WithGeneratedByTopology.counit G Y).comp f).toGeneratedBy G = f := by
  ext x
  exact WithGeneratedByTopology.equiv.symm_apply_apply (f x)

end ContinuousMap
