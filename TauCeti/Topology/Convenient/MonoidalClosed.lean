/-!
# Cartesian monoidal closed categories of generated spaces

Because `TopCat` is not cartesian closed, homotopy theory passes to convenient categories of spaces
generated by `X : ι → Type u`: `ContinuousGeneratedByCat.{v} X` and the coreflective subcategory
`GeneratedByTopCat.{v} X` of `TopCat.{v}` (which creates colimits in `TopCat.{v}`). Point-level
calculations unwrap products and internal homs via `tensorEquiv` and `ihomEquiv`.

* `PUnit` and `Y × Z` give chosen finite products in `ContinuousGeneratedByCat.{v} X`, while
  `GeneratedByTopCat.{v} X` refines binary products to `WithGeneratedByTopology X (Y × Z)`. When
  `Y × Z` is `X`-generated (in particular when one factor is locally compact under the closedness
  hypotheses on `X`), `GeneratedByTopCat.toTopCat` preserves the product and
  `CartesianMonoidalCategory.prodComparison` upgrades to
  `GeneratedByTopCat.prodComparisonIsoOfLocallyCompactLeft` and `Right`.
* When every `X i` is locally compact and every `X i × X j` is `X`-generated,
  `Topology.ContinuousMapGeneratedBy.curryEquiv` makes `ContinuousGeneratedByCat.{v} X` cartesian
  monoidal closed, and transporting along `ContinuousGeneratedByCat.equivalence` gives
  `GeneratedByTopCat.{v} X` its `MonoidalClosed` structure, `MonoidalClosed.ihomTensorIso`
  evaluation lemmas, `ihomIsoCompactOpen`, and `compactOpenCurryIso`.

## References

* R. M. Vogt, *Convenient categories of topological spaces for homotopy theory*, Arch. Math.
  (Basel) 22 (1971), 545–555.
* M. Escardó, J. Lawson and A. Simpson, *Comparing Cartesian closed categories of (core) compactly
  generated spaces*, Topology Appl. 143 (2004), 105–145.
-/

public section
noncomputable section

universe v t u

open CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory MonoidalClosed Topology

variable {ι : Type t} {X : ι → Type u} [∀ i, TopologicalSpace (X i)]

namespace ContinuousGeneratedByCat

/-- `PUnit` is terminal in `ContinuousGeneratedByCat X`. -/
def isTerminalPUnit : IsTerminal (of (X := X) PUnit.{v + 1}) :=
  IsTerminal.ofUniqueHom (fun _ ↦ homMk (fun _ ↦ PUnit.unit) continuous_const.continuousGeneratedBy)
    (fun _ _ ↦ by ext)

/-- The binary product fan of `Y` and `Z` in `ContinuousGeneratedByCat X`, given by `Y × Z`. -/
@[expose] def prodBinaryFan (Y Z : ContinuousGeneratedByCat.{v} X) : BinaryFan Y Z :=
  BinaryFan.mk (homMk (Y := of (X := X) (Y × Z)) Prod.fst continuous_fst.continuousGeneratedBy)
    (homMk (Y := of (X := X) (Y × Z)) Prod.snd continuous_snd.continuousGeneratedBy)

/-- The ordinary product `Y × Z` is a binary product in `ContinuousGeneratedByCat X`. -/
def prodBinaryFanIsLimit (Y Z : ContinuousGeneratedByCat.{v} X) : IsLimit (prodBinaryFan Y Z) :=
  BinaryFan.IsLimit.mk _
    (fun f g ↦ homMk (Z := of (X := X) (Y × Z)) (fun w ↦ (f w, g w)) <|
      (continuousGeneratedBy_def _).2 fun _ p ↦ (f.hom.prop p).prodMk (g.hom.prop p))
    (fun _ _ ↦ rfl) (fun _ _ ↦ rfl)
    (fun _ _ _ h₁ h₂ ↦ by ext w; exact Prod.ext (congr($h₁ w).trans rfl) (congr($h₂ w).trans rfl))

/-- Chosen finite products on `ContinuousGeneratedByCat X`, with unit `PUnit` and binary product
`Y × Z`. -/
instance instCartesianMonoidalCategory :
    CartesianMonoidalCategory (ContinuousGeneratedByCat.{v} X) :=
  .ofChosenFiniteProducts ⟨_, isTerminalPUnit⟩
    fun Y Z ↦ ⟨prodBinaryFan Y Z, prodBinaryFanIsLimit Y Z⟩

instance instBraidedCategory : BraidedCategory (ContinuousGeneratedByCat.{v} X) :=
  .ofCartesianMonoidalCategory

theorem tensorObj_def (Y Z : ContinuousGeneratedByCat.{v} X) : Y ⊗ Z = of (X := X) (Y × Z) := (rfl)
theorem tensorUnit_def : 𝟙_ (ContinuousGeneratedByCat.{v} X) = of (X := X) PUnit.{v + 1} := (rfl)

/-- The canonical bijection identifying points of `Y ⊗ Z` in `ContinuousGeneratedByCat X` with
`Y × Z`. -/
@[expose] def tensorEquiv (Y Z : ContinuousGeneratedByCat.{v} X) : ↑(Y ⊗ Z) ≃ Y × Z := Equiv.refl _

variable {W W₁ W₂ Y Y₁ Y₂ Z Z₁ Z₂ T T' : ContinuousGeneratedByCat.{v} X}

@[ext] theorem tensor_ext {p q : ↑(Y ⊗ Z)} (h : tensorEquiv Y Z p = tensorEquiv Y Z q) : p = q :=
  (tensorEquiv Y Z).injective h
@[simp] theorem fst_apply (p : ↑(Y ⊗ Z)) : fst Y Z p = (tensorEquiv Y Z p).1 := (rfl)
@[simp] theorem snd_apply (p : ↑(Y ⊗ Z)) : snd Y Z p = (tensorEquiv Y Z p).2 := (rfl)

private theorem eq_tensorEquiv_symm {p : ↑(Y ⊗ Z)} {y : Y} {z : Z}
    (h₁ : fst Y Z p = y) (h₂ : snd Y Z p = z) : p = (tensorEquiv Y Z).symm (y, z) :=
  (tensorEquiv Y Z).injective <| (Prod.ext h₁ h₂).trans ((tensorEquiv Y Z).apply_symm_apply _).symm

@[simp] theorem lift_apply (f : W ⟶ Y) (g : W ⟶ Z) (w : W) :
    CartesianMonoidalCategory.lift f g w = (tensorEquiv Y Z).symm (f w, g w) :=
  eq_tensorEquiv_symm congr($(lift_fst f g) w) congr($(lift_snd f g) w)
@[simp] theorem tensor_apply (f : W₁ ⟶ Y) (g : W₂ ⟶ Z) (p : ↑(W₁ ⊗ W₂)) :
    (f ⊗ₘ g) p = (tensorEquiv Y Z).symm (f (tensorEquiv W₁ W₂ p).1, g (tensorEquiv W₁ W₂ p).2) :=
  eq_tensorEquiv_symm congr($(tensorHom_fst f g) p) congr($(tensorHom_snd f g) p)
@[simp] theorem whiskerLeft_apply (Y : ContinuousGeneratedByCat.{v} X) (g : Z₁ ⟶ Z₂)
    (p : ↑(Y ⊗ Z₁)) :
    (Y ◁ g) p = (tensorEquiv Y Z₂).symm ((tensorEquiv Y Z₁ p).1, g (tensorEquiv Y Z₁ p).2) :=
  eq_tensorEquiv_symm congr($(whiskerLeft_fst Y g) p) congr($(whiskerLeft_snd Y g) p)
@[simp] theorem whiskerRight_apply (f : Y₁ ⟶ Y₂) (Z : ContinuousGeneratedByCat.{v} X)
    (p : ↑(Y₁ ⊗ Z)) :
    (f ▷ Z) p = (tensorEquiv Y₂ Z).symm (f (tensorEquiv Y₁ Z p).1, (tensorEquiv Y₁ Z p).2) :=
  eq_tensorEquiv_symm congr($(whiskerRight_fst f Z) p) congr($(whiskerRight_snd f Z) p)
@[simp] theorem braiding_hom_apply (p : ↑(Y ⊗ Z)) :
    (β_ Y Z).hom p = (tensorEquiv Z Y).symm (tensorEquiv Y Z p).swap :=
  eq_tensorEquiv_symm congr($(braiding_hom_fst Y Z) p) congr($(braiding_hom_snd Y Z) p)
@[simp] theorem braiding_inv_apply (p : ↑(Z ⊗ Y)) :
    (β_ Y Z).inv p = (tensorEquiv Y Z).symm (tensorEquiv Z Y p).swap :=
  eq_tensorEquiv_symm congr($(braiding_inv_fst Y Z) p) congr($(braiding_inv_snd Y Z) p)
@[simp] theorem associator_hom_apply (p : ↑((W ⊗ Y) ⊗ Z)) :
    (α_ W Y Z).hom p = (tensorEquiv W (Y ⊗ Z)).symm ((tensorEquiv W Y (tensorEquiv _ Z p).1).1,
      (tensorEquiv Y Z).symm ((tensorEquiv W Y (tensorEquiv _ Z p).1).2, (tensorEquiv _ Z p).2)) :=
  eq_tensorEquiv_symm congr($(associator_hom_fst W Y Z) p)
    (eq_tensorEquiv_symm congr($(associator_hom_snd_fst W Y Z) p)
      congr($(associator_hom_snd_snd W Y Z) p))
@[simp] theorem associator_inv_apply (p : ↑(W ⊗ (Y ⊗ Z))) :
    (α_ W Y Z).inv p = (tensorEquiv (W ⊗ Y) Z).symm ((tensorEquiv W Y).symm
      ((tensorEquiv W _ p).1, (tensorEquiv Y Z (tensorEquiv W _ p).2).1),
      (tensorEquiv Y Z (tensorEquiv W _ p).2).2) :=
  eq_tensorEquiv_symm (eq_tensorEquiv_symm congr($(associator_inv_fst_fst W Y Z) p)
    congr($(associator_inv_fst_snd W Y Z) p)) congr($(associator_inv_snd W Y Z) p)
@[simp] theorem leftUnitor_hom_apply (p : ↑(𝟙_ (ContinuousGeneratedByCat.{v} X) ⊗ Y)) :
    (λ_ Y).hom p = (tensorEquiv _ Y p).2 := by rw [leftUnitor_hom, snd_apply]
@[simp] theorem leftUnitor_inv_apply (y : Y) :
    (λ_ Y).inv y = (tensorEquiv _ Y).symm (PUnit.unit, y) :=
  eq_tensorEquiv_symm (PUnit.ext _ _) congr($(Iso.inv_hom_id (λ_ Y)) y)
@[simp] theorem rightUnitor_hom_apply (p : ↑(Y ⊗ 𝟙_ (ContinuousGeneratedByCat.{v} X))) :
    (ρ_ Y).hom p = (tensorEquiv Y _ p).1 := by rw [rightUnitor_hom, fst_apply]
@[simp] theorem rightUnitor_inv_apply (y : Y) :
    (ρ_ Y).inv y = (tensorEquiv Y _).symm (y, PUnit.unit) :=
  eq_tensorEquiv_symm congr($(Iso.inv_hom_id (ρ_ Y)) y) (PUnit.ext _ _)

section Closed

variable [∀ i, LocallyCompactSpace (X i)] [∀ i j, IsGeneratedBy X (X i × X j)]

/-- The internal hom functor on `ContinuousGeneratedByCat X` sending `T` to
`ContinuousMapGeneratedBy X Y T` and acting on morphisms by postcomposition. -/
@[expose] protected def ihom (Y : ContinuousGeneratedByCat.{v} X) :
    ContinuousGeneratedByCat.{v} X ⥤ ContinuousGeneratedByCat.{v} X where
  obj T := of (X := X) (ContinuousMapGeneratedBy X Y T)
  map p := ConcreteCategory.ofHom p.hom.postcomp

/-- Suppose `[∀ i, LocallyCompactSpace (X i)]` and `[∀ i j, IsGeneratedBy X (X i × X j)]`. Currying
in `ContinuousGeneratedByCat X` identifies morphisms `Y ⊗ Z ⟶ T` with morphisms
`Z ⟶ (ContinuousGeneratedByCat.ihom Y).obj T`. -/
def tensorHomEquiv (Y Z T : ContinuousGeneratedByCat.{v} X) :
    (Y ⊗ Z ⟶ T) ≃ (Z ⟶ (ContinuousGeneratedByCat.ihom Y).obj T) where
  toFun f := ConcreteCategory.ofHom (ContinuousMapGeneratedBy.curryEquiv f.hom)
  invFun g := ConcreteCategory.ofHom (ContinuousMapGeneratedBy.curryEquiv.symm g.hom)
  left_inv _ := by ext; rfl
  right_inv _ := by ext z; exact ContinuousMapGeneratedBy.ext (funext fun _ ↦ rfl)

/-- When every `X i` is locally compact and every `X i × X j` is `X`-generated,
`ContinuousGeneratedByCat X` is cartesian monoidal closed. -/
instance instMonoidalClosed : MonoidalClosed (ContinuousGeneratedByCat.{v} X) where
  closed Y :=
    { rightAdj := ContinuousGeneratedByCat.ihom Y
      adj := Adjunction.mkOfHomEquiv
        { homEquiv := tensorHomEquiv Y
          homEquiv_naturality_left_symm _ _ := by ext ⟨_, _⟩; rfl
          homEquiv_naturality_right _ _ := by
            ext z; exact ContinuousMapGeneratedBy.ext (funext fun _ ↦ rfl) } }

theorem homEquiv_def (Y Z T : ContinuousGeneratedByCat.{v} X) :
    (ihom.adjunction Y).homEquiv Z T = tensorHomEquiv Y Z T :=
  congrFun (congrFun (Adjunction.mkOfHomEquiv_homEquiv _) _) _
theorem ihom_obj_def (Y T : ContinuousGeneratedByCat.{v} X) :
    (ihom Y).obj T = of (X := X) (ContinuousMapGeneratedBy X Y T) := (rfl)
theorem ihom_map_def (p : T ⟶ T') : (ihom Y).map p = (ContinuousGeneratedByCat.ihom Y).map p :=
  (rfl)

/-- The canonical bijection identifying points of `(ihom Y).obj T` in `ContinuousGeneratedByCat X`
with `X`-continuous maps `Y → T`. -/
@[expose] def ihomEquiv (Y T : ContinuousGeneratedByCat.{v} X) :
    ↑((ihom Y).obj T) ≃ ContinuousMapGeneratedBy X Y T := Equiv.refl _

@[ext] theorem ihom_obj_ext {f g : ↑((ihom Y).obj T)}
    (h : ∀ y, ihomEquiv Y T f y = ihomEquiv Y T g y) : f = g :=
  (ihomEquiv Y T).injective (DFunLike.ext _ _ h)
@[simp] theorem ihom_map_apply (p : T ⟶ T') (g : ↑((ihom Y).obj T)) (y : Y) :
    ihomEquiv Y T' ((ihom Y).map p g) y = p (ihomEquiv Y T g y) := (rfl)
@[simp] theorem tensorHomEquiv_apply_apply (f : Y ⊗ Z ⟶ T) (z : Z) (y : Y) :
    ihomEquiv Y T (tensorHomEquiv Y Z T f z) y = f ((tensorEquiv Y Z).symm (y, z)) := (rfl)
@[simp] theorem tensorHomEquiv_symm_apply (g : Z ⟶ (ContinuousGeneratedByCat.ihom Y).obj T)
    (p : ↑(Y ⊗ Z)) : (tensorHomEquiv Y Z T).symm g p =
      ihomEquiv Y T (g (tensorEquiv Y Z p).2) (tensorEquiv Y Z p).1 := (rfl)
@[simp] theorem curry_apply (f : Y ⊗ Z ⟶ T) (z : Z) (y : Y) :
    ihomEquiv Y T (MonoidalClosed.curry f z) y = f ((tensorEquiv Y Z).symm (y, z)) := by
  rw [← MonoidalClosed.homEquiv_apply_eq, homEquiv_def]; exact tensorHomEquiv_apply_apply f z y
@[simp] theorem uncurry_apply (g : Z ⟶ (ihom Y).obj T) (p : ↑(Y ⊗ Z)) :
    MonoidalClosed.uncurry g p = ihomEquiv Y T (g (tensorEquiv Y Z p).2) (tensorEquiv Y Z p).1 := by
  rw [← MonoidalClosed.homEquiv_symm_apply_eq, homEquiv_def]; exact tensorHomEquiv_symm_apply g p
@[simp] theorem ihom_ev_app_apply (p : ↑(Y ⊗ (ihom Y).obj T)) :
    dsimp% (ihom.ev Y).app T p = ihomEquiv Y T (tensorEquiv Y _ p).2 (tensorEquiv Y _ p).1 := by
  simp [← MonoidalClosed.uncurry_id_eq_ev]
@[simp] theorem ihom_coev_app_apply (z : Z) (y : Y) :
    dsimp% ihomEquiv Y (Y ⊗ Z) ((ihom.coev Y).app Z z) y = (tensorEquiv Y Z).symm (y, z) := by
  simp [← MonoidalClosed.curry_id_eq_coev]
@[simp] theorem pre_app_apply (f : Y₂ ⟶ Y₁) (g : ↑((ihom Y₁).obj T)) (y₂ : Y₂) :
    ihomEquiv Y₂ T ((MonoidalClosed.pre f).app T g) y₂ = ihomEquiv Y₁ T g (f y₂) := by
  simpa using (uncurry_apply ((MonoidalClosed.pre f).app T) ((tensorEquiv Y₂ _).symm (y₂, g))).symm

@[simp] theorem ihomTensorIso_hom_apply (Y Z T : ContinuousGeneratedByCat.{v} X)
    (g : ↑((ihom (Y ⊗ Z)).obj T)) (y : Y) (z : Z) :
    ihomEquiv Z T (ihomEquiv Y ((ihom Z).obj T) ((ihomTensorIso Y Z T).hom g) y) z =
      ihomEquiv (Y ⊗ Z) T g ((tensorEquiv Y Z).symm (y, z)) := by
  simpa [MonoidalClosed.ihomTensorIso_hom] using congr($(MonoidalClosed.uncurry_uncurry_ihomCurry
    Z Y T) ((tensorEquiv Z (Y ⊗ (ihom (Z ⊗ Y)).obj T)).symm
      (z, (tensorEquiv Y ((ihom (Z ⊗ Y)).obj T)).symm
        (y, (MonoidalClosed.pre (β_ Z Y).hom).app T g))))
@[simp] theorem ihomTensorIso_inv_apply (Y Z T : ContinuousGeneratedByCat.{v} X)
    (h : ↑((ihom Y).obj ((ihom Z).obj T))) (p : ↑(Y ⊗ Z)) :
    ihomEquiv (Y ⊗ Z) T ((ihomTensorIso Y Z T).inv h) p =
      ihomEquiv Z T (ihomEquiv Y ((ihom Z).obj T) h (tensorEquiv Y Z p).1)
        (tensorEquiv Y Z p).2 := by
  simpa [show (ihomTensorIso Y Z T).hom ((ihomTensorIso Y Z T).inv h) = h from
    congr($((ihomTensorIso Y Z T).inv_hom_id) h)] using (ihomTensorIso_hom_apply Y Z T
      ((ihomTensorIso Y Z T).inv h) (tensorEquiv Y Z p).1 (tensorEquiv Y Z p).2).symm

end Closed

end ContinuousGeneratedByCat

namespace GeneratedByTopCat

/-- `PUnit` is terminal in `GeneratedByTopCat X`. -/
def isTerminalPUnit : IsTerminal (of (X := X) PUnit.{v + 1}) :=
  IsTerminal.ofUniqueHom
    (fun _ ↦ ObjectProperty.homMk (TopCat.ofHom ⟨fun _ ↦ PUnit.unit, continuous_const⟩))
    (fun _ _ ↦ by ext)

/-- The binary product fan of `Y` and `Z` in `GeneratedByTopCat X`, given by the convenient
product `WithGeneratedByTopology X (Y × Z)`. -/
@[expose] def prodBinaryFan (Y Z : GeneratedByTopCat.{v} X) : BinaryFan Y Z :=
  BinaryFan.mk
    (ObjectProperty.homMk (X := of (X := X) (WithGeneratedByTopology X (Y × Z))) <| TopCat.ofHom
      ⟨Prod.fst ∘ WithGeneratedByTopology.equiv (X := X),
        continuous_fst.comp WithGeneratedByTopology.continuous_equiv⟩)
    (ObjectProperty.homMk (X := of (X := X) (WithGeneratedByTopology X (Y × Z))) <| TopCat.ofHom
      ⟨Prod.snd ∘ WithGeneratedByTopology.equiv (X := X),
        continuous_snd.comp WithGeneratedByTopology.continuous_equiv⟩)

/-- The convenient product `WithGeneratedByTopology X (Y × Z)` is a binary product in
`GeneratedByTopCat X`. -/
def prodBinaryFanIsLimit (Y Z : GeneratedByTopCat.{v} X) : IsLimit (prodBinaryFan Y Z) :=
  BinaryFan.IsLimit.mk _
    (fun f g ↦ ObjectProperty.homMk (Y := of (X := X) (WithGeneratedByTopology X (Y × Z))) <|
      TopCat.ofHom ⟨fun w ↦ (WithGeneratedByTopology.equiv (X := X) (Y := Y × Z)).symm (f w, g w),
        (IsGeneratedBy.equiv_symm_comp_continuous_iff (X := X) _).2
          (f.hom.hom.continuous.prodMk g.hom.hom.continuous)⟩)
    (fun _ _ ↦ by ext; rfl) (fun _ _ ↦ by ext; rfl)
    (fun _ _ _ h₁ h₂ ↦ by
      ext w; exact (WithGeneratedByTopology.equiv (X := X) (Y := Y × Z)).injective
        (Prod.ext (congr($h₁ w)) (congr($h₂ w))))

/-- Chosen finite products on `GeneratedByTopCat X`, with unit `PUnit` and binary product
`WithGeneratedByTopology X (Y × Z)`. -/
instance instCartesianMonoidalCategory : CartesianMonoidalCategory (GeneratedByTopCat.{v} X) :=
  .ofChosenFiniteProducts ⟨_, isTerminalPUnit⟩
    fun Y Z ↦ ⟨prodBinaryFan Y Z, prodBinaryFanIsLimit Y Z⟩

instance instBraidedCategory : BraidedCategory (GeneratedByTopCat.{v} X) :=
  .ofCartesianMonoidalCategory

theorem tensorObj_def (Y Z : GeneratedByTopCat.{v} X) :
    Y ⊗ Z = of (X := X) (WithGeneratedByTopology X (Y × Z)) := (rfl)
theorem tensorUnit_def : 𝟙_ (GeneratedByTopCat.{v} X) = of (X := X) PUnit.{v + 1} := (rfl)

/-- The canonical bijection identifying points of `Y ⊗ Z` in `GeneratedByTopCat X` with `Y × Z`. -/
@[expose] def tensorEquiv (Y Z : GeneratedByTopCat.{v} X) : ↑(Y ⊗ Z) ≃ Y × Z :=
  WithGeneratedByTopology.equiv (X := X) (Y := Y × Z)

instance instT2SpaceTensor (Y Z : GeneratedByTopCat.{v} X) [T2Space Y] [T2Space Z] :
    T2Space ↑(Y ⊗ Z) := inferInstanceAs (T2Space (WithGeneratedByTopology X (Y × Z)))
instance instNontrivialTensorLeft (Y Z : GeneratedByTopCat.{v} X) [Nontrivial Y] [Nonempty Z] :
    Nontrivial ↑(Y ⊗ Z) := (tensorEquiv Y Z).nontrivial
instance instNontrivialTensorRight (Y Z : GeneratedByTopCat.{v} X) [Nonempty Y] [Nontrivial Z] :
    Nontrivial ↑(Y ⊗ Z) := (tensorEquiv Y Z).nontrivial

variable {W W₁ W₂ Y Y₁ Y₂ Z Z' Z₁ Z₂ T T' : GeneratedByTopCat.{v} X}

@[ext] theorem tensor_ext {p q : ↑(Y ⊗ Z)} (h : tensorEquiv Y Z p = tensorEquiv Y Z q) : p = q :=
  (tensorEquiv Y Z).injective h
@[simp] theorem fst_apply (p : ↑(Y ⊗ Z)) : fst Y Z p = (tensorEquiv Y Z p).1 := (rfl)
@[simp] theorem snd_apply (p : ↑(Y ⊗ Z)) : snd Y Z p = (tensorEquiv Y Z p).2 := (rfl)

private theorem eq_tensorEquiv_symm {p : ↑(Y ⊗ Z)} {y : Y} {z : Z}
    (h₁ : fst Y Z p = y) (h₂ : snd Y Z p = z) : p = (tensorEquiv Y Z).symm (y, z) :=
  (tensorEquiv Y Z).injective <| (Prod.ext h₁ h₂).trans ((tensorEquiv Y Z).apply_symm_apply _).symm

@[simp] theorem lift_apply (f : W ⟶ Y) (g : W ⟶ Z) (w : W) :
    CartesianMonoidalCategory.lift f g w = (tensorEquiv Y Z).symm (f w, g w) :=
  eq_tensorEquiv_symm congr($(lift_fst f g) w) congr($(lift_snd f g) w)
@[simp] theorem tensor_apply (f : W₁ ⟶ Y) (g : W₂ ⟶ Z) (p : ↑(W₁ ⊗ W₂)) :
    (f ⊗ₘ g) p = (tensorEquiv Y Z).symm (f (tensorEquiv W₁ W₂ p).1, g (tensorEquiv W₁ W₂ p).2) :=
  eq_tensorEquiv_symm congr($(tensorHom_fst f g) p) congr($(tensorHom_snd f g) p)
@[simp] theorem whiskerLeft_apply (Y : GeneratedByTopCat.{v} X) (g : Z₁ ⟶ Z₂) (p : ↑(Y ⊗ Z₁)) :
    (Y ◁ g) p = (tensorEquiv Y Z₂).symm ((tensorEquiv Y Z₁ p).1, g (tensorEquiv Y Z₁ p).2) :=
  eq_tensorEquiv_symm congr($(whiskerLeft_fst Y g) p) congr($(whiskerLeft_snd Y g) p)
@[simp] theorem whiskerRight_apply (f : Y₁ ⟶ Y₂) (Z : GeneratedByTopCat.{v} X) (p : ↑(Y₁ ⊗ Z)) :
    (f ▷ Z) p = (tensorEquiv Y₂ Z).symm (f (tensorEquiv Y₁ Z p).1, (tensorEquiv Y₁ Z p).2) :=
  eq_tensorEquiv_symm congr($(whiskerRight_fst f Z) p) congr($(whiskerRight_snd f Z) p)
@[simp] theorem braiding_hom_apply (p : ↑(Y ⊗ Z)) :
    (β_ Y Z).hom p = (tensorEquiv Z Y).symm (tensorEquiv Y Z p).swap :=
  eq_tensorEquiv_symm congr($(braiding_hom_fst Y Z) p) congr($(braiding_hom_snd Y Z) p)
@[simp] theorem braiding_inv_apply (p : ↑(Z ⊗ Y)) :
    (β_ Y Z).inv p = (tensorEquiv Y Z).symm (tensorEquiv Z Y p).swap :=
  eq_tensorEquiv_symm congr($(braiding_inv_fst Y Z) p) congr($(braiding_inv_snd Y Z) p)
@[simp] theorem associator_hom_apply (p : ↑((W ⊗ Y) ⊗ Z)) :
    (α_ W Y Z).hom p = (tensorEquiv W (Y ⊗ Z)).symm ((tensorEquiv W Y (tensorEquiv _ Z p).1).1,
      (tensorEquiv Y Z).symm ((tensorEquiv W Y (tensorEquiv _ Z p).1).2, (tensorEquiv _ Z p).2)) :=
  eq_tensorEquiv_symm congr($(associator_hom_fst W Y Z) p)
    (eq_tensorEquiv_symm congr($(associator_hom_snd_fst W Y Z) p)
      congr($(associator_hom_snd_snd W Y Z) p))
@[simp] theorem associator_inv_apply (p : ↑(W ⊗ (Y ⊗ Z))) :
    (α_ W Y Z).inv p = (tensorEquiv (W ⊗ Y) Z).symm ((tensorEquiv W Y).symm
      ((tensorEquiv W _ p).1, (tensorEquiv Y Z (tensorEquiv W _ p).2).1),
      (tensorEquiv Y Z (tensorEquiv W _ p).2).2) :=
  eq_tensorEquiv_symm (eq_tensorEquiv_symm congr($(associator_inv_fst_fst W Y Z) p)
    congr($(associator_inv_fst_snd W Y Z) p)) congr($(associator_inv_snd W Y Z) p)
@[simp] theorem leftUnitor_hom_apply (p : ↑(𝟙_ (GeneratedByTopCat.{v} X) ⊗ Y)) :
    (λ_ Y).hom p = (tensorEquiv _ Y p).2 := by rw [leftUnitor_hom, snd_apply]
@[simp] theorem leftUnitor_inv_apply (y : Y) :
    (λ_ Y).inv y = (tensorEquiv _ Y).symm (PUnit.unit, y) :=
  eq_tensorEquiv_symm (PUnit.ext _ _) congr($(Iso.inv_hom_id (λ_ Y)) y)
@[simp] theorem rightUnitor_hom_apply (p : ↑(Y ⊗ 𝟙_ (GeneratedByTopCat.{v} X))) :
    (ρ_ Y).hom p = (tensorEquiv Y _ p).1 := by rw [rightUnitor_hom, fst_apply]
@[simp] theorem rightUnitor_inv_apply (y : Y) :
    (ρ_ Y).inv y = (tensorEquiv Y _).symm (y, PUnit.unit) :=
  eq_tensorEquiv_symm congr($(Iso.inv_hom_id (ρ_ Y)) y) (PUnit.ext _ _)

/-- The constant morphism `Y ⟶ Z` with value `z : Z` in `GeneratedByTopCat X`. -/
def const (z : Z) : Y ⟶ Z := ObjectProperty.homMk (TopCat.const z)

@[simp] theorem const_apply (z : Z) (y : Y) : const z y = z := (rfl)

@[simp] theorem prodComparison_toTopCat_apply (Y Z : GeneratedByTopCat.{v} X) (p : ↑(Y ⊗ Z)) :
    dsimp% CartesianMonoidalCategory.prodComparison (toTopCat (X := X)) Y Z p = tensorEquiv Y Z p :=
  Prod.ext congr($(CartesianMonoidalCategory.prodComparison_fst (toTopCat (X := X)) Y Z) p)
    congr($(CartesianMonoidalCategory.prodComparison_snd (toTopCat (X := X)) Y Z) p)

instance preservesLimit_pair_toTopCat (Y Z : GeneratedByTopCat.{v} X) [IsGeneratedBy X (Y × Z)] :
    PreservesLimit (pair Y Z) (toTopCat (X := X)) := by
  have h : CartesianMonoidalCategory.prodComparison (toTopCat (X := X)) Y Z =
      (TopCat.isoOfHomeo (IsGeneratedBy.homeomorph (X := X) (Y := Y × Z))).hom :=
    TopCat.ext (prodComparison_toTopCat_apply Y Z)
  have : IsIso (CartesianMonoidalCategory.prodComparison (toTopCat (X := X)) Y Z) :=
    h ▸ inferInstance
  exact preservesLimit_pair_of_isIso_prodComparison (toTopCat (X := X)) Y Z

@[simp] theorem prodComparisonIso_toTopCat_inv_apply (Y Z : GeneratedByTopCat.{v} X)
    [PreservesLimit (pair Y Z) (toTopCat (X := X))] (p : Y × Z) :
    dsimp% (CartesianMonoidalCategory.prodComparisonIso (toTopCat (X := X)) Y Z).inv p =
      (tensorEquiv Y Z).symm p := by
  apply (tensorEquiv Y Z).injective; rw [Equiv.apply_symm_apply, ← prodComparison_toTopCat_apply]
  exact congr($((CartesianMonoidalCategory.prodComparisonIso (toTopCat (X := X)) Y Z).inv_hom_id) p)

private theorem equivalence_toAdjunction_homEquiv_apply {B : ContinuousGeneratedByCat.{v} X}
    (h : ContinuousGeneratedByCat.equivalence.functor.obj Z ⟶ B) (z : Z) :
    WithGeneratedByTopology.equiv (X := X) (Y := B)
      (ContinuousGeneratedByCat.equivalence.toAdjunction.homEquiv Z B h z) = h z := by
  rw [Adjunction.homEquiv_unit]; exact (ContinuousGeneratedByCat.toGeneratedByTopCat_map_apply h
    (ContinuousGeneratedByCat.equivalence.toAdjunction.unit.app Z z)).trans
    ((Equiv.apply_symm_apply _ _).trans (congrArg h (Equiv.apply_symm_apply _ z)))
private theorem equivalence_symm_toAdjunction_homEquiv_apply {A : ContinuousGeneratedByCat.{v} X}
    (f : ContinuousGeneratedByCat.equivalence.symm.functor.obj A ⟶ T) (a : A) :
    ContinuousGeneratedByCat.equivalence.symm.toAdjunction.homEquiv A T f a =
      f ((WithGeneratedByTopology.equiv (X := X) (Y := A)).symm a) := by
  rw [Adjunction.homEquiv_unit, CategoryTheory.comp_apply]
  dsimp [ContinuousGeneratedByCat.equivalence, ContinuousGeneratedByCat.adjUnitIso]; rfl

section Closed

variable [∀ i, LocallyCompactSpace (X i)] [∀ i j, IsGeneratedBy X (X i × X j)]

section ProdComparison

variable (Y Z : GeneratedByTopCat.{v} X)

instance preservesLimit_pair_toTopCat_of_locallyCompactSpace_left [LocallyCompactSpace Y] :
    PreservesLimit (pair Y Z) (toTopCat (X := X)) :=
  have := IsGeneratedBy.prod_of_locallyCompactSpace_left (X := X) (Y := Y) (Z := Z); inferInstance
instance preservesLimit_pair_toTopCat_of_locallyCompactSpace_right [LocallyCompactSpace Z] :
    PreservesLimit (pair Y Z) (toTopCat (X := X)) :=
  have := IsGeneratedBy.prod_of_locallyCompactSpace_right (X := X) (Y := Y) (Z := Z); inferInstance

/-- Suppose `[∀ i, LocallyCompactSpace (X i)]` and `[∀ i j, IsGeneratedBy X (X i × X j)]`. When `Y`
is locally compact, `CartesianMonoidalCategory.prodComparison toTopCat Y Z` upgrades to an
isomorphism `(Y ⊗ Z).obj ≅ Y.obj ⊗ Z.obj` in `TopCat`. -/
def prodComparisonIsoOfLocallyCompactLeft [LocallyCompactSpace Y] : (Y ⊗ Z).obj ≅ Y.obj ⊗ Z.obj :=
  CartesianMonoidalCategory.prodComparisonIso (toTopCat (X := X)) Y Z

@[simp] theorem prodComparisonIsoOfLocallyCompactLeft_hom [LocallyCompactSpace Y] :
    (prodComparisonIsoOfLocallyCompactLeft Y Z).hom =
      CartesianMonoidalCategory.prodComparison (toTopCat (X := X)) Y Z := (rfl)
@[simp] theorem prodComparisonIsoOfLocallyCompactLeft_inv_apply [LocallyCompactSpace Y]
    (p : Y × Z) : dsimp% (prodComparisonIsoOfLocallyCompactLeft Y Z).inv p =
      (tensorEquiv Y Z).symm p := prodComparisonIso_toTopCat_inv_apply Y Z p

/-- Suppose `[∀ i, LocallyCompactSpace (X i)]` and `[∀ i j, IsGeneratedBy X (X i × X j)]`. When `Z`
is locally compact, `CartesianMonoidalCategory.prodComparison toTopCat Y Z` upgrades to an
isomorphism `(Y ⊗ Z).obj ≅ Y.obj ⊗ Z.obj` in `TopCat`. -/
def prodComparisonIsoOfLocallyCompactRight [LocallyCompactSpace Z] : (Y ⊗ Z).obj ≅ Y.obj ⊗ Z.obj :=
  CartesianMonoidalCategory.prodComparisonIso (toTopCat (X := X)) Y Z

@[simp] theorem prodComparisonIsoOfLocallyCompactRight_hom [LocallyCompactSpace Z] :
    (prodComparisonIsoOfLocallyCompactRight Y Z).hom =
      CartesianMonoidalCategory.prodComparison (toTopCat (X := X)) Y Z := (rfl)
@[simp] theorem prodComparisonIsoOfLocallyCompactRight_inv_apply [LocallyCompactSpace Z]
    (p : Y × Z) : dsimp% (prodComparisonIsoOfLocallyCompactRight Y Z).inv p =
      (tensorEquiv Y Z).symm p := prodComparisonIso_toTopCat_inv_apply Y Z p

end ProdComparison

/-- The internal hom functor on `GeneratedByTopCat X`, transported from `ContinuousGeneratedByCat X`
along `ContinuousGeneratedByCat.equivalence` so that `(GeneratedByTopCat.ihom Y).obj T` is
`WithGeneratedByTopology X (ContinuousMapGeneratedBy X Y T)`. -/
@[expose] protected def ihom (Y : GeneratedByTopCat.{v} X) :
    GeneratedByTopCat.{v} X ⥤ GeneratedByTopCat.{v} X :=
  ContinuousGeneratedByCat.fromGeneratedByTopCat ⋙
    ContinuousGeneratedByCat.ihom (ContinuousGeneratedByCat.fromGeneratedByTopCat.obj Y) ⋙
    ContinuousGeneratedByCat.toGeneratedByTopCat

/-- Suppose `[∀ i, LocallyCompactSpace (X i)]` and `[∀ i j, IsGeneratedBy X (X i × X j)]`. Currying
in `GeneratedByTopCat X` transports `ContinuousGeneratedByCat.tensorHomEquiv` across
`ContinuousGeneratedByCat.equivalence`. -/
def tensorHomEquiv (Y Z T : GeneratedByTopCat.{v} X) :
    (Y ⊗ Z ⟶ T) ≃ (Z ⟶ (GeneratedByTopCat.ihom Y).obj T) :=
  let F := ContinuousGeneratedByCat.fromGeneratedByTopCat (X := X)
  (ContinuousGeneratedByCat.equivalence.symm.toAdjunction.homEquiv (F.obj Y ⊗ F.obj Z) T).trans <|
    (ContinuousGeneratedByCat.tensorHomEquiv (F.obj Y) (F.obj Z) (F.obj T)).trans
      (ContinuousGeneratedByCat.equivalence.toAdjunction.homEquiv Z _)

private theorem tensorHomEquiv_apply_aux (f : Y ⊗ Z ⟶ T) (z : Z) (y : Y) :
    WithGeneratedByTopology.equiv (X := X) (Y := ContinuousMapGeneratedBy X Y T)
      (tensorHomEquiv Y Z T f z) y = f ((tensorEquiv Y Z).symm (y, z)) := by
  let F := ContinuousGeneratedByCat.fromGeneratedByTopCat (X := X)
  let f₁ := ContinuousGeneratedByCat.equivalence.symm.toAdjunction.homEquiv (F.obj Y ⊗ F.obj Z) T f
  let f₂ := ContinuousGeneratedByCat.tensorHomEquiv (F.obj Y) (F.obj Z) (F.obj T) f₁
  exact (congrArg (fun k : ContinuousMapGeneratedBy X Y T ↦ k y)
    (equivalence_toAdjunction_homEquiv_apply f₂ z)).trans
    ((ContinuousGeneratedByCat.tensorHomEquiv_apply_apply f₁ z y).trans
      (equivalence_symm_toAdjunction_homEquiv_apply f
        ((ContinuousGeneratedByCat.tensorEquiv (F.obj Y) (F.obj Z)).symm (y, z))))

private theorem tensorHomEquiv_symm_apply_aux (g : Z ⟶ (GeneratedByTopCat.ihom Y).obj T)
    (p : ↑(Y ⊗ Z)) : (tensorHomEquiv Y Z T).symm g p =
      WithGeneratedByTopology.equiv (X := X) (Y := ContinuousMapGeneratedBy X Y T)
        (g (tensorEquiv Y Z p).2) (tensorEquiv Y Z p).1 :=
  let h := (tensorHomEquiv Y Z T).apply_symm_apply g
  (congrArg ((tensorHomEquiv Y Z T).symm g) ((tensorEquiv Y Z).symm_apply_apply p).symm).trans <|
    (tensorHomEquiv_apply_aux ((tensorHomEquiv Y Z T).symm g)
      (tensorEquiv Y Z p).2 (tensorEquiv Y Z p).1).symm.trans <|
      congrArg (fun k ↦ WithGeneratedByTopology.equiv (X := X)
        (Y := ContinuousMapGeneratedBy X Y T) (k (tensorEquiv Y Z p).2) (tensorEquiv Y Z p).1) h

theorem tensorHomEquiv_symm_comp (f : Z' ⟶ Z) (g : Z ⟶ (GeneratedByTopCat.ihom Y).obj T) :
    (tensorHomEquiv Y Z' T).symm (f ≫ g) = Y ◁ f ≫ (tensorHomEquiv Y Z T).symm g :=
  ConcreteCategory.hom_ext _ _ fun p ↦ by simp [tensorHomEquiv_symm_apply_aux]

theorem tensorHomEquiv_comp (f : Y ⊗ Z ⟶ T) (g : T ⟶ T') :
    tensorHomEquiv Y Z T' (f ≫ g) = tensorHomEquiv Y Z T f ≫ (GeneratedByTopCat.ihom Y).map g :=
  ConcreteCategory.hom_ext _ _ fun z ↦ (WithGeneratedByTopology.equiv (X := X)
    (Y := ContinuousMapGeneratedBy X Y T')).injective <| DFunLike.ext _ _ fun y ↦
      (tensorHomEquiv_apply_aux (f ≫ g) z y).trans
        (congrArg g (tensorHomEquiv_apply_aux f z y).symm)

/-- **Cartesian closedness of `GeneratedByTopCat X`.**
When every test space `X i` is locally compact and every pairwise product `X i × X j` is
`X`-generated, `GeneratedByTopCat X` is cartesian monoidal closed. -/
instance instMonoidalClosed : MonoidalClosed (GeneratedByTopCat.{v} X) where
  closed Y :=
    { rightAdj := GeneratedByTopCat.ihom Y
      adj := Adjunction.mkOfHomEquiv
        { homEquiv := tensorHomEquiv Y
          homEquiv_naturality_left_symm := tensorHomEquiv_symm_comp
          homEquiv_naturality_right := tensorHomEquiv_comp } }

theorem homEquiv_def (Y Z T : GeneratedByTopCat.{v} X) :
    (ihom.adjunction Y).homEquiv Z T = tensorHomEquiv Y Z T :=
  congrFun (congrFun (Adjunction.mkOfHomEquiv_homEquiv _) _) _
theorem ihom_obj_def (Y T : GeneratedByTopCat.{v} X) :
    (ihom Y).obj T = of (X := X) (WithGeneratedByTopology X (ContinuousMapGeneratedBy X Y T)) :=
  (rfl)
theorem ihom_map_def (p : T ⟶ T') : (ihom Y).map p = (GeneratedByTopCat.ihom Y).map p := (rfl)

/-- The canonical bijection identifying points of `(ihom Y).obj T` in `GeneratedByTopCat X` with
`X`-continuous maps `Y → T`. -/
@[expose] def ihomEquiv (Y T : GeneratedByTopCat.{v} X) :
    ↑((ihom Y).obj T) ≃ ContinuousMapGeneratedBy X Y T :=
  WithGeneratedByTopology.equiv (X := X)

instance instNontrivialIhom (Y T : GeneratedByTopCat.{v} X) [Nonempty Y] [Nontrivial T] :
    Nontrivial ↑((ihom Y).obj T) :=
  inferInstanceAs (Nontrivial (WithGeneratedByTopology X (ContinuousMapGeneratedBy X Y T)))

@[ext] theorem ihom_obj_ext {f g : ↑((ihom Y).obj T)}
    (h : ∀ y, ihomEquiv Y T f y = ihomEquiv Y T g y) : f = g :=
  (ihomEquiv Y T).injective (DFunLike.ext _ _ h)
@[simp] theorem ihom_map_apply (p : T ⟶ T') (g : ↑((ihom Y).obj T)) (y : Y) :
    ihomEquiv Y T' ((ihom Y).map p g) y = p (ihomEquiv Y T g y) := (rfl)
@[simp] theorem tensorHomEquiv_apply_apply (f : Y ⊗ Z ⟶ T) (z : Z) (y : Y) :
    ihomEquiv Y T (tensorHomEquiv Y Z T f z) y = f ((tensorEquiv Y Z).symm (y, z)) :=
  tensorHomEquiv_apply_aux f z y
@[simp] theorem tensorHomEquiv_symm_apply (g : Z ⟶ (GeneratedByTopCat.ihom Y).obj T)
    (p : ↑(Y ⊗ Z)) : (tensorHomEquiv Y Z T).symm g p =
      ihomEquiv Y T (g (tensorEquiv Y Z p).2) (tensorEquiv Y Z p).1 :=
  tensorHomEquiv_symm_apply_aux g p
@[simp] theorem curry_apply (f : Y ⊗ Z ⟶ T) (z : Z) (y : Y) :
    ihomEquiv Y T (MonoidalClosed.curry f z) y = f ((tensorEquiv Y Z).symm (y, z)) := by
  rw [← MonoidalClosed.homEquiv_apply_eq, homEquiv_def]; exact tensorHomEquiv_apply_apply f z y
@[simp] theorem uncurry_apply (g : Z ⟶ (ihom Y).obj T) (p : ↑(Y ⊗ Z)) :
    MonoidalClosed.uncurry g p = ihomEquiv Y T (g (tensorEquiv Y Z p).2) (tensorEquiv Y Z p).1 := by
  rw [← MonoidalClosed.homEquiv_symm_apply_eq, homEquiv_def]; exact tensorHomEquiv_symm_apply g p
@[simp] theorem ihom_ev_app_apply (p : ↑(Y ⊗ (ihom Y).obj T)) :
    dsimp% (ihom.ev Y).app T p = ihomEquiv Y T (tensorEquiv Y _ p).2 (tensorEquiv Y _ p).1 := by
  simp [← MonoidalClosed.uncurry_id_eq_ev]
@[simp] theorem ihom_coev_app_apply (z : Z) (y : Y) :
    dsimp% ihomEquiv Y (Y ⊗ Z) ((ihom.coev Y).app Z z) y = (tensorEquiv Y Z).symm (y, z) := by
  simp [← MonoidalClosed.curry_id_eq_coev]
@[simp] theorem pre_app_apply (f : Y₂ ⟶ Y₁) (g : ↑((ihom Y₁).obj T)) (y₂ : Y₂) :
    ihomEquiv Y₂ T ((MonoidalClosed.pre f).app T g) y₂ = ihomEquiv Y₁ T g (f y₂) := by
  simpa using (uncurry_apply ((MonoidalClosed.pre f).app T) ((tensorEquiv Y₂ _).symm (y₂, g))).symm

/-- Evaluation of the internal hom `(ihom Y).obj T` at a point `y : Y`. -/
def evalHom (T : GeneratedByTopCat.{v} X) (y : Y) : (ihom Y).obj T ⟶ T :=
  (λ_ _).inv ≫ (const y ▷ _) ≫ (ihom.ev Y).app T

@[simp] theorem evalHom_apply (T : GeneratedByTopCat.{v} X) (y : Y) (g : ↑((ihom Y).obj T)) :
    evalHom T y g = ihomEquiv Y T g y := by simp [evalHom]

@[simp] theorem ihomTensorIso_hom_apply (Y Z T : GeneratedByTopCat.{v} X)
    (g : ↑((ihom (Y ⊗ Z)).obj T)) (y : Y) (z : Z) :
    ihomEquiv Z T (ihomEquiv Y ((ihom Z).obj T) ((ihomTensorIso Y Z T).hom g) y) z =
      ihomEquiv (Y ⊗ Z) T g ((tensorEquiv Y Z).symm (y, z)) := by
  simpa [MonoidalClosed.ihomTensorIso_hom] using congr($(MonoidalClosed.uncurry_uncurry_ihomCurry
    Z Y T) ((tensorEquiv Z (Y ⊗ (ihom (Z ⊗ Y)).obj T)).symm
      (z, (tensorEquiv Y ((ihom (Z ⊗ Y)).obj T)).symm
        (y, (MonoidalClosed.pre (β_ Z Y).hom).app T g))))
@[simp] theorem ihomTensorIso_inv_apply (Y Z T : GeneratedByTopCat.{v} X)
    (h : ↑((ihom Y).obj ((ihom Z).obj T))) (p : ↑(Y ⊗ Z)) :
    ihomEquiv (Y ⊗ Z) T ((ihomTensorIso Y Z T).inv h) p =
      ihomEquiv Z T (ihomEquiv Y ((ihom Z).obj T) h (tensorEquiv Y Z p).1)
        (tensorEquiv Y Z p).2 := by
  simpa [show (ihomTensorIso Y Z T).hom ((ihomTensorIso Y Z T).inv h) = h from
    congr($((ihomTensorIso Y Z T).inv_hom_id) h)] using (ihomTensorIso_hom_apply Y Z T
      ((ihomTensorIso Y Z T).inv h) (tensorEquiv Y Z p).1 (tensorEquiv Y Z p).2).symm

instance instIsGeneratedByFromGeneratedByTopCat (Y : GeneratedByTopCat.{v} X) :
    IsGeneratedBy X (ContinuousGeneratedByCat.fromGeneratedByTopCat.obj Y) := Y.property

/-- Suppose `[∀ i, LocallyCompactSpace (X i)]` and `[∀ i j, IsGeneratedBy X (X i × X j)]`. For
every `Y, T : GeneratedByTopCat X`, `(ihom Y).obj T` is canonically isomorphic to the `X`-generated
refinement of the compact-open mapping space `C(Y, T)`. -/
def ihomIsoCompactOpen (Y T : GeneratedByTopCat.{v} X) :
    (ihom Y).obj T ≅ of (X := X) (WithGeneratedByTopology X C(Y, T)) :=
  ObjectProperty.isoMk (TopCat.generatedBy X)
    (TopCat.isoOfHomeo (ContinuousMapGeneratedBy.generatedByHomeomorphContinuousMap (X := X)))

@[simp] theorem ihomIsoCompactOpen_hom_apply (Y T : GeneratedByTopCat.{v} X)
    (g : ↑((ihom Y).obj T)) (y : Y) :
    dsimp% WithGeneratedByTopology.equiv (X := X) (Y := C(Y, T))
      ((ihomIsoCompactOpen Y T).hom g) y = ihomEquiv Y T g y :=
  congr($(ContinuousMapGeneratedBy.generatedByHomeomorphContinuousMap_apply (X := X) g) y).trans
    (ContinuousMapGeneratedBy.toContinuousMap_apply _ y)
@[simp] theorem ihomIsoCompactOpen_inv_apply (Y T : GeneratedByTopCat.{v} X)
    (f : WithGeneratedByTopology X C(Y, T)) (y : Y) :
    ihomEquiv Y T (dsimp% (ihomIsoCompactOpen Y T).inv f) y =
      WithGeneratedByTopology.equiv (X := X) (Y := C(Y, T)) f y :=
  congr($(ContinuousMapGeneratedBy.generatedByHomeomorphContinuousMap_symm_apply
    (X := X) (Y := Y) (T := T) f) y).trans (ContinuousMap.toContinuousMapGeneratedBy_apply _ y)

/-- Suppose `[∀ i, LocallyCompactSpace (X i)]` and `[∀ i j, IsGeneratedBy X (X i × X j)]`. For
arbitrary `Y, Z, T : GeneratedByTopCat X`, the `X`-generated refinement of `C(↑(Y ⊗ Z), T)` is
canonically isomorphic to the `X`-generated refinement of
`C(Y, WithGeneratedByTopology X C(Z, T))`. -/
def compactOpenCurryIso (Y Z T : GeneratedByTopCat.{v} X) :
    of (X := X) (WithGeneratedByTopology X C(↑(Y ⊗ Z), T)) ≅
      of (X := X) (WithGeneratedByTopology X C(Y, WithGeneratedByTopology X C(Z, T))) :=
  (ihomIsoCompactOpen (Y ⊗ Z) T).symm ≪≫ ihomTensorIso Y Z T ≪≫
    (ihom Y).mapIso (ihomIsoCompactOpen Z T) ≪≫ ihomIsoCompactOpen Y _

@[simp] theorem compactOpenCurryIso_hom_apply (Y Z T : GeneratedByTopCat.{v} X)
    (f : WithGeneratedByTopology X C(↑(Y ⊗ Z), T)) (y : Y) (z : Z) :
    dsimp% WithGeneratedByTopology.equiv (X := X) (Y := C(Z, T))
      (WithGeneratedByTopology.equiv (X := X) (Y := C(Y, WithGeneratedByTopology X C(Z, T)))
        ((compactOpenCurryIso Y Z T).hom f) y) z =
      WithGeneratedByTopology.equiv (X := X) (Y := C(↑(Y ⊗ Z), T)) f
        ((tensorEquiv Y Z).symm (y, z)) := by
  let g₁ := (ihomIsoCompactOpen (Y ⊗ Z) T).inv f; let g₂ := (ihomTensorIso Y Z T).hom g₁
  exact (congrArg (fun h : WithGeneratedByTopology X C(Z, T) ↦
    WithGeneratedByTopology.equiv (X := X) (Y := C(Z, T)) h z)
    ((ihomIsoCompactOpen_hom_apply Y _ ((ihom Y).map (ihomIsoCompactOpen Z T).hom g₂) y).trans
      (ihom_map_apply (ihomIsoCompactOpen Z T).hom g₂ y))).trans <|
    (ihomIsoCompactOpen_hom_apply Z T (ihomEquiv Y _ g₂ y) z).trans <|
      (ihomTensorIso_hom_apply Y Z T g₁ y z).trans
        (ihomIsoCompactOpen_inv_apply (Y ⊗ Z) T f ((tensorEquiv Y Z).symm (y, z)))
@[simp] theorem compactOpenCurryIso_inv_apply (Y Z T : GeneratedByTopCat.{v} X)
    (g : WithGeneratedByTopology X C(Y, WithGeneratedByTopology X C(Z, T))) (p : ↑(Y ⊗ Z)) :
    dsimp% WithGeneratedByTopology.equiv (X := X) (Y := C(↑(Y ⊗ Z), T))
      ((compactOpenCurryIso Y Z T).inv g) p =
      WithGeneratedByTopology.equiv (X := X) (Y := C(Z, T))
        (WithGeneratedByTopology.equiv (X := X)
          (Y := C(Y, WithGeneratedByTopology X C(Z, T))) g (tensorEquiv Y Z p).1)
        (tensorEquiv Y Z p).2 := by
  simpa [show (compactOpenCurryIso Y Z T).hom ((compactOpenCurryIso Y Z T).inv g) = g from
    congr($((compactOpenCurryIso Y Z T).inv_hom_id) g)] using (compactOpenCurryIso_hom_apply Y Z T
      ((compactOpenCurryIso Y Z T).inv g) (tensorEquiv Y Z p).1 (tensorEquiv Y Z p).2).symm

end Closed

end GeneratedByTopCat

end
