module

public import Mathlib.Topology.Convenient.Category
public import TauCeti.Topology.Convenient.GeneratedBy

/-!
# Categorical API for `GeneratedByTopCat`

This file supplements Mathlib's `Mathlib.Topology.Convenient.Category` for the coreflective full
subcategory `GeneratedByTopCat` of `TopCat`:

* pointwise evaluation lemmas for
  `TopCat.toGeneratedByTopCat`, `GeneratedByTopCat`, `GeneratedByTopCat.adjUnitIso`,
  `GeneratedByTopCat.adjCounit`, and `GeneratedByTopCat.adj.homEquiv`;
* counit characterization (`GeneratedByTopCat.isIso_adjCounit_app_iff`) and instance
  `GeneratedByTopCat.instIsIsoAdjCounitApp` when `X` is generated by `G`;
* natural functor comparison `TauCeti.generatedByFunctorIso` for functors inverting the
  generated-topology counit;
* `Small`-indexed and `UnivLE`-sized limits and colimits on `GeneratedByTopCat`, together with
  creation of colimits by `GeneratedByTopCat.toTopCat`.

## References

* R. M. Vogt, *Convenient categories of topological spaces for homotopy theory*, Arch. Math.
  (Basel) 22 (1971), 545–555.
* M. Escardó, J. Lawson, and A. Simpson, *Comparing Cartesian closed categories of (core)
  compactly generated spaces*, Topology Appl. 143 (2004), 105–145.
-/

public section

universe w' v' v t u

namespace TopCat

variable {ι : Type t} (G : ι → Type u) [∀ i, TopologicalSpace (G i)]

@[simp] theorem toGeneratedByTopCat_obj_obj (X : TopCat.{v}) :
    ((TopCat.toGeneratedByTopCat (X := G)).obj X).obj =
      TopCat.of (Topology.WithGeneratedByTopology G X) := (rfl)

@[simp] theorem toGeneratedByTopCat_map_apply {X Y : TopCat.{v}} (f : X ⟶ Y)
    (x : ↑((TopCat.toGeneratedByTopCat (X := G)).obj X)) :
    (TopCat.toGeneratedByTopCat (X := G)).map f x =
      (Topology.WithGeneratedByTopology.equiv (X := G)).symm
        (f (Topology.WithGeneratedByTopology.equiv (X := G) x)) := (rfl)

/-- Applying `WithGeneratedByTopology.equiv` after `(TopCat.toGeneratedByTopCat.map f)` evaluates
`f` on `WithGeneratedByTopology.equiv x`. -/
theorem equiv_toGeneratedByTopCat_map_apply {X Y : TopCat.{v}} (f : X ⟶ Y)
    (x : ↑((TopCat.toGeneratedByTopCat (X := G)).obj X)) :
    Topology.WithGeneratedByTopology.equiv (X := G)
        ((TopCat.toGeneratedByTopCat (X := G)).map f x) =
      f (Topology.WithGeneratedByTopology.equiv (X := G) x) :=
  Equiv.apply_symm_apply _ _

end TopCat

namespace GeneratedByTopCat

open CategoryTheory Limits Topology

section Morphisms

variable {ι : Type t} {X : ι → Type u} [∀ i, TopologicalSpace (X i)]

@[simp] theorem hom_apply {Y Z : GeneratedByTopCat.{v} X} (f : Y ⟶ Z) (y : Y) :
    f.hom y = f y := (rfl)

end Morphisms

section ExplicitFamily

variable {ι : Type t} (G : ι → Type u) [∀ i, TopologicalSpace (G i)]

@[simp] theorem adjUnitIso_hom_app_apply (Y : GeneratedByTopCat.{v} G) (y : Y) :
    ConcreteCategory.hom (X := Y) (Y := (TopCat.toGeneratedByTopCat (X := G)).obj Y.obj)
      ((adjUnitIso (X := G)).hom.app Y) y =
      (WithGeneratedByTopology.equiv (X := G)).symm y := (rfl)

@[simp] theorem adjUnitIso_inv_app_apply (Y : GeneratedByTopCat.{v} G)
    (y : ↑((TopCat.toGeneratedByTopCat (X := G)).obj Y.obj)) :
    ConcreteCategory.hom (X := (TopCat.toGeneratedByTopCat (X := G)).obj Y.obj) (Y := Y)
      ((adjUnitIso (X := G)).inv.app Y) y =
      WithGeneratedByTopology.equiv (X := G) (Y := Y.obj) y := (rfl)

/-- The underlying continuous map of the categorical counit is the generated-topology counit. -/
@[simp]
theorem adjCounit_app_hom (X : TopCat.{v}) :
    ((adjCounit (X := G)).app X).hom = Topology.WithGeneratedByTopology.counit G X :=
  ContinuousMap.ext fun x ↦ (Topology.WithGeneratedByTopology.counit_apply G (X := X) x).symm

/-- Refining the counit gives the counit at the refined space after forgetting to `TopCat`. -/
@[simp]
theorem toGeneratedByTopCat_map_adjCounit_hom (X : TopCat.{v}) :
    dsimp% (((TopCat.toGeneratedByTopCat (X := G)).map ((adjCounit (X := G)).app X)).hom =
      (adjCounit (X := G)).app ((TopCat.toGeneratedByTopCat (X := G)).obj X).obj) :=
  (CategoryTheory.counit_obj_eq_map_counit (toTopCat (X := G)) X).symm

/-- The categorical counit at `X` is an isomorphism in `TopCat` if and only if `X` is generated by
`G`. -/
theorem isIso_adjCounit_app_iff (X : TopCat.{v}) :
    CategoryTheory.IsIso ((adjCounit (X := G)).app X) ↔ Topology.IsGeneratedBy G X := by
  rw [TopCat.isIso_iff_isHomeomorph]
  -- `TopCat.isIso_iff_isHomeomorph` states `IsHomeomorph ⇑(ConcreteCategory.hom _)`, whereas
  -- `adjCounit_app_hom` rewrites `TopCat.Hom.hom`.
  exact (iff_of_eq (congrArg (fun f : C(_, _) ↦ IsHomeomorph (f : _ → _))
    (adjCounit_app_hom G X))).trans
    (Topology.WithGeneratedByTopology.isHomeomorph_counit_iff G X)

theorem adjCounit_app_apply (X : TopCat.{v})
    (x : ↑((TopCat.toGeneratedByTopCat (X := G)).obj X)) :
    ConcreteCategory.hom (X := ((TopCat.toGeneratedByTopCat (X := G)).obj X).obj) (Y := X)
      ((adjCounit (X := G)).app X) x =
      WithGeneratedByTopology.equiv (X := G) (Y := X) x := (rfl)

@[simp] theorem adj_homEquiv_apply {Y : GeneratedByTopCat.{v} G} {X : TopCat.{v}}
    (f : toTopCat.obj Y ⟶ X) (y : Y) :
    dsimp% ((adj (X := G)).homEquiv Y X f) y =
      (WithGeneratedByTopology.equiv (X := G)).symm (f y) := (rfl)

@[simp] theorem adj_homEquiv_symm_apply {Y : GeneratedByTopCat.{v} G} {X : TopCat.{v}}
    (g : Y ⟶ (TopCat.toGeneratedByTopCat (X := G)).obj X) (y : Y) :
    dsimp% (((adj (X := G)).homEquiv Y X).symm g) y =
      WithGeneratedByTopology.equiv (X := G) (Y := X) (g y) := by
  rw [Adjunction.homEquiv_counit]
  simp [-adjCounit_app_hom, adjCounit_app_apply]

end ExplicitFamily

section Instances

variable {ι : Type t} {G : ι → Type u} [∀ i, TopologicalSpace (G i)]

/-- On a space already generated by `G`, the categorical counit is an isomorphism. -/
instance instIsIsoAdjCounitApp (X : TopCat.{v}) [Topology.IsGeneratedBy G X] :
    IsIso ((adjCounit (X := G)).app X) :=
  (isIso_adjCounit_app_iff G X).2 inferInstance

instance (X : TopCat.{v}) [Topology.IsGeneratedBy G X] : IsIso ((adj (X := G)).counit.app X) := by
  rw [adj_counit]; infer_instance

noncomputable instance instCreatesColimitsOfSizeToTopCat :
    CreatesColimitsOfSize.{w', v'} (toTopCat.{v} (X := G)) :=
  comonadicCreatesColimits _

instance {J : Type v'} [Category.{w'} J] [Small.{v} J] :
    HasLimitsOfShape J (GeneratedByTopCat.{v} G) :=
  hasLimitsOfShape_of_coreflective toTopCat

instance {J : Type v'} [Category.{w'} J] [Small.{v} J] :
    HasColimitsOfShape J (GeneratedByTopCat.{v} G) :=
  hasColimitsOfShape_of_coreflective toTopCat

instance [UnivLE.{v', v}] : HasLimitsOfSize.{w', v'} (GeneratedByTopCat.{v} G) :=
  hasLimits_of_coreflective toTopCat

instance [UnivLE.{v', v}] : HasColimitsOfSize.{w', v'} (GeneratedByTopCat.{v} G) :=
  hasColimits_of_coreflective toTopCat

end Instances

end GeneratedByTopCat

namespace TauCeti

open CategoryTheory

variable {ι : Type t} (G : ι → Type u) [∀ i, TopologicalSpace (G i)]
  {D : Type v'} [Category.{w'} D] (F : TopCat.{v} ⥤ D)
  [∀ X, IsIso (F.map ((GeneratedByTopCat.adjCounit (X := G)).app X))]

/-- A functor inverting generated-topology counits is naturally unchanged by refinement. -/
noncomputable def generatedByFunctorIso :
    (TopCat.toGeneratedByTopCat (X := G) ⋙ GeneratedByTopCat.toTopCat) ⋙ F ≅ F := by
  have (X : TopCat.{v}) :
      IsIso ((Functor.whiskerRight (GeneratedByTopCat.adjCounit (X := G)) F).app X) :=
    inferInstanceAs (IsIso (F.map ((GeneratedByTopCat.adjCounit (X := G)).app X)))
  have := NatIso.isIso_of_isIso_app
    (Functor.whiskerRight (GeneratedByTopCat.adjCounit (X := G)) F)
  exact asIso (Functor.whiskerRight (GeneratedByTopCat.adjCounit (X := G)) F)

/-- The forward comparison is the image of the refinement counit. -/
@[simp]
theorem generatedByFunctorIso_hom_app (X : TopCat.{v}) :
    (generatedByFunctorIso G F).hom.app X = F.map ((GeneratedByTopCat.adjCounit (X := G)).app X) :=
  (rfl)

/-- The inverse comparison is the inverse of the image of the refinement counit. -/
theorem generatedByFunctorIso_inv_app (X : TopCat.{v}) :
    (generatedByFunctorIso G F).inv.app X =
      inv (F.map ((GeneratedByTopCat.adjCounit (X := G)).app X)) := by
  simpa only [IsIso.Iso.inv_hom, generatedByFunctorIso_hom_app] using
    NatIso.isIso_inv_app (generatedByFunctorIso G F).hom X

end TauCeti
