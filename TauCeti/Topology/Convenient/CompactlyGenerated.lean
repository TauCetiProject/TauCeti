module

public import TauCeti.Topology.Compactness.CompactlyGeneratedSpace
public import TauCeti.Topology.Convenient.HomSpace

/-!
# Compact Hausdorff generators

Mathlib provides both compact generation (`TopologicalSpace.compactlyGenerated`,
`UCompactlyGeneratedSpace`) and generation by an arbitrary family of spaces
(`TopologicalSpace.generatedBy`, `Topology.IsGeneratedBy`). Evaluating the latter at the family
`fun K : CompHaus.{u} ↦ K` of compact Hausdorff spaces in universe `u` identifies the two notions
(`TopologicalSpace.generatedBy_compHaus`, `Topology.isGeneratedBy_compHaus_iff`), with `u`
independent of the universe of the space being refined.

Specializing the general generated-space product and hom-space comparisons to `CompHaus.{u}` yields:

* `Topology.ContinuousMapGeneratedBy.homeomorphContinuousMapOfT2`: for a `u`-small Hausdorff
  `u`-compactly generated space `Y`, `CompHaus.{u}`-continuous maps `Y → Z` form a space
  homeomorphic to the compact-open mapping space `C(Y, Z)`.
* `TauCeti.uCompactlyGeneratedSpace_prod_of_locallyCompactSpace_right` and
  `TauCeti.uCompactlyGeneratedSpace_prod_of_locallyCompactSpace_left`: the ordinary product of two
  `u`-compactly generated spaces is `u`-compactly generated whenever one factor is locally compact.

For the categorical equivalence `CompactlyGenerated.{u, w} ≌ GeneratedByTopCat.{w} ...`, the
coreflection in `TopCat`, and the cartesian closed structure on `CompactlyGenerated`, see
`TauCeti.Topology.Category.CompactlyGenerated.Basic` and
`TauCeti.Topology.Category.CompactlyGenerated.CartesianClosed`.

## References

* R. M. Vogt, *Convenient categories of topological spaces for homotopy theory*, Arch. Math.
  (Basel) 22 (1971), 545–555.
* M. Escardó, J. Lawson, and A. Simpson, *Comparing Cartesian closed categories of (core)
  compactly generated spaces*, Topology Appl. 143 (2004), 105–145.
* J. H. C. Whitehead, *Note on a theorem due to Borsuk*, Bull. Amer. Math. Soc. 54 (1948),
  1125–1132.
-/

public section

universe u v w

namespace TopologicalSpace

/-- Generation by all compact Hausdorff spaces is compact generation. -/
theorem generatedBy_compHaus (Y : Type v) [TopologicalSpace Y] :
    generatedBy (fun K : CompHaus.{u} ↦ K) (Y := Y) = compactlyGenerated.{u} Y := by
  rw [generatedBy_eq_coinduced]
  rfl

end TopologicalSpace

namespace Topology

/-- The two compact-generation predicates agree, with the same test-space universe. -/
theorem isGeneratedBy_compHaus_iff (Y : Type v) [TopologicalSpace Y] :
    IsGeneratedBy (fun K : CompHaus.{u} ↦ K) Y ↔ UCompactlyGeneratedSpace.{u} Y := by
  rw [IsGeneratedBy.iff_le_generatedBy, TopologicalSpace.generatedBy_compHaus]
  exact ⟨fun h ↦ ⟨h⟩, fun h ↦ h.le_compactlyGenerated⟩

/-- Compactly generated spaces are generated by the family of compact Hausdorff spaces. -/
instance (Y : Type v) [TopologicalSpace Y] [UCompactlyGeneratedSpace.{u} Y] :
    IsGeneratedBy (fun K : CompHaus.{u} ↦ K) Y :=
  (isGeneratedBy_compHaus_iff Y).2 inferInstance

/-- The compactly generated refinement of any topological space is `u`-compactly generated. -/
instance (Y : Type v) [TopologicalSpace Y] :
    UCompactlyGeneratedSpace.{u} (WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K) Y) :=
  (isGeneratedBy_compHaus_iff _).1 inferInstance

/-- On a `u`-small Hausdorff `u`-compactly generated domain `Y`, `CompHaus.{u}`-continuous maps
`Y → Z` form a space homeomorphic to the compact-open mapping space `C(Y, Z)`. -/
def ContinuousMapGeneratedBy.homeomorphContinuousMapOfT2 (Y : Type v) (Z : Type w)
    [TopologicalSpace Y] [TopologicalSpace Z] [Small.{u} Y] [T2Space Y]
    [UCompactlyGeneratedSpace.{u} Y] :
    ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) Y Z ≃ₜ C(Y, Z) :=
  homeomorphContinuousMapOfExistsIsCompactImageEq fun _ hKc ↦ hKc.exists_compHaus_isCompact_image_eq

@[simp]
theorem ContinuousMapGeneratedBy.homeomorphContinuousMapOfT2_apply {Y : Type v} {Z : Type w}
    [TopologicalSpace Y] [TopologicalSpace Z] [Small.{u} Y] [T2Space Y]
    [UCompactlyGeneratedSpace.{u} Y]
    (g : ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) Y Z) :
    homeomorphContinuousMapOfT2 Y Z g = g.toContinuousMap :=
  homeomorphContinuousMapOfExistsIsCompactImageEq_apply _ g

@[simp]
theorem ContinuousMapGeneratedBy.homeomorphContinuousMapOfT2_symm_apply {Y : Type v} {Z : Type w}
    [TopologicalSpace Y] [TopologicalSpace Z] [Small.{u} Y] [T2Space Y]
    [UCompactlyGeneratedSpace.{u} Y] (g : C(Y, Z)) :
    (homeomorphContinuousMapOfT2 Y Z).symm g =
      g.toContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) :=
  homeomorphContinuousMapOfExistsIsCompactImageEq_symm_apply _ g

end Topology

namespace TauCeti

/-- If `X` and `Y` are `u`-compactly generated and `Y` is locally compact, then the ordinary
product `X × Y` is `u`-compactly generated. -/
theorem uCompactlyGeneratedSpace_prod_of_locallyCompactSpace_right (X : Type v) (Y : Type w)
    [TopologicalSpace X] [TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{u} X] [UCompactlyGeneratedSpace.{u} Y] [LocallyCompactSpace Y] :
    UCompactlyGeneratedSpace.{u} (X × Y) :=
  (Topology.isGeneratedBy_compHaus_iff (X × Y)).1
    (Topology.IsGeneratedBy.prod_of_locallyCompactSpace_right X Y)

/-- If `X` and `Y` are `u`-compactly generated and `X` is locally compact, then the ordinary
product `X × Y` is `u`-compactly generated. -/
theorem uCompactlyGeneratedSpace_prod_of_locallyCompactSpace_left (X : Type v) (Y : Type w)
    [TopologicalSpace X] [TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{u} X] [UCompactlyGeneratedSpace.{u} Y] [LocallyCompactSpace X] :
    UCompactlyGeneratedSpace.{u} (X × Y) :=
  (Topology.isGeneratedBy_compHaus_iff (X × Y)).1
    (Topology.IsGeneratedBy.prod_of_locallyCompactSpace_left X Y)

end TauCeti
