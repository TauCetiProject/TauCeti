module

public import Mathlib.Topology.Instances.ENat
public import Mathlib.Topology.Semicontinuity.Defs

/-!
# Semicontinuity at infinity on `ℕ∞`

Because neighborhoods of `⊤ : ℕ∞` are generated by upper rays `(N, ⊤]`, a relation or
preorder-valued function on `ℕ∞` is semicontinuous at `⊤` if and only if the corresponding
condition holds eventually along `ℕ`. Extending a sequence `g : ℕ → β` to `ℕ∞` via
`ENat.recTopCoe b g` therefore turns sequential semicontinuity statements into topological
semicontinuity at `⊤ : ℕ∞`, allowing composition and algebraic operations to reuse topological
theorems.
-/

public section

open Filter Set Topology

namespace ENat

/-- A relation `r : ℕ∞ → β → Prop` is semicontinuous at `⊤` if and only if every `y` satisfying
`r ⊤ y` eventually holds at finite indices `n : ℕ`. -/
theorem semicontinuousAt_top_iff {β : Type*} {r : ℕ∞ → β → Prop} :
    SemicontinuousAt r ⊤ ↔ ∀ y, r ⊤ y → ∀ᶠ n : ℕ in atTop, r n y := by
  refine ⟨fun h y hy ↦ ENat.tendsto_natCast_nhds_top.eventually (h y hy), fun h y hy ↦ ?_⟩
  obtain ⟨N, hN⟩ := eventually_atTop.1 (h y hy)
  refine eventually_of_mem (Ioi_mem_nhds (ENat.natCast_lt_top N)) fun z hz ↦ ?_
  cases z with
  | top => exact hy
  | coe n => exact hN n (Nat.le_of_lt (ENat.natCast_lt_natCast.1 hz))

/-- A function `f : ℕ∞ → β` into a preordered type is lower semicontinuous at `⊤` if and only if
every strict lower bound `y < f ⊤` is eventually exceeded along `ℕ`. -/
theorem lowerSemicontinuousAt_top_iff {β : Type*} [Preorder β] {f : ℕ∞ → β} :
    LowerSemicontinuousAt f ⊤ ↔ ∀ y < f ⊤, ∀ᶠ n : ℕ in atTop, y < f n :=
  semicontinuousAt_top_iff

/-- A function `f : ℕ∞ → β` into a preordered type is upper semicontinuous at `⊤` if and only if
every strict upper bound `f ⊤ < y` eventually holds along `ℕ`. -/
theorem upperSemicontinuousAt_top_iff {β : Type*} [Preorder β] {f : ℕ∞ → β} :
    UpperSemicontinuousAt f ⊤ ↔ ∀ y, f ⊤ < y → ∀ᶠ n : ℕ in atTop, f n < y :=
  semicontinuousAt_top_iff

end ENat
