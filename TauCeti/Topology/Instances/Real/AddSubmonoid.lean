module

public import Mathlib.Algebra.Group.Submonoid.Operations
public import Mathlib.Topology.Instances.Real.Lemmas

/-!
# Additive submonoids generated by real half-lines

This file computes the closures of the additive submonoids of `ℝ` generated by one or both
closed half-lines with nonnegative cutoffs.

## Main results

* `TauCeti.closure_addSubmonoidClosure_Ici` — a nonnegative right half-line generates itself and
  zero.
* `TauCeti.closure_addSubmonoidClosure_Iic` — a nonpositive left half-line generates itself and
  zero.
* `TauCeti.closure_addSubmonoidClosure_twoSided` — two oppositely directed half-lines generate a
  dense additive submonoid of `ℝ`.
-/

public section

open Set Topology

namespace TauCeti

/-- The closure of the additive submonoid generated by `[ε, ∞)` for `ε ≥ 0` is
`{0} ∪ [ε, ∞)`. -/
theorem closure_addSubmonoidClosure_Ici {ε : ℝ} (hε : 0 ≤ ε) :
    closure (AddSubmonoid.closure (Ici ε) : Set ℝ) = {0} ∪ Ici ε := by
  let M : AddSubmonoid ℝ := {
    carrier := {0} ∪ Ici ε
    zero_mem' := Or.inl rfl
    add_mem' := by
      rintro x y (rfl | hx) (rfl | hy)
      · exact Or.inl (zero_add 0)
      · exact Or.inr (by simpa using hy)
      · exact Or.inr (by simpa using hx)
      · exact Or.inr (by simp only [mem_Ici] at hx hy ⊢; linarith) }
  have hM : AddSubmonoid.closure (Ici ε) = M := by
    apply le_antisymm
    · exact AddSubmonoid.closure_le.mpr fun x hx ↦ Or.inr hx
    · intro x hx
      rcases hx with (rfl | hx)
      · exact (AddSubmonoid.closure (Ici ε)).zero_mem
      · exact AddSubmonoid.subset_closure hx
  rw [hM]
  exact (isClosed_singleton.union isClosed_Ici).closure_eq

/-- The closure of the additive submonoid generated by `(-∞, -ε]` for `ε ≥ 0` is
`{0} ∪ (-∞, -ε]`. -/
theorem closure_addSubmonoidClosure_Iic {ε : ℝ} (hε : 0 ≤ ε) :
    closure (AddSubmonoid.closure (Iic (-ε)) : Set ℝ) = {0} ∪ Iic (-ε) := by
  let M : AddSubmonoid ℝ := {
    carrier := {0} ∪ Iic (-ε)
    zero_mem' := Or.inl rfl
    add_mem' := by
      rintro x y (rfl | hx) (rfl | hy)
      · exact Or.inl (zero_add 0)
      · exact Or.inr (by simpa using hy)
      · exact Or.inr (by simpa using hx)
      · exact Or.inr (by simp only [mem_Iic] at hx hy ⊢; linarith) }
  have hM : AddSubmonoid.closure (Iic (-ε)) = M := by
    apply le_antisymm
    · exact AddSubmonoid.closure_le.mpr fun x hx ↦ Or.inr hx
    · intro x hx
      rcases hx with (rfl | hx)
      · exact (AddSubmonoid.closure (Iic (-ε))).zero_mem
      · exact AddSubmonoid.subset_closure hx
  rw [hM]
  exact (isClosed_singleton.union isClosed_Iic).closure_eq

/-- The additive submonoid generated by two oppositely directed closed half-lines is dense in
`ℝ`. -/
theorem closure_addSubmonoidClosure_twoSided {ε : ℝ} :
    closure (AddSubmonoid.closure (Iic (-ε) ∪ Ici ε) : Set ℝ) = univ := by
  have htop : AddSubmonoid.closure (Iic (-ε) ∪ Ici ε) = ⊤ := by
    exact eq_top_iff.mpr fun x ↦ by
      let y := ε + |x| + 1
      let z := x - y
      have hy : y ∈ Iic (-ε) ∪ Ici ε := Or.inr (by
        simp only [mem_Ici, y]
        linarith [abs_nonneg x])
      have hz : z ∈ Iic (-ε) ∪ Ici ε := Or.inl (by
        simp only [mem_Iic, z, y]
        have := le_abs_self x
        linarith)
      have hy' := AddSubmonoid.subset_closure hy
      have hz' := AddSubmonoid.subset_closure hz
      convert (AddSubmonoid.closure (Iic (-ε) ∪ Ici ε)).add_mem hy' hz' using 1
      simp [z]
  rw [htop]
  exact closure_univ

end TauCeti
