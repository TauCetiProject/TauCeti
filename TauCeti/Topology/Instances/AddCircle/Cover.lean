module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.Topology.Instances.AddCircle.Real

/-!
# Reduction maps between additive circles

When `p ∈ AddSubgroup.zmultiples q`, reduction modulo `q` descends to the surjective additive map
`AddCircle.coverMap : AddCircle p →+ AddCircle q`, sending `[t]_p` to `[t]_q`. Its kernel is
generated by the class of `q` (`AddCircle.ker_coverMap`). For positive `p = k q` with `k` a positive
integer, the kernel has `k` elements (`AddCircle.natCard_ker_coverMap`) and is canonically
isomorphic to `ZMod k` (`AddCircle.zmodEquivZMultiples`), giving the deck group and degree of the
finite cover of the circle of length `q` by the circle of length `p`. Half the period lies in this
kernel exactly when `k` is even (`AddCircle.period_div_two_mem_zmultiples_iff`).

This quotient-group API describes repeated traversal of periodic curves without requiring a smooth
structure. Analyticity and the local diffeomorphism property for positive periods are developed in
`TauCeti.Geometry.Manifold.Instances.AddCircle.Cover`.
-/

public noncomputable section

namespace AddCircle

variable {p q : ℝ}

/-- For positive `p`, half the period is nonzero in `AddCircle p`. -/
theorem period_div_two_coe_ne_zero [Fact (0 < p)] : ((p / 2 : ℝ) : AddCircle p) ≠ 0 := by
  intro h0
  have h2 := addOrderOf_period_div (p := p) (n := 2) zero_lt_two
  norm_num [h0] at h2

/-- For positive `p = k q` with `k : ℕ`, the class of `q` in `AddCircle p` has additive order
`k`. -/
theorem addOrderOf_coe_of_eq_mul [Fact (0 < p)] {k : ℕ} (hp : p = k * q) :
    addOrderOf ((q : ℝ) : AddCircle p) = k := by
  have hk : 0 < k := Nat.pos_of_ne_zero fun hk0 ↦ (Fact.out : 0 < p).ne' (by simp [hp, hk0])
  have hq : q = p / k := by
    rw [hp, mul_div_cancel_left₀ q (Nat.cast_ne_zero.mpr hk.ne')]
  rw [hq, addOrderOf_period_div hk]

/-- For a period `p` that is an integer multiple of the period `q`, the covering map
`AddCircle p → AddCircle q` sending the class of `t` modulo `p` to its class modulo `q`. For
positive `p = k q` with `k` a positive integer it is the `k`-sheeted covering of the circle of
length `q` by the circle of length `p` (`AddCircle.natCard_ker_coverMap`). -/
def coverMap (h : p ∈ AddSubgroup.zmultiples q) : AddCircle p →+ AddCircle q :=
  QuotientAddGroup.map _ _ (AddMonoidHom.id ℝ) <| by
    rw [AddSubgroup.comap_id, AddSubgroup.zmultiples_le]
    exact h

section CoverMap

variable (h : p ∈ AddSubgroup.zmultiples q)

/-- The covering map sends the class of `t` modulo `p` to the class of `t` modulo `q`. -/
@[simp]
theorem coverMap_coe (t : ℝ) : coverMap h t = (t : AddCircle q) :=
  QuotientAddGroup.map_mk _ _ _ _ t

/-- Read on the real line, the covering map is the quotient map `ℝ → AddCircle q`. -/
theorem coverMap_comp_coe :
    coverMap h ∘ ((↑) : ℝ → AddCircle p) = ((↑) : ℝ → AddCircle q) :=
  funext (coverMap_coe h)

/-- Reduction between period quotients is continuous. -/
@[continuity, fun_prop]
theorem continuous_coverMap : Continuous (coverMap h) := by
  rw [(QuotientAddGroup.isQuotientMap_mk _).continuous_iff, coverMap_comp_coe]
  exact AddCircle.continuous_mk' q

/-- The covering map is surjective. -/
theorem coverMap_surjective : Function.Surjective (coverMap h) := fun y ↦ by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective y
  exact ⟨t, coverMap_coe h t⟩

/-- The kernel of the covering map is the subgroup of `AddCircle p` generated by the class of
`q`. -/
theorem ker_coverMap :
    (coverMap h).ker = AddSubgroup.zmultiples ((q : ℝ) : AddCircle p) := by
  rw [coverMap, QuotientAddGroup.ker_map, AddSubgroup.comap_id, AddMonoidHom.map_zmultiples,
    QuotientAddGroup.mk'_apply]

/-- For positive `p = k q` with `k` a natural number, the kernel has `k` elements. -/
theorem natCard_ker_coverMap [Fact (0 < p)] {k : ℕ} (hp : p = k * q) :
    Nat.card (coverMap h).ker = k := by
  rw [ker_coverMap, Nat.card_zmultiples, addOrderOf_coe_of_eq_mul hp]

end CoverMap

/-- For positive `p = k q` with `k : ℕ`, the canonical additive isomorphism
`ZMod k ≃+ AddSubgroup.zmultiples ((q : ℝ) : AddCircle p)` sending `1` to the class of `q`. -/
def zmodEquivZMultiples [Fact (0 < p)] {k : ℕ} (hp : p = k * q) :
    ZMod k ≃+ AddSubgroup.zmultiples ((q : ℝ) : AddCircle p) :=
  zmodAddEquivOfGenerator
    (g := ⟨(q : AddCircle p), AddSubgroup.mem_zmultiples _⟩)
    (fun ⟨_, hx⟩ ↦ by
      obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hx
      exact ⟨m, rfl⟩)
    (by rw [Nat.card_zmultiples, addOrderOf_coe_of_eq_mul hp])

@[simp]
theorem coe_zmodEquivZMultiples_intCast [Fact (0 < p)] {k : ℕ} (hp : p = k * q) (n : ℤ) :
    (zmodEquivZMultiples hp n : AddCircle p) = n • ((q : ℝ) : AddCircle p) := by
  rw [zmodEquivZMultiples, zmodAddEquivOfGenerator_apply_intCast, AddSubgroup.coe_zsmul]

@[simp]
theorem coe_zmodEquivZMultiples_natCast [Fact (0 < p)] {k : ℕ} (hp : p = k * q) (n : ℕ) :
    (zmodEquivZMultiples hp n : AddCircle p) = n • ((q : ℝ) : AddCircle p) := by
  simpa using coe_zmodEquivZMultiples_intCast hp n

@[simp]
theorem coe_zmodEquivZMultiples_one [Fact (0 < p)] {k : ℕ} (hp : p = k * q) :
    (zmodEquivZMultiples hp 1 : AddCircle p) = ((q : ℝ) : AddCircle p) := by
  simpa using coe_zmodEquivZMultiples_natCast hp 1

@[simp]
theorem zmodEquivZMultiples_symm_apply_zsmul [Fact (0 < p)] {k : ℕ} (hp : p = k * q) (n : ℤ) :
    (zmodEquivZMultiples hp).symm
      (n • ⟨(q : AddCircle p), AddSubgroup.mem_zmultiples _⟩) = n :=
  zmodAddEquivOfGenerator_symm_apply_zsmul _ _ n

/-- For positive `p = k q` with `k : ℕ`, half the period `p / 2` lies in the subgroup of
`AddCircle p` generated by `q` if and only if `k` is even. -/
theorem period_div_two_mem_zmultiples_iff [Fact (0 < p)] {k : ℕ} (hp : p = k * q) :
    ((p / 2 : ℝ) : AddCircle p) ∈
      AddSubgroup.zmultiples ((q : ℝ) : AddCircle p) ↔ Even k := by
  have hmem : p ∈ AddSubgroup.zmultiples q :=
    AddSubgroup.mem_zmultiples_iff.2 ⟨k, by rw [zsmul_eq_mul, Int.cast_natCast, hp]⟩
  have hq : 0 < q := pos_of_mul_pos_right (hp ▸ (Fact.out : 0 < p)) (Nat.cast_nonneg k)
  rw [← ker_coverMap hmem, AddMonoidHom.mem_ker, coverMap_coe, coe_eq_zero_iff]
  constructor
  · rintro ⟨n, hn⟩
    rw [zsmul_eq_mul, hp] at hn
    have hmul : (2 * n : ℝ) * q = (k : ℝ) * q := by linarith
    have heq : (2 * n : ℤ) = (k : ℤ) := by exact_mod_cast mul_right_cancel₀ hq.ne' hmul
    have hn₀ : 0 ≤ n := by linarith [Int.natCast_nonneg k]
    lift n to ℕ using hn₀
    exact ⟨n, by omega⟩
  · rintro ⟨n, rfl⟩
    refine ⟨n, ?_⟩
    rw [zsmul_eq_mul, hp]
    push_cast
    ring

end AddCircle
