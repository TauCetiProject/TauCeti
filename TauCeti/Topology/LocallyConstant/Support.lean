module

public import Mathlib.Topology.Algebra.Support
public import Mathlib.Topology.LocallyConstant.Algebra
public import Mathlib.Topology.Sets.Compacts

/-!
# Compact-open expansions of locally constant functions

A compactly supported locally constant function has finite range and compact nonzero fibers.
On a Hausdorff space, it is consequently a finite sum of constant functions restricted to
pairwise disjoint compact open subsets. No topology on the coefficient module is used.

The compactly supported functions form a submodule of `LocallyConstant X M`, generated by
these compact-open indicators. This finite expansion is the input for integration against
finitely additive volumes with values in a coefficient ring.

The fiber-partition argument is that of Bernstein, *Representations of p-adic groups* (1992),
Ch. I, §1.1, Lemma 1 and §1.2.
-/

public section

open Function Set TopologicalSpace
open scoped BigOperators

namespace LocallyConstant

variable {X M : Type*} [TopologicalSpace X]

/-- A compactly supported locally constant function has finite range, even on a noncompact
space and without any topology on its target. -/
theorem range_finite_of_hasCompactSupport [Zero M]
    (f : LocallyConstant X M) (hf : HasCompactSupport f) :
    (Set.range f).Finite := by
  let : TopologicalSpace M := ⊥
  have : DiscreteTopology M := discreteTopology_bot M
  exact (hf.isCompact_range f.continuous).finite_of_discrete

/-- Every nonzero fiber of a compactly supported locally constant function is compact.
No separation hypothesis on the domain is needed. -/
theorem isCompact_fiber_of_hasCompactSupport [Zero M] (f : LocallyConstant X M)
    (hf : HasCompactSupport f) {m : M} (hm : m ≠ 0) : IsCompact (f ⁻¹' {m}) := by
  refine hf.isCompact.of_isClosed_subset (f.isLocallyConstant.isClosed_fiber m) ?_
  intro x hx
  exact subset_tsupport f (Function.mem_support.mpr (by
    rw [mem_preimage, mem_singleton_iff] at hx
    exact hx ▸ hm))

section AddCommMonoid

variable [AddCommMonoid M]

/-- A compactly supported locally constant function is a finite sum of constant functions
restricted to pairwise disjoint compact opens. The coefficients are precisely its nonzero
values. This applies to any Hausdorff domain, with no local compactness assumption. -/
theorem exists_sum_indicator_of_hasCompactSupport [T2Space X]
    (f : LocallyConstant X M) (hf : HasCompactSupport f) :
    ∃ (s : Finset M), (∀ m, m ∈ s ↔ m ∈ Set.range f ∧ m ≠ 0) ∧
      ∃ U : s → CompactOpens X,
      (∀ i : s, (U i : Set X) = f ⁻¹' {(i : M)}) ∧
      (Pairwise fun i j => Disjoint (U i : Set X) (U j : Set X)) ∧
      f = ∑ i : s, (const X (i : M)).indicator (U i).toClopens.2 := by
  classical
  let s := ((f.range_finite_of_hasCompactSupport hf).toFinset).erase 0
  have hs (m : M) : m ∈ s ↔ m ∈ Set.range f ∧ m ≠ 0 := by
    simp [s, and_comm]
  let U : s → CompactOpens X := fun i =>
    ⟨⟨f ⁻¹' {(i : M)}, f.isCompact_fiber_of_hasCompactSupport hf ((hs i).mp i.2).2⟩,
      f.isLocallyConstant.isOpen_fiber i⟩
  have hU (i : s) : (U i).toClopens.carrier = f ⁻¹' {(i : M)} := rfl
  refine ⟨s, hs, U, fun _ => rfl, ?_, ?_⟩
  · intro i j hij
    apply Set.disjoint_left.mpr
    intro x hxi hxj
    exact hij (Subtype.ext (hxi.symm.trans hxj))
  · ext x
    conv_rhs => rw [← evalAddMonoidHom_apply x, map_sum]
    simp only [evalAddMonoidHom_apply]
    by_cases hx : f x = 0
    · rw [hx]
      symm
      apply Finset.sum_eq_zero
      intro j _
      simp [indicator_apply, hU, hx, ((hs j).mp j.2).2.symm]
    · let i : s := ⟨f x, (hs (f x)).mpr ⟨⟨x, rfl⟩, hx⟩⟩
      have hi : (const X (i : M)).indicator (U i).toClopens.2 x = f x := by
        simp [indicator_apply, hU, i]
      rw [← hi]
      symm
      apply Finset.sum_eq_single i
      · intro j _ hji
        have hj : f x ≠ (j : M) := fun h => hji (Subtype.ext h.symm)
        simp [indicator_apply, hU, hj]
      · simp

end AddCommMonoid

end LocallyConstant

namespace TauCeti

variable (R X M : Type*) [Semiring R] [TopologicalSpace X] [AddCommMonoid M] [Module R M]

/-- The submodule of locally constant functions with compact support. Its underlying module
requires no topology on the coefficient module. -/
def compactlySupportedLocallyConstantSubmodule : Submodule R (LocallyConstant X M) where
  carrier := {f | HasCompactSupport f}
  zero_mem' := HasCompactSupport.zero
  add_mem' hf hg := hf.add hg
  smul_mem' r _ hf := hf.smul_left (f := fun _ : X => r)

@[simp]
theorem mem_compactlySupportedLocallyConstantSubmodule (f : LocallyConstant X M) :
    f ∈ compactlySupportedLocallyConstantSubmodule R X M ↔ HasCompactSupport f :=
  Iff.rfl

/-- Compact-open indicators generate all compactly supported locally constant functions.
The coefficient ring need not be commutative and the domain need not be locally compact. -/
theorem compactlySupportedLocallyConstantSubmodule_eq_span [T2Space X] :
    compactlySupportedLocallyConstantSubmodule R X M =
      Submodule.span R {f : LocallyConstant X M | ∃ (U : CompactOpens X) (m : M),
        f = (LocallyConstant.const X m).indicator U.toClopens.2} := by
  classical
  apply le_antisymm
  · intro f hf
    obtain ⟨s, -, U, -, -, hsum⟩ :=
      f.exists_sum_indicator_of_hasCompactSupport hf
    rw [hsum]
    exact Submodule.sum_mem _ fun i _ => Submodule.subset_span ⟨U i, i, rfl⟩
  · apply Submodule.span_le.mpr
    rintro f ⟨U, m, rfl⟩
    apply HasCompactSupport.intro U.isCompact
    intro x hx
    simp [LocallyConstant.indicator_apply, CompactOpens.toClopens, hx]

end TauCeti
