/-!
# Ring homomorphisms out of locally constant integer functions

On a compact space `X` a locally constant function `f : X → ℤ` takes finitely many values, and
it is the finite sum `f = ∑ n • χ_{f⁻¹{n}}` of its values times the characteristic functions of
its fibres, which are clopen. Hence the ring `LocallyConstant X ℤ` is additively generated by the
characteristic functions `χ_U` of clopen sets `U`, and homomorphisms out of it are determined by
their values on them (`LocallyConstant.addMonoidHom_ext_charFn`,
`LocallyConstant.ringHom_ext_charFn`).

Conversely, `χ_⊤ = 1`, `χ_{U ∩ V} = χ_U χ_V` and `χ_{Uᶜ} = 1 - χ_U`. Any assignment
`c : Clopens X → A` into a ring satisfying these three identities, that is, a homomorphism of
Boolean algebras from the clopen sets to the idempotents of `A`, extends uniquely to a ring
homomorphism `LocallyConstant X ℤ →+* A` sending `χ_U` to `c U`
(`LocallyConstant.ringHomOfClopens`), namely `f ↦ ∑ n • c (f⁻¹{n})`. This is how a ring
homomorphism out of the locally constant integer functions on a prime spectrum is built from
idempotents, for instance the rank section of projective `K₀`.

## Main definitions

* `LocallyConstant.ringHomOfClopens`: the ring homomorphism `LocallyConstant X ℤ →+* A` induced by
  a map `c` from clopen sets to `A` with `c ⊤ = 1`, `c (U ⊓ V) = c U * c V` and
  `c Uᶜ = 1 - c U`.

## Main results

* `LocallyConstant.sum_zsmul_charFn_fiberClopens`: a locally constant integer function is the sum
  of its values times the characteristic functions of its fibres.
* `LocallyConstant.addMonoidHom_ext_charFn`, `LocallyConstant.ringHom_ext_charFn`: on a compact
  space, homomorphisms out of `LocallyConstant X ℤ` agreeing on characteristic functions of clopen
  sets are equal.
* `LocallyConstant.ringHomOfClopens_apply`, `LocallyConstant.ringHomOfClopens_charFn`: the
  induced ring homomorphism sends `f` to `∑ n • c (f⁻¹{n})`, and `χ_U` to `c U`.
-/

public section

open TopologicalSpace

namespace LocallyConstant

variable {X : Type*} [TopologicalSpace X]

/-- A locally constant integer function is the sum, over any finite set of integers containing its
values, of each value times the characteristic function of its fibre. -/
theorem sum_zsmul_charFn_fiberClopens (f : LocallyConstant X ℤ) {s : Finset ℤ}
    (hs : Set.range f ⊆ s) :
    ∑ n ∈ s, n • charFn ℤ (f.fiberClopens n).isClopen = f := by
  ext x
  rw [← evalAddMonoidHom_apply, map_sum, Finset.sum_eq_single_of_mem (f x) (hs ⟨x, rfl⟩)]
  · simp [-zsmul_eq_mul, coe_charFn]
  · intro n _ hn
    simp [-zsmul_eq_mul, coe_charFn, Ne.symm hn]

/-- On a compact space, additive homomorphisms out of the locally constant integer functions are
determined by their values on the characteristic functions of clopen sets. -/
theorem addMonoidHom_ext_charFn [CompactSpace X] {A : Type*} [AddCommGroup A]
    {φ ψ : LocallyConstant X ℤ →+ A}
    (h : ∀ U : Clopens X, φ (charFn ℤ U.isClopen) = ψ (charFn ℤ U.isClopen)) : φ = ψ := by
  ext f
  rw [← f.sum_zsmul_charFn_fiberClopens (s := f.range_finite.toFinset) (by simp), map_sum,
    map_sum]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [map_zsmul, map_zsmul, h]

/-- On a compact space, ring homomorphisms out of the locally constant integer functions are
determined by their values on the characteristic functions of clopen sets. -/
theorem ringHom_ext_charFn [CompactSpace X] {A : Type*} [NonAssocRing A]
    {φ ψ : LocallyConstant X ℤ →+* A}
    (h : ∀ U : Clopens X, φ (charFn ℤ U.isClopen) = ψ (charFn ℤ U.isClopen)) : φ = ψ :=
  RingHom.toAddMonoidHom_injective (addMonoidHom_ext_charFn h)

section RingHomOfClopens

variable {A : Type*} [Ring A] {c : Clopens X → A} (htop : c ⊤ = 1)
  (hinf : ∀ U V, c (U ⊓ V) = c U * c V) (hcompl : ∀ U, c Uᶜ = 1 - c U)

include htop hcompl in
/-- A Boolean algebra homomorphism into the idempotents kills the empty set. -/
private theorem map_bot : c ⊥ = 0 := by
  rw [← compl_top, hcompl, htop, sub_self]

include htop hinf hcompl in
/-- A Boolean algebra homomorphism into the idempotents is additive on disjoint clopen sets. -/
private theorem map_sup_of_inf_eq_bot {U V : Clopens X} (h : U ⊓ V = ⊥) :
    c (U ⊔ V) = c U + c V := by
  have hUV : c U * c V = 0 := by rw [← hinf, h, map_bot htop hcompl]
  have h' := hcompl (U ⊔ V)
  rw [compl_sup, hinf, hcompl, hcompl] at h'
  calc c (U ⊔ V) = 1 - (1 - c U) * (1 - c V) := by rw [h', sub_sub_cancel]
    _ = c U + c V := by simp only [sub_mul, mul_sub, one_mul, mul_one, hUV]; abel

include htop hinf hcompl in
/-- The values of a Boolean algebra homomorphism into the idempotents on the fibres of a locally
constant function sum to `1`. -/
private theorem sum_map_fiberClopens (g : LocallyConstant X ℤ) {s : Finset ℤ}
    (hs : Set.range g ⊆ s) : ∑ m ∈ s, c (g.fiberClopens m) = 1 := by
  suffices h : ∀ t : Finset ℤ, ∑ m ∈ t, c (g.fiberClopens m) = c (t.sup g.fiberClopens) by
    rw [h, ← htop]
    congr 1
    refine eq_top_iff.mpr fun x _ ↦ ?_
    exact Finset.le_sup (f := g.fiberClopens) (hs ⟨x, rfl⟩) (mem_fiberClopens.mpr rfl)
  intro t
  induction t using Finset.cons_induction with
  | empty => rw [Finset.sum_empty, Finset.sup_empty, map_bot htop hcompl]
  | cons a t ha ih =>
    rw [Finset.sum_cons, Finset.sup_cons, ih, map_sup_of_inf_eq_bot htop hinf hcompl]
    refine disjoint_iff.mp (Finset.disjoint_sup_right.mpr fun b hb ↦ ?_)
    rw [← Clopens.coe_disjoint, coe_fiberClopens, coe_fiberClopens]
    exact (Set.disjoint_singleton.mpr (by rintro rfl; exact ha hb)).preimage g

/-- The sum `∑ n • c (f⁻¹{n})` over a finite set of integers. -/
private noncomputable def fiberSum (c : Clopens X → A) (f : LocallyConstant X ℤ) (s : Finset ℤ) :
    A :=
  ∑ n ∈ s, n • c (f.fiberClopens n)

variable [CompactSpace X]

include htop hcompl in
/-- The sum `∑ n • c (f⁻¹{n})` does not depend on the finite set of integers, as long as it
contains the values of `f`. -/
private theorem fiberSum_eq_fiberSum (f : LocallyConstant X ℤ) {s t : Finset ℤ}
    (hs : Set.range f ⊆ s) (ht : Set.range f ⊆ t) : fiberSum c f s = fiberSum c f t := by
  have key : ∀ s : Finset ℤ, Set.range f ⊆ s →
      fiberSum c f s = fiberSum c f f.range_finite.toFinset := by
    intro s hs
    refine (Finset.sum_subset (by simpa using hs) fun n _ hn ↦ ?_).symm
    have : f.fiberClopens n = ⊥ := eq_bot_iff.mpr fun x hx ↦
      hn (by simpa using ⟨x, mem_fiberClopens.mp hx⟩)
    rw [this, map_bot htop hcompl, smul_zero]
  rw [key s hs, key t ht]

/-- The value of `LocallyConstant.ringHomOfClopens` on `f`: the sum `∑ n • c (f⁻¹{n})` over the
finitely many values of `f`. -/
private noncomputable def ringHomOfClopensFun (c : Clopens X → A) (f : LocallyConstant X ℤ) : A :=
  fiberSum c f f.range_finite.toFinset

include htop hcompl in
private theorem ringHomOfClopensFun_eq (f : LocallyConstant X ℤ) {s : Finset ℤ}
    (hs : Set.range f ⊆ s) : ringHomOfClopensFun c f = fiberSum c f s :=
  fiberSum_eq_fiberSum htop hcompl f (by simp) hs

include htop hinf hcompl in
/-- **Pairing of fibres.** If `h x = op (f x) (g x)`, the value of
`LocallyConstant.ringHomOfClopens` on `h` is the double sum over the fibres of `f` and `g`. This
is the common step behind additivity and multiplicativity of `LocallyConstant.ringHomOfClopens`. -/
private theorem ringHomOfClopensFun_eq_sum_sum (op : ℤ → ℤ → ℤ) (f g h : LocallyConstant X ℤ)
    (hfg : ∀ x, h x = op (f x) (g x)) {s t : Finset ℤ} (hs : Set.range f ⊆ s)
    (ht : Set.range g ⊆ t) :
    ringHomOfClopensFun c h =
      ∑ a ∈ s, ∑ b ∈ t, op a b • (c (f.fiberClopens a) * c (g.fiberClopens b)) := by
  set u := Finset.image (fun p : ℤ × ℤ ↦ op p.1 p.2) (s ×ˢ t)
  have hu : Set.range h ⊆ u := by
    rintro _ ⟨x, rfl⟩
    rw [hfg]
    exact Finset.mem_image_of_mem _ (Finset.mk_mem_product (hs ⟨x, rfl⟩) (ht ⟨x, rfl⟩))
  rw [ringHomOfClopensFun_eq htop hcompl h hu]
  -- The fibre of `h` at `k` meets the fibres of `f` at `a` and of `g` at `b` exactly when
  -- `op a b = k`.
  have hfib : ∀ k a b, h.fiberClopens k ⊓ (f.fiberClopens a ⊓ g.fiberClopens b) =
      if op a b = k then f.fiberClopens a ⊓ g.fiberClopens b else ⊥ := by
    intro k a b
    split_ifs with hk <;> ext x <;> simp only [Clopens.coe_inf, coe_fiberClopens, Clopens.coe_bot,
      Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff, hfg] <;> grind
  calc fiberSum c h u
      = ∑ k ∈ u, k • (c (h.fiberClopens k) *
          ((∑ a ∈ s, c (f.fiberClopens a)) * ∑ b ∈ t, c (g.fiberClopens b))) := by
        simp_rw [sum_map_fiberClopens htop hinf hcompl f hs,
          sum_map_fiberClopens htop hinf hcompl g ht, mul_one, fiberSum]
    _ = ∑ k ∈ u, ∑ a ∈ s, ∑ b ∈ t,
          if op a b = k then k • (c (f.fiberClopens a) * c (g.fiberClopens b)) else 0 := by
        refine Finset.sum_congr rfl fun k _ ↦ ?_
        simp_rw [Finset.sum_mul_sum, Finset.mul_sum, Finset.smul_sum, ← hinf, hfib]
        refine Finset.sum_congr rfl fun a _ ↦ Finset.sum_congr rfl fun b _ ↦ ?_
        split_ifs <;> simp [hinf, map_bot htop hcompl]
    _ = ∑ a ∈ s, ∑ b ∈ t, op a b • (c (f.fiberClopens a) * c (g.fiberClopens b)) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun a ha ↦ ?_
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun b hb ↦ ?_
        exact Finset.sum_ite_eq_of_mem _ _ _
          (Finset.mem_image_of_mem _ (Finset.mk_mem_product ha hb))

/-- **Ring homomorphisms out of locally constant integer functions.** On a compact space `X`, a
map `c` from the clopen sets of `X` to a ring with `c ⊤ = 1`, `c (U ⊓ V) = c U * c V` and
`c Uᶜ = 1 - c U` induces the ring homomorphism `LocallyConstant X ℤ →+* A`,
`f ↦ ∑ n • c (f⁻¹{n})`, sending the characteristic function of each clopen set `U` to `c U`. -/
noncomputable def ringHomOfClopens : LocallyConstant X ℤ →+* A where
  toFun := ringHomOfClopensFun c
  map_one' := by
    rw [ringHomOfClopensFun_eq htop hcompl 1 (s := {1}) (by simp),
      fiberSum, Finset.sum_singleton, one_smul, ← htop]
    congr 1
    exact eq_top_iff.mpr fun x _ ↦ mem_fiberClopens.mpr rfl
  map_mul' f g := by
    obtain ⟨s, hs⟩ : ∃ s : Finset ℤ, Set.range f ⊆ s := ⟨_, f.range_finite.coe_toFinset.ge⟩
    obtain ⟨t, ht⟩ : ∃ t : Finset ℤ, Set.range g ⊆ t := ⟨_, g.range_finite.coe_toFinset.ge⟩
    rw [ringHomOfClopensFun_eq_sum_sum htop hinf hcompl (· * ·) f g (f * g) (fun _ ↦ rfl) hs ht,
      ringHomOfClopensFun_eq htop hcompl f hs, ringHomOfClopensFun_eq htop hcompl g ht, fiberSum,
      fiberSum, Finset.sum_mul_sum]
    simp_rw [smul_mul_smul_comm]
  map_zero' := by
    rw [ringHomOfClopensFun_eq htop hcompl 0 (s := {0}) (by simp),
      fiberSum, Finset.sum_singleton, zero_smul]
  map_add' f g := by
    obtain ⟨s, hs⟩ : ∃ s : Finset ℤ, Set.range f ⊆ s := ⟨_, f.range_finite.coe_toFinset.ge⟩
    obtain ⟨t, ht⟩ : ∃ t : Finset ℤ, Set.range g ⊆ t := ⟨_, g.range_finite.coe_toFinset.ge⟩
    rw [ringHomOfClopensFun_eq_sum_sum htop hinf hcompl (· + ·) f g (f + g) (fun _ ↦ rfl) hs ht,
      ringHomOfClopensFun_eq htop hcompl f hs, ringHomOfClopensFun_eq htop hcompl g ht, fiberSum,
      fiberSum]
    -- Split `(a + b) • (c_a * c_b)` and sum out the fibres of the other function.
    simp_rw [add_smul, Finset.sum_add_distrib]
    congr 1
    · refine Finset.sum_congr rfl fun a _ ↦ ?_
      rw [← Finset.smul_sum, ← Finset.mul_sum, sum_map_fiberClopens htop hinf hcompl g ht, mul_one]
    · rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun b _ ↦ ?_
      rw [← Finset.smul_sum, ← Finset.sum_mul, sum_map_fiberClopens htop hinf hcompl f hs, one_mul]

/-- `LocallyConstant.ringHomOfClopens` sends `f` to `∑ n • c (f⁻¹{n})`, summed over any finite set
of integers containing the values of `f`. -/
theorem ringHomOfClopens_apply (f : LocallyConstant X ℤ) {s : Finset ℤ} (hs : Set.range f ⊆ s) :
    ringHomOfClopens htop hinf hcompl f = ∑ n ∈ s, n • c (f.fiberClopens n) :=
  ringHomOfClopensFun_eq htop hcompl f hs

/-- `LocallyConstant.ringHomOfClopens` sends the characteristic function of a clopen set `U` to
`c U`. -/
@[simp]
theorem ringHomOfClopens_charFn (U : Clopens X) :
    ringHomOfClopens htop hinf hcompl (charFn ℤ U.isClopen) = c U := by
  have hrange : Set.range (charFn ℤ U.isClopen) ⊆ ({0, 1} : Finset ℤ) := by
    rintro _ ⟨x, rfl⟩
    by_cases hx : x ∈ U <;> simp [coe_charFn, hx]
  have hfib : (charFn ℤ U.isClopen).fiberClopens 1 = U := by
    ext x
    simp [charFn_eq_one]
  rw [ringHomOfClopens_apply htop hinf hcompl _ hrange, Finset.sum_pair zero_ne_one, zero_smul,
    zero_add, one_smul, hfib]

end RingHomOfClopens

end LocallyConstant
