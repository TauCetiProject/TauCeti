module

public import Mathlib.Topology.Algebra.Ring.Basic
public import Mathlib.Topology.Algebra.Group.Subgroup
public import Mathlib.Topology.Algebra.Group.Units
public import Mathlib.RingTheory.Ideal.Span
import Mathlib.RingTheory.Ideal.Quotient.Defs

/-!
# Divisibility in closed cyclic subgroups of a unit group

If the principal ideal of `u ^ a - 1` is closed, then `u ^ a - 1` divides
`v ^ a - 1` for every member `v` of the closed subgroup generated by `u`.
This lets a divisibility bound for any member be used for a topological generator.
-/

public section

namespace TauCeti

/-- If `v` belongs to the closed subgroup generated by `u`, then `u ^ a - 1`
divides `v ^ a - 1` whenever the ideal generated by `u ^ a - 1` is closed. -/
theorem pow_sub_one_dvd_of_mem_topologicalClosure_zpowers {R : Type*} [CommRing R]
    [TopologicalSpace R] [IsTopologicalRing R]
    {u v : Rˣ} (hv : v ∈ (Subgroup.zpowers u).topologicalClosure) (a : ℕ)
    (hI : IsClosed (Ideal.span {(u : R) ^ a - 1} : Set R)) :
    (u : R) ^ a - 1 ∣ (v : R) ^ a - 1 := by
  let d := (u : R) ^ a - 1
  let I := Ideal.span {d}
  let f := (Units.map (Ideal.Quotient.mk I).toMonoidHom).comp (powMonoidHom a)
  have hf (w : Rˣ) : w ∈ f.ker ↔ (w : R) ^ a - 1 ∈ I := by
    rw [MonoidHom.mem_ker, ← Units.val_inj]
    simp only [f, MonoidHom.comp_apply, Units.coe_map, powMonoidHom_apply,
      Units.val_pow_eq_pow_val, Units.val_one, RingHom.toMonoidHom_eq_coe]
    rw [← map_one (Ideal.Quotient.mk I)]
    exact Ideal.Quotient.eq
  have hker : (f.ker : Set Rˣ) = (fun w : Rˣ ↦ (w : R) ^ a - 1) ⁻¹' (I : Set R) :=
    Set.ext hf
  have hclosed : IsClosed (f.ker : Set Rˣ) := by
    rw [hker]
    exact hI.preimage ((Units.continuous_val.pow a).sub continuous_const)
  exact Ideal.mem_span_singleton.mp ((hf v).1 (Subgroup.topologicalClosure_minimal _
    (Subgroup.zpowers_le.mpr ((hf u).2 (Ideal.mem_span_singleton_self d))) hclosed hv))

end TauCeti
