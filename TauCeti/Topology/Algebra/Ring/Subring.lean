/-!
# Subrings of a topological ring

This file records facts about a subring `R` of a topological ring `B` without auxiliary ideal or
adic data: the underlying set of `Subring.topologicalClosure` is the closure of the underlying
set of `R`, and the integral closure of `R` in `B` is open as soon as `R` is, for which only
separate continuity of addition is needed.

The first is the `Subring` case of the family `Subsemigroup.coe_topologicalClosure`,
`Submonoid.coe_topologicalClosure`, `Subsemiring.topologicalClosure_coe`; Mathlib stops short of
`Subring`, so the equation is only available as a definitional unfolding, which is what this file
supplies as a rewrite. The second is the observation that the integral closure contains `R` and
that an additive subgroup containing an open one is open. The same observation shows that an ideal
of `B` is open exactly when its trace on an open subring is.

Powers of a topologically nilpotent scalar absorb elements of the ambient ring into any open
subring. For submodules over that subring, they absorb the ambient span element by element,
and a single exponent absorbs a finitely generated submodule. These facts compare the
power-scaled filtrations of finite spanning lattices; they need only separately continuous
multiplication on the ambient ring. In particular, inverting a topologically nilpotent element
that is a unit in the ambient ring recovers the ambient ring from any open subring containing it.
Scalar absorption is supplied by `exists_mul_pow_mem_of_isTopologicallyNilpotent`.

A ring homomorphism out of an open subring whose kernel is generated by an ambient unit is
locally constant, being constant on the open cosets of its kernel.

## Main results

* `Subring.topologicalClosure_coe`: `↑S.topologicalClosure = closure ↑S`.
* `isOpen_integralClosure_toSubring`: the integral closure of an open subring is open.
* `Ideal.isOpen_comap_subtype_iff`: an ideal is open exactly when its trace on an open subring is.
* `Subring.isLocalizationAway_of_isOpen`: an open subring containing a topologically nilpotent
  unit recovers the ambient ring by inverting that element.
* `Subring.isLocalization_of_isOpen`: such a subring recovers the ambient ring by inverting all
  of its elements which are ambient units.
* `Subring.exists_dvd_pow_of_isTopologicallyNilpotent`: in an open subring, an ambient unit divides
  a power of every ambient topologically nilpotent element.
* `Subring.isNoetherianRing_of_isOpen`: a ring with a topologically nilpotent unit and a
  noetherian open subring is noetherian.
* `Subring.exists_pow_smul_mem`: a power carries an element of the ambient span into a
  submodule over the open subring.
* `Subring.exists_pow_smul_le` and `Subring.exists_pow_smul_le_pow_smul`: the uniform and
  cofinality forms for finitely generated submodules.
* `Subring.exists_pow_smul_le_pow_smul_of_isUnit`: powers of a topologically nilpotent scalar
  are cofinal in the filtration defined by powers of a unit.
* `TauCeti.isLocallyConstant_of_ker_eq_span`: the reduction of an open subring modulo an ambient
  unit is locally constant.

## References

* [Wedhorn, *Adic Spaces*][wedhorn_adic], Definition 7.14, where the integral closure of an open
  subring is taken and its openness is used without comment; Proposition 6.18 and Remark 6.19
  for the application of absorption to module topologies.
-/

public section

namespace Subring

variable {R : Type*} [Ring R] [TopologicalSpace R] [IsSemitopologicalRing R]

/-- The closure of a subring, as a set, is the closure of its underlying set: that set is how
`Subring.topologicalClosure` is defined. Mathlib has the `Subsemigroup`, `Submonoid` and
`Subsemiring` forms of this equation but not the `Subring` one. -/
@[simp]
theorem topologicalClosure_coe (S : Subring R) :
    (S.topologicalClosure : Set R) = _root_.closure (S : Set R) := (rfl)

end Subring

section Ideal

variable {B : Type*} [Ring B] [TopologicalSpace B] [SeparatelyContinuousAdd B]

/-- **An ideal is open exactly when its trace on an open subring is.** For an open subring `R` of
`B`, with the subspace topology, the contraction `p.comap R.subtype` of an ideal `p` of `B` is open
in `R` if and only if `p` is open in `B`. -/
theorem Ideal.isOpen_comap_subtype_iff (p : Ideal B) {R : Subring B} (hR : IsOpen (R : Set B)) :
    IsOpen (p.comap R.subtype : Set R) ↔ IsOpen (p : Set B) := by
  refine ⟨fun h ↦ AddSubgroup.isOpen_of_mem_nhds p.toAddSubgroup (g := 0) ?_,
    fun h ↦ h.preimage continuous_subtypeVal⟩
  -- the image of the open trace is an open neighbourhood of `0` in `B` contained in `p`
  refine Filter.mem_of_superset ((hR.isOpenMap_subtypeVal _ h).mem_nhds ⟨0, by simp, rfl⟩) ?_
  rintro _ ⟨x, hx, rfl⟩
  exact hx

end Ideal

variable {B : Type*} [CommRing B] [TopologicalSpace B] [SeparatelyContinuousAdd B]

/-- The integral closure of an open subring `R` of `B` is open: it contains `R` itself, as the
image of `algebraMap`, and an additive subgroup containing an open one is open. Only separate
continuity of addition on `B` is used, not the full additive topological group structure. -/
theorem isOpen_integralClosure_toSubring {R : Subring B} (hR : IsOpen (R : Set B)) :
    IsOpen ((integralClosure R B).toSubring : Set B) :=
  AddSubgroup.isOpen_mono (H₁ := R.toAddSubgroup)
    (H₂ := (integralClosure R B).toSubring.toAddSubgroup)
    (fun x hx ↦ (integralClosure R B).algebraMap_mem ⟨x, hx⟩) hR

namespace Subring

open scoped Topology Pointwise

variable {A : Type*} [CommRing A] [TopologicalSpace A] [SeparatelyContinuousMul A]
  {M : Type*} [AddCommMonoid M] [Module A M]

/-- Inverting a topologically nilpotent unit in an open subring recovers the ambient ring.
No boundedness, completeness, or integrally closedness is needed. -/
theorem isLocalizationAway_of_isOpen (S : Subring A) (hS : IsOpen (S : Set A)) (s : S)
    (hs : IsTopologicallyNilpotent (s : A)) (hu : IsUnit (s : A)) :
    IsLocalization.Away s A := by
  refine IsLocalization.Away.mk s hu (fun x ↦ ?_) (fun a b hab ↦ ?_)
  · obtain ⟨n, hn⟩ := exists_mul_pow_mem_of_isTopologicallyNilpotent hs hS x
    exact ⟨n, ⟨_, hn⟩, rfl⟩
  · exact ⟨0, by simpa using Subtype.ext hab⟩

/-- In an open subring `S`, an element which is a unit of the ambient ring divides some power of
every element of `S` that is topologically nilpotent in the ambient ring. -/
theorem exists_dvd_pow_of_isTopologicallyNilpotent (S : Subring A) (hS : IsOpen (S : Set A))
    {a b : S} (ha : IsUnit (a : A)) (hb : IsTopologicallyNilpotent (b : A)) :
    ∃ n : ℕ, a ∣ b ^ n := by
  obtain ⟨u, hu⟩ := ha
  obtain ⟨n, hn⟩ := exists_mul_pow_mem_of_isTopologicallyNilpotent hb hS (↑u⁻¹ : A)
  exact ⟨n, ⟨_, hn⟩, Subtype.ext <| by simp [← hu]⟩

/-- **The ambient ring is the localisation of an open subring at its ambient units.** If an open
subring `S` contains a topologically nilpotent element which is a unit of `A`, then `A` is the
localisation of `S` at the elements of `S` which are units of `A`. Unlike
`Subring.isLocalizationAway_of_isOpen`, the submonoid inverted involves no choice of element. -/
theorem isLocalization_of_isOpen (S : Subring A) (hS : IsOpen (S : Set A)) (s : S)
    (hs : IsTopologicallyNilpotent (s : A)) (hu : IsUnit (s : A)) :
    IsLocalization ((IsUnit.submonoid A).comap S.subtype) A := by
  have := S.isLocalizationAway_of_isOpen hS s hs hu
  refine (IsLocalization.iff_of_le_of_exists_dvd (M := Submonoid.powers s)
    (N := (IsUnit.submonoid A).comap S.subtype) ?_ ?_).mp this
  · exact Submonoid.powers_le.mpr hu
  · intro a ha
    obtain ⟨n, hn⟩ := S.exists_dvd_pow_of_isTopologicallyNilpotent hS
      ((IsUnit.mem_submonoid_iff _).mp (Submonoid.mem_comap.mp ha)) hs
    exact ⟨_, ⟨n, rfl⟩, hn⟩

/-- A ring with a topologically nilpotent unit and a noetherian open subring is noetherian.
Only separate continuity of multiplication is needed; the unit need not lie in the subring. -/
theorem isNoetherianRing_of_isOpen (S : Subring A) [IsNoetherianRing S]
    (hS : IsOpen (S : Set A)) {ϖ : A} (hϖ : IsTopologicallyNilpotent ϖ)
    (hu : IsUnit ϖ) : IsNoetherianRing A := by
  obtain ⟨n, hn⟩ := Filter.eventually_atTop.mp
    (hϖ.eventually_mem (hS.mem_nhds S.zero_mem))
  let s : S := ⟨ϖ ^ (n + 1), hn (n + 1) (by omega)⟩
  have : IsLocalization.Away s A := S.isLocalizationAway_of_isOpen hS s
    (hϖ.pow (Nat.succ_ne_zero n)) (hu.pow (n + 1))
  exact IsLocalization.isNoetherianRing (Submonoid.powers s) A inferInstance

/-- A power of a topologically nilpotent scalar `s` carries any element of the `A`-span
of `M₀` into `M₀`. No spanning hypothesis on the whole module is needed, and `s` need not lie
in `S`: only its large powers do. -/
theorem exists_pow_smul_mem (S : Subring A) (hS : IsOpen (S : Set A)) {s : A}
    (hs : IsTopologicallyNilpotent s)
    (M₀ : Submodule S M) {m : M}
    (hm : m ∈ Submodule.span A (M₀ : Set M)) :
    ∃ k : ℕ, s ^ k • m ∈ M₀ := by
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp (hs.eventually_mem (hS.mem_nhds S.zero_mem))
  have key : ∀ j, N ≤ j → ∀ z ∈ M₀, s ^ j • z ∈ M₀ := fun j hj z hz ↦ by
    simpa [Subring.smul_def] using M₀.smul_mem (⟨s ^ j, hN j hj⟩ : S) hz
  induction hm using Submodule.span_induction with
  | mem x hx => exact ⟨0, by simpa using hx⟩
  | zero => exact ⟨0, by simp⟩
  | add x y _ _ ihx ihy =>
      obtain ⟨kx, hkx⟩ := ihx; obtain ⟨ky, hky⟩ := ihy
      refine ⟨max kx ky + N, ?_⟩
      have hx' : s ^ (max kx ky + N) • x ∈ M₀ := by
        have he : max kx ky + N = (max kx ky + N - kx) + kx := by omega
        rw [he, pow_add, mul_smul]; exact key _ (by omega) _ hkx
      have hy' : s ^ (max kx ky + N) • y ∈ M₀ := by
        have he : max kx ky + N = (max kx ky + N - ky) + ky := by omega
        rw [he, pow_add, mul_smul]; exact key _ (by omega) _ hky
      rw [smul_add]; exact M₀.add_mem hx' hy'
  | smul c x _ ih =>
      obtain ⟨k, hk⟩ := ih
      obtain ⟨i, hi⟩ := exists_mul_pow_mem_of_isTopologicallyNilpotent hs hS c
      rw [mul_comm] at hi
      refine ⟨i + k, ?_⟩
      have he : s ^ (i + k) • (c • x) = (⟨s ^ i * c, hi⟩ : S) • (s ^ k • x) := by
        rw [smul_smul, Subring.smul_def, ← smul_assoc, smul_eq_mul]
        congr 1
        push_cast
        rw [pow_add]; ring
      rw [he]; exact M₀.smul_mem _ hk

/-- A power of `s` carries a finitely generated `S`-submodule into `M₀` uniformly.

A *single* exponent serves all of `M₁` at once. That uniformity is exactly what finite generation
buys: without it `exists_pow_smul_mem` still gives an exponent for each element separately, but
those exponents need not be bounded, and no power of `s` need carry the whole submodule.

`M₀` is not required to span `M`; only `M₁` need lie in its span. -/
theorem exists_pow_smul_le (S : Subring A) (hS : IsOpen (S : Set A)) {s : A}
    (hs : IsTopologicallyNilpotent s)
    (hs0 : s ∈ S) (M₀ M₁ : Submodule S M)
    (hspan : (M₁ : Set M) ⊆ Submodule.span A (M₀ : Set M)) (hfg : M₁.FG) :
    ∃ k : ℕ, (⟨s, hs0⟩ : S) ^ k • M₁ ≤ M₀ := by
  obtain ⟨G, hG⟩ := hfg
  have hGmem : ∀ g ∈ (G : Set M), g ∈ Submodule.span A (M₀ : Set M) := fun g hg ↦
    hspan (hG ▸ Submodule.subset_span hg)
  choose! f hf using fun g hg ↦ S.exists_pow_smul_mem hS hs M₀ (hGmem g hg)
  refine ⟨G.sup f, ?_⟩
  rw [← hG, Submodule.smul_span, Submodule.span_le]
  rintro _ ⟨g, hg, rfl⟩
  obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le (Finset.le_sup (f := f) hg)
  simpa only [SetLike.mem_coe, Subring.smul_def, SubmonoidClass.coe_pow, hd, Nat.add_comm] using
    M₀.pow_add_smul_mem hs0 d (f g) g (hf g hg)

/-- Every member of the power-scaled family built from `M₀` contains a member built from a
finitely generated `M₁` lying in the `A`-span of `M₀`.

Applying this in both directions compares the two filtrations when both submodules are
finitely generated and each lies in the ambient span of the other. -/
theorem exists_pow_smul_le_pow_smul (S : Subring A) (hS : IsOpen (S : Set A)) {s : A}
    (hs : IsTopologicallyNilpotent s) (hs0 : s ∈ S)
    (M₀ M₁ : Submodule S M) (hspan : (M₁ : Set M) ⊆ Submodule.span A (M₀ : Set M))
    (hfg : M₁.FG) (n : ℕ) : ∃ k : ℕ, (⟨s, hs0⟩ : S) ^ k • M₁
      ≤ (⟨s, hs0⟩ : S) ^ n • M₀ := by
  obtain ⟨k, hk⟩ := S.exists_pow_smul_le hS hs hs0 M₀ M₁ hspan hfg
  refine ⟨n + k, ?_⟩
  have hsplit : (⟨s, hs0⟩ : S) ^ (n + k) • M₁
      = (⟨s, hs0⟩ : S) ^ n • ((⟨s, hs0⟩ : S) ^ k • M₁) := by
    rw [pow_add, mul_smul]
  rw [hsplit]
  exact smul_mono_right ((⟨s, hs0⟩ : S) ^ n) hk

/-- The powers of a topologically nilpotent scalar `t` are cofinal in the filtration of `M₀`
by powers of a unit `s`: for every `sⁿ • M₀`, some `tᵏ • M₀` is contained in it.

No finite-generation or spanning hypothesis on `M₀` is needed. -/
theorem exists_pow_smul_le_pow_smul_of_isUnit (S : Subring A) (hS : IsOpen (S : Set A))
    {s t : A} (hs : IsUnit s) (ht : IsTopologicallyNilpotent t)
    (hs0 : s ∈ S) (ht0 : t ∈ S)
    (M₀ : Submodule S M) (n : ℕ) :
    ∃ k : ℕ, (⟨t, ht0⟩ : S) ^ k • M₀
      ≤ (⟨s, hs0⟩ : S) ^ n • M₀ := by
  obtain ⟨u, rfl⟩ := hs
  obtain ⟨k, hk⟩ := exists_mul_pow_mem_of_isTopologicallyNilpotent ht hS ((↑u⁻¹ : A) ^ n)
  rw [mul_comm] at hk
  refine ⟨k, fun x hx ↦ ?_⟩
  obtain ⟨y, hy, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hx
  apply (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr
  refine ⟨(⟨t ^ k * (↑u⁻¹ : A) ^ n, hk⟩ : S) • y,
    M₀.smul_mem _ hy, ?_⟩
  rw [smul_smul]
  congr 1
  ext
  simp [mul_left_comm, ← mul_pow]

end Subring

namespace TauCeti

/-- The reduction `π : O →+* R` modulo `ϖ O`, for a unit `ϖ` of `F` in an open subring `O`, is
locally constant: `π` is constant on the open sets `x + ϖ O`. -/
theorem isLocallyConstant_of_ker_eq_span {F R : Type*} [CommRing F] [CommRing R]
    [TopologicalSpace F] [IsTopologicalRing F] {O : Subring F} {ϖ : Fˣ} {π : O →+* R}
    (hO : IsOpen (O : Set F)) (hϖ : (ϖ : F) ∈ O)
    (hker : RingHom.ker π = Ideal.span {⟨ϖ, hϖ⟩}) : IsLocallyConstant π := by
  -- the kernel `ϖ O` is the preimage of `O` under `x ↦ ϖ⁻¹ x`, hence open
  have hopen : IsOpen (π.toAddMonoidHom.ker : Set O) := by
    have : (π.toAddMonoidHom.ker : Set O) = (fun y : O ↦ ((ϖ⁻¹ : Fˣ) : F) * y) ⁻¹' O := by
      ext y
      simpa using map_eq_zero_iff_inv_mul_mem hϖ hker y
    rw [this]
    exact hO.preimage (by fun_prop)
  exact π.toAddMonoidHom.isLocallyConstant_of_isOpen_ker hopen

end TauCeti
