/-!
# Closed two-sided ideals

The closure of a two-sided ideal in a topological ring is again two-sided, and closed two-sided
ideals in rings with an approximate unit absorb compatible scalar multiplication. In a `T₁`
topological ring with continuous multiplication, the left and right annihilators of any two-sided
ideal are closed and agree with the annihilators of its topological closure; we also define
essential ideals in the lattice of closed two-sided ideals (`TwoSidedIdeal.IsClosedEssential`) and
relate them to `TwoSidedIdeal.IsEssential` and annihilators. We
also supply the topological-ring structure on Mathlib's existing quotient topology
for quotients of noncommutative rings by native ideals. The closed ideal generated
by an ideal of the center presents discrete modules with central relations.
Continuous algebra equivalences carrying one central character to another map the closed ideal
generated by the kernel of the first into that of the second
(`AlgEquiv.apply_mem_closedCentralIdeal_ker`), so continuous automorphisms with continuous
inverses fixing a character preserve its closed ideal (`MonoidHom.map_closedCentralIdeal_ker`).
When ring automorphisms preserving a two-sided ideal have continuous inverses, so do the
automorphisms they induce on the quotient (`MonoidHom.continuous_quotientRingAut_symm`).

The quotient-ring construction generalizes Patrick Massot's
`QuotientRing.topologicalRing_quotient` in Mathlib from commutative rings, using
the same native additive quotient and open quotient-map argument.
-/

public section

open Filter Topology

namespace Ideal

variable {A : Type*} [Ring A] [TopologicalSpace A]

/-- A quotient of a possibly noncommutative topological ring is a topological ring. -/
instance (priority := 100) isTopologicalRingQuotient [IsTopologicalRing A]
    (I : Ideal A) [I.IsTwoSided] : IsTopologicalRing (A ⧸ I) where
  __ := Submodule.isTopologicalAddGroup_quotient I
  continuous_mul := by
    have hq := I.isOpenQuotientMap_mkQ.prodMap I.isOpenQuotientMap_mkQ
    exact hq.isQuotientMap.continuous_iff.mpr
      (I.isQuotientMap_mkQ.continuous.comp continuous_mul)

/-- The closure of a two-sided ideal is two-sided. -/
instance isTwoSided_closure [IsTopologicalRing A] (I : Ideal A) [I.IsTwoSided] :
    I.closure.IsTwoSided where
  mul_mem_of_left {_} b ha :=
    map_mem_closure (f := fun x : A => x * b)
      (s := (I : Set A)) (t := (I : Set A))
      (continuous_mul_const b) ha fun _ hx => I.mul_mem_right b hx

end Ideal

namespace MonoidHom

variable {H : Type*} [Monoid H] {A : Type*} [Ring A] [TopologicalSpace A] (a : H →* RingAut A)
  (I : Ideal A) [I.IsTwoSided] (hI : ∀ h, I.map (a h : A →+* A) = I)

/-- If the inverse of an automorphism preserving `I` is continuous, so is the inverse of the
induced automorphism of `A ⧸ I`, for the quotient topology. -/
theorem continuous_quotientRingAut_symm {h : H} (ha : Continuous (a h).symm) :
    Continuous (a.quotientRingAut I hI h).symm :=
  I.isQuotientMap_mkQ.continuous_iff.mpr <| (I.isQuotientMap_mkQ.continuous.comp ha).congr
    fun x => (a.quotientRingAut_symm_apply_mk I hI h x).symm

end MonoidHom

namespace TwoSidedIdeal

section TopologicalClosure

variable {A : Type*} [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A]

/-- The topological closure of a two-sided ideal in a possibly nonunital topological ring, as a
native two-sided ideal. -/
def topologicalClosure (I : TwoSidedIdeal A) : TwoSidedIdeal A :=
  TwoSidedIdeal.mk' (closure (I : Set A))
    (subset_closure I.zero_mem)
    (fun hx hy => map_mem_closure₂ continuous_add hx hy fun _ ha _ hb => I.add_mem ha hb)
    (fun hx => map_mem_closure continuous_neg hx fun _ ha => I.neg_mem ha)
    (fun {x _} hy => map_mem_closure (continuous_const_mul x) hy fun _ hb => I.mul_mem_left x _ hb)
    (fun {_ y} hx => map_mem_closure (f := fun x : A => x * y) (s := (I : Set A))
      (t := (I : Set A)) (continuous_mul_const y) hx fun _ ha => I.mul_mem_right _ y ha)

@[simp]
theorem coe_topologicalClosure (I : TwoSidedIdeal A) :
    (I.topologicalClosure : Set A) = closure (I : Set A) := by
  simp [topologicalClosure]

@[simp]
theorem mem_topologicalClosure {I : TwoSidedIdeal A} {a : A} :
    a ∈ I.topologicalClosure ↔ a ∈ closure (I : Set A) := by
  rw [← SetLike.mem_coe, coe_topologicalClosure]

/-- A two-sided ideal is contained in its topological closure. -/
theorem le_topologicalClosure (I : TwoSidedIdeal A) : I ≤ I.topologicalClosure := by
  intro a ha
  rw [mem_topologicalClosure]
  exact subset_closure ha

/-- The topological closure is closed. -/
theorem isClosed_topologicalClosure (I : TwoSidedIdeal A) :
    IsClosed (I.topologicalClosure : Set A) := by
  rw [coe_topologicalClosure]
  exact isClosed_closure

/-- A closed two-sided ideal equals its topological closure. -/
@[simp]
theorem topologicalClosure_eq_self (I : TwoSidedIdeal A) [hI : IsClosed (I : Set A)] :
    I.topologicalClosure = I := by
  ext a
  rw [mem_topologicalClosure, hI.closure_eq, SetLike.mem_coe]

/-- Taking topological closure of a two-sided ideal is idempotent. -/
theorem topologicalClosure_idem (I : TwoSidedIdeal A) :
    I.topologicalClosure.topologicalClosure = I.topologicalClosure := by
  have : IsClosed (I.topologicalClosure : Set A) := I.isClosed_topologicalClosure
  exact I.topologicalClosure.topologicalClosure_eq_self

/-- Taking topological closure of two-sided ideals is monotone. -/
theorem topologicalClosure_mono {I J : TwoSidedIdeal A} (h : I ≤ J) :
    I.topologicalClosure ≤ J.topologicalClosure := by
  rw [← SetLike.coe_subset_coe, coe_topologicalClosure, coe_topologicalClosure]
  exact closure_mono h

/-- The closure is the least closed two-sided ideal containing the original ideal. -/
theorem topologicalClosure_le_iff (I J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A)) :
    I.topologicalClosure ≤ J ↔ I ≤ J :=
  ⟨fun h => I.le_topologicalClosure.trans h,
    fun h => by
      rw [← SetLike.coe_subset_coe, coe_topologicalClosure]
      exact closure_minimal h hJ⟩

end TopologicalClosure

section ClosedKer

variable {A B F : Type*} [NonUnitalNonAssocRing A] [TopologicalSpace A]
  [NonUnitalNonAssocSemiring B] [TopologicalSpace B] [T1Space B]
  [FunLike F A B] [NonUnitalRingHomClass F A B]

/-- The kernel two-sided ideal of a continuous nonunital ring homomorphism into a `T₁` space is
closed. -/
theorem isClosed_ker {f : F} (hf : Continuous f) : IsClosed (TwoSidedIdeal.ker f : Set A) := by
  have hset : (TwoSidedIdeal.ker f : Set A) = f ⁻¹' {0} := by
    ext x
    exact TwoSidedIdeal.mem_ker f
  rw [hset]
  exact isClosed_singleton.preimage hf

end ClosedKer

section ApproximateUnit

variable {R A : Type*} [Semiring R] [NonUnitalRing A] [TopologicalSpace A]
  [Module R A] [IsScalarTower R A A] [ContinuousConstSMul R A]

/-- In a topological ring with a scalar-compatible `R`-module structure and an approximate unit,
every closed two-sided ideal is closed under scalar multiplication by `R`. -/
theorem smul_mem_of_isApproximateUnit (I : TwoSidedIdeal A) [hI : IsClosed (I : Set A)]
    {l : Filter A} (hl : l.IsApproximateUnit) (c : R) {a : A} (ha : a ∈ I) :
    c • a ∈ I := by
  have := hl.neBot
  have hlim : Tendsto (fun e => (c • e) * a) l (𝓝 (c • a)) := by
    simpa only [smul_mul_assoc] using (hl.tendsto_mul_right a).const_smul c
  exact hI.mem_of_tendsto hlim (Eventually.of_forall fun e => I.mul_mem_left (c • e) a ha)

end ApproximateUnit

section ClosedLattice

variable {A : Type*} [NonUnitalNonAssocRing A] [TopologicalSpace A]

instance isClosed_top : IsClosed ((⊤ : TwoSidedIdeal A) : Set A) :=
  isClosed_univ

instance isClosed_bot [T1Space A] : IsClosed ((⊥ : TwoSidedIdeal A) : Set A) :=
  isClosed_singleton

instance isClosed_inf (I J : TwoSidedIdeal A) [hI : IsClosed (I : Set A)]
    [hJ : IsClosed (J : Set A)] : IsClosed ((I ⊓ J : TwoSidedIdeal A) : Set A) :=
  hI.inter hJ

end ClosedLattice

section ClosedAnnihilator

variable {A : Type*} [NonUnitalRing A] [TopologicalSpace A]

/-- In a `T₁` space with continuous multiplication, the left annihilator of any two-sided ideal is
closed, as an intersection of preimages of `{0}` under right multiplications. -/
instance isClosed_leftAnnihilator [ContinuousMul A] [T1Space A] (I : TwoSidedIdeal A) :
    IsClosed (I.leftAnnihilator : Set A) := by
  have hset : (I.leftAnnihilator : Set A) = ⋂ x ∈ (I : Set A), (· * x) ⁻¹' {0} := by
    ext a
    simp [mem_leftAnnihilator]
  rw [hset]
  exact isClosed_biInter fun x _ => isClosed_singleton.preimage (continuous_mul_const x)

/-- In a `T₁` space with continuous multiplication, the right annihilator of any two-sided ideal is
closed, as an intersection of preimages of `{0}` under left multiplications. -/
instance isClosed_rightAnnihilator [ContinuousMul A] [T1Space A] (I : TwoSidedIdeal A) :
    IsClosed (I.rightAnnihilator : Set A) := by
  have hset : (I.rightAnnihilator : Set A) = ⋂ x ∈ (I : Set A), (x * ·) ⁻¹' {0} := by
    ext a
    simp [mem_rightAnnihilator]
  rw [hset]
  exact isClosed_biInter fun x _ => isClosed_singleton.preimage (continuous_const_mul x)

/-- Taking topological closure does not change the left annihilator of a two-sided ideal. -/
@[simp]
theorem leftAnnihilator_topologicalClosure [IsTopologicalRing A] [T1Space A]
    (I : TwoSidedIdeal A) :
    I.topologicalClosure.leftAnnihilator = I.leftAnnihilator :=
  le_antisymm (leftAnnihilator_anti I.le_topologicalClosure) fun a ha =>
    mem_leftAnnihilator.mpr fun _ hx =>
      closure_minimal (fun _ hy => mul_eq_zero_of_mem_leftAnnihilator ha hy)
        (isClosed_singleton.preimage (continuous_const_mul a))
        (I.mem_topologicalClosure.mp hx)

/-- Taking topological closure does not change the right annihilator of a two-sided ideal. -/
@[simp]
theorem rightAnnihilator_topologicalClosure [IsTopologicalRing A] [T1Space A]
    (I : TwoSidedIdeal A) :
    I.topologicalClosure.rightAnnihilator = I.rightAnnihilator :=
  le_antisymm (rightAnnihilator_anti I.le_topologicalClosure) fun a ha =>
    mem_rightAnnihilator.mpr fun _ hx =>
      closure_minimal (fun _ hy => mul_eq_zero_of_mem_rightAnnihilator hy ha)
        (isClosed_singleton.preimage (continuous_mul_const a))
        (I.mem_topologicalClosure.mp hx)

end ClosedAnnihilator

section ClosedEssential

variable {A : Type*} [NonUnitalNonAssocRing A] [TopologicalSpace A]

/-- A two-sided ideal `I` of a topological ring `A` is *essential among closed ideals* if it meets
every nonzero closed two-sided ideal of `A` nontrivially. -/
def IsClosedEssential (I : TwoSidedIdeal A) : Prop :=
  ∀ J : TwoSidedIdeal A, IsClosed (J : Set A) → J ≠ ⊥ → I ⊓ J ≠ ⊥

theorem isClosedEssential_def {I : TwoSidedIdeal A} :
    I.IsClosedEssential ↔ ∀ J : TwoSidedIdeal A, IsClosed (J : Set A) → J ≠ ⊥ → I ⊓ J ≠ ⊥ :=
  Iff.rfl

/-- Contrapositive characterization: `I.IsClosedEssential` iff `I ⊓ J = ⊥` forces `J = ⊥` for every
closed two-sided ideal `J`. -/
theorem isClosedEssential_iff_eq_bot {I : TwoSidedIdeal A} :
    I.IsClosedEssential ↔ ∀ J : TwoSidedIdeal A, IsClosed (J : Set A) → I ⊓ J = ⊥ → J = ⊥ :=
  ⟨fun h J hJ hIJ => by_contra fun hJ0 => h J hJ hJ0 hIJ,
   fun h J hJ hJ0 hIJ => hJ0 (h J hJ hIJ)⟩

theorem IsEssential.isClosedEssential {I : TwoSidedIdeal A} (hI : I.IsEssential) :
    I.IsClosedEssential :=
  isClosedEssential_def.mpr fun J _ => isEssential_def.mp hI J

@[simp]
theorem isClosedEssential_top : (⊤ : TwoSidedIdeal A).IsClosedEssential :=
  isEssential_top.isClosedEssential

theorem IsClosedEssential.mono {I J : TwoSidedIdeal A} (hI : I.IsClosedEssential) (hIJ : I ≤ J) :
    J.IsClosedEssential :=
  isClosedEssential_iff_eq_bot.mpr fun K hK hJK =>
    isClosedEssential_iff_eq_bot.mp hI K hK (le_bot_iff.mp ((inf_le_inf_right K hIJ).trans hJK.le))

theorem IsClosedEssential.inf_of_isClosed {I J : TwoSidedIdeal A}
    (hI : I.IsClosedEssential) (hJ : J.IsClosedEssential) [IsClosed (J : Set A)] :
    (I ⊓ J).IsClosedEssential :=
  isClosedEssential_iff_eq_bot.mpr fun K hK hIJK =>
    isClosedEssential_iff_eq_bot.mp hJ K hK <|
      isClosedEssential_iff_eq_bot.mp hI (J ⊓ K) (isClosed_inf J K) (by rwa [← inf_assoc])

@[simp]
theorem isClosedEssential_bot_iff : (⊥ : TwoSidedIdeal A).IsClosedEssential ↔ Subsingleton A := by
  rw [isClosedEssential_iff_eq_bot]
  refine ⟨fun h => ⟨fun a b => ?_⟩, fun _ J _ _ => ?_⟩
  · have htop : (⊤ : TwoSidedIdeal A) = ⊥ := h ⊤ isClosed_top (by simp)
    have ha : a - b ∈ (⊥ : TwoSidedIdeal A) := htop ▸ mem_top A
    exact sub_eq_zero.mp ((mem_bot _).mp ha)
  · ext x
    simp [Subsingleton.elim x 0]

theorem not_isClosedEssential_bot [Nontrivial A] : ¬ (⊥ : TwoSidedIdeal A).IsClosedEssential := by
  rw [isClosedEssential_bot_iff]
  exact not_subsingleton A

theorem IsClosedEssential.ne_bot [Nontrivial A] {I : TwoSidedIdeal A}
    (hI : I.IsClosedEssential) : I ≠ ⊥ :=
  fun h => not_isClosedEssential_bot (h ▸ hI)

end ClosedEssential

section ClosedEssentialRing

variable {A : Type*} [NonUnitalRing A] [TopologicalSpace A]

theorem isClosedEssential_of_leftAnnihilator_eq_bot {I : TwoSidedIdeal A}
    (hI : I.leftAnnihilator = ⊥) : I.IsClosedEssential :=
  (isEssential_of_leftAnnihilator_eq_bot hI).isClosedEssential

theorem isClosedEssential_of_rightAnnihilator_eq_bot {I : TwoSidedIdeal A}
    (hI : I.rightAnnihilator = ⊥) : I.IsClosedEssential :=
  (isEssential_of_rightAnnihilator_eq_bot hI).isClosedEssential

/-- In a `T₁` ring with continuous multiplication and proper involution, a `star`-closed two-sided
ideal is essential among closed ideals if and only if its left annihilator is trivial. -/
theorem isClosedEssential_iff_leftAnnihilator_eq_bot_of_star_mem
    [ContinuousMul A] [T1Space A] [StarRing A] [IsProperStar A]
    {I : TwoSidedIdeal A} (hstar : ∀ {x : A}, x ∈ I → star x ∈ I) :
    I.IsClosedEssential ↔ I.leftAnnihilator = ⊥ :=
  ⟨fun h => isClosedEssential_iff_eq_bot.mp h I.leftAnnihilator I.isClosed_leftAnnihilator
      (inf_leftAnnihilator_eq_bot_of_star_mem hstar),
   isClosedEssential_of_leftAnnihilator_eq_bot⟩

/-- In a `T₁` ring with continuous multiplication and proper involution, essentiality among closed
two-sided ideals and algebraic essentiality coincide for `star`-closed two-sided ideals. -/
theorem isClosedEssential_iff_isEssential_of_star_mem
    [ContinuousMul A] [T1Space A] [StarRing A] [IsProperStar A]
    {I : TwoSidedIdeal A} (hstar : ∀ {x : A}, x ∈ I → star x ∈ I) :
    I.IsClosedEssential ↔ I.IsEssential := by
  rw [isClosedEssential_iff_leftAnnihilator_eq_bot_of_star_mem hstar,
    isEssential_iff_leftAnnihilator_eq_bot_of_star_mem hstar]

end ClosedEssentialRing

end TwoSidedIdeal

namespace Ideal

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]
  [TopologicalSpace A] [IsTopologicalRing A]

/-- The closed two-sided ideal generated by an ideal of the center. -/
def closedCentralIdeal (L : Ideal (Subalgebra.center R A)) : TwoSidedIdeal A :=
  (TwoSidedIdeal.span ((↑) '' (L : Set (Subalgebra.center R A)))).topologicalClosure

/-- The generated central ideal is closed. -/
theorem isClosed_closedCentralIdeal (L : Ideal (Subalgebra.center R A)) :
    IsClosed (closedCentralIdeal L : Set A) :=
  TwoSidedIdeal.isClosed_topologicalClosure _

/-- Every central relation belongs to the closed generated ideal. -/
theorem mem_closedCentralIdeal (L : Ideal (Subalgebra.center R A))
    {z : Subalgebra.center R A} (hz : z ∈ L) : (z : A) ∈ closedCentralIdeal L :=
  TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span ⟨z, hz, rfl⟩)

/-- The closed central ideal is the least closed two-sided ideal containing the relations. -/
theorem closedCentralIdeal_le_iff (L : Ideal (Subalgebra.center R A))
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A)) :
    closedCentralIdeal L ≤ J ↔ ∀ z ∈ L, (z : A) ∈ J := by
  rw [closedCentralIdeal, TwoSidedIdeal.topologicalClosure_le_iff _ _ hJ,
    TwoSidedIdeal.span_le]
  exact ⟨fun h z hz => h ⟨z, hz, rfl⟩, fun h _ ⟨z, hz, he⟩ => he ▸ h z hz⟩

end Ideal

namespace AlgEquiv

open TauCeti Ideal

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]
  [TopologicalSpace A] [IsTopologicalRing A] {B : Type*} [Ring B] [Algebra R B]
  [TopologicalSpace B] [IsTopologicalRing B]

/-- A continuous algebra equivalence carrying the central character `χ` to `χ'` maps the closed
ideal generated by the kernel of `χ` into that generated by the kernel of `χ'`. -/
theorem apply_mem_closedCentralIdeal_ker (e : A ≃ₐ[R] B) (he : Continuous e)
    {χ : Subalgebra.center R A →ₐ[R] R} {χ' : Subalgebra.center R B →ₐ[R] R}
    (hχ : χ'.comp (Subalgebra.centerCongr e).toAlgHom = χ) {x : A}
    (hx : x ∈ closedCentralIdeal (RingHom.ker χ)) :
    e x ∈ closedCentralIdeal (RingHom.ker χ') := by
  have hcomap : (TwoSidedIdeal.comap e (closedCentralIdeal (RingHom.ker χ')) : Set A) =
      e ⁻¹' closedCentralIdeal (RingHom.ker χ') :=
    Set.ext fun _ => TwoSidedIdeal.mem_comap e
  have hclosed : IsClosed
      (TwoSidedIdeal.comap e (closedCentralIdeal (RingHom.ker χ')) : Set A) := by
    rw [hcomap]
    exact (isClosed_closedCentralIdeal _).preimage he
  refine (TwoSidedIdeal.mem_comap e).mp
    (((closedCentralIdeal_le_iff _ _ hclosed).mpr fun z hz => ?_) hx)
  rw [TwoSidedIdeal.mem_comap, ← Subalgebra.centerCongr_apply_coe e z]
  refine mem_closedCentralIdeal _ ?_
  rw [RingHom.mem_ker] at hz ⊢
  exact (congrArg (fun φ => φ z) hχ).trans hz

end AlgEquiv

namespace MonoidHom

open TauCeti Ideal

variable {H : Type*} [Monoid H] {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]
  [TopologicalSpace A] [IsTopologicalRing A] (a : H →* (A ≃ₐ[R] A))
  (χ : Subalgebra.center R A →ₐ[R] R) (ha : ∀ h, Continuous (a h).symm)
  (ha' : ∀ h, Continuous (a h))
  (hχ : ∀ h, χ.comp (Subalgebra.centerCongr (a h).symm).toAlgHom = χ)

include ha ha' hχ in
/-- Continuous automorphisms with continuous inverses that preserve a central character preserve
the closed ideal generated by its kernel. -/
theorem map_closedCentralIdeal_ker (h : H) :
    (closedCentralIdeal (RingHom.ker χ)).asIdeal.map
        ((MulSemiringAction.toRingEquiv (A ≃ₐ[R] A) A).comp a h : A →+* A) =
      (closedCentralIdeal (RingHom.ker χ)).asIdeal := by
  rw [Ideal.map_comap_of_equiv]
  ext x
  rw [Ideal.mem_comap, TwoSidedIdeal.mem_asIdeal, TwoSidedIdeal.mem_asIdeal]
  constructor
  · intro hx
    have := (a h).apply_mem_closedCentralIdeal_ker (ha' h) (χ := χ) (χ' := χ) ?_ hx
    · simpa using this
    · ext z
      simpa [Subalgebra.centerCongr_apply_coe (a h) z, ← Subalgebra.symm_centerCongr] using
        (congrArg (fun φ => φ (Subalgebra.centerCongr (a h) z)) (hχ h)).symm
  · intro hx
    refine (a h).symm.apply_mem_closedCentralIdeal_ker (ha h) (χ := χ) (χ' := χ) ?_ hx
    ext z
    simpa using congrArg (fun φ => φ z) (hχ h)

end MonoidHom
