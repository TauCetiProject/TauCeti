/-!
# Adic topologies on modules

For an ideal `I` of a commutative ring, every linear map is continuous for the `I`-adic
module topologies, and every surjective linear map is an open quotient map. These assertions
need neither finite generation nor completeness.

Whenever a submodule `P` of a module `M` satisfies an Artin–Rees bound
`∃ k, ∀ n, P ⊓ (I ^ (n + k) • ⊤) ≤ I ^ n • P` — for instance when `R` is noetherian and `M` is
finite, or when `R` is strictly topologically of finite type over a complete rank-one valuation
base, `M` is finite, and `I` is generated by a pseudouniformiser — the `I`-adic topology of `P`
equals its subspace topology in `M`. Consequently every linear map whose image satisfies such a
bound is strict. If moreover `P` is `I`-adically precomplete and `M` is `I`-adically Hausdorff,
`P` is closed in `M` for the `I`-adic topology, and `M ⧸ P` is `I`-adically Hausdorff.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique I*,
  Ch. 0, §§7.2–7.3, especially Corollaire 7.3.6.
* S. Bosch and W. Lütkebohmert, *Formal and rigid geometry. I. Rigid spaces*, Math. Ann. 295
  (1993), §1, Lemma 1.2(a),(b).
-/

public section

open Filter Topology

variable {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N]

namespace Ideal

/-- The powers `I^n M` form a neighbourhood basis of zero for the adic module topology. -/
theorem hasBasis_nhds_zero_adicModule (I : Ideal R) :
    (@nhds M (I.adicModuleTopology M) 0).HasBasis (fun _ : ℕ ↦ True)
      (fun n ↦ (↑(I ^ n • (⊤ : Submodule R M)) : Set M)) := by
  let := I.adicTopology
  exact (I.ringFilterBasis.submodulesBasisIsBasis (I.adic_module_basis M)).hasBasis_nhds_zero

end Ideal

namespace LinearMap

/-- Every linear map is continuous for the adic module topologies. -/
theorem continuous_adicModuleTopology (f : M →ₗ[R] N) (I : Ideal R) :
    @Continuous M N (I.adicModuleTopology M) (I.adicModuleTopology N) f := by
  let := I.adicTopology
  let := I.adicModuleTopology M
  let := I.adicModuleTopology N
  refine continuous_of_continuousAt_zero f.toAddMonoidHom ?_
  rw [ContinuousAt, map_zero]
  exact (I.hasBasis_nhds_zero_adicModule.tendsto_iff
    I.hasBasis_nhds_zero_adicModule).mpr fun n _ ↦
      ⟨n, trivial, Submodule.smul_top_le_comap_smul_top (I ^ n) f⟩

/-- A surjective linear map is an open quotient map for adic module topologies, without
finiteness or completeness assumptions. In particular, adic module topology commutes with
quotients. -/
theorem isOpenQuotientMap_adicModuleTopology (f : M →ₗ[R] N) (I : Ideal R)
    (hf : Function.Surjective f) :
    @IsOpenQuotientMap M N (I.adicModuleTopology M) (I.adicModuleTopology N) f := by
  let := I.adicTopology
  let := I.adicModuleTopology M
  let := I.adicModuleTopology N
  refine ⟨hf, f.continuous_adicModuleTopology I, ?_⟩
  rw [IsTopologicalAddGroup.isOpenMap_iff_nhds_zero]
  have hmap (n : ℕ) : f '' (↑(I ^ n • (⊤ : Submodule R M)) : Set M) =
      (↑(I ^ n • (⊤ : Submodule R N)) : Set N) := by
    rw [← Submodule.map_coe, Submodule.map_smul'', Submodule.map_top,
      LinearMap.range_eq_top.mpr hf]
  exact ((I.hasBasis_nhds_zero_adicModule (M := N)).le_basis_iff
    ((I.hasBasis_nhds_zero_adicModule (M := M)).map f)).mpr
      fun n _ ↦ ⟨n, trivial, (hmap n).ge⟩

end LinearMap

namespace Submodule

/-- An Artin–Rees bound `P ⊓ (I ^ (n + k) • ⊤) ≤ I ^ n • P` makes the `I`-adic topology of `P`
equal to its subspace topology in `M`, without noetherianity, completeness or separatedness. -/
theorem isEmbedding_subtype_adicModuleTopology_of_exists_inf_pow_smul_le
    (P : Submodule R M) (I : Ideal R)
    (h : ∃ k : ℕ, ∀ n : ℕ, P ⊓ (I ^ (n + k) • ⊤) ≤ I ^ n • P) :
    @Topology.IsEmbedding P M (I.adicModuleTopology P) (I.adicModuleTopology M) P.subtype := by
  let := I.adicTopology
  let := I.adicModuleTopology M
  let := I.adicModuleTopology P
  refine ⟨IsTopologicalAddGroup.isInducing_iff_nhds_zero.mpr ?_, P.injective_subtype⟩
  refine le_antisymm ?_ ?_
  · exact Filter.map_le_iff_le_comap.mp
      (by simpa only [ContinuousAt, Filter.Tendsto, map_zero] using
        (P.subtype.continuous_adicModuleTopology I).continuousAt (x := 0))
  obtain ⟨k, hk⟩ := h
  refine ((I.hasBasis_nhds_zero_adicModule (M := M)).comap P.subtype).le_basis_iff
    (I.hasBasis_nhds_zero_adicModule (M := P)) |>.mpr ?_
  intro n _
  exact ⟨n + k, trivial, fun x hx ↦ (Submodule.mem_smul_top_iff (I ^ n) P x).mpr (hk n ⟨x.property,
      hx⟩)⟩

/-- Artin–Rees makes the adic topology of a submodule of a finite module over a noetherian
ring equal to its subspace topology. No completeness or separatedness is required. -/
theorem isEmbedding_subtype_adicModuleTopology [IsNoetherianRing R] [Module.Finite R M]
    (P : Submodule R M) (I : Ideal R) :
    @Topology.IsEmbedding P M (I.adicModuleTopology P) (I.adicModuleTopology M) P.subtype := by
  obtain ⟨k, hk⟩ := I.exists_pow_inf_eq_pow_smul P
  refine P.isEmbedding_subtype_adicModuleTopology_of_exists_inf_pow_smul_le I ⟨k, fun n ↦ ?_⟩
  rw [inf_comm, hk (n + k) (Nat.le_add_left k n), Nat.add_sub_cancel]
  exact Submodule.smul_mono le_rfl inf_le_right

/-- An `I`-adically precomplete submodule `P` of an `I`-adically Hausdorff module `M` satisfying
an Artin–Rees bound `P ⊓ (I ^ (n + k) • ⊤) ≤ I ^ n • P` is closed for the `I`-adic topology on
`M`. -/
theorem isClosed_adicModuleTopology_of_exists_inf_pow_smul_le
    (P : Submodule R M) (I : Ideal R) [IsPrecomplete I P] [IsHausdorff I M]
    (h : ∃ k : ℕ, ∀ n : ℕ, P ⊓ (I ^ (n + k) • ⊤) ≤ I ^ n • P) :
    @IsClosed M (I.adicModuleTopology M) (P : Set M) := by
  let := I.adicTopology
  let := I.adicModuleTopology M
  rw [← closure_subset_iff_isClosed]
  intro x hx
  obtain ⟨k, hk⟩ := h
  have hnhds (n : ℕ) : ∃ y : P, (y : M) - x ∈ (I ^ n • ⊤ : Submodule R M) := by
    have hmem : (· - x) ⁻¹' ((I ^ n • ⊤ : Submodule R M) : Set M) ∈ 𝓝 x := by
      refine (continuous_sub_right x).continuousAt ?_
      simpa using (I.hasBasis_nhds_zero_adicModule (M := M)).mem_of_mem trivial
    obtain ⟨y, hyU, hyP⟩ := mem_closure_iff_nhds.mp hx _ hmem
    exact ⟨⟨y, hyP⟩, hyU⟩
  choose y hy using hnhds
  let z (n : ℕ) : P := y (n + k)
  have hcauchy {m n : ℕ} (hmn : m ≤ n) : z m ≡ z n [SMOD (I ^ m • ⊤ : Submodule R P)] := by
    rw [SModEq.sub_mem, Submodule.mem_smul_top_iff]
    refine hk m ⟨(z m - z n).property, ?_⟩
    have hm : (z m : M) - x ∈ (I ^ (m + k) • ⊤ : Submodule R M) := hy (m + k)
    have hn : (z n : M) - x ∈ (I ^ (m + k) • ⊤ : Submodule R M) :=
      Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.add_le_add_right hmn k)) (hy (n + k))
    simpa [sub_sub_sub_cancel_right] using sub_mem hm hn
  obtain ⟨L, hL⟩ := IsPrecomplete.prec (I := I) inferInstance (f := z) @hcauchy
  have hLx : (L : M) = x := by
    refine (IsHausdorff.eq_iff_smodEq (I := I)).mpr fun m ↦ ?_
    rw [SModEq.sub_mem]
    have hLm : (z m : M) - (L : M) ∈ (I ^ m • ⊤ : Submodule R M) :=
      (Submodule.smul_mono le_rfl le_top)
        ((Submodule.mem_smul_top_iff (I ^ m) P (z m - L)).mp (SModEq.sub_mem.mp (hL m)))
    have hzm : (z m : M) - x ∈ (I ^ m • ⊤ : Submodule R M) :=
      Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_add_right m k)) (hy (m + k))
    simpa [sub_sub_sub_cancel_left] using sub_mem hzm hLm
  exact hLx ▸ L.property

/-- The quotient of a module by an `I`-adically closed submodule is `I`-adically Hausdorff. -/
theorem isHausdorff_quotient_of_isClosed_adicModuleTopology (P : Submodule R M) (I : Ideal R)
    (hcl : @IsClosed M (I.adicModuleTopology M) (P : Set M)) :
    IsHausdorff I (M ⧸ P) := by
  let := I.adicTopology
  let := I.adicModuleTopology M
  refine ⟨fun q hq ↦ ?_⟩
  obtain ⟨x, rfl⟩ := P.mkQ_surjective q
  suffices hx : x ∈ (P : Set M) from (Submodule.Quotient.mk_eq_zero P).mpr hx
  rw [← hcl.closure_eq, mem_closure_iff_nhds]
  intro U hU
  have hmem : (x - ·) ⁻¹' U ∈ 𝓝 (0 : M) := by
    refine (continuous_const.sub continuous_id).continuousAt ?_
    simpa using hU
  obtain ⟨n, -, hnU⟩ := (I.hasBasis_nhds_zero_adicModule (M := M)).mem_iff.mp hmem
  have hmap : (I ^ n • ⊤ : Submodule R (M ⧸ P)) = (I ^ n • ⊤ : Submodule R M).map P.mkQ := by
    rw [Submodule.map_smul'', Submodule.map_top, P.range_mkQ]
  obtain ⟨u, hu, hux⟩ := Submodule.mem_map.mp (hmap ▸ SModEq.zero.mp (hq n))
  exact ⟨x - u, hnU hu, P.ker_mkQ ▸ LinearMap.mem_ker.mpr (by rw [map_sub, hux, sub_self])⟩

end Submodule

namespace LinearMap

/-- A linear map whose range has its `I`-adic topology as subspace topology is strict for adic
module topologies; the source need not satisfy any finiteness hypothesis. -/
theorem isStrictMap_adicModuleTopology_of_isEmbedding (f : M →ₗ[R] N) (I : Ideal R)
    (hi : @Topology.IsEmbedding (LinearMap.range f) N (I.adicModuleTopology (LinearMap.range f))
      (I.adicModuleTopology N) (LinearMap.range f).subtype) :
    @Topology.IsStrictMap M N (I.adicModuleTopology M) (I.adicModuleTopology N) f := by
  let := I.adicTopology
  let := I.adicModuleTopology M
  let := I.adicModuleTopology N
  let := I.adicModuleTopology (LinearMap.range f)
  have hq := f.rangeRestrict.isOpenQuotientMap_adicModuleTopology I f.surjective_rangeRestrict
  exact hi.isStrictMap_iff.mp hq.isQuotientMap.isStrictMap

/-- Every linear map into a finite module over a noetherian ring is strict for adic module
topologies. The source need not be finite: its quotient topology on the image is always adic,
and Artin–Rees identifies this with the subspace topology in the finite target. -/
theorem isStrictMap_adicModuleTopology [IsNoetherianRing R] [Module.Finite R N]
    (f : M →ₗ[R] N) (I : Ideal R) :
    @Topology.IsStrictMap M N (I.adicModuleTopology M) (I.adicModuleTopology N) f :=
  f.isStrictMap_adicModuleTopology_of_isEmbedding I
    ((LinearMap.range f).isEmbedding_subtype_adicModuleTopology I)

end LinearMap
