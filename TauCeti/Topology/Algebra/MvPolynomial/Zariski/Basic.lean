/-!
# The polynomial Zariski topology on coordinate spaces

For a commutative semiring `R` and an index type `σ`, the **polynomial Zariski topology**
`TauCeti.polynomialTopology σ R` on the coordinate space `σ → R` is generated by the polynomial
nonvanishing loci `{x | MvPolynomial.eval x p ≠ 0}` for `p : MvPolynomial σ R`. It is defined as
an explicit `TopologicalSpace` value rather than a global instance so that it never collides with
product or analytic topologies on spaces such as `Fin n → ℂ`.

When `R` is nontrivial with no zero divisors, these basic nonvanishing loci form a topological
basis, the closed sets are exactly the common zero loci of sets of polynomials (agreeing with
`MvPolynomial.zariskiClosure` over a field), and the topology is induced from the Zariski topology
on `PrimeSpectrum (MvPolynomial σ R)` along evaluation kernels. Polynomial maps between coordinate
spaces — and in particular coordinate reindexings and linear maps from finite-dimensional coordinate
spaces — are continuous, so invertible coordinate reindexings are homeomorphisms. Over a Noetherian
commutative ring `R`, Hilbert's basis theorem therefore makes it Noetherian whenever `σ` is finite.

Over an infinite integral domain `R`, `MvPolynomial.funext` shows that two nonempty basic opens
always meet, making `σ → R` an irreducible space for every `σ` (including empty `σ`, where the
space is a single point). In at most one variable over a ring without zero divisors, the
polynomial Zariski topology coincides with `TopologicalSpace.cofinite`, so no nonempty set with
infinite complement is open.

## Main definitions

* `TauCeti.polynomialTopology`: the polynomial Zariski topology on `σ → R`.
* `TauCeti.evalPrimeSpectrum`: the map sending `x : σ → R` to the kernel of `MvPolynomial.eval x`
  in `PrimeSpectrum (MvPolynomial σ R)`.

## Main results

* `TauCeti.isTopologicalBasis_polynomialTopology`, `TauCeti.isOpen_polynomialTopology_iff`, and
  `TauCeti.isClosed_polynomialTopology_iff`: basic opens form a basis and closed sets are common
  zero loci over a nontrivial semiring without zero divisors.
* `MvPolynomial.zariskiClosure_eq_closureOperator`: over a field `K`,
  `MvPolynomial.zariskiClosure K` coincides with the topological closure operator of
  `TauCeti.polynomialTopology σ K`.
* `TauCeti.continuous_polynomialTopology_of_polynomial`,
  `Equiv.isHomeomorph_polynomialTopology_comp`, and
  `LinearMap.continuous_polynomialTopology`: continuity of polynomial and linear maps and
  invariance under coordinate reindexings.
* `TauCeti.polynomialTopology_eq_induced_evalPrimeSpectrum` and
  `TauCeti.noetherianSpace_polynomialTopology`: comparison with `PrimeSpectrum` and Noetherianity
  for finite `σ` over a Noetherian commutative ring.
* `TauCeti.irreducibleSpace_polynomialTopology`: irreducibility of `σ → R` over an infinite
  integral domain.
* `TauCeti.polynomialTopology_eq_cofinite`: in at most one variable over a commutative ring without
  zero divisors, the polynomial Zariski topology is the cofinite topology.

## References

* H. Atobe, S. Kondo, S. Yasuda, *Local newforms for the general linear groups over a
  non-archimedean local field*, Forum Math. Pi **10** (2022), e24, Section 3.1.
* C. Mœglin, J.-L. Waldspurger, *Sur l'involution de Zelevinski*, J. Reine Angew. Math. **372**
  (1986), Remark II.6.1.
-/

public section

open Set Topology

section CommSemiring

variable {σ τ R : Type*} [CommSemiring R]

namespace TauCeti

/-- The polynomial Zariski topology on the coordinate space `σ → R`, generated by the nonvanishing
loci `{x | MvPolynomial.eval x p ≠ 0}` of multivariate polynomials. -/
@[instance_reducible]
def polynomialTopology (σ R : Type*) [CommSemiring R] : TopologicalSpace (σ → R) :=
  TopologicalSpace.generateFrom
    {U | ∃ p : MvPolynomial σ R, U = {x | MvPolynomial.eval x p ≠ 0}}

/-- The defining subbasis presentation of `TauCeti.polynomialTopology`. -/
theorem polynomialTopology_eq_generateFrom (σ R : Type*) [CommSemiring R] :
    polynomialTopology σ R =
      TopologicalSpace.generateFrom
        {U | ∃ p : MvPolynomial σ R, U = {x | MvPolynomial.eval x p ≠ 0}} :=
  (rfl)

end TauCeti

namespace MvPolynomial

open TauCeti

/-- Every polynomial nonvanishing locus is open in the polynomial Zariski topology. -/
theorem isOpen_polynomialTopology_eval_ne_zero (p : MvPolynomial σ R) :
    IsOpen[polynomialTopology σ R] {x : σ → R | MvPolynomial.eval x p ≠ 0} :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨p, rfl⟩

/-- Every polynomial zero locus is closed in the polynomial Zariski topology. -/
theorem isClosed_polynomialTopology_eval_eq_zero (p : MvPolynomial σ R) :
    IsClosed[polynomialTopology σ R] {x : σ → R | MvPolynomial.eval x p = 0} := by
  let := polynomialTopology σ R
  rw [← isOpen_compl_iff]
  simpa only [compl_ofPred] using p.isOpen_polynomialTopology_eval_ne_zero

end MvPolynomial

namespace Set

open TauCeti

/-- The common zero locus of any set of polynomials is closed in the polynomial Zariski
topology. -/
theorem isClosed_polynomialTopology_setOf_forall_eval_eq_zero (S : Set (MvPolynomial σ R)) :
    IsClosed[polynomialTopology σ R] {x : σ → R | ∀ p ∈ S, MvPolynomial.eval x p = 0} := by
  let := polynomialTopology σ R
  have hEq : {x : σ → R | ∀ p ∈ S, MvPolynomial.eval x p = 0} =
      ⋂ p ∈ S, {x : σ → R | MvPolynomial.eval x p = 0} := by
    ext x
    simp
  rw [hEq]
  exact isClosed_biInter fun p _ ↦ p.isClosed_polynomialTopology_eval_eq_zero

end Set

namespace TauCeti

/-- A map whose coordinates are given by multivariate polynomials is continuous for the polynomial
Zariski topologies. -/
theorem continuous_polynomialTopology_of_polynomial (f : (σ → R) → (τ → R))
    (hf : ∀ j : τ, ∃ q : MvPolynomial σ R, ∀ x : σ → R, f x j = MvPolynomial.eval x q) :
    @Continuous _ _ (polynomialTopology σ R) (polynomialTopology τ R) f := by
  let := polynomialTopology σ R
  let := polynomialTopology τ R
  rw [polynomialTopology_eq_generateFrom τ R, continuous_generateFrom_iff]
  rintro U ⟨p, rfl⟩
  choose q hq using hf
  have hpre : f ⁻¹' {y : τ → R | MvPolynomial.eval y p ≠ 0} =
      {x : σ → R | MvPolynomial.eval x (MvPolynomial.bind₁ q p) ≠ 0} := by
    ext x
    have hfx : f x = fun j ↦ MvPolynomial.eval x (q j) := funext fun j ↦ hq j x
    simp only [mem_preimage, mem_ofPred_eq, hfx]
    have heval : MvPolynomial.eval x (MvPolynomial.bind₁ q p) =
        MvPolynomial.eval (fun j ↦ MvPolynomial.eval x (q j)) p :=
      MvPolynomial.eval₂Hom_bind₁ (RingHom.id R) x q p
    rw [heval]
  rw [hpre]
  exact (MvPolynomial.bind₁ q p).isOpen_polynomialTopology_eval_ne_zero

/-- Precomposition with a map of index types is continuous for the polynomial Zariski
topologies. -/
theorem continuous_polynomialTopology_comp (e : τ → σ) :
    @Continuous _ _ (polynomialTopology σ R) (polynomialTopology τ R) (fun x ↦ x ∘ e) :=
  continuous_polynomialTopology_of_polynomial (fun x ↦ x ∘ e) fun j ↦
    ⟨MvPolynomial.X (e j), fun x ↦ by simp⟩

end TauCeti

namespace Equiv

open TauCeti

/-- Reindexing coordinates by an equivalence is a homeomorphism for the polynomial Zariski
topologies. -/
theorem isHomeomorph_polynomialTopology_comp (e : τ ≃ σ) :
    @IsHomeomorph _ _ (polynomialTopology σ R) (polynomialTopology τ R) (fun x ↦ x ∘ e) := by
  let := polynomialTopology σ R
  let := polynomialTopology τ R
  exact Homeomorph.isHomeomorph
    ⟨Equiv.arrowCongr e.symm (Equiv.refl R), continuous_polynomialTopology_comp (R := R) e,
      continuous_polynomialTopology_comp (R := R) e.symm⟩

/-- Reindexing coordinates by an equivalence preserves the polynomial Zariski topology. -/
@[simp]
theorem induced_polynomialTopology_comp (e : τ ≃ σ) :
    TopologicalSpace.induced (fun x : σ → R ↦ x ∘ e) (polynomialTopology τ R) =
      polynomialTopology σ R := by
  let := polynomialTopology σ R
  let := polynomialTopology τ R
  exact
    ((e.isHomeomorph_polynomialTopology_comp (R := R)).homeomorph.isInducing.eq_induced).symm

end Equiv

namespace LinearMap

open TauCeti

/-- An affine-linear map `x ↦ f x + c` out of a finite coordinate space is continuous for the
polynomial Zariski topologies. -/
theorem continuous_polynomialTopology_add_const [Finite σ]
    (f : (σ → R) →ₗ[R] (τ → R)) (c : τ → R) :
    @Continuous _ _ (polynomialTopology σ R) (polynomialTopology τ R) (fun x ↦ f x + c) := by
  classical
  have := Fintype.ofFinite σ
  refine continuous_polynomialTopology_of_polynomial (fun x ↦ f x + c) fun j ↦ ?_
  refine ⟨∑ i : σ, MvPolynomial.C (f (fun k ↦ if i = k then 1 else 0) j) * MvPolynomial.X i +
    MvPolynomial.C (c j), fun x ↦ ?_⟩
  rw [Pi.add_apply, f.pi_apply_eq_sum_univ x]
  simp [Finset.sum_apply, mul_comm]

/-- Every linear map out of a finite coordinate space is continuous for the polynomial Zariski
topologies. -/
theorem continuous_polynomialTopology [Finite σ] (f : (σ → R) →ₗ[R] (τ → R)) :
    @Continuous _ _ (polynomialTopology σ R) (polynomialTopology τ R) f := by
  simpa only [add_zero] using f.continuous_polynomialTopology_add_const 0

end LinearMap

end CommSemiring

section PrimeSpectrum

variable {σ R : Type*} [CommSemiring R] [Nontrivial R] [NoZeroDivisors R]

namespace TauCeti

/-- Send a coordinate point `x : σ → R` to the prime ideal `ker (MvPolynomial.eval x)` in
`PrimeSpectrum (MvPolynomial σ R)`. -/
noncomputable def evalPrimeSpectrum (x : σ → R) : PrimeSpectrum (MvPolynomial σ R) :=
  ⟨RingHom.ker (MvPolynomial.eval x), RingHom.ker_isPrime _⟩

/-- Membership in the prime ideal `evalPrimeSpectrum x` is vanishing at `x`. -/
@[simp]
theorem mem_evalPrimeSpectrum_asIdeal (x : σ → R) (p : MvPolynomial σ R) :
    p ∈ (evalPrimeSpectrum x).asIdeal ↔ MvPolynomial.eval x p = 0 :=
  Iff.rfl

/-- Pulling back a `PrimeSpectrum.basicOpen` along `TauCeti.evalPrimeSpectrum` recovers the
polynomial nonvanishing locus. -/
theorem preimage_evalPrimeSpectrum_basicOpen (p : MvPolynomial σ R) :
    evalPrimeSpectrum ⁻¹' (PrimeSpectrum.basicOpen p : Set (PrimeSpectrum (MvPolynomial σ R))) =
      {x : σ → R | MvPolynomial.eval x p ≠ 0} := by
  ext x
  simp

private theorem image_preimage_evalPrimeSpectrum_basicOpen :
    (evalPrimeSpectrum (σ := σ) (R := R) ⁻¹' ·) ''
        Set.range (fun p : MvPolynomial σ R ↦ (PrimeSpectrum.basicOpen p : Set _)) =
      {U | ∃ p : MvPolynomial σ R, U = {x | MvPolynomial.eval x p ≠ 0}} := by
  ext U
  simp only [mem_image, mem_range, exists_exists_eq_and, preimage_evalPrimeSpectrum_basicOpen,
    mem_ofPred_eq]
  simp only [eq_comm]

/-- Over a nontrivial commutative semiring without zero divisors, the polynomial Zariski topology
is induced from the Zariski topology on `PrimeSpectrum (MvPolynomial σ R)` along evaluation
kernels. -/
theorem polynomialTopology_eq_induced_evalPrimeSpectrum :
    polynomialTopology σ R =
      TopologicalSpace.induced (evalPrimeSpectrum (σ := σ) (R := R))
        PrimeSpectrum.zariskiTopology := by
  rw [PrimeSpectrum.isTopologicalBasis_basic_opens.eq_generateFrom, induced_generateFrom_eq,
    image_preimage_evalPrimeSpectrum_basicOpen, polynomialTopology_eq_generateFrom]

end TauCeti

end PrimeSpectrum

section Basis

variable {σ R : Type*} [CommSemiring R] [Nontrivial R] [NoZeroDivisors R]

namespace TauCeti

/-- Over a nontrivial commutative semiring without zero divisors, the polynomial nonvanishing loci
form a topological basis of the polynomial Zariski topology. -/
theorem isTopologicalBasis_polynomialTopology :
    @TopologicalSpace.IsTopologicalBasis (σ → R) (polynomialTopology σ R)
      {U | ∃ p : MvPolynomial σ R, U = {x | MvPolynomial.eval x p ≠ 0}} := by
  rw [← image_preimage_evalPrimeSpectrum_basicOpen,
    polynomialTopology_eq_induced_evalPrimeSpectrum]
  exact (PrimeSpectrum.isTopologicalBasis_basic_opens (R := MvPolynomial σ R)).induced
    (evalPrimeSpectrum (σ := σ) (R := R))

/-- A set is open in the polynomial Zariski topology exactly when each of its points lies in a
polynomial nonvanishing locus contained in the set. -/
theorem isOpen_polynomialTopology_iff {U : Set (σ → R)} :
    IsOpen[polynomialTopology σ R] U ↔
      ∀ x ∈ U, ∃ p : MvPolynomial σ R,
        MvPolynomial.eval x p ≠ 0 ∧ {y : σ → R | MvPolynomial.eval y p ≠ 0} ⊆ U := by
  let := polynomialTopology σ R
  rw [isTopologicalBasis_polynomialTopology.isOpen_iff]
  constructor
  · intro h x hx
    obtain ⟨V, ⟨p, rfl⟩, hxp, hVU⟩ := h x hx
    exact ⟨p, hxp, hVU⟩
  · intro h x hx
    obtain ⟨p, hxp, hpU⟩ := h x hx
    exact ⟨{y | MvPolynomial.eval y p ≠ 0}, ⟨p, rfl⟩, hxp, hpU⟩

/-- A set is closed in the polynomial Zariski topology exactly when it is the common zero locus of
a set of multivariate polynomials. -/
theorem isClosed_polynomialTopology_iff {F : Set (σ → R)} :
    IsClosed[polynomialTopology σ R] F ↔
      ∃ S : Set (MvPolynomial σ R), F = {x : σ → R | ∀ p ∈ S, MvPolynomial.eval x p = 0} := by
  rw [polynomialTopology_eq_induced_evalPrimeSpectrum, isClosed_induced_iff]
  simp_rw [PrimeSpectrum.isClosed_iff_zeroLocus]
  constructor
  · rintro ⟨_, ⟨S, rfl⟩, rfl⟩
    exact ⟨S, by ext x; simp [Set.subset_def]⟩
  · rintro ⟨S, rfl⟩
    exact ⟨_, ⟨S, rfl⟩, by ext x; simp [Set.subset_def]⟩

end TauCeti

end Basis

section ZariskiClosure

namespace MvPolynomial

open TauCeti

/-- Over a field `K`, the Zariski closure operator `MvPolynomial.zariskiClosure K` coincides with
the topological closure operator of `TauCeti.polynomialTopology σ K`. -/
theorem zariskiClosure_eq_closureOperator {σ K : Type*} [Field K] :
    zariskiClosure K = @Topology.closureOperator (σ → K) (polynomialTopology σ K) := by
  let := polynomialTopology σ K
  refine ClosureOperator.ext_isClosed _ _ fun S ↦ ?_
  rw [Topology.isClosed_closureOperator, isClosed_polynomialTopology_iff,
    zariskiClosure_isClosed_iff]
  constructor
  · rintro ⟨I, rfl⟩
    refine ⟨(I : Set (MvPolynomial σ K)), ?_⟩
    rw [← Ideal.span_eq I, zeroLocus_span]
    simp [aeval_def]
  · rintro ⟨T, rfl⟩
    refine ⟨Ideal.span T, ?_⟩
    rw [zeroLocus_span]
    simp [aeval_def]

end MvPolynomial

end ZariskiClosure

section CommRing

variable {σ R : Type*} [CommRing R]

namespace TauCeti

/-- Points are closed in the polynomial Zariski topology over any commutative ring. -/
theorem t1Space_polynomialTopology : @T1Space (σ → R) (polynomialTopology σ R) := by
  let := polynomialTopology σ R
  refine ⟨fun a ↦ ?_⟩
  have hsing : ({a} : Set (σ → R)) =
      ⋂ i : σ, {x : σ → R | MvPolynomial.eval x (MvPolynomial.X i - MvPolynomial.C (a i)) = 0} := by
    ext x
    simp [sub_eq_zero, funext_iff]
  rw [hsing]
  exact isClosed_iInter fun i ↦
    (MvPolynomial.X i - MvPolynomial.C (a i)).isClosed_polynomialTopology_eval_eq_zero

/-- Over a Noetherian commutative ring, the polynomial Zariski topology on a finite coordinate
space is Noetherian. -/
theorem noetherianSpace_polynomialTopology [Finite σ] [IsNoetherianRing R] :
    @TopologicalSpace.NoetherianSpace (σ → R) (polynomialTopology σ R) := by
  let := polynomialTopology σ R
  rw [TopologicalSpace.noetherianSpace_iff_isCompact]
  intro s
  refine isCompact_generateFrom (polynomialTopology_eq_generateFrom σ R) fun P hP hs ↦ ?_
  let T : Set (MvPolynomial σ R) := {p | {x : σ → R | MvPolynomial.eval x p ≠ 0} ∈ P}
  obtain ⟨T₀, hT₀T, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset T).mp
    (IsNoetherian.noetherian (Ideal.span T))
  refine ⟨(fun p : MvPolynomial σ R ↦ {x : σ → R | MvPolynomial.eval x p ≠ 0}) '' (T₀ : Set _),
    ?_, (T₀.finite_toSet.image _), ?_⟩
  · rintro _ ⟨p, hp, rfl⟩
    exact hT₀T hp
  · intro x hx
    obtain ⟨U, hUP, hxU⟩ := mem_sUnion.mp (hs hx)
    obtain ⟨p, rfl⟩ := hP hUP
    have hpT : p ∈ Ideal.span (T₀ : Set (MvPolynomial σ R)) := by
      rw [← show Ideal.span T = Ideal.span (T₀ : Set (MvPolynomial σ R)) from hspan]
      exact Ideal.subset_span hUP
    by_contra hxQ
    have hker : (T₀ : Set (MvPolynomial σ R)) ⊆ RingHom.ker (MvPolynomial.eval x) := by
      intro q hq
      by_contra hqx
      exact hxQ (mem_sUnion.mpr ⟨{y | MvPolynomial.eval y q ≠ 0}, ⟨q, hq, rfl⟩, hqx⟩)
    have hp0 : p ∈ RingHom.ker (MvPolynomial.eval x) := Ideal.span_le.mpr hker hpT
    exact hxU hp0

end TauCeti

end CommRing

section Domain

variable {σ R : Type*} [CommRing R] [IsDomain R]

section Infinite

variable [Infinite R]

namespace TauCeti

/-- Over an infinite integral domain, the polynomial Zariski topology on any coordinate space is
irreducible. -/
theorem irreducibleSpace_polynomialTopology :
    @IrreducibleSpace (σ → R) (polynomialTopology σ R) := by
  let := polynomialTopology σ R
  have : PreirreducibleSpace (σ → R) := ⟨fun U V hU hV ⟨x, _, hxU⟩ ⟨y, _, hyV⟩ ↦ by
    obtain ⟨p, hxp, hpU⟩ := isOpen_polynomialTopology_iff.mp hU x hxU
    obtain ⟨q, hyq, hqV⟩ := isOpen_polynomialTopology_iff.mp hV y hyV
    have hp : p ≠ 0 := by
      rintro rfl
      simp at hxp
    have hq : q ≠ 0 := by
      rintro rfl
      simp at hyq
    obtain ⟨z, hz⟩ := MvPolynomial.exists_eval_ne_zero (mul_ne_zero hp hq)
    rw [map_mul, mul_ne_zero_iff] at hz
    exact ⟨z, mem_univ z, hpU hz.1, hqV hz.2⟩⟩
  exact ⟨⟨0⟩⟩

end TauCeti

namespace MvPolynomial

open TauCeti

/-- Over an infinite integral domain, a polynomial nonvanishing locus is dense in the polynomial
Zariski topology exactly when the polynomial is nonzero. -/
theorem dense_polynomialTopology_eval_ne_zero_iff (p : MvPolynomial σ R) :
    @Dense (σ → R) (polynomialTopology σ R) {x : σ → R | MvPolynomial.eval x p ≠ 0} ↔ p ≠ 0 := by
  let := polynomialTopology σ R
  have := irreducibleSpace_polynomialTopology (σ := σ) (R := R)
  refine ⟨fun hd ↦ ?_, fun hp ↦ (p.isOpen_polynomialTopology_eval_ne_zero).dense
    (exists_eval_ne_zero hp)⟩
  obtain ⟨x, hx⟩ := hd.nonempty
  rintro rfl
  simp at hx

end MvPolynomial

end Infinite

end Domain

section OneVariable

variable {σ R : Type*} [CommRing R] [Subsingleton σ] [NoZeroDivisors R]

namespace TauCeti

/-- In at most one variable over a commutative ring without zero divisors, the polynomial Zariski
topology coincides with the cofinite topology. -/
theorem polynomialTopology_eq_cofinite :
    polynomialTopology σ R = TopologicalSpace.cofinite := by
  rcases isEmpty_or_nonempty σ with hσ | ⟨⟨s₀⟩⟩
  · exact Subsingleton.elim _ _
  let : Unique σ := ⟨⟨s₀⟩, fun s ↦ Subsingleton.elim s s₀⟩
  rcases subsingleton_or_nontrivial R with hR | hR
  · exact Subsingleton.elim _ _
  have : IsDomain R := NoZeroDivisors.to_isDomain R
  have hinj : Function.Injective (fun x : σ → R ↦ x default) := fun x y h ↦
    funext fun i ↦ by rw [Unique.eq_default i]; exact h
  apply le_antisymm
  · intro U hU
    let := polynomialTopology σ R
    have := t1Space_polynomialTopology (σ := σ) (R := R)
    by_cases hne : U.Nonempty
    · rw [← isClosed_compl_iff]
      exact (hU hne).isClosed
    · rw [Set.not_nonempty_iff_eq_empty.mp hne]
      exact isOpen_empty
  · rw [← hinj.induced_cofinite, polynomialTopology_eq_generateFrom,
      TopologicalSpace.le_generateFrom_iff_subset_isOpen]
    rintro _ ⟨p, rfl⟩
    by_cases hp : p = 0
    · subst hp
      simp
    have hq : MvPolynomial.uniqueAlgEquiv R σ p ≠ 0 :=
      fun h ↦ hp ((MvPolynomial.uniqueAlgEquiv R σ).injective (by simpa using h))
    have hpre : {x : σ → R | MvPolynomial.eval x p ≠ 0} =
        (fun x : σ → R ↦ x default) ⁻¹'
          {r : R | ¬(MvPolynomial.uniqueAlgEquiv R σ p).IsRoot r} := by
      ext x
      have heval : Polynomial.eval (x default) (MvPolynomial.uniqueAlgEquiv R σ p) =
          MvPolynomial.eval x p :=
        MvPolynomial.eval₂_uniqueAlgEquiv (φ := RingHom.id R) (a := x)
      simp only [mem_ofPred_eq, mem_preimage, Polynomial.IsRoot, heval]
    rw [hpre]
    refine ⟨{r : R | ¬(MvPolynomial.uniqueAlgEquiv R σ p).IsRoot r}, fun _ ↦ ?_, rfl⟩
    simpa only [compl_ofPred, not_not] using Polynomial.finite_setOfPred_isRoot hq

end TauCeti

end OneVariable
