/-!
# The polynomial Zariski topology on modules

For a commutative semiring `R` and an `R`-module `M`, the intrinsic **polynomial Zariski topology**
`TauCeti.modulePolynomialTopology R M` is generated by the polynomial nonvanishing loci
`{x : M | MvPolynomial.eval (fun i ↦ φ i x) p ≠ 0}` as `φ : Fin n → Module.Dual R M` and
`p : MvPolynomial (Fin n) R` vary. Like `TauCeti.polynomialTopology`, it is an explicit
`TopologicalSpace` value rather than a global instance so it never collides with norm or product
topologies on real or complex vector spaces.

This coordinate-free definition makes every linear map and every affine map continuous with no
finiteness hypothesis, and makes every linear or affine equivalence a homeomorphism. On a finite
coordinate space `σ → R`, it coincides with `TauCeti.polynomialTopology σ R`; consequently, for
every finite basis `b : Module.Basis ι R M`, it agrees with the topology transported from
`TauCeti.polynomialTopology ι R` along `b.equivFun`, proving independence of the choice of basis.
Over a commutative ring without zero divisors, `modulePolynomialTopology R R` is the cofinite
topology; over a Noetherian commutative ring, every finitely generated module is a Noetherian space.

Over an infinite integral domain `R`, restricting to the affine line `t ↦ (1 - t) • x + t • y`
shows that every `R`-module `M` is an irreducible space (without any finiteness or basis
hypothesis). Continuous maps with dense range — and in particular surjective linear and affine
maps — therefore pull back nonempty open sets to dense sets, and every nonempty affine subspace
`A : AffineSubspace R M` is irreducible, so any open set meeting `A` cuts out an open dense subset
of `A`. Over a field `k`, every injective linear map — in particular every submodule inclusion — is
a topological embedding for `modulePolynomialTopology`, and every nonempty affine subspace is
homeomorphic to its direction.

## Main definitions

* `TauCeti.modulePolynomialTopology`: the intrinsic polynomial Zariski topology on an `R`-module.

## Main results

* `TauCeti.isOpen_modulePolynomialTopology_eval_ne_zero` and
  `TauCeti.isTopologicalBasis_modulePolynomialTopology`: polynomial nonvanishing loci for arbitrary
  families of dual functionals are open, and form a topological basis over a nontrivial semiring
  without zero divisors.
* `LinearMap.continuous_modulePolynomialTopology`,
  `AffineMap.continuous_modulePolynomialTopology`,
  `TauCeti.continuous_modulePolynomialTopology_line`,
  `LinearEquiv.isHomeomorph_modulePolynomialTopology`, and
  `AffineEquiv.isHomeomorph_modulePolynomialTopology`: functoriality under linear maps,
  affine maps, affine lines, and linear/affine equivalences.
* `TauCeti.modulePolynomialTopology_pi`, `Module.Basis.modulePolynomialTopology_eq_induced`, and
  `Module.Basis.induced_polynomialTopology_eq_induced`: agreement with coordinate-space
  polynomial Zariski topology and independence of basis.
* `TauCeti.modulePolynomialTopology_self_eq_cofinite` and
  `TauCeti.noetherianSpace_modulePolynomialTopology`: cofinite characterization in rank one and
  Noetherianity for finitely generated modules over Noetherian commutative rings.
* `TauCeti.irreducibleSpace_modulePolynomialTopology`,
  `TauCeti.dense_preimage_modulePolynomialTopology_of_denseRange`,
  `TauCeti.dense_preimage_modulePolynomialTopology_of_surjective_linearMap`,
  `AffineSubspace.isIrreducible_modulePolynomialTopology`, and
  `AffineSubspace.dense_preimage_val_modulePolynomialTopology`: irreducibility of modules
  and affine subspaces over infinite integral domains and pullback/intersection density.
* `Submodule.induced_modulePolynomialTopology` and
  `AffineSubspace.isHomeomorph_modulePolynomialTopology_direction`: subspace topologies on
  submodules and affine subspaces over a field.

## References

* H. Atobe, S. Kondo, S. Yasuda, *Local newforms for the general linear groups over a
  non-archimedean local field*, Forum Math. Pi **10** (2022), e24, Section 3.1.
* C. Mœglin, J.-L. Waldspurger, *Sur l'involution de Zelevinski*, J. Reine Angew. Math. **372**
  (1986), Remark II.6.1.
-/

public section

open Set Topology

section CommSemiring

variable {R M N : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]
  [AddCommMonoid N] [Module R N]

namespace TauCeti

/-- The intrinsic polynomial Zariski topology on an `R`-module `M`, generated by the nonvanishing
loci `{x | MvPolynomial.eval (fun i ↦ φ i x) p ≠ 0}` of multivariate polynomials evaluated on
finitely many linear functionals. -/
@[instance_reducible]
def modulePolynomialTopology (R M : Type*) [CommSemiring R] [AddCommMonoid M] [Module R M] :
    TopologicalSpace M :=
  TopologicalSpace.generateFrom
    {U | ∃ (n : ℕ) (φ : Fin n → Module.Dual R M) (p : MvPolynomial (Fin n) R),
      U = {x : M | MvPolynomial.eval (fun i ↦ φ i x) p ≠ 0}}

/-- The defining subbasis presentation of `TauCeti.modulePolynomialTopology`. -/
theorem modulePolynomialTopology_eq_generateFrom (R M : Type*) [CommSemiring R] [AddCommMonoid M]
    [Module R M] :
    modulePolynomialTopology R M =
      TopologicalSpace.generateFrom
        {U | ∃ (n : ℕ) (φ : Fin n → Module.Dual R M) (p : MvPolynomial (Fin n) R),
          U = {x : M | MvPolynomial.eval (fun i ↦ φ i x) p ≠ 0}} :=
  (rfl)

/-- Every polynomial nonvanishing locus in an arbitrary family of linear functionals is open in the
polynomial Zariski topology on `M`. -/
theorem isOpen_modulePolynomialTopology_eval_ne_zero {ι : Type*}
    (φ : ι → Module.Dual R M) (p : MvPolynomial ι R) :
    IsOpen[modulePolynomialTopology R M] {x : M | MvPolynomial.eval (fun i ↦ φ i x) p ≠ 0} := by
  obtain ⟨n, f, _, q, rfl⟩ := p.exists_fin_rename
  simp only [MvPolynomial.eval_rename, Function.comp_def]
  exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨n, φ ∘ f, q, rfl⟩

/-- Every polynomial zero locus in an arbitrary family of linear functionals is closed in the
polynomial Zariski topology on `M`. -/
theorem isClosed_modulePolynomialTopology_eval_eq_zero {ι : Type*}
    (φ : ι → Module.Dual R M) (p : MvPolynomial ι R) :
    IsClosed[modulePolynomialTopology R M] {x : M | MvPolynomial.eval (fun i ↦ φ i x) p = 0} := by
  let := modulePolynomialTopology R M
  rw [← isOpen_compl_iff]
  simpa only [compl_ofPred] using isOpen_modulePolynomialTopology_eval_ne_zero φ p

end TauCeti

namespace LinearMap

open TauCeti

/-- Every affine-linear map `x ↦ f x + c` between `R`-modules is continuous for the polynomial
Zariski topologies. -/
theorem continuous_modulePolynomialTopology_add_const (f : M →ₗ[R] N) (c : N) :
    @Continuous _ _ (modulePolynomialTopology R M) (modulePolynomialTopology R N)
      (fun x ↦ f x + c) := by
  let := modulePolynomialTopology R M
  let := modulePolynomialTopology R N
  rw [modulePolynomialTopology_eq_generateFrom R N, continuous_generateFrom_iff]
  rintro U ⟨n, φ, p, rfl⟩
  let q : Fin n → MvPolynomial (Fin n) R := fun i ↦ MvPolynomial.X i + MvPolynomial.C (φ i c)
  have hpre : (fun x ↦ f x + c) ⁻¹' {y : N | MvPolynomial.eval (fun i ↦ φ i y) p ≠ 0} =
      {x : M | MvPolynomial.eval (fun i ↦ (φ i ∘ₗ f) x) (MvPolynomial.bind₁ q p) ≠ 0} := by
    ext x
    simp only [mem_preimage, mem_ofPred_eq, map_add]
    have hbind : MvPolynomial.eval (fun i ↦ (φ i ∘ₗ f) x) (MvPolynomial.bind₁ q p) =
        MvPolynomial.eval
          (fun i ↦ MvPolynomial.eval (fun j ↦ (φ j ∘ₗ f) x) (q i)) p :=
      MvPolynomial.eval₂Hom_bind₁ (RingHom.id R) (fun i ↦ (φ i ∘ₗ f) x) q p
    have heval : MvPolynomial.eval (fun i ↦ (φ i ∘ₗ f) x) (MvPolynomial.bind₁ q p) =
        MvPolynomial.eval (fun i ↦ φ i (f x) + φ i c) p := by
      have hfun : (fun i ↦ MvPolynomial.eval (fun j ↦ (φ j ∘ₗ f) x) (q i)) =
          fun i ↦ φ i (f x) + φ i c := funext fun i ↦ by simp [q]
      rw [hbind, hfun]
    rw [heval]
  rw [hpre]
  exact isOpen_modulePolynomialTopology_eval_ne_zero (fun i ↦ φ i ∘ₗ f) (MvPolynomial.bind₁ q p)

/-- Every linear map between `R`-modules is continuous for the polynomial Zariski topologies. -/
theorem continuous_modulePolynomialTopology (f : M →ₗ[R] N) :
    @Continuous _ _ (modulePolynomialTopology R M) (modulePolynomialTopology R N) f := by
  simpa only [add_zero] using f.continuous_modulePolynomialTopology_add_const 0

end LinearMap

namespace TauCeti

/-- A linear map admitting a linear left inverse is a topological embedding for the polynomial
Zariski topologies. -/
theorem isEmbedding_modulePolynomialTopology_of_leftInverse {f : M →ₗ[R] N} {g : N →ₗ[R] M}
    (hfg : g.comp f = LinearMap.id) :
    @IsEmbedding _ _ (modulePolynomialTopology R M) (modulePolynomialTopology R N) f := by
  let := modulePolynomialTopology R M
  let := modulePolynomialTopology R N
  exact Function.LeftInverse.isEmbedding (LinearMap.congr_fun hfg)
    g.continuous_modulePolynomialTopology f.continuous_modulePolynomialTopology

/-- A linear map admitting a linear left inverse induces the polynomial Zariski topology on its
domain. -/
theorem induced_modulePolynomialTopology_of_leftInverse {f : M →ₗ[R] N} {g : N →ₗ[R] M}
    (hfg : g.comp f = LinearMap.id) :
    TopologicalSpace.induced f (modulePolynomialTopology R N) = modulePolynomialTopology R M := by
  let := modulePolynomialTopology R M
  let := modulePolynomialTopology R N
  exact (isEmbedding_modulePolynomialTopology_of_leftInverse hfg).isInducing.eq_induced.symm

end TauCeti

namespace LinearEquiv

open TauCeti

/-- Every linear equivalence between `R`-modules is a homeomorphism for the polynomial Zariski
topologies. -/
theorem isHomeomorph_modulePolynomialTopology (e : M ≃ₗ[R] N) :
    @IsHomeomorph _ _ (modulePolynomialTopology R M) (modulePolynomialTopology R N) e := by
  let := modulePolynomialTopology R M
  let := modulePolynomialTopology R N
  exact Homeomorph.isHomeomorph
    ⟨e.toEquiv, e.toLinearMap.continuous_modulePolynomialTopology,
      e.symm.toLinearMap.continuous_modulePolynomialTopology⟩

/-- A linear equivalence transports the polynomial Zariski topology to itself. -/
@[simp]
theorem induced_modulePolynomialTopology (e : M ≃ₗ[R] N) :
    TopologicalSpace.induced e (modulePolynomialTopology R N) = modulePolynomialTopology R M :=
  induced_modulePolynomialTopology_of_leftInverse (f := e.toLinearMap) (g := e.symm.toLinearMap)
    (by ext x; simp)

end LinearEquiv

namespace TauCeti

/-- On any coordinate space `σ → R`, the intrinsic module polynomial Zariski topology is at least as
fine as the coordinate polynomial Zariski topology. -/
theorem modulePolynomialTopology_pi_le (σ : Type*) :
    modulePolynomialTopology R (σ → R) ≤ polynomialTopology σ R := by
  rw [polynomialTopology_eq_generateFrom, TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  rintro _ ⟨p, rfl⟩
  exact isOpen_modulePolynomialTopology_eval_ne_zero (fun i : σ ↦ LinearMap.proj i) p

/-- On a finite coordinate space `σ → R`, the intrinsic module polynomial Zariski topology coincides
with `TauCeti.polynomialTopology σ R`. -/
@[simp]
theorem modulePolynomialTopology_pi (σ : Type*) [Finite σ] :
    modulePolynomialTopology R (σ → R) = polynomialTopology σ R := by
  apply le_antisymm (modulePolynomialTopology_pi_le σ)
  rw [modulePolynomialTopology_eq_generateFrom, TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  rintro _ ⟨n, φ, p, rfl⟩
  let := polynomialTopology σ R
  let := polynomialTopology (Fin n) R
  let ψ : (σ → R) →ₗ[R] (Fin n → R) := LinearMap.pi φ
  have hcont : Continuous ψ := ψ.continuous_polynomialTopology
  exact hcont.isOpen_preimage _ p.isOpen_polynomialTopology_eval_ne_zero

end TauCeti

namespace Module.Basis

open TauCeti

/-- For any finite basis of `M`, the intrinsic polynomial Zariski topology coincides with the
topology induced from `TauCeti.polynomialTopology` along `b.equivFun`. -/
theorem modulePolynomialTopology_eq_induced {ι : Type*} [Finite ι] (b : Module.Basis ι R M) :
    modulePolynomialTopology R M =
      TopologicalSpace.induced b.equivFun (polynomialTopology ι R) := by
  rw [← modulePolynomialTopology_pi (R := R) ι, b.equivFun.induced_modulePolynomialTopology]

/-- For any finite basis of `M`, the intrinsic polynomial Zariski topology coincides with the
topology coinduced from `TauCeti.polynomialTopology` along `b.equivFun.symm`. -/
theorem modulePolynomialTopology_eq_coinduced {ι : Type*} [Finite ι]
    (b : Module.Basis ι R M) :
    modulePolynomialTopology R M =
      TopologicalSpace.coinduced b.equivFun.symm (polynomialTopology ι R) := by
  rw [b.modulePolynomialTopology_eq_induced]
  exact (congrFun b.equivFun.toEquiv.coinduced_symm (polynomialTopology ι R)).symm

/-- Transporting `TauCeti.polynomialTopology` to `M` along any two finite bases produces the exact
same topology on `M`. -/
theorem induced_polynomialTopology_eq_induced {ι₁ ι₂ : Type*} [Finite ι₁] [Finite ι₂]
    (b₁ : Module.Basis ι₁ R M) (b₂ : Module.Basis ι₂ R M) :
    TopologicalSpace.induced b₁.equivFun (polynomialTopology ι₁ R) =
      TopologicalSpace.induced b₂.equivFun (polynomialTopology ι₂ R) := by
  rw [← b₁.modulePolynomialTopology_eq_induced, ← b₂.modulePolynomialTopology_eq_induced]

end Module.Basis

namespace TauCeti

/-- Every subsingleton module (such as a zero-dimensional vector space) is irreducible in the
polynomial Zariski topology over any commutative semiring. -/
theorem irreducibleSpace_modulePolynomialTopology_of_subsingleton [Subsingleton M] :
    @IrreducibleSpace M (modulePolynomialTopology R M) := by
  let := modulePolynomialTopology R M
  exact ⟨⟨0⟩⟩

end TauCeti

end CommSemiring

section Basis

variable {R M : Type*} [CommSemiring R] [Nontrivial R] [NoZeroDivisors R]
  [AddCommMonoid M] [Module R M]

namespace TauCeti

/-- Over a nontrivial commutative semiring without zero divisors, the polynomial nonvanishing loci
of finitely many linear functionals form a topological basis of
`TauCeti.modulePolynomialTopology`. -/
theorem isTopologicalBasis_modulePolynomialTopology :
    @TopologicalSpace.IsTopologicalBasis M (modulePolynomialTopology R M)
      {U | ∃ (n : ℕ) (φ : Fin n → Module.Dual R M) (p : MvPolynomial (Fin n) R),
        U = {x : M | MvPolynomial.eval (fun i ↦ φ i x) p ≠ 0}} := by
  let := modulePolynomialTopology R M
  have huniv : (univ : Set M) ∈
      {U | ∃ (n : ℕ) (φ : Fin n → Module.Dual R M) (p : MvPolynomial (Fin n) R),
        U = {x : M | MvPolynomial.eval (fun i ↦ φ i x) p ≠ 0}} :=
    ⟨0, Fin.elim0, 1, by ext x; simp⟩
  have hbasis := TopologicalSpace.isTopologicalBasis_of_subbasis_of_inter
    (modulePolynomialTopology_eq_generateFrom R M) (by
      rintro _ ⟨n₁, φ₁, p₁, rfl⟩ _ ⟨n₂, φ₂, p₂, rfl⟩
      let φ : Fin (n₁ + n₂) → Module.Dual R M := Fin.addCases φ₁ φ₂
      refine ⟨n₁ + n₂, φ,
        MvPolynomial.rename (Fin.castAdd n₂) p₁ * MvPolynomial.rename (Fin.natAdd n₁) p₂, ?_⟩
      ext x
      have h1 : ((fun i : Fin (n₁ + n₂) ↦ φ i x) ∘ Fin.castAdd n₂) = fun i ↦ φ₁ i x := by
        ext i
        simp [φ]
      have h2 : ((fun i : Fin (n₁ + n₂) ↦ φ i x) ∘ Fin.natAdd n₁) = fun i ↦ φ₂ i x := by
        ext i
        simp [φ]
      simp [map_mul, MvPolynomial.eval_rename, h1, h2])
  rwa [insert_eq_of_mem huniv] at hbasis

/-- Over a nontrivial commutative semiring without zero divisors, a set is open in the polynomial
Zariski topology on `M` exactly when each of its points lies in a basic polynomial nonvanishing
locus contained in the set. -/
theorem isOpen_modulePolynomialTopology_iff {U : Set M} :
    IsOpen[modulePolynomialTopology R M] U ↔
      ∀ x ∈ U, ∃ (n : ℕ) (φ : Fin n → Module.Dual R M) (p : MvPolynomial (Fin n) R),
        MvPolynomial.eval (fun i ↦ φ i x) p ≠ 0 ∧
          {y : M | MvPolynomial.eval (fun i ↦ φ i y) p ≠ 0} ⊆ U := by
  let := modulePolynomialTopology R M
  rw [isTopologicalBasis_modulePolynomialTopology.isOpen_iff]
  constructor
  · intro h x hx
    obtain ⟨V, ⟨n, φ, p, rfl⟩, hxp, hVU⟩ := h x hx
    exact ⟨n, φ, p, hxp, hVU⟩
  · intro h x hx
    obtain ⟨n, φ, p, hxp, hpU⟩ := h x hx
    exact ⟨{y : M | MvPolynomial.eval (fun i ↦ φ i y) p ≠ 0}, ⟨n, φ, p, rfl⟩, hxp, hpU⟩

end TauCeti

end Basis

section CommRing

variable {R : Type*} [CommRing R]

namespace TauCeti

/-- If `Module.Dual R M` separates points of `M`, then points are closed in
`TauCeti.modulePolynomialTopology R M`. -/
theorem t1Space_modulePolynomialTopology_of_dual_separating {M : Type*} [AddCommMonoid M]
    [Module R M] (hsep : ∀ x y : M, x ≠ y → ∃ φ : Module.Dual R M, φ x ≠ φ y) :
    @T1Space M (modulePolynomialTopology R M) := by
  let := modulePolynomialTopology R M
  refine ⟨fun a ↦ ?_⟩
  have hsing : ({a} : Set M) =
      ⋂ φ : Module.Dual R M,
        {x : M | MvPolynomial.eval (fun _ : Fin 1 ↦ φ x)
          (MvPolynomial.X 0 - MvPolynomial.C (φ a)) = 0} := by
    ext x
    simp only [mem_singleton_iff, mem_iInter, mem_ofPred_eq, map_sub, MvPolynomial.eval_X,
      MvPolynomial.eval_C, sub_eq_zero]
    constructor
    · rintro rfl φ
      rfl
    · intro h
      by_contra hne
      obtain ⟨φ, hφ⟩ := hsep x a hne
      exact hφ (h φ)
  rw [hsing]
  exact isClosed_iInter fun φ ↦
    isClosed_modulePolynomialTopology_eval_eq_zero (fun _ : Fin 1 ↦ φ) _

/-- On any free module over a commutative ring, points are closed in the polynomial Zariski
topology. -/
theorem t1Space_modulePolynomialTopology {M : Type*} [AddCommMonoid M] [Module R M]
    [Module.Free R M] :
    @T1Space M (modulePolynomialTopology R M) := by
  refine t1Space_modulePolynomialTopology_of_dual_separating fun x y hxy ↦ ?_
  by_contra! h
  exact hxy ((Module.Free.chooseBasis R M).eval_injective (LinearMap.ext h))

end TauCeti

namespace AffineMap

open TauCeti

/-- Every affine map between modules over a commutative ring is continuous for the polynomial
Zariski topologies. -/
theorem continuous_modulePolynomialTopology {M N : Type*} [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (f : M →ᵃ[R] N) :
    @Continuous _ _ (modulePolynomialTopology R M) (modulePolynomialTopology R N) f := by
  rw [f.decomp]
  exact f.linear.continuous_modulePolynomialTopology_add_const (f 0)

end AffineMap

namespace AffineEquiv

open TauCeti

/-- Every affine equivalence between modules over a commutative ring is a homeomorphism for the
polynomial Zariski topologies. -/
theorem isHomeomorph_modulePolynomialTopology {M N : Type*} [AddCommGroup M]
    [Module R M] [AddCommGroup N] [Module R N] (e : M ≃ᵃ[R] N) :
    @IsHomeomorph _ _ (modulePolynomialTopology R M) (modulePolynomialTopology R N) e := by
  let := modulePolynomialTopology R M
  let := modulePolynomialTopology R N
  exact Homeomorph.isHomeomorph
    ⟨e.toEquiv, e.toAffineMap.continuous_modulePolynomialTopology,
      e.symm.toAffineMap.continuous_modulePolynomialTopology⟩

/-- An affine equivalence transports the polynomial Zariski topology to itself. -/
@[simp]
theorem induced_modulePolynomialTopology {M N : Type*} [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (e : M ≃ᵃ[R] N) :
    TopologicalSpace.induced e (modulePolynomialTopology R N) = modulePolynomialTopology R M := by
  let := modulePolynomialTopology R M
  let := modulePolynomialTopology R N
  exact
    ((e.isHomeomorph_modulePolynomialTopology).homeomorph.isInducing.eq_induced).symm

end AffineEquiv

namespace TauCeti

/-- On a commutative ring `R` without zero divisors viewed as a module over itself, the polynomial
Zariski topology coincides with the cofinite topology. -/
theorem modulePolynomialTopology_self_eq_cofinite [NoZeroDivisors R] :
    modulePolynomialTopology R R = TopologicalSpace.cofinite := by
  let e : R ≃ₗ[R] (Unit → R) := (LinearEquiv.funUnique Unit R R).symm
  rw [← e.induced_modulePolynomialTopology, modulePolynomialTopology_pi Unit,
    polynomialTopology_eq_cofinite]
  ext U
  let : TopologicalSpace (Unit → R) := TopologicalSpace.cofinite
  rw [isOpen_induced_iff]
  simp only [isOpen_mk]
  constructor
  · rintro ⟨V, hV, rfl⟩ ⟨x, hx⟩
    rw [← preimage_compl]
    exact (hV ⟨e x, hx⟩).preimage e.injective.injOn
  · intro hU
    refine ⟨e '' U, fun hne ↦ ?_, e.injective.preimage_image U⟩
    rw [← Set.image_compl_eq e.bijective]
    exact (hU (image_nonempty.mp hne)).image e

/-- On a commutative ring `R` without zero divisors, a set is polynomial-Zariski open exactly when
it is empty or has finite complement. -/
theorem isOpen_modulePolynomialTopology_self_iff_cofinite [NoZeroDivisors R] {U : Set R} :
    IsOpen[modulePolynomialTopology R R] U ↔ U = ∅ ∨ Uᶜ.Finite := by
  rw [modulePolynomialTopology_self_eq_cofinite, TopologicalSpace.cofinite, isOpen_mk,
    nonempty_iff_ne_empty, or_iff_not_imp_left]

/-- On a commutative ring `R` without zero divisors, a set is polynomial-Zariski closed exactly
when it is the whole ring or finite. -/
theorem isClosed_modulePolynomialTopology_self_iff_cofinite [NoZeroDivisors R] {F : Set R} :
    IsClosed[modulePolynomialTopology R R] F ↔ F = Set.univ ∨ F.Finite := by
  let := modulePolynomialTopology R R
  rw [← isOpen_compl_iff, isOpen_modulePolynomialTopology_self_iff_cofinite, compl_empty_iff,
    compl_compl]

/-- On a commutative ring `R` without zero divisors, no nonempty set with infinite complement (such
as the complex open unit disk) is open in the polynomial Zariski topology. -/
theorem not_isOpen_modulePolynomialTopology_self_of_nonempty_of_infinite_compl [NoZeroDivisors R]
    {U : Set R} (hne : U.Nonempty) (hinf : Uᶜ.Infinite) :
    ¬ IsOpen[modulePolynomialTopology R R] U := by
  rw [isOpen_modulePolynomialTopology_self_iff_cofinite]
  rintro (rfl | hfin)
  · exact hne.ne_empty rfl
  · exact hinf hfin

/-- For any `x, y : M`, the affine line `t ↦ (1 - t) • x + t • y` is continuous for the polynomial
Zariski topologies. -/
theorem continuous_modulePolynomialTopology_line {M : Type*} [AddCommMonoid M] [Module R M]
    (x y : M) :
    @Continuous R M (modulePolynomialTopology R R) (modulePolynomialTopology R M)
      (fun t ↦ (1 - t) • x + t • y) := by
  have hfun : (fun t : R ↦ (1 - t) • x + t • y) =
      fun t : R ↦ (LinearMap.id : R →ₗ[R] R).smulRight (y + (-1 : R) • x) t + x := by
    ext t
    simp [sub_eq_add_neg, add_smul, smul_add, smul_smul, add_comm, add_left_comm]
  rw [hfun]
  exact ((LinearMap.id : R →ₗ[R] R).smulRight
    (y + (-1 : R) • x)).continuous_modulePolynomialTopology_add_const x

/-- Over a Noetherian commutative ring, every finitely generated module is a Noetherian space in
the polynomial Zariski topology. -/
theorem noetherianSpace_modulePolynomialTopology {M : Type*} [IsNoetherianRing R] [AddCommMonoid M]
    [Module R M] [Module.Finite R M] :
    @TopologicalSpace.NoetherianSpace M (modulePolynomialTopology R M) := by
  let := modulePolynomialTopology R M
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  let := modulePolynomialTopology R (Fin n → R)
  have : @TopologicalSpace.NoetherianSpace (Fin n → R)
      (modulePolynomialTopology R (Fin n → R)) := by
    rw [modulePolynomialTopology_pi]
    exact noetherianSpace_polynomialTopology
  exact TopologicalSpace.noetherianSpace_of_surjective f f.continuous_modulePolynomialTopology hf

end TauCeti

end CommRing

section Domain

variable {R : Type*} [CommRing R] [IsDomain R]

namespace TauCeti

section Infinite

variable [Infinite R]

/-- Over an infinite integral domain, every module is an irreducible space in the polynomial Zariski
topology. -/
theorem irreducibleSpace_modulePolynomialTopology {M : Type*} [AddCommMonoid M] [Module R M] :
    @IrreducibleSpace M (modulePolynomialTopology R M) := by
  let := modulePolynomialTopology R M
  let := modulePolynomialTopology R R
  have : PreirreducibleSpace M := ⟨fun U V hU hV ⟨x, _, hxU⟩ ⟨y, _, hyV⟩ ↦ by
    have hγ := continuous_modulePolynomialTopology_line (R := R) x y
    have hU' : ((fun t : R ↦ (1 - t) • x + t • y) ⁻¹' U)ᶜ.Finite :=
      (isOpen_modulePolynomialTopology_self_iff_cofinite.mp (hU.preimage hγ)).resolve_left
        (Set.Nonempty.ne_empty ⟨0, by simpa using hxU⟩)
    have hV' : ((fun t : R ↦ (1 - t) • x + t • y) ⁻¹' V)ᶜ.Finite :=
      (isOpen_modulePolynomialTopology_self_iff_cofinite.mp (hV.preimage hγ)).resolve_left
        (Set.Nonempty.ne_empty ⟨1, by simpa using hyV⟩)
    obtain ⟨t, ht⟩ := (hU'.union hV').infinite_compl.nonempty
    exact ⟨(1 - t) • x + t • y, mem_univ _, by simpa using ht⟩⟩
  exact ⟨⟨0⟩⟩

/-- Over an infinite integral domain, the whole module is irreducible in the polynomial Zariski
topology. -/
theorem isIrreducible_univ_modulePolynomialTopology {M : Type*} [AddCommMonoid M] [Module R M] :
    @IsIrreducible M (modulePolynomialTopology R M) Set.univ := by
  let := modulePolynomialTopology R M
  have := irreducibleSpace_modulePolynomialTopology (R := R) (M := M)
  exact IrreducibleSpace.isIrreducible_univ M

/-- A continuous map out of a module over an infinite integral domain with dense range pulls back
every nonempty open set to a dense set. -/
theorem dense_preimage_modulePolynomialTopology_of_denseRange {M X : Type*} [AddCommMonoid M]
    [Module R M] [τX : TopologicalSpace X] {f : M → X}
    (hf : @Continuous _ _ (modulePolynomialTopology R M) τX f) (hdr : DenseRange f)
    {U : Set X} (hU : IsOpen U) (hne : U.Nonempty) :
    @Dense M (modulePolynomialTopology R M) (f ⁻¹' U) := by
  let := modulePolynomialTopology R M
  have := irreducibleSpace_modulePolynomialTopology (R := R) (M := M)
  exact (hU.preimage hf).dense (hdr.exists_mem_open hU hne)

/-- A surjective linear map between modules over an infinite integral domain pulls back every
nonempty polynomial-Zariski open set to a dense set. -/
theorem dense_preimage_modulePolynomialTopology_of_surjective_linearMap {M N : Type*}
    [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N]
    {f : M →ₗ[R] N} (hf : Function.Surjective f) {U : Set N}
    (hU : IsOpen[modulePolynomialTopology R N] U) (hne : U.Nonempty) :
    @Dense M (modulePolynomialTopology R M) (f ⁻¹' U) := by
  let := modulePolynomialTopology R N
  exact dense_preimage_modulePolynomialTopology_of_denseRange
    f.continuous_modulePolynomialTopology hf.denseRange hU hne

/-- A surjective affine map between modules over an infinite integral domain pulls back every
nonempty polynomial-Zariski open set to a dense set. -/
theorem dense_preimage_modulePolynomialTopology_of_surjective_affineMap {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {f : M →ᵃ[R] N} (hf : Function.Surjective f) {U : Set N}
    (hU : IsOpen[modulePolynomialTopology R N] U) (hne : U.Nonempty) :
    @Dense M (modulePolynomialTopology R M) (f ⁻¹' U) := by
  let := modulePolynomialTopology R N
  exact dense_preimage_modulePolynomialTopology_of_denseRange
    f.continuous_modulePolynomialTopology hf.denseRange hU hne

end Infinite

end TauCeti

section Infinite

variable [Infinite R]

namespace AffineSubspace

open TauCeti

/-- Every nonempty affine subspace of a module over an infinite integral domain is irreducible in
the polynomial Zariski topology. -/
theorem isIrreducible_modulePolynomialTopology {M : Type*} [AddCommGroup M]
    [Module R M] (A : AffineSubspace R M) (hne : (A : Set M).Nonempty) :
    @IsIrreducible M (modulePolynomialTopology R M) (A : Set M) := by
  let := modulePolynomialTopology R A.direction
  let := modulePolynomialTopology R M
  obtain ⟨p₀, hp₀⟩ := hne
  have : Nonempty A := ⟨⟨p₀, hp₀⟩⟩
  let e : A.direction ≃ᵃ[R] A := AffineEquiv.vaddConst R (⟨p₀, hp₀⟩ : A)
  have hcont : Continuous (Subtype.val ∘ e) :=
    A.direction.subtype.continuous_modulePolynomialTopology_add_const p₀
  have himg : (Subtype.val ∘ e) '' Set.univ = (A : Set M) := by
    rw [Set.image_comp, Set.image_univ_of_surjective e.surjective, Set.image_univ,
      Subtype.range_coe]
  rw [← himg]
  exact (isIrreducible_univ_modulePolynomialTopology (R := R) (M := A.direction)).image
    (Subtype.val ∘ e) hcont.continuousOn

/-- Every nonempty affine subspace of a module over an infinite integral domain is an irreducible
space in the subspace polynomial Zariski topology. -/
theorem irreducibleSpace_modulePolynomialTopology {M : Type*} [AddCommGroup M]
    [Module R M] (A : AffineSubspace R M) (hne : (A : Set M).Nonempty) :
    @IrreducibleSpace A (TopologicalSpace.induced Subtype.val (modulePolynomialTopology R M)) := by
  let := modulePolynomialTopology R M
  exact Subtype.irreducibleSpace (A.isIrreducible_modulePolynomialTopology hne)

/-- If a polynomial-Zariski open set meets an affine subspace `A`, its intersection with `A` is
dense in `A` for the subspace topology. -/
theorem dense_preimage_val_modulePolynomialTopology {M : Type*} [AddCommGroup M]
    [Module R M] (A : AffineSubspace R M) {U : Set M}
    (hU : IsOpen[modulePolynomialTopology R M] U) (hne : ((A : Set M) ∩ U).Nonempty) :
    @Dense A (TopologicalSpace.induced Subtype.val (modulePolynomialTopology R M))
      ((Subtype.val : A → M) ⁻¹' U) := by
  let := modulePolynomialTopology R M
  have hAne : (A : Set M).Nonempty := ⟨hne.choose, hne.choose_spec.1⟩
  have := A.irreducibleSpace_modulePolynomialTopology hAne
  have hopen : IsOpen ((Subtype.val : A → M) ⁻¹' U) := hU.preimage continuous_subtype_val
  have hpre : ((Subtype.val : A → M) ⁻¹' U).Nonempty :=
    ⟨⟨hne.choose, hne.choose_spec.1⟩, hne.choose_spec.2⟩
  exact hopen.dense hpre

/-- If a polynomial-Zariski open set meets an affine subspace `A`, then `A` lies in the ambient
polynomial-Zariski closure of `A ∩ U`. -/
theorem subset_closure_inter_modulePolynomialTopology {M : Type*} [AddCommGroup M]
    [Module R M] (A : AffineSubspace R M) {U : Set M}
    (hU : IsOpen[modulePolynomialTopology R M] U) (hne : ((A : Set M) ∩ U).Nonempty) :
    (A : Set M) ⊆ @closure M (modulePolynomialTopology R M) ((A : Set M) ∩ U) := by
  let := modulePolynomialTopology R M
  have hAne : (A : Set M).Nonempty := ⟨hne.choose, hne.choose_spec.1⟩
  exact subset_closure_inter_of_isPreirreducible_of_isOpen
    (A.isIrreducible_modulePolynomialTopology hAne).isPreirreducible hU hne

end AffineSubspace

end Infinite

end Domain

section Field

variable {k V W : Type*} [Field k] [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]

namespace TauCeti

/-- Over a field, every injective linear map is a topological embedding for the polynomial Zariski
topologies. -/
theorem isEmbedding_modulePolynomialTopology_of_injective_linearMap {f : V →ₗ[k] W}
    (hf : Function.Injective f) :
    @IsEmbedding _ _ (modulePolynomialTopology k V) (modulePolynomialTopology k W) f := by
  obtain ⟨g, hgf⟩ := f.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr hf)
  exact isEmbedding_modulePolynomialTopology_of_leftInverse hgf

/-- Over a field, every injective linear map induces the polynomial Zariski topology on its
domain. -/
theorem induced_modulePolynomialTopology_of_injective_linearMap {f : V →ₗ[k] W}
    (hf : Function.Injective f) :
    TopologicalSpace.induced f (modulePolynomialTopology k W) = modulePolynomialTopology k V := by
  let := modulePolynomialTopology k V
  let := modulePolynomialTopology k W
  exact (isEmbedding_modulePolynomialTopology_of_injective_linearMap hf).isInducing.eq_induced.symm

end TauCeti

namespace Submodule

open TauCeti

/-- Over a field, the subspace topology induced by the ambient polynomial Zariski topology on any
submodule coincides with the submodule's intrinsic polynomial Zariski topology. -/
@[simp]
theorem induced_modulePolynomialTopology (S : Submodule k V) :
    TopologicalSpace.induced (Subtype.val : S → V) (modulePolynomialTopology k V) =
      modulePolynomialTopology k S :=
  induced_modulePolynomialTopology_of_injective_linearMap S.injective_subtype

end Submodule

namespace AffineSubspace

open TauCeti

/-- Over a field, translating the direction submodule by a base point `p₀ ∈ A` is a homeomorphism
from the intrinsic polynomial Zariski topology on `A.direction` to the subspace topology on the
affine subspace `A`. -/
theorem isHomeomorph_modulePolynomialTopology_direction (A : AffineSubspace k V)
    {p₀ : V} (hp₀ : p₀ ∈ A) :
    @IsHomeomorph A.direction A (modulePolynomialTopology k A.direction)
      (TopologicalSpace.induced Subtype.val (modulePolynomialTopology k V))
      (fun v ↦ ⟨(v : V) + p₀, AffineSubspace.vadd_mem_of_mem_direction v.2 hp₀⟩) := by
  have : Nonempty A := ⟨⟨p₀, hp₀⟩⟩
  let e : A.direction ≃ A := (AffineEquiv.vaddConst k (⟨p₀, hp₀⟩ : A)).toEquiv
  let := modulePolynomialTopology k V
  have hto : @Continuous _ _ (modulePolynomialTopology k A.direction)
      (TopologicalSpace.induced Subtype.val (modulePolynomialTopology k V)) e := by
    rw [continuous_induced_rng]
    exact A.direction.subtype.continuous_modulePolynomialTopology_add_const p₀
  have hinv : @Continuous _ _
      (TopologicalSpace.induced Subtype.val (modulePolynomialTopology k V))
      (modulePolynomialTopology k A.direction) e.symm := by
    have hsub : Continuous (fun x : V ↦ x + (-p₀)) :=
      (LinearMap.id : V →ₗ[k] V).continuous_modulePolynomialTopology_add_const (-p₀)
    have hcomp : Continuous (fun x : A ↦ (x : V) - p₀) := by
      simpa only [Function.comp_def, sub_eq_add_neg] using hsub.comp continuous_subtype_val
    rw [← A.direction.induced_modulePolynomialTopology, continuous_induced_rng]
    exact hcomp
  let := modulePolynomialTopology k A.direction
  exact Homeomorph.isHomeomorph ⟨e, hto, hinv⟩

end AffineSubspace

end Field
