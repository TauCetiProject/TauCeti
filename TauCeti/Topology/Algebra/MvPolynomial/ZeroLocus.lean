module

public import Mathlib.Analysis.InnerProductSpace.PiL2
public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.Topology.Algebra.MvPolynomial

import Mathlib.Topology.MetricSpace.ProperSpace.Lemmas
import TauCeti.Topology.Maps.Proper.Metric

/-!
# Zero loci of polynomials are closed

Let `K` be a field with a topology in which the ring operations are continuous and points are
closed, such as `ℝ`, `ℂ` or a `p`-adic field, and let `k` be a field with `K` a `k`-algebra. The
common zeros in `K^σ` of an ideal of `k[X_σ]` form a closed set, since evaluating a polynomial is
continuous. Consequently the topological closure of a set of points lies in its Zariski closure,
the zero locus of its vanishing ideal: a polynomial identity holding on a set also holds on its
closure.

The common zero set of a family of polynomials `p : ι → R[X_σ]` is also presented as the level
set `TauCeti.affineZeroLocus p` of the evaluation map `x ↦ (pᵢ(x))ᵢ` at `0`, the form on which
implicit-function charts are built. Over `ℝ` or `ℂ` the Euclidean squared distance from any point
restricts to a proper function on it.

## Main results

* `MvPolynomial.isClosed_zeroLocus`: zero loci are closed.
* `MvPolynomial.closure_subset_zeroLocus_vanishingIdeal`: the closure of a set lies in the zero
  locus of its vanishing ideal.
* `TauCeti.affineZeroLocus_eq_zeroLocus`: the level-set zero locus of a family is the zero locus
  of the ideal it generates.
* `TauCeti.isClosed_affineZeroLocus`: the level-set zero locus is closed.
* `TauCeti.isProperMap_norm_sq_sub_toLp_affineZeroLocus`: Euclidean squared distance is proper on
  it.
-/

public section

namespace MvPolynomial

variable {k K σ : Type*} [Field k] [Field K] [Algebra k K] [TopologicalSpace K]
  [IsTopologicalRing K] [T1Space K]

/-- In a field with continuous ring operations and closed points, the common zero locus of an
ideal of polynomials is closed. -/
theorem isClosed_zeroLocus (I : Ideal (MvPolynomial σ k)) : IsClosed (zeroLocus K I) := by
  have hI : zeroLocus K I =
      ⋂ p ∈ I, (fun x : σ → K ↦ eval x (map (algebraMap k K) p)) ⁻¹' {0} := by
    ext x
    simp [mem_zeroLocus_iff, aeval_def, eval_map]
  rw [hI]
  exact isClosed_biInter fun p _ ↦ isClosed_singleton.preimage (continuous_eval _)

/-- In a field with continuous ring operations and closed points, the closure of a set of points
lies in its Zariski closure, the zero locus of its vanishing ideal. -/
theorem closure_subset_zeroLocus_vanishingIdeal (V : Set (σ → K)) :
    closure V ⊆ zeroLocus K (vanishingIdeal k V) :=
  closure_minimal (zeroLocus_vanishingIdeal_le V) (isClosed_zeroLocus _)

end MvPolynomial

open MvPolynomial Set

namespace TauCeti

section CommSemiring

variable {R σ ι : Type*} [CommSemiring R]

/-- The common zero set in `R^σ` of a family of polynomials, presented as the level set of
their evaluation map `x ↦ (pᵢ(x))ᵢ` at `0`. Over a field it agrees with `MvPolynomial.zeroLocus`
of the ideal generated by the family (`TauCeti.affineZeroLocus_eq_zeroLocus`); the level-set
presentation is the one on which implicit-function charts are built. -/
@[expose] def affineZeroLocus (p : ι → MvPolynomial σ R) : Set (σ → R) :=
  {x | (fun k ↦ eval x (p k)) = 0}

variable {p : ι → MvPolynomial σ R}

@[simp]
theorem mem_affineZeroLocus {x : σ → R} : x ∈ affineZeroLocus p ↔ ∀ k, eval x (p k) = 0 :=
  funext_iff

/-- The common zero set of a family of polynomials is closed. -/
theorem isClosed_affineZeroLocus [TopologicalSpace R] [IsTopologicalSemiring R] [T2Space R]
    (p : ι → MvPolynomial σ R) : IsClosed (affineZeroLocus p) :=
  isClosed_eq (continuous_pi fun k ↦ continuous_eval (p k)) continuous_const

end CommSemiring

/-- The level-set zero locus of a family is Mathlib's zero locus of the ideal it generates. -/
theorem affineZeroLocus_eq_zeroLocus {K σ ι : Type*} [Field K] {p : ι → MvPolynomial σ K} :
    affineZeroLocus p = zeroLocus K (Ideal.span (range p)) := by
  ext x
  rw [mem_affineZeroLocus, mem_zeroLocus_iff]
  refine ⟨fun h q hq ↦ ?_, fun h k ↦ h _ (Ideal.subset_span (mem_range_self k))⟩
  have hle : Ideal.span (range p) ≤ RingHom.ker (eval x) := by
    rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    exact h k
  simpa using hle hq

/-- **Squared distance is proper on an affine algebraic set.** For every point `a` of Euclidean
space `𝕜^σ`, the Euclidean squared distance from `a`, restricted to the common zero set of a family
of polynomials, is a proper map. -/
theorem isProperMap_norm_sq_sub_toLp_affineZeroLocus {𝕜 σ ι : Type*} [RCLike 𝕜] [Fintype σ]
    (p : ι → MvPolynomial σ 𝕜) (a : EuclideanSpace 𝕜 σ) :
    IsProperMap fun x : affineZeroLocus p ↦ ‖WithLp.toLp 2 (x : σ → 𝕜) - a‖ ^ 2 :=
  isProperMap_norm_sq_sub_comp ((EuclideanSpace.equiv σ 𝕜).symm.toHomeomorph.isClosedEmbedding.comp
    (isClosed_affineZeroLocus p).isClosedEmbedding_subtypeVal) a

end TauCeti
