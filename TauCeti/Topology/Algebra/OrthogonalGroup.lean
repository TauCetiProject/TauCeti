/-!
# Closedness and path components of matrix orthogonal groups

The matrix orthogonal and special orthogonal groups are closed in the entrywise matrix topology.
The orthogonal group is cut out by the transpose-inverse equations, and the special orthogonal
group adds the determinant-one equation. Mathlib defines these groups as the unitary and special
unitary groups for the trivial scalar star operation, so their closedness follows from the
corresponding unitary results.

Over `ℝ` the special orthogonal group is path-connected, so two orthogonal matrices lie in the
same path component exactly when they have the same determinant; for a nonempty index type the
orthogonal group therefore has exactly two path components, cut out by the sign of the
determinant. The special orthogonal group is
generated by products `r_u r_w` of two reflections
(`TauCeti.closure_reflection_mul_eq_matrixSpecialOrthogonalGroup`), and such a product is joined
to `r_u r_u = 1` by moving `w` to `u`: along the segment from `w` to `u` when it avoids the origin,
and directly otherwise, since then `w` is a multiple of `u` and `r_w = r_u`. The products joined to
the identity form a submonoid, which therefore contains every special orthogonal matrix.

## Main results

* `TauCeti.Matrix.isClosed_orthogonalGroup` and `TauCeti.Matrix.isClosed_specialOrthogonalGroup`:
  the matrix orthogonal and special orthogonal groups are closed over any `T₁` topological
  commutative ring.
* `TauCeti.Matrix.instPathConnectedSpaceSpecialOrthogonalGroup`: the real special orthogonal
  group is path-connected.
* `TauCeti.Matrix.joined_orthogonalGroup_iff_det_eq`: two real orthogonal matrices are joined by
  a path of orthogonal matrices exactly when they have the same determinant.

The closedness statements identify the topological input supplied by these carriers for later
constructions of Lie-group structures and continuity arguments on the corresponding subgroups.
-/

public section

namespace TauCeti.Matrix

variable {n R : Type*} [Fintype n] [DecidableEq n]
  [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]

attribute [local instance] starRingOfComm

local instance instContinuousStar {R : Type*} [CommSemiring R] [TopologicalSpace R] :
    ContinuousStar R := ⟨continuous_id⟩

/-- The matrix orthogonal group is closed in the entrywise matrix topology. -/
theorem isClosed_orthogonalGroup [T1Space R] :
    IsClosed (Matrix.orthogonalGroup n R : Set (Matrix n n R)) := by
  simpa only [Matrix.orthogonalGroup] using
    (isClosed_unitary (R := Matrix n n R))

/-- The matrix special orthogonal group is closed in the entrywise matrix topology. -/
theorem isClosed_specialOrthogonalGroup [T1Space R] :
    IsClosed (Matrix.specialOrthogonalGroup n R : Set (Matrix n n R)) := by
  simpa only [Matrix.specialOrthogonalGroup] using
    (TauCeti.Matrix.isClosed_specialUnitaryGroup (n := n) (𝕜 := R))

end TauCeti.Matrix

-- Reopened over `ℝ` without the local `starRingOfComm` instance of the section above.
namespace TauCeti.Matrix

open _root_.Matrix unitInterval

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-! ### Path components of the real orthogonal group -/

/-- The matrix of the reflection of `ι → ℝ` in the hyperplane orthogonal to `u`, with the
normalizing scalar `2 / (u ⬝ᵥ u)`. -/
private noncomputable def refl (u : ι → ℝ) : _root_.Matrix ι ι ℝ :=
  TauCeti.reflectionMatrix u (2 / (u ⬝ᵥ u))

omit [DecidableEq ι] in
private lemma refl_hc {u : ι → ℝ} (hu : u ≠ 0) : 2 / (u ⬝ᵥ u) * (u ⬝ᵥ u) = 2 :=
  div_mul_cancel₀ _ (mt dotProduct_self_eq_zero.1 hu)

/-- The reflection in a nonzero vector only depends on the line it spans. -/
private lemma refl_smul {u : ι → ℝ} (hu : u ≠ 0) {c : ℝ} (hc : c ≠ 0) :
    refl (c • u) = refl u := by
  have huu : u ⬝ᵥ u ≠ 0 := mt dotProduct_self_eq_zero.1 hu
  have h : c • u = fun i ↦ c * u i := funext fun i ↦ Pi.smul_apply c u i
  rw [refl, refl, h, TauCeti.reflectionMatrix_smul]
  congr 1
  simp only [← h, dotProduct_smul, smul_dotProduct, smul_eq_mul]
  field_simp

private lemma refl_mul_refl_mem {u w : ι → ℝ} (hu : u ≠ 0) (hw : w ≠ 0) :
    refl u * refl w ∈ specialOrthogonalGroup ι ℝ := by
  rw [mem_specialOrthogonalGroup_iff]
  refine ⟨mul_mem (TauCeti.reflectionMatrix_mem_orthogonalGroup (refl_hc hu))
    (TauCeti.reflectionMatrix_mem_orthogonalGroup (refl_hc hw)), ?_⟩
  rw [det_mul, refl, refl, TauCeti.det_reflectionMatrix (refl_hc hu),
    TauCeti.det_reflectionMatrix (refl_hc hw)]
  norm_num

private lemma continuousOn_refl : ContinuousOn (refl (ι := ι)) {u | u ≠ 0} := by
  rw [show refl (ι := ι) = fun u ↦ 1 - vecMulVec ((2 / (u ⬝ᵥ u)) • u) u from
    funext fun u ↦ TauCeti.reflectionMatrix_eq_one_sub_vecMulVec u _]
  have hc : ContinuousOn (fun u : ι → ℝ ↦ (2 / (u ⬝ᵥ u)) • u) {u | u ≠ 0} :=
    (continuousOn_const.div (continuous_id.dotProduct continuous_id).continuousOn
      fun u hu ↦ mt dotProduct_self_eq_zero.1 hu).smul continuousOn_id
  exact continuousOn_const.sub ((continuous_fst.matrix_vecMulVec continuous_snd).comp_continuousOn
    (hc.prodMk continuousOn_id))

/-- A product of two reflections in nonzero vectors is joined to the identity in the special
orthogonal group. -/
private lemma joined_one_refl_mul_refl {u w : ι → ℝ} (hu : u ≠ 0) (hw : w ≠ 0) :
    Joined (1 : specialOrthogonalGroup ι ℝ) ⟨refl u * refl w, refl_mul_refl_mem hu hw⟩ := by
  by_cases hlin : ∃ c : ℝ, w = c • u
  · obtain ⟨c, rfl⟩ := hlin
    have hc : c ≠ 0 := by rintro rfl; simp at hw
    have : (⟨refl u * refl (c • u), refl_mul_refl_mem hu hw⟩ : specialOrthogonalGroup ι ℝ) = 1 :=
      Subtype.ext <| (congrArg (refl u * ·) (refl_smul hu hc)).trans
        (TauCeti.reflectionMatrix_mul_self (refl_hc hu))
    rw [this]
  push Not at hlin
  -- The segment from `w` to `u` avoids the origin.
  have hσ : ∀ t : I, (1 - (t : ℝ)) • w + (t : ℝ) • u ≠ 0 := by
    intro t ht
    have ht1 : 1 - (t : ℝ) ≠ 0 := by
      intro h
      have h1 : (t : ℝ) = 1 := by linarith
      simp [h1, hu] at ht
    apply hlin (-((t : ℝ) / (1 - t)))
    ext i
    have hi := congrFun ht i
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hi ⊢
    field_simp
    linear_combination hi
  have hcont : Continuous fun t : I ↦ refl ((1 - (t : ℝ)) • w + (t : ℝ) • u) :=
    continuousOn_refl.comp_continuous (by fun_prop) hσ
  refine ⟨{
    toFun := fun t ↦ ⟨refl u * refl ((1 - (σ t : ℝ)) • w + (σ t : ℝ) • u),
      refl_mul_refl_mem hu (hσ (σ t))⟩
    continuous_toFun := (continuous_const.mul (hcont.comp continuous_symm)).subtype_mk _
    source' := ?_
    target' := ?_ }⟩
  · apply Subtype.ext
    simp [refl, TauCeti.reflectionMatrix_mul_self (refl_hc hu)]
  · apply Subtype.ext
    simp

/-- **The real special orthogonal group is path-connected.** -/
instance instPathConnectedSpaceSpecialOrthogonalGroup :
    PathConnectedSpace (specialOrthogonalGroup ι ℝ) := by
  refine ⟨⟨1⟩, fun A B ↦ ?_⟩
  suffices h : ∀ A : specialOrthogonalGroup ι ℝ, Joined 1 A from (h A).symm.trans (h B)
  intro A
  -- The matrices joined to the identity form a submonoid containing the products of two
  -- reflections, which generate the special orthogonal group.
  let P : Submonoid (_root_.Matrix ι ι ℝ) :=
    (Submonoid.pathComponentOne (specialOrthogonalGroup ι ℝ)).map
      (specialOrthogonalGroup ι ℝ).subtype
  have hle : specialOrthogonalGroup ι ℝ ≤ P := by
    rw [← TauCeti.closure_reflection_mul_eq_matrixSpecialOrthogonalGroup, Submonoid.closure_le]
    rintro _ ⟨u, w, hu, hw, rfl⟩
    have hu0 : u ≠ 0 := by
      rintro rfl
      exact Invertible.ne_zero _ (toQuadraticForm' (1 : _root_.Matrix ι ι ℝ)).map_zero
    have hw0 : w ≠ 0 := by
      rintro rfl
      exact Invertible.ne_zero _ (toQuadraticForm' (1 : _root_.Matrix ι ι ℝ)).map_zero
    refine ⟨⟨refl u * refl w, refl_mul_refl_mem hu0 hw0⟩,
      mem_pathComponent_iff.2 (joined_one_refl_mul_refl hu0 hw0), ?_⟩
    simp only [Submonoid.coe_subtype, refl, TauCeti.toMatrix'_reflection, toQuadraticForm'_apply,
      one_mulVec, invOf_eq_inv, div_eq_mul_inv]
  obtain ⟨B, hB, hBA⟩ := hle A.2
  obtain rfl : B = A := Subtype.ext hBA
  exact mem_pathComponent_iff.1 hB

/-- **The path components of the real orthogonal group.** Two orthogonal matrices are joined by a
path of orthogonal matrices exactly when they have the same determinant. -/
theorem joined_orthogonalGroup_iff_det_eq {A B : orthogonalGroup ι ℝ} :
    Joined A B ↔ (A : _root_.Matrix ι ι ℝ).det = (B : _root_.Matrix ι ι ℝ).det := by
  constructor
  · -- The determinant along a path takes only the values `±1`, so it cannot change sign.
    rintro ⟨γ⟩
    have hc : Continuous fun t ↦ ((γ t : orthogonalGroup ι ℝ) : _root_.Matrix ι ι ℝ).det :=
      (continuous_subtype_val.comp γ.continuous).matrix_det
    have h0 : ∀ t, ((γ t : orthogonalGroup ι ℝ) : _root_.Matrix ι ι ℝ).det ≠ 0 := fun t ↦ by
      rcases det_eq_one_or_neg_one_of_mem_orthogonalGroup (γ t).2 with h | h <;> simp [h]
    rcases det_eq_one_or_neg_one_of_mem_orthogonalGroup A.2 with hA | hA <;>
      rcases det_eq_one_or_neg_one_of_mem_orthogonalGroup B.2 with hB | hB
    · rw [hA, hB]
    · obtain ⟨t, ht⟩ := intermediate_value_univ 1 0 hc (show (0 : ℝ) ∈ _ by simp [hA, hB])
      exact (h0 t ht).elim
    · obtain ⟨t, ht⟩ := intermediate_value_univ 0 1 hc (show (0 : ℝ) ∈ _ by simp [hA, hB])
      exact (h0 t ht).elim
    · rw [hA, hB]
  · -- `A⁻¹ * B` is special orthogonal, hence joined to the identity.
    intro h
    have hdet : ((A⁻¹ * B : orthogonalGroup ι ℝ) : _root_.Matrix ι ι ℝ).det = 1 := by
      simpa [star_eq_conjTranspose, det_conjTranspose, det_mul, h] using
        congrArg det ((mem_orthogonalGroup_iff' _ _).1 A.2)
    let C : specialOrthogonalGroup ι ℝ := ⟨A⁻¹ * B, (A⁻¹ * B).2, hdet⟩
    have hC : Joined (1 : orthogonalGroup ι ℝ) (A⁻¹ * B) :=
      (PathConnectedSpace.joined 1 C).map (f := fun D : specialOrthogonalGroup ι ℝ ↦
        (⟨D, D.2.1⟩ : orthogonalGroup ι ℝ)) (continuous_subtype_val.subtype_mk _)
    simpa using (Joined.refl A).mul hC

end TauCeti.Matrix
