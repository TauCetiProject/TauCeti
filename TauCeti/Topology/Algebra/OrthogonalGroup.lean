/-!
# Closedness and path components of matrix orthogonal groups

The matrix orthogonal and special orthogonal groups are closed in the entrywise matrix topology.
The orthogonal group is cut out by the transpose-inverse equations, and the special orthogonal
group adds the determinant-one equation. Mathlib defines these groups as the unitary and special
unitary groups for the trivial scalar star operation, so their closedness follows from the
corresponding unitary results. Likewise the block inclusions `TauCeti.orthogonalBlockSucc` and
`TauCeti.specialOrthogonalBlockSucc` are continuous closed embeddings (bundled as
`TauCeti.continuousOrthogonalBlockSucc` and `TauCeti.continuousSpecialOrthogonalBlockSucc`),
`Matrix.specialOrthogonalGroup.toOrthogonalGroup` is a continuous closed embedding whose determinant
sign descends to `TauCeti.orthogonalDetSign : O(n) →* ℤˣ`, and reindexing along an equivalence
`e : m ≃ n` induces `Matrix.specialOrthogonalReindexContinuousMulEquiv : SO(m, k) ≃ₜ* SO(n, k)`.

Over `ℝ` the special orthogonal group is path-connected, so two orthogonal matrices lie in the
same path component exactly when they have the same determinant; for a nonempty index type the
orthogonal group therefore has exactly two path components, cut out by the sign of the
determinant. The special orthogonal group is
generated by products `r_u r_w` of two reflections
(`TauCeti.closure_reflection_mul_eq_matrixSpecialOrthogonalGroup`), and such a product is joined
to `r_u r_u = 1` by moving `w` to `u`: along the segment from `w` to `u` when it avoids the origin,
and directly otherwise, since then `w` is a multiple of `u` and `r_w = r_u`. The products joined to
the identity form a submonoid, which therefore contains every special orthogonal matrix.

Read through the action of orthogonal matrices on Euclidean space, two linear isometries of
`EuclideanSpace ℝ ι` with the same determinant are joined by a path of linear isometries,
continuous in the operator-norm topology.

## Main results

* `TauCeti.Matrix.isClosed_orthogonalGroup` and `TauCeti.Matrix.isClosed_specialOrthogonalGroup`:
  the matrix orthogonal and special orthogonal groups are closed over any `T₁` topological
  commutative ring.
* `TauCeti.continuousOrthogonalBlockSucc`, `TauCeti.isClosedEmbedding_orthogonalBlockSucc`,
  `TauCeti.isClosedEmbedding_continuousOrthogonalBlockSucc`,
  `TauCeti.continuousSpecialOrthogonalBlockSucc`,
  `TauCeti.isClosedEmbedding_specialOrthogonalBlockSucc`,
  `TauCeti.isClosedEmbedding_continuousSpecialOrthogonalBlockSucc`: continuity and closed-embedding
  properties of the upper-left block inclusions `O(n) →ₜ* O(n + 1)` and `SO(n) →ₜ* SO(n + 1)`.
* `Matrix.specialOrthogonalReindexContinuousMulEquiv`: the topological group isomorphism
  `SO(m, k) ≃ₜ* SO(n, k)` induced by `e : m ≃ n`.
* `Matrix.specialOrthogonalGroup.continuous_toOrthogonalGroup`,
  `Matrix.specialOrthogonalGroup.isClosedEmbedding_toOrthogonalGroup`: `SO(n) → O(n)` is a
  continuous closed embedding.
* `TauCeti.continuous_orthogonalDetSign`: continuity of `TauCeti.orthogonalDetSign : O(n) →* ℤˣ`.
* `TauCeti.Matrix.instPathConnectedSpaceSpecialOrthogonalGroup`: the real special orthogonal
  group is path-connected.
* `TauCeti.Matrix.joined_orthogonalGroup_iff_det_eq`: two real orthogonal matrices are joined by
  a path of orthogonal matrices exactly when they have the same determinant.
* `TauCeti.Matrix.continuousOn_reflectionMatrix`: the reflection in a nonzero vector depends
  continuously on the vector.
* `TauCeti.sphereRotation`: for unit vectors `b` and `y ≠ -b` of `ℝᴺ`, the reflection in `b`
  followed by the reflection in `b + y`, a rotation taking `b` to `y`
  (`TauCeti.sphereRotation_mulVec`, `TauCeti.sphereRotation_smul`) that depends continuously
  on `y` (`TauCeti.continuousOn_sphereRotation`).
* `TauCeti.exists_path_linearIsometryEquiv_of_det_eq`: two linear isometries of Euclidean space
  with the same determinant are joined by an operator-norm-continuous path of linear isometries.

The closedness statements identify the topological input supplied by these carriers for later
constructions of Lie-group structures and continuity arguments on the corresponding subgroups.
-/

public section

namespace TauCeti.Matrix

variable {n R : Type*} [Fintype n] [DecidableEq n]
  [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]

attribute [local instance] starRingOfComm

local instance instContinuousStar {R : Type*} [CommSemiring R] [TopologicalSpace R] :
    ContinuousStar R := ⟨continuous_id⟩

/-- The matrix orthogonal group is closed in the entrywise matrix topology. -/
theorem isClosed_orthogonalGroup [T1Space R] :
    IsClosed (Matrix.orthogonalGroup n R : Set (Matrix n n R)) := by
  simpa only [Matrix.orthogonalGroup] using
    (isClosed_unitary (R := Matrix n n R))

/-- The matrix special orthogonal group is closed in the entrywise matrix topology. -/
theorem isClosed_specialOrthogonalGroup [T1Space R] :
    IsClosed (Matrix.specialOrthogonalGroup n R : Set (Matrix n n R)) := by
  simpa only [Matrix.specialOrthogonalGroup] using
    (TauCeti.Matrix.isClosed_specialUnitaryGroup (n := n) (𝕜 := R))

end TauCeti.Matrix

namespace Matrix.specialOrthogonalGroup

section Topology

attribute [local instance] starRingOfComm

/-- The canonical inclusion `SO(n, R) → O(n, R)` is continuous. -/
theorem continuous_toOrthogonalGroup {n R : Type*} [Fintype n] [DecidableEq n]
    [CommRing R] [TopologicalSpace R] :
    Continuous (toOrthogonalGroup (n := n) (R := R)) :=
  continuous_induced_rng.2 <|
    continuous_subtypeVal.congr fun A ↦ (coe_toOrthogonalGroup A).symm

/-- Over a `T₁` topological commutative ring, `SO(n, R) → O(n, R)` is a closed embedding. -/
theorem isClosedEmbedding_toOrthogonalGroup {n R : Type*} [Fintype n] [DecidableEq n]
    [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [T1Space R] :
    Topology.IsClosedEmbedding (toOrthogonalGroup (n := n) (R := R)) := by
  have hcoe : (Subtype.val ∘ toOrthogonalGroup (n := n) (R := R)) = Subtype.val :=
    funext coe_toOrthogonalGroup
  refine ⟨.of_comp continuous_toOrthogonalGroup continuous_subtypeVal (hcoe ▸ .subtypeVal), ?_⟩
  have hrange : Set.range (toOrthogonalGroup (n := n) (R := R)) =
      {A : orthogonalGroup n R | (A : Matrix n n R).det = 1} := by
    ext A
    exact ⟨fun ⟨B, hB⟩ ↦ by simpa [← hB, coe_toOrthogonalGroup] using
      (mem_specialOrthogonalGroup_iff.1 B.property).2,
      fun hdet ↦ ⟨⟨A, A.property, hdet⟩, Subtype.ext (coe_toOrthogonalGroup _)⟩⟩
  rw [hrange]
  exact isClosed_singleton.preimage continuous_subtypeVal.matrix_det

end Topology

end Matrix.specialOrthogonalGroup

namespace Matrix

section SpecialOrthogonalReindex

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]
  (k : Type*) [CommRing k] [TopologicalSpace k]

attribute [local instance] starRingOfComm

/-- Reindexing rows and columns along an equivalence `e : m ≃ n` induces an isomorphism of
topological groups between `Matrix.specialOrthogonalGroup m k` and
`Matrix.specialOrthogonalGroup n k`. -/
def specialOrthogonalReindexContinuousMulEquiv (e : m ≃ n) :
    Matrix.specialOrthogonalGroup m k ≃ₜ* Matrix.specialOrthogonalGroup n k :=
  let u := unitaryReindexContinuousMulEquiv k e
  { toFun A := ⟨(u ⟨A.val, A.property.1⟩ : Matrix n n k),
      (u ⟨A.val, A.property.1⟩).property,
      by simp [u, (Matrix.mem_specialOrthogonalGroup_iff.1 A.property).2]⟩
    invFun B := ⟨(u.symm ⟨B.val, B.property.1⟩ : Matrix m m k),
      (u.symm ⟨B.val, B.property.1⟩).property,
      by simp [u, (Matrix.mem_specialOrthogonalGroup_iff.1 B.property).2]⟩
    left_inv A := Subtype.ext <| by simp [u]
    right_inv B := Subtype.ext <| by simp [u]
    map_mul' A B := Subtype.ext <| by
      simpa using congrArg Subtype.val (map_mul u ⟨A.val, A.property.1⟩ ⟨B.val, B.property.1⟩)
    continuous_toFun := continuous_induced_rng.2 <|
      (continuous_subtypeVal.comp (map_continuous u)).comp
        (continuous_subtypeVal.subtype_mk fun A : Matrix.specialOrthogonalGroup m k ↦
          A.property.1)
    continuous_invFun := continuous_induced_rng.2 <|
      (continuous_subtypeVal.comp (map_continuous u.symm)).comp
        (continuous_subtypeVal.subtype_mk fun B : Matrix.specialOrthogonalGroup n k ↦
          B.property.1) }

variable {k} in
/-- The underlying matrix of `Matrix.specialOrthogonalReindexContinuousMulEquiv` is
`Matrix.reindex`. -/
@[simp]
theorem coe_specialOrthogonalReindexContinuousMulEquiv_apply (e : m ≃ n)
    (A : Matrix.specialOrthogonalGroup m k) :
    (specialOrthogonalReindexContinuousMulEquiv k e A : Matrix n n k) = reindex e e A.val := by
  simp [specialOrthogonalReindexContinuousMulEquiv]

end SpecialOrthogonalReindex

end Matrix

namespace TauCeti

section BlockSucc

attribute [local instance] starRingOfComm

private theorem isClosedEmbedding_blockSucc_subtype (k : Type*) [CommRing k]
    [TopologicalSpace k] [T1Space k] (n : ℕ)
    {P : Submonoid (_root_.Matrix (Fin n) (Fin n) k)}
    {Q : Submonoid (_root_.Matrix (Fin (n + 1)) (Fin (n + 1)) k)}
    (f : P → Q) (hf_cont : Continuous f)
    (hf_coe : ∀ A : P,
      (f A : _root_.Matrix (Fin (n + 1)) (Fin (n + 1)) k) = _root_.Matrix.blockSucc A.val)
    (hmem : ∀ M, _root_.Matrix.blockSucc M ∈ Q ↔ M ∈ P) :
    Topology.IsClosedEmbedding f := by
  have hcoe : (Subtype.val ∘ f) = _root_.Matrix.blockSucc ∘ Subtype.val := funext hf_coe
  refine ⟨.of_comp hf_cont continuous_subtypeVal
    (hcoe ▸ _root_.Matrix.isEmbedding_blockSucc.comp .subtypeVal), ?_⟩
  have hrange : Set.range f =
      Subtype.val ⁻¹' Set.range
        (_root_.Matrix.blockSucc : _root_.Matrix (Fin n) (Fin n) k → _) := by
    ext B
    refine ⟨?_, ?_⟩
    · rintro ⟨A, rfl⟩
      exact ⟨A.val, (hf_coe A).symm⟩
    · rintro ⟨M, hM⟩
      exact ⟨⟨M, (hmem M).mp (hM.symm ▸ B.property)⟩, Subtype.ext ((hf_coe _).trans hM)⟩
  rw [hrange]
  exact _root_.Matrix.isClosedEmbedding_blockSucc.isClosed_range.preimage continuous_subtypeVal

/-- The block inclusion `O(n, k) → O(n + 1, k)` is continuous. -/
theorem continuous_orthogonalBlockSucc (k : Type*) [CommRing k] [TopologicalSpace k] (n : ℕ) :
    Continuous (orthogonalBlockSucc k n) :=
  continuous_induced_rng.2 <|
    continuous_subtypeVal.matrix_blockSucc.congr fun A ↦ (coe_orthogonalBlockSucc k n A).symm

/-- Over a `T₁` space, the block inclusion `O(n, k) → O(n + 1, k)` is a closed embedding. -/
theorem isClosedEmbedding_orthogonalBlockSucc (k : Type*) [CommRing k] [TopologicalSpace k]
    [T1Space k] (n : ℕ) :
    Topology.IsClosedEmbedding (orthogonalBlockSucc k n) :=
  isClosedEmbedding_blockSucc_subtype k n (orthogonalBlockSucc k n)
    (continuous_orthogonalBlockSucc k n) (coe_orthogonalBlockSucc k n)
    fun _ ↦ _root_.Matrix.blockSucc_mem_orthogonalGroup_iff

/-- The orthogonal block inclusion as a continuous monoid homomorphism
`O(n, k) →ₜ* O(n + 1, k)`. -/
def continuousOrthogonalBlockSucc (k : Type*) [CommRing k] [TopologicalSpace k] (n : ℕ) :
    _root_.Matrix.orthogonalGroup (Fin n) k →ₜ* _root_.Matrix.orthogonalGroup (Fin (n + 1)) k where
  __ := orthogonalBlockSucc k n
  continuous_toFun := continuous_orthogonalBlockSucc k n

/-- Evaluating `TauCeti.continuousOrthogonalBlockSucc` agrees with `TauCeti.orthogonalBlockSucc`. -/
@[simp]
theorem continuousOrthogonalBlockSucc_apply (k : Type*) [CommRing k] [TopologicalSpace k] (n : ℕ)
    (A : _root_.Matrix.orthogonalGroup (Fin n) k) :
    continuousOrthogonalBlockSucc k n A = orthogonalBlockSucc k n A :=
  (rfl)

/-- Over a `T₁` space, `TauCeti.continuousOrthogonalBlockSucc` is a closed embedding. -/
theorem isClosedEmbedding_continuousOrthogonalBlockSucc (k : Type*) [CommRing k]
    [TopologicalSpace k] [T1Space k] (n : ℕ) :
    Topology.IsClosedEmbedding (continuousOrthogonalBlockSucc k n) :=
  (funext (continuousOrthogonalBlockSucc_apply k n) :
    (continuousOrthogonalBlockSucc k n : _ → _) = orthogonalBlockSucc k n) ▸
    isClosedEmbedding_orthogonalBlockSucc k n

/-- The block inclusion `SO(n, k) → SO(n + 1, k)` is continuous. -/
theorem continuous_specialOrthogonalBlockSucc (k : Type*) [CommRing k] [TopologicalSpace k]
    (n : ℕ) :
    Continuous (specialOrthogonalBlockSucc k n) :=
  continuous_induced_rng.2 <|
    continuous_subtypeVal.matrix_blockSucc.congr
      fun A ↦ (coe_specialOrthogonalBlockSucc k n A).symm

/-- Over a `T₁` space, the block inclusion `SO(n, k) → SO(n + 1, k)` is a closed embedding. -/
theorem isClosedEmbedding_specialOrthogonalBlockSucc (k : Type*) [CommRing k] [TopologicalSpace k]
    [T1Space k] (n : ℕ) :
    Topology.IsClosedEmbedding (specialOrthogonalBlockSucc k n) :=
  isClosedEmbedding_blockSucc_subtype k n (specialOrthogonalBlockSucc k n)
    (continuous_specialOrthogonalBlockSucc k n) (coe_specialOrthogonalBlockSucc k n)
    fun _ ↦ _root_.Matrix.blockSucc_mem_specialOrthogonalGroup_iff

/-- The special orthogonal block inclusion as a continuous monoid homomorphism
`SO(n, k) →ₜ* SO(n + 1, k)`. -/
def continuousSpecialOrthogonalBlockSucc (k : Type*) [CommRing k] [TopologicalSpace k]
    (n : ℕ) :
    _root_.Matrix.specialOrthogonalGroup (Fin n) k →ₜ*
      _root_.Matrix.specialOrthogonalGroup (Fin (n + 1)) k where
  __ := specialOrthogonalBlockSucc k n
  continuous_toFun := continuous_specialOrthogonalBlockSucc k n

/-- Evaluating `TauCeti.continuousSpecialOrthogonalBlockSucc` agrees with
`TauCeti.specialOrthogonalBlockSucc`. -/
@[simp]
theorem continuousSpecialOrthogonalBlockSucc_apply (k : Type*) [CommRing k] [TopologicalSpace k]
    (n : ℕ) (A : _root_.Matrix.specialOrthogonalGroup (Fin n) k) :
    continuousSpecialOrthogonalBlockSucc k n A = specialOrthogonalBlockSucc k n A :=
  (rfl)

/-- Over a `T₁` space, `TauCeti.continuousSpecialOrthogonalBlockSucc` is a closed embedding. -/
theorem isClosedEmbedding_continuousSpecialOrthogonalBlockSucc (k : Type*) [CommRing k]
    [TopologicalSpace k] [T1Space k] (n : ℕ) :
    Topology.IsClosedEmbedding (continuousSpecialOrthogonalBlockSucc k n) :=
  (funext (continuousSpecialOrthogonalBlockSucc_apply k n) :
    (continuousSpecialOrthogonalBlockSucc k n : _ → _) = specialOrthogonalBlockSucc k n) ▸
    isClosedEmbedding_specialOrthogonalBlockSucc k n

end BlockSucc

section DetSign

open Classical in
/-- Over a `T₁` topological commutative ring without zero divisors, `TauCeti.orthogonalDetSign` is
continuous into `ℤˣ` (with the discrete topology). -/
theorem continuous_orthogonalDetSign {n R : Type*} [Fintype n] [DecidableEq n] [CommRing R]
    [NoZeroDivisors R] [TopologicalSpace R] [IsTopologicalRing R] [T1Space R] :
    Continuous (orthogonalDetSign n R) := by
  refine Continuous.congr ?_ fun A ↦ (orthogonalDetSign_apply A).symm
  refine Continuous.if ?_ continuous_const continuous_const
  intro A hA
  have hdet : Continuous fun B : _root_.Matrix.orthogonalGroup n R ↦
      (B : _root_.Matrix n n R).det :=
    continuous_subtypeVal.matrix_det
  have hclosed1 : IsClosed {B : _root_.Matrix.orthogonalGroup n R |
      (B : _root_.Matrix n n R).det = 1} :=
    isClosed_singleton.preimage hdet
  have hopen1 : IsOpen {B : _root_.Matrix.orthogonalGroup n R |
      (B : _root_.Matrix n n R).det = 1} := by
    rw [← isClosed_compl_iff]
    by_cases h1 : (-1 : R) = 1
    · have hc : {B : _root_.Matrix.orthogonalGroup n R |
          (B : _root_.Matrix n n R).det = 1}ᶜ = ∅ := by
        ext B
        rcases det_eq_one_or_neg_one_of_mem_orthogonalGroup B.property with hB | hB <;>
          simp [hB, h1]
      rw [hc]
      exact isClosed_empty
    · have hc : {B : _root_.Matrix.orthogonalGroup n R |
          (B : _root_.Matrix n n R).det = 1}ᶜ =
          {B : _root_.Matrix.orthogonalGroup n R | (B : _root_.Matrix n n R).det = -1} := by
        ext B
        rcases det_eq_one_or_neg_one_of_mem_orthogonalGroup B.property with hB | hB <;>
          simp [hB, h1, Ne.symm h1]
      rw [hc]
      exact isClosed_singleton.preimage hdet
  rw [IsClopen.frontier_eq ⟨hclosed1, hopen1⟩] at hA
  exact hA.elim

end DetSign

end TauCeti

-- Reopened over `ℝ` without the local `starRingOfComm` instance of the section above.
namespace TauCeti.Matrix

open _root_.Matrix unitInterval

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-! ### Path components of the real orthogonal group -/

/-- The matrix of the reflection of `ι → ℝ` in the hyperplane orthogonal to `u`, with the
normalizing scalar `2 / (u ⬝ᵥ u)`. -/
private noncomputable def refl (u : ι → ℝ) : _root_.Matrix ι ι ℝ :=
  TauCeti.reflectionMatrix u (2 / (u ⬝ᵥ u))

omit [DecidableEq ι] in
private lemma refl_hc {u : ι → ℝ} (hu : u ≠ 0) : 2 / (u ⬝ᵥ u) * (u ⬝ᵥ u) = 2 :=
  div_mul_cancel₀ _ (mt dotProduct_self_eq_zero.1 hu)

/-- The reflection in a nonzero vector only depends on the line it spans. -/
private lemma refl_smul {u : ι → ℝ} (hu : u ≠ 0) {c : ℝ} (hc : c ≠ 0) :
    refl (c • u) = refl u := by
  have huu : u ⬝ᵥ u ≠ 0 := mt dotProduct_self_eq_zero.1 hu
  have h : c • u = fun i ↦ c * u i := funext fun i ↦ Pi.smul_apply c u i
  rw [refl, refl, h, TauCeti.reflectionMatrix_smul]
  congr 1
  simp only [← h, dotProduct_smul, smul_dotProduct, smul_eq_mul]
  field_simp

private lemma refl_mul_refl_mem {u w : ι → ℝ} (hu : u ≠ 0) (hw : w ≠ 0) :
    refl u * refl w ∈ specialOrthogonalGroup ι ℝ := by
  rw [mem_specialOrthogonalGroup_iff]
  refine ⟨mul_mem (TauCeti.reflectionMatrix_mem_orthogonalGroup (refl_hc hu))
    (TauCeti.reflectionMatrix_mem_orthogonalGroup (refl_hc hw)), ?_⟩
  rw [det_mul, refl, refl, TauCeti.det_reflectionMatrix (refl_hc hu),
    TauCeti.det_reflectionMatrix (refl_hc hw)]
  norm_num

/-- The reflection matrix `u ↦ 1 - (2 / (u ⬝ᵥ u)) • vecMulVec u u` in the hyperplane orthogonal to
`u` depends continuously on the nonzero vector `u`. -/
theorem continuousOn_reflectionMatrix :
    ContinuousOn (fun u : ι → ℝ ↦ TauCeti.reflectionMatrix u (2 / (u ⬝ᵥ u))) {u | u ≠ 0} := by
  simp only [TauCeti.reflectionMatrix_eq_one_sub_vecMulVec]
  have hc : ContinuousOn (fun u : ι → ℝ ↦ (2 / (u ⬝ᵥ u)) • u) {u | u ≠ 0} :=
    (continuousOn_const.div (continuous_id.dotProduct continuous_id).continuousOn
      fun u hu ↦ mt dotProduct_self_eq_zero.1 hu).smul continuousOn_id
  exact continuousOn_const.sub ((continuous_fst.matrix_vecMulVec continuous_snd).comp_continuousOn
    (hc.prodMk continuousOn_id))

/-- A product of two reflections in nonzero vectors is joined to the identity in the special
orthogonal group. -/
private lemma joined_one_refl_mul_refl {u w : ι → ℝ} (hu : u ≠ 0) (hw : w ≠ 0) :
    Joined (1 : specialOrthogonalGroup ι ℝ) ⟨refl u * refl w, refl_mul_refl_mem hu hw⟩ := by
  by_cases hlin : ∃ c : ℝ, w = c • u
  · obtain ⟨c, rfl⟩ := hlin
    have hc : c ≠ 0 := by rintro rfl; simp at hw
    have : (⟨refl u * refl (c • u), refl_mul_refl_mem hu hw⟩ : specialOrthogonalGroup ι ℝ) = 1 :=
      Subtype.ext <| (congrArg (refl u * ·) (refl_smul hu hc)).trans
        (TauCeti.reflectionMatrix_mul_self (refl_hc hu))
    rw [this]
  push Not at hlin
  -- The segment from `w` to `u` avoids the origin.
  have hσ : ∀ t : I, (1 - (t : ℝ)) • w + (t : ℝ) • u ≠ 0 := by
    intro t ht
    have ht1 : 1 - (t : ℝ) ≠ 0 := by
      intro h
      have h1 : (t : ℝ) = 1 := by linarith
      simp [h1, hu] at ht
    apply hlin (-((t : ℝ) / (1 - t)))
    ext i
    have hi := congrFun ht i
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hi ⊢
    field_simp
    linear_combination hi
  have hcont : Continuous fun t : I ↦ refl ((1 - (t : ℝ)) • w + (t : ℝ) • u) :=
    continuousOn_reflectionMatrix.comp_continuous (by fun_prop) hσ
  refine ⟨{
    toFun := fun t ↦ ⟨refl u * refl ((1 - (σ t : ℝ)) • w + (σ t : ℝ) • u),
      refl_mul_refl_mem hu (hσ (σ t))⟩
    continuous_toFun := (continuous_const.mul (hcont.comp continuous_symm)).subtype_mk _
    source' := ?_
    target' := ?_ }⟩
  · apply Subtype.ext
    simp [refl, TauCeti.reflectionMatrix_mul_self (refl_hc hu)]
  · apply Subtype.ext
    simp

/-- **The real special orthogonal group is path-connected.** -/
instance instPathConnectedSpaceSpecialOrthogonalGroup :
    PathConnectedSpace (specialOrthogonalGroup ι ℝ) := by
  refine ⟨⟨1⟩, fun A B ↦ ?_⟩
  suffices h : ∀ A : specialOrthogonalGroup ι ℝ, Joined 1 A from (h A).symm.trans (h B)
  intro A
  -- The matrices joined to the identity form a submonoid containing the products of two
  -- reflections, which generate the special orthogonal group.
  let P : Submonoid (_root_.Matrix ι ι ℝ) :=
    (Submonoid.pathComponentOne (specialOrthogonalGroup ι ℝ)).map
      (specialOrthogonalGroup ι ℝ).subtype
  have hle : specialOrthogonalGroup ι ℝ ≤ P := by
    rw [← TauCeti.closure_reflection_mul_eq_matrixSpecialOrthogonalGroup, Submonoid.closure_le]
    rintro _ ⟨u, w, hu, hw, rfl⟩
    have hu0 : u ≠ 0 := by
      rintro rfl
      exact Invertible.ne_zero _ (toQuadraticForm' (1 : _root_.Matrix ι ι ℝ)).map_zero
    have hw0 : w ≠ 0 := by
      rintro rfl
      exact Invertible.ne_zero _ (toQuadraticForm' (1 : _root_.Matrix ι ι ℝ)).map_zero
    refine ⟨⟨refl u * refl w, refl_mul_refl_mem hu0 hw0⟩,
      mem_pathComponent_iff.2 (joined_one_refl_mul_refl hu0 hw0), ?_⟩
    simp only [Submonoid.coe_subtype, refl, TauCeti.toMatrix'_reflection, toQuadraticForm'_apply,
      one_mulVec, invOf_eq_inv, div_eq_mul_inv]
  obtain ⟨B, hB, hBA⟩ := hle A.property
  obtain rfl : B = A := Subtype.ext hBA
  exact mem_pathComponent_iff.1 hB

/-- **The path components of the real orthogonal group.** Two orthogonal matrices are joined by a
path of orthogonal matrices exactly when they have the same determinant. -/
theorem joined_orthogonalGroup_iff_det_eq {A B : orthogonalGroup ι ℝ} :
    Joined A B ↔ (A : _root_.Matrix ι ι ℝ).det = (B : _root_.Matrix ι ι ℝ).det := by
  constructor
  · -- The determinant along a path takes only the values `±1`, so it cannot change sign.
    rintro ⟨γ⟩
    have hc : Continuous fun t ↦ ((γ t : orthogonalGroup ι ℝ) : _root_.Matrix ι ι ℝ).det :=
      (continuous_subtypeVal.comp γ.continuous).matrix_det
    have h0 : ∀ t, ((γ t : orthogonalGroup ι ℝ) : _root_.Matrix ι ι ℝ).det ≠ 0 := fun t ↦ by
      rcases det_eq_one_or_neg_one_of_mem_orthogonalGroup (γ t).property with h | h <;> simp [h]
    rcases det_eq_one_or_neg_one_of_mem_orthogonalGroup A.property with hA | hA <;>
      rcases det_eq_one_or_neg_one_of_mem_orthogonalGroup B.property with hB | hB
    · rw [hA, hB]
    · obtain ⟨t, ht⟩ := intermediate_value_univ 1 0 hc (show (0 : ℝ) ∈ _ by simp [hA, hB])
      exact (h0 t ht).elim
    · obtain ⟨t, ht⟩ := intermediate_value_univ 0 1 hc (show (0 : ℝ) ∈ _ by simp [hA, hB])
      exact (h0 t ht).elim
    · rw [hA, hB]
  · -- `A⁻¹ * B` is special orthogonal, hence joined to the identity.
    intro h
    have hdet : ((A⁻¹ * B : orthogonalGroup ι ℝ) : _root_.Matrix ι ι ℝ).det = 1 := by
      simpa [star_eq_conjTranspose, det_conjTranspose, det_mul, h] using
        congrArg det ((mem_orthogonalGroup_iff' _ _).1 A.property)
    let C : specialOrthogonalGroup ι ℝ := ⟨A⁻¹ * B, (A⁻¹ * B).property, hdet⟩
    have hC : Joined (1 : orthogonalGroup ι ℝ) (A⁻¹ * B) :=
      (PathConnectedSpace.joined 1 C).map (f := fun D : specialOrthogonalGroup ι ℝ ↦
        (⟨D, D.property.1⟩ : orthogonalGroup ι ℝ)) (continuous_subtypeVal.subtype_mk _)
    simpa using (Joined.refl A).mul hC

end TauCeti.Matrix

/-! ### Rotations taking one unit vector to another -/

namespace TauCeti

section Rotation

open _root_.Matrix Metric

variable {N : ℕ}

/-- The rotation taking a unit vector `b` to a unit vector `y ≠ -b`: the reflection in `b`
followed by the reflection in `b + y`. For `y = -b` it is defined to be the identity, which does
not take `b` to `-b`. -/
noncomputable def sphereRotation (b y : sphere (0 : EuclideanSpace ℝ (Fin N)) 1) :
    specialOrthogonalGroup (Fin N) ℝ :=
  if h : y = -b then 1 else
    reflectionPair (WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))))
      (WithLp.ofLp (b : EuclideanSpace ℝ (Fin N)))
      (2 / (WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))) ⬝ᵥ
        WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))))) 2
      (div_mul_cancel₀ _ <| by
        rw [EuclideanSpace.dotProduct_ofLp_self]
        exact pow_ne_zero 2 (norm_ne_zero_iff.2 (coe_add_coe_ne_zero h)))
      (by rw [EuclideanSpace.dotProduct_ofLp_self, norm_eq_of_mem_sphere]; norm_num)

/-- At the antipode `-b`, `sphereRotation b (-b)` is defined to be the identity as a fallback; it
does not take `b` to `-b`. -/
@[simp]
theorem sphereRotation_neg_self (b : sphere (0 : EuclideanSpace ℝ (Fin N)) 1) :
    sphereRotation b (-b) = 1 := by
  simp [sphereRotation]

/-- Away from the antipode of `b`, `sphereRotation b y` is the product of the reflections in
`b + y` and in `b`. -/
theorem coe_sphereRotation_of_ne {b y : sphere (0 : EuclideanSpace ℝ (Fin N)) 1} (h : y ≠ -b) :
    (sphereRotation b y : Matrix (Fin N) (Fin N) ℝ) =
      reflectionMatrix
          (WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))))
          (2 / (WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))) ⬝ᵥ
            WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))))) *
        reflectionMatrix (WithLp.ofLp (b : EuclideanSpace ℝ (Fin N))) 2 := by
  simp only [sphereRotation, h, ↓reduceDIte, coe_reflectionPair]

/-- The rotation `sphereRotation b y` takes `b` to `y` when `y ≠ -b`. -/
theorem sphereRotation_mulVec {b y : sphere (0 : EuclideanSpace ℝ (Fin N)) 1} (h : y ≠ -b) :
    (sphereRotation b y : Matrix (Fin N) (Fin N) ℝ) *ᵥ WithLp.ofLp (b : EuclideanSpace ℝ (Fin N)) =
      WithLp.ofLp (y : EuclideanSpace ℝ (Fin N)) := by
  have hunit (x : sphere (0 : EuclideanSpace ℝ (Fin N)) 1) :
      WithLp.ofLp (x : EuclideanSpace ℝ (Fin N)) ⬝ᵥ WithLp.ofLp (x : EuclideanSpace ℝ (Fin N)) =
        1 := by
    rw [EuclideanSpace.dotProduct_ofLp_self, norm_eq_of_mem_sphere, one_pow]
  have hv : WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))) ⬝ᵥ
      WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))) ≠ 0 := by
    rw [EuclideanSpace.dotProduct_ofLp_self]
    exact pow_ne_zero 2 (norm_ne_zero_iff.2 (coe_add_coe_ne_zero h))
  rw [coe_sphereRotation_of_ne h, ← mulVec_mulVec]
  rw [WithLp.ofLp_add] at hv ⊢
  exact reflectionMatrix_add_mulVec_reflectionMatrix_mulVec (hunit b) (hunit y) hv

/-- The rotation `sphereRotation b y` takes `b` to `y` when `y ≠ -b`, acting on the unit
sphere. -/
theorem sphereRotation_smul {b y : sphere (0 : EuclideanSpace ℝ (Fin N)) 1} (h : y ≠ -b) :
    sphereRotation b y • b = y :=
  Subtype.ext (by
    rw [coe_specialUnitaryGroup_smul_unitSphere, sphereRotation_mulVec h, WithLp.toLp_ofLp])

/-- The rotation `sphereRotation b y` depends continuously on `y` away from `-b`. -/
theorem continuousOn_sphereRotation (b : sphere (0 : EuclideanSpace ℝ (Fin N)) 1) :
    ContinuousOn (sphereRotation b) {-b}ᶜ := by
  rw [Topology.IsInducing.subtypeVal.continuousOn_iff]
  have hv : Continuous fun y : sphere (0 : EuclideanSpace ℝ (Fin N)) 1 ↦
      WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))) := by fun_prop
  have hR : ContinuousOn (fun y : sphere (0 : EuclideanSpace ℝ (Fin N)) 1 ↦
      reflectionMatrix
        (WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))))
        (2 / (WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))) ⬝ᵥ
          WithLp.ofLp ((b : EuclideanSpace ℝ (Fin N)) + (y : EuclideanSpace ℝ (Fin N))))))
      {-b}ᶜ :=
    TauCeti.Matrix.continuousOn_reflectionMatrix.comp hv.continuousOn fun y hy h0 ↦
      coe_add_coe_ne_zero hy (by simpa using congrArg (WithLp.toLp 2) h0)
  have hM := (continuous_id.matrix_mul (continuous_const
    (y := reflectionMatrix (WithLp.ofLp (b : EuclideanSpace ℝ (Fin N))) 2))).comp_continuousOn hR
  exact hM.congr fun y hy ↦ coe_sphereRotation_of_ne hy

end Rotation

/-! ### Paths of linear isometries -/

open unitInterval

variable {ι : Type*} [Fintype ι]

/-- **Linear isometries of Euclidean space with the same determinant are joined by a path.** Two
linear isometries `g` and `g'` of `EuclideanSpace ℝ ι` with the same determinant are joined by a
path of linear isometries, continuous in the operator-norm topology. -/
theorem exists_path_linearIsometryEquiv_of_det_eq
    {g g' : EuclideanSpace ℝ ι ≃ₗᵢ[ℝ] EuclideanSpace ℝ ι}
    (h : LinearMap.det g.toLinearMap = LinearMap.det g'.toLinearMap) :
    ∃ γ : I → (EuclideanSpace ℝ ι ≃ₗᵢ[ℝ] EuclideanSpace ℝ ι),
      Continuous (fun t ↦ ((γ t).toContinuousLinearEquiv :
        EuclideanSpace ℝ ι →L[ℝ] EuclideanSpace ℝ ι)) ∧
      γ 0 = g ∧ γ 1 = g' := by
  classical
  obtain ⟨A, rfl⟩ := Matrix.UnitaryGroup.toLinearIsometryEquiv.surjective g
  obtain ⟨B, rfl⟩ := Matrix.UnitaryGroup.toLinearIsometryEquiv.surjective g'
  have hAB : (A : _root_.Matrix ι ι ℝ).det = (B : _root_.Matrix ι ι ℝ).det := by
    rw [← Matrix.UnitaryGroup.det_toLinearIsometryEquiv,
      ← Matrix.UnitaryGroup.det_toLinearIsometryEquiv]
    exact h
  obtain ⟨p⟩ := Matrix.joined_orthogonalGroup_iff_det_eq.2 hAB
  exact ⟨fun t ↦ Matrix.UnitaryGroup.toLinearIsometryEquiv (p t),
    Matrix.UnitaryGroup.continuous_toLinearIsometryEquiv.comp p.continuous,
    congrArg Matrix.UnitaryGroup.toLinearIsometryEquiv p.source,
    congrArg Matrix.UnitaryGroup.toLinearIsometryEquiv p.target⟩

end TauCeti
