module

public import Mathlib.Topology.Algebra.NonUnitalStarAlgebra
public import TauCeti.Algebra.Star.Subalgebra
public import TauCeti.Topology.Algebra.Ring.TwoSidedIdeal

/-!
# Topological closures of nonunital star subalgebras, self-adjoint cores, and generated ideals

This file provides topological closure and closed-ideal operations associated to nonunital
`⋆`-subalgebras and left-absorbing submodules:

* `NonUnitalStarSubalgebra.topologicalClosure_coe`: identifies the underlying set of
  `s.topologicalClosure` with `closure (s : Set A)`, matching
  `StarSubalgebra.topologicalClosure_coe`.
* `Submodule.isClosed_starCore`: if a left-absorbing submodule `L` is closed and `star` is
  continuous, its self-adjoint core `L.starCore hL` is closed.
* `NonUnitalStarSubalgebra.isClosed_comap_subtype`: restricting a closed two-sided ideal `J` of `A`
  to `B` gives a closed two-sided ideal of `B`.
* `NonUnitalStarSubalgebra.closedIdeal` and `NonUnitalStarSubalgebra.extendIdeal`: the closed
  two-sided ideal of `A` generated by `B` or by the image of a two-sided ideal `K` of `B`, together
  with their closure universal properties and monotonicity.
-/

public section

namespace Submodule

variable {R A : Type*} [CommSemiring R] [Star R] [NonUnitalSemiring A] [StarRing A]
  [Module R A] [StarModule R A] [TopologicalSpace A] [ContinuousStar A]

/-- If a left-absorbing submodule `L` is closed, its self-adjoint core `L.starCore hL` is closed. -/
instance isClosed_starCore (L : Submodule R A) (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L)
    [hLc : IsClosed (L : Set A)] : IsClosed (L.starCore hL : Set A) := by
  rw [coe_starCore]
  exact hLc.inter (hLc.preimage continuous_star)

end Submodule

namespace NonUnitalStarSubalgebra

section TopologicalClosure

variable {R A : Type*} [CommSemiring R] [TopologicalSpace A] [Star A]
  [NonUnitalSemiring A] [Module R A] [ContinuousStar A]
  [ContinuousConstSMul R A] [IsSemitopologicalSemiring A]

/-- Coercing `s.topologicalClosure` to `Set A` gives the topological closure
`closure (s : Set A)`. -/
@[simp]
theorem topologicalClosure_coe (s : NonUnitalStarSubalgebra R A) :
    (s.topologicalClosure : Set A) = _root_.closure (s : Set A) :=
  (rfl)

end TopologicalClosure

section ClosedIdeal

variable {R A : Type*} [CommRing R] [NonUnitalRing A] [Module R A] [Star A]
  [TopologicalSpace A]

/-- Restricting a closed two-sided ideal `J` of `A` to `B` yields a closed two-sided ideal of `B`.
-/
instance isClosed_comap_subtype (B : NonUnitalStarSubalgebra R A) (J : TwoSidedIdeal A)
    [hJ : IsClosed (J : Set A)] :
    IsClosed ((J.comap (NonUnitalStarSubalgebraClass.subtype B) : TwoSidedIdeal B) : Set B) :=
  hJ.preimage continuous_subtype_val

variable [IsTopologicalRing A]

/-- The closed two-sided ideal of `A` generated by a nonunital `⋆`-subalgebra `B`. -/
def closedIdeal (B : NonUnitalStarSubalgebra R A) : TwoSidedIdeal A :=
  (TwoSidedIdeal.span (B : Set A)).topologicalClosure

theorem closedIdeal_def (B : NonUnitalStarSubalgebra R A) :
    B.closedIdeal = (TwoSidedIdeal.span (B : Set A)).topologicalClosure :=
  (rfl)

/-- `B.closedIdeal` is closed in `A`. -/
instance isClosed_closedIdeal (B : NonUnitalStarSubalgebra R A) :
    IsClosed (B.closedIdeal : Set A) :=
  TwoSidedIdeal.isClosed_topologicalClosure _

/-- Every element of `B` belongs to `B.closedIdeal`. -/
theorem mem_closedIdeal_of_mem (B : NonUnitalStarSubalgebra R A) {b : A} (hb : b ∈ B) :
    b ∈ B.closedIdeal :=
  TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span hb)

/-- The underlying set of `B` is contained in `B.closedIdeal`. -/
theorem subset_closedIdeal (B : NonUnitalStarSubalgebra R A) :
    (B : Set A) ⊆ B.closedIdeal :=
  fun _ ↦ B.mem_closedIdeal_of_mem

/-- `B.closedIdeal` is monotone with respect to inclusion of `⋆`-subalgebras. -/
theorem closedIdeal_mono {B₁ B₂ : NonUnitalStarSubalgebra R A} (h : B₁ ≤ B₂) :
    B₁.closedIdeal ≤ B₂.closedIdeal :=
  TwoSidedIdeal.topologicalClosure_mono (TwoSidedIdeal.span_mono h)

/-- `B.closedIdeal` is the smallest closed two-sided ideal of `A` containing `B`. -/
theorem closedIdeal_le_iff (B : NonUnitalStarSubalgebra R A) (J : TwoSidedIdeal A)
    [hJ : IsClosed (J : Set A)] : B.closedIdeal ≤ J ↔ (B : Set A) ⊆ J :=
  (TwoSidedIdeal.topologicalClosure_le_iff _ J hJ).trans TwoSidedIdeal.span_le

/-- Extending a two-sided ideal `K` of `B` to the closed two-sided ideal of `A` generated by the
image of `K` in `A`. -/
def extendIdeal (B : NonUnitalStarSubalgebra R A) (K : TwoSidedIdeal B) : TwoSidedIdeal A :=
  (K.map (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure

theorem extendIdeal_def (B : NonUnitalStarSubalgebra R A) (K : TwoSidedIdeal B) :
    B.extendIdeal K = (K.map (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure :=
  (rfl)

/-- `B.extendIdeal K` is closed in `A`. -/
instance isClosed_extendIdeal (B : NonUnitalStarSubalgebra R A) (K : TwoSidedIdeal B) :
    IsClosed (B.extendIdeal K : Set A) :=
  TwoSidedIdeal.isClosed_topologicalClosure _

/-- Every element of `K` coerced to `A` lies in `B.extendIdeal K`. -/
theorem coe_mem_extendIdeal (B : NonUnitalStarSubalgebra R A) (K : TwoSidedIdeal B) {k : B}
    (hk : k ∈ K) : (k : A) ∈ B.extendIdeal K :=
  TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span ⟨k, hk, rfl⟩)

/-- For a closed two-sided ideal `J` of `A`, `B.extendIdeal K ≤ J` if and only if `K` is contained
in the restriction of `J` to `B`. -/
theorem extendIdeal_le_iff (B : NonUnitalStarSubalgebra R A) (K : TwoSidedIdeal B)
    (J : TwoSidedIdeal A) [hJ : IsClosed (J : Set A)] :
    B.extendIdeal K ≤ J ↔ K ≤ J.comap (NonUnitalStarSubalgebraClass.subtype B) := by
  rw [extendIdeal_def, TwoSidedIdeal.topologicalClosure_le_iff _ J hJ, TwoSidedIdeal.map,
    TwoSidedIdeal.span_le]
  refine ⟨fun h b hb ↦ (TwoSidedIdeal.mem_comap _).mpr (h ⟨b, hb, rfl⟩), ?_⟩
  rintro h _ ⟨b, hb, rfl⟩
  exact (TwoSidedIdeal.mem_comap (NonUnitalStarSubalgebraClass.subtype B)).mp (h hb)

/-- `B.extendIdeal` is monotone with respect to inclusion of ideals in `B`. -/
theorem extendIdeal_mono (B : NonUnitalStarSubalgebra R A) {K₁ K₂ : TwoSidedIdeal B}
    (h : K₁ ≤ K₂) : B.extendIdeal K₁ ≤ B.extendIdeal K₂ :=
  TwoSidedIdeal.topologicalClosure_mono (TwoSidedIdeal.map_mono _ h)

/-- For every two-sided ideal `K` of `B`, `B.extendIdeal K ≤ B.closedIdeal`. -/
theorem extendIdeal_le_closedIdeal (B : NonUnitalStarSubalgebra R A) (K : TwoSidedIdeal B) :
    B.extendIdeal K ≤ B.closedIdeal := by
  refine TwoSidedIdeal.topologicalClosure_mono (TwoSidedIdeal.span_mono ?_)
  rintro _ ⟨b, -, rfl⟩
  exact b.2

/-- Extending the whole two-sided ideal `⊤` of `B` yields `B.closedIdeal`. -/
@[simp]
theorem extendIdeal_top (B : NonUnitalStarSubalgebra R A) :
    B.extendIdeal ⊤ = B.closedIdeal := by
  rw [extendIdeal_def, closedIdeal_def, TwoSidedIdeal.map]
  congr 2
  ext x
  simp

end ClosedIdeal

end NonUnitalStarSubalgebra
