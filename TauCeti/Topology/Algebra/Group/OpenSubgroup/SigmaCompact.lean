module

public import Mathlib.Topology.Algebra.OpenSubgroup
public import Mathlib.Topology.Compactness.SigmaCompact
import Mathlib.Algebra.Group.Subgroup.Lattice
import TauCeti.Topology.Algebra.Group.SigmaCompact

/-!
# σ-compact open subgroups of locally compact groups

In a locally compact group every σ-compact set `s` lies in a σ-compact open subgroup. Choose a
compact identity neighbourhood `V` and take the subgroup generated by `s ∪ V`. It is open because
it contains `V`, and it is σ-compact because the subgroup generated by a σ-compact set is
σ-compact (`IsSigmaCompact.subgroupClosure`).

For the same reason, the join `H₁ ⊔ H₂` of two σ-compact open subgroups is σ-compact without any
local compactness assumption, and in a locally compact group any σ-compact set together with
countably many σ-compact open subgroups lies in a single σ-compact open subgroup.

A locally compact group need not be σ-compact, but this lets an argument involving countably many
σ-compact sets, for instance the supports of countably many integrable functions for a Haar
measure, take place inside a σ-compact open subgroup, on which a Haar measure is σ-finite, and
allows two such subgroup choices to be compared inside their join.

## Main results

* `IsSigmaCompact.exists_openSubgroup`: a σ-compact subset of a locally compact group is contained
  in a σ-compact open subgroup, with additive version `IsSigmaCompact.exists_openAddSubgroup`.
* `OpenSubgroup.isSigmaCompact_sup`: the join of two σ-compact open subgroups of a topological
  group is σ-compact, with additive version `OpenAddSubgroup.isSigmaCompact_sup`.
* `IsSigmaCompact.exists_openSubgroup_le` and `OpenSubgroup.exists_isSigmaCompact_le`: a σ-compact
  set and countably many σ-compact open subgroups of a locally compact group lie in a single
  σ-compact open subgroup.
* `IsTopologicalGroup.sigmaCompactSpace_of_preconnected`: a preconnected locally compact group
  is σ-compact.

## References

* E. Hewitt, K. A. Ross, *Abstract Harmonic Analysis I*, 2nd ed., Springer (1979), Theorem 5.7.
* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Springer GTM 218 (2013),
  Proposition 7.14, pp.156–157.
-/

public section

open Set

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- **σ-compact open subgroups.** In a locally compact group, every σ-compact set is contained in
a σ-compact open subgroup. -/
@[to_additive /-- **σ-compact open subgroups.** In a locally compact additive group, every
σ-compact set is contained in a σ-compact open subgroup. -/]
theorem IsSigmaCompact.exists_openSubgroup [WeaklyLocallyCompactSpace G] {s : Set G}
    (hs : IsSigmaCompact s) : ∃ H : OpenSubgroup G, s ⊆ H ∧ IsSigmaCompact (H : Set G) := by
  obtain ⟨V, hV, hV1⟩ := exists_compact_mem_nhds (1 : G)
  set H := Subgroup.closure (s ∪ V)
  have hsV : s ∪ V ⊆ H := Subgroup.subset_closure
  refine ⟨⟨H, H.isOpen_of_mem_nhds (Filter.mem_of_superset hV1 (subset_union_right.trans hsV))⟩,
    subset_union_left.trans hsV, ?_⟩
  exact (hs.union hV.isSigmaCompact).subgroupClosure

/-- The join `H₁ ⊔ H₂` of two σ-compact open subgroups of a topological group is σ-compact. No
local compactness assumption on `G` is required. -/
@[to_additive /-- The join `H₁ ⊔ H₂` of two σ-compact open additive subgroups of a topological
additive group is σ-compact. No local compactness assumption on `G` is required. -/]
theorem OpenSubgroup.isSigmaCompact_sup {H₁ H₂ : OpenSubgroup G}
    (h₁ : IsSigmaCompact (H₁ : Set G)) (h₂ : IsSigmaCompact (H₂ : Set G)) :
    IsSigmaCompact ((H₁ ⊔ H₂ : OpenSubgroup G) : Set G) := by
  rw [← OpenSubgroup.coe_toSubgroup, OpenSubgroup.toSubgroup_sup, Subgroup.sup_eq_closure]
  exact (h₁.union h₂).subgroupClosure

/-- In a locally compact group, a σ-compact set and countably many σ-compact open subgroups are
simultaneously contained in a single σ-compact open subgroup. -/
@[to_additive /-- In a locally compact additive group, a σ-compact set and countably many
σ-compact open additive subgroups are simultaneously contained in a single σ-compact open additive
subgroup. -/]
theorem IsSigmaCompact.exists_openSubgroup_le [WeaklyLocallyCompactSpace G] {ι : Type*}
    [Countable ι] {s : Set G} (hs : IsSigmaCompact s) {H : ι → OpenSubgroup G}
    (hH : ∀ i, IsSigmaCompact (H i : Set G)) :
    ∃ U : OpenSubgroup G, s ⊆ U ∧ (∀ i, H i ≤ U) ∧ IsSigmaCompact (U : Set G) := by
  obtain ⟨U, hsU, hU⟩ := (hs.union (isSigmaCompact_iUnion _ hH)).exists_openSubgroup
  exact ⟨U, subset_union_left.trans hsU,
    fun i ↦ (subset_iUnion (fun j ↦ (H j : Set G)) i).trans (subset_union_right.trans hsU), hU⟩

/-- Countably many σ-compact open subgroups of a locally compact group are contained in a single
σ-compact open subgroup. -/
@[to_additive /-- Countably many σ-compact open additive subgroups of a locally compact additive
group are contained in a single σ-compact open additive subgroup. -/]
theorem OpenSubgroup.exists_isSigmaCompact_le [WeaklyLocallyCompactSpace G] {ι : Type*}
    [Countable ι] {H : ι → OpenSubgroup G} (hH : ∀ i, IsSigmaCompact (H i : Set G)) :
    ∃ U : OpenSubgroup G, (∀ i, H i ≤ U) ∧ IsSigmaCompact (U : Set G) := by
  obtain ⟨U, -, hHU, hU⟩ := isSigmaCompact_empty.exists_openSubgroup_le hH
  exact ⟨U, hHU, hU⟩

/-- A preconnected locally compact topological group is σ-compact. -/
@[to_additive /-- A preconnected locally compact topological additive group is σ-compact. -/]
theorem IsTopologicalGroup.sigmaCompactSpace_of_preconnected
    [WeaklyLocallyCompactSpace G] [PreconnectedSpace G] : SigmaCompactSpace G := by
  obtain ⟨U, _, hU⟩ := (isSigmaCompact_empty (X := G)).exists_openSubgroup
  have hfull : (U : Set G) = univ := U.isClopen.eq_univ ⟨1, U.one_mem⟩
  rw [hfull] at hU
  exact isSigmaCompact_univ_iff.mp hU
