module

public import Mathlib.Topology.Algebra.OpenSubgroup
public import Mathlib.Topology.Compactness.SigmaCompact
import TauCeti.Topology.Algebra.Monoid

/-!
# σ-compact open subgroups of locally compact groups

In a locally compact group every σ-compact set lies in a σ-compact open subgroup. Writing the set
as `⋃ n, K n` with `K n` compact and choosing a compact identity neighbourhood `V`, let `C n` be
the symmetric compact set generated by `V` and `K 0, …, K (n - 1)`. The union `⋃ n, C n ^ n` is a
subgroup because the sets `C n` increase, it is open because it contains `V`, and it is σ-compact
because each power of a compact set is compact.

A locally compact group need not be σ-compact, but this lets an argument involving countably many
σ-compact sets, for instance the supports of countably many integrable functions for a Haar
measure, take place inside a σ-compact open subgroup, on which a Haar measure is σ-finite.

## Main results

* `IsSigmaCompact.exists_openSubgroup`: a σ-compact subset of a locally compact group is contained
  in a σ-compact open subgroup, with additive version `IsSigmaCompact.exists_openAddSubgroup`.

## References

* E. Hewitt, K. A. Ross, *Abstract Harmonic Analysis I*, 2nd ed., Springer (1979), Theorem 5.7.
-/

public section

open Set
open scoped Pointwise

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- **σ-compact open subgroups.** In a locally compact group, every σ-compact set is contained in
a σ-compact open subgroup. -/
@[to_additive /-- **σ-compact open subgroups.** In a locally compact additive group, every
σ-compact set is contained in a σ-compact open subgroup. -/]
theorem IsSigmaCompact.exists_openSubgroup [WeaklyLocallyCompactSpace G] {s : Set G}
    (hs : IsSigmaCompact s) : ∃ H : OpenSubgroup G, s ⊆ H ∧ IsSigmaCompact (H : Set G) := by
  obtain ⟨K, hK, rfl⟩ := hs
  obtain ⟨V, hV, hV1⟩ := exists_compact_mem_nhds (1 : G)
  -- `C n` is the symmetric compact set generated by `V` and the first `n` compact pieces.
  set D : ℕ → Set G := fun n ↦ V ∪ ⋃ k ∈ Finset.range n, K k
  set C : ℕ → Set G := fun n ↦ D n ∪ (D n)⁻¹
  have hC : ∀ n, IsCompact (C n) := fun n ↦
    have hD : IsCompact (D n) := hV.union <| (Finset.range n).isCompact_biUnion fun k _ ↦ hK k
    hD.union hD.inv
  have hC_mono : Monotone C := fun m n hmn ↦ by
    have hD : D m ⊆ D n := union_subset_union_right _ <| biUnion_subset_biUnion_left <| by
      simpa using Finset.range_subset_range.2 hmn
    exact union_subset_union hD (inv_subset_inv.2 hD)
  have hVC : ∀ n, V ⊆ C n := fun n ↦ subset_union_left.trans subset_union_left
  have hC1 : ∀ n, (1 : G) ∈ C n := fun n ↦ hVC n (mem_of_mem_nhds hV1)
  have hC_inv : ∀ n, (C n)⁻¹ = C n := fun n ↦ by simp [C, union_comm]
  let H : Subgroup G :=
    { carrier := ⋃ n, C n ^ n
      mul_mem' := by
        simp only [mem_iUnion]
        rintro x y ⟨m, hx⟩ ⟨n, hy⟩
        refine ⟨m + n, ?_⟩
        rw [pow_add]
        exact mul_mem_mul (pow_subset_pow_left (hC_mono (m.le_add_right n)) hx)
          (pow_subset_pow_left (hC_mono (n.le_add_left m)) hy)
      one_mem' := mem_iUnion.2 ⟨0, by simp⟩
      inv_mem' := by
        simp only [mem_iUnion]
        rintro x ⟨n, hx⟩
        refine ⟨n, ?_⟩
        rw [← hC_inv n, inv_pow, inv_mem_inv]
        exact hx }
  have hVH : V ⊆ H := fun x hx ↦ mem_iUnion.2 ⟨1, by simpa using hVC 1 hx⟩
  refine ⟨⟨H, H.isOpen_of_mem_nhds (Filter.mem_of_superset hV1 hVH)⟩, ?_, ?_⟩
  · refine iUnion_subset fun k x hx ↦ mem_iUnion.2 ⟨k + 1, ?_⟩
    refine subset_pow (hC1 _) k.succ_ne_zero (subset_union_left (subset_union_right ?_))
    exact mem_biUnion (Finset.mem_range.2 k.lt_succ_self) hx
  · exact isSigmaCompact_iUnion_of_isCompact _ fun n ↦ (hC n).pow n
