module

public import Mathlib.Topology.Algebra.Group.Pointwise
public import Mathlib.Topology.Algebra.OpenSubgroup
public import TauCeti.Topology.Compactness.Compact

/-!
# σ-compact subgroups of topological groups

A σ-compact set is a countable union of compact sets. In a topological group the pointwise
product of two σ-compact sets is σ-compact, being a countable union of products of compact sets.
The subgroup generated by a σ-compact set `S` is the increasing union of the powers of
`{1} ∪ S ∪ S⁻¹`, so it is σ-compact as well.

In a locally compact group this gives a σ-compact *open* subgroup containing any prescribed
σ-compact set: adjoin a compact neighbourhood of the identity before generating. This is how
analysis on a locally compact group that need not be σ-compact is reduced to a σ-compact piece.
A Haar measure restricted to such a subgroup is σ-finite, and countably many integrable functions
all vanish almost everywhere outside one such subgroup.

## Main results

* `IsSigmaCompact.mul`: the pointwise product of two σ-compact sets is σ-compact.
* `IsSigmaCompact.subgroupClosure`: the subgroup generated by a σ-compact set is σ-compact.
* `IsSigmaCompact.exists_isSigmaCompact_openSubgroup_superset`: in a weakly locally compact
  group, every σ-compact set lies in a σ-compact open subgroup.

## References

* E. Hewitt, K. A. Ross, *Abstract Harmonic Analysis I*, Springer (1963), Theorem 5.7.
-/

public section

open Set
open scoped Pointwise

variable {G : Type*} [TopologicalSpace G]

/-- The pointwise product of two σ-compact sets is σ-compact. -/
@[to_additive /-- The pointwise sum of two σ-compact sets is σ-compact. -/]
theorem IsSigmaCompact.mul [Mul G] [ContinuousMul G] {s t : Set G} (hs : IsSigmaCompact s)
    (ht : IsSigmaCompact t) : IsSigmaCompact (s * t) := by
  obtain ⟨K, hK, rfl⟩ := hs
  obtain ⟨L, hL, rfl⟩ := ht
  rw [iUnion_mul]
  simp_rw [mul_iUnion]
  exact isSigmaCompact_iUnion _ fun m ↦ isSigmaCompact_iUnion _ fun n ↦
    ((hK m).mul (hL n)).isSigmaCompact

/-- Every natural power of a σ-compact set is σ-compact. -/
@[to_additive /-- Every natural multiple of a σ-compact set is σ-compact. -/]
theorem IsSigmaCompact.pow [Monoid G] [ContinuousMul G] {s : Set G} (hs : IsSigmaCompact s)
    (n : ℕ) : IsSigmaCompact (s ^ n) := by
  induction n with
  | zero =>
    rw [pow_zero, ← singleton_one]
    exact isCompact_singleton.isSigmaCompact
  | succ n ih => simpa [pow_succ] using ih.mul hs

/-- The pointwise inverse of a σ-compact set is σ-compact. -/
@[to_additive /-- The pointwise negation of a σ-compact set is σ-compact. -/]
theorem IsSigmaCompact.inv [InvolutiveInv G] [ContinuousInv G] {s : Set G}
    (hs : IsSigmaCompact s) : IsSigmaCompact s⁻¹ := by
  simpa using hs.image continuous_inv

/-- The subgroup generated by a σ-compact set is σ-compact. -/
@[to_additive /-- The additive subgroup generated by a σ-compact set is σ-compact. -/]
theorem IsSigmaCompact.subgroupClosure [Group G] [ContinuousMul G] [ContinuousInv G]
    {s : Set G} (hs : IsSigmaCompact s) : IsSigmaCompact (Subgroup.closure s : Set G) := by
  set t : Set G := {1} ∪ (s ∪ s⁻¹)
  have ht : IsSigmaCompact t := isCompact_singleton.isSigmaCompact.union (hs.union hs.inv)
  have ht_inv : t⁻¹ = t := by simp [t, union_comm]
  -- The subgroup generated by `s` is the union of the powers of `t = {1} ∪ s ∪ s⁻¹`.
  suffices (Subgroup.closure s : Set G) = ⋃ n : ℕ, t ^ n from
    this ▸ isSigmaCompact_iUnion _ ht.pow
  refine Subset.antisymm (fun x hx ↦ ?_) (iUnion_subset fun n ↦ Subgroup.pow_subset ?_)
  · induction hx using Subgroup.closure_induction with
    | mem x hx => exact mem_iUnion.2 ⟨1, by simp [t, hx]⟩
    | one => exact mem_iUnion.2 ⟨0, by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨m, hm⟩ := mem_iUnion.1 hx
      obtain ⟨n, hn⟩ := mem_iUnion.1 hy
      exact mem_iUnion.2 ⟨m + n, pow_add t m n ▸ mul_mem_mul hm hn⟩
    | inv x _ hx =>
      obtain ⟨n, hn⟩ := mem_iUnion.1 hx
      exact mem_iUnion.2 ⟨n, by rwa [← ht_inv, inv_pow, mem_inv, inv_inv]⟩
  · simp only [t, union_subset_iff, singleton_subset_iff, SetLike.mem_coe, one_mem, true_and]
    exact ⟨Subgroup.subset_closure, Subgroup.inv_subset_closure s⟩

/-- In a weakly locally compact group, every σ-compact set is contained in a σ-compact open
subgroup. -/
@[to_additive /-- In a weakly locally compact additive group, every σ-compact set is contained in
a σ-compact open additive subgroup. -/]
theorem IsSigmaCompact.exists_isSigmaCompact_openSubgroup_superset [Group G]
    [IsTopologicalGroup G] [WeaklyLocallyCompactSpace G] {s : Set G} (hs : IsSigmaCompact s) :
    ∃ H : OpenSubgroup G, s ⊆ H ∧ IsSigmaCompact (H : Set G) := by
  obtain ⟨K, hK, hK1⟩ := exists_compact_mem_nhds (1 : G)
  set H := Subgroup.closure (s ∪ K)
  have hsK : s ∪ K ⊆ H := Subgroup.subset_closure
  refine ⟨⟨H, H.isOpen_of_mem_nhds (Filter.mem_of_superset hK1 (subset_union_right.trans hsK))⟩,
    subset_union_left.trans hsK, ?_⟩
  exact (hs.union hK.isSigmaCompact).subgroupClosure
