public import TauCeti.Topology.Algebra.Group.LowerCentralSeries

/-!
# Closed power subgroups and powerful groups

For a topological group `G` and a natural number `n`, the **closed power subgroup** `Gⁿ` is the
topological closure of the subgroup generated by the `n`-th powers. A pro-`p` group is
**powerful** (Lubotzky-Mann) when its commutator subgroup lies in `Gᵖ`, and, for `p = 2`, in
`G⁴`. Powerful groups are the setting of the theory of uniform pro-`p` groups, hence of compact
`p`-adic analytic groups and of their completed group algebras.

The convention at `p = 2` is forced: in *every* group the commutator subgroup lies in the
subgroup generated by the squares (`TauCeti.commutator_le_closedPowerSubgroup_two`), because
`⁅a, b⁆ = a² (a⁻¹ b)² (b⁻¹)²`; so the condition with `G²` would hold for every group.

The closed power subgroup is the verbal step `TauCeti.pVerbalStep n ⊤ ⊥` with no commutator
contribution, so it inherits the closedness, normality and functoriality of the verbal step. In a
powerful group the commutators add nothing to the first term `λ_1 = closure (Gᵖ [G, G])` of the
lower `p`-series, so `λ_1 = Gᵖ`
(`TauCeti.IsPowerful.closedPowerSubgroup_eq_pLowerCentralSeries_one`). For a topologically
finitely generated pro-`p` group this is what identifies the index of `Gᵖ` with `p` raised to the
number of generators.

The predicate `TauCeti.IsPowerful` is the containment alone; the pro-`p` condition is imposed
separately where it is needed, as in `TauCeti.IsUniform`.

## Main definitions

* `TauCeti.closedPowerSubgroup n G`: the closed subgroup `Gⁿ` generated by the `n`-th powers.
* `TauCeti.IsPowerful p G`: the commutator subgroup lies in `Gᵖ`, or in `G⁴` when `p = 2`.

## Main results

* `TauCeti.closedPowerSubgroup_le_iff`: a closed subgroup contains `Gⁿ` exactly when it contains
  every `n`-th power.
* `TauCeti.closedPowerSubgroup_le_of_dvd`: `Gᵐ ≤ Gⁿ` when `n ∣ m`.
* `TauCeti.closedPowerSubgroup_mul_le_map_subtype_closedPowerSubgroup`: `G^{mn} ≤ Kⁿ` for a closed
  subgroup `K` containing every `m`-th power.
* `TauCeti.commutator_le_closedPowerSubgroup_two`: the commutator subgroup always lies in `G²`.
* `TauCeti.IsPowerful.closedPowerSubgroup_eq_pLowerCentralSeries_one`: in a powerful group,
  `Gᵖ = λ_1`.
* `TauCeti.IsPowerful.of_surjective`, `TauCeti.isPowerful_congr`, `TauCeti.IsPowerful.prod`,
  `TauCeti.isPowerful_of_isMulCommutative`: powerful groups are stable under continuous
  surjections, topological group isomorphisms and binary products, and include the commutative
  groups.

## References

* J. D. Dixon, M. P. F. du Sautoy, A. Mann and D. Segal, *Analytic pro-`p` groups*, second
  edition, Definitions 3.1 and 4.1.
* K. Ardakov and K. A. Brown, *Ring-theoretic properties of Iwasawa algebras: a survey*, §2.3.
-/

public section

namespace TauCeti

open Subgroup
open scoped commutatorElement

/-! ### The closed power subgroup -/

section PowerSubgroup

variable (n : ℕ) (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The **closed power subgroup** `Gⁿ`: the topological closure of the subgroup generated by the
`n`-th powers of the elements of `G`. It is the verbal step `TauCeti.pVerbalStep n ⊤ ⊥`, whose
commutator part `⁅⊤, ⊥⁆` is trivial; the explicit form is
`TauCeti.closedPowerSubgroup_eq_topologicalClosure`, and the characteristic property is
`TauCeti.closedPowerSubgroup_le_iff`. -/
def closedPowerSubgroup : Subgroup G :=
  pVerbalStep n (⊤ : Subgroup G) ⊥

/-- The closed power subgroup is the verbal step of the whole group against the trivial
subgroup. -/
theorem closedPowerSubgroup_eq_pVerbalStep :
    closedPowerSubgroup n G = pVerbalStep n (⊤ : Subgroup G) ⊥ := by
  rw [closedPowerSubgroup]

/-- The closed power subgroup is the topological closure of the subgroup generated by the
`n`-th powers. -/
theorem closedPowerSubgroup_eq_topologicalClosure :
    closedPowerSubgroup n G =
      (Subgroup.closure (Set.range fun g : G ↦ g ^ n)).topologicalClosure := by
  rw [closedPowerSubgroup_eq_pVerbalStep, pVerbalStep_def, commutator_bot_right, sup_bot_eq,
    coe_top, Set.image_univ]

variable {n G}

/-- The closed power subgroup is closed. -/
instance isClosed_closedPowerSubgroup : IsClosed (closedPowerSubgroup n G : Set G) := by
  rw [closedPowerSubgroup_eq_pVerbalStep]
  exact isClosed_pVerbalStep _ _

/-- The closed power subgroup is normal. -/
instance closedPowerSubgroup_normal : (closedPowerSubgroup n G).Normal := by
  rw [closedPowerSubgroup_eq_pVerbalStep]
  infer_instance

/-- Every `n`-th power lies in the closed power subgroup `Gⁿ`. -/
theorem pow_mem_closedPowerSubgroup (g : G) : g ^ n ∈ closedPowerSubgroup n G := by
  rw [closedPowerSubgroup_eq_pVerbalStep]
  exact pow_mem_pVerbalStep (mem_top g)

/-- **The characteristic property of `Gⁿ`.** A closed subgroup contains the closed power subgroup
exactly when it contains every `n`-th power. -/
theorem closedPowerSubgroup_le_iff {K : Subgroup G} (hK : IsClosed (K : Set G)) :
    closedPowerSubgroup n G ≤ K ↔ ∀ g : G, g ^ n ∈ K := by
  rw [closedPowerSubgroup_eq_pVerbalStep, pVerbalStep_le_iff hK, commutator_bot_right]
  simp

/-- The closed power subgroup is antitone along divisibility: an `m`-th power is an `n`-th power
when `n ∣ m`. -/
theorem closedPowerSubgroup_le_of_dvd {m : ℕ} (h : n ∣ m) :
    closedPowerSubgroup m G ≤ closedPowerSubgroup n G := by
  obtain ⟨k, rfl⟩ := h
  refine (closedPowerSubgroup_le_iff isClosed_closedPowerSubgroup).mpr fun g ↦ ?_
  rw [pow_mul']
  exact pow_mem_closedPowerSubgroup _

/-- The closed power subgroup `Kⁿ` of a closed subgroup `K`, computed in `K`, is closed in `G`. -/
theorem isClosed_map_subtype_closedPowerSubgroup {K : Subgroup G} (hK : IsClosed (K : Set G)) :
    IsClosed (((closedPowerSubgroup n K).map K.subtype : Subgroup G) : Set G) := by
  rw [Subgroup.coe_map]
  exact hK.isClosedEmbedding_subtypeVal.isClosedMap _ isClosed_closedPowerSubgroup

/-- If a closed subgroup `K` contains every `m`-th power, then `G^{mn}` lies in the closed power
subgroup `Kⁿ`, computed in `K`: an `mn`-th power is the `n`-th power of an `m`-th power. -/
theorem closedPowerSubgroup_mul_le_map_subtype_closedPowerSubgroup {K : Subgroup G}
    (hK : IsClosed (K : Set G)) {m : ℕ} (hm : ∀ g : G, g ^ m ∈ K) :
    closedPowerSubgroup (m * n) G ≤ (closedPowerSubgroup n K).map K.subtype :=
  (closedPowerSubgroup_le_iff (isClosed_map_subtype_closedPowerSubgroup hK)).mpr fun g ↦
    ⟨⟨g ^ m, hm g⟩ ^ n, pow_mem_closedPowerSubgroup _, by simp [pow_mul]⟩

/-- The closed power subgroup for the exponent `1` is the whole group. -/
@[simp]
theorem closedPowerSubgroup_one : closedPowerSubgroup 1 G = ⊤ :=
  eq_top_iff.mpr fun g _ ↦ by simpa using pow_mem_closedPowerSubgroup (n := 1) g

/-- The closed power subgroup `Gᵖ` lies in the first term `λ_1` of the lower `p`-series. -/
theorem closedPowerSubgroup_le_pLowerCentralSeries_one {p : ℕ} :
    closedPowerSubgroup p G ≤ pLowerCentralSeries p G 1 :=
  (closedPowerSubgroup_le_iff (isClosed_pLowerCentralSeries 1)).mpr fun g ↦
    pow_mem_pLowerCentralSeries (mem_pLowerCentralSeries_zero p g)

/-- **The square condition is vacuous.** In every topological group the commutator subgroup lies
in the closed subgroup generated by the squares, since `⁅a, b⁆ = a² (a⁻¹ b)² (b⁻¹)²`. This is why
powerfulness at the prime `2` asks for fourth powers. -/
theorem commutator_le_closedPowerSubgroup_two : commutator G ≤ closedPowerSubgroup 2 G := by
  refine (commutator_def G ▸ commutator_le).mpr fun a _ b _ ↦ ?_
  have h : ⁅a, b⁆ = a ^ 2 * (a⁻¹ * b) ^ 2 * b⁻¹ ^ 2 := by
    simp only [commutatorElement_def, sq, mul_assoc, mul_inv_cancel_left]
  rw [h]
  exact mul_mem (mul_mem (pow_mem_closedPowerSubgroup a) (pow_mem_closedPowerSubgroup _))
    (pow_mem_closedPowerSubgroup _)

variable {H : Type*} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]

/-- A continuous homomorphism carries `Gⁿ` into `Hⁿ`. -/
theorem _root_.MonoidHom.map_closedPowerSubgroup_le (f : G →* H) (hf : Continuous f) :
    (closedPowerSubgroup n G).map f ≤ closedPowerSubgroup n H := by
  rw [closedPowerSubgroup_eq_pVerbalStep, closedPowerSubgroup_eq_pVerbalStep]
  exact (f.map_pVerbalStep_le hf ⊤ ⊥).trans (pVerbalStep_mono le_top (Subgroup.map_bot f).le)

/-- A continuous closed surjective homomorphism, for instance a continuous surjection from a
compact group onto a Hausdorff group, carries `Gⁿ` onto `Hⁿ`. -/
theorem _root_.MonoidHom.map_closedPowerSubgroup_eq_of_surjective (f : G →* H)
    (hf : Continuous f) (hfc : IsClosedMap f) (hsurj : Function.Surjective f) :
    (closedPowerSubgroup n G).map f = closedPowerSubgroup n H := by
  rw [closedPowerSubgroup_eq_pVerbalStep, closedPowerSubgroup_eq_pVerbalStep,
    f.map_pVerbalStep_eq_of_isClosedMap hf hfc, map_top_of_surjective f hsurj, Subgroup.map_bot]

/-- A topological group isomorphism carries `Gⁿ` onto `Hⁿ`. -/
theorem _root_.ContinuousMulEquiv.map_closedPowerSubgroup_eq (e : G ≃ₜ* H) :
    (closedPowerSubgroup n G).map (e : G →* H) = closedPowerSubgroup n H :=
  (e : G →* H).map_closedPowerSubgroup_eq_of_surjective e.continuous
    e.toHomeomorph.isClosedMap e.surjective

/-- The product of the closed power subgroups of two groups lies in the closed power subgroup of
their product. -/
theorem prod_closedPowerSubgroup_le :
    (closedPowerSubgroup n G).prod (closedPowerSubgroup n H) ≤ closedPowerSubgroup n (G × H) :=
  prod_le_iff.mpr
    ⟨(MonoidHom.inl G H).map_closedPowerSubgroup_le (continuous_id.prodMk continuous_const),
      (MonoidHom.inr G H).map_closedPowerSubgroup_le (continuous_const.prodMk continuous_id)⟩

end PowerSubgroup

/-! ### Powerful groups -/

section Powerful

variable (p : ℕ) (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- A topological group is **powerful** at `p` when its commutator subgroup lies in the closed
power subgroup `Gᵖ`, and, for `p = 2`, in `G⁴`. The predicate is meant for pro-`p` groups and a
prime `p`; it is stated for every topological group so that it can be imposed alongside
`TauCeti.IsProP`. The square condition at `p = 2` would be vacuous, by
`TauCeti.commutator_le_closedPowerSubgroup_two`. -/
def IsPowerful : Prop :=
  commutator G ≤ closedPowerSubgroup (if p = 2 then 4 else p) G

variable {p G}

/-- The defining property of `IsPowerful`. -/
theorem isPowerful_iff :
    IsPowerful p G ↔ commutator G ≤ closedPowerSubgroup (if p = 2 then 4 else p) G := by
  rw [IsPowerful]

/-- At an exponent other than `2`, powerfulness asks for the commutator subgroup to lie in
`Gᵖ`. -/
theorem isPowerful_iff_of_ne_two (hp : p ≠ 2) :
    IsPowerful p G ↔ commutator G ≤ closedPowerSubgroup p G := by
  simp [isPowerful_iff, hp]

/-- At the prime `2`, powerfulness asks for the commutator subgroup to lie in `G⁴`. -/
theorem isPowerful_two_iff :
    IsPowerful 2 G ↔ commutator G ≤ closedPowerSubgroup 4 G := by
  simp [isPowerful_iff]

/-- In a powerful group the commutator subgroup lies in `Gᵖ`; for `p = 2` this weakening of the
fourth-power condition holds in every group. -/
theorem IsPowerful.commutator_le (hG : IsPowerful p G) :
    commutator G ≤ closedPowerSubgroup p G := by
  rw [isPowerful_iff] at hG
  split_ifs at hG with hp
  · subst hp
    exact hG.trans (closedPowerSubgroup_le_of_dvd (by norm_num))
  · exact hG

/-- **In a powerful group, `λ_1 = Gᵖ`.** The first term `closure (Gᵖ [G, G])` of the lower
`p`-series is the closed power subgroup, since the commutators already lie in `Gᵖ`. -/
theorem IsPowerful.closedPowerSubgroup_eq_pLowerCentralSeries_one (hG : IsPowerful p G) :
    closedPowerSubgroup p G = pLowerCentralSeries p G 1 := by
  refine le_antisymm closedPowerSubgroup_le_pLowerCentralSeries_one ?_
  rw [pLowerCentralSeries_succ, pLowerCentralSeries_zero,
    pLowerCentralStep_le_iff isClosed_closedPowerSubgroup]
  exact ⟨fun g _ ↦ pow_mem_closedPowerSubgroup g, commutator_def G ▸ hG.commutator_le⟩

/-- A commutative topological group is powerful: its commutator subgroup is trivial. -/
theorem isPowerful_of_isMulCommutative [IsMulCommutative G] : IsPowerful p G := by
  rw [isPowerful_iff, commutator_eq_bot]
  exact bot_le

variable {H : Type*} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]

/-- **Powerfulness passes to continuous surjective images**, in particular to quotients. -/
theorem IsPowerful.of_surjective (hG : IsPowerful p G) (f : G →* H) (hf : Continuous f)
    (hsurj : Function.Surjective f) : IsPowerful p H := by
  rw [isPowerful_iff] at hG ⊢
  rw [commutator_def, ← map_top_of_surjective f hsurj, ← map_commutator, ← commutator_def]
  exact (map_mono hG).trans (f.map_closedPowerSubgroup_le hf)

/-- Powerfulness is invariant under topological group isomorphism. -/
theorem isPowerful_congr (e : G ≃ₜ* H) : IsPowerful p G ↔ IsPowerful p H :=
  ⟨fun hG ↦ hG.of_surjective (e : G →* H) e.continuous e.surjective,
    fun hH ↦ hH.of_surjective (e.symm : H →* G) e.symm.continuous e.symm.surjective⟩

/-- **A product of two powerful groups is powerful.** -/
theorem IsPowerful.prod (hG : IsPowerful p G) (hH : IsPowerful p H) : IsPowerful p (G × H) := by
  rw [isPowerful_iff] at hG hH ⊢
  rw [commutator_def, ← top_prod_top, commutator_prod_prod, ← commutator_def, ← commutator_def]
  exact (prod_mono hG hH).trans prod_closedPowerSubgroup_le

end Powerful

end TauCeti
