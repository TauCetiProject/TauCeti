/-!
# The congruence topology on continuous automorphisms

The group `ContinuousAut G` of continuous automorphisms of a topological group `G` carries the
**congruence topology**: the coarsest topology for which every coordinate
`ContinuousAut.mapQuotient : ContinuousAut G →* MulAut (G ⧸ N)`, for `N` a topologically
characteristic open normal subgroup of `G`, is continuous into the discrete group `MulAut (G ⧸ N)`.
Two automorphisms are close when they agree modulo a small characteristic open normal subgroup.
With this topology `ContinuousAut G` is a topological group and the inner automorphism map
`ContinuousAut.conj : G → ContinuousAut G` is continuous.

The topology is well behaved for a topologically finitely generated profinite group `G`, where the
topologically characteristic open normal subgroups form a neighbourhood basis of the identity
(`TauCeti.IsTopologicallyFinitelyGenerated.exists_isTopCharacteristic_subset`). Then the
evaluation `ContinuousAut G × G → G` is jointly continuous, the coordinates separate
automorphisms, so `ContinuousAut G` is Hausdorff and totally disconnected, and the conditions
`φ x = y` and `IsConj (φ x) y` on an automorphism `φ` define closed sets. The last is the form
in which closed-graph arguments impose conjugacy conditions on an automorphism.

Without finite generation the congruence topology need not be compact, and without compactness
of `G` it can be indiscrete (`Multiplicative ℝ` has no proper open subgroup) or infinite and
discrete (`Multiplicative (ℤ × ℤ)` has the open characteristic subgroup `⊥`, and
`ContinuousAut (Multiplicative (ℤ × ℤ)) ≅ GL₂(ℤ)`).

## Main definitions

* `TauCeti.ContinuousAut.congruenceTopology`: the congruence topology on `ContinuousAut G`, as an
  instance.

## Main results

* `TauCeti.ContinuousAut.continuous_mapQuotient`: each characteristic quotient coordinate is
  continuous into the discrete automorphism group of the quotient.
* `TauCeti.ContinuousAut.hasBasis_nhds`, `TauCeti.ContinuousAut.mem_nhds_iff`: the neighbourhoods
  of `φ` are generated by the sets of automorphisms agreeing with `φ` modulo a topologically
  characteristic open normal subgroup.
* `TauCeti.ContinuousAut.continuous_conj`: the inner automorphism map is continuous.
* `TauCeti.ContinuousAut.continuous_eval`: for a topologically finitely generated profinite group,
  evaluation `ContinuousAut G × G → G` is continuous.
* `TauCeti.ContinuousAut.isEmbedding_pi_mapQuotient`, `TauCeti.ContinuousAut.t2Space`,
  `TauCeti.ContinuousAut.totallyDisconnectedSpace`: for a topologically finitely generated
  profinite group, the coordinates embed `ContinuousAut G` into a product of discrete groups, so
  the congruence topology is Hausdorff and totally disconnected.
* `TauCeti.ContinuousAut.isClosed_setOf_apply_eq`, `TauCeti.ContinuousAut.isClosed_isConj`: the
  automorphisms with a prescribed value, or a prescribed conjugacy class of a value, at a point
  form a closed set.

## References

* L. Ribes, P. Zalesskii, *Profinite Groups*, 2nd ed., §4.4.
-/

public section

open Filter Topology

namespace TauCeti

namespace ContinuousAut

variable {G : Type*} [Group G] [TopologicalSpace G]

/-- The **congruence topology** on the continuous automorphisms of `G`: the coarsest topology for
which every coordinate `mapQuotient : ContinuousAut G →* MulAut (G ⧸ N)`, `N` ranging over the
topologically characteristic open normal subgroups of `G`, is continuous into the discrete group
`MulAut (G ⧸ N)`. -/
instance congruenceTopology : TopologicalSpace (ContinuousAut G) :=
  ⨅ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N},
    TopologicalSpace.induced (mapQuotient N.2) ⊥

/-- The congruence topology is the infimum of the topologies induced by the characteristic
quotient coordinates from the discrete topology `⊥`. -/
theorem congruenceTopology_eq_iInf :
    congruenceTopology = ⨅ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N},
      TopologicalSpace.induced (mapQuotient N.2) ⊥ :=
  (rfl)

/-- The congruence topology makes `ContinuousAut G` a topological group, as an infimum of
topologies induced along homomorphisms into discrete groups. -/
instance : IsTopologicalGroup (ContinuousAut G) :=
  isTopologicalGroup_iInf fun N ↦
    letI : TopologicalSpace (MulAut (G ⧸ (N.1 : Subgroup G))) := ⊥
    haveI := discreteTopology_bot (MulAut (G ⧸ (N.1 : Subgroup G)))
    haveI : IsTopologicalGroup (MulAut (G ⧸ (N.1 : Subgroup G))) := {}
    isTopologicalGroup_induced (mapQuotient N.2)

/-- Each characteristic quotient coordinate is continuous for the congruence topology and the
discrete topology `⊥` on `MulAut (G ⧸ N)`. -/
theorem continuous_mapQuotient (N : OpenNormalSubgroup G) (hN : IsTopCharacteristic G N) :
    Continuous[congruenceTopology, ⊥] (mapQuotient hN) :=
  continuous_iInf_dom (i := ⟨N, hN⟩) continuous_induced_dom

/-- The automorphisms sharing a characteristic quotient coordinate with `φ` form an open set. -/
theorem isOpen_setOf_mapQuotient_eq (N : OpenNormalSubgroup G) (hN : IsTopCharacteristic G N)
    (φ : ContinuousAut G) :
    IsOpen {ψ : ContinuousAut G | mapQuotient hN ψ = mapQuotient hN φ} := by
  let _ : TopologicalSpace (MulAut (G ⧸ (N : Subgroup G))) := ⊥
  have := discreteTopology_bot (MulAut (G ⧸ (N : Subgroup G)))
  exact (continuous_mapQuotient N hN).isOpen_preimage {mapQuotient hN φ} (isOpen_discrete _)

/-- The neighbourhoods of `φ` in the congruence topology are generated by the sets of
automorphisms agreeing with `φ` modulo a topologically characteristic open normal subgroup. -/
theorem hasBasis_nhds (φ : ContinuousAut G) :
    (𝓝 φ).HasBasis (fun N : OpenNormalSubgroup G ↦ IsTopCharacteristic G N)
      fun N ↦ {ψ : ContinuousAut G | ∀ x : G, (ψ x : G ⧸ (N : Subgroup G)) = φ x} := by
  let S : {N : OpenNormalSubgroup G // IsTopCharacteristic G N} → Set (ContinuousAut G) :=
    fun N ↦ {ψ | mapQuotient N.2 ψ = mapQuotient N.2 φ}
  have hS : ∀ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N},
      S N = {ψ : ContinuousAut G | ∀ x : G, (ψ x : G ⧸ (N.1 : Subgroup G)) = φ x} := fun N ↦ by
    ext ψ
    exact mapQuotient_eq_iff N.2
  have key : 𝓝 φ = ⨅ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N}, 𝓟 (S N) := by
    rw [congruenceTopology_eq_iInf, nhds_iInf]
    refine iInf_congr fun N ↦ ?_
    let _ : TopologicalSpace (MulAut (G ⧸ (N.1 : Subgroup G))) := ⊥
    have := discreteTopology_bot (MulAut (G ⧸ (N.1 : Subgroup G)))
    rw [nhds_induced, nhds_discrete, comap_pure]
    rfl
  have hmono : ∀ {M₁ M₂ : OpenNormalSubgroup G} (hM₁ : IsTopCharacteristic G M₁)
      (hM₂ : IsTopCharacteristic G M₂), (M₁ : Subgroup G) ≤ M₂ → S ⟨M₁, hM₁⟩ ⊆ S ⟨M₂, hM₂⟩ := by
    intro M₁ M₂ hM₁ hM₂ hle ψ hψ
    rw [hS] at hψ ⊢
    exact fun x ↦ QuotientGroup.eq.mpr (hle (QuotientGroup.eq.mp (hψ x)))
  have hdir : Directed (· ≥ ·) S := by
    rintro ⟨N₁, h₁⟩ ⟨N₂, h₂⟩
    -- `(N₁ ⊓ N₂ : OpenNormalSubgroup G)` coerces to the infimum of the underlying subgroups.
    exact ⟨⟨N₁ ⊓ N₂, IsTopCharacteristic.inf h₁ h₂⟩, hmono _ _ inf_le_left, hmono _ _ inf_le_right⟩
  have : Nonempty {N : OpenNormalSubgroup G // IsTopCharacteristic G N} :=
    ⟨⟨{ toOpenSubgroup := ⟨⊤, isOpen_univ⟩ }, IsTopCharacteristic.top⟩⟩
  refine (key ▸ hasBasis_iInf_principal hdir).to_hasBasis ?_ ?_
  · rintro ⟨N, hN⟩ -
    exact ⟨N, hN, (hS ⟨N, hN⟩).ge⟩
  · intro N hN
    exact ⟨⟨N, hN⟩, trivial, (hS ⟨N, hN⟩).le⟩

/-- A set is a neighbourhood of `φ` in the congruence topology exactly when it contains every
automorphism agreeing with `φ` modulo some topologically characteristic open normal subgroup. -/
theorem mem_nhds_iff {φ : ContinuousAut G} {s : Set (ContinuousAut G)} :
    s ∈ 𝓝 φ ↔ ∃ N : OpenNormalSubgroup G, IsTopCharacteristic G N ∧
      {ψ : ContinuousAut G | ∀ x : G, (ψ x : G ⧸ (N : Subgroup G)) = φ x} ⊆ s :=
  (hasBasis_nhds φ).mem_iff

/-- The inner automorphism map `G → ContinuousAut G` is continuous for the congruence topology:
on each characteristic open quotient it factors through the discrete group `G ⧸ N`. -/
theorem continuous_conj [SeparatelyContinuousMul G] :
    Continuous (conj : G → ContinuousAut G) := by
  rw [congruenceTopology_eq_iInf, continuous_iInf_rng]
  intro N
  rw [continuous_induced_rng]
  let _ : TopologicalSpace (MulAut (G ⧸ (N.1 : Subgroup G))) := ⊥
  have := discreteTopology_bot (MulAut (G ⧸ (N.1 : Subgroup G)))
  have := QuotientGroup.discreteTopology N.1.isOpen
  have : (mapQuotient N.2 ∘ conj : G → MulAut (G ⧸ (N.1 : Subgroup G))) =
      (fun q : G ⧸ (N.1 : Subgroup G) ↦ MulAut.conj q) ∘ QuotientGroup.mk := by
    ext g : 1
    exact mapQuotient_conj N.2 g
  rw [this]
  exact continuous_of_discreteTopology.comp QuotientGroup.continuous_mk

section Profinite

variable [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G]

/-- For a topologically finitely generated profinite group, the evaluation
`(φ, x) ↦ φ x` is jointly continuous on `ContinuousAut G × G`. -/
theorem continuous_eval (hG : IsTopologicallyFinitelyGenerated G) :
    Continuous fun p : ContinuousAut G × G ↦ p.1 p.2 := by
  rw [continuous_def]
  intro U hU
  rw [isOpen_iff_forall_mem_open]
  rintro ⟨φ, x⟩ (hφx : φ x ∈ U)
  obtain ⟨N, hN, hNU⟩ := hG.exists_isTopCharacteristic_subset
    (hU.preimage (continuous_const.mul continuous_id : Continuous fun g : G ↦ φ x * g))
    (by simpa using hφx)
  refine ⟨{ψ : ContinuousAut G | mapQuotient hN ψ = mapQuotient hN φ} ×ˢ
    {y : G | x⁻¹ * y ∈ (N : Subgroup G)}, ?_, ?_, rfl, by simp⟩
  · rintro ⟨ψ, y⟩ ⟨hψ, hy⟩
    have h1 : (φ x)⁻¹ * ψ x ∈ (N : Subgroup G) :=
      QuotientGroup.eq.mp ((mapQuotient_eq_iff hN).mp hψ x).symm
    have h2 : ψ (x⁻¹ * y) ∈ (N : Subgroup G) := by
      rw [← isTopCharacteristic_iff_map_eq.mp hN ψ]
      exact Subgroup.mem_map_of_mem _ hy
    have h3 : (φ x)⁻¹ * ψ y ∈ (N : Subgroup G) := by
      have : (φ x)⁻¹ * ψ y = (φ x)⁻¹ * ψ x * ψ (x⁻¹ * y) := by simp [mul_assoc]
      rw [this]
      exact mul_mem h1 h2
    simpa using hNU h3
  · exact (isOpen_setOf_mapQuotient_eq N hN φ).prod
      (N.isOpen.preimage (continuous_const.mul continuous_id))

/-- For a topologically finitely generated profinite group, evaluation at a point is continuous
on `ContinuousAut G`. -/
theorem continuous_eval_const (hG : IsTopologicallyFinitelyGenerated G) (x : G) :
    Continuous fun φ : ContinuousAut G ↦ φ x :=
  (continuous_eval hG).comp (continuous_id.prodMk continuous_const)

/-- For a topologically finitely generated profinite group, the characteristic quotient
coordinates separate continuous automorphisms. -/
theorem eq_of_forall_mapQuotient_eq (hG : IsTopologicallyFinitelyGenerated G)
    {φ ψ : ContinuousAut G}
    (h : ∀ (N : OpenNormalSubgroup G) (hN : IsTopCharacteristic G N),
      mapQuotient hN φ = mapQuotient hN ψ) :
    φ = ψ := by
  by_contra hne
  obtain ⟨x, hx⟩ : ∃ x, φ x ≠ ψ x := by
    by_contra h'
    push Not at h'
    exact hne (ContinuousMulEquiv.ext h')
  have hx' : (1 : G) ∈ ({(φ x)⁻¹ * ψ x} : Set G)ᶜ := fun h ↦
    hx (inv_mul_eq_one.mp (Set.mem_singleton_iff.mp h).symm)
  obtain ⟨N, hN, hNU⟩ := hG.exists_isTopCharacteristic_subset isOpen_compl_singleton hx'
  exact hNU (QuotientGroup.eq.mp ((mapQuotient_eq_iff hN).mp (h N hN) x)) (Set.mem_singleton _)

/-- For a topologically finitely generated profinite group, the joint characteristic quotient
coordinate map is a topological embedding of `ContinuousAut G` into the product of the discrete
automorphism groups of the characteristic open quotients. -/
theorem isEmbedding_pi_mapQuotient (hG : IsTopologicallyFinitelyGenerated G) :
    letI : ∀ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N},
      TopologicalSpace (MulAut (G ⧸ (N.1 : Subgroup G))) := fun _ ↦ ⊥
    IsEmbedding fun (φ : ContinuousAut G)
      (N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N}) ↦ mapQuotient N.2 φ := by
  let _ : ∀ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N},
    TopologicalSpace (MulAut (G ⧸ (N.1 : Subgroup G))) := fun _ ↦ ⊥
  exact ⟨inducing_iInf_to_pi _,
    fun φ ψ h ↦ eq_of_forall_mapQuotient_eq hG fun N hN ↦ congrFun h ⟨N, hN⟩⟩

/-- For a topologically finitely generated profinite group, the congruence topology is
Hausdorff. -/
theorem t2Space (hG : IsTopologicallyFinitelyGenerated G) : T2Space (ContinuousAut G) := by
  let _ : ∀ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N},
    TopologicalSpace (MulAut (G ⧸ (N.1 : Subgroup G))) := fun _ ↦ ⊥
  have : ∀ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N},
    DiscreteTopology (MulAut (G ⧸ (N.1 : Subgroup G))) := fun _ ↦ discreteTopology_bot _
  exact (isEmbedding_pi_mapQuotient hG).t2Space

/-- For a topologically finitely generated profinite group, the congruence topology is totally
disconnected. -/
theorem totallyDisconnectedSpace (hG : IsTopologicallyFinitelyGenerated G) :
    TotallyDisconnectedSpace (ContinuousAut G) := by
  let _ : ∀ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N},
    TopologicalSpace (MulAut (G ⧸ (N.1 : Subgroup G))) := fun _ ↦ ⊥
  have : ∀ N : {N : OpenNormalSubgroup G // IsTopCharacteristic G N},
    DiscreteTopology (MulAut (G ⧸ (N.1 : Subgroup G))) := fun _ ↦ discreteTopology_bot _
  exact (isEmbedding_pi_mapQuotient hG).isTotallyDisconnected_range.mp
    (isTotallyDisconnected_of_totallyDisconnectedSpace _)

/-- For a topologically finitely generated profinite group, the automorphisms taking a
prescribed value at a point form a closed set. -/
theorem isClosed_setOf_apply_eq (hG : IsTopologicallyFinitelyGenerated G) (x y : G) :
    IsClosed {φ : ContinuousAut G | φ x = y} :=
  isClosed_eq (continuous_eval_const hG x) continuous_const

/-- For a topologically finitely generated profinite group, the automorphisms carrying `x` into
the conjugacy class of `y` form a closed set. -/
theorem isClosed_isConj (hG : IsTopologicallyFinitelyGenerated G) (x y : G) :
    IsClosed {φ : ContinuousAut G | IsConj (φ x) y} :=
  (isClosed_isConj_pair G).preimage ((continuous_eval_const hG x).prodMk continuous_const)

end Profinite

