module

public import Mathlib.Data.Nat.Prime.Defs
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.Index
public import Mathlib.Topology.Algebra.OpenSubgroup
import Mathlib.Data.Nat.Factorization.Basic
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.GroupTheory.Sylow

/-!
# Open Sylow pullbacks and prime-to-l central quotients

Given a finite-index open normal subgroup U of a topological group G and a prime l, pulling
back a Sylow l-subgroup of G ⧸ U yields an open subgroup P ≥ U of index coprime to l in
which every element has an l-power in U (TauCeti.exists_open_sylow). For any finite-index
normal subgroup N of a group G and any element z central modulo N, the prime-to-l part
of the cyclic subgroup generated by z in G ⧸ N is a normal subgroup of order not divisible by
l containing an l-power of z (TauCeti.exists_normal_pow_mem_not_dvd_card).

## Main results

* TauCeti.exists_open_sylow: open subgroup P ≥ U of index coprime to l whose elements have
  an l-power in U.
* TauCeti.exists_normal_pow_mem_not_dvd_card: normal subgroup S of G ⧸ N of order prime to
  l containing (z : G ⧸ N) ^ l ^ j for some j.

## Provenance

Adapted from New.DiscreteModule.exists_open_sylow and
New.DiscreteModule.exists_normal_pow_mem_not_dvd_card in src/Lib/General/Algebra/CartanMap.lean
in grh-lean (https://github.com/lsernau/grh-lean, commit
72fead102f663d5c7a407964a13dc0cf9d977207, Apache 2.0, Copyright 2026 Anthropic, PBC),
generalized from compact groups to finite-index quotients.
-/

public section

open scoped commutatorElement

namespace TauCeti

/-- For a prime l and a finite-index open normal subgroup U of a topological group G (for
instance, any open normal subgroup of a compact topological group), there is an open subgroup
P ≥ U of index coprime to l such that every g ∈ P has g ^ l ^ k ∈ U for some k. -/
theorem exists_open_sylow {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (l : ℕ) [hl : Fact l.Prime] (U : OpenNormalSubgroup G) [Finite (G ⧸ (U : Subgroup G))] :
    ∃ P : OpenSubgroup G,
      (U : Subgroup G) ≤ P ∧ l.Coprime P.toSubgroup.index ∧ ∀ g ∈ P, ∃ k : ℕ, g ^ l ^ k ∈ U := by
  classical
  have : Fintype (G ⧸ (U : Subgroup G)) := Fintype.ofFinite _
  obtain ⟨T⟩ : Nonempty (Sylow l (G ⧸ (U : Subgroup G))) := Sylow.nonempty
  let P : Subgroup G := T.toSubgroup.comap (QuotientGroup.mk' (U : Subgroup G))
  have hU_le : (U : Subgroup G) ≤ P := QuotientGroup.le_comap_mk' (U : Subgroup G) T.toSubgroup
  refine ⟨⟨P, Subgroup.isOpen_mono hU_le U.toOpenSubgroup.isOpen⟩, hU_le, ?_, fun g hg ↦ ?_⟩
  · change l.Coprime (T.toSubgroup.comap (QuotientGroup.mk' (U : Subgroup G))).index
    rw [T.toSubgroup.index_comap_of_surjective (QuotientGroup.mk'_surjective _)]
    exact hl.out.coprime_iff_not_dvd.mpr T.not_dvd_index
  · obtain ⟨k, hk⟩ := T.isPGroup ⟨g, hg⟩
    exact ⟨k, (QuotientGroup.eq_one_iff _).mp (by simpa [Subtype.ext_iff] using hk)⟩

/-- Let l be prime, N a finite-index normal subgroup of G, and z : G central modulo N
(every commutator ⁅z, g⁆ lies in N). Then G ⧸ N has a normal subgroup S of order not
divisible by l containing (z : G ⧸ N) ^ l ^ j for some j. -/
theorem exists_normal_pow_mem_not_dvd_card {G : Type*} [Group G] (l : ℕ) [hl : Fact l.Prime]
    (N : Subgroup G) [N.Normal] [Finite (G ⧸ N)] {z : G} (hz_central : ∀ g : G, ⁅z, g⁆ ∈ N) :
    ∃ (S : Subgroup (G ⧸ N)) (j : ℕ),
      S.Normal ∧ (z : G ⧸ N) ^ l ^ j ∈ S ∧ ¬l ∣ Nat.card S := by
  classical
  have : Fintype (G ⧸ N) := Fintype.ofFinite _
  let j : ℕ := (orderOf (z : G ⧸ N)).factorization l
  let n : ℕ := ordCompl[l] (orderOf (z : G ⧸ N))
  have h_order : orderOf (z : G ⧸ N) = l ^ j * n :=
    (Nat.ordProj_mul_ordCompl_eq_self (orderOf (z : G ⧸ N)) l).symm
  have hn : ¬l ∣ n :=
    hl.out.coprime_iff_not_dvd.mp (Nat.coprime_ordCompl hl.out (orderOf_pos (z : G ⧸ N)).ne')
  let S : Subgroup (G ⧸ N) := Subgroup.zpowers ((z : G ⧸ N) ^ l ^ j)
  have hS_card : Nat.card S = n := by
    rw [Nat.card_zpowers, orderOf_pow, h_order, Nat.gcd_eq_right (dvd_mul_right _ _),
      Nat.mul_div_cancel_left _ (pow_pos hl.out.pos j)]
  have central (g : G) : Commute (z : G ⧸ N) g :=
    commutatorElement_eq_one_iff_commute.mp ((QuotientGroup.eq_one_iff _).mpr (hz_central g))
  refine ⟨S, j, ⟨?_⟩, Subgroup.mem_zpowers _, by rwa [hS_card]⟩
  rintro _ ⟨i, rfl⟩ ⟨g⟩
  exact ⟨i, eq_mul_inv_of_mul_eq (((central g).pow_left _).zpow_left i)⟩

end TauCeti
