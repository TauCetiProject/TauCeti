module

public import TauCeti.Topology.Algebra.Group.Profinite.CompletedGroupAlgebra.PowerSeries
public import TauCeti.Topology.Algebra.Group.Profinite.ProP.BinomialSeries

/-!
# Division in a completed group algebra along a character

For a continuous character `χ : Γ → ℤ_pˣ` of a commutative pro-`p` group, an element `δ` in the
closed subgroup generated by `γ` is a `p`-adic power of `γ`. If `χ δ = -s`, the coefficient
`s + [δ]` is divisible by `[γ] - χ γ` in `ℤ_p[[Γ]]`. This turns character equations into
coefficient factorizations, without choosing the exponent expressing `δ` as a power of `γ`.
It applies in particular to the coefficients of a Demushkin relator in the abelianized
orientation kernel.

The division uses the power-series criterion at `χ γ - 1`, a topologically nilpotent
`p`-adic integer, and the scalar and completed-algebra evaluations of the binomial series.

## References

* J. P. Labute, *Classification of Demushkin groups*, Canad. J. Math. 19 (1967), §4, p. 122.
-/

public section

namespace TauCeti.completedGroupAlgebra

variable {p : ℕ} [Fact p.Prime] {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
  [IsTopologicalGroup Γ] [CompactSpace Γ] [TotallyDisconnectedSpace Γ] [IsMulCommutative Γ]

/-- A coefficient `s + [δ]` whose character value vanishes is divisible by `[γ] - χ γ`,
provided `δ` lies in the closed subgroup generated by `γ`. -/
theorem of_sub_algebraMap_dvd_algebraMap_add_of_mem (hΓ : IsProP p Γ)
    (χ : Γ →ₜ* ℤ_[p]ˣ) {γ δ : Γ}
    (hδ : δ ∈ (Subgroup.closure {γ}).topologicalClosure) {s : ℤ_[p]}
    (hs : (χ δ : ℤ_[p]) = -s) :
    of ℤ_[p] Γ γ - algebraMap ℤ_[p] (completedGroupAlgebra ℤ_[p] Γ) (χ γ : ℤ_[p]) ∣
      algebraMap ℤ_[p] (completedGroupAlgebra ℤ_[p] Γ) s + of ℤ_[p] Γ δ := by
  obtain ⟨l, rfl⟩ := hΓ.mem_topologicalClosure_closure_singleton_iff.mp hδ
  have hc : (p : ℤ_[p]) ∣ (χ γ : ℤ_[p]) - 1 :=
    Huber.PadicInt.isTopologicallyNilpotent_iff_dvd.mp (hΓ.hasEval_coe_apply_sub_one χ γ)
  have heval : PowerSeries.aeval (Huber.PadicInt.isTopologicallyNilpotent_iff_dvd.mpr hc)
      (PowerSeries.binomialSeries ℤ_[p] l) = -s := by
    rw [hΓ.aeval_binomialSeries χ γ l, hs]
  simpa only [add_sub_cancel] using
    of_sub_algebraMap_dvd_algebraMap_add_of_padicPow hΓ γ hc heval

end TauCeti.completedGroupAlgebra

namespace TauCeti.IsProP

variable {p : ℕ} [Fact p.Prime] {G : Type*} [Group G] [TopologicalSpace G]
  [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G]

/-- In the completed group algebra of a character quotient, every coefficient `s + [z]`
with `χ z = -s` is divisible by `[y] - χ y` when `χ y` topologically generates the character
image. -/
theorem of_sub_algebraMap_dvd_algebraMap_add_of_range (hG : IsProP p G)
    (χ : G →ₜ* ℤ_[p]ˣ) (y : G)
    (hrange : χ.toMonoidHom.range = (Subgroup.closure {χ y}).topologicalClosure)
    (z : G) {s : ℤ_[p]} (hs : (χ z : ℤ_[p]) = -s) :
    haveI := χ.isClosed_ker
    completedGroupAlgebra.of ℤ_[p] (G ⧸ χ.toMonoidHom.ker) (y : G ⧸ χ.toMonoidHom.ker) -
        algebraMap ℤ_[p] (completedGroupAlgebra ℤ_[p] (G ⧸ χ.toMonoidHom.ker)) (χ y : ℤ_[p]) ∣
      algebraMap ℤ_[p] (completedGroupAlgebra ℤ_[p] (G ⧸ χ.toMonoidHom.ker)) s +
        completedGroupAlgebra.of ℤ_[p] (G ⧸ χ.toMonoidHom.ker) (z : G ⧸ χ.toMonoidHom.ker) := by
  have := χ.isClosed_ker
  have : IsMulCommutative (G ⧸ χ.toMonoidHom.ker) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr
      (Abelianization.commutator_subset_ker _)
  let κ : (G ⧸ χ.toMonoidHom.ker) →ₜ* ℤ_[p]ˣ :=
    { toMonoidHom := QuotientGroup.kerLift χ.toMonoidHom
      continuous_toFun := (QuotientGroup.isQuotientMap_mk _).continuous_iff.mpr χ.continuous }
  have hκ (t : G) : κ (t : G ⧸ χ.toMonoidHom.ker) = χ t :=
    QuotientGroup.kerLift_mk χ.toMonoidHom t
  -- The injective character on the quotient identifies its closed cyclic subgroup with
  -- the entire character image, so the chosen class generates the quotient.
  have hgen : (Subgroup.closure {(y : G ⧸ χ.toMonoidHom.ker)}).topologicalClosure = ⊤ := by
    apply Subgroup.map_injective (QuotientGroup.kerLift_injective χ.toMonoidHom)
    rw [κ.toMonoidHom.map_topologicalClosure κ.continuous _
      (Subgroup.isClosed_topologicalClosure _).isCompact, MonoidHom.map_closure,
      Set.image_singleton]
    simp only [ContinuousMonoidHom.coe_toMonoidHom, MonoidHom.coe_ofClass, hκ]
    rw [← hrange, Subgroup.map_top]
    have hcomp : (QuotientGroup.kerLift χ.toMonoidHom).comp
        (QuotientGroup.mk' χ.toMonoidHom.ker) = χ.toMonoidHom :=
      MonoidHom.ext hκ
    calc
      χ.toMonoidHom.range =
          ((QuotientGroup.kerLift χ.toMonoidHom).comp
            (QuotientGroup.mk' χ.toMonoidHom.ker)).range := congrArg MonoidHom.range hcomp.symm
      _ = _ := by
        rw [MonoidHom.range_comp,
          MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective _), Subgroup.map_top]
        -- `χ.toMonoidHom` and the class-coerced homomorphism in `map_top` have the same fields.
        rfl
  exact completedGroupAlgebra.of_sub_algebraMap_dvd_algebraMap_add_of_mem
    (hG.quotient χ.toMonoidHom.ker) κ (hgen ▸ Subgroup.mem_top (z : G ⧸ χ.toMonoidHom.ker))
    (hs : (κ (z : G ⧸ χ.toMonoidHom.ker) : ℤ_[p]) = -s)

end TauCeti.IsProP
