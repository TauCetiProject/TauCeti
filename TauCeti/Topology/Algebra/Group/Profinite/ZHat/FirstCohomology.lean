public import TauCeti.Topology.Algebra.Group.Profinite.ZHat.Extension

/-!
# First continuous cohomology of the profinite integers

Let `M` be a profinite additive group carrying a continuous action of the profinite integers
`zHat`. Evaluation at the canonical topological generator `zHat.gen` identifies the continuous
`1`-cocycles `Z¹(ℤ̂, M)` with `M` (`TauCeti.zHat.z1Equiv`): injectivity comes from topological
generation by `zHat.gen`, while for any `m ∈ M` the universal property `TauCeti.zHat.lift`
applied to `⟨m, zHat.gen⟩` in the profinite semidirect product `M ⋊ ℤ̂` produces the continuous
crossed homomorphism taking `zHat.gen` to `m`.

Under this identification the `1`-coboundaries `B¹(ℤ̂, M)` correspond to the image of
`gen - 1 : M →+ M` (`TauCeti.zHat.genSubOneHom`), descending to the coinvariant presentation
`H¹(ℤ̂, M) ≃+ M ⧸ (gen - 1)M` (`TauCeti.zHat.h1EquivQuotient`). Because `ℤ̂` is topologically
generated by `zHat.gen`, the kernel of `gen - 1` on any `T₁` module is `H⁰(ℤ̂, M) = M^{ℤ̂}`
(`TauCeti.zHat.ker_genSubOneHom`). When `M` is finite, comparing the index and cardinality of the
image of `gen - 1` yields Herbrand's equality `#H¹(ℤ̂, M) = #H⁰(ℤ̂, M)`
(`TauCeti.zHat.natCard_H1_eq_natCard_H0`). Transporting along an isomorphism `G ≃ₜ* ℤ̂` transfers
`H²`-vanishing, finiteness of `H¹`, and `#H¹ = #H⁰` directly to any procyclic profinite group `G`.

## Main definitions

* `TauCeti.zHat.genSubOneHom`: the endomorphism `m ↦ zHat.gen • m - m` of a `ℤ̂`-module `M`.
* `TauCeti.zHat.z1Equiv`: evaluation at `zHat.gen` as an additive equivalence
  `Z¹(ℤ̂, M) ≃+ M` for a profinite `ℤ̂`-module `M`.
* `TauCeti.zHat.h1EquivQuotient`: the coinvariant presentation
  `H¹(ℤ̂, M) ≃+ M ⧸ (genSubOneHom M).range` for a profinite `ℤ̂`-module `M`.

## Main results

* `TauCeti.zHat.mem_H0_iff_gen_smul_eq`, `TauCeti.zHat.ker_genSubOneHom`: an element of a `T₁`
  continuous `ℤ̂`-module is fixed by `ℤ̂` if and only if it is fixed by `zHat.gen`.
* `TauCeti.zHat.finite_H1`: `H¹(ℤ̂, M)` is finite for every finite profinite `ℤ̂`-module `M` (in
  particular every finite discrete `ℤ̂`-module).
* `TauCeti.zHat.natCard_H1_eq_natCard_H0`: `#H¹(ℤ̂, M) = #H⁰(ℤ̂, M)` for every finite profinite
  `ℤ̂`-module `M`.
* `TauCeti.zHat.subsingleton_H2_of_continuousMulEquiv`,
  `TauCeti.zHat.finite_H1_of_continuousMulEquiv`,
  `TauCeti.zHat.natCard_H1_eq_natCard_H0_of_continuousMulEquiv`: transport along `G ≃ₜ* ℤ̂`.

## References

* J.-P. Serre, *Local Fields*, Chapter XIII, §1, Proposition 1.
* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, 2nd ed., Proposition 1.7.7.
* J. S. Milne, *Arithmetic Duality Theorems*, 2nd ed., Chapter I, Lemma 2.5.
-/

public section

namespace TauCeti.zHat

open ContCohomology

universe u v w

/-! ### Invariants and the endomorphism `gen - 1` -/

section GenSubOne

variable (M : Type v) [AddCommGroup M] [DistribMulAction zHat.{u} M]

/-- The endomorphism `m ↦ zHat.gen • m - m` of a `ℤ̂`-module `M`, whose kernel is `H⁰(ℤ̂, M)` on
`T₁` modules and whose cokernel computes `H¹(ℤ̂, M)` on profinite modules. -/
noncomputable def genSubOneHom : M →+ M where
  toFun m := (gen : zHat.{u}) • m - m
  map_zero' := by simp
  map_add' m n := by simp only [smul_add]; abel

variable {M}

/-- Applying `genSubOneHom` evaluates `d⁰` at `zHat.gen`. -/
@[simp]
theorem genSubOneHom_apply (m : M) :
    genSubOneHom.{u} M m = (gen : zHat.{u}) • m - m :=
  (rfl)

/-- The subgroup generated by `zHat.gen` is dense in `ℤ̂`. -/
theorem topologicalClosure_closure_singleton_gen :
    (Subgroup.closure ({(gen : zHat.{u})} : Set zHat.{u})).topologicalClosure = ⊤ := by
  have hle : (ofInt : Multiplicative ℤ →* zHat.{u}).range ≤
      Subgroup.closure ({(gen : zHat.{u})} : Set zHat.{u}) := by
    rintro _ ⟨z, rfl⟩
    rw [← ofAdd_toAdd z, ofInt_ofAdd]
    exact Subgroup.zpow_mem _ (Subgroup.subset_closure rfl) z.toAdd
  rw [← SetLike.coe_set_eq, Subgroup.topologicalClosure_coe, Subgroup.coe_top,
    Set.eq_univ_iff_forall]
  intro x
  exact closure_mono hle (denseRange_ofInt x)

/-- An element of a `T₁` continuous `ℤ̂`-module is fixed by all of `ℤ̂` if and only if it is fixed
by the topological generator `zHat.gen`. -/
theorem mem_H0_iff_gen_smul_eq [TopologicalSpace M] [T1Space M] [ContinuousSMul zHat.{u} M]
    {m : M} : m ∈ H0 zHat.{u} M ↔ (gen : zHat.{u}) • m = m := by
  rw [FixedPoints.mem_addSubgroup]
  refine ⟨fun hm ↦ hm gen, fun hm g ↦ ?_⟩
  let S : Subgroup zHat.{u} := MulAction.stabilizer zHat.{u} m
  have hgen : (gen : zHat.{u}) ∈ S := hm
  have hrange : Set.range (ofInt : Multiplicative ℤ →* zHat.{u}) ⊆ (S : Set zHat.{u}) := by
    rintro _ ⟨z, rfl⟩
    rw [← ofAdd_toAdd z, ofInt_ofAdd]
    exact S.zpow_mem hgen z.toAdd
  have hclosed : IsClosed (S : Set zHat.{u}) :=
    isClosed_singleton.preimage (continuous_id.smul continuous_const)
  exact hclosed.closure_subset_iff.2 hrange (denseRange_ofInt g)

/-- On a `T₁` continuous `ℤ̂`-module, the kernel of `gen - 1` is `H⁰(ℤ̂, M)`. -/
@[simp]
theorem ker_genSubOneHom [TopologicalSpace M] [T1Space M] [ContinuousSMul zHat.{u} M] :
    (genSubOneHom.{u} M).ker = H0 zHat.{u} M := by
  ext m
  rw [AddMonoidHom.mem_ker, genSubOneHom_apply, sub_eq_zero, mem_H0_iff_gen_smul_eq]

end GenSubOne

/-! ### Continuous `1`-cocycles by evaluation at the generator -/

section Cocycles

variable (M : Type v) [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M]
  [DistribMulAction zHat.{u} M]

/-- Evaluation of a continuous `1`-cocycle on `ℤ̂` at the topological generator `zHat.gen`. -/
noncomputable def evalZ1Gen : Z1 zHat.{u} M →+ M where
  toFun f := (f : zHat.{u} → M) gen
  map_zero' := rfl
  map_add' _ _ := rfl

variable {M}

/-- Evaluating `evalZ1Gen` returns the value of the cocycle at `zHat.gen`. -/
@[simp]
theorem evalZ1Gen_apply (f : Z1 zHat.{u} M) :
    evalZ1Gen.{u} M f = (f : zHat.{u} → M) gen :=
  (rfl)

/-- Evaluation at `zHat.gen` is injective on `Z¹(ℤ̂, M)` whenever `M` is `T₁`. -/
theorem evalZ1Gen_injective [T1Space M] : Function.Injective (evalZ1Gen.{u} M) := by
  intro f₁ f₂ h
  ext1
  exact eq_of_mem_Z1_of_eqOn_of_topologicalClosure_closure_eq_top f₁.2 f₂.2
    topologicalClosure_closure_singleton_gen (Set.eqOn_singleton.2 h)

section Profinite

variable [CompactSpace M] [TotallyDisconnectedSpace M] [ContinuousSMul zHat.{u} M]

/-- For every element `m` of a profinite `ℤ̂`-module `M`, there is a continuous `1`-cocycle on `ℤ̂`
taking `zHat.gen` to `m`, constructed as the `M`-component of the continuous section of `M ⋊ ℤ̂`
sending `zHat.gen` to `⟨m, zHat.gen⟩`. -/
theorem evalZ1Gen_surjective : Function.Surjective (evalZ1Gen.{u} M) := by
  intro m
  let α : FactorSet zHat.{u} (Multiplicative M) :=
    FactorSet.trivial zHat.{u} (Multiplicative M)
  let : IsTopologicalGroup α.Extension :=
    FactorSet.Extension.isTopologicalGroup FactorSet.continuous_trivial
  let e : α.Extension := ⟨Multiplicative.ofAdd m, gen⟩
  let σ : zHat.{u} →ₜ* α.Extension := lift e
  let π : α.Extension →ₜ* zHat.{u} := ⟨α.rightHom, α.continuous_rightHom⟩
  have hπ : π.comp σ = ContinuousMonoidHom.id zHat.{u} :=
    hom_ext (by simp [π, σ, e])
  have hright : ∀ g : zHat.{u}, (σ g).right = g := fun g ↦ by
    simpa [π] using DFunLike.congr_fun hπ g
  let c : zHat.{u} → M := fun g ↦ Multiplicative.toAdd (σ g).left
  have hc_cont : Continuous c :=
    continuous_toAdd.comp (FactorSet.Extension.continuous_left.comp σ.continuous)
  have hc_coc : groupCohomology.IsCocycle₁ c := fun g h ↦ by
    have hmul := congrArg (fun x : α.Extension ↦ Multiplicative.toAdd x.left) (map_mul σ g h)
    simpa only [c, α, FactorSet.Extension.mul_left, FactorSet.trivial_apply, mul_one, toAdd_mul,
      Multiplicative.toAdd_smul, hright g, add_comm] using hmul
  refine ⟨⟨c, mem_Z1_iff.2 ⟨hc_cont, hc_coc⟩⟩, ?_⟩
  simp [evalZ1Gen_apply, c, σ, e]

variable (M) in
/-- **Continuous `1`-cocycles on `ℤ̂` with values in a profinite module `M` are isomorphic to `M`**
via evaluation at the generator `zHat.gen`. -/
noncomputable def z1Equiv : Z1 zHat.{u} M ≃+ M :=
  AddEquiv.ofBijective (evalZ1Gen.{u} M) ⟨evalZ1Gen_injective, evalZ1Gen_surjective⟩

/-- `z1Equiv` evaluates a continuous `1`-cocycle at `zHat.gen`. -/
@[simp]
theorem z1Equiv_apply (f : Z1 zHat.{u} M) :
    z1Equiv.{u} M f = (f : zHat.{u} → M) gen :=
  (rfl)

/-- The inverse of `z1Equiv` produces the unique continuous `1`-cocycle taking `zHat.gen` to `m`. -/
@[simp]
theorem z1Equiv_symm_apply_gen (m : M) :
    (((z1Equiv.{u} M).symm m : Z1 zHat.{u} M) : zHat.{u} → M) gen = m :=
  (z1Equiv.{u} M).apply_symm_apply m

/-- Under `z1Equiv`, the subgroup of `1`-coboundaries inside `Z¹(ℤ̂, M)` is the preimage of the
range of `gen - 1`. -/
theorem ker_mk_comp_z1Equiv :
    ((QuotientAddGroup.mk' (genSubOneHom.{u} M).range).comp
        (z1Equiv.{u} M).toAddMonoidHom).ker =
      (B1 zHat.{u} M).addSubgroupOf (Z1 zHat.{u} M) := by
  ext f
  simp only [AddMonoidHom.mem_ker, AddMonoidHom.coe_comp, Function.comp_apply,
    QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff, AddMonoidHom.mem_range,
    AddEquiv.toAddMonoidHom_eq_coe, AddMonoidHom.coe_ofClass, z1Equiv_apply,
    AddSubgroup.mem_addSubgroupOf, mem_B1_iff]
  constructor
  · rintro ⟨m, hm⟩
    refine ⟨m, ?_⟩
    have hcoc : f = ⟨d0 zHat.{u} M m, B1_le_Z1 zHat.{u} M (d0_mem_B1 m)⟩ :=
      (z1Equiv.{u} M).injective (by simpa [z1Equiv_apply, genSubOneHom_apply] using hm.symm)
    intro g
    simpa [d0_apply] using (congrFun (congrArg Subtype.val hcoc) g).symm
  · rintro ⟨m, hm⟩
    exact ⟨m, hm gen⟩

end Profinite

end Cocycles

/-! ### Coinvariant presentation and cardinality of `H¹(ℤ̂, M)` -/

section FirstCohomology

variable (M : Type v) [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M]
  [CompactSpace M] [TotallyDisconnectedSpace M] [DistribMulAction zHat.{u} M]
  [ContinuousSMul zHat.{u} M]

/-- **Coinvariant presentation of `H¹(ℤ̂, M)`.** Evaluation at `zHat.gen` descends from `Z¹(ℤ̂, M)`
to an additive isomorphism `H¹(ℤ̂, M) ≃+ M ⧸ (gen - 1)M` for every profinite `ℤ̂`-module `M`. -/
noncomputable def h1EquivQuotient :
    H1 zHat.{u} M ≃+ M ⧸ (genSubOneHom.{u} M).range :=
  AddEquiv.ofBijective
    (QuotientAddGroup.lift ((B1 zHat.{u} M).addSubgroupOf (Z1 zHat.{u} M))
      ((QuotientAddGroup.mk' (genSubOneHom.{u} M).range).comp (z1Equiv.{u} M).toAddMonoidHom)
      (fun _ hf ↦ (ker_mk_comp_z1Equiv (M := M)).symm ▸ hf))
    ⟨by
      rw [injective_iff_map_eq_zero]
      intro x hx
      induction x using QuotientAddGroup.induction_on with
      | _ f =>
        rw [QuotientAddGroup.eq_zero_iff, ← ker_mk_comp_z1Equiv (M := M)]
        exact hx,
     fun q ↦ QuotientAddGroup.induction_on q fun m ↦
      ⟨((z1Equiv.{u} M).symm m : H1 zHat.{u} M),
        congrArg QuotientAddGroup.mk (z1Equiv_symm_apply_gen m)⟩⟩

variable {M}

/-- `h1EquivQuotient` sends the cohomology class of a cocycle `f` to the coset of `f gen`. -/
@[simp]
theorem h1EquivQuotient_mk (f : Z1 zHat.{u} M) :
    h1EquivQuotient.{u} M (f : H1 zHat.{u} M) =
      QuotientAddGroup.mk ((f : zHat.{u} → M) gen) :=
  (rfl)

/-- The inverse of `h1EquivQuotient` sends the coset of `m` to the class of `(z1Equiv M).symm m`. -/
@[simp]
theorem h1EquivQuotient_symm_mk (m : M) :
    (h1EquivQuotient.{u} M).symm (QuotientAddGroup.mk m) =
      ((z1Equiv.{u} M).symm m : H1 zHat.{u} M) := by
  apply (h1EquivQuotient.{u} M).injective
  simp

/-- `H¹(ℤ̂, M)` is finite whenever `M` is a finite profinite (in particular, finite discrete)
`ℤ̂`-module. -/
instance finite_H1 [Finite M] : Finite (H1 zHat.{u} M) :=
  Finite.of_equiv _ (h1EquivQuotient.{u} M).symm.toEquiv

variable (M) in
/-- **Herbrand quotient of `ℤ̂` on a finite module.** For every finite profinite (in particular,
finite discrete) continuous `ℤ̂`-module `M`, `#H¹(ℤ̂, M) = #H⁰(ℤ̂, M)`. -/
theorem natCard_H1_eq_natCard_H0 [Finite M] :
    Nat.card (H1 zHat.{u} M) = Nat.card (H0 zHat.{u} M) := by
  rw [Nat.card_congr (h1EquivQuotient.{u} M).toEquiv]
  have hker := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup (genSubOneHom.{u} M).ker
  rw [Nat.card_congr (QuotientAddGroup.quotientKerEquivRange (genSubOneHom.{u} M)).toEquiv,
    ker_genSubOneHom] at hker
  have hrange := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup (genSubOneHom.{u} M).range
  have hpos : 0 < Nat.card (genSubOneHom.{u} M).range := Nat.card_pos
  exact Nat.mul_right_cancel hpos (hrange.symm.trans (hker.trans (mul_comm _ _)))

end FirstCohomology

/-! ### Transport along an isomorphism with `ℤ̂` -/

section ChangeOfGroup

variable {G : Type w} [Monoid G] [TopologicalSpace G]
  (M : Type v) [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M]
  [CompactSpace M] [TotallyDisconnectedSpace M] [DistribMulAction G M] [ContinuousSMul G M]

/-- If `G` is topologically isomorphic to `ℤ̂`, its explicit second continuous cohomology with
coefficients in any profinite continuous `G`-module vanishes. -/
theorem subsingleton_H2_of_continuousMulEquiv [ContinuousMul G] (e : G ≃ₜ* zHat.{u}) :
    Subsingleton (H2 G M) := by
  let _ : DistribMulAction zHat.{u} M := DistribMulAction.compHom M (e.symm : zHat.{u} →* G)
  have _ : ContinuousSMul zHat.{u} M :=
    ⟨(e.symm.continuous.comp continuous_fst).smul continuous_snd⟩
  exact (explicitMap2Equiv zHat.{u} M G M e (AddEquiv.refl M) continuous_id continuous_id
    fun g m ↦ congrArg (· • m) (e.symm_apply_apply g)).symm.injective.subsingleton

/-- If `G` is topologically isomorphic to `ℤ̂`, `H¹(G, M)` is finite for every finite profinite
`G`-module `M`. -/
theorem finite_H1_of_continuousMulEquiv [Finite M] (e : G ≃ₜ* zHat.{u}) :
    Finite (H1 G M) := by
  let _ : DistribMulAction zHat.{u} M := DistribMulAction.compHom M (e.symm : zHat.{u} →* G)
  have _ : ContinuousSMul zHat.{u} M :=
    ⟨(e.symm.continuous.comp continuous_fst).smul continuous_snd⟩
  exact Finite.of_equiv _
    (explicitMap1Equiv zHat.{u} M G M e (AddEquiv.refl M) continuous_id continuous_id
      fun g m ↦ congrArg (· • m) (e.symm_apply_apply g)).toEquiv

/-- If `G` is topologically isomorphic to `ℤ̂`, `#H¹(G, M) = #H⁰(G, M)` for every finite profinite
`G`-module `M`. -/
theorem natCard_H1_eq_natCard_H0_of_continuousMulEquiv [Finite M] (e : G ≃ₜ* zHat.{u}) :
    Nat.card (H1 G M) = Nat.card (H0 G M) := by
  let _ : DistribMulAction zHat.{u} M := DistribMulAction.compHom M (e.symm : zHat.{u} →* G)
  have _ : ContinuousSMul zHat.{u} M :=
    ⟨(e.symm.continuous.comp continuous_fst).smul continuous_snd⟩
  have h1 : Nat.card (H1 G M) = Nat.card (H1 zHat.{u} M) :=
    (Nat.card_congr (explicitMap1Equiv zHat.{u} M G M e (AddEquiv.refl M)
      continuous_id continuous_id fun g m ↦ congrArg (· • m) (e.symm_apply_apply g)).toEquiv).symm
  have h0 : Nat.card (H0 zHat.{u} M) = Nat.card (H0 G M) :=
    Nat.card_congr (Equiv.ofBijective
      (explicitMap0 zHat.{u} M (e : G →* zHat.{u}) (AddMonoidHom.id M)
        fun g m ↦ congrArg (· • m) (e.symm_apply_apply g))
      (explicitMap0_bijective zHat.{u} M (e : G →* zHat.{u}) e.surjective
        (AddMonoidHom.id M) Function.bijective_id
        fun g m ↦ congrArg (· • m) (e.symm_apply_apply g)))
  exact (h1.trans (natCard_H1_eq_natCard_H0 M)).trans h0

end ChangeOfGroup

end TauCeti.zHat
