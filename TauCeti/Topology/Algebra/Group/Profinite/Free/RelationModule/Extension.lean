module

public import TauCeti.RepresentationTheory.Homological.ContCohomology.CohomologicalDimension.ClassModule.Quotient
public import TauCeti.Topology.Algebra.ContinuousMonoidHom.QuotientKerEquiv
public import TauCeti.Topology.Algebra.Group.Profinite.Free.Basic
public import TauCeti.Topology.Algebra.GroupExtension.Comparison

/-!
# Free class-module extensions over their presented quotient

Let `g : ι → G` generate a profinite group topologically, `F` be the free profinite group on
`ι`, and `R = ker(lift g)`. The first isomorphism theorem identifies `F/R` with `G`. Transporting
the quotient action on `Rᵃᵇ(p)` and the class-module extension along this identification gives
an extension over `G`, with projection induced by `lift g`.

Choosing lifts of the `g i` to any profinite extension of `G` whose kernel is an abelian pro-`p`
group gives a continuous comparison with it over the identity of `G`, since the relation group
lands in the kernel and so kills the kernel of `R → Rᵃᵇ(p)`. Thus the free extension can be used
in the extension-lifting criterion against such an extension.

If moreover the class of the target extension generates its second cohomology group, of
`p`-power order, then a continuous equivariant surjection `Rᵃᵇ(p) → N` that is bijective on `H²`
lifts, after a prime-to-`p` power correction, to a surjection of extensions. The total group of
the target is then topologically generated by lifts of the `g i`, by
`freeProfiniteGroup.exists_topologicalClosure_closure_range_eq_top_of_bijective_explicitCoeff2`.
For a finite quotient `G = G_K/V` of an absolute Galois group, with target the class-module
extension `G_K / ker(V → Vᵃᵇ(p))`, this is the finite-level generation step of the proof of
NSW (7.4.1).

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, 2nd ed.,
  proof of (7.4.1).
-/

public noncomputable section

namespace TauCeti.freeProfiniteGroup

universe u

variable (p : ℕ) {ι G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [CompactSpace G] [TotallyDisconnectedSpace G] {g : ι → G}
  (hg : Dense (Subgroup.closure (Set.range g) : Set G))

/-- The action of the presented group on its pro-`p` relation group, transported from
the conjugation action of `F/ker(lift g)` along the first isomorphism theorem. -/
abbrev presentationClassModuleAction :
    MulDistribMulAction G
      (abelianizationProP p (freeProfiniteGroup ι) (lift g : freeProfiniteGroup ι →* G).ker) :=
  MulDistribMulAction.compHom _
    ((lift g).quotientKerEquivOfSurjective (lift_surjective hg)).symm.toMulEquiv.toMonoidHom

/-- The transported action is conjugation by the corresponding class in `F/ker(lift g)`. -/
theorem presentationClassModuleAction_smul (h : G)
    (x : abelianizationProP p (freeProfiniteGroup ι) (lift g : freeProfiniteGroup ι →* G).ker) :
    letI := presentationClassModuleAction p hg
    h • x = ((lift g).quotientKerEquivOfSurjective (lift_surjective hg)).symm h • x :=
  (rfl)

/-- The image of a free-group element acts by its class in `F/ker(lift g)`. -/
@[simp]
theorem presentationClassModuleAction_lift_smul (f : freeProfiniteGroup ι)
    (x : abelianizationProP p (freeProfiniteGroup ι) (lift g : freeProfiniteGroup ι →* G).ker) :
    letI := presentationClassModuleAction p hg
    lift g f • x =
      (QuotientGroup.mk f :
        freeProfiniteGroup ι ⧸ (lift g : freeProfiniteGroup ι →* G).ker) • x := by
  rw [presentationClassModuleAction_smul,
    ContinuousMonoidHom.quotientKerEquivOfSurjective_symm_apply]

/-- The transported conjugation action on the pro-`p` relation group is jointly continuous. -/
theorem continuousSMul_presentationClassModuleAction :
    letI := presentationClassModuleAction p hg
    ContinuousSMul G
      (abelianizationProP p (freeProfiniteGroup ι) (lift g : freeProfiniteGroup ι →* G).ker) :=
  MulAction.continuousSMul_compHom
    ((lift g).quotientKerEquivOfSurjective (lift_surjective hg)).symm.continuous

/-- The class-module extension of a free presentation, with quotient the presented group.
Its total group remains the canonical quotient `F/ker(R → Rᵃᵇ(p))`. -/
abbrev presentationProfiniteExtension :
    letI := presentationClassModuleAction p hg
    ProfiniteGroupExtension G
      (abelianizationProP p (freeProfiniteGroup ι) (lift g : freeProfiniteGroup ι →* G).ker) := by
  letI := presentationClassModuleAction p hg
  letI : IsClosed ((lift g : freeProfiniteGroup ι →* G).ker : Set (freeProfiniteGroup ι)) :=
    (lift g).isClosed_ker
  exact (abelianizationProPProfiniteExtension p (freeProfiniteGroup ι)
    (lift g : freeProfiniteGroup ι →* G).ker).relabelQuotient
    ((lift g).quotientKerEquivOfSurjective (lift_surjective hg))
    (fun q x ↦ by
      rw [presentationClassModuleAction_smul, ContinuousMulEquiv.symm_apply_apply])

/-- The projection of the free presentation extension sends the class of `f` to `lift g f`. -/
theorem presentationProfiniteExtension_rightHom_mk (f : freeProfiniteGroup ι) :
    letI := presentationClassModuleAction p hg
    (presentationProfiniteExtension p hg).toGroupExtension.rightHom (QuotientGroup.mk f) =
      lift g f := by
  let := presentationClassModuleAction p hg
  simp

section Comparison

variable {N : Type u} [CommGroup N] [TopologicalSpace N] [MulDistribMulAction G N]

/-- The free class-module extension admits a continuous comparison, over the identity of `G`, with
every profinite extension of `G` whose kernel is an abelian pro-`p` group. No surjectivity of the
comparison is asserted. -/
theorem exists_presentationProfiniteExtension_comparison (Y : ProfiniteGroupExtension G N)
    (hN : IsProP p N) :
    letI := presentationClassModuleAction p hg
    ∃ ψ : (presentationProfiniteExtension p hg).E →ₜ* Y.E,
      Y.toGroupExtension.rightHom.comp ψ.toMonoidHom =
        (presentationProfiniteExtension p hg).toGroupExtension.rightHom := by
  let := presentationClassModuleAction p hg
  let S := Y.toGroupExtension
  let π : Y.E →ₜ* G := ⟨S.rightHom, Y.continuous_rightHom⟩
  let y : ι → Y.E := fun i ↦ (S.rightHom_surjective (g i)).choose
  have hπ (x : freeProfiniteGroup ι) : S.rightHom (lift y x) = lift g x := by
    have h : π.comp (lift y) = lift g := by
      rw [comp_lift]
      congr 1
      funext i
      exact (S.rightHom_surjective (g i)).choose_spec
    exact DFunLike.congr_fun h x
  -- The relation group lands in the kernel `S.inl.range = S.rightHom.ker`, an abelian
  -- pro-`p` subgroup, so `lift y` kills the kernel of `R → Rᵃᵇ(p)`.
  have hR : (lift g : freeProfiniteGroup ι →* G).ker ≤ S.inl.range.comap (lift y) := by
    intro x hx
    rw [Subgroup.mem_comap, S.range_inl_eq_ker_rightHom, MonoidHom.mem_ker]
    exact (hπ x).trans hx
  have hclosed : IsClosed (S.inl.range : Set Y.E) := by
    rw [S.range_inl_eq_ker_rightHom]
    exact isClosed_singleton.preimage Y.continuous_rightHom
  have hpro : IsProP p S.inl.range :=
    hN.of_surjective S.inl.rangeRestrict (Y.continuous_inl.subtype_mk _)
      S.inl.rangeRestrict_surjective
  refine ⟨TauCeti.ContinuousMonoidHom.quotientLift _ (lift y)
    (abelianizationProPExtensionKernel_le_ker p _ (lift y) S.inl.range hclosed hpro hR), ?_⟩
  ext f
  refine Eq.trans ?_ (presentationProfiniteExtension_rightHom_mk p hg f).symm
  simpa using hπ f

open ContCohomology in
/-- **Generation of an extension by lifts of a presentation** (NSW, proof of (7.4.1)). Let `Y`
be a profinite extension of `G` by an abelian pro-`p` group `N` whose class generates
`H²(G, N)`, a group of `p`-power order. If a continuous equivariant surjection
`f : Rᵃᵇ(p) → N` is bijective on `H²`, then lifts of the `g i` to `Y` topologically generate its
total group. -/
theorem exists_topologicalClosure_closure_range_eq_top_of_bijective_explicitCoeff2 [Fact p.Prime]
    [IsTopologicalGroup N] [ContinuousSMul G N] [CompactSpace N] [TotallyDisconnectedSpace N]
    (Y : ProfiniteGroupExtension G N) (hN : IsProP p N)
    (hy : AddSubgroup.zmultiples Y.contCohomologyClass = ⊤)
    (hcard : ∃ r : ℕ, Nat.card (H2 G (Additive N)) = p ^ r) :
    letI := presentationClassModuleAction p hg
    haveI := continuousSMul_presentationClassModuleAction p hg
    ∀ (f : abelianizationProP p (freeProfiniteGroup ι)
        (lift g : freeProfiniteGroup ι →* G).ker →*[G] N) (hf : Continuous f),
      Function.Surjective f →
      Function.Bijective (explicitCoeff2 G _ f.toAdditive (f.continuous_toAdditive hf)) →
      ∃ y : ι → Y.E, (∀ i, Y.toGroupExtension.rightHom (y i) = g i) ∧
        (Subgroup.closure (Set.range y)).topologicalClosure = ⊤ := by
  let := presentationClassModuleAction p hg
  have := continuousSMul_presentationClassModuleAction p hg
  intro f hf hs hc
  have : CompactSpace (lift g : freeProfiniteGroup ι →* G).ker :=
    isCompact_iff_compactSpace.mp (lift g).isClosed_ker.isCompact
  let X := presentationProfiniteExtension p hg
  obtain ⟨φ, hφ⟩ := exists_presentationProfiniteExtension_comparison p hg Y hN
  obtain ⟨-, ψ, -, hψs, -, hψ⟩ :=
    X.exists_surjective_continuousMonoidHom_of_comparison Y φ hφ hN f hf hs hc hy hcard
  -- The composite `F → X.E → Y.E` is a continuous surjection carrying `of i` to a lift of `g i`.
  let π : freeProfiniteGroup ι →ₜ* Y.E :=
    ψ.comp (TauCeti.ContinuousMonoidHom.quotientMk _)
  refine ⟨fun i ↦ π (of i), fun i ↦ ?_, ?_⟩
  · refine (DFunLike.congr_fun hψ (QuotientGroup.mk (of i))).trans ?_
    rw [presentationProfiniteExtension_rightHom_mk, lift_of]
  · have hπ : Function.Surjective π := hψs.comp QuotientGroup.mk_surjective
    have hF : (Subgroup.closure (Set.range (of : ι → freeProfiniteGroup ι))).topologicalClosure =
        ⊤ := SetLike.coe_injective <| Subgroup.topologicalClosure_coe.trans
          (dense_closure_range_of ι).closure_eq
    have h := hπ.denseRange.topologicalClosure_map_subgroup (map_continuous π) hF
    rwa [MonoidHom.map_closure, ← Set.range_comp] at h

end Comparison

end TauCeti.freeProfiniteGroup
