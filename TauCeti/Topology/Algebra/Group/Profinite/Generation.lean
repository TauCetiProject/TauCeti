/-!
# Topological generation of profinite groups

A subset of a topological group *generates it topologically* when the subgroup it generates is
dense, that is when `(Subgroup.closure s).topologicalClosure = ⊤`. For a profinite group this
is a condition on the finite quotients alone: a subgroup is dense exactly when it surjects onto
every quotient by an open normal subgroup
(`Subgroup.topologicalClosure_eq_top_iff_forall_map_mk'`). That criterion is the whole content
of the notion, and everything else here is read off from it.

Topological *finite* generation — `TauCeti.IsTopologicallyFinitelyGenerated`, whose general API
is in `TauCeti/Topology/Algebra/Group/Generation.lean` — is likewise detected by the finite
quotients, but only in a *uniform* form: `G` is topologically finitely generated if and only if
the minimal number of generators of its finite quotients is bounded
(`isTopologicallyFinitelyGenerated_iff_exists_rank_le`). A bound on `Group.rank (G ⧸ U)` for
each open normal `U` separately says nothing, since each such quotient is finite.

## Main results

* `Subgroup.topologicalClosure_eq_top_iff_forall_map_mk'`: a subgroup of a profinite group is
  dense if and only if its image in every quotient by an open normal subgroup is everything.
* `TauCeti.topologicalClosure_closure_eq_top_iff`: the same, for the subgroup generated by a
  subset.
* `TauCeti.exists_topologicalClosure_closure_range_eq_top_of_rank_le`: a profinite group whose
  finite quotients are generated by `n` elements is topologically generated by an `n`-tuple.
* `TauCeti.rank_quotient_le_card_of_topologicalClosure_closure_eq_top`: conversely, a topological
  generating set bounds the rank of every quotient by an open normal subgroup.
* `TauCeti.isTopologicallyFinitelyGenerated_iff_exists_rank_le`: topological finite generation
  is exactly a uniform bound on the ranks of the finite quotients.

## References

* L. Ribes and P. Zalesskii, *Profinite Groups*, Section 2.5.
-/

public section

namespace TauCeti

section DenseSubgroups

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G]

/-- A subgroup of a profinite group is dense exactly when it surjects onto every quotient by an
open normal subgroup. Density is `topologicalClosure = ⊤`; the open normal subgroups are cofinal
among the open subgroups, so nothing finer than the finite quotients can be seen. -/
theorem _root_.Subgroup.topologicalClosure_eq_top_iff_forall_map_mk' (H : Subgroup G) :
    H.topologicalClosure = ⊤ ↔
      ∀ U : OpenNormalSubgroup G, H.map (QuotientGroup.mk' U.toSubgroup) = ⊤ := by
  refine ⟨fun h U ↦ ?_, fun h ↦ ?_⟩
  · rw [← Subgroup.map_topologicalClosure_quotient_eq, h]
    exact Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)
  · -- The joins `H ⊔ U` are all of `G`, and a closed subgroup is the infimum of those joins.
    have hsup : ∀ U : OpenNormalSubgroup G, H ⊔ U.toSubgroup = ⊤ := fun U ↦ by
      have hcomap := congrArg (Subgroup.comap (QuotientGroup.mk' U.toSubgroup)) (h U)
      rwa [Subgroup.comap_map_eq, QuotientGroup.ker_mk', Subgroup.comap_top] at hcomap
    refine (Subgroup.eq_iInf_sup_openNormalSubgroup _ H.isClosed_topologicalClosure).trans
      (eq_top_iff.mpr (le_iInf fun U ↦ ?_))
    exact (hsup U).ge.trans (sup_le_sup_right H.le_topologicalClosure _)

/-- A subset of a profinite group generates a dense subgroup exactly when its image generates
every quotient by an open normal subgroup. -/
theorem topologicalClosure_closure_eq_top_iff {s : Set G} :
    (Subgroup.closure s).topologicalClosure = ⊤ ↔
      ∀ U : OpenNormalSubgroup G,
        Subgroup.closure ((QuotientGroup.mk' U.toSubgroup) '' s) = ⊤ := by
  simp_rw [Subgroup.topologicalClosure_eq_top_iff_forall_map_mk', MonoidHom.map_closure]

end DenseSubgroups

section FiniteQuotients

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G]

/-- **Topological generation from the finite quotients.** If every finite quotient of a profinite
group `G` is generated by `n` elements, then `G` is topologically generated by an `n`-tuple.

The bound has to be uniform in the quotient: each `G ⧸ U` is finite, so a bound for a single `U`
carries no information. -/
theorem exists_topologicalClosure_closure_range_eq_top_of_rank_le {n : ℕ}
    (hrank : ∀ U : OpenNormalSubgroup G, Group.rank (G ⧸ U.toSubgroup) ≤ n) :
    ∃ g : Fin n → G, (Subgroup.closure (Set.range g)).topologicalClosure = ⊤ := by
  classical
  -- The compactness argument of Ribes and Zalesskii, Section 2.5: the `n`-tuples of `G` whose
  -- image generates `G ⧸ U` form a clopen subset `C U` of `Fin n → G`, because generating
  -- `G ⧸ U` is a condition on the image in the discrete space `Fin n → G ⧸ U`; the family is
  -- nonempty by hypothesis and directed downwards because `C (U ⊓ V) ⊆ C U ∩ C V`, so
  -- `TauCeti.nonempty_iInter_of_directed_nonempty_isClosed` produces a common point.
  have hneIdx : Nonempty (OpenNormalSubgroup G) := ⟨{ toOpenSubgroup := ⟨⊤, isOpen_univ⟩ }⟩
  set C : OpenNormalSubgroup G → Set (Fin n → G) := fun U ↦
    {g | Subgroup.closure (Set.range (⇑(QuotientGroup.mk' U.toSubgroup) ∘ g)) = ⊤} with hC
  have hmono : ∀ {U V : OpenNormalSubgroup G}, U ≤ V → C U ⊆ C V := by
    intro U V hUV g hg
    have hmap : (Subgroup.closure (Set.range (⇑(QuotientGroup.mk' U.toSubgroup) ∘ g))).map
        (QuotientGroup.mapOfLE hUV) = ⊤ := by
      rw [hg]
      exact Subgroup.map_top_of_surjective _ (QuotientGroup.mapOfLE_surjective hUV)
    rw [MonoidHom.map_closure, ← Set.range_comp] at hmap
    simpa [hC, Function.comp_def] using hmap
  have hdir : Directed (· ⊇ ·) C := fun U V ↦
    ⟨U ⊓ V, hmono inf_le_left, hmono inf_le_right⟩
  have hclosed : ∀ U : OpenNormalSubgroup G, IsClosed (C U) := by
    intro U
    have hcont : Continuous fun g : Fin n → G ↦ ⇑(QuotientGroup.mk' U.toSubgroup) ∘ g :=
      continuous_pi fun i ↦
        (QuotientGroup.continuous_mk (N := U.toSubgroup)).comp (continuous_apply i)
    exact (isClosed_discrete
      {f : Fin n → G ⧸ U.toSubgroup | Subgroup.closure (Set.range f) = ⊤}).preimage hcont
  have hne : ∀ U : OpenNormalSubgroup G, (C U).Nonempty := by
    intro U
    obtain ⟨S, hScard, hSgen⟩ := Group.rank_spec (G ⧸ U.toSubgroup)
    have hcard : S.card ≤ n := hScard.trans_le (hrank U)
    -- Spread the `S.card` generators over `Fin n`, filling the unused slots with `1`.
    let e : S ↪ Fin n := S.equivFin.toEmbedding.trans (Fin.castLEEmb hcard)
    set f : Fin n → G ⧸ U.toSubgroup :=
      Function.extend e (fun x : S ↦ (x : G ⧸ U.toSubgroup)) fun _ ↦ 1
    have hSf : (S : Set (G ⧸ U.toSubgroup)) ⊆ Set.range f := fun x hx ↦
      ⟨e ⟨x, hx⟩, e.injective.extend_apply _ _ _⟩
    have hfgen : Subgroup.closure (Set.range f) = ⊤ := by
      refine eq_top_iff.mpr ?_
      rw [← hSgen]
      exact Subgroup.closure_mono hSf
    choose g hg using fun i ↦ QuotientGroup.mk'_surjective U.toSubgroup (f i)
    have hcomp : f = ⇑(QuotientGroup.mk' U.toSubgroup) ∘ g := (funext hg).symm
    have hmem : Subgroup.closure (Set.range (⇑(QuotientGroup.mk' U.toSubgroup) ∘ g)) = ⊤ :=
      hcomp ▸ hfgen
    exact ⟨g, hmem⟩
  obtain ⟨g, hg⟩ := nonempty_iInter_of_directed_nonempty_isClosed C hdir hne hclosed
  refine ⟨g, topologicalClosure_closure_eq_top_iff.mpr fun U ↦ ?_⟩
  have hgU : Subgroup.closure (Set.range (⇑(QuotientGroup.mk' U.toSubgroup) ∘ g)) = ⊤ :=
    Set.mem_iInter.mp hg U
  rwa [Set.range_comp] at hgU

/-- A profinite group whose finite quotients are generated by `n` elements has a topological
generating set of at most `n` elements. -/
theorem exists_finset_card_le_topologicalClosure_closure_eq_top_of_rank_le {n : ℕ}
    (hrank : ∀ U : OpenNormalSubgroup G, Group.rank (G ⧸ U.toSubgroup) ≤ n) :
    ∃ s : Finset G, s.card ≤ n ∧ (Subgroup.closure (s : Set G)).topologicalClosure = ⊤ := by
  classical
  obtain ⟨g, hg⟩ := exists_topologicalClosure_closure_range_eq_top_of_rank_le hrank
  refine ⟨Finset.univ.image g, (Finset.card_image_le).trans_eq (by simp), ?_⟩
  rwa [Finset.coe_image, Finset.coe_univ, Set.image_univ]

omit [TotallyDisconnectedSpace G] in
/-- The quotients of a topologically finitely generated compact group by its open normal
subgroups — for a profinite group, its finite quotients — are generated by a bounded number of
elements, the bound being the size of any topological generating set. -/
theorem rank_quotient_le_card_of_topologicalClosure_closure_eq_top {s : Finset G}
    (hs : (Subgroup.closure (s : Set G)).topologicalClosure = ⊤) (U : OpenNormalSubgroup G) :
    Group.rank (G ⧸ U.toSubgroup) ≤ s.card := by
  classical
  refine le_trans (Group.rank_le (S := s.image (QuotientGroup.mk' U.toSubgroup)) ?_)
    Finset.card_image_le
  -- The image of `s` generates a dense subgroup of `G ⧸ U`, which is discrete, hence all of it.
  have himage := topologicalClosure_closure_image_eq_top hs
    (QuotientGroup.continuous_mk (N := U.toSubgroup))
    (QuotientGroup.mk'_surjective U.toSubgroup).denseRange
  have hdiscrete : ∀ K : Subgroup (G ⧸ U.toSubgroup), K.topologicalClosure = K := fun K ↦
    le_antisymm (K.topologicalClosure_minimal le_rfl (isClosed_discrete _)) K.le_topologicalClosure
  rw [Finset.coe_image]
  rwa [hdiscrete] at himage

/-- **Topological finite generation is a uniform bound on the ranks of the finite quotients.**
A profinite group is topologically finitely generated if and only if there is an `n` bounding the
minimal number of generators of every quotient by an open normal subgroup. -/
theorem isTopologicallyFinitelyGenerated_iff_exists_rank_le :
    IsTopologicallyFinitelyGenerated G ↔
      ∃ n : ℕ, ∀ U : OpenNormalSubgroup G, Group.rank (G ⧸ U.toSubgroup) ≤ n := by
  rw [isTopologicallyFinitelyGenerated_iff]
  refine ⟨fun ⟨s, hs⟩ ↦ ⟨s.card, fun U ↦
    rank_quotient_le_card_of_topologicalClosure_closure_eq_top hs U⟩, fun ⟨n, hn⟩ ↦ ?_⟩
  obtain ⟨s, _, hs⟩ := exists_finset_card_le_topologicalClosure_closure_eq_top_of_rank_le hn
  exact ⟨s, hs⟩

end FiniteQuotients

end TauCeti
