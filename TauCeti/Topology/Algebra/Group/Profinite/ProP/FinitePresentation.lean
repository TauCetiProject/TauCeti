module

public import TauCeti.Topology.Algebra.Group.Profinite.ProP.RelationRank

/-!
# Finite presentations of pro-`p` groups

A topologically finitely generated pro-`p` group has a minimal presentation with finitely many
defining relations if and only if its second continuous cohomology with trivial `𝔽_p`
coefficients is finite. The relation subgroup of a minimal presentation is normally generated by
finitely many elements exactly when its quotient by `Rᵖ[R,F]` is topologically finitely
generated. The latter condition is detected by `H²` through transgression.

The finite relators obtained here need not be among a previously chosen set of relators: they
belong to its closed normal closure and define the same quotient.

The result is the finite presentability criterion in Neukirch–Schmidt–Wingberg,
*Cohomology of Number Fields*, Proposition 3.9.5.
-/

public section

namespace TauCeti

open Subgroup
open ContCohomology

universe u v

variable {p : ℕ} [Fact p.Prime]

attribute [local instance 2000] Ring.toAddCommGroup

namespace presentedProP

variable {X : Type u} (rels : Set (freeProP p X))
  {G : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [DistribMulAction G (ZMod p)] [ContinuousSMul G (ZMod p)]

/-- A Frattini relation system can be replaced by a finite relation system exactly when
`H²(G, 𝔽_p)` is finite. The new system uses the same generators and has the same closed normal
relation subgroup. -/
theorem finite_H2_iff_exists_finite_relation_system
    (hrels : rels ⊆ proPFrattini p (freeProP p X))
    (e : presentedProP p X rels ≃ₜ* G)
    (htriv : ∀ (g : G) (m : ZMod p), g • m = m) :
    Finite (H2 G (ZMod p)) ↔
      ∃ s : Finset (freeProP p X),
        (normalClosure (s : Set (freeProP p X))).topologicalClosure =
          (normalClosure rels).topologicalClosure := by
  classical
  let R := (normalClosure rels).topologicalClosure
  have hnormal : R.Normal := inferInstance
  have hclosed : IsClosed (R : Set (freeProP p X)) := isClosed_topologicalClosure _
  have hpro : IsProP p (freeProP p X) := isProP_freeProP p X
  constructor
  · intro h
    have hfg := (finite_H2_iff rels hrels e htriv).mp h
    obtain ⟨t, ht⟩ :=
      (hpro.isTopologicallyFinitelyGenerated_quotient_pLowerCentralStep_iff
        Fact.out hclosed).mp hfg
    let s : Finset (freeProP p X) := t.image Subtype.val
    have hs : (normalClosure (s : Set (freeProP p X))).topologicalClosure =
        (normalClosure rels).topologicalClosure := by
      simpa only [s, Finset.coe_image] using ht
    exact ⟨s, hs⟩
  · rintro ⟨s, hsclosure⟩
    have hmem : ∀ x ∈ s, x ∈ R := by
      intro x hx
      dsimp only [R]
      rw [← hsclosure]
      exact le_topologicalClosure _ (Subgroup.subset_normalClosure hx)
    let t : Finset R := s.subtype (· ∈ R)
    have ht : (Subtype.val '' (t : Set R)) = (s : Set (freeProP p X)) := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact Finset.mem_subtype.mp hy
      · intro hx
        exact ⟨⟨x, hmem x hx⟩, Finset.mem_subtype.mpr hx, rfl⟩
    have hfg : IsTopologicallyFinitelyGenerated
        (R ⧸ (pLowerCentralStep p R).subgroupOf R) :=
      (hpro.isTopologicallyFinitelyGenerated_quotient_pLowerCentralStep_iff
        Fact.out hclosed).mpr ⟨t, by rw [ht]; exact hsclosure⟩
    exact (finite_H2_iff rels hrels e htriv).mpr hfg

end presentedProP

/-- A topologically finitely generated pro-`p` group has finite second cohomology with trivial
`𝔽_p` coefficients exactly when it has a finite minimal presentation on `d(G)` generators.
The set of relators in the conclusion lies in the Frattini subgroup of the free pro-`p` group. -/
theorem IsProP.finite_H2_iff_exists_finite_minimal_presentation
    {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [CompactSpace G] [TotallyDisconnectedSpace G]
    [DistribMulAction G (ZMod p)] [ContinuousSMul G (ZMod p)]
    (hG : IsProP p G) (h : IsTopologicallyFinitelyGenerated G)
    (htriv : ∀ (g : G) (m : ZMod p), g • m = m)
    (X : Type u) [Finite X] (hX : Nat.card X = topologicalGeneratorRankNat G h) :
    Finite (H2 G (ZMod p)) ↔
      ∃ s : Finset (freeProP p X),
        (s : Set (freeProP p X)) ⊆ proPFrattini p (freeProP p X) ∧
        Nonempty (presentedProP p X (s : Set (freeProP p X)) ≃ₜ* G) := by
  classical
  obtain ⟨rels, hrels, ⟨e⟩⟩ :=
    hG.exists_subset_proPFrattini_continuousMulEquiv_presentedProP h X hX
  constructor
  · intro hf
    obtain ⟨s, hsclosure⟩ :=
      (presentedProP.finite_H2_iff_exists_finite_relation_system rels hrels e htriv).mp hf
    have e' : presentedProP p X (s : Set (freeProP p X)) ≃ₜ* G :=
      (presentedProP.congrOfClosureEq (rels := rels) hsclosure.symm).symm.trans e
    exact ⟨s, (presentedProP.subset_proPFrattini_iff_card_eq
      (s : Set (freeProP p X)) e' h).mpr hX, ⟨e'⟩⟩
  · rintro ⟨s, hs, ⟨e'⟩⟩
    exact (presentedProP.finite_H2_iff_exists_finite_relation_system
      (s : Set (freeProP p X)) hs e' htriv).mpr
        ⟨s, rfl⟩

end TauCeti
