/-!
# Powerful pro-`p` groups

For a topological group `G` and `n : ℕ`, the **closed `n`-th power subgroup**
`TauCeti.closedPowerSubgroup G n` is the topological closure of the subgroup generated by all
`n`-th powers in `G`. A topological group `G` is **powerful** for `p` (`TauCeti.IsPowerful p G`)
when `[G, G] ≤ closedPowerSubgroup G p` for `p ≠ 2`, and `[G, G] ≤ closedPowerSubgroup G 4` for
`p = 2`. The fourth-power condition at `p = 2` is essential: the dihedral group `DihedralGroup 4`
of order `8` satisfies `[G, G] ≤ G²` yet fails `IsPowerful 2`, and over `ZMod p` the Heisenberg
group fails `IsPowerful p` for every prime `p`.

For a profinite powerful pro-`p` group `G` (without any finite-generation hypothesis), the finite
powerful `p`-group theory of `TauCeti.GroupTheory.Powerful` passes to the inverse limit of open
normal quotients via compactness:

* every element of the `k`-th term `λ_k(G)` of the lower `p`-series is literally a `p ^ k`-th
  power (`TauCeti.IsProP.mem_pLowerCentralSeries_iff_exists_pow_pow`), so
  `λ_k(G) = closedPowerSubgroup G (p ^ k)`
  (`TauCeti.IsProP.pLowerCentralSeries_eq_closedPowerSubgroup`) and in particular the pro-`p`
  Frattini subgroup equals `closedPowerSubgroup G p`;
* at `p = 2`, `[λ_k(G), G] ≤ λ_{k+2}(G)`
  (`TauCeti.IsProP.commutator_pLowerCentralSeries_top_le_add_two`);
* every term `λ_k(G)` is again powerful (`TauCeti.IsProP.isPowerful_pLowerCentralSeries`), and its
  own lower `p`-series shifts the ambient series by `k`
  (`TauCeti.IsProP.map_subtype_pLowerCentralSeries_pLowerCentralSeries`);
* the `p`-th power map `gradedPow p G k : gr_k(G) → gr_{k+1}(G)` is an additive surjection in every
  degree `k` (`TauCeti.IsProP.gradedPow_add`, `TauCeti.IsProP.gradedPow_surjective`), so for a
  topologically finitely generated powerful pro-`p` group the cardinalities of the graded pieces are
  antitone (`TauCeti.IsProP.antitone_natCard_gradedPiece`);
* an element `x ∉ λ_1(G)` with `x ^ p ∈ λ_2(G)` lifts along the lower `p`-series to a nontrivial
  element of order `p` (`TauCeti.IsProP.exists_pow_eq_one_of_notMem_pLowerCentralSeries_one`),
  whence `G` has no nontrivial element of order `p` if and only if every `gradedPow p G k` is
  bijective (`TauCeti.IsProP.forall_eq_one_of_pow_eq_one_iff_bijective_gradedPow`).

## Main definitions

* `TauCeti.closedPowerSubgroup`: the closed subgroup generated by all `n`-th powers in `G`.
* `TauCeti.IsPowerful`: the powerfulness predicate for a topological group, using fourth powers at
  `p = 2`.

## Main results

* `TauCeti.closedPowerSubgroup_prod`, `TauCeti.closedPowerSubgroup_pi`: compatibility of closed
  power subgroups with binary and arbitrary products.
* `TauCeti.IsPowerful.of_surjective`, `TauCeti.isPowerful_congr`, `TauCeti.IsPowerful.prod`,
  `TauCeti.IsPowerful.pi`: stability of `IsPowerful` under continuous surjections, isomorphisms,
  and products.
* `TauCeti.commutator_le_closedPowerSubgroup_two_dihedralGroup`,
  `TauCeti.not_isPowerful_two_dihedralGroup`, `TauCeti.not_isPowerful_heisenbergGroup_zmod`:
  concrete non-powerful witnesses separating `[G, G] ≤ G²` from `IsPowerful 2` and exhibiting
  non-powerful `p`-groups for every prime `p`.
* `TauCeti.IsProP.mem_pLowerCentralSeries_iff_exists_pow_pow`,
  `TauCeti.IsProP.pLowerCentralSeries_eq_closedPowerSubgroup`,
  `TauCeti.IsProP.proPFrattini_eq_closedPowerSubgroup`: every element of `λ_k(G)` is a `p ^ k`-th
  power.
* `TauCeti.IsProP.isPowerful_pLowerCentralSeries`,
  `TauCeti.IsProP.map_subtype_pLowerCentralSeries_pLowerCentralSeries`: every term `λ_k(G)` is
  powerful and shifts the lower `p`-series by `k`.
* `TauCeti.IsProP.gradedPow_add`, `TauCeti.IsProP.gradedPow_surjective`,
  `TauCeti.IsProP.antitone_natCard_gradedPiece`: the graded `p`-power operator is an additive
  surjection in every degree.
* `TauCeti.IsProP.exists_pow_eq_one_of_notMem_pLowerCentralSeries_one`,
  `TauCeti.IsProP.forall_eq_one_of_pow_eq_one_iff_injective_gradedPow`,
  `TauCeti.IsProP.forall_eq_one_of_pow_eq_one_iff_bijective_gradedPow`: absence of `p`-torsion in
  a profinite powerful pro-`p` group is equivalent to bijectivity of `gradedPow` in every degree.

## References

* J. D. Dixon, M. P. F. du Sautoy, A. Mann, and D. Segal, *Analytic pro-`p` groups*, 2nd ed.,
  Chapter 3 (Lemma 3.4, Theorem 3.6) and Chapter 4 (Lemma 4.2, Theorem 4.5).
-/

public section

namespace TauCeti

open Subgroup
open scoped commutatorElement

universe u v

/-! ### Closed power subgroups -/

section ClosedPowerSubgroup

variable (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The closed subgroup generated by all `n`-th powers in a topological group `G`. -/
def closedPowerSubgroup (n : ℕ) : Subgroup G :=
  (Subgroup.closure (Set.range (fun g : G ↦ g ^ n))).topologicalClosure

/-- The defining equation of `TauCeti.closedPowerSubgroup`. -/
theorem closedPowerSubgroup_def (n : ℕ) :
    closedPowerSubgroup G n =
      (Subgroup.closure (Set.range (fun g : G ↦ g ^ n))).topologicalClosure :=
  (rfl)

/-- `closedPowerSubgroup G n` is the topological closure of `(⊤ : Subgroup G).powClosure n`. -/
theorem closedPowerSubgroup_eq_topologicalClosure_powClosure (n : ℕ) :
    closedPowerSubgroup G n = ((⊤ : Subgroup G).powClosure n).topologicalClosure := by
  rw [closedPowerSubgroup_def, Subgroup.powClosure_top]

variable {G}

/-- Every closed power subgroup is closed. -/
instance isClosed_closedPowerSubgroup (n : ℕ) : IsClosed (closedPowerSubgroup G n : Set G) := by
  rw [closedPowerSubgroup_def]
  exact Subgroup.instIsClosedTopologicalClosure _

/-- Every closed power subgroup is normal. -/
instance closedPowerSubgroup_normal (n : ℕ) : (closedPowerSubgroup G n).Normal := by
  rw [closedPowerSubgroup_eq_topologicalClosure_powClosure]
  exact Subgroup.is_normal_topologicalClosure _

/-- The `n`-th power of every element lies in `closedPowerSubgroup G n`. -/
theorem pow_mem_closedPowerSubgroup (g : G) (n : ℕ) : g ^ n ∈ closedPowerSubgroup G n :=
  le_topologicalClosure _ (Subgroup.subset_closure ⟨g, rfl⟩)

/-- A closed subgroup contains `closedPowerSubgroup G n` if and only if it contains every `n`-th
power. -/
theorem closedPowerSubgroup_le_iff {K : Subgroup G} (hK : IsClosed (K : Set G)) {n : ℕ} :
    closedPowerSubgroup G n ≤ K ↔ ∀ g : G, g ^ n ∈ K := by
  refine ⟨fun h g ↦ h (pow_mem_closedPowerSubgroup g n), fun h ↦ ?_⟩
  rw [closedPowerSubgroup_def]
  refine topologicalClosure_minimal _ ((Subgroup.closure_le _).mpr ?_) hK
  rintro _ ⟨g, rfl⟩
  exact h g

/-- If `m ∣ n`, then `closedPowerSubgroup G n ≤ closedPowerSubgroup G m`. -/
theorem closedPowerSubgroup_anti_of_dvd {m n : ℕ} (h : m ∣ n) :
    closedPowerSubgroup G n ≤ closedPowerSubgroup G m := by
  obtain ⟨k, rfl⟩ := h
  refine (closedPowerSubgroup_le_iff (isClosed_closedPowerSubgroup m)).mpr fun g ↦ ?_
  rw [mul_comm, pow_mul]
  exact pow_mem_closedPowerSubgroup (g ^ k) m

/-- In a `T1` topological group, `closedPowerSubgroup G 0 = ⊥`. -/
@[simp]
theorem closedPowerSubgroup_zero [T1Space G] : closedPowerSubgroup G 0 = ⊥ :=
  le_bot_iff.mp <| (closedPowerSubgroup_le_iff (by simp)).mpr fun g ↦ by
    simp

/-- `closedPowerSubgroup G 1 = ⊤`. -/
@[simp]
theorem closedPowerSubgroup_one : closedPowerSubgroup G 1 = ⊤ :=
  top_le_iff.mp fun g _ ↦ by simpa using pow_mem_closedPowerSubgroup g 1

/-- In a subsingleton topological group, every closed power subgroup is `⊤`. -/
theorem closedPowerSubgroup_of_subsingleton [Subsingleton G] (n : ℕ) :
    closedPowerSubgroup G n = ⊤ :=
  Subsingleton.elim _ _

/-- On a discrete group, `closedPowerSubgroup G n` agrees with `(⊤ : Subgroup G).powClosure n`. -/
theorem closedPowerSubgroup_eq_of_discreteTopology [DiscreteTopology G] (n : ℕ) :
    closedPowerSubgroup G n = (⊤ : Subgroup G).powClosure n := by
  rw [closedPowerSubgroup_eq_topologicalClosure_powClosure]
  exact le_antisymm (topologicalClosure_minimal _ le_rfl (isClosed_discrete _))
    (le_topologicalClosure _)

section Functoriality

variable {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]

/-- A continuous homomorphism carries `closedPowerSubgroup G n` into `closedPowerSubgroup H n`. -/
theorem _root_.MonoidHom.map_closedPowerSubgroup_le (f : G →* H) (hf : Continuous f) (n : ℕ) :
    (closedPowerSubgroup G n).map f ≤ closedPowerSubgroup H n := by
  rw [map_le_iff_le_comap]
  refine (closedPowerSubgroup_le_iff ?_).mpr fun g ↦ ?_
  · rw [coe_comap]
    exact (isClosed_closedPowerSubgroup n).preimage hf
  · rw [mem_comap, map_pow]
    exact pow_mem_closedPowerSubgroup (f g) n

/-- A continuous closed surjection carries `closedPowerSubgroup G n` onto
`closedPowerSubgroup H n`. -/
theorem _root_.MonoidHom.map_closedPowerSubgroup_eq_of_surjective (f : G →* H) (hf : Continuous f)
    (hfc : IsClosedMap f) (hsurj : Function.Surjective f) (n : ℕ) :
    (closedPowerSubgroup G n).map f = closedPowerSubgroup H n := by
  refine le_antisymm (f.map_closedPowerSubgroup_le hf n) ?_
  have hclosed : IsClosed ((closedPowerSubgroup G n).map f : Set H) := by
    rw [coe_map]
    exact hfc _ (isClosed_closedPowerSubgroup n)
  refine (closedPowerSubgroup_le_iff hclosed).mpr fun y ↦ ?_
  obtain ⟨x, rfl⟩ := hsurj y
  exact ⟨x ^ n, pow_mem_closedPowerSubgroup x n, map_pow f x n⟩

/-- A topological group isomorphism carries `closedPowerSubgroup G n` onto
`closedPowerSubgroup H n`. -/
theorem _root_.ContinuousMulEquiv.map_closedPowerSubgroup_eq (e : G ≃ₜ* H) (n : ℕ) :
    (closedPowerSubgroup G n).map e.toMulEquiv.toMonoidHom = closedPowerSubgroup H n := by
  refine le_antisymm (e.toMulEquiv.toMonoidHom.map_closedPowerSubgroup_le e.continuous n)
    fun y hy ↦ ?_
  have hsymm : e.symm y ∈ closedPowerSubgroup G n :=
    e.symm.toMulEquiv.toMonoidHom.map_closedPowerSubgroup_le e.symm.continuous n
      (mem_map_of_mem _ hy)
  exact ⟨e.symm y, hsymm, e.apply_symm_apply y⟩

/-- Every closed power subgroup is topologically characteristic. -/
theorem isTopCharacteristic_closedPowerSubgroup (n : ℕ) :
    IsTopCharacteristic G (closedPowerSubgroup G n) :=
  isTopCharacteristic_iff_map_eq.mpr fun φ ↦ φ.map_closedPowerSubgroup_eq n

/-- The closed `n`-th power subgroup of a product is the product of the closed `n`-th power
subgroups. -/
theorem closedPowerSubgroup_prod (n : ℕ) :
    closedPowerSubgroup (G × H) n = (closedPowerSubgroup G n).prod (closedPowerSubgroup H n) := by
  refine le_antisymm ((closedPowerSubgroup_le_iff ?_).mpr fun x ↦ ?_) (prod_le_iff.mpr ⟨?_, ?_⟩)
  · rw [coe_prod]
    exact (isClosed_closedPowerSubgroup n).prod (isClosed_closedPowerSubgroup n)
  · exact ⟨pow_mem_closedPowerSubgroup x.1 n, pow_mem_closedPowerSubgroup x.2 n⟩
  · exact (MonoidHom.inl G H).map_closedPowerSubgroup_le (ContinuousMonoidHom.inl G H).continuous n
  · exact (MonoidHom.inr G H).map_closedPowerSubgroup_le (ContinuousMonoidHom.inr G H).continuous n

/-- The closed `n`-th power subgroup of an arbitrary product is the product of the closed `n`-th
power subgroups. -/
theorem closedPowerSubgroup_pi {ι : Type*} {F : ι → Type*} [∀ i, Group (F i)]
    [∀ i, TopologicalSpace (F i)] [∀ i, IsTopologicalGroup (F i)] (n : ℕ) :
    closedPowerSubgroup (∀ i, F i) n =
      Subgroup.pi Set.univ (fun i ↦ closedPowerSubgroup (F i) n) := by
  classical
  refine le_antisymm ((closedPowerSubgroup_le_iff ?_).mpr fun x i _ ↦ ?_) fun x hx ↦ ?_
  · rw [coe_pi]
    exact isClosed_set_pi fun i _ ↦ isClosed_closedPowerSubgroup n
  · exact pow_mem_closedPowerSubgroup (x i) n
  · -- Approximate `x` inside every basic open box by its finite-support truncations.
    rw [← SetLike.mem_coe, ← (isClosed_closedPowerSubgroup n).closure_eq, mem_closure_iff]
    intro V hV hxV
    obtain ⟨I, t, ht, htV⟩ := isOpen_pi_iff.mp hV x hxV
    refine ⟨fun i ↦ if i ∈ I then x i else 1, htV fun i hi ↦ ?_, ?_⟩
    · simpa [Finset.mem_coe.mp hi] using (ht i (Finset.mem_coe.mp hi)).2
    · exact Submonoid.pi_mem_of_mulSingle_mem_aux I _ (fun i hi ↦ by simp [hi]) fun i hi ↦ by
        have hsing : Pi.mulSingle i (x i) ∈ closedPowerSubgroup (∀ i, F i) n :=
          (MonoidHom.mulSingle F i).map_closedPowerSubgroup_le (continuous_mulSingle i) n
            ⟨x i, hx i (Set.mem_univ i), rfl⟩
        simpa [hi] using hsing

end Functoriality

end ClosedPowerSubgroup

/-! ### Powerful topological groups -/

section Powerful

variable (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- A topological group `G` is **powerful** for `p` when `[G, G] ≤ closedPowerSubgroup G p` for
`p ≠ 2`, and `[G, G] ≤ closedPowerSubgroup G 4` for `p = 2`. -/
def IsPowerful : Prop :=
  ⁅(⊤ : Subgroup G), ⊤⁆ ≤ closedPowerSubgroup G (if p = 2 then 4 else p)

variable {p G}

/-- The defining property of `TauCeti.IsPowerful`. -/
theorem isPowerful_iff :
    IsPowerful p G ↔ ⁅(⊤ : Subgroup G), ⊤⁆ ≤ closedPowerSubgroup G (if p = 2 then 4 else p) :=
  (Iff.rfl)

/-- Powerfulness expressed with `commutator G`. -/
theorem isPowerful_iff_commutator_le :
    IsPowerful p G ↔ commutator G ≤ closedPowerSubgroup G (if p = 2 then 4 else p) := by
  rw [isPowerful_iff, commutator_def]

/-- Every commutative topological group is powerful for every `p`. -/
theorem isPowerful_of_isMulCommutative [IsMulCommutative G] : IsPowerful p G := by
  rw [isPowerful_iff, commutator_le]
  rintro a _ b _
  rw [commutatorElement_eq_one_iff_mul_comm.mpr (IsMulCommutative.is_comm.comm a b)]
  exact one_mem _

/-- Every subsingleton topological group is powerful for every `p`. -/
theorem isPowerful_of_subsingleton [Subsingleton G] : IsPowerful p G :=
  isPowerful_of_isMulCommutative

/-- On a discrete group, `IsPowerful p G` agrees with `(⊤ : Subgroup G).IsPowerfullyEmbedded p`. -/
theorem isPowerful_iff_isPowerfullyEmbedded_top [DiscreteTopology G] :
    IsPowerful p G ↔ (⊤ : Subgroup G).IsPowerfullyEmbedded p := by
  rw [isPowerful_iff, Subgroup.isPowerfullyEmbedded_iff,
    closedPowerSubgroup_eq_of_discreteTopology]
  exact ⟨fun h ↦ ⟨inferInstance, h⟩, fun h ↦ h.2⟩

namespace IsPowerful

/-- In a powerful group, `[G, G] ≤ closedPowerSubgroup G p` for every `p` (at `p = 2`, fourth
powers are squares). -/
theorem commutator_le_closedPowerSubgroup (hG : IsPowerful p G) :
    ⁅(⊤ : Subgroup G), ⊤⁆ ≤ closedPowerSubgroup G p := by
  by_cases hp2 : p = 2
  · subst hp2
    exact (isPowerful_iff.mp hG).trans (closedPowerSubgroup_anti_of_dvd (by decide : 2 ∣ 4))
  · simpa [isPowerful_iff, hp2] using hG

variable {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]

/-- A continuous surjective image of a powerful group is powerful. -/
theorem of_surjective (hG : IsPowerful p G) (f : G →* H) (hf : Continuous f)
    (hsurj : Function.Surjective f) : IsPowerful p H := by
  rw [isPowerful_iff, ← map_top_of_surjective f hsurj, ← map_commutator]
  exact (map_mono (isPowerful_iff.mp hG)).trans (f.map_closedPowerSubgroup_le hf _)

/-- A quotient of a powerful group by a normal subgroup is powerful. -/
theorem quotient (hG : IsPowerful p G) (N : Subgroup G) [N.Normal] : IsPowerful p (G ⧸ N) :=
  hG.of_surjective (QuotientGroup.mk' N) QuotientGroup.continuous_mk
    (QuotientGroup.mk'_surjective N)

/-- A topological group isomorphism carries powerfulness to its target. -/
theorem of_equiv (hG : IsPowerful p G) (e : G ≃ₜ* H) : IsPowerful p H :=
  hG.of_surjective e.toMulEquiv.toMonoidHom e.continuous e.surjective

/-- The product of two powerful groups is powerful. -/
theorem prod (hG : IsPowerful p G) (hH : IsPowerful p H) : IsPowerful p (G × H) := by
  rw [isPowerful_iff, closedPowerSubgroup_prod, commutator_le]
  rintro x _ y _
  exact ⟨isPowerful_iff.mp hG (commutator_mem_commutator (mem_top x.1) (mem_top y.1)),
    isPowerful_iff.mp hH (commutator_mem_commutator (mem_top x.2) (mem_top y.2))⟩

/-- An arbitrary product of powerful groups is powerful. -/
theorem pi {ι : Type*} {F : ι → Type*} [∀ i, Group (F i)] [∀ i, TopologicalSpace (F i)]
    [∀ i, IsTopologicalGroup (F i)] (hF : ∀ i, IsPowerful p (F i)) : IsPowerful p (∀ i, F i) := by
  rw [isPowerful_iff, closedPowerSubgroup_pi, commutator_le]
  rintro x _ y _ i _
  exact isPowerful_iff.mp (hF i) (commutator_mem_commutator (mem_top (x i)) (mem_top (y i)))

end IsPowerful

/-- Powerfulness is invariant under topological group isomorphism. -/
theorem isPowerful_congr {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (e : G ≃ₜ* H) : IsPowerful p G ↔ IsPowerful p H :=
  ⟨fun h ↦ h.of_equiv e, fun h ↦ h.of_equiv e.symm⟩

end Powerful

/-! ### Non-powerful witnesses -/

section Witnesses

/-- In every dihedral group `DihedralGroup n`, every commutator is a square, so
`[D_n, D_n] ≤ D_n²`. -/
theorem commutator_le_closedPowerSubgroup_two_dihedralGroup (n : ℕ)
    [TopologicalSpace (DihedralGroup n)] [DiscreteTopology (DihedralGroup n)] :
    ⁅(⊤ : Subgroup (DihedralGroup n)), ⊤⁆ ≤ closedPowerSubgroup (DihedralGroup n) 2 := by
  rw [commutator_le]
  rintro a _ b _
  cases a with
  | r i =>
    cases b with
    | r j =>
      have h : ⁅DihedralGroup.r i, DihedralGroup.r j⁆ = (DihedralGroup.r (0 : ZMod n)) ^ 2 := by
        simp [commutatorElement_def]
      rw [h]
      exact pow_mem_closedPowerSubgroup _ 2
    | sr j =>
      have h : ⁅DihedralGroup.r i, DihedralGroup.sr j⁆ = (DihedralGroup.r i) ^ 2 := by
        simp only [commutatorElement_def, sq, DihedralGroup.inv_r, DihedralGroup.inv_sr,
          DihedralGroup.r_mul_sr, DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr,
          DihedralGroup.r_mul_r]
        congr 1
        abel
      rw [h]
      exact pow_mem_closedPowerSubgroup _ 2
  | sr i =>
    cases b with
    | r j =>
      have h : ⁅DihedralGroup.sr i, DihedralGroup.r j⁆ = (DihedralGroup.r (-j)) ^ 2 := by
        simp only [commutatorElement_def, sq, DihedralGroup.inv_r, DihedralGroup.inv_sr,
          DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr, DihedralGroup.r_mul_r]
        congr 1
        abel
      rw [h]
      exact pow_mem_closedPowerSubgroup _ 2
    | sr j =>
      have h : ⁅DihedralGroup.sr i, DihedralGroup.sr j⁆ = (DihedralGroup.r (j - i)) ^ 2 := by
        simp only [commutatorElement_def, sq, DihedralGroup.inv_sr, DihedralGroup.r_mul_sr,
          DihedralGroup.sr_mul_sr, DihedralGroup.r_mul_r]
        congr 1
        abel
      rw [h]
      exact pow_mem_closedPowerSubgroup _ 2

/-- Whenever `4 ∣ n` (in particular for `DihedralGroup 4`, of order `8`, and for all larger
dihedral `2`-groups), `DihedralGroup n` is not powerful at `p = 2`: every fourth power is a
rotation by a multiple of `4`, whereas `[r 1, sr 0] = r 2`. Together with
`TauCeti.commutator_le_closedPowerSubgroup_two_dihedralGroup`, this shows why the fourth-power
condition at `p = 2` is strictly stronger than `[G, G] ≤ G²`. -/
theorem not_isPowerful_two_dihedralGroup {n : ℕ} (hn : 4 ∣ n)
    [TopologicalSpace (DihedralGroup n)] [DiscreteTopology (DihedralGroup n)] :
    ¬ IsPowerful 2 (DihedralGroup n) := by
  intro hpow
  let K : Subgroup (DihedralGroup n) :=
    { carrier := {g | ∃ i : ZMod n, g = DihedralGroup.r (4 * i)}
      mul_mem' := by
        rintro _ _ ⟨i, rfl⟩ ⟨j, rfl⟩
        exact ⟨i + j, by rw [DihedralGroup.r_mul_r, mul_add]⟩
      one_mem' := ⟨0, by rw [mul_zero, DihedralGroup.r_zero]⟩
      inv_mem' := by
        rintro _ ⟨i, rfl⟩
        exact ⟨-i, by rw [DihedralGroup.inv_r, mul_neg]⟩ }
  have h4le : closedPowerSubgroup (DihedralGroup n) 4 ≤ K :=
    (closedPowerSubgroup_le_iff (isClosed_discrete _)).mpr fun g ↦ by
      cases g with
      | r i =>
        refine ⟨i, ?_⟩
        rw [DihedralGroup.r_pow, Nat.cast_ofNat, mul_comm]
      | sr i =>
        refine ⟨0, ?_⟩
        have hsr : DihedralGroup.sr i ^ 2 = 1 := by simp [sq]
        have h4 : DihedralGroup.sr i ^ (2 * 2) = 1 := by rw [pow_mul, hsr, one_pow]
        rw [mul_zero, DihedralGroup.r_zero]
        exact h4
  have hpow' : ⁅(⊤ : Subgroup (DihedralGroup n)), ⊤⁆ ≤
      closedPowerSubgroup (DihedralGroup n) 4 := by
    simpa [isPowerful_iff] using hpow
  have hcomm : ⁅DihedralGroup.r (1 : ZMod n), DihedralGroup.sr (0 : ZMod n)⁆ ∈ K :=
    h4le (hpow' (commutator_mem_commutator (mem_top _) (mem_top _)))
  obtain ⟨i, hi⟩ := hcomm
  have hcalc :
      ⁅DihedralGroup.r (1 : ZMod n), DihedralGroup.sr (0 : ZMod n)⁆ = DihedralGroup.r 2 := by
    simp only [commutatorElement_def, DihedralGroup.inv_r, DihedralGroup.inv_sr,
      DihedralGroup.r_mul_sr, DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr]
    congr 1
    ring
  have h2eq : (2 : ZMod n) = 4 * i := DihedralGroup.r.inj (hcalc.symm.trans hi)
  have h20 : (2 : ZMod 4) = 0 := by
    have h := congrArg (ZMod.castHom hn (ZMod 4)) h2eq
    have h4 : (4 : ZMod 4) = 0 := by decide
    rw [map_ofNat, map_mul, map_ofNat, h4, zero_mul] at h
    exact h
  exact (by decide : (2 : ZMod 4) ≠ 0) h20

/-- For every prime `p`, the finite Heisenberg group `HeisenbergGroup (ZMod p)` is not powerful
for `p`: every `p`-th power (or fourth power when `p = 2`) is trivial, while the commutator
`⁅(1, 0, 0), (0, 1, 0)⁆ = (0, 0, 1)` is nontrivial. -/
theorem not_isPowerful_heisenbergGroup_zmod (p : ℕ) [hp : Fact p.Prime] :
    ¬ IsPowerful p (HeisenbergGroup (ZMod p)) := by
  intro hpow
  set e : ℕ := if p = 2 then 4 else p
  have he_pow : ∀ a : HeisenbergGroup (ZMod p), a ^ e = 1 := fun a ↦ by
    rw [HeisenbergGroup.pow_eq]
    have hpe : (p : ℕ) ∣ e := by
      by_cases hp2 : p = 2
      · subst hp2; decide
      · simp [e, hp2]
    have hpe2 : (p : ℕ) ∣ e.choose 2 := by
      by_cases hp2 : p = 2
      · subst hp2; decide
      · simpa [e, hp2] using
          hp.out.dvd_choose_self two_ne_zero (lt_of_le_of_ne hp.out.two_le (Ne.symm hp2))
    have hzero : ∀ (m : ℕ) (r : ZMod p), p ∣ m → m • r = 0 := fun m r ⟨c, hc⟩ ↦ by
      rw [hc, nsmul_eq_mul, Nat.cast_mul, ZMod.natCast_self, zero_mul, zero_mul]
    ext <;> simp [hzero e _ hpe, hzero (e.choose 2) _ hpe2]
  have hbot : closedPowerSubgroup (HeisenbergGroup (ZMod p)) e = ⊥ :=
    le_bot_iff.mp ((closedPowerSubgroup_le_iff (isClosed_discrete _)).mpr fun a ↦
      mem_bot.mpr (he_pow a))
  have hmem : ⁅(⟨1, 0, 0⟩ : HeisenbergGroup (ZMod p)),
      (⟨0, 1, 0⟩ : HeisenbergGroup (ZMod p))⁆ ∈ (⊥ : Subgroup _) := by
    rw [← hbot]
    exact (isPowerful_iff.mp hpow) (commutator_mem_commutator (mem_top _) (mem_top _))
  have h10 : (1 : ZMod p) = 0 := by
    have h := congrArg HeisenbergGroup.z (mem_bot.mp hmem)
    simp [HeisenbergGroup.commutatorElement_eq] at h
  exact one_ne_zero h10

end Witnesses

/-! ### Powerful profinite pro-`p` groups -/

section ProfiniteProP

variable {p : ℕ} [hp : Fact p.Prime]
variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [CompactSpace G] [TotallyDisconnectedSpace G]

namespace IsProP

omit hp [CompactSpace G] [TotallyDisconnectedSpace G] in
/-- Every open normal quotient of a powerful profinite pro-`p` group is a finite `p`-group whose
top subgroup is powerfully embedded, and the image of `λ_k(G)` in the quotient is the abstract
`k`-th lower `p`-central series term. -/
private theorem quotient_openNormalSubgroup_isPowerfullyEmbedded (hpow : IsPowerful p G)
    (U : OpenNormalSubgroup G) :
    (⊤ : Subgroup (G ⧸ U.toSubgroup)).IsPowerfullyEmbedded p := by
  have : DiscreteTopology (G ⧸ U.toSubgroup) :=
    QuotientGroup.discreteTopology (hN := U.isOpen)
  exact isPowerful_iff_isPowerfullyEmbedded_top.mp (hpow.quotient U.toSubgroup)

omit hp [TotallyDisconnectedSpace G] in
private theorem map_pLowerCentralSeries_openNormalSubgroup (U : OpenNormalSubgroup G) (k : ℕ) :
    (pLowerCentralSeries p G k).map (QuotientGroup.mk' U.toSubgroup) =
      (⊤ : Subgroup (G ⧸ U.toSubgroup)).pLowerCentralSeries p k := by
  have : DiscreteTopology (G ⧸ U.toSubgroup) :=
    QuotientGroup.discreteTopology (hN := U.isOpen)
  rw [(QuotientGroup.mk' U.toSubgroup).map_pLowerCentralSeries_eq_of_surjective
      QuotientGroup.continuous_mk QuotientGroup.continuous_mk.isClosedMap
      (QuotientGroup.mk'_surjective _),
    pLowerCentralSeries_eq_of_discreteTopology]

/-- **Every element of `λ_k(G)` is a `p ^ k`-th power** (Dixon–du Sautoy–Mann–Segal,
Theorem 3.6(iii)): in a profinite powerful pro-`p` group `G`, the `k`-th term of the lower
`p`-series consists precisely of the `p ^ k`-th powers. No finite generation is needed. -/
theorem mem_pLowerCentralSeries_iff_exists_pow_pow (hG : IsProP p G) (hpow : IsPowerful p G)
    (k : ℕ) {g : G} :
    g ∈ pLowerCentralSeries p G k ↔ ∃ x : G, x ^ (p ^ k) = g := by
  refine ⟨fun hg ↦ ?_, ?_⟩
  · -- For each open normal subgroup `U`, the `p ^ k`-th roots of `g` modulo `U` form a nonempty
    -- closed set, and these sets are directed downward under intersection.
    let F : OpenNormalSubgroup G → Set G := fun U ↦
      {x : G | (x : G ⧸ U.toSubgroup) ^ (p ^ k) = (g : G ⧸ U.toSubgroup)}
    have hF_closed : ∀ U, IsClosed (F U) := fun U ↦ by
      have : DiscreteTopology (G ⧸ U.toSubgroup) :=
        QuotientGroup.discreteTopology (hN := U.isOpen)
      exact (isClosed_singleton (x := (g : G ⧸ U.toSubgroup))).preimage
        ((continuous_pow (p ^ k)).comp QuotientGroup.continuous_mk)
    have hF_nonempty : ∀ U, (F U).Nonempty := fun U ↦ by
      have : Finite (G ⧸ U.toSubgroup) := U.toSubgroup.quotient_finite_of_isOpen U.isOpen
      have hgU : (g : G ⧸ U.toSubgroup) ∈
          (⊤ : Subgroup (G ⧸ U.toSubgroup)).pLowerCentralSeries p k := by
        rw [← map_pLowerCentralSeries_openNormalSubgroup U k]
        exact ⟨g, hg, rfl⟩
      have hU := quotient_openNormalSubgroup_isPowerfullyEmbedded hpow U
      obtain ⟨xQ, hxQ⟩ :=
        (hU.mem_pLowerCentralSeries_iff_exists_pow_pow (isProP_iff.mp hG U) k).mp hgU
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective xQ
      exact ⟨x, hxQ⟩
    have hF_dir : Directed (· ⊇ ·) F := fun U V ↦ by
      refine ⟨U ⊓ V, fun x hx ↦ ?_, fun x hx ↦ ?_⟩
      · simpa [F, map_pow] using congrArg (QuotientGroup.mapOfLE (inf_le_left :
          (U ⊓ V).toSubgroup ≤ U.toSubgroup)) hx
      · simpa [F, map_pow] using congrArg (QuotientGroup.mapOfLE (inf_le_right :
          (U ⊓ V).toSubgroup ≤ V.toSubgroup)) hx
    obtain ⟨x, hx⟩ := IsCompact.nonempty_iInter_of_directed_nonempty_isCompact_isClosed F hF_dir
      hF_nonempty (fun U ↦ (hF_closed U).isCompact) hF_closed
    refine ⟨x, eq_of_inv_mul_eq_one (Subgroup.eq_one_of_mem_iInf_openNormalSubgroup fun U ↦ ?_)⟩
    have hxU : (x : G ⧸ U.toSubgroup) ^ (p ^ k) = (g : G ⧸ U.toSubgroup) := Set.mem_iInter.mp hx U
    exact QuotientGroup.eq.mp (by rwa [QuotientGroup.mk_pow])
  · rintro ⟨x, rfl⟩
    simpa using pow_pow_mem_pLowerCentralSeries (mem_pLowerCentralSeries_zero p x) k

/-- **The lower `p`-series equals the closed power subgroups** (Dixon–du Sautoy–Mann–Segal,
Theorem 3.6(ii)): in a profinite powerful pro-`p` group, `λ_k(G) = closedPowerSubgroup G (p ^ k)`.
No finite generation is needed. -/
theorem pLowerCentralSeries_eq_closedPowerSubgroup (hG : IsProP p G) (hpow : IsPowerful p G)
    (k : ℕ) : pLowerCentralSeries p G k = closedPowerSubgroup G (p ^ k) := by
  refine le_antisymm (fun g hg ↦ ?_)
    ((closedPowerSubgroup_le_iff (isClosed_pLowerCentralSeries k)).mpr fun g ↦ ?_)
  · obtain ⟨x, rfl⟩ := (hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow k).mp hg
    exact pow_mem_closedPowerSubgroup x (p ^ k)
  · simpa using pow_pow_mem_pLowerCentralSeries (mem_pLowerCentralSeries_zero p g) k

/-- In a profinite powerful pro-`p` group, `λ_1(G) = closedPowerSubgroup G p`. -/
theorem pLowerCentralSeries_one_eq_closedPowerSubgroup (hG : IsProP p G) (hpow : IsPowerful p G) :
    pLowerCentralSeries p G 1 = closedPowerSubgroup G p := by
  simpa using hG.pLowerCentralSeries_eq_closedPowerSubgroup hpow 1

/-- In a profinite powerful pro-`p` group, the pro-`p` Frattini subgroup is
`closedPowerSubgroup G p`. -/
theorem proPFrattini_eq_closedPowerSubgroup (hG : IsProP p G) (hpow : IsPowerful p G) :
    proPFrattini p G = closedPowerSubgroup G p := by
  rw [← pLowerCentralSeries_one_eq_proPFrattini hp.out,
    hG.pLowerCentralSeries_one_eq_closedPowerSubgroup hpow]

/-- In a profinite powerful pro-`2` group, `⁅λ_k(G), G⁆ ≤ λ_{k+2}(G)` for every `k`. -/
theorem commutator_pLowerCentralSeries_top_le_add_two (hG : IsProP 2 G) (hpow : IsPowerful 2 G)
    (k : ℕ) :
    ⁅pLowerCentralSeries 2 G k, (⊤ : Subgroup G)⁆ ≤ pLowerCentralSeries 2 G (k + 2) := by
  rw [(pLowerCentralSeries 2 G (k + 2)).eq_iInf_sup_openNormalSubgroup
      (isClosed_pLowerCentralSeries (k + 2))]
  refine le_iInf fun U ↦ ?_
  have : Finite (G ⧸ U.toSubgroup) := U.toSubgroup.quotient_finite_of_isOpen U.isOpen
  have hmap : ⁅pLowerCentralSeries 2 G k, (⊤ : Subgroup G)⁆.map (QuotientGroup.mk' U.toSubgroup) ≤
      (pLowerCentralSeries 2 G (k + 2)).map (QuotientGroup.mk' U.toSubgroup) := by
    rw [map_commutator, map_top_of_surjective _ (QuotientGroup.mk'_surjective _),
      map_pLowerCentralSeries_openNormalSubgroup U k,
      map_pLowerCentralSeries_openNormalSubgroup U (k + 2)]
    have hU := quotient_openNormalSubgroup_isPowerfullyEmbedded hpow U
    exact hU.commutator_pLowerCentralSeries_top_le_add_two (isProP_iff.mp hG U) k
  intro g hg
  obtain ⟨h, hh, hgh⟩ := Subgroup.mem_map.mp (hmap ⟨g, hg, rfl⟩)
  have hmem := Subgroup.mul_mem_sup hh (QuotientGroup.eq.mp hgh)
  rwa [mul_inv_cancel_left] at hmem

/-- **Every term of the lower `p`-series is powerful** (Dixon–du Sautoy–Mann–Segal, Theorem 3.6(i)):
in a profinite powerful pro-`p` group `G`, each `λ_k(G)` is again powerful for `p`. -/
theorem isPowerful_pLowerCentralSeries (hG : IsProP p G) (hpow : IsPowerful p G) (k : ℕ) :
    IsPowerful p (pLowerCentralSeries p G k) := by
  rw [isPowerful_iff, commutator_le]
  rintro a _ b _
  set r : ℕ := if p = 2 then 2 else 1
  have he : p ^ r = if p = 2 then 4 else p := by
    by_cases hp2 : p = 2 <;> simp [r, hp2]
  have hab : ((⁅a, b⁆ : pLowerCentralSeries p G k) : G) ∈ pLowerCentralSeries p G (k + r) := by
    have hval : ((⁅a, b⁆ : pLowerCentralSeries p G k) : G) = ⁅(a : G), (b : G)⁆ :=
      map_commutatorElement (pLowerCentralSeries p G k).subtype a b
    rw [hval]
    by_cases hp2 : p = 2
    · subst hp2
      exact hG.commutator_pLowerCentralSeries_top_le_add_two hpow k
        (commutator_mem_commutator a.2 (mem_top (b : G)))
    · simpa [r, hp2] using commutator_mem_pLowerCentralSeries_succ a.2 (b : G)
  obtain ⟨x, hx⟩ := (hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow (k + r)).mp hab
  let y : pLowerCentralSeries p G k :=
    ⟨x ^ (p ^ k), (hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow k).mpr ⟨x, rfl⟩⟩
  have hy : y ^ (if p = 2 then 4 else p) = ⁅a, b⁆ := by
    apply Subtype.ext
    rw [coe_pow, ← he, ← pow_mul, ← pow_add]
    exact hx
  rw [← hy]
  exact pow_mem_closedPowerSubgroup y _

/-- Every closed `p ^ k`-th power subgroup of a profinite powerful pro-`p` group is powerful. -/
theorem isPowerful_closedPowerSubgroup_pow (hG : IsProP p G) (hpow : IsPowerful p G) (k : ℕ) :
    IsPowerful p (closedPowerSubgroup G (p ^ k)) := by
  rw [← hG.pLowerCentralSeries_eq_closedPowerSubgroup hpow k]
  exact hG.isPowerful_pLowerCentralSeries hpow k

/-- **Shift invariance of the lower `p`-series** (Dixon–du Sautoy–Mann–Segal, Theorem 3.6(iv)):
in a profinite powerful pro-`p` group `G`, the `j`-th term of the lower `p`-series of `λ_k(G)`
maps onto `λ_{k+j}(G)`. -/
theorem map_subtype_pLowerCentralSeries_pLowerCentralSeries (hG : IsProP p G)
    (hpow : IsPowerful p G) (k j : ℕ) :
    (pLowerCentralSeries p (pLowerCentralSeries p G k) j).map
        (pLowerCentralSeries p G k).subtype =
      pLowerCentralSeries p G (k + j) := by
  set H := pLowerCentralSeries p G k
  have hH_proP : IsProP p H := hG.subgroup H
  have hH_pow : IsPowerful p H := hG.isPowerful_pLowerCentralSeries hpow k
  ext g
  rw [mem_map, hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow (k + j)]
  constructor
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨z, rfl⟩ := (hH_proP.mem_pLowerCentralSeries_iff_exists_pow_pow hH_pow j).mp hy
    obtain ⟨x, hx⟩ := (hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow k).mp z.2
    exact ⟨x, by rw [pow_add, pow_mul, hx, ← coe_pow]; rfl⟩
  · rintro ⟨x, rfl⟩
    let z : H := ⟨x ^ (p ^ k), (hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow k).mpr ⟨x, rfl⟩⟩
    refine ⟨z ^ (p ^ j), (hH_proP.mem_pLowerCentralSeries_iff_exists_pow_pow hH_pow j).mpr
      ⟨z, rfl⟩, ?_⟩
    rw [coe_subtype, coe_pow, ← pow_mul, ← pow_add]

/-! ### Graded `p`-power operator and torsion lifting -/

/-- **Additivity of the graded `p`-power operator** in every degree for a profinite powerful
pro-`p` group, including degree `0` at `p = 2`. -/
theorem gradedPow_add (hG : IsProP p G) (hpow : IsPowerful p G) (k : ℕ)
    (x y : gradedPiece p G k) :
    gradedPow p G k (x + y) = gradedPow p G k x + gradedPow p G k y := by
  cases k with
  | succ k => exact gradedPow_add_of_one_le (Nat.succ_le_succ (Nat.zero_le k)) x y
  | zero =>
    by_cases hp2 : p = 2
    · subst hp2
      rw [gradedPow_add_zero_of_two rfl]
      obtain ⟨a, rfl⟩ := gradedMkZero_surjective x
      obtain ⟨b, rfl⟩ := gradedMkZero_surjective y
      have hbr : gradedBracket 2 G 0 0 (gradedMkZero 2 G a) (gradedMkZero 2 G b) = 0 := by
        rw [gradedBracket_gradedMkZero, gradedMk_eq_zero_iff]
        exact hG.commutator_pLowerCentralSeries_top_le_add_two hpow 0
          (commutator_mem_commutator (mem_pLowerCentralSeries_zero 2 a) (mem_top b))
      rw [hbr, add_zero]
    · exact gradedPow_add_zero_of_odd (hp.out.odd_of_ne_two hp2) x y

/-- **Surjectivity of the graded `p`-power operator** (Dixon–du Sautoy–Mann–Segal, Lemma 3.4):
in a profinite powerful pro-`p` group, `gradedPow p G k : gr_k(G) → gr_{k+1}(G)` is surjective in
every degree `k`. -/
theorem gradedPow_surjective (hG : IsProP p G) (hpow : IsPowerful p G) (k : ℕ) :
    Function.Surjective (gradedPow p G k) := fun z ↦ by
  obtain ⟨⟨g, hg⟩, rfl⟩ := gradedMk_surjective (k + 1) z
  obtain ⟨x, rfl⟩ := (hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow (k + 1)).mp hg
  let y : pLowerCentralSeries p G k :=
    ⟨x ^ (p ^ k), (hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow k).mpr ⟨x, rfl⟩⟩
  refine ⟨gradedMk p G k y, ?_⟩
  rw [gradedPow_gradedMk]
  congr 1
  exact Subtype.ext (by simp [y, pow_succ, pow_mul])

/-- In a topologically finitely generated profinite powerful pro-`p` group, the cardinalities of
the graded pieces `gr_k(G) = λ_k ⧸ λ_{k+1}` form a nonincreasing sequence. -/
theorem antitone_natCard_gradedPiece (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) (hpow : IsPowerful p G) :
    Antitone fun k ↦ Nat.card (gradedPiece p G k) := by
  refine antitone_nat_of_succ_le fun k ↦ ?_
  have := hfg.finite_gradedPiece hp.out k
  exact Nat.card_le_card_of_surjective (gradedPow p G k) (hG.gradedPow_surjective hpow k)

/-- **Multiplicativity of the `p`-th power map modulo `λ_{m+2}`** in a profinite powerful pro-`p`
group: for arbitrary `x : G` and `y ∈ λ_m(G)`, `(x * y) ^ p = x ^ p * y ^ p` in `G ⧸ λ_{m+2}(G)`,
for every prime `p`. -/
theorem mk_mul_pow_pLowerCentralSeries_add_two (hG : IsProP p G) (hpow : IsPowerful p G)
    (m : ℕ) (x : G) {y : G} (hy : y ∈ pLowerCentralSeries p G m) :
    ((x * y : G) : G ⧸ pLowerCentralSeries p G (m + 2)) ^ p =
      (x : G ⧸ pLowerCentralSeries p G (m + 2)) ^ p *
        (y : G ⧸ pLowerCentralSeries p G (m + 2)) ^ p := by
  set N := pLowerCentralSeries p G (m + 2)
  rw [QuotientGroup.mk_mul]
  by_cases hp2 : p = 2
  · subst hp2
    have hcomm : Commute (x : G ⧸ N) (y : G ⧸ N) := by
      rw [QuotientGroup.commute_mk_iff, ← inv_mem_iff, commutatorElement_inv]
      exact hG.commutator_pLowerCentralSeries_top_le_add_two hpow m
        (commutator_mem_commutator hy (mem_top x))
    exact hcomm.mul_pow 2
  · have hyx : ⁅y, x⁆ ∈ pLowerCentralSeries p G (m + 1) :=
      commutator_mem_pLowerCentralSeries_succ hy x
    have hmk_comm : ⁅(y : G ⧸ N), (x : G ⧸ N)⁆ = ((⁅y, x⁆ : G) : G ⧸ N) :=
      (map_commutatorElement (QuotientGroup.mk' N) y x).symm
    have hchoose : p ∣ p.choose 2 :=
      hp.out.dvd_choose_self two_ne_zero (lt_of_le_of_ne hp.out.two_le (Ne.symm hp2))
    obtain ⟨c, hc⟩ := hchoose
    have hpow_yx : (((⁅y, x⁆ : G) : G ⧸ N) ^ p) = 1 := by
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
      exact pow_mem_pLowerCentralSeries hyx
    rw [Commute.mul_pow_eq_pow_mul_pow_mul_commutatorElement_pow_choose_two
        (hmk_comm.symm ▸ commute_mk_of_mem_pLowerCentralSeries hyx x)
        (hmk_comm.symm ▸ commute_mk_of_mem_pLowerCentralSeries hyx y) p,
      hmk_comm, hc, pow_mul, hpow_yx, one_pow, mul_one]

/-- One step of the torsion-lifting iteration: if `x ^ p ∈ λ_{k+2}`, there exists `y ∈ λ_{k+1}`
such that `(x * y) ^ p ∈ λ_{k+3}`. -/
private theorem exists_mul_pow_mem_pLowerCentralSeries_add_three (hG : IsProP p G)
    (hpow : IsPowerful p G) (k : ℕ) {x : G} (hx : x ^ p ∈ pLowerCentralSeries p G (k + 2)) :
    ∃ y ∈ pLowerCentralSeries p G (k + 1), (x * y) ^ p ∈ pLowerCentralSeries p G (k + 3) := by
  obtain ⟨u, hu⟩ := (hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow (k + 2)).mp
    (inv_mem hx)
  refine ⟨u ^ (p ^ (k + 1)),
    (hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow (k + 1)).mpr ⟨u, rfl⟩, ?_⟩
  rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow,
    hG.mk_mul_pow_pLowerCentralSeries_add_two hpow (k + 1) x
      ((hG.mem_pLowerCentralSeries_iff_exists_pow_pow hpow (k + 1)).mpr ⟨u, rfl⟩),
    ← QuotientGroup.mk_pow, ← QuotientGroup.mk_pow, ← pow_mul, ← pow_succ, hu,
    ← QuotientGroup.mk_mul, mul_inv_cancel, QuotientGroup.mk_one]

/-- **Torsion lifting in a powerful pro-`p` group** (Dixon–du Sautoy–Mann–Segal, Lemma 4.2):
if an element `x ∉ λ_1(G)` satisfies `x ^ p ∈ λ_2(G)`, then `G` contains a nontrivial element of
order `p`. No finite generation is needed. -/
theorem exists_pow_eq_one_of_notMem_pLowerCentralSeries_one (hG : IsProP p G)
    (hpow : IsPowerful p G) {x : G} (hx1 : x ∉ pLowerCentralSeries p G 1)
    (hx2 : x ^ p ∈ pLowerCentralSeries p G 2) :
    ∃ g : G, g ≠ 1 ∧ g ^ p = 1 := by
  -- Recursively refine `x` modulo `λ_{k+1}` so that `(seq k) ^ p ∈ λ_{k+2}`.
  let step : ∀ k, {z : G // z ^ p ∈ pLowerCentralSeries p G (k + 2)} →
      {z : G // z ^ p ∈ pLowerCentralSeries p G (k + 3)} := fun k s ↦
    let h := hG.exists_mul_pow_mem_pLowerCentralSeries_add_three hpow k s.2
    ⟨s.1 * Classical.choose h, (Classical.choose_spec h).2⟩
  let seq : ∀ k, {z : G // z ^ p ∈ pLowerCentralSeries p G (k + 2)} := fun k ↦
    Nat.rec ⟨x, hx2⟩ step k
  have hstep_eq : ∀ k, ((seq (k + 1)).1 : G ⧸ pLowerCentralSeries p G (k + 1)) =
      ((seq k).1 : G ⧸ pLowerCentralSeries p G (k + 1)) := fun k ↦ by
    have h := hG.exists_mul_pow_mem_pLowerCentralSeries_add_three hpow k (seq k).2
    have hmem : Classical.choose h ∈ pLowerCentralSeries p G (k + 1) := (Classical.choose_spec h).1
    dsimp only [seq, step]
    rw [QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff _).mpr hmem, mul_one]
  obtain ⟨g, hg, -⟩ := hG.existsUnique_forall_mk_eq_pLowerCentralSeries hp.out
    (fun k ↦ ((seq k).1 : G ⧸ pLowerCentralSeries p G k)) fun k z hz ↦ by
      have hz' : (z : G ⧸ pLowerCentralSeries p G (k + 1)) =
          ((seq k).1 : G ⧸ pLowerCentralSeries p G (k + 1)) := hz.trans (hstep_eq k)
      simpa using congrArg (QuotientGroup.mapOfLE (pLowerCentralSeries_succ_le k)) hz'
  refine ⟨g, fun h1 ↦ hx1 ?_, ?_⟩
  · have hg1 : (1 : G ⧸ pLowerCentralSeries p G 1) = (x : G ⧸ pLowerCentralSeries p G 1) := by
      simpa [h1, seq] using (hg 1).trans (hstep_eq 0)
    exact (QuotientGroup.eq_one_iff x).mp hg1.symm
  · refine mem_bot.mp ((hG.iInf_pLowerCentralSeries_eq_bot hp.out) ▸ mem_iInf.mpr fun k ↦ ?_)
    match k with
    | 0 => exact mem_pLowerCentralSeries_zero p _
    | 1 => exact pow_mem_pLowerCentralSeries (mem_pLowerCentralSeries_zero p g)
    | k + 2 =>
      set w : G := (seq k).1⁻¹ * g
      have hw1 : w ∈ pLowerCentralSeries p G (k + 1) :=
        QuotientGroup.eq.mp ((hg (k + 1)).trans (hstep_eq k)).symm
      have hg_eq : g = (seq k).1 * w := by simp [w]
      rw [← QuotientGroup.eq_one_iff, hg_eq, QuotientGroup.mk_pow,
        hG.mk_mul_pow_pLowerCentralSeries_add_two hpow k (seq k).1
          (pLowerCentralSeries_succ_le k hw1),
        ← QuotientGroup.mk_pow, ← QuotientGroup.mk_pow,
        (QuotientGroup.eq_one_iff _).mpr (seq k).2,
        (QuotientGroup.eq_one_iff _).mpr (pow_mem_pLowerCentralSeries hw1), one_mul]

/-- **Injectivity of `gradedPow` characterizes absence of `p`-torsion** in a profinite powerful
pro-`p` group (no finite generation needed). -/
theorem forall_eq_one_of_pow_eq_one_iff_injective_gradedPow (hG : IsProP p G)
    (hpow : IsPowerful p G) :
    (∀ g : G, g ^ p = 1 → g = 1) ↔ ∀ k, Function.Injective (gradedPow p G k) := by
  constructor
  · intro htors k
    let f : gradedPiece p G k →+ gradedPiece p G (k + 1) :=
      AddMonoidHom.mk' (gradedPow p G k) (hG.gradedPow_add hpow k)
    refine (injective_iff_map_eq_zero f).mpr fun z hz ↦ ?_
    obtain ⟨a, rfl⟩ := gradedMk_surjective k z
    rw [gradedMk_eq_zero_iff]
    by_contra ha1
    have hH_mem : ∀ j (b : pLowerCentralSeries p G k),
        b ∈ pLowerCentralSeries p (pLowerCentralSeries p G k) j ↔
          (b : G) ∈ pLowerCentralSeries p G (k + j) := fun j b ↦ by
      rw [← hG.map_subtype_pLowerCentralSeries_pLowerCentralSeries hpow k j, mem_map]
      exact ⟨fun hb ↦ ⟨b, hb, rfl⟩, fun ⟨c, hc, hcb⟩ ↦ Subtype.ext hcb ▸ hc⟩
    have ha_not1 : a ∉ pLowerCentralSeries p (pLowerCentralSeries p G k) 1 :=
      (hH_mem 1 a).not.mpr ha1
    have ha_pow2 : a ^ p ∈ pLowerCentralSeries p (pLowerCentralSeries p G k) 2 :=
      (hH_mem 2 (a ^ p)).mpr <| by
        rw [coe_pow]
        simpa [f, gradedPow_gradedMk] using hz
    obtain ⟨h, hne, hhp⟩ :=
      (hG.subgroup (pLowerCentralSeries p G k)).exists_pow_eq_one_of_notMem_pLowerCentralSeries_one
        (hG.isPowerful_pLowerCentralSeries hpow k) ha_not1 ha_pow2
    exact hne (Subtype.ext (htors (h : G) (by rw [← coe_pow, hhp]; rfl)))
  · intro hinj g hgp
    refine mem_bot.mp ((hG.iInf_pLowerCentralSeries_eq_bot hp.out) ▸ mem_iInf.mpr fun k ↦ ?_)
    induction k with
    | zero => exact mem_pLowerCentralSeries_zero p g
    | succ k ih =>
      have h0 : gradedPow p G k (gradedMk p G k ⟨g, ih⟩) = gradedPow p G k 0 := by
        rw [gradedPow_gradedMk, gradedPow_zero, gradedMk_eq_zero_iff]
        simp [hgp]
      exact gradedMk_eq_zero_iff.mp (hinj k h0)

/-- **Bijectivity of `gradedPow` characterizes absence of `p`-torsion** in a profinite powerful
pro-`p` group (no finite generation needed). -/
theorem forall_eq_one_of_pow_eq_one_iff_bijective_gradedPow (hG : IsProP p G)
    (hpow : IsPowerful p G) :
    (∀ g : G, g ^ p = 1 → g = 1) ↔ ∀ k, Function.Bijective (gradedPow p G k) := by
  rw [hG.forall_eq_one_of_pow_eq_one_iff_injective_gradedPow hpow]
  exact forall_congr' fun k ↦ ⟨fun h ↦ ⟨h, hG.gradedPow_surjective hpow k⟩, fun h ↦ h.1⟩

end IsProP

