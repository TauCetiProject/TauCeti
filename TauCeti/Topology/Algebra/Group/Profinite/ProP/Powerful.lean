/-!
# Powerful topological and pro-`p` groups

This file develops the closed power subgroups `TauCeti.closedPowerSubgroup G n = closure ⟨g^n⟩`,
the powerfulness predicate `TauCeti.IsPowerful p G`, and the structure of topologically finitely
generated powerful pro-`p` groups (Dixon–du Sautoy–Mann–Segal, Chapter 3).

A topological group `G` is **powerful** relative to `p` when its commutator subgroup lies in the
closed subgroup generated by `p`-th powers for `p ≠ 2`, respectively `4`-th powers for `p = 2`:

  `⁅⊤, ⊤⁆ ≤ closedPowerSubgroup G (if p = 2 then 4 else p)`.

The fourth-power condition at `p = 2` is essential: in every dihedral group `DihedralGroup n` the
commutator subgroup lies in its squares
(`TauCeti.commutator_dihedralGroup_le_closedPowerSubgroup_two`), yet whenever `4 ∣ n` (in
particular for the dihedral group of order `8`) it does not lie in its fourth powers, so the group
is not powerful at `p = 2` (`TauCeti.not_isPowerful_two_dihedralGroup`). At odd primes `p`, the
Heisenberg group over `ZMod p` has exponent `p` and nontrivial commutator subgroup, so it is not
powerful (`TauCeti.not_isPowerful_heisenbergGroup_zmod`).

For a general powerful topological group and prime `p`, the `p`-power operator `TauCeti.gradedPow`
on the graded pieces of the lower `p`-series is additive in every degree, including degree `0` at
`p = 2` (`TauCeti.IsPowerful.gradedPow_add`). For a topologically finitely generated powerful
pro-`p` group `G`, passing to the finite powerful `p`-group quotients `G ⧸ λ_k` yields DDMS
Theorem 3.6:

* every element of `λ_k(G)` is a genuine `p ^ k`-th power
  (`TauCeti.IsPowerful.mem_pLowerCentralSeries_iff_exists_pow_pow`),
* `λ_k(G) = closedPowerSubgroup G (p ^ k)`
  (`TauCeti.IsPowerful.pLowerCentralSeries_eq_closedPowerSubgroup`),
* `closedPowerSubgroup G p` coincides with the pro-`p` Frattini subgroup and has index `p ^ d(G)`,
* each graded `p`-power map `gr_k(G) → gr_{k+1}(G)` is surjective, so the graded orders are
  antitone (`TauCeti.IsPowerful.gradedPow_surjective`,
  `TauCeti.IsPowerful.natCard_gradedPiece_antitone`),
* every term `λ_k(G)` is itself powerful, with `λ_j(λ_k(G)) = λ_{k + j}(G)`
  (`TauCeti.IsPowerful.pLowerCentralSeries_isPowerful`,
  `TauCeti.IsPowerful.map_subtype_pLowerCentralSeries_pLowerCentralSeries`), and
* modulo `λ_{n+2}(G)`, `(a * y) ^ p = a ^ p * y ^ p` for all `a : G` and `y ∈ λ_n(G)`
  (`TauCeti.IsPowerful.mk_mul_pow_prime_eq`).

## Main definitions

* `TauCeti.closedPowerSubgroup`: the closed subgroup generated by all `n`-th powers of a
  topological group.
* `TauCeti.IsPowerful`: powerfulness of a topological group relative to `p`, with the `4`-th power
  condition at `p = 2`.
* `TauCeti.IsPowerful.gradedPowAddMonoidHom`: the graded `p`-power map as an additive homomorphism
  in every degree `k : ℕ`.

## Main results

* `TauCeti.closedPowerSubgroup_prod`, `TauCeti.closedPowerSubgroup_pi`: closed power subgroups
  commute with binary and arbitrary indexed products.
* `TauCeti.IsPowerful.of_surjective`, `TauCeti.isPowerful_congr`, `TauCeti.isPowerful_prod_iff`,
  `TauCeti.isPowerful_pi_iff`: functoriality and product stability of `IsPowerful`.
* `TauCeti.IsPowerful.mem_pLowerCentralSeries_iff_exists_pow_pow`,
  `TauCeti.IsPowerful.pLowerCentralSeries_eq_closedPowerSubgroup`,
  `TauCeti.IsPowerful.pLowerCentralSeries_isPowerful`,
  `TauCeti.IsPowerful.map_subtype_pLowerCentralSeries_pLowerCentralSeries`: DDMS Theorem 3.6.
* `TauCeti.IsPowerful.gradedPow_surjective`, `TauCeti.IsPowerful.mk_mul_pow_prime_eq`: graded
  surjectivity and the product-power congruence modulo `λ_{n+2}`.
* `TauCeti.commutator_dihedralGroup_le_closedPowerSubgroup_two`,
  `TauCeti.not_isPowerful_two_dihedralGroup`, `TauCeti.not_isPowerful_heisenbergGroup_zmod`:
  concrete non-powerful examples.

## References

* J. D. Dixon, M. P. F. du Sautoy, A. Mann and D. Segal, *Analytic pro-`p` groups*, 2nd ed.,
  Cambridge University Press, 1999, Chapter 3, Theorem 3.6.
-/

public section

open Subgroup
open scoped commutatorElement Topology

namespace TauCeti

/-! ### Closed power subgroups -/

section ClosedPowerSubgroup

variable (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The **closed `n`-th power subgroup** of a topological group `G`: the topological closure of the
subgroup generated by all `n`-th powers `g ^ n`. -/
def closedPowerSubgroup (n : ℕ) : Subgroup G :=
  (Subgroup.closure (Set.range fun g : G ↦ g ^ n)).topologicalClosure

/-- The defining equation of `TauCeti.closedPowerSubgroup`. -/
theorem closedPowerSubgroup_def (n : ℕ) :
    closedPowerSubgroup G n =
      (Subgroup.closure (Set.range fun g : G ↦ g ^ n)).topologicalClosure := by
  rw [closedPowerSubgroup]

/-- `closedPowerSubgroup G n` is the topological closure of the abstract power subgroup
`(⊤ : Subgroup G).powerClosure n`. -/
theorem closedPowerSubgroup_eq_topologicalClosure_powerClosure (n : ℕ) :
    closedPowerSubgroup G n = ((⊤ : Subgroup G).powerClosure n).topologicalClosure := by
  rw [closedPowerSubgroup_def, Subgroup.powerClosure_top]

/-- Every closed power subgroup is closed. -/
instance isClosed_closedPowerSubgroup (n : ℕ) : IsClosed (closedPowerSubgroup G n : Set G) := by
  rw [closedPowerSubgroup_def]
  exact isClosed_topologicalClosure _

/-- Every closed power subgroup is normal. -/
instance closedPowerSubgroup_normal (n : ℕ) : (closedPowerSubgroup G n).Normal := by
  rw [closedPowerSubgroup_eq_topologicalClosure_powerClosure]
  exact is_normal_topologicalClosure _

variable {G}

/-- Every `n`-th power lies in `closedPowerSubgroup G n`. -/
theorem pow_mem_closedPowerSubgroup (g : G) (n : ℕ) : g ^ n ∈ closedPowerSubgroup G n :=
  le_topologicalClosure _ (Subgroup.subset_closure ⟨g, rfl⟩)

/-- A closed subgroup contains `closedPowerSubgroup G n` if and only if it contains every `n`-th
power. -/
theorem closedPowerSubgroup_le_iff {n : ℕ} {S : Subgroup G} (hS : IsClosed (S : Set G)) :
    closedPowerSubgroup G n ≤ S ↔ ∀ g : G, g ^ n ∈ S := by
  refine ⟨fun h g ↦ h (pow_mem_closedPowerSubgroup g n), fun h ↦ ?_⟩
  rw [closedPowerSubgroup_def]
  refine topologicalClosure_minimal _ ((Subgroup.closure_le _).mpr ?_) hS
  rintro _ ⟨g, rfl⟩
  exact h g

/-- If `m ∣ n`, then `closedPowerSubgroup G n ≤ closedPowerSubgroup G m`. -/
theorem closedPowerSubgroup_le_of_dvd {m n : ℕ} (h : m ∣ n) :
    closedPowerSubgroup G n ≤ closedPowerSubgroup G m := by
  obtain ⟨k, rfl⟩ := h
  refine (closedPowerSubgroup_le_iff (isClosed_closedPowerSubgroup G m)).mpr fun g ↦ ?_
  rw [mul_comm, pow_mul]
  exact pow_mem_closedPowerSubgroup (g ^ k) m

variable (G) in
/-- The closed `1`-st power subgroup is the whole group. -/
@[simp]
theorem closedPowerSubgroup_one : closedPowerSubgroup G 1 = ⊤ :=
  eq_top_iff.mpr fun g _ ↦ by simpa using pow_mem_closedPowerSubgroup g 1

variable (G) in
/-- In a `T1Space` topological group, the closed `0`-th power subgroup is trivial. -/
@[simp]
theorem closedPowerSubgroup_zero [T1Space G] : closedPowerSubgroup G 0 = ⊥ :=
  le_bot_iff.mp ((closedPowerSubgroup_le_iff (isClosed_singleton (x := (1 : G)))).mpr
    fun g ↦ by simp)

/-- On a discrete topological group, `closedPowerSubgroup G n` coincides with the abstract power
subgroup `(⊤ : Subgroup G).powerClosure n`. -/
theorem closedPowerSubgroup_eq_powerClosure_of_discreteTopology [DiscreteTopology G] (n : ℕ) :
    closedPowerSubgroup G n = (⊤ : Subgroup G).powerClosure n := by
  rw [closedPowerSubgroup_eq_topologicalClosure_powerClosure]
  exact le_antisymm (topologicalClosure_minimal _ le_rfl (isClosed_discrete _))
    (le_topologicalClosure _)

/-- The closed `p`-th power subgroup lies in the first term `λ_1` of the lower `p`-series. -/
theorem closedPowerSubgroup_le_pLowerCentralSeries_one (p : ℕ) :
    closedPowerSubgroup G p ≤ pLowerCentralSeries p G 1 :=
  (closedPowerSubgroup_le_iff (isClosed_pLowerCentralSeries 1)).mpr fun g ↦
    pow_mem_pLowerCentralSeries (mem_pLowerCentralSeries_zero p g)

/-- The closed `p ^ k`-th power subgroup lies in `λ_k`. -/
theorem closedPowerSubgroup_pow_le_pLowerCentralSeries (p k : ℕ) :
    closedPowerSubgroup G (p ^ k) ≤ pLowerCentralSeries p G k :=
  (closedPowerSubgroup_le_iff (isClosed_pLowerCentralSeries k)).mpr fun g ↦ by
    simpa only [zero_add] using
      pow_pow_mem_pLowerCentralSeries (mem_pLowerCentralSeries_zero p g) k

/-- In a compact Hausdorff abelian group, `closedPowerSubgroup G n` is simply the range of the
`n`-th power homomorphism `g ↦ g ^ n`. -/
theorem closedPowerSubgroup_eq_range_powMonoidHom {A : Type*} [CommGroup A] [TopologicalSpace A]
    [IsTopologicalGroup A] [CompactSpace A] [T2Space A] (n : ℕ) :
    closedPowerSubgroup A n = (powMonoidHom n : A →* A).range := by
  have hclosed : IsClosed (((powMonoidHom n : A →* A).range : Subgroup A) : Set A) :=
    (isCompact_range (continuous_pow n)).isClosed
  refine le_antisymm ((closedPowerSubgroup_le_iff hclosed).mpr fun g ↦ ⟨g, rfl⟩) ?_
  rintro _ ⟨g, rfl⟩
  exact pow_mem_closedPowerSubgroup g n

section Functoriality

variable {H : Type*} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]

/-- A continuous homomorphism maps `closedPowerSubgroup G n` into `closedPowerSubgroup H n`. -/
theorem _root_.MonoidHom.map_closedPowerSubgroup_le (f : G →* H) (hf : Continuous f) (n : ℕ) :
    (closedPowerSubgroup G n).map f ≤ closedPowerSubgroup H n := by
  rw [map_le_iff_le_comap]
  refine (closedPowerSubgroup_le_iff ((isClosed_closedPowerSubgroup H n).preimage hf)).mpr
    fun g ↦ ?_
  rw [mem_comap, map_pow]
  exact pow_mem_closedPowerSubgroup (f g) n

/-- A continuous closed surjective homomorphism maps `closedPowerSubgroup G n` onto
`closedPowerSubgroup H n`. -/
theorem _root_.MonoidHom.map_closedPowerSubgroup_eq_of_surjective (f : G →* H) (hf : Continuous f)
    (hfc : IsClosedMap f) (hsurj : Function.Surjective f) (n : ℕ) :
    (closedPowerSubgroup G n).map f = closedPowerSubgroup H n := by
  refine le_antisymm (f.map_closedPowerSubgroup_le hf n) ?_
  have hclosed : IsClosed (((closedPowerSubgroup G n).map f : Subgroup H) : Set H) := by
    rw [coe_map]
    exact hfc _ (isClosed_closedPowerSubgroup G n)
  refine (closedPowerSubgroup_le_iff hclosed).mpr fun h ↦ ?_
  obtain ⟨g, rfl⟩ := hsurj h
  exact ⟨g ^ n, pow_mem_closedPowerSubgroup g n, map_pow f g n⟩

/-- A topological group isomorphism carries `closedPowerSubgroup G n` onto
`closedPowerSubgroup H n`. -/
theorem _root_.ContinuousMulEquiv.map_closedPowerSubgroup_eq (e : G ≃ₜ* H) (n : ℕ) :
    (closedPowerSubgroup G n).map e.toMulEquiv.toMonoidHom = closedPowerSubgroup H n :=
  e.toMulEquiv.toMonoidHom.map_closedPowerSubgroup_eq_of_surjective e.continuous
    e.toHomeomorph.isClosedMap e.surjective n

/-- Every closed power subgroup is topologically characteristic. -/
theorem isTopCharacteristic_closedPowerSubgroup (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (n : ℕ) : IsTopCharacteristic G (closedPowerSubgroup G n) :=
  isTopCharacteristic_iff_map_eq.mpr fun φ ↦ φ.map_closedPowerSubgroup_eq n

/-- Topological group isomorphisms preserve the index of every closed power subgroup. -/
theorem closedPowerSubgroup_index_congr (e : G ≃ₜ* H) (n : ℕ) :
    (closedPowerSubgroup G n).index = (closedPowerSubgroup H n).index := by
  rw [← e.map_closedPowerSubgroup_eq n]
  exact (Subgroup.index_map_equiv (closedPowerSubgroup G n) e.toMulEquiv).symm

end Functoriality

section Products

/-- Closed power subgroups commute with binary products of topological groups. -/
theorem closedPowerSubgroup_prod (G H : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [Group H] [TopologicalSpace H] [IsTopologicalGroup H] (n : ℕ) :
    closedPowerSubgroup (G × H) n =
      (closedPowerSubgroup G n).prod (closedPowerSubgroup H n) := by
  refine le_antisymm ?_ ?_
  · have hclosed : IsClosed
        ((((closedPowerSubgroup G n).prod (closedPowerSubgroup H n) : Subgroup (G × H)) :
          Set (G × H))) :=
      (isClosed_closedPowerSubgroup G n).prod (isClosed_closedPowerSubgroup H n)
    refine (closedPowerSubgroup_le_iff hclosed).mpr fun ⟨g, h⟩ ↦ ?_
    exact ⟨pow_mem_closedPowerSubgroup g n, pow_mem_closedPowerSubgroup h n⟩
  · rintro ⟨x, y⟩ ⟨hx, hy⟩
    have hx' : (x, (1 : H)) ∈ closedPowerSubgroup (G × H) n :=
      (MonoidHom.inl G H).map_closedPowerSubgroup_le (continuous_id.prodMk continuous_const) n
        ⟨x, hx, rfl⟩
    have hy' : ((1 : G), y) ∈ closedPowerSubgroup (G × H) n :=
      (MonoidHom.inr G H).map_closedPowerSubgroup_le (continuous_const.prodMk continuous_id) n
        ⟨y, hy, rfl⟩
    have hxy : (x, y) = (x, 1) * (1, y) := by simp
    rw [hxy]
    exact mul_mem hx' hy'

/-- Closed power subgroups commute with arbitrary products of topological groups. -/
theorem closedPowerSubgroup_pi {ι : Type*} (F : ι → Type*) [∀ i, Group (F i)]
    [∀ i, TopologicalSpace (F i)] [∀ i, IsTopologicalGroup (F i)] (n : ℕ) :
    closedPowerSubgroup (∀ i, F i) n =
      Subgroup.pi Set.univ fun i ↦ closedPowerSubgroup (F i) n := by
  classical
  refine le_antisymm ?_ ?_
  · have hclosed : IsClosed
        (((Subgroup.pi Set.univ fun i ↦ closedPowerSubgroup (F i) n :
          Subgroup (∀ i, F i)) : Set (∀ i, F i))) :=
      isClosed_set_pi fun i _ ↦ isClosed_closedPowerSubgroup (F i) n
    refine (closedPowerSubgroup_le_iff hclosed).mpr fun f i _ ↦ ?_
    exact pow_mem_closedPowerSubgroup (f i) n
  · intro x hx
    have hsingle : ∀ i, Pi.mulSingle i (x i) ∈ closedPowerSubgroup (∀ i, F i) n := fun i ↦
      (MonoidHom.mulSingle F i).map_closedPowerSubgroup_le (continuous_mulSingle i) n
        ⟨x i, hx i trivial, MonoidHom.mulSingle_apply i (x i)⟩
    rw [← SetLike.mem_coe, ← (isClosed_closedPowerSubgroup (∀ i, F i) n).closure_eq,
      mem_closure_iff_nhds]
    intro U hU
    rw [nhds_pi] at hU
    obtain ⟨I, hI, t, ht, hIt⟩ := Filter.mem_pi.mp hU
    refine ⟨fun i ↦ if i ∈ I then x i else 1, hIt (Set.mem_pi.mpr fun i hi ↦ ?_), ?_⟩
    · simp only [hi, ↓reduceIte]
      exact mem_of_mem_nhds (ht i)
    · refine Submonoid.pi_mem_of_mulSingle_mem_aux hI.toFinset _ (fun i hi ↦ ?_) fun i _ ↦ ?_
      · rw [hI.mem_toFinset] at hi
        simp only [hi, ↓reduceIte]
      · simpa only [hI.mem_toFinset.mp ‹_›, ↓reduceIte] using hsingle i

end Products

end ClosedPowerSubgroup

/-! ### Powerful topological groups -/

section IsPowerful

variable {G H : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [Group H] [TopologicalSpace H] [IsTopologicalGroup H]

/-- A topological group `G` is **powerful** relative to `p` if its commutator subgroup lies in
`closedPowerSubgroup G p` for `p ≠ 2`, respectively `closedPowerSubgroup G 4` for `p = 2`. -/
def IsPowerful (p : ℕ) (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] : Prop :=
  ⁅(⊤ : Subgroup G), ⊤⁆ ≤ closedPowerSubgroup G (if p = 2 then 4 else p)

/-- The unfolding characterization of `TauCeti.IsPowerful`. -/
theorem isPowerful_iff (p : ℕ) (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] :
    IsPowerful p G ↔ ⁅(⊤ : Subgroup G), ⊤⁆ ≤ closedPowerSubgroup G (if p = 2 then 4 else p) :=
  Iff.rfl

/-- Every commutative topological group is powerful for every `p`. -/
theorem isPowerful_of_isMulCommutative [IsMulCommutative G] (p : ℕ) : IsPowerful p G := by
  rw [isPowerful_iff, commutator_le]
  intro a _ b _
  rw [commutatorElement_eq_one_iff_commute.mpr (IsMulCommutative.is_comm.comm a b)]
  exact one_mem _

/-- On a discrete group, `IsPowerful p G` coincides with `(⊤ : Subgroup G).IsPowerfullyEmbedded p`.
-/
theorem isPowerful_iff_isPowerfullyEmbedded_of_discreteTopology [DiscreteTopology G] (p : ℕ) :
    IsPowerful p G ↔ (⊤ : Subgroup G).IsPowerfullyEmbedded p := by
  rw [isPowerful_iff, Subgroup.isPowerfullyEmbedded_iff,
    closedPowerSubgroup_eq_powerClosure_of_discreteTopology]
  exact ⟨fun h ↦ ⟨inferInstance, h⟩, fun h ↦ h.2⟩

namespace IsPowerful

variable {p : ℕ}

/-- The defining commutator bound of a powerful topological group. -/
theorem commutator_le (hG : IsPowerful p G) :
    ⁅(⊤ : Subgroup G), ⊤⁆ ≤ closedPowerSubgroup G (if p = 2 then 4 else p) :=
  hG

/-- Every powerful topological group satisfies `⁅⊤, ⊤⁆ ≤ closedPowerSubgroup G p`, for both odd `p`
and `p = 2`. -/
theorem commutator_le_closedPowerSubgroup_prime (hG : IsPowerful p G) :
    ⁅(⊤ : Subgroup G), ⊤⁆ ≤ closedPowerSubgroup G p := by
  by_cases hp2 : p = 2
  · subst hp2
    have h4 : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ closedPowerSubgroup G 4 := by simpa using hG.commutator_le
    exact h4.trans (closedPowerSubgroup_le_of_dvd (by decide : 2 ∣ 4))
  · simpa [hp2] using hG.commutator_le

/-- Powerfulness passes along continuous surjective homomorphisms. -/
theorem of_surjective (hG : IsPowerful p G) {f : G →* H} (hf : Continuous f)
    (hsurj : Function.Surjective f) : IsPowerful p H := by
  rw [isPowerful_iff, ← map_top_of_surjective f hsurj, ← map_commutator]
  exact (map_mono hG.commutator_le).trans (f.map_closedPowerSubgroup_le hf _)

/-- Every quotient of a powerful topological group by a normal subgroup is powerful. -/
theorem quotient (hG : IsPowerful p G) (N : Subgroup G) [N.Normal] : IsPowerful p (G ⧸ N) :=
  hG.of_surjective QuotientGroup.continuous_mk (QuotientGroup.mk'_surjective N)

/-- Powerfulness transfers along a topological group isomorphism. -/
theorem of_equiv (hG : IsPowerful p G) (e : G ≃ₜ* H) : IsPowerful p H :=
  hG.of_surjective (f := e.toMulEquiv.toMonoidHom) e.continuous e.surjective

/-- A binary product of powerful topological groups is powerful. -/
theorem prod (hG : IsPowerful p G) (hH : IsPowerful p H) : IsPowerful p (G × H) := by
  rw [isPowerful_iff, closedPowerSubgroup_prod, Subgroup.commutator_le]
  rintro ⟨a₁, b₁⟩ _ ⟨a₂, b₂⟩ _
  exact ⟨hG.commutator_le (commutator_mem_commutator (mem_top a₁) (mem_top a₂)),
    hH.commutator_le (commutator_mem_commutator (mem_top b₁) (mem_top b₂))⟩

/-- An arbitrary product of powerful topological groups is powerful. -/
theorem pi {ι : Type*} {F : ι → Type*} [∀ i, Group (F i)] [∀ i, TopologicalSpace (F i)]
    [∀ i, IsTopologicalGroup (F i)] (hF : ∀ i, IsPowerful p (F i)) :
    IsPowerful p (∀ i, F i) := by
  rw [isPowerful_iff, closedPowerSubgroup_pi, Subgroup.commutator_le]
  intro a _ b _ i _
  exact (hF i).commutator_le (commutator_mem_commutator (mem_top (a i)) (mem_top (b i)))

/-- **Additivity of the graded `p`-power operator.** In any powerful topological group (for a prime
`p`), the `p`-power map `gradedPow p G k : gr_k(G) → gr_{k+1}(G)` is additive in every degree
`k : ℕ`, including degree `0` at `p = 2` (where the fourth-power condition kills the dyadic defect
`[x, y]`). -/
theorem gradedPow_add [hp : Fact p.Prime] (hG : IsPowerful p G) (k : ℕ)
    (x y : gradedPiece p G k) :
    gradedPow p G k (x + y) = gradedPow p G k x + gradedPow p G k y := by
  rcases eq_or_ne k 0 with rfl | hk
  · by_cases hp2 : p = 2
    · subst hp2
      rw [gradedPow_add_zero_of_two rfl]
      suffices hbr : gradedBracket 2 G 0 0 x y = 0 by rw [hbr, add_zero]
      obtain ⟨x, rfl⟩ := gradedMk_surjective 0 x
      obtain ⟨y, rfl⟩ := gradedMk_surjective 0 y
      rw [gradedBracket_gradedMk, gradedMk_eq_zero_iff]
      have h4 : ⁅(x : G), (y : G)⁆ ∈ closedPowerSubgroup G (2 ^ 2) := by
        simpa using hG.commutator_le (commutator_mem_commutator (mem_top (x : G)) (mem_top (y : G)))
      exact closedPowerSubgroup_pow_le_pLowerCentralSeries 2 2 h4
    · exact gradedPow_add_zero_of_odd (hp.out.odd_of_ne_two hp2) x y
  · exact gradedPow_add_of_one_le (Nat.one_le_iff_ne_zero.mpr hk) x y

/-- The graded `p`-power map of a powerful topological group as an additive homomorphism
`gr_k(G) →+ gr_{k+1}(G)` in every degree `k : ℕ`. -/
def gradedPowAddMonoidHom [Fact p.Prime] (hG : IsPowerful p G) (k : ℕ) :
    gradedPiece p G k →+ gradedPiece p G (k + 1) :=
  AddMonoidHom.mk' (gradedPow p G k) (hG.gradedPow_add k)

/-- Evaluation of `TauCeti.IsPowerful.gradedPowAddMonoidHom`. -/
@[simp]
theorem gradedPowAddMonoidHom_apply [Fact p.Prime] (hG : IsPowerful p G) (k : ℕ)
    (x : gradedPiece p G k) : hG.gradedPowAddMonoidHom k x = gradedPow p G k x := by
  rw [gradedPowAddMonoidHom]
  rfl

end IsPowerful

/-- Powerfulness is invariant under topological group isomorphism. -/
theorem isPowerful_congr {p : ℕ} (e : G ≃ₜ* H) : IsPowerful p G ↔ IsPowerful p H :=
  ⟨fun h ↦ h.of_equiv e, fun h ↦ h.of_equiv e.symm⟩

/-- A binary product of topological groups is powerful if and only if both factors are. -/
theorem isPowerful_prod_iff {p : ℕ} : IsPowerful p (G × H) ↔ IsPowerful p G ∧ IsPowerful p H :=
  ⟨fun h ↦ ⟨h.of_surjective (f := MonoidHom.fst G H) continuous_fst Prod.fst_surjective,
      h.of_surjective (f := MonoidHom.snd G H) continuous_snd Prod.snd_surjective⟩,
    fun ⟨hG, hH⟩ ↦ hG.prod hH⟩

/-- An arbitrary product of topological groups is powerful if and only if every factor is. -/
theorem isPowerful_pi_iff {p : ℕ} {ι : Type*} {F : ι → Type*} [∀ i, Group (F i)]
    [∀ i, TopologicalSpace (F i)] [∀ i, IsTopologicalGroup (F i)] :
    IsPowerful p (∀ i, F i) ↔ ∀ i, IsPowerful p (F i) :=
  ⟨fun h i ↦ h.of_surjective (f := Pi.evalMonoidHom F i) (continuous_apply i)
      (Function.surjective_eval i),
    IsPowerful.pi⟩

end IsPowerful

/-! ### Topologically finitely generated powerful pro-`p` groups -/

section ProP

variable {p : ℕ} [hp : Fact p.Prime] {G : Type*} [Group G] [TopologicalSpace G]
  [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G]

/-- In a topologically finitely generated pro-`p` group, the first term `λ_1` of the lower
`p`-series has index `p ^ d(G)`. -/
theorem IsProP.index_pLowerCentralSeries_one (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) :
    (pLowerCentralSeries p G 1).index = p ^ topologicalGeneratorRankNat G hfg := by
  rw [pLowerCentralSeries_one_eq_proPFrattini hp.out, Subgroup.index_eq_card,
    hG.natCard_quotient_proPFrattini hfg]

namespace IsPowerful

/-- Every quotient `G ⧸ λ_k` of a topologically finitely generated powerful profinite group is
abstractly powerful. -/
theorem isPowerfullyEmbedded_quotient_pLowerCentralSeries (hpow : IsPowerful p G)
    (hfg : IsTopologicallyFinitelyGenerated G) (k : ℕ) :
    (⊤ : Subgroup (G ⧸ pLowerCentralSeries p G k)).IsPowerfullyEmbedded p := by
  have : DiscreteTopology (G ⧸ pLowerCentralSeries p G k) :=
    QuotientGroup.discreteTopology (hfg.isOpen_pLowerCentralSeries hp.out k)
  exact (isPowerful_iff_isPowerfullyEmbedded_of_discreteTopology p).mp (hpow.quotient _)

/-- **DDMS Theorem 3.6(iii).** In a topologically finitely generated powerful pro-`p` group `G`, an
element lies in `λ_k(G)` if and only if it is a `p ^ k`-th power in `G`. -/
theorem mem_pLowerCentralSeries_iff_exists_pow_pow (hpow : IsPowerful p G) (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) (k : ℕ) {x : G} :
    x ∈ pLowerCentralSeries p G k ↔ ∃ g : G, g ^ p ^ k = x := by
  refine ⟨fun hx ↦ ?_, fun ⟨g, hg⟩ ↦ by
    simpa only [zero_add, hg] using
      pow_pow_mem_pLowerCentralSeries (mem_pLowerCentralSeries_zero p g) k⟩
  set R : Set G := Set.range fun g : G ↦ g ^ p ^ k
  have hRclosed : IsClosed R := (isCompact_range (continuous_pow (p ^ k))).isClosed
  suffices hmem : x ∈ _root_.closure R by
    rw [hRclosed.closure_eq] at hmem
    exact hmem
  rw [mem_closure_iff_nhds]
  intro U hU
  have h1 : (fun y : G ↦ x * y) ⁻¹' U ∈ 𝓝 (1 : G) := by
    refine (continuous_const.mul continuous_id).continuousAt.preimage_mem_nhds ?_
    simpa using hU
  obtain ⟨n, hn⟩ :=
    (hG.hasAntitoneBasis_nhds_one_pLowerCentralSeries hfg hp.out).mem_iff.mp h1
  let q := QuotientGroup.mk' (pLowerCentralSeries p G n)
  have : Finite (G ⧸ pLowerCentralSeries p G n) :=
    hfg.finite_quotient_pLowerCentralSeries hp.out n
  have : DiscreteTopology (G ⧸ pLowerCentralSeries p G n) :=
    QuotientGroup.discreteTopology (hfg.isOpen_pLowerCentralSeries hp.out n)
  have hQx : q x ∈ (⊤ : Subgroup (G ⧸ pLowerCentralSeries p G n)).pLowerCentralSeries p k := by
    rw [← pLowerCentralSeries_eq_of_discreteTopology]
    exact q.map_pLowerCentralSeries_le QuotientGroup.continuous_mk k ⟨x, hx, rfl⟩
  obtain ⟨u, hu⟩ :=
    ((hpow.isPowerfullyEmbedded_quotient_pLowerCentralSeries hfg
      n).mem_pLowerCentralSeries_iff_exists_pow_pow
        (hG.isPGroup_quotient_pLowerCentralSeries hfg hp.out n) k).mp hQx
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective _ u
  have hdiff : x⁻¹ * g ^ p ^ k ∈ pLowerCentralSeries p G n := by
    rw [← QuotientGroup.eq]
    simpa [q, map_pow] using hu.symm
  exact ⟨g ^ p ^ k, by simpa using hn hdiff, ⟨g, rfl⟩⟩

/-- **DDMS Theorem 3.6(ii).** In a topologically finitely generated powerful pro-`p` group `G`, the
`k`-th term of the lower `p`-series is the closed `p ^ k`-th power subgroup. -/
theorem pLowerCentralSeries_eq_closedPowerSubgroup (hpow : IsPowerful p G) (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) (k : ℕ) :
    pLowerCentralSeries p G k = closedPowerSubgroup G (p ^ k) := by
  refine le_antisymm (fun x hx ↦ ?_) (closedPowerSubgroup_pow_le_pLowerCentralSeries p k)
  obtain ⟨g, rfl⟩ := (hpow.mem_pLowerCentralSeries_iff_exists_pow_pow hG hfg k).mp hx
  exact pow_mem_closedPowerSubgroup g (p ^ k)

/-- In a topologically finitely generated powerful pro-`p` group, `closedPowerSubgroup G p` equals
the pro-`p` Frattini subgroup `proPFrattini p G`. -/
theorem closedPowerSubgroup_prime_eq_proPFrattini (hpow : IsPowerful p G) (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) :
    closedPowerSubgroup G p = proPFrattini p G := by
  rw [← pLowerCentralSeries_one_eq_proPFrattini hp.out,
    hpow.pLowerCentralSeries_eq_closedPowerSubgroup hG hfg 1, pow_one]

/-- In a topologically finitely generated powerful pro-`p` group, `closedPowerSubgroup G p` has
index `p ^ d(G)`. -/
theorem index_closedPowerSubgroup_prime_eq_pow_rank (hpow : IsPowerful p G) (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) :
    (closedPowerSubgroup G p).index = p ^ topologicalGeneratorRankNat G hfg := by
  rw [hpow.closedPowerSubgroup_prime_eq_proPFrattini hG hfg, Subgroup.index_eq_card,
    hG.natCard_quotient_proPFrattini hfg]

/-- In a topologically finitely generated powerful pro-`p` group, every graded `p`-power map
`gr_k(G) → gr_{k+1}(G)` is surjective. -/
theorem gradedPow_surjective (hpow : IsPowerful p G) (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) (k : ℕ) :
    Function.Surjective (gradedPow p G k) := by
  intro y
  obtain ⟨⟨z, hz⟩, rfl⟩ := gradedMk_surjective (k + 1) y
  obtain ⟨g, rfl⟩ := (hpow.mem_pLowerCentralSeries_iff_exists_pow_pow hG hfg (k + 1)).mp hz
  have hgk : g ^ p ^ k ∈ pLowerCentralSeries p G k := by
    simpa only [zero_add] using
      pow_pow_mem_pLowerCentralSeries (mem_pLowerCentralSeries_zero p g) k
  refine ⟨gradedMk p G k ⟨g ^ p ^ k, hgk⟩, ?_⟩
  rw [gradedPow_gradedMk]
  congr 1
  exact Subtype.ext (by dsimp only; rw [← pow_mul, ← pow_succ])

/-- In a topologically finitely generated powerful pro-`p` group, the cardinalities of the graded
pieces `gr_k(G)` form a decreasing sequence. -/
theorem natCard_gradedPiece_antitone (hpow : IsPowerful p G) (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) :
    Antitone fun k ↦ Nat.card (gradedPiece p G k) :=
  antitone_nat_of_succ_le fun k ↦ by
    have : Finite (gradedPiece p G k) := hfg.finite_gradedPiece hp.out k
    exact Nat.card_le_card_of_surjective _ (hpow.gradedPow_surjective hG hfg k)

/-- **DDMS Theorem 3.6(i).** Every term `λ_k(G)` of the lower `p`-series of a topologically
finitely generated powerful pro-`p` group is itself powerful. -/
theorem pLowerCentralSeries_isPowerful (hpow : IsPowerful p G) (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) (k : ℕ) :
    IsPowerful p (pLowerCentralSeries p G k) := by
  set L := pLowerCentralSeries p G k
  set e : ℕ := if p = 2 then 4 else p
  set H : Subgroup G := (closedPowerSubgroup L e).map L.subtype
  have : CompactSpace L := isCompact_iff_compactSpace.mp (isClosed_pLowerCentralSeries k).isCompact
  have hHclosed : IsClosed (H : Set G) :=
    ((isClosed_closedPowerSubgroup L e).isCompact.image continuous_subtype_val).isClosed
  rw [isPowerful_iff, Subgroup.commutator_le]
  intro a _ b _
  suffices hmem : ⁅(a : G), (b : G)⁆ ∈ H by
    obtain ⟨w, hw, hwa⟩ := Subgroup.mem_map.mp hmem
    have hEq : w = ⁅a, b⁆ := L.subtype_injective hwa
    exact hEq ▸ hw
  refine hG.mem_of_forall_mk_mem_map_pLowerCentralSeries hp.out hHclosed fun n ↦ ?_
  let q := QuotientGroup.mk' (pLowerCentralSeries p G n)
  have : Finite (G ⧸ pLowerCentralSeries p G n) :=
    hfg.finite_quotient_pLowerCentralSeries hp.out n
  have : DiscreteTopology (G ⧸ pLowerCentralSeries p G n) :=
    QuotientGroup.discreteTopology (hfg.isOpen_pLowerCentralSeries hp.out n)
  have hQpow := hpow.isPowerfullyEmbedded_quotient_pLowerCentralSeries hfg n
  have hQpg := hG.isPGroup_quotient_pLowerCentralSeries hfg hp.out n
  have hLmap :
      L.map q = (⊤ : Subgroup (G ⧸ pLowerCentralSeries p G n)).pLowerCentralSeries p k := by
    rw [← pLowerCentralSeries_eq_of_discreteTopology]
    exact q.map_pLowerCentralSeries_eq_of_surjective QuotientGroup.continuous_mk
      QuotientGroup.continuous_mk.isClosedMap (QuotientGroup.mk'_surjective _) k
  have hN : (L.map q).IsPowerfullyEmbedded p := hLmap ▸ hQpow.pLowerCentralSeries hQpg k
  have hcomm : q ⁅(a : G), (b : G)⁆ ∈ (L.map q).powerClosure e := by
    rw [map_commutatorElement]
    exact hN.commutator_le
      (commutator_mem_commutator (mem_map_of_mem q a.2) (mem_top (q (b : G))))
  have hle : (L.map q).powerClosure e ≤ H.map q := by
    refine Subgroup.powerClosure_le_iff.mpr fun y hy ↦ ?_
    obtain ⟨x, hxL, rfl⟩ := Subgroup.mem_map.mp hy
    have hxH : x ^ e ∈ H :=
      Subgroup.mem_map.mpr ⟨(⟨x, hxL⟩ : L) ^ e, pow_mem_closedPowerSubgroup _ e,
        Subgroup.coe_pow L ⟨x, hxL⟩ e⟩
    exact Subgroup.mem_map.mpr ⟨x ^ e, hxH, map_pow q x e⟩
  exact hle hcomm

/-- **DDMS Theorem 3.6(iv).** In a topologically finitely generated powerful pro-`p` group `G`, the
lower `p`-series of `λ_k(G)` shifts the lower `p`-series of `G` by `k`:
`λ_j(λ_k(G)) = λ_{k + j}(G)`. -/
theorem map_subtype_pLowerCentralSeries_pLowerCentralSeries (hpow : IsPowerful p G)
    (hG : IsProP p G) (hfg : IsTopologicallyFinitelyGenerated G) (k j : ℕ) :
    (pLowerCentralSeries p (pLowerCentralSeries p G k) j).map (pLowerCentralSeries p G k).subtype =
      pLowerCentralSeries p G (k + j) := by
  set L := pLowerCentralSeries p G k
  have : CompactSpace L := isCompact_iff_compactSpace.mp (isClosed_pLowerCentralSeries k).isCompact
  have hLproP : IsProP p L := hG.subgroup L
  have hLfg : IsTopologicallyFinitelyGenerated L :=
    hfg.of_openSubgroup ⟨L, hfg.isOpen_pLowerCentralSeries hp.out k⟩
  have hLpow : IsPowerful p L := hpow.pLowerCentralSeries_isPowerful hG hfg k
  ext x
  rw [Subgroup.mem_map, hpow.mem_pLowerCentralSeries_iff_exists_pow_pow hG hfg (k + j)]
  constructor
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨w, rfl⟩ := (hLpow.mem_pLowerCentralSeries_iff_exists_pow_pow hLproP hLfg j).mp hy
    obtain ⟨g, hg⟩ := (hpow.mem_pLowerCentralSeries_iff_exists_pow_pow hG hfg k).mp w.2
    exact ⟨g, by rw [pow_add, pow_mul, hg, Subgroup.coe_subtype, Subgroup.coe_pow]⟩
  · rintro ⟨g, rfl⟩
    have hgk : g ^ p ^ k ∈ L := by
      simpa only [zero_add] using
        pow_pow_mem_pLowerCentralSeries (mem_pLowerCentralSeries_zero p g) k
    refine ⟨(⟨g ^ p ^ k, hgk⟩ : L) ^ p ^ j, ?_,
      by rw [Subgroup.coe_subtype, Subgroup.coe_pow, ← pow_mul, ← pow_add]⟩
    exact (hLpow.mem_pLowerCentralSeries_iff_exists_pow_pow hLproP hLfg j).mpr ⟨_, rfl⟩

/-- **Product-power congruence modulo `λ_{n+2}`.** In a topologically finitely generated powerful
pro-`p` group `G`, `(a * y) ^ p ≡ a ^ p * y ^ p` modulo `λ_{n+2}(G)` for all `a : G` and
`y ∈ λ_n(G)`. -/
theorem mk_mul_pow_prime_eq (hpow : IsPowerful p G) (hG : IsProP p G)
    (hfg : IsTopologicallyFinitelyGenerated G) (n : ℕ) {a y : G}
    (hy : y ∈ pLowerCentralSeries p G n) :
    (((a * y) ^ p : G) : G ⧸ pLowerCentralSeries p G (n + 2)) =
      ((a ^ p * y ^ p : G) : G ⧸ pLowerCentralSeries p G (n + 2)) := by
  let q := QuotientGroup.mk' (pLowerCentralSeries p G (n + 2))
  have : Finite (G ⧸ pLowerCentralSeries p G (n + 2)) :=
    hfg.finite_quotient_pLowerCentralSeries hp.out (n + 2)
  have : DiscreteTopology (G ⧸ pLowerCentralSeries p G (n + 2)) :=
    QuotientGroup.discreteTopology (hfg.isOpen_pLowerCentralSeries hp.out (n + 2))
  have hQbot :
      (⊤ : Subgroup (G ⧸ pLowerCentralSeries p G (n + 2))).pLowerCentralSeries p (n + 2) = ⊥ := by
    rw [← pLowerCentralSeries_eq_of_discreteTopology,
      ← q.map_pLowerCentralSeries_eq_of_surjective QuotientGroup.continuous_mk
        QuotientGroup.continuous_mk.isClosedMap (QuotientGroup.mk'_surjective _) (n + 2),
      Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
  have hQy :
      q y ∈ (⊤ : Subgroup (G ⧸ pLowerCentralSeries p G (n + 2))).pLowerCentralSeries p n := by
    rw [← pLowerCentralSeries_eq_of_discreteTopology]
    exact q.map_pLowerCentralSeries_le QuotientGroup.continuous_mk n ⟨y, hy, rfl⟩
  have hmul := (hpow.isPowerfullyEmbedded_quotient_pLowerCentralSeries hfg
    (n + 2)).mul_pow_prime_eq_of_pLowerCentralSeries_eq_bot
      (hG.isPGroup_quotient_pLowerCentralSeries hfg hp.out (n + 2)) hQbot (a := q a) hQy
  simpa only [q, QuotientGroup.mk'_apply, QuotientGroup.mk_mul, QuotientGroup.mk_pow] using hmul

end IsPowerful

end ProP

/-! ### Concrete non-powerful examples -/

section Examples

/-- In every dihedral group `DihedralGroup n`, every commutator is a square, so its commutator
subgroup lies in `closedPowerSubgroup (DihedralGroup n) 2`. Together with
`TauCeti.not_isPowerful_two_dihedralGroup`, this shows that the fourth-power condition at `p = 2`
is genuinely stronger than the square condition (already for the dihedral group of order `8`,
`n = 4`). -/
theorem commutator_dihedralGroup_le_closedPowerSubgroup_two (n : ℕ)
    [TopologicalSpace (DihedralGroup n)] [IsTopologicalGroup (DihedralGroup n)] :
    ⁅(⊤ : Subgroup (DihedralGroup n)), ⊤⁆ ≤ closedPowerSubgroup (DihedralGroup n) 2 := by
  rw [Subgroup.commutator_le]
  intro a _ b _
  cases a with
  | r i =>
    cases b with
    | r j =>
      have h : ⁅DihedralGroup.r i, DihedralGroup.r j⁆ = 1 := by
        simp [commutatorElement_def]
      rw [h]
      exact one_mem _
    | sr j =>
      have h : ⁅DihedralGroup.r i, DihedralGroup.sr j⁆ = (DihedralGroup.r i) ^ 2 := by
        simp only [commutatorElement_def, sq, DihedralGroup.inv_r, DihedralGroup.inv_sr,
          DihedralGroup.r_mul_sr, DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr,
          DihedralGroup.r_mul_r]
        congr 1
        ring
      rw [h]
      exact pow_mem_closedPowerSubgroup _ 2
  | sr i =>
    cases b with
    | r j =>
      have h : ⁅DihedralGroup.sr i, DihedralGroup.r j⁆ = (DihedralGroup.r (-j)) ^ 2 := by
        simp only [commutatorElement_def, sq, DihedralGroup.inv_r, DihedralGroup.inv_sr,
          DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr, DihedralGroup.r_mul_r]
        congr 1
        ring
      rw [h]
      exact pow_mem_closedPowerSubgroup _ 2
    | sr j =>
      have h : ⁅DihedralGroup.sr i, DihedralGroup.sr j⁆ = (DihedralGroup.r (j - i)) ^ 2 := by
        simp only [commutatorElement_def, sq, DihedralGroup.inv_sr, DihedralGroup.r_mul_sr,
          DihedralGroup.sr_mul_sr, DihedralGroup.r_mul_r]
        congr 1
        ring
      rw [h]
      exact pow_mem_closedPowerSubgroup _ 2

/-- Whenever `4 ∣ n` (in particular for the dihedral group of order `8`, `n = 4`), `DihedralGroup n`
is not powerful at `p = 2`: every `4`-th power has rotation angle divisible by `4`, while
`⁅r 1, sr 0⁆ = r 2` does not. -/
theorem not_isPowerful_two_dihedralGroup {n : ℕ} (hn : 4 ∣ n)
    [TopologicalSpace (DihedralGroup n)] [DiscreteTopology (DihedralGroup n)] :
    ¬ IsPowerful 2 (DihedralGroup n) := by
  intro hpow
  let H : Subgroup (DihedralGroup n) :=
    { carrier := {g | ∃ k : ZMod n, g = DihedralGroup.r (4 * k)}
      one_mem' := ⟨0, by rw [mul_zero, DihedralGroup.r_zero]⟩
      mul_mem' := by
        rintro _ _ ⟨k, rfl⟩ ⟨l, rfl⟩
        exact ⟨k + l, by rw [DihedralGroup.r_mul_r, mul_add]⟩
      inv_mem' := by
        rintro _ ⟨k, rfl⟩
        exact ⟨-k, by rw [DihedralGroup.inv_r, mul_neg]⟩ }
  have hpow4 : closedPowerSubgroup (DihedralGroup n) 4 ≤ H := by
    refine (closedPowerSubgroup_le_iff (isClosed_discrete _)).mpr fun g ↦ ?_
    cases g with
    | r i => exact ⟨i, by rw [DihedralGroup.r_pow, Nat.cast_ofNat, mul_comm]⟩
    | sr i =>
      refine ⟨0, ?_⟩
      have hsr2 : (DihedralGroup.sr i) ^ 2 = 1 := by rw [sq, DihedralGroup.sr_mul_self]
      have hsr4 : (DihedralGroup.sr i) ^ 4 = ((DihedralGroup.sr i) ^ 2) ^ 2 := by rw [← pow_mul]
      rw [hsr4, hsr2, one_pow, mul_zero, DihedralGroup.r_zero]
  have hcomm : ⁅DihedralGroup.r (1 : ZMod n), DihedralGroup.sr 0⁆ ∈ H :=
    hpow4 (by simpa using hpow.commutator_le (commutator_mem_commutator (mem_top _) (mem_top _)))
  obtain ⟨k, hk⟩ := hcomm
  have hval :
      ⁅DihedralGroup.r (1 : ZMod n), DihedralGroup.sr (0 : ZMod n)⁆ = DihedralGroup.r 2 := by
    simp only [commutatorElement_def, DihedralGroup.inv_r, DihedralGroup.inv_sr,
      DihedralGroup.r_mul_sr, DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr]
    congr 1
    ring
  rw [hval] at hk
  have hmod : (2 : ZMod 4) = 0 := by
    have hcast := congrArg (ZMod.castHom hn (ZMod 4)) (DihedralGroup.r.inj hk)
    simpa only [map_ofNat, map_mul, show (4 : ZMod 4) = 0 from rfl, zero_mul] using hcast
  exact (by decide : (2 : ZMod 4) ≠ 0) hmod

/-- For every odd prime `p`, the Heisenberg group over `ZMod p` has exponent `p` and nontrivial
commutator subgroup, so it is not powerful at `p`. -/
theorem not_isPowerful_heisenbergGroup_zmod {p : ℕ} [hp : Fact p.Prime] (hp2 : p ≠ 2)
    [TopologicalSpace (HeisenbergGroup (ZMod p))] [DiscreteTopology (HeisenbergGroup (ZMod p))] :
    ¬ IsPowerful p (HeisenbergGroup (ZMod p)) := by
  intro hpow
  have hchoose : p ∣ p.choose 2 :=
    hp.out.dvd_choose_self (by decide) (hp.out.two_le.lt_of_ne' hp2)
  have hpowp : closedPowerSubgroup (HeisenbergGroup (ZMod p)) p = ⊥ := by
    refine le_bot_iff.mp ((closedPowerSubgroup_le_iff (isClosed_discrete _)).mpr fun a ↦ ?_)
    rw [mem_bot, HeisenbergGroup.pow_eq]
    have hch0 : ((p.choose 2 : ℕ) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ _).mpr hchoose
    ext <;> simp [nsmul_eq_mul, hch0]
  have hcomm : ⁅(⟨1, 0, 0⟩ : HeisenbergGroup (ZMod p)), ⟨0, 1, 0⟩⁆ ∈
      closedPowerSubgroup (HeisenbergGroup (ZMod p)) p :=
    hpow.commutator_le_closedPowerSubgroup_prime
      (commutator_mem_commutator (mem_top _) (mem_top _))
  rw [hpowp, mem_bot, HeisenbergGroup.commutatorElement_eq] at hcomm
  have h10 : (1 : ZMod p) = 0 := by
    simpa using congrArg HeisenbergGroup.z hcomm
  exact one_ne_zero h10

end Examples

end TauCeti
