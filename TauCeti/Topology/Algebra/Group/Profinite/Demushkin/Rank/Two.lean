module

public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Basic
public import TauCeti.Topology.Algebra.Group.Profinite.ProP.Procyclic
import TauCeti.GroupTheory.SemidirectProduct

/-!
# A split procyclic extension in the rank-two Demushkin presentation

For the pro-`p` presentation `G = ⟨x, t ∣ x^q (x,t)⟩`, with `p ∣ q`, the projection
`x ↦ 0`, `t ↦ 1` onto `ℤ_p` has a continuous homomorphic section given by the `p`-adic
powers of `t`. Its kernel is the closed procyclic subgroup generated by `x`. Thus every
element has a unique expression `n * t^b` with `n` in that subgroup and `b ∈ ℤ_p`.

The relation says `t⁻¹ * x * t = x^(1-q)`. Since `1-q` is a `p`-adic unit, conjugation
preserves the closed subgroup generated by `x`, giving the normality needed for the
decomposition. The result includes the abelian case `q = 0` and the dyadic case `q = 2`.
It does not assert that the procyclic kernel is infinite.

The presentation and its generators are the existing `TauCeti.presentedProP` and
`TauCeti.demushkinWordNeTwo`. The splitting uses `TauCeti.IsProP.padicPowHom`.

## References

* J. P. Labute, *Classification of Demushkin groups*, Canad. J. Math. 19 (1967),
  Theorem 3, the rank-two presentation.
-/

public section

namespace TauCeti

open Multiplicative

namespace DemushkinRankTwo

variable (p q : ℕ) [Fact p.Prime]

-- These local notations abbreviate the existing presentation and its two marked generators.
local notation "G" => presentedProP p (Fin 2) {demushkinWordNeTwo q 2 (freeProPGen p 2)}
local notation "x" => presentedProP.of p {demushkinWordNeTwo q 2 (freeProPGen p 2)} (0 : Fin 2)
local notation "t" => presentedProP.of p {demushkinWordNeTwo q 2 (freeProPGen p 2)} (1 : Fin 2)

/-- The continuous projection onto the second generator of the rank-two presentation. -/
noncomputable def projection : G →ₜ* Multiplicative ℤ_[p] :=
  presentedProP.lift
    (freeProP.lift (isProP_multiplicative_padicInt p) ![1, ofAdd 1]) (by
      intro r hr
      rcases Set.mem_singleton_iff.mp hr with rfl
      simp [demushkinWordNeTwo_def, freeProPGen_of_lt, labuteComm_def])

/-- The projection kills the first marked generator. -/
@[simp]
theorem projection_of_zero : projection p q x = 1 := by
  simp [projection]

/-- The projection sends the second marked generator to `1 ∈ ℤ_p`. -/
@[simp]
theorem projection_of_one : projection p q t = ofAdd 1 := by
  simp [projection]

/-- The section of the projection, given by `p`-adic powers of the second marked generator. -/
noncomputable def sectionHom : Multiplicative ℤ_[p] →ₜ* G :=
  (presentedProP.isProP p _ _).padicPowHom t

/-- The section is the `p`-adic power map of the second marked generator. -/
theorem sectionHom_apply (b : Multiplicative ℤ_[p]) :
    sectionHom p q b = (presentedProP.isProP p _ _).padicPow t b.toAdd := by
  rw [sectionHom, IsProP.padicPowHom_apply]

/-- The section takes `1 ∈ ℤ_p` to the second marked generator. -/
@[simp]
theorem sectionHom_ofAdd_one : sectionHom p q (ofAdd 1) = t := by
  simp [sectionHom]

/-- The section followed by the projection is the identity on `ℤ_p`. -/
@[simp]
theorem projection_comp_sectionHom :
    (projection p q).comp (sectionHom p q) = ContinuousMonoidHom.id _ :=
  continuousMonoidHom_ext_multiplicative_padicInt (by simp)

/-- The projection recovers the exponent of a section value. -/
@[simp]
theorem projection_sectionHom (b : Multiplicative ℤ_[p]) :
    projection p q (sectionHom p q b) = b :=
  DFunLike.congr_fun (projection_comp_sectionHom p q) b

/-- The section is injective. -/
theorem sectionHom_injective : Function.Injective (sectionHom p q) :=
  Function.LeftInverse.injective (projection_sectionHom p q)

omit [Fact p.Prime] in
/-- The two marked generators topologically generate the rank-two presentation. -/
private theorem generators :
    (Subgroup.closure ({x, t} : Set G)).topologicalClosure = ⊤ := by
  have hrange : Set.range
      (presentedProP.of p {demushkinWordNeTwo q 2 (freeProPGen p 2)}) = {x, t} := by
    rw [Fin.range_fin_succ, Set.range_unique]
    rfl
  rw [← hrange]
  exact presentedProP.topologicalClosure_closure_range_of_eq_top

/-- The defining relation, expressed as conjugation of the first marked generator. -/
theorem inv_of_one_mul_of_zero_mul_of_one :
    t⁻¹ * x * t = (presentedProP.isProP p _ _).padicPow x (1 - (q : ℤ_[p])) := by
  have hr : x ^ q * labuteComm x t = 1 := by
    simpa [demushkinWordNeTwo_def, presentedProPGen_of_lt] using
      demushkinWordNeTwo_presentedProPGen_eq_one p q 2
  rw [sub_eq_add_neg, IsProP.padicPow_add, IsProP.padicPow_one,
    IsProP.padicPow_neg, IsProP.padicPow_natCast]
  have h := congrArg (fun z : G ↦ (x * (x ^ q)⁻¹) * z) hr
  simp only [labuteComm_def] at h
  group at h ⊢
  exact h

/-- The closed procyclic subgroup of the first generator is normal when `p ∣ q`. -/
theorem normal_closedZpowers_of_zero (hq : p ∣ q) : (closedZpowers x).Normal := by
  have hu : IsUnit (1 - (q : ℤ_[p])) := by
    apply IsLocalRing.isUnit_one_sub_self_of_mem_nonunits
    rw [PadicInt.mem_nonunits]
    apply (PadicInt.norm_lt_one_iff_dvd _).2
    obtain ⟨k, rfl⟩ := hq
    exact ⟨(k : ℤ_[p]), by push_cast; rfl⟩
  obtain ⟨u, hu⟩ := hu
  have ht : t⁻¹ ∈ Subgroup.normalizer (closedZpowers x : Set G) := by
    apply (presentedProP.isProP p _ _).mem_normalizer_closedZpowers_of_conj_eq_padicPow u
    simpa only [inv_inv, hu] using inv_of_one_mul_of_zero_mul_of_one p q
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_le_iff.mp
  rw [← generators p q]
  refine Subgroup.topologicalClosure_minimal _ ((Subgroup.closure_le _).2 ?_)
    (Subgroup.isClosed_normalizer (isClosed_closedZpowers x))
  exact Set.pair_subset_iff.mpr
    ⟨Subgroup.le_normalizer (mem_closedZpowers x), by simpa using
      (Subgroup.normalizer (closedZpowers x : Set G)).inv_mem ht⟩

/-- Every element is a product of an element of the first closed procyclic subgroup and
a section value. -/
theorem exists_mul_sectionHom (hq : p ∣ q) (g : G) :
    ∃ n : closedZpowers x, ∃ b : Multiplicative ℤ_[p], g = n * sectionHom p q b := by
  have := normal_closedZpowers_of_zero p q hq
  have hnorm : closedZpowers t ≤ Subgroup.normalizer (closedZpowers x : Set G) := by
    rw [Subgroup.normalizer_eq_top]
    exact le_top
  have hsup : closedZpowers x ⊔ closedZpowers t = ⊤ := by
    apply top_le_iff.mp
    rw [← generators p q]
    apply Subgroup.topologicalClosure_minimal
    · exact (Subgroup.closure_le _).2 (Set.pair_subset_iff.mpr
        ⟨Subgroup.mem_sup_left (mem_closedZpowers x),
          Subgroup.mem_sup_right (mem_closedZpowers t)⟩)
    · rw [sup_comm]
      exact (Subgroup.isCompact_sup_of_le_normalizer
        (isClosed_closedZpowers t).isCompact (isClosed_closedZpowers x).isCompact hnorm).isClosed
  have hg : g ∈ closedZpowers x ⊔ closedZpowers t := hsup ▸ Subgroup.mem_top g
  obtain ⟨n, hn, y, hy, h⟩ :=
    (TauCeti.Subgroup.mem_sup_of_right_le_normalizer_left hnorm).mp hg
  obtain ⟨b, rfl⟩ := (presentedProP.isProP p _ _).mem_topologicalClosure_closure_singleton_iff.mp
    (by simpa only [closedZpowers_def, Subgroup.zpowers_eq_closure] using hy)
  refine ⟨⟨n, hn⟩, ofAdd b, ?_⟩
  simpa only [sectionHom, IsProP.padicPowHom_apply, toAdd_ofAdd] using h

/-- The kernel of the projection is exactly the closed subgroup generated by the first
marked generator. -/
@[simp]
theorem ker_projection (hq : p ∣ q) :
    (projection p q : G →* Multiplicative ℤ_[p]).ker = closedZpowers x := by
  have hle : closedZpowers x ≤ (projection p q).toMonoidHom.ker :=
    (closedZpowers_le (projection p q).isClosed_ker).2 (projection_of_zero p q)
  apply le_antisymm _ hle
  intro g hg
  obtain ⟨n, b, rfl⟩ := exists_mul_sectionHom p q hq g
  have hn : projection p q n = 1 := hle n.2
  have hb : b = 1 := by simpa [hn] using hg
  simp [hb]

/-- The procyclic-kernel decomposition is unique, including the kernel element and exponent. -/
theorem mul_sectionHom_injective :
    Function.Injective (fun z : closedZpowers x × Multiplicative ℤ_[p] ↦
      (z.1 : G) * sectionHom p q z.2) := by
  have hn (n : closedZpowers x) : projection p q n = 1 :=
    ((closedZpowers_le (projection p q).isClosed_ker).2 (projection_of_zero p q)) n.2
  rintro ⟨n, b⟩ ⟨n', b'⟩ h
  have hb : b = b' := by
    simpa only [map_mul, hn, projection_sectionHom, one_mul] using
      congrArg (projection p q) h
  subst b'
  exact Prod.ext (Subtype.ext (mul_right_cancel h)) rfl

/-- Multiplication gives topological coordinates consisting of a kernel element and a
`p`-adic exponent of the second marked generator. -/
noncomputable def decomposition (hq : p ∣ q) :
    closedZpowers x × Multiplicative ℤ_[p] ≃ₜ G :=
  ((continuous_subtype_val.comp continuous_fst).mul
    ((sectionHom p q).continuous.comp continuous_snd)).homeoOfEquivCompactToT2
      (f := Equiv.ofBijective _ ⟨mul_sectionHom_injective p q, fun g ↦ by
        obtain ⟨n, b, h⟩ := exists_mul_sectionHom p q hq g
        exact ⟨(n, b), h.symm⟩⟩)

/-- The decomposition sends `(n, b)` to `n * t^b`. -/
@[simp]
theorem decomposition_apply (hq : p ∣ q) (n : closedZpowers x) (b : Multiplicative ℤ_[p]) :
    decomposition p q hq (n, b) = n * sectionHom p q b :=
  (rfl)

/-- The second coordinate of an element is its image under the projection. -/
@[simp]
theorem decomposition_symm_snd (hq : p ∣ q) (g : G) :
    ((decomposition p q hq).symm g).2 = projection p q g := by
  obtain ⟨⟨n, b⟩, rfl⟩ := (decomposition p q hq).surjective g
  have hn : projection p q n = 1 :=
    ((closedZpowers_le (projection p q).isClosed_ker).2 (projection_of_zero p q)) n.2
  rw [Homeomorph.symm_apply_apply, decomposition_apply, map_mul, hn,
    projection_sectionHom, one_mul]

/-- The first coordinate is obtained by removing the section value of the projection. -/
@[simp]
theorem coe_decomposition_symm_fst (hq : p ∣ q) (g : G) :
    (((decomposition p q hq).symm g).1 : G) = g * (sectionHom p q (projection p q g))⁻¹ := by
  obtain ⟨⟨n, b⟩, rfl⟩ := (decomposition p q hq).surjective g
  have hn : projection p q n = 1 :=
    ((closedZpowers_le (projection p q).isClosed_ker).2 (projection_of_zero p q)) n.2
  rw [Homeomorph.symm_apply_apply, decomposition_apply, map_mul, hn,
    projection_sectionHom, one_mul, mul_inv_cancel_right]

end DemushkinRankTwo

end TauCeti
