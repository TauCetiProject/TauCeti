module

public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.LabuteModule.Basic

/-!
# Labute's module at the finite dyadic endpoint

Let `F` be the free pro-`2` group on `x₁, …, x_n`, and read on `F` the standard orientation of
the endpoint relator `x₁² (x₁, x₂) (x₃, x₄) ⋯ (x_{n-1}, x_n)`. The Demushkin (even-rank) case is
that of even `n`, but the results here hold for every `1 < n`, so no parity hypothesis is imposed.
The orientation is the `q = 2` instance of `TauCeti.orientationNeTwo`: it takes `x₂` to `-1`
and kills every other generator, so its image is the finite group `{±1}`. Unlike the
infinite-image normal forms, its kernel `X` is not an exponent sum kernel.

This file identifies `X` as the closed normal closure of `x₂²` and the generators other than
`x₂` (`TauCeti.ker_orientationNeTwo_two_comp_mk`). Consequently Labute's module
`E = X ⧸ (X, X)` is spanned over `Λ = ℤ_2[[F ⧸ X]]` by the classes of those elements
(`TauCeti.span_topologicalAbelianization_ker_orientationNeTwo_two_comp_mk_eq_top`). This supplies
the finite-image endpoint analogue of the kernel and spanning results in
`TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.LabuteModule.Basic` and is the
relation-module input for the `f = ∞` endpoint of Labute's even-rank classification.

## Main results

* `TauCeti.ker_orientationNeTwo_two_comp_mk`: the kernel of the endpoint orientation on `F` is
  normally generated, topologically, by `x₂²` and the generators other than `x₂`.
* `TauCeti.span_topologicalAbelianization_ker_orientationNeTwo_two_comp_mk_eq_top`: their classes
  span Labute's module `E` over the completed group algebra.

## References

* J. P. Labute, *Classification of Demushkin groups*, Canad. J. Math. 19 (1967), §4,
  pp. 121–122, and Theorem 6.
-/

public section

namespace TauCeti

variable (n : ℕ)

/-- **The kernel of the orientation at the finite dyadic endpoint.** For `1 < n`, the
kernel on `F = freeProP 2 (Fin n)` of the character with `χ(x₂) = -1` and `χ(x_i) = 1` for
`i ≠ 2` is the closed normal closure of `x₂²` and the other generators. The statement needs no
parity condition on `n`; for even `n` it is Labute's `X = ker χ` for the even-rank endpoint
`Im χ = {±1}`. -/
theorem ker_orientationNeTwo_two_comp_mk (hn : 1 < n) :
    ((orientationNeTwo 2 n (-1) (by simp)).comp (presentedProP.mk 2 _)).toMonoidHom.ker =
      (Subgroup.normalClosure (insert (freeProPGen 2 n 1 ^ 2)
        (freeProPGen 2 n '' {i | i ≠ 1}))).topologicalClosure := by
  refine freeProP.ker_eq_topologicalClosure_normalClosure_insert_pow_image_freeProPGen _
    ((orientationNeTwo 2 n (-1) (by simp)).comp (presentedProP.mk 2 _)).isClosed_ker
    (fun i hi ↦ orientationNeTwo_comp_mk_freeProPGen_of_ne 2 n (-1) _ hi) two_pos ?_
  simp [orientationNeTwo_comp_mk_freeProPGen_one 2 n (-1) _ hn, ← orderOf_units]

/-- **Labute's module at the finite dyadic endpoint is generated by the classes of `x₂²` and
the generators other than `x₂`.** For `1 < n`, let `X` be the kernel on `F = freeProP 2 (Fin n)`
of the character with `χ(x₂) = -1` and `χ(x_i) = 1` for `i ≠ 2`. Then `E = X^{ab}` is spanned
over `Λ = ℤ_2[[F ⧸ X]]`, through conjugation, by the classes of `x₂²` and the `x_i`, `i ≠ 2`
(Labute, §4, p. 121). No parity condition on `n` is needed; the even-rank endpoint is the case of
even `n`. -/
theorem span_topologicalAbelianization_ker_orientationNeTwo_two_comp_mk_eq_top (hn : 1 < n) :
    haveI := ((orientationNeTwo 2 n (-1) (by simp)).comp (presentedProP.mk 2 _)).isClosed_ker
    letI := ((isProP_freeProP 2 (Fin n)).topologicalAbelianization
      ((orientationNeTwo 2 n (-1) (by simp)).comp (presentedProP.mk 2 _)).toMonoidHom.ker
      ).completedGroupAlgebraModule (freeProP 2 (Fin n) ⧸
        ((orientationNeTwo 2 n (-1) (by simp)).comp (presentedProP.mk 2 _)).toMonoidHom.ker)
    Submodule.span (completedGroupAlgebra ℤ_[2] (freeProP 2 (Fin n) ⧸
        ((orientationNeTwo 2 n (-1) (by simp)).comp (presentedProP.mk 2 _)).toMonoidHom.ker))
      (Additive.ofMul '' ((QuotientGroup.mk :
        ((orientationNeTwo 2 n (-1) (by simp)).comp (presentedProP.mk 2 _)).toMonoidHom.ker →
          TopologicalAbelianization
            ((orientationNeTwo 2 n (-1) (by simp)).comp (presentedProP.mk 2 _)).toMonoidHom.ker) ''
        (Subtype.val ⁻¹' (insert (freeProPGen 2 n 1 ^ 2)
          (freeProPGen 2 n '' {i | i ≠ 1}))))) = ⊤ :=
  (isProP_freeProP 2 (Fin n)).span_completedGroupAlgebraModule_topologicalAbelianization_eq_top _
    (((finite_range_freeProPGen 2 n).subset (Set.image_subset_range _ _)).insert _)
    (ker_orientationNeTwo_two_comp_mk n hn).symm

end TauCeti
