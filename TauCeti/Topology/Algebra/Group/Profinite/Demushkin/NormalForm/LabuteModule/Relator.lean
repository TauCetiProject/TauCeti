module

public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.Labute.RelationModule
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.Labute.RelatorCharacter
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Character
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Two.Even.Image
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Two.Even.Twisted
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Two.Even.UnitsPlusMinus
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.LabuteModule.NonprocyclicFactorization

/-!
# The class of a Demushkin relator in Labute's module

Let `F` be the free pro-`p` group on a set `X` and `r ∈ F` a relator presenting a Demushkin group
`G = F ⧸ (r)`. The canonical character of `G` read on `F` is a continuous character
`χ : F → ℤ_pˣ` (`TauCeti.demushkinRelatorCharacter`, in
`TauCeti.Topology.Algebra.Group.Profinite.Demushkin.Labute.RelatorCharacter`), the character
Labute attaches to `r` (Labute, §4 Definition, p. 121). Its kernel contains `r`
(`TauCeti.demushkinRelatorCharacter_mem_ker`), so `r` has a class `cl(r)` in Labute's module
`E = ker χ ⧸ (ker χ, ker χ)` (`TauCeti.labuteRelatorClass`), a module over
`Λ = ℤ_p[[F ⧸ ker χ]]`.

At `p = 2`, for `F` of even rank `n`, `r ∈ Φ(F)` and an image of `χ` with a finite level
`2 ≤ f`, Labute's Theorems 5 and 6 rest on a factorization of `cl(r)` in `E`:

* when the image of `χ` is the twisted subgroup `U^[f]`, the closed subgroup generated by
  `-1 + 2^f`, then `cl(r) = ((1 + 2^f) + [y]) • z` for some `z ∈ E`, for every `y ∈ F` with
  `χ(y) = -(1 + 2^f)`
  (`TauCeti.exists_labuteRelatorClass_eq_smul_of_range_eq_procyclicClosure`);
* when the image of `χ` is `{±1} × U^(f)`, then `cl(r) = (1 + [s]) • z₁ + (2^f - 1 + [y]) • z₃` for
  some `z₁, z₃ ∈ E`, for every `s, y ∈ F` with `χ(s) = -1` and `χ(y) = 1 - 2^f`
  (`TauCeti.exists_labuteRelatorClass_eq_add_smul_of_range_eq_unitsPlusMinus`).

Both are read off from the normal forms. By Labute's normal-form theorems a continuous
automorphism `e` of `F` carries `r` to the normal-form word, so `r` is that word read on the basis
`e⁻¹(x_i)`, and the character table of the normal form gives the values of `χ` on that basis. In
the twisted branch the normal form is `x₁^{2 + 2^f} (x₁, x₂)(x₃, x₄) ⋯ (x_{n-1}, x_n)`, whose
class `((1 + 2^f) + [x₂]⁻¹) • [x₁]` (`TauCeti.IsProP.ofMul_mk_demushkinWordNeTwo_ker`) already has
the required shape, since `[x₂]⁻¹ = [y]` in `F ⧸ ker χ`. In the branch `{±1} × U^(f)` the normal
form is `x₁² (x₁, x₂) x₃^{2^f} (x₃, x₄) ⋯ (x_{n-1}, x_n)`, and the factorization of its class is
`TauCeti.IsProP.exists_ofMul_mk_demushkinWordTwoEven_ker_eq_add_smul`.

**Conventions.** `Λ` acts on `E` by conjugation, `[g] • [x] = [g x g⁻¹]`
(`TauCeti.IsProP.completedGroupAlgebraModule`). Labute lets `[g]` act by `[g⁻¹ x g]`, so his
multipliers `2 + 2^f + T` and `2^f + T`, where `1 + T` is the class of an element of character
`-(1 + 2^f)⁻¹`, respectively `(1 - 2^f)⁻¹`, read `(1 + 2^f) + [y]` and `2^f - 1 + [y]` here.

## Main results

* `TauCeti.exists_labuteRelatorClass_eq_smul_of_range_eq_procyclicClosure`: the factorization of
  the relator class in the twisted branch (Labute, §4.1, p. 123).
* `TauCeti.exists_labuteRelatorClass_eq_add_smul_of_range_eq_unitsPlusMinus`: the factorization
  of the relator class in the branch `{±1} × U^(f)` (Labute, §4.2, p. 127).

## References

* J. P. Labute, *Classification of Demushkin groups*, Canad. J. Math. 19 (1967), 106–132, §4,
  Definition p. 121, the computations on pp. 122–123 and 127, and Theorems 5 and 6.
-/

public section

namespace TauCeti

/-! ### The relator class in the two finite-level branches of even rank at `p = 2` -/

section Factorization

variable {n : ℕ} {r : freeProP 2 (Fin n)}

/-- **The relator class in the twisted branch** (Labute, §4.1, p. 123). Let `r ∈ Φ(F)` be a
relator of the free pro-`2` group `F` on an even number `n` of generators presenting a Demushkin
group whose character `χ` has image the twisted subgroup `U^[f]`, the closed subgroup generated
by `u = -1 + 2^f`, for a finite `f ≥ 2`. For every `y ∈ F` with `χ(y) = -(1 + 2^f)`, the class
of `r` in Labute's module `E = ker χ ⧸ (ker χ, ker χ)` is `((1 + 2^f) + [y]) • z` for some
`z ∈ E`, over `ℤ_2[[F ⧸ ker χ]]` acting by conjugation. -/
theorem exists_labuteRelatorClass_eq_smul_of_range_eq_procyclicClosure
    (hr : IsDemushkin 2 (presentedProP 2 (Fin n) {r})) (hn : Even n)
    (hrΦ : r ∈ proPFrattini 2 (freeProP 2 (Fin n))) {f : ℕ} (hf : 2 ≤ f) {u : ℤ_[2]ˣ}
    (hu : (u : ℤ_[2]) = -1 + 2 ^ f)
    (hrange : (demushkinRelatorCharacter hr).toMonoidHom.range =
      (Subgroup.zpowers u).topologicalClosure)
    {y : freeProP 2 (Fin n)} (hy : (demushkinRelatorCharacter hr y : ℤ_[2]) = -(1 + 2 ^ f)) :
    let χ := demushkinRelatorCharacter hr
    haveI := χ.isClosed_ker
    letI := ((isProP_freeProP 2 (Fin n)).topologicalAbelianization
      χ.toMonoidHom.ker).completedGroupAlgebraModule (freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)
    ∃ z : labuteE χ,
      labuteRelatorClass χ r (demushkinRelatorCharacter_mem_ker hr) =
        (algebraMap ℤ_[2] (completedGroupAlgebra ℤ_[2] (freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker))
            (1 + 2 ^ f) +
          completedGroupAlgebra.of ℤ_[2] (freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)
            (y : freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)) • z := by
  intro χ
  have := χ.isClosed_ker
  let _ := ((isProP_freeProP 2 (Fin n)).topologicalAbelianization
    χ.toMonoidHom.ker).completedGroupAlgebraModule (freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)
  have hn1 : 1 < n := by
    have := hr.card_pos_presentedProP
    obtain ⟨k, hk⟩ := hn
    simp only [Nat.card_eq_fintype_card, Fintype.card_fin] at this
    omega
  have hq : 2 ∣ 2 + 2 ^ f := dvd_add dvd_rfl (dvd_pow_self 2 (by omega))
  -- Labute's Theorem 5: an automorphism `e` of `F` carries `r` to the normal-form word, so `r` is
  -- that word read on the basis `x = e⁻¹ ∘ freeProPGen`.
  obtain ⟨e, he⟩ := freeProP.exists_continuousMulEquiv_apply_eq_demushkinWordNeTwo_of_range_eq
    hrΦ hr hn hf hu (by rwa [← range_demushkinRelatorCharacter])
  set x : ℕ → freeProP 2 (Fin n) := e.symm ∘ freeProPGen 2 n with hx_def
  have hrx : r = demushkinWordNeTwo (2 + 2 ^ f) n x := by
    rw [hx_def, ← map_demushkinWordNeTwo e.symm, ← he, ContinuousMulEquiv.symm_apply_apply]
  -- The character table of the normal form gives the values of `χ` on `x`.
  obtain ⟨h₁, hx⟩ := demushkinCharacter_apply_equiv_symm_of_equiv_demushkinWordNeTwo hr hq hn hn1
    (presentedProP.congrSingleton e he)
  simp only [← presentedProP.mk_freeProPGen, ← demushkinRelatorCharacter_apply_equiv_symm,
    ← Function.comp_apply (f := e.symm), ← hx_def] at h₁ hx
  have hclass := (isProP_freeProP 2 (Fin n)).ofMul_mk_demushkinWordNeTwo_ker χ (2 + 2 ^ f) hn1
    (x := x) (fun i hi _ ↦ hx i hi)
  -- `[x₂]⁻¹ = [y]` in `F ⧸ ker χ`, since both have character value `-(1 + 2^f)`.
  have hinv : (x 1 : freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)⁻¹ = y := by
    rw [← QuotientGroup.mk_inv, QuotientGroup.eq, inv_inv, MonoidHom.mem_ker, Units.ext_iff]
    have hy' : (χ y : ℤ_[2]) = -(1 + 2 ^ f) := hy
    simp only [ContinuousMonoidHom.coe_toMonoidHom, MonoidHom.coe_ofClass, map_mul,
      Units.val_mul, Units.val_one, hy']
    push_cast at h₁
    linear_combination h₁
  have h : labuteRelatorClass χ r (demushkinRelatorCharacter_mem_ker hr) =
      Additive.ofMul ((⟨demushkinWordNeTwo (2 + 2 ^ f) n x,
        hrx ▸ demushkinRelatorCharacter_mem_ker hr⟩ : χ.toMonoidHom.ker) :
          TopologicalAbelianization χ.toMonoidHom.ker) := by
    rw [labuteRelatorClass_def]
    congr
  refine ⟨Additive.ofMul ((⟨x 0, MonoidHom.mem_ker.mpr (hx 0 zero_ne_one)⟩ : χ.toMonoidHom.ker) :
    TopologicalAbelianization χ.toMonoidHom.ker), (h.trans hclass).trans ?_⟩
  rw [hinv]
  push_cast
  norm_num [add_sub_right_comm, map_ofNat]

/-- **The relator class in the branch `{±1} × U^(f)`** (Labute, §4.2, p. 127). Let `r ∈ Φ(F)` be
a relator of the free pro-`2` group `F` on an even number `n` of generators presenting a
Demushkin group whose character `χ` has image `{±1} × U^(f)` for a finite `f ≥ 2`. For every
`s, y ∈ F` with `χ(s) = -1` and `χ(y) = 1 - 2^f`, the class of `r` in Labute's module
`E = ker χ ⧸ (ker χ, ker χ)` is `(1 + [s]) • z₁ + (2^f - 1 + [y]) • z₃` for some `z₁, z₃ ∈ E`,
over `ℤ_2[[F ⧸ ker χ]]` acting by conjugation. -/
theorem exists_labuteRelatorClass_eq_add_smul_of_range_eq_unitsPlusMinus
    (hr : IsDemushkin 2 (presentedProP 2 (Fin n) {r})) (hn : Even n)
    (hrΦ : r ∈ proPFrattini 2 (freeProP 2 (Fin n))) {f : ℕ} (hf : 2 ≤ f)
    (hrange : (demushkinRelatorCharacter hr).toMonoidHom.range = unitsPlusMinus f)
    {s y : freeProP 2 (Fin n)} (hs : demushkinRelatorCharacter hr s = -1)
    (hy : (demushkinRelatorCharacter hr y : ℤ_[2]) = 1 - 2 ^ f) :
    let χ := demushkinRelatorCharacter hr
    haveI := χ.isClosed_ker
    letI := ((isProP_freeProP 2 (Fin n)).topologicalAbelianization
      χ.toMonoidHom.ker).completedGroupAlgebraModule (freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)
    ∃ z₁ z₃ : labuteE χ,
      labuteRelatorClass χ r (demushkinRelatorCharacter_mem_ker hr) =
        (1 + completedGroupAlgebra.of ℤ_[2] (freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)
            (s : freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)) • z₁ +
          ((2 : completedGroupAlgebra ℤ_[2] (freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)) ^ f - 1 +
            completedGroupAlgebra.of ℤ_[2] (freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)
              (y : freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)) • z₃ := by
  intro χ
  have := χ.isClosed_ker
  let _ := ((isProP_freeProP 2 (Fin n)).topologicalAbelianization
    χ.toMonoidHom.ker).completedGroupAlgebraModule (freeProP 2 (Fin n) ⧸ χ.toMonoidHom.ker)
  have hA : (demushkinCharacter hr).toMonoidHom.range = unitsPlusMinus f := by
    rwa [← range_demushkinRelatorCharacter]
  -- The rank `n` of the presented group is at least `4`: rank two has procyclic image.
  have hn3 : 3 < n := by
    have hrank := demushkinRank_presentedProP (Set.singleton_subset_iff.mpr hrΦ) hr
    have hpos := hr.card_pos_presentedProP
    simp only [Nat.card_eq_fintype_card, Fintype.card_fin] at hrank hpos
    by_contra h
    obtain ⟨k, hk⟩ := hn
    exact hr.range_demushkinCharacter_ne_unitsPlusMinus_of_demushkinRank_eq_two (by omega) hf hA
  -- Labute's Theorem 6: an automorphism `e` of `F` carries `r` to the normal-form word, so `r` is
  -- that word read on the basis `x = e⁻¹ ∘ freeProPGen`.
  obtain ⟨e, he⟩ :=
    freeProP.exists_continuousMulEquiv_apply_eq_demushkinWordTwoEven_of_range_eq hrΦ hr hn hn3 hf hA
  set x : ℕ → freeProP 2 (Fin n) := e.symm ∘ freeProPGen 2 n with hx_def
  have hrx : r = demushkinWordTwoEven 0 f n x := by
    rw [hx_def, ← map_demushkinWordTwoEven e.symm, ← he, ContinuousMulEquiv.symm_apply_apply]
  -- The character table of the normal form gives the values of `χ` on `x`.
  obtain ⟨h₁, h₃, hx⟩ := demushkinCharacter_apply_equiv_symm_of_equiv_demushkinWordTwoEven hr
    (dvd_zero 2) (by omega) hn hn3 (presentedProP.congrSingleton e he)
  simp only [← presentedProP.mk_freeProPGen, ← demushkinRelatorCharacter_apply_equiv_symm,
    ← Function.comp_apply (f := e.symm), ← hx_def] at h₁ h₃ hx
  obtain ⟨z₁, z₃, hz⟩ :=
    (isProP_freeProP 2 (Fin n)).exists_ofMul_mk_demushkinWordTwoEven_ker_eq_add_smul χ 0 f hn3 hf
      (x := x) (fun i hi hi' _ ↦ hx i hi hi') h₁ h₃ (by simp) hs hy
  refine ⟨z₁, z₃, Eq.trans ?_ hz⟩
  rw [labuteRelatorClass_def]
  congr

end Factorization

end TauCeti
