module

public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Existence
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Two.Even.Exact
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Two.Even.PadicExponent.Character

/-!
# The orientation image of a Demushkin group of even rank

Labute's existence theorem (Theorem 1 with Remark 2, after Serre) says that a pair `(n, A)`, with
`n` even and `A ≤ ℤ_pˣ` a closed pro-`p` subgroup, is the pair of invariants `(rank, Im χ)` of a
Demushkin group exactly when `(A : A^p) < p ^ n` as supernatural numbers. The realization half is
proved in `TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Existence` for every `p`,
and the necessity half there only for the Demushkin groups with `q ≠ 2`, where `(A : A^p) ≤ p`.
This file proves the necessity half for the remaining groups, those at `p = 2` with `q(G) = 2`,
and so closes the even-rank existence theorem as an equivalence.

The only content is in rank two. For `A` a closed subgroup of `ℤ_2ˣ` the index `(A : A²)` is `1`,
`2` or `4`, and the value `4` occurs exactly for the non-procyclic subgroups `{±1} × U^(f)`,
`2 ≤ f < ∞`. So `(A : A²) < 2 ^ n` can fail for an even rank `n ≥ 2` only at `n = 2` with
`A = {±1} × U^(f)`, and the theorem to prove is that **a Demushkin group of rank two has
procyclic orientation image**, which is proved at every prime. When `q(G) ≠ 2` the image lies in
`1 + pℤ_p`, and in `1 + 4ℤ_2` at `p = 2`, every closed subgroup of which is procyclic. When
`q(G) = 2` Labute's exact normal form presents `G` as `⟨x₁, x₂ ∣ x₁^{2+α} (x₁, x₂)⟩` with
`α ∈ 4ℤ_2` (`TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Two.Even.Exact`), and
the canonical character of that presented group is trivial on `x₁`, so its image is the closed
subgroup generated by `χ(x₂) = -(1 + α)⁻¹`.

## Main results

* `exists_topologicalClosure_zpowers_eq_range_demushkinCharacter_of_demushkinRank_eq_two`, in the
  namespace `TauCeti.IsDemushkin`: the orientation image of a Demushkin group of rank two is
  procyclic, at every prime; hence at `p = 2` it is not `{±1} × U^(f)`
  (`TauCeti.IsDemushkin.range_demushkinCharacter_ne_unitsPlusMinus_of_demushkinRank_eq_two`).
* `TauCeti.IsDemushkin.three_lt_demushkinRank_of_even_of_range_eq_unitsPlusMinus` and its
  one-relator form
  `TauCeti.IsDemushkin.three_lt_of_presentedProP_of_even_of_range_eq_unitsPlusMinus`: a dyadic
  Demushkin group of even rank with image `{±1} × U^(f)` has rank at least four.
* `TauCeti.IsDemushkin.profiniteIndex_subgroupOf_map_powMonoidHom_range_lt_of_even_demushkinRank`:
  **the necessity half of the existence theorem for even rank**, `(A : A^p) < p ^ n` for the
  image `A` of the canonical character of a Demushkin group of even rank `n`, at every prime.
* `TauCeti.exists_isDemushkin_range_demushkinCharacter_eq_iff_of_even`: **the existence theorem
  of the classification for even rank, as an equivalence**.

## References

* J. Labute, *Classification of Demushkin groups*, Canad. J. Math. 19 (1967), 106--132, Theorem 1
  and Remark 2, and the remark after the corollary to Theorem 4.
* J.-P. Serre, *Structure de certains pro-p-groupes (d'après Demuškin)*, Séminaire Bourbaki
  1962/63, exp. 252, Théorème 3.2.
-/

public section

namespace TauCeti

open Subgroup

universe u

variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G]

namespace IsDemushkin

section Procyclic

variable {p : ℕ} [hp : Fact p.Prime] (hG : IsDemushkin p G)
include hG

/-- **A Demushkin group of rank two has procyclic orientation image.** When `q(G) ≠ 2` the image
lies in `1 + pℤ_p`, and in `1 + 4ℤ_2` at `p = 2`, every closed subgroup of which is procyclic.
When `q(G) = 2`, so `p = 2`, the group is `⟨x₁, x₂ ∣ x₁^{2+α} (x₁, x₂)⟩` with `α ∈ 4ℤ_2`, its
canonical character is trivial on `x₁`, and the image is the closed subgroup generated by
`χ(x₂)`. -/
theorem exists_topologicalClosure_zpowers_eq_range_demushkinCharacter_of_demushkinRank_eq_two
    (hn : demushkinRank hG = 2) :
    ∃ u : ℤ_[p]ˣ, (zpowers u).topologicalClosure = (demushkinCharacter hG).toMonoidHom.range := by
  by_cases hq : demushkinQ hG = 2
  · -- `q(G) = 2` forces `p = 2`, since `p ∣ q(G)`.
    obtain rfl : p = 2 :=
      (Nat.prime_dvd_prime_iff_eq hp.out Nat.prime_two).1 (hq ▸ hG.prime_dvd_demushkinQ)
    obtain ⟨α, q, hα, -, ⟨e⟩⟩ :=
      hG.exists_continuousMulEquiv_presentedProP_padicPow_mul_labuteComm_mul_demushkinWordNeTwo
        (by rw [hn]; exact even_two) hq
    rw [hn, ← demushkinWordTwoEvenPadic_eq_padicPow_mul_labuteComm_mul (isProP_freeProP 2 (Fin 2))
      α q 2 (freeProPGen 2 2)] at e
    -- The canonical character, read on the presented group, generates its image by `χ(x₂)`.
    have hχ := (hasPrescriptionProperty_demushkinCharacter hG).comp_equiv (e := e.symm)
    exact ⟨_,
      (range_eq_topologicalClosure_zpowers_of_hasPrescriptionProperty_demushkinWordTwoEvenPadic_two
        ((Dvd.intro 2 (by norm_num)).trans hα) hχ).symm.trans
        (range_demushkinCharacter_comp_equiv hG e.symm)⟩
  · by_cases hp₂ : p = 2
    · subst hp₂
      exact exists_topologicalClosure_zpowers_eq_of_isClosed_of_le_unitsPrincipal two_pos
        (fun _ ↦ le_rfl) (isClosed_range_demushkinCharacter hG)
        ((demushkinQ_ne_two_iff_range_demushkinCharacter_le hG).1 hq rfl)
    · refine exists_topologicalClosure_zpowers_eq_of_isClosed_of_le_unitsPrincipal one_pos
        (fun h ↦ absurd h hp₂) (isClosed_range_demushkinCharacter hG) ?_
      rintro _ ⟨g, rfl⟩
      exact demushkinCharacter_apply_mem_unitsPrincipal_one hG g

end Procyclic

section Dyadic

variable (hG : IsDemushkin 2 G)
include hG

/-- **The non-procyclic family does not occur at rank two**: the orientation image of a Demushkin
group of rank two at `p = 2` is not `{±1} × U^(f)`, `f < ∞` (for `f ≤ 2` this group is all of
`ℤ_2ˣ`, which is not procyclic either). -/
theorem range_demushkinCharacter_ne_unitsPlusMinus_of_demushkinRank_eq_two
    (hn : demushkinRank hG = 2) {f : ℕ} :
    (demushkinCharacter hG).toMonoidHom.range ≠ unitsPlusMinus f := fun h ↦ by
  obtain ⟨u, hu⟩ :=
    hG.exists_topologicalClosure_zpowers_eq_range_demushkinCharacter_of_demushkinRank_eq_two hn
  exact not_exists_topologicalClosure_zpowers_eq_unitsPlusMinus ⟨u, hu.trans h⟩

/-- **A dyadic Demushkin group of even rank with image `{±1} × U^(f)` has rank at least four.**
The image `{±1} × U^(f)` is not procyclic, so it does not occur at rank two
(`TauCeti.IsDemushkin.range_demushkinCharacter_ne_unitsPlusMinus_of_demushkinRank_eq_two`). -/
theorem three_lt_demushkinRank_of_even_of_range_eq_unitsPlusMinus
    (hn : Even (demushkinRank hG)) {f : ℕ}
    (hA : (demushkinCharacter hG).toMonoidHom.range = unitsPlusMinus f) :
    3 < demushkinRank hG := by
  have hpos := hG.demushkinRank_pos
  by_contra h
  obtain ⟨k, hk⟩ := hn
  exact hG.range_demushkinCharacter_ne_unitsPlusMinus_of_demushkinRank_eq_two (by omega) hA

end Dyadic

/-- **A one-relator dyadic Demushkin group of even rank with image `{±1} × U^(f)` has at least
four generators**: the one-relator form of
`TauCeti.IsDemushkin.three_lt_demushkinRank_of_even_of_range_eq_unitsPlusMinus`. -/
theorem three_lt_of_presentedProP_of_even_of_range_eq_unitsPlusMinus {n : ℕ}
    {r : freeProP 2 (Fin n)} (hG : IsDemushkin 2 (presentedProP 2 (Fin n) {r})) (hn : Even n)
    {f : ℕ} (hA : (demushkinCharacter hG).toMonoidHom.range = unitsPlusMinus f) : 3 < n := by
  have hrank : demushkinRank hG = n := by
    simpa using demushkinRank_presentedProP
      (Set.singleton_subset_iff.2 hG.mem_proPFrattini_of_presentedProP_singleton) hG
  rw [← hrank] at hn ⊢
  exact hG.three_lt_demushkinRank_of_even_of_range_eq_unitsPlusMinus hn hA

section Necessity

variable {p : ℕ} [hp : Fact p.Prime] (hG : IsDemushkin p G)
include hG

/-- **The necessity half of the existence theorem for even rank** (Labute, Theorem 1 and Remark 2;
Serre, Theorem 3.2). For a Demushkin group `G` of even rank `n`, the image `A` of its canonical
character has `(A : A^p) < p ^ n` as supernatural numbers. For `q(G) ≠ 2` this is
`TauCeti.IsDemushkin.profiniteIndex_subgroupOf_map_powMonoidHom_range_lt_of_demushkinQ_ne_two`.
For `q(G) = 2`, so `p = 2`, the index `(A : A²)` is `1`, `2` or `4`, and it is `4` only for the
non-procyclic images `{±1} × U^(f)`, which do not occur at rank two; so `(A : A²) ≤ 2 < 2 ^ n`, or
`(A : A²) = 4 < 2 ^ n` with `n ≥ 4`. -/
theorem profiniteIndex_subgroupOf_map_powMonoidHom_range_lt_of_even_demushkinRank
    (hn : Even (demushkinRank hG)) :
    profiniteIndex (((demushkinCharacter hG).toMonoidHom.range.map (powMonoidHom p)).subgroupOf
        (demushkinCharacter hG).toMonoidHom.range) <
      Supernatural.primePower ⟨p, hp.out⟩ (demushkinRank hG) := by
  by_cases hq : demushkinQ hG = 2
  · -- `q(G) = 2` forces `p = 2`, since `p ∣ q(G)`.
    obtain rfl : p = 2 :=
      (Nat.prime_dvd_prime_iff_eq hp.out Nat.prime_two).1 (hq ▸ hG.prime_dvd_demushkinQ)
    have hA := isClosed_range_demushkinCharacter hG
    have hn₂ : 1 < demushkinRank hG := by
      obtain ⟨k, hk⟩ := hn
      have := hG.demushkinRank_pos
      omega
    rcases profiniteIndex_subgroupOf_map_powMonoidHom_two_eq_one_or_two_or_four hA with h | h | h
    · rw [h, ← Supernatural.primePower_zero]
      exact (Supernatural.primePower_lt_primePower_iff _).2 (by exact_mod_cast hG.demushkinRank_pos)
    · rw [h]
      exact (Supernatural.primePower_lt_primePower_iff _).2 (by exact_mod_cast hn₂)
    · -- `(A : A²) = 4` means `A = {±1} × U^(f)`, which is excluded at rank two, so `n ≥ 4`.
      rw [h]
      refine (Supernatural.primePower_lt_primePower_iff _).2 ?_
      obtain ⟨f, -, hA'⟩ :=
        (profiniteIndex_subgroupOf_map_powMonoidHom_two_eq_primePower_two_iff hA).1 h
      have hn₃ := hG.three_lt_demushkinRank_of_even_of_range_eq_unitsPlusMinus hn hA'
      exact_mod_cast (show 2 < demushkinRank hG by omega)
  · exact hG.profiniteIndex_subgroupOf_map_powMonoidHom_range_lt_of_demushkinQ_ne_two hq

end Necessity

end IsDemushkin

variable {p : ℕ} [hp : Fact p.Prime]

/-- **The existence theorem of the classification of Demushkin groups for even rank, as an
equivalence** (Labute, Theorem 1 and Remark 2; Serre, Theorem 3.2). Let `n` be even and let
`A ≤ ℤ_pˣ` be a closed pro-`p` subgroup. Then `(n, A)` is the pair of invariants `(rank, Im χ)` of
a Demushkin group, presented on `n` generators by one relator, exactly when `(A : A^p) < p ^ n` as
supernatural numbers. At `p = 2` the condition excludes exactly `n = 0` and the non-procyclic images
`{±1} × U^(f)` in rank two; at an odd prime it excludes exactly `n = 0`. Together with
`TauCeti.exists_isDemushkin_range_demushkinCharacter_eq_iff_of_odd`, this is the full list of the
pairs of invariants of Demushkin groups. -/
theorem exists_isDemushkin_range_demushkinCharacter_eq_iff_of_even {n : ℕ} (hn : Even n)
    {A : Subgroup ℤ_[p]ˣ} (hA : IsClosed (A : Set ℤ_[p]ˣ)) (hAp : IsProP p A) :
    (∃ r : freeProP p (Fin n), ∃ hG : IsDemushkin p (presentedProP p (Fin n) {r}),
        demushkinRank hG = n ∧ (demushkinCharacter hG).toMonoidHom.range = A) ↔
      profiniteIndex ((A.map (powMonoidHom p)).subgroupOf A) <
        Supernatural.primePower ⟨p, hp.out⟩ n := by
  refine ⟨?_, fun hlt ↦ ?_⟩
  · rintro ⟨r, hG, hrank, rfl⟩
    have := hG.profiniteIndex_subgroupOf_map_powMonoidHom_range_lt_of_even_demushkinRank
      (by rwa [hrank])
    rwa [hrank] at this
  · obtain ⟨r, hG, hrank, -, hrange⟩ := exists_isDemushkin_range_eq_of_even_of_lt hA hAp hn hlt
    exact ⟨r, hG, hrank, hrange _ (hasPrescriptionProperty_demushkinCharacter hG)⟩

end TauCeti
