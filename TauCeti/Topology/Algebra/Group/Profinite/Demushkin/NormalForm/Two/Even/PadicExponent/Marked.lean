module

public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Uniqueness
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Two.Even.PadicExponent.IsDemushkin
public import TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Two.Even.PadicExponent.RankTwoImage

/-!
# Marked dyadic normal forms with a `2`-adic exponent

The even-rank dyadic normal form of a Demushkin group is

`x₁^(2+α) (x₁, x₂) x₃^(2^f) (x₃, x₄) ⋯ (xₙ₋₁, xₙ)`

with a genuinely `2`-adic exponent `α ∈ 4ℤ₂`. This file gives the marked classification
with that relator. It complements the natural-exponent statements in
`TauCeti.Topology.Algebra.Group.Profinite.Demushkin.NormalForm.Marked`: the target presentation is
now formed with `TauCeti.demushkinWordTwoEvenPadic`, and the marking reads the factor `1 + α`
in `ℤ₂` directly.

At a finite level there are two branches. If `2^f ∣ α`, the orientation image is
`{±1} × U^(f)`. If `α` has exact divisibility depth `g < f`, the image is the twisted
procyclic subgroup `U^[g]`. The same twisted statement at rank two has no level parameter, while
the endpoint `α = 0`, `f = ∞` is already covered by
`TauCeti.isDemushkin_marked_of_q_two_even_top`. In every case the isomorphism preserves the marked
character values prescribed by Labute's Theorem 4.

## Main results

* `TauCeti.isDemushkin_marked_of_q_two_even_unitsPlusMinus_padic`: the branch with image
  `{±1} × U^(f)`.
* `TauCeti.isDemushkin_marked_of_q_two_even_twisted_padic`: the branch with image `U^[g]`.
* `TauCeti.isDemushkin_marked_of_q_two_even_padic`: both finite-level branches in one statement.
* `TauCeti.isDemushkin_marked_of_q_two_rank_two_padic`: the rank-two twisted branch.

## References

* J. P. Labute, *Classification of Demushkin groups*, Canad. J. Math. 19 (1967), 106–132,
  Theorems 2, 4, 5 and 6.
-/

public section

namespace TauCeti

open Subgroup

universe u

variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G]

/-- **The marked classification with a `2`-adic exponent and image `{±1} × U^(f)`.**
A Demushkin pro-`2` group of even rank at least four whose orientation has image
`{±1} × U^(f)` is isomorphic to the even dyadic presentation with any `α ∈ ℤ₂` divisible by
`2^f`. The isomorphism gives the canonical character the values `-(1 + α)⁻¹` on `x₂`,
`(1 - 2^f)⁻¹` on `x₄`, and `1` on the other marked generators. -/
theorem isDemushkin_marked_of_q_two_even_unitsPlusMinus_padic (hG : IsDemushkin 2 G)
    (heven : Even (demushkinRank hG)) (hn : 4 ≤ demushkinRank hG) {α : ℤ_[2]} {f : ℕ}
    (hf : 2 ≤ f) (hα : (2 : ℤ_[2]) ^ f ∣ α)
    (hrange : (demushkinCharacter hG).toMonoidHom.range = unitsPlusMinus f) :
    ∃ e : G ≃ₜ* presentedProP 2 (Fin (demushkinRank hG))
        {demushkinWordTwoEvenPadic (isProP_freeProP 2 (Fin (demushkinRank hG))) α (2 ^ f)
          (demushkinRank hG) (freeProPGen 2 (demushkinRank hG))},
      ((demushkinCharacter hG
          (e.symm (presentedProPGen 2 (demushkinRank hG) _ 1)) : ℤ_[2]) * (1 + α) = -1) ∧
        ((demushkinCharacter hG
          (e.symm (presentedProPGen 2 (demushkinRank hG) _ 3)) : ℤ_[2]) * (1 - 2 ^ f) = 1) ∧
        ∀ i : ℕ, i ≠ 1 → i ≠ 3 → i < demushkinRank hG →
          demushkinCharacter hG
            (e.symm (presentedProPGen 2 (demushkinRank hG) _ i)) = 1 := by
  have hα₂ : (2 : ℤ_[2]) ∣ α := (dvd_pow_self 2 (by omega : f ≠ 0)).trans hα
  have hq₂ : 2 ∣ 2 ^ f := dvd_pow_self 2 (by omega)
  let hH := isDemushkin_presentedProP_demushkinWordTwoEvenPadic heven (by omega) hα₂ hq₂
  have hrank := demushkinRank_presentedProP_demushkinWordTwoEvenPadic hα₂ hq₂ hH
  have hHrange :=
    range_demushkinCharacter_eq_unitsPlusMinus_of_equiv_demushkinWordTwoEvenPadic hH hf rfl
      heven (by omega) hα (ContinuousMulEquiv.refl _)
  obtain ⟨e⟩ := hG.nonempty_continuousMulEquiv_of_range_demushkinCharacter_eq hH
    (hrange.trans hHrange.symm) hrank.symm
  obtain ⟨hsecond, hfourth, htrivial⟩ :=
    demushkinCharacter_apply_equiv_symm_of_equiv_demushkinWordTwoEvenPadic hG hα₂
      (fun _ ↦ hq₂) heven (by omega) e
  exact ⟨e, hsecond, by simpa using hfourth (by omega),
    fun i hi₁ hi₃ _ ↦ htrivial i hi₁ hi₃⟩

/-- **The marked classification with a `2`-adic exponent and twisted image.**
If `α ∈ ℤ₂` has exact divisibility depth `g ≥ 2`, `g < f`, and the orientation image is
the closed subgroup generated by `-1 + 2^g`, then the group is isomorphic to the even dyadic
presentation at level `f`. The isomorphism has the prescribed values on `x₂` and `x₄` and is
trivial on all other marked generators. -/
theorem isDemushkin_marked_of_q_two_even_twisted_padic (hG : IsDemushkin 2 G)
    (heven : Even (demushkinRank hG)) (hn : 4 ≤ demushkinRank hG) {α : ℤ_[2]} {g f : ℕ}
    (hg : 2 ≤ g) (hαg : (2 : ℤ_[2]) ^ g ∣ α) (hαg' : ¬ (2 : ℤ_[2]) ^ (g + 1) ∣ α)
    (hgf : g < f) {w : ℤ_[2]ˣ} (hw : (w : ℤ_[2]) = -1 + (2 : ℤ_[2]) ^ g)
    (hrange : (demushkinCharacter hG).toMonoidHom.range = (zpowers w).topologicalClosure) :
    ∃ e : G ≃ₜ* presentedProP 2 (Fin (demushkinRank hG))
        {demushkinWordTwoEvenPadic (isProP_freeProP 2 (Fin (demushkinRank hG))) α (2 ^ f)
          (demushkinRank hG) (freeProPGen 2 (demushkinRank hG))},
      ((demushkinCharacter hG
          (e.symm (presentedProPGen 2 (demushkinRank hG) _ 1)) : ℤ_[2]) * (1 + α) = -1) ∧
        ((demushkinCharacter hG
          (e.symm (presentedProPGen 2 (demushkinRank hG) _ 3)) : ℤ_[2]) * (1 - 2 ^ f) = 1) ∧
        ∀ i : ℕ, i ≠ 1 → i ≠ 3 → i < demushkinRank hG →
          demushkinCharacter hG
            (e.symm (presentedProPGen 2 (demushkinRank hG) _ i)) = 1 := by
  have hα₂ : (2 : ℤ_[2]) ∣ α := (dvd_pow_self 2 (by omega : g ≠ 0)).trans hαg
  have hq₂ : 2 ∣ 2 ^ f := dvd_pow_self 2 (by omega)
  have hqg : (2 : ℤ_[2]) ^ (g + 1) ∣ ((2 ^ f : ℕ) : ℤ_[2]) := by
    simpa only [Nat.cast_ofNat, Nat.cast_pow] using
      (pow_dvd_pow (2 : ℤ_[2]) (by omega : g + 1 ≤ f))
  let hH := isDemushkin_presentedProP_demushkinWordTwoEvenPadic heven (by omega) hα₂ hq₂
  have hrank := demushkinRank_presentedProP_demushkinWordTwoEvenPadic hα₂ hq₂ hH
  have hHrange :=
    range_demushkinCharacter_eq_of_equiv_demushkinWordTwoEvenPadic_of_not_dvd hH hg hαg hαg'
      hqg heven (by omega) hw (ContinuousMulEquiv.refl _)
  obtain ⟨e⟩ := hG.nonempty_continuousMulEquiv_of_range_demushkinCharacter_eq hH
    (hrange.trans hHrange.symm) hrank.symm
  obtain ⟨hsecond, hfourth, htrivial⟩ :=
    demushkinCharacter_apply_equiv_symm_of_equiv_demushkinWordTwoEvenPadic hG hα₂
      (fun _ ↦ hq₂) heven (by omega) e
  exact ⟨e, hsecond, by simpa using hfourth (by omega),
    fun i hi₁ hi₃ _ ↦ htrivial i hi₁ hi₃⟩

/-- **The finite-level marked classification with a `2`-adic exponent.**
For even rank at least four and `f ≥ 2`, a Demushkin pro-`2` group has the marked presentation
with exponent `α` whenever its orientation image is the entry assigned to `(α, f)` by Labute's
table: `{±1} × U^(f)` if `2^f ∣ α`, or `U^[g]` if `α` has exact divisibility depth
`g < f`. -/
theorem isDemushkin_marked_of_q_two_even_padic (hG : IsDemushkin 2 G)
    (heven : Even (demushkinRank hG)) (hn : 4 ≤ demushkinRank hG) {α : ℤ_[2]} {f : ℕ}
    (hf : 2 ≤ f)
    (hrange : ((2 : ℤ_[2]) ^ f ∣ α ∧
        (demushkinCharacter hG).toMonoidHom.range = unitsPlusMinus f) ∨
      ∃ g : ℕ, ∃ w : ℤ_[2]ˣ, 2 ≤ g ∧ (2 : ℤ_[2]) ^ g ∣ α ∧
        ¬ (2 : ℤ_[2]) ^ (g + 1) ∣ α ∧ g < f ∧
        (w : ℤ_[2]) = -1 + (2 : ℤ_[2]) ^ g ∧
        (demushkinCharacter hG).toMonoidHom.range = (zpowers w).topologicalClosure) :
    ∃ e : G ≃ₜ* presentedProP 2 (Fin (demushkinRank hG))
        {demushkinWordTwoEvenPadic (isProP_freeProP 2 (Fin (demushkinRank hG))) α (2 ^ f)
          (demushkinRank hG) (freeProPGen 2 (demushkinRank hG))},
      ((demushkinCharacter hG
          (e.symm (presentedProPGen 2 (demushkinRank hG) _ 1)) : ℤ_[2]) * (1 + α) = -1) ∧
        ((demushkinCharacter hG
          (e.symm (presentedProPGen 2 (demushkinRank hG) _ 3)) : ℤ_[2]) * (1 - 2 ^ f) = 1) ∧
        ∀ i : ℕ, i ≠ 1 → i ≠ 3 → i < demushkinRank hG →
          demushkinCharacter hG
            (e.symm (presentedProPGen 2 (demushkinRank hG) _ i)) = 1 := by
  rcases hrange with ⟨hα, hrange⟩ | ⟨g, w, hg, hαg, hαg', hgf, hw, hrange⟩
  · exact isDemushkin_marked_of_q_two_even_unitsPlusMinus_padic hG heven hn hf hα hrange
  · exact isDemushkin_marked_of_q_two_even_twisted_padic hG heven hn hg hαg hαg' hgf hw
      hrange

/-- **The rank-two marked classification with a `2`-adic exponent.**
If the orientation image is `U^[g]` and `α ∈ ℤ₂` has exact divisibility depth `g ≥ 2`, a
rank-two Demushkin pro-`2` group is isomorphic to
`⟨x₁, x₂ ∣ x₁^(2+α) (x₁, x₂)⟩`, with the prescribed marked character values. -/
theorem isDemushkin_marked_of_q_two_rank_two_padic (hG : IsDemushkin 2 G)
    (hn : demushkinRank hG = 2) {α : ℤ_[2]} {g : ℕ} (hg : 2 ≤ g)
    (hαg : (2 : ℤ_[2]) ^ g ∣ α) (hαg' : ¬ (2 : ℤ_[2]) ^ (g + 1) ∣ α) {w : ℤ_[2]ˣ}
    (hw : (w : ℤ_[2]) = -1 + (2 : ℤ_[2]) ^ g)
    (hrange : (demushkinCharacter hG).toMonoidHom.range = (zpowers w).topologicalClosure) :
    ∃ e : G ≃ₜ* presentedProP 2 (Fin 2)
        {demushkinWordTwoEvenPadic (isProP_freeProP 2 (Fin 2)) α 0 2 (freeProPGen 2 2)},
      demushkinCharacter hG (e.symm (presentedProPGen 2 2 _ 0)) = 1 ∧
        (demushkinCharacter hG (e.symm (presentedProPGen 2 2 _ 1)) : ℤ_[2]) * (1 + α) = -1 := by
  have hα₂ : (2 : ℤ_[2]) ∣ α := (dvd_pow_self 2 (by omega : g ≠ 0)).trans hαg
  have hα₄ : (4 : ℤ_[2]) ∣ α := by
    simpa only [show (4 : ℤ_[2]) = 2 ^ 2 by norm_num] using
      (pow_dvd_pow (2 : ℤ_[2]) hg).trans hαg
  let hH := isDemushkin_presentedProP_demushkinWordTwoEvenPadic even_two (by norm_num) hα₂
    (dvd_zero 2)
  have hrank := demushkinRank_presentedProP_demushkinWordTwoEvenPadic hα₂ (dvd_zero 2) hH
  have hHrange :=
    (range_eq_topologicalClosure_zpowers_iff_dvd_and_not_dvd_demushkinWordTwoEvenPadic_two hα₄
      hg hw (hasPrescriptionProperty_demushkinCharacter hH)).2 ⟨hαg, hαg'⟩
  obtain ⟨e⟩ := hG.nonempty_continuousMulEquiv_of_range_demushkinCharacter_eq hH
    (hrange.trans hHrange.symm) (hn.trans hrank.symm)
  obtain ⟨hsecond, -, htrivial⟩ :=
    demushkinCharacter_apply_equiv_symm_of_equiv_demushkinWordTwoEvenPadic hG hα₂
      (by omega) even_two one_lt_two e
  exact ⟨e, htrivial 0 (by norm_num) (by norm_num), hsecond⟩

end TauCeti
