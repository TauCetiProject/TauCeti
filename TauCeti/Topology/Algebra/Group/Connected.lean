module

public import Mathlib.Topology.Algebra.Group.Quotient
public import Mathlib.Topology.Algebra.Group.Subgroup
public import Mathlib.Topology.Algebra.ContinuousMonoidHom
public import TauCeti.Topology.ConnectedComponents

import Mathlib.Topology.Algebra.OpenSubgroup

/-!
# Connectedness of topological groups

This file derives connectedness of a group from preconnectedness of a subgroup and its coset
quotient, and develops the identity component `Subgroup.connectedComponentOfOne G` of a
topological group `G`: it is a closed normal subgroup, it lies in every open subgroup, continuous
homomorphisms preserve it, a continuous homomorphism from a connected group with open range is
onto it, and the quotient of `G` by it is totally disconnected.  Thus a group
whose quotient by its identity component is compact is an extension of a profinite group by a
connected one.

## Main results

* `Subgroup.connectedSpace_of_quotient`: a group with continuous left translations is
  connected when a subgroup and the corresponding coset quotient are preconnected.
* `Subgroup.connectedComponentOfOne_le_of_isOpen`: an open subgroup contains the identity
  component.
* `Subgroup.ambientConnectedComponentOfOne`: the identity component of a subgroup, as a subgroup of
  the ambient group, with carrier `connectedComponentIn H 1`; it is closed when `H` is, and
  preserved by continuous self-maps of `G` that preserve `H` and fix `1`
  (`Subgroup.mapsTo_ambientConnectedComponentOfOne`).
* `TauCeti.exists_pow_mem_connectedComponentOfOne`: in a group with finitely many connected
  components, some positive power of each element lies in the identity component.
* `Subgroup.closure_eq_connectedComponentOfOne_of_mem_nhds_one_of_subset`: a neighbourhood of
  `1` inside the identity component generates it.
* `Subgroup.closure_eq_top_of_mem_nhds_one`: a preconnected topological group is generated by any
  neighbourhood of `1`.
* `Submonoid.eq_top_of_mem_nhds_one`: in a preconnected topological group a submonoid that is a
  neighbourhood of `1` is the whole group.
* `Joined.inv_mul_mem_connectedComponentOfOne`: elements joined by a path differ by an element of
  the identity component.
* `Subgroup.mem_connectedComponentOfOne_iff_joined`: in a locally path-connected group, the
  identity component consists of the elements joined to `1` by a path.
* `Subgroup.map_connectedComponentOfOne_le`: a continuous homomorphism maps the identity
  component into the identity component.
* `MonoidHom.range_eq_connectedComponentOfOne`: a continuous homomorphism with open range, whose
  kernel and the identity component of its source generate the source, is onto the identity
  component of its target.
* `ContinuousMulEquiv.map_connectedComponentOfOne`: a continuous multiplicative equivalence maps
  the identity component onto the identity component.
* `QuotientGroup.totallyDisconnectedSpace_connectedComponentOfOne`: the quotient of a
  topological group by its identity component is totally disconnected.

## References

* E. Hewitt and K. A. Ross, *Abstract Harmonic Analysis I*, Theorem 7.3.
* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Proposition 7.14 (a connected Lie group
  is generated by any neighbourhood of the identity; the argument is purely topological).
-/

public section

open Set
open scoped Topology

namespace TauCeti

variable {G : Type*} [Group G] [TopologicalSpace G] [ContinuousConstSMul G G]

/-- A group with continuous left translations is connected when a subgroup and its coset quotient
are preconnected. -/
theorem _root_.Subgroup.connectedSpace_of_quotient (H : Subgroup G) [PreconnectedSpace H]
    [PreconnectedSpace (G ⧸ H)] : ConnectedSpace G := by
  rw [connectedSpace_iff_univ]
  -- Each fiber of the quotient projection is a left translate of `H`.
  have hfiber : ∀ q : G ⧸ H, IsConnected (QuotientGroup.mk ⁻¹' {q}) := by
    intro q
    refine QuotientGroup.induction_on q ?_
    intro g
    have hrange : IsConnected (Set.range fun h : H => g * (h : G)) :=
      ⟨Set.range_nonempty _,
        isPreconnected_range ((continuous_const_smul g).comp continuous_subtypeVal)⟩
    convert hrange using 1
    ext x
    simp only [mem_preimage, mem_singleton_iff, mem_range]
    constructor
    · intro hx
      have hxH : g⁻¹ * x ∈ H := by
        simpa only [mul_inv_rev, inv_inv] using H.inv_mem (QuotientGroup.eq.mp hx)
      exact ⟨⟨g⁻¹ * x, hxH⟩, by simp⟩
    · rintro ⟨h, rfl⟩
      apply QuotientGroup.eq.mpr
      convert H.inv_mem h.property using 1
      simp
  -- Pull connectedness of the whole quotient back through the quotient projection.
  have hquot : IsConnected (Set.univ : Set (G ⧸ H)) :=
    ⟨Set.univ_nonempty, isPreconnected_univ⟩
  have huniv := (QuotientGroup.isQuotientMap_mk H).isCoinducing.isConnected_preimage_of_isClosed
    hfiber isClosed_univ hquot
  simpa using huniv

section IdentityComponent

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The underlying set of the identity component is the connected component of `1`. -/
@[simp]
theorem _root_.Subgroup.coe_connectedComponentOfOne :
    (Subgroup.connectedComponentOfOne G : Set G) = connectedComponent 1 :=
  (rfl)

/-- An element lies in the identity component exactly when it lies in the connected component
of `1`. -/
@[simp]
theorem _root_.Subgroup.mem_connectedComponentOfOne_iff {g : G} :
    g ∈ Subgroup.connectedComponentOfOne G ↔ g ∈ connectedComponent 1 :=
  Iff.rfl

/-- The identity component of a topological group is closed. -/
instance _root_.Subgroup.isClosed_connectedComponentOfOne :
    IsClosed (Subgroup.connectedComponentOfOne G : Set G) :=
  isClosed_connectedComponent

/-- The identity component of a topological group is normal. -/
instance _root_.Subgroup.normal_connectedComponentOfOne :
    (Subgroup.connectedComponentOfOne G).Normal where
  conj_mem n hn g := by
    -- Conjugation is a homeomorphism fixing `1`, so it preserves its connected component.
    have h := (IsTopologicalGroup.continuous_conj g).mapsTo_connectedComponent 1 hn
    rwa [mul_one, mul_inv_cancel] at h

/-- An open subgroup of a topological group contains the identity component. -/
theorem _root_.Subgroup.connectedComponentOfOne_le_of_isOpen {H : Subgroup G}
    (hH : IsOpen (H : Set G)) : Subgroup.connectedComponentOfOne G ≤ H :=
  -- An open subgroup is also closed, so the connected component of `1` cannot leave it.
  fun _ hg ↦ IsClopen.connectedComponent_subset ⟨H.isClosed_of_isOpen hH, hH⟩ H.one_mem hg

/-- The identity component of a subgroup `H`, as a subgroup of the ambient group: the image of
the identity component of `H` under the inclusion. -/
def _root_.Subgroup.ambientConnectedComponentOfOne (H : Subgroup G) : Subgroup G :=
  (Subgroup.connectedComponentOfOne H).map H.subtype

/-- Membership in the identity component of a subgroup `H`, viewed in the ambient group. -/
@[simp]
theorem _root_.Subgroup.mem_ambientConnectedComponentOfOne {H : Subgroup G} {g : G} :
    g ∈ H.ambientConnectedComponentOfOne ↔
      ∃ x ∈ Subgroup.connectedComponentOfOne H, (x : G) = g :=
  Subgroup.mem_map

/-- The carrier of `Subgroup.ambientConnectedComponentOfOne H` is the connected component of `1`
in `H`. -/
@[simp]
theorem _root_.Subgroup.coe_ambientConnectedComponentOfOne (H : Subgroup G) :
    (H.ambientConnectedComponentOfOne : Set G) = connectedComponentIn (H : Set G) 1 := by
  rw [connectedComponentIn_eq_image H.one_mem]
  exact Subgroup.coe_map _ _

/-- The identity component of a subgroup is contained in it. -/
theorem _root_.Subgroup.ambientConnectedComponentOfOne_le (H : Subgroup G) :
    H.ambientConnectedComponentOfOne ≤ H :=
  Subgroup.map_subtype_le _

/-- The identity component of a subgroup is preconnected. -/
theorem _root_.Subgroup.isPreconnected_ambientConnectedComponentOfOne (H : Subgroup G) :
    IsPreconnected (H.ambientConnectedComponentOfOne : Set G) := by
  rw [Subgroup.coe_ambientConnectedComponentOfOne]
  exact isPreconnected_connectedComponentIn

/-- The identity component of a closed subgroup is closed. -/
theorem _root_.Subgroup.isClosed_ambientConnectedComponentOfOne {H : Subgroup G}
    (hH : IsClosed (H : Set G)) : IsClosed (H.ambientConnectedComponentOfOne : Set G) := by
  rw [Subgroup.coe_ambientConnectedComponentOfOne]
  exact hH.connectedComponentIn

/-- A continuous self-map of `G` that maps a subgroup `H` into itself and fixes `1` maps the
identity component of `H` into itself. -/
theorem _root_.Subgroup.mapsTo_ambientConnectedComponentOfOne {H : Subgroup G} {f : G → G}
    (hf : Continuous f) (hfH : Set.MapsTo f H H) (hf1 : f 1 = 1) :
    Set.MapsTo f H.ambientConnectedComponentOfOne H.ambientConnectedComponentOfOne := by
  rw [Subgroup.coe_ambientConnectedComponentOfOne]
  have h := (hf.continuousOn.mapsTo_connectedComponentIn H.one_mem).mono_right
    (connectedComponentIn_mono _ (Set.mapsTo_iff_image_subset.1 hfH))
  rwa [hf1] at h

open scoped Pointwise in
/-- In a topological group with finitely many connected components, some positive power of each
element lies in the identity component. -/
theorem exists_pow_mem_connectedComponentOfOne [Finite (ConnectedComponents G)] (p : G) :
    ∃ m : ℕ, 0 < m ∧ p ^ m ∈ Subgroup.connectedComponentOfOne G := by
  -- Two powers `p ^ i` and `p ^ j` with `i < j` lie in the same component, so `p ^ (j - i)` lies
  -- in the component of `1`.
  have key (i j : ℕ) (hij : i < j)
      (h : ConnectedComponents.mk (p ^ i) = ConnectedComponents.mk (p ^ j)) :
      ∃ m : ℕ, 0 < m ∧ p ^ m ∈ Subgroup.connectedComponentOfOne G := by
    refine ⟨j - i, Nat.sub_pos_of_lt hij, ?_⟩
    have hj : p ^ j ∈ p ^ i • connectedComponent (1 : G) := by
      rw [smul_connectedComponent, mul_one]
      exact ConnectedComponents.coe_eq_coe.1 h ▸ mem_connectedComponent
    have heq : (p ^ i)⁻¹ • p ^ j = p ^ (j - i) := by
      rw [smul_eq_mul, inv_mul_eq_iff_eq_mul, ← pow_add, Nat.add_sub_cancel' hij.le]
    rw [Subgroup.mem_connectedComponentOfOne_iff, ← heq]
    exact Set.mem_smul_set_iff_inv_smul_mem.1 hj
  obtain ⟨i, j, hij, h⟩ :=
    Finite.exists_ne_map_eq_of_infinite fun k : ℕ ↦ ConnectedComponents.mk (p ^ k)
  rcases hij.lt_or_gt with hij | hij
  · exact key i j hij h
  · exact key j i hij h.symm

/-- In a preconnected topological group the identity component is the whole group. -/
@[simp]
theorem _root_.Subgroup.connectedComponentOfOne_eq_top [PreconnectedSpace G] :
    Subgroup.connectedComponentOfOne G = ⊤ :=
  Subgroup.coe_eq_univ.mp
    ((Subgroup.coe_connectedComponentOfOne (G := G)).trans
      (PreconnectedSpace.connectedComponent_eq_univ 1))

/-- A subgroup that is a neighbourhood of `1` contains the identity component. -/
theorem _root_.Subgroup.connectedComponentOfOne_le_of_mem_nhds_one {H : Subgroup G}
    (hH : (H : Set G) ∈ 𝓝 (1 : G)) : Subgroup.connectedComponentOfOne G ≤ H :=
  Subgroup.connectedComponentOfOne_le_of_isOpen (H.isOpen_of_mem_nhds hH)

/-- A neighbourhood of `1` contained in the identity component generates the identity
component. -/
theorem _root_.Subgroup.closure_eq_connectedComponentOfOne_of_mem_nhds_one_of_subset {s : Set G}
    (hs : s ∈ 𝓝 (1 : G)) (hsub : s ⊆ Subgroup.connectedComponentOfOne G) :
    Subgroup.closure s = Subgroup.connectedComponentOfOne G :=
  le_antisymm ((Subgroup.closure_le _).mpr hsub)
    (Subgroup.connectedComponentOfOne_le_of_mem_nhds_one
      (Filter.mem_of_superset hs Subgroup.subset_closure))

/-- A preconnected topological group is generated by any neighbourhood of `1`. -/
theorem _root_.Subgroup.closure_eq_top_of_mem_nhds_one [PreconnectedSpace G] {s : Set G}
    (hs : s ∈ 𝓝 (1 : G)) : Subgroup.closure s = ⊤ := by
  rw [← Subgroup.connectedComponentOfOne_eq_top]
  exact Subgroup.closure_eq_connectedComponentOfOne_of_mem_nhds_one_of_subset hs
    (by rw [Subgroup.connectedComponentOfOne_eq_top]; exact fun _ _ ↦ Subgroup.mem_top _)

open scoped Pointwise in
/-- **A submonoid of a preconnected topological group that is a neighbourhood of `1` is the whole
group.** No closure of `S` under inverses is assumed. -/
theorem _root_.Submonoid.eq_top_of_mem_nhds_one [PreconnectedSpace G] {S : Submonoid G}
    (hS : (S : Set G) ∈ 𝓝 (1 : G)) : S = ⊤ := by
  -- `S ∩ S⁻¹` generates the group, and as a monoid together with its inverse, which lies in `S`
  have htop := Subgroup.closure_eq_top_of_mem_nhds_one (Filter.inter_mem hS (inv_mem_nhds_one G hS))
  refine eq_top_iff.2 fun g _ ↦ ?_
  have hg : g ∈ (Subgroup.closure ((S : Set G) ∩ (S : Set G)⁻¹)).toSubmonoid := by
    rw [htop]
    exact Subgroup.mem_top g
  rw [Subgroup.closure_toSubmonoid] at hg
  refine Submonoid.closure_le.2 ?_ hg
  rintro x (hx | hx)
  · exact hx.1
  · simpa using hx.2

/-- In a topological group, an element joined to `y` differs from it by an element of the
identity component. -/
theorem _root_.Joined.inv_mul_mem_connectedComponentOfOne {x y : G} (h : Joined x y) :
    x⁻¹ * y ∈ Subgroup.connectedComponentOfOne G := by
  have : Joined (1 : G) (x⁻¹ * y) := by
    simpa using h.map (continuous_const.mul continuous_id : Continuous fun z : G ↦ x⁻¹ * z)
  exact pathComponent_subset_component _ this

/-- In a locally path-connected topological group, an element lies in the identity component
exactly when it is joined to `1` by a path. -/
theorem _root_.Subgroup.mem_connectedComponentOfOne_iff_joined [LocallyPathConnectedSpace G]
    {x : G} : x ∈ Subgroup.connectedComponentOfOne G ↔ Joined 1 x := by
  rw [Subgroup.mem_connectedComponentOfOne_iff, ← pathComponent_eq_connectedComponent,
    mem_pathComponent_iff]

/-- A continuous homomorphism maps the identity component into the identity component. -/
theorem _root_.Subgroup.map_connectedComponentOfOne_le {G' : Type*} [Group G']
    [TopologicalSpace G'] [IsTopologicalGroup G'] {f : G →* G'} (hf : Continuous f) :
    (Subgroup.connectedComponentOfOne G).map f ≤ Subgroup.connectedComponentOfOne G' := by
  rintro _ ⟨g, hg, rfl⟩
  have h := hf.mapsTo_connectedComponent 1 hg
  rwa [map_one] at h

/-- A continuous homomorphism with open range is onto the identity component of its target,
provided its kernel and the identity component of its source generate the source. The latter
holds, for instance, when the source is connected. -/
theorem _root_.MonoidHom.range_eq_connectedComponentOfOne {G' : Type*} [Group G']
    [TopologicalSpace G'] [IsTopologicalGroup G'] {f : G →* G'} (hf : Continuous f)
    (hopen : IsOpen (f.range : Set G')) (hgen : Subgroup.connectedComponentOfOne G ⊔ f.ker = ⊤) :
    f.range = Subgroup.connectedComponentOfOne G' := by
  refine le_antisymm ?_ (Subgroup.connectedComponentOfOne_le_of_isOpen hopen)
  rw [MonoidHom.range_eq_map, ← hgen, Subgroup.map_sup, (Subgroup.map_eq_bot_iff _).mpr le_rfl,
    sup_bot_eq]
  exact Subgroup.map_connectedComponentOfOne_le hf

/-- A continuous multiplicative equivalence maps identity components onto each other. -/
theorem _root_.ContinuousMulEquiv.map_connectedComponentOfOne {G' : Type*} [Group G']
    [TopologicalSpace G'] [IsTopologicalGroup G'] (e : G ≃ₜ* G') :
    (Subgroup.connectedComponentOfOne G).map e.toMulEquiv.toMonoidHom =
      Subgroup.connectedComponentOfOne G' := by
  apply SetLike.coe_injective
  simpa [Subgroup.coe_map, Subgroup.coe_connectedComponentOfOne, map_one] using
    e.toHomeomorph.image_connectedComponent 1

open scoped Pointwise in
/-- The quotient of a topological group by its identity component is totally disconnected. -/
instance _root_.QuotientGroup.totallyDisconnectedSpace_connectedComponentOfOne :
    TotallyDisconnectedSpace (G ⧸ Subgroup.connectedComponentOfOne G) := by
  set N := Subgroup.connectedComponentOfOne G
  rw [totallyDisconnectedSpace_iff_connectedComponent_one]
  -- The fibre of the quotient map over the class of `g` is the connected component of `g`.
  have hfib (q : G ⧸ N) : IsConnected ((QuotientGroup.mk : G → G ⧸ N) ⁻¹' {q}) := by
    induction q using QuotientGroup.induction_on with | H g => ?_
    have hg : g • connectedComponent (1 : G) = connectedComponent g := by
      rw [smul_connectedComponent, mul_one]
    convert (isConnected_connectedComponent (x := g)) using 1
    ext x
    rw [Set.mem_preimage, Set.mem_singleton_iff, eq_comm, QuotientGroup.eq, ← hg,
      Set.mem_smul_set_iff_inv_smul_mem, smul_eq_mul, Subgroup.mem_connectedComponentOfOne_iff]
  -- Connected fibres make the preimage of the identity component in the quotient connected,
  -- so it lies in the identity component of `G`.
  have hpre := (QuotientGroup.isQuotientMap_mk N).isCoinducing.preimage_connectedComponent hfib 1
  refine Set.eq_singleton_iff_unique_mem.mpr ⟨mem_connectedComponent, fun y hy ↦ ?_⟩
  induction y using QuotientGroup.induction_on with | H g => ?_
  rw [← QuotientGroup.mk_one, ← Set.mem_preimage, hpre] at hy
  exact (QuotientGroup.eq_one_iff g).mpr hy

end IdentityComponent

end TauCeti
