module

public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Topology.Algebra.Group.Pointwise
public import Mathlib.Topology.Algebra.Module.Compact
public import Mathlib.Topology.Algebra.TopologicallyNilpotent

/-!
# The topological Nakayama lemma

Let `R` be a commutative topological semiring and `I` a finitely generated ideal of `R` all of
whose elements are topologically nilpotent. For a topological `R`-module `M`, compactness takes
over the role that finite generation plays in the algebraic Nakayama lemma
(`Submodule.le_of_le_smul_of_le_jacobson`): if `P` is a compact submodule and `N` a closed
submodule with `P ≤ N ⊔ I • P`, then `P ≤ N`. No finiteness of `P` and no Jacobson radical
hypothesis is needed.

The proof treats one generator `a` of `I` at a time. If `P ≤ N ⊔ a • P`, then `P ≤ N ⊔ aⁿ • P` for
every `n`; continuity of the action and compactness of `P` make `aⁿ • P` lie in any prescribed
neighbourhood of zero for large `n`, so every element of `P` lies in the closure of `N`. Adding the
remaining generators one at a time keeps the submodule closed, because the sum of a closed set and
a compact set in a topological group is closed.

The typical application is to a noetherian local ring with its adic topology and `I` its maximal
ideal `𝔪`, whose elements are then topologically nilpotent
(`WithIdeal.isTopologicallyNilpotent_of_mem`). The main example is the Iwasawa algebra
`Λ = O⟦T⟧` of a complete discrete valuation ring `O` with finite residue field: `Λ` is compact, its
`(ϖ, T)`-adic topology agrees with the coefficientwise topology, and each element of its maximal
ideal is topologically nilpotent there
(`MvPowerSeries.LinearTopology.isTopologicallyNilpotent_of_constantCoeff`). For a compact
Hausdorff `Λ`-module `M` with continuous action this gives: `M = 0` once `M = 𝔪M`; `M` is
generated by lifts of any finite spanning set of `M ⧸ 𝔪M`, so `M` is finitely generated once
`M ⧸ 𝔪M` is finite; and a continuous linear map of compact modules is surjective once it is
surjective modulo `𝔪`. Compactness cannot be dropped: `ℚ_p ⧸ ℤ_p` with the discrete topology is a
nonzero `ℤ_p`-module equal to `p` times itself.

## Main results

* `Submodule.le_of_le_smul_of_isCompact`: the topological Nakayama lemma, `P ≤ N ⊔ I • P` implies
  `P ≤ N` for `P` compact and `N` closed.
* `Submodule.eq_bot_of_le_smul_of_isCompact`: a compact submodule `N` of a `T1` module with
  `N ≤ I • N` is zero.
* `Submodule.span_eq_top_of_span_image_mkQ_eq_top`: over a compact ring, a finite subset of a
  compact Hausdorff module whose image spans `M ⧸ I • ⊤` spans `M`.
* `Module.Finite.of_quotient_smul_top`: over a compact ring, a compact Hausdorff module is
  finitely generated once `M ⧸ I • ⊤` is.
* `LinearMap.surjective_of_surjective_comp_mkQ_of_compactSpace`: a continuous linear map between
  compact modules, with Hausdorff target, is surjective once it is surjective modulo `I`.

## References

* P. N. Balister and S. Howson, *Note on Nakayama's lemma for compact Λ-modules*, Asian J. Math.
  1 (1997), 224–229.
* J. Neukirch, A. Schmidt and K. Wingberg, *Cohomology of Number Fields*, Chapter V, §2.
-/

public section

open Filter Topology Pointwise

section CommSemiring

variable {R M : Type*} [CommSemiring R] [TopologicalSpace R] [AddCommGroup M] [Module R M]
  [TopologicalSpace M] [IsTopologicalAddGroup M] [ContinuousSMul R M]

namespace Submodule

/-- The topological Nakayama lemma for the ideal generated by one topologically nilpotent
element. -/
private theorem le_of_le_sup_span_singleton_smul {a : R} (ha : IsTopologicallyNilpotent a)
    {N P : Submodule R M} (hN : IsClosed (N : Set M)) (hP : IsCompact (P : Set M))
    (hNP : P ≤ N ⊔ Ideal.span {a} • P) : P ≤ N := by
  -- Iterating the hypothesis gives `P ≤ N ⊔ aⁿ • P` for every `n`.
  have hpow (n : ℕ) : P ≤ N ⊔ a ^ n • P := by
    induction n with
    | zero => simp
    | succ n ih =>
      calc P ≤ N ⊔ a ^ n • P := ih
        _ ≤ N ⊔ a ^ n • (N ⊔ a • P) := by
          gcongr
          rwa [← ideal_span_singleton_smul]
        _ ≤ N ⊔ a ^ (n + 1) • P := by
          rw [smul_sup', pow_succ, mul_smul, ← sup_assoc]
          exact sup_le_sup_right (sup_le le_rfl (smul_le_self_of_tower _ _)) _
  -- An element `m ∈ P \ N` keeps a neighbourhood `m - U` away from the closed set `N`, while
  -- `aⁿ • P ⊆ U` for large `n` by compactness of `P`.
  intro m hm
  by_contra hmN
  have hU : {x : M | m - x ∉ N} ∈ 𝓝 0 :=
    (hN.isOpen_compl.preimage (continuous_const.sub continuous_id)).mem_nhds (by simpa)
  have hsmul : ∀ᶠ r in 𝓝 (0 : R), ∀ y ∈ (P : Set M), r • y ∈ {x : M | m - x ∉ N} :=
    hP.eventually_forall_of_forall_eventually fun y _ ↦
      (continuous_smul.tendsto ((0 : R), y)).eventually (by rwa [zero_smul])
  obtain ⟨n, hn⟩ := (ha.eventually hsmul).exists
  obtain ⟨x, hx, z, hz, rfl⟩ := mem_sup.1 (hpow n hm)
  obtain ⟨y, hy, rfl⟩ := (mem_smul_pointwise_iff_exists _ _ _).1 hz
  exact hn y hy (by simpa using hx)

/-- **The topological Nakayama lemma.** Let `I` be a finitely generated ideal of topologically
nilpotent elements. If `P` is a compact submodule and `N` a closed submodule of a topological
module with `P ≤ N ⊔ I • P`, then `P ≤ N`. Compactness of `P` replaces the finite generation
hypothesis of `Submodule.le_of_le_smul_of_le_jacobson`. -/
theorem le_of_le_smul_of_isCompact {I : Ideal R} {N P : Submodule R M} (hI : I.FG)
    (hInil : ∀ a ∈ I, IsTopologicallyNilpotent a) (hN : IsClosed (N : Set M))
    (hP : IsCompact (P : Set M)) (hNP : P ≤ N ⊔ I • P) : P ≤ N := by
  classical
  obtain ⟨s, rfl⟩ := hI
  induction s using Finset.induction_on generalizing N with
  | empty => simpa using hNP
  | insert a s _ ih =>
    -- Absorb the generator `a` into `N`; the enlarged submodule `N ⊔ a • P` is still closed.
    rw [Finset.coe_insert, Ideal.span_insert, sup_smul, ← sup_assoc] at hNP
    refine le_of_le_sup_span_singleton_smul
      (hInil a (Ideal.subset_span (Finset.mem_coe.2 (Finset.mem_insert_self a s)))) hN hP
      (ih ?_ (fun b hb ↦ hInil b (Ideal.span_mono (Finset.coe_subset.2 (Finset.subset_insert a s))
        hb)) hNP)
    rw [coe_sup, ideal_span_singleton_smul, coe_pointwise_smul]
    exact hN.add_right_of_isCompact (hP.smul a)

/-- **The topological Nakayama lemma**, vanishing form: if `I` is a finitely generated ideal of
topologically nilpotent elements, a compact submodule `N` of a `T1` topological module with
`N ≤ I • N` is zero. -/
theorem eq_bot_of_le_smul_of_isCompact [T1Space M] {I : Ideal R} {N : Submodule R M} (hI : I.FG)
    (hInil : ∀ a ∈ I, IsTopologicallyNilpotent a) (hN : IsCompact (N : Set M))
    (hIN : N ≤ I • N) : N = ⊥ :=
  le_bot_iff.1 <| le_of_le_smul_of_isCompact hI hInil (by simp) hN
    (by simpa using hIN)

end Submodule

end CommSemiring

section CommRing

variable {R M : Type*} [CommRing R] [TopologicalSpace R] [AddCommGroup M] [Module R M]
  [TopologicalSpace M] [IsTopologicalAddGroup M] [ContinuousSMul R M]

namespace Submodule

/-- **Lifting generators along `M → M ⧸ I • M`.** Over a compact ring, let `I` be a finitely
generated ideal of topologically nilpotent elements and `M` a compact Hausdorff module. A finite
set whose image spans `M ⧸ I • ⊤` spans `M`. -/
theorem span_eq_top_of_span_image_mkQ_eq_top [CompactSpace R] [CompactSpace M] [T2Space M]
    {I : Ideal R} (hI : I.FG) (hInil : ∀ a ∈ I, IsTopologicallyNilpotent a) {s : Set M}
    (hs : s.Finite) (hspan : span R ((I • ⊤ : Submodule R M).mkQ '' s) = ⊤) : span R s = ⊤ := by
  refine top_le_iff.1 <| le_of_le_smul_of_isCompact hI hInil
    (isCompact_of_fg (fg_span hs)).isClosed (by simpa using isCompact_univ) ?_
  rw [← map_span] at hspan
  rw [sup_comm, ← comap_map_mkQ, hspan, comap_top]

end Submodule

/-- **Finite generation from the reduction modulo `I`.** Over a compact ring, let `I` be a
finitely generated ideal of topologically nilpotent elements. A compact Hausdorff topological
module `M` is finitely generated once `M ⧸ I • ⊤` is; in particular once `M ⧸ I • ⊤` is finite
(`Module.Finite.of_finite`). -/
theorem Module.Finite.of_quotient_smul_top [CompactSpace R] [CompactSpace M] [T2Space M]
    {I : Ideal R} (hI : I.FG) (hInil : ∀ a ∈ I, IsTopologicallyNilpotent a)
    [Module.Finite R (M ⧸ (I • ⊤ : Submodule R M))] : Module.Finite R M := by
  obtain ⟨t, ht⟩ := Module.finite_def.1 ‹Module.Finite R (M ⧸ (I • ⊤ : Submodule R M))›
  have ht' : (t : Set (M ⧸ (I • ⊤ : Submodule R M))).Finite := t.finite_toSet
  refine ⟨Submodule.fg_def.2 ⟨_, ht'.image Quotient.out, ?_⟩⟩
  refine Submodule.span_eq_top_of_span_image_mkQ_eq_top hI hInil (ht'.image _) ?_
  simpa [Set.image_image] using ht

/-- **Surjectivity modulo `I`.** Let `I` be a finitely generated ideal of topologically nilpotent
elements and `f : M' →ₗ[R] M` a continuous linear map between compact topological modules, with
`M` Hausdorff. If `f` is surjective modulo `I`, that is `M' → M ⧸ I • M` is surjective, then `f`
is surjective. Compare `LinearMap.surjective_of_surjective_comp_mkQ` for finite modules. -/
theorem LinearMap.surjective_of_surjective_comp_mkQ_of_compactSpace {M' : Type*} [AddCommGroup M']
    [Module R M'] [TopologicalSpace M'] [CompactSpace M'] [CompactSpace M] [T2Space M]
    {I : Ideal R} (hI : I.FG) (hInil : ∀ a ∈ I, IsTopologicallyNilpotent a) (f : M' →ₗ[R] M)
    (hf : Continuous f) (surj : Function.Surjective ((I • (⊤ : Submodule R M)).mkQ ∘ₗ f)) :
    Function.Surjective f := by
  rw [← LinearMap.range_eq_top, ← top_le_iff]
  refine Submodule.le_of_le_smul_of_isCompact hI hInil ?_ (by simpa using isCompact_univ) ?_
  · rw [LinearMap.coe_range]
    exact (isCompact_range hf).isClosed
  · rw [top_le_iff, sup_comm, ← Submodule.map_mkQ_eq_top, ← LinearMap.range_comp]
    exact LinearMap.range_eq_top_of_surjective _ surj

end CommRing
