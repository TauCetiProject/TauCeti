/-!
# Finite-dimensional topological vector spaces

The linear-map conversion API preserves composition and recovers a continuous linear map after
forgetting continuity. `LinearMap.toContinuousLinearMap_coe` only needs finite dimension on the
source. `LinearMap.toContinuousLinearMap_comp` needs finite dimension on the source and
intermediate space; the target may be any topological vector space.

A multilinear map `f : MultilinearMap 𝕜 M N` on finitely many finite-dimensional Hausdorff
topological vector spaces over a complete nontrivially normed field is continuous when addition
and scalar multiplication are continuous in the codomain:
`MultilinearMap.continuous_of_finiteDimensional`. The codomain need only be an additive
commutative monoid. No norm is required on the domain modules or codomain, and no bound on the
map is assumed.

This is the multilinear companion of `LinearMap.continuous_of_finiteDimensional`. Mathlib's
`MultilinearMap.continuous_of_bound` asks for an explicit bound, which is exactly what one does
not have when the multilinear map arrives from algebra — a tensor or symmetric-power
construction, say — rather than from analysis. In particular alternating maps on such a space
are the same as continuous alternating maps: `AlternatingMap.toContinuousAlternatingMap` is the
alternating companion of `LinearMap.toContinuousLinearMap`.

In the same setting every seminorm on a finite-dimensional Hausdorff topological vector space is
continuous: `Seminorm.continuous_of_finiteDimensional`. Such a seminorm is dominated by a multiple
of the sup norm of the coordinates in a basis, and those coordinates are continuous. This is how a
norm defined by algebra, such as the spectral norm of a finite field extension, is compared with a
topology given in advance.

The inverse of the continuous coordinate equivalence `Module.Basis.equivFunL` of a finite
basis `v` sends a coordinate vector `x` to the linear combination `∑ i, x i • v i`:
`Module.Basis.equivFunL_symm_apply`, the continuous counterpart of
`Module.Basis.equivFun_symm_apply`.

A closed subspace `S` of finite codimension has a topological complement inside every dense
subspace `D`: `Submodule.exists_le_isTopCompl_of_dense`. Consequently `S ⊔ D` is the whole space
(`Submodule.sup_eq_top_of_dense`) and `S ⊓ D` is dense in `S`
(`Submodule.closure_inf_eq_of_dense`). For instance, an ideal of finite codimension in a Banach
algebra all of whose ideals are closed is generated by its intersection with a dense subalgebra.

A linear map with dense range out of a finite-dimensional space into a Hausdorff topological
vector space is surjective, since its range is finite-dimensional and therefore closed:
`LinearMap.surjective_of_denseRange`. For an algebra map `f : A → B` with dense range into a
topological `K`-algebra, this makes `A ⧸ (J ∩ A) → B ⧸ J` bijective whenever `B ⧸ J` is Hausdorff
and `A ⧸ (J ∩ A)` is finite over `K`: `Ideal.quotientMapₐ_bijective_of_denseRange`.
-/

public section

namespace LinearMap

variable {𝕜 E F : Type*} [NontriviallyNormedField 𝕜] [CompleteSpace 𝕜]
  [AddCommGroup E] [TopologicalSpace E] [IsTopologicalAddGroup E]
  [Module 𝕜 E] [ContinuousSMul 𝕜 E] [T2Space E] [FiniteDimensional 𝕜 E]
  [AddCommGroup F] [TopologicalSpace F] [IsTopologicalAddGroup F]
  [Module 𝕜 F] [ContinuousSMul 𝕜 F]

/-- Passing a continuous linear map to a linear map and back returns the original map. -/
@[simp]
theorem toContinuousLinearMap_coe (T : E →L[𝕜] F) :
    (T : E →ₗ[𝕜] F).toContinuousLinearMap = T :=
  ContinuousLinearMap.ext fun _ ↦ rfl

variable [T2Space F] [FiniteDimensional 𝕜 F]
  {G : Type*} [AddCommGroup G] [TopologicalSpace G] [IsTopologicalAddGroup G]
  [Module 𝕜 G] [ContinuousSMul 𝕜 G]

/-- Passing a composition of linear maps to continuous linear maps preserves composition. -/
@[simp]
theorem toContinuousLinearMap_comp (g : F →ₗ[𝕜] G) (f : E →ₗ[𝕜] F) :
    (g ∘ₗ f).toContinuousLinearMap =
      g.toContinuousLinearMap ∘L f.toContinuousLinearMap :=
  ContinuousLinearMap.ext fun _ ↦ rfl

end LinearMap

namespace MultilinearMap

variable {𝕜 ι : Type*} {M : ι → Type*} {N : Type*} [NontriviallyNormedField 𝕜] [CompleteSpace 𝕜]
  [Finite ι] [∀ i, AddCommGroup (M i)] [∀ i, Module 𝕜 (M i)] [∀ i, TopologicalSpace (M i)]
  [∀ i, IsTopologicalAddGroup (M i)] [∀ i, ContinuousSMul 𝕜 (M i)] [∀ i, T2Space (M i)]
  [∀ i, FiniteDimensional 𝕜 (M i)] [AddCommMonoid N] [Module 𝕜 N] [TopologicalSpace N]
  [ContinuousAdd N] [ContinuousSMul 𝕜 N]

/-- A multilinear map on finitely many finite-dimensional Hausdorff topological vector spaces
over a complete nontrivially normed field is continuous when its codomain is an additive
commutative monoid with continuous addition and scalar multiplication. No bound is required. -/
theorem continuous_of_finiteDimensional (f : MultilinearMap 𝕜 M N) : Continuous f := by
  classical
  cases nonempty_fintype ι
  set b : ∀ i, Module.Basis (Fin (Module.finrank 𝕜 (M i))) 𝕜 (M i) :=
    fun i ↦ Module.finBasis 𝕜 (M i) with _
  have key : ⇑f = fun m : ∀ i, M i ↦ ∑ r : ∀ i, Fin (Module.finrank 𝕜 (M i)),
      (∏ i, (b i).repr (m i) (r i)) • f fun i ↦ b i (r i) := by
    funext m
    have hm : f m = f fun i ↦ ∑ j, (b i).repr (m i) j • b i j := by
      congr 1 with i
      exact ((b i).sum_repr (m i)).symm
    rw [hm, f.map_sum]
    exact Finset.sum_congr rfl fun r _ ↦ f.map_smul_univ _ _
  rw [key]
  refine continuous_finsetSum _ fun r _ ↦ Continuous.smul ?_ continuous_const
  refine continuous_finsetProd _ fun i _ ↦ ?_
  exact (((b i).coord (r i)).continuous_of_finiteDimensional.comp
    (continuous_apply i)).congr fun m ↦ Module.Basis.coord_apply _ _ _

end MultilinearMap

namespace AlternatingMap

variable {𝕜 ι M N : Type*} [NontriviallyNormedField 𝕜] [CompleteSpace 𝕜] [Finite ι]
  [AddCommGroup M] [Module 𝕜 M] [TopologicalSpace M] [IsTopologicalAddGroup M]
  [ContinuousSMul 𝕜 M] [T2Space M] [FiniteDimensional 𝕜 M] [AddCommGroup N] [Module 𝕜 N]
  [TopologicalSpace N] [ContinuousAdd N] [ContinuousSMul 𝕜 N]

/-- On a finite-dimensional Hausdorff topological vector space over a complete nontrivially
normed field, every alternating map is continuous, so alternating maps and continuous alternating
maps form linearly equivalent spaces. -/
def toContinuousAlternatingMap : (M [⋀^ι]→ₗ[𝕜] N) ≃ₗ[𝕜] M [⋀^ι]→L[𝕜] N where
  toFun f := { f with cont := f.toMultilinearMap.continuous_of_finiteDimensional }
  invFun f := f.toAlternatingMap
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv _ := rfl
  right_inv _ := rfl

/-- An alternating map and its continuous version have the same values. -/
@[simp]
theorem coe_toContinuousAlternatingMap (f : M [⋀^ι]→ₗ[𝕜] N) :
    ⇑(toContinuousAlternatingMap f) = f :=
  (rfl)

/-- The inverse of `AlternatingMap.toContinuousAlternatingMap` forgets continuity. -/
@[simp]
theorem toContinuousAlternatingMap_symm_apply (f : M [⋀^ι]→L[𝕜] N) :
    toContinuousAlternatingMap.symm f = f.toAlternatingMap :=
  (rfl)

end AlternatingMap

namespace Seminorm

variable {𝕜 E : Type*} [NontriviallyNormedField 𝕜] [CompleteSpace 𝕜] [AddCommGroup E]
  [Module 𝕜 E] [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E] [T2Space E]
  [FiniteDimensional 𝕜 E]

/-- A seminorm on a finite-dimensional Hausdorff topological vector space over a complete
nontrivially normed field is continuous. -/
theorem continuous_of_finiteDimensional (p : Seminorm 𝕜 E) : Continuous p := by
  let b := Module.finBasis 𝕜 E
  -- `p` is dominated by `C` times the sup norm of the coordinates in `b`, with `C = ∑ᵢ p (b i)`
  have hle (x : E) : p x ≤ (∑ i, p (b i)) * ‖b.equivFun x‖ :=
    calc p x = p (∑ i, b.equivFun x i • b i) := by rw [b.sum_equivFun]
      _ ≤ ∑ i, p (b.equivFun x i • b i) :=
        Finset.le_sum_of_subadditive p (map_zero p).le (map_add_le_add p) _ _
      _ = ∑ i, ‖b.equivFun x i‖ * p (b i) := by simp only [map_smul_eq_mul]
      _ ≤ ∑ i, ‖b.equivFun x‖ * p (b i) := by
        gcongr with i
        exact norm_le_pi_norm (b.equivFun x) i
      _ = (∑ i, p (b i)) * ‖b.equivFun x‖ := by
        rw [← Finset.mul_sum, mul_comm]
  refine Seminorm.continuous_of_continuousAt_zero ?_
  rw [ContinuousAt, map_zero]
  refine squeeze_zero (fun x ↦ apply_nonneg p x) hle ?_
  have hc : Continuous fun x ↦ (∑ i, p (b i)) * ‖b.equivFun x‖ :=
    continuous_const.mul (continuous_norm.comp (continuous_equivFun_basis b))
  simpa using hc.tendsto 0

end Seminorm

namespace Module.Basis

variable {𝕜 E ι : Type*} [NontriviallyNormedField 𝕜] [CompleteSpace 𝕜] [AddCommGroup E]
  [Module 𝕜 E] [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E] [T2Space E]
  [Fintype ι]

/-- The inverse of the continuous coordinate equivalence of a finite basis `v` sends a coordinate
vector `x` to the linear combination `∑ i, x i • v i`. -/
@[simp] theorem equivFunL_symm_apply (v : Basis ι 𝕜 E) (x : ι → 𝕜) :
    v.equivFunL.symm x = ∑ i, x i • v i :=
  v.equivFunL.symm_apply_eq.2 <| funext fun i ↦ by
    rw [equivFunL_apply, ← equivFun_apply, ← v.equivFun_symm_apply, LinearEquiv.apply_symm_apply]

end Module.Basis

namespace Submodule

variable {𝕜 E : Type*} [NontriviallyNormedField 𝕜] [CompleteSpace 𝕜] [AddCommGroup E]
  [Module 𝕜 E] [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E]
  {S D : Submodule 𝕜 E}

/-- A closed subspace of finite codimension and a dense subspace together span the whole space. -/
theorem sup_eq_top_of_dense (hS : IsClosed (S : Set E)) [FiniteDimensional 𝕜 (E ⧸ S)]
    (hD : Dense (D : Set E)) : S ⊔ D = ⊤ := by
  -- The image of `D` in the finite-dimensional Hausdorff quotient `E ⧸ S` is dense and closed.
  have hmap : D.map S.mkQ = ⊤ := by
    rw [← coe_eq_univ, ← (D.map S.mkQ).closed_of_finiteDimensional.closure_eq, map_coe]
    exact (S.mkQ_surjective.denseRange.dense_image S.continuous_mkQ hD).closure_eq
  rw [← comap_map_mkQ, hmap, comap_top]

/-- A closed subspace of finite codimension has a topological complement contained in any given
dense subspace. -/
theorem exists_le_isTopCompl_of_dense (hS : IsClosed (S : Set E)) [FiniteDimensional 𝕜 (E ⧸ S)]
    (hD : Dense (D : Set E)) : ∃ F ≤ D, IsTopCompl S F := by
  -- Complement `S ⊓ D` inside `D`.
  obtain ⟨F, hdisj, hsup⟩ := IsModularLattice.exists_disjoint_and_sup_eq (inf_le_right : S ⊓ D ≤ D)
  have hFD : F ≤ D := hsup ▸ le_sup_right
  refine ⟨F, hFD, IsCompl.isTopCompl_of_finiteDimensional_quotient ⟨?_, ?_⟩ hS⟩
  · rw [disjoint_iff, ← inf_eq_right.mpr hFD, ← inf_assoc, ← disjoint_iff]
    exact hdisj
  · rw [codisjoint_iff, ← sup_eq_top_of_dense hS hD, ← hsup, ← sup_assoc,
      sup_inf_self]

/-- The intersection of a closed subspace `S` of finite codimension with a dense subspace is dense
in `S`. -/
theorem closure_inf_eq_of_dense (hS : IsClosed (S : Set E)) [FiniteDimensional 𝕜 (E ⧸ S)]
    (hD : Dense (D : Set E)) : closure ((S ⊓ D : Submodule 𝕜 E) : Set E) = S := by
  obtain ⟨F, hFD, hF⟩ := exists_le_isTopCompl_of_dense hS hD
  -- The continuous projection onto `S` along `F ≤ D` maps `D` into `S ⊓ D` and fixes `S`.
  have hPD : S.projection F hF.isCompl '' D ⊆ (S ⊓ D : Submodule 𝕜 E) := by
    rintro _ ⟨x, hx, rfl⟩
    refine ⟨projection_apply_mem hF.isCompl x, ?_⟩
    rw [SetLike.mem_coe, projection_eq_self_sub_projection hF.isCompl.symm x]
    exact D.sub_mem hx (hFD (projection_apply_mem _ x))
  refine (closure_minimal (by simp) hS).antisymm fun x hx ↦ ?_
  rw [← (projection_eq_self_iff hF.isCompl x).mpr hx]
  exact closure_mono hPD (mem_closure_image hF.continuous_projection.continuousAt (hD x))

end Submodule

namespace LinearMap

variable {𝕜 E F : Type*} [NontriviallyNormedField 𝕜] [CompleteSpace 𝕜]
  [AddCommGroup E] [Module 𝕜 E] [FiniteDimensional 𝕜 E]
  [AddCommGroup F] [TopologicalSpace F] [IsTopologicalAddGroup F] [Module 𝕜 F]
  [ContinuousSMul 𝕜 F] [T2Space F]

/-- **A linear map with dense range out of a finite-dimensional space is surjective**, since its
range is a finite-dimensional, hence closed, subspace of the Hausdorff topological vector space. -/
theorem surjective_of_denseRange {f : E →ₗ[𝕜] F} (hf : DenseRange f) :
    Function.Surjective f := fun y ↦
  LinearMap.mem_range.mp <| (LinearMap.range f).closed_of_finiteDimensional.closure_subset_iff.mpr
    (LinearMap.coe_range f).ge (hf y)

end LinearMap

/-- **Finite quotients along a dense algebra map.** Let `f : A → B` be a `K`-algebra map with dense
range into a topological `K`-algebra, and `J` an ideal of `B` with `B ⧸ J` Hausdorff. If
`A ⧸ (J ∩ A)` is finite over `K`, then the induced map `A ⧸ (J ∩ A) → B ⧸ J` is bijective. -/
theorem Ideal.quotientMapₐ_bijective_of_denseRange {K A B : Type*} [NontriviallyNormedField K]
    [CompleteSpace K] [CommRing A] [Algebra K A] [CommRing B] [Algebra K B] [TopologicalSpace B]
    [IsTopologicalRing B] [ContinuousSMul K B] {f : A →ₐ[K] B} (hf : DenseRange f) (J : Ideal B)
    [T2Space (B ⧸ J)] [Module.Finite K (A ⧸ J.comap f)] :
    Function.Bijective (Ideal.quotientMapₐ J f le_rfl) := by
  have : ContinuousSMul K (B ⧸ J) := continuousSMul_of_algebraMap K (B ⧸ J) <| by
    rw [IsScalarTower.algebraMap_eq K B (B ⧸ J), RingHom.coe_comp, Ideal.Quotient.algebraMap_eq]
    exact continuous_quot_mk.comp (continuous_algebraMap K B)
  -- The range contains the dense image of `A` in `B ⧸ J`.
  refine ⟨Ideal.quotientMap_injective, LinearMap.surjective_of_denseRange
    (f := (Ideal.quotientMapₐ J f le_rfl).toLinearMap) (Dense.mono ?_
      ((Ideal.Quotient.mk_surjective (I := J)).denseRange.comp hf continuous_quotient_mk'))⟩
  rintro _ ⟨a, rfl⟩
  exact ⟨Ideal.Quotient.mk _ a, rfl⟩
