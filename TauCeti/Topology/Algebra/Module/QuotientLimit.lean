/-!
# Inverse limits of quotient modules

Let `R` be a ring, `M` an `R`-module and `F : ι → Submodule R M` a family of submodules indexed
by a preorder. The inverse limit `lim_i M ⧸ F i` (`TauCeti.QuotientLimit F`) is the module of
families `x i ∈ M ⧸ F i` such that for `i ≤ j` the classes `x i` and `x j` have a common lift to
`M`. When `F` is antitone this says that `x j` maps to `x i` under the transition map
`M ⧸ F j → M ⧸ F i` (`TauCeti.QuotientLimit.factor_eval`), so these are the compatible families.
The ring `R` need not be commutative: for a family of left ideals of `R`, viewed as submodules of
the left regular module, `lim_i R ⧸ F i` is a left `R`-module. This is how the completed
enveloping algebra of an affine Kac--Moody algebra at a fixed level is built, as the limit of the
quotients of the enveloping algebra by the left ideals generated by high-order currents.

The limit carries the coordinate topology: the coarsest topology in which every projection
`TauCeti.QuotientLimit.eval F i` is continuous for the discrete topology on `M ⧸ F i`. A
neighbourhood basis of `x` consists of the sets of `y` agreeing with `x` in finitely many
coordinates (`TauCeti.QuotientLimit.nhds_eq`). With this topology the limit is a complete
Hausdorff nonarchimedean additive group whose topology is `R`-linear, for an arbitrary family
`F`. A family of elements is summable exactly when, in each coordinate, all but finitely many of
its terms vanish (`TauCeti.QuotientLimit.summable_iff`).

For an antitone family over a nonempty directed index, a single coordinate suffices in the
neighbourhood basis (`TauCeti.QuotientLimit.hasBasis_nhds`), the kernels of the projections form a
basis of neighbourhoods of zero, and the canonical map
`TauCeti.QuotientLimit.of F : M → lim_i M ⧸ F i` has dense range
(`TauCeti.QuotientLimit.denseRange_of`). Its kernel is `⨅ i, F i`
(`TauCeti.QuotientLimit.ker_of`), so it is injective exactly when the family separates the points
of `M`. Compatible families of linear maps into the quotients assemble into a unique linear map
into the limit (`TauCeti.QuotientLimit.lift`).

Mathlib's `AdicCompletion I M` is, up to this equivalent formulation of compatibility, the
special case of the powers `I ^ n • ⊤` of an ideal of a commutative ring, indexed by `ℕ` and
without a topology; the definition here follows its design as a type of compatible families.

## Main definitions

* `TauCeti.QuotientLimit F`: the inverse limit `lim_i M ⧸ F i`.
* `TauCeti.QuotientLimit.eval F i`: the projection onto `M ⧸ F i`.
* `TauCeti.QuotientLimit.of F`: the canonical map from `M`.
* `TauCeti.QuotientLimit.lift`: the universal property for an antitone family.

## Main results

* `TauCeti.QuotientLimit.factor_eval`: the coordinates are compatible with the transition maps.
* `TauCeti.QuotientLimit.ker_of`: the kernel of the canonical map is `⨅ i, F i`.
* `TauCeti.QuotientLimit.nhds_eq`, `TauCeti.QuotientLimit.hasBasis_nhds`: neighbourhoods in the
  coordinate topology.
* `TauCeti.QuotientLimit.instCompleteSpace`, `TauCeti.QuotientLimit.instT2Space`: the limit is
  complete and Hausdorff.
* `TauCeti.QuotientLimit.summable_iff`: summable families in the limit.
* `TauCeti.QuotientLimit.denseRange_of`: the canonical map has dense range.

## References

* N. Bourbaki, *General Topology*, Chapter III, §7.3, for the completion of a group with a
  neighbourhood basis of subgroups as an inverse limit of discrete quotients.
-/

public section

noncomputable section

open Filter Topology Uniformity

namespace TauCeti

variable {R M N ι : Type*} [Ring R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [Preorder ι] (F : ι → Submodule R M)

/-- The submodule of `∀ i, M ⧸ F i` of families `x` such that, for `i ≤ j`, the classes `x i` and
`x j` have a common lift to `M`. Its elements form `TauCeti.QuotientLimit F`. -/
def QuotientLimit.submodule : Submodule R (∀ i, M ⧸ F i) where
  carrier := {x | ∀ ⦃i j⦄, i ≤ j →
    ∃ m : M, Submodule.Quotient.mk m = x i ∧ Submodule.Quotient.mk m = x j}
  zero_mem' _ _ _ := ⟨0, by simp, by simp⟩
  add_mem' {x y} hx hy i j h := by
    obtain ⟨m, hmi, hmj⟩ := hx h
    obtain ⟨n, hni, hnj⟩ := hy h
    exact ⟨m + n, by simp [hmi, hni], by simp [hmj, hnj]⟩
  smul_mem' r x hx i j h := by
    obtain ⟨m, hmi, hmj⟩ := hx h
    exact ⟨r • m, by simp [hmi], by simp [hmj]⟩

/-- The inverse limit `lim_i M ⧸ F i` of the quotients of `M` by a family of submodules: the
families `x i ∈ M ⧸ F i` such that, for `i ≤ j`, the classes `x i` and `x j` have a common lift.
For an antitone family these are the families compatible with the transition maps. -/
def QuotientLimit : Type _ :=
  QuotientLimit.submodule F

namespace QuotientLimit

variable {F} in
/-- A family of classes is compatible when, for `i ≤ j`, its classes at `i` and `j` have a common
lift. -/
theorem mem_submodule_iff {x : ∀ i, M ⧸ F i} :
    x ∈ QuotientLimit.submodule F ↔ ∀ ⦃i j⦄, i ≤ j →
      ∃ m : M, Submodule.Quotient.mk m = x i ∧ Submodule.Quotient.mk m = x j :=
  Iff.rfl

instance : AddCommGroup (QuotientLimit F) :=
  inferInstanceAs (AddCommGroup (QuotientLimit.submodule F))

instance {S : Type*} [Semiring S] [SMul S R] [Module S M] [IsScalarTower S R M] :
    Module S (QuotientLimit F) :=
  inferInstanceAs (Module S (QuotientLimit.submodule F))

instance {S T : Type*} [SMul S T] [Semiring S] [Semiring T] [SMul S R] [SMul T R] [Module S M]
    [Module T M] [IsScalarTower S R M] [IsScalarTower T R M] [IsScalarTower S T M] :
    IsScalarTower S T (QuotientLimit F) :=
  inferInstanceAs (IsScalarTower S T (QuotientLimit.submodule F))

/-- The projection of the inverse limit onto the quotient `M ⧸ F i`. -/
def eval (i : ι) : QuotientLimit F →ₗ[R] M ⧸ F i :=
  (LinearMap.proj i).comp (QuotientLimit.submodule F).subtype

variable {F}

/-- Elements of the inverse limit are determined by their coordinates. -/
@[ext]
theorem ext {x y : QuotientLimit F} (h : ∀ i, eval F i x = eval F i y) : x = y :=
  Subtype.ext (funext h)

/-- Linear maps into the inverse limit are determined by their coordinates. -/
@[ext]
theorem linearMap_ext {f g : N →ₗ[R] QuotientLimit F}
    (h : ∀ i, (eval F i).comp f = (eval F i).comp g) : f = g :=
  LinearMap.ext fun n ↦ ext fun i ↦ LinearMap.congr_fun (h i) n

/-- For `i ≤ j`, the coordinates of an element at `i` and at `j` have a common lift. -/
theorem exists_mk_eq_eval (x : QuotientLimit F) {i j : ι} (h : i ≤ j) :
    ∃ m : M, Submodule.Quotient.mk m = eval F i x ∧ Submodule.Quotient.mk m = eval F j x :=
  x.2 h

variable (F) in
/-- The element of the inverse limit with prescribed coordinates, any two of which have a common
lift. -/
def mk (x : ∀ i, M ⧸ F i)
    (hx : ∀ ⦃i j⦄, i ≤ j →
      ∃ m : M, Submodule.Quotient.mk m = x i ∧ Submodule.Quotient.mk m = x j) :
    QuotientLimit F :=
  ⟨x, hx⟩

@[simp]
theorem eval_mk (x : ∀ i, M ⧸ F i)
    (hx : ∀ ⦃i j⦄, i ≤ j →
      ∃ m : M, Submodule.Quotient.mk m = x i ∧ Submodule.Quotient.mk m = x j) (i : ι) :
    eval F i (mk F x hx) = x i :=
  (rfl)

/-- For an antitone family, the coordinates of an element of the inverse limit are compatible with
the transition maps `M ⧸ F j → M ⧸ F i` for `i ≤ j`. -/
@[simp]
theorem factor_eval (hF : Antitone F) {i j : ι} (h : i ≤ j) (x : QuotientLimit F) :
    Submodule.factor (hF h) (eval F j x) = eval F i x := by
  obtain ⟨m, hmi, hmj⟩ := x.exists_mk_eq_eval h
  rw [← hmi, ← hmj]
  exact Submodule.factor_mk _ m

/-- For an antitone family, the common-lift condition on a family of classes is compatibility with
the transition maps. -/
theorem forall_exists_mk_eq_iff (hF : Antitone F) (x : ∀ i, M ⧸ F i) :
    (∀ ⦃i j⦄, i ≤ j →
      ∃ m : M, Submodule.Quotient.mk m = x i ∧ Submodule.Quotient.mk m = x j) ↔
      ∀ ⦃i j⦄ (h : i ≤ j), Submodule.factor (hF h) (x j) = x i := by
  refine ⟨fun hx i j h ↦ factor_eval hF h (mk F x hx), fun hx i j h ↦ ?_⟩
  obtain ⟨m, hm⟩ := Submodule.Quotient.mk_surjective _ (x j)
  exact ⟨m, by rw [← hx h, ← hm]; exact (Submodule.factor_mk _ m).symm, hm⟩

/-- For an antitone family, agreement in a coordinate implies agreement in every smaller
coordinate. -/
theorem eval_eq_of_le (hF : Antitone F) {i j : ι} (h : i ≤ j) {x y : QuotientLimit F}
    (hxy : eval F j x = eval F j y) : eval F i x = eval F i y := by
  rw [← factor_eval hF h x, hxy, factor_eval]

variable (F) in
/-- The canonical map from `M` to the inverse limit, sending `m` to the family of its classes. -/
def of : M →ₗ[R] QuotientLimit F where
  toFun m := mk F (fun _ ↦ Submodule.Quotient.mk m) fun _ _ _ ↦ ⟨m, rfl, rfl⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp]
theorem eval_of (i : ι) (m : M) : eval F i (of F m) = Submodule.Quotient.mk m :=
  (rfl)

theorem eval_comp_of (i : ι) : (eval F i).comp (of F) = (F i).mkQ :=
  (rfl)

/-- The projections of the inverse limit are surjective. -/
theorem eval_surjective (i : ι) : Function.Surjective (eval F i) := fun q ↦ by
  obtain ⟨m, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  exact ⟨of F m, rfl⟩

variable (F) in
/-- The kernel of the canonical map is the intersection of the submodules. -/
theorem ker_of : LinearMap.ker (of F) = ⨅ i, F i := by
  ext m
  simp [QuotientLimit.ext_iff]

variable (F) in
/-- The canonical map is injective exactly when the submodules intersect in zero. -/
theorem of_injective_iff : Function.Injective (of F) ↔ ⨅ i, F i = ⊥ := by
  rw [← LinearMap.ker_eq_bot, ker_of]

/-! ### The universal property -/

section Lift

variable (hF : Antitone F) (f : ∀ i, N →ₗ[R] M ⧸ F i)
  (hf : ∀ ⦃i j⦄ (h : i ≤ j), (Submodule.factor (hF h)).comp (f j) = f i)

/-- A family of linear maps into the quotients `M ⧸ F i` of an antitone family, compatible with the
transition maps, assembles into a linear map into the inverse limit. -/
def lift : N →ₗ[R] QuotientLimit F where
  toFun n := mk F (fun i ↦ f i n) <|
    (forall_exists_mk_eq_iff hF _).mpr fun _ _ h ↦ LinearMap.congr_fun (hf h) n
  map_add' _ _ := ext fun _ ↦ map_add (f _) _ _
  map_smul' _ _ := ext fun _ ↦ map_smul (f _) _ _

@[simp]
theorem eval_lift (i : ι) (n : N) : eval F i (lift hF f hf n) = f i n :=
  (rfl)

theorem eval_comp_lift (i : ι) : (eval F i).comp (lift hF f hf) = f i :=
  (rfl)

/-- The lift is the unique linear map with the prescribed coordinates. -/
theorem eq_lift_iff (g : N →ₗ[R] QuotientLimit F) :
    g = lift hF f hf ↔ ∀ i, (eval F i).comp g = f i :=
  ⟨fun h i ↦ h ▸ eval_comp_lift hF f hf i, fun h ↦ linearMap_ext fun i ↦ h i⟩

/-- The canonical map is the lift of the quotient maps. -/
theorem lift_mkQ : lift hF (fun i ↦ (F i).mkQ) (fun _ _ h ↦ Submodule.factor_comp_mk (hF h)) =
    of F :=
  (rfl)

end Lift

/-! ### The coordinate topology -/

/-- The coordinate topology on the inverse limit: the coarsest topology in which every projection
`eval F i` is continuous for the discrete topology on `M ⧸ F i`. -/
instance : TopologicalSpace (QuotientLimit F) :=
  ⨅ i, TopologicalSpace.induced (eval F i) ⊥

/-- A neighbourhood basis of `x` in the coordinate topology consists of the sets of elements which
agree with `x` in finitely many coordinates. -/
theorem nhds_eq (x : QuotientLimit F) :
    𝓝 x = ⨅ i, 𝓟 {y | eval F i y = eval F i x} := by
  rw [nhds_iInf]
  refine iInf_congr fun i ↦ ?_
  let : TopologicalSpace (M ⧸ F i) := ⊥
  have : DiscreteTopology (M ⧸ F i) := ⟨rfl⟩
  simp [nhds_induced, comap_pure, Set.preimage]

/-- A family converges to `x` exactly when it eventually agrees with `x` in each coordinate. -/
theorem tendsto_nhds_iff {α : Type*} {l : Filter α} {g : α → QuotientLimit F}
    {x : QuotientLimit F} :
    Tendsto g l (𝓝 x) ↔ ∀ i, ∀ᶠ a in l, eval F i (g a) = eval F i x := by
  simp [nhds_eq, tendsto_iInf]

/-- Each set of elements with a prescribed coordinate is open. -/
theorem isOpen_setOf_eval_eq (i : ι) (q : M ⧸ F i) :
    IsOpen {x : QuotientLimit F | eval F i x = q} := by
  refine isOpen_iff_mem_nhds.mpr fun x hx ↦ ?_
  rw [nhds_eq]
  exact mem_iInf_of_mem i (mem_principal.mpr fun y hy ↦ hy.trans hx)

/-- The kernel of each projection is open. -/
theorem isOpen_ker_eval (i : ι) : IsOpen (LinearMap.ker (eval F i) : Set (QuotientLimit F)) :=
  isOpen_setOf_eval_eq i 0

/-- The finite intersections of kernels of projections form a basis of neighbourhoods of zero. -/
theorem hasBasis_nhds_zero_finite :
    (𝓝 (0 : QuotientLimit F)).HasBasis (fun s : Set ι ↦ s.Finite)
      fun s ↦ ((⨅ i ∈ s, LinearMap.ker (eval F i) : Submodule R (QuotientLimit F)) :
        Set (QuotientLimit F)) := by
  rw [nhds_eq]
  convert hasBasis_iInf_principal_finite _ using 2 with s
  simp [Set.ext_iff]

instance : IsTopologicalAddGroup (QuotientLimit F) := by
  refine isTopologicalAddGroup_iInf fun i ↦ ?_
  let : TopologicalSpace (M ⧸ F i) := ⊥
  have : DiscreteTopology (M ⧸ F i) := ⟨rfl⟩
  exact isTopologicalAddGroup_induced (eval F i)

/-- The coordinate topology is linear: the finite intersections of kernels of projections are
submodules forming a basis of neighbourhoods of zero. -/
instance : IsLinearTopology R (QuotientLimit F) :=
  IsLinearTopology.mk_of_hasBasis R hasBasis_nhds_zero_finite

instance : NonarchimedeanAddGroup (QuotientLimit F) where
  is_nonarchimedean U hU := by
    obtain ⟨s, hs, hsU⟩ := hasBasis_nhds_zero_finite.mem_iff.mp hU
    let V := (⨅ i ∈ s, LinearMap.ker (eval F i) : Submodule R (QuotientLimit F)).toAddSubgroup
    exact ⟨⟨V, V.isOpen_of_mem_nhds (hasBasis_nhds_zero_finite.mem_of_mem hs)⟩, hsU⟩

/-- Scalar multiplication by a fixed scalar is continuous in the coordinate topology. -/
instance {S : Type*} [Semiring S] [SMul S R] [Module S M] [IsScalarTower S R M] :
    ContinuousConstSMul S (QuotientLimit F) where
  continuous_const_smul s := continuous_iff_continuousAt.mpr fun x ↦ by
    refine tendsto_nhds_iff.mpr fun i ↦ ?_
    rw [nhds_eq]
    exact mem_iInf_of_mem i (mem_principal.mpr fun y hy ↦ by
      simp only [Set.mem_ofPred_eq] at hy ⊢
      rw [LinearMap.map_smul_of_tower, LinearMap.map_smul_of_tower, hy])

/-- The coordinate topology is Hausdorff. -/
instance instT2Space : T2Space (QuotientLimit F) := by
  refine IsTopologicalAddGroup.t2Space_of_zero_sep fun x hx ↦ ?_
  obtain ⟨i, hi⟩ : ∃ i, eval F i x ≠ 0 := by
    by_contra! h
    exact hx (ext fun i ↦ by simp [h i])
  exact ⟨_, (isOpen_ker_eval i).mem_nhds (by simp), hi⟩

/-- The inverse limit carries the uniform structure of its topological additive group. -/
instance : UniformSpace (QuotientLimit F) :=
  IsTopologicalAddGroup.rightUniformSpace _

instance : IsUniformAddGroup (QuotientLimit F) :=
  isUniformAddGroup_of_addCommGroup

/-- In a Cauchy filter on the inverse limit, each coordinate is eventually constant. -/
private theorem exists_setOf_eval_eq_mem {f : Filter (QuotientLimit F)} (hf : Cauchy f) (i : ι) :
    ∃ q : M ⧸ F i, {x | eval F i x = q} ∈ f := by
  have hU : {p : QuotientLimit F × QuotientLimit F | eval F i (p.2 - p.1) = 0} ∈
      𝓤 (QuotientLimit F) := by
    rw [uniformity_eq_comap_nhds_zero]
    exact preimage_mem_comap ((isOpen_ker_eval i).mem_nhds (by simp))
  obtain ⟨t, ht, hts⟩ := mem_prod_same_iff.mp (hf.2 hU)
  obtain ⟨x₀, hx₀⟩ := hf.1.nonempty_of_mem ht
  refine ⟨eval F i x₀, mem_of_superset ht fun x hx ↦ ?_⟩
  have := hts (Set.mk_mem_prod hx₀ hx)
  simpa [sub_eq_zero] using this

/-- The inverse limit is complete in the coordinate topology. -/
instance instCompleteSpace : CompleteSpace (QuotientLimit F) where
  complete {f} hf := by
    choose q hq using fun i ↦ exists_setOf_eval_eq_mem hf i
    have hcompat : ∀ ⦃i j⦄, i ≤ j →
        ∃ m : M, Submodule.Quotient.mk m = q i ∧ Submodule.Quotient.mk m = q j := by
      intro i j h
      obtain ⟨x, hxi, hxj⟩ := hf.1.nonempty_of_mem (inter_mem (hq i) (hq j))
      obtain ⟨m, hmi, hmj⟩ := x.exists_mk_eq_eval h
      exact ⟨m, hmi.trans hxi, hmj.trans hxj⟩
    refine ⟨mk F q hcompat, ?_⟩
    rw [nhds_eq]
    exact le_iInf fun i ↦ le_principal_iff.mpr (by simpa using hq i)

/-- A family in the inverse limit is summable exactly when, in each coordinate, all but finitely
many of its terms vanish. -/
theorem summable_iff {α : Type*} {g : α → QuotientLimit F} :
    Summable g ↔ ∀ i, ∀ᶠ a in cofinite, eval F i (g a) = 0 := by
  rw [NonarchimedeanAddGroup.summable_iff_tendsto_cofinite_zero, tendsto_nhds_iff]
  simp

/-- Each coordinate of the sum of a summable family in the inverse limit is the finite sum of the
coordinates of its terms. -/
theorem eval_tsum {α : Type*} {g : α → QuotientLimit F} (hg : Summable g) (i : ι) :
    eval F i (∑' a, g a) = ∑ᶠ a, eval F i (g a) := by
  let : TopologicalSpace (M ⧸ F i) := ⊥
  have : DiscreteTopology (M ⧸ F i) := ⟨rfl⟩
  have hfin : (Function.support fun a ↦ eval F i (g a)).Finite :=
    eventually_cofinite.mp (summable_iff.mp hg i)
  refine (hg.hasSum.map (eval F i) (continuous_iInf_dom continuous_induced_dom)).unique ?_
  rw [finsum_eq_sum _ hfin]
  exact hasSum_sum_of_ne_finset_zero fun a ha ↦ by simpa using ha

/-- The images of a family in `M` form a summable family in the inverse limit when every `F i`
contains all but finitely many of its terms. -/
theorem summable_of {α : Type*} {g : α → M} (hg : ∀ i, ∀ᶠ a in cofinite, g a ∈ F i) :
    Summable fun a ↦ of F (g a) :=
  summable_iff.mpr fun i ↦ by simpa using hg i

/-! ### Antitone families over a directed index -/

section Directed

variable [IsDirected ι (· ≤ ·)] [Nonempty ι]

/-- For an antitone family over a nonempty directed index, the elements agreeing with `x` in a
single coordinate form a basis of neighbourhoods of `x`. -/
theorem hasBasis_nhds (hF : Antitone F) (x : QuotientLimit F) :
    (𝓝 x).HasBasis (fun _ : ι ↦ True) fun i ↦ {y | eval F i y = eval F i x} := by
  rw [nhds_eq]
  refine hasBasis_iInf_principal fun i j ↦ ?_
  obtain ⟨k, hik, hjk⟩ := directed_of (· ≤ ·) i j
  exact ⟨k, fun y hy ↦ eval_eq_of_le hF hik hy, fun y hy ↦ eval_eq_of_le hF hjk hy⟩

/-- For an antitone family over a nonempty directed index, the kernels of the projections form a
basis of neighbourhoods of zero. -/
theorem hasBasis_nhds_zero (hF : Antitone F) :
    (𝓝 (0 : QuotientLimit F)).HasBasis (fun _ : ι ↦ True)
      fun i ↦ (LinearMap.ker (eval F i) : Set (QuotientLimit F)) := by
  convert hasBasis_nhds hF (0 : QuotientLimit F) using 2 with i
  ext
  simp

/-- For an antitone family over a nonempty directed index, the canonical map from `M` to the
inverse limit has dense range. -/
theorem denseRange_of (hF : Antitone F) : DenseRange (of F) := fun x ↦
  (mem_closure_iff_nhds_basis (hasBasis_nhds hF x)).mpr fun i _ ↦ by
    obtain ⟨m, hm⟩ := Submodule.Quotient.mk_surjective _ (eval F i x)
    exact ⟨of F m, ⟨m, rfl⟩, hm⟩

end Directed

end QuotientLimit

end TauCeti
