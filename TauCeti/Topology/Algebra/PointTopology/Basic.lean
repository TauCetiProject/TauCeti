module

public import Mathlib.Algebra.WithConv
public import Mathlib.RingTheory.FiniteType
public import Mathlib.Topology.Algebra.Polynomial
public import Mathlib.Topology.Homeomorph.Lemmas
public import TauCeti.Topology.Algebra.MvPolynomial.Aeval

/-!
# The point topology on points of an affine algebra

Let `A` be a `k`-algebra and `R` a topological `k`-algebra. The `R`-points of the affine scheme
`Spec A` over `k` are the `k`-algebra homomorphisms `A →ₐ[k] R`. Their *point topology* is the
coarsest topology making every evaluation `x ↦ x a` continuous, that is, the topology induced from
the product topology on `A → R`. No finiteness or separation hypothesis is needed to define it.
For an affine group scheme, whose points carry the convolution group structure on
`WithConv (A →ₐ[k] R)`, the topology is transported along `WithConv.ofConv`; this is the topology on
rational points used for topological groups of points over local fields and adeles.

When `A` is generated by a family `a : ι → A`, evaluation at that family embeds the points in
`ι → R`, and for `R` a commutative ring with closed points the image is the closed common zero locus
of the polynomial relations among the generators. So the point topology is the topology induced by
any presentation of `A`. For `A` of finite type this gives local compactness when `R` is locally
compact, and discreteness when `R` is discrete; without finite type discreteness fails, already for
the points of a polynomial ring in infinitely many variables over `𝔽₂`.

Mathlib's `CommRingCat.HomTopology` (Andrew Yang and Christian Merten) puts the same evaluation
topology on ring homomorphisms `A ⟶ R` between bundled commutative rings, that is, on points over
`ℤ`; the closed-embedding argument here follows its
`CommRingCat.HomTopology.isClosedEmbedding_precomp_of_surjective`. The points of an affine scheme
over a base `k` are instead `k`-algebra homomorphisms, which is the form in which affine group
schemes over `k` and their convolution groups of points are set up.

## Main declarations

* `TauCeti.PointTopology.topology`: the point topology on `A →ₐ[k] R`, a scoped instance in the
  namespace `TauCeti.PointTopology`.
* `TauCeti.PointTopology.instTopologicalSpaceWithConv`: the point topology on
  `WithConv (A →ₐ[k] R)`, with `TauCeti.PointTopology.isHomeomorph_ofConv`,
  `TauCeti.PointTopology.continuous_withConv_iff` and
  `TauCeti.PointTopology.continuous_eval_ofConv`.
* `TauCeti.PointTopology.isEmbedding_coeFn`, `TauCeti.PointTopology.continuous_eval` and
  `TauCeti.PointTopology.continuous_iff`: the characterization by evaluations.
* `TauCeti.PointTopology.polynomialHomeomorph` and
  `TauCeti.PointTopology.mvPolynomialHomeomorph`: the points of the affine line are `R`, and those
  of the affine space with coordinates indexed by `σ` are `σ → R`.
* `TauCeti.PointTopology.isEmbedding_eval_generators` and
  `TauCeti.PointTopology.isClosedEmbedding_eval_generators`: a generating family embeds the points
  in affine space, as a closed subspace when `R` is T1.
* `TauCeti.PointTopology.locallyCompactSpace_of_finiteType` and
  `TauCeti.PointTopology.discreteTopology_of_finiteType`: consequences of finite type, and
  `TauCeti.PointTopology.not_discreteTopology_mvPolynomial`, showing that finite type is needed.

## References

* B. Conrad, *Weil and Grothendieck approaches to adelic points*, Enseign. Math. (2) 58 (2012),
  Prop. 2.1 and its proof, pp. 2–3.
-/

public section

open Topology

namespace TauCeti.PointTopology

section Semiring

variable {k A R : Type*} [CommSemiring k] [Semiring A] [Algebra k A] [Semiring R] [Algebra k R]
  [TopologicalSpace R]

/-- The point topology on the `R`-points `A →ₐ[k] R` of `Spec A`: the coarsest topology for which
every evaluation `x ↦ x a` is continuous, induced from the product topology on `A → R`. It is a
scoped instance in the namespace `TauCeti.PointTopology`. -/
@[expose, implicit_reducible]
def topology : TopologicalSpace (A →ₐ[k] R) :=
  .induced (fun x ↦ ⇑x) Pi.topologicalSpace

attribute [scoped instance] topology

/-- The point topology is the topology induced from the product topology on `A → R`. -/
theorem topology_eq_induced :
    (topology : TopologicalSpace (A →ₐ[k] R)) = .induced (fun x ↦ ⇑x) Pi.topologicalSpace :=
  (rfl)

/-- Forgetting that a point is an algebra homomorphism embeds the points in `A → R`. -/
theorem isEmbedding_coeFn : IsEmbedding fun x : A →ₐ[k] R ↦ (x : A → R) :=
  ⟨⟨topology_eq_induced⟩, DFunLike.coe_injective⟩

/-- Evaluation of points at an element of `A` is continuous. -/
@[continuity, fun_prop]
theorem continuous_eval (a : A) : Continuous fun x : A →ₐ[k] R ↦ x a :=
  (continuous_apply a).comp isEmbedding_coeFn.continuous

/-- A map into the points is continuous exactly when its composite with every evaluation is. -/
theorem continuous_iff {X : Type*} [TopologicalSpace X] {g : X → A →ₐ[k] R} :
    Continuous g ↔ ∀ a, Continuous fun y ↦ g y a :=
  isEmbedding_coeFn.isInducing.continuous_iff.trans continuous_pi_iff

/-- The point topology on the convolution type `WithConv (A →ₐ[k] R)`, which carries the group of
points of an affine group scheme: the topology transported from `A →ₐ[k] R` along
`WithConv.ofConv`. -/
instance instTopologicalSpaceWithConv : TopologicalSpace (WithConv (A →ₐ[k] R)) :=
  .induced WithConv.ofConv topology

/-- `WithConv.ofConv` is a homeomorphism from `WithConv (A →ₐ[k] R)` onto the points with their
point topology. -/
theorem isHomeomorph_ofConv :
    IsHomeomorph (WithConv.ofConv : WithConv (A →ₐ[k] R) → A →ₐ[k] R) :=
  isHomeomorph_iff_isEmbedding_surjective.2
    ⟨⟨⟨rfl⟩, WithConv.ofConv_injective⟩, WithConv.ofConv_surjective⟩

/-- A map into `WithConv (A →ₐ[k] R)` is continuous exactly when its composite with every
evaluation is. -/
theorem continuous_withConv_iff {X : Type*} [TopologicalSpace X] {g : X → WithConv (A →ₐ[k] R)} :
    Continuous g ↔ ∀ a, Continuous fun y ↦ (g y).ofConv a :=
  isHomeomorph_ofConv.isEmbedding.isInducing.continuous_iff.trans continuous_iff

/-- Evaluation at `a` is continuous on `WithConv (A →ₐ[k] R)`. -/
@[continuity, fun_prop]
theorem continuous_eval_ofConv (a : A) : Continuous fun x : WithConv (A →ₐ[k] R) ↦ x.ofConv a :=
  (continuous_eval a).comp isHomeomorph_ofConv.continuous

variable (k R) in
/-- The points of the affine line: evaluation at the variable is a homeomorphism from
`k[X] →ₐ[k] R` onto `R`, with inverse `r ↦ Polynomial.aeval r`. -/
noncomputable def polynomialHomeomorph [IsTopologicalSemiring R] :
    (Polynomial k →ₐ[k] R) ≃ₜ R where
  toEquiv := (Polynomial.aevalEquiv k R).symm
  continuous_toFun := continuous_eval Polynomial.X
  continuous_invFun := continuous_iff.2 Polynomial.continuous_aeval

/-- The homeomorphism `polynomialHomeomorph` evaluates a point at the variable. -/
@[simp]
theorem polynomialHomeomorph_apply [IsTopologicalSemiring R] (x : Polynomial k →ₐ[k] R) :
    polynomialHomeomorph k R x = x Polynomial.X :=
  (rfl)

/-- The inverse of `polynomialHomeomorph` sends `r` to evaluation at `r`. -/
@[simp]
theorem polynomialHomeomorph_symm_apply [IsTopologicalSemiring R] (r : R) :
    (polynomialHomeomorph k R).symm r = Polynomial.aeval r :=
  (rfl)

end Semiring

section CommSemiring

variable {k A R : Type*} [CommSemiring k] [CommSemiring A] [Algebra k A] [CommSemiring R]
  [Algebra k R] [TopologicalSpace R] [IsTopologicalSemiring R]

variable (k R) in
/-- The points of affine space with coordinates indexed by `σ`: evaluation at the variables is a
homeomorphism from `MvPolynomial σ k →ₐ[k] R` onto `σ → R`, with inverse `MvPolynomial.aeval`. -/
noncomputable def mvPolynomialHomeomorph (σ : Type*) :
    (MvPolynomial σ k →ₐ[k] R) ≃ₜ (σ → R) where
  toFun x i := x (MvPolynomial.X i)
  invFun := MvPolynomial.aeval
  left_inv x := (MvPolynomial.aeval_unique x).symm
  right_inv v := funext (MvPolynomial.aeval_X v)
  continuous_toFun := continuous_pi fun i ↦ continuous_eval (MvPolynomial.X i)
  continuous_invFun := continuous_iff.2 MvPolynomial.continuous_aeval

/-- The homeomorphism `mvPolynomialHomeomorph` evaluates a point at each variable. -/
@[simp]
theorem mvPolynomialHomeomorph_apply {σ : Type*} (x : MvPolynomial σ k →ₐ[k] R) (i : σ) :
    mvPolynomialHomeomorph k R σ x i = x (MvPolynomial.X i) :=
  (rfl)

/-- The inverse of `mvPolynomialHomeomorph` sends `v` to evaluation at `v`. -/
@[simp]
theorem mvPolynomialHomeomorph_symm_apply {σ : Type*} (v : σ → R) :
    (mvPolynomialHomeomorph k R σ).symm v = MvPolynomial.aeval v :=
  (rfl)

/-- If the family `a` generates `A` as a `k`-algebra, then evaluation at `a` embeds the points
`A →ₐ[k] R` in `ι → R`. -/
theorem isEmbedding_eval_generators {ι : Type*} {a : ι → A}
    (ha : Algebra.adjoin k (Set.range a) = ⊤) :
    IsEmbedding fun (x : A →ₐ[k] R) (i : ι) ↦ x (a i) := by
  -- Write every element of `A` as a polynomial in the generators; then every evaluation of a
  -- point is a polynomial function of its values on the generators.
  have hp (b : A) : ∃ p : MvPolynomial ι k, MvPolynomial.aeval a p = b := by
    have hb : b ∈ Algebra.adjoin k (Set.range a) := ha ▸ Algebra.mem_top
    rwa [Algebra.adjoin_range_eq_range_aeval, AlgHom.mem_range] at hb
  choose p hp using hp
  refine .of_comp (continuous_pi fun i ↦ continuous_eval (a i))
    (continuous_pi fun b ↦ (p b).continuous_aeval) ?_
  convert (isEmbedding_coeFn (k := k) (A := A) (R := R)) using 1
  ext x b
  rw [Function.comp_apply, ← MvPolynomial.comp_aeval_apply, hp]

omit [IsTopologicalSemiring R] in
/-- Points of a finite type algebra over a discrete coefficient ring form a discrete space. -/
theorem discreteTopology_of_finiteType [DiscreteTopology R] [Algebra.FiniteType k A] :
    DiscreteTopology (A →ₐ[k] R) := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := k) (A := A)
  exact (isEmbedding_eval_generators (a := ((↑) : s → A)) (by simpa using hs)).discreteTopology

/-- Without finite type, points over a discrete ring need not be discrete: for infinitely many
variables and a nontrivial compact coefficient ring, such as `𝔽₂` with the discrete topology, the
points of affine space are an infinite compact space, hence not discrete. -/
theorem not_discreteTopology_mvPolynomial (σ : Type*) [Infinite σ] [Nontrivial R]
    [CompactSpace R] : ¬DiscreteTopology (MvPolynomial σ k →ₐ[k] R) := fun _ ↦ by
  have : DiscreteTopology (σ → R) :=
    (mvPolynomialHomeomorph k R σ).symm.isEmbedding.discreteTopology
  have : Finite (σ → R) := finite_of_compact_of_discrete
  exact not_finite (σ → R)

end CommSemiring

section CommRing

variable {k A R : Type*} [CommRing k] [CommRing A] [Algebra k A] [CommRing R] [Algebra k R]

/-- For a family `a` generating `A`, the values of the points of `A` on `a` are exactly the
families in `ι → R` at which every polynomial relation among the generators vanishes. -/
theorem range_eval_generators {ι : Type*} {a : ι → A} (ha : Algebra.adjoin k (Set.range a) = ⊤) :
    Set.range (fun (x : A →ₐ[k] R) (i : ι) ↦ x (a i)) =
      {v | ∀ p ∈ RingHom.ker (MvPolynomial.aeval a : MvPolynomial ι k →ₐ[k] A),
        MvPolynomial.aeval v p = 0} := by
  have hsurj : Function.Surjective (MvPolynomial.aeval a : MvPolynomial ι k →ₐ[k] A) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, ha]
  ext v
  constructor
  · rintro ⟨x, rfl⟩ p hp
    rw [RingHom.mem_ker] at hp
    simp only [← MvPolynomial.comp_aeval_apply, hp, map_zero]
  · intro hv
    refine ⟨AlgHom.liftOfSurjective _ hsurj (MvPolynomial.aeval v) fun p hp ↦ hv p hp, ?_⟩
    funext i
    simpa using AlgHom.liftOfSurjective_apply _ hsurj (MvPolynomial.aeval v) _ (MvPolynomial.X i)

variable [TopologicalSpace R] [IsTopologicalSemiring R] [T1Space R]

/-- If the family `a` generates `A` and `R` is T1, evaluation at `a` is a closed embedding of the
points `A →ₐ[k] R` in `ι → R`, onto the common zero locus of the relations among the generators. -/
theorem isClosedEmbedding_eval_generators {ι : Type*} {a : ι → A}
    (ha : Algebra.adjoin k (Set.range a) = ⊤) :
    IsClosedEmbedding fun (x : A →ₐ[k] R) (i : ι) ↦ x (a i) := by
  refine ⟨isEmbedding_eval_generators ha, ?_⟩
  rw [range_eval_generators ha]
  have hzero : {v : ι → R | ∀ p ∈ RingHom.ker (MvPolynomial.aeval a : MvPolynomial ι k →ₐ[k] A),
      MvPolynomial.aeval v p = 0} =
      ⋂ p ∈ RingHom.ker (MvPolynomial.aeval a : MvPolynomial ι k →ₐ[k] A),
        (fun v : ι → R ↦ MvPolynomial.aeval v p) ⁻¹' {0} := by
    ext v
    simp
  rw [hzero]
  exact isClosed_biInter fun p _ ↦ isClosed_singleton.preimage p.continuous_aeval

/-- Points of a finite type algebra over a locally compact T1 coefficient ring form a locally
compact space. -/
theorem locallyCompactSpace_of_finiteType [LocallyCompactSpace R] [Algebra.FiniteType k A] :
    LocallyCompactSpace (A →ₐ[k] R) := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := k) (A := A)
  exact (isClosedEmbedding_eval_generators (a := ((↑) : s → A))
    (by simpa using hs)).locallyCompactSpace

end CommRing

end TauCeti.PointTopology
