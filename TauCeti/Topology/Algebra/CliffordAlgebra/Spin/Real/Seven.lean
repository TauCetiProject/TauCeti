/-!
# The elementary abelian subgroup of order sixteen in `Spin(7)` lies in no torus

Let `E ≤ Spin(7)` be the elementary abelian subgroup of order `16` generated by `-1` and the
fourfold products `e₀e₁e₂e₃`, `e₀e₁e₄e₅`, `e₀e₂e₄e₆` of coordinate generators
(`TauCeti.realSpinSevenElementaryAbelian`). This file proves that `E` lies in no torus of the
compact Spin group `Spin(7) = realCliffordSpinGroup 7 0`, and more generally in no preconnected
subgroup of `Spin(7)` that centralizes it
(`TauCeti.not_realSpinSevenElementaryAbelian_le_of_le_centralizer`).

The argument uses the vector representation of `Spin(7)` on `ℝ⁷` rather than the rank of the
maximal tori. A basis monomial `e_s` of an even support `s` commutes with the generator `e_k` for
`k ∉ s` and anticommutes with it for `k ∈ s`, so it acts on the coordinate vector of index `k` by
`1` or `-1` respectively (`CliffordAlgebra.spinVectorAction_basis_of_coe_eq`). The three
supports `{0, 1, 2, 3}`, `{0, 1, 4, 5}`, `{0, 2, 4, 6}` all contain `0` and have no other common
index. Hence the joint `-1`-eigenspace of the three generators is the coordinate line `ℓ` of
index `0`. Every Spin element `t` commuting with `E` preserves this joint eigenspace, so it acts
on `ℓ` by a nonzero scalar `c(t)`, which depends continuously on `t`. On a preconnected subgroup
`T` containing `1` the scalar therefore never changes sign, so `c(t) > 0` on `T`; but the
generator `e₀e₁e₂e₃` acts on `ℓ` by `-1`. So `E` is not contained in `T`.

A torus is a compact connected commutative subgroup (`TauCeti.Lie.IsTorus`), and a commutative
subgroup containing `E` centralizes `E`, so `E` lies in no torus
(`TauCeti.not_realSpinSevenElementaryAbelian_le_of_isTorus`), although `Spin(7)` is compact
(`CliffordAlgebra.instCompactSpaceRealCliffordSpinGroupZero`), path connected
(`CliffordAlgebra.pathConnectedSpace_realCliffordSpinGroupZero_add_two`) and simply connected
(`CliffordAlgebra.simplyConnectedSpace_realCliffordSpinGroupZero`). So in a compact connected
simply connected Lie group a finite commutative subgroup need not lie in a torus. No Lie group
structure on `Spin(7)` and no rank of its maximal tori is used.

## Main results

* `TauCeti.not_realSpinSevenElementaryAbelian_le_of_le_centralizer`: `E` lies in no preconnected
  subgroup of `Spin(7)` contained in the centralizer of `E`.
* `TauCeti.not_realSpinSevenElementaryAbelian_le_of_isMulCommutative`: `E` lies in no preconnected
  commutative subgroup of `Spin(7)`.
* `TauCeti.not_realSpinSevenElementaryAbelian_le_of_isTorus`: `E` lies in no torus of `Spin(7)`.

## References

* R. L. Griess, Jr., *Elementary abelian p-subgroups of algebraic groups*, Geometriae Dedicata 39
  (1991), 253–305, for nontoral elementary abelian `2`-subgroups of Spin groups.
* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, §1–§2.
-/

public section

open CliffordAlgebra Function Set

namespace TauCeti

/-! ### The vector action of the compact model -/

/-- The coordinate basis of `ℝ⁷`, transported by `realCliffordFormNegIsometry 0 7` to the space
of the positive-definite form `realCliffordForm 7 0`. -/
private noncomputable def negBasis : Module.Basis (Fin (0 + 7)) ℝ (Fin (7 + 0) → ℝ) :=
  (Pi.basisFun ℝ (Fin (0 + 7))).map (realCliffordFormNegIsometry 0 7).toLinearEquiv

private theorem negBasis_apply (k : Fin (0 + 7)) :
    negBasis k = realCliffordFormNegIsometry 0 7 (Pi.single k 1) := by
  simp [negBasis]

/-- A Spin element of `Spin(7)` acts on the transported coordinate basis by the sign character of
the support `s`: by `-1` on the vectors indexed by `s`, and by `1` on the others. -/
private def ActsBySign (x : realCliffordSpinGroup 7 0) (s : Finset (Fin (0 + 7))) : Prop :=
  ∀ k, spinVectorAction (realCliffordForm 7 0) x (negBasis k) =
    (if k ∈ s then -1 else 1 : ℝ) • negBasis k

/-- An element acting by a sign character multiplies each coordinate by its sign. -/
private theorem ActsBySign.repr_apply {x : realCliffordSpinGroup 7 0} {s : Finset (Fin (0 + 7))}
    (hx : ActsBySign x s) (w : Fin (7 + 0) → ℝ) (k : Fin (0 + 7)) :
    negBasis.repr (spinVectorAction (realCliffordForm 7 0) x w) k =
      (if k ∈ s then -1 else 1 : ℝ) * negBasis.repr w k := by
  have h : negBasis.coord k ∘ₗ (spinVectorAction (realCliffordForm 7 0) x).toLinearMap =
      (if k ∈ s then -1 else 1 : ℝ) • negBasis.coord k := by
    refine negBasis.ext fun j ↦ ?_
    rw [LinearMap.comp_apply, LinearEquiv.coe_coe, hx j, map_smul, LinearMap.smul_apply]
    rcases eq_or_ne j k with rfl | hjk
    · rfl
    · simp [hjk]
  simpa [-ite_smul] using LinearMap.congr_fun h w

/-- The image in `Spin(7)` of a Spin element `±e_s` of the negative-definite model acts by the
sign character of `s`, for an even support `s`. -/
private theorem actsBySign_realCliffordSpinGroupEquivNeg {g : realCliffordSpinGroup 0 7}
    {s : Finset (Fin (0 + 7))} (hs : Even s.card)
    (hg : IsSignedBasisSpinZeroSeven g s) :
    ActsBySign (realCliffordSpinGroupEquivNeg 0 7 g) s := fun k ↦ by
  rw [negBasis_apply, spinVectorAction_realCliffordSpinGroupEquivNeg, ← Pi.basisFun_apply ℝ,
    spinVectorAction_basis_of_coe_eq (isOrthoᵢ_associated_realCliffordForm 0 7) hs
      (isSignedBasisSpinZeroSeven_iff.1 hg), map_smul]

/-- For every support `s`, the elementary abelian subgroup of `Spin(7)` contains an element acting
by the sign character of `s`. -/
private theorem exists_mem_actsBySign {s : Finset (Fin (0 + 7))} (hs : s ∈ spinSevenSupports) :
    ∃ x ∈ realSpinSevenElementaryAbelian, ActsBySign x s := by
  obtain ⟨g, hg, hgs⟩ :=
    exists_isSignedBasisSpinZeroSeven_mem_realSpinZeroSevenElementaryAbelian hs
  exact ⟨realCliffordSpinGroupEquivNeg 0 7 g,
    mem_realSpinSevenElementaryAbelian_iff.2 (by rwa [MulEquiv.symm_apply_apply]),
    actsBySign_realCliffordSpinGroupEquivNeg (even_card_of_mem_spinSevenSupports hs) hgs⟩

/-- A Spin element commuting with the elementary abelian subgroup preserves the line of the first
transported coordinate vector, the joint `-1`-eigenspace of the three generators. -/
private theorem spinVectorAction_negBasis_zero_eq_smul {t : realCliffordSpinGroup 7 0}
    (ht : ∀ x ∈ realSpinSevenElementaryAbelian, Commute t x) :
    spinVectorAction (realCliffordForm 7 0) t (negBasis 0) =
      negBasis.repr (spinVectorAction (realCliffordForm 7 0) t (negBasis 0)) 0 • negBasis 0 := by
  set w := spinVectorAction (realCliffordForm 7 0) t (negBasis 0) with hw
  -- `w` lies in the `-1`-eigenspace of every element whose support contains `0`.
  have hneg {s : Finset (Fin (0 + 7))} (hs : s ∈ spinSevenSupports) (h0 : 0 ∈ s)
      {k : Fin (0 + 7)} (hk : k ∉ s) : negBasis.repr w k = 0 := by
    obtain ⟨x, hxE, hx⟩ := exists_mem_actsBySign hs
    have hxw : spinVectorAction (realCliffordForm 7 0) x w = -w := by
      rw [hw, spinVectorAction_apply_comm _ (ht x hxE).symm, hx 0]
      simp [h0]
    have := hx.repr_apply w k
    simp only [hxw, hk, ↓reduceIte, one_mul, map_neg, Finsupp.coe_neg, Pi.neg_apply] at this
    linarith
  -- Every index other than `0` is missed by one of the supports containing `0`.
  have hzero (k : Fin (0 + 7)) (hk : k ≠ 0) : negBasis.repr w k = 0 := by
    fin_cases k
    · exact absurd rfl hk
    · exact hneg (s := {0, 2, 4, 6}) (mem_spinSevenSupports.2 (by simp)) (by decide) (by decide)
    all_goals first
      | exact hneg (s := {0, 1, 4, 5}) (mem_spinSevenSupports.2 (by simp)) (by decide) (by decide)
      | exact hneg (s := {0, 1, 2, 3}) (mem_spinSevenSupports.2 (by simp)) (by decide) (by decide)
  conv_lhs => rw [← negBasis.sum_repr w]
  exact Finset.sum_eq_single 0 (fun k _ hk ↦ by rw [hzero k hk, zero_smul]) (by simp)

/-- The coefficient of the first transported coordinate vector in its image under a Spin element
depends continuously on the Spin element. -/
private theorem continuous_repr_spinVectorAction_negBasis_zero :
    Continuous fun t : realCliffordSpinGroup 7 0 ↦
      negBasis.repr (spinVectorAction (realCliffordForm 7 0) t (negBasis 0)) 0 := by
  refine ((LinearMap.continuous_of_finiteDimensional (negBasis.coord 0)).comp
    (continuous_spinVectorAction_apply (realCliffordForm 7 0) (negBasis 0))).congr fun t ↦ ?_
  rw [comp_apply, Module.Basis.coord_apply]

/-! ### Nontorality -/

/-- **The elementary abelian subgroup of order `16` of `Spin(7)` lies in no preconnected subgroup
centralizing it.** Every element of such a subgroup acts on the joint `-1`-eigenline of the
generators `e₀e₁e₂e₃`, `e₀e₁e₄e₅`, `e₀e₂e₄e₆` in `ℝ⁷` by a positive scalar, while `e₀e₁e₂e₃` acts
on it by `-1`. -/
theorem not_realSpinSevenElementaryAbelian_le_of_le_centralizer
    {T : Subgroup (realCliffordSpinGroup 7 0)}
    (hT : IsPreconnected (T : Set (realCliffordSpinGroup 7 0)))
    (hTc : T ≤ Subgroup.centralizer
      (realSpinSevenElementaryAbelian : Set (realCliffordSpinGroup 7 0))) :
    ¬realSpinSevenElementaryAbelian ≤ T := by
  intro hle
  set φ := fun t : realCliffordSpinGroup 7 0 ↦
    negBasis.repr (spinVectorAction (realCliffordForm 7 0) t (negBasis 0)) 0 with hφ
  -- The coefficient `φ t` is the scalar by which `t ∈ T` acts on the eigenline, so it is nonzero.
  have hφT {t : realCliffordSpinGroup 7 0} (htT : t ∈ T) : φ t ≠ 0 := by
    intro h0
    have hcomm (x : realCliffordSpinGroup 7 0) (hx : x ∈ realSpinSevenElementaryAbelian) :
        Commute t x :=
      (Subgroup.mem_centralizer_iff.1 (hTc htT) x hx).symm
    simp only [hφ] at h0
    have h := spinVectorAction_negBasis_zero_eq_smul hcomm
    rw [h0, zero_smul, LinearEquiv.map_eq_zero_iff] at h
    exact negBasis.ne_zero 0 h
  -- It takes the value `1` at the identity and `-1` at the generator `e₀e₁e₂e₃`.
  obtain ⟨x, hxE, hx⟩ :=
    exists_mem_actsBySign (s := {0, 1, 2, 3}) (mem_spinSevenSupports.2 (by simp))
  have h₁ : (1 : ℝ) ∈ φ '' T := ⟨1, T.one_mem, by simp [hφ]⟩
  have h₂ : (-1 : ℝ) ∈ φ '' T := ⟨x, hle hxE, by simp [hφ, hx 0]⟩
  obtain ⟨t, htT, ht0⟩ :=
    (hT.image φ continuous_repr_spinVectorAction_negBasis_zero.continuousOn).Icc_subset h₂ h₁
      (show (0 : ℝ) ∈ Icc (-1) 1 from ⟨by norm_num, by norm_num⟩)
  exact hφT htT ht0

/-- **The elementary abelian subgroup of order `16` of `Spin(7)` lies in no preconnected
commutative subgroup.** -/
theorem not_realSpinSevenElementaryAbelian_le_of_isMulCommutative
    {T : Subgroup (realCliffordSpinGroup 7 0)} [IsMulCommutative T]
    (hT : IsPreconnected (T : Set (realCliffordSpinGroup 7 0))) :
    ¬realSpinSevenElementaryAbelian ≤ T := fun hle ↦
  not_realSpinSevenElementaryAbelian_le_of_le_centralizer hT
    (fun _ ht ↦ Subgroup.mem_centralizer_iff.2 fun _ hx ↦ setLike_mul_comm (hle hx) ht) hle

/-- **The elementary abelian subgroup of order `16` of `Spin(7)` lies in no torus**, although
`Spin(7)` is compact, connected and simply connected. -/
theorem not_realSpinSevenElementaryAbelian_le_of_isTorus
    {T : Subgroup (realCliffordSpinGroup 7 0)} (hT : Lie.IsTorus T) :
    ¬realSpinSevenElementaryAbelian ≤ T :=
  have := hT.isMulCommutative
  not_realSpinSevenElementaryAbelian_le_of_isMulCommutative hT.isConnected.isPreconnected

end TauCeti
