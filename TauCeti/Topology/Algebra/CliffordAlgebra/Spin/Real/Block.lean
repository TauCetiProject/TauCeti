public import TauCeti.Topology.Algebra.CliffordAlgebra.Spin.Compact
public import TauCeti.Topology.Algebra.CliffordAlgebra.Spin.Prod
public import TauCeti.Topology.Algebra.CliffordAlgebra.Spin.Real.Neg
