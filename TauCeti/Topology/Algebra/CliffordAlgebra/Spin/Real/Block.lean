/-!
# The compact block subgroup `K(p, q)` of `Spin(p, q)` as a topological group

The block homomorphism `CliffordAlgebra.realCliffordSpinBlockHom p q : Spin(p) × Spin(q) →*
Spin(p, q)` acts on the positive-definite block of the signature form through `Spin(p)` and on the
negative-definite block through `Spin(q)`. For positive `p` and `q` its kernel is generated by
`(-1, -1)`, so its image `K(p, q)` is algebraically `(Spin(p) × Spin(q)) / ⟨(-1, -1)⟩`
(`CliffordAlgebra.realCliffordSpinBlockQuotientEquiv`).

This file treats `K(p, q)` with the subspace topology from the Clifford algebra. The block
homomorphism is built from the topological Spin isomorphisms of isometries and of the negative
form and from the continuous Spin homomorphism of an orthogonal sum, so it is continuous. Its
source is a product of two compact groups, so `K(p, q)` is a compact, hence closed, subgroup of
`Spin(p, q)`, and a continuous bijection from the compact quotient onto the Hausdorff group
`K(p, q)` is a homeomorphism:

`(Spin(p) × Spin(q)) / ⟨(-1, -1)⟩ ≃ₜ* K(p, q)`.

Two low-rank cases are made explicit. In signature `(p, 1)` the factor `Spin(1) = {1, -1}`
contributes nothing new and `K(p, 1)` is a copy of `Spin(p)`, as a topological group; for `p = 2`
it is a copy of the circle `Spin(2)`. In signature `(1, 1)` the group `K(1, 1) = {1, -1}` has
order two, and it is a maximal compact subgroup of `Spin(1, 1)`: every element of `Spin(1, 1)` is
`±(cosh t + sinh t e₁e₂)`, and the powers of an element with `t ≠ 0` leave every compact set.

## Main definitions

* `CliffordAlgebra.realCliffordSpinBlockQuotientContinuousMulEquiv p q`: the isomorphism of
  topological groups `(Spin(p) × Spin(q)) / ⟨(-1, -1)⟩ ≃ₜ* K(p, q)`.
* `CliffordAlgebra.realCliffordSpinContinuousMulEquivBlockRange p`: the isomorphism of topological
  groups `Spin(p) ≃ₜ* K(p, 1)`.

## Main results

* `CliffordAlgebra.continuous_realCliffordSpinBlockHom`: the block homomorphism is continuous.
* `CliffordAlgebra.isCompact_range_realCliffordSpinBlockHom` and
  `CliffordAlgebra.isClosed_range_realCliffordSpinBlockHom`: `K(p, q)` is compact and closed in
  `Spin(p, q)`.
* `CliffordAlgebra.card_range_realCliffordSpinBlockHom_one_one`: `K(1, 1)` has two elements.
* `CliffordAlgebra.maximal_isCompact_range_realCliffordSpinBlockHom_one_one`: `K(1, 1)` is a
  maximal compact subgroup of `Spin(1, 1)`.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I §§2–3.
-/

public section

open QuadraticMap TauCeti

namespace CliffordAlgebra

variable (p q : ℕ)

/-- **The block homomorphism `Spin(p) × Spin(q) →* Spin(p, q)` is continuous** for the subspace
topologies from the Clifford algebras. -/
@[fun_prop]
theorem continuous_realCliffordSpinBlockHom : Continuous (realCliffordSpinBlockHom p q) := by
  have hneg : Continuous (realCliffordSpinGroupEquivNeg q 0) :=
    coe_realCliffordSpinGroupContinuousMulEquivNeg q 0 ▸ map_continuous _
  exact ((realCliffordBlockIsometry p q).symm.continuous_spinGroupEquiv.comp
    ((continuous_spinGroupProd _ _).comp (continuous_fst.prodMk (hneg.comp continuous_snd)))).congr
    fun x ↦ (realCliffordSpinBlockHom_apply p q x).symm

/-- **The block subgroup `K(p, q)` is compact**, as the continuous image of the compact group
`Spin(p) × Spin(q)`. -/
theorem isCompact_range_realCliffordSpinBlockHom :
    IsCompact ((realCliffordSpinBlockHom p q).range : Set (realCliffordSpinGroup p q)) := by
  rw [MonoidHom.coe_range]
  exact isCompact_range (continuous_realCliffordSpinBlockHom p q)

/-- The block subgroup `K(p, q)` is closed in `Spin(p, q)`. -/
theorem isClosed_range_realCliffordSpinBlockHom :
    IsClosed ((realCliffordSpinBlockHom p q).range : Set (realCliffordSpinGroup p q)) :=
  (isCompact_range_realCliffordSpinBlockHom p q).isClosed

/-- The block subgroup `K(p, q)`, with its subspace topology, is a compact space. -/
instance compactSpace_range_realCliffordSpinBlockHom :
    CompactSpace (realCliffordSpinBlockHom p q).range :=
  isCompact_iff_compactSpace.mp (isCompact_range_realCliffordSpinBlockHom p q)

variable [NeZero p] [NeZero q]

/-- The isomorphism `realCliffordSpinBlockQuotientEquiv p q` from the quotient of
`Spin(p) × Spin(q)` by `⟨(-1, -1)⟩` onto `K(p, q)` is continuous for the quotient topology. -/
theorem continuous_realCliffordSpinBlockQuotientEquiv :
    Continuous (realCliffordSpinBlockQuotientEquiv p q) :=
  (QuotientGroup.isQuotientMap_mk _).continuous_iff.mpr <|
    ((continuous_realCliffordSpinBlockHom p q).subtype_mk fun x ↦ ⟨x, rfl⟩).congr fun x ↦
      Subtype.ext (coe_realCliffordSpinBlockQuotientEquiv_mk p q x).symm

/-- **`K(p, q) ≅ (Spin(p) × Spin(q)) / ⟨(-1, -1)⟩` as topological groups.** For positive `p` and
`q`, the block homomorphism identifies the quotient group of `Spin(p) × Spin(q)` by the subgroup
generated by `(-1, -1)`, with the quotient topology, with its image `K(p, q)` in `Spin(p, q)`, with
the subspace topology. -/
noncomputable def realCliffordSpinBlockQuotientContinuousMulEquiv :
    (realCliffordSpinGroupZero p × realCliffordSpinGroupZero q) ⧸
        Subgroup.zpowers (spinGroup.negOne (realCliffordForm p 0)
          (nondegenerate_realCliffordForm p 0).ne_zero,
        spinGroup.negOne (realCliffordForm q 0) (nondegenerate_realCliffordForm q 0).ne_zero) ≃ₜ*
      (realCliffordSpinBlockHom p q).range where
  toMulEquiv := realCliffordSpinBlockQuotientEquiv p q
  continuous_toFun := continuous_realCliffordSpinBlockQuotientEquiv p q
  continuous_invFun :=
    (continuous_realCliffordSpinBlockQuotientEquiv p q).homeoOfEquivCompactToT2.symm.continuous

/-- `realCliffordSpinBlockQuotientContinuousMulEquiv p q` evaluates as
`realCliffordSpinBlockQuotientEquiv p q`. -/
@[simp]
theorem coe_realCliffordSpinBlockQuotientContinuousMulEquiv :
    ⇑(realCliffordSpinBlockQuotientContinuousMulEquiv p q) =
      realCliffordSpinBlockQuotientEquiv p q :=
  (rfl)

omit [NeZero q]

/-- The isomorphism `realCliffordSpinMulEquivBlockRange p` from `Spin(p)` onto `K(p, 1)` is
continuous. -/
theorem continuous_realCliffordSpinMulEquivBlockRange :
    Continuous (realCliffordSpinMulEquivBlockRange p) :=
  ((continuous_realCliffordSpinBlockHom p 1).comp (continuous_id.prodMk continuous_const)
    |>.subtype_mk fun x ↦ ⟨(x, 1), rfl⟩).congr fun x ↦
    Subtype.ext (coe_realCliffordSpinMulEquivBlockRange_apply p x).symm

/-- **`K(p, 1) ≅ Spin(p)` as topological groups.** In signature `(p, 1)` the map
`x ↦ realCliffordSpinBlockHom p 1 (x, 1)` is a homeomorphism from `Spin(p)` onto the block subgroup
`K(p, 1)`, with the subspace topology. -/
noncomputable def realCliffordSpinContinuousMulEquivBlockRange :
    realCliffordSpinGroupZero p ≃ₜ* (realCliffordSpinBlockHom p 1).range where
  toMulEquiv := realCliffordSpinMulEquivBlockRange p
  continuous_toFun := continuous_realCliffordSpinMulEquivBlockRange p
  continuous_invFun :=
    (continuous_realCliffordSpinMulEquivBlockRange p).homeoOfEquivCompactToT2.symm.continuous

/-- `realCliffordSpinContinuousMulEquivBlockRange p` evaluates as
`realCliffordSpinMulEquivBlockRange p`. -/
@[simp]
theorem coe_realCliffordSpinContinuousMulEquivBlockRange :
    ⇑(realCliffordSpinContinuousMulEquivBlockRange p) = realCliffordSpinMulEquivBlockRange p :=
  (rfl)

/-! ### Signature `(1, 1)` -/

/-- **`K(1, 1)` has two elements**: it is a copy of `Spin(1) = {1, -1}`. -/
theorem card_range_realCliffordSpinBlockHom_one_one :
    Nat.card (realCliffordSpinBlockHom 1 1).range = 2 := by
  rw [← Nat.card_congr (realCliffordSpinMulEquivBlockRange 1).toEquiv,
    ← Nat.card_congr (zmodTwoMulEquivSpinGroupOfFinrankEqOne (realCliffordForm 1 0)
      (nondegenerate_realCliffordForm 1 0) (Module.finrank_fin_fun ℝ)).toEquiv,
    Nat.card_eq_fintype_card, Fintype.card_multiplicative, ZMod.card]

/-- An element of `Spin(1, 1)` lying in a compact subgroup has rapidity zero: if
`x = ±(cosh t + sinh t e₁e₂)` lies in a compact subgroup, then `t = 0`, because the rapidity of `xⁿ`
is `n t`. -/
private theorem realCliffordSpinOneOneEquiv_symm_snd_eq_one_of_isCompact
    {C : Subgroup (realCliffordSpinGroup 1 1)}
    (hC : IsCompact (C : Set (realCliffordSpinGroup 1 1)))
    {x : realCliffordSpinGroup 1 1} (hx : x ∈ C) :
    (realCliffordSpinOneOneEquiv.symm x).2 = 1 := by
  set r : realCliffordSpinGroup 1 1 → ℝ := fun y ↦ (realCliffordSpinOneOneEquiv.symm y).2.toAdd
  have hr : Continuous r :=
    (continuous_toAdd.comp (continuous_snd.comp
      (map_continuous realCliffordSpinOneOneContinuousMulEquiv.symm))).congr fun y ↦ by
      simp only [r, Function.comp_apply, coe_realCliffordSpinOneOneContinuousMulEquiv_symm]
  have hpow (n : ℕ) (y : realCliffordSpinGroup 1 1) : r (y ^ n) = n * r y := by
    simp [r, Prod.pow_snd, toAdd_pow, nsmul_eq_mul]
  have hinv (y : realCliffordSpinGroup 1 1) : r y⁻¹ = -r y := by
    simp [r, toAdd_inv]
  obtain ⟨M, hM⟩ := (hC.image hr).bddAbove
  have hle (y : realCliffordSpinGroup 1 1) (hy : y ∈ C) (n : ℕ) : n * r y ≤ M :=
    hpow n y ▸ hM ⟨y ^ n, pow_mem hy n, rfl⟩
  suffices r x = 0 from Multiplicative.toAdd.injective (this.trans toAdd_one.symm)
  by_contra h
  -- one of `x` and `x⁻¹` has positive rapidity, whose multiples are unbounded
  obtain ⟨y, hy, hpos⟩ : ∃ y ∈ C, 0 < r y := by
    rcases lt_or_gt_of_ne h with h | h
    · exact ⟨x⁻¹, inv_mem hx, by rw [hinv]; linarith⟩
    · exact ⟨x, hx, h⟩
  obtain ⟨n, hn⟩ := exists_nat_gt (M / r y)
  exact absurd (hle y hy n) (not_le.mpr ((div_lt_iff₀ hpos).mp hn))

/-- **`K(1, 1)` is a maximal compact subgroup of `Spin(1, 1)`.** Every compact subgroup consists of
elements `±(cosh t + sinh t e₁e₂)` with `t = 0`, that is, of `1` and `-1`, and both lie in
`K(1, 1)`. -/
theorem maximal_isCompact_range_realCliffordSpinBlockHom_one_one :
    Maximal (fun C : Subgroup (realCliffordSpinGroup 1 1) ↦
      IsCompact (C : Set (realCliffordSpinGroup 1 1))) (realCliffordSpinBlockHom 1 1).range := by
  refine ⟨isCompact_range_realCliffordSpinBlockHom 1 1, fun C hC _ x hx ↦ ?_⟩
  obtain ⟨⟨ζ, t⟩, rfl⟩ := realCliffordSpinOneOneEquiv.surjective x
  have ht : t = 1 := by
    simpa using realCliffordSpinOneOneEquiv_symm_snd_eq_one_of_isCompact hC hx
  subst ht
  have hζ : ((ζ : ℝˣ) : ℝ) = 1 ∨ ((ζ : ℝˣ) : ℝ) = -1 := by
    refine mul_self_eq_one_iff.mp ?_
    rw [← Units.val_mul, ← _root_.sq, (mem_rootsOfUnity 2 (ζ : ℝˣ)).mp ζ.property,
      Units.val_one]
  rcases hζ with hζ | hζ
  · rw [show realCliffordSpinOneOneEquiv (ζ, 1) = 1 from
      Subtype.ext (by simp [hζ, OneMemClass.coe_one])]
    exact one_mem _
  · refine ⟨(spinGroup.negOne _ (nondegenerate_realCliffordForm 1 0).ne_zero, 1), ?_⟩
    rw [realCliffordSpinBlockHom_negOne_one]
    exact Subtype.ext (by simp [hζ])

end CliffordAlgebra
