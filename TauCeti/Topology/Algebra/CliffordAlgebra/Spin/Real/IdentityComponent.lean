module

public import TauCeti.Topology.Algebra.CliffordAlgebra.Spin.Real.Connected
public import TauCeti.Topology.Algebra.CliffordAlgebra.Spin.Real.OneOne
public import TauCeti.Topology.Algebra.CliffordAlgebra.Spin.SpinorNorm
import TauCeti.FieldTheory.SquareClassGroup.Real
import TauCeti.Topology.Algebra.Group.Units.Real
import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Kernel

/-!
# The image of `Spin(p, q)` is the identity component of `SO(p, q)`

For a nondegenerate quadratic form `Q` on a finite-dimensional real vector space, the image of
the Spin group in `SO(Q)` is the kernel of the spinor norm, which over `ℝ` is the norm-sign
character `SO(Q) → ℝˣ ⧸ (ℝˣ)² ≅ {±1}`. Since the positive reals are open in `ℝˣ`, this kernel is
an open subgroup, so it contains the identity component of `SO(Q)`. Conversely the image of the
identity component of the Spin group is connected, and the kernel `{±1}` of the Spin action is
mapped to `1`; so whenever these two generate the Spin group, the image is exactly the identity
component.

This holds in every real signature `(p, q)` with `p + q ≥ 2`:

* if `2 ≤ p` or `2 ≤ q`, then `Spin(p, q)` is path-connected
  (`CliffordAlgebra.pathConnectedSpace_realCliffordSpinGroup`), more generally the Spin group of
  any real form that is definite on some plane;
* `Spin(1, 1)` has two components, but every element is `±1` times a hyperbolic rotation, and
  the hyperbolic rotations form its identity component
  (`CliffordAlgebra.connectedComponentOfOne_realCliffordSpinGroup_one_one`).

Thus the identity component `SO₀(p, q)` is both the image of `Spin(p, q)` and the kernel of the
norm-sign character. In the positive definite signature the Spin action is moreover onto `SO(Q)`
(`CliffordAlgebra.spinToSpecialOrthogonal_surjective_of_posDef`), while in an indefinite signature
the spinor norm is onto (`CliffordAlgebra.spinorNorm_surjective_of_indefinite`), so there
`SO₀(p, q)` is a proper subgroup of `SO(p, q)`.

For `SO(p, q)` the statements use the coordinate topology that `Fin (p + q) → ℝ` gives it, which
is the topology `SO(p, q)` carries by instance resolution.

## Main results

* `CliffordAlgebra.range_spinToSpecialOrthogonal_eq_connectedComponentOfOne_of_isOrtho`,
  `CliffordAlgebra.ker_spinorNorm_eq_connectedComponentOfOne_of_isOrtho`: for a real form that is
  definite on some plane, the image of Spin and the spinor kernel are the identity component of
  `SO(Q)`.
* `CliffordAlgebra.range_spinToSpecialOrthogonal_realCliffordForm_eq_connectedComponentOfOne`:
  the image of `Spin(p, q)` is the identity component `SO₀(p, q)` as soon as `p + q ≥ 2`.
* `CliffordAlgebra.ker_spinorNorm_realCliffordForm_eq_connectedComponentOfOne`: the norm-sign
  kernel of `SO(p, q)` is its identity component as soon as `p + q ≥ 2`.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, §2.
-/

public section

namespace CliffordAlgebra

open TauCeti

section IsOrtho

variable {V : Type*} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
  {Q : QuadraticForm ℝ V}

/-- **The image of Spin is the identity component of `SO(Q)`** for a nondegenerate real quadratic
form with two orthogonal vectors whose norms are nonzero of the same sign. -/
theorem range_spinToSpecialOrthogonal_eq_connectedComponentOfOne_of_isOrtho
    (hQ : Q.Nondegenerate) {e f : V} (hef : Q.IsOrtho e f) (h : 0 < Q e * Q f) :
    (spinToSpecialOrthogonal Q).range =
      Subgroup.connectedComponentOfOne (QuadraticMap.specialOrthogonalGroup Q) := by
  -- The topology of the Spin group does not depend on one on `V`; the module topology serves.
  let _ : TopologicalSpace V := moduleTopology ℝ V
  have : IsModuleTopology ℝ V := ⟨rfl⟩
  have := pathConnectedSpace_spinGroup_of_isOrtho hef h
  exact range_spinToSpecialOrthogonal_eq_connectedComponentOfOne Q hQ
    (Units.square_eq_posSubgroup_real ▸ Units.isOpen_posSubgroup_real) (by simp)

/-- **The spinor kernel of `SO(Q)` is its identity component** for a nondegenerate real quadratic
form with two orthogonal vectors whose norms are nonzero of the same sign. -/
theorem ker_spinorNorm_eq_connectedComponentOfOne_of_isOrtho
    (hQ : Q.Nondegenerate) {e f : V} (hef : Q.IsOrtho e f) (h : 0 < Q e * Q f) :
    (spinorNorm Q hQ).ker =
      Subgroup.connectedComponentOfOne (QuadraticMap.specialOrthogonalGroup Q) := by
  rw [← range_spinToSpecialOrthogonal_eq_ker_spinorNorm Q hQ,
    range_spinToSpecialOrthogonal_eq_connectedComponentOfOne_of_isOrtho hQ hef h]

end IsOrtho

/-- `Spin(1, 1)` is generated by its identity component, the hyperbolic rotations, and the kernel
`{±1}` of its action. -/
private theorem connectedComponentOfOne_sup_ker_realCliffordSpinGroup_one_one :
    Subgroup.connectedComponentOfOne (realCliffordSpinGroup 1 1) ⊔
      (spinToSpecialOrthogonal (realCliffordForm 1 1)).ker = ⊤ := by
  refine eq_top_iff.mpr fun x _ ↦ ?_
  obtain ⟨⟨ζ, t⟩, rfl⟩ := realCliffordSpinOneOneEquiv.surjective x
  have hx : realCliffordSpinOneOneEquiv (ζ, t) =
      realCliffordSpinOneOneEquiv (1, t) * realCliffordSpinOneOneEquiv (ζ, 1) := by
    rw [← map_mul, Prod.mk_mul_mk, one_mul, mul_one]
  rw [hx]
  refine Subgroup.mul_mem_sup ?_ ?_
  · rw [connectedComponentOfOne_realCliffordSpinGroup_one_one, realCliffordSpinOneOneEquiv_one_mk]
    exact ⟨t, rfl⟩
  · exact mem_ker_spinToSpecialOrthogonal_of_coe_eq_algebraMap _ _ (r := ((ζ : ℝˣ) : ℝ))
      (by simp [coe_realCliffordSpinOneOneEquiv_apply])

/-- `Spin(p, q)` is generated by its identity component and the kernel `{±1}` of its action as
soon as `p + q ≥ 2`. -/
private theorem connectedComponentOfOne_sup_ker_realCliffordSpinGroup {p q : ℕ}
    (h : 2 ≤ p + q) :
    Subgroup.connectedComponentOfOne (realCliffordSpinGroup p q) ⊔
      (spinToSpecialOrthogonal (realCliffordForm p q)).ker = ⊤ := by
  rcases (by omega : 2 ≤ p ∨ 2 ≤ q ∨ (p = 1 ∧ q = 1)) with hpq | hpq | ⟨rfl, rfl⟩
  · have := pathConnectedSpace_realCliffordSpinGroup (q := q) (Or.inl hpq)
    simp
  · have := pathConnectedSpace_realCliffordSpinGroup (p := p) (Or.inr hpq)
    simp
  · exact connectedComponentOfOne_sup_ker_realCliffordSpinGroup_one_one

/-- **The image of `Spin(p, q)` is the identity component `SO₀(p, q)`** as soon as `p + q ≥ 2`,
for the coordinate topology on `SO(p, q)`. -/
theorem range_spinToSpecialOrthogonal_realCliffordForm_eq_connectedComponentOfOne {p q : ℕ}
    (h : 2 ≤ p + q) :
    (spinToSpecialOrthogonal (realCliffordForm p q)).range =
      Subgroup.connectedComponentOfOne
        (QuadraticMap.specialOrthogonalGroup (realCliffordForm p q)) := by
  -- The range is open for the subspace topology from the linear automorphisms, hence for the
  -- coordinate topology, which is at least as fine.
  obtain ⟨U, hU, hUrange⟩ := isOpen_induced_iff.mp (isOpen_range_spinToSpecialOrthogonal _
    (nondegenerate_realCliffordForm p q)
    (Units.square_eq_posSubgroup_real ▸ Units.isOpen_posSubgroup_real))
  refine MonoidHom.range_eq_connectedComponentOfOne (continuous_spinToSpecialOrthogonal_pi _) ?_
    (connectedComponentOfOne_sup_ker_realCliffordSpinGroup h)
  rw [← hUrange]
  exact hU.preimage (QuadraticMap.continuous_coe_specialOrthogonalGroup_pi _)

/-- **The norm-sign kernel of `SO(p, q)` is its identity component** as soon as `p + q ≥ 2`, for
the coordinate topology on `SO(p, q)`. -/
theorem ker_spinorNorm_realCliffordForm_eq_connectedComponentOfOne {p q : ℕ} (h : 2 ≤ p + q) :
    (spinorNorm (realCliffordForm p q) (nondegenerate_realCliffordForm p q)).ker =
      Subgroup.connectedComponentOfOne
        (QuadraticMap.specialOrthogonalGroup (realCliffordForm p q)) := by
  rw [← range_spinToSpecialOrthogonal_eq_ker_spinorNorm,
    range_spinToSpecialOrthogonal_realCliffordForm_eq_connectedComponentOfOne h]

end CliffordAlgebra
