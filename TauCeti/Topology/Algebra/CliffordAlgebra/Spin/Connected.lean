module

public import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Generation
public import TauCeti.Topology.Algebra.CliffordAlgebra.Spin.ReflectionPair
public import TauCeti.Topology.Algebra.QuadraticForm.Complex

/-!
# Path-connectedness of Spin groups

The Spin group of a nondegenerate quadratic space is generated by the scalar `-1` and by lifts of
products of two reflections. When every anisotropic vector can be rescaled to a unit vector and the
unit level `{v | Q v = 1}` is path-connected, all of these generators lie in the identity path
component. Indeed a path from `v` to `w` in the unit level gives a path from `1 = ι v * ι v` to
`ι v * ι w`, and taking `w = -v` reaches `-1`. The Spin group is then path-connected.

Both hypotheses hold for the positive-definite real form in dimension at least two, whose unit
level is the Euclidean sphere, and for every nondegenerate complex form in dimension at least two,
where every scalar is a square and the unit level is a complex quadric. In dimension one both
Spin groups are `{±1}`, so the dimension bounds are sharp.

## Main results

* `CliffordAlgebra.pathConnectedSpace_spinGroup_of_isPathConnected`: the Spin group is
  path-connected when every anisotropic value of `Q` is a square and the unit level of `Q` is
  path-connected.
* `CliffordAlgebra.pathConnectedSpace_realCliffordSpinGroupZero_add_two`: every compact real Spin
  group of dimension at least two is path-connected.
* `CliffordAlgebra.pathConnectedSpace_spinGroup_of_two_le_finrank`: the Spin group of a
  nondegenerate complex quadratic space of dimension at least two is path-connected.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, Sections 2 and 6.
-/

public section

namespace CliffordAlgebra

open Module TauCeti

universe u v

section Criterion

variable {K : Type u} {V : Type v} [Field K] [TopologicalSpace K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] [Invertible (2 : K)] [TopologicalSpace V] [IsModuleTopology K V]
  {Q : QuadraticForm K V} [ContinuousMul (CliffordAlgebra Q)]

/-- A nondegenerate Spin group is path-connected when every anisotropic value of the quadratic form
is a square, so that every anisotropic vector rescales to a unit vector, and the unit level
`{v | Q v = 1}` is path-connected. -/
theorem pathConnectedSpace_spinGroup_of_isPathConnected (hQ : Q.Nondegenerate)
    (hsq : ∀ v, Q v ≠ 0 → IsSquare (Q v)) (hconn : IsPathConnected {v | Q v = 1}) :
    PathConnectedSpace (spinGroup Q) := by
  obtain ⟨u, hu : Q u = 1⟩ := hconn.nonempty
  have hu' : Q (-u) = 1 := by rwa [QuadraticMap.map_neg]
  have _ : Nontrivial V := ⟨u, 0, by rintro rfl; simp at hu⟩
  let H := Subgroup.pathComponentOne (spinGroup Q)
  -- A path between unit vectors joins their reflection-pair lift to the identity.
  have hpair (v w : V) (hv : Q v = 1) (hw : Q w = 1) : spinReflectionPair Q v w hv hw ∈ H :=
    mem_pathComponent_iff.mpr <| joined_one_spinReflectionPair_of_joined v w hv hw
      (hconn.joinedIn v hv w hw).joined_subtype
  have hH : H = ⊤ := by
    apply subgroup_eq_top_of_negOne_mem_of_reflection_pair_lift_mem Q hQ H
    · convert hpair u (-u) hu hu' using 1
      ext1
      simp [ι_sq_scalar, hu]
    · intro v w _ _
      -- Rescale `v` and `w` to unit vectors; this does not change their reflections.
      have hunit (x : V) [Invertible (Q x)] : ∃ a : K, ∃ _ : Invertible a, Q (a • x) = 1 := by
        obtain ⟨b, hb⟩ := hsq x (isUnit_of_invertible (Q x)).ne_zero
        have hb0 : b ≠ 0 := by
          rintro rfl
          exact (isUnit_of_invertible (Q x)).ne_zero (by rw [hb, mul_zero])
        refine ⟨b⁻¹, invertibleOfNonzero (inv_ne_zero hb0), ?_⟩
        rw [QuadraticMap.map_smul, smul_eq_mul, hb]
        field_simp
      have hrefl (x : V) [Invertible (Q x)] (a : K) [Invertible a] [Invertible (Q (a • x))] :
          QuadraticMap.reflection Q (a • x) = QuadraticMap.reflection Q x := by
        -- `reflection_smul_eq` builds its own instance for `Q (a • x)`; the two instances are
        -- propositionally equal, so align them through the subsingleton instance proof.
        convert QuadraticMap.reflection_smul_eq Q x a using 1
        congr 1
        exact Subsingleton.elim _ _
      obtain ⟨a, _, hv⟩ := hunit v
      obtain ⟨b, _, hw⟩ := hunit w
      let _ : Invertible (Q (a • v)) := hv.symm ▸ invertibleOne
      let _ : Invertible (Q (b • w)) := hw.symm ▸ invertibleOne
      refine ⟨spinReflectionPair Q (a • v) (b • w) hv hw, hpair _ _ hv hw, ?_⟩
      rw [coe_spinToSpecialOrthogonal_spinReflectionPair]
      simp only [Subgroup.coe_mul, QuadraticMap.coe_reflectionOrthogonal]
      rw [hrefl v a, hrefl w b]
  apply pathConnectedSpace_iff_eq.mpr
  refine ⟨1, ?_⟩
  simpa only [H, Subgroup.coe_pathComponentOne] using Subgroup.coe_eq_univ.mpr hH

end Criterion

/-- The compact real Spin group is path-connected in every dimension at least two. -/
theorem pathConnectedSpace_realCliffordSpinGroupZero_add_two (n : ℕ) :
    PathConnectedSpace (realCliffordSpinGroupZero (n + 2)) := by
  have hQ := posDef_realCliffordForm_zero (n + 2)
  refine pathConnectedSpace_spinGroup_of_isPathConnected hQ.anisotropic.nondegenerate
    (fun v hv ↦ ?_) ?_
  · have hpos : 0 < realCliffordForm (n + 2) 0 v :=
      hQ v fun h ↦ hv (by rw [h, QuadraticMap.map_zero])
    exact ⟨_, (Real.mul_self_sqrt hpos.le).symm⟩
  · have _ := pathConnectedSpace_realCliffordUnitLevel_add_two n
    exact isPathConnected_iff_pathConnectedSpace.mpr
      (realCliffordUnitLevelHomeomorphSubtype (n + 2)).pathConnectedSpace

/-- **The complex Spin groups are path-connected.** The Spin group of a nondegenerate quadratic
form on a complex vector space of dimension at least two is path-connected. -/
theorem pathConnectedSpace_spinGroup_of_two_le_finrank {V : Type v} [AddCommGroup V]
    [Module ℂ V] [FiniteDimensional ℂ V] {Q : QuadraticForm ℂ V} (hQ : Q.Nondegenerate)
    (hV : 2 ≤ finrank ℂ V) : PathConnectedSpace (spinGroup Q) := by
  let _ : TopologicalSpace V := moduleTopology ℂ V
  have _ : IsModuleTopology ℂ V := ⟨rfl⟩
  exact pathConnectedSpace_spinGroup_of_isPathConnected hQ
    (fun v _ ↦ IsAlgClosed.isSquare (Q v))
    (QuadraticForm.isPathConnected_setOf_apply_eq hQ hV 1)

end CliffordAlgebra
