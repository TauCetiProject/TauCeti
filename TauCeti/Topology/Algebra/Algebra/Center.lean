module

public import Mathlib.Topology.Algebra.Algebra
public import Mathlib.Topology.UniformSpace.UniformEmbedding
public import TauCeti.Topology.Algebra.Group.Basic

/-!
# Centers of topological algebras

In a Hausdorff semigroup with separately continuous multiplication the center is the centralizer
of everything, so it is closed (`Set.isClosed_center`, in `TauCeti.Topology.Algebra.Group.Basic`).
For a topological algebra `A` over a commutative semiring `R` this has two consequences used to
study centers of completions:

* the center `Subalgebra.center R A` of a complete algebra is complete;
* centrality is detected on a set of topological generators: if the subalgebra generated by `s` is
  dense, an element is central as soon as it commutes with every element of `s`
  (`Subalgebra.mem_center_iff_forall_commute_of_topologicalClosure_adjoin_eq_top`). In particular
  an algebra map with dense range sends the center into the center
  (`Subalgebra.map_center_le_center_of_denseRange`).

These are the continuous counterparts of Mathlib's `Subalgebra.centralizer` lemmas, built on
`Set.isClosed_centralizer` and `Subalgebra.topologicalClosure_adjoin_le_centralizer_centralizer`.
-/

public section

namespace Subalgebra

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R A] [TopologicalSpace A]

variable (R A) in
/-- The center of a Hausdorff algebra with separately continuous multiplication is closed. -/
theorem isClosed_center [SeparatelyContinuousMul A] [T2Space A] :
    IsClosed (center R A : Set A) :=
  Set.isClosed_center A

/-- The center of a complete Hausdorff algebra with separately continuous multiplication is
complete. -/
instance {A : Type*} [Semiring A] [Algebra R A] [UniformSpace A] [CompleteSpace A]
    [SeparatelyContinuousMul A] [T2Space A] : CompleteSpace (center R A) :=
  (isClosed_center R A).completeSpace_coe

/-- **Centrality is detected on topological generators.** If the subalgebra generated by `s` is
dense in a Hausdorff algebra with separately continuous multiplication, an element is central
exactly when it commutes with every element of `s`. -/
theorem mem_center_iff_forall_commute_of_topologicalClosure_adjoin_eq_top
    [IsSemitopologicalSemiring A] [T2Space A] {s : Set A}
    (hs : (Algebra.adjoin R s).topologicalClosure = ⊤) {z : A} :
    z ∈ center R A ↔ ∀ x ∈ s, Commute x z := by
  refine ⟨fun hz x _ ↦ mem_center_iff.1 hz x, fun h ↦ mem_center_iff.2 fun b ↦ ?_⟩
  -- `b` lies in the closure of the subalgebra generated by `s`, which commutes with everything
  -- commuting with `s`.
  have hb : b ∈ (Algebra.adjoin R s).topologicalClosure := hs ▸ Algebra.mem_top
  exact (topologicalClosure_adjoin_le_centralizer_centralizer R s hb z
    fun x hx ↦ (h x hx).eq).symm

/-- An algebra map with dense range into a Hausdorff algebra with separately continuous
multiplication sends the center into the center. -/
theorem map_center_le_center_of_denseRange {B : Type*} [Semiring B] [Algebra R B]
    [SeparatelyContinuousMul A] [T2Space A] (f : B →ₐ[R] A) (hf : DenseRange f) :
    (center R B).map f ≤ center R A := by
  rintro _ ⟨b, hb, rfl⟩
  -- The centralizer of `f b` is closed and contains the dense range of `f`.
  have h : Set.range f ⊆ Set.centralizer {f b} := by
    rintro _ ⟨c, rfl⟩ _ rfl
    rw [← map_mul, ← map_mul, mem_center_iff.1 hb c]
  refine mem_center_iff.2 fun x ↦ ?_
  have hx :=
    (Set.isClosed_centralizer {f b}).closure_subset_iff.2 h (hf.closure_eq ▸ Set.mem_univ x)
  exact (hx (f b) rfl).symm

end Subalgebra
