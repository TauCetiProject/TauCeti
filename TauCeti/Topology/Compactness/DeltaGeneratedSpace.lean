module

public import Mathlib.Topology.Compactness.DeltaGeneratedSpace
public import Mathlib.Topology.MetricSpace.Pseudo.Pi
public import Mathlib.Topology.Order.ProjIcc

/-!
# Delta-generated empty spaces and closed balls

A topological space is delta-generated (Mathlib's `DeltaGeneratedSpace`) when its topology is
coinduced by all continuous maps from the spaces `Fin n → ℝ`. This file adds two families of
examples to the ones Mathlib provides.

* Every empty space is generated by any family of spaces, in particular delta-generated
  (`TauCeti.instIsGeneratedByOfIsEmpty`).
* Every closed ball of `Fin n → ℝ`, with its sup metric, is delta-generated
  (`TauCeti.instDeltaGeneratedSpaceClosedBall`). A nonempty closed ball is a box, a product of
  closed intervals, and clamping each coordinate into its interval is a continuous retraction of
  `Fin n → ℝ` onto it. A retraction is a quotient map, and quotients of delta-generated spaces are
  delta-generated.

The closed unit balls of `Fin n → ℝ` are the domains of the characteristic maps of a classical CW
complex, so this is the input for showing that CW complexes are delta-generated, in
`TauCeti.Topology.CWComplex.Classical.DeltaGenerated`.
-/

public section

open Metric Set Topology

namespace TauCeti

/-- **An empty space is generated by any family of spaces**: it has only one topology. -/
instance instIsGeneratedByOfIsEmpty {ι : Type*} (X : ι → Type*)
    [∀ i, TopologicalSpace (X i)] (Y : Type*) [TopologicalSpace Y] [IsEmpty Y] :
    IsGeneratedBy X Y :=
  IsGeneratedBy.iff_le_generatedBy.2 fun U _ ↦ by simp [Set.eq_empty_of_isEmpty U]

/-- **A closed ball of `Fin n → ℝ` is delta-generated.** This holds for every closed ball for the
sup metric, including an empty one. -/
instance instDeltaGeneratedSpaceClosedBall {n : ℕ} (x : Fin n → ℝ) (r : ℝ) :
    DeltaGeneratedSpace (closedBall x r) := by
  rcases lt_or_ge r 0 with hr | hr
  · have : IsEmpty (closedBall x r) := by simp [closedBall_eq_empty.2 hr]
    infer_instance
  have hle (i : Fin n) : x i - r ≤ x i + r := by linarith
  have hball : closedBall x r = univ.pi fun i ↦ Icc (x i - r) (x i + r) := by
    simp [closedBall_pi x hr, Real.closedBall_eq_Icc]
  -- Clamping every coordinate into its interval retracts `Fin n → ℝ` onto the ball.
  let ρ : (Fin n → ℝ) → closedBall x r := fun y ↦
    ⟨fun i ↦ projIcc (x i - r) (x i + r) (hle i) (y i),
      hball ▸ fun i _ ↦ (projIcc (x i - r) (x i + r) (hle i) (y i)).2⟩
  have hρ : Continuous ρ :=
    (continuous_pi fun i ↦ continuous_subtype_val.comp
      ((continuous_projIcc (h := hle i)).comp (continuous_apply i))).subtype_mk _
  refine (IsQuotientMap.of_inverse continuous_subtype_val hρ fun z ↦ ?_).isGeneratedBy
  have hz : (z : Fin n → ℝ) ∈ univ.pi fun i ↦ Icc (x i - r) (x i + r) := hball ▸ z.2
  ext i
  exact congrArg Subtype.val (projIcc_of_mem (hle i) (hz i (mem_univ i)))

end TauCeti
