module

public import Mathlib.Topology.Compactness.CompactlyGeneratedSpace
public import Mathlib.Topology.Convenient.GeneratedBy

/-!
# Compact Hausdorff generation as generation by a family

Mathlib's compactly generated topology is the topology generated by the family of compact
Hausdorff spaces. This instance connects the native `UCompactlyGeneratedSpace` API to the
general generated-space universal property, with the same universe of test spaces.
-/

public section

open Topology

namespace TauCeti

/-- A space compactly generated using tests in universe `u` is generated by that same family
in Mathlib's general generated-space API. -/
instance {Y : Type v} [TopologicalSpace Y] [UCompactlyGeneratedSpace.{u} Y] :
    IsGeneratedBy (fun S : CompHaus.{u} ↦ (S : Type u)) Y := by
  rw [IsGeneratedBy.iff_le_generatedBy, TopologicalSpace.generatedBy_eq_coinduced]
  exact UCompactlyGeneratedSpace.le_compactlyGenerated

end TauCeti
