/-!
# The inverse topology of a spectral space

The *inverse topology* (or Hochster dual topology) of a topological space `X` is the topology
generated by the complements of the quasi-compact open subsets of `X`. On a spectral space it is
again spectral, it reverses specialization, and its quasi-compact open subsets are exactly the
complements of the quasi-compact open subsets of `X`. Consequently passing to the inverse topology
is an involution on spectral topologies, it does not change the constructible (patch) topology,
and a map between spectral spaces is spectral exactly when it is spectral for the inverse
topologies.

Hochster duality turns statements about generalizations in a spectral space into statements about
specializations, and lets proofs about closed or pro-constructible subsets be applied to their
duals.

Most results below hold for compact, quasi-sober, quasi-separated prespectral spaces, that is,
for spectral spaces up to the T₀ axiom; spectrality of the inverse topology itself also uses T₀.

## Main definitions

* `TauCeti.inverseTopology X`: the topology on `X` generated by the closed subsets with
  quasi-compact open complement.

## Main results

* `TauCeti.specializes_inverseTopology_iff`: on a prespectral space, `x` specializes to `y` for
  the inverse topology if and only if `y` specializes to `x`.
* `TauCeti.isOpen_and_isCompact_inverseTopology_iff`: the quasi-compact open subsets of the inverse
  topology are the complements of the quasi-compact open subsets.
* `TauCeti.spectralSpace_inverseTopology`: the inverse topology of a spectral space is spectral.
* `TauCeti.inverseTopology_inverseTopology`: the inverse topology of the inverse topology is the
  original topology.
* `TauCeti.constructibleTopology_inverseTopology`: the inverse topology has the same constructible
  topology as the original one.
* `TauCeti.isSpectralMap_inverseTopology_iff`: a map is spectral if and only if it is spectral for
  the inverse topologies.

## Implementation notes

Spectrality and the description of the quasi-compact opens come from the patch criterion
`TauCeti.spectralSpace_of_isClopen_generateFrom` (Wedhorn, Proposition 3.31), applied with the
constructible topology as compact witness topology: the generators of the inverse topology are
clopen for it. The other statements are deduced from the description of the quasi-compact opens.

## References

* M. Hochster, *Prime ideal structure in commutative rings*, Trans. Amer. Math. Soc. 142 (1969),
  43–60, Proposition 8.
* K. Kedlaya, R. Liu, *Relative p-adic Hodge theory: foundations*, Astérisque 371 (2015),
  Definition 8.1.4.
* T. Wedhorn, *Adic Spaces*, arXiv:1910.05934v1, Proposition 3.31.
-/

public section

namespace TauCeti

open Set Topology TopologicalSpace

variable {X Y : Type*}

section General

variable (X) [TopologicalSpace X]

/-- The *inverse topology* (Hochster dual topology) of a topological space `X`: the topology
generated by the closed subsets whose complement is quasi-compact, that is, by the complements of
the quasi-compact open subsets of `X`. -/
@[instance_reducible]
def inverseTopology : TopologicalSpace X :=
  generateFrom {s | IsClosed s ∧ IsCompact sᶜ}

theorem inverseTopology_def :
    inverseTopology X = generateFrom {s | IsClosed s ∧ IsCompact sᶜ} :=
  (rfl)

/-- The constructible topology refines the inverse topology. -/
theorem constructibleTopology_le_inverseTopology :
    constructibleTopology X ≤ inverseTopology X :=
  le_generateFrom fun _ hs ↦ isOpen_generateFrom_of_mem (Or.inr hs)

variable {X}

/-- A closed subset with quasi-compact complement is open in the inverse topology. -/
theorem isOpen_inverseTopology_of_isClosed {s : Set X} (hs : IsClosed s) (hc : IsCompact sᶜ) :
    IsOpen[inverseTopology X] s :=
  isOpen_generateFrom_of_mem ⟨hs, hc⟩

/-- An open subset of the inverse topology is stable under specialization for the original
topology. -/
theorem stableUnderSpecialization_of_isOpen_inverseTopology {s : Set X}
    (hs : IsOpen[inverseTopology X] s) : StableUnderSpecialization s := by
  induction hs with
  | basic s hs => exact hs.1.stableUnderSpecialization
  | univ => exact stableUnderSpecialization_univ
  | inter s t _ _ hs ht =>
    rw [← sInter_pair]
    exact stableUnderSpecialization_sInter _ (by rintro u (rfl | rfl) <;> assumption)
  | sUnion S _ hS => exact stableUnderSpecialization_sUnion S hS

/-- **The inverse topology reverses specialization.** On a prespectral space, `x` specializes to
`y` for the inverse topology if and only if `y` specializes to `x`. -/
@[simp]
theorem specializes_inverseTopology_iff [PrespectralSpace X] {x y : X} :
    @Specializes X (inverseTopology X) x y ↔ y ⤳ x := by
  constructor
  · -- A quasi-compact open subset containing `x` but not `y` has a complement that is open in
    -- the inverse topology and contains `y` but not `x`.
    intro h
    by_contra hyx
    obtain ⟨U, hUo, hUc, hxU, hyU⟩ :=
      PrespectralSpace.not_specializes_iff_exists_isOpen_isCompact.1 hyx
    exact @Specializes.mem_open X (inverseTopology X) _ _ _ h
      (isOpen_inverseTopology_of_isClosed hUo.isClosed_compl (by rwa [compl_compl])) hyU hxU
  · exact fun h ↦ @specializes_iff_forall_open X (inverseTopology X) x y |>.2 fun _ hs hy ↦
      stableUnderSpecialization_of_isOpen_inverseTopology hs h hy

/-- The inverse topology of a T₀ prespectral space is T₀. -/
theorem t0Space_inverseTopology [T0Space X] [PrespectralSpace X] :
    @T0Space X (inverseTopology X) := by
  refine (@t0Space_iff_inseparable X (inverseTopology X)).2 fun x y h ↦ ?_
  rw [@inseparable_iff_specializes_and X (inverseTopology X), specializes_inverseTopology_iff,
    specializes_inverseTopology_iff] at h
  exact (inseparable_iff_specializes_and.2 h.symm).eq

end General

section Spectral

variable [tX : TopologicalSpace X] [CompactSpace X] [QuasiSober X] [PrespectralSpace X]
  [QuasiSeparatedSpace X]

/-- The inverse topology of a compact, quasi-sober, quasi-separated prespectral space is
compact. -/
theorem compactSpace_inverseTopology : @CompactSpace X (inverseTopology X) :=
  compactSpace_of_isOpen_generateFrom (t := inverseTopology X) (inverseTopology_def X)
    (compactSpace_constructibleTopology X)
    fun _ hs ↦ hs.2.isOpen_constructibleTopology_of_isClosed hs.1

/-- The inverse topology of a compact, quasi-sober, quasi-separated prespectral space is
quasi-sober. -/
theorem quasiSober_inverseTopology : @QuasiSober X (inverseTopology X) :=
  quasiSober_of_isClopen_generateFrom (t := inverseTopology X) (inverseTopology_def X)
    (compactSpace_constructibleTopology X)
    fun _ hs ↦ hs.2.isClopen_constructibleTopology_of_isClosed hs.1

/-- The inverse topology of a compact, quasi-sober, quasi-separated prespectral space is
prespectral. -/
theorem prespectralSpace_inverseTopology : @PrespectralSpace X (inverseTopology X) :=
  prespectralSpace_of_isClopen_generateFrom (t := inverseTopology X) (inverseTopology_def X)
    (compactSpace_constructibleTopology X)
    fun _ hs ↦ hs.2.isClopen_constructibleTopology_of_isClosed hs.1

/-- The inverse topology of a compact, quasi-sober, quasi-separated prespectral space is
quasi-separated. -/
theorem quasiSeparatedSpace_inverseTopology : @QuasiSeparatedSpace X (inverseTopology X) :=
  quasiSeparatedSpace_of_isClopen_generateFrom (t := inverseTopology X) (inverseTopology_def X)
    (compactSpace_constructibleTopology X)
    fun _ hs ↦ hs.2.isClopen_constructibleTopology_of_isClosed hs.1

/-- **Quasi-compact opens of the inverse topology.** In a spectral space, a subset is quasi-compact
and open for the inverse topology if and only if it is closed with quasi-compact open complement
for the original topology. -/
theorem isOpen_and_isCompact_inverseTopology_iff {s : Set X} :
    IsOpen[inverseTopology X] s ∧ @IsCompact X (inverseTopology X) s ↔
      IsClosed s ∧ IsCompact sᶜ := by
  refine ⟨fun ⟨ho, hc⟩ ↦ ?_, fun ⟨hs, hc⟩ ↦ ⟨isOpen_inverseTopology_of_isClosed hs hc, ?_⟩⟩
  · -- `s` is clopen for the constructible topology, so `s` and its complement are
    -- pro-constructible; `s` is moreover stable under specialization, hence closed.
    have hcl : IsClopen[constructibleTopology X] s :=
      isClopen_of_isCompact_of_isOpen_generateFrom (t := inverseTopology X) (inverseTopology_def X)
        (fun _ hs ↦ hs.2.isClopen_constructibleTopology_of_isClosed hs.1) hc ho
    refine ⟨(isProConstructible_iff_isClosed.2 hcl.1).isClosed_iff_stableUnderSpecialization.2
      (stableUnderSpecialization_of_isOpen_inverseTopology ho), ?_⟩
    exact (isProConstructible_iff_isClosed.2
      ((@isClosed_compl_iff X (constructibleTopology X) s).2 hcl.2)).isCompact
  · exact isCompact_of_isClosed_generateFrom (t := inverseTopology X) (inverseTopology_def X)
      (compactSpace_constructibleTopology X)
      (fun _ hs ↦ hs.2.isOpen_constructibleTopology_of_isClosed hs.1)
      (hc.isClosed_constructibleTopology_of_isClosed hs)

/-- In a spectral space, a subset is closed for the inverse topology with quasi-compact
complement exactly when it is quasi-compact and open for the original topology. -/
theorem isClosed_and_isCompact_compl_inverseTopology_iff {s : Set X} :
    IsClosed[inverseTopology X] s ∧ @IsCompact X (inverseTopology X) sᶜ ↔
      IsOpen s ∧ IsCompact s := by
  rw [← @isOpen_compl_iff X s (inverseTopology X), isOpen_and_isCompact_inverseTopology_iff,
    isClosed_compl_iff, compl_compl]

/-- **The inverse topology is an involution.** On a spectral space, the inverse topology of the
inverse topology is the original topology. -/
@[simp]
theorem inverseTopology_inverseTopology : @inverseTopology X (inverseTopology X) = tX := by
  refine Eq.trans ?_ (PrespectralSpace.isTopologicalBasis (X := X)).eq_generateFrom.symm
  rw [@inverseTopology_def X (inverseTopology X)]
  exact congrArg generateFrom (Set.ext fun _ ↦ isClosed_and_isCompact_compl_inverseTopology_iff)

/-- On a spectral space, the inverse topology has the same constructible topology as the original
topology. -/
@[simp]
theorem constructibleTopology_inverseTopology :
    @constructibleTopology X (inverseTopology X) = constructibleTopology X := by
  refine congrArg generateFrom (Set.ext fun s ↦ ?_)
  simp only [constructibleTopologySubbasis, mem_union, mem_ofPred_eq]
  rw [isOpen_and_isCompact_inverseTopology_iff, isClosed_and_isCompact_compl_inverseTopology_iff,
    or_comm]

/-- The inverse topology of a spectral space is spectral. -/
theorem spectralSpace_inverseTopology [T0Space X] : @SpectralSpace X (inverseTopology X) :=
  @spectralSpace_of_isClopen_generateFrom X _ (constructibleTopology X) (inverseTopology X)
    (inverseTopology_def X) (compactSpace_constructibleTopology X)
    (fun _ hs ↦ hs.2.isClopen_constructibleTopology_of_isClosed hs.1) t0Space_inverseTopology

variable [tY : TopologicalSpace Y] [CompactSpace Y] [QuasiSober Y] [PrespectralSpace Y]
  [QuasiSeparatedSpace Y]

/-- A spectral map between spectral spaces is spectral for the inverse topologies. -/
theorem _root_.IsSpectralMap.inverseTopology {f : X → Y} (hf : IsSpectralMap f) :
    @IsSpectralMap X Y (TauCeti.inverseTopology X) (TauCeti.inverseTopology Y) f := by
  -- Preimages of closed subsets with quasi-compact open complement are again of this form.
  have hpre {s : Set Y} (hs : IsClosed s) (hc : IsCompact sᶜ) :
      IsClosed (f ⁻¹' s) ∧ IsCompact (f ⁻¹' s)ᶜ :=
    ⟨hs.preimage hf.continuous, hf.isCompact_preimage_of_isOpen hs.isOpen_compl hc⟩
  refine @IsSpectralMap.mk X Y (TauCeti.inverseTopology X) (TauCeti.inverseTopology Y) f ?_
    fun s ho hc ↦ ?_
  · rw [inverseTopology_def Y]
    exact continuous_generateFrom_iff.2 fun s ⟨hs, hc⟩ ↦
      isOpen_inverseTopology_of_isClosed (hpre hs hc).1 (hpre hs hc).2
  · obtain ⟨hs, hsc⟩ := isOpen_and_isCompact_inverseTopology_iff.1 ⟨ho, hc⟩
    exact (isOpen_and_isCompact_inverseTopology_iff.2 (hpre hs hsc)).2

/-- **Spectral maps and the inverse topology.** A map between spectral spaces is spectral if and
only if it is spectral for the inverse topologies. -/
@[simp]
theorem isSpectralMap_inverseTopology_iff {f : X → Y} :
    @IsSpectralMap X Y (inverseTopology X) (inverseTopology Y) f ↔ IsSpectralMap f := by
  refine ⟨fun hf ↦ ?_, IsSpectralMap.inverseTopology⟩
  have h := @IsSpectralMap.inverseTopology X Y (inverseTopology X) compactSpace_inverseTopology
    quasiSober_inverseTopology prespectralSpace_inverseTopology
    quasiSeparatedSpace_inverseTopology (inverseTopology Y) compactSpace_inverseTopology
    quasiSober_inverseTopology prespectralSpace_inverseTopology
    quasiSeparatedSpace_inverseTopology f hf
  rwa [inverseTopology_inverseTopology, inverseTopology_inverseTopology] at h

end Spectral

end TauCeti
