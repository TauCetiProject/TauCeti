module

public import TauCeti.Topology.Spectral.PatchCriterion
public import TauCeti.Topology.Spectral.ProConstructible

/-!
# The inverse topology of a spectral space

The *inverse topology* (or Hochster dual topology) on a topological space `X` is generated by the
complements of the quasi-compact open subsets of `X`. On a spectral space it is again spectral and
it reverses specialization: the closed points of `X` become the generic points of the inverse
space and conversely. The quasi-compact opens of the inverse topology are exactly the
complements of the quasi-compact opens of `X`, from which the duality is formal: taking the
inverse topology twice returns the original topology, both topologies have the same
constructible topology, and a map of spectral spaces is spectral exactly when it is spectral for
the inverse topologies.

The inverse topology exchanges specialization and generalization: `x` specializes to `y` in the
inverse topology exactly when `y` specializes to `x` in `X`. Accordingly, the closed subsets of the
inverse topology are exactly the pro-constructible subsets of `X` that are stable under
generalization, and its open subsets are the subsets stable under specialization whose complement
is pro-constructible.

Except for spectrality itself, which also needs T₀, the duality results hold on every compact,
quasi-sober, quasi-separated prespectral space, the hypotheses under which the constructible
topology is compact.

Recall that Mathlib orders topologies by *reverse* inclusion of their open sets, so
`constructibleTopology X ≤ inverseTopology X` says that the constructible topology is finer.

## Main definitions

* `TauCeti.inverseTopology X` — the topology on `X` generated by the complements of the
  quasi-compact open subsets.

## Main results

* `TauCeti.constructibleTopology_le_inverseTopology` — the constructible topology refines the
  inverse topology.
* `TauCeti.stableUnderSpecialization_of_isOpen_inverseTopology` — open subsets of the inverse
  topology are stable under specialization in `X`.
* `TauCeti.specializes_inverseTopology_iff` — on a prespectral space, `x` specializes to `y` in the
  inverse topology if and only if `y` specializes to `x` in `X`; hence
  `TauCeti.t0Space_inverseTopology`.
* `TauCeti.isOpen_inverseTopology_and_isCompact_iff` — the quasi-compact opens of the inverse
  topology are the closed sets with quasi-compact open complement.
* `TauCeti.compactSpace_inverseTopology`, `TauCeti.quasiSober_inverseTopology`,
  `TauCeti.quasiSeparatedSpace_inverseTopology`, `TauCeti.prespectralSpace_inverseTopology` and
  `TauCeti.spectralSpace_inverseTopology` — **Hochster**: the inverse topology of a spectral space
  is spectral.
* `TauCeti.isClosed_inverseTopology_iff` and `TauCeti.isOpen_inverseTopology_iff` — the closed
  subsets of the inverse topology are the pro-constructible subsets stable under generalization,
  and the open subsets are those stable under specialization with pro-constructible complement.
* `TauCeti.inverseTopology_inverseTopology` — the inverse of the inverse topology is the original
  topology.
* `TauCeti.constructibleTopology_inverseTopology` — a spectral space and its inverse have the same
  constructible topology.
* `TauCeti.isSpectralMap_inverseTopology_iff` — a map of spectral spaces is spectral if and only
  if it is spectral for the inverse topologies.

## References

* M. Hochster, *Prime ideal structure in commutative rings*, Trans. Amer. Math. Soc. 142 (1969),
  43–60, Proposition 8.
* M. Dickmann, N. Schwartz, M. Tressl, *Spectral Spaces*, Cambridge University Press (2019),
  §1.4.
-/

public section

namespace TauCeti

open Set Topology TopologicalSpace

variable {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]

variable (X) in
/-- The *inverse topology* (Hochster dual topology) on `X`: the topology generated by the
complements of the quasi-compact open subsets of `X`, that is, by the closed subsets with
quasi-compact complement. -/
@[instance_reducible]
def inverseTopology : TopologicalSpace X :=
  generateFrom {s | IsClosed s ∧ IsCompact sᶜ}

variable (X) in
/-- The inverse topology is generated by the closed subsets with quasi-compact complement. -/
theorem inverseTopology_def :
    inverseTopology X = generateFrom {s | IsClosed s ∧ IsCompact sᶜ} :=
  (rfl)

/-- A closed subset with quasi-compact complement is open in the inverse topology. -/
theorem isOpen_inverseTopology_of_isClosed {s : Set X} (hs : IsClosed s) (hc : IsCompact sᶜ) :
    IsOpen[inverseTopology X] s :=
  isOpen_generateFrom_of_mem ⟨hs, hc⟩

/-- A quasi-compact open subset is closed in the inverse topology. -/
theorem isClosed_inverseTopology_of_isOpen {s : Set X} (hs : IsOpen s) (hc : IsCompact s) :
    IsClosed[inverseTopology X] s :=
  @IsClosed.mk X (inverseTopology X) s
    (isOpen_inverseTopology_of_isClosed hs.isClosed_compl (by rwa [compl_compl]))

variable (X) in
/-- The constructible topology refines the inverse topology. -/
theorem constructibleTopology_le_inverseTopology :
    constructibleTopology X ≤ inverseTopology X :=
  le_generateFrom fun _ hs ↦ hs.2.isOpen_constructibleTopology_of_isClosed hs.1

/-- Every open subset of the inverse topology is stable under specialization in `X`. -/
theorem stableUnderSpecialization_of_isOpen_inverseTopology {s : Set X}
    (hs : IsOpen[inverseTopology X] s) : StableUnderSpecialization s := by
  rw [inverseTopology_def] at hs
  induction hs with
  | basic t ht => exact ht.1.stableUnderSpecialization
  | univ => exact stableUnderSpecialization_univ
  | inter t u _ _ ht hu => exact fun _ _ h hx ↦ ⟨ht h hx.1, hu h hx.2⟩
  | sUnion S _ hS => exact stableUnderSpecialization_sUnion S hS

/-- A specialization `x ⤳ y` in `X` is reversed to `y ⤳ x` in the inverse topology. -/
theorem _root_.Specializes.inverseTopology {x y : X} (h : x ⤳ y) :
    @Specializes X (TauCeti.inverseTopology X) y x :=
  (@specializes_iff_forall_open X (TauCeti.inverseTopology X) y x).2 fun _ hs hx ↦
    stableUnderSpecialization_of_isOpen_inverseTopology hs h hx

/-- On a prespectral space, `x` specializes to `y` in the inverse topology if and only if `y`
specializes to `x` in `X`. -/
@[simp]
theorem specializes_inverseTopology_iff [PrespectralSpace X] {x y : X} :
    @Specializes X (inverseTopology X) x y ↔ y ⤳ x := by
  refine ⟨fun h ↦ ?_, Specializes.inverseTopology⟩
  by_contra hyx
  -- A quasi-compact open containing `x` but not `y` has an inverse-open complement containing `y`
  -- but not `x`.
  obtain ⟨U, hUo, hUc, hxU, hyU⟩ :=
    PrespectralSpace.not_specializes_iff_exists_isOpen_isCompact.1 hyx
  exact @Specializes.mem_open X (inverseTopology X) x y _ h
    (@IsClosed.isOpen_compl X (inverseTopology X) U (isClosed_inverseTopology_of_isOpen hUo hUc))
    hyU hxU

/-- The inverse topology of a T₀ prespectral space is T₀. -/
theorem t0Space_inverseTopology [PrespectralSpace X] [T0Space X] :
    @T0Space X (inverseTopology X) :=
  (@t0Space_iff_inseparable X (inverseTopology X)).2 fun x y h ↦
    have h' := (@inseparable_iff_specializes_and X (inverseTopology X) x y).1 h
    (inseparable_iff_specializes_and.2
      ⟨specializes_inverseTopology_iff.1 h'.2, specializes_inverseTopology_iff.1 h'.1⟩).eq

/-- The generators of the inverse topology are clopen for the constructible topology. -/
private theorem isClopen_constructibleTopology_of_mem {s : Set X}
    (hs : s ∈ {s : Set X | IsClosed s ∧ IsCompact sᶜ}) : IsClopen[constructibleTopology X] s :=
  hs.2.isClopen_constructibleTopology_of_isClosed hs.1

/-- The generators of the inverse topology are open for the constructible topology. -/
private theorem isOpen_constructibleTopology_of_mem {s : Set X}
    (hs : s ∈ {s : Set X | IsClosed s ∧ IsCompact sᶜ}) : IsOpen[constructibleTopology X] s :=
  hs.2.isOpen_constructibleTopology_of_isClosed hs.1

section Spectral

/-! ### Duality on spectral spaces

The results of this section hold on every compact, quasi-sober, quasi-separated prespectral space,
that is, on a spectral space up to the T₀ axiom, which only `spectralSpace_inverseTopology` uses. -/

variable [CompactSpace X] [QuasiSober X] [PrespectralSpace X] [QuasiSeparatedSpace X]

/-- On a compact, quasi-sober, quasi-separated prespectral space (for instance a spectral space),
the quasi-compact open subsets of the inverse topology are exactly the closed subsets of `X` with
quasi-compact complement, that is, the complements of the quasi-compact open subsets of `X`. -/
theorem isOpen_inverseTopology_and_isCompact_iff {s : Set X} :
    IsOpen[inverseTopology X] s ∧ @IsCompact X (inverseTopology X) s ↔
      IsClosed s ∧ IsCompact sᶜ := by
  refine ⟨fun ⟨ho, hc⟩ ↦ ?_, fun ⟨hs, hc⟩ ↦ ⟨isOpen_inverseTopology_of_isClosed hs hc, ?_⟩⟩
  · -- A quasi-compact open of the generated topology is clopen for the constructible topology.
    have hcl := @isClopen_of_isCompact_of_isOpen_generateFrom X _ (constructibleTopology X)
      (inverseTopology X) (inverseTopology_def X) (fun _ ↦ isClopen_constructibleTopology_of_mem)
      s hc ho
    -- It is pro-constructible and stable under specialization, hence closed; its complement is
    -- pro-constructible, hence quasi-compact.
    have hpc : IsProConstructible s :=
      isProConstructible_iff_isClosed.2 (@IsClopen.isClosed X (constructibleTopology X) s hcl)
    have hpc' : IsProConstructible sᶜ := isProConstructible_iff_isClosed.2
      (@IsOpen.isClosed_compl X (constructibleTopology X) s
        (@IsClopen.isOpen X (constructibleTopology X) s hcl))
    exact ⟨hpc.isClosed_iff_stableUnderSpecialization.2
      (stableUnderSpecialization_of_isOpen_inverseTopology ho), hpc'.isCompact⟩
  · exact @isCompact_of_isClosed_generateFrom X _ (constructibleTopology X) (inverseTopology X)
      (inverseTopology_def X) (compactSpace_constructibleTopology X)
      (fun _ ↦ isOpen_constructibleTopology_of_mem) s
      (hc.isClosed_constructibleTopology_of_isClosed hs)

/-- On a compact, quasi-sober, quasi-separated prespectral space, the closed subsets of the inverse
topology with quasi-compact complement are exactly the quasi-compact open subsets of `X`. -/
theorem isClosed_inverseTopology_and_isCompact_compl_iff {s : Set X} :
    IsClosed[inverseTopology X] s ∧ @IsCompact X (inverseTopology X) sᶜ ↔
      IsOpen s ∧ IsCompact s := by
  rw [← @isOpen_compl_iff X _ (inverseTopology X), isOpen_inverseTopology_and_isCompact_iff,
    compl_compl, isClosed_compl_iff]

variable (X)

/-- The inverse topology of a compact, quasi-sober, quasi-separated prespectral space is
compact. -/
theorem compactSpace_inverseTopology : @CompactSpace X (inverseTopology X) :=
  @compactSpace_of_isOpen_generateFrom X _ (constructibleTopology X) (inverseTopology X)
    (inverseTopology_def X) (compactSpace_constructibleTopology X)
    (fun _ ↦ isOpen_constructibleTopology_of_mem)

/-- The inverse topology of a compact, quasi-sober, quasi-separated prespectral space is
quasi-sober. -/
theorem quasiSober_inverseTopology : @QuasiSober X (inverseTopology X) :=
  @quasiSober_of_isClopen_generateFrom X _ (constructibleTopology X) (inverseTopology X)
    (inverseTopology_def X) (compactSpace_constructibleTopology X)
    (fun _ ↦ isClopen_constructibleTopology_of_mem)

/-- The inverse topology of a compact, quasi-sober, quasi-separated prespectral space is
quasi-separated. -/
theorem quasiSeparatedSpace_inverseTopology : @QuasiSeparatedSpace X (inverseTopology X) :=
  @quasiSeparatedSpace_of_isClopen_generateFrom X _ (constructibleTopology X) (inverseTopology X)
    (inverseTopology_def X) (compactSpace_constructibleTopology X)
    (fun _ ↦ isClopen_constructibleTopology_of_mem)

/-- The inverse topology of a compact, quasi-sober, quasi-separated prespectral space is
prespectral. -/
theorem prespectralSpace_inverseTopology : @PrespectralSpace X (inverseTopology X) :=
  @prespectralSpace_of_isClopen_generateFrom X _ (constructibleTopology X) (inverseTopology X)
    (inverseTopology_def X) (compactSpace_constructibleTopology X)
    (fun _ ↦ isClopen_constructibleTopology_of_mem)

/-- **Hochster**: the inverse topology of a spectral space is spectral. -/
theorem spectralSpace_inverseTopology [T0Space X] : @SpectralSpace X (inverseTopology X) :=
  @spectralSpace_of_isClopen_generateFrom X _ (constructibleTopology X) (inverseTopology X)
    (inverseTopology_def X) (compactSpace_constructibleTopology X)
    (fun _ ↦ isClopen_constructibleTopology_of_mem) t0Space_inverseTopology

/-- The inverse of the inverse topology of a compact, quasi-sober, quasi-separated prespectral
space (for instance a spectral space) is the original topology. -/
@[simp]
theorem inverseTopology_inverseTopology :
    @inverseTopology X (inverseTopology X) = ‹TopologicalSpace X› := by
  rw [@inverseTopology_def X (inverseTopology X)]
  refine Eq.trans ?_ (PrespectralSpace.isTopologicalBasis (X := X)).eq_generateFrom.symm
  exact congrArg generateFrom (Set.ext fun _ ↦ isClosed_inverseTopology_and_isCompact_compl_iff)

/-- A compact, quasi-sober, quasi-separated prespectral space (for instance a spectral space) and
its inverse have the same constructible topology. -/
@[simp]
theorem constructibleTopology_inverseTopology :
    @constructibleTopology X (inverseTopology X) = constructibleTopology X := by
  -- Both sides are generated by their constructible subbases.
  unfold constructibleTopology
  refine congrArg generateFrom (Set.ext fun s ↦ ?_)
  simp only [constructibleTopologySubbasis, mem_union, mem_ofPred_eq]
  rw [isOpen_inverseTopology_and_isCompact_iff, isClosed_inverseTopology_and_isCompact_compl_iff,
    or_comm]

variable {X}

/-- On a compact, quasi-sober, quasi-separated prespectral space (for instance a spectral space),
the closed subsets of the inverse topology are exactly the pro-constructible subsets stable under
generalization. -/
theorem isClosed_inverseTopology_iff {s : Set X} :
    IsClosed[inverseTopology X] s ↔ IsProConstructible s ∧ StableUnderGeneralization s := by
  -- Both topologies have the same pro-constructible subsets, and specialization is reversed.
  have hpc : @IsProConstructible X (inverseTopology X) s ↔ IsProConstructible s := by
    rw [@isProConstructible_iff_isClosed X (inverseTopology X),
      constructibleTopology_inverseTopology, isProConstructible_iff_isClosed]
  have hsp : @StableUnderSpecialization X (inverseTopology X) s ↔ StableUnderGeneralization s := by
    simp only [StableUnderSpecialization, StableUnderGeneralization,
      specializes_inverseTopology_iff]
  have := prespectralSpace_inverseTopology X
  refine ⟨fun h ↦ ⟨hpc.1 (@IsClosed.isProConstructible X (inverseTopology X) _ s h),
    hsp.1 (@IsClosed.stableUnderSpecialization X (inverseTopology X) s h)⟩, fun ⟨h₁, h₂⟩ ↦ ?_⟩
  exact (@IsProConstructible.isClosed_iff_stableUnderSpecialization X (inverseTopology X)
    (compactSpace_inverseTopology X) (quasiSober_inverseTopology X) _
    (quasiSeparatedSpace_inverseTopology X) s (hpc.2 h₁)).2 (hsp.2 h₂)

/-- On a compact, quasi-sober, quasi-separated prespectral space (for instance a spectral space),
the open subsets of the inverse topology are exactly the subsets stable under specialization whose
complement is pro-constructible. -/
theorem isOpen_inverseTopology_iff {s : Set X} :
    IsOpen[inverseTopology X] s ↔ IsProConstructible sᶜ ∧ StableUnderSpecialization s := by
  rw [← @isClosed_compl_iff X (inverseTopology X), isClosed_inverseTopology_iff,
    stableUnderGeneralization_compl_iff]

variable [CompactSpace Y] [QuasiSober Y] [PrespectralSpace Y] [QuasiSeparatedSpace Y]

/-- A spectral map of spectral spaces is spectral for the inverse topologies. More generally the
spaces need only be compact, quasi-sober, quasi-separated and prespectral. -/
theorem _root_.IsSpectralMap.inverseTopology {f : X → Y} (hf : IsSpectralMap f) :
    @IsSpectralMap X Y (TauCeti.inverseTopology X) (TauCeti.inverseTopology Y) f := by
  -- The preimage of a closed subset with quasi-compact open complement is again of this form.
  have key : ∀ s : Set Y, IsClosed s → IsCompact sᶜ → IsClosed (f ⁻¹' s) ∧ IsCompact (f ⁻¹' s)ᶜ :=
    fun s hs hc ↦ ⟨hs.preimage hf.continuous, hf.isCompact_preimage_of_isOpen hs.isOpen_compl hc⟩
  refine @IsSpectralMap.mk X Y (TauCeti.inverseTopology X) (TauCeti.inverseTopology Y) f ?_
    fun s hso hsc ↦ ?_
  · rw [TauCeti.inverseTopology_def Y]
    exact (continuous_generateFrom_iff (t := TauCeti.inverseTopology X)).2 fun s ⟨hs, hc⟩ ↦
      isOpen_inverseTopology_of_isClosed (key s hs hc).1 (key s hs hc).2
  · obtain ⟨hs, hc⟩ := isOpen_inverseTopology_and_isCompact_iff.1 ⟨hso, hsc⟩
    exact (isOpen_inverseTopology_and_isCompact_iff.2 (key s hs hc)).2

/-- A map of spectral spaces is spectral if and only if it is spectral for the inverse
topologies. More generally the spaces need only be compact, quasi-sober, quasi-separated and
prespectral. -/
@[simp]
theorem isSpectralMap_inverseTopology_iff {f : X → Y} :
    @IsSpectralMap X Y (inverseTopology X) (inverseTopology Y) f ↔ IsSpectralMap f := by
  refine ⟨fun hf ↦ ?_, IsSpectralMap.inverseTopology⟩
  -- Apply the forward direction to the inverse topologies, which satisfy the same hypotheses.
  have h := @IsSpectralMap.inverseTopology X Y (inverseTopology X) (inverseTopology Y)
    (compactSpace_inverseTopology X) (quasiSober_inverseTopology X)
    (prespectralSpace_inverseTopology X) (quasiSeparatedSpace_inverseTopology X)
    (compactSpace_inverseTopology Y) (quasiSober_inverseTopology Y)
    (prespectralSpace_inverseTopology Y) (quasiSeparatedSpace_inverseTopology Y) f hf
  rwa [inverseTopology_inverseTopology, inverseTopology_inverseTopology] at h

end Spectral

end TauCeti
