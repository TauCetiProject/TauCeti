module

public import Mathlib.Topology.Convenient.Category
public import TauCeti.Topology.Compactness.CompactlyGeneratedSpace
public import TauCeti.Topology.Homotopy.GenLoop.GeneratedBy
public import TauCeti.Topology.Homotopy.HomotopyGroup.WeakHomotopyEquivalence

/-!
# Homotopy groups of generated topologies

The counit from the topology generated by a family of test spaces to the original topology
induces a bijection on cubical homotopy classes whenever cubes and their homotopy cylinders
are generated by the family. In positive dimensions this bijection is a group isomorphism.
The comparison uses the original target topology without separation or generation assumptions.

For compact Hausdorff test spaces, all finite cubes and their cylinders have the required
property. Thus the actual compact-generation counit is a weak homotopy equivalence, including
its assertion on path components. This applies in particular to raw compact-open mapping
spaces and stopped Moore-path carriers.

The compact-test argument follows the generated-space universal property in
[Rainer M. Vogt, *Convenient categories of topological spaces for homotopy theory*][vogt-1971].
The formal construction uses Mathlib's `WithGeneratedByTopology` and
`IsGeneratedBy.equiv_symm_comp_continuous_iff`.
-/

public section

open scoped unitInterval Topology Topology.Homotopy
open Topology Topology.Homotopy

namespace TauCeti

universe t u v w

variable {ι : Type t} (X : ι → Type u) [∀ i, TopologicalSpace (X i)]
  {N : Type*} {Y : Type v} [TopologicalSpace Y]

/-- The homotopy-group comparison induced by the generated-topology counit. The hypotheses
cover degree zero as well as positive dimensions. -/
def homotopyGroupGeneratedByEquiv [IsGeneratedBy X (I^N)] [IsGeneratedBy X (I × I^N)]
    (x : WithGeneratedByTopology X Y) :
    HomotopyGroup N (WithGeneratedByTopology X Y) x ≃
      HomotopyGroup N Y (WithGeneratedByTopology.equiv x) :=
  Quotient.congr (genLoopGeneratedByEquiv X x) fun p q ↦
    (genLoopGeneratedByEquiv_homotopic_iff X x p q).symm

/-- The counit comparison sends the class of a generated-topology loop to the class of its
underlying loop. -/
theorem homotopyGroupGeneratedByEquiv_mk [IsGeneratedBy X (I^N)]
    [IsGeneratedBy X (I × I^N)] (x : WithGeneratedByTopology X Y)
    (p : Ω^ N (WithGeneratedByTopology X Y) x) :
    homotopyGroupGeneratedByEquiv X x (⟦p⟧ : HomotopyGroup N _ x) =
      ⟦genLoopGeneratedByEquiv X x p⟧ :=
  (rfl)

/-- The comparison is the map on homotopy groups of the actual counit. -/
theorem homotopyGroupGeneratedByEquiv_apply [IsGeneratedBy X (I^N)]
    [IsGeneratedBy X (I × I^N)] (x : WithGeneratedByTopology X Y)
    (a : HomotopyGroup N (WithGeneratedByTopology X Y) x) :
    homotopyGroupGeneratedByEquiv X x a =
      HomotopyGroup.map
        ⟨WithGeneratedByTopology.equiv, WithGeneratedByTopology.continuous_equiv⟩ rfl a := by
  refine Quotient.inductionOn a ?_
  intro p
  rw [homotopyGroupGeneratedByEquiv_mk, HomotopyGroup.map_mk]
  apply congrArg (Quotient.mk _)
  apply _root_.GenLoop.ext
  intro z
  simp only [genLoopGeneratedByEquiv_apply, _root_.GenLoop.map_apply, ContinuousMap.coe_mk]

/-- The inverse comparison lifts any representative to the generated topology. -/
theorem homotopyGroupGeneratedByEquiv_symm_mk [IsGeneratedBy X (I^N)]
    [IsGeneratedBy X (I × I^N)] (x : WithGeneratedByTopology X Y)
    (p : Ω^ N Y (WithGeneratedByTopology.equiv x)) :
    (homotopyGroupGeneratedByEquiv X x).symm
        (⟦p⟧ : HomotopyGroup N Y (WithGeneratedByTopology.equiv x)) =
      ⟦(genLoopGeneratedByEquiv X x).symm p⟧ :=
  (rfl)

/-- The counit comparison commutes with the map induced by any continuous map of raw targets.
The map on generated targets is Mathlib's existing generated-space map. -/
theorem homotopyGroupGeneratedByEquiv_naturality {Z : Type w} [TopologicalSpace Z]
    [IsGeneratedBy X (I^N)] [IsGeneratedBy X (I × I^N)]
    (f : C(Y, Z)) (x : WithGeneratedByTopology X Y)
    (a : HomotopyGroup N (WithGeneratedByTopology X Y) x) :
    homotopyGroupGeneratedByEquiv X (Y := Z)
        ((f.continuous.continuousGeneratedBy (X := X)).continuousMap x)
        (HomotopyGroup.map (f.continuous.continuousGeneratedBy (X := X)).continuousMap rfl a) =
      HomotopyGroup.map (y := WithGeneratedByTopology.equiv
        ((f.continuous.continuousGeneratedBy (X := X)).continuousMap x)) f
        ((WithGeneratedByTopology.equiv (X := X) (Y := Z)).apply_symm_apply
          (f (WithGeneratedByTopology.equiv x))).symm
        (homotopyGroupGeneratedByEquiv X (Y := Y) x a) := by
  let cY : C(WithGeneratedByTopology X Y, Y) :=
    ⟨WithGeneratedByTopology.equiv, WithGeneratedByTopology.continuous_equiv⟩
  let cZ : C(WithGeneratedByTopology X Z, Z) :=
    ⟨WithGeneratedByTopology.equiv, WithGeneratedByTopology.continuous_equiv⟩
  let kf := (f.continuous.continuousGeneratedBy (X := X)).continuousMap
  have hcomm : cZ.comp kf = f.comp cY := by
    ext y
    exact (WithGeneratedByTopology.equiv (X := X) (Y := Z)).apply_symm_apply _
  have hb : f (cY x) = cZ (kf x) :=
    ((WithGeneratedByTopology.equiv (X := X) (Y := Z)).apply_symm_apply _).symm
  rw [homotopyGroupGeneratedByEquiv_apply, homotopyGroupGeneratedByEquiv_apply]
  exact (HomotopyGroup.map_comp_apply cZ rfl kf rfl a).trans
    ((HomotopyGroup.map_congr hcomm _ _ a).trans
      (HomotopyGroup.map_comp_apply f hb cY rfl a).symm)

/-- In positive dimensions, the generated-topology counit induces an isomorphism of homotopy
groups. -/
def homotopyGroupGeneratedByMulEquiv [DecidableEq N] [Nonempty N]
    [IsGeneratedBy X (I^N)] [IsGeneratedBy X (I × I^N)]
    (x : WithGeneratedByTopology X Y) :
    HomotopyGroup N (WithGeneratedByTopology X Y) x ≃*
      HomotopyGroup N Y (WithGeneratedByTopology.equiv x) where
  toEquiv := homotopyGroupGeneratedByEquiv X x
  map_mul' a b := by
    simpa only [Equiv.toFun_as_coe, homotopyGroupGeneratedByEquiv_apply] using
      HomotopyGroup.map_mul
        ⟨WithGeneratedByTopology.equiv, WithGeneratedByTopology.continuous_equiv⟩ rfl a b

/-- The multiplicative comparison has the same forward map as the comparison of homotopy
classes. -/
theorem homotopyGroupGeneratedByMulEquiv_apply [DecidableEq N] [Nonempty N]
    [IsGeneratedBy X (I^N)] [IsGeneratedBy X (I × I^N)]
    (x : WithGeneratedByTopology X Y)
    (a : HomotopyGroup N (WithGeneratedByTopology X Y) x) :
    homotopyGroupGeneratedByMulEquiv X x a = homotopyGroupGeneratedByEquiv X x a :=
  (rfl)

/-- If every finite cube and its cylinder are generated by the test spaces, the counit of
Mathlib's generated-space coreflection is a weak homotopy equivalence. -/
theorem generatedByCounit_isWeakHomotopyEquivalence
    [∀ n : ℕ, IsGeneratedBy X (I^(Fin n))]
    [∀ n : ℕ, IsGeneratedBy X (I × I^(Fin n))] (Y : TopCat.{v}) :
    ((GeneratedByTopCat.adjCounit (X := X)).app Y).hom.IsWeakHomotopyEquivalence where
  exists_joined y := ⟨(WithGeneratedByTopology.equiv (X := X) (Y := Y)).symm y,
    ((WithGeneratedByTopology.equiv (X := X) (Y := Y)).apply_symm_apply y) ▸ Joined.refl y⟩
  bijective n x := by
    have h := (homotopyGroupGeneratedByEquiv X (N := Fin n) (Y := Y) x).bijective
    have he : ⇑(homotopyGroupGeneratedByEquiv X (N := Fin n) (Y := Y) x) =
        HomotopyGroup.map
          ⟨WithGeneratedByTopology.equiv, WithGeneratedByTopology.continuous_equiv⟩ rfl :=
      funext (homotopyGroupGeneratedByEquiv_apply X (N := Fin n) (Y := Y) x)
    rw [he] at h
    exact h

end TauCeti

namespace TopCat

/-- The compact-generation counit is a weak homotopy equivalence for every raw target,
with no Hausdorff, metrizability or compact-generation hypothesis on that target. The universe
of compact Hausdorff tests can be chosen independently of the target universe. -/
theorem compactlyGeneratedCounit_isWeakHomotopyEquivalence (Y : TopCat.{v}) :
    ContinuousMap.IsWeakHomotopyEquivalence
      ((GeneratedByTopCat.adjCounit (X := fun S : CompHaus.{u} ↦ (S : Type u))).app Y).hom :=
  TauCeti.generatedByCounit_isWeakHomotopyEquivalence _ Y

end TopCat
