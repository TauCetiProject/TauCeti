module

public import Mathlib.Topology.Convenient.GeneratedBy
public import TauCeti.Topology.Homotopy.GenLoop.Map

/-!
# Generalized loops of generated topologies

The counit from a generated topology to the original topology induces a bijection on
generalized loops whenever the parameter cube is generated by the test spaces. If the homotopy
cylinder is also generated by the test spaces, this bijection preserves and reflects homotopy
relative to the cube boundary. No separation or generation assumption on the target is needed.
-/

public section

open scoped unitInterval Topology Topology.Homotopy
open Topology Topology.Homotopy

namespace TauCeti

universe t u v

variable {ι : Type t} (X : ι → Type u) [∀ i, TopologicalSpace (X i)]
  {N : Type*} {Y : Type v} [TopologicalSpace Y]

/-- The counit gives a bijection of generalized loops when the parameter cube is generated
by the test spaces. This is a bijection of sets; continuity between the compact-open loop
spaces is not asserted. -/
def genLoopGeneratedByEquiv [IsGeneratedBy X (I^N)] (x : WithGeneratedByTopology X Y) :
    (Ω^ N (WithGeneratedByTopology X Y) x) ≃
      (Ω^ N Y (WithGeneratedByTopology.equiv x)) where
  toFun := _root_.GenLoop.map
    ⟨WithGeneratedByTopology.equiv, WithGeneratedByTopology.continuous_equiv⟩ rfl
  invFun p := ⟨⟨WithGeneratedByTopology.equiv.symm ∘ p,
    (IsGeneratedBy.equiv_symm_comp_continuous_iff (X := X) p).2 p.1.continuous⟩,
    fun z hz ↦ (congrArg (WithGeneratedByTopology.equiv (X := X) (Y := Y)).symm
      (_root_.GenLoop.boundary p z hz)).trans
        ((WithGeneratedByTopology.equiv (X := X) (Y := Y)).symm_apply_apply x)⟩
  left_inv p := by
    apply _root_.GenLoop.ext
    intro z
    exact (congrArg (WithGeneratedByTopology.equiv (X := X) (Y := Y)).symm
      (_root_.GenLoop.map_apply _ _ p z)).trans
        ((WithGeneratedByTopology.equiv (X := X) (Y := Y)).symm_apply_apply (p z))
  right_inv p := by
    apply _root_.GenLoop.ext
    intro z
    exact (_root_.GenLoop.map_apply _ _ _ z).trans
      ((WithGeneratedByTopology.equiv (X := X) (Y := Y)).apply_symm_apply (p z))

@[simp]
theorem genLoopGeneratedByEquiv_apply [IsGeneratedBy X (I^N)]
    (x : WithGeneratedByTopology X Y) (p : Ω^ N (WithGeneratedByTopology X Y) x) (z : I^N) :
    genLoopGeneratedByEquiv X x p z = WithGeneratedByTopology.equiv (p z) :=
  _root_.GenLoop.map_apply _ _ _ _

@[simp]
theorem genLoopGeneratedByEquiv_symm_apply [IsGeneratedBy X (I^N)]
    (x : WithGeneratedByTopology X Y) (p : Ω^ N Y (WithGeneratedByTopology.equiv x))
    (z : I^N) :
    (genLoopGeneratedByEquiv X x).symm p z = WithGeneratedByTopology.equiv.symm (p z) :=
  (rfl)

/-- A homotopy of generalized loops in the original topology lifts to the generated topology
when the homotopy cylinder is generated by the test spaces. -/
theorem genLoopGeneratedByEquiv_homotopic_iff [IsGeneratedBy X (I^N)]
    [IsGeneratedBy X (I × I^N)] (x : WithGeneratedByTopology X Y)
    (p q : Ω^ N (WithGeneratedByTopology X Y) x) :
    _root_.GenLoop.Homotopic (genLoopGeneratedByEquiv X x p) (genLoopGeneratedByEquiv X x q) ↔
      _root_.GenLoop.Homotopic p q := by
  refine ⟨?_, fun h ↦ _root_.GenLoop.map_homotopic h _ rfl⟩
  rintro ⟨H⟩
  refine ⟨{
    toContinuousMap := ⟨WithGeneratedByTopology.equiv.symm ∘ H,
      (IsGeneratedBy.equiv_symm_comp_continuous_iff (X := X) H).2 H.continuous⟩
    map_zero_left := fun z ↦ ?_
    map_one_left := fun z ↦ ?_
    prop' := fun t z hz ↦ ?_ }⟩
  · simp only [Function.comp_apply, H.apply_zero, _root_.GenLoop.coe_coe,
      genLoopGeneratedByEquiv_apply,
      Equiv.symm_apply_apply]
  · simp only [Function.comp_apply, H.apply_one, _root_.GenLoop.coe_coe,
      genLoopGeneratedByEquiv_apply,
      Equiv.symm_apply_apply]
  · simpa only [Function.comp_apply, ContinuousMap.coe_mk, _root_.GenLoop.coe_coe,
      genLoopGeneratedByEquiv_apply, Equiv.symm_apply_apply] using
      congrArg (WithGeneratedByTopology.equiv (X := X) (Y := Y)).symm (H.eq_fst t hz)

end TauCeti
