module

public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.Algebra.Category.Ring.Limits
public import Mathlib.RingTheory.LocalRing.RingHom.Basic
public import Mathlib.Topology.Sheaves.LocalPredicate
public import Mathlib.Topology.Sheaves.Stalks

/-!
# The quotient of a presheaf of rings by an ideal of global sections, on a subset

Let `F` be a presheaf of commutative rings on a topological space `X`, let `J` be an ideal of the
ring `F(X)` of global sections, and let `Z` be a subset of `X`. The stalk ideal
`F.stalkIdeal J x` is the ideal `J_x` of the stalk `F_x` generated by the germs of the elements
of `J`. This file builds the sheaf of rings `(F ⧸ J F)|_Z` on `Z` and identifies its stalk at `z`
with `F_z ⧸ J_z`. Nothing is radicalized. When `F` is the sheaf of holomorphic functions on a
complex manifold and `Z` is the common zero locus of `J`, this is the structure sheaf of the closed
analytic subspace cut out by `J`.

The sheaf is built concretely, as the structure sheaf of a prime spectrum is. A section over an
open subset `W` of `Z` is a family of classes `f w ∈ F_w ⧸ J_w`, `w ∈ W`, that is locally the
family of classes of the germs of a single section of `F`
(`TopCat.Presheaf.quotientIdealSheaf.isLocallyRestriction`). Restricting sections of `F` gives
the ring homomorphisms `TopCat.Presheaf.quotientIdealSheaf.restrictRingHom`
`F(U) → (F ⧸ J F)|_Z(U ∩ Z)`, natural in `U`. Evaluation of germs identifies the stalks with the
quotients `F_z ⧸ J_z` (`TopCat.Presheaf.quotientIdealSheaf.stalkEquiv`). The key point for
injectivity is that membership in `J_x` spreads: a germ in `J_x` has a representative whose germs
at all nearby points `w` lie in `J_w` (`TopCat.Presheaf.exists_germ_eq_forall_germ_mem`).

## Main definitions

* `TopCat.Presheaf.stalkIdeal F J x`: the ideal `J_x` of `F_x`.
* `TopCat.Presheaf.quotientIdealSheaf F J Z`: the sheaf of rings `(F ⧸ J F)|_Z` on `Z`, with
  `TopCat.Presheaf.quotientIdealSheaf.sectionsEquiv` reading its sections as families of classes.
* `TopCat.Presheaf.quotientIdealSheaf.restrictRingHom F J Z U`: restriction of sections of `F`
  over `U` to sections over `U ∩ Z`.

## Main results

* `TopCat.Presheaf.exists_germ_eq_forall_germ_mem`: membership in `J_x` spreads to the stalk
  ideals at nearby points.
* `TopCat.Presheaf.quotientIdealSheaf.stalkEquiv`: the stalk at `z` is `F_z ⧸ J_z`.
* `TopCat.Presheaf.quotientIdealSheaf.isLocalRing_stalk`: the stalk at `z` is local when `F_z` is
  local and `J_z` is proper.

## References

* The construction of the sheaf by a local predicate and of the stalk map by evaluation follows
  `AlgebraicGeometry.StructureSheaf` in `Mathlib/AlgebraicGeometry/StructureSheaf.lean`, by Johan
  Commelin, Kim Morrison and Andrew Yang.
-/

public noncomputable section

universe u

open CategoryTheory Opposite TopologicalSpace

namespace TopCat.Presheaf

variable {X : TopCat.{u}} (F : X.Presheaf CommRingCat.{u}) (J : Ideal (F.obj (op ⊤)))

/-! ### Stalk ideals -/

/-- The ideal `J_x` of the stalk `F_x` generated by the germs of the global sections in `J`. -/
def stalkIdeal (x : X) : Ideal (F.stalk x) :=
  J.map (F.germ ⊤ x (Opens.mem_top x)).hom

variable {F J} in
/-- The germ of a global section in `J` lies in each stalk ideal of `J`. -/
theorem germ_mem_stalkIdeal {f : F.obj (op ⊤)} (hf : f ∈ J) (x : X) :
    F.germ ⊤ x (Opens.mem_top x) f ∈ F.stalkIdeal J x :=
  Ideal.mem_map_of_mem _ hf

variable {F J} in
/-- The stalk ideal `J_x` lies in an ideal `K` of `F_x` exactly when the germs of all elements of
`J` lie in `K`. -/
theorem stalkIdeal_le_iff {x : X} {K : Ideal (F.stalk x)} :
    F.stalkIdeal J x ≤ K ↔ J ≤ K.comap (F.germ ⊤ x (Opens.mem_top x)).hom :=
  Ideal.map_le_iff_le_comap

/-- The stalk ideal of the ideal generated by a set of sections is generated by their germs. -/
theorem stalkIdeal_span (s : Set (F.obj (op ⊤))) (x : X) :
    F.stalkIdeal (Ideal.span s) x = Ideal.span (F.germ ⊤ x (Opens.mem_top x) '' s) :=
  Ideal.map_span _ s

/-- The zero ideal has zero stalk ideals. -/
@[simp]
theorem stalkIdeal_bot (x : X) : F.stalkIdeal ⊥ x = ⊥ :=
  Ideal.map_bot

/-- The germs at `x` with a representative near `x` whose germs at every point `w` of its domain
lie in `J_w`. -/
private def spreadIdeal (x : X) : Ideal (F.stalk x) where
  carrier := {s | ∃ (U : Opens X) (hx : x ∈ U) (g : F.obj (op U)),
    F.germ U x hx g = s ∧ ∀ (w : X) (hw : w ∈ U), F.germ U w hw g ∈ F.stalkIdeal J w}
  zero_mem' := ⟨⊤, Opens.mem_top _, 0, map_zero _, fun w _ ↦ by
    rw [map_zero]
    exact zero_mem _⟩
  add_mem' := by
    rintro - - ⟨U, hxU, g, rfl, hg⟩ ⟨V, hxV, h, rfl, hh⟩
    refine ⟨U ⊓ V, Opens.mem_inf.2 ⟨hxU, hxV⟩,
      F.map (homOfLE inf_le_left).op g + F.map (homOfLE inf_le_right).op h, ?_, fun w hw ↦ ?_⟩
    · rw [map_add, germ_res_apply, germ_res_apply]
    · rw [map_add, germ_res_apply, germ_res_apply]
      exact add_mem (hg w (Opens.mem_inf.1 hw).1) (hh w (Opens.mem_inf.1 hw).2)
  smul_mem' := by
    rintro c - ⟨U, hxU, g, rfl, hg⟩
    obtain ⟨V, hxV, h, rfl⟩ := F.exists_germ_eq c
    refine ⟨V ⊓ U, Opens.mem_inf.2 ⟨hxV, hxU⟩,
      F.map (homOfLE inf_le_left).op h * F.map (homOfLE inf_le_right).op g, ?_, fun w hw ↦ ?_⟩
    · rw [map_mul, germ_res_apply, germ_res_apply, smul_eq_mul]
    · rw [map_mul, germ_res_apply, germ_res_apply]
      exact Ideal.mul_mem_left _ _ (hg w (Opens.mem_inf.1 hw).2)

variable {F J} in
/-- **Membership in the stalk ideals spreads.** A germ in `J_x` is the germ of a section near `x`
whose germs at all points `w` of its domain lie in `J_w`. -/
theorem exists_germ_eq_forall_germ_mem {x : X} {s : F.stalk x} (hs : s ∈ F.stalkIdeal J x) :
    ∃ (U : Opens X) (hx : x ∈ U) (g : F.obj (op U)),
      F.germ U x hx g = s ∧ ∀ (w : X) (hw : w ∈ U), F.germ U w hw g ∈ F.stalkIdeal J w := by
  have hle : F.stalkIdeal J x ≤ spreadIdeal F J x :=
    stalkIdeal_le_iff.mpr fun f hf ↦ ⟨⊤, Opens.mem_top _, f, rfl, fun w _ ↦
      germ_mem_stalkIdeal hf w⟩
  exact hle hs

variable (Z : Set X)

namespace quotientIdealSheaf

/-- A family of classes in the stalks `F_w ⧸ J_w` over an open subset `W` of `Z` is a restriction
if it is the family of classes of the germs of one section of `F`. -/
private def isRestriction :
    TopCat.PrelocalPredicate (fun z : TopCat.of Z ↦ F.stalk z.val ⧸ F.stalkIdeal J z.val) where
  pred {W} f := ∃ (U : Opens X) (hU : ∀ w : W, w.val.val ∈ U) (g : F.obj (op U)),
    ∀ w : W, f w = Ideal.Quotient.mk _ (F.germ U w.val.val (hU w) g)
  res {_ _} i _ := fun ⟨U, hU, g, h⟩ ↦
    ⟨U, fun w ↦ hU (Set.inclusion i.le w), g, fun w ↦ h (Set.inclusion i.le w)⟩

variable {F J Z} in
/-- Two restrictions over `U` and `V` are, on `U ⊓ V`, the families of classes of the germs of two
sections over one common open subset of `X`. -/
private theorem isRestriction_inf {U V : Opens (TopCat.of Z)}
    {a : ∀ w : U, F.stalk w.val.val ⧸ F.stalkIdeal J w.val.val}
    {b : ∀ w : V, F.stalk w.val.val ⧸ F.stalkIdeal J w.val.val}
    (ha : (isRestriction F J Z).pred a) (hb : (isRestriction F J Z).pred b) :
    ∃ (P : Opens X) (hP : ∀ w : (U ⊓ V : Opens (TopCat.of Z)), w.val.val ∈ P)
      (g h : F.obj (op P)), ∀ w : (U ⊓ V : Opens (TopCat.of Z)),
        a ⟨w.val, w.property.1⟩ = Ideal.Quotient.mk _ (F.germ P w.val.val (hP w) g) ∧
          b ⟨w.val, w.property.2⟩ = Ideal.Quotient.mk _ (F.germ P w.val.val (hP w) h) := by
  obtain ⟨P, hP, g, hg⟩ := ha
  obtain ⟨Q, hQ, h, hh⟩ := hb
  refine ⟨P ⊓ Q, fun w ↦ Opens.mem_inf.2 ⟨hP ⟨w.val, w.property.1⟩, hQ ⟨w.val, w.property.2⟩⟩,
    F.map (homOfLE inf_le_left).op g, F.map (homOfLE inf_le_right).op h, fun w ↦ ⟨?_, ?_⟩⟩
  · rw [germ_res_apply]
    exact hg _
  · rw [germ_res_apply]
    exact hh _

/-- The sections of `(F ⧸ J F)|_Z`: families of classes which are locally restrictions of sections
of `F`. -/
def isLocallyRestriction :
    TopCat.LocalPredicate (fun z : TopCat.of Z ↦ F.stalk z.val ⧸ F.stalkIdeal J z.val) :=
  (isRestriction F J Z).sheafify

variable {F J Z} in
/-- A family is a section exactly when, near each point, it is the family of classes of the germs
of one section of `F`. -/
theorem isLocallyRestriction_pred_iff {W : Opens (TopCat.of Z)}
    {f : ∀ w : W, F.stalk w.val.val ⧸ F.stalkIdeal J w.val.val} :
    (isLocallyRestriction F J Z).pred f ↔ ∀ w : W, ∃ (V : Opens (TopCat.of Z))
      (_ : w.val ∈ V) (i : V ⟶ W) (U : Opens X) (hU : ∀ v : V, v.val.val ∈ U) (g : F.obj (op U)),
      ∀ v : V, f (Set.inclusion i.le v) = Ideal.Quotient.mk _ (F.germ U v.val.val (hU v) g) :=
  Iff.rfl

/-- The ring of sections over an open subset `W` of `Z`. -/
def sectionsSubring (W : Opens (TopCat.of Z)) :
    Subring (∀ w : W, F.stalk w.val.val ⧸ F.stalkIdeal J w.val.val) where
  carrier := {f | (isLocallyRestriction F J Z).pred f}
  zero_mem' := TopCat.PrelocalPredicate.sheafifyOf ⟨⊤, fun _ ↦ Opens.mem_top _, 0, fun _ ↦ by
    rw [map_zero, map_zero]
    rfl⟩
  one_mem' := TopCat.PrelocalPredicate.sheafifyOf ⟨⊤, fun _ ↦ Opens.mem_top _, 1, fun _ ↦ by
    rw [map_one, map_one]
    rfl⟩
  add_mem' ha hb := (isRestriction F J Z).sheafify_inductionOn₂' (isRestriction F J Z)
    (isRestriction F J Z) (fun s t ↦ s + t) (fun ha hb ↦ by
      obtain ⟨P, hP, g, h, hgh⟩ := isRestriction_inf ha hb
      exact ⟨P, hP, g + h, fun w ↦ by
        beta_reduce
        rw [(hgh w).1, (hgh w).2, map_add, map_add]⟩) ha hb
  neg_mem' ha := (isRestriction F J Z).sheafify_inductionOn' (fun s ↦ -s) (fun ⟨P, hP, g, hg⟩ ↦
    ⟨P, hP, -g, fun w ↦ by beta_reduce; rw [hg, map_neg, map_neg]⟩) ha
  mul_mem' ha hb := (isRestriction F J Z).sheafify_inductionOn₂' (isRestriction F J Z)
    (isRestriction F J Z) (fun s t ↦ s * t) (fun ha hb ↦ by
      obtain ⟨P, hP, g, h, hgh⟩ := isRestriction_inf ha hb
      exact ⟨P, hP, g * h, fun w ↦ by
        beta_reduce
        rw [(hgh w).1, (hgh w).2, map_mul, map_mul]⟩) ha hb

variable {F J Z} in
/-- Membership in the ring of sections is the local predicate of sections. -/
@[simp]
theorem mem_sectionsSubring_iff {W : Opens (TopCat.of Z)}
    {f : ∀ w : W, F.stalk w.val.val ⧸ F.stalkIdeal J w.val.val} :
    f ∈ sectionsSubring F J Z W ↔ (isLocallyRestriction F J Z).pred f :=
  Iff.rfl

/-- The presheaf of rings of sections of `(F ⧸ J F)|_Z`, with restriction of families. -/
private def presheaf : TopCat.Presheaf CommRingCat.{u} (TopCat.of Z) where
  obj W := CommRingCat.of (sectionsSubring F J Z W.unop)
  map {_ _} i := CommRingCat.ofHom
    { toFun f := ⟨fun w ↦ f.val (Set.inclusion i.unop.le w),
        (isLocallyRestriction F J Z).res i.unop f.val f.property⟩
      map_one' := rfl
      map_mul' _ _ := rfl
      map_zero' := rfl
      map_add' _ _ := rfl }
  map_id _ := rfl
  map_comp _ _ := rfl

end quotientIdealSheaf

open quotientIdealSheaf in
/-- The sheaf of rings `(F ⧸ J F)|_Z` on `Z`. Its sections over `W` are the families of classes in
`F_w ⧸ J_w`, `w ∈ W`, which are locally the classes of the germs of one section of `F`. Its stalk
at `z` is `F_z ⧸ J_z` (`TopCat.Presheaf.quotientIdealSheaf.stalkEquiv`). -/
def quotientIdealSheaf : TopCat.Sheaf CommRingCat.{u} (TopCat.of Z) where
  obj := presheaf F J Z
  property := by
    rw [Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget CommRingCat)]
    -- The underlying presheaf of sets is the subsheaf cut out by the local predicate.
    exact TopCat.Presheaf.isSheaf_of_iso (NatIso.ofComponents (fun _ ↦ (Equiv.refl _).toIso)
      fun _ ↦ rfl) (TopCat.subsheafToTypes (isLocallyRestriction F J Z)).property

namespace quotientIdealSheaf

/-- Read a section of `(F ⧸ J F)|_Z` over `W` as a family in `sectionsSubring F J Z W`. -/
def sectionsEquiv (W : Opens (TopCat.of Z)) :
    (F.quotientIdealSheaf J Z).presheaf.obj (op W) ≃+* sectionsSubring F J Z W :=
  RingEquiv.refl _

variable {F J Z} in
/-- Restriction of sections is restriction of families. -/
@[simp]
theorem sectionsEquiv_map_apply {W V : Opens (TopCat.of Z)} (i : V ⟶ W)
    (f : (F.quotientIdealSheaf J Z).presheaf.obj (op W)) (v : V) :
    (sectionsEquiv F J Z V ((F.quotientIdealSheaf J Z).presheaf.map i.op f)).val v =
      (sectionsEquiv F J Z W f).val (Set.inclusion i.le v) :=
  (rfl)

variable {F J Z} in
/-- Sections of `(F ⧸ J F)|_Z` are equal when they have the same classes at every point. -/
theorem ext {W : Opens (TopCat.of Z)} {f g : (F.quotientIdealSheaf J Z).presheaf.obj (op W)}
    (h : ∀ w : W, (sectionsEquiv F J Z W f).val w = (sectionsEquiv F J Z W g).val w) : f = g :=
  (sectionsEquiv F J Z W).injective (Subtype.ext (funext h))

/-- The ring homomorphism restricting sections of `F` over an open subset `U` of `X` to the trace
`U ∩ Z`: a section goes to the family of classes of its germs. -/
def restrictRingHom (U : Opens X) :
    F.obj (op U) →+* (F.quotientIdealSheaf J Z).presheaf.obj
      (op (Opens.comap ⟨Subtype.val, continuous_subtypeVal⟩ U)) :=
  (sectionsEquiv F J Z _).symm.toRingHom.comp <|
    (RingHom.pi fun w : Opens.comap ⟨Subtype.val, continuous_subtypeVal⟩ U ↦
      (Ideal.Quotient.mk _).comp (F.germ U w.val.val w.property).hom).codRestrict _
      fun g ↦ TopCat.PrelocalPredicate.sheafifyOf (P := isRestriction F J Z)
        ⟨U, fun w ↦ w.property, g, fun _ ↦ rfl⟩

variable {F J Z} in
/-- The restriction of a section of `F` has, at each point, the class of its germ. -/
@[simp]
theorem sectionsEquiv_restrictRingHom_apply (U : Opens X) (g : F.obj (op U))
    (w : Opens.comap ⟨Subtype.val, continuous_subtypeVal⟩ U) :
    (sectionsEquiv F J Z _ (restrictRingHom F J Z U g)).val w =
      Ideal.Quotient.mk _ (F.germ U w.val.val w.property g) :=
  (rfl)

variable {F J Z} in
/-- Restriction of sections of `F` commutes with restriction to smaller open sets, so the maps
`restrictRingHom F J Z U` are the components of a morphism of presheaves. -/
theorem restrictRingHom_map {U V : Opens X} (h : V ≤ U) (g : F.obj (op U)) :
    restrictRingHom F J Z V (F.map (homOfLE h).op g) =
      (F.quotientIdealSheaf J Z).presheaf.map (homOfLE (Opens.comap_mono _ h)).op
        (restrictRingHom F J Z U g) :=
  ext fun w ↦ by
    rw [sectionsEquiv_restrictRingHom_apply, sectionsEquiv_map_apply,
      sectionsEquiv_restrictRingHom_apply]
    exact congrArg (Ideal.Quotient.mk _) (F.germ_res_apply (homOfLE h) w.val.val w.property g)

/-! ### Stalks -/

/-- Evaluation of germs of sections at their base point, with values in `F_z ⧸ J_z`. -/
private def stalkToFiberRingHom (z : TopCat.of Z) :
    (F.quotientIdealSheaf J Z).presheaf.stalk z ⟶
      CommRingCat.of (F.stalk z.val ⧸ F.stalkIdeal J z.val) :=
  Limits.colimit.desc ((OpenNhds.inclusion z).op ⋙ (F.quotientIdealSheaf J Z).presheaf)
    { pt := CommRingCat.of (F.stalk z.val ⧸ F.stalkIdeal J z.val)
      ι :=
        { app W := CommRingCat.ofHom ((Pi.evalRingHom
            (fun w : W.unop.val ↦ F.stalk w.val.val ⧸ F.stalkIdeal J w.val.val)
            ⟨z, W.unop.property⟩).comp ((sectionsSubring F J Z W.unop.val).subtype.comp
              (sectionsEquiv F J Z W.unop.val).toRingHom))
          naturality _ _ _ := rfl } }

variable {F J Z} in
private theorem stalkToFiberRingHom_germ {z : TopCat.of Z} {W : Opens (TopCat.of Z)} (hz : z ∈ W)
    (f : (F.quotientIdealSheaf J Z).presheaf.obj (op W)) :
    stalkToFiberRingHom F J Z z ((F.quotientIdealSheaf J Z).presheaf.germ W z hz f) =
      (sectionsEquiv F J Z W f).val ⟨z, hz⟩ := by
  rw [← ConcreteCategory.comp_apply]
  exact ConcreteCategory.congr_hom (Limits.colimit.ι_desc
    (F := (OpenNhds.inclusion z).op ⋙ (F.quotientIdealSheaf J Z).presheaf) _ (op ⟨W, hz⟩)) f

private theorem stalkToFiberRingHom_surjective (z : TopCat.of Z) :
    Function.Surjective (stalkToFiberRingHom F J Z z) := by
  intro t
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective t
  obtain ⟨U, hzU, g, rfl⟩ := F.exists_germ_eq s
  exact ⟨(F.quotientIdealSheaf J Z).presheaf.germ _ z hzU (restrictRingHom F J Z U g),
    stalkToFiberRingHom_germ hzU _⟩

private theorem stalkToFiberRingHom_injective (z : TopCat.of Z) :
    Function.Injective (stalkToFiberRingHom F J Z z) := by
  refine (injective_iff_map_eq_zero (stalkToFiberRingHom F J Z z).hom).mpr fun s hs ↦ ?_
  obtain ⟨W, hzW, f, rfl⟩ := (F.quotientIdealSheaf J Z).presheaf.exists_germ_eq s
  have hfz : (sectionsEquiv F J Z W f).val ⟨z, hzW⟩ = 0 :=
    (stalkToFiberRingHom_germ hzW f).symm.trans hs
  -- Near `z`, the section `f` is the family of classes of the germs of some `g`.
  obtain ⟨V, hzV, iV, U, hU, g, hg⟩ := (sectionsEquiv F J Z W f).property ⟨z, hzW⟩
  have hgz : F.germ U z.val (hU ⟨z, hzV⟩) g ∈ F.stalkIdeal J z.val := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact (hg ⟨z, hzV⟩).symm.trans hfz
  -- The germ of `g` at `z` lies in `J_z`, so the germs of `g` lie in `J_w` near `z`.
  obtain ⟨U', hzU', g', hgg', hg'⟩ := exists_germ_eq_forall_germ_mem hgz
  obtain ⟨U'', hzU'', i', i, hU''⟩ := F.germ_eq z.val hzU' (hU ⟨z, hzV⟩) g' g hgg'
  let N : Opens (TopCat.of Z) := V ⊓ Opens.comap ⟨Subtype.val, continuous_subtypeVal⟩ U''
  have hzN : z ∈ N := Opens.mem_inf.2 ⟨hzV, hzU''⟩
  have hNW : N ≤ W := inf_le_left.trans iV.le
  have hres : (F.quotientIdealSheaf J Z).presheaf.map (homOfLE hNW).op f = 0 := by
    refine ext fun w ↦ ?_
    have hwU'' : w.val.val ∈ U'' := (Opens.mem_inf.1 w.property).2
    -- The germs of `g` and `g'` at `w` agree, since `g` and `g'` agree on `U''`.
    have hw := hg' w.val.val (i'.le hwU'')
    rw [← germ_res_apply F i' w.val.val hwU'', hU'', germ_res_apply] at hw
    rw [sectionsEquiv_map_apply, map_zero]
    exact (hg ⟨w.val, (Opens.mem_inf.1 w.property).1⟩).trans (Ideal.Quotient.eq_zero_iff_mem.mpr hw)
  rw [← germ_res_apply _ (homOfLE hNW) z hzN f, hres, map_zero]

/-- **The stalks of `(F ⧸ J F)|_Z`.** Evaluation of germs identifies the stalk at `z` with the
quotient `F_z ⧸ J_z`. -/
def stalkEquiv (z : TopCat.of Z) :
    (F.quotientIdealSheaf J Z).presheaf.stalk z ≃+* F.stalk z.val ⧸ F.stalkIdeal J z.val :=
  RingEquiv.ofBijective (stalkToFiberRingHom F J Z z).hom
    ⟨stalkToFiberRingHom_injective F J Z z, stalkToFiberRingHom_surjective F J Z z⟩

variable {F J Z} in
/-- The stalk isomorphism sends the germ of a section to its class at the base point. -/
@[simp]
theorem stalkEquiv_germ {z : TopCat.of Z} {W : Opens (TopCat.of Z)} (hz : z ∈ W)
    (f : (F.quotientIdealSheaf J Z).presheaf.obj (op W)) :
    stalkEquiv F J Z z ((F.quotientIdealSheaf J Z).presheaf.germ W z hz f) =
      (sectionsEquiv F J Z W f).val ⟨z, hz⟩ :=
  stalkToFiberRingHom_germ hz f

variable {F J Z} in
/-- The stalk of `(F ⧸ J F)|_Z` at `z` is local when `F_z` is local and `J_z` is proper. -/
theorem isLocalRing_stalk {z : TopCat.of Z} [IsLocalRing (F.stalk z.val)]
    (hz : F.stalkIdeal J z.val ≠ ⊤) :
    IsLocalRing ((F.quotientIdealSheaf J Z).presheaf.stalk z) :=
  have : Nontrivial (F.stalk z.val ⧸ F.stalkIdeal J z.val) := Ideal.Quotient.nontrivial_iff.mpr hz
  have := IsLocalRing.of_surjective' (Ideal.Quotient.mk (F.stalkIdeal J z.val))
    Ideal.Quotient.mk_surjective
  (stalkEquiv F J Z z).symm.isLocalRing

end TopCat.Presheaf.quotientIdealSheaf
