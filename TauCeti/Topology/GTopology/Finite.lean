module

public import TauCeti.Topology.GTopology.Basic

/-!
# G-topologies generated by finite covers

On a meet-closed family of subsets containing the whole space, a covering family is
admissible when its members lie in the target and it has a finite subcover. This gives
`GTopology.finiteCovers`, the G-topology used for quasi-compact bases, in particular
for the weak affinoid site. No ambient topology or compactness assumption is needed.

## References

* Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*, §§9.1.1 and 9.1.4.
-/

public section

namespace TauCeti.GTopology

variable {X B : Type*} [SemilatticeInf B] [OrderTop B] (ι : B ↪o Set X)
  (htop : ι ⊤ = Set.univ) (hinf : ∀ U V, ι (U ⊓ V) = ι U ∩ ι V)

/-- The G-topology in which covers are families contained in the target admitting a finite
subcover. Families themselves need not be finite. -/
def finiteCovers : GTopology ι where
  map_top := htop
  map_inf := hinf
  Covers U S := (∀ V ∈ S, V ≤ U) ∧
    ∃ R ⊆ S, R.Finite ∧ ⋃₀ (ι '' R) = ι U
  subset h := h.1
  union_eq := by
    rintro U S ⟨hSU, R, hRS, _, hR⟩
    apply Set.Subset.antisymm
    · rintro x ⟨_, ⟨V, hV, rfl⟩, hx⟩
      exact ι.monotone (hSU V hV) hx
    · rw [← hR]
      exact Set.sUnion_mono (Set.image_mono hRS)
  identity U := ⟨by simp, {U}, Set.Subset.rfl, Set.finite_singleton U, by simp⟩
  restriction := by
    rintro U S ⟨_, R, hRS, hfin, hR⟩ V hVU
    refine ⟨?_, (fun W ↦ W ⊓ V) '' R, Set.image_mono hRS, hfin.image _, ?_⟩
    · rintro _ ⟨W, _, rfl⟩
      exact inf_le_right
    · calc
        ⋃₀ (ι '' ((fun W ↦ W ⊓ V) '' R)) = (⋃₀ (ι '' R)) ∩ ι V := by
          simp only [Set.image_image, Set.sUnion_image, hinf, ← Set.iUnion_inter]
        _ = ι V := by rw [hR, Set.inter_eq_right.mpr (ι.monotone hVU)]
  transitive := by
    classical
    rintro U S T ⟨hSU, R, hRS, hfin, hR⟩ hT
    choose! Q hQT hQfin hQ using fun V hV ↦ (hT V (hRS hV)).2
    refine ⟨?_, ⋃ V ∈ R, Q V, ?_, hfin.biUnion (fun V hV ↦ hQfin V hV), ?_⟩
    · intro W hW
      obtain ⟨V, hV, hWV⟩ := Set.mem_iUnion₂.mp hW
      exact ((hT V hV).1 W hWV).trans (hSU V hV)
    · intro W hW
      obtain ⟨V, hV, hWV⟩ := Set.mem_iUnion₂.mp hW
      exact Set.mem_iUnion₂.mpr ⟨V, hRS hV, hQT V hV hWV⟩
    · calc
        ⋃₀ (ι '' (⋃ V ∈ R, Q V)) = ⋃ V ∈ R, ⋃₀ (ι '' Q V) := by
          simp only [Set.image_iUnion, Set.sUnion_iUnion]
        _ = ⋃ V ∈ R, ι V := Set.iUnion₂_congr fun V hV ↦ hQ V hV
        _ = ι U := by simpa only [Set.sUnion_image] using hR

/-- Characterization of covers in the finite-cover G-topology. -/
@[simp]
theorem finiteCovers_covers_iff {U : B} {S : Set B} :
    (finiteCovers ι htop hinf).Covers U S ↔ (∀ V ∈ S, V ≤ U) ∧
      ∃ R ⊆ S, R.Finite ∧ ⋃₀ (ι '' R) = ι U := Iff.rfl

/-- A finite family is admissible precisely when its union is the target. -/
theorem finiteCovers_covers_iff_of_finite {U : B} {S : Set B} (hS : S.Finite) :
    (finiteCovers ι htop hinf).Covers U S ↔ ⋃₀ (ι '' S) = ι U := by
  constructor
  · exact (finiteCovers ι htop hinf).union_eq
  · intro h
    refine ⟨fun V hV ↦ ι.le_iff_le.mp ?_, S, Set.Subset.rfl, hS, h⟩
    exact h ▸ Set.subset_sUnion_of_mem ⟨V, hV, rfl⟩

/-- A sieve covers precisely when it contains a finite set-theoretic cover. -/
theorem mem_finiteCovers_grothendieckTopology_iff {U : B}
    {R : CategoryTheory.Sieve U} :
    R ∈ (finiteCovers ι htop hinf).grothendieckTopology U ↔
      ∃ S : Set B, S.Finite ∧ ⋃₀ (ι '' S) = ι U ∧ coverPresieve U S ≤ R := by
  rw [mem_grothendieckTopology_iff]
  simp only [finiteCovers_covers_iff]
  constructor
  · rintro ⟨S, ⟨_, T, hTS, hfin, hT⟩, hSR⟩
    exact ⟨T, hfin, hT, fun V f hV ↦ hSR V f
      ((coverPresieve_apply S f).mpr (hTS ((coverPresieve_apply T f).mp hV)))⟩
  · rintro ⟨S, hfin, hS, hSR⟩
    exact ⟨S, (finiteCovers_covers_iff_of_finite ι htop hinf hfin).mpr hS, hSR⟩

end TauCeti.GTopology
