public import TauCeti.Topology.GTopology.ContinuousMap

/-!
# Slightly finer G-topologies

The conditions (G0)–(G2) of [BGR, §9.1.2] on a G-topology are `GTopology.Saturated`, in
`TauCeti.Topology.GTopology.Basic`.

A G-topology `G'` on `X` is *slightly finer* than `G` (`GTopology.SlightlyFiner`, [BGR, 9.1.2/1])
if it is finer, the admissible opens of `G` form a basis of `G'`, and every `G'`-cover of a
`G`-admissible open is refined by a `G`-cover. This is the relation between the weak and the
strong G-topology of an affinoid space [BGR, 9.1.4], and sheaves extend uniquely along it
[BGR, 9.2.3/1].

`GTopology.finestSlightlyFiner` is the finest G-topology that is slightly finer than `G`
[BGR, 9.1.2/2]. Its admissible opens are the unions of admissible opens of `G`, that is, the open
sets of the topology they generate (`GTopology.isOpen_generateFrom_range_iff`). A covering of
such a union `V` is admissible when its restriction to every `G`-admissible open contained in `V`
is refined by a `G`-cover. We prove that it satisfies (G0)–(G2)
(`GTopology.saturated_finestSlightlyFiner`), that it is slightly finer than `G`
(`GTopology.slightlyFiner_finestSlightlyFiner`), and its universal property: every G-topology
slightly finer than `G` is coarser than `G.finestSlightlyFiner`
(`GTopology.SlightlyFiner.exists_continuousMap_finestSlightlyFiner`).

## References

* Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*, §§9.1.2, 9.1.4 and 9.2.3.
-/

public section

namespace TauCeti

open TopologicalSpace Topology

universe u v v'

namespace GTopology

variable {X : Type u} {B : Type v} [SemilatticeInf B] [OrderTop B] {ι : B ↪o Set X}
  {B' : Type v'} [SemilatticeInf B'] [OrderTop B'] {ι' : B' ↪o Set X}

/-- The G-topology `G'` on `X` is slightly finer than `G` [BGR, 9.1.2/1]: it is finer, the
admissible opens of `G` form a basis of `G'`, and every `G'`-cover of a `G`-admissible open is
refined by a `G`-cover. -/
structure SlightlyFiner (G' : GTopology ι') (G : GTopology ι) : Prop where
  /-- `G'` is finer than `G`: the identity of `X` is a continuous map from `G'` to `G`. -/
  exists_continuousMap : ∃ f : G'.ContinuousMap G, ∀ x, f x = x
  /-- Every `G'`-admissible open has a `G'`-cover by `G`-admissible opens. -/
  exists_covers : ∀ V : B', ∃ S : Set B', G'.Covers V S ∧ ∀ W ∈ S, ι' W ∈ Set.range ι
  /-- Every `G'`-cover of a `G`-admissible open is refined by a `G`-cover. -/
  exists_refinement : ∀ {U : B} {V : B'} {S : Set B'}, ι' V = ι U → G'.Covers V S →
    ∃ R : Set B, G.Covers U R ∧ ∀ W ∈ R, ∃ W' ∈ S, ι W ⊆ ι' W'

/-- The admissible opens of `GTopology.finestSlightlyFiner`: the open sets of the topology
generated by the admissible opens of `ι`. -/
abbrev GeneratedOpens (ι : B ↪o Set X) : Type u :=
  @Opens X (generateFrom (Set.range ι))

/-- The underlying subsets of the admissible opens of `GTopology.finestSlightlyFiner`. -/
abbrev generatedOpensEmbedding (ι : B ↪o Set X) : GeneratedOpens ι ↪o Set X :=
  @opensEmbedding X (generateFrom (Set.range ι))

omit [OrderTop B] in
theorem generatedOpensEmbedding_apply (V : GeneratedOpens ι) :
    generatedOpensEmbedding ι V = (V : Set X) :=
  @opensEmbedding_apply X (generateFrom (Set.range ι)) V

variable (ι) in
/-- Every admissible open of `ι` is an admissible open of `GTopology.finestSlightlyFiner`. -/
def toGeneratedOpens (U : B) : GeneratedOpens ι :=
  @Opens.mk X (generateFrom (Set.range ι)) (ι U) (.basic _ ⟨U, rfl⟩)

omit [OrderTop B] in
@[simp]
theorem coe_toGeneratedOpens (U : B) : (toGeneratedOpens ι U : Set X) = ι U :=
  @Opens.coe_mk X (generateFrom (Set.range ι)) _ _

/-- The finest G-topology slightly finer than `G` [BGR, 9.1.2/2]. Its admissible opens are the
unions of admissible opens of `G`. A covering `S` of such a union `V` is admissible if its
restriction to every `G`-admissible open contained in `V` is refined by a `G`-cover. -/
def finestSlightlyFiner (G : GTopology ι) : GTopology (generatedOpensEmbedding ι) where
  map_top := (@topological X (generateFrom (Set.range ι))).map_top
  map_inf := (@topological X (generateFrom (Set.range ι))).map_inf
  Covers V S := ⋃₀ ((↑) '' S) = (V : Set X) ∧
    ∀ U : B, ι U ⊆ V → ∃ R : Set B, G.Covers U R ∧ ∀ W ∈ R, ∃ W' ∈ S, ι W ⊆ W'
  subset {V S} h W hW := (generatedOpensEmbedding ι).le_iff_le.mp <| by
    simpa only [generatedOpensEmbedding_apply] using h.1 ▸ Set.subset_sUnion_of_mem ⟨W, hW, rfl⟩
  union_eq h := by
    simpa only [Set.image_congr fun V _ ↦ generatedOpensEmbedding_apply V,
      generatedOpensEmbedding_apply] using h.1
  identity V := ⟨by simp, fun U _ ↦ ⟨{U}, G.identity U, by simpa⟩⟩
  restriction := by
    let _ : TopologicalSpace X := generateFrom (Set.range ι)
    rintro V S ⟨hS, hloc⟩ V' hV'
    have hV'V : (V' : Set X) ⊆ V := SetLike.coe_subset_coe.mpr hV'
    refine ⟨?_, fun U hU ↦ ?_⟩
    · simp only [Set.sUnion_image, Set.biUnion_image, Opens.coe_inf] at hS ⊢
      rw [← Set.iUnion₂_inter, hS, Set.inter_eq_right.mpr hV'V]
    · obtain ⟨R, hR, hRS⟩ := hloc U (hU.trans hV'V)
      refine ⟨R, hR, fun W hW ↦ ?_⟩
      obtain ⟨W', hW', hWW'⟩ := hRS W hW
      refine ⟨W' ⊓ V', ⟨W', hW', rfl⟩, ?_⟩
      rw [Opens.coe_inf]
      exact Set.subset_inter hWW' ((ι.le_iff_le.mpr (G.subset hR W hW)).trans hU)
  transitive := by
    rintro V S T ⟨hS, hloc⟩ hT
    refine ⟨?_, fun U hU ↦ ?_⟩
    · simp only [Set.sUnion_image, Set.biUnion_iUnion] at hS hT ⊢
      rw [← hS]
      exact Set.iUnion₂_congr fun W hW ↦ (hT W hW).1
    · obtain ⟨R, hR, hRS⟩ := hloc U hU
      -- Refine each member of the first refinement through the cover of a member above it.
      choose! W' hW' hWW' using hRS
      choose! R' hR' hR'T using fun W (hW : W ∈ R) ↦ (hT (W' W) (hW' W hW)).2 W (hWW' W hW)
      refine ⟨⋃ W ∈ R, R' W, G.transitive hR hR', fun Z hZ ↦ ?_⟩
      simp only [Set.mem_iUnion] at hZ
      obtain ⟨W, hW, hZ⟩ := hZ
      obtain ⟨Z', hZ', hZZ'⟩ := hR'T W hW Z hZ
      exact ⟨Z', Set.mem_biUnion (hW' W hW) hZ', hZZ'⟩

/-- The admissible covers of `G.finestSlightlyFiner`. -/
@[simp]
theorem finestSlightlyFiner_covers_iff (G : GTopology ι) {V : GeneratedOpens ι}
    {S : Set (GeneratedOpens ι)} :
    G.finestSlightlyFiner.Covers V S ↔ ⋃₀ ((↑) '' S) = (V : Set X) ∧
      ∀ U : B, ι U ⊆ V → ∃ R : Set B, G.Covers U R ∧ ∀ W ∈ R, ∃ W' ∈ S, ι W ⊆ W' :=
  Iff.rfl

/-- The finest G-topology slightly finer than `G` satisfies (G0)–(G2). -/
theorem saturated_finestSlightlyFiner (G : GTopology ι) : G.finestSlightlyFiner.Saturated where
  empty_mem_range :=
    ⟨⊥, (generatedOpensEmbedding_apply _).trans (@Opens.coe_bot X (generateFrom (Set.range ι)))⟩
  mem_range_of_covers hS :=
    (@saturated_topological X (generateFrom (Set.range ι))).mem_range_of_covers
      ((@topological_covers_iff X (generateFrom (Set.range ι)) _ _).mpr hS.1)
  covers_of_refinement := by
    rintro U S R hS ⟨-, hR⟩ hRS
    refine ⟨?_, fun U' hU' ↦ ?_⟩
    · simpa only [Set.image_congr fun V _ ↦ generatedOpensEmbedding_apply V,
        generatedOpensEmbedding_apply] using hS
    obtain ⟨Q, hQ, hQR⟩ := hR U' hU'
    refine ⟨Q, hQ, fun W hW ↦ ?_⟩
    obtain ⟨W', hW', hWW'⟩ := hQR W hW
    obtain ⟨W'', hW'', hW'W''⟩ := hRS W' hW'
    exact ⟨W'', hW'', hWW'.trans hW'W''⟩

/-- The identity of `X`, as a continuous map from the finest G-topology slightly finer than `G`
to `G`. -/
def finestSlightlyFinerId (G : GTopology ι) : G.finestSlightlyFiner.ContinuousMap G where
  toFun := id
  comap := toGeneratedOpens ι
  coe_comap' U := by rw [generatedOpensEmbedding_apply, coe_toGeneratedOpens, Set.preimage_id]
  covers_comap {U S} hS := by
    refine ⟨by simpa [Set.sUnion_image] using G.union_eq hS, fun U' hU' ↦ ?_⟩
    rw [coe_toGeneratedOpens] at hU'
    refine ⟨(fun W ↦ W ⊓ U') '' S, G.restriction hS U' (ι.le_iff_le.mp hU'), ?_⟩
    rintro _ ⟨W, hW, rfl⟩
    exact ⟨toGeneratedOpens ι W, ⟨W, hW, rfl⟩, by
      simpa only [coe_toGeneratedOpens] using ι.monotone inf_le_left⟩

@[simp]
theorem coe_finestSlightlyFinerId (G : GTopology ι) : ⇑G.finestSlightlyFinerId = id :=
  ContinuousMap.coe_mk _ _ _ _

@[simp]
theorem finestSlightlyFinerId_comap (G : GTopology ι) :
    G.finestSlightlyFinerId.comap = toGeneratedOpens ι := (rfl)

/-- `G.finestSlightlyFiner` is slightly finer than `G`. -/
theorem slightlyFiner_finestSlightlyFiner (G : GTopology ι) :
    G.finestSlightlyFiner.SlightlyFiner G where
  exists_continuousMap := ⟨G.finestSlightlyFinerId, fun _ ↦ by rw [coe_finestSlightlyFinerId, id]⟩
  exists_covers V := by
    let _ : TopologicalSpace X := generateFrom (Set.range ι)
    refine ⟨toGeneratedOpens ι '' {U | ι U ⊆ V}, ⟨?_, fun U hU ↦ ?_⟩, ?_⟩
    · apply subset_antisymm
      · simp only [Set.sUnion_image, Set.biUnion_image, coe_toGeneratedOpens,
          Set.iUnion₂_subset_iff]
        exact fun U hU ↦ hU
      · intro x hx
        obtain ⟨U, hxU, hUV⟩ := (G.isOpen_generateFrom_range_iff).mp V.2 x hx
        exact Set.mem_sUnion.mpr ⟨ι U, ⟨_, ⟨U, hUV, rfl⟩, coe_toGeneratedOpens U⟩, hxU⟩
    · refine ⟨{U}, G.identity U, ?_⟩
      simp only [Set.mem_singleton_iff, forall_eq]
      exact ⟨_, ⟨U, hU, rfl⟩, (coe_toGeneratedOpens U).ge⟩
    · rintro _ ⟨U, -, rfl⟩
      exact ⟨U, by rw [generatedOpensEmbedding_apply, coe_toGeneratedOpens]⟩
  exists_refinement {U V S} hVU hS := by
    rw [generatedOpensEmbedding_apply] at hVU
    obtain ⟨R, hR, hRS⟩ := hS.2 U hVU.ge
    exact ⟨R, hR, by simpa only [generatedOpensEmbedding_apply] using hRS⟩

/-- The universal property of `G.finestSlightlyFiner` [BGR, 9.1.2/2]: every G-topology slightly
finer than `G` is coarser than `G.finestSlightlyFiner`, in the sense that the identity of `X` is a
continuous map from `G.finestSlightlyFiner` to it. -/
theorem SlightlyFiner.exists_continuousMap_finestSlightlyFiner {G : GTopology ι}
    {G' : GTopology ι'} (h : G'.SlightlyFiner G) :
    ∃ f : G.finestSlightlyFiner.ContinuousMap G', ∀ x, f x = x := by
  obtain ⟨g, hg⟩ := h.exists_continuousMap
  have hgU (U : B) : ι' (g.comap U) = ι U := by
    rw [g.coe_comap]
    ext x
    simp [hg]
  -- Every admissible open of `G'` is a union of admissible opens of `G`.
  have hopen (V : B') : IsOpen[generateFrom (Set.range ι)] (ι' V) := by
    rw [G.isOpen_generateFrom_range_iff]
    intro x hx
    obtain ⟨S, hS, hSG⟩ := h.exists_covers V
    rw [← G'.union_eq hS] at hx
    obtain ⟨_, ⟨W, hW, rfl⟩, hxW⟩ := hx
    obtain ⟨U, hU⟩ := hSG W hW
    exact ⟨U, hU ▸ hxW, hU ▸ ι'.le_iff_le.mpr (G'.subset hS W hW)⟩
  let φ (V : B') : GeneratedOpens ι := @Opens.mk X (generateFrom (Set.range ι)) _ (hopen V)
  have hφ (V : B') : (φ V : Set X) = ι' V := @Opens.coe_mk X (generateFrom (Set.range ι)) _ _
  refine ⟨⟨id, φ, fun V ↦ by rw [generatedOpensEmbedding_apply, hφ, Set.preimage_id],
    fun {V S} hS ↦ ⟨?_, fun U hU ↦ ?_⟩⟩, fun _ ↦ rfl⟩
  · simpa [Set.sUnion_image, hφ] using G'.union_eq hS
  · have hUV : g.comap U ≤ V := ι'.le_iff_le.mp ((hgU U).trans_subset hU)
    obtain ⟨R, hR, hRS⟩ :=
      h.exists_refinement (hgU U) (G'.restriction hS (g.comap U) hUV)
    refine ⟨R, hR, fun W hW ↦ ?_⟩
    obtain ⟨_, ⟨W', hW', rfl⟩, hWW'⟩ := hRS W hW
    exact ⟨φ W', ⟨W', hW', rfl⟩, (hφ W').symm ▸ hWW'.trans (ι'.monotone inf_le_left)⟩

end GTopology

end TauCeti
