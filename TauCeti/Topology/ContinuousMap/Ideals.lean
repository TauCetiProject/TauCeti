module

public import Mathlib.Topology.ContinuousMap.Compact
public import Mathlib.Topology.ContinuousMap.Ideals
public import Mathlib.Topology.ContinuousMap.Star

/-!
# Closures of principal ideals and point-evaluation kernels in `C(X, R)`

In `C(X, R)`, the open support `ContinuousMap.setOfIdeal (Ideal.span {f})` of a principal left
ideal is the nonvanishing locus `{x : X | f x ≠ 0}`, without any commutativity or domain
assumption on `R`. Over `RCLike` scalars on a compact space `X`, combining this with
`ContinuousMap.idealOfSet_ofIdeal_eq_closure` on compact Hausdorff images identifies the norm
closure `(Ideal.span {f}).closure` with the closed ideal of functions vanishing wherever `f`
vanishes (`ContinuousMap.closure_span_singleton_eq_idealOfSet`), without assuming `T2Space X`.

Point evaluation `ContinuousMap.evalAlgHom` (and `ContinuousMap.evalStarAlgHom`) at `x : X` has
kernel `ContinuousMap.idealOfSet R ({x}ᶜ)`, which is maximal over any topological division ring
`R` without compactness or separation hypotheses on `X`.
-/

public section

namespace ContinuousMap

/-- The nonvanishing set of the principal left ideal generated by `f : C(X, R)` is the support
`{x : X | f x ≠ 0}`. -/
@[simp]
theorem setOfIdeal_span_singleton {X R : Type*} [TopologicalSpace X] [Semiring R]
    [TopologicalSpace R] [IsTopologicalSemiring R] (f : C(X, R)) :
    setOfIdeal (Ideal.span ({f} : Set C(X, R))) = {x : X | f x ≠ 0} := by
  ext x
  simp only [mem_setOfIdeal, Set.mem_ofPred_eq]
  refine ⟨?_, fun hx ↦ ⟨f, Ideal.mem_span_singleton_self f, hx⟩⟩
  rintro ⟨g, hg, hgx⟩ hfx
  obtain ⟨h, rfl⟩ := Ideal.mem_span_singleton'.mp hg
  exact hgx (by simp [hfx])

/-- On any compact space `X` (without assuming `T2Space X`), the norm closure of the principal
ideal generated by `f : C(X, 𝕜)` consists of all continuous functions vanishing wherever `f`
vanishes. -/
theorem closure_span_singleton_eq_idealOfSet {X 𝕜 : Type*} [TopologicalSpace X]
    [CompactSpace X] [RCLike 𝕜] (f : C(X, 𝕜)) :
    (Ideal.span ({f} : Set C(X, 𝕜))).closure = idealOfSet 𝕜 {x : X | f x ≠ 0} := by
  refine le_antisymm ?_ fun g hg ↦ ?_
  · refine (idealOfSet_closed 𝕜 _).closure_subset_iff.mpr fun g hg x hx ↦ ?_
    obtain ⟨h, rfl⟩ := Ideal.mem_span_singleton'.mp hg
    have hfx : f x = 0 := by simpa using hx
    simp [hfx]
  · -- Factor `(f, g)` through its compact Hausdorff image `Y ⊆ 𝕜 × 𝕜` to apply Mathlib's result.
    let p : C(X, 𝕜 × 𝕜) := f.prodMk g
    let Y := Set.range p
    have : CompactSpace Y := isCompact_iff_compactSpace.mp (isCompact_range p.continuous)
    let q : C(X, Y) := ⟨Set.rangeFactorization p, p.continuous.subtype_mk _⟩
    let fY : C(Y, 𝕜) := ⟨fun y ↦ y.1.1, continuous_fst.comp continuous_subtype_val⟩
    let gY : C(Y, 𝕜) := ⟨fun y ↦ y.1.2, continuous_snd.comp continuous_subtype_val⟩
    have hgY : gY ∈ (Ideal.span ({fY} : Set C(Y, 𝕜))).closure := by
      rw [← idealOfSet_ofIdeal_eq_closure, setOfIdeal_span_singleton, mem_idealOfSet]
      rintro ⟨_, x, rfl⟩ hx
      have hfx : f x = 0 := by simpa [fY, p] using hx
      simpa [gY, p] using mem_idealOfSet.mp hg (by simpa using hfx)
    let pull := compRightAlgHom 𝕜 𝕜 q
    have hpull_cont : Continuous pull := compRightAlgHom_continuous 𝕜 𝕜 q
    have hpull_span : pull '' (Ideal.span ({fY} : Set C(Y, 𝕜)) : Set C(Y, 𝕜)) ⊆
        (Ideal.span ({f} : Set C(X, 𝕜)) : Set C(X, 𝕜)) := by
      rintro _ ⟨u, hu, rfl⟩
      obtain ⟨h, rfl⟩ := Ideal.mem_span_singleton'.mp hu
      rw [map_mul]
      exact Ideal.mem_span_singleton'.mpr ⟨pull h, by ext x; rfl⟩
    have hmem := image_closure_subset_closure_image hpull_cont ⟨gY, hgY, by ext x; rfl⟩
    exact closure_mono hpull_span hmem

/-- The kernel of point evaluation `ContinuousMap.evalAlgHom S R x` is the ideal of functions
vanishing at `x`. -/
@[simp]
theorem ker_evalAlgHom_eq_idealOfSet {X : Type*} (S R : Type*) [TopologicalSpace X]
    [CommSemiring S] [CommSemiring R] [Algebra S R] [TopologicalSpace R]
    [IsTopologicalSemiring R] (x : X) :
    RingHom.ker (evalAlgHom S R x) = idealOfSet R ({x}ᶜ : Set X) := by
  ext f
  simp

/-- The kernel of point evaluation `ContinuousMap.evalStarAlgHom S R x` is the ideal of functions
vanishing at `x`. -/
@[simp]
theorem ker_evalStarAlgHom_eq_idealOfSet {X : Type*} (S R : Type*) [TopologicalSpace X]
    [CommSemiring S] [CommSemiring R] [Algebra S R] [StarRing R] [TopologicalSpace R]
    [IsTopologicalSemiring R] [ContinuousStar R] (x : X) :
    RingHom.ker (evalStarAlgHom S R x) = idealOfSet R ({x}ᶜ : Set X) := by
  ext f
  simp

/-- For any topological space `X` and topological division ring `R`, the ideal of continuous
functions vanishing at `x : X` is maximal. Unlike
`ContinuousMap.idealOf_compl_singleton_isMaximal`, this requires no compactness, separation, or
`RCLike` hypothesis. -/
instance instIsMaximalIdealOfSetComplSingleton {X R : Type*} [TopologicalSpace X]
    [DivisionRing R] [TopologicalSpace R] [IsTopologicalSemiring R] (x : X) :
    (idealOfSet R ({x}ᶜ : Set X)).IsMaximal := by
  have hneg : (fun r : R ↦ -r) = ((-1 : R) * ·) := funext fun r ↦ (neg_one_mul r).symm
  have : ContinuousNeg R := ⟨hneg ▸ continuous_const.mul continuous_id⟩
  have : IsTopologicalRing R := {}
  let ev : C(X, R) →+* R := (Pi.evalRingHom (fun _ ↦ R) x).comp coeFnRingHom
  have hker : RingHom.ker ev = idealOfSet R ({x}ᶜ : Set X) := by
    ext f
    simp [ev]
  rw [← hker]
  exact RingHom.ker_isMaximal_of_surjective ev fun r ↦ ⟨ContinuousMap.const X r, rfl⟩

end ContinuousMap
