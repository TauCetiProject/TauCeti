module

public import Mathlib.Topology.ContinuousMap.Compact
public import Mathlib.Topology.ContinuousMap.Ideals
public import Mathlib.Topology.ContinuousMap.Star

/-!
# Ideals, point evaluation and evaluation-kernel star subalgebras of `C(X, R)`

In `C(X, R)`, the nonvanishing set `ContinuousMap.setOfIdeal (Ideal.span s)` of the left ideal
generated by `s` is the union of the nonvanishing loci `{x : X | f x ≠ 0}` for `f ∈ s`, without
any commutativity, separation, or domain assumption on `R`. Over `RCLike` scalars on any compact
space `X` (without assuming `T2Space X`), factoring evaluation through the compact Hausdorff image
of `X` in `C(X, 𝕜) → 𝕜` extends Mathlib's `ContinuousMap.idealOfSet_ofIdeal_eq_closure` to
`ContinuousMap.idealOfSet_ofIdeal_eq_closure_of_compact` and, for principal ideals,
`ContinuousMap.closure_span_singleton_eq_idealOfSet`.

Point evaluation `ContinuousMap.evalAlgHom` (and `ContinuousMap.evalStarAlgHom`) at `x : X` has
kernel `ContinuousMap.idealOfSet R ({x}ᶜ)`, which is maximal over any topological division ring
`R` without compactness or separation hypotheses on `X` (generalizing Mathlib's
`ContinuousMap.idealOf_compl_singleton_isMaximal`).

Mathlib constructs the vanishing ideal `ContinuousMap.idealOfSet` on `C(X, R)` and the evaluation
homeomorphism `WeakDual.CharacterSpace.homeoEval : X ≃ₜ characterSpace 𝕜 C(X, 𝕜)` for compact
Hausdorff `X` and `RCLike 𝕜`.

This file provides:
* `WeakDual.CharacterSpace.homeoEval_apply`: the `@[simp]` evaluation formula
  `homeoEval X 𝕜 x f = f x`;
* `ContinuousMap.evalKerSubalgebra`: the nonunital star subalgebra `{F ∈ C(K, A) : F x₀ = 0}` of
  continuous functions vanishing at `x₀ : K` for any topological semiring `A` with continuous star,
  which is closed when `A` is `T₁` (`ContinuousMap.isClosed_evalKerSubalgebra`) and has the same
  carrier as Mathlib's vanishing-ideal construction `ContinuousMap.idealOfSet A ({x₀}ᶜ)` when `A` is
  unital (`ContinuousMap.coe_evalKerSubalgebra_eq_idealOfSet`).
-/

public section

namespace WeakDual.CharacterSpace

/-- `WeakDual.CharacterSpace.homeoEval` evaluates a continuous function at the given point. -/
@[simp]
theorem homeoEval_apply {X 𝕜 : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X]
    [RCLike 𝕜] (x : X) (f : C(X, 𝕜)) :
    homeoEval X 𝕜 x f = f x := (rfl)

end WeakDual.CharacterSpace

namespace ContinuousMap

variable {K S A : Type*} [TopologicalSpace K]

variable (S A) in
/-- The evaluation-kernel nonunital star subalgebra `{F ∈ C(K, A) : F x₀ = 0}` of continuous
functions vanishing at a point `x₀ : K`. -/
def evalKerSubalgebra [CommSemiring S] [NonUnitalNonAssocSemiring A] [TopologicalSpace A]
    [IsTopologicalSemiring A] [StarAddMonoid A] [ContinuousStar A] [Module S A]
    [ContinuousConstSMul S A] (x₀ : K) :
    NonUnitalStarSubalgebra S C(K, A) where
  carrier := {F : C(K, A) | F x₀ = 0}
  mul_mem' {f g} hf hg := by simp_all
  add_mem' {f g} hf hg := by simp_all
  zero_mem' := rfl
  smul_mem' c {f} hf := by simp_all
  star_mem' {f} hf := by simp_all

/-- Membership in `evalKerSubalgebra S A x₀` means vanishing at `x₀`. -/
@[simp]
theorem mem_evalKerSubalgebra [CommSemiring S] [NonUnitalNonAssocSemiring A] [TopologicalSpace A]
    [IsTopologicalSemiring A] [StarAddMonoid A] [ContinuousStar A] [Module S A]
    [ContinuousConstSMul S A] {x₀ : K} {F : C(K, A)} :
    F ∈ evalKerSubalgebra S A x₀ ↔ F x₀ = 0 :=
  Iff.rfl

/-- The underlying set of `evalKerSubalgebra S A x₀` is `{F : C(K, A) | F x₀ = 0}`. -/
@[simp, norm_cast]
theorem coe_evalKerSubalgebra [CommSemiring S] [NonUnitalNonAssocSemiring A] [TopologicalSpace A]
    [IsTopologicalSemiring A] [StarAddMonoid A] [ContinuousStar A] [Module S A]
    [ContinuousConstSMul S A] (x₀ : K) :
    (evalKerSubalgebra S A x₀ : Set C(K, A)) = {F : C(K, A) | F x₀ = 0} := (rfl)

/-- For `T₁` codomain `A`, `evalKerSubalgebra S A x₀` is closed in `C(K, A)`. -/
theorem isClosed_evalKerSubalgebra [CommSemiring S] [NonUnitalNonAssocSemiring A]
    [TopologicalSpace A] [T1Space A] [IsTopologicalSemiring A] [StarAddMonoid A] [ContinuousStar A]
    [Module S A] [ContinuousConstSMul S A] (x₀ : K) :
    IsClosed (evalKerSubalgebra S A x₀ : Set C(K, A)) :=
  isClosed_singleton.preimage (continuous_eval_const x₀)

/-- When `A` is unital, `evalKerSubalgebra S A x₀` has the same carrier as Mathlib's vanishing-ideal
construction `ContinuousMap.idealOfSet A ({x₀}ᶜ)`. -/
theorem coe_evalKerSubalgebra_eq_idealOfSet [CommSemiring S] [Semiring A] [TopologicalSpace A]
    [IsTopologicalSemiring A] [StarAddMonoid A] [ContinuousStar A] [Module S A]
    [ContinuousConstSMul S A] (x₀ : K) :
    (evalKerSubalgebra S A x₀ : Set C(K, A)) = (idealOfSet A ({x₀}ᶜ : Set K) : Set C(K, A)) := by
  ext F
  simp

end ContinuousMap

namespace ContinuousMap

/-- The nonvanishing set of the left ideal generated by `s : Set C(X, R)` is the union of the
nonvanishing sets `{x : X | f x ≠ 0}` for `f ∈ s`. -/
theorem setOfIdeal_span {X R : Type*} [TopologicalSpace X] [Semiring R]
    [TopologicalSpace R] [IsTopologicalSemiring R] (s : Set C(X, R)) :
    setOfIdeal (Ideal.span s) = ⋃ f ∈ s, {x : X | f x ≠ 0} := by
  ext x
  simp only [mem_setOfIdeal, Set.mem_iUnion, Set.mem_ofPred_eq, exists_prop]
  refine ⟨fun ⟨g, hg, hgx⟩ ↦ ?_, fun ⟨f, hf, hfx⟩ ↦ ⟨f, Ideal.subset_span hf, hfx⟩⟩
  by_contra! hall
  have hle : Ideal.span s ≤ idealOfSet R ({x}ᶜ : Set X) :=
    Ideal.span_le.mpr fun f hf ↦ (mem_idealOfSet_compl_singleton x f).mpr (hall f hf)
  exact hgx ((mem_idealOfSet_compl_singleton x g).mp (hle hg))

/-- The nonvanishing set of the principal left ideal generated by `f : C(X, R)` is
`{x : X | f x ≠ 0}`. -/
@[simp]
theorem setOfIdeal_span_singleton {X R : Type*} [TopologicalSpace X] [Semiring R]
    [TopologicalSpace R] [IsTopologicalSemiring R] (f : C(X, R)) :
    setOfIdeal (Ideal.span ({f} : Set C(X, R))) = {x : X | f x ≠ 0} := by
  simp [setOfIdeal_span]

/-- On any compact space `X` (without assuming `T2Space X`), the norm closure of an ideal
`I : Ideal C(X, 𝕜)` equals `ContinuousMap.idealOfSet 𝕜 (ContinuousMap.setOfIdeal I)`. -/
theorem idealOfSet_ofIdeal_eq_closure_of_compact {X 𝕜 : Type*} [TopologicalSpace X]
    [CompactSpace X] [RCLike 𝕜] (I : Ideal C(X, 𝕜)) :
    idealOfSet 𝕜 (setOfIdeal I) = I.closure := by
  refine le_antisymm (fun g hg ↦ ?_)
    ((idealOfSet_closed 𝕜 _).closure_subset_iff.mpr ((ideal_gc X 𝕜 _ _).mp le_rfl))
  -- Factor `X` through its compact Hausdorff evaluation image `Y ⊆ (C(X, 𝕜) → 𝕜)`.
  let ev : C(X, C(X, 𝕜) → 𝕜) := ⟨fun x f ↦ f x, continuous_pi fun f ↦ f.continuous⟩
  let Y := Set.range ev
  have : CompactSpace Y := isCompact_iff_compactSpace.mp (isCompact_range ev.continuous)
  let q : C(X, Y) := ⟨Set.rangeFactorization ev, ev.continuous.subtype_mk _⟩
  let pull : C(Y, 𝕜) →ₐ[𝕜] C(X, 𝕜) := compRightAlgHom 𝕜 𝕜 q
  let toY (f : C(X, 𝕜)) : C(Y, 𝕜) :=
    ⟨fun y ↦ y.val f, (continuous_apply f).comp continuous_subtypeVal⟩
  have hpull_eq (f : C(X, 𝕜)) : pull (toY f) = f := by
    ext x
    simp [pull, toY, q, ev]
  let J : Ideal C(Y, 𝕜) := I.comap pull.toRingHom
  have hgY : toY g ∈ J.closure := by
    rw [← idealOfSet_ofIdeal_eq_closure, mem_idealOfSet]
    rintro ⟨_, x, rfl⟩ hx
    have hxI : x ∈ (setOfIdeal I)ᶜ := by
      rw [Set.mem_compl_iff, notMem_setOfIdeal]
      intro f hf
      have hfJ : toY f ∈ J := by
        rw [Ideal.mem_comap]
        simpa [hpull_eq f] using hf
      have h0 : toY f ⟨ev x, x, rfl⟩ = 0 := notMem_setOfIdeal.mp hx hfJ
      simpa [toY, ev] using h0
    simpa [toY, ev] using mem_idealOfSet.mp hg hxI
  have hmem := image_closure_subset_closure_image (compRightAlgHom_continuous 𝕜 𝕜 q)
    ⟨toY g, hgY, hpull_eq g⟩
  exact closure_mono (by rintro _ ⟨h, hh, rfl⟩; simpa [J, pull] using hh) hmem

/-- On any compact space `X` (without assuming `T2Space X`), the norm closure of the principal
ideal generated by `f : C(X, 𝕜)` consists of all continuous functions vanishing wherever `f`
vanishes. -/
theorem closure_span_singleton_eq_idealOfSet {X 𝕜 : Type*} [TopologicalSpace X]
    [CompactSpace X] [RCLike 𝕜] (f : C(X, 𝕜)) :
    (Ideal.span ({f} : Set C(X, 𝕜))).closure = idealOfSet 𝕜 {x : X | f x ≠ 0} := by
  rw [← idealOfSet_ofIdeal_eq_closure_of_compact, setOfIdeal_span_singleton]

/-- The kernel of point evaluation `ContinuousMap.evalAlgHom S R x` is the ideal of functions
vanishing at `x`. -/
@[simp]
theorem ker_evalAlgHom_eq_idealOfSet {X : Type*} (S R : Type*) [TopologicalSpace X]
    [CommSemiring S] [CommSemiring R] [Algebra S R] [TopologicalSpace R]
    [IsTopologicalSemiring R] (x : X) :
    RingHom.ker (evalAlgHom S R x) = idealOfSet R ({x}ᶜ : Set X) := by
  ext f
  simp

/-- The kernel of point evaluation `ContinuousMap.evalStarAlgHom S R x` is the ideal of functions
vanishing at `x`. -/
@[simp]
theorem ker_evalStarAlgHom_eq_idealOfSet {X : Type*} (S R : Type*) [TopologicalSpace X]
    [CommSemiring S] [CommSemiring R] [Algebra S R] [StarRing R] [TopologicalSpace R]
    [IsTopologicalSemiring R] [ContinuousStar R] (x : X) :
    RingHom.ker (evalStarAlgHom S R x) = idealOfSet R ({x}ᶜ : Set X) := by
  ext f
  simp

/-- For any topological space `X` and topological division ring `R`, the ideal of continuous
functions vanishing at `x : X` is maximal. Unlike
`ContinuousMap.idealOf_compl_singleton_isMaximal`, this requires no compactness, separation, or
`RCLike` hypothesis. -/
instance instIsMaximalIdealOfSetComplSingleton {X R : Type*} [TopologicalSpace X]
    [DivisionRing R] [TopologicalSpace R] [IsTopologicalSemiring R] (x : X) :
    (idealOfSet R ({x}ᶜ : Set X)).IsMaximal := by
  have := IsTopologicalSemiring.toIsTopologicalRing (R := R) inferInstance
  let ev : C(X, R) →+* R := (Pi.evalRingHom (fun _ ↦ R) x).comp coeFnRingHom
  have hker : RingHom.ker ev = idealOfSet R ({x}ᶜ : Set X) := by
    ext f
    simp [ev]
  rw [← hker]
  exact RingHom.ker_isMaximal_of_surjective ev fun r ↦ ⟨ContinuousMap.const X r, by simp [ev]⟩

end ContinuousMap
