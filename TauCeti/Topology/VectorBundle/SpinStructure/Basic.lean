module

public import TauCeti.Topology.Algebra.CliffordAlgebra.Spin.SpinC
public import TauCeti.Topology.VectorBundle.OrthonormalFrame.Lift

/-!
# Spin and `Spinᶜ` structures on real vector bundles with fibre inner products

Let `E → X` be a real vector bundle with model fibre `F` and fibre inner products. A *Spin
structure* of rank `n` on `E` (`TauCeti.SpinStructure`) is a principal `Spin(n)`-bundle `P → X`,
where `Spin(n)` is the compact group `CliffordAlgebra.realCliffordSpinGroupZero n` with its
subspace topology, together with a continuous map `P → Fr(E)` to the orthonormal frame bundle of
`E` modelled on `ℝⁿ`, covering the identity of `X` and equivariant along the vector action
`Spin(n) → SO(n)`, `g ↦ (v ↦ g v g⁻¹)` (`CliffordAlgebra.spinVectorAction`): the frame of
`p • g` sends `v` to the frame of `p` applied to `g v g⁻¹`
(`TauCeti.SpinStructure.toFrame_smul_spinVectorAction`).

A *`Spinᶜ` structure* of rank `n ≥ 1` on `E` (`TauCeti.SpinCStructure`) is the same with the
group `Spinᶜ(n) = (Spin(n) × U(1)) / {±(1, 1)}` (`CliffordAlgebra.spinCGroup`), with its quotient
topology, in place of `Spin(n)`, and its rotation homomorphism `[s, z] ↦ π(s)`
(`CliffordAlgebra.spinCGroup.toSpecialOrthogonal`) in place of the vector action: the frame of
`p • [s, z]` sends `v` to the frame of `p` applied to `s v s⁻¹`
(`TauCeti.SpinCStructure.toFrame_smul_mk`). In particular the central circle `[1, z]` acts
trivially on frames (`TauCeti.SpinCStructure.toFrame_smul_ofCircle`), so it acts on the fibres of
`P → Fr(E)`. The determinant line of the structure is the line associated to `P` by the
determinant character `[s, z] ↦ z²`; associated principal bundles, and hence that line, are not
constructed here. On an almost Hermitian four-manifold the canonical `Spinᶜ` structure is the
one induced from the unitary frame bundle by the canonical lift `U(2) → Spinᶜ(4)`, and
Seiberg–Witten theory is set up on the spinor bundles of a `Spinᶜ` structure, which need not
come from a Spin structure.

Both are lifts of the orthonormal frame bundle along a homomorphism into the linear automorphisms
of `ℝⁿ` (`TauCeti.OrthonormalFrameLift`), which supplies their equivalences
(`TauCeti.OrthonormalFrameLift.Equiv`) and pullbacks (`TauCeti.OrthonormalFrameLift.pullback`).
Each fibre of `P` is a torsor, so its image is one `SO(n)`-orbit of frames, and the orientation of
`E` is the one for which these frames are positive: a Spin or `Spinᶜ` structure chooses an
orientation of `E`, and equivalences, which preserve the frame map, preserve it. There is no
numerability field; on paracompact Hausdorff bases every principal bundle is numerable.

The native `Spin(0)`, generated by the invertible vectors of the zero space, is trivial, so a
rank-zero Spin structure in this sense carries no double cover; the classical rank-zero Spin
structures, double covers of the base, are not modelled here. `Spinᶜ(Q)` is only defined for a
nonzero form `Q`, which for the standard form on `ℝⁿ` means `n ≥ 1`
(`QuadraticMap.Nondegenerate.ne_zero`).

## Main definitions

* `TauCeti.SpinStructure`: a Spin structure of rank `n` on a real vector bundle with fibre inner
  products.
* `TauCeti.SpinCStructure`: a `Spinᶜ` structure of rank `n ≥ 1` on a real vector bundle with
  fibre inner products.

## Main results

* `TauCeti.SpinStructure.toFrame_smul_spinVectorAction`: the frame map of a Spin structure is
  equivariant along the vector action of `Spin(n)`.
* `TauCeti.SpinCStructure.toFrame_smul_mk`: the frame map of a `Spinᶜ` structure is equivariant
  along `[s, z] ↦ (v ↦ s v s⁻¹)`.
* `TauCeti.SpinCStructure.toFrame_smul_ofCircle`: the central circle of `Spinᶜ(n)` acts trivially
  on frames.

## References

* R. C. Kirby, *The topology of 4-manifolds*, Lecture Notes in Mathematics 1374, Springer, 1989,
  Chapter IV, p. 33.
* H. B. Lawson, M.-L. Michelsohn, *Spin Geometry*, Princeton University Press, 1989, Chapter II,
  §1 and Appendix D.
* J. W. Morgan, *The Seiberg–Witten equations and applications to the topology of smooth
  four-manifolds*, Mathematical Notes 44, Princeton University Press, 1996, §3.1.
-/

public section

open Bundle MulOpposite CliffordAlgebra

universe w

namespace TauCeti

variable {X : Type*} [TopologicalSpace X] (F : Type*) (E : X → Type w)
  [TopologicalSpace (TotalSpace F E)]
  [∀ x, NormedAddCommGroup (E x)] [∀ x, InnerProductSpace ℝ (E x)] (n : ℕ)

/-- A **Spin structure** of rank `n` on a real vector bundle `E` with model fibre `F` and fibre
inner products: a principal `Spin(n)`-bundle `P` over the base, where `Spin(n)` is the compact group
`realCliffordSpinGroupZero n` with its subspace topology, together with a continuous map to the
orthonormal frame bundle of `E` over the identity, equivariant along the vector action
`Spin(n) → SO(n)`: the frame of `p • g` sends `v` to the frame of `p` applied to `g v g⁻¹`. For
`n = 0` the native `Spin(0)` is trivial, so this is the classical notion only for `n ≥ 1`. -/
abbrev SpinStructure : Type _ :=
  OrthonormalFrameLift F E n (realCliffordSpinGroupZero n)
    ((QuadraticMap.specialOrthogonalGroup (realCliffordForm n 0)).subtype.comp
      (spinToSpecialOrthogonal (realCliffordForm n 0)))

/-- A **`Spinᶜ` structure** of rank `n ≥ 1` on a real vector bundle `E` with model fibre `F` and
fibre inner products: a principal `Spinᶜ(n)`-bundle `P` over the base, where
`Spinᶜ(n) = (Spin(n) × U(1)) / {±(1, 1)}` carries its quotient topology, together with a
continuous map to the orthonormal frame bundle of `E` over the identity, equivariant along the
rotation homomorphism `Spinᶜ(n) → SO(n)`, `[s, z] ↦ π(s)`: the frame of `p • [s, z]` sends `v` to
the frame of `p` applied to `s v s⁻¹`. -/
abbrev SpinCStructure [NeZero n] : Type _ :=
  OrthonormalFrameLift F E n
    (spinCGroup (realCliffordForm n 0)
      (QuadraticMap.Nondegenerate.ne_zero (nondegenerate_realCliffordForm n 0)))
    ((QuadraticMap.specialOrthogonalGroup (realCliffordForm n 0)).subtype.comp
      (spinCGroup.toSpecialOrthogonal (realCliffordForm n 0) _))

variable {F E n}

/-- **The frame map of a Spin structure is equivariant along the vector action**: the frame of
`p • g` sends `v` to the frame of `p` applied to `g v g⁻¹`. -/
theorem SpinStructure.toFrame_smul_spinVectorAction (s : SpinStructure F E n) (x : X) (p : s.P x)
    (g : realCliffordSpinGroupZero n) (v : Fin n → ℝ) :
    TotalSpace.mk' F (s.toFrame ⟨x, op g • p⟩).proj
        ((s.toFrame ⟨x, op g • p⟩).frame (WithLp.toLp 2 v)) =
      TotalSpace.mk' F (s.toFrame ⟨x, p⟩).proj
        ((s.toFrame ⟨x, p⟩).frame (WithLp.toLp 2 (spinVectorAction _ g v))) := by
  simpa using s.toFrame_smul x p g v

namespace SpinCStructure

variable [NeZero n]

/-- The proof that the standard form on `ℝⁿ`, `n ≥ 1`, is nonzero, on which `Spinᶜ(n)` depends. -/
local notation "hQ" => QuadraticMap.Nondegenerate.ne_zero (nondegenerate_realCliffordForm n 0)

/-- **The frame map of a `Spinᶜ` structure is equivariant along the rotation homomorphism**: the
frame of `p • [g, z]` sends `v` to the frame of `p` applied to `g v g⁻¹`, whatever `z`. -/
theorem toFrame_smul_mk (s : SpinCStructure F E n) (x : X) (p : s.P x)
    (g : realCliffordSpinGroupZero n) (z : Circle) (v : Fin n → ℝ) :
    TotalSpace.mk' F (s.toFrame ⟨x, op (spinCGroup.mk _ hQ (g, z)) • p⟩).proj
        ((s.toFrame ⟨x, op (spinCGroup.mk _ hQ (g, z)) • p⟩).frame (WithLp.toLp 2 v)) =
      TotalSpace.mk' F (s.toFrame ⟨x, p⟩).proj
        ((s.toFrame ⟨x, p⟩).frame (WithLp.toLp 2 (spinVectorAction _ g v))) := by
  simpa using s.toFrame_smul x p (spinCGroup.mk _ hQ (g, z)) v

/-- **The central circle of `Spinᶜ(n)` acts trivially on frames**: the frame of `p • [1, z]` is the
frame of `p`. -/
@[simp]
theorem toFrame_smul_ofCircle (s : SpinCStructure F E n) (x : X) (p : s.P x) (z : Circle) :
    s.toFrame ⟨x, op (spinCGroup.ofCircle _ hQ z) • p⟩ = s.toFrame ⟨x, p⟩ :=
  s.toFrame_smul_of_map_eq_one (by simp) x p

end SpinCStructure

end TauCeti
