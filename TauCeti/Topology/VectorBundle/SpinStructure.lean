/-!
# Spin structures on real vector bundles with fibre inner products

Let `E → X` be a real vector bundle with model fibre `F` and fibre inner products, and let
`n ≥ 1`. A *Spin structure* of rank `n` on `E` (`TauCeti.SpinStructure`) is a principal
`Spin(n)`-bundle `P → X`, where `Spin(n)` is the compact group
`CliffordAlgebra.realCliffordSpinGroupZero n` with its subspace topology, together with a
continuous map `P → Fr(E)` to the orthonormal frame bundle of `E` modelled on `ℝⁿ`, covering the
identity of `X` and equivariant along the vector action `Spin(n) → SO(n)`,
`g ↦ (v ↦ g v g⁻¹)` (`CliffordAlgebra.spinVectorAction`): the frame of `p • g` sends `v` to the
frame of `p` applied to `g v g⁻¹`.

The frame map lands in the full orthonormal frame bundle. Each fibre of `P` is a
`Spin(n)`-torsor, so its image is one `SO(n)`-orbit of frames, and the orientation of `E` is the
one for which these frames are positive: a Spin structure chooses an orientation of `E`, and
equivalences, which preserve the frame map, preserve it. There is no numerability field; on
paracompact Hausdorff bases every principal bundle is numerable. Positive rank is required
because the native `Spin(0)`, generated by the invertible vectors of the zero space, is trivial.

An *equivalence* of Spin structures (`TauCeti.SpinStructure.Equiv`) is a family of equivariant
bijections between the fibres of the two principal bundles, inducing a homeomorphism of total
spaces (`TauCeti.SpinStructure.Equiv.toHomeomorph`) and commuting with the frame maps.
Equivalences have identities, inverses and composites.

The *pullback* of a Spin structure along a continuous map `f : Y → X`
(`TauCeti.SpinStructure.pullback`) is the pulled-back principal bundle `f *ᵖ P` with the frame map
read through the identification of the frames of `f *ᵖ E` at `y` with the frames of `E` at `f y`
(`TauCeti.OrthonormalFrameBundle.pullbackHomeomorph`). Equivalences pull back to equivalences
(`TauCeti.SpinStructure.Equiv.pullback`).

## Main definitions

* `TauCeti.SpinStructure`: a Spin structure of rank `n ≥ 1` on a real vector bundle with fibre
  inner products.
* `TauCeti.SpinStructure.Equiv`: equivalences of Spin structures, with `refl`, `symm`, `trans`.
* `TauCeti.SpinStructure.pullback`: the pullback of a Spin structure along a continuous map.
* `TauCeti.SpinStructure.Equiv.pullback`: the pullback of an equivalence.

## References

* R. C. Kirby, *The topology of 4-manifolds*, Lecture Notes in Mathematics 1374, Springer, 1989,
  Chapter IV, p. 33.
* H. B. Lawson, M.-L. Michelsohn, *Spin Geometry*, Princeton University Press, 1989, Chapter II,
  §1.
-/

public section

open Bundle MulOpposite CliffordAlgebra

universe w

namespace TauCeti

/-- A **Spin structure** of rank `n ≥ 1` on a real vector bundle `E` with model fibre `F` and fibre
inner products: a principal `Spin(n)`-bundle `P` over the base, where `Spin(n)` is the compact group
`realCliffordSpinGroupZero n` with its subspace topology, together with a continuous map to the
orthonormal frame bundle of `E` over the identity, equivariant along the vector action
`Spin(n) → SO(n)`: the frame of `p • g` sends `v` to the frame of `p` applied to `g v g⁻¹`.
Each fibre of `P` is a `Spin(n)`-torsor, so its image is one `SO(n)`-orbit of frames, and the
orientation of `E` is the one for which these frames are positive. Positive rank is required: the
native `Spin(0)` is trivial. -/
structure SpinStructure {X : Type*} [TopologicalSpace X] (F : Type*) (E : X → Type w)
    [TopologicalSpace (TotalSpace F E)]
    [∀ x, NormedAddCommGroup (E x)] [∀ x, InnerProductSpace ℝ (E x)] (n : ℕ) [NeZero n] where
  /-- The fibres of the principal `Spin(n)`-bundle. -/
  P : X → Type w
  /-- The topology of the total space of `P`. -/
  [topTotal : TopologicalSpace (TotalSpace (realCliffordSpinGroupZero n) P)]
  /-- The topologies of the fibres of `P`. -/
  [topFiber : ∀ x, TopologicalSpace (P x)]
  /-- The right action of `Spin(n)` on the fibres of `P`. -/
  [act : ∀ x, MulAction (realCliffordSpinGroupZero n)ᵐᵒᵖ (P x)]
  /-- `P` is a fibre bundle with model fibre `Spin(n)`. -/
  [fiberBundle : FiberBundle (realCliffordSpinGroupZero n) P]
  /-- The trivializations of the atlas of `P` are equivariant. -/
  [principal : PrincipalBundle (realCliffordSpinGroupZero n) P]
  /-- The map to the orthonormal frames of `E`. -/
  toFrame : TotalSpace (realCliffordSpinGroupZero n) P →
    OrthonormalFrameBundle ℝ F E (EuclideanSpace ℝ (Fin n))
  /-- The map to frames is continuous. -/
  continuous_toFrame : Continuous toFrame
  /-- The map to frames covers the identity of the base. -/
  proj_toFrame : ∀ p, (toFrame p).proj = p.proj
  /-- The map to frames is equivariant along the vector action of `Spin(n)`. -/
  toFrame_smul : ∀ (x : X) (p : P x) (g : realCliffordSpinGroupZero n) (v : Fin n → ℝ),
    TotalSpace.mk' F (toFrame ⟨x, op g • p⟩).proj
        ((toFrame ⟨x, op g • p⟩).frame (WithLp.toLp 2 v)) =
      TotalSpace.mk' F (toFrame ⟨x, p⟩).proj
        ((toFrame ⟨x, p⟩).frame (WithLp.toLp 2 (spinVectorAction _ g v)))

namespace SpinStructure

attribute [instance] topTotal topFiber act fiberBundle principal

attribute [simp] proj_toFrame

variable {X : Type*} [TopologicalSpace X] {F : Type*} {E : X → Type w}
  [TopologicalSpace (TotalSpace F E)]
  [∀ x, NormedAddCommGroup (E x)] [∀ x, InnerProductSpace ℝ (E x)] {n : ℕ} [NeZero n]

/-- The fibres of the principal bundle of a Spin structure are nonempty: each is homeomorphic to
`Spin(n)`. -/
instance nonempty_P (s : SpinStructure F E n) (x : X) : Nonempty (s.P x) :=
  ⟨(FiberBundle.homeomorphAt (realCliffordSpinGroupZero n) s.P x).symm 1⟩

/-! ### Equivalences -/

/-- An **equivalence of Spin structures** `s ≃ t` on the same bundle: a family of bijections
between the fibres of their principal bundles, equivariant for the right action of `Spin(n)`,
inducing continuous maps of total spaces in both directions, and commuting with the maps to the
orthonormal frame bundle. -/
structure Equiv (s t : SpinStructure F E n) where
  /-- The bijection between fibres. -/
  toEquiv : ∀ x, s.P x ≃ t.P x
  /-- The induced map of total spaces is continuous. -/
  continuous_toFun : Continuous fun p : TotalSpace (realCliffordSpinGroupZero n) s.P ↦
    (⟨p.proj, toEquiv p.proj p.2⟩ : TotalSpace (realCliffordSpinGroupZero n) t.P)
  /-- The inverse map of total spaces is continuous. -/
  continuous_invFun : Continuous fun p : TotalSpace (realCliffordSpinGroupZero n) t.P ↦
    (⟨p.proj, (toEquiv p.proj).symm p.2⟩ : TotalSpace (realCliffordSpinGroupZero n) s.P)
  /-- The bijection is equivariant. -/
  map_smul : ∀ (x : X) (p : s.P x) (g : realCliffordSpinGroupZero n),
    toEquiv x (op g • p) = op g • toEquiv x p
  /-- The bijection commutes with the maps to frames. -/
  toFrame_map : ∀ (x : X) (p : s.P x), t.toFrame ⟨x, toEquiv x p⟩ = s.toFrame ⟨x, p⟩

namespace Equiv

variable {s t u : SpinStructure F E n}

attribute [simp] map_smul toFrame_map

/-- The inverse of the bijection of an equivalence is equivariant. -/
@[simp]
theorem map_smul_symm (φ : s.Equiv t) (x : X) (p : t.P x) (g : realCliffordSpinGroupZero n) :
    (φ.toEquiv x).symm (op g • p) = op g • (φ.toEquiv x).symm p := by
  rw [_root_.Equiv.symm_apply_eq, φ.map_smul, _root_.Equiv.apply_symm_apply]

/-- The inverse of the bijection of an equivalence commutes with the maps to frames. -/
@[simp]
theorem toFrame_map_symm (φ : s.Equiv t) (x : X) (p : t.P x) :
    s.toFrame ⟨x, (φ.toEquiv x).symm p⟩ = t.toFrame ⟨x, p⟩ := by
  rw [← φ.toFrame_map x ((φ.toEquiv x).symm p), _root_.Equiv.apply_symm_apply]

/-- Two equivalences of Spin structures are equal when their bijections agree pointwise. -/
@[ext]
theorem ext {φ ψ : s.Equiv t} (h : ∀ x p, φ.toEquiv x p = ψ.toEquiv x p) : φ = ψ := by
  obtain ⟨φ, _⟩ := φ
  obtain ⟨ψ, _⟩ := ψ
  congr
  funext x
  exact _root_.Equiv.ext (h x)

/-- The homeomorphism of total spaces induced by an equivalence of Spin structures. -/
def toHomeomorph (φ : s.Equiv t) :
    TotalSpace (realCliffordSpinGroupZero n) s.P ≃ₜ TotalSpace (realCliffordSpinGroupZero n) t.P
    where
  toFun p := ⟨p.proj, φ.toEquiv p.proj p.2⟩
  invFun p := ⟨p.proj, (φ.toEquiv p.proj).symm p.2⟩
  left_inv p := by simp
  right_inv p := by simp
  continuous_toFun := φ.continuous_toFun
  continuous_invFun := φ.continuous_invFun

@[simp]
theorem toHomeomorph_apply (φ : s.Equiv t) (p : TotalSpace (realCliffordSpinGroupZero n) s.P) :
    φ.toHomeomorph p = ⟨p.proj, φ.toEquiv p.proj p.2⟩ :=
  (rfl)

@[simp]
theorem toHomeomorph_symm_apply (φ : s.Equiv t)
    (p : TotalSpace (realCliffordSpinGroupZero n) t.P) :
    φ.toHomeomorph.symm p = ⟨p.proj, (φ.toEquiv p.proj).symm p.2⟩ :=
  (rfl)

/-- The homeomorphism of total spaces induced by an equivalence covers the identity of the
base. -/
theorem proj_toHomeomorph (φ : s.Equiv t) (p : TotalSpace (realCliffordSpinGroupZero n) s.P) :
    (φ.toHomeomorph p).proj = p.proj :=
  (rfl)

/-- The homeomorphism of total spaces induced by an equivalence commutes with the maps to
frames. -/
theorem toFrame_toHomeomorph (φ : s.Equiv t) (p : TotalSpace (realCliffordSpinGroupZero n) s.P) :
    t.toFrame (φ.toHomeomorph p) = s.toFrame p :=
  φ.toFrame_map p.proj p.2

/-- The homeomorphism of total spaces induced by an equivalence is equivariant. -/
theorem toHomeomorph_smul (φ : s.Equiv t) (g : (realCliffordSpinGroupZero n)ᵐᵒᵖ)
    (p : TotalSpace (realCliffordSpinGroupZero n) s.P) :
    φ.toHomeomorph (g • p) = g • φ.toHomeomorph p :=
  congrArg (TotalSpace.mk p.proj) (φ.map_smul p.proj p.2 g.unop)

/-- The inverse homeomorphism of total spaces induced by an equivalence covers the identity of the
base. -/
theorem proj_toHomeomorph_symm (φ : s.Equiv t) (p : TotalSpace (realCliffordSpinGroupZero n) t.P) :
    (φ.toHomeomorph.symm p).proj = p.proj :=
  (rfl)

/-- The inverse homeomorphism of total spaces induced by an equivalence commutes with the maps to
frames. -/
theorem toFrame_toHomeomorph_symm (φ : s.Equiv t)
    (p : TotalSpace (realCliffordSpinGroupZero n) t.P) :
    s.toFrame (φ.toHomeomorph.symm p) = t.toFrame p :=
  φ.toFrame_map_symm p.proj p.2

/-- The inverse homeomorphism of total spaces induced by an equivalence is equivariant. -/
theorem toHomeomorph_symm_smul (φ : s.Equiv t) (g : (realCliffordSpinGroupZero n)ᵐᵒᵖ)
    (p : TotalSpace (realCliffordSpinGroupZero n) t.P) :
    φ.toHomeomorph.symm (g • p) = g • φ.toHomeomorph.symm p :=
  congrArg (TotalSpace.mk p.proj) (φ.map_smul_symm p.proj p.2 g.unop)

/-- The identity equivalence of a Spin structure. -/
@[refl]
def refl (s : SpinStructure F E n) : s.Equiv s where
  toEquiv _ := _root_.Equiv.refl _
  continuous_toFun := continuous_id
  continuous_invFun := continuous_id
  map_smul _ _ _ := rfl
  toFrame_map _ _ := rfl

/-- The inverse of an equivalence of Spin structures. -/
@[symm]
def symm (φ : s.Equiv t) : t.Equiv s where
  toEquiv x := (φ.toEquiv x).symm
  continuous_toFun := φ.continuous_invFun
  continuous_invFun := φ.continuous_toFun
  map_smul := φ.map_smul_symm
  toFrame_map := φ.toFrame_map_symm

/-- The composite of two equivalences of Spin structures. -/
@[trans]
def trans (φ : s.Equiv t) (ψ : t.Equiv u) : s.Equiv u where
  toEquiv x := (φ.toEquiv x).trans (ψ.toEquiv x)
  continuous_toFun := ψ.continuous_toFun.comp φ.continuous_toFun
  continuous_invFun := φ.continuous_invFun.comp ψ.continuous_invFun
  map_smul x p g := by
    simp only [_root_.Equiv.trans_apply, φ.map_smul, ψ.map_smul]
  toFrame_map x p := by
    simp only [_root_.Equiv.trans_apply, ψ.toFrame_map, φ.toFrame_map]

@[simp]
theorem refl_toEquiv (s : SpinStructure F E n) (x : X) :
    (refl s).toEquiv x = _root_.Equiv.refl (s.P x) :=
  (rfl)

@[simp]
theorem symm_toEquiv (φ : s.Equiv t) (x : X) : φ.symm.toEquiv x = (φ.toEquiv x).symm :=
  (rfl)

@[simp]
theorem trans_toEquiv (φ : s.Equiv t) (ψ : t.Equiv u) (x : X) :
    (φ.trans ψ).toEquiv x = (φ.toEquiv x).trans (ψ.toEquiv x) :=
  (rfl)

@[simp]
theorem symm_symm (φ : s.Equiv t) : φ.symm.symm = φ :=
  (rfl)

@[simp]
theorem refl_symm (s : SpinStructure F E n) : (refl s).symm = refl s :=
  (rfl)

@[simp]
theorem refl_trans (φ : s.Equiv t) : (refl s).trans φ = φ :=
  (rfl)

@[simp]
theorem trans_refl (φ : s.Equiv t) : φ.trans (refl t) = φ :=
  (rfl)

@[simp]
theorem self_trans_symm (φ : s.Equiv t) : φ.trans φ.symm = refl s :=
  ext fun x p ↦ (φ.toEquiv x).symm_apply_apply p

@[simp]
theorem symm_trans_self (φ : s.Equiv t) : φ.symm.trans φ = refl t :=
  ext fun x p ↦ (φ.toEquiv x).apply_symm_apply p

@[simp]
theorem symm_trans (φ : s.Equiv t) (ψ : t.Equiv u) : (φ.trans ψ).symm = ψ.symm.trans φ.symm :=
  (rfl)

@[simp]
theorem refl_toHomeomorph (s : SpinStructure F E n) : (refl s).toHomeomorph = Homeomorph.refl _ :=
  (rfl)

@[simp]
theorem symm_toHomeomorph (φ : s.Equiv t) : φ.symm.toHomeomorph = φ.toHomeomorph.symm :=
  (rfl)

@[simp]
theorem trans_toHomeomorph (φ : s.Equiv t) (ψ : t.Equiv u) :
    (φ.trans ψ).toHomeomorph = φ.toHomeomorph.trans ψ.toHomeomorph :=
  (rfl)

theorem trans_assoc (φ : s.Equiv t) (ψ : t.Equiv u) {v : SpinStructure F E n}
    (χ : u.Equiv v) : (φ.trans ψ).trans χ = φ.trans (ψ.trans χ) :=
  (rfl)

end Equiv

/-! ### Pullback -/

section Pullback

variable {Y : Type*} [TopologicalSpace Y] {K : Type*} [FunLike K Y X] [ContinuousMapClass K Y X]

/-- The map to frames of the pullback of a Spin structure: the frame of `E` at `f y` of the
underlying point of `P`, read as a frame of `f *ᵖ E` at `y`. -/
noncomputable def pullbackToFrame (s : SpinStructure F E n) (f : Y → X)
    (p : TotalSpace (realCliffordSpinGroupZero n) (f *ᵖ s.P)) :
    OrthonormalFrameBundle ℝ F (f *ᵖ E) (EuclideanSpace ℝ (Fin n)) :=
  (OrthonormalFrameBundle.pullbackHomeomorph f).symm
    ⟨(p.proj, s.toFrame (Pullback.lift f p)), s.proj_toFrame _⟩

@[simp]
theorem proj_pullbackToFrame (s : SpinStructure F E n) (f : Y → X)
    (p : TotalSpace (realCliffordSpinGroupZero n) (f *ᵖ s.P)) :
    (s.pullbackToFrame f p).proj = p.proj :=
  OrthonormalFrameBundle.proj_pullbackHomeomorph_symm f _

/-- The frame of a point of the pullback, viewed as a frame of `E`, is the frame of its lift. -/
@[simp]
theorem pullbackLift_pullbackToFrame (s : SpinStructure F E n) (f : Y → X)
    (p : TotalSpace (realCliffordSpinGroupZero n) (f *ᵖ s.P)) :
    OrthonormalFrameBundle.pullbackLift f (s.pullbackToFrame f p) =
      s.toFrame (Pullback.lift f p) :=
  OrthonormalFrameBundle.pullbackLift_pullbackHomeomorph_symm f _

/-- The map to frames of the pullback of a Spin structure is continuous. -/
theorem continuous_pullbackToFrame (s : SpinStructure F E n) (f : Y → X) :
    Continuous (s.pullbackToFrame f) :=
  (OrthonormalFrameBundle.pullbackHomeomorph f).continuous_symm.comp
    (((Pullback.continuous_proj _ _ _).prodMk
      (s.continuous_toFrame.comp (Pullback.continuous_lift _ _ _))).subtype_mk _)

/-- The **pullback of a Spin structure** along a continuous map `f : Y → X`: the pulled-back
principal bundle `f *ᵖ P`, with the frame of a point over `y` the frame of `E` at `f y` of the
underlying point of `P`, read as a frame of `f *ᵖ E` at `y`. Its body is exposed so that the
fibre `(s.pullback f).P y` unfolds to `s.P (f y)` downstream. -/
@[expose]
noncomputable def pullback (s : SpinStructure F E n) (f : K) :
    SpinStructure F ((f : Y → X) *ᵖ E) n where
  P := (f : Y → X) *ᵖ s.P
  toFrame := s.pullbackToFrame f
  continuous_toFrame := s.continuous_pullbackToFrame f
  proj_toFrame := s.proj_pullbackToFrame f
  toFrame_smul y p g v := by
    refine Pullback.totalSpace_ext ((s.proj_pullbackToFrame f ⟨y, op g • p⟩).trans
      (s.proj_pullbackToFrame f ⟨y, p⟩).symm) ?_
    have h := s.toFrame_smul (f y) p g v
    simp only [TotalSpace.mk'] at h ⊢
    rw [← OrthonormalFrameBundle.totalSpaceMk_pullbackLift_frame,
      ← OrthonormalFrameBundle.totalSpaceMk_pullbackLift_frame,
      pullbackLift_pullbackToFrame, pullbackLift_pullbackToFrame]
    exact h

@[simp]
theorem pullback_P (s : SpinStructure F E n) (f : K) :
    (s.pullback f).P = (f : Y → X) *ᵖ s.P :=
  rfl

theorem pullback_toFrame (s : SpinStructure F E n) (f : K) :
    (s.pullback f).toFrame = s.pullbackToFrame f :=
  rfl

/-- The frame of a point of the pullback of a Spin structure, viewed as a frame of `E`, is the frame
of its lift. -/
@[simp]
theorem pullbackLift_toFrame_pullback (s : SpinStructure F E n) (f : K)
    (p : TotalSpace (realCliffordSpinGroupZero n) (s.pullback f).P) :
    OrthonormalFrameBundle.pullbackLift f ((s.pullback f).toFrame p) =
      s.toFrame (Pullback.lift f p) :=
  s.pullbackLift_pullbackToFrame f p

/-- The **pullback of an equivalence** of Spin structures along a continuous map: equivalences
commute with pullback. -/
noncomputable def Equiv.pullback {s t : SpinStructure F E n} (φ : s.Equiv t) (f : K) :
    (s.pullback f).Equiv (t.pullback f) where
  toEquiv y := φ.toEquiv (f y)
  continuous_toFun := (Pullback.continuous_iff (f := (f : Y → X))
    (g := fun p : TotalSpace _ ((f : Y → X) *ᵖ s.P) ↦
      (⟨p.proj, φ.toEquiv (f p.proj) p.2⟩ : TotalSpace _ ((f : Y → X) *ᵖ t.P)))).2
    ⟨Pullback.continuous_proj _ _ _, φ.continuous_toFun.comp (Pullback.continuous_lift _ _ _)⟩
  continuous_invFun := (Pullback.continuous_iff (f := (f : Y → X))
    (g := fun p : TotalSpace _ ((f : Y → X) *ᵖ t.P) ↦
      (⟨p.proj, (φ.toEquiv (f p.proj)).symm p.2⟩ : TotalSpace _ ((f : Y → X) *ᵖ s.P)))).2
    ⟨Pullback.continuous_proj _ _ _, φ.continuous_invFun.comp (Pullback.continuous_lift _ _ _)⟩
  map_smul y p g := φ.map_smul (f y) p g
  toFrame_map y p := by
    simp only [pullback_toFrame, pullbackToFrame]
    congr 2
    exact Prod.ext rfl (φ.toFrame_map (f y) p)

@[simp]
theorem Equiv.pullback_toEquiv {s t : SpinStructure F E n} (φ : s.Equiv t) (f : K) (y : Y) :
    (φ.pullback f).toEquiv y = φ.toEquiv (f y) :=
  (rfl)

@[simp]
theorem Equiv.toFrame_pullback_toEquiv {s t : SpinStructure F E n} (φ : s.Equiv t) (f : K) (y : Y)
    (p : s.P (f y)) :
    (t.pullback f).toFrame ⟨y, φ.toEquiv (f y) p⟩ = (s.pullback f).toFrame ⟨y, p⟩ :=
  (φ.pullback f).toFrame_map y p

@[simp]
theorem Equiv.toFrame_pullback_toEquiv_symm {s t : SpinStructure F E n} (φ : s.Equiv t) (f : K)
    (y : Y) (p : t.P (f y)) :
    (s.pullback f).toFrame ⟨y, (φ.toEquiv (f y)).symm p⟩ = (t.pullback f).toFrame ⟨y, p⟩ :=
  (φ.pullback f).toFrame_map_symm y p

@[simp]
theorem Equiv.pullback_refl (s : SpinStructure F E n) (f : K) :
    (refl s).pullback f = refl (s.pullback f) :=
  (rfl)

@[simp]
theorem Equiv.pullback_symm {s t : SpinStructure F E n} (φ : s.Equiv t) (f : K) :
    φ.symm.pullback f = (φ.pullback f).symm :=
  (rfl)

@[simp]
theorem Equiv.pullback_trans {s t u : SpinStructure F E n} (φ : s.Equiv t) (ψ : t.Equiv u)
    (f : K) : (φ.trans ψ).pullback f = (φ.pullback f).trans (ψ.pullback f) :=
  (rfl)

/-- The homeomorphism of total spaces induced by the pullback of an equivalence lifts to the one
induced by the equivalence. -/
theorem Equiv.lift_pullback_toHomeomorph {s t : SpinStructure F E n} (φ : s.Equiv t) (f : K)
    (p : TotalSpace (realCliffordSpinGroupZero n) (s.pullback f).P) :
    Pullback.lift f ((φ.pullback f).toHomeomorph p) = φ.toHomeomorph (Pullback.lift f p) :=
  (rfl)

end Pullback

end SpinStructure

end TauCeti
