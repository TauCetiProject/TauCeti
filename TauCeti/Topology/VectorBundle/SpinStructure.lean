module

public import TauCeti.Topology.Algebra.CliffordAlgebra.Spin.Basic
public import TauCeti.Topology.VectorBundle.OrthonormalFrame.Lift

/-!
# Spin structures on real vector bundles with fibre inner products

Let `E → X` be a real vector bundle with model fibre `F` and fibre inner products, and let
`n : ℕ`. A *Spin structure* of rank `n` on `E` (`TauCeti.SpinStructure`) is a principal
`Spin(n)`-bundle `P → X`, where `Spin(n)` is the compact group
`CliffordAlgebra.realCliffordSpinGroupZero n` with its subspace topology, together with a
continuous map `P → Fr(E)` to the orthonormal frame bundle of `E` modelled on `ℝⁿ`, covering the
identity of `X` and equivariant along the vector action `Spin(n) → SO(n)`,
`g ↦ (v ↦ g v g⁻¹)` (`CliffordAlgebra.spinToSpecialOrthogonal`): the frame of `p • g` sends `v`
to the frame of `p` applied to `g v g⁻¹` (`TauCeti.SpinStructure.toFrame_smul_spinVectorAction`).

It is the lift of the orthonormal frame bundle along the vector action,
`TauCeti.OrthonormalFrameLift F E n (realCliffordSpinGroupZero n) (spinToSpecialOrthogonal _)`,
and inherits its equivalences (`TauCeti.OrthonormalFrameLift.Equiv`) and pullbacks
(`TauCeti.OrthonormalFrameLift.pullback`). Each fibre of `P` is a `Spin(n)`-torsor, so its image
is one `SO(n)`-orbit of frames, and the orientation of `E` is the one for which these frames are
positive: a Spin structure chooses an orientation of `E`, and equivalences, which preserve the
frame map, preserve it. The notion is of interest for `n ≥ 1`: the native `Spin(0)`, generated by
the invertible vectors of the zero space, is trivial.

## Main definitions

* `TauCeti.SpinStructure`: a Spin structure of rank `n` on a real vector bundle with fibre
  inner products.

## Main results

* `TauCeti.SpinStructure.toFrame_smul_spinVectorAction`: `g` moves frames by its vector action.

## References

* R. C. Kirby, *The topology of 4-manifolds*, Lecture Notes in Mathematics 1374, Springer, 1989,
  Chapter IV, p. 33.
* H. B. Lawson, M.-L. Michelsohn, *Spin Geometry*, Princeton University Press, 1989, Chapter II,
  §1.
-/

public section

open Bundle MulOpposite CliffordAlgebra

universe w

namespace TauCeti

/-- A **Spin structure** of rank `n` on a real vector bundle `E` with model fibre `F` and fibre
inner products: a principal `Spin(n)`-bundle `P` over the base, where `Spin(n)` is the compact group
`realCliffordSpinGroupZero n` with its subspace topology, together with a continuous map to the
orthonormal frame bundle of `E` over the identity, equivariant along the vector action
`Spin(n) → SO(n)`: the frame of `p • g` sends `v` to the frame of `p` applied to `g v g⁻¹`. It is
the lift of the orthonormal frame bundle along the vector action. The notion is of interest for
`n ≥ 1`, the native `Spin(0)` being trivial. -/
abbrev SpinStructure {X : Type*} [TopologicalSpace X] (F : Type*) (E : X → Type w)
    [TopologicalSpace (TotalSpace F E)]
    [∀ x, NormedAddCommGroup (E x)] [∀ x, InnerProductSpace ℝ (E x)] (n : ℕ) :=
  OrthonormalFrameLift F E n (realCliffordSpinGroupZero n)
    (spinToSpecialOrthogonal (realCliffordForm n 0))

namespace SpinStructure

variable {X : Type*} [TopologicalSpace X] {F : Type*} {E : X → Type w}
  [TopologicalSpace (TotalSpace F E)]
  [∀ x, NormedAddCommGroup (E x)] [∀ x, InnerProductSpace ℝ (E x)] {n : ℕ}

/-- An element `g` of `Spin(n)` moves frames by its vector action `v ↦ g v g⁻¹`. -/
theorem toFrame_smul_spinVectorAction (s : SpinStructure F E n) (x : X) (p : s.P x)
    (g : realCliffordSpinGroupZero n) (v : Fin n → ℝ) :
    TotalSpace.mk' F (s.toFrame ⟨x, op g • p⟩).proj
        ((s.toFrame ⟨x, op g • p⟩).frame (WithLp.toLp 2 v)) =
      TotalSpace.mk' F (s.toFrame ⟨x, p⟩).proj
        ((s.toFrame ⟨x, p⟩).frame (WithLp.toLp 2 (spinVectorAction _ g v))) := by
  rw [s.toFrame_smul, coe_spinToSpecialOrthogonal_apply]

end SpinStructure

end TauCeti
