module

public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import TauCeti.AlgebraicTopology.Singular.Twisted.Coinvariants
public import TauCeti.Topology.VectorBundle.Orientation.LocalSystem
import TauCeti.RepresentationTheory.Coinvariants
import TauCeti.Topology.IsLocalHomeomorph

/-!
# Zeroth homology with coefficients in the orientation local system

Let `E → B` be a real vector bundle over a path-connected base and `o(E)` its orientation local
system with coefficients in a commutative ring `R`
(`TauCeti.VectorBundleOrientationCover.signLocalSystem`): its fibre over `b` is a copy of `R`
generated by the two orientations of `E_b`, one the negative of the other. This file computes the
zeroth singular homology `H₀(B; o(E))`.

Transport around a loop at `b` lifts the loop to the orientation double cover. If the lift returns
to the orientation it started from, transport is the identity of the fibre; if it ends at the
opposite orientation, transport is `-1`
(`TauCeti.VectorBundleOrientationCover.monodromyRepresentation_signLocalSystem_eq_one` and
`TauCeti.VectorBundleOrientationCover.monodromyRepresentation_signLocalSystem_eq_neg_one`).
Zeroth homology is the coinvariants of this monodromy
(`TauCeti.LocalCoefficientSystem.twistedHomology₀IsoCoinvariants`), so:

* if `E` is orientable, every loop lifts to a loop, since an orientation is a continuous section
  of the cover, and `H₀(B; o(E)) ≅ R`, by evaluating at the chosen orientation
  (`TauCeti.VectorBundleOrientation.twistedHomology₀SignLocalSystemEquiv`);
* if `E` is not orientable and `B` is locally path-connected, the orientation double cover is
  connected, hence path-connected, so some loop lifts to a path between the two orientations of
  `E_b`, and `H₀(B; o(E)) ≅ R ⧸ 2R`
  (`TauCeti.VectorBundleOrientationCover.twistedHomology₀SignLocalSystemEquivOfIsEmpty`).

With `R = ℤ` this is `ℤ` for an orientable bundle and `ℤ/2` for a nonorientable one, whereas the
zeroth homology of `B` with constant coefficients `ℤ` is `ℤ` in both cases. By the twisted Thom
isomorphism `H_j(D(E), S(E)) ≅ H_{j-r}(B; o(E))` for a bundle of rank `r`, this is the lowest
nonzero relative homology group of its disc bundle relative to its sphere bundle, in degree `r`.
For a critical submanifold `B` of a Morse–Bott function with negative normal bundle `E` of rank
`λ`, it is the contribution of `B` in degree `λ` to the relative homology across its critical
level. Over a field `k` it is `k` for an
orientable bundle, and for a nonorientable one it is `k` in characteristic two and `0` otherwise.

## Main results

* `VectorBundleOrientationCover.monodromyRepresentation_signLocalSystem_eq_one_or_eq_neg_one`, in
  the namespace `TauCeti`: transport around a loop in the orientation local system is `1` or
  `-1`.
* `TauCeti.VectorBundleOrientation.twistedHomology₀SignLocalSystemEquiv`: for an orientable
  bundle over a path-connected base, `H₀(B; o(E)) ≅ R`.
* `TauCeti.VectorBundleOrientationCover.twistedHomology₀SignLocalSystemEquivOfIsEmpty`: for a
  nonorientable bundle over a path-connected, locally path-connected base, `H₀(B; o(E)) ≅ R ⧸ 2R`.

## References

* A. Hatcher, *Algebraic Topology*, Section 3.H (local coefficient systems, and zeroth homology as
  the coinvariants of the monodromy action).
* J. W. Milnor, J. D. Stasheff, *Characteristic Classes*, Annals of Mathematics Studies 76,
  Princeton (1974), §12 (the orientation double cover and twisted coefficients).
-/

public section

noncomputable section

open Bundle CategoryTheory Module
open scoped Pointwise

universe u uB uE uι

variable {B : Type uB} [TopologicalSpace B]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {E : B → Type uE} [TopologicalSpace (TotalSpace F E)] [∀ b, AddCommMonoid (E b)]
  [∀ b, Module ℝ (E b)] [∀ b, TopologicalSpace (E b)] [FiberBundle F E] [VectorBundle ℝ F E]
  {ι : Type uι} [Fintype ι] {R : Type u} [CommRing R] (hι : Fintype.card ι = finrank ℝ F)

namespace TauCeti

namespace VectorBundleOrientationCover

open LocalCoefficientSystem

/-- If the lift to the orientation double cover of a loop at `b` starting at the orientation `o`
of `E_b` ends at `o`, transport around the loop in the orientation local system is the
identity. -/
theorem monodromyRepresentation_signLocalSystem_eq_one {b : B}
    (g : FundamentalGroup (TopCat.of B) b) (o : Orientation ℝ (E b) ι)
    (hg : (isCoveringMap_proj hι).monodromy g.asHom ⟨⟨b, o⟩, rfl⟩ = ⟨⟨b, o⟩, rfl⟩) :
    monodromyRepresentation (signLocalSystem F E R hι) b g = 1 := by
  ext f
  apply (signLocalSystemFiberEquiv hι o).injective
  have h := signLocalSystemObjEquiv_map_apply_monodromy hι g.asHom f ⟨⟨b, o⟩, rfl⟩
  rw [hg] at h
  rw [Module.End.one_eq_id, LinearMap.id_apply, monodromyRepresentation_apply,
    signLocalSystemFiberEquiv_apply, signLocalSystemFiberEquiv_apply]
  exact h

/-- If the lift to the orientation double cover of a loop at `b` starting at the orientation `o`
of `E_b` ends at the opposite orientation `-o`, transport around the loop in the orientation local
system is `-1`. -/
theorem monodromyRepresentation_signLocalSystem_eq_neg_one {b : B}
    (g : FundamentalGroup (TopCat.of B) b) (o : Orientation ℝ (E b) ι)
    (hg : (isCoveringMap_proj hι).monodromy g.asHom ⟨⟨b, o⟩, rfl⟩ = ⟨⟨b, -o⟩, rfl⟩) :
    monodromyRepresentation (signLocalSystem F E R hι) b g = -1 := by
  ext f
  apply (signLocalSystemFiberEquiv hι o).injective
  -- The lift ends at `-o`, where the transported coefficient takes the value of `f` at `o`.
  have h := signLocalSystemObjEquiv_map_apply_monodromy hι g.asHom f ⟨⟨b, o⟩, rfl⟩
  rw [hg, ← signLocalSystemFiberEquiv_apply, ← signLocalSystemFiberEquiv_apply,
    signLocalSystemFiberEquiv_neg] at h
  rw [LinearMap.neg_apply, Module.End.one_eq_id, LinearMap.id_apply, map_neg,
    monodromyRepresentation_apply, ← h, neg_neg]

/-- Transport around a loop in the orientation local system is `1` or `-1`: the lift of the loop
to the orientation double cover ends at the orientation it starts from, or at the opposite one. -/
theorem monodromyRepresentation_signLocalSystem_eq_one_or_eq_neg_one {b : B}
    (g : FundamentalGroup (TopCat.of B) b) :
    monodromyRepresentation (signLocalSystem F E R hι) b g = 1 ∨
      monodromyRepresentation (signLocalSystem F E R hι) b g = -1 := by
  obtain ⟨⟨b', o⟩, rfl⟩ := surjective_proj (F := F) (E := E) hι b
  set e := (isCoveringMap_proj hι).monodromy g.asHom ⟨⟨b', o⟩, rfl⟩
  rcases eq_or_eq_deck hι (p := ⟨b', o⟩) (q := e.1) e.2 with h | h
  · exact .inl (monodromyRepresentation_signLocalSystem_eq_one hι g o (Subtype.ext h))
  · exact .inr (monodromyRepresentation_signLocalSystem_eq_neg_one hι g o
      (Subtype.ext (h.trans (deck_apply _))))

variable [PathConnectedSpace B]

/-- For a nonorientable bundle over a path-connected, locally path-connected base, some loop at
`b` lifts to a path in the orientation double cover from the orientation `o` of `E_b` to the
opposite orientation. -/
theorem exists_monodromy_eq_neg_of_isEmpty [LocallyPathConnectedSpace B]
    (h : IsEmpty (VectorBundleOrientation F E ι)) {b : B} (o : Orientation ℝ (E b) ι) :
    ∃ g : FundamentalGroup (TopCat.of B) b,
      (isCoveringMap_proj hι).monodromy g.asHom ⟨⟨b, o⟩, rfl⟩ = ⟨⟨b, -o⟩, rfl⟩ := by
  -- The orientation double cover is connected, and locally path-connected as a covering space of
  -- a locally path-connected space, so it is path-connected.
  have : ConnectedSpace (VectorBundleOrientationCover F E ι) := by
    by_contra hc
    exact h.elim' ((VectorBundleOrientation.nonempty_iff_not_connectedSpace hι).2 hc).some
  have := (isCoveringMap_proj (F := F) (E := E) hι).isLocalHomeomorph.locallyPathConnectedSpace
  have : PathConnectedSpace (VectorBundleOrientationCover F E ι) :=
    pathConnectedSpace_iff_connectedSpace.2 inferInstance
  -- A path between the two orientations of `E_b` lies over a loop at `b`.
  let Γ : Path (⟨b, o⟩ : VectorBundleOrientationCover F E ι) ⟨b, -o⟩ :=
    PathConnectedSpace.somePath _ _
  let γ : Path b b := Γ.map (continuous_proj (F := F) (E := E) (ι := ι))
  refine ⟨.of (Path.Homotopic.Quotient.mk γ), ?_⟩
  exact Subtype.ext ((isCoveringMap_proj hι).monodromy_eq_apply_one (Γ := Γ.toContinuousMap)
    (funext fun _ ↦ rfl) Γ.source |>.trans Γ.target)

/-- **Zeroth homology of the orientation local system of a nonorientable bundle.** Over a
path-connected, locally path-connected base, the zeroth homology of the orientation local system
of a nonorientable bundle is `R ⧸ 2R`; for `R = ℤ` it is `ℤ/2`. The class of a coefficient `f` at
`b` goes to the class of its value at an orientation `o` of `E_b`. -/
def twistedHomology₀SignLocalSystemEquivOfIsEmpty [LocallyPathConnectedSpace B]
    (h : IsEmpty (VectorBundleOrientation F E ι)) {b : B} (o : Orientation ℝ (E b) ι) :
    twistedHomology.{u, uB, max uE uι u} (signLocalSystem F E R hι) 0 ≃ₗ[R]
      R ⧸ Ideal.span {(2 : R)} :=
  (twistedHomology₀IsoCoinvariants.{u, uB, max uE uι u} (signLocalSystem F E R hι)
    b).toLinearEquiv ≪≫ₗ
    Submodule.quotEquivOfEq _ _ ((monodromyRepresentation _ b).coinvariantsKer_eq_two_smul_top
      (monodromyRepresentation_signLocalSystem_eq_one_or_eq_neg_one hι)
      ((exists_monodromy_eq_neg_of_isEmpty hι h o).imp fun g ↦
        monodromyRepresentation_signLocalSystem_eq_neg_one hι g o)) ≪≫ₗ
    Submodule.Quotient.equiv _ _ (signLocalSystemFiberEquiv hι o) (by
      rw [Submodule.map_pointwise_smul, Submodule.map_top, LinearEquiv.range]) ≪≫ₗ
    Submodule.quotEquivOfEq _ _ (by
      rw [← Submodule.ideal_span_singleton_smul, smul_eq_mul, Ideal.mul_top])

/-- The identification `H₀(B; o(E)) ≅ R ⧸ 2R` of a nonorientable bundle sends the class of a
coefficient at `b` to the class of its value at the orientation `o` of `E_b`. -/
@[simp]
theorem twistedHomology₀SignLocalSystemEquivOfIsEmpty_ιTwistedHomology₀
    [LocallyPathConnectedSpace B] (h : IsEmpty (VectorBundleOrientation F E ι)) {b : B}
    (o : Orientation ℝ (E b) ι) (f : (signLocalSystem F E R hι).obj (FundamentalGroupoid.mk b)) :
    twistedHomology₀SignLocalSystemEquivOfIsEmpty hι h o
        ((ιTwistedHomology₀.{u, uB, max uE uι u} _ b).hom f) =
      Ideal.Quotient.mk _ (signLocalSystemFiberEquiv hι o f) := by
  have := congrArg (fun φ ↦ φ.hom f) (ιTwistedHomology₀_isoCoinvariants_hom.{u, uB, max uE uι u}
    (signLocalSystem F E R hι) b)
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_ofHom] at this
  rw [twistedHomology₀SignLocalSystemEquivOfIsEmpty, LinearEquiv.trans_apply,
    LinearEquiv.trans_apply]
  -- The innermost composite is of linear equivalences between the carriers of objects of
  -- `ModuleCat`, which `rw` does not match against `LinearEquiv.trans_apply`.
  erw [LinearEquiv.trans_apply, Iso.toLinearEquiv_apply, this]
  rfl

end VectorBundleOrientationCover

namespace VectorBundleOrientation

open LocalCoefficientSystem VectorBundleOrientationCover

/-- Transport around every loop in the orientation local system of an oriented bundle is the
identity, so the coinvariant kernel of the monodromy vanishes. -/
private theorem coinvariantsKer_monodromyRepresentation_signLocalSystem_eq_bot
    (o : VectorBundleOrientation F E ι) (b : B) :
    Representation.Coinvariants.ker
      (monodromyRepresentation (signLocalSystem F E R hι) b) = ⊥ :=
  (monodromyRepresentation _ b).coinvariantsKer_eq_bot_of_forall_eq_one fun g ↦
    monodromyRepresentation_signLocalSystem_eq_one hι g (o b) <|
      (isCoveringMap_proj hι).monodromy_section (o.continuous_mk_cover hι) (fun _ ↦ rfl) g.asHom

variable [PathConnectedSpace B]

/-- **Zeroth homology of the orientation local system of an oriented bundle.** Over a
path-connected base, the orientation local system of an oriented bundle has zeroth homology `R`:
the class of a coefficient `f` at `b` goes to its value at the orientation `o b`. -/
def twistedHomology₀SignLocalSystemEquiv (o : VectorBundleOrientation F E ι) (b : B) :
    twistedHomology.{u, uB, max uE uι u} (signLocalSystem F E R hι) 0 ≃ₗ[R] R :=
  (twistedHomology₀IsoCoinvariants.{u, uB, max uE uι u} (signLocalSystem F E R hι)
    b).toLinearEquiv ≪≫ₗ
    Submodule.quotEquivOfEqBot _
      (coinvariantsKer_monodromyRepresentation_signLocalSystem_eq_bot hι o b) ≪≫ₗ
    signLocalSystemFiberEquiv hι (o b)

/-- The identification `H₀(B; o(E)) ≅ R` of an oriented bundle sends the class of a coefficient at
`b` to its value at the orientation `o b`. -/
@[simp]
theorem twistedHomology₀SignLocalSystemEquiv_ιTwistedHomology₀
    (o : VectorBundleOrientation F E ι) (b : B)
    (f : (signLocalSystem F E R hι).obj (FundamentalGroupoid.mk b)) :
    twistedHomology₀SignLocalSystemEquiv hι o b
        ((ιTwistedHomology₀.{u, uB, max uE uι u} _ b).hom f) =
      signLocalSystemFiberEquiv hι (o b) f := by
  have := congrArg (fun φ ↦ φ.hom f) (ιTwistedHomology₀_isoCoinvariants_hom.{u, uB, max uE uι u}
    (signLocalSystem F E R hι) b)
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_ofHom] at this
  rw [twistedHomology₀SignLocalSystemEquiv, LinearEquiv.trans_apply]
  -- The inner composite is of linear equivalences between the carriers of objects of
  -- `ModuleCat`, which `rw` does not match against `LinearEquiv.trans_apply`; it applies the
  -- isomorphism with the coinvariants and then the identification of the coinvariants with the
  -- fibre, which sends the class of `f` to `f`.
  exact congrArg (signLocalSystemFiberEquiv hι (o b) ∘ Submodule.quotEquivOfEqBot _
    (coinvariantsKer_monodromyRepresentation_signLocalSystem_eq_bot hι o b)) this

end VectorBundleOrientation

end TauCeti
