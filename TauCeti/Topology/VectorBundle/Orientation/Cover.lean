module

public import Mathlib.Topology.Covering.Basic
public import TauCeti.Topology.VectorBundle.Orientation.Basic

/-!
# The orientation double cover of a real vector bundle

The orientation double cover of a real vector bundle `E → B` with finite-dimensional model fibre
`F` is the set of pairs of a point `b : B` and an orientation of the fibre `E b`. Its topology is
read in local trivializations: a linear trivialization `e` reads an orientation of each fibre over
its base set as an orientation of `F`, and the points over `e.baseSet` read as a fixed orientation
of `F` form a *sheet* (`TauCeti.VectorBundleOrientationCover.sheet`). The topology is generated by
the sheets of the preferred trivializations together with the preimages of open subsets of `B`.

When `ι` has cardinality the rank of the bundle, the sheet of every trivialization of the atlas
is open (`TauCeti.VectorBundleOrientationCover.isOpen_sheet`),
because the coordinate changes of the atlas have locally constant determinant sign; over the base
set of each such trivialization the cover is the product of the base set with the two-point set
of orientations of `F`, so the projection is a covering map
(`TauCeti.VectorBundleOrientationCover.isCoveringMap_proj`). Reversing the orientation is a
fixed-point-free deck involution (`TauCeti.VectorBundleOrientationCover.deck`).

A family of fibre orientations is an orientation of the bundle exactly when the associated
section of the cover is continuous (`TauCeti.VectorBundleOrientation.continuous_mk_cover` and
`TauCeti.VectorBundleOrientation.ofContinuous`), so a bundle is orientable if and only if its
orientation double cover has a continuous section
(`TauCeti.VectorBundleOrientation.nonempty_iff_exists_section`). Over a connected base, a
nonempty proper clopen subset of the cover is the image of such a section, so a bundle is
orientable if and only if its orientation double cover is disconnected
(`TauCeti.VectorBundleOrientation.nonempty_iff_not_connectedSpace`). Applied to the tangent
bundle this gives the orientation double cover of a manifold.

## Main definitions

* `TauCeti.VectorBundleOrientationCover F E ι`: the orientation double cover of `E`.
* `TauCeti.VectorBundleOrientationCover.sheet`: the points read as a fixed orientation of `F` in
  a trivialization.
* `TauCeti.VectorBundleOrientationCover.deck`: the deck involution reversing orientations.
* `TauCeti.VectorBundleOrientation.ofContinuous`: an orientation from a continuous section.

## Main results

* `TauCeti.VectorBundleOrientationCover.isCoveringMap_proj`: the projection is a covering map.
* `TauCeti.VectorBundleOrientationCover.exists_section_of_isClopen`: over a preconnected base, a
  nonempty proper clopen subset of the cover is the image of a continuous section.
* `TauCeti.VectorBundleOrientation.nonempty_iff_exists_section`: a bundle is orientable if and
  only if its orientation double cover has a continuous section.
* `TauCeti.VectorBundleOrientation.nonempty_iff_not_connectedSpace`: over a connected base, a
  bundle is orientable if and only if its orientation double cover is disconnected.

## References

* John M. Lee, *Introduction to Smooth Manifolds*, second edition, Graduate Texts in
  Mathematics 218, Springer, 2013, Chapter 15, "The Orientation Covering".
* J. W. Milnor, J. D. Stasheff, *Characteristic Classes*, Annals of Mathematics Studies 76,
  Princeton (1974), §12 (the orientation double cover of a vector bundle).
-/

public section

noncomputable section

open Bundle Filter Module Set
open scoped Topology

variable {B : Type*} [TopologicalSpace B]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {E : B → Type*} [TopologicalSpace (TotalSpace F E)] [∀ b, AddCommMonoid (E b)]
  [∀ b, Module ℝ (E b)] {ι : Type*}

namespace TauCeti

/-- The orientation double cover of the real vector bundle `E` with model fibre `F`: the pairs
of a point of the base and an orientation, indexed by `ι`, of the fibre over it. It is a double
cover when `ι` has cardinality the rank of the bundle. The model fibre `F` enters only through
the topology, which is read in the trivializations of the bundle. -/
@[ext]
structure VectorBundleOrientationCover (F : Type*) (E : B → Type*) [∀ b, AddCommMonoid (E b)]
    [∀ b, Module ℝ (E b)] (ι : Type*) where
  /-- The base point. -/
  proj : B
  /-- The orientation of the fibre over the base point. -/
  orientation : Orientation ℝ (E proj) ι

namespace VectorBundleOrientationCover

omit [TopologicalSpace B] [NormedAddCommGroup F] [NormedSpace ℝ F]
    [TopologicalSpace (TotalSpace F E)] in
/-- Two points of the orientation double cover over the same base point are equal exactly when
their orientations are equal. -/
theorem mk_eq_mk_iff {b : B} {o o' : Orientation ℝ (E b) ι} :
    (⟨b, o⟩ : VectorBundleOrientationCover F E ι) = ⟨b, o'⟩ ↔ o = o' := by
  constructor
  · exact fun h ↦ eq_of_heq (VectorBundleOrientationCover.mk.inj h).2
  · rintro rfl
    rfl

/-- The sheet of the orientation double cover read as the orientation `o` of the model fibre in
the linear trivialization `e`: the orientations of fibres over `e.baseSet` that `e` transports
to `o`. -/
def sheet (e : Trivialization F (π F E)) [e.IsLinear ℝ] (o : Orientation ℝ F ι) :
    Set (VectorBundleOrientationCover F E ι) :=
  {p | ∃ h : p.proj ∈ e.baseSet, e.mapOrientation ι h p.orientation = o}

@[simp]
theorem mem_sheet_iff {e : Trivialization F (π F E)} [e.IsLinear ℝ] {o : Orientation ℝ F ι}
    {p : VectorBundleOrientationCover F E ι} :
    p ∈ sheet e o ↔ ∃ h : p.proj ∈ e.baseSet, e.mapOrientation ι h p.orientation = o :=
  Iff.rfl

variable [∀ b, TopologicalSpace (E b)] [FiberBundle F E] [VectorBundle ℝ F E]

/-- The topology of the orientation double cover, generated by the preimages of open subsets of
the base and the sheets of the preferred trivializations. -/
instance : TopologicalSpace (VectorBundleOrientationCover F E ι) :=
  .generateFrom ({s | ∃ U : Set B, IsOpen U ∧ proj ⁻¹' U = s} ∪
    range fun bo : B × Orientation ℝ F ι ↦ sheet (trivializationAt F E bo.1) bo.2)

theorem isOpen_preimage_proj {U : Set B} (hU : IsOpen U) :
    IsOpen (proj ⁻¹' U : Set (VectorBundleOrientationCover F E ι)) :=
  .basic _ (.inl ⟨U, hU, rfl⟩)

theorem isOpen_sheet_trivializationAt (b : B) (o : Orientation ℝ F ι) :
    IsOpen (sheet (trivializationAt F E b) o) :=
  .basic _ (.inr ⟨(b, o), rfl⟩)

theorem continuous_proj : Continuous (proj : VectorBundleOrientationCover F E ι → B) :=
  ⟨fun _ ↦ isOpen_preimage_proj⟩

/-- A map into the orientation double cover is continuous when its composite with the projection
is continuous and the preimage of the sheet of every preferred trivialization is open. -/
theorem continuous_of_isOpen_preimage_sheet {X : Type*} [TopologicalSpace X]
    {f : X → VectorBundleOrientationCover F E ι} (hf : Continuous (proj ∘ f))
    (hsheet : ∀ (b : B) (o : Orientation ℝ F ι), IsOpen (f ⁻¹' sheet (trivializationAt F E b) o)) :
    Continuous f := by
  refine continuous_generateFrom_iff.2 fun s hs ↦ ?_
  rcases hs with ⟨U, hU, rfl⟩ | ⟨⟨b, o⟩, rfl⟩
  · exact hU.preimage hf
  · exact hsheet b o

omit [∀ b, TopologicalSpace (E b)] [FiberBundle F E] [VectorBundle ℝ F E] in
private theorem mk_neg_mem_sheet_iff {e : Trivialization F (π F E)} [e.IsLinear ℝ]
    {o : Orientation ℝ F ι} {p : VectorBundleOrientationCover F E ι} :
    (⟨p.proj, -p.orientation⟩ : VectorBundleOrientationCover F E ι) ∈ sheet e o ↔
      p ∈ sheet e (-o) := by
  simp only [mem_sheet_iff, Trivialization.mapOrientation_neg]
  exact exists_congr fun _ ↦
    ⟨fun h ↦ by rw [← h]; exact (neg_neg (G := Orientation ℝ F ι) _).symm,
      fun h ↦ by rw [h]; exact neg_neg o⟩

/-- The deck involution of the orientation double cover, reversing the orientation of the fibre
and fixing the base point. -/
def deck : VectorBundleOrientationCover F E ι ≃ₜ VectorBundleOrientationCover F E ι :=
  have hneg : Continuous fun p : VectorBundleOrientationCover F E ι ↦
      (⟨p.proj, -p.orientation⟩ : VectorBundleOrientationCover F E ι) :=
    continuous_of_isOpen_preimage_sheet continuous_proj fun b o ↦ by
      convert isOpen_sheet_trivializationAt b (-o) using 1
      ext p
      exact mk_neg_mem_sheet_iff
  -- `simp [neg_neg]` does not fire: the negation on `Orientation` reached through
  -- `InvolutiveNeg` is only reducibly, not syntactically, the one in the goal.
  { toFun p := ⟨p.proj, -p.orientation⟩
    invFun p := ⟨p.proj, -p.orientation⟩
    left_inv := fun ⟨b, o⟩ ↦ congrArg (mk b) (neg_neg o)
    right_inv := fun ⟨b, o⟩ ↦ congrArg (mk b) (neg_neg o)
    continuous_toFun := hneg
    continuous_invFun := hneg }

theorem deck_apply (p : VectorBundleOrientationCover F E ι) :
    deck p = ⟨p.proj, -p.orientation⟩ :=
  (rfl)

@[simp]
theorem proj_deck (p : VectorBundleOrientationCover F E ι) : (deck p).proj = p.proj :=
  (rfl)

/-- The deck involution reverses the orientation of each point. -/
@[simp]
theorem orientation_deck (p : VectorBundleOrientationCover F E ι) :
    (proj_deck p) ▸ (deck p).orientation = -p.orientation :=
  (rfl)

/-- The deck involution exchanges the two sheets determined by a linear trivialization. -/
@[simp high]
theorem deck_mem_sheet_iff {e : Trivialization F (π F E)} [e.IsLinear ℝ]
    {o : Orientation ℝ F ι} {p : VectorBundleOrientationCover F E ι} :
    deck p ∈ sheet e o ↔ p ∈ sheet e (-o) :=
  mk_neg_mem_sheet_iff

@[simp]
theorem deck_symm : (deck : VectorBundleOrientationCover F E ι ≃ₜ _).symm = deck :=
  (rfl)

@[simp]
theorem deck_deck (p : VectorBundleOrientationCover F E ι) : deck (deck p) = p :=
  deck.symm_apply_apply p

/-- The deck involution has no fixed points. -/
theorem deck_ne_self (p : VectorBundleOrientationCover F E ι) : deck p ≠ p := fun h ↦ by
  obtain ⟨b, o⟩ := p
  exact Module.Ray.ne_neg_self o (mk_eq_mk_iff.1 h).symm

variable [Fintype ι] [FiniteDimensional ℝ F]

/-- The sheet of every trivialization of the atlas is open, provided `ι` has cardinality the
rank of the bundle. -/
theorem isOpen_sheet (hι : Fintype.card ι = finrank ℝ F) (e : Trivialization F (π F E))
    [MemTrivializationAtlas e] (o : Orientation ℝ F ι) : IsOpen (sheet e o) := by
  refine isOpen_iff_forall_mem_open.2 fun p hp ↦ ?_
  -- Near `p`, the sheet of the preferred trivialization at `p.proj` through `p` lies in the
  -- sheet of `e`.
  obtain ⟨hpe, rfl⟩ := hp
  set e₀ := trivializationAt F E p.proj
  have hp₀ : p.proj ∈ e₀.baseSet := FiberBundle.mem_baseSet_trivializationAt' p.proj
  set o₀ := e₀.mapOrientation ι hp₀ p.orientation
  obtain ⟨U, hUsub, hU, hpU⟩ := mem_nhds_iff.1
    (inter_mem (e.eventually_mapOrientation_symm_eq hι e₀ hpe hp₀ (e.mapOrientation ι hpe
      p.orientation)) ((e₀.eventually_mapOrientation_symm_eq hι e hp₀ hpe o₀).and
        (e.open_baseSet.mem_nhds hpe)))
  refine ⟨proj ⁻¹' U ∩ sheet e₀ o₀, ?_, (isOpen_preimage_proj hU).inter
    (isOpen_sheet_trivializationAt _ _), hpU, hp₀, rfl⟩
  rintro q ⟨hqU, hq₀, hq⟩
  obtain ⟨-, h, hqe⟩ := hUsub hqU
  refine ⟨hqe, ?_⟩
  have hq' : q.orientation = (e₀.mapOrientation ι hq₀).symm o₀ := by
    rw [← hq, Equiv.symm_apply_apply]
  rw [hq', h hq₀ hqe, Equiv.symm_apply_apply]

/-- The section of the orientation double cover over the base set of a trivialization `e` of the
atlas read as the fixed orientation `o` of the model fibre is continuous. -/
theorem continuous_mk_mapOrientation_symm (hι : Fintype.card ι = finrank ℝ F)
    (e : Trivialization F (π F E)) [MemTrivializationAtlas e] (o : Orientation ℝ F ι) :
    Continuous fun x : e.baseSet ↦
      (⟨x, (e.mapOrientation ι x.2).symm o⟩ : VectorBundleOrientationCover F E ι) := by
  refine continuous_of_isOpen_preimage_sheet continuous_subtype_val fun b o' ↦ ?_
  set e' := trivializationAt F E b
  refine isOpen_iff_mem_nhds.2 fun x ⟨hx', hx⟩ ↦ ?_
  have h := (e.eventually_mapOrientation_symm_eq hι e' x.2 hx' o).and
    (e'.open_baseSet.mem_nhds hx')
  filter_upwards [continuous_subtype_val.continuousAt.eventually h] with y ⟨hy, hy'⟩
  exact ⟨hy', (hy y.2 hy').trans hx⟩

/-- Over the base set of a trivialization `e` of the atlas, the orientation double cover is the
product of the base set with the discrete set of orientations of the model fibre. -/
def trivializationHomeomorph (hι : Fintype.card ι = finrank ℝ F)
    (e : Trivialization F (π F E)) [MemTrivializationAtlas e] [TopologicalSpace (Orientation ℝ F ι)]
    [DiscreteTopology (Orientation ℝ F ι)] :
    (proj ⁻¹' e.baseSet : Set (VectorBundleOrientationCover F E ι)) ≃ₜ
      e.baseSet × Orientation ℝ F ι where
  toFun p := (⟨p.1.proj, p.2⟩, e.mapOrientation ι p.2 p.1.orientation)
  invFun x := ⟨⟨x.1, (e.mapOrientation ι x.1.2).symm x.2⟩, x.1.2⟩
  left_inv p := by ext <;> simp
  right_inv x := by simp
  continuous_toFun := by
    refine (continuous_proj.comp continuous_subtype_val).subtype_mk _ |>.prodMk ?_
    refine continuous_discrete_rng.2 fun o ↦ ?_
    convert (isOpen_sheet hι e o).preimage continuous_subtype_val using 1
    ext p
    exact ⟨fun hp ↦ ⟨p.2, hp⟩, fun ⟨_, hp⟩ ↦ hp⟩
  continuous_invFun := by
    refine continuous_prod_of_discrete_right.2 fun o ↦ ?_
    exact (continuous_mk_mapOrientation_symm hι e o).subtype_mk _

@[simp]
theorem trivializationHomeomorph_apply (hι : Fintype.card ι = finrank ℝ F)
    (e : Trivialization F (π F E)) [MemTrivializationAtlas e] [TopologicalSpace (Orientation ℝ F ι)]
    [DiscreteTopology (Orientation ℝ F ι)]
    (p : (proj ⁻¹' e.baseSet : Set (VectorBundleOrientationCover F E ι))) :
    trivializationHomeomorph hι e p = (⟨p.1.proj, p.2⟩, e.mapOrientation ι p.2 p.1.orientation) :=
  (rfl)

@[simp]
theorem trivializationHomeomorph_symm_apply (hι : Fintype.card ι = finrank ℝ F)
    (e : Trivialization F (π F E)) [MemTrivializationAtlas e] [TopologicalSpace (Orientation ℝ F ι)]
    [DiscreteTopology (Orientation ℝ F ι)] (x : e.baseSet × Orientation ℝ F ι) :
    (trivializationHomeomorph hι e).symm x = ⟨⟨x.1, (e.mapOrientation ι x.1.2).symm x.2⟩, x.1.2⟩ :=
  (rfl)

/-- The projection of the orientation double cover is a covering map, provided `ι` has
cardinality the rank of the bundle. -/
theorem isCoveringMap_proj (hι : Fintype.card ι = finrank ℝ F) :
    IsCoveringMap (proj : VectorBundleOrientationCover F E ι → B) := fun b ↦
  letI : TopologicalSpace (Orientation ℝ F ι) := ⊥
  haveI : DiscreteTopology (Orientation ℝ F ι) := ⟨rfl⟩
  IsEvenlyCovered.to_isEvenlyCovered_preimage
    ⟨inferInstance, _, FiberBundle.mem_baseSet_trivializationAt' b,
      (trivializationAt F E b).open_baseSet,
      isOpen_preimage_proj (trivializationAt F E b).open_baseSet,
      trivializationHomeomorph hι (trivializationAt F E b), fun _ ↦ rfl⟩

/-- The projection of the orientation double cover is surjective, provided `ι` has cardinality
the rank of the bundle. -/
theorem surjective_proj (hι : Fintype.card ι = finrank ℝ F) :
    Function.Surjective (proj : VectorBundleOrientationCover F E ι → B) := by
  classical
  intro b
  have hb := FiberBundle.mem_baseSet_trivializationAt' (F := F) (E := E) b
  exact ⟨⟨b, ((trivializationAt F E b).mapOrientation ι hb).symm
    ((Module.finBasis ℝ F).reindex (Fintype.equivFinOfCardEq hι).symm).orientation⟩, rfl⟩

/-- The fibre of the orientation double cover through `p` consists of `p` and `deck p`, provided
`ι` has cardinality the rank of the bundle. -/
theorem eq_or_eq_deck (hι : Fintype.card ι = finrank ℝ F) {p q : VectorBundleOrientationCover F E ι}
    (h : q.proj = p.proj) : q = p ∨ q = deck p := by
  obtain ⟨b, o⟩ := p
  obtain ⟨b', o'⟩ := q
  obtain rfl : b' = b := h
  -- Read in a trivialization, the two orientations are orientations of `F`, whose rank is
  -- `card ι`, so they are equal or opposite.
  have hb := FiberBundle.mem_baseSet_trivializationAt' (F := F) (E := E) b'
  have hinj := ((trivializationAt F E b').mapOrientation ι hb).injective
  rcases Orientation.eq_or_eq_neg ((trivializationAt F E b').mapOrientation ι hb o')
    ((trivializationAt F E b').mapOrientation ι hb o) hι with h | h
  · obtain rfl := hinj h
    exact .inl rfl
  · rw [← Trivialization.mapOrientation_neg] at h
    obtain rfl := hinj h
    exact .inr rfl

/-- Over a preconnected base, a clopen subset of the orientation double cover that is invariant
under the deck involution is empty or the whole cover, provided `ι` has cardinality the rank of
the bundle. -/
theorem eq_empty_or_eq_univ_of_isClopen_of_forall_deck_mem [PreconnectedSpace B]
    (hι : Fintype.card ι = finrank ℝ F)
    {A : Set (VectorBundleOrientationCover F E ι)} (hA : IsClopen A)
    (hdeck : ∀ p ∈ A, deck p ∈ A) : A = ∅ ∨ A = univ := by
  -- `A` is a union of fibres, so its image in `B` is clopen: the projection is an open map.
  have hsat (p q : VectorBundleOrientationCover F E ι) (h : q.proj = p.proj) (hp : p ∈ A) :
      q ∈ A := by
    rcases eq_or_eq_deck hι h with rfl | rfl
    exacts [hp, hdeck p hp]
  have hcompl : (proj '' A)ᶜ = proj '' Aᶜ := by
    ext b
    obtain ⟨p, rfl⟩ := surjective_proj (F := F) (E := E) hι b
    simp only [mem_compl_iff, mem_image]
    refine ⟨fun h ↦ ⟨p, fun hp ↦ h ⟨p, hp, rfl⟩, rfl⟩, ?_⟩
    rintro ⟨q, hq, hqp⟩ ⟨r, hr, hrp⟩
    exact hq (hsat r q (hqp.trans hrp.symm) hr)
  have hopen := (isCoveringMap_proj (F := F) (E := E) hι).isOpenMap
  have hclopen : IsClopen (proj '' A) :=
    ⟨by rw [← isOpen_compl_iff, hcompl]; exact hopen _ hA.isClosed.isOpen_compl,
      hopen _ hA.isOpen⟩
  rcases isClopen_iff.1 hclopen with h | h
  · exact .inl (image_eq_empty.1 h)
  · refine .inr (eq_univ_of_forall fun p ↦ ?_)
    obtain ⟨q, hq, hqp⟩ : p.proj ∈ proj '' A := h ▸ mem_univ _
    exact hsat q p hqp.symm hq

/-- Over a preconnected base, a nonempty proper clopen subset of the orientation double cover
contains exactly one of the two points of each fibre, provided `ι` has cardinality the rank of
the bundle. -/
theorem deck_mem_iff_notMem_of_isClopen [PreconnectedSpace B]
    (hι : Fintype.card ι = finrank ℝ F) {C : Set (VectorBundleOrientationCover F E ι)}
    (hC : IsClopen C) (hC₀ : C.Nonempty) (hCuniv : C ≠ univ)
    (p : VectorBundleOrientationCover F E ι) : deck p ∈ C ↔ p ∉ C := by
  -- The points both of whose fibre points lie in `C`, or both outside `C`, form clopen
  -- deck-invariant sets, which must be empty.
  refine ⟨fun hp' hp ↦ ?_, fun hp ↦ ?_⟩
  · rcases eq_empty_or_eq_univ_of_isClopen_of_forall_deck_mem hι
      (hC.inter (hC.preimage deck.continuous))
        (fun q hq ↦ ⟨hq.2, by simpa only [mem_preimage, deck_deck] using hq.1⟩) with h | h
    · exact h.subset ⟨hp, hp'⟩
    · exact hCuniv (eq_univ_of_univ_subset (h.symm.subset.trans inter_subset_left))
  · rcases eq_empty_or_eq_univ_of_isClopen_of_forall_deck_mem hι
        (hC.compl.inter (hC.compl.preimage deck.continuous))
        (fun q hq ↦ ⟨hq.2, by simpa only [mem_preimage, deck_deck] using hq.1⟩) with h | h
    · exact not_not.1 fun hp' ↦ h.subset ⟨hp, hp'⟩
    · exact (hC₀.ne_empty (compl_univ_iff.1
        (eq_univ_of_univ_subset (h.symm.subset.trans inter_subset_left)))).elim

/-- Over a preconnected base, a nonempty proper clopen subset of the orientation double cover is
the image of a continuous section, provided `ι` has cardinality the rank of the bundle. -/
theorem exists_section_of_isClopen [PreconnectedSpace B] (hι : Fintype.card ι = finrank ℝ F)
    {C : Set (VectorBundleOrientationCover F E ι)} (hC : IsClopen C) (hC₀ : C.Nonempty)
    (hCuniv : C ≠ univ) :
    ∃ s : B → VectorBundleOrientationCover F E ι,
      Continuous s ∧ (∀ b, (s b).proj = b) ∧ range s = C := by
  classical
  have hdeck := deck_mem_iff_notMem_of_isClopen hι hC hC₀ hCuniv
  -- Choose any point over `b`, and replace it by the other point of its fibre if it is not
  -- in `C`.
  let r := Function.surjInv (surjective_proj (F := F) (E := E) hι)
  let s : B → VectorBundleOrientationCover F E ι := fun b ↦ if r b ∈ C then r b else deck (r b)
  have hsC (b : B) : s b ∈ C := by
    by_cases h : r b ∈ C
    · simp only [s, h, ↓reduceIte]
    · simpa only [s, h, ↓reduceIte] using (hdeck _).2 h
  have hsproj (b : B) : (s b).proj = b := by
    by_cases h : r b ∈ C
    · simpa only [s, h, ↓reduceIte] using Function.surjInv_eq _ b
    · simpa only [s, h, ↓reduceIte, proj_deck] using Function.surjInv_eq _ b
  have hsunique (q) (hq : q ∈ C) : s q.proj = q := by
    rcases eq_or_eq_deck hι (hsproj q.proj) with h | h
    · exact h
    · exact absurd (h ▸ hsC q.proj) ((hdeck q).1 · hq)
  refine ⟨s, continuous_def.2 fun V hV ↦ ?_, hsproj, (range_subset_iff.2 hsC).antisymm
    fun q hq ↦ ⟨q.proj, hsunique q hq⟩⟩
  -- The preimage of an open set `V` is the image of the open set `V ∩ C` under the projection,
  -- which is an open map.
  have hpre : s ⁻¹' V = proj '' (V ∩ C) := by
    ext b
    refine ⟨fun hb ↦ ⟨s b, ⟨hb, hsC b⟩, hsproj b⟩, ?_⟩
    rintro ⟨q, ⟨hqV, hqC⟩, rfl⟩
    rwa [mem_preimage, hsunique q hqC]
  rw [hpre]
  exact (isCoveringMap_proj (F := F) (E := E) hι).isOpenMap _ (hV.inter hC.isOpen)

end VectorBundleOrientationCover

namespace VectorBundleOrientation

variable [∀ b, TopologicalSpace (E b)] [FiberBundle F E] [VectorBundle ℝ F E]

/-- An orientation of the bundle from a family of fibre orientations whose associated section of
the orientation double cover is continuous. -/
def ofContinuous (o : ∀ b, Orientation ℝ (E b) ι)
    (ho : Continuous fun b ↦ (⟨b, o b⟩ : VectorBundleOrientationCover F E ι)) :
    VectorBundleOrientation F E ι where
  toFun := o
  eventually_mapOrientation_eq' b := by
    have hb := FiberBundle.mem_baseSet_trivializationAt' (F := F) (E := E) b
    have hmem : (⟨b, o b⟩ : VectorBundleOrientationCover F E ι) ∈
        VectorBundleOrientationCover.sheet (trivializationAt F E b)
          ((trivializationAt F E b).mapOrientation ι hb (o b)) := ⟨hb, rfl⟩
    filter_upwards [ho.continuousAt.preimage_mem_nhds
      ((VectorBundleOrientationCover.isOpen_sheet_trivializationAt _ _).mem_nhds hmem)]
      with x ⟨_, hx⟩ _
    exact hx

@[simp]
theorem coe_ofContinuous (o : ∀ b, Orientation ℝ (E b) ι)
    (ho : Continuous fun b ↦ (⟨b, o b⟩ : VectorBundleOrientationCover F E ι)) :
    ⇑(ofContinuous o ho) = o :=
  (rfl)

/-- The points of the orientation double cover lying on the section given by an orientation `o`
form an open set. -/
theorem isOpen_setOf_orientation_eq (o : VectorBundleOrientation F E ι) :
    IsOpen {p : VectorBundleOrientationCover F E ι | p.orientation = o p.proj} := by
  refine isOpen_iff_forall_mem_open.2 fun p hp ↦ ?_
  set e := trivializationAt F E p.proj
  have hb : p.proj ∈ e.baseSet := FiberBundle.mem_baseSet_trivializationAt' _
  obtain ⟨U, hUsub, hU, hpU⟩ := mem_nhds_iff.1 (o.eventually_mapOrientation_eq' p.proj)
  refine ⟨VectorBundleOrientationCover.proj ⁻¹' U ∩
      VectorBundleOrientationCover.sheet e (e.mapOrientation ι hb (o p.proj)),
    ?_, (VectorBundleOrientationCover.isOpen_preimage_proj hU).inter
      (VectorBundleOrientationCover.isOpen_sheet_trivializationAt _ _), hpU, hb, by rw [hp]⟩
  rintro q ⟨hqU, hq, hqo⟩
  exact (e.mapOrientation ι hq).injective (hqo.trans (hUsub hqU hq).symm)

variable [Fintype ι] [FiniteDimensional ℝ F]

/-- The section of the orientation double cover given by an orientation of the bundle is
continuous, provided `ι` has cardinality the rank of the bundle. -/
theorem continuous_mk_cover (hι : Fintype.card ι = finrank ℝ F)
    (o : VectorBundleOrientation F E ι) :
    Continuous fun b ↦ (⟨b, o b⟩ : VectorBundleOrientationCover F E ι) := by
  refine VectorBundleOrientationCover.continuous_of_isOpen_preimage_sheet continuous_id
    fun b o' ↦ isOpen_iff_mem_nhds.2 fun x ⟨hx, hxo⟩ ↦ ?_
  filter_upwards [o.eventually_mapOrientation_eq hι _ hx,
    (trivializationAt F E b).open_baseSet.mem_nhds hx] with y hy hy'
  exact ⟨hy', (hy hy').trans hxo⟩

/-- A bundle of rank `card ι` is orientable if and only if its orientation double cover has a
continuous section. -/
theorem nonempty_iff_exists_section (hι : Fintype.card ι = finrank ℝ F) :
    Nonempty (VectorBundleOrientation F E ι) ↔
      ∃ s : B → VectorBundleOrientationCover F E ι, Continuous s ∧ ∀ b, (s b).proj = b := by
  refine ⟨fun ⟨o⟩ ↦ ⟨_, o.continuous_mk_cover hι, fun _ ↦ rfl⟩, fun ⟨s, hs, hproj⟩ ↦ ?_⟩
  -- A section is determined by its fibre orientations, transported along `(s b).proj = b`.
  have key (p : VectorBundleOrientationCover F E ι) (b : B) (h : p.proj = b) :
      (⟨b, h ▸ p.orientation⟩ : VectorBundleOrientationCover F E ι) = p := by
    subst h
    rfl
  refine ⟨ofContinuous (fun b ↦ hproj b ▸ (s b).orientation) ?_⟩
  convert hs using 1
  exact funext fun b ↦ key (s b) b (hproj b)

/-- The points of the orientation double cover lying on the section given by an orientation `o`
form a clopen set, provided `ι` has cardinality the rank of the bundle. -/
theorem isClopen_setOf_orientation_eq (hι : Fintype.card ι = finrank ℝ F)
    (o : VectorBundleOrientation F E ι) :
    IsClopen {p : VectorBundleOrientationCover F E ι | p.orientation = o p.proj} := by
  -- The complement consists of the points on the section given by `-o`.
  have hcompl : {p : VectorBundleOrientationCover F E ι | p.orientation = o p.proj}ᶜ =
      {p | p.orientation = (-o) p.proj} := by
    ext ⟨b, o'⟩
    simp only [mem_compl_iff, mem_ofPred_eq, neg_apply]
    rcases VectorBundleOrientationCover.eq_or_eq_deck hι (p := ⟨b, o b⟩) (q := ⟨b, o'⟩) rfl
      with h | h
    · obtain rfl : o' = o b := VectorBundleOrientationCover.mk_eq_mk_iff.1 h
      exact iff_of_false (· rfl) (Module.Ray.ne_neg_self _)
    · rw [VectorBundleOrientationCover.deck_apply] at h
      obtain rfl : o' = -o b := VectorBundleOrientationCover.mk_eq_mk_iff.1 h
      exact iff_of_true (fun h' ↦ Module.Ray.ne_neg_self _ h'.symm) rfl
  exact ⟨isOpen_compl_iff.1 (hcompl ▸ (-o).isOpen_setOf_orientation_eq),
    o.isOpen_setOf_orientation_eq⟩

/-- Over a connected base, a bundle of rank `card ι` is orientable if and only if its orientation
double cover is disconnected. -/
theorem nonempty_iff_not_connectedSpace [ConnectedSpace B] (hι : Fintype.card ι = finrank ℝ F) :
    Nonempty (VectorBundleOrientation F E ι) ↔
      ¬ ConnectedSpace (VectorBundleOrientationCover F E ι) := by
  obtain ⟨b₀⟩ := ‹ConnectedSpace B›.toNonempty
  refine ⟨fun ⟨o⟩ hconn ↦ ?_, fun hnc ↦ ?_⟩
  · -- The image of the section given by `o` is a nonempty proper clopen subset of the cover.
    rcases isClopen_iff.1 (o.isClopen_setOf_orientation_eq hι) with h | h
    · exact (h.subset (show (⟨b₀, o b₀⟩ : VectorBundleOrientationCover F E ι) ∈ _ from rfl)).elim
    · have hmem : VectorBundleOrientationCover.deck
          (⟨b₀, o b₀⟩ : VectorBundleOrientationCover F E ι) ∈
          {p : VectorBundleOrientationCover F E ι | p.orientation = o p.proj} := h ▸ mem_univ _
      exact Module.Ray.ne_neg_self (o b₀) hmem.symm
  · -- A nonempty proper clopen subset of the cover is the image of a continuous section.
    obtain ⟨p₀, -⟩ := VectorBundleOrientationCover.surjective_proj (F := F) (E := E) hι b₀
    rw [connectedSpace_iff_clopen] at hnc
    push Not at hnc
    obtain ⟨C, hC, hC₀, hCuniv⟩ := hnc ⟨p₀⟩
    obtain ⟨s, hs, hsproj, -⟩ :=
      VectorBundleOrientationCover.exists_section_of_isClopen hι hC hC₀ hCuniv
    exact (nonempty_iff_exists_section hι).2 ⟨s, hs, hsproj⟩

end VectorBundleOrientation

end TauCeti
