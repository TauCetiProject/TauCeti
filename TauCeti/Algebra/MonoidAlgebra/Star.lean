module

public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.Algebra.Star.StarAlgHom
public import Mathlib.Algebra.Star.Unitary

/-!
# The involution of a group algebra

For a group `G` and a ⋆-ring `k`, the group algebra `k[G]` is a ⋆-ring with the involution
`(∑ r_g g)⋆ = ∑ r_g⋆ g⁻¹`, so `(single g r)⋆ = single g⁻¹ r⋆` (`MonoidAlgebra.star_single`). Every
group element `single g 1` is then unitary.

For a commutative ⋆-ring `k` and a ⋆-algebra `A` over `k`, the ⋆-algebra homomorphisms
`k[G] → A` correspond to the group homomorphisms from `G` into the unitary group of `A`,
`MonoidAlgebra.starLift`. This is the universal property of the group ⋆-algebra used to build
full group C⋆-algebras and universal C⋆-algebras generated by unitaries.

## Main definitions

* `MonoidAlgebra.instStarRing`: the involution `single g r ↦ single g⁻¹ r⋆` of `k[G]`.
* `MonoidAlgebra.starLift`: ⋆-algebra homomorphisms `k[G] →⋆ₐ[k] A` are group homomorphisms
  `G →* unitary A`.

## Main statements

* `MonoidAlgebra.coeff_star`: the coefficient of `x⋆` at `g` is `(x_{g⁻¹})⋆`.
* `MonoidAlgebra.single_one_mem_unitary`: group elements are unitary in `k[G]`.
* `MonoidAlgebra.starAlgHom_ext`: ⋆-algebra homomorphisms out of `k[G]` agree when they agree on
  the group elements.
-/

public section

noncomputable section

namespace MonoidAlgebra

variable {k G : Type*} [Group G]

section Star

variable [Semiring k] [StarRing k]

/-- The involution of a group algebra: `(∑ r_g g)⋆ = ∑ r_g⋆ g⁻¹`. -/
instance instStar : Star (MonoidAlgebra k G) where
  star x := ofCoeff ((x.coeff.mapRange star (star_zero k)).equivMapDomain (Equiv.inv G))

/-- The coefficient of `x⋆` at `g` is the conjugate of the coefficient of `x` at `g⁻¹`. -/
@[simp]
theorem coeff_star (x : MonoidAlgebra k G) (g : G) : (star x).coeff g = star (x.coeff g⁻¹) :=
  (rfl)

@[simp]
theorem star_single (g : G) (r : k) : star (single g r) = single g⁻¹ (star r) := by
  classical
  ext h
  rw [coeff_star, coeff_single, coeff_single, Finsupp.single_apply, Finsupp.single_apply]
  by_cases hg : g = h⁻¹ <;> simp [hg, inv_eq_iff_eq_inv]

instance instInvolutiveStar : InvolutiveStar (MonoidAlgebra k G) where
  star_involutive x := by ext g; simp

instance instStarAddMonoid : StarAddMonoid (MonoidAlgebra k G) where
  star_add x y := by ext g; simp

/-- The involution `single g r ↦ single g⁻¹ r⋆` makes a group algebra over a ⋆-ring a ⋆-ring. -/
instance instStarRing : StarRing (MonoidAlgebra k G) where
  star_add := star_add
  star_mul x y := by
    induction x using induction_linear with
    | zero => simp
    | add x x' hx hx' => simp only [add_mul, star_add, hx, hx', mul_add]
    | single g r =>
      induction y using induction_linear with
      | zero => simp
      | add y y' hy hy' => simp only [mul_add, star_add, hy, hy', add_mul]
      | single h s => simp [single_mul_single]

/-- A group element `single g 1` is unitary in the group algebra. -/
theorem single_one_mem_unitary (g : G) : single g (1 : k) ∈ unitary (MonoidAlgebra k G) := by
  simp [Unitary.mem_iff, single_mul_single, one_def]

end Star

section StarModule

variable [CommSemiring k] [StarRing k]

instance instStarModule : StarModule k (MonoidAlgebra k G) where
  star_smul r x := by ext g; simp

/-- ⋆-algebra homomorphisms out of a group algebra agree when they agree on the group elements. -/
@[ext high]
theorem starAlgHom_ext {A : Type*} [Semiring A] [Algebra k A] [Star A]
    ⦃φ ψ : MonoidAlgebra k G →⋆ₐ[k] A⦄
    (h : ∀ g, φ (single g 1) = ψ (single g 1)) : φ = ψ :=
  StarAlgHom.ext fun x => DFunLike.congr_fun (algHom_ext (φ₁ := (φ : MonoidAlgebra k G →ₐ[k] A))
    (φ₂ := (ψ : MonoidAlgebra k G →ₐ[k] A)) h (Subsingleton.elim _ _)) x

variable {A : Type*} [Semiring A] [Algebra k A] [StarRing A] [StarModule k A]

/-- The algebra homomorphism `k[G] → A` induced by a group homomorphism into the unitary group of
`A` preserves the involution. -/
private theorem lift_star (F : G →* unitary A) (x : MonoidAlgebra k G) :
    lift k A G ((unitary A).subtype.comp F) (star x) =
      star (lift k A G ((unitary A).subtype.comp F) x) := by
  induction x using induction_linear with
  | zero => simp
  | add x y hx hy => simp only [star_add, map_add, hx, hy]
  | single g r =>
    simp only [star_single, lift_single, MonoidHom.coe_comp, Submonoid.coe_subtype,
      Function.comp_apply, map_inv, star_smul, ← Unitary.star_eq_inv, Unitary.coe_star]

variable (k G A) in
/-- **The universal property of a group ⋆-algebra.** ⋆-algebra homomorphisms `k[G] → A` are the
group homomorphisms from `G` into the unitary group of `A`: a group homomorphism `F` extends
linearly, and a ⋆-algebra homomorphism `φ` restricts to `g ↦ φ (single g 1)`. -/
def starLift : (G →* unitary A) ≃ (MonoidAlgebra k G →⋆ₐ[k] A) where
  toFun F :=
    { lift k A G ((unitary A).subtype.comp F) with
      map_star' := lift_star F }
  invFun φ :=
    { toFun g := ⟨φ (single g 1), Unitary.map_mem φ (single_one_mem_unitary g)⟩
      map_one' := Subtype.ext (by simp [← one_def])
      map_mul' g h := Subtype.ext (by simp [← map_mul, single_mul_single]) }
  left_inv F := by ext g; simp
  right_inv φ := by ext g; simp

@[simp]
theorem starLift_single (F : G →* unitary A) (g : G) (r : k) :
    starLift k G A F (single g r) = r • (F g : A) :=
  lift_single _ g r

@[simp]
theorem starLift_symm_apply_coe (φ : MonoidAlgebra k G →⋆ₐ[k] A) (g : G) :
    ((starLift k G A).symm φ g : A) = φ (single g 1) :=
  (rfl)

end StarModule

end MonoidAlgebra
