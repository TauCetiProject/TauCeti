module

public import TauCeti.Algebra.Group.Submonoid.GroupCompletion
public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.Localization.LocalizationLocalization

/-!
# Localizing a semigroup algebra to its generated group

For an additive submonoid `S` of an abelian group, inverting all coefficient-one
monomials in `R[S]` gives `R[L_S]`, where `L_S = AddSubgroup.closure (S : Set G)`.
The algebra map is induced by `S.toGroupClosure`, so the target uses the generated
group rather than the ambient group. No saturation, finite generation, or domain
assumption on the coefficient semiring is needed.

The denominators are the native multiplicative range of `AddMonoidAlgebra.of R S`.
Every finite sum has a common monomial denominator, giving the native
`IsLocalization` interface and its universal property. Because `S` is cancellative, every
coefficient-one monomial in `R[S]` is a nonzerodivisor
(`AddSubmonoid.mrange_of_le_nonZeroDivisors`), so over any commutative ring `R`, any fraction ring
`K` of `R[S]` receives an injective canonical map from `R[L_S]`
(`AddSubmonoid.groupClosureToFractionRing`) that realizes `K` as a fraction ring of `R[L_S]`
(`AddSubmonoid.isFractionRing_addMonoidAlgebra_groupClosure`).

## Main definitions and results

* `AddSubmonoid.isLocalization_addMonoidAlgebra_groupClosure`: `R[AddSubgroup.closure S]` is the
  localization of `R[S]` at `MonoidHom.mrange (of R S)`.
* `AddSubmonoid.mrange_of_le_nonZeroDivisors`: every coefficient-one monomial in `R[S]` is a
  nonzerodivisor.
* `AddSubmonoid.isDomain_addMonoidAlgebra_groupClosure`: when `R[S]` is a domain, so is
  `R[AddSubgroup.closure S]`.
* `AddSubmonoid.groupClosureToFractionRing` and
  `AddSubmonoid.isFractionRing_addMonoidAlgebra_groupClosure`: any fraction ring `K` of `R[S]` is
  canonically a fraction ring of `R[AddSubgroup.closure S]`, with injective canonical map
  `AddSubmonoid.groupClosureToFractionRing_injective`.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 2,
  affine monoids and their group algebras.
* W. Fulton, *Introduction to Toric Varieties*, §1.1.
-/

public section

open AddMonoidAlgebra

namespace AddSubmonoid

variable {G : Type*} [AddCommGroup G] (S : AddSubmonoid G)

section CommSemiring

variable (R : Type*) [CommSemiring R]

/-- The algebra of the group generated by `S` is the localization of `R[S]` at all
coefficient-one monomials. The algebra structure is induced by the canonical inclusion
`S.toGroupClosure`. -/
theorem isLocalization_addMonoidAlgebra_groupClosure :
    letI := (mapDomainRingHom R S.toGroupClosure).toAlgebra
    IsLocalization (MonoidHom.mrange (of R S))
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) := by
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  have halg (a : AddMonoidAlgebra R S) :
      algebraMap _ (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) a =
        mapDomain S.toGroupClosure a := by
    rw [RingHom.algebraMap_toAlgebra, mapDomainRingHom_apply]
  refine ⟨⟨?_, ?_, ?_⟩⟩
  · intro s
    obtain ⟨m, hm⟩ := s.property
    rw [halg, ← hm, of_apply, mapDomain_single]
    exact (Group.isUnit (Multiplicative.ofAdd (S.toGroupClosure m.toAdd))).map
      (of R (AddSubgroup.closure (S : Set G)))
  · intro p
    induction p using AddMonoidAlgebra.induction_on with
    | of g =>
      obtain ⟨a, b, hab⟩ := S.exists_add_toGroupClosure_eq g
      refine ⟨⟨single a 1, ⟨of R S (Multiplicative.ofAdd b), ⟨_, rfl⟩⟩⟩, ?_⟩
      simp [halg, of_apply, hab]
    | add p q hp hq =>
      obtain ⟨⟨a, s⟩, ha⟩ := hp
      obtain ⟨⟨b, t⟩, hb⟩ := hq
      refine ⟨⟨a * t + b * s, s * t⟩, ?_⟩
      simp only [map_add, map_mul, Submonoid.coe_mul]
      rw [← ha, ← hb]
      ring
    | smul r p hp =>
      obtain ⟨⟨a, s⟩, ha⟩ := hp
      refine ⟨⟨r • a, s⟩, ?_⟩
      rw [smul_mul_assoc, ha]
      exact ((mapDomainAlgHom R R S.toGroupClosure).toLinearMap.map_smul r a).symm
  · intro a b hab
    refine ⟨1, ?_⟩
    rw [halg, halg] at hab
    simp [mapDomain_injective S.toGroupClosure_injective hab]

/-- Because `S` is cancellative, every coefficient-one monomial in `R[S]` is a nonzerodivisor, with
no domain assumption on `R` or `R[S]`. -/
theorem mrange_of_le_nonZeroDivisors :
    MonoidHom.mrange (of R S) ≤ nonZeroDivisors (AddMonoidAlgebra R S) := by
  rintro _ ⟨m, rfl⟩
  rw [mem_nonZeroDivisors_iff_right, of_apply]
  intro x hx
  ext b
  simpa [coeff_mul_single_add] using congr(($hx).coeff (b + Multiplicative.toAdd m))

end CommSemiring

section CommRing

variable (R : Type*) [CommRing R]

/-- When `R[S]` is a domain, so is the group algebra `R[AddSubgroup.closure S]` of the subgroup
generated by `S`. -/
theorem isDomain_addMonoidAlgebra_groupClosure [IsDomain (AddMonoidAlgebra R S)] :
    IsDomain (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) :=
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  IsLocalization.isDomain_of_le_nonZeroDivisors _ (S.mrange_of_le_nonZeroDivisors R)

/-- The canonical ring homomorphism from `R[AddSubgroup.closure S]` into any fraction ring `K` of
`R[S]`, obtained by inverting all coefficient-one monomials of `R[S]` without enlarging the lattice
`AddSubgroup.closure S`. -/
noncomputable def groupClosureToFractionRing
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    AddMonoidAlgebra R (AddSubgroup.closure (S : Set G)) →+* K :=
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  IsLocalization.lift (M := MonoidHom.mrange (of R S))
    (g := algebraMap (AddMonoidAlgebra R S) K)
    fun u ↦ IsLocalization.map_units K ⟨u.1, S.mrange_of_le_nonZeroDivisors R u.2⟩

/-- Composing `S.groupClosureToFractionRing R K` with the inclusion of `R[S]` into
`R[AddSubgroup.closure S]` recovers `algebraMap R[S] K`. -/
@[simp]
theorem groupClosureToFractionRing_comp_mapDomainRingHom
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    (S.groupClosureToFractionRing R K).comp (mapDomainRingHom R S.toGroupClosure) =
      algebraMap (AddMonoidAlgebra R S) K := by
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  exact IsLocalization.lift_comp _

/-- On elements pushed forward from `R[S]`, `S.groupClosureToFractionRing R K` agrees with
`algebraMap R[S] K`. -/
@[simp]
theorem groupClosureToFractionRing_mapDomain_toGroupClosure
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] (x : AddMonoidAlgebra R S) :
    S.groupClosureToFractionRing R K (mapDomain S.toGroupClosure x) =
      algebraMap (AddMonoidAlgebra R S) K x :=
  RingHom.congr_fun (S.groupClosureToFractionRing_comp_mapDomainRingHom R K) x

/-- On monomials from `S`, `S.groupClosureToFractionRing R K` agrees with `algebraMap R[S] K`. -/
@[simp]
theorem groupClosureToFractionRing_single_toGroupClosure
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] (a : S) (r : R) :
    S.groupClosureToFractionRing R K (single (S.toGroupClosure a) r) =
      algebraMap (AddMonoidAlgebra R S) K (single a r) := by
  rw [← mapDomain_single, S.groupClosureToFractionRing_mapDomain_toGroupClosure R K]

/-- Any fraction ring `K` of `R[S]` is also a fraction ring of `R[AddSubgroup.closure S]` along
`S.groupClosureToFractionRing R K`. -/
theorem isFractionRing_addMonoidAlgebra_groupClosure
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    letI := (S.groupClosureToFractionRing R K).toAlgebra
    IsFractionRing (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K := by
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  let := (S.groupClosureToFractionRing R K).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  have : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K :=
    IsScalarTower.of_algebraMap_eq' (S.groupClosureToFractionRing_comp_mapDomainRingHom R K).symm
  exact IsFractionRing.isFractionRing_of_isLocalization
    (MonoidHom.mrange (of R S)) (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K
    (S.mrange_of_le_nonZeroDivisors R)

/-- The canonical homomorphism `R[AddSubgroup.closure S] →+* K` into a fraction ring of `R[S]` is
injective. -/
theorem groupClosureToFractionRing_injective
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    Function.Injective (S.groupClosureToFractionRing R K) := by
  let := (S.groupClosureToFractionRing R K).toAlgebra
  have := S.isFractionRing_addMonoidAlgebra_groupClosure R K
  exact IsFractionRing.injective (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K

end CommRing

end AddSubmonoid
