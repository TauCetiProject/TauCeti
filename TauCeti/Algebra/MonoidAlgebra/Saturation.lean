module

public import TauCeti.Algebra.Group.Submonoid.GroupCompletion
public import TauCeti.Algebra.Group.Submonoid.NSMulSaturation
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed

/-!
# Integral monomials and saturation of semigroups

Let `f : M →+ N` be a homomorphism of commutative monoids, inducing `R[M] → R[N]`. A
coefficient-one monomial `single x 1` of `R[N]` is integral over `R[M]` as soon as some positive
multiple of `x` lies in the image of `f`, that is, when `x` lies in the positive-multiple
saturation of `AddMonoidHom.mrange f`. When `R` is nontrivial and `N` is cancellative, this is
also necessary. For the inclusion of a submonoid `S ≤ N` it follows that `R[sat S]` is integral
over `R[S]`, and that `sat S` is precisely the set of exponents of the coefficient-one monomials
of `R[N]` that are integral over `R[S]`.

Conversely, if `R[S]` is an integrally closed domain then `S` is saturated inside the group it
generates: an element `x` of that group with `n • x ∈ S` for some `n ≠ 0` already lies in `S`.
This is the implication from normality of `R[S]` to saturation of `S`, and it is stated without
reference to a fraction field, through `IsIntegrallyClosed.pow_dvd_pow_iff`.

## Main results

* `AddMonoidAlgebra.isIntegralElem_single_one_iff`: `single x 1` is integral over `R[M]` iff
  `x ∈ (AddMonoidHom.mrange f).nsmulSaturation`.
* `AddMonoidAlgebra.isIntegral_mapDomainRingHom_inclusion_nsmulSaturation`: `R[sat S]` is
  integral over `R[S]`.
* `AddSubmonoid.mem_of_nsmul_mem_of_add_mem`: if `R[S]` is an integrally closed domain,
  `b ∈ S`, `x + b ∈ S` and `n • x ∈ S` with `n ≠ 0`, then `x ∈ S`.
* `AddSubmonoid.nsmulSaturation_inf_closure_eq`: for a submonoid `S` of an abelian group with
  `R[S]` an integrally closed domain, the saturation of `S` meets the group generated by `S`
  exactly in `S`.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 4, normality of affine
  monoid algebras.
* W. Bruns and J. Herzog, *Cohen–Macaulay Rings*, §6.1, normal semigroup rings.
-/

public section

open Polynomial

namespace AddMonoidAlgebra

variable {R M N : Type*} [CommRing R] [AddCommMonoid M] [AddCommMonoid N]

/-- A coefficient-one monomial whose exponent has a positive multiple in the image of `f` is
integral over `R[M]`: it is a root of `X ^ n - C (single m 1)` when `n • x = f m`. -/
theorem isIntegralElem_single_one (f : M →+ N) {x : N}
    (hx : x ∈ (AddMonoidHom.mrange f).nsmulSaturation) :
    (mapDomainRingHom R f).IsIntegralElem (single x (1 : R)) := by
  obtain ⟨n, hn, m, hm⟩ := AddSubmonoid.mem_nsmulSaturation.mp hx
  refine ⟨X ^ n - C (single m 1), monic_X_pow_sub_C _ hn.ne', ?_⟩
  simp [single_pow, hm]

/-- A coefficient-one monomial `single x 1` of `R[N]` is integral over `R[M]` exactly when some
positive multiple of `x` lies in the image of `f`. -/
theorem isIntegralElem_single_one_iff [Nontrivial R] [IsRightCancelAdd N] (f : M →+ N) {x : N} :
    (mapDomainRingHom R f).IsIntegralElem (single x (1 : R)) ↔
      x ∈ (AddMonoidHom.mrange f).nsmulSaturation := by
  refine ⟨fun ⟨p, hp, hpx⟩ ↦ ?_, isIntegralElem_single_one f⟩
  by_contra hx
  -- The coefficient of the monic equation at `p.natDegree • x` comes only from its leading
  -- term: every lower term `f (p.coeff i) * single (i • x) 1` would need an exponent
  -- `(p.natDegree - i) • x` in the image of `f`.
  have hterm (i : ℕ) (hi : i < p.natDegree) :
      (mapDomainRingHom R f (p.coeff i) * single x 1 ^ i).coeff (p.natDegree • x) = 0 := by
    have hsplit : p.natDegree • x = (p.natDegree - i) • x + i • x := by
      rw [← add_nsmul, Nat.sub_add_cancel hi.le]
    rw [single_pow, one_pow, hsplit, coeff_mul_single_eq_coeff_mul ((p.natDegree - i) • x)
      (fun _ _ ↦ add_left_inj _), mul_one, mapDomainRingHom_apply, coeff_mapDomain]
    refine Finsupp.mapDomain_of_notMem_range _ _ fun hmem ↦ hx ?_
    obtain ⟨m, hm⟩ := hmem
    exact AddSubmonoid.mem_nsmulSaturation.mpr ⟨p.natDegree - i, by lia, m, hm⟩
  have hcoeff := congr(($hpx).coeff (p.natDegree • x))
  rw [eval₂_eq_sum_range, coeff_sum, Finsupp.finsetSum_apply, Finset.sum_range_succ,
    Finset.sum_eq_zero fun i hi ↦ hterm i (Finset.mem_range.mp hi), hp.coeff_natDegree] at hcoeff
  simp [single_pow] at hcoeff

/-- The algebra of the saturation of `S` is integral over the algebra of `S`. -/
theorem isIntegral_mapDomainRingHom_inclusion_nsmulSaturation (S : AddSubmonoid N) :
    (mapDomainRingHom R (AddSubmonoid.inclusion S.le_nsmulSaturation)).IsIntegral := by
  intro y
  induction y using induction_linear with
  | zero => exact RingHom.isIntegralElem_zero _
  | add y z hy hz => exact hy.add _ hz
  | single x r =>
    set ι := AddSubmonoid.inclusion S.le_nsmulSaturation
    obtain ⟨n, hn, hnx⟩ := AddSubmonoid.mem_nsmulSaturation.mp x.property
    have hx : x ∈ (AddMonoidHom.mrange ι).nsmulSaturation :=
      AddSubmonoid.mem_nsmulSaturation.mpr ⟨n, hn, ⟨n • (x : N), hnx⟩, Subtype.ext (by simp [ι])⟩
    have hr : (mapDomainRingHom R ι).IsIntegralElem (mapDomainRingHom R ι (single 0 r)) :=
      RingHom.isIntegralElem_map _
    have h1 : (mapDomainRingHom R ι).IsIntegralElem (single x 1) :=
      isIntegralElem_single_one ι hx
    have hsingle : single x r = mapDomainRingHom R ι (single 0 r) * single x 1 := by simp [ι]
    rw [hsingle]
    exact hr.mul _ h1

end AddMonoidAlgebra

namespace AddSubmonoid

open AddMonoidAlgebra

variable {N : Type*} [AddCommMonoid N] [IsRightCancelAdd N]

/-- If the algebra of `S` is an integrally closed domain, then `S` is saturated relative to its
differences: when `b ∈ S`, `x + b ∈ S` and `n • x ∈ S` for some `n ≠ 0`, already `x ∈ S`. -/
theorem mem_of_nsmul_mem_of_add_mem (S : AddSubmonoid N) (R : Type*) [CommRing R]
    [IsDomain (AddMonoidAlgebra R S)] [IsIntegrallyClosed (AddMonoidAlgebra R S)]
    {x b : N} (hb : b ∈ S) (hxb : x + b ∈ S) {n : ℕ} (hn : n ≠ 0) (hnx : n • x ∈ S) :
    x ∈ S := by
  have hpow : single (⟨b, hb⟩ : S) (1 : R) ^ n ∣ single (⟨x + b, hxb⟩ : S) (1 : R) ^ n :=
    ⟨single ⟨n • x, hnx⟩ 1, by
      simp only [single_pow, one_pow, single_mul_single, mul_one]
      congr 1
      exact Subtype.ext (by simp [add_comm])⟩
  obtain ⟨d, hd⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff hn).mp hpow
  by_contra hx
  have hne (e : S) : ⟨b, hb⟩ + e ≠ ⟨x + b, hxb⟩ := fun he ↦ by
    have he' : (e : N) + b = x + b := by rw [add_comm]; exact congr_arg Subtype.val he
    exact hx (add_right_cancel he' ▸ e.property)
  have hcoeff := congr(($hd).coeff ⟨x + b, hxb⟩)
  rw [coeff_single_mul_of_forall_add_ne _ _ hne,
    coeff_single, Finsupp.single_eq_same] at hcoeff
  exact one_ne_zero (α := AddMonoidAlgebra R S) (by rw [one_def, hcoeff, single_zero])

/-- If the algebra of a submonoid `S` of an abelian group is an integrally closed domain, then
`S` is saturated inside the group it generates: the saturation of `S` meets
`AddSubgroup.closure S` exactly in `S`. -/
theorem nsmulSaturation_inf_closure_eq {G : Type*} [AddCommGroup G] (S : AddSubmonoid G)
    (R : Type*) [CommRing R] [IsDomain (AddMonoidAlgebra R S)]
    [IsIntegrallyClosed (AddMonoidAlgebra R S)] :
    S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S := by
  refine le_antisymm (fun x hx ↦ ?_) (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)
  obtain ⟨n, hn, hnx⟩ := mem_nsmulSaturation.mp hx.1
  obtain ⟨a, b, rfl⟩ := S.mem_groupClosure_iff.mp hx.2
  exact S.mem_of_nsmul_mem_of_add_mem R b.property (by simp) hn.ne' hnx

end AddSubmonoid
