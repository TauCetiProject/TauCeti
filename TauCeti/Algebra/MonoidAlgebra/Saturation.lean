/-!
# Integral closure, finite normalization, and normality of semigroup algebras

Let `f : M →+ N` be a homomorphism of commutative monoids, inducing `R[M] → R[N]`. A monomial
`single x c` of `R[N]` is integral over `R[M]` as soon as some positive multiple of `x` lies in the
image of `f`, that is, when `x` lies in the positive-multiple saturation of
`AddMonoidHom.mrange f`. When `c` is not nilpotent and `N` is cancellative, this is also
necessary. For the inclusion of a submonoid `S ≤ N` it follows that `R[sat S]` is integral over
`R[S]`; if `T ≤ sat S` is finitely generated, `R[T]` is even module-finite over `R[S]`
(`AddMonoidAlgebra.finite_mapDomainRingHom_inclusion_of_le_nsmulSaturation`).

When `N = G` is a torsion-free abelian group (`[Module.IsTorsionFree ℤ G]`) and `R` is reduced,
reducing to a finitely generated—hence free—subgroup shows via
`AddMonoidAlgebra.isIntegralElem_single_coeff` that the integral closure of `R[M]` in `R[G]` is
graded, so it consists of the elements supported on the saturation of `AddMonoidHom.mrange f`.

For a submonoid `S ≤ G`, let `L_S = AddSubgroup.closure (S : Set G)` be the subgroup generated by
`S` without enlarging the ambient lattice. Because `R[L_S]` is the localization of `R[S]` at its
monomials (`AddSubmonoid.isLocalization_addMonoidAlgebra_groupClosure`), any fraction ring `K` of
`R[S]` is canonically a fraction ring of `R[L_S]` (`AddSubmonoid.groupClosureToFractionRing`,
`AddSubmonoid.isFractionRing_addMonoidAlgebra_groupClosure`). When `R` is an integrally closed
domain, `R[L_S]` is integrally closed (`AddMonoidAlgebra.isIntegrallyClosed`), so the integral
closure of `R[S]` in `K` coincides with its integral closure in `R[L_S]`, namely
`R[sat S ⊓ L_S]` (`AddSubmonoid.isIntegralClosure_nsmulSaturation_inf_closure`,
`AddSubmonoid.integralClosureEquiv`). When `S` is finitely generated, this normalization is a
finitely generated `R[S]`-module (`AddSubmonoid.moduleFinite_integralClosure`).

Combining both directions yields the exact normality criterion over any integral domain `R`
(`AddSubmonoid.isIntegrallyClosed_addMonoidAlgebra_iff`): `R[S]` is integrally closed if and only
if `R` is integrally closed and `S.nsmulSaturation ⊓ L_S = S`.

## Main definitions

* `AddSubmonoid.groupClosureToFractionRing`: canonical embedding of `R[AddSubgroup.closure S]` into
  any fraction ring `K` of `R[S]`.
* `AddSubmonoid.saturationInfClosureToFractionRing`: canonical embedding of
  `R[S.nsmulSaturation ⊓ AddSubgroup.closure S]` into `K`.
* `AddSubmonoid.integralClosureEquiv`: `(AddMonoidAlgebra R S)`-algebra isomorphism between
  `R[S.nsmulSaturation ⊓ AddSubgroup.closure S]` and `integralClosure (AddMonoidAlgebra R S) K`.

## Main results

* `AddMonoidAlgebra.finite_mapDomainRingHom_inclusion_of_le_nsmulSaturation`,
  `AddMonoidAlgebra.finite_mapDomainRingHom_inclusion_nsmulSaturation`, and
  `AddMonoidAlgebra.finite_mapDomainRingHom_inclusion_nsmulSaturation_inf_closure`: finite
  normalization of semigroup algebras.
* `AddMonoidAlgebra.isIntegralElem_iff_forall_mem_support`: for a torsion-free abelian group `G`
  and a reduced ring `R`, an element of `R[G]` is integral over `R[M]` iff its support lies in the
  saturation of `AddMonoidHom.mrange f`.
* `AddSubmonoid.isIntegralClosure_nsmulSaturation_inf_closure`: over an integrally closed domain
  `R`, `R[S.nsmulSaturation ⊓ AddSubgroup.closure S]` is the integral closure of `R[S]` in its
  fraction field `K`.
* `AddSubmonoid.moduleFinite_integralClosure`: finite generation of the normalization when `S.FG`.
* `AddSubmonoid.isIntegrallyClosed_addMonoidAlgebra_iff`: over a domain `R`, `R[S]` is integrally
  closed iff `R` is integrally closed and `S` is saturated inside `AddSubgroup.closure S`.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Theorem 4.40.
* W. Bruns and J. Herzog, *Cohen–Macaulay Rings*, Theorem 6.1.4.
* R. Gilmer, *Commutative Semigroup Rings*, Theorems 12.10 and 12.11.
-/

public section

open Polynomial

namespace AddMonoidAlgebra

variable {R M N : Type*} [CommRing R] [AddCommMonoid M] [AddCommMonoid N]

/-- A monomial whose exponent has a positive multiple in the image of `f` is integral over
`R[M]`: it is a root of `X ^ n - C (single m (c ^ n))` when `n • x = f m`. -/
theorem isIntegralElem_single (f : M →+ N) {x : N}
    (hx : x ∈ (AddMonoidHom.mrange f).nsmulSaturation) (c : R) :
    (mapDomainRingHom R f).IsIntegralElem (single x c) := by
  obtain ⟨n, hn, m, hm⟩ := AddSubmonoid.mem_nsmulSaturation.mp hx
  refine ⟨X ^ n - C (single m (c ^ n)), monic_X_pow_sub_C _ hn.ne', ?_⟩
  simp [single_pow, hm]

/-- A monomial `single x c` of `R[N]` with non-nilpotent coefficient is integral over `R[M]`
exactly when some positive multiple of `x` lies in the image of `f`. -/
theorem isIntegralElem_single_iff [IsRightCancelAdd N] (f : M →+ N) {x : N} {c : R}
    (hc : ¬IsNilpotent c) :
    (mapDomainRingHom R f).IsIntegralElem (single x c) ↔
      x ∈ (AddMonoidHom.mrange f).nsmulSaturation := by
  refine ⟨fun ⟨p, hp, hpx⟩ ↦ ?_, (isIntegralElem_single f · c)⟩
  by_contra hx
  -- The coefficient of the monic equation at `p.natDegree • x` comes only from its leading
  -- term: every lower term `f (p.coeff i) * single (i • x) (c ^ i)` would need an exponent
  -- `(p.natDegree - i) • x` in the image of `f`.
  have hterm (i : ℕ) (hi : i < p.natDegree) :
      (mapDomainRingHom R f (p.coeff i) * single x c ^ i).coeff (p.natDegree • x) = 0 := by
    have hsplit : p.natDegree • x = (p.natDegree - i) • x + i • x := by
      rw [← add_nsmul, Nat.sub_add_cancel hi.le]
    rw [single_pow, hsplit, coeff_mul_single_eq_coeff_mul ((p.natDegree - i) • x)
      (fun _ _ ↦ add_left_inj _), mapDomainRingHom_apply, coeff_mapDomain,
      Finsupp.mapDomain_of_notMem_range, zero_mul]
    rintro ⟨m, hm⟩
    exact hx (AddSubmonoid.mem_nsmulSaturation.mpr ⟨p.natDegree - i, by lia, m, hm⟩)
  have hcoeff := congr(($hpx).coeff (p.natDegree • x))
  rw [eval₂_eq_sum_range, coeff_sum, Finsupp.finsetSum_apply, Finset.sum_range_succ,
    Finset.sum_eq_zero fun i hi ↦ hterm i (Finset.mem_range.mp hi), hp.coeff_natDegree] at hcoeff
  exact hc ⟨p.natDegree, by simpa [single_pow] using hcoeff⟩

/-- The algebra of the saturation of `S` is integral over the algebra of `S`. -/
theorem isIntegral_mapDomainRingHom_inclusion_nsmulSaturation (S : AddSubmonoid N) :
    (mapDomainRingHom R (AddSubmonoid.inclusion S.le_nsmulSaturation)).IsIntegral := by
  intro y
  induction y using induction_linear with
  | zero => exact RingHom.isIntegralElem_zero _
  | add y z hy hz => exact hy.add _ hz
  | single x r =>
    obtain ⟨n, hn, hnx⟩ := AddSubmonoid.mem_nsmulSaturation.mp x.property
    exact isIntegralElem_single _ (AddSubmonoid.mem_nsmulSaturation.mpr
      ⟨n, hn, ⟨n • (x : N), hnx⟩, Subtype.ext (by simp)⟩) r

/-- **Finite normalization for submonoids inside the saturation.** If `S ≤ T ≤ S.nsmulSaturation`
and `T` is finitely generated, then `R[T]` is a finite `R[S]`-algebra. -/
theorem finite_mapDomainRingHom_inclusion_of_le_nsmulSaturation {S T : AddSubmonoid N}
    (hST : S ≤ T) (hTS : T ≤ S.nsmulSaturation) (hT : T.FG) :
    (mapDomainRingHom R (AddSubmonoid.inclusion hST)).Finite := by
  classical
  let := (mapDomainRingHom R (AddSubmonoid.inclusion hST)).toAlgebra
  obtain ⟨F, hFT, hdecomp⟩ := hT.exists_finset_subset_forall_exists_add hTS
  let gens : Finset (AddMonoidAlgebra R T) := F.attach.image fun z ↦ single ⟨z.1, hFT z.2⟩ (1 : R)
  have hspan (x : AddMonoidAlgebra R T) :
      x ∈ Submodule.span (AddMonoidAlgebra R S) (gens : Set (AddMonoidAlgebra R T)) := by
    induction x using induction_linear with
    | zero => exact Submodule.zero_mem _
    | add x y hx hy => exact Submodule.add_mem _ hx hy
    | single t r =>
      obtain ⟨z, hzF, y, hyS, ht⟩ := hdecomp t.1 t.2
      have hmem : single (⟨z, hFT hzF⟩ : T) (1 : R) ∈
          Submodule.span (AddMonoidAlgebra R S) (gens : Set (AddMonoidAlgebra R T)) :=
        Submodule.subset_span (Finset.mem_image_of_mem _ (Finset.mem_attach _ ⟨z, hzF⟩))
      have hsmul := Submodule.smul_mem _ (single (⟨y, hyS⟩ : S) r) hmem
      have heq : AddSubmonoid.inclusion hST ⟨y, hyS⟩ + ⟨z, hFT hzF⟩ = t :=
        Subtype.ext (by simp [ht, add_comm])
      simpa [Algebra.smul_def, RingHom.algebraMap_toAlgebra, mapDomainRingHom_apply,
        mapDomain_single, single_mul_single, heq] using hsmul
  exact Module.Finite.of_fg_top ⟨gens, top_unique fun x _ ↦ hspan x⟩

/-- In a free `ℤ`-module `G`, the algebra `R[sat S]` of the saturation of a finitely generated
submonoid `S` is a finite `R[S]`-algebra. -/
theorem finite_mapDomainRingHom_inclusion_nsmulSaturation {G : Type*} [AddCommGroup G]
    [Module.Free ℤ G] {S : AddSubmonoid G} (hS : S.FG) :
    (mapDomainRingHom R (AddSubmonoid.inclusion S.le_nsmulSaturation)).Finite :=
  finite_mapDomainRingHom_inclusion_of_le_nsmulSaturation S.le_nsmulSaturation le_rfl
    hS.nsmulSaturation

/-- In a torsion-free abelian group `G`, the algebra `R[sat S ⊓ AddSubgroup.closure S]` of a
finitely generated submonoid `S` is a finite `R[S]`-algebra. -/
theorem finite_mapDomainRingHom_inclusion_nsmulSaturation_inf_closure {G : Type*} [AddCommGroup G]
    [Module.IsTorsionFree ℤ G] {S : AddSubmonoid G} (hS : S.FG) :
    (mapDomainRingHom R
      (AddSubmonoid.inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).Finite :=
  finite_mapDomainRingHom_inclusion_of_le_nsmulSaturation _ inf_le_left
    hS.nsmulSaturation_inf_closure

section TorsionFreeGroup

private theorem isIntegralElem_iff_forall_mem_support_of_free {G : Type*} [AddCommGroup G]
    [Module.Free ℤ G] [IsReduced R] (f : M →+ G) {x : AddMonoidAlgebra R G} :
    (mapDomainRingHom R f).IsIntegralElem x ↔
      ∀ g ∈ x.coeff.support, g ∈ (AddMonoidHom.mrange f).nsmulSaturation := by
  refine ⟨fun hx g hg ↦ ?_, fun h ↦ ?_⟩
  · refine (isIntegralElem_single_iff f ?_).mp (isIntegralElem_single_coeff f hx g)
    exact fun hnil ↦ Finsupp.mem_support_iff.mp hg hnil.eq_zero
  · rw [← sum_coeff_single x, Finsupp.sum]
    exact Finset.sum_induction _ _ (fun _ _ ha hb ↦ ha.add _ hb) (RingHom.isIntegralElem_zero _)
      fun g hg ↦ isIntegralElem_single f (h g hg) _

variable {G : Type*} [AddCommGroup G] [Module.IsTorsionFree ℤ G]

/-- **The integral closure of a monoid algebra in the algebra of a torsion-free abelian group.**
Over a reduced ring `R`, an element of `R[G]` is integral over `R[M]` along `f : M →+ G` exactly
when its support lies in the saturation of the image of `f`. -/
theorem isIntegralElem_iff_forall_mem_support [IsReduced R] (f : M →+ G)
    {x : AddMonoidAlgebra R G} :
    (mapDomainRingHom R f).IsIntegralElem x ↔
      ∀ g ∈ x.coeff.support, g ∈ (AddMonoidHom.mrange f).nsmulSaturation := by
  classical
  refine ⟨fun ⟨p, hp, hpx⟩ g hg ↦ ?_, fun h ↦ ?_⟩
  · -- Restrict `M` and `G` to the finitely generated submonoid and subgroup spanned by the
    -- exponents appearing in `x` and `p`, so `H` is a free `ℤ`-module.
    let F_M : Finset M := p.support.biUnion fun i ↦ (p.coeff i).coeff.support
    let M₀ : AddSubmonoid M := AddSubmonoid.closure (F_M : Set M)
    let F_G : Finset G := x.coeff.support ∪ F_M.image f
    let H : AddSubgroup G := AddSubgroup.closure (F_G : Set G)
    have hH_fg : H.FG := AddSubgroup.isAddFG_iff.mpr ⟨F_G, rfl⟩
    have : AddGroup.FG H := (AddGroup.fg_iff_addSubgroup_fg H).mpr hH_fg
    have : Module.Finite ℤ H := Module.Finite.iff_addGroup_fg.mpr this
    have : Module.IsTorsionFree ℤ H :=
      H.subtype_injective.moduleIsTorsionFree H.subtype fun _ _ ↦ rfl
    have : Module.Free ℤ H := Module.free_of_finite_type_torsion_free'
    have hfM₀ (m : M₀) : f m.1 ∈ H :=
      (AddSubmonoid.closure_le (s := (F_M : Set M)) (S := H.toAddSubmonoid.comap f)).mpr
        (fun a ha ↦ AddSubgroup.subset_closure (Finset.mem_union_right _
          (Finset.mem_image_of_mem f ha))) m.2
    let f₀ : M₀ →+ H := (f.comp M₀.subtype).codRestrict H hfM₀
    have hf₀_comp : H.subtype.comp f₀ = f.comp M₀.subtype := rfl
    obtain ⟨x₀, hx₀⟩ : x ∈ Set.range (mapDomainRingHom R H.subtype) :=
      (mem_range_mapDomain_iff H.subtype_injective x).mpr fun a ha ↦
        ⟨⟨a, AddSubgroup.subset_closure (Finset.mem_union_left _ ha)⟩, rfl⟩
    have hlifts : p ∈ Polynomial.lifts (mapDomainRingHom R M₀.subtype) :=
      (Polynomial.lifts_iff_coeff_lifts p).mpr fun i ↦ by
        by_cases hi : i ∈ p.support
        · exact (mem_range_mapDomain_iff M₀.subtype_injective (p.coeff i)).mpr fun m hm ↦
            ⟨⟨m, AddSubmonoid.subset_closure
              (Finset.mem_biUnion.mpr ⟨i, hi, hm⟩)⟩, rfl⟩
        · exact ⟨0, by simp [Polynomial.notMem_support_iff.mp hi]⟩
    obtain ⟨p₀, hp₀, -, hp₀_monic⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlifts hp
    have hcomm :
        (mapDomainRingHom R H.subtype).comp (mapDomainRingHom R f₀) =
          (mapDomainRingHom R f).comp (mapDomainRingHom R M₀.subtype) := by
      rw [← mapDomainRingHom_comp, ← mapDomainRingHom_comp, hf₀_comp]
    have hx₀_int : (mapDomainRingHom R f₀).IsIntegralElem x₀ :=
      ⟨p₀, hp₀_monic, mapDomain_injective H.subtype_injective <| by
        rw [mapDomain_zero, ← mapDomainRingHom_apply, Polynomial.hom_eval₂, hcomm,
          ← Polynomial.eval₂_map, hp₀, hx₀, hpx]⟩
    have hgH : g ∈ H := AddSubgroup.subset_closure (Finset.mem_union_left _ hg)
    have hg₀ : (⟨g, hgH⟩ : H) ∈ x₀.coeff.support := by
      refine Finsupp.mem_support_iff.mpr fun h0 ↦ Finsupp.mem_support_iff.mp hg ?_
      rw [← hx₀, mapDomainRingHom_apply, coeff_mapDomain]
      change (Finsupp.mapDomain H.subtype x₀.coeff) (H.subtype ⟨g, hgH⟩) = 0
      rw [Finsupp.mapDomain_apply_of_injective H.subtype_injective, h0]
    obtain ⟨n, hn, m₀, hm₀⟩ := AddSubmonoid.mem_nsmulSaturation.mp
      ((isIntegralElem_iff_forall_mem_support_of_free f₀).mp hx₀_int ⟨g, hgH⟩ hg₀)
    exact AddSubmonoid.mem_nsmulSaturation.mpr ⟨n, hn, m₀.1, congrArg Subtype.val hm₀⟩
  · rw [← sum_coeff_single x, Finsupp.sum]
    exact Finset.sum_induction _ _ (fun _ _ ha hb ↦ ha.add _ hb) (RingHom.isIntegralElem_zero _)
      fun g hg ↦ isIntegralElem_single f (h g hg) _

end TorsionFreeGroup

end AddMonoidAlgebra

namespace AddSubmonoid

open AddMonoidAlgebra

variable {N : Type*} [AddCommMonoid N] [IsRightCancelAdd N]

/-- If the algebra of `S` is an integrally closed domain, then `S` is saturated relative to its
differences: when `b ∈ S`, `x + b ∈ S` and `n • x ∈ S` for some `n ≠ 0`, already `x ∈ S`. -/
theorem mem_of_nsmul_mem_of_add_mem (S : AddSubmonoid N) (R : Type*) [CommRing R]
    [IsDomain (AddMonoidAlgebra R S)] [IsIntegrallyClosed (AddMonoidAlgebra R S)]
    {x b : N} (hb : b ∈ S) (hxb : x + b ∈ S) {n : ℕ} (hn : n ≠ 0) (hnx : n • x ∈ S) :
    x ∈ S := by
  have hpow : single (⟨b, hb⟩ : S) (1 : R) ^ n ∣ single (⟨x + b, hxb⟩ : S) (1 : R) ^ n :=
    ⟨single ⟨n • x, hnx⟩ 1, by
      simp only [single_pow, one_pow, single_mul_single, mul_one]
      congr 1
      exact Subtype.ext (by simp [add_comm])⟩
  obtain ⟨d, hd⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff hn).mp hpow
  by_contra hx
  have hne (e : S) : ⟨b, hb⟩ + e ≠ ⟨x + b, hxb⟩ := fun he ↦ by
    have he' : (e : N) + b = x + b := by rw [add_comm]; exact congr_arg Subtype.val he
    exact hx (add_right_cancel he' ▸ e.property)
  have hcoeff := congr(($hd).coeff ⟨x + b, hxb⟩)
  rw [coeff_single_mul_of_forall_add_ne _ _ hne,
    coeff_single, Finsupp.single_eq_same] at hcoeff
  exact one_ne_zero (α := AddMonoidAlgebra R S) (by rw [one_def, hcoeff, single_zero])

/-- If the algebra of a submonoid `S` of an abelian group is an integrally closed domain, then
`S` is saturated inside the group it generates: the saturation of `S` meets
`AddSubgroup.closure S` exactly in `S`. -/
theorem nsmulSaturation_inf_closure_eq {G : Type*} [AddCommGroup G] (S : AddSubmonoid G)
    (R : Type*) [CommRing R] [IsDomain (AddMonoidAlgebra R S)]
    [IsIntegrallyClosed (AddMonoidAlgebra R S)] :
    S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S := by
  refine le_antisymm (fun x hx ↦ ?_) (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)
  obtain ⟨n, hn, hnx⟩ := mem_nsmulSaturation.mp hx.1
  obtain ⟨a, b, rfl⟩ := S.mem_groupClosure_iff.mp hx.2
  exact S.mem_of_nsmul_mem_of_add_mem R b.property (by simp) hn.ne' hnx

section GroupClosureLocalization

variable {G : Type*} [AddCommGroup G] (S : AddSubmonoid G) (R : Type*) [CommRing R]

/-- When `R[S]` is a domain, every coefficient-one monomial in `R[S]` is a nonzerodivisor. -/
theorem monoidHom_mrange_of_le_nonZeroDivisors [IsDomain (AddMonoidAlgebra R S)] :
    MonoidHom.mrange (of R S) ≤ nonZeroDivisors (AddMonoidAlgebra R S) := by
  rintro _ ⟨m, rfl⟩
  rw [mem_nonZeroDivisors_iff_ne_zero, of_apply]
  refine single_ne_zero.mpr fun h1 ↦ one_ne_zero (α := AddMonoidAlgebra R S) ?_
  rw [one_def, h1, single_zero]

/-- When `R[S]` is a domain, so is the group algebra `R[AddSubgroup.closure S]` of the subgroup
generated by `S`. -/
theorem isDomain_addMonoidAlgebra_groupClosure [IsDomain (AddMonoidAlgebra R S)] :
    IsDomain (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) :=
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  IsLocalization.isDomain_of_le_nonZeroDivisors _ (S.monoidHom_mrange_of_le_nonZeroDivisors R)

/-- The canonical ring homomorphism from `R[AddSubgroup.closure S]` into any fraction ring `K` of
`R[S]`, obtained by inverting all coefficient-one monomials of `R[S]` without enlarging the lattice
`AddSubgroup.closure S`. -/
noncomputable def groupClosureToFractionRing [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    AddMonoidAlgebra R (AddSubgroup.closure (S : Set G)) →+* K :=
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  IsLocalization.lift (M := MonoidHom.mrange (of R S))
    (g := algebraMap (AddMonoidAlgebra R S) K)
    fun u ↦ IsLocalization.map_units K ⟨u.1, S.monoidHom_mrange_of_le_nonZeroDivisors R u.2⟩

/-- Composing `S.groupClosureToFractionRing R K` with the inclusion of `R[S]` into
`R[AddSubgroup.closure S]` recovers `algebraMap R[S] K`. -/
@[simp]
theorem groupClosureToFractionRing_comp_mapDomainRingHom [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    (S.groupClosureToFractionRing R K).comp (mapDomainRingHom R S.toGroupClosure) =
      algebraMap (AddMonoidAlgebra R S) K := by
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  exact IsLocalization.lift_comp _

/-- On elements pushed forward from `R[S]`, `S.groupClosureToFractionRing R K` agrees with
`algebraMap R[S] K`. -/
@[simp]
theorem groupClosureToFractionRing_mapDomain_toGroupClosure [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] (x : AddMonoidAlgebra R S) :
    S.groupClosureToFractionRing R K (mapDomain S.toGroupClosure x) =
      algebraMap (AddMonoidAlgebra R S) K x :=
  RingHom.congr_fun (S.groupClosureToFractionRing_comp_mapDomainRingHom R K) x

/-- On monomials from `S`, `S.groupClosureToFractionRing R K` agrees with `algebraMap R[S] K`. -/
@[simp]
theorem groupClosureToFractionRing_single_toGroupClosure [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] (a : S) (r : R) :
    S.groupClosureToFractionRing R K (single (S.toGroupClosure a) r) =
      algebraMap (AddMonoidAlgebra R S) K (single a r) := by
  rw [← mapDomain_single, S.groupClosureToFractionRing_mapDomain_toGroupClosure R K]

/-- Any fraction ring `K` of `R[S]` is also a fraction ring of `R[AddSubgroup.closure S]` along
`S.groupClosureToFractionRing R K`. -/
theorem isFractionRing_addMonoidAlgebra_groupClosure [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    letI := (S.groupClosureToFractionRing R K).toAlgebra
    IsFractionRing (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K := by
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  let := (S.groupClosureToFractionRing R K).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  have : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K :=
    IsScalarTower.of_algebraMap_eq' (S.groupClosureToFractionRing_comp_mapDomainRingHom R K).symm
  exact IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
    (MonoidHom.mrange (of R S)) (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K

/-- The canonical homomorphism `R[AddSubgroup.closure S] →+* K` into a fraction ring of `R[S]` is
injective. -/
theorem groupClosureToFractionRing_injective [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    Function.Injective (S.groupClosureToFractionRing R K) := by
  let := (S.groupClosureToFractionRing R K).toAlgebra
  have := S.isDomain_addMonoidAlgebra_groupClosure R
  have := S.isFractionRing_addMonoidAlgebra_groupClosure R K
  exact IsFractionRing.injective (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K

/-- The canonical inclusion of `S.nsmulSaturation ⊓ AddSubgroup.closure S` into
`AddSubgroup.closure S`. -/
def saturationInfClosureToGroupClosure :
    ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid) →+
      ↥(AddSubgroup.closure (S : Set G)) :=
  (S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid).subtype.codRestrict
    (AddSubgroup.closure (S : Set G)) fun x ↦ x.2.2

/-- The inclusion into `AddSubgroup.closure S` preserves the underlying element of `G`. -/
@[simp]
theorem coe_saturationInfClosureToGroupClosure_apply
    (x : ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) :
    (S.saturationInfClosureToGroupClosure x : G) = x.1 :=
  (rfl)

/-- The inclusion `S.saturationInfClosureToGroupClosure` is injective. -/
theorem saturationInfClosureToGroupClosure_injective :
    Function.Injective S.saturationInfClosureToGroupClosure := fun _ _ h ↦
  Subtype.ext (by simpa using congrArg Subtype.val h)

/-- Restricting `S.saturationInfClosureToGroupClosure` to `S` gives `S.toGroupClosure`. -/
@[simp]
theorem saturationInfClosureToGroupClosure_comp_inclusion :
    S.saturationInfClosureToGroupClosure.comp
        (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)) =
      S.toGroupClosure := by
  ext x
  simp

/-- Inside `AddSubgroup.closure S`, the image of `S.saturationInfClosureToGroupClosure` is the
saturation of the image of `S.toGroupClosure`. -/
@[simp]
theorem mrange_saturationInfClosureToGroupClosure :
    AddMonoidHom.mrange S.saturationInfClosureToGroupClosure =
      (AddMonoidHom.mrange S.toGroupClosure).nsmulSaturation := by
  refine AddSubmonoid.ext fun ⟨x, hx⟩ ↦ ?_
  rw [S.mrange_toGroupClosure, S.nsmulSaturation_comap, mem_comap, AddMonoidHom.mem_mrange]
  refine ⟨fun ⟨y, hy⟩ ↦ ?_, fun hxS ↦ ⟨⟨x, hxS, hx⟩, rfl⟩⟩
  have hyx : y.1 = x := by simpa using congrArg Subtype.val hy
  exact hyx ▸ y.2.1

/-- The canonical ring homomorphism from `R[S.nsmulSaturation ⊓ AddSubgroup.closure S]` into any
fraction ring `K` of `R[S]`. -/
noncomputable def saturationInfClosureToFractionRing [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid) →+*
      K :=
  (S.groupClosureToFractionRing R K).comp
    (mapDomainRingHom R S.saturationInfClosureToGroupClosure)

/-- `S.saturationInfClosureToFractionRing R K` factors through `R[AddSubgroup.closure S]`. -/
@[simp]
theorem saturationInfClosureToFractionRing_apply [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K]
    (x : AddMonoidAlgebra R
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) :
    S.saturationInfClosureToFractionRing R K x =
      S.groupClosureToFractionRing R K (mapDomain S.saturationInfClosureToGroupClosure x) :=
  (rfl)

/-- Restricting `S.saturationInfClosureToFractionRing R K` to `R[S]` recovers
`algebraMap R[S] K`. -/
@[simp]
theorem saturationInfClosureToFractionRing_comp_inclusion [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    (S.saturationInfClosureToFractionRing R K).comp
        (mapDomainRingHom R (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))) =
      algebraMap (AddMonoidAlgebra R S) K := by
  rw [saturationInfClosureToFractionRing, RingHom.comp_assoc, ← mapDomainRingHom_comp,
    S.saturationInfClosureToGroupClosure_comp_inclusion,
    S.groupClosureToFractionRing_comp_mapDomainRingHom]

/-- The canonical homomorphism `R[S.nsmulSaturation ⊓ AddSubgroup.closure S] →+* K` is injective. -/
theorem saturationInfClosureToFractionRing_injective [IsDomain (AddMonoidAlgebra R S)]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    Function.Injective (S.saturationInfClosureToFractionRing R K) :=
  (S.groupClosureToFractionRing_injective R K).comp
    (mapDomain_injective S.saturationInfClosureToGroupClosure_injective)

end GroupClosureLocalization

section TorsionFreeGroup

open AddMonoidAlgebra

variable {G : Type*} [AddCommGroup G] [Module.IsTorsionFree ℤ G] (S : AddSubmonoid G)
  (R : Type*) [CommRing R]

/-- **The integral closure of a semigroup algebra in the algebra of a torsion-free abelian group.**
For a submonoid `S` of a torsion-free abelian group `G` and a reduced ring `R`, the algebra
`R[sat S]` of the saturation of `S` is the integral closure of `R[S]` in `R[G]`. -/
theorem isIntegralClosure_nsmulSaturation [IsReduced R] :
    letI := (mapDomainRingHom R S.subtype).toAlgebra
    letI := (mapDomainRingHom R S.nsmulSaturation.subtype).toAlgebra
    IsIntegralClosure (AddMonoidAlgebra R S.nsmulSaturation) (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R G) := by
  let := (mapDomainRingHom R S.subtype).toAlgebra
  let := (mapDomainRingHom R S.nsmulSaturation.subtype).toAlgebra
  refine ⟨mapDomain_injective S.nsmulSaturation.subtype_injective, fun {x} ↦ ?_⟩
  rw [IsIntegral, RingHom.algebraMap_toAlgebra, isIntegralElem_iff_forall_mem_support,
    mrange_subtype, RingHom.algebraMap_toAlgebra]
  simp only [mapDomainRingHom_apply, ← Set.mem_range,
    mem_range_mapDomain_iff S.nsmulSaturation.subtype_injective]
  simp

/-- **Normality relative to the ambient group algebra.** For a submonoid `S` of a torsion-free
abelian group `G` and a nontrivial reduced ring `R`, the algebra `R[S]` is integrally closed in
`R[G]` exactly when `S` is saturated in `G`. -/
theorem isIntegrallyClosedIn_iff_nsmulSaturated [Nontrivial R] [IsReduced R] :
    letI := (mapDomainRingHom R S.subtype).toAlgebra
    IsIntegrallyClosedIn (AddMonoidAlgebra R S) (AddMonoidAlgebra R G) ↔ S.NSMulSaturated := by
  let := (mapDomainRingHom R S.subtype).toAlgebra
  have hint (x : AddMonoidAlgebra R G) :
      IsIntegral (AddMonoidAlgebra R S) x ↔ ∀ g ∈ x.coeff.support, g ∈ S.nsmulSaturation := by
    rw [IsIntegral, RingHom.algebraMap_toAlgebra, isIntegralElem_iff_forall_mem_support,
      mrange_subtype]
  have hrange (x : AddMonoidAlgebra R G) :
      (∃ y, algebraMap (AddMonoidAlgebra R S) (AddMonoidAlgebra R G) y = x) ↔
        ∀ g ∈ x.coeff.support, g ∈ S := by
    simp only [RingHom.algebraMap_toAlgebra, mapDomainRingHom_apply, ← Set.mem_range,
      mem_range_mapDomain_iff S.subtype_injective]
    simp
  rw [isIntegrallyClosedIn_iff]
  refine ⟨fun ⟨_, h⟩ n x hnx ↦ or_iff_not_imp_left.mpr fun hn ↦ ?_, fun hS ↦
    ⟨mapDomain_injective S.subtype_injective, fun {x} hx ↦ ?_⟩⟩
  · refine (hrange (single x 1)).mp (h ((hint _).mpr fun g hg ↦ ?_)) x (by simp)
    obtain rfl : g = x := by simpa using hg
    exact mem_nsmulSaturation.mpr ⟨n, Nat.pos_of_ne_zero hn, hnx⟩
  · refine (hrange x).mpr fun g hg ↦ ?_
    rw [← nsmulSaturation_eq_self hS]
    exact (hint x).mp hx g hg

/-- **The integral closure of `R[S]` in `R[AddSubgroup.closure S]`.** Over a reduced ring `R`,
`R[S.nsmulSaturation ⊓ AddSubgroup.closure S]` is the integral closure of `R[S]` in the group
algebra of the subgroup generated by `S`. -/
theorem isIntegralClosure_nsmulSaturation_inf_closure_groupClosure [IsReduced R] :
    letI := (mapDomainRingHom R S.toGroupClosure).toAlgebra
    letI := (mapDomainRingHom R S.saturationInfClosureToGroupClosure).toAlgebra
    IsIntegralClosure
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) := by
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  let := (mapDomainRingHom R S.saturationInfClosureToGroupClosure).toAlgebra
  have : Module.IsTorsionFree ℤ (AddSubgroup.closure (S : Set G)) :=
    (AddSubgroup.closure (S : Set G)).subtype_injective.moduleIsTorsionFree
      (AddSubgroup.closure (S : Set G)).subtype fun _ _ ↦ rfl
  refine ⟨mapDomain_injective S.saturationInfClosureToGroupClosure_injective, fun {x} ↦ ?_⟩
  rw [IsIntegral, RingHom.algebraMap_toAlgebra, isIntegralElem_iff_forall_mem_support,
    ← S.mrange_saturationInfClosureToGroupClosure, RingHom.algebraMap_toAlgebra]
  simp only [mapDomainRingHom_apply, ← Set.mem_range,
    mem_range_mapDomain_iff S.saturationInfClosureToGroupClosure_injective,
    AddMonoidHom.mem_mrange]

/-- **The integral closure of a semigroup algebra in its fraction field.** For a submonoid `S` of a
torsion-free abelian group `G` and an integrally closed domain `R`, the algebra
`R[S.nsmulSaturation ⊓ AddSubgroup.closure S]` is the integral closure of `R[S]` in any fraction
ring `K` of `R[S]`. -/
theorem isIntegralClosure_nsmulSaturation_inf_closure [IsDomain R] [IsIntegrallyClosed R]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    letI := (S.saturationInfClosureToFractionRing R K).toAlgebra
    IsIntegralClosure
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      (AddMonoidAlgebra R S) K := by
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  let := (mapDomainRingHom R S.saturationInfClosureToGroupClosure).toAlgebra
  let := (S.groupClosureToFractionRing R K).toAlgebra
  let := (S.saturationInfClosureToFractionRing R K).toAlgebra
  have : Module.IsTorsionFree ℤ (AddSubgroup.closure (S : Set G)) :=
    (AddSubgroup.closure (S : Set G)).subtype_injective.moduleIsTorsionFree
      (AddSubgroup.closure (S : Set G)).subtype fun _ _ ↦ rfl
  have : IsFractionRing (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K :=
    S.isFractionRing_addMonoidAlgebra_groupClosure R K
  have : IsIntegrallyClosedIn (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K :=
    (isIntegrallyClosed_iff_isIntegrallyClosedIn K).mp inferInstance
  have : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K :=
    IsScalarTower.of_algebraMap_eq' (S.groupClosureToFractionRing_comp_mapDomainRingHom R K).symm
  have : IsScalarTower
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K :=
    IsScalarTower.of_algebraMap_eq' rfl
  have := S.isIntegralClosure_nsmulSaturation_inf_closure_groupClosure R
  exact IsIntegralClosure.of_isIntegralClosure_of_isIntegrallyClosedIn
    (AddMonoidAlgebra R S)
    (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
    (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K

/-- The `(AddMonoidAlgebra R S)`-algebra isomorphism between
`R[S.nsmulSaturation ⊓ AddSubgroup.closure S]` and the integral closure of `R[S]` in its fraction
ring `K`. -/
noncomputable def integralClosureEquiv [IsDomain R] [IsIntegrallyClosed R]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    letI := (mapDomainRingHom R
      (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
    AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)
      ≃ₐ[AddMonoidAlgebra R S] integralClosure (AddMonoidAlgebra R S) K := by
  let := (mapDomainRingHom R
    (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
  let := (S.saturationInfClosureToFractionRing R K).toAlgebra
  have : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      K :=
    IsScalarTower.of_algebraMap_eq' (S.saturationInfClosureToFractionRing_comp_inclusion R K).symm
  have := S.isIntegralClosure_nsmulSaturation_inf_closure R K
  exact IsIntegralClosure.equiv (AddMonoidAlgebra R S)
    (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
    K (integralClosure (AddMonoidAlgebra R S) K)

/-- In the ambient fraction ring `K`, `S.integralClosureEquiv R K` acts by
`S.saturationInfClosureToFractionRing R K`. -/
@[simp]
theorem coe_integralClosureEquiv_apply [IsDomain R] [IsIntegrallyClosed R]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K]
    (x : AddMonoidAlgebra R
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) :
    letI := (mapDomainRingHom R
      (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
    ((S.integralClosureEquiv R K x) : K) = S.saturationInfClosureToFractionRing R K x := by
  let := (mapDomainRingHom R
    (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
  let := (S.saturationInfClosureToFractionRing R K).toAlgebra
  have : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      K :=
    IsScalarTower.of_algebraMap_eq' (S.saturationInfClosureToFractionRing_comp_inclusion R K).symm
  have := S.isIntegralClosure_nsmulSaturation_inf_closure R K
  exact IsIntegralClosure.algebraMap_equiv (AddMonoidAlgebra R S)
    (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
    K (integralClosure (AddMonoidAlgebra R S) K) x

/-- **Finite normalization of affine semigroup algebras.** Over an integrally closed domain `R`,
the integral closure of `R[S]` in its fraction ring `K` is a finitely generated `R[S]`-module
whenever `S` is a finitely generated submonoid of a torsion-free abelian group. -/
theorem moduleFinite_integralClosure [IsDomain R] [IsIntegrallyClosed R] {S : AddSubmonoid G}
    (hS : S.FG) (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    Module.Finite (AddMonoidAlgebra R S) (integralClosure (AddMonoidAlgebra R S) K) := by
  let := (mapDomainRingHom R
    (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
  have : Module.Finite (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R
        ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) :=
    finite_mapDomainRingHom_inclusion_nsmulSaturation_inf_closure hS
  exact Module.Finite.equiv (S.integralClosureEquiv R K).toLinearEquiv

/-- **Normality iff saturation.** For a submonoid `S` of a torsion-free abelian group `G` and an
integral domain `R`, the semigroup algebra `R[S]` is integrally closed if and only if `R` is
integrally closed and `S` is saturated inside the subgroup `AddSubgroup.closure S` it generates. -/
theorem isIntegrallyClosed_addMonoidAlgebra_iff [IsDomain R] :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔
      IsIntegrallyClosed R ∧
        S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S := by
  refine ⟨fun _ ↦ ⟨isIntegrallyClosed_coeffRing R S, S.nsmulSaturation_inf_closure_eq R⟩,
    fun ⟨_, hS⟩ ↦ ?_⟩
  let K := FractionRing (AddMonoidAlgebra R S)
  let := (S.saturationInfClosureToFractionRing R K).toAlgebra
  have := S.isIntegralClosure_nsmulSaturation_inf_closure R K
  refine (isIntegrallyClosed_iff K).mpr fun {z} hz ↦ ?_
  obtain ⟨y, rfl⟩ := (IsIntegralClosure.isIntegral_iff (A := AddMonoidAlgebra R
    ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))).mp hz
  have hsurj : Function.Surjective
      (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)) :=
    fun t ↦ ⟨⟨t.1, hS.le t.2⟩, rfl⟩
  obtain ⟨x, rfl⟩ := mapDomain_surjective (R := R) hsurj y
  exact ⟨x, (RingHom.congr_fun (S.saturationInfClosureToFractionRing_comp_inclusion R K) x).symm⟩

/-- Over an integrally closed domain `R`, a semigroup algebra `R[S]` is integrally closed if and
only if `S` is saturated inside `AddSubgroup.closure S`. -/
theorem isIntegrallyClosed_addMonoidAlgebra_iff_of_isIntegrallyClosed
    [IsDomain R] [IsIntegrallyClosed R] :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔
      S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S := by
  simp [S.isIntegrallyClosed_addMonoidAlgebra_iff R, ‹IsIntegrallyClosed R›]

/-- If `S` is saturated in a torsion-free abelian group `G` and `R` is an integrally closed domain,
then `R[S]` is integrally closed. -/
theorem isIntegrallyClosed_addMonoidAlgebra_of_nsmulSaturated
    [IsDomain R] [IsIntegrallyClosed R] {S : AddSubmonoid G} (hS : S.NSMulSaturated) :
    IsIntegrallyClosed (AddMonoidAlgebra R S) :=
  (S.isIntegrallyClosed_addMonoidAlgebra_iff_of_isIntegrallyClosed R).mpr <| by
    rw [nsmulSaturation_eq_self hS, inf_eq_left]
    exact AddSubgroup.subset_closure

/-- When `S` generates the full ambient torsion-free abelian group `G`, `R[S]` is integrally closed
if and only if `R` is integrally closed and `S` is saturated in `G`. -/
theorem isIntegrallyClosed_addMonoidAlgebra_iff_nsmulSaturated [IsDomain R]
    {S : AddSubmonoid G} (hS : AddSubgroup.closure (S : Set G) = ⊤) :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔ IsIntegrallyClosed R ∧ S.NSMulSaturated := by
  rw [S.isIntegrallyClosed_addMonoidAlgebra_iff R, hS]
  simp [nsmulSaturation_eq_self_iff]

end TorsionFreeGroup

end AddSubmonoid
