/-!
# Integral monomials and saturation of semigroups

Let `f : M →+ N` be a homomorphism of commutative monoids, inducing `R[M] → R[N]`. A monomial
`single x c` of `R[N]` is integral over `R[M]` as soon as some positive multiple of `x` lies in the
image of `f`, that is, when `x` lies in the positive-multiple saturation of
`AddMonoidHom.mrange f`. When `c` is not nilpotent and `N` is cancellative, this is also
necessary. For the inclusion of a submonoid `S ≤ N` it follows that `R[sat S]` is integral over
`R[S]`.

When `N = G` is a free abelian group and `R` is reduced, the integral closure of `R[M]` in `R[G]` is
graded (`AddMonoidAlgebra.isIntegralElem_single_coeff`), so it consists exactly of the elements
supported on the saturation of the image of `f`. For a submonoid `S ≤ G` this identifies `R[sat S]`
with the integral closure of `R[S]` in `R[G]`, and shows, for `R` nontrivial, that `R[S]` is
integrally closed in `R[G]` exactly when `S` is saturated in `G`. Taking for `G` the group
generated by `S` when it is free, whose algebra is the localization of `R[S]` at its monomials
(`AddSubmonoid.isLocalization_addMonoidAlgebra_groupClosure`), this computes the integral closure
of `R[S]` in that localization.

Conversely, if `R[S]` is an integrally closed domain then `S` is saturated inside the group it
generates: an element `x` of that group with `n • x ∈ S` for some `n ≠ 0` already lies in `S`.
This is the implication from normality of `R[S]` to saturation of `S`, and it is stated without
reference to a fraction field, through `IsIntegrallyClosed.pow_dvd_pow_iff`.

## Main results

* `AddMonoidAlgebra.isIntegralElem_single_iff`: for `c` not nilpotent, `single x c` is integral
  over `R[M]` iff `x ∈ (AddMonoidHom.mrange f).nsmulSaturation`.
* `AddMonoidAlgebra.isIntegral_mapDomainRingHom_inclusion_nsmulSaturation`: `R[sat S]` is
  integral over `R[S]`.
* `AddMonoidAlgebra.isIntegralElem_iff_forall_mem_support`: for a free abelian group `G` and a
  reduced ring `R`, an element of `R[G]` is integral over `R[M]` iff its support lies in the
  saturation of the image of `f`.
* `AddSubmonoid.isIntegralClosure_nsmulSaturation`: `R[sat S]` is the integral closure of `R[S]`
  in `R[G]`.
* `AddSubmonoid.isIntegrallyClosedIn_iff_nsmulSaturated`: for a nontrivial reduced ring `R`,
  `R[S]` is integrally closed in `R[G]` iff `S` is saturated in `G`.
* `AddSubmonoid.mem_of_nsmul_mem_of_add_mem`: if `R[S]` is an integrally closed domain,
  `b ∈ S`, `x + b ∈ S` and `n • x ∈ S` with `n ≠ 0`, then `x ∈ S`.
* `AddSubmonoid.nsmulSaturation_inf_closure_eq`: for a submonoid `S` of an abelian group with
  `R[S]` an integrally closed domain, the saturation of `S` meets the group generated by `S`
  exactly in `S`.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 4, normality of affine
  monoid algebras.
* W. Bruns and J. Herzog, *Cohen–Macaulay Rings*, §6.1, normal semigroup rings.
-/

public section

open Polynomial

namespace AddMonoidAlgebra

variable {R M N : Type*} [CommRing R] [AddCommMonoid M] [AddCommMonoid N]

/-- A monomial whose exponent has a positive multiple in the image of `f` is integral over
`R[M]`: it is a root of `X ^ n - C (single m (c ^ n))` when `n • x = f m`. -/
theorem isIntegralElem_single (f : M →+ N) {x : N}
    (hx : x ∈ (AddMonoidHom.mrange f).nsmulSaturation) (c : R) :
    (mapDomainRingHom R f).IsIntegralElem (single x c) := by
  obtain ⟨n, hn, m, hm⟩ := AddSubmonoid.mem_nsmulSaturation.mp hx
  refine ⟨X ^ n - C (single m (c ^ n)), monic_X_pow_sub_C _ hn.ne', ?_⟩
  simp [single_pow, hm]

/-- A monomial `single x c` of `R[N]` with non-nilpotent coefficient is integral over `R[M]`
exactly when some positive multiple of `x` lies in the image of `f`. -/
theorem isIntegralElem_single_iff [IsRightCancelAdd N] (f : M →+ N) {x : N} {c : R}
    (hc : ¬IsNilpotent c) :
    (mapDomainRingHom R f).IsIntegralElem (single x c) ↔
      x ∈ (AddMonoidHom.mrange f).nsmulSaturation := by
  refine ⟨fun ⟨p, hp, hpx⟩ ↦ ?_, (isIntegralElem_single f · c)⟩
  by_contra hx
  -- The coefficient of the monic equation at `p.natDegree • x` comes only from its leading
  -- term: every lower term `f (p.coeff i) * single (i • x) (c ^ i)` would need an exponent
  -- `(p.natDegree - i) • x` in the image of `f`.
  have hterm (i : ℕ) (hi : i < p.natDegree) :
      (mapDomainRingHom R f (p.coeff i) * single x c ^ i).coeff (p.natDegree • x) = 0 := by
    have hsplit : p.natDegree • x = (p.natDegree - i) • x + i • x := by
      rw [← add_nsmul, Nat.sub_add_cancel hi.le]
    rw [single_pow, hsplit, coeff_mul_single_eq_coeff_mul ((p.natDegree - i) • x)
      (fun _ _ ↦ add_left_inj _), mapDomainRingHom_apply, coeff_mapDomain,
      Finsupp.mapDomain_of_notMem_range, zero_mul]
    rintro ⟨m, hm⟩
    exact hx (AddSubmonoid.mem_nsmulSaturation.mpr ⟨p.natDegree - i, by lia, m, hm⟩)
  have hcoeff := congr(($hpx).coeff (p.natDegree • x))
  rw [eval₂_eq_sum_range, coeff_sum, Finsupp.finsetSum_apply, Finset.sum_range_succ,
    Finset.sum_eq_zero fun i hi ↦ hterm i (Finset.mem_range.mp hi), hp.coeff_natDegree] at hcoeff
  exact hc ⟨p.natDegree, by simpa [single_pow] using hcoeff⟩

/-- The algebra of the saturation of `S` is integral over the algebra of `S`. -/
theorem isIntegral_mapDomainRingHom_inclusion_nsmulSaturation (S : AddSubmonoid N) :
    (mapDomainRingHom R (AddSubmonoid.inclusion S.le_nsmulSaturation)).IsIntegral := by
  intro y
  induction y using induction_linear with
  | zero => exact RingHom.isIntegralElem_zero _
  | add y z hy hz => exact hy.add _ hz
  | single x r =>
    obtain ⟨n, hn, hnx⟩ := AddSubmonoid.mem_nsmulSaturation.mp x.property
    exact isIntegralElem_single _ (AddSubmonoid.mem_nsmulSaturation.mpr
      ⟨n, hn, ⟨n • (x : N), hnx⟩, Subtype.ext (by simp)⟩) r

section FreeGroup

variable {G : Type*} [AddCommGroup G] [Module.Free ℤ G]

/-- **The integral closure of a monoid algebra in the algebra of a free abelian group.** Over a
reduced ring `R`, an element of `R[G]` is integral over `R[M]` along `f : M →+ G` exactly when
its support lies in the saturation of the image of `f`. -/
theorem isIntegralElem_iff_forall_mem_support [IsReduced R] (f : M →+ G)
    {x : AddMonoidAlgebra R G} :
    (mapDomainRingHom R f).IsIntegralElem x ↔
      ∀ g ∈ x.coeff.support, g ∈ (AddMonoidHom.mrange f).nsmulSaturation := by
  refine ⟨fun hx g hg ↦ ?_, fun h ↦ ?_⟩
  · refine (isIntegralElem_single_iff f ?_).mp (isIntegralElem_single_coeff f hx g)
    exact fun hnil ↦ Finsupp.mem_support_iff.mp hg hnil.eq_zero
  · rw [← sum_coeff_single x, Finsupp.sum]
    exact Finset.sum_induction _ _ (fun _ _ ha hb ↦ ha.add _ hb) (RingHom.isIntegralElem_zero _)
      fun g hg ↦ isIntegralElem_single f (h g hg) _

end FreeGroup

end AddMonoidAlgebra

namespace AddSubmonoid

open AddMonoidAlgebra

variable {N : Type*} [AddCommMonoid N] [IsRightCancelAdd N]

/-- If the algebra of `S` is an integrally closed domain, then `S` is saturated relative to its
differences: when `b ∈ S`, `x + b ∈ S` and `n • x ∈ S` for some `n ≠ 0`, already `x ∈ S`. -/
theorem mem_of_nsmul_mem_of_add_mem (S : AddSubmonoid N) (R : Type*) [CommRing R]
    [IsDomain (AddMonoidAlgebra R S)] [IsIntegrallyClosed (AddMonoidAlgebra R S)]
    {x b : N} (hb : b ∈ S) (hxb : x + b ∈ S) {n : ℕ} (hn : n ≠ 0) (hnx : n • x ∈ S) :
    x ∈ S := by
  have hpow : single (⟨b, hb⟩ : S) (1 : R) ^ n ∣ single (⟨x + b, hxb⟩ : S) (1 : R) ^ n :=
    ⟨single ⟨n • x, hnx⟩ 1, by
      simp only [single_pow, one_pow, single_mul_single, mul_one]
      congr 1
      exact Subtype.ext (by simp [add_comm])⟩
  obtain ⟨d, hd⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff hn).mp hpow
  by_contra hx
  have hne (e : S) : ⟨b, hb⟩ + e ≠ ⟨x + b, hxb⟩ := fun he ↦ by
    have he' : (e : N) + b = x + b := by rw [add_comm]; exact congr_arg Subtype.val he
    exact hx (add_right_cancel he' ▸ e.property)
  have hcoeff := congr(($hd).coeff ⟨x + b, hxb⟩)
  rw [coeff_single_mul_of_forall_add_ne _ _ hne,
    coeff_single, Finsupp.single_eq_same] at hcoeff
  exact one_ne_zero (α := AddMonoidAlgebra R S) (by rw [one_def, hcoeff, single_zero])

/-- If the algebra of a submonoid `S` of an abelian group is an integrally closed domain, then
`S` is saturated inside the group it generates: the saturation of `S` meets
`AddSubgroup.closure S` exactly in `S`. -/
theorem nsmulSaturation_inf_closure_eq {G : Type*} [AddCommGroup G] (S : AddSubmonoid G)
    (R : Type*) [CommRing R] [IsDomain (AddMonoidAlgebra R S)]
    [IsIntegrallyClosed (AddMonoidAlgebra R S)] :
    S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S := by
  refine le_antisymm (fun x hx ↦ ?_) (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)
  obtain ⟨n, hn, hnx⟩ := mem_nsmulSaturation.mp hx.1
  obtain ⟨a, b, rfl⟩ := S.mem_groupClosure_iff.mp hx.2
  exact S.mem_of_nsmul_mem_of_add_mem R b.property (by simp) hn.ne' hnx

section FreeGroup

open AddMonoidAlgebra

variable {G : Type*} [AddCommGroup G] [Module.Free ℤ G] (S : AddSubmonoid G)
  (R : Type*) [CommRing R]

/-- **The integral closure of a semigroup algebra in the algebra of a free abelian group.** For a
submonoid `S` of a free abelian group `G` and a reduced ring `R`, the algebra `R[sat S]` of the
saturation of `S` is the integral closure of `R[S]` in `R[G]`. -/
theorem isIntegralClosure_nsmulSaturation [IsReduced R] :
    letI := (mapDomainRingHom R S.subtype).toAlgebra
    letI := (mapDomainRingHom R S.nsmulSaturation.subtype).toAlgebra
    IsIntegralClosure (AddMonoidAlgebra R S.nsmulSaturation) (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R G) := by
  let := (mapDomainRingHom R S.subtype).toAlgebra
  let := (mapDomainRingHom R S.nsmulSaturation.subtype).toAlgebra
  refine ⟨mapDomain_injective S.nsmulSaturation.subtype_injective, fun {x} ↦ ?_⟩
  rw [IsIntegral, RingHom.algebraMap_toAlgebra, isIntegralElem_iff_forall_mem_support,
    mrange_subtype, RingHom.algebraMap_toAlgebra]
  simp only [mapDomainRingHom_apply, ← Set.mem_range,
    mem_range_mapDomain_iff S.nsmulSaturation.subtype_injective]
  simp

/-- **Normality relative to the ambient group algebra.** For a submonoid `S` of a free abelian
group `G` and a nontrivial reduced ring `R`, the algebra `R[S]` is integrally closed in `R[G]`
exactly when `S` is saturated in `G`. -/
theorem isIntegrallyClosedIn_iff_nsmulSaturated [Nontrivial R] [IsReduced R] :
    letI := (mapDomainRingHom R S.subtype).toAlgebra
    IsIntegrallyClosedIn (AddMonoidAlgebra R S) (AddMonoidAlgebra R G) ↔ S.NSMulSaturated := by
  let := (mapDomainRingHom R S.subtype).toAlgebra
  -- Integral elements and elements of `R[S]` are both characterized by their supports.
  have hint (x : AddMonoidAlgebra R G) :
      IsIntegral (AddMonoidAlgebra R S) x ↔ ∀ g ∈ x.coeff.support, g ∈ S.nsmulSaturation := by
    rw [IsIntegral, RingHom.algebraMap_toAlgebra, isIntegralElem_iff_forall_mem_support,
      mrange_subtype]
  have hrange (x : AddMonoidAlgebra R G) :
      (∃ y, algebraMap (AddMonoidAlgebra R S) (AddMonoidAlgebra R G) y = x) ↔
        ∀ g ∈ x.coeff.support, g ∈ S := by
    simp only [RingHom.algebraMap_toAlgebra, mapDomainRingHom_apply, ← Set.mem_range,
      mem_range_mapDomain_iff S.subtype_injective]
    simp
  rw [isIntegrallyClosedIn_iff]
  refine ⟨fun ⟨_, h⟩ n x hnx ↦ or_iff_not_imp_left.mpr fun hn ↦ ?_, fun hS ↦
    ⟨mapDomain_injective S.subtype_injective, fun {x} hx ↦ ?_⟩⟩
  · -- The monomial `single x 1` is integral, so it comes from `R[S]`.
    refine (hrange (single x 1)).mp (h ((hint _).mpr fun g hg ↦ ?_)) x (by simp)
    obtain rfl : g = x := by simpa using hg
    exact mem_nsmulSaturation.mpr ⟨n, Nat.pos_of_ne_zero hn, hnx⟩
  · refine (hrange x).mpr fun g hg ↦ ?_
    rw [← nsmulSaturation_eq_self hS]
    exact (hint x).mp hx g hg

end FreeGroup

end AddSubmonoid
