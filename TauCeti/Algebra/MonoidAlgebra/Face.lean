/-!
# Monomial ideals of semigroup faces

A face of an additive monoid is an additive submonoid `F` satisfying Mathlib's
`AddSubmonoid.AddSaturated` condition: if `a + b ∈ F`, then both summands lie in `F`.
This is distinct from saturation under positive multiples.

Restriction to a face sends a monomial outside the face to zero and retains every monomial
on the face. It is a surjective algebra homomorphism, whose kernel is the ideal generated
by the coefficient-one monomials outside the face. The quotient is canonically the monoid
algebra of the face. For nontrivial coefficients with no zero divisors, the ideal of a face `F`
with unique sums is prime. These are the coordinate-ring maps for closed face embeddings
of affine semigroup schemes; no normality or finite generation is needed.

All of these constructions commute with changing the coefficients along an arbitrary ring
homomorphism `φ : R →+* S`: restriction commutes with `AddMonoidAlgebra.mapRingHom`, the face
ideal over `R` extends to the face ideal over `S`, and the quotient equivalence is natural in `φ`.
No flatness, injectivity or surjectivity of `φ` is needed, because the face ideal has a fixed
monomial generating set; this is not an instance of kernels commuting with base change.

Multiplying all exponents by a positive integer `n`, that is, raising every monomial to its
`n`-th power while fixing the coefficients, preserves each face. On a face `F` it restricts to
the same operation on `R[F]`, and the preimage of the zero locus of the face ideal is that zero
locus again. For `n = 0` every monomial goes to `1`, and the preimage of the zero locus of a
proper face is empty.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 2.
* W. Fulton, *Introduction to Toric Varieties*, §1.2.
-/

public section

namespace AddSubmonoid

open AddMonoidAlgebra

variable {M R : Type*} [AddCommMonoid M] [CommSemiring R]

/-- The ideal generated by the monomials whose exponents lie outside `F`.
When `F` is a face, this cuts out its closed affine semigroup subscheme. -/
noncomputable def faceIdeal (F : AddSubmonoid M) (R : Type*) [CommSemiring R] :
    Ideal (AddMonoidAlgebra R M) :=
  Ideal.span (of' R M '' (F : Set M)ᶜ)

/-- The face ideal is the span of the coefficient-one monomials outside the submonoid. -/
theorem faceIdeal_def (F : AddSubmonoid M) (R : Type*) [CommSemiring R] :
    F.faceIdeal R = Ideal.span (of' R M '' (F : Set M)ᶜ) := (rfl)

/-- Restriction to a face: retain monomials on the face and kill those outside it. -/
noncomputable def faceRestriction (F : AddSubmonoid M) (hF : F.AddSaturated)
    (R : Type*) [CommSemiring R] : AddMonoidAlgebra R M →ₐ[R] AddMonoidAlgebra R F := by
  classical
  exact AddMonoidAlgebra.lift R _ M
    { toFun := fun a ↦ if h : a.toAdd ∈ F then single ⟨a.toAdd, h⟩ 1 else 0
      map_one' := by
        simp [one_def, (F.mk_eq_zero (ha := F.zero_mem)).mpr rfl]
      map_mul' := by
        intro a b
        by_cases ha : a.toAdd ∈ F <;> by_cases hb : b.toAdd ∈ F <;>
          simp [hF.add_mem_iff, ha, hb, single_mul_single] }

variable (F : AddSubmonoid M) (hF : F.AddSaturated)

/-- Face restriction is coefficient pullback along the inclusion of the face. -/
theorem faceRestriction_eq_comapDomain (p : AddMonoidAlgebra R M) :
    F.faceRestriction hF R p = comapDomain Subtype.val Subtype.val_injective p := by
  classical
  induction p using AddMonoidAlgebra.induction_on with
  | of b =>
    by_cases hb : b ∈ F
    · simpa [faceRestriction, of_apply, AddMonoidAlgebra.lift_single, hb] using
        (comapDomain_single_map Subtype.val Subtype.val_injective ⟨b, hb⟩ (1 : R)).symm
    · ext a
      simp [faceRestriction, of_apply, AddMonoidAlgebra.lift_single, hb]
  | add p q hp hq => simp [hp, hq]
  | smul r p hp =>
    ext a
    simp [hp]

/-- Restriction retains a monomial on the face. -/
@[simp]
theorem faceRestriction_single_mem (a : F) (r : R) :
    F.faceRestriction hF R (single (a : M) r) = single a r := by
  rw [faceRestriction_eq_comapDomain, comapDomain_single_map]

/-- Restriction kills a monomial outside the face. -/
@[simp]
theorem faceRestriction_single_of_notMem {a : M} (ha : a ∉ F) (r : R) :
    F.faceRestriction hF R (single a r) = 0 := by
  rw [faceRestriction_eq_comapDomain]
  ext b
  have hab : a ≠ (b : M) := fun h ↦ ha (h ▸ b.property)
  simp [hab]

/-- The coefficients of restriction are the original coefficients on the face. -/
@[simp]
theorem coeff_faceRestriction (p : AddMonoidAlgebra R M) (a : F) :
    (F.faceRestriction hF R p).coeff a = p.coeff (a : M) := by
  simp [faceRestriction_eq_comapDomain]

/-- Extending face monomials to the ambient monoid is a section of restriction. -/
@[simp]
theorem faceRestriction_mapDomain (p : AddMonoidAlgebra R F) :
    F.faceRestriction hF R (mapDomain Subtype.val p) = p := by
  ext a
  simp

/-- Face restriction is surjective, even over a coefficient semiring. -/
theorem faceRestriction_surjective : Function.Surjective (F.faceRestriction hF R) :=
  fun p ↦ ⟨mapDomainAlgHom R R F.subtype p, F.faceRestriction_mapDomain hF p⟩

include hF in
/-- Membership in the face ideal means that every coefficient on the face vanishes. -/
theorem mem_faceIdeal_iff (p : AddMonoidAlgebra R M) :
    p ∈ F.faceIdeal R ↔ ∀ a : F, p.coeff (a : M) = 0 := by
  rw [faceIdeal_def, mem_ideal_span_of'_image_iff fun d m (hm : m ∉ F) h ↦ hm (hF h).2]
  simp

/-- The monomial face ideal is exactly the kernel of restriction. -/
theorem ker_faceRestriction : RingHom.ker (F.faceRestriction hF R) = F.faceIdeal R := by
  ext p
  rw [F.mem_faceIdeal_iff hF, RingHom.mem_ker, ← coeff_inj]
  simp [Finsupp.ext_iff]

include hF in
/-- A monomial belongs to the face ideal exactly when its coefficient is zero or its
exponent is outside the face. -/
@[simp]
theorem single_mem_faceIdeal_iff (a : M) (r : R) :
    single a r ∈ F.faceIdeal R ↔ r = 0 ∨ a ∉ F := by
  classical
  rw [F.mem_faceIdeal_iff hF]
  by_cases ha : a ∈ F
  · constructor
    · intro h
      exact Or.inl (by simpa using h ⟨a, ha⟩)
    · rintro (rfl | h)
      · simp
      · exact (h ha).elim
  · have hab : ∀ b : F, a ≠ (b : M) := fun b h ↦ ha (h ▸ b.property)
    simp [ha, hab]

/-- Inclusion of faces reverses inclusion of their monomial ideals. -/
theorem faceIdeal_le_faceIdeal_iff [Nontrivial R] (G : AddSubmonoid M)
    (hG : G.AddSaturated) : F.faceIdeal R ≤ G.faceIdeal R ↔ G ≤ F := by
  constructor
  · intro h a ha
    by_contra hnot
    have hm : single a (1 : R) ∈ F.faceIdeal R := Ideal.subset_span ⟨a, hnot, of'_apply a⟩
    simpa [ha] using (G.single_mem_faceIdeal_iff hG a 1).mp (h hm)
  · intro h
    apply Ideal.span_le.mpr
    rintro _ ⟨a, ha, rfl⟩
    exact Ideal.subset_span ⟨a, fun hmem ↦ ha (h hmem), rfl⟩

section CoefficientChange

variable {S : Type*} [CommSemiring S] (φ : R →+* S)

/-- Restricting to a face commutes with changing the coefficients. -/
@[simp]
theorem faceRestriction_mapRingHom (p : AddMonoidAlgebra R M) :
    F.faceRestriction hF S (mapRingHom M φ p) = mapRingHom F φ (F.faceRestriction hF R p) := by
  ext a
  simp

/-- Restricting to a face and changing the coefficients, in either order, give the same ring
homomorphism. -/
theorem faceRestriction_comp_mapRingHom :
    (F.faceRestriction hF S : AddMonoidAlgebra S M →+* AddMonoidAlgebra S F).comp
        (mapRingHom M φ) =
      (mapRingHom F φ).comp (F.faceRestriction hF R) :=
  RingHom.ext (F.faceRestriction_mapRingHom hF φ)

/-- Changing the coefficients extends the monomial ideal of a submonoid over `R` to the monomial
ideal of the same submonoid over `S`. -/
@[simp]
theorem faceIdeal_map : (F.faceIdeal R).map (mapRingHom M φ) = F.faceIdeal S :=
  map_mapRingHom_ideal_span_of'_image φ _

/-- Changing the coefficients maps the monomial ideal of a submonoid into the monomial ideal
over the new coefficients. -/
theorem faceIdeal_le_comap_mapRingHom :
    F.faceIdeal R ≤ (F.faceIdeal S).comap (mapRingHom M φ) :=
  Ideal.map_le_iff_le_comap.mp (F.faceIdeal_map φ).le

end CoefficientChange

section CommRing

variable {S : Type*} [CommRing S]

/-- The coordinate ring of the closed face is the monoid algebra of that face. -/
noncomputable def faceQuotientEquiv :
    (AddMonoidAlgebra S M ⧸ F.faceIdeal S) ≃ₐ[S] AddMonoidAlgebra S F :=
  (Ideal.quotientEquivAlgOfEq S (F.ker_faceRestriction hF).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (F.faceRestriction_surjective hF))

/-- The face quotient equivalence is induced by restriction. -/
@[simp]
theorem faceQuotientEquiv_mk (p : AddMonoidAlgebra S M) :
    F.faceQuotientEquiv hF (Ideal.Quotient.mk (F.faceIdeal S) p) =
      F.faceRestriction hF S p := by
  simp [faceQuotientEquiv, Ideal.quotientEquivAlgOfEq_mk]

/-- The inverse quotient equivalence extends a polynomial on the face and takes its class. -/
@[simp]
theorem faceQuotientEquiv_symm_apply (p : AddMonoidAlgebra S F) :
    (F.faceQuotientEquiv hF).symm p =
      Ideal.Quotient.mk (F.faceIdeal S) (mapDomain Subtype.val p) := by
  apply (F.faceQuotientEquiv hF).injective
  simpa only [AlgEquiv.apply_symm_apply, faceQuotientEquiv_mk] using
    (F.faceRestriction_mapDomain hF p).symm

variable {T : Type*} [CommRing T] (ψ : S →+* T)

/-- The face quotient equivalence is natural in the coefficient ring: the map of face quotients
induced by a change of coefficients corresponds to changing the coefficients of the monoid
algebra of the face. -/
@[simp]
theorem faceQuotientEquiv_quotientMap (x : AddMonoidAlgebra S M ⧸ F.faceIdeal S) :
    F.faceQuotientEquiv hF
        (Ideal.quotientMap (F.faceIdeal T) (mapRingHom M ψ) (F.faceIdeal_le_comap_mapRingHom ψ)
          x) =
      mapRingHom F ψ (F.faceQuotientEquiv hF x) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  simp

end CommRing

section NSMul

variable {n : ℕ}

/-- For `n ≠ 0`, raising monomials to the `n`-th power commutes with restriction to a face. -/
theorem faceRestriction_mapDomainRingHom_nsmul (hn : n ≠ 0) (p : AddMonoidAlgebra R M) :
    F.faceRestriction hF R (mapDomainRingHom R (nsmulAddMonoidHom n) p) =
      mapDomainRingHom R (nsmulAddMonoidHom n) (F.faceRestriction hF R p) := by
  induction p using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add p q hp hq => simp only [map_add, hp, hq]
  | single a r =>
    by_cases ha : a ∈ F
    · have h := F.faceRestriction_single_mem hF (n • ⟨a, ha⟩) r
      rw [AddSubmonoidClass.coe_nsmul] at h
      simp only [mapDomainRingHom_apply, mapDomain_single, nsmulAddMonoidHom_apply, h,
        F.faceRestriction_single_mem hF ⟨a, ha⟩]
    · have hna : n • a ∉ F := fun h ↦ ha ((hF.nsmulSaturated h).resolve_left hn)
      simp [mapDomainRingHom_apply, F.faceRestriction_single_of_notMem hF ha,
        F.faceRestriction_single_of_notMem hF hna]

include hF in
/-- For `n ≠ 0`, raising monomials to the `n`-th power maps the ideal of a face into itself. -/
theorem faceIdeal_le_comap_mapDomainRingHom_nsmul (hn : n ≠ 0) :
    F.faceIdeal R ≤ (F.faceIdeal R).comap (mapDomainRingHom R (nsmulAddMonoidHom n)) := by
  intro p hp
  rw [← F.ker_faceRestriction hF, RingHom.mem_ker] at hp
  rw [Ideal.mem_comap, ← F.ker_faceRestriction hF, RingHom.mem_ker,
    F.faceRestriction_mapDomainRingHom_nsmul hF hn, hp, map_zero]

/-- For `n ≠ 0`, the preimage of the zero locus of a monomial ideal under raising monomials to
the `n`-th power is the same zero locus. No face condition is needed: a prime contains the
`n`-th power of a monomial exactly when it contains the monomial. -/
theorem preimage_comap_mapDomainRingHom_nsmul_zeroLocus_faceIdeal (hn : n ≠ 0) :
    PrimeSpectrum.comap (mapDomainRingHom R (nsmulAddMonoidHom n)) ⁻¹'
        PrimeSpectrum.zeroLocus (F.faceIdeal R : Set (AddMonoidAlgebra R M)) =
      PrimeSpectrum.zeroLocus (F.faceIdeal R : Set (AddMonoidAlgebra R M)) := by
  rw [faceIdeal_def, PrimeSpectrum.zeroLocus_span, PrimeSpectrum.preimage_comap_zeroLocus,
    ← Set.image_comp]
  ext x
  simp only [PrimeSpectrum.mem_zeroLocus, Set.image_subset_iff]
  refine forall₂_congr fun a _ ↦ ?_
  simp only [Set.mem_preimage, Function.comp_apply, of'_apply, mapDomainRingHom_apply,
    mapDomain_single, nsmulAddMonoidHom_apply, SetLike.mem_coe]
  rw [show single (n • a) (1 : R) = single a 1 ^ n by rw [single_pow, one_pow],
    x.isPrime.pow_mem_iff_mem n (Nat.pos_of_ne_zero hn)]

/-- Raising monomials to the zeroth power sends each of them to `1`, so the preimage of the zero
locus of the monomial ideal of a proper submonoid is empty. -/
theorem preimage_comap_mapDomainRingHom_nsmul_zero_zeroLocus_faceIdeal_eq_empty (hFtop : F ≠ ⊤) :
    PrimeSpectrum.comap (mapDomainRingHom R (nsmulAddMonoidHom 0)) ⁻¹'
        PrimeSpectrum.zeroLocus (F.faceIdeal R : Set (AddMonoidAlgebra R M)) = ∅ := by
  obtain ⟨a, ha⟩ : ∃ a, a ∉ F := by
    by_contra! h
    exact hFtop (eq_top_iff.mpr fun a _ ↦ h a)
  refine Set.eq_empty_of_forall_notMem fun x hx ↦ x.isPrime.ne_top ?_
  have hmem : single a (1 : R) ∈ F.faceIdeal R := Ideal.subset_span ⟨a, ha, of'_apply a⟩
  rw [Set.mem_preimage, PrimeSpectrum.mem_zeroLocus] at hx
  have h1 := hx hmem
  simp only [SetLike.mem_coe, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap,
    mapDomainRingHom_apply, mapDomain_single, nsmulAddMonoidHom_apply, zero_nsmul,
    ← one_def] at h1
  exact (Ideal.eq_top_iff_one _).mpr h1

end NSMul

include hF in
/-- Over a nontrivial semiring with no zero divisors, the ideal of a face is prime whenever
the face has unique sums. In particular, this applies to every submonoid of a lattice. -/
theorem faceIdeal_isPrime [NoZeroDivisors R] [Nontrivial R] [UniqueSums F] :
    (F.faceIdeal R).IsPrime := by
  rw [← F.ker_faceRestriction hF]
  exact RingHom.ker_isPrime (F.faceRestriction hF R)

end AddSubmonoid
