module

public import Mathlib.Algebra.Group.Submonoid.Saturation
public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.Algebra.MonoidAlgebra.Ideal
public import Mathlib.Algebra.MonoidAlgebra.NoZeroDivisors
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Monomial ideals of semigroup faces

A face of an additive monoid is an additive submonoid `F` satisfying Mathlib's
`AddSubmonoid.AddSaturated` condition: if `a + b ∈ F`, then both summands lie in `F`.
This is distinct from saturation under positive multiples.

Restriction to a face sends a monomial outside the face to zero and retains every monomial
on the face. It is a surjective algebra homomorphism, whose kernel is the ideal generated
by the coefficient-one monomials outside the face. The quotient is canonically the monoid
algebra of the face. For nontrivial coefficients with no zero divisors, the ideal of a face `F`
with unique sums is prime. These are the coordinate-ring maps for closed face embeddings
of affine semigroup schemes; no normality or finite generation is needed.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 2.
* W. Fulton, *Introduction to Toric Varieties*, §1.2.
-/

public section

namespace AddSubmonoid

open AddMonoidAlgebra

variable {M R : Type*} [AddCommMonoid M] [CommSemiring R]

/-- The ideal generated by the monomials whose exponents lie outside `F`.
When `F` is a face, this cuts out its closed affine semigroup subscheme. -/
noncomputable def faceIdeal (F : AddSubmonoid M) (R : Type*) [CommSemiring R] :
    Ideal (AddMonoidAlgebra R M) :=
  Ideal.span (of' R M '' (F : Set M)ᶜ)

/-- The face ideal is the span of the coefficient-one monomials outside the submonoid. -/
theorem faceIdeal_def (F : AddSubmonoid M) (R : Type*) [CommSemiring R] :
    F.faceIdeal R = Ideal.span (of' R M '' (F : Set M)ᶜ) := (rfl)

/-- Restriction to a face: retain monomials on the face and kill those outside it. -/
noncomputable def faceRestriction (F : AddSubmonoid M) (hF : F.AddSaturated)
    (R : Type*) [CommSemiring R] : AddMonoidAlgebra R M →ₐ[R] AddMonoidAlgebra R F := by
  classical
  exact AddMonoidAlgebra.lift R _ M
    { toFun := fun a ↦ if h : a.toAdd ∈ F then single ⟨a.toAdd, h⟩ 1 else 0
      map_one' := by
        simp [one_def, (F.mk_eq_zero (ha := F.zero_mem)).mpr rfl]
      map_mul' := by
        intro a b
        by_cases ha : a.toAdd ∈ F <;> by_cases hb : b.toAdd ∈ F <;>
          simp [hF.add_mem_iff, ha, hb, single_mul_single] }

variable (F : AddSubmonoid M) (hF : F.AddSaturated)

/-- Face restriction is coefficient pullback along the inclusion of the face. -/
theorem faceRestriction_eq_comapDomain (p : AddMonoidAlgebra R M) :
    F.faceRestriction hF R p = comapDomain Subtype.val Subtype.val_injective p := by
  classical
  induction p using AddMonoidAlgebra.induction_on with
  | of b =>
    by_cases hb : b ∈ F
    · simpa [faceRestriction, of_apply, AddMonoidAlgebra.lift_single, hb] using
        (comapDomain_single_map Subtype.val Subtype.val_injective ⟨b, hb⟩ (1 : R)).symm
    · ext a
      simp [faceRestriction, of_apply, AddMonoidAlgebra.lift_single, hb]
  | add p q hp hq => simp [hp, hq]
  | smul r p hp =>
    ext a
    simp [hp]

/-- Restriction retains a monomial on the face. -/
@[simp]
theorem faceRestriction_single_mem (a : F) (r : R) :
    F.faceRestriction hF R (single (a : M) r) = single a r := by
  rw [faceRestriction_eq_comapDomain, comapDomain_single_map]

/-- Restriction kills a monomial outside the face. -/
@[simp]
theorem faceRestriction_single_of_notMem {a : M} (ha : a ∉ F) (r : R) :
    F.faceRestriction hF R (single a r) = 0 := by
  rw [faceRestriction_eq_comapDomain]
  ext b
  have hab : a ≠ (b : M) := fun h ↦ ha (h ▸ b.property)
  simp [hab]

/-- The coefficients of restriction are the original coefficients on the face. -/
@[simp]
theorem coeff_faceRestriction (p : AddMonoidAlgebra R M) (a : F) :
    (F.faceRestriction hF R p).coeff a = p.coeff (a : M) := by
  simp [faceRestriction_eq_comapDomain]

/-- Extending face monomials to the ambient monoid is a section of restriction. -/
@[simp]
theorem faceRestriction_mapDomain (p : AddMonoidAlgebra R F) :
    F.faceRestriction hF R (mapDomain Subtype.val p) = p := by
  ext a
  simp

/-- Face restriction is surjective, even over a coefficient semiring. -/
theorem faceRestriction_surjective : Function.Surjective (F.faceRestriction hF R) :=
  fun p ↦ ⟨mapDomainAlgHom R R F.subtype p, F.faceRestriction_mapDomain hF p⟩

include hF in
/-- Membership in the face ideal means that every coefficient on the face vanishes. -/
theorem mem_faceIdeal_iff (p : AddMonoidAlgebra R M) :
    p ∈ F.faceIdeal R ↔ ∀ a : F, p.coeff (a : M) = 0 := by
  classical
  rw [faceIdeal_def, mem_ideal_span_of'_image]
  constructor
  · intro hp a
    by_contra ha
    obtain ⟨b, hb, d, hd⟩ := hp a (Finsupp.mem_support_iff.mpr ha)
    exact hb ((hF.add_mem_iff.mp (hd ▸ a.property)).2)
  · intro hp a ha
    refine ⟨a, ?_, 0, (zero_add a).symm⟩
    exact fun h ↦ (Finsupp.mem_support_iff.mp ha) (hp ⟨a, h⟩)

/-- The monomial face ideal is exactly the kernel of restriction. -/
theorem ker_faceRestriction : RingHom.ker (F.faceRestriction hF R) = F.faceIdeal R := by
  ext p
  rw [F.mem_faceIdeal_iff hF, RingHom.mem_ker, ← coeff_inj]
  simp [Finsupp.ext_iff]

include hF in
/-- A monomial belongs to the face ideal exactly when its coefficient is zero or its
exponent is outside the face. -/
@[simp]
theorem single_mem_faceIdeal_iff (a : M) (r : R) :
    single a r ∈ F.faceIdeal R ↔ r = 0 ∨ a ∉ F := by
  classical
  rw [F.mem_faceIdeal_iff hF]
  by_cases ha : a ∈ F
  · constructor
    · intro h
      exact Or.inl (by simpa using h ⟨a, ha⟩)
    · rintro (rfl | h)
      · simp
      · exact (h ha).elim
  · have hab : ∀ b : F, a ≠ (b : M) := fun b h ↦ ha (h ▸ b.property)
    simp [ha, hab]

/-- Inclusion of faces reverses inclusion of their monomial ideals. -/
theorem faceIdeal_le_faceIdeal_iff [Nontrivial R] (G : AddSubmonoid M)
    (hG : G.AddSaturated) : F.faceIdeal R ≤ G.faceIdeal R ↔ G ≤ F := by
  constructor
  · intro h a ha
    by_contra hnot
    have hm : single a (1 : R) ∈ F.faceIdeal R := Ideal.subset_span ⟨a, hnot, of'_apply a⟩
    simpa [ha] using (G.single_mem_faceIdeal_iff hG a 1).mp (h hm)
  · intro h
    apply Ideal.span_le.mpr
    rintro _ ⟨a, ha, rfl⟩
    exact Ideal.subset_span ⟨a, fun hmem ↦ ha (h hmem), rfl⟩

section CommRing

variable {S : Type*} [CommRing S]

/-- The coordinate ring of the closed face is the monoid algebra of that face. -/
noncomputable def faceQuotientEquiv :
    (AddMonoidAlgebra S M ⧸ F.faceIdeal S) ≃ₐ[S] AddMonoidAlgebra S F :=
  (Ideal.quotientEquivAlgOfEq S (F.ker_faceRestriction hF).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (F.faceRestriction_surjective hF))

/-- The face quotient equivalence is induced by restriction. -/
@[simp]
theorem faceQuotientEquiv_mk (p : AddMonoidAlgebra S M) :
    F.faceQuotientEquiv hF (Ideal.Quotient.mk (F.faceIdeal S) p) =
      F.faceRestriction hF S p := by
  simp [faceQuotientEquiv, Ideal.quotientEquivAlgOfEq_mk]

/-- The inverse quotient equivalence extends a polynomial on the face and takes its class. -/
@[simp]
theorem faceQuotientEquiv_symm_apply (p : AddMonoidAlgebra S F) :
    (F.faceQuotientEquiv hF).symm p =
      Ideal.Quotient.mk (F.faceIdeal S) (mapDomain Subtype.val p) := by
  apply (F.faceQuotientEquiv hF).injective
  simpa only [AlgEquiv.apply_symm_apply, faceQuotientEquiv_mk] using
    (F.faceRestriction_mapDomain hF p).symm

end CommRing

include hF in
/-- Over a nontrivial semiring with no zero divisors, the ideal of a face is prime whenever
the face has unique sums. In particular, this applies to every submonoid of a lattice. -/
theorem faceIdeal_isPrime [NoZeroDivisors R] [Nontrivial R] [UniqueSums F] :
    (F.faceIdeal R).IsPrime := by
  rw [← F.ker_faceRestriction hF]
  exact RingHom.ker_isPrime (F.faceRestriction hF R)

end AddSubmonoid
