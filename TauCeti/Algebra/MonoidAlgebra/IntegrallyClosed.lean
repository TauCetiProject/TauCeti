section FiniteNormalization

/-- **Finite normalization in a finitely generated torsion-free abelian group.** For a finitely
generated submonoid `S` of a finitely generated torsion-free abelian group `L`,
`R[S.nsmulSaturation]` is a finite `R[S]`-algebra over any commutative ring `R`. -/
theorem mapDomainRingHom_inclusion_nsmulSaturation_finite {L : Type*} [AddCommGroup L]
    [Module.Finite ℤ L] [HasUniqueDiv L] {S : AddSubmonoid L} (hS : S.FG)
    (R : Type*) [CommRing R] :
    (mapDomainRingHom R (AddSubmonoid.inclusion S.le_nsmulSaturation)).Finite :=
  TauCeti.AddMonoidAlgebra.mapDomainRingHom_finite_of_exists_finset_add _
    (AddSubmonoid.exists_finset_inclusion_add S.le_nsmulSaturation
      hS.exists_finset_subset_nsmulSaturation_add) R

/-- **Finite normalization in the generated subgroup.** For a finitely generated submonoid `S` of a
torsion-free abelian group `G`, the algebra of the saturation of `S` inside
`AddSubgroup.closure (S : Set G)` is a finite `R[S]`-algebra over any commutative ring `R`. -/
theorem mapDomainRingHom_inclusion_nsmulSaturation_inf_closure_finite {G : Type*} [AddCommGroup G]
    [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG) (R : Type*) [CommRing R] :
    (mapDomainRingHom R
      (AddSubmonoid.inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).Finite :=
  TauCeti.AddMonoidAlgebra.mapDomainRingHom_finite_of_exists_finset_add _
    (AddSubmonoid.exists_finset_inclusion_add
      (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)
      hS.exists_finset_subset_nsmulSaturation_inf_closure_add) R

end FiniteNormalization

section CoeffAndFreeGroup

/-- If the monoid algebra `R[M]` of a commutative monoid `M` is integrally closed, then the
coefficient ring `R` is integrally closed. -/
theorem isIntegrallyClosed_of_addMonoidAlgebra {R M : Type*} [CommRing R] [AddCommMonoid M]
    [IsIntegrallyClosed (AddMonoidAlgebra R M)] : IsIntegrallyClosed R := by
  have h_le : R⁰ ≤ (AddMonoidAlgebra R M)⁰.comap (algebraMap R (AddMonoidAlgebra R M)) := by
    intro r hr
    rw [Submonoid.mem_comap, mem_nonZeroDivisors_iff_right]
    intro f hf
    ext m
    exact mem_nonZeroDivisors_iff_right.mp hr (f.coeff m)
      (by simpa [coeff_mul_single_zero] using congr(($hf).coeff m))
  let g : FractionRing R →+* FractionRing (AddMonoidAlgebra R M) :=
    IsLocalization.map (T := (AddMonoidAlgebra R M)⁰)
      (FractionRing (AddMonoidAlgebra R M)) (algebraMap R (AddMonoidAlgebra R M)) h_le
  let gₐ : FractionRing R →ₐ[R] FractionRing (AddMonoidAlgebra R M) :=
    { g with
      commutes' r := by
        simp [g, IsLocalization.map_eq,
          IsScalarTower.algebraMap_apply R (AddMonoidAlgebra R M)
            (FractionRing (AddMonoidAlgebra R M))] }
  refine (isIntegrallyClosed_iff (FractionRing R)).mpr fun {x} hx => ?_
  have hxg : IsIntegral (AddMonoidAlgebra R M) (gₐ x) := (hx.map gₐ).tower_top
  obtain ⟨f, hf⟩ := (isIntegrallyClosed_iff (FractionRing (AddMonoidAlgebra R M))).mp ‹_› hxg
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj R⁰ x
  have hmul_frac :
      algebraMap (AddMonoidAlgebra R M) (FractionRing (AddMonoidAlgebra R M))
          (f * algebraMap R (AddMonoidAlgebra R M) b.1) =
        algebraMap (AddMonoidAlgebra R M) (FractionRing (AddMonoidAlgebra R M))
          (algebraMap R (AddMonoidAlgebra R M) a) := by
    simpa [gₐ.commutes, IsScalarTower.algebraMap_apply R (AddMonoidAlgebra R M)
      (FractionRing (AddMonoidAlgebra R M)), ← hf] using congrArg gₐ hab
  have hmul : f * algebraMap R (AddMonoidAlgebra R M) b.1 =
      algebraMap R (AddMonoidAlgebra R M) a :=
    IsFractionRing.injective (AddMonoidAlgebra R M) (FractionRing (AddMonoidAlgebra R M)) hmul_frac
  have hcoeff : f.coeff 0 * b.1 = a := by
    simpa [coeff_mul_single_zero] using congr(($hmul).coeff 0)
  refine ⟨f.coeff 0, ?_⟩
  apply (IsLocalization.map_units (FractionRing R) b).mul_left_inj.mp
  rw [← map_mul, hcoeff, hab]

/-- Over an integrally closed domain `R`, the group algebra `R[G]` of any free abelian group `G`
is integrally closed. -/
instance isIntegrallyClosed_of_free {R G : Type*} [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    [AddCommGroup G] [Module.Free ℤ G] : IsIntegrallyClosed (AddMonoidAlgebra R G) := by
  let b := Module.Free.chooseBasis ℤ G
  let ι := Module.Free.ChooseBasisIndex ℤ G
  refine IsIntegrallyClosed.of_equiv (mapDomainRingEquiv R b.repr.toAddEquiv).symm (h := ?_)
  let j : (ι →₀ ℕ) →+ (ι →₀ ℤ) := Finsupp.mapRange.addMonoidHom (Nat.castAddMonoidHom ℤ)
  have hj : Function.Injective j :=
    Finsupp.mapRange_injective _ Nat.cast_zero Nat.cast_injective
  let P : AddSubmonoid (ι →₀ ℤ) := AddMonoidHom.mrange j
  have hP_top : AddSubgroup.closure (P : Set (ι →₀ ℤ)) = ⊤ := by
    rw [eq_top_iff]
    intro v _
    let vPos : ι →₀ ℕ := v.mapRange Int.toNat rfl
    let vNeg : ι →₀ ℕ := (-v).mapRange Int.toNat rfl
    have hv : v = j vPos - j vNeg := by
      ext i
      simp [j, vPos, vNeg]
      lia
    rw [hv]
    exact sub_mem (AddSubgroup.subset_closure ⟨vPos, rfl⟩) (AddSubgroup.subset_closure ⟨vNeg, rfl⟩)
  let eP : (ι →₀ ℕ) ≃+ P := AddEquiv.ofBijective (j.codRestrict P fun x => ⟨x, rfl⟩)
    ⟨(j.injective_codRestrict P _).mpr hj, fun ⟨_, x, rfl⟩ => ⟨x, rfl⟩⟩
  have hIC_mv : IsIntegrallyClosed (AddMonoidAlgebra R (ι →₀ ℕ)) :=
    TauCeti.MvPolynomial.isIntegrallyClosed (σ := ι) (R := R)
  have hIC_P : IsIntegrallyClosed (AddMonoidAlgebra R P) :=
    IsIntegrallyClosed.of_equiv (mapDomainRingEquiv R eP) (h := hIC_mv)
  let := (mapDomainRingHom R P.toGroupClosure).toAlgebra
  have := P.isLocalization_addMonoidAlgebra_groupClosure R
  have hIC_cl : IsIntegrallyClosed (AddMonoidAlgebra R (AddSubgroup.closure (P : Set (ι →₀ ℤ)))) :=
    isIntegrallyClosed_of_isLocalization _ (MonoidHom.mrange (of R P)) mrange_of_le_nonZeroDivisors
  let eTop : AddSubgroup.closure (P : Set (ι →₀ ℤ)) ≃+ (ι →₀ ℤ) :=
    AddEquiv.ofBijective (AddSubgroup.closure (P : Set (ι →₀ ℤ))).subtype
      ⟨Subtype.val_injective, fun v => ⟨⟨v, hP_top.symm ▸ AddSubgroup.mem_top v⟩, rfl⟩⟩
  exact IsIntegrallyClosed.of_equiv (mapDomainRingEquiv R eTop) (h := hIC_cl)

end CoeffAndFreeGroup

section HalfSpaceAndGroupClosure

private theorem le_inf_support_pow_coe {R G : Type*} [Semiring R] [AddCommMonoid G] (φ : G →+ ℤ)
    {f : AddMonoidAlgebra R G} {μ : ℤ} (hf : ∀ g ∈ f.coeff.support, μ ≤ φ g) (n : ℕ) :
    ((n • μ : ℤ) : WithTop ℤ) ≤ (f ^ n).coeff.support.inf fun g => (φ g : WithTop ℤ) :=
  have hf_inf : (μ : WithTop ℤ) ≤ f.coeff.support.inf fun g => (φ g : WithTop ℤ) :=
    Finset.le_inf_iff.mpr fun g hg => WithTop.coe_le_coe.mpr (hf g hg)
  (WithTop.coe_nsmul μ n).trans_le <| (nsmul_le_nsmul_right hf_inf n).trans <|
    le_inf_support_pow (by simp) (fun a b => by simp [map_add, ← WithTop.coe_add]) n f

private theorem lt_apply_of_mem_support_pow_sub_pow {R G : Type*} [CommRing R] [AddCommMonoid G]
    (φ : G →+ ℤ) {f f₀ f₁ : AddMonoidAlgebra R G} (hf_split : f = f₀ + f₁) {μ : ℤ}
    (hf : ∀ g ∈ f.coeff.support, μ ≤ φ g) (hf₀ : ∀ g ∈ f₀.coeff.support, μ ≤ φ g)
    (hf₁ : ∀ g ∈ f₁.coeff.support, μ < φ g) (n : ℕ) :
    ∀ g ∈ (f ^ n - f₀ ^ n).coeff.support, n • μ < φ g := by
  let degt : G → WithTop ℤ := fun g => (φ g : WithTop ℤ)
  have degtm : ∀ a b, degt a + degt b ≤ degt (a + b) := fun a b => by
    simp [degt, map_add, ← WithTop.coe_add]
  have hf₀_inf : (μ : WithTop ℤ) ≤ f₀.coeff.support.inf degt :=
    Finset.le_inf_iff.mpr fun g hg => WithTop.coe_le_coe.mpr (hf₀ g hg)
  have hf₁_inf : ((μ + 1 : ℤ) : WithTop ℤ) ≤ f₁.coeff.support.inf degt :=
    Finset.le_inf_iff.mpr fun g hg => WithTop.coe_le_coe.mpr (Int.add_one_le_iff.mpr (hf₁ g hg))
  suffices ((n • μ + 1 : ℤ) : WithTop ℤ) ≤ (f ^ n - f₀ ^ n).coeff.support.inf degt from
    fun g hg => Int.add_one_le_iff.mp (WithTop.coe_le_coe.mp (Finset.le_inf_iff.mp this g hg))
  induction n with
  | zero => simp
  | succ n ih =>
    have hid : f ^ (n + 1) - f₀ ^ (n + 1) = (f ^ n - f₀ ^ n) * f₀ + f ^ n * f₁ := by
      rw [hf_split, pow_succ, pow_succ]
      ring
    rw [hid]
    refine (le_inf ?_ ?_).trans (le_inf_support_coeff_add degt _ _)
    · rw [show (n + 1) • μ + 1 = (n • μ + 1) + μ by rw [succ_nsmul]; ring, WithTop.coe_add]
      exact (add_le_add ih hf₀_inf).trans (le_inf_support_coeff_mul degtm _ _)
    · rw [show (n + 1) • μ + 1 = n • μ + (μ + 1) by rw [succ_nsmul]; ring, WithTop.coe_add]
      exact (add_le_add (le_inf_support_pow_coe φ hf n) hf₁_inf).trans
        (le_inf_support_coeff_mul degtm _ _)

private theorem lt_apply_of_mem_support_sum_mul_pow {R A G : Type*} [CommRing R] [Semiring A]
    [AddCommMonoid G] (σ : A →+* AddMonoidAlgebra R G) (φ : G →+ ℤ)
    (hσ : ∀ a : A, ∀ g ∈ (σ a).coeff.support, 0 ≤ φ g) {f : AddMonoidAlgebra R G} {μ : ℤ}
    (hμ_neg : μ < 0) (hf : ∀ g ∈ f.coeff.support, μ ≤ φ g) (c : ℕ → A) (d : ℕ) :
    ∀ g ∈ (∑ i ∈ Finset.range d, σ (c i) * f ^ i).coeff.support, d • μ < φ g := by
  let degt : G → WithTop ℤ := fun g => (φ g : WithTop ℤ)
  have degtm : ∀ a b, degt a + degt b ≤ degt (a + b) := fun a b => by
    simp [degt, map_add, ← WithTop.coe_add]
  intro g hg
  have hsum_ne : ∑ i ∈ Finset.range d, (σ (c i) * f ^ i).coeff g ≠ 0 := by
    simpa [coeff_sum, Finsupp.finsetSum_apply] using Finsupp.mem_support_iff.mp hg
  obtain ⟨i, hi, hgi_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum_ne
  have hσ_inf : ((0 : ℤ) : WithTop ℤ) ≤ (σ (c i)).coeff.support.inf degt :=
    Finset.le_inf_iff.mpr fun x hx => WithTop.coe_le_coe.mpr (hσ (c i) x hx)
  have hterm_inf : ((i • μ : ℤ) : WithTop ℤ) ≤ (σ (c i) * f ^ i).coeff.support.inf degt := by
    simpa using (add_le_add hσ_inf (le_inf_support_pow_coe φ hf i)).trans
      (le_inf_support_coeff_mul degtm _ _)
  have hterm : i • μ ≤ φ g :=
    WithTop.coe_le_coe.mp (Finset.le_inf_iff.mp hterm_inf g (Finsupp.mem_support_iff.mpr hgi_ne))
  have hlt : d • μ < i • μ := by
    simpa [nsmul_eq_mul] using
      mul_lt_mul_of_neg_right (Nat.cast_lt.mpr (Finset.mem_range.mp hi)) hμ_neg
  exact hlt.trans_le hterm

/-- **Half-space integral closedness.** Let `R` be a domain, `G` a torsion-free abelian group, and
`φ : G →+ ℤ` an additive functional. If a ring homomorphism `σ : A →+* R[G]` lands in elements
whose support satisfies `0 ≤ φ`, then every element `f : R[G]` integral over `σ` also has support
satisfying `0 ≤ φ`. -/
theorem nonneg_on_support_coeff_of_isIntegralElem {R A G : Type*} [CommRing R] [IsDomain R]
    [CommRing A] [AddCommGroup G] [HasUniqueDiv G] (σ : A →+* AddMonoidAlgebra R G) (φ : G →+ ℤ)
    (hσ : ∀ a : A, ∀ g ∈ (σ a).coeff.support, 0 ≤ φ g) {f : AddMonoidAlgebra R G}
    (hf : σ.IsIntegralElem f) :
    ∀ g ∈ f.coeff.support, 0 ≤ φ g := by
  classical
  by_contra hnot
  push Not at hnot
  -- Isolate the nonzero initial form `f₀` of `f` along the minimum negative value `μ` of `φ`.
  obtain ⟨g₀, hg₀, hφg₀⟩ := hnot
  let V : Finset ℤ := f.coeff.support.image φ
  have hne : V.Nonempty := ⟨φ g₀, Finset.mem_image_of_mem φ hg₀⟩
  let μ : ℤ := V.min' hne
  have hμ_neg : μ < 0 := (Finset.min'_le V (φ g₀) (Finset.mem_image_of_mem φ hg₀)).trans_lt hφg₀
  have hμ_le : ∀ g ∈ f.coeff.support, μ ≤ φ g :=
    fun g hg => Finset.min'_le V (φ g) (Finset.mem_image_of_mem φ hg)
  obtain ⟨gMin, hgMin_supp, hgMin_eq⟩ := Finset.mem_image.mp (Finset.min'_mem V hne)
  let f₀ : AddMonoidAlgebra R G := ofCoeff (f.coeff.filter fun g => φ g = μ)
  let f₁ : AddMonoidAlgebra R G := ofCoeff (f.coeff.filter fun g => ¬ (φ g = μ))
  have hf_split : f = f₀ + f₁ :=
    coeff_injective (by simp only [coeff_add, f₀, f₁, Finsupp.filter_add_filter_not])
  have hf₀_ne : f₀ ≠ 0 := fun h0 =>
    Finsupp.mem_support_iff.mp hgMin_supp <| by
      have hc : f₀.coeff gMin = 0 := by simp [h0]
      rwa [coeff_ofCoeff, Finsupp.filter_apply_pos (fun g => φ g = μ) f.coeff hgMin_eq] at hc
  have hf₀_grade : f₀ ∈ gradeBy R φ μ := (mem_gradeBy_iff R φ μ f₀).mpr fun g hg => by
    rw [Finset.mem_coe, coeff_ofCoeff, Finsupp.support_filter, Finset.mem_filter] at hg
    exact hg.2
  have hf₁_gt : ∀ g ∈ f₁.coeff.support, μ < φ g := fun g hg => by
    rw [coeff_ofCoeff, Finsupp.support_filter, Finset.mem_filter] at hg
    exact lt_of_le_of_ne (hμ_le g hg.1) (Ne.symm hg.2)
  -- In the monic relation for `f`, every term except `f₀ ^ d` has `φ`-value strictly above `d • μ`.
  obtain ⟨p, hp_monic, hp_eval⟩ := hf
  let d := p.natDegree
  rw [eval₂_eq_sum_range, Finset.sum_range_succ, hp_monic.coeff_natDegree, map_one, one_mul]
    at hp_eval
  have heq : f₀ ^ d = -((f ^ d - f₀ ^ d) + ∑ i ∈ Finset.range d, σ (p.coeff i) * f ^ i) :=
    eq_neg_of_add_eq_zero_left (by rw [← hp_eval]; ring)
  have hrhs : ∀ g ∈ (-((f ^ d - f₀ ^ d) + ∑ i ∈ Finset.range d, σ (p.coeff i) * f ^ i))
      |>.coeff.support, d • μ < φ g := by
    intro g hg
    rw [coeff_neg, Finsupp.support_neg, coeff_add] at hg
    rcases Finset.mem_union.mp (Finsupp.support_add hg) with hg_diff | hg_sum
    · exact lt_apply_of_mem_support_pow_sub_pow φ hf_split hμ_le
        (fun x hx => (hf₀_grade x hx).ge) hf₁_gt d g hg_diff
    · exact lt_apply_of_mem_support_sum_mul_pow σ φ hσ hμ_neg hμ_le p.coeff d g hg_sum
  -- Since `R[G]` is a domain, `f₀ ^ d ≠ 0`, contradicting `φ = d • μ` on its support.
  have hpow_ne : f₀ ^ d ≠ 0 := pow_ne_zero d hf₀_ne
  obtain ⟨gMin', hgMin'⟩ : (f₀ ^ d).coeff.support.Nonempty :=
    Finsupp.support_nonempty_iff.mpr fun h => hpow_ne (coeff_injective (by simp [h]))
  have hf₀_pow : φ gMin' = d • μ := SetLike.pow_mem_graded d hf₀_grade gMin' hgMin'
  exact (hf₀_pow ▸ hrhs gMin' (heq ▸ hgMin')).false

/-- **Integral closure inside `R[L]`.** For a finitely generated submonoid `S` of a finitely
generated torsion-free abelian group `L` and any integral domain `R`, `R[S.nsmulSaturation]` is the
integral closure of `R[S]` inside `R[L]`. -/
theorem isIntegralClosure_nsmulSaturation {R L : Type*} [CommRing R] [IsDomain R] [AddCommGroup L]
    [Module.Finite ℤ L] [HasUniqueDiv L] {S : AddSubmonoid L} (hS : S.FG) :
    letI := (mapDomainRingHom R S.subtype).toAlgebra
    letI := (mapDomainRingHom R S.nsmulSaturation.subtype).toAlgebra
    IsIntegralClosure (AddMonoidAlgebra R S.nsmulSaturation) (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R L) := by
  classical
  let := (mapDomainRingHom R S.subtype).toAlgebra
  let := (mapDomainRingHom R S.nsmulSaturation.subtype).toAlgebra
  refine ⟨mapDomain_injective Subtype.val_injective, fun {f} => ⟨fun hf => ?_, ?_⟩⟩
  · have hsupp : ∀ g ∈ f.coeff.support, g ∈ S.nsmulSaturation := by
      intro g hg
      refine hS.mem_nsmulSaturation_iff_forall_nonneg.mpr fun φ hφ => ?_
      refine nonneg_on_support_coeff_of_isIntegralElem (mapDomainRingHom R S.subtype) φ ?_ hf g hg
      intro a x hx
      rw [mapDomainRingHom_apply] at hx
      obtain ⟨s, _, rfl⟩ :=
        Finset.mem_image.mp (Finsupp.mapDomain_support (by rwa [coeff_mapDomain] at hx))
      exact hφ s.1 s.2
    refine ⟨comapDomain S.nsmulSaturation.subtype Subtype.val_injective f, ?_⟩
    rw [RingHom.algebraMap_toAlgebra, mapDomainRingHom_apply]
    exact mapDomain_comapDomain (fun g hg => ⟨⟨g, hsupp g hg⟩, rfl⟩) Subtype.val_injective
  · rintro ⟨y, rfl⟩
    set ι₁ := AddSubmonoid.inclusion S.le_nsmulSaturation
    obtain ⟨p, hp_monic, hp_eval⟩ := isIntegral_mapDomainRingHom_inclusion_nsmulSaturation S y
    have hcomp : (mapDomainRingHom R S.nsmulSaturation.subtype).comp (mapDomainRingHom R ι₁) =
        mapDomainRingHom R S.subtype := by
      rw [← mapDomainRingHom_comp, AddSubmonoid.subtype_comp_inclusion]
    rw [RingHom.algebraMap_toAlgebra]
    refine ⟨p, hp_monic, ?_⟩
    rw [RingHom.algebraMap_toAlgebra, ← hcomp, ← hom_eval₂, hp_eval, map_zero]

/-- **Integral closure inside `R[L_S]`.** For any finitely generated submonoid `S` of a
torsion-free abelian group `G` and any integral domain `R`, the algebra of
`S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid` is the integral closure of
`R[S]` inside `R[AddSubgroup.closure (S : Set G)]`. -/
theorem isIntegralClosure_nsmulSaturation_inf_closure {R G : Type*} [CommRing R]
    [IsDomain R] [AddCommGroup G] [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG) :
    letI := (mapDomainRingHom R S.toGroupClosure).toAlgebra
    letI := (mapDomainRingHom R
      (AddSubmonoid.inclusion
        (inf_le_right :
          S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid ≤
            (AddSubgroup.closure (S : Set G)).toAddSubmonoid) :
        _ →+ AddSubgroup.closure (S : Set G))).toAlgebra
    IsIntegralClosure
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) := by
  -- Transport `isIntegralClosure_nsmulSaturation` from the pullback `S₀ ≤ L_S` to `S` and `S_sat`.
  set L_S := AddSubgroup.closure (S : Set G)
  set S₀ := S.comap L_S.subtype
  have : Module.Finite ℤ L_S := hS.moduleFinite_addSubgroup_closure
  let _ : Algebra (AddMonoidAlgebra R S₀) (AddMonoidAlgebra R L_S) :=
    (mapDomainRingHom R S₀.subtype).toAlgebra
  let _ : Algebra (AddMonoidAlgebra R S₀.nsmulSaturation) (AddMonoidAlgebra R L_S) :=
    (mapDomainRingHom R S₀.nsmulSaturation.subtype).toAlgebra
  let _ : Algebra (AddMonoidAlgebra R S) (AddMonoidAlgebra R L_S) :=
    (mapDomainRingHom R S.toGroupClosure).toAlgebra
  let ιSat : ↥(S.nsmulSaturation ⊓ L_S.toAddSubmonoid) →+ L_S :=
    AddSubmonoid.inclusion (inf_le_right : S.nsmulSaturation ⊓ L_S.toAddSubmonoid ≤ _)
  let _ : Algebra (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ L_S.toAddSubmonoid))
      (AddMonoidAlgebra R L_S) :=
    (mapDomainRingHom R ιSat).toAlgebra
  refine (isIntegralClosure_nsmulSaturation hS.comap_subtype_closure).of_ringEquiv
    (mapDomainRingEquiv R S.nsmulSaturationInfClosureEquiv.symm)
    (mapDomainRingEquiv R S.toGroupClosureEquiv.symm) (.refl _) (fun r => ?_) (fun a => ?_)
  · rw [RingEquiv.refl_apply, RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra,
      ← RingEquiv.coe_toRingHom, ← RingEquiv.toRingHom_eq_coe, toRingHom_mapDomainRingEquiv,
      ← RingHom.comp_apply, ← mapDomainRingHom_comp]
    congr 2
    ext y
    simp
  · rw [RingEquiv.refl_apply, RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra,
      ← RingEquiv.coe_toRingHom, ← RingEquiv.toRingHom_eq_coe, toRingHom_mapDomainRingEquiv,
      ← RingHom.comp_apply, ← mapDomainRingHom_comp]
    congr 2
    ext z
    simp

end HalfSpaceAndGroupClosure

section FractionFieldAndNormality

variable {G : Type*} [AddCommGroup G]

/-- The canonical ring homomorphism from the algebra of the saturation of `S` inside
`AddSubgroup.closure (S : Set G)` into any fraction ring `K` of `R[S]`. -/
noncomputable def nsmulSaturationToFractionRing (S : AddSubmonoid G) (R K : Type*) [CommRing R]
    [CommRing K] [Algebra (AddMonoidAlgebra R S) K] [IsFractionRing (AddMonoidAlgebra R S) K] :
    AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid) →+*
      K :=
  (groupClosureToFractionRing S R K).comp
    (mapDomainRingHom R
      (AddSubmonoid.inclusion
        (inf_le_right :
          S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid ≤
            (AddSubgroup.closure (S : Set G)).toAddSubmonoid) :
        _ →+ AddSubgroup.closure (S : Set G)))

/-- `nsmulSaturationToFractionRing` extends `algebraMap (R[S]) K` along the inclusion of `S` into
its saturation inside `AddSubgroup.closure (S : Set G)`. -/
@[simp]
theorem nsmulSaturationToFractionRing_mapDomain_inclusion (S : AddSubmonoid G) (R K : Type*)
    [CommRing R] [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] (f : AddMonoidAlgebra R S) :
    nsmulSaturationToFractionRing S R K
        (mapDomain
          (AddSubmonoid.inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)) f) =
      algebraMap (AddMonoidAlgebra R S) K f := by
  have hcomp :
      ((AddSubmonoid.inclusion
          (inf_le_right :
            S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid ≤
              (AddSubgroup.closure (S : Set G)).toAddSubmonoid) :
          _ →+ AddSubgroup.closure (S : Set G)) : _ → _) ∘
        AddSubmonoid.inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure) =
      S.toGroupClosure :=
    funext fun s => Subtype.ext (S.coe_toGroupClosure s).symm
  simp [nsmulSaturationToFractionRing, mapDomain_mapDomain, hcomp]

/-- `nsmulSaturationToFractionRing` is injective. -/
theorem nsmulSaturationToFractionRing_injective (S : AddSubmonoid G) (R K : Type*) [CommRing R]
    [CommRing K] [Algebra (AddMonoidAlgebra R S) K] [IsFractionRing (AddMonoidAlgebra R S) K] :
    Function.Injective (nsmulSaturationToFractionRing S R K) :=
  (groupClosureToFractionRing_injective S R K).comp
    (mapDomain_injective (AddSubmonoid.inclusion_injective inf_le_right))

/-- **Integral closure of `R[S]` in its own fraction ring.** Over an integrally closed domain `R`,
for any finitely generated submonoid `S` of a torsion-free abelian group `G` and any fraction ring
`K` of `R[S]`, the algebra `R[S.nsmulSaturation ⊓ (AddSubgroup.closure S).toAddSubmonoid]` is the
integral closure of `R[S]` in `K`. -/
theorem isIntegralClosure_nsmulSaturation_inf_closure_fractionRing {R K : Type*} [CommRing R]
    [IsDomain R] [IsIntegrallyClosed R] [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG)
    [CommRing K] [Algebra (AddMonoidAlgebra R S) K] [IsFractionRing (AddMonoidAlgebra R S) K] :
    letI := (nsmulSaturationToFractionRing S R K).toAlgebra
    IsIntegralClosure
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      (AddMonoidAlgebra R S) K := by
  set A := AddMonoidAlgebra R S
  set B :=
    AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)
  set C := AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))
  let _ : Algebra A C := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  let _ : Algebra B C :=
    (mapDomainRingHom R
      (AddSubmonoid.inclusion
        (inf_le_right :
          S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid ≤
            (AddSubgroup.closure (S : Set G)).toAddSubmonoid) :
        _ →+ AddSubgroup.closure (S : Set G))).toAlgebra
  let _ : Algebra C K := (groupClosureToFractionRing S R K).toAlgebra
  let _ : Algebra B K := (nsmulSaturationToFractionRing S R K).toAlgebra
  have : IsScalarTower A C K := IsScalarTower.of_algebraMap_eq fun f =>
    (groupClosureToFractionRing_mapDomain_toGroupClosure S R K f).symm
  have : IsScalarTower B C K := IsScalarTower.of_algebraMap_eq fun f => by
    simp [RingHom.algebraMap_toAlgebra, nsmulSaturationToFractionRing]
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  have : IsFractionRing C K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (MonoidHom.mrange (of R S)) C K
  have := hS.moduleFinite_addSubgroup_closure
  have : Module.Free ℤ (AddSubgroup.closure (S : Set G)) := Module.free_of_finite_type_torsion_free'
  have : IsIntegrallyClosedIn C K :=
    (isIntegrallyClosed_iff_isIntegrallyClosedIn K).mp inferInstance
  have : IsIntegralClosure B A C := isIntegralClosure_nsmulSaturation_inf_closure hS
  exact IsIntegralClosure.of_isIntegralClosure_of_isIntegrallyClosedIn A B C K

/-- Over an integrally closed domain `R`, the image of `nsmulSaturationToFractionRing` in any
fraction ring `K` of `R[S]` equals the integral closure of `R[S]` in `K`. -/
theorem range_nsmulSaturationToFractionRing {R K : Type*} [CommRing R] [IsDomain R]
    [IsIntegrallyClosed R] [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG) [CommRing K]
    [Algebra (AddMonoidAlgebra R S) K] [IsFractionRing (AddMonoidAlgebra R S) K] :
    (nsmulSaturationToFractionRing S R K).range =
      (integralClosure (AddMonoidAlgebra R S) K).toSubring := by
  let := (nsmulSaturationToFractionRing S R K).toAlgebra
  have hIC := isIntegralClosure_nsmulSaturation_inf_closure_fractionRing (R := R) hS (K := K)
  ext x
  exact hIC.isIntegral_iff.symm

/-- Canonical `R[S]`-algebra isomorphism between
`R[S.nsmulSaturation ⊓ (AddSubgroup.closure S).toAddSubmonoid]` and the integral closure of `R[S]`
in its fraction ring `K` (for instance `K = FractionRing (AddMonoidAlgebra R S)`). -/
noncomputable def nsmulSaturationEquivIntegralClosure {R : Type*} [CommRing R] [IsDomain R]
    [IsIntegrallyClosed R] [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG) (K : Type*)
    [CommRing K] [Algebra (AddMonoidAlgebra R S) K] [IsFractionRing (AddMonoidAlgebra R S) K] :
    letI := (mapDomainRingHom R
      (AddSubmonoid.inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
    AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid) ≃ₐ[
        AddMonoidAlgebra R S]
      integralClosure (AddMonoidAlgebra R S) K :=
  letI := (mapDomainRingHom R
    (AddSubmonoid.inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
  letI := (nsmulSaturationToFractionRing S R K).toAlgebra
  haveI : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      K :=
    IsScalarTower.of_algebraMap_eq fun f =>
      (nsmulSaturationToFractionRing_mapDomain_inclusion S R K f).symm
  haveI := isIntegralClosure_nsmulSaturation_inf_closure_fractionRing (R := R) hS (K := K)
  IsIntegralClosure.equiv (AddMonoidAlgebra R S)
    (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) K
    (integralClosure (AddMonoidAlgebra R S) K)

/-- `nsmulSaturationEquivIntegralClosure` acts on `K` via `nsmulSaturationToFractionRing`. -/
@[simp]
theorem coe_nsmulSaturationEquivIntegralClosure {R : Type*} [CommRing R] [IsDomain R]
    [IsIntegrallyClosed R] [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG) (K : Type*)
    [CommRing K] [Algebra (AddMonoidAlgebra R S) K] [IsFractionRing (AddMonoidAlgebra R S) K]
    (f : AddMonoidAlgebra R
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) :
    (nsmulSaturationEquivIntegralClosure hS K f : K) =
      nsmulSaturationToFractionRing S R K f := by
  have h :
      algebraMap (integralClosure (AddMonoidAlgebra R S) K) K
          (nsmulSaturationEquivIntegralClosure hS K f) =
        nsmulSaturationToFractionRing S R K f := by
    rw [nsmulSaturationEquivIntegralClosure, IsIntegralClosure.algebraMap_equiv,
      RingHom.algebraMap_toAlgebra]
  simpa using h

/-- **Hochster's theorem for the saturation.** Over an integrally closed domain `R`, the semigroup
algebra of `S.nsmulSaturation` in a finitely generated torsion-free abelian group `L` is integrally
closed whenever `S` is finitely generated. -/
theorem isIntegrallyClosed_nsmulSaturation {R L : Type*} [CommRing R] [IsDomain R]
    [IsIntegrallyClosed R] [AddCommGroup L] [Module.Finite ℤ L] [HasUniqueDiv L]
    {S : AddSubmonoid L} (hS : S.FG) :
    IsIntegrallyClosed (AddMonoidAlgebra R S.nsmulSaturation) := by
  have : Module.Free ℤ L := Module.free_of_finite_type_torsion_free'
  let ι₁ := AddSubmonoid.inclusion S.le_nsmulSaturation
  let _ : Algebra (AddMonoidAlgebra R S) (AddMonoidAlgebra R S.nsmulSaturation) :=
    (mapDomainRingHom R ι₁).toAlgebra
  let _ : Algebra (AddMonoidAlgebra R S) (AddMonoidAlgebra R L) :=
    (mapDomainRingHom R S.subtype).toAlgebra
  let _ : Algebra (AddMonoidAlgebra R S.nsmulSaturation) (AddMonoidAlgebra R L) :=
    (mapDomainRingHom R S.nsmulSaturation.subtype).toAlgebra
  have : IsScalarTower (AddMonoidAlgebra R S) (AddMonoidAlgebra R S.nsmulSaturation)
      (AddMonoidAlgebra R L) :=
    IsScalarTower.of_algebraMap_eq fun f => by
      simp only [RingHom.algebraMap_toAlgebra, ← RingHom.comp_apply, ← mapDomainRingHom_comp,
        ι₁, AddSubmonoid.subtype_comp_inclusion]
  have : IsIntegralClosure (AddMonoidAlgebra R S.nsmulSaturation) (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R L) := isIntegralClosure_nsmulSaturation hS
  have : IsIntegrallyClosedIn (AddMonoidAlgebra R S.nsmulSaturation) (AddMonoidAlgebra R L) :=
    IsIntegrallyClosedIn.of_isIntegralClosure (AddMonoidAlgebra R S)
  have : FaithfulSMul (AddMonoidAlgebra R S.nsmulSaturation) (AddMonoidAlgebra R L) :=
    IsIntegralClosure.faithfulSMul (AddMonoidAlgebra R S) (AddMonoidAlgebra R S.nsmulSaturation)
      (AddMonoidAlgebra R L)
  exact IsIntegrallyClosed.of_isIntegrallyClosed_of_isIntegrallyClosedIn
    (AddMonoidAlgebra R S.nsmulSaturation) (AddMonoidAlgebra R L)

/-- Over an integrally closed domain `R`, the semigroup algebra of the saturation of `S` inside
`AddSubgroup.closure (S : Set G)` is integrally closed whenever `S` is finitely generated and `G`
is torsion-free. -/
theorem isIntegrallyClosed_nsmulSaturation_inf_closure {R : Type*} [CommRing R] [IsDomain R]
    [IsIntegrallyClosed R] [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG) :
    IsIntegrallyClosed (AddMonoidAlgebra R
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) := by
  have := hS.moduleFinite_addSubgroup_closure
  have hIC := isIntegrallyClosed_nsmulSaturation (R := R) hS.comap_subtype_closure
  exact IsIntegrallyClosed.of_equiv
    (mapDomainRingEquiv R S.nsmulSaturationInfClosureEquiv.symm) (h := hIC)

/-- **Hochster's theorem.** Over an integrally closed domain `R`, the semigroup algebra `R[S]` of a
finitely generated submonoid `S` of a torsion-free abelian group `G` is integrally closed when `S`
is saturated inside `AddSubgroup.closure (S : Set G)`. -/
theorem isIntegrallyClosed_of_nsmulSaturation_inf_closure_eq {R : Type*} [CommRing R] [IsDomain R]
    [IsIntegrallyClosed R] [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG)
    (hsat : S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S) :
    IsIntegrallyClosed (AddMonoidAlgebra R S) :=
  hsat ▸ isIntegrallyClosed_nsmulSaturation_inf_closure hS

/-- **Normality of a finitely generated semigroup algebra over a domain.** Over an integral domain
`R`, the semigroup algebra `R[S]` of a finitely generated submonoid `S` of a torsion-free abelian
group `G` is integrally closed if and only if `R` is integrally closed and `S` is saturated inside
`AddSubgroup.closure (S : Set G)`. -/
theorem isIntegrallyClosed_iff_nsmulSaturation_inf_closure_eq {R : Type*} [CommRing R] [IsDomain R]
    [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG) :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔
      IsIntegrallyClosed R ∧
        S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S := by
  refine ⟨fun h => ⟨isIntegrallyClosed_of_addMonoidAlgebra (M := S),
    S.nsmulSaturation_inf_closure_eq R⟩, fun ⟨_, hsat⟩ => ?_⟩
  exact isIntegrallyClosed_of_nsmulSaturation_inf_closure_eq hS hsat

/-- Variant of `AddMonoidAlgebra.isIntegrallyClosed_iff_nsmulSaturation_inf_closure_eq` phrased
using `NSMulSaturated` on the pullback of `S` to `AddSubgroup.closure (S : Set G)`. -/
theorem isIntegrallyClosed_iff_nsmulSaturated_comap {R : Type*} [CommRing R] [IsDomain R]
    [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG) :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔
      IsIntegrallyClosed R ∧ (S.comap (AddSubgroup.closure (S : Set G)).subtype).NSMulSaturated :=
  (isIntegrallyClosed_iff_nsmulSaturation_inf_closure_eq hS).trans
    (and_congr_right' S.nsmulSaturated_comap_subtype_closure_iff.symm)

/-- **Normality of a finitely generated semigroup algebra over a field.** Over a field `k`, the
semigroup algebra `k[S]` of a finitely generated submonoid `S` of a torsion-free abelian group `G`
is integrally closed if and only if `S` is saturated inside `AddSubgroup.closure (S : Set G)`. -/
theorem isIntegrallyClosed_field_iff_nsmulSaturation_inf_closure_eq {k : Type*} [Field k]
    [HasUniqueDiv G] {S : AddSubmonoid G} (hS : S.FG) :
    IsIntegrallyClosed (AddMonoidAlgebra k S) ↔
      S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S := by
  simpa [Field.instIsIntegrallyClosed k] using
    isIntegrallyClosed_iff_nsmulSaturation_inf_closure_eq (R := k) hS

/-- Variant of `AddMonoidAlgebra.isIntegrallyClosed_field_iff_nsmulSaturation_inf_closure_eq`
phrased using `NSMulSaturated` on the pullback of `S` to `AddSubgroup.closure (S : Set G)`. -/
theorem isIntegrallyClosed_field_iff_nsmulSaturated_comap {k : Type*} [Field k] [HasUniqueDiv G]
    {S : AddSubmonoid G} (hS : S.FG) :
    IsIntegrallyClosed (AddMonoidAlgebra k S) ↔
      (S.comap (AddSubgroup.closure (S : Set G)).subtype).NSMulSaturated :=
  (isIntegrallyClosed_field_iff_nsmulSaturation_inf_closure_eq hS).trans
    S.nsmulSaturated_comap_subtype_closure_iff.symm

end FractionFieldAndNormality

end AddMonoidAlgebra
