/-!
# Normality and normalization of semigroup algebras

Let `S` be an additive submonoid of a free abelian group `G` and `R` a commutative integral domain
(for instance a field `k`). Let `L_S = AddSubgroup.closure (S : Set G)` be the subgroup generated by
`S`, and let `K` be any fraction ring of `R[S]`.

Because `R[L_S]` is the localization of `R[S]` at all coefficient-one monomials
(`AddSubmonoid.isLocalization_addMonoidAlgebra_groupClosure`), and those monomials are
non-zero-divisors in `R[S]`, `R[L_S]` embeds canonically into `K`
(`AddSubmonoid.groupClosureRingHom`) and `K` is already a fraction ring of `R[L_S]`
(`AddSubmonoid.isFractionRing_groupClosure`) without enlarging `L_S` to the ambient lattice `G`.

When `R` is integrally closed, choosing a `ℤ`-basis of the free abelian group `L_S` identifies
`R[L_S]` with a Laurent polynomial ring (`TauCeti.LaurentRing.isIntegrallyClosed`), so `R[L_S]` is
integrally closed (`AddMonoidAlgebra.isIntegrallyClosed`). Combining this with the graded
characterization of integral elements in `R[L_S]` (`TauCeti.Algebra.MonoidAlgebra.Saturation`)
identifies the integral closure of `R[S]` in `K` with the semigroup algebra of the saturation of `S`
inside `L_S`, namely `S.nsmulSaturation ⊓ L_S.toAddSubmonoid`:

* `AddSubmonoid.isIntegralClosure_nsmulSaturation_inf_closure` and
  `AddSubmonoid.nsmulSaturationInfClosureAlgEquivIntegralClosure`: `R[sat_{L_S} S]` is the integral
  closure of `R[S]` in `K`.
* `AddSubmonoid.isIntegrallyClosed_addMonoidAlgebra_iff_and`: `R[S]` is integrally closed if and
  only if `R` is integrally closed and `S` is saturated inside `L_S` (with necessity of coefficient
  normality provided by `IsIntegrallyClosed.of_addMonoidAlgebra`, including when `S = ⊥`).
* `AddSubmonoid.isIntegrallyClosed_addMonoidAlgebra_iff` and
  `AddSubmonoid.isIntegrallyClosed_addMonoidAlgebra_iff_nsmulSaturated`: Hochster's normality
  criterion over an integrally closed domain (in particular over any field).
* `AddSubmonoid.FG.finite_integralClosure_addMonoidAlgebra`: finite normalization of `R[S]` in its
  fraction field when `S` is finitely generated.

## References

* M. Hochster, *Rings of invariants of tori, Cohen–Macaulay rings generated by monomials, and
  polytopes*, Annals of Mathematics **96** (1972), 318–337, Proposition 1.
* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 4, Theorem 4.40.
* W. Bruns and J. Herzog, *Cohen–Macaulay Rings*, §6.1, Theorem 6.1.4.
-/

public section

namespace IsIntegrallyClosed

/-- If a commutative monoid algebra `R[M]` is integrally closed, then so is its coefficient ring
`R`. -/
theorem of_monoidAlgebra (R M : Type*) [CommRing R] [CommMonoid M]
    [IsIntegrallyClosed (MonoidAlgebra R M)] : IsIntegrallyClosed R := by
  refine IsIntegrallyClosed.of_retract MonoidAlgebra.singleOneRingHom
    (MonoidAlgebra.augmentation R M) (fun r ↦ MonoidAlgebra.augmentation_single R 1 r) ?_
  intro r hr
  rw [Submonoid.mem_comap, mem_nonZeroDivisors_iff_left]
  intro f hf
  ext m
  refine mem_nonZeroDivisors_iff_left.mp hr (f.coeff m) ?_
  have hsmul : r • f = 0 := by rwa [Algebra.smul_def]
  simpa using congr(($hsmul).coeff m)

/-- If a commutative additive monoid algebra `R[M]` is integrally closed, then so is its coefficient
ring `R`. -/
theorem of_addMonoidAlgebra (R M : Type*) [CommRing R] [AddCommMonoid M]
    [IsIntegrallyClosed (AddMonoidAlgebra R M)] : IsIntegrallyClosed R := by
  have := IsIntegrallyClosed.of_equiv (AddMonoidAlgebra.toMultiplicative R M)
  exact IsIntegrallyClosed.of_monoidAlgebra R (Multiplicative M)

end IsIntegrallyClosed

namespace AddMonoidAlgebra

/-- In the algebra of a right-cancellative commutative additive monoid, every coefficient-one
monomial is a non-zero-divisor. -/
theorem single_one_mem_nonZeroDivisors {R M : Type*} [CommRing R] [AddCommMonoid M]
    [IsRightCancelAdd M] (m : M) :
    single m (1 : R) ∈ nonZeroDivisors (AddMonoidAlgebra R M) := by
  rw [mem_nonZeroDivisors_iff_right]
  intro f hf
  ext a
  have h := congr(($hf).coeff (a + m))
  rwa [coeff_mul_single_eq_coeff_mul a (fun _ _ ↦ add_left_inj m), mul_one, coeff_zero] at h

/-- All coefficient-one monomials of a right-cancellative additive monoid algebra are
non-zero-divisors. -/
theorem mrange_of_le_nonZeroDivisors {R M : Type*} [CommRing R] [AddCommMonoid M]
    [IsRightCancelAdd M] :
    MonoidHom.mrange (of R M) ≤ nonZeroDivisors (AddMonoidAlgebra R M) := by
  rintro _ ⟨m, rfl⟩
  exact single_one_mem_nonZeroDivisors m.toAdd

/-- The group algebra `R[G]` of a free abelian group `G` over an integrally closed domain `R` is
integrally closed. -/
instance isIntegrallyClosed {R G : Type*} [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    [AddCommGroup G] [Module.Free ℤ G] : IsIntegrallyClosed (AddMonoidAlgebra R G) := by
  let e : (Module.Free.ChooseBasisIndex ℤ G →₀ ℤ) ≃+ G :=
    (Module.Free.chooseBasis ℤ G).repr.symm.toAddEquiv
  exact IsIntegrallyClosed.of_equiv (mapDomainRingEquiv R e)

end AddMonoidAlgebra

namespace AddSubmonoid

open AddMonoidAlgebra

section Localization

variable {G : Type*} [AddCommGroup G] (S : AddSubmonoid G) (R : Type*) [CommRing R]
  (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
  [IsFractionRing (AddMonoidAlgebra R S) K]

/-- The canonical ring homomorphism from the generated-group algebra `R[L_S]` into any fraction ring
`K` of `R[S]`, extending `algebraMap R[S] K` across the monomial localization
`AddSubmonoid.isLocalization_addMonoidAlgebra_groupClosure`. -/
noncomputable def groupClosureRingHom :
    AddMonoidAlgebra R (AddSubgroup.closure (S : Set G)) →+* K :=
  letI := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  haveI := S.isLocalization_addMonoidAlgebra_groupClosure R
  (Localization.mapToFractionRing K (MonoidHom.mrange (of R S))
    (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G)))
    mrange_of_le_nonZeroDivisors).toRingHom

/-- `groupClosureRingHom` restricts along `S.toGroupClosure` to `algebraMap R[S] K`. -/
@[simp]
theorem groupClosureRingHom_comp_mapDomainRingHom :
    (S.groupClosureRingHom R K).comp (mapDomainRingHom R S.toGroupClosure) =
      algebraMap (AddMonoidAlgebra R S) K := by
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  refine RingHom.ext fun x ↦ ?_
  exact (Localization.mapToFractionRing K (MonoidHom.mrange (of R S))
    (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G)))
    mrange_of_le_nonZeroDivisors).commutes x

/-- `groupClosureRingHom` agrees with `algebraMap R[S] K` on elements mapped from `R[S]`. -/
@[simp]
theorem groupClosureRingHom_mapDomain_toGroupClosure (x : AddMonoidAlgebra R S) :
    S.groupClosureRingHom R K (mapDomain S.toGroupClosure x) =
      algebraMap (AddMonoidAlgebra R S) K x :=
  RingHom.congr_fun (S.groupClosureRingHom_comp_mapDomainRingHom R K) x

/-- `groupClosureRingHom` sends monomials coming from `S` to their images under
`algebraMap R[S] K`. -/
@[simp]
theorem groupClosureRingHom_single_toGroupClosure (a : S) (c : R) :
    S.groupClosureRingHom R K (single (S.toGroupClosure a) c) =
      algebraMap (AddMonoidAlgebra R S) K (single a c) := by
  rw [← mapDomain_single, S.groupClosureRingHom_mapDomain_toGroupClosure]

/-- Any fraction ring `K` of `R[S]` is also a fraction ring of the generated-group algebra
`R[L_S]` along `AddSubmonoid.groupClosureRingHom`. -/
theorem isFractionRing_groupClosure :
    letI := (S.groupClosureRingHom R K).toAlgebra
    IsFractionRing (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K := by
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  let := (S.groupClosureRingHom R K).toAlgebra
  have := S.isLocalization_addMonoidAlgebra_groupClosure R
  have : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K :=
    IsScalarTower.of_algebraMap_eq' (S.groupClosureRingHom_comp_mapDomainRingHom R K).symm
  exact IsFractionRing.isFractionRing_of_isLocalization (MonoidHom.mrange (of R S))
    (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K mrange_of_le_nonZeroDivisors

/-- The canonical map from `R[L_S]` into a fraction ring `K` of `R[S]` is injective. -/
theorem groupClosureRingHom_injective : Function.Injective (S.groupClosureRingHom R K) := by
  let := (S.groupClosureRingHom R K).toAlgebra
  have := S.isFractionRing_groupClosure R K
  exact IsFractionRing.injective (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K

/-- The canonical inclusion `(S.nsmulSaturation ⊓ L_S) →+ L_S`. -/
def nsmulSaturationInfClosureToGroupClosure :
    ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid) →+
      AddSubgroup.closure (S : Set G) :=
  (S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid).subtype.codRestrict
    (AddSubgroup.closure (S : Set G)) fun t ↦ t.2.2

/-- The canonical inclusion `(S.nsmulSaturation ⊓ L_S) →+ L_S` is injective. -/
theorem nsmulSaturationInfClosureToGroupClosure_injective :
    Function.Injective S.nsmulSaturationInfClosureToGroupClosure :=
  fun _ _ h ↦ Subtype.ext (congrArg (fun z : AddSubgroup.closure (S : Set G) ↦ (z : G)) h)

/-- Composing `nsmulSaturationInfClosureToGroupClosure` with the inclusion of `S` yields
`S.toGroupClosure`. -/
@[simp]
theorem nsmulSaturationInfClosureToGroupClosure_comp_inclusion :
    S.nsmulSaturationInfClosureToGroupClosure.comp
      (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)) = S.toGroupClosure := by
  ext s
  simp [nsmulSaturationInfClosureToGroupClosure]
  rfl

/-- The canonical ring homomorphism from the generated-lattice saturation algebra
`R[S.nsmulSaturation ⊓ L_S]` into any fraction ring `K` of `R[S]`. -/
noncomputable def nsmulSaturationInfClosureRingHom :
    AddMonoidAlgebra R
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid) →+* K :=
  (S.groupClosureRingHom R K).comp (mapDomainRingHom R S.nsmulSaturationInfClosureToGroupClosure)

/-- `nsmulSaturationInfClosureRingHom` restricts on `R[S]` to `algebraMap R[S] K`. -/
@[simp]
theorem nsmulSaturationInfClosureRingHom_comp_mapDomainRingHom :
    (S.nsmulSaturationInfClosureRingHom R K).comp
      (mapDomainRingHom R (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))) =
      algebraMap (AddMonoidAlgebra R S) K := by
  rw [nsmulSaturationInfClosureRingHom, RingHom.comp_assoc, ← mapDomainRingHom_comp,
    nsmulSaturationInfClosureToGroupClosure_comp_inclusion,
    groupClosureRingHom_comp_mapDomainRingHom]

/-- `nsmulSaturationInfClosureRingHom` agrees with `algebraMap R[S] K` on elements mapped from
`R[S]`. -/
@[simp]
theorem nsmulSaturationInfClosureRingHom_mapDomain_inclusion (x : AddMonoidAlgebra R S) :
    S.nsmulSaturationInfClosureRingHom R K
      (mapDomain (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)) x) =
      algebraMap (AddMonoidAlgebra R S) K x :=
  RingHom.congr_fun (S.nsmulSaturationInfClosureRingHom_comp_mapDomainRingHom R K) x

/-- `nsmulSaturationInfClosureRingHom` sends monomials coming from `S` to their images under
`algebraMap R[S] K`. -/
@[simp]
theorem nsmulSaturationInfClosureRingHom_single_inclusion (a : S) (c : R) :
    S.nsmulSaturationInfClosureRingHom R K
      (single (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure) a) c) =
      algebraMap (AddMonoidAlgebra R S) K (single a c) := by
  rw [← mapDomain_single, S.nsmulSaturationInfClosureRingHom_mapDomain_inclusion]

/-- The canonical map from `R[S.nsmulSaturation ⊓ L_S]` into a fraction ring `K` of `R[S]` is
injective. -/
theorem nsmulSaturationInfClosureRingHom_injective :
    Function.Injective (S.nsmulSaturationInfClosureRingHom R K) :=
  (S.groupClosureRingHom_injective R K).comp
    (mapDomain_injective S.nsmulSaturationInfClosureToGroupClosure_injective)

/-- When `S` generates the ambient group `G`, the saturation algebra `R[sat S]` embeds canonically
into any fraction ring `K` of `R[S]`. -/
noncomputable def nsmulSaturationRingHom (hG : AddSubgroup.closure (S : Set G) = ⊤) :
    AddMonoidAlgebra R S.nsmulSaturation →+* K :=
  (S.nsmulSaturationInfClosureRingHom R K).comp
    (mapDomainRingHom R
      (inclusion (le_inf le_rfl fun x _ ↦ hG.symm ▸ AddSubgroup.mem_top x)))

/-- `nsmulSaturationRingHom` restricts on `R[S]` to `algebraMap R[S] K`. -/
@[simp]
theorem nsmulSaturationRingHom_comp_mapDomainRingHom
    (hG : AddSubgroup.closure (S : Set G) = ⊤) :
    (S.nsmulSaturationRingHom R K hG).comp
      (mapDomainRingHom R (inclusion S.le_nsmulSaturation)) =
      algebraMap (AddMonoidAlgebra R S) K := by
  rw [nsmulSaturationRingHom, RingHom.comp_assoc, ← mapDomainRingHom_comp]
  exact S.nsmulSaturationInfClosureRingHom_comp_mapDomainRingHom R K

/-- `nsmulSaturationRingHom` agrees with `algebraMap R[S] K` on elements mapped from `R[S]`. -/
@[simp]
theorem nsmulSaturationRingHom_mapDomain_inclusion
    (hG : AddSubgroup.closure (S : Set G) = ⊤) (x : AddMonoidAlgebra R S) :
    S.nsmulSaturationRingHom R K hG (mapDomain (inclusion S.le_nsmulSaturation) x) =
      algebraMap (AddMonoidAlgebra R S) K x :=
  RingHom.congr_fun (S.nsmulSaturationRingHom_comp_mapDomainRingHom R K hG) x

end Localization

section FreeGroup

variable {G : Type*} [AddCommGroup G] [Module.Free ℤ G] (S : AddSubmonoid G)
  (R : Type*) [CommRing R]

/-- Over a reduced ring `R`, the generated-lattice saturation algebra `R[S.nsmulSaturation ⊓ L_S]`
is the integral closure of `R[S]` inside `R[L_S]`. -/
theorem isIntegralClosure_nsmulSaturation_inf_closure_in_groupClosure [IsReduced R] :
    letI := (mapDomainRingHom R S.toGroupClosure).toAlgebra
    letI := (mapDomainRingHom R S.nsmulSaturationInfClosureToGroupClosure).toAlgebra
    IsIntegralClosure
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) := by
  have := (AddSubgroup.closure (S : Set G)).free_int
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  let := (mapDomainRingHom R S.nsmulSaturationInfClosureToGroupClosure).toAlgebra
  refine ⟨mapDomain_injective S.nsmulSaturationInfClosureToGroupClosure_injective, fun {x} ↦ ?_⟩
  rw [IsIntegral, RingHom.algebraMap_toAlgebra, isIntegralElem_iff_forall_mem_support,
    S.mrange_toGroupClosure, nsmulSaturation_comap, RingHom.algebraMap_toAlgebra]
  simp only [mapDomainRingHom_apply, ← Set.mem_range,
    mem_range_mapDomain_iff S.nsmulSaturationInfClosureToGroupClosure_injective]
  refine forall₂_congr fun g _ ↦ ⟨fun hg ↦ ⟨⟨g.1, hg, g.2⟩, rfl⟩, ?_⟩
  rintro ⟨t, rfl⟩
  exact t.2.1

variable [IsDomain R]

/-- **The integral closure of a semigroup algebra in its own fraction field.** Over an integrally
closed domain `R` (in particular over any field), the algebra of `S.nsmulSaturation ⊓ L_S` — the
saturation of `S` inside its generated lattice `L_S`, without enlarging the lattice — is the
integral closure of `R[S]` in any fraction ring `K` of `R[S]`. -/
theorem isIntegralClosure_nsmulSaturation_inf_closure [IsIntegrallyClosed R]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    letI := (S.nsmulSaturationInfClosureRingHom R K).toAlgebra
    IsIntegralClosure
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      (AddMonoidAlgebra R S) K := by
  have := (AddSubgroup.closure (S : Set G)).free_int
  let := (mapDomainRingHom R S.toGroupClosure).toAlgebra
  let := (mapDomainRingHom R S.nsmulSaturationInfClosureToGroupClosure).toAlgebra
  let := (S.groupClosureRingHom R K).toAlgebra
  let := (S.nsmulSaturationInfClosureRingHom R K).toAlgebra
  have : IsScalarTower
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K :=
    IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K :=
    IsScalarTower.of_algebraMap_eq' (S.groupClosureRingHom_comp_mapDomainRingHom R K).symm
  have := S.isIntegralClosure_nsmulSaturation_inf_closure_in_groupClosure R
  have := S.isFractionRing_groupClosure R K
  exact IsIntegralClosure.of_isIntegralClosure_of_isIntegrallyClosedIn
    (AddMonoidAlgebra R S)
    (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
    (AddMonoidAlgebra R (AddSubgroup.closure (S : Set G))) K

/-- **Normalization isomorphism for semigroup algebras.** Over an integrally closed domain `R`, the
saturation algebra `R[S.nsmulSaturation ⊓ L_S]` is canonically isomorphic as an `R[S]`-algebra to
`integralClosure R[S] K` for any fraction ring `K` of `R[S]`. -/
noncomputable def nsmulSaturationInfClosureAlgEquivIntegralClosure [IsIntegrallyClosed R]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K] :
    letI := (mapDomainRingHom R
      (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
    AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)
      ≃ₐ[AddMonoidAlgebra R S] integralClosure (AddMonoidAlgebra R S) K := by
  letI := (mapDomainRingHom R
    (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
  letI := (S.nsmulSaturationInfClosureRingHom R K).toAlgebra
  haveI : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      K :=
    IsScalarTower.of_algebraMap_eq'
      (S.nsmulSaturationInfClosureRingHom_comp_mapDomainRingHom R K).symm
  haveI := S.isIntegralClosure_nsmulSaturation_inf_closure R K
  exact IsIntegralClosure.equiv (AddMonoidAlgebra R S)
    (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
    K (integralClosure (AddMonoidAlgebra R S) K)

/-- `nsmulSaturationInfClosureAlgEquivIntegralClosure` acts on underlying elements of `K` via
`nsmulSaturationInfClosureRingHom`. -/
@[simp]
theorem coe_nsmulSaturationInfClosureAlgEquivIntegralClosure [IsIntegrallyClosed R]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K]
    (x : AddMonoidAlgebra R
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) :
    (S.nsmulSaturationInfClosureAlgEquivIntegralClosure R K x : K) =
      S.nsmulSaturationInfClosureRingHom R K x := by
  let := (mapDomainRingHom R
    (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
  let := (S.nsmulSaturationInfClosureRingHom R K).toAlgebra
  have : IsScalarTower (AddMonoidAlgebra R S)
      (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
      K :=
    IsScalarTower.of_algebraMap_eq'
      (S.nsmulSaturationInfClosureRingHom_comp_mapDomainRingHom R K).symm
  have := S.isIntegralClosure_nsmulSaturation_inf_closure R K
  exact IsIntegralClosure.algebraMap_equiv (AddMonoidAlgebra R S)
    (AddMonoidAlgebra R ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))
    K (integralClosure (AddMonoidAlgebra R S) K) x

/-- **Normality iff coefficient normality and semigroup saturation.** For a submonoid `S` of a free
abelian group `G` and an integral domain `R`, the semigroup algebra `R[S]` is integrally closed if
and only if `R` is integrally closed and `S` is saturated inside the subgroup `L_S` it generates. -/
theorem isIntegrallyClosed_addMonoidAlgebra_iff_and :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔
      IsIntegrallyClosed R ∧
        S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S := by
  refine ⟨fun h ↦ ⟨IsIntegrallyClosed.of_addMonoidAlgebra R S,
    S.nsmulSaturation_inf_closure_eq R⟩, ?_⟩
  rintro ⟨hR, hS⟩
  rw [isIntegrallyClosed_iff (FractionRing (AddMonoidAlgebra R S))]
  intro x hx
  let := (S.nsmulSaturationInfClosureRingHom R
    (FractionRing (AddMonoidAlgebra R S))).toAlgebra
  have := S.isIntegralClosure_nsmulSaturation_inf_closure R
    (FractionRing (AddMonoidAlgebra R S))
  obtain ⟨y, rfl⟩ := (IsIntegralClosure.isIntegral_iff
    (A := AddMonoidAlgebra R
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid))).mp hx
  have hsurj : Function.Surjective
      (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)) :=
    fun t ↦ ⟨⟨t.1, hS.le t.2⟩, rfl⟩
  obtain ⟨z, rfl⟩ := mapDomain_surjective hsurj y
  exact ⟨z, (S.nsmulSaturationInfClosureRingHom_mapDomain_inclusion R _ z).symm⟩

/-- **Hochster's normality criterion.** Over an integrally closed domain `R` (for instance a field),
the semigroup algebra `R[S]` of a submonoid `S` of a free abelian group `G` is integrally closed if
and only if `S` is saturated inside the subgroup `AddSubgroup.closure S` it generates. -/
theorem isIntegrallyClosed_addMonoidAlgebra_iff [IsIntegrallyClosed R] :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔
      S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid = S := by
  rw [S.isIntegrallyClosed_addMonoidAlgebra_iff_and R, and_iff_right ‹_›]

/-- Over an integrally closed domain `R`, `R[S]` is integrally closed if and only if the pullback of
`S` to its generated subgroup `AddSubgroup.closure S` is `NSMulSaturated`. -/
theorem isIntegrallyClosed_addMonoidAlgebra_iff_comap_nsmulSaturated [IsIntegrallyClosed R] :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔
      (S.comap (AddSubgroup.closure (S : Set G)).subtype).NSMulSaturated := by
  rw [S.isIntegrallyClosed_addMonoidAlgebra_iff R,
    nsmulSaturated_comap_addSubgroup_subtype_iff AddSubgroup.subset_closure]

/-- If `S` is `NSMulSaturated` in the ambient free abelian group `G` and `R` is an integrally closed
domain, then `R[S]` is integrally closed. -/
theorem NSMulSaturated.isIntegrallyClosed_addMonoidAlgebra [IsIntegrallyClosed R]
    {S : AddSubmonoid G} (hS : S.NSMulSaturated) :
    IsIntegrallyClosed (AddMonoidAlgebra R S) :=
  (S.isIntegrallyClosed_addMonoidAlgebra_iff_comap_nsmulSaturated R).mpr (hS.comap _)

/-- **Finite normalization of affine semigroup algebras.** Over an integrally closed domain `R` (in
particular over any field), if `S` is a finitely generated submonoid of a free abelian group `G`,
then the integral closure of `R[S]` in any fraction ring `K` of `R[S]` is a finitely generated
`R[S]`-module. -/
theorem FG.finite_integralClosure_addMonoidAlgebra [IsIntegrallyClosed R]
    {S : AddSubmonoid G} (hS : S.FG) (K : Type*) [CommRing K]
    [Algebra (AddMonoidAlgebra R S) K] [IsFractionRing (AddMonoidAlgebra R S) K] :
    Module.Finite (AddMonoidAlgebra R S) (integralClosure (AddMonoidAlgebra R S) K) := by
  let := (mapDomainRingHom R
    (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))).toAlgebra
  have : Module.Finite (AddMonoidAlgebra R S) (AddMonoidAlgebra R
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) :=
    hS.finite_mapDomainRingHom_inclusion_nsmulSaturation_inf_closure R
  exact Module.Finite.equiv (S.nsmulSaturationInfClosureAlgEquivIntegralClosure R K).toLinearEquiv

section SpanningLattice

/-- When `S` generates the free abelian group `G` and `R` is an integrally closed domain, `R[sat S]`
is the integral closure of `R[S]` in any fraction ring `K` of `R[S]`. -/
theorem isIntegralClosure_nsmulSaturation_of_closure_eq_top [IsIntegrallyClosed R]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K]
    (hG : AddSubgroup.closure (S : Set G) = ⊤) :
    letI := (S.nsmulSaturationRingHom R K hG).toAlgebra
    IsIntegralClosure (AddMonoidAlgebra R S.nsmulSaturation) (AddMonoidAlgebra R S) K := by
  let := (S.nsmulSaturationRingHom R K hG).toAlgebra
  let := (S.nsmulSaturationInfClosureRingHom R K).toAlgebra
  have hIC := S.isIntegralClosure_nsmulSaturation_inf_closure R K
  let j : S.nsmulSaturation →+
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid) :=
    inclusion (le_inf le_rfl fun x _ ↦ hG.symm ▸ AddSubgroup.mem_top x)
  refine ⟨(S.nsmulSaturationInfClosureRingHom_injective R K).comp
    (mapDomain_injective (inclusion_injective _)), fun {x} ↦ ?_⟩
  rw [hIC.isIntegral_iff]
  refine ⟨?_, fun ⟨y, hy⟩ ↦ ⟨mapDomain j y, hy⟩⟩
  rintro ⟨y, rfl⟩
  obtain ⟨z, rfl⟩ := mapDomain_surjective (f := j) (fun t ↦ ⟨⟨t.1, t.2.1⟩, rfl⟩) y
  exact ⟨z, rfl⟩

/-- When `S` generates the free abelian group `G` and `R` is an integrally closed domain, `R[sat S]`
is canonically isomorphic as an `R[S]`-algebra to `integralClosure R[S] K`. -/
noncomputable def nsmulSaturationAlgEquivIntegralClosure [IsIntegrallyClosed R]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K]
    (hG : AddSubgroup.closure (S : Set G) = ⊤) :
    letI := (mapDomainRingHom R (inclusion S.le_nsmulSaturation)).toAlgebra
    AddMonoidAlgebra R S.nsmulSaturation ≃ₐ[AddMonoidAlgebra R S]
      integralClosure (AddMonoidAlgebra R S) K := by
  letI := (mapDomainRingHom R (inclusion S.le_nsmulSaturation)).toAlgebra
  letI := (S.nsmulSaturationRingHom R K hG).toAlgebra
  haveI : IsScalarTower (AddMonoidAlgebra R S) (AddMonoidAlgebra R S.nsmulSaturation) K :=
    IsScalarTower.of_algebraMap_eq' (S.nsmulSaturationRingHom_comp_mapDomainRingHom R K hG).symm
  haveI := S.isIntegralClosure_nsmulSaturation_of_closure_eq_top R K hG
  exact IsIntegralClosure.equiv (AddMonoidAlgebra R S)
    (AddMonoidAlgebra R S.nsmulSaturation) K (integralClosure (AddMonoidAlgebra R S) K)

/-- `nsmulSaturationAlgEquivIntegralClosure` acts on underlying elements of `K` via
`nsmulSaturationRingHom`. -/
@[simp]
theorem coe_nsmulSaturationAlgEquivIntegralClosure [IsIntegrallyClosed R]
    (K : Type*) [CommRing K] [Algebra (AddMonoidAlgebra R S) K]
    [IsFractionRing (AddMonoidAlgebra R S) K]
    (hG : AddSubgroup.closure (S : Set G) = ⊤) (x : AddMonoidAlgebra R S.nsmulSaturation) :
    (S.nsmulSaturationAlgEquivIntegralClosure R K hG x : K) =
      S.nsmulSaturationRingHom R K hG x := by
  let := (mapDomainRingHom R (inclusion S.le_nsmulSaturation)).toAlgebra
  let := (S.nsmulSaturationRingHom R K hG).toAlgebra
  have : IsScalarTower (AddMonoidAlgebra R S) (AddMonoidAlgebra R S.nsmulSaturation) K :=
    IsScalarTower.of_algebraMap_eq' (S.nsmulSaturationRingHom_comp_mapDomainRingHom R K hG).symm
  have := S.isIntegralClosure_nsmulSaturation_of_closure_eq_top R K hG
  exact IsIntegralClosure.algebraMap_equiv (AddMonoidAlgebra R S)
    (AddMonoidAlgebra R S.nsmulSaturation) K (integralClosure (AddMonoidAlgebra R S) K) x

/-- When `S` generates the free abelian group `G`, `R[S]` is integrally closed if and only if `R` is
integrally closed and `S` is `NSMulSaturated` in `G`. -/
theorem isIntegrallyClosed_addMonoidAlgebra_iff_and_nsmulSaturated
    (hG : AddSubgroup.closure (S : Set G) = ⊤) :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔ IsIntegrallyClosed R ∧ S.NSMulSaturated := by
  rw [S.isIntegrallyClosed_addMonoidAlgebra_iff_and R, hG, AddSubgroup.top_toAddSubmonoid,
    inf_top_eq, nsmulSaturation_eq_self_iff]

/-- When `S` generates the free abelian group `G` and `R` is an integrally closed domain, `R[S]` is
integrally closed if and only if `S` is `NSMulSaturated` in `G`. -/
theorem isIntegrallyClosed_addMonoidAlgebra_iff_nsmulSaturated [IsIntegrallyClosed R]
    (hG : AddSubgroup.closure (S : Set G) = ⊤) :
    IsIntegrallyClosed (AddMonoidAlgebra R S) ↔ S.NSMulSaturated := by
  rw [S.isIntegrallyClosed_addMonoidAlgebra_iff_and_nsmulSaturated R hG, and_iff_right ‹_›]

end SpanningLattice

