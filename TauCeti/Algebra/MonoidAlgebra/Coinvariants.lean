/-!
# Coinvariants of monoid-algebra modules over arbitrary rings

For a possibly noncommutative ring `Λ`, a monoid `G`, and a left `Λ[G]`-module `P` with a left
`Λ`-module structure, `TauCeti.Coinvariants Λ G P` is `P ⧸ Coinvariants.ker Λ G P`, where
`Coinvariants.ker` is spanned by `single g 1 • p - p`. The semilinear universal property,
functoriality, and finiteness/projectivity descent further assume `[IsScalarTower Λ Λ[G] P]`.
Defining `Coinvariants` directly as a `Submodule.Quotient` (adapting `Representation.Coinvariants`
and `TauCeti.BalancedExtension`) avoids `[CommRing Λ]` and keeps the canonical `Module ℤ` instance
at `Λ = ℤ`.

## Main definitions and results

* `TauCeti.Coinvariants.ker`, `TauCeti.Coinvariants`, `TauCeti.Coinvariants.mk`: the coinvariant
  quotient `P_G = P ⧸ ⟨single g 1 • p - p⟩` and its quotient map.
* `TauCeti.Coinvariants.lift`, `TauCeti.Coinvariants.liftSemilinear`,
  `TauCeti.Coinvariants.balancedExtensionEquiv`, `TauCeti.Coinvariants.map`,
  `TauCeti.Coinvariants.congr`, `TauCeti.Coinvariants.piEquiv`: universal properties, comparison
  with `TauCeti.BalancedExtension (augmentation Λ G) P`, functoriality, and identification
  `Coinvariants Λ G (ι → Λ[G]) ≃ₗ[Λ] (ι → Λ)` for finite `ι`.
* `Module.Finite` and `Module.Projective` over `Λ[G]` descend to `Coinvariants Λ G P` over `Λ`.

## References

* The Stacks Project, Section 64.15; K. S. Brown, *Cohomology of Groups*, Chapter II, Section 2.
-/

public section

noncomputable section

open MonoidAlgebra

namespace TauCeti

section Basic

variable (Λ G P : Type*) [Ring Λ] [Monoid G] [AddCommGroup P] [Module Λ P] [Module Λ[G] P]

/-- The `Λ`-submodule of `P` generated by all differences `single g 1 • p - p` for `g : G` and
`p : P`. -/
def Coinvariants.ker : Submodule Λ P :=
  Submodule.span Λ (Set.range fun gp : G × P ↦ single gp.1 (1 : Λ) • gp.2 - gp.2)

/-- **The `G`-coinvariant left `Λ`-module** `P_G = P ⧸ ⟨single g 1 • p - p⟩` of a left
`Λ[G]`-module `P` over an arbitrary ring `Λ`. -/
def Coinvariants : Type _ := P ⧸ Coinvariants.ker Λ G P

namespace Coinvariants

theorem ker_def :
    ker Λ G P = Submodule.span Λ (Set.range fun gp : G × P ↦ single gp.1 (1 : Λ) • gp.2 - gp.2) :=
  by rfl

variable {Λ G P} in
theorem ker_le_iff {S : Submodule Λ P} :
    ker Λ G P ≤ S ↔ ∀ (g : G) (p : P), single g (1 : Λ) • p - p ∈ S := by
  rw [ker_def, Submodule.span_le, Set.range_subset_iff]; exact Prod.forall

instance : AddCommGroup (Coinvariants Λ G P) := inferInstanceAs <| AddCommGroup (P ⧸ ker Λ G P)
instance : Module Λ (Coinvariants Λ G P) := inferInstanceAs <| Module Λ (P ⧸ ker Λ G P)
instance [Subsingleton P] : Subsingleton (Coinvariants Λ G P) :=
  inferInstanceAs <| Subsingleton (P ⧸ ker Λ G P)

variable {Λ G P} in
theorem sub_mem_ker (g : G) (p : P) : single g (1 : Λ) • p - p ∈ ker Λ G P :=
  Submodule.subset_span ⟨(g, p), rfl⟩

/-- The quotient map `P →ₗ[Λ] Coinvariants Λ G P`. -/
def mk : P →ₗ[Λ] Coinvariants Λ G P := (ker Λ G P).mkQ

variable {Λ G P}

theorem mk_surjective : Function.Surjective (mk Λ G P) := Submodule.mkQ_surjective (ker Λ G P)

instance [Module.Finite Λ P] : Module.Finite Λ (Coinvariants Λ G P) :=
  .of_surjective (mk Λ G P) mk_surjective

@[elab_as_elim]
theorem induction_on {motive : Coinvariants Λ G P → Prop} (x : Coinvariants Λ G P)
    (h : ∀ p : P, motive (mk Λ G P p)) : motive x := by
  obtain ⟨p, rfl⟩ := mk_surjective x; exact h p

@[simp] theorem ker_mk : LinearMap.ker (mk Λ G P) = ker Λ G P := Submodule.ker_mkQ (ker Λ G P)

@[simp] theorem mk_eq_zero {p : P} : mk Λ G P p = 0 ↔ p ∈ ker Λ G P :=
  Submodule.Quotient.mk_eq_zero (ker Λ G P)

theorem mk_eq_iff {p q : P} : mk Λ G P p = mk Λ G P q ↔ p - q ∈ ker Λ G P :=
  Submodule.Quotient.eq (ker Λ G P)

@[simp] theorem mk_single_one_smul (g : G) (p : P) : mk Λ G P (single g (1 : Λ) • p) = mk Λ G P p :=
  mk_eq_iff.2 (sub_mem_ker g p)

section Lift

variable {Q : Type*} [AddCommGroup Q] [Module Λ Q]

@[ext]
theorem hom_ext {f g : Coinvariants Λ G P →ₗ[Λ] Q} (h : ∀ p, f (mk Λ G P p) = g (mk Λ G P p)) :
    f = g := by ext x; obtain ⟨p, rfl⟩ := mk_surjective x; exact h p

/-- Universal property of `Coinvariants`: any `Λ`-linear map `f : P →ₗ[Λ] Q` invariant under the
action of every `g : G` descends to `Coinvariants Λ G P →ₗ[Λ] Q`. -/
def lift (f : P →ₗ[Λ] Q) (hf : ∀ (g : G) (p : P), f (single g (1 : Λ) • p) = f p) :
    Coinvariants Λ G P →ₗ[Λ] Q :=
  (ker Λ G P).liftQ f <| ker_le_iff.2 fun g p ↦ by rw [LinearMap.mem_ker, map_sub, hf, sub_self]

@[simp]
theorem lift_mk (f : P →ₗ[Λ] Q) (hf : ∀ (g : G) (p : P), f (single g (1 : Λ) • p) = f p) (p : P) :
    lift f hf (mk Λ G P p) = f p := by rfl

@[simp]
theorem lift_comp_mk (f : P →ₗ[Λ] Q) (hf : ∀ (g : G) (p : P), f (single g (1 : Λ) • p) = f p) :
    lift f hf ∘ₗ mk Λ G P = f := by ext p; rfl

end Lift

end Coinvariants

end Basic

namespace Coinvariants

section ScalarTower

variable {Λ G P : Type*} [Ring Λ] [Monoid G] [AddCommGroup P] [Module Λ P]
  [Module Λ[G] P] [IsScalarTower Λ Λ[G] P]

/-- On `Coinvariants Λ G P`, the `Λ[G]`-action reduces to scalar multiplication by the
augmentation. -/
@[simp]
theorem mk_smul (r : Λ[G]) (p : P) : mk Λ G P (r • p) = augmentation Λ G r • mk Λ G P p := by
  induction r using induction_linear with
  | zero => simp
  | add x y hx hy => rw [add_smul, map_add, map_add, add_smul, hx, hy]
  | single g c =>
    rw [TauCeti.MonoidAlgebra.single_smul_eq_smul_single_one_smul, map_smul, mk_single_one_smul,
      augmentation_single]

variable (Λ G P) in
/-- The quotient map to coinvariants as an `augmentation Λ G`-semilinear map. -/
def mkSemilinear : P →ₛₗ[augmentation Λ G] Coinvariants Λ G P where
  toFun := mk Λ G P
  map_add' := map_add (mk Λ G P)
  map_smul' := mk_smul

@[simp] theorem mkSemilinear_apply (p : P) : mkSemilinear Λ G P p = mk Λ G P p := by rfl

section LiftSemilinear

variable {Q : Type*} [AddCommGroup Q] [Module Λ Q]

/-- Any `augmentation Λ G`-semilinear map `f : P →ₛₗ[augmentation Λ G] Q` descends to a `Λ`-linear
map `Coinvariants Λ G P →ₗ[Λ] Q`. -/
def liftSemilinear (f : P →ₛₗ[augmentation Λ G] Q) : Coinvariants Λ G P →ₗ[Λ] Q :=
  lift
    { toFun := f, map_add' := map_add f,
      map_smul' := fun c p ↦ by
        have hc : c • p = (single (1 : G) c : Λ[G]) • p := by
          rw [TauCeti.MonoidAlgebra.single_smul_eq_smul_single_one_smul, ← one_def, one_smul]
        rw [RingHom.id_apply, hc, map_smulₛₗ, augmentation_single] }
    fun g p ↦ by rw [LinearMap.coe_mk, AddHom.coe_mk, map_smulₛₗ, augmentation_single, one_smul]

@[simp] theorem liftSemilinear_mk (f : P →ₛₗ[augmentation Λ G] Q) (p : P) :
    liftSemilinear f (mk Λ G P p) = f p := by rfl

@[simp] theorem liftSemilinear_comp_mkSemilinear (f : P →ₛₗ[augmentation Λ G] Q) :
    (liftSemilinear f).comp (mkSemilinear Λ G P) = f := by ext p; rfl

end LiftSemilinear

section BalancedExtension

variable (Λ G P) in
/-- Coinvariants of `P` identify with scalar extension along the augmentation `Λ[G] →+* Λ`. -/
def balancedExtensionEquiv :
    Coinvariants Λ G P ≃ₗ[Λ] BalancedExtension (augmentation Λ G) P :=
  LinearEquiv.ofLinearMap
    (liftSemilinear (BalancedExtension.includeRight (augmentation Λ G) P))
    (BalancedExtension.lift (mkSemilinear Λ G P))
    (BalancedExtension.hom_ext fun p ↦ by simp)
    (hom_ext fun p ↦ by simp)

@[simp]
theorem balancedExtensionEquiv_mk (p : P) :
    balancedExtensionEquiv Λ G P (mk Λ G P p) =
      BalancedExtension.tmul (augmentation Λ G) 1 p := by
  simp [balancedExtensionEquiv]

theorem balancedExtensionEquiv_mk_eq_includeRight (p : P) :
    balancedExtensionEquiv Λ G P (mk Λ G P p) =
      BalancedExtension.includeRight (augmentation Λ G) P p := by
  simp

@[simp]
theorem balancedExtensionEquiv_comp_mkSemilinear :
    (balancedExtensionEquiv Λ G P).toLinearMap.comp (mkSemilinear Λ G P) =
      BalancedExtension.includeRight (augmentation Λ G) P := by
  ext p; simp

@[simp]
theorem balancedExtensionEquiv_symm_tmul (c : Λ) (p : P) :
    (balancedExtensionEquiv Λ G P).symm (BalancedExtension.tmul (augmentation Λ G) c p) =
      c • mk Λ G P p := by
  simp [balancedExtensionEquiv]

@[simp]
theorem balancedExtensionEquiv_symm_comp_includeRight :
    (balancedExtensionEquiv Λ G P).symm.toLinearMap.comp
        (BalancedExtension.includeRight (augmentation Λ G) P) =
      mkSemilinear Λ G P := by
  ext p; simp

end BalancedExtension

section Map

variable {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module Λ[G] P'] [IsScalarTower Λ Λ[G] P']

/-- Functoriality of `Coinvariants` along `Λ[G]`-linear maps. -/
def map (f : P →ₗ[Λ[G]] P') : Coinvariants Λ G P →ₗ[Λ] Coinvariants Λ G P' :=
  lift ((mk Λ G P').comp (f.restrictScalars Λ)) fun g p ↦ by simp [LinearMap.comp_apply]

@[simp]
theorem map_mk (f : P →ₗ[Λ[G]] P') (p : P) : map f (mk Λ G P p) = mk Λ G P' (f p) := by rfl

@[simp] theorem map_comp_mk (f : P →ₗ[Λ[G]] P') :
    map (Λ := Λ) f ∘ₗ mk Λ G P = mk Λ G P' ∘ₗ f.restrictScalars Λ := by ext p; rfl

@[simp]
theorem map_comp {P'' : Type*} [AddCommGroup P''] [Module Λ P''] [Module Λ[G] P'']
    [IsScalarTower Λ Λ[G] P''] (g : P' →ₗ[Λ[G]] P'') (f : P →ₗ[Λ[G]] P') :
    map (g ∘ₗ f) = map g ∘ₗ map f := by ext p; rfl

@[simp] theorem map_zero : map (Λ := Λ) (0 : P →ₗ[Λ[G]] P') = 0 := by ext p; simp

@[simp] theorem map_add (f g : P →ₗ[Λ[G]] P') : map (Λ := Λ) (f + g) = map f + map g := by
  ext p; simp

@[simp] theorem map_neg (f : P →ₗ[Λ[G]] P') : map (Λ := Λ) (-f) = -map f := by ext p; simp

@[simp] theorem map_sub (f g : P →ₗ[Λ[G]] P') : map (Λ := Λ) (f - g) = map f - map g := by
  ext p; simp

theorem map_surjective {f : P →ₗ[Λ[G]] P'} (hf : Function.Surjective f) :
    Function.Surjective (map (Λ := Λ) f) := fun y ↦ by
  obtain ⟨p', rfl⟩ := mk_surjective y; obtain ⟨p, rfl⟩ := hf p'; exact ⟨mk Λ G P p, rfl⟩

@[simp]
theorem balancedExtensionEquiv_map (f : P →ₗ[Λ[G]] P') (x : Coinvariants Λ G P) :
    balancedExtensionEquiv Λ G P' (map f x) =
      BalancedExtension.map (augmentation Λ G) f (balancedExtensionEquiv Λ G P x) := by
  induction x using induction_on with
  | h p => simp

theorem balancedExtensionEquiv_comp_map (f : P →ₗ[Λ[G]] P') :
    (balancedExtensionEquiv Λ G P').toLinearMap ∘ₗ map f =
      BalancedExtension.map (augmentation Λ G) f ∘ₗ
        (balancedExtensionEquiv Λ G P).toLinearMap := by
  ext p; simp

/-- The `Λ`-linear equivalence `Coinvariants Λ G P ≃ₗ[Λ] Coinvariants Λ G P'` induced by a
`Λ[G]`-linear equivalence `e : P ≃ₗ[Λ[G]] P'`. -/
def congr (e : P ≃ₗ[Λ[G]] P') : Coinvariants Λ G P ≃ₗ[Λ] Coinvariants Λ G P' :=
  LinearEquiv.ofLinearMap (map e.toLinearMap) (map e.symm.toLinearMap)
    (hom_ext fun p ↦ by simp) (hom_ext fun p ↦ by simp)

@[simp] theorem congr_mk (e : P ≃ₗ[Λ[G]] P') (p : P) :
    congr (Λ := Λ) e (mk Λ G P p) = mk Λ G P' (e p) := by rfl

@[simp] theorem congr_symm (e : P ≃ₗ[Λ[G]] P') :
    (congr (Λ := Λ) e).symm = congr (Λ := Λ) e.symm := by rfl

@[simp] theorem congr_toLinearMap (e : P ≃ₗ[Λ[G]] P') :
    (congr (Λ := Λ) e).toLinearMap = map (Λ := Λ) e.toLinearMap := by rfl

end Map

@[simp] theorem map_id : map (LinearMap.id : P →ₗ[Λ[G]] P) = LinearMap.id := by ext p; rfl

variable (Λ G) in
/-- Coinvariants of a finite free `Λ[G]`-module `(ι → Λ[G])` identify with `(ι → Λ)` via
coordinatewise augmentation. -/
def piEquiv (ι : Type*) [Finite ι] : Coinvariants Λ G (ι → Λ[G]) ≃ₗ[Λ] (ι → Λ) := by
  classical
  refine LinearEquiv.ofLinearMap
    (lift (LinearMap.pi fun i ↦ (augmentationLinearMap Λ G).comp (LinearMap.proj i))
      fun g v ↦ by ext i; simp [Pi.smul_apply, smul_eq_mul])
    ((mk Λ G (ι → Λ[G])).comp (LinearMap.pi fun i ↦ lsingle (R := Λ) (1 : G) ∘ₗ LinearMap.proj i))
    (by ext w i; simp) (by
      cases nonempty_fintype ι; ext v
      simp only [LinearMap.comp_apply, lift_mk, LinearMap.id_apply]
      have hv : v = ∑ i : ι, v i • Pi.single i (1 : Λ[G]) := by
        ext j; simp [Finset.sum_apply, Pi.single_apply]
      have hw : (LinearMap.pi fun i ↦ lsingle (R := Λ) (1 : G) ∘ₗ LinearMap.proj i)
            ((LinearMap.pi fun i ↦ (augmentationLinearMap Λ G).comp (LinearMap.proj i)) v) =
          ∑ i : ι, augmentation Λ G (v i) • Pi.single i (1 : Λ[G]) := by
        ext j; simp [Finset.sum_apply, Pi.single_apply, one_def]
      conv_rhs => rw [hv]
      rw [hw, map_sum, map_sum]
      exact Finset.sum_congr rfl fun i _ ↦ by rw [mk_smul, map_smul])

@[simp] theorem piEquiv_mk {ι : Type*} [Finite ι] (v : ι → Λ[G]) (i : ι) :
    piEquiv Λ G ι (mk Λ G (ι → Λ[G]) v) i = augmentation Λ G (v i) := by simp [piEquiv]

@[simp] theorem piEquiv_symm_apply {ι : Type*} [Finite ι] (w : ι → Λ) :
    (piEquiv Λ G ι).symm w = mk Λ G (ι → Λ[G]) (fun i ↦ single 1 (w i)) := by rfl

/-- Coinvariants of a finitely generated left `Λ[G]`-module are finitely generated over `Λ`. -/
instance [Module.Finite Λ[G] P] : Module.Finite Λ (Coinvariants Λ G P) := by
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' Λ[G] P
  exact .of_surjective ((map (Λ := Λ) π).comp (piEquiv Λ G (Fin n)).symm.toLinearMap)
    ((map_surjective hπ).comp (piEquiv Λ G (Fin n)).symm.surjective)

/-- Coinvariants of a projective left `Λ[G]`-module are projective over `Λ`. -/
instance [Module.Projective Λ[G] P] : Module.Projective Λ (Coinvariants Λ G P) := by
  refine .of_lifting_property'' fun F hF ↦ ?_
  obtain ⟨h, hh⟩ := Module.projective_lifting_property_semilinear F hF (mkSemilinear Λ G P)
  exact ⟨liftSemilinear h, hom_ext fun p ↦ by simpa using LinearMap.congr_fun hh p⟩

end ScalarTower

end Coinvariants

