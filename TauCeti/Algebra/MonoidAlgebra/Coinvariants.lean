/-!
# Coinvariants of monoid-algebra modules over arbitrary rings

For a possibly noncommutative ring `Λ`, a monoid `G`, and a left `Λ[G]`-module `P` equipped with a
left `Λ`-module structure, the coinvariant quotient `TauCeti.Coinvariants Λ G P` is `P` modulo the
`Λ`-submodule `TauCeti.Coinvariants.ker Λ G P` generated by all differences `single g 1 • p - p`
(`g : G`, `p : P`). The semilinear universal property, functoriality, and finiteness/projectivity
descent further assume `[IsScalarTower Λ (MonoidAlgebra Λ G) P]`.

This adapts the quotient API of Mathlib's `Representation.Coinvariants` while phrasing the group
action through `Module (MonoidAlgebra Λ G) P`, avoiding the `[CommRing]` hypothesis of
`Representation.Coinvariants`. For the semilinear universal property and the `Module.Finite` /
`Module.Projective` descent proofs, this adapts the proof plan of `TauCeti.BalancedExtension`,
defining `Coinvariants` directly as a `Submodule.Quotient` rather than
`TauCeti.BalancedExtension (MonoidAlgebra.augmentation Λ G) P` so that at `Λ = ℤ` the quotient
inherits the canonical `Module ℤ` instance without introducing a second `Module ℤ` structure.

## Main definitions

* `TauCeti.Coinvariants.ker`: the `Λ`-submodule spanned by `single g 1 • p - p`.
* `TauCeti.Coinvariants` and `TauCeti.Coinvariants.mk`: the quotient left `Λ`-module
  `P ⧸ Coinvariants.ker Λ G P` and its quotient map.
* `TauCeti.Coinvariants.lift` and `TauCeti.Coinvariants.liftSemilinear`: universal properties for
  `G`-invariant `Λ`-linear maps and `augmentation Λ G`-semilinear maps.
* `TauCeti.Coinvariants.map` and `TauCeti.Coinvariants.congr`: functoriality along `Λ[G]`-linear
  maps and equivalences.
* `TauCeti.Coinvariants.piEquiv`: `Coinvariants Λ G (ι → Λ[G]) ≃ₗ[Λ] (ι → Λ)` for finite `ι`.

## Main results

* Finite generation (`Module.Finite`) and projectivity (`Module.Projective`) over `Λ[G]` descend to
  `Coinvariants Λ G P` over `Λ` (registered as instances).

## References

* The Stacks Project, Section 64.15.
* K. S. Brown, *Cohomology of Groups*, Springer, 1982, Chapter II, Section 2.
-/

public section

noncomputable section

open MonoidAlgebra

namespace TauCeti

section Basic

variable (Λ G P : Type*) [Ring Λ] [Monoid G] [AddCommGroup P] [Module Λ P]
  [Module (MonoidAlgebra Λ G) P]

/-- The `Λ`-submodule of `P` generated by all differences `single g 1 • p - p` for `g : G` and
`p : P`. -/
def Coinvariants.ker : Submodule Λ P :=
  Submodule.span Λ (Set.range fun gp : G × P ↦ single gp.1 (1 : Λ) • gp.2 - gp.2)

/-- **The `G`-coinvariant left `Λ`-module** `P_G = P ⧸ ⟨single g 1 • p - p⟩` of a left
`Λ[G]`-module `P` over an arbitrary ring `Λ`. -/
def Coinvariants : Type _ :=
  P ⧸ Coinvariants.ker Λ G P

namespace Coinvariants

theorem ker_def :
    ker Λ G P = Submodule.span Λ (Set.range fun gp : G × P ↦ single gp.1 (1 : Λ) • gp.2 - gp.2) :=
  (rfl)

variable {Λ G P} in
theorem ker_le_iff {S : Submodule Λ P} :
    ker Λ G P ≤ S ↔ ∀ (g : G) (p : P), single g (1 : Λ) • p - p ∈ S := by
  rw [ker_def, Submodule.span_le, Set.range_subset_iff]
  exact Prod.forall

instance : AddCommGroup (Coinvariants Λ G P) :=
  inferInstanceAs <| AddCommGroup (P ⧸ ker Λ G P)

instance : Module Λ (Coinvariants Λ G P) :=
  inferInstanceAs <| Module Λ (P ⧸ ker Λ G P)

instance [Subsingleton P] : Subsingleton (Coinvariants Λ G P) :=
  inferInstanceAs <| Subsingleton (P ⧸ ker Λ G P)

variable {Λ G P} in
theorem sub_mem_ker (g : G) (p : P) : single g (1 : Λ) • p - p ∈ ker Λ G P :=
  Submodule.subset_span ⟨(g, p), rfl⟩

/-- The quotient map `P →ₗ[Λ] Coinvariants Λ G P`. -/
def mk : P →ₗ[Λ] Coinvariants Λ G P :=
  (ker Λ G P).mkQ

variable {Λ G P}

theorem mk_surjective : Function.Surjective (mk Λ G P) :=
  Submodule.mkQ_surjective (ker Λ G P)

instance [Module.Finite Λ P] : Module.Finite Λ (Coinvariants Λ G P) :=
  .of_surjective (mk Λ G P) mk_surjective

@[elab_as_elim]
theorem induction_on {motive : Coinvariants Λ G P → Prop} (x : Coinvariants Λ G P)
    (h : ∀ p : P, motive (mk Λ G P p)) : motive x := by
  obtain ⟨p, rfl⟩ := mk_surjective x
  exact h p

@[simp]
theorem ker_mk : LinearMap.ker (mk Λ G P) = ker Λ G P :=
  Submodule.ker_mkQ (ker Λ G P)

@[simp]
theorem mk_eq_zero {p : P} : mk Λ G P p = 0 ↔ p ∈ ker Λ G P :=
  Submodule.Quotient.mk_eq_zero (ker Λ G P)

theorem mk_eq_iff {p q : P} : mk Λ G P p = mk Λ G P q ↔ p - q ∈ ker Λ G P :=
  Submodule.Quotient.eq (ker Λ G P)

@[ext]
theorem hom_ext {Q : Type*} [AddCommGroup Q] [Module Λ Q]
    {f g : Coinvariants Λ G P →ₗ[Λ] Q} (h : ∀ p, f (mk Λ G P p) = g (mk Λ G P p)) :
    f = g := by
  ext x; obtain ⟨p, rfl⟩ := mk_surjective x; exact h p

@[simp]
theorem mk_single_one_smul (g : G) (p : P) :
    mk Λ G P (single g (1 : Λ) • p) = mk Λ G P p :=
  mk_eq_iff.2 (sub_mem_ker g p)

/-- Universal property of `Coinvariants`: any `Λ`-linear map `f : P →ₗ[Λ] Q` invariant under the
action of every `g : G` descends to `Coinvariants Λ G P →ₗ[Λ] Q`. -/
def lift {Q : Type*} [AddCommGroup Q] [Module Λ Q] (f : P →ₗ[Λ] Q)
    (hf : ∀ (g : G) (p : P), f (single g (1 : Λ) • p) = f p) :
    Coinvariants Λ G P →ₗ[Λ] Q :=
  (ker Λ G P).liftQ f <| ker_le_iff.2 fun g p ↦ by
    rw [LinearMap.mem_ker, map_sub, hf, sub_self]

@[simp]
theorem lift_mk {Q : Type*} [AddCommGroup Q] [Module Λ Q] (f : P →ₗ[Λ] Q)
    (hf : ∀ (g : G) (p : P), f (single g (1 : Λ) • p) = f p) (p : P) :
    lift f hf (mk Λ G P p) = f p :=
  (rfl)

@[simp]
theorem lift_comp_mk {Q : Type*} [AddCommGroup Q] [Module Λ Q] (f : P →ₗ[Λ] Q)
    (hf : ∀ (g : G) (p : P), f (single g (1 : Λ) • p) = f p) :
    lift f hf ∘ₗ mk Λ G P = f := by
  ext p
  rfl

end Coinvariants

end Basic

namespace Coinvariants

section ScalarTower

variable {Λ G P : Type*} [Ring Λ] [Monoid G] [AddCommGroup P] [Module Λ P]
  [Module (MonoidAlgebra Λ G) P] [IsScalarTower Λ (MonoidAlgebra Λ G) P]

/-- On `Coinvariants Λ G P`, the `Λ[G]`-action reduces to scalar multiplication by the
augmentation. -/
@[simp]
theorem mk_smul (r : MonoidAlgebra Λ G) (p : P) :
    mk Λ G P (r • p) = augmentation Λ G r • mk Λ G P p := by
  induction r using induction_linear with
  | zero => simp
  | add x y hx hy => rw [add_smul, map_add, map_add, add_smul, hx, hy]
  | single g c =>
    rw [TauCeti.MonoidAlgebra.single_smul_eq_smul_single_one_smul, map_smul, mk_single_one_smul,
      augmentation_single]

variable (Λ G P) in
/-- The quotient map to coinvariants as an `augmentation Λ G`-semilinear map. -/
def mkSemilinear : P →ₛₗ[augmentation Λ G] Coinvariants Λ G P where
  toFun := mk Λ G P
  map_add' := map_add (mk Λ G P)
  map_smul' := mk_smul

@[simp]
theorem mkSemilinear_apply (p : P) : mkSemilinear Λ G P p = mk Λ G P p :=
  (rfl)

/-- Any `augmentation Λ G`-semilinear map `f : P →ₛₗ[augmentation Λ G] Q` descends to a `Λ`-linear
map `Coinvariants Λ G P →ₗ[Λ] Q`. -/
def liftSemilinear {Q : Type*} [AddCommGroup Q] [Module Λ Q]
    (f : P →ₛₗ[augmentation Λ G] Q) : Coinvariants Λ G P →ₗ[Λ] Q :=
  lift
    { toFun := f, map_add' := map_add f,
      map_smul' := fun c p ↦ by
        have hc : c • p = (single (1 : G) c : MonoidAlgebra Λ G) • p := by
          rw [TauCeti.MonoidAlgebra.single_smul_eq_smul_single_one_smul, ← one_def, one_smul]
        rw [RingHom.id_apply, hc, map_smulₛₗ, augmentation_single] }
    (fun g p ↦ by rw [LinearMap.coe_mk, AddHom.coe_mk, map_smulₛₗ, augmentation_single, one_smul])

@[simp]
theorem liftSemilinear_mk {Q : Type*} [AddCommGroup Q] [Module Λ Q]
    (f : P →ₛₗ[augmentation Λ G] Q) (p : P) :
    liftSemilinear f (mk Λ G P p) = f p :=
  (rfl)

@[simp]
theorem liftSemilinear_comp_mkSemilinear {Q : Type*} [AddCommGroup Q] [Module Λ Q]
    (f : P →ₛₗ[augmentation Λ G] Q) :
    (liftSemilinear f).comp (mkSemilinear Λ G P) = f := by
  ext p
  rfl

/-- Functoriality of `Coinvariants` along `Λ[G]`-linear maps. -/
def map {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (f : P →ₗ[MonoidAlgebra Λ G] P') :
    Coinvariants Λ G P →ₗ[Λ] Coinvariants Λ G P' :=
  lift ((mk Λ G P').comp (f.restrictScalars Λ)) fun g p ↦ by simp [LinearMap.comp_apply]

@[simp]
theorem map_mk {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (f : P →ₗ[MonoidAlgebra Λ G] P') (p : P) :
    map f (mk Λ G P p) = mk Λ G P' (f p) :=
  (rfl)

@[simp]
theorem map_comp_mk {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (f : P →ₗ[MonoidAlgebra Λ G] P') :
    map (Λ := Λ) f ∘ₗ mk Λ G P = mk Λ G P' ∘ₗ f.restrictScalars Λ := by
  ext p
  rfl

@[simp]
theorem map_id : map (LinearMap.id : P →ₗ[MonoidAlgebra Λ G] P) = LinearMap.id := by ext p; rfl

@[simp]
theorem map_comp {P' P'' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] [AddCommGroup P''] [Module Λ P'']
    [Module (MonoidAlgebra Λ G) P''] [IsScalarTower Λ (MonoidAlgebra Λ G) P'']
    (g : P' →ₗ[MonoidAlgebra Λ G] P'') (f : P →ₗ[MonoidAlgebra Λ G] P') :
    map (g ∘ₗ f) = map g ∘ₗ map f := by ext p; rfl

@[simp]
theorem map_zero {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] :
    map (Λ := Λ) (0 : P →ₗ[MonoidAlgebra Λ G] P') = 0 := by
  ext p
  simp

@[simp]
theorem map_add {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (f g : P →ₗ[MonoidAlgebra Λ G] P') :
    map (Λ := Λ) (f + g) = map f + map g := by
  ext p
  simp

@[simp]
theorem map_neg {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (f : P →ₗ[MonoidAlgebra Λ G] P') :
    map (Λ := Λ) (-f) = -map f := by
  ext p
  simp

@[simp]
theorem map_sub {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (f g : P →ₗ[MonoidAlgebra Λ G] P') :
    map (Λ := Λ) (f - g) = map f - map g := by
  ext p
  simp

theorem map_surjective {P' : Type*} [AddCommGroup P'] [Module Λ P']
    [Module (MonoidAlgebra Λ G) P'] [IsScalarTower Λ (MonoidAlgebra Λ G) P']
    {f : P →ₗ[MonoidAlgebra Λ G] P'} (hf : Function.Surjective f) :
    Function.Surjective (map (Λ := Λ) f) := by
  intro y
  obtain ⟨p', rfl⟩ := mk_surjective y
  obtain ⟨p, rfl⟩ := hf p'
  exact ⟨mk Λ G P p, rfl⟩

/-- The `Λ`-linear equivalence `Coinvariants Λ G P ≃ₗ[Λ] Coinvariants Λ G P'` induced by a
`Λ[G]`-linear equivalence `e : P ≃ₗ[Λ[G]] P'`. -/
def congr {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (e : P ≃ₗ[MonoidAlgebra Λ G] P') :
    Coinvariants Λ G P ≃ₗ[Λ] Coinvariants Λ G P' :=
  LinearEquiv.ofLinearMap (map e.toLinearMap) (map e.symm.toLinearMap)
    (hom_ext fun p ↦ by simp) (hom_ext fun p ↦ by simp)

@[simp]
theorem congr_mk {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (e : P ≃ₗ[MonoidAlgebra Λ G] P') (p : P) :
    congr (Λ := Λ) e (mk Λ G P p) = mk Λ G P' (e p) :=
  (rfl)

@[simp]
theorem congr_symm {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (e : P ≃ₗ[MonoidAlgebra Λ G] P') :
    (congr (Λ := Λ) e).symm = congr (Λ := Λ) e.symm :=
  (rfl)

@[simp]
theorem congr_toLinearMap {P' : Type*} [AddCommGroup P'] [Module Λ P']
    [Module (MonoidAlgebra Λ G) P'] [IsScalarTower Λ (MonoidAlgebra Λ G) P']
    (e : P ≃ₗ[MonoidAlgebra Λ G] P') :
    (congr (Λ := Λ) e).toLinearMap = map (Λ := Λ) e.toLinearMap :=
  (rfl)

variable (Λ G) in
/-- Coinvariants of a finite free `Λ[G]`-module `(ι → Λ[G])` identify with `(ι → Λ)` via
coordinatewise augmentation. -/
def piEquiv (ι : Type*) [Finite ι] :
    Coinvariants Λ G (ι → MonoidAlgebra Λ G) ≃ₗ[Λ] (ι → Λ) := by
  classical
  refine LinearEquiv.ofLinearMap
    (lift (LinearMap.pi fun i ↦ (augmentationLinearMap Λ G).comp (LinearMap.proj i))
      fun g v ↦ by ext i; simp [Pi.smul_apply, smul_eq_mul])
    ((mk Λ G (ι → MonoidAlgebra Λ G)).comp
      (LinearMap.pi fun i ↦ lsingle (R := Λ) (1 : G) ∘ₗ LinearMap.proj i))
    (by ext w i; simp)
    (by
      cases nonempty_fintype ι
      ext v
      simp only [LinearMap.comp_apply, lift_mk, LinearMap.id_apply]
      have hv : v = ∑ i : ι, v i • Pi.single i (1 : MonoidAlgebra Λ G) := by
        ext j; simp [Finset.sum_apply, Pi.single_apply]
      have hw : (LinearMap.pi fun i ↦ lsingle (R := Λ) (1 : G) ∘ₗ LinearMap.proj i)
            ((LinearMap.pi fun i ↦ (augmentationLinearMap Λ G).comp (LinearMap.proj i)) v) =
          ∑ i : ι, augmentation Λ G (v i) • Pi.single i (1 : MonoidAlgebra Λ G) := by
        ext j; simp [Finset.sum_apply, Pi.single_apply, one_def]
      conv_rhs => rw [hv]
      rw [hw, map_sum, map_sum]
      exact Finset.sum_congr rfl fun i _ ↦ by rw [mk_smul, map_smul])

@[simp]
theorem piEquiv_mk {ι : Type*} [Finite ι] (v : ι → MonoidAlgebra Λ G) (i : ι) :
    piEquiv Λ G ι (mk Λ G (ι → MonoidAlgebra Λ G) v) i = augmentation Λ G (v i) := by
  simp [piEquiv]

@[simp]
theorem piEquiv_symm_apply {ι : Type*} [Finite ι] (w : ι → Λ) :
    (piEquiv Λ G ι).symm w = mk Λ G (ι → MonoidAlgebra Λ G) (fun i ↦ single 1 (w i)) :=
  (rfl)

/-- Coinvariants of a finitely generated left `Λ[G]`-module are finitely generated over `Λ`. -/
instance [Module.Finite (MonoidAlgebra Λ G) P] : Module.Finite Λ (Coinvariants Λ G P) := by
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' (MonoidAlgebra Λ G) P
  exact .of_surjective ((map (Λ := Λ) π).comp (piEquiv Λ G (Fin n)).symm.toLinearMap)
    ((map_surjective hπ).comp (piEquiv Λ G (Fin n)).symm.surjective)

/-- Coinvariants of a projective left `Λ[G]`-module are projective over `Λ`. -/
instance [Module.Projective (MonoidAlgebra Λ G) P] :
    Module.Projective Λ (Coinvariants Λ G P) := by
  refine .of_lifting_property'' fun F hF ↦ ?_
  obtain ⟨h, hh⟩ :=
    Module.projective_lifting_property_semilinear F hF (mkSemilinear Λ G P)
  exact ⟨liftSemilinear h, hom_ext fun p ↦ by simpa using LinearMap.congr_fun hh p⟩

end ScalarTower

end Coinvariants

end TauCeti

