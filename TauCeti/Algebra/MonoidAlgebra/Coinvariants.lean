/-!
# Coinvariants of monoid-algebra modules over arbitrary rings

For a possibly noncommutative ring `Λ`, a monoid `G`, and a left `Λ[G]`-module `P` with a left
`Λ`-module structure, the coinvariant quotient `MonoidAlgebra.Coinvariants Λ G P` is `P` modulo the
`Λ`-submodule generated by all elements `single g 1 • p - p` (`g : G`, `p : P`). Working directly
with `Submodule.Quotient` removes commutativity of `Λ` while preserving the canonical `Module ℤ`
structure at `Λ = ℤ`.

## Main definitions

* `MonoidAlgebra.elemLinearMap`: the `Λ`-linear endomorphism `p ↦ single g 1 • p`.
* `MonoidAlgebra.Coinvariants` and `MonoidAlgebra.Coinvariants.mk`: the quotient left `Λ`-module
  `P ⧸ Coinvariants.ker Λ G P` and its quotient map.
* `MonoidAlgebra.Coinvariants.desc` and `MonoidAlgebra.Coinvariants.liftSemilinear`: universal
  properties for `G`-invariant `Λ`-linear maps and `augmentation Λ G`-semilinear maps.
* `MonoidAlgebra.Coinvariants.map`: functoriality along `Λ[G]`-linear maps.
* `MonoidAlgebra.Coinvariants.piEquiv`: `Coinvariants Λ G (ι → Λ[G]) ≃ₗ[Λ] (ι → Λ)` for finite `ι`.

## Main results

* Finite generation (`Module.Finite`) and projectivity (`Module.Projective`) over `Λ[G]` descend to
  `Coinvariants Λ G P` over `Λ` (registered as instances).

## References

* The Stacks Project, Section 64.15.
* K. S. Brown, *Cohomology of Groups*, Springer, 1982, Chapter II, Section 2.
-/

public section

noncomputable section

namespace MonoidAlgebra

section SingleComm

variable {Λ G P : Type*} [Semiring Λ] [Monoid G] [AddCommMonoid P] [Module Λ P]
  [Module (MonoidAlgebra Λ G) P] [IsScalarTower Λ (MonoidAlgebra Λ G) P]

/-- Action of a group-ring basis element `single g 1` commutes with scalar multiplication by `Λ`,
even when `Λ` is noncommutative. -/
theorem single_one_smul_comm (g : G) (c : Λ) (p : P) :
    single g (1 : Λ) • (c • p) = c • (single g (1 : Λ) • p) := by
  rw [← smul_one_smul (MonoidAlgebra Λ G) c p, ← mul_smul]
  have h : single g (1 : Λ) * (c • (1 : MonoidAlgebra Λ G)) = c • single g (1 : Λ) := by
    rw [one_def, smul_single, smul_eq_mul, mul_one, single_mul_single, mul_one, one_mul,
      smul_single, smul_eq_mul, mul_one]
  rw [h, smul_assoc]

/-- Action of `single g c` factors into the `Λ`-action of `c` and the action of `single g 1`. -/
theorem single_smul_eq_smul_single_one_smul (g : G) (c : Λ) (p : P) :
    single g c • p = c • (single g (1 : Λ) • p) := by
  have hsingle : (single g c : MonoidAlgebra Λ G) = c • single g (1 : Λ) := by
    rw [smul_single, smul_eq_mul, mul_one]
  rw [hsingle, smul_assoc]

variable (Λ P) in
/-- Action of a monoid element `g : G` on `P` as a `Λ`-linear endomorphism. -/
def elemLinearMap (g : G) : P →ₗ[Λ] P where
  toFun p := single g (1 : Λ) • p
  map_add' := smul_add _
  map_smul' c p := by rw [RingHom.id_apply, single_one_smul_comm]

@[simp]
theorem elemLinearMap_apply (g : G) (p : P) :
    elemLinearMap Λ P g p = single g (1 : Λ) • p :=
  (rfl)

end SingleComm

section Basic

variable (Λ G P : Type*) [Ring Λ] [Monoid G] [AddCommGroup P] [Module Λ P]
  [Module (MonoidAlgebra Λ G) P]

/-- The `Λ`-submodule of `P` generated by all differences `single g 1 • p - p` for `g : G` and
`p : P`. -/
def Coinvariants.ker : Submodule Λ P :=
  Submodule.span Λ (Set.range fun gp : G × P ↦ single gp.1 (1 : Λ) • gp.2 - gp.2)

/-- **The `G`-coinvariant left `Λ`-module** `P_G = P ⧸ ⟨single g 1 • p - p⟩` of a left
`Λ[G]`-module `P` over an arbitrary ring `Λ`. -/
def Coinvariants : Type _ :=
  P ⧸ Coinvariants.ker Λ G P

namespace Coinvariants

instance : AddCommGroup (Coinvariants Λ G P) :=
  inferInstanceAs <| AddCommGroup (P ⧸ ker Λ G P)

instance : Module Λ (Coinvariants Λ G P) :=
  inferInstanceAs <| Module Λ (P ⧸ ker Λ G P)

variable {Λ G P} in
theorem sub_mem_ker (g : G) (p : P) : single g (1 : Λ) • p - p ∈ ker Λ G P :=
  Submodule.subset_span ⟨(g, p), rfl⟩

/-- The quotient map `P →ₗ[Λ] Coinvariants Λ G P`. -/
def mk : P →ₗ[Λ] Coinvariants Λ G P :=
  (ker Λ G P).mkQ

variable {Λ G P}

theorem mk_surjective : Function.Surjective (mk Λ G P) :=
  Submodule.mkQ_surjective (ker Λ G P)

theorem mk_eq_iff {p q : P} : mk Λ G P p = mk Λ G P q ↔ p - q ∈ ker Λ G P :=
  Submodule.Quotient.eq (ker Λ G P)

@[ext]
theorem hom_ext {Q : Type*} [AddCommGroup Q] [Module Λ Q]
    {f g : Coinvariants Λ G P →ₗ[Λ] Q} (h : ∀ p, f (mk Λ G P p) = g (mk Λ G P p)) :
    f = g := by
  ext x; obtain ⟨p, rfl⟩ := mk_surjective x; exact h p

@[simp]
theorem mk_single_one_smul (g : G) (p : P) :
    mk Λ G P (single g (1 : Λ) • p) = mk Λ G P p :=
  mk_eq_iff.2 (sub_mem_ker g p)

/-- Universal property of `Coinvariants`: any `Λ`-linear map `f : P →ₗ[Λ] Q` invariant under the
action of every `g : G` descends to `Coinvariants Λ G P →ₗ[Λ] Q`. -/
def desc {Q : Type*} [AddCommGroup Q] [Module Λ Q] (f : P →ₗ[Λ] Q)
    (hf : ∀ (g : G) (p : P), f (single g (1 : Λ) • p) = f p) :
    Coinvariants Λ G P →ₗ[Λ] Q :=
  (ker Λ G P).liftQ f <| by
    rw [ker, Submodule.span_le]
    rintro _ ⟨⟨g, p⟩, rfl⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker, map_sub, hf, sub_self]

@[simp]
theorem desc_mk {Q : Type*} [AddCommGroup Q] [Module Λ Q] (f : P →ₗ[Λ] Q)
    (hf : ∀ (g : G) (p : P), f (single g (1 : Λ) • p) = f p) (p : P) :
    desc f hf (mk Λ G P p) = f p :=
  (rfl)

end Coinvariants

end Basic

namespace Coinvariants

section ScalarTower

variable {Λ G P : Type*} [Ring Λ] [Monoid G] [AddCommGroup P] [Module Λ P]
  [Module (MonoidAlgebra Λ G) P] [IsScalarTower Λ (MonoidAlgebra Λ G) P]

/-- On `Coinvariants Λ G P`, the `Λ[G]`-action reduces to scalar multiplication by the
augmentation. -/
@[simp]
theorem mk_smul (r : MonoidAlgebra Λ G) (p : P) :
    mk Λ G P (r • p) = augmentation Λ G r • mk Λ G P p := by
  induction r using induction_linear with
  | zero => simp
  | add x y hx hy => rw [add_smul, map_add, map_add, add_smul, hx, hy]
  | single g c =>
    rw [single_smul_eq_smul_single_one_smul, map_smul, mk_single_one_smul, augmentation_single]

variable (Λ G P) in
/-- The quotient map to coinvariants as an `augmentation Λ G`-semilinear map. -/
def mkSemilinear : P →ₛₗ[augmentation Λ G] Coinvariants Λ G P where
  toFun := mk Λ G P
  map_add' := map_add (mk Λ G P)
  map_smul' := mk_smul

@[simp]
theorem mkSemilinear_apply (p : P) : mkSemilinear Λ G P p = mk Λ G P p :=
  (rfl)

/-- Any `augmentation Λ G`-semilinear map `f : P →ₛₗ[augmentation Λ G] Q` descends to a `Λ`-linear
map `Coinvariants Λ G P →ₗ[Λ] Q`. -/
def liftSemilinear {Q : Type*} [AddCommGroup Q] [Module Λ Q]
    (f : P →ₛₗ[augmentation Λ G] Q) : Coinvariants Λ G P →ₗ[Λ] Q :=
  desc
    { toFun := f, map_add' := map_add f,
      map_smul' := fun c p ↦ by
        have hc : c • p = (single (1 : G) c : MonoidAlgebra Λ G) • p := by
          rw [← smul_one_smul (MonoidAlgebra Λ G) c p, one_def, smul_single, smul_eq_mul, mul_one]
        rw [RingHom.id_apply, hc, map_smulₛₗ, augmentation_single] }
    (fun g p ↦ by rw [LinearMap.coe_mk, AddHom.coe_mk, map_smulₛₗ, augmentation_single, one_smul])

@[simp]
theorem liftSemilinear_mk {Q : Type*} [AddCommGroup Q] [Module Λ Q]
    (f : P →ₛₗ[augmentation Λ G] Q) (p : P) :
    liftSemilinear f (mk Λ G P p) = f p :=
  (rfl)

/-- Functoriality of `Coinvariants` along `Λ[G]`-linear maps. -/
def map {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (f : P →ₗ[MonoidAlgebra Λ G] P') :
    Coinvariants Λ G P →ₗ[Λ] Coinvariants Λ G P' :=
  desc ((mk Λ G P').comp (f.restrictScalars Λ)) fun g p ↦ by simp [LinearMap.comp_apply]

@[simp]
theorem map_mk {P' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] (f : P →ₗ[MonoidAlgebra Λ G] P') (p : P) :
    map f (mk Λ G P p) = mk Λ G P' (f p) :=
  (rfl)

@[simp]
theorem map_id : map (LinearMap.id : P →ₗ[MonoidAlgebra Λ G] P) = LinearMap.id := by ext p; rfl

@[simp]
theorem map_comp {P' P'' : Type*} [AddCommGroup P'] [Module Λ P'] [Module (MonoidAlgebra Λ G) P']
    [IsScalarTower Λ (MonoidAlgebra Λ G) P'] [AddCommGroup P''] [Module Λ P'']
    [Module (MonoidAlgebra Λ G) P''] [IsScalarTower Λ (MonoidAlgebra Λ G) P'']
    (g : P' →ₗ[MonoidAlgebra Λ G] P'') (f : P →ₗ[MonoidAlgebra Λ G] P') :
    map (g ∘ₗ f) = map g ∘ₗ map f := by ext p; rfl

theorem map_surjective {P' : Type*} [AddCommGroup P'] [Module Λ P']
    [Module (MonoidAlgebra Λ G) P'] [IsScalarTower Λ (MonoidAlgebra Λ G) P']
    {f : P →ₗ[MonoidAlgebra Λ G] P'} (hf : Function.Surjective f) :
    Function.Surjective (map (Λ := Λ) f) := by
  intro y
  obtain ⟨p', rfl⟩ := mk_surjective y
  obtain ⟨p, rfl⟩ := hf p'
  exact ⟨mk Λ G P p, rfl⟩

variable (Λ G) in
/-- Coinvariants of a finite free `Λ[G]`-module `(ι → Λ[G])` identify with `(ι → Λ)` via
coordinatewise augmentation. -/
def piEquiv (ι : Type*) [Fintype ι] :
    Coinvariants Λ G (ι → MonoidAlgebra Λ G) ≃ₗ[Λ] (ι → Λ) := by
  classical
  refine LinearEquiv.ofLinearMap
    (desc (LinearMap.pi fun i ↦ (augmentationLinearMap Λ G).comp (LinearMap.proj i))
      fun g v ↦ by ext i; simp [Pi.smul_apply, smul_eq_mul])
    ((mk Λ G (ι → MonoidAlgebra Λ G)).comp
      (LinearMap.pi fun i ↦ lsingle (R := Λ) (1 : G) ∘ₗ LinearMap.proj i))
    (by ext w i; simp)
    (by
      ext v
      simp only [LinearMap.comp_apply, desc_mk, LinearMap.id_apply]
      have hv : v = ∑ i : ι, v i • Pi.single i (1 : MonoidAlgebra Λ G) := by
        ext j; simp [Finset.sum_apply, Pi.single_apply]
      have hw : (LinearMap.pi fun i ↦ lsingle (R := Λ) (1 : G) ∘ₗ LinearMap.proj i)
            ((LinearMap.pi fun i ↦ (augmentationLinearMap Λ G).comp (LinearMap.proj i)) v) =
          ∑ i : ι, augmentation Λ G (v i) • Pi.single i (1 : MonoidAlgebra Λ G) := by
        ext j; simp [Finset.sum_apply, Pi.single_apply, one_def]
      conv_rhs => rw [hv]
      rw [hw, map_sum, map_sum]
      exact Finset.sum_congr rfl fun i _ ↦ by rw [mk_smul, map_smul])

@[simp]
theorem piEquiv_mk {ι : Type*} [Fintype ι] (v : ι → MonoidAlgebra Λ G) (i : ι) :
    piEquiv Λ G ι (mk Λ G (ι → MonoidAlgebra Λ G) v) i = augmentation Λ G (v i) := by
  simp [piEquiv]

@[simp]
theorem piEquiv_symm_apply {ι : Type*} [Fintype ι] (w : ι → Λ) :
    (piEquiv Λ G ι).symm w = mk Λ G (ι → MonoidAlgebra Λ G) (fun i ↦ single 1 (w i)) :=
  (rfl)

/-- Coinvariants of a finitely generated left `Λ[G]`-module are finitely generated over `Λ`. -/
instance [Module.Finite (MonoidAlgebra Λ G) P] : Module.Finite Λ (Coinvariants Λ G P) := by
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' (MonoidAlgebra Λ G) P
  exact .of_surjective ((map (Λ := Λ) π).comp (piEquiv Λ G (Fin n)).symm.toLinearMap)
    ((map_surjective hπ).comp (piEquiv Λ G (Fin n)).symm.surjective)

/-- Coinvariants of a projective left `Λ[G]`-module are projective over `Λ`. -/
instance [Module.Projective (MonoidAlgebra Λ G) P] :
    Module.Projective Λ (Coinvariants Λ G P) := by
  refine .of_lifting_property'' fun F hF ↦ ?_
  obtain ⟨h, hh⟩ :=
    Module.projective_lifting_property_semilinear F hF (mkSemilinear Λ G P)
  exact ⟨liftSemilinear h, hom_ext fun p ↦ by simpa using LinearMap.congr_fun hh p⟩

end ScalarTower

end Coinvariants

end MonoidAlgebra

end
