/-!
# Kolyvagin derivative operators

For an element `σ` of a monoid `G` and `m : ℕ`, this file studies two elements of the monoid
algebra `k[G]`: the **Kolyvagin derivative** `D(σ, m) = ∑_{i < m} i σ^i`
(`TauCeti.kolyvaginDerivative`) and the **lifted norm** `N(σ, m) = ∑_{i < m} σ^(i + 1)`
(`TauCeti.liftedNorm`). They are the operators of Kolyvagin's derivative construction in the
theory of Euler systems.

The basic identity is the telescoping relation `(σ - 1) D(σ, m) = m σ^m - N(σ, m)`, which holds
for every `σ` and `m`, with no assumption on the order of `σ`. This lifted form matters because the
decomposition-group lift of a generator of an inertia group need not have the order of its image.
When `σ ^ m = 1` it reads `(σ - 1) D(σ, m) = m - N(σ, m)`, and when `m` is the order of `σ` the
lifted norm is the norm element `∑_{h ∈ ⟨σ⟩} h` of the cyclic subgroup generated by `σ`, which is
`TauCeti.subgroupCharSum` at the trivial character. For a generator `σ` of a finite cyclic group
`Γ` of order `n` this is Kolyvagin's identity `(σ - 1) D_σ = n - N_Γ`.

The augmentation sends `D(σ, m)` to `m (m - 1) / 2` and `N(σ, m)` to `m`, so the two operators are
not distinguished by the augmentation alone (they agree for `m = 3`). Changing the generator `σ` of
a cyclic group of order `n` to `σ ^ a`, with `a a' ≡ 1 (mod n)`, changes `D` by `a'` up to
multiples of `n`. Finally, for a family of elements `σ_q` of a commutative monoid `G`, over a
commutative ring `k`, with `σ_q ^ m_q = 1`, the product `D_r = ∏_{q ∣ r} D_q` satisfies
`(σ_q - 1) D_r = (m_q - N_q) D_{r/q}`, the form in which the identity is applied to the derivative
classes of an Euler system.

## Main definitions

* `TauCeti.kolyvaginDerivative`: the derivative `D(σ, m) = ∑_{i < m} i σ^i`;
* `TauCeti.liftedNorm`: the lifted norm `N(σ, m) = ∑_{i < m} σ^(i + 1)`.

## Main results

* `TauCeti.sub_one_mul_kolyvaginDerivative_lifted`: `(σ - 1) D(σ, m) = m σ^m - N(σ, m)`;
* `TauCeti.sub_one_mul_kolyvaginDerivative_of_pow_eq_one`: `(σ - 1) D(σ, m) = m - N(σ, m)` when
  `σ ^ m = 1`;
* `TauCeti.liftedNorm_orderOf`: at the order of `σ` the lifted norm is the norm element of the
  cyclic subgroup generated by `σ`;
* `TauCeti.sub_one_mul_kolyvaginDerivative_orderOf` and
  `TauCeti.sub_one_mul_kolyvaginDerivative_natCard`: Kolyvagin's identity `(σ - 1) D_σ = n - N_Γ`;
* `TauCeti.augmentation_kolyvaginDerivative` and `TauCeti.augmentation_liftedNorm`: the
  augmentations `m (m - 1) / 2` and `m`;
* `TauCeti.natCast_dvd_kolyvaginDerivative_pow_sub_nsmul`: `D(σ^a, n) - a' D(σ, n)` is divisible by
  `n` when `σ ^ n = 1` and `a a' ≡ 1 (mod n)`;
* `TauCeti.sub_one_mul_prod_kolyvaginDerivative`: `(σ_q - 1) ∏_{q'} D_{q'}` is
  `(m_q - N_q) ∏_{q' ≠ q} D_{q'}`.

## References

* Karl Rubin, *Euler Systems*, Annals of Mathematics Studies 147, Princeton University Press
  (2000), Chapter IV, Definition 4.1 and equation (4), p. 62, and equation (9) of §IV.7, p. 75.
-/

public section

namespace TauCeti

open MonoidAlgebra Finset

section Semiring

variable (k : Type*) {G : Type*} [Semiring k] [Monoid G]

/-- The **Kolyvagin derivative** `D(σ, m) = ∑_{i < m} i σ^i` in the monoid algebra `k[G]`. -/
noncomputable def kolyvaginDerivative (σ : G) (m : ℕ) : MonoidAlgebra k G :=
  ∑ i ∈ range m, i • of k G (σ ^ i)

/-- The **lifted norm** `N(σ, m) = ∑_{i < m} σ^(i + 1)` in the monoid algebra `k[G]`. When `m` is
the order of `σ` it is the norm element of the cyclic group generated by `σ`
(`TauCeti.liftedNorm_orderOf`); in general `σ` need not have order `m`. -/
noncomputable def liftedNorm (σ : G) (m : ℕ) : MonoidAlgebra k G :=
  ∑ i ∈ range m, of k G (σ ^ (i + 1))

variable {k}

/-- The derivative `D(σ, m)` is the weighted sum `∑_{i < m} i σ^i`. -/
theorem kolyvaginDerivative_def (σ : G) (m : ℕ) :
    kolyvaginDerivative k σ m = ∑ i ∈ range m, i • of k G (σ ^ i) :=
  (rfl)

/-- The lifted norm `N(σ, m)` is the sum `∑_{i < m} σ^(i + 1)`. -/
theorem liftedNorm_def (σ : G) (m : ℕ) :
    liftedNorm k σ m = ∑ i ∈ range m, of k G (σ ^ (i + 1)) :=
  (rfl)

/-- The derivative of length zero is zero. -/
@[simp]
theorem kolyvaginDerivative_zero (σ : G) : kolyvaginDerivative k σ 0 = 0 := by
  simp [kolyvaginDerivative_def]

/-- The lifted norm of length zero is zero. -/
@[simp]
theorem liftedNorm_zero (σ : G) : liftedNorm k σ 0 = 0 := by
  simp [liftedNorm_def]

/-- Extending the derivative by one term: `D(σ, m + 1) = D(σ, m) + m σ^m`. -/
theorem kolyvaginDerivative_succ (σ : G) (m : ℕ) :
    kolyvaginDerivative k σ (m + 1) = kolyvaginDerivative k σ m + m • of k G (σ ^ m) := by
  simp [kolyvaginDerivative_def, sum_range_succ]

/-- Extending the lifted norm by one term: `N(σ, m + 1) = N(σ, m) + σ^(m + 1)`. -/
theorem liftedNorm_succ (σ : G) (m : ℕ) :
    liftedNorm k σ (m + 1) = liftedNorm k σ m + of k G (σ ^ (m + 1)) := by
  simp [liftedNorm_def, sum_range_succ]

/-- The derivative of length one is zero, whatever the element. -/
@[simp]
theorem kolyvaginDerivative_one (σ : G) : kolyvaginDerivative k σ 1 = 0 := by
  simp [kolyvaginDerivative_def]

/-- The lifted norm of length one is `σ` itself, not `1`. -/
@[simp]
theorem liftedNorm_one (σ : G) : liftedNorm k σ 1 = of k G σ := by
  simp [liftedNorm_def]

/-- The derivative of length two is `σ`. -/
theorem kolyvaginDerivative_two (σ : G) : kolyvaginDerivative k σ 2 = of k G σ := by
  simp [kolyvaginDerivative_def, sum_range_succ]

/-- The derivative of length three is `σ + 2 σ²`. -/
theorem kolyvaginDerivative_three (σ : G) :
    kolyvaginDerivative k σ 3 = of k G σ + 2 • of k G (σ ^ 2) := by
  simp [kolyvaginDerivative_def, sum_range_succ]

/-- **Concatenation of lifted norms**: `N(σ, m + n) = N(σ, m) + σ^m N(σ, n)`. -/
theorem liftedNorm_add (σ : G) (m n : ℕ) :
    liftedNorm k σ (m + n) = liftedNorm k σ m + of k G (σ ^ m) * liftedNorm k σ n := by
  simp only [liftedNorm_def, sum_range_add, mul_sum, ← map_mul, ← pow_add, add_assoc]

/-- When `σ ^ m = 1` the shift in the lifted norm is invisible:
`N(σ, m) = ∑_{i < m} σ^i`. -/
theorem liftedNorm_of_pow_eq_one {σ : G} {m : ℕ} (h : σ ^ m = 1) :
    liftedNorm k σ m = ∑ i ∈ range m, of k G (σ ^ i) := by
  cases m with
  | zero => simp
  | succ m => rw [liftedNorm_def, sum_range_succ, h, sum_range_succ' _ m, pow_zero]

/-- The augmentation of `D(σ, m)` is `m (m - 1) / 2`. -/
@[simp]
theorem augmentation_kolyvaginDerivative (σ : G) (m : ℕ) :
    augmentation k G (kolyvaginDerivative k σ m) = (m * (m - 1) / 2 : ℕ) := by
  simp [kolyvaginDerivative_def, ← sum_range_id]

/-- The augmentation of `N(σ, m)` is `m`. -/
@[simp]
theorem augmentation_liftedNorm (σ : G) (m : ℕ) :
    augmentation k G (liftedNorm k σ m) = m := by
  simp [liftedNorm_def]

end Semiring

section Group

variable {k G : Type*} [Semiring k] [Group G]

/-- At the order of `σ`, the lifted norm is the norm element `∑_{h ∈ ⟨σ⟩} h` of the cyclic
subgroup generated by `σ`. -/
theorem liftedNorm_orderOf (σ : G) [Fintype (Subgroup.zpowers σ)] :
    liftedNorm k σ (orderOf σ) = subgroupCharSum (1 : G →* k) (Subgroup.zpowers σ) := by
  have hσ : IsOfFinOrder σ := finite_zpowers.1 inferInstance
  rw [liftedNorm_of_pow_eq_one (pow_orderOf_eq_one σ), subgroupCharSum_def,
    ← Fin.sum_univ_eq_sum_range (fun i ↦ of k G (σ ^ i)), ← (finEquivZPowers hσ).sum_comp]
  simp [finEquivZPowers_apply]

end Group

section Ring

variable {k G : Type*} [Ring k] [Monoid G]

/-- **Kolyvagin's lifted identity** `(σ - 1) D(σ, m) = m σ^m - N(σ, m)`, for any `σ` and `m`. -/
theorem sub_one_mul_kolyvaginDerivative_lifted (σ : G) (m : ℕ) :
    (of k G σ - 1) * kolyvaginDerivative k σ m = m • of k G (σ ^ m) - liftedNorm k σ m := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [kolyvaginDerivative_succ, liftedNorm_succ, mul_add, ih]
    simp only [sub_one_mul, mul_smul_comm, ← map_mul, ← pow_succ']
    module

/-- **Kolyvagin's identity** `(σ - 1) D(σ, m) = m - N(σ, m)` when `σ ^ m = 1`. -/
theorem sub_one_mul_kolyvaginDerivative_of_pow_eq_one {σ : G} {m : ℕ} (h : σ ^ m = 1) :
    (of k G σ - 1) * kolyvaginDerivative k σ m = m - liftedNorm k σ m := by
  rw [sub_one_mul_kolyvaginDerivative_lifted, h, map_one, nsmul_one]

/-- **Change of generator**: if `σ ^ n = 1` and `a a' ≡ 1 (mod n)`, then
`D(σ^a, n) - a' D(σ, n)` is divisible by `n`. -/
theorem natCast_dvd_kolyvaginDerivative_pow_sub_nsmul {σ : G} {n : ℕ} (h : σ ^ n = 1)
    {a a' : ℕ} (ha : a * a' ≡ 1 [MOD n]) :
    (n : MonoidAlgebra k G) ∣ kolyvaginDerivative k (σ ^ a) n - a' • kolyvaginDerivative k σ n := by
  -- reindex `D(σ, n)` along `i ↦ a i mod n`, so that both sums run over the powers `σ ^ (a i % n)`
  rw [kolyvaginDerivative_def σ, ← (Nat.coprime_of_mul_modEq_one _ ha).sum_range_mul_mod,
    kolyvaginDerivative_def, smul_sum, ← sum_sub_distrib]
  refine dvd_sum fun i _ ↦ ?_
  -- the coefficient `i - a' (a i mod n)` of `σ ^ (a i % n)` is divisible by `n`
  obtain ⟨c, hc⟩ : (n : ℤ) ∣ i - (a' * (a * i % n) : ℕ) :=
    Nat.modEq_iff_dvd.1 (((Nat.mod_modEq _ n).mul_left a').trans
      (by rw [mul_left_comm, ← mul_assoc]; simpa using ha.mul_right i))
  rw [← pow_mul, pow_eq_pow_mod _ h]
  refine ⟨c • of k G (σ ^ (a * i % n)), ?_⟩
  rw [← nsmul_eq_mul]
  linear_combination (norm := module) hc • of k G (σ ^ (a * i % n))

/-- At the order of `σ`, **Kolyvagin's identity** reads `(σ - 1) D(σ, |σ|) = |σ| - N`, where `N`
is the norm element of the cyclic subgroup generated by `σ`. -/
theorem sub_one_mul_kolyvaginDerivative_orderOf {G : Type*} [Group G] (σ : G)
    [Fintype (Subgroup.zpowers σ)] :
    (of k G σ - 1) * kolyvaginDerivative k σ (orderOf σ) =
      orderOf σ - subgroupCharSum (1 : G →* k) (Subgroup.zpowers σ) := by
  rw [sub_one_mul_kolyvaginDerivative_of_pow_eq_one (pow_orderOf_eq_one σ), liftedNorm_orderOf]

/-- **Kolyvagin's identity** `(σ - 1) D_σ = n - N_Γ` for a generator `σ` of a finite cyclic group
`Γ` of order `n`, with `N_Γ = ∑_{γ ∈ Γ} γ` the norm element. -/
theorem sub_one_mul_kolyvaginDerivative_natCard {G : Type*} [Group G] [Fintype G] {σ : G}
    (hσ : ∀ g, g ∈ Subgroup.zpowers σ) :
    (of k G σ - 1) * kolyvaginDerivative k σ (Nat.card G) =
      Nat.card G - ∑ g : G, of k G g := by
  classical
  rw [← orderOf_eq_card_of_forall_mem_zpowers hσ, sub_one_mul_kolyvaginDerivative_orderOf,
    subgroupCharSum_eq_sum_of_eq_top _ _ ((Subgroup.zpowers σ).eq_top_iff'.2 hσ)]
  simp

end Ring

section CommRing

variable {k G : Type*} [CommRing k] [CommMonoid G]

/-- **Kolyvagin's identity for products.** Let `D_r = ∏_{q ∈ s} D(σ_q, m_q)` be the product of the
derivatives of a finite family of elements of a commutative monoid. If `q ∈ s` and
`σ_q ^ m_q = 1`, then `(σ_q - 1) D_r = (m_q - N(σ_q, m_q)) D_{r/q}`, where `D_{r/q}` omits `q`. -/
theorem sub_one_mul_prod_kolyvaginDerivative {ι : Type*} [DecidableEq ι] {s : Finset ι}
    (σ : ι → G) (m : ι → ℕ) {q : ι} (hq : q ∈ s) (h : σ q ^ m q = 1) :
    (of k G (σ q) - 1) * ∏ q' ∈ s, kolyvaginDerivative k (σ q') (m q') =
      (m q - liftedNorm k (σ q) (m q)) * ∏ q' ∈ s.erase q, kolyvaginDerivative k (σ q') (m q') := by
  rw [← mul_prod_erase s _ hq, ← mul_assoc, sub_one_mul_kolyvaginDerivative_of_pow_eq_one h]

end CommRing

end TauCeti
