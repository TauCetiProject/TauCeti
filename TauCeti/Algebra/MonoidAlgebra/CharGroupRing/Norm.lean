module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import TauCeti.Algebra.MonoidAlgebra.CharGroupRing.Basic

/-!
# Quotients of group rings by subgroup norms as character group rings

Let `O` be an integral domain, `G` a finite commutative group such that `O` has enough roots of
unity of order the exponent of `G`, and `I` a subgroup of `G` with norm element
`N_I = ∑_{σ ∈ I} σ ∈ O[G]` (`TauCeti.subgroupCharSum (1 : G →* O) I`). Let
`Ψ = {ψ : G →* Oˣ | ¬ I ≤ ψ.ker}` be the set of characters of `G` that are nontrivial on `I`.

This file proves Lemma 2.2 of Dasgupta and Kakde: the kernel of the canonical surjection
`α_Ψ : O[G] → R_Ψ` onto the character group ring of `Ψ` is the principal ideal `(N_I)`, so that
`O[G] / (N_I) ≃ₐ[O] R_Ψ` is a character group ring.

No invertibility of `#I` in `O` is needed:

* Every `ψ ∈ Ψ` is nontrivial on `I`, so `ψ(N_I) = 0` by row orthogonality
  (`MonoidHom.charEval_subgroupCharSum_one_eq_zero`); this half holds for any commutative group
  `G` and finite subgroup `I`.
* Conversely, if `ψ(x) = 0` for every `ψ ∈ Ψ` and `h ∈ I`, then `(h - 1) x` vanishes at every
  character `ψ : G →* Oˣ` — at characters trivial on `I` because `ψ(h) = 1`, and at characters
  nontrivial on `I` because `ψ(x) = 0`. Since the joint evaluation at all characters is injective
  (`TauCeti.eq_of_forall_charEval_eq`), `h x = x` for every `h ∈ I`, so `x` is constant on cosets
  of `I` and lies in `(N_I)` by `TauCeti.mem_span_subgroupCharSum_one_iff`.

## Main definitions and results

* `Set.charGroupRing.proj_subgroupCharSum_one_eq_zero_of_forall` and
  `Set.charGroupRing.span_norm_le_ker_proj_of_forall`: `(N_I) ≤ ker α_Ψ` whenever every
  character in `Ψ` is nontrivial on `I`.
* `Set.charGroupRing.span_norm_le_ker_proj`: `(N_I) ≤ ker α_Ψ` for `Ψ = {ψ | ¬ I ≤ ψ.ker}`, for
  any commutative group `G`, finite subgroup `I`, and domain `O`.
* `Set.charGroupRing.ker_proj_eq_span_norm`: for finite `G` and `O` with enough roots of unity,
  `ker α_Ψ = (N_I)` (Dasgupta–Kakde, Lemma 2.2).
* `Set.charGroupRing.quotientSpanNormAlgEquiv`: the induced `O`-algebra isomorphism
  `O[G] / (N_I) ≃ₐ[O] R_Ψ`, characterized on residue classes by
  `Set.charGroupRing.quotientSpanNormAlgEquiv_mk`.

## References

* S. Dasgupta, M. Kakde, *On the Brumer–Stark conjecture*, Ann. of Math. (2) 197 (2023), §2.2,
  Lemma 2.2.
-/

public section

namespace Set.charGroupRing

section Domain

variable {O G : Type*} [CommRing O] [IsDomain O] [CommGroup G]

/-- Evaluating `α_Ψ` at the subgroup norm `N_I = ∑_{σ ∈ I} σ` gives `0` whenever every character
in `Ψ` is nontrivial on `I`. -/
theorem proj_subgroupCharSum_one_eq_zero_of_forall {Ψ : Set (G →* Oˣ)} (I : Subgroup G)
    [Fintype I] (hΨ : ∀ ψ ∈ Ψ, ¬ I ≤ ψ.ker) :
    proj Ψ (TauCeti.subgroupCharSum (1 : G →* O) I) = 0 := by
  rw [proj_eq_zero_iff]
  intro ψ hψ
  exact ψ.charEval_subgroupCharSum_one_eq_zero I (hΨ ψ hψ)

/-- The subgroup norm `N_I = ∑_{σ ∈ I} σ` vanishes in `R_Ψ` whenever every character in `Ψ` is
nontrivial on `I`: `(N_I) ≤ ker α_Ψ`. Neither finiteness of `G` nor roots of unity in `O` are
required. -/
theorem span_norm_le_ker_proj_of_forall {Ψ : Set (G →* Oˣ)} (I : Subgroup G) [Fintype I]
    (hΨ : ∀ ψ ∈ Ψ, ¬ I ≤ ψ.ker) :
    Ideal.span {TauCeti.subgroupCharSum (1 : G →* O) I} ≤ RingHom.ker (proj Ψ) := by
  rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
  exact proj_subgroupCharSum_one_eq_zero_of_forall I hΨ

/-- The subgroup norm `N_I = ∑_{σ ∈ I} σ` vanishes in the character group ring of the characters
nontrivial on `I`: `(N_I) ≤ ker α_Ψ` for `Ψ = {ψ | ¬ I ≤ ψ.ker}`. Neither finiteness of `G` nor
roots of unity in `O` are required for this inclusion. -/
theorem span_norm_le_ker_proj (I : Subgroup G) [Fintype I] :
    Ideal.span {TauCeti.subgroupCharSum (1 : G →* O) I} ≤
      RingHom.ker (proj {ψ : G →* Oˣ | ¬ I ≤ ψ.ker}) :=
  span_norm_le_ker_proj_of_forall I fun _ hψ ↦ hψ

/-- Evaluating `α_Ψ` at `N_I` gives `0` when `Ψ = {ψ | ¬ I ≤ ψ.ker}`. -/
@[simp]
theorem proj_subgroupCharSum_one_eq_zero (I : Subgroup G) [Fintype I] :
    proj {ψ : G →* Oˣ | ¬ I ≤ ψ.ker} (TauCeti.subgroupCharSum (1 : G →* O) I) = 0 :=
  proj_subgroupCharSum_one_eq_zero_of_forall I fun _ hψ ↦ hψ

variable [Finite G] [HasEnoughRootsOfUnity O (Monoid.exponent G)]

/-- **Quotients by subgroup norms are character group rings** (Dasgupta–Kakde, Lemma 2.2): for a
subgroup `I` of a finite commutative group `G` and a domain `O` with enough roots of unity, the
kernel of `α_Ψ : O[G] → R_Ψ` for `Ψ = {ψ : G →* Oˣ | ¬ I ≤ ψ.ker}` is the principal ideal
generated by the norm element `N_I = ∑_{σ ∈ I} σ`. -/
theorem ker_proj_eq_span_norm (I : Subgroup G) [Fintype I] :
    RingHom.ker (proj {ψ : G →* Oˣ | ¬ I ≤ ψ.ker}) =
      Ideal.span {TauCeti.subgroupCharSum (1 : G →* O) I} := by
  refine le_antisymm (fun x hx ↦ ?_) (span_norm_le_ker_proj I)
  rw [RingHom.mem_ker, proj_eq_zero_iff] at hx
  rw [TauCeti.mem_span_subgroupCharSum_one_iff]
  intro ⟨h, hh⟩
  refine TauCeti.eq_of_forall_charEval_eq fun ψ ↦ ?_
  by_cases hI : I ≤ ψ.ker
  · rw [map_mul, TauCeti.DiagonalizableGroup.point_single_one, MonoidHom.mem_ker.mp (hI hh),
      Units.val_one, mul_one]
  · rw [map_mul, hx ψ hI, zero_mul]

/-- **The `O`-algebra isomorphism `O[G] / (N_I) ≃ₐ[O] R_Ψ`** (Dasgupta–Kakde, Lemma 2.2), where
`N_I = ∑_{σ ∈ I} σ` and `Ψ = {ψ : G →* Oˣ | ¬ I ≤ ψ.ker}` is the set of characters nontrivial on
`I`. -/
noncomputable def quotientSpanNormAlgEquiv (I : Subgroup G) [Fintype I] :
    (MonoidAlgebra O G ⧸ Ideal.span {TauCeti.subgroupCharSum (1 : G →* O) I}) ≃ₐ[O]
      {ψ : G →* Oˣ | ¬ I ≤ ψ.ker}.charGroupRing :=
  (Ideal.quotientEquivAlgOfEq O (ker_proj_eq_span_norm I).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (proj_surjective _))

/-- `quotientSpanNormAlgEquiv` sends the residue class of `x ∈ O[G]` modulo `(N_I)` to
`α_Ψ(x)`. -/
@[simp]
theorem quotientSpanNormAlgEquiv_mk (I : Subgroup G) [Fintype I] (x : MonoidAlgebra O G) :
    quotientSpanNormAlgEquiv I
      (Ideal.Quotient.mk (Ideal.span {TauCeti.subgroupCharSum (1 : G →* O) I}) x) =
        proj {ψ : G →* Oˣ | ¬ I ≤ ψ.ker} x := by
  simp [quotientSpanNormAlgEquiv]

/-- The inverse of `quotientSpanNormAlgEquiv` sends `α_Ψ(x)` back to the residue class of `x`
modulo `(N_I)`. -/
@[simp]
theorem quotientSpanNormAlgEquiv_symm_proj (I : Subgroup G) [Fintype I] (x : MonoidAlgebra O G) :
    (quotientSpanNormAlgEquiv I).symm (proj {ψ : G →* Oˣ | ¬ I ≤ ψ.ker} x) =
      Ideal.Quotient.mk (Ideal.span {TauCeti.subgroupCharSum (1 : G →* O) I}) x := by
  simp [quotientSpanNormAlgEquiv, Ideal.quotientEquivAlgOfEq_symm]

-- For the trivial subgroup `I = ⊥`, no character is nontrivial on `⊥` and `N_⊥ = 1`, so both the
-- kernel and the norm ideal equal the whole group algebra `⊤`.
example :
    RingHom.ker (proj {ψ : G →* Oˣ | ¬ (⊥ : Subgroup G) ≤ ψ.ker}) = ⊤ ∧
      Ideal.span {TauCeti.subgroupCharSum (1 : G →* O) (⊥ : Subgroup G)} = ⊤ := by
  have h1 := TauCeti.subgroupCharSum_eq_one (1 : G →* O) (⊥ : Subgroup G) rfl
  refine ⟨?_, by rw [h1, Ideal.span_singleton_one]⟩
  rw [ker_proj_eq_span_norm (⊥ : Subgroup G), h1, Ideal.span_singleton_one]

-- For the whole group `I = ⊤`, a character is nontrivial on `⊤` iff it is `≠ 1`, so the kernel of
-- the joint evaluation at nontrivial characters is generated by the full group sum.
omit [Finite G] in
example [Fintype G] :
    RingHom.ker (proj {ψ : G →* Oˣ | ψ ≠ 1}) =
      Ideal.span {∑ g : G, MonoidAlgebra.of O G g} := by
  let := Fintype.ofFinite (⊤ : Subgroup G)
  have hset :
      ({ψ : G →* Oˣ | ψ ≠ 1} : Set (G →* Oˣ)) = {ψ : G →* Oˣ | ¬ (⊤ : Subgroup G) ≤ ψ.ker} := by
    ext ψ
    simp [top_le_iff, MonoidHom.ker_eq_top_iff]
  have hsum : TauCeti.subgroupCharSum (1 : G →* O) (⊤ : Subgroup G) =
      ∑ g : G, MonoidAlgebra.of O G g := by
    simpa using TauCeti.subgroupCharSum_eq_sum_of_eq_top (1 : G →* O) (⊤ : Subgroup G) rfl
  rw [hset, ker_proj_eq_span_norm (⊤ : Subgroup G), hsum]

end Domain

end Set.charGroupRing
