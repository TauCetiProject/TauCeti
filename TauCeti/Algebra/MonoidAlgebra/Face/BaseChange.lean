module

public import TauCeti.Algebra.MonoidAlgebra.Face.Basic

/-!
# Coefficient change for face quotients

Restriction to a face of an additive monoid commutes with applying a homomorphism to the
coefficients. The ideal generated by the off-face monomials extends to the corresponding ideal
over the new coefficients, so the identification of the quotient with the face algebra is natural.
Neither assertion requires flatness: the monomial generators keep coefficient one under any
coefficient map.

For the use of this quotient in toric strata, see K.-W. Lan, *Arithmetic compactifications of
PEL-type Shimura varieties*, Lemma 6.1.2.6.
-/

public section

namespace AddSubmonoid

open AddMonoidAlgebra

variable {M R S : Type*} [AddCommMonoid M] (F : AddSubmonoid M)

section CommSemiring

variable [CommSemiring R] [CommSemiring S]

/-- Coefficient change commutes with restriction to a face. -/
theorem mapRingHom_comp_faceRestriction (hF : F.AddSaturated) (f : R →+* S) :
    (mapRingHom F f).comp (F.faceRestriction hF R).toRingHom =
      (F.faceRestriction hF S).toRingHom.comp (mapRingHom M f) := by
  apply RingHom.ext
  intro p
  apply AddMonoidAlgebra.ext
  ext a
  simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
    coeff_mapRingHom, coeff_faceRestriction]

/-- Extending the off-face ideal by a coefficient map preserves its monomial generators.
No face condition on the submonoid is needed for this equality of spans. -/
@[simp]
theorem map_faceIdeal (f : R →+* S) :
    (F.faceIdeal R).map (mapRingHom M f) = F.faceIdeal S := by
  rw [faceIdeal_def, faceIdeal_def, Ideal.map_span, Set.image_image]
  exact congrArg Ideal.span <| Set.image_congr fun a _ ↦ by
    simp only [of'_apply, mapRingHom_single, map_one]

end CommSemiring

/-- Under the face quotient equivalences, the induced map of quotients is the coefficient
map on the face algebra. -/
theorem faceQuotientEquiv_comp_quotientMap [CommRing R] [CommRing S]
    (hF : F.AddSaturated) (f : R →+* S) :
    (F.faceQuotientEquiv hF (S := S)).toRingHom.comp
        (Ideal.quotientMap (F.faceIdeal S) (mapRingHom M f)
          (Ideal.map_le_iff_le_comap.mp (F.map_faceIdeal f).le)) =
      (mapRingHom F f).comp (F.faceQuotientEquiv hF (S := R)).toRingHom := by
  apply Ideal.Quotient.ringHom_ext
  apply RingHom.ext
  intro p
  simpa only [RingHom.comp_apply, Ideal.quotientMap_mk, RingEquiv.toRingHom_eq_coe,
    RingEquiv.coe_toRingHom, AlgEquiv.coe_toRingEquiv, AlgHom.toRingHom_eq_coe,
    AlgHom.coe_toRingHom, faceQuotientEquiv_mk] using
      DFunLike.congr_fun (F.mapRingHom_comp_faceRestriction hF f).symm p

end AddSubmonoid
