/-!
# Monoid algebras over a local ring

For a finite monoid `G` (for instance a finite group) and a local ring `R` with residue field `k`,
the free module `R[G]^ι` of finite rank is a finitely generated `R`-module, so Nakayama's lemma
over `R` detects surjectivity of its endomorphisms after reduction to `k[G]^ι`.
The Orzech property then upgrades surjectivity to bijectivity.

For a commutative `p`-group `Q` and a local ring `R` in which `p` is not a unit, the group
algebra `R[Q]` is itself local, and the augmentation `R[Q] → R` is a local homomorphism: an element
of `R[Q]` is a unit as soon as its augmentation is. Indeed every maximal ideal of `R[Q]` lies over
the maximal ideal of `R`, because `R[Q]` is integral over `R`, so its residue field has
characteristic `p`; there `q - 1` is nilpotent, as `(q - 1) ^ (p ^ k) = q ^ (p ^ k) - 1 = 0`, and
therefore zero. So every maximal ideal contains the augmentation ideal.

For a finite, possibly noncommutative, `p`-group `P` the same conclusions hold by a different
argument, as the commutative argument through maximal ideals does not apply. Units of
`R[P]` are detected in `k[P]` by Nakayama's lemma. Over a ring of characteristic `p`, every element
of augmentation zero in the group algebra of a finite `p`-group is nilpotent: modulo a nontrivial
central element `z` this holds by induction on the order of the group, and the kernel of the
reduction is generated by the central element `z - 1`, whose `p ^ k`-th power vanishes.
Conversely, if `R[G]` is local and `g ^ n = 1` with `n` a unit in `R`, then `g = 1`, because
`n⁻¹ ∑_{i < n} gⁱ` is an idempotent with augmentation `1`. So for a finite group `G` and a local
ring `R` in which `p` is not a unit, `R[G]` is local exactly when `G` is a `p`-group.

## Main results

* `TauCeti.MonoidAlgebra.bijective_of_forall_exists_mapRingHom_residue_eq`: an `R[G]`-linear
  endomorphism of `R[G]^ι` that is onto modulo the maximal ideal is bijective.
* `TauCeti.MonoidAlgebra.isLocalHom_mapRingHom_residue`: for a finite monoid `G`, an element of
  `R[G]` whose image in `k[G]` is a unit is a unit.
* `TauCeti.MonoidAlgebra.isLocalHom_lift_one_of_isPGroup`: for a commutative `p`-group `Q`
  the augmentation `R[Q] → R` is a local homomorphism.
* `TauCeti.MonoidAlgebra.isLocalRing_of_isPGroup`: `R[Q]` is a local ring.
* `TauCeti.MonoidAlgebra.isNilpotent_of_isNilpotent_mapDomainRingHom_mk'`: in characteristic `p`,
  nilpotence lifts along the quotient by a central element of `p`-power order.
* `TauCeti.MonoidAlgebra.isNilpotent_of_augmentation_eq_zero`: in characteristic `p`, elements of
  augmentation zero in the group algebra of a finite `p`-group are nilpotent.
* `TauCeti.MonoidAlgebra.isLocalHom_augmentation_of_isPGroup`,
  `TauCeti.MonoidAlgebra.isLocalRing_of_isPGroup_of_finite`: for a finite `p`-group `P` the
  augmentation `R[P] → R` is a local homomorphism and `R[P]` is a local ring.
* `TauCeti.MonoidAlgebra.eq_one_of_pow_eq_one_of_isUnit`,
  `TauCeti.MonoidAlgebra.isPGroup_of_isLocalRing`: a local group algebra over a ring in which `p`
  is not a unit has only elements of `p`-power order among its torsion.
* `TauCeti.MonoidAlgebra.isLocalRing_iff_isPGroup`: for a finite group `G`, `R[G]` is local if and
  only if `G` is a `p`-group.
-/

public section

open MonoidAlgebra IsLocalRing

namespace TauCeti.MonoidAlgebra

variable {R : Type*} [CommRing R] [IsLocalRing R] {G : Type*} [Monoid G] [Finite G] {ι : Type*}
  [Finite ι]

/-- **Nakayama's lemma for `R[G]^ι`.** An `R[G]`-linear endomorphism of `R[G]^ι` that is onto
modulo the maximal ideal is bijective. -/
theorem bijective_of_forall_exists_mapRingHom_residue_eq
    (θ : (ι → MonoidAlgebra R G) →ₗ[MonoidAlgebra R G] (ι → MonoidAlgebra R G))
    (h : ∀ y : ι → MonoidAlgebra R G, ∃ x, ∀ i,
      mapRingHom G (residue R) (θ x i) = mapRingHom G (residue R) (y i)) :
    Function.Bijective θ := by
  classical
  have := Fintype.ofFinite ι
  -- `R[G]^ι` is a finitely generated `R`-module and `θ` is onto modulo `𝔪 • R[G]^ι`.
  have hle : (⊤ : Submodule R (ι → MonoidAlgebra R G)) ≤
      LinearMap.range (θ.restrictScalars R) ⊔ maximalIdeal R • ⊤ := by
    intro y _
    obtain ⟨x, hx⟩ := h y
    refine Submodule.mem_sup.mpr ⟨θ x, ⟨x, rfl⟩, y - θ x, ?_, add_sub_cancel _ _⟩
    rw [← Finset.univ_sum_single (y - θ x)]
    refine Submodule.sum_mem _ fun i _ ↦ Submodule.smul_top_le_comap_smul_top _
      (LinearMap.single R (fun _ ↦ MonoidAlgebra R G) i) ?_
    rw [← ker_residue, ← mapRingHom_eq_zero_iff, Pi.sub_apply, map_sub, hx, sub_self]
  have hsurj : Function.Surjective θ := LinearMap.range_eq_top.mp (top_unique
    (Submodule.le_of_le_smul_of_le_jacobson Module.Finite.fg_top (ringJacobson_eq_maximalIdeal R).ge
      hle))
  exact ⟨OrzechProperty.injective_of_surjective_endomorphism (θ.restrictScalars R) hsurj, hsurj⟩

/-- **Units of `R[G]` are detected modulo the maximal ideal.** For a finite monoid `G` and a local
ring `R` with residue field `k`, an element of `R[G]` whose image in `k[G]` is a unit is a unit. -/
theorem isLocalHom_mapRingHom_residue : IsLocalHom (mapRingHom G (residue R)) := by
  have hsurj : Function.Surjective (mapRingHom G (residue R)) := by
    rw [coe_mapRingHom]
    exact map_surjective (residue R).toAddMonoidHom residue_surjective
  -- An element whose image is a unit has a left inverse: right multiplication by it is onto
  -- modulo the maximal ideal, hence bijective by Nakayama's lemma.
  have hleft (x : MonoidAlgebra R G) (hx : IsUnit (mapRingHom G (residue R) x)) :
      ∃ y, y * x = 1 := by
    let θ : (Unit → MonoidAlgebra R G) →ₗ[MonoidAlgebra R G] (Unit → MonoidAlgebra R G) :=
      LinearMap.pi fun _ ↦ (LinearMap.toSpanSingleton _ _ x).comp (LinearMap.proj ())
    have hθ := bijective_of_forall_exists_mapRingHom_residue_eq θ fun y ↦ by
      obtain ⟨z, hz⟩ := hsurj (mapRingHom G (residue R) (y ()) * ↑hx.unit⁻¹)
      exact ⟨fun _ ↦ z, fun _ ↦ by simp [θ, hz, mul_assoc]⟩
    obtain ⟨y, hy⟩ := hθ.2 1
    exact ⟨y (), by simpa [θ] using congrFun hy ()⟩
  refine ⟨fun x hx ↦ ?_⟩
  obtain ⟨y, hyx⟩ := hleft x hx
  -- The image of `y` is the inverse of the image of `x`, so `y` has a left inverse too, which
  -- must be `x`.
  have hy : IsUnit (mapRingHom G (residue R) y) := by
    have h : mapRingHom G (residue R) y * ↑hx.unit = 1 := by
      rw [IsUnit.unit_spec, ← map_mul, hyx, map_one]
    rw [Units.mul_eq_one_iff_eq_inv.mp h]
    exact Units.isUnit _
  obtain ⟨z, hzy⟩ := hleft y hy
  have hzx : z = x := by rw [← mul_one z, ← hyx, ← mul_assoc, hzy, one_mul]
  exact ⟨⟨x, y, hzx ▸ hzy, hyx⟩, rfl⟩

section PGroup

variable {R : Type*} [CommRing R] [IsLocalRing R] {p : ℕ} [Fact p.Prime] {Q : Type*} [CommGroup Q]

/-- Every maximal ideal of `R[Q]` contains `q - 1` for each `q` in the `p`-group `Q`. -/
private theorem single_sub_one_mem_of_isMaximal (hp : ¬IsUnit (p : R)) (hQ : IsPGroup p Q)
    (𝔐 : Ideal (MonoidAlgebra R Q)) [𝔐.IsMaximal] (q : Q) : single q (1 : R) - 1 ∈ 𝔐 := by
  -- `R[Q]` is integral over `R`: each group element has order a power of `p`.
  have : Algebra.IsIntegral R (MonoidAlgebra R Q) :=
    TauCeti.MonoidAlgebra.isIntegral_of_isMulTorsion fun m ↦ by
      obtain ⟨k, hk⟩ := hQ m
      exact isOfFinOrder_iff_pow_eq_one.2 ⟨p ^ k, pow_pos (Fact.out : p.Prime).pos k, hk⟩
  -- `𝔐` lies over the maximal ideal of `R`, which contains `p`.
  have hcomap : 𝔐.comap (algebraMap R (MonoidAlgebra R Q)) = maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_under_of_isIntegral_of_isMaximal 𝔐)
  have hp𝔐 : (p : MonoidAlgebra R Q) ∈ 𝔐 := by
    rw [← map_natCast (algebraMap R (MonoidAlgebra R Q)), ← Ideal.mem_comap, hcomap]
    exact hp
  -- In the residue field of `𝔐`, of characteristic `p`, the element `q - 1` is nilpotent.
  let _ := Ideal.Quotient.field 𝔐
  have : CharP (MonoidAlgebra R Q ⧸ 𝔐) p := (CharP.charP_iff_prime_eq_zero Fact.out).mpr <| by
    rw [← map_natCast (Ideal.Quotient.mk 𝔐), Ideal.Quotient.eq_zero_iff_mem]
    exact hp𝔐
  obtain ⟨k, hk⟩ := hQ q
  rw [← Ideal.Quotient.eq_zero_iff_mem,
    ← pow_eq_zero_iff (pow_ne_zero k (Fact.out : p.Prime).ne_zero)]
  simp [sub_pow_char_pow, ← map_pow, single_pow, hk, ← one_def]

/-- **The augmentation of the group algebra of a `p`-group is local.** For a commutative `p`-group
`Q` and a local ring `R` in which `p` is not a unit, the augmentation `R[Q] → R` is a local
homomorphism: an element of `R[Q]` whose augmentation is a unit is a unit. -/
theorem isLocalHom_lift_one_of_isPGroup (hp : ¬IsUnit (p : R)) (hQ : IsPGroup p Q) :
    IsLocalHom (MonoidAlgebra.lift R R Q 1) := by
  refine ⟨fun x hx ↦ ?_⟩
  by_contra hx'
  obtain ⟨𝔐, h𝔐, hx𝔐⟩ := Ideal.exists_le_maximal (Ideal.span {x})
    (by rwa [Ne, Ideal.span_singleton_eq_top])
  have hx𝔐 : x ∈ 𝔐 := hx𝔐 (Ideal.subset_span rfl)
  -- `𝔐` contains the augmentation ideal, which is generated by the differences `q - 1`.
  have hker : RingHom.ker (augmentation R Q) ≤ 𝔐 := by
    rw [ker_augmentation_eq_span, Ideal.span_le]
    rintro _ ⟨q, rfl⟩
    exact single_sub_one_mem_of_isMaximal hp hQ 𝔐 q
  have haug : (MonoidAlgebra.lift R R Q 1 : MonoidAlgebra R Q →+* R) = augmentation R Q :=
    MonoidAlgebra.ringHom_ext (fun _ ↦ by simp [MonoidAlgebra.lift_single]) fun _ ↦ by
      simp [MonoidAlgebra.lift_single]
  -- `x` differs from the constant `algebraMap (augmentation x)` by an element of `𝔐`.
  have hdiff : ∀ y : MonoidAlgebra R Q,
      algebraMap R (MonoidAlgebra R Q) (MonoidAlgebra.lift R R Q 1 y) - y ∈ 𝔐 := fun y ↦
    hker <| by
      rw [RingHom.mem_ker, map_sub, ← RingHom.coe_coe (MonoidAlgebra.lift R R Q 1), haug]
      simp
  have hmem := 𝔐.add_mem (hdiff x) hx𝔐
  rw [sub_add_cancel] at hmem
  exact h𝔐.ne_top (𝔐.eq_top_of_isUnit_mem hmem (hx.map _))

/-- **The group algebra of a `p`-group is local.** For a commutative `p`-group `Q` and a local
ring `R` in which `p` is not a unit, the group algebra `R[Q]` is a local ring. -/
theorem isLocalRing_of_isPGroup (hp : ¬IsUnit (p : R)) (hQ : IsPGroup p Q) :
    IsLocalRing (MonoidAlgebra R Q) :=
  have := isLocalHom_lift_one_of_isPGroup hp hQ
  (MonoidAlgebra.lift R R Q 1 : MonoidAlgebra R Q →+* R).domain_isLocalRing

end PGroup

section CharP

variable {S : Type*} [CommRing S] {p : ℕ} [ExpChar S p]

/-- **Nilpotence lifts along the quotient by a central `p`-element.** In exponential
characteristic `p`, let `z` be a central element of `p`-power order of a group `G`. An element of
`S[G]` whose image in `S[G ⧸ ⟨z⟩]` is nilpotent is nilpotent: the kernel of the reduction consists
of the left multiples of the central element `single z 1 - 1`, whose `p ^ k`-th power vanishes. -/
theorem isNilpotent_of_isNilpotent_mapDomainRingHom_mk' {G : Type*} [Group G] {z : G}
    (hzc : z ∈ Subgroup.center G) {k : ℕ} (hk : z ^ p ^ k = 1) [(Subgroup.zpowers z).Normal]
    {x : MonoidAlgebra S G}
    (hx : IsNilpotent (mapDomainRingHom S (QuotientGroup.mk' (Subgroup.zpowers z)) x)) :
    IsNilpotent x := by
  have : ExpChar (MonoidAlgebra S G) p :=
    expChar_of_injective_algebraMap (R := S)
      (fun a b h ↦ by simpa [MonoidAlgebra.coe_algebraMap] using h) p
  obtain ⟨m, hm⟩ := hx
  -- `x ^ m` lies in the kernel, which is generated by `single z 1 - 1` as a left ideal.
  have hmem : x ^ m ∈ Ideal.span {single z (1 : S) - 1} := by
    have hker : x ^ m ∈ RingHom.ker (mapDomainRingHom S (QuotientGroup.mk' (Subgroup.zpowers z))) :=
      by rw [RingHom.mem_ker, map_pow, hm]
    rw [TauCeti.MonoidAlgebra.ker_mapDomainRingHom_eq_span] at hker
    refine Ideal.span_le.mpr ?_ hker
    rintro _ ⟨⟨g, hg⟩, rfl⟩
    rw [QuotientGroup.ker_mk', Subgroup.zpowers_eq_closure] at hg
    simpa using single_sub_one_mem_span_of_mem_closure S hg
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hmem
  have hcomm : Commute w (single z (1 : S) - 1) :=
    ((single_commute (fun g ↦ (Subgroup.mem_center_iff.mp hzc g).symm)
      (fun r ↦ Commute.one_left r) w).symm.sub_right (Commute.one_right w))
  refine ⟨m * p ^ k, ?_⟩
  rw [pow_mul, ← hw, hcomm.mul_pow, sub_pow_expChar_pow_of_commute _ _ (Commute.one_right _),
    single_pow, one_pow, hk, one_pow, ← one_def, sub_self, mul_zero]

/-- **The augmentation ideal of a finite `p`-group algebra is nil in characteristic `p`.** In the
group algebra of a finite, possibly noncommutative, `p`-group over a commutative ring of
exponential characteristic `p`, every element of augmentation zero is nilpotent. -/
theorem isNilpotent_of_augmentation_eq_zero {P : Type*} [Group P] [Finite P] (hP : IsPGroup p P)
    {x : MonoidAlgebra S P} (hx : augmentation S P x = 0) : IsNilpotent x := by
  induction h : Nat.card P using Nat.strong_induction_on generalizing P with | _ n ih
  rcases subsingleton_or_nontrivial P with hP₁ | hP₁
  · -- Over the trivial group the augmentation is injective.
    have hsingle (y : MonoidAlgebra S P) : y = single 1 (augmentation S P y) := by
      induction y using MonoidAlgebra.induction_linear with
      | zero => simp
      | add y y' hy hy' => rw [map_add, single_add, ← hy, ← hy']
      | single g a => rw [Subsingleton.elim g 1, augmentation_single]
    rw [hsingle x, hx, single_zero]
    exact IsNilpotent.zero
  · have hp : p.Prime := (expChar_is_prime_or_one S p).resolve_right fun hp₁ ↦ by
      obtain ⟨g, hg⟩ := exists_ne (1 : P)
      obtain ⟨k, hk⟩ := hP g
      exact hg (by simpa [hp₁] using hk)
    have := Fact.mk hp
    -- Reduce modulo the subgroup generated by a nontrivial central element `z`, of smaller order.
    have := hP.center_nontrivial
    obtain ⟨⟨z, hzc⟩, hz⟩ := exists_ne (1 : Subgroup.center P)
    have hz : z ≠ 1 := fun h ↦ hz (Subtype.ext h)
    have : (Subgroup.zpowers z).Normal :=
      Subgroup.normal_of_le_center ((Subgroup.zpowers_le).mpr hzc)
    have hcard : Nat.card (P ⧸ Subgroup.zpowers z) < n := by
      rw [← h, ← (Subgroup.zpowers z).card_mul_index, Subgroup.index_eq_card]
      refine lt_mul_of_one_lt_left Nat.card_pos ?_
      rw [Subgroup.one_lt_card_iff_ne_bot, Ne, Subgroup.zpowers_eq_bot]
      exact hz
    obtain ⟨k, hk⟩ := hP z
    exact isNilpotent_of_isNilpotent_mapDomainRingHom_mk' hzc hk <|
      ih _ hcard (hP.to_quotient _) (by
        rw [← RingHom.comp_apply, augmentation_comp_mapDomainRingHom, hx]) rfl

end CharP

section FinitePGroup

variable {R : Type*} [CommRing R] [IsLocalRing R] {p : ℕ} [Fact p.Prime] {P : Type*} [Group P]
  [Finite P]

/-- **The augmentation of the group algebra of a finite `p`-group is local.** For a finite,
possibly noncommutative, `p`-group `P` and a local ring `R` in which `p` is not a unit, an element
of `R[P]` whose augmentation is a unit is a unit. -/
theorem isLocalHom_augmentation_of_isPGroup (hp : ¬IsUnit (p : R)) (hP : IsPGroup p P) :
    IsLocalHom (augmentation R P) := by
  have : ExpChar (ResidueField R) p := by
    have : CharP (ResidueField R) p := (CharP.charP_iff_prime_eq_zero Fact.out).mpr <| by
      rw [← map_natCast (residue R), residue_eq_zero_iff]
      exact hp
    exact .prime Fact.out
  refine ⟨fun x hx ↦ (isLocalHom_mapRingHom_residue (G := P)).map_nonunit x ?_⟩
  -- The image `y` of `x` in `k[P]` has nonzero augmentation `c`, and `y * c⁻¹ - 1` is nilpotent.
  set y := mapRingHom P (residue R) x
  have hc : augmentation (ResidueField R) P y ≠ 0 := by
    have hnat : (augmentation (ResidueField R) P).comp (mapRingHom P (residue R)) =
        (residue R).comp (augmentation R P) :=
      MonoidAlgebra.ringHom_ext (fun _ ↦ by simp) fun _ ↦ by simp
    rw [show augmentation (ResidueField R) P y = residue R (augmentation R P x) from
      RingHom.congr_fun hnat x]
    exact (hx.map (residue R)).ne_zero
  set c := augmentation (ResidueField R) P y
  have hn : IsNilpotent (y * algebraMap _ (MonoidAlgebra (ResidueField R) P) c⁻¹ - 1) :=
    isNilpotent_of_augmentation_eq_zero hP <| by
      simp [MonoidAlgebra.coe_algebraMap, c, hc]
  have hu := (by simpa using hn.isUnit_one_add :
    IsUnit (y * algebraMap _ (MonoidAlgebra (ResidueField R) P) c⁻¹)).mul
    ((isUnit_iff_ne_zero.mpr hc).map (algebraMap _ (MonoidAlgebra (ResidueField R) P)))
  rwa [mul_assoc, ← map_mul, inv_mul_cancel₀ hc, map_one, mul_one] at hu

/-- **The group algebra of a finite `p`-group is local.** For a finite, possibly noncommutative,
`p`-group `P` and a local ring `R` in which `p` is not a unit, the group algebra `R[P]` is a local
ring. -/
theorem isLocalRing_of_isPGroup_of_finite (hp : ¬IsUnit (p : R)) (hP : IsPGroup p P) :
    IsLocalRing (MonoidAlgebra R P) :=
  have := isLocalHom_augmentation_of_isPGroup hp hP
  (augmentation R P).domain_isLocalRing

end FinitePGroup

section Converse

variable {R : Type*} [CommRing R]

/-- **Element orders invertible in the coefficients rule out locality.** If the monoid algebra
`R[G]` is a local ring and `g ^ n = 1` for some `n` that is a unit in `R`, then `g = 1`.
Otherwise `n⁻¹ ∑_{i < n} gⁱ` would be an idempotent of `R[G]` different from `0` and `1`. -/
theorem eq_one_of_pow_eq_one_of_isUnit {G : Type*} [Monoid G] [IsLocalRing (MonoidAlgebra R G)]
    {g : G} {n : ℕ} (hg : g ^ n = 1) (hn : IsUnit (n : R)) : g = 1 := by
  have : Nontrivial R := (algebraMap R (MonoidAlgebra R G)).domain_nontrivial
  set x : MonoidAlgebra R G := single g 1
  set s := ∑ i ∈ Finset.range n, x ^ i
  -- `s` is fixed by right multiplication by `x`, so `s * s = n * s`.
  have hsx : s * x = s := by
    have h := Finset.sum_range_succ' (fun i ↦ x ^ i) n
    rw [Finset.sum_range_succ, pow_zero, show x ^ n = 1 by
      rw [single_pow, one_pow, hg, one_def]] at h
    rw [Finset.sum_mul]
    simp_rw [← pow_succ]
    exact (add_right_cancel h).symm
  have hsxi (i : ℕ) : s * x ^ i = s := by
    induction i with
    | zero => rw [pow_zero, mul_one]
    | succ i ih => rw [pow_succ, ← mul_assoc, ih, hsx]
  have hss : s * s = n * s := by
    rw [Finset.mul_sum, Finset.sum_congr rfl fun i _ ↦ hsxi i, Finset.sum_const, Finset.card_range,
      nsmul_eq_mul]
  -- `e = n⁻¹ * s` is an idempotent with augmentation `1`, fixed by right multiplication by `x`.
  set a := algebraMap R (MonoidAlgebra R G) ↑hn.unit⁻¹
  have ha : a * n = 1 := by
    rw [← map_natCast (algebraMap R (MonoidAlgebra R G)), ← map_mul, hn.val_inv_mul, map_one]
  set e := a * s
  have he : IsIdempotentElem e := by
    rw [isIdempotentElem_iff, mul_assoc, ← mul_assoc s, ← Algebra.commutes, mul_assoc, hss,
      ← mul_assoc a, ← mul_assoc, mul_assoc a, ha, mul_one]
  have he0 : e ≠ 0 := fun h ↦ by
    have := congrArg (augmentation R G) h
    simp only [e, a, s, map_mul, map_sum, map_pow, x, augmentation_single, one_pow,
      Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one, map_zero,
      MonoidAlgebra.coe_algebraMap, Function.comp_apply] at this
    rw [Algebra.algebraMap_self, RingHom.id_apply, hn.val_inv_mul] at this
    exact one_ne_zero this
  -- In a local ring an idempotent is `0` or `1`; so `e = 1`, and then `x = e * x = e = 1`.
  have he1 : e = 1 := by
    refine (IsLocalRing.isUnit_or_isUnit_one_sub_self e).elim
      (fun h ↦ (IsIdempotentElem.iff_eq_one_of_isUnit h).mp he) fun h ↦ (he0 ?_).elim
    rw [← sub_eq_self, (IsIdempotentElem.iff_eq_one_of_isUnit h).mp he.one_sub]
  have hx1 : x = 1 := by rw [← one_mul x, ← he1, mul_assoc, hsx]
  rwa [one_def, single_left_inj one_ne_zero] at hx1

/-- **A local group algebra forces a `p`-group.** If `G` is a torsion group, `R` is a commutative
ring in which the prime `p` is not a unit, and the group algebra `R[G]` is a local ring, then `G`
is a `p`-group. -/
theorem isPGroup_of_isLocalRing {p : ℕ} [Fact p.Prime] {G : Type*} [Group G]
    [IsLocalRing (MonoidAlgebra R G)] (hp : ¬IsUnit (p : R)) (hG : IsMulTorsion G) :
    IsPGroup p G := by
  have : Nontrivial R := (algebraMap R (MonoidAlgebra R G)).domain_nontrivial
  -- `R` is local, as a quotient of `R[G]` along the augmentation.
  have : IsLocalRing R := IsLocalRing.of_surjective' (augmentation R G)
    fun r ↦ ⟨single 1 r, by simp⟩
  intro g
  have hn : orderOf g ≠ 0 := (hG g).orderOf_pos.ne'
  -- Every prime `ℓ` dividing the order of `g` is `p`: otherwise `ℓ` is a unit in `R`, and
  -- `g ^ (orderOf g / ℓ)`, of order `ℓ`, would be trivial.
  have hprime {ℓ : ℕ} (hℓ : ℓ.Prime) (hdvd : ℓ ∣ orderOf g) : ℓ = p := by
    by_contra hne
    have hord := orderOf_pow_orderOf_div hn hdvd
    have hunit : IsUnit (ℓ : R) := by
      by_contra hℓR
      obtain ⟨u, v, huv⟩ := ((Nat.coprime_primes hℓ Fact.out).mpr hne).cast (R := R)
      have h1 : (1 : R) ∈ maximalIdeal R := huv ▸ add_mem
        (Ideal.mul_mem_left _ u ((mem_maximalIdeal _).mpr hℓR))
        (Ideal.mul_mem_left _ v ((mem_maximalIdeal _).mpr hp))
      exact (maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    have := eq_one_of_pow_eq_one_of_isUnit (hord ▸ pow_orderOf_eq_one (g ^ (orderOf g / ℓ))) hunit
    rw [this, orderOf_one] at hord
    exact hℓ.one_lt.ne hord
  exact ⟨_, by
    rw [← Nat.eq_prime_pow_of_unique_prime_dvd hn hprime, pow_orderOf_eq_one]⟩

/-- **The group algebra of a finite group over a local ring is local exactly for `p`-groups.**
For a finite group `G` and a local ring `R` in which the prime `p` is not a unit, the group algebra
`R[G]` is a local ring if and only if `G` is a `p`-group. -/
theorem isLocalRing_iff_isPGroup [IsLocalRing R] {p : ℕ} [Fact p.Prime] {G : Type*} [Group G]
    [Finite G] (hp : ¬IsUnit (p : R)) : IsLocalRing (MonoidAlgebra R G) ↔ IsPGroup p G :=
  ⟨fun _ ↦ isPGroup_of_isLocalRing hp isMulTorsion_of_finite,
    isLocalRing_of_isPGroup_of_finite hp⟩

end Converse

end TauCeti.MonoidAlgebra
