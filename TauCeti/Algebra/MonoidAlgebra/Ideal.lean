/-!
# Monomial ideals of additive monoid algebras

Let `D` be a subset of an additive monoid `M` that is stable under translation: `d + m ∈ D` for
every `m ∈ D` and every `d ∈ M`. The ideal of `R[M]` generated by the coefficient-one monomials
with exponent in `D` then consists exactly of the elements whose coefficients vanish off `D`.

For a commutative ring `R` and a commutative additive monoid `M`, the quotient of `R[M]` by this
ideal is a free `R`-module: the classes of the monomials with exponent outside `D` form a basis,
and the coordinates of the class of `p` are the coefficients of `p` off `D`. This basis is natural
in the coefficient ring: the extension of the ideal along any ring homomorphism `φ : R →+* S` is
the ideal generated by the same monomials over `S`, and the induced map of quotients applies `φ`
to each coordinate. No flatness, injectivity or surjectivity of `φ` is needed. When `D` is
translation-stable and `0 ∉ D`, the coordinate at the exponent `0` of the class of a scalar `r` is
`r` itself, so nonzero nilpotent scalars survive in the quotient.
Without translation stability, `0 ∉ D` does not suffice: in `R[ℤ]` the monomial with exponent `1`
is a unit, so it alone spans the unit ideal. For every set `D`, the formation of the quotient
commutes with base change (`AddMonoidAlgebra.quotientSpanOf'ImageTensorEquiv`, in
`TauCeti.Algebra.MonoidAlgebra.TensorProduct`).

When `M` is canonically ordered and `Q` is an additive monoid, a monomial ideal of `R[M × Q]`
generated by exponents `(a, 0)` with `a` in a set `s ⊆ M` is described by the order of `M`: an
exponent `p` is divisible by `(a, 0)` exactly when `a ≤ p.1`, whatever `p.2` is. For
`M = ι →₀ ℕ`, `s` indexes monomial generators in the coordinates `x_i` of
`R[x_1, …, x_r] ⊗ R[Q]`; the ideals generated by coordinates `x_i` are the case where `s` consists
of coordinate unit vectors `Finsupp.single i 1`.

The quotients of `R[M]` by the monomial ideals above are the coordinate rings of closed subschemes
of affine semigroup schemes cut out by monomials, such as the union of the boundary divisors of a
regular toric chart.

## Main declarations

* `AddMonoidAlgebra.mem_ideal_span_of'_image_iff`: for translation-stable `D`, the monomial ideal
  of `D` consists of the elements whose coefficients vanish off `D`.
* `AddMonoidAlgebra.mem_ideal_span_of'_inl_image_iff`: membership in the monomial ideal of the
  exponents `(a, 0)` with `a ∈ s`, for `M` canonically ordered.
* `AddMonoidAlgebra.map_mapRingHom_ideal_span_of'_image`: changing coefficients extends a monomial
  ideal to the monomial ideal with the same exponents.
* `AddMonoidAlgebra.quotientSpanOf'ImageBasis`: the basis of the quotient by a translation-stable
  monomial ideal given by the monomials off `D`, with `quotientSpanOf'ImageBasis_apply` and
  `quotientSpanOf'ImageBasis_repr_mk`.
* `AddMonoidAlgebra.quotientSpanOf'ImageBasis_repr_quotientMap`: the basis is natural in the
  coefficient ring.

## References

* D. Cox, J. Little and D. O'Shea, *Ideals, Varieties, and Algorithms*, Chapter 2, §4, for monomial
  ideals of polynomial rings.
* The construction by restricting coefficients to the exponents off `D` follows the monomial basis
  `TauCeti.Toric.boundaryQuotientBasis` of the boundary of a regular toric chart, which is the case
  where `D` is the set of exponents with every ray coordinate nonzero.
-/

public section

namespace AddMonoidAlgebra

variable {R M : Type*}

section Semiring

variable [Semiring R] [AddMonoid M] {D : Set M}

/-- If `D` is stable under translation, the ideal spanned by the monomials with exponent in `D`
consists of the elements whose coefficients vanish off `D`. -/
theorem mem_ideal_span_of'_image_iff (hD : ∀ d m, m ∈ D → d + m ∈ D) {p : AddMonoidAlgebra R M} :
    p ∈ Ideal.span (of' R M '' D) ↔ ∀ m ∉ D, p.coeff m = 0 := by
  rw [mem_ideal_span_of'_image]
  refine ⟨fun hp m hm ↦ by_contra fun h ↦ ?_, fun hp m hm ↦ ⟨m, ?_, 0, (zero_add m).symm⟩⟩
  · obtain ⟨m', hm', d, rfl⟩ := hp m (Finsupp.mem_support_iff.mpr h)
    exact hm (hD d m' hm')
  · by_contra h
    exact Finsupp.mem_support_iff.mp hm (hp m h)

/-- Changing the coefficients along any ring homomorphism extends the ideal spanned by a set of
monomials to the ideal spanned by the same monomials over the new coefficients. -/
@[simp]
theorem map_mapRingHom_ideal_span_of'_image {S : Type*} [Semiring S] (φ : R →+* S) (D : Set M) :
    (Ideal.span (of' R M '' D)).map (mapRingHom M φ) = Ideal.span (of' S M '' D) := by
  rw [Ideal.map_span, ← Set.image_comp]
  congr 1
  exact Set.image_congr fun a _ ↦ by simp [of'_apply]

/-- Changing coefficients maps the monomial ideal over `R` into the monomial ideal over `S`. -/
theorem ideal_span_of'_image_le_comap_mapRingHom {S : Type*} [Semiring S] (φ : R →+* S)
    (D : Set M) :
    Ideal.span (of' R M '' D) ≤ (Ideal.span (of' S M '' D)).comap (mapRingHom M φ) :=
  Ideal.map_le_iff_le_comap.mp (map_mapRingHom_ideal_span_of'_image φ D).le

end Semiring

section CanonicallyOrdered

variable [Semiring R] [AddCommMonoid M] [PartialOrder M] [CanonicallyOrderedAdd M] {Q : Type*}
  [AddMonoid Q]

/-- A polynomial lies in the ideal generated by the monomials `(a, 0)` with `a ∈ s` exactly when
its coefficients vanish at every exponent whose first component dominates no element of `s`. -/
theorem mem_ideal_span_of'_inl_image_iff {s : Set M} {x : AddMonoidAlgebra R (M × Q)} :
    x ∈ Ideal.span (of' R (M × Q) '' ((·, (0 : Q)) '' s)) ↔
      ∀ p : M × Q, (∀ a ∈ s, ¬ a ≤ p.1) → x.coeff p = 0 := by
  have hdvd (a : M) (p : M × Q) : (∃ d, p = d + (a, 0)) ↔ a ≤ p.1 := by
    rw [le_iff_exists_add']
    constructor
    · rintro ⟨d, rfl⟩
      exact ⟨d.1, rfl⟩
    · rintro ⟨c, hc⟩
      exact ⟨(c, p.2), Prod.ext hc (add_zero _).symm⟩
  simp only [mem_ideal_span_of'_image, Set.exists_mem_image, hdvd, Finsupp.mem_support_iff]
  exact forall_congr' fun p ↦ not_imp_comm.trans <| by simp

end CanonicallyOrdered

section Coeff

variable [Semiring R] (D : Set M)

/-- The coefficients off `D`, as an `R`-linear map. Its kernel is the monomial ideal of a
translation-stable `D`. -/
private noncomputable def coeffCompl : AddMonoidAlgebra R M →ₗ[R] ↥Dᶜ →₀ R :=
  Finsupp.lcomapDomain Subtype.val Subtype.val_injective ∘ₗ (coeffLinearEquiv R).toLinearMap

private theorem coeffCompl_apply (p : AddMonoidAlgebra R M) (m : ↥Dᶜ) :
    coeffCompl D p m = p.coeff m := by
  simp [coeffCompl]

private theorem coeffCompl_surjective : Function.Surjective (coeffCompl (R := R) D) := by
  intro g
  obtain ⟨f, rfl⟩ := Finsupp.comapDomain_surjective (α := ↥Dᶜ) Subtype.val_injective g
  obtain ⟨p, rfl⟩ := (coeffLinearEquiv R).surjective f
  exact ⟨p, Finsupp.ext fun m ↦ by simp [coeffCompl_apply]⟩

variable [AddMonoid M] {D}

private theorem coeffCompl_eq_zero_iff (hD : ∀ d m, m ∈ D → d + m ∈ D) (p : AddMonoidAlgebra R M) :
    coeffCompl D p = 0 ↔ p ∈ Ideal.span (of' R M '' D) := by
  simp [mem_ideal_span_of'_image_iff hD, Finsupp.ext_iff, coeffCompl_apply]

end Coeff

section CommRing

variable [CommRing R] [AddCommMonoid M] {D : Set M} (hD : ∀ d m, m ∈ D → d + m ∈ D)

include hD in
private theorem ker_coeffCompl :
    LinearMap.ker (coeffCompl (R := R) D) = (Ideal.span (of' R M '' D)).restrictScalars R :=
  Submodule.ext fun p ↦ by
    rw [LinearMap.mem_ker, Submodule.restrictScalars_mem, coeffCompl_eq_zero_iff hD]

variable (R) in
/-- The quotient of `R[M]` by the ideal spanned by the monomials with exponent in a
translation-stable set `D` is free over `R`, with basis the classes of the coefficient-one
monomials with exponent outside `D`. -/
noncomputable def quotientSpanOf'ImageBasis :
    Module.Basis ↥Dᶜ R (AddMonoidAlgebra R M ⧸ Ideal.span (of' R M '' D)) :=
  .ofRepr <| (Submodule.Quotient.restrictScalarsEquiv R _).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _ (ker_coeffCompl hD).symm ≪≫ₗ
    (coeffCompl (R := R) D).quotKerEquivOfSurjective (coeffCompl_surjective D)

/-- The coordinates of the class of `p` in the monomial basis are the coefficients of `p` off
`D`. -/
@[simp]
theorem quotientSpanOf'ImageBasis_repr_mk (p : AddMonoidAlgebra R M) (m : ↥Dᶜ) :
    (quotientSpanOf'ImageBasis R hD).repr (Ideal.Quotient.mk _ p) m = p.coeff m := by
  simp [quotientSpanOf'ImageBasis, ← Ideal.Quotient.mk_eq_mk, coeffCompl_apply]

/-- The basis vector indexed by `m ∉ D` is the class of the monomial `single m 1`. -/
@[simp]
theorem quotientSpanOf'ImageBasis_apply (m : ↥Dᶜ) :
    quotientSpanOf'ImageBasis R hD m =
      Ideal.Quotient.mk (Ideal.span (of' R M '' D)) (single m 1) := by
  classical
  refine (quotientSpanOf'ImageBasis R hD).repr.injective (Finsupp.ext fun n ↦ ?_)
  simp [Finsupp.single_apply, Subtype.val_injective.eq_iff]

variable {S : Type*} [CommRing S] (φ : R →+* S)

/-- The monomial bases of the quotients are natural in the coefficient ring: the coordinates of
the image of a class under the map of quotients induced by changing coefficients are the images of
its coordinates. -/
@[simp]
theorem quotientSpanOf'ImageBasis_repr_quotientMap
    (x : AddMonoidAlgebra R M ⧸ Ideal.span (of' R M '' D)) :
    (quotientSpanOf'ImageBasis S hD).repr
        (Ideal.quotientMap _ (mapRingHom M φ) (ideal_span_of'_image_le_comap_mapRingHom φ D) x) =
      Finsupp.mapRange φ φ.map_zero ((quotientSpanOf'ImageBasis R hD).repr x) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  ext m
  simp

end CommRing

end AddMonoidAlgebra
