module

public import Mathlib.Algebra.MonoidAlgebra.Ideal
public import Mathlib.Algebra.Order.Monoid.Canonical.Defs

/-!
# Monomial ideals in a product with a canonically ordered factor

Let `M` be a canonically ordered additive monoid and `Q` an additive monoid. A monomial ideal of
`k[M × Q]` generated by exponents `(a, 0)` with `a` in a set `s ⊆ M` is described by the order of
`M`: an exponent `p` is divisible by `(a, 0)` exactly when `a ≤ p.1`, whatever `p.2` is. So a
polynomial lies in the ideal exactly when its coefficients vanish at every exponent whose first
component dominates no element of `s`. For `M = ι →₀ ℕ` these are the monomial ideals of the
coordinates `x_i` in `k[x_1, …, x_r] ⊗ k[Q]`.
-/

public section

namespace AddMonoidAlgebra

variable {k : Type*} [Semiring k] {M : Type*} [AddCommMonoid M] [PartialOrder M]
  [CanonicallyOrderedAdd M] {Q : Type*} [AddMonoid Q]

/-- A polynomial lies in the ideal generated by the monomials `(a, 0)` with `a ∈ s` exactly when
its coefficients vanish at every exponent whose first component dominates no element of `s`. -/
theorem mem_ideal_span_of'_inl_image_iff {s : Set M} {x : AddMonoidAlgebra k (M × Q)} :
    x ∈ Ideal.span (of' k (M × Q) '' ((·, (0 : Q)) '' s)) ↔
      ∀ p : M × Q, (∀ a ∈ s, ¬ a ≤ p.1) → x.coeff p = 0 := by
  have hdvd (a : M) (p : M × Q) : (∃ d, p = d + (a, 0)) ↔ a ≤ p.1 := by
    rw [le_iff_exists_add']
    constructor
    · rintro ⟨d, rfl⟩
      exact ⟨d.1, rfl⟩
    · rintro ⟨c, hc⟩
      exact ⟨(c, p.2), Prod.ext hc (add_zero _).symm⟩
  simp only [mem_ideal_span_of'_image, Set.exists_mem_image, hdvd, Finsupp.mem_support_iff]
  exact forall_congr' fun p ↦ not_imp_comm.trans <| by simp

end AddMonoidAlgebra
