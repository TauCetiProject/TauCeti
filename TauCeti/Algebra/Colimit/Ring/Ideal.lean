module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import TauCeti.Algebra.Colimit.Ring.Basic

/-!
# Ideals over directed colimits of rings

Let `I i` be a compatible family of ideals in a directed system of commutative rings `G i`,
indexed by a nonempty directed preorder: the transition maps `f i j` carry `I i` into `I j`. The
colimit ideal of `Ring.DirectLimit G f` is `⨆ i, (I i).map (of G f i)`. This file shows that its
elements are exactly the images of elements of the `I i`, and that the image of an element of a
stage `i` lies in it, or is a unit modulo it, if and only if the same holds for the ideal `I j` at
some stage `j ≥ i`.

The same three statements hold in Mathlib's generic directed colimit `DirectLimit G F`, whose
transition maps `F i j` belong to any class of ring homomorphisms (for instance `A`-algebra maps),
for the colimit ideal `⨆ i, (I i).map (DirectLimit.Ring.of G F i)`. They are transported from
`Ring.DirectLimit` along the isomorphism `TauCeti.Ring.DirectLimit.ringEquivOfEq`, which carries
one colimit ideal to the other.

## Main results

* `TauCeti.Ring.DirectLimit.mem_iSup_map_of_iff`: membership in the colimit ideal.
* `TauCeti.Ring.DirectLimit.of_mem_iSup_map_of_iff`,
  `TauCeti.Ring.DirectLimit.isUnit_quotientMk_of_iff`: the image of an element of a stage `i`
  lies in the colimit ideal, or is a unit modulo it, if and only if this holds for the ideal at
  some stage `j ≥ i`.
* `TauCeti.Ring.DirectLimit.map_ringEquivOfEq_iSup_map`: `ringEquivOfEq` carries the colimit ideal
  of `Ring.DirectLimit G f` to that of `DirectLimit G F`.
* `TauCeti.DirectLimit.Ring.mem_iSup_map_of_iff`, `TauCeti.DirectLimit.Ring.of_mem_iSup_map_of_iff`,
  `TauCeti.DirectLimit.Ring.isUnit_quotientMk_of_iff`: the same three statements for the generic
  colimit `DirectLimit G F`.
-/

public section

namespace TauCeti.Ring.DirectLimit

open _root_.Ring.DirectLimit

section Ring

variable {ι : Type*} [Preorder ι] {G : ι → Type*} [∀ i, CommRing (G i)]
  {f : ∀ i j, i ≤ j → G i →+* G j} {I : ∀ i, Ideal (G i)}

/-- In a directed colimit of rings, the ideal generated by the images of a compatible family of
ideals consists of the images of their elements. -/
@[simp]
theorem mem_iSup_map_of_iff [Nonempty ι] [IsDirectedOrder ι]
    (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (f i j hij))
    {z : _root_.Ring.DirectLimit G (f · · ·)} :
    z ∈ ⨆ i, (I i).map (of G (f · · ·) i) ↔ ∃ i, ∃ x ∈ I i, of G (f · · ·) i x = z := by
  refine ⟨fun hz ↦ ?_, fun ⟨i, x, hx, hxz⟩ ↦
    hxz ▸ Ideal.mem_iSup_of_mem i (Ideal.mem_map_of_mem _ hx)⟩
  -- The images of the elements of the `I i` already form an ideal of the colimit.
  let J : Ideal (_root_.Ring.DirectLimit G (f · · ·)) :=
    { carrier := {z | ∃ i, ∃ x ∈ I i, of G (f · · ·) i x = z}
      zero_mem' := ⟨Classical.arbitrary ι, 0, zero_mem _, map_zero _⟩
      add_mem' := by
        rintro _ _ ⟨i, x, hx, rfl⟩ ⟨j, y, hy, rfl⟩
        obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
        exact ⟨k, f i k hik x + f j k hjk y, add_mem (hI i k hik hx) (hI j k hjk hy),
          by simp⟩
      smul_mem' := by
        rintro c _ ⟨i, x, hx, rfl⟩
        induction c using _root_.Ring.DirectLimit.induction_on with
        | ih j y =>
          obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
          exact ⟨k, f j k hjk y * f i k hik x, Ideal.mul_mem_left _ _ (hI i k hik hx),
            by simp⟩ }
  exact (iSup_le fun i ↦ Ideal.map_le_iff_le_comap.2 fun x hx ↦ ⟨i, x, hx, rfl⟩ :
    ⨆ i, (I i).map (of G (f · · ·) i) ≤ J) hz

/-- The image of an element of a stage lies in the colimit of a compatible family of ideals if and
only if the element is carried into the ideal at some later stage. -/
theorem of_mem_iSup_map_of_iff [IsDirectedOrder ι] [DirectedSystem G (f · · ·)]
    (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (f i j hij)) {i : ι} {x : G i} :
    of G (f · · ·) i x ∈ ⨆ i, (I i).map (of G (f · · ·) i) ↔
      ∃ j, ∃ hij : i ≤ j, f i j hij x ∈ I j := by
  refine ⟨fun hx ↦ ?_, fun ⟨j, hij, hj⟩ ↦
    of_f hij x ▸ Ideal.mem_iSup_of_mem j (Ideal.mem_map_of_mem _ hj)⟩
  have : Nonempty ι := ⟨i⟩
  obtain ⟨m, y, hy, hyx⟩ := (mem_iSup_map_of_iff hI).1 hx
  -- `y` and `x` have the same image in the colimit, so they agree at a common later stage.
  obtain ⟨j, hmj, hij, hj⟩ := of_eq_of_iff.1 hyx
  exact ⟨j, hij, hj ▸ hI m j hmj hy⟩

/-- An element of a stage is a unit modulo the colimit of a compatible family of ideals if and only
if it is a unit modulo the ideal at some later stage. -/
theorem isUnit_quotientMk_of_iff [IsDirectedOrder ι] [DirectedSystem G (f · · ·)]
    (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (f i j hij)) {i : ι} {x : G i} :
    IsUnit (Ideal.Quotient.mk (⨆ i, (I i).map (of G (f · · ·) i)) (of G (f · · ·) i x)) ↔
      ∃ j, ∃ hij : i ≤ j, IsUnit (Ideal.Quotient.mk (I j) (f i j hij x)) := by
  -- For the reverse direction, map the unit along `G j ⧸ I j → colim G ⧸ ⨆ i, (I i).map (of i)`.
  refine ⟨fun hx ↦ ?_, fun ⟨j, hij, hj⟩ ↦ by
    simpa using hj.map (Ideal.quotientMap _ (of G (f · · ·) j)
      (Ideal.map_le_iff_le_comap.1 (le_iSup (fun j ↦ (I j).map (of G (f · · ·) j)) j)))⟩
  have : Nonempty ι := ⟨i⟩
  obtain ⟨u, hu⟩ := hx.exists_left_inv
  obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective u
  obtain ⟨m, v, rfl⟩ := exists_of u
  obtain ⟨k, hik, hmk⟩ := exists_ge_ge i m
  rw [← map_mul, Ideal.Quotient.mk_eq_one_iff_sub_mem] at hu
  obtain ⟨j, hkj, hj⟩ := (of_mem_iSup_map_of_iff hI
    (x := f m k hmk v * f i k hik x - 1)).1 (by simpa using hu)
  refine ⟨j, hik.trans hkj, .of_mul_eq_one_right (Ideal.Quotient.mk _ (f m j (hmk.trans hkj) v)) ?_⟩
  rw [← map_mul, Ideal.Quotient.mk_eq_one_iff_sub_mem]
  simpa [DirectedSystem.map_map' f] using hj

end Ring

section RingHomClass

variable {ι : Type*} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι] {G : ι → Type*}
  [∀ i, CommRing (G i)] {f : ∀ i j, i ≤ j → G i → G j} {T : ∀ ⦃i j : ι⦄, i ≤ j → Type*}
  [∀ i j (h : i ≤ j), FunLike (T h) (G i) (G j)]
  [∀ i j (h : i ≤ j), RingHomClass (T h) (G i) (G j)]
  {F : ∀ i j (h : i ≤ j), T h} [DirectedSystem G (F · · ·)] {I : ∀ i, Ideal (G i)}

/-- The ring isomorphism `ringEquivOfEq` between `Ring.DirectLimit G f` and the generic colimit
`DirectLimit G F` carries the colimit ideal `⨆ i, (I i).map (of G f i)` of a family of ideals to
its counterpart `⨆ i, (I i).map (DirectLimit.Ring.of G F i)`. -/
theorem map_ringEquivOfEq_iSup_map (hF : ∀ i j hij x, F i j hij x = f i j hij x) :
    (⨆ i, (I i).map (of G f i)).map (ringEquivOfEq hF) =
      ⨆ i, (I i).map (_root_.DirectLimit.Ring.of G F i) := by
  simp only [Ideal.map_iSup, ← Ideal.map_coe (ringEquivOfEq hF), Ideal.map_map]
  congr! with i
  ext x
  simp

end RingHomClass

end TauCeti.Ring.DirectLimit

/-! ### The generic colimit -/

namespace TauCeti.DirectLimit.Ring

variable {ι : Type*} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι] {G : ι → Type*}
  [∀ i, CommRing (G i)] {T : ∀ ⦃i j : ι⦄, i ≤ j → Type*}
  [∀ i j (h : i ≤ j), FunLike (T h) (G i) (G j)]
  [∀ i j (h : i ≤ j), RingHomClass (T h) (G i) (G j)]
  {F : ∀ i j (h : i ≤ j), T h} [DirectedSystem G (F · · ·)] {I : ∀ i, Ideal (G i)}

/-- In the generic directed colimit of commutative rings, the ideal generated by the images of a
compatible family of ideals consists of the images of their elements. -/
@[simp]
theorem mem_iSup_map_of_iff (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (F i j hij))
    {z : _root_.DirectLimit G F} :
    z ∈ ⨆ i, (I i).map (_root_.DirectLimit.Ring.of G F i) ↔
      ∃ i, ∃ x ∈ I i, _root_.DirectLimit.Ring.of G F i x = z := by
  -- Transport the statement for `Ring.DirectLimit` along `ringEquivOfEq`.
  let f i j (h : i ≤ j) : G i →+* G j := F i j h
  have hF i j hij (y : G i) : F i j hij y = f i j hij y := by simp [f]
  have hI' i j hij : I i ≤ (I j).comap (f i j hij) := by
    simpa only [f, Ideal.comap_coe] using hI i j hij
  rw [← TauCeti.Ring.DirectLimit.map_ringEquivOfEq_iSup_map hF, Ideal.mem_map_of_equiv]
  simp [TauCeti.Ring.DirectLimit.mem_iSup_map_of_iff hI']

/-- In the generic directed colimit of commutative rings, the image of an element of a stage lies
in the colimit of a compatible family of ideals if and only if the element is carried into the
ideal at some later stage. -/
theorem of_mem_iSup_map_of_iff (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (F i j hij)) {i : ι}
    {x : G i} :
    _root_.DirectLimit.Ring.of G F i x ∈ ⨆ i, (I i).map (_root_.DirectLimit.Ring.of G F i) ↔
      ∃ j, ∃ hij : i ≤ j, F i j hij x ∈ I j := by
  -- Transport the statement for `Ring.DirectLimit` along `ringEquivOfEq`.
  let f i j (h : i ≤ j) : G i →+* G j := F i j h
  have hF i j hij (y : G i) : F i j hij y = f i j hij y := by simp [f]
  have hI' i j hij : I i ≤ (I j).comap (f i j hij) := by
    simpa only [f, Ideal.comap_coe] using hI i j hij
  have : DirectedSystem G (f · · ·) := by simpa only [f, RingHom.coe_coe]
  rw [← TauCeti.Ring.DirectLimit.ringEquivOfEq_of hF,
    ← TauCeti.Ring.DirectLimit.map_ringEquivOfEq_iSup_map hF, Ideal.apply_mem_of_equiv_iff]
  simpa only [f, RingHom.coe_coe] using TauCeti.Ring.DirectLimit.of_mem_iSup_map_of_iff hI'

/-- In the generic directed colimit of commutative rings, an element of a stage is a unit modulo
the colimit of a compatible family of ideals if and only if it is a unit modulo the ideal at some
later stage. -/
theorem isUnit_quotientMk_of_iff (hI : ∀ i j (hij : i ≤ j), I i ≤ (I j).comap (F i j hij))
    {i : ι} {x : G i} :
    IsUnit (Ideal.Quotient.mk (⨆ i, (I i).map (_root_.DirectLimit.Ring.of G F i))
      (_root_.DirectLimit.Ring.of G F i x)) ↔
      ∃ j, ∃ hij : i ≤ j, IsUnit (Ideal.Quotient.mk (I j) (F i j hij x)) := by
  -- Transport the statement for `Ring.DirectLimit` along `ringEquivOfEq` and the isomorphism of
  -- quotients it induces.
  let f i j (h : i ≤ j) : G i →+* G j := F i j h
  have hF i j hij (y : G i) : F i j hij y = f i j hij y := by simp [f]
  have hI' i j hij : I i ≤ (I j).comap (f i j hij) := by
    simpa only [f, Ideal.comap_coe] using hI i j hij
  have : DirectedSystem G (f · · ·) := by simpa only [f, RingHom.coe_coe]
  rw [← TauCeti.Ring.DirectLimit.ringEquivOfEq_of hF, ← Ideal.quotientEquiv_mk _ _ _
    (TauCeti.Ring.DirectLimit.map_ringEquivOfEq_iSup_map hF).symm, isUnit_map_iff]
  simpa only [f, RingHom.coe_coe] using TauCeti.Ring.DirectLimit.isUnit_quotientMk_of_iff hI'

end TauCeti.DirectLimit.Ring
