module

public import Mathlib.Algebra.Algebra.Subalgebra.Directed
public import Mathlib.Algebra.Algebra.Subalgebra.Pointwise
public import Mathlib.RingTheory.Adjoin.Basic

/-!
# Subalgebras generated by the initial terms of a sequence

For a sequence `g : ℕ → A` in an `R`-algebra, `TauCeti.Algebra.adjoinPrefix R g n` is the
subalgebra `Aₙ` generated by `g 0, …, g (n - 1)`. These subalgebras increase with `n` and start at
the scalars.

As a submodule, `Aₙ₊₁` always contains `Aₙ + Aₙ gₙ Aₙ`
(`TauCeti.Algebra.adjoinPrefixSplit R g n`). It is equal to it when the sequence behaves like the
generators of a type-A Hecke algebra or of a Temperley–Lieb-type algebra: distant terms commute,
`gₙ²` lies in `Aₙ + Aₙ gₙ Aₙ`, and `gₙ₊₁ gₙ gₙ₊₁` lies in `Aₙ₊₁ + Aₙ₊₁ gₙ₊₁ Aₙ₊₁`
(`TauCeti.Algebra.toSubmodule_adjoinPrefix_succ`). This is the bimodule decomposition along which
Markov traces are determined recursively.

## Main definitions

* `TauCeti.Algebra.adjoinPrefix R g n`: the subalgebra generated by `g 0, …, g (n - 1)`.
* `TauCeti.Algebra.adjoinPrefixSplit R g n`: the submodule `Aₙ + Aₙ gₙ Aₙ`.

## Main results

* `TauCeti.Algebra.iSup_adjoinPrefix`: the subalgebras `Aₙ` exhaust the subalgebra generated by the
  whole sequence.
* `TauCeti.Algebra.toSubmodule_adjoinPrefix_succ`: `Aₙ₊₁ = Aₙ + Aₙ gₙ Aₙ` for Hecke-type
  sequences.
* `TauCeti.Algebra.toSubmodule_adjoinPrefix_succ_le_iff`: the resulting criterion for `Aₙ₊₁` to
  lie in a submodule.
-/

public section

namespace TauCeti.Algebra

variable (R : Type*) {A : Type*} [CommSemiring R] [Semiring A] [Algebra R A]

/-- The subalgebra generated by the first `n` terms `g 0, …, g (n - 1)` of a sequence. -/
def adjoinPrefix (g : ℕ → A) (n : ℕ) : Subalgebra R A :=
  Algebra.adjoin R (Set.range fun i : Fin n ↦ g i)

variable {R} {g : ℕ → A}

variable (R g) in
/-- `Aₙ` is the subalgebra generated by `g 0, …, g (n - 1)`. -/
theorem adjoinPrefix_def (n : ℕ) :
    adjoinPrefix R g n = Algebra.adjoin R (Set.range fun i : Fin n ↦ g i) :=
  (rfl)

/-- Each of the first `n` terms lies in the subalgebra they generate. -/
theorem apply_mem_adjoinPrefix {i n : ℕ} (h : i < n) : g i ∈ adjoinPrefix R g n :=
  Algebra.subset_adjoin ⟨⟨i, h⟩, rfl⟩

/-- `Aₙ` lies in a subalgebra exactly when the first `n` terms do. -/
theorem adjoinPrefix_le_iff {n : ℕ} {S : Subalgebra R A} :
    adjoinPrefix R g n ≤ S ↔ ∀ i < n, g i ∈ S := by
  rw [adjoinPrefix_def, Algebra.adjoin_le_iff, Set.range_subset_iff]
  exact ⟨fun h i hi ↦ h ⟨i, hi⟩, fun h i ↦ h i i.isLt⟩

variable (R g) in
/-- The subalgebras generated by the initial terms increase. -/
theorem adjoinPrefix_mono : Monotone (adjoinPrefix R g) :=
  fun _ _ hmn ↦ adjoinPrefix_le_iff.2 fun _ hi ↦ apply_mem_adjoinPrefix (hi.trans_le hmn)

/-- An element commuting with the first `n` terms commutes with the subalgebra they generate. -/
theorem commute_of_mem_adjoinPrefix {n : ℕ} {x y : A} (h : ∀ i < n, Commute y (g i))
    (hx : x ∈ adjoinPrefix R g n) : Commute y x :=
  Algebra.commute_of_mem_adjoin_of_forall_mem_commute hx <| by
    rintro _ ⟨i, rfl⟩
    exact h i i.isLt

variable (R g) in
/-- No term generates the scalars. -/
@[simp]
theorem adjoinPrefix_zero : adjoinPrefix R g 0 = ⊥ :=
  le_bot_iff.1 <| adjoinPrefix_le_iff.2 fun _ hi ↦ absurd hi (Nat.not_lt_zero _)

variable (R g) in
/-- The subalgebras generated by the initial terms exhaust the subalgebra generated by the whole
sequence. -/
theorem iSup_adjoinPrefix : ⨆ n, adjoinPrefix R g n = Algebra.adjoin R (Set.range g) := by
  refine le_antisymm (iSup_le fun _ ↦ adjoinPrefix_le_iff.2 fun i _ ↦
    Algebra.subset_adjoin ⟨i, rfl⟩) ?_
  rw [Algebra.adjoin_le_iff, Set.range_subset_iff]
  exact fun i ↦ le_iSup (adjoinPrefix R g) (i + 1) (apply_mem_adjoinPrefix i.lt_add_one)

/-- An element of the subalgebra generated by a sequence lies in the subalgebra generated by
finitely many of its initial terms. -/
theorem exists_mem_adjoinPrefix {x : A} (hx : x ∈ Algebra.adjoin R (Set.range g)) :
    ∃ n, x ∈ adjoinPrefix R g n := by
  rwa [← iSup_adjoinPrefix, ← SetLike.mem_coe,
    Subalgebra.coe_iSup_of_directed (adjoinPrefix_mono R g).directed_le, Set.mem_iUnion] at hx

section Split

/-! ### The submodule `Aₙ + Aₙ gₙ Aₙ` -/

variable (R g) in
/-- The submodule `Aₙ + Aₙ gₙ Aₙ` spanned by the subalgebra `Aₙ` generated by `g 0, …, g (n - 1)`
and the products `a * g n * b` with `a`, `b ∈ Aₙ`. -/
def adjoinPrefixSplit (n : ℕ) : Submodule R A :=
  Subalgebra.toSubmodule (adjoinPrefix R g n) ⊔
    Subalgebra.toSubmodule (adjoinPrefix R g n) * (R ∙ g n) *
      Subalgebra.toSubmodule (adjoinPrefix R g n)

variable (R g) in
/-- `Aₙ + Aₙ gₙ Aₙ` is the supremum of `Aₙ` and the product submodule `Aₙ (R ∙ gₙ) Aₙ`. -/
theorem adjoinPrefixSplit_def (n : ℕ) :
    adjoinPrefixSplit R g n = Subalgebra.toSubmodule (adjoinPrefix R g n) ⊔
      Subalgebra.toSubmodule (adjoinPrefix R g n) * (R ∙ g n) *
        Subalgebra.toSubmodule (adjoinPrefix R g n) :=
  (rfl)

/-- `Aₙ` lies in `Aₙ + Aₙ gₙ Aₙ`. -/
theorem mem_adjoinPrefixSplit_of_mem {n : ℕ} {a : A} (ha : a ∈ adjoinPrefix R g n) :
    a ∈ adjoinPrefixSplit R g n :=
  Submodule.mem_sup_left ha

/-- The products `a * g n * b` with `a`, `b ∈ Aₙ` lie in `Aₙ + Aₙ gₙ Aₙ`. -/
theorem mul_apply_mul_mem_adjoinPrefixSplit {n : ℕ} {a b : A} (ha : a ∈ adjoinPrefix R g n)
    (hb : b ∈ adjoinPrefix R g n) : a * g n * b ∈ adjoinPrefixSplit R g n :=
  Submodule.mem_sup_right <| Submodule.mul_mem_mul
    (Submodule.mul_mem_mul ha (Submodule.mem_span_singleton_self _)) hb

/-- The term `g n` lies in `Aₙ + Aₙ gₙ Aₙ`. -/
theorem apply_mem_adjoinPrefixSplit (n : ℕ) : g n ∈ adjoinPrefixSplit R g n := by
  simpa only [one_mul, mul_one] using mul_apply_mul_mem_adjoinPrefixSplit (g := g)
    (one_mem (adjoinPrefix R g n)) (one_mem _)

/-- `Aₙ + Aₙ gₙ Aₙ` lies in a submodule exactly when `Aₙ` and the products `a * g n * b` with
`a`, `b ∈ Aₙ` do. -/
theorem adjoinPrefixSplit_le_iff {n : ℕ} {P : Submodule R A} :
    adjoinPrefixSplit R g n ≤ P ↔ Subalgebra.toSubmodule (adjoinPrefix R g n) ≤ P ∧
      ∀ a ∈ adjoinPrefix R g n, ∀ b ∈ adjoinPrefix R g n, a * g n * b ∈ P := by
  refine sup_le_iff.trans <| and_congr_right fun _ ↦
    ⟨fun h a ha b hb ↦ h (Submodule.mul_mem_mul
      (Submodule.mul_mem_mul ha (Submodule.mem_span_singleton_self _)) hb), fun h ↦ ?_⟩
  refine Submodule.mul_le.2 fun y hy b hb ↦ ?_
  obtain ⟨a, ha, rfl⟩ := Submodule.mem_mul_span_singleton.1 hy
  exact h a ha b hb

/-- `Aₙ + Aₙ gₙ Aₙ` is stable under left multiplication by `Aₙ`. -/
private theorem toSubmodule_adjoinPrefix_mul_adjoinPrefixSplit (n : ℕ) :
    Subalgebra.toSubmodule (adjoinPrefix R g n) * adjoinPrefixSplit R g n =
      adjoinPrefixSplit R g n := by
  simp only [adjoinPrefixSplit_def, Submodule.mul_sup, ← mul_assoc,
    (Subalgebra.isIdempotentElem_toSubmodule (adjoinPrefix R g n)).eq]

/-- `Aₙ + Aₙ gₙ Aₙ` is stable under right multiplication by `Aₙ`. -/
private theorem adjoinPrefixSplit_mul_toSubmodule_adjoinPrefix (n : ℕ) :
    adjoinPrefixSplit R g n * Subalgebra.toSubmodule (adjoinPrefix R g n) =
      adjoinPrefixSplit R g n := by
  simp only [adjoinPrefixSplit_def, Submodule.sup_mul, mul_assoc,
    (Subalgebra.isIdempotentElem_toSubmodule (adjoinPrefix R g n)).eq]

/-- `Aₙ + Aₙ gₙ Aₙ` is stable under multiplication by `Aₙ` on both sides. -/
private theorem mul_mul_mem_adjoinPrefixSplit {n : ℕ} {d x f : A} (hd : d ∈ adjoinPrefix R g n)
    (hx : x ∈ adjoinPrefixSplit R g n) (hf : f ∈ adjoinPrefix R g n) :
    d * x * f ∈ adjoinPrefixSplit R g n := by
  rw [← adjoinPrefixSplit_mul_toSubmodule_adjoinPrefix,
    ← toSubmodule_adjoinPrefix_mul_adjoinPrefixSplit]
  exact Submodule.mul_mem_mul (Submodule.mul_mem_mul hd hx) hf

/-- `Aₙ + Aₙ gₙ Aₙ` is stable under left multiplication by `gₙ` as soon as `gₙ Aₙ gₙ` lies in
it. -/
private theorem apply_mul_mem_adjoinPrefixSplit_of_forall {n : ℕ}
    (h : ∀ a ∈ adjoinPrefix R g n, g n * a * g n ∈ adjoinPrefixSplit R g n)
    {m : A} (hm : m ∈ adjoinPrefixSplit R g n) : g n * m ∈ adjoinPrefixSplit R g n := by
  obtain ⟨m₁, hm₁, m₂, hm₂, rfl⟩ := Submodule.mem_sup.1 hm
  clear hm
  rw [mul_add]
  refine add_mem ?_ ?_
  · simpa only [one_mul] using mul_apply_mul_mem_adjoinPrefixSplit (one_mem _) hm₁
  · induction hm₂ using Submodule.mul_induction_on' with
    | mem_mul_mem y hy b hb =>
      obtain ⟨a, ha, rfl⟩ := Submodule.mem_mul_span_singleton.1 hy
      rw [← adjoinPrefixSplit_mul_toSubmodule_adjoinPrefix, ← mul_assoc, ← mul_assoc]
      exact Submodule.mul_mem_mul (h a ha) hb
    | add y _ y' _ hy hy' =>
      rw [mul_add]
      exact add_mem hy hy'

/-- `Aₙ₊₁` lies in `Aₙ + Aₙ gₙ Aₙ` as soon as `gₙ Aₙ gₙ` does. -/
private theorem toSubmodule_adjoinPrefix_succ_le_adjoinPrefixSplit {n : ℕ}
    (h : ∀ a ∈ adjoinPrefix R g n, g n * a * g n ∈ adjoinPrefixSplit R g n) :
    Subalgebra.toSubmodule (adjoinPrefix R g (n + 1)) ≤ adjoinPrefixSplit R g n := by
  -- `Aₙ + Aₙ gₙ Aₙ` contains `1` and is stable under left multiplication by `Aₙ₊₁`.
  intro x hx
  rw [Subalgebra.mem_toSubmodule, adjoinPrefix_def] at hx
  suffices key : ∀ m ∈ adjoinPrefixSplit R g n, x * m ∈ adjoinPrefixSplit R g n by
    simpa only [mul_one] using key 1 (mem_adjoinPrefixSplit_of_mem (one_mem _))
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    dsimp only
    rcases Nat.lt_succ_iff_lt_or_eq.1 i.isLt with hi | hi
    · intro m hm
      rw [← toSubmodule_adjoinPrefix_mul_adjoinPrefixSplit]
      exact Submodule.mul_mem_mul (apply_mem_adjoinPrefix hi) hm
    · intro m hm
      rw [hi]
      exact apply_mul_mem_adjoinPrefixSplit_of_forall h hm
  | algebraMap r =>
    intro m hm
    rw [← Algebra.smul_def]
    exact Submodule.smul_mem _ r hm
  | add x y _ _ hx hy =>
    intro m hm
    rw [add_mul]
    exact add_mem (hx m hm) (hy m hm)
  | mul x y _ _ hx hy =>
    intro m hm
    rw [mul_assoc]
    exact hx _ (hy m hm)

/-- **The bimodule decomposition.** As a submodule, `Aₙ₊₁` is `Aₙ + Aₙ gₙ Aₙ` as soon as distant
terms of the sequence commute, `gₙ²` lies in `Aₙ + Aₙ gₙ Aₙ` and `gₙ₊₁ gₙ gₙ₊₁` lies in
`Aₙ₊₁ + Aₙ₊₁ gₙ₊₁ Aₙ₊₁`. -/
theorem toSubmodule_adjoinPrefix_succ (hcomm : ∀ i j, i + 1 < j → Commute (g j) (g i))
    (hsq : ∀ n, g n * g n ∈ adjoinPrefixSplit R g n)
    (hbraid : ∀ n, g (n + 1) * g n * g (n + 1) ∈ adjoinPrefixSplit R g (n + 1)) (n : ℕ) :
    Subalgebra.toSubmodule (adjoinPrefix R g (n + 1)) = adjoinPrefixSplit R g n := by
  refine le_antisymm ?_ <| adjoinPrefixSplit_le_iff.2
    ⟨fun x hx ↦ adjoinPrefix_mono R g n.le_succ hx, fun a ha b hb ↦
      (Subalgebra.mem_toSubmodule _).2 <| mul_mem
      (mul_mem (adjoinPrefix_mono R g n.le_succ ha) (apply_mem_adjoinPrefix n.lt_succ_self))
      (adjoinPrefix_mono R g n.le_succ hb)⟩
  induction n with
  | zero =>
    refine toSubmodule_adjoinPrefix_succ_le_adjoinPrefixSplit fun a ha ↦ ?_
    rw [adjoinPrefix_zero, Algebra.mem_bot] at ha
    obtain ⟨r, rfl⟩ := ha
    rw [← Algebra.commutes, mul_assoc, ← Algebra.smul_def]
    exact Submodule.smul_mem _ r (hsq 0)
  | succ m ih =>
    -- Split `a ∈ Aₘ₊₁` as `Aₘ + Aₘ gₘ Aₘ`; then `gₘ₊₁` commutes past `Aₘ`.
    refine toSubmodule_adjoinPrefix_succ_le_adjoinPrefixSplit fun a ha ↦ ?_
    have hc : ∀ d ∈ adjoinPrefix R g m, g (m + 1) * d = d * g (m + 1) := fun _ hd ↦
      (commute_of_mem_adjoinPrefix (fun i hi ↦ hcomm i (m + 1) (by omega)) hd).eq
    have hd : ∀ {d}, d ∈ adjoinPrefix R g m → d ∈ adjoinPrefix R g (m + 1) :=
      fun h ↦ adjoinPrefix_mono R g m.le_succ h
    let P : Submodule R A := (adjoinPrefixSplit R g (m + 1)).comap
      (LinearMap.mulLeftRight R (g (m + 1), g (m + 1)))
    have hP : ∀ a, a ∈ P ↔ g (m + 1) * a * g (m + 1) ∈ adjoinPrefixSplit R g (m + 1) :=
      fun _ ↦ by rw [Submodule.mem_comap, LinearMap.mulLeftRight_apply]
    refine (hP a).1 <| (ih.trans (adjoinPrefixSplit_le_iff.2 ⟨fun d hd' ↦ (hP d).2 ?_,
      fun d hd' f hf ↦ (hP _).2 ?_⟩)) ha
    · rw [hc d hd', mul_assoc]
      simpa only [mul_one] using mul_mul_mem_adjoinPrefixSplit (hd hd') (hsq (m + 1)) (one_mem _)
    · have : g (m + 1) * (d * g m * f) * g (m + 1) = d * (g (m + 1) * g m * g (m + 1)) * f := by
        rw [← mul_assoc, ← mul_assoc, hc d hd', mul_assoc _ f, ← hc f hf]
        simp only [mul_assoc]
      rw [this]
      exact mul_mul_mem_adjoinPrefixSplit (hd hd') (hbraid m) (hd hf)

/-- For a Hecke-type sequence, `Aₙ₊₁` lies in a submodule exactly when `Aₙ` and the products
`a * g n * b` with `a`, `b ∈ Aₙ` do. -/
theorem toSubmodule_adjoinPrefix_succ_le_iff (hcomm : ∀ i j, i + 1 < j → Commute (g j) (g i))
    (hsq : ∀ n, g n * g n ∈ adjoinPrefixSplit R g n)
    (hbraid : ∀ n, g (n + 1) * g n * g (n + 1) ∈ adjoinPrefixSplit R g (n + 1)) {n : ℕ}
    {P : Submodule R A} :
    Subalgebra.toSubmodule (adjoinPrefix R g (n + 1)) ≤ P ↔
      Subalgebra.toSubmodule (adjoinPrefix R g n) ≤ P ∧
        ∀ a ∈ adjoinPrefix R g n, ∀ b ∈ adjoinPrefix R g n, a * g n * b ∈ P := by
  rw [toSubmodule_adjoinPrefix_succ hcomm hsq hbraid]
  exact adjoinPrefixSplit_le_iff

end Split

end TauCeti.Algebra
