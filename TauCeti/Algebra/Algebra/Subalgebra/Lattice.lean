module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Supplements to the lattice of subalgebras

This file collects two small facts about subalgebras that Mathlib's
`Mathlib.Algebra.Algebra.Subalgebra.Lattice` does not state.

For an injective `algebraMap R A`, `Algebra.botEquivOfInjective` identifies the bottom subalgebra
`⊥` of `A` with `R`. Mathlib states it without `@[simps]` — unlike `Algebra.botEquiv`, which
carries `@[simps! symm_apply]` — so nothing names its value on an element. This file supplies the
equation in the direction a caller needs: applying `algebraMap R A` to the result returns the
element itself.

Adjoining a multiplicatively closed set containing `1` (a submonoid, subring, subalgebra, …)
creates nothing beyond its span: the products that `Algebra.adjoin` forms lie in the set again.

## Main results

* `Algebra.algebraMap_botEquivOfInjective`: `algebraMap R A (botEquivOfInjective h x) = x` for
  `x : (⊥ : Subalgebra R A)`.
* `Algebra.adjoin_coe_eq_span`: for a submonoid-like `M` of `A`, `Algebra.adjoin R (M : Set A)`,
  as a submodule, is `Submodule.span R (M : Set A)`.
-/

public section

namespace Algebra

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R A]

/-- **`algebraMap R A` undoes `botEquivOfInjective`.** The equiv sends an element of `⊥` to the
scalar it comes from, so mapping that scalar back into `A` returns the element. -/
@[simp]
theorem algebraMap_botEquivOfInjective (h : Function.Injective (algebraMap R A))
    (x : (⊥ : Subalgebra R A)) : algebraMap R A (botEquivOfInjective h x) = (x : A) := by
  -- The inverse equiv's `AlgEquiv.commutes`, read in `A` through `Subalgebra.coe_algebraMap`.
  simpa using
    congr_arg Subtype.val ((botEquivOfInjective h).symm.commutes (botEquivOfInjective h x)).symm

variable (R) in
/-- The subalgebra generated by a submonoid-like set `M` (a submonoid, subsemiring, subring,
subalgebra, …) is, as a submodule, the span of `M`: `M` is already closed under multiplication and
contains `1`, so adjoining it creates no products that its span misses. -/
theorem adjoin_coe_eq_span {M₀ : Type*} [SetLike M₀ A] [SubmonoidClass M₀ A] (M : M₀) :
    Subalgebra.toSubmodule (adjoin R (M : Set A)) = Submodule.span R (M : Set A) :=
  adjoin_eq_span_of_subset R <| .trans
    (SetLike.coe_subset_coe.2 <| (Submonoid.closure_le (S := .ofClass M)).2 subset_rfl)
    Submodule.subset_span

end Algebra

end
