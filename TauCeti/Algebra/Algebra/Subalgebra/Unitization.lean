module

public import Mathlib.Algebra.Algebra.Subalgebra.Unitization

/-!
# The vector subspace underlying a unitized subalgebra

Adjoining the identity to a nonunital subalgebra adds just the scalar line. This identifies
the underlying subspace of the internal unitization, for instance when proving closedness
in normed algebras. The result generalizes Mathlib's
`Algebra.adjoin_nonUnitalSubalgebra_eq_span` to noncommutative ambient algebras, using the
same span calculation.
-/

public section

namespace NonUnitalSubalgebra

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R A]

/-- The unital subalgebra generated by a nonunital subalgebra is the sum of its underlying
subspace and the scalar line, also when the ambient algebra is noncommutative. -/
theorem adjoin_toSubmodule (B : NonUnitalSubalgebra R A) :
    (Algebra.adjoin R (B : Set A)).toSubmodule = Submodule.span R {1} ⊔ B.toSubmodule := by
  rw [Algebra.adjoin_eq_span, Submonoid.closure_eq_one_union, Submodule.span_union,
    ← NonUnitalAlgebra.adjoin_eq_span, NonUnitalAlgebra.adjoin_eq]

end NonUnitalSubalgebra
