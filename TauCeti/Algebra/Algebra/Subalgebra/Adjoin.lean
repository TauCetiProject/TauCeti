module

public import Mathlib.RingTheory.Adjoin.Basic

/-!
# Generators and vector subspaces of generated algebras

An affine image `a x + b` of an element `x` of an algebra, with `a` a unit of the base ring,
generates the same subalgebra as `x`: `a x + b` lies in the algebra generated by
`x`, and `x = a⁻¹ (a x + b) - a⁻¹ b` lies in the algebra generated by `a x + b`. In particular
`a x + b` generates the whole algebra whenever `x` does.

Adjoining the identity to a nonunital subalgebra adds just the scalar line. The underlying
subspace calculation generalizes Mathlib's `Algebra.adjoin_nonUnitalSubalgebra_eq_span`
to noncommutative ambient algebras, using the same span calculation.

## Main results

* `TauCeti.Algebra.adjoin_algebraMap_mul_add_algebraMap_eq_adjoin`: an affine change with a
  unit multiplier generates the same subalgebra.
* `TauCeti.Algebra.adjoin_two_mul_sub_one_eq_top`: `2x - 1` generates the whole algebra when
  `x` does and `2` is a unit.
* `NonUnitalSubalgebra.adjoin_eq_span_one_sup`: adjoining the identity adds the scalar line
  to the underlying submodule.
-/

public section

namespace TauCeti.Algebra

variable {F E : Type*} [CommRing F] [Ring E] [Algebra F E]

/-- **An affine change with a unit multiplier generates the same subalgebra.** If `a` is a
unit of the commutative ring `F`, then `a x + b` and `x` generate the same subalgebra of the
`F`-algebra `E`. -/
theorem adjoin_algebraMap_mul_add_algebraMap_eq_adjoin {a : F} (ha : IsUnit a) (b : F) (x : E) :
    Algebra.adjoin F {algebraMap F E a * x + algebraMap F E b} = Algebra.adjoin F {x} := by
  obtain ⟨u, rfl⟩ := ha
  refine le_antisymm (Algebra.adjoin_le (Set.singleton_subset_iff.mpr ?_))
    (Algebra.adjoin_le (Set.singleton_subset_iff.mpr ?_))
  · exact add_mem (mul_mem (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin (Set.mem_singleton _))) (Subalgebra.algebraMap_mem _ _)
  · -- `x = u⁻¹ y - u⁻¹ b` lies in the algebra generated by `y = u x + b`.
    set y := algebraMap F E u * x + algebraMap F E b with hy
    have hinv : algebraMap F E ↑u⁻¹ * algebraMap F E u = 1 := by
      rw [← map_mul, Units.inv_mul, map_one]
    have hx : x = algebraMap F E ↑u⁻¹ * y - algebraMap F E (↑u⁻¹ * b) := by
      rw [hy, map_mul, mul_add, ← mul_assoc, hinv, one_mul, add_sub_cancel_right]
    rw [hx]
    exact sub_mem (mul_mem (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin (Set.mem_singleton _))) (Subalgebra.algebraMap_mem _ _)

/-- If `x` generates an algebra over a commutative ring in which `2` is a unit, then so does
`2x - 1`. -/
theorem adjoin_two_mul_sub_one_eq_top (h2 : IsUnit (2 : F)) {x : E}
    (h : Algebra.adjoin F {x} = ⊤) : Algebra.adjoin F {2 * x - 1} = ⊤ := by
  have := adjoin_algebraMap_mul_add_algebraMap_eq_adjoin h2 (-1) x
  rwa [map_ofNat, map_neg, map_one, ← sub_eq_add_neg, h] at this

end TauCeti.Algebra

namespace NonUnitalSubalgebra

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R A]

/-- The unital subalgebra generated by a nonunital subalgebra is the sum of its underlying
subspace and the scalar line, also when the ambient algebra is noncommutative. -/
theorem adjoin_eq_span_one_sup (B : NonUnitalSubalgebra R A) :
    (Algebra.adjoin R (B : Set A)).toSubmodule = Submodule.span R {1} ⊔ B.toSubmodule := by
  rw [Algebra.adjoin_eq_span, Submonoid.closure_eq_one_union, Submodule.span_union,
    ← NonUnitalAlgebra.adjoin_eq_span, NonUnitalAlgebra.adjoin_eq]

end NonUnitalSubalgebra
