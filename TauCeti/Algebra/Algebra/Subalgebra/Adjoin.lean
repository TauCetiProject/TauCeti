module

public import Mathlib.RingTheory.Adjoin.Basic

/-!
# Generators of an algebra under affine changes

A single generator of a commutative algebra over a field may be replaced by any invertible
affine image of itself: if `x` generates `E` over `F` and `a ≠ 0`, then `a x + b` generates `E`
as well, because `x = a⁻¹ (a x + b) - a⁻¹ b` lies in the algebra generated by `a x + b`.

## Main results

* `TauCeti.Algebra.adjoin_algebraMap_mul_add_algebraMap_eq_top`: an invertible affine change
  preserves a singleton generator.
* `TauCeti.Algebra.adjoin_two_mul_sub_one_eq_top`: the case `2x - 1`, when `2 ≠ 0`.
-/

public section

namespace TauCeti.Algebra

variable {F E : Type*} [Field F] [CommRing E] [Algebra F E]

/-- **An invertible affine change preserves a singleton generator.** If `x` generates the
commutative algebra `E` over the field `F` and `a ≠ 0`, then so does `a x + b`. -/
theorem adjoin_algebraMap_mul_add_algebraMap_eq_top {a : F} (ha : a ≠ 0) (b : F) {x : E}
    (h : Algebra.adjoin F {x} = ⊤) :
    Algebra.adjoin F {algebraMap F E a * x + algebraMap F E b} = ⊤ := by
  rw [eq_top_iff, ← h, Algebra.adjoin_le_iff, Set.singleton_subset_iff]
  set y := algebraMap F E a * x + algebraMap F E b with hy
  have hinv : algebraMap F E a⁻¹ * algebraMap F E a = 1 := by
    rw [← map_mul, inv_mul_cancel₀ ha, map_one]
  -- `x = a⁻¹ y - a⁻¹ b` lies in the algebra generated by `y`.
  have hx : x = algebraMap F E a⁻¹ * y - algebraMap F E (a⁻¹ * b) := by
    rw [hy, map_mul, mul_add, ← mul_assoc, hinv, one_mul, add_sub_cancel_right]
  rw [hx]
  exact sub_mem (mul_mem (Subalgebra.algebraMap_mem _ _)
    (Algebra.subset_adjoin (Set.mem_singleton _))) (Subalgebra.algebraMap_mem _ _)

/-- If `x` generates a commutative algebra over a field in which `2 ≠ 0`, then so does
`2x - 1`. -/
theorem adjoin_two_mul_sub_one_eq_top (h2 : (2 : F) ≠ 0) {x : E}
    (h : Algebra.adjoin F {x} = ⊤) : Algebra.adjoin F {2 * x - 1} = ⊤ := by
  have := adjoin_algebraMap_mul_add_algebraMap_eq_top h2 (-1) h
  rwa [map_ofNat, map_neg, map_one, ← sub_eq_add_neg] at this

end TauCeti.Algebra
