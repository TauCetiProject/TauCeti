module

public import Mathlib.RingTheory.Adjoin.Basic

/-!
# Generators of an algebra under affine changes

A single generator of a commutative algebra may be replaced by any affine image of itself with
a unit multiplier: if `x` generates `E` over the commutative ring `F` and `a` is a unit of `F`,
then `a x + b` generates `E` as well, because `x = a⁻¹ (a x + b) - a⁻¹ b` lies in the algebra
generated by `a x + b`.

## Main results

* `TauCeti.Algebra.adjoin_algebraMap_mul_add_algebraMap_eq_top`: an affine change with a unit
  multiplier preserves a singleton generator.
* `TauCeti.Algebra.adjoin_two_mul_sub_one_eq_top`: the case `2x - 1`, when `2` is a unit.
-/

public section

namespace TauCeti.Algebra

variable {F E : Type*} [CommRing F] [CommRing E] [Algebra F E]

/-- **An affine change with a unit multiplier preserves a singleton generator.** If `x`
generates the commutative algebra `E` over the commutative ring `F` and `a` is a unit of `F`,
then so does `a x + b`. -/
theorem adjoin_algebraMap_mul_add_algebraMap_eq_top {a : F} (ha : IsUnit a) (b : F) {x : E}
    (h : Algebra.adjoin F {x} = ⊤) :
    Algebra.adjoin F {algebraMap F E a * x + algebraMap F E b} = ⊤ := by
  obtain ⟨u, rfl⟩ := ha
  rw [eq_top_iff, ← h, Algebra.adjoin_le_iff, Set.singleton_subset_iff]
  set y := algebraMap F E u * x + algebraMap F E b with hy
  have hinv : algebraMap F E ↑u⁻¹ * algebraMap F E u = 1 := by
    rw [← map_mul, Units.inv_mul, map_one]
  -- `x = u⁻¹ y - u⁻¹ b` lies in the algebra generated by `y`.
  have hx : x = algebraMap F E ↑u⁻¹ * y - algebraMap F E (↑u⁻¹ * b) := by
    rw [hy, map_mul, mul_add, ← mul_assoc, hinv, one_mul, add_sub_cancel_right]
  rw [hx]
  exact sub_mem (mul_mem (Subalgebra.algebraMap_mem _ _)
    (Algebra.subset_adjoin (Set.mem_singleton _))) (Subalgebra.algebraMap_mem _ _)

/-- If `x` generates a commutative algebra over a commutative ring in which `2` is a unit, then
so does `2x - 1`. -/
theorem adjoin_two_mul_sub_one_eq_top (h2 : IsUnit (2 : F)) {x : E}
    (h : Algebra.adjoin F {x} = ⊤) : Algebra.adjoin F {2 * x - 1} = ⊤ := by
  have := adjoin_algebraMap_mul_add_algebraMap_eq_top h2 (-1) h
  rwa [map_ofNat, map_neg, map_one, ← sub_eq_add_neg] at this

end TauCeti.Algebra
