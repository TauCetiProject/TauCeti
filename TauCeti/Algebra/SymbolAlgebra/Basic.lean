/-!
# Symbol algebras

For a commutative ring `R`, a natural number `n` and elements `ζ a b : R`, the **symbol algebra**
`(a, b)_ζ` is the associative unital `R`-algebra generated by two elements `x` and `y` subject to

`x ^ n = a`, `y ^ n = b`, `y * x = ζ • (x * y)`.

When `R = K` is a field, `ζ` is a primitive `n`-th root of unity and `a, b ≠ 0`, this is the
**cyclic algebra** `(a, b)_ζ` of degree `n`, a central simple `K`-algebra of dimension `n ^ 2`
(`TauCeti/Algebra/SymbolAlgebra/CentralSimple.lean`). For `n = 2` and `ζ = -1` the relations are
those of the quaternion algebra `(a, b)`. Cyclic algebras are the Brauer classes through which
degree-two Milnor `K`-theory of a field containing a primitive `n`-th root of unity is compared
with the `n`-torsion of its Brauer group; that comparison is not part of this file.

The algebra is built as a quotient of the free algebra on two generators, so it has the universal
property `TauCeti.SymbolAlgebra.lift`. The main structural result of this file is that, over any
commutative ring, as soon as `ζ ^ n = 1` and `n ≠ 0`, the monomials `x ^ i * y ^ j` with
`i, j < n` form an `R`-basis (`TauCeti.SymbolAlgebra.basis`). Neither `a` nor `b` needs to be
invertible for this. Spanning is the normal-form computation `y * x ^ i = ζ ^ i • (x ^ i * y)`
together with `x ^ n = a` and `y ^ n = b`. Linear independence comes from the representation on
`R[X]/(X ^ n - a) ⊗[R] R[Y]/(Y ^ n - b)` in which `x` multiplies by the class of `X` and `y`
multiplies by the class of `Y` after applying the automorphism `X ↦ ζ X` of the first factor; it
sends `x ^ i * y ^ j` applied to `1 ⊗ 1` to `X ^ i ⊗ Y ^ j`, a tensor of power-basis vectors.

The hypothesis `ζ ^ n = 1` is necessary: the relations give `y * x ^ n = ζ ^ n • (x ^ n * y)`, that
is `(1 - ζ ^ n) • (a • y) = 0`; over a field with `a, b ≠ 0` and `ζ ^ n ≠ 1` this makes the algebra
zero.

## Main definitions

* `TauCeti.SymbolAlgebra.Rel`: the three defining relations on the free algebra.
* `TauCeti.SymbolAlgebra`: the symbol algebra `(a, b)_ζ` of degree `n`.
* `TauCeti.SymbolAlgebra.x`, `TauCeti.SymbolAlgebra.y`: the two generators.
* `TauCeti.SymbolAlgebra.lift`: the universal property.
* `TauCeti.SymbolAlgebra.basis`: the monomial basis `x ^ i * y ^ j`, `i, j < n`.
* `TauCeti.SymbolAlgebra.toEndAdjoinRoot`: the representation of `(a, 1)_ζ` on `R[X]/(X ^ n - a)`
  in which `x` multiplies by the class of `X` and `y` acts by the automorphism `X ↦ ζ X`
  (`TauCeti.standardTameCoverAut`).

## Main results

* `TauCeti.SymbolAlgebra.x_pow`, `TauCeti.SymbolAlgebra.y_pow`, `TauCeti.SymbolAlgebra.y_mul_x`:
  the defining relations.
* `TauCeti.SymbolAlgebra.y_pow_mul_x_pow`: the commutation rule
  `y ^ j * x ^ i = ζ ^ (i * j) • (x ^ i * y ^ j)`.
* `TauCeti.SymbolAlgebra.finrank_eq`: the symbol algebra has rank `n ^ 2`.
* `TauCeti.SymbolAlgebra.isUnit_x`, `TauCeti.SymbolAlgebra.isUnit_y`: the generators are units
  when `a` and `b` are.

## References

* P. Gille, T. Szamuely, *Central Simple Algebras and Galois Cohomology*, CUP (2006), §2.5.
* The quotient presentation and universal-property API follow the construction pattern in
  `Mathlib.LinearAlgebra.CliffordAlgebra.Basic`.
-/

public section

open Polynomial

open scoped TensorProduct

namespace TauCeti

variable {R : Type*}

namespace SymbolAlgebra

/-- The defining relations of the symbol algebra `(a, b)_ζ` of degree `n`, as a relation on the free
algebra on the two generators `0 ↦ x` and `1 ↦ y`: `x ^ n = a`, `y ^ n = b` and
`y * x = ζ • (x * y)`. -/
inductive Rel [CommSemiring R] (n : ℕ) (ζ a b : R) :
    FreeAlgebra R (Fin 2) → FreeAlgebra R (Fin 2) → Prop
  | x_pow : Rel n ζ a b (FreeAlgebra.ι R 0 ^ n) (algebraMap R _ a)
  | y_pow : Rel n ζ a b (FreeAlgebra.ι R 1 ^ n) (algebraMap R _ b)
  | y_mul_x :
      Rel n ζ a b (FreeAlgebra.ι R 1 * FreeAlgebra.ι R 0)
        (ζ • (FreeAlgebra.ι R 0 * FreeAlgebra.ι R 1))

end SymbolAlgebra

/-- The **symbol algebra** `(a, b)_ζ` of degree `n` over a commutative semiring `R`: the
`R`-algebra generated by `x` and `y` with `x ^ n = a`, `y ^ n = b` and `y * x = ζ • (x * y)`.
Over a field with `ζ` a primitive `n`-th root of unity and `a, b ≠ 0` this is the cyclic algebra
`(a, b)_ζ`, a central simple algebra of degree `n`. -/
@[expose] def SymbolAlgebra [CommSemiring R] (n : ℕ) (ζ a b : R) : Type _ :=
  RingQuot (SymbolAlgebra.Rel n ζ a b)

namespace SymbolAlgebra

section CommSemiring

variable [CommSemiring R] {n : ℕ} {ζ a b : R}

instance : Semiring (SymbolAlgebra n ζ a b) :=
  inferInstanceAs (Semiring (RingQuot (Rel n ζ a b)))

instance : Algebra R (SymbolAlgebra n ζ a b) :=
  inferInstanceAs (Algebra R (RingQuot (Rel n ζ a b)))

variable (n ζ a b) in
/-- The quotient map from the free algebra onto the symbol algebra. -/
private def mkAlgHom : FreeAlgebra R (Fin 2) →ₐ[R] SymbolAlgebra n ζ a b :=
  RingQuot.mkAlgHom R (Rel n ζ a b)

/-- The generator `x` of the symbol algebra, with `x ^ n = a`. -/
def x : SymbolAlgebra n ζ a b :=
  mkAlgHom n ζ a b (FreeAlgebra.ι R 0)

/-- The generator `y` of the symbol algebra, with `y ^ n = b`. -/
def y : SymbolAlgebra n ζ a b :=
  mkAlgHom n ζ a b (FreeAlgebra.ι R 1)

variable (n ζ a b) in
/-- The quotient map from the free algebra, as a function of the generators `x` and `y`. -/
private theorem mkAlgHom_ι (i : Fin 2) :
    mkAlgHom n ζ a b (FreeAlgebra.ι R i) = ![x, y] i := by
  fin_cases i <;> rfl

private theorem mkAlgHom_rel {u v : FreeAlgebra R (Fin 2)} (h : Rel n ζ a b u v) :
    mkAlgHom n ζ a b u = mkAlgHom n ζ a b v :=
  RingQuot.mkAlgHom_rel R h

/-- The first defining relation: `x ^ n = a`. -/
@[simp]
theorem x_pow : (x : SymbolAlgebra n ζ a b) ^ n = algebraMap R _ a := by
  simpa [map_pow, mkAlgHom_ι] using mkAlgHom_rel (Rel.x_pow (n := n) (ζ := ζ) (a := a)
    (b := b))

/-- The second defining relation: `y ^ n = b`. -/
@[simp]
theorem y_pow : (y : SymbolAlgebra n ζ a b) ^ n = algebraMap R _ b := by
  simpa [map_pow, mkAlgHom_ι] using mkAlgHom_rel (Rel.y_pow (n := n) (ζ := ζ) (a := a)
    (b := b))

/-- The third defining relation: `y * x = ζ • (x * y)`. -/
@[simp]
theorem y_mul_x : (y : SymbolAlgebra n ζ a b) * x = ζ • (x * y) := by
  simpa [mkAlgHom_ι] using mkAlgHom_rel (Rel.y_mul_x (n := n) (ζ := ζ) (a := a) (b := b))

/-- Moving `y` past a power of `x`: `y * x ^ i = ζ ^ i • (x ^ i * y)`. -/
@[simp]
theorem y_mul_x_pow (i : ℕ) :
    (y : SymbolAlgebra n ζ a b) * x ^ i = ζ ^ i • (x ^ i * y) := by
  induction i with
  | zero => simp
  | succ i ih =>
    rw [pow_succ, ← mul_assoc, ih, smul_mul_assoc, mul_assoc, y_mul_x, mul_smul_comm, smul_smul,
      ← pow_succ, mul_assoc, pow_succ]

/-- Moving a power of `y` past a power of `x`: `y ^ j * x ^ i = ζ ^ (i * j) • (x ^ i * y ^ j)`. -/
@[simp]
theorem y_pow_mul_x_pow (i j : ℕ) :
    (y : SymbolAlgebra n ζ a b) ^ j * x ^ i = ζ ^ (i * j) • (x ^ i * y ^ j) := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [pow_succ', mul_assoc, ih, mul_smul_comm, ← mul_assoc, y_mul_x_pow, smul_mul_assoc,
      smul_smul, mul_assoc, ← pow_succ', ← pow_add, Nat.mul_succ]

/-- A power of `x` reduces to a power with exponent less than `n`:
`x ^ i = a ^ (i / n) • x ^ (i % n)`. -/
theorem x_pow_eq_smul (i : ℕ) :
    (x : SymbolAlgebra n ζ a b) ^ i = a ^ (i / n) • x ^ (i % n) := by
  conv_lhs => rw [← Nat.div_add_mod i n]
  rw [pow_add, pow_mul, x_pow, ← map_pow, ← Algebra.smul_def]

/-- A power of `y` reduces to a power with exponent less than `n`:
`y ^ j = b ^ (j / n) • y ^ (j % n)`. -/
theorem y_pow_eq_smul (j : ℕ) :
    (y : SymbolAlgebra n ζ a b) ^ j = b ^ (j / n) • y ^ (j % n) := by
  conv_lhs => rw [← Nat.div_add_mod j n]
  rw [pow_add, pow_mul, y_pow, ← map_pow, ← Algebra.smul_def]

/-- The generator `x` is a unit when `a` is, since `x ^ n = a` and `n ≠ 0`. -/
theorem isUnit_x [NeZero n] (ha : IsUnit a) : IsUnit (x : SymbolAlgebra n ζ a b) :=
  (isUnit_pow_iff (NeZero.ne n)).1 (by rw [x_pow]; exact ha.map _)

/-- The generator `y` is a unit when `b` is, since `y ^ n = b` and `n ≠ 0`. -/
theorem isUnit_y [NeZero n] (hb : IsUnit b) : IsUnit (y : SymbolAlgebra n ζ a b) :=
  (isUnit_pow_iff (NeZero.ne n)).1 (by rw [y_pow]; exact hb.map _)

/-- Moving `x` to the left across a monomial: `x ^ i * y ^ j * x = ζ ^ j • (x * (x ^ i * y ^ j))`.
-/
theorem x_pow_mul_y_pow_mul_x (i j : ℕ) :
    (x : SymbolAlgebra n ζ a b) ^ i * y ^ j * x = ζ ^ j • (x * (x ^ i * y ^ j)) := by
  have h := y_pow_mul_x_pow (n := n) (ζ := ζ) (a := a) (b := b) 1 j
  simp only [pow_one, one_mul] at h
  rw [mul_assoc, h, mul_smul_comm, ← mul_assoc, ← pow_succ, pow_succ', mul_assoc]

/-- Moving `y` to the right across a monomial: `y * (x ^ i * y ^ j) = ζ ^ i • (x ^ i * y ^ j * y)`.
-/
theorem y_mul_x_pow_mul_y_pow (i j : ℕ) :
    (y : SymbolAlgebra n ζ a b) * (x ^ i * y ^ j) = ζ ^ i • (x ^ i * y ^ j * y) := by
  rw [← mul_assoc, y_mul_x_pow, smul_mul_assoc, mul_assoc, mul_assoc, ← pow_succ', ← pow_succ]

section Lift

variable {A : Type*} [Semiring A] [Algebra R A]

/-- The universal property of the symbol algebra: two elements `u` and `v` of an `R`-algebra with
`u ^ n = a`, `v ^ n = b` and `v * u = ζ • (u * v)` determine an algebra map out of `(a, b)_ζ`
sending `x` to `u` and `y` to `v`. -/
def lift (u v : A) (hu : u ^ n = algebraMap R A a) (hv : v ^ n = algebraMap R A b)
    (hvu : v * u = ζ • (u * v)) : SymbolAlgebra n ζ a b →ₐ[R] A :=
  RingQuot.liftAlgHom R ⟨FreeAlgebra.lift R ![u, v], by
    rintro _ _ (_ | _ | _) <;> simp [hu, hv, hvu]⟩

/-- The algebra map built by `TauCeti.SymbolAlgebra.lift` sends `x` to `u`. -/
@[simp]
theorem lift_x (u v : A) (hu hv hvu) :
    lift (n := n) (ζ := ζ) (a := a) (b := b) u v hu hv hvu x = u :=
  (RingQuot.liftAlgHom_mkAlgHom_apply R _ _ _).trans (by simp)

/-- The algebra map built by `TauCeti.SymbolAlgebra.lift` sends `y` to `v`. -/
@[simp]
theorem lift_y (u v : A) (hu hv hvu) :
    lift (n := n) (ζ := ζ) (a := a) (b := b) u v hu hv hvu y = v :=
  (RingQuot.liftAlgHom_mkAlgHom_apply R _ _ _).trans (by simp)

/-- Two algebra maps out of the symbol algebra agreeing on `x` and `y` are equal. -/
@[ext high]
theorem algHom_ext {F G : SymbolAlgebra n ζ a b →ₐ[R] A} (hx : F x = G x) (hy : F y = G y) :
    F = G :=
  RingQuot.ringQuot_ext' R F G <| FreeAlgebra.hom_ext <| funext fun i => by
    fin_cases i
    · exact hx
    · exact hy

end Lift

section DegreeOne

variable (a b)

/-- A degree-one symbol algebra is the base semiring, without nonzero assumptions. -/
def algEquivOfDegreeOne : SymbolAlgebra 1 1 a b ≃ₐ[R] R :=
  AlgEquiv.ofAlgHom
    (lift a b (by simp) (by simp) (by simp [mul_comm]))
    (Algebra.ofId R (SymbolAlgebra 1 1 a b))
    (by ext)
    (by
      apply algHom_ext
      · simp only [AlgHom.comp_apply, lift_x, Algebra.ofId_apply, AlgHom.id_apply]
        simpa only [pow_one] using
          (x_pow (n := 1) (ζ := (1 : R)) (a := a) (b := b)).symm
      · simp only [AlgHom.comp_apply, lift_y, Algebra.ofId_apply, AlgHom.id_apply]
        simpa only [pow_one] using
          (y_pow (n := 1) (ζ := (1 : R)) (a := a) (b := b)).symm)

/-- The degree-one equivalence sends `x` to its defining scalar. -/
@[simp]
theorem algEquivOfDegreeOne_x : algEquivOfDegreeOne a b x = a := by
  exact lift_x _ _ _ _ _

/-- The degree-one equivalence sends `y` to its defining scalar. -/
@[simp]
theorem algEquivOfDegreeOne_y : algEquivOfDegreeOne a b y = b := by
  exact lift_y _ _ _ _ _

end DegreeOne

/-- The generators generate. -/
theorem adjoin_x_y : Algebra.adjoin R {(x : SymbolAlgebra n ζ a b), y} = ⊤ := by
  have hrange : ({x, y} : Set (SymbolAlgebra n ζ a b))
      = mkAlgHom n ζ a b '' Set.range (FreeAlgebra.ι R (X := Fin 2)) := by
    rw [← Set.range_comp]
    ext z
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_range, Function.comp_apply,
      mkAlgHom_ι, Fin.exists_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one]
    tauto
  rw [hrange, ← AlgHom.map_adjoin, FreeAlgebra.adjoin_range_ι, Algebra.map_top]
  exact (AlgHom.range_eq_top _).2 (RingQuot.mkAlgHom_surjective R _)

/-- Induction on elements of the symbol algebra using the generators, scalars, addition and
multiplication. -/
@[elab_as_elim]
theorem induction {P : SymbolAlgebra n ζ a b → Prop} (x : P x) (y : P y)
    (algebraMap : ∀ r, P (algebraMap R (SymbolAlgebra n ζ a b) r))
    (add : ∀ z w, P z → P w → P (z + w)) (mul : ∀ z w, P z → P w → P (z * w))
    (z : SymbolAlgebra n ζ a b) : P z := by
  have hz : z ∈ Algebra.adjoin R {(SymbolAlgebra.x : SymbolAlgebra n ζ a b), SymbolAlgebra.y} := by
    rw [adjoin_x_y]
    trivial
  induction hz using Algebra.adjoin_induction with
  | mem z hz =>
    rcases hz with rfl | rfl
    · exact x
    · exact y
  | algebraMap r => exact algebraMap r
  | add z w _ _ hz hw => exact add z w hz hw
  | mul z w _ _ hz hw => exact mul z w hz hw

end CommSemiring

section CommRing

variable [CommRing R] {n : ℕ} {ζ a b : R}

instance : Ring (SymbolAlgebra n ζ a b) :=
  inferInstanceAs (Ring (RingQuot (Rel n ζ a b)))

/-! ### Spanning -/

variable (n ζ a b) in
/-- The monomials `x ^ i * y ^ j` with `i, j < n`. -/
private def monomial (p : Fin n × Fin n) : SymbolAlgebra n ζ a b :=
  x ^ (p.1 : ℕ) * y ^ (p.2 : ℕ)

/-- Every monomial `x ^ i * y ^ j` lies in the span of the reduced monomials. -/
private theorem x_pow_mul_y_pow_mem_span [NeZero n] (i j : ℕ) :
    (x : SymbolAlgebra n ζ a b) ^ i * y ^ j ∈ Submodule.span R (Set.range (monomial n ζ a b)) := by
  rw [x_pow_eq_smul, y_pow_eq_smul, smul_mul_smul_comm]
  exact Submodule.smul_mem _ _ (Submodule.subset_span
    ⟨(⟨i % n, Nat.mod_lt _ (NeZero.pos n)⟩, ⟨j % n, Nat.mod_lt _ (NeZero.pos n)⟩), rfl⟩)

/-- The reduced monomials span the symbol algebra. -/
private theorem span_monomial [NeZero n] :
    Submodule.span R (Set.range (monomial n ζ a b)) = ⊤ := by
  set S := Submodule.span R (Set.range (monomial n ζ a b))
  -- `S` is stable under left multiplication by `x` and by `y`.
  have hx : ∀ s ∈ S, x * s ∈ S := fun s hs => by
    refine Submodule.mem_comap.1
      ((Submodule.span_le (p := S.comap (LinearMap.mulLeft R x))).2 ?_ hs)
    rintro _ ⟨p, rfl⟩
    rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply, monomial, ← mul_assoc,
      ← pow_succ']
    exact x_pow_mul_y_pow_mem_span _ _
  have hy : ∀ s ∈ S, y * s ∈ S := fun s hs => by
    refine Submodule.mem_comap.1
      ((Submodule.span_le (p := S.comap (LinearMap.mulLeft R y))).2 ?_ hs)
    rintro _ ⟨p, rfl⟩
    rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply, monomial, ← mul_assoc,
      y_mul_x_pow, smul_mul_assoc, mul_assoc, ← pow_succ']
    exact Submodule.smul_mem _ _ (x_pow_mul_y_pow_mem_span _ _)
  -- Hence it is stable under left multiplication by everything, and it contains `1`.
  have hmul : ∀ z : SymbolAlgebra n ζ a b, ∀ s ∈ S, z * s ∈ S := fun z => by
    induction z using SymbolAlgebra.induction with
    | x => exact hx
    | y => exact hy
    | algebraMap r => exact fun s hs => by rw [← Algebra.smul_def]; exact S.smul_mem r hs
    | add z w hz hw => exact fun s hs => by rw [add_mul]; exact S.add_mem (hz s hs) (hw s hs)
    | mul z w hz hw => exact fun s hs => by rw [mul_assoc]; exact hz _ (hw s hs)
  refine eq_top_iff.2 fun z _ => ?_
  simpa using hmul z 1 (by simpa using x_pow_mul_y_pow_mem_span (ζ := ζ) (a := a) (b := b) 0 0)

/-! ### Linear independence, through a representation -/

variable (n ζ a b) in
/-- The representation space `R[X]/(X ^ n - a) ⊗[R] R[Y]/(Y ^ n - b)`. -/
private abbrev Rep := AdjoinRoot (X ^ n - C a) ⊗[R] AdjoinRoot (X ^ n - C b)

variable (a b) in
/-- The action of `y` on the representation space: apply the automorphism `X ↦ ζ X` of the first
factor (`TauCeti.standardTameCoverAut`), then multiply by the class of `Y` in the second. -/
private noncomputable def repY [NeZero n] (hζ : ζ ^ n = 1) : Module.End R (Rep n a b) :=
  LinearMap.mulLeft R (1 ⊗ₜ AdjoinRoot.root _) ∘ₗ
    (Algebra.TensorProduct.map (standardTameCoverAut a (rootsOfUnity.mkOfPowEq ζ hζ) :
      AdjoinRoot (X ^ n - C a) →ₐ[R] AdjoinRoot (X ^ n - C a)) (AlgHom.id R _)).toLinearMap

private theorem repY_pow_tmul [NeZero n] (hζ : ζ ^ n = 1) (k : ℕ) (p q) :
    (repY a b hζ ^ k) (p ⊗ₜ q) =
      standardTameCoverAut a (rootsOfUnity.mkOfPowEq ζ hζ ^ k) p ⊗ₜ
        (AdjoinRoot.root (X ^ n - C b) ^ k * q) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', mul_apply_eq_comp, ih]
    simp [repY, pow_succ', mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, AlgEquiv.mul_apply]

private theorem repX_pow : LinearMap.mulLeft R (AdjoinRoot.root _ ⊗ₜ 1 : Rep n a b) ^ n =
    algebraMap R _ a := by
  ext p q
  simp [LinearMap.pow_mulLeft, Algebra.TensorProduct.tmul_pow, Algebra.smul_def,
    Algebra.TensorProduct.algebraMap_apply, AdjoinRoot.algebraMap_eq]

private theorem repY_pow [NeZero n] (hζ : ζ ^ n = 1) : repY a b hζ ^ n = algebraMap R _ b := by
  refine TensorProduct.ext' fun p q => ?_
  simp [repY_pow_tmul, ← AdjoinRoot.algebraMap_eq, ← Algebra.smul_def]

private theorem repY_mul_repX [NeZero n] (hζ : ζ ^ n = 1) :
    repY a b hζ * LinearMap.mulLeft R (AdjoinRoot.root _ ⊗ₜ 1 : Rep n a b) =
      ζ • (LinearMap.mulLeft R (AdjoinRoot.root _ ⊗ₜ 1) * repY a b hζ) := by
  refine LinearMap.ext fun w => ?_
  simp only [repY, mul_apply_eq_comp, LinearMap.comp_apply, AlgHom.toLinearMap_apply,
    LinearMap.mulLeft_apply, map_mul, Algebra.TensorProduct.map_tmul, AlgEquiv.coe_toAlgHom,
    standardTameCoverAut_root, rootsOfUnity.coe_mkOfPowEq, ← Algebra.smul_def, map_one,
    LinearMap.smul_apply, ← TensorProduct.smul_tmul', smul_mul_assoc, mul_smul_comm]
  congr 1
  ring

/-- The representation of the symbol algebra on `R[X]/(X ^ n - a) ⊗[R] R[Y]/(Y ^ n - b)`. -/
private noncomputable def rep [NeZero n] (hζ : ζ ^ n = 1) :
    SymbolAlgebra n ζ a b →ₐ[R] Module.End R (Rep n a b) :=
  lift _ _ repX_pow (repY_pow hζ) (repY_mul_repX hζ)

private theorem rep_monomial_one [NeZero n] (hζ : ζ ^ n = 1) (i j : ℕ) :
    rep hζ ((x : SymbolAlgebra n ζ a b) ^ i * y ^ j) 1 =
      (AdjoinRoot.root (X ^ n - C a) ^ i) ⊗ₜ (AdjoinRoot.root (X ^ n - C b) ^ j) := by
  simp [rep, mul_apply_eq_comp, Algebra.TensorProduct.one_def, repY_pow_tmul,
    LinearMap.pow_mulLeft, Algebra.TensorProduct.tmul_pow]

/-- The tensor products `X ^ i ⊗ Y ^ j` of power-basis vectors, `i, j < n`, are linearly
independent. -/
private theorem linearIndependent_root_pow_tmul [NeZero n] :
    LinearIndependent R fun p : Fin n × Fin n =>
      (AdjoinRoot.root (X ^ n - C a) ^ (p.1 : ℕ)) ⊗ₜ[R]
        (AdjoinRoot.root (X ^ n - C b) ^ (p.2 : ℕ)) := by
  nontriviality R
  convert ((AdjoinRoot.basisXPowSubC n a).tensorProduct
    (AdjoinRoot.basisXPowSubC n b)).linearIndependent with p
  simp [Module.Basis.tensorProduct_apply']

/-- The reduced monomials are linearly independent. -/
private theorem linearIndependent_monomial [NeZero n] (hζ : ζ ^ n = 1) :
    LinearIndependent R (monomial n ζ a b) := by
  refine LinearIndependent.of_comp ((LinearMap.applyₗ (1 : Rep n a b)) ∘ₗ (rep hζ).toLinearMap) ?_
  convert linearIndependent_root_pow_tmul (n := n) (a := a) (b := b) with p
  simpa [monomial] using rep_monomial_one hζ (p.1 : ℕ) p.2

/-! ### The split representation of `(a, 1)_ζ` -/

variable (a) in
/-- The representation of the symbol algebra `(a, 1)_ζ` on `R[X]/(X ^ n - a)`, in which `x`
multiplies by the class of `X` and `y` acts by the algebra automorphism `X ↦ ζ X`. Over a field,
with `ζ` a primitive `n`-th root of unity and `a ≠ 0`, it is an isomorphism onto the
endomorphism algebra of this `n`-dimensional space
(`TauCeti.SymbolAlgebra.algEquivEndAdjoinRoot`), so `(a, 1)_ζ` is split. -/
noncomputable def toEndAdjoinRoot [NeZero n] (hζ : ζ ^ n = 1) :
    SymbolAlgebra n ζ a 1 →ₐ[R] Module.End R (AdjoinRoot (X ^ n - C a)) :=
  lift (LinearMap.mulLeft R (AdjoinRoot.root _))
    (standardTameCoverAut a (rootsOfUnity.mkOfPowEq ζ hζ)).toLinearMap
    (LinearMap.ext fun q => by
      simp [LinearMap.pow_mulLeft, ← AdjoinRoot.algebraMap_eq, ← Algebra.smul_def])
    (by rw [← AlgEquiv.pow_toLinearMap, ← map_pow, rootsOfUnity.pow_eq_one, map_one, map_one,
      AlgEquiv.one_toLinearMap])
    (LinearMap.ext fun q => by
      simp [mul_apply_eq_comp, Algebra.smul_def, mul_assoc])

/-- In the split representation, `x` multiplies by the class of `X`. -/
@[simp]
theorem toEndAdjoinRoot_x [NeZero n] (hζ : ζ ^ n = 1) :
    toEndAdjoinRoot a hζ x = LinearMap.mulLeft R (AdjoinRoot.root (X ^ n - C a : R[X])) :=
  lift_x ..

/-- In the split representation, `y` acts by the automorphism `X ↦ ζ X` of `R[X]/(X ^ n - a)`. -/
@[simp]
theorem toEndAdjoinRoot_y [NeZero n] (hζ : ζ ^ n = 1) :
    toEndAdjoinRoot a hζ y = (standardTameCoverAut a (rootsOfUnity.mkOfPowEq ζ hζ)).toLinearMap :=
  lift_y ..

/-! ### The monomial basis -/

/-- **The monomial basis of the symbol algebra.** If `ζ ^ n = 1` and `n ≠ 0`, the monomials
`x ^ i * y ^ j` with `i, j < n` form a basis of `(a, b)_ζ` over the commutative ring `R`, for
arbitrary `a` and `b`. -/
noncomputable def basis [NeZero n] (hζ : ζ ^ n = 1) :
    Module.Basis (Fin n × Fin n) R (SymbolAlgebra n ζ a b) :=
  .mk (linearIndependent_monomial hζ) span_monomial.ge

/-- The basis vector indexed by `(i, j)` is the monomial `x ^ i * y ^ j`. -/
@[simp]
theorem basis_apply [NeZero n] (hζ : ζ ^ n = 1) (p : Fin n × Fin n) :
    basis (a := a) (b := b) hζ p = x ^ (p.1 : ℕ) * y ^ (p.2 : ℕ) :=
  Module.Basis.mk_apply _ _ _

/-- The symbol algebra is a free module when `ζ ^ n = 1` and `n ≠ 0`. -/
theorem free [NeZero n] (hζ : ζ ^ n = 1) : Module.Free R (SymbolAlgebra n ζ a b) :=
  .of_basis (basis hζ)

/-- The symbol algebra is a finite module when `ζ ^ n = 1` and `n ≠ 0`. -/
theorem finite [NeZero n] (hζ : ζ ^ n = 1) : Module.Finite R (SymbolAlgebra n ζ a b) :=
  .of_basis (basis hζ)

/-- **The symbol algebra has rank `n ^ 2`** when `ζ ^ n = 1` and `n ≠ 0`. -/
theorem finrank_eq [StrongRankCondition R] [NeZero n] (hζ : ζ ^ n = 1) :
    Module.finrank R (SymbolAlgebra n ζ a b) = n ^ 2 := by
  rw [Module.finrank_eq_card_basis (basis hζ), Fintype.card_prod, Fintype.card_fin, sq]

/-- The symbol algebra is nontrivial over a nontrivial ring when `ζ ^ n = 1` and `n ≠ 0`: it is free
of rank `n ^ 2 > 0`. -/
theorem nontrivial [Nontrivial R] [NeZero n] (hζ : ζ ^ n = 1) :
    Nontrivial (SymbolAlgebra n ζ a b) :=
  Module.nontrivial_of_finrank_pos (R := R) (by
    rw [finrank_eq hζ]
    exact pow_pos (NeZero.pos n) 2)

end CommRing

end SymbolAlgebra

end TauCeti
