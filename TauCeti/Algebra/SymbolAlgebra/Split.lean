public import TauCeti.Algebra.SymbolAlgebra.CentralSimple

/-!
# Splitting cyclic algebras by an `n`-th root of `a`

Let `ζ` be a primitive `n`-th root of unity in a field `K` and `a, b ∈ Kˣ`, and consider the cyclic
algebra `(a, b)_ζ` of `TauCeti/Algebra/SymbolAlgebra/Basic.lean`, generated by `x, y` with
`x ^ n = a`, `y ^ n = b` and `y * x = ζ • (x * y)`. This file shows that an `n`-th root of `a`
splits it, by an explicit diagonal-and-shift representation; no `n`-th root of `b` is needed.

If `α ^ n = a`, the algebra acts on `K[X]/(X ^ n - b)` with `y` multiplying by the class of `X`
and `x` acting as `α` times the automorphism `X ↦ ζ⁻¹ X`. On the basis `v_i = X ^ i`, `i < n`,
this is

* `x v_i = α ζ⁻¹ ^ i v_i`, a diagonal matrix whose entries are pairwise distinct;
* `y v_i = v_(i+1)` for `i + 1 < n` and `y v_(n-1) = b v_0`, the forward shift with wrap factor
  `b`.

The representation makes sense over any commutative ring
(`TauCeti.SymbolAlgebra.toEndAdjoinRootOfPowEq`). Over a field it is an isomorphism
`(a, b)_ζ ≃ₐ[K] Mat_n(K)` (`TauCeti.SymbolAlgebra.algEquivMatrixOfPowEq`): it is injective since
the cyclic algebra is simple (`TauCeti.SymbolAlgebra.isSimpleRing`), and both sides have dimension
`n ^ 2`. Consequently the Brauer class of `(a, b)_ζ` is trivial when `a` is an `n`-th power.

For a field extension `L / F` and `α ∈ L` with `α ^ n = a`, the same matrices over `L` give the
**splitting representation** `L ⊗[F] (a, b)_ζ ≃ₐ[L] Mat_n(L)`
(`TauCeti.SymbolAlgebra.baseChangeAlgEquivMatrix`); here injectivity uses that the scalar extension
of a central simple algebra is simple (`IsSimpleRing.tensorProduct_of_isCentral_right`). So every
extension containing an `n`-th root of `a`, for instance `F(a ^ (1 / n))`, splits `(a, b)_ζ`. The
hypothesis on `a` cannot be dropped: Hamilton's quaternions `(-1, -1)_(-1)` over `ℝ` are split by
`ℂ` but not by `ℝ`.

## Main definitions

* `TauCeti.SymbolAlgebra.toEndAdjoinRootOfPowEq`: the representation of `(a, b)_ζ` on
  `R[X]/(X ^ n - b)` attached to `α` with `α ^ n = a`.
* `TauCeti.SymbolAlgebra.algEquivMatrixOfPowEq`: `(a, b)_ζ ≃ₐ[K] Mat_n(K)` when `α ^ n = a`.
* `TauCeti.SymbolAlgebra.baseChangeAlgEquivMatrix`: `L ⊗[F] (a, b)_ζ ≃ₐ[L] Mat_n(L)` when
  `α ∈ L` has `α ^ n = a`.

## Main results

* `TauCeti.SymbolAlgebra.algEquivMatrixOfPowEq_x`, `TauCeti.SymbolAlgebra.algEquivMatrixOfPowEq_y`,
  `TauCeti.SymbolAlgebra.baseChangeAlgEquivMatrix_one_tmul_x`,
  `TauCeti.SymbolAlgebra.baseChangeAlgEquivMatrix_one_tmul_y`: the generators go to the diagonal
  matrix and to the shift matrix with wrap factor `b`.
* `TauCeti.SymbolAlgebra.baseChangeAlgEquivMatrix_one_tmul_eq_algEquivMatrixOfPowEq`,
  `TauCeti.SymbolAlgebra.baseChangeAlgEquivMatrix_one_tmul_map`: the splitting representation for
  the identity extension is `algEquivMatrixOfPowEq`, and it is compatible with a further
  extension carrying `α` to its image.
* `TauCeti.SymbolAlgebra.isSplittingField_of_pow_eq`: an extension containing an `n`-th root of `a`
  splits `(a, b)_ζ`.
* `TauCeti.SymbolAlgebra.brauerClass_eq_one_of_pow_eq`: if `a` is an `n`-th power, the Brauer class
  of `(a, b)_ζ` is trivial.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-theory*, AMS (2013), III.6.9 and the
  split-algebra argument around Lemma III.6.9.1.
* P. Gille, T. Szamuely, *Central Simple Algebras and Galois Cohomology*, CUP (2006), §2.5.
-/

public section

open Polynomial

open scoped TensorProduct

namespace TauCeti

namespace SymbolAlgebra

section CommRing

variable {R : Type*} [CommRing R] {n : ℕ} [NeZero n] {ζ a b α : R}

private theorem mkOfPowEq_pow (hζ : ζ ^ n = 1) : rootsOfUnity.mkOfPowEq ζ hζ ^ n = 1 := by
  ext
  simp [hζ]

/-- The relation `x ^ n = a` in the representation on `R[X]/(X ^ n - b)`. -/
private theorem toEnd_x_pow (hζ : ζ ^ n = 1) (hα : α ^ n = a) :
    (α • (standardTameCoverAut b (rootsOfUnity.mkOfPowEq ζ hζ)⁻¹).toLinearMap) ^ n =
      algebraMap R _ a := by
  refine LinearMap.ext fun q => ?_
  simp [smul_pow, ← AlgEquiv.pow_toLinearMap, ← map_pow, mkOfPowEq_pow hζ, hα]

omit [NeZero n] in
/-- The relation `y ^ n = b` in the representation on `R[X]/(X ^ n - b)`. -/
private theorem toEnd_y_pow :
    LinearMap.mulLeft R (AdjoinRoot.root (X ^ n - C b : R[X])) ^ n = algebraMap R _ b :=
  LinearMap.ext fun q => by
    simp [LinearMap.pow_mulLeft, ← AdjoinRoot.algebraMap_eq, ← Algebra.smul_def]

/-- The relation `y * x = ζ • (x * y)` in the representation on `R[X]/(X ^ n - b)`. -/
private theorem toEnd_y_mul_x (hζ : ζ ^ n = 1) :
    LinearMap.mulLeft R (AdjoinRoot.root (X ^ n - C b : R[X])) *
        (α • (standardTameCoverAut b (rootsOfUnity.mkOfPowEq ζ hζ)⁻¹).toLinearMap) =
      ζ • ((α • (standardTameCoverAut b (rootsOfUnity.mkOfPowEq ζ hζ)⁻¹).toLinearMap) *
        LinearMap.mulLeft R (AdjoinRoot.root (X ^ n - C b : R[X]))) := by
  refine LinearMap.ext fun q => ?_
  -- `ζ` times the scalar `ζ⁻¹` by which `X ↦ ζ⁻¹ X` rescales `X` is `1`
  have hu : algebraMap R (AdjoinRoot (X ^ n - C b)) ζ *
      algebraMap R _ (((rootsOfUnity.mkOfPowEq ζ hζ : Rˣ)⁻¹ : Rˣ) : R) = 1 := by
    rw [← map_mul, ← map_one (algebraMap R _)]
    exact congrArg _ (rootsOfUnity.mkOfPowEq ζ hζ : Rˣ).mul_inv
  simp only [mul_apply_eq_comp, LinearMap.smul_apply, LinearMap.mulLeft_apply,
    AlgEquiv.toLinearMap_apply, map_mul, standardTameCoverAut_root, InvMemClass.coe_inv]
  simp only [Algebra.smul_def]
  linear_combination (-(algebraMap R _ α * AdjoinRoot.root _ *
    standardTameCoverAut b (rootsOfUnity.mkOfPowEq ζ hζ)⁻¹ q)) * hu

variable (b) in
/-- The representation of the symbol algebra `(a, b)_ζ` on `R[X]/(X ^ n - b)` attached to an
`n`-th root `α` of `a`: `y` multiplies by the class of `X`, and `x` is `α` times the algebra
automorphism `X ↦ ζ⁻¹ X`. In the basis `X ^ i`, `i < n`, `x` is the diagonal matrix with entries
`α ζ⁻¹ ^ i` and `y` is the forward shift with wrap factor `b`
(`TauCeti.SymbolAlgebra.algEquivMatrixOfPowEq_x`, `TauCeti.SymbolAlgebra.algEquivMatrixOfPowEq_y`).
-/
noncomputable def toEndAdjoinRootOfPowEq (hζ : ζ ^ n = 1) (hα : α ^ n = a) :
    SymbolAlgebra n ζ a b →ₐ[R] Module.End R (AdjoinRoot (X ^ n - C b)) :=
  lift _ _ (toEnd_x_pow hζ hα) toEnd_y_pow (toEnd_y_mul_x hζ)

/-- In the representation `toEndAdjoinRootOfPowEq`, `x` is `α` times the automorphism
`X ↦ ζ⁻¹ X` of `R[X]/(X ^ n - b)`. -/
@[simp]
theorem toEndAdjoinRootOfPowEq_x (hζ : ζ ^ n = 1) (hα : α ^ n = a) :
    toEndAdjoinRootOfPowEq b hζ hα x =
      α • (standardTameCoverAut b (rootsOfUnity.mkOfPowEq ζ hζ)⁻¹).toLinearMap :=
  lift_x ..

/-- In the representation `toEndAdjoinRootOfPowEq`, `y` multiplies by the class of `X`. -/
@[simp]
theorem toEndAdjoinRootOfPowEq_y (hζ : ζ ^ n = 1) (hα : α ^ n = a) :
    toEndAdjoinRootOfPowEq b hζ hα y =
      LinearMap.mulLeft R (AdjoinRoot.root (X ^ n - C b : R[X])) :=
  lift_y ..

end CommRing

section Field

variable {K : Type*} [Field K] {n : ℕ} [NeZero n] {ζ a b α : K}

/-- Over a field, for `ζ` a primitive `n`-th root of unity and `a, b ≠ 0`, the representation
`toEndAdjoinRootOfPowEq` of `(a, b)_ζ` on the `n`-dimensional space `K[X]/(X ^ n - b)` is
bijective. -/
theorem bijective_toEndAdjoinRootOfPowEq (hζ : IsPrimitiveRoot ζ n) (hα : α ^ n = a)
    (ha : a ≠ 0) (hb : b ≠ 0) :
    Function.Bijective (toEndAdjoinRootOfPowEq b hζ.pow_eq_one hα) := by
  have := isSimpleRing hζ ha hb
  have := finite (a := a) (b := b) hζ.pow_eq_one
  have := Module.Finite.of_basis (AdjoinRoot.basisXPowSubC n b)
  refine AlgHom.bijective_of_finrank_eq _ ?_
  simp [finrank_eq hζ.pow_eq_one, Module.finrank_linearMap,
    Module.finrank_eq_card_basis (AdjoinRoot.basisXPowSubC n b), sq]

/-- **A cyclic algebra `(a, b)_ζ` with `a` an `n`-th power is a matrix algebra**: if `α ^ n = a`,
then `(a, b)_ζ ≃ₐ[K] Mat_n(K)`, through the representation `toEndAdjoinRootOfPowEq` on
`K[X]/(X ^ n - b)` and its basis `X ^ i`, `i < n`. It sends `x` to the diagonal matrix with
entries `α ζ⁻¹ ^ i` and `y` to the forward shift with wrap factor `b`
(`TauCeti.SymbolAlgebra.algEquivMatrixOfPowEq_x`, `TauCeti.SymbolAlgebra.algEquivMatrixOfPowEq_y`).
No `n`-th root of `b` is needed. -/
noncomputable def algEquivMatrixOfPowEq (hζ : IsPrimitiveRoot ζ n) (hα : α ^ n = a) (ha : a ≠ 0)
    (hb : b ≠ 0) : SymbolAlgebra n ζ a b ≃ₐ[K] Matrix (Fin n) (Fin n) K :=
  (AlgEquiv.ofBijective _ (bijective_toEndAdjoinRootOfPowEq hζ hα ha hb)).trans
    (LinearMap.toMatrixAlgEquiv (AdjoinRoot.basisXPowSubC n b))

/-- The matrix entries of `algEquivMatrixOfPowEq z` are the coordinates of the images of the
basis vectors `X ^ j` under `toEndAdjoinRootOfPowEq`. -/
private theorem algEquivMatrixOfPowEq_apply (hζ : IsPrimitiveRoot ζ n) (hα : α ^ n = a)
    (ha : a ≠ 0) (hb : b ≠ 0) (z : SymbolAlgebra n ζ a b) (i j : Fin n) :
    algEquivMatrixOfPowEq hζ hα ha hb z i j = (AdjoinRoot.basisXPowSubC n b).repr
      (toEndAdjoinRootOfPowEq b hζ.pow_eq_one hα z (AdjoinRoot.root _ ^ (j : ℕ))) i := by
  rw [algEquivMatrixOfPowEq, AlgEquiv.trans_apply, AlgEquiv.ofBijective_apply,
    LinearMap.toMatrixAlgEquiv_apply, AdjoinRoot.basisXPowSubC_apply]

/-- Under `algEquivMatrixOfPowEq`, the generator `x` is the diagonal matrix with entries
`α ζ⁻¹ ^ i`. -/
@[simp]
theorem algEquivMatrixOfPowEq_x (hζ : IsPrimitiveRoot ζ n) (hα : α ^ n = a) (ha : a ≠ 0)
    (hb : b ≠ 0) :
    algEquivMatrixOfPowEq hζ hα ha hb x = Matrix.diagonal fun i : Fin n => α * ζ⁻¹ ^ (i : ℕ) := by
  ext i j
  -- `x` sends `X ^ j` to `α (ζ⁻¹ X) ^ j = (α ζ⁻¹ ^ j) X ^ j`
  have h : toEndAdjoinRootOfPowEq b hζ.pow_eq_one hα x (AdjoinRoot.root _ ^ (j : ℕ)) =
      algebraMap K _ (α * ζ⁻¹ ^ (j : ℕ)) * AdjoinRoot.root _ ^ (j : ℕ) := by
    rw [toEndAdjoinRootOfPowEq_x, LinearMap.smul_apply, AlgEquiv.toLinearMap_apply, map_pow,
      standardTameCoverAut_root]
    simp [mul_pow, Algebra.smul_def, mul_assoc, -inv_pow]
  rw [algEquivMatrixOfPowEq_apply, h, AdjoinRoot.basisXPowSubC_repr_algebraMap_mul_root_pow]
  rcases eq_or_ne i j with rfl | hij
  · simp
  · simp [hij]

/-- Under `algEquivMatrixOfPowEq`, the generator `y` is the forward shift with wrap factor `b`:
it sends the `j`-th basis vector to the `(j + 1)`-th for `j + 1 < n`, and the last one to `b`
times the first. -/
@[simp]
theorem algEquivMatrixOfPowEq_y (hζ : IsPrimitiveRoot ζ n) (hα : α ^ n = a) (ha : a ≠ 0)
    (hb : b ≠ 0) :
    algEquivMatrixOfPowEq hζ hα ha hb y = Matrix.of fun i j : Fin n =>
      if (i : ℕ) = j + 1 then 1 else if (i : ℕ) = 0 ∧ (j : ℕ) + 1 = n then b else 0 := by
  ext i j
  rw [algEquivMatrixOfPowEq_apply, toEndAdjoinRootOfPowEq_y, LinearMap.mulLeft_apply,
    ← pow_succ', Matrix.of_apply]
  rcases (show (j : ℕ) + 1 ≤ n from j.isLt).lt_or_eq with h | h
  · -- the image `X ^ (j + 1)` of `X ^ j` is the next basis vector
    rw [AdjoinRoot.basisXPowSubC_repr_root_pow _ _ ⟨j + 1, h⟩, Finsupp.single_apply]
    by_cases hi : (i : ℕ) = j + 1
    · simp [Fin.ext_iff, hi]
    · have h1 : (⟨j + 1, h⟩ : Fin n) ≠ i := fun h' => hi (congrArg Fin.val h').symm
      simp [h1, hi, h.ne]
  · -- the image `X ^ n = b` of `X ^ (n - 1)` is `b` times the first basis vector
    rw [h, AdjoinRoot.basisXPowSubC_repr_root_pow_self, Finsupp.single_apply]
    rcases eq_or_ne i 0 with rfl | hi
    · simp [(NeZero.ne n).symm]
    · simp [hi, hi.symm, i.isLt.ne]

/-- **A cyclic algebra `(a, b)_ζ` with `a` an `n`-th power is split**: its Brauer class is
trivial. -/
theorem brauerClass_eq_one_of_pow_eq (hζ : IsPrimitiveRoot ζ n) (hα : α ^ n = a) (ha : a ≠ 0)
    (hb : b ≠ 0) : brauerClass hζ ha hb = 1 := by
  have := isCentral hζ ha hb
  have := isSimpleRing hζ ha hb
  have := finite (a := a) (b := b) hζ.pow_eq_one
  rw [brauerClass_eq_mk, BrauerGroup.mk_eq_one_iff]
  exact (IsBrauerEquivalent.of_algEquiv K (algEquivMatrixOfPowEq hζ hα ha hb)).trans
    (isBrauerTrivial_matrix K n)

end Field

section BaseChange

variable {F L : Type*} [Field F] [Field L] [Algebra F L] {n : ℕ} [NeZero n] {ζ a b : F} {α : L}

/-- The `F`-algebra map `(a, b)_ζ → Mat_n(L)` sending the generators to the matrices of
`algEquivMatrixOfPowEq` over `L`. -/
private noncomputable def toMatrixBaseChange (hζ : IsPrimitiveRoot ζ n)
    (hα : α ^ n = algebraMap F L a) (ha : a ≠ 0) (hb : b ≠ 0) :
    SymbolAlgebra n ζ a b →ₐ[F] Matrix (Fin n) (Fin n) L :=
  let e := algEquivMatrixOfPowEq (b := algebraMap F L b)
    (hζ.map_of_injective (algebraMap F L).injective) hα
    ((map_ne_zero (algebraMap F L)).2 ha) ((map_ne_zero (algebraMap F L)).2 hb)
  lift (e x) (e y)
    (by rw [← map_pow, x_pow, AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply])
    (by rw [← map_pow, y_pow, AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply])
    (by rw [← map_mul, y_mul_x, map_smul, map_mul, algebraMap_smul])

private theorem toMatrixBaseChange_x (hζ : IsPrimitiveRoot ζ n)
    (hα : α ^ n = algebraMap F L a) (ha : a ≠ 0) (hb : b ≠ 0) :
    toMatrixBaseChange hζ hα ha hb x =
      Matrix.diagonal fun i : Fin n => α * (algebraMap F L ζ)⁻¹ ^ (i : ℕ) := by
  rw [toMatrixBaseChange, lift_x, algEquivMatrixOfPowEq_x]

private theorem toMatrixBaseChange_y (hζ : IsPrimitiveRoot ζ n)
    (hα : α ^ n = algebraMap F L a) (ha : a ≠ 0) (hb : b ≠ 0) :
    toMatrixBaseChange hζ hα ha hb y = Matrix.of fun i j : Fin n =>
      if (i : ℕ) = j + 1 then 1
      else if (i : ℕ) = 0 ∧ (j : ℕ) + 1 = n then algebraMap F L b else 0 := by
  rw [toMatrixBaseChange, lift_y, algEquivMatrixOfPowEq_y]

/-- The `L`-algebra map `L ⊗[F] (a, b)_ζ → Mat_n(L)` extending `toMatrixBaseChange`. -/
private noncomputable def baseChangeToMatrix (hζ : IsPrimitiveRoot ζ n)
    (hα : α ^ n = algebraMap F L a) (ha : a ≠ 0) (hb : b ≠ 0) :
    L ⊗[F] SymbolAlgebra n ζ a b →ₐ[L] Matrix (Fin n) (Fin n) L :=
  Algebra.TensorProduct.lift (Algebra.ofId L _) (toMatrixBaseChange hζ hα ha hb)
    fun l _ => by rw [Algebra.ofId_apply]; exact Algebra.commute_algebraMap_left l _

private theorem bijective_baseChangeToMatrix (hζ : IsPrimitiveRoot ζ n)
    (hα : α ^ n = algebraMap F L a) (ha : a ≠ 0) (hb : b ≠ 0) :
    Function.Bijective (baseChangeToMatrix hζ hα ha hb) := by
  have := isCentral hζ ha hb
  have := isSimpleRing hζ ha hb
  have := finite (a := a) (b := b) hζ.pow_eq_one
  -- the scalar extension of a central simple algebra is simple, so the map is injective
  refine AlgHom.bijective_of_finrank_eq _ ?_
  simp [finrank_eq hζ.pow_eq_one, Module.finrank_matrix, sq]

/-- **The splitting representation of a cyclic algebra.** Let `ζ ∈ F` be a primitive `n`-th root
of unity, `a, b ∈ Fˣ`, and `L / F` a field extension containing an `n`-th root `α` of `a`. Then
`L ⊗[F] (a, b)_ζ ≃ₐ[L] Mat_n(L)`, sending `x` to the diagonal matrix with entries `α ζ⁻¹ ^ i` and
`y` to the forward shift with wrap factor `b`
(`TauCeti.SymbolAlgebra.baseChangeAlgEquivMatrix_one_tmul_x`,
`TauCeti.SymbolAlgebra.baseChangeAlgEquivMatrix_one_tmul_y`). No `n`-th root of `b` is needed. -/
noncomputable def baseChangeAlgEquivMatrix (hζ : IsPrimitiveRoot ζ n)
    (hα : α ^ n = algebraMap F L a) (ha : a ≠ 0) (hb : b ≠ 0) :
    L ⊗[F] SymbolAlgebra n ζ a b ≃ₐ[L] Matrix (Fin n) (Fin n) L :=
  AlgEquiv.ofBijective _ (bijective_baseChangeToMatrix hζ hα ha hb)

/-- Under `baseChangeAlgEquivMatrix`, the generator `1 ⊗ x` is the diagonal matrix with entries
`α ζ⁻¹ ^ i`. -/
@[simp]
theorem baseChangeAlgEquivMatrix_one_tmul_x (hζ : IsPrimitiveRoot ζ n)
    (hα : α ^ n = algebraMap F L a) (ha : a ≠ 0) (hb : b ≠ 0) :
    baseChangeAlgEquivMatrix hζ hα ha hb (1 ⊗ₜ x) =
      Matrix.diagonal fun i : Fin n => α * (algebraMap F L ζ)⁻¹ ^ (i : ℕ) := by
  rw [baseChangeAlgEquivMatrix, AlgEquiv.ofBijective_apply, baseChangeToMatrix,
    Algebra.TensorProduct.lift_tmul, map_one, one_mul, toMatrixBaseChange_x]

/-- Under `baseChangeAlgEquivMatrix`, the generator `1 ⊗ y` is the forward shift with wrap
factor `b`. -/
@[simp]
theorem baseChangeAlgEquivMatrix_one_tmul_y (hζ : IsPrimitiveRoot ζ n)
    (hα : α ^ n = algebraMap F L a) (ha : a ≠ 0) (hb : b ≠ 0) :
    baseChangeAlgEquivMatrix hζ hα ha hb (1 ⊗ₜ y) = Matrix.of fun i j : Fin n =>
      if (i : ℕ) = j + 1 then 1
      else if (i : ℕ) = 0 ∧ (j : ℕ) + 1 = n then algebraMap F L b else 0 := by
  rw [baseChangeAlgEquivMatrix, AlgEquiv.ofBijective_apply, baseChangeToMatrix,
    Algebra.TensorProduct.lift_tmul, map_one, one_mul, toMatrixBaseChange_y]

/-- For the trivial extension `L = F`, the splitting representation `baseChangeAlgEquivMatrix` is
`algEquivMatrixOfPowEq` on `1 ⊗ z`. -/
theorem baseChangeAlgEquivMatrix_one_tmul_eq_algEquivMatrixOfPowEq {α : F}
    (hζ : IsPrimitiveRoot ζ n) (hα : α ^ n = a) (ha : a ≠ 0) (hb : b ≠ 0)
    (z : SymbolAlgebra n ζ a b) :
    baseChangeAlgEquivMatrix (L := F) hζ hα ha hb (1 ⊗ₜ z) =
      algEquivMatrixOfPowEq hζ hα ha hb z := by
  have h : (baseChangeAlgEquivMatrix (L := F) hζ hα ha hb).toAlgHom.comp
      Algebra.TensorProduct.includeRight = (algEquivMatrixOfPowEq hζ hα ha hb).toAlgHom :=
    algHom_ext (by simp) (by simp)
  exact AlgHom.congr_fun h z

/-- The splitting representation `baseChangeAlgEquivMatrix` is compatible with a further field
extension `L'` of `L`, carrying `α` to its image: on `1 ⊗ z`, the representation over `L'` is the
entrywise image of the representation over `L`. -/
theorem baseChangeAlgEquivMatrix_one_tmul_map {L' : Type*} [Field L'] [Algebra F L']
    [Algebra L L'] [IsScalarTower F L L'] (hζ : IsPrimitiveRoot ζ n)
    (hα : α ^ n = algebraMap F L a) (hα' : algebraMap L L' α ^ n = algebraMap F L' a)
    (ha : a ≠ 0) (hb : b ≠ 0) (z : SymbolAlgebra n ζ a b) :
    baseChangeAlgEquivMatrix hζ hα' ha hb (1 ⊗ₜ z) =
      (baseChangeAlgEquivMatrix hζ hα ha hb (1 ⊗ₜ z)).map (algebraMap L L') := by
  have h : ((baseChangeAlgEquivMatrix hζ hα' ha hb).toAlgHom.restrictScalars F).comp
      Algebra.TensorProduct.includeRight = (IsScalarTower.toAlgHom F L L').mapMatrix.comp
        (((baseChangeAlgEquivMatrix hζ hα ha hb).toAlgHom.restrictScalars F).comp
          Algebra.TensorProduct.includeRight) :=
    algHom_ext (by simp [← IsScalarTower.algebraMap_apply])
      (by ext; simp [apply_ite (algebraMap L L'), ← IsScalarTower.algebraMap_apply])
  exact AlgHom.congr_fun h z

/-- **A field extension containing an `n`-th root of `a` splits the cyclic algebra `(a, b)_ζ`.** -/
theorem isSplittingField_of_pow_eq (hζ : IsPrimitiveRoot ζ n) (hα : α ^ n = algebraMap F L a)
    (ha : a ≠ 0) (hb : b ≠ 0) : Algebra.IsSplittingField F (SymbolAlgebra n ζ a b) L :=
  (Algebra.isSplittingField_iff F _ L).2 ⟨n, ⟨baseChangeAlgEquivMatrix hζ hα ha hb⟩⟩

end BaseChange

end SymbolAlgebra

end TauCeti
