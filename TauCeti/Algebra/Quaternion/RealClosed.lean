/-!
# Quaternion Brauer symbols over semireal and ordered real closed fields

Over any semireal field `K` (in particular, any ordered field or any real closed field), `-1` is
not a sum of squares, so the norm equation `-1 = x² + y²` of the Hamilton quaternion symbol
`(-1, -1)` has no solution. By the four-fold splitting criterion its Brauer class
`[(-1, -1)] = quaternionClass (-1) (-1)` is therefore nontrivial and of order `2`, and powers of
`[(-1, -1)]` depend only on the parity of the exponent.

When `K` is an ordered real closed field, every positive unit is a square and every negative unit
has the square class of `-1`. Consequently a quaternion symbol `[(a, b)]` equals `[(-1, -1)]` when
both `a` and `b` are negative and is trivial otherwise. In particular, the quaternion subgroup
`quaternionSubgroup K` of `BrauerGroup K` is cyclic of order `2`, generated by `[(-1, -1)]`.

## Main results

* `TauCeti.BrauerGroup.quaternionClass_pow`: a natural-number power of any quaternion symbol is
  `1` or `[(a, b)]` according to the parity of the exponent.
* `TauCeti.BrauerGroup.quaternionClass_neg_one_neg_one_ne_one`: `[(-1, -1)] ≠ 1` over a semireal
  field.
* `TauCeti.BrauerGroup.orderOf_quaternionClass_neg_one_neg_one`: `[(-1, -1)]` has order `2`.
* `TauCeti.BrauerGroup.quaternionClass_neg_one_neg_one_pow_eq_one_iff`,
  `TauCeti.BrauerGroup.quaternionClass_neg_one_neg_one_pow_eq_self_iff`,
  `TauCeti.BrauerGroup.quaternionClass_neg_one_neg_one_pow_eq_pow_iff`: parity rules for powers of
  `[(-1, -1)]`.
* `TauCeti.BrauerGroup.quaternionClass_eq_ite_neg`: closed formula for `[(a, b)]` over an ordered
  real closed field.
* `TauCeti.BrauerGroup.quaternionClass_eq_one_iff_pos` and
  `TauCeti.BrauerGroup.quaternionClass_eq_neg_one_neg_one_iff`: sign characterizations of trivial
  and nontrivial quaternion symbols.
* `TauCeti.BrauerGroup.quaternionSubgroup_eq_zpowers` and
  `TauCeti.BrauerGroup.card_quaternionSubgroup`: `quaternionSubgroup K` is generated by
  `[(-1, -1)]` and has cardinality `2`.

## References

* T. Y. Lam, *Introduction to Quadratic Forms over Fields* (2005), Chapter III, §2, Example 2.13.
-/

public section

namespace TauCeti

namespace BrauerGroup

section Field

variable {K : Type*} [Field K] [Invertible (2 : K)]

/-- Every quaternion symbol is `2`-torsion, so a natural-number power `[(a, b)] ^ n` is `1` when
`n` is even and `[(a, b)]` when `n` is odd. -/
theorem quaternionClass_pow (a b : Kˣ) (n : ℕ) :
    quaternionClass a b ^ n = if Even n then 1 else quaternionClass a b := by
  rcases n.even_or_odd with ⟨m, rfl⟩ | ⟨m, rfl⟩
  · simp [← two_mul, pow_mul]
  · rw [ite_eq_right (Nat.not_even_iff_odd.mpr ⟨m, rfl⟩), pow_add, pow_mul, quaternionClass_sq,
      one_pow, one_mul, pow_one]

end Field

section Semireal

variable {K : Type*} [Field K] [IsSemireal K] [Invertible (2 : K)]

/-- **Hamilton's quaternion symbol is nontrivial over any semireal field**: `-1` is not a sum of
two squares, so `ℍ[K, -1, -1]` is not split. -/
theorem quaternionClass_neg_one_neg_one_ne_one :
    quaternionClass (-1 : Kˣ) (-1) ≠ 1 := by
  rw [Ne, quaternionClass_eq_one_iff_exists_eq_sq_sub_mul_sq]
  rintro ⟨x, y, h⟩
  have hsum : (-1 : K) = x * x + y * y := by
    simpa only [Units.val_neg, Units.val_one, neg_mul, one_mul, sub_neg_eq_add, pow_two] using h
  exact IsSemireal.not_isSumSq_neg_one K
    (hsum ▸ (IsSumSq.mul_self x).add (IsSumSq.mul_self y))

/-- Over a semireal field, the Brauer class `[(-1, -1)]` has order `2`. -/
@[simp]
theorem orderOf_quaternionClass_neg_one_neg_one :
    orderOf (quaternionClass (-1 : Kˣ) (-1)) = 2 :=
  orderOf_eq_prime (quaternionClass_sq (-1) (-1)) quaternionClass_neg_one_neg_one_ne_one

/-- A power of `[(-1, -1)]` over a semireal field is trivial if and only if its exponent is even.
Not `@[simp]`: `quaternionClass_sq` already simplifies the `n = 2` instance of the left-hand
side. -/
theorem quaternionClass_neg_one_neg_one_pow_eq_one_iff (n : ℕ) :
    quaternionClass (-1 : Kˣ) (-1) ^ n = 1 ↔ Even n := by
  rw [← orderOf_dvd_iff_pow_eq_one, orderOf_quaternionClass_neg_one_neg_one, even_iff_two_dvd]

/-- A power of `[(-1, -1)]` over a semireal field equals `[(-1, -1)]` if and only if its exponent
is odd. -/
theorem quaternionClass_neg_one_neg_one_pow_eq_self_iff (n : ℕ) :
    quaternionClass (-1 : Kˣ) (-1) ^ n = quaternionClass (-1 : Kˣ) (-1) ↔ Odd n := by
  rw [quaternionClass_pow]
  split_ifs with h
  · simp [Nat.not_odd_iff_even.mpr h, quaternionClass_neg_one_neg_one_ne_one.symm]
  · simp [Nat.not_even_iff_odd.mp h]

/-- Two powers of `[(-1, -1)]` over a semireal field agree if and only if their exponents have the
same parity. -/
theorem quaternionClass_neg_one_neg_one_pow_eq_pow_iff (m n : ℕ) :
    quaternionClass (-1 : Kˣ) (-1) ^ m = quaternionClass (-1 : Kˣ) (-1) ^ n ↔ m ≡ n [MOD 2] := by
  rw [pow_eq_pow_iff_modEq, orderOf_quaternionClass_neg_one_neg_one]

end Semireal

section IsRealClosed

variable {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] [Invertible (2 : K)]
  [IsRealClosed K]

/-- Over an ordered real closed field, a quaternion symbol with positive first parameter is
trivial, because every positive element is a square. -/
theorem quaternionClass_of_pos_left {a : Kˣ} (ha : 0 < (a : K)) (b : Kˣ) :
    quaternionClass a b = 1 := by
  obtain ⟨c, rfl⟩ := Units.isSquare_coe_iff.mp (IsSquare.of_nonneg ha.le)
  rw [← pow_two, quaternionClass_sq_left]

/-- Over an ordered real closed field, a quaternion symbol with positive second parameter is
trivial. -/
theorem quaternionClass_of_pos_right (a : Kˣ) {b : Kˣ} (hb : 0 < (b : K)) :
    quaternionClass a b = 1 := by
  rw [quaternionClass_comm, quaternionClass_of_pos_left hb]

/-- Over an ordered real closed field, a quaternion symbol whose parameters are both negative
equals `[(-1, -1)]`. -/
theorem quaternionClass_of_neg {a b : Kˣ} (ha : (a : K) < 0) (hb : (b : K) < 0) :
    quaternionClass a b = quaternionClass (-1 : Kˣ) (-1) := by
  have ha' : a = -a * (-1 : Kˣ) := by simp
  have hb' : b = -b * (-1 : Kˣ) := by simp
  rw [ha', quaternionClass_mul_left,
    quaternionClass_of_pos_left (by simpa using neg_pos.mpr ha), one_mul,
    hb', quaternionClass_mul,
    quaternionClass_of_pos_right _ (by simpa using neg_pos.mpr hb), one_mul]

/-- **Closed formula for quaternion symbols over an ordered real closed field**: `[(a, b)]` is
`[(-1, -1)]` when both parameters are negative and `1` otherwise. -/
theorem quaternionClass_eq_ite_neg (a b : Kˣ) :
    quaternionClass a b =
      if (a : K) < 0 ∧ (b : K) < 0 then quaternionClass (-1 : Kˣ) (-1) else 1 := by
  split_ifs with h
  · exact quaternionClass_of_neg h.1 h.2
  · rcases lt_or_gt_of_ne a.ne_zero with ha | ha
    · rcases lt_or_gt_of_ne b.ne_zero with hb | hb
      · exact absurd ⟨ha, hb⟩ h
      · exact quaternionClass_of_pos_right a hb
    · exact quaternionClass_of_pos_left ha b

/-- Over an ordered real closed field, a quaternion symbol is trivial if and only if at least one
of its parameters is positive. -/
theorem quaternionClass_eq_one_iff_pos (a b : Kˣ) :
    quaternionClass a b = 1 ↔ 0 < (a : K) ∨ 0 < (b : K) := by
  have ha := a.ne_zero
  have hb := b.ne_zero
  rw [quaternionClass_eq_ite_neg]
  split_ifs with h
  · exact ⟨fun h1 => absurd h1 quaternionClass_neg_one_neg_one_ne_one,
      fun hpos => by rcases hpos with ha' | hb' <;> linarith [h.1, h.2]⟩
  · refine ⟨fun _ => ?_, fun _ => rfl⟩
    rcases lt_or_gt_of_ne ha with ha' | ha'
    · exact Or.inr ((lt_or_gt_of_ne hb).resolve_left fun hb' => h ⟨ha', hb'⟩)
    · exact Or.inl ha'

/-- Over an ordered real closed field, a quaternion symbol equals `[(-1, -1)]` if and only if both
parameters are negative. -/
theorem quaternionClass_eq_neg_one_neg_one_iff (a b : Kˣ) :
    quaternionClass a b = quaternionClass (-1 : Kˣ) (-1) ↔ (a : K) < 0 ∧ (b : K) < 0 := by
  rw [quaternionClass_eq_ite_neg]
  split_ifs with h
  · simp [h]
  · simp [h, quaternionClass_neg_one_neg_one_ne_one.symm]

/-- Over an ordered real closed field, the quaternion subgroup of `BrauerGroup K` is the cyclic
subgroup generated by `[(-1, -1)]`. -/
theorem quaternionSubgroup_eq_zpowers :
    quaternionSubgroup K = Subgroup.zpowers (quaternionClass (-1 : Kˣ) (-1)) := by
  apply le_antisymm
  · rw [quaternionSubgroup, Subgroup.closure_le]
    rintro _ ⟨⟨a, b⟩, rfl⟩
    simp only [SetLike.mem_coe]
    rw [quaternionClass_eq_ite_neg a b]
    split_ifs
    · exact Subgroup.mem_zpowers _
    · exact one_mem _
  · rw [Subgroup.zpowers_le]
    exact quaternionClass_mem_quaternionSubgroup K (-1) (-1)

/-- Over an ordered real closed field, the quaternion subgroup of `BrauerGroup K` has order `2`. -/
@[simp]
theorem card_quaternionSubgroup : Nat.card (quaternionSubgroup K) = 2 := by
  rw [quaternionSubgroup_eq_zpowers, Nat.card_zpowers, orderOf_quaternionClass_neg_one_neg_one]

end IsRealClosed

end BrauerGroup

end TauCeti
