module

public import Mathlib.FieldTheory.IsRealClosed.Basic
public import TauCeti.Algebra.Quaternion.Subgroup
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# Quaternion Brauer symbols over ordered real closed fields

When `K` is an ordered real closed field, every positive unit is a square and every negative unit
has the square class of `-1`. Consequently a quaternion symbol `[(a, b)]` equals `[(-1, -1)]` when
both `a` and `b` are negative and is trivial otherwise. Combined with the nontriviality and
order-`2` results for `[(-1, -1)]` over semireal fields in `TauCeti.Algebra.Quaternion.BrauerClass`,
this shows that the quaternion subgroup `quaternionSubgroup K` of `BrauerGroup K` is cyclic of
order `2`, generated by `[(-1, -1)]`.

## Main results

* `TauCeti.BrauerGroup.quaternionClass_eq_ite_neg`: closed formula for `[(a, b)]` over an ordered
  real closed field.
* `TauCeti.BrauerGroup.quaternionClass_eq_one_iff_pos` and
  `TauCeti.BrauerGroup.quaternionClass_eq_neg_one_neg_one_iff`: sign characterizations of trivial
  and nontrivial quaternion symbols.
* `TauCeti.BrauerGroup.quaternionSubgroup_eq_zpowers` and
  `TauCeti.BrauerGroup.card_quaternionSubgroup`: `quaternionSubgroup K` is generated by
  `[(-1, -1)]` and has cardinality `2`.

## References

* T. Y. Lam, *Introduction to Quadratic Forms over Fields* (2005), Chapter III, §2, Example 2.13.
-/

public section

namespace TauCeti

namespace BrauerGroup

section IsRealClosed

variable {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] [Invertible (2 : K)]
  [IsRealClosed K]

/-- Over an ordered real closed field, a quaternion symbol with positive first parameter is
trivial, because every positive element is a square. -/
theorem quaternionClass_of_pos_left {a : Kˣ} (ha : 0 < (a : K)) (b : Kˣ) :
    quaternionClass a b = 1 := by
  obtain ⟨c, rfl⟩ := Units.isSquare_coe_iff.mp (IsSquare.of_nonneg ha.le)
  rw [← pow_two, quaternionClass_sq_left]

/-- Over an ordered real closed field, a quaternion symbol with positive second parameter is
trivial. -/
theorem quaternionClass_of_pos_right (a : Kˣ) {b : Kˣ} (hb : 0 < (b : K)) :
    quaternionClass a b = 1 := by
  rw [quaternionClass_comm, quaternionClass_of_pos_left hb]

/-- Over an ordered real closed field, a quaternion symbol whose parameters are both negative
equals `[(-1, -1)]`. -/
theorem quaternionClass_of_neg {a b : Kˣ} (ha : (a : K) < 0) (hb : (b : K) < 0) :
    quaternionClass a b = quaternionClass (-1 : Kˣ) (-1) := by
  have ha' : a = -a * (-1 : Kˣ) := by simp
  have hb' : b = -b * (-1 : Kˣ) := by simp
  rw [ha', quaternionClass_mul_left,
    quaternionClass_of_pos_left (by simpa using neg_pos.mpr ha), one_mul,
    hb', quaternionClass_mul,
    quaternionClass_of_pos_right _ (by simpa using neg_pos.mpr hb), one_mul]

/-- **Closed formula for quaternion symbols over an ordered real closed field**: `[(a, b)]` is
`[(-1, -1)]` when both parameters are negative and `1` otherwise. -/
theorem quaternionClass_eq_ite_neg (a b : Kˣ) :
    quaternionClass a b =
      if (a : K) < 0 ∧ (b : K) < 0 then quaternionClass (-1 : Kˣ) (-1) else 1 := by
  split_ifs with h
  · exact quaternionClass_of_neg h.left h.right
  · rcases lt_or_gt_of_ne a.ne_zero with ha | ha
    · rcases lt_or_gt_of_ne b.ne_zero with hb | hb
      · exact absurd ⟨ha, hb⟩ h
      · exact quaternionClass_of_pos_right a hb
    · exact quaternionClass_of_pos_left ha b

/-- Over an ordered real closed field, a quaternion symbol is trivial if and only if at least one
of its parameters is positive. -/
theorem quaternionClass_eq_one_iff_pos (a b : Kˣ) :
    quaternionClass a b = 1 ↔ 0 < (a : K) ∨ 0 < (b : K) := by
  have ha := a.ne_zero
  have hb := b.ne_zero
  rw [quaternionClass_eq_ite_neg]
  split_ifs with h
  · exact ⟨fun h1 => absurd h1 quaternionClass_neg_one_neg_one_ne_one,
      fun hpos => by rcases hpos with ha' | hb' <;> linarith [h.left, h.right]⟩
  · refine ⟨fun _ => ?_, fun _ => rfl⟩
    rcases lt_or_gt_of_ne ha with ha' | ha'
    · exact Or.inr ((lt_or_gt_of_ne hb).resolve_left fun hb' => h ⟨ha', hb'⟩)
    · exact Or.inl ha'

/-- Over an ordered real closed field, a quaternion symbol equals `[(-1, -1)]` if and only if both
parameters are negative. -/
theorem quaternionClass_eq_neg_one_neg_one_iff (a b : Kˣ) :
    quaternionClass a b = quaternionClass (-1 : Kˣ) (-1) ↔ (a : K) < 0 ∧ (b : K) < 0 := by
  rw [quaternionClass_eq_ite_neg]
  split_ifs with h
  · simp [h]
  · simp [h, quaternionClass_neg_one_neg_one_ne_one.symm]

/-- Over an ordered real closed field, the quaternion subgroup of `BrauerGroup K` is the cyclic
subgroup generated by `[(-1, -1)]`. -/
theorem quaternionSubgroup_eq_zpowers :
    quaternionSubgroup K = Subgroup.zpowers (quaternionClass (-1 : Kˣ) (-1)) := by
  apply le_antisymm
  · rw [quaternionSubgroup, Subgroup.closure_le]
    rintro _ ⟨⟨a, b⟩, rfl⟩
    simp only [SetLike.mem_coe]
    rw [quaternionClass_eq_ite_neg a b]
    split_ifs
    · exact Subgroup.mem_zpowers _
    · exact one_mem _
  · rw [Subgroup.zpowers_le]
    exact quaternionClass_mem_quaternionSubgroup K (-1) (-1)

/-- Over an ordered real closed field, the quaternion subgroup of `BrauerGroup K` has order `2`. -/
@[simp]
theorem card_quaternionSubgroup : Nat.card (quaternionSubgroup K) = 2 := by
  rw [quaternionSubgroup_eq_zpowers, Nat.card_zpowers, orderOf_quaternionClass_neg_one_neg_one]

end IsRealClosed

end BrauerGroup

end TauCeti
