module

public import TauCeti.Algebra.Quaternion.BrauerClass

/-!
# The subgroup generated by quaternion classes

The quaternion subgroup of the Brauer group is generated by the classes of the quaternion
algebras `ℍ[K,a,b]`, for units `a` and `b`. Products of quaternion classes, such as the Hasse
invariant of a regular quadratic form, belong to this subgroup. Over a general field a product
need not itself be the class of a quaternion algebra.

## References

* T. Y. Lam, *Introduction to Quadratic Forms over Fields*, Chapter V, §3.
-/

public section

namespace TauCeti.BrauerGroup

variable (K : Type*) [Field K] [Invertible (2 : K)]

/-- The subgroup of the Brauer group generated by quaternion algebra classes. -/
@[expose]
def quaternionSubgroup : Subgroup (BrauerGroup K) :=
  Subgroup.closure (Set.range fun ab : Kˣ × Kˣ => quaternionClass ab.1 ab.2)

/-- Every quaternion symbol belongs to the quaternion subgroup. -/
@[simp]
theorem quaternionClass_mem_quaternionSubgroup (a b : Kˣ) :
    quaternionClass a b ∈ quaternionSubgroup K :=
  Subgroup.subset_closure (Set.mem_range_self (a, b))

end TauCeti.BrauerGroup
