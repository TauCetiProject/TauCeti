module

public import Mathlib.Algebra.Group.Subgroup.Defs
public import Mathlib.Data.Int.GCD
public import Mathlib.Data.Nat.Find
public import Mathlib.Data.Nat.Prime.Defs

/-!
# Coprime exponents in a group

If `n` and `m` are coprime natural numbers then every element `y` of a group lies in the subgroup
generated by `y ^ n` and `y ^ m`: a Bézout identity `1 = n * i + m * j` turns into the
factorization `y = (y ^ n) ^ i * (y ^ m) ^ j`, with `i` and `j` the same for every `y`.

The same arithmetic, run over all primes at once, detects membership in a subgroup: if for every
prime `p` some power `x ^ m` with `p ∤ m` lies in `H`, then `x ∈ H`, because the exponents `m`
with `x ^ m ∈ H` are the multiples of a single number that no prime divides. This is the
prime-by-prime assembly step of Brauer's induction theorem, where `m • 1` lies in the span of
virtual characters induced from `p`-elementary subgroups.

## Main results

* `TauCeti.exists_zpow_mul_zpow_eq_of_coprime` and its additive form
  `TauCeti.exists_zsmul_add_zsmul_eq_of_coprime`: the factorization above, with coefficients
  independent of `y`.
* `TauCeti.exists_pow_eq_and_pow_eq_of_coprime` and its additive form
  `TauCeti.exists_nsmul_eq_and_nsmul_eq_of_coprime`: for coprime `n` and `m`, elements `x` and `y`
  of a commutative group with `x ^ m = y ^ n` are `v ^ n` and `v ^ m` for a single `v`.
* `TauCeti.mem_of_forall_prime_exists_pow_mem` and its additive form
  `TauCeti.mem_of_forall_prime_exists_nsmul_mem`: membership from prime-to-`p` powers, one
  prime at a time, in any subgroup (or additive subgroup) of a group.
-/

public section

namespace TauCeti

/-- For coprime `n` and `m`, every element `y` of a group factors as a product of an integer power
of `y ^ n` and an integer power of `y ^ m`, the exponents being the Bézout coefficients of `n` and
`m` and hence independent of `y`. Consequently `y` lies in any subgroup product `A * B` with
`y ^ n ∈ A` and `y ^ m ∈ B`. -/
@[to_additive
/-- For coprime `n` and `m`, every element `y` of an additive group decomposes as a sum of an
integer multiple of `n • y` and an integer multiple of `m • y`, the coefficients being the Bézout
coefficients of `n` and `m` and hence independent of `y`. -/]
theorem exists_zpow_mul_zpow_eq_of_coprime {G : Type*} [Group G] {n m : ℕ}
    (h : Nat.Coprime n m) : ∃ i j : ℤ, ∀ y : G, (y ^ n) ^ i * (y ^ m) ^ j = y :=
  ⟨Nat.gcdA n m, Nat.gcdB n m, fun y ↦ by
    calc (y ^ n) ^ Nat.gcdA n m * (y ^ m) ^ Nat.gcdB n m
        = y ^ ((n : ℤ) * Nat.gcdA n m + (m : ℤ) * Nat.gcdB n m) := by
          rw [zpow_add, zpow_mul, zpow_mul, zpow_natCast, zpow_natCast]
      _ = y ^ ((Nat.gcd n m : ℕ) : ℤ) := by rw [← Nat.gcd_eq_gcd_ab]
      _ = y := by rw [h.gcd_eq_one, zpow_natCast, pow_one]⟩

/-- **Common roots for coprime exponents.** For coprime `n` and `m`, two elements `x` and `y` of a
commutative group with `x ^ m = y ^ n` are the `n`-th and `m`-th powers of a single element `v`.
Writing `1 = n i + m j`, the element `v = x ^ i * y ^ j` works. -/
@[to_additive /-- **Common divisions for coprime coefficients.** For coprime `n` and `m`, two
elements `x` and `y` of an additive commutative group with `m • x = n • y` are the multiples `n • v`
and `m • v` of a single element `v`. -/]
theorem exists_pow_eq_and_pow_eq_of_coprime {G : Type*} [CommGroup G] {n m : ℕ}
    (h : Nat.Coprime n m) {x y : G} (hxy : x ^ m = y ^ n) : ∃ v : G, v ^ n = x ∧ v ^ m = y := by
  obtain ⟨i, j, hij⟩ := exists_zpow_mul_zpow_eq_of_coprime (G := G) h
  have hcomm (g : G) (k : ℤ) (l : ℕ) : (g ^ k) ^ l = (g ^ l) ^ k := by
    rw [← zpow_natCast, ← zpow_mul, ← zpow_natCast, ← zpow_mul, mul_comm]
  refine ⟨x ^ i * y ^ j, ?_, ?_⟩
  · rw [mul_pow, hcomm, hcomm, ← hxy]
    exact hij x
  · rw [mul_pow, hcomm, hcomm, hxy]
    exact hij y

/-- **Membership from prime-to-`p` powers.** If for every prime `p` some power `x ^ m` with
`p ∤ m` lies in the subgroup `H`, then `x` lies in `H`. -/
@[to_additive /-- **Membership from prime-to-`p` multiples.** If for every prime `p` some multiple
`m • x` with `p ∤ m` lies in the additive subgroup `H`, then `x` lies in `H`. -/]
theorem mem_of_forall_prime_exists_pow_mem {G S : Type*} [Group G] [SetLike S G]
    [SubgroupClass S G] {H : S} {x : G} (h : ∀ p : ℕ, p.Prime → ∃ m : ℕ, ¬ p ∣ m ∧ x ^ m ∈ H) :
    x ∈ H := by
  have hex : ∃ d, 0 < d ∧ x ^ d ∈ H := by
    obtain ⟨m, hm, hmH⟩ := h 2 Nat.prime_two
    exact ⟨m, Nat.pos_of_ne_zero fun hm0 ↦ hm (hm0 ▸ dvd_zero 2), hmH⟩
  classical
  obtain ⟨hd, hdH⟩ := Nat.find_spec hex
  -- The least positive exponent `d` with `x ^ d ∈ H` divides every such exponent.
  have hdvd {m : ℕ} (hm : x ^ m ∈ H) : Nat.find hex ∣ m := by
    rw [← Nat.div_add_mod m (Nat.find hex), pow_add, pow_mul,
      mul_mem_cancel_left (pow_mem hdH _)] at hm
    exact Nat.dvd_of_mod_eq_zero <| by_contra fun hne ↦
      Nat.find_min hex (Nat.mod_lt m hd) ⟨Nat.pos_of_ne_zero hne, hm⟩
  -- So no prime divides `d`, which is therefore `1`.
  obtain h1 | h1 := eq_or_ne (Nat.find hex) 1
  · simpa [h1] using hdH
  · obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd h1
    obtain ⟨m, hm, hmH⟩ := h p hp
    exact absurd (hpd.trans (hdvd hmH)) hm

end TauCeti
