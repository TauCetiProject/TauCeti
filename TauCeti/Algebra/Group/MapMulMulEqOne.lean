module

public import Mathlib.Algebra.Group.Hom.Defs

/-!
# Building a homomorphism from a ternary relation

Mathlib builds a `MonoidHom` out of a bare map from the two-variable identities
`f (x * y) = f x * f y` (`MonoidHom.mk'`) and `f (x * y⁻¹) = f x * (f y)⁻¹`
(`MonoidHom.ofMapMulInv`). Some maps are not naturally presented that way: they are defined by a
*symmetric ternary* condition, and what one can prove about them directly is that they send triples
with product `1` to triples with product `1`. The motivating example is the descent map on an
elliptic curve, whose defining property is that the classes of three collinear points multiply to
`1` — collinearity being symmetric in the three points, whereas the group law is not.

## Main results

* `MonoidHom.ofMapMulMulEqOne`: a map from a group to a monoid with `f 1 = 1` that sends triples
  with product `1` to triples with product `1` is a homomorphism, and
  `MonoidHom.coe_ofMapMulMulEqOne` says it is the original map. The additive versions are
  generated by `to_additive`.

## Provenance

Adapted, with the author's proof, from Michael Stoll's `EllipticCurves` project
(`github.com/MichaelStollBayreuth/EllipticCurves`, Apache-2.0, pinned by
`TauCetiRoadmap/EllipticCurves/README.md` at `66889eada51a`), `EllipticCurves/Mathlib/Basic.lean`.
-/

public section

variable {G H : Type*} [Group G] [Monoid H]

/-- A map `f` from a group to a monoid with `f 1 = 1` that sends triples with product `1` to
triples with product `1` is a homomorphism. Useful when a map is naturally defined via a symmetric
ternary relation, like collinearity on a cubic curve. -/
@[to_additive /-- A map `f` from an additive group to an additive monoid with `f 0 = 0` that sends
triples with sum `0` to triples with sum `0` is a homomorphism. Useful when a map is naturally
defined via a symmetric ternary relation, like collinearity on a cubic curve. -/]
def MonoidHom.ofMapMulMulEqOne {f : G → H} (hf₁ : f 1 = 1)
    (hf : ∀ a b c, a * b * c = 1 → f a * f b * f c = 1) :
    G →* H where
  toFun := f
  map_one' := hf₁
  map_mul' x y := by
    have h := hf (x * y)⁻¹ (x * y) 1 <| (mul_one _).trans (inv_mul_cancel _)
    rw [hf₁, mul_one] at h
    rw [← one_mul (f (x * y)), ← hf x y (x * y)⁻¹ (mul_inv_cancel _), mul_assoc _ (f _), h,
      mul_one]

/-- The homomorphism built by `MonoidHom.ofMapMulMulEqOne` has the original map as its
underlying function. -/
@[to_additive (attr := simp) /-- The homomorphism built by `AddMonoidHom.ofMapAddAddEqZero` has the
original map as its underlying function. -/]
lemma MonoidHom.coe_ofMapMulMulEqOne {f : G → H} (hf₁ : f 1 = 1)
    (hf : ∀ a b c, a * b * c = 1 → f a * f b * f c = 1) :
    ⇑(ofMapMulMulEqOne hf₁ hf) = f :=
  (rfl)

end
