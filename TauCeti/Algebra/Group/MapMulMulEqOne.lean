/-!
# Building a homomorphism from a ternary relation

Mathlib builds a `MonoidHom` out of a bare map from the two-variable identities
`f (x * y) = f x * f y` (`MonoidHom.mk'`) and `f (x * y⁻¹) = f x * (f y)⁻¹`
(`MonoidHom.ofMapMulInv`). Some maps are not naturally presented that way: they are defined by a
*symmetric ternary* condition, and what one can prove about them directly is that they send triples
with product `1` to triples with product `1`. The motivating example is the descent map on an
elliptic curve, whose defining property is that the classes of three collinear points multiply to
`1` — collinearity being symmetric in the three points, whereas the group law is not.

## Main results

* `MonoidHom.ofMapMulMulEqOne`: a map from a group to a monoid with `f 1 = 1` that sends triples
  with product `1` to triples with product `1` is a homomorphism, and
  `MonoidHom.coe_ofMapMulMulEqOne` says it is the original map. The additive versions are
  generated by `to_additive`.
* `TauCeti.map_mul_mul_eq_one_of_pairwise_ne`: on a commutative group with infinitely many
  squares, for a map compatible with `1` and with inversion, it suffices to check triples of
  pairwise distinct nonidentity elements. For a cubic curve these are the triples cut out by
  lines with three distinct abscissae. The proof moves an arbitrary pair into general position
  with an auxiliary element and cancels its image.

## Provenance

`MonoidHom.ofMapMulMulEqOne` is adapted, with the author's proof, from Michael Stoll's
`EllipticCurves` project (`github.com/MichaelStollBayreuth/EllipticCurves`, Apache-2.0, pinned by
`TauCetiRoadmap/EllipticCurves/README.md` at `66889eada51a`), `EllipticCurves/Mathlib/Basic.lean`.
-/

public section

variable {G H : Type*} [Group G] [Monoid H]

/-- A map `f` from a group to a monoid with `f 1 = 1` that sends triples with product `1` to
triples with product `1` is a homomorphism. Useful when a map is naturally defined via a symmetric
ternary relation, like collinearity on a cubic curve. -/
@[to_additive /-- A map `f` from an additive group to an additive monoid with `f 0 = 0` that sends
triples with sum `0` to triples with sum `0` is a homomorphism. Useful when a map is naturally
defined via a symmetric ternary relation, like collinearity on a cubic curve. -/]
def MonoidHom.ofMapMulMulEqOne {f : G → H} (hf₁ : f 1 = 1)
    (hf : ∀ a b c, a * b * c = 1 → f a * f b * f c = 1) :
    G →* H where
  toFun := f
  map_one' := hf₁
  map_mul' x y := by
    have h := hf (x * y)⁻¹ (x * y) 1 <| (mul_one _).trans (inv_mul_cancel _)
    rw [hf₁, mul_one] at h
    rw [← one_mul (f (x * y)), ← hf x y (x * y)⁻¹ (mul_inv_cancel _), mul_assoc _ (f _), h,
      mul_one]

/-- The homomorphism built by `MonoidHom.ofMapMulMulEqOne` has the original map as its
underlying function. -/
@[to_additive (attr := simp) /-- The homomorphism built by `AddMonoidHom.ofMapAddAddEqZero` has the
original map as its underlying function. -/]
lemma MonoidHom.coe_ofMapMulMulEqOne {f : G → H} (hf₁ : f 1 = 1)
    (hf : ∀ a b c, a * b * c = 1 → f a * f b * f c = 1) :
    ⇑(ofMapMulMulEqOne hf₁ hf) = f :=
  (rfl)

namespace TauCeti

variable {G H : Type*} [CommGroup G] [Group H]

/-- **Triples in general position suffice.** Let `f` be a map from a commutative group with
infinitely many squares to a group, with `f 1 = 1` and `f x⁻¹ = (f x)⁻¹`. If `f` sends every
triple of pairwise distinct nonidentity elements with product `1` to a triple with product `1`,
then it does so for every triple with product `1`; so `MonoidHom.ofMapMulMulEqOne` makes it a
homomorphism.

On a cubic curve, the three points cut out by a line with three distinct abscissae add to zero.
This lemma removes the distinctness: the tangent and inflection cases follow from the chord case.
The compatibility with inversion cannot be dropped: a map sending `1` to `1` and every other
element to a fixed `t ≠ 1` with `t ^ 3 = 1` satisfies the other hypotheses. -/
@[to_additive /-- **Triples in general position suffice.** Let `f` be a map from an additive
commutative group in which infinitely many elements are doubles to an additive group, with
`f 0 = 0` and `f (-x) = -f x`. If `f` sends every triple of pairwise distinct nonzero elements
with sum `0` to a triple with sum `0`, then it does so for every triple with sum `0`; so
`AddMonoidHom.ofMapAddAddEqZero` makes it a homomorphism. -/]
theorem map_mul_mul_eq_one_of_pairwise_ne {f : G → H}
    (hsq : (Set.range fun g : G ↦ g ^ 2).Infinite) (hf₁ : f 1 = 1)
    (hf_inv : ∀ a, f a⁻¹ = (f a)⁻¹)
    (hf : ∀ a b c, a ≠ 1 → b ≠ 1 → c ≠ 1 → a ≠ b → a ≠ c → b ≠ c → a * b * c = 1 →
      f a * f b * f c = 1)
    {a b c : G} (habc : a * b * c = 1) : f a * f b * f c = 1 := by
  classical
  have key (d w : G) (h : w ≠ d⁻¹) : d * w ≠ 1 := fun e ↦ h (eq_inv_of_mul_eq_one_right e)
  -- The two-variable form, for `x`, `y` and `(x y)⁻¹` pairwise distinct and nonidentity.
  have hmul (x y : G) (hx : x ≠ 1) (hy : y ≠ 1) (hxy : x * y ≠ 1) (hne : x ≠ y)
      (h₁ : x ^ 2 * y ≠ 1) (h₂ : x * y ^ 2 ≠ 1) : f (x * y) = f x * f y := by
    have h := hf x y (x * y)⁻¹ hx hy (inv_ne_one.mpr hxy) hne
      (fun e ↦ h₁ (by rw [sq, mul_assoc, ← eq_inv_iff_mul_eq_one.mp e]))
      (fun e ↦ h₂ (by rw [sq, ← mul_assoc, mul_comm x y, mul_assoc, ← eq_inv_iff_mul_eq_one.mp e]))
      (mul_inv_cancel _)
    rw [hf_inv] at h
    exact (mul_inv_eq_one.mp h).symm
  -- An auxiliary `z` puts all three pairs below in general position; cancel its image.
  have hmul' (x y : G) : f (x * y) = f x * f y := by
    by_cases hx : x = 1
    · simp [hx, hf₁]
    by_cases hy : y = 1
    · simp [hy, hf₁]
    by_cases hxy : x * y = 1
    · rw [eq_inv_of_mul_eq_one_right hxy, mul_inv_cancel, hf₁, hf_inv, mul_inv_cancel]
    let P : Finset G := {1, y⁻¹, y, (y ^ 2)⁻¹, (x * y)⁻¹, y⁻¹ * x, (x ^ 2 * y)⁻¹, x * y,
      ((x * y) ^ 2)⁻¹}
    let Q : Finset G := {y⁻¹, (x * y ^ 2)⁻¹, (x * y)⁻¹}
    obtain ⟨-, ⟨z, rfl⟩, hw⟩ := hsq.exists_notMem_finset (Q ∪ P.image (· ^ 2))
    have hzP : z ∉ P := fun h ↦ hw (Finset.mem_union_right _ (Finset.mem_image_of_mem _ h))
    have hzQ : z ^ 2 ∉ Q := fun h ↦ hw (Finset.mem_union_left _ h)
    simp only [P, Q, Finset.mem_insert, Finset.mem_singleton, not_or] at hzP hzQ
    obtain ⟨hz₁, hz₂, hz₃, hz₄, hz₅, hz₆, hz₇, hz₈, hz₉⟩ := hzP
    obtain ⟨hw₁, hw₂, hw₃⟩ := hzQ
    have hyz : y * z ≠ 1 := key _ _ hz₂
    have hxyz : x * y * z ≠ 1 := key _ _ hz₅
    have e₁ := hmul y z hy hz₁ hyz (Ne.symm hz₃) (key _ _ hz₄) (key _ _ hw₁)
    have e₂ := hmul x (y * z) hx hyz (by rwa [← mul_assoc])
      (fun e ↦ hz₆ (eq_inv_mul_iff_mul_eq.mpr e.symm))
      (by rw [← mul_assoc]; exact key _ _ hz₇)
      (by rw [mul_pow, ← mul_assoc]; exact key _ _ hw₂)
    have e₃ := hmul (x * y) z hxy hz₁ hxyz (Ne.symm hz₈) (key _ _ hz₉) (key _ _ hw₃)
    refine mul_right_cancel (b := f z) ?_
    rw [← e₃, mul_assoc x, e₂, e₁, mul_assoc]
  rw [← hmul', ← hmul', habc, hf₁]

end TauCeti

end
