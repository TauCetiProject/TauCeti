module

public import Mathlib.Algebra.Order.BigOperators.Group.Finset
public import Mathlib.Algebra.Group.Action.Pointwise.Finset
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Data.Finset.SymmDiff

/-!
# Symmetric differences of translates of finite sets

An element `g` acting injectively on a type `X` (for example, any element of a group acting on
`X`) moves a finite set `F ⊆ X` to a translate `g • F` of the same size, so `g • F` has as many
points outside `F` as `F` has outside `g • F`. Hence the symmetric difference `g • F ∆ F` has
twice as many points as `g • F \ F`. Følner-type arguments use this to pass between symmetric
differences and one-sided differences.

For a monoid acting left-cancellatively on `X`, the size `|gF △ F|` of the translation boundary
of `F` satisfies a triangle bound in `g`. For a group action it is also unchanged when `g` is
replaced by `g⁻¹`. Consequently the boundary
for an element of the subgroup generated by a set `S` is bounded, uniformly in `F`, by a multiple
of the sum of the boundaries for finitely many elements of `S`. This lets Følner conditions be
tested on generators only.

## Main results

* `Finset.card_smul_finset_symmDiff`: `|gF △ F| = 2 |gF \ F|` for a finite set `F`.
* `Finset.card_smul_finset_symmDiff_image`: an injective map intertwining `g` preserves `|gF △ F|`.
* `Finset.filter_smul_finset_symmDiff_eq` and `Finset.card_smul_finset_symmDiff_eq_sum_image`:
  fiberwise decomposition of `(g • F) ∆ F` and its cardinality along a map invariant under `g`.
* `Finset.card_mul_smul_finset_symmDiff_le`: `|(gh)F △ F| ≤ |gF △ F| + |hF △ F|`.
* `Finset.card_inv_smul_finset_symmDiff`: `|g⁻¹F △ F| = |gF △ F|`.
* `Finset.exists_card_smul_finset_symmDiff_le_mul_sum`: for `g` in the subgroup generated by `S`,
  there are a finite `T ⊆ S` and `n : ℕ` with `|gF △ F| ≤ n · ∑_{t ∈ T} |tF △ F|` for every
  finite `F`.
-/

public section

open scoped Pointwise symmDiff

namespace Finset

section SMul

/-- An injective map intertwining the action of `g` preserves the cardinality of the translation
boundary `|(g • F) ∆ F|`. -/
@[to_additive /-- An injective map intertwining the additive action of `g` preserves the cardinality
of the translation boundary `|(g +ᵥ F) ∆ F|`. -/]
theorem card_smul_finset_symmDiff_image {G X Y : Type*} [SMul G X] [SMul G Y] [DecidableEq X]
    [DecidableEq Y] {f : X → Y} {g : G} (hf : Function.Injective f)
    (hsmul : ∀ x, f (g • x) = g • f x) (F : Finset X) :
    #((g • F.image f) ∆ (F.image f)) = #((g • F) ∆ F) := by
  rw [← image_smul, ← image_smul, ← image_comm hsmul, ← image_symmDiff _ _ hf,
    card_image_of_injective _ hf]

/-- Filtering `(g • F) ∆ F` along a fiber of a map `π` invariant under `g` yields the translation
boundary of the fiber `F.filter (π · = o)`. -/
@[to_additive /-- Filtering `(g +ᵥ F) ∆ F` along a fiber of a map `π` invariant under `g` yields the
translation boundary of the fiber `F.filter (π · = o)`. -/]
theorem filter_smul_finset_symmDiff_eq {G X Q : Type*} [SMul G X] [DecidableEq X] [DecidableEq Q]
    {π : X → Q} {g : G} (hπ : ∀ x, π (g • x) = π x) (F : Finset X) (o : Q) :
    ((g • F) ∆ F).filter (π · = o) = (g • F.filter (π · = o)) ∆ (F.filter (π · = o)) := by
  ext z
  simp only [mem_filter, mem_symmDiff, mem_smul_finset]
  constructor
  · rintro ⟨h1 | h1, hzo⟩
    · rcases h1.1 with ⟨w, hw, rfl⟩
      exact Or.inl ⟨⟨w, ⟨hw, (hπ w).symm.trans hzo⟩, rfl⟩, fun hw' ↦ h1.2 hw'.1⟩
    · refine Or.inr ⟨⟨h1.1, hzo⟩, ?_⟩
      rintro ⟨w, ⟨hw, _⟩, rfl⟩
      exact h1.2 ⟨w, hw, rfl⟩
  · rintro (h1 | h1)
    · rcases h1.1 with ⟨w, ⟨hw, hwo⟩, rfl⟩
      have hgw : π (g • w) = o := (hπ w).trans hwo
      exact ⟨Or.inl ⟨⟨w, hw, rfl⟩, fun hw' ↦ h1.2 ⟨hw', hgw⟩⟩, hgw⟩
    · refine ⟨Or.inr ⟨h1.1.1, ?_⟩, h1.1.2⟩
      rintro ⟨w, hw, rfl⟩
      exact h1.2 ⟨w, ⟨hw, (hπ w).symm.trans h1.1.2⟩, rfl⟩

/-- Along any map `π : X → Q` invariant under `g`, the cardinality of `(g • F) ∆ F` decomposes as
the sum over `o ∈ F.image π` of the fiber boundaries `#((g • F_o) ∆ F_o)`. -/
@[to_additive /-- Along any map `π : X → Q` invariant under `g`, the cardinality of `(g +ᵥ F) ∆ F`
decomposes as the sum over `o ∈ F.image π` of the fiber boundaries `#((g +ᵥ F_o) ∆ F_o)`. -/]
theorem card_smul_finset_symmDiff_eq_sum_image {G X Q : Type*} [SMul G X] [DecidableEq X]
    [DecidableEq Q] {π : X → Q} {g : G} (hπ : ∀ x, π (g • x) = π x) (F : Finset X) :
    #((g • F) ∆ F) = ∑ o ∈ F.image π, #((g • F.filter (π · = o)) ∆ (F.filter (π · = o))) := by
  have hmaps : ∀ z ∈ (g • F) ∆ F, π z ∈ F.image π := by
    intro z hz
    rcases mem_symmDiff.mp hz with ⟨hz, _⟩ | ⟨hz, _⟩
    · rcases mem_smul_finset.mp hz with ⟨w, hw, rfl⟩
      rw [hπ]
      exact mem_image_of_mem π hw
    · exact mem_image_of_mem π hz
  rw [card_eq_sum_card_fiberwise hmaps]
  exact sum_congr rfl fun o _ ↦ congrArg card (filter_smul_finset_symmDiff_eq hπ F o)

end SMul

section LeftCancel

variable {G X : Type*} [SMul G X] [IsLeftCancelSMul G X] [DecidableEq X]

/-- A translate `g • F` of a finite set has as many points outside `F` as `F` has outside `g • F`,
so its symmetric difference with `F` has twice as many points as `g • F \ F`. -/
theorem card_smul_finset_symmDiff (g : G) (F : Finset X) : #((g • F) ∆ F) = 2 * #(g • F \ F) := by
  rw [symmDiff_def, card_union_of_disjoint disjoint_sdiff_sdiff,
    ← card_sdiff_comm (card_smul_finset g F), Nat.two_mul]

end LeftCancel

section Monoid

variable {G X : Type*} [Monoid G] [MulAction G X] [IsLeftCancelSMul G X] [DecidableEq X]

/-- **Triangle bound** for translation boundaries: the boundary of a finite set under a product
`g * h` has at most as many points as the boundaries under `g` and `h` together. -/
@[to_additive /-- **Triangle bound** for translation boundaries: the boundary of a finite set
under a sum `g + h` has at most as many points as the boundaries under `g` and `h` together. -/]
theorem card_mul_smul_finset_symmDiff_le (g h : G) (F : Finset X) :
    #(((g * h) • F) ∆ F) ≤ #((g • F) ∆ F) + #((h • F) ∆ F) := by
  calc #(((g * h) • F) ∆ F)
      ≤ #(((g * h) • F) ∆ (g • F)) + #((g • F) ∆ F) :=
        (card_le_card (symmDiff_triangle _ (g • F) _)).trans (card_union_le _ _)
    _ = #((h • F) ∆ F) + #((g • F) ∆ F) := by
        rw [mul_smul, ← smul_finset_symmDiff, card_smul_finset]
    _ = #((g • F) ∆ F) + #((h • F) ∆ F) := add_comm _ _

end Monoid

section Group

variable {G X : Type*} [Group G] [MulAction G X] [DecidableEq X]

/-- The boundary of a finite set under `g⁻¹` has as many points as its boundary under `g`. -/
@[to_additive (attr := simp) /-- The boundary of a finite set under `-g` has as many points as its
boundary under `g`. -/]
theorem card_inv_smul_finset_symmDiff (g : G) (F : Finset X) :
    #((g⁻¹ • F) ∆ F) = #((g • F) ∆ F) := by
  rw [← card_smul_finset g ((g⁻¹ • F) ∆ F), smul_finset_symmDiff, smul_inv_smul, symmDiff_comm]

/-- The boundary of a finite set under an element `g` of the subgroup generated by `S` is
controlled by finitely many elements of `S`: there are a finite `T ⊆ S` and `n : ℕ` such that
`|gF △ F| ≤ n · ∑_{t ∈ T} |tF △ F|` for every finite set `F`. -/
@[to_additive /-- The boundary of a finite set under an element `g` of the additive subgroup
generated by `S` is controlled by finitely many elements of `S`: there are a finite `T ⊆ S` and
`n : ℕ` such that `|(g +ᵥ F) △ F| ≤ n · ∑_{t ∈ T} |(t +ᵥ F) △ F|` for every finite set `F`. -/]
theorem exists_card_smul_finset_symmDiff_le_mul_sum {S : Set G} {g : G}
    (hg : g ∈ Subgroup.closure S) :
    ∃ T : Finset G, (T : Set G) ⊆ S ∧ ∃ n : ℕ, ∀ F : Finset X,
      #((g • F) ∆ F) ≤ n * ∑ t ∈ T, #((t • F) ∆ F) := by
  classical
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact ⟨{x}, by simpa using hx, 1, fun F => by simp⟩
  | one => exact ⟨∅, by simp, 0, fun F => by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨T₁, hT₁, n₁, h₁⟩ := hx
    obtain ⟨T₂, hT₂, n₂, h₂⟩ := hy
    refine ⟨T₁ ∪ T₂, by simpa using And.intro hT₁ hT₂, n₁ + n₂, fun F => ?_⟩
    calc #(((x * y) • F) ∆ F) ≤ #((x • F) ∆ F) + #((y • F) ∆ F) :=
          card_mul_smul_finset_symmDiff_le x y F
      _ ≤ n₁ * ∑ t ∈ T₁, #((t • F) ∆ F) + n₂ * ∑ t ∈ T₂, #((t • F) ∆ F) :=
          Nat.add_le_add (h₁ F) (h₂ F)
      _ ≤ (n₁ + n₂) * ∑ t ∈ T₁ ∪ T₂, #((t • F) ∆ F) := by
          rw [Nat.add_mul]
          exact Nat.add_le_add (Nat.mul_le_mul_left _ (sum_le_sum_of_subset subset_union_left))
            (Nat.mul_le_mul_left _ (sum_le_sum_of_subset subset_union_right))
  | inv x _ hx =>
    obtain ⟨T, hT, n, h⟩ := hx
    exact ⟨T, hT, n, fun F => (card_inv_smul_finset_symmDiff x F).trans_le (h F)⟩

end Group

end Finset
