module

public import Mathlib.Algebra.Order.BigOperators.Group.Finset
public import Mathlib.Algebra.Group.Action.Pointwise.Finset
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Data.Finset.SymmDiff

/-!
# Symmetric differences of translates of finite sets

An element `g` acting injectively on a type `X` (for example, any element of a group acting on
`X`) moves a finite set `F ⊆ X` to a translate `g • F` of the same size, so `g • F` has as many
points outside `F` as `F` has outside `g • F`. Hence the symmetric difference `g • F ∆ F` has
twice as many points as `g • F \ F`. Følner-type arguments use this to pass between symmetric
differences and one-sided differences.

For a group acting on `X` and a fixed finite set `F`, the size `d g = |gF △ F|` of the boundary
moved by `g` is symmetric, `d g⁻¹ = d g`, and subadditive, `d (g * h) ≤ d g + d h`. So the
boundary moved by any element of the subgroup generated by a set `S` is bounded, uniformly in `F`,
by a multiple of the boundaries moved by finitely many elements of `S`. Følner conditions therefore
only need to be tested on a generating set.

## Main results

* `Finset.card_smul_finset_symmDiff`: `|gF △ F| = 2 |gF \ F|` for a finite set `F`.
* `Finset.card_inv_smul_finset_symmDiff`: `|g⁻¹F △ F| = |gF △ F|`.
* `Finset.card_mul_smul_finset_symmDiff_le`: the triangle bound
  `|(gh)F △ F| ≤ |gF △ F| + |hF △ F|`.
* `Finset.exists_card_smul_finset_symmDiff_le_sum_of_mem_closure`: for `g` in the subgroup
  generated by `S`, `|gF △ F| ≤ n ∑_{s ∈ T} |sF △ F|` for all finite `F`, with `T ⊆ S` finite and
  `n` independent of `F`.
-/

public section

open scoped Pointwise symmDiff

namespace Finset

section LeftCancel

variable {G X : Type*} [SMul G X] [IsLeftCancelSMul G X] [DecidableEq X]

/-- A translate `g • F` of a finite set has as many points outside `F` as `F` has outside `g • F`,
so its symmetric difference with `F` has twice as many points as `g • F \ F`. -/
theorem card_smul_finset_symmDiff (g : G) (F : Finset X) : #((g • F) ∆ F) = 2 * #(g • F \ F) := by
  rw [symmDiff_def, card_union_of_disjoint disjoint_sdiff_sdiff,
    ← card_sdiff_comm (card_smul_finset g F), Nat.two_mul]

end LeftCancel

section Group

variable {G X : Type*} [Group G] [MulAction G X] [DecidableEq X]

/-- Translating by `g⁻¹` instead of `g` does not change the size of the symmetric difference of a
translate of a finite set with the set itself. -/
theorem card_inv_smul_finset_symmDiff (g : G) (F : Finset X) :
    #((g⁻¹ • F) ∆ F) = #((g • F) ∆ F) := by
  rw [← card_smul_finset g, smul_finset_symmDiff, smul_inv_smul, symmDiff_comm]

/-- **Triangle bound for translation boundaries.** The symmetric difference of a finite set with
its translate by a product is at most the sum of those for the two factors. -/
theorem card_mul_smul_finset_symmDiff_le (g h : G) (F : Finset X) :
    #(((g * h) • F) ∆ F) ≤ #((g • F) ∆ F) + #((h • F) ∆ F) := by
  -- Pass through `g • F`; the first leg is the translate by `g` of `h • F ∆ F`.
  calc #(((g * h) • F) ∆ F) ≤ #(((g * h) • F) ∆ (g • F) ∪ (g • F) ∆ F) :=
        card_le_card (symmDiff_triangle _ _ _)
    _ ≤ #(((g * h) • F) ∆ (g • F)) + #((g • F) ∆ F) := card_union_le _ _
    _ = #((g • F) ∆ F) + #((h • F) ∆ F) := by
      rw [mul_smul, ← smul_finset_symmDiff, card_smul_finset, add_comm]

/-- An element of the subgroup generated by `S` moves every finite set by at most a fixed multiple
of the total boundary moved by finitely many elements of `S`. The finite set `T ⊆ S` and the
multiplier `n` depend only on `g`, not on the finite set `F`. -/
theorem exists_card_smul_finset_symmDiff_le_sum_of_mem_closure {S : Set G} {g : G}
    (hg : g ∈ Subgroup.closure S) :
    ∃ T : Finset G, (T : Set G) ⊆ S ∧ ∃ n : ℕ, ∀ F : Finset X,
      #((g • F) ∆ F) ≤ n * ∑ s ∈ T, #((s • F) ∆ F) := by
  classical
  induction hg using Subgroup.closure_induction with
  | mem s hs => exact ⟨{s}, by simpa using hs, 1, fun F => by simp⟩
  | one => exact ⟨∅, by simp, 0, fun F => by simp⟩
  | mul g h _ _ ihg ihh =>
    obtain ⟨T₁, hT₁, n₁, h₁⟩ := ihg
    obtain ⟨T₂, hT₂, n₂, h₂⟩ := ihh
    refine ⟨T₁ ∪ T₂, by simpa using And.intro hT₁ hT₂, n₁ + n₂, fun F => ?_⟩
    calc #(((g * h) • F) ∆ F) ≤ #((g • F) ∆ F) + #((h • F) ∆ F) :=
          card_mul_smul_finset_symmDiff_le g h F
      _ ≤ n₁ * ∑ s ∈ T₁, #((s • F) ∆ F) + n₂ * ∑ s ∈ T₂, #((s • F) ∆ F) :=
          Nat.add_le_add (h₁ F) (h₂ F)
      _ ≤ (n₁ + n₂) * ∑ s ∈ T₁ ∪ T₂, #((s • F) ∆ F) := by
        rw [Nat.add_mul]
        exact Nat.add_le_add (Nat.mul_le_mul_left _ (sum_le_sum_of_subset subset_union_left))
          (Nat.mul_le_mul_left _ (sum_le_sum_of_subset subset_union_right))
  | inv g _ ih =>
    obtain ⟨T, hT, n, h⟩ := ih
    exact ⟨T, hT, n, fun F => (card_inv_smul_finset_symmDiff g F).trans_le (h F)⟩

end Group

end Finset
