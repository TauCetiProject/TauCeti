module

public import Mathlib.Algebra.Group.Action.Pointwise.Finset
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Algebra.Order.BigOperators.Group.Finset
public import Mathlib.Data.Finset.SymmDiff

/-!
# Symmetric differences of translates of finite sets

An element `g` acting injectively on a type `X` (for example, any element of a group acting on
`X`) moves a finite set `F ⊆ X` to a translate `g • F` of the same size, so `g • F` has as many
points outside `F` as `F` has outside `g • F`. Hence the symmetric difference `g • F ∆ F` has
twice as many points as `g • F \ F`. Følner-type arguments use this to pass between symmetric
differences and one-sided differences.

The displacement `g ↦ |gF △ F|` of a fixed finite set is subadditive, `|(gh)F △ F| ≤
|gF △ F| + |hF △ F|`, and invariant under inversion in a group. Consequently every element `g` of
the subgroup generated by a finite set `S` displaces finite sets by at most a fixed multiple of the
total displacement of the elements of `S`. This reduces Følner-type estimates for the elements of a
finitely generated group to estimates for its generators.

## Main results

* `Finset.card_smul_finset_symmDiff`: `|gF △ F| = 2 |gF \ F|` for a finite set `F`.
* `Finset.card_mul_smul_finset_symmDiff_le`: the triangle bound
  `|(gh)F △ F| ≤ |gF △ F| + |hF △ F|`.
* `Finset.card_inv_smul_finset_symmDiff`: `|g⁻¹F △ F| = |gF △ F|`.
* `Finset.exists_card_smul_symmDiff_le_mul_sum_of_mem_closure`: for `g` in the subgroup generated by
  a finite set `S`, there is `n` with `|gF △ F| ≤ n · ∑_{s ∈ S} |sF △ F|` for every finite `F`.
-/

public section

open scoped Pointwise symmDiff

namespace Finset

section IsLeftCancelSMul

variable {G X : Type*} [SMul G X] [IsLeftCancelSMul G X] [DecidableEq X]

/-- A translate `g • F` of a finite set has as many points outside `F` as `F` has outside `g • F`,
so its symmetric difference with `F` has twice as many points as `g • F \ F`. -/
@[to_additive /-- A translate `g +ᵥ F` of a finite set has as many points outside `F` as `F` has
outside `g +ᵥ F`, so its symmetric difference with `F` has twice as many points as
`g +ᵥ F \ F`. -/]
theorem card_smul_finset_symmDiff (g : G) (F : Finset X) : #((g • F) ∆ F) = 2 * #(g • F \ F) := by
  rw [symmDiff_def, card_union_of_disjoint disjoint_sdiff_sdiff,
    ← card_sdiff_comm (card_smul_finset g F), Nat.two_mul]

end IsLeftCancelSMul

/-- The triangle bound for the displacement of a finite set: `(g * h) • F` differs from `F` by at
most the points by which `g • F` and `h • F` differ from `F`. -/
@[to_additive /-- The triangle bound for the displacement of a finite set: `(g + h) +ᵥ F` differs
from `F` by at most the points by which `g +ᵥ F` and `h +ᵥ F` differ from `F`. -/]
theorem card_mul_smul_finset_symmDiff_le {M X : Type*} [Monoid M] [MulAction M X]
    [IsLeftCancelSMul M X] [DecidableEq X] (g h : M) (F : Finset X) :
    #(((g * h) • F) ∆ F) ≤ #((g • F) ∆ F) + #((h • F) ∆ F) := by
  -- Compare `g • (h • F)` with `F` through `g • F`; translating by `g` preserves cardinalities.
  calc #(((g * h) • F) ∆ F) ≤ #((g • h • F) ∆ (g • F) ∪ (g • F) ∆ F) := by
        rw [mul_smul]
        exact card_le_card (symmDiff_triangle _ _ _)
    _ ≤ #((g • h • F) ∆ (g • F)) + #((g • F) ∆ F) := card_union_le _ _
    _ = #((g • F) ∆ F) + #((h • F) ∆ F) := by
        rw [← smul_finset_symmDiff, card_smul_finset, add_comm]

/-- A finite set is displaced by `g⁻¹` exactly as much as by `g`. -/
@[to_additive (attr := simp) /-- A finite set is displaced by `-g` exactly as much as by `g`. -/]
theorem card_inv_smul_finset_symmDiff {G X : Type*} [Group G] [MulAction G X] [DecidableEq X]
    (g : G) (F : Finset X) : #((g⁻¹ • F) ∆ F) = #((g • F) ∆ F) := by
  rw [← card_smul_finset g ((g⁻¹ • F) ∆ F), smul_finset_symmDiff, smul_inv_smul, symmDiff_comm]

/-- An element `g` of the subgroup generated by a finite set `S` displaces finite sets by at most a
fixed multiple of the total displacement of the elements of `S`: there is `n` with
`|gF △ F| ≤ n · ∑_{s ∈ S} |sF △ F|` for every finite `F`. -/
@[to_additive /-- An element `g` of the additive subgroup generated by a finite set `S` displaces
finite sets by at most a fixed multiple of the total displacement of the elements of `S`: there is
`n` with `|(g +ᵥ F) △ F| ≤ n · ∑_{s ∈ S} |(s +ᵥ F) △ F|` for every finite `F`. -/]
theorem exists_card_smul_symmDiff_le_mul_sum_of_mem_closure {G X : Type*} [Group G]
    [MulAction G X] [DecidableEq X] {S : Finset G} {g : G}
    (hg : g ∈ Subgroup.closure (S : Set G)) :
    ∃ n : ℕ, ∀ F : Finset X, #((g • F) ∆ F) ≤ n * ∑ s ∈ S, #((s • F) ∆ F) := by
  induction hg using Subgroup.closure_induction with
  | mem s hs => exact ⟨1, fun F => by
      simpa using single_le_sum (f := fun s => #((s • F) ∆ F)) (fun _ _ => Nat.zero_le _) hs⟩
  | one => exact ⟨0, fun F => by simp⟩
  | mul a b _ _ ha hb =>
    obtain ⟨m, hm⟩ := ha
    obtain ⟨n, hn⟩ := hb
    exact ⟨m + n, fun F => (card_mul_smul_finset_symmDiff_le a b F).trans <| by
      rw [Nat.add_mul]
      exact add_le_add (hm F) (hn F)⟩
  | inv a _ ha =>
    obtain ⟨n, hn⟩ := ha
    exact ⟨n, fun F => (card_inv_smul_finset_symmDiff a F).trans_le (hn F)⟩

end Finset
