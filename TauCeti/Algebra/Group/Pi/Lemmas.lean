module

public import Mathlib.Algebra.Group.Pi.Lemmas
public import Mathlib.Algebra.Group.Submonoid.Operations
public import TauCeti.Logic.Function.Extend

/-!
# Post-composition with a monoid homomorphism, one-point families and restriction

`MonoidHom.compLeft f I` applies `f : α →* β` coordinatewise to a family `I → α`. It sends the
one-point family `Pi.mulSingle i a` to the one-point family `Pi.mulSingle i (f a)`, since `f` sends
`1` to `1`; more generally, `f ∘ Pi.mulSingle i a = Pi.mulSingle i (f a)` holds for any
`1`-preserving map `f` (`TauCeti.map_comp_mulSingle`, `TauCeti.map_comp_single`).

Restriction `g ↦ fun i ↦ g (f i)` of a product of monoids along an injective map `f`, the monoid
homomorphism `MonoidHom.pi fun i ↦ Pi.evalMonoidHom G (f i)`, is surjective: extend by `1` off the
range of `f`. Moreover, a one-point family `Pi.mulSingle c x` lies in the submonoid generated by
coordinatewise images `⋃ d, Pi.mulSingle d '' s d` if and only if `x` lies in the submonoid
generated by `s c` (`Submonoid.mulSingle_mem_closure_iUnion_mulSingle`,
`AddSubmonoid.single_mem_closure_iUnion_single`).

## Main results

* `TauCeti.map_comp_mulSingle`, `TauCeti.map_comp_single`: composing a `1`- or `0`-preserving map
  with a one-point family gives the mapped one-point family.
* `MonoidHom.compLeft_mulSingle`, `AddMonoidHom.compLeft_single`: post-composition maps
  one-point families to one-point families.
* `MonoidHom.pi_evalMonoidHom_surjective_of_injective`,
  `AddMonoidHom.pi_evalAddMonoidHom_surjective_of_injective`: restriction of a product of monoids
  along an injective map is surjective.
* `Submonoid.mulSingle_mem_closure_iUnion_mulSingle`,
  `AddSubmonoid.single_mem_closure_iUnion_single`: membership of a one-point family in the
  submonoid generated by coordinatewise images reduces to its coordinate.
* `Function.extend_const_eq_mulSingle`, `Function.extend_const_eq_single`: extending a constant
  family from a unique index type yields `Pi.mulSingle` / `Pi.single`.
-/

public section

namespace TauCeti

/-- A map preserving `1` applied coordinatewise to `Pi.mulSingle i a` gives
`Pi.mulSingle i (f a)`. -/
@[to_additive (attr := simp) /-- A map preserving `0` applied coordinatewise to `Pi.single i a`
gives `Pi.single i (f a)`. -/]
theorem map_comp_mulSingle {F α β I : Type*} [One α] [One β] [DecidableEq I] [FunLike F α β]
    [OneHomClass F α β] (f : F) (i : I) (a : α) :
    f ∘ Pi.mulSingle i a = Pi.mulSingle i (f a) :=
  (Pi.mulSingle_op (fun _ ↦ f) (fun _ ↦ map_one f) i a).symm

end TauCeti

namespace MonoidHom

variable {α β I : Type*} [MulOneClass α] [MulOneClass β] [DecidableEq I]

/-- Post-composition with `f` sends the one-point family `Pi.mulSingle i a` to
`Pi.mulSingle i (f a)`. -/
@[to_additive (attr := simp) /-- Post-composition with `f` sends the one-point family
`Pi.single i a` to `Pi.single i (f a)`. -/]
theorem compLeft_mulSingle (f : α →* β) (i : I) (a : α) :
    f.compLeft I (Pi.mulSingle i a) = Pi.mulSingle i (f a) :=
  TauCeti.map_comp_mulSingle f i a

/-- Restriction `g ↦ fun i ↦ g (f i)` of a product of monoids along an injective map `f` is
surjective: extend by `1` off the range of `f`. -/
@[to_additive /-- Restriction `g ↦ fun i ↦ g (f i)` of a product of additive monoids along an
injective map `f` is surjective: extend by `0` off the range of `f`. -/]
theorem pi_evalMonoidHom_surjective_of_injective {σ τ : Type*} {G : τ → Type*}
    [∀ j, MulOneClass (G j)] {f : σ → τ} (hf : Function.Injective f) :
    Function.Surjective (MonoidHom.pi fun i ↦ Pi.evalMonoidHom G (f i)) :=
  hf.surjective_pi_comp_right 1

end MonoidHom

namespace Submonoid

/-- A one-point family `Pi.mulSingle c x` lies in the submonoid generated by the coordinatewise
images of sets `s d` if and only if `x` lies in the submonoid generated by `s c`. -/
@[to_additive (attr := simp) /-- A one-point family `Pi.single c x` lies in the additive submonoid
generated by the coordinatewise images of sets `s d` if and only if `x` lies in the additive
submonoid generated by `s c`. -/]
theorem mulSingle_mem_closure_iUnion_mulSingle {κ : Type*} [DecidableEq κ] {M : κ → Type*}
    [∀ d, MulOneClass (M d)] {s : ∀ d, Set (M d)} {c : κ} {x : M c} :
    Pi.mulSingle c x ∈ closure (⋃ d, Pi.mulSingle d '' s d) ↔ x ∈ closure (s c) := by
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · have hle : closure (⋃ d, Pi.mulSingle d '' s d) ≤ pi Set.univ fun d ↦ closure (s d) :=
      closure_le.mpr <| Set.iUnion_subset fun d _ ⟨y, hy, hy'⟩ ↦
        hy' ▸ (mulSingle_mem_pi d y).mpr fun _ ↦ subset_closure hy
    exact (mulSingle_mem_pi c x).mp (hle hx) (Set.mem_univ c)
  · have hle : (closure (s c)).map (MonoidHom.mulSingle M c) ≤
        closure (⋃ d, Pi.mulSingle d '' s d) := by
      rw [MonoidHom.map_mclosure]
      exact closure_mono (Set.subset_iUnion (fun d ↦ Pi.mulSingle d '' s d) c)
    exact hle (mem_map_of_mem (MonoidHom.mulSingle M c) hx)

end Submonoid

/-- Extending a constant family on a unique index type `κ` along `f : κ → ι` with fallback `1`
produces `Pi.mulSingle (f default) x`. -/
@[to_additive /-- Extending a constant family on a unique index type `κ` along `f : κ → ι` with
fallback `0` produces `Pi.single (f default) x`. -/]
theorem Function.extend_const_eq_mulSingle {κ ι α : Type*} [Unique κ] [DecidableEq ι]
    [One α] (f : κ → ι) (x : α) :
    Function.extend f (fun _ ↦ x) 1 = Pi.mulSingle (f default) x := by
  rw [← Subsingleton.pi_mulSingle_eq default x,
    (Function.injective_of_subsingleton f).extend_mulSingle]
