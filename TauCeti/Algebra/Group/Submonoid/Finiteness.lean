/-!
# Finiteness of preimages and saturations of additive submonoids

The preimage of a finitely generated additive submonoid under a homomorphism from a finitely
generated commutative monoid is finitely generated, provided the target is cancellative
(`AddSubmonoid.FG.comap`). This is the slack-variable form of Gordan's lemma.

Dually, if `T` is a finitely generated submonoid contained in the positive-power saturation of `S`,
finitely many elements of `T` already represent every element of `T` up to a factor in `S`
(`Submonoid.FG.exists_finset_subset_forall_exists_mul`). In a free `ℤ`-module of arbitrary rank,
the positive-multiple saturation of any finitely generated additive submonoid `S` is itself
finitely generated (`AddSubmonoid.FG.nsmulSaturation`), by bounding the coordinates of Euclidean
remainders in the fundamental parallelepiped of the generators; inside the group generated by `S`,
torsion-freeness of the ambient group suffices (`AddSubmonoid.FG.nsmulSaturation_inf_closure`).

## Main results

* `AddSubmonoid.FG.comap`: preimage of a finitely generated submonoid of a cancellative monoid
  under a map from a finitely generated monoid is finitely generated.
* `Submonoid.FG.exists_finset_subset_forall_exists_mul` and
  `AddSubmonoid.FG.exists_finset_subset_forall_exists_add`: finite set of remainders for `T ≤ sat S`
  when `T` is finitely generated.
* `AddSubmonoid.FG.nsmulSaturation`: the saturation of a finitely generated submonoid of a free
  `ℤ`-module is finitely generated.
* `AddSubmonoid.FG.nsmulSaturation_inf_closure`: in a torsion-free abelian group, the saturation of
  a finitely generated submonoid inside the subgroup it generates is finitely generated.

## References

* W. Bruns and J. Herzog, *Cohen–Macaulay Rings*, Proposition 6.1.2.
* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §1.2, Proposition 1.2.17, Gordan's lemma.
-/

public section

/-- The preimage of a finitely generated additive submonoid of a cancellative commutative monoid
under a homomorphism from a finitely generated commutative monoid is finitely generated. -/
theorem AddSubmonoid.FG.comap {M G : Type*} [AddCommMonoid M] [AddCommMonoid G]
    [IsCancelAdd G] [AddMonoid.FG M] {P : AddSubmonoid G} (hP : P.FG) (f : M →+ G) :
    (P.comap f).FG := by
  obtain ⟨n, q, hq⟩ := AddSubmonoid.fg_iff_exists_fin_addMonoidHom.mp
    (AddMonoid.FG.fg_top (M := M))
  obtain ⟨k, g, rfl⟩ := AddSubmonoid.fg_iff_exists_fin_addMonoidHom.mp hP
  -- Pair a parameter of `M` with a slack vector parametrizing `P`, and keep the pairs whose
  -- images under `f` and `g` agree.
  let π := q.comp (AddMonoidHom.fst _ (Fin k → ℕ))
  convert (AddSubmonoid.fg_eqLocusM (f.comp π) (g.comp (.snd ..))).map π
  ext x
  constructor
  · rintro ⟨b, hb⟩
    obtain ⟨a, rfl⟩ := AddMonoidHom.mrange_eq_top.mp hq x
    exact ⟨(a, b), hb.symm, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a.2, ha.symm⟩

/-- If `T` is a finitely generated submonoid contained in `S.powSaturation`, there is a finite
subset `F ⊆ T` such that every element of `T` factors as `z * y` with `z ∈ F` and `y ∈ S`. -/
@[to_additive /-- If `T` is a finitely generated additive submonoid contained in
`S.nsmulSaturation`, there is a finite subset `F ⊆ T` such that every element of `T` decomposes as
`z + y` with `z ∈ F` and `y ∈ S`. -/]
theorem Submonoid.FG.exists_finset_subset_forall_exists_mul {M : Type*} [CommMonoid M]
    {S T : Submonoid M} (hT : T.FG) (hTS : T ≤ S.powSaturation) :
    ∃ F : Finset M, (F : Set M) ⊆ T ∧ ∀ x ∈ T, ∃ z ∈ F, ∃ y ∈ S, x = z * y := by
  classical
  obtain ⟨s, rfl⟩ := Submonoid.isMulFG_iff.mp hT
  choose d hd_pos hd_mem using fun a : s ↦
    Submonoid.mem_powSaturation.mp (hTS (Submonoid.subset_closure a.2))
  have : ∀ a : s, NeZero (d a) := fun a ↦ ⟨(hd_pos a).ne'⟩
  let F : Finset M :=
    Finset.univ.image fun r : (∀ a : s, Fin (d a)) ↦ ∏ a : s, (a : M) ^ (r a : ℕ)
  refine ⟨F, ?_, fun x hx ↦ ?_⟩
  · intro _ h
    obtain ⟨r, -, rfl⟩ := Finset.mem_image.mp h
    exact Submonoid.prod_mem _ fun a _ ↦ pow_mem (Submonoid.subset_closure a.2) _
  · obtain ⟨c, -, rfl⟩ := Submonoid.mem_closure_finset.mp hx
    let r : ∀ a : s, Fin (d a) := fun a ↦ ⟨c a % d a, Nat.mod_lt _ (hd_pos a)⟩
    refine ⟨∏ a : s, (a : M) ^ (r a : ℕ), Finset.mem_image_of_mem _ (Finset.mem_univ r),
      ∏ a : s, ((a : M) ^ d a) ^ (c a / d a), S.prod_mem fun a _ ↦ pow_mem (hd_mem a) _, ?_⟩
    rw [← Finset.prod_attach, ← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun a _ ↦ ?_
    rw [← pow_mul, ← pow_add, add_comm, Nat.div_add_mod]

/-- **Gordan's lemma for saturation.** In a free `ℤ`-module `G` (of arbitrary rank), the
positive-multiple saturation of any finitely generated additive submonoid `S` is finitely
generated. -/
theorem AddSubmonoid.FG.nsmulSaturation {G : Type*} [AddCommGroup G] [Module.Free ℤ G]
    {S : AddSubmonoid G} (hS : S.FG) : S.nsmulSaturation.FG := by
  classical
  obtain ⟨s, hs⟩ := AddSubmonoid.isAddFG_iff.mp hS
  let b := Module.Free.chooseBasis ℤ G
  -- All generators of `S`, and hence all of `S.nsmulSaturation`, are supported on `I`.
  let I : Finset (Module.Free.ChooseBasisIndex ℤ G) := s.biUnion fun a ↦ (b.repr a).support
  let B : Module.Free.ChooseBasisIndex ℤ G → ℤ := fun i ↦ ∑ a ∈ s, |b.repr a i|
  let box : Finset G :=
    (Fintype.piFinset fun i : I ↦ Finset.Icc (-B i.1) (B i.1)).image
      (fun v ↦ ∑ i : I, v i • b i.1)
  let F : Finset G := box.filter (· ∈ S.nsmulSaturation)
  refine AddSubmonoid.isAddFG_iff.mpr ⟨F ∪ s, le_antisymm ?_ (fun x hx ↦ ?_)⟩
  · rw [AddSubmonoid.closure_le, Finset.coe_union]
    refine Set.union_subset (fun z hz ↦ (Finset.mem_filter.mp hz).2) ?_
    exact (hs ▸ AddSubmonoid.subset_closure).trans S.le_nsmulSaturation
  · obtain ⟨n, hn, hnx⟩ := AddSubmonoid.mem_nsmulSaturation.mp hx
    rw [← hs, AddSubmonoid.mem_closure_finset] at hnx
    obtain ⟨c, -, hc⟩ := hnx
    -- Divide the coefficients `c a` by `n`: the quotient `y` lies in `S`, and the remainder `z`
    -- lies in `S.nsmulSaturation` with coordinates bounded by `B`.
    let y : G := ∑ a ∈ s, (c a / n) • a
    let z : G := x - y
    have hnz : n • z = ∑ a ∈ s, (c a % n) • a := by
      rw [nsmul_sub, ← hc, Finset.smul_sum, sub_eq_iff_eq_add, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun a _ ↦ ?_
      rw [smul_smul, ← add_nsmul, add_comm, Nat.div_add_mod]
    have hz_sat : z ∈ S.nsmulSaturation := AddSubmonoid.mem_nsmulSaturation.mpr
      ⟨n, hn, hnz ▸ hs ▸ AddSubmonoid.sum_mem _ fun a ha ↦
        nsmul_mem (AddSubmonoid.subset_closure ha) _⟩
    have hz_supp : (b.repr z).support ⊆ I := by
      intro i hi
      by_contra hiI
      have h0 : ∀ a ∈ s, b.repr a i = 0 := fun a ha ↦
        Finsupp.notMem_support_iff.mp fun hia ↦ hiI (Finset.mem_biUnion.mpr ⟨a, ha, hia⟩)
      have hni : b.repr z i = 0 := by
        have h : (n : ℤ) * b.repr z i = 0 := calc
          (n : ℤ) * b.repr z i = ∑ a ∈ s, (c a % n : ℤ) * b.repr a i := by
            simpa [map_nsmul, map_sum] using congrArg (fun f ↦ f i) (congrArg b.repr hnz)
          _ = 0 := Finset.sum_eq_zero fun a ha ↦ by simp [h0 a ha]
        exact (mul_eq_zero.mp h).resolve_left (Nat.cast_ne_zero.mpr hn.ne')
      exact Finsupp.mem_support_iff.mp hi hni
    have hz_bound (i : I) : |b.repr z i.1| ≤ B i.1 := by
      have hn' : (0 : ℤ) < n := Nat.cast_pos.mpr hn
      refine le_of_mul_le_mul_left ?_ hn'
      calc
        (n : ℤ) * |b.repr z i.1|
            = |(n : ℤ) * b.repr z i.1| := by rw [abs_mul, abs_of_pos hn']
        _ = |∑ a ∈ s, (c a % n : ℤ) * b.repr a i.1| := by
            congr 1
            have h := congrArg (fun f ↦ f i.1) (congrArg b.repr hnz)
            simpa [map_nsmul, map_sum] using h
        _ ≤ ∑ a ∈ s, |(c a % n : ℤ) * b.repr a i.1| := Finset.abs_sum_le_sum_abs _ _
        _ = ∑ a ∈ s, (c a % n : ℤ) * |b.repr a i.1| := by
            refine Finset.sum_congr rfl fun a _ ↦ ?_
            rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
        _ ≤ ∑ a ∈ s, (n : ℤ) * |b.repr a i.1| := by
            refine Finset.sum_le_sum fun a _ ↦ mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
            exact_mod_cast (Nat.mod_lt (c a) hn).le
        _ = (n : ℤ) * B i.1 := (Finset.mul_sum _ _ _).symm
    have hz_box : z ∈ box := by
      refine Finset.mem_image.mpr ⟨fun i ↦ b.repr z i.1, Fintype.mem_piFinset.mpr fun i ↦
        Finset.mem_Icc.mpr (abs_le.mp (hz_bound i)), ?_⟩
      dsimp only
      rw [Finset.sum_coe_sort I fun i ↦ b.repr z i • b i]
      simpa [Finsupp.linearCombination_apply] using
        (Finsupp.sum_of_support_subset (b.repr z) hz_supp (fun i c ↦ c • b i)
          (fun _ _ ↦ zero_smul _ _)).symm.trans (b.linearCombination_repr z)
    have hzF : z ∈ F := Finset.mem_filter.mpr ⟨hz_box, hz_sat⟩
    have hyS : y ∈ AddSubmonoid.closure ((F ∪ s : Finset G) : Set G) :=
      AddSubmonoid.sum_mem _ fun a ha ↦
        nsmul_mem (AddSubmonoid.subset_closure (Finset.mem_union_right _ ha)) _
    simpa [z, sub_add_cancel] using add_mem
      (AddSubmonoid.subset_closure (Finset.mem_union_left _ hzF)) hyS

/-- In a torsion-free abelian group, the saturation of a finitely generated submonoid `S` inside
the subgroup generated by `S` is finitely generated. -/
theorem AddSubmonoid.FG.nsmulSaturation_inf_closure {G : Type*} [AddCommGroup G]
    [Module.IsTorsionFree ℤ G] {S : AddSubmonoid G} (hS : S.FG) :
    (S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid).FG := by
  let L := AddSubgroup.closure (S : Set G)
  obtain ⟨s, hs⟩ := AddSubmonoid.isAddFG_iff.mp hS
  have hsub : (s : Set G) ⊆ AddSubgroup.closure (s : Set G) := AddSubgroup.subset_closure
  have hL_fg : L.FG := AddSubgroup.isAddFG_iff.mpr ⟨s, le_antisymm
    (AddSubgroup.closure_mono (hs ▸ AddSubmonoid.subset_closure))
    ((AddSubgroup.closure_le (AddSubgroup.closure (s : Set G))).mpr fun x hx ↦
      AddSubmonoid.closure_le.mpr hsub (hs ▸ hx))⟩
  have : AddGroup.FG L := (AddGroup.fg_iff_addSubgroup_fg L).mpr hL_fg
  have : Module.Finite ℤ L := Module.Finite.iff_addGroup_fg.mpr this
  have : Module.IsTorsionFree ℤ L :=
    L.subtype_injective.moduleIsTorsionFree L.subtype fun _ _ ↦ rfl
  have : Module.Free ℤ L := Module.free_of_finite_type_torsion_free'
  have : IsAddFG S := hS
  have hS' : (AddMonoidHom.mrange S.toGroupClosure).FG := inferInstance
  have hmrange : AddMonoidHom.mrange L.subtype = L.toAddSubmonoid := by ext; simp
  have hsat := hS'.nsmulSaturation.map L.subtype
  simpa [L, S.mrange_toGroupClosure, S.nsmulSaturation_comap, AddSubmonoid.map_comap_eq,
    hmrange, inf_comm] using hsat
