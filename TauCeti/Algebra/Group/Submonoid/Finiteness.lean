/-!
# Finiteness of preimages and saturations of additive submonoids

The preimage of a finitely generated additive submonoid under a homomorphism from a finitely
generated commutative monoid is finitely generated, provided the target is cancellative.
For instance, since the nonnegative integer vectors form a finitely generated submonoid of
`ℤⁿ`, finitely many integral linear inequalities on a finitely generated commutative monoid cut out
a finitely generated additive submonoid (`AddSubmonoid.fg_of_mem_iff_forall_nonneg`).

Combining this slack-variable Gordan argument with the integral Tucker theorem
`TauCeti.exists_nat_sum_nsmul_eq_zero_and_forall_coeff_add_dual_pos` proves **Gordan's lemma for
positive-multiple saturations** (`AddSubmonoid.FG.nsmulSaturation`): if `S` is a finitely generated
additive submonoid of a free `ℤ`-module `G` (of arbitrary rank), then `S.nsmulSaturation` is
finitely generated, as is the saturation of `S` inside the subgroup `L_S` it generates
(`AddSubmonoid.FG.comap_groupClosure_nsmulSaturation`,
`AddSubmonoid.FG.nsmulSaturation_inf_closure`), without passing through a real vector space (compare
`TauCeti.Toric.IsLatticeRational.fg_dualSemigroup` and
`TauCeti.Toric.IsLatticeRational.fg_comap_toAddSubmonoid` for finite-rank cones over `ℝ`).

## Main declarations

* `AddSubmonoid.FG.comap`: preimages of finitely generated additive submonoids are finitely
  generated.
* `AddSubmonoid.fg_of_mem_iff_forall_nonneg`: an additive submonoid of a finitely generated
  commutative monoid cut out by finitely many integral linear inequalities is finitely generated.
* `AddSubmonoid.exists_addMonoidHom_nonneg_and_neg_of_notMem_nsmulSaturation`: an element outside
  the saturation of a finitely generated submonoid of a free `ℤ`-module is separated from it by an
  integral linear functional.
* `AddSubmonoid.FG.nsmulSaturation`: Gordan's lemma for the saturation of a finitely generated
  submonoid of a free `ℤ`-module.
* `AddSubmonoid.FG.comap_groupClosure_nsmulSaturation` and
  `AddSubmonoid.FG.nsmulSaturation_inf_closure`: finite generation of the saturation inside the
  subgroup generated by `S`.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 2, Theorem 2.9 (Gordan's
  lemma).
* W. Fulton, *Introduction to Toric Varieties*, §1.2, Proposition 1.
* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §1.2, Proposition 1.2.17.
-/

public section

/-- The preimage of a finitely generated additive submonoid of a cancellative commutative monoid
under a homomorphism from a finitely generated commutative monoid is finitely generated. -/
theorem AddSubmonoid.FG.comap {M G : Type*} [AddCommMonoid M] [AddCommMonoid G]
    [IsCancelAdd G] [AddMonoid.FG M] {P : AddSubmonoid G} (hP : P.FG) (f : M →+ G) :
    (P.comap f).FG := by
  obtain ⟨n, q, hq⟩ := AddSubmonoid.fg_iff_exists_fin_addMonoidHom.mp
    (AddMonoid.FG.fg_top (M := M))
  obtain ⟨k, g, rfl⟩ := AddSubmonoid.fg_iff_exists_fin_addMonoidHom.mp hP
  -- Pair a parameter of `M` with a slack vector parametrizing `P`, and keep the pairs whose
  -- images under `f` and `g` agree.
  let π := q.comp (AddMonoidHom.fst _ (Fin k → ℕ))
  convert (AddSubmonoid.fg_eqLocusM (f.comp π) (g.comp (.snd ..))).map π
  ext x
  constructor
  · rintro ⟨b, hb⟩
    obtain ⟨a, rfl⟩ := AddMonoidHom.mrange_eq_top.mp hq x
    exact ⟨(a, b), hb.symm, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a.2, ha.symm⟩

namespace AddSubmonoid

/-- In a finitely generated commutative monoid, an additive submonoid cut out by finitely many
integral nonnegativity inequalities is finitely generated. -/
theorem fg_of_mem_iff_forall_nonneg {M ι : Type*} [AddCommMonoid M] [AddMonoid.FG M] [Finite ι]
    (S : AddSubmonoid M) (f : ι → M →+ ℤ) (hS : ∀ x, x ∈ S ↔ ∀ i, 0 ≤ f i x) : S.FG := by
  classical
  cases nonempty_fintype ι
  let ev : M →+ (ι → ℤ) := AddMonoidHom.pi f
  let cast : (ι → ℕ) →+ (ι → ℤ) := (Nat.castAddMonoidHom ℤ).compLeft ι
  have hfg : ((AddMonoidHom.mrange cast).comap ev).FG := by
    rw [AddMonoidHom.mrange_eq_map]
    exact (FG.map (AddMonoid.FG.fg_top (M := ι → ℕ)) cast).comap ev
  convert hfg using 1
  ext x
  rw [hS, mem_comap, AddMonoidHom.mem_mrange]
  refine ⟨fun hx ↦ ⟨fun i ↦ (f i x).toNat, funext fun i ↦ Int.toNat_of_nonneg (hx i)⟩, ?_⟩
  rintro ⟨a, ha⟩ i
  have hi : (a i : ℤ) = f i x := congrFun ha i
  exact hi ▸ Int.natCast_nonneg (a i)

section FreeGroup

variable {G : Type*} [AddCommGroup G] [Module.Free ℤ G]

/-- An element outside the saturation of a finitely generated submonoid `S` of a free `ℤ`-module is
separated from `S` by an integral linear functional that is nonnegative on `S` and strictly
negative on the element. -/
theorem exists_addMonoidHom_nonneg_and_neg_of_notMem_nsmulSaturation {S : AddSubmonoid G}
    (hS : S.FG) {x : G} (hx : x ∉ S.nsmulSaturation) :
    ∃ m : G →+ ℤ, (∀ a ∈ S, 0 ≤ m a) ∧ m x < 0 := by
  classical
  obtain ⟨F, rfl⟩ := isAddFG_iff.mp hS
  let v : Option F → G := Option.elim' (-x) Subtype.val
  obtain ⟨c, m, hrel, hm, hpos⟩ :=
    TauCeti.exists_nat_sum_nsmul_eq_zero_and_forall_coeff_add_dual_pos v
  have heq : c none • x = ∑ a : F, c (some a) • (a : G) := by
    simpa [v, Fintype.sum_option, neg_add_eq_zero] using hrel
  have hc : c none = 0 := by
    by_contra hne
    refine hx (mem_nsmulSaturation.mpr ⟨c none, Nat.pos_of_ne_zero hne, ?_⟩)
    rw [heq]
    exact (closure (F : Set G)).sum_mem fun (a : F) _ ↦ nsmul_mem (subset_closure a.property) _
  refine ⟨m, fun a ha ↦ ?_, by simpa [hc, v] using hpos none⟩
  induction ha using closure_induction with
  | mem a ha => simpa [v] using hm (some ⟨a, ha⟩)
  | zero => simp
  | add a b _ _ ha hb => simpa using add_nonneg ha hb

/-- Gordan's lemma for the saturation of a finitely generated submonoid in a finite-rank free
`ℤ`-module. -/
private theorem fg_nsmulSaturation_of_moduleFinite [Module.Finite ℤ G] {S : AddSubmonoid G}
    (hS : S.FG) : S.nsmulSaturation.FG := by
  classical
  have : AddMonoid.FG G :=
    AddGroup.fg_iff_addMonoid_fg.mp (Module.Finite.iff_addGroup_fg.mp inferInstance)
  let b := Module.Free.chooseBasis ℤ G
  let e := (addMonoidHomLequivInt ℤ).trans b.dualBasis.equivFun
  have : AddMonoid.FG (G →+ ℤ) := (isAddFG_congr e.toAddEquiv).mpr inferInstance
  obtain ⟨F, hF⟩ := isAddFG_iff.mp hS
  let D : AddSubmonoid (G →+ ℤ) :=
    { carrier := {m | ∀ a : F, 0 ≤ m a.1}
      zero_mem' := fun _ ↦ le_rfl
      add_mem' := fun hm hn a ↦ add_nonneg (hm a) (hn a) }
  have hD_fg : D.FG :=
    fg_of_mem_iff_forall_nonneg D (fun a : F ↦ AddMonoidHom.eval a.1) fun _ ↦ Iff.rfl
  obtain ⟨M, hM⟩ := isAddFG_iff.mp hD_fg
  refine fg_of_mem_iff_forall_nonneg S.nsmulSaturation (fun m : M ↦ m.1) fun x ↦ ⟨?_, ?_⟩
  · rintro hx ⟨m, hm⟩
    obtain ⟨n, hn, hnx⟩ := mem_nsmulSaturation.mp hx
    have hmD : m ∈ D := hM ▸ subset_closure hm
    have hmS : ∀ s ∈ S, 0 ≤ m s := by
      intro s hs
      rw [← hF] at hs
      induction hs using closure_induction with
      | mem a ha => exact hmD ⟨a, ha⟩
      | zero => simp
      | add u v _ _ hu hv => simpa using add_nonneg hu hv
    have hmnx : 0 ≤ (n : ℤ) * m x := by simpa [map_nsmul] using hmS _ hnx
    exact nonneg_of_mul_nonneg_right hmnx (Int.natCast_pos.mpr hn)
  · intro hx
    by_contra hnot
    obtain ⟨m, hmS, hneg⟩ := exists_addMonoidHom_nonneg_and_neg_of_notMem_nsmulSaturation hS hnot
    have hmD : m ∈ closure (M : Set (G →+ ℤ)) :=
      hM.symm ▸ fun a ↦ hmS a.1 (hF ▸ subset_closure a.2)
    have hnonneg : ∀ μ ∈ closure (M : Set (G →+ ℤ)), 0 ≤ μ x := by
      intro μ hμ
      induction hμ using closure_induction with
      | mem μ hμ => exact hx ⟨μ, hμ⟩
      | zero => simp
      | add μ ν _ _ hμ hν => simpa using add_nonneg hμ hν
    exact (not_lt_of_ge (hnonneg m hmD)) hneg

/-- **Gordan's lemma for positive-multiple saturation.** If `S` is a finitely generated additive
submonoid of a free `ℤ`-module `G` (of arbitrary rank), then `S.nsmulSaturation` is finitely
generated. -/
theorem FG.nsmulSaturation {S : AddSubmonoid G} (hS : S.FG) : S.nsmulSaturation.FG := by
  classical
  let b := Module.Free.chooseBasis ℤ G
  obtain ⟨F, hF⟩ := isAddFG_iff.mp hS
  -- All generators of `S`, and hence all elements of `S` and `S.nsmulSaturation`, are supported on
  -- a single finite set `I` of basis coordinates.
  let I : Finset (Module.Free.ChooseBasisIndex ℤ G) :=
    F.biUnion fun a ↦ (b.repr a).support
  let r : G →+ (I → ℤ) := AddMonoidHom.mk' (fun g k ↦ b.repr g k.1) fun g g' ↦ by ext k; simp
  let p : (I → ℤ) →+ G := AddMonoidHom.mk' (fun f ↦ ∑ k : I, f k • b k.1) fun f f' ↦ by
    simp [add_smul, Finset.sum_add_distrib]
  have hpr {g : G} (hg : ∀ j ∉ I, b.repr g j = 0) : p (r g) = g := by
    conv_rhs => rw [← b.linearCombination_repr g]
    rw [Finsupp.linearCombination_apply, Finsupp.sum,
      Finset.sum_subset (s₁ := (b.repr g).support) (s₂ := I)]
    · simpa [p, r] using (Finset.sum_attach I fun j ↦ b.repr g j • b j)
    · intro j hj
      by_contra hjI
      exact Finsupp.mem_support_iff.mp hj (hg j hjI)
    · intro j _ hj
      rw [Finsupp.notMem_support_iff.mp hj, zero_smul]
  have hsupp_S {g : G} (hg : g ∈ S) : ∀ j ∉ I, b.repr g j = 0 := by
    rw [← hF] at hg
    induction hg using closure_induction with
    | mem a ha =>
      intro j hj
      by_contra hne
      exact hj (Finset.mem_biUnion.mpr ⟨a, ha, Finsupp.mem_support_iff.mpr hne⟩)
    | zero => simp
    | add u v _ _ hu hv =>
      intro j hj
      simp [hu j hj, hv j hj]
  have heq : S.nsmulSaturation = (S.map r).nsmulSaturation.map p := by
    ext x
    constructor
    · intro hx
      obtain ⟨n, hn, hnx⟩ := mem_nsmulSaturation.mp hx
      have hx_supp (j) (hj : j ∉ I) : b.repr x j = 0 := by
        have hmul : (n : ℤ) * b.repr x j = 0 := by
          simpa using hsupp_S hnx j hj
        exact (mul_eq_zero.mp hmul).resolve_left (by exact_mod_cast hn.ne')
      refine mem_map.mpr ⟨r x, mem_nsmulSaturation.mpr ⟨n, hn, ?_⟩, hpr hx_supp⟩
      rw [← map_nsmul]
      exact mem_map_of_mem r hnx
    · rintro ⟨f, hf, rfl⟩
      obtain ⟨n, hn, s, hs, hfs⟩ := mem_nsmulSaturation.mp hf
      refine mem_nsmulSaturation.mpr ⟨n, hn, ?_⟩
      rw [← map_nsmul, ← hfs, hpr (hsupp_S hs)]
      exact hs
  rw [heq]
  exact FG.map (fg_nsmulSaturation_of_moduleFinite (FG.map hS r)) p

/-- For a finitely generated submonoid `S` of a free `ℤ`-module `G`, the saturation of `S` inside
the subgroup `AddSubgroup.closure S` it generates is finitely generated. -/
theorem FG.comap_groupClosure_nsmulSaturation {S : AddSubmonoid G} (hS : S.FG) :
    (S.comap (AddSubgroup.closure (S : Set G)).subtype).nsmulSaturation.FG := by
  have := (AddSubgroup.closure (S : Set G)).free_int
  have : AddMonoid.FG S := hS
  have hcomap_fg : (S.comap (AddSubgroup.closure (S : Set G)).subtype).FG := by
    rw [← S.mrange_toGroupClosure, AddMonoidHom.mrange_eq_map]
    exact FG.map AddMonoid.FG.fg_top S.toGroupClosure
  exact hcomap_fg.nsmulSaturation

/-- For a finitely generated submonoid `S` of a free `ℤ`-module `G`, the intersection of
`S.nsmulSaturation` with the subgroup generated by `S` is finitely generated. -/
theorem FG.nsmulSaturation_inf_closure {S : AddSubmonoid G} (hS : S.FG) :
    (S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid).FG := by
  have h : (S.nsmulSaturation.comap (AddSubgroup.closure (S : Set G)).subtype).FG := by
    rw [← nsmulSaturation_comap]
    exact hS.comap_groupClosure_nsmulSaturation
  exact (isAddFG_congr (S.nsmulSaturation.comapSubtypeEquivInf _)).mp h

end FreeGroup

end AddSubmonoid
