module

public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Algebra.Group.Submonoid.Operations
public import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.Tactic.Abel

/-!
# The group generated by an additive submonoid

The additive subgroup generated by a submonoid `S` of an abelian group consists exactly
of differences of elements of `S`. The canonical inclusion `S.toGroupClosure` therefore
realizes the generated group using only the lattice generated by `S`, even when the
ambient group is larger, and restricts to an additive equivalence `S.toGroupClosureEquiv` onto
`S.comap (AddSubgroup.closure S).subtype`. When `S` is finitely generated, both
`AddSubgroup.closure S` (including as a `ℤ`-module when `G` is commutative) and
`S.comap (AddSubgroup.closure S).subtype` inherit finite generation. The denominator-clearing
statement is useful for localizing semigroup algebras at their monomials.
-/

public section

namespace AddSubmonoid

variable {G : Type*}

section

variable [AddGroup G] (S : AddSubmonoid G)

/-- The canonical inclusion of an additive submonoid into the subgroup it generates. -/
def toGroupClosure : S →+ AddSubgroup.closure (S : Set G) :=
  S.subtype.codRestrict _ fun s ↦ AddSubgroup.subset_closure s.property

/-- The canonical inclusion preserves the underlying element of the ambient group. -/
@[simp]
theorem coe_toGroupClosure (s : S) : (S.toGroupClosure s : G) = s :=
  (rfl)

/-- The inclusion into the generated group is injective. -/
theorem toGroupClosure_injective : Function.Injective S.toGroupClosure :=
  (S.subtype.injective_codRestrict _ _).mpr S.subtype_injective

/-- The range of `S.toGroupClosure` inside `AddSubgroup.closure S` is the pullback of `S` along
the subgroup inclusion. -/
@[simp]
theorem mrange_toGroupClosure :
    AddMonoidHom.mrange S.toGroupClosure = S.comap (AddSubgroup.closure (S : Set G)).subtype := by
  ext ⟨x, hx⟩
  refine ⟨?_, fun hxS ↦ ⟨⟨x, hxS⟩, rfl⟩⟩
  rintro ⟨s, hs⟩
  rw [mem_comap, AddSubgroup.coe_subtype, ← congrArg Subtype.val hs]
  exact s.property

/-- The canonical additive equivalence between `S` and its pullback to the subgroup it
generates. -/
def toGroupClosureEquiv : S ≃+ S.comap (AddSubgroup.closure (S : Set G)).subtype where
  toFun s := ⟨S.toGroupClosure s, s.property⟩
  invFun y := ⟨y.1.1, y.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

/-- `toGroupClosureEquiv` agrees with `toGroupClosure` inside `AddSubgroup.closure S`. -/
@[simp]
theorem coe_toGroupClosureEquiv_apply (s : S) :
    (S.toGroupClosureEquiv s : AddSubgroup.closure (S : Set G)) = S.toGroupClosure s :=
  (rfl)

/-- `toGroupClosureEquiv.symm` preserves the underlying element of the ambient group. -/
@[simp]
theorem coe_toGroupClosureEquiv_symm_apply
    (y : S.comap (AddSubgroup.closure (S : Set G)).subtype) :
    (S.toGroupClosureEquiv.symm y : G) = y :=
  (rfl)

/-- The subgroup generated by a finitely generated additive submonoid is finitely generated. -/
theorem FG.addSubgroup_closure {S : AddSubmonoid G} (hS : S.FG) :
    (AddSubgroup.closure (S : Set G)).FG := by
  obtain ⟨s, rfl⟩ := isAddFG_iff.mp hS
  have heq : AddSubgroup.closure ((closure (s : Set G) : AddSubmonoid G) : Set G) =
      AddSubgroup.closure (s : Set G) :=
    le_antisymm
      ((AddSubgroup.closure_le _).mpr (AddSubgroup.le_closure_toAddSubmonoid _))
      (AddSubgroup.closure_mono subset_closure)
  exact (AddSubgroup.fg_iff _).mpr ⟨s, heq.symm, s.finite_toSet⟩

/-- Pulling back a finitely generated additive submonoid `S` to the subgroup it generates yields a
finitely generated additive submonoid. -/
theorem FG.comap_subtype_closure {S : AddSubmonoid G} (hS : S.FG) :
    (S.comap (AddSubgroup.closure (S : Set G)).subtype).FG := by
  have : AddMonoid.FG S := (AddMonoid.fg_iff_addSubmonoid_fg S).mpr hS
  rw [← S.mrange_toGroupClosure, AddMonoidHom.mrange_eq_map]
  exact AddMonoid.FG.fg_top.map S.toGroupClosure

end

variable [AddCommGroup G]

/-- For a finitely generated additive submonoid `S` of a commutative group `G`, the generated
subgroup `AddSubgroup.closure (S : Set G)` is a finitely generated `ℤ`-module. -/
theorem FG.moduleFinite_addSubgroup_closure {S : AddSubmonoid G} (hS : S.FG) :
    Module.Finite ℤ (AddSubgroup.closure (S : Set G)) :=
  Module.Finite.iff_addGroup_fg.mpr hS.addSubgroup_closure

variable (S : AddSubmonoid G)

/-- An element belongs to the group generated by `S` exactly when it is a difference
of two elements of `S`. -/
theorem mem_groupClosure_iff {g : G} :
    g ∈ AddSubgroup.closure (S : Set G) ↔ ∃ a b : S, g = (a : G) - b := by
  constructor
  · intro hg
    induction hg using AddSubgroup.closure_induction with
    | mem g hg => exact ⟨⟨g, hg⟩, 0, by simp⟩
    | zero => exact ⟨0, 0, by simp⟩
    | add g h _ _ hg hh =>
      obtain ⟨a, b, rfl⟩ := hg
      obtain ⟨c, d, rfl⟩ := hh
      exact ⟨a + c, b + d, by simp only [coe_add]; abel⟩
    | neg g _ hg =>
      obtain ⟨a, b, rfl⟩ := hg
      exact ⟨b, a, by simp⟩
  · rintro ⟨a, b, rfl⟩
    exact (AddSubgroup.closure (S : Set G)).sub_mem
      (AddSubgroup.subset_closure a.property) (AddSubgroup.subset_closure b.property)

/-- Every element of the generated group can be shifted into `S` by an element of `S`. -/
theorem exists_add_toGroupClosure_eq (g : AddSubgroup.closure (S : Set G)) :
    ∃ a b : S, g + S.toGroupClosure b = S.toGroupClosure a := by
  obtain ⟨a, b, hab⟩ := S.mem_groupClosure_iff.mp g.property
  refine ⟨a, b, Subtype.ext ?_⟩
  simpa using (eq_sub_iff_add_eq.mp hab)

end AddSubmonoid
