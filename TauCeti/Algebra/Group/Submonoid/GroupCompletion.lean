module

public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Algebra.Group.Submonoid.Operations
import Mathlib.Tactic.Abel

/-!
# The group generated by an additive submonoid

The additive subgroup generated by a submonoid `S` of an abelian group consists exactly
of differences of elements of `S`. The canonical inclusion `S.toGroupClosure` therefore
realizes the generated group using only the lattice generated by `S`, even when the
ambient group is larger. The denominator-clearing statement is useful for localizing
semigroup algebras at their monomials.
-/

public section

namespace AddSubmonoid

variable {G : Type*}

section

variable [AddGroup G] (S : AddSubmonoid G)

/-- The canonical inclusion of an additive submonoid into the subgroup it generates. -/
def toGroupClosure : S →+ AddSubgroup.closure (S : Set G) :=
  S.subtype.codRestrict _ fun s ↦ AddSubgroup.subset_closure s.property

/-- The canonical inclusion preserves the underlying element of the ambient group. -/
@[simp]
theorem coe_toGroupClosure (s : S) : (S.toGroupClosure s : G) = s :=
  (rfl)

/-- The inclusion into the generated group is injective. -/
theorem toGroupClosure_injective : Function.Injective S.toGroupClosure :=
  (S.subtype.injective_codRestrict _ _).mpr S.subtype_injective

/-- The additive range of `S.toGroupClosure` inside the generated group is the pullback of `S`
along the subgroup inclusion. -/
@[simp]
theorem mrange_toGroupClosure :
    AddMonoidHom.mrange S.toGroupClosure = S.comap (AddSubgroup.closure (S : Set G)).subtype := by
  ext g
  simp only [AddMonoidHom.mem_mrange, mem_comap, AddSubgroup.coe_subtype]
  exact ⟨fun ⟨s, hs⟩ ↦ hs ▸ s.property, fun hg ↦ ⟨⟨g, hg⟩, rfl⟩⟩

/-- The pullback of an additive submonoid `T` to an additive subgroup `H` is canonically
isomorphic to the intersection `T ⊓ H.toAddSubmonoid`, via the inclusion of `H` in `G`. -/
def comapSubtypeEquivInf (T : AddSubmonoid G) (H : AddSubgroup G) :
    ↥(T.comap H.subtype) ≃+ ↥(T ⊓ H.toAddSubmonoid) where
  toFun x := ⟨x.1.1, x.2, x.1.2⟩
  invFun y := ⟨⟨y.1, y.2.2⟩, y.2.1⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

/-- `comapSubtypeEquivInf` preserves the underlying element of `G`. -/
@[simp]
theorem coe_comapSubtypeEquivInf (T : AddSubmonoid G) (H : AddSubgroup G)
    (x : T.comap H.subtype) :
    ((comapSubtypeEquivInf T H x : ↥(T ⊓ H.toAddSubmonoid)) : G) = x.1 :=
  (rfl)

/-- The inverse of `comapSubtypeEquivInf` preserves the underlying element of `G`. -/
@[simp]
theorem coe_comapSubtypeEquivInf_symm (T : AddSubmonoid G) (H : AddSubgroup G)
    (y : ↥(T ⊓ H.toAddSubmonoid)) :
    (((comapSubtypeEquivInf T H).symm y : ↥(T.comap H.subtype)) : H) = ⟨y.1, y.2.2⟩ :=
  (rfl)

end

variable [AddCommGroup G] (S : AddSubmonoid G)

/-- An element belongs to the group generated by `S` exactly when it is a difference
of two elements of `S`. -/
theorem mem_groupClosure_iff {g : G} :
    g ∈ AddSubgroup.closure (S : Set G) ↔ ∃ a b : S, g = (a : G) - b := by
  constructor
  · intro hg
    induction hg using AddSubgroup.closure_induction with
    | mem g hg => exact ⟨⟨g, hg⟩, 0, by simp⟩
    | zero => exact ⟨0, 0, by simp⟩
    | add g h _ _ hg hh =>
      obtain ⟨a, b, rfl⟩ := hg
      obtain ⟨c, d, rfl⟩ := hh
      exact ⟨a + c, b + d, by simp only [coe_add]; abel⟩
    | neg g _ hg =>
      obtain ⟨a, b, rfl⟩ := hg
      exact ⟨b, a, by simp⟩
  · rintro ⟨a, b, rfl⟩
    exact (AddSubgroup.closure (S : Set G)).sub_mem
      (AddSubgroup.subset_closure a.property) (AddSubgroup.subset_closure b.property)

/-- Every element of the generated group can be shifted into `S` by an element of `S`. -/
theorem exists_add_toGroupClosure_eq (g : AddSubgroup.closure (S : Set G)) :
    ∃ a b : S, g + S.toGroupClosure b = S.toGroupClosure a := by
  obtain ⟨a, b, hab⟩ := S.mem_groupClosure_iff.mp g.property
  refine ⟨a, b, Subtype.ext ?_⟩
  simpa using (eq_sub_iff_add_eq.mp hab)

end AddSubmonoid
