module

public import Mathlib.Algebra.BigOperators.Intervals
public import Mathlib.Algebra.Group.Submonoid.BigOperators
public import Mathlib.Tactic.Abel

/-!
# Telescoping differences in additive submonoids

This file records criteria for differences and sums of terms in a sequence to belong to an
additive submonoid, given membership of its consecutive differences. The criteria are stated for
any `AddSubmonoidClass`, so they apply equally to additive subgroups, submodules and ideals.

## Main results

* `TauCeti.sub_mem_of_consecutive_sub_mem`: a difference of two terms telescopes into an additive
  submonoid containing the intervening consecutive differences.
* `TauCeti.sub_mem_closure_of_le`: a difference `f a - f b` with `a ≤ b ≤ n` lies in the additive
  closure of the first `n` consecutive differences.
* `TauCeti.sub_mem_of_consecutive_sub_mem_fin`: the corresponding result for a `Fin`-indexed
  family.
* `TauCeti.add_mem_of_consecutive_sub_mem_fin`: a companion criterion for sums in a
  `Fin`-indexed family.
-/

public section

namespace TauCeti

variable {M S : Type*} [AddCommGroup M] [SetLike S M] [AddSubmonoidClass S M] {s : S}

/-- A difference `f a - f b` telescopes into any additive submonoid containing all the consecutive
differences `f k - f (k + 1)` for `a ≤ k < b`. -/
theorem sub_mem_of_consecutive_sub_mem (f : ℕ → M) {a b : ℕ} (hab : a ≤ b)
    (h : ∀ k, a ≤ k → k < b → f k - f (k + 1) ∈ s) : f a - f b ∈ s := by
  rw [← neg_sub_neg, ← Finset.sum_Ico_sub (fun k => -f k) hab]
  exact sum_mem fun k hk => by
    rw [neg_sub_neg]
    exact h k (Finset.mem_Ico.1 hk).1 (Finset.mem_Ico.1 hk).2

/-- A difference `f a - f b` with `a ≤ b ≤ n` lies in the additive submonoid generated by the `n`
consecutive differences `f i - f (i + 1)`. -/
theorem sub_mem_closure_of_le {n : ℕ} (f : ℕ → M) {a b : ℕ} (hb : b ≤ n) (hab : a ≤ b) :
    f a - f b ∈ AddSubmonoid.closure (Set.range fun i : Fin n => f (i : ℕ) - f ((i : ℕ) + 1)) :=
  sub_mem_of_consecutive_sub_mem f hab fun i _ hib =>
    AddSubmonoid.subset_closure ⟨⟨i, hib.trans_le hb⟩, rfl⟩

/-- A difference `v a - v b` of a `Fin`-indexed family with `a ≤ b` lies in any additive submonoid
containing the consecutive differences `v k - v (k + 1)`. -/
theorem sub_mem_of_consecutive_sub_mem_fin {m : ℕ} (v : Fin m → M)
    (h : ∀ a b : Fin m, (a : ℕ) + 1 = b → v a - v b ∈ s) {a b : Fin m} (hab : a ≤ b) :
    v a - v b ∈ s := by
  let f (k : ℕ) : M := if hk : k < m then v ⟨k, hk⟩ else 0
  have hf (c : Fin m) : f c = v c := by simp [f]
  rw [← hf a, ← hf b]
  refine sub_mem_of_consecutive_sub_mem f hab fun k _ hkb => ?_
  have hk : k + 1 < m := by omega
  simpa [f, hk, Nat.lt_of_succ_lt hk] using h ⟨k, by omega⟩ ⟨k + 1, hk⟩ rfl

/-- A sum `v a + v b` of a `Fin`-indexed family lies in any additive submonoid containing the
consecutive differences `v k - v (k + 1)` and twice the last member, since it is
`(v a - v c) + (v b - v c) + (v c + v c)` for the last index `c`. -/
theorem add_mem_of_consecutive_sub_mem_fin {m : ℕ} (v : Fin m → M)
    (h : ∀ a b : Fin m, (a : ℕ) + 1 = b → v a - v b ∈ s)
    (hlast : ∀ c : Fin m, (c : ℕ) + 1 = m → v c + v c ∈ s) (a b : Fin m) :
    v a + v b ∈ s := by
  have hm := a.isLt
  let c : Fin m := ⟨m - 1, by omega⟩
  have hc (d : Fin m) : d ≤ c := Fin.le_def.2 (Nat.le_sub_one_of_lt d.isLt)
  rw [show v a + v b = (v a - v c) + (v b - v c) + (v c + v c) by abel]
  exact add_mem (add_mem (sub_mem_of_consecutive_sub_mem_fin v h (hc a))
    (sub_mem_of_consecutive_sub_mem_fin v h (hc b))) (hlast c (by simp [c]; omega))

end TauCeti
