module

public import Mathlib.Algebra.Group.Submonoid.BigOperators
public import Mathlib.Algebra.Group.Submonoid.Operations
import Mathlib.Algebra.Group.Submonoid.Finsupp
import TauCeti.Algebra.Group.Submonoid.PositiveDegree
import TauCeti.Data.Finsupp.Weight

/-!
# The additive closure of a family

This file records that a family generates its additive closure when viewed inside it. It also
records when an integer combination `∑ i, c i • v i` of a finite family `v` lies in the additive
submonoid generated by the family: when all coefficients are nonnegative, and, up to sign, when
all coefficients have the same sign. These are the integer-coefficient companions of
`AddSubmonoid.mem_closure_range_iff_of_fintype`, which describes the closure through natural
coefficients. Finally, for finitely many generators of positive degree in `ℕ`, only finitely
many elements of the closure have a given degree.

## Main results

* `TauCeti.closure_range_mk_eq_top`: the family `v`, viewed in the additive submonoid
  `AddSubmonoid.closure (range v)` it generates, generates that submonoid.
* `TauCeti.finite_closure_range_deg_eq`: for finitely many generators of positive degree, only
  finitely many elements of the closure have degree `n`.
* `TauCeti.sum_smul_mem_closure`: a combination with nonnegative integer coefficients lies in the
  additive closure of the family.
* `TauCeti.sum_smul_mem_or_neg_mem_closure`: a combination whose coefficients all have the same sign
  lies in the additive closure of the family, or its negative does.
-/

public section

namespace TauCeti

open Set

/-- A family `v`, viewed in the additive submonoid `AddSubmonoid.closure (range v)` it generates,
generates that submonoid. This is the family form of `AddSubmonoid.closure_closure_coe_preimage`. -/
theorem closure_range_mk_eq_top {ι M : Type*} [AddMonoid M] (v : ι → M) :
    AddSubmonoid.closure (range fun i ↦ (⟨v i, AddSubmonoid.subset_closure (mem_range_self i)⟩ :
      AddSubmonoid.closure (range v))) = ⊤ := by
  rw [← AddSubmonoid.closure_closure_coe_preimage (s := range v)]
  congr 1
  ext ⟨m, hm⟩
  simp [Subtype.ext_iff]

/-- For finitely many generators `a i` of positive degree in `ℕ`, only finitely many elements of
the submonoid they generate have degree `n`: each is `∑ i, u i • a i` for an exponent `u` of
weight `n`. -/
theorem finite_closure_range_deg_eq {ι M : Type*} [AddCommMonoid M] [Finite ι] (a : ι → M)
    (deg : M →+ ℕ) (hdeg : ∀ i, deg (a i) ≠ 0) (n : ℕ) :
    Finite {s : AddSubmonoid.closure (range a) // deg s = n} := by
  let := Finsupp.nonTorsionWeight_of ℕ (w := deg ∘ a) hdeg
  have hfg : (AddSubmonoid.closure (range a)).FG :=
    (AddSubmonoid.fg_iff _).mpr ⟨range a, rfl, finite_range a⟩
  have hpos : ∀ x ∈ AddSubmonoid.closure (range a), x ≠ 0 →
      0 < ((Nat.castAddMonoidHom ℤ).comp deg) x := by
    intro x hx hne
    obtain ⟨u, hu⟩ := AddSubmonoid.mem_closure_range_iff.mp hx
    have hu' : Finsupp.linearCombination ℕ a u = x := by
      simpa [Finsupp.linearCombination_apply] using hu.symm
    have hd : deg x ≠ 0 := by
      intro hx0
      have hw : Finsupp.weight (deg ∘ a) u = 0 := by
        rw [Finsupp.weight_comp_eq_apply_linearCombination, hu', hx0]
      have hu0 := (Finsupp.weight_eq_zero_iff_eq_zero (deg ∘ a)).mp hw
      apply hne
      rw [← hu', hu0, map_zero]
    simpa using Nat.pos_of_ne_zero hd
  have hcut := hfg.finite_degree_le ((Nat.castAddMonoidHom ℤ).comp deg) hpos n
  have hfin : {s : AddSubmonoid.closure (range a) | deg s = n}.Finite := by
    refine (hcut.preimage Subtype.val_injective.injOn).subset ?_
    intro s (hs : deg s = n)
    exact ⟨s.property, by simp [hs]⟩
  exact hfin.to_subtype

variable {κ M : Type*} [Fintype κ] [SubtractionCommMonoid M] (v : κ → M)

/-- A combination of a finite family with nonnegative integer coefficients lies in the additive
closure of the family. -/
theorem sum_smul_mem_closure (c : κ → ℤ) (hc : ∀ i, 0 ≤ c i) :
    (∑ i, c i • v i) ∈ AddSubmonoid.closure (range v) := by
  refine AddSubmonoid.sum_mem _ fun i _ => ?_
  lift c i to ℕ using hc i with m
  rw [natCast_zsmul]
  exact AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure (mem_range_self i)) m

/-- A combination of a finite family whose integer coefficients all have the same sign lies in the
additive closure of the family, or its negative does. -/
theorem sum_smul_mem_or_neg_mem_closure (c : κ → ℤ) (hc : (∀ i, 0 ≤ c i) ∨ (∀ i, c i ≤ 0)) :
    (∑ i, c i • v i) ∈ AddSubmonoid.closure (range v) ∨
      -(∑ i, c i • v i) ∈ AddSubmonoid.closure (range v) := by
  refine hc.imp (sum_smul_mem_closure v c) fun h => ?_
  rw [← Finset.sum_neg_distrib]
  simp only [← neg_zsmul]
  exact sum_smul_mem_closure v (-c) fun i => Int.neg_nonneg_of_nonpos (h i)

end TauCeti
