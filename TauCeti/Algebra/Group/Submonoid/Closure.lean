/-!
# The additive closure of a family

This file records that a family generates its additive closure when viewed inside it. It also
records when an integer combination `∑ i, c i • v i` of a finite family `v` lies in the additive
submonoid generated by the family: when all coefficients are nonnegative, and, up to sign, when
all coefficients have the same sign. These are the integer-coefficient companions of
`AddSubmonoid.mem_closure_range_iff_of_fintype`, which describes the closure through natural
coefficients. For finitely many generators of positive degree in `ℕ`, only finitely
many elements of the closure have a given degree. Strict positivity of an additive map on
the nonzero elements of a generated submonoid is tested on the nonzero generators. Finally,
additive closures inside a submonoid are compared with additive closures in the ambient monoid.

## Main results

* `TauCeti.closure_range_mk_eq_top`: the family `v`, viewed in the additive submonoid
  `AddSubmonoid.closure (range v)` it generates, generates that submonoid.
* `TauCeti.finite_closure_range_deg_eq`: for finitely many generators of positive degree, only
  finitely many elements of the closure have degree `n`.
* `TauCeti.sum_smul_mem_closure`: a combination with nonnegative integer coefficients lies in the
  additive closure of the family.
* `TauCeti.sum_smul_mem_or_neg_mem_closure`: a combination whose coefficients all have the same sign
  lies in the additive closure of the family, or its negative does.
* `AddSubmonoid.forall_pos_iff_of_closure_eq`: an additive map is strictly positive on the nonzero
  elements of a generated submonoid exactly when it is on the nonzero generators.
* `AddSubmonoid.mem_closure_image_iff_coe`, `AddSubmonoid.mem_closure_image_preimage_val_iff`:
  membership in the additive closure of a family valued in a submonoid, indexed by all indices or
  by a subset, read in the ambient monoid.

`AddSubmonoid.forall_pos_iff_of_closure_eq` is adapted from
`Mei/Algebra/Group/AddSubmonoid/Degree.lean` in
[yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`3d2e9c869ee44c41ae9c7b5c6e2042898430d0ca` (Apache 2.0).
-/

public section

namespace TauCeti

open Set

/-- A family `v`, viewed in the additive submonoid `AddSubmonoid.closure (range v)` it generates,
generates that submonoid. This is the family form of `AddSubmonoid.closure_closure_coe_preimage`. -/
theorem closure_range_mk_eq_top {ι M : Type*} [AddZeroClass M] (v : ι → M) :
    AddSubmonoid.closure (range fun i ↦ (⟨v i, AddSubmonoid.subset_closure (mem_range_self i)⟩ :
      AddSubmonoid.closure (range v))) = ⊤ := by
  rw [← AddSubmonoid.closure_closure_coe_preimage (s := range v)]
  congr 1
  ext
  simp [Subtype.ext_iff]

/-- For finitely many generators `a i` of positive degree in `ℕ`, only finitely many elements of
the submonoid they generate have degree `n`: each is `∑ i, u i • a i` for an exponent `u` of
weight `n`. -/
theorem finite_closure_range_deg_eq {ι M : Type*} [AddCommMonoid M] [Finite ι] (a : ι → M)
    (deg : M →+ ℕ) (hdeg : ∀ i, deg (a i) ≠ 0) (n : ℕ) :
    Finite {s : AddSubmonoid.closure (range a) // deg s = n} := by
  let f (u : ι →₀ ℕ) : AddSubmonoid.closure (range a) :=
    ⟨_, AddSubmonoid.mem_closure_range_iff.2 ⟨u, Finsupp.linearCombination_apply ℕ u⟩⟩
  refine Set.Finite.to_subtype (s := {s : AddSubmonoid.closure (range a) | deg s = n}) <|
    ((Finsupp.finite_of_nat_weight_eq (deg ∘ a) hdeg n).image f).subset ?_
  rintro ⟨s, hs⟩ (rfl : deg s = n)
  obtain ⟨u, rfl⟩ := AddSubmonoid.mem_closure_range_iff.1 hs
  exact ⟨u, Finsupp.weight_comp_eq_apply_linearCombination deg a u,
    Subtype.ext (Finsupp.linearCombination_apply ℕ u)⟩

variable {κ M : Type*} [Fintype κ] [SubtractionCommMonoid M] (v : κ → M)

/-- A combination of a finite family with nonnegative integer coefficients lies in the additive
closure of the family. -/
theorem sum_smul_mem_closure (c : κ → ℤ) (hc : ∀ i, 0 ≤ c i) :
    (∑ i, c i • v i) ∈ AddSubmonoid.closure (range v) := by
  refine sum_mem fun i _ ↦ ?_
  rw [← Int.toNat_of_nonneg (hc i), natCast_zsmul]
  exact nsmul_mem (AddSubmonoid.subset_closure (mem_range_self i)) _

/-- A combination of a finite family whose integer coefficients all have the same sign lies in the
additive closure of the family, or its negative does. -/
theorem sum_smul_mem_or_neg_mem_closure (c : κ → ℤ) (hc : (∀ i, 0 ≤ c i) ∨ (∀ i, c i ≤ 0)) :
    (∑ i, c i • v i) ∈ AddSubmonoid.closure (range v) ∨
      -(∑ i, c i • v i) ∈ AddSubmonoid.closure (range v) := by
  refine hc.imp (sum_smul_mem_closure v c) fun h ↦ ?_
  simpa using sum_smul_mem_closure v (-c) fun i ↦ neg_nonneg.2 (h i)

end TauCeti

namespace AddSubmonoid

variable {M A : Type*} [AddCommMonoid M] [AddCommMonoid A] [PartialOrder A] [IsOrderedAddMonoid A]

/-- An additive map is strictly positive on the nonzero elements of a generated submonoid exactly
when it is strictly positive on the nonzero generators. Zero is allowed among the generators, and
the ambient monoid need not be cancellative. -/
theorem forall_pos_iff_of_closure_eq {P : AddSubmonoid M} {s : Set M} (hs : closure s = P)
    (f : M →+ A) : (∀ x ∈ P, x ≠ 0 → 0 < f x) ↔ ∀ x ∈ s, x ≠ 0 → 0 < f x := by
  refine ⟨fun h x hx => h x (hs ▸ subset_closure hx), fun h x hx hx0 => ?_⟩
  let S : AddSubmonoid M :=
    { carrier := {x | x = 0 ∨ 0 < f x}
      zero_mem' := Or.inl rfl
      add_mem' := by
        rintro x y (rfl | hx) (rfl | hy)
        · simp
        · simpa using Or.inr hy
        · simpa using Or.inr hx
        · exact Or.inr (by simpa using add_pos' hx hy) }
  have hPS : P ≤ S := by
    rw [← hs, closure_le]
    intro y hy
    by_cases hy0 : y = 0
    · exact Or.inl hy0
    · exact Or.inr (h y hy hy0)
  exact (hPS hx).resolve_left hx0

/-- Membership in the additive closure of a family `f` valued in a submonoid `p`, restricted to the
indices in `s`, can be read in the ambient monoid: it is membership in the additive closure of any
family `g` with the same values, restricted to the same indices. -/
theorem mem_closure_image_iff_coe {ι B S : Type*} [AddMonoid B] [SetLike S B]
    [AddSubmonoidClass S B] {p : S} {f : ι → p} {g : ι → B} (hfg : ∀ i, (f i : B) = g i)
    {s : Set ι} {x : p} :
    x ∈ closure (f '' s) ↔ (x : B) ∈ closure (g '' s) := by
  have himage : AddSubmonoidClass.subtype p '' (f '' s) = g '' s := by
    rw [Set.image_image]
    simp_rw [AddSubmonoidClass.coe_subtype, hfg]
  rw [← himage, ← AddMonoidHom.map_mclosure]
  exact (mem_map_iff_mem Subtype.val_injective).symm

/-- Membership in the additive closure of a family `f` indexed by a subset `t` and valued in a
submonoid `p`, restricted to the indices in `s`, can be read in the ambient monoid: it is
membership in the additive closure of any family `g` on all indices that extends the values of `f`,
restricted to the indices in `s ∩ t`. -/
theorem mem_closure_image_preimage_val_iff {ι B S : Type*} [AddMonoid B] [SetLike S B]
    [AddSubmonoidClass S B] {p : S} {t : Set ι} {f : t → p} {g : ι → B}
    (hfg : ∀ i, (f i : B) = g i) {s : Set ι} {x : p} :
    x ∈ closure (f '' (Subtype.val ⁻¹' s)) ↔ (x : B) ∈ closure (g '' (s ∩ t)) := by
  rw [mem_closure_image_iff_coe (g := g ∘ Subtype.val) hfg, Set.image_comp,
    Subtype.image_preimage_coe, Set.inter_comm]

end AddSubmonoid
