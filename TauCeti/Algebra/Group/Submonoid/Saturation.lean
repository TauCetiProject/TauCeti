module

public import Mathlib.Algebra.Group.Submonoid.Saturation
public import Mathlib.LinearAlgebra.FreeModule.PID
public import TauCeti.Algebra.Group.Subgroup.PowSaturation

/-!
# Faces of monoids, positive-power invariance, and generated subgroups of faces

A face of an additive monoid `M` is an `AddSubmonoid` satisfying `AddSubmonoid.AddSaturated`
(`x + y ∈ F → x ∈ F ∧ y ∈ F`), bundled in Mathlib as `SaturatedAddSubmonoid M` (multiplicatively
`SaturatedSubmonoid M`). Every face is `NSMulSaturated`; when `M` is finitely generated, every face
is finitely generated and `SaturatedAddSubmonoid M` is finite.

Pullback along an injective homomorphism `f : M →+ N` whose image generates `N` up to positive
multiples induces an order isomorphism `SaturatedAddSubmonoid N ≃o SaturatedAddSubmonoid M`
(`SaturatedAddSubmonoid.comapOrderIsoOfNSMulSaturation`). In particular, saturating `S ≤ G` inside
`AddSubgroup.closure (S : Set G)` preserves the face lattice
(`AddSubmonoid.nsmulSaturationInfClosureFaceOrderIso`).

For `F : SaturatedAddSubmonoid S`, `F.faceSubgroup` is the subgroup of
`AddSubgroup.closure (S : Set G)` generated by `F`. It meets `S` in `F`, reflects and preserves
order, and under positive-multiple saturation in `AddSubgroup.closure (S : Set G)` is replaced by
`F.faceSubgroup.nsmulSaturation`, in which `F.faceSubgroup` has torsion (and, when `S.FG`, finite)
quotient.

## Main declarations

* `Submonoid.MulSaturated.comap`, `SaturatedSubmonoid.comap`: pullback of faces.
* `SaturatedSubmonoid.powSaturated`, `SaturatedSubmonoid.instFG`,
  `SaturatedSubmonoid.instFinite`: positive-power saturation and finiteness for FG monoids.
* `SaturatedSubmonoid.comapOrderIsoOfPowSaturation` and
  `AddSubmonoid.nsmulSaturationInfClosureFaceOrderIso`: invariance of faces under positive-multiple
  saturation.
* `SaturatedAddSubmonoid.faceSubgroup`, `SaturatedAddSubmonoid.toFaceSubgroup`, and
  `SaturatedAddSubmonoid.faceSubgroupNSMulSaturationEquiv`: generated face subgroups and
  identification under positive-multiple saturation.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 2.
* W. Fulton, *Introduction to Toric Varieties*, §1.2.
-/

public section

namespace Submonoid.MulSaturated

/-- Pulling back a `MulSaturated` submonoid along a monoid hom is `MulSaturated`. -/
@[to_additive
/-- Pulling back an `AddSaturated` additive submonoid along an add-monoid hom is `AddSaturated`. -/]
theorem comap {M N : Type*} [MulOneClass M] [MulOneClass N] {s : Submonoid N}
    (hs : s.MulSaturated) (f : M →* N) : (s.comap f).MulSaturated :=
  fun _ _ hxy ↦ hs (by simpa only [mem_comap, map_mul] using hxy)

/-- A `MulSaturated` submonoid of a monoid generated by `t` is generated by `t ∩ s`. -/
@[to_additive
/-- An `AddSaturated` additive submonoid of an additive monoid generated by `t` is generated by
`t ∩ s`. -/]
theorem eq_closure_inter_of_closure_eq {M : Type*} [Monoid M] {s : Submonoid M}
    (hs : s.MulSaturated) {t : Set M} (ht : Submonoid.closure t = ⊤) :
    s = Submonoid.closure (t ∩ s) := by
  refine le_antisymm (fun x hx ↦ ?_) (Submonoid.closure_le.2 Set.inter_subset_right)
  have hxt : x ∈ Submonoid.closure t := ht ▸ mem_top x
  induction hxt using Submonoid.closure_induction with
  | mem y hy => exact Submonoid.subset_closure ⟨hy, hx⟩
  | one => exact one_mem _
  | mul y z _ _ ihy ihz => exact mul_mem (ihy (hs hx).1) (ihz (hs hx).2)

end Submonoid.MulSaturated

namespace SaturatedSubmonoid

section Pullback

variable {M N P : Type*} [MulOneClass M] [MulOneClass N] [MulOneClass P]

/-- Pullback of a bundled saturated submonoid along a monoid homomorphism. -/
@[to_additive
/-- Pullback of a bundled saturated additive submonoid along an additive monoid homomorphism. -/]
def comap (f : M →* N) (F : SaturatedSubmonoid N) : SaturatedSubmonoid M where
  toSubmonoid := F.toSubmonoid.comap f
  mulSaturated := F.mulSaturated.comap f

/-- The underlying submonoid of `F.comap f` is `F.toSubmonoid.comap f`. -/
@[to_additive (attr := simp)
/-- The underlying additive submonoid of `F.comap f` is `F.toAddSubmonoid.comap f`. -/]
theorem toSubmonoid_comap (f : M →* N) (F : SaturatedSubmonoid N) :
    (F.comap f).toSubmonoid = F.toSubmonoid.comap f := (rfl)

/-- Membership in `F.comap f` is membership of the image in `F`. -/
@[to_additive (attr := simp)
/-- Membership in `F.comap f` is membership of the image in `F`. -/]
theorem mem_comap {f : M →* N} {F : SaturatedSubmonoid N} {x : M} :
    x ∈ F.comap f ↔ f x ∈ F := Iff.rfl

/-- The carrier set of `F.comap f` is the preimage `f ⁻¹' F`. -/
@[to_additive (attr := simp)
/-- The carrier set of `F.comap f` is the preimage `f ⁻¹' F`. -/]
theorem coe_comap (f : M →* N) (F : SaturatedSubmonoid N) : (F.comap f : Set M) = f ⁻¹' F := (rfl)

/-- Pullback along the identity monoid homomorphism is the identity. -/
@[to_additive (attr := simp)
/-- Pullback along the identity additive monoid homomorphism is the identity. -/]
theorem comap_id (F : SaturatedSubmonoid M) : F.comap (.id M) = F := ext rfl

/-- Pullback of saturated submonoids is contravariantly functorial. -/
@[to_additive
/-- Pullback of saturated additive submonoids is contravariantly functorial. -/]
theorem comap_comp (g : N →* P) (f : M →* N) (F : SaturatedSubmonoid P) :
    F.comap (g.comp f) = (F.comap g).comap f := ext rfl

/-- Pullback of saturated submonoids is monotone. -/
@[to_additive (attr := gcongr)
/-- Pullback of saturated additive submonoids is monotone. -/]
theorem comap_mono {f : M →* N} {F₁ F₂ : SaturatedSubmonoid N} (h : F₁ ≤ F₂) :
    F₁.comap f ≤ F₂.comap f := fun _ hx ↦ h hx

/-- Inclusion of saturated submonoids is equivalent to inclusion of their underlying submonoids. -/
@[to_additive (attr := simp)
/-- Inclusion of saturated additive submonoids is equivalent to inclusion of their underlying
additive submonoids. -/]
theorem toSubmonoid_le_iff {F₁ F₂ : SaturatedSubmonoid M} :
    F₁.toSubmonoid ≤ F₂.toSubmonoid ↔ F₁ ≤ F₂ := Iff.rfl

end Pullback

section Monoid

variable {M : Type*} [Monoid M]

/-- Every bundled saturated submonoid of a monoid is `PowSaturated`. -/
@[to_additive
/-- Every bundled saturated additive submonoid of an additive monoid is `NSMulSaturated`. -/]
theorem powSaturated (F : SaturatedSubmonoid M) : F.toSubmonoid.PowSaturated :=
  F.mulSaturated.powSaturated

/-- Every saturated submonoid of a finitely generated monoid is finitely generated. -/
@[to_additive
/-- Every saturated additive submonoid of a finitely generated additive monoid is FG. -/]
theorem fg_toSubmonoid [Monoid.FG M] (F : SaturatedSubmonoid M) : F.toSubmonoid.FG := by
  obtain ⟨t, ht, hfin⟩ := Monoid.fg_iff.1 ‹Monoid.FG M›
  exact (Submonoid.fg_iff F.toSubmonoid).2
    ⟨t ∩ F, (F.mulSaturated.eq_closure_inter_of_closure_eq ht).symm,
      hfin.subset Set.inter_subset_left⟩

/-- Every saturated submonoid of a finitely generated monoid is finitely generated. -/
@[to_additive
/-- Every saturated additive submonoid of a finitely generated additive monoid is FG. -/]
instance instFG [Monoid.FG M] (F : SaturatedSubmonoid M) : Monoid.FG F :=
  (Monoid.fg_iff_submonoid_fg F.toSubmonoid).2 F.fg_toSubmonoid

/-- A finitely generated monoid has only finitely many saturated submonoids. -/
@[to_additive
/-- A finitely generated additive monoid has only finitely many saturated additive submonoids. -/]
instance instFinite [Monoid.FG M] : Finite (SaturatedSubmonoid M) := by
  obtain ⟨t, ht, hfin⟩ := Monoid.fg_iff.1 ‹Monoid.FG M›
  have : Finite t := hfin.to_subtype
  refine Finite.of_injective (fun F : SaturatedSubmonoid M ↦ ((↑) : t → M) ⁻¹' F) fun F K h ↦ ?_
  apply ext
  rw [F.mulSaturated.eq_closure_inter_of_closure_eq ht,
    K.mulSaturated.eq_closure_inter_of_closure_eq ht]
  exact congrArg Submonoid.closure (Subtype.preimage_coe_eq_preimage_coe_iff.1 h)

end Monoid

section PowSaturation

variable {M N : Type*} [CommMonoid M] [CommMonoid N]

/-- Pushforward of a saturated submonoid along an injective monoid homomorphism whose image
generates the target up to positive powers, followed by positive-power saturation. -/
@[to_additive
/-- Pushforward of a saturated additive submonoid along an injective additive monoid homomorphism
whose image generates the target up to positive multiples, followed by positive-multiple
saturation. -/]
def mapPowSaturation {f : M →* N} (hf : Function.Injective f)
    (hsurj : ∀ y : N, ∃ n, 0 < n ∧ y ^ n ∈ MonoidHom.mrange f) (F : SaturatedSubmonoid M) :
    SaturatedSubmonoid N where
  toSubmonoid := (F.toSubmonoid.map f).powSaturation
  mulSaturated := .of_left fun y₁ y₂ hprod ↦ by
    obtain ⟨k, hk, hkprod⟩ := Submonoid.mem_powSaturation.1 hprod
    obtain ⟨z, hzF, hfz⟩ := Submonoid.mem_map.1 hkprod
    obtain ⟨n₁, hn₁, x₁, hx₁⟩ := hsurj y₁
    obtain ⟨n₂, hn₂, x₂, hx₂⟩ := hsurj y₂
    have heq : f (x₁ ^ (k * n₂) * x₂ ^ (k * n₁)) = f (z ^ (n₁ * n₂)) := by
      simp only [map_mul, map_pow, hx₁, hx₂, ← pow_mul]
      rw [show n₁ * (k * n₂) = k * (n₁ * n₂) by ring,
        show n₂ * (k * n₁) = k * (n₁ * n₂) by ring, ← mul_pow, pow_mul, ← hfz]
    have hx₁F : x₁ ∈ F := (F.powSaturated ((F.mulSaturated
      (hf heq ▸ pow_mem hzF (n₁ * n₂))).1)).resolve_left (Nat.mul_pos hk hn₂).ne'
    exact Submonoid.mem_powSaturation.2 ⟨n₁, hn₁, Submonoid.mem_map.2 ⟨x₁, hx₁F, hx₁⟩⟩

/-- The underlying submonoid of `mapPowSaturation hf hsurj F` is
`(F.toSubmonoid.map f).powSaturation`. -/
@[to_additive (attr := simp)
/-- The underlying additive submonoid of `mapNSMulSaturation hf hsurj F` is
`(F.toAddSubmonoid.map f).nsmulSaturation`. -/]
theorem toSubmonoid_mapPowSaturation {f : M →* N} (hf : Function.Injective f)
    (hsurj : ∀ y : N, ∃ n, 0 < n ∧ y ^ n ∈ MonoidHom.mrange f) (F : SaturatedSubmonoid M) :
    (F.mapPowSaturation hf hsurj).toSubmonoid = (F.toSubmonoid.map f).powSaturation := (rfl)

/-- Membership in `mapPowSaturation hf hsurj F` holds iff some positive power lies in `f '' F`. -/
@[to_additive
/-- Membership in `mapNSMulSaturation` holds iff some positive multiple lies in `f '' F`. -/]
theorem mem_mapPowSaturation {f : M →* N} {hf : Function.Injective f}
    {hsurj : ∀ y : N, ∃ n, 0 < n ∧ y ^ n ∈ MonoidHom.mrange f} {F : SaturatedSubmonoid M} {y : N} :
    y ∈ F.mapPowSaturation hf hsurj ↔ ∃ n, 0 < n ∧ y ^ n ∈ F.toSubmonoid.map f :=
  Submonoid.mem_powSaturation

/-- Pullback along an injective homomorphism whose image generates `N` up to positive powers gives
an order isomorphism between the face lattices of `N` and `M`. -/
@[to_additive
/-- Pullback along an injective additive homomorphism whose image generates `N` up to positive
multiples gives an order isomorphism between the face lattices of `N` and `M`. -/]
def comapOrderIsoOfPowSaturation {f : M →* N} (hf : Function.Injective f)
    (hsurj : ∀ y : N, ∃ n, 0 < n ∧ y ^ n ∈ MonoidHom.mrange f) :
    SaturatedSubmonoid N ≃o SaturatedSubmonoid M where
  toFun := comap f
  invFun := mapPowSaturation hf hsurj
  left_inv K := ext' fun y ↦ by
    rw [mem_mapPowSaturation]
    refine ⟨fun ⟨n, hn, hmap⟩ ↦ ?_, fun hy ↦ ?_⟩
    · obtain ⟨x, hx, hfx⟩ := Submonoid.mem_map.1 hmap
      exact (K.powSaturated (hfx ▸ hx)).resolve_left hn.ne'
    · obtain ⟨n, hn, x, hx⟩ := hsurj y
      exact ⟨n, hn, Submonoid.mem_map.2 ⟨x, by simpa [hx] using pow_mem hy n, hx⟩⟩
  right_inv F := ext' fun x ↦ by
    rw [mem_comap, mem_mapPowSaturation]
    refine ⟨fun ⟨n, hn, hmap⟩ ↦ ?_,
      fun hx ↦ ⟨1, Nat.one_pos, Submonoid.mem_map.2 ⟨x, hx, (pow_one (f x)).symm⟩⟩⟩
    obtain ⟨z, hzF, hfz⟩ := Submonoid.mem_map.1 hmap
    exact (F.powSaturated (hf (map_pow f x n ▸ hfz) ▸ hzF)).resolve_left hn.ne'
  map_rel_iff' {K₁ K₂} := ⟨fun h y hy ↦ by
    obtain ⟨n, hn, x, hx⟩ := hsurj y
    exact (K₂.powSaturated (hx ▸ h (by simpa [hx] using pow_mem hy n))).resolve_left hn.ne',
    comap_mono⟩

/-- Applying `comapOrderIsoOfPowSaturation` computes `comap f`. -/
@[to_additive (attr := simp)
/-- Applying `comapOrderIsoOfNSMulSaturation` computes `comap f`. -/]
theorem comapOrderIsoOfPowSaturation_apply {f : M →* N} (hf : Function.Injective f)
    (hsurj : ∀ y : N, ∃ n, 0 < n ∧ y ^ n ∈ MonoidHom.mrange f) (K : SaturatedSubmonoid N) :
    comapOrderIsoOfPowSaturation hf hsurj K = K.comap f := (rfl)

/-- Applying `(comapOrderIsoOfPowSaturation hf hsurj).symm` computes `mapPowSaturation`. -/
@[to_additive (attr := simp)
/-- Applying `(comapOrderIsoOfNSMulSaturation hf hsurj).symm` computes `mapNSMulSaturation`. -/]
theorem comapOrderIsoOfPowSaturation_symm_apply {f : M →* N} (hf : Function.Injective f)
    (hsurj : ∀ y : N, ∃ n, 0 < n ∧ y ^ n ∈ MonoidHom.mrange f) (F : SaturatedSubmonoid M) :
    (comapOrderIsoOfPowSaturation hf hsurj).symm F = F.mapPowSaturation hf hsurj := (rfl)

end PowSaturation

end SaturatedSubmonoid

namespace AddSubmonoid

variable {G : Type*} [AddCommGroup G] (S : AddSubmonoid G)

/-- Saturating `S` inside `AddSubgroup.closure (S : Set G)` induces an order isomorphism on face
lattices via pullback along the canonical inclusion. -/
def nsmulSaturationInfClosureFaceOrderIso :
    SaturatedAddSubmonoid
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid) ≃o
      SaturatedAddSubmonoid S :=
  SaturatedAddSubmonoid.comapOrderIsoOfNSMulSaturation
    (inclusion_injective (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure))
    fun y ↦ by
      obtain ⟨n, hn, hny⟩ := mem_nsmulSaturation.1 y.property.1
      exact ⟨n, hn, ⟨n • y.val, hny⟩, rfl⟩

/-- Pulling back a face of the saturation of `S` in `AddSubgroup.closure S` computes `comap`. -/
@[simp]
theorem nsmulSaturationInfClosureFaceOrderIso_apply
    (K : SaturatedAddSubmonoid
      ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)) :
    S.nsmulSaturationInfClosureFaceOrderIso K =
      K.comap (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)) := (rfl)

/-- Membership in `(S.nsmulSaturationInfClosureFaceOrderIso).symm F` holds iff some positive
multiple lies in the image of `F` under the canonical inclusion. -/
@[simp]
theorem mem_nsmulSaturationInfClosureFaceOrderIso_symm (F : SaturatedAddSubmonoid S)
    {y : ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid)} :
    y ∈ (S.nsmulSaturationInfClosureFaceOrderIso).symm F ↔
      ∃ n, 0 < n ∧ n • y ∈ F.toAddSubmonoid.map
        (inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)) := by
  rw [nsmulSaturationInfClosureFaceOrderIso,
    SaturatedAddSubmonoid.comapOrderIsoOfNSMulSaturation_symm_apply]
  exact SaturatedAddSubmonoid.mem_mapNSMulSaturation

end AddSubmonoid

namespace SaturatedAddSubmonoid

variable {G : Type*} [AddCommGroup G] {S : AddSubmonoid G}

/-- For a face `F : SaturatedAddSubmonoid S`, `F.faceSubgroup` is the subgroup of
`AddSubgroup.closure (S : Set G)` generated by the image of `F` under `S.toGroupClosure`. -/
def faceSubgroup (F : SaturatedAddSubmonoid S) :
    AddSubgroup (AddSubgroup.closure (S : Set G)) :=
  AddSubgroup.closure (S.toGroupClosure '' (F : Set S))

/-- Explicit definition of `SaturatedAddSubmonoid.faceSubgroup`. -/
theorem faceSubgroup_def (F : SaturatedAddSubmonoid S) :
    F.faceSubgroup = AddSubgroup.closure (S.toGroupClosure '' (F : Set S)) := (rfl)

/-- The canonical additive homomorphism from a face `F` of `S` into `F.faceSubgroup`. -/
def toFaceSubgroup (F : SaturatedAddSubmonoid S) : F →+ F.faceSubgroup :=
  (S.toGroupClosure.comp F.toAddSubmonoid.subtype).codRestrict F.faceSubgroup fun a ↦
    AddSubgroup.subset_closure ⟨a, a.property, rfl⟩

/-- `F.toFaceSubgroup` agrees with `S.toGroupClosure` inside `AddSubgroup.closure (S : Set G)`. -/
@[simp]
theorem coe_toFaceSubgroup (F : SaturatedAddSubmonoid S) (a : F) :
    (F.toFaceSubgroup a : AddSubgroup.closure (S : Set G)) = S.toGroupClosure a := (rfl)

/-- Composing `F.toFaceSubgroup` with `F.faceSubgroup.subtype` yields
`S.toGroupClosure.comp F.toAddSubmonoid.subtype`. -/
@[simp]
theorem subtype_comp_toFaceSubgroup (F : SaturatedAddSubmonoid S) :
    F.faceSubgroup.subtype.comp F.toFaceSubgroup =
      S.toGroupClosure.comp F.toAddSubmonoid.subtype := (rfl)

/-- `F.toFaceSubgroup` is injective. -/
theorem toFaceSubgroup_injective (F : SaturatedAddSubmonoid S) :
    Function.Injective F.toFaceSubgroup :=
  ((S.toGroupClosure.comp F.toAddSubmonoid.subtype).injective_codRestrict _ _).2
    (S.toGroupClosure_injective.comp F.toAddSubmonoid.subtype_injective)

/-- `F.faceSubgroup` is monotone in `F`. -/
@[gcongr]
theorem faceSubgroup_mono {F₁ F₂ : SaturatedAddSubmonoid S} (h : F₁ ≤ F₂) :
    F₁.faceSubgroup ≤ F₂.faceSubgroup := AddSubgroup.closure_mono (Set.image_mono h)

/-- An element of `AddSubgroup.closure (S : Set G)` belongs to `F.faceSubgroup` iff it is a
difference of two elements of `F`. -/
theorem mem_faceSubgroup_iff (F : SaturatedAddSubmonoid S)
    {g : AddSubgroup.closure (S : Set G)} :
    g ∈ F.faceSubgroup ↔ ∃ a b : F, g = S.toGroupClosure a - S.toGroupClosure b := by
  have heq : F.faceSubgroup =
      AddSubgroup.closure ((F.toAddSubmonoid.map S.toGroupClosure : AddSubmonoid _) : Set _) := rfl
  rw [heq, (F.toAddSubmonoid.map S.toGroupClosure).mem_groupClosure_iff]
  exact ⟨fun ⟨⟨_, a, ha, rfl⟩, ⟨_, b, hb, rfl⟩, h⟩ ↦ ⟨⟨a, ha⟩, ⟨b, hb⟩, h⟩,
    fun ⟨a, b, h⟩ ↦ ⟨⟨_, a, a.property, rfl⟩, ⟨_, b, b.property, rfl⟩, h⟩⟩

/-- Every element of `F.faceSubgroup` can be shifted into `F` by an element of `F`. -/
theorem exists_add_toFaceSubgroup_eq (F : SaturatedAddSubmonoid S) (g : F.faceSubgroup) :
    ∃ a b : F, g + F.toFaceSubgroup b = F.toFaceSubgroup a := by
  obtain ⟨a, b, hab⟩ := F.mem_faceSubgroup_iff.1 g.property
  exact ⟨a, b, Subtype.ext (by simpa using eq_sub_iff_add_eq.1 hab)⟩

/-- If `F` is finitely generated, then `F.faceSubgroup` is finitely generated. -/
theorem fg_faceSubgroup (F : SaturatedAddSubmonoid S) (hF : F.toAddSubmonoid.FG) :
    F.faceSubgroup.FG := (hF.map S.toGroupClosure).addSubgroupClosure

/-- An element of `S` maps into `F.faceSubgroup` iff it belongs to `F`. -/
@[simp]
theorem toGroupClosure_mem_faceSubgroup_iff (F : SaturatedAddSubmonoid S) {s : S} :
    S.toGroupClosure s ∈ F.faceSubgroup ↔ s ∈ F := by
  refine ⟨fun hs ↦ ?_, fun hs ↦ AddSubgroup.subset_closure ⟨s, hs, rfl⟩⟩
  obtain ⟨a, b, hab⟩ := F.mem_faceSubgroup_iff.1 hs
  have hsb : s + b.val = a.val :=
    S.toGroupClosure_injective (by simpa [map_add] using (sub_eq_iff_eq_add.1 hab.symm).symm)
  exact (F.addSaturated (hsb ▸ a.property)).1

/-- Inclusion of faces of `S` is equivalent to inclusion of their generated subgroups inside
`AddSubgroup.closure (S : Set G)`. -/
@[simp]
theorem faceSubgroup_le_faceSubgroup_iff {F₁ F₂ : SaturatedAddSubmonoid S} :
    F₁.faceSubgroup ≤ F₂.faceSubgroup ↔ F₁ ≤ F₂ :=
  ⟨fun h _ hs ↦ F₂.toGroupClosure_mem_faceSubgroup_iff.1
    (h (F₁.toGroupClosure_mem_faceSubgroup_iff.2 hs)), faceSubgroup_mono⟩

/-- Helper for the `≥` inclusion in `closure_nsmulSaturationInfClosure_eq_nsmulSaturation`:
given `n > 0` with `n • z ∈ F.faceSubgroup`, shifting `z` by an element `b ∈ F` places `z + b`
and `b` inside the saturated face `(S.nsmulSaturationInfClosureFaceOrderIso).symm F`. -/
private theorem mem_closure_nsmulSaturationInfClosure_of_mem_nsmulSaturation
    (F : SaturatedAddSubmonoid S) {z : AddSubgroup.closure (S : Set G)}
    (hz : z ∈ F.faceSubgroup.nsmulSaturation) :
    z ∈ AddSubgroup.closure
      (S.nsmulSaturationInfClosureToGroupClosure ''
        (((S.nsmulSaturationInfClosureFaceOrderIso).symm F : SaturatedAddSubmonoid _) :
          Set _)) := by
  let inc := AddSubmonoid.inclusion (le_inf S.le_nsmulSaturation AddSubgroup.subset_closure)
  obtain ⟨n, hn, hnz⟩ := (AddSubgroup.mem_nsmulSaturation _).1 hz
  obtain ⟨a, b, hab⟩ := F.mem_faceSubgroup_iff.1 hnz
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn.ne'
  -- Clear the difference `n • z = a - b` by shifting `z` by `b`: `(k + 1) • (z + b) = a + k • b`.
  have hzb : (k + 1) • (z + S.toGroupClosure b.val).val = (a.val : G) + (k • b.val : S) := by
    have h1 : (k + 1) • (z + S.toGroupClosure b.val) =
        S.toGroupClosure a.val + k • S.toGroupClosure b.val := by
      rw [smul_add, hab, succ_nsmul']; abel
    simpa [map_add, map_nsmul] using congrArg Subtype.val h1
  let w : ↥(S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid) :=
    ⟨(z + S.toGroupClosure b.val).val,
      ⟨AddSubmonoid.mem_nsmulSaturation.2
        ⟨k + 1, Nat.succ_pos k, hzb ▸ add_mem a.val.property (nsmul_mem b.val.property k)⟩,
        (z + S.toGroupClosure b.val).property⟩⟩
  have hw : w ∈ (S.nsmulSaturationInfClosureFaceOrderIso).symm F :=
    (S.mem_nsmulSaturationInfClosureFaceOrderIso_symm F).2
      ⟨k + 1, Nat.succ_pos k, AddSubmonoid.mem_map.2
        ⟨a.val + k • b.val, add_mem a.property (nsmul_mem b.property k), Subtype.ext hzb.symm⟩⟩
  have hb : inc b.val ∈ (S.nsmulSaturationInfClosureFaceOrderIso).symm F :=
    (S.mem_nsmulSaturationInfClosureFaceOrderIso_symm F).2
      ⟨1, Nat.one_pos, AddSubmonoid.mem_map.2 ⟨b.val, b.property, (one_nsmul (inc b.val)).symm⟩⟩
  -- Express `z = w - b` inside `AddSubgroup.closure S`.
  have hz_eq : z = S.nsmulSaturationInfClosureToGroupClosure w -
      S.nsmulSaturationInfClosureToGroupClosure (inc b.val) := Subtype.ext (by simp [w, inc])
  exact hz_eq ▸ sub_mem (AddSubgroup.subset_closure ⟨w, hw, rfl⟩)
    (AddSubgroup.subset_closure ⟨inc b.val, hb, rfl⟩)

/-- Under `S.nsmulSaturationInfClosureToGroupClosure`, the subgroup of
`AddSubgroup.closure (S : Set G)` generated by the face of the saturation
`S.nsmulSaturation ⊓ (AddSubgroup.closure S).toAddSubmonoid` corresponding to `F` equals the
subgroup saturation `F.faceSubgroup.nsmulSaturation`. -/
theorem closure_nsmulSaturationInfClosure_eq_nsmulSaturation (F : SaturatedAddSubmonoid S) :
    AddSubgroup.closure
      (S.nsmulSaturationInfClosureToGroupClosure ''
        (((S.nsmulSaturationInfClosureFaceOrderIso).symm F : SaturatedAddSubmonoid _) : Set _)) =
      F.faceSubgroup.nsmulSaturation := by
  refine le_antisymm ?_ fun _ hz ↦
    F.mem_closure_nsmulSaturationInfClosure_of_mem_nsmulSaturation hz
  -- `≤` direction: every generator has a positive multiple in `F`.
  rw [AddSubgroup.closure_le]
  rintro _ ⟨y, hy, rfl⟩
  obtain ⟨n, hn, hmap⟩ := (S.mem_nsmulSaturationInfClosureFaceOrderIso_symm F).1 hy
  obtain ⟨s, hsF, hfs⟩ := AddSubmonoid.mem_map.1 hmap
  refine (AddSubgroup.mem_nsmulSaturation _).2 ⟨n, hn, ?_⟩
  rw [← map_nsmul, ← hfs, S.nsmulSaturationInfClosureToGroupClosure_inclusion_apply]
  exact F.toGroupClosure_mem_faceSubgroup_iff.2 hsF

/-- Canonical additive equivalence between the face subgroup of the saturated face
`(S.nsmulSaturationInfClosureFaceOrderIso).symm F` and the subgroup saturation
`F.faceSubgroup.nsmulSaturation` inside `AddSubgroup.closure (S : Set G)`. -/
def faceSubgroupNSMulSaturationEquiv (F : SaturatedAddSubmonoid S) :
    ((S.nsmulSaturationInfClosureFaceOrderIso).symm F).faceSubgroup ≃+
      F.faceSubgroup.nsmulSaturation :=
  ((AddEquiv.addSubgroupCongr S.addSubgroupClosure_nsmulSaturation_inf_closure).addSubgroupMap
    ((S.nsmulSaturationInfClosureFaceOrderIso).symm F).faceSubgroup).trans
    (AddEquiv.addSubgroupCongr (by
      rw [faceSubgroup_def, AddMonoidHom.map_closure, ← Set.image_comp]
      convert F.closure_nsmulSaturationInfClosure_eq_nsmulSaturation using 3
      refine Subtype.ext ?_
      simp only [AddSubmonoid.coe_inf, AddSubgroup.coe_toAddSubmonoid, AddMonoidHom.coe_ofClass,
        Function.comp_apply, AddEquiv.addSubgroupCongr_apply,
        AddSubmonoid.coe_nsmulSaturationInfClosureToGroupClosure_apply]
      exact AddSubmonoid.coe_toGroupClosure _ _))

/-- `faceSubgroupNSMulSaturationEquiv` preserves the underlying element of the ambient group `G`. -/
theorem coe_faceSubgroupNSMulSaturationEquiv_apply (F : SaturatedAddSubmonoid S)
    (x : ((S.nsmulSaturationInfClosureFaceOrderIso).symm F).faceSubgroup) :
    ((F.faceSubgroupNSMulSaturationEquiv x : AddSubgroup.closure (S : Set G)) : G) =
      x.val.val := by
  simp [faceSubgroupNSMulSaturationEquiv]

/-- The inverse of `faceSubgroupNSMulSaturationEquiv` preserves the underlying element of the
ambient group `G`. -/
theorem coe_faceSubgroupNSMulSaturationEquiv_symm_apply (F : SaturatedAddSubmonoid S)
    (y : F.faceSubgroup.nsmulSaturation) :
    ((F.faceSubgroupNSMulSaturationEquiv.symm y).val.val : G) =
      ((y : AddSubgroup.closure (S : Set G)) : G) := by
  simpa using (F.coe_faceSubgroupNSMulSaturationEquiv_apply
    (F.faceSubgroupNSMulSaturationEquiv.symm y)).symm

/-- When `S` is finitely generated, `F.faceSubgroup` has finite quotient in its positive-multiple
saturation inside `AddSubgroup.closure (S : Set G)`. -/
theorem finite_quotient_nsmulSaturation_faceSubgroup (hS : S.FG) (F : SaturatedAddSubmonoid S) :
    Finite (F.faceSubgroup.nsmulSaturation ⧸
      F.faceSubgroup.addSubgroupOf F.faceSubgroup.nsmulSaturation) := by
  let L := AddSubgroup.closure (S : Set G)
  have : AddGroup.FG L := (AddGroup.fg_iff_addSubgroup_fg L).2 hS.addSubgroupClosure
  have : Module.Finite ℤ L := Module.Finite.iff_addGroup_fg.2 this
  have hfg : F.faceSubgroup.nsmulSaturation.FG := by
    rw [← F.faceSubgroup.nsmulSaturation.toIntSubmodule_toAddSubgroup]
    exact Submodule.fg_toAddSubgroup (IsNoetherian.noetherian _)
  exact F.faceSubgroup.finite_quotient_nsmulSaturation hfg

end SaturatedAddSubmonoid
