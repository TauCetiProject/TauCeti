module

public import Mathlib.Algebra.Group.Submonoid.Finsupp
public import Mathlib.Data.Finsupp.Weight
public import Mathlib.GroupTheory.Finiteness

import Mathlib.Algebra.Order.Ring.Int

/-!
# Integral degrees on finitely generated additive submonoids

An additive integral degree which is strictly positive on the nonzero elements of a finitely
generated submonoid has finite sublevel sets, and it dominates any other integral additive function
up to a natural constant. Neither a freeness nor a saturation assumption is needed, and the
ambient monoid need not be cancellative.

The finiteness argument parametrizes the submonoid generated by finitely many nonzero generators
by the coefficient vectors of `Finsupp.weight`; the weight of a vector, computed with the degrees of
the generators, is at most the cutoff, and `Finsupp.finite_of_nat_weight_le` bounds such vectors.
The domination is proved by induction on the generated submonoid.

Adapted from `Mei/Algebra/Group/AddSubmonoid/Degree.lean` in
[yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`3d2e9c869ee44c41ae9c7b5c6e2042898430d0ca`, released under Apache 2.0.
-/

public section

namespace AddSubmonoid

variable {M : Type*} [AddCommMonoid M]

/-- A strictly positive integral degree on a finitely generated additive submonoid has finite
cutoffs. The generating set may contain zero, and the ambient monoid need not be cancellative. -/
theorem FG.finite_setOf_degree_le {P : AddSubmonoid M} (hP : P.FG) (δ : M →+ ℤ)
    (hδ : ∀ x ∈ P, x ≠ 0 → 0 < δ x) (k : ℕ) :
    {x | x ∈ P ∧ δ x ≤ k}.Finite := by
  classical
  obtain ⟨s, hs⟩ := AddSubmonoid.isAddFG_iff.mp hP
  have hs' : closure ((s.erase 0 : Finset M) : Set M) = P := by
    simpa using (closure_sdiff_singleton_zero (s : Set M)).trans hs
  have hpos (x : s.erase 0) : 0 < δ x :=
    hδ x (hs' ▸ subset_closure x.2) (Finset.ne_of_mem_erase x.2)
  refine ((Finsupp.finite_of_nat_weight_le (fun x : s.erase 0 => (δ x).toNat)
    (fun x => by have := hpos x; omega) k).image
    (Finsupp.weight (fun x : s.erase 0 => (x : M)))).subset ?_
  rintro x ⟨hx, hle⟩
  rw [← hs', ← Subtype.range_coe (s := ((s.erase 0 : Finset M) : Set M)),
    mem_closure_range_iff] at hx
  obtain ⟨a, ha⟩ := hx
  have ha' : Finsupp.weight (fun x : s.erase 0 => (x : M)) a = x :=
    (Finsupp.weight_apply _ _).trans ha.symm
  refine ⟨a, ?_, ha'⟩
  have hweight : δ (Finsupp.weight (fun x : s.erase 0 => (x : M)) a) =
      (Finsupp.weight (fun x : s.erase 0 => (δ x).toNat) a : ℤ) := by
    simp only [Finsupp.weight_apply, Finsupp.sum, map_sum, map_nsmul, Nat.cast_sum,
      nsmul_eq_mul, Nat.cast_mul, Nat.cast_id, Int.toNat_of_nonneg (hpos _).le]
  rw [← ha', hweight] at hle
  exact_mod_cast hle

/-- On a finitely generated additive submonoid, a strictly positive integral degree dominates
any integral additive function by a natural multiple. No positivity is required of the other
function. -/
theorem FG.exists_degree_le_mul {P : AddSubmonoid M} (hP : P.FG) (δ ε : M →+ ℤ)
    (hε : ∀ x ∈ P, x ≠ 0 → 0 < ε x) :
    ∃ c : ℕ, ∀ x ∈ P, δ x ≤ c * ε x := by
  classical
  obtain ⟨s, hs⟩ := AddSubmonoid.isAddFG_iff.mp hP
  refine ⟨s.sup (fun x => (δ x).toNat), fun x hx => ?_⟩
  rw [← hs] at hx
  induction hx using closure_induction with
  | mem y hy =>
    by_cases hy0 : y = 0
    · simp [hy0]
    have hyP : y ∈ P := hs ▸ subset_closure hy
    have hpos := hε y hyP hy0
    have hbound := Finset.le_sup (f := fun x => (δ x).toNat) hy
    have hδ : δ y ≤ (s.sup (fun x => (δ x).toNat) : ℕ) := by omega
    exact hδ.trans (le_mul_of_one_le_right (by omega) (by omega))
  | zero => simp
  | add x y hx hy ihx ihy => simpa [mul_add] using add_le_add ihx ihy

end AddSubmonoid
