module

public import Mathlib.Algebra.Group.Pointwise.Set.Basic
public import Mathlib.Algebra.Group.Subsemigroup.Basic

/-!
# The subsemigroup generated by the inverses of a set

In a division monoid, inversion reverses products, so it carries the subsemigroup generated by a
set `s` onto the subsemigroup generated by `s⁻¹`. This is the subsemigroup companion of
`Submonoid.mem_closure_inv`. In additive form: the sums of negations of elements of `s` are the
negations of the sums of elements of `s`.

## Main results

* `Subsemigroup.mem_closure_inv`: `x` lies in the subsemigroup generated by `s⁻¹` if and only if
  `x⁻¹` lies in the subsemigroup generated by `s`.
* `AddSubsemigroup.mem_closure_neg`: the additive version.
-/

public section

open scoped Pointwise

namespace Subsemigroup

variable {G : Type*} [DivisionMonoid G]

/-- An element lies in the subsemigroup generated by the inverses of a set `s` if and only if its
inverse lies in the subsemigroup generated by `s`. -/
@[to_additive /-- An element lies in the additive subsemigroup generated by the negations of a set
`s` if and only if its negation lies in the additive subsemigroup generated by `s`. -/]
theorem mem_closure_inv (s : Set G) (x : G) : x ∈ closure s⁻¹ ↔ x⁻¹ ∈ closure s := by
  -- Inversion reverses products, so it carries the closure of `t⁻¹` into the closure of `t`.
  have key (t : Set G) (x : G) (hx : x ∈ closure t⁻¹) : x⁻¹ ∈ closure t := by
    induction hx using closure_induction with
    | mem x hx => exact subset_closure (Set.mem_inv.1 hx)
    | mul x y _ _ hx hy =>
      rw [mul_inv_rev]
      exact mul_mem hy hx
  refine ⟨key s x, fun hx => ?_⟩
  simpa using key s⁻¹ x⁻¹ (by simpa using hx)

end Subsemigroup
