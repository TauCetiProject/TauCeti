module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Lemmas

/-!
# `ℤ`-multiples of a non-torsion element

For an element `p` of an additive group that is not of finite additive order, the subgroup
`zmultiples p` of its `ℤ`-multiples is infinite cyclic: `n ↦ n • p` is an isomorphism
`ℤ ≃+ zmultiples p`. This generalizes Mathlib's `AddSubgroup.zmultiplesEquivInt`, which needs
the ambient group to be torsion-free. A homomorphism into a torsion-free additive group is
injective on `zmultiples p` whenever it is nonzero at `p`. If `n ↦ n • g` identifies `ℤ` with a
group `H`, then any element that an additive endomorphism of `H` sends to `g` is `g` up to a unit
of `ℤ`, and every surjective additive endomorphism of `H` is an involution. A homomorphism out of
an infinite cyclic group is injective as soon as some element has image of infinite order. Free
generation `n ↦ n • g` is transported along additive equivalences, and generation of the whole
group is transported along surjective additive maps.

## Main declarations

* `TauCeti.intEquivZMultiples`: the isomorphism `ℤ ≃+ zmultiples p` for a non-torsion `p`.
* `TauCeti.intEquivOpZMultiples`: the bijection `ℤ ≃ (zmultiples p).op`, under which `n` acts on
  the group by right translation by `n • p`.
* `TauCeti.zmultiples_apply_eq_top_of_surjective`: a surjective additive map sends a generator
  of the source to a generator of the target.
* `AddMonoidHom.comp_zmultiples_subtype_injective`: injectivity on a cyclic subgroup when
  its generator has nonzero image in a torsion-free group.
* `AddMonoidHom.exists_eq_units_smul_of_map_eq`: in an infinite cyclic group with generator `g`,
  an element sent to `g` by an additive endomorphism is a unit multiple of `g`.
* `AddMonoidHom.involutive_of_surjective`: a surjective additive endomorphism of an infinite cyclic
  group is `±1`, hence an involution.
* `AddMonoidHom.finite_of_surjective_of_map_eq_zero`: a quotient of `ℤ` by a subgroup containing a
  nonzero integer is finite.
* `AddMonoidHom.injective_of_addEquiv_int`: a homomorphism out of an infinite cyclic group is
  injective when it sends some element to an element of infinite order.
* `AddEquiv.bijective_zmultiplesHom_apply_iff`: `n ↦ n • f a` is bijective exactly when
  `n ↦ n • a` is, for an additive equivalence `f`.
* `AddSubgroup.natCast_mul_mem_zmultiples`: in a ring, `n r` lies in the subgroup generated by
  `r` for `n : ℕ`.
-/

public section

namespace TauCeti

open AddSubgroup

variable {G : Type*} [AddGroup G] {p : G}

/-- For an element `p` of infinite additive order, the subgroup `zmultiples p` is infinite
cyclic, identified with `ℤ` by `n ↦ n • p`. -/
noncomputable def intEquivZMultiples (hp : ¬ IsOfFinAddOrder p) : ℤ ≃+ zmultiples p :=
  (AddMonoidHom.ofInjective (f := zmultiplesHom G p)
    (injective_zsmul_iff_not_isOfFinAddOrder.2 hp)).trans
    (AddEquiv.addSubgroupCongr (range_zmultiplesHom p))

@[simp]
theorem intEquivZMultiples_apply (hp : ¬ IsOfFinAddOrder p) (n : ℤ) :
    (intEquivZMultiples hp n : G) = n • p :=
  (rfl)

@[simp]
theorem intEquivZMultiples_symm_mk_zsmul (hp : ¬ IsOfFinAddOrder p) (n : ℤ) :
    (intEquivZMultiples hp).symm ⟨n • p, zsmul_mem_zmultiples p n⟩ = n :=
  (intEquivZMultiples hp).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp]
theorem intEquivZMultiples_symm_zsmul (hp : ¬ IsOfFinAddOrder p) (a : zmultiples p) :
    (intEquivZMultiples hp).symm a • p = (a : G) := by
  rw [← intEquivZMultiples_apply hp, AddEquiv.apply_symm_apply]

/-- For an element `p` of infinite additive order, `n ↦ op (n • p)` identifies `ℤ` with the
opposite subgroup `(zmultiples p).op`, whose elements act on the group by right translation. -/
noncomputable def intEquivOpZMultiples (hp : ¬ IsOfFinAddOrder p) : ℤ ≃ (zmultiples p).op :=
  (intEquivZMultiples hp).toEquiv.trans (equivOp _)

@[simp]
theorem coe_intEquivOpZMultiples (hp : ¬ IsOfFinAddOrder p) (n : ℤ) :
    (intEquivOpZMultiples hp n : Gᵃᵒᵖ) = AddOpposite.op (n • p) :=
  (rfl)

/-- The integer `n` acts through `intEquivOpZMultiples` by right translation by `n • p`. -/
@[simp]
theorem intEquivOpZMultiples_vadd (hp : ¬ IsOfFinAddOrder p) (n : ℤ) (x : G) :
    intEquivOpZMultiples hp n +ᵥ x = x + n • p :=
  (rfl)

@[simp]
theorem intEquivOpZMultiples_symm_mk_zsmul_op (hp : ¬ IsOfFinAddOrder p) (n : ℤ) :
    (intEquivOpZMultiples hp).symm
      ⟨n • AddOpposite.op p, zsmul_mem (mem_op.2 (mem_zmultiples p)) n⟩ = n :=
  (intEquivOpZMultiples hp).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp]
theorem intEquivOpZMultiples_symm_zsmul (hp : ¬ IsOfFinAddOrder p) (a : (zmultiples p).op) :
    (intEquivOpZMultiples hp).symm a • p = (a : Gᵃᵒᵖ).unop := by
  rw [← AddOpposite.op_inj, ← coe_intEquivOpZMultiples hp, Equiv.apply_symm_apply,
    AddOpposite.op_unop]

/-- A surjective additive map sends an element whose `ℤ`-multiples exhaust the source to an element
whose `ℤ`-multiples exhaust the target. -/
theorem zmultiples_apply_eq_top_of_surjective {F H : Type*} [AddGroup H] [FunLike F G H]
    [AddMonoidHomClass F G H] {g : F} (hg : Function.Surjective g) (hp : zmultiples p = ⊤) :
    zmultiples (g p) = ⊤ := by
  rw [← AddMonoidHom.coe_ofClass g, ← AddMonoidHom.map_zmultiples, hp, ← AddMonoidHom.range_eq_map,
    AddMonoidHom.range_eq_top]
  exact hg

end TauCeti

namespace AddMonoidHom

/-- A homomorphism into a torsion-free additive group is injective on the subgroup generated
by any element with nonzero image. The source group need not be torsion-free. -/
theorem comp_zmultiples_subtype_injective {A B : Type*} [AddGroup A] [AddGroup B]
    [IsAddTorsionFree B] (f : A →+ B) {a : A} (ha : f a ≠ 0) :
    Function.Injective (f.comp (AddSubgroup.zmultiples a).subtype) := by
  rintro ⟨_, m, rfl⟩ ⟨_, n, rfl⟩ h
  obtain rfl : m = n := IsAddTorsionFree.zsmul_left_injective ha (by simpa using h)
  rfl

/-- If `k ↦ k • g` identifies `ℤ` with `H` and an additive endomorphism of `H` sends `x` to `g`,
then `g` is a unit multiple of `x`. -/
theorem exists_eq_units_smul_of_map_eq {H : Type*} [AddCommGroup H] (f : H →+ H) {g x : H}
    (hg : Function.Bijective fun k : ℤ ↦ k • g) (hx : f x = g) :
    ∃ ε : ℤˣ, g = (ε : ℤ) • x := by
  -- Write `x = m • g` and `f g = j • g`. Then `g = f x = (m * j) • g`, so `m * j = 1`.
  obtain ⟨m, rfl⟩ := hg.2 x
  obtain ⟨j, hj⟩ := hg.2 (f g)
  have hmj : m * j = 1 := hg.1 <| by
    simp only [mul_smul, hj, ← map_zsmul, hx, one_smul]
  exact ⟨Units.mkOfMulEqOne j m (by rw [mul_comm, hmj]), by simp [smul_smul, mul_comm j m, hmj]⟩

/-- If `k ↦ k • g` identifies `ℤ` with `H`, then a surjective additive endomorphism of `H` is
multiplication by a unit of `ℤ`, so it is an involution. -/
theorem involutive_of_surjective {H : Type*} [AddCommGroup H] (f : H →+ H) {g : H}
    (hg : Function.Bijective fun k : ℤ ↦ k • g) (hf : Function.Surjective f) :
    Function.Involutive f := by
  -- `f` multiplies the generator by a unit `ε`, and `ε = ±1`.
  obtain ⟨x, hx⟩ := hf g
  obtain ⟨ε, hε⟩ := f.exists_eq_units_smul_of_map_eq hg hx
  have hfg : f g = (ε : ℤ) • g := by
    conv_lhs => rw [hε]
    rw [map_zsmul, hx]
  intro y
  obtain ⟨k, rfl⟩ := hg.2 y
  rcases Int.units_eq_one_or ε with rfl | rfl <;> simp [hfg]

/-- **A quotient of `ℤ` by a nonzero subgroup is finite.** If `f : ℤ →+ H` is surjective and
`f k = 0` for some integer `k ≠ 0`, then `H` is finite: every element of `H` is the image of a
residue modulo `k`. -/
theorem finite_of_surjective_of_map_eq_zero {H : Type*} [AddGroup H] {f : ℤ →+ H}
    (hf : Function.Surjective f) {k : ℤ} (hk : k ≠ 0) (hfk : f k = 0) : Finite H := by
  refine Finite.of_surjective (fun j : Fin k.natAbs ↦ f j) fun d ↦ ?_
  obtain ⟨j, rfl⟩ := hf d
  have hr : 0 ≤ j % k := Int.emod_nonneg j hk
  refine ⟨⟨(j % k).toNat, by have := Int.emod_lt j hk; omega⟩, ?_⟩
  -- `j` and its residue modulo `k` differ by a multiple of `k`, which `f` kills.
  have hq : f (k * (j / k)) = 0 := by
    rw [mul_comm, ← smul_eq_mul, map_zsmul, hfk, smul_zero]
  conv_rhs => rw [← Int.emod_add_mul_ediv j k]
  simp [Int.toNat_of_nonneg hr, hq]

/-- A homomorphism out of an infinite cyclic group is injective as soon as it sends some element
to an element of infinite order. -/
theorem injective_of_addEquiv_int {Z N : Type*} [AddGroup Z] [AddGroup N] (f : Z →+ N)
    (e : Z ≃+ ℤ) {z₀ : Z} (hz₀ : Function.Injective fun c : ℤ ↦ c • f z₀) :
    Function.Injective f := by
  -- On `ℤ`, `f` is `c ↦ c • v` for `v` the image of the generator `e⁻¹ 1`.
  have hf : ∀ z, f z = e z • f (e.symm 1) := fun z ↦ by
    rw [← map_zsmul, ← map_zsmul, zsmul_one, Int.cast_id, e.symm_apply_apply]
  intro z z' h
  apply e.injective
  apply hz₀
  beta_reduce
  rw [hf z₀, smul_comm (e z), smul_comm (e z'), ← hf, ← hf, h]

end AddMonoidHom

namespace AddEquiv

/-- An additive equivalence `f` transports free generation: `n ↦ n • f a` is bijective exactly
when `n ↦ n • a` is. -/
theorem bijective_zmultiplesHom_apply_iff {A B : Type*} [AddGroup A] [AddGroup B] (f : A ≃+ B)
    (a : A) :
    Function.Bijective (zmultiplesHom B (f a)) ↔ Function.Bijective (zmultiplesHom A a) := by
  have h : ⇑(zmultiplesHom B (f a)) = f ∘ zmultiplesHom A a := by
    funext n
    rw [Function.comp_apply, zmultiplesHom_apply, zmultiplesHom_apply, map_zsmul]
  rw [h, EquivLike.comp_bijective]

end AddEquiv

namespace AddSubgroup

/-- A natural multiple `n r` of `r` lies in the subgroup generated by `r`. -/
@[simp]
theorem natCast_mul_mem_zmultiples {R : Type*} [Ring R] (r : R) (n : ℕ) :
    (n : R) * r ∈ zmultiples r := by
  simpa using intCast_mul_mem_zmultiples r n

end AddSubgroup
