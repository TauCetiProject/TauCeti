module

public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Algebra.Field.Basic
import Mathlib.Tactic.Group

/-!
# Rank-one Bruhat collection

The rank-one relations collect words in an additive root group, its coroot and a Weyl
representative into the two forms `x(a) h(s)` and `x(a) h(s) n x(b)`. This is an existence
statement: no faithfulness of the root or torus parametrizations, and no separation of the
two cells, is assumed. It applies equally to simply connected and adjoint realizations.

The hypotheses are the torus action, inversion of the coroot by `n`, its square, and the
rank-one exchange identity. They are verified for divided-power root groups in
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Weyl.Bruhat`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19–20 and Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §6.4.
-/

public section

namespace TauCeti

open Multiplicative

variable {K G : Type*} [Field K] [Group G]

private def rankOneForms (x : Multiplicative K →* G) (h : Kˣ →* G) (n g : G) : Prop :=
  (∃ a s, g = x (ofAdd a) * h s) ∨ ∃ a s b, g = x (ofAdd a) * h s * n * x (ofAdd b)

private theorem rankOneForms_mul_torus (x : Multiplicative K →* G) (h : Kˣ →* G) (n : G)
    (hmove : ∀ s : Kˣ, ∀ r : K, h s * x (ofAdd r) = x (ofAdd ((s : K) ^ 2 * r)) * h s)
    (hn : ∀ s : Kˣ, n * h s = h s⁻¹ * n) {g : G} (hg : rankOneForms x h n g) (t : Kˣ) :
    rankOneForms x h n (g * h t) := by
  rcases hg with ⟨a, s, rfl⟩ | ⟨a, s, b, rfl⟩
  · exact Or.inl ⟨a, s * t, by simp [map_mul, mul_assoc]⟩
  · have hback : x (ofAdd b) * h t = h t * x (ofAdd (((t⁻¹ : Kˣ) : K) ^ 2 * b)) := by
      rw [hmove]
      simp
    refine Or.inr ⟨a, s * t⁻¹, ((t⁻¹ : Kˣ) : K) ^ 2 * b, ?_⟩
    calc
      _ = x (ofAdd a) * h s * (n * h t) *
          x (ofAdd (((t⁻¹ : Kˣ) : K) ^ 2 * b)) := by rw [mul_assoc _ (x (ofAdd b)), hback]; group
      _ = _ := by rw [hn, h.map_mul]; group

private theorem rankOneForms_mul_weyl (x : Multiplicative K →* G) (h : Kˣ →* G) (n : G)
    (hmove : ∀ s : Kˣ, ∀ r : K, h s * x (ofAdd r) = x (ofAdd ((s : K) ^ 2 * r)) * h s)
    (hsq : n * n = h (-1))
    (hexchange : ∀ u : Kˣ, n * x (ofAdd (u : K)) * n =
      x (ofAdd (-((u⁻¹ : Kˣ) : K))) * h (-u⁻¹) * n * x (ofAdd (-((u⁻¹ : Kˣ) : K))))
    {g : G} (hg : rankOneForms x h n g) : rankOneForms x h n (g * n) := by
  rcases hg with ⟨a, s, rfl⟩ | ⟨a, s, b, rfl⟩
  · exact Or.inr ⟨a, s, 0, by simp⟩
  · by_cases hb : b = 0
    · subst b
      refine Or.inl ⟨a, s * (-1), ?_⟩
      simp only [ofAdd_zero, map_one, mul_one, h.map_mul]
      rw [mul_assoc _ n n, hsq, mul_assoc]
    · let u : Kˣ := Units.mk0 b hb
      have hu : (u : K) = b := Units.val_mk0 hb
      refine Or.inr ⟨a + (s : K) ^ 2 * -((u⁻¹ : Kˣ) : K), s * (-u⁻¹),
        -((u⁻¹ : Kˣ) : K), ?_⟩
      calc
        _ = x (ofAdd a) * h s * (n * x (ofAdd (u : K)) * n) := by rw [hu]; group
        _ = (x (ofAdd a) * (h s * x (ofAdd (-((u⁻¹ : Kˣ) : K))))) *
            h (-u⁻¹) * n * x (ofAdd (-((u⁻¹ : Kˣ) : K))) := by rw [hexchange]; group
        _ = _ := by
          rw [hmove, ← mul_assoc, ← x.map_mul, ← ofAdd_add, h.map_mul]
          group

end TauCeti

namespace MonoidHom

open TauCeti Multiplicative

variable {K G : Type*} [Field K] [Group G]

/-- The rank-one relations give two Bruhat forms for the subgroup generated by a root group,
its coroot and a Weyl representative. This asserts existence, not uniqueness or disjointness. -/
theorem mem_closure_rankOne_iff (x : Multiplicative K →* G) (h : Kˣ →* G) (n : G)
    (hconj : ∀ s : Kˣ, ∀ r : K, h s * x (ofAdd r) * (h s)⁻¹ = x (ofAdd ((s : K) ^ 2 * r)))
    (hn : ∀ s : Kˣ, n * h s = h s⁻¹ * n)
    (hsq : n * n = h (-1))
    (hexchange : ∀ u : Kˣ, n * x (ofAdd (u : K)) * n =
      x (ofAdd (-((u⁻¹ : Kˣ) : K))) * h (-u⁻¹) * n *
        x (ofAdd (-((u⁻¹ : Kˣ) : K)))) (g : G) :
    g ∈ Subgroup.closure (Set.range x ∪ Set.range h ∪ {n}) ↔
      (∃ a s, g = x (ofAdd a) * h s) ∨
        ∃ a s b, g = x (ofAdd a) * h s * n * x (ofAdd b) := by
  have hmove (s : Kˣ) (r : K) : h s * x (ofAdd r) =
      x (ofAdd ((s : K) ^ 2 * r)) * h s := by rw [← hconj]; group
  have right_x {g : G} (hg : rankOneForms x h n g) (r : K) :
      rankOneForms x h n (g * x (ofAdd r)) := by
    rcases hg with ⟨a, s, rfl⟩ | ⟨a, s, b, rfl⟩
    · exact Or.inl ⟨a + (s : K) ^ 2 * r, s, by
        rw [mul_assoc, hmove, ← mul_assoc, ← map_mul, ← ofAdd_add]⟩
    · exact Or.inr ⟨a, s, b + r, by rw [mul_assoc, ← map_mul, ← ofAdd_add]⟩
  have right_h {g : G} := rankOneForms_mul_torus x h n hmove hn (g := g)
  have right_n {g : G} := rankOneForms_mul_weyl x h n hmove hsq hexchange (g := g)
  constructor
  · intro hg
    refine Subgroup.closure_induction_right (p := fun g _ => rankOneForms x h n g)
      (Or.inl ⟨0, 1, by simp⟩) ?_ ?_ hg
    · rintro g _ y ((⟨r, rfl⟩ | ⟨s, rfl⟩) | hy) hg
      · exact right_x hg (toAdd r)
      · exact right_h hg s
      · exact Set.mem_singleton_iff.mp hy ▸ right_n hg
    · rintro g _ y ((⟨r, rfl⟩ | ⟨s, rfl⟩) | hy) hg
      · simpa using right_x hg (-toAdd r)
      · simpa using right_h hg s⁻¹
      · have hninv : n⁻¹ = n * (h (-1))⁻¹ := by rw [← hsq]; group
        rw [Set.mem_singleton_iff.mp hy, hninv, ← mul_assoc, ← h.map_inv]
        exact right_h (right_n hg) _
  · have hx (a : K) : x (ofAdd a) ∈ Subgroup.closure (Set.range x ∪ Set.range h ∪ {n}) :=
      Subgroup.subset_closure (Or.inl (Or.inl ⟨_, rfl⟩))
    have hh (s : Kˣ) : h s ∈ Subgroup.closure (Set.range x ∪ Set.range h ∪ {n}) :=
      Subgroup.subset_closure (Or.inl (Or.inr ⟨_, rfl⟩))
    have hnmem : n ∈ Subgroup.closure (Set.range x ∪ Set.range h ∪ {n}) :=
      Subgroup.subset_closure (Or.inr rfl)
    rintro (⟨a, s, rfl⟩ | ⟨a, s, b, rfl⟩)
    · exact Subgroup.mul_mem _ (hx a) (hh s)
    · exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ (hx a) (hh s)) hnmem) (hx b)

end MonoidHom
