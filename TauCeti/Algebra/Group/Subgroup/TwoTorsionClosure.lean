module

public import Mathlib.Algebra.Group.Subgroup.Finite
public import Mathlib.Data.Set.Card
public import TauCeti.Algebra.BigOperators.Finset.SymmDiff

/-!
# Subgroups of an abelian group generated by finitely many involutions

Let `G` be a commutative group and `f : ι → G` a family whose values on a finite index set `s` are
involutions, `f i ^ 2 = 1`. The subgroup they generate is then the set of sub-products
`∏_{i ∈ S} f i` over the subsets `S ⊆ s` (`Finset.closure_image_eq_image_powerset`), so it has at
most `2 ^ #s` elements, with equality exactly when distinct subsets give distinct sub-products
(`Finset.natCard_closure_image_eq_two_pow_iff`). A single *relation* — a nonempty `R ⊆ s` with
`∏_{i ∈ R} f i = 1` — halves that count: replacing `S` by its symmetric difference `S ∆ R` leaves
the sub-product unchanged (`TauCeti.prod_symmDiff`) and toggles membership of a fixed `q ∈ R`, so
every value is already attained by a subset avoiding `q`
(`Finset.natCard_closure_image_le_two_pow_card_sub_one`).

This is the counting step of genus theory, where `f` runs over the classes of the primes above the
ramified rational primes of a quadratic field: those classes are involutions, and one relation
between them cuts the bound from `2 ^ t` to `2 ^ (t - 1)`. Both the ordinary class group
(`TauCeti.Multiquadratic.natCard_closure_image_classGroupMk0_le`) and the narrow class group
(`TauCeti.Multiquadratic.natCard_closure_image_narrowMk0_le`) consume it, with different relations.

## Main results

* `Finset.closure_image_eq_image_powerset`: the subgroup generated by involutions is the set of
  sub-products.
* `Finset.natCard_closure_image_eq_two_pow_iff`: that subgroup has exactly `2 ^ #s` elements if
  and only if there is no relation at all, that is, distinct subsets give distinct sub-products.
* `Finset.natCard_closure_image_le_two_pow_card_sub_one`: one relation bounds that subgroup by
  `2 ^ (#s - 1)` elements.
-/

public section

open scoped symmDiff

namespace Finset

variable {G ι : Type*} [CommGroup G]

/-- **A subgroup generated by involutions is the set of sub-products of its generators.** For a
family `f` of involutions indexed by a finite set `s`, the subgroup `⟨f i : i ∈ s⟩` consists exactly
of the products `∏_{i ∈ S} f i` over the subsets `S ⊆ s`. -/
theorem closure_image_eq_image_powerset (s : Finset ι) (f : ι → G) (hsq : ∀ i ∈ s, f i ^ 2 = 1) :
    (↑(Subgroup.closure (f '' (↑s : Set ι))) : Set G) =
      (fun S : Finset ι ↦ ∏ i ∈ S, f i) '' ↑s.powerset := by
  classical
  ext x
  constructor
  · intro hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
        obtain ⟨i, hi, rfl⟩ := hx
        exact ⟨{i}, by simpa, by simp⟩
    | one => exact ⟨∅, by simp, by simp⟩
    | mul x y _ _ hx hy =>
        obtain ⟨S, hS, rfl⟩ := hx
        obtain ⟨D, hD, rfl⟩ := hy
        rw [Finset.mem_coe, Finset.mem_powerset] at hS hD
        exact ⟨S ∆ D, Finset.mem_powerset.mpr (symmDiff_le_sup.trans (Finset.union_subset hS hD)),
          TauCeti.prod_symmDiff f fun i hi ↦ hsq i (hS (Finset.mem_inter.mp hi).1)⟩
    | inv x _ hx =>
        obtain ⟨S, hS, rfl⟩ := hx
        rw [Finset.mem_coe, Finset.mem_powerset] at hS
        refine ⟨S, by simpa, ?_⟩
        rw [eq_comm, inv_eq_iff_mul_eq_one, ← sq, ← Finset.prod_pow]
        exact Finset.prod_eq_one fun i hi ↦ hsq i (hS hi)
  · rintro ⟨S, hS, rfl⟩
    rw [Finset.mem_coe, Finset.mem_powerset] at hS
    exact (Subgroup.closure (f '' (↑s : Set ι))).prod_mem fun i hi ↦
      Subgroup.subset_closure ⟨i, hS hi, rfl⟩

/-- **A family of involutions generates a group of order `2 ^ #s` exactly when its sub-products
are distinct.** Let `f i` be an involution for each `i` in a finite index set `s`. Then the
subgroup generated by the `f i` for `i ∈ s` has exactly `2 ^ #s` elements if and only if distinct
subsets of `s` have distinct sub-products: that subgroup is the set of sub-products, indexed by
the `2 ^ #s` subsets of `s`. -/
theorem natCard_closure_image_eq_two_pow_iff (s : Finset ι) (f : ι → G)
    (hsq : ∀ i ∈ s, f i ^ 2 = 1) :
    Nat.card (Subgroup.closure (f '' (↑s : Set ι))) = 2 ^ s.card ↔
      Set.InjOn (fun S : Finset ι ↦ ∏ i ∈ S, f i) ↑s.powerset := by
  rw [← SetLike.coe_sort_coe, Nat.card_coe_set_eq, closure_image_eq_image_powerset s f hsq,
    ← Finset.card_powerset, ← Set.ncard_coe_finset, Set.ncard_image_iff]

/-- **One relation halves the number of sub-products of a family of involutions.** Let `f i` be an
involution for each `i` in a finite index set `s`, and suppose the sub-product over some nonempty
`R ⊆ s` is trivial. Then the subgroup generated by the `f i` for `i ∈ s` has at most `2 ^ (#s - 1)`
elements.

Fix `q ∈ R`. Replacing an index set `S` by its symmetric difference with `R` multiplies the
sub-product by the trivial `∏_{i ∈ R} f i`, so leaves it unchanged, while toggling whether `q`
belongs to the index set. Hence every sub-product is already attained by a subset of `s` avoiding
`q`, and there are `2 ^ (#s - 1)` such subsets. -/
theorem natCard_closure_image_le_two_pow_card_sub_one (s : Finset ι) (f : ι → G)
    (hsq : ∀ i ∈ s, f i ^ 2 = 1) {R : Finset ι} (hR : R ⊆ s) (hRne : R.Nonempty)
    (hrel : ∏ i ∈ R, f i = 1) :
    Nat.card (Subgroup.closure (f '' (↑s : Set ι))) ≤ 2 ^ (s.card - 1) := by
  classical
  obtain ⟨q, hq⟩ := hRne
  -- Every sub-product is already attained by a subset of `s` avoiding `q`.
  have hsub : (fun S : Finset ι ↦ ∏ i ∈ S, f i) '' ↑s.powerset ⊆
      (fun S : Finset ι ↦ ∏ i ∈ S, f i) '' ↑(s.erase q).powerset := by
    rintro x ⟨S, hSs, rfl⟩
    rw [Finset.mem_coe, Finset.mem_powerset] at hSs
    by_cases hqS : q ∈ S
    · refine ⟨S ∆ R, ?_, (TauCeti.prod_symmDiff f fun i hi ↦
        hsq i (hSs (Finset.mem_inter.mp hi).1)).trans (by rw [hrel, mul_one])⟩
      rw [Finset.mem_coe, Finset.mem_powerset, Finset.subset_erase]
      exact ⟨symmDiff_le_sup.trans (Finset.union_subset hSs hR),
        by simp [Finset.mem_symmDiff, hq, hqS]⟩
    · exact ⟨S, Finset.mem_coe.mpr <| Finset.mem_powerset.mpr <|
        Finset.subset_erase.mpr ⟨hSs, hqS⟩, rfl⟩
  rw [← SetLike.coe_sort_coe, Nat.card_coe_set_eq, closure_image_eq_image_powerset s f hsq]
  calc ((fun S : Finset ι ↦ ∏ i ∈ S, f i) '' ↑s.powerset).ncard
    _ ≤ ((fun S : Finset ι ↦ ∏ i ∈ S, f i) '' ↑(s.erase q).powerset).ncard :=
        Set.ncard_le_ncard hsub
    _ ≤ ((s.erase q).powerset : Set (Finset ι)).ncard := Set.ncard_image_le
    _ = 2 ^ (s.card - 1) := by
        rw [Set.ncard_coe_finset, Finset.card_powerset, Finset.card_erase_of_mem (hR hq)]

end Finset
