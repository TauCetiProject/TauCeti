module

public import Mathlib.Algebra.Group.Conj
public import Mathlib.Algebra.Group.End
public import Mathlib.Algebra.Group.Subgroup.Map

/-!
# The subgroup generated by the `n`-th powers

For a group `G` and a natural number `n`, the set of `n`-th powers is stable under conjugation,
because `(g x g⁻¹) ^ n = g x ^ n g⁻¹`. The subgroup `Gⁿ` it generates is therefore normal, even
when `G` is not commutative. Together with the commutator subgroup it cuts out the largest
abelian quotient of exponent dividing `n`; when `n` is prime, this quotient is elementary abelian.
-/

public section

namespace TauCeti

namespace Subgroup

/-- The subgroup generated by a conjugation-stable set is normal. -/
theorem normal_closure_of_conj_mem {G : Type*} [Group G] {s : Set G}
    (hs : ∀ g x, x ∈ s → g * x * g⁻¹ ∈ s) : (_root_.Subgroup.closure s).Normal := by
  have hle : ∀ g : G, (_root_.Subgroup.closure s).map (MulAut.conj g).toMonoidHom ≤
      _root_.Subgroup.closure s := by
    intro g
    rw [MonoidHom.map_closure, _root_.Subgroup.closure_le]
    rintro _ ⟨x, hx, rfl⟩
    exact _root_.Subgroup.subset_closure (hs g x hx)
  exact ⟨fun x hx g ↦
    MulAut.conj_apply g x ▸
      hle g (_root_.Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom hx)⟩

/-- The subgroup generated by the `n`-th powers of a group is normal: the set of `n`-th powers
is stable under conjugation. -/
theorem normal_closure_range_pow {G : Type*} [Group G] (n : ℕ) :
    (_root_.Subgroup.closure (Set.range fun g : G ↦ g ^ n)).Normal :=
  normal_closure_of_conj_mem fun g _ ↦ by
    rintro ⟨x, rfl⟩
    exact ⟨g * x * g⁻¹, by simp [conj_pow]⟩

end Subgroup

end TauCeti
