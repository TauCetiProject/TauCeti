module

public import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Tactic.Group

/-!
# Normalizer membership and normality tested on generators

Two criteria for a subgroup to be normal, each read off from a generating set.

A subgroup is normal as soon as its normalizer is everything, and the normalizer contains both the
subgroup itself and anything centralising it. So a subgroup `C` that is centralised elementwise by
a subgroup `P` with `C ⊔ P = ⊤` is normal. Mathlib has each ingredient
(`Subgroup.normalizer_eq_top_iff`, `Subgroup.le_normalizer`,
`Subgroup.centralizer_le_normalizer`) but not this combination.

The subgroup generated by a set that is stable under conjugation is normal: every element of the
group normalizes the subgroup as soon as it conjugates the generators into it
(`Subgroup.le_normalizer_closure_iff`).

A normal subgroup `Z` normalizing a subgroup `U` with `Z ∩ U = 1` commutes elementwise with `U`,
because each commutator lies in both, and hence with every conjugate of `U`. If the normal closure
of `U` and the normalizer of `U` together generate the group, then the conjugates of `U` by
elements of its normal closure already generate that normal closure.

An element normalizes the range of a group homomorphism when its conjugation action is induced
by a surjective change of parameters.

## Main results

* `TauCeti.normal_of_commute_of_sup_eq_top`: a subgroup centralised elementwise by a subgroup that
  joins with it to the whole group is normal.
* `Subgroup.closure_normal_of_forall_conj_mem`: the subgroup generated by a conjugation-stable set
  is normal.
* `Subgroup.normalClosure_le_centralizer_of_le_normalizer`: a normal subgroup normalizing `U` and
  meeting it trivially centralizes the normal closure of `U`.
* `Subgroup.normalClosure_subgroupOf_normalClosure_eq_top`: if the normal closure and the
  normalizer of `U` generate the group, then `U` normally generates its normal closure.
* `MonoidHom.mem_normalizer_range_of_surjective`: conjugation realizing a surjective change of
  parameters normalizes the range of a group homomorphism.
-/

public section

namespace TauCeti

open Subgroup

variable {G : Type*} [Group G]

/-- A subgroup centralised elementwise by a subgroup that joins with it to the whole group is
normal.

The commutation hypothesis is elementwise rather than `P ≤ centralizer C` because that is the form
a direct-product decomposition supplies; `C ⊔ P = ⊤` is weaker than `C` and `P` being complements,
which is what such a decomposition actually gives. -/
theorem normal_of_commute_of_sup_eq_top {C P : Subgroup G}
    (hcomm : ∀ c ∈ C, ∀ x ∈ P, Commute c x) (hsup : C ⊔ P = ⊤) : C.Normal := by
  -- `C` is normalised by itself and centralised by `P`, and the two generate `G`.
  rw [← normalizer_eq_top_iff, eq_top_iff, ← hsup]
  exact sup_le le_normalizer fun x hx =>
    centralizer_le_normalizer _ (mem_centralizer_iff.mpr fun c hc => hcomm c hc x hx)

/-- The subgroup generated by a set that is stable under conjugation is normal. -/
theorem _root_.Subgroup.closure_normal_of_forall_conj_mem {S : Set G}
    (h : ∀ g : G, ∀ s ∈ S, g * s * g⁻¹ ∈ S) : (closure S).Normal :=
  normalizer_eq_top_iff.mp <| top_le_iff.mp <|
    le_normalizer_closure_iff.mpr fun g _ s hs ↦ subset_closure (h g s hs)

/-- A normal subgroup `Z` that normalizes `U` and meets it trivially centralizes the normal closure
of `U`: each commutator `z u z⁻¹ u⁻¹` lies in both `Z` and `U`. -/
theorem _root_.Subgroup.normalClosure_le_centralizer_of_le_normalizer {Z U : Subgroup G}
    [Z.Normal] (hZ : Z ≤ normalizer (U : Set G)) (hZU : Disjoint Z U) :
    normalClosure (U : Set G) ≤ centralizer Z := by
  refine normalClosure_le_normal fun u hu ↦ mem_centralizer_iff.mpr fun z hz ↦ ?_
  have hZ' : z * u * z⁻¹ * u⁻¹ ∈ Z := by
    simpa only [mul_assoc] using mul_mem hz (‹Z.Normal›.conj_mem z⁻¹ (inv_mem hz) u)
  have hU' : z * u * z⁻¹ * u⁻¹ ∈ U :=
    mul_mem ((mem_normalizer_iff.mp (hZ hz) u).mp hu) (inv_mem hu)
  rw [← mul_inv_eq_iff_eq_mul, ← mul_inv_eq_one]
  exact (Subgroup.disjoint_def.mp hZU) hZ' hU'

open scoped Pointwise in
/-- If the normal closure of `U` and the normalizer of `U` generate `G`, then `U` already normally
generates its normal closure: every conjugate `k s u s⁻¹ k⁻¹` of `u ∈ U`, with `k` in the normal
closure and `s` normalizing `U`, is a conjugate of `s u s⁻¹ ∈ U` by an element of the normal
closure. -/
theorem _root_.Subgroup.normalClosure_subgroupOf_normalClosure_eq_top {U : Subgroup G}
    (h : normalClosure (U : Set G) ⊔ normalizer (U : Set G) = ⊤) :
    normalClosure ((U.subgroupOf (normalClosure (U : Set G)) : Subgroup _) :
      Set (normalClosure (U : Set G))) = ⊤ := by
  refine eq_top_iff.mpr fun ⟨x, hx⟩ _ ↦ ?_
  refine closure_induction (p := fun x hx ↦ (⟨x, hx⟩ : normalClosure (U : Set G)) ∈
      normalClosure ((U.subgroupOf (normalClosure (U : Set G)) : Subgroup _) :
        Set (normalClosure (U : Set G)))) (fun y hy ↦ ?_) (one_mem _)
      (fun _ _ _ _ hx hy ↦ mul_mem hx hy) (fun _ _ hx ↦ inv_mem hx) hx
  obtain ⟨u, hu, c, rfl⟩ : ∃ u ∈ U, ∃ c, c * u * c⁻¹ = y := by
    simpa only [Group.mem_conjugatesOfSet_iff, isConj_iff, SetLike.mem_coe] using hy
  obtain ⟨k, hk, s, hs, rfl⟩ : c ∈ (normalClosure (U : Set G) : Set G) *
      (normalizer (U : Set G) : Set G) := by
    rw [← normal_mul, h]
    exact mem_top c
  have hsu : s * u * s⁻¹ ∈ U := (mem_normalizer_iff.mp hs u).mp hu
  have heq : (⟨k * s * u * (k * s)⁻¹, conjugatesOfSet_subset_normalClosure hy⟩ :
      normalClosure (U : Set G)) =
      ⟨k, hk⟩ * ⟨s * u * s⁻¹, le_normalClosure hsu⟩ * ⟨k, hk⟩⁻¹ :=
    Subtype.ext (by simp only [coe_mul, coe_inv]; group)
  rw [heq]
  exact (normalClosure_normal).conj_mem _ (subset_normalClosure (mem_subgroupOf.mpr hsu)) _

end TauCeti

/-- An element normalizes the range of a group homomorphism if its conjugation action is induced
by a surjective map on the parameters. In particular, an involution on the parameters suffices. -/
theorem MonoidHom.mem_normalizer_range_of_surjective {P G : Type*} [Group P] [Group G]
    (T : P →* G) {σ : P → P} (hσ : Function.Surjective σ) {n : G}
    (hconj : ∀ s, n * T s * n⁻¹ = T (σ s)) : n ∈ Subgroup.normalizer T.range := by
  refine Subgroup.mem_normalizer_iff.2 fun x ↦ ⟨?_, ?_⟩
  · rintro ⟨s, rfl⟩
    exact ⟨_, (hconj s).symm⟩
  · rintro ⟨s, hs⟩
    obtain ⟨t, rfl⟩ := hσ s
    rw [← hconj t] at hs
    exact ⟨t, mul_left_cancel (mul_right_cancel hs)⟩
