/-!
# Generating tuples

A group generated by a pair of elements is generated by a tuple of any larger length, the extra
entries being the identity. Generation statements by a fixed number of elements are stated for
tuples, in which repetitions are allowed, so that they are monotone in the number of entries.
A surjective homomorphism carries generating sets, and so generating tuples, to generating sets.
Two elements `τ` and `σ` with `τ³ = σ² = 1` and `σ τ σ = τ² σ τ²`, the relations of the
tetrahedral group, generate a subgroup whose elements are the products `τ^a` and `τ^a σ τ^b` with
`a, b < 3`. If left multiplication by every element of a set `S` maps `R * K` into itself, for a
finite subgroup `K` and a finite nonempty set `R`, then the subgroup generated by `S` stabilizes the
finite set `R * K` and so has at most `|R| * |K|` elements.

## Main results

* `Subgroup.exists_closure_range_eq_top_of_closure_pair_eq_top`: a group generated by two elements
  is generated by an `(n + 2)`-tuple.
* `Subgroup.mem_closure_pair_iff_of_tetrahedral`: the normal forms `τ^a` and `τ^a σ τ^b` of the
  subgroup generated by two elements satisfying the tetrahedral relations.
* `MonoidHom.closure_image_eq_top_of_surjective`,
  `AddMonoidHom.closure_image_eq_top_of_surjective`: a surjective homomorphism carries a
  generating set to a generating set.
* `Subgroup.exists_injective_closure_to_mul`, `Subgroup.finite_closure_of_forall_mul_mem`: a set `S`
  whose left multiplications map `R * K` into itself generates a subgroup embedding into `R * K`,
  hence a finite one.
* `Subgroup.natCard_closure_le_ncard_mul`: the covering bound `|⟨S⟩| ≤ |R| * |K|` for a set `S`
  whose left multiplications map `R * K` into itself.
-/

public section

namespace Subgroup

/-- A group generated by two elements is generated by an `(n + 2)`-tuple, for every `n`: pad the
pair with identity elements. -/
theorem exists_closure_range_eq_top_of_closure_pair_eq_top {G : Type*} [Group G] (n : ℕ)
    {σ τ : G} (hστ : closure {σ, τ} = ⊤) : ∃ g : Fin (n + 2) → G, closure (Set.range g) = ⊤ := by
  let g : Fin (n + 2) → G := Fin.cases σ (Fin.cases τ fun _ : Fin n ↦ 1)
  refine ⟨g, top_unique ?_⟩
  rw [← hστ]
  apply closure_mono
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact ⟨0, by simp [g]⟩
  · exact ⟨Fin.succ 0, by simp only [g, Fin.cases_succ, Fin.cases_zero]⟩

/-- If `τ³ = σ² = 1` and `σ τ σ = τ² σ τ²`, every element of the subgroup generated by `τ` and `σ`
is one of the twelve products `τ^a` and `τ^a σ τ^b` with `a, b < 3`: left multiplication by either
generator preserves these normal forms. -/
theorem mem_closure_pair_iff_of_tetrahedral {G : Type*} [Group G] {τ σ g : G} (hτ3 : τ ^ 3 = 1)
    (hσ2 : σ * σ = 1) (hrel : σ * τ * σ = τ ^ 2 * σ * τ ^ 2) :
    g ∈ closure {τ, σ} ↔ ∃ a < 3, ∃ b < 3, g = τ ^ a ∨ g = τ ^ a * σ * τ ^ b := by
  have hσi : σ⁻¹ = σ := inv_eq_of_mul_eq_one_right hσ2
  have hτi : τ⁻¹ = τ ^ 2 := inv_eq_of_mul_eq_one_right (by rw [← pow_succ', hτ3])
  have hτ2i : (τ ^ 2)⁻¹ = τ := inv_eq_of_mul_eq_one_right (by rw [← pow_succ, hτ3])
  -- inverting `σ τ σ = τ² σ τ²` gives `σ τ² σ = τ σ τ`
  have hrel' : σ * τ ^ 2 * σ = τ * σ * τ := by
    have h := congrArg (·⁻¹) hrel
    simpa only [mul_inv_rev, hσi, hτi, hτ2i, mul_assoc] using h
  have hmod (n : ℕ) : τ ^ n = τ ^ (n % 3) := pow_eq_pow_mod n hτ3
  -- left multiplication by a generator preserves the twelve normal forms
  have key : ∀ x ∈ ({τ, σ} : Set G), ∀ y,
      (∃ a < 3, ∃ b < 3, y = τ ^ a ∨ y = τ ^ a * σ * τ ^ b) →
      ∃ a < 3, ∃ b < 3, x * y = τ ^ a ∨ x * y = τ ^ a * σ * τ ^ b := by
    intro x hx
    rcases hx with hx | hx <;> subst x <;> rintro y ⟨a, ha, b, hb, rfl | rfl⟩
    · exact ⟨(a + 1) % 3, Nat.mod_lt _ (by norm_num), 0, by norm_num,
        Or.inl (by rw [← pow_succ', hmod])⟩
    · exact ⟨(a + 1) % 3, Nat.mod_lt _ (by norm_num), b, hb,
        Or.inr (by rw [← hmod, pow_succ', mul_assoc, mul_assoc, mul_assoc])⟩
    · exact ⟨0, by norm_num, a, ha, Or.inr (by rw [pow_zero, one_mul])⟩
    · interval_cases a
      · exact ⟨b, hb, 0, by norm_num, Or.inl (by rw [pow_zero, one_mul, ← mul_assoc, hσ2, one_mul])⟩
      · refine ⟨2, by norm_num, (b + 2) % 3, Nat.mod_lt _ (by norm_num), Or.inr ?_⟩
        rw [← hmod, add_comm, pow_add, pow_one, ← mul_assoc, ← mul_assoc, hrel]
        simp only [mul_assoc]
      · refine ⟨1, by norm_num, (b + 1) % 3, Nat.mod_lt _ (by norm_num), Or.inr ?_⟩
        rw [← hmod, add_comm, pow_add, pow_one, ← mul_assoc, ← mul_assoc, hrel']
        simp only [mul_assoc]
  constructor
  · intro hg
    induction hg using closure_induction_left with
    | one => exact ⟨0, by norm_num, 0, by norm_num, Or.inl (pow_zero τ).symm⟩
    | mul_left x hx y _ ih => exact key x hx y ih
    | inv_mul_cancel x hx y _ ih =>
      rcases hx with hx | hx <;> subst x
      · rw [hτi, pow_two, mul_assoc]
        exact key _ (Set.mem_insert _ _) _ (key _ (Set.mem_insert _ _) y ih)
      · rw [hσi]
        exact key _ (Set.mem_insert_of_mem _ rfl) y ih
  · have hτmem : τ ∈ closure {τ, σ} := subset_closure (Set.mem_insert _ _)
    have hσmem : σ ∈ closure {τ, σ} := subset_closure (Set.mem_insert_of_mem _ rfl)
    rintro ⟨a, -, b, -, rfl | rfl⟩
    · exact pow_mem hτmem a
    · exact mul_mem (mul_mem (pow_mem hτmem a) hσmem) (pow_mem hτmem b)

section Cover

open MulAction Pointwise

/-- If left multiplication by every element of `S` maps `R * K` into itself, for a finite subgroup
`K` and a finite nonempty set `R`, then `S` generates a subgroup stabilizing the finite set `R * K`,
and right multiplication by a point of `R * K` embeds that subgroup into `R * K`. -/
theorem exists_injective_closure_to_mul {G : Type*} [Group G] {S R : Set G} {K : Subgroup G}
    (hR : R.Finite) (hR' : R.Nonempty) [Finite K] (h : ∀ s ∈ S, ∀ r ∈ R, s * r ∈ R * (K : Set G)) :
    ∃ f : closure S → (R * (K : Set G) : Set G), Function.Injective f := by
  have hX : (R * (K : Set G)).Finite := hR.mul (K : Set G).toFinite
  have hle : closure S ≤ stabilizer G (R * (K : Set G)) := by
    refine (closure_le _).2 fun s hs ↦ (mem_stabilizer_set_iff_smul_set_subset hX).2 ?_
    rintro _ ⟨_, ⟨r, hr, k, hk, rfl⟩, rfl⟩
    obtain ⟨r', hr', k', hk', e⟩ := h s hs r hr
    exact ⟨r', hr', k' * k, mul_mem hk' hk, by simp [← mul_assoc, e]⟩
  obtain ⟨r, hr⟩ := hR'
  have hx : r ∈ R * (K : Set G) := ⟨r, hr, 1, one_mem K, mul_one r⟩
  refine ⟨fun g ↦ ⟨(g : G) * r, ?_⟩, fun g g' e ↦ Subtype.ext (mul_right_cancel
    (congrArg Subtype.val e))⟩
  rw [← mem_stabilizer_iff.1 (hle g.2)]
  exact Set.smul_mem_smul_set hx

/-- A subgroup is finite if it is generated by a set `S` such that left multiplication by every
element of `S` maps `R * K` into itself, for a finite subgroup `K` and a finite nonempty set `R`. -/
theorem finite_closure_of_forall_mul_mem {G : Type*} [Group G] {S R : Set G} {K : Subgroup G}
    (hR : R.Finite) (hR' : R.Nonempty) [Finite K]
    (h : ∀ s ∈ S, ∀ r ∈ R, s * r ∈ R * (K : Set G)) : Finite (closure S) :=
  have : Finite (R * (K : Set G) : Set G) := (hR.mul (K : Set G).toFinite).to_subtype
  have ⟨_, hf⟩ := exists_injective_closure_to_mul hR hR' h
  Finite.of_injective _ hf

/-- **The covering bound.** If left multiplication by every element of `S` maps `R * K` into itself,
for a finite subgroup `K` and a finite nonempty set `R`, then the subgroup generated by `S` has at
most `|R| * |K|` elements.

A related covering bound, `Subgroup.natCard_closure_le_mul`, phrased with inverse transitions and
correction words, appears in https://github.com/TauCetiProject/TauCeti/pull/12300
(feat: prove the M24 permutation image has order 244823040). -/
theorem natCard_closure_le_ncard_mul {G : Type*} [Group G] {S R : Set G} {K : Subgroup G}
    (hR : R.Finite) (hR' : R.Nonempty) [Finite K]
    (h : ∀ s ∈ S, ∀ r ∈ R, s * r ∈ R * (K : Set G)) :
    Nat.card (closure S) ≤ R.ncard * Nat.card K := by
  have : Finite (R * (K : Set G) : Set G) := (hR.mul (K : Set G).toFinite).to_subtype
  obtain ⟨f, hf⟩ := exists_injective_closure_to_mul hR hR' h
  calc Nat.card (closure S) ≤ Nat.card (R * (K : Set G) : Set G) :=
        Nat.card_le_card_of_injective f hf
    _ ≤ Nat.card R * Nat.card (K : Set G) := Set.natCard_mul_le
    _ = R.ncard * Nat.card K := by rw [Nat.card_coe_set_eq, SetLike.coe_sort_coe]

end Cover

end Subgroup

/-- A surjective homomorphism carries a generating set to a generating set. -/
@[to_additive /-- A surjective additive homomorphism carries a generating set to a generating
set. -/]
theorem MonoidHom.closure_image_eq_top_of_surjective {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Surjective f) {s : Set G} (hs : Subgroup.closure s = ⊤) :
    Subgroup.closure (f '' s) = ⊤ := by
  simp [← MonoidHom.map_closure, hs, ← MonoidHom.range_eq_map, hf]
