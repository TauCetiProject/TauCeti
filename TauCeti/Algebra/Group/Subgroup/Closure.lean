module

public import Mathlib.Algebra.Group.Subgroup.Ker
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Data.Fin.Tuple.Basic

/-!
# Generating tuples

A group generated by a pair of elements is generated by a tuple of any larger length, the extra
entries being the identity. Generation statements by a fixed number of elements are stated for
tuples, in which repetitions are allowed, so that they are monotone in the number of entries.
A surjective homomorphism carries generating sets, and so generating tuples, to generating sets.

## Main results

* `Subgroup.exists_closure_range_eq_top_of_closure_pair_eq_top`: a group generated by two elements
  is generated by an `(n + 2)`-tuple.
* `MonoidHom.closure_image_eq_top_of_surjective`,
  `AddMonoidHom.closure_image_eq_top_of_surjective`: a surjective homomorphism carries a
  generating set to a generating set.
-/

public section

namespace Subgroup

/-- A group generated by two elements is generated by an `(n + 2)`-tuple, for every `n`: pad the
pair with identity elements. -/
theorem exists_closure_range_eq_top_of_closure_pair_eq_top {G : Type*} [Group G] (n : ℕ)
    {σ τ : G} (hστ : closure {σ, τ} = ⊤) : ∃ g : Fin (n + 2) → G, closure (Set.range g) = ⊤ := by
  let g : Fin (n + 2) → G := Fin.cases σ (Fin.cases τ fun _ : Fin n ↦ 1)
  refine ⟨g, top_unique ?_⟩
  rw [← hστ]
  apply closure_mono
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact ⟨0, by simp [g]⟩
  · exact ⟨Fin.succ 0, by simp only [g, Fin.cases_succ, Fin.cases_zero]⟩

end Subgroup

/-- A surjective homomorphism carries a generating set to a generating set. -/
@[to_additive /-- A surjective additive homomorphism carries a generating set to a generating
set. -/]
theorem MonoidHom.closure_image_eq_top_of_surjective {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Surjective f) {s : Set G} (hs : Subgroup.closure s = ⊤) :
    Subgroup.closure (f '' s) = ⊤ := by
  simp [← MonoidHom.map_closure, hs, ← MonoidHom.range_eq_map, hf]
