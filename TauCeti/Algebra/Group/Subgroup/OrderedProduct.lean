module

public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import TauCeti.GroupTheory.Commutator
public import Mathlib.Algebra.BigOperators.Group.List.Basic
public import Mathlib.Data.List.OfFn

/-!
# Ordered products of normalizing subgroups

Let `H₀, …, Hₙ₋₁` be subgroups of an arbitrary group. If each `Hᵢ` normalizes the subgroup
generated by the later factors, every element of their join is a product `h₀ ⋯ hₙ₋₁`, with
`hᵢ ∈ Hᵢ`. The product is written with `List.ofFn`, so its order is specified even in a
noncommutative group. No uniqueness of the factors is asserted.

The commutator version checks the normalization hypothesis on pairs of factors: it suffices
that `⁅Hᵢ, Hⱼ⁆`, for `i < j`, lies in the subgroup generated by factors later than `i`. This
is the collection step for positive root subgroups ordered by height, once the commutator
relations supply that containment.

The proof iterates Mathlib's binary normalized-join formula
`Subgroup.coe_mul_of_left_le_normalizer_right`, rather than performing word rewriting.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3.
-/

public section

namespace Subgroup

open scoped Pointwise

variable {G : Type*} [Group G]

/-- Membership in the join of finitely many subgroups is equivalent to an ordered product of
one element from each subgroup, if each subgroup normalizes the join of the later ones. -/
theorem mem_iSup_iff_exists_ofFn_prod {n : ℕ} (H : Fin n → Subgroup G)
    (hN : ∀ i, H i ≤ normalizer (⨆ j, ⨆ (_ : i < j), H j : Subgroup G)) {g : G} :
    g ∈ ⨆ i, H i ↔ ∃ f : ∀ i, H i, (List.ofFn fun i => (f i : G)).prod = g := by
  induction n generalizing g with
  | zero => simp [eq_comm]
  | succ n ih =>
    have htail (i : Fin n) :
        (⨆ j : Fin (n + 1), ⨆ (_ : i.succ < j), H j) =
          ⨆ j : Fin n, ⨆ (_ : i < j), H j.succ := by
      apply le_antisymm
      · refine iSup_le fun j => iSup_le fun hij => ?_
        obtain ⟨j, rfl⟩ := Fin.eq_succ_of_ne_zero (ne_of_gt (lt_of_le_of_lt (Fin.zero_le _) hij))
        exact le_iSup_of_le j (le_iSup_of_le (Fin.succ_lt_succ_iff.mp hij) le_rfl)
      · exact iSup_le fun j => iSup_le fun hij =>
          le_iSup_of_le j.succ (le_iSup_of_le (Fin.succ_lt_succ_iff.mpr hij) le_rfl)
    have hNtail : ∀ i : Fin n,
        H i.succ ≤ normalizer (⨆ j : Fin n, ⨆ (_ : i < j), H j.succ : Subgroup G) := by
      intro i
      simpa only [htail] using hN i.succ
    have hzero : (⨆ j : Fin (n + 1), ⨆ (_ : (0 : Fin (n + 1)) < j), H j) =
        ⨆ j : Fin n, H j.succ := by
      apply le_antisymm
      · refine iSup_le fun j => iSup_le fun hj => ?_
        obtain ⟨j, rfl⟩ := Fin.eq_succ_of_ne_zero (ne_of_gt hj)
        exact le_iSup (fun j : Fin n => H j.succ) j
      · exact iSup_le fun j => le_iSup_of_le j.succ
          (le_iSup_of_le (Fin.succ_pos j) le_rfl)
    have hjoin : (⨆ i, H i) = H 0 ⊔ ⨆ i : Fin n, H i.succ := by
      apply le_antisymm
      · refine iSup_le fun i => ?_
        exact Fin.cases le_sup_left
          (fun j => (le_iSup (fun i : Fin n => H i.succ) j).trans le_sup_right) i
      · exact sup_le (le_iSup _ 0) (iSup_le fun i => le_iSup _ i.succ)
    rw [hjoin, ← SetLike.mem_coe,
      coe_mul_of_left_le_normalizer_right _ _ (hzero ▸ hN 0), Set.mem_mul]
    constructor
    · rintro ⟨a, ha, b, hb, hab⟩
      obtain ⟨f, hf⟩ := (ih (fun i => H i.succ) hNtail).mp hb
      refine ⟨Fin.cons ⟨a, ha⟩ f, ?_⟩
      simpa only [List.ofFn_succ, Fin.cons_zero, Fin.cons_succ, List.prod_cons, hf] using hab
    · rintro ⟨f, hf⟩
      refine ⟨f 0, (f 0).property, (List.ofFn fun i : Fin n => (f i.succ : G)).prod, ?_, ?_⟩
      · exact (ih (fun i => H i.succ) hNtail).mpr ⟨fun i => f i.succ, rfl⟩
      · simpa only [List.ofFn_succ, List.prod_cons] using hf

/-- Ordered products cover the join when each commutator of an earlier factor with a later
factor lies in the join of the factors later than the earlier one. -/
theorem mem_iSup_iff_exists_ofFn_prod_of_commutator_le {n : ℕ} (H : Fin n → Subgroup G)
    (hC : ∀ i j, i < j → ⁅H i, H j⁆ ≤ ⨆ k, ⨆ (_ : i < k), H k) {g : G} :
    g ∈ ⨆ i, H i ↔ ∃ f : ∀ i, H i, (List.ofFn fun i => (f i : G)).prod = g := by
  apply mem_iSup_iff_exists_ofFn_prod
  intro i
  apply le_normalizer_iSup_of_commutator_le
  intro j
  by_cases hij : i < j
  · simpa only [iSup_pos hij] using hC i j hij
  · simp [hij]

end Subgroup
