module

public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Dedekind's modular law for subgroups

The lattice of subgroups of a group is not modular in general, but the modular identity
`(K ⊓ H) ⊔ N = K ⊓ (H ⊔ N)` does hold for `N ≤ K` as soon as `H` normalizes `N`, because then
the join `H ⊔ N` is the product set `H * N` and the identity is Dedekind's law for products of
subgroups (Mathlib's `Subgroup.inf_mul_assoc`).

When moreover `H ⊔ N = ⊤`, a subgroup `K ≥ N` is recovered as `(K ⊓ H) ⊔ N`, so `K = N` as soon as
`H ⊓ K = ⊥`. This is how a kernel is read off from a normal subgroup `N` it contains and a
complementary subgroup `H` on which the homomorphism is injective: for a character, `N` is the
normal closure of the generators it kills and `H` the subgroup generated by the remaining ones.

## Main results

* `Subgroup.inf_sup_assoc_of_le`: `(K ⊓ H) ⊔ N = K ⊓ (H ⊔ N)` for `H ≤ normalizer N` and
  `N ≤ K`.
* `Subgroup.eq_inf_sup_of_sup_eq_top`: `K = (K ⊓ H) ⊔ N` when moreover `H ⊔ N = ⊤`.
* `Subgroup.eq_of_sup_eq_top_of_inf_eq_bot`: `K = N` when moreover `H ⊔ N = ⊤` and
  `H ⊓ K = ⊥`.
-/

public section

namespace Subgroup

variable {G : Type*} [Group G]

/-- **Dedekind's modular law**: if `H` normalizes `N` and `N ≤ K`, then
`(K ⊓ H) ⊔ N = K ⊓ (H ⊔ N)`. -/
@[to_additive /-- **Dedekind's modular law**: if `H` normalizes `N` and `N ≤ K`, then
`(K ⊓ H) ⊔ N = K ⊓ (H ⊔ N)`. -/]
theorem inf_sup_assoc_of_le {H K N : Subgroup G} (hHN : H ≤ normalizer (N : Set G)) (h : N ≤ K) :
    (K ⊓ H) ⊔ N = K ⊓ (H ⊔ N) := by
  apply SetLike.coe_injective
  rw [coe_mul_of_left_le_normalizer_right _ _ (inf_le_right.trans hHN), inf_mul_assoc K H N h,
    coe_inf, coe_mul_of_left_le_normalizer_right _ _ hHN]

/-- If `H` normalizes `N`, `N ≤ K` and `H ⊔ N = ⊤`, then `K = (K ⊓ H) ⊔ N`. -/
@[to_additive /-- If `H` normalizes `N`, `N ≤ K` and `H ⊔ N = ⊤`, then `K = (K ⊓ H) ⊔ N`. -/]
theorem eq_inf_sup_of_sup_eq_top {H K N : Subgroup G} (hHN : H ≤ normalizer (N : Set G))
    (hNK : N ≤ K) (hsup : H ⊔ N = ⊤) : K = (K ⊓ H) ⊔ N := by
  rw [inf_sup_assoc_of_le hHN hNK, hsup, inf_top_eq]

/-- If `H` normalizes `N`, `N ≤ K`, `H ⊔ N = ⊤` and `H ⊓ K = ⊥`, then `K = N`. -/
@[to_additive
  /-- If `H` normalizes `N`, `N ≤ K`, `H ⊔ N = ⊤` and `H ⊓ K = ⊥`, then `K = N`. -/]
theorem eq_of_sup_eq_top_of_inf_eq_bot {H K N : Subgroup G} (hHN : H ≤ normalizer (N : Set G))
    (hNK : N ≤ K) (hsup : H ⊔ N = ⊤) (hHK : H ⊓ K = ⊥) : K = N := by
  rw [eq_inf_sup_of_sup_eq_top hHN hNK hsup, inf_comm, hHK, bot_sup_eq]

end Subgroup
