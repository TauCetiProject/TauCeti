module

public import Mathlib.Algebra.RingQuot
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.TwoSidedIdeal.Kernel
public import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# The relation ideal of a ring quotient

The kernel of `RingQuot.mkRingHom r` is the two-sided ideal generated by the differences
`a - b` for which `r a b`. This identifies a generators-and-relations quotient with an ideal
quotient, including for noncommutative rings. It lets homogeneous-ideal constructions apply to
`RingQuot` without changing its carrier.

This extends the relation-ideal comparison in Mathlib's `RingQuot` file, which uses
`Ideal.ofRel` for commutative rings. The proof uses `RingQuot.lift` and the universal property
of `TwoSidedIdeal.span`.
-/

public section

namespace RingQuot

variable {A : Type*} [Ring A]

/-- The kernel of the relation quotient is generated, as a two-sided ideal, by the
differences of related elements. No commutativity of the ambient ring is required. -/
theorem ker_mkRingHom_eq_span (r : A → A → Prop) :
    RingHom.ker (mkRingHom r) =
      (TwoSidedIdeal.span {z | ∃ a b, r a b ∧ z = a - b}).asIdeal := by
  let I := TwoSidedIdeal.span {z | ∃ a b, r a b ∧ z = a - b}
  have hI : I ≤ TwoSidedIdeal.ker (mkRingHom r) := by
    refine TwoSidedIdeal.span_le.2 ?_
    rintro _ ⟨a, b, hab, rfl⟩
    apply (TwoSidedIdeal.mem_ker (mkRingHom r)).2
    rw [map_sub, mkRingHom_rel hab, sub_self]
  let f : RingQuot r →+* A ⧸ I.asIdeal := lift ⟨Ideal.Quotient.mk I.asIdeal, by
    intro a b hab
    exact Ideal.Quotient.eq.2 (TwoSidedIdeal.subset_span ⟨a, b, hab, rfl⟩)⟩
  ext a
  constructor
  · intro ha
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have h := congrArg f (RingHom.mem_ker.mp ha)
    simpa only [f, lift_mkRingHom_apply, map_zero] using h
  · intro ha
    exact (TwoSidedIdeal.mem_ker (mkRingHom r)).mp (hI ha)

end RingQuot
