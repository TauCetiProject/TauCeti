module

public import Mathlib.Algebra.QuadraticAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Maps
import TauCeti.RingTheory.Ideal.Operations

/-!
# Ideals of a quadratic algebra extended from the coefficients

Let `R` be a commutative semiring and `I` an ideal of `R`. The extension of `I` to
`QuadraticAlgebra R a b` consists of the elements whose two coordinates lie in `I`: as an
`R`-submodule it is `I • ⊤` (`Ideal.smul_top_eq_map`), whose members are read off coordinatewise
in the basis `1, ω` (`Module.Basis.mem_smul_top_iff`). Consequently the kernel of a change of
coefficients `mapRingHom f a b` is the extension of the kernel of `f`.

The statements, their order and the proof plan follow Mathlib's polynomial analogues
`Polynomial.mem_map_C_iff` and `Polynomial.ker_mapRingHom`, with the basis `1, ω` of
`QuadraticAlgebra R a b` in place of the monomial basis of `R[X]`.

## Main results

* `QuadraticAlgebra.mem_map_algebraMap_iff`: the extension of an ideal `I` of `R` to
  `QuadraticAlgebra R a b` consists of the elements with both coordinates in `I`.
* `QuadraticAlgebra.ker_mapRingHom`: the kernel of `mapRingHom f a b` is the extension of the
  kernel of `f`.
-/

public section

namespace QuadraticAlgebra

variable {R S : Type*} [CommSemiring R] [CommSemiring S] {a b : R}

/-- **Extension of an ideal of the coefficients.** An element of `QuadraticAlgebra R a b` lies
in the ideal generated by an ideal `I` of `R` exactly when both of its coordinates lie in `I`. -/
theorem mem_map_algebraMap_iff {I : Ideal R} {z : QuadraticAlgebra R a b} :
    z ∈ I.map (algebraMap R (QuadraticAlgebra R a b)) ↔ z.re ∈ I ∧ z.im ∈ I := by
  rw [← Submodule.restrictScalars_mem R, ← Ideal.smul_top_eq_map, (basis a b).mem_smul_top_iff]
  simp [Fin.forall_fin_two]

/-- **The kernel of a change of coefficients.** The kernel of the coefficientwise map
`mapRingHom f a b` is the extension of the kernel of `f`. -/
theorem ker_mapRingHom (f : R →+* S) (a b : R) :
    RingHom.ker (mapRingHom f a b) =
      (RingHom.ker f).map (algebraMap R (QuadraticAlgebra R a b)) := by
  ext z
  rw [mem_map_algebraMap_iff, RingHom.mem_ker, QuadraticAlgebra.ext_iff]
  simp

end QuadraticAlgebra
