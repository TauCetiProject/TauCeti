/-!
# Laurent subalgebras generated by coordinate families

For a family of coordinates `x : I → F` in a division `C`-algebra `F`, the *Laurent subalgebra*
`TauCeti.laurentSubalgebra C x` is the `C`-subalgebra of `F` generated by the `x i` and their
inverses `(x i)⁻¹`.

Over a commutative ambient semifield `F` and a family of units `x : I → Fˣ`, the Laurent subalgebra
coincides with the range of the evaluation map `TauCeti.LaurentRing.aeval x` out of the
multivariable Laurent polynomial ring `TauCeti.LaurentRing C I`. Defining `laurentSubalgebra`
directly on `I → F` over any division semiring avoids bundling unit proofs when coordinates are
transported or specialized, accommodates noncommutative division algebras, and handles degenerate
zero coordinates via `(0 : F)⁻¹ = 0`.

## Main definitions

* `TauCeti.laurentSubalgebra`: the `C`-subalgebra of `F` generated by `x i` and `(x i)⁻¹`.

## Main results

* `TauCeti.laurentSubalgebra_le_iff`, `TauCeti.apply_mem_laurentSubalgebra`,
  `TauCeti.inv_apply_mem_laurentSubalgebra`, and `TauCeti.zpow_apply_mem_laurentSubalgebra`:
  membership and universal-property characterization of `laurentSubalgebra`.
* `TauCeti.map_laurentSubalgebra`: transport along `C`-algebra homomorphisms of division semirings.
* `TauCeti.exists_finset_mem_laurentSubalgebra` and `TauCeti.laurentSubalgebra_eq_iSup_finset`:
  reduction of an infinite coordinate family to its finite subfamilies.
* `TauCeti.LaurentRing.aeval_range_eq_laurentSubalgebra`: the image of `LaurentRing.aeval x` is
  `laurentSubalgebra C (fun i ↦ (x i : F))`.

## References

* S. Fomin and A. Zelevinsky, *Cluster algebras I: Foundations*, J. Amer. Math. Soc. 15 (2002), §3.
* A. Berenstein and A. Zelevinsky, *Quantum cluster algebras*, Adv. Math. 195 (2005), 405–455, §5.
-/

public section

namespace TauCeti

section LaurentSubalgebra

variable (C : Type*) {I J F : Type*} [CommSemiring C] [DivisionSemiring F] [Algebra C F]

/-- The `C`-subalgebra of `F` generated by a family of coordinates `x : I → F` and their inverses
`(x i)⁻¹`. -/
def laurentSubalgebra (x : I → F) : Subalgebra C F :=
  Algebra.adjoin C (Set.range x ∪ Set.range fun i ↦ (x i)⁻¹)

/-- Unfolds `TauCeti.laurentSubalgebra` to `Algebra.adjoin`. -/
theorem laurentSubalgebra_def (x : I → F) :
    laurentSubalgebra C x = Algebra.adjoin C (Set.range x ∪ Set.range fun i ↦ (x i)⁻¹) :=
  (rfl)

/-- A `C`-subalgebra contains `laurentSubalgebra C x` if and only if it contains every coordinate
`x i` and its inverse `(x i)⁻¹`. -/
@[simp]
theorem laurentSubalgebra_le_iff {x : I → F} {S : Subalgebra C F} :
    laurentSubalgebra C x ≤ S ↔ (∀ i, x i ∈ S) ∧ ∀ i, (x i)⁻¹ ∈ S := by
  simp [laurentSubalgebra_def, Algebra.adjoin_le_iff, Set.union_subset_iff, Set.range_subset_iff]

/-- Every coordinate `x i` belongs to `laurentSubalgebra C x`. -/
@[simp]
theorem apply_mem_laurentSubalgebra (x : I → F) (i : I) :
    x i ∈ laurentSubalgebra C x :=
  Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)

/-- The inverse `(x i)⁻¹` of every coordinate belongs to `laurentSubalgebra C x`. -/
@[simp]
theorem inv_apply_mem_laurentSubalgebra (x : I → F) (i : I) :
    (x i)⁻¹ ∈ laurentSubalgebra C x :=
  Algebra.subset_adjoin (Or.inr ⟨i, rfl⟩)

/-- Every integer power `x i ^ n` of a coordinate belongs to `laurentSubalgebra C x`. -/
theorem zpow_apply_mem_laurentSubalgebra (x : I → F) (i : I) (n : ℤ) :
    x i ^ n ∈ laurentSubalgebra C x := by
  cases n with
  | ofNat m =>
    rw [Int.ofNat_eq_natCast, zpow_natCast]
    exact pow_mem (apply_mem_laurentSubalgebra C x i) m
  | negSucc m =>
    rw [zpow_negSucc, ← inv_pow]
    exact pow_mem (inv_apply_mem_laurentSubalgebra C x i) (m + 1)

/-- With an empty coordinate index type, the Laurent subalgebra is the image of `C`. -/
@[simp]
theorem laurentSubalgebra_of_isEmpty [IsEmpty I] (x : I → F) :
    laurentSubalgebra C x = ⊥ :=
  eq_bot_iff.mpr ((laurentSubalgebra_le_iff C).mpr ⟨isEmptyElim, isEmptyElim⟩)

/-- Pulling back a coordinate family along a map of index types gives a smaller Laurent
subalgebra. -/
theorem laurentSubalgebra_comp_le (x : I → F) (f : J → I) :
    laurentSubalgebra C (x ∘ f) ≤ laurentSubalgebra C x :=
  (laurentSubalgebra_le_iff C).mpr
    ⟨fun j ↦ apply_mem_laurentSubalgebra C x (f j),
      fun j ↦ inv_apply_mem_laurentSubalgebra C x (f j)⟩

/-- Pulling back a coordinate family along a surjective map preserves the Laurent subalgebra. -/
theorem laurentSubalgebra_comp_of_surjective (x : I → F) {f : J → I}
    (hf : Function.Surjective f) :
    laurentSubalgebra C (x ∘ f) = laurentSubalgebra C x := by
  refine le_antisymm (laurentSubalgebra_comp_le C x f)
    ((laurentSubalgebra_le_iff C).mpr ⟨fun i ↦ ?_, fun i ↦ ?_⟩)
  · obtain ⟨j, rfl⟩ := hf i
    exact apply_mem_laurentSubalgebra C (x ∘ f) j
  · obtain ⟨j, rfl⟩ := hf i
    exact inv_apply_mem_laurentSubalgebra C (x ∘ f) j

/-- Reindexing coordinates along an equivalence preserves the Laurent subalgebra. -/
@[simp]
theorem laurentSubalgebra_comp_equiv (x : I → F) (e : J ≃ I) :
    laurentSubalgebra C (x ∘ e) = laurentSubalgebra C x :=
  laurentSubalgebra_comp_of_surjective C x e.surjective

/-- A `C`-algebra homomorphism between division semirings maps the Laurent subalgebra of `x` onto
the Laurent subalgebra of `φ ∘ x`. -/
@[simp]
theorem map_laurentSubalgebra {G : Type*} [DivisionSemiring G] [Algebra C G] (φ : F →ₐ[C] G)
    (x : I → F) :
    (laurentSubalgebra C x).map φ = laurentSubalgebra C (φ ∘ x) := by
  rw [laurentSubalgebra_def, laurentSubalgebra_def, φ.map_adjoin, Set.image_union,
    ← Set.range_comp]
  congr 2
  ext y
  simp [map_inv₀]

/-- Extending scalars from `C` to an intermediate commutative semiring `R` enlarges the Laurent
subalgebra. -/
theorem laurentSubalgebra_le_restrictScalars (R : Type*) [CommSemiring R] [Algebra C R]
    [Algebra R F] [IsScalarTower C R F] (x : I → F) :
    laurentSubalgebra C x ≤ (laurentSubalgebra R x).restrictScalars C :=
  (laurentSubalgebra_le_iff C).mpr
    ⟨fun i ↦ apply_mem_laurentSubalgebra R x i, fun i ↦ inv_apply_mem_laurentSubalgebra R x i⟩

/-- Since `0`, `0⁻¹ = 0`, `1`, and `1⁻¹ = 1` belong to every subalgebra, replacing a coordinate
with `0` generates the same Laurent subalgebra as replacing it with `1`. -/
theorem laurentSubalgebra_update_zero_eq_update_one [DecidableEq I] (x : I → F) (i : I) :
    laurentSubalgebra C (Function.update x i 0) =
      laurentSubalgebra C (Function.update x i 1) := by
  refine le_antisymm ((laurentSubalgebra_le_iff C).mpr ⟨fun j ↦ ?_, fun j ↦ ?_⟩)
    ((laurentSubalgebra_le_iff C).mpr ⟨fun j ↦ ?_, fun j ↦ ?_⟩) <;>
    by_cases hj : j = i
  · subst hj; simp [zero_mem]
  · rw [Function.update_of_ne hj]
    simpa [Function.update_of_ne hj] using
      apply_mem_laurentSubalgebra C (Function.update x i 1) j
  · subst hj; simp [zero_mem]
  · rw [Function.update_of_ne hj]
    simpa [Function.update_of_ne hj] using
      inv_apply_mem_laurentSubalgebra C (Function.update x i 1) j
  · subst hj; simp [one_mem]
  · rw [Function.update_of_ne hj]
    simpa [Function.update_of_ne hj] using
      apply_mem_laurentSubalgebra C (Function.update x i 0) j
  · subst hj; simp [one_mem]
  · rw [Function.update_of_ne hj]
    simpa [Function.update_of_ne hj] using
      inv_apply_mem_laurentSubalgebra C (Function.update x i 0) j

/-- The Laurent subalgebra of an arbitrary coordinate family is the supremum of the Laurent
subalgebras of its finite subfamilies. -/
theorem laurentSubalgebra_eq_iSup_finset (x : I → F) :
    laurentSubalgebra C x = ⨆ s : Finset I, laurentSubalgebra C (fun i : s ↦ x i) := by
  classical
  refine le_antisymm ?_ (iSup_le fun s ↦ laurentSubalgebra_comp_le C x Subtype.val)
  rw [laurentSubalgebra_def]
  refine Algebra.adjoin_le ?_
  rintro y (⟨i, rfl⟩ | ⟨i, rfl⟩)
  · exact le_iSup (fun s : Finset I ↦ laurentSubalgebra C (fun j : s ↦ x j)) {i}
      (apply_mem_laurentSubalgebra C (fun j : ({i} : Finset I) ↦ x j)
        ⟨i, Finset.mem_singleton_self i⟩)
  · exact le_iSup (fun s : Finset I ↦ laurentSubalgebra C (fun j : s ↦ x j)) {i}
      (inv_apply_mem_laurentSubalgebra C (fun j : ({i} : Finset I) ↦ x j)
        ⟨i, Finset.mem_singleton_self i⟩)

end LaurentSubalgebra

/-- Every element of `laurentSubalgebra C x` already lies in the Laurent subalgebra of a finite
subfamily of coordinates. -/
theorem exists_finset_mem_laurentSubalgebra {C I F : Type*} [CommSemiring C] [DivisionSemiring F]
    [Algebra C F] {x : I → F} {z : F} (hz : z ∈ laurentSubalgebra C x) :
    ∃ s : Finset I, z ∈ laurentSubalgebra C (fun i : s ↦ x i) := by
  classical
  rw [laurentSubalgebra_def] at hz
  induction hz using Algebra.adjoin_induction with
  | mem y hy =>
    rcases hy with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · exact ⟨{i}, apply_mem_laurentSubalgebra C (fun j : ({i} : Finset I) ↦ x j)
        ⟨i, Finset.mem_singleton_self i⟩⟩
    · exact ⟨{i}, inv_apply_mem_laurentSubalgebra C (fun j : ({i} : Finset I) ↦ x j)
        ⟨i, Finset.mem_singleton_self i⟩⟩
  | algebraMap r => exact ⟨∅, Subalgebra.algebraMap_mem _ r⟩
  | add y₁ y₂ _ _ ih₁ ih₂ =>
    obtain ⟨s₁, h₁⟩ := ih₁
    obtain ⟨s₂, h₂⟩ := ih₂
    exact ⟨s₁ ∪ s₂, add_mem
      (laurentSubalgebra_comp_le C (fun i : ↑(s₁ ∪ s₂) ↦ x i)
        (Set.inclusion Finset.subset_union_left) h₁)
      (laurentSubalgebra_comp_le C (fun i : ↑(s₁ ∪ s₂) ↦ x i)
        (Set.inclusion Finset.subset_union_right) h₂)⟩
  | mul y₁ y₂ _ _ ih₁ ih₂ =>
    obtain ⟨s₁, h₁⟩ := ih₁
    obtain ⟨s₂, h₂⟩ := ih₂
    exact ⟨s₁ ∪ s₂, mul_mem
      (laurentSubalgebra_comp_le C (fun i : ↑(s₁ ∪ s₂) ↦ x i)
        (Set.inclusion Finset.subset_union_left) h₁)
      (laurentSubalgebra_comp_le C (fun i : ↑(s₁ ∪ s₂) ↦ x i)
        (Set.inclusion Finset.subset_union_right) h₂)⟩

/-- Over a commutative ambient semifield `F`, the range of `TauCeti.LaurentRing.aeval x` for a
family of units `x : I → Fˣ` is the Laurent subalgebra generated by the underlying coordinates. -/
@[simp]
theorem LaurentRing.aeval_range_eq_laurentSubalgebra {C I F : Type*} [CommSemiring C]
    [Semifield F] [Algebra C F] (x : I → Fˣ) :
    (LaurentRing.aeval (R := C) x).range = laurentSubalgebra C (fun i ↦ (x i : F)) := by
  refine le_antisymm ?_ ((laurentSubalgebra_le_iff C).mpr ⟨fun i ↦ ?_, fun i ↦ ?_⟩)
  · intro y hy
    obtain ⟨p, rfl⟩ := (LaurentRing.aeval (R := C) x).mem_range.mp hy
    clear hy
    induction p using AddMonoidAlgebra.induction_linear with
    | zero =>
      rw [map_zero]
      exact zero_mem _
    | add p q hp hq =>
      rw [map_add]
      exact add_mem hp hq
    | single m r =>
      rw [LaurentRing.aeval_single, Algebra.smul_def]
      refine mul_mem (Subalgebra.algebraMap_mem _ r) ?_
      have hprod : ((m.prod fun i n ↦ x i ^ n : Fˣ) : F) = m.prod fun i n ↦ (x i : F) ^ n := by
        simpa [Units.val_zpow_eq_zpow_val] using
          map_finsuppProd (Units.coeHom F) m fun i n ↦ x i ^ n
      rw [hprod]
      exact Subalgebra.prod_mem _ fun i _ ↦
        zpow_apply_mem_laurentSubalgebra C (fun j ↦ (x j : F)) i (m i)
  · exact (LaurentRing.aeval (R := C) x).mem_range.mpr ⟨LaurentRing.X i, LaurentRing.aeval_X x i⟩
  · refine (LaurentRing.aeval (R := C) x).mem_range.mpr
      ⟨(((LaurentRing.unitX i)⁻¹ : (LaurentRing C I)ˣ) : LaurentRing C I), ?_⟩
    rw [LaurentRing.val_inv_unitX, LaurentRing.aeval_single, one_smul, Finsupp.prod_single_index,
      zpow_neg_one, Units.val_inv_eq_inv_val]
    exact zpow_zero _

end TauCeti
