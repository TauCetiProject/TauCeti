module

public import TauCeti.Algebra.MvPolynomial.Laurent.Subalgebra
public import TauCeti.RingTheory.Localization.Hartogs
import Mathlib.RingTheory.Localization.AsSubring

/-!
# Algebraic Hartogs intersections of finite Laurent subalgebras

Let `R` be a Noetherian ring embedding faithfully into a field `F` over a commutative semiring `C`
(`[FaithfulSMul R F]`, which includes `[IsFractionRing R F]`). For a finite family of coordinates
`x : I → R`, the Laurent subalgebra `TauCeti.laurentSubalgebra C (algebraMap R F ∘ x)` inside any
commutative ambient semifield `F` lies in every embedded principal localization `A ⊆ F` of `R` away
from the product `∏ i, x i`.

Combining this inclusion with algebraic Hartogs for embedded principal localizations
(`TauCeti.IsLocalization.iInf_subalgebra_powers_eq_bot_of_two_le_depth`) and transporting from
`FractionRing R` into `F` along `IsFractionRing.liftAlgHom` shows that for any family of finite
coordinate tuples `x : ∀ t, I t → R`, the intersection `⋂_t C[x_{t,i}^{±1}]` lies in the image of
`R` in `F` whenever `depth R_p ≥ 2` at every prime containing each product `∏ i, x t i`, and in
particular for a nonempty family under Serre's condition `(S_2)` when no height-one prime contains
every product.

## Main results

* `TauCeti.laurentSubalgebra_le_subalgebra_powers_prod`: over a commutative ambient semifield `F`,
  a finite Laurent subalgebra lies in any embedded localization of `R` away from `∏ i, x i`.
* `TauCeti.iInf_laurentSubalgebra_le_range_of_two_le_depth`: intersection of a family of
  finite-coordinate Laurent subalgebras lies in the image of `R` when `depth R_p ≥ 2` on the common
  vanishing locus of the coordinate products.
* `TauCeti.iInf_laurentSubalgebra_le_range_of_satisfiesSerreS_two`: the `(S_2)` case for a nonempty
  chart family when the basic opens `D(∏ i, x t i)` cover all height-one primes of `R`.

## References

* [Stacks Project, Lemma 31.5.11 (0E9I)](https://stacks.math.columbia.edu/tag/0E9I)
* A. Berenstein, S. Fomin, and A. Zelevinsky, *Cluster algebras III: Upper bounds and double Bruhat
  cells*, Duke Math. J. 126 (2005), 1–52, Theorem 2.10.
-/

public section

open scoped nonZeroDivisors

namespace TauCeti

/-- Over a commutative ambient semifield `F`, the Laurent subalgebra over `C` generated by the
images of a finite tuple `x : I → R` lies in any embedded localization `A ⊆ F` of `R` away from
`∏ i, x i`. -/
theorem laurentSubalgebra_le_subalgebra_powers_prod (C : Type*) {R F I : Type*} [CommSemiring C]
    [CommSemiring R] [Semifield F] [Algebra C R] [Algebra C F] [Algebra R F] [IsScalarTower C R F]
    [Fintype I] (x : I → R) (A : Subalgebra R F)
    [IsLocalization (Submonoid.powers (∏ i, x i)) A] :
    laurentSubalgebra C (algebraMap R F ∘ x) ≤ A.restrictScalars C :=
  (laurentSubalgebra_le_iff C).mpr
    ⟨fun i ↦ A.algebraMap_mem (x i),
      fun i ↦ IsLocalization.inv_algebraMap_mem_subalgebra_powers_prod Finset.univ x A
        (Finset.mem_univ i)⟩

private theorem iInf_laurentSubalgebra_le_range_of_two_le_depth_isFractionRing
    {C R K T : Type*} [CommSemiring C] [CommRing R] [IsNoetherianRing R] [Field K]
    [Algebra C R] [Algebra C K] [Algebra R K] [IsScalarTower C R K] [IsFractionRing R K]
    {I : T → Type*} [∀ t, Fintype (I t)] (x : ∀ t, I t → R) (hx : ∀ t i, x t i ≠ 0)
    (hdepth : ∀ (p : Ideal R) [p.IsPrime], (∀ t, ∏ i, x t i ∈ p) →
      2 ≤ IsLocalRing.depth (ModuleCat.of (Localization.AtPrime p) (Localization.AtPrime p))) :
    (⨅ t, laurentSubalgebra C (algebraMap R K ∘ x t)) ≤
      (IsScalarTower.toAlgHom C R K).range := by
  have : IsDomain R := (IsFractionRing.injective R K).isDomain
  have hpow (t : T) : Submonoid.powers (∏ i, x t i) ≤ R⁰ :=
    Submonoid.powers_le.mpr
      (Submonoid.prod_mem R⁰ fun i _ ↦ mem_nonZeroDivisors_of_ne_zero (hx t i))
  intro z hz
  rw [Algebra.mem_iInf] at hz
  let B (t : T) : Subalgebra R K :=
    Localization.subalgebra.ofField K (Submonoid.powers (∏ i, x t i)) (hpow t)
  have hmem : z ∈ ⨅ t, B t :=
    Algebra.mem_iInf.mpr fun t ↦ laurentSubalgebra_le_subalgebra_powers_prod C (x t) (B t) (hz t)
  rw [IsLocalization.iInf_subalgebra_powers_eq_bot_of_two_le_depth _ B hdepth,
    Algebra.mem_bot] at hmem
  obtain ⟨r, hr⟩ := hmem
  exact (IsScalarTower.toAlgHom C R K).mem_range.mpr ⟨r, hr⟩

private theorem iInf_laurentSubalgebra_le_range_of_two_le_depth_ne_zero {C R F T : Type*}
    [CommSemiring C] [CommRing R] [IsNoetherianRing R] [Field F] [Algebra C R] [Algebra C F]
    [Algebra R F] [IsScalarTower C R F] [FaithfulSMul R F] [Nonempty T] {I : T → Type*}
    [∀ t, Fintype (I t)] (x : ∀ t, I t → R) (hx : ∀ t i, x t i ≠ 0)
    (hdepth : ∀ (p : Ideal R) [p.IsPrime], (∀ t, ∏ i, x t i ∈ p) →
      2 ≤ IsLocalRing.depth (ModuleCat.of (Localization.AtPrime p) (Localization.AtPrime p))) :
    (⨅ t, laurentSubalgebra C (algebraMap R F ∘ x t)) ≤
      (IsScalarTower.toAlgHom C R F).range := by
  have : IsDomain R := (FaithfulSMul.algebraMap_injective R F).isDomain
  let K := FractionRing R
  let φR : K →ₐ[R] F :=
    IsFractionRing.liftAlgHom (K := K) (g := Algebra.ofId R F)
      (FaithfulSMul.algebraMap_injective R F)
  let φ : K →ₐ[C] F := φR.restrictScalars C
  have hcomp (t : T) : φ ∘ (algebraMap R K ∘ x t) = algebraMap R F ∘ x t :=
    funext fun i ↦ φR.commutes (x t i)
  have hiInf : (⨅ t, laurentSubalgebra C (algebraMap R F ∘ x t)) =
      (⨅ t, laurentSubalgebra C (algebraMap R K ∘ x t)).map φ := by
    rw [Algebra.map_iInf φ φ.toRingHom.injective]
    exact iInf_congr fun t ↦ by rw [map_laurentSubalgebra, hcomp]
  rw [hiInf]
  refine (Subalgebra.map_mono
    (iInf_laurentSubalgebra_le_range_of_two_le_depth_isFractionRing x hx hdepth)).trans ?_
  rw [← AlgHom.range_comp]
  refine le_of_eq (congrArg AlgHom.range ?_)
  ext r
  exact φR.commutes r

/-- **Algebraic Hartogs for Laurent chart families.** Let `R` be a Noetherian ring embedding
faithfully into a field `F` over `C`, and let `x : ∀ t, I t → R` be a family of finite coordinate
tuples. If `depth R_p ≥ 2` at every prime `p` containing each product `∏ i, x t i`, then
`⋂_t C[x_{t,i}^{±1}]` lies in the image of `R` in `F`. -/
theorem iInf_laurentSubalgebra_le_range_of_two_le_depth {C R F T : Type*} [CommSemiring C]
    [CommRing R] [IsNoetherianRing R] [Field F] [Algebra C R] [Algebra C F] [Algebra R F]
    [IsScalarTower C R F] [FaithfulSMul R F] {I : T → Type*} [∀ t, Fintype (I t)]
    (x : ∀ t, I t → R)
    (hdepth : ∀ (p : Ideal R) [p.IsPrime], (∀ t, ∏ i, x t i ∈ p) →
      2 ≤ IsLocalRing.depth (ModuleCat.of (Localization.AtPrime p) (Localization.AtPrime p))) :
    (⨅ t, laurentSubalgebra C (algebraMap R F ∘ x t)) ≤
      (IsScalarTower.toAlgHom C R F).range := by
  have : IsDomain R := (FaithfulSMul.algebraMap_injective R F).isDomain
  let T' := {t : T // ∀ i, x t i ≠ 0}
  have hprod_mem (p : Ideal R) (hall : ∀ t : T', ∏ i, x t.val i ∈ p) (t : T) :
      ∏ i, x t i ∈ p := by
    by_cases ht : ∀ i, x t i ≠ 0
    · exact hall ⟨t, ht⟩
    · push Not at ht
      obtain ⟨i, hi⟩ := ht
      rw [Finset.prod_eq_zero (Finset.mem_univ i) hi]
      exact p.zero_mem
  have : Nonempty T' := by
    by_contra hne
    rw [not_nonempty_iff] at hne
    -- At the minimal prime `(0)`, `R_{(0)}` is a field of depth `0`, contradicting `2 ≤ depth`.
    have h20 := hdepth ⊥ (hprod_mem ⊥ fun t ↦ isEmptyElim t)
    have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime (⊥ : Ideal R)) = ⊥ := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (⊥ : Ideal R)
        (Localization.AtPrime (⊥ : Ideal R)), Ideal.map_bot]
    have h0 : IsLocalRing.depth
        (ModuleCat.of (Localization.AtPrime (⊥ : Ideal R))
          (Localization.AtPrime (⊥ : Ideal R))) = 0 :=
      by_contra fun h ↦ IsLocalRing.maximalIdeal_ne_bot_of_depth_ne_zero h hmax
    exact absurd (h0 ▸ h20) (by decide)
  exact (le_iInf fun t : T' ↦ iInf_le _ t.val).trans
    (iInf_laurentSubalgebra_le_range_of_two_le_depth_ne_zero (fun t : T' ↦ x t.val)
      (fun t ↦ t.property) fun p _ hall ↦ hdepth p (hprod_mem p hall))

/-- **Laurent chart intersection under `(S_2)`.** Over a Noetherian ring `R` satisfying `(S_2)` and
embedding faithfully into a field `F` over `C`, if `x : ∀ t, I t → R` is a nonempty family of
finite coordinate tuples whose products `∏ i, x t i` do not simultaneously vanish at any height-one
prime, then `⋂_t C[x_{t,i}^{±1}]` lies in the image of `R` in `F`. -/
theorem iInf_laurentSubalgebra_le_range_of_satisfiesSerreS_two {C R F T : Type*} [CommSemiring C]
    [CommRing R] [IsNoetherianRing R] [Field F] [Algebra C R] [Algebra C F] [Algebra R F]
    [IsScalarTower C R F] [FaithfulSMul R F] (hS₂ : Module.SatisfiesSerreS 2 R R) [Nonempty T]
    {I : T → Type*} [∀ t, Fintype (I t)] (x : ∀ t, I t → R)
    (hcover : ∀ p : Ideal R, p.IsPrime → p.height = 1 → ∃ t, ∏ i, x t i ∉ p) :
    (⨅ t, laurentSubalgebra C (algebraMap R F ∘ x t)) ≤
      (IsScalarTower.toAlgHom C R F).range := by
  have : IsDomain R := (FaithfulSMul.algebraMap_injective R F).isDomain
  by_cases hT' : ∃ t₀ : T, ∀ i, x t₀ i ≠ 0
  · obtain ⟨t₀, ht₀⟩ := hT'
    have hprod₀ : ∏ i, x t₀ i ∈ R⁰ :=
      Submonoid.prod_mem R⁰ fun i _ ↦ mem_nonZeroDivisors_of_ne_zero (ht₀ i)
    refine iInf_laurentSubalgebra_le_range_of_two_le_depth x fun p hp hall ↦
      hS₂.two_le_depth_atPrime_of_mem_nonZeroDivisors_of_height_ne_one
        hprod₀ (hall t₀) fun h1 ↦ ?_
    obtain ⟨t, ht⟩ := hcover p hp h1
    exact ht (hall t)
  · -- Every tuple has a zero entry, so `hcover` rules out height-one primes and `R` is a field.
    push Not at hT'
    obtain ⟨t₀⟩ := ‹Nonempty T›
    refine (iInf_le _ t₀).trans ((laurentSubalgebra_le_iff C).mpr ⟨fun j ↦ ?_, fun j ↦ ?_⟩)
    · exact (IsScalarTower.toAlgHom C R F).mem_range.mpr ⟨x t₀ j, rfl⟩
    · by_cases hj : x t₀ j = 0
      · simp [hj, zero_mem]
      · have hu : IsUnit (x t₀ j) := by
          rw [← Ideal.span_singleton_eq_top, Ideal.eq_top_iff_one]
          refine hS₂.mem_span_singleton_of_forall_height_eq_one
            (mem_nonZeroDivisors_of_ne_zero hj) fun P hP hP1 ↦ ?_
          obtain ⟨t, ht⟩ := hcover P hP hP1
          obtain ⟨i, hi⟩ := hT' t
          exact absurd (Finset.prod_eq_zero (Finset.mem_univ i) hi ▸ P.zero_mem) ht
        obtain ⟨u, hu⟩ := hu
        refine (IsScalarTower.toAlgHom C R F).mem_range.mpr ⟨↑u⁻¹, ?_⟩
        rw [IsScalarTower.toAlgHom_apply, Function.comp_apply, ← hu]
        simp

end TauCeti
