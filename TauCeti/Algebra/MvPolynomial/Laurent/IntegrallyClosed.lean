module

public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import TauCeti.Algebra.MvPolynomial.Laurent.Polynomial
import TauCeti.RingTheory.MvPolynomial.IntegrallyClosed

/-!
# Multivariable Laurent polynomial rings over integrally closed domains

If `R` is an integrally closed domain, then so is the multivariable Laurent polynomial ring
`TauCeti.LaurentRing R K` in any family `K` of variables (`TauCeti.LaurentRing.isIntegrallyClosed`).
Indeed, `MvPolynomial K R` is integrally closed (`TauCeti.MvPolynomial.isIntegrallyClosed`), and
`LaurentRing R K` is its localization at the submonoid generated by the variables
(`TauCeti.LaurentRing.isLocalization`), all of which are nonzerodivisors.

## Main results

* `TauCeti.LaurentRing.isIntegrallyClosed`: `LaurentRing R K` is integrally closed when `R` is an
  integrally closed domain.

## References

* N. Bourbaki, *Commutative Algebra*, Chapter V, §1, no. 2, Proposition 8 and no. 3,
  Corollary to Proposition 13.
-/

public section

namespace TauCeti.LaurentRing

/-- A multivariable Laurent polynomial ring, in any set of variables, over an integrally closed
domain is integrally closed. -/
instance isIntegrallyClosed {R K : Type*} [CommRing R] [IsDomain R] [IsIntegrallyClosed R] :
    IsIntegrallyClosed (LaurentRing R K) :=
  isIntegrallyClosed_of_isLocalization (LaurentRing R K)
    (Submonoid.closure (Set.range (_root_.MvPolynomial.X : K → _root_.MvPolynomial K R)))
    (Submonoid.closure_le.mpr <| Set.range_subset_iff.mpr fun i ↦
      mem_nonZeroDivisors_iff_ne_zero.mpr (_root_.MvPolynomial.X_ne_zero i))

end TauCeti.LaurentRing
