module

public import TauCeti.Algebra.MvPolynomial.Laurent.Polynomial
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import TauCeti.RingTheory.Localization.FractionRing
import TauCeti.RingTheory.MvPolynomial.IntegrallyClosed

/-!
# Laurent polynomial rings over integrally closed domains

If `R` is an integrally closed domain, then the multivariable Laurent polynomial ring
`TauCeti.LaurentRing R K` in any indexing type `K` of variables is integrally closed: it is the
localization of the polynomial ring `MvPolynomial K R` at the submonoid generated by the variables
(`TauCeti.LaurentRing.isLocalization`), and `MvPolynomial K R` is integrally closed
(`TauCeti.MvPolynomial.isIntegrallyClosed`).

## Main results

* `TauCeti.LaurentRing.isIntegrallyClosed`: `LaurentRing R K` is integrally closed when `R` is an
  integrally closed domain.

## References

* N. Bourbaki, *Commutative Algebra*, Chapter V, §1, no. 3 and no. 8.
* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 4.
-/

public section

namespace TauCeti.LaurentRing

/-- A multivariable Laurent polynomial ring, in any set of variables, over an integrally closed
domain is integrally closed. -/
instance isIntegrallyClosed {R K : Type*} [CommRing R] [IsDomain R] [IsIntegrallyClosed R] :
    IsIntegrallyClosed (LaurentRing R K) :=
  isIntegrallyClosed_of_isLocalization (LaurentRing R K)
    (Submonoid.closure (Set.range (MvPolynomial.X : K → MvPolynomial K R)))
    (TauCeti.IsLocalization.le_nonZeroDivisors_of_nontrivial _ (LaurentRing R K))

end TauCeti.LaurentRing
