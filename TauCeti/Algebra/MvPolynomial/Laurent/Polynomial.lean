module

public import TauCeti.Algebra.MvPolynomial.Laurent.Basic
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.RingTheory.AlgebraicIndependent.Defs
public import Mathlib.RingTheory.Localization.Defs

/-!
# Polynomials as Laurent polynomials

The polynomial ring `MvPolynomial K R` embeds in the Laurent ring `TauCeti.LaurentRing R K` by
reading natural exponents as integers. This file constructs the embedding
`MvPolynomial.toLaurent`, identifies its image as the Laurent polynomials all of whose exponents
are nonnegative, and proves that it exhibits the Laurent ring as the localization of the
polynomial ring at the variables.

The localization statement is what transports the theory of polynomial rings to Laurent rings.
Its first use here is the criterion `TauCeti.LaurentRing.aeval_injective_iff_algebraicIndependent`:
evaluation of Laurent polynomials at a family of units is injective exactly when the family is
algebraically independent. A cluster of a cluster algebra is such a family in the ambient field,
and this is the condition for it to define a faithful Laurent chart.

## Main definitions

* `MvPolynomial.toLaurent`: the inclusion of the polynomial ring in the Laurent ring, as an
  algebra map.
* `TauCeti.LaurentRing.algebraMvPolynomial`: the resulting algebra structure of the Laurent ring
  over the polynomial ring.

## Main results

* `MvPolynomial.toLaurent_injective`: the inclusion is injective.
* `MvPolynomial.mem_range_toLaurent_iff`: a Laurent polynomial is a polynomial exactly when the
  exponents in its support are nonnegative.
* `MvPolynomial.toLaurent_map`, `TauCeti.LaurentRing.rename_toLaurent` and
  `TauCeti.LaurentRing.aeval_toLaurent`: the inclusion commutes with coefficient maps, with
  renaming the variables, and with evaluation at a family of units.
* `TauCeti.LaurentRing.exists_mul_toLaurent_monomial`: every Laurent polynomial becomes a
  polynomial after multiplication by a monomial.
* `TauCeti.LaurentRing.isLocalization`: the Laurent ring is the localization of the polynomial
  ring at the submonoid generated by the variables.
* `TauCeti.LaurentRing.aeval_injective_iff`: evaluation of Laurent polynomials at a family of
  units is injective exactly when evaluation of polynomials at that family is.

## Implementation notes

The definitions follow the one-variable case in Mathlib: `MvPolynomial.toLaurent` is the analogue
of `Polynomial.toLaurent`, and the algebra structure and the localization statement are the
analogues of `LaurentPolynomial.algebraPolynomial` and `LaurentPolynomial.isLocalization`.

## References

* S. Fomin and A. Zelevinsky, *Cluster algebras I: Foundations*, J. Amer. Math. Soc. 15 (2002),
  §§2–3, where the variables of a cluster are algebraically independent generators of the
  ambient field and cluster variables are expanded as Laurent polynomials in them.
-/

public section

open AddMonoidAlgebra TauCeti

namespace MvPolynomial

variable {R : Type*} [CommSemiring R] {K : Type*}

/-- The inclusion of the polynomial ring in the Laurent ring in the same variables, reading the
natural exponents of a monomial as integers. -/
noncomputable def toLaurent : MvPolynomial K R →ₐ[R] LaurentRing R K :=
  mapDomainAlgHom R R (Finsupp.mapRange.addMonoidHom (Nat.castAddMonoidHom ℤ))

/-- The inclusion of polynomials in Laurent polynomials pushes the coefficients forward along
the inclusion of natural exponents in integer exponents. -/
theorem toLaurent_apply (p : MvPolynomial K R) :
    toLaurent p = mapDomain (Finsupp.mapRange Nat.cast Nat.cast_zero : (K →₀ ℕ) → K →₀ ℤ) p :=
  (rfl)

@[simp]
theorem toLaurent_monomial (s : K →₀ ℕ) (r : R) :
    toLaurent (monomial s r) = single (s.mapRange Nat.cast Nat.cast_zero : K →₀ ℤ) r := by
  simp [toLaurent_apply, ← single_eq_monomial]

@[simp]
theorem toLaurent_X (i : K) : toLaurent (X i : MvPolynomial K R) = LaurentRing.X i := by
  simp [X, LaurentRing.X_def]

/-- The coefficient of a polynomial at a natural exponent is its coefficient, as a Laurent
polynomial, at the same exponent read as an integer vector. -/
@[simp]
theorem coeff_toLaurent (p : MvPolynomial K R) (s : K →₀ ℕ) :
    (toLaurent p).coeff (s.mapRange Nat.cast Nat.cast_zero) = p.coeff s := by
  rw [toLaurent_apply, coeff_mapDomain]
  exact Finsupp.mapDomain_apply_of_injective
    (Finsupp.mapRange_injective _ Nat.cast_zero Nat.cast_injective) p.coeff s

/-- Distinct polynomials are distinct Laurent polynomials. -/
theorem toLaurent_injective :
    Function.Injective (toLaurent : MvPolynomial K R → LaurentRing R K) := fun p q h ↦
  MvPolynomial.ext p q fun s ↦ by rw [← coeff_toLaurent, h, coeff_toLaurent]

@[simp]
theorem toLaurent_inj (p q : MvPolynomial K R) : toLaurent p = toLaurent q ↔ p = q :=
  toLaurent_injective.eq_iff

@[simp]
theorem toLaurent_eq_zero {p : MvPolynomial K R} : toLaurent p = 0 ↔ p = 0 :=
  map_eq_zero_iff _ toLaurent_injective

theorem toLaurent_ne_zero {p : MvPolynomial K R} : toLaurent p ≠ 0 ↔ p ≠ 0 :=
  map_ne_zero_iff _ toLaurent_injective

/-- A Laurent polynomial is a polynomial exactly when every exponent in its support is
nonnegative in every variable. -/
theorem mem_range_toLaurent_iff {f : LaurentRing R K} :
    f ∈ (toLaurent : MvPolynomial K R →ₐ[R] LaurentRing R K).range ↔
      ∀ m ∈ f.coeff.support, ∀ i, 0 ≤ m i := by
  classical
  refine ⟨fun hf m hm i ↦ ?_, fun h ↦ ?_⟩
  · obtain ⟨p, rfl⟩ := (AlgHom.mem_range _).1 hf
    rw [toLaurent_apply, coeff_mapDomain] at hm
    obtain ⟨s, -, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support hm)
    simp
  · rw [← sum_coeff_single f]
    refine Subalgebra.sum_mem _ fun m hm ↦ (AlgHom.mem_range _).2
      ⟨monomial (m.mapRange Int.toNat Int.toNat_zero) (f.coeff m), ?_⟩
    rw [toLaurent_monomial]
    congr 1
    ext i
    simpa using h m hm i

/-- The inclusion of polynomials in Laurent polynomials commutes with coefficient maps. -/
theorem toLaurent_map {S : Type*} [CommSemiring S] (φ : R →+* S) (p : MvPolynomial K R) :
    toLaurent (map φ p) = mapRingHom (K →₀ ℤ) φ (toLaurent p) := by
  induction p using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp]

end MvPolynomial

namespace TauCeti.LaurentRing

open MvPolynomial

variable {R : Type*} [CommSemiring R] {K K' : Type*}

theorem aeval_comp_toLaurent {A : Type*} [CommSemiring A] [Algebra R A] (x : K → Aˣ) :
    (aeval (R := R) x).comp toLaurent = MvPolynomial.aeval fun i ↦ (x i : A) :=
  MvPolynomial.algHom_ext fun i ↦ by simp

/-- Evaluating a polynomial as a Laurent polynomial at a family of units is evaluating it at
the underlying family of elements. -/
@[simp]
theorem aeval_toLaurent {A : Type*} [CommSemiring A] [Algebra R A] (x : K → Aˣ)
    (p : MvPolynomial K R) :
    aeval x (toLaurent p) = MvPolynomial.aeval (fun i ↦ (x i : A)) p :=
  DFunLike.congr_fun (aeval_comp_toLaurent x) p

theorem rename_comp_toLaurent (f : K → K') :
    (rename (R := R) f).comp toLaurent = toLaurent.comp (MvPolynomial.rename f) :=
  MvPolynomial.algHom_ext fun i ↦ by simp

/-- The inclusion of polynomials in Laurent polynomials commutes with renaming the variables. -/
theorem rename_toLaurent (f : K → K') (p : MvPolynomial K R) :
    rename f (toLaurent p) = toLaurent (MvPolynomial.rename f p) :=
  DFunLike.congr_fun (rename_comp_toLaurent f) p

/-- Every Laurent polynomial becomes a polynomial after multiplication by a monomial in the
variables: a common denominator of its finitely many terms. -/
theorem exists_mul_toLaurent_monomial (f : LaurentRing R K) :
    ∃ (n : K →₀ ℕ) (p : MvPolynomial K R), f * toLaurent (monomial n 1) = toLaurent p := by
  induction f using AddMonoidAlgebra.induction_linear with
  | zero => exact ⟨0, 0, by simp⟩
  | add f g hf hg =>
    obtain ⟨n, p, hp⟩ := hf
    obtain ⟨k, q, hq⟩ := hg
    refine ⟨n + k, p * monomial k 1 + q * monomial n 1, ?_⟩
    have hnk : (monomial (n + k) 1 : MvPolynomial K R) = monomial n 1 * monomial k 1 := by
      rw [monomial_mul_monomial, one_mul]
    rw [hnk, map_add, map_mul, map_mul, map_mul, ← hp, ← hq]
    ring
  | single m r =>
    -- Multiply by the monomial whose exponent is the negative part of `m`.
    refine ⟨(-m).mapRange Int.toNat Int.toNat_zero,
      monomial (m.mapRange Int.toNat Int.toNat_zero) r, ?_⟩
    rw [toLaurent_monomial, toLaurent_monomial, single_mul_single, mul_one]
    congr 1
    ext i
    simp only [Finsupp.add_apply, Finsupp.mapRange_apply, Finsupp.neg_apply]
    omega

/-- The Laurent ring is an algebra over the polynomial ring in the same variables, through the
inclusion `MvPolynomial.toLaurent`. -/
noncomputable instance algebraMvPolynomial : Algebra (MvPolynomial K R) (LaurentRing R K) :=
  (toLaurent : MvPolynomial K R →ₐ[R] LaurentRing R K).toRingHom.toAlgebra

@[simp]
theorem algebraMap_eq_toLaurent (p : MvPolynomial K R) :
    algebraMap (MvPolynomial K R) (LaurentRing R K) p = toLaurent p :=
  (rfl)

instance : IsScalarTower R (MvPolynomial K R) (LaurentRing R K) :=
  .of_algebraMap_eq fun r ↦ by simp

/-- **The Laurent ring is the localization of the polynomial ring at the variables**: the
variables become units, every Laurent polynomial is a polynomial divided by a monomial in the
variables, and distinct polynomials stay distinct. -/
instance isLocalization :
    IsLocalization (Submonoid.closure (Set.range (MvPolynomial.X : K → MvPolynomial K R)))
      (LaurentRing R K) where
  map_units := by
    rintro ⟨s, hs⟩
    induction hs using Submonoid.closure_induction with
    | mem s hs =>
      obtain ⟨i, rfl⟩ := hs
      simpa using isUnit_X (R := R) i
    | one => simp
    | mul s t _ _ hs ht => simpa using hs.mul ht
  surj f := by
    obtain ⟨n, p, h⟩ := exists_mul_toLaurent_monomial f
    refine ⟨(p, ⟨monomial n 1, ?_⟩), h⟩
    rw [monomial_eq, C_1, one_mul]
    exact Submonoid.prod_mem _ fun i _ ↦ pow_mem (Submonoid.subset_closure (Set.mem_range_self i)) _
  exists_of_eq h := ⟨1, by simpa using toLaurent_injective h⟩

/-- Evaluation of Laurent polynomials at a family of units is injective exactly when evaluation
of polynomials at the underlying family of elements is: inverting the variables neither creates
nor destroys relations among the values. -/
theorem aeval_injective_iff {A : Type*} [CommSemiring A] [Algebra R A] (x : K → Aˣ) :
    Function.Injective (aeval (R := R) x) ↔
      Function.Injective (MvPolynomial.aeval (R := R) fun i ↦ (x i : A)) := by
  have h := IsLocalization.injective_iff_map_algebraMap_eq
    (Submonoid.closure (Set.range (MvPolynomial.X : K → MvPolynomial K R)))
    (aeval (R := R) x : LaurentRing R K →+* A)
  simp only [algebraMap_eq_toLaurent, RingHom.coe_coe, aeval_toLaurent,
    toLaurent_injective.eq_iff] at h
  exact h.trans ⟨fun h p q hpq ↦ (h p q).2 hpq, fun h p q ↦ h.eq_iff.symm⟩

/-- Evaluation of Laurent polynomials at a family of units is injective exactly when the family
is algebraically independent over the coefficient ring. -/
theorem aeval_injective_iff_algebraicIndependent {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] (x : K → Aˣ) :
    Function.Injective (aeval (R := R) x) ↔ AlgebraicIndependent R fun i ↦ (x i : A) :=
  (aeval_injective_iff x).trans algebraicIndependent_iff_injective_aeval.symm

end TauCeti.LaurentRing
