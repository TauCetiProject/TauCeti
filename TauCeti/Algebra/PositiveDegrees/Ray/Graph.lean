module

public import TauCeti.Algebra.PositiveDegrees.Graph
public import TauCeti.Algebra.PositiveDegrees.Ray.Map

/-!
# Supported rays on swapped graphs

The graph lift sends a supported ray with generator `v` to the ray with generator
`(f v, v)`. Multiples of those generators belong to the respective allowed monoids
for the same integer multipliers. The ray degrees are characterized by their second
coordinate and the graph equation, and form the image of the original ray degrees.

Numerical degrees are read from the second coordinate by
`PositiveDegrees.swappedGraph_degree`. Over a free target the lift agrees with
`SupportedRay.map` and has `SupportedRay.mapMultiplier` equal to one.

Adapted from `Mei/Algebra/PositiveDegrees/Graph.lean` in
[yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`bf3986029ff4d3eb4025d4067489511b0724374e`, released under Apache 2.0.
-/

public section

namespace TauCeti.SupportedRay

variable {N M : Type*} [AddCommGroup N] [AddCommGroup M]
  {d : PositiveDegrees N} (w : SupportedRay d) (f : N →+ M)

/-- The supported ray of `d.swappedGraph f` generated by `(f w.generator, w.generator)`. -/
def swappedGraph : SupportedRay (d.swappedGraph f) where
  generator := (f w.generator, w.generator)
  isPrimitive := IsPrimitive.of_map (g := LinearMap.snd ℤ M N) w.isPrimitive
  supported := by
    obtain ⟨a, ha, hn⟩ := w.supported
    exact ⟨a, ha, by simpa [map_zsmul] using (d.swappedGraphMap f).map_mem hn⟩

/-- The primitive generator of the graph lift retains the original generator
as its second coordinate. -/
@[simp]
theorem swappedGraph_generator : (w.swappedGraph f).generator = (f w.generator, w.generator) :=
  (rfl)

/-- An integer multiple of the lifted generator is allowed exactly when the same integer
multiple of the original generator is allowed. -/
theorem zsmul_generator_mem_swappedGraph_monoid (a : ℤ) :
    a • (w.swappedGraph f).generator ∈ (d.swappedGraph f).monoid ↔
      a • w.generator ∈ d.monoid := by
  simp [Prod.smul_mk, map_zsmul]

/-- An allowed ray degree on the graph is determined by its second coordinate
and the graph equation. -/
@[simp]
theorem mem_swappedGraph_rayDegrees (x : M × N) :
    x ∈ (w.swappedGraph f).rayDegrees ↔ x.2 ∈ w.rayDegrees ∧ x.1 = f x.2 := by
  simp only [mem_rayDegrees, PositiveDegrees.mem_swappedGraph_monoid, swappedGraph_generator,
    Prod.smul_mk]
  constructor
  · rintro ⟨⟨hn, hm⟩, a, ha, h⟩
    exact ⟨⟨hn, a, ha, congrArg Prod.snd h⟩, hm⟩
  · rintro ⟨⟨hn, a, ha, h⟩, hm⟩
    exact ⟨⟨hn, hm⟩, a, ha, Prod.ext (hm.trans (h ▸ map_zsmul f a w.generator)) h⟩

/-- The allowed ray degrees on the graph are exactly the image of the original allowed ray
degrees. -/
theorem swappedGraph_rayDegrees :
    (w.swappedGraph f).rayDegrees = d.swappedGraphMap f '' w.rayDegrees := by
  ext x
  rw [mem_swappedGraph_rayDegrees, PositiveDegrees.mem_image_swappedGraphMap]

variable [Module.Free ℤ (M × N)]

/-- Canonical transport by graph inclusion gives the graph lift. -/
@[simp]
theorem map_swappedGraphMap : w.map (d.swappedGraphMap f) = w.swappedGraph f :=
  (w.map_eq_iff _ _).mpr ⟨1, one_pos, by simp⟩

/-- Graph inclusion has primitive-ray multiplier one. -/
@[simp]
theorem mapMultiplier_swappedGraphMap : w.mapMultiplier (d.swappedGraphMap f) = 1 :=
  (w.mapMultiplier_eq_iff _ _).mpr (by simp)

end TauCeti.SupportedRay
