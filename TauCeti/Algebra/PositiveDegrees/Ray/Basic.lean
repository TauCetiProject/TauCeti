module

public import TauCeti.Algebra.PositiveDegrees.Basic
public import TauCeti.Algebra.Module.Primitive
public import Mathlib.GroupTheory.Subgroup.Saturated

/-!
# Supported primitive rays of a positive monoid

A supported ray is a primitive ambient vector with some positive integer multiple
in the allowed monoid. Its generator need not itself be allowed: for example, the
ray generated by `1` is supported by the monoid of nonnegative even integers.
`SupportedRay.rayDegrees` records the actual allowed degrees on the ray.

Every nonzero allowed degree in a free integer module has a unique supported ray
and a unique positive integer multiplier. Distinct rays have disjoint degree sets,
and only finitely many rays meet any degree cutoff. These facts allow homogeneous
series to be grouped by primitive direction even for nonsaturated monoids.

Primitive decomposition uses `exists_eq_zsmul_isPrimitive`.

Adapted from `Mei/Algebra/PositiveDegrees/Ray/Basic.lean` in
[yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`7f1e4c7714fb020473694755ad8748c8f15d0e7f`, released under Apache 2.0.
-/

public section

namespace TauCeti

variable {N : Type*} [AddCommGroup N]

/-- A primitive ambient direction with a positive multiple in the allowed monoid.
The primitive generator itself is not required to belong to the monoid. -/
structure SupportedRay (d : PositiveDegrees N) where
  /-- The primitive ambient generator, with its sign fixed by support. -/
  generator : N
  /-- The generator is primitive in the ambient integer module. -/
  isPrimitive : IsPrimitive generator
  /-- Some positive multiple of the generator is an allowed degree. -/
  supported : ∃ a : ℤ, 0 < a ∧ a • generator ∈ d.monoid

namespace SupportedRay

variable {d : PositiveDegrees N}

/-- Supported rays are determined by their ambient generators. -/
@[ext]
theorem ext {v w : SupportedRay d} (h : v.generator = w.generator) : v = w := by
  cases v
  cases w
  cases h
  rfl

/-- A supported ray has nonzero generator. -/
theorem generator_ne_zero (w : SupportedRay d) : w.generator ≠ 0 :=
  w.isPrimitive.ne_zero

/-- A supported generator belongs to the allowed monoid if that monoid is saturated
under division by positive natural multiples. -/
theorem generator_mem_of_nsmulSaturated (w : SupportedRay d)
    (h : d.monoid.NSMulSaturated) : w.generator ∈ d.monoid := by
  obtain ⟨a, ha, haw⟩ := w.supported
  have haw' : a.toNat • w.generator ∈ d.monoid := by
    simpa only [← Nat.cast_smul_eq_nsmul ℤ, Int.toNat_of_nonneg ha.le] using haw
  exact (h haw').resolve_left (by omega)

/-- The allowed positive multiples of a supported primitive generator. -/
def rayDegrees (w : SupportedRay d) : Set N :=
  {n | n ∈ d.monoid ∧ ∃ a : ℤ, 0 < a ∧ n = a • w.generator}

/-- Membership in the degrees of a supported ray. -/
theorem mem_rayDegrees {w : SupportedRay d} {n : N} :
    n ∈ w.rayDegrees ↔ n ∈ d.monoid ∧ ∃ a : ℤ, 0 < a ∧ n = a • w.generator :=
  Iff.rfl

/-- Actual allowed degrees on a supported ray are closed under addition. -/
theorem add_mem_rayDegrees {w : SupportedRay d} {n m : N}
    (hn : n ∈ w.rayDegrees) (hm : m ∈ w.rayDegrees) : n + m ∈ w.rayDegrees := by
  obtain ⟨hn, a, ha, rfl⟩ := hn
  obtain ⟨hm, b, hb, rfl⟩ := hm
  exact ⟨d.monoid.add_mem hn hm, a + b, add_pos ha hb, (add_zsmul _ _ _).symm⟩

/-- Each supported ray has at least one actual allowed degree. -/
theorem rayDegrees_nonempty (w : SupportedRay d) : w.rayDegrees.Nonempty := by
  obtain ⟨a, ha, ham⟩ := w.supported
  exact ⟨a • w.generator, ham, a, ha, rfl⟩

/-- Zero is not a degree on a supported ray. -/
@[simp]
theorem zero_notMem_rayDegrees (w : SupportedRay d) : (0 : N) ∉ w.rayDegrees := by
  rintro ⟨_, a, ha, h⟩
  have : (0 : ℤ) = a := w.isPrimitive.zsmul_left_injective (by simpa using h)
  omega

/-- Every degree on a supported ray is nonzero. -/
theorem ne_zero_of_mem_rayDegrees {w : SupportedRay d} {n : N}
    (hn : n ∈ w.rayDegrees) : n ≠ 0 := by
  rintro rfl
  exact w.zero_notMem_rayDegrees hn

/-- A supported primitive generator has strictly positive degree even when it is
not itself an allowed degree. -/
theorem degree_generator_pos (w : SupportedRay d) : 0 < d.degree w.generator := by
  obtain ⟨n, hn⟩ := w.rayDegrees_nonempty
  have hpos := d.degree_pos hn.1 (ne_zero_of_mem_rayDegrees hn)
  obtain ⟨a, ha, rfl⟩ := hn.2
  rw [map_zsmul, zsmul_eq_mul, Int.cast_id] at hpos
  exact (mul_pos_iff.mp hpos).resolve_right (by omega) |>.2

/-- The generator is an actual ray degree precisely when it belongs to the monoid. -/
@[simp]
theorem generator_mem_rayDegrees_iff (w : SupportedRay d) :
    w.generator ∈ w.rayDegrees ↔ w.generator ∈ d.monoid := by
  exact ⟨fun h => h.1, fun h => ⟨h, 1, by omega, by simp⟩⟩

/-- The ray generated by `1` is supported by the monoid generated by `2`, although `1` is not an
allowed degree. -/
example : ∃ (d : PositiveDegrees ℤ) (w : SupportedRay d), w.generator ∉ d.monoid := by
  refine ⟨⟨AddSubmonoid.closure {2}, AddMonoidHom.id ℤ, ?_, ?_⟩,
    ⟨1, isPrimitive_def.mpr ⟨LinearMap.id, rfl⟩, 2, by norm_num, ?_⟩, ?_⟩
  · rintro n hn hne
    obtain ⟨m, rfl⟩ := AddSubmonoid.mem_closure_singleton.mp hn
    simp only [AddMonoidHom.id_apply, nsmul_eq_mul] at hne ⊢
    omega
  · intro k
    refine (Set.finite_Icc (0 : ℤ) k).subset fun n ⟨hn, hk⟩ => ⟨?_, hk⟩
    obtain ⟨m, rfl⟩ := AddSubmonoid.mem_closure_singleton.mp hn
    simp
  · exact AddSubmonoid.mem_closure_singleton.mpr ⟨1, by simp⟩
  · intro h
    obtain ⟨m, hm⟩ := AddSubmonoid.mem_closure_singleton.mp h
    simp only [nsmul_eq_mul] at hm
    omega

/-- A primitive allowed vector supplies a supported ray. -/
def ofMem (n : N) (hn : n ∈ d.monoid) (hprim : IsPrimitive n) :
    SupportedRay d where
  generator := n
  isPrimitive := hprim
  supported := ⟨1, by omega, by simpa⟩

/-- The ray supplied by a primitive allowed vector has that vector as generator. -/
@[simp]
theorem generator_ofMem (n : N) (hn : n ∈ d.monoid) (hprim : IsPrimitive n) :
    (ofMem n hn hprim).generator = n := (rfl)

/-- A primitive allowed vector lies on the ray it supplies. -/
theorem mem_rayDegrees_ofMem (n : N) (hn : n ∈ d.monoid) (hprim : IsPrimitive n) :
    n ∈ (ofMem n hn hprim).rayDegrees :=
  mem_rayDegrees.mpr ⟨hn, 1, one_pos, by rw [generator_ofMem, one_smul]⟩

/-- Membership of an integer multiple uses exactly its positive multipliers and
the original monoid membership condition. -/
@[simp]
theorem zsmul_mem_rayDegrees_iff (w : SupportedRay d) (a : ℤ) :
    a • w.generator ∈ w.rayDegrees ↔ 0 < a ∧ a • w.generator ∈ d.monoid := by
  constructor
  · rintro ⟨hn, b, hb, hab⟩
    have := w.isPrimitive.zsmul_left_injective hab
    exact ⟨this ▸ hb, hn⟩
  · rintro ⟨ha, hn⟩
    exact ⟨hn, a, ha, rfl⟩

/-- An actual ray degree has a unique positive integer multiplier. -/
theorem existsUnique_multiplier {w : SupportedRay d} {n : N} (hn : n ∈ w.rayDegrees) :
    ∃! a : ℤ, 0 < a ∧ n = a • w.generator := by
  obtain ⟨a, ha, hna⟩ := hn.2
  refine ⟨a, ⟨ha, hna⟩, ?_⟩
  intro b hb
  exact w.isPrimitive.zsmul_left_injective (hb.2.symm.trans hna)

section TorsionFree

variable [HasUniqueDiv N]

/-- A degree common to two supported rays determines the ray uniquely. -/
theorem eq_of_mem_rayDegrees {v w : SupportedRay d} {n : N}
    (hv : n ∈ v.rayDegrees) (hw : n ∈ w.rayDegrees) : v = w := by
  obtain ⟨a, ha, hna⟩ := hv.2
  obtain ⟨b, hb, hnb⟩ := hw.2
  exact ext (v.isPrimitive.eq_of_pos_zsmul_eq w.isPrimitive ha hb (hna.symm.trans hnb))

/-- The degree sets of distinct supported rays are disjoint. -/
theorem disjoint_rayDegrees {v w : SupportedRay d} (h : v ≠ w) :
    Disjoint v.rayDegrees w.rayDegrees := by
  exact Set.disjoint_left.mpr fun _ hv hw => h (eq_of_mem_rayDegrees hv hw)

end TorsionFree

end SupportedRay

namespace PositiveDegrees

variable (d : PositiveDegrees N)

/-- The supported rays with an actual nonzero degree of order at most `k`. -/
def raysAtOrder (k : ℕ) : Set (SupportedRay d) :=
  {w | ∃ n ∈ w.rayDegrees, d.degree n ≤ k}

/-- A ray occurs at an order precisely when an actual degree on it meets the cutoff. -/
@[simp]
theorem mem_raysAtOrder {k : ℕ} {w : SupportedRay d} :
    w ∈ d.raysAtOrder k ↔ ∃ n ∈ w.rayDegrees, d.degree n ≤ k := Iff.rfl

/-- Increasing the order retains all previously occurring rays. -/
theorem raysAtOrder_mono : Monotone d.raysAtOrder := by
  intro k l h w hw
  obtain ⟨n, hn, hk⟩ := hw
  exact ⟨n, hn, hk.trans (Int.ofNat_le.mpr h)⟩

/-- No supported ray occurs at order zero. -/
@[simp]
theorem raysAtOrder_zero : d.raysAtOrder 0 = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  rintro w ⟨n, hn, hk⟩
  have := d.degree_pos hn.1 (SupportedRay.ne_zero_of_mem_rayDegrees hn)
  omega

/-- Only finitely many supported rays meet each degree cutoff. Finiteness is
measured on actual degrees, rather than on all primitive vectors of bounded degree. -/
theorem finite_raysAtOrder [HasUniqueDiv N] (k : ℕ) : (d.raysAtOrder k).Finite := by
  have hsingle (n : N) : {w : SupportedRay d | n ∈ w.rayDegrees}.Finite :=
    Set.Subsingleton.finite fun _ hv _ hw => SupportedRay.eq_of_mem_rayDegrees hv hw
  apply ((d.finite_cutoff k).biUnion fun n _ => hsingle n).subset
  rintro w ⟨n, hn, hk⟩
  exact Set.mem_iUnion₂.mpr ⟨n, d.mem_cutoff.mpr ⟨hn.1, hk⟩, hn⟩

/-- Every nonzero allowed degree in a free integer module has a supported ray. -/
theorem exists_supportedRay [Module.Free ℤ N] {n : N} (hn : n ∈ d.monoid)
    (hne : n ≠ 0) : ∃ w : SupportedRay d, n ∈ w.rayDegrees := by
  obtain ⟨a, w, ha, hw, hnw⟩ := exists_eq_zsmul_isPrimitive hne
  exact ⟨⟨w, hw, a, ha, hnw ▸ hn⟩, hn, a, ha, hnw⟩

/-- Every nonzero allowed degree lies on a unique supported ray, with a unique
positive integer multiplier of its primitive generator. -/
theorem existsUnique_supportedRay_multiplier [Module.Free ℤ N] {n : N}
    (hn : n ∈ d.monoid) (hne : n ≠ 0) :
    ∃! p : SupportedRay d × ℤ, 0 < p.2 ∧ n = p.2 • p.1.generator := by
  let : HasUniqueDiv N := .of_isTorsionFree ℤ N
  obtain ⟨w, hw⟩ := d.exists_supportedRay hn hne
  obtain ⟨a, ha, _⟩ := SupportedRay.existsUnique_multiplier hw
  refine ⟨(w, a), ha, ?_⟩
  rintro ⟨v, b⟩ hb
  have hv : n ∈ v.rayDegrees := ⟨hn, b, hb⟩
  have hvw := SupportedRay.eq_of_mem_rayDegrees hv hw
  subst v
  exact Prod.ext rfl (w.isPrimitive.zsmul_left_injective (hb.2.symm.trans ha.2))

/-- The ray degree sets partition the nonzero part of the allowed monoid. -/
theorem iUnion_rayDegrees [Module.Free ℤ N] :
    ⋃ w : SupportedRay d, w.rayDegrees = (d.monoid : Set N) \ {0} := by
  ext n
  simp only [Set.mem_iUnion, Set.mem_sdiff, SetLike.mem_coe, Set.mem_singleton_iff]
  exact ⟨fun ⟨w, hw⟩ => ⟨hw.1, SupportedRay.ne_zero_of_mem_rayDegrees hw⟩,
    fun ⟨hn, hne⟩ => d.exists_supportedRay hn hne⟩

end PositiveDegrees
end TauCeti
