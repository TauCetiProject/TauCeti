module

public import Mathlib.Algebra.Group.Action.Units
public import Mathlib.Algebra.Group.Subgroup.Ker
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.Algebra.Group.ULift
public import Mathlib.Data.Int.Cast.Lemmas
public import Mathlib.Data.Int.Order.Units

/-!
# Equality and squares of signs

The group `ℤˣ = {±1}` has exponent two, so two signs are equal exactly when their product is `1`.
This is the form in which an equality of two products of Hilbert symbols is checked, by expanding
both sides into one common product of symbols. For the same reason, the image of a sign in any
ring squares to `1`. Read on the copy `ULift ℤˣ` of `ℤˣ` in any universe, the image of a sign in
the units of a ring is a character `ULift ℤˣ →* kˣ`, used where a group acting on spaces of an
arbitrary universe must lie in that universe.

## Main definitions

* `TauCeti.uliftIntUnitsSign`: the sign character `ULift ℤˣ →* kˣ` of the copy `ULift ℤˣ` of `ℤˣ`
  in any universe.

## Main results

* `Int.units_eq_iff_mul_eq_one`: `u = v ↔ u * v = 1` for signs `u v : ℤˣ`.
* `Int.units_eq_iff_eq_of_mul_eq_mul`: if `u * v = u' * v'` then `u = v ↔ u' = v'`.
* `Int.cast_units_sq`, `Int.cast_units_mul_self`: the square of a sign, cast to any ring, is `1`.
* `Int.units_smul_eq_cast_mul`: a sign acts on a ring by multiplication by its image.
* `Int.unitsMap_castRingHom_eq_one_iff`: the image of a sign `u` in a ring `R` is `1` exactly when
  `u = 1` or `2 = 0` in `R`.
* `Int.range_unitsMap_castRingHom`: the images of the signs in the units of a ring `R` form the
  subgroup `{±1}` generated by `-1`.
* `Int.exists_apply_eq_and_apply_eq`: two `ℤ`-valued functions that take all four pairs of signs at
  four points take every pair of signs.
* `Int.lt_units_mul_iff`: `(d : ℤ) < w * y` holds iff `(d : ℤ) < |y|` and `w`
  matches the sign of `y`.
* `TauCeti.uliftIntUnitsSign_apply`: the sign character sends `g` to the image of `g.down` in `k`.
-/

public section

namespace Int

/-- Two signs are equal exactly when their product is `1`. -/
theorem units_eq_iff_mul_eq_one (u v : ℤˣ) : u = v ↔ u * v = 1 := by
  rw [mul_eq_one_iff_eq_inv, Int.units_inv_eq_self]

/-- Two pairs of signs with the same product agree in the same cases: if `u * v = u' * v'` then
`u = v` exactly when `u' = v'`. -/
theorem units_eq_iff_eq_of_mul_eq_mul {u v u' v' : ℤˣ} (h : u * v = u' * v') :
    u = v ↔ u' = v' := by
  rw [Int.units_eq_iff_mul_eq_one u v, Int.units_eq_iff_mul_eq_one u' v', h]

/-- The square of a sign `u : ℤˣ`, cast to any ring, is `1`. -/
@[simp]
theorem cast_units_sq {R : Type*} [Ring R] (u : ℤˣ) : ((u : ℤ) : R) ^ 2 = 1 := by
  rcases Int.units_eq_one_or u with rfl | rfl <;> simp

/-- The image of a sign `u : ℤˣ` in any ring, multiplied by itself, is `1`. -/
theorem cast_units_mul_self {R : Type*} [Ring R] (u : ℤˣ) : ((u : ℤ) : R) * ((u : ℤ) : R) = 1 := by
  rw [← sq, cast_units_sq]

/-- The image of a sign `u : ℤˣ` in a nontrivial ring is nonzero. -/
theorem cast_units_ne_zero {R : Type*} [Ring R] [Nontrivial R] (u : ℤˣ) : ((u : ℤ) : R) ≠ 0 :=
  fun h ↦ by simpa [h] using cast_units_sq (R := R) u

/-- A sign `u : ℤˣ` acts on a ring by multiplication by its image: `u • c = u * c`. -/
theorem units_smul_eq_cast_mul {R : Type*} [Ring R] (u : ℤˣ) (c : R) :
    u • c = ((u : ℤ) : R) * c := by
  rw [Units.smul_def, zsmul_eq_mul]

/-- The image of a sign `u : ℤˣ` in the units of a ring `R` is `1` exactly when `u = 1` or
`2 = 0` in `R`. -/
theorem unitsMap_castRingHom_eq_one_iff {R : Type*} [Ring R] (u : ℤˣ) :
    Units.map (Int.castRingHom R).toMonoidHom u = 1 ↔ u = 1 ∨ (2 : R) = 0 := by
  rcases Int.units_eq_one_or u with rfl | rfl
  · simp
  · simp [Units.ext_iff, neg_eq_iff_add_eq_zero, one_add_one_eq_two]

/-- The images of the signs `±1` in the units of a ring `R` form the subgroup generated by `-1`. -/
theorem range_unitsMap_castRingHom (R : Type*) [Ring R] :
    (Units.map (Int.castRingHom R : ℤ →* R)).range = Subgroup.zpowers (-1) := by
  refine le_antisymm ?_ (Subgroup.zpowers_le.2 ⟨-1, by ext; simp⟩)
  rintro _ ⟨u, rfl⟩
  rcases Int.units_eq_one_or u with rfl | rfl
  · rw [map_one]
    exact one_mem _
  · exact Subgroup.mem_zpowers_iff.2 ⟨1, by ext; simp⟩

/-- Two `ℤ`-valued functions that take the four sign pairs at four points take every pair of
signs. -/
theorem exists_apply_eq_and_apply_eq {α : Type*} {f g : α → ℤ} {a₁ a₂ a₃ a₄ : α}
    (h₁ : f a₁ = 1 ∧ g a₁ = 1) (h₂ : f a₂ = 1 ∧ g a₂ = -1)
    (h₃ : f a₃ = -1 ∧ g a₃ = 1) (h₄ : f a₄ = -1 ∧ g a₄ = -1) (ε ε' : ℤˣ) :
    ∃ a, f a = ε ∧ g a = ε' := by
  rcases Int.units_eq_one_or ε with rfl | rfl <;> rcases Int.units_eq_one_or ε' with rfl | rfl
  · exact ⟨a₁, by simpa using h₁.1, by simpa using h₁.2⟩
  · exact ⟨a₂, by simpa using h₂.1, by simpa using h₂.2⟩
  · exact ⟨a₃, by simpa using h₃.1, by simpa using h₃.2⟩
  · exact ⟨a₄, by simpa using h₄.1, by simpa using h₄.2⟩

/-- `w * y > d` holds iff `|y| > d` and `w` agrees with the sign of `y`. -/
theorem lt_units_mul_iff {d : ℕ} {w : ℤˣ} {y : ℤ} :
    (d : ℤ) < w * y ↔
      (d : ℤ) < |y| ∧ (0 < y → w = 1) ∧ (y < 0 → w = -1) := by
  rcases Int.units_eq_one_or w with rfl | rfl <;> simp [lt_abs, Units.ext_iff] <;> omega

end Int

namespace TauCeti

universe u w

variable (k : Type u) [Ring k]

/-- **The sign character of `ULift ℤˣ`.** The character `ULift ℤˣ →* kˣ` sending `⟨u⟩` to the
image of `u` in `k`: the sign character `ℤˣ →* kˣ` induced by `ℤ → k`, read on the copy
`ULift ℤˣ` of `ℤˣ` in any universe through `MulEquiv.ulift`. -/
def uliftIntUnitsSign : ULift.{w} ℤˣ →* kˣ :=
  (Units.map (Int.castRingHom k).toMonoidHom).comp MulEquiv.ulift.toMonoidHom

/-- The sign character of `ULift ℤˣ` sends `g` to the image of `g.down` in `k`. -/
@[simp]
theorem uliftIntUnitsSign_apply (g : ULift.{w} ℤˣ) :
    (uliftIntUnitsSign k g : k) = ((g.down : ℤ) : k) :=
  (rfl)

end TauCeti
