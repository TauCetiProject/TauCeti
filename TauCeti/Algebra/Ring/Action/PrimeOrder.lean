module

public import Mathlib.Algebra.Group.Action.Pointwise.Finset
public import Mathlib.Algebra.Ring.Action.Basic
public import Mathlib.Data.Nat.Prime.Defs
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.SetTheory.Cardinal.Finite
public import TauCeti.GroupTheory.GroupAction.Orbit.Sum
import Mathlib.Algebra.BigOperators.Ring.Finset
import TauCeti.Algebra.BigOperators.Finset.Powerset
import TauCeti.GroupTheory.GroupAction.Stabilizer

/-!
# The norm of `1 + x` under an action of a group of prime order

Let a finite group `G` act on a commutative semiring `R` by semiring automorphisms. Expanding the
product `∏_{g ∈ G} (1 + g • x)` gives the sum, over all subsets `S ⊆ G`, of the products
`∏_{h ∈ S} h • x`. The empty subset contributes `1`, the full subset contributes the "norm"
`∏_{g} g • x`, and `G` permutes the remaining subsets by translation. When `G` has prime order,
every nonempty proper subset has trivial stabilizer, so the sum over each orbit of subsets is the
"trace" `∑_{g} g • z` of the product `z` attached to any one of its members; the singletons form
one such orbit, with trace `∑_{g} g • x`. Collecting the orbits of the subsets with at least two
elements gives

`∏_{g} (1 + g • x) = 1 + ∑_{g} g • x + ∑_{g} g • y + ∏_{g} g • x`

for an element `y` of the square of the ideal generated by the orbit of `x`.

This is the identity behind the computation of the norm on the unit filtration of a cyclic
extension of local fields of prime degree (Serre, *Local Fields*, Chapter V, §3, Lemma 5): there
`x` lies in a power `𝓂^m` of the maximal ideal, so `y` lies in `𝓂^(2m)`, and the valuations of the
two traces are read off from the behaviour of the trace on powers of the maximal ideal.

## Main results

* `TauCeti.MulSemiringAction.prod_smul_finset_smul`: translating a subset of `G` acts on the
  attached product of conjugates by the translating element.
* `TauCeti.MulSemiringAction.prod_smul_mem_span_orbit_sq_of_one_lt_card`: the product attached
  to a subset with at least two elements lies in the square of the ideal generated by the orbit.
* `TauCeti.MulSemiringAction.exists_prod_one_add_smul_eq_of_prime_card`: the expansion above.

## References

* J.-P. Serre, *Local Fields*, Chapter V, §3, Lemma 5.
-/

public section

open Finset
open scoped Pointwise

namespace TauCeti.MulSemiringAction

variable {G R : Type*} [Group G] [CommSemiring R] [MulSemiringAction G R]

/-- Translating a finite subset `S` of the acting group by `g` acts on the product
`∏_{h ∈ S} h • x` of the corresponding conjugates of `x` by `g`. -/
theorem prod_smul_finset_smul [DecidableEq G] (g : G) (S : Finset G) (x : R) :
    ∏ h ∈ g • S, h • x = g • ∏ h ∈ S, h • x := by
  rw [Finset.smul_finset_def, prod_image (MulAction.injective g).injOn]
  simp_rw [smul_eq_mul, mul_smul]
  exact (map_prod (_root_.MulSemiringAction.toRingHom G R g) _ _).symm

/-- The product of the conjugates of `x` indexed by a subset of the acting group with at least
two elements lies in the square of the ideal generated by the orbit of `x`. -/
theorem prod_smul_mem_span_orbit_sq_of_one_lt_card {S : Finset G} (hS : 1 < S.card) (x : R) :
    ∏ h ∈ S, h • x ∈ Ideal.span (MulAction.orbit G x) ^ 2 := by
  classical
  obtain ⟨a, b, ha, hb, hab⟩ := one_lt_card_iff.1 hS
  rw [← mul_prod_erase S _ ha, ← mul_prod_erase (S.erase a) _ (mem_erase.2 ⟨hab.symm, hb⟩),
    ← mul_assoc, sq]
  exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_mul (Ideal.subset_span (MulAction.mem_orbit x a))
    (Ideal.subset_span (MulAction.mem_orbit x b)))

variable (G) in
/-- **The product `∏_{g} (1 + g • x)` for a group of prime order.** If `G` is a group of prime
order acting on a commutative semiring `R` by semiring automorphisms, then

`∏_{g} (1 + g • x) = 1 + ∑_{g} g • x + ∑_{g} g • y + ∏_{g} g • x`

for some `y` in the square of the ideal generated by the orbit of `x`. The element `y` is the
sum, over a set of representatives of the translation orbits of the subsets of `G` with at least
two elements other than `G` itself, of the products of the conjugates of `x` indexed by the
subset. -/
theorem exists_prod_one_add_smul_eq_of_prime_card [Fintype G] (hG : (Nat.card G).Prime) (x : R) :
    ∃ y ∈ Ideal.span (MulAction.orbit G x) ^ 2,
      ∏ g : G, (1 + g • x) = 1 + ∑ g : G, g • x + ∑ g : G, g • y + ∏ g : G, g • x := by
  classical
  -- The subsets of `G` with at least two elements, other than `G` itself.
  set B : Finset (Finset G) := univ.filter fun S : Finset G ↦ 1 < S.card ∧ S ≠ univ with hB
  have hmemB : ∀ S, S ∈ B ↔ 1 < S.card ∧ S ≠ univ := fun S ↦ by
    rw [hB, mem_filter, and_iff_right (mem_univ S)]
  -- They form a free `G`-set under translation, on which `S ↦ ∏_{h ∈ S} h • x` is equivariant.
  have hBsmul : ∀ (g : G), ∀ S ∈ B, g • S ∈ B := fun g S hS ↦ by
    rw [hmemB] at hS ⊢
    refine ⟨by rw [card_smul_finset]; exact hS.1, fun h ↦ hS.2 ?_⟩
    rwa [← smul_finset_univ (a := g), smul_left_cancel_iff] at h
  have hBstab : ∀ S ∈ B, MulAction.stabilizer G S = ⊥ := fun S hS ↦ by
    rw [hmemB] at hS
    exact stabilizer_finset_eq_bot_of_prime_card hG (card_pos.1 (by omega)) hS.2
  obtain ⟨y, hy, hsumB⟩ := TauCeti.MulAction.exists_sum_eq_sum_smul_of_stabilizer_eq_bot hBsmul
    hBstab (f := fun S : Finset G ↦ ∏ h ∈ S, h • x) fun g S _ ↦ prod_smul_finset_smul g S x
  refine ⟨y, ?_, ?_⟩
  · -- Each product indexed by a subset with two distinct elements lies in the square of the ideal.
    refine (AddSubmonoid.closure_le (S := (Ideal.span (MulAction.orbit G x) ^ 2).toAddSubmonoid)).2
      ?_ hy
    rintro _ ⟨S, hS, rfl⟩
    rw [mem_coe, hmemB] at hS
    exact prod_smul_mem_span_orbit_sq_of_one_lt_card hS.1 x
  · -- Expand the product over all subsets of `G` and split off `∅`, the singletons and `univ`.
    rw [prod_one_add, sum_powerset_eq_add_sum_singleton_add_sum_filter_add
      (by rw [card_univ, ← Nat.card_eq_fintype_card]; exact hG.one_lt), powerset_univ, ← hB,
      hsumB, prod_empty]
    simp only [prod_singleton]

end TauCeti.MulSemiringAction
