module

public import Mathlib.LinearAlgebra.LinearIndependent.Defs
public import TauCeti.Algebra.Ring.Action.ConjAct
import TauCeti.Algebra.Group.Units.Basic

/-!
# Skew Laurent extensions of subsemirings

For a subsemiring `C ≤ B` and an ambient unit `x : Bˣ`, `Subsemiring.laurentAdjoin C x` is the
subsemiring `C ⊔ Subsemiring.closure {x, x⁻¹}` generated by `C` and `x^{±1}`, and
`Subsemiring.skewLaurentSum C x : (ℤ →₀ C) →+ B` evaluates finite left Laurent expansions
`∑_m f(m) * x^m`. Injectivity of `C.skewLaurentSum x` is left `C`-linear independence of integer
powers of `x` (`Subsemiring.injective_skewLaurentSum_iff_linearIndependent`), and when `x`
normalizes `C` under `ConjAct`, finite left Laurent expansions span the entire Laurent extension
(`Subsemiring.range_skewLaurentSum`).
-/

public section

open scoped Pointwise

namespace Subsemiring

variable {B : Type*} [Semiring B]

/-- The subsemiring `C[x^{±1}] = C ⊔ Subsemiring.closure {x, x⁻¹}` generated by `C` and `x^{±1}`. -/
def laurentAdjoin (C : Subsemiring B) (x : Bˣ) : Subsemiring B :=
  C ⊔ Subsemiring.closure {(x : B), ((x⁻¹ : Bˣ) : B)}

theorem laurentAdjoin_def (C : Subsemiring B) (x : Bˣ) :
    C.laurentAdjoin x = C ⊔ Subsemiring.closure {(x : B), ((x⁻¹ : Bˣ) : B)} :=
  (rfl)

theorem le_laurentAdjoin (C : Subsemiring B) (x : Bˣ) : C ≤ C.laurentAdjoin x :=
  le_sup_left

theorem coe_mem_laurentAdjoin (C : Subsemiring B) (x : Bˣ) : (x : B) ∈ C.laurentAdjoin x :=
  (le_sup_right : Subsemiring.closure _ ≤ C.laurentAdjoin x) <| subset_closure <| by simp

theorem coe_inv_mem_laurentAdjoin (C : Subsemiring B) (x : Bˣ) :
    ((x⁻¹ : Bˣ) : B) ∈ C.laurentAdjoin x :=
  (le_sup_right : Subsemiring.closure _ ≤ C.laurentAdjoin x) <| subset_closure <| by simp

theorem coe_zpow_mem_laurentAdjoin (C : Subsemiring B) (x : Bˣ) (m : ℤ) :
    ((x ^ m : Bˣ) : B) ∈ C.laurentAdjoin x := by
  induction m using Int.induction_on with
  | zero => simp [(C.laurentAdjoin x).one_mem]
  | succ _ hk => rw [zpow_add_one, Units.val_mul]; exact mul_mem hk (C.coe_mem_laurentAdjoin x)
  | pred _ hk => rw [zpow_sub_one, Units.val_mul]; exact mul_mem hk (C.coe_inv_mem_laurentAdjoin x)

/-- Universal property of `Subsemiring.laurentAdjoin`: `C.laurentAdjoin x ≤ T` if and only if
`C ≤ T` and both `x` and `x⁻¹` belong to `T`. -/
theorem laurentAdjoin_le_iff {C T : Subsemiring B} {x : Bˣ} :
    C.laurentAdjoin x ≤ T ↔ C ≤ T ∧ (x : B) ∈ T ∧ ((x⁻¹ : Bˣ) : B) ∈ T := by
  rw [laurentAdjoin_def, sup_le_iff, closure_le, Set.insert_subset_iff, Set.singleton_subset_iff,
    SetLike.mem_coe, SetLike.mem_coe]

/-- `Subsemiring.laurentAdjoin` is monotone in the base subsemiring `C`. -/
@[gcongr]
theorem laurentAdjoin_mono {C₁ C₂ : Subsemiring B} (h : C₁ ≤ C₂) (x : Bˣ) :
    C₁.laurentAdjoin x ≤ C₂.laurentAdjoin x :=
  sup_le_sup_right h _

/-- Evaluation of finite left Laurent expansions `f ↦ ∑_m f(m) * x^m` with coefficients in `C`. -/
def skewLaurentSum (C : Subsemiring B) (x : Bˣ) : (ℤ →₀ C) →+ B where
  toFun f := f.sum fun m c ↦ (c : B) * ((x ^ m : Bˣ) : B)
  map_zero' := Finsupp.sum_zero_index
  map_add' _ _ := Finsupp.sum_add_index' (fun _ ↦ zero_mul _) (fun _ _ _ ↦ add_mul _ _ _)

theorem skewLaurentSum_apply (C : Subsemiring B) (x : Bˣ) (f : ℤ →₀ C) :
    C.skewLaurentSum x f = f.sum fun m c ↦ (c : B) * ((x ^ m : Bˣ) : B) :=
  (rfl)

@[simp]
theorem skewLaurentSum_single (C : Subsemiring B) (x : Bˣ) (m : ℤ) (c : C) :
    C.skewLaurentSum x (Finsupp.single m c) = (c : B) * ((x ^ m : Bˣ) : B) := by
  rw [skewLaurentSum_apply, Finsupp.sum_single_index (zero_mul _)]

/-- `C.skewLaurentSum x` agrees with `Finsupp.linearCombination C` on integer powers of `x`. -/
theorem skewLaurentSum_eq_linearCombination (C : Subsemiring B) (x : Bˣ) (f : ℤ →₀ C) :
    C.skewLaurentSum x f = Finsupp.linearCombination C (fun m : ℤ ↦ ((x ^ m : Bˣ) : B)) f := by
  simp [skewLaurentSum_apply, Finsupp.linearCombination_apply, Subsemiring.smul_def]

/-- Injectivity of `C.skewLaurentSum x` is left `C`-linear independence of integer powers of `x`. -/
theorem injective_skewLaurentSum_iff_linearIndependent (C : Subsemiring B) (x : Bˣ) :
    Function.Injective (C.skewLaurentSum x) ↔
      LinearIndependent C (fun m : ℤ ↦ ((x ^ m : Bˣ) : B)) := by
  have h : (C.skewLaurentSum x : (ℤ →₀ C) → B) =
      Finsupp.linearCombination C (fun m : ℤ ↦ ((x ^ m : Bˣ) : B)) :=
    funext (C.skewLaurentSum_eq_linearCombination x)
  rw [LinearIndependent, h]

theorem skewLaurentSum_mem_laurentAdjoin (C : Subsemiring B) (x : Bˣ) (f : ℤ →₀ C) :
    C.skewLaurentSum x f ∈ C.laurentAdjoin x := by
  induction f using Finsupp.induction_linear with
  | zero => simp [(C.laurentAdjoin x).zero_mem]
  | add _ _ hf hg => rw [map_add]; exact add_mem hf hg
  | single m c =>
    rw [skewLaurentSum_single]
    exact mul_mem (C.le_laurentAdjoin x c.property) (C.coe_zpow_mem_laurentAdjoin x m)

/-- Multiplying `C.skewLaurentSum x f` on the right by `b ∈ C` twists each coefficient by `x^m`
conjugation whenever `x` normalizes `C`. -/
theorem skewLaurentSum_mul_right_of_mem {C : Subsemiring B} {x : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (f : ℤ →₀ C) {b : B} (hb : b ∈ C) :
    C.skewLaurentSum x f * b =
      C.skewLaurentSum x (f.sum fun m c ↦
        Finsupp.single m (c * ⟨((x ^ m : Bˣ) : B) * b * ((x ^ (-m) : Bˣ) : B),
          conj_zpow_mem hx m hb⟩)) := by
  rw [map_finsuppSum, skewLaurentSum_apply, Finsupp.sum, Finsupp.sum, Finset.sum_mul]
  exact Finset.sum_congr rfl fun m _ ↦ by
    rw [skewLaurentSum_single, Subsemiring.coe_mul]
    dsimp only
    rw [mul_assoc ((f m : C) : B), mul_assoc ((f m : C) : B), ← Units.zpow_mul_eq_conj_mul_zpow]

/-- When `x` normalizes `C`, finite left Laurent expansions span the entire Laurent extension
`C.laurentAdjoin x`. -/
theorem range_skewLaurentSum {C : Subsemiring B} {x : Bˣ} (hx : ConjAct.toConjAct x • C = C) :
    Set.range (C.skewLaurentSum x) = (C.laurentAdjoin x : Set B) := by
  refine Set.Subset.antisymm (by rintro _ ⟨f, rfl⟩; exact C.skewLaurentSum_mem_laurentAdjoin x f) ?_
  let M := AddMonoidHom.mrange (C.skewLaurentSum x)
  have hmul : ∀ {a b : B}, a ∈ M → b ∈ M → a * b ∈ M := by
    rintro _ _ ⟨f, rfl⟩ ⟨g, rfl⟩
    induction f using Finsupp.induction_linear with
    | zero => simp [M.zero_mem]
    | add _ _ hf₁ hf₂ => rw [map_add, add_mul]; exact M.add_mem hf₁ hf₂
    | single m c₁ =>
      induction g using Finsupp.induction_linear with
      | zero => simp [M.zero_mem]
      | add _ _ hg₁ hg₂ => rw [map_add, mul_add]; exact M.add_mem hg₁ hg₂
      | single n c₂ =>
        refine ⟨Finsupp.single (m + n) ⟨(c₁ : B) * (((x ^ m : Bˣ) : B) * (c₂ : B) *
          ((x ^ (-m) : Bˣ) : B)), C.mul_mem c₁.property (conj_zpow_mem hx m c₂.property)⟩, ?_⟩
        simp only [skewLaurentSum_single, zpow_add, Units.val_mul]
        rw [← mul_assoc _ ((x ^ m : Bˣ) : B), mul_assoc (c₁ : B), ← Units.zpow_mul_eq_conj_mul_zpow]
        simp only [mul_assoc]
  let S : Subsemiring B := { M with one_mem' := ⟨Finsupp.single 0 1, by simp⟩, mul_mem' := hmul }
  suffices C.laurentAdjoin x ≤ S from this
  exact laurentAdjoin_le_iff.mpr ⟨fun c hc ↦ ⟨Finsupp.single 0 ⟨c, hc⟩, by simp⟩,
    ⟨Finsupp.single 1 1, by simp⟩, ⟨Finsupp.single (-1) 1, by simp⟩⟩

end Subsemiring
