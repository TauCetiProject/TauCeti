/-!
# The Moufang identities and Artin's theorem for the double of the quaternions

The Cayley–Dickson double `CayleyDickson ℍ[R]` of the quaternions over a commutative ring `R`, the
octonions when `R = ℝ`, is not associative, but it is **alternative**: the left and right
alternative laws and the flexible law of `TauCeti.Algebra.CayleyDickson.Quaternion` say that the
associator `(a * b) * c - a * (b * c)` vanishes whenever two of its arguments are equal. This file
proves the two standard consequences of alternativity for this algebra.

* The three **Moufang identities**
  `(z * x * z) * y = z * (x * (z * y))`, `x * (z * y * z) = ((x * z) * y) * z` and
  `(z * x) * (y * z) = (z * (x * y)) * z`.
* **Artin's theorem**: any two elements `x` and `y` generate an associative subalgebra. Here the
  subalgebra generated by `x` and `y` is `NonUnitalAlgebra.adjoin R {1, x, y}`, the smallest
  subalgebra containing the unit, `x` and `y`. It is the span of `1`, `x`, `y` and `x * y`, and
  it is closed under conjugation by `TauCeti.CayleyDickson.star_mem_of_one_mem`.

## Main results

* `TauCeti.CayleyDickson.moufang_left`, `TauCeti.CayleyDickson.moufang_right` and
  `TauCeti.CayleyDickson.moufang_middle`: the **Moufang identities**.
* `TauCeti.CayleyDickson.associator_swap_left` and `TauCeti.CayleyDickson.associator_swap_right`:
  the associator is alternating, so it changes sign when two arguments are swapped.
* `TauCeti.CayleyDickson.adjoin_toSubmodule_eq_span`: the subalgebra generated by `x` and `y` is
  the span of `1`, `x`, `y` and `x * y`.
* `TauCeti.CayleyDickson.mul_assoc_of_mem_adjoin`: **Artin's theorem**, the subalgebra generated
  by two elements is associative.

## Implementation notes

Nothing here is proved in coordinates beyond the alternative laws and the rank-two equation of
`TauCeti.Algebra.CayleyDickson.Quaternion`: expanding a Moufang identity into the eight coordinates
gives polynomials of degree four that are expensive to normalize. Instead the antisymmetry of the
associator is the linearization of the alternative laws, and the Moufang identities come from the
Teichmüller identity `associator_cocycle` of Mathlib. At `z, z, x, y` it gives
`associator z (z * x) y = star z * associator z x y`, because `z * z` is a combination of `z` and
`1`. The left Moufang identity is the sum of two such terms with opposite signs, the middle one
follows in the same way after `y * z` is traded for `z * y`, and the right one is the left one read
through the involution, which reverses products.

For Artin's theorem, the span of `1`, `x`, `y` and `x * y` is closed under multiplication because
every element is a root of its rank-two equation `a * a = T a • a - N a • 1`. This equation
reduces `x * x` and `y * y`, and at `x + y` it writes `y * x` in terms of `x * y`; the alternative
and flexible laws then reduce the products of `x * y` with `x` and `y`. The associator is linear in
each argument (`TauCeti.associator_eq_zero_of_mem_span`), so it is enough that it vanishes on
triples from `1`, `x`, `y` and `x * y`. Being alternating, it vanishes on a triple with a repeated
entry, and the only remaining triples are the permutations of `(x, x * y, y)`. On that one the left
and right alternative laws give `(x * (x * y)) * y = (x * x) * (y * y) = x * ((x * y) * y)`.

## References

* R. D. Schafer, *An Introduction to Nonassociative Algebras*, Academic Press (1966), Chapter III,
  for alternative algebras, the Moufang identities and Artin's theorem.
* T. A. Springer and F. D. Veldkamp, *Octonions, Jordan Algebras and Exceptional Groups*,
  Springer (2000), Chapter 1, for the Moufang identities in composition algebras.
-/

public section

open scoped Quaternion

namespace TauCeti

namespace CayleyDickson

variable {R : Type*} [CommRing R]

/-! ### The associator is alternating -/

section Associator

variable (x y z : CayleyDickson ℍ[R])

/-- The associator vanishes when its first two arguments agree: the left alternative law. -/
@[simp]
theorem associator_self_left : associator x x y = 0 :=
  sub_eq_zero.2 (left_alternative x y)

/-- The associator vanishes when its last two arguments agree: the right alternative law. -/
@[simp]
theorem associator_self_right : associator x y y = 0 :=
  sub_eq_zero.2 (right_alternative x y)

/-- The associator vanishes when its first and last arguments agree: the flexible law. -/
@[simp]
theorem associator_self_outer : associator x y x = 0 :=
  sub_eq_zero.2 (flexible x y)

/-- The associator changes sign when its first two arguments are swapped. -/
theorem associator_swap_left : associator y x z = -associator x y z := by
  -- The left alternative law at `x + y`.
  have h := associator_self_left (x + y) z
  rw [associator_add_left, associator_add_middle, associator_add_middle, associator_self_left,
    associator_self_left] at h
  linear_combination (norm := module) h

/-- The associator changes sign when its last two arguments are swapped. -/
theorem associator_swap_right : associator x z y = -associator x y z := by
  -- The right alternative law at `y + z`.
  have h := associator_self_right x (y + z)
  rw [associator_add_middle, associator_add_right, associator_add_right, associator_self_right,
    associator_self_right] at h
  linear_combination (norm := module) h

end Associator

/-! ### The Moufang identities -/

section Moufang

/-- Left multiplication by `z` in the middle argument of `associator z · y` is left
multiplication by `star z` outside. -/
private theorem associator_mul_middle (x y z : CayleyDickson ℍ[R]) :
    associator z (z * x) y = star z * associator z x y := by
  -- The Teichmüller identity at `z, z, x, y`, where by the rank-two equation
  -- `associator (z * z) x y = T z • associator z x y`.
  have h := associator_cocycle z z x y
  have hzz : associator (z * z) x y = trace z • associator z x y := by
    have h₁ := congrArg (associator · x y) (mul_self z)
    simp only [sub_eq_add_neg, ← neg_smul, associator_add_left, associator_smul_left] at h₁
    rw [h₁, associator_one_left, smul_zero, add_zero]
  rw [associator_self_left, associator_self_left, zero_mul, hzz] at h
  rw [star_eq_trace_smul_one_sub, sub_mul, smul_mul_assoc, one_mul]
  linear_combination (norm := module) h

variable (x y z : CayleyDickson ℍ[R])

/-- **The left Moufang identity**: `(z * x * z) * y = z * (x * (z * y))`. -/
theorem moufang_left : z * x * z * y = z * (x * (z * y)) := by
  -- The difference is `associator (z * x) z y + associator z x (z * y)`. Bringing the products with
  -- `z` to the middle argument, both terms are `star z * associator z x y`, with opposite signs.
  have h : z * x * z * y - z * (x * (z * y)) =
      associator (z * x) z y + associator z x (z * y) := by
    simp only [associator_apply]
    abel
  rw [associator_swap_left z (z * x) y, associator_swap_right z (z * y) x, associator_mul_middle,
    associator_mul_middle, associator_swap_right z x y] at h
  simpa [sub_eq_zero] using h

/-- **The right Moufang identity**: `x * (z * y * z) = ((x * z) * y) * z`. -/
theorem moufang_right : x * (z * y * z) = x * z * y * z := by
  -- The left identity read through the involution, which reverses products; the flexible law puts
  -- the two brackets of `z * y * z` in the shape the involution produces.
  have h := congrArg star (moufang_left (star y) (star x) (star z))
  simp only [star_mul, star_star] at h
  rw [flexible z y]
  exact h

/-- **The middle Moufang identity**: `(z * x) * (y * z) = (z * (x * y)) * z`. -/
theorem moufang_middle : z * x * (y * z) = z * (x * y) * z := by
  -- By the flexible law the difference is `associator z x (y * z) - z * associator x y z`. Writing
  -- `y * z` as `z * y` plus terms in `1`, `y` and `z` by the polarized rank-two equation, the first
  -- term is `z * associator z x y`, and the associator is invariant under cyclic permutations.
  have h : z * x * (y * z) - z * (x * y) * z = associator z x (y * z) - z * associator x y z := by
    rw [flexible z (x * y)]
    simp only [associator_apply, mul_sub]
    abel
  have hyz : associator z (z * y) x + associator z (y * z) x = trace z • associator z y x := by
    rw [← associator_add_middle, mul_add_mul_comm]
    simp [associator_add_middle, associator_smul_middle]
  rw [associator_mul_middle, star_eq_trace_smul_one_sub, sub_mul, smul_mul_assoc, one_mul] at hyz
  -- Reversing the arguments of the associator is an odd permutation.
  have hrev : associator x y z = -associator z y x := by
    rw [associator_swap_left y x z, associator_swap_right y z x, associator_swap_left z y x,
      neg_neg]
  rw [associator_swap_right z (y * z) x, hrev, mul_neg] at h
  rw [← sub_eq_zero, h]
  linear_combination (norm := module) -hyz

end Moufang

/-! ### Artin's theorem -/

section Artin

variable {x y : CayleyDickson ℍ[R]}

/-- A linear combination of `1`, `x`, `y` and `x * y` lies in their span. -/
private theorem mem_span_of_eq {z : CayleyDickson ℍ[R]} (a b c d : R)
    (h : z = a • 1 + b • x + c • y + d • (x * y)) :
    z ∈ Submodule.span R {1, x, y, x * y} := by
  subst h
  refine add_mem (add_mem (add_mem ?_ ?_) ?_) ?_ <;>
    exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))

/-- The span of `1`, `x`, `y` and `x * y` is closed under multiplication. -/
private theorem mul_mem_span {a b : CayleyDickson ℍ[R]}
    (ha : a ∈ Submodule.span R {1, x, y, x * y}) (hb : b ∈ Submodule.span R {1, x, y, x * y}) :
    a * b ∈ Submodule.span R {1, x, y, x * y} := by
  -- The span of the products of the four generators is the span of all products, so it is enough
  -- to write each product of two generators as a linear combination of the generators.
  have key : ∀ a ∈ ({1, x, y, x * y} : Set (CayleyDickson ℍ[R])),
      ∀ b ∈ ({1, x, y, x * y} : Set (CayleyDickson ℍ[R])),
        a * b ∈ Submodule.span R {1, x, y, x * y} := by
    set p := normSq x + normSq y - normSq (x + y)
    have hyx : y * x = trace y • x + trace x • y + p • 1 - x * y :=
      eq_sub_of_add_eq' (mul_add_mul_comm x y)
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, forall_eq_or_imp, forall_eq, one_mul,
      mul_one]
    refine ⟨⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_⟩⟩
    -- The products with `1`, and `x * y` itself, are generators.
    all_goals try (apply Submodule.subset_span; simp; done)
    -- Each remaining product is reduced by the alternative and flexible laws, the expression of
    -- `y * x` and the rank-two equation, and then distributed.
    · -- `x * x`
      exact mem_span_of_eq (-normSq x) (trace x) 0 0 (by rw [mul_self]; module)
    · -- `x * (x * y) = (x * x) * y`
      refine mem_span_of_eq 0 0 (-normSq x) (trace x) ?_
      rw [← left_alternative, mul_self]
      simp only [sub_mul, smul_mul_assoc, one_mul]
      module
    · -- `y * x`
      exact mem_span_of_eq p (trace y) (trace x) (-1) (by rw [hyx]; module)
    · -- `y * y`
      exact mem_span_of_eq (-normSq y) 0 (trace y) 0 (by rw [mul_self]; module)
    · -- `y * (x * y) = (y * x) * y`
      refine mem_span_of_eq (-(trace x * normSq y)) (normSq y) (trace x * trace y + p) 0 ?_
      rw [← flexible, hyx]
      simp only [add_mul, sub_mul, smul_mul_assoc, one_mul, right_alternative, mul_self y, mul_sub,
        mul_smul_comm, mul_one]
      module
    · -- `(x * y) * x = x * (y * x)`
      refine mem_span_of_eq (-(trace y * normSq x)) (trace x * trace y + p) (normSq x) 0 ?_
      rw [flexible, hyx]
      simp only [mul_add, mul_sub, mul_smul_comm, mul_one, ← left_alternative, mul_self x, sub_mul,
        smul_mul_assoc, one_mul]
      module
    · -- `(x * y) * y = x * (y * y)`
      refine mem_span_of_eq 0 (-normSq y) 0 (trace y) ?_
      rw [right_alternative, mul_self y]
      simp only [mul_sub, mul_smul_comm, mul_one]
      module
    · -- `(x * y) * (x * y)`
      exact mem_span_of_eq (-normSq (x * y)) 0 0 (trace (x * y)) (by rw [mul_self]; module)
  have hle : Submodule.map₂ (LinearMap.mul R _) (Submodule.span R {1, x, y, x * y})
      (Submodule.span R {1, x, y, x * y}) ≤ Submodule.span R {1, x, y, x * y} := by
    rw [Submodule.map₂_span_span, Submodule.span_le]
    exact Set.image2_subset_iff.2 key
  exact hle (Submodule.apply_mem_map₂ _ ha hb)

variable (x y) in
/-- The subalgebra generated by `x` and `y` is the span of `1`, `x`, `y` and `x * y`. -/
theorem adjoin_toSubmodule_eq_span :
    (NonUnitalAlgebra.adjoin R {1, x, y}).toSubmodule = Submodule.span R {1, x, y, x * y} := by
  refine le_antisymm ?_ (Submodule.span_le.2 ?_)
  · have hle := NonUnitalAlgebra.adjoin_le
      (S := (Submodule.span R {1, x, y, x * y}).toNonUnitalSubalgebra fun _ _ => mul_mem_span)
      (s := {1, x, y}) fun a ha => Submodule.subset_span (by aesop)
    exact fun a ha => hle ha
  · have hx : x ∈ NonUnitalAlgebra.adjoin R {1, x, y} := NonUnitalAlgebra.subset_adjoin R (by simp)
    have hy : y ∈ NonUnitalAlgebra.adjoin R {1, x, y} := NonUnitalAlgebra.subset_adjoin R (by simp)
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe,
      NonUnitalSubalgebra.mem_toSubmodule]
    exact ⟨NonUnitalAlgebra.subset_adjoin R (by simp), hx, hy, mul_mem hx hy⟩

/-- **Artin's theorem** for the double of the quaternions: the subalgebra generated by two elements
`x` and `y` is associative. -/
theorem mul_assoc_of_mem_adjoin {a b c : CayleyDickson ℍ[R]}
    (ha : a ∈ NonUnitalAlgebra.adjoin R {1, x, y}) (hb : b ∈ NonUnitalAlgebra.adjoin R {1, x, y})
    (hc : c ∈ NonUnitalAlgebra.adjoin R {1, x, y}) : a * b * c = a * (b * c) := by
  rw [← NonUnitalSubalgebra.mem_toSubmodule, adjoin_toSubmodule_eq_span] at ha hb hc
  refine sub_eq_zero.1 (associator_eq_zero_of_mem_span ?_ ha hb hc)
  -- Only the permutations of `(x, x * y, y)` are not covered by alternativity; on that triple the
  -- left and right alternative laws give
  -- `(x * (x * y)) * y = (x * x) * (y * y) = x * ((x * y) * y)`.
  have h₁ : associator x (x * y) y = 0 := by
    rw [associator_apply, ← left_alternative x y, right_alternative (x * x) y,
      right_alternative x y, left_alternative x (y * y), sub_self]
  have h₂ : associator (x * y) x y = 0 := by rw [associator_swap_left, h₁, neg_zero]
  have h₃ : associator x y (x * y) = 0 := by rw [associator_swap_right, h₁, neg_zero]
  have h₄ : associator y x (x * y) = 0 := by rw [associator_swap_left, h₃, neg_zero]
  have h₅ : associator (x * y) y x = 0 := by rw [associator_swap_right, h₂, neg_zero]
  have h₆ : associator y (x * y) x = 0 := by rw [associator_swap_right, h₄, neg_zero]
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, forall_eq_or_imp, forall_eq]
  simp only [associator_one_left, associator_one_middle, associator_one_right,
    associator_self_left, associator_self_right, associator_self_outer, h₁, h₂, h₃, h₄, h₅, h₆,
    and_self]

end Artin

end CayleyDickson

end TauCeti
