module

public import Mathlib.Algebra.Quandle

/-!
# The conjugation quandle on a conjugation-invariant subset

Mathlib's `Quandle.Conj G` is the quandle structure `x ◃ y = x y x⁻¹` on a group `G`. A subset
`c ⊆ G` that is stable under conjugation is a subquandle: `Quandle.conjOn c hc` is the quandle
structure on `c` with the same operation. Its enveloping group `Rack.EnvelGroup` is the group
generated by the elements of `c` subject to the relations `x y x⁻¹ = x ◃ y`.

The structure depends on the proof `hc` of invariance, so it is a definition rather than an
instance; use it with `letI := Quandle.conjOn c hc`.
-/

public section

namespace Quandle

variable {G : Type*} [Group G]

/-- The conjugation quandle on a conjugation-invariant subset `c` of a group:
`x ◃ y = x y x⁻¹` and `x ◃⁻¹ y = x⁻¹ y x`. -/
abbrev conjOn (c : Set G) (hc : ∀ g x, x ∈ c → g * x * g⁻¹ ∈ c) : Quandle c where
  act x y := ⟨x * y * (x : G)⁻¹, hc _ _ y.property⟩
  self_distrib := Subtype.ext (by simp [mul_assoc])
  invAct x y := ⟨(x : G)⁻¹ * y * x, by simpa using hc (x : G)⁻¹ _ y.property⟩
  left_inv _ _ := Subtype.ext (by simp [mul_assoc])
  right_inv _ _ := Subtype.ext (by simp [mul_assoc])
  fix := Subtype.ext (by simp)

variable {c : Set G} {hc : ∀ g x, x ∈ c → g * x * g⁻¹ ∈ c}

@[simp]
theorem coe_conjOn_act (x y : c) :
    ((@Shelf.act c (conjOn c hc).toShelf x y : c) : G) = x * y * (x : G)⁻¹ :=
  (rfl)

@[simp]
theorem coe_conjOn_invAct (x y : c) :
    ((@Rack.invAct c (conjOn c hc).toRack x y : c) : G) = (x : G)⁻¹ * y * x :=
  (rfl)

end Quandle
