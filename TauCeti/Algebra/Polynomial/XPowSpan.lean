module

public import Mathlib.Algebra.Polynomial.Basis
public import Mathlib.Algebra.Algebra.Tower
public import Mathlib.LinearAlgebra.Basis.Basic
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Spanning a module over a polynomial ring by the powers of `X`

A module over `R[X]` generated by a finite family `m` is exhausted by the `R`-submodules spanned
by the elements `X ^ i • m k` with `i < j`.

## Main declarations

* `Polynomial.iSup_iSup_lt_range_linearCombination_X_pow_smul`: these `R`-submodules exhaust a
  module over `R[X]` generated by `m`.
-/

public section

namespace Polynomial

/-- The `R`-submodules spanned by `X ^ i • m k` for `i < j` exhaust a module over `R[X]`
generated by `m`. -/
theorem iSup_iSup_lt_range_linearCombination_X_pow_smul {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R[X] M] [Module R M] [IsScalarTower R R[X] M]
    {ι : Type*} [Fintype ι] (m : ι → M) (hm : Submodule.span R[X] (Set.range m) = ⊤) :
    ⨆ j, ⨆ i < j, LinearMap.range
      (Fintype.linearCombination R fun k ↦ (X ^ i : R[X]) • m k) = ⊤ := by
  have hspan : Submodule.span R (Set.range fun i : ℕ ↦ (X ^ i : R[X])) = ⊤ := by
    simpa [← Polynomial.X_pow_eq_monomial] using (Polynomial.basisMonomials R).span_eq
  classical
  rw [eq_top_iff, ← Submodule.restrictScalars_top R R[X] M, ← hm,
    ← Submodule.span_smul_of_span_eq_top hspan, Submodule.span_le]
  rintro _ ⟨_, ⟨i, rfl⟩, _, ⟨k, rfl⟩, rfl⟩
  refine Submodule.mem_iSup_of_mem (i + 1) (Submodule.mem_iSup_of_mem i
    (Submodule.mem_iSup_of_mem (Nat.lt_succ_self i) ⟨Pi.single k 1, ?_⟩))
  simp [Fintype.linearCombination_apply, Pi.single_apply]

end Polynomial
