module

public import TauCeti.Algebra.MonoidAlgebra.Basic
public import TauCeti.Algebra.Polynomial.Laurent.Regular
public import Mathlib.Algebra.Regular.Pow
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import TauCeti.Algebra.MonoidAlgebra.Degree

/-!
# Intersections of separated Laurent principal ideals

Unit highest coefficient is preserved under arbitrary coefficient maps, and implies regularity
over every two-sided coefficient quotient, even for noncommutative rings. Over a commutative
coefficient ring `S`, a Laurent factor with unit highest coefficient therefore has principal
ideal intersecting that of any constant `C f` in their product. No domain, reducedness, or
comaximality assumption is used.

Taking `S = LaurentPolynomial R` and the constant coefficient inclusion gives
`(f(S)) ∩ (g(T)) = (f(S) g(T))` in the genuine two-variable Laurent ring. This also applies
to powers and finite products, even when the coefficient quotient by `f(S)` is nonreduced.
The product-lattice presentation is Mathlib's `AddMonoidAlgebra.curryAlgEquiv`.
-/

public section

namespace LaurentPolynomial

open AddMonoidAlgebra

variable {R S : Type*}

section QuotientRegularity

/-- Unit highest coefficient stays regular after any coefficient map followed by an arbitrary
two-sided ideal quotient. Neither principality nor commutativity is required. -/
theorem isRegular_mapRingHom_quotientMk_mapRingHom_of_isUnit_leadingCoeff
    [Semiring R] [Ring S] (φ : R →+* S) (I : Ideal S) [I.IsTwoSided]
    {g : LaurentPolynomial R}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    IsRegular (mapRingHom ℤ (Ideal.Quotient.mk I) (mapRingHom ℤ φ g)) := by
  rw [← RingHom.comp_apply, ← mapRingHom_comp]
  exact isRegular_mapRingHom_of_isUnit_leadingCoeff ((Ideal.Quotient.mk I).comp φ) hg

end QuotientRegularity

variable [CommRing S]

/-- The coefficient quotient by `f` kills exactly the multiples of the constant Laurent
polynomial `C f`. -/
theorem mapRingHom_quotientMk_span_singleton_eq_zero_iff {f : S} {p : LaurentPolynomial S} :
    mapRingHom ℤ (Ideal.Quotient.mk (Ideal.span {f})) p = 0 ↔ C f ∣ p := by
  rw [AddMonoidAlgebra.mapRingHom_eq_zero_iff, Ideal.mk_ker,
    Ideal.smul_top_eq_map, Ideal.map_span, Set.image_singleton]
  exact Ideal.mem_span_singleton

/-- Regularity after the coefficient quotient is enough for the two principal ideals
generated by a constant and a Laurent polynomial to intersect in their product. -/
theorem span_C_inf_span_eq_span_mul {f : S} {p : LaurentPolynomial S}
    (hp : IsRegular (mapRingHom ℤ (Ideal.Quotient.mk (Ideal.span {f})) p)) :
    Ideal.span {C f} ⊓ Ideal.span {p} = Ideal.span {C f * p} := by
  ext z
  simp only [Ideal.mem_inf, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨hf, b, rfl⟩
    have hb : C f ∣ b := by
      apply mapRingHom_quotientMk_span_singleton_eq_zero_iff.1
      apply hp.left.mul_left_eq_zero_iff.1
      rw [← map_mul]
      exact mapRingHom_quotientMk_span_singleton_eq_zero_iff.2 hf
    obtain ⟨a, rfl⟩ := hb
    exact ⟨a, by ring⟩
  · intro h
    exact ⟨dvd_trans (dvd_mul_right _ _) h, dvd_trans (dvd_mul_left _ _) h⟩

/-- The ideals of a constant factor and a Laurent factor with unit highest coefficient
intersect in their product, intrinsically over the commutative coefficient ring. -/
theorem span_C_inf_span_eq_span_mul_of_isUnit_leadingCoeff (f : S)
    {g : LaurentPolynomial S}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {g} = Ideal.span {C f * g} :=
  span_C_inf_span_eq_span_mul
    (isRegular_mapRingHom_of_isUnit_leadingCoeff (Ideal.Quotient.mk (Ideal.span {f})) hg)

/-- Powers of any intrinsic Laurent factor with unit highest coefficient satisfy the same
intersection identity, including exponent zero and a zero coefficient quotient. -/
theorem span_C_inf_span_pow_eq_span_mul (f : S) {g : LaurentPolynomial S}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) (n : ℕ) :
    Ideal.span {C f} ⊓ Ideal.span {g ^ n} = Ideal.span {C f * g ^ n} := by
  apply span_C_inf_span_eq_span_mul
  rw [map_pow]
  exact (isRegular_mapRingHom_of_isUnit_leadingCoeff
    (Ideal.Quotient.mk (Ideal.span {f})) hg).pow n

/-- Finite products of intrinsic Laurent factors with unit highest coefficients satisfy the
constant-factor principal-intersection identity. -/
theorem span_C_inf_span_prod_eq_span_mul {ι : Type*} (s : Finset ι) (f : S)
    (g : ι → LaurentPolynomial S)
    (hg : ∀ i ∈ s, IsUnit ((g i).leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {∏ i ∈ s, g i} =
      Ideal.span {C f * ∏ i ∈ s, g i} := by
  apply span_C_inf_span_eq_span_mul
  rw [map_prod]
  exact IsRegular.prod fun i hi ↦
    isRegular_mapRingHom_of_isUnit_leadingCoeff (Ideal.Quotient.mk (Ideal.span {f})) (hg i hi)

/-- Products of powers of intrinsic Laurent factors satisfy the intersection identity.
The constant coefficient factor is unrestricted. -/
theorem span_C_inf_span_prod_pow_eq_span_mul {ι : Type*} (s : Finset ι) (f : S)
    (g : ι → LaurentPolynomial S) (n : ι → ℕ)
    (hg : ∀ i ∈ s, IsUnit ((g i).leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {∏ i ∈ s, g i ^ n i} =
      Ideal.span {C f * ∏ i ∈ s, g i ^ n i} := by
  apply span_C_inf_span_eq_span_mul
  simp only [map_prod, map_pow]
  exact IsRegular.prod fun i hi ↦
    (isRegular_mapRingHom_of_isUnit_leadingCoeff
      (Ideal.Quotient.mk (Ideal.span {f})) (hg i hi)).pow (n i)

variable [Semiring R]

/-- Coefficient images of unit-highest-coefficient factors satisfy the intrinsic intersection
identity. For `S = R[S±]` and `φ = C`, the factors depend on separate Laurent variables. -/
theorem span_C_inf_span_mapRingHom_eq_span_mul (φ : R →+* S) (f : S)
    {g : LaurentPolynomial R}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {mapRingHom ℤ φ g} =
      Ideal.span {C f * mapRingHom ℤ φ g} :=
  span_C_inf_span_eq_span_mul_of_isUnit_leadingCoeff f
    (isUnit_leadingCoeff_mapRingHom WithBot.coe_injective φ hg)

/-- Coefficient images of powers satisfy the intrinsic constant-factor intersection identity. -/
theorem span_C_inf_span_mapRingHom_pow_eq_span_mul (φ : R →+* S) (f : S)
    {g : LaurentPolynomial R}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) (n : ℕ) :
    Ideal.span {C f} ⊓ Ideal.span {(mapRingHom ℤ φ g) ^ n} =
      Ideal.span {C f * (mapRingHom ℤ φ g) ^ n} :=
  span_C_inf_span_pow_eq_span_mul f
    (isUnit_leadingCoeff_mapRingHom WithBot.coe_injective φ hg) n

/-- Coefficient images of finite products satisfy the intrinsic intersection identity. -/
theorem span_C_inf_span_prod_mapRingHom_eq_span_mul {ι : Type*} (s : Finset ι)
    (φ : R →+* S) (f : S) (g : ι → LaurentPolynomial R)
    (hg : ∀ i ∈ s, IsUnit ((g i).leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {∏ i ∈ s, mapRingHom ℤ φ (g i)} =
      Ideal.span {C f * ∏ i ∈ s, mapRingHom ℤ φ (g i)} :=
  span_C_inf_span_prod_eq_span_mul s f _ fun i hi ↦
    isUnit_leadingCoeff_mapRingHom WithBot.coe_injective φ (hg i hi)

/-- Coefficient images of products of powers satisfy the intrinsic intersection identity. -/
theorem span_C_inf_span_prod_mapRingHom_pow_eq_span_mul {ι : Type*} (s : Finset ι)
    (φ : R →+* S) (f : S) (g : ι → LaurentPolynomial R) (n : ι → ℕ)
    (hg : ∀ i ∈ s, IsUnit ((g i).leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {∏ i ∈ s, (mapRingHom ℤ φ (g i)) ^ n i} =
    Ideal.span {C f * ∏ i ∈ s, (mapRingHom ℤ φ (g i)) ^ n i} :=
  span_C_inf_span_prod_pow_eq_span_mul s f _ n fun i hi ↦
    isUnit_leadingCoeff_mapRingHom WithBot.coe_injective φ (hg i hi)

end LaurentPolynomial
