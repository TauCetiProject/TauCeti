module

public import TauCeti.Algebra.MonoidAlgebra.Basic
public import TauCeti.Algebra.Polynomial.Laurent.Regular
public import Mathlib.Algebra.Regular.Pow
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Intersections of separated Laurent principal ideals

Unit highest coefficient is preserved under arbitrary coefficient maps, and implies regularity
over every two-sided coefficient quotient, even for noncommutative rings. Over a commutative
coefficient ring `S`, a Laurent factor with unit highest coefficient therefore has principal
ideal intersecting that of any constant `C f` in their product. No domain, reducedness, or
comaximality assumption is used.

For a Laurent factor `g` with unit highest coefficient, taking
`S = LaurentPolynomial R` over a commutative ring `R` gives
`(f(S)) ∩ (g(T)) = (f(S) g(T))` in the two-variable Laurent ring. Unit highest coefficients
are closed under powers and finite products, so these forms satisfy the same identity even
when the coefficient quotient by `f(S)` is nonreduced.
The product-lattice presentation is Mathlib's `AddMonoidAlgebra.curryAlgEquiv`.
-/

public section

namespace LaurentPolynomial

open AddMonoidAlgebra

variable {R S : Type*}

variable [CommRing S]

/-- The coefficient quotient by `f` kills exactly the multiples of the constant Laurent
polynomial `C f`. -/
theorem mapRingHom_quotientMk_span_singleton_eq_zero_iff {f : S} {p : LaurentPolynomial S} :
    mapRingHom ℤ (Ideal.Quotient.mk (Ideal.span {f})) p = 0 ↔ C f ∣ p := by
  rw [AddMonoidAlgebra.mapRingHom_eq_zero_iff, Ideal.mk_ker,
    Ideal.smul_top_eq_map, Ideal.map_span, Set.image_singleton]
  rw [Submodule.restrictScalars_mem, ← C_eq_algebraMap, Ideal.mem_span_singleton]

/-- If the coefficient quotient image of `p` is regular, the ideals generated by `C f` and
`p` intersect in the principal ideal generated by `C f * p`. -/
theorem span_C_inf_span_eq_span_mul_of_isRegular_mapRingHom {f : S} {p : LaurentPolynomial S}
    (hp : IsRegular (mapRingHom ℤ (Ideal.Quotient.mk (Ideal.span {f})) p)) :
    Ideal.span {C f} ⊓ Ideal.span {p} = Ideal.span {C f * p} := by
  ext z
  simp only [Ideal.mem_inf, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨hf, b, rfl⟩
    have hb : C f ∣ b := by
      apply mapRingHom_quotientMk_span_singleton_eq_zero_iff.1
      apply hp.left.mul_left_eq_zero_iff.1
      rw [← map_mul]
      exact mapRingHom_quotientMk_span_singleton_eq_zero_iff.2 hf
    obtain ⟨a, rfl⟩ := hb
    exact ⟨a, by ring⟩
  · intro h
    exact ⟨dvd_trans (dvd_mul_right _ _) h, dvd_trans (dvd_mul_left _ _) h⟩

/-- If `g` has unit highest coefficient, the ideals generated by `C f` and `g` intersect
in the principal ideal generated by `C f * g`. -/
theorem span_C_inf_span_eq_span_mul_of_isUnit_leadingCoeff (f : S)
    {g : LaurentPolynomial S}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {g} = Ideal.span {C f * g} :=
  span_C_inf_span_eq_span_mul_of_isRegular_mapRingHom
    (isRegular_mapRingHom_of_isUnit_leadingCoeff (Ideal.Quotient.mk (Ideal.span {f})) hg)

/-- If `g` has unit highest coefficient, the ideals generated by `C f` and `g ^ n`
intersect in the principal ideal generated by `C f * g ^ n`, including `n = 0`. -/
theorem span_C_inf_span_pow_eq_span_mul_of_isUnit_leadingCoeff (f : S)
    {g : LaurentPolynomial S}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) (n : ℕ) :
    Ideal.span {C f} ⊓ Ideal.span {g ^ n} = Ideal.span {C f * g ^ n} :=
  span_C_inf_span_eq_span_mul_of_isUnit_leadingCoeff f (isUnit_leadingCoeff_pow hg n)

/-- If every `g i` has unit highest coefficient, the ideals generated by `C f` and the
finite product of the `g i` intersect in the principal ideal of their product. -/
theorem span_C_inf_span_prod_eq_span_mul_of_isUnit_leadingCoeff {ι : Type*}
    (s : Finset ι) (f : S) (g : ι → LaurentPolynomial S)
    (hg : ∀ i ∈ s, IsUnit ((g i).leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {∏ i ∈ s, g i} =
      Ideal.span {C f * ∏ i ∈ s, g i} :=
  span_C_inf_span_eq_span_mul_of_isUnit_leadingCoeff f (isUnit_leadingCoeff_prod s g hg)

/-- If every `g i` has unit highest coefficient, the ideals generated by `C f` and the
finite product of powers `g i ^ n i` intersect in the principal ideal of their product. -/
theorem span_C_inf_span_prod_pow_eq_span_mul_of_isUnit_leadingCoeff {ι : Type*}
    (s : Finset ι) (f : S) (g : ι → LaurentPolynomial S) (n : ι → ℕ)
    (hg : ∀ i ∈ s, IsUnit ((g i).leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {∏ i ∈ s, g i ^ n i} =
    Ideal.span {C f * ∏ i ∈ s, g i ^ n i} :=
  span_C_inf_span_eq_span_mul_of_isUnit_leadingCoeff f
    (isUnit_leadingCoeff_prod s _ (fun i hi ↦ isUnit_leadingCoeff_pow (hg i hi) (n i)))

end LaurentPolynomial
