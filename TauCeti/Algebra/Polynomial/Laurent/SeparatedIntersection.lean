module

public import TauCeti.Algebra.MonoidAlgebra.Basic
public import TauCeti.Algebra.Polynomial.Laurent.Regular
public import Mathlib.Algebra.Regular.Pow
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Intersections of separated Laurent principal ideals

Let `R → S` be a homomorphism of commutative rings. If a Laurent polynomial over `R` has
unit highest coefficient, its image is regular over every coefficient quotient of `S`.
Consequently its principal ideal intersects the ideal of any constant `C f`, for `f : S`,
in their product. No domain, reducedness, or comaximality assumption is used.

Taking `S = LaurentPolynomial R` and the constant coefficient inclusion gives
`(f(S)) ∩ (g(T)) = (f(S) g(T))` in the genuine two-variable Laurent ring. This also applies
to powers and finite products, even when the coefficient quotient by `f(S)` is nonreduced.
The product-lattice presentation is Mathlib's `AddMonoidAlgebra.curryAlgEquiv`.
-/

public section

namespace LaurentPolynomial

open AddMonoidAlgebra

variable {R S : Type*} [CommRing R] [CommRing S]

/-- The coefficient quotient by `f` kills exactly the multiples of the constant Laurent
polynomial `C f`. -/
@[simp↓]
theorem map_quotient_eq_zero_iff {f : S} {p : LaurentPolynomial S} :
    mapRingHom ℤ (Ideal.Quotient.mk (Ideal.span {f})) p = 0 ↔ C f ∣ p := by
  rw [AddMonoidAlgebra.mapRingHom_eq_zero_iff, Ideal.mk_ker,
    Ideal.smul_top_eq_map, Ideal.map_span, Set.image_singleton]
  exact Ideal.mem_span_singleton

/-- Regularity after the coefficient quotient is enough for the two principal ideals
generated by a constant and a Laurent polynomial to intersect in their product. -/
theorem span_C_inf_span_eq_span_mul {f : S} {p : LaurentPolynomial S}
    (hp : IsRegular (mapRingHom ℤ (Ideal.Quotient.mk (Ideal.span {f})) p)) :
    Ideal.span {C f} ⊓ Ideal.span {p} = Ideal.span {C f * p} := by
  ext z
  simp only [Ideal.mem_inf, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨hf, b, rfl⟩
    have hb : C f ∣ b := by
      apply map_quotient_eq_zero_iff.1
      apply hp.left.mul_left_eq_zero_iff.1
      rw [← map_mul]
      exact map_quotient_eq_zero_iff.2 hf
    obtain ⟨a, rfl⟩ := hb
    exact ⟨a, by ring⟩
  · intro h
    exact ⟨dvd_trans (dvd_mul_right _ _) h, dvd_trans (dvd_mul_left _ _) h⟩

/-- A Laurent polynomial with unit highest coefficient stays regular after arbitrary
coefficient extension followed by quotienting by a constant factor. -/
theorem isRegular_map_quotient_of_isUnit_leadingCoeff (φ : R →+* S) (f : S)
    {g : LaurentPolynomial R}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    IsRegular (mapRingHom ℤ (Ideal.Quotient.mk (Ideal.span {f}))
      (mapRingHom ℤ φ g)) := by
  rw [← RingHom.comp_apply, ← mapRingHom_comp]
  exact isRegular_mapRingHom_of_isUnit_leadingCoeff
    ((Ideal.Quotient.mk (Ideal.span {f})).comp φ) hg

/-- The principal ideals of a constant factor and a Laurent factor with unit highest
coefficient intersect in their product, over arbitrary commutative coefficient rings.
For `S = R[S±]` and `φ = C`, the factors depend on separate Laurent variables. -/
theorem span_C_inf_span_map_eq_span_mul (φ : R →+* S) (f : S)
    {g : LaurentPolynomial R}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {mapRingHom ℤ φ g} =
      Ideal.span {C f * mapRingHom ℤ φ g} :=
  span_C_inf_span_eq_span_mul (isRegular_map_quotient_of_isUnit_leadingCoeff φ f hg)

/-- Powers of a separate-variable Laurent factor satisfy the same intersection identity.
The exponent may be zero, and the coefficient quotient may be the zero ring. -/
theorem span_C_inf_span_map_pow_eq_span_mul (φ : R →+* S) (f : S)
    {g : LaurentPolynomial R}
    (hg : IsUnit (g.leadingCoeff ((↑) : ℤ → WithBot ℤ))) (n : ℕ) :
    Ideal.span {C f} ⊓ Ideal.span {(mapRingHom ℤ φ g) ^ n} =
      Ideal.span {C f * (mapRingHom ℤ φ g) ^ n} := by
  apply span_C_inf_span_eq_span_mul
  rw [map_pow]
  exact (isRegular_map_quotient_of_isUnit_leadingCoeff φ f hg).pow n

/-- Products of powers of Laurent factors with unit highest coefficients satisfy the
separated principal-intersection identity. The other coefficient factor is unrestricted. -/
theorem span_C_inf_span_prod_map_pow_eq_span_mul {ι : Type*} (s : Finset ι)
    (φ : R →+* S) (f : S) (g : ι → LaurentPolynomial R) (n : ι → ℕ)
    (hg : ∀ i ∈ s, IsUnit ((g i).leadingCoeff ((↑) : ℤ → WithBot ℤ))) :
    Ideal.span {C f} ⊓ Ideal.span {∏ i ∈ s, (mapRingHom ℤ φ (g i)) ^ n i} =
      Ideal.span {C f * ∏ i ∈ s, (mapRingHom ℤ φ (g i)) ^ n i} := by
  apply span_C_inf_span_eq_span_mul
  simp only [map_prod, map_pow]
  exact IsRegular.prod fun i hi ↦
    (isRegular_map_quotient_of_isUnit_leadingCoeff φ f (hg i hi)).pow (n i)

end LaurentPolynomial
