module

public import TauCeti.Algebra.Polynomial.Laurent.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Kernels of Laurent polynomial evaluation

Evaluation at a unit `u` has kernel generated by `T - C u`.
In particular evaluation at one has kernel `(T - 1)`, and its quotient is the
coordinate ring of the identity in the multiplicative group. The kernel equation also
characterizes points of this closed subscheme over nonreduced coefficient algebras.
-/

public section

open LaurentPolynomial

namespace TauCeti

variable {R : Type*} [CommRing R]

/-- Evaluation at a unit has kernel generated by the Laurent variable minus that unit. -/
theorem ker_laurentEval (u : Rˣ) :
    RingHom.ker (laurentEval u) = Ideal.span {(T 1 - C (u : R) : R[T;T⁻¹])} := by
  let I := Ideal.span {(T 1 - C (u : R) : R[T;T⁻¹])}
  have hI : I ≤ RingHom.ker (laurentEval u) := by
    rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
    simp
  refine le_antisymm (fun p hp ↦ ?_) hI
  have hq : (Ideal.Quotient.mkₐ R I) (T 1) = algebraMap R _ (u : R) := by
    apply sub_eq_zero.mp
    rw [← (Ideal.Quotient.mkₐ R I).commutes, ← C_eq_algebraMap, ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have heq : Ideal.Quotient.mkₐ R I =
      (Algebra.ofId R (R[T;T⁻¹] ⧸ I)).comp (laurentEval u) := by
    apply (laurentEval_unique
      (Units.map (algebraMap R (R[T;T⁻¹] ⧸ I) : R →* (R[T;T⁻¹] ⧸ I)) u) _ hq).trans
    symm
    apply laurentEval_unique
    simp
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  rw [← Ideal.Quotient.mkₐ_eq_mk R, heq, AlgHom.comp_apply, RingHom.mem_ker.mp hp, map_zero]

end TauCeti
