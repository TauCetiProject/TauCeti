module

public import TauCeti.Algebra.Polynomial.Laurent.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The augmentation ideal of Laurent polynomials

Evaluation at one has kernel generated by `T - 1`. In particular its quotient is the
coordinate ring of the identity in the multiplicative group. The kernel equation also
characterizes points of this closed subscheme over nonreduced coefficient algebras.
-/

public section

open LaurentPolynomial

namespace TauCeti

variable {R : Type*} [CommRing R]

/-- The augmentation ideal of the Laurent polynomial algebra is generated by `T - 1`. -/
theorem ker_laurentEval_one :
    RingHom.ker (laurentEval (R := R) (1 : Rˣ)) =
      Ideal.span {(T 1 - 1 : R[T;T⁻¹])} := by
  let I := Ideal.span {(T 1 - 1 : R[T;T⁻¹])}
  have hI : I ≤ RingHom.ker (laurentEval (R := R) (1 : Rˣ)) := by
    rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
    simp
  refine le_antisymm (fun p hp ↦ ?_) hI
  have hq : (Ideal.Quotient.mkₐ R I) (T 1) = 1 := by
    apply sub_eq_zero.mp
    rw [← map_one (Ideal.Quotient.mkₐ R I), ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have heq : Ideal.Quotient.mkₐ R I =
      (Algebra.ofId R (R[T;T⁻¹] ⧸ I)).comp (laurentEval (R := R) (1 : Rˣ)) := by
    apply (laurentEval_unique (1 : (R[T;T⁻¹] ⧸ I)ˣ) _ hq).trans
    symm
    apply laurentEval_unique
    simp
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  rw [← Ideal.Quotient.mkₐ_eq_mk R, heq, AlgHom.comp_apply, RingHom.mem_ker.mp hp, map_zero]

end TauCeti
