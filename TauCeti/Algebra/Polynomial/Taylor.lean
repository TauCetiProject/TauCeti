/-!
# Taylor coefficients at a root and in subleading degree

Over a commutative ring, the Taylor expansion `taylor r p = p(X + r)` of a nonzero polynomial `p`
at `r` starts in degree `p.rootMultiplicity r`, and its lowest nonzero coefficient is the value at
`r` of `p` divided by the largest power of `X - r` dividing it. This is the coefficient that
survives when `X - r` is divided out of `p` as often as possible before evaluating at `r`; it is
nonzero by `Polynomial.eval_divByMonic_pow_rootMultiplicity_ne_zero`. The formal identities for
`natTrailingDegree` and `trailingCoeff` hold for `p = 0` as well, where both sides are `0`.

Over any ring, translation by `r` sends `(X - C r) ^ m` to `X ^ m`, and more generally the product
`p * (X - C r) ^ m` to `taylor r p * X ^ m`, although over a noncommutative ring `taylor r` need not
be multiplicative. Since the Taylor coefficients of `p` at `r` are the values at `r` of the Hasse
derivatives of `p`, the polynomials `g * (X - C r) ^ n` are exactly those whose Hasse derivatives of
order less than `n` vanish at `r`. Over a commutative ring this says that divisibility of `p` by
`(X - r) ^ n` is the vanishing of these Hasse derivatives.

At the other end of the expansion, over any semiring, the leading coefficient is unchanged and the
subleading coefficient moves by `p.natDegree * p.leadingCoeff * r`. Over a ring this is the input
for the Tschirnhaus shift: if `u = p.natDegree * p.leadingCoeff` is a unit, then translating by
`r = -u⁻¹ * p.nextCoeff` removes the subleading coefficient. This applies for instance over a field
in which `(p.natDegree : R) ≠ 0`. Over a semiring without negation such an `r` need not exist.

Collecting the Hasse derivatives of order below `n` at `r` gives the Taylor coordinates
`TauCeti.taylorJet r n : R[X] →ₗ[R] Fin n → R`. Over any ring they are surjective, and their
kernel is the left ideal generated by `(X - C r) ^ n`, that is, the set of products
`g * (X - C r) ^ n`. They therefore induce an `R`-linear equivalence between the quotient
`R[X] ⧸ ((X - C r) ^ n)` by this left ideal and `Fin n → R`. Over a commutative ring the quotient
is a ring. For `n ≤ 1` the equivalence then also respects multiplication (for `n = 1` it is
evaluation at `r`). For `n ≥ 2` over a nontrivial commutative ring it does not respect pointwise
multiplication on `Fin n → R`: the class of `X - C r` has coordinates `Pi.single 1 1`, which is
idempotent, while that of `(X - C r) ^ 2` has coordinate `0` in order `1`.

## Main results

* `Polynomial.coeff_taylor_eq_sum`: the coefficients of the Taylor expansion as finite sums of
  binomial multiples of the coefficients of `p` times powers of `r`.
* `Polynomial.taylor_mul_X_sub_C`, `Polynomial.taylor_mul_X_sub_C_pow`,
  `Polynomial.taylor_X_sub_C_pow`: the Taylor expansion at `r` of `p * (X - C r) ^ m` is
  `taylor r p * X ^ m`, and that of `(X - C r) ^ m` is `X ^ m`, over any ring.
* `Polynomial.taylor_neg_taylor`: the Taylor expansion at `-r` undoes that at `r`, over any ring.
* `Polynomial.mem_span_X_sub_C_pow_iff_forall_eval_hasseDeriv_eq_zero`: `p = g * (X - C r) ^ n`
  for some `g` if and only if the Hasse derivatives of `p` of order less than `n` vanish at `r`,
  over any ring.
* `Polynomial.natTrailingDegree_taylor`: the Taylor expansion at `r` has trailing degree
  `p.rootMultiplicity r`; for `p ≠ 0` this is the degree in which it starts. This result and those
  below it, up to and including
  `Polynomial.le_rootMultiplicity_iff_forall_eval_hasseDeriv_eq_zero`, are stated over commutative
  rings.
* `Polynomial.coeff_taylor_rootMultiplicity`, `Polynomial.trailingCoeff_taylor`: its trailing
  coefficient is `(p /ₘ (X - C r) ^ p.rootMultiplicity r).eval r`; for `p ≠ 0` this is its lowest
  nonzero coefficient.
* `Polynomial.eval_hasseDeriv_rootMultiplicity_ne_zero`: for `p ≠ 0`, the Hasse derivative of
  order `p.rootMultiplicity r` does not vanish at `r`.
* `Polynomial.X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero`,
  `Polynomial.le_rootMultiplicity_iff_forall_eval_hasseDeriv_eq_zero`: `(X - r) ^ n` divides `p`
  (and for `p ≠ 0`, `n ≤ p.rootMultiplicity r`) if and only if the Hasse derivatives of `p` of
  order less than `n` vanish at `r`.
* `Polynomial.coeff_taylor_map_algebraMap`, `Polynomial.aeval_hasseDeriv_eq_zero_of_pow_dvd`: the
  Taylor coefficients at a point `ζ` of an `R`-algebra are the values at `ζ` of Hasse derivatives,
  and those of order less than `m` vanish on multiples of `g ^ m` when `g(ζ) = 0`.
* `Polynomial.eval_hasseDeriv_X_sub_C_pow`: the Hasse derivatives of `(X - r) ^ m` at `r`, over any
  ring.
* `Polynomial.taylor_comp_C_mul_X`, `Polynomial.eval_hasseDeriv_comp_C_mul_X`: the Taylor
  expansion and the Hasse derivatives of a rescaled polynomial `p(a X)`.
* `Polynomial.nextCoeff_taylor`: the subleading coefficient of the Taylor expansion of `p` at `r`
  is `p.nextCoeff + p.natDegree * p.leadingCoeff * r`, over any semiring.
* `TauCeti.taylorJet_sum_smul_X_sub_C_pow`, `TauCeti.taylorJet_surjective`: the coordinates `c`
  are attained by `∑ k, c k • (X - C r) ^ k`, over any ring.
* `TauCeti.taylorJet_eq_zero_iff`, `TauCeti.ker_taylorJet`: the Taylor coordinates of order below
  `n` at `r` vanish exactly on the left ideal generated by `(X - C r) ^ n`, over any ring.
* `TauCeti.taylorJetQuotientEquiv`, `TauCeti.taylorJetQuotientEquiv_symm_apply`: over any ring, the
  `R`-linear equivalence `R[X] ⧸ ((X - C r) ^ n) ≃ₗ[R] Fin n → R` induced by the Taylor
  coordinates, and its inverse.
-/

public section

namespace Polynomial

/-- The coefficients of the Taylor expansion `p(X + r)` as finite sums: the coefficient of `X ^ m`
is `∑ₖ (k + m).choose m • (p.coeff (k + m) * r ^ k)`, summed over any range of indices `k`
beyond the degree of `p`. -/
theorem coeff_taylor_eq_sum {R : Type*} [Semiring R] {p : R[X]} {N : ℕ} (hN : p.natDegree < N)
    (r : R) (m : ℕ) :
    (taylor r p).coeff m = ∑ k ∈ Finset.range N, (k + m).choose m • (p.coeff (k + m) * r ^ k) := by
  rw [taylor_coeff, eval_eq_sum_range' ((natDegree_hasseDeriv_le p m).trans_lt
    ((Nat.sub_le _ _).trans_lt hN))]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [hasseDeriv_coeff, nsmul_eq_mul, mul_assoc]

/-- Translating `p * (X - r)` by `r` gives `taylor r p * X`. Unlike `Polynomial.taylor_mul`, this
does not need commutativity: the coefficients of `X - C r` commute with `X + C r`. -/
@[simp]
theorem taylor_mul_X_sub_C {R : Type*} [Ring R] (r : R) (p : R[X]) :
    taylor r (p * (X - C r)) = taylor r p * X := by
  have h (k : ℕ) : Commute (C ((X - C r).coeff k)) (X + C r) := by
    refine (commute_X _).symm.add_right (Commute.map ?_ C)
    rw [coeff_sub, coeff_X, coeff_C]
    split_ifs <;> simp
  calc taylor r (p * (X - C r)) = taylor r p * taylor r (X - C r) := by
        simpa only [taylor_apply, comp] using eval₂_mul_noncomm _ _ h
    _ = taylor r p * X := by rw [taylor_X_sub_C]

/-- Translating `p * (X - r) ^ m` by `r` gives `taylor r p * X ^ m`, over any ring. -/
@[simp]
theorem taylor_mul_X_sub_C_pow {R : Type*} [Ring R] (r : R) (p : R[X]) (m : ℕ) :
    taylor r (p * (X - C r) ^ m) = taylor r p * X ^ m := by
  induction m with
  | zero => simp
  | succ m ih => rw [pow_succ, ← mul_assoc, taylor_mul_X_sub_C, ih, pow_succ, mul_assoc]

/-- The Taylor expansion of `(X - r) ^ m` at `r` is `X ^ m`. Unlike `Polynomial.taylor_pow`, this
does not need commutativity. -/
@[simp]
theorem taylor_X_sub_C_pow {R : Type*} [Ring R] (r : R) (m : ℕ) :
    taylor r ((X - C r) ^ m) = X ^ m := by
  simpa using taylor_mul_X_sub_C_pow r 1 m

/-- Translating back by `-r` undoes the translation by `r`. Unlike `Polynomial.taylor_taylor`, this
does not need commutativity. -/
@[simp]
theorem taylor_neg_taylor {R : Type*} [Ring R] (r : R) (p : R[X]) :
    taylor (-r) (taylor r p) = p := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simp only [map_add, hp, hq]
  | monomial n a =>
    have h : X + C r = X - C (-r) := by rw [map_neg, sub_neg_eq_add]
    rw [taylor_monomial, ← smul_eq_C_mul, map_smul, h, taylor_X_sub_C_pow, smul_eq_C_mul,
      C_mul_X_pow_eq_monomial]

/-- Taylor expansion commutes with rescaling the variable: the expansion of `p(a X)` at `r` is
the expansion of `p` at `a r`, rescaled. -/
@[simp]
theorem taylor_comp_C_mul_X {R : Type*} [CommSemiring R] (p : R[X]) (a r : R) :
    taylor r (p.comp (C a * X)) = (taylor (a * r) p).comp (C a * X) := by
  simp only [taylor_apply, comp_assoc, mul_comp, C_comp, X_comp, add_comp, mul_add, C_mul]

/-- The Hasse derivatives of the rescaled polynomial `p(a X)`: the `k`-th one at `r` is
`a ^ k` times the `k`-th Hasse derivative of `p` at `a r`. -/
@[simp]
theorem eval_hasseDeriv_comp_C_mul_X {R : Type*} [CommSemiring R] (p : R[X]) (a r : R)
    (k : ℕ) : (hasseDeriv k (p.comp (C a * X))).eval r = a ^ k * (hasseDeriv k p).eval (a * r) := by
  rw [← taylor_coeff, ← taylor_coeff, taylor_comp_C_mul_X, comp_C_mul_X_coeff, mul_comm]

/-- The subleading coefficient of the Taylor expansion `p(X + r)` is that of `p` plus
`p.natDegree * p.leadingCoeff * r`. -/
theorem nextCoeff_taylor {R : Type*} [Semiring R] (p : R[X]) (r : R) :
    (taylor r p).nextCoeff = p.nextCoeff + p.natDegree * p.leadingCoeff * r := by
  rcases Nat.eq_zero_or_pos p.natDegree with h | h
  · simp [nextCoeff, natDegree_taylor, h]
  -- The Hasse derivative of order `p.natDegree - 1` is linear; evaluate it at `r`.
  have hlin : (hasseDeriv (p.natDegree - 1) p).natDegree ≤ 1 :=
    (natDegree_hasseDeriv_le _ _).trans (by omega)
  rw [nextCoeff_of_natDegree_pos (by rwa [natDegree_taylor]), nextCoeff_of_natDegree_pos h,
    natDegree_taylor, taylor_coeff]
  rw [eq_X_add_C_of_natDegree_le_one hlin]
  obtain ⟨d, hd⟩ : ∃ d, p.natDegree = d + 1 := ⟨_, (Nat.succ_pred_eq_of_pos h).symm⟩
  simp only [eval_add, eval_C_mul, eval_X, eval_C, hasseDeriv_coeff]
  simp [leadingCoeff, hd, add_comm 1 d, add_comm (p.coeff d)]

/-- The Hasse derivative of order `i` of `(X - r) ^ m` is `1` at `r` if `i = m`, and `0`
otherwise: the Taylor expansion of `(X - r) ^ m` at `r` is `X ^ m`. -/
@[simp]
theorem eval_hasseDeriv_X_sub_C_pow {R : Type*} [Ring R] (r : R) (i m : ℕ) :
    (hasseDeriv i ((X - C r) ^ m)).eval r = if i = m then 1 else 0 := by
  rw [← taylor_coeff, taylor_X_sub_C_pow, coeff_X_pow]

/-- `p = g * (X - r) ^ n` for some `g`, that is, `p` lies in the left ideal generated by
`(X - r) ^ n`, if and only if every Hasse derivative of `p` of order less than `n` vanishes at `r`.
-/
theorem mem_span_X_sub_C_pow_iff_forall_eval_hasseDeriv_eq_zero {R : Type*} [Ring R] {p : R[X]}
    {r : R} {n : ℕ} : p ∈ Ideal.span {(X - C r) ^ n} ↔ ∀ i < n, (hasseDeriv i p).eval r = 0 := by
  simp_rw [Ideal.mem_span_singleton', ← taylor_coeff]
  constructor
  · rintro ⟨g, rfl⟩ i hi
    simp [coeff_mul_X_pow', hi]
  · intro h
    obtain ⟨g, hg⟩ := X_pow_dvd_iff.2 h
    refine ⟨taylor (-r) g, taylor_injective r ?_⟩
    rw [taylor_mul_X_sub_C_pow, hg, (commute_X_pow g n).eq]
    simpa using congr_arg (· * X ^ n) (taylor_neg_taylor (-r) g)

/-- The Taylor coefficients at `ζ` of the image of `p` in an `R`-algebra are the values at `ζ` of
the Hasse derivatives of `p`. -/
theorem coeff_taylor_map_algebraMap {R B : Type*} [CommSemiring R] [CommSemiring B] [Algebra R B]
    (ζ : B) (p : R[X]) (k : ℕ) :
    (taylor ζ (p.map (algebraMap R B))).coeff k = aeval ζ (hasseDeriv k p) := by
  rw [taylor_coeff, hasseDeriv_map, eval_map_algebraMap]

variable {R : Type*} [CommRing R]

/-- The trailing degree of the Taylor expansion of `p` at `r` is `p.rootMultiplicity r`. For
`p ≠ 0` this is the degree in which the expansion starts; for `p = 0` both sides are `0`. -/
theorem natTrailingDegree_taylor (p : R[X]) (r : R) :
    (taylor r p).natTrailingDegree = p.rootMultiplicity r := by
  rw [rootMultiplicity_eq_natTrailingDegree, taylor_apply]

/-- The coefficient of `X ^ p.rootMultiplicity r` in the Taylor expansion of `p` at `r` is the
value at `r` of `p /ₘ (X - C r) ^ p.rootMultiplicity r`. For `p ≠ 0` this divides out the largest
power of `X - r` dividing `p`. -/
theorem coeff_taylor_rootMultiplicity (p : R[X]) (r : R) :
    (taylor r p).coeff (p.rootMultiplicity r) =
      (p /ₘ (X - C r) ^ p.rootMultiplicity r).eval r := by
  set m := p.rootMultiplicity r
  conv_lhs => rw [← pow_mul_divByMonic_rootMultiplicity_eq p r]
  simpa [taylor_mul, taylor_pow, taylor_coeff_zero] using
    coeff_X_pow_mul (taylor r (p /ₘ (X - C r) ^ m)) m 0

/-- The trailing coefficient of the Taylor expansion of `p` at `r` is the value at `r` of
`p /ₘ (X - C r) ^ p.rootMultiplicity r`. For `p ≠ 0` this divides out the largest power of `X - r`
dividing `p`, and it is the lowest nonzero coefficient of the expansion. -/
theorem trailingCoeff_taylor (p : R[X]) (r : R) :
    (taylor r p).trailingCoeff = (p /ₘ (X - C r) ^ p.rootMultiplicity r).eval r := by
  rw [trailingCoeff, natTrailingDegree_taylor, coeff_taylor_rootMultiplicity]

/-- For `p ≠ 0`, the Hasse derivative of `p` of order `p.rootMultiplicity r` does not vanish
at `r`. -/
theorem eval_hasseDeriv_rootMultiplicity_ne_zero {p : R[X]} (hp : p ≠ 0) (r : R) :
    (hasseDeriv (p.rootMultiplicity r) p).eval r ≠ 0 := by
  rw [← taylor_coeff, ← natTrailingDegree_taylor]
  exact coeff_natTrailingDegree_ne_zero.2 ((taylor_eq_zero _ _).not.2 hp)

/-- `(X - r) ^ n` divides `p` if and only if every Hasse derivative of `p` of order less than `n`
vanishes at `r`. -/
theorem X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero {p : R[X]} {r : R} {n : ℕ} :
    (X - C r) ^ n ∣ p ↔ ∀ i < n, (hasseDeriv i p).eval r = 0 := by
  rw [← Ideal.mem_span_singleton, mem_span_X_sub_C_pow_iff_forall_eval_hasseDeriv_eq_zero]

/-- If `ζ` is a root of `g` in an `R`-algebra and `g ^ m ∣ p`, then the Hasse derivatives of `p` of
order less than `m` vanish at `ζ`. -/
theorem aeval_hasseDeriv_eq_zero_of_pow_dvd {B : Type*} [CommRing B] [Algebra R B] {ζ : B}
    {g p : R[X]} (hg : aeval ζ g = 0) {m : ℕ} (h : g ^ m ∣ p) {k : ℕ} (hk : k < m) :
    aeval ζ (hasseDeriv k p) = 0 := by
  obtain ⟨c, hc⟩ := pow_sub_dvd_hasseDeriv_of_pow_dvd k h
  rw [hc, map_mul, map_pow, hg, zero_pow (by omega), zero_mul]

/-- For `p ≠ 0`, `r` has multiplicity at least `n` as a root of `p` if and only if every Hasse
derivative of `p` of order less than `n` vanishes at `r`. -/
theorem le_rootMultiplicity_iff_forall_eval_hasseDeriv_eq_zero {p : R[X]} (hp : p ≠ 0) {r : R}
    {n : ℕ} : n ≤ p.rootMultiplicity r ↔ ∀ i < n, (hasseDeriv i p).eval r = 0 := by
  rw [le_rootMultiplicity_iff hp, X_sub_C_pow_dvd_iff_forall_eval_hasseDeriv_eq_zero]

end Polynomial

namespace TauCeti

open Polynomial Function

section Semiring

variable {R : Type*} [Semiring R]

/-- The Taylor coordinates of order below `n` at `r`: `f ↦ (D^[k] f (r))_{k < n}`. -/
noncomputable def taylorJet (r : R) (n : ℕ) : R[X] →ₗ[R] Fin n → R :=
  LinearMap.pi fun k => leval r ∘ₗ hasseDeriv (k : ℕ)

@[simp]
theorem taylorJet_apply (r : R) (n : ℕ) (f : R[X]) (k : Fin n) :
    taylorJet r n f k = (hasseDeriv k f).eval r := by
  simp [taylorJet]

end Semiring

section Ring

variable {R : Type*} [Ring R]

/-- The Taylor coordinates of `∑ k, c k • (X - C r) ^ k` are `c`. -/
theorem taylorJet_sum_smul_X_sub_C_pow (r : R) {n : ℕ} (c : Fin n → R) :
    taylorJet r n (∑ k : Fin n, c k • (X - C r) ^ (k : ℕ)) = c := by
  ext k
  simp [eval_finsetSum, Fin.val_inj]

/-- Every family of Taylor coordinates is attained, by `∑ k, c k • (X - C r) ^ k`. -/
theorem taylorJet_surjective (r : R) (n : ℕ) : Surjective (taylorJet r n) :=
  fun c => ⟨_, taylorJet_sum_smul_X_sub_C_pow r c⟩

/-- The Taylor coordinates of order below `n` at `r` vanish iff `f` lies in the left ideal
generated by `(X - C r) ^ n`, that is, iff `f = g * (X - C r) ^ n` for some `g`. -/
theorem taylorJet_eq_zero_iff {r : R} {n : ℕ} {f : R[X]} :
    taylorJet r n f = 0 ↔ f ∈ Ideal.span {(X - C r) ^ n} := by
  rw [mem_span_X_sub_C_pow_iff_forall_eval_hasseDeriv_eq_zero, funext_iff]
  simp [Fin.forall_iff]

/-- The kernel of the Taylor coordinates is the left ideal generated by `(X - C r) ^ n`. -/
theorem ker_taylorJet (r : R) (n : ℕ) :
    LinearMap.ker (taylorJet r n) = (Ideal.span {(X - C r) ^ n}).restrictScalars R := by
  ext f
  simp [taylorJet_eq_zero_iff]

/-- The Taylor coordinates induce an `R`-linear equivalence
`R[X] ⧸ ((X - C r) ^ n) ≃ₗ[R] Fin n → R` from the quotient by the left ideal generated by
`(X - C r) ^ n`. Over a commutative ring it respects multiplication for `n ≤ 1`, but for `n ≥ 2`
over a nontrivial commutative ring it does not respect pointwise multiplication on `Fin n → R`. -/
noncomputable def taylorJetQuotientEquiv (r : R) (n : ℕ) :
    (R[X] ⧸ Ideal.span {(X - C r) ^ n}) ≃ₗ[R] Fin n → R :=
  (Submodule.Quotient.restrictScalarsEquiv R _).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _ (ker_taylorJet r n).symm ≪≫ₗ
    (taylorJet r n).quotKerEquivOfSurjective (taylorJet_surjective r n)

@[simp]
theorem taylorJetQuotientEquiv_mk (r : R) (n : ℕ) (f : R[X]) :
    taylorJetQuotientEquiv r n (Submodule.Quotient.mk f) = taylorJet r n f := by
  simp [taylorJetQuotientEquiv]

/-- `TauCeti.taylorJetQuotientEquiv_mk` for the quotient ring map `Ideal.Quotient.mk`, available
when the ideal generated by `(X - C r) ^ n` is two-sided, for instance over a commutative ring. -/
@[simp]
theorem taylorJetQuotientEquiv_ideal_mk (r : R) (n : ℕ)
    [(Ideal.span {(X - C r) ^ n}).IsTwoSided] (f : R[X]) :
    taylorJetQuotientEquiv r n (Ideal.Quotient.mk _ f) = taylorJet r n f := by
  rw [← Ideal.Quotient.mk_eq_mk, taylorJetQuotientEquiv_mk]

/-- The inverse of `taylorJetQuotientEquiv` sends `c` to the class of `∑ k, c k • (X - C r) ^ k`. -/
theorem taylorJetQuotientEquiv_symm_apply (r : R) (n : ℕ) (c : Fin n → R) :
    (taylorJetQuotientEquiv r n).symm c =
      Submodule.Quotient.mk (∑ k : Fin n, c k • (X - C r) ^ (k : ℕ)) := by
  rw [LinearEquiv.symm_apply_eq, taylorJetQuotientEquiv_mk, taylorJet_sum_smul_X_sub_C_pow]

end Ring

end TauCeti
