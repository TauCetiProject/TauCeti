module

public import Mathlib.Algebra.Star.Subalgebra
public import Mathlib.RingTheory.TwoSidedIdeal.Kernel
import TauCeti.Algebra.Algebra.Subalgebra.Pointwise

/-!
# Supplements to `⋆`-algebra homomorphisms and `⋆`-subalgebras

This file supplies basic API for `⋆`-algebra homomorphisms and `⋆`-subalgebras omitted from
`Mathlib.Algebra.Star.NonUnitalSubalgebra` and `Mathlib.Algebra.Star.Subalgebra`:

1. **Range and codomain restrictions of `⋆`-algebra homomorphisms.** Mathlib defines `codRestrict`
   and `rangeRestrict` for `NonUnitalStarAlgHom` and `StarAlgHom`, but omits surjectivity of
   `rangeRestrict`, the coercion simp lemma `StarAlgHom.coe_rangeRestrict`, and compatibility of
   `TwoSidedIdeal.ker` with codomain and range restriction. We supply these in nonunital and unital
   generality, mirroring `AlgHom.rangeRestrict_surjective` and `AlgHom.ker_rangeRestrict`.
2. **Transport and underlying submodules of `⋆`-subalgebras.** Equal `⋆`-subalgebras are isomorphic
   via `StarSubalgebra.equivOfEq` (the `⋆`-analog of `Subalgebra.equivOfEq`, used to transport
   `StarAlgEquiv.ofInjective` across range identities). Forgetting `⋆` commutes with binary joins
   (`StarSubalgebra.sup_toSubalgebra`), so commuting `⋆`-subalgebras have join carrier
   `S.toSubmodule * T.toSubmodule` (`StarSubalgebra.toSubmodule_sup_of_commute`), and the
   `⋆`-subalgebra generated by a self-adjoint multiplicatively closed set `s` has underlying
   submodule `Submodule.span R (insert 1 s)` (`StarAlgebra.adjoin_eq_span_of_mul_mem`).

## Main declarations and results

* `NonUnitalStarAlgHom.rangeRestrict_surjective`, `StarAlgHom.rangeRestrict_surjective`, and
  `StarAlgHom.coe_rangeRestrict`: surjectivity and coercion of range restrictions.
* `NonUnitalStarAlgHom.ker_codRestrict`, `NonUnitalStarAlgHom.ker_rangeRestrict`,
  `StarAlgHom.ker_codRestrict`, and `StarAlgHom.ker_rangeRestrict`: restricting the codomain or
  range preserves `TwoSidedIdeal.ker`.
* `StarSubalgebra.equivOfEq`: `S ≃⋆ₐ[R] T` from an equality `S = T` of `⋆`-subalgebras.
* `StarSubalgebra.sup_toSubalgebra` and `StarSubalgebra.toSubmodule_sup_of_commute`: `(S ⊔ T)` has
  underlying subalgebra `S.toSubalgebra ⊔ T.toSubalgebra`, and underlying submodule
  `S.toSubmodule * T.toSubmodule` when `S` and `T` commute elementwise.
* `StarAlgebra.adjoin_eq_span_of_mul_mem`: for a self-adjoint multiplicatively closed set `s`,
  `StarAlgebra.adjoin R s` has underlying submodule `Submodule.span R (insert 1 s)`.

## Implementation notes

`NonUnitalStarAlgHom.rangeRestrict` is an `abbrev` for `NonUnitalStarAlgHom.codRestrict`, so
`@[simp]` is placed on `NonUnitalStarAlgHom.ker_codRestrict` (which already simplifies
`TwoSidedIdeal.ker f.rangeRestrict`), whereas `StarAlgHom.rangeRestrict` is an irreducible `def` and
receives its own `@[simp]` lemmas (`StarAlgHom.coe_rangeRestrict` and
`StarAlgHom.ker_rangeRestrict`).
-/

public section

namespace NonUnitalStarAlgHom

section RangeRestrict

variable {R A B : Type*} [CommSemiring R]
  [NonUnitalNonAssocSemiring A] [Module R A] [Star A]
  [NonUnitalNonAssocSemiring B] [Module R B] [Star B]

/-- Restricting a nonunital `⋆`-algebra homomorphism to its range gives a surjective map. -/
theorem rangeRestrict_surjective (f : A →⋆ₙₐ[R] B) : Function.Surjective f.rangeRestrict :=
  fun ⟨_, a, ha⟩ => ⟨a, Subtype.ext ha⟩

end RangeRestrict

section Ker

variable {R A B : Type*} [CommSemiring R]
  [NonUnitalNonAssocRing A] [Module R A] [Star A]
  [NonUnitalNonAssocSemiring B] [Module R B] [Star B]

/-- Restricting the codomain of a nonunital `⋆`-algebra homomorphism to a nonunital `⋆`-subalgebra
preserves its two-sided ideal kernel. -/
@[simp]
theorem ker_codRestrict (f : A →⋆ₙₐ[R] B) (S : NonUnitalStarSubalgebra R B)
    (hf : ∀ x, f x ∈ S) :
    TwoSidedIdeal.ker (f.codRestrict S hf) = TwoSidedIdeal.ker f := by
  ext a
  rw [TwoSidedIdeal.mem_ker, TwoSidedIdeal.mem_ker, Subtype.ext_iff]
  rfl

/-- Restricting a nonunital `⋆`-algebra homomorphism to its range preserves its two-sided ideal
kernel. -/
theorem ker_rangeRestrict (f : A →⋆ₙₐ[R] B) :
    TwoSidedIdeal.ker f.rangeRestrict = TwoSidedIdeal.ker f :=
  f.ker_codRestrict f.range f.mem_range_self

end Ker

end NonUnitalStarAlgHom

namespace StarAlgHom

section RangeRestrict

variable {R A B : Type*} [CommSemiring R] [StarRing R]
  [Semiring A] [Algebra R A] [StarRing A]
  [Semiring B] [Algebra R B] [StarRing B] [StarModule R B]

/-- Coercing `f.rangeRestrict x` back to the ambient algebra recovers `f x`. -/
@[simp]
theorem coe_rangeRestrict (f : A →⋆ₐ[R] B) (x : A) : (f.rangeRestrict x : B) = f x :=
  (rfl)

/-- Restricting a unital `⋆`-algebra homomorphism to its range gives a surjective map. -/
theorem rangeRestrict_surjective (f : A →⋆ₐ[R] B) : Function.Surjective f.rangeRestrict :=
  f.toAlgHom.rangeRestrict_surjective

end RangeRestrict

section Ker

variable {R A B : Type*} [CommSemiring R] [StarRing R]
  [Ring A] [Algebra R A] [StarRing A]
  [Semiring B] [Algebra R B] [StarRing B] [StarModule R B]

/-- Restricting the codomain of a unital `⋆`-algebra homomorphism to a `⋆`-subalgebra preserves its
two-sided ideal kernel. -/
@[simp]
theorem ker_codRestrict (f : A →⋆ₐ[R] B) (S : StarSubalgebra R B) (hf : ∀ x, f x ∈ S) :
    TwoSidedIdeal.ker (f.codRestrict S hf) = TwoSidedIdeal.ker f :=
  f.toNonUnitalStarAlgHom.ker_codRestrict S.toNonUnitalStarSubalgebra hf

/-- Restricting a unital `⋆`-algebra homomorphism to its range preserves its two-sided ideal kernel.
-/
@[simp]
theorem ker_rangeRestrict (f : A →⋆ₐ[R] B) :
    TwoSidedIdeal.ker f.rangeRestrict = TwoSidedIdeal.ker f :=
  f.ker_codRestrict f.range fun x => ⟨x, rfl⟩

end Ker

end StarAlgHom

namespace StarSubalgebra

open scoped Pointwise

variable {R A : Type*} [CommSemiring R] [StarRing R]
  [Semiring A] [StarRing A] [Algebra R A] [StarModule R A]

/-- Two `⋆`-subalgebras that are equal are also equivalent as `⋆`-algebras.

This is the `StarSubalgebra` version of `Subalgebra.equivOfEq` and `LinearEquiv.ofEq`. -/
def equivOfEq (S T : StarSubalgebra R A) (h : S = T) : S ≃⋆ₐ[R] T :=
  StarAlgEquiv.ofAlgEquiv
    (S.toSubalgebra.equivOfEq T.toSubalgebra (congrArg toSubalgebra h)) fun _ => rfl

@[simp]
theorem equivOfEq_apply (S T : StarSubalgebra R A) (h : S = T) (x : S) :
    equivOfEq S T h x = ⟨x, h ▸ x.property⟩ :=
  (rfl)

@[simp]
theorem equivOfEq_symm (S T : StarSubalgebra R A) (h : S = T) :
    (equivOfEq S T h).symm = equivOfEq T S h.symm := by
  ext; rfl

@[simp]
theorem equivOfEq_rfl (S : StarSubalgebra R A) :
    equivOfEq S S rfl = StarAlgEquiv.refl R S := by
  ext; rfl

@[simp]
theorem equivOfEq_trans (S T U : StarSubalgebra R A) (hST : S = T) (hTU : T = U) :
    (equivOfEq S T hST).trans (equivOfEq T U hTU) = equivOfEq S U (hST.trans hTU) := by
  ext; rfl

/-- Forgetting the `⋆`-operation preserves binary joins of `⋆`-subalgebras, since the subalgebra
generated by two `⋆`-subalgebras is already closed under `⋆`. -/
@[simp]
theorem sup_toSubalgebra (S T : StarSubalgebra R A) :
    (S ⊔ T).toSubalgebra = S.toSubalgebra ⊔ T.toSubalgebra := by
  refine le_antisymm ?_
    (sup_le (toSubalgebra_le_iff.mpr le_sup_left) (toSubalgebra_le_iff.mpr le_sup_right))
  have hstar : S.toSubalgebra ⊔ T.toSubalgebra ≤ star (S.toSubalgebra ⊔ T.toSubalgebra) :=
    sup_le (fun _ hx => le_sup_left (α := Subalgebra R A) (S.star_mem' hx))
      (fun _ hx => le_sup_right (α := Subalgebra R A) (T.star_mem' hx))
  let U : StarSubalgebra R A := ⟨S.toSubalgebra ⊔ T.toSubalgebra, fun hx => hstar hx⟩
  exact toSubalgebra_le_iff.mpr (sup_le (a := S) (b := T) (c := U)
    (toSubalgebra_le_iff.mp le_sup_left) (toSubalgebra_le_iff.mp le_sup_right))

/-- If every element of `S` commutes with every element of `T`, the underlying submodule of the
`⋆`-subalgebra join `S ⊔ T` is the submodule product `S.toSubmodule * T.toSubmodule`. -/
theorem toSubmodule_sup_of_commute {S T : StarSubalgebra R A}
    (hcomm : ∀ a ∈ S, ∀ b ∈ T, Commute a b) :
    (S ⊔ T).toSubmodule = S.toSubmodule * T.toSubmodule := by
  rw [sup_toSubalgebra, ← Subalgebra.mul_toSubmodule_of_commute S.toSubalgebra T.toSubalgebra hcomm]

end StarSubalgebra

namespace StarAlgebra

open scoped Pointwise

variable {R A : Type*} [CommSemiring R] [StarRing R]
  [Semiring A] [StarRing A] [Algebra R A] [StarModule R A]

/-- For a self-adjoint multiplicatively closed subset `s`, the `⋆`-algebra it generates has
underlying submodule `Submodule.span R (insert 1 s)`. -/
theorem adjoin_eq_span_of_mul_mem {s : Set A} (hstar : star s ⊆ s)
    (hmul : ∀ a ∈ s, ∀ b ∈ s, a * b ∈ s) :
    (adjoin R s).toSubmodule = Submodule.span R (insert 1 s) := by
  let sg : Subsemigroup A := ⟨s, fun {a b} ha hb => hmul a ha b hb⟩
  have hsg : (Subsemigroup.closure s : Set A) = s :=
    congrArg SetLike.coe
      (Subsemigroup.closure_eq_of_le (S := sg) subset_rfl Subsemigroup.subset_closure)
  rw [adjoin_eq_span, Set.union_eq_left.2 hstar, Submonoid.closure_eq_one_union, hsg,
    Set.singleton_union]
end StarAlgebra
