/-!
# Noncommutative star polynomials

For a commutative star ring `R` and a type `ι`, `TauCeti.StarPolynomial R ι` is the free unital
star `R`-algebra on generators `Xᵢ`, `i : ι`. As an `R`-algebra it is the free algebra
`FreeAlgebra R (ι × Bool)`, where `(i, false)` stands for `Xᵢ` and `(i, true)` for its formal
adjoint `Xᵢ*`. Its involution conjugates coefficients, reverses words and exchanges each
generator with its formal adjoint, so that for instance
`star (c • X i * X j) = star c • star (X j) * star (X i)`.

These are the noncommutative *-polynomials of free probability: the *-distribution of a family
`a : ι → A` in a star algebra is a functional on `StarPolynomial ℂ ι`, evaluated through
`StarPolynomial.lift a`. The star structure is deliberately not Mathlib's `StarRing` instance on
`FreeAlgebra R X` from `Mathlib.Algebra.Star.Free`, which fixes both coefficients and generators;
for that reason `StarPolynomial R ι` is a type synonym carrying its own `StarRing` and
`StarModule R` instances. Commutative polynomials in `Xᵢ` and `Xᵢ*` would not encode arbitrary
noncommutative words.

## Main definitions

* `TauCeti.StarPolynomial R ι` — the noncommutative *-polynomials over `R` in variables indexed
  by `ι`, with its `StarRing` and `StarModule R` instances.
* `TauCeti.StarPolynomial.X i` — the generator `Xᵢ`; its adjoint is `star (X i)`.
* `TauCeti.StarPolynomial.lift` — the universal property: families `ι → A` in a star
  `R`-algebra correspond to star algebra homomorphisms `StarPolynomial R ι →⋆ₐ[R] A`.
* `TauCeti.StarPolynomial.ofFreeAlgebra` — the map from the noncommutative polynomials without
  adjoints, `Xᵢ ↦ Xᵢ`.
* `TauCeti.StarPolynomial.toFreeAlgebra` — the identification with `FreeAlgebra R (ι × Bool)`,
  forgetting the star structure.
* `TauCeti.StarPolynomial.withStar a` — the family of the values `a i` and their adjoints,
  indexed by the letters `ι × Bool`.

## Main results

* `TauCeti.StarPolynomial.induction` — induction over scalars, generators and their adjoints.
* `TauCeti.StarPolynomial.hom_ext` — star algebra homomorphisms out of `StarPolynomial R ι` are
  determined by their values on the generators.
* `TauCeti.StarPolynomial.adjoin_range_X` — the generators generate `StarPolynomial R ι` as a
  star algebra.
* `TauCeti.StarPolynomial.range_lift` — the image of evaluation at `a` is the unital star
  subalgebra generated by the family `a`.
* `TauCeti.StarPolynomial.lift_ofFreeAlgebra` — on polynomials without adjoints, evaluation is
  `FreeAlgebra.lift`.
* `TauCeti.StarPolynomial.lift_apply` — evaluation at `a` is free-algebra evaluation at
  `withStar a`.
* `TauCeti.StarPolynomial.star_X_ne_X` — over a nontrivial ring no generator is self-adjoint.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 4.
-/

public section

noncomputable section

namespace TauCeti

variable (R ι : Type*) [CommSemiring R]

/-- The noncommutative *-polynomials over `R` in variables `Xᵢ`, `i : ι`: the free algebra on
the letters `(i, false)`, standing for `Xᵢ`, and `(i, true)`, standing for its formal adjoint
`Xᵢ*`. When `R` is a star ring it carries the involution conjugating coefficients, reversing words
and exchanging `Xᵢ` with `Xᵢ*`, which makes it the free unital star `R`-algebra on `ι`. -/
def StarPolynomial : Type _ :=
  FreeAlgebra R (ι × Bool)

namespace StarPolynomial

instance : Semiring (StarPolynomial R ι) :=
  inferInstanceAs (Semiring (FreeAlgebra R (ι × Bool)))

instance : Algebra R (StarPolynomial R ι) :=
  inferInstanceAs (Algebra R (FreeAlgebra R (ι × Bool)))

instance {R : Type*} [CommRing R] : Ring (StarPolynomial R ι) :=
  inferInstanceAs (Ring (FreeAlgebra R (ι × Bool)))

variable {R ι}

/-- The letter `x` of the underlying free algebra, as a star polynomial: `Xᵢ` for `x = (i, false)`
and `Xᵢ*` for `x = (i, true)`. -/
private def gen (x : ι × Bool) : StarPolynomial R ι :=
  FreeAlgebra.ι R x

/-- The generator `Xᵢ` of the star polynomials. Its formal adjoint is `star (X i)`. -/
def X (i : ι) : StarPolynomial R ι :=
  gen (i, false)

/-- Induction on star polynomials over the letters `Xᵢ` and `Xᵢ*` of the underlying free
algebra. -/
@[elab_as_elim]
private theorem induction_gen {motive : StarPolynomial R ι → Prop}
    (algebraMap : ∀ r, motive (algebraMap R (StarPolynomial R ι) r))
    (gen : ∀ x, motive (gen x)) (mul : ∀ p q, motive p → motive q → motive (p * q))
    (add : ∀ p q, motive p → motive q → motive (p + q)) (p : StarPolynomial R ι) :
    motive p :=
  FreeAlgebra.induction R (ι × Bool) algebraMap gen mul add p

/-- Evaluation of the letters of the underlying free algebra in an `R`-algebra. -/
private def liftGen {A : Type*} [Semiring A] [Algebra R A] (f : ι × Bool → A) :
    StarPolynomial R ι →ₐ[R] A :=
  FreeAlgebra.lift R f

private theorem liftGen_gen {A : Type*} [Semiring A] [Algebra R A] (f : ι × Bool → A)
    (x : ι × Bool) : liftGen (R := R) f (gen x) = f x :=
  FreeAlgebra.lift_ι_apply f x

private theorem adjoin_range_gen : Algebra.adjoin R (Set.range (gen (R := R) (ι := ι))) = ⊤ :=
  FreeAlgebra.adjoin_range_ι R (ι × Bool)

/-- The underlying free algebra as the monoid algebra of the free monoid on the letters. -/
private def toMonoidAlgebra :
    StarPolynomial R ι ≃ₐ[R] MonoidAlgebra R (FreeMonoid (ι × Bool)) :=
  FreeAlgebra.equivMonoidAlgebraFreeMonoid

private theorem toMonoidAlgebra_gen (x : ι × Bool) :
    toMonoidAlgebra (gen (R := R) x) = MonoidAlgebra.single (FreeMonoid.of x) 1 :=
  FreeAlgebra.lift_ι_apply _ x

/-- Reversal of words exchanging each generator with its formal adjoint, as an `R`-algebra map
to the opposite algebra. -/
private def reverseSwap : StarPolynomial R ι →ₐ[R] (StarPolynomial R ι)ᵐᵒᵖ :=
  liftGen fun x ↦ MulOpposite.op (gen (x.1, !x.2))

section Star

variable [StarRing R]

/-- Coefficientwise conjugation of star polynomials, computed in the monoid algebra of the free
monoid on the letters. -/
private def conjCoeffs : StarPolynomial R ι →+* StarPolynomial R ι :=
  (toMonoidAlgebra.toRingEquiv.symm.toRingHom.comp
    (MonoidAlgebra.mapRingHom (FreeMonoid (ι × Bool)) (starRingEnd R))).comp
    toMonoidAlgebra.toRingEquiv.toRingHom

private theorem conjCoeffs_apply (p : StarPolynomial R ι) :
    conjCoeffs p = toMonoidAlgebra.symm
      (MonoidAlgebra.mapRingHom (FreeMonoid (ι × Bool)) (starRingEnd R) (toMonoidAlgebra p)) :=
  rfl

private theorem conjCoeffs_gen (x : ι × Bool) : conjCoeffs (gen (R := R) x) = gen x := by
  rw [conjCoeffs_apply, toMonoidAlgebra_gen, MonoidAlgebra.mapRingHom_single, map_one,
    ← toMonoidAlgebra_gen, AlgEquiv.symm_apply_apply]

private theorem conjCoeffs_algebraMap (r : R) :
    conjCoeffs (algebraMap R (StarPolynomial R ι) r) =
      algebraMap R (StarPolynomial R ι) (star r) := by
  rw [conjCoeffs_apply, AlgEquiv.commutes, ← RingHom.comp_apply,
    MonoidAlgebra.mapRingHom_comp_algebraMap, RingHom.comp_apply, starRingEnd_apply,
    AlgEquiv.commutes]

/-- The involution of the star polynomials, before it is packaged as a `StarRing` instance. -/
private def starAux (p : StarPolynomial R ι) : StarPolynomial R ι :=
  conjCoeffs (reverseSwap p).unop

private theorem starAux_add (p q : StarPolynomial R ι) :
    starAux (p + q) = starAux p + starAux q := by
  simp [starAux]

private theorem starAux_mul (p q : StarPolynomial R ι) :
    starAux (p * q) = starAux q * starAux p := by
  simp [starAux]

private theorem starAux_algebraMap (r : R) :
    starAux (algebraMap R (StarPolynomial R ι) r) =
      algebraMap R (StarPolynomial R ι) (star r) := by
  simp [starAux, conjCoeffs_algebraMap]

private theorem starAux_gen (x : ι × Bool) : starAux (gen (R := R) x) = gen (x.1, !x.2) := by
  simp [starAux, reverseSwap, liftGen_gen, conjCoeffs_gen]

private theorem starAux_starAux (p : StarPolynomial R ι) : starAux (starAux p) = p := by
  induction p using induction_gen with
  | algebraMap r => simp [starAux_algebraMap]
  | gen x => simp [starAux_gen]
  | mul p q hp hq => rw [starAux_mul, starAux_mul, hp, hq]
  | add p q hp hq => rw [starAux_add, starAux_add, hp, hq]

/-- The involution of the star polynomials conjugates coefficients, reverses words and exchanges
each generator `Xᵢ` with its formal adjoint `Xᵢ*`. -/
@[no_expose]
instance : StarRing (StarPolynomial R ι) where
  star := starAux
  star_involutive := starAux_starAux
  star_mul := starAux_mul
  star_add := starAux_add

private theorem star_gen (x : ι × Bool) : star (gen (R := R) x) = gen (x.1, !x.2) :=
  starAux_gen x

private theorem star_algebraMap (r : R) :
    star (algebraMap R (StarPolynomial R ι) r) = algebraMap R (StarPolynomial R ι) (star r) :=
  starAux_algebraMap r

instance : StarModule R (StarPolynomial R ι) where
  star_smul r p := by
    rw [Algebra.smul_def, Algebra.smul_def, star_mul, star_algebraMap]
    exact (Algebra.commutes (star r) (star p)).symm

private theorem star_X (i : ι) : star (X (R := R) i) = gen (i, true) :=
  star_gen (i, false)

/-- Induction on star polynomials: a property of scalars, generators and their adjoints that is
preserved by multiplication and addition holds for every star polynomial. -/
@[elab_as_elim, induction_eliminator]
theorem induction {motive : StarPolynomial R ι → Prop}
    (algebraMap : ∀ r, motive (algebraMap R (StarPolynomial R ι) r))
    (X : ∀ i, motive (StarPolynomial.X i)) (star_X : ∀ i, motive (star (StarPolynomial.X i)))
    (mul : ∀ p q, motive p → motive q → motive (p * q))
    (add : ∀ p q, motive p → motive q → motive (p + q)) (p : StarPolynomial R ι) :
    motive p := by
  induction p using induction_gen with
  | algebraMap r => exact algebraMap r
  | gen x =>
    obtain ⟨i, _ | _⟩ := x
    · exact X i
    · simpa only [StarPolynomial.star_X] using star_X i
  | mul p q hp hq => exact mul p q hp hq
  | add p q hp hq => exact add p q hp hq

/-- The generators and their adjoints generate the star polynomials as a star algebra. -/
@[simp]
theorem adjoin_range_X : StarAlgebra.adjoin R (Set.range (X (R := R) (ι := ι))) = ⊤ := by
  refine StarSubalgebra.toSubalgebra_injective ?_
  rw [StarSubalgebra.top_toSubalgebra, StarAlgebra.adjoin_toSubalgebra, eq_top_iff,
    ← adjoin_range_gen]
  refine Algebra.adjoin_mono ?_
  rintro _ ⟨⟨i, b⟩, rfl⟩
  cases b
  · exact Or.inl ⟨i, rfl⟩
  · exact Or.inr ⟨i, (star_gen (i, true)).symm⟩

variable {A : Type*} [Semiring A] [Algebra R A] [StarRing A]

/-- Two star algebra homomorphisms out of the star polynomials agree once they agree on the
generators. -/
@[ext]
theorem hom_ext {f g : StarPolynomial R ι →⋆ₐ[R] A} (h : ∀ i, f (X i) = g (X i)) : f = g :=
  StarAlgHom.ext_of_adjoin_eq_top adjoin_range_X <| by
    rintro _ ⟨i, rfl⟩
    exact h i

variable [StarModule R A]

/-- Evaluation of the letters `Xᵢ ↦ a i` and `Xᵢ* ↦ star (a i)` commutes with the
involutions. -/
private theorem liftGen_star (a : ι → A) (p : StarPolynomial R ι) :
    liftGen (fun x ↦ if x.2 then star (a x.1) else a x.1) (star p) =
      star (liftGen (fun x ↦ if x.2 then star (a x.1) else a x.1) p) := by
  induction p using induction_gen with
  | algebraMap r => rw [star_algebraMap, AlgHom.commutes, AlgHom.commutes, algebraMap_star_comm]
  | gen x => obtain ⟨i, _ | _⟩ := x <;> simp [star_gen, liftGen_gen]
  | mul p q hp hq => rw [star_mul, map_mul, map_mul, hp, hq, star_mul]
  | add p q hp hq => rw [star_add, map_add, map_add, hp, hq, star_add]

/-- Evaluation of the letters `Xᵢ ↦ a i` and `Xᵢ* ↦ star (a i)`. -/
private def liftAux (a : ι → A) : StarPolynomial R ι →⋆ₐ[R] A where
  toAlgHom := liftGen fun x ↦ if x.2 then star (a x.1) else a x.1
  map_star' := liftGen_star a

private theorem liftAux_X (a : ι → A) (i : ι) : liftAux a (X (R := R) i) = a i := by
  simp [liftAux, X, liftGen_gen]

/-- The universal property of the star polynomials: a family `a : ι → A` in a star `R`-algebra
extends uniquely to a star algebra homomorphism sending `Xᵢ` to `a i`, and hence `star (X i)` to
`star (a i)`. Applied to a star polynomial `p`, `lift a p` is the evaluation of `p` at `a`. -/
def lift : (ι → A) ≃ (StarPolynomial R ι →⋆ₐ[R] A) where
  toFun := liftAux
  invFun f i := f (X i)
  left_inv a := funext <| liftAux_X a
  right_inv f := hom_ext <| liftAux_X fun i ↦ f (X i)

@[simp]
theorem lift_X (a : ι → A) (i : ι) : lift a (X (R := R) i) = a i :=
  liftAux_X a i

/-- Evaluation sends the formal adjoint `Xᵢ*` to the adjoint of `a i`. -/
@[simp]
theorem lift_star_X (a : ι → A) (i : ι) : lift a (star (X (R := R) i)) = star (a i) := by
  rw [map_star, lift_X]

@[simp]
theorem lift_symm_apply (f : StarPolynomial R ι →⋆ₐ[R] A) (i : ι) :
    lift.symm f i = f (X i) :=
  congrFun ((Equiv.symm_apply_eq lift).2 (hom_ext fun j ↦ (lift_X (fun i ↦ f (X i)) j).symm)) i

/-- Evaluating the generators gives the identity. -/
@[simp]
theorem lift_X_eq_id : lift (X (R := R) (ι := ι)) = StarAlgHom.id R (StarPolynomial R ι) :=
  hom_ext <| lift_X X

/-- Evaluation is natural in the target star algebra. -/
theorem comp_lift {B : Type*} [Semiring B] [Algebra R B] [StarRing B] [StarModule R B]
    (f : A →⋆ₐ[R] B) (a : ι → A) : f.comp (lift a) = lift (R := R) (f ∘ a) :=
  hom_ext fun i ↦ by simp

/-- The image of evaluation at `a` is the unital star subalgebra generated by the family `a`. -/
theorem range_lift (a : ι → A) :
    (lift (R := R) a).range = StarAlgebra.adjoin R (Set.range a) := by
  rw [StarAlgHom.range_eq_map_top, ← adjoin_range_X, StarAlgHom.map_adjoin, ← Set.range_comp]
  congr 2
  funext i
  exact lift_X a i

/-- Over a nontrivial ring no generator is self-adjoint: its adjoint `star (X i)` is a separate
variable. -/
theorem star_X_ne_X [Nontrivial R] (i : ι) : star (X (R := R) i) ≠ X i := by
  rw [star_X, X]
  intro h
  simpa using FreeAlgebra.ι_injective (R := R) h

end Star

variable (R ι) in
/-- The noncommutative polynomials in the variables `Xᵢ`, without their adjoints, mapped into the
star polynomials by sending each `Xᵢ` to `Xᵢ`. -/
def ofFreeAlgebra : FreeAlgebra R ι →ₐ[R] StarPolynomial R ι :=
  FreeAlgebra.lift R X

@[simp]
theorem ofFreeAlgebra_ι (i : ι) : ofFreeAlgebra R ι (FreeAlgebra.ι R i) = X i :=
  FreeAlgebra.lift_ι_apply X i

/-- On polynomials without adjoints, evaluating a star polynomial is evaluating the
noncommutative polynomial with `FreeAlgebra.lift`. -/
@[simp]
theorem lift_ofFreeAlgebra [StarRing R] {A : Type*} [Semiring A] [Algebra R A] [StarRing A]
    [StarModule R A] (a : ι → A) (p : FreeAlgebra R ι) :
    lift a (ofFreeAlgebra R ι p) = FreeAlgebra.lift R a p := by
  have h : ((lift a : StarPolynomial R ι →⋆ₐ[R] A) : StarPolynomial R ι →ₐ[R] A).comp
      (ofFreeAlgebra R ι) = FreeAlgebra.lift R a :=
    FreeAlgebra.hom_ext <| funext fun i ↦ by simp
  exact DFunLike.congr_fun h p

section WithStar

/-- The family of the variables and their adjoints indexed by `ι × Bool`: the letter `(i, false)`
takes the value `a i` and the letter `(i, true)` takes the value `star (a i)`. -/
def withStar {A : Type*} [Star A] (a : ι → A) (x : ι × Bool) : A :=
  if x.2 then star (a x.1) else a x.1

theorem withStar_def {A : Type*} [Star A] (a : ι → A) (x : ι × Bool) :
    withStar a x = if x.2 then star (a x.1) else a x.1 :=
  (rfl)

@[simp]
theorem withStar_mk_false {A : Type*} [Star A] (a : ι → A) (i : ι) :
    withStar a (i, false) = a i :=
  (rfl)

@[simp]
theorem withStar_mk_true {A : Type*} [Star A] (a : ι → A) (i : ι) :
    withStar a (i, true) = star (a i) :=
  (rfl)

variable (R ι) in
/-- The identification of the star polynomials with the free algebra on the letters `(i, false)`,
standing for `Xᵢ`, and `(i, true)`, standing for `Xᵢ*`. It forgets the star structure. -/
def toFreeAlgebra : StarPolynomial R ι ≃ₐ[R] FreeAlgebra R (ι × Bool) :=
  AlgEquiv.refl

@[simp]
theorem toFreeAlgebra_X (i : ι) : toFreeAlgebra R ι (X i) = FreeAlgebra.ι R (i, false) :=
  (rfl)

variable [StarRing R]

@[simp]
theorem toFreeAlgebra_star_X (i : ι) :
    toFreeAlgebra R ι (star (X i)) = FreeAlgebra.ι R (i, true) :=
  congrArg (toFreeAlgebra R ι) (star_X i)

variable {A : Type*} [Semiring A] [Algebra R A] [StarRing A] [StarModule R A]

/-- Evaluating a star polynomial at `a` is evaluating the corresponding element of the free
algebra at the family `withStar a` of the values and their adjoints. -/
theorem lift_apply (a : ι → A) (p : StarPolynomial R ι) :
    lift a p = FreeAlgebra.lift R (withStar a) (toFreeAlgebra R ι p) :=
  (rfl)

@[simp]
theorem lift_withStar (a : ι → A) (x : ι × Bool) :
    lift a (withStar (X (R := R)) x) = withStar a x := by
  obtain ⟨i, _ | _⟩ := x <;> simp

end WithStar

end StarPolynomial

end TauCeti
