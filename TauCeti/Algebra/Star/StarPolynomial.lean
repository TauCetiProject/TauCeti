module

public import Mathlib.Algebra.FreeAlgebra
public import Mathlib.Algebra.Star.Subalgebra

/-!
# Noncommutative star polynomials

`StarPolynomial R ι` is the free unital star algebra over a commutative star ring `R` on
variables `X i`, `i : ι`. As an algebra it is the free algebra on `ι × Bool`, where the
generator `(i, false)` is the variable `X i` and `(i, true)` is its formal adjoint. Its star
structure conjugates coefficients, reverses the order of words and exchanges each variable with
its adjoint, so `star (X i)` is the generator `(i, true)`.

This is deliberately a type synonym: the star structure on `FreeAlgebra R (ι × Bool)` from
`Mathlib.Algebra.Star.Free` fixes coefficients and generators, so it does not model adjoints.

Evaluation `StarPolynomial.lift` is the universal property: a family `a` in a star algebra
extends uniquely to a star algebra homomorphism sending `X i` to `a i`. Under the
identification with the free algebra it is ordinary free-algebra evaluation at the family
`StarPolynomial.withStar a` of the variables and their adjoints, and its range is the star
subalgebra generated by the family. Star polynomials are the test functions of
star distributions in noncommutative probability.

## Main definitions

* `TauCeti.StarPolynomial R ι`: noncommutative star polynomials, with its star structure.
* `TauCeti.StarPolynomial.X`, `TauCeti.StarPolynomial.generator`: the variables, and the
  generators indexed by `ι × Bool`.
* `TauCeti.StarPolynomial.toFreeAlgebra`: the identification with `FreeAlgebra R (ι × Bool)`.
* `TauCeti.StarPolynomial.lift`: evaluation, as an equivalence between families and star algebra
  homomorphisms.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 1,
  for star polynomials in noncommuting indeterminates and star distributions.
-/

public section

namespace TauCeti

variable (R ι : Type*) [CommSemiring R]

/-- Noncommutative star polynomials over `R` in variables indexed by `ι`: the free algebra on
`ι × Bool`, where `(i, false)` stands for the variable `X i` and `(i, true)` for its formal
adjoint. Its own star structure is `StarPolynomial.instStarRing`. -/
@[expose] def StarPolynomial : Type _ := FreeAlgebra R (ι × Bool)

namespace StarPolynomial

instance : Semiring (StarPolynomial R ι) := inferInstanceAs (Semiring (FreeAlgebra R (ι × Bool)))

instance : Algebra R (StarPolynomial R ι) :=
  inferInstanceAs (Algebra R (FreeAlgebra R (ι × Bool)))

instance {S : Type*} [CommRing S] : Ring (StarPolynomial S ι) :=
  inferInstanceAs (Ring (FreeAlgebra S (ι × Bool)))

/-- The identification of star polynomials with the free algebra on the variables and their
formal adjoints. It forgets the star structure. -/
def toFreeAlgebra : StarPolynomial R ι ≃ₐ[R] FreeAlgebra R (ι × Bool) := AlgEquiv.refl

/-- The generator indexed by `x : ι × Bool`: the variable `X x.1` if `x.2 = false`, and its
adjoint if `x.2 = true`. -/
noncomputable def generator (x : ι × Bool) : StarPolynomial R ι :=
  (toFreeAlgebra R ι).symm (FreeAlgebra.ι R x)

/-- The variable indexed by `i`. -/
noncomputable def X (i : ι) : StarPolynomial R ι := generator R ι (i, false)

variable {R ι}

@[simp]
theorem toFreeAlgebra_generator (x : ι × Bool) :
    toFreeAlgebra R ι (generator R ι x) = FreeAlgebra.ι R x := by
  simp [generator]

@[simp]
theorem toFreeAlgebra_symm_ι (x : ι × Bool) :
    (toFreeAlgebra R ι).symm (FreeAlgebra.ι R x) = generator R ι x := (rfl)

@[simp]
theorem generator_mk_false (i : ι) : generator R ι (i, false) = X R ι i := (rfl)

/-- Induction on star polynomials: a property of scalars and generators that is closed under
addition and multiplication holds for every star polynomial. -/
@[elab_as_elim]
theorem induction {C : StarPolynomial R ι → Prop}
    (algebraMap : ∀ r, C (algebraMap R (StarPolynomial R ι) r))
    (generator : ∀ x, C (generator R ι x)) (mul : ∀ a b, C a → C b → C (a * b))
    (add : ∀ a b, C a → C b → C (a + b)) (a : StarPolynomial R ι) : C a :=
  FreeAlgebra.induction R (ι × Bool) (motive := fun b => C ((toFreeAlgebra R ι).symm b))
    algebraMap generator (fun _ _ ha hb => mul _ _ ha hb) (fun _ _ ha hb => add _ _ ha hb)
    (toFreeAlgebra R ι a)

section Generators

/-- The family of values of the generators at `a`: the variable `(i, false)` takes the value
`a i` and its adjoint `(i, true)` takes the value `star (a i)`. -/
def withStar {A : Type*} [Star A] (a : ι → A) (x : ι × Bool) : A :=
  bif x.2 then star (a x.1) else a x.1

@[simp]
theorem withStar_mk_false {A : Type*} [Star A] (a : ι → A) (i : ι) :
    withStar a (i, false) = a i := (rfl)

@[simp]
theorem withStar_mk_true {A : Type*} [Star A] (a : ι → A) (i : ι) :
    withStar a (i, true) = star (a i) := (rfl)

/-- The values of the generators under evaluation are compatible with the star structure. -/
theorem withStar_mk_not {A : Type*} [InvolutiveStar A] (a : ι → A) (x : ι × Bool) :
    withStar a (x.1, !x.2) = star (withStar a x) := by
  obtain ⟨i, _ | _⟩ := x <;> simp

variable {A : Type*} [Semiring A] [Algebra R A] [Star A]

variable (R) in
/-- Evaluating a star polynomial at the family `a`, as a plain algebra homomorphism: free-algebra
evaluation at `withStar a`. Use `StarPolynomial.lift` instead. -/
private noncomputable def liftAlgHom (a : ι → A) : StarPolynomial R ι →ₐ[R] A :=
  (FreeAlgebra.lift R (withStar a)).comp (toFreeAlgebra R ι).toAlgHom

private theorem liftAlgHom_generator (a : ι → A) (x : ι × Bool) :
    liftAlgHom R a (generator R ι x) = withStar a x := by
  simp [liftAlgHom]

end Generators

/-! ### The star structure -/

variable [StarRing R]

/-- The conjugate-linear antimultiplicative map underlying the star structure, as a ring
homomorphism into the opposite ring: coefficients are conjugated and each generator is sent to
the generator with the other flag. -/
private noncomputable def starOpHom : StarPolynomial R ι →+* (StarPolynomial R ι)ᵐᵒᵖ :=
  (MonoidAlgebra.liftNCRingHom ((algebraMap R (StarPolynomial R ι)ᵐᵒᵖ).comp (starRingEnd R))
      (FreeMonoid.lift fun x => MulOpposite.op (generator R ι (x.1, !x.2)))
      fun r _ => Algebra.commute_algebraMap_left (star r) _).comp
    (FreeAlgebra.equivMonoidAlgebraFreeMonoid.toRingHom.comp (toFreeAlgebra R ι).toRingHom)

private theorem starOpHom_algebraMap (r : R) :
    starOpHom (algebraMap R (StarPolynomial R ι) r) =
      MulOpposite.op (algebraMap R (StarPolynomial R ι) (star r)) := by
  simp [starOpHom, MonoidAlgebra.coe_algebraMap, starRingEnd_apply]

private theorem starOpHom_generator (x : ι × Bool) :
    starOpHom (generator R ι x) = MulOpposite.op (generator R ι (x.1, !x.2)) := by
  simp [starOpHom, FreeAlgebra.equivMonoidAlgebraFreeMonoid]

/-- The star structure on star polynomials: conjugate the coefficients, reverse the order of
each word, and exchange each variable with its adjoint. -/
@[no_expose]
noncomputable instance instStarRing : StarRing (StarPolynomial R ι) where
  star a := (starOpHom a).unop
  star_involutive a := by
    induction a using StarPolynomial.induction with
    | algebraMap r => simp [starOpHom_algebraMap]
    | generator x => simp [starOpHom_generator]
    | add a b ha hb => simp only [map_add, MulOpposite.unop_add, ha, hb]
    | mul a b ha hb => simp only [map_mul, MulOpposite.unop_mul, ha, hb]
  star_mul a b := by simp only [map_mul, MulOpposite.unop_mul]
  star_add a b := by simp only [map_add, MulOpposite.unop_add]

/- After the `StarModule` instance below, this is Mathlib's `algebraMap_star_comm`. -/
private theorem star_algebraMap (r : R) :
    star (algebraMap R (StarPolynomial R ι) r) = algebraMap R (StarPolynomial R ι) (star r) :=
  congrArg MulOpposite.unop (starOpHom_algebraMap r)

@[simp]
theorem star_generator (x : ι × Bool) :
    star (generator R ι x) = generator R ι (x.1, !x.2) :=
  congrArg MulOpposite.unop (starOpHom_generator x)

/-- The adjoint generator `(i, true)` is the star of the variable `X i`. -/
@[simp]
theorem generator_mk_true (i : ι) : generator R ι (i, true) = star (X R ι i) := by
  simp only [X, star_generator, Bool.not_false]

/-- The star structure on star polynomials is conjugate-linear. -/
instance : StarModule R (StarPolynomial R ι) where
  star_smul r a := by
    rw [Algebra.smul_def, star_mul, star_algebraMap, Algebra.smul_def]
    exact (Algebra.commutes (star r) (star a)).symm

/-! ### Evaluation -/

variable {A B : Type*} [Semiring A] [Algebra R A] [StarRing A]
  [Semiring B] [Algebra R B] [StarRing B]

/-- Two star algebra homomorphisms out of star polynomials agree once they agree on the
variables. -/
@[ext]
theorem hom_ext {f g : StarPolynomial R ι →⋆ₐ[R] A} (h : ∀ i, f (X R ι i) = g (X R ι i)) :
    f = g := by
  ext p
  induction p using StarPolynomial.induction with
  | algebraMap r => simp only [AlgHomClass.commutes]
  | generator x =>
    obtain ⟨i, _ | _⟩ := x
    · exact h i
    · simp only [generator_mk_true, map_star, h]
  | add a b ha hb => simp only [map_add, ha, hb]
  | mul a b ha hb => simp only [map_mul, ha, hb]

variable [StarModule R A] [StarModule R B]

private theorem liftAlgHom_star (a : ι → A) (p : StarPolynomial R ι) :
    liftAlgHom R a (star p) = star (liftAlgHom R a p) := by
  induction p using StarPolynomial.induction with
  | algebraMap r => rw [star_algebraMap, AlgHom.commutes, AlgHom.commutes, algebraMap_star_comm]
  | generator x => simp [liftAlgHom_generator, withStar_mk_not]
  | add a b ha hb => simp only [star_add, map_add, ha, hb]
  | mul a b ha hb => simp only [star_mul, map_mul, ha, hb]

variable (R) in
/-- The universal property of star polynomials: evaluation at a family `a` in a star algebra is
the unique star algebra homomorphism sending each variable `X i` to `a i`. -/
noncomputable def lift : (ι → A) ≃ (StarPolynomial R ι →⋆ₐ[R] A) where
  toFun a := { liftAlgHom R a with map_star' := liftAlgHom_star a }
  invFun f i := f (X R ι i)
  left_inv a := funext fun i => liftAlgHom_generator a (i, false)
  right_inv _ := hom_ext fun i => liftAlgHom_generator _ (i, false)

@[simp]
theorem lift_generator (a : ι → A) (x : ι × Bool) :
    lift R a (generator R ι x) = withStar a x :=
  liftAlgHom_generator a x

@[simp]
theorem lift_X (a : ι → A) (i : ι) : lift R a (X R ι i) = a i :=
  liftAlgHom_generator a (i, false)

@[simp]
theorem lift_symm_apply (f : StarPolynomial R ι →⋆ₐ[R] A) :
    (lift R).symm f = fun i => f (X R ι i) := (rfl)

/-- Evaluation of a star polynomial is free-algebra evaluation at the variables and their
adjoints. -/
theorem lift_apply (a : ι → A) (p : StarPolynomial R ι) :
    lift R a p = FreeAlgebra.lift R (withStar a) (toFreeAlgebra R ι p) := (rfl)

/-- Evaluating the variables themselves is the identity. -/
@[simp]
theorem lift_X_self : lift R (X R ι) = StarAlgHom.id R (StarPolynomial R ι) :=
  hom_ext fun i => by simp

/-- Evaluation commutes with star algebra homomorphisms. -/
theorem comp_lift (f : A →⋆ₐ[R] B) (a : ι → A) :
    f.comp (lift R a) = lift R (f ∘ a) :=
  hom_ext fun i => by simp

/-- Evaluating star polynomials at star polynomials is composition of evaluations. -/
theorem lift_comp_lift {κ : Type*} (a : ι → A) (p : κ → StarPolynomial R ι) :
    (lift R a).comp (lift R p) = lift R fun j => lift R a (p j) :=
  comp_lift (lift R a) p

/-- The variables generate star polynomials as a star algebra. -/
@[simp]
theorem adjoin_range_X : StarAlgebra.adjoin R (Set.range (X R ι)) = ⊤ := by
  rw [eq_top_iff]
  rintro p -
  induction p using StarPolynomial.induction with
  | algebraMap r => exact StarSubalgebra.algebraMap_mem _ r
  | generator x =>
    obtain ⟨i, _ | _⟩ := x
    · exact StarAlgebra.subset_adjoin R _ ⟨i, rfl⟩
    · rw [generator_mk_true]
      exact StarAlgebra.star_subset_adjoin R _ ⟨i, (star_star _).symm⟩
  | add a b ha hb => exact add_mem ha hb
  | mul a b ha hb => exact mul_mem ha hb

/-- The range of evaluation at `a` is the star subalgebra generated by `a`. -/
theorem range_lift (a : ι → A) :
    (lift R a).range = StarAlgebra.adjoin R (Set.range a) := by
  rw [StarAlgHom.range_eq_map_top, ← adjoin_range_X, StarAlgHom.map_adjoin, ← Set.range_comp]
  congr 2
  exact funext fun i => lift_X a i

end StarPolynomial

end TauCeti
