module

public import Mathlib.Algebra.Star.NonUnitalSubalgebra

/-!
# The star subalgebras `L ∩ star L` and `star a * A * a`, and a direct `SMul` instance

For a submodule `L` of a star algebra `A` that absorbs left multiplication by elements of `A`
(a left ideal), the elements `x` with `x ∈ L` and `star x ∈ L` form a star subalgebra
`Submodule.interStar L hL`: it is closed under multiplication since
`x * y ∈ L` by left absorption and `star (x * y) = star y * star x ∈ L`. In a C⋆-algebra this is
the hereditary C⋆-subalgebra attached to a closed left ideal.

For an element `a`, the elements `star a * x * a` form a star subalgebra
`NonUnitalStarSubalgebra.starMulMul a`, since
`(star a * x * a) * (star a * y * a) = star a * (x * a * star a * y) * a`. Its closure in a
C⋆-algebra is the hereditary C⋆-subalgebra generated by `a` when `a` is positive, and for a
projection `p` it is the corner `pAp`.

## Direct `SMul` instance

Mathlib defines `NonUnitalStarSubalgebra.instModule` at default priority while leaving the direct
`SMul R S` instance to `SetLike.smul` at priority `50`. Consequently, synthesizing `SMul R S`
directly (as `StarAlgEquiv` does) traverses the module and action hierarchy instead of resolving on
`NonUnitalStarSubalgebra` immediately, which can time out on operator algebras over submodules. We
register `NonUnitalStarSubalgebra.instSMul := SetLike.smul S` at default priority, definitionally
equal to `S.instModule.toSMul`.

## Main declarations

* `Submodule.interStar`: the star subalgebra `L ∩ star L` of a left ideal `L`.
* `Submodule.mem_interStar`, `Submodule.coe_interStar` and `Submodule.interStar_mono`: its
  membership criterion, underlying set and monotonicity in `L`.
* `NonUnitalStarSubalgebra.starMulMul`: the star subalgebra `star a * A * a`, with
  `NonUnitalStarSubalgebra.mem_starMulMul` and `NonUnitalStarSubalgebra.coe_starMulMul`.
* `NonUnitalStarSubalgebra.instSMul`: the direct `SMul R S` instance at default priority.
-/

public section

namespace Submodule

variable {R A : Type*} [CommSemiring R] [Star R] [NonUnitalNonAssocSemiring A] [StarRing A]
  [Module R A] [StarModule R A]

/-- For a left ideal `L`, the star subalgebra `L ∩ star L`. -/
def interStar (L : Submodule R A) (hL : ∀ (a : A) {x : A}, x ∈ L → a * x ∈ L) :
    NonUnitalStarSubalgebra R A where
  carrier := {x | x ∈ L ∧ star x ∈ L}
  add_mem' hx hy := ⟨L.add_mem hx.1 hy.1, by rw [star_add]; exact L.add_mem hx.2 hy.2⟩
  zero_mem' := ⟨L.zero_mem, by rw [star_zero]; exact L.zero_mem⟩
  mul_mem' {x _} _ hy := ⟨hL x hy.1, by rw [star_mul]; exact hL _ ‹x ∈ L ∧ star x ∈ L›.2⟩
  smul_mem' c _ hx := ⟨L.smul_mem c hx.1, by rw [star_smul]; exact L.smul_mem _ hx.2⟩
  star_mem' hx := ⟨hx.2, by rw [star_star]; exact hx.1⟩

variable {L : Submodule R A} {hL : ∀ (a : A) {x : A}, x ∈ L → a * x ∈ L}

/-- Membership in `L ∩ star L`. -/
@[simp]
theorem mem_interStar {x : A} : x ∈ L.interStar hL ↔ x ∈ L ∧ star x ∈ L :=
  Iff.rfl

/-- The underlying set of `L ∩ star L`. -/
@[simp]
theorem coe_interStar : (L.interStar hL : Set A) = (L : Set A) ∩ star ⁻¹' (L : Set A) :=
  (rfl)

/-- `L ↦ L ∩ star L` is monotone. -/
theorem interStar_mono {L' : Submodule R A} {hL' : ∀ (a : A) {x : A}, x ∈ L' → a * x ∈ L'}
    (h : L ≤ L') : L.interStar hL ≤ L'.interStar hL' :=
  fun _ hx ↦ ⟨h hx.1, h hx.2⟩

end Submodule

namespace NonUnitalStarSubalgebra

/-- Direct `R`-scalar action on the carrier of a `NonUnitalStarSubalgebra R A`, definitionally equal
to `S.instModule.toSMul`. -/
instance instSMul {R A : Type*} [CommSemiring R] [NonUnitalNonAssocSemiring A] [Module R A]
    [Star A] (S : NonUnitalStarSubalgebra R A) : SMul R S :=
  SetLike.smul S

variable {R A : Type*} [CommSemiring R] [NonUnitalSemiring A] [StarRing A] [Module R A]
  [IsScalarTower R A A] [SMulCommClass R A A]

/-- The star subalgebra `star a * A * a` of elements `star a * x * a`. -/
def starMulMul (a : A) : NonUnitalStarSubalgebra R A where
  carrier := Set.range fun x ↦ star a * x * a
  add_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x + y, by simp only [mul_add, add_mul]⟩
  zero_mem' := ⟨0, by simp⟩
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x * a * star a * y, by simp only [mul_assoc]⟩
  smul_mem' := by
    rintro c _ ⟨x, rfl⟩
    exact ⟨c • x, by simp only [mul_smul_comm, smul_mul_assoc]⟩
  star_mem' := by
    rintro _ ⟨x, rfl⟩
    exact ⟨star x, by simp [mul_assoc]⟩

variable {a x : A}

/-- Membership in `star a * A * a`. -/
@[simp]
theorem mem_starMulMul : x ∈ starMulMul (R := R) a ↔ ∃ y, star a * y * a = x :=
  Iff.rfl

/-- The underlying set of `star a * A * a`. -/
@[simp]
theorem coe_starMulMul (a : A) :
    (starMulMul (R := R) a : Set A) = Set.range fun x ↦ star a * x * a :=
  (rfl)

/-- `star a * A * a` contains every `star a * x * a`. -/
theorem star_mul_mul_mem_starMulMul (a x : A) : star a * x * a ∈ starMulMul (R := R) a :=
  ⟨x, rfl⟩

end NonUnitalStarSubalgebra
