/-!
# Finite generation of invariants of linearly reductive groups

Let `H` be a linearly reductive commutative bialgebra over a field `k`, for instance the coordinate
Hopf algebra of a linearly reductive affine group `G`, and let `A` be a finitely generated
commutative `k`-algebra with an `H`-comodule algebra structure, that is, an affine `k`-scheme
`Spec A` with an action of `G`. Then the algebra of invariants `A^{co H}` is a finitely generated
`k`-algebra. This is the theorem of Hilbert and Nagata. It makes the affine quotient
`Spec A^{co H}` a scheme of finite type. For the translation action of a linearly reductive
closed subgroup `N` on an affine group `G` of finite type, it makes the invariant functions
`O(G)^N`, the candidate coordinate ring of the homogeneous space `G/N`, a finitely generated
algebra.

The proof follows Hilbert, with exactness of invariants
(`TauCeti.Comodule.Hom.exists_fixed_preimage_of_isLinearlyReductive`) in place of the Reynolds
operator.

* Multiplication by an invariant element is a comodule endomorphism. Lifting invariants through
  finitely many such morphisms shows that an invariant element of the ideal generated by
  invariants `j₁, …, jᵣ` is a combination of them with invariant coefficients: every ideal `J` of
  `A^{co H}` satisfies `J A ∩ A^{co H} = J`.
* For a finite-dimensional comodule `V`, the homogeneous components of an invariant of the
  symmetric algebra `Sym V` are invariant. Hilbert's argument
  (`Subalgebra.fg_of_decompose_mem_of_comap_map_le`) then shows that `(Sym V)^{co H}` is
  finitely generated.
* In general, the generators of `A` lie in a finite-dimensional subcomodule `V`, so `Sym V` maps
  onto `A` equivariantly. By exactness of invariants this map is onto on invariants.

No smoothness, connectedness, reducedness or characteristic assumption is made: linear reductivity
is the only input. In characteristic zero, reductive groups are linearly reductive; in positive
characteristic they are in general only geometrically reductive, and finite generation then needs
the theorems of Nagata and Haboush instead.

## Main declarations

* `TauCeti.ComoduleAlgebra.mulLeftHom`: multiplication by an invariant element as a comodule
  endomorphism.
* `TauCeti.ComoduleAlgebra.comap_map_coinvariants`: over a linearly reductive bialgebra,
  every ideal of the invariants is the contraction of the ideal it generates.
* `TauCeti.ComoduleAlgebra.symmetricAlgebra`: the comodule algebra structure on the symmetric
  algebra of a comodule.
* `TauCeti.ComoduleAlgebra.fg_coinvariants_symmetricAlgebra`: **Hilbert's theorem**, the
  invariants of the symmetric algebra of a finite-dimensional comodule form a finitely generated
  algebra.
* `TauCeti.ComoduleAlgebra.finiteType_coinvariants`: **the invariants of a finitely generated
  comodule algebra form a finitely generated algebra.**

## References

* D. Hilbert, *Über die Theorie der algebraischen Formen*, Math. Ann. **36** (1890).
* M. Nagata, *Invariants of a group in an affine ring*, J. Math. Kyoto Univ. **3** (1964).
* S. Mukai, *An Introduction to Invariants and Moduli*, Cambridge University Press (2003), §4.3.
* J. S. Milne, *Algebraic Groups* (2017), §12.
-/

public section

open scoped TensorProduct

namespace TauCeti

namespace ComoduleAlgebra

universe u v w

section Semiring

variable {R : Type*} {H : Type*} {A : Type*} [CommSemiring R] [Semiring H] [Bialgebra R H]
  [Semiring A] [Algebra R A] [ComoduleAlgebra R H A]

/-- Left multiplication by an invariant element of a comodule algebra, as a comodule
endomorphism. -/
noncomputable def mulLeftHom (a : A) (ha : a ∈ coinvariants R H A) :
    Comodule.Hom R H A A where
  toLinearMap := LinearMap.mulLeft R a
  map_coact := by
    ext b
    rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.mulLeft_apply, coact_mul,
      mem_coinvariants.1 ha]
    induction Comodule.coact (R := R) (C := H) b using TensorProduct.inductionOn with
    | tmul c h => simp
    | add x y hx hy => rw [map_add, hx, hy, mul_add]

@[simp]
theorem mulLeftHom_apply (a : A) (ha : a ∈ coinvariants R H A) (b : A) :
    mulLeftHom a ha b = a * b :=
  (rfl)

end Semiring

section Field

variable {k : Type u} [Field k] {H : Type v} [Semiring H] [Bialgebra k H]
  {A : Type w} [CommRing A] [Algebra k A] [ComoduleAlgebra k H A]

/-- **Ideal contraction for invariants.** Over a linearly reductive bialgebra, an ideal `J` of the
invariants is recovered from the ideal of `A` it generates: `J A ∩ A^{co H} = J`. -/
theorem comap_map_coinvariants (hH : Coalgebra.IsLinearlyReductive.{u, v, u} k H)
    (J : Ideal (coinvariants k H A)) :
    (J.map (algebraMap (coinvariants k H A) A)).comap (algebraMap (coinvariants k H A) A) = J := by
  refine le_antisymm (fun x hx ↦ ?_) Ideal.le_comap_map
  rw [Ideal.mem_comap, ← Ideal.span_eq J, Ideal.map_span, ← Ideal.submodule_span_eq,
    Submodule.mem_span_set'] at hx
  obtain ⟨n, c, g, hcg⟩ := hx
  choose j hjJ hjg using fun i ↦ (g i).2
  have hx : (x : A) ∈ Comodule.fixedSubcomodule k H A := by
    rw [Comodule.mem_fixedSubcomodule, ← mem_coinvariants]
    exact x.2
  -- Lift `x = ∑ cᵢ jᵢ` to a combination with invariant coefficients.
  obtain ⟨q, hqfixed, hq⟩ := Comodule.Hom.exists_fixed_sum_eq_of_isLinearlyReductive hH
    Finset.univ (fun i ↦ mulLeftHom (j i : A) (j i).2) hx
    ⟨c, by simpa [← hjg, mul_comm] using hcg⟩
  have hq' (i : Fin n) : q i ∈ coinvariants k H A :=
    mem_coinvariants.2 (Comodule.mem_fixedSubcomodule.1 (hqfixed i (Finset.mem_univ i)))
  have hxsum : x = ∑ i, ⟨q i, hq' i⟩ * j i := by
    apply Subtype.ext
    simpa [mul_comm] using hq.symm
  rw [hxsum]
  exact J.sum_mem fun i _ ↦ J.mul_mem_left _ (hjJ i)

end Field

/-! ### The symmetric algebra -/

section SymmetricAlgebra

variable {R : Type*} {H : Type*} {M : Type*} [CommSemiring R] [CommSemiring H] [Bialgebra R H]
  [AddCommMonoid M] [Module R M] [Comodule R H M]

variable (R H M) in
/-- The symmetric algebra of a comodule over a commutative bialgebra is a comodule algebra, with
the multiplicative coaction `TauCeti.Comodule.symmetricAlgebraCoact`.

Like `TauCeti.Comodule.symmetricAlgebra`, this is not a global instance. -/
@[implicit_reducible]
noncomputable def symmetricAlgebra : ComoduleAlgebra R H (SymmetricAlgebra R M) where
  toComodule := Comodule.symmetricAlgebra R H M
  coact_one := by rw [Comodule.symmetricAlgebra_coact, AlgHom.toLinearMap_apply, map_one]
  coact_mul x y := by rw [Comodule.symmetricAlgebra_coact, AlgHom.toLinearMap_apply,
    AlgHom.toLinearMap_apply, AlgHom.toLinearMap_apply, map_mul]

attribute [local instance] symmetricAlgebra

/-- The homogeneous components of an invariant of the symmetric algebra of a comodule are
invariant. -/
theorem decompose_mem_coinvariants_symmetricAlgebra {x : SymmetricAlgebra R M}
    (hx : x ∈ coinvariants R H (SymmetricAlgebra R M)) (n : ℕ) :
    (DirectSum.decompose (SymmetricAlgebra.homogeneousSubmodule R M) x n : SymmetricAlgebra R M) ∈
      coinvariants R H (SymmetricAlgebra R M) := by
  rw [← SetLike.mem_coe, coe_coinvariants] at hx ⊢
  exact Comodule.decompose_mem_fixedSubcomodule _
    (fun _ _ hy ↦ by
      rw [Comodule.symmetricAlgebra_coact, AlgHom.toLinearMap_apply]
      exact Comodule.symmetricAlgebraCoact_mem_decomposeTensor hy) hx n

end SymmetricAlgebra

/-! ### Hilbert's finiteness theorem -/

section Hilbert

variable {k : Type u} [Field k] {H : Type v} [CommSemiring H] [Bialgebra k H]

attribute [local instance] symmetricAlgebra

/-- **Hilbert's finiteness theorem.** For a finite-dimensional comodule `V` over a linearly
reductive commutative bialgebra, the invariants of the symmetric algebra `Sym V` form a finitely
generated algebra. -/
theorem fg_coinvariants_symmetricAlgebra (hH : Coalgebra.IsLinearlyReductive.{u, v, u} k H)
    (V : Type*)
    [AddCommMonoid V] [Module k V] [Comodule k H V] [Module.Finite k V] :
    (coinvariants k H (SymmetricAlgebra k V)).FG := by
  refine Subalgebra.fg_of_decompose_mem_of_comap_map_le (SymmetricAlgebra.homogeneousSubmodule k V)
    (fun x hx ↦ ?_) _ (fun x hx n ↦ decompose_mem_coinvariants_symmetricAlgebra hx n)
    fun J ↦ (comap_map_coinvariants hH J).le
  rw [Algebra.mem_bot]
  exact ⟨_, SymmetricAlgebra.algebraMap_homogeneousSubmoduleZeroEquiv_apply k V ⟨x, hx⟩⟩

end Hilbert

/-! ### Finitely generated comodule algebras -/

section FiniteType

variable {k : Type u} [Field k] {H : Type v} [CommSemiring H] [Bialgebra k H]
  {A : Type w} [CommRing A] [Algebra k A] [ComoduleAlgebra k H A]

attribute [local instance] symmetricAlgebra

/-- The algebra homomorphism from the symmetric algebra of a subcomodule of a comodule algebra,
extending the inclusion, is a comodule morphism. -/
private noncomputable def liftSubcomoduleHom [Module.Flat k H] (V : Subcomodule k H A) :
    Comodule.Hom k H (SymmetricAlgebra k V) A where
  toLinearMap := (SymmetricAlgebra.lift (SMulMemClass.subtype V)).toLinearMap
  map_coact := by
    have h : (Algebra.TensorProduct.map (SymmetricAlgebra.lift (SMulMemClass.subtype V))
        (AlgHom.id k H)).comp (Comodule.symmetricAlgebraCoact k H V) =
        (coactAlgHom k H A).comp (SymmetricAlgebra.lift (SMulMemClass.subtype V)) := by
      apply SymmetricAlgebra.algHom_ext
      ext v
      simp only [← AlgHom.toLinearMap_eq_coe, LinearMap.comp_apply, AlgHom.toLinearMap_apply,
        AlgHom.comp_apply, Comodule.symmetricAlgebraCoact_ι, SymmetricAlgebra.lift_ι_apply,
        coactAlgHom_apply]
      rw [SMulMemClass.coe_subtype, ← Subcomodule.subtype_rTensor_coact V v]
      induction Comodule.coact (R := k) (C := H) v using TensorProduct.inductionOn with
      | tmul w h => simp
      | add x y hx hy => simp only [map_add, hx, hy]
    simpa [TensorProduct.AlgebraTensorModule.map_eq] using congrArg AlgHom.toLinearMap h

/-- **Finite generation of invariants.** The invariants of a finitely generated commutative
comodule algebra over a linearly reductive commutative bialgebra form a finitely generated
algebra. Geometrically, the invariant functions on an affine scheme of finite type acted on by a
linearly reductive group form a finitely generated algebra. -/
theorem finiteType_coinvariants (hH : Coalgebra.IsLinearlyReductive.{u, v, u} k H)
    [Algebra.FiniteType k A] : Algebra.FiniteType k (coinvariants k H A) := by
  let : AddCommGroup H := Module.addCommMonoidToAddCommGroup k
  -- The generators of `A` lie in a finite-dimensional subcomodule `V`.
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := k) (A := A)
  obtain ⟨V, hVfin, hsV⟩ := Subcomodule.exists_finite_subcomodule_of_setFinite_of_exists_mem
    (fun a ↦ Subcomodule.exists_finite_subcomodule_mem (R := k) (C := H) a) s.finite_toSet
  have : Module.Finite k V := hVfin
  -- `Sym V` maps onto `A`, equivariantly.
  let φ := liftSubcomoduleHom V
  have hφ (v : V) : φ (SymmetricAlgebra.ι k V v) = v := SymmetricAlgebra.lift_ι_apply _ _
  have hrange : (SymmetricAlgebra.lift (SMulMemClass.subtype V)).range = ⊤ := by
    rw [eq_top_iff, ← hs, Algebra.adjoin_le_iff]
    intro a ha
    exact ⟨SymmetricAlgebra.ι k V ⟨a, hsV ha⟩, hφ ⟨a, hsV ha⟩⟩
  -- By exactness of invariants, the invariants of `A` are the image of those of `Sym V`.
  have himage : (coinvariants k H (SymmetricAlgebra k V)).map
      (SymmetricAlgebra.lift (SMulMemClass.subtype V)) = coinvariants k H A := by
    apply le_antisymm
    · rintro _ ⟨y, hy, rfl⟩
      exact mem_coinvariants.2 (Comodule.mem_fixedSubcomodule.1
        (φ.mem_fixedSubcomodule (Comodule.mem_fixedSubcomodule.2 (mem_coinvariants.1 hy))))
    · intro a ha
      obtain ⟨y, hy⟩ := (AlgHom.mem_range _).1 (hrange ▸ Algebra.mem_top : a ∈ _)
      obtain ⟨z, hz, hza⟩ := φ.exists_fixed_preimage_of_isLinearlyReductive hH
        (Comodule.mem_fixedSubcomodule.2 (mem_coinvariants.1 ha)) ⟨y, hy⟩
      exact ⟨z, mem_coinvariants.2 (Comodule.mem_fixedSubcomodule.1 hz), hza⟩
  rw [← Subalgebra.fg_iff_finiteType, ← himage]
  exact (fg_coinvariants_symmetricAlgebra hH V).map _

end FiniteType

end ComoduleAlgebra

