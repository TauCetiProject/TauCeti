/-!
# Symmetric algebras of comodules as comodule algebras

This file equips the symmetric algebra of a comodule with its natural comodule-algebra structure.
It also records that homogeneous components of coinvariants remain coinvariant and constructs the
equivariant algebra map induced by the inclusion of a subcomodule into a comodule algebra.

The ideal `Subalgebra.symmetricAlgebraHilbertIdeal` of the coinvariants, generated by the invariant
functions vanishing at the origin, is the ideal of the zero fibre of the quotient map
`Spec (Sym M) → Spec (Sym M)^{co H}`. It is stable under the coaction, so the zero fibre is stable
under the action. A comodule isomorphism `M ≅ N` carries it onto the corresponding ideal for `N`,
and for the trivial coaction it is the augmentation ideal: the zero fibre is the origin.

## Main declarations

* `TauCeti.ComoduleAlgebra.symmetricAlgebra`: the comodule-algebra structure on the symmetric
  algebra of a comodule.
* `TauCeti.ComoduleAlgebra.decompose_mem_coinvariants_symmetricAlgebra`: homogeneous components
  of a coinvariant in a symmetric algebra are coinvariant.
* `TauCeti.ComoduleAlgebra.liftSubcomoduleHom`: the equivariant algebra map from the symmetric
  algebra of a subcomodule into a comodule algebra.
* `TauCeti.ComoduleAlgebra.coact_mem_map_includeLeft_symmetricAlgebraHilbertIdeal`: the ideal
  generated by the coinvariants vanishing at the origin is stable under the coaction.
* `TauCeti.ComoduleAlgebra.symmetricAlgebraHilbertIdeal_coinvariants_eq_ker_algebraMapInv`: for a
  trivial coaction it is the augmentation ideal.
* `TauCeti.Comodule.Hom.map_symmetricAlgebraHilbertIdeal_le` and
  `TauCeti.Comodule.Hom.map_symmetricAlgebraHilbertIdeal`: a comodule morphism maps it into the
  corresponding ideal, and a comodule morphism with a comodule section, in particular a comodule
  isomorphism, maps it onto that ideal.
-/

public section

open scoped TensorProduct

namespace TauCeti

namespace ComoduleAlgebra

universe u v w

section SymmetricAlgebra

variable {R : Type*} {H : Type*} {M : Type*} [CommSemiring R] [CommSemiring H] [Bialgebra R H]
  [AddCommMonoid M] [Module R M] [Comodule R H M]

variable (R H M) in
/-- The symmetric algebra of a comodule over a commutative bialgebra is a comodule algebra, with
the multiplicative coaction `TauCeti.Comodule.symmetricAlgebraCoact`.

Like `TauCeti.Comodule.symmetricAlgebra`, this is not a global instance. -/
@[implicit_reducible]
noncomputable def symmetricAlgebra : ComoduleAlgebra R H (SymmetricAlgebra R M) where
  toComodule := Comodule.symmetricAlgebra R H M
  coact_one := by rw [Comodule.symmetricAlgebra_coact, AlgHom.toLinearMap_apply, map_one]
  coact_mul x y := by rw [Comodule.symmetricAlgebra_coact, AlgHom.toLinearMap_apply,
    AlgHom.toLinearMap_apply, AlgHom.toLinearMap_apply, map_mul]

attribute [local instance] symmetricAlgebra

/-- The coaction of the symmetric-algebra comodule algebra is
`TauCeti.Comodule.symmetricAlgebraCoact`. Unlike `TauCeti.Comodule.symmetricAlgebra_coact`, it
rewrites with the comodule structure underlying this comodule algebra. -/
theorem symmetricAlgebra_coact :
    Comodule.coact (R := R) (C := H) (M := SymmetricAlgebra R M) =
      (Comodule.symmetricAlgebraCoact R H M).toLinearMap :=
  Comodule.symmetricAlgebra_coact

/-- The homogeneous components of an invariant of the symmetric algebra of a comodule are
invariant. -/
theorem decompose_mem_coinvariants_symmetricAlgebra {x : SymmetricAlgebra R M}
    (hx : x ∈ coinvariants R H (SymmetricAlgebra R M)) (n : ℕ) :
    (DirectSum.decompose (SymmetricAlgebra.homogeneousSubmodule R M) x n : SymmetricAlgebra R M) ∈
      coinvariants R H (SymmetricAlgebra R M) := by
  rw [← SetLike.mem_coe, coe_coinvariants] at hx ⊢
  exact Comodule.decompose_mem_fixedSubcomodule _
    (fun _ _ hy ↦ by
      rw [Comodule.symmetricAlgebra_coact, AlgHom.toLinearMap_apply]
      exact Comodule.symmetricAlgebraCoact_mem_decomposeTensor hy) hx n

end SymmetricAlgebra

section HilbertIdeal

variable {R : Type*} {H : Type*} {M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]

/-- **The zero fibre of the quotient map is stable under the action.** For any comodule-algebra
structure on a symmetric algebra, the coaction carries the ideal generated by the coinvariants
vanishing at the origin into the ideal it generates in `Sym M ⊗[R] H`. -/
theorem coact_mem_map_includeLeft_symmetricAlgebraHilbertIdeal [Semiring H] [Bialgebra R H]
    [ComoduleAlgebra R H (SymmetricAlgebra R M)] {p : SymmetricAlgebra R M}
    (hp : p ∈ (coinvariants R H (SymmetricAlgebra R M)).symmetricAlgebraHilbertIdeal) :
    Comodule.coact (R := R) (C := H) p ∈
      (coinvariants R H (SymmetricAlgebra R M)).symmetricAlgebraHilbertIdeal.map
        (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := SymmetricAlgebra R M)
          (B := H)) := by
  rw [Subalgebra.symmetricAlgebraHilbertIdeal_def] at hp ⊢
  exact coact_mem_map_includeLeft_span (fun _ ↦ And.left) hp

variable [CommSemiring H] [Bialgebra R H] [Comodule R H M]

attribute [local instance] symmetricAlgebra

/-- **The zero fibre for a trivial coaction is the origin.** If `H` coacts trivially on `M`, then
every element of `Sym M` is coinvariant, and the ideal generated by the coinvariants vanishing at
the origin is the augmentation ideal. -/
theorem symmetricAlgebraHilbertIdeal_coinvariants_eq_ker_algebraMapInv
    (h : ∀ m : M, Comodule.coact (R := R) (C := H) m = m ⊗ₜ[R] 1) :
    (coinvariants R H (SymmetricAlgebra R M)).symmetricAlgebraHilbertIdeal =
      RingHom.ker (SymmetricAlgebra.algebraMapInv : SymmetricAlgebra R M →ₐ[R] R) := by
  -- The coaction is an algebra map agreeing with `p ↦ p ⊗ 1` on the generators.
  have hc : coactAlgHom R H (SymmetricAlgebra R M) = Algebra.TensorProduct.includeLeft := by
    apply SymmetricAlgebra.algHom_ext
    ext m
    simp [h m]
  have htop : coinvariants R H (SymmetricAlgebra R M) = ⊤ :=
    eq_top_iff.2 fun p _ ↦ mem_coinvariants.2 <| by
      simpa using AlgHom.congr_fun hc p
  rw [htop, Subalgebra.symmetricAlgebraHilbertIdeal_top]

end HilbertIdeal

section Lift

variable {R : Type u} [CommSemiring R] {H : Type v} [CommSemiring H] [Bialgebra R H]
  {A : Type w} [CommSemiring A] [Algebra R A] [ComoduleAlgebra R H A]

attribute [local instance] symmetricAlgebra

/-- The algebra homomorphism from the symmetric algebra of a subcomodule of a comodule algebra,
extending the inclusion, is a comodule morphism. -/
noncomputable def liftSubcomoduleHom [Module.Flat R H] (V : Subcomodule R H A) :
    Comodule.Hom R H (SymmetricAlgebra R V) A where
  toLinearMap := (SymmetricAlgebra.lift (SMulMemClass.subtype V)).toLinearMap
  map_coact := by
    have h : (Algebra.TensorProduct.map (SymmetricAlgebra.lift (SMulMemClass.subtype V))
        (AlgHom.id R H)).comp (Comodule.symmetricAlgebraCoact R H V) =
        (coactAlgHom R H A).comp (SymmetricAlgebra.lift (SMulMemClass.subtype V)) := by
      apply SymmetricAlgebra.algHom_ext
      ext v
      simp only [← AlgHom.toLinearMap_eq_coe, LinearMap.comp_apply, AlgHom.toLinearMap_apply,
        AlgHom.comp_apply, Comodule.symmetricAlgebraCoact_ι, SymmetricAlgebra.lift_ι_apply,
        coactAlgHom_apply]
      rw [SMulMemClass.coe_subtype, ← Subcomodule.subtype_rTensor_coact V v]
      induction Comodule.coact (R := R) (C := H) v using TensorProduct.inductionOn with
      | tmul w h => simp
      | add x y hx hy => simp only [map_add, hx, hy]
    simpa [TensorProduct.AlgebraTensorModule.map_eq] using congrArg AlgHom.toLinearMap h

/-- The underlying map of the equivariant lift is the symmetric-algebra lift. -/
@[simp]
theorem liftSubcomoduleHom_apply [Module.Flat R H] (V : Subcomodule R H A)
    (x : SymmetricAlgebra R V) :
    liftSubcomoduleHom V x = SymmetricAlgebra.lift (SMulMemClass.subtype V) x :=
  (rfl)

end Lift

end ComoduleAlgebra

namespace Comodule.Hom

variable {R : Type*} {H : Type*} {M : Type*} {N : Type*} [CommSemiring R] [CommSemiring H]
  [Bialgebra R H] [AddCommMonoid M] [Module R M] [Comodule R H M] [AddCommMonoid N] [Module R N]
  [Comodule R H N]

open ComoduleAlgebra

attribute [local instance] ComoduleAlgebra.symmetricAlgebra

/-- A comodule morphism `f : M → N` maps the ideal of `Sym M` generated by the coinvariants
vanishing at the origin into the corresponding ideal of `Sym N`: the induced map of symmetric
algebras `TauCeti.Comodule.Hom.symmetricAlgebraMap f` preserves coinvariants and the
augmentation. -/
theorem map_symmetricAlgebraHilbertIdeal_le (f : Hom R H M N) :
    (coinvariants R H (SymmetricAlgebra R M)).symmetricAlgebraHilbertIdeal.map
        (SymmetricAlgebra.map R f.toLinearMap) ≤
      (coinvariants R H (SymmetricAlgebra R N)).symmetricAlgebraHilbertIdeal := by
  rw [Subalgebra.map_symmetricAlgebraHilbertIdeal]
  refine Subalgebra.symmetricAlgebraHilbertIdeal_mono (Subalgebra.map_le.2 fun p hp ↦ ?_)
  rw [Subalgebra.mem_comap, ← SetLike.mem_coe, coe_coinvariants]
  rw [← SetLike.mem_coe, coe_coinvariants] at hp
  rw [SetLike.mem_coe, ← symmetricAlgebraMap_apply]
  exact (symmetricAlgebraMap f).mem_fixedSubcomodule hp

/-- **A comodule isomorphism identifies the zero fibres.** If the comodule morphism `f : M → N`
has a section `g` that is again a comodule morphism, in particular if `f` is a comodule
isomorphism, then `f` maps the ideal of `Sym M` generated by the coinvariants vanishing at the
origin onto the corresponding ideal of `Sym N`. -/
theorem map_symmetricAlgebraHilbertIdeal (f : Hom R H M N) (g : Hom R H N M)
    (hfg : Function.LeftInverse f g) :
    (coinvariants R H (SymmetricAlgebra R M)).symmetricAlgebraHilbertIdeal.map
        (SymmetricAlgebra.map R f.toLinearMap) =
      (coinvariants R H (SymmetricAlgebra R N)).symmetricAlgebraHilbertIdeal := by
  refine le_antisymm f.map_symmetricAlgebraHilbertIdeal_le fun q hq ↦ ?_
  rw [← SymmetricAlgebra.map_leftInverse R (f := g.toLinearMap) (g := f.toLinearMap) hfg q]
  exact Ideal.mem_map_of_mem _ (g.map_symmetricAlgebraHilbertIdeal_le (Ideal.mem_map_of_mem _ hq))

end Comodule.Hom

end TauCeti
