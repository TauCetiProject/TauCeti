module

public import TauCeti.Algebra.Bialgebra.ComoduleAlgebra
public import TauCeti.Algebra.Coalgebra.Comodule.SymmetricAlgebra.Basic
public import TauCeti.Algebra.Coalgebra.Subcomodule.Induced
