/-!
# Fixed-point ideals of comodule algebras over monoid algebras

Let `M` be a monoid and let `A` be a commutative `R`-algebra with a right `R[M]`-comodule structure.
The coaction decomposes `A` into weight submodules. This file defines the **fixed-point ideal**: the
ideal generated by the weight submodules of nontrivial weight. An algebra map out of `A` kills it
exactly when the coaction, pushed forward along that map, is trivial
(`TauCeti.Comodule.fixedPointIdeal_le_ker_iff`).

Geometrically, when `M` is commutative and the coaction is a comodule algebra structure, this is an
action of the diagonalizable monoid scheme `D(M) = Spec R[M]` on `X = Spec A`. The fixed-point
ideal then cuts out the closed subscheme `X^{D(M)}` of fixed points, and an algebra-valued point
of `X` lies in it exactly when the action of the universal point of `D(M)` fixes it.

This is not the subalgebra of coinvariants `TauCeti.ComoduleAlgebra.coinvariants`: in the
geometric setting, the coinvariants are the invariant functions on `X`, the coordinate ring of the
quotient, while the fixed-point ideal defines a closed subscheme.

The main result is that **the quotient of a formally smooth comodule algebra over `R[M]` by its
fixed-point ideal is formally smooth**
(`TauCeti.ComoduleAlgebra.formallySmooth_quotient_fixedPointIdeal`). The proof is the
infinitesimal lifting criterion. An algebra map `A → C ⧸ J` killing the fixed-point ideal, for a
square-zero ideal `J`, lifts to some algebra map `φ : A → C`, which need not kill it. Its weight-`1`
component `a ↦ φ(a₁)` is again an algebra map. Indeed, pushing the coaction forward along `φ` gives
an algebra map `A → C[M]` (the orbit map of `φ`) whose coefficient at `m` is `a ↦ φ(aₘ)`. The
coefficients away from `1` lie in `J`, because the original map killed the fixed-point ideal, so
the coefficient at `1` is multiplicative. The weight-`1` component kills the nontrivial weight
submodules and still lifts the given map.

No hypothesis on `M` beyond being a monoid, and no Noetherian or finiteness hypothesis on `R` or
`A`, is needed for this algebraic statement; it is a statement about fixed-point subschemes when
`M` is commutative. The main application is to centralizers of diagonalizable subgroups of smooth
affine groups, which are the fixed points of the conjugation action.

## Main definitions

* `TauCeti.Comodule.fixedPointIdeal`: the ideal generated by the weight submodules of nontrivial
  weight.

## Main results

* `TauCeti.Comodule.weightSpace_subset_fixedPointIdeal`: a nontrivial weight submodule lies in the
  fixed-point ideal.
* `TauCeti.Comodule.sub_weightProj_one_mem_fixedPointIdeal`: modulo the fixed-point ideal, every
  function agrees with its weight-`1` component.
* `TauCeti.Comodule.fixedPointIdeal_le_ker_iff`: an algebra map kills the fixed-point ideal
  exactly when it is a fixed point of the coaction.
* `TauCeti.ComoduleAlgebra.formallySmooth_quotient_fixedPointIdeal`: **the fixed-point quotient
  of a formally smooth comodule algebra over `R[M]` is formally smooth**; for commutative `M`,
  this is the fixed-point subscheme of a diagonalizable action.

## References

* J. S. Milne, *Algebraic Groups* (2017), Theorem 13.1.
* B. Conrad, O. Gabber, G. Prasad, *Pseudo-reductive Groups*, Proposition A.8.10(2).
-/

public section

open scoped TensorProduct

namespace TauCeti

universe u v w x

variable {R : Type u} {M : Type v} {A : Type w}

namespace Comodule

section FixedPointIdeal

variable [CommRing R] [Monoid M] [CommRing A] [Algebra R A]
variable [Comodule R (MonoidAlgebra R M) A]

variable (R M A) in
/-- The **fixed-point ideal** of a commutative algebra `A` with a comodule structure over `R[M]`:
the ideal generated by the weight submodules of nontrivial weight. When `M` is commutative and the
comodule structure is a comodule algebra structure, it cuts out the closed subscheme of fixed
points of the action of `D(M)` on `Spec A`. -/
noncomputable def fixedPointIdeal : Ideal A :=
  Ideal.span (⋃ m ∈ ({1}ᶜ : Set M), (weightSpace R M A m : Set A))

/-- A weight submodule of nontrivial weight lies in the fixed-point ideal. -/
theorem weightSpace_subset_fixedPointIdeal {m : M} (hm : m ≠ 1) :
    (weightSpace R M A m : Set A) ⊆ fixedPointIdeal R M A :=
  (Set.subset_biUnion_of_mem (u := fun m ↦ (weightSpace R M A m : Set A))
    (Set.mem_compl_singleton_iff.mpr hm)).trans Ideal.subset_span

/-- A weight component of nontrivial weight lies in the fixed-point ideal. -/
theorem weightProj_mem_fixedPointIdeal {m : M} (hm : m ≠ 1) (a : A) :
    weightProj R M A m a ∈ fixedPointIdeal R M A :=
  weightSpace_subset_fixedPointIdeal hm (weightProj_mem_weightSpace m a)

/-- Modulo the fixed-point ideal, a function agrees with its weight-`1` component. -/
theorem sub_weightProj_one_mem_fixedPointIdeal (a : A) :
    a - weightProj R M A 1 a ∈ fixedPointIdeal R M A := by
  classical
  rw [← Ideal.Quotient.eq]
  conv_lhs => rw [← weightDecomposition_sum (R := R) (G := M) a]
  rw [map_finsuppSum, Finsupp.sum_eq_single 1]
  · rw [weightDecomposition_apply]
  · intro m _ hm
    rw [weightDecomposition_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact weightProj_mem_fixedPointIdeal hm a
  · simp

/-- **An algebra map kills the fixed-point ideal exactly when it is a fixed point of the
coaction**: pushing the coaction forward along it gives the trivial coaction `a ↦ f a ⊗ 1`. -/
theorem fixedPointIdeal_le_ker_iff {B : Type x} [CommRing B] [Algebra R B] (f : A →ₐ[R] B) :
    fixedPointIdeal R M A ≤ RingHom.ker f ↔
      ∀ a, Algebra.TensorProduct.map f (AlgHom.id R (MonoidAlgebra R M))
        (coact (R := R) (C := MonoidAlgebra R M) a) = f a ⊗ₜ[R] 1 := by
  classical
  -- Both sides of the fixed-point equation are read off coefficientwise.
  have hcoeff (a : A) (m : M) :
      LinearMap.tensorComponent (Comodule.monoidCoeff R M m)
          (Algebra.TensorProduct.map f (AlgHom.id R (MonoidAlgebra R M))
            (coact (R := R) (C := MonoidAlgebra R M) a)) =
        f (weightProj R M A m a) := by
    rw [Algebra.TensorProduct.map_apply_eq_map, AlgHom.toLinearMap_id,
      LinearMap.tensorComponent_map, LinearMap.comp_id, weightProj_apply, AlgHom.toLinearMap_apply]
  constructor
  · intro h a
    apply (tensorCoeffEquiv R M B).injective
    ext m
    rw [tensorCoeffEquiv_apply, tensorCoeffEquiv_apply, hcoeff, LinearMap.tensorComponent_tmul,
      MonoidAlgebra.one_def, monoidCoeff_apply, MonoidAlgebra.coeff_single]
    by_cases hm : m = 1
    · subst hm
      have hsub := h (sub_weightProj_one_mem_fixedPointIdeal a)
      rw [RingHom.mem_ker, map_sub, sub_eq_zero] at hsub
      simp [hsub]
    · rw [Finsupp.single_eq_of_ne hm, zero_smul]
      exact h (weightProj_mem_fixedPointIdeal hm a)
  · intro h
    refine Ideal.span_le.mpr fun a ha ↦ ?_
    simp only [Set.mem_iUnion, Set.mem_compl_iff, Set.mem_singleton_iff, SetLike.mem_coe] at ha
    obtain ⟨m, hm, ha⟩ := ha
    have hc := hcoeff a m
    rw [h a, LinearMap.tensorComponent_tmul, MonoidAlgebra.one_def, monoidCoeff_apply,
      MonoidAlgebra.coeff_single, Finsupp.single_eq_of_ne hm, zero_smul,
      weightProj_of_mem ha] at hc
    exact hc.symm

end FixedPointIdeal

end Comodule

namespace ComoduleAlgebra

open Comodule

variable [CommRing R] [Monoid M] [CommRing A] [Algebra R A]
variable [ComoduleAlgebra R (MonoidAlgebra R M) A]

section Lift

variable {C : Type x} [CommRing C] [Algebra R C]

/-- The orbit map `t ↦ φ · t` of a point `φ`, as an algebra map `A → C[M]`. -/
private noncomputable def orbitMap (φ : A →ₐ[R] C) : A →ₐ[R] MonoidAlgebra C M :=
  ((MonoidAlgebra.tensorAlgEquiv R C M).toAlgHom.comp
    (Algebra.TensorProduct.comm R C (MonoidAlgebra R M)).toAlgHom).comp
    ((Algebra.TensorProduct.map φ (AlgHom.id R (MonoidAlgebra R M))).comp
      (coactAlgHom R (MonoidAlgebra R M) A))

/-- The coefficients of the orbit map of a point `φ` are the values of `φ` on the weight
components. -/
private theorem coeff_orbitMap (φ : A →ₐ[R] C) (a : A) (m : M) :
    (orbitMap φ a).coeff m = φ (weightProj R M A m a) := by
  simp only [orbitMap, AlgHom.comp_apply, coactAlgHom_apply, weightProj_apply]
  induction coact (R := R) (C := MonoidAlgebra R M) a using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, MonoidAlgebra.coeff_add, Finsupp.add_apply, hs, ht]
  | tmul b p =>
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgEquiv.coe_toAlgHom,
      AlgEquiv.coe_toAlgHom, Algebra.TensorProduct.comm_tmul, MonoidAlgebra.tensorAlgEquiv_tmul,
      MonoidAlgebra.coeff_smul, Finsupp.smul_apply, MonoidAlgebra.coeff_mapAlgHom,
      LinearMap.tensorComponent_tmul, monoidCoeff_apply, map_smul, Algebra.ofId_apply,
      smul_eq_mul, Algebra.smul_def, mul_comm]

/-- The weight-`1` component `a ↦ φ(a₁)` of a point `φ` whose values on the nontrivial weight
components lie in a square-zero ideal, as an algebra map. It is the coefficient at `1` of the
orbit map, which is multiplicative because the other coefficients lie in the ideal. -/
private noncomputable def weightOneAlgHom {J : Ideal C} (hJ : J ^ 2 = ⊥) (φ : A →ₐ[R] C)
    (hφ : ∀ m ≠ 1, ∀ a, φ (weightProj R M A m a) ∈ J) : A →ₐ[R] C :=
  AlgHom.ofLinearMap (φ.toLinearMap ∘ₗ weightProj R M A 1)
    (by
      have h1 : (1 : A) ∈ weightSpace R M A 1 := by
        rw [mem_weightSpace, ← MonoidAlgebra.one_def, ← coactAlgHom_apply, map_one,
          Algebra.TensorProduct.one_def]
      simp [weightProj_of_mem h1])
    (fun a b ↦ by
      have h := congrArg (fun p : MonoidAlgebra C M ↦ p.coeff 1) (map_mul (orbitMap φ) a b)
      simp only [coeff_orbitMap] at h
      rw [MonoidAlgebra.coeff_one_mul_of_coeff_mem hJ, coeff_orbitMap, coeff_orbitMap] at h
      · simpa using h
      · intro m hm
        rw [coeff_orbitMap]
        exact hφ m hm a
      · intro m hm
        rw [coeff_orbitMap]
        exact hφ m hm b)

private theorem weightOneAlgHom_apply {J : Ideal C} (hJ : J ^ 2 = ⊥) (φ : A →ₐ[R] C)
    (hφ : ∀ m ≠ 1, ∀ a, φ (weightProj R M A m a) ∈ J) (a : A) :
    weightOneAlgHom hJ φ hφ a = φ (weightProj R M A 1 a) :=
  rfl

end Lift

/-- **The quotient of a formally smooth comodule algebra over `R[M]` by its fixed-point ideal is
formally smooth.** For commutative `M`, this says that the fixed points of a diagonalizable action
on a formally smooth affine scheme form a formally smooth closed subscheme. No hypothesis on the
monoid `M` or on the base ring is needed. -/
instance formallySmooth_quotient_fixedPointIdeal [Algebra.FormallySmooth R A] :
    Algebra.FormallySmooth R (A ⧸ fixedPointIdeal R M A) := by
  refine Algebra.FormallySmooth.iff_comp_surjective.mpr fun C _ _ J hJ f ↦ ?_
  -- Lift the point of the fixed locus over `C ⧸ J` to an arbitrary point `φ` over `C`.
  obtain ⟨φ, hφ⟩ := Algebra.FormallySmooth.comp_surjective R A J hJ
    (f.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal R M A)))
  have hφJ (m : M) (hm : m ≠ 1) (a : A) : φ (weightProj R M A m a) ∈ J := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.mkₐ_eq_mk R, ← AlgHom.comp_apply, hφ,
      AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.mpr (weightProj_mem_fixedPointIdeal (R := R) hm a), map_zero]
  -- Its weight-`1` component is a point of the fixed locus lifting the same point.
  let g := weightOneAlgHom hJ φ hφJ
  have hg : fixedPointIdeal R M A ≤ RingHom.ker g := by
    refine Ideal.span_le.mpr fun a ha ↦ ?_
    simp only [Set.mem_iUnion, Set.mem_compl_iff, Set.mem_singleton_iff, SetLike.mem_coe] at ha
    obtain ⟨m, hm, ha⟩ := ha
    rw [SetLike.mem_coe, RingHom.mem_ker, weightOneAlgHom_apply,
      weightProj_of_mem_of_ne (Ne.symm hm) ha, map_zero]
  refine ⟨Ideal.Quotient.liftₐ _ g fun a ha ↦ RingHom.mem_ker.mp (hg ha),
    Ideal.Quotient.algHom_ext R ?_⟩
  rw [AlgHom.comp_assoc, Ideal.Quotient.liftₐ_comp]
  ext a
  have hsub := sub_weightProj_one_mem_fixedPointIdeal (R := R) (M := M) a
  rw [← Ideal.Quotient.eq, ← Ideal.Quotient.mkₐ_eq_mk R] at hsub
  rw [AlgHom.comp_apply, weightOneAlgHom_apply, ← AlgHom.comp_apply, hφ, AlgHom.comp_apply,
    AlgHom.comp_apply, ← hsub]

end ComoduleAlgebra

end TauCeti
