module

public import Mathlib.Order.DirectedInverseSystem
public import Mathlib.RingTheory.Bialgebra.Hom
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Basic facts about bialgebra morphisms

`BialgHom.toCoalgHom_eq_ofClass` identifies the structure projection to a coalgebra morphism
with the coercion `CoalgHom.ofClass`.

`BialgHom.id_toRingHom` and `BialgHom.comp_toRingHom` identify the direct ring-homomorphism
coercions of the identity and composition. They complement Mathlib's `BialgHom.id_toAlgHom`
and `BialgHom.comp_toAlgHom`, which concern the algebra-homomorphism coercions.

The ordinary kernel of a bialgebra morphism is killed by the counit, and its comultiplication
lies in the kernel of the tensor-square map. These facts require only the algebra and coalgebra
structures used to define a bialgebra morphism, without an antipode.
`BialgHom.mem_ker_toAlgHom_toRingHom` reads membership in the kernel of the underlying ring
homomorphism as vanishing under the bialgebra morphism.

`Bialgebra.unitBialgHom_apply` evaluates Mathlib's unit bialgebra morphism as the structure map.

A sequence of bialgebra morphisms `g n : A n →ₐc[R] A (n + 1)` determines, for `i ≤ j`, the
composite `BialgHom.natLERec g i j : A i →ₐc[R] A j`. These composites form a directed system over
`ℕ` (`BialgHom.natLERec.directedSystem`), which is how sequential directed colimits of bialgebras
are usually presented.
-/

public section

namespace BialgHom

variable (R A : Type*) [CommSemiring R] [Semiring A] [Algebra R A] [CoalgebraStruct R A]

/-- The ring homomorphism underlying the identity bialgebra morphism is the identity. -/
@[simp]
theorem id_toRingHom : (BialgHom.id R A : A →+* A) = RingHom.id A := rfl

variable {R A}
variable {B : Type*} [Semiring B] [Algebra R B] [CoalgebraStruct R B]

/-- The coalgebra morphism underlying a bialgebra morphism is its coercion to a coalgebra
morphism. -/
theorem toCoalgHom_eq_ofClass (f : A →ₐc[R] B) : f.toCoalgHom = CoalgHom.ofClass f :=
  rfl

/-- The ring homomorphism underlying a composite of bialgebra morphisms is the composite
of the underlying ring homomorphisms. -/
@[simp]
theorem comp_toRingHom {C : Type*} [Semiring C] [Algebra R C] [CoalgebraStruct R C]
    (g : B →ₐc[R] C) (f : A →ₐc[R] B) :
    (g.comp f : A →+* C) = (g : B →+* C).comp (f : A →+* B) := by
  ext x
  simp only [RingHom.coe_coe, BialgHom.coe_comp, RingHom.coe_comp, Function.comp_apply]

/-- The tensor-square map sends the comultiplication of an element in the kernel of a
bialgebra morphism to zero. -/
theorem comul_mem_ker_tensorProduct_map (f : A →ₐc[R] B) {x : A}
    (hx : x ∈ RingHom.ker f.toAlgHom) :
    Coalgebra.comul (R := R) x ∈
      RingHom.ker (Algebra.TensorProduct.map f.toAlgHom f.toAlgHom) := by
  simp only [RingHom.mem_ker, coe_toAlgHom] at hx
  rw [RingHom.mem_ker]
  calc
    Algebra.TensorProduct.map f.toAlgHom f.toAlgHom (Coalgebra.comul (R := R) x) =
        Coalgebra.comul (R := R) (f x) := CoalgHomClass.map_comp_comul_apply f x
    _ = 0 := by rw [hx, map_zero]

/-- The counit vanishes on the ordinary kernel of a bialgebra morphism. -/
theorem counit_eq_zero_of_mem_ker (f : A →ₐc[R] B) {x : A}
    (hx : x ∈ RingHom.ker f.toAlgHom) : Coalgebra.counit (R := R) x = 0 := by
  simp only [RingHom.mem_ker, coe_toAlgHom] at hx
  rw [← CoalgHomClass.counit_comp_apply f x, hx, map_zero]

/-- Membership in the kernel of the ring homomorphism underlying a bialgebra morphism is
vanishing under the morphism. -/
theorem mem_ker_toAlgHom_toRingHom {f : A →ₐc[R] B} {x : A} :
    x ∈ RingHom.ker f.toAlgHom.toRingHom ↔ f x = 0 :=
  Iff.rfl

end BialgHom

namespace Bialgebra

variable {R A : Type*} [CommSemiring R] [Semiring A] [Bialgebra R A]

/-- The unit bialgebra morphism is the structure map. -/
@[simp]
theorem unitBialgHom_apply (r : R) : unitBialgHom R A r = algebraMap R A r := rfl

end Bialgebra

namespace BialgHom

variable {R : Type*} [CommSemiring R] {A : ℕ → Type*} [∀ n, Semiring (A n)]
  [∀ n, Bialgebra R (A n)] (g : ∀ n, A n →ₐc[R] A (n + 1))

/-- The composite `A i →ₐc[R] A j`, for `i ≤ j`, of a sequence of bialgebra morphisms
`g k : A k →ₐc[R] A (k + 1)` for `i ≤ k < j`. These are the transition maps of the directed system
generated by `g` (`BialgHom.natLERec.directedSystem`). This is the bialgebra version of Mathlib's
`FirstOrder.Language.DirectedSystem.natLERec` and of `StarAlgHom.natLERec`, whose construction
through `Nat.leRecOn` it follows. -/
noncomputable def natLERec (i j : ℕ) (h : i ≤ j) : A i →ₐc[R] A j :=
  Nat.leRecOn h (fun {k} φ ↦ (g k).comp φ) (BialgHom.id R _)

/-- The composite from a stage to itself is the identity. -/
@[simp]
theorem natLERec_self (i : ℕ) : natLERec g i i le_rfl = BialgHom.id R _ :=
  Nat.leRecOn_self _

/-- The composite to the stage after `k` is `g k` after the composite to `k`. -/
theorem natLERec_succ {i k : ℕ} (h : i ≤ k) :
    natLERec g i (k + 1) (h.trans k.le_succ) = (g k).comp (natLERec g i k h) :=
  Nat.leRecOn_succ h _

/-- The composite from a stage to the next one is `g`. -/
@[simp]
theorem natLERec_self_succ (n : ℕ) (h : n ≤ n + 1) : natLERec g n (n + 1) h = g n := by
  rw [natLERec_succ g le_rfl, natLERec_self, BialgHom.comp_id]

/-- The composites compose. -/
@[simp]
theorem natLERec_comp {i j k : ℕ} (hij : i ≤ j) (hjk : j ≤ k) :
    (natLERec g j k hjk).comp (natLERec g i j hij) = natLERec g i k (hij.trans hjk) := by
  induction k, hjk using Nat.le_induction with
  | base => rw [natLERec_self, BialgHom.id_comp]
  | succ k hjk ih => rw [natLERec_succ g hjk, natLERec_succ g (hij.trans hjk), comp_assoc, ih]

instance natLERec.directedSystem : DirectedSystem A fun i j h ↦ natLERec g i j h where
  map_self i a := by rw [natLERec_self, BialgHom.id_apply]
  map_map k j i hij hjk a := by rw [← natLERec_comp g hij hjk, BialgHom.comp_apply]

end BialgHom
