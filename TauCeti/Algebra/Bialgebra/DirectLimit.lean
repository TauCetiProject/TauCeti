module

public import Mathlib.Algebra.Colimit.DirectLimit
public import TauCeti.Algebra.AlgebraicGroup.Hopf.Map
public import TauCeti.Algebra.Bialgebra.Hom.Basic
public import TauCeti.Algebra.Coalgebra.DirectLimit

/-!
# Directed colimits of bialgebras

Let `(Aᵢ, fᵢⱼ)` be a directed system of `R`-bialgebras with bialgebra morphisms as transition
maps. Mathlib makes its colimit `DirectLimit A f` an `R`-algebra, and
`Module.DirectLimit.instCoalgebra` makes the colimit of the underlying modules a coalgebra.
Transporting that coalgebra structure along the identification of the two colimits of modules,
the comultiplication and counit of `DirectLimit A f` are the unique linear maps with
`Δ (ofᵢ a) = (ofᵢ ⊗ ofᵢ) (Δ a)` and `ε (ofᵢ a) = ε a`. They are algebra maps, so `DirectLimit A f`
is a bialgebra. The canonical maps are bialgebra morphisms and a compatible family of bialgebra
morphisms out of the stages induces one out of the colimit.

For a commutative `R`-algebra `S`, the points of the colimit in `S` are the compatible families
of points of the stages: the convolution monoid `WithConv (DirectLimit A f →ₐ[R] S)` is the
inverse limit of the convolution monoids `WithConv (Aᵢ →ₐ[R] S)` (`DirectLimit.pointsMulEquiv`).
For commutative Hopf algebras this says that the affine group with coordinate ring
`DirectLimit A f` is the inverse limit of the affine groups `Spec Aᵢ`, which is how a
proalgebraic group, such as the group of arcs of an algebraic group, is presented by algebraic
groups. Directed systems indexed by `ℕ` are usually given by their maps `Aₙ → Aₙ₊₁`; their
composites `BialgHom.natLERec` form the directed system.

The Hopf algebra structure of a directed colimit of Hopf algebras is in
`TauCeti.Algebra.HopfAlgebra.DirectLimit`.

## Main definitions

* `DirectLimit.instBialgebra`: the bialgebra structure on the colimit.
* `DirectLimit.Bialgebra.of`: the canonical map from a stage, as a bialgebra morphism.
* `DirectLimit.Bialgebra.lift`: the bialgebra morphism out of the colimit induced by a
  compatible family of bialgebra morphisms.
* `DirectLimit.pointsLimit`: the inverse limit of the convolution monoids of points of the
  stages.
* `DirectLimit.pointsMulEquiv`: the points of the colimit are the inverse limit of the points of
  the stages.
* `BialgHom.mem_pointsLimit_natLERec_iff`: for the directed system `BialgHom.natLERec g`
  generated by a sequence of bialgebra morphisms `g n : Aₙ → Aₙ₊₁`, compatibility of points can
  be checked on each `g n`.
-/

public section

open TensorProduct Coalgebra WithConv

namespace DirectLimit

variable {R : Type*} [CommSemiring R] {ι : Type*} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
  {A : ι → Type*} [∀ i, Semiring (A i)]

section Bialgebra

variable [∀ i, _root_.Bialgebra R (A i)] (f : ∀ i j, i ≤ j → A i →ₐc[R] A j)
  [DirectedSystem A (f · · ·)]

section Coalgebra

/-- Mathlib's colimit `DirectLimit A f`, a quotient of the disjoint union, is linearly
isomorphic to the colimit `Module.DirectLimit` of the underlying modules, a quotient of the direct
sum, which carries the coalgebra structure `Module.DirectLimit.instCoalgebra`. This is
`Module.DirectLimit.linearEquiv` for transition maps that are bialgebra morphisms: there
`DirectLimit A f` is formed with the coercion of the linear maps `f i j h` to functions. -/
noncomputable def moduleDirectLimitLinearEquiv [DecidableEq ι] :
    DirectLimit A f ≃ₗ[R]
      Module.DirectLimit A fun i j h ↦ ((f i j h : A i →ₗc[R] A j) : A i →ₗ[R] A j) :=
  .ofLinearMap
    (Module.lift R ι A f (fun i ↦ Module.DirectLimit.of R ι A _ i) fun _ j h x ↦ by
      rw [← Module.DirectLimit.of_f (j := j) (hij := h) (x := x), LinearMap.coe_ofClass,
        CoalgHom.coe_ofClass])
    (Module.DirectLimit.lift R ι A _ (fun i ↦ Module.of R ι A f i) fun _ _ _ _ ↦ by
      rw [LinearMap.coe_ofClass, CoalgHom.coe_ofClass, Module.of_f])
    (by
      ext i x
      simp only [LinearMap.comp_apply, LinearMap.id_apply]
      rw [Module.DirectLimit.lift_of, Module.lift_of])
    (by
      ext i x
      simp only [LinearMap.comp_apply, LinearMap.id_apply]
      rw [Module.lift_of, Module.DirectLimit.lift_of])

@[simp]
theorem moduleDirectLimitLinearEquiv_mk [DecidableEq ι] (i : ι) (x : A i) :
    moduleDirectLimitLinearEquiv f ⟦⟨i, x⟩⟧ = Module.DirectLimit.of R ι A _ i x :=
  (rfl)

@[simp]
theorem moduleDirectLimitLinearEquiv_symm_of [DecidableEq ι] (i : ι) (x : A i) :
    (moduleDirectLimitLinearEquiv f).symm (Module.DirectLimit.of R ι A _ i x) = ⟦⟨i, x⟩⟧ :=
  (moduleDirectLimitLinearEquiv f).symm_apply_eq.mpr (moduleDirectLimitLinearEquiv_mk f i x).symm

/-- The coalgebra structure of a directed colimit of bialgebras, transported from
`Module.DirectLimit.instCoalgebra`: the comultiplication and counit are determined by
`comul_mk` and `counit_mk`. -/
noncomputable instance instCoalgebra : Coalgebra R (DirectLimit A f) :=
  letI := Classical.decEq ι
  (moduleDirectLimitLinearEquiv f).coalgebra R

/-- The comultiplication of the colimit on the image of a stage. -/
@[simp]
theorem comul_mk (i : ι) (x : A i) :
    comul (R := R) (⟦⟨i, x⟩⟧ : DirectLimit A f) =
      TensorProduct.map (Module.of R ι A f i) (Module.of R ι A f i) (comul x) := by
  classical
  -- unfold the transported comultiplication
  change TensorProduct.map (moduleDirectLimitLinearEquiv f).symm.toLinearMap
    (moduleDirectLimitLinearEquiv f).symm.toLinearMap
    (comul (moduleDirectLimitLinearEquiv f ⟦⟨i, x⟩⟧)) = _
  rw [moduleDirectLimitLinearEquiv_mk, Module.DirectLimit.comul_of, TensorProduct.map_map]
  congr 1
  ext
  simp

/-- The counit of the colimit on the image of a stage. -/
@[simp]
theorem counit_mk (i : ι) (x : A i) :
    counit (R := R) (⟦⟨i, x⟩⟧ : DirectLimit A f) = counit x := by
  classical
  -- unfold the transported counit
  change counit (moduleDirectLimitLinearEquiv f ⟦⟨i, x⟩⟧) = _
  rw [moduleDirectLimitLinearEquiv_mk, Module.DirectLimit.counit_of]

end Coalgebra

/-- A directed colimit of bialgebras along bialgebra morphisms is a bialgebra. -/
noncomputable instance instBialgebra : Bialgebra R (DirectLimit A f) :=
  Bialgebra.mk' R _
    (by rw [one_def (Classical.arbitrary ι), counit_mk, Bialgebra.counit_one])
    (fun {a b} ↦ DirectLimit.induction₂ (C := fun a b ↦ counit (R := R) (a * b) =
        counit a * counit b) f (fun i x y ↦ by
      rw [mul_def, counit_mk, counit_mk, counit_mk, Bialgebra.counit_mul]) a b)
    (by
      rw [one_def (Classical.arbitrary ι), comul_mk, Bialgebra.comul_one,
        Algebra.TensorProduct.one_def, TensorProduct.map_tmul, Algebra.TensorProduct.one_def]
      simp [one_def (Classical.arbitrary ι)])
    (fun {a b} ↦ DirectLimit.induction₂ (C := fun a b ↦ comul (R := R) (a * b) =
        comul a * comul b) f (fun i x y ↦ by
      have h := map_mul (Algebra.TensorProduct.map (Algebra.of A f i) (Algebra.of A f i))
        (comul (R := R) x) (comul y)
      rw [← AlgHom.coe_toLinearMap, Algebra.TensorProduct.toLinearMap_map] at h
      rw [mul_def, comul_mk, comul_mk, comul_mk, Bialgebra.comul_mul]
      exact h) a b)

namespace Bialgebra

variable (A) in
/-- The canonical map from a stage into a directed colimit of bialgebras, as a bialgebra
morphism. -/
noncomputable def of (i : ι) : A i →ₐc[R] DirectLimit A f :=
  .ofAlgHom (Algebra.of A f i)
    (AlgHom.ext fun x ↦ by simp)
    (AlgHom.ext fun x ↦ by
      simp only [AlgHom.comp_apply, Bialgebra.comulAlgHom_apply, Algebra.of_apply, comul_mk]
      rw [← AlgHom.coe_toLinearMap, Algebra.TensorProduct.toLinearMap_map]
      -- `Module.of` and `(Algebra.of A f i).toLinearMap` are both `x ↦ ⟦⟨i, x⟩⟧`
      rfl)

@[simp]
theorem of_apply (i : ι) (x : A i) : of A f i x = ⟦⟨i, x⟩⟧ := (rfl)

@[simp]
theorem toAlgHom_of (i : ι) : (of A f i : A i →ₐ[R] DirectLimit A f) = Algebra.of A f i := (rfl)

/-- The canonical bialgebra morphisms are compatible with the transition maps. -/
@[simp]
theorem of_comp {i j : ι} (h : i ≤ j) : (of A f j).comp (f i j h) = of A f i :=
  BialgHom.coe_toAlgHom_injective (AlgHom.ext fun _ ↦ Algebra.of_f ..)

variable {B : Type*} [Semiring B] [_root_.Bialgebra R B] (g : ∀ i, A i →ₐc[R] B)
  (hg : ∀ i j h, (g j).comp (f i j h) = g i)

/-- The universal property of a directed colimit of bialgebras: a compatible family of bialgebra
morphisms out of the stages induces a bialgebra morphism out of the colimit. -/
noncomputable def lift : DirectLimit A f →ₐc[R] B :=
  .ofAlgHom (Algebra.lift A f B (fun i ↦ g i) fun i j h x ↦ by
      rw [BialgHom.coe_toAlgHom, BialgHom.coe_toAlgHom, ← BialgHom.comp_apply, hg])
    (Algebra.hom_ext _ fun i ↦ AlgHom.ext fun x ↦ by
      simp only [AlgHom.comp_apply, Bialgebra.counitAlgHom_apply, Algebra.of_apply,
        Algebra.lift_apply, DirectLimit.lift_def, BialgHom.coe_toAlgHom, counit_mk,
        CoalgHomClass.counit_comp_apply])
    (Algebra.hom_ext _ fun i ↦ AlgHom.ext fun x ↦ by
      simp only [AlgHom.comp_apply, Bialgebra.comulAlgHom_apply, Algebra.of_apply,
        Algebra.lift_apply, DirectLimit.lift_def, BialgHom.coe_toAlgHom, comul_mk]
      rw [← CoalgHomClass.map_comp_comul_apply (g i)]
      induction comul (R := R) x using TensorProduct.inductionOn with
      | tmul a b => simp
      | add a b ha hb => simp only [map_add, ha, hb])

@[simp]
theorem lift_mk (i : ι) (x : A i) : lift f g hg ⟦⟨i, x⟩⟧ = g i x := (rfl)

@[simp]
theorem lift_comp_of (i : ι) : (lift f g hg).comp (of A f i) = g i :=
  BialgHom.coe_toAlgHom_injective (AlgHom.ext fun _ ↦ (rfl))

/-- Bialgebra morphisms out of a directed colimit of bialgebras agree when they agree on every
stage. -/
@[ext]
theorem hom_ext {φ ψ : DirectLimit A f →ₐc[R] B} (h : ∀ i, φ.comp (of A f i) = ψ.comp (of A f i)) :
    φ = ψ :=
  BialgHom.coe_toAlgHom_injective <| Algebra.hom_ext _ fun i ↦ congr(($(h i) : A i →ₐ[R] B))

end Bialgebra

section Points

variable (S : Type*) [CommSemiring S] [Algebra R S]

omit [IsDirectedOrder ι] [Nonempty ι] [DirectedSystem A (f · · ·)] in
/-- **The inverse limit of the points of the stages.** The submonoid of `∏ i, Hom(Aᵢ, S)`, with
the convolution products, of families compatible with the transition maps. -/
def pointsLimit : Submonoid (∀ i, WithConv (A i →ₐ[R] S)) where
  carrier := {x | ∀ i j h, BialgHom.mapDomain (f i j h) (x j) = x i}
  mul_mem' {a b} ha hb i j h := by rw [Pi.mul_apply, map_mul, ha i j h, hb i j h, Pi.mul_apply]
  one_mem' _ _ _ := map_one _

omit [IsDirectedOrder ι] [Nonempty ι] [DirectedSystem A (f · · ·)] in
variable {f S} in
@[simp]
theorem mem_pointsLimit_iff {x : ∀ i, WithConv (A i →ₐ[R] S)} :
    x ∈ pointsLimit f S ↔ ∀ i j h, BialgHom.mapDomain (f i j h) (x j) = x i :=
  Iff.rfl

/-- **The points of a directed colimit of bialgebras are the inverse limit of the points of the
stages.** Restricting a point of `DirectLimit A f` in `S` to the stages identifies the
convolution monoid of points with the compatible families of points of the stages. -/
noncomputable def pointsMulEquiv : WithConv (DirectLimit A f →ₐ[R] S) ≃* pointsLimit f S :=
  MulEquiv.ofBijective
    ((MonoidHom.pi fun i ↦ BialgHom.mapDomain (Bialgebra.of A f i)).codRestrict _ fun x ↦
      mem_pointsLimit_iff.mpr fun i j h ↦ by
        rw [MonoidHom.pi_apply, MonoidHom.pi_apply, ← MonoidHom.comp_apply,
          ← BialgHom.mapDomain_comp, Bialgebra.of_comp])
    ⟨fun x y hxy ↦ WithConv.ofConv_injective <| Algebra.hom_ext _ fun i ↦ by
        have h := congr(WithConv.ofConv ((($hxy).val : ∀ i, WithConv (A i →ₐ[R] S)) i))
        simp only [MonoidHom.codRestrict_apply, MonoidHom.pi_apply, BialgHom.mapDomain_apply,
          ofConv_toConv, Bialgebra.toAlgHom_of] at h
        exact h,
      fun c ↦ ⟨toConv (Algebra.lift A f S (fun i ↦ (c.val i).ofConv) fun i j h a ↦ by
          simpa using congr((($(c.property i j h)).ofConv) a)),
        Subtype.ext <| funext fun i ↦ WithConv.ofConv_injective <| AlgHom.ext fun a ↦ by simp⟩⟩

variable {f S}

/-- The `i`-th component of the family of a point of the colimit is its restriction to the
`i`-th stage. -/
@[simp]
theorem pointsMulEquiv_apply (x : WithConv (DirectLimit A f →ₐ[R] S)) (i : ι) :
    (pointsMulEquiv f S x : ∀ i, WithConv (A i →ₐ[R] S)) i =
      BialgHom.mapDomain (Bialgebra.of A f i) x :=
  (rfl)

/-- The point of the colimit attached to a compatible family takes the value of the `i`-th
member of the family on the image of the `i`-th stage. -/
@[simp]
theorem ofConv_pointsMulEquiv_symm_apply_mk (c : pointsLimit f S) (i : ι) (a : A i) :
    ((pointsMulEquiv f S).symm c).ofConv ⟦⟨i, a⟩⟧ = (c.val i).ofConv a := by
  obtain ⟨x, rfl⟩ := (pointsMulEquiv f S).surjective c
  rw [MulEquiv.symm_apply_apply, pointsMulEquiv_apply, BialgHom.mapDomain_apply_apply,
    Bialgebra.of_apply]

/-- **Naturality of `pointsMulEquiv` in `S`.** For `φ : S →ₐ[R] T`, the family of the image of a
point under `φ` is the image under `φ` of its family. -/
theorem pointsMulEquiv_mapValue {T : Type*} [CommSemiring T] [Algebra R T] (φ : S →ₐ[R] T)
    (x : WithConv (DirectLimit A f →ₐ[R] S)) (i : ι) :
    (pointsMulEquiv f T (AlgHom.mapValue φ x) : ∀ i, WithConv (A i →ₐ[R] T)) i =
      AlgHom.mapValue φ ((pointsMulEquiv f S x : ∀ i, WithConv (A i →ₐ[R] S)) i) := by
  rw [pointsMulEquiv_apply, pointsMulEquiv_apply, ← MonoidHom.comp_apply,
    BialgHom.mapValue_mapDomain, MonoidHom.comp_apply]

end Points

end Bialgebra

end DirectLimit

namespace BialgHom

variable {R : Type*} [CommSemiring R] {A : ℕ → Type*} [∀ n, Semiring (A n)]
  [∀ n, Bialgebra R (A n)] (g : ∀ n, A n →ₐc[R] A (n + 1))

/-- A family of points is compatible with the directed system generated by `g` exactly when it is
compatible with each `g n`. -/
theorem mem_pointsLimit_natLERec_iff {S : Type*} [CommSemiring S] [Algebra R S]
    {x : ∀ n, WithConv (A n →ₐ[R] S)} :
    x ∈ DirectLimit.pointsLimit (natLERec g) S ↔
      ∀ n, BialgHom.mapDomain (g n) (x (n + 1)) = x n := by
  refine ⟨fun hx n ↦ by simpa using hx n (n + 1) n.le_succ, fun hx i j hij ↦ ?_⟩
  induction j, hij using Nat.le_induction with
  | base => rw [natLERec_self, BialgHom.mapDomain_id, MonoidHom.id_apply]
  | succ j hij ih =>
    rw [natLERec_succ g hij, BialgHom.mapDomain_comp, MonoidHom.comp_apply, hx, ih]

end BialgHom
