module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import TauCeti.Algebra.BrauerAlgebra.Basic
public import TauCeti.Combinatorics.Brauer.Generation

/-!
# Generators of the Brauer algebra

The Brauer algebra `B_k(δ)` is generated, as an `R`-algebra, by the permutation diagrams together
with a single cap-cup diagram `e = TauCeti.capCup a b` on two distinct strands
(`TauCeti.BrauerAlgebra.adjoin_insert_of_capCup_range_of_permToBrauer`). Since the symmetric group
is generated by the adjacent transpositions `sᵢ`, taking `a, b` adjacent recovers Brauer's
classical generators `s₁, …, s_{k-1}` and `e`; the statements here use all the permutation
diagrams. So an algebra map out of `B_k(δ)` is determined by its
restriction to the symmetric group and its value on `e`
(`TauCeti.BrauerAlgebra.algHom_ext_of_capCup`). This is how an action of the Brauer algebra is
matched against the operators it is built from: on tensor powers, the permutations of the tensor
factors and a single contraction-expansion of two slots.

The proof has two steps.

* Every diagram is a loop-free stack of cap-cup diagrams above a permutation diagram
  (`TauCeti.BrauerDiagram.capCup_induction_on`), and in the Brauer algebra a stack that closes up
  no loop is the product of its two diagrams
  (`TauCeti.BrauerAlgebra.of_mul_of_of_middleLoopCount_eq_zero`). Since the diagrams form a basis,
  the permutation diagrams and all the cap-cup diagrams generate the algebra
  (`TauCeti.BrauerAlgebra.adjoin_range_of_permToBrauer_union_range_of_capCup`).
* Conjugating a cap-cup diagram by a permutation diagram renames its pair
  (`TauCeti.BrauerAlgebra.of_permToBrauer_mul_of_capCup_mul_of_permToBrauer_inv`), and any pair of
  distinct strands is carried to any other by some permutation, so one cap-cup diagram suffices.

## Main results

* `TauCeti.BrauerAlgebra.adjoin_range_of_permToBrauer_union_range_of_capCup`: the permutation
  diagrams and the cap-cup diagrams generate the Brauer algebra.
* `TauCeti.BrauerAlgebra.adjoin_insert_of_capCup_range_of_permToBrauer`: **the permutation
  diagrams and one cap-cup diagram generate the Brauer algebra.**
* `TauCeti.BrauerAlgebra.algHom_ext_of_capCup`: an algebra map out of the Brauer algebra is
  determined by its values on the permutation diagrams and on one cap-cup diagram.

## References

* [R. Brauer, *On algebras which are connected with the semisimple continuous groups*][brauer1937],
  Annals of Mathematics 38 (1937), 857-872.
* R. Goodman and N. R. Wallach, *Symmetry, Representations, and Invariants*, Springer GTM 255
  (2009), §10.1.
-/

public section

namespace TauCeti

namespace BrauerAlgebra

variable {R : Type*} [CommSemiring R] {δ : R} {k : ℕ}

variable (R δ k) in
/-- **The permutation diagrams and the cap-cup diagrams generate the Brauer algebra.** -/
theorem adjoin_range_of_permToBrauer_union_range_of_capCup :
    Algebra.adjoin R (Set.range (fun σ : Equiv.Perm (Fin k) => (of (permToBrauer σ) :
      BrauerAlgebra R δ k)) ∪ Set.range fun p : Fin k × Fin k => of (capCup p.1 p.2)) = ⊤ := by
  set S := Algebra.adjoin R (Set.range (fun σ : Equiv.Perm (Fin k) => (of (permToBrauer σ) :
    BrauerAlgebra R δ k)) ∪ Set.range fun p : Fin k × Fin k => of (capCup p.1 p.2))
  have hD (D : BrauerDiagram k) : (of D : BrauerAlgebra R δ k) ∈ S := by
    induction D using BrauerDiagram.capCup_induction_on with
    | permToBrauer σ => exact Algebra.subset_adjoin (Or.inl ⟨σ, rfl⟩)
    | capCup_compose a b X _ hloop hX =>
      rw [← of_mul_of_of_middleLoopCount_eq_zero hloop]
      exact S.mul_mem (Algebra.subset_adjoin (Or.inr ⟨(a, b), rfl⟩)) hX
  refine eq_top_iff.mpr fun x _ => ?_
  have hspan : Submodule.span R (Set.range (basis R δ k)) ≤ Subalgebra.toSubmodule S :=
    Submodule.span_le.mpr <| Set.range_subset_iff.mpr fun D => by
      simpa [basis_apply] using hD D
  exact hspan ((basis R δ k).span_eq ▸ Submodule.mem_top)

variable (R δ) in
/-- **The permutation diagrams and one cap-cup diagram generate the Brauer algebra**: the cap-cup
diagram `e = capCup a b` on any two distinct strands, together with the permutation diagrams,
generates `B_k(δ)` as an `R`-algebra. -/
theorem adjoin_insert_of_capCup_range_of_permToBrauer {a b : Fin k} (hab : a ≠ b) :
    Algebra.adjoin R (insert (of (capCup a b)) (Set.range fun σ : Equiv.Perm (Fin k) =>
      (of (permToBrauer σ) : BrauerAlgebra R δ k))) = ⊤ := by
  set S := Algebra.adjoin R (insert (of (capCup a b)) (Set.range fun σ : Equiv.Perm (Fin k) =>
    (of (permToBrauer σ) : BrauerAlgebra R δ k)))
  have hperm (σ : Equiv.Perm (Fin k)) : (of (permToBrauer σ) : BrauerAlgebra R δ k) ∈ S :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨σ, rfl⟩)
  rw [eq_top_iff, ← adjoin_range_of_permToBrauer_union_range_of_capCup R δ k,
    Algebra.adjoin_le_iff]
  rintro _ (⟨σ, rfl⟩ | ⟨⟨c, d⟩, rfl⟩) <;> simp only [SetLike.mem_coe]
  · exact hperm σ
  rcases eq_or_ne c d with rfl | hcd
  · simpa only [capCup_self] using hperm 1
  obtain ⟨σ, hσ⟩ := Equiv.Perm.exists_extending_pair ![a, b] ![c, d]
    (Matrix.injective_pair_iff_ne.mpr hab) (Matrix.injective_pair_iff_ne.mpr hcd)
  obtain ⟨rfl, rfl⟩ : σ a = c ∧ σ b = d := ⟨hσ 0, hσ 1⟩
  rw [← of_permToBrauer_mul_of_capCup_mul_of_permToBrauer_inv]
  exact S.mul_mem (S.mul_mem (hperm σ) (Algebra.subset_adjoin (Set.mem_insert _ _))) (hperm σ⁻¹)

/-- **An algebra map out of the Brauer algebra is determined by its values on the permutation
diagrams and on one cap-cup diagram** on two distinct strands. -/
theorem algHom_ext_of_capCup {A : Type*} [Semiring A] [Algebra R A]
    {f g : BrauerAlgebra R δ k →ₐ[R] A} {a b : Fin k} (hab : a ≠ b)
    (hperm : ∀ σ : Equiv.Perm (Fin k), f (of (permToBrauer σ)) = g (of (permToBrauer σ)))
    (hcapCup : f (of (capCup a b)) = g (of (capCup a b))) : f = g :=
  AlgHom.ext_of_adjoin_eq_top (adjoin_insert_of_capCup_range_of_permToBrauer R δ hab) <| by
    rintro _ (rfl | ⟨σ, rfl⟩)
    exacts [hcapCup, hperm σ]

end BrauerAlgebra

end TauCeti
