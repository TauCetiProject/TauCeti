module

public import Mathlib.Algebra.Order.Group.Defs
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import TauCeti.Algebra.Order.Monoid.Unbundled.Pow
import Mathlib.Order.Monotone.Basic

/-!
# Positive members of an ordered cyclic subgroup

In a preordered additive group with monotone left addition, a positive element of the cyclic
subgroup `zmultiples a` generated by some `a > 0` is at least `a`. This is the additive-group
counterpart of `TauCeti.isLeast_pos_int_mul` for linearly ordered rings. A nonnegative element of
the cyclic subgroup is a natural multiple of its generator.

## Main results

* `TauCeti.le_of_mem_zmultiples` : a positive integer multiple of `a > 0` is at least `a`.
* `TauCeti.exists_nsmul_eq_of_nonneg_of_mem_zmultiples` : a nonnegative integer multiple of
  `a > 0` is a natural multiple of `a`.
-/

public section

namespace TauCeti

/-- In a preordered additive group with monotone left addition, a positive element of
`zmultiples a` for `a > 0` is at least `a`: it is `k • a` with `k ≥ 1`. -/
theorem le_of_mem_zmultiples {A : Type*} [AddGroup A] [Preorder A] [AddLeftMono A] {a b : A}
    (ha : 0 < a) (hb : b ∈ AddSubgroup.zmultiples a) (hpos : 0 < b) : a ≤ b := by
  obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hb
  have hmono : Monotone fun k : ℤ ↦ k • a := monotone_int_of_le_succ fun k ↦ by
    rw [add_one_zsmul]
    exact le_add_of_nonneg_right ha.le
  have hk : 1 ≤ k := by
    by_contra! hk
    exact hpos.not_ge (by simpa using hmono (Int.lt_add_one_iff.1 hk : k ≤ 0))
  simpa using hmono hk

/-- In a preordered additive group with monotone left addition, a nonnegative element of
`zmultiples a` for `a > 0` is a natural multiple of `a`. -/
theorem exists_nsmul_eq_of_nonneg_of_mem_zmultiples {A : Type*} [AddGroup A] [Preorder A]
    [AddLeftMono A] {a b : A} (ha : 0 < a) (hb : 0 ≤ b)
    (hba : b ∈ AddSubgroup.zmultiples a) : ∃ n : ℕ, n • a = b := by
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 hba
  rcases k with n | n
  · exact ⟨n, by simpa using hk⟩
  · have hn := nsmul_pos ha (Nat.succ_ne_zero n)
    rw [← hk, negSucc_zsmul, neg_nonneg] at hb
    exact (hn.not_ge hb).elim

end TauCeti

end
