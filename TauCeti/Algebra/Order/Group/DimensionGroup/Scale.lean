/-!
# Scales of ordered abelian groups

A *scale* of a preordered additive monoid `G` is a set `S` of positive elements that contains
`0`, is upward directed, is hereditary in the positive cone (`0 ≤ g ≤ s` with `s ∈ S` forces
`g ∈ S`) and generates the positive cone as an additive monoid. Scales are the extra datum that
turns the ordered `K₀`-group of an AF C⋆-algebra into a complete isomorphism invariant: the
scale of a C⋆-algebra is the set of classes of its projections, so the matrix algebras `M₂` and
`M₃` have the same ordered group `ℤ` but the different scales `[0, 2]` and `[0, 3]`. A scale of
a unital algebra is the interval up to the class of the unit (`IsScale.eq_Icc_of_isGreatest`),
while the scale of a stable algebra is its whole positive cone (`isScale_Ici`).

## Main definitions

* `TauCeti.IsScale S`: `S` is a scale.

## Main results

* `TauCeti.IsScale.closure_eq`: the additive submonoid generated by a scale is the positive cone.
* `TauCeti.IsScale.exists_le_nsmul`: the domination form of a scale, every positive element lies
  below a multiple of a single element of the scale.
* `TauCeti.IsScale.of_forall_exists_le`: conversely, under Riesz interpolation, domination of
  the positive cone by sums of elements of `S` is enough for generation.
* `TauCeti.isScale_Ici`: the positive cone is a scale.
* `TauCeti.isScale_Icc_iff`: under Riesz interpolation, `[0, u]` is a scale exactly when `u` is
  a positive element dominating every positive element up to a multiple, an order unit.
* `TauCeti.isScale_singleton_zero_iff`: `{0}` is a scale exactly when the positive cone is
  trivial.
* `TauCeti.IsScale.pi`: scales of finitely many groups give a scale of their product.

The hypothesis of Riesz interpolation cannot be dropped from `isScale_Icc_iff`: in `ℤ` with
positive cone `{0} ∪ {n | 2 ≤ n}` every positive element lies below a multiple of `2`, but the
interval `[0, 2] = {0, 2}` generates only the even positive integers.

## References

* G. A. Elliott, *On the classification of inductive limits of sequences of semisimple
  finite-dimensional algebras*, Journal of Algebra 38 (1976), 29–44.
* E. G. Effros, *Dimensions and C⋆-algebras*, CBMS Regional Conference Series in Mathematics 46,
  AMS, 1981.
* M. Rørdam, *Classification of nuclear C⋆-algebras*, Encyclopaedia of Mathematical Sciences
  126, Springer, 2002, §1.4.
-/

public section

namespace TauCeti

variable {G : Type*}

/-- A *scale* of a preordered additive monoid `G`: a set `S` of positive elements that contains
`0`, is upward directed, is hereditary in the positive cone, and generates the positive cone as
an additive monoid. -/
structure IsScale [AddMonoid G] [LE G] (S : Set G) : Prop where
  /-- A scale contains `0`. -/
  zero_mem : (0 : G) ∈ S
  /-- A scale consists of positive elements. -/
  nonneg_of_mem ⦃s : G⦄ : s ∈ S → 0 ≤ s
  /-- A scale is upward directed. -/
  directedOn : DirectedOn (· ≤ ·) S
  /-- A scale is hereditary in the positive cone: it contains every positive element below one
  of its elements. -/
  mem_of_nonneg_of_le ⦃g s : G⦄ : 0 ≤ g → g ≤ s → s ∈ S → g ∈ S
  /-- A scale generates the positive cone as an additive monoid. -/
  mem_closure_of_nonneg ⦃g : G⦄ : 0 ≤ g → g ∈ AddSubmonoid.closure S

namespace IsScale

section Preorder

variable [AddMonoid G] [Preorder G] {S : Set G}

/-- A scale is order-connected. -/
theorem ordConnected (hS : IsScale S) : S.OrdConnected :=
  ⟨fun _ ha _ hb _ hg ↦ hS.mem_of_nonneg_of_le ((hS.nonneg_of_mem ha).trans hg.1) hg.2 hb⟩

/-- A scale with a greatest element `u` is the interval `[0, u]`. This is the shape of the scale
of a unital C⋆-algebra, with `u` the class of the unit. -/
theorem eq_Icc_of_isGreatest (hS : IsScale S) {u : G} (hu : IsGreatest S u) :
    S = Set.Icc 0 u :=
  Set.Subset.antisymm (fun _ hs ↦ ⟨hS.nonneg_of_mem hs, hu.2 hs⟩)
    fun _ hg ↦ hS.mem_of_nonneg_of_le hg.1 hg.2 hu.1

/-- The additive submonoid generated by a scale is the positive cone. -/
theorem closure_eq [AddLeftMono G] (hS : IsScale S) :
    AddSubmonoid.closure S = AddSubmonoid.nonneg G :=
  le_antisymm
    (AddSubmonoid.closure_le.2 fun _ hs ↦ AddSubmonoid.mem_nonneg.2 (hS.nonneg_of_mem hs))
    fun _ hg ↦ hS.mem_closure_of_nonneg (AddSubmonoid.mem_nonneg.1 hg)

end Preorder

section OrderedAddCommMonoid

variable [AddCommMonoid G] [Preorder G] [IsOrderedAddMonoid G] {S : Set G}

/-- Every element of the additive submonoid generated by a scale lies below a multiple of a
single element of the scale. -/
theorem exists_le_nsmul_of_mem_closure (hS : IsScale S) {g : G}
    (hg : g ∈ AddSubmonoid.closure S) : ∃ s ∈ S, ∃ n : ℕ, g ≤ n • s := by
  induction hg using AddSubmonoid.closure_induction with
  | mem g hg => exact ⟨g, hg, 1, (one_nsmul g).ge⟩
  | zero => exact ⟨0, hS.zero_mem, 0, (zero_nsmul 0).ge⟩
  | add x y _ _ hx hy =>
    obtain ⟨s, hs, m, hxs⟩ := hx
    obtain ⟨t, ht, n, hyt⟩ := hy
    obtain ⟨u, hu, hsu, htu⟩ := hS.directedOn s hs t ht
    refine ⟨u, hu, m + n, ?_⟩
    rw [add_nsmul]
    exact add_le_add (hxs.trans (nsmul_le_nsmul_right hsu m))
      (hyt.trans (nsmul_le_nsmul_right htu n))

/-- **Domination form of a scale**: every positive element lies below a multiple of a single
element of the scale. -/
theorem exists_le_nsmul (hS : IsScale S) {g : G} (hg : 0 ≤ g) :
    ∃ s ∈ S, ∃ n : ℕ, g ≤ n • s :=
  hS.exists_le_nsmul_of_mem_closure (hS.mem_closure_of_nonneg hg)

/-- An upper bound `u` of a scale dominates the positive cone: every positive element lies below
a multiple of `u`. In particular the top `u` of a scale `[0, u]` is an order unit. -/
theorem exists_le_nsmul_of_mem_upperBounds (hS : IsScale S) {u : G} (hu : u ∈ upperBounds S)
    {g : G} (hg : 0 ≤ g) : ∃ n : ℕ, g ≤ n • u := by
  obtain ⟨s, hs, n, hgs⟩ := hS.exists_le_nsmul hg
  exact ⟨n, hgs.trans (nsmul_le_nsmul_right (hu hs) n)⟩

end OrderedAddCommMonoid

/-- **Domination form of a scale, converse**: in a group with Riesz interpolation, a hereditary
upward directed set `S` of positive elements containing `0` is a scale as soon as every positive
element lies below some element of the additive submonoid generated by `S`. -/
theorem of_forall_exists_le [AddCommGroup G] [Preorder G] [IsOrderedAddMonoid G]
    (h : HasRieszInterpolation G) {S : Set G} (h0 : (0 : G) ∈ S)
    (hnonneg : ∀ ⦃s⦄, s ∈ S → 0 ≤ s) (hdir : DirectedOn (· ≤ ·) S)
    (hher : ∀ ⦃g s⦄, 0 ≤ g → g ≤ s → s ∈ S → g ∈ S)
    (hdom : ∀ ⦃g⦄, 0 ≤ g → ∃ x ∈ AddSubmonoid.closure S, g ≤ x) : IsScale S where
  zero_mem := h0
  nonneg_of_mem := hnonneg
  directedOn := hdir
  mem_of_nonneg_of_le := hher
  mem_closure_of_nonneg g hg := by
    obtain ⟨x, hx, hgx⟩ := hdom hg
    have hcl : AddSubmonoid.closure S ≤ AddSubmonoid.nonneg G :=
      AddSubmonoid.closure_le.2 fun _ hs ↦ AddSubmonoid.mem_nonneg.2 (hnonneg hs)
    induction hx using AddSubmonoid.closure_induction generalizing g with
    | mem s hs => exact AddSubmonoid.subset_closure (hher hg hgx hs)
    | zero => exact AddSubmonoid.subset_closure (hher hg hgx h0)
    | add x y hx hy ihx ihy =>
      obtain ⟨g₁, g₂, hg₁, hg₁x, hg₂, hg₂y, rfl⟩ := h.exists_decomposition
        (AddSubmonoid.mem_nonneg.1 (hcl hx)) (AddSubmonoid.mem_nonneg.1 (hcl hy)) hg hgx
      exact add_mem (ihx _ hg₁ hg₁x) (ihy _ hg₂ hg₂y)

/-- Scales of finitely many ordered additive monoids give a scale of their product, ordered
componentwise. -/
theorem pi {ι : Type*} [Finite ι] {G : ι → Type*} [∀ i, AddCommMonoid (G i)]
    [∀ i, LE (G i)] {S : ∀ i, Set (G i)} (hS : ∀ i, IsScale (S i)) :
    IsScale (Set.univ.pi S) where
  zero_mem i _ := (hS i).zero_mem
  nonneg_of_mem _ hs i := (hS i).nonneg_of_mem (hs i trivial)
  directedOn s hs t ht := by
    choose u hu hsu htu using fun i ↦ (hS i).directedOn (s i) (hs i trivial) (t i) (ht i trivial)
    exact ⟨u, fun i _ ↦ hu i, hsu, htu⟩
  mem_of_nonneg_of_le _ _ hg hgs hs i _ :=
    (hS i).mem_of_nonneg_of_le (hg i) (hgs i) (hs i trivial)
  mem_closure_of_nonneg g hg := by
    classical
    cases nonempty_fintype ι
    rw [← Finset.univ_sum_single g]
    refine AddSubmonoid.sum_mem _ fun i _ ↦ ?_
    have hmap : (AddSubmonoid.closure (S i)).map (AddMonoidHom.single G i) ≤
        AddSubmonoid.closure (Set.univ.pi S) := by
      rw [AddMonoidHom.map_mclosure]
      refine AddSubmonoid.closure_mono (Set.image_subset_iff.2 fun s hs j _ ↦ ?_)
      obtain rfl | hji := eq_or_ne j i
      · simpa using hs
      · simpa [hji] using (hS j).zero_mem
    exact hmap (AddSubmonoid.mem_map_of_mem _ ((hS i).mem_closure_of_nonneg (hg i)))

end IsScale

section Examples

/-- The positive cone is a scale. -/
theorem isScale_Ici [AddCommMonoid G] [Preorder G] [IsOrderedAddMonoid G] :
    IsScale (Set.Ici (0 : G)) where
  zero_mem := le_rfl
  nonneg_of_mem _ hs := hs
  directedOn a ha b hb :=
    ⟨a + b, add_nonneg ha hb, le_add_of_nonneg_right hb, le_add_of_nonneg_left ha⟩
  mem_of_nonneg_of_le _ _ hg _ _ := hg
  mem_closure_of_nonneg _ hg := AddSubmonoid.subset_closure hg

/-- In a group with Riesz interpolation, the interval `[0, u]` is a scale exactly when `u` is an
order unit for the positive cone: `0 ≤ u` and every positive element lies below a multiple
of `u`. -/
theorem isScale_Icc_iff [AddCommGroup G] [Preorder G] [IsOrderedAddMonoid G]
    (h : HasRieszInterpolation G) {u : G} :
    IsScale (Set.Icc 0 u) ↔ 0 ≤ u ∧ ∀ ⦃g : G⦄, 0 ≤ g → ∃ n : ℕ, g ≤ n • u := by
  refine ⟨fun hS ↦ ⟨hS.zero_mem.2, fun _ ↦ hS.exists_le_nsmul_of_mem_upperBounds fun _ ↦ And.right⟩,
    fun ⟨hu, hdom⟩ ↦ ?_⟩
  refine IsScale.of_forall_exists_le h (Set.left_mem_Icc.2 hu) (fun _ hs ↦ hs.1)
    (fun _ hs _ ht ↦ ⟨u, Set.right_mem_Icc.2 hu, hs.2, ht.2⟩)
    (fun _ _ hg hgs hs ↦ ⟨hg, hgs.trans hs.2⟩) fun g hg ↦ ?_
  obtain ⟨n, hn⟩ := hdom hg
  exact ⟨n • u, nsmul_mem (AddSubmonoid.subset_closure (Set.right_mem_Icc.2 hu)) n, hn⟩

/-- `{0}` is a scale exactly when the positive cone is trivial. -/
theorem isScale_singleton_zero_iff [AddMonoid G] [Preorder G] :
    IsScale ({0} : Set G) ↔ ∀ ⦃g : G⦄, 0 ≤ g → g = 0 := by
  refine ⟨fun hS g hg ↦ ?_,
    fun h ↦ ⟨rfl, ?_, ?_, fun _ _ hg _ _ ↦ h hg, fun g hg ↦ ?_⟩⟩
  · simpa [AddSubmonoid.closure_singleton_zero] using hS.mem_closure_of_nonneg hg
  · rintro _ rfl
    exact le_rfl
  · rintro _ rfl _ rfl
    exact ⟨0, rfl, le_rfl, le_rfl⟩
  · rw [h hg]
    exact zero_mem _

end Examples

end TauCeti
