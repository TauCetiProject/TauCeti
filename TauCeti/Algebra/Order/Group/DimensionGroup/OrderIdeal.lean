/-!
# Order ideals of partially ordered abelian groups

An *order ideal* of a partially ordered abelian group `G` is an additive subgroup `I` of `G` that
is upward directed (equivalently, generated by its positive elements) and order-hereditary in the
positive cone (`0 ≤ a ≤ b` with `b ∈ I` implies `a ∈ I`, equivalently `I` is
order-connected).

Under Riesz interpolation, order ideals form a distributive lattice (`OrderIdeal.distribLattice`)
with intersection as infimum and subgroup sum as supremum, as well as a complete lattice when `G`
is directed (`OrderIdeal.completeLattice`). A directed partially ordered abelian group has only the
trivial order ideals `⊥` and `⊤` if and only if it is nontrivial and every strictly positive
element is an order unit (`isSimpleOrder_iff_forall_pos_isAddOrderUnit`).

## Main definitions

* `TauCeti.OrderIdeal G`: directed, hereditary additive subgroup of `G`.
* `TauCeti.OrderIdeal.closure`: the smallest order ideal containing a given set of nonnegative
  elements.
* `TauCeti.OrderIdeal.inf`, `TauCeti.OrderIdeal.sup`, `TauCeti.OrderIdeal.sSup`: lattice
  operations under Riesz interpolation.
* `TauCeti.OrderIdeal.distribLattice` and `TauCeti.OrderIdeal.completeLattice`: the lattice
  structure on `OrderIdeal G` under Riesz interpolation.

## Main results

* `TauCeti.OrderIdeal.ordConnected`: every order ideal is order-connected.
* `TauCeti.OrderIdeal.ext_nonneg`: an order ideal is determined by its nonnegative elements.
* `TauCeti.OrderIdeal.closure_singleton_eq_top_iff`: the order ideal generated by `u ≥ 0` is `⊤`
  iff `u` is an order unit.
* `TauCeti.OrderIdeal.isSimpleOrder_iff_forall_pos_isAddOrderUnit`: simplicity of `OrderIdeal G`
  iff `G` is nontrivial and every strictly positive element is an order unit.

## References

* K. R. Goodearl, *Partially ordered abelian groups with interpolation*, Mathematical Surveys
  and Monographs 20, AMS, 1986, Chapters 1–2.
* M. Rørdam, *Classification of nuclear C⋆-algebras*, Encyclopaedia of Mathematical Sciences
  126, Springer, 2002, §§1.4–1.5.
-/

public section

namespace TauCeti

section Defs

/-- An *order ideal* of an ordered abelian group `G`: an upward-directed additive subgroup that
is hereditary in the positive cone (`0 ≤ a ≤ b` and `b ∈ I` force `a ∈ I`). -/
structure OrderIdeal (G : Type*) [AddCommGroup G] [LE G] extends AddSubgroup G where
  /-- An order ideal is upward directed. -/
  directedOn' : DirectedOn (· ≤ ·) carrier
  /-- An order ideal is hereditary in the positive cone. -/
  isHereditary' : IsHereditary toAddSubgroup

end Defs

namespace OrderIdeal

section Basic

variable {G : Type*} [AddCommGroup G] [LE G]

instance : SetLike (OrderIdeal G) G where
  coe I := I.carrier
  coe_injective := by
    intro ⟨I₁, _, _⟩ ⟨I₂, _, _⟩ h
    congr 1
    exact AddSubgroup.ext (Set.ext_iff.mp h)

instance : AddSubgroupClass (OrderIdeal G) G where
  add_mem {I} := I.toAddSubgroup.add_mem'
  zero_mem {I} := I.toAddSubgroup.zero_mem'
  neg_mem {I} := I.toAddSubgroup.neg_mem'

@[ext]
theorem ext {I J : OrderIdeal G} (h : ∀ x, x ∈ I ↔ x ∈ J) : I = J :=
  SetLike.ext h

/-- Order ideals are ordered by inclusion. -/
instance : PartialOrder (OrderIdeal G) :=
  PartialOrder.ofSetLike (OrderIdeal G)

/-- Membership in the underlying subgroup is membership in the order ideal. -/
@[simp]
theorem mem_toAddSubgroup {I : OrderIdeal G} {x : G} : x ∈ I.toAddSubgroup ↔ x ∈ I :=
  Iff.rfl

/-- The underlying subgroup has the same underlying set. -/
@[simp]
theorem coe_toAddSubgroup (I : OrderIdeal G) : ((I.toAddSubgroup : AddSubgroup G) : Set G) = I :=
  rfl

/-- Inclusion of order ideals is inclusion of their underlying subgroups. -/
@[simp]
theorem toAddSubgroup_le {I J : OrderIdeal G} : I.toAddSubgroup ≤ J.toAddSubgroup ↔ I ≤ J :=
  Iff.rfl

/-- Strict inclusion of order ideals is strict inclusion of their underlying subgroups. -/
@[simp]
theorem toAddSubgroup_lt {I J : OrderIdeal G} : I.toAddSubgroup < J.toAddSubgroup ↔ I < J := by
  simp [lt_iff_le_not_ge, toAddSubgroup_le]

/-- An order ideal is determined by its underlying additive subgroup. -/
theorem toAddSubgroup_injective : Function.Injective (toAddSubgroup (G := G)) := by
  intro I J h
  ext x
  rw [← mem_toAddSubgroup, ← mem_toAddSubgroup, h]

/-- Two order ideals are equal iff their underlying subgroups are equal. -/
@[simp]
theorem toAddSubgroup_inj {I J : OrderIdeal G} : I.toAddSubgroup = J.toAddSubgroup ↔ I = J :=
  toAddSubgroup_injective.eq_iff

/-- An order ideal is upward directed. -/
theorem directedOn (I : OrderIdeal G) : DirectedOn (· ≤ ·) (I : Set G) :=
  I.directedOn'

/-- An order ideal is hereditary in the positive cone. -/
theorem isHereditary (I : OrderIdeal G) : IsHereditary I :=
  (isHereditary_congr (I.coe_toAddSubgroup)).1 I.isHereditary'

/-- Heredity of an order ideal: `0 ≤ a ≤ b` and `b ∈ I` imply `a ∈ I`. -/
theorem mem_of_nonneg_of_le (I : OrderIdeal G) {a b : G} (ha : 0 ≤ a) (hab : a ≤ b)
    (hb : b ∈ I) : a ∈ I :=
  I.isHereditary.mem_of_le ha hab hb

/-- Every element of an order ideal is dominated by a nonnegative element of the ideal. -/
theorem exists_nonneg_le (I : OrderIdeal G) {x : G} (hx : x ∈ I) :
    ∃ y ∈ I, 0 ≤ y ∧ x ≤ y :=
  I.directedOn 0 (zero_mem I) x hx

end Basic

section Preorder

variable {G : Type*} [AddCommGroup G] [Preorder G]

/-- Viewing an order ideal as a subtype gives an upward-directed ordered type. -/
instance isDirectedOrder (I : OrderIdeal G) : IsDirectedOrder I where
  directed a b := by
    obtain ⟨c, hc, hac, hbc⟩ := I.directedOn a.val a.property b.val b.property
    exact ⟨⟨c, hc⟩, hac, hbc⟩

variable [IsOrderedAddMonoid G]

/-- Every order ideal of a preordered abelian group is order-connected. -/
theorem ordConnected (I : OrderIdeal G) : (I : Set G).OrdConnected :=
  (isHereditary_iff_ordConnected (s := I)).1 I.isHereditary

/-- Order-convexity of an order ideal: `a ≤ x ≤ b` with `a, b ∈ I` implies `x ∈ I`. -/
theorem convex (I : OrderIdeal G) {a b x : G} (ha : a ∈ I) (hb : b ∈ I)
    (h₁ : a ≤ x) (h₂ : x ≤ b) : x ∈ I :=
  I.ordConnected.out ha hb ⟨h₁, h₂⟩

/-- Every element of an order ideal is a difference of two nonnegative elements of the ideal. -/
theorem exists_sub_nonneg_mem (I : OrderIdeal G) {x : G} (hx : x ∈ I) :
    ∃ a b : G, a ∈ I ∧ 0 ≤ a ∧ b ∈ I ∧ 0 ≤ b ∧ a - b = x := by
  obtain ⟨y, hy, hy0, hxy⟩ := I.exists_nonneg_le hx
  exact ⟨y, y - x, hy, hy0, sub_mem hy hx, sub_nonneg.2 hxy, sub_sub_cancel y x⟩

/-- Two order ideals are equal iff they have the same nonnegative elements. -/
theorem ext_nonneg {I J : OrderIdeal G} (h : ∀ x : G, 0 ≤ x → (x ∈ I ↔ x ∈ J)) :
    I = J := by
  ext x
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · obtain ⟨a, b, ha, ha0, hb, hb0, rfl⟩ := I.exists_sub_nonneg_mem hx
    exact sub_mem ((h a ha0).1 ha) ((h b hb0).1 hb)
  · obtain ⟨a, b, ha, ha0, hb, hb0, rfl⟩ := J.exists_sub_nonneg_mem hx
    exact sub_mem ((h a ha0).2 ha) ((h b hb0).2 hb)

/-- Construct an order ideal from an additive subgroup that is hereditary and bounds every element
above by a nonnegative member. -/
def ofDirected (H : AddSubgroup G) (hdir : ∀ x ∈ H, ∃ y ∈ H, 0 ≤ y ∧ x ≤ y)
    (hher : IsHereditary H) : OrderIdeal G where
  toAddSubgroup := H
  directedOn' x hx y hy := by
    obtain ⟨x', hx', hx'0, hxx'⟩ := hdir x hx
    obtain ⟨y', hy', hy'0, hyy'⟩ := hdir y hy
    exact ⟨x' + y', add_mem hx' hy', hxx'.trans (le_add_of_nonneg_right hy'0),
      hyy'.trans (le_add_of_nonneg_left hx'0)⟩
  isHereditary' := hher

end Preorder

section Bounds

variable {G : Type*} [AddCommGroup G]

/-- The trivial subgroup `{0}` is an order ideal in any partially ordered abelian group. -/
instance [PartialOrder G] : Bot (OrderIdeal G) where
  bot :=
    { toAddSubgroup := ⊥
      directedOn' := fun x hx y hy ↦ by
        change x ∈ (⊥ : AddSubgroup G) at hx
        change y ∈ (⊥ : AddSubgroup G) at hy
        rw [AddSubgroup.mem_bot] at hx hy
        exact ⟨0, zero_mem (⊥ : AddSubgroup G), by simp [hx], by simp [hy]⟩
      isHereditary' := isHereditary_def.2 fun a b ha0 ha hb ↦ by
        rw [AddSubgroup.mem_bot] at hb ⊢
        exact le_antisymm (hb ▸ ha) ha0 }

@[simp]
theorem mem_bot [PartialOrder G] {x : G} : x ∈ (⊥ : OrderIdeal G) ↔ x = 0 :=
  Iff.rfl

@[simp]
theorem bot_toAddSubgroup [PartialOrder G] : (⊥ : OrderIdeal G).toAddSubgroup = ⊥ :=
  rfl

instance [PartialOrder G] : OrderBot (OrderIdeal G) where
  bot_le I _ hx := (mem_bot.1 hx) ▸ zero_mem I

/-- Every nonzero order ideal of a partially ordered abelian group contains a strictly positive
element. -/
theorem exists_pos_mem_of_ne_bot [PartialOrder G] [IsOrderedAddMonoid G]
    {I : OrderIdeal G} (hI : I ≠ ⊥) : ∃ p ∈ I, 0 < p := by
  have hnot : ¬ I ≤ ⊥ := fun h ↦ hI (le_bot_iff.1 h)
  obtain ⟨x, hx, hx0⟩ := Set.not_subset.1 hnot
  rw [SetLike.mem_coe, mem_bot] at hx0
  obtain ⟨y, hy, hy0, hxy⟩ := I.exists_nonneg_le hx
  rcases eq_or_lt_of_le hy0 with rfl | hypos
  · exact ⟨-x, neg_mem hx, lt_of_le_of_ne (neg_nonneg.2 hxy) (neg_ne_zero.2 hx0).symm⟩
  · exact ⟨y, hy, hypos⟩

/-- In a directed ordered abelian group, the whole group is an order ideal `⊤`. -/
instance [Preorder G] [IsDirectedOrder G] : Top (OrderIdeal G) where
  top :=
    { toAddSubgroup := ⊤
      directedOn' := fun a _ b _ ↦ by
        obtain ⟨c, hac, hbc⟩ := exists_ge_ge a b
        exact ⟨c, trivial, hac, hbc⟩
      isHereditary' := isHereditary_def.2 fun _ _ _ _ _ ↦ trivial }

@[simp]
theorem mem_top [Preorder G] [IsDirectedOrder G] {x : G} : x ∈ (⊤ : OrderIdeal G) :=
  trivial

@[simp]
theorem top_toAddSubgroup [Preorder G] [IsDirectedOrder G] :
    (⊤ : OrderIdeal G).toAddSubgroup = ⊤ :=
  rfl

instance [Preorder G] [IsDirectedOrder G] : OrderTop (OrderIdeal G) where
  le_top _ _ _ := trivial

instance [PartialOrder G] [IsDirectedOrder G] : BoundedOrder (OrderIdeal G) where

/-- Any order ideal containing an order unit is the whole group. -/
theorem eq_top_of_isAddOrderUnit_mem [Preorder G] [IsOrderedAddMonoid G] [IsDirectedOrder G]
    {I : OrderIdeal G} {u : G} (hu : IsAddOrderUnit u) (huI : u ∈ I) : I = ⊤ := by
  refine top_unique fun g _ ↦ ?_
  obtain ⟨n, hlo, hhi⟩ := hu.exists_neg_nsmul_le_le_nsmul g
  exact I.convex (neg_mem (nsmul_mem huI n)) (nsmul_mem huI n) hlo hhi

end Bounds

section Iso

variable {G H : Type*} [AddCommGroup G] [Preorder G] [AddCommGroup H] [Preorder H]

/-- Preimage of an order ideal under an ordered additive isomorphism. -/
def comap (I : OrderIdeal H) (e : G ≃+o H) : OrderIdeal G where
  toAddSubgroup := AddSubgroup.comap (e.toAddEquiv : G →+ H) I.toAddSubgroup
  directedOn' x hx y hy := by
    obtain ⟨z, hz, hxz, hyz⟩ := I.directedOn (e x) hx (e y) hy
    refine ⟨e.symm z, by simpa using hz, ?_, ?_⟩
    · simpa using OrderHomClass.mono e.symm hxz
    · simpa using OrderHomClass.mono e.symm hyz
  isHereditary' := isHereditary_def.2 fun a b ha hab hb ↦ by
    refine I.mem_of_nonneg_of_le ?_ (OrderHomClass.mono e hab) hb
    simpa using OrderHomClass.mono e ha

@[simp]
theorem mem_comap {I : OrderIdeal H} {e : G ≃+o H} {x : G} :
    x ∈ I.comap e ↔ e x ∈ I :=
  Iff.rfl

/-- Forward image of an order ideal under an ordered additive isomorphism. -/
def map (I : OrderIdeal G) (e : G ≃+o H) : OrderIdeal H :=
  I.comap e.symm

@[simp]
theorem mem_map {I : OrderIdeal G} {e : G ≃+o H} {y : H} :
    y ∈ I.map e ↔ e.symm y ∈ I :=
  Iff.rfl

theorem map_apply_mem_iff {I : OrderIdeal G} {e : G ≃+o H} {x : G} :
    e x ∈ I.map e ↔ x ∈ I := by
  simp

/-- An ordered additive isomorphism induces an order isomorphism between posets of order ideals. -/
def _root_.OrderAddMonoidIso.orderIdealCongr (e : G ≃+o H) : OrderIdeal G ≃o OrderIdeal H where
  toFun I := I.map e
  invFun J := J.comap e
  left_inv I := by ext x; simp
  right_inv J := by ext y; simp
  map_rel_iff' {I₁ I₂} := by
    refine ⟨fun h x hx ↦ ?_, fun h y hy ↦ h hy⟩
    exact map_apply_mem_iff.1 (h (map_apply_mem_iff.2 hx))

end Iso

section Closure

variable {G : Type*} [AddCommGroup G] [PartialOrder G] [IsOrderedAddMonoid G]

/-- The smallest order ideal containing a given set `S` of nonnegative elements: the elements
bounded in absolute value `[-s, s]` by some element `s` of the additive submonoid generated by
`S`. -/
def closure (S : Set G) (hS : ∀ s ∈ S, 0 ≤ s) : OrderIdeal G where
  toAddSubgroup :=
    { carrier := { g : G | ∃ s ∈ AddSubmonoid.closure S, -s ≤ g ∧ g ≤ s }
      zero_mem' := ⟨0, zero_mem _, by simp⟩
      add_mem' := fun {x y} ⟨s, hs, hsx, hxs⟩ ⟨t, ht, hty, hyt⟩ ↦
        ⟨s + t, add_mem hs ht, by rw [neg_add]; exact add_le_add hsx hty, add_le_add hxs hyt⟩
      neg_mem' := fun {x} ⟨s, hs, hsx, hxs⟩ ↦
        ⟨s, hs, neg_le_neg hxs, neg_le.1 hsx⟩ }
  directedOn' := by
    rintro x ⟨s, hs, _, hxs⟩ y ⟨t, ht, _, hyt⟩
    have hs0 : 0 ≤ s := (AddSubmonoid.closure_le (S := AddSubmonoid.nonneg G)).2 hS hs
    have ht0 : 0 ≤ t := (AddSubmonoid.closure_le (S := AddSubmonoid.nonneg G)).2 hS ht
    have hst0 : 0 ≤ s + t := add_nonneg hs0 ht0
    exact ⟨s + t, ⟨s + t, add_mem hs ht, (neg_nonpos.2 hst0).trans hst0, le_rfl⟩,
      hxs.trans (le_add_of_nonneg_right ht0), hyt.trans (le_add_of_nonneg_left hs0)⟩
  isHereditary' := isHereditary_def.2 fun a b ha hab ⟨s, hs, _, hbs⟩ ↦ by
    have hs0 : 0 ≤ s := (AddSubmonoid.closure_le (S := AddSubmonoid.nonneg G)).2 hS hs
    exact ⟨s, hs, (neg_nonpos.2 hs0).trans ha, hab.trans hbs⟩

theorem mem_closure {S : Set G} {hS : ∀ s ∈ S, 0 ≤ s} {g : G} :
    g ∈ closure S hS ↔ ∃ s ∈ AddSubmonoid.closure S, -s ≤ g ∧ g ≤ s :=
  Iff.rfl

/-- Every element of `S` lies in `closure S hS`. -/
theorem subset_closure {S : Set G} (hS : ∀ s ∈ S, 0 ≤ s) : S ⊆ closure S hS := by
  intro s hs
  exact ⟨s, AddSubmonoid.subset_closure hs, (neg_nonpos.2 (hS s hs)).trans (hS s hs), le_rfl⟩

/-- Universal property of `closure`: `closure S hS ≤ I` iff `S ⊆ I`. -/
@[simp]
theorem closure_le {S : Set G} {hS : ∀ s ∈ S, 0 ≤ s} {I : OrderIdeal G} :
    closure S hS ≤ I ↔ S ⊆ I := by
  refine ⟨fun h ↦ (subset_closure hS).trans h, fun hSI g ⟨s, hs, hsg, hgs⟩ ↦ ?_⟩
  have hsI : s ∈ I := (AddSubmonoid.closure_le (M := G)).2 hSI hs
  exact I.convex (neg_mem hsI) hsI hsg hgs

/-- Membership in the order ideal generated by a single nonnegative element `u`: the elements
lying in `[-n • u, n • u]` for some `n : ℕ`. -/
theorem mem_closure_singleton {u : G} (hu : 0 ≤ u) {g : G} :
    g ∈ closure {u} (by simp [hu]) ↔ ∃ n : ℕ, -(n • u) ≤ g ∧ g ≤ n • u := by
  simp only [mem_closure, AddSubmonoid.mem_closure_singleton]
  refine ⟨fun ⟨_, ⟨n, hn⟩, h⟩ ↦ ⟨n, hn ▸ h⟩,
    fun ⟨n, h⟩ ↦ ⟨n • u, ⟨n, rfl⟩, h⟩⟩

/-- In a directed ordered abelian group, the order ideal generated by `u ≥ 0` is `⊤` iff `u` is
an order unit. -/
theorem closure_singleton_eq_top_iff [IsDirectedOrder G] {u : G} (hu : 0 ≤ u) :
    closure {u} (by simp [hu]) = ⊤ ↔ IsAddOrderUnit u := by
  refine ⟨fun htop ↦ ⟨hu, fun g ↦ ?_⟩, fun hu' ↦ ?_⟩
  · have hg : g ∈ closure {u} (by simp [hu]) := htop ▸ mem_top
    exact ((mem_closure_singleton hu).1 hg).imp fun _ hn ↦ hn.2
  · exact eq_top_of_isAddOrderUnit_mem hu' (subset_closure _ rfl)

end Closure

section Lattice

variable {G : Type*} [AddCommGroup G] [PartialOrder G] [IsOrderedAddMonoid G]

/-- Intersection of two order ideals, which is again an order ideal under Riesz interpolation. -/
def inf (h : HasRieszInterpolation G) (I J : OrderIdeal G) : OrderIdeal G where
  toAddSubgroup := I.toAddSubgroup ⊓ J.toAddSubgroup
  directedOn' x hx y hy := by
    obtain ⟨a, haI, hxa, hya⟩ := I.directedOn x hx.1 y hy.1
    obtain ⟨b, hbJ, hxb, hyb⟩ := J.directedOn x hx.2 y hy.2
    obtain ⟨c, hxc, hyc, hca, hcb⟩ := h.exists_ge_ge_le_le hxa hxb hya hyb
    exact ⟨c, ⟨I.convex hx.1 haI hxc hca, J.convex hx.2 hbJ hxc hcb⟩, hxc, hyc⟩
  isHereditary' := isHereditary_def.2 fun _ _ ha hab hb ↦
    ⟨I.mem_of_nonneg_of_le ha hab hb.1, J.mem_of_nonneg_of_le ha hab hb.2⟩

@[simp]
theorem mem_inf (h : HasRieszInterpolation G) {I J : OrderIdeal G} {x : G} :
    x ∈ inf h I J ↔ x ∈ I ∧ x ∈ J :=
  Iff.rfl

theorem inf_le_left (h : HasRieszInterpolation G) (I J : OrderIdeal G) : inf h I J ≤ I :=
  fun _ hx ↦ hx.1

theorem inf_le_right (h : HasRieszInterpolation G) (I J : OrderIdeal G) : inf h I J ≤ J :=
  fun _ hx ↦ hx.2

theorem le_inf (h : HasRieszInterpolation G) {K I J : OrderIdeal G}
    (hI : K ≤ I) (hJ : K ≤ J) : K ≤ inf h I J :=
  fun _ hx ↦ ⟨hI hx, hJ hx⟩

/-- Subgroup sum of two order ideals, which is an order ideal under Riesz interpolation. -/
def sup (h : HasRieszInterpolation G) (I J : OrderIdeal G) : OrderIdeal G where
  toAddSubgroup := I.toAddSubgroup ⊔ J.toAddSubgroup
  directedOn' x hx y hy := by
    obtain ⟨a₁, ha₁, b₁, hb₁, rfl⟩ := AddSubgroup.mem_sup.1 hx
    obtain ⟨a₂, ha₂, b₂, hb₂, rfl⟩ := AddSubgroup.mem_sup.1 hy
    obtain ⟨a, haI, ha₁a, ha₂a⟩ := I.directedOn a₁ ha₁ a₂ ha₂
    obtain ⟨b, hbJ, hb₁b, hb₂b⟩ := J.directedOn b₁ hb₁ b₂ hb₂
    exact ⟨a + b, AddSubgroup.add_mem_sup haI hbJ,
      add_le_add ha₁a hb₁b, add_le_add ha₂a hb₂b⟩
  isHereditary' := isHereditary_def.2 fun g b hg hgb hb ↦ by
    obtain ⟨a, haI, c, hcJ, rfl⟩ := AddSubgroup.mem_sup.1 hb
    obtain ⟨a', ha'I, ha'0, haa'⟩ := I.exists_nonneg_le haI
    obtain ⟨c', hc'J, hc'0, hcc'⟩ := J.exists_nonneg_le hcJ
    obtain ⟨g₁, g₂, hg₁0, hg₁a', hg₂0, hg₂c', rfl⟩ :=
      h.exists_decomposition ha'0 hc'0 hg (hgb.trans (add_le_add haa' hcc'))
    exact AddSubgroup.add_mem_sup
      (I.mem_of_nonneg_of_le hg₁0 hg₁a' ha'I) (J.mem_of_nonneg_of_le hg₂0 hg₂c' hc'J)

theorem mem_sup (h : HasRieszInterpolation G) {I J : OrderIdeal G} {x : G} :
    x ∈ sup h I J ↔ ∃ a ∈ I, ∃ b ∈ J, a + b = x :=
  AddSubgroup.mem_sup

theorem le_sup_left (h : HasRieszInterpolation G) (I J : OrderIdeal G) : I ≤ sup h I J :=
  _root_.le_sup_left (a := I.toAddSubgroup) (b := J.toAddSubgroup)

theorem le_sup_right (h : HasRieszInterpolation G) (I J : OrderIdeal G) : J ≤ sup h I J :=
  _root_.le_sup_right (a := I.toAddSubgroup) (b := J.toAddSubgroup)

theorem sup_le (h : HasRieszInterpolation G) {I J K : OrderIdeal G}
    (hI : I ≤ K) (hJ : J ≤ K) : sup h I J ≤ K :=
  _root_.sup_le (a := I.toAddSubgroup) (b := J.toAddSubgroup) hI hJ

omit [IsOrderedAddMonoid G] in
private theorem iSup_eq_closure (S : Set (OrderIdeal G)) :
    (⨆ I ∈ S, I.toAddSubgroup : AddSubgroup G) =
      AddSubgroup.closure (⋃ I ∈ S, (I : Set G)) := by
  refine le_antisymm ?_ ?_
  · refine _root_.iSup₂_le fun I hIS x hx ↦ AddSubgroup.subset_closure ?_
    exact Set.mem_iUnion₂.2 ⟨I, hIS, hx⟩
  · refine (AddSubgroup.closure_le _).2 (Set.iUnion₂_subset fun I hIS ↦ ?_)
    exact _root_.le_biSup (fun K : OrderIdeal G ↦ K.toAddSubgroup) hIS

private theorem sSup_directedOn (S : Set (OrderIdeal G)) :
    DirectedOn (· ≤ ·) ((⨆ I ∈ S, I.toAddSubgroup : AddSubgroup G) : Set G) := by
  let K : AddSubgroup G := ⨆ I ∈ S, I.toAddSubgroup
  have hK : K = AddSubgroup.closure (⋃ I ∈ S, (I : Set G)) := iSup_eq_closure S
  have hbound : ∀ x ∈ K, ∃ y ∈ K, 0 ≤ y ∧ x ≤ y ∧ -x ≤ y := by
    intro x hx
    rw [hK] at hx
    induction hx using AddSubgroup.closure_induction with
    | mem z hz =>
      simp only [Set.mem_iUnion, SetLike.mem_coe, exists_prop] at hz
      obtain ⟨I, hIS, hzI⟩ := hz
      obtain ⟨y₁, hy₁, hy₁0, hzy₁⟩ := I.exists_nonneg_le hzI
      obtain ⟨y₂, hy₂, hy₂0, hnzy₂⟩ := I.exists_nonneg_le (neg_mem hzI)
      have hymem : y₁ + y₂ ∈ K := by
        rw [hK]
        exact AddSubgroup.subset_closure <| Set.mem_iUnion₂.2 ⟨I, hIS, add_mem hy₁ hy₂⟩
      exact ⟨y₁ + y₂, hymem, add_nonneg hy₁0 hy₂0,
        hzy₁.trans (le_add_of_nonneg_right hy₂0),
        hnzy₂.trans (le_add_of_nonneg_left hy₁0)⟩
    | zero => exact ⟨0, zero_mem K, le_rfl, le_rfl, by simp⟩
    | add x₁ x₂ _ _ ih₁ ih₂ =>
      obtain ⟨y₁, hy₁, hy₁0, hx₁, hnx₁⟩ := ih₁
      obtain ⟨y₂, hy₂, hy₂0, hx₂, hnx₂⟩ := ih₂
      refine ⟨y₁ + y₂, add_mem hy₁ hy₂, add_nonneg hy₁0 hy₂0,
        add_le_add hx₁ hx₂, ?_⟩
      rw [neg_add_rev, add_comm (-x₂) (-x₁)]
      exact add_le_add hnx₁ hnx₂
    | neg x _ ih =>
      obtain ⟨y, hy, hy0, hx, hnx⟩ := ih
      exact ⟨y, hy, hy0, hnx, by simpa using hx⟩
  intro x hx y hy
  obtain ⟨u, hu, hu0, hxu, _⟩ := hbound x hx
  obtain ⟨v, hv, hv0, hyv, _⟩ := hbound y hy
  exact ⟨u + v, add_mem hu hv, hxu.trans (le_add_of_nonneg_right hv0),
    hyv.trans (le_add_of_nonneg_left hu0)⟩

private theorem sSup_exists_le_mem_closure (S : Set (OrderIdeal G))
    {x : G} (hx : x ∈ (⨆ I ∈ S, I.toAddSubgroup : AddSubgroup G)) :
    ∃ c ∈ AddSubmonoid.closure (⋃ I ∈ S, { z : G | z ∈ I ∧ 0 ≤ z }),
      x ≤ c ∧ -x ≤ c := by
  rw [iSup_eq_closure] at hx
  induction hx using AddSubgroup.closure_induction with
  | mem z hz =>
    simp only [Set.mem_iUnion, SetLike.mem_coe, exists_prop] at hz
    obtain ⟨I, hIS, hzI⟩ := hz
    obtain ⟨y₁, hy₁, hy₁0, hzy₁⟩ := I.exists_nonneg_le hzI
    obtain ⟨y₂, hy₂, hy₂0, hnzy₂⟩ := I.exists_nonneg_le (neg_mem hzI)
    refine ⟨y₁ + y₂,
      add_mem (AddSubmonoid.subset_closure ?_) (AddSubmonoid.subset_closure ?_),
      hzy₁.trans (le_add_of_nonneg_right hy₂0), hnzy₂.trans (le_add_of_nonneg_left hy₁0)⟩
    · exact Set.mem_iUnion₂.2 ⟨I, hIS, hy₁, hy₁0⟩
    · exact Set.mem_iUnion₂.2 ⟨I, hIS, hy₂, hy₂0⟩
  | zero => exact ⟨0, zero_mem _, le_rfl, by simp⟩
  | add x₁ x₂ _ _ ih₁ ih₂ =>
    obtain ⟨c₁, hc₁, hx₁, hnx₁⟩ := ih₁
    obtain ⟨c₂, hc₂, hx₂, hnx₂⟩ := ih₂
    refine ⟨c₁ + c₂, add_mem hc₁ hc₂, add_le_add hx₁ hx₂, ?_⟩
    rw [neg_add_rev, add_comm (-x₂) (-x₁)]
    exact add_le_add hnx₁ hnx₂
  | neg x _ ih =>
    obtain ⟨c, hc, hx, hnx⟩ := ih
    exact ⟨c, hc, hnx, by simpa using hx⟩

private theorem sSup_mem_of_nonneg_of_le_closure (h : HasRieszInterpolation G)
    (S : Set (OrderIdeal G)) {c g : G}
    (hc : c ∈ AddSubmonoid.closure (⋃ I ∈ S, { z : G | z ∈ I ∧ 0 ≤ z }))
    (hg : 0 ≤ g) (hgc : g ≤ c) : g ∈ (⨆ I ∈ S, I.toAddSubgroup : AddSubgroup G) := by
  have hP_nonneg :
      ∀ z ∈ AddSubmonoid.closure (⋃ I ∈ S, { z : G | z ∈ I ∧ 0 ≤ z }), 0 ≤ z := by
    refine (AddSubmonoid.closure_le (S := AddSubmonoid.nonneg G)).2 fun z hz ↦ ?_
    obtain ⟨I, _, _, hz0⟩ := Set.mem_iUnion₂.1 hz
    exact hz0
  induction hc using AddSubmonoid.closure_induction generalizing g with
  | mem z hz =>
    obtain ⟨I, hIS, hzI, _⟩ := Set.mem_iUnion₂.1 hz
    have hgI : g ∈ I := I.mem_of_nonneg_of_le hg hgc hzI
    exact (_root_.le_biSup (fun I : OrderIdeal G ↦ I.toAddSubgroup) hIS) hgI
  | zero =>
    obtain rfl : g = 0 := le_antisymm hgc hg
    exact zero_mem _
  | add c₁ c₂ hc₁ hc₂ ih₁ ih₂ =>
    obtain ⟨g₁, g₂, hg₁, hgc₁, hg₂, hgc₂, rfl⟩ :=
      h.exists_decomposition (hP_nonneg c₁ hc₁) (hP_nonneg c₂ hc₂) hg hgc
    exact add_mem (ih₁ hg₁ hgc₁) (ih₂ hg₂ hgc₂)

/-- Supremum of an arbitrary family of order ideals under Riesz interpolation. -/
def sSup (h : HasRieszInterpolation G) (S : Set (OrderIdeal G)) : OrderIdeal G where
  toAddSubgroup := ⨆ I ∈ S, I.toAddSubgroup
  directedOn' := sSup_directedOn S
  isHereditary' := isHereditary_def.2 fun g b hg hgb hb ↦ by
    obtain ⟨c, hc, hbc, _⟩ := sSup_exists_le_mem_closure S hb
    exact sSup_mem_of_nonneg_of_le_closure h S hc hg (hgb.trans hbc)

theorem le_sSup (h : HasRieszInterpolation G) {S : Set (OrderIdeal G)} {I : OrderIdeal G}
    (hI : I ∈ S) : I ≤ sSup h S :=
  _root_.le_biSup (fun K : OrderIdeal G ↦ K.toAddSubgroup) hI

theorem sSup_le (h : HasRieszInterpolation G) {S : Set (OrderIdeal G)} {J : OrderIdeal G}
    (hJ : ∀ I ∈ S, I ≤ J) : sSup h S ≤ J := by
  change (⨆ I ∈ S, I.toAddSubgroup) ≤ J.toAddSubgroup
  exact _root_.iSup₂_le fun I hI ↦ hJ I hI

private theorem inf_sup_le (h : HasRieszInterpolation G) (I J K : OrderIdeal G) :
    inf h I (sup h J K) ≤ sup h (inf h I J) (inf h I K) := by
  intro x hx
  suffices hpos : ∀ g ∈ inf h I (sup h J K), 0 ≤ g → g ∈ sup h (inf h I J) (inf h I K) by
    obtain ⟨a, b, ha, ha0, hb, hb0, rfl⟩ := (inf h I (sup h J K)).exists_sub_nonneg_mem hx
    exact sub_mem (hpos a ha ha0) (hpos b hb hb0)
  intro g ⟨hgI, hgJK⟩ hg0
  obtain ⟨b, hbJ, c, hcK, hbc⟩ := (mem_sup h).1 hgJK
  obtain ⟨b', hb'J, hb'0, hbb'⟩ := J.exists_nonneg_le hbJ
  obtain ⟨c', hc'K, hc'0, hcc'⟩ := K.exists_nonneg_le hcK
  have hgbc : g ≤ b' + c' := hbc.symm.trans_le (add_le_add hbb' hcc')
  obtain ⟨g₁, g₂, hg₁0, hg₁b', hg₂0, hg₂c', rfl⟩ :=
    h.exists_decomposition hb'0 hc'0 hg0 hgbc
  have hg₁I : g₁ ∈ I :=
    I.mem_of_nonneg_of_le hg₁0 (le_add_of_le_of_nonneg le_rfl hg₂0) hgI
  have hg₂I : g₂ ∈ I := I.mem_of_nonneg_of_le hg₂0 (le_add_of_nonneg_left hg₁0) hgI
  exact (mem_sup h).2 ⟨g₁, ⟨hg₁I, J.mem_of_nonneg_of_le hg₁0 hg₁b' hb'J⟩,
    g₂, ⟨hg₂I, K.mem_of_nonneg_of_le hg₂0 hg₂c' hc'K⟩, rfl⟩

/-- Under Riesz interpolation, order ideals form a distributive lattice with intersection as `⊓`
and subgroup sum as `⊔`. -/
@[instance_reducible]
def distribLattice (h : HasRieszInterpolation G) : DistribLattice (OrderIdeal G) :=
  letI : Lattice (OrderIdeal G) :=
    { inf := inf h
      sup := sup h
      inf_le_left := inf_le_left h
      inf_le_right := inf_le_right h
      le_inf := fun _ _ _ ↦ le_inf h
      le_sup_left := le_sup_left h
      le_sup_right := le_sup_right h
      sup_le := fun _ _ _ ↦ sup_le h }
  { le_sup_inf x y z := by
      calc (x ⊔ y) ⊓ (x ⊔ z)
          ≤ ((x ⊔ y) ⊓ x) ⊔ ((x ⊔ y) ⊓ z) := inf_sup_le h (x ⊔ y) x z
        _ = x ⊔ (z ⊓ (x ⊔ y)) := by
            rw [_root_.inf_of_le_right (_root_.le_sup_left : x ≤ x ⊔ y), inf_comm (x ⊔ y) z]
        _ ≤ x ⊔ ((z ⊓ x) ⊔ (z ⊓ y)) := sup_le_sup_left (inf_sup_le h z x y) x
        _ ≤ x ⊔ (x ⊔ (y ⊓ z)) := by
            refine sup_le_sup_left (sup_le_sup _root_.inf_le_right ?_) x
            rw [inf_comm z y]
        _ = x ⊔ (y ⊓ z) := by rw [← sup_assoc, sup_idem] }

/-- In a directed ordered abelian group with Riesz interpolation, order ideals form a complete
lattice. -/
@[instance_reducible]
def completeLattice (h : HasRieszInterpolation G) [IsDirectedOrder G] :
    CompleteLattice (OrderIdeal G) where
  __ := distribLattice h
  le_top _ := le_top
  bot_le _ := _root_.bot_le
  sSup := sSup h
  isLUB_sSup _ := ⟨fun _ hI ↦ le_sSup h hI, fun _ hJ ↦ sSup_le h hJ⟩
  sInf S := sSup h { K | ∀ I ∈ S, K ≤ I }
  isGLB_sInf _ := ⟨fun _ hI ↦ sSup_le h fun _ hK ↦ hK _ hI, fun _ hK ↦ le_sSup h hK⟩

end Lattice

section Simple

variable {G : Type*} [AddCommGroup G] [PartialOrder G] [IsOrderedAddMonoid G] [IsDirectedOrder G]

/-- A directed partially ordered abelian group has no nontrivial proper order ideals iff it is
nontrivial and every strictly positive element is an order unit. -/
theorem isSimpleOrder_iff_forall_pos_isAddOrderUnit :
    IsSimpleOrder (OrderIdeal G) ↔ Nontrivial G ∧ ∀ g : G, 0 < g → IsAddOrderUnit g := by
  refine ⟨fun hsimple ↦ ⟨?_, fun g hg ↦ ?_⟩, fun ⟨_, hunit⟩ ↦ ?_⟩
  · obtain ⟨I, J, hIJ⟩ := hsimple.exists_pair_ne
    by_contra hsub
    rw [not_nontrivial_iff_subsingleton] at hsub
    apply hIJ
    ext x
    simp [Subsingleton.elim x 0]
  · have hne : closure {g} (by simp [hg.le]) ≠ ⊥ := by
      intro hbot
      have hmem : g ∈ (⊥ : OrderIdeal G) := hbot ▸ subset_closure _ rfl
      exact hg.ne' (mem_bot.1 hmem)
    have htop : closure {g} (by simp [hg.le]) = ⊤ :=
      (eq_bot_or_eq_top _).resolve_left hne
    exact (closure_singleton_eq_top_iff hg.le).1 htop
  · refine { exists_pair_ne := ⟨⊥, ⊤, fun hbot ↦ ?_⟩, eq_bot_or_eq_top := fun I ↦ ?_ }
    · obtain ⟨g, hg⟩ := exists_ne (0 : G)
      exact hg (mem_bot.1 (hbot ▸ (mem_top : g ∈ (⊤ : OrderIdeal G))))
    · by_cases hbot : I = ⊥
      · exact Or.inl hbot
      · right
        obtain ⟨p, hpI, hp0⟩ := exists_pos_mem_of_ne_bot hbot
        exact eq_top_of_isAddOrderUnit_mem (hunit p hp0) hpI

end Simple

