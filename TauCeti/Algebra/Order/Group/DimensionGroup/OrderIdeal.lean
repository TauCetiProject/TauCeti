/-!
# Order ideals of partially ordered abelian groups

An *order ideal* of a partially ordered abelian group `G` is an additive subgroup `I` of `G` that
is upward directed (equivalently, generated by its positive elements) and order-hereditary in the
positive cone (`0 ≤ a ≤ b` with `b ∈ I` implies `a ∈ I`, equivalently `I` is
order-connected).

Under Riesz interpolation, order ideals form a distributive lattice (`OrderIdeal.distribLattice`)
with intersection as infimum and subgroup sum as supremum, and in fact a complete lattice
(`OrderIdeal.completeLattice`) whose top element `⊤` is the subgroup `G⁺ - G⁺` generated by the
positive cone (`OrderIdeal.top_toAddSubgroup`; equal to the whole group when `G` is directed,
`OrderIdeal.top_toAddSubgroup_of_isDirectedOrder`). A directed partially ordered abelian group has
exactly two distinct order ideals (`⊥` and `⊤`) if and only if it is nontrivial and every
strictly positive element is an order unit (`isSimpleOrder_iff_forall_pos_isNatOrderUnit`).

## Main definitions

* `TauCeti.OrderIdeal G`: directed, hereditary additive subgroup of `G`.
* `TauCeti.OrderIdeal.closure`: the smallest order ideal containing a given set of nonnegative
  elements.
* `TauCeti.OrderIdeal.inf`, `TauCeti.OrderIdeal.sup`, `TauCeti.OrderIdeal.sSup`: lattice
  operations under Riesz interpolation.
* `TauCeti.OrderIdeal.distribLattice` and `TauCeti.OrderIdeal.completeLattice`: the lattice
  structure on `OrderIdeal G` under Riesz interpolation.

## Main results

* `TauCeti.OrderIdeal.ordConnected`: every order ideal is order-connected.
* `TauCeti.OrderIdeal.ext_nonneg`: an order ideal is determined by its nonnegative elements.
* `TauCeti.OrderIdeal.closure_singleton_eq_top_iff`: in a directed group, the order ideal
  generated by `u ≥ 0` is `⊤` iff `u` is an order unit.
* `TauCeti.OrderIdeal.isSimpleOrder_iff_forall_pos_isNatOrderUnit`: in a directed group,
  simplicity of `OrderIdeal G` iff `G` is nontrivial and every strictly positive element is an
  order unit.

## References

* K. R. Goodearl, *Partially ordered abelian groups with interpolation*, Mathematical Surveys
  and Monographs 20, AMS, 1986, Chapters 1–2.
* M. Rørdam, *Classification of nuclear C⋆-algebras*, Encyclopaedia of Mathematical Sciences
  126, Springer, 2002, §§1.4–1.5.
-/

public section

namespace TauCeti

section Defs

/-- An *order ideal* of an ordered abelian group `G`: an upward-directed additive subgroup that
is hereditary in the positive cone (`0 ≤ a ≤ b` and `b ∈ I` force `a ∈ I`). -/
structure OrderIdeal (G : Type*) [AddCommGroup G] [LE G] extends AddSubgroup G where
  /-- An order ideal is upward directed. -/
  directedOn' : DirectedOn (· ≤ ·) carrier
  /-- An order ideal is hereditary in the positive cone. -/
  isHereditary' : IsHereditary toAddSubgroup

end Defs

namespace OrderIdeal

section Basic

variable {G : Type*} [AddCommGroup G] [LE G]

instance : SetLike (OrderIdeal G) G where
  coe I := I.carrier
  coe_injective := by
    intro ⟨I₁, _, _⟩ ⟨I₂, _, _⟩ h
    congr 1
    exact AddSubgroup.ext (Set.ext_iff.mp h)

instance : AddSubgroupClass (OrderIdeal G) G where
  add_mem {I} := I.toAddSubgroup.add_mem'
  zero_mem {I} := I.toAddSubgroup.zero_mem'
  neg_mem {I} := I.toAddSubgroup.neg_mem'

@[ext]
theorem ext {I J : OrderIdeal G} (h : ∀ x, x ∈ I ↔ x ∈ J) : I = J :=
  SetLike.ext h

/-- Order ideals are ordered by inclusion. -/
instance : PartialOrder (OrderIdeal G) :=
  PartialOrder.ofSetLike (OrderIdeal G)

/-- Membership in the underlying subgroup is membership in the order ideal. -/
@[simp]
theorem mem_toAddSubgroup {I : OrderIdeal G} {x : G} : x ∈ I.toAddSubgroup ↔ x ∈ I :=
  Iff.rfl

/-- The underlying subgroup has the same underlying set. -/
@[simp]
theorem coe_toAddSubgroup (I : OrderIdeal G) : ((I.toAddSubgroup : AddSubgroup G) : Set G) = I :=
  rfl

/-- Inclusion of order ideals is inclusion of their underlying subgroups. -/
@[simp]
theorem toAddSubgroup_le {I J : OrderIdeal G} : I.toAddSubgroup ≤ J.toAddSubgroup ↔ I ≤ J :=
  Iff.rfl

/-- Strict inclusion of order ideals is strict inclusion of their underlying subgroups. -/
@[simp]
theorem toAddSubgroup_lt {I J : OrderIdeal G} : I.toAddSubgroup < J.toAddSubgroup ↔ I < J := by
  simp [lt_iff_le_not_ge, toAddSubgroup_le]

/-- An order ideal is determined by its underlying additive subgroup. -/
theorem toAddSubgroup_injective : Function.Injective (toAddSubgroup (G := G)) := by
  intro I J h
  ext x
  rw [← mem_toAddSubgroup, ← mem_toAddSubgroup, h]

/-- Two order ideals are equal iff their underlying subgroups are equal. -/
@[simp]
theorem toAddSubgroup_inj {I J : OrderIdeal G} : I.toAddSubgroup = J.toAddSubgroup ↔ I = J :=
  toAddSubgroup_injective.eq_iff

/-- An order ideal is upward directed. -/
theorem directedOn (I : OrderIdeal G) : DirectedOn (· ≤ ·) (I : Set G) :=
  I.directedOn'

/-- An order ideal is hereditary in the positive cone. -/
theorem isHereditary (I : OrderIdeal G) : IsHereditary I :=
  (isHereditary_congr (I.coe_toAddSubgroup)).1 I.isHereditary'

/-- Every element of an order ideal is dominated by a nonnegative element of the ideal. -/
theorem exists_nonneg_le (I : OrderIdeal G) {x : G} (hx : x ∈ I) :
    ∃ y ∈ I, 0 ≤ y ∧ x ≤ y :=
  I.directedOn 0 (zero_mem I) x hx

end Basic

section Preorder

variable {G : Type*} [AddCommGroup G] [Preorder G]

/-- Viewing an order ideal as a subtype gives an upward-directed ordered type. -/
instance isDirectedOrder (I : OrderIdeal G) : IsDirectedOrder I :=
  I.directedOn.isDirectedOrder

variable [IsOrderedAddMonoid G]

/-- Every order ideal of a preordered abelian group is order-connected. -/
theorem ordConnected (I : OrderIdeal G) : (I : Set G).OrdConnected :=
  (isHereditary_iff_ordConnected (s := I)).1 I.isHereditary

/-- Order-connectedness of an order ideal: `a ≤ x ≤ b` with `a, b ∈ I` implies `x ∈ I`. -/
theorem mem_of_le_of_le (I : OrderIdeal G) {a b x : G} (ha : a ∈ I) (hb : b ∈ I)
    (h₁ : a ≤ x) (h₂ : x ≤ b) : x ∈ I :=
  I.ordConnected.out ha hb ⟨h₁, h₂⟩

/-- Every element of an order ideal is a difference of two nonnegative elements of the ideal. -/
theorem exists_sub_nonneg_mem (I : OrderIdeal G) {x : G} (hx : x ∈ I) :
    ∃ a b : G, a ∈ I ∧ 0 ≤ a ∧ b ∈ I ∧ 0 ≤ b ∧ a - b = x := by
  obtain ⟨y, hy, hy0, hxy⟩ := I.exists_nonneg_le hx
  exact ⟨y, y - x, hy, hy0, sub_mem hy hx, sub_nonneg.2 hxy, sub_sub_cancel y x⟩

/-- An order ideal `I` is contained in `J` if every nonnegative element of `I` lies in `J`. -/
theorem le_of_forall_nonneg {I J : OrderIdeal G} (h : ∀ x : G, 0 ≤ x → x ∈ I → x ∈ J) :
    I ≤ J := by
  intro x hx
  obtain ⟨a, b, ha, ha0, hb, hb0, rfl⟩ := I.exists_sub_nonneg_mem hx
  exact sub_mem (h a ha0 ha) (h b hb0 hb)

/-- Two order ideals are equal iff they have the same nonnegative elements. -/
theorem ext_nonneg {I J : OrderIdeal G} (h : ∀ x : G, 0 ≤ x → (x ∈ I ↔ x ∈ J)) :
    I = J :=
  le_antisymm (le_of_forall_nonneg fun x hx ↦ (h x hx).1)
    (le_of_forall_nonneg fun x hx ↦ (h x hx).2)

/-- Construct an order ideal from an additive subgroup that is hereditary and bounds every element
above by a nonnegative member. -/
def ofDirected (H : AddSubgroup G) (hdir : ∀ x ∈ H, ∃ y ∈ H, 0 ≤ y ∧ x ≤ y)
    (hher : IsHereditary H) : OrderIdeal G where
  toAddSubgroup := H
  directedOn' x hx y hy := by
    obtain ⟨x', hx', hx'0, hxx'⟩ := hdir x hx
    obtain ⟨y', hy', hy'0, hyy'⟩ := hdir y hy
    exact ⟨x' + y', add_mem hx' hy', hxx'.trans (le_add_of_nonneg_right hy'0),
      hyy'.trans (le_add_of_nonneg_left hx'0)⟩
  isHereditary' := hher

@[simp]
theorem mem_ofDirected {H : AddSubgroup G} {hdir : ∀ x ∈ H, ∃ y ∈ H, 0 ≤ y ∧ x ≤ y}
    {hher : IsHereditary H} {x : G} : x ∈ ofDirected H hdir hher ↔ x ∈ H := by
  exact Iff.rfl

@[simp]
theorem ofDirected_toAddSubgroup {H : AddSubgroup G}
    {hdir : ∀ x ∈ H, ∃ y ∈ H, 0 ≤ y ∧ x ≤ y} {hher : IsHereditary H} :
    (ofDirected H hdir hher).toAddSubgroup = H := by
  rfl

end Preorder

section Bounds

variable {G : Type*} [AddCommGroup G]

/-- The trivial subgroup `{0}` is an order ideal in any partially ordered abelian group. -/
instance [PartialOrder G] : Bot (OrderIdeal G) where
  bot :=
    { toAddSubgroup := ⊥
      directedOn' := fun x hx y hy ↦ by
        rw [AddSubgroup.mem_carrier, AddSubgroup.mem_bot] at hx hy
        exact ⟨0, zero_mem (⊥ : AddSubgroup G), by simp [hx], by simp [hy]⟩
      isHereditary' := isHereditary_def.2 fun a b ha0 ha hb ↦ by
        rw [AddSubgroup.mem_bot] at hb ⊢
        exact le_antisymm (hb ▸ ha) ha0 }

@[simp]
theorem mem_bot [PartialOrder G] {x : G} : x ∈ (⊥ : OrderIdeal G) ↔ x = 0 :=
  Iff.rfl

@[simp]
theorem bot_toAddSubgroup [PartialOrder G] : (⊥ : OrderIdeal G).toAddSubgroup = ⊥ :=
  rfl

instance [PartialOrder G] : OrderBot (OrderIdeal G) where
  bot_le I _ hx := (mem_bot.1 hx) ▸ zero_mem I

/-- Every nonzero order ideal of a partially ordered abelian group contains a strictly positive
element. -/
theorem exists_pos_mem_of_ne_bot [PartialOrder G] [IsOrderedAddMonoid G]
    {I : OrderIdeal G} (hI : I ≠ ⊥) : ∃ p ∈ I, 0 < p := by
  have hnot : ¬ I ≤ ⊥ := fun h ↦ hI (le_bot_iff.1 h)
  obtain ⟨x, hx, hx0⟩ := Set.not_subset.1 hnot
  rw [SetLike.mem_coe, mem_bot] at hx0
  obtain ⟨y, hy, hy0, hxy⟩ := I.exists_nonneg_le hx
  rcases eq_or_lt_of_le hy0 with rfl | hypos
  · exact ⟨-x, neg_mem hx, lt_of_le_of_ne (neg_nonneg.2 hxy) (neg_ne_zero.2 hx0).symm⟩
  · exact ⟨y, hy, hypos⟩

/-- The greatest order ideal `⊤` of any preordered abelian group: the subgroup `G⁺ - G⁺`
generated by the positive cone, which is always upward directed and hereditary. -/
instance [Preorder G] [IsOrderedAddMonoid G] : Top (OrderIdeal G) where
  top := ofDirected
    { carrier := { x : G | ∃ a b : G, 0 ≤ a ∧ 0 ≤ b ∧ a - b = x }
      zero_mem' := ⟨0, 0, le_rfl, le_rfl, sub_zero 0⟩
      add_mem' := fun ⟨a₁, b₁, ha₁, hb₁, hx⟩ ⟨a₂, b₂, ha₂, hb₂, hy⟩ ↦
        ⟨a₁ + a₂, b₁ + b₂, add_nonneg ha₁ ha₂, add_nonneg hb₁ hb₂,
          by rw [← hx, ← hy, add_sub_add_comm]⟩
      neg_mem' := fun ⟨a, b, ha, hb, hx⟩ ↦
        ⟨b, a, hb, ha, by rw [← hx, neg_sub]⟩ }
    (fun _ ⟨a, b, ha, hb, hx⟩ ↦
      ⟨a, ⟨a, 0, ha, le_rfl, sub_zero a⟩, ha, hx ▸ sub_le_self a hb⟩)
    (isHereditary_def.2 fun a _ ha _ _ ↦ ⟨a, 0, ha, le_rfl, sub_zero a⟩)

theorem mem_top_iff [Preorder G] [IsOrderedAddMonoid G] {x : G} :
    x ∈ (⊤ : OrderIdeal G) ↔ ∃ a b : G, 0 ≤ a ∧ 0 ≤ b ∧ a - b = x :=
  Iff.rfl

/-- `⊤` is the subgroup generated by the positive cone. -/
theorem top_toAddSubgroup [Preorder G] [IsOrderedAddMonoid G] :
    (⊤ : OrderIdeal G).toAddSubgroup = AddSubgroup.closure (Set.Ici (0 : G)) := by
  ext x
  rw [mem_toAddSubgroup]
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · obtain ⟨a, b, ha, hb, rfl⟩ := mem_top_iff.1 hx
    exact sub_mem (AddSubgroup.subset_closure ha) (AddSubgroup.subset_closure hb)
  · induction hx using AddSubgroup.closure_induction with
    | mem y hy => exact mem_top_iff.2 ⟨y, 0, hy, le_rfl, sub_zero y⟩
    | zero => exact zero_mem (⊤ : OrderIdeal G)
    | add _ _ _ _ ih₁ ih₂ => exact add_mem ih₁ ih₂
    | neg _ _ ih => exact neg_mem ih

instance [Preorder G] [IsOrderedAddMonoid G] : OrderTop (OrderIdeal G) where
  le_top _ := le_of_forall_nonneg fun g hg _ ↦ mem_top_iff.2 ⟨g, 0, hg, le_rfl, sub_zero g⟩

/-- In an upward-directed ordered abelian group, every element belongs to `⊤`. -/
@[simp]
theorem mem_top [Preorder G] [IsOrderedAddMonoid G] [IsDirectedOrder G] {x : G} :
    x ∈ (⊤ : OrderIdeal G) := by
  obtain ⟨c, hc0, hxc⟩ := exists_ge_ge (0 : G) x
  exact mem_top_iff.2 ⟨c, c - x, hc0, sub_nonneg.2 hxc, sub_sub_cancel c x⟩

/-- In an upward-directed ordered abelian group, `(⊤ : OrderIdeal G)` has underlying subgroup
`⊤`. -/
theorem top_toAddSubgroup_of_isDirectedOrder [Preorder G] [IsOrderedAddMonoid G]
    [IsDirectedOrder G] : (⊤ : OrderIdeal G).toAddSubgroup = ⊤ :=
  (AddSubgroup.eq_top_iff' _).2 fun _ ↦ mem_top

instance [PartialOrder G] [IsOrderedAddMonoid G] : BoundedOrder (OrderIdeal G) where

/-- Any order ideal containing an order unit is the whole group (`⊤`). -/
theorem eq_top_of_isNatOrderUnit_mem [Preorder G] [IsOrderedAddMonoid G]
    {I : OrderIdeal G} {u : G} (hu : IsNatOrderUnit u) (huI : u ∈ I) : I = ⊤ := by
  refine _root_.top_unique fun g _ ↦ ?_
  obtain ⟨n, hlo, hhi⟩ := hu.exists_neg_nsmul_le_le_nsmul g
  exact I.mem_of_le_of_le (neg_mem (nsmul_mem huI n)) (nsmul_mem huI n) hlo hhi

end Bounds

section Iso

variable {G H : Type*} [AddCommGroup G] [Preorder G] [AddCommGroup H] [Preorder H]

/-- Preimage of an order ideal under an ordered additive isomorphism. -/
def comap (e : G ≃+o H) (I : OrderIdeal H) : OrderIdeal G where
  toAddSubgroup := AddSubgroup.comap (e.toAddEquiv : G →+ H) I.toAddSubgroup
  directedOn' x hx y hy := by
    obtain ⟨z, hz, hxz, hyz⟩ := I.directedOn (e x) hx (e y) hy
    refine ⟨e.symm z, by simpa using hz, ?_, ?_⟩
    · simpa using OrderHomClass.mono e.symm hxz
    · simpa using OrderHomClass.mono e.symm hyz
  isHereditary' := isHereditary_def.2 fun a b ha hab hb ↦ by
    refine I.isHereditary.mem_of_le ?_ (OrderHomClass.mono e hab) hb
    simpa using OrderHomClass.mono e ha

@[simp]
theorem mem_comap {e : G ≃+o H} {I : OrderIdeal H} {x : G} :
    x ∈ I.comap e ↔ e x ∈ I :=
  Iff.rfl

/-- Forward image of an order ideal under an ordered additive isomorphism. -/
def map (e : G ≃+o H) (I : OrderIdeal G) : OrderIdeal H :=
  I.comap e.symm

@[simp]
theorem mem_map {e : G ≃+o H} {I : OrderIdeal G} {y : H} :
    y ∈ I.map e ↔ e.symm y ∈ I :=
  Iff.rfl

theorem mem_map_iff_mem {e : G ≃+o H} {I : OrderIdeal G} {x : G} :
    e x ∈ I.map e ↔ x ∈ I := by
  simp

/-- An ordered additive isomorphism induces an order isomorphism between posets of order ideals. -/
def _root_.OrderAddMonoidIso.orderIdealCongr (e : G ≃+o H) : OrderIdeal G ≃o OrderIdeal H where
  toFun I := I.map e
  invFun J := J.comap e
  left_inv I := by ext x; simp
  right_inv J := by ext y; simp
  map_rel_iff' {I₁ I₂} := by
    refine ⟨fun h x hx ↦ ?_, fun h y hy ↦ h hy⟩
    exact mem_map_iff_mem.1 (h (mem_map_iff_mem.2 hx))

@[simp]
theorem _root_.OrderAddMonoidIso.orderIdealCongr_apply (e : G ≃+o H) (I : OrderIdeal G) :
    e.orderIdealCongr I = I.map e := by
  rfl

@[simp]
theorem _root_.OrderAddMonoidIso.orderIdealCongr_symm_apply (e : G ≃+o H) (J : OrderIdeal H) :
    e.orderIdealCongr.symm J = J.comap e := by
  rfl

end Iso

section Closure

variable {G : Type*} [AddCommGroup G] [Preorder G] [IsOrderedAddMonoid G]

/-- The smallest order ideal containing a given set `S` of nonnegative elements: the elements
bounded in absolute value `[-s, s]` by some element `s` of the additive submonoid generated by
`S`. -/
def closure (S : Set G) (hS : ∀ s ∈ S, 0 ≤ s) : OrderIdeal G :=
  ofDirected
    { carrier := { g : G | ∃ s ∈ AddSubmonoid.closure S, -s ≤ g ∧ g ≤ s }
      zero_mem' := ⟨0, zero_mem _, by simp⟩
      add_mem' := fun {x y} ⟨s, hs, hsx, hxs⟩ ⟨t, ht, hty, hyt⟩ ↦
        ⟨s + t, add_mem hs ht, by rw [neg_add]; exact add_le_add hsx hty, add_le_add hxs hyt⟩
      neg_mem' := fun {x} ⟨s, hs, hsx, hxs⟩ ↦
        ⟨s, hs, neg_le_neg_iff.2 hxs, neg_le.1 hsx⟩ }
    (fun _ ⟨s, hs, _, hxs⟩ ↦
      have hs0 : 0 ≤ s := nonneg_of_mem_addSubmonoidClosure hS hs
      ⟨s, ⟨s, hs, (neg_nonpos.2 hs0).trans hs0, le_rfl⟩, hs0, hxs⟩)
    (isHereditary_def.2 fun _ _ ha hab ⟨s, hs, _, hbs⟩ ↦
      have hs0 : 0 ≤ s := nonneg_of_mem_addSubmonoidClosure hS hs
      ⟨s, hs, (neg_nonpos.2 hs0).trans ha, hab.trans hbs⟩)

theorem mem_closure {S : Set G} {hS : ∀ s ∈ S, 0 ≤ s} {g : G} :
    g ∈ closure S hS ↔ ∃ s ∈ AddSubmonoid.closure S, -s ≤ g ∧ g ≤ s := by
  exact Iff.rfl

/-- Every element of `S` lies in `closure S hS`. -/
theorem subset_closure {S : Set G} (hS : ∀ s ∈ S, 0 ≤ s) : S ⊆ closure S hS := by
  intro s hs
  exact mem_closure.2
    ⟨s, AddSubmonoid.subset_closure hs, (neg_nonpos.2 (hS s hs)).trans (hS s hs), le_rfl⟩

/-- Universal property of `closure`: `closure S hS ≤ I` iff `S ⊆ I`. -/
@[simp]
theorem closure_le {S : Set G} {hS : ∀ s ∈ S, 0 ≤ s} {I : OrderIdeal G} :
    closure S hS ≤ I ↔ S ⊆ I := by
  refine ⟨fun h ↦ (subset_closure hS).trans h, fun hSI g hg ↦ ?_⟩
  obtain ⟨s, hs, hsg, hgs⟩ := mem_closure.1 hg
  have hsI : s ∈ I := (AddSubmonoid.closure_le (M := G)).2 hSI hs
  exact I.mem_of_le_of_le (neg_mem hsI) hsI hsg hgs

/-- Membership in the order ideal generated by a single nonnegative element `u`: the elements
lying in `[-n • u, n • u]` for some `n : ℕ`. -/
theorem mem_closure_singleton {u : G} (hu : 0 ≤ u) {g : G} :
    g ∈ closure {u} (by simp [hu]) ↔ ∃ n : ℕ, -(n • u) ≤ g ∧ g ≤ n • u := by
  simp only [mem_closure, AddSubmonoid.mem_closure_singleton]
  refine ⟨fun ⟨_, ⟨n, hn⟩, h⟩ ↦ ⟨n, hn ▸ h⟩,
    fun ⟨n, h⟩ ↦ ⟨n • u, ⟨n, rfl⟩, h⟩⟩

/-- In a directed ordered abelian group, the order ideal generated by `u ≥ 0` is `⊤` iff `u` is
an order unit. -/
theorem closure_singleton_eq_top_iff [IsDirectedOrder G] {u : G} (hu : 0 ≤ u) :
    closure {u} (by simp [hu]) = ⊤ ↔ IsNatOrderUnit u := by
  refine ⟨fun htop ↦ ⟨hu, fun g ↦ ?_⟩, fun hu' ↦ ?_⟩
  · have hg : g ∈ closure {u} (by simp [hu]) := htop ▸ mem_top
    exact ((mem_closure_singleton hu).1 hg).imp fun _ hn ↦ hn.2
  · exact eq_top_of_isNatOrderUnit_mem hu' (subset_closure _ rfl)

end Closure

section LatticePreorder

variable {G : Type*} [AddCommGroup G] [Preorder G] [IsOrderedAddMonoid G]

/-- Intersection of two order ideals, which is again an order ideal under Riesz interpolation. -/
def inf (h : HasRieszInterpolation G) (I J : OrderIdeal G) : OrderIdeal G where
  toAddSubgroup := I.toAddSubgroup ⊓ J.toAddSubgroup
  directedOn' x hx y hy := by
    obtain ⟨a, haI, hxa, hya⟩ := I.directedOn x hx.1 y hy.1
    obtain ⟨b, hbJ, hxb, hyb⟩ := J.directedOn x hx.2 y hy.2
    obtain ⟨c, hxc, hyc, hca, hcb⟩ := h.exists_ge_ge_le_le hxa hxb hya hyb
    exact ⟨c, ⟨I.mem_of_le_of_le hx.1 haI hxc hca, J.mem_of_le_of_le hx.2 hbJ hxc hcb⟩,
      hxc, hyc⟩
  isHereditary' := isHereditary_def.2 fun _ _ ha hab hb ↦
    ⟨I.isHereditary.mem_of_le ha hab hb.1, J.isHereditary.mem_of_le ha hab hb.2⟩

@[simp]
theorem mem_inf (h : HasRieszInterpolation G) {I J : OrderIdeal G} {x : G} :
    x ∈ inf h I J ↔ x ∈ I ∧ x ∈ J :=
  Iff.rfl

private theorem exists_decomposition_of_le_mem_sup (h : HasRieszInterpolation G)
    {I J : OrderIdeal G} {g b : G} (hg : 0 ≤ g) (hgb : g ≤ b)
    (hb : b ∈ I.toAddSubgroup ⊔ J.toAddSubgroup) :
    ∃ g₁ ∈ I, ∃ g₂ ∈ J, 0 ≤ g₁ ∧ 0 ≤ g₂ ∧ g₁ + g₂ = g := by
  obtain ⟨a, haI, c, hcJ, rfl⟩ := AddSubgroup.mem_sup.1 hb
  obtain ⟨a', ha'I, ha'0, haa'⟩ := I.exists_nonneg_le haI
  obtain ⟨c', hc'J, hc'0, hcc'⟩ := J.exists_nonneg_le hcJ
  obtain ⟨g₁, g₂, hg₁0, hg₁a', hg₂0, hg₂c', rfl⟩ :=
    h.exists_decomposition ha'0 hc'0 hg (hgb.trans (add_le_add haa' hcc'))
  exact ⟨g₁, I.isHereditary.mem_of_le hg₁0 hg₁a' ha'I,
    g₂, J.isHereditary.mem_of_le hg₂0 hg₂c' hc'J, hg₁0, hg₂0, rfl⟩

/-- Subgroup sum of two order ideals, which is an order ideal under Riesz interpolation. -/
def sup (h : HasRieszInterpolation G) (I J : OrderIdeal G) : OrderIdeal G where
  toAddSubgroup := I.toAddSubgroup ⊔ J.toAddSubgroup
  directedOn' x hx y hy := by
    obtain ⟨a₁, ha₁, b₁, hb₁, rfl⟩ := AddSubgroup.mem_sup.1 hx
    obtain ⟨a₂, ha₂, b₂, hb₂, rfl⟩ := AddSubgroup.mem_sup.1 hy
    obtain ⟨a, haI, ha₁a, ha₂a⟩ := I.directedOn a₁ ha₁ a₂ ha₂
    obtain ⟨b, hbJ, hb₁b, hb₂b⟩ := J.directedOn b₁ hb₁ b₂ hb₂
    exact ⟨a + b, AddSubgroup.add_mem_sup haI hbJ,
      add_le_add ha₁a hb₁b, add_le_add ha₂a hb₂b⟩
  isHereditary' := isHereditary_def.2 fun _ _ hg hgb hb ↦ by
    obtain ⟨g₁, hg₁, g₂, hg₂, -, -, rfl⟩ := exists_decomposition_of_le_mem_sup h hg hgb hb
    exact AddSubgroup.add_mem_sup hg₁ hg₂

theorem mem_sup (h : HasRieszInterpolation G) {I J : OrderIdeal G} {x : G} :
    x ∈ sup h I J ↔ ∃ a ∈ I, ∃ b ∈ J, a + b = x :=
  AddSubgroup.mem_sup

private theorem inf_sup_le (h : HasRieszInterpolation G) (I J K : OrderIdeal G) :
    inf h I (sup h J K) ≤ sup h (inf h I J) (inf h I K) := by
  refine le_of_forall_nonneg fun g hg0 ⟨hgI, hgJK⟩ ↦ ?_
  obtain ⟨g₁, hg₁J, g₂, hg₂K, hg₁0, hg₂0, rfl⟩ :=
    exists_decomposition_of_le_mem_sup h hg0 le_rfl hgJK
  have hg₁I : g₁ ∈ I :=
    I.isHereditary.mem_of_le hg₁0 (le_add_of_le_of_nonneg le_rfl hg₂0) hgI
  have hg₂I : g₂ ∈ I := I.isHereditary.mem_of_le hg₂0 (le_add_of_nonneg_left hg₁0) hgI
  exact (mem_sup h).2 ⟨g₁, ⟨hg₁I, hg₁J⟩, g₂, ⟨hg₂I, hg₂K⟩, rfl⟩

/-- Under Riesz interpolation, order ideals form a distributive lattice with intersection as `⊓`
and subgroup sum as `⊔`. -/
@[instance_reducible]
def distribLattice (h : HasRieszInterpolation G) : DistribLattice (OrderIdeal G) :=
  letI : Max (OrderIdeal G) := ⟨sup h⟩
  letI : Min (OrderIdeal G) := ⟨inf h⟩
  letI : Lattice (OrderIdeal G) :=
    toAddSubgroup_injective.lattice _ toAddSubgroup_le toAddSubgroup_lt
      (fun _ _ ↦ rfl) (fun _ _ ↦ rfl)
  DistribLattice.ofInfSupLe (inf_sup_le h)

/-- Under `distribLattice h`, `I ⊓ J` equals `inf h I J`. -/
@[simp]
theorem inf_eq (h : HasRieszInterpolation G) (I J : OrderIdeal G) :
    (letI := distribLattice h; I ⊓ J) = inf h I J := by
  rfl

/-- Under `distribLattice h`, `I ⊔ J` equals `sup h I J`. -/
@[simp]
theorem sup_eq (h : HasRieszInterpolation G) (I J : OrderIdeal G) :
    (letI := distribLattice h; I ⊔ J) = sup h I J := by
  rfl

end LatticePreorder

section LatticePartialOrder

variable {G : Type*} [AddCommGroup G] [PartialOrder G] [IsOrderedAddMonoid G]

omit [IsOrderedAddMonoid G] in
private theorem iSup_eq_closure (S : Set (OrderIdeal G)) :
    (⨆ I ∈ S, I.toAddSubgroup : AddSubgroup G) =
      AddSubgroup.closure (⋃ I ∈ S, (I : Set G)) := by
  rw [iSup_subtype', AddSubgroup.iSup_eq_closure]
  simp only [coe_toAddSubgroup, Set.iUnion_coe_set]

private theorem sSup_exists_le_mem_closure (S : Set (OrderIdeal G))
    {x : G} (hx : x ∈ (⨆ I ∈ S, I.toAddSubgroup : AddSubgroup G)) :
    ∃ c ∈ AddSubmonoid.closure (⋃ I ∈ S, { z : G | z ∈ I ∧ 0 ≤ z }),
      x ≤ c ∧ -x ≤ c := by
  rw [iSup_eq_closure] at hx
  induction hx using AddSubgroup.closure_induction with
  | mem z hz =>
    simp only [Set.mem_iUnion, SetLike.mem_coe, exists_prop] at hz
    obtain ⟨I, hIS, hzI⟩ := hz
    obtain ⟨y₁, hy₁, hy₁0, hzy₁⟩ := I.exists_nonneg_le hzI
    obtain ⟨y₂, hy₂, hy₂0, hnzy₂⟩ := I.exists_nonneg_le (neg_mem hzI)
    refine ⟨y₁ + y₂,
      add_mem (AddSubmonoid.subset_closure ?_) (AddSubmonoid.subset_closure ?_),
      hzy₁.trans (le_add_of_nonneg_right hy₂0), hnzy₂.trans (le_add_of_nonneg_left hy₁0)⟩
    · exact Set.mem_iUnion₂.2 ⟨I, hIS, hy₁, hy₁0⟩
    · exact Set.mem_iUnion₂.2 ⟨I, hIS, hy₂, hy₂0⟩
  | zero => exact ⟨0, zero_mem _, le_rfl, by simp⟩
  | add x₁ x₂ _ _ ih₁ ih₂ =>
    obtain ⟨c₁, hc₁, hx₁, hnx₁⟩ := ih₁
    obtain ⟨c₂, hc₂, hx₂, hnx₂⟩ := ih₂
    refine ⟨c₁ + c₂, add_mem hc₁ hc₂, add_le_add hx₁ hx₂, ?_⟩
    rw [neg_add_rev, add_comm (-x₂) (-x₁)]
    exact add_le_add hnx₁ hnx₂
  | neg x _ ih =>
    obtain ⟨c, hc, hx, hnx⟩ := ih
    exact ⟨c, hc, hnx, by simpa using hx⟩

/-- Supremum of an arbitrary family of order ideals under Riesz interpolation. -/
def sSup (h : HasRieszInterpolation G) (S : Set (OrderIdeal G)) : OrderIdeal G :=
  let T : Set G := ⋃ I ∈ S, { z : G | z ∈ I ∧ 0 ≤ z }
  have hT_nonneg : ∀ s ∈ T, 0 ≤ s := fun _ hz ↦ by
    obtain ⟨_, _, _, hz0⟩ := Set.mem_iUnion₂.1 hz
    exact hz0
  have hT_le : AddSubmonoid.closure T ≤ (⨆ I ∈ S, I.toAddSubgroup).toAddSubmonoid :=
    (AddSubmonoid.closure_le (M := G)).2 fun _ hz ↦ by
      obtain ⟨I, hIS, hzI, _⟩ := Set.mem_iUnion₂.1 hz
      exact (_root_.le_biSup (fun K : OrderIdeal G ↦ K.toAddSubgroup) hIS) hzI
  ofDirected (⨆ I ∈ S, I.toAddSubgroup)
    (fun _ hx ↦ by
      obtain ⟨c, hc, hxc, _⟩ := sSup_exists_le_mem_closure S hx
      exact ⟨c, (AddSubgroup.mem_toAddSubmonoid _ _).1 (hT_le hc),
        nonneg_of_mem_addSubmonoidClosure hT_nonneg hc, hxc⟩)
    (isHereditary_def.2 fun _ _ hg hgb hb ↦ by
      obtain ⟨c, hc, hbc, _⟩ := sSup_exists_le_mem_closure S hb
      have hT_her : ∀ ⦃g s⦄, 0 ≤ g → g ≤ s → s ∈ T → g ∈ T := fun g s hg' hgs hs ↦ by
        obtain ⟨I, hIS, hsI, _⟩ := Set.mem_iUnion₂.1 hs
        exact Set.mem_iUnion₂.2 ⟨I, hIS, I.isHereditary.mem_of_le hg' hgs hsI, hg'⟩
      exact (AddSubgroup.mem_toAddSubmonoid _ _).1 <|
        hT_le (h.mem_addSubmonoidClosure_of_nonneg_of_le (fun _ hs ↦ hT_nonneg _ hs)
          hT_her hg (hgb.trans hbc) hc))

@[simp]
theorem sSup_toAddSubgroup (h : HasRieszInterpolation G) (S : Set (OrderIdeal G)) :
    (sSup h S).toAddSubgroup = ⨆ I ∈ S, I.toAddSubgroup := by
  rfl

theorem mem_sSup (h : HasRieszInterpolation G) {S : Set (OrderIdeal G)} {x : G} :
    x ∈ sSup h S ↔ x ∈ AddSubgroup.closure (⋃ I ∈ S, (I : Set G)) := by
  rw [← mem_toAddSubgroup, sSup_toAddSubgroup, iSup_eq_closure]

private theorem le_sSup' (h : HasRieszInterpolation G) {S : Set (OrderIdeal G)} {I : OrderIdeal G}
    (hI : I ∈ S) : I ≤ sSup h S :=
  toAddSubgroup_le.1 (_root_.le_biSup (fun K : OrderIdeal G ↦ K.toAddSubgroup) hI)

private theorem sSup_le' (h : HasRieszInterpolation G) {S : Set (OrderIdeal G)} {J : OrderIdeal G}
    (hJ : ∀ I ∈ S, I ≤ J) : sSup h S ≤ J :=
  toAddSubgroup_le.1 (_root_.iSup₂_le fun I hI ↦ toAddSubgroup_le.2 (hJ I hI))

/-- Under Riesz interpolation, order ideals form a complete lattice whose `⊓`, `⊔`, `sSup`, `⊥`,
and `⊤` agree definitionally with `inf h`, `sup h`, `sSup h`, `⊥`, and `⊤`. -/
@[instance_reducible]
def completeLattice (h : HasRieszInterpolation G) : CompleteLattice (OrderIdeal G) :=
  letI : SupSet (OrderIdeal G) := ⟨sSup h⟩
  { distribLattice h,
    completeLatticeOfSup (OrderIdeal G)
      (fun _ ↦ ⟨fun _ hI ↦ le_sSup' h hI, fun _ hJ ↦ sSup_le' h hJ⟩) with
    bot := ⊥
    bot_le := fun _ ↦ _root_.bot_le
    top := ⊤
    le_top := fun _ ↦ _root_.le_top }

/-- Under `completeLattice h`, `I ⊓ J` equals `inf h I J`. -/
theorem completeLattice_inf_eq (h : HasRieszInterpolation G) (I J : OrderIdeal G) :
    (letI := completeLattice h; I ⊓ J) = inf h I J := by
  rfl

/-- Under `completeLattice h`, `I ⊔ J` equals `sup h I J`. -/
theorem completeLattice_sup_eq (h : HasRieszInterpolation G) (I J : OrderIdeal G) :
    (letI := completeLattice h; I ⊔ J) = sup h I J := by
  rfl

/-- Under `completeLattice h`, `SupSet.sSup S` equals `sSup h S`. -/
@[simp]
theorem sSup_eq (h : HasRieszInterpolation G) (S : Set (OrderIdeal G)) :
    (letI := completeLattice h; SupSet.sSup S) = sSup h S := by
  rfl

/-- Membership of a nonnegative element in the infimum `sInf S` of a family of order ideals. -/
theorem mem_sInf_of_nonneg (h : HasRieszInterpolation G) {S : Set (OrderIdeal G)} {g : G}
    (hg : 0 ≤ g) : (letI := completeLattice h; g ∈ InfSet.sInf S) ↔ ∀ I ∈ S, g ∈ I := by
  let _ := completeLattice h
  refine ⟨fun hgS I hI ↦ _root_.sInf_le hI hgS, fun hmem ↦ ?_⟩
  have hle : closure {g} (by simp [hg]) ≤ InfSet.sInf S :=
    _root_.le_sInf fun I hI ↦ closure_le.2 (by simpa using hmem I hI)
  exact hle (subset_closure _ rfl)

/-- Membership in the infimum `sInf S` of a family of order ideals: elements expressible as a
difference of two nonnegative elements lying in every ideal of `S`. -/
theorem mem_sInf (h : HasRieszInterpolation G) {S : Set (OrderIdeal G)} {x : G} :
    (letI := completeLattice h; x ∈ InfSet.sInf S) ↔
      ∃ a b : G, 0 ≤ a ∧ 0 ≤ b ∧ (∀ I ∈ S, a ∈ I ∧ b ∈ I) ∧ a - b = x := by
  let _ := completeLattice h
  refine ⟨fun hx ↦ ?_, fun ⟨a, b, ha0, hb0, hmem, hab⟩ ↦ ?_⟩
  · obtain ⟨a, b, ha, ha0, hb, hb0, hab⟩ := (InfSet.sInf S).exists_sub_nonneg_mem hx
    exact ⟨a, b, ha0, hb0, fun I hI ↦ ⟨_root_.sInf_le hI ha, _root_.sInf_le hI hb⟩, hab⟩
  · rw [← hab]
    exact sub_mem ((mem_sInf_of_nonneg h ha0).2 fun I hI ↦ (hmem I hI).1)
      ((mem_sInf_of_nonneg h hb0).2 fun I hI ↦ (hmem I hI).2)

end LatticePartialOrder

section Simple

variable {G : Type*} [AddCommGroup G] [PartialOrder G] [IsOrderedAddMonoid G] [IsDirectedOrder G]

/-- A directed partially ordered abelian group has `OrderIdeal G` simple (i.e., exactly two
distinct order ideals `⊥` and `⊤`) iff it is nontrivial and every strictly positive element is an
order unit. -/
theorem isSimpleOrder_iff_forall_pos_isNatOrderUnit :
    IsSimpleOrder (OrderIdeal G) ↔ Nontrivial G ∧ ∀ g : G, 0 < g → IsNatOrderUnit g := by
  refine ⟨fun hsimple ↦ ⟨?_, fun g hg ↦ ?_⟩, fun ⟨_, hunit⟩ ↦ ?_⟩
  · obtain ⟨I, J, hIJ⟩ := hsimple.exists_pair_ne
    by_contra hsub
    rw [not_nontrivial_iff_subsingleton] at hsub
    apply hIJ
    ext x
    simp [Subsingleton.elim x 0]
  · have hne : closure {g} (by simp [hg.le]) ≠ ⊥ := by
      intro hbot
      have hmem : g ∈ (⊥ : OrderIdeal G) := hbot ▸ subset_closure _ rfl
      exact hg.ne' (mem_bot.1 hmem)
    have htop : closure {g} (by simp [hg.le]) = ⊤ :=
      (eq_bot_or_eq_top _).resolve_left hne
    exact (closure_singleton_eq_top_iff hg.le).1 htop
  · refine { exists_pair_ne := ⟨⊥, ⊤, fun hbot ↦ ?_⟩, eq_bot_or_eq_top := fun I ↦ ?_ }
    · obtain ⟨g, hg⟩ := exists_ne (0 : G)
      exact hg (mem_bot.1 (hbot ▸ (mem_top : g ∈ (⊤ : OrderIdeal G))))
    · by_cases hbot : I = ⊥
      · exact Or.inl hbot
      · right
        obtain ⟨p, hpI, hp0⟩ := exists_pos_mem_of_ne_bot hbot
        exact eq_top_of_isNatOrderUnit_mem (hunit p hp0) hpI

end Simple

