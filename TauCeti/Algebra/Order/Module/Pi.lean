module

public import Mathlib.Algebra.Module.LinearMap.Defs
public import Mathlib.Basic.Finite.Defs
public import Mathlib.Algebra.Module.Pi
public import Mathlib.Algebra.Order.Module.Defs
public import Mathlib.Algebra.Order.Pi
import Mathlib.Algebra.BigOperators.Pi
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Algebra.Order.Hom.Monoid
import Mathlib.Data.Fintype.EquivFin

/-!
# Linear maps nonnegative on coordinate cones

For a finite index type `ι` and a set `J` of coordinates, the vectors `v : ι → R` with `0 ≤ v` and
`v j = 0` for `j ∈ J` form a cone, generated by the coordinate vectors `Pi.single j 1` with
`j ∉ J`. A linear map is therefore nonnegative on this cone exactly when it is nonnegative on those
coordinate vectors. For `J = ∅` the cone is the whole nonnegative orthant, and the criterion says
that a linear map is monotone exactly when its coordinate coefficients are nonnegative. For
`J = univ` the cone is `{0}`, so every linear map is nonnegative on it.

## Main results

* `TauCeti.forall_map_nonneg_iff_map_single_nonneg`: nonnegativity on the coordinate cone
  vanishing on `J` is nonnegativity on the coordinate vectors outside `J`.
* `TauCeti.forall_map_nonneg_univ`: for `J = univ` the condition holds for every linear map.
* `TauCeti.monotone_iff_map_single_nonneg`: a linear map on `ι → R` is monotone if and only if it
  is nonnegative on every coordinate vector.
-/

public section

namespace TauCeti

variable {ι R M F : Type*} [Finite ι] [DecidableEq ι] [FunLike F (ι → R) M]

section Semiring

variable [Semiring R] [PartialOrder R] [IsOrderedRing R] [AddCommMonoid M] [PartialOrder M]
  [IsOrderedAddMonoid M] [Module R M] [PosSMulMono R M] [LinearMapClass F R (ι → R) M]

/-- A linear map on `ι → R` is nonnegative on the nonnegative vectors vanishing on `J` if and only
if it is nonnegative on the coordinate vectors `Pi.single j 1` with `j ∉ J`. -/
theorem forall_map_nonneg_iff_map_single_nonneg (J : Set ι) (L : F) :
    (∀ v : ι → R, 0 ≤ v → (∀ j ∈ J, v j = 0) → 0 ≤ L v) ↔
      ∀ j ∉ J, 0 ≤ L (Pi.single j 1) := by
  refine ⟨fun hL j hj ↦ hL _ (Pi.single_nonneg.2 zero_le_one) fun k hk ↦ ?_, fun hL v hv hJ ↦ ?_⟩
  · exact Pi.single_eq_of_ne (ne_of_mem_of_not_mem hk hj) 1
  · have := Fintype.ofFinite ι
    rw [pi_eq_sum_univ' v, map_sum]
    refine Finset.sum_nonneg fun j _ ↦ ?_
    rw [map_smul]
    by_cases hj : j ∈ J
    · rw [hJ j hj, zero_smul]
    · exact smul_nonneg (hv j) (hL j hj)

omit [DecidableEq ι] in
/-- Every linear map on `ι → R` is nonnegative on the nonnegative vectors vanishing on every
coordinate, since the only such vector is zero. This is the case `J = univ` of
`forall_map_nonneg_iff_map_single_nonneg`. -/
theorem forall_map_nonneg_univ (L : F) :
    ∀ v : ι → R, 0 ≤ v → (∀ j ∈ (Set.univ : Set ι), v j = 0) → 0 ≤ L v := by
  classical
  exact (forall_map_nonneg_iff_map_single_nonneg Set.univ L).2 fun j hj ↦ (hj (Set.mem_univ j)).elim

end Semiring

/-- A linear map on `ι → R` is monotone if and only if it is nonnegative on every coordinate
vector `Pi.single j 1`. -/
theorem monotone_iff_map_single_nonneg [Ring R] [PartialOrder R] [IsOrderedRing R]
    [AddCommGroup M] [PartialOrder M] [IsOrderedAddMonoid M] [Module R M] [PosSMulMono R M]
    [LinearMapClass F R (ι → R) M] (L : F) :
    Monotone L ↔ ∀ j, 0 ≤ L (Pi.single j 1) := by
  rw [monotone_iff_map_nonneg L]
  simpa using forall_map_nonneg_iff_map_single_nonneg (∅ : Set ι) L

end TauCeti
