module

public import Mathlib.RingTheory.TensorProduct.Basic
public import TauCeti.Algebra.WordFiltration.Basic
public import TauCeti.LinearAlgebra.TensorProduct.Filtration.Basic

/-!
# The word filtration of a tensor product

Let `f : M →ₗ[R] A` and `g : N →ₗ[R] B` be linear families in two algebras. The tensor product
`A ⊗[R] B` is generated by the family `(m, n) ↦ f m ⊗ 1 + 1 ⊗ g n` on `M × N`
(`TauCeti.Algebra.tensorGenerators f g`). This file shows that the word filtration of that family
is the total tensor filtration `TauCeti.tensorFiltration` of the two word filtrations
(`TauCeti.Algebra.wordFiltration_tensorGenerators`): degree `n` is spanned by the pure tensors
`x ⊗ y` with `x` a word of length `i` in `f`, `y` a word of length `j` in `g` and `i + j ≤ n`.

No flatness or commutativity is needed: the two factor inclusions commute in `A ⊗[R] B`, and both
filtrations are described by images of submodules.

## Main definitions and results

* `TauCeti.Algebra.tensorGenerators`: the generating family `(m, n) ↦ f m ⊗ 1 + 1 ⊗ g n`.
* `TauCeti.Algebra.wordFiltration_tensorGenerators`: its word filtration is the total tensor
  filtration of the word filtrations of `f` and `g`.
-/

public section

open scoped TensorProduct

namespace TauCeti.Algebra

variable {R M N A B : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]
  [AddCommMonoid N] [Module R N] [Semiring A] [_root_.Algebra R A] [Semiring B]
  [_root_.Algebra R B] (f : M →ₗ[R] A) (g : N →ₗ[R] B)

/-- The generating family `(m, n) ↦ f m ⊗ 1 + 1 ⊗ g n` of `A ⊗[R] B` given by linear families
`f` in `A` and `g` in `B`. -/
noncomputable def tensorGenerators : M × N →ₗ[R] A ⊗[R] B :=
  LinearMap.coprod
    ((_root_.Algebra.TensorProduct.includeLeft : A →ₐ[R] A ⊗[R] B).toLinearMap ∘ₗ f)
    ((_root_.Algebra.TensorProduct.includeRight : B →ₐ[R] A ⊗[R] B).toLinearMap ∘ₗ g)

/-- The value of `tensorGenerators f g` at `(m, n)` is `f m ⊗ 1 + 1 ⊗ g n`. -/
@[simp]
theorem tensorGenerators_apply (x : M × N) :
    tensorGenerators f g x = f x.1 ⊗ₜ[R] (1 : B) + (1 : A) ⊗ₜ[R] g x.2 := by
  simp [tensorGenerators]

/-- The left factor inclusion sends words in `f` to words of the same length in
`tensorGenerators f g`. -/
theorem tmul_one_mem_wordFiltration_tensorGenerators {k : ℕ} {x : A}
    (hx : x ∈ wordFiltration f k) :
    x ⊗ₜ[R] (1 : B) ∈ wordFiltration (tensorGenerators f g) k :=
  map_mem_wordFiltration f (_root_.Algebra.TensorProduct.includeLeft : A →ₐ[R] A ⊗[R] B) _
    (fun m ↦ by
      simpa using apply_mem_wordFiltration_one (tensorGenerators f g) (m, (0 : N))) hx

/-- The right factor inclusion sends words in `g` to words of the same length in
`tensorGenerators f g`. -/
theorem one_tmul_mem_wordFiltration_tensorGenerators {k : ℕ} {y : B}
    (hy : y ∈ wordFiltration g k) :
    (1 : A) ⊗ₜ[R] y ∈ wordFiltration (tensorGenerators f g) k :=
  map_mem_wordFiltration g (_root_.Algebra.TensorProduct.includeRight : B →ₐ[R] A ⊗[R] B) _
    (fun n ↦ by
      simpa using apply_mem_wordFiltration_one (tensorGenerators f g) ((0 : M), n)) hy

/-- The word filtration of the generating family `(m, n) ↦ f m ⊗ 1 + 1 ⊗ g n` of `A ⊗[R] B` is the
total tensor filtration of the word filtrations of `f` and `g`. -/
theorem wordFiltration_tensorGenerators (n : ℕ) :
    wordFiltration (tensorGenerators f g) n =
      tensorFiltration (wordFiltration f) (wordFiltration g) n := by
  apply le_antisymm
  · rw [wordFiltration_le_iff]
    intro l hl
    refine tensorFiltration_mono _ _ hl ?_
    clear hl
    have hmul := tensorFiltration_mul_le (fun i j ↦ (wordFiltration_mul f i j).le)
      (fun i j ↦ (wordFiltration_mul g i j).le)
    induction l with
    | nil =>
      simpa using one_mem_tensorFiltration (one_mem_wordFiltration f 0)
        (one_mem_wordFiltration g 0) 0
    | cons x l ih =>
      have hx : tensorGenerators f g x ∈
          tensorFiltration (wordFiltration f) (wordFiltration g) 1 := by
        rw [tensorGenerators_apply]
        exact Submodule.add_mem _
          (tmul_mem_tensorFiltration (by omega : 1 + 0 ≤ 1)
            (apply_mem_wordFiltration_one f x.1) (one_mem_wordFiltration g 0))
          (tmul_mem_tensorFiltration (by omega : 0 + 1 ≤ 1)
            (one_mem_wordFiltration f 0) (apply_mem_wordFiltration_one g x.2))
      simpa only [List.map_cons, List.prod_cons, List.length_cons, Nat.add_comm 1] using
        hmul 1 l.length (Submodule.mul_mem_mul hx ih)
  · rw [tensorFiltration_le_iff]
    intro i j hij x hx y hy
    have hxy : x ⊗ₜ[R] y = (x ⊗ₜ[R] (1 : B)) * ((1 : A) ⊗ₜ[R] y) := by
      simp [_root_.Algebra.TensorProduct.tmul_mul_tmul]
    rw [hxy]
    exact wordFiltration_mono _ hij (mul_mem_wordFiltration _
      (tmul_one_mem_wordFiltration_tensorGenerators f g hx)
      (one_tmul_mem_wordFiltration_tensorGenerators f g hy))

end TauCeti.Algebra
