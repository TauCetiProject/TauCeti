module

public import TauCeti.Algebra.WordFiltration.AssociatedGraded
public import TauCeti.RingTheory.GradedAlgebra.CoeffSubalgebra.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.Polynomial.Inductions

/-!
# The zero fibre of a word-filtration Rees algebra

For a linear generating family `f`, the Rees algebra is the subalgebra of `A[X]` whose
coefficient in degree `n` lies in `wordFiltration f n`. Its symbol map sends that coefficient
to its class in the `n`-th associated-graded piece. This map is surjective, and its kernel
is the ideal generated by the central parameter. Thus specializing the Rees parameter to
zero gives the associated graded, even when `A` is noncommutative.

This symbol map differs from ambient polynomial evaluation at zero: a positive-degree
monomial can have a nonzero symbol.
-/

public section

open scoped DirectSum
open Polynomial DirectSum

namespace TauCeti.Algebra.wordFiltration

variable {R M A : Type*} [CommRing R] [AddCommMonoid M] [Module R M]
  [Ring A] [Algebra R A] (f : M →ₗ[R] A)

/-- The Rees algebra of the word filtration generated by `f`. -/
abbrev Rees := coeffSubalgebra (wordFiltration f)

private noncomputable def symbolComponent (n : ℕ) :
    coeffSubalgebra.grade (wordFiltration f) n →ₗ[R] GradedPiece f n :=
  (Submodule.mkQ (previousRestricted f n)).comp
    (coeffSubalgebra.gradeEquiv (wordFiltration f) n).symm.toLinearMap

private theorem symbolComponent_apply (n : ℕ)
    (a : coeffSubalgebra.grade (wordFiltration f) n) :
    symbolComponent f n a = Submodule.Quotient.mk
      (⟨((a : Rees f) : A[X]).coeff n,
        mem_coeffSubalgebra_iff.mp (a : Rees f).2 n⟩ : wordFiltration f n) := by
  apply congrArg Submodule.Quotient.mk
  exact Subtype.ext (coeffSubalgebra.coe_gradeEquiv_symm_apply n a)

/-- The symbol homomorphism from the Rees algebra to the associated graded. -/
noncomputable def reesSymbol : Rees f →ₐ[R] AssociatedGraded f := by
  let c : ∀ n, coeffSubalgebra.grade (wordFiltration f) n →ₗ[R] AssociatedGraded f :=
    fun n ↦ (DirectSum.lof R ℕ (GradedPiece f) n).comp (symbolComponent f n)
  have h1 : c 0 (GradedMonoid.GOne.one
      (A := fun n ↦ coeffSubalgebra.grade (wordFiltration f) n)) = 1 := by
    dsimp only [c, LinearMap.comp_apply]
    rw [symbolComponent_apply, lof_eq_of]
    convert associatedGraded_of_gradedOne (f := f) using 2
    rw [← mk_one_eq_gradedOne]
    congr 1
    apply Subtype.ext
    exact Polynomial.coeff_one_zero
  have hm {i j} (a : coeffSubalgebra.grade (wordFiltration f) i)
      (b : coeffSubalgebra.grade (wordFiltration f) j) :
      c (i + j) (GradedMonoid.GMul.mul
        (A := fun n ↦ coeffSubalgebra.grade (wordFiltration f) n) a b) = c i a * c j b := by
    dsimp only [c, LinearMap.comp_apply]
    simp only [symbolComponent_apply, lof_eq_of]
    rw [associatedGraded_of_mul_of, gradedMul_apply_mk]
    congr 1
    congr 1
    apply Subtype.ext
    dsimp only [Subtype.coe_mk]
    -- Each homogeneous factor is a monomial, so only one product coefficient survives.
    rw [SetLike.coe_gMul, Subalgebra.coe_mul,
      ← coeffSubalgebra.mem_grade_iff_monomial_coeff.mp a.2,
      ← coeffSubalgebra.mem_grade_iff_monomial_coeff.mp b.2,
      monomial_mul_monomial, coeff_monomial_same, coeff_monomial_same,
      coeff_monomial_same]
  exact (DirectSum.toAlgebra R _ c h1 @hm).comp
    (DirectSum.decomposeAlgEquiv (coeffSubalgebra.grade (wordFiltration f))).toAlgHom

/-- A homogeneous Rees monomial maps to the corresponding homogeneous symbol. -/
@[simp]
theorem reesSymbol_monomial (n : ℕ) (a : A) (ha : a ∈ wordFiltration f n) :
    reesSymbol f (coeffSubalgebra.monomial (wordFiltration f) n a ha) =
      DirectSum.of (GradedPiece f) n (Submodule.Quotient.mk ⟨a, ha⟩) := by
  simp only [reesSymbol, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
    DirectSum.decomposeAlgEquiv_apply]
  rw [DirectSum.decompose_of_mem _ (coeffSubalgebra.monomial_mem_grade n a ha)]
  rw [DirectSum.toAlgebra_apply]
  -- The direct-sum algebra constructor passes linear maps through additive homomorphisms.
  erw [DirectSum.toSemiring_of]
  simp [symbolComponent_apply, lof_eq_of]

private theorem reesSymbol_eq_lmap (p : Rees f) :
    reesSymbol f p = DirectSum.lmap (symbolComponent f)
      (DirectSum.decompose (coeffSubalgebra.grade (wordFiltration f)) p) := by
  let d := DirectSum.decompose (coeffSubalgebra.grade (wordFiltration f)) p
  have hp : p = (DirectSum.decompose (coeffSubalgebra.grade (wordFiltration f))).symm d :=
    ((DirectSum.decompose (coeffSubalgebra.grade (wordFiltration f))).symm_apply_apply p).symm
  rw [hp]
  induction d using DirectSum.induction_on with
  | zero => simp
  | of n a =>
    rw [DirectSum.decompose_symm_of]
    obtain ⟨b, hb, hba⟩ := coeffSubalgebra.mem_grade_iff.mp a.2
    have heq : (a : Rees f) = coeffSubalgebra.monomial (wordFiltration f) n b hb :=
      Subtype.ext (by simpa using hba.symm)
    rw [DirectSum.decompose_coe, DirectSum.lmap_of, heq, reesSymbol_monomial]
    apply congrArg (DirectSum.of (GradedPiece f) n)
    rw [symbolComponent_apply]
    apply congrArg Submodule.Quotient.mk
    apply Subtype.ext
    exact (Polynomial.coeff_monomial_same n b).symm.trans
      (congrArg (fun p : A[X] ↦ p.coeff n) hba)
  | add a b ha hb => simp_all

/-- The degree-`n` component of the symbol is the class of the `n`-th coefficient. -/
@[simp]
theorem reesSymbol_apply (p : Rees f) (n : ℕ) :
    reesSymbol f p n = Submodule.Quotient.mk
      (⟨(p : A[X]).coeff n, mem_coeffSubalgebra_iff.mp p.2 n⟩ : wordFiltration f n) := by
  rw [reesSymbol_eq_lmap, DirectSum.lmap_apply, symbolComponent_apply]
  apply congrArg Submodule.Quotient.mk
  apply Subtype.ext
  simpa only [Polynomial.coeff_monomial_same] using
    congrArg (fun p : A[X] ↦ p.coeff n) (coeffSubalgebra.coe_decompose_apply p n)

/-- The symbol map vanishes exactly when each coefficient lies one step lower. -/
theorem reesSymbol_eq_zero_iff (p : Rees f) :
    reesSymbol f p = 0 ↔ ∀ n, (p : A[X]).coeff n ∈ wordFiltrationPrevious f n := by
  rw [DirectSum.ext_iff]
  simp only [reesSymbol_apply, DirectSum.zero_apply, gradedPiece_mk_eq_zero_iff]

/-- Every associated-graded element has a Rees lift. -/
theorem reesSymbol_surjective : Function.Surjective (reesSymbol f) := by
  intro x
  induction x using DirectSum.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | of n a =>
    induction a using Submodule.Quotient.induction_on with
    | _ a => exact ⟨coeffSubalgebra.monomial (wordFiltration f) n a a.2,
        reesSymbol_monomial f n a a.2⟩
  | add a b ha hb =>
    obtain ⟨p, rfl⟩ := ha
    obtain ⟨q, rfl⟩ := hb
    exact ⟨p + q, map_add _ p q⟩

/-- The central Rees parameter has zero symbol. -/
@[simp]
theorem reesSymbol_X :
    reesSymbol f (coeffSubalgebra.X (wordFiltration f) (one_mem_wordFiltration f 1)) = 0 := by
  apply (reesSymbol_eq_zero_iff f _).mpr
  intro n
  cases n with
  | zero => simp
  | succ n =>
    rw [wordFiltrationPrevious_succ]
    by_cases hn : n = 0
    · subst n
      simpa using one_mem_wordFiltration f 0
    · simp [Polynomial.coeff_X, hn]

/-- A Rees element has zero symbol exactly when it is a multiple of the parameter. -/
theorem reesSymbol_eq_zero_iff_exists_X_mul_eq (p : Rees f) :
    reesSymbol f p = 0 ↔ ∃ q : Rees f,
      coeffSubalgebra.X (wordFiltration f) (one_mem_wordFiltration f 1) * q = p := by
  constructor
  · intro hp
    have hc := (reesSymbol_eq_zero_iff f p).mp hp
    have h0 : (p : A[X]).coeff 0 = 0 := by simpa using hc 0
    have hq : (p : A[X]).divX ∈ coeffSubalgebra (wordFiltration f) := by
      apply mem_coeffSubalgebra_iff.mpr
      intro n
      simpa only [Polynomial.coeff_divX, wordFiltrationPrevious_succ] using hc (n + 1)
    refine ⟨⟨(p : A[X]).divX, hq⟩, Subtype.ext ?_⟩
    simpa [h0] using Polynomial.X_mul_divX_add (p : A[X])
  · rintro ⟨q, rfl⟩
    simp

/-- The kernel of the symbol map is the principal ideal of the central parameter. -/
theorem ker_reesSymbol :
    RingHom.ker (reesSymbol f : Rees f →+* AssociatedGraded f) =
      Ideal.span {coeffSubalgebra.X (wordFiltration f) (one_mem_wordFiltration f 1)} := by
  ext p
  simp only [RingHom.mem_ker, AlgHom.coe_toRingHom]
  rw [reesSymbol_eq_zero_iff_exists_X_mul_eq, Ideal.mem_span_singleton']
  exact exists_congr fun q ↦ by rw [(coeffSubalgebra.commute_X _ _ q).eq]

/-- Specializing the Rees parameter to zero gives the associated graded algebra. -/
noncomputable def reesZeroFiberEquiv :
    (Rees f ⧸ Ideal.span {(coeffSubalgebra.X (wordFiltration f)
      (one_mem_wordFiltration f 1))}) ≃ₐ[R] AssociatedGraded f :=
  (Ideal.quotientEquivAlgOfEq R (ker_reesSymbol f).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (reesSymbol_surjective f))

/-- The zero-fibre comparison sends the class of a Rees polynomial to its symbol. -/
@[simp]
theorem reesZeroFiberEquiv_mk (p : Rees f) :
    reesZeroFiberEquiv f (Ideal.Quotient.mk _ p) = reesSymbol f p := by
  exact (congrArg (Ideal.quotientKerAlgEquivOfSurjective (reesSymbol_surjective f))
    (Ideal.quotientEquivAlgOfEq_mk R (ker_reesSymbol f).symm p)).trans
      (Ideal.quotientKerAlgEquivOfSurjective_mk (reesSymbol_surjective f) p)

end TauCeti.Algebra.wordFiltration
