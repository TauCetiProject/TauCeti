module

public import TauCeti.Algebra.AlgebraicGroup.Connected.Comultiplication
public import TauCeti.Algebra.AlgebraicGroup.Connected.AlgebraicallyClosed
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Basic
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange
import Mathlib.RingTheory.FiniteStability

/-!
# Connectedness of a subgroup generated by connected affine groups

Over an algebraically closed field, the closed subgroup scheme generated by a family of
connected affine group schemes is connected. We use the common-kernel construction of the
generated subgroup: a connected generator factors through the identity component of the
generated subgroup. Maximality of the common-kernel Hopf ideal then forces that identity
component to be the whole generated subgroup.

Over an arbitrary field, geometric connectedness of the generators implies geometric
connectedness of their common-kernel quotient. Common kernels commute with field extension,
so the algebraically closed result applies after base change. Only the generated quotient
needs to be of finite type; smoothness or reducedness is not required.

## Reference

* J. S. Milne, *Algebraic Groups* (2017), Propositions 2.37 and 2.48, and §7.
* The Tau Ceti contributors, finite-type transport in
  `smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal_of_geometricallyReduced`,
  `TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.GeometricallyReduced`.
  The finite-type base-change argument below adapts
  [that formal proof](https://github.com/TauCetiProject/TauCeti/blob/2527db7c58c264a54ab77c2accbaf5a7c7a6f1a2/TauCeti/Algebra/AlgebraicGroup/HopfIdeal/CommonKernel/GeometricallyReduced.lean#L43-L53).
-/

public section

open CategoryTheory
open scoped TensorProduct

namespace TauCeti.CommHopfAlgCat

universe u v w

variable {k : Type u} [Field k]

/-- A finite-type common-kernel quotient generated by connected affine groups over an
algebraically closed field is connected. Neither the ambient affine group nor the generators
need be of finite type. -/
theorem connectedSpace_commonKernelQuotient [IsAlgClosed k]
    {H : _root_.CommHopfAlgCat.{v} k}
    {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} k}
    (f : ∀ i, H ⟶ K i)
    [Algebra.FiniteType k (quotient H (commonKernelHopfIdeal f))]
    (hK : ∀ i, ConnectedSpace (PrimeSpectrum (K i))) :
    ConnectedSpace (PrimeSpectrum (quotient H (commonKernelHopfIdeal f))) := by
  let Q := quotient H (commonKernelHopfIdeal f)
  let J := HopfAlgebra.identityComponentHopfIdeal (k := k) (H := Q)
  have hJ : J = ⊥ := by
    apply le_antisymm ?_ bot_le
    rw [← commonKernelHopfIdeal_commonKernelLift_eq_bot f]
    apply (le_commonKernelHopfIdeal_iff (commonKernelLift f) J).mpr
    intro i
    let _ : ConnectedSpace (PrimeSpectrum (K i)) := hK i
    exact identityComponentHopfIdeal_toIdeal_le_ker_of_connected (commonKernelLift f i)
  exact HopfAlgebra.identityComponentHopfIdeal_eq_bot_iff_connectedSpace.mp hJ

/-- A finite-type common-kernel quotient generated by geometrically connected affine groups is
geometrically connected over any field. Only the quotient is required to be of finite type. -/
theorem geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient_of_geometricallyConnected
    {H : _root_.CommHopfAlgCat.{v} k}
    {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} k}
    (f : ∀ i, H ⟶ K i)
    [Algebra.FiniteType k (quotient H (commonKernelHopfIdeal f))]
    (hK : ∀ i, geometricallyConnectedCommHopfAlgProperty k (K i)) :
    geometricallyConnectedCommHopfAlgProperty k
      (quotient H (commonKernelHopfIdeal f)) := by
  apply (geometricallyConnectedCommHopfAlgProperty_iff_connectedSpace_of_isAlgClosed k _).mpr
  intro L _ _ _
  let Q := quotient H (commonKernelHopfIdeal f)
  let e := quotientBaseChangeIso (K := L) (commonKernelHopfIdeal f)
  have hfinite : Algebra.FiniteType L
      (quotient (baseChange (K := L) H)
        (commonKernelHopfIdeal fun i ↦ baseChangeMap (K := L) (f i))) := by
    rw [← baseChangeHopfIdeal_commonKernelHopfIdeal f]
    exact Algebra.FiniteType.of_surjective e.inv.hom.toAlgHom
      (ConcreteCategory.bijective_of_isIso e.inv).2
  have hconnected := connectedSpace_commonKernelQuotient
    (fun i ↦ baseChangeMap (K := L) (f i)) (fun i ↦ by
      have := (geometricallyConnectedCommHopfAlgProperty_iff k (K i)).mp (hK i) L
      exact connectedSpace_primeSpectrum_of_injective
        (Algebra.TensorProduct.comm k L (K i)).toRingHom
        (Algebra.TensorProduct.comm k L (K i)).injective)
  rw [← baseChangeHopfIdeal_commonKernelHopfIdeal f] at hconnected
  have : ConnectedSpace (PrimeSpectrum (baseChange (K := L) Q)) :=
    connectedSpace_primeSpectrum_of_injective e.inv.hom.toAlgHom.toRingHom
      (ConcreteCategory.bijective_of_isIso e.inv).1
  exact connectedSpace_primeSpectrum_of_injective
    (Algebra.TensorProduct.comm k Q L).toRingHom
    (Algebra.TensorProduct.comm k Q L).injective

/-- A finite-type common-kernel quotient generated by connected affine groups over an
algebraically closed field is geometrically connected. Ordinary connectedness of the generators
suffices in this case; only the quotient is required to be of finite type. -/
theorem geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient [IsAlgClosed k]
    {H : _root_.CommHopfAlgCat.{v} k}
    {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} k}
    (f : ∀ i, H ⟶ K i)
    [Algebra.FiniteType k (quotient H (commonKernelHopfIdeal f))]
    (hK : ∀ i, ConnectedSpace (PrimeSpectrum (K i))) :
    geometricallyConnectedCommHopfAlgProperty k
      (quotient H (commonKernelHopfIdeal f)) := by
  exact geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient_of_geometricallyConnected
    f (fun i ↦ (geometricallyConnectedCommHopfAlgProperty_iff_connectedSpace k (K i)).mpr
      (hK i))

end TauCeti.CommHopfAlgCat
