/-!
# The Weyl group of a closed diagonalizable subgroup

Let `G = Spec H` be an affine group scheme over a commutative ring `R` with connected prime
spectrum, and let `D(X) → G` be a closed diagonalizable subgroup, given by a surjective morphism
`π : H →ₐc[R] R[X]` of coordinate Hopf algebras. The rational points of its scheme normalizer act
on the character group `X` through `BialgHom.normalizerCharacterHom`. This file names the image of
this action, `BialgHom.weylGroup π hπ`, a subgroup of `MulAut X`, and records how it acts on the
data from which a root datum is read off.

* The kernel of the action is the group of rational points of the scheme centralizer
  `Z_G(D(X))`, so the Weyl group is the quotient `N_G(D(X))(R) / Z_G(D(X))(R)` of rational points
  (`BialgHom.normalizerQuotientCentralizerEquiv`). It acts faithfully on `X` by construction.
  Over a field, and for a finite-type group, it is finite. Its elements are exactly the
  automorphisms `w` of `X` realized by a normalization equation for some rational point
  (`BialgHom.mem_weylGroup_iff`).
* In every representation of `G`, it permutes the weights of the restriction to `D(X)` and
  preserves their multiplicities (`BialgHom.finrank_weightSpace_apply_of_mem_weylGroup`).
* It permutes the nontrivial adjoint weights, which are the roots when `D(X)` is a split maximal
  torus of a reductive group (`BialgHom.weylGroupRootPerm`). The adjoint action of a normalizing
  point identifies the weight space `𝔤_α` with `𝔤_{wα}`
  (`BialgHom.normalizerAdjointWeightSpaceEquiv`), so weight multiplicities are invariant under the
  Weyl group.
* Conjugating the cocharacter `𝔾ₘ → D(X) → G` attached to `ψ : X →* Multiplicative ℤ` by a
  normalizing point `g` gives the cocharacter attached to `ψ ∘ w⁻¹`, where `w` is the image of `g`
  (`BialgHom.conjCocharacter_cocharacter`). Hence the normalizer carries the dynamic subgroups
  `P(λ)`, `U(λ)` and `Z(λ)` of a cocharacter of `D(X)` to those of its Weyl translate.

Normalization and centralization are scheme-theoretic, through the Hopf ideals
`HopfIdeal.kerOfSurjective π hπ` and `BialgHom.centralizerHopfIdeal π`, so `G` and `D(X)` may be
nonreduced. Only rational points enter: over a field that is not algebraically closed, the
group `N_G(D(X))(k) / Z_G(D(X))(k)` can be smaller than the rational points of the finite étale
quotient scheme `N_G(D(X)) / Z_G(D(X))`. Nothing here asserts that `D(X)` is a maximal torus, that
its centralizer is `D(X)` itself, or that the Weyl group is generated by reflections.

## Main definitions

* `BialgHom.weylGroup`: the image of the rational normalizer in `MulAut X`.
* `BialgHom.normalizerQuotientCentralizerEquiv`: the rational normalizer modulo the rational
  centralizer is isomorphic to the Weyl group.
* `BialgHom.weylGroupRootPerm`: the action of the Weyl group on the nontrivial adjoint weights.

## Main results

* `BialgHom.finite_weylGroup`: over a field, the Weyl group of a closed diagonalizable subgroup of
  a finite-type affine group is finite.
* `BialgHom.mem_weylGroup_iff`: membership in the Weyl group through a normalization equation.
* `BialgHom.finrank_weightSpace_apply_of_mem_weylGroup` and
  `BialgHom.weightSpace_apply_eq_bot_iff_of_mem_weylGroup`: the Weyl group preserves the weights
  and weight multiplicities of every representation.
* `BialgHom.mem_nontrivialAdjointWeights_apply_iff_of_mem_weylGroup`: the Weyl group preserves
  the nontrivial adjoint weights.
* `BialgHom.finrank_adjointWeightSpace_apply_of_mem_weylGroup`: weight multiplicities are Weyl
  invariant.
* `BialgHom.conjCocharacter_cocharacter`: the normalizer acts on cocharacters of `D(X)` through
  the contragredient of its action on characters.
* `BialgHom.conjugate_parabolicDefiningHopfIdeal_cocharacter`,
  `BialgHom.conjugate_leviDefiningHopfIdeal_cocharacter` and
  `BialgHom.conjugate_unipotentDefiningHopfIdeal_cocharacter`: the normalizer carries the dynamic
  subgroups of a cocharacter of `D(X)` to those of its Weyl translate.

## References

* J. S. Milne, *Algebraic Groups* (2017), Chapter 21.
* A. Borel, *Linear Algebraic Groups*, 2nd ed., §§8.10 and 11.19.
-/

public section

open TauCeti TauCeti.Cocharacter WithConv

namespace BialgHom

noncomputable section

universe u v w

variable {R : Type u} {H : Type v} {X : Type w} [CommRing R] [CommRing H] [HopfAlgebra R H]
  [CommGroup X] [ConnectedSpace (PrimeSpectrum R)]
variable (π : H →ₐc[R] MonoidAlgebra R X) (hπ : Function.Surjective π)

/-! ### The Weyl group and the centralizer -/

/-- The **Weyl group** of the closed diagonalizable subgroup `D(X) → G`: the automorphisms of the
character group `X` induced by inverse conjugation by rational points of the scheme normalizer.
It is the quotient of the rational normalizer by the rational centralizer
(`BialgHom.normalizerQuotientCentralizerEquiv`), realized inside `MulAut X`. -/
def weylGroup : Subgroup (MulAut X) :=
  (normalizerCharacterHom π hπ).range

/-- The rational normalizer modulo the rational centralizer is the Weyl group. -/
def normalizerQuotientCentralizerEquiv :
    normalizerPoints π hπ ⧸
        (centralizerPointsSubgroup π (CommAlgCat.of R R)).subgroupOf (normalizerPoints π hπ) ≃*
      weylGroup π hπ :=
  (QuotientGroup.quotientMulEquivOfEq (ker_normalizerCharacterHom π hπ).symm).trans
    (QuotientGroup.quotientKerEquivRange (normalizerCharacterHom π hπ))

@[simp]
theorem coe_normalizerQuotientCentralizerEquiv_mk (g : normalizerPoints π hπ) :
    (normalizerQuotientCentralizerEquiv π hπ g : MulAut X) = normalizerCharacterHom π hπ g :=
  (rfl)

/-- **Membership in the Weyl group** means being realized by a normalization equation: some
rational point `g` whose inverse conjugation restricts to `D(X)` as the coordinate map of `w`. -/
theorem mem_weylGroup_iff {w : MulAut X} :
    w ∈ weylGroup π hπ ↔ ∃ g : WithConv (H →ₐ[R] R),
      π.toAlgHom.comp (HopfAlgebra.pointConjugationAlgHom g⁻¹) =
        (MonoidAlgebra.domCongr R R w).toAlgHom.comp π.toAlgHom := by
  constructor
  · rintro ⟨g, rfl⟩
    exact ⟨g, normalizerCharacterHom_comp π hπ g⟩
  · rintro ⟨g, hg⟩
    exact ⟨_, normalizerCharacterHom_of_comp_eq π hπ g w hg⟩

section Field

variable {k : Type u} {L : Type v} [Field k] [CommRing L] [HopfAlgebra k L]
  [Algebra.FiniteType k L]

/-- **The Weyl group is finite** for a closed diagonalizable subgroup of a finite-type affine
group over a field. -/
instance finite_weylGroup (ρ : L →ₐc[k] MonoidAlgebra k X) (hρ : Function.Surjective ρ) :
    Finite (weylGroup ρ hρ) :=
  (finite_range_normalizerCharacterHom ρ hρ).to_subtype

end Field

/-! ### The action on weight spaces of representations -/

section Representation

variable {V : Type*} [AddCommGroup V] [Module R V] [Comodule R H V]

/-- **The Weyl group preserves weight multiplicities** in every representation `V` of `G`: the
weight spaces of `x` and `w x` for the restriction of `V` to `D(X)` have the same dimension. -/
theorem finrank_weightSpace_apply_of_mem_weylGroup {w : MulAut X} (hw : w ∈ weylGroup π hπ)
    (x : X) :
    Module.finrank R (DiagonalizableGroup.weightSpace V π.toCoalgHom (w x)) =
      Module.finrank R (DiagonalizableGroup.weightSpace V π.toCoalgHom x) := by
  obtain ⟨g, hg⟩ := (mem_weylGroup_iff π hπ).mp hw
  exact (DiagonalizableGroup.weightSpaceEquivOfNormalizes π g w hg x).finrank_eq.symm

/-- **The Weyl group permutes the weights** of every representation `V` of `G`: `w x` is a weight
of the restriction of `V` to `D(X)` exactly when `x` is. -/
theorem weightSpace_apply_eq_bot_iff_of_mem_weylGroup {w : MulAut X}
    (hw : w ∈ weylGroup π hπ) (x : X) :
    DiagonalizableGroup.weightSpace V π.toCoalgHom (w x) = ⊥ ↔
      DiagonalizableGroup.weightSpace V π.toCoalgHom x = ⊥ := by
  obtain ⟨g, hg⟩ := (mem_weylGroup_iff π hπ).mp hw
  exact not_iff_not.mp (DiagonalizableGroup.weightSpace_apply_ne_bot_iff π g w hg x)

end Representation

/-! ### The action on roots and root spaces -/

section RootSpace

attribute [local instance] Derivation.adjointComodule

variable [Module.Finite R (Bialgebra.CotangentSpace R H)]
variable [Module.Projective R (Bialgebra.CotangentSpace R H)]

/-- **The Weyl group preserves the nontrivial adjoint weights**, the roots when `D(X)` is a split
maximal torus of a reductive group. -/
theorem mem_nontrivialAdjointWeights_apply_iff_of_mem_weylGroup {w : MulAut X}
    (hw : w ∈ weylGroup π hπ) (α : X) :
    w α ∈ Derivation.nontrivialAdjointWeights π ↔ α ∈ Derivation.nontrivialAdjointWeights π := by
  obtain ⟨g, rfl⟩ := hw
  exact Derivation.mem_nontrivialAdjointWeights_apply_iff π g _ (normalizerCharacterHom_comp π hπ g)
    α

/-- The permutation action of the Weyl group on the nontrivial adjoint weights. When `D(X)` is a
split maximal torus of a reductive group, this is the action of the Weyl group on the roots. -/
def weylGroupRootPerm : weylGroup π hπ →* Equiv.Perm (Derivation.nontrivialAdjointWeights π) where
  toFun w := Equiv.Perm.subtypePerm (w : MulAut X).toEquiv fun α ↦
    mem_nontrivialAdjointWeights_apply_iff_of_mem_weylGroup π hπ w.property α
  map_one' := rfl
  map_mul' _ _ := rfl

@[simp]
theorem coe_weylGroupRootPerm_apply (w : weylGroup π hπ)
    (α : Derivation.nontrivialAdjointWeights π) :
    (weylGroupRootPerm π hπ w α : X) = (w : MulAut X) α :=
  (rfl)

/-- **Weight multiplicities are invariant under the Weyl group.** For a split maximal torus of a
reductive group, `w α` is a root of the same multiplicity as `α`. -/
theorem finrank_adjointWeightSpace_apply_of_mem_weylGroup {w : MulAut X}
    (hw : w ∈ weylGroup π hπ) (α : X) :
    Module.finrank R (Derivation.adjointWeightSpace π (w α)) =
      Module.finrank R (Derivation.adjointWeightSpace π α) := by
  rw [Derivation.adjointWeightSpace_eq_weightSpace, Derivation.adjointWeightSpace_eq_weightSpace]
  exact finrank_weightSpace_apply_of_mem_weylGroup π hπ hw α

end RootSpace

/-! ### The action on cocharacters -/

/-- **Conjugating a cocharacter of `D(X)` by a normalizing point.** The cocharacter
`t ↦ g λ_ψ(t) g⁻¹` is the cocharacter of `D(X)` attached to `ψ ∘ w⁻¹`, where `w` is the
automorphism of the character group induced by `g`. Thus the normalizer acts on the cocharacters
of `D(X)` through the contragredient `ψ ↦ ψ ∘ w⁻¹` of its action on characters. -/
theorem conjCocharacter_cocharacter (g : normalizerPoints π hπ) (ψ : X →* Multiplicative ℤ) :
    (π.cocharacter ψ).conjCocharacter g =
      π.cocharacter (ψ.comp (normalizerCharacterHom π hπ g⁻¹).toMonoidHom) := by
  have hg := normalizerCharacterHom_comp π hπ g⁻¹
  rw [Subgroup.coe_inv, inv_inv] at hg
  ext x : 1
  rw [conjCocharacter_apply]
  have hx := AlgHom.congr_fun hg x
  simp only [AlgHom.comp_apply, coe_toAlgHom, AlgEquiv.coe_toAlgHom] at hx
  apply EquivLike.injective (AddMonoidAlgebra.toMultiplicativeBialgEquiv R R ℤ)
  have h₁ := BialgHom.congr_fun (toMultiplicativeBialgEquiv_comp_cocharacter π ψ)
    (HopfAlgebra.pointConjugationAlgHom (g : WithConv (H →ₐ[R] R)) x)
  have h₂ := BialgHom.congr_fun (toMultiplicativeBialgEquiv_comp_cocharacter π
    (ψ.comp (normalizerCharacterHom π hπ g⁻¹).toMonoidHom)) x
  simp only [comp_apply] at h₁ h₂
  exact h₁.trans ((congrArg _ hx).trans
    ((MonoidAlgebra.mapDomainBialgHom_mapDomainBialgHom ψ
      (normalizerCharacterHom π hπ g⁻¹).toMonoidHom (π x)).trans h₂.symm))

/-- The normalizer carries the parabolic subgroup `P(λ)` of a cocharacter `λ` of `D(X)` to the
parabolic subgroup of its Weyl translate. -/
theorem conjugate_parabolicDefiningHopfIdeal_cocharacter (g : normalizerPoints π hπ)
    (ψ : X →* Multiplicative ℤ) :
    (parabolicDefiningHopfIdeal (π.cocharacter ψ)).conjugate (g : WithConv (H →ₐ[R] R)) =
      parabolicDefiningHopfIdeal
        (π.cocharacter (ψ.comp (normalizerCharacterHom π hπ g⁻¹).toMonoidHom)) := by
  rw [← conjCocharacter_cocharacter, parabolicDefiningHopfIdeal_conjCocharacter]

/-- The normalizer carries the Levi subgroup `Z(λ)` of a cocharacter `λ` of `D(X)` to the Levi
subgroup of its Weyl translate. -/
theorem conjugate_leviDefiningHopfIdeal_cocharacter (g : normalizerPoints π hπ)
    (ψ : X →* Multiplicative ℤ) :
    (leviDefiningHopfIdeal (π.cocharacter ψ)).conjugate (g : WithConv (H →ₐ[R] R)) =
      leviDefiningHopfIdeal
        (π.cocharacter (ψ.comp (normalizerCharacterHom π hπ g⁻¹).toMonoidHom)) := by
  rw [← conjCocharacter_cocharacter, leviDefiningHopfIdeal_conjCocharacter]

/-- The normalizer carries the unipotent subgroup `U(λ)` of a cocharacter `λ` of `D(X)` to the
unipotent subgroup of its Weyl translate. -/
theorem conjugate_unipotentDefiningHopfIdeal_cocharacter (g : normalizerPoints π hπ)
    (ψ : X →* Multiplicative ℤ) :
    (π.cocharacter ψ).unipotentDefiningHopfIdeal.conjugate (g : WithConv (H →ₐ[R] R)) =
      (π.cocharacter
        (ψ.comp (normalizerCharacterHom π hπ g⁻¹).toMonoidHom)).unipotentDefiningHopfIdeal := by
  rw [← conjCocharacter_cocharacter, unipotentDefiningHopfIdeal_conjCocharacter]

end

end BialgHom
