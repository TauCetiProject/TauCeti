/-!
# Fixed points of diagonalizable groups and worked examples

For a diagonalizable group `D(G) = Spec R[G]` acted on through character endomorphisms
`φ : ι → (G →* G)`, any surjective character quotient `q : G →* Q` whose kernel is generated by
the displacements `φ i g * g⁻¹` identifies the fixed-point closed subgroup scheme `D(G)^φ` with
`D(Q)` (`DiagonalizableGroup.fixedPointCoordinateIsoOfSurjective`), building on
`TauCeti.CommHopfAlgCat.fixedPointHopfIdeal` from
`TauCeti.Algebra.AlgebraicGroup.HopfIdeal.FixedPoints`.

In particular, smoothness of `H^Θ` under Edixhoven's theorem does *not* imply connectedness, even
when `H` is a split torus:
* Under inversion on `𝔾ₘ = D(Multiplicative ℤ)`, the fixed-point subgroup scheme is `μ₂`
  (`DiagonalizableGroup.fixedPointInversionIso`), which has two `k`-points `{1, -1}` over any
  domain of characteristic not `2`
  (`DiagonalizableGroup.natCard_points_quotient_fixedPointInversion`, via
  `TauCeti.card_rootsOfUnity_two`) and disconnected prime spectrum over any nontrivial ring in
  which `2` is invertible
  (`DiagonalizableGroup.not_connectedSpace_primeSpectrum_quotient_fixedPointInversion`, via
  `MonoidAlgebra.cyclicTwoEquivProd`).
* Under factor swap on `𝔾ₘ² = D(Multiplicative (ℤ × ℤ))`, the fixed-point subgroup scheme is the
  diagonal `𝔾ₘ` (`DiagonalizableGroup.fixedPointSwapIso`, via `DiagonalizableGroup.sumCharHom`),
  which has connected prime spectrum over every integral domain
  (`DiagonalizableGroup.connectedSpace_primeSpectrum_quotient_fixedPointSwap`).

## Main declarations

* `TauCeti.DiagonalizableGroup.fixedPointHopfIdeal_mapDomainBialgHom_toIdeal`: ideal-theoretic
  identification of `(fixedPointHopfIdeal ...).toIdeal` with `ker (mapDomainRingHom R q)`.
* `TauCeti.DiagonalizableGroup.fixedPointCoordinateIsoOfSurjective`: for a diagonalizable group
  `D(G)` with character endomorphisms `φ : ι → (G →* G)`, any surjective character quotient
  `q : G →* Q` with `q.ker = Subgroup.closure {φ i g * g⁻¹}` identifies `D(G)^φ ≅ D(Q)`.
* `TauCeti.DiagonalizableGroup.fixedPointInversionIso`,
  `TauCeti.DiagonalizableGroup.natCard_points_quotient_fixedPointInversion`, and
  `TauCeti.DiagonalizableGroup.not_connectedSpace_primeSpectrum_quotient_fixedPointInversion`:
  `(𝔾ₘ)^{inv} ≅ μ₂`, its point count over domains with `2 ≠ 0`, and disconnectedness for `2 ∈ Rˣ`.
* `TauCeti.DiagonalizableGroup.swapCharHom`, `TauCeti.DiagonalizableGroup.sumCharHom`,
  `TauCeti.DiagonalizableGroup.fixedPointSwapIso`, and
  `TauCeti.DiagonalizableGroup.connectedSpace_primeSpectrum_quotient_fixedPointSwap`:
  `(𝔾ₘ²)^{swap} ≅ 𝔾ₘ` and connectedness of its prime spectrum over integral domains.

## References

* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), Proposition 3.1
  (p. 293) and Proposition 3.4 (pp. 294–295).
* J. S. Milne, *Algebraic Groups* (2017), §1.h and Theorem 12.9.
-/

public noncomputable section

open CategoryTheory

namespace TauCeti.DiagonalizableGroup

universe u v w x

section General

variable (R : Type u) [CommRing R]

/-- For a family of character endomorphisms `φ : ι → (G →* G)` and a monoid homomorphism
`q : G →* Q` whose kernel is generated by the displacements `φ i g * g⁻¹`, the fixed-point Hopf
ideal on `R[G]` has underlying ideal `ker (mapDomainRingHom R q)`. -/
theorem fixedPointHopfIdeal_mapDomainBialgHom_toIdeal {G : Type v} {Q : Type x}
    [CommGroup G] [Monoid Q] {ι : Sort w} (φ : ι → (G →* G))
    (q : G →* Q) (hq_ker : q.ker = Subgroup.closure {x : G | ∃ i g, φ i g * g⁻¹ = x}) :
    (CommHopfAlgCat.fixedPointHopfIdeal
      (fun i ↦ _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R (φ i)))).toIdeal =
        RingHom.ker (MonoidAlgebra.mapDomainRingHom R q) := by
  apply le_antisymm
  · rw [CommHopfAlgCat.fixedPointHopfIdeal_le_ker_iff]
    intro i x
    induction x using MonoidAlgebra.induction_linear with
    | zero => simp
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
    | single g r =>
      have hmem : φ i g * g⁻¹ ∈ q.ker := by
        rw [hq_ker]
        exact Subgroup.subset_closure ⟨i, g, rfl⟩
      have hqg : q (φ i g) = q g := by
        calc
          q (φ i g) = q (φ i g * g⁻¹ * g) := by rw [inv_mul_cancel_right]
          _ = q (φ i g * g⁻¹) * q g := map_mul q _ _
          _ = q g := by rw [MonoidHom.mem_ker.mp hmem, one_mul]
      simp [hqg]
  · rw [TauCeti.MonoidAlgebra.ker_mapDomainRingHom_eq_span R q, Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    have hk : (k : G) ∈ Subgroup.closure {x : G | ∃ i g, φ i g * g⁻¹ = x} := hq_ker ▸ k.property
    refine Ideal.span_le.mpr ?_ (TauCeti.MonoidAlgebra.single_sub_one_mem_span_of_mem_closure R hk)
    rintro _ ⟨_, ⟨i, g, rfl⟩, rfl⟩
    have hsub : MonoidAlgebra.single (φ i g) (1 : R) - MonoidAlgebra.single g 1 ∈
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun i ↦ _root_.CommHopfAlgCat.ofHom
            (MonoidAlgebra.mapDomainBialgHom R (φ i)))).toIdeal := by
      simpa using
        HopfIdeal.mem_toIdeal.mpr (CommHopfAlgCat.sub_mem_fixedPointHopfIdeal
          (fun i ↦ _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R (φ i))) i
          (MonoidAlgebra.single g 1))
    have hmul := Ideal.mul_mem_right (MonoidAlgebra.single g⁻¹ (1 : R)) _ hsub
    exact SetLike.mem_coe.mpr (by
      simpa only [sub_mul, MonoidAlgebra.single_mul_single, one_mul, mul_inv_cancel,
        MonoidAlgebra.one_def] using hmul)

/-- **Fixed-point coordinate algebra of a diagonalizable group.** If `q : G →* Q` is surjective with
kernel generated by `{φ i g * g⁻¹}`, then `D(G)^φ ≅ D(Q)` in `CommHopfAlgCat R`. -/
def fixedPointCoordinateIsoOfSurjective {G Q : Type v} [CommGroup G] [CommGroup Q]
    {ι : Sort w} (φ : ι → (G →* G)) (q : G →* Q)
    (hq_surj : Function.Surjective q)
    (hq_ker : q.ker = Subgroup.closure {x : G | ∃ i g, φ i g * g⁻¹ = x}) :
    _root_.CommHopfAlgCat.quotient (_root_.CommHopfAlgCat.of R (MonoidAlgebra R G))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun i ↦ _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R (φ i)))) ≅
      _root_.CommHopfAlgCat.of R (MonoidAlgebra R Q) :=
  _root_.CommHopfAlgCat.Hom.quotientIsoOfKerOfSurjectiveEq
    (_root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R q))
    (by
      rw [_root_.CommHopfAlgCat.hom_ofHom]
      exact _root_.MonoidAlgebra.mapDomainBialgHom_surjective R hq_surj) <| by
      ext x
      rw [HopfIdeal.mem_kerOfSurjective, _root_.CommHopfAlgCat.hom_ofHom, ← HopfIdeal.mem_toIdeal,
        fixedPointHopfIdeal_mapDomainBialgHom_toIdeal R φ q hq_ker, RingHom.mem_ker,
        ← BialgHom.coe_toAlgHom, ← RingHom.coe_coe,
        TauCeti.MonoidAlgebra.mapDomainBialgHom_toRingHom]

/-- Composing `mkQuotient` with `(fixedPointCoordinateIsoOfSurjective ...).hom` recovers the
coordinate map `mapDomainBialgHom R q`. -/
@[reassoc (attr := simp)]
theorem mkQuotient_comp_fixedPointCoordinateIsoOfSurjective_hom
    {G Q : Type v} [CommGroup G] [CommGroup Q]
    {ι : Sort w} (φ : ι → (G →* G)) (q : G →* Q) (hq_surj : Function.Surjective q)
    (hq_ker : q.ker = Subgroup.closure {x : G | ∃ i g, φ i g * g⁻¹ = x}) :
    _root_.CommHopfAlgCat.mkQuotient (_root_.CommHopfAlgCat.of R (MonoidAlgebra R G))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun i ↦ _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R (φ i)))) ≫
        (fixedPointCoordinateIsoOfSurjective R φ q hq_surj hq_ker).hom =
      _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R q) :=
  _root_.CommHopfAlgCat.Hom.mkQuotient_comp_quotientIsoOfKerOfSurjectiveEq_hom _ _ _

/-- Composing `mapDomainBialgHom R q` with `(fixedPointCoordinateIsoOfSurjective ...).inv` recovers
`mkQuotient`. -/
@[reassoc (attr := simp)]
theorem ofHom_mapDomainBialgHom_comp_fixedPointCoordinateIsoOfSurjective_inv
    {G Q : Type v} [CommGroup G] [CommGroup Q]
    {ι : Sort w} (φ : ι → (G →* G)) (q : G →* Q) (hq_surj : Function.Surjective q)
    (hq_ker : q.ker = Subgroup.closure {x : G | ∃ i g, φ i g * g⁻¹ = x}) :
    _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R q) ≫
        (fixedPointCoordinateIsoOfSurjective R φ q hq_surj hq_ker).inv =
      _root_.CommHopfAlgCat.mkQuotient (_root_.CommHopfAlgCat.of R (MonoidAlgebra R G))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun i ↦ _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R (φ i)))) :=
  _root_.CommHopfAlgCat.Hom.comp_quotientIsoOfKerOfSurjectiveEq_inv _ _ _

end General

/-! #### Worked example 1: inversion on `𝔾ₘ` gives `μ₂` (smooth for `2 ∈ Rˣ`, disconnected) -/

section Inversion

private theorem mem_ker_toMultiplicativeZMod_two_iff (x : Multiplicative ℤ) :
    RootsOfUnityGroup.toMultiplicativeZMod 2 x = 1 ↔
      ∃ k : ℤ, Multiplicative.ofAdd (-k + -k) = x := by
  rw [← MonoidHom.mem_ker, RootsOfUnityGroup.ker_toMultiplicativeZMod, Subgroup.mem_zpowers_iff]
  refine ⟨fun ⟨k, hk⟩ ↦ ⟨-k, ?_⟩, fun ⟨k, hk⟩ ↦ ⟨-k, ?_⟩⟩
  · rw [← hk]
    apply Multiplicative.toAdd.injective
    simp only [toAdd_ofAdd, toAdd_zpow]
    ring
  · rw [← hk]
    apply Multiplicative.toAdd.injective
    simp only [toAdd_zpow, toAdd_ofAdd]
    ring

private theorem ker_toMultiplicativeZMod_two :
    (RootsOfUnityGroup.toMultiplicativeZMod 2).ker =
      Subgroup.closure
        {x : Multiplicative ℤ |
          ∃ (_ : Unit) (g : Multiplicative ℤ), invMonoidHom g * g⁻¹ = x} := by
  apply le_antisymm
  · intro y hy
    obtain ⟨k, rfl⟩ := (mem_ker_toMultiplicativeZMod_two_iff y).mp hy
    refine Subgroup.subset_closure ⟨(), Multiplicative.ofAdd k, ?_⟩
    apply Multiplicative.toAdd.injective
    simp
  · rw [Subgroup.closure_le]
    rintro _ ⟨⟨⟩, g, rfl⟩
    rw [SetLike.mem_coe, MonoidHom.mem_ker, mem_ker_toMultiplicativeZMod_two_iff]
    refine ⟨g.toAdd, ?_⟩
    apply Multiplicative.toAdd.injective
    simp

/-- **Fixed points of inversion on `𝔾ₘ` are `μ₂`:** over every commutative ring `R`, the
fixed-point quotient of `𝔾ₘ = D(Multiplicative ℤ)` under inversion is isomorphic in
`CommHopfAlgCat R` to `μ₂ = D(Multiplicative (ZMod 2))`. -/
def fixedPointInversionIso (R : Type u) [CommRing R] :
    _root_.CommHopfAlgCat.quotient (_root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative ℤ)))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun _ : Unit ↦ _root_.CommHopfAlgCat.ofHom
            (MonoidAlgebra.mapDomainBialgHom R (invMonoidHom : Multiplicative ℤ →* _)))) ≅
      _root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative (ZMod 2))) :=
  fixedPointCoordinateIsoOfSurjective R
    (fun _ : Unit ↦ (invMonoidHom : Multiplicative ℤ →* Multiplicative ℤ))
    (RootsOfUnityGroup.toMultiplicativeZMod 2)
    (RootsOfUnityGroup.toMultiplicativeZMod_surjective 2)
    ker_toMultiplicativeZMod_two

/-- Composing `mkQuotient` with `(fixedPointInversionIso R).hom` gives the `μ₂ ↪ 𝔾ₘ` coordinate
surjection. -/
@[reassoc (attr := simp)]
theorem mkQuotient_comp_fixedPointInversionIso_hom (R : Type u) [CommRing R] :
    _root_.CommHopfAlgCat.mkQuotient
        (_root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative ℤ)))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun _ : Unit ↦ _root_.CommHopfAlgCat.ofHom
            (MonoidAlgebra.mapDomainBialgHom R (invMonoidHom : Multiplicative ℤ →* _)))) ≫
        (fixedPointInversionIso R).hom =
      _root_.CommHopfAlgCat.ofHom
        (MonoidAlgebra.mapDomainBialgHom R (RootsOfUnityGroup.toMultiplicativeZMod 2)) := by
  rw [fixedPointInversionIso, mkQuotient_comp_fixedPointCoordinateIsoOfSurjective_hom]

/-- Composing the `μ₂ ↪ 𝔾ₘ` coordinate surjection with `(fixedPointInversionIso R).inv` recovers
`mkQuotient`. -/
@[reassoc (attr := simp)]
theorem ofHom_mapDomainBialgHom_toMultiplicativeZMod_comp_fixedPointInversionIso_inv
    (R : Type u) [CommRing R] :
    _root_.CommHopfAlgCat.ofHom
        (MonoidAlgebra.mapDomainBialgHom R (RootsOfUnityGroup.toMultiplicativeZMod 2)) ≫
        (fixedPointInversionIso R).inv =
      _root_.CommHopfAlgCat.mkQuotient
        (_root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative ℤ)))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun _ : Unit ↦ _root_.CommHopfAlgCat.ofHom
            (MonoidAlgebra.mapDomainBialgHom R (invMonoidHom : Multiplicative ℤ →* _)))) := by
  rw [fixedPointInversionIso, ofHom_mapDomainBialgHom_comp_fixedPointCoordinateIsoOfSurjective_inv]

/-- Over an integral domain `k` with `(2 : k) ≠ 0`, the `k`-points of `(𝔾ₘ)^{inv}` have cardinality
`2` (corresponding to `{1, -1}`). -/
theorem natCard_points_quotient_fixedPointInversion (k : Type u) [CommRing k] [IsDomain k]
    (h2 : (2 : k) ≠ 0) :
    Nat.card (HopfAlgebra.points (R := k)
      (H := _root_.CommHopfAlgCat.quotient
        (_root_.CommHopfAlgCat.of k (MonoidAlgebra k (Multiplicative ℤ)))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun _ : Unit ↦ _root_.CommHopfAlgCat.ofHom
            (MonoidAlgebra.mapDomainBialgHom k (invMonoidHom : Multiplicative ℤ →* _)))))
      (CommAlgCat.of k k)) = 2 := by
  let ePts :=
    (BialgEquiv.mapDomainMulEquiv (A := k)
      (_root_.CommHopfAlgCat.ofIso (fixedPointInversionIso k))).symm.trans
      (RootsOfUnityGroup.pointsMulEquiv 2)
  exact (Nat.card_congr ePts.toEquiv).trans (TauCeti.card_rootsOfUnity_two h2)

/-- **Non-example for connectedness:** over any nontrivial ring `R` in which `2` is invertible,
`(𝔾ₘ)^{inv}` is smooth by Edixhoven's theorem yet its prime spectrum is disconnected. -/
theorem not_connectedSpace_primeSpectrum_quotient_fixedPointInversion (R : Type u) [CommRing R]
    [Nontrivial R] [Invertible (2 : R)] :
    ¬ ConnectedSpace (PrimeSpectrum
      (_root_.CommHopfAlgCat.quotient
        (_root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative ℤ)))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun _ : Unit ↦ _root_.CommHopfAlgCat.ofHom
            (MonoidAlgebra.mapDomainBialgHom R (invMonoidHom : Multiplicative ℤ →* _)))))) := by
  let eRing :=
    ((_root_.CommHopfAlgCat.ofIso (fixedPointInversionIso R)).toAlgEquiv.trans
      (MonoidAlgebra.cyclicTwoEquivProd R)).toRingEquiv
  rw [(PrimeSpectrum.homeomorphOfRingEquiv eRing).connectedSpace_iff]
  intro hconn
  have he : IsIdempotentElem ((1, 0) : R × R) := by ext <;> simp
  rcases he.eq_zero_or_eq_one_of_preconnectedSpace with h0 | h1
  · exact one_ne_zero (congrArg Prod.fst h0)
  · exact zero_ne_one (congrArg Prod.snd h1)

end Inversion

/-! #### Worked example 2: factor swap on `𝔾ₘ²` gives the connected diagonal `𝔾ₘ` -/

section Swap

/-- The coordinate-swap automorphism of the character group `Multiplicative (ℤ × ℤ)` of `𝔾ₘ²`. -/
def swapCharHom : Multiplicative (ℤ × ℤ) →* Multiplicative (ℤ × ℤ) :=
  AddMonoidHom.toMultiplicative (AddEquiv.prodComm : ℤ × ℤ ≃+ ℤ × ℤ).toAddMonoidHom

/-- `swapCharHom` swaps the additive coordinates of `Multiplicative.ofAdd p`. -/
@[simp]
theorem swapCharHom_ofAdd (p : ℤ × ℤ) :
    swapCharHom (Multiplicative.ofAdd p) = Multiplicative.ofAdd p.swap := by
  simp [swapCharHom]

/-- `toAdd` of `swapCharHom g` swaps the additive coordinates of `g.toAdd`. -/
@[simp]
theorem toAdd_swapCharHom (g : Multiplicative (ℤ × ℤ)) :
    (swapCharHom g).toAdd = g.toAdd.swap := by
  simp [swapCharHom]

/-- The sum character homomorphism `Multiplicative (ℤ × ℤ) →* Multiplicative ℤ` representing the
diagonal embedding `𝔾ₘ ↪ 𝔾ₘ²`. -/
def sumCharHom : Multiplicative (ℤ × ℤ) →* Multiplicative ℤ :=
  AddMonoidHom.toMultiplicative (AddMonoidHom.fst ℤ ℤ + AddMonoidHom.snd ℤ ℤ)

/-- `sumCharHom` adds the additive coordinates of `Multiplicative.ofAdd p`. -/
@[simp]
theorem sumCharHom_ofAdd (p : ℤ × ℤ) :
    sumCharHom (Multiplicative.ofAdd p) = Multiplicative.ofAdd (p.1 + p.2) := by
  simp [sumCharHom]

/-- `toAdd` of `sumCharHom g` is the sum of the additive coordinates of `g.toAdd`. -/
@[simp]
theorem toAdd_sumCharHom (g : Multiplicative (ℤ × ℤ)) :
    (sumCharHom g).toAdd = g.toAdd.1 + g.toAdd.2 := by
  simp [sumCharHom]

private theorem sumCharHom_surjective : Function.Surjective sumCharHom := fun y ↦
  ⟨Multiplicative.ofAdd (y.toAdd, 0), Multiplicative.toAdd.injective (by simp)⟩

private theorem ker_sumCharHom :
    sumCharHom.ker =
      Subgroup.closure
        {x : Multiplicative (ℤ × ℤ) |
          ∃ (_ : Unit) (g : Multiplicative (ℤ × ℤ)), swapCharHom g * g⁻¹ = x} := by
  apply le_antisymm
  · intro x hx
    rw [MonoidHom.mem_ker] at hx
    have hx' : x.toAdd.1 + x.toAdd.2 = 0 := by simpa using congrArg Multiplicative.toAdd hx
    refine Subgroup.subset_closure ⟨(), Multiplicative.ofAdd (0, x.toAdd.1), ?_⟩
    apply Multiplicative.toAdd.injective
    (ext <;> simp); omega
  · rw [Subgroup.closure_le]
    rintro _ ⟨⟨⟩, g, rfl⟩
    rw [SetLike.mem_coe, MonoidHom.mem_ker]
    apply Multiplicative.toAdd.injective
    simp
    omega

/-- **Fixed points of factor swap on `𝔾ₘ²` are the diagonal `𝔾ₘ`:** over every commutative ring `R`,
the fixed-point quotient of `𝔾ₘ² = D(Multiplicative (ℤ × ℤ))` under `swapCharHom` is isomorphic in
`CommHopfAlgCat R` to `𝔾ₘ = D(Multiplicative ℤ)`. -/
def fixedPointSwapIso (R : Type u) [CommRing R] :
    _root_.CommHopfAlgCat.quotient
        (_root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative (ℤ × ℤ))))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun _ : Unit ↦
            _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R swapCharHom))) ≅
      _root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative ℤ)) :=
  fixedPointCoordinateIsoOfSurjective R (fun _ : Unit ↦ swapCharHom) sumCharHom
    sumCharHom_surjective ker_sumCharHom

/-- Composing `mkQuotient` with `(fixedPointSwapIso R).hom` gives the diagonal coordinate map
induced by `sumCharHom`. -/
@[reassoc (attr := simp)]
theorem mkQuotient_comp_fixedPointSwapIso_hom (R : Type u) [CommRing R] :
    _root_.CommHopfAlgCat.mkQuotient
        (_root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative (ℤ × ℤ))))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun _ : Unit ↦
            _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R swapCharHom))) ≫
        (fixedPointSwapIso R).hom =
      _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R sumCharHom) :=
  mkQuotient_comp_fixedPointCoordinateIsoOfSurjective_hom R _ _ _ _

/-- Composing `mapDomainBialgHom R sumCharHom` with `(fixedPointSwapIso R).inv` recovers
`mkQuotient`. -/
@[reassoc (attr := simp)]
theorem ofHom_mapDomainBialgHom_sumCharHom_comp_fixedPointSwapIso_inv (R : Type u) [CommRing R] :
    _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R sumCharHom) ≫
        (fixedPointSwapIso R).inv =
      _root_.CommHopfAlgCat.mkQuotient
        (_root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative (ℤ × ℤ))))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun _ : Unit ↦
            _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R swapCharHom))) :=
  ofHom_mapDomainBialgHom_comp_fixedPointCoordinateIsoOfSurjective_inv R _ _ _ _

/-- Over every integral domain `R`, the fixed-point subgroup scheme `(𝔾ₘ²)^{swap}` has connected
prime spectrum. -/
theorem connectedSpace_primeSpectrum_quotient_fixedPointSwap (R : Type u) [CommRing R]
    [IsDomain R] :
    ConnectedSpace (PrimeSpectrum
      (_root_.CommHopfAlgCat.quotient
        (_root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative (ℤ × ℤ))))
        (CommHopfAlgCat.fixedPointHopfIdeal
          (fun _ : Unit ↦
            _root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R swapCharHom))))) :=
  let e := (_root_.CommHopfAlgCat.ofIso (fixedPointSwapIso R)).toAlgEquiv.toRingEquiv
  (PrimeSpectrum.homeomorphOfRingEquiv e).connectedSpace_iff.mpr inferInstance

end Swap

end TauCeti.DiagonalizableGroup
