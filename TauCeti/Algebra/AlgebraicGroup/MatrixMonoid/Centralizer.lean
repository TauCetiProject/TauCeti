module

public import TauCeti.Algebra.AlgebraicGroup.MatrixMonoid.Bialgebra

/-!
# The affine scheme of matrices commuting with a fixed matrix

The entries of `YX - XY`, with `Y` the generic matrix, are linear polynomial equations
defining the commuting-matrix scheme of `X`. Their ideal describes commuting matrices
over every commutative value algebra, including nonreduced ones. Inverting the determinant
in this coordinate ring gives the group centralizer in the general linear group.

## References

* J. S. Milne, *Algebraic Groups* (2017), Chapter 10.
* D. H. Collingwood and W. M. McGovern, *Nilpotent Orbits in Semisimple Lie Algebras*,
  §6.1.
-/

public section

noncomputable section

namespace Matrix

variable {R ι : Type*} [CommRing R] [Fintype ι]

/-- The linear equations defining the affine scheme of matrices commuting with `X`. -/
def centralizerIdeal (X : Matrix ι ι R) : Ideal (MvPolynomial (ι × ι) R) :=
  Ideal.span (Set.range fun ij : ι × ι ↦
    (Matrix.mvPolynomialX ι ι R * X.map (MvPolynomial.C : R →+* MvPolynomial (ι × ι) R) -
      X.map MvPolynomial.C * Matrix.mvPolynomialX ι ι R :
        Matrix ι ι (MvPolynomial (ι × ι) R)) ij.1 ij.2)

/-- The centralizer ideal is generated by the entries of the generic commutator. -/
theorem centralizerIdeal_def (X : Matrix ι ι R) :
    centralizerIdeal X = Ideal.span (Set.range fun ij : ι × ι ↦
      (Matrix.mvPolynomialX ι ι R * X.map (MvPolynomial.C : R →+* MvPolynomial (ι × ι) R) -
        X.map MvPolynomial.C * Matrix.mvPolynomialX ι ι R :
        Matrix ι ι (MvPolynomial (ι × ι) R)) ij.1 ij.2) := (rfl)

/-- A polynomial point satisfies the centralizer equations exactly when its matrix commutes
with the base change of `X`. No reducedness assumption is imposed on the value algebra. -/
theorem centralizerIdeal_le_ker_iff {A : Type*} [CommRing A] [Algebra R A]
    (X : Matrix ι ι R) (f : MvPolynomial (ι × ι) R →ₐ[R] A) :
    centralizerIdeal X ≤ RingHom.ker f ↔
      Commute ((Matrix.mvPolynomialX ι ι R).map f) (X.map (algebraMap R A)) := by
  classical
  rw [centralizerIdeal_def, Ideal.span_le]
  simp only [Set.range_subset_iff]
  have hX : (X.map MvPolynomial.C).map f = X.map (algebraMap R A) := by
    ext i j
    simp
  rw [commute_iff_eq, ← sub_eq_zero, ← hX]
  simp only [← AlgHom.mapMatrix_apply, ← map_mul, ← map_sub]
  exact ⟨fun h ↦ Matrix.ext fun i j ↦ h (i, j), fun h ij ↦ congrFun (congrFun h ij.1) ij.2⟩

end Matrix
