module

public import Mathlib.LinearAlgebra.Matrix.MvPolynomial
public import TauCeti.Algebra.AlgebraicGroup.MatrixMonoid.Bialgebra

/-!
# The centralizer of a matrix in the matrix affine space

For a commutative ring `R`, a finite type `ι` and a square matrix `X` over `R`, the matrices
commuting with `X` form a closed subscheme of the affine space of matrices with coordinate ring
`R[Yᵢⱼ]`. It is cut out by the linear equations `Y X = X Y`: the ideal
`TauCeti.MatrixMonoid.centralizerIdeal X` is generated by the entries of `G X - X G`, where `G` is
the generic matrix `Matrix.mvPolynomialX`.

Its points are what they should be: an algebra homomorphism `φ` from `R[Yᵢⱼ]` to a commutative
`R`-algebra `A` kills the ideal exactly when the matrix `G.map φ` commutes with the image of `X`
in `Matrix ι ι A` (`TauCeti.MatrixMonoid.centralizerIdeal_le_ker_iff`). Thus the quotient by
`centralizerIdeal X` is the coordinate ring of the closed subscheme of matrices commuting with
`X`: its points with values in every commutative `R`-algebra, including nonreduced ones, are
exactly those matrices.

## Main declarations

* `TauCeti.MatrixMonoid.centralizerIdeal`: the ideal of matrices commuting with `X`.
* `TauCeti.MatrixMonoid.centralizerIdeal_le_ker_iff`: its points are the matrices commuting
  with `X`.

## References

* J. S. Milne, *Algebraic Groups* (2017), Chapter 1, for affine schemes and their closed
  subschemes through their points over all algebras.
-/

public section

namespace TauCeti.MatrixMonoid

variable {R : Type*} [CommRing R] {ι : Type*} [Fintype ι]

/-- The ideal of the matrix affine space cut out by the linear equations `Y X = X Y`: it is
generated by the entries of `G X - X G`, where `G` is the generic matrix. -/
noncomputable def centralizerIdeal (X : Matrix ι ι R) : Ideal (CoordinateRing R ι) :=
  Ideal.span (Set.range fun ij : ι × ι ↦
    (Matrix.mvPolynomialX ι ι R * X.map MvPolynomial.C -
      X.map MvPolynomial.C * Matrix.mvPolynomialX ι ι R : Matrix ι ι (CoordinateRing R ι))
      ij.1 ij.2)

/-- The centralizer ideal is generated by the entries of the commutator of the generic matrix
with `X`. -/
theorem centralizerIdeal_def (X : Matrix ι ι R) :
    centralizerIdeal X = Ideal.span (Set.range fun ij : ι × ι ↦
      (Matrix.mvPolynomialX ι ι R * X.map MvPolynomial.C -
        X.map MvPolynomial.C * Matrix.mvPolynomialX ι ι R : Matrix ι ι (CoordinateRing R ι))
        ij.1 ij.2) :=
  (rfl)

/-- **The points of the centralizer of a matrix.** An algebra homomorphism `φ` out of the
coordinate ring of the matrix affine space kills the centralizer ideal of `X` exactly when the
matrix `G.map φ` of the corresponding point commutes with the image of `X`. -/
theorem centralizerIdeal_le_ker_iff {A : Type*} [CommRing A] [Algebra R A]
    (X : Matrix ι ι R) (φ : CoordinateRing R ι →ₐ[R] A) :
    centralizerIdeal X ≤ RingHom.ker φ ↔
      Commute ((Matrix.mvPolynomialX ι ι R).map φ) (X.map (algebraMap R A)) := by
  classical
  have hX : (X.map MvPolynomial.C).map φ = X.map (algebraMap R A) := by
    ext i j
    simp
  have hmap : φ.mapMatrix (Matrix.mvPolynomialX ι ι R * X.map MvPolynomial.C -
        X.map MvPolynomial.C * Matrix.mvPolynomialX ι ι R) =
      (Matrix.mvPolynomialX ι ι R).map φ * X.map (algebraMap R A) -
        X.map (algebraMap R A) * (Matrix.mvPolynomialX ι ι R).map φ := by
    simp only [map_sub, map_mul, AlgHom.mapMatrix_apply, hX]
  rw [centralizerIdeal, Ideal.span_le, Set.range_subset_iff, commute_iff_eq, ← sub_eq_zero,
    ← hmap, ← Matrix.ext_iff]
  simp [Prod.forall, RingHom.mem_ker]

end TauCeti.MatrixMonoid
