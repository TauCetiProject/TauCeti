/-!
# The dual of the binary forms: its simple head and its highest lines

Let `R_d = k[x, y]_d` be the binary forms of degree `d` over a field `k`, a rational
representation of `SL₂` (`TauCeti.SpecialLinear.binaryForms`), and let `R_d*` be its dual
representation. In every characteristic `R_d` has a simple socle, the subrepresentation generated
by the highest weight vector `yᵈ`, which lies in every nonzero subrepresentation
(`TauCeti.SpecialLinear.binaryFormsSocle_le_of_ne_bot`). Dually, `R_d*` has a unique maximal
proper subrepresentation: the annihilator of that socle contains every proper subrepresentation
of `R_d*`. Its simple quotient is the head of `R_d*`.

Since `xᵈ` lies in the socle, a subrepresentation of `R_d*` containing a functional that does not
vanish at `xᵈ` is everything. In particular the coordinate functional `δ_{xᵈ}`, dual to the
monomial `xᵈ`, generates `R_d*`, for every degree `d` and in every characteristic. This contrasts
with `R_d` itself, which in characteristic `p` is generated by its highest weight vector `yᵈ` only
when `d + 1 = (a + 1) pᵐ` for some `a < p` and some `m`
(`TauCeti.SpecialLinear.binaryFormsSocle_eq_binaryForms_iff_of_charP`).

The functional `δ_{xᵈ}` also spans a line stable under the upper-triangular subgroup `B⁺`: its
coaction restricted to `B⁺` is `δ_{xᵈ} ⊗ aᵈ`, where `a` is the upper-left entry of the generic
upper-triangular matrix. So `δ_{xᵈ}` is a highest weight vector of weight `d` which generates
`R_d*`. Classically `R_d*` is the Weyl module `Δ(d)`; that identification is not proved here.

More generally, for `i + j = d` the coordinate functional `δ_{xⁱ yʲ}` spans a `B⁺`-stable line
exactly when `l choose i` vanishes in `k` for every `i < l ≤ d`. In characteristic zero this
leaves only `δ_{xᵈ}`. In characteristic `p > 0` the functional `δ_{xᵖ⁻¹ y}` on `R_p` spans a
second `B⁺`-stable line, since `p choose (p - 1) = p`: unlike the binary forms `R_d`, whose
`B⁺`-stable line `k yᵈ` is unique over every field
(`TauCeti.SpecialLinear.exists_lTensor_coact_eq_tmul_iff_mem_span`), the dual `R_p*` has more than
one. Stability is meant scheme-theoretically, through the coaction, so over a finite field it is
stronger than invariance under the rational points of `B⁺`.

The proofs about the head transport the socle of `R_d` through the order-reversing correspondence
between subcomodules of a finite-dimensional comodule and of its dual
(`TauCeti.Subcomodule.dualAnnihilatorOrderIso`). The proofs about stable lines compute the matrix
coefficients `c(δ_{xⁱ yʲ}, xᵃ yᵇ)` after applying the antipode and restricting to `B⁺`. The
representation `R_d` acts by `(g f)(v) = f(g⁻¹ v)`, so its matrix coefficients involve the entries
of `g⁻¹`; the antipode turns them back into entries `gᵢⱼ` of the generic upper-triangular matrix
`g`, and the antipode-transformed coaction sends `f` to `f(g v)`. It sends `xᵃ yᵇ` to
`(g₀₀ x + g₀₁ y)ᵃ (g₁₁ y)ᵇ`, whose coefficient of `xⁱ yʲ` is `(a choose i) g₀₀ⁱ g₀₁ᵃ⁻ⁱ g₁₁ᵇ`.

## Main declarations

* `TauCeti.SpecialLinear.le_dualAnnihilator_comap_binaryFormsSocle`: every proper
  subrepresentation of `R_d*` annihilates the socle of `R_d`.
* `TauCeti.SpecialLinear.isCoatom_dualAnnihilator_comap_binaryFormsSocle`: the annihilator of the
  socle is the unique maximal proper subrepresentation of `R_d*`.
* `TauCeti.SpecialLinear.eq_top_of_apply_X_zero_pow_ne_zero`: a subrepresentation of `R_d*`
  containing a functional not vanishing at `xᵈ` is everything.
* `TauCeti.SpecialLinear.eq_top_of_lcoeff_comp_subtype_mem`: the coordinate functional `δ_{xᵈ}`
  generates `R_d*`.
* `TauCeti.SpecialLinear.lTensor_coact_lcoeff_single_comp_subtype`: `δ_{xᵈ}` spans a `B⁺`-stable
  line of weight `d`.
* `TauCeti.SpecialLinear.lTensor_coact_lcoeff_comp_subtype_of_choose_eq_zero` and
  `TauCeti.SpecialLinear.exists_lTensor_coact_lcoeff_comp_subtype_eq_tmul_iff`: the coordinate
  functional `δ_{xⁱ yʲ}` spans a `B⁺`-stable line exactly when every `l choose i` with
  `i < l ≤ d` vanishes in `k`.
* `TauCeti.SpecialLinear.exists_lTensor_coact_lcoeff_comp_subtype_eq_tmul_iff_of_charZero`: in
  characteristic zero only `δ_{xᵈ}` does.
* `TauCeti.SpecialLinear.lcoeff_comp_subtype_notMem_span_singleton`: distinct coordinate
  functionals span distinct lines.
* `TauCeti.SpecialLinear.lTensor_coact_lcoeff_single_sub_one_add_single_comp_subtype`: in
  characteristic `p > 0`, `δ_{xᵖ⁻¹ y}` spans a second `B⁺`-stable line of `R_p*`.

## References

* J. C. Jantzen, *Representations of Algebraic Groups*, 2nd ed., II.2.13 and II.2.16.
-/

public section

namespace TauCeti.SpecialLinear

universe u

variable {k : Type u} [Field k] {d : ℕ}

attribute [local instance] polynomialComodule Comodule.dual

/-- **Every proper subrepresentation of the dual binary forms annihilates the socle.** A
subrepresentation `W ≠ R_d*` vanishes on the socle of `R_d`: its common kernel is a nonzero
subrepresentation of `R_d`, so it contains the socle. -/
theorem le_dualAnnihilator_comap_binaryFormsSocle
    {W : Subcomodule k (coordinateHopfAlgebra k 2) (Module.Dual k (binaryForms k d))}
    (hW : W ≠ ⊤) :
    W ≤ ((binaryFormsSocle k d).comap (Subcomodule.subtype (binaryForms k d))).dualAnnihilator := by
  rw [← Subcomodule.dualCoannihilator_dualAnnihilator W,
    Subcomodule.dualAnnihilator_le_dualAnnihilator_iff]
  set N := W.dualCoannihilator
  have hN : N ≠ ⊥ := Subcomodule.dualCoannihilator_eq_bot_iff.not.mpr hW
  -- The image of the common kernel in the polynomial functions is a nonzero subrepresentation
  -- of the binary forms, so it contains the socle.
  have hle : N.map (Subcomodule.subtype (binaryForms k d)) ≤ binaryForms k d := by
    intro f hf
    obtain ⟨g, -, rfl⟩ := Subcomodule.mem_map.mp hf
    rw [Subcomodule.subtype_apply]
    exact g.2
  have hne : N.map (Subcomodule.subtype (binaryForms k d)) ≠ ⊥ := by
    obtain ⟨g, hg, hg₀⟩ := Subcomodule.ne_bot_iff.mp hN
    refine Subcomodule.ne_bot_iff.mpr ⟨g, ?_, fun h ↦ hg₀ (Subtype.ext h)⟩
    simpa only [Subcomodule.subtype_apply] using
      Subcomodule.mem_map_of_mem (Subcomodule.subtype (binaryForms k d)) hg
  intro f hf
  obtain ⟨g, hg, hgf⟩ := Subcomodule.mem_map.mp
    (binaryFormsSocle_le_of_ne_bot hle hne (Subcomodule.mem_comap.mp hf))
  rw [Subcomodule.subtype_apply, Subcomodule.subtype_apply] at hgf
  rwa [← Subtype.ext hgf]

/-- **The simple head of the dual binary forms.** The annihilator of the socle of `R_d` is the
unique maximal proper subrepresentation of `R_d*`: it is proper, and it contains every proper
subrepresentation. -/
theorem isCoatom_dualAnnihilator_comap_binaryFormsSocle :
    IsCoatom ((binaryFormsSocle k d).comap
      (Subcomodule.subtype (binaryForms k d))).dualAnnihilator := by
  refine ⟨Subcomodule.dualAnnihilator_eq_top_iff.not.mpr fun h ↦ ?_, fun W hW ↦ ?_⟩
  · -- The socle contains the nonzero binary form `xᵈ`.
    have hx : (⟨_, X_zero_pow_mem_binaryForms⟩ : binaryForms k d) ∈
        (binaryFormsSocle k d).comap (Subcomodule.subtype (binaryForms k d)) := by
      simpa [Subcomodule.subtype_apply] using X_zero_pow_mem_binaryFormsSocle
    rw [h, Subcomodule.mem_bot] at hx
    exact pow_ne_zero d (MvPolynomial.X_ne_zero (R := k) (0 : Fin 2))
      (congrArg Subtype.val hx)
  · by_contra hW₀
    exact hW.not_ge (le_dualAnnihilator_comap_binaryFormsSocle hW₀)

/-- **Generation of the dual binary forms.** A subrepresentation of `R_d*` containing a
functional `φ` with `φ(xᵈ) ≠ 0` is all of `R_d*`, over every field and in every
characteristic. -/
theorem eq_top_of_apply_X_zero_pow_ne_zero
    {W : Subcomodule k (coordinateHopfAlgebra k 2) (Module.Dual k (binaryForms k d))}
    {φ : Module.Dual k (binaryForms k d)} (hφ : φ ∈ W)
    (h : φ ⟨_, X_zero_pow_mem_binaryForms⟩ ≠ 0) : W = ⊤ := by
  by_contra hW
  refine h (Subcomodule.mem_dualAnnihilator.mp (le_dualAnnihilator_comap_binaryFormsSocle hW hφ)
    _ ?_)
  simpa [Subcomodule.subtype_apply] using X_zero_pow_mem_binaryFormsSocle

/-- **The functional `δ_{xᵈ}` generates the dual binary forms.** The coordinate functional
`δ_{xᵈ}`, reading off the coefficient of `xᵈ`, generates `R_d*` as a representation: every
subrepresentation containing it is everything. This holds for every degree `d`, over every
field and in every characteristic. -/
theorem eq_top_of_lcoeff_comp_subtype_mem
    {W : Subcomodule k (coordinateHopfAlgebra k 2) (Module.Dual k (binaryForms k d))}
    (h : (MvPolynomial.lcoeff k (Finsupp.single 0 d)).comp
      (SMulMemClass.subtype (binaryForms k d)) ∈ W) : W = ⊤ :=
  eq_top_of_apply_X_zero_pow_ne_zero h (by
    classical
    simp [MvPolynomial.coeff_X_pow])

/-! ### Lines stable under the upper-triangular subgroup -/

section StableLine

open scoped TensorProduct

attribute [local instance] GeneralLinear.standardComodule standardComodule

/-- The antipode of `O(SL₂)` followed by restriction to the upper-triangular subgroup. -/
private noncomputable abbrev upperAntipode :
    coordinateHopfAlgebra k 2 →ₐ[k] UpperTriangular.coordinateHopfAlgebra k 2 :=
  ((UpperTriangular.coordinateMap k 2).hom : coordinateHopfAlgebra k 2 →ₐ[k] _).comp
    (_root_.HopfAlgebra.antipodeAlgHom k (coordinateHopfAlgebra k 2))

/-- The `(i, j)` entry of the generic upper-triangular matrix of determinant one. -/
private noncomputable abbrev upperEntry (i j : Fin 2) :
    UpperTriangular.coordinateHopfAlgebra k 2 :=
  (UpperTriangular.coordinateMap k 2).hom
    (Comodule.coefficientMatrix (C := coordinateHopfAlgebra k 2) (Pi.basisFun k (Fin 2)) i j)

/-- After the antipode and restriction to `B⁺`, the coaction sends `X i` to
`X 0 ⊗ gᵢ₀ + X 1 ⊗ gᵢ₁`: this is the action `f(v) ↦ f(g v)` of the generic upper-triangular
matrix `g`. -/
private theorem map_upperAntipode_coact_X (i : Fin 2) :
    Algebra.TensorProduct.map (AlgHom.id k (MvPolynomial (Fin 2) k)) (upperAntipode (k := k))
        (Comodule.polynomialCoact (coordinateHopfAlgebra k 2) (Pi.basisFun k (Fin 2))
          (MvPolynomial.X i)) =
      MvPolynomial.X 0 ⊗ₜ upperEntry i 0 + MvPolynomial.X 1 ⊗ₜ upperEntry i 1 := by
  rw [Comodule.polynomialCoact_X, Fin.sum_univ_two]
  simp only [← Comodule.coefficientMatrix_apply, Algebra.TensorProduct.map_tmul, map_add,
    AlgHom.id_apply, AlgHom.comp_apply, _root_.HopfAlgebra.antipodeAlgHom_apply,
    HopfAlgebra.antipode_antipode, BialgHom.coe_toAlgHom]

private theorem upperEntry_one_zero : upperEntry (k := k) 1 0 = 0 := by
  rw [upperEntry, coefficientMatrix_basisFun, Matrix.map_apply,
    UpperTriangular.coordinateMap_coordinateMap_genericMatrix_eq_zero_of_lt
      (by decide : (0 : Fin 2) < 1)]

/-- **The `B⁺`-coefficients of a monomial against `δ_{xⁱ yʲ}`.** Restricted to the
upper-triangular subgroup, the antipode of the matrix coefficient of `δ_{xⁱ yʲ}` and `xᵃ yᵇ` is
`(a choose i) g₀₀ⁱ g₀₁ᵃ⁻ⁱ g₁₁ᵇ`, in the entries `gᵢⱼ` of the generic upper-triangular matrix. -/
private theorem upperAntipode_matrixCoefficient {i j a b : ℕ} (h : i + j = a + b) :
    upperAntipode (k := k) (Comodule.matrixCoefficient (C := coordinateHopfAlgebra k 2)
        (MvPolynomial.lcoeff k (Finsupp.single (0 : Fin 2) i + Finsupp.single 1 j))
        (MvPolynomial.X 0 ^ a * MvPolynomial.X 1 ^ b : MvPolynomial (Fin 2) k)) =
      (a.choose i : k) • (upperEntry 0 0 ^ i * upperEntry 0 1 ^ (a - i) * upperEntry 1 1 ^ b) := by
  set ψ := MvPolynomial.lcoeff k (Finsupp.single (0 : Fin 2) i + Finsupp.single 1 j)
  -- Moving the restriction past the contraction with `ψ`.
  have hnat (y : MvPolynomial (Fin 2) k ⊗[k] coordinateHopfAlgebra k 2) :
      upperAntipode (k := k) (TensorProduct.lid k _ (TensorProduct.map ψ LinearMap.id y)) =
        TensorProduct.lid k _ (TensorProduct.map ψ LinearMap.id
          (Algebra.TensorProduct.map (AlgHom.id k _) (upperAntipode (k := k)) y)) := by
    have h := LinearMap.congr_fun
      (CoassocSimps.lid_comp_map ψ (upperAntipode (k := k)).toLinearMap) y
    rw [← AlgHom.toLinearMap_apply (Algebra.TensorProduct.map _ _)]
    simpa [TensorProduct.AlgebraTensorModule.map_eq, TensorProduct.map_map] using h.symm
  rw [Comodule.matrixCoefficient_def, hnat, polynomialComodule_coact, AlgHom.toLinearMap_apply]
  simp only [map_mul, map_pow]
  rw [map_upperAntipode_coact_X, map_upperAntipode_coact_X, upperEntry_one_zero,
    TensorProduct.tmul_zero, zero_add, add_pow, Finset.sum_mul, map_sum, map_sum]
  -- Only the term with `r = i` contributes to the coefficient of `xⁱ yʲ`.
  have hterm (r : ℕ) (hr : r ∈ Finset.range (a + 1)) :
      TensorProduct.lid k _ (TensorProduct.map ψ LinearMap.id
        ((MvPolynomial.X 0 ⊗ₜ[k] upperEntry (k := k) 0 0) ^ r *
            (MvPolynomial.X 1 ⊗ₜ[k] upperEntry (k := k) 0 1) ^ (a - r) *
            (a.choose r : MvPolynomial (Fin 2) k ⊗[k] UpperTriangular.coordinateHopfAlgebra k 2) *
          (MvPolynomial.X 1 ⊗ₜ[k] upperEntry (k := k) 1 1) ^ b)) =
        if r = i then
          (a.choose i : k) • (upperEntry 0 0 ^ i * upperEntry 0 1 ^ (a - i) * upperEntry 1 1 ^ b)
        else 0 := by
    have hr : r ≤ a := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
    have hmul : (MvPolynomial.X 0 ⊗ₜ[k] upperEntry (k := k) 0 0) ^ r *
          (MvPolynomial.X 1 ⊗ₜ[k] upperEntry (k := k) 0 1) ^ (a - r) *
          (a.choose r : MvPolynomial (Fin 2) k ⊗[k] UpperTriangular.coordinateHopfAlgebra k 2) *
        (MvPolynomial.X 1 ⊗ₜ[k] upperEntry (k := k) 1 1) ^ b =
        (a.choose r : k) • ((MvPolynomial.X 0 ^ r * MvPolynomial.X 1 ^ (a - r + b) :
            MvPolynomial (Fin 2) k) ⊗ₜ[k]
          (upperEntry 0 0 ^ r * upperEntry 0 1 ^ (a - r) * upperEntry 1 1 ^ b)) := by
      simp only [Algebra.TensorProduct.tmul_pow, Algebra.TensorProduct.tmul_mul_tmul,
        ← nsmul_eq_mul', smul_mul_assoc, Nat.cast_smul_eq_nsmul, pow_add]
      ring_nf
    simp only [hmul, map_smul, TensorProduct.map_tmul, TensorProduct.lid_tmul, LinearMap.id_apply,
      ψ, MvPolynomial.lcoeff_apply, MvPolynomial.coeff_X_zero_pow_mul_X_one_pow]
    by_cases hri : r = i
    · subst hri
      simp [show a - r + b = j by omega]
    · simp [hri]
  rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq']
  split_ifs with hi
  · rfl
  · rw [Nat.choose_eq_zero_of_lt (by simpa using hi), Nat.cast_zero, zero_smul]

/-- A functional on `k[x, y]` restricted to `R_d` has the same matrix coefficients on `R_d` as
the functional itself. -/
private theorem matrixCoefficient_comp_subtype (φ : Module.Dual k (MvPolynomial (Fin 2) k))
    (f : binaryForms k d) :
    Comodule.matrixCoefficient (C := coordinateHopfAlgebra k 2)
        (φ.comp (SMulMemClass.subtype (binaryForms k d))) f =
      Comodule.matrixCoefficient (C := coordinateHopfAlgebra k 2) φ
        (f : MvPolynomial (Fin 2) k) := by
  rw [← Subcomodule.subtype_toLinearMap, ← Comodule.matrixCoefficient_map,
    Subcomodule.subtype_apply]

/-- The restricted coaction of a coordinate functional `δ` on `R_d` is `δ ⊗ h` exactly when
the restricted antipode of each matrix coefficient `c(δ, f)` is `δ(f) h`. -/
private theorem lTensor_coact_lcoeff_comp_subtype_eq_tmul_iff {s : Fin 2 →₀ ℕ}
    (h : UpperTriangular.coordinateHopfAlgebra k 2) :
    (UpperTriangular.coordinateMap k 2).hom.toLinearMap.lTensor (Module.Dual k (binaryForms k d))
        (Comodule.coact (R := k) (C := coordinateHopfAlgebra k 2)
          ((MvPolynomial.lcoeff k s).comp (SMulMemClass.subtype (binaryForms k d)))) =
        (MvPolynomial.lcoeff k s).comp (SMulMemClass.subtype (binaryForms k d)) ⊗ₜ h ↔
      ∀ f ∈ binaryForms k d,
        upperAntipode (k := k) (Comodule.matrixCoefficient (C := coordinateHopfAlgebra k 2)
          (MvPolynomial.lcoeff k s) f) = f.coeff s • h := by
  rw [Comodule.dual_coact]
  have hinj := (dualTensorHom_bijective (R := k) (M := binaryForms k d)
    (N := UpperTriangular.coordinateHopfAlgebra k 2)).1
  rw [← hinj.eq_iff, LinearMap.ext_iff, Subtype.forall]
  refine forall₂_congr fun f hf ↦ ?_
  have hl (x : Module.Dual k (binaryForms k d) ⊗[k] coordinateHopfAlgebra k 2) :
      dualTensorHom k (binaryForms k d) (UpperTriangular.coordinateHopfAlgebra k 2)
          ((UpperTriangular.coordinateMap k 2).hom.toLinearMap.lTensor _ x) =
        (UpperTriangular.coordinateMap k 2).hom.toLinearMap ∘ₗ
          dualTensorHom k (binaryForms k d) (coordinateHopfAlgebra k 2) x :=
    LinearMap.congr_fun (dualTensorHom_comp_lTensor _) x
  rw [hl, LinearMap.comp_apply, Comodule.dualTensorHom_dualCoact_apply, dualTensorHom_apply,
    matrixCoefficient_comp_subtype]
  simp only [LinearMap.comp_apply, SMulMemClass.coe_subtype, MvPolynomial.lcoeff_apply]
  -- `upperAntipode` is by definition the antipode followed by the restriction map.
  rfl

/-- The rational point `[[1, 1], [0, 1]]` of the upper-triangular subgroup takes the value one on
the three entries `a`, `b`, `d` of the generic upper-triangular matrix. -/
private theorem exists_algHom_upperEntry_eq_one :
    ∃ u : UpperTriangular.coordinateHopfAlgebra k 2 →ₐ[k] k,
      u (upperEntry 0 0) = 1 ∧ u (upperEntry 0 1) = 1 ∧ u (upperEntry 1 1) = 1 := by
  let v : Matrix.SpecialLinearGroup (Fin 2) k := ⟨!![1, 1; 0, 1], by simp [Matrix.det_fin_two]⟩
  have hv : v ∈ (upperTriangularGroup (Fin 2) k).comap Matrix.SpecialLinearGroup.toGL := by
    rw [UpperTriangularGroup.mem_comap_toGL_iff]
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [v]
  let uB := (UpperTriangular.pointsMulEquiv k 2 (A := k)).symm ⟨v, hv⟩
  let g := CommHopfAlgCat.quotientPointsHom (coordinateHopfAlgebra k 2)
    (UpperTriangular.definingHopfIdeal k 2) (CommAlgCat.of k k) uB
  have hg (i j : Fin 2) : uB.ofConv (upperEntry i j) =
      (pointsMulEquiv (R := k) (A := k) 2 g : Matrix (Fin 2) (Fin 2) k) i j := by
    rw [← ofConv_coefficientMatrix]
    simp [g, upperEntry]
  refine ⟨uB.ofConv, ?_, ?_, ?_⟩ <;> simp [hg, g, uB, v]

/-- If every `l choose i` with `i < l ≤ d` vanishes in `k`, then for every binary form `f` of
degree `d` the restricted antipode of `c(δ_{xⁱ yʲ}, f)` is `δ_{xⁱ yʲ}(f) g₀₀ⁱ g₁₁ʲ`. -/
private theorem upperAntipode_matrixCoefficient_lcoeff_of_choose_eq_zero {i j : ℕ}
    (hij : i + j = d) (hl : ∀ l, i < l → l ≤ d → (l.choose i : k) = 0)
    {f : MvPolynomial (Fin 2) k} (hf : f ∈ binaryForms k d) :
    upperAntipode (k := k) (Comodule.matrixCoefficient (C := coordinateHopfAlgebra k 2)
        (MvPolynomial.lcoeff k (Finsupp.single (0 : Fin 2) i + Finsupp.single 1 j)) f) =
      f.coeff (Finsupp.single 0 i + Finsupp.single 1 j) •
        (upperEntry 0 0 ^ i * upperEntry 1 1 ^ j) := by
  -- Both sides are linear in `f`, so it suffices to compare them on the monomials of `f`.
  set ψ := MvPolynomial.lcoeff k (Finsupp.single (0 : Fin 2) i + Finsupp.single 1 j)
  have hL₁ (g : MvPolynomial (Fin 2) k) :
      upperAntipode (k := k) (Comodule.matrixCoefficient (C := coordinateHopfAlgebra k 2) ψ g) =
        ((upperAntipode (k := k)).toLinearMap ∘ₗ
          Comodule.matrixCoefficientBilinear (C := coordinateHopfAlgebra k 2) ψ) g := by
    rw [LinearMap.comp_apply, Comodule.matrixCoefficientBilinear_apply_apply,
      AlgHom.toLinearMap_apply]
  have hL₂ (g : MvPolynomial (Fin 2) k) :
      g.coeff (Finsupp.single 0 i + Finsupp.single 1 j) •
          (upperEntry (k := k) 0 0 ^ i * upperEntry 1 1 ^ j) =
        (ψ.smulRight (upperEntry (k := k) 0 0 ^ i * upperEntry 1 1 ^ j)) g := by
    rw [LinearMap.smulRight_apply, MvPolynomial.lcoeff_apply]
  rw [hL₁, hL₂, ← f.support_sum_monomial_coeff, map_sum, map_sum]
  refine Finset.sum_congr rfl fun t ht ↦ ?_
  have ht' : t 0 + t 1 = d := (mem_binaryForms.mp hf).add_eq_of_mem_support ht
  have hmono : MvPolynomial.monomial t (f.coeff t) =
      f.coeff t • (MvPolynomial.X 0 ^ t 0 * MvPolynomial.X 1 ^ t 1 : MvPolynomial (Fin 2) k) := by
    rw [MvPolynomial.monomial_fin_two, mul_assoc, ← MvPolynomial.smul_eq_C_mul]
  rw [hmono, map_smul, map_smul, ← hL₁, ← hL₂, upperAntipode_matrixCoefficient (by omega),
    MvPolynomial.coeff_X_zero_pow_mul_X_one_pow]
  congr 1
  rcases lt_trichotomy (t 0) i with hlt | heq | hgt
  · simp [Nat.choose_eq_zero_of_lt hlt, hlt.ne]
  · simp [heq, show t 1 = j by omega]
  · simp [hl _ hgt (by omega), hgt.ne']

/-- **Restricted coaction of a coordinate functional on the dual binary forms.** If every
`l choose i` with `i < l ≤ d` vanishes in `k`, then restricted to the upper-triangular subgroup
the coaction of the coordinate functional `δ_{xⁱ yʲ}` on `R_d*` is `δ_{xⁱ yʲ} ⊗ g₀₀ⁱ g₁₁ʲ`,
where `g₀₀` and `g₁₁` are the diagonal entries of the generic upper-triangular matrix. So
`δ_{xⁱ yʲ}` spans a `B⁺`-stable line of weight `i - j`. -/
theorem lTensor_coact_lcoeff_comp_subtype_of_choose_eq_zero {i j : ℕ} (hij : i + j = d)
    (hl : ∀ l, i < l → l ≤ d → (l.choose i : k) = 0) :
    (UpperTriangular.coordinateMap k 2).hom.toLinearMap.lTensor (Module.Dual k (binaryForms k d))
        (Comodule.coact (R := k) (C := coordinateHopfAlgebra k 2)
          ((MvPolynomial.lcoeff k (Finsupp.single 0 i + Finsupp.single 1 j)).comp
            (SMulMemClass.subtype (binaryForms k d)))) =
      (MvPolynomial.lcoeff k (Finsupp.single 0 i + Finsupp.single 1 j)).comp
          (SMulMemClass.subtype (binaryForms k d)) ⊗ₜ
        ((UpperTriangular.coordinateMap k 2).hom
            (Comodule.coefficientMatrix (C := coordinateHopfAlgebra k 2) (Pi.basisFun k (Fin 2))
              0 0) ^ i *
          (UpperTriangular.coordinateMap k 2).hom
            (Comodule.coefficientMatrix (C := coordinateHopfAlgebra k 2) (Pi.basisFun k (Fin 2))
              1 1) ^ j) :=
  (lTensor_coact_lcoeff_comp_subtype_eq_tmul_iff _).mpr fun _ hf ↦
    upperAntipode_matrixCoefficient_lcoeff_of_choose_eq_zero hij hl hf

/-- **The `B⁺`-stable coordinate lines of the dual binary forms.** For `i + j = d`, the coordinate
functional `δ_{xⁱ yʲ}` on `R_d` spans a line of `R_d*` stable under the upper-triangular
subgroup, that is, its restricted coaction is `δ_{xⁱ yʲ} ⊗ h` for some function `h`, exactly when
every `l choose i` with `i < l ≤ d` vanishes in `k`. Stability is scheme-theoretic, so over a
finite field it is stronger than invariance under the rational points. -/
theorem exists_lTensor_coact_lcoeff_comp_subtype_eq_tmul_iff {i j : ℕ} (hij : i + j = d) :
    (∃ h : UpperTriangular.coordinateHopfAlgebra k 2,
      (UpperTriangular.coordinateMap k 2).hom.toLinearMap.lTensor (Module.Dual k (binaryForms k d))
          (Comodule.coact (R := k) (C := coordinateHopfAlgebra k 2)
            ((MvPolynomial.lcoeff k (Finsupp.single 0 i + Finsupp.single 1 j)).comp
              (SMulMemClass.subtype (binaryForms k d)))) =
        (MvPolynomial.lcoeff k (Finsupp.single 0 i + Finsupp.single 1 j)).comp
          (SMulMemClass.subtype (binaryForms k d)) ⊗ₜ h) ↔
      ∀ l, i < l → l ≤ d → (l.choose i : k) = 0 := by
  refine ⟨fun ⟨h, hh⟩ l hil hld ↦ ?_,
    fun hl ↦ ⟨_, lTensor_coact_lcoeff_comp_subtype_of_choose_eq_zero hij hl⟩⟩
  rw [lTensor_coact_lcoeff_comp_subtype_eq_tmul_iff] at hh
  -- The monomial `xˡ yᵈ⁻ˡ` is killed by `δ_{xⁱ yʲ}`, so `(l choose i) g₀₀ⁱ g₀₁ˡ⁻ⁱ g₁₁ᵈ⁻ˡ`
  -- vanishes; evaluate it at the rational point `[[1, 1], [0, 1]]`.
  have hmem : (MvPolynomial.X 0 ^ l * MvPolynomial.X 1 ^ (d - l) : MvPolynomial (Fin 2) k) ∈
      binaryForms k d := by
    have := (MvPolynomial.isHomogeneous_X_pow (R := k) (0 : Fin 2) l).mul
      (MvPolynomial.isHomogeneous_X_pow (1 : Fin 2) (d - l))
    rwa [Nat.add_sub_cancel' hld, ← mem_binaryForms] at this
  have hzero := hh _ hmem
  rw [upperAntipode_matrixCoefficient (by omega),
    MvPolynomial.coeff_X_zero_pow_mul_X_one_pow] at hzero
  simp only [show ¬(l = i ∧ d - l = j) by omega, ↓reduceIte, zero_smul] at hzero
  obtain ⟨u, h₀, h₁, h₂⟩ := exists_algHom_upperEntry_eq_one (k := k)
  simpa [h₀, h₁, h₂] using congrArg u hzero

/-- **In characteristic zero the highest line is the only `B⁺`-stable coordinate line.** For
`i + j = d`, the coordinate functional `δ_{xⁱ yʲ}` spans a `B⁺`-stable line of `R_d*` exactly when
`i = d`, that is, when it is `δ_{xᵈ}`. -/
theorem exists_lTensor_coact_lcoeff_comp_subtype_eq_tmul_iff_of_charZero [CharZero k] {i j : ℕ}
    (hij : i + j = d) :
    (∃ h : UpperTriangular.coordinateHopfAlgebra k 2,
      (UpperTriangular.coordinateMap k 2).hom.toLinearMap.lTensor (Module.Dual k (binaryForms k d))
          (Comodule.coact (R := k) (C := coordinateHopfAlgebra k 2)
            ((MvPolynomial.lcoeff k (Finsupp.single 0 i + Finsupp.single 1 j)).comp
              (SMulMemClass.subtype (binaryForms k d)))) =
        (MvPolynomial.lcoeff k (Finsupp.single 0 i + Finsupp.single 1 j)).comp
          (SMulMemClass.subtype (binaryForms k d)) ⊗ₜ h) ↔ i = d := by
  rw [exists_lTensor_coact_lcoeff_comp_subtype_eq_tmul_iff hij]
  refine ⟨fun hl ↦ ?_, fun hid l hil hld ↦ absurd hld (by omega)⟩
  by_contra hid
  exact Nat.cast_ne_zero.mpr (Nat.choose_pos (Nat.le_succ i)).ne' (hl (i + 1) (by omega) (by omega))

/-- **The highest line of the dual binary forms.** Restricted to the upper-triangular subgroup,
the coaction of the coordinate functional `δ_{xᵈ}` on `R_d*` is `δ_{xᵈ} ⊗ aᵈ`, where `a` is the
upper-left entry of the generic upper-triangular matrix: `δ_{xᵈ}` spans a `B⁺`-stable line of
weight `d`, in every characteristic. -/
theorem lTensor_coact_lcoeff_single_comp_subtype :
    (UpperTriangular.coordinateMap k 2).hom.toLinearMap.lTensor (Module.Dual k (binaryForms k d))
        (Comodule.coact (R := k) (C := coordinateHopfAlgebra k 2)
          ((MvPolynomial.lcoeff k (Finsupp.single 0 d)).comp
            (SMulMemClass.subtype (binaryForms k d)))) =
      (MvPolynomial.lcoeff k (Finsupp.single 0 d)).comp (SMulMemClass.subtype (binaryForms k d)) ⊗ₜ
        ((UpperTriangular.coordinateMap k 2).hom
          (Comodule.coefficientMatrix (C := coordinateHopfAlgebra k 2) (Pi.basisFun k (Fin 2))
            0 0) ^ d) := by
  simpa using lTensor_coact_lcoeff_comp_subtype_of_choose_eq_zero (k := k) (i := d) (j := 0)
    (add_zero d) fun l hdl hld ↦ absurd hld (by omega)

/-- **Distinct coordinate functionals span distinct lines.** If `xˢ` is a binary form of
degree `d` and `t ≠ s`, the coordinate functional `δ_{xˢ}` on `R_d` is not a multiple of
`δ_{xᵗ}`. -/
theorem lcoeff_comp_subtype_notMem_span_singleton {s t : Fin 2 →₀ ℕ} (hs : s 0 + s 1 = d)
    (hst : s ≠ t) :
    (MvPolynomial.lcoeff k s).comp (SMulMemClass.subtype (binaryForms k d)) ∉
      k ∙ (MvPolynomial.lcoeff k t).comp (SMulMemClass.subtype (binaryForms k d)) := by
  -- Evaluate both functionals at the monomial `xˢ`.
  intro hmem
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
  have hx : (MvPolynomial.monomial s 1 : MvPolynomial (Fin 2) k) ∈ binaryForms k d :=
    mem_binaryForms.mpr (MvPolynomial.isHomogeneous_monomial _ (by
      rw [Finsupp.degree_eq_sum, Fin.sum_univ_two, hs]))
  have := LinearMap.congr_fun hc ⟨_, hx⟩
  simp [MvPolynomial.coeff_monomial, hst] at this

variable (p : ℕ) [CharP k p]

/-- **A second `B⁺`-stable line in characteristic `p`.** In characteristic `p > 0`, restricted to
the upper-triangular subgroup, the coaction of the coordinate functional `δ_{xᵖ⁻¹ y}` on `R_p*` is
`δ_{xᵖ⁻¹ y} ⊗ g₀₀ᵖ⁻¹ g₁₁`, where `g₀₀` and `g₁₁` are the diagonal entries of the generic
upper-triangular matrix. So besides the highest line `k δ_{xᵖ}`
(`TauCeti.SpecialLinear.lTensor_coact_lcoeff_single_comp_subtype`), the functional `δ_{xᵖ⁻¹ y}`
spans a second `B⁺`-stable line of `R_p*`, of weight `p - 2`; the two lines are distinct by
`TauCeti.SpecialLinear.lcoeff_comp_subtype_notMem_span_singleton`. -/
theorem lTensor_coact_lcoeff_single_sub_one_add_single_comp_subtype (hp : p ≠ 0) :
    (UpperTriangular.coordinateMap k 2).hom.toLinearMap.lTensor (Module.Dual k (binaryForms k p))
        (Comodule.coact (R := k) (C := coordinateHopfAlgebra k 2)
          ((MvPolynomial.lcoeff k (Finsupp.single 0 (p - 1) + Finsupp.single 1 1)).comp
            (SMulMemClass.subtype (binaryForms k p)))) =
      (MvPolynomial.lcoeff k (Finsupp.single 0 (p - 1) + Finsupp.single 1 1)).comp
          (SMulMemClass.subtype (binaryForms k p)) ⊗ₜ
        ((UpperTriangular.coordinateMap k 2).hom
            (Comodule.coefficientMatrix (C := coordinateHopfAlgebra k 2) (Pi.basisFun k (Fin 2))
              0 0) ^ (p - 1) *
          (UpperTriangular.coordinateMap k 2).hom
            (Comodule.coefficientMatrix (C := coordinateHopfAlgebra k 2) (Pi.basisFun k (Fin 2))
              1 1)) := by
  -- The only binomial coefficient to check is `p choose (p - 1) = p`.
  simpa using lTensor_coact_lcoeff_comp_subtype_of_choose_eq_zero (k := k) (d := p) (i := p - 1)
    (j := 1) (Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hp)) fun l hl hlp ↦ by
      rw [show l = p by omega, Nat.choose_symm (Nat.one_le_iff_ne_zero.mpr hp),
        Nat.choose_one_right, CharP.cast_eq_zero]


end StableLine

end TauCeti.SpecialLinear
