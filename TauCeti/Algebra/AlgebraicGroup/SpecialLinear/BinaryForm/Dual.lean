module

public import TauCeti.Algebra.AlgebraicGroup.SpecialLinear.BinaryForm.Basic
public import TauCeti.Algebra.Coalgebra.Subcomodule.Comap
public import TauCeti.Algebra.Coalgebra.Subcomodule.Dual
public import TauCeti.Algebra.Coalgebra.Subcomodule.Induced

/-!
# The dual of the binary forms and its simple head

Let `R_d = k[x, y]_d` be the binary forms of degree `d` over a field `k`, a rational
representation of `SL₂` (`TauCeti.SpecialLinear.binaryForms`), and let `R_d*` be its dual
representation. In every characteristic `R_d` has a simple socle, the subrepresentation generated
by the highest weight vector `yᵈ`, which lies in every nonzero subrepresentation
(`TauCeti.SpecialLinear.binaryFormsSocle_le_of_ne_bot`). Dually, `R_d*` has a unique maximal
proper subrepresentation: the annihilator of that socle contains every proper subrepresentation
of `R_d*`. Its simple quotient is the head of `R_d*`.

Since `xᵈ` lies in the socle, a subrepresentation of `R_d*` containing a functional that does not
vanish at `xᵈ` is everything. In particular the coordinate functional `δ_{xᵈ}`, dual to the
monomial `xᵈ`, generates `R_d*`, for every degree `d` and in every characteristic. This contrasts
with `R_d` itself, which in characteristic `p` is generated by its highest weight vector `yᵈ` only
when `d + 1 = (a + 1) pᵐ` for some `a < p` and some `m`
(`TauCeti.SpecialLinear.binaryFormsSocle_eq_binaryForms_iff_of_charP`).
Classically `R_d*` is the Weyl module `Δ(d)` and `δ_{xᵈ}` spans its highest weight line; these
identifications are not proved here.

The proofs transport the socle of `R_d` through the order-reversing correspondence between
subcomodules of a finite-dimensional comodule and of its dual
(`TauCeti.Subcomodule.dualAnnihilatorOrderIso`).

## Main declarations

* `TauCeti.SpecialLinear.le_dualAnnihilator_comap_binaryFormsSocle`: every proper
  subrepresentation of `R_d*` annihilates the socle of `R_d`.
* `TauCeti.SpecialLinear.isCoatom_dualAnnihilator_comap_binaryFormsSocle`: the annihilator of the
  socle is the unique maximal proper subrepresentation of `R_d*`.
* `TauCeti.SpecialLinear.eq_top_of_apply_X_zero_pow_ne_zero`: a subrepresentation of `R_d*`
  containing a functional not vanishing at `xᵈ` is everything.
* `TauCeti.SpecialLinear.eq_top_of_lcoeff_comp_subtype_mem`: the coordinate functional `δ_{xᵈ}`
  generates `R_d*`.

## References

* J. C. Jantzen, *Representations of Algebraic Groups*, 2nd ed., II.2.13 and II.2.16.
-/

public section

namespace TauCeti.SpecialLinear

universe u

variable {k : Type u} [Field k] {d : ℕ}

attribute [local instance] polynomialComodule Comodule.dual

/-- **Every proper subrepresentation of the dual binary forms annihilates the socle.** A
subrepresentation `W ≠ R_d*` vanishes on the socle of `R_d`: its common kernel is a nonzero
subrepresentation of `R_d`, so it contains the socle. -/
theorem le_dualAnnihilator_comap_binaryFormsSocle
    {W : Subcomodule k (coordinateHopfAlgebra k 2) (Module.Dual k (binaryForms k d))}
    (hW : W ≠ ⊤) :
    W ≤ ((binaryFormsSocle k d).comap (Subcomodule.subtype (binaryForms k d))).dualAnnihilator := by
  rw [← Subcomodule.dualCoannihilator_dualAnnihilator W,
    Subcomodule.dualAnnihilator_le_dualAnnihilator_iff]
  set N := W.dualCoannihilator
  have hN : N ≠ ⊥ := Subcomodule.dualCoannihilator_eq_bot_iff.not.mpr hW
  -- The image of the common kernel in the polynomial functions is a nonzero subrepresentation
  -- of the binary forms, so it contains the socle.
  have hle : N.map (Subcomodule.subtype (binaryForms k d)) ≤ binaryForms k d := by
    intro f hf
    obtain ⟨g, -, rfl⟩ := Subcomodule.mem_map.mp hf
    rw [Subcomodule.subtype_apply]
    exact g.2
  have hne : N.map (Subcomodule.subtype (binaryForms k d)) ≠ ⊥ := by
    obtain ⟨g, hg, hg₀⟩ := Subcomodule.ne_bot_iff.mp hN
    refine Subcomodule.ne_bot_iff.mpr ⟨g, ?_, fun h ↦ hg₀ (Subtype.ext h)⟩
    simpa only [Subcomodule.subtype_apply] using
      Subcomodule.mem_map_of_mem (Subcomodule.subtype (binaryForms k d)) hg
  intro f hf
  obtain ⟨g, hg, hgf⟩ := Subcomodule.mem_map.mp
    (binaryFormsSocle_le_of_ne_bot hle hne (Subcomodule.mem_comap.mp hf))
  rw [Subcomodule.subtype_apply, Subcomodule.subtype_apply] at hgf
  rwa [← Subtype.ext hgf]

/-- **The simple head of the dual binary forms.** The annihilator of the socle of `R_d` is the
unique maximal proper subrepresentation of `R_d*`: it is proper, and it contains every proper
subrepresentation. -/
theorem isCoatom_dualAnnihilator_comap_binaryFormsSocle :
    IsCoatom ((binaryFormsSocle k d).comap
      (Subcomodule.subtype (binaryForms k d))).dualAnnihilator := by
  refine ⟨Subcomodule.dualAnnihilator_eq_top_iff.not.mpr fun h ↦ ?_, fun W hW ↦ ?_⟩
  · -- The socle contains the nonzero binary form `xᵈ`.
    have hx : (⟨_, X_zero_pow_mem_binaryForms⟩ : binaryForms k d) ∈
        (binaryFormsSocle k d).comap (Subcomodule.subtype (binaryForms k d)) := by
      simpa [Subcomodule.subtype_apply] using X_zero_pow_mem_binaryFormsSocle
    rw [h, Subcomodule.mem_bot] at hx
    exact pow_ne_zero d (MvPolynomial.X_ne_zero (R := k) (0 : Fin 2))
      (congrArg Subtype.val hx)
  · by_contra hW₀
    exact hW.not_ge (le_dualAnnihilator_comap_binaryFormsSocle hW₀)

/-- **Generation of the dual binary forms.** A subrepresentation of `R_d*` containing a
functional `φ` with `φ(xᵈ) ≠ 0` is all of `R_d*`, over every field and in every
characteristic. -/
theorem eq_top_of_apply_X_zero_pow_ne_zero
    {W : Subcomodule k (coordinateHopfAlgebra k 2) (Module.Dual k (binaryForms k d))}
    {φ : Module.Dual k (binaryForms k d)} (hφ : φ ∈ W)
    (h : φ ⟨_, X_zero_pow_mem_binaryForms⟩ ≠ 0) : W = ⊤ := by
  by_contra hW
  refine h (Subcomodule.mem_dualAnnihilator.mp (le_dualAnnihilator_comap_binaryFormsSocle hW hφ)
    _ ?_)
  simpa [Subcomodule.subtype_apply] using X_zero_pow_mem_binaryFormsSocle

/-- **The functional `δ_{xᵈ}` generates the dual binary forms.** The coordinate functional
`δ_{xᵈ}`, reading off the coefficient of `xᵈ`, generates `R_d*` as a representation: every
subrepresentation containing it is everything. This holds for every degree `d`, over every
field and in every characteristic. -/
theorem eq_top_of_lcoeff_comp_subtype_mem
    {W : Subcomodule k (coordinateHopfAlgebra k 2) (Module.Dual k (binaryForms k d))}
    (h : (MvPolynomial.lcoeff k (Finsupp.single 0 d)).comp
      (SMulMemClass.subtype (binaryForms k d)) ∈ W) : W = ⊤ :=
  eq_top_of_apply_X_zero_pow_ne_zero h (by
    classical
    simp [MvPolynomial.coeff_X_pow])

end TauCeti.SpecialLinear
