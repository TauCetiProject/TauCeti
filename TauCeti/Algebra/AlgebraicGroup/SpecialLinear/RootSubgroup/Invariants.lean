import Mathlib.Algebra.MonoidAlgebra.MapDomain
import Mathlib.RingTheory.Localization.Away.Basic

/-!
# Invariants of the root subgroups of the special linear group

For distinct indices `i ≠ j`, right translation by the closed root subgroup `xᵢⱼ(𝔾ₐ) ⊆ SLₙ`,
with Hopf ideal `TauCeti.SpecialLinear.rootSubgroupHopfIdeal`, adds `t` times column `i` to
column `j`, so every entry of the generic matrix outside column `j` is a right invariant.

For `SL₂` and the upper unipotent subgroup `N⁺ = x₀₁(𝔾ₐ)`, with generic matrix
`[[a, b], [c, d]]`, right translation by `n(t) = [[1, t], [0, 1]]` is

```text
a ↦ a,   c ↦ c,   b ↦ b + a t,   d ↦ d + c t,
```

and this file proves that the right `N⁺`-invariants are exactly the polynomials in the first
column, over every commutative base ring:

```text
O(SL₂)^{N⁺} = R[a, c],
```

with `a` and `c` algebraically independent. Invariants are the coaction equalizer
`TauCeti.HopfIdeal.coinvariants`, not invariance under rational points only; in particular the
result holds over finite fields and in every characteristic.

Geometrically, the first-column map `SL₂ → 𝔸² \ {0}` is an `N⁺`-torsor, trivialized over the
two charts `D(a)` and `D(c)` by the sections `[[a, 0], [c, a⁻¹]]` and `[[a, -c⁻¹], [c, 0]]`,
which differ on the overlap by `n(-1/(ac))`. The quotient `SL₂ / N⁺` is this punctured plane,
which is quasi-affine but not affine; the invariant ring computed here is the coordinate ring of
its affinization `𝔸²`. Neither the torsor nor the quotient is constructed in this file.

## Main declarations

* `TauCeti.SpecialLinear.genericMatrix_mem_coinvariants_rootSubgroupHopfIdeal`: generic entries
  outside column `j` are right invariant under `xᵢⱼ(𝔾ₐ)`.
* `TauCeti.SpecialLinear.coinvariants_rootSubgroupHopfIdeal_two_eq_adjoin`: the right invariants of
  the upper unipotent subgroup of `SL₂` are generated by the first column.
* `TauCeti.SpecialLinear.algebraicIndependent_genericMatrix_col_zero_two`: the first-column entries
  of `SL₂` are algebraically independent.
* `TauCeti.SpecialLinear.coinvariantsRootSubgroupHopfIdealTwoAlgEquiv`: the invariant algebra is a
  polynomial ring in two variables.

## Implementation notes

The computation follows the two charts. An invariant takes the same value at both sections over
the Laurent polynomial ring `R[ℤ × ℤ] = R[α^±, γ^±]`; the first value lies in `R[ℤ × ℕ]` and the
second in `R[ℕ × ℤ]`, so the common value is a polynomial `p(α, γ)`. The invariant `f - p(a, c)`
then vanishes at both sections, hence after inverting `a` and after inverting `c`, hence is zero
because `a d - b c = 1` makes `a` and `c` span the unit ideal.

## References

* I. Hedén, *Affine extensions of principal additive bundles over a punctured surface*,
  arXiv:1407.7638, §§1 and 3, for the rank-one torsor and its transition cocycle.
-/

public section

open CategoryTheory WithConv

namespace TauCeti

namespace SpecialLinear

universe u

variable {R : Type u} [CommRing R] {N : ℕ} {i j : Fin N}

variable {A : Type u} [CommRing A] [Algebra R A]

/-! ### Right invariance -/

/-- A right invariant of the root subgroup `xᵢⱼ(𝔾ₐ)` takes the same value at `M` and at
`M (1 + t Eᵢⱼ)`. -/
theorem ofConv_pointsMulEquiv_symm_mul_transvection {hij : i ≠ j} {h : coordinateHopfAlgebra R N}
    (hh : h ∈ (rootSubgroupHopfIdeal hij).coinvariants)
    (M : Matrix.SpecialLinearGroup (Fin N) A) (t : A) :
    ((pointsMulEquiv (R := R) (A := A) N).symm
        (M * Matrix.SpecialLinearGroup.transvection hij t)).ofConv h =
      ((pointsMulEquiv (R := R) (A := A) N).symm M).ofConv h := by
  rw [map_mul]
  exact HopfIdeal.ofConv_mul_apply_of_mem_coinvariants hh _
    ((mem_quotientPointsSubgroup_rootSubgroupHopfIdeal_iff hij _).mpr
      ⟨t, MulEquiv.apply_symm_apply _ _⟩)

/-! ### Invariance of the columns other than `j` -/

/-- Right translation by `xᵢⱼ(t)` changes only column `j`, so every generic entry outside
column `j` is a right invariant of the root subgroup. -/
theorem genericMatrix_mem_coinvariants_rootSubgroupHopfIdeal (hij : i ≠ j) (k : Fin N)
    {l : Fin N} (hl : l ≠ j) :
    (GeneralLinear.genericMatrix R N).map (coordinateMap R N).hom k l ∈
      (rootSubgroupHopfIdeal hij).coinvariants := by
  rw [HopfIdeal.mem_coinvariants_iff_forall_mul]
  intro A g n hn
  obtain ⟨t, ht⟩ := (mem_quotientPointsSubgroup_rootSubgroupHopfIdeal_iff hij n).mp hn
  rw [← (pointsMulEquiv (R := R) (A := A) N).symm_apply_apply (g * n), map_mul, ht,
    ← (pointsMulEquiv (R := R) (A := A) N).symm_apply_apply g,
    ofConv_pointsMulEquiv_symm_genericMatrix, ofConv_pointsMulEquiv_symm_genericMatrix,
    MulEquiv.apply_symm_apply, Matrix.SpecialLinearGroup.coe_mul]
  exact Matrix.mul_transvection_apply_of_ne _ _ _ _ hl _ _

/-! ### The right invariants of the upper unipotent subgroup of `SL₂`

Write `a, b, c, d` for the generic entries of `SL₂`. The chart `D(a)` is parametrized by the
section `[[α, 0], [γ, α⁻¹]]` over `R[ℤ × ℕ] = R[α^±, γ]`, and the chart `D(c)` by the section
`[[α, -γ⁻¹], [γ, 0]]` over `R[ℕ × ℤ] = R[α, γ^±]`. Both include into `R[ℤ × ℤ]`, where the two
sections differ by right multiplication by `n(-α⁻¹γ⁻¹)`. -/

section SL2

open AddMonoidAlgebra

/-- The generic entries of `SL₂`. -/
private noncomputable def entry (R : Type u) [CommRing R] (k l : Fin 2) :
    coordinateHopfAlgebra R 2 :=
  (GeneralLinear.genericMatrix R 2).map (coordinateMap R 2).hom k l

/-- The generic matrix of `SL₂` has determinant one: `a d - b c = 1`. -/
private theorem entry_det :
    entry R 0 0 * entry R 1 1 - entry R 0 1 * entry R 1 0 = 1 := by
  rw [entry, entry, entry, entry, ← Matrix.det_fin_two]
  exact det_map_genericMatrix_coordinateMap R 2

/-- The relation `a d - b c = 1` after applying an algebra map. -/
private theorem map_entry_det {L : Type*} [CommRing L] [Algebra R L]
    (τ : coordinateHopfAlgebra R 2 →ₐ[R] L) :
    τ (entry R 0 0) * τ (entry R 1 1) - τ (entry R 0 1) * τ (entry R 1 0) = 1 := by
  rw [← map_mul, ← map_mul, ← map_sub, entry_det, map_one]

/-- The point of `SL₂` over `L` whose value on each generic entry is its image under `τ`. -/
private theorem coe_pointsMulEquiv_toConv {L : Type u} [CommRing L] [Algebra R L]
    (τ : coordinateHopfAlgebra R 2 →ₐ[R] L) (k l : Fin 2) :
    (pointsMulEquiv (R := R) (A := L) 2 (toConv τ) : Matrix (Fin 2) (Fin 2) L) k l =
      τ (entry R k l) := by
  rw [coe_pointsMulEquiv_apply, ofConv_toConv, entry]

/-- The invertible first coordinate on the Laurent chart `D(a)`. -/
private noncomputable def chartUnitA : (AddMonoidAlgebra R (ℤ × ℕ))ˣ :=
  ⟨single (1, 0) 1, single (-1, 0) 1,
    by simp [single_mul_single, one_def, Prod.mk_zero_zero],
    by simp [single_mul_single, one_def, Prod.mk_zero_zero]⟩

/-- The invertible second coordinate on the Laurent chart `D(c)`. -/
private noncomputable def chartUnitC : (AddMonoidAlgebra R (ℕ × ℤ))ˣ :=
  ⟨single (0, 1) 1, single (0, -1) 1,
    by simp [single_mul_single, one_def, Prod.mk_zero_zero],
    by simp [single_mul_single, one_def, Prod.mk_zero_zero]⟩

/-- The section of the first-column torsor over the chart `D(a)`. -/
private noncomputable def chartPointA :
    Matrix.SpecialLinearGroup (Fin 2) (AddMonoidAlgebra R (ℤ × ℕ)) :=
  Matrix.SpecialLinearGroup.upperLeftSection chartUnitA (single (0, 1) 1)

/-- The section of the first-column torsor over the chart `D(c)`. -/
private noncomputable def chartPointC :
    Matrix.SpecialLinearGroup (Fin 2) (AddMonoidAlgebra R (ℕ × ℤ)) :=
  Matrix.SpecialLinearGroup.lowerLeftSection (single (1, 0) 1) chartUnitC

/-- Evaluation at the section over `D(a)`. -/
private noncomputable def chartEvalA :
    coordinateHopfAlgebra R 2 →ₐ[R] AddMonoidAlgebra R (ℤ × ℕ) :=
  ((pointsMulEquiv (R := R) (A := AddMonoidAlgebra R (ℤ × ℕ)) 2).symm chartPointA).ofConv

/-- Evaluation at the section over `D(c)`. -/
private noncomputable def chartEvalC :
    coordinateHopfAlgebra R 2 →ₐ[R] AddMonoidAlgebra R (ℕ × ℤ) :=
  ((pointsMulEquiv (R := R) (A := AddMonoidAlgebra R (ℕ × ℤ)) 2).symm chartPointC).ofConv

private theorem chartEvalA_entry (k l : Fin 2) : chartEvalA (entry R k l) = chartPointA k l :=
  ofConv_pointsMulEquiv_symm_genericMatrix R 2 _ k l

/-- The exponent inclusion `ℤ × ℕ → ℤ × ℤ`. -/
private def inclA : ℤ × ℕ →+ ℤ × ℤ := (AddMonoidHom.id ℤ).prodMap (Nat.castAddMonoidHom ℤ)

/-- The exponent inclusion `ℕ × ℤ → ℤ × ℤ`. -/
private def inclC : ℕ × ℤ →+ ℤ × ℤ := (Nat.castAddMonoidHom ℤ).prodMap (AddMonoidHom.id ℤ)

/-- The exponents of the monomial `α ^ m 0 * γ ^ m 1` in `R[α^±, γ]`. -/
private noncomputable def monomialA : (Fin 2 →₀ ℕ) →+ ℤ × ℕ :=
  ((Nat.castAddMonoidHom ℤ).comp (Finsupp.applyAddHom 0)).prod (Finsupp.applyAddHom 1)

private theorem inclA_injective : Function.Injective inclA := by
  rw [inclA, AddMonoidHom.coe_prodMap]
  exact Function.injective_id.prodMap Nat.cast_injective

private theorem inclC_injective : Function.Injective inclC := by
  rw [inclC, AddMonoidHom.coe_prodMap]
  exact Nat.cast_injective.prodMap Function.injective_id

private theorem monomialA_injective : Function.Injective monomialA := by
  intro m m' h
  simp only [monomialA, AddMonoidHom.prod_apply, AddMonoidHom.coe_comp, Function.comp_apply,
    Finsupp.applyAddHom_apply, Nat.coe_castAddMonoidHom, Prod.mk.injEq, Nat.cast_inj] at h
  ext k
  fin_cases k
  exacts [h.1, h.2]

/-- Over `R[ℤ × ℤ]` the section over `D(c)` is the section over `D(a)` translated by
`n(-α⁻¹γ⁻¹)`. -/
private theorem map_chartPointC :
    Matrix.SpecialLinearGroup.map (mapDomainAlgHom R R inclC).toRingHom chartPointC =
      Matrix.SpecialLinearGroup.map (mapDomainAlgHom R R inclA).toRingHom chartPointA *
        Matrix.SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1)
          (single (-1, -1) (-1)) := by
  have h := Matrix.SpecialLinearGroup.lowerLeftSection_eq_upperLeftSection_mul_transvection
    (Units.map (mapDomainAlgHom R R inclA).toMonoidHom (chartUnitA (R := R)))
    (Units.map (mapDomainAlgHom R R inclC).toMonoidHom (chartUnitC (R := R)))
  rw [chartPointA, chartPointC, Matrix.SpecialLinearGroup.map_upperLeftSection,
    Matrix.SpecialLinearGroup.map_lowerLeftSection]
  convert h using 2 <;>
    simp [chartUnitA, chartUnitC, inclA, inclC, single_mul_single]

/-- A right invariant takes the same value at the two sections, compared in `R[ℤ × ℤ]`. -/
private theorem mapDomain_chartEvalC {h : coordinateHopfAlgebra R 2}
    (hh : h ∈ (rootSubgroupHopfIdeal (R := R) (zero_ne_one : (0 : Fin 2) ≠ 1)).coinvariants) :
    mapDomain inclC (chartEvalC h) = mapDomain inclA (chartEvalA h) := by
  have key := ofConv_pointsMulEquiv_symm_mul_transvection hh
    (Matrix.SpecialLinearGroup.map (mapDomainAlgHom R R inclA).toRingHom chartPointA)
    (single (-1, -1) (-1))
  rw [← map_chartPointC, ← mapValue_pointsMulEquiv_symm_apply,
    ← mapValue_pointsMulEquiv_symm_apply] at key
  simp only [AlgHom.mapValue_apply, ofConv_toConv, AlgHom.comp_apply, mapDomainAlgHom_apply]
    at key
  exact key

/-- The value of a right invariant at the section over `D(a)` has no negative power of `α`: it
is a polynomial in `α` and `γ`. -/
private theorem exists_chartEvalA_eq {h : coordinateHopfAlgebra R 2}
    (hh : h ∈ (rootSubgroupHopfIdeal (R := R) (zero_ne_one : (0 : Fin 2) ≠ 1)).coinvariants) :
    ∃ p : MvPolynomial (Fin 2) R, chartEvalA h = mapDomain monomialA p := by
  classical
  -- Each exponent of the common value in `R[ℤ × ℤ]` lies in the ranges of both inclusions.
  have hsupp : ↑(mapDomain inclA (chartEvalA h)).coeff.support ⊆
      Set.range (inclA.comp monomialA) := by
    intro m hm
    have hA := Finsupp.mapDomain_support (f := inclA) hm
    rw [← mapDomain_chartEvalC hh] at hm
    have hC := Finsupp.mapDomain_support (f := inclC) hm
    obtain ⟨⟨x, n⟩, -, rfl⟩ := Finset.mem_image.mp hA
    obtain ⟨⟨n', y⟩, -, hy⟩ := Finset.mem_image.mp hC
    refine ⟨Finsupp.single 0 n' + Finsupp.single 1 n, ?_⟩
    simp only [inclA, inclC, AddMonoidHom.coe_prodMap, Prod.map_apply, AddMonoidHom.id_apply,
      Nat.coe_castAddMonoidHom, Prod.mk.injEq] at hy
    simp [inclA, monomialA, hy.1]
  obtain ⟨p, hp⟩ : ∃ p, mapDomain (inclA.comp monomialA) p = mapDomain inclA (chartEvalA h) :=
    ⟨comapDomain _ (inclA_injective.comp monomialA_injective) _, mapDomain_comapDomain hsupp _⟩
  refine ⟨p, mapDomain_injective inclA_injective ?_⟩
  rw [← hp, ← mapDomainAlgHom_apply R R, mapDomainAlgHom_comp, AlgHom.comp_apply,
    mapDomainAlgHom_apply, mapDomainAlgHom_apply]

/-- At the section over `D(a)`, the polynomial `p(a, c)` takes the value `p(α, γ)`. -/
private theorem chartEvalA_aeval (p : MvPolynomial (Fin 2) R) :
    chartEvalA (MvPolynomial.aeval ![entry R 0 0, entry R 1 0] p) = mapDomain monomialA p := by
  rw [← AlgHom.comp_apply, ← mapDomainAlgHom_apply R R]
  congr 1
  refine MvPolynomial.algHom_ext (Fin.forall_fin_two.mpr ⟨?_, ?_⟩) <;>
    rw [AlgHom.comp_apply, MvPolynomial.aeval_X, mapDomainAlgHom_apply, MvPolynomial.X,
      ← MvPolynomial.single_eq_monomial, mapDomain_single]
  · rw [Matrix.cons_val_zero, chartEvalA_entry]
    simp [chartPointA, chartUnitA, monomialA]
  · rw [Matrix.cons_val_one, Matrix.cons_val_zero, chartEvalA_entry]
    simp [chartPointA, chartUnitA, monomialA]

/-- If the tautological point over `L` is `M` translated by the root subgroup, then a right
invariant vanishing at `M` vanishes in `L`. -/
private theorem eq_zero_of_pointsMulEquiv_eq_map_mul {L S : Type u} [CommRing L] [Algebra R L]
    [CommRing S] [Algebra R S] {h : coordinateHopfAlgebra R 2}
    (hh : h ∈ (rootSubgroupHopfIdeal (R := R) (zero_ne_one : (0 : Fin 2) ≠ 1)).coinvariants)
    (τ : coordinateHopfAlgebra R 2 →ₐ[R] L) (M : Matrix.SpecialLinearGroup (Fin 2) S)
    (φ : S →ₐ[R] L) (t : L)
    (hτ : pointsMulEquiv (R := R) (A := L) 2 (toConv τ) =
      Matrix.SpecialLinearGroup.map φ.toRingHom M *
        Matrix.SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1) t)
    (h0 : ((pointsMulEquiv (R := R) (A := S) 2).symm M).ofConv h = 0) :
    τ h = 0 := by
  have hτh : τ h = ((pointsMulEquiv (R := R) (A := L) 2).symm
      (pointsMulEquiv (R := R) (A := L) 2 (toConv τ))).ofConv h := by
    rw [MulEquiv.symm_apply_apply, ofConv_toConv]
  rw [hτh, hτ, ofConv_pointsMulEquiv_symm_mul_transvection hh,
    ← mapValue_pointsMulEquiv_symm_apply, AlgHom.mapValue_apply, ofConv_toConv, AlgHom.comp_apply,
    h0, map_zero]

/-- A right invariant vanishing at the section over `D(a)` vanishes after inverting `a`. -/
private theorem algebraMap_away_eq_zero_of_chartEvalA {h : coordinateHopfAlgebra R 2}
    (hh : h ∈ (rootSubgroupHopfIdeal (R := R) (zero_ne_one : (0 : Fin 2) ≠ 1)).coinvariants)
    (h0 : chartEvalA h = 0) :
    algebraMap _ (Localization.Away (entry R 0 0)) h = 0 := by
  let L := Localization.Away (entry R 0 0)
  let τ : coordinateHopfAlgebra R 2 →ₐ[R] L := IsScalarTower.toAlgHom R _ L
  let u : Lˣ := (IsLocalization.Away.algebraMap_isUnit (entry R 0 0)).unit
  have hu : (u : L) = τ (entry R 0 0) := IsUnit.unit_spec _
  -- The lower-right entry is `d = c (a⁻¹ b) + a⁻¹`, which is `a d - b c = 1` divided by `a`.
  have hd : τ (entry R 1 1) = τ (entry R 1 0) * (↑u⁻¹ * τ (entry R 0 1)) + ↑u⁻¹ := by
    linear_combination (↑u⁻¹ : L) * map_entry_det τ - τ (entry R 1 1) * u.inv_mul_eq_one.mpr hu
  refine eq_zero_of_pointsMulEquiv_eq_map_mul hh τ chartPointA
    (lift R L (ℤ × ℕ) ((Units.coeHom L).comp ((zpowersHom Lˣ u).comp
        (AddMonoidHom.fst ℤ ℕ).toMultiplicative) *
      (powersHom L (τ (entry R 1 0))).comp (AddMonoidHom.snd ℤ ℕ).toMultiplicative))
    (↑u⁻¹ * τ (entry R 0 1)) (Matrix.SpecialLinearGroup.ext _ _ fun k l ↦ ?_) h0
  rw [coe_pointsMulEquiv_toConv, Matrix.SpecialLinearGroup.coe_mul,
    Matrix.SpecialLinearGroup.map_apply_coe]
  fin_cases k <;> fin_cases l <;>
    simp [chartPointA, chartUnitA, lift_single, Matrix.mul_apply, Fin.sum_univ_two,
      Matrix.SpecialLinearGroup.transvection_coe, ← hu, hd]

/-- A right invariant vanishing at the section over `D(c)` vanishes after inverting `c`. -/
private theorem algebraMap_away_eq_zero_of_chartEvalC {h : coordinateHopfAlgebra R 2}
    (hh : h ∈ (rootSubgroupHopfIdeal (R := R) (zero_ne_one : (0 : Fin 2) ≠ 1)).coinvariants)
    (h0 : chartEvalC h = 0) :
    algebraMap _ (Localization.Away (entry R 1 0)) h = 0 := by
  let L := Localization.Away (entry R 1 0)
  let τ : coordinateHopfAlgebra R 2 →ₐ[R] L := IsScalarTower.toAlgHom R _ L
  let v : Lˣ := (IsLocalization.Away.algebraMap_isUnit (entry R 1 0)).unit
  have hv : (v : L) = τ (entry R 1 0) := IsUnit.unit_spec _
  -- The upper-right entry is `b = a (c⁻¹ d) - c⁻¹`, which is `a d - b c = 1` divided by `c`.
  have hb : τ (entry R 0 1) = τ (entry R 0 0) * (↑v⁻¹ * τ (entry R 1 1)) - ↑v⁻¹ := by
    linear_combination (-(↑v⁻¹ : L)) * map_entry_det τ - τ (entry R 0 1) * v.inv_mul_eq_one.mpr hv
  refine eq_zero_of_pointsMulEquiv_eq_map_mul hh τ chartPointC
    (lift R L (ℕ × ℤ) ((powersHom L (τ (entry R 0 0))).comp
        (AddMonoidHom.fst ℕ ℤ).toMultiplicative *
      (Units.coeHom L).comp ((zpowersHom Lˣ v).comp (AddMonoidHom.snd ℕ ℤ).toMultiplicative)))
    (↑v⁻¹ * τ (entry R 1 1)) (Matrix.SpecialLinearGroup.ext _ _ fun k l ↦ ?_) h0
  rw [coe_pointsMulEquiv_toConv, Matrix.SpecialLinearGroup.coe_mul,
    Matrix.SpecialLinearGroup.map_apply_coe]
  fin_cases k <;> fin_cases l <;>
    simp [chartPointC, chartUnitC, lift_single, Matrix.mul_apply, Fin.sum_univ_two,
      Matrix.SpecialLinearGroup.transvection_coe, ← hv, hb, sub_eq_add_neg]

/-- A right invariant vanishing at the section over `D(a)` is zero. -/
private theorem eq_zero_of_chartEvalA_eq_zero {h : coordinateHopfAlgebra R 2}
    (hh : h ∈ (rootSubgroupHopfIdeal (R := R) (zero_ne_one : (0 : Fin 2) ≠ 1)).coinvariants)
    (h0 : chartEvalA h = 0) : h = 0 := by
  -- It also vanishes at the section over `D(c)`, as the two values agree in `R[ℤ × ℤ]`.
  have h0' : chartEvalC h = 0 := mapDomain_injective inclC_injective <| by
    rw [mapDomain_chartEvalC hh, h0, ← mapDomainAlgHom_apply R R, ← mapDomainAlgHom_apply R R,
      map_zero, map_zero]
  -- Since `a d - b c = 1`, the entries `a` and `c` span the unit ideal.
  have hspan : Ideal.span {entry R 0 0, entry R 1 0} = ⊤ := by
    rw [Ideal.eq_top_iff_one, Ideal.mem_span_pair]
    exact ⟨entry R 1 1, -entry R 0 1, by linear_combination (entry_det (R := R))⟩
  refine Localization.algebraMap_injective_of_span_eq_top _ hspan <| funext fun ⟨s, hs⟩ ↦ ?_
  rw [map_zero, Pi.zero_apply, Pi.algebraMap_apply]
  obtain rfl | rfl := hs
  exacts [algebraMap_away_eq_zero_of_chartEvalA hh h0, algebraMap_away_eq_zero_of_chartEvalC hh h0']

/-- **The right invariants of the upper unipotent subgroup of `SL₂`.** Over every commutative
ring, the functions on `SL₂` invariant under right translation by `n(t) = [[1, t], [0, 1]]` are
exactly the polynomials in the first-column entries `a` and `c`. -/
theorem coinvariants_rootSubgroupHopfIdeal_two_eq_adjoin :
    (rootSubgroupHopfIdeal (R := R) (zero_ne_one : (0 : Fin 2) ≠ 1)).coinvariants =
      Algebra.adjoin R {(GeneralLinear.genericMatrix R 2).map (coordinateMap R 2).hom 0 0,
        (GeneralLinear.genericMatrix R 2).map (coordinateMap R 2).hom 1 0} := by
  have hle : Algebra.adjoin R {entry R 0 0, entry R 1 0} ≤
      (rootSubgroupHopfIdeal (R := R) (zero_ne_one : (0 : Fin 2) ≠ 1)).coinvariants :=
    Algebra.adjoin_le <| by
      rintro _ (rfl | rfl) <;>
        exact genericMatrix_mem_coinvariants_rootSubgroupHopfIdeal _ _ zero_ne_one
  refine le_antisymm (fun h hh ↦ ?_) hle
  -- Subtract the polynomial in `a, c` with the same value on the chart `D(a)`.
  obtain ⟨p, hp⟩ := exists_chartEvalA_eq hh
  have hmem : MvPolynomial.aeval ![entry R 0 0, entry R 1 0] p ∈
      Algebra.adjoin R {entry R 0 0, entry R 1 0} := by
    rw [← Matrix.range_cons_cons_empty (entry R 0 0) (entry R 1 0) ![],
      Algebra.adjoin_range_eq_range_aeval]
    exact ⟨p, rfl⟩
  have hsub := eq_zero_of_chartEvalA_eq_zero (sub_mem hh (hle hmem)) <| by
    rw [map_sub, hp, chartEvalA_aeval, sub_self]
  rw [sub_eq_zero.mp hsub]
  exact hmem

/-- The first-column entries `a` and `c` of the generic matrix of `SL₂` are algebraically
independent over every commutative ring. -/
theorem algebraicIndependent_genericMatrix_col_zero_two :
    AlgebraicIndependent R ![(GeneralLinear.genericMatrix R 2).map (coordinateMap R 2).hom 0 0,
      (GeneralLinear.genericMatrix R 2).map (coordinateMap R 2).hom 1 0] := by
  rw [algebraicIndependent_iff_injective_aeval]
  intro p q hpq
  -- Evaluating at the section over `D(a)` sends `p(a, c)` to `p(α, γ) ∈ R[α^±, γ]`.
  exact mapDomain_injective monomialA_injective <|
    (chartEvalA_aeval p).symm.trans ((congrArg chartEvalA hpq).trans (chartEvalA_aeval q))

/-- The right invariants of the upper unipotent subgroup of `SL₂` form a polynomial ring in two
variables, `X 0 ↦ a` and `X 1 ↦ c`. -/
noncomputable def coinvariantsRootSubgroupHopfIdealTwoAlgEquiv :
    MvPolynomial (Fin 2) R ≃ₐ[R]
      (rootSubgroupHopfIdeal (R := R) (zero_ne_one : (0 : Fin 2) ≠ 1)).coinvariants :=
  (algebraicIndependent_genericMatrix_col_zero_two (R := R)).aevalEquiv.trans
    (Subalgebra.equivOfEq _ _ <| by
      rw [coinvariants_rootSubgroupHopfIdeal_two_eq_adjoin]
      exact congrArg (Algebra.adjoin R) (Matrix.range_cons_cons_empty _ _ _))

/-- The polynomial-ring presentation of the right invariants evaluates a polynomial at the
first column. -/
@[simp]
theorem coe_coinvariantsRootSubgroupHopfIdealTwoAlgEquiv_apply (p : MvPolynomial (Fin 2) R) :
    (coinvariantsRootSubgroupHopfIdealTwoAlgEquiv p : coordinateHopfAlgebra R 2) =
      MvPolynomial.aeval ![(GeneralLinear.genericMatrix R 2).map (coordinateMap R 2).hom 0 0,
        (GeneralLinear.genericMatrix R 2).map (coordinateMap R 2).hom 1 0] p := by
  rw [coinvariantsRootSubgroupHopfIdealTwoAlgEquiv, AlgEquiv.trans_apply,
    Subalgebra.equivOfEq_apply]
  exact algebraicIndependent_genericMatrix_col_zero_two.algebraMap_aevalEquiv p

