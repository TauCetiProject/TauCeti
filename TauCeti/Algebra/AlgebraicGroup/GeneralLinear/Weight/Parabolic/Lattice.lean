module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Weight.Parabolic.BlockWeight
import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Dynamic.Weight.Parabolic.Geometry
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Separation
import TauCeti.Algebra.GroupWithZero.Units.Basic

/-!
# Intersections and closed generation of standard block parabolics

For the standard block parabolics of `GLₙ₊₁`, intersecting the Levi labels gives the
scheme-theoretic intersection of the subgroups. On defining Hopf ideals this is an ideal
sum. This identity holds over every commutative base ring, so it retains infinitesimal
structure, rather than merely comparing geometric points. In particular, these
intersections are again smooth standard block parabolics.

Over a field, the union of two labels gives the smallest closed subgroup scheme containing
both standard block parabolics. The universal property allows an arbitrary competing
closed subgroup, including a nonreduced one. It follows by applying the Tits-system
comparison over an algebraic closure and reflecting inclusion using the reducedness of
the standard block parabolic, not of the competing subgroup.

The point-group generation identity is also provided over fields with nontrivial unit
group, the hypothesis of the native general-linear Tits system. The scheme-level results
have no restriction on the cardinality or characteristic of the field.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§29.3–30.1.
* J. S. Milne, *Algebraic Groups* (2017), Theorem 21.91.
-/

public section

namespace TauCeti.GeneralLinear

universe u v

variable {n : ℕ}

section Ring

variable (R : Type u) [CommRing R]

/-- Scheme-theoretic intersection of standard block parabolics corresponds to intersection
of their Levi labels. The sum of defining ideals retains the full scheme structure over
arbitrary base rings. -/
@[simp]
theorem weightParabolicDefiningHopfIdeal_standardWeight_inter (J K : Finset (Fin n)) :
    weightParabolicDefiningHopfIdeal R (standardWeight (J ∩ K)) =
      weightParabolicDefiningHopfIdeal R (standardWeight J) ⊔
        weightParabolicDefiningHopfIdeal R (standardWeight K) := by
  classical
  apply le_antisymm
  · rw [← HopfIdeal.toIdeal_le_toIdeal, weightParabolicDefiningHopfIdeal_toIdeal,
      Ideal.span_le]
    intro x hx
    obtain ⟨i, j, hij, rfl⟩ := (mem_weightParabolicRelationSet_iff R _ x).mp hx
    obtain ⟨a, hja, hai, ha⟩ := (standardWeight_lt_iff (J ∩ K) i j).mp hij
    have hmem (L : Finset (Fin n)) (haL : a ∉ L) :
        coordinateHopfAlgebraAlgEquiv R (n + 1)
            (coordinateRingMap R (n + 1) (MvPolynomial.X (i, j))) ∈
          (weightParabolicDefiningHopfIdeal R (standardWeight L)).toIdeal := by
      rw [weightParabolicDefiningHopfIdeal_toIdeal]
      exact Ideal.subset_span (X_mem_weightParabolicRelationSet R _
        ((standardWeight_lt_iff L i j).mpr ⟨a, hja, hai, haL⟩))
    rw [HopfIdeal.sup_toIdeal]
    by_cases haJ : a ∈ J
    · exact Ideal.mem_sup_right (hmem K (fun haK ↦ ha (Finset.mem_inter.mpr ⟨haJ, haK⟩)))
    · exact Ideal.mem_sup_left (hmem J haJ)
  · exact sup_le
      (weightParabolicDefiningHopfIdeal_standardWeight_antitone R Finset.inter_subset_left)
      (weightParabolicDefiningHopfIdeal_standardWeight_antitone R Finset.inter_subset_right)

/-- On every value algebra, the intersection of standard block parabolics is the parabolic
with intersected Levi label. This includes nonreduced value algebras. -/
@[simp]
theorem weightParabolicPoints_standardWeight_inter (J K : Finset (Fin n))
    (A : Type v) [CommRing A] [Algebra R A] :
    weightParabolicPoints R (standardWeight (J ∩ K)) A =
      weightParabolicPoints R (standardWeight J) A ⊓
        weightParabolicPoints R (standardWeight K) A := by
  simp only [weightParabolicPoints_eq_hopfIdealPointsSubgroup,
    weightParabolicDefiningHopfIdeal_standardWeight_inter, hopfIdealPointsSubgroup_sup]

end Ring

section FieldPoints

variable (k : Type u) [Field k] [Nontrivial kˣ]

/-- The group generated by two standard block parabolics is the standard block parabolic
with the union label. The unit-group hypothesis is that of the general-linear Tits system. -/
theorem weightParabolicPoints_standardWeight_union (J K : Finset (Fin n)) :
    weightParabolicPoints k (standardWeight (J ∪ K)) k =
      weightParabolicPoints k (standardWeight J) k ⊔
        weightParabolicPoints k (standardWeight K) k := by
  classical
  let T := glTitsSystem k n
  have hB : T.subgroupB ≤ weightParabolicPoints k (standardWeight J) k := by
    rw [glTitsSystem_subgroupB]
    exact upperTriangularGroup_le_weightParabolicPoints (standardWeight_antitone J)
  apply le_antisymm
  · rw [← standardParabolic_weightParabolicSimple k _ (standardWeight_antitone _)]
    apply (T.standardParabolic_le_iff _ _).mpr
    refine ⟨hB.trans le_sup_left, ?_⟩
    intro s hs g hg
    obtain ⟨i, hi, hs⟩ := (mem_weightParabolicSimple_iff_exists k _ s).mp hs
    have hi' := (standardWeight_castSucc_eq_succ_iff (J ∪ K) i).mp hi
    rcases Finset.mem_union.mp hi' with hiJ | hiK
    · exact Subgroup.mem_sup_left ((mem_weightParabolicSimple_iff k _
        (standardWeight_antitone J) s).mp
          ((mem_weightParabolicSimple_iff_exists k _ s).mpr
            ⟨i, (standardWeight_castSucc_eq_succ_iff J i).mpr hiJ, hs⟩) hg)
    · exact Subgroup.mem_sup_right ((mem_weightParabolicSimple_iff k _
        (standardWeight_antitone K) s).mp
          ((mem_weightParabolicSimple_iff_exists k _ s).mpr
            ⟨i, (standardWeight_castSucc_eq_succ_iff K i).mpr hiK, hs⟩) hg)
  · apply sup_le
    · exact weightParabolicPoints_le_of_weightParabolicDefiningHopfIdeal_le k _ _
        (weightParabolicDefiningHopfIdeal_standardWeight_antitone k Finset.subset_union_left)
    · exact weightParabolicPoints_le_of_weightParabolicDefiningHopfIdeal_le k _ _
        (weightParabolicDefiningHopfIdeal_standardWeight_antitone k Finset.subset_union_right)

end FieldPoints

section Field

variable (k : Type u) [Field k]

/-- The standard block parabolic with union label is the smallest closed subgroup scheme
containing the two given standard block parabolics. Ideal inclusion reverses geometric
inclusion. No reducedness hypothesis is imposed on the competing subgroup `I`. -/
@[simp]
theorem le_weightParabolicDefiningHopfIdeal_standardWeight_union_iff
    (I : HopfIdeal k (coordinateHopfAlgebra k (n + 1))) (J K : Finset (Fin n)) :
    I ≤ weightParabolicDefiningHopfIdeal k (standardWeight (J ∪ K)) ↔
      I ≤ weightParabolicDefiningHopfIdeal k (standardWeight J) ∧
        I ≤ weightParabolicDefiningHopfIdeal k (standardWeight K) := by
  classical
  constructor
  · intro h
    exact ⟨h.trans (weightParabolicDefiningHopfIdeal_standardWeight_antitone k
      Finset.subset_union_left), h.trans
        (weightParabolicDefiningHopfIdeal_standardWeight_antitone k Finset.subset_union_right)⟩
  · rintro ⟨hJ, hK⟩
    let L := AlgebraicClosure k
    have hbase (A : Finset (Fin n)) :
        weightParabolicPoints k (standardWeight A) L =
          weightParabolicPoints L (standardWeight A) L := by
      ext g
      simp only [mem_weightParabolicPoints_iff]
    have hpoints : weightParabolicPoints k (standardWeight (J ∪ K)) L ≤
        hopfIdealPointsSubgroup (n + 1) I L := by
      rw [hbase, weightParabolicPoints_standardWeight_union, ← hbase, ← hbase]
      apply sup_le
      · rw [weightParabolicPoints_eq_hopfIdealPointsSubgroup]
        exact hopfIdealPointsSubgroup_le_of_le (n + 1) hJ L
      · rw [weightParabolicPoints_eq_hopfIdealPointsSubgroup]
        exact hopfIdealPointsSubgroup_le_of_le (n + 1) hK L
    apply HopfIdeal.le_of_quotientPointsSubgroup_le (K := L)
    intro g hg
    have hm := hpoints ((pointsMulEquiv_mem_weightParabolicPoints_iff k _ g).mpr hg)
    simpa only [mem_hopfIdealPointsSubgroup_iff, MulEquiv.symm_apply_apply,
      ← CommHopfAlgCat.mem_quotientPointsSubgroup_iff] using hm

end Field

end TauCeti.GeneralLinear
