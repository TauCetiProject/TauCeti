module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Weight.Parabolic.Basic
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Weight.Torus
public import TauCeti.Algebra.Coalgebra.Subcomodule.Coordinate

/-!
# Weight parabolics, weight tori, and invariant coordinate spans

This file records two facts about weight parabolics of `GL_N` that do not depend on any root
system. First, every weight torus lies in every weight parabolic, since the diagonal
weight-torus coordinate morphism kills all off-diagonal coordinates. Second, a closed subgroup of
a weight parabolic stabilizes the coordinate span of every set of indices whose weights all
exceed the weights outside it.

Together they reduce the invariance of a coordinate span under a subgroup generated by a weight
torus and root subgroups to checking that each root subgroup lies in one weight parabolic.

## Main declarations

All declarations live in the `TauCeti.GeneralLinear` namespace.

* `weightParabolicDefiningHopfIdeal_toIdeal_le_ker_weightTorusCoordinateBialgHom`: the weight
  torus lies in every weight parabolic.
* `coordinateSpanIsStable_of_weightParabolicDefiningHopfIdeal_le`: closed subgroups of a weight
  parabolic stabilize the coordinate spans of upper weight sets.

## References

* J. S. Milne, *Algebraic Groups* (2017), Chapter 13.
-/

public section

open CategoryTheory

namespace TauCeti.GeneralLinear

universe u v

variable {R : Type u} [CommRing R] {N : ℕ}

/-- Every weight torus lies in every weight parabolic: the diagonal weight-torus coordinate
morphism kills each forbidden coordinate, since forbidden coordinates are off the diagonal. -/
theorem weightParabolicDefiningHopfIdeal_toIdeal_le_ker_weightTorusCoordinateBialgHom
    {sigma : Type v} [Finite sigma] (w : Fin N → ℤ) (wt : Fin N → sigma → ℤ) :
    (weightParabolicDefiningHopfIdeal R w).toIdeal ≤
      RingHom.ker (weightTorusCoordinateBialgHom (S := R) wt).toAlgHom.toRingHom := by
  apply weightParabolicDefiningHopfIdeal_toIdeal_le_ker
  intro a b hab
  have hab' : a ≠ b := by rintro rfl; exact lt_irrefl _ hab
  simpa only [hab', ↓reduceIte, BialgHom.coe_toAlgHom] using
    weightTorusCoordinateBialgHom_X (S := R) wt a b

/-- A closed subgroup of the weight parabolic attached to `w` stabilizes the coordinate span of
`s` in the standard representation whenever every weight outside `s` is smaller than every
weight in `s`. -/
theorem coordinateSpanIsStable_of_weightParabolicDefiningHopfIdeal_le {w : Fin N → ℤ}
    {I : HopfIdeal R (coordinateHopfAlgebra R N)} (hI : weightParabolicDefiningHopfIdeal R w ≤ I)
    {s : Set (Fin N)} (hs : ∀ a ∉ s, ∀ b ∈ s, w a < w b) :
    letI := corestrictStandardComodule R N (CommHopfAlgCat.mkQuotient _ I).hom
    (Pi.basisFun R (Fin N)).coordinateSpanIsStable
      (C := CommHopfAlgCat.quotient (coordinateHopfAlgebra R N) I) s := by
  let _ := corestrictStandardComodule R N (CommHopfAlgCat.mkQuotient _ I).hom
  let _ := standardComodule R N
  rw [Module.Basis.coordinateSpanIsStable_iff]
  intro a ha b hb
  rw [Comodule.coefficientMatrix_corestrict, coefficientMatrix_basisFun, Matrix.map_apply,
    genericMatrix_apply, BialgHom.toCoalgHom_apply, CommHopfAlgCat.mkQuotient_eq_zero_iff]
  apply hI
  rw [← HopfIdeal.mem_toIdeal, weightParabolicDefiningHopfIdeal_toIdeal]
  exact Ideal.subset_span (X_mem_weightParabolicRelationSet R w (hs a ha b hb))

end TauCeti.GeneralLinear
