module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.DiagonalTorus.WeylGroup
public import TauCeti.Algebra.AlgebraicGroup.Hopf.ClassFunction.Restriction

/-!
# Class functions of `GL_N` restricted to the diagonal torus

Let `T ⊆ GL_N` be the diagonal split torus over a commutative ring `R`, with coordinate algebra the
Laurent polynomial ring `R[t₁^{±1}, …, t_N^{±1}]`. A regular class function of `GL_N` restricts to a
symmetric Laurent polynomial: it is fixed by every permutation of the coordinates
(`TauCeti.GeneralLinear.domCongr_characterRelabel_apply_of_mem_classFunctions`). This holds over
every commutative ring, since the permutation matrices are rational points normalizing `T`.

Over a domain the Weyl group of `T` is exactly the symmetric group on the coordinates, so the
Weyl-invariant functions on `T` are exactly the symmetric Laurent polynomials
(`TauCeti.GeneralLinear.mem_weylInvariants_diagonalTorusCoordinateMap_iff`). The Chevalley
restriction map of `GL_N` therefore takes values in the symmetric Laurent polynomials, which over a
field are generated by the elementary symmetric polynomials `e₁, …, e_N` and `e_N⁻¹`, the
coefficients of the characteristic polynomial with invertible constant term.

## Main results

* `TauCeti.GeneralLinear.domCongr_characterRelabel_apply_of_mem_classFunctions`: the restriction of
  a class function of `GL_N` to the diagonal torus is a symmetric Laurent polynomial.
* `TauCeti.GeneralLinear.mem_weylInvariants_diagonalTorusCoordinateMap_iff`: over a domain, the
  Weyl-invariant functions on the diagonal torus are the symmetric Laurent polynomials.

## References

* R. Steinberg, *Regular elements of semisimple algebraic groups*, Publ. Math. IHÉS 25 (1965),
  §6.
* J. S. Milne, *Algebraic Groups* (2017), Example 19.7.
-/

public section

namespace TauCeti.GeneralLinear

universe u

variable {R : Type u} [CommRing R] {N : ℕ}

/-- **Class functions of `GL_N` restrict to symmetric Laurent polynomials.** Restricted to the
diagonal torus, a regular class function of `GL_N` is fixed by the relabelling of the characters
along every permutation `σ` of the coordinates. -/
theorem domCongr_characterRelabel_apply_of_mem_classFunctions (σ : Equiv.Perm (Fin N))
    {f : coordinateHopfAlgebra R N}
    (hf : f ∈ HopfAlgebra.classFunctions R (coordinateHopfAlgebra R N)) :
    MonoidAlgebra.domCongr R R
        (SplitTorus.characterRelabel (Equiv.ulift.{u}.symm.permCongr σ))
        ((diagonalTorusCoordinateMap (R := R) (N := N)).hom f) =
      (diagonalTorusCoordinateMap (R := R) (N := N)).hom f := by
  simpa [HopfAlgebra.pointConjugationAlgHom_apply_of_mem_classFunctions hf] using
    (AlgHom.congr_fun (diagonalTorusCoordinateMap_comp_pointConjugationAlgHom_permutationGL σ)
      f).symm

/-- Over a domain, **the Weyl-invariant functions on the diagonal torus of `GL_N` are the
symmetric Laurent polynomials**: those fixed by the relabelling of the characters along every
permutation of the coordinates. -/
theorem mem_weylInvariants_diagonalTorusCoordinateMap_iff [IsDomain R]
    {p : MonoidAlgebra R (Multiplicative (ULift.{u} (Fin N) →₀ ℤ))} :
    p ∈ BialgHom.weylInvariants (diagonalTorusCoordinateMap (R := R) (N := N)).hom
        (diagonalTorusCoordinateMap_surjective R N) ↔
      ∀ σ : Equiv.Perm (Fin N), MonoidAlgebra.domCongr R R
        (SplitTorus.characterRelabel (Equiv.ulift.{u}.symm.permCongr σ)) p = p := by
  rw [BialgHom.mem_weylInvariants_iff]
  refine ⟨fun h σ ↦ h _ (characterRelabel_mem_weylGroup_diagonalTorusCoordinateMap σ),
    fun h w hw ↦ ?_⟩
  obtain ⟨σ, rfl⟩ := mem_weylGroup_diagonalTorusCoordinateMap_iff.mp hw
  exact h σ

end TauCeti.GeneralLinear
