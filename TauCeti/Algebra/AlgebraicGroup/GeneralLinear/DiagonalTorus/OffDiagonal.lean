module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.DiagonalTorus.Maximal
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Dynamic.Weight.Levi.DiagonalTorus

/-!
# The diagonal-torus ideal of `GL_n` is generated by the off-diagonal entries

The diagonal torus of `GL_n` over a commutative ring `R` is cut out by
`TauCeti.GeneralLinear.diagonalTorusDefiningIdeal`, the kernel of the restriction
`R[GL_n] → R[t₁^{±1}, …, tₙ^{±1}]` to diagonal coordinates. This kernel is the ideal generated by
the off-diagonal matrix coordinates `x_{ij}`, `i ≠ j`.

For an injective weight `w`, the weight Levi of `w` is the diagonal torus: the restriction map
factors through the weight-Levi quotient by an isomorphism
(`TauCeti.GeneralLinear.weightLeviCoordinateMap_comp_weightLeviDiagonalCoordinateIso_hom`), so the
two defining ideals agree. The weight-Levi ideal is generated by the coordinates `x_{ij}` with
`w i ≠ w j`, that is, `i ≠ j`.

## Main declarations

* `TauCeti.GeneralLinear.diagonalTorusDefiningIdeal_eq_weightLeviDefiningHopfIdeal`: for an
  injective weight, the diagonal-torus ideal is the weight-Levi ideal.
* `TauCeti.GeneralLinear.diagonalTorusDefiningIdeal_toIdeal_eq_span`: the diagonal-torus ideal is
  generated by the off-diagonal coordinates.
-/

public section

open CategoryTheory

namespace TauCeti.GeneralLinear

universe u

variable (R : Type u) [CommRing R] {N : ℕ}

/-- The off-diagonal matrix coordinates `x_{ij}`, `i ≠ j`, of `GL_N`. -/
def offDiagonalCoordinateSet : Set (coordinateHopfAlgebra R N) :=
  {x | ∃ i j, i ≠ j ∧
    x = coordinateHopfAlgebraAlgEquiv R N (coordinateRingMap R N (MvPolynomial.X (i, j)))}

/-- Membership in `offDiagonalCoordinateSet` means being an off-diagonal matrix coordinate. -/
theorem mem_offDiagonalCoordinateSet {x : coordinateHopfAlgebra R N} :
    x ∈ offDiagonalCoordinateSet R ↔ ∃ i j, i ≠ j ∧
      x = coordinateHopfAlgebraAlgEquiv R N (coordinateRingMap R N (MvPolynomial.X (i, j))) :=
  Iff.rfl

/-- **For an injective weight, the weight Levi is the diagonal torus**: their defining Hopf ideals
agree. -/
theorem diagonalTorusDefiningIdeal_eq_weightLeviDefiningHopfIdeal (w : Fin N → ℤ)
    (hw : Function.Injective w) :
    diagonalTorusDefiningIdeal R N = weightLeviDefiningHopfIdeal R w := by
  ext x
  have hinj : Function.Injective (weightLeviDiagonalCoordinateIso R w hw).hom.hom :=
    Function.LeftInverse.injective (g := (weightLeviDiagonalCoordinateIso R w hw).inv.hom)
      fun y ↦ Iso.hom_inv_id_apply (weightLeviDiagonalCoordinateIso R w hw) y
  rw [mem_diagonalTorusDefiningIdeal,
    ← weightLeviCoordinateMap_comp_weightLeviDiagonalCoordinateIso_hom R w hw,
    CommHopfAlgCat.hom_comp, BialgHom.comp_apply, map_eq_zero_iff _ hinj,
    CommHopfAlgCat.hom_mkQuotient]
  exact Ideal.Quotient.eq_zero_iff_mem.trans HopfIdeal.mem_toIdeal

/-- **The diagonal-torus ideal of `GL_N` is generated by the off-diagonal coordinates.** -/
theorem diagonalTorusDefiningIdeal_toIdeal_eq_span :
    (diagonalTorusDefiningIdeal R N).toIdeal = Ideal.span (offDiagonalCoordinateSet R) := by
  rw [diagonalTorusDefiningIdeal_eq_weightLeviDefiningHopfIdeal R (fun i ↦ (i : ℤ))
      (fun i j h ↦ Fin.ext (by simpa using h)),
    weightLeviDefiningHopfIdeal_def, HopfIdeal.sup_toIdeal,
    weightParabolicDefiningHopfIdeal_toIdeal, weightParabolicDefiningHopfIdeal_toIdeal,
    ← Ideal.span_union]
  congr 1
  ext x
  simp only [Set.mem_union, mem_weightParabolicRelationSet_iff, mem_offDiagonalCoordinateSet,
    Pi.neg_apply, neg_lt_neg_iff, Nat.cast_lt, Fin.val_fin_lt]
  constructor
  · rintro (⟨i, j, h, rfl⟩ | ⟨i, j, h, rfl⟩)
    exacts [⟨i, j, h.ne, rfl⟩, ⟨i, j, h.ne', rfl⟩]
  · rintro ⟨i, j, h, rfl⟩
    rcases h.lt_or_gt with h | h
    exacts [Or.inl ⟨i, j, h, rfl⟩, Or.inr ⟨i, j, h, rfl⟩]

end TauCeti.GeneralLinear
