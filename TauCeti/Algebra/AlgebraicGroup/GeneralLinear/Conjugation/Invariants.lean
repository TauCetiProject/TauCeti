module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.FunctorOfPoints
public import TauCeti.AlgebraicGeometry.Quotient.Conjugation

/-!
# The characteristic polynomial on the conjugation quotient of `GLₙ`

The coefficients of the characteristic polynomial of the generic matrix of `GLₙ` are invariant
under the conjugation action of `GLₙ` on itself
(`TauCeti.GeneralLinear.charpoly_coeff_genericMatrix_mem_conjugationInvariants`): on points this
is the invariance of the characteristic polynomial under conjugation, and it is tested on the
universal pair of `GLₙ`-points valued in `O(GLₙ) ⊗ O(GLₙ)`. The constant coefficient
`(-1)ⁿ det` is a unit of the invariants. The coefficients therefore define an algebra map

`R[c₀^{±1}, c₁, …, c_{n-1}] → O(GLₙ)^{GLₙ}`

(`TauCeti.GeneralLinear.charpolyCoeffAlgHom`), for `n ≥ 1`. Equivalently, the characteristic
polynomial `GLₙ ⟶ 𝔸^{n-1} × 𝔾ₘ` factors uniquely through the quotient map
`χ : GLₙ ⟶ Conj_{GLₙ} = GLₙ // GLₙ`, by `TauCeti.GeneralLinear.charpolyQuotientMap`
(
`TauCeti.GeneralLinear.existsUnique_conjugationQuotientMap_comp_eq_charpoly`).

Over a field, `charpolyCoeffAlgHom` is expected to be an isomorphism, identifying the conjugation
invariants of `GLₙ` with the Laurent polynomial ring `R[c₀^{±1}, c₁, …, c_{n-1}]`: the invariants
are generated by the coefficients of the characteristic polynomial and the inverse determinant,
with no further relations. That identification is outside the scope of this file.

## Main declarations

* `TauCeti.GeneralLinear.charpoly_coeff_genericMatrix_mem_conjugationInvariants`: the
  coefficients of the characteristic polynomial are conjugation invariant.
* `TauCeti.GeneralLinear.isUnit_charpolyCoeffInvariant_zero`: the constant coefficient is a unit
  of the invariants.
* `TauCeti.GeneralLinear.charpolyCoeffAlgHom`: the coordinate map of the characteristic
  polynomial on the conjugation quotient.
* `TauCeti.GeneralLinear.charpolyQuotientMap`: the characteristic polynomial on `Conj_{GLₙ}`, as a
  morphism of schemes, with `TauCeti.GeneralLinear.conjugationQuotientMap_comp_charpolyQuotientMap`.
* `TauCeti.GeneralLinear.existsUnique_conjugationQuotientMap_comp_eq_charpoly`: the characteristic
  polynomial factors uniquely through `Conj_{GLₙ}`.

## References

* G. Böckle, M. Harris, C. Khare, J. A. Thorne, arXiv:1609.03491v2, §3.
* R. Steinberg, *Regular elements of semisimple algebraic groups*, Publ. Math. IHÉS **25** (1965),
  §6.
-/

public section

open WithConv
open scoped TensorProduct

namespace TauCeti.GeneralLinear

universe u

variable (R : Type u) [CommRing R] (n : ℕ)

/-- **The characteristic polynomial is a class function.** Every coefficient of the characteristic
polynomial of the generic matrix of `GLₙ` is invariant under conjugation. -/
theorem charpoly_coeff_genericMatrix_mem_conjugationInvariants (i : ℕ) :
    (genericMatrix R n).charpoly.coeff i ∈
      HopfAlgebra.conjugationInvariants R (coordinateHopfAlgebra R n) := by
  set H := coordinateHopfAlgebra R n
  have hcoeff (φ : H →ₐ[R] H ⊗[R] H) :
      φ ((genericMatrix R n).charpoly.coeff i) = ((genericMatrix R n).map φ).charpoly.coeff i := by
    have := congrArg (·.coeff i) (Matrix.charpoly_map (genericMatrix R n) φ.toRingHom)
    simpa [Polynomial.coeff_map] using this.symm
  -- The conjugation coaction sends the generic matrix `X` to `g⁻¹ X g`, where `X` and `g` are the
  -- universal points of the left and right factors.
  let g := pointToGeneralLinear n (toConv (Algebra.TensorProduct.includeRight : H →ₐ[R] H ⊗[R] H))
  have hmat : (genericMatrix R n).map (HopfAlgebra.conjugationCoactAlgHom R H) =
      (g : Matrix (Fin n) (Fin n) (H ⊗[R] H))⁻¹ *
        (genericMatrix R n).map (Algebra.TensorProduct.includeLeft : H →ₐ[R] H ⊗[R] H) * g := by
    rw [map_genericMatrix_eq_coe_pointToGeneralLinear, HopfAlgebra.toConv_conjugationCoactAlgHom,
      pointToGeneralLinear_mul, pointToGeneralLinear_mul, pointToGeneralLinear_inv,
      Units.val_mul, Units.val_mul, Matrix.coe_units_inv,
      map_genericMatrix_eq_coe_pointToGeneralLinear]
  rw [HopfAlgebra.mem_conjugationInvariants,
    ← Algebra.TensorProduct.includeLeft_apply (S := R) (B := H),
    hcoeff (HopfAlgebra.conjugationCoactAlgHom R H),
    hcoeff (Algebra.TensorProduct.includeLeft : H →ₐ[R] H ⊗[R] H),
    hmat, Matrix.charpoly_units_conj']

/-- A coefficient of the characteristic polynomial of the generic matrix of `GLₙ`, as a
conjugation-invariant function. -/
noncomputable def charpolyCoeffInvariant (i : ℕ) :
    HopfAlgebra.conjugationInvariants R (coordinateHopfAlgebra R n) :=
  ⟨_, charpoly_coeff_genericMatrix_mem_conjugationInvariants R n i⟩

/-- The invariant `charpolyCoeffInvariant R n i` is the `i`-th coefficient of the characteristic
polynomial of the generic matrix. -/
@[simp]
theorem coe_charpolyCoeffInvariant (i : ℕ) :
    (charpolyCoeffInvariant R n i : coordinateHopfAlgebra R n) =
      (genericMatrix R n).charpoly.coeff i :=
  (rfl)

/-- The constant coefficient `(-1)ⁿ det` of the characteristic polynomial of the generic matrix
is a unit of the conjugation invariants, since it is a unit of `O(GLₙ)`
(`TauCeti.HopfAlgebra.isUnit_conjugationInvariants_iff`). -/
theorem isUnit_charpolyCoeffInvariant_zero : IsUnit (charpolyCoeffInvariant R n 0) := by
  have hu : IsUnit ((genericMatrix R n).charpoly.coeff 0) := by
    have h := isUnit_det_genericMatrix R n
    rw [Matrix.det_eq_sign_charpoly_coeff] at h
    exact isUnit_of_mul_isUnit_right h
  exact HopfAlgebra.isUnit_conjugationInvariants_iff.2 hu

variable [NeZero n]

/-- **The characteristic polynomial on `Conj_{GLₙ}`.** The algebra map from the coordinate ring
`R[c₀^{±1}, c₁, …, c_{n-1}]` of `𝔸^{n-1} × 𝔾ₘ` to the conjugation invariants of `O(GLₙ)` sending
`cᵢ` to the `i`-th coefficient of the characteristic polynomial of the generic matrix. -/
noncomputable def charpolyCoeffAlgHom :
    Localization.Away (MvPolynomial.X (0 : Fin n) : MvPolynomial (Fin n) R) →ₐ[R]
      HopfAlgebra.conjugationInvariants R (coordinateHopfAlgebra R n) :=
  IsLocalization.Away.liftAlgHom (MvPolynomial.X 0)
    (f := MvPolynomial.aeval fun i : Fin n => charpolyCoeffInvariant R n i)
    (by simpa using isUnit_charpolyCoeffInvariant_zero R n)

/-- `charpolyCoeffAlgHom` sends the coordinate `cᵢ` to the `i`-th coefficient of the
characteristic polynomial. -/
@[simp]
theorem charpolyCoeffAlgHom_X (i : Fin n) :
    charpolyCoeffAlgHom R n (algebraMap (MvPolynomial (Fin n) R)
      (Localization.Away (MvPolynomial.X (0 : Fin n) : MvPolynomial (Fin n) R))
        (MvPolynomial.X i)) = charpolyCoeffInvariant R n i := by
  simp [charpolyCoeffAlgHom]

/-- `charpolyCoeffAlgHom` sends `c₀⁻¹` to the inverse of the constant coefficient of the
characteristic polynomial. -/
@[simp]
theorem charpolyCoeffAlgHom_invSelf :
    charpolyCoeffAlgHom R n (IsLocalization.Away.invSelf
      (MvPolynomial.X (0 : Fin n) : MvPolynomial (Fin n) R)) =
      ↑(isUnit_charpolyCoeffInvariant_zero R n).unit⁻¹ := by
  have h := congrArg (charpolyCoeffAlgHom R n)
    (IsLocalization.Away.mul_invSelf (MvPolynomial.X (0 : Fin n) : MvPolynomial (Fin n) R))
  rw [map_mul, charpolyCoeffAlgHom_X, map_one, Fin.val_zero] at h
  exact Units.eq_inv_of_mul_eq_one_left (by rwa [IsUnit.unit_spec])

section Scheme

open AlgebraicGeometry CategoryTheory

/-- The morphism `GLₙ ⟶ 𝔸^{n-1} × 𝔾ₘ` given by the coefficients of the characteristic polynomial
is invariant under the conjugation action, since the coefficients are conjugation invariant. -/
private theorem conjugationCoact_comp_charpoly :
    Spec.map (CommRingCat.ofHom
        (HopfAlgebra.conjugationCoactAlgHom R (coordinateHopfAlgebra R n)).toRingHom) ≫
      Spec.map (CommRingCat.ofHom
        ((HopfAlgebra.conjugationInvariants R (coordinateHopfAlgebra R n)).val.comp
          (charpolyCoeffAlgHom R n)).toRingHom) =
    Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        coordinateHopfAlgebra R n →+* coordinateHopfAlgebra R n ⊗[R] coordinateHopfAlgebra R n)) ≫
      Spec.map (CommRingCat.ofHom
        ((HopfAlgebra.conjugationInvariants R (coordinateHopfAlgebra R n)).val.comp
          (charpolyCoeffAlgHom R n)).toRingHom) := by
  rw [← Spec.map_comp, ← Spec.map_comp]
  congr 1
  ext x
  exact HopfAlgebra.mem_conjugationInvariants.1 (charpolyCoeffAlgHom R n x).property

/-- **The characteristic polynomial on `Conj_{GLₙ}`**, as a morphism of schemes
`Conj_{GLₙ} ⟶ 𝔸^{n-1} × 𝔾ₘ`: the descent through the quotient map of the morphism given by the
coefficients of the characteristic polynomial. -/
noncomputable def charpolyQuotientMap :
    HopfAlgebra.conjugationQuotient R (coordinateHopfAlgebra R n) ⟶
      Spec (CommRingCat.of
        (Localization.Away (MvPolynomial.X (0 : Fin n) : MvPolynomial (Fin n) R))) :=
  letI := HopfAlgebra.conjugationComoduleAlgebra (R := R) (H := coordinateHopfAlgebra R n)
  ComoduleAlgebra.AffineQuotient.desc _ <| by
    rw [HopfAlgebra.conjugationComoduleAlgebra_coactAlgHom]
    exact conjugationCoact_comp_charpoly R n

/-- The quotient map `χ : GLₙ ⟶ Conj_{GLₙ}` followed by `charpolyQuotientMap` is the morphism
`GLₙ ⟶ 𝔸^{n-1} × 𝔾ₘ` given by the coefficients of the characteristic polynomial. -/
@[reassoc]
theorem conjugationQuotientMap_comp_charpolyQuotientMap :
    HopfAlgebra.conjugationQuotientMap R (coordinateHopfAlgebra R n) ≫ charpolyQuotientMap R n =
      Spec.map (CommRingCat.ofHom
        ((HopfAlgebra.conjugationInvariants R (coordinateHopfAlgebra R n)).val.comp
          (charpolyCoeffAlgHom R n)).toRingHom) := by
  let := HopfAlgebra.conjugationComoduleAlgebra (R := R) (H := coordinateHopfAlgebra R n)
  rw [HopfAlgebra.conjugationQuotientMap_def, charpolyQuotientMap]
  exact ComoduleAlgebra.AffineQuotient.projection_desc _ _

/-- **The characteristic polynomial factors through `Conj_{GLₙ}`.** The morphism
`GLₙ ⟶ 𝔸^{n-1} × 𝔾ₘ` given by the coefficients of the characteristic polynomial factors
uniquely through the quotient map `χ : GLₙ ⟶ Conj_{GLₙ}`, by `charpolyQuotientMap`. -/
theorem existsUnique_conjugationQuotientMap_comp_eq_charpoly :
    ∃! g : HopfAlgebra.conjugationQuotient R (coordinateHopfAlgebra R n) ⟶
        Spec (CommRingCat.of
          (Localization.Away (MvPolynomial.X (0 : Fin n) : MvPolynomial (Fin n) R))),
      HopfAlgebra.conjugationQuotientMap R (coordinateHopfAlgebra R n) ≫ g =
        Spec.map (CommRingCat.ofHom
          ((HopfAlgebra.conjugationInvariants R (coordinateHopfAlgebra R n)).val.comp
            (charpolyCoeffAlgHom R n)).toRingHom) :=
  ⟨charpolyQuotientMap R n, conjugationQuotientMap_comp_charpolyQuotientMap R n, fun _ hg ↦
    (HopfAlgebra.existsUnique_conjugationQuotientMap_comp_eq _
      (conjugationCoact_comp_charpoly R n)).unique hg
      (conjugationQuotientMap_comp_charpolyQuotientMap R n)⟩

end Scheme

end TauCeti.GeneralLinear
