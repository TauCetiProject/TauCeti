module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Generated.Basic
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Equalizer
import TauCeti.AlgebraicGeometry.AffineGroupScheme.HopfSpec

/-!
# Redundant generators of a closed subgroup scheme of `GLₙ`

Let `f j : O(GLₙ/R) ⟶ K j` be a family of coordinate morphisms indexed by `ι ⊕ κ`, and write
`G` for the closed subgroup scheme of `GLₙ` it generates and `G'` for the one generated by the
subfamily indexed by `ι`. This file proves that the members indexed by `κ` may be dropped as soon
as each of them kills the defining Hopf ideal of `G'`: then `G = G'`, and a homomorphism out of
`G` is determined by its restrictions to the generators indexed by `ι` alone. The equality of
defining ideals is `TauCeti.CommHopfAlgCat.commonKernelHopfIdeal_eq_of_toIdeal_le_ker`.

The kernel condition says exactly that the universal point of `K (.inr k)` is a point of `G'`.
It is usually proved pointwise, as an identity among matrices showing that each point of an extra
generator, typically a split torus, is a product of points of the remaining ones, typically root
subgroups; `commonKernelHopfIdeal_toIdeal_le_ker_of_mapPointsFunctor_mem` converts that
pointwise statement into the kernel condition.

The equality concerns the subgroup scheme generated over `R` itself, with the maximal defining ideal
of `TauCeti.GeneralLinear.generatedGroupScheme`; no base change is involved.

## Main results

* `TauCeti.GeneralLinear.commonKernelHopfIdeal_toIdeal_le_ker_of_mapPointsFunctor_mem`: a
  coordinate morphism all of whose points lie in a generated subgroup scheme kills its defining
  Hopf ideal.
* `TauCeti.GeneralLinear.generatedGroupScheme_eq_of_toIdeal_le_ker`: the two generated group
  schemes agree.
* `TauCeti.GeneralLinear.generatedGroupScheme_hom_ext_of_toIdeal_le_ker`: homomorphisms out of the
  generated group scheme agreeing on the generators indexed by `ι` are equal.

## References

* W. C. Waterhouse, *Introduction to Affine Group Schemes*, §§1.4 and 15.1.
* R. Steinberg, *Lectures on Chevalley Groups*, §3.

The universal-point argument generalizes
`TauCeti.kostantGeneratedDefiningIdeal_toIdeal_le_torus_ker_of_universal_torus_mem_elementary` in
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Generation`,
which treats the weight torus of a Kostant toral closure over `ℤ`.
-/

public section

open AlgebraicGeometry CategoryTheory WithConv

namespace TauCeti.GeneralLinear

universe u v w

variable {R : Type u} [CommRing R] (n : ℕ)

/-- **A generator whose points are already generated kills the defining ideal.** If every point of
`g` lies in the points of the subgroup scheme generated by `p`, then `g` kills the defining Hopf
ideal of that subgroup scheme. Only the universal point of `L` is used. The converse is
`TauCeti.GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_hopfIdealPointsSubgroup`. -/
theorem commonKernelHopfIdeal_toIdeal_le_ker_of_mapPointsFunctor_mem {ι : Type v}
    {K : ι → _root_.CommHopfAlgCat.{u} R} (p : ∀ i, coordinateHopfAlgebra R n ⟶ K i)
    {L : _root_.CommHopfAlgCat.{u} R} (g : coordinateHopfAlgebra R n ⟶ L)
    (hg : ∀ (A : Type u) [CommRing A] [Algebra R A]
      (q : HopfAlgebra.points (R := R) (H := L) (CommAlgCat.of R A)),
      pointsMulEquiv n ((CommHopfAlgCat.mapPointsFunctor g).app (CommAlgCat.of R A) q) ∈
        generatedPointsSubgroup n p A) :
    (CommHopfAlgCat.commonKernelHopfIdeal p).toIdeal ≤ RingHom.ker g.hom.toAlgHom.toRingHom := by
  -- Test the hypothesis on the universal point of `L`, the identity of its coordinate algebra;
  -- its image under `g` is `g` itself.
  have hmem := hg L (toConv (AlgHom.id R L))
  have hq : (CommHopfAlgCat.mapPointsFunctor g).app (CommAlgCat.of R L) (toConv (AlgHom.id R L)) =
      toConv g.hom.toAlgHom := by
    rw [CommHopfAlgCat.mapPointsFunctor_app_apply, ofConv_toConv, AlgHom.id_comp]
  rw [hq, pointsMulEquiv_apply, generatedPointsSubgroup_def] at hmem
  exact (pointToGeneralLinear_mem_hopfIdealPointsSubgroup_iff_toIdeal_le_ker n _ _ _).1 hmem

variable {ι : Type v} {κ : Type w} {K : ι ⊕ κ → _root_.CommHopfAlgCat.{u} R}
variable (f : ∀ j, coordinateHopfAlgebra R n ⟶ K j)

/-- **Dropping redundant generators**, for the generated group schemes: if every generator indexed
by `κ` kills the defining ideal of the subgroup scheme generated by those indexed by `ι`, then the
subgroup scheme of `GLₙ` generated by the whole family is the one generated by the members indexed
by `ι`. -/
theorem generatedGroupScheme_eq_of_toIdeal_le_ker
    (hker : ∀ k, (CommHopfAlgCat.commonKernelHopfIdeal fun i ↦ f (.inl i)).toIdeal ≤
      RingHom.ker (f (.inr k)).hom.toAlgHom.toRingHom) :
    generatedGroupScheme n f = generatedGroupScheme n (fun i ↦ f (.inl i)) := by
  rw [generatedGroupScheme_def, generatedGroupScheme_def,
    CommHopfAlgCat.commonKernelHopfIdeal_eq_of_toIdeal_le_ker f hker]

/-- **Rigidity with redundant generators dropped.** Under the hypothesis of
`generatedGroupScheme_eq_of_toIdeal_le_ker`, two homomorphisms from the subgroup scheme generated
by the whole family to an affine group scheme presented as `hopfSpec Y` are equal as soon as they
agree on the generators indexed by `ι`. -/
theorem generatedGroupScheme_hom_ext_of_toIdeal_le_ker
    (hker : ∀ k, (CommHopfAlgCat.commonKernelHopfIdeal fun i ↦ f (.inl i)).toIdeal ≤
      RingHom.ker (f (.inr k)).hom.toAlgHom.toRingHom)
    {Y : _root_.CommHopfAlgCat.{u} R}
    (φ ψ : generatedGroupScheme n f ⟶ (hopfSpec (CommRingCat.of R)).obj (Opposite.op Y))
    (h : ∀ i, generatorToGeneratedGroupScheme n f (.inl i) ≫ φ =
      generatorToGeneratedGroupScheme n f (.inl i) ≫ ψ) :
    φ = ψ := by
  apply (cancel_epi (eqToHom (generatedGroupScheme_def n f).symm)).1
  refine CommHopfAlgCat.hom_ext_of_preimage_unop_eq _ _ ?_
  refine CommHopfAlgCat.hom_ext_of_le_iff_forall_toIdeal_le_ker (p := fun i ↦ f (.inl i))
    (fun J ↦ ?_) (fun i ↦ CommHopfAlgCat.mkQuotient_comp_commonKernelLift f (.inl i)) _ _
    fun i ↦ ?_
  · rw [CommHopfAlgCat.commonKernelHopfIdeal_eq_of_toIdeal_le_ker f hker]
    exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff _ J
  · refine CommHopfAlgCat.preimage_unop_comp_eq_of_hopfSpec_map_comp_eq _ _ _ ?_
    simpa only [generatorToGeneratedGroupScheme_def, Category.assoc] using h i

end TauCeti.GeneralLinear
