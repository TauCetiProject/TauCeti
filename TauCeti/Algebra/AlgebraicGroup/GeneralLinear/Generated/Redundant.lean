module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Generated.Basic
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Equalizer
import TauCeti.AlgebraicGeometry.AffineGroupScheme.HopfSpec

/-!
# Redundant generators of a closed subgroup scheme of `GLₙ`

Let `f j : O(GLₙ/R) ⟶ K j` be a family of coordinate morphisms indexed by `ι ⊕ κ`, and write
`G` for the closed subgroup scheme of `GLₙ` it generates and `G'` for the one generated by the
subfamily indexed by `ι`. This file proves that the members indexed by `κ` may be dropped as soon
as every one of their points already lies in `G'`: then `G = G'`, and a homomorphism out of `G` is
determined by its restrictions to the generators indexed by `ι` alone.

Only the universal point of each `K (.inr k)` is needed, since the defining Hopf ideal of `G'` is
killed by `f (.inr k)` exactly when that universal point is a point of `G'`. The hypothesis is
stated for points over every `R`-algebra, which is the form in which it is usually proved: an
identity among matrices showing that each point of an extra generator, typically a split torus, is
a product of points of the remaining ones, typically root subgroups.

The equality concerns the subgroup scheme generated over `R` itself, with the maximal defining ideal
of `TauCeti.GeneralLinear.generatedGroupScheme`; no base change is involved.

## Main results

* `TauCeti.GeneralLinear.commonKernelHopfIdeal_eq_of_mapPointsFunctor_mem`: the two defining
  Hopf ideals agree.
* `TauCeti.GeneralLinear.generatedGroupScheme_eq_of_mapPointsFunctor_mem`: the two generated group
  schemes agree.
* `TauCeti.GeneralLinear.generatedGroupScheme_hom_ext_of_mapPointsFunctor_mem`: homomorphisms out
  of the generated group scheme agreeing on the generators indexed by `ι` are equal.

## References

* W. C. Waterhouse, *Introduction to Affine Group Schemes*, §§1.4 and 15.1.
* R. Steinberg, *Lectures on Chevalley Groups*, §3.
-/

public section

open AlgebraicGeometry CategoryTheory WithConv

namespace TauCeti.GeneralLinear

universe u v w

variable {R : Type u} [CommRing R] (n : ℕ)
variable {ι : Type v} {κ : Type w} {K : ι ⊕ κ → _root_.CommHopfAlgCat.{u} R}
variable (f : ∀ j, coordinateHopfAlgebra R n ⟶ K j)

/-- **Dropping generators whose points are already generated.** If every point of each generator
indexed by `κ` lies in the points of the subgroup scheme generated by the generators indexed by
`ι`, then the two families have the same common-kernel defining Hopf ideal. -/
theorem commonKernelHopfIdeal_eq_of_mapPointsFunctor_mem
    (hred : ∀ (k : κ) (A : Type u) [CommRing A] [Algebra R A]
      (p : HopfAlgebra.points (R := R) (H := K (.inr k)) (CommAlgCat.of R A)),
      pointsMulEquiv n ((CommHopfAlgCat.mapPointsFunctor (f (.inr k))).app (CommAlgCat.of R A) p) ∈
        generatedPointsSubgroup n (fun i ↦ f (.inl i)) A) :
    CommHopfAlgCat.commonKernelHopfIdeal f =
      CommHopfAlgCat.commonKernelHopfIdeal (fun i ↦ f (.inl i)) := by
  apply le_antisymm
  · rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
    exact fun i ↦ CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker f (.inl i)
  · rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
    rintro (i | k)
    · exact CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker (fun i ↦ f (.inl i)) i
    · -- Test the hypothesis on the universal point of `K (.inr k)`, the identity of its
      -- coordinate algebra; its image under `f (.inr k)` is `f (.inr k)` itself.
      have hmem := hred k (K (.inr k)) (toConv (AlgHom.id R (K (.inr k))))
      have hp : (CommHopfAlgCat.mapPointsFunctor (f (.inr k))).app
          (CommAlgCat.of R (K (.inr k))) (toConv (AlgHom.id R (K (.inr k)))) =
          toConv (f (.inr k)).hom.toAlgHom := by
        rw [CommHopfAlgCat.mapPointsFunctor_app_apply, ofConv_toConv, AlgHom.id_comp]
      rw [hp, pointsMulEquiv_apply, generatedPointsSubgroup_def] at hmem
      exact (pointToGeneralLinear_mem_hopfIdealPointsSubgroup_iff_toIdeal_le_ker n _ _ _).1 hmem

/-- **Dropping generators whose points are already generated**, for the generated group schemes:
under the hypothesis of `commonKernelHopfIdeal_eq_of_mapPointsFunctor_mem`, the subgroup scheme
of `GLₙ` generated by the whole family is the one generated by the members indexed by `ι`. -/
theorem generatedGroupScheme_eq_of_mapPointsFunctor_mem
    (hred : ∀ (k : κ) (A : Type u) [CommRing A] [Algebra R A]
      (p : HopfAlgebra.points (R := R) (H := K (.inr k)) (CommAlgCat.of R A)),
      pointsMulEquiv n ((CommHopfAlgCat.mapPointsFunctor (f (.inr k))).app (CommAlgCat.of R A) p) ∈
        generatedPointsSubgroup n (fun i ↦ f (.inl i)) A) :
    generatedGroupScheme n f = generatedGroupScheme n (fun i ↦ f (.inl i)) := by
  rw [generatedGroupScheme_def, generatedGroupScheme_def,
    commonKernelHopfIdeal_eq_of_mapPointsFunctor_mem n f hred]

/-- **Rigidity with redundant generators dropped.** Under the hypothesis of
`commonKernelHopfIdeal_eq_of_mapPointsFunctor_mem`, two homomorphisms from the subgroup scheme
generated by the whole family to an affine group scheme presented as `hopfSpec Y` are equal as soon
as they agree on the generators indexed by `ι`. -/
theorem generatedGroupScheme_hom_ext_of_mapPointsFunctor_mem
    (hred : ∀ (k : κ) (A : Type u) [CommRing A] [Algebra R A]
      (p : HopfAlgebra.points (R := R) (H := K (.inr k)) (CommAlgCat.of R A)),
      pointsMulEquiv n ((CommHopfAlgCat.mapPointsFunctor (f (.inr k))).app (CommAlgCat.of R A) p) ∈
        generatedPointsSubgroup n (fun i ↦ f (.inl i)) A)
    {Y : _root_.CommHopfAlgCat.{u} R}
    (φ ψ : generatedGroupScheme n f ⟶ (hopfSpec (CommRingCat.of R)).obj (Opposite.op Y))
    (h : ∀ i, generatorToGeneratedGroupScheme n f (.inl i) ≫ φ =
      generatorToGeneratedGroupScheme n f (.inl i) ≫ ψ) :
    φ = ψ := by
  apply (cancel_epi (eqToHom (generatedGroupScheme_def n f).symm)).1
  refine CommHopfAlgCat.hom_ext_of_preimage_unop_eq _ _ ?_
  refine CommHopfAlgCat.hom_ext_of_le_iff_forall_toIdeal_le_ker (p := fun i ↦ f (.inl i))
    (fun J ↦ ?_) (fun i ↦ CommHopfAlgCat.mkQuotient_comp_commonKernelLift f (.inl i)) _ _
    fun i ↦ ?_
  · rw [commonKernelHopfIdeal_eq_of_mapPointsFunctor_mem n f hred]
    exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff _ J
  · refine CommHopfAlgCat.preimage_unop_comp_eq_of_hopfSpec_map_comp_eq _ _ _ ?_
    simpa only [generatorToGeneratedGroupScheme_def, Category.assoc] using h i

end TauCeti.GeneralLinear
