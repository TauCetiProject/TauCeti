module

public import TauCeti.Algebra.AlgebraicGroup.ConstantForm.Basic
public import TauCeti.Algebra.AlgebraicGroup.ConstantMultiplication.Tangent
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Generated.Basic

/-!
# A generated subgroup scheme of `GLₙ` inside a constant-multiplication or constant-form subgroup

Fix a commutative ring `R`, a family of coordinate morphisms `f i : O(GLₙ/R) ⟶ K i`, and the
closed subgroup scheme of `GLₙ` they generate. Two closed conditions on `GLₙ` are cut out by an
explicit Hopf ideal: preserving a bilinear multiplication with constant structure matrices
`C : Fin n → Matrix (Fin n) (Fin n) R`, and fixing a constant matrix `C` by the congruence
`M C Mᵀ = C`.

Because the defining ideal of the generated subgroup scheme is the largest Hopf ideal killed by
all the `f i`, each containment is tested on the generators alone: it suffices that the generic
matrix of every `f i` satisfies the relation. On matrix-valued points the containment says that
every point of the generated subgroup scheme satisfies the relation, over every `R`-algebra.
Differentiating the multiplication containment makes every tangent matrix a derivation of the
multiplication, with coefficients in any commutative `R`-algebra.

Only the containments are proved. Nothing here asserts that the generated subgroup scheme
exhausts the points of the ambient constant-multiplication or constant-form subgroup scheme, nor
is any relation asserted between the congruence `M C Mᵀ = C` and the transposed congruence
`Mᵀ C M = C`, which is a different closed condition.

## Main results

In the namespace `TauCeti.GeneralLinear`:

* `constantMultiplicationDefiningHopfIdeal_le_commonKernelHopfIdeal` and
  `preserves_of_mem_generatedPointsSubgroup`: the containment of Hopf ideals for a constant
  multiplication and its consequence on matrix points.
* `constantFormDefiningHopfIdeal_le_commonKernelHopfIdeal` and
  `mul_mul_transpose_of_mem_generatedPointsSubgroup`: the same pair for a constant form.
* `tangentMatrix_mul_of_constantMultiplicationDefiningHopfIdeal_le`: tangent matrices of the
  generated subgroup scheme are derivations of the constant multiplication.

The multiplication tangent argument is factored from
`TauCeti.G2ShortRoot.PrimeField.tangentMatrix_mul_crossOperatorPrime` in
`TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.Root.Space`.

## References

* W. C. Waterhouse, *Introduction to Affine Group Schemes* (1979), §15.1, for a subgroup scheme
  generated by a family of homomorphisms.
* J. S. Milne, *Algebraic Groups* (2017), §2.3, for subgroups of `GLₙ` cut out by matrix
  relations.
-/

public section

open CategoryTheory Matrix WithConv

namespace TauCeti.GeneralLinear

universe u v w

variable {R : Type u} [CommRing R] (n : ℕ)
variable {ι : Type v} {K : ι → _root_.CommHopfAlgCat.{u} R}
variable (f : ∀ i, coordinateHopfAlgebra R n ⟶ K i)

/-! ### A constant multiplication -/

section ConstantMultiplication

variable (C : Fin n → Matrix (Fin n) (Fin n) R)

/-- **The generators of a generated subgroup scheme cut out a multiplication they preserve.** If
the generic matrix of every generating coordinate morphism preserves the multiplication with
structure matrices `C`, then the Hopf ideal cutting out the subgroup scheme preserving that
multiplication is contained in the defining ideal of the generated subgroup scheme. -/
theorem constantMultiplicationDefiningHopfIdeal_le_commonKernelHopfIdeal
    (hf : ∀ i, ConstantMultiplication.Preserves R n C
      ((genericMatrix R n).map (f i).hom.toAlgHom)) :
    ConstantMultiplication.definingHopfIdeal R n C ≤
      CommHopfAlgCat.commonKernelHopfIdeal f := by
  rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  exact fun i =>
    ConstantMultiplication.definingHopfIdeal_toIdeal_le_ker_of_preserves_map_genericMatrix
      R n C _ (hf i)

/-- **Every matrix point of a generated subgroup scheme preserves a multiplication preserved by
the generic matrices of its generators.** -/
theorem preserves_of_mem_generatedPointsSubgroup
    (hf : ∀ i, ConstantMultiplication.Preserves R n C
      ((genericMatrix R n).map (f i).hom.toAlgHom))
    (A : Type w) [CommRing A] [Algebra R A]
    {g : Matrix.GeneralLinearGroup (Fin n) A} (hg : g ∈ generatedPointsSubgroup n f A) :
    ConstantMultiplication.Preserves R n C (g : Matrix (Fin n) (Fin n) A) := by
  have hsub := generatedPointsSubgroup_le_hopfIdealPointsSubgroup n f
    ((CommHopfAlgCat.le_commonKernelHopfIdeal_iff f _).1
      (constantMultiplicationDefiningHopfIdeal_le_commonKernelHopfIdeal n f C hf)) A hg
  rw [mem_hopfIdealPointsSubgroup_iff] at hsub
  have hmem : ((pointsMulEquiv (R := R) n).symm g) ∈
      CommHopfAlgCat.quotientPointsSubgroup (coordinateHopfAlgebra R n)
        (ConstantMultiplication.definingHopfIdeal R n C) (CommAlgCat.of R A) :=
    (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mpr hsub
  rw [ConstantMultiplication.mem_definingPointsSubgroup_iff, MulEquiv.apply_symm_apply] at hmem
  exact hmem

/-- Tangent matrices of a generated subgroup scheme contained in a constant-multiplication
stabilizer are derivations of that multiplication, over any commutative coefficient algebra. -/
theorem tangentMatrix_mul_of_constantMultiplicationDefiningHopfIdeal_le
    (hC : ConstantMultiplication.definingHopfIdeal R n C ≤
      CommHopfAlgCat.commonKernelHopfIdeal f)
    {B : Type w} [CommRing B] [Algebra R B]
    (d : Derivation R
      (CommHopfAlgCat.quotient (coordinateHopfAlgebra R n)
        (CommHopfAlgCat.commonKernelHopfIdeal f))
      (Bialgebra.CounitAlgebra R
        (CommHopfAlgCat.quotient (coordinateHopfAlgebra R n)
          (CommHopfAlgCat.commonKernelHopfIdeal f)) B)) (a : Fin n) :
    tangentMatrix n (HopfIdeal.quotientLieHom (CommHopfAlgCat.commonKernelHopfIdeal f) d) *
        (C a).map (algebraMap R B) =
      ConstantMultiplication.imageStructureMatrix R n C
          (tangentMatrix n (HopfIdeal.quotientLieHom
            (CommHopfAlgCat.commonKernelHopfIdeal f) d)) a +
        (C a).map (algebraMap R B) *
          tangentMatrix n (HopfIdeal.quotientLieHom
            (CommHopfAlgCat.commonKernelHopfIdeal f) d) := by
  apply (ConstantMultiplication.mem_lieSubalgebra_definingHopfIdeal_iff C _).mp ?_ a
  rw [HopfIdeal.mem_lieSubalgebra_iff]
  intro y hy
  have hcarrier := (HopfIdeal.mem_lieSubalgebra_iff _ _).mp
    (HopfIdeal.quotientLieEquiv (B := B) (CommHopfAlgCat.commonKernelHopfIdeal f) d).2
  rw [HopfIdeal.quotientLieEquiv_apply_coe] at hcarrier
  exact hcarrier y (HopfIdeal.toIdeal_le_toIdeal.mpr hC hy)

end ConstantMultiplication

/-! ### A constant form -/

section ConstantForm

variable (C : Matrix (Fin n) (Fin n) R)

/-- **The generators of a generated subgroup scheme cut out a form they fix.** If the generic
matrix `X` of every generating coordinate morphism satisfies `X C Xᵀ = C`, then the Hopf ideal
cutting out the subgroup scheme fixing `C` by congruence is contained in the defining ideal of
the generated subgroup scheme. -/
theorem constantFormDefiningHopfIdeal_le_commonKernelHopfIdeal
    (hf : ∀ i, (genericMatrix R n).map (f i).hom.toAlgHom *
          C.map (algebraMap R (K i)) *
          ((genericMatrix R n).map (f i).hom.toAlgHom)ᵀ =
        C.map (algebraMap R (K i))) :
    ConstantForm.definingHopfIdeal R n C ≤ CommHopfAlgCat.commonKernelHopfIdeal f := by
  rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  exact fun i => (ConstantForm.definingHopfIdeal_toIdeal_le_ker_iff R n C _).2 (hf i)

/-- **Every matrix point of a generated subgroup scheme fixes by congruence a form fixed by the
generic matrices of its generators.** -/
theorem mul_mul_transpose_of_mem_generatedPointsSubgroup
    (hf : ∀ i, (genericMatrix R n).map (f i).hom.toAlgHom *
          C.map (algebraMap R (K i)) *
          ((genericMatrix R n).map (f i).hom.toAlgHom)ᵀ =
        C.map (algebraMap R (K i)))
    (A : Type w) [CommRing A] [Algebra R A]
    {g : Matrix.GeneralLinearGroup (Fin n) A} (hg : g ∈ generatedPointsSubgroup n f A) :
    (g : Matrix (Fin n) (Fin n) A) * C.map (algebraMap R A) *
      (g : Matrix (Fin n) (Fin n) A)ᵀ = C.map (algebraMap R A) := by
  have hsub := generatedPointsSubgroup_le_hopfIdealPointsSubgroup n f
    ((CommHopfAlgCat.le_commonKernelHopfIdeal_iff f _).1
      (constantFormDefiningHopfIdeal_le_commonKernelHopfIdeal n f C hf)) A hg
  rw [mem_hopfIdealPointsSubgroup_iff] at hsub
  have hmem : ((pointsMulEquiv (R := R) n).symm g) ∈
      CommHopfAlgCat.quotientPointsSubgroup (coordinateHopfAlgebra R n)
        (ConstantForm.definingHopfIdeal R n C) (CommAlgCat.of R A) :=
    (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mpr hsub
  rw [ConstantForm.mem_definingPointsSubgroup_iff, MulEquiv.apply_symm_apply] at hmem
  exact hmem

end ConstantForm

end TauCeti.GeneralLinear
