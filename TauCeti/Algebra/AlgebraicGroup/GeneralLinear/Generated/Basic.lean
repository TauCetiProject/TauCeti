module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.HopfIdealPoints.Basic
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Basic
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Scheme

/-!
# The closed subgroup scheme of `GLₙ` generated by a family of coordinate morphisms

Over a commutative ring `R`, fix a family of morphisms of commutative Hopf algebras

```text
f i : O(GLₙ/R) ⟶ K i.
```

Contravariantly these are homomorphisms `Spec (K i) ⟶ GLₙ` of affine group schemes, and the
smallest closed subgroup scheme of `GLₙ` through which all of them factor is cut out by the
largest Hopf ideal contained in all their kernels. This file packages that common-kernel
quotient as a closed subgroup scheme of `GLₙ` over `R`, together with its matrix-valued points.

The defining ideal is maximal among Hopf ideals killed by the `f i` **over `R` itself**. That
maximality is what makes the scheme receive endomorphisms from generator equations, and it is
the reason to form the scheme over the ring one works over rather than to base change a scheme
generated over a subring: a Hopf ideal killed by the base-changed generators need not descend.

No reductivity, smoothness, flatness or root-datum statement is asserted, and nothing here
identifies the points of the generated scheme with the abstract subgroup generated by the images
of the `K i`-points; only the containment of the latter in the former is formal.

## Main declarations

* `TauCeti.GeneralLinear.generatedGroupScheme`: the closed subgroup scheme of `GLₙ` generated by
  the family, presented as a Hopf-ideal quotient of `O(GLₙ/R)`.
* `TauCeti.GeneralLinear.generatedGroupSchemeι`: its closed immersion into `GLₙ`.
* `TauCeti.GeneralLinear.generatorToGeneratedGroupScheme`: the morphism `Spec (K i) ⟶` the
  generated scheme through which the `i`th generator factors.
* `TauCeti.GeneralLinear.generatedPointsSubgroup`: its matrix-valued points over an `R`-algebra.
* `TauCeti.GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup`: every
  matrix coming from a point of some `K i` is a point of the generated scheme.

## References

The construction is the scheme-theoretic subgroup generated by a family of homomorphisms; see
J. E. Humphreys, *Linear Algebraic Groups*, §7.5, and W. C. Waterhouse, *Introduction to Affine
Group Schemes*, §15.1. In the Chevalley--Demazure setting the family consists of the root
subgroups and a split torus.
-/

public section

open AlgebraicGeometry CategoryTheory

namespace TauCeti.GeneralLinear

universe u v w

variable {R : Type u} [CommRing R] (n : ℕ)
variable {ι : Type v} {K : ι → _root_.CommHopfAlgCat.{u} R}
variable (f : ∀ i, coordinateHopfAlgebra R n ⟶ K i)

/-- The affine group scheme generated inside `GLₙ` by a family of coordinate morphisms,
presented as the quotient of `O(GLₙ/R)` by the largest Hopf ideal killed by all of them. -/
noncomputable def generatedGroupScheme : Grp (Over (Spec (CommRingCat.of R))) :=
  CommHopfAlgCat.quotientSpec (coordinateHopfAlgebra R n)
    (CommHopfAlgCat.commonKernelHopfIdeal f)

/-- The generated group scheme is the spectrum of the common-kernel Hopf quotient. -/
theorem generatedGroupScheme_def :
    generatedGroupScheme n f =
      CommHopfAlgCat.quotientSpec (coordinateHopfAlgebra R n)
        (CommHopfAlgCat.commonKernelHopfIdeal f) := (rfl)

/-- The canonical morphism from the generated subgroup scheme to `GLₙ`. -/
noncomputable def generatedGroupSchemeι :
    generatedGroupScheme n f ⟶ groupScheme R n :=
  eqToHom (generatedGroupScheme_def n f) ≫
    hopfIdealInclusion R n (CommHopfAlgCat.commonKernelHopfIdeal f)

/-- The inclusion of the generated subgroup scheme is the quotient-spectrum inclusion, read
through the named presentation of `GLₙ`. -/
theorem generatedGroupSchemeι_def :
    generatedGroupSchemeι n f =
      eqToHom (generatedGroupScheme_def n f) ≫
        CommHopfAlgCat.quotientSpecι (coordinateHopfAlgebra R n)
          (CommHopfAlgCat.commonKernelHopfIdeal f) ≫
        eqToHom (groupScheme_def R n).symm := by
  rw [generatedGroupSchemeι, hopfIdealInclusion_def]
  rfl

/-- Closed immersion of the generated-subgroup inclusion reduces to closed immersion of the
common-kernel quotient inclusion. This records the definitional transport through
`generatedGroupScheme_def` explicitly for downstream proofs. -/
theorem isClosedImmersion_generatedGroupSchemeι_iff :
    IsClosedImmersion (generatedGroupSchemeι n f).hom.hom.left ↔
      IsClosedImmersion
        (hopfIdealInclusion R n (CommHopfAlgCat.commonKernelHopfIdeal f)).hom.hom.left := by
  -- The two source objects are propositionally identified by `generatedGroupScheme_def`, so the
  -- underlying morphisms have different dependent types and cannot be related by an equality
  -- rewrite. Reducing the inserted `eqToHom` transport makes the two properties definitionally
  -- equal.
  change IsClosedImmersion
      (hopfIdealInclusion R n (CommHopfAlgCat.commonKernelHopfIdeal f)).hom.hom.left ↔ _
  rfl

/-- The generated subgroup scheme is a closed subgroup scheme of `GLₙ`. -/
instance isClosedImmersion_generatedGroupSchemeι :
    IsClosedImmersion (generatedGroupSchemeι n f).hom.hom.left := by
  rw [isClosedImmersion_generatedGroupSchemeι_iff]
  infer_instance

/-- The `i`th generator, factored through the subgroup scheme it generates. -/
noncomputable def generatorToGeneratedGroupScheme (i : ι) :
    (hopfSpec (CommRingCat.of R)).obj (Opposite.op (K i)) ⟶ generatedGroupScheme n f :=
  (hopfSpec (CommRingCat.of R)).map (CommHopfAlgCat.commonKernelLift f i).op ≫
    eqToHom (generatedGroupScheme_def n f).symm

/-- The generator morphism is induced by the common-kernel factorization. -/
theorem generatorToGeneratedGroupScheme_def (i : ι) :
    generatorToGeneratedGroupScheme n f i =
      (hopfSpec (CommRingCat.of R)).map (CommHopfAlgCat.commonKernelLift f i).op ≫
        eqToHom (generatedGroupScheme_def n f).symm := (rfl)

/-- Closed immersion of a factored generator reduces to closed immersion of the spectrum map of
its common-kernel lift. This records the definitional transport through
`generatedGroupScheme_def` explicitly for downstream proofs. -/
theorem isClosedImmersion_generatorToGeneratedGroupScheme_iff (i : ι) :
    IsClosedImmersion (generatorToGeneratedGroupScheme n f i).hom.hom.left ↔
      IsClosedImmersion ((hopfSpec (CommRingCat.of R)).map
        (CommHopfAlgCat.commonKernelLift f i).op).hom.hom.left := by
  -- The target objects are propositionally identified by `generatedGroupScheme_def`, so the
  -- underlying morphisms have different dependent types and cannot be related by an equality
  -- rewrite. Reducing the inserted `eqToHom` transport makes the two properties definitionally
  -- equal.
  change IsClosedImmersion ((hopfSpec (CommRingCat.of R)).map
      (CommHopfAlgCat.commonKernelLift f i).op).hom.hom.left ↔ _
  rfl

/-- Factoring the `i`th generator through the generated subgroup scheme and then including into
`GLₙ` recovers that generator. -/
@[simp]
theorem generatorToGeneratedGroupScheme_comp_ι (i : ι) :
    generatorToGeneratedGroupScheme n f i ≫ generatedGroupSchemeι n f =
      (hopfSpec (CommRingCat.of R)).map (f i).op ≫ eqToHom (groupScheme_def R n).symm := by
  rw [generatorToGeneratedGroupScheme_def, generatedGroupSchemeι_def,
    CommHopfAlgCat.quotientSpecι_def]
  simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  rw [← Category.assoc, ← Functor.map_comp, ← op_comp,
    CommHopfAlgCat.mkQuotient_comp_commonKernelLift]

/-- The `i`th generator is a closed immersion into the generated subgroup scheme whenever its
coordinate morphism is surjective. -/
theorem isClosedImmersion_generatorToGeneratedGroupScheme_of_surjective (i : ι)
    (hi : Function.Surjective (f i).hom) :
    IsClosedImmersion (generatorToGeneratedGroupScheme n f i).hom.hom.left := by
  rw [isClosedImmersion_generatorToGeneratedGroupScheme_iff,
    CommHopfAlgCat.isClosedImmersion_hopfSpec_map_iff]
  exact CommHopfAlgCat.commonKernelLift_surjective_of_surjective f i hi

/-! ### Matrix-valued points -/

/-- The matrix-valued points of the subgroup scheme of `GLₙ` generated by a family of coordinate
morphisms. -/
noncomputable def generatedPointsSubgroup (A : Type w) [CommRing A] [Algebra R A] :
    Subgroup (Matrix.GeneralLinearGroup (Fin n) A) :=
  hopfIdealPointsSubgroup n (CommHopfAlgCat.commonKernelHopfIdeal f) A

/-- The points of the generated subgroup scheme are the matrix points cut out by its defining
Hopf ideal. -/
theorem generatedPointsSubgroup_def (A : Type w) [CommRing A] [Algebra R A] :
    generatedPointsSubgroup n f A =
      hopfIdealPointsSubgroup n (CommHopfAlgCat.commonKernelHopfIdeal f) A := by
  rw [generatedPointsSubgroup]

/-- A matrix is a point of the generated subgroup scheme exactly when the corresponding point of
`O(GLₙ/R)` vanishes on the defining Hopf ideal. -/
@[simp]
theorem mem_generatedPointsSubgroup_iff (A : Type w) [CommRing A] [Algebra R A]
    (g : Matrix.GeneralLinearGroup (Fin n) A) :
    g ∈ generatedPointsSubgroup n f A ↔
      ∀ x ∈ CommHopfAlgCat.commonKernelHopfIdeal f,
        ((pointsMulEquiv (R := R) n).symm g).ofConv x = 0 := by
  rw [generatedPointsSubgroup_def]
  exact mem_hopfIdealPointsSubgroup_iff n (CommHopfAlgCat.commonKernelHopfIdeal f) A g

/-- **Every matrix coming from a point of one of the generators is a point of the generated
subgroup scheme.** -/
theorem pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup (i : ι)
    (A : Type w) [CommRing A] [Algebra R A]
    (p : HopfAlgebra.points (R := R) (H := K i) (CommAlgCat.of R A)) :
    pointsMulEquiv n
        ((CommHopfAlgCat.mapPointsFunctor (f i)).app (CommAlgCat.of R A) p) ∈
      generatedPointsSubgroup n f A := by
  rw [generatedPointsSubgroup_def]
  exact pointsMulEquiv_mapPointsFunctor_mem_hopfIdealPointsSubgroup n
    (CommHopfAlgCat.commonKernelHopfIdeal f) (f i)
    (CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker f i) A p

/-- A Hopf ideal killed by every generator cuts out a point subgroup containing the points of
the generated subgroup scheme. -/
theorem generatedPointsSubgroup_le_hopfIdealPointsSubgroup
    {J : HopfIdeal R (coordinateHopfAlgebra R n)}
    (hJ : ∀ i, J.toIdeal ≤ RingHom.ker (f i).hom.toAlgHom.toRingHom)
    (A : Type w) [CommRing A] [Algebra R A] :
    generatedPointsSubgroup n f A ≤ hopfIdealPointsSubgroup n J A := by
  rw [generatedPointsSubgroup_def]
  exact hopfIdealPointsSubgroup_le_of_le n
    ((CommHopfAlgCat.le_commonKernelHopfIdeal_iff f J).2 hJ) A

end TauCeti.GeneralLinear
