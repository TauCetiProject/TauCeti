module

public import Mathlib.Topology.Algebra.ContinuousMonoidHom
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.FunctorOfPoints
public import TauCeti.Topology.Algebra.IsOpenUnits
public import TauCeti.Topology.Algebra.PointTopology.Group

/-!
# The point topology on `GL_n` is the topology of the unit group

For a commutative ring `k` and a topological commutative `k`-algebra `R`, the points
`WithConv (coordinateHopfAlgebra k n →ₐ[k] R)` of `GL_n` carry the point topology, the coarsest
topology making every evaluation of a point continuous. The group `GL (Fin n) R` of invertible
matrices carries the topology of the unit group of `M_n(R)`, induced by `g ↦ (g, g⁻¹)`. This file
shows that the identification `TauCeti.GeneralLinear.pointsMulEquiv` of the two groups is a
homeomorphism. The coordinate Hopf algebra is generated by the generic entries `X i j` and their
images under the antipode, which are the entries of the inverse generic matrix, so the point
topology is induced by the entries of `g` and of `g⁻¹`.

When the units of `R` are open with continuous inversion, for instance when `R` is a topological
field such as a nonarchimedean local field `E`, the points of `GL_n` are an open subspace of
`M_n(R)` (`TauCeti.GeneralLinear.isOpenEmbedding_coe_pointsMulEquiv`).

For the valuation ring `O` of `E`, a matrix of `M_n(E)` comes from a point of `GL_n` over `O`
exactly when it is the image of a matrix over `O` whose determinant is a unit of `O`
(`TauCeti.GeneralLinear.range_coe_pointsMulEquiv_mapValue`). In particular a diagonal matrix with
entries in `O` comes from such a point exactly when its entries are units of `O`, so `diag(ϖ, 1)`
for a uniformizer `ϖ` does not, although its entries are integral and its determinant is nonzero.

## Main declarations

* `TauCeti.GeneralLinear.pointsContinuousMulEquiv`: `pointsMulEquiv` as an isomorphism of
  topological groups between the points of `GL_n` and `GL (Fin n) R`.
* `TauCeti.GeneralLinear.isOpenEmbedding_coe_pointsMulEquiv`: over a ring with open units, the
  points of `GL_n` form an open subspace of the matrices.
* `TauCeti.GeneralLinear.range_coe_pointsMulEquiv_mapValue`: the matrices coming from points with
  values in `A` are the images of the matrices over `A` with unit determinant.
* `TauCeti.GeneralLinear.diagonal_mem_range_coe_pointsMulEquiv_mapValue_iff`: along an injective
  map, a diagonal matrix comes from a point exactly when its entries are units.

## References

* B. Conrad, *Weil and Grothendieck approaches to adelic points*, Enseign. Math. (2) 58 (2012),
  Prop. 2.1, p. 2, §3, pp. 3–4, and Ex. 2.3, p. 3.
-/

public section

open Topology WithConv

namespace TauCeti

open PointTopology

namespace GeneralLinear

variable {k : Type*} [CommRing k] (n : ℕ)

section PointTopology

variable {R : Type*} [CommRing R] [Algebra k R] [TopologicalSpace R]

omit [TopologicalSpace R] in
/-- The entries of the invertible matrix of a point inverse are the values of the point on the
antipodes of the generic entries. -/
private theorem coe_inv_pointsMulEquiv_apply (x : WithConv (coordinateHopfAlgebra k n →ₐ[k] R))
    (i j : Fin n) :
    (↑(pointsMulEquiv n x)⁻¹ : Matrix (Fin n) (Fin n) R) i j =
      x.ofConv (HopfAlgebra.antipode k (A := coordinateHopfAlgebra k n)
        (coordinateHopfAlgebraAlgEquiv k n (coordinateRingMap k n (MvPolynomial.X (i, j))))) := by
  rw [← map_inv, pointsMulEquiv_apply, pointToGeneralLinear_apply, ← algHom_inv_apply]

/-- Reading a point of `GL_n` as an invertible matrix is continuous for the point topology and
the topology of the unit group. -/
private theorem continuous_pointsMulEquiv :
    Continuous (pointsMulEquiv (R := k) (A := R) n) := by
  refine Units.continuous_iff.2 ⟨continuous_matrix fun i j ↦ ?_, continuous_matrix fun i j ↦ ?_⟩
  · simpa only [Function.comp_apply, pointsMulEquiv_apply, pointToGeneralLinear_apply] using
      continuous_eval_ofConv _
  · simpa only [coe_inv_pointsMulEquiv_apply] using continuous_eval_ofConv _

variable [IsTopologicalRing R]

/-- Reading a point of `GL_n` as an invertible matrix is an embedding: the point topology is
induced by the entries of the matrix and of its inverse. -/
private theorem isEmbedding_pointsMulEquiv :
    IsEmbedding (pointsMulEquiv (R := k) (A := R) n) := by
  -- The generic entries and their antipodes generate the coordinate Hopf algebra.
  let a : (Fin n × Fin n) ⊕ (Fin n × Fin n) → coordinateHopfAlgebra k n :=
    Sum.elim (fun ij ↦ coordinateHopfAlgebraAlgEquiv k n (coordinateRingMap k n (.X ij)))
      fun ij ↦ HopfAlgebra.antipode k (A := coordinateHopfAlgebra k n)
        (coordinateHopfAlgebraAlgEquiv k n (coordinateRingMap k n (.X ij)))
  have ha : Algebra.adjoin k (Set.range a) = ⊤ := by
    rw [Set.Sum.elim_range]
    exact adjoin_coordinateHopfAlgebra_X_union_antipode_X k n
  -- Their values are the entries of the matrix and of its inverse.
  let g (M : Matrix.GeneralLinearGroup (Fin n) R) : (Fin n × Fin n) ⊕ (Fin n × Fin n) → R :=
    Sum.elim (fun ij ↦ (M : Matrix (Fin n) (Fin n) R) ij.1 ij.2)
      fun ij ↦ (↑M⁻¹ : Matrix (Fin n) (Fin n) R) ij.1 ij.2
  have hg : Continuous g := continuous_pi fun
    | .inl ij => Units.continuous_val.matrix_elem ij.1 ij.2
    | .inr ij => Units.continuous_coe_inv.matrix_elem ij.1 ij.2
  have hcomp : g ∘ pointsMulEquiv n = (fun x i ↦ x (a i)) ∘ WithConv.ofConv := by
    funext x i
    cases i with
    | inl ij => simp [g, a]
    | inr ij => simp only [Function.comp_apply, g, a, Sum.elim_inr, coe_inv_pointsMulEquiv_apply]
  refine .of_comp (continuous_pointsMulEquiv n) hg ?_
  rw [hcomp]
  exact (isEmbedding_eval_generators ha).comp isHomeomorph_ofConv.isEmbedding

/-- The identification `pointsMulEquiv` of the points of `GL_n` with the invertible matrices, as
an isomorphism of topological groups: the point topology on the points of `GL_n` is the topology
of the unit group of `M_n(R)`. -/
noncomputable def pointsContinuousMulEquiv :
    WithConv (coordinateHopfAlgebra k n →ₐ[k] R) ≃ₜ* Matrix.GeneralLinearGroup (Fin n) R where
  toMulEquiv := pointsMulEquiv n
  continuous_toFun := continuous_pointsMulEquiv n
  continuous_invFun := (isEmbedding_pointsMulEquiv n).continuous_iff.2 <|
    continuous_id.congr fun M ↦ ((pointsMulEquiv n).apply_symm_apply M).symm

/-- The underlying group isomorphism of `pointsContinuousMulEquiv` is `pointsMulEquiv`. -/
@[simp]
theorem coe_pointsContinuousMulEquiv :
    (pointsContinuousMulEquiv (k := k) (R := R) n :
        WithConv (coordinateHopfAlgebra k n →ₐ[k] R) ≃* Matrix.GeneralLinearGroup (Fin n) R) =
      pointsMulEquiv n :=
  (rfl)

/-- The forward map of `pointsContinuousMulEquiv` is `pointsMulEquiv`. -/
@[simp]
theorem pointsContinuousMulEquiv_apply (x : WithConv (coordinateHopfAlgebra k n →ₐ[k] R)) :
    pointsContinuousMulEquiv n x = pointsMulEquiv n x :=
  (rfl)

/-- The inverse map of `pointsContinuousMulEquiv` is the inverse of `pointsMulEquiv`. -/
@[simp]
theorem pointsContinuousMulEquiv_symm_apply (M : Matrix.GeneralLinearGroup (Fin n) R) :
    (pointsContinuousMulEquiv (k := k) n).symm M = (pointsMulEquiv n).symm M :=
  (rfl)

/-- When the units of `R` are open and inversion is continuous on them, for instance over a
topological field, reading a point of `GL_n` as a matrix is an open embedding into `M_n(R)`. -/
theorem isOpenEmbedding_coe_pointsMulEquiv [IsOpenUnits R] :
    IsOpenEmbedding fun x : WithConv (coordinateHopfAlgebra k n →ₐ[k] R) ↦
      (pointsMulEquiv n x : Matrix (Fin n) (Fin n) R) :=
  IsOpenUnits.isOpenEmbedding_unitsVal.comp (pointsContinuousMulEquiv n).isOpenEmbedding

end PointTopology

section Integral

variable {A B : Type*} [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]

/-- The matrices over `B` that come from points of `GL_n` with values in `A`, along a map
`φ : A → B`, are the images of the matrices over `A` whose determinant is a unit of `A`. For the
valuation ring `O` of a local field `E` and `φ : O → E`, these are the matrices with integral
entries whose determinant is a unit of `O`. -/
theorem range_coe_pointsMulEquiv_mapValue (φ : A →ₐ[k] B) :
    Set.range (fun x : WithConv (coordinateHopfAlgebra k n →ₐ[k] A) ↦
        (pointsMulEquiv n (AlgHom.mapValue φ x) : Matrix (Fin n) (Fin n) B)) =
      {M | ∃ N : Matrix (Fin n) (Fin n) A, IsUnit N.det ∧ N.map φ = M} := by
  ext M
  simp only [pointsMulEquiv_mapValue, Set.mem_range, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨pointsMulEquiv n x, Matrix.isUnits_det_units _, rfl⟩
  · rintro ⟨N, hN, rfl⟩
    obtain ⟨u, rfl⟩ := (Matrix.isUnit_iff_isUnit_det N).2 hN
    exact ⟨(pointsMulEquiv n).symm u, by simp [Matrix.GeneralLinearGroup.map]⟩

/-- Along an injective map `φ : A → B`, the diagonal matrix with entries `φ (d i)` comes from a
point of `GL_n` with values in `A` exactly when every `d i` is a unit of `A`. For the valuation
ring `O` of a local field and a uniformizer `ϖ`, the matrix `diag(ϖ, 1)` has integral entries and
nonzero determinant, but does not come from a point of `GL_2` over `O`. -/
theorem diagonal_mem_range_coe_pointsMulEquiv_mapValue_iff {φ : A →ₐ[k] B}
    (hφ : Function.Injective φ) (d : Fin n → A) :
    Matrix.diagonal (fun i ↦ φ (d i)) ∈ Set.range
        (fun x : WithConv (coordinateHopfAlgebra k n →ₐ[k] A) ↦
          (pointsMulEquiv n (AlgHom.mapValue φ x) : Matrix (Fin n) (Fin n) B)) ↔
      ∀ i, IsUnit (d i) := by
  rw [range_coe_pointsMulEquiv_mapValue, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨N, hN, hNd⟩
    have : N = Matrix.diagonal d := by
      ext i j
      apply hφ
      simpa [Matrix.diagonal_apply, apply_ite φ] using congrFun (congrFun hNd i) j
    simpa [this] using hN
  · intro hd
    exact ⟨Matrix.diagonal d, by simpa using hd, by simp [Matrix.diagonal_map]⟩

end Integral

end GeneralLinear

end TauCeti
