/-!
# Prime-units of an affine group over `ℚ`

Let `H` be a Hopf algebra over `ℚ`, the coordinate algebra of an affine group `G`, and `l` a
prime. A rational point `γ ∈ G(ℚ)` is an *`l`-unit* when, for every prime `v ≠ l`, the cyclic
subgroup `{γⁿ : n ∈ ℤ}` is relatively compact in the group `G(ℚ_v)` of `ℚ_v`-points, with the point
topology of `TauCeti.PointTopology`. No condition is imposed at `l` or at the real place: `l` itself
is an `l`-unit of the multiplicative group. For the multiplicative group over `ℚ` the `l`-units
are exactly the rational numbers `± lⁿ`, `n ∈ ℤ`
(`TauCeti.MultiplicativeGroup.isPrimeUnit_iff_exists_zpow`).

The notion comes from Kisin, Madapusi Pera and Shin's study of Frobenius elements of Shimura
varieties. Their Lemma 2.2.4, not proved here, says that on a torus over `ℚ` whose maximal
`ℝ`-split subtorus is defined and split over `ℚ`, the `l`-units are exactly the rational points
whose eigenvalues are `l`-Weil numbers.

The condition is about the group generated by `γ`, not about `γ` alone: inverse powers count.
Thus `l`-units are stable under integer powers, inverses, conjugation and morphisms of affine
groups, closed immersions reflect them, and the product of two commuting `l`-units is an `l`-unit.
In a commutative group the `l`-units form a subgroup (`TauCeti.HopfAlgebra.primeUnitSubgroup`).
In a noncommutative group they need not, which is why `IsPrimeUnit.mul` asks for commuting
factors: for a prime `q ≠ l`, the matrices `[[1, 1/q], [0, 1]]` and `[[1, 0], [1/q, 1]]` of
`GL₂(ℚ)` are `l`-units, while their product has trace `2 + 1/q²`, which is not `q`-integral, so it
lies in no compact subgroup of `GL₂(ℚ_q)`.

## Main declarations

* `TauCeti.HopfAlgebra.IsPrimeUnit`: the `l`-unit condition on a rational point.
* `TauCeti.HopfAlgebra.IsPrimeUnit.zpow`, `TauCeti.HopfAlgebra.isPrimeUnit_inv_iff`,
  `TauCeti.HopfAlgebra.IsPrimeUnit.mul`: integer powers, inverses and products of commuting
  `l`-units.
* `TauCeti.HopfAlgebra.IsPrimeUnit.mapDomain`: morphisms of affine groups preserve `l`-units.
* `TauCeti.HopfAlgebra.isPrimeUnit_mapDomain_iff`: closed immersions, given by surjective
  bialgebra maps of coordinate algebras, reflect `l`-units.
* `TauCeti.HopfAlgebra.isPrimeUnit_conj_iff`: conjugation preserves and reflects `l`-units.
* `TauCeti.HopfAlgebra.primeUnitSubgroup`: the subgroup of `l`-units of a commutative group.

## References

* M. Kisin, K. Madapusi Pera, S. W. Shin, *Honda–Tate theory for Shimura varieties*, Duke Math.
  J. 171 (2022), §2.2.3 and Lemma 2.2.4.
-/

public section

open WithConv TauCeti.PointTopology Topology

namespace TauCeti.HopfAlgebra

variable {H : Type*} [Ring H] [HopfAlgebra ℚ H] {l : ℕ}

/-- A rational point `γ` of the affine group with coordinate Hopf algebra `H` over `ℚ` is an
`l`-unit when, for every prime `v ≠ l`, the subgroup `{γⁿ : n ∈ ℤ}` is relatively compact in the
group of `ℚ_v`-points with the point topology. No condition is imposed at `l` or at the real
place. -/
def IsPrimeUnit (l : ℕ) (γ : WithConv (H →ₐ[ℚ] ℚ)) : Prop :=
  ∀ (v : ℕ) [Fact v.Prime], v ≠ l →
    IsCompact (closure (Subgroup.zpowers (AlgHom.mapValue (Algebra.ofId ℚ ℚ_[v]) γ) :
      Set (WithConv (H →ₐ[ℚ] ℚ_[v]))))

/-- A rational point is an `l`-unit exactly when, for every prime `v ≠ l`, its powers are
relatively compact in the `ℚ_v`-points. -/
theorem isPrimeUnit_iff {γ : WithConv (H →ₐ[ℚ] ℚ)} :
    IsPrimeUnit l γ ↔ ∀ (v : ℕ) [Fact v.Prime], v ≠ l →
      IsCompact (closure (Subgroup.zpowers (AlgHom.mapValue (Algebra.ofId ℚ ℚ_[v]) γ) :
        Set (WithConv (H →ₐ[ℚ] ℚ_[v])))) :=
  Iff.rfl

/-- The identity is an `l`-unit. -/
@[simp]
theorem isPrimeUnit_one (l : ℕ) : IsPrimeUnit l (1 : WithConv (H →ₐ[ℚ] ℚ)) := by
  intro v _ _
  rw [map_one, Subgroup.zpowers_one_eq_bot, Subgroup.coe_bot, closure_singleton]
  exact isCompact_singleton

/-- Integer powers of an `l`-unit are `l`-units. -/
theorem IsPrimeUnit.zpow {γ : WithConv (H →ₐ[ℚ] ℚ)} (hγ : IsPrimeUnit l γ) (n : ℤ) :
    IsPrimeUnit l (γ ^ n) := by
  intro v _ hv
  refine (hγ v hv).of_isClosed_subset isClosed_closure (closure_mono ?_)
  rw [map_zpow]
  exact Subgroup.zpowers_le.mpr (Subgroup.zpow_mem_zpowers _ n)

/-- Natural powers of an `l`-unit are `l`-units. -/
theorem IsPrimeUnit.pow {γ : WithConv (H →ₐ[ℚ] ℚ)} (hγ : IsPrimeUnit l γ) (n : ℕ) :
    IsPrimeUnit l (γ ^ n) := by
  simpa using hγ.zpow n

/-- A rational point is an `l`-unit exactly when its inverse is. -/
@[simp]
theorem isPrimeUnit_inv_iff {γ : WithConv (H →ₐ[ℚ] ℚ)} :
    IsPrimeUnit l γ⁻¹ ↔ IsPrimeUnit l γ := by
  simp only [isPrimeUnit_iff, map_inv, Subgroup.zpowers_inv]

/-- The inverse of an `l`-unit is an `l`-unit. -/
theorem IsPrimeUnit.inv {γ : WithConv (H →ₐ[ℚ] ℚ)} (hγ : IsPrimeUnit l γ) :
    IsPrimeUnit l γ⁻¹ :=
  isPrimeUnit_inv_iff.mpr hγ

/-- The product of two commuting `l`-units is an `l`-unit. Commutativity is needed: in `GL₂(ℚ)` the
product of two `l`-units need not be one. -/
theorem IsPrimeUnit.mul {γ δ : WithConv (H →ₐ[ℚ] ℚ)} (hγ : IsPrimeUnit l γ)
    (hδ : IsPrimeUnit l δ) (h : Commute γ δ) : IsPrimeUnit l (γ * δ) := by
  intro v _ hv
  -- `(γ δ)ⁿ = γⁿ δⁿ` lies in the product of the two compact closures.
  refine ((hγ v hv).mul (hδ v hv)).closure_of_subset ?_
  rintro _ ⟨n, rfl⟩
  simp only [map_mul]
  rw [(h.map (AlgHom.mapValue (Algebra.ofId ℚ ℚ_[v]))).mul_zpow]
  exact Set.mul_mem_mul (subset_closure (Subgroup.zpow_mem_zpowers _ n))
    (subset_closure (Subgroup.zpow_mem_zpowers _ n))

section Conjugation

/-- A conjugate of an `l`-unit is an `l`-unit. -/
theorem IsPrimeUnit.conj {γ : WithConv (H →ₐ[ℚ] ℚ)} (hγ : IsPrimeUnit l γ)
    (g : WithConv (H →ₐ[ℚ] ℚ)) : IsPrimeUnit l (g * γ * g⁻¹) := by
  intro v _ hv
  have hc := hγ v hv
  set ψ := AlgHom.mapValue (H := H) (Algebra.ofId ℚ ℚ_[v])
  -- Conjugation by `ψ g` is a continuous automorphism of the `ℚ_v`-points carrying the powers of
  -- `ψ γ` to those of `ψ (g γ g⁻¹)`.
  have hcont : Continuous (MulAut.conj (ψ g)).toMonoidHom := by
    rw [MulEquiv.coe_toMonoidHom]
    exact (IsTopologicalGroup.continuous_conj (ψ g)).congr fun x ↦ (MulAut.conj_apply _ _).symm
  have hψ : ψ (g * γ * g⁻¹) = (MulAut.conj (ψ g)).toMonoidHom (ψ γ) := by simp
  rw [hψ, ← MonoidHom.map_zpowers, Subgroup.coe_map]
  exact hc.closure_image hcont.continuousOn

/-- Conjugation preserves and reflects `l`-units. -/
@[simp]
theorem isPrimeUnit_conj_iff {γ g : WithConv (H →ₐ[ℚ] ℚ)} :
    IsPrimeUnit l (g * γ * g⁻¹) ↔ IsPrimeUnit l γ := by
  refine ⟨fun h ↦ ?_, fun h ↦ h.conj g⟩
  simpa [mul_assoc] using h.conj g⁻¹

end Conjugation

section MapDomain

variable {H' : Type*} [Ring H'] [HopfAlgebra ℚ H']

/-- A morphism of affine groups, given by a bialgebra map `φ` of coordinate algebras, sends
`l`-units to `l`-units. -/
theorem IsPrimeUnit.mapDomain {γ : WithConv (H →ₐ[ℚ] ℚ)} (hγ : IsPrimeUnit l γ)
    (φ : H' →ₐc[ℚ] H) : IsPrimeUnit l (BialgHom.mapDomain φ γ) := by
  intro v _ hv
  rw [BialgHom.coe_zpowers_mapValue_mapDomain]
  exact (hγ v hv).closure_image (BialgHom.continuous_mapDomain φ).continuousOn

/-- A closed immersion of affine groups, given by a surjective bialgebra map `φ` of coordinate
algebras, preserves and reflects `l`-units. So the `l`-unit condition can be tested after a
closed embedding into another affine group, such as `GL_n`. -/
theorem isPrimeUnit_mapDomain_iff {φ : H' →ₐc[ℚ] H} (hφ : Function.Surjective φ)
    {γ : WithConv (H →ₐ[ℚ] ℚ)} : IsPrimeUnit l (BialgHom.mapDomain φ γ) ↔ IsPrimeUnit l γ := by
  refine ⟨fun hγ v _ hv ↦ ?_, fun hγ ↦ hγ.mapDomain φ⟩
  -- Over `ℚ_v`, precomposition with `φ` is a closed embedding of groups of points.
  have he := BialgHom.isClosedEmbedding_mapDomain_of_surjective (R := ℚ_[v]) hφ
  have hc := hγ v hv
  rw [BialgHom.coe_zpowers_mapValue_mapDomain, he.closure_image_eq] at hc
  exact he.isCompact_iff.mpr hc

end MapDomain

section Cocommutative

variable (H l) [Coalgebra.IsCocomm ℚ H]

/-- The `l`-units of a commutative affine group over `ℚ`, that is, one with cocommutative
coordinate Hopf algebra, form a subgroup of its rational points. -/
def primeUnitSubgroup : Subgroup (WithConv (H →ₐ[ℚ] ℚ)) where
  carrier := {γ | IsPrimeUnit l γ}
  mul_mem' hγ hδ := hγ.mul hδ (Commute.all _ _)
  one_mem' := isPrimeUnit_one l
  inv_mem' := IsPrimeUnit.inv

variable {H l}

@[simp]
theorem mem_primeUnitSubgroup {γ : WithConv (H →ₐ[ℚ] ℚ)} :
    γ ∈ primeUnitSubgroup H l ↔ IsPrimeUnit l γ :=
  Iff.rfl

end Cocommutative

end TauCeti.HopfAlgebra
