public import TauCeti.Algebra.AlgebraicGroup.ConstantForm.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.ConstantForm.Congruence.Basic

/-!
# The determinant-one subgroup scheme of a constant form

The determinant-one subgroup scheme of the group preserving a matrix `C` is cut out in
`GLₙ` by the entries of `X C Xᵀ - C` and by `det X - 1`. This construction works over a
commutative ring and permits degenerate forms. The matrix condition on points uses the row
convention of `TauCeti.ConstantForm`.

The identity and antidiagonal forms give the standard and antidiagonal special orthogonal
groups. Congruence of forms induces conjugation on the matrix groups, through the constant-form
congruence theorem for the defining ideals.

The join presentation follows `TauCeti.SpecialOrthogonal.definingHopfIdeal`. The base-change
transport follows `TauCeti.Symplectic.coordinateHopfAlgebraBaseChangeIso`, generalized here
from the standard and antidiagonal special orthogonal constructions to an arbitrary form.

## References

* The Stacks Project, [Tag 022W](https://stacks.math.columbia.edu/tag/022W), for the ambient
  general linear group scheme, and [Tag 01JO](https://stacks.math.columbia.edu/tag/01JO), for
  base change of affine schemes.
-/

public section

open AlgebraicGeometry CategoryTheory Matrix
open WithConv
open scoped TensorProduct

namespace TauCeti.ConstantForm.Special

universe u v w

variable (R : Type u) [CommRing R] (n : ℕ) (C : Matrix (Fin n) (Fin n) R)

/-- The Hopf ideal cutting out the determinant-one subgroup of the group preserving `C`. -/
noncomputable def definingHopfIdeal : HopfIdeal R (GeneralLinear.coordinateHopfAlgebra R n) :=
  ConstantForm.definingHopfIdeal R n C ⊔ SpecialLinear.definingHopfIdeal R n

/-- The defining Hopf ideal is the join of the form and determinant-one ideals. -/
theorem definingHopfIdeal_def :
    definingHopfIdeal R n C =
      ConstantForm.definingHopfIdeal R n C ⊔ SpecialLinear.definingHopfIdeal R n :=
  (rfl)

/-- The underlying ideal is generated by the form relations and the determinant-one relation. -/
@[simp]
theorem definingHopfIdeal_toIdeal :
    (definingHopfIdeal R n C).toIdeal =
      Ideal.span (ConstantForm.relationSet R n C ∪
        {(GeneralLinear.determinantGroupLike R n :
          GeneralLinear.coordinateHopfAlgebra R n) - 1}) := by
  rw [definingHopfIdeal_def, HopfIdeal.sup_toIdeal, ConstantForm.definingHopfIdeal_toIdeal,
    SpecialLinear.definingHopfIdeal_toIdeal, Ideal.span_union]

/-- A coordinate morphism kills the defining ideal exactly when its generic matrix preserves
the scalar image of the form and its generic determinant maps to one. -/
@[simp↓]
theorem definingHopfIdeal_toIdeal_le_ker_iff {T : Type*} [Ring T] [Algebra R T]
    (phi : GeneralLinear.coordinateHopfAlgebra R n →ₐ[R] T) :
    (definingHopfIdeal R n C).toIdeal ≤ RingHom.ker (phi : _ →+* T) ↔
      (GeneralLinear.genericMatrix R n).map phi * C.map (algebraMap R T) *
          ((GeneralLinear.genericMatrix R n).map phi)ᵀ = C.map (algebraMap R T) ∧
        phi (GeneralLinear.determinantGroupLike R n) = 1 := by
  rw [definingHopfIdeal_def, HopfIdeal.sup_toIdeal, sup_le_iff,
    ConstantForm.definingHopfIdeal_toIdeal_le_ker_iff]
  exact Iff.rfl.and (SpecialLinear.definingHopfIdeal_toIdeal_le_ker_iff R n (phi : _ →+* T))

/-- The coordinate Hopf algebra of the determinant-one subgroup scheme preserving `C`. -/
noncomputable abbrev coordinateHopfAlgebra : _root_.CommHopfAlgCat.{u} R :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra R n) (definingHopfIdeal R n C)

/-- The quotient morphism from the general-linear coordinate Hopf algebra. -/
noncomputable def coordinateMap :
    GeneralLinear.coordinateHopfAlgebra R n ⟶ coordinateHopfAlgebra R n C :=
  CommHopfAlgCat.mkQuotient _ (definingHopfIdeal R n C)

/-- The coordinate morphism is the quotient by the joint defining Hopf ideal. -/
theorem coordinateMap_def :
    coordinateMap R n C = CommHopfAlgCat.mkQuotient _ (definingHopfIdeal R n C) :=
  (rfl)

/-- The coordinate morphism sends an ambient coordinate to its quotient class. -/
theorem coordinateMap_apply (h : GeneralLinear.coordinateHopfAlgebra R n) :
    (coordinateMap R n C).hom h = Ideal.Quotient.mkₐ R (definingHopfIdeal R n C).toIdeal h :=
  CommHopfAlgCat.mkQuotient_apply _ _ h

/-- Each form relation vanishes in the determinant-one coordinate Hopf algebra. -/
@[simp↓]
theorem coordinateMap_relationMatrix (i j : Fin n) :
    (coordinateMap R n C).hom (ConstantForm.relationMatrix R n C i j) = 0 := by
  rw [coordinateMap_def, CommHopfAlgCat.mkQuotient_eq_zero_iff, ← HopfIdeal.mem_toIdeal,
    definingHopfIdeal_toIdeal]
  exact Ideal.subset_span (Or.inl (ConstantForm.relationMatrix_mem_relationSet R n C i j))

/-- The generic determinant maps to one in the determinant-one coordinate Hopf algebra. -/
@[simp↓]
theorem coordinateMap_determinantGroupLike :
    (coordinateMap R n C).hom (GeneralLinear.determinantGroupLike R n) = 1 := by
  rw [coordinateMap_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.mk_eq_one_iff_sub_mem,
    definingHopfIdeal_toIdeal]
  exact Ideal.subset_span (Or.inr rfl)

/-- The finite-type coordinate Hopf algebra of the determinant-one subgroup scheme preserving
`C`. -/
noncomputable def finiteTypeCoordinateHopfAlgebra : FiniteTypeCommHopfAlgCat R :=
  ⟨coordinateHopfAlgebra R n C, (finiteTypeCommHopfAlgProperty_iff _).mpr inferInstance⟩

/-- The underlying Hopf algebra of the finite-type package is the quotient coordinate
Hopf algebra. -/
@[simp]
theorem finiteTypeCoordinateHopfAlgebra_obj :
    (finiteTypeCoordinateHopfAlgebra R n C).obj = coordinateHopfAlgebra R n C :=
  (rfl)

/-- The determinant-one subgroup scheme preserving `C`, as a closed subgroup scheme of
`GLₙ`. -/
noncomputable abbrev groupScheme :=
  CommHopfAlgCat.quotientSpec (GeneralLinear.coordinateHopfAlgebra R n) (definingHopfIdeal R n C)

/-- The determinant-one subgroup scheme is the quotient spectrum of its defining Hopf ideal. -/
theorem groupScheme_def :
    groupScheme R n C =
      CommHopfAlgCat.quotientSpec (GeneralLinear.coordinateHopfAlgebra R n)
        (definingHopfIdeal R n C) :=
  (rfl)

/-- The inclusion of the determinant-one subgroup scheme into the constant-form group scheme. -/
noncomputable def inclusion :
    groupScheme R n C ⟶ ConstantForm.groupScheme R n C :=
  CommHopfAlgCat.quotientSpecMapOfLe (GeneralLinear.coordinateHopfAlgebra R n)
    (le_sup_left.trans_eq (definingHopfIdeal_def R n C).symm)

/-- The inclusion is induced by the containment of the constant-form ideal in the joint ideal. -/
theorem inclusion_def :
    inclusion R n C =
      CommHopfAlgCat.quotientSpecMapOfLe (GeneralLinear.coordinateHopfAlgebra R n)
        (le_sup_left.trans_eq (definingHopfIdeal_def R n C).symm) :=
  (rfl)

/-- The determinant-one inclusion into the form-preserving group is a closed immersion. -/
instance isClosedImmersion_inclusion : IsClosedImmersion (inclusion R n C).hom.hom.left := by
  rw [inclusion_def]
  infer_instance

/-- The inclusion into the form-preserving group followed by its inclusion into `GLₙ` is the
closed immersion defined by the joint ideal. -/
@[simp, reassoc]
theorem inclusion_comp_constantForm_inclusion :
    inclusion R n C ≫ ConstantForm.inclusion R n C =
      GeneralLinear.hopfIdealInclusion R n (definingHopfIdeal R n C) := by
  rw [inclusion_def, ConstantForm.inclusion_def, GeneralLinear.hopfIdealInclusion_def,
    GeneralLinear.hopfIdealInclusion_def, ← Category.assoc]
  simp

section Points

variable (A : Type w) [CommRing A] [Algebra R A]

/-- The matrix points form the intersection of the form stabilizer and the determinant kernel. -/
@[simp]
theorem hopfIdealPointsSubgroup_definingHopfIdeal :
    GeneralLinear.hopfIdealPointsSubgroup n (definingHopfIdeal R n C) A =
      ConstantForm.pointsSubgroup (C.map (algebraMap R A)) ⊓
        (Matrix.GeneralLinearGroup.det : GL (Fin n) A →* Aˣ).ker := by
  rw [definingHopfIdeal_def, GeneralLinear.hopfIdealPointsSubgroup_sup,
    ConstantForm.hopfIdealPointsSubgroup_definingHopfIdeal,
    SpecialLinear.hopfIdealPointsSubgroup_definingHopfIdeal]

/-- An invertible matrix represents a point of the determinant-one subgroup precisely when it
preserves the scalar-extended form and has determinant one. -/
theorem mem_hopfIdealPointsSubgroup_iff (g : GL (Fin n) A) :
    g ∈ GeneralLinear.hopfIdealPointsSubgroup n (definingHopfIdeal R n C) A ↔
      (g : Matrix (Fin n) (Fin n) A) * C.map (algebraMap R A) *
        (g : Matrix (Fin n) (Fin n) A)ᵀ = C.map (algebraMap R A) ∧
      (g : Matrix (Fin n) (Fin n) A).det = 1 := by
  rw [hopfIdealPointsSubgroup_definingHopfIdeal, Subgroup.mem_inf,
    ConstantForm.mem_pointsSubgroup_iff, MonoidHom.mem_ker,
    ← Units.val_eq_one, Matrix.GeneralLinearGroup.val_det_apply]

variable {A}

/-- The algebra-valued points of the determinant-one subgroup scheme are the invertible
matrices preserving the scalar-extended form and having determinant one. -/
noncomputable def pointsMulEquiv :
    HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n C) (CommAlgCat.of R A) ≃*
      ↥(ConstantForm.pointsSubgroup (C.map (algebraMap R A)) ⊓
        (Matrix.GeneralLinearGroup.det : GL (Fin n) A →* Aˣ).ker) :=
  (GeneralLinear.hopfIdealPointsSubgroupMulEquiv n (definingHopfIdeal R n C)
    (CommAlgCat.of R A)).trans (MulEquiv.subgroupCongr (hopfIdealPointsSubgroup_definingHopfIdeal
      R n C A))

/-- The matrix underlying the point equivalence is the matrix of the included general-linear
point. -/
theorem pointsMulEquiv_coe
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n C) (CommAlgCat.of R A)) :
    (pointsMulEquiv R n C (A := A) f : GL (Fin n) A) =
      GeneralLinear.pointsMulEquiv n
        (CommHopfAlgCat.quotientPointsHom _ (definingHopfIdeal R n C) (CommAlgCat.of R A) f) := by
  rw [pointsMulEquiv, MulEquiv.trans_apply, MulEquiv.subgroupCongr_apply,
    GeneralLinear.coe_hopfIdealPointsSubgroupMulEquiv_apply]

/-- The ambient point of a determinant-one form-preserving matrix is its general-linear point. -/
@[simp↓]
theorem quotientPointsHom_pointsMulEquiv_symm
    (g : ↥(ConstantForm.pointsSubgroup (C.map (algebraMap R A)) ⊓
      (Matrix.GeneralLinearGroup.det : GL (Fin n) A →* Aˣ).ker)) :
    CommHopfAlgCat.quotientPointsHom _ (definingHopfIdeal R n C) (CommAlgCat.of R A)
        ((pointsMulEquiv R n C (A := A)).symm g) =
      (GeneralLinear.pointsMulEquiv (R := R) (A := A) n).symm (g : GL (Fin n) A) := by
  apply (GeneralLinear.pointsMulEquiv (R := R) (A := A) n).injective
  rw [← pointsMulEquiv_coe, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply]

/-- The point equivalence sends scalar extension along an algebra map to entrywise matrix
extension along that map. -/
theorem pointsMulEquiv_mapValue {B : Type v} [CommRing B] [Algebra R B] (phi : A →ₐ[R] B)
    (f : WithConv (coordinateHopfAlgebra R n C →ₐ[R] A)) :
    (pointsMulEquiv R n C (A := B) (AlgHom.mapValue (H := coordinateHopfAlgebra R n C) phi f) :
      GL (Fin n) B) =
      GeneralLinearGroup.map (phi : A →+* B) (pointsMulEquiv R n C (A := A) f : GL (Fin n) A) := by
  rw [pointsMulEquiv_coe, pointsMulEquiv_coe, ← CommHopfAlgCat.mapValue_quotientPointsHom,
    GeneralLinear.pointsMulEquiv_mapValue]

/-- The inverse point equivalence commutes with entrywise extension along an algebra map. -/
theorem mapValue_pointsMulEquiv_symm_apply {B : Type v} [CommRing B] [Algebra R B]
    (phi : A →ₐ[R] B)
    (g : ↥(ConstantForm.pointsSubgroup (C.map (algebraMap R A)) ⊓
      (Matrix.GeneralLinearGroup.det : GL (Fin n) A →* Aˣ).ker)) :
    AlgHom.mapValue (H := coordinateHopfAlgebra R n C) phi
        ((pointsMulEquiv R n C (A := A)).symm g) =
      (pointsMulEquiv R n C (A := B)).symm
        (GeneralLinear.mapHopfIdealPointsSubgroupCongr n (definingHopfIdeal R n C)
          (hopfIdealPointsSubgroup_definingHopfIdeal R n C A).symm
          (hopfIdealPointsSubgroup_definingHopfIdeal R n C B).symm phi g) := by
  apply (pointsMulEquiv R n C (A := B)).injective
  rw [MulEquiv.apply_symm_apply]
  apply Subtype.ext
  rw [pointsMulEquiv_mapValue, MulEquiv.apply_symm_apply,
    GeneralLinear.coe_mapHopfIdealPointsSubgroupCongr]

/-- An ambient algebra-valued point lies in the determinant-one subgroup scheme precisely
when its matrix preserves the scalar-extended form and has determinant one. -/
@[simp↓]
theorem mem_definingPointsSubgroup_iff
    (g : HopfAlgebra.points (R := R) (H := GeneralLinear.coordinateHopfAlgebra R n)
      (CommAlgCat.of R A)) :
    g ∈ CommHopfAlgCat.quotientPointsSubgroup _ (definingHopfIdeal R n C) (CommAlgCat.of R A) ↔
      (GeneralLinear.pointsMulEquiv n g : Matrix (Fin n) (Fin n) A) * C.map (algebraMap R A) *
        (GeneralLinear.pointsMulEquiv n g : Matrix (Fin n) (Fin n) A)ᵀ =
          C.map (algebraMap R A) ∧
        (GeneralLinear.pointsMulEquiv n g : Matrix (Fin n) (Fin n) A).det = 1 := by
  rw [← mem_hopfIdealPointsSubgroup_iff R n C A, GeneralLinear.mem_hopfIdealPointsSubgroup_iff,
    MulEquiv.symm_apply_apply, CommHopfAlgCat.mem_quotientPointsSubgroup_iff]

end Points

section Congruence

variable {R n C} {C' : Matrix (Fin n) (Fin n) R}

/-- Congruence of coefficient matrices induces an isomorphism of determinant-one coordinate
Hopf algebras, by conjugation on the ambient general linear group. -/
noncomputable def coordinateHopfAlgebraCongr (P : GL (Fin n) R)
    (hP : (P : Matrix (Fin n) (Fin n) R) * C * (P : Matrix (Fin n) (Fin n) R)ᵀ = C') :
    coordinateHopfAlgebra R n C ≅ coordinateHopfAlgebra R n C' :=
  CommHopfAlgCat.quotientIsoOfComapEq (GeneralLinear.conjCoordinateIso P⁻¹)
    (definingHopfIdeal R n C') (by
      simpa only [definingHopfIdeal_def] using
        ConstantForm.sup_specialLinear_comapOfSurjective_conjCoordinateIso_inv P hP)

/-- The coordinate isomorphism for a congruence is the quotient of ambient conjugation. -/
theorem coordinateHopfAlgebraCongr_def (P : GL (Fin n) R)
    (hP : (P : Matrix (Fin n) (Fin n) R) * C * (P : Matrix (Fin n) (Fin n) R)ᵀ = C') :
    coordinateHopfAlgebraCongr P hP =
      CommHopfAlgCat.quotientIsoOfComapEq (GeneralLinear.conjCoordinateIso P⁻¹)
        (definingHopfIdeal R n C') (by
          simpa only [definingHopfIdeal_def] using
            ConstantForm.sup_specialLinear_comapOfSurjective_conjCoordinateIso_inv P hP) :=
  (rfl)

/-- The coordinate isomorphism induced by congruence intertwines the quotient maps with the
pullback of conjugation by `P⁻¹` on `GLₙ`. -/
@[reassoc]
theorem coordinateMap_comp_coordinateHopfAlgebraCongr_hom (P : GL (Fin n) R)
    (hP : (P : Matrix (Fin n) (Fin n) R) * C * (P : Matrix (Fin n) (Fin n) R)ᵀ = C') :
    coordinateMap R n C ≫ (coordinateHopfAlgebraCongr P hP).hom =
      (GeneralLinear.conjCoordinateIso P⁻¹).hom ≫ coordinateMap R n C' :=
  CommHopfAlgCat.mkQuotient_comp_quotientIsoOfComapEq_hom _ _ _

/-- The inverse coordinate isomorphism intertwines the quotient maps with the pullback of
conjugation by `P` on `GLₙ`. -/
@[reassoc]
theorem coordinateMap_comp_coordinateHopfAlgebraCongr_inv (P : GL (Fin n) R)
    (hP : (P : Matrix (Fin n) (Fin n) R) * C * (P : Matrix (Fin n) (Fin n) R)ᵀ = C') :
    coordinateMap R n C' ≫ (coordinateHopfAlgebraCongr P hP).inv =
      (GeneralLinear.conjCoordinateIso P).hom ≫ coordinateMap R n C := by
  rw [coordinateMap_def, coordinateMap_def, coordinateHopfAlgebraCongr_def,
    CommHopfAlgCat.mkQuotient_comp_quotientIsoOfComapEq_inv, GeneralLinear.conjCoordinateIso_inv,
    Iso.symm_inv]

/-- Precomposing a point preserving `C'` with the coordinate isomorphism for `P C Pᵀ = C'`
sends its ambient matrix `M` to `P⁻¹ M P`, with `P` mapped to the value algebra. -/
theorem pointsMulEquiv_mapPointsFunctor_coordinateHopfAlgebraCongr (P : GL (Fin n) R)
    (hP : (P : Matrix (Fin n) (Fin n) R) * C * (P : Matrix (Fin n) (Fin n) R)ᵀ = C')
    {A : Type w} [CommRing A] [Algebra R A]
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n C') (CommAlgCat.of R A)) :
    (pointsMulEquiv R n C (A := A) ((CommHopfAlgCat.Hom.mapPointsFunctor
        (coordinateHopfAlgebraCongr P hP).hom).app (CommAlgCat.of R A) f) : GL (Fin n) A) =
      GeneralLinearGroup.map (algebraMap R A) P⁻¹ *
        (pointsMulEquiv R n C' (A := A) f : GL (Fin n) A) *
        (GeneralLinearGroup.map (algebraMap R A) P⁻¹)⁻¹ := by
  rw [pointsMulEquiv_coe R n C' f]
  refine (pointsMulEquiv_coe R n C _).trans ?_
  simp only [CommHopfAlgCat.quotientPointsHom, ← coordinateMap_def]
  refine (congrArg (GeneralLinear.pointsMulEquiv n)
    (CommHopfAlgCat.Hom.mapPointsFunctor_comp_app_apply (coordinateMap R n C)
      (coordinateHopfAlgebraCongr P hP).hom (CommAlgCat.of R A) f).symm).trans ?_
  rw [coordinateMap_comp_coordinateHopfAlgebraCongr_hom]
  exact (congrArg (GeneralLinear.pointsMulEquiv n)
    (CommHopfAlgCat.Hom.mapPointsFunctor_comp_app_apply (GeneralLinear.conjCoordinateIso P⁻¹).hom
      (coordinateMap R n C') (CommAlgCat.of R A) f)).trans
    (GeneralLinear.pointsMulEquiv_mapPointsFunctor_conjCoordinateIso P⁻¹ _ _)

/-- Congruence of coefficient matrices induces the corresponding conjugation isomorphism
of determinant-one group schemes. -/
noncomputable def groupSchemeCongr (P : GL (Fin n) R)
    (hP : (P : Matrix (Fin n) (Fin n) R) * C * (P : Matrix (Fin n) (Fin n) R)ᵀ = C') :
    groupScheme R n C ≅ groupScheme R n C' :=
  (AlgebraicGeometry.hopfSpec (CommRingCat.of R)).mapIso (coordinateHopfAlgebraCongr P hP).op.symm

/-- The group-scheme isomorphism for a congruence is induced by the coordinate isomorphism. -/
theorem groupSchemeCongr_def (P : GL (Fin n) R)
    (hP : (P : Matrix (Fin n) (Fin n) R) * C * (P : Matrix (Fin n) (Fin n) R)ᵀ = C') :
    groupSchemeCongr P hP =
      (AlgebraicGeometry.hopfSpec (CommRingCat.of R)).mapIso
        (coordinateHopfAlgebraCongr P hP).op.symm :=
  (rfl)

/-- The group-scheme isomorphism is induced by conjugation by `P` on the ambient group. -/
@[reassoc]
theorem groupSchemeCongr_hom_comp_hopfIdealInclusion (P : GL (Fin n) R)
    (hP : (P : Matrix (Fin n) (Fin n) R) * C * (P : Matrix (Fin n) (Fin n) R)ᵀ = C') :
    (groupSchemeCongr P hP).hom ≫
        GeneralLinear.hopfIdealInclusion R n (definingHopfIdeal R n C') =
      GeneralLinear.hopfIdealInclusion R n (definingHopfIdeal R n C) ≫
        eqToHom (GeneralLinear.groupScheme_def R n) ≫
        (AlgebraicGeometry.hopfSpec (CommRingCat.of R)).map
          (GeneralLinear.conjCoordinateIso P).hom.op ≫
        eqToHom (GeneralLinear.groupScheme_def R n).symm := by
  simp only [groupSchemeCongr_def, GeneralLinear.hopfIdealInclusion_def, Functor.mapIso_hom,
    Iso.symm_hom, Iso.op_inv, CommHopfAlgCat.quotientSpecι_def, Category.assoc,
    eqToHom_trans_assoc, eqToHom_refl, Category.id_comp, ← Functor.map_comp_assoc, ← op_comp,
    ← coordinateMap_def, coordinateMap_comp_coordinateHopfAlgebraCongr_inv]

/-- Congruence commutes with inclusion into the full form-preserving subgroup schemes. -/
@[reassoc]
theorem groupSchemeCongr_hom_comp_inclusion (P : GL (Fin n) R)
    (hP : (P : Matrix (Fin n) (Fin n) R) * C * (P : Matrix (Fin n) (Fin n) R)ᵀ = C') :
    (groupSchemeCongr P hP).hom ≫ inclusion R n C' =
      inclusion R n C ≫ (ConstantForm.groupSchemeCongr P hP).hom := by
  have : Mono (ConstantForm.inclusion R n C') :=
    (Grp.forget _ ⋙ Over.forget _).mono_of_mono_map
      (inferInstanceAs (Mono (ConstantForm.inclusion R n C').hom.hom.left))
  apply (cancel_mono (ConstantForm.inclusion R n C')).mp
  simp only [Category.assoc, inclusion_comp_constantForm_inclusion,
    groupSchemeCongr_hom_comp_hopfIdealInclusion, ConstantForm.groupSchemeCongr_hom_comp_inclusion,
    inclusion_comp_constantForm_inclusion_assoc]

end Congruence

section BaseChange

variable {R n C} {S : Type max u v} [CommRing S] [Algebra R S]
  {C' : Matrix (Fin n) (Fin n) S}

/-- The ambient base-change isomorphism carries the extended defining Hopf ideal to the ideal
of the scalar-extended form, retaining the determinant-one relation. -/
theorem map_baseChangeHopfIdeal_definingHopfIdeal (hC : C.map (algebraMap R S) = C') :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := S) (definingHopfIdeal R n C)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S n).hom.hom =
      definingHopfIdeal S n C' := by
  refine CommHopfAlgCat.map_baseChangeHopfIdeal_of_toIdeal_eq_span
    (definingHopfIdeal R n C) (definingHopfIdeal S n C')
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S n)
    (definingHopfIdeal_toIdeal R n C) (definingHopfIdeal_toIdeal S n C') ?_
  rw [Set.image_union, ConstantForm.image_relationSet_baseChange hC]
  simp only [Set.image_singleton, TensorProduct.tmul_sub, ← Algebra.TensorProduct.one_def,
    map_sub, map_one]
  have hdet := GeneralLinear.coordinateHopfAlgebraBaseChangeIso_hom_determinantGroupLike R S n
  exact congrArg (fun x : GeneralLinear.coordinateHopfAlgebra S n ↦
    ConstantForm.relationSet S n C' ∪ {x - 1}) hdet

/-- The determinant-one coordinate Hopf algebra commutes with extension of scalars. -/
noncomputable def coordinateHopfAlgebraBaseChangeIso (hC : C.map (algebraMap R S) = C') :
    CommHopfAlgCat.baseChange (K := S) (coordinateHopfAlgebra R n C) ≅
      coordinateHopfAlgebra S n C' :=
  CommHopfAlgCat.quotientBaseChangeIsoOfMapEq
    (definingHopfIdeal R n C) (definingHopfIdeal S n C')
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S n)
    (map_baseChangeHopfIdeal_definingHopfIdeal hC)

/-- The base-change isomorphism is induced by scalar extension of the ambient quotient. -/
theorem coordinateHopfAlgebraBaseChangeIso_def (hC : C.map (algebraMap R S) = C') :
    coordinateHopfAlgebraBaseChangeIso hC =
      CommHopfAlgCat.quotientBaseChangeIsoOfMapEq
        (definingHopfIdeal R n C) (definingHopfIdeal S n C')
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S n)
        (map_baseChangeHopfIdeal_definingHopfIdeal hC) :=
  (rfl)

/-- The base-change isomorphism intertwines the two quotient maps from the ambient general
linear coordinate algebras. -/
@[reassoc]
theorem baseChangeMap_coordinateMap_comp_coordinateHopfAlgebraBaseChangeIso_hom
    (hC : C.map (algebraMap R S) = C') :
    CommHopfAlgCat.baseChangeMap (K := S) (coordinateMap R n C) ≫
        (coordinateHopfAlgebraBaseChangeIso hC).hom =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S n).hom ≫ coordinateMap S n C' :=
  CommHopfAlgCat.baseChangeMap_mkQuotient_comp_quotientBaseChangeIsoOfMapEq_hom _ _ _ _

/-- The inverse coordinate base-change isomorphism also intertwines the ambient quotient maps. -/
@[reassoc]
theorem coordinateMap_comp_coordinateHopfAlgebraBaseChangeIso_inv
    (hC : C.map (algebraMap R S) = C') :
    coordinateMap S n C' ≫ (coordinateHopfAlgebraBaseChangeIso hC).inv =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S n).inv ≫
        CommHopfAlgCat.baseChangeMap (K := S) (coordinateMap R n C) :=
  CommHopfAlgCat.mkQuotient_comp_quotientBaseChangeIsoOfMapEq_inv _ _ _ _

/-- The base-change isomorphism on the finite-type coordinate Hopf algebras. -/
noncomputable def finiteTypeCoordinateHopfAlgebraBaseChangeIso
    (hC : C.map (algebraMap R S) = C') :
    FiniteTypeCommHopfAlgCat.baseChange (K := S) (finiteTypeCoordinateHopfAlgebra R n C) ≅
      finiteTypeCoordinateHopfAlgebra S n C' :=
  FiniteTypeCommHopfAlgCat.baseChangeIsoOfObjIso
    (finiteTypeCoordinateHopfAlgebra_obj R n C) (finiteTypeCoordinateHopfAlgebra_obj S n C')
    (coordinateHopfAlgebraBaseChangeIso hC)

/-- The finite-type base-change isomorphism induces the coordinate base-change morphism. -/
@[simp]
theorem finiteTypeCoordinateHopfAlgebraBaseChangeIso_hom (hC : C.map (algebraMap R S) = C') :
    (finiteTypeCoordinateHopfAlgebraBaseChangeIso hC).hom.hom =
      (eqToIso (congrArg (CommHopfAlgCat.baseChange (K := S))
          (finiteTypeCoordinateHopfAlgebra_obj R n C)) ≪≫
        coordinateHopfAlgebraBaseChangeIso hC ≪≫
        eqToIso (finiteTypeCoordinateHopfAlgebra_obj S n C').symm).hom :=
  FiniteTypeCommHopfAlgCat.baseChangeIsoOfObjIso_hom _ _ _

end BaseChange

section SchemeBaseChange

variable {R n C} {S : Type u} [CommRing S] [Algebra R S]
  {C' : Matrix (Fin n) (Fin n) S}

/-- The determinant-one group scheme of a constant form commutes with extension of scalars. -/
noncomputable def groupSchemeBaseChangeIso (hC : C.map (algebraMap R S) = C') :
    (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R S)))).mapGrp.obj
        (groupScheme R n C) ≅ groupScheme S n C' :=
  GeneralLinear.hopfIdealBaseChangeIso R S n (definingHopfIdeal R n C) (definingHopfIdeal S n C')
    (coordinateHopfAlgebraBaseChangeIso hC).symm

/-- The group-scheme base-change isomorphism is the ambient Hopf-ideal comparison. -/
theorem groupSchemeBaseChangeIso_def (hC : C.map (algebraMap R S) = C') :
    groupSchemeBaseChangeIso hC =
      GeneralLinear.hopfIdealBaseChangeIso R S n
        (definingHopfIdeal R n C) (definingHopfIdeal S n C')
        (coordinateHopfAlgebraBaseChangeIso hC).symm :=
  (rfl)

/-- The scalar-extension isomorphism respects the inclusions into the general linear
group schemes. -/
@[reassoc]
theorem map_hopfIdealInclusion_comp_groupSchemeBaseChangeIso_hom
    (hC : C.map (algebraMap R S) = C') :
    (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R S)))).mapGrp.map
        (GeneralLinear.hopfIdealInclusion R n (definingHopfIdeal R n C)) ≫
        (GeneralLinear.groupSchemeBaseChangeIso R S n).hom =
      (groupSchemeBaseChangeIso hC).hom ≫
        GeneralLinear.hopfIdealInclusion S n (definingHopfIdeal S n C') := by
  rw [groupSchemeBaseChangeIso_def]
  exact GeneralLinear.map_hopfIdealInclusion_comp_groupSchemeBaseChangeIso R S n _ _ _
    (coordinateMap_comp_coordinateHopfAlgebraBaseChangeIso_inv hC)

end SchemeBaseChange

end TauCeti.ConstantForm.Special
