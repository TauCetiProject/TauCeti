module

public import TauCeti.Algebra.AlgebraicGroup.ConstantForm.Basic
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.FunctorOfPoints

/-!
# The polynomial presentation of a constant-form coordinate algebra

For a constant matrix `C` over `R` with unit determinant, the coordinate algebra of the subgroup
scheme of `GLₙ` preserving `C` is the polynomial algebra on the matrix entries modulo the
entries of `X C Xᵀ - C`. No determinant localization is needed: in the polynomial quotient,
`X C Xᵀ = C` makes `C Xᵀ C⁻¹` a right inverse of `X`, so `X` is already invertible there.

The equivalence sends a generic matrix entry to the corresponding variable class. Its inverse
evaluates polynomials at the generic matrix of the subgroup scheme. The two inverse identities
are checked on generators: the generic matrix entries generate the coordinate algebra, because
the entries of the inverse generic matrix are those of `C Xᵀ C⁻¹`.

The construction works over every commutative ring and in every rank, including zero.

## Main declarations

* `TauCeti.ConstantForm.polynomialRelationIdeal`: the ideal of `R[Xᵢⱼ]` generated by the entries
  of `X C Xᵀ - C`.
* `TauCeti.ConstantForm.adjoin_range_map_genericMatrix`: the generic matrix entries generate the
  coordinate algebra.
* `TauCeti.ConstantForm.polynomialPresentation`: the polynomial presentation of the coordinate
  algebra, with `polynomialPresentation_genericMatrix` and `polynomialPresentation_symm_mk`.

The construction follows `TauCeti.SpecialLinear.polynomialPresentation`.
-/

public section

open Matrix

namespace TauCeti.ConstantForm

universe u

variable (R : Type u) [CommRing R] (n : ℕ) (C : Matrix (Fin n) (Fin n) R)

/-- The relation matrix `X C Xᵀ - C` over the polynomial ring on the matrix entries. -/
noncomputable def polynomialRelationMatrix :
    Matrix (Fin n) (Fin n) (MvPolynomial (Fin n × Fin n) R) :=
  mvPolynomialX (Fin n) (Fin n) R * C.map (algebraMap R _) * (mvPolynomialX (Fin n) (Fin n) R)ᵀ -
    C.map (algebraMap R _)

/-- The ideal of `R[Xᵢⱼ]` generated by the entries of `X C Xᵀ - C`. -/
noncomputable def polynomialRelationIdeal : Ideal (MvPolynomial (Fin n × Fin n) R) :=
  Ideal.span (Set.range fun ij : Fin n × Fin n ↦ polynomialRelationMatrix R n C ij.1 ij.2)

/-- An algebra morphism out of `R[Xᵢⱼ]` kills the relation ideal exactly when the images `x` of
the variables satisfy `x C xᵀ = C`. -/
theorem polynomialRelationIdeal_le_ker_iff {T : Type*} [Ring T] [Algebra R T]
    (phi : MvPolynomial (Fin n × Fin n) R →ₐ[R] T) :
    polynomialRelationIdeal R n C ≤ RingHom.ker (phi : _ →+* T) ↔
      (mvPolynomialX (Fin n) (Fin n) R).map phi * C.map (algebraMap R T) *
          ((mvPolynomialX (Fin n) (Fin n) R).map phi)ᵀ = C.map (algebraMap R T) := by
  have hC : (C.map (algebraMap R (MvPolynomial (Fin n × Fin n) R))).map phi =
      C.map (algebraMap R T) := by
    rw [Matrix.map_map]
    exact congrArg _ (funext fun r ↦ phi.commutes r)
  have hmap : (polynomialRelationMatrix R n C).map phi =
      (mvPolynomialX (Fin n) (Fin n) R).map phi * C.map (algebraMap R T) *
          ((mvPolynomialX (Fin n) (Fin n) R).map phi)ᵀ - C.map (algebraMap R T) := by
    rw [polynomialRelationMatrix, Matrix.map_sub, Matrix.map_mul, Matrix.map_mul, hC,
      Matrix.transpose_map]
    exact fun a b ↦ map_sub phi a b
  rw [polynomialRelationIdeal, Ideal.span_le, ← sub_eq_zero, ← hmap,
    ← Matrix.forall_mem_ker_iff_map_eq_zero]
  refine ⟨fun h i j ↦ h ⟨(i, j), rfl⟩, ?_⟩
  rintro h _ ⟨ij, rfl⟩
  exact h ij.1 ij.2

/-- The generic matrix of the subgroup scheme, the image of the generic matrix of `GLₙ`,
preserves `C`. -/
theorem map_genericMatrix_coordinateMap_mul_mul_transpose :
    (GeneralLinear.genericMatrix R n).map (coordinateMap R n C).hom *
        C.map (algebraMap R (coordinateHopfAlgebra R n C)) *
        ((GeneralLinear.genericMatrix R n).map (coordinateMap R n C).hom)ᵀ =
      C.map (algebraMap R (coordinateHopfAlgebra R n C)) := by
  have h := relationMatrix_map R n C (coordinateMap R n C).hom.toAlgHom
  rw [BialgHom.coe_toAlgHom] at h
  rw [← sub_eq_zero, ← h]
  ext i j
  exact coordinateMap_relationMatrix R n C i j

variable {R n C}

/-- If `x C xᵀ = C` for a matrix `C` with unit determinant, then `C xᵀ C⁻¹` is a right inverse
of `x`. -/
private theorem mul_mul_transpose_mul_inv_eq_one {T : Type*} [Ring T] [Algebra R T]
    (hC : IsUnit C.det) {x : Matrix (Fin n) (Fin n) T}
    (hx : x * C.map (algebraMap R T) * xᵀ = C.map (algebraMap R T)) :
    x * (C.map (algebraMap R T) * xᵀ * C⁻¹.map (algebraMap R T)) = 1 := by
  rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, hx, ← Matrix.map_mul,
    Matrix.mul_nonsing_inv C hC, Matrix.map_one _ (map_zero _) (map_one _)]

variable (R n C)

/-- The entries of the generic matrix of the subgroup scheme preserving a matrix with unit
determinant generate its coordinate algebra. -/
theorem adjoin_range_map_genericMatrix (hC : IsUnit C.det) :
    Algebra.adjoin R (Set.range fun ij : Fin n × Fin n ↦
      (GeneralLinear.genericMatrix R n).map (coordinateMap R n C).hom ij.1 ij.2) = ⊤ := by
  let X := (GeneralLinear.genericMatrix R n).map (coordinateMap R n C).hom
  let T := Algebra.adjoin R (Set.range fun ij : Fin n × Fin n ↦ X ij.1 ij.2)
  let q := (coordinateMap R n C).hom.toAlgHom
  have hq : Function.Surjective q := by
    simp only [q, BialgHom.coe_toAlgHom]
    rw [coordinateMap_def]
    exact CommHopfAlgCat.mkQuotient_surjective _ (definingHopfIdeal R n C)
  -- The entries of `X` and of `X⁻¹` are the images of the generators of `O(GLₙ)`.
  have himage := congrArg (Subalgebra.map q)
    (GeneralLinear.adjoin_coordinateHopfAlgebra_X_union_antipode_X R n)
  rw [Algebra.map_top, (AlgHom.range_eq_top q).mpr hq, ← Algebra.adjoin_image, Set.image_union,
    ← Set.range_comp, ← Set.range_comp] at himage
  rw [eq_top_iff, ← himage, Algebra.adjoin_le_iff]
  -- Since `X C Xᵀ = C`, the inverse `X⁻¹` is `C Xᵀ C⁻¹`, whose entries lie in `T`.
  let M : Matrix (Fin n) (Fin n) T := .of fun i j ↦ ⟨X i j, Algebra.subset_adjoin ⟨(i, j), rfl⟩⟩
  have hM : T.val.mapMatrix M = X := rfl
  have hval (D : Matrix (Fin n) (Fin n) R) :
      T.val.mapMatrix (D.map (algebraMap R T)) = D.map (algebraMap R _) := by
    rw [AlgHom.mapMatrix_apply, Matrix.map_map]
    exact congrArg _ (funext fun r ↦ T.val.commutes r)
  have hinv : X⁻¹ = T.val.mapMatrix
      (C.map (algebraMap R T) * Mᵀ * C⁻¹.map (algebraMap R T)) := by
    rw [map_mul, map_mul, hval, hval, AlgHom.mapMatrix_apply, Matrix.transpose_map,
      ← AlgHom.mapMatrix_apply, hM]
    exact Matrix.inv_eq_right_inv (mul_mul_transpose_mul_inv_eq_one hC
      (map_genericMatrix_coordinateMap_mul_mul_transpose R n C))
  rintro _ (⟨⟨i, j⟩, rfl⟩ | ⟨⟨i, j⟩, rfl⟩)
  · exact Algebra.subset_adjoin ⟨(i, j), by
      beta_reduce
      rw [Function.comp_apply, Matrix.map_apply, GeneralLinear.genericMatrix_apply,
        BialgHom.coe_toAlgHom]⟩
  · rw [Function.comp_apply, ← HopfAlgebra.antipodeAlgHom_apply,
      ← GeneralLinear.genericMatrix_apply, ← Matrix.map_apply (f := HopfAlgebra.antipodeAlgHom R _),
      GeneralLinear.map_antipode_genericMatrix, ← Matrix.map_apply (f := q),
      GeneralLinear.map_inv_genericMatrix, BialgHom.coe_toAlgHom]
    change X⁻¹ i j ∈ T
    rw [hinv]
    exact (_ : Matrix (Fin n) (Fin n) T) i j |>.property

/-! ### The presentation -/

variable {R n C}

/-- The generic matrix of the polynomial quotient, invertible because `C` has unit
determinant. -/
private noncomputable def polynomialQuotientMatrix (hC : IsUnit C.det) :
    GL (Fin n) (MvPolynomial (Fin n × Fin n) R ⧸ polynomialRelationIdeal R n C) :=
  have h := mul_mul_transpose_mul_inv_eq_one hC
    ((polynomialRelationIdeal_le_ker_iff R n C (Ideal.Quotient.mkₐ R _)).1 (by
      rw [Ideal.Quotient.mkₐ_ker]))
  GeneralLinearGroup.mk'' _ (Matrix.isUnit_det_of_right_inverse h)

private theorem coe_polynomialQuotientMatrix (hC : IsUnit C.det) :
    ((polynomialQuotientMatrix hC : GL (Fin n) _) :
        Matrix (Fin n) (Fin n) (MvPolynomial (Fin n × Fin n) R ⧸ polynomialRelationIdeal R n C)) =
      (mvPolynomialX (Fin n) (Fin n) R).map (Ideal.Quotient.mkₐ R _) :=
  (rfl)

/-- The point of `GLₙ` given by the generic matrix of the polynomial quotient. -/
private noncomputable def generalLinearToPolynomialQuotient (hC : IsUnit C.det) :
    GeneralLinear.coordinateHopfAlgebra R n →ₐ[R]
      MvPolynomial (Fin n × Fin n) R ⧸ polynomialRelationIdeal R n C :=
  ((GeneralLinear.pointsMulEquiv n).symm (polynomialQuotientMatrix hC)).ofConv

private theorem map_genericMatrix_generalLinearToPolynomialQuotient (hC : IsUnit C.det) :
    (GeneralLinear.genericMatrix R n).map (generalLinearToPolynomialQuotient hC) =
      (mvPolynomialX (Fin n) (Fin n) R).map (Ideal.Quotient.mkₐ R _) := by
  rw [generalLinearToPolynomialQuotient,
    GeneralLinear.map_genericMatrix_eq_coe_pointToGeneralLinear, WithConv.toConv_ofConv,
    ← GeneralLinear.pointsMulEquiv_apply, MulEquiv.apply_symm_apply,
    coe_polynomialQuotientMatrix]

private noncomputable def toPolynomialQuotient (hC : IsUnit C.det) :
    coordinateHopfAlgebra R n C →ₐ[R]
      MvPolynomial (Fin n × Fin n) R ⧸ polynomialRelationIdeal R n C :=
  Ideal.Quotient.liftₐ _ (generalLinearToPolynomialQuotient hC) fun a ha ↦ RingHom.mem_ker.1 <| by
    refine (definingHopfIdeal_toIdeal_le_ker_iff R n C _).2 ?_ ha
    rw [map_genericMatrix_generalLinearToPolynomialQuotient]
    exact (polynomialRelationIdeal_le_ker_iff R n C (Ideal.Quotient.mkₐ R _)).1 (by
      rw [Ideal.Quotient.mkₐ_ker])

private theorem toPolynomialQuotient_genericMatrix (hC : IsUnit C.det) (i j : Fin n) :
    toPolynomialQuotient hC ((GeneralLinear.genericMatrix R n).map (coordinateMap R n C).hom i j) =
      Ideal.Quotient.mk _ (MvPolynomial.X (i, j)) := by
  rw [Matrix.map_apply, coordinateMap_apply]
  change generalLinearToPolynomialQuotient hC _ = _
  rw [← Matrix.map_apply (f := generalLinearToPolynomialQuotient hC),
    map_genericMatrix_generalLinearToPolynomialQuotient, Matrix.map_apply,
    Ideal.Quotient.mkₐ_eq_mk, mvPolynomialX_apply]

private noncomputable def fromPolynomialQuotient :
    (MvPolynomial (Fin n × Fin n) R ⧸ polynomialRelationIdeal R n C) →ₐ[R]
      coordinateHopfAlgebra R n C :=
  let f := MvPolynomial.aeval fun ij : Fin n × Fin n ↦
    (GeneralLinear.genericMatrix R n).map (coordinateMap R n C).hom ij.1 ij.2
  Ideal.Quotient.liftₐ _ f fun a ha ↦ RingHom.mem_ker.1 <| by
    refine (polynomialRelationIdeal_le_ker_iff R n C f).2 ?_ ha
    rw [← AlgHom.mapMatrix_apply, Matrix.mvPolynomialX_mapMatrix_aeval]
    exact map_genericMatrix_coordinateMap_mul_mul_transpose R n C

private theorem fromPolynomialQuotient_mk (p : MvPolynomial (Fin n × Fin n) R) :
    fromPolynomialQuotient (C := C) (Ideal.Quotient.mk _ p) =
      MvPolynomial.aeval (fun ij : Fin n × Fin n ↦
        (GeneralLinear.genericMatrix R n).map (coordinateMap R n C).hom ij.1 ij.2) p :=
  (rfl)

variable (R n C)

/-- The coordinate algebra of the subgroup scheme of `GLₙ` preserving a matrix `C` with unit
determinant is the polynomial algebra on the matrix entries modulo the entries of
`X C Xᵀ - C`. -/
noncomputable def polynomialPresentation (hC : IsUnit C.det) :
    coordinateHopfAlgebra R n C ≃ₐ[R]
      MvPolynomial (Fin n × Fin n) R ⧸ polynomialRelationIdeal R n C :=
  AlgEquiv.ofAlgHom (toPolynomialQuotient hC) fromPolynomialQuotient
    (by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro ij
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
      rw [fromPolynomialQuotient_mk, MvPolynomial.aeval_X, toPolynomialQuotient_genericMatrix])
    (by
      apply AlgHom.ext_of_adjoin_eq_top (adjoin_range_map_genericMatrix R n C hC)
      rintro x ⟨⟨i, j⟩, rfl⟩
      rw [AlgHom.comp_apply, toPolynomialQuotient_genericMatrix, fromPolynomialQuotient_mk,
        MvPolynomial.aeval_X, AlgHom.id_apply])

/-- The polynomial presentation sends a generic matrix entry to the corresponding variable
class. -/
-- Run before the generic entry expands into its localized coordinate formula.
@[simp↓]
theorem polynomialPresentation_genericMatrix (hC : IsUnit C.det) (i j : Fin n) :
    polynomialPresentation R n C hC
        ((GeneralLinear.genericMatrix R n).map (coordinateMap R n C).hom i j) =
      Ideal.Quotient.mk _ (MvPolynomial.X (i, j)) :=
  toPolynomialQuotient_genericMatrix hC i j

/-- The inverse polynomial presentation evaluates a representative at the generic matrix of the
subgroup scheme. -/
@[simp]
theorem polynomialPresentation_symm_mk (hC : IsUnit C.det) (p : MvPolynomial (Fin n × Fin n) R) :
    (polynomialPresentation R n C hC).symm (Ideal.Quotient.mk _ p) =
      MvPolynomial.aeval (fun ij : Fin n × Fin n ↦
        (GeneralLinear.genericMatrix R n).map (coordinateMap R n C).hom ij.1 ij.2) p :=
  fromPolynomialQuotient_mk p

end TauCeti.ConstantForm
