/-!
# The similitude subgroup scheme of a constant form

For a commutative ring `R`, a natural number `n`, and a **constant** matrix
`C : Matrix (Fin n) (Fin n) R`, the *similitude group scheme* `GSim(C)` is the closed subgroup
scheme of `GLₙ × 𝔾_m` of pairs `(h, r)` with

```text
h C hᵀ = r C.
```

Its coordinate Hopf algebra is the quotient of `O(GLₙ) ⊗[R] R[T;T⁻¹]`, the coordinate Hopf
algebra of the product `GLₙ × 𝔾_m`, by the Hopf ideal generated by the entries of the relation
matrix `X C Xᵀ - r C`, where `X` is the generic matrix in the left tensor factor and `r = T` is the
coordinate of the right one. The second component `r` is the *multiplier*; the pairs with
multiplier `1` are the matrices preserving `C`, as in `TauCeti.ConstantForm`. On every
commutative `R`-algebra `A`, the points are the pairs `(h, r) ∈ GLₙ(A) × Aˣ` with
`h C hᵀ = r C` (`TauCeti.ConstantFormSimilitude.pointsMulEquiv`).

The row convention `h C hᵀ` is that of `TauCeti.ConstantForm`. Nothing is assumed of `C`; the
construction includes `n = 0` and the zero ring. The symplectic similitude group `GSp₂ₘ` is the
specialization at the standard alternating form (`TauCeti.SymplecticSimilitude`).

As for `TauCeti.ConstantForm`, the three Hopf-ideal closure conditions are matrix identities.
Write `f(X, r) = X C Xᵀ - r C`.

* The counit sends `(X, r)` to `(1, 1)`, and `f(1, 1) = 0`.
* The comultiplication sends `(X, r)` to `(Y Z, r₁ r₂)`, where `Y`, `r₁` and `Z`, `r₂` are the
  left and right tensor copies, and

  ```text
  f(Y Z, r₁ r₂) = Y f(Z, r₂) Yᵀ + r₂ f(Y, r₁),
  ```

  whose summands have entries in the right and left tensor ideals.
* The antipode sends `(X, r)` to `(W, s)` with `W X = 1` and `s r = 1`, and

  ```text
  f(W, s) = -(s W f(X, r) Wᵀ).
  ```

None of these identities uses a property of `C`.

## Main declarations

* `TauCeti.ConstantFormSimilitude.ambientHopfAlgebra`: the coordinate Hopf algebra
  `O(GLₙ) ⊗[R] R[T;T⁻¹]` of `GLₙ × 𝔾_m`, with the coordinate morphisms `inl` and `inr` of its two
  projections, the generic matrix `matrixCoord` and the multiplier coordinate
  `multiplierCoord`.
* `TauCeti.ConstantFormSimilitude.relationMatrix`: the matrix of defining relations
  `X C Xᵀ - r C`.
* `TauCeti.ConstantFormSimilitude.definingHopfIdeal`: the Hopf ideal its entries generate, and
  `definingHopfIdeal_toIdeal_le_ker_iff`, the criterion for a coordinate morphism to kill it.
* `TauCeti.ConstantFormSimilitude.coordinateMap`: the quotient coordinate morphism, with
  `coordinateMap_relationMatrix`: the relations `X C Xᵀ = r C` hold in the quotient.
* `TauCeti.ConstantFormSimilitude.groupScheme` and `TauCeti.ConstantFormSimilitude.inclusion`:
  the similitude group scheme and its closed immersion into `GLₙ × 𝔾_m`.
* `TauCeti.ConstantFormSimilitude.multiplier` and
  `TauCeti.ConstantFormSimilitude.multiplierCoordinateMap`: the multiplier character
  `GSim(C) → 𝔾_m` and its coordinate morphism, the right tensor inclusion followed by the
  quotient map (`multiplier_def`, `multiplierCoordinateMap_def`).
* `TauCeti.ConstantFormSimilitude.multiplierPoints`: the multiplier on points, `(h, r) ↦ r`,
  which is the multiplier character under the points identification
  (`multiplierPoints_pointsMulEquiv`).
* `TauCeti.ConstantFormSimilitude.pointsSubgroup` and
  `TauCeti.ConstantFormSimilitude.pointsMulEquiv`: the points are the pairs `(h, r)` with
  `h C hᵀ = r C`, with `pointsMulEquiv_fst` and `pointsMulEquiv_snd` computing the two
  components, and `pointsMulEquiv_mapValue`: naturality in the value algebra, through the
  componentwise map `pointsSubgroupMap`.
* `TauCeti.ConstantFormSimilitude.ambientPointsMulEquiv`: the points of `GLₙ × 𝔾_m` are
  `GLₙ(A) × Aˣ`, naturally in `A` (`ambientPointsMulEquiv_mapValue`).

## References

* J. S. Milne, *Algebraic Groups* (2017), 2.10, for the group-valued functors cut out of `GLₙ`
  by a constant form.
* W. C. Waterhouse, *Introduction to Affine Group Schemes* (1979), Chapter 1, for affine group
  schemes as representable functors on commutative rings.

The framing identities above are standard matrix algebra and generalize those of
`TauCeti.ConstantForm` (the case `r = 1`).
-/

public section

open CategoryTheory Matrix WithConv TensorProduct
open scoped LaurentPolynomial

namespace TauCeti.ConstantFormSimilitude

universe u w

variable (R : Type u) [CommRing R] (n : ℕ)

/-! ### The ambient product -/

/-- The coordinate Hopf algebra `O(GLₙ) ⊗[R] R[T;T⁻¹]` of the product group scheme
`GLₙ × 𝔾_m`. -/
noncomputable def ambientHopfAlgebra : _root_.CommHopfAlgCat.{u} R :=
  _root_.CommHopfAlgCat.of R (GeneralLinear.coordinateHopfAlgebra R n ⊗[R] R[T;T⁻¹])

/-- The coordinate morphism `x ↦ x ⊗ 1` of the projection `GLₙ × 𝔾_m → GLₙ`. -/
noncomputable def inl : GeneralLinear.coordinateHopfAlgebra R n ⟶ ambientHopfAlgebra R n :=
  _root_.CommHopfAlgCat.ofHom
    (Bialgebra.TensorProduct.includeLeft (R := R) (H₂ := R[T;T⁻¹]))

/-- The coordinate morphism `y ↦ 1 ⊗ y` of the projection `GLₙ × 𝔾_m → 𝔾_m`. -/
noncomputable def inr : _root_.CommHopfAlgCat.of R R[T;T⁻¹] ⟶ ambientHopfAlgebra R n :=
  _root_.CommHopfAlgCat.ofHom
    (Bialgebra.TensorProduct.includeRight (R := R)
      (H₁ := GeneralLinear.coordinateHopfAlgebra R n) (H₂ := R[T;T⁻¹]))

/-- The generic matrix of the `GLₙ` factor, read in the ambient product coordinate algebra. -/
noncomputable def matrixCoord : Matrix (Fin n) (Fin n) (ambientHopfAlgebra R n) :=
  (GeneralLinear.genericMatrix R n).map (inl R n).hom

/-- The coordinate `T` of the `𝔾_m` factor, read in the ambient product coordinate algebra: the
multiplier coordinate. -/
noncomputable def multiplierCoord : ambientHopfAlgebra R n :=
  (inr R n).hom (LaurentPolynomial.T 1)

/-! ### The defining relation matrix -/

variable (C : Matrix (Fin n) (Fin n) R)

/-- **The matrix of defining relations** of the similitude group scheme: `X C Xᵀ - r C` over the
coordinate Hopf algebra of `GLₙ × 𝔾_m`. -/
noncomputable def relationMatrix : Matrix (Fin n) (Fin n) (ambientHopfAlgebra R n) :=
  matrixCoord R n * C.map (algebraMap R (ambientHopfAlgebra R n)) * (matrixCoord R n)ᵀ -
    multiplierCoord R n • C.map (algebraMap R (ambientHopfAlgebra R n))

/-- The relation matrix is `X C Xᵀ - r C`. -/
theorem relationMatrix_def :
    relationMatrix R n C =
      matrixCoord R n * C.map (algebraMap R (ambientHopfAlgebra R n)) * (matrixCoord R n)ᵀ -
        multiplierCoord R n • C.map (algebraMap R (ambientHopfAlgebra R n)) := by
  rw [relationMatrix]

/-- The set of defining relations: the entries of the relation matrix. -/
noncomputable def relationSet : Set (ambientHopfAlgebra R n) :=
  Set.range fun ij : Fin n × Fin n => relationMatrix R n C ij.1 ij.2

/-- Every entry of the relation matrix is a defining relation. -/
theorem relationMatrix_mem_relationSet (i j : Fin n) :
    relationMatrix R n C i j ∈ relationSet R n C :=
  ⟨(i, j), rfl⟩

/-- Mapping the relation matrix through an algebra morphism gives the relation of the images of
the generic matrix and the multiplier coordinate. -/
theorem relationMatrix_map {T : Type*} [Ring T] [Algebra R T]
    (phi : ambientHopfAlgebra R n →ₐ[R] T) :
    (relationMatrix R n C).map phi =
      (matrixCoord R n).map phi * C.map (algebraMap R T) * ((matrixCoord R n).map phi)ᵀ -
        phi (multiplierCoord R n) • C.map (algebraMap R T) := by
  have hC : (C.map (algebraMap R (ambientHopfAlgebra R n))).map phi =
      C.map (algebraMap R T) := by
    rw [Matrix.map_map]
    exact congrArg _ (funext fun r => phi.commutes r)
  rw [relationMatrix, Matrix.map_sub _ (map_sub phi), Matrix.map_mul, Matrix.map_mul,
    Matrix.map_smul' _ _ _ (map_mul phi), hC, Matrix.transpose_map]

/-! ### The three Hopf-ideal closure conditions -/

/-- The counit sends the generic matrix of the product to the identity matrix. -/
private theorem map_counit_matrixCoord :
    (matrixCoord R n).map (Bialgebra.counitAlgHom R (ambientHopfAlgebra R n)) = 1 := by
  rw [matrixCoord, Matrix.map_map, ← GeneralLinear.map_counit_genericMatrix R n]
  congr 1
  funext x
  exact CoalgHomClass.counit_comp_apply (inl R n).hom x

/-- The counit sends the multiplier coordinate to `1`. -/
private theorem counit_multiplierCoord :
    Bialgebra.counitAlgHom R (ambientHopfAlgebra R n) (multiplierCoord R n) = 1 := by
  rw [multiplierCoord, Bialgebra.counitAlgHom_apply, CoalgHomClass.counit_comp_apply,
    LaurentPolynomial.counit_T]

/-- The counit vanishes on every defining relation. -/
private theorem counit_relationMatrix (i j : Fin n) :
    Coalgebra.counit (R := R) (relationMatrix R n C i j) = 0 := by
  have h := congrFun (congrFun (relationMatrix_map R n C
    (Bialgebra.counitAlgHom R (ambientHopfAlgebra R n))) i) j
  rw [Matrix.map_apply, Bialgebra.counitAlgHom_apply] at h
  rw [h, map_counit_matrixCoord, counit_multiplierCoord]
  simp

/-- The left tensor inclusion of the ambient coordinate algebra into its tensor square. -/
private noncomputable abbrev leftCopy :
    ambientHopfAlgebra R n →ₐ[R] ambientHopfAlgebra R n ⊗[R] ambientHopfAlgebra R n :=
  Algebra.TensorProduct.includeLeft

/-- The right tensor inclusion of the ambient coordinate algebra into its tensor square. -/
private noncomputable abbrev rightCopy :
    ambientHopfAlgebra R n →ₐ[R] ambientHopfAlgebra R n ⊗[R] ambientHopfAlgebra R n :=
  Algebra.TensorProduct.includeRight

/-- The comultiplication sends the generic matrix of the product to the product of its two
tensor copies. -/
private theorem map_comul_matrixCoord :
    (matrixCoord R n).map (Bialgebra.comulAlgHom R (ambientHopfAlgebra R n)) =
      (matrixCoord R n).map (leftCopy R n) * (matrixCoord R n).map (rightCopy R n) := by
  have h := GeneralLinear.map_comul_genericMatrix R n
  ext i j
  have hij := congrArg (TensorProduct.map ((inl R n).hom :
      GeneralLinear.coordinateHopfAlgebra R n →ₗ[R] ambientHopfAlgebra R n)
    ((inl R n).hom : GeneralLinear.coordinateHopfAlgebra R n →ₗ[R] ambientHopfAlgebra R n))
    (congrFun (congrFun h i) j)
  rw [Matrix.map_apply, Bialgebra.comulAlgHom_apply, Matrix.mul_apply, map_sum] at hij
  rw [Matrix.map_apply, matrixCoord, Matrix.map_apply, Bialgebra.comulAlgHom_apply,
    ← CoalgHomClass.map_comp_comul_apply, hij, Matrix.mul_apply]
  refine Finset.sum_congr rfl fun k _ => ?_
  simp [Algebra.TensorProduct.tmul_mul_tmul]

/-- The comultiplication sends the multiplier coordinate to the product of its two tensor
copies: the multiplier coordinate is group-like. -/
private theorem comul_multiplierCoord :
    Bialgebra.comulAlgHom R (ambientHopfAlgebra R n) (multiplierCoord R n) =
      leftCopy R n (multiplierCoord R n) * rightCopy R n (multiplierCoord R n) := by
  rw [Bialgebra.comulAlgHom_apply, multiplierCoord, ← CoalgHomClass.map_comp_comul_apply,
    LaurentPolynomial.comul_T, TensorProduct.map_tmul]
  simp [Algebra.TensorProduct.tmul_mul_tmul]

/-- The comultiplication of the relation matrix decomposes as a left-tensor-framed copy of the
right tensor relations plus the right multiplier times the left tensor relations. -/
private theorem relationMatrix_map_comul :
    (relationMatrix R n C).map (Bialgebra.comulAlgHom R (ambientHopfAlgebra R n)) =
      (matrixCoord R n).map (leftCopy R n) * (relationMatrix R n C).map (rightCopy R n) *
          ((matrixCoord R n).map (leftCopy R n))ᵀ +
        rightCopy R n (multiplierCoord R n) • (relationMatrix R n C).map (leftCopy R n) := by
  rw [relationMatrix_map R n C, relationMatrix_map R n C, relationMatrix_map R n C,
    map_comul_matrixCoord, comul_multiplierCoord]
  exact Matrix.mul_mul_mul_transpose_sub_mul_smul _ _ _ _ _

/-- The comultiplication of every defining relation lies in the sum of the left and right tensor
ideals of the span of the relations. -/
private theorem comul_relationMatrix_mem (i j : Fin n) :
    Coalgebra.comul (R := R) (relationMatrix R n C i j) ∈
      Ideal.leftTensorIdeal (R := R) (B := ambientHopfAlgebra R n)
          (Ideal.span (relationSet R n C)) ⊔
        Ideal.rightTensorIdeal (R := R) (A := ambientHopfAlgebra R n)
          (Ideal.span (relationSet R n C)) := by
  have h := congrFun (congrFun (relationMatrix_map_comul R n C) i) j
  rw [Matrix.map_apply, Bialgebra.comulAlgHom_apply] at h
  rw [h, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  refine Ideal.add_mem _ (Ideal.mem_sup_right ?_) (Ideal.mem_sup_left (Ideal.mul_mem_left _ _ ?_))
  · refine Matrix.mul_mul_apply_mem (fun k l => ?_) _ _ i j
    rw [Matrix.map_apply]
    exact Ideal.includeRight_mem_rightTensorIdeal (R := R) (A := ambientHopfAlgebra R n)
      (Ideal.subset_span (relationMatrix_mem_relationSet R n C k l))
  · rw [Matrix.map_apply]
    exact Ideal.includeLeft_mem_leftTensorIdeal (R := R) (B := ambientHopfAlgebra R n)
      (Ideal.subset_span (relationMatrix_mem_relationSet R n C i j))

/-- The antipode of the generic matrix of the product is a left inverse of it. -/
private theorem map_antipode_matrixCoord_mul :
    (matrixCoord R n).map
        (HopfAlgebra.antipodeAlgHom (R := R) (A := ambientHopfAlgebra R n)) *
      matrixCoord R n = 1 := by
  have hS : (matrixCoord R n).map
      (HopfAlgebra.antipodeAlgHom (R := R) (A := ambientHopfAlgebra R n)) =
      ((GeneralLinear.genericMatrix R n)⁻¹).map (inl R n).hom := by
    rw [← GeneralLinear.map_antipode_genericMatrix, matrixCoord, Matrix.map_map, Matrix.map_map]
    congr 1
    funext x
    exact (BialgHomClass.map_antipode (inl R n).hom x).symm
  rw [hS, matrixCoord, ← Matrix.map_mul,
    Matrix.nonsing_inv_mul _ (GeneralLinear.isUnit_det_genericMatrix R n),
    Matrix.map_one _ (map_zero _) (map_one _)]

/-- The antipode of the multiplier coordinate is its inverse. -/
private theorem antipode_multiplierCoord_mul :
    HopfAlgebra.antipodeAlgHom (R := R) (A := ambientHopfAlgebra R n) (multiplierCoord R n) *
      multiplierCoord R n = 1 := by
  rw [HopfAlgebra.antipodeAlgHom_apply, multiplierCoord, ← BialgHomClass.map_antipode,
    LaurentPolynomial.antipode_T, ← map_mul, ← LaurentPolynomial.T_add, neg_add_cancel,
    LaurentPolynomial.T_zero, map_one]

/-- The antipode image of the relation matrix is the negative of the relation matrix framed by
the antipode of the generic matrix and scaled by the inverse multiplier. -/
private theorem relationMatrix_map_antipode :
    (relationMatrix R n C).map
        (HopfAlgebra.antipodeAlgHom (R := R) (A := ambientHopfAlgebra R n)) =
      -(HopfAlgebra.antipodeAlgHom (R := R) (A := ambientHopfAlgebra R n)
            (multiplierCoord R n) •
          ((matrixCoord R n).map
              (HopfAlgebra.antipodeAlgHom (R := R) (A := ambientHopfAlgebra R n)) *
            relationMatrix R n C *
            ((matrixCoord R n).map
              (HopfAlgebra.antipodeAlgHom (R := R) (A := ambientHopfAlgebra R n)))ᵀ)) := by
  rw [relationMatrix_map R n C, relationMatrix]
  exact Matrix.mul_mul_transpose_sub_smul_of_mul_eq_one (map_antipode_matrixCoord_mul R n)
    (antipode_multiplierCoord_mul R n) _

/-- The antipode carries every defining relation into the span of the relations. -/
private theorem antipode_relationMatrix_mem (i j : Fin n) :
    HopfAlgebra.antipode R (relationMatrix R n C i j) ∈ Ideal.span (relationSet R n C) := by
  have h := congrFun (congrFun (relationMatrix_map_antipode R n C) i) j
  rw [Matrix.map_apply, HopfAlgebra.antipodeAlgHom_apply] at h
  rw [h, Matrix.neg_apply, Matrix.smul_apply, smul_eq_mul]
  exact neg_mem (Ideal.mul_mem_left _ _ (Matrix.mul_mul_apply_mem
    (fun k l => Ideal.subset_span (relationMatrix_mem_relationSet R n C k l)) _ _ i j))

/-! ### The defining Hopf ideal and quotient -/

/-- **The similitude Hopf ideal of `C`**: the ideal of the coordinate Hopf algebra of
`GLₙ × 𝔾_m` generated by the entries of `X C Xᵀ - r C`. -/
noncomputable def definingHopfIdeal : HopfIdeal R (ambientHopfAlgebra R n) :=
  HopfIdeal.ofSpan (relationSet R n C)
    (fun x hx => by
      obtain ⟨ij, rfl⟩ := hx
      exact comul_relationMatrix_mem R n C ij.1 ij.2)
    (fun x hx => by
      obtain ⟨ij, rfl⟩ := hx
      exact counit_relationMatrix R n C ij.1 ij.2)
    (fun x hx => by
      obtain ⟨ij, rfl⟩ := hx
      exact antipode_relationMatrix_mem R n C ij.1 ij.2)

/-- The underlying ideal of the defining Hopf ideal is the span of the defining relations. -/
@[simp]
theorem definingHopfIdeal_toIdeal :
    (definingHopfIdeal R n C).toIdeal = Ideal.span (relationSet R n C) := by
  rw [definingHopfIdeal, HopfIdeal.ofSpan_toIdeal]

/-- **A coordinate morphism kills the defining ideal exactly when the images `X'` of the generic
matrix and `r'` of the multiplier coordinate satisfy `X' C X'ᵀ = r' C`.** -/
theorem definingHopfIdeal_toIdeal_le_ker_iff {T : Type*} [Ring T] [Algebra R T]
    (phi : ambientHopfAlgebra R n →ₐ[R] T) :
    (definingHopfIdeal R n C).toIdeal ≤ RingHom.ker (phi : _ →+* T) ↔
      (matrixCoord R n).map phi * C.map (algebraMap R T) * ((matrixCoord R n).map phi)ᵀ =
        phi (multiplierCoord R n) • C.map (algebraMap R T) := by
  rw [definingHopfIdeal_toIdeal, Ideal.span_le, relationSet, Set.range_subset_iff, Prod.forall,
    ← sub_eq_zero, ← relationMatrix_map]
  simp only [SetLike.mem_coe]
  exact Matrix.forall_mem_ker_iff_map_eq_zero

/-- The coordinate Hopf algebra of the similitude group scheme of `C`. -/
noncomputable abbrev coordinateHopfAlgebra : _root_.CommHopfAlgCat.{u} R :=
  CommHopfAlgCat.quotient (ambientHopfAlgebra R n) (definingHopfIdeal R n C)

/-- The quotient coordinate morphism from `O(GLₙ × 𝔾_m)` to the coordinate Hopf algebra of the
similitude group scheme. -/
noncomputable def coordinateMap : ambientHopfAlgebra R n ⟶ coordinateHopfAlgebra R n C :=
  CommHopfAlgCat.mkQuotient (ambientHopfAlgebra R n) (definingHopfIdeal R n C)

/-- The coordinate map is the canonical quotient morphism by the defining Hopf ideal. -/
theorem coordinateMap_def :
    coordinateMap R n C =
      CommHopfAlgCat.mkQuotient (ambientHopfAlgebra R n) (definingHopfIdeal R n C) := by
  unfold coordinateMap
  rfl

/-- The coordinate morphism sends an ambient coordinate to its quotient class. -/
-- Not `@[simp]`: its left-hand side subsumes that of the `@[simp]` elimination lemma
-- `coordinateMap_relationMatrix`, and the named morphism is the normal form.
theorem coordinateMap_apply (h : ambientHopfAlgebra R n) :
    (coordinateMap R n C).hom h = Ideal.Quotient.mkₐ R (definingHopfIdeal R n C).toIdeal h := by
  unfold coordinateMap
  exact CommHopfAlgCat.mkQuotient_apply (ambientHopfAlgebra R n) (definingHopfIdeal R n C) h

/-- Every defining relation vanishes in the coordinate Hopf algebra of the similitude group
scheme: `X C Xᵀ = r C` holds there. -/
@[simp]
theorem coordinateMap_relationMatrix (i j : Fin n) :
    (coordinateMap R n C).hom (relationMatrix R n C i j) = 0 := by
  rw [coordinateMap_def]
  exact (CommHopfAlgCat.mkQuotient_eq_zero_iff _ _ _).mpr
    (HopfIdeal.mem_toIdeal.mp (definingHopfIdeal_toIdeal R n C ▸
      Ideal.subset_span (relationMatrix_mem_relationSet R n C i j)))

/-! ### The group scheme, its closed immersion and the multiplier -/

/-- **The similitude group scheme of `C`**: the closed subgroup scheme of `GLₙ × 𝔾_m` of pairs
`(h, r)` with `h C hᵀ = r C`. -/
noncomputable abbrev groupScheme :=
  CommHopfAlgCat.quotientSpec (ambientHopfAlgebra R n) (definingHopfIdeal R n C)

/-- The similitude group scheme is the quotient spectrum of its coordinate Hopf algebra. -/
theorem groupScheme_def :
    groupScheme R n C =
      CommHopfAlgCat.quotientSpec (ambientHopfAlgebra R n) (definingHopfIdeal R n C) :=
  rfl

/-- The closed-subgroup inclusion of the similitude group scheme into `GLₙ × 𝔾_m`. -/
noncomputable def inclusion :
    groupScheme R n C ⟶
      (AlgebraicGeometry.hopfSpec (CommRingCat.of R)).obj
        (Opposite.op (ambientHopfAlgebra R n)) :=
  CommHopfAlgCat.quotientSpecι (ambientHopfAlgebra R n) (definingHopfIdeal R n C)

/-- The inclusion is the quotient-spectrum inclusion at the defining Hopf ideal. -/
theorem inclusion_def :
    inclusion R n C =
      CommHopfAlgCat.quotientSpecι (ambientHopfAlgebra R n) (definingHopfIdeal R n C) := by
  unfold inclusion
  rfl

/-- The inclusion into `GLₙ × 𝔾_m` is a closed immersion. -/
instance isClosedImmersion_inclusion :
    AlgebraicGeometry.IsClosedImmersion (inclusion R n C).hom.hom.left := by
  rw [inclusion_def]
  infer_instance

/-- The coordinate morphism `O(𝔾_m) ⟶ O(GSim(C))` of the **multiplier character**
`ν : (h, r) ↦ r`: the right tensor inclusion followed by the quotient map. -/
noncomputable def multiplierCoordinateMap :
    _root_.CommHopfAlgCat.of R R[T;T⁻¹] ⟶ coordinateHopfAlgebra R n C :=
  inr R n ≫ coordinateMap R n C

/-- The multiplier coordinate morphism is the right tensor inclusion followed by the quotient
map. -/
theorem multiplierCoordinateMap_def :
    multiplierCoordinateMap R n C = inr R n ≫ coordinateMap R n C := by
  unfold multiplierCoordinateMap
  rfl

/-- **The multiplier character** `ν : GSim(C) ⟶ 𝔾_m` of group schemes over `R`. -/
noncomputable def multiplier :
    groupScheme R n C ⟶
      (AlgebraicGeometry.hopfSpec (CommRingCat.of R)).obj
        (Opposite.op (_root_.CommHopfAlgCat.of R R[T;T⁻¹])) :=
  (AlgebraicGeometry.hopfSpec (CommRingCat.of R)).map (multiplierCoordinateMap R n C).op

/-- The multiplier character is the image under `hopfSpec` of its coordinate morphism. -/
theorem multiplier_def :
    multiplier R n C =
      (AlgebraicGeometry.hopfSpec (CommRingCat.of R)).map (multiplierCoordinateMap R n C).op := by
  unfold multiplier
  rfl

/-! ### Algebra-valued points -/

section Points

variable {A : Type w} [CommRing A] [Algebra R A]

/-- The points of `GLₙ × 𝔾_m`: the product-points equivalence followed by the points
equivalences of the two factors. -/
noncomputable def ambientPointsMulEquiv (A : Type w) [CommRing A] [Algebra R A] :
    HopfAlgebra.points (R := R) (H := ambientHopfAlgebra R n) (CommAlgCat.of R A) ≃*
      GL (Fin n) A × Aˣ :=
  (AffineGroup.Product.pointsMulEquiv (H₁ := GeneralLinear.coordinateHopfAlgebra R n)
    (H₂ := R[T;T⁻¹]) (A := A)).trans
    (MulEquiv.prodCongr (GeneralLinear.pointsMulEquiv n) MultiplicativeGroup.pointsMulEquiv)

/-- An ambient point corresponds to the pair of its restrictions to the two factors, read as an
invertible matrix and a unit. -/
theorem ambientPointsMulEquiv_apply
    (g : HopfAlgebra.points (R := R) (H := ambientHopfAlgebra R n) (CommAlgCat.of R A)) :
    ambientPointsMulEquiv R n A g =
      (GeneralLinear.pointsMulEquiv n (BialgHom.mapDomain (inl R n).hom g),
        MultiplicativeGroup.pointsMulEquiv (BialgHom.mapDomain (inr R n).hom g)) := by
  rw [ambientPointsMulEquiv]
  -- `ambientHopfAlgebra R n` is the tensor product `O(GLₙ) ⊗[R] R[T;T⁻¹]` of the two factors,
  -- `inl` and `inr` are its two inclusions, and `MulEquiv.prodCongr` acts componentwise.
  exact congrArg (MulEquiv.prodCongr _ _) (AffineGroup.Product.pointsMulEquiv_apply g)

/-- The matrix of an ambient point is its value on the generic matrix of the product. -/
@[simp]
theorem coe_ambientPointsMulEquiv_fst
    (g : HopfAlgebra.points (R := R) (H := ambientHopfAlgebra R n) (CommAlgCat.of R A)) :
    ((ambientPointsMulEquiv R n A g).1 : Matrix (Fin n) (Fin n) A) =
      (matrixCoord R n).map g.ofConv := by
  rw [ambientPointsMulEquiv_apply, GeneralLinear.pointsMulEquiv_apply,
    ← GeneralLinear.map_genericMatrix_eq_coe_pointToGeneralLinear]
  ext i j
  rw [Matrix.map_apply, Matrix.map_apply, matrixCoord, Matrix.map_apply,
    ← BialgHom.mapDomain_apply_apply]

/-- The unit of an ambient point is its value on the multiplier coordinate. -/
@[simp]
theorem coe_ambientPointsMulEquiv_snd
    (g : HopfAlgebra.points (R := R) (H := ambientHopfAlgebra R n) (CommAlgCat.of R A)) :
    ((ambientPointsMulEquiv R n A g).2 : A) = g.ofConv (multiplierCoord R n) := by
  rw [ambientPointsMulEquiv_apply, MultiplicativeGroup.pointsMulEquiv_apply,
    laurentEvalEquiv_symm_apply, multiplierCoord, ← BialgHom.mapDomain_apply_apply]

/-- **The subgroup of `GLₙ(A) × Aˣ` of similitudes of `C`**: pairs `(h, r)` with
`h C hᵀ = r C`. -/
def pointsSubgroup (A : Type w) [CommRing A] [Algebra R A] : Subgroup (GL (Fin n) A × Aˣ) where
  carrier := {p | (p.1 : Matrix (Fin n) (Fin n) A) * C.map (algebraMap R A) *
    (p.1 : Matrix (Fin n) (Fin n) A)ᵀ = (p.2 : A) • C.map (algebraMap R A)}
  one_mem' := by
    simp only [Set.mem_ofPred_eq, Prod.fst_one, Prod.snd_one, Units.val_one, Matrix.one_mul,
      Matrix.transpose_one, Matrix.mul_one, one_smul]
  mul_mem' {p q} hp hq := by
    simp only [Set.mem_ofPred_eq, Prod.fst_mul, Prod.snd_mul, Units.val_mul] at hp hq ⊢
    rw [← sub_eq_zero] at hp hq ⊢
    rw [Matrix.mul_mul_mul_transpose_sub_mul_smul, hp, hq, Matrix.mul_zero, Matrix.zero_mul,
      smul_zero, add_zero]
  inv_mem' {p} hp := by
    simp only [Set.mem_ofPred_eq, Prod.fst_inv, Prod.snd_inv] at hp ⊢
    rw [← sub_eq_zero] at hp ⊢
    rw [Matrix.mul_mul_transpose_sub_smul_of_mul_eq_one (Units.inv_mul p.1) (Units.inv_mul p.2),
      hp, Matrix.mul_zero, Matrix.zero_mul, smul_zero, neg_zero]

/-- Membership in the subgroup of similitudes of `C`. -/
@[simp]
theorem mem_pointsSubgroup_iff (p : GL (Fin n) A × Aˣ) :
    p ∈ pointsSubgroup R n C A ↔
      (p.1 : Matrix (Fin n) (Fin n) A) * C.map (algebraMap R A) *
          (p.1 : Matrix (Fin n) (Fin n) A)ᵀ = (p.2 : A) • C.map (algebraMap R A) :=
  Iff.rfl

/-- **The ambient membership criterion**: an ambient point of `GLₙ × 𝔾_m` belongs to the subgroup
cut out by the defining Hopf ideal exactly when its pair `(h, r)` is a similitude of `C`. -/
theorem mem_definingPointsSubgroup_iff
    (g : HopfAlgebra.points (R := R) (H := ambientHopfAlgebra R n) (CommAlgCat.of R A)) :
    g ∈ CommHopfAlgCat.quotientPointsSubgroup (ambientHopfAlgebra R n)
        (definingHopfIdeal R n C) (CommAlgCat.of R A) ↔
      ambientPointsMulEquiv R n A g ∈ pointsSubgroup R n C A := by
  rw [CommHopfAlgCat.mem_quotientPointsSubgroup_iff, mem_pointsSubgroup_iff,
    coe_ambientPointsMulEquiv_fst, coe_ambientPointsMulEquiv_snd,
    ← definingHopfIdeal_toIdeal_le_ker_iff]
  exact ⟨fun h x hx => h x (HopfIdeal.mem_toIdeal.mp hx), fun h x hx => h hx⟩

/-- The subgroup of ambient points cut out by the defining Hopf ideal is the subgroup of
similitudes of `C`. -/
private theorem map_definingPointsSubgroup :
    (CommHopfAlgCat.quotientPointsSubgroup (ambientHopfAlgebra R n)
        (definingHopfIdeal R n C) (CommAlgCat.of R A)).map
        (ambientPointsMulEquiv R n A).toMonoidHom =
      pointsSubgroup R n C A := by
  ext p
  rw [Subgroup.mem_map_equiv, mem_definingPointsSubgroup_iff, MulEquiv.apply_symm_apply]

/-- **The points identification**: the group of algebra-valued points of the similitude
coordinate Hopf algebra is the group of similitudes `(h, r)` of `C`. -/
noncomputable def pointsMulEquiv :
    HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n C) (CommAlgCat.of R A) ≃*
      pointsSubgroup R n C A :=
  ((CommHopfAlgCat.quotientPointsSubgroupNatIso (ambientHopfAlgebra R n)
      (definingHopfIdeal R n C)).app (CommAlgCat.of R A)).groupIsoToMulEquiv.trans
    (((ambientPointsMulEquiv R n A).subgroupMap _).trans
      (MulEquiv.subgroupCongr (map_definingPointsSubgroup R n C)))

/-- Under the points identifications, the quotient-point inclusion is the inclusion of
similitudes into `GLₙ(A) × Aˣ`. -/
theorem pointsMulEquiv_coe
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n C) (CommAlgCat.of R A)) :
    ambientPointsMulEquiv R n A
        (CommHopfAlgCat.quotientPointsHom (ambientHopfAlgebra R n) (definingHopfIdeal R n C)
          (CommAlgCat.of R A) f) =
      (pointsMulEquiv R n C (A := A) f : GL (Fin n) A × Aˣ) := by
  have hcomponent := CommHopfAlgCat.quotientPointsSubgroupNatIso_hom_app_apply
    (ambientHopfAlgebra R n) (definingHopfIdeal R n C) (CommAlgCat.of R A) f
  -- `pointsMulEquiv` is the natural isomorphism followed by `MulEquiv.subgroupMap` and
  -- `MulEquiv.subgroupCongr`, both of which apply `ambientPointsMulEquiv` to the underlying point.
  exact congrArg (ambientPointsMulEquiv R n A) (congrArg Subtype.val hcomponent).symm

/-- The multiplier of a point, read through the points identification, is its unit
component. -/
theorem pointsMulEquiv_snd
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n C) (CommAlgCat.of R A)) :
    (((pointsMulEquiv R n C (A := A) f : GL (Fin n) A × Aˣ).2 : Aˣ) : A) =
      f.ofConv ((multiplierCoordinateMap R n C).hom (LaurentPolynomial.T 1)) := by
  rw [← pointsMulEquiv_coe, coe_ambientPointsMulEquiv_snd,
    CommHopfAlgCat.quotientPointsHom_apply_apply, multiplierCoordinateMap_def, coordinateMap_def]
  simp [multiplierCoord]

/-- The matrix of a point, read through the points identification, is its value on the image of
the generic matrix in the coordinate Hopf algebra. -/
theorem pointsMulEquiv_fst
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n C) (CommAlgCat.of R A)) :
    (((pointsMulEquiv R n C (A := A) f : GL (Fin n) A × Aˣ).1 : GL (Fin n) A) :
        Matrix (Fin n) (Fin n) A) =
      (matrixCoord R n).map fun x ↦ f.ofConv ((coordinateMap R n C).hom x) := by
  rw [← pointsMulEquiv_coe, coe_ambientPointsMulEquiv_fst]
  ext i j
  rw [Matrix.map_apply, Matrix.map_apply, CommHopfAlgCat.quotientPointsHom_apply_apply,
    coordinateMap_apply, Ideal.Quotient.mkₐ_eq_mk]

variable (A) in
/-- **The multiplier on points**, `(h, r) ↦ r`, on the similitudes of `C`. -/
def multiplierPoints : pointsSubgroup R n C A →* Aˣ :=
  (MonoidHom.snd _ _).comp (pointsSubgroup R n C A).subtype

/-- The multiplier of a similitude is its unit component. -/
@[simp]
theorem multiplierPoints_apply (p : pointsSubgroup R n C A) :
    multiplierPoints R n C A p = (p : GL (Fin n) A × Aˣ).2 := by
  unfold multiplierPoints
  rfl

/-- Under the points identification, the multiplier on points is the multiplier character. -/
theorem multiplierPoints_pointsMulEquiv
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n C) (CommAlgCat.of R A)) :
    ((multiplierPoints R n C A (pointsMulEquiv R n C (A := A) f) : Aˣ) : A) =
      f.ofConv ((multiplierCoordinateMap R n C).hom (LaurentPolynomial.T 1)) := by
  rw [multiplierPoints_apply, pointsMulEquiv_snd]

variable {B : Type*} [CommRing B] [Algebra R B]

/-- The ambient points equivalence is natural in the value algebra. -/
theorem ambientPointsMulEquiv_mapValue (phi : A →ₐ[R] B)
    (g : HopfAlgebra.points (R := R) (H := ambientHopfAlgebra R n) (CommAlgCat.of R A)) :
    ambientPointsMulEquiv R n B (AlgHom.mapValue (H := ambientHopfAlgebra R n) phi g) =
      Prod.map (Matrix.GeneralLinearGroup.map (phi : A →+* B)) (Units.map (phi : A →* B))
        (ambientPointsMulEquiv R n A g) := by
  unfold ambientPointsMulEquiv
  -- `ambientHopfAlgebra R n` is the tensor product `O(GLₙ) ⊗[R] R[T;T⁻¹]` of the two factors.
  exact (congrArg (MulEquiv.prodCongr _ _)
    (AffineGroup.Product.pointsMulEquiv_mapValue phi g)).trans
      (Prod.ext (GeneralLinear.pointsMulEquiv_mapValue n phi _)
        (MultiplicativeGroup.pointsMulEquiv_mapValue phi _))

/-- **Change of value algebra on similitudes**: an algebra morphism `phi : A → B` sends a
similitude `(h, r)` of `C` over `A` to the similitude `(phi h, phi r)` over `B`. -/
def pointsSubgroupMap (phi : A →ₐ[R] B) : pointsSubgroup R n C A →* pointsSubgroup R n C B :=
  ((MonoidHom.prodMap (Matrix.GeneralLinearGroup.map (phi : A →+* B))
      (Units.map (phi : A →* B))).comp (pointsSubgroup R n C A).subtype).codRestrict _
    fun p => by
      have hC : (C.map (algebraMap R A)).map phi = C.map (algebraMap R B) := by
        rw [Matrix.map_map]
        exact congrArg _ (funext fun r => phi.commutes r)
      have h := congrArg (Matrix.map · phi) ((mem_pointsSubgroup_iff R n C _).mp p.property)
      rw [Matrix.map_mul, Matrix.map_mul, Matrix.map_smul' _ _ _ (map_mul phi), hC,
        Matrix.transpose_map] at h
      rw [mem_pointsSubgroup_iff, MonoidHom.comp_apply, Subgroup.coe_subtype,
        MonoidHom.coe_prodMap, Prod.map_fst, Prod.map_snd, Units.coe_map, MonoidHom.coe_ofClass,
        Matrix.GeneralLinearGroup.val_map_apply, RingHom.coe_coe]
      exact h

/-- The similitude `pointsSubgroupMap phi p` is `p` with `phi` applied to both components. -/
@[simp]
theorem coe_pointsSubgroupMap (phi : A →ₐ[R] B) (p : pointsSubgroup R n C A) :
    (pointsSubgroupMap R n C phi p : GL (Fin n) B × Bˣ) =
      Prod.map (Matrix.GeneralLinearGroup.map (phi : A →+* B)) (Units.map (phi : A →* B))
        (p : GL (Fin n) A × Aˣ) := by
  unfold pointsSubgroupMap
  rfl

/-- **The points identification is natural in the value algebra**: post-composing a point with
`phi` maps its similitude componentwise by `phi`. -/
theorem pointsMulEquiv_mapValue (phi : A →ₐ[R] B)
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n C) (CommAlgCat.of R A)) :
    pointsMulEquiv R n C (A := B) (AlgHom.mapValue (H := coordinateHopfAlgebra R n C) phi f) =
      pointsSubgroupMap R n C phi (pointsMulEquiv R n C (A := A) f) := by
  apply Subtype.ext
  rw [coe_pointsSubgroupMap, ← pointsMulEquiv_coe, ← pointsMulEquiv_coe,
    ← CommHopfAlgCat.mapValue_quotientPointsHom, ambientPointsMulEquiv_mapValue]

end Points

end TauCeti.ConstantFormSimilitude
