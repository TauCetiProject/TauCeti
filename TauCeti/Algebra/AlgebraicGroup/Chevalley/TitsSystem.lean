/-!
# The Tits systems and Weyl quotients of a Chevalley datum

For a Chevalley datum `D` of valid Dynkin type `t`, let `B(A) = D.borelSubgroup A` be the subgroup
generated by all positive root subgroups and the actual weight-lattice torus `T(A)`, and let
`N(A) = D.weylSubgroup A` be generated by `T(A)` and the pinned simple Weyl representatives
`n_{αᵢ}(1)`. Over every commutative ring `A`, `B(A)` and `N(A)` lie in and together generate the
extended elementary Chevalley group `D.extendedElementarySubgroup A`.

Over any field `k` — including finite fields and `𝔽₂`, without assuming nontriviality of `kˣ` —
defining `N(k)` by pinned generators rather than as the full matrix normalizer of `T(k)` avoids the
degeneracy where `T(𝔽₂) = 1` has too large a normalizer. Combining the local parabolic
factorization `U(k) = U⁽ⁱ⁾(k) X_{αᵢ}(k)` with the rank-one exchange identity yields the exact
double-coset multiplication laws for `(B n_{αᵢ}(1) B)(B n B)`: it equals `B (n_{αᵢ}(1) n) B` when
`w⁻¹ αᵢ` is positive (`w = D.weylProjection k n`) and `B (n_{αᵢ}(1) n) B ∪ B n B` when `w⁻¹ αᵢ` is
negative.

In particular, `TitsSystem.existsUnique_mem_bruhatCell` gives the disjoint Weyl-indexed Bruhat
decompositions of both `D.extendedElementarySubgroup k` and `D.elementarySubgroup k`. Neither
equality of `D.extendedElementarySubgroup k` with all scheme points `D.points k` nor a refined
normal form `u n_w b` on inversion root subgroups is asserted here.

## Main declarations

* `TauCeti.DynkinType.ChevalleyDatum.borelSubgroup_sup_weylSubgroup_eq_extendedElementarySubgroup`:
  `B(A) ⊔ N(A) = D.extendedElementarySubgroup A` over every commutative ring `A`.
* `TauCeti.DynkinType.ChevalleyDatum.doubleCoset_weylElement_mul_eq_of_mem_posRoots` and
  `TauCeti.DynkinType.ChevalleyDatum.doubleCoset_weylElement_mul_eq_union_of_mem_negRoots`:
  simple-reflection Bruhat double-coset multiplication in `D.points k`.
* `TauCeti.DynkinType.ChevalleyDatum.titsSystem` and
  `TauCeti.DynkinType.ChevalleyDatum.titsSystemWeylGroupMulEquiv`: the Tits system on
  `D.extendedElementarySubgroup k` and its Weyl-group isomorphism onto
  `(t.simplyConnectedRootDatum ht).weylGroup`.
* `TauCeti.DynkinType.ChevalleyDatum.ker_weylProjection` and
  `TauCeti.DynkinType.ChevalleyDatum.weylQuotientMulEquiv`: `(D.weylProjection k).ker = T(k)` and
  `N(k) ⧸ T(k) ≃* (t.simplyConnectedRootDatum ht).weylGroup`.
* `TauCeti.DynkinType.ChevalleyDatum.elementaryTitsSystem` and
  `TauCeti.DynkinType.ChevalleyDatum.elementaryTitsSystemWeylGroupMulEquiv`: the pulled-back Tits
  system on `D.elementarySubgroup k` and its Weyl-group isomorphism.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 22, Theorem 4, and Theorem 4′.
* R. W. Carter, *Simple Groups of Lie Type*, §§7.2 and 8.2–8.3.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Chapter IV, §2.
-/

public section

open Multiplicative
open scoped Pointwise

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-! ## Generation of the extended elementary subgroup over commutative rings -/

section CommRing

variable (A : Type v) [CommRing A]

/-- Every positive point lies in the elementary Chevalley subgroup. -/
theorem positivePoints_le_elementarySubgroup :
    D.positivePoints A ≤ D.elementarySubgroup A :=
  D.positivePoints_le_iff.mpr fun γ _ u => D.rootSubgroupPoints_mem_elementarySubgroup A γ u

/-- The Borel subgroup lies in the extended elementary Chevalley subgroup over every commutative
ring. -/
theorem borelSubgroup_le_extendedElementarySubgroup :
    D.borelSubgroup A ≤ D.extendedElementarySubgroup A := by
  rw [D.borelSubgroup_def, D.extendedElementarySubgroup_def]
  exact sup_le ((D.positivePoints_le_elementarySubgroup A).trans le_sup_left) le_sup_right

/-- Every Steinberg Weyl element `n_γ(s)` lies in the elementary Chevalley subgroup. -/
theorem weylElement_mem_elementarySubgroup (γ : Fin t.numRoots) (s : Aˣ) :
    D.weylElement γ A s ∈ D.elementarySubgroup A := by
  rw [D.weylElement_def]
  exact mul_mem (mul_mem (D.rootSubgroupPoints_mem_elementarySubgroup A _ _)
    (D.rootSubgroupPoints_mem_elementarySubgroup A _ _))
    (D.rootSubgroupPoints_mem_elementarySubgroup A _ _)

/-- The Weyl subgroup lies in the extended elementary Chevalley subgroup over every commutative
ring. -/
theorem weylSubgroup_le_extendedElementarySubgroup :
    D.weylSubgroup A ≤ D.extendedElementarySubgroup A := by
  rw [D.weylSubgroup_def, Subgroup.closure_le]
  rintro _ (⟨s, rfl⟩ | ⟨i, rfl⟩)
  · exact D.torusPoints_mem_extendedElementarySubgroup A s
  · exact D.elementarySubgroup_le_extendedElementarySubgroup A
      (D.weylElement_mem_elementarySubgroup A _ 1)

/-- Over every commutative ring, the Borel and Weyl subgroups together generate the extended
elementary Chevalley subgroup: each negative simple root subgroup is conjugate to its positive
counterpart by the corresponding simple Weyl element. -/
@[simp]
theorem borelSubgroup_sup_weylSubgroup_eq_extendedElementarySubgroup :
    D.borelSubgroup A ⊔ D.weylSubgroup A = D.extendedElementarySubgroup A := by
  apply le_antisymm
  · exact sup_le (D.borelSubgroup_le_extendedElementarySubgroup A)
      (D.weylSubgroup_le_extendedElementarySubgroup A)
  · rw [D.extendedElementarySubgroup_def]
    refine sup_le ?_ ((D.range_torusPoints_le_borelSubgroup A).trans le_sup_left)
    rw [D.elementarySubgroup_eq_closure_simpleRootPair A, Subgroup.closure_le]
    rintro _ hg
    obtain ⟨i, ⟨u, rfl⟩ | ⟨u, rfl⟩⟩ := Set.mem_iUnion.mp hg
    · exact Subgroup.mem_sup_left (D.positivePoints_le_borelSubgroup A
        (D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u))
    · let ε := t.chevalleyWeylSign ht (t.simpleIndex ht i) (t.simpleIndex ht i)
      have hεsq : ((ε : ℤ) : A) * (((ε : ℤ) : A) * toAdd u) = toAdd u := by
        rcases Int.units_eq_one_or ε with hε | hε <;> simp [hε]
      have hconj := D.weylElement_conj_rootSubgroupPoints i (t.simpleIndex ht i) A
        (((ε : ℤ) : A) * toAdd u)
      rw [hεsq, ofAdd_toAdd] at hconj
      rw [← hconj]
      have hn : D.weylElement (t.simpleIndex ht i) A 1 ∈ D.borelSubgroup A ⊔ D.weylSubgroup A :=
        Subgroup.mem_sup_right (D.weylElement_mem_weylSubgroup A i)
      have hx : D.rootSubgroupPoints (t.simpleIndex ht i) A
          (ofAdd (((ε : ℤ) : A) * toAdd u)) ∈ D.borelSubgroup A ⊔ D.weylSubgroup A :=
        Subgroup.mem_sup_left (D.positivePoints_le_borelSubgroup A
          (D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) _))
      exact mul_mem (mul_mem hn hx) (inv_mem hn)

end CommRing

/-! ## Simple-reflection Bruhat cell multiplication over a field -/

noncomputable section Field

variable (k : Type v) [Field k]

/-- Using `B = U⁽ⁱ⁾ X_{αᵢ} T`, `n_{αᵢ}(1) ∈ N_G(U⁽ⁱ⁾)`, and `n ∈ N_G(T)`, every element of
`(B n_{αᵢ}(1) B)(B n B)` reduces to `b₁ (n_{αᵢ}(1) x_{αᵢ}(a) n) b₂` with `b₁, b₂ ∈ B`. -/
private theorem exists_weylElement_mul_rootSubgroup_mul_of_mem_mul_doubleCoset
    (i : Fin t.rank) (n : D.weylSubgroup k) {g : D.points k}
    (hg : g ∈ DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1)
        (D.borelSubgroup k) (D.borelSubgroup k) *
      DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k)) :
    ∃ b₁ ∈ D.borelSubgroup k, ∃ b₂ ∈ D.borelSubgroup k, ∃ a : Multiplicative k,
      g = b₁ * (D.weylElement (t.simpleIndex ht i) k 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) k a * (n : D.points k)) * b₂ := by
  obtain ⟨_, hx, _, hy, rfl⟩ := Set.mem_mul.mp hg
  obtain ⟨b₁, hb₁, c₁, hc₁, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
  obtain ⟨c₂, hc₂, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hy
  obtain ⟨u, hu, s, hus⟩ := (D.mem_borelSubgroup_iff k).mp (mul_mem hc₁ hc₂)
  obtain ⟨v, hv, a, rfl⟩ := (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints k i u).mp hu
  let r := D.weylElement (t.simpleIndex ht i) k 1
  have hrv : r * v * r⁻¹ ∈ D.borelSubgroup k := by
    have hmem : r * v * r⁻¹ ∈ (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)) :=
      (Subgroup.mem_normalizer_iff.mp
        (D.weylElement_mem_normalizer_positivePoints_diff_singleton k i 1) v).mp hv
    have hle : (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)) ≤ D.positivePoints k := by
      rw [D.positivePoints_eq_iSup k]
      exact iSup₂_mono' fun γ hγ => ⟨γ, hγ.1, le_rfl⟩
    exact D.positivePoints_le_borelSubgroup k (hle hmem)
  have htn : (n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k) ∈ D.borelSubgroup k := by
    have hnorm := D.weylSubgroup_le_normalizer_range_torusPoints k (inv_mem n.property)
    have hmem : (n : D.points k)⁻¹ * D.torusPoints k s * ((n : D.points k)⁻¹)⁻¹ ∈
        (D.torusPoints k).range :=
      (Subgroup.mem_normalizer_iff.mp hnorm _).mp ⟨s, rfl⟩
    simpa only [inv_inv] using D.range_torusPoints_le_borelSubgroup k hmem
  refine ⟨b₁ * (r * v * r⁻¹), mul_mem hb₁ hrv,
    (n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k) * b₂, mul_mem htn hb₂, a, ?_⟩
  have hc : c₁ * c₂ = v * D.rootSubgroupPoints (t.simpleIndex ht i) k a * D.torusPoints k s :=
    hus.symm
  calc
    b₁ * r * c₁ * (c₂ * (n : D.points k) * b₂)
      = b₁ * r * (c₁ * c₂) * (n : D.points k) * b₂ := by group
    _ = b₁ * r * (v * D.rootSubgroupPoints (t.simpleIndex ht i) k a * D.torusPoints k s) *
          (n : D.points k) * b₂ := by rw [hc]
    _ = (b₁ * (r * v * r⁻¹)) *
          (r * D.rootSubgroupPoints (t.simpleIndex ht i) k a * (n : D.points k)) *
          ((n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k) * b₂) := by group

/-- If `w⁻¹ αᵢ` is positive (`w = D.weylProjection k n`), conjugating `X_{αᵢ}` by `n⁻¹` lands in
the positive Borel subgroup. -/
private theorem conj_inv_rootSubgroupPoints_mem_borelSubgroup_of_mem_posRoots
    (i : Fin t.rank) (n : D.weylSubgroup k)
    (hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k n)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (a : Multiplicative k) :
    (n : D.points k)⁻¹ * D.rootSubgroupPoints (t.simpleIndex ht i) k a * (n : D.points k) ∈
      D.borelSubgroup k := by
  have hmem : MulAut.conj ((n⁻¹ : D.weylSubgroup k) : D.points k)
      (D.rootSubgroupPoints (t.simpleIndex ht i) k a) ∈
      (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).weylGroupToPerm
        (D.weylProjection k n⁻¹) (t.simpleIndex ht i)) k).range := by
    rw [← D.map_range_rootSubgroupPoints_conj k n⁻¹ (t.simpleIndex ht i)]
    exact ⟨_, ⟨a, rfl⟩, rfl⟩
  rw [map_inv] at hmem
  obtain ⟨b, hb⟩ := hmem
  have hcalc : (n : D.points k)⁻¹ * D.rootSubgroupPoints (t.simpleIndex ht i) k a *
      (n : D.points k) =
      D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).weylGroupToPerm
        (D.weylProjection k n)⁻¹ (t.simpleIndex ht i)) k b := by
    simpa only [MulAut.conj_apply, Subgroup.coe_inv, inv_inv] using hb.symm
  rw [hcalc]
  exact D.positivePoints_le_borelSubgroup k (D.rootSubgroupPoints_mem_positivePoints k hpos b)

/-- **Length-increasing simple Bruhat multiplication in `D.points k`.** When `w⁻¹ αᵢ` is a positive
root for `w = D.weylProjection k n`, multiplying `B n_{αᵢ}(1) B` by `B n B` gives the single double
coset `B (n_{αᵢ}(1) n) B`. -/
theorem doubleCoset_weylElement_mul_eq_of_mem_posRoots
    (i : Fin t.rank) (n : D.weylSubgroup k)
    (hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k n)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1)
          (D.borelSubgroup k) (D.borelSubgroup k) *
        DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) =
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1 * (n : D.points k))
        (D.borelSubgroup k) (D.borelSubgroup k) := by
  apply Set.Subset.antisymm
  · intro g hg
    obtain ⟨b₁, hb₁, b₂, hb₂, a, rfl⟩ :=
      D.exists_weylElement_mul_rootSubgroup_mul_of_mem_mul_doubleCoset k i n hg
    have hconj := D.conj_inv_rootSubgroupPoints_mem_borelSubgroup_of_mem_posRoots k i n hpos a
    refine DoubleCoset.mem_doubleCoset.mpr
      ⟨b₁, hb₁, (n : D.points k)⁻¹ * D.rootSubgroupPoints (t.simpleIndex ht i) k a *
        (n : D.points k) * b₂, mul_mem hconj hb₂, ?_⟩
    group
  · exact DoubleCoset.doubleCoset_mul_subset_mul_doubleCoset (M := D.points k)
      (D.borelSubgroup k) (D.borelSubgroup k) (D.borelSubgroup k) (D.borelSubgroup k).one_mem _ _

/-- **Length-decreasing simple Bruhat multiplication in `D.points k`.** When `w⁻¹ αᵢ` is a negative
root for `w = D.weylProjection k n`, multiplying `B n_{αᵢ}(1) B` by `B n B` gives the union
`B (n_{αᵢ}(1) n) B ∪ B n B`. -/
theorem doubleCoset_weylElement_mul_eq_union_of_mem_negRoots
    (i : Fin t.rank) (n : D.weylSubgroup k)
    (hneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k n)⁻¹
      (t.simpleIndex ht i) ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1)
          (D.borelSubgroup k) (D.borelSubgroup k) *
        DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) =
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1 * (n : D.points k))
          (D.borelSubgroup k) (D.borelSubgroup k) ∪
        DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) := by
  let r := D.weylElement (t.simpleIndex ht i) k 1
  let rN : D.weylSubgroup k := ⟨r, D.weylElement_mem_weylSubgroup k i⟩
  let m : D.weylSubgroup k := rN⁻¹ * n
  have hm_pos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k m)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    let P := t.simplyConnectedRootDatum ht
    let _ := P.indexNeg
    have hproj : (D.weylProjection k m)⁻¹ =
        (D.weylProjection k n)⁻¹ * RootPairing.weylGroup.ofIdx P (t.simpleIndex ht i) := by
      simp only [m, rN, r, P, map_mul, map_inv, mul_inv_rev, inv_inv,
        D.weylProjection_weylElement]
    have hperm : P.weylGroupToPerm (D.weylProjection k m)⁻¹ (t.simpleIndex ht i) =
        P.reflectionPerm (P.weylGroupToPerm (D.weylProjection k n)⁻¹ (t.simpleIndex ht i))
          (P.weylGroupToPerm (D.weylProjection k n)⁻¹ (t.simpleIndex ht i)) := by
      rw [hproj, map_mul, Equiv.Perm.mul_apply, RootPairing.weylGroupToPerm_ofIdx_apply,
        ← RootPairing.indexNeg_neg, P.weylGroupToPerm_neg, RootPairing.indexNeg_neg]
    rw [hperm, ← t.reflectionPerm_rationalRootSystem ht]
    exact (reflectionPerm_self_mem_posRoots_iff_mem_negRoots
      (t.rationalRootSystem ht) (t.rationalBase ht) _).mpr hneg
  have hunit_mem (u : kˣ) :
      r * D.rootSubgroupPoints (t.simpleIndex ht i) k (ofAdd (u : k)) * (n : D.points k) ∈
        DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) := by
    have hexch := D.weylElement_mul_rootSubgroup_mul_weylElement i k u
    have hbL : D.rootSubgroupPoints (t.simpleIndex ht i) k (ofAdd (-((u⁻¹ : kˣ) : k))) *
        D.simpleCorootPoints i k (-u⁻¹) ∈ D.borelSubgroup k :=
      mul_mem
        (D.positivePoints_le_borelSubgroup k
          (D.rootSubgroupPoints_mem_positivePoints k (simpleIndex_mem_posRoots i) _))
        (by
          rw [D.simpleCorootPoints_eq_torusPoints]
          exact D.range_torusPoints_le_borelSubgroup k ⟨_, rfl⟩)
    have hbR := D.conj_inv_rootSubgroupPoints_mem_borelSubgroup_of_mem_posRoots k i m hm_pos
      (ofAdd (-((u⁻¹ : kˣ) : k)))
    refine DoubleCoset.mem_doubleCoset.mpr ⟨_, hbL, _, hbR, ?_⟩
    have hm_coe : (m : D.points k) = r⁻¹ * (n : D.points k) := rfl
    calc
      r * D.rootSubgroupPoints (t.simpleIndex ht i) k (ofAdd (u : k)) * (n : D.points k)
        = (r * D.rootSubgroupPoints (t.simpleIndex ht i) k (ofAdd (u : k)) * r) *
            (m : D.points k) := by rw [hm_coe]; group
      _ = (D.rootSubgroupPoints (t.simpleIndex ht i) k (ofAdd (-((u⁻¹ : kˣ) : k))) *
            D.simpleCorootPoints i k (-u⁻¹) * r *
            D.rootSubgroupPoints (t.simpleIndex ht i) k (ofAdd (-((u⁻¹ : kˣ) : k)))) *
            (m : D.points k) := by rw [hexch]
      _ = (D.rootSubgroupPoints (t.simpleIndex ht i) k (ofAdd (-((u⁻¹ : kˣ) : k))) *
            D.simpleCorootPoints i k (-u⁻¹)) * (n : D.points k) *
            ((m : D.points k)⁻¹ *
              D.rootSubgroupPoints (t.simpleIndex ht i) k (ofAdd (-((u⁻¹ : kˣ) : k))) *
              (m : D.points k)) := by rw [hm_coe]; group
  apply Set.Subset.antisymm
  · intro g hg
    obtain ⟨b₁, hb₁, b₂, hb₂, a, rfl⟩ :=
      D.exists_weylElement_mul_rootSubgroup_mul_of_mem_mul_doubleCoset k i n hg
    by_cases ha : toAdd a = 0
    · have ha1 : a = 1 := toAdd.injective (ha.trans toAdd_one.symm)
      rw [ha1, map_one, mul_one]
      exact Or.inl (DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, b₂, hb₂, rfl⟩)
    · obtain ⟨c₁, hc₁, c₂, hc₂, hc⟩ :=
        DoubleCoset.mem_doubleCoset.mp (hunit_mem (Units.mk0 (toAdd a) ha))
      have ha_eq : ofAdd ((Units.mk0 (toAdd a) ha : kˣ) : k) = a := ofAdd_toAdd a
      rw [ha_eq] at hc
      exact Or.inr (DoubleCoset.mem_doubleCoset.mpr
        ⟨b₁ * c₁, mul_mem hb₁ hc₁, c₂ * b₂, mul_mem hc₂ hb₂, by rw [hc]; group⟩)
  · refine Set.union_subset
      (DoubleCoset.doubleCoset_mul_subset_mul_doubleCoset (M := D.points k) (D.borelSubgroup k)
        (D.borelSubgroup k) (D.borelSubgroup k) (D.borelSubgroup k).one_mem _ _) ?_
    -- At parameter `u = 1`, `r * x_i(1) * n` lies in both `(B r B)(B n B)` and `B n B`.
    conv_lhs => rw [← DoubleCoset.doubleCoset_eq_of_mem (hunit_mem 1)]
    rintro g hg
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    refine ⟨b₁ * r * D.rootSubgroupPoints (t.simpleIndex ht i) k (ofAdd ((1 : kˣ) : k)),
      DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, _, D.positivePoints_le_borelSubgroup k
        (D.rootSubgroupPoints_mem_positivePoints k (simpleIndex_mem_posRoots i) _), rfl⟩,
      (n : D.points k) * b₂,
      DoubleCoset.mem_doubleCoset.mpr ⟨1, one_mem _, b₂, hb₂, by rw [one_mul]⟩, ?_⟩
    group

/-! ## The Tits system of the extended elementary subgroup -/

private theorem mem_doubleCoset_subgroupOf_extendedElementarySubgroup_iff
    (x y : D.extendedElementarySubgroup k) :
    y ∈ DoubleCoset.doubleCoset x
        ((D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k))
        ((D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k)) ↔
      (y : D.points k) ∈ DoubleCoset.doubleCoset (x : D.points k)
        (D.borelSubgroup k) (D.borelSubgroup k) := by
  simp only [DoubleCoset.mem_doubleCoset, SetLike.mem_coe]
  constructor
  · rintro ⟨b₁, hb₁, b₂, hb₂, rfl⟩
    exact ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · rintro ⟨b₁, hb₁, b₂, hb₂, hy⟩
    exact ⟨⟨b₁, D.borelSubgroup_le_extendedElementarySubgroup k hb₁⟩, hb₁,
      ⟨b₂, D.borelSubgroup_le_extendedElementarySubgroup k hb₂⟩, hb₂, Subtype.ext hy⟩

private theorem subgroupOf_borel_subgroupOf_weyl_eq_comap :
    (((D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k)).subgroupOf
        ((D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k))) =
      (((D.torusPoints k).range).subgroupOf (D.weylSubgroup k)).comap
        (Subgroup.subgroupOfEquivOfLe
          (D.weylSubgroup_le_extendedElementarySubgroup k)).toMonoidHom := by
  rw [← D.borelSubgroup_subgroupOf_weylSubgroup k]
  rfl

private instance :
    (((D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k)).subgroupOf
      ((D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k))).Normal := by
  rw [D.subgroupOf_borel_subgroupOf_weyl_eq_comap k]
  exact Subgroup.Normal.comap inferInstance _

private def extendedSimpleRep (i : Fin t.rank) :
    (D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k) :=
  ⟨⟨D.weylElement (t.simpleIndex ht i) k 1,
    D.weylSubgroup_le_extendedElementarySubgroup k (D.weylElement_mem_weylSubgroup k i)⟩,
    D.weylElement_mem_weylSubgroup k i⟩

private theorem closure_range_mk_extendedSimpleRep :
    Subgroup.closure (Set.range fun i : Fin t.rank =>
      (QuotientGroup.mk (D.extendedSimpleRep k i) :
        (D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k) ⧸
          ((D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k)).subgroupOf
            ((D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k)))) = ⊤ := by
  let N_E := (D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k)
  let H_N := ((D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k)).subgroupOf N_E
  let C := Subgroup.closure (Set.range fun i : Fin t.rank =>
    (QuotientGroup.mk (D.extendedSimpleRep k i) : N_E ⧸ H_N))
  let P : Subgroup (D.points k) :=
    (C.comap (QuotientGroup.mk' H_N)).map
      ((D.extendedElementarySubgroup k).subtype.comp N_E.subtype)
  have hle : D.weylSubgroup k ≤ P := by
    rw [D.weylSubgroup_def k, Subgroup.closure_le]
    rintro _ (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · let t_N : N_E := ⟨⟨D.torusPoints k s, D.torusPoints_mem_extendedElementarySubgroup k s⟩,
        D.torusPoints_mem_weylSubgroup k s⟩
      refine ⟨t_N, ?_, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap, QuotientGroup.mk'_apply,
        (QuotientGroup.eq_one_iff t_N).mpr (D.range_torusPoints_le_borelSubgroup k ⟨s, rfl⟩)]
      exact C.one_mem
    · exact ⟨D.extendedSimpleRep k i, Subgroup.subset_closure ⟨i, rfl⟩, rfl⟩
  rw [eq_top_iff]
  rintro q -
  obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective q
  obtain ⟨n', hn', hval⟩ := hle n.2
  have heq : n' = n := Subtype.ext (Subtype.ext hval)
  rwa [← heq]

/-- **The Tits system of the extended elementary Chevalley subgroup** over an arbitrary field `k`
(including `𝔽₂`), with Borel subgroup `B(k) = U(k) T(k)`, Weyl subgroup `N(k)`, and simple
reflections represented by `n_{αᵢ}(1)`. -/
def titsSystem : TitsSystem (D.extendedElementarySubgroup k) where
  subgroupB := (D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k)
  subgroupN := (D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k)
  closure_subgroupB_union_subgroupN := by
    have hsub : ((D.borelSubgroup k : Set (D.points k)) ∪ D.weylSubgroup k) ⊆
        Set.range (D.extendedElementarySubgroup k).subtype := by
      rw [Subgroup.coe_subtype, Subtype.range_coe_subtype]
      rintro g (hg | hg)
      · exact D.borelSubgroup_le_extendedElementarySubgroup k hg
      · exact D.weylSubgroup_le_extendedElementarySubgroup k hg
    have hpre : (D.extendedElementarySubgroup k).subtype ⁻¹'
        ((D.borelSubgroup k : Set (D.points k)) ∪ D.weylSubgroup k) =
        (((D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k) : Set _) ∪
          ((D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k) : Set _)) := rfl
    rw [← hpre, MonoidHom.closure_preimage_eq_of_injective _
      (D.extendedElementarySubgroup k).subtype_injective hsub, Subgroup.closure_union,
      Subgroup.closure_eq, Subgroup.closure_eq,
      D.borelSubgroup_sup_weylSubgroup_eq_extendedElementarySubgroup k, Subgroup.comap_subtype,
      Subgroup.subgroupOf_self]
  intersection_normal := inferInstance
  simple := Set.range fun i : Fin t.rank => QuotientGroup.mk (D.extendedSimpleRep k i)
  closure_simple := D.closure_range_mk_extendedSimpleRep k
  exists_simpleRep_mul_self_mem s hs := by
    obtain ⟨i, rfl⟩ := hs
    refine ⟨D.extendedSimpleRep k i, rfl, ?_⟩
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_subgroupOf, Subgroup.coe_mul, Subgroup.coe_mul]
    have hmul : (((D.extendedSimpleRep k i : D.extendedElementarySubgroup k) : D.points k) *
        ((D.extendedSimpleRep k i : D.extendedElementarySubgroup k) : D.points k)) =
        D.simpleCorootPoints i k (-1) := D.weylElement_mul_self i k
    rw [hmul, D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup k ⟨_, rfl⟩
  mul_doubleCoset_subset s hs := by
    obtain ⟨i, rfl⟩ := hs
    refine ⟨D.extendedSimpleRep k i, rfl, fun w z hz => ?_⟩
    obtain ⟨z₁, hz₁, z₂, hz₂, rfl⟩ := Set.mem_mul.mp hz
    rw [D.mem_doubleCoset_subgroupOf_extendedElementarySubgroup_iff k] at hz₁ hz₂
    let n : D.weylSubgroup k := ⟨((w : D.extendedElementarySubgroup k) : D.points k), w.2⟩
    have hprod : ((z₁ * z₂ : D.extendedElementarySubgroup k) : D.points k) ∈
        DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1)
          (D.borelSubgroup k) (D.borelSubgroup k) *
        DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) :=
      Set.mul_mem_mul hz₁ hz₂
    by_cases hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k n)⁻¹
        (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)
    · rw [D.doubleCoset_weylElement_mul_eq_of_mem_posRoots k i n hpos] at hprod
      exact Or.inl ((D.mem_doubleCoset_subgroupOf_extendedElementarySubgroup_iff k _ _).mpr hprod)
    · have hneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k n)⁻¹
          (t.simpleIndex ht i) ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
        rwa [mem_negRoots, ← mem_posRoots]
      rw [D.doubleCoset_weylElement_mul_eq_union_of_mem_negRoots k i n hneg] at hprod
      exact hprod.imp
        ((D.mem_doubleCoset_subgroupOf_extendedElementarySubgroup_iff k _ _).mpr)
        ((D.mem_doubleCoset_subgroupOf_extendedElementarySubgroup_iff k _ _).mpr)
  exists_conj_not_mem s hs := by
    obtain ⟨i, rfl⟩ := hs
    obtain ⟨b, hb⟩ := D.exists_weylElement_conj_notMem_borelSubgroup k i
    exact ⟨D.extendedSimpleRep k i, rfl,
      ⟨⟨b.val, D.borelSubgroup_le_extendedElementarySubgroup k b.2⟩, b.2⟩, hb⟩

/-- The `B` subgroup of `D.titsSystem k` is `D.borelSubgroup k` inside
`D.extendedElementarySubgroup k`. -/
@[simp]
theorem titsSystem_subgroupB :
    (D.titsSystem k).subgroupB =
      (D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k) :=
  (rfl)

/-- The `N` subgroup of `D.titsSystem k` is `D.weylSubgroup k` inside
`D.extendedElementarySubgroup k`. -/
@[simp]
theorem titsSystem_subgroupN :
    (D.titsSystem k).subgroupN =
      (D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k) :=
  (rfl)

/-- In `D.titsSystem k`, `B ∩ N` consists of the points of the actual weight-lattice torus. -/
theorem titsSystem_mem_intersection (g : (D.titsSystem k).subgroupN) :
    g ∈ (D.titsSystem k).intersection ↔
      ((g : D.extendedElementarySubgroup k) : D.points k) ∈ (D.torusPoints k).range := by
  have hgN : ((g : D.extendedElementarySubgroup k) : D.points k) ∈ D.weylSubgroup k := by
    simpa only [D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] using g.2
  rw [TitsSystem.mem_intersection, D.titsSystem_subgroupB, Subgroup.mem_subgroupOf,
    ← D.borelSubgroup_inf_weylSubgroup_eq_range_torusPoints k, Subgroup.mem_inf]
  exact (and_iff_left hgN).symm

/-- The pinned representative of the `i`-th simple reflection in `D.titsSystem k`. -/
def titsSystemSimpleRep (i : Fin t.rank) : (D.titsSystem k).subgroupN :=
  D.extendedSimpleRep k i

/-- The underlying point of the `i`-th simple reflection representative is `n_{αᵢ}(1)`. -/
@[simp]
theorem coe_titsSystemSimpleRep (i : Fin t.rank) :
    ((D.titsSystemSimpleRep k i : D.extendedElementarySubgroup k) : D.points k) =
      D.weylElement (t.simpleIndex ht i) k 1 :=
  (rfl)

/-- The simple reflections of `D.titsSystem k` are the classes of `n_{αᵢ}(1)`. -/
@[simp]
theorem titsSystem_simple :
    (D.titsSystem k).simple =
      Set.range fun i : Fin t.rank =>
        (QuotientGroup.mk (D.titsSystemSimpleRep k i) : (D.titsSystem k).WeylGroup) :=
  (rfl)

/-! ## Kernel of `weylProjection` and identification of the Weyl quotients -/

private def titsSystemWeylProjectionHom :
    (D.titsSystem k).WeylGroup →* (t.simplyConnectedRootDatum ht).weylGroup :=
  QuotientGroup.lift (D.titsSystem k).intersection
    ((D.weylProjection k).comp
      (Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup k)).toMonoidHom)
    fun _ hg => D.weylProjection_eq_one_of_mem_borelSubgroup k hg

private theorem titsSystemWeylProjectionHom_mk (g : (D.titsSystem k).subgroupN) :
    D.titsSystemWeylProjectionHom k (QuotientGroup.mk g) =
      D.weylProjection k ⟨((g : D.extendedElementarySubgroup k) : D.points k), g.2⟩ :=
  (rfl)

private theorem titsSystemWeylProjectionHom_simpleRep (i : Fin t.rank) :
    D.titsSystemWeylProjectionHom k (QuotientGroup.mk (D.titsSystemSimpleRep k i)) =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) :=
  D.weylProjection_weylElement k i

/-- If left multiplication by the `i`-th simple reflection increases the Tits-system word length of
`q`, then `(π q)⁻¹ αᵢ` is a positive root; otherwise
`n ∈ (B n_{αᵢ}(1) B)(B n B) = B (n_{αᵢ}(1) n) B` would collapse two distinct Bruhat cells. -/
private theorem mem_posRoots_of_wordLength_lt (i : Fin t.rank) (q : (D.titsSystem k).WeylGroup)
    (hlt : (D.titsSystem k).simpleGenerators.wordLength q <
      (D.titsSystem k).simpleGenerators.wordLength
        (QuotientGroup.mk (D.titsSystemSimpleRep k i) * q)) :
    (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.titsSystemWeylProjectionHom k q)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
  by_contra hnotpos
  have hneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.titsSystemWeylProjectionHom k q)⁻¹
      (t.simpleIndex ht i) ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rwa [mem_negRoots, ← mem_posRoots]
  obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective q
  let s : (D.titsSystem k).WeylGroup := QuotientGroup.mk (D.titsSystemSimpleRep k i)
  have hs : s ∈ (D.titsSystem k).simple := ⟨i, rfl⟩
  have hcell := (D.titsSystem k).bruhatCell_mul_eq_of_wordLength_le hs hlt.le
  let n : D.weylSubgroup k := ⟨((w : D.extendedElementarySubgroup k) : D.points k), w.2⟩
  have hn_dc : (n : D.points k) ∈
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1)
        (D.borelSubgroup k) (D.borelSubgroup k) *
      DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) := by
    rw [D.doubleCoset_weylElement_mul_eq_union_of_mem_negRoots k i n hneg]
    exact Or.inr (DoubleCoset.mem_doubleCoset_self _ _ _)
  obtain ⟨u, hu, v, hv, huv⟩ := Set.mem_mul.mp hn_dc
  have huE : u ∈ D.extendedElementarySubgroup k := by
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hu
    exact mul_mem (mul_mem (D.borelSubgroup_le_extendedElementarySubgroup k hb₁)
      (D.weylSubgroup_le_extendedElementarySubgroup k (D.weylElement_mem_weylSubgroup k i)))
      (D.borelSubgroup_le_extendedElementarySubgroup k hb₂)
  have hvE : v ∈ D.extendedElementarySubgroup k := by
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hv
    exact mul_mem (mul_mem (D.borelSubgroup_le_extendedElementarySubgroup k hb₁) w.1.2)
      (D.borelSubgroup_le_extendedElementarySubgroup k hb₂)
  have hw_mul : (w : D.extendedElementarySubgroup k) ∈
      (D.titsSystem k).bruhatCell s * (D.titsSystem k).bruhatCell (QuotientGroup.mk w) := by
    rw [TitsSystem.bruhatCell_mk, TitsSystem.bruhatCell_mk]
    exact ⟨⟨u, huE⟩, (D.mem_doubleCoset_subgroupOf_extendedElementarySubgroup_iff k _ _).mpr hu,
      ⟨v, hvE⟩, (D.mem_doubleCoset_subgroupOf_extendedElementarySubgroup_iff k _ _).mpr hv,
      Subtype.ext huv⟩
  rw [hcell] at hw_mul
  have hw_self : (w : D.extendedElementarySubgroup k) ∈
      (D.titsSystem k).bruhatCell (QuotientGroup.mk w) := by
    rw [TitsSystem.bruhatCell_mk]
    exact DoubleCoset.mem_doubleCoset_self _ _ _
  have heq := (D.titsSystem k).eq_of_mem_bruhatCell_of_mem hw_mul hw_self
  exact (D.titsSystem k).simple_ne_one hs (mul_right_cancel (heq.trans (one_mul _).symm))

private theorem titsSystemWeylProjectionHom_injective :
    Function.Injective (D.titsSystemWeylProjectionHom k) := by
  rw [injective_iff_map_eq_one]
  intro q hq1
  by_contra hqne
  obtain ⟨l, hl, hlen, hprod⟩ := (D.titsSystem k).exists_prod_eq_of_wordLength q
  cases l with
  | nil =>
    exact hqne (hprod.symm.trans List.prod_nil)
  | cons s l' =>
    have hs : s ∈ (D.titsSystem k).simple := hl s List.mem_cons_self
    rw [D.titsSystem_simple] at hs
    obtain ⟨i, rfl⟩ := hs
    have hl' : ∀ x ∈ l', x ∈ (D.titsSystem k).simple :=
      fun x hx => hl x (List.mem_cons_of_mem _ hx)
    have hlt : (D.titsSystem k).simpleGenerators.wordLength l'.prod <
        (D.titsSystem k).simpleGenerators.wordLength
          (QuotientGroup.mk (D.titsSystemSimpleRep k i) * l'.prod) := by
      have hle := (D.titsSystem k).wordLength_prod_le hl'
      rw [List.prod_cons] at hprod
      rw [hprod, ← hlen, List.length_cons]
      omega
    have hpos := D.mem_posRoots_of_wordLength_lt k i l'.prod hlt
    rw [← hprod, List.prod_cons, map_mul, D.titsSystemWeylProjectionHom_simpleRep k i] at hq1
    have hinv : (D.titsSystemWeylProjectionHom k l'.prod)⁻¹ =
        RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) :=
      (eq_inv_of_mul_eq_one_left hq1).symm
    rw [hinv, RootPairing.weylGroupToPerm_ofIdx_apply,
      ← t.reflectionPerm_rationalRootSystem ht,
      reflectionPerm_self_mem_posRoots_iff_mem_negRoots, mem_negRoots, ← mem_posRoots] at hpos
    exact hpos (simpleIndex_mem_posRoots i)

private theorem titsSystemWeylProjectionHom_surjective :
    Function.Surjective (D.titsSystemWeylProjectionHom k) := by
  intro w
  obtain ⟨g, rfl⟩ := D.weylProjection_surjective k w
  exact ⟨QuotientGroup.mk
    ⟨⟨g.val, D.weylSubgroup_le_extendedElementarySubgroup k g.2⟩, g.2⟩, rfl⟩

/-- **The Weyl group of `D.titsSystem k` is the Weyl group of the root datum.** -/
def titsSystemWeylGroupMulEquiv :
    (D.titsSystem k).WeylGroup ≃* (t.simplyConnectedRootDatum ht).weylGroup :=
  MulEquiv.ofBijective (D.titsSystemWeylProjectionHom k)
    ⟨D.titsSystemWeylProjectionHom_injective k, D.titsSystemWeylProjectionHom_surjective k⟩

/-- The Weyl-group equivalence acts on classes in `N(k)` via `D.weylProjection k`. -/
@[simp]
theorem titsSystemWeylGroupMulEquiv_mk (g : (D.titsSystem k).subgroupN) :
    D.titsSystemWeylGroupMulEquiv k (QuotientGroup.mk g) =
      D.weylProjection k ⟨((g : D.extendedElementarySubgroup k) : D.points k), by
        simpa only [D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] using g.2⟩ :=
  (rfl)

/-- The `i`-th simple reflection of `D.titsSystem k` maps to the `i`-th simple reflection of the
root datum's Weyl group. -/
theorem titsSystemWeylGroupMulEquiv_simpleRep (i : Fin t.rank) :
    D.titsSystemWeylGroupMulEquiv k (QuotientGroup.mk (D.titsSystemSimpleRep k i)) =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) :=
  D.weylProjection_weylElement k i

/-- Under `D.titsSystemWeylGroupMulEquiv k`, the simple reflections of `D.titsSystem k` correspond
to the simple reflections of `(t.simplyConnectedRootDatum ht).weylGroup`. -/
theorem titsSystem_simple_eq_preimage :
    (D.titsSystem k).simple =
      D.titsSystemWeylGroupMulEquiv k ⁻¹'
        Set.range fun i : Fin t.rank =>
          RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  ext q
  simp only [D.titsSystem_simple, Set.mem_range, Set.mem_preimage]
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i, (D.titsSystemWeylGroupMulEquiv_simpleRep k i).symm⟩
  · rintro ⟨i, hi⟩
    exact ⟨i, (D.titsSystemWeylGroupMulEquiv k).injective
      ((D.titsSystemWeylGroupMulEquiv_simpleRep k i).trans hi)⟩

/-- **The kernel of `D.weylProjection k` is the actual weight-lattice torus** inside
`D.weylSubgroup k`, over every field `k`. -/
@[simp]
theorem ker_weylProjection :
    (D.weylProjection k).ker = ((D.torusPoints k).range).subgroupOf (D.weylSubgroup k) := by
  apply le_antisymm
  · intro g hg
    let gN : (D.titsSystem k).subgroupN :=
      ⟨⟨g.val, D.weylSubgroup_le_extendedElementarySubgroup k g.2⟩, g.2⟩
    have hmk : (QuotientGroup.mk gN : (D.titsSystem k).WeylGroup) = 1 :=
      (D.titsSystemWeylProjectionHom_injective k)
        ((D.titsSystemWeylProjectionHom_mk k gN).trans (hg.trans (map_one _).symm))
    exact (D.titsSystem_mem_intersection k gN).mp ((QuotientGroup.eq_one_iff gN).mp hmk)
  · rintro g ⟨s, hs⟩
    have hsub : g = ⟨D.torusPoints k s, D.torusPoints_mem_weylSubgroup k s⟩ :=
      Subtype.ext hs.symm
    rw [MonoidHom.mem_ker, hsub, D.weylProjection_torusPoints]

/-- An element of `D.weylSubgroup k` has trivial Weyl projection if and only if it belongs to the
actual weight-lattice torus. -/
theorem weylProjection_eq_one_iff_mem_range_torusPoints (g : D.weylSubgroup k) :
    D.weylProjection k g = 1 ↔ (g : D.points k) ∈ (D.torusPoints k).range := by
  rw [← MonoidHom.mem_ker, D.ker_weylProjection k, Subgroup.mem_subgroupOf]

/-- **The Weyl quotient `N(k) ⧸ T(k)` is canonically isomorphic to the root datum's Weyl group**
over every field `k`. -/
def weylQuotientMulEquiv :
    D.weylSubgroup k ⧸ ((D.torusPoints k).range).subgroupOf (D.weylSubgroup k) ≃*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  QuotientGroup.liftEquiv _ (D.weylProjection_surjective k) (D.ker_weylProjection k).symm

/-- The Weyl-quotient isomorphism sends the coset of `g ∈ N(k)` to `D.weylProjection k g`. -/
@[simp]
theorem weylQuotientMulEquiv_mk (g : D.weylSubgroup k) :
    D.weylQuotientMulEquiv k (QuotientGroup.mk g) = D.weylProjection k g :=
  (rfl)

/-! ## The Tits system of the elementary Chevalley subgroup -/

private theorem exists_inclusion_mul_mem_inf (g : D.extendedElementarySubgroup k) :
    ∃ x : D.elementarySubgroup k,
      ∃ t₀ ∈ (D.titsSystem k).subgroupB ⊓ (D.titsSystem k).subgroupN,
        Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup k) x * t₀ = g := by
  obtain ⟨e, he, s, hes⟩ := (D.mem_extendedElementarySubgroup_iff k g.val).mp g.2
  refine ⟨⟨e, he⟩, ⟨D.torusPoints k s, D.torusPoints_mem_extendedElementarySubgroup k s⟩,
    ⟨D.range_torusPoints_le_borelSubgroup k ⟨s, rfl⟩, D.torusPoints_mem_weylSubgroup k s⟩,
    Subtype.ext hes⟩

/-- **The Tits system of the elementary Chevalley subgroup** `D.elementarySubgroup k` over any
field `k`, obtained by pulling `D.titsSystem k` back along the inclusion into
`D.extendedElementarySubgroup k`. -/
def elementaryTitsSystem : TitsSystem (D.elementarySubgroup k) :=
  (D.titsSystem k).comap
    (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup k))
    (D.exists_inclusion_mul_mem_inf k)

/-- The `B` subgroup of `D.elementaryTitsSystem k` is `D.borelSubgroup k` intersected with
`D.elementarySubgroup k`. -/
@[simp]
theorem elementaryTitsSystem_subgroupB :
    (D.elementaryTitsSystem k).subgroupB =
      (D.borelSubgroup k).subgroupOf (D.elementarySubgroup k) := by
  rw [elementaryTitsSystem, TitsSystem.comap_subgroupB, D.titsSystem_subgroupB,
    Subgroup.comap_inclusion_subgroupOf]

/-- The `N` subgroup of `D.elementaryTitsSystem k` is `D.weylSubgroup k` intersected with
`D.elementarySubgroup k`. -/
@[simp]
theorem elementaryTitsSystem_subgroupN :
    (D.elementaryTitsSystem k).subgroupN =
      (D.weylSubgroup k).subgroupOf (D.elementarySubgroup k) := by
  rw [elementaryTitsSystem, TitsSystem.comap_subgroupN, D.titsSystem_subgroupN,
    Subgroup.comap_inclusion_subgroupOf]

/-- **The Weyl group of `D.elementaryTitsSystem k` is the Weyl group of the root datum.** -/
def elementaryTitsSystemWeylGroupMulEquiv :
    (D.elementaryTitsSystem k).WeylGroup ≃* (t.simplyConnectedRootDatum ht).weylGroup :=
  ((D.titsSystem k).comapWeylGroupMulEquiv _ _).trans (D.titsSystemWeylGroupMulEquiv k)

/-- The Weyl-group equivalence of `D.elementaryTitsSystem k` acts on classes via
`D.weylProjection k`. -/
@[simp]
theorem elementaryTitsSystemWeylGroupMulEquiv_mk
    (g : (D.elementaryTitsSystem k).subgroupN) :
    D.elementaryTitsSystemWeylGroupMulEquiv k (QuotientGroup.mk g) =
      D.weylProjection k ⟨((g : D.elementarySubgroup k) : D.points k), by
        simpa only [D.elementaryTitsSystem_subgroupN, Subgroup.mem_subgroupOf] using g.2⟩ :=
  congrArg (D.titsSystemWeylGroupMulEquiv k)
    ((D.titsSystem k).comapWeylGroupMulEquiv_mk _ (D.exists_inclusion_mul_mem_inf k) g)

/-- The pinned representative of the `i`-th simple reflection in `D.elementaryTitsSystem k`. -/
def elementaryTitsSystemSimpleRep (i : Fin t.rank) : (D.elementaryTitsSystem k).subgroupN :=
  ⟨⟨D.weylElement (t.simpleIndex ht i) k 1,
    D.weylElement_mem_elementarySubgroup k (t.simpleIndex ht i) 1⟩, by
    rw [D.elementaryTitsSystem_subgroupN, Subgroup.mem_subgroupOf]
    exact D.weylElement_mem_weylSubgroup k i⟩

/-- The underlying point of the `i`-th elementary simple reflection representative is
`n_{αᵢ}(1)`. -/
@[simp]
theorem coe_elementaryTitsSystemSimpleRep (i : Fin t.rank) :
    ((D.elementaryTitsSystemSimpleRep k i : D.elementarySubgroup k) : D.points k) =
      D.weylElement (t.simpleIndex ht i) k 1 :=
  (rfl)

/-- The `i`-th simple reflection of `D.elementaryTitsSystem k` maps to the `i`-th simple
reflection of the root datum's Weyl group. -/
theorem elementaryTitsSystemWeylGroupMulEquiv_simpleRep (i : Fin t.rank) :
    D.elementaryTitsSystemWeylGroupMulEquiv k
        (QuotientGroup.mk (D.elementaryTitsSystemSimpleRep k i)) =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  rw [D.elementaryTitsSystemWeylGroupMulEquiv_mk]
  exact D.weylProjection_weylElement k i

/-- Under `D.elementaryTitsSystemWeylGroupMulEquiv k`, the simple reflections of
`D.elementaryTitsSystem k` correspond to the simple reflections of
`(t.simplyConnectedRootDatum ht).weylGroup`. -/
theorem elementaryTitsSystem_simple_eq_preimage :
    (D.elementaryTitsSystem k).simple =
      D.elementaryTitsSystemWeylGroupMulEquiv k ⁻¹'
        Set.range fun i : Fin t.rank =>
          RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  have h := (D.titsSystem k).comap_simple _ (D.exists_inclusion_mul_mem_inf k)
  rw [D.titsSystem_simple_eq_preimage k, ← Set.preimage_comp] at h
  exact h

/-- The simple reflections of `D.elementaryTitsSystem k` are the classes of `n_{αᵢ}(1)`. -/
@[simp]
theorem elementaryTitsSystem_simple :
    (D.elementaryTitsSystem k).simple =
      Set.range fun i : Fin t.rank =>
        (QuotientGroup.mk (D.elementaryTitsSystemSimpleRep k i) :
          (D.elementaryTitsSystem k).WeylGroup) := by
  rw [D.elementaryTitsSystem_simple_eq_preimage k]
  ext q
  simp only [Set.mem_preimage, Set.mem_range]
  constructor
  · rintro ⟨i, hi⟩
    exact ⟨i, (D.elementaryTitsSystemWeylGroupMulEquiv k).injective
      ((D.elementaryTitsSystemWeylGroupMulEquiv_simpleRep k i).trans hi)⟩
  · rintro ⟨i, rfl⟩
    exact ⟨i, (D.elementaryTitsSystemWeylGroupMulEquiv_simpleRep k i).symm⟩

/-- Membership in a Bruhat cell of `D.titsSystem k` coincides with membership in the corresponding
`D.borelSubgroup k` double coset inside `D.points k`. -/
theorem titsSystem_mem_bruhatCell_mk (n : (D.titsSystem k).subgroupN)
    (g : D.extendedElementarySubgroup k) :
    g ∈ (D.titsSystem k).bruhatCell (QuotientGroup.mk n) ↔
      (g : D.points k) ∈ DoubleCoset.doubleCoset
        ((n : D.extendedElementarySubgroup k) : D.points k)
        (D.borelSubgroup k) (D.borelSubgroup k) := by
  rw [TitsSystem.bruhatCell_mk, D.titsSystem_subgroupB]
  exact D.mem_doubleCoset_subgroupOf_extendedElementarySubgroup_iff k n g

/-- In `D.elementaryTitsSystem k`, `B ∩ N` consists of those elements of `N ∩ E_D(k)` that lie in
the actual weight-lattice torus `T(k)`. -/
theorem elementaryTitsSystem_mem_intersection (g : (D.elementaryTitsSystem k).subgroupN) :
    g ∈ (D.elementaryTitsSystem k).intersection ↔
      ((g : D.elementarySubgroup k) : D.points k) ∈ (D.torusPoints k).range := by
  have hgN : ((g : D.elementarySubgroup k) : D.points k) ∈ D.weylSubgroup k := by
    simpa only [D.elementaryTitsSystem_subgroupN, Subgroup.mem_subgroupOf] using g.2
  rw [TitsSystem.mem_intersection, D.elementaryTitsSystem_subgroupB, Subgroup.mem_subgroupOf,
    ← D.borelSubgroup_inf_weylSubgroup_eq_range_torusPoints k, Subgroup.mem_inf]
  exact (and_iff_left hgN).symm

/-- Membership in a Bruhat cell of `D.elementaryTitsSystem k` coincides with membership in the
corresponding `D.borelSubgroup k` double coset inside `D.points k`, even when `D.torusPoints k` is
larger than its intersection with `D.elementarySubgroup k`. -/
theorem elementaryTitsSystem_mem_bruhatCell_mk (n : (D.elementaryTitsSystem k).subgroupN)
    (g : D.elementarySubgroup k) :
    g ∈ (D.elementaryTitsSystem k).bruhatCell (QuotientGroup.mk n) ↔
      (g : D.points k) ∈ DoubleCoset.doubleCoset
        ((n : D.elementarySubgroup k) : D.points k)
        (D.borelSubgroup k) (D.borelSubgroup k) := by
  have hcell : g ∈ (D.elementaryTitsSystem k).bruhatCell (QuotientGroup.mk n) ↔
      Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup k) g ∈
        (D.titsSystem k).bruhatCell
          ((D.titsSystem k).comapWeylGroupMulEquiv _ (D.exists_inclusion_mul_mem_inf k)
            (QuotientGroup.mk n)) :=
    Set.ext_iff.mp ((D.titsSystem k).comap_bruhatCell _ (D.exists_inclusion_mul_mem_inf k)
      (QuotientGroup.mk n)) g
  have hmk := (D.titsSystem k).comapWeylGroupMulEquiv_mk _ (D.exists_inclusion_mul_mem_inf k) n
  rw [hcell, hmk, D.titsSystem_mem_bruhatCell_mk]
  rfl

end Field

end TauCeti.DynkinType.ChevalleyDatum
