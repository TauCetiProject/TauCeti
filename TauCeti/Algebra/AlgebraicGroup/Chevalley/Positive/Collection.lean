module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.G2
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2

/-!
# Ordered positive-root products for Chevalley data

For every valid Dynkin type and every Chevalley datum `D`, each element of the positive-root
subgroup `D.positiveSubgroup A` (and hence of `D.positivePoints A`) is a product with one factor
from each positive root subgroup, in any enumeration of the positive roots without repetition.
This holds over every commutative ring without characteristic or reducedness restrictions. It
supplies the existence half of Steinberg's positive-root normal form, and yields an ordered
two-factor decomposition `U_S * U_{Φ⁺ \ S}` for any subset `S` of positive roots by enumerating
`S` before its complement.

Outside type `G₂`, `(t.rationalRootSystem ht).IsNotG2` holds by
`TauCeti.DynkinType.isNotG2_rationalRootSystem_of_ne_G2`, so collection reduces to
`TauCeti.DynkinType.mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod`. In type `G₂`,
collection reduces to `TauCeti.DynkinType.mem_biSup_posRoots_g2_iff_exists_list_prod_map`.

## Main declarations

* `TauCeti.DynkinType.ChevalleyDatum.mem_positiveSubgroup_iff_exists_prod`: ordered positive-root
  collection on the admissible lattice over any commutative `ℤ`-algebra.
* `TauCeti.DynkinType.ChevalleyDatum.mem_positivePoints_iff_exists_prod`: ordered positive-root
  collection on the datum's point group over any commutative ring.
* `TauCeti.DynkinType.ChevalleyDatum.mem_positivePoints_iff_exists_mul_mem_iSup_diff`: every
  positive point factors into the subgroup generated by a subset `S ⊆ Φ⁺` followed by the subgroup
  generated by `Φ⁺ \ S`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.3.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

attribute [local instance high] Algebra.toModule

private theorem mem_positiveSubgroup_iff_exists_prod_G2 {ht : G2.Valid} (D : ChevalleyDatum G2 ht)
    (l : List (Fin G2.numRoots)) (hl : l.Nodup)
    (hcover : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht))
    (A : CommAlgCat.{v} ℤ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)) :
    g ∈ D.positiveSubgroup A ↔ ∃ u : Fin G2.numRoots → Multiplicative A,
      (l.map fun γ => chevalleyRootSubgroup D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A (u γ)).prod =
        g := by
  let X := fun γ => chevalleyRootSubgroup D.representation D.lattice
    D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A
  have hlt : ∀ x : {γ // γ ∈ l}, x.1.val < 6 := fun x =>
    (mem_posRoots_rational_g2_iff ht x.1).mp ((hcover x.1).mp x.2)
  let toFin6 : {γ // γ ∈ l} → Fin 6 := fun x => ⟨x.1.val, hlt x⟩
  let l₆ : List (Fin 6) := l.attach.map toFin6
  have hl₆ : l₆.Nodup :=
    hl.attach.map fun _ _ hab => Subtype.ext (Fin.ext (congrArg (Fin.val (n := 6)) hab))
  have hlall : ∀ i : Fin 6, i ∈ l₆ := fun i =>
    List.mem_map.mpr ⟨⟨Fin.castAdd 6 i,
      (hcover _).mpr ((mem_posRoots_rational_g2_iff ht _).mpr i.isLt)⟩,
      List.mem_attach _ _, Fin.ext rfl⟩
  rw [D.positiveSubgroup_eq_iSup, mem_biSup_posRoots_g2_iff_exists_list_prod_map
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator A l₆ hl₆ hlall g]
  constructor
  · rintro ⟨f, hf⟩
    let u : Fin G2.numRoots → Multiplicative A := fun γ =>
      if h : γ.val < 6 then Multiplicative.ofAdd (f ⟨γ.val, h⟩) else 1
    refine ⟨u, ?_⟩
    have hmap : (l₆.map fun i => X (Fin.castAdd 6 i) (Multiplicative.ofAdd (f i))) =
        l.map fun γ => X γ (u γ) := by
      rw [List.map_map, ← List.attach_map_val (f := fun γ => X γ (u γ))]
      refine List.map_congr_left fun x _ => ?_
      have hx : Fin.castAdd 6 (toFin6 x) = x.1 := Fin.ext rfl
      simp only [Function.comp_apply, hx, u, hlt x, ↓reduceDIte, toFin6, X]
    exact hmap ▸ hf
  · rintro ⟨u, rfl⟩
    refine ⟨fun i => (u (Fin.castAdd 6 i)).toAdd, ?_⟩
    rw [List.map_map, ← List.attach_map_val (f := fun γ => X γ (u γ))]
    refine congrArg List.prod (List.map_congr_left fun x _ => ?_)
    have hx : Fin.castAdd 6 (toFin6 x) = x.1 := Fin.ext rfl
    simp only [Function.comp_apply, hx, ofAdd_toAdd, X]

/-- Every element of the positive subgroup of a Chevalley datum has an ordered positive-root
product expression. The list enumerates all positive roots without repetition in any chosen order,
over an arbitrary commutative value ring. -/
theorem mem_positiveSubgroup_iff_exists_prod
    (l : List (Fin t.numRoots)) (hl : l.Nodup)
    (hcover : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : CommAlgCat.{v} ℤ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)) :
    g ∈ D.positiveSubgroup A ↔ ∃ u : Fin t.numRoots → Multiplicative A,
      (l.map fun γ => chevalleyRootSubgroup D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A (u γ)).prod =
        g := by
  by_cases hG2 : t = G2
  · subst hG2
    exact mem_positiveSubgroup_iff_exists_prod_G2 D l hl hcover A g
  · have : (t.rationalRootSystem ht).IsNotG2 :=
      t.isNotG2_rationalRootSystem_of_ne_G2 hG2
    rw [D.positiveSubgroup_eq_iSup,
      mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod
        D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator A l hl hcover g]
    constructor
    · rintro ⟨u, rfl⟩
      exact ⟨fun γ => Multiplicative.ofAdd (u γ), rfl⟩
    · rintro ⟨u, rfl⟩
      exact ⟨fun γ => (u γ).toAdd, by simp only [ofAdd_toAdd]⟩

/-- On datum points, every element of `D.positivePoints A` is an ordered product with one factor
from each positive root subgroup in any duplicate-free enumeration of the positive roots. -/
theorem mem_positivePoints_iff_exists_prod (A : Type v) [CommRing A]
    (l : List (Fin t.numRoots)) (hl : l.Nodup)
    (hcover : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (g : D.points A) :
    g ∈ D.positivePoints A ↔ ∃ u : Fin t.numRoots → Multiplicative A,
      (l.map fun γ => D.rootSubgroupPoints γ A (u γ)).prod = g := by
  constructor
  · intro hg
    obtain ⟨x, hx, hgx⟩ := D.mem_positivePoints_iff.mp hg
    obtain ⟨u, rfl⟩ :=
      (D.mem_positiveSubgroup_iff_exists_prod l hl hcover (CommAlgCat.of ℤ A) x).mp hx
    refine ⟨u, (D.points A).subtype_injective ?_⟩
    simpa only [map_list_prod, List.map_map, Function.comp_def, Subgroup.coe_subtype,
      D.coe_rootSubgroupPoints] using hgx
  · rintro ⟨u, rfl⟩
    refine Subgroup.list_prod_mem _ ?_
    intro x hx
    obtain ⟨γ, hγ, rfl⟩ := List.mem_map.mp hx
    exact D.rootSubgroupPoints_mem_positivePoints A ((hcover γ).mp hγ) (u γ)

/-- For any subset `S` of positive roots, every element of `D.positivePoints A` factors as an
element generated by the root subgroups in `S` followed by an element generated by the root
subgroups in `Φ⁺ \ S`. -/
theorem mem_positivePoints_iff_exists_mul_mem_iSup_diff (A : Type v) [CommRing A]
    {S : Set (Fin t.numRoots)}
    (hS : S ⊆ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ u₁ ∈ (⨆ γ ∈ S, (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
        ∃ u₂ ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ S,
            (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
          u₁ * u₂ = g := by
  classical
  constructor
  · intro hg
    let P := posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht)
    let l₁ := {γ ∈ P | γ ∈ S}.toList
    let l₂ := {γ ∈ P | γ ∉ S}.toList
    have hdisj : l₁.Disjoint l₂ := by
      intro γ h₁ h₂
      simp only [l₁, l₂, Finset.mem_toList, Finset.mem_filter] at h₁ h₂
      exact h₂.2 h₁.2
    have hl : (l₁ ++ l₂).Nodup :=
      (Finset.nodup_toList _).append (Finset.nodup_toList _) hdisj
    have hcover : ∀ γ, γ ∈ l₁ ++ l₂ ↔
        γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      intro γ
      simp only [l₁, l₂, P, List.mem_append, Finset.mem_toList, Finset.mem_filter,
        mem_posRootsFinset]
      exact ⟨fun h => h.elim And.left And.left, fun h =>
        if hγS : γ ∈ S then Or.inl ⟨h, hγS⟩ else Or.inr ⟨h, hγS⟩⟩
    obtain ⟨u, rfl⟩ := (D.mem_positivePoints_iff_exists_prod A (l₁ ++ l₂) hl hcover g).mp hg
    rw [List.map_append, List.prod_append]
    refine ⟨_, Subgroup.list_prod_mem _ ?_, _, Subgroup.list_prod_mem _ ?_, rfl⟩
    · intro x hx
      obtain ⟨γ, hγ, rfl⟩ := List.mem_map.mp hx
      simp only [l₁, Finset.mem_toList, Finset.mem_filter] at hγ
      exact (le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ hγ.2) ⟨u γ, rfl⟩
    · intro x hx
      obtain ⟨γ, hγ, rfl⟩ := List.mem_map.mp hx
      simp only [l₂, P, Finset.mem_toList, Finset.mem_filter, mem_posRootsFinset] at hγ
      exact (le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ hγ) ⟨u γ, rfl⟩
  · rintro ⟨u₁, hu₁, u₂, hu₂, rfl⟩
    have hle₁ : (⨆ γ ∈ S, (D.rootSubgroupPoints γ A).range) ≤ D.positivePoints A := by
      refine iSup₂_le fun γ hγ => ?_
      rintro _ ⟨u, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints A (hS hγ) u
    have hle₂ : (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ S,
        (D.rootSubgroupPoints γ A).range) ≤ D.positivePoints A := by
      refine iSup₂_le fun γ hγ => ?_
      rintro _ ⟨u, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints A hγ.1 u
    exact (D.positivePoints A).mul_mem (hle₁ hu₁) (hle₂ hu₂)

end TauCeti.DynkinType.ChevalleyDatum
