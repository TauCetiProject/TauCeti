module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
public import TauCeti.GroupTheory.Subgroup.OrderedProduct
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Commutator.SimplyLaced
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Commutator.Basic
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.WeightDegree

/-!
# Height-ordered positive-root products in simply laced types

For a simply laced Chevalley datum, every element of the positive-root subgroup is a product
with one factor from each positive root subgroup, in any enumeration of nondecreasing height.
This works on the admissible lattice over every commutative value ring. It is the existence
part of positive-root coordinates, not their uniqueness or a point-generation theorem for the
whole Chevalley group.

The simply laced commutator formula puts the commutator of two positive root elements in the
root group at their sum, when that sum is a root. Its height is greater than either original
height. Consequently each root group normalizes the subgroup generated by all later root groups,
and `Subgroup.mem_iSup_list_iff_exists_prod` collects the factors in the chosen order.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17.
* R. W. Carter, *Simple Groups of Lie Type*, §5.3.
-/

public section

open scoped commutatorElement
open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid}

private theorem root_sum_mem_positive_suffix (l : List (Fin t.numRoots))
    (hcover : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (horder : l.Pairwise (fun α β =>
      (t.rationalBase ht).height α ≤ (t.rationalBase ht).height β))
    (p : List (Fin t.numRoots)) (i : Fin t.numRoots) (s : List (Fin t.numRoots))
    (heq : l = p ++ i :: s) {j k : Fin t.numRoots} (hj : j ∈ s)
    (hk : (t.simplyConnectedRootDatum ht).root k =
      (t.simplyConnectedRootDatum ht).root i + (t.simplyConnectedRootDatum ht).root j) :
    k ∈ s := by
  have hi := (hcover i).mp (heq ▸ List.mem_append_right p (List.mem_cons_self ..))
  have hjpos := (hcover j).mp (heq ▸ List.mem_append_right p (List.mem_cons_of_mem i hj))
  have hheight : (t.rationalBase ht).height k =
      (t.rationalBase ht).height i + (t.rationalBase ht).height j := by
    have h := congrArg (t.weightDegree ht) hk
    simp only [map_add, weightDegree_root] at h
    exact_mod_cast h
  have hhi := one_le_height_of_mem_posRoots _ _ hi
  have hhj := one_le_height_of_mem_posRoots _ _ hjpos
  have hkpos : k ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [mem_posRoots, RootPairing.Base.isPos_iff]
    omega
  have hsplit : l = (p ++ [i]) ++ s := by
    simpa only [List.append_assoc, List.singleton_append] using heq
  have hbefore := (List.pairwise_append.mp (hsplit ▸ horder)).2.2
  have hkl := (hcover k).mpr hkpos
  rw [hsplit, List.mem_append] at hkl
  rcases hkl with hkp | hks
  · have hle := hbefore k hkp j hj
    omega
  · exact hks

variable (D : ChevalleyDatum t ht)

attribute [local instance high] Algebra.toModule

private theorem range_root_normalizes_positive_suffix (hs : t.IsSimplyLaced)
    (l : List (Fin t.numRoots))
    (hcover : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (horder : l.Pairwise (fun α β =>
      (t.rationalBase ht).height α ≤ (t.rationalBase ht).height β))
    (A : CommAlgCat.{v} ℤ) (p : List (Fin t.numRoots)) (i : Fin t.numRoots)
    (s : List (Fin t.numRoots)) (heq : l = p ++ i :: s) :
    let X := fun γ => chevalleyRootSubgroup D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A
    (X i).range ≤ Subgroup.normalizer (⨆ j ∈ s, (X j).range : Subgroup _) := by
  classical
  dsimp only
  let X := fun γ => chevalleyRootSubgroup D.representation D.lattice
    D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A
  have hjoin : (⨆ γ ∈ s, (X γ).range) =
      Subgroup.closure (⋃ γ ∈ s, Set.range (X γ)) := by
    simp only [← MonoidHom.coe_range, Subgroup.closure_iUnion, Subgroup.closure_eq]
  rw [hjoin, Subgroup.le_normalizer_closure_iff]
  rintro _ ⟨u, rfl⟩ _ hj
  obtain ⟨j, hjs, v, rfl⟩ := by simpa only [Set.mem_iUnion, Set.mem_range] using hj
  have hjmem : X j v ∈ Subgroup.closure (⋃ γ ∈ s, Set.range (X γ)) :=
    Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨j,
      Set.mem_iUnion.mpr ⟨hjs, Set.mem_range_self v⟩⟩)
  -- The commutator belongs to a later root group, or is trivial if the sum is not a root.
  have hcomm : ⁅X i u, X j v⁆ ∈ Subgroup.closure (⋃ γ ∈ s, Set.range (X γ)) := by
    by_cases hadd : (t.simplyConnectedRootDatum ht).root i +
        (t.simplyConnectedRootDatum ht).root j ∈ Set.range (t.simplyConnectedRootDatum ht).root
    · obtain ⟨k, hk⟩ := hadd
      have hks := root_sum_mem_positive_suffix l hcover horder p i s heq hjs hk
      have heq := commutatorElement_chevalleyRootSubgroup_of_isSimplyLaced D.representation
        D.lattice D.representation_mem_lattice D.isNilpotent_representation_rootGenerator
        hs hk A u.toAdd v.toAdd
      simp only [ofAdd_toAdd] at heq
      dsimp only [X]
      rw [heq]
      exact Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨k,
        Set.mem_iUnion.mpr ⟨hks, Set.mem_range_self _⟩⟩)
    · have hi := (hcover i).mp (heq ▸ List.mem_append_right p (List.mem_cons_self ..))
      have hjpos := (hcover j).mp (heq ▸ List.mem_append_right p (List.mem_cons_of_mem i hjs))
      have hzero : (t.simplyConnectedRootDatum ht).root i +
          (t.simplyConnectedRootDatum ht).root j ≠ 0 := by
        intro hz
        have h := congrArg (t.weightDegree ht) hz
        have hdi := t.weightDegree_root_pos ht hi
        have hdj := t.weightDegree_root_pos ht hjpos
        simp only [map_add, map_zero] at h
        linarith
      have heq := (commute_chevalleyRootSubgroup D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator
        hadd hzero A u.toAdd v.toAdd).commutator_eq
      simp only [ofAdd_toAdd] at heq
      dsimp only [X]
      rw [heq]
      exact Subgroup.one_mem _
  have hmul := Subgroup.mul_mem _ hcomm hjmem
  simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel, mul_one] using hmul

/-- In simply laced types every element of the positive subgroup has a height-ordered
root-product expression. The list enumerates all positive roots without repetition, in any
order refining their heights; no field or characteristic restriction is needed. -/
theorem mem_positiveSubgroup_iff_exists_prod_of_isSimplyLaced (hs : t.IsSimplyLaced)
    (l : List (Fin t.numRoots)) (hl : l.Nodup)
    (hcover : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (horder : l.Pairwise (fun α β =>
      (t.rationalBase ht).height α ≤ (t.rationalBase ht).height β))
    (A : CommAlgCat.{v} ℤ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)) :
    g ∈ D.positiveSubgroup A ↔ ∃ u : Fin t.numRoots → Multiplicative A,
      (l.map fun γ => chevalleyRootSubgroup D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A (u γ)).prod =
        g := by
  classical
  let X := fun γ => chevalleyRootSubgroup D.representation D.lattice
    D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A
  have hwhole : D.positiveSubgroup A = ⨆ γ ∈ l, (X γ).range := by
    have hjoin : (⨆ γ ∈ l, (X γ).range) =
        Subgroup.closure (⋃ γ ∈ l, Set.range (X γ)) := by
      simp only [← MonoidHom.coe_range, Subgroup.closure_iUnion, Subgroup.closure_eq]
    rw [hjoin, D.positiveSubgroup_eq_closure]
    congr 1
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_range, hcover, X, exists_prop]
  rw [hwhole, Subgroup.mem_iSup_list_iff_exists_prod _ _ hl
    (D.range_root_normalizes_positive_suffix hs l hcover horder A)]
  constructor
  · rintro ⟨f, hf, hprod⟩
    have hchoose : ∀ γ, ∃ u, γ ∈ l → X γ u = f γ := by
      intro γ
      by_cases hγ : γ ∈ l
      · obtain ⟨u, hu⟩ := hf γ hγ
        exact ⟨u, fun _ => hu⟩
      · exact ⟨1, fun h => (hγ h).elim⟩
    choose u hu using hchoose
    refine ⟨u, ?_⟩
    calc
      _ = (l.map f).prod := congrArg List.prod (List.map_congr_left fun γ hγ => hu γ hγ)
      _ = g := hprod
  · rintro ⟨u, hu⟩
    exact ⟨fun γ => X γ (u γ), fun γ _ => ⟨u γ, rfl⟩, hu⟩

end TauCeti.DynkinType.ChevalleyDatum
