module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.Basic
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic

/-!
# Positive-root collection and subset factorizations for Chevalley data

For every valid Dynkin type `t`, every Chevalley datum `D` of type `t`, and every commutative
value ring `A`, each element of `D.positiveSubgroup` or `D.positivePoints` is a product with one
factor from each positive root subgroup, in any duplicate-free enumeration of the positive roots.
This gives the existence part of positive-root coordinates uniformly across all types and
characteristics, without asserting uniqueness of coordinates.

Choosing an enumeration that lists a subset `S ⊆ posRoots` before its complement splits every
positive point as `u₁ * u₂` with `u₁` generated by the root subgroups in `S` and `u₂` generated by
those in `posRoots \ S` (`mem_positivePoints_iff_exists_mul_of_subset`). Specializing `S` to the
punctured positive roots `posRoots \ {αᵢ}` gives the simple-root factorization `U = U⁽ⁱ⁾ Xᵢ` over
every commutative ring, while transporting
`DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton` shows that the opposite
simple-root pair `⟨Xᵢ, X₋ᵢ⟩` (and hence every simple Weyl element `n_{αᵢ}(s)`) normalizes `U⁽ⁱ⁾`.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.mem_positiveSubgroup_iff_exists_prod`: ordered positive-root
  collection on the base-changed admissible lattice, for every valid Dynkin type and commutative
  ring.
* `TauCeti.DynkinType.ChevalleyDatum.mem_positivePoints_iff_exists_prod`: the same ordered
  collection inside `D.points A`.
* `TauCeti.DynkinType.ChevalleyDatum.mem_positivePoints_iff_exists_mul_of_subset`: splitting
  `D.positivePoints A` along an arbitrary subset of positive roots and its complement.
* `TauCeti.DynkinType.ChevalleyDatum.mem_positivePoints_iff_exists_mul_rootSubgroupPoints`:
  simple-root factorization `U = U⁽ⁱ⁾ Xᵢ` for every valid Dynkin type.
* `ChevalleyDatum.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton` and
  `ChevalleyDatum.weylElement_mem_normalizer_positivePoints_diff_singleton`: the opposite
  simple-root pair and every simple Weyl element normalize the punctured positive subgroup `U⁽ⁱ⁾`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17 and proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.3 and 8.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

attribute [local instance high] Algebra.toModule

private theorem positiveSubgroup_eq_biSup (A : CommAlgCat.{v} ℤ) :
    D.positiveSubgroup A =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ A).range := by
  have hjoin :
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ A).range) =
        Subgroup.closure
          (⋃ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
            Set.range (chevalleyRootSubgroup D.representation D.lattice
              D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A)) := by
    simp only [← MonoidHom.coe_range, Subgroup.closure_iUnion, Subgroup.closure_eq]
  rw [hjoin, D.positiveSubgroup_eq_closure]
  congr 1
  ext x
  simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_range, exists_prop]

/-- **Every element of the positive lattice subgroup is an ordered positive-root product.**
The list `l` enumerates all positive roots without repetition, in any chosen order, over an
arbitrary commutative value ring and for every valid Dynkin type. -/
theorem mem_positiveSubgroup_iff_exists_prod
    (l : List (Fin t.numRoots)) (hl : l.Nodup)
    (hcover : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : CommAlgCat.{v} ℤ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)) :
    g ∈ D.positiveSubgroup A ↔ ∃ u : Fin t.numRoots → Multiplicative A,
      (l.map fun γ => chevalleyRootSubgroup D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A (u γ)).prod =
        g := by
  rw [D.positiveSubgroup_eq_biSup A,
    mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator A l hl hcover g]
  constructor
  · rintro ⟨u, hu⟩
    exact ⟨fun γ => Multiplicative.ofAdd (u γ), hu⟩
  · rintro ⟨u, hu⟩
    exact ⟨fun γ => Multiplicative.toAdd (u γ), by simpa only [ofAdd_toAdd] using hu⟩

private noncomputable def pointsToLatticeGL (A : Type v) [CommRing A] :
    D.points A →* LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice) :=
  (Units.mapEquiv
    (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).symm.toMonoidHom.comp
    (D.points A).subtype

private theorem pointsToLatticeGL_injective (A : Type v) [CommRing A] :
    Function.Injective (D.pointsToLatticeGL A) :=
  (Units.mapEquiv
    (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).symm.injective.comp
    (D.points A).subtype_injective

private theorem map_pointsToLatticeGL (A : Type v) [CommRing A] (g : D.points A) :
    Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
        (D.pointsToLatticeGL A g) =
      g.val :=
  (Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).apply_symm_apply
    g.val

private theorem pointsToLatticeGL_rootSubgroupPoints (A : Type v) [CommRing A]
    (γ : Fin t.numRoots) (u : Multiplicative A) :
    D.pointsToLatticeGL A (D.rootSubgroupPoints γ A u) =
      chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) u :=
  (Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).injective
    ((D.map_pointsToLatticeGL A _).trans (D.coe_rootSubgroupPoints γ A u))

private theorem pointsToLatticeGL_comp_rootSubgroupPoints (A : Type v) [CommRing A]
    (γ : Fin t.numRoots) :
    (D.pointsToLatticeGL A).comp (D.rootSubgroupPoints γ A) =
      chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) :=
  MonoidHom.ext (D.pointsToLatticeGL_rootSubgroupPoints A γ)

private theorem mem_positivePoints_iff_pointsToLatticeGL_mem (A : Type v) [CommRing A]
    (g : D.points A) :
    g ∈ D.positivePoints A ↔ D.pointsToLatticeGL A g ∈ D.positiveSubgroup (CommAlgCat.of ℤ A) := by
  rw [D.mem_positivePoints_iff, ← D.map_pointsToLatticeGL A g]
  exact (Units.mapEquiv
    (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).injective.mem_set_image

/-- **Every positive point of a Chevalley datum is an ordered positive-root product.**
The list `l` enumerates all positive roots without repetition, in any order, over an arbitrary
commutative ring `A`. -/
theorem mem_positivePoints_iff_exists_prod
    (l : List (Fin t.numRoots)) (hl : l.Nodup)
    (hcover : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : Type v) [CommRing A] (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ u : Fin t.numRoots → Multiplicative A,
        (l.map fun γ => D.rootSubgroupPoints γ A (u γ)).prod = g := by
  rw [D.mem_positivePoints_iff_pointsToLatticeGL_mem A g,
    D.mem_positiveSubgroup_iff_exists_prod l hl hcover (CommAlgCat.of ℤ A)]
  refine exists_congr fun u => ?_
  rw [← (D.pointsToLatticeGL_injective A).eq_iff, map_list_prod, List.map_map]
  have hmap :
      List.map (D.pointsToLatticeGL A ∘ fun γ => D.rootSubgroupPoints γ A (u γ)) l =
        List.map (fun γ => chevalleyRootSubgroup D.representation D.lattice
          D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ
          (CommAlgCat.of ℤ A) (u γ)) l :=
    List.map_congr_left fun γ _ => D.pointsToLatticeGL_rootSubgroupPoints A γ (u γ)
  rw [hmap]

/-- **Splitting positive points along an arbitrary subset of positive roots.** For any subset
`S ⊆ posRoots`, every positive point factors as `u₁ * u₂` with `u₁` in the subgroup generated by
the root subgroups of `S` and `u₂` in the subgroup generated by those of `posRoots \ S`. -/
theorem mem_positivePoints_iff_exists_mul_of_subset
    {S : Set (Fin t.numRoots)}
    (hS : S ⊆ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : Type v) [CommRing A] (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ u₁ ∈ (⨆ γ ∈ S, (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
        ∃ u₂ ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ S,
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
          u₁ * u₂ = g := by
  classical
  constructor
  · -- Enumerate `S` before `posRoots \ S` so ordered collection splits the product into `u₁ * u₂`.
    intro hg
    let P := posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht)
    let S₁ := P.filter (· ∈ S)
    let S₂ := P.filter (· ∉ S)
    let l₁ := S₁.toList
    let l₂ := S₂.toList
    have hl : (l₁ ++ l₂).Nodup := by
      rw [List.nodup_append]
      refine ⟨S₁.nodup_toList, S₂.nodup_toList, fun x hx₁ y hy₂ hxy => ?_⟩
      subst hxy
      rw [Finset.mem_toList, Finset.mem_filter] at hx₁ hy₂
      exact hy₂.2 hx₁.2
    have hcover : ∀ γ, γ ∈ l₁ ++ l₂ ↔
        γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      intro γ
      simp only [List.mem_append, l₁, l₂, Finset.mem_toList, S₁, S₂, Finset.mem_filter, P,
        mem_posRootsFinset]
      tauto
    obtain ⟨u, rfl⟩ := (D.mem_positivePoints_iff_exists_prod (l₁ ++ l₂) hl hcover A g).mp hg
    rw [List.map_append, List.prod_append]
    refine ⟨_, Subgroup.list_prod_mem _ ?_, _, Subgroup.list_prod_mem _ ?_, rfl⟩
    · intro x hx
      rw [List.mem_map] at hx
      obtain ⟨γ, hγ, rfl⟩ := hx
      rw [Finset.mem_toList, Finset.mem_filter] at hγ
      exact le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ hγ.2 ⟨u γ, rfl⟩
    · intro x hx
      rw [List.mem_map] at hx
      obtain ⟨γ, hγ, rfl⟩ := hx
      rw [Finset.mem_toList, Finset.mem_filter, mem_posRootsFinset] at hγ
      exact le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ hγ ⟨u γ, rfl⟩
  · -- Conversely, both root-subgroup joins lie inside `positivePoints`.
    rintro ⟨u₁, hu₁, u₂, hu₂, rfl⟩
    have hle₁ : (⨆ γ ∈ S, (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) ≤
        D.positivePoints A := by
      refine iSup₂_le fun γ hγ => ?_
      rintro _ ⟨u, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints A (hS hγ) u
    have hle₂ :
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ S,
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) ≤
          D.positivePoints A := by
      refine iSup₂_le fun γ hγ => ?_
      rintro _ ⟨u, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints A hγ.1 u
    exact Subgroup.mul_mem _ (hle₁ hu₁) (hle₂ hu₂)

/-- **Simple-root factorization of positive points.** For every valid Dynkin type and commutative
ring `A`, each positive point factors as a product of a point in the punctured positive subgroup
`U⁽ⁱ⁾` followed by an element of the simple root subgroup `Xᵢ`. -/
theorem mem_positivePoints_iff_exists_mul_rootSubgroupPoints
    (i : Fin t.rank) (A : Type v) [CommRing A] (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ v ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
        ∃ u : Multiplicative A, g = v * D.rootSubgroupPoints (t.simpleIndex ht i) A u := by
  have hdiff :
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
          (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}) =
        {t.simpleIndex ht i} := by
    ext x
    simp only [Set.mem_sdiff, Set.mem_singleton_iff, not_and, not_not]
    exact ⟨fun ⟨hx, h⟩ => h hx, fun h => ⟨h ▸ simpleIndex_mem_posRoots i, fun _ => h⟩⟩
  have hsing :
      (⨆ γ ∈ ({t.simpleIndex ht i} : Set (Fin t.numRoots)),
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) =
        (D.rootSubgroupPoints (t.simpleIndex ht i) A).range :=
    le_antisymm (iSup₂_le fun _ h => Set.mem_singleton_iff.mp h ▸ le_rfl)
      (le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range)
        (t.simpleIndex ht i) (Set.mem_singleton _))
  rw [D.mem_positivePoints_iff_exists_mul_of_subset
    (S := posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
    Set.sdiff_subset A g, hdiff, hsing]
  simp only [MonoidHom.mem_range]
  constructor
  · rintro ⟨v, hv, _, ⟨u, rfl⟩, rfl⟩
    exact ⟨v, hv, u, rfl⟩
  · rintro ⟨v, hv, u, rfl⟩
    exact ⟨v, hv, _, ⟨u, rfl⟩, rfl⟩

/-- **The opposite simple-root pair normalizes the punctured positive subgroup `U⁽ⁱ⁾`** generated
by all positive root subgroups other than `Xᵢ`, over every commutative value ring and for every
valid Dynkin type. -/
theorem closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton
    (i : Fin t.rank) (A : Type v) [CommRing A] :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  let U : Subgroup (D.points A) :=
    ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
      (D.rootSubgroupPoints γ A).range
  have hmap : (Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
      Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) A))).map (D.pointsToLatticeGL A) ≤
      Subgroup.normalizer (U.map (D.pointsToLatticeGL A)) := by
    simpa only [U, Subgroup.closure_union, ← MonoidHom.coe_range, Subgroup.closure_eq,
      Subgroup.map_sup, Subgroup.map_iSup, MonoidHom.map_range,
      D.pointsToLatticeGL_comp_rootSubgroupPoints] using
      DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton
        D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  have hpre := (Subgroup.map_le_iff_le_comap.mp hmap).trans
    ((U.map (D.pointsToLatticeGL A)).le_normalizer_comap (D.pointsToLatticeGL A))
  simpa only [Subgroup.comap_map_eq_self_of_injective (D.pointsToLatticeGL_injective A)] using hpre

/-- **Every simple Weyl element `n_{αᵢ}(s)` normalizes the punctured positive subgroup `U⁽ⁱ⁾`**
generated by all positive root subgroups other than `Xᵢ`, over every commutative value ring. -/
theorem weylElement_mem_normalizer_positivePoints_diff_singleton
    (i : Fin t.rank) (A : Type v) [CommRing A] (s : Aˣ) :
    D.weylElement (t.simpleIndex ht i) A s ∈
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) :=
  D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton i A
    (D.weylElement_mem_closure_rootPair (t.simpleIndex ht i) A s)

end TauCeti.DynkinType.ChevalleyDatum
