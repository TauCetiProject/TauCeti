module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Weight.Blocks
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.WeightDegree
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Elementary.Coordinate

/-!
# Weight-space block unitriangularity of positive Chevalley points

In the weight basis of a Chevalley datum `D`, `orderedWeightBlock (t.weightDegree ht) D.weight`
groups basis indices by their actual Cartan weights, numbered by decreasing height degree. Unlike
an arbitrary linear extension of the basis indices, its fibres are the entire weight spaces, even
when a weight space has dimension greater than one.

Over every commutative ring `A`, each positive root subgroup acts by matrices that are block upper
unitriangular for this weight-block ranking, and hence so does the entire subgroup
`D.positivePoints A` generated by all positive root subgroups. In particular, every positive point
restricts to the identity on each weight space (`D.weight r = D.weight s`). This separates
`D.positivePoints` from operators preserving distinct weight spaces without assuming weight
multiplicity one.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.blockUnitriangular_coe_rootSubgroupPoints_of_mem_posRoots`:
  every positive root element is weight-block upper unitriangular.
* `TauCeti.DynkinType.ChevalleyDatum.blockUnitriangular_coe_of_mem_positivePoints`: every point of
  `D.positivePoints A` is weight-block upper unitriangular.
* `TauCeti.DynkinType.ChevalleyDatum.coe_apply_eq_one_of_mem_positivePoints_of_weight_eq`: every
  positive point agrees with the identity matrix on basis indices of equal Cartan weight.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17, and Chapter 5, Theorem 7.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

-- Match the tensor product with the integral algebra structure on the value ring.
attribute [local instance high] Algebra.toModule

/-- Every positive root element has weight-block upper unitriangular matrix in the datum's weight
basis, over every commutative ring. -/
theorem blockUnitriangular_coe_rootSubgroupPoints_of_mem_posRoots {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (u : Multiplicative A) :
    (((D.rootSubgroupPoints γ A u : Matrix.GeneralLinearGroup (Fin D.dim) A) :
        Matrix (Fin D.dim) (Fin D.dim) A)).BlockUnitriangular
      (orderedWeightBlock (t.weightDegree ht) D.weight) := by
  rw [D.coe_rootSubgroupPoints,
    ← kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ
      (CommAlgCat.of ℤ A),
    basisMatrix_kostantRootSubgroupParam (t.chevalleySystem ht) (t.lieBasis ht).h
      D.representation D.lattice
      (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
      (isNilpotent_apply_ι_chevalleySystem D.representation
        D.isNilpotent_representation_rootGenerator) D.basis A γ u]
  exact blockUnitriangular_kostantRootSubgroupMatrix
    (t.chevalleySystem ht) (t.lieBasis ht).h D.representation D.lattice
    (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
    D.basis D.weight (t.weightDegree ht) γ
    (isNilpotent_apply_ι_chevalleySystem D.representation
      D.isNilpotent_representation_rootGenerator γ)
    D.isCartanWeightVector_basis (t.lie_lieBasis_h_chevalleySystem ht γ)
    (t.weightDegree_root_pos ht hγ) _

/-- Every point of `D.positivePoints A` has weight-block upper unitriangular matrix in the datum's
weight basis, over every commutative ring. -/
theorem blockUnitriangular_coe_of_mem_positivePoints {g : D.points A}
    (hg : g ∈ D.positivePoints A) :
    (((g : Matrix.GeneralLinearGroup (Fin D.dim) A) :
        Matrix (Fin D.dim) (Fin D.dim) A)).BlockUnitriangular
      (orderedWeightBlock (t.weightDegree ht) D.weight) := by
  rw [D.positivePoints_eq_closure A] at hg
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨γ, hγ, u, rfl⟩ := hx
    exact D.blockUnitriangular_coe_rootSubgroupPoints_of_mem_posRoots A hγ u
  | one =>
    simpa only [Subgroup.coe_one, Units.val_one] using Matrix.blockUnitriangular_one
  | mul x y _ _ hx hy =>
    simpa only [Subgroup.coe_mul, Units.val_mul] using hx.mul hy
  | inv x _ hx =>
    have hinv : (((x⁻¹ : D.points A) : Matrix.GeneralLinearGroup (Fin D.dim) A) :
        Matrix (Fin D.dim) (Fin D.dim) A) =
        (((x : Matrix.GeneralLinearGroup (Fin D.dim) A) :
          Matrix (Fin D.dim) (Fin D.dim) A))⁻¹ := by
      rw [Subgroup.coe_inv, Matrix.coe_units_inv]
    rw [hinv]
    exact hx.inv

/-- On basis indices of equal weight, the matrix of any positive point agrees with the identity
matrix. -/
theorem coe_apply_eq_one_of_mem_positivePoints_of_weight_eq {g : D.points A}
    (hg : g ∈ D.positivePoints A) {r s : Fin D.dim} (hrs : D.weight r = D.weight s) :
    (((g : Matrix.GeneralLinearGroup (Fin D.dim) A) :
        Matrix (Fin D.dim) (Fin D.dim) A)) r s =
      (1 : Matrix (Fin D.dim) (Fin D.dim) A) r s :=
  (D.blockUnitriangular_coe_of_mem_positivePoints A hg).apply_of_eq
    ((orderedWeightBlock_eq_iff (t.weightDegree ht) D.weight).mpr hrs)

end TauCeti.DynkinType.ChevalleyDatum
