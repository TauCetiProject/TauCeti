module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Weyl.Root
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Opposite
import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Collection

/-!
# Splitting positive Chevalley points at a Weyl element

The inversion subgroup is generated by the positive roots which a Weyl element sends to
negative roots. For any lift `n` in the Weyl subgroup, it meets the conjugate-positive subgroup
trivially. In simply laced types, every positive point factors uniquely as an inversion point
followed by a positive point whose conjugate by `n` is positive.

This is the positive-subgroup factorization used to select unique representatives in Bruhat
cells. It concerns arbitrary Chevalley data, with their actual character lattices, over every
field. It asserts neither a Bruhat decomposition nor generation of all scheme points.

The proof combines `mem_positiveSubgroup_iff_exists_prod_of_isSimplyLaced`, which permits any
order of the positive roots, with `map_range_rootSubgroupPoints_conj` and the opposite-subgroup
intersection theorem. No uniqueness of individual root parameters is needed.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorems 4 and 4′.
* R. W. Carter, *Simple Groups of Lie Type*, §8.3.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

-- Use the module structure carried by the integer algebra in scalar extensions.
attribute [local instance high] Algebra.toModule

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-- The subgroup generated by the positive roots sent to negative roots by `w`.
The sign test uses the pinned positive system and the native Weyl action. -/
noncomputable def inversionSubgroup (A : Type*) [CommRing A]
    (w : (t.simplyConnectedRootDatum ht).weylGroup) : Subgroup (D.points A) :=
  ⨆ γ ∈ {γ | γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) ∧
    (t.simplyConnectedRootDatum ht).weylGroupToPerm w γ ∈
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht)},
    (D.rootSubgroupPoints γ A).range

/-- The inversion subgroup is generated by the root subgroups at the inversions. -/
theorem inversionSubgroup_def (A : Type*) [CommRing A]
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.inversionSubgroup A w =
      ⨆ γ ∈ {γ | γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) ∧
        (t.simplyConnectedRootDatum ht).weylGroupToPerm w γ ∈
          negRoots (t.rationalRootSystem ht) (t.rationalBase ht)},
        (D.rootSubgroupPoints γ A).range := (rfl)

/-- Every inversion root element lies in the inversion subgroup. -/
theorem rootSubgroupPoints_mem_inversionSubgroup (A : Type*) [CommRing A]
    (w : (t.simplyConnectedRootDatum ht).weylGroup) {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hwγ : (t.simplyConnectedRootDatum ht).weylGroupToPerm w γ ∈
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.inversionSubgroup A w :=
  (le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ ⟨hγ, hwγ⟩) ⟨u, rfl⟩

/-- The inversion subgroup is a subgroup of the positive points. -/
theorem inversionSubgroup_le_positivePoints (A : Type*) [CommRing A]
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.inversionSubgroup A w ≤ D.positivePoints A := by
  rw [D.inversionSubgroup_def]
  refine iSup₂_le fun γ hγ => ?_
  rintro _ ⟨u, rfl⟩
  exact D.rootSubgroupPoints_mem_positivePoints A hγ.1 u

variable (K : Type*) [Field K]

/-- Conjugation by a Weyl lift carries its inversion subgroup into the subgroup generated by
negative roots. This holds in every type, including over finite fields. -/
theorem map_inversionSubgroup_conj_le (n : D.weylSubgroup K) :
    (D.inversionSubgroup K (D.weylProjection K n)).map
        (MulAut.conj (n : D.points K)).toMonoidHom ≤
      ⨆ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (D.rootSubgroupPoints γ K).range := by
  rw [D.inversionSubgroup_def]
  simp only [Subgroup.map_iSup, D.map_range_rootSubgroupPoints_conj]
  exact iSup₂_le fun γ hγ =>
    le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ K).range) _ hγ.2

/-- An inversion point whose conjugate is positive is the identity. No simply laced
hypothesis or positive-root collection theorem is needed for this disjointness. -/
theorem disjoint_inversionSubgroup_comap_positivePoints (n : D.weylSubgroup K) :
    Disjoint (D.inversionSubgroup K (D.weylProjection K n))
      ((D.positivePoints K).comap (MulAut.conj (n : D.points K)).toMonoidHom) := by
  rw [Subgroup.disjoint_def]
  intro x hx hxpos
  apply (MulAut.conj (n : D.points K)).injective
  simpa only [map_one, MulEquiv.coe_toMonoidHom] using
    (Subgroup.disjoint_def.mp (D.disjoint_positivePoints_iSup_negRoots K)) hxpos
      (D.map_inversionSubgroup_conj_le K n ⟨x, hx, rfl⟩)

/-- In simply laced types, a positive point is a product of an inversion point and a positive
point whose conjugate by the specified Weyl lift is positive. The lift is arbitrary. -/
theorem exists_inversionSubgroup_mul_eq_of_mem_positivePoints (hs : t.IsSimplyLaced)
    (n : D.weylSubgroup K) {x : D.points K} (hx : x ∈ D.positivePoints K) :
    ∃ a ∈ D.inversionSubgroup K (D.weylProjection K n),
      ∃ b ∈ D.positivePoints K ⊓
        (D.positivePoints K).comap (MulAut.conj (n : D.points K)).toMonoidHom, a * b = x := by
  classical
  let P := t.rationalRootSystem ht
  let base := t.rationalBase ht
  let w := (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)
  let l := (posRootsFinset P base).toList
  -- Order all inverted roots before all roots whose images stay positive.
  let left := l.filter fun γ => w γ ∈ negRoots P base
  let right := l.filter fun γ => w γ ∉ negRoots P base
  have hl : (left ++ right).Nodup := by
    rw [List.nodup_append]
    refine ⟨List.Nodup.filter _ (Finset.nodup_toList _),
      List.Nodup.filter _ (Finset.nodup_toList _), ?_⟩
    simp only [List.mem_filter, decide_eq_true_eq, left, right]
    intro a ha b hb hab
    subst b
    exact hb.2 ha.2
  have hcover : ∀ γ, γ ∈ left ++ right ↔ γ ∈ posRoots P base := by
    intro γ
    simp only [List.mem_append, List.mem_filter, decide_eq_true_eq, Finset.mem_toList,
      mem_posRootsFinset, left, right, l]
    tauto
  -- Collect on the admissible lattice, then carry the product into the datum's points.
  obtain ⟨y, hy, hyx⟩ := (D.mem_positivePoints_iff).mp hx
  obtain ⟨u, hu⟩ := (D.mem_positiveSubgroup_iff_exists_prod_of_isSimplyLaced hs
    (left ++ right) hl hcover (CommAlgCat.of ℤ K) y).mp hy
  let X := fun γ => D.rootSubgroupPoints γ K (u γ)
  have hprod : ((left ++ right).map X).prod = x := by
    apply (D.points K).subtype_injective
    have hmat := congrArg
      (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange K)).toMonoidHom) hu
    simpa only [map_list_prod, List.map_map, Function.comp_def, X, Subgroup.subtype_apply,
      D.coe_rootSubgroupPoints, MulEquiv.toMonoidHom_eq_coe] using hmat.trans hyx
  -- The two blocks have the required signs before and after conjugation.
  refine ⟨(left.map X).prod, ?_, (right.map X).prod, ⟨?_, ?_⟩, ?_⟩
  · apply Subgroup.list_prod_mem
    intro z hz
    obtain ⟨γ, hγ, rfl⟩ := List.mem_map.mp hz
    have hγ' : γ ∈ posRoots P base ∧ w γ ∈ negRoots P base := by
      simpa only [List.mem_filter, decide_eq_true_eq, Finset.mem_toList,
        mem_posRootsFinset, left, l] using hγ
    exact D.rootSubgroupPoints_mem_inversionSubgroup K _ hγ'.1 hγ'.2 (u γ)
  · apply Subgroup.list_prod_mem
    intro z hz
    obtain ⟨γ, hγ, rfl⟩ := List.mem_map.mp hz
    have hpos := (hcover γ).mp (List.mem_append_right _ hγ)
    exact D.rootSubgroupPoints_mem_positivePoints K hpos (u γ)
  · apply Subgroup.list_prod_mem
    intro z hz
    obtain ⟨γ, hγ, rfl⟩ := List.mem_map.mp hz
    have hkeep : w γ ∈ posRoots P base := by
      have h := (List.mem_filter.mp hγ).2
      simpa only [decide_eq_true_eq, mem_negRoots, not_not, ← mem_posRoots] using h
    obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints K n γ
    simp only [Subgroup.mem_comap, X, MulEquiv.coe_toMonoidHom]
    rw [← ofAdd_toAdd (u γ), hc]
    exact D.rootSubgroupPoints_mem_positivePoints K hkeep _
  · simpa only [List.map_append, List.prod_append] using hprod

/-- In simply laced types the root-generated inversion subgroup is exactly the positive
points whose conjugates by the Weyl lift lie in the negative-root subgroup. -/
theorem inversionSubgroup_eq_inf_comap_negRoots (hs : t.IsSimplyLaced)
    (n : D.weylSubgroup K) :
    D.inversionSubgroup K (D.weylProjection K n) = D.positivePoints K ⊓
      (⨆ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (D.rootSubgroupPoints γ K).range).comap
          (MulAut.conj (n : D.points K)).toMonoidHom := by
  refine le_antisymm
    (le_inf (D.inversionSubgroup_le_positivePoints K _)
      (Subgroup.map_le_iff_le_comap.mp (D.map_inversionSubgroup_conj_le K n))) ?_
  intro x hx
  obtain ⟨a, ha, b, hb, hab⟩ :=
    D.exists_inversionSubgroup_mul_eq_of_mem_positivePoints K hs n hx.1
  let c := (MulAut.conj (n : D.points K)).toMonoidHom
  have ha' := D.map_inversionSubgroup_conj_le K n ⟨a, ha, rfl⟩
  have hb' : c b = (c a)⁻¹ * c x := by
    rw [eq_inv_mul_iff_mul_eq, ← map_mul, hab]
  have hb1 : c b = 1 := Subgroup.disjoint_def.mp
    (D.disjoint_positivePoints_iSup_negRoots K) hb.2
      (hb'.symm ▸ Subgroup.mul_mem _ (Subgroup.inv_mem _ ha') hx.2)
  have hb_eq : b = 1 := (MulAut.conj (n : D.points K)).injective (by
    simpa only [c, MulEquiv.coe_toMonoidHom, map_one] using hb1)
  rw [hb_eq, mul_one] at hab
  exact hab ▸ ha

/-- Multiplication gives unique inversion and conjugate-positive factors for each positive
point in simply laced types. This is a bijection of types, not a direct-product group law. -/
theorem bijective_inversionSubgroup_mul (hs : t.IsSimplyLaced) (n : D.weylSubgroup K) :
    Function.Bijective (fun ab : D.inversionSubgroup K (D.weylProjection K n) ×
        ↥(D.positivePoints K ⊓
          (D.positivePoints K).comap (MulAut.conj (n : D.points K)).toMonoidHom) =>
      (⟨ab.1 * ab.2, (D.positivePoints K).mul_mem
        (D.inversionSubgroup_le_positivePoints K _ ab.1.property) ab.2.property.1⟩ :
          D.positivePoints K)) := by
  constructor
  · intro a b hab
    apply Subgroup.mul_injective_of_disjoint
      ((D.disjoint_inversionSubgroup_comap_positivePoints K n).mono_right inf_le_right)
    exact congrArg Subtype.val hab
  · intro x
    obtain ⟨a, ha, b, hb, hab⟩ :=
      D.exists_inversionSubgroup_mul_eq_of_mem_positivePoints K hs n x.property
    exact ⟨(⟨a, ha⟩, ⟨b, hb⟩), Subtype.ext hab⟩

end TauCeti.DynkinType.ChevalleyDatum
