module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.Algebra.Group.Subgroup.Pointwise
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic.G2

/-!
# Simple-root factorization of positive G₂ points

For either simple root αᵢ of a G₂ Chevalley datum, the subgroup U⁽ⁱ⁾ generated by the
other positive root subgroups is normalized by both Xᵢ and X₋ᵢ. Every positive point
factors as an element of U⁽ⁱ⁾ followed by an element of Xᵢ. This is the local
factorization used in simple-reflection Bruhat reduction, not a claim that the
positive simple root subgroups generate the positive subgroup.

The normalization transports
`DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_G2`
from automorphisms of the admissible lattice to the datum's points. The factorization
then uses `Subgroup.mem_sup_of_right_le_normalizer_left`. Both results hold over every
commutative ring, including characteristics two and three; neither point generation
of the whole scheme nor a unique root-product expression is assumed.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {ht : G2.Valid} (D : ChevalleyDatum G2 ht)
variable (A : Type v) [CommRing A]

-- Match the tensor product with the integral algebra structure on the value ring.
attribute [local instance high] Algebra.toModule

/-- In G₂, the opposite simple-root pair normalizes the subgroup generated by all the
other positive roots, over every commutative value ring. -/
theorem closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton_G2
    (i : Fin G2.rank) :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (G2.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((G2.simplyConnectedRootDatum ht).reflectionPerm
          (G2.simpleIndex ht i) (G2.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer (⨆ γ ∈
        posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht) \ {G2.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  let e := Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
  let f := e.symm.toMonoidHom.comp (D.points A).subtype
  have hf (γ : Fin G2.numRoots) :
      f.comp (D.rootSubgroupPoints γ A) =
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) := by
    apply MonoidHom.ext
    intro u
    apply e.injective
    simp only [f, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.apply_symm_apply, Subgroup.coe_subtype]
    apply Units.ext
    simpa [e] using congrArg Units.val (D.coe_rootSubgroupPoints γ A u)
  have hinj : Function.Injective f := e.symm.injective.comp (D.points A).subtype_injective
  let U : Subgroup (D.points A) := ⨆ γ ∈
    posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht) \ {G2.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range
  have h := DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_G2
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  -- First express both generated subgroups in lattice coordinates. The injective
  -- coordinate map then reflects normalization back into the datum's point group.
  have hmap : (Subgroup.closure
      (Set.range (D.rootSubgroupPoints (G2.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((G2.simplyConnectedRootDatum ht).reflectionPerm
          (G2.simpleIndex ht i) (G2.simpleIndex ht i)) A))).map f ≤
        Subgroup.normalizer (U.map f) := by
    simpa only [U, Subgroup.closure_union, ← MonoidHom.coe_range, Subgroup.closure_eq,
      Subgroup.map_sup, Subgroup.map_iSup, MonoidHom.map_range, hf] using h
  have hpre := (Subgroup.map_le_iff_le_comap.mp hmap).trans
    ((U.map f).le_normalizer_comap f)
  simpa only [Subgroup.comap_map_eq_self_of_injective hinj] using hpre

/-- Every positive G₂ point is a product of a point generated by the other positive roots
and a point of a chosen simple root subgroup. No uniqueness of these factors is asserted. -/
theorem mem_positivePoints_iff_exists_mul_rootSubgroupPoints_G2
    (i : Fin G2.rank) (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ v ∈ (⨆ γ ∈
        posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht) \ {G2.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
        ∃ u : Multiplicative A, g = v * D.rootSubgroupPoints (G2.simpleIndex ht i) A u := by
  classical
  let U : Subgroup (D.points A) := ⨆ γ ∈
    posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht) \ {G2.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range
  have hnorm : (D.rootSubgroupPoints (G2.simpleIndex ht i) A).range ≤
      Subgroup.normalizer U := by
    refine le_trans ?_
      (D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton_G2 A i)
    rintro _ hu
    exact Subgroup.subset_closure (Or.inl hu)
  have hpos : G2.simpleIndex ht i ∈
      posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht) :=
    simpleIndex_mem_posRoots i
  have hwhole : D.positivePoints A =
      U ⊔ (D.rootSubgroupPoints (G2.simpleIndex ht i) A).range := by
    apply le_antisymm
    · apply D.positivePoints_le_iff.mpr
      intro γ hγ u
      by_cases heq : γ = G2.simpleIndex ht i
      · subst γ
        exact (le_sup_right : (D.rootSubgroupPoints (G2.simpleIndex ht i) A).range ≤ _) ⟨u, rfl⟩
      · exact (le_sup_left : U ≤ _) ((le_iSup₂
          (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ ⟨hγ, heq⟩) ⟨u, rfl⟩)
    · apply sup_le
      · refine iSup₂_le fun γ hγ => ?_
        rintro _ ⟨u, rfl⟩
        exact D.rootSubgroupPoints_mem_positivePoints A hγ.1 u
      · rintro _ ⟨u, rfl⟩
        exact D.rootSubgroupPoints_mem_positivePoints A hpos u
  rw [hwhole, Subgroup.mem_sup_of_right_le_normalizer_left hnorm]
  constructor
  · rintro ⟨v, hv, _, ⟨u, rfl⟩, h⟩
    exact ⟨v, hv, u, h.symm⟩
  · rintro ⟨v, hv, u, h⟩
    exact ⟨v, hv, _, ⟨u, rfl⟩, h.symm⟩

end TauCeti.DynkinType.ChevalleyDatum
