module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.Algebra.Group.Subgroup.Pointwise
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic

/-!
# Simple-root factorization of positive Chevalley points

For any valid Dynkin type and any simple root `αᵢ` of a Chevalley datum `D`, let `U⁽ⁱ⁾` be the
subgroup of `D.points A` generated by all positive root subgroups other than `X_{αᵢ}`. This file
shows that `U⁽ⁱ⁾` is normalized by the opposite simple-root pair `(X_{αᵢ}, X_{-αᵢ})` — and hence
by every pinned simple Weyl element `n_{αᵢ}(s)` — and that every element of `D.positivePoints A`
factors both on the right as `v * x_{αᵢ}(u)` and on the left as `x_{αᵢ}(u) * v` with `v ∈ U⁽ⁱ⁾`.

These are the local unipotent factorizations used in simple-reflection Bruhat reduction and in the
construction of the Bruhat normal form, without assuming that positive simple root subgroups
generate `D.positivePoints A` or that root-product expressions are unique. Both results hold over
every commutative ring `A`, including characteristics two and three.

## Main results

* `ChevalleyDatum.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton`:
  the opposite simple-root pair normalizes `U⁽ⁱ⁾` inside `D.points A`.
* `ChevalleyDatum.weylElement_mem_normalizer_positivePoints_diff_singleton`:
  every pinned simple Weyl element `n_{αᵢ}(s)` normalizes `U⁽ⁱ⁾`.
* `ChevalleyDatum.iSup_rootSubgroupPoints_diff_singleton_le_positivePoints`:
  `U⁽ⁱ⁾ ≤ D.positivePoints A`.
* `ChevalleyDatum.mem_positivePoints_iff_exists_mul_rootSubgroupPoints` and
  `ChevalleyDatum.mem_positivePoints_iff_exists_rootSubgroupPoints_mul`:
  right and left factorizations of `D.positivePoints A` along a chosen simple root subgroup.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 18 and proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

-- Match the tensor product with the integral algebra structure on the value ring.
attribute [local instance high] Algebra.toModule

/-- For every Chevalley datum, the opposite simple-root pair normalizes the subgroup generated by
all the other positive roots, over every commutative value ring. -/
theorem closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton
    (i : Fin t.rank) :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  let e := Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
  let f := e.symm.toMonoidHom.comp (D.points A).subtype
  have hf (γ : Fin t.numRoots) :
      f.comp (D.rootSubgroupPoints γ A) =
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) := by
    apply MonoidHom.ext
    intro u
    apply e.injective
    simp only [f, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.apply_symm_apply, Subgroup.coe_subtype]
    apply Units.ext
    simpa [e] using congrArg Units.val (D.coe_rootSubgroupPoints γ A u)
  have hinj : Function.Injective f := e.symm.injective.comp (D.points A).subtype_injective
  let U : Subgroup (D.points A) := ⨆ γ ∈
    posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range
  have h := DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  -- Express both generated subgroups in lattice coordinates; injectivity reflects normalization.
  have hmap : (Subgroup.closure
      (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A))).map f ≤
        Subgroup.normalizer (U.map f) := by
    simpa only [U, Subgroup.closure_union, ← MonoidHom.coe_range, Subgroup.closure_eq,
      Subgroup.map_sup, Subgroup.map_iSup, MonoidHom.map_range, hf] using h
  have hpre := (Subgroup.map_le_iff_le_comap.mp hmap).trans
    ((U.map f).le_normalizer_comap f)
  simpa only [Subgroup.comap_map_eq_self_of_injective hinj] using hpre

/-- Every pinned simple Weyl element `n_{αᵢ}(s)` normalizes the punctured positive subgroup
generated by all positive roots other than `αᵢ`. -/
theorem weylElement_mem_normalizer_positivePoints_diff_singleton
    (i : Fin t.rank) (s : Aˣ) :
    D.weylElement (t.simpleIndex ht i) A s ∈
      Subgroup.normalizer (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  apply D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton A i
  rw [D.weylElement_def]
  exact mul_mem
    (mul_mem (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))
      (Subgroup.subset_closure (Or.inr ⟨_, rfl⟩)))
    (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))

/-- The punctured positive subgroup generated by all positive roots other than `αᵢ` lies inside
`D.positivePoints A`. -/
theorem iSup_rootSubgroupPoints_diff_singleton_le_positivePoints (i : Fin t.rank) :
    (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
      (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) ≤ D.positivePoints A := by
  refine iSup₂_le fun γ hγ => ?_
  rintro _ ⟨u, rfl⟩
  exact D.rootSubgroupPoints_mem_positivePoints A hγ.1 u

/-- Every positive point is a product of a point generated by the other positive roots followed by
a point of a chosen simple root subgroup. No uniqueness of these factors is asserted. -/
theorem mem_positivePoints_iff_exists_mul_rootSubgroupPoints
    (i : Fin t.rank) (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ v ∈ (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
        ∃ u : Multiplicative A, g = v * D.rootSubgroupPoints (t.simpleIndex ht i) A u := by
  classical
  let U : Subgroup (D.points A) := ⨆ γ ∈
    posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range
  have hnorm : (D.rootSubgroupPoints (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer U := by
    refine le_trans ?_
      (D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton A i)
    rintro _ hu
    exact Subgroup.subset_closure (Or.inl hu)
  have hpos : t.simpleIndex ht i ∈
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) :=
    simpleIndex_mem_posRoots i
  have hwhole : D.positivePoints A =
      U ⊔ (D.rootSubgroupPoints (t.simpleIndex ht i) A).range := by
    apply le_antisymm
    · apply D.positivePoints_le_iff.mpr
      intro γ hγ u
      by_cases heq : γ = t.simpleIndex ht i
      · subst γ
        exact (le_sup_right :
          (D.rootSubgroupPoints (t.simpleIndex ht i) A).range ≤ _) ⟨u, rfl⟩
      · exact (le_sup_left : U ≤ _) ((le_iSup₂
          (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ ⟨hγ, heq⟩) ⟨u, rfl⟩)
    · refine sup_le (D.iSup_rootSubgroupPoints_diff_singleton_le_positivePoints A i) ?_
      rintro _ ⟨u, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints A hpos u
  rw [hwhole, Subgroup.mem_sup_of_right_le_normalizer_left hnorm]
  constructor
  · rintro ⟨v, hv, _, ⟨u, rfl⟩, h⟩
    exact ⟨v, hv, u, h.symm⟩
  · rintro ⟨v, hv, u, h⟩
    exact ⟨v, hv, _, ⟨u, rfl⟩, h.symm⟩

/-- Every positive point is a product of a point of a chosen simple root subgroup followed by a
point generated by the other positive roots. -/
theorem mem_positivePoints_iff_exists_rootSubgroupPoints_mul
    (i : Fin t.rank) (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ u : Multiplicative A,
        ∃ v ∈ (⨆ γ ∈
          posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
          g = D.rootSubgroupPoints (t.simpleIndex ht i) A u * v := by
  rw [← inv_mem_iff, D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints A i]
  constructor
  · rintro ⟨v, hv, u, h⟩
    refine ⟨u⁻¹, v⁻¹, inv_mem hv, ?_⟩
    rw [map_inv, ← mul_inv_rev, ← h, inv_inv]
  · rintro ⟨u, v, hv, rfl⟩
    exact ⟨v⁻¹, inv_mem hv, u⁻¹, by rw [map_inv, mul_inv_rev]⟩

end TauCeti.DynkinType.ChevalleyDatum
