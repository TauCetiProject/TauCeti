module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Borel
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic

/-!
# Rank-one punctured positive subgroups of a Chevalley datum

For each simple root `αᵢ` of a valid Dynkin type and every Chevalley datum `D`, let
`D.puncturedPositivePoints i A` (`U^{(i)}`) be the subgroup of `D.points A` generated by all
positive root subgroups other than `X_{αᵢ}`. Over every commutative ring `A`, `U^{(i)}` is
normalized by the opposite simple-root pair `X_{αᵢ}` and `X_{-αᵢ}`, hence by every simple Weyl
element `n_{αᵢ}(s)` (`s : Aˣ`), and also by the actual torus `T(A)`. Consequently every positive
point factors as `v * x_{αᵢ}(u)` with `v ∈ U^{(i)}`, and every point of `D.borelSubgroup A`
factors as `v * x_{αᵢ}(u) * t`.

This all-type local factorization transports
`TauCeti.DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton` from the
admissible lattice to the datum's point group. It supplies the simple-reflection reduction step
for the Tits-system multiplication axiom without characteristic restrictions.

## Main declarations

* `TauCeti.DynkinType.ChevalleyDatum.puncturedPositivePoints`: the subgroup `U^{(i)}` generated by
  all positive root subgroups except `X_{αᵢ}`.
* `TauCeti.DynkinType.ChevalleyDatum.closure_simpleRootPair_le_normalizer_puncturedPositivePoints`:
  `X_{αᵢ}` and `X_{-αᵢ}` normalize `U^{(i)}`.
* `TauCeti.DynkinType.ChevalleyDatum.weylElement_mem_normalizer_puncturedPositivePoints`:
  `n_{αᵢ}(s)` normalizes `U^{(i)}`.
* `TauCeti.DynkinType.ChevalleyDatum.mem_positivePoints_iff_exists_puncturedPositivePoints_mul`:
  every positive point factors in `U^{(i)} X_{αᵢ}`.
* `TauCeti.DynkinType.ChevalleyDatum.mem_borelSubgroup_iff_exists_puncturedPositivePoints_mul`:
  every Borel point factors in `U^{(i)} X_{αᵢ} T`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.3 and 8.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

attribute [local instance high] Algebra.toModule

/-- The punctured positive subgroup `U^{(i)}` of datum points generated by all positive root
subgroups other than the `i`-th simple root subgroup. -/
noncomputable def puncturedPositivePoints (i : Fin t.rank) (A : Type v) [CommRing A] :
    Subgroup (D.points A) :=
  ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range

/-- The defining join expression for `puncturedPositivePoints`. -/
theorem puncturedPositivePoints_def (i : Fin t.rank) (A : Type v) [CommRing A] :
    D.puncturedPositivePoints i A =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range :=
  (rfl)

/-- Containment of `puncturedPositivePoints` is checked on positive roots distinct from `αᵢ`. -/
theorem puncturedPositivePoints_le_iff {i : Fin t.rank} {A : Type v} [CommRing A]
    {P : Subgroup (D.points A)} :
    D.puncturedPositivePoints i A ≤ P ↔
      ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}, ∀ u,
        D.rootSubgroupPoints γ A u ∈ P := by
  rw [D.puncturedPositivePoints_def]
  constructor
  · intro h γ hγ u
    exact h ((le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ hγ) ⟨u, rfl⟩)
  · intro h
    refine iSup₂_le fun γ hγ => ?_
    rintro _ ⟨u, rfl⟩
    exact h γ hγ u

/-- Each positive root element distinct from `αᵢ` lies in `D.puncturedPositivePoints i A`. -/
@[simp]
theorem rootSubgroupPoints_mem_puncturedPositivePoints {i : Fin t.rank} (A : Type v) [CommRing A]
    {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
    (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.puncturedPositivePoints i A :=
  (D.puncturedPositivePoints_le_iff.mp le_rfl) γ hγ u

/-- The punctured positive subgroup is contained in `D.positivePoints A`. -/
theorem puncturedPositivePoints_le_positivePoints (i : Fin t.rank) (A : Type v) [CommRing A] :
    D.puncturedPositivePoints i A ≤ D.positivePoints A :=
  D.puncturedPositivePoints_le_iff.mpr fun _ hγ u =>
    D.rootSubgroupPoints_mem_positivePoints A hγ.1 u

/-- The punctured positive subgroup is contained in `D.borelSubgroup A`. -/
theorem puncturedPositivePoints_le_borelSubgroup (i : Fin t.rank) (A : Type v) [CommRing A] :
    D.puncturedPositivePoints i A ≤ D.borelSubgroup A :=
  (D.puncturedPositivePoints_le_positivePoints i A).trans (D.positivePoints_le_borelSubgroup A)

/-- For every valid Dynkin type and every commutative ring, the opposite simple-root pair `X_{αᵢ}`
and `X_{-αᵢ}` normalizes `D.puncturedPositivePoints i A`. -/
theorem closure_simpleRootPair_le_normalizer_puncturedPositivePoints
    (i : Fin t.rank) (A : Type v) [CommRing A] :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set (D.points A)) := by
  let e := Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
  let f := e.symm.toMonoidHom.comp (D.points A).subtype
  have hf (γ : Fin t.numRoots) :
      f.comp (D.rootSubgroupPoints γ A) =
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) := by
    apply MonoidHom.ext
    intro u
    apply e.injective
    simp only [f, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.apply_symm_apply, Subgroup.coe_subtype]
    apply Units.ext
    simpa [e] using congrArg Units.val (D.coe_rootSubgroupPoints γ A u)
  have hinj : Function.Injective f := e.symm.injective.comp (D.points A).subtype_injective
  have hlat := DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  have hmap : (Subgroup.closure
      (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A))).map f ≤
        Subgroup.normalizer ((D.puncturedPositivePoints i A).map f) := by
    simpa only [puncturedPositivePoints_def, Subgroup.closure_union, ← MonoidHom.coe_range,
      Subgroup.closure_eq, Subgroup.map_sup, Subgroup.map_iSup, MonoidHom.map_range, hf]
      using hlat
  have hpre := (Subgroup.map_le_iff_le_comap.mp hmap).trans
    (((D.puncturedPositivePoints i A).map f).le_normalizer_comap f)
  simpa only [Subgroup.comap_map_eq_self_of_injective hinj] using hpre

/-- The positive simple root subgroup `X_{αᵢ}` normalizes `D.puncturedPositivePoints i A`. -/
theorem range_rootSubgroupPoints_simpleIndex_le_normalizer_puncturedPositivePoints
    (i : Fin t.rank) (A : Type v) [CommRing A] :
    (D.rootSubgroupPoints (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set (D.points A)) :=
  le_trans (fun _ hx => Subgroup.subset_closure (Or.inl hx))
    (D.closure_simpleRootPair_le_normalizer_puncturedPositivePoints i A)

/-- The negative simple root subgroup `X_{-αᵢ}` normalizes `D.puncturedPositivePoints i A`. -/
theorem range_rootSubgroupPoints_reflectionPerm_simpleIndex_le_normalizer_puncturedPositivePoints
    (i : Fin t.rank) (A : Type v) [CommRing A] :
    (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) A).range ≤
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set (D.points A)) :=
  le_trans (fun _ hx => Subgroup.subset_closure (Or.inr hx))
    (D.closure_simpleRootPair_le_normalizer_puncturedPositivePoints i A)

/-- Every simple Weyl element `n_{αᵢ}(s)` normalizes `D.puncturedPositivePoints i A`. -/
theorem weylElement_mem_normalizer_puncturedPositivePoints
    (i : Fin t.rank) (A : Type v) [CommRing A] (s : Aˣ) :
    D.weylElement (t.simpleIndex ht i) A s ∈
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set (D.points A)) := by
  apply D.closure_simpleRootPair_le_normalizer_puncturedPositivePoints i A
  rw [D.weylElement_def]
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _ (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))
      (Subgroup.subset_closure (Or.inr ⟨_, rfl⟩)))
    (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))

/-- The actual torus normalizes `D.puncturedPositivePoints i A`. -/
theorem range_torusPoints_le_normalizer_puncturedPositivePoints
    (i : Fin t.rank) (A : Type v) [CommRing A] :
    (D.torusPoints A).range ≤
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set (D.points A)) := by
  have hconj (s' : Fin t.rank → Aˣ) {x : D.points A}
      (hx : x ∈ D.puncturedPositivePoints i A) :
      D.torusPoints A s' * x * (D.torusPoints A s')⁻¹ ∈ D.puncturedPositivePoints i A := by
    have hle : D.puncturedPositivePoints i A ≤
        (D.puncturedPositivePoints i A).comap
          (MulAut.conj (D.torusPoints A s')).toMonoidHom := by
      refine D.puncturedPositivePoints_le_iff.mpr fun γ hγ u => ?_
      rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
        ← ofAdd_toAdd u, D.torusPoints_conj_rootSubgroupPoints]
      exact D.rootSubgroupPoints_mem_puncturedPositivePoints A hγ _
    exact hle hx
  rintro _ ⟨s, rfl⟩
  rw [Subgroup.mem_normalizer_iff]
  intro x
  exact ⟨fun hx => hconj s hx, fun hx => by
    have h := hconj s⁻¹ hx
    rw [map_inv, inv_inv] at h
    simpa only [← mul_assoc, inv_mul_cancel, one_mul, inv_mul_cancel_right] using h⟩

/-- Every element of `D.positivePoints A` factors as an element of `D.puncturedPositivePoints i A`
followed by an element of `X_{αᵢ}`. -/
theorem mem_positivePoints_iff_exists_puncturedPositivePoints_mul
    (i : Fin t.rank) (A : Type v) [CommRing A] {g : D.points A} :
    g ∈ D.positivePoints A ↔
      ∃ v ∈ D.puncturedPositivePoints i A, ∃ u : Multiplicative A,
        v * D.rootSubgroupPoints (t.simpleIndex ht i) A u = g := by
  have hwhole : D.positivePoints A =
      D.puncturedPositivePoints i A ⊔ (D.rootSubgroupPoints (t.simpleIndex ht i) A).range := by
    rw [D.positivePoints_eq_iSup, posRoots_eq_diff_union_simpleIndex i, iSup_union,
      iSup_singleton, D.puncturedPositivePoints_def]
  rw [hwhole, Subgroup.mem_sup_of_right_le_normalizer_left
    (D.range_rootSubgroupPoints_simpleIndex_le_normalizer_puncturedPositivePoints i A)]
  simp only [MonoidHom.mem_range, exists_exists_eq_and]

/-- Every element of `D.borelSubgroup A` factors as `v * x_{αᵢ}(u) * t` with
`v ∈ D.puncturedPositivePoints i A`, `u : Multiplicative A`, and `t` in the actual torus. -/
theorem mem_borelSubgroup_iff_exists_puncturedPositivePoints_mul
    (i : Fin t.rank) (A : Type v) [CommRing A] {g : D.points A} :
    g ∈ D.borelSubgroup A ↔
      ∃ v ∈ D.puncturedPositivePoints i A, ∃ u : Multiplicative A, ∃ s : Fin t.rank → Aˣ,
        v * D.rootSubgroupPoints (t.simpleIndex ht i) A u * D.torusPoints A s = g := by
  rw [D.mem_borelSubgroup_iff A]
  constructor
  · rintro ⟨w, hw, s, rfl⟩
    obtain ⟨v, hv, u, rfl⟩ :=
      (D.mem_positivePoints_iff_exists_puncturedPositivePoints_mul i A).mp hw
    exact ⟨v, hv, u, s, rfl⟩
  · rintro ⟨v, hv, u, s, rfl⟩
    refine ⟨v * D.rootSubgroupPoints (t.simpleIndex ht i) A u, ?_, s, rfl⟩
    exact (D.mem_positivePoints_iff_exists_puncturedPositivePoints_mul i A).mpr ⟨v, hv, u, rfl⟩

end TauCeti.DynkinType.ChevalleyDatum
