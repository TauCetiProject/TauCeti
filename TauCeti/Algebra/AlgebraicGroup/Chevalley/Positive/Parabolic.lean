module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.Algebra.Group.Subgroup.Pointwise
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic

/-!
# Simple-root factorization of positive Chevalley points

For any valid Dynkin type and any simple root `αᵢ` of a Chevalley datum `D`, let `U⁽ⁱ⁾`
(`ChevalleyDatum.puncturedPositivePoints`) be the subgroup of `D.points A` generated by all
positive root subgroups other than `X_{αᵢ}`. Both `X_{αᵢ}` and `X_{-αᵢ}`, and in particular the
pinned simple Weyl representative `n_{αᵢ}(1)`, normalize `U⁽ⁱ⁾`. Consequently every positive point
factors either as an element of `U⁽ⁱ⁾` followed by an element of `X_{αᵢ}`, or in the opposite
order.

The normalization transports
`DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton` from automorphisms of
the base-changed admissible lattice to `D.points A`. The factorizations then follow from
`Subgroup.mem_sup_of_right_le_normalizer_left`. All statements hold over every commutative ring,
without assuming point generation of the ambient scheme or uniqueness of root coordinates.

## Main declarations

* `TauCeti.DynkinType.ChevalleyDatum.puncturedPositivePoints`: the subgroup `U⁽ⁱ⁾(A)` generated by
  all positive root subgroups other than `X_{αᵢ}`.
* `TauCeti.DynkinType.ChevalleyDatum.closure_simpleRootPair_le_normalizer_puncturedPositivePoints`:
  the opposite simple-root pair normalizes `U⁽ⁱ⁾(A)`.
* `TauCeti.DynkinType.ChevalleyDatum.weylElement_mem_normalizer_puncturedPositivePoints`:
  the pinned simple Weyl representative normalizes `U⁽ⁱ⁾(A)`.
* `TauCeti.DynkinType.ChevalleyDatum.mem_positivePoints_iff_exists_mem_puncturedPositivePoints_mul`:
  simple-root factorization `U(A) = U⁽ⁱ⁾(A) X_{αᵢ}(A)` (and the opposite order).

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (i : Fin t.rank) (A : Type v) [CommRing A]

-- Match the tensor product with the integral algebra structure on the value ring.
attribute [local instance high] Algebra.toModule

/-- The subgroup of positive datum points generated by all positive root subgroups except the
`i`-th simple root subgroup. -/
noncomputable def puncturedPositivePoints : Subgroup (D.points A) :=
  ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range

/-- The punctured positive subgroup is the join of the remaining positive root subgroup ranges. -/
theorem puncturedPositivePoints_def :
    D.puncturedPositivePoints i A =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range :=
  (rfl)

/-- Containment of the punctured positive subgroup is checked on positive roots distinct from the
omitted simple root. -/
theorem puncturedPositivePoints_le_iff {P : Subgroup (D.points A)} :
    D.puncturedPositivePoints i A ≤ P ↔
      ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        γ ≠ t.simpleIndex ht i → ∀ u, D.rootSubgroupPoints γ A u ∈ P := by
  constructor
  · intro h γ hγ hne u
    exact h (le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ ⟨hγ, hne⟩ ⟨u, rfl⟩)
  · intro h
    rw [D.puncturedPositivePoints_def]
    refine iSup₂_le fun γ hγ => ?_
    rintro _ ⟨u, rfl⟩
    exact h γ hγ.1 hγ.2 u

/-- Every positive root element away from the `i`-th simple root belongs to the punctured positive
subgroup. -/
theorem rootSubgroupPoints_mem_puncturedPositivePoints {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hne : γ ≠ t.simpleIndex ht i) (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.puncturedPositivePoints i A :=
  (D.puncturedPositivePoints_le_iff i A).mp le_rfl γ hγ hne u

/-- The punctured positive subgroup is contained in the positive subgroup. -/
theorem puncturedPositivePoints_le_positivePoints :
    D.puncturedPositivePoints i A ≤ D.positivePoints A :=
  (D.puncturedPositivePoints_le_iff i A).mpr fun _ hγ _ u =>
    D.rootSubgroupPoints_mem_positivePoints A hγ u

/-- Over every commutative ring, the opposite simple-root pair at node `i` normalizes the subgroup
generated by all other positive root subgroups. -/
theorem closure_simpleRootPair_le_normalizer_puncturedPositivePoints :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set (D.points A)) := by
  let e := Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
  let f := e.symm.toMonoidHom.comp (D.points A).subtype
  have hf (γ : Fin t.numRoots) :
      f.comp (D.rootSubgroupPoints γ A) =
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) := by
    apply MonoidHom.ext
    intro u
    apply e.injective
    simp only [f, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.apply_symm_apply, Subgroup.coe_subtype]
    apply Units.ext
    simpa [e] using congrArg Units.val (D.coe_rootSubgroupPoints γ A u)
  have hinj : Function.Injective f := e.symm.injective.comp (D.points A).subtype_injective
  have h := DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  -- Express both generated subgroups in lattice coordinates, then pull back normalization along
  -- the injective matrix embedding.
  have hmap : (Subgroup.closure
      (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A))).map f ≤
        Subgroup.normalizer ((D.puncturedPositivePoints i A).map f) := by
    simpa only [puncturedPositivePoints, Subgroup.closure_union, ← MonoidHom.coe_range,
      Subgroup.closure_eq, Subgroup.map_sup, Subgroup.map_iSup, MonoidHom.map_range, hf] using h
  have hpre := (Subgroup.map_le_iff_le_comap.mp hmap).trans
    (((D.puncturedPositivePoints i A).map f).le_normalizer_comap f)
  simpa only [Subgroup.comap_map_eq_self_of_injective hinj] using hpre

/-- The `i`-th positive simple root subgroup normalizes the punctured positive subgroup. -/
theorem range_rootSubgroupPoints_simpleIndex_le_normalizer_puncturedPositivePoints :
    (D.rootSubgroupPoints (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set (D.points A)) :=
  le_trans (fun _ hu => Subgroup.subset_closure (Or.inl hu))
    (D.closure_simpleRootPair_le_normalizer_puncturedPositivePoints i A)

/-- Each pinned simple Weyl representative normalizes the corresponding punctured positive
subgroup over every commutative ring. -/
theorem weylElement_mem_normalizer_puncturedPositivePoints :
    D.weylElement (t.simpleIndex ht i) A 1 ∈
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set (D.points A)) := by
  apply D.closure_simpleRootPair_le_normalizer_puncturedPositivePoints i A
  rw [D.weylElement_def]
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _
      (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))
      (Subgroup.subset_closure (Or.inr ⟨_, rfl⟩)))
    (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))

/-- The positive subgroup is the join of the punctured positive subgroup and the omitted simple
root subgroup. -/
theorem positivePoints_eq_puncturedPositivePoints_sup_range_rootSubgroupPoints :
    D.positivePoints A =
      D.puncturedPositivePoints i A ⊔
        (D.rootSubgroupPoints (t.simpleIndex ht i) A).range := by
  classical
  apply le_antisymm
  · apply D.positivePoints_le_iff.mpr
    intro γ hγ u
    by_cases heq : γ = t.simpleIndex ht i
    · subst γ
      exact Subgroup.mem_sup_right ⟨u, rfl⟩
    · exact Subgroup.mem_sup_left
        (D.rootSubgroupPoints_mem_puncturedPositivePoints i A hγ heq u)
  · refine sup_le (D.puncturedPositivePoints_le_positivePoints i A) ?_
    rintro _ ⟨u, rfl⟩
    exact D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u

/-- Every positive point is a product of a punctured positive point followed by an element of the
omitted simple root subgroup. -/
theorem mem_positivePoints_iff_exists_mem_puncturedPositivePoints_mul (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ v ∈ D.puncturedPositivePoints i A, ∃ u : Multiplicative A,
        g = v * D.rootSubgroupPoints (t.simpleIndex ht i) A u := by
  rw [D.positivePoints_eq_puncturedPositivePoints_sup_range_rootSubgroupPoints i A,
    Subgroup.mem_sup_of_right_le_normalizer_left
      (D.range_rootSubgroupPoints_simpleIndex_le_normalizer_puncturedPositivePoints i A)]
  constructor
  · rintro ⟨v, hv, _, ⟨u, rfl⟩, h⟩
    exact ⟨v, hv, u, h.symm⟩
  · rintro ⟨v, hv, u, h⟩
    exact ⟨v, hv, _, ⟨u, rfl⟩, h.symm⟩

/-- Every positive point is a product of an element of the omitted simple root subgroup followed
by a punctured positive point. -/
theorem mem_positivePoints_iff_exists_rootSubgroupPoints_mul_mem_puncturedPositivePoints
    (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ u : Multiplicative A, ∃ v ∈ D.puncturedPositivePoints i A,
        g = D.rootSubgroupPoints (t.simpleIndex ht i) A u * v := by
  rw [← Subgroup.inv_mem_iff,
    D.mem_positivePoints_iff_exists_mem_puncturedPositivePoints_mul i A]
  constructor
  · rintro ⟨v, hv, u, h⟩
    refine ⟨u⁻¹, v⁻¹, (D.puncturedPositivePoints i A).inv_mem hv, ?_⟩
    rw [map_inv, ← mul_inv_rev, ← h, inv_inv]
  · rintro ⟨u, v, hv, rfl⟩
    refine ⟨v⁻¹, (D.puncturedPositivePoints i A).inv_mem hv, u⁻¹, ?_⟩
    rw [map_inv, mul_inv_rev]

end TauCeti.DynkinType.ChevalleyDatum
