module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.Algebra.Group.Subgroup.Pointwise
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic

/-!
# Simple-root factorization of positive Chevalley points

For any valid Dynkin type `t`, Chevalley datum `D`, and simple root `αᵢ`, let `U⁽ⁱ⁾` be the
subgroup of `D.points A` generated by all positive root subgroups other than `X_{αᵢ}`. Over every
commutative value ring `A`, `U⁽ⁱ⁾` is normalized both by the opposite simple-root pair
`⟨X_{αᵢ}, X_{-αᵢ}⟩` (hence by `n_{αᵢ}(s)`) and by the full positive subgroup `D.positivePoints A`,
and every positive point factors as an element of `U⁽ⁱ⁾` followed by an element of `X_{αᵢ}`.

This is the local parabolic factorization used in simple-reflection Bruhat reduction. Neither
generation of `D.positivePoints A` by positive simple root subgroups nor uniqueness of the two
factors is asserted, and no characteristic restriction is imposed.

The normalization transports
`TauCeti.DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton` from
automorphisms of the base-changed admissible lattice to `D.points A` along the faithful coordinate
representation, and the factorization follows from `Subgroup.mem_sup_of_right_le_normalizer_left`.

## Main results

* `ChevalleyDatum.positivePoints_eq_iSup`: `D.positivePoints A` is the supremum of all positive
  root subgroup images.
* `ChevalleyDatum.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton` and
  `ChevalleyDatum.weylElement_mem_normalizer_positivePoints_diff_singleton`: opposite simple-root
  pairs and simple Weyl elements normalize `U⁽ⁱ⁾`.
* `ChevalleyDatum.positivePoints_le_normalizer_positivePoints_diff_singleton`:
  `D.positivePoints A` normalizes `U⁽ⁱ⁾`.
* `ChevalleyDatum.mem_positivePoints_iff_exists_mul_rootSubgroupPoints`: every element of
  `D.positivePoints A` factors as `v * x_{αᵢ}(u)` with `v ∈ U⁽ⁱ⁾`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

-- Match the tensor product with the integral algebra structure on the value ring.
attribute [local instance high] Algebra.toModule

/-- The positive point subgroup is the supremum of the ranges of all positive root subgroups. -/
theorem positivePoints_eq_iSup :
    D.positivePoints A =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (D.rootSubgroupPoints γ A).range := by
  apply le_antisymm
  · exact D.positivePoints_le_iff.mpr fun γ hγ u =>
      (le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ hγ) ⟨u, rfl⟩
  · refine iSup₂_le fun γ hγ => ?_
    rintro _ ⟨u, rfl⟩
    exact D.rootSubgroupPoints_mem_positivePoints A hγ u

/-- For every valid Dynkin type and commutative ring, the subgroup generated by an opposite
simple-root pair normalizes the subgroup generated by all other positive root subgroups. -/
theorem closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton
    (i : Fin t.rank) :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  let e := Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
  let f := e.symm.toMonoidHom.comp (D.points A).subtype
  have hf (γ : Fin t.numRoots) :
      f.comp (D.rootSubgroupPoints γ A) =
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) := by
    apply MonoidHom.ext
    intro u
    apply e.injective
    simp only [f, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.apply_symm_apply, Subgroup.coe_subtype]
    apply Units.ext
    simpa [e] using congrArg Units.val (D.coe_rootSubgroupPoints γ A u)
  have hinj : Function.Injective f := e.symm.injective.comp (D.points A).subtype_injective
  let U : Subgroup (D.points A) := ⨆ γ ∈
    posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range
  have h := DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  -- Express both generated subgroups in lattice coordinates; injectivity of `f` reflects
  -- normalization back into the datum's point group.
  have hmap : (Subgroup.closure
      (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A))).map f ≤
        Subgroup.normalizer (U.map f) := by
    simpa only [U, Subgroup.closure_union, ← MonoidHom.coe_range, Subgroup.closure_eq,
      Subgroup.map_sup, Subgroup.map_iSup, MonoidHom.map_range, hf] using h
  have hpre := (Subgroup.map_le_iff_le_comap.mp hmap).trans
    ((U.map f).le_normalizer_comap f)
  simpa only [Subgroup.comap_map_eq_self_of_injective hinj] using hpre

/-- Each positive simple root subgroup normalizes the subgroup generated by all other positive
root subgroups. -/
theorem range_simpleIndex_le_normalizer_positivePoints_diff_singleton
    (i : Fin t.rank) :
    (D.rootSubgroupPoints (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  refine le_trans ?_ (D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton A i)
  rintro _ hu
  exact Subgroup.subset_closure (Or.inl hu)

/-- Every simple Weyl element `n_{αᵢ}(s)` normalizes the subgroup generated by all positive root
subgroups other than `X_{αᵢ}`. -/
theorem weylElement_mem_normalizer_positivePoints_diff_singleton
    (i : Fin t.rank) (s : Aˣ) :
    D.weylElement (t.simpleIndex ht i) A s ∈
      Subgroup.normalizer (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) :=
  D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton A i
    (D.weylElement_mem_closure_rootPair (t.simpleIndex ht i) A s)

/-- The positive point subgroup normalizes the subgroup generated by all positive root subgroups
except a chosen simple one. -/
theorem positivePoints_le_normalizer_positivePoints_diff_singleton
    (i : Fin t.rank) :
    D.positivePoints A ≤
      Subgroup.normalizer (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  conv_lhs =>
    rw [D.positivePoints_eq_iSup A, posRoots_eq_diff_union_simpleIndex i, iSup_union,
      iSup_singleton]
  exact sup_le Subgroup.le_normalizer
    (D.range_simpleIndex_le_normalizer_positivePoints_diff_singleton A i)

/-- Every positive point factors as an element generated by the positive roots other than `αᵢ`
followed by an element of the simple root subgroup `X_{αᵢ}`. No uniqueness of these factors is
asserted. -/
theorem mem_positivePoints_iff_exists_mul_rootSubgroupPoints
    (i : Fin t.rank) (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ v ∈ (⨆ γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
        ∃ u : Multiplicative A, g = v * D.rootSubgroupPoints (t.simpleIndex ht i) A u := by
  have hwhole : D.positivePoints A =
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range) ⊔
        (D.rootSubgroupPoints (t.simpleIndex ht i) A).range := by
    conv_lhs =>
      rw [D.positivePoints_eq_iSup A, posRoots_eq_diff_union_simpleIndex i, iSup_union,
        iSup_singleton]
  rw [hwhole, Subgroup.mem_sup_of_right_le_normalizer_left
    (D.range_simpleIndex_le_normalizer_positivePoints_diff_singleton A i)]
  constructor
  · rintro ⟨v, hv, _, ⟨u, rfl⟩, h⟩
    exact ⟨v, hv, u, h.symm⟩
  · rintro ⟨v, hv, u, h⟩
    exact ⟨v, hv, _, ⟨u, rfl⟩, h.symm⟩

end TauCeti.DynkinType.ChevalleyDatum
