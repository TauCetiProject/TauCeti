module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.Algebra.Group.Subgroup.Pointwise
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic

/-!
# Simple-root factorization of positive Chevalley points

For any simple root `αᵢ` of a Chevalley datum `D`, let `U⁽ⁱ⁾` be the subgroup of `D.points A`
generated by the remaining positive root subgroups. Both the positive subgroup `D.positivePoints A`
and the opposite simple-root pair `Xᵢ ∪ X₋ᵢ` normalize `U⁽ⁱ⁾`, and hence so does the pinned simple
Weyl representative `nᵢ(1)`. Consequently every positive point factors in either order as an
element of `U⁽ⁱ⁾` and an element of `Xᵢ`.

These factorizations supply the local step in simple-reflection Bruhat reduction and in the
inductive construction of Bruhat normal forms. They transport
`DynkinType.iSup_posRoots_le_normalizer_posRoots_diff_singleton` and
`DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton` from automorphisms of
the base-changed admissible lattice to `D.points A`, and hold over every commutative ring without
assuming a global root-product normal form.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17 and proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

-- Match the tensor product with the integral algebra structure on the value ring.
attribute [local instance high] Algebra.toModule

/-- The coordinate embedding from datum points back to automorphisms of the base-changed lattice. -/
private noncomputable def latticeHom :
    D.points A →* LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice) :=
  (Units.mapEquiv
    (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).symm.toMonoidHom.comp
    (D.points A).subtype

private theorem latticeHom_injective : Function.Injective (D.latticeHom A) :=
  (Units.mapEquiv _).symm.injective.comp (D.points A).subtype_injective

private theorem latticeHom_comp_rootSubgroupPoints (γ : Fin t.numRoots) :
    (D.latticeHom A).comp (D.rootSubgroupPoints γ A) =
      chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) := by
  let e := Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
  apply MonoidHom.ext
  intro u
  apply e.injective
  simp only [latticeHom, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, Subgroup.coe_subtype]
  exact Units.ext (by simpa [e] using congrArg Units.val (D.coe_rootSubgroupPoints γ A u))

/-- Transport normalization of the punctured positive root subgroup from lattice automorphisms to
the datum's point group. -/
private theorem le_normalizer_positivePoints_diff_singleton_of_lattice
    (i : Fin t.rank) {H : Subgroup (D.points A)}
    (hH : H.map (D.latticeHom A) ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
            D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A)).range : Subgroup _)) :
    H ≤ Subgroup.normalizer
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  let U : Subgroup (D.points A) :=
    ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
      (D.rootSubgroupPoints γ A).range
  have hmap : H.map (D.latticeHom A) ≤ Subgroup.normalizer (U.map (D.latticeHom A)) := by
    simpa only [U, Subgroup.map_iSup, MonoidHom.map_range,
      D.latticeHom_comp_rootSubgroupPoints A] using hH
  have hpre := (Subgroup.map_le_iff_le_comap.mp hmap).trans
    ((U.map (D.latticeHom A)).le_normalizer_comap (D.latticeHom A))
  simpa only [Subgroup.comap_map_eq_self_of_injective (D.latticeHom_injective A)] using hpre

/-- The positive point subgroup normalizes the subgroup generated by all positive root subgroups
except a chosen simple one, over every commutative ring. -/
theorem positivePoints_le_normalizer_positivePoints_diff_singleton (i : Fin t.rank) :
    D.positivePoints A ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  apply D.le_normalizer_positivePoints_diff_singleton_of_lattice A i
  have h := DynkinType.iSup_posRoots_le_normalizer_posRoots_diff_singleton
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  simpa only [D.positivePoints_eq_iSup A, Subgroup.map_iSup, MonoidHom.map_range,
    D.latticeHom_comp_rootSubgroupPoints A] using h

/-- An opposite simple-root pair normalizes the subgroup generated by all other positive root
subgroups, over every commutative value ring. -/
theorem closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton (i : Fin t.rank) :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  apply D.le_normalizer_positivePoints_diff_singleton_of_lattice A i
  have h := DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  simpa only [Subgroup.closure_union, ← MonoidHom.coe_range, Subgroup.closure_eq,
    Subgroup.map_sup, Subgroup.map_iSup, MonoidHom.map_range,
    D.latticeHom_comp_rootSubgroupPoints A] using h

/-- Each pinned simple Weyl representative normalizes the subgroup generated by all other positive
root subgroups. -/
theorem weylElement_mem_normalizer_positivePoints_diff_singleton (i : Fin t.rank) (s : Aˣ) :
    D.weylElement (t.simpleIndex ht i) A s ∈
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)) := by
  apply D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton A i
  rw [D.weylElement_def]
  exact mul_mem
    (mul_mem (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))
      (Subgroup.subset_closure (Or.inr ⟨_, rfl⟩)))
    (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))

/-- The positive subgroup is the join of the punctured positive subgroup at `i` and the `i`-th
simple root subgroup. -/
private theorem positivePoints_eq_sup_simpleIndex (i : Fin t.rank) :
    D.positivePoints A =
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range) ⊔
      (D.rootSubgroupPoints (t.simpleIndex ht i) A).range := by
  let U : Subgroup (D.points A) :=
    ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
      (D.rootSubgroupPoints γ A).range
  have hpos : t.simpleIndex ht i ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) :=
    simpleIndex_mem_posRoots i
  apply le_antisymm
  · apply D.positivePoints_le_iff.mpr
    intro γ hγ u
    by_cases heq : γ = t.simpleIndex ht i
    · subst γ
      exact (le_sup_right : (D.rootSubgroupPoints (t.simpleIndex ht i) A).range ≤ _) ⟨u, rfl⟩
    · exact (le_sup_left : U ≤ _)
        ((le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ ⟨hγ, heq⟩) ⟨u, rfl⟩)
  · refine sup_le (iSup₂_le fun γ hγ => ?_) ?_
    · rintro _ ⟨u, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints A hγ.1 u
    · rintro _ ⟨u, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints A hpos u

/-- Every positive point factors as a point generated by the other positive roots followed by a
point of the chosen simple root subgroup. -/
theorem mem_positivePoints_iff_exists_mul_rootSubgroupPoints
    (i : Fin t.rank) (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ v ∈ (⨆ γ ∈
          posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
        ∃ u : Multiplicative A, g = v * D.rootSubgroupPoints (t.simpleIndex ht i) A u := by
  let U : Subgroup (D.points A) :=
    ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
      (D.rootSubgroupPoints γ A).range
  have hnorm : (D.rootSubgroupPoints (t.simpleIndex ht i) A).range ≤ Subgroup.normalizer U := by
    refine le_trans ?_ (D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton A i)
    rintro _ hu
    exact Subgroup.subset_closure (Or.inl hu)
  rw [D.positivePoints_eq_sup_simpleIndex A i, Subgroup.mem_sup_of_right_le_normalizer_left hnorm]
  constructor
  · rintro ⟨v, hv, _, ⟨u, rfl⟩, h⟩
    exact ⟨v, hv, u, h.symm⟩
  · rintro ⟨v, hv, u, h⟩
    exact ⟨v, hv, _, ⟨u, rfl⟩, h.symm⟩

/-- Every positive point factors as a point of a chosen simple root subgroup followed by a point
generated by the remaining positive roots. -/
theorem mem_positivePoints_iff_exists_rootSubgroupPoints_mul
    (i : Fin t.rank) (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ u : Multiplicative A,
        ∃ v ∈ (⨆ γ ∈
            posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
            (D.rootSubgroupPoints γ A).range : Subgroup (D.points A)),
          g = D.rootSubgroupPoints (t.simpleIndex ht i) A u * v := by
  constructor
  · intro hg
    obtain ⟨v, hv, u, hinv⟩ :=
      (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints A i g⁻¹).mp (inv_mem hg)
    refine ⟨u⁻¹, v⁻¹, inv_mem hv, ?_⟩
    calc
      g = g⁻¹⁻¹ := (inv_inv g).symm
      _ = (v * D.rootSubgroupPoints (t.simpleIndex ht i) A u)⁻¹ := by rw [hinv]
      _ = D.rootSubgroupPoints (t.simpleIndex ht i) A u⁻¹ * v⁻¹ := by
        rw [mul_inv_rev, map_inv]
  · rintro ⟨u, v, hv, rfl⟩
    rw [D.positivePoints_eq_sup_simpleIndex A i]
    exact mul_mem (Subgroup.mem_sup_right ⟨u, rfl⟩) (Subgroup.mem_sup_left hv)

end TauCeti.DynkinType.ChevalleyDatum
