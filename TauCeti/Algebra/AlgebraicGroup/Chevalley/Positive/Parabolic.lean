module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Weyl.Basic
import TauCeti.Algebra.Group.Subgroup.Pointwise
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic

/-!
# Punctured positive subgroups of a Chevalley datum

For a Chevalley datum `D` and a numbered simple root `αᵢ`, `puncturedPositivePoints` is the
subgroup of `D.points A` generated by all positive root subgroups other than `αᵢ`. Over every
commutative value ring, this subgroup is normalized both by the positive point subgroup and by
the opposite simple-root pair at `αᵢ`, hence in particular by the pinned simple Weyl
representative. Every positive point factors as a punctured-positive point times an `αᵢ`-root
element, and symmetrically with the `αᵢ`-root element on the left.

These results transport the integral Kostant lattice normalization theorems in
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic` along the
datum's weight-basis matrix embedding, then deduce the factorizations via
`Subgroup.mem_sup_of_right_le_normalizer_left`. No field hypothesis, structure-constant inversion,
or uniqueness of the factors is assumed.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (i : Fin t.rank) (A : Type v) [CommRing A]

attribute [local instance high] Algebra.toModule

/-- The subgroup of datum points generated by all positive root subgroups except the chosen
simple root `t.simpleIndex ht i`. -/
noncomputable def puncturedPositivePoints : Subgroup (D.points A) :=
  ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range

/-- The punctured positive point subgroup is the join of the remaining positive root ranges. -/
theorem puncturedPositivePoints_def :
    D.puncturedPositivePoints i A =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range :=
  (rfl)

/-- A subgroup contains the punctured positive subgroup exactly when it contains every positive
root subgroup other than the omitted simple root. -/
theorem puncturedPositivePoints_le_iff {P : Subgroup (D.points A)} :
    D.puncturedPositivePoints i A ≤ P ↔
      ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        ∀ u, D.rootSubgroupPoints γ A u ∈ P := by
  rw [D.puncturedPositivePoints_def, iSup₂_le_iff]
  simp only [IsConcreteLE.le_iff, MonoidHom.mem_range, forall_exists_index,
    forall_apply_eq_imp_iff]

/-- Every positive root element away from the omitted simple root lies in the punctured positive
subgroup. -/
theorem rootSubgroupPoints_mem_puncturedPositivePoints {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
    (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.puncturedPositivePoints i A :=
  (D.puncturedPositivePoints_le_iff i A).mp le_rfl γ hγ u

/-- The punctured positive subgroup is contained in the full positive point subgroup. -/
theorem puncturedPositivePoints_le_positivePoints :
    D.puncturedPositivePoints i A ≤ D.positivePoints A :=
  (D.puncturedPositivePoints_le_iff i A).mpr fun _ hγ u =>
    D.rootSubgroupPoints_mem_positivePoints A hγ.1 u

private noncomputable def pointsToLatticeHom :
    D.points A →* LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice) :=
  (Units.mapEquiv
    (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).symm.toMonoidHom.comp
    (D.points A).subtype

private theorem pointsToLatticeHom_injective :
    Function.Injective (D.pointsToLatticeHom A) :=
  (Units.mapEquiv
    (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).symm.injective.comp
    (D.points A).subtype_injective

private theorem pointsToLatticeHom_comp_rootSubgroupPoints (γ : Fin t.numRoots) :
    (D.pointsToLatticeHom A).comp (D.rootSubgroupPoints γ A) =
      chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) := by
  apply MonoidHom.ext
  intro u
  apply (Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).injective
  simp only [pointsToLatticeHom, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.apply_symm_apply, Subgroup.coe_subtype]
  exact Units.ext (by simpa using congrArg Units.val (D.coe_rootSubgroupPoints γ A u))

/-- The opposite simple-root pair at `t.simpleIndex ht i` normalizes the punctured positive
subgroup over every commutative ring. -/
theorem closure_simpleRootPair_le_normalizer_puncturedPositivePoints :
    Subgroup.closure
      (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
            (t.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set _) := by
  let f := D.pointsToLatticeHom A
  have h := DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  have hmap : (Subgroup.closure
      (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
            (t.simpleIndex ht i)) A))).map f ≤
      Subgroup.normalizer ((D.puncturedPositivePoints i A).map f : Set _) := by
    simpa only [f, puncturedPositivePoints_def, Subgroup.closure_union, ← MonoidHom.coe_range,
      Subgroup.closure_eq, Subgroup.map_sup, Subgroup.map_iSup, MonoidHom.map_range,
      D.pointsToLatticeHom_comp_rootSubgroupPoints A] using h
  have hpre := (Subgroup.map_le_iff_le_comap.mp hmap).trans
    (((D.puncturedPositivePoints i A).map f).le_normalizer_comap f)
  simpa only [f, Subgroup.comap_map_eq_self_of_injective (D.pointsToLatticeHom_injective A)]
    using hpre

/-- The positive point subgroup normalizes the punctured positive subgroup over every commutative
ring. -/
theorem positivePoints_le_normalizer_puncturedPositivePoints :
    D.positivePoints A ≤ Subgroup.normalizer (D.puncturedPositivePoints i A : Set _) := by
  rw [D.positivePoints_eq_iSup, iSup₂_le_iff]
  intro γ hγ
  by_cases hγi : γ = t.simpleIndex ht i
  · subst hγi
    exact (le_trans (fun _ h => Subgroup.subset_closure (Or.inl h))
      (D.closure_simpleRootPair_le_normalizer_puncturedPositivePoints i A))
  · exact (le_iSup₂_of_le γ ⟨hγ, hγi⟩ le_rfl).trans (D.puncturedPositivePoints i A).le_normalizer

/-- The pinned simple Weyl representative normalizes the punctured positive subgroup over every
commutative ring. -/
theorem weylElement_mem_normalizer_puncturedPositivePoints :
    D.weylElement (t.simpleIndex ht i) A 1 ∈
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set _) := by
  apply D.closure_simpleRootPair_le_normalizer_puncturedPositivePoints i A
  rw [D.weylElement_def]
  exact mul_mem (mul_mem (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))
    (Subgroup.subset_closure (Or.inr ⟨_, rfl⟩))) (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))

/-- The full positive point subgroup is the join of the punctured positive subgroup and the
omitted simple root subgroup. -/
theorem positivePoints_eq_puncturedPositivePoints_sup :
    D.positivePoints A =
      D.puncturedPositivePoints i A ⊔ (D.rootSubgroupPoints (t.simpleIndex ht i) A).range := by
  refine le_antisymm ((D.positivePoints_le_iff).mpr fun γ hγ u => ?_)
    (sup_le (D.puncturedPositivePoints_le_positivePoints i A) ?_)
  · by_cases hγi : γ = t.simpleIndex ht i
    · exact hγi ▸ Subgroup.mem_sup_right ⟨u, rfl⟩
    · exact Subgroup.mem_sup_left (D.rootSubgroupPoints_mem_puncturedPositivePoints i A ⟨hγ, hγi⟩ u)
  · rintro _ ⟨u, rfl⟩
    exact D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u

/-- Every positive point factors as a punctured-positive point followed by an element of the
omitted simple root subgroup. -/
theorem mem_positivePoints_iff_exists_puncturedPositivePoints_mul {g : D.points A} :
    g ∈ D.positivePoints A ↔
      ∃ q ∈ D.puncturedPositivePoints i A, ∃ u : Multiplicative A,
        q * D.rootSubgroupPoints (t.simpleIndex ht i) A u = g := by
  have hnorm : (D.rootSubgroupPoints (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer (D.puncturedPositivePoints i A : Set _) := by
    rintro _ ⟨u, rfl⟩
    exact D.positivePoints_le_normalizer_puncturedPositivePoints i A
      (D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u)
  rw [D.positivePoints_eq_puncturedPositivePoints_sup i A,
    Subgroup.mem_sup_of_right_le_normalizer_left hnorm]
  simp only [MonoidHom.mem_range, exists_exists_eq_and]

/-- Every positive point factors as an element of the omitted simple root subgroup followed by
a punctured-positive point. -/
theorem mem_positivePoints_iff_exists_mul_puncturedPositivePoints {g : D.points A} :
    g ∈ D.positivePoints A ↔
      ∃ u : Multiplicative A, ∃ q ∈ D.puncturedPositivePoints i A,
        D.rootSubgroupPoints (t.simpleIndex ht i) A u * q = g := by
  refine ⟨fun hg => ?_, fun ⟨u, q, hq, h⟩ => h ▸ mul_mem
    (D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u)
    (D.puncturedPositivePoints_le_positivePoints i A hq)⟩
  obtain ⟨q, hq, u, hu⟩ := (D.mem_positivePoints_iff_exists_puncturedPositivePoints_mul i A).mp
    ((D.positivePoints A).inv_mem hg)
  refine ⟨u⁻¹, q⁻¹, (D.puncturedPositivePoints i A).inv_mem hq, ?_⟩
  rw [(D.rootSubgroupPoints (t.simpleIndex ht i) A).map_inv, ← mul_inv_rev, hu, inv_inv]

end TauCeti.DynkinType.ChevalleyDatum
