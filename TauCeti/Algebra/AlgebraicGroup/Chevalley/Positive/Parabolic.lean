module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.Algebra.Group.Subgroup.Pointwise
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic

/-!
# Simple-root factorization of positive Chevalley points

For any valid Dynkin type and any simple root `αᵢ` of a Chevalley datum `D`, this file defines
`U⁽ⁱ⁾ = D.puncturedPositivePoints A i`, the subgroup of `D.points A` generated by all positive
root subgroups other than `X_{αᵢ}`. Transporting
`DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton` from
`LieAlgebra.Root.Parabolic` shows that the opposite simple-root pair `(X_{αᵢ}, X_{-αᵢ})`
normalizes `U⁽ⁱ⁾`. Consequently every pinned simple Weyl element `n_{αᵢ}(s)` normalizes `U⁽ⁱ⁾`,
`D.positivePoints A` normalizes `U⁽ⁱ⁾`, and every element of `D.positivePoints A` factors on
both the right as `v * x_{αᵢ}(u)` and the left as `x_{αᵢ}(u) * v` with `v ∈ U⁽ⁱ⁾`.

These are the local unipotent factorizations used in simple-reflection Bruhat reduction and in the
construction of the Bruhat normal form, without assuming that positive simple root subgroups
generate `D.positivePoints A` or that root-product expressions are unique. All results hold over
every commutative ring `A`, including characteristics two and three.

## Main definitions and results

* `ChevalleyDatum.puncturedPositivePoints`: the subgroup generated by all positive root subgroups
  other than `X_{αᵢ}`, with membership, matrix-image, containment, join, and ring-map
  functoriality lemmas.
* `ChevalleyDatum.closure_simpleRootPair_le_normalizer_puncturedPositivePoints`,
  `ChevalleyDatum.range_rootSubgroupPoints_le_normalizer_puncturedPositivePoints`, and
  `ChevalleyDatum.range_torusPoints_le_normalizer_puncturedPositivePoints`: the opposite
  simple-root pair, `X_{αᵢ}`, and the actual torus `T_D` normalize `U⁽ⁱ⁾`.
* `ChevalleyDatum.weylElement_mem_normalizer_puncturedPositivePoints`:
  every pinned simple Weyl element `n_{αᵢ}(s)` normalizes `U⁽ⁱ⁾`.
* `ChevalleyDatum.mem_positivePoints_iff_exists_mul_rootSubgroupPoints` and
  `ChevalleyDatum.mem_positivePoints_iff_exists_rootSubgroupPoints_mul`:
  right and left factorizations of `D.positivePoints A` along a chosen simple root subgroup.
* `ChevalleyDatum.positivePoints_le_normalizer_puncturedPositivePoints`:
  `D.positivePoints A` normalizes `U⁽ⁱ⁾`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 18 and proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

open CategoryTheory TensorProduct
open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v w

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

-- Match the tensor product with the integral algebra structure on the value ring.
attribute [local instance high] Algebra.toModule

/-- The punctured positive point subgroup generated by all positive root subgroups other than
`X_{αᵢ}`. -/
noncomputable def puncturedPositivePoints (A : Type v) [CommRing A] (i : Fin t.rank) :
    Subgroup (D.points A) :=
  D.subsystemPoints
    (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}) A

/-- Punctured positive points are the root-set points for all positive roots other than `αᵢ`. -/
theorem puncturedPositivePoints_def (A : Type v) [CommRing A] (i : Fin t.rank) :
    D.puncturedPositivePoints A i = D.subsystemPoints
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}) A :=
  (rfl)

/-- Punctured-positive-point membership is membership in the matrix image of its lattice
subgroup. -/
theorem mem_puncturedPositivePoints_iff {A : Type v} [CommRing A] {i : Fin t.rank}
    {g : D.points A} :
    g ∈ D.puncturedPositivePoints A i ↔
      g.val ∈ (D.subsystemSubgroup
          (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
          (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) :=
  D.mem_subsystemPoints_iff

/-- Forgetting datum points recovers the punctured-positive lattice subgroup's matrix image. -/
theorem map_puncturedPositivePoints_subtype (A : Type v) [CommRing A] (i : Fin t.rank) :
    (D.puncturedPositivePoints A i).map (D.points A).subtype =
      (D.subsystemSubgroup
          (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
          (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) :=
  D.map_subsystemPoints_subtype _ A

/-- Punctured positive points are the join of the root-subgroup ranges for positive roots other
than `αᵢ`. -/
theorem puncturedPositivePoints_eq_iSup (A : Type v) [CommRing A] (i : Fin t.rank) :
    D.puncturedPositivePoints A i =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range :=
  D.subsystemPoints_eq_iSup _ A

/-- Containment of punctured positive points can be checked on positive root elements other than
`αᵢ`. -/
theorem puncturedPositivePoints_le_iff {A : Type v} [CommRing A] {i : Fin t.rank}
    {P : Subgroup (D.points A)} :
    D.puncturedPositivePoints A i ≤ P ↔
      ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        ∀ u, D.rootSubgroupPoints γ A u ∈ P :=
  D.subsystemPoints_le_iff

/-- Every positive root element other than `αᵢ` belongs to the punctured positive subgroup. -/
@[simp]
theorem rootSubgroupPoints_mem_puncturedPositivePoints (A : Type v) [CommRing A]
    {i : Fin t.rank} {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
    (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.puncturedPositivePoints A i :=
  D.rootSubgroupPoints_mem_subsystemPoints A hγ u

/-- The punctured positive subgroup is contained in `D.positivePoints A`. -/
theorem puncturedPositivePoints_le_positivePoints (A : Type v) [CommRing A] (i : Fin t.rank) :
    D.puncturedPositivePoints A i ≤ D.positivePoints A := by
  rw [D.positivePoints_def, D.puncturedPositivePoints_def]
  exact D.subsystemPoints_mono Set.sdiff_subset A

/-- The positive point subgroup is the join of the punctured positive subgroup and the omitted
simple root subgroup. -/
theorem positivePoints_eq_puncturedPositivePoints_sup (A : Type v) [CommRing A]
    (i : Fin t.rank) :
    D.positivePoints A =
      D.puncturedPositivePoints A i ⊔ (D.rootSubgroupPoints (t.simpleIndex ht i) A).range := by
  rw [D.positivePoints_def, D.puncturedPositivePoints_def]
  conv_lhs =>
    rw [posRoots_eq_diff_union_simpleIndex i, D.subsystemPoints_union,
      D.subsystemPoints_eq_iSup {t.simpleIndex ht i} A, iSup_singleton]

/-- Ring maps preserve punctured positive points. -/
theorem map_puncturedPositivePoints_le {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    (f : A →+* B) (i : Fin t.rank) :
    (D.puncturedPositivePoints A i).map
        ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      D.puncturedPositivePoints B i :=
  D.map_subsystemPoints_le _ f

variable (A : Type v) [CommRing A]

/-- The opposite simple-root pair normalizes the punctured positive subgroup generated by all the
other positive roots, over every commutative value ring. -/
theorem closure_simpleRootPair_le_normalizer_puncturedPositivePoints (i : Fin t.rank) :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer (D.puncturedPositivePoints A i : Set (D.points A)) := by
  let α := t.simpleIndex ht i
  let β := (t.simplyConnectedRootDatum ht).reflectionPerm α α
  let e := Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
  let f := e.symm.toMonoidHom.comp (D.points A).subtype
  have hinj : Function.Injective f := e.symm.injective.comp (D.points A).subtype_injective
  let U : Subgroup (D.points A) := D.puncturedPositivePoints A i
  have hpairPoints :
      Subgroup.closure (Set.range (D.rootSubgroupPoints α A) ∪
          Set.range (D.rootSubgroupPoints β A)) =
        D.subsystemPoints {α, β} A := by
    rw [Subgroup.closure_union, ← MonoidHom.coe_range, ← MonoidHom.coe_range,
      Subgroup.closure_eq, Subgroup.closure_eq, D.subsystemPoints_eq_iSup, iSup_pair]
  have hpairSubgroup :
      Subgroup.closure
          (Set.range (chevalleyRootSubgroup D.representation D.lattice
            D.representation_mem_lattice D.isNilpotent_representation_rootGenerator α
            (CommAlgCat.of ℤ A)) ∪
          Set.range (chevalleyRootSubgroup D.representation D.lattice
            D.representation_mem_lattice D.isNilpotent_representation_rootGenerator β
            (CommAlgCat.of ℤ A))) =
        D.subsystemSubgroup {α, β} (CommAlgCat.of ℤ A) := by
    rw [Subgroup.closure_union, ← MonoidHom.coe_range, ← MonoidHom.coe_range,
      Subgroup.closure_eq, Subgroup.closure_eq, D.subsystemSubgroup_eq_iSup, iSup_pair]
  have hU : U.map f = D.subsystemSubgroup
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {α})
      (CommAlgCat.of ℤ A) := by
    rw [← Subgroup.map_map]
    dsimp only [U]
    rw [D.map_puncturedPositivePoints_subtype A i]
    exact (Subgroup.map_symm_eq_iff_map_eq (e := e) _).mpr rfl
  have h := DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ A)
  rw [hpairSubgroup, ← D.subsystemSubgroup_eq_iSup] at h
  -- First express both subgroups in lattice coordinates. The injective coordinate map then
  -- reflects normalization back into the datum's point group.
  have hmap : (D.subsystemPoints {α, β} A).map f ≤ Subgroup.normalizer (U.map f) := by
    have hpair :
        ((D.subsystemSubgroup {α, β} (CommAlgCat.of ℤ A)).map
            (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv)).map
            e.symm.toMonoidHom =
          D.subsystemSubgroup {α, β} (CommAlgCat.of ℤ A) :=
      (Subgroup.map_symm_eq_iff_map_eq (e := e) _).mpr rfl
    rw [← Subgroup.map_map, D.map_subsystemPoints_subtype, hpair, hU]
    exact h
  have hpre := (Subgroup.map_le_iff_le_comap.mp hmap).trans
    ((U.map f).le_normalizer_comap f)
  rw [hpairPoints]
  simpa only [Subgroup.comap_map_eq_self_of_injective hinj] using hpre

/-- The simple root subgroup `X_{αᵢ}` normalizes the punctured positive subgroup `U⁽ⁱ⁾`. -/
theorem range_rootSubgroupPoints_le_normalizer_puncturedPositivePoints (i : Fin t.rank) :
    (D.rootSubgroupPoints (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer (D.puncturedPositivePoints A i : Set (D.points A)) := by
  refine le_trans ?_ (D.closure_simpleRootPair_le_normalizer_puncturedPositivePoints A i)
  rintro _ hx
  exact Subgroup.subset_closure (Or.inl hx)

/-- Every positive point factors through the punctured positive subgroup followed by a chosen
simple root subgroup. No uniqueness of these factors is asserted. -/
theorem mem_positivePoints_iff_exists_mul_rootSubgroupPoints
    (i : Fin t.rank) (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ v ∈ D.puncturedPositivePoints A i,
        ∃ u : Multiplicative A, g = v * D.rootSubgroupPoints (t.simpleIndex ht i) A u := by
  rw [D.positivePoints_eq_puncturedPositivePoints_sup A i,
    Subgroup.mem_sup_of_right_le_normalizer_left
      (D.range_rootSubgroupPoints_le_normalizer_puncturedPositivePoints A i)]
  constructor
  · rintro ⟨v, hv, _, ⟨u, rfl⟩, rfl⟩
    exact ⟨v, hv, u, rfl⟩
  · rintro ⟨v, hv, u, rfl⟩
    exact ⟨v, hv, _, ⟨u, rfl⟩, rfl⟩

/-- Every pinned simple Weyl element `n_{αᵢ}(s)` normalizes the punctured positive subgroup
generated by all positive roots other than `αᵢ`. -/
theorem weylElement_mem_normalizer_puncturedPositivePoints
    (i : Fin t.rank) (s : Aˣ) :
    D.weylElement (t.simpleIndex ht i) A s ∈
      Subgroup.normalizer (D.puncturedPositivePoints A i : Set (D.points A)) :=
  D.closure_simpleRootPair_le_normalizer_puncturedPositivePoints A i
    (D.weylElement_mem_closure_rootPair (t.simpleIndex ht i) A s)

/-- Every positive point is a product of a point of a chosen simple root subgroup followed by a
point generated by the other positive roots. -/
theorem mem_positivePoints_iff_exists_rootSubgroupPoints_mul
    (i : Fin t.rank) (g : D.points A) :
    g ∈ D.positivePoints A ↔
      ∃ u : Multiplicative A,
        ∃ v ∈ D.puncturedPositivePoints A i,
          g = D.rootSubgroupPoints (t.simpleIndex ht i) A u * v := by
  rw [← inv_mem_iff, D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints A i]
  constructor
  · rintro ⟨v, hv, u, h⟩
    refine ⟨u⁻¹, v⁻¹, inv_mem hv, ?_⟩
    rw [map_inv, ← mul_inv_rev, ← h, inv_inv]
  · rintro ⟨u, v, hv, rfl⟩
    exact ⟨v⁻¹, inv_mem hv, u⁻¹, by rw [map_inv, mul_inv_rev]⟩

/-- The positive point subgroup normalizes the punctured positive subgroup generated by all
positive roots other than `αᵢ`. -/
theorem positivePoints_le_normalizer_puncturedPositivePoints (i : Fin t.rank) :
    D.positivePoints A ≤
      Subgroup.normalizer (D.puncturedPositivePoints A i : Set (D.points A)) := by
  rw [D.positivePoints_eq_puncturedPositivePoints_sup A i]
  exact sup_le (Subgroup.le_normalizer (H := _))
    (D.range_rootSubgroupPoints_le_normalizer_puncturedPositivePoints A i)

/-- The actual character-lattice torus normalizes the punctured positive subgroup `U⁽ⁱ⁾`. -/
theorem range_torusPoints_le_normalizer_puncturedPositivePoints (i : Fin t.rank) :
    (D.torusPoints A).range ≤
      Subgroup.normalizer (D.puncturedPositivePoints A i : Set (D.points A)) := by
  rw [D.puncturedPositivePoints_def]
  exact D.range_torusPoints_le_normalizer_subsystemPoints _ A

end TauCeti.DynkinType.ChevalleyDatum
