public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Coordinates
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Parabolic
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.Basic

/-!
# Simple-root quotients of positive Chevalley points

The quotient of the positive point subgroup by the subgroup generated by all positive
root groups except a chosen simple root is the additive group of the value ring.
The simple-root coordinates are natural under arbitrary changes of the value ring and
transform under the actual torus with their root characters. Together they give a surjective
homomorphism whose kernel is generated by the nonsimple positive root groups.

`simpleRootQuotientEquiv` identifies each quotient with `Multiplicative A` (the additive
group of `A` written multiplicatively). `simpleRootCoordinate_eq_positiveRootEquiv_symm`
identifies its coordinate with the simple-root entry of every ordered coordinate chart.

The collection argument is restricted to the roots other than the chosen simple root.
It uses the native height bounds outside G₂ and the native table-index bounds in G₂,
and `positiveRootProduct_inj` for integral uniqueness. The two commutator bounds are
`commutator_range_chevalleyRootSubgroup_le` and
`commutator_range_chevalleyRootSubgroup_g2_le`. No division in the value ring is involved.

## References

* The quotient construction and restricted collectors are adapted from
  [Tau Ceti PR #47461](https://github.com/TauCetiProject/TauCeti/pull/47461), retained at
  [commit 81fef49](https://github.com/TauCetiProject/TauCeti/commit/81fef49abc52d4fecb370a25605370bc2c8a7bd5).
* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 17–18.
* R. W. Carter, *Simple Groups of Lie Type*, §5.3.
-/

public section

open Multiplicative TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v w

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

local notation "PositiveRoot" =>
  {γ // γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)}

private def pin (i : Fin t.rank) : PositiveRoot :=
  ⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩

attribute [local instance high] Algebra.toModule

open scoped Classical in
private theorem punctured_lattice_mem (A : CommAlgCat ℤ) (i : Fin t.rank)
    {g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)}
    (hg : g ∈ D.subsystemSubgroup
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}) A) :
    g ∈ ⨆ γ ∈ Finset.univ.erase (pin (ht := ht) i),
      (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ.val A).range := by
  have hle : D.subsystemSubgroup
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}) A ≤
      ⨆ γ ∈ Finset.univ.erase (pin (ht := ht) i),
        (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ.val A).range := by
    rw [D.subsystemSubgroup_eq_iSup]
    refine iSup₂_le fun γ hγ => le_iSup_of_le ⟨γ, hγ.1⟩ (le_iSup_of_le ?_ le_rfl)
    exact Finset.mem_erase.mpr ⟨fun h => hγ.2 (congrArg Subtype.val h), Finset.mem_univ _⟩
  exact hle hg

private theorem collect_punctured (A : Type v) [CommRing A] (i : Fin t.rank)
    (l : List PositiveRoot) (hl : l.Nodup) (hall : ∀ γ, γ ∈ l ↔ γ ≠ pin i)
    (g : D.points A) (hg : g ∈ D.puncturedPositivePoints A i) :
    ∃ u : PositiveRoot → A, (D.positiveRootProduct l A u : D.points A) = g := by
  obtain ⟨q, hq, hmatrix⟩ := D.mem_puncturedPositivePoints_iff.mp hg
  have hprod := exists_prod_of_mem_iSup_punctured_posRoots_chevalleyRootSubgroup
    D.representation D.lattice D.representation_mem_lattice
    D.isNilpotent_representation_rootGenerator (CommAlgCat.of ℤ A) i l hl hall q
    (punctured_lattice_mem D _ i hq)
  obtain ⟨u, hu⟩ := hprod
  refine ⟨u, Subtype.ext ?_⟩
  rw [D.coe_positiveRootProduct_eq_latticeProduct, hu]
  exact hmatrix

private theorem simple_mem_punctured (A : Type v) [CommRing A] (i : Fin t.rank)
    (a : A) (ha : D.rootSubgroupPoints (t.simpleIndex ht i) A (ofAdd a) ∈
      D.puncturedPositivePoints A i) : a = 0 := by
  classical
  let p : PositiveRoot := pin i
  let l := (Finset.univ.erase p).toList
  have hl : l.Nodup := Finset.nodup_toList _
  have hall (γ : PositiveRoot) : γ ∈ l ↔ γ ≠ p := by
    simp only [l, Finset.mem_toList, Finset.mem_erase, Finset.mem_univ, and_true]
  obtain ⟨u, hu⟩ := collect_punctured D A i l hl hall _ ha
  have hupdate : D.positiveRootProduct l A (Function.update u p 0) =
      D.positiveRootProduct l A u := by
    apply D.positiveRootProduct_congr
    intro γ hγ
    exact Function.update_of_ne ((hall γ).mp hγ) _ _
  have hsingle : D.positiveRootProduct l A (Pi.single p a) = 1 := by
    calc
      D.positiveRootProduct l A (Pi.single p a) = D.positiveRootProduct l A 0 :=
        D.positiveRootProduct_congr l A fun γ hγ =>
          Pi.single_eq_of_ne ((hall γ).mp hγ) _
      _ = 1 := D.positiveRootProduct_zero l A
  have heq : D.positiveRootProduct (p :: l) A (Function.update u p 0) =
      D.positiveRootProduct (p :: l) A (Pi.single p a) := by
    apply Subtype.ext
    simp only [positiveRootProduct_cons, Function.update_self, Pi.single_eq_same,
      hupdate, hsingle, Subgroup.coe_mul, Subgroup.coe_mk,
      ofAdd_zero, map_one, one_mul, mul_one]
    exact hu
  have h := (D.positiveRootProduct_inj (p :: l)
    (List.nodup_cons.mpr ⟨fun hp => ((hall p).mp hp) rfl, hl⟩) A).mp heq p
    List.mem_cons_self
  simpa only [Function.update_self, Pi.single_eq_same] using h.symm

/-- The omitted simple root group meets the punctured positive subgroup trivially. -/
@[simp]
theorem rootSubgroupPoints_simpleIndex_mem_puncturedPositivePoints_iff
    (A : Type v) [CommRing A] (i : Fin t.rank) (u : Multiplicative A) :
    D.rootSubgroupPoints (t.simpleIndex ht i) A u ∈ D.puncturedPositivePoints A i ↔ u = 1 := by
  constructor
  · intro hu
    exact congrArg ofAdd (simple_mem_punctured D A i u.toAdd hu)
  · rintro rfl
    simp

@[simp]
private theorem positiveRootHom_pin_apply (A : Type v) [CommRing A] (i : Fin t.rank)
    (u : Multiplicative A) :
    positiveRootHom D A (pin i) u =
      ⟨D.rootSubgroupPoints (t.simpleIndex ht i) A u,
        D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u⟩ := by
  apply Subtype.ext
  exact D.coe_positiveRootHom A (pin i) u

private theorem lift_punctured_simple_factorization (A : Type v) [CommRing A]
    (i : Fin t.rank) (g : D.positivePoints A) (v : D.points A)
    (hv : v ∈ D.puncturedPositivePoints A i) (u : Multiplicative A)
    (h : (g : D.points A) = v * D.rootSubgroupPoints (t.simpleIndex ht i) A u) :
    g = ⟨v, D.puncturedPositivePoints_le_positivePoints A i hv⟩ *
      positiveRootHom D A (pin i) u := by
  rw [positiveRootHom_pin_apply]
  exact Subtype.ext h

private noncomputable def simpleQuotientMap (A : Type v) [CommRing A] (i : Fin t.rank) :
    Multiplicative A →*
      D.positivePoints A ⧸ (D.puncturedPositivePoints A i).subgroupOf (D.positivePoints A) :=
  (QuotientGroup.mk' _).comp (positiveRootHom D A (pin i))

@[simp]
private theorem simpleQuotientMap_apply (A : Type v) [CommRing A] (i : Fin t.rank)
    (u : Multiplicative A) :
    simpleQuotientMap D A i u = QuotientGroup.mk
      (⟨D.rootSubgroupPoints (t.simpleIndex ht i) A u,
        D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u⟩ :
        D.positivePoints A) := by
  rw [simpleQuotientMap, MonoidHom.comp_apply, positiveRootHom_pin_apply,
    QuotientGroup.mk'_apply]

private theorem simpleQuotientMap_bijective (A : Type v) [CommRing A] (i : Fin t.rank) :
    Function.Bijective (simpleQuotientMap D A i) := by
  constructor
  · apply (MonoidHom.ker_eq_bot_iff _).mp
    apply le_antisymm _ bot_le
    intro u hu
    apply Subgroup.mem_bot.mpr
    apply (D.rootSubgroupPoints_simpleIndex_mem_puncturedPositivePoints_iff A i u).mp
    have hq := MonoidHom.mem_ker.mp hu
    rw [simpleQuotientMap_apply] at hq
    rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at hq
    exact hq
  · intro q
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective _ q
    obtain ⟨v, hv, u, h⟩ := (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints A i g).mp
      g.property
    refine ⟨u, ?_⟩
    have hv' : (QuotientGroup.mk' ((D.puncturedPositivePoints A i).subgroupOf
        (D.positivePoints A))) ⟨v, D.puncturedPositivePoints_le_positivePoints A i hv⟩ = 1 := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
      exact hv
    have hg := lift_punctured_simple_factorization D A i g v hv u h
    rw [hg, map_mul, hv', one_mul, simpleQuotientMap_apply,
      positiveRootHom_pin_apply, QuotientGroup.mk'_apply]

/-- The simple-root quotient, normalized by the chosen root parameter. -/
noncomputable def simpleRootQuotientEquiv (A : Type v) [CommRing A] (i : Fin t.rank) :
    (D.positivePoints A ⧸
      (D.puncturedPositivePoints A i).subgroupOf (D.positivePoints A)) ≃* Multiplicative A :=
  (MulEquiv.ofBijective (simpleQuotientMap D A i)
    (simpleQuotientMap_bijective D A i)).symm

/-- The inverse quotient equivalence is the chosen simple-root homomorphism modulo the kernel. -/
@[simp]
theorem simpleRootQuotientEquiv_symm_apply (A : Type v) [CommRing A] (i : Fin t.rank)
    (u : Multiplicative A) :
    (D.simpleRootQuotientEquiv A i).symm u = QuotientGroup.mk
      (⟨D.rootSubgroupPoints (t.simpleIndex ht i) A u,
        D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u⟩ :
        D.positivePoints A) := by
  rw [simpleRootQuotientEquiv, MulEquiv.symm_symm, MulEquiv.ofBijective_apply,
    simpleQuotientMap_apply]

/-- The coordinate at the simple root `i`, as a homomorphism to the additive group of `A`. -/
noncomputable def simpleRootCoordinate (A : Type v) [CommRing A] (i : Fin t.rank) :
    D.positivePoints A →* Multiplicative A :=
  (D.simpleRootQuotientEquiv A i).toMonoidHom.comp (QuotientGroup.mk' _)

/-- The quotient equivalence on a class is its simple-root coordinate. -/
@[simp]
theorem simpleRootQuotientEquiv_mk (A : Type v) [CommRing A] (i : Fin t.rank)
    (g : D.positivePoints A) :
    D.simpleRootQuotientEquiv A i (QuotientGroup.mk g) =
      D.simpleRootCoordinate A i g := (rfl)

/-- The simple-root coordinate recovers its chosen parameter. -/
@[simp]
theorem simpleRootCoordinate_simpleIndex (A : Type v) [CommRing A] (i : Fin t.rank)
    (u : Multiplicative A) :
    D.simpleRootCoordinate A i
      ⟨D.rootSubgroupPoints (t.simpleIndex ht i) A u,
        D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u⟩ = u := by
  simpa only [D.simpleRootQuotientEquiv_symm_apply, D.simpleRootQuotientEquiv_mk] using
    (D.simpleRootQuotientEquiv A i).apply_symm_apply u

/-- The kernel is the native punctured positive subgroup, restricted to positive points. -/
@[simp]
theorem ker_simpleRootCoordinate (A : Type v) [CommRing A] (i : Fin t.rank) :
    (D.simpleRootCoordinate A i).ker =
      (D.puncturedPositivePoints A i).subgroupOf (D.positivePoints A) := by
  rw [simpleRootCoordinate, MulEquiv.toMonoidHom_eq_coe,
    MonoidHom.ker_mulEquiv_comp, QuotientGroup.ker_mk']

/-- A positive point has zero simple-root coordinate exactly when it is punctured positive. -/
@[simp]
theorem simpleRootCoordinate_eq_one_iff (A : Type v) [CommRing A] (i : Fin t.rank)
    (g : D.positivePoints A) :
    D.simpleRootCoordinate A i g = 1 ↔ (g : D.points A) ∈ D.puncturedPositivePoints A i := by
  rw [← MonoidHom.mem_ker, D.ker_simpleRootCoordinate, Subgroup.mem_subgroupOf]

/-- Multiplying a punctured positive point by the chosen simple-root element recovers
that element's parameter as the simple-root coordinate. -/
@[simp]
theorem simpleRootCoordinate_mul_rootSubgroupPoints_simpleIndex
    (A : Type v) [CommRing A] (i : Fin t.rank) (v : D.positivePoints A)
    (hv : (v : D.points A) ∈ D.puncturedPositivePoints A i) (u : Multiplicative A) :
    D.simpleRootCoordinate A i
      (v * ⟨D.rootSubgroupPoints (t.simpleIndex ht i) A u,
        D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u⟩) = u := by
  rw [map_mul, (D.simpleRootCoordinate_eq_one_iff A i v).mpr hv, one_mul]
  exact D.simpleRootCoordinate_simpleIndex A i u

private theorem simpleRootCoordinate_of_factorization (A : Type v) [CommRing A]
    (i : Fin t.rank) (g : D.positivePoints A) (v : D.points A)
    (hv : v ∈ D.puncturedPositivePoints A i) (u : Multiplicative A)
    (h : (g : D.points A) = v * D.rootSubgroupPoints (t.simpleIndex ht i) A u) :
    D.simpleRootCoordinate A i g = u := by
  rw [lift_punctured_simple_factorization D A i g v hv u h, positiveRootHom_pin_apply]
  exact D.simpleRootCoordinate_mul_rootSubgroupPoints_simpleIndex A i _ hv u

/-- The coordinate vanishes on every other positive root group. -/
@[simp]
theorem simpleRootCoordinate_rootSubgroupPoints (A : Type v) [CommRing A] (i : Fin t.rank)
    (γ : Fin t.numRoots) (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Multiplicative A) :
    D.simpleRootCoordinate A i
      ⟨D.rootSubgroupPoints γ A u, D.rootSubgroupPoints_mem_positivePoints A hγ u⟩ =
      if γ = t.simpleIndex ht i then u else 1 := by
  classical
  split_ifs with h
  · subst γ
    exact D.simpleRootCoordinate_simpleIndex A i u
  · exact (D.simpleRootCoordinate_eq_one_iff A i _).mpr
      (D.rootSubgroupPoints_mem_puncturedPositivePoints A ⟨hγ, h⟩ u)

/-- Each simple-root coordinate is surjective, including over rings with nilpotents. -/
theorem simpleRootCoordinate_surjective (A : Type v) [CommRing A] (i : Fin t.rank) :
    Function.Surjective (D.simpleRootCoordinate A i) := fun u =>
  ⟨_, D.simpleRootCoordinate_simpleIndex A i u⟩

/-- In any ordered product, the simple coordinate is the sum of the parameters at that root. -/
theorem simpleRootCoordinate_positiveRootProduct (A : Type v) [CommRing A] (i : Fin t.rank)
    (l : List PositiveRoot) (u : PositiveRoot → A) :
    D.simpleRootCoordinate A i (D.positiveRootProduct l A u) =
      (l.map fun γ => if γ.val = t.simpleIndex ht i then ofAdd (u γ) else 1).prod := by
  classical
  induction l with
  | nil => simp
  | cons γ l ih =>
    simp only [positiveRootProduct_cons, map_mul,
      D.simpleRootCoordinate_rootSubgroupPoints A i γ.val γ.property,
      List.map_cons, List.prod_cons, ih]

/-- Reading a simple coordinate in any enumeration of all positive roots recovers its parameter.
Thus the simple coordinate is independent of the order. -/
@[simp]
theorem simpleRootCoordinate_positiveRootEquiv (A : Type v) [CommRing A] (i : Fin t.rank)
    (l : List PositiveRoot) (hl : l.Nodup) (hall : ∀ γ, γ ∈ l) (u : PositiveRoot → A) :
    D.simpleRootCoordinate A i (D.positiveRootEquiv l hl hall A u) =
      ofAdd (u ⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩) := by
  classical
  -- List collection uses equality from DecidableEq; use the same lawful equality for counting.
  let : BEq PositiveRoot := instBEqOfDecidableEq
  rw [D.positiveRootEquiv_apply, D.simpleRootCoordinate_positiveRootProduct]
  let p : PositiveRoot := pin i
  rw [List.prod_map_eq_pow_single p _ (fun γ hγ _ => by
    split_ifs with h
    · exact False.elim (hγ (Subtype.ext h))
    · rfl)]
  have hc : l.count p = 1 := List.count_eq_one_of_mem hl (hall p)
  rw [hc, pow_one]
  simp only [p, pin, ite_true]

/-- The simple-root coordinate is the corresponding entry of the inverse coordinate equivalence,
for every ordering of the positive roots. -/
theorem simpleRootCoordinate_eq_positiveRootEquiv_symm (A : Type v) [CommRing A]
    (i : Fin t.rank) (l : List PositiveRoot) (hl : l.Nodup) (hall : ∀ γ, γ ∈ l)
    (g : D.positivePoints A) :
    D.simpleRootCoordinate A i g =
      ofAdd ((D.positiveRootEquiv l hl hall A).symm g
        ⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩) := by
  simpa only [Equiv.apply_symm_apply] using
    D.simpleRootCoordinate_positiveRootEquiv A i l hl hall
      ((D.positiveRootEquiv l hl hall A).symm g)

/-- A positive point has a unique punctured-positive factor followed by a simple-root factor. -/
theorem existsUnique_puncturedPositivePoints_mul_rootSubgroupPoints_simpleIndex
    (A : Type v) [CommRing A] (i : Fin t.rank) (g : D.positivePoints A) :
    ∃! p : D.puncturedPositivePoints A i × Multiplicative A,
      (g : D.points A) = p.1 * D.rootSubgroupPoints (t.simpleIndex ht i) A p.2 := by
  obtain ⟨v, hv, u, h⟩ := (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints A i g).mp
    g.property
  refine ⟨(⟨v, hv⟩, u), h, fun p hp => ?_⟩
  have hu : p.2 = u :=
    (simpleRootCoordinate_of_factorization D A i g p.1 p.1.property p.2 hp).symm.trans
      (simpleRootCoordinate_of_factorization D A i g v hv u h)
  apply Prod.ext _ hu
  apply Subtype.ext
  apply mul_right_cancel (b := D.rootSubgroupPoints (t.simpleIndex ht i) A u)
  simpa only [hu] using hp.symm.trans h

/-- Simple-root coordinates commute with every ring homomorphism, including reductions. -/
@[simp]
theorem simpleRootCoordinate_map {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    (f : A →+* B) (i : Fin t.rank) (g : D.positivePoints A) :
    D.simpleRootCoordinate B i (D.mapPositivePoints f g) =
      ofAdd (f (D.simpleRootCoordinate A i g).toAdd) := by
  classical
  obtain ⟨l, hl, hall⟩ := Finite.exists_univ_list PositiveRoot
  rw [D.simpleRootCoordinate_eq_positiveRootEquiv_symm B i l hl hall,
    D.simpleRootCoordinate_eq_positiveRootEquiv_symm A i l hl hall,
    D.positiveRootEquiv_symm_map, toAdd_ofAdd]

/-- Conjugation by the actual torus scales a simple-root coordinate by that root's character. -/
theorem simpleRootCoordinate_torusPoints_conj (A : Type v) [CommRing A] (i : Fin t.rank)
    (s : Fin t.rank → Aˣ) (g : D.positivePoints A) :
    D.simpleRootCoordinate A i
      ⟨D.torusPoints A s * g * (D.torusPoints A s)⁻¹,
        (Subgroup.mem_normalizer_iff.mp
          (D.range_torusPoints_le_normalizer_positivePoints A ⟨s, rfl⟩) g).mp g.property⟩ =
      ofAdd ((torusCharacter s (D.coordinateRoot (t.simpleIndex ht i)) : A) *
        (D.simpleRootCoordinate A i g).toAdd) := by
  obtain ⟨v, hv, u, h⟩ := (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints A i g).mp
    g.property
  have hcoord := simpleRootCoordinate_of_factorization D A i g v hv u h
  have hvconj := (Subgroup.mem_normalizer_iff.mp
    (D.range_torusPoints_le_normalizer_puncturedPositivePoints A i ⟨s, rfl⟩) v).mp hv
  let w : D.positivePoints A := ⟨D.torusPoints A s * v * (D.torusPoints A s)⁻¹,
    D.puncturedPositivePoints_le_positivePoints A i hvconj⟩
  have heq :
      (⟨D.torusPoints A s * g * (D.torusPoints A s)⁻¹,
        (Subgroup.mem_normalizer_iff.mp
          (D.range_torusPoints_le_normalizer_positivePoints A ⟨s, rfl⟩) g).mp
            g.property⟩ : D.positivePoints A) =
      w * positiveRootHom D A (pin i)
        (ofAdd ((torusCharacter s (D.coordinateRoot (t.simpleIndex ht i)) : A) * u.toAdd)) := by
    apply Subtype.ext
    simp only [positiveRootHom_pin_apply, Subgroup.coe_mul, w]
    rw [h, ← D.torusPoints_conj_rootSubgroupPoints, ofAdd_toAdd]
    group
  rw [heq, hcoord, positiveRootHom_pin_apply]
  exact D.simpleRootCoordinate_mul_rootSubgroupPoints_simpleIndex A i w hvconj _

/-- The simultaneous simple-root coordinates, with the componentwise additive group law. -/
noncomputable def simpleRootCoordinates (A : Type v) [CommRing A] :
    D.positivePoints A →* (Fin t.rank → Multiplicative A) :=
  MonoidHom.pi (D.simpleRootCoordinate A)

/-- Evaluation of the simultaneous coordinate map at a simple root. -/
@[simp]
theorem simpleRootCoordinates_apply (A : Type v) [CommRing A]
    (g : D.positivePoints A) (i : Fin t.rank) :
    D.simpleRootCoordinates A g i = D.simpleRootCoordinate A i g := (rfl)

/-- The simultaneous map onto all simple-root additive groups is surjective. -/
theorem simpleRootCoordinates_surjective (A : Type v) [CommRing A] :
    Function.Surjective (D.simpleRootCoordinates A) := by
  classical
  intro a
  obtain ⟨l, hl, hall⟩ := Finite.exists_univ_list PositiveRoot
  have hinj : Function.Injective (pin (t := t) (ht := ht)) := by
    intro i j h
    apply (t.simpleSupportEquiv ht).injective
    apply Subtype.ext
    simpa only [coe_simpleSupportEquiv, pin] using congrArg Subtype.val h
  let u : PositiveRoot → A := Function.extend (pin (ht := ht)) (fun i => (a i).toAdd) 0
  refine ⟨D.positiveRootEquiv l hl hall A u, funext fun i => ?_⟩
  rw [D.simpleRootCoordinates_apply, D.simpleRootCoordinate_positiveRootEquiv]
  exact congrArg ofAdd (hinj.extend_apply (fun i => (a i).toAdd) 0 i)

/-- The kernel of all simple-root coordinates is generated by the nonsimple positive root groups.
The subgroup is restricted from the ambient datum point group with `Subgroup.subgroupOf`. -/
@[simp]
theorem ker_simpleRootCoordinates (A : Type v) [CommRing A] :
    (D.simpleRootCoordinates A).ker =
      (D.subsystemPoints (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
        (t.rationalBase ht).support) A).subgroupOf (D.positivePoints A) := by
  classical
  ext g
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
  constructor
  · intro hg
    obtain ⟨l, hl, hall⟩ := Finite.exists_univ_list PositiveRoot
    let u := (D.positiveRootEquiv l hl hall A).symm g
    have hsimple (γ : PositiveRoot) (hγ : γ.val ∈ (t.rationalBase ht).support) : u γ = 0 := by
      obtain ⟨i, hi⟩ := exists_simpleIndex_eq_of_mem_support hγ
      have hc := congrFun hg i
      rw [D.simpleRootCoordinates_apply, Pi.one_apply] at hc
      rw [D.simpleRootCoordinate_eq_positiveRootEquiv_symm A i l hl hall] at hc
      have hγ' : γ = ⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ := Subtype.ext hi.symm
      exact hγ' ▸ congrArg toAdd hc
    have hprod : (D.positiveRootProduct l A u : D.points A) ∈ D.subsystemPoints
        (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
          (t.rationalBase ht).support) A := by
      rw [coe_positiveRootProduct]
      apply Subgroup.list_prod_mem
      intro x hx
      obtain ⟨γ, _, rfl⟩ := List.mem_map.mp hx
      by_cases hs : γ.val ∈ (t.rationalBase ht).support
      · simp only [hsimple γ hs, ofAdd_zero, map_one, Subgroup.one_mem]
      · exact D.rootSubgroupPoints_mem_subsystemPoints
          (S := posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
            (t.rationalBase ht).support) A ⟨γ.property, hs⟩ _
    dsimp only [u] at hprod
    rw [D.positiveRootProduct_positiveRootEquiv_symm] at hprod
    exact hprod
  · intro hg
    apply funext
    intro i
    rw [D.simpleRootCoordinates_apply, Pi.one_apply]
    apply (D.simpleRootCoordinate_eq_one_iff A i g).mpr
    have hle : D.subsystemPoints
        (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
          (t.rationalBase ht).support) A ≤ D.puncturedPositivePoints A i := by
      rw [D.puncturedPositivePoints_def]
      apply D.subsystemPoints_mono (A := A)
      intro γ hγ
      exact ⟨hγ.1, fun h => hγ.2 (h ▸ simpleIndex_mem_support i)⟩
    exact hle hg

/-- The simultaneous map commutes with all changes of value ring. -/
@[simp]
theorem simpleRootCoordinates_map {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    (f : A →+* B) (g : D.positivePoints A) :
    D.simpleRootCoordinates B (D.mapPositivePoints f g) =
      fun i => ofAdd (f (D.simpleRootCoordinates A g i).toAdd) := by
  ext i
  exact D.simpleRootCoordinate_map f i g

end TauCeti.DynkinType.ChevalleyDatum
