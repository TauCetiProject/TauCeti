module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Borel
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Weyl
import TauCeti.Algebra.AlgebraicGroup.Chevalley.RankOne

/-!
# Generation by the Borel and Weyl subgroups

For a Chevalley datum, the subgroup generated by the positive roots and the actual torus,
together with the Weyl subgroup, generates exactly the subgroup generated by all roots and
the actual torus. This is the generation assertion needed for a BN-pair on that subgroup.
It holds over every commutative ring, independently of Bruhat decomposition or generation
of all scheme-valued points.

The rank-one identity `ChevalleyDatum.closure_simpleRootPair_eq` recovers each negative
simple-root subgroup from the positive simple-root subgroup, its coroot and its Weyl
representative. The existing signed-simple-root generation theorem then reaches every root.
The torus is the one with character lattice equal to the datum's weight lattice; no
surjectivity of restriction from the full weight lattice is assumed.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19–20 and Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §8.1.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

private theorem closure_simpleRootPair_le_borelSubgroup_sup_weylSubgroup (i : Fin t.rank) :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
      Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      D.borelSubgroup A ⊔ D.weylSubgroup A := by
  rw [D.closure_simpleRootPair_eq, Subgroup.closure_le]
  rintro g ((⟨u, rfl⟩ | ⟨s, rfl⟩) | rfl)
  · apply Subgroup.mem_sup_left
    exact D.positivePoints_le_borelSubgroup A
      (D.rootSubgroupPoints_mem_positivePoints A
        ((mem_posRoots _ _ _).mpr
          (RootPairing.Base.isPos_of_mem_support (t.simpleIndex_mem_support i))) u)
  · rw [D.simpleCorootPoints_eq_torusPoints]
    exact Subgroup.mem_sup_right (D.torusPoints_mem_weylSubgroup A _)
  · exact Subgroup.mem_sup_right (D.weylElement_mem_weylSubgroup A i)

/-- The Borel-type and Weyl subgroups jointly generate the subgroup generated by all root
subgroups and the actual character-lattice torus. This does not assert that they generate
all points of the group scheme. -/
theorem borelSubgroup_sup_weylSubgroup :
    D.borelSubgroup A ⊔ D.weylSubgroup A =
      Subgroup.closure (⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroupPoints γ A)) ⊔
        (D.torusPoints A).range := by
  let E := Subgroup.closure (⋃ γ : Fin t.numRoots,
    Set.range (D.rootSubgroupPoints γ A)) ⊔ (D.torusPoints A).range
  have hx (γ : Fin t.numRoots) (u : Multiplicative A) :
      D.rootSubgroupPoints γ A u ∈ E :=
    Subgroup.mem_sup_left (Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨γ, ⟨u, rfl⟩⟩))
  have hT (s : Fin t.rank → Aˣ) : D.torusPoints A s ∈ E :=
    Subgroup.mem_sup_right ⟨s, rfl⟩
  apply le_antisymm
  · apply sup_le
    · exact (D.borelSubgroup_le_iff A).mpr ⟨fun γ _ u => hx γ u, hT⟩
    · rw [D.weylSubgroup_def, Subgroup.closure_le]
      rintro g (⟨s, rfl⟩ | ⟨i, rfl⟩)
      · exact hT s
      · dsimp only
        rw [D.weylElement_def]
        exact E.mul_mem (E.mul_mem (hx _ _) (hx _ _)) (hx _ _)
  · have hsigned : Subgroup.closure (⋃ i : Fin t.rank,
        Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
          Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
            (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
        D.borelSubgroup A ⊔ D.weylSubgroup A := by
      rw [Subgroup.closure_le]
      intro g hg
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hg
      exact D.closure_simpleRootPair_le_borelSubgroup_sup_weylSubgroup A i
        (Subgroup.subset_closure hi)
    apply sup_le
    · rw [Subgroup.closure_le]
      intro g hg
      obtain ⟨γ, u, rfl⟩ := Set.mem_iUnion.mp hg
      exact hsigned (D.rootSubgroupPoints_mem_closure γ A u)
    · rintro g ⟨s, rfl⟩
      exact Subgroup.mem_sup_right (D.torusPoints_mem_weylSubgroup A s)

end TauCeti.DynkinType.ChevalleyDatum
