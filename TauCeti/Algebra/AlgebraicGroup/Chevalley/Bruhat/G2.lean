module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Bruhat.Basic
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.G2

/-!
# Simple Weyl cells in type G₂

For a G₂ Chevalley datum, let `B` be the subgroup generated by the positive root
subgroups and the actual character-lattice torus, and let `nᵢ` be a pinned simple
Weyl representative. Then `nᵢ B ⊆ B nᵢ Xᵢ`, and consequently
`B nᵢ B = B nᵢ Xᵢ`. This is the local collection step for simple-reflection
Bruhat multiplication. It is not a global Bruhat decomposition; uniqueness of the
factors is not proved here.

The statements hold over every commutative ring, including characteristics two
and three and nonreduced rings. They use the actual torus, without requiring
surjectivity of restriction from the full weight lattice or generation of all
scheme points.

The proofs specialize the type-independent reduction in `Chevalley.Bruhat.Basic`
using `ChevalleyDatum.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton_G2`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §8.3.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

variable {ht : G2.Valid} (D : ChevalleyDatum G2 ht)
variable (A : Type*) [CommRing A]

/-- Left multiplication of a Borel-type point by a simple Weyl representative in G₂ can be
collected into a Borel-type point, that Weyl representative, and a simple-root element. -/
theorem exists_mem_borelSubgroup_weylElement_mul_eq_mul_weylElement_mul_rootSubgroupPoints_G2
    (i : Fin G2.rank) {b : D.points A} (hb : b ∈ D.borelSubgroup A) :
    ∃ b' ∈ D.borelSubgroup A, ∃ u : Multiplicative A,
      D.weylElement (G2.simpleIndex ht i) A 1 * b =
        b' * D.weylElement (G2.simpleIndex ht i) A 1 *
          D.rootSubgroupPoints (G2.simpleIndex ht i) A u :=
  D.exists_mem_borelSubgroup_weylElement_mul_eq_mul_weylElement_mul_rootSubgroupPoints A i
    (D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton_G2 A i) hb

/-- In G₂ a simple Weyl double coset of the Borel-type subgroup has representatives
`b nᵢ xᵢ(u)` over every commutative ring. This asserts existence, not uniqueness, of the factors. -/
theorem mem_doubleCoset_weylElement_borelSubgroup_iff_exists_mul_rootSubgroupPoints_G2
    (i : Fin G2.rank) (g : D.points A) :
    g ∈ DoubleCoset.doubleCoset (D.weylElement (G2.simpleIndex ht i) A 1)
        (D.borelSubgroup A) (D.borelSubgroup A) ↔
      ∃ b ∈ D.borelSubgroup A, ∃ u : Multiplicative A,
        g = b * D.weylElement (G2.simpleIndex ht i) A 1 *
          D.rootSubgroupPoints (G2.simpleIndex ht i) A u :=
  D.mem_doubleCoset_weylElement_borelSubgroup_iff_exists_mul_rootSubgroupPoints A i
    (D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton_G2 A i) g

end TauCeti.DynkinType.ChevalleyDatum
