module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Borel
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.G2
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Torus.Weyl
public import Mathlib.GroupTheory.DoubleCoset

/-!
# Simple Weyl cells in type G₂

For a G₂ Chevalley datum, let `B` be the subgroup generated by the positive root
subgroups and the actual character-lattice torus, and let `nᵢ` be a pinned simple
Weyl representative. Then `nᵢ B ⊆ B nᵢ Xᵢ`, and consequently
`B nᵢ B = B nᵢ Xᵢ`. This is the local collection step for simple-reflection
Bruhat multiplication. It is not a global Bruhat decomposition, and the left
`B` factor is not unique.

The statements hold over every commutative ring, including characteristics two
and three and nonreduced rings. They use the actual torus, without requiring
surjectivity of restriction from the full weight lattice or generation of all
scheme points.

The proof uses the punctured-positive factorization and opposite-root
normalization in `ChevalleyDatum.mem_positivePoints_iff_exists_mul_rootSubgroupPoints_G2`
and `ChevalleyDatum.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton_G2`,
together with the native torus pinning and Weyl-conjugation equations.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §8.3.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

variable {ht : G2.Valid} (D : ChevalleyDatum G2 ht)
variable (A : Type*) [CommRing A]

/-- Multiplying a Borel-type point by a simple Weyl representative in G₂ can be collected
into a Borel-type point, that Weyl representative, and a simple-root element. -/
theorem exists_weylElement_mul_eq_mul_weylElement_mul_rootSubgroupPoints_G2
    (i : Fin G2.rank) {b : D.points A} (hb : b ∈ D.borelSubgroup A) :
    ∃ b' ∈ D.borelSubgroup A, ∃ u : Multiplicative A,
      D.weylElement (G2.simpleIndex ht i) A 1 * b =
        b' * D.weylElement (G2.simpleIndex ht i) A 1 *
          D.rootSubgroupPoints (G2.simpleIndex ht i) A u := by
  let U : Subgroup (D.points A) := ⨆ γ ∈
    posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht) \ {G2.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range
  let n := D.weylElement (G2.simpleIndex ht i) A 1
  -- The rank-one subgroup normalizes the punctured positive subgroup, so its Weyl
  -- representative carries the punctured factor back into the positive subgroup.
  have hn : n ∈ Subgroup.normalizer U :=
    D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton_G2 A i
      (D.weylElement_mem_closure_rootPair (G2.simpleIndex ht i) A 1)
  have hU : U ≤ D.borelSubgroup A := by
    refine iSup₂_le fun γ hγ => ?_
    rintro _ ⟨u, rfl⟩
    exact D.positivePoints_le_borelSubgroup A
      (D.rootSubgroupPoints_mem_positivePoints A hγ.1 u)
  obtain ⟨v, hv, s, rfl⟩ := D.mem_borelSubgroup_iff A |>.mp hb
  obtain ⟨w, hw, u, rfl⟩ :=
    (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints_G2 A i v).mp hv
  have hw' : n * w * n⁻¹ ∈ D.borelSubgroup A :=
    hU ((Subgroup.mem_normalizer_iff.mp hn w).mp hw)
  -- Move the torus to the left using its Weyl conjugate, and scale the remaining
  -- root parameter by the inverse torus character.
  refine ⟨(n * w * n⁻¹) *
    D.torusPoints A (D.simpleReflectionTorusParameter i A s),
    (D.borelSubgroup A).mul_mem hw'
      (D.range_torusPoints_le_borelSubgroup A ⟨_, rfl⟩),
    Multiplicative.ofAdd
      ((torusCharacter (s⁻¹) (D.coordinateRoot (G2.simpleIndex ht i)) : A) * u.toAdd), ?_⟩
  rw [← D.torusPoints_conj_rootSubgroupPoints (G2.simpleIndex ht i) A (s⁻¹) u.toAdd,
    ofAdd_toAdd, map_inv, inv_inv, ← D.weylElement_conj_torusPoints i A s]
  dsimp only [n]
  group

/-- In G₂ a simple Weyl double coset has representatives `b nᵢ xᵢ(u)` over every
commutative ring. This asserts existence, not uniqueness, of the Borel-type factor. -/
theorem mem_doubleCoset_weylElement_iff_exists_mul_rootSubgroupPoints_G2
    (i : Fin G2.rank) (g : D.points A) :
    g ∈ DoubleCoset.doubleCoset (D.weylElement (G2.simpleIndex ht i) A 1)
        (D.borelSubgroup A) (D.borelSubgroup A) ↔
      ∃ b ∈ D.borelSubgroup A, ∃ u : Multiplicative A,
        g = b * D.weylElement (G2.simpleIndex ht i) A 1 *
          D.rootSubgroupPoints (G2.simpleIndex ht i) A u := by
  constructor
  · intro hg
    obtain ⟨a, ha, b, hb, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    obtain ⟨c, hc, u, hu⟩ :=
      D.exists_weylElement_mul_eq_mul_weylElement_mul_rootSubgroupPoints_G2 A i hb
    refine ⟨a * c, (D.borelSubgroup A).mul_mem ha hc, u, ?_⟩
    simpa only [mul_assoc] using congrArg (a * ·) hu
  · rintro ⟨b, hb, u, rfl⟩
    exact DoubleCoset.mem_doubleCoset.mpr ⟨b, hb, _,
      D.positivePoints_le_borelSubgroup A
        (D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u), rfl⟩

end TauCeti.DynkinType.ChevalleyDatum
