module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Borel
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.SimplyConnected
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.SimplyConnectedModule.RootSubgroup
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Elementary.Coordinate

/-!
# Simple Weyl representatives do not preserve the positive Borel

A pinned simple Weyl representative sends its positive simple-root subgroup to the
opposite root subgroup. Its conjugate can therefore belong to the positive Borel-type
subgroup only when the original root element is the identity.

For the full-weight Chevalley datum, primitive root strings detect every nonzero parameter
over every commutative ring. Over a nontrivial ring, the root element with parameter one
thus witnesses the noncontainment required by the last Tits-system axiom. This result
uses the existing Borel subgroup and Weyl words, without assuming Bruhat decomposition or
that all scheme points are generated by root subgroups.

The opposite-intersection argument is supplied by `ChevalleyDatum`'s opposite subgroups;
parameter detection uses `DynkinType.kostantRootSubgroupParam_scLattice_injective`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3.
* R. W. Carter, *Simple Groups of Lie Type*, §8.1.
-/

public section

open TauCeti.UniversalEnvelopingAlgebra

-- Use the scalar structure of the integer algebra in the lattice point maps.
attribute [local instance high] Algebra.toModule

universe v

namespace TauCeti.DynkinType.ChevalleyDatum

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A] (i : Fin t.rank)

/-- Conjugating a positive simple-root element by its pinned Weyl representative lands
in the positive Borel-type subgroup exactly when that root element is trivial. -/
@[simp]
theorem weylElement_conj_simpleRoot_mem_borelSubgroup_iff (u : A) :
    D.weylElement (t.simpleIndex ht i) A 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) A (Multiplicative.ofAdd u) *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ ∈ D.borelSubgroup A ↔
      D.rootSubgroupPoints (t.simpleIndex ht i) A (Multiplicative.ofAdd u) = 1 := by
  constructor
  · intro h
    have hneg : (t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i) ∈
        negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [← t.reflectionPerm_rationalRootSystem ht]
      exact (reflectionPerm_self_mem_negRoots_iff_mem_posRoots _ _ _).mpr
        ((mem_posRoots _ _ _).mpr
          ((t.rationalBase ht).isPos_of_mem_support (t.simpleIndex_mem_support i)))
    rw [D.weylElement_conj_rootSubgroupPoints] at h
    have heq := D.rootSubgroupPoints_eq_one_of_mem_borelSubgroup A hneg _ h
    rw [← D.weylElement_conj_rootSubgroupPoints] at heq
    have hmul := mul_inv_eq_one.mp heq
    exact mul_left_cancel (hmul.trans (mul_one _).symm)
  · intro h
    simpa only [h, mul_one, mul_inv_cancel] using (D.borelSubgroup A).one_mem

end TauCeti.DynkinType.ChevalleyDatum

namespace TauCeti.DynkinType

variable (t : DynkinType) (ht : t.Valid)
variable (A : Type v) [CommRing A] [Nontrivial A] (i : Fin t.rank)

/-- For the full-weight Chevalley datum, every pinned simple Weyl representative conjugates
some element of the positive Borel outside that Borel, even over a nonreduced ring. -/
theorem exists_weylElement_conj_notMem_borelSubgroup_scChevalleyDatum :
    ∃ b : (t.scChevalleyDatum ht).borelSubgroup A,
      (t.scChevalleyDatum ht).weylElement (t.simpleIndex ht i) A 1 * b.val *
        ((t.scChevalleyDatum ht).weylElement (t.simpleIndex ht i) A 1)⁻¹ ∉
          (t.scChevalleyDatum ht).borelSubgroup A := by
  let D := t.scChevalleyDatum ht
  have hpos : t.simpleIndex ht i ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) :=
    (mem_posRoots _ _ _).mpr
      ((t.rationalBase ht).isPos_of_mem_support (t.simpleIndex_mem_support i))
  refine ⟨⟨D.rootSubgroupPoints (t.simpleIndex ht i) A (Multiplicative.ofAdd 1),
    D.positivePoints_le_borelSubgroup A (D.rootSubgroupPoints_mem_positivePoints A hpos _)⟩, ?_⟩
  intro h
  have heq := (D.weylElement_conj_simpleRoot_mem_borelSubgroup_iff A i 1).mp h
  have hmatrix := congrArg Subtype.val heq
  rw [D.coe_rootSubgroupPoints_simpleIndex] at hmatrix
  -- Detect the parameter on the native lattice, using its matrix-coordinate equation.
  let x := kostantRootSubgroupParam (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
    D.representation D.lattice D.representation_mem_lattice (.inl i)
    (D.isNilpotent_representation_rootGenerator (.inl i)) (CommAlgCat.of ℤ A)
  have hparam : x (Multiplicative.ofAdd 1) = 1 := by
    apply Units.map_injective
      (f := (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMonoidHom)
      (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).injective
    simpa only [x, MulEquiv.toMonoidHom_eq_coe, map_one, Subgroup.coe_one] using
      (basisMatrix_kostantRootSubgroupParam (t.lieBasis ht).rootGenerator
        (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator D.basis A (.inl i)
        (Multiplicative.ofAdd 1)).trans hmatrix
  have hinj : Function.Injective x := by
    -- Only the lattice parameter map is unfolded; its matrix coordinates remain abstract.
    dsimp only [x, D, scChevalleyDatum]
    exact t.kostantRootSubgroupParam_scLattice_injective ht A (.inl i)
  have hz : (1 : A) = 0 := by
    simpa only [toAdd_ofAdd, toAdd_one] using
      congrArg Multiplicative.toAdd (hinj (hparam.trans x.map_one.symm))
  exact one_ne_zero hz

end TauCeti.DynkinType
