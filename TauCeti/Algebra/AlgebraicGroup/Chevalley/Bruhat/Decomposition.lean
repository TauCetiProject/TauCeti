/-!
# Steinberg's sharp Bruhat normal form for a Chevalley datum

Over any field `K`, the extended elementary subgroup `D.extendedElementarySubgroup K` is the
disjoint union of the Bruhat cells `D.bruhatCell K w = B(K) n B(K)` indexed by the root-datum Weyl
group (`Chevalley.Bruhat.Basic`). Within each Bruhat cell `B(K) n B(K)` (with
`w = D.weylProjection K n`), Steinberg's sharp normal form refines the left Borel factor to the
inversion subgroup

```text
U_w(K) = ⨆ γ ∈ inversions P b w⁻¹, X_γ(K) = U(K) ∩ n U⁻(K) n⁻¹.
```

Uniqueness of `(u, b) ∈ (n U⁻(A) n⁻¹) × B(A)` in `u * n * b` holds over every commutative ring `A`
because `U⁻(A) ∩ B(A) = 1`. Existence of `(u, b) ∈ U_w(K) × B(K)` is proved by induction on the
inversion count `|inversions P b w⁻¹|`, peeling off a simple root `αᵢ` sent negative by `w⁻¹` via
the rank-one parabolic factorization `U(K) = X_{αᵢ}(K) * U^{αᵢ}(K)` and the normalization of
`U^{αᵢ}(K)` by `nᵢ`. Combining existence and uniqueness identifies
`U(K) ∩ n U⁻(K) n⁻¹ = U_w(K)` and establishes unique factorization on every cell and across
`D.extendedElementarySubgroup K`.

## Main definitions

* `TauCeti.DynkinType.ChevalleyDatum.inversionPoints`: the subgroup `U_w(A) ≤ D.points A` generated
  by the positive root subgroups sent negative by `w⁻¹`.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.range_torusPoints_le_normalizer_inversionPoints`: the actual
  torus normalizes every inversion subgroup over any commutative ring.
* `TauCeti.DynkinType.ChevalleyDatum.bruhatCell_subset_iff`,
  `TauCeti.DynkinType.ChevalleyDatum.eq_of_mem_bruhatCell_of_mem`, and
  `TauCeti.DynkinType.ChevalleyDatum.rootSubgroupPoints_injective`: Bruhat cells are determined by
  any one of their points, and every root subgroup parametrization is injective over any field.
* `TauCeti.DynkinType.ChevalleyDatum.positivePoints_inf_map_negativePoints_conj_eq_inversionPoints`:
  `D.positivePoints K ⊓ (D.negativePoints K).map (MulAut.conj n) = D.inversionPoints K w`.
* `TauCeti.DynkinType.ChevalleyDatum.map_negativePoints_conj_eq_positivePoints` and
  `TauCeti.DynkinType.ChevalleyDatum.map_positivePoints_conj_eq_negativePoints`: a Weyl lift whose
  projection inverts every positive root exchanges `U⁻(K)` and `U(K)` by conjugation.
* `TauCeti.DynkinType.ChevalleyDatum.existsUnique_mul_mul_eq_of_mem_bruhatCell`,
  `TauCeti.DynkinType.ChevalleyDatum.existsUnique_bruhatNormalForm`, and
  `TauCeti.DynkinType.ChevalleyDatum.exists_bruhatNormalForm`: Steinberg's sharp Bruhat normal form
  on each cell and on `D.extendedElementarySubgroup K`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorems 4 and 4'.
* R. W. Carter, *Simple Groups of Lie Type*, §§8.3--8.4.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

section Ring

variable (A : Type v) [CommRing A]

/-- The subgroup `U_w(A) ≤ D.points A` generated by the positive root subgroups whose root indices
are sent negative by `w⁻¹`. -/
noncomputable def inversionPoints (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    Subgroup (D.points A) :=
  ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹,
    (D.rootSubgroupPoints γ A).range

/-- Containment of the inversion subgroup can be checked on all inverted root parameters. -/
theorem inversionPoints_le_iff {A : Type v} [CommRing A]
    {w : (t.simplyConnectedRootDatum ht).weylGroup} {P : Subgroup (D.points A)} :
    D.inversionPoints A w ≤ P ↔
      ∀ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹, ∀ u,
        D.rootSubgroupPoints γ A u ∈ P := by
  simp only [inversionPoints, iSup_le_iff]
  constructor
  · intro h γ hγ u
    exact h γ hγ ⟨u, rfl⟩
  · rintro h γ hγ _ ⟨u, rfl⟩
    exact h γ hγ u

/-- Each root element at an inversion of `w⁻¹` belongs to `D.inversionPoints A w`. -/
@[simp]
theorem rootSubgroupPoints_mem_inversionPoints
    {w : (t.simplyConnectedRootDatum ht).weylGroup} {γ : Fin t.numRoots}
    (hγ : γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹)
    (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.inversionPoints A w :=
  (D.inversionPoints_le_iff.mp le_rfl) γ hγ u

/-- The actual torus normalizes every inversion subgroup over any commutative ring. -/
theorem range_torusPoints_le_normalizer_inversionPoints
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    (D.torusPoints A).range ≤ Subgroup.normalizer (D.inversionPoints A w) := by
  rw [inversionPoints, ← D.subsystemPoints_eq_iSup _ A]
  exact D.range_torusPoints_le_normalizer_subsystemPoints _ A

/-- The inversion subgroup is generated by the root elements at inversions of `w⁻¹`. -/
theorem inversionPoints_eq_closure (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.inversionPoints A w = Subgroup.closure
      {g | ∃ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹,
        ∃ u, D.rootSubgroupPoints γ A u = g} := by
  apply le_antisymm
  · exact D.inversionPoints_le_iff.mpr fun γ hγ u => Subgroup.subset_closure ⟨γ, hγ, u, rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ ⟨γ, hγ, u, rfl⟩
    exact D.rootSubgroupPoints_mem_inversionPoints A hγ u

/-- The inversion subgroup at `1` is trivial. -/
@[simp]
theorem inversionPoints_one : D.inversionPoints A 1 = ⊥ := by
  simp [inversionPoints, inversions_one]

/-- Every inversion subgroup is contained in `D.positivePoints A`. -/
theorem inversionPoints_le_positivePoints (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.inversionPoints A w ≤ D.positivePoints A :=
  D.inversionPoints_le_iff.mpr fun _ hγ u =>
    D.rootSubgroupPoints_mem_positivePoints A
      ((t.posRoots_rationalRootSystem ht).symm ▸ inversions_subset_posRoots _ _ _ hγ) u

/-- Over every commutative ring, the factors `u ∈ n U⁻(A) n⁻¹` and `b ∈ B(A)` in `u * n * b` are
uniquely determined by their product. -/
theorem eq_and_eq_of_mem_map_negativePoints_conj_of_mul_eq {n u₁ u₂ b₁ b₂ : D.points A}
    (hu₁ : u₁ ∈ (D.negativePoints A).map (MulAut.conj n).toMonoidHom)
    (hu₂ : u₂ ∈ (D.negativePoints A).map (MulAut.conj n).toMonoidHom)
    (hb₁ : b₁ ∈ D.borelSubgroup A) (hb₂ : b₂ ∈ D.borelSubgroup A)
    (heq : u₁ * n * b₁ = u₂ * n * b₂) :
    u₁ = u₂ ∧ b₁ = b₂ := by
  have hdisj : Disjoint ((D.negativePoints A).map (MulAut.conj n).toMonoidHom)
      ((D.borelSubgroup A).map (MulAut.conj n).toMonoidHom) :=
    Subgroup.disjoint_map (MulAut.conj n).injective
      (disjoint_iff.mpr (D.negativePoints_inf_borelSubgroup_eq_bot A))
  have hp := Subgroup.mul_mul_injective_of_disjoint
    ((D.negativePoints A).map (MulAut.conj n).toMonoidHom) (D.borelSubgroup A) hdisj
    (a₁ := (⟨u₁, hu₁⟩, ⟨b₁, hb₁⟩)) (a₂ := (⟨u₂, hu₂⟩, ⟨b₂, hb₂⟩)) heq
  exact ⟨congrArg (fun p => (p.1 : D.points A)) hp,
    congrArg (fun p => (p.2 : D.points A)) hp⟩

end Ring

section Field

variable (K : Type v) [Field K]

/-- Two Bruhat cells sharing an element have the same Weyl-group index. -/
theorem eq_of_mem_bruhatCell_of_mem {g : D.points K}
    {w v : (t.simplyConnectedRootDatum ht).weylGroup}
    (hw : g ∈ D.bruhatCell K w) (hv : g ∈ D.bruhatCell K v) : w = v :=
  by_contra fun hne => Set.disjoint_left.mp ((D.disjoint_bruhatCell_iff K).mpr hne) hw hv

/-- Over any field, every root subgroup parametrization of a Chevalley datum is injective. -/
theorem rootSubgroupPoints_injective (γ : Fin t.numRoots) :
    Function.Injective (D.rootSubgroupPoints γ K) := by
  refine D.rootSubgroupPoints_injective_of_simple K (fun i => ?_) γ
  rw [injective_iff_map_eq_one]
  intro u hu
  by_contra hu1
  have hne : Multiplicative.toAdd u ≠ 0 := fun h => hu1 (toAdd_eq_zero.mp h)
  let v : Kˣ := Units.mk0 (Multiplicative.toAdd u) hne
  have hv : D.rootSubgroupPoints (t.simpleIndex ht i) K (Multiplicative.ofAdd (v : K)) = 1 := by
    simpa [v] using hu
  have hexch := D.weylElement_mul_rootSubgroup_mul_weylElement i K v
  dsimp only at hexch
  rw [hv, mul_one, D.weylElement_mul_self i K] at hexch
  have hmem_one : D.simpleCorootPoints i K (-1) ∈ D.bruhatCell K 1 := by
    rw [D.bruhatCell_one K, SetLike.mem_coe, D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  have hmem_si : D.simpleCorootPoints i K (-1) ∈
      D.bruhatCell K
        (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) := by
    rw [hexch, D.bruhatCell_ofIdx_simpleIndex K i]
    have hy :
        D.rootSubgroupPoints (t.simpleIndex ht i) K
            (Multiplicative.ofAdd (-((v⁻¹ : Kˣ) : K))) ∈
          D.borelSubgroup K :=
      D.positivePoints_le_borelSubgroup K
        (D.rootSubgroupPoints_mem_positivePoints K (simpleIndex_mem_posRoots i) _)
    have hh : D.simpleCorootPoints i K (-v⁻¹) ∈ D.borelSubgroup K := by
      rw [D.simpleCorootPoints_eq_torusPoints]
      exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
    exact DoubleCoset.mem_doubleCoset.mpr ⟨_, mul_mem hy hh, _, hy, by group⟩
  exact RootPairing.weylGroup.ofIdx_ne_one (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)
    (D.eq_of_mem_bruhatCell_of_mem K hmem_one hmem_si).symm

/-- Containment of Bruhat cells is equality of their Weyl-group indices. -/
@[simp]
theorem bruhatCell_subset_iff {w v : (t.simplyConnectedRootDatum ht).weylGroup} :
    D.bruhatCell K w ⊆ D.bruhatCell K v ↔ w = v := by
  refine ⟨fun h => ?_, fun h => h ▸ subset_rfl⟩
  obtain ⟨n, rfl⟩ := D.weylProjection_surjective K w
  exact D.eq_of_mem_bruhatCell_of_mem K (D.mem_bruhatCell_weylProjection K n)
    (h (D.mem_bruhatCell_weylProjection K n))

/-- Every element of `D.elementarySubgroup K` belongs to a unique Bruhat cell. -/
theorem existsUnique_mem_bruhatCell_of_mem_elementarySubgroup {g : D.points K}
    (hg : g ∈ D.elementarySubgroup K) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup, g ∈ D.bruhatCell K w :=
  D.existsUnique_mem_bruhatCell_of_mem_extendedElementarySubgroup K
    (D.elementarySubgroup_le_extendedElementarySubgroup K hg)

/-- For every Weyl lift `n ∈ D.weylSubgroup K`, the inversion subgroup at `D.weylProjection K n` is
contained in `n U⁻(K) n⁻¹`. -/
theorem inversionPoints_le_map_negativePoints_conj (n : D.weylSubgroup K) :
    D.inversionPoints K (D.weylProjection K n) ≤
      (D.negativePoints K).map (MulAut.conj (n : D.points K)).toMonoidHom := by
  apply D.inversionPoints_le_iff.mpr
  intro γ hγ u
  let δ := (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹ γ
  have hδ : δ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    simpa only [δ, mem_negRoots, RootPairing.Base.isPos_iff, height_rationalBase] using
      mapsTo_inversions_negRoots _ _ _ hγ
  obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints K n δ
  have hγδ : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n) δ = γ := by
    dsimp only [δ]
    rw [← Equiv.Perm.mul_apply, ← map_mul, mul_inv_cancel, map_one, Equiv.Perm.one_apply]
  refine ⟨D.rootSubgroupPoints δ K
      (Multiplicative.ofAdd ((c⁻¹ : Kˣ) * Multiplicative.toAdd u)),
    D.rootSubgroupPoints_mem_negativePoints K hδ _, ?_⟩
  simpa only [MulEquiv.coe_toMonoidHom, hγδ, Units.mul_inv_cancel_left, ofAdd_toAdd] using
    hc ((c⁻¹ : Kˣ) * Multiplicative.toAdd u)

private theorem map_inversionPoints_weylElement_conj_le (i : Fin t.rank)
    (w : (t.simplyConnectedRootDatum ht).weylGroup)
    (hαinv : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹) :
    (D.inversionPoints K
        ((RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i))⁻¹ *
          w)).map
        (MulAut.conj (D.weylElement (t.simpleIndex ht i) K 1)).toMonoidHom ≤
      D.inversionPoints K w := by
  let : (t.simplyConnectedRootDatum ht).IsReduced := t.isReduced_simplyConnectedRootDatum ht
  have hαsupp : t.simpleIndex ht i ∈ (t.simplyConnectedBase ht).support := by
    rw [← support_rationalBase]
    exact t.simpleIndex_mem_support i
  have hαnot : t.simpleIndex ht i ∉ inversions (t.simplyConnectedRootDatum ht)
      (t.simplyConnectedBase ht)
      (w⁻¹ * RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) :=
    fun hmem => ((mem_inversions_mul_ofIdx_iff_not_mem _ w⁻¹ _
      (isPos_simplyConnectedBase_simpleIndex i)).mp hmem) hαinv
  rw [Subgroup.map_le_iff_le_comap, D.inversionPoints_le_iff]
  intro γ hγ u
  rw [mul_inv_rev, inv_inv] at hγ
  have hγα : γ ≠ t.simpleIndex ht i := fun heq => hαnot (heq ▸ hγ)
  have hγ' := (mem_inversions _ _ _ _).mp hγ
  have hδinv : (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹ := by
    refine (mem_inversions _ _ _ _).mpr ⟨hγ'.1.reflectionPerm hαsupp hγα, ?_⟩
    simpa only [RootPairing.weylGroupToPerm_mul_ofIdx_apply] using hγ'.2
  rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
    ← ofAdd_toAdd u, D.weylElement_conj_rootSubgroupPoints]
  exact D.rootSubgroupPoints_mem_inversionPoints K hδinv _

private theorem exists_inversionPoints_mul_borelSubgroup_step (i : Fin t.rank)
    (n : D.weylSubgroup K)
    (hαinv : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹)
    (ih : ∀ {u₁ : D.points K}, u₁ ∈ D.positivePoints K →
      ∃ u ∈ D.inversionPoints K (D.weylProjection K ((D.simpleWeylLift K i)⁻¹ * n)),
        ∃ b₀ ∈ D.borelSubgroup K,
          u * (((D.simpleWeylLift K i)⁻¹ * n : D.weylSubgroup K) : D.points K) * b₀ =
            u₁ * (((D.simpleWeylLift K i)⁻¹ * n : D.weylSubgroup K) : D.points K))
    {u₁ : D.points K} (hu₁ : u₁ ∈ D.positivePoints K) :
    ∃ u ∈ D.inversionPoints K (D.weylProjection K n),
      ∃ b₀ ∈ D.borelSubgroup K, u * (n : D.points K) * b₀ = u₁ * (n : D.points K) := by
  obtain ⟨a, v, hv, rfl⟩ :=
    (D.mem_positivePoints_iff_exists_rootSubgroupPoints_mul K i u₁).mp hu₁
  have hnorm := Subgroup.inv_mem _
    (D.weylElement_mem_normalizer_positivePoints_diff_singleton K i 1)
  have hv'pos : (D.simpleWeylLift K i : D.points K)⁻¹ * v *
      (D.simpleWeylLift K i : D.points K) ∈ D.positivePoints K :=
    D.iSup_rootSubgroupPoints_diff_singleton_le_positivePoints K i
      (by simpa only [D.coe_simpleWeylLift, inv_inv] using
        (Subgroup.mem_normalizer_iff.mp hnorm v).mp hv)
  obtain ⟨u', hu', b₀, hb₀, hih⟩ := ih hv'pos
  have hu'conj : (D.simpleWeylLift K i : D.points K) * u' *
      (D.simpleWeylLift K i : D.points K)⁻¹ ∈
      D.inversionPoints K (D.weylProjection K n) := by
    rw [map_mul, map_inv, D.weylProjection_simpleWeylLift] at hu'
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, D.coe_simpleWeylLift] using
      D.map_inversionPoints_weylElement_conj_le K i (D.weylProjection K n) hαinv ⟨u', hu', rfl⟩
  have hx_mem : D.rootSubgroupPoints (t.simpleIndex ht i) K a ∈
      D.inversionPoints K (D.weylProjection K n) :=
    D.rootSubgroupPoints_mem_inversionPoints K hαinv a
  refine ⟨D.rootSubgroupPoints (t.simpleIndex ht i) K a *
    ((D.simpleWeylLift K i : D.points K) * u' * (D.simpleWeylLift K i : D.points K)⁻¹),
    mul_mem hx_mem hu'conj, b₀, hb₀, ?_⟩
  have hih' : u' * ((D.simpleWeylLift K i : D.points K)⁻¹ * (n : D.points K)) * b₀ =
      (D.simpleWeylLift K i : D.points K)⁻¹ * v * (n : D.points K) := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv] at hih
    calc
      u' * ((D.simpleWeylLift K i : D.points K)⁻¹ * (n : D.points K)) * b₀
        = (D.simpleWeylLift K i : D.points K)⁻¹ * v * (D.simpleWeylLift K i : D.points K) *
            ((D.simpleWeylLift K i : D.points K)⁻¹ * (n : D.points K)) := hih
      _ = (D.simpleWeylLift K i : D.points K)⁻¹ * v * (n : D.points K) := by group
  calc
    D.rootSubgroupPoints (t.simpleIndex ht i) K a *
        ((D.simpleWeylLift K i : D.points K) * u' *
          (D.simpleWeylLift K i : D.points K)⁻¹) * (n : D.points K) * b₀
      = D.rootSubgroupPoints (t.simpleIndex ht i) K a * (D.simpleWeylLift K i : D.points K) *
          (u' * ((D.simpleWeylLift K i : D.points K)⁻¹ * (n : D.points K)) * b₀) := by group
    _ = D.rootSubgroupPoints (t.simpleIndex ht i) K a * v * (n : D.points K) := by
          rw [hih']; group

private theorem exists_inversionPoints_mul_borelSubgroup_of_ncard_eq (k : ℕ) :
    ∀ (n : D.weylSubgroup K),
      (inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹).ncard = k →
      ∀ {u₁ : D.points K}, u₁ ∈ D.positivePoints K →
        ∃ u ∈ D.inversionPoints K (D.weylProjection K n),
          ∃ b₀ ∈ D.borelSubgroup K, u * (n : D.points K) * b₀ = u₁ * (n : D.points K) := by
  let : (t.simplyConnectedRootDatum ht).IsReduced := t.isReduced_simplyConnectedRootDatum ht
  induction k with
  | zero =>
    intro n hk u₁ hu₁
    have hw1 : D.weylProjection K n = 1 := by
      by_contra hne
      have hpos := ncard_inversions_pos_of_ne_one
        (P := t.simplyConnectedRootDatum ht) (b := t.simplyConnectedBase ht)
        (inv_ne_one.mpr hne)
      omega
    have hnB : (n : D.points K) ∈ D.borelSubgroup K := by
      have hn := D.mem_bruhatCell_weylProjection K n
      rwa [hw1, D.bruhatCell_one] at hn
    refine ⟨1, one_mem _, (n : D.points K)⁻¹ * u₁ * (n : D.points K),
      mul_mem (mul_mem (inv_mem hnB) (D.positivePoints_le_borelSubgroup K hu₁)) hnB, ?_⟩
    group
  | succ k ih =>
    intro n hk u₁ hu₁
    have hwne : (D.weylProjection K n)⁻¹ ≠ 1 := by
      intro h1
      rw [h1, inversions_one, Set.ncard_empty] at hk
      omega
    obtain ⟨α, hαsupp, hαinv⟩ := exists_mem_support_mem_inversions_of_ne_one
      (P := t.simplyConnectedRootDatum ht) (b := t.simplyConnectedBase ht) hwne
    obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support (by rwa [support_rationalBase])
    have hm_ncard :
        (inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K ((D.simpleWeylLift K i)⁻¹ * n))⁻¹).ncard = k := by
      have hm_inv : (D.weylProjection K ((D.simpleWeylLift K i)⁻¹ * n))⁻¹ =
          (D.weylProjection K n)⁻¹ *
            RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
        simp [mul_inv_rev]
      have hstep := ncard_inversions_mul_ofIdx_of_mem
        (t.simplyConnectedRootDatum ht) (D.weylProjection K n)⁻¹ (t.simplyConnectedBase ht)
        hαsupp hαinv
      rw [hm_inv]
      omega
    exact D.exists_inversionPoints_mul_borelSubgroup_step K i n hαinv
      (ih ((D.simpleWeylLift K i)⁻¹ * n) hm_ncard) hu₁

/-- **A lift of the longest Weyl element conjugates `U⁻` onto `U`.** If the Weyl projection of
`n ∈ N(K)` inverts every positive root, then `n U⁻(K) n⁻¹ = U(K)`. -/
theorem map_negativePoints_conj_eq_positivePoints (n : D.weylSubgroup K)
    (hn : inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n) =
      posRoots (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)) :
    (D.negativePoints K).map (MulAut.conj (n : D.points K)).toMonoidHom = D.positivePoints K := by
  have := isReduced_simplyConnectedRootDatum t ht
  rw [D.negativePoints_eq_iSup, D.map_iSup_rootSubgroupPoints_conj, D.positivePoints_eq_iSup,
    posRoots_rationalRootSystem, negRoots_rationalRootSystem,
    eq_longestElement_of_inversions_eq_posRoots hn, image_weylGroupToPerm_longestElement_negRoots]

/-- **A lift of the longest Weyl element conjugates `U` onto `U⁻`.** If the Weyl projection of
`n ∈ N(K)` inverts every positive root, then `n U(K) n⁻¹ = U⁻(K)`. -/
theorem map_positivePoints_conj_eq_negativePoints (n : D.weylSubgroup K)
    (hn : inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n) =
      posRoots (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)) :
    (D.positivePoints K).map (MulAut.conj (n : D.points K)).toMonoidHom = D.negativePoints K := by
  have := isReduced_simplyConnectedRootDatum t ht
  rw [D.positivePoints_eq_iSup, D.map_iSup_rootSubgroupPoints_conj, D.negativePoints_eq_iSup,
    posRoots_rationalRootSystem, negRoots_rationalRootSystem,
    eq_longestElement_of_inversions_eq_posRoots hn, image_weylGroupToPerm_longestElement_posRoots]

/-- **The positive subgroup meets the conjugate opposite unipotent subgroup in the inversion
subgroup:** `U(K) ∩ n U⁻(K) n⁻¹ = U_w(K)` for every Weyl lift `n ∈ D.weylSubgroup K` projecting to
`w`. -/
theorem positivePoints_inf_map_negativePoints_conj_eq_inversionPoints (n : D.weylSubgroup K) :
    D.positivePoints K ⊓
        (D.negativePoints K).map (MulAut.conj (n : D.points K)).toMonoidHom =
      D.inversionPoints K (D.weylProjection K n) := by
  apply le_antisymm
  · rintro u₁ ⟨hu₁pos, hu₁neg⟩
    obtain ⟨u₂, hu₂, b₀, hb₀, heq⟩ :=
      D.exists_inversionPoints_mul_borelSubgroup_of_ncard_eq K _ n rfl hu₁pos
    have hu₂neg := D.inversionPoints_le_map_negativePoints_conj K n hu₂
    have heq' : u₁ * (n : D.points K) * 1 = u₂ * (n : D.points K) * b₀ := by
      rw [mul_one, heq]
    obtain ⟨rfl, -⟩ := D.eq_and_eq_of_mem_map_negativePoints_conj_of_mul_eq K
      hu₁neg hu₂neg (one_mem _) hb₀ heq'
    exact hu₂
  · exact le_inf (D.inversionPoints_le_positivePoints K _)
      (D.inversionPoints_le_map_negativePoints_conj K n)

/-- **Steinberg's sharp Bruhat normal form on a cell:** for every Weyl lift `n ∈ D.weylSubgroup K`
and every `g ∈ D.bruhatCell K (D.weylProjection K n)`, there exist unique
`u ∈ D.inversionPoints K (D.weylProjection K n)` and `b ∈ D.borelSubgroup K` with `u * n * b = g`.
-/
theorem existsUnique_mul_mul_eq_of_mem_bruhatCell (n : D.weylSubgroup K) {g : D.points K}
    (hg : g ∈ D.bruhatCell K (D.weylProjection K n)) :
    ∃! p : D.inversionPoints K (D.weylProjection K n) × D.borelSubgroup K,
      (p.1 : D.points K) * (n : D.points K) * (p.2 : D.points K) = g := by
  rw [D.bruhatCell_weylProjection K n] at hg
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
  obtain ⟨u₁, hu₁, s, rfl⟩ := (D.mem_borelSubgroup_iff K).mp hb₁
  have ht' : (n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K) ∈ D.borelSubgroup K :=
    D.weylSubgroup_inv_conj_torusPoints_mem_borelSubgroup K n s
  obtain ⟨u, hu, b₀, hb₀, heq⟩ :=
    D.exists_inversionPoints_mul_borelSubgroup_of_ncard_eq K _ n rfl hu₁
  let bFinal := b₀ * ((n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K)) * b₂
  have hbFinal : bFinal ∈ D.borelSubgroup K := mul_mem (mul_mem hb₀ ht') hb₂
  have hprod : u * (n : D.points K) * bFinal =
      u₁ * D.torusPoints K s * (n : D.points K) * b₂ := by
    dsimp only [bFinal]
    calc
      u * (n : D.points K) *
          (b₀ * ((n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K)) * b₂)
        = (u * (n : D.points K) * b₀) * (n : D.points K)⁻¹ * D.torusPoints K s *
            (n : D.points K) * b₂ := by group
      _ = u₁ * D.torusPoints K s * (n : D.points K) * b₂ := by rw [heq]; group
  refine ⟨(⟨u, hu⟩, ⟨bFinal, hbFinal⟩), hprod, ?_⟩
  rintro ⟨⟨u', hu'⟩, ⟨b', hb'⟩⟩ h'
  have hEq := D.eq_and_eq_of_mem_map_negativePoints_conj_of_mul_eq K
    (D.inversionPoints_le_map_negativePoints_conj K n hu')
    (D.inversionPoints_le_map_negativePoints_conj K n hu)
    hb' hbFinal (h'.trans hprod.symm)
  exact Prod.ext (Subtype.ext hEq.1) (Subtype.ext hEq.2)

/-- **Global sharp Bruhat normal form on `D.extendedElementarySubgroup K`:** given any section
`rep : W → D.weylSubgroup K` of `D.weylProjection K`, every `g ∈ D.extendedElementarySubgroup K`
factors uniquely as `u * rep w * b` with `w ∈ W`, `u ∈ U_w(K)`, and `b ∈ B(K)`. -/
theorem existsUnique_bruhatNormalForm
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w)
    {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! q : (t.simplyConnectedRootDatum ht).weylGroup × D.points K × D.points K,
      q.2.1 ∈ D.inversionPoints K q.1 ∧
        q.2.2 ∈ D.borelSubgroup K ∧
        q.2.1 * (rep q.1 : D.points K) * q.2.2 = g := by
  obtain ⟨w, hw, hwuniq⟩ := D.existsUnique_mem_bruhatCell_of_mem_extendedElementarySubgroup K hg
  have hw' : g ∈ D.bruhatCell K (D.weylProjection K (rep w)) := by rwa [hrep w]
  obtain ⟨⟨⟨u, hu⟩, ⟨b, hb⟩⟩, hprod, hpuniq⟩ :=
    D.existsUnique_mul_mul_eq_of_mem_bruhatCell K (rep w) hw'
  have hu' : u ∈ D.inversionPoints K w := by rwa [hrep w] at hu
  refine ⟨(w, u, b), ⟨hu', hb, hprod⟩, ?_⟩
  rintro ⟨w₁, u₁, b₁⟩ ⟨hu₁, hb₁, hprod₁⟩
  have hgcell : g ∈ D.bruhatCell K w₁ := by
    rw [← hrep w₁, D.bruhatCell_weylProjection, ← hprod₁]
    exact DoubleCoset.mem_doubleCoset.mpr
      ⟨u₁, D.positivePoints_le_borelSubgroup K
        (D.inversionPoints_le_positivePoints K w₁ hu₁), b₁, hb₁, rfl⟩
  have hww : w₁ = w := hwuniq w₁ hgcell
  subst hww
  have hu₁' : u₁ ∈ D.inversionPoints K (D.weylProjection K (rep w₁)) := by rwa [hrep w₁]
  have hp := hpuniq (⟨u₁, hu₁'⟩, ⟨b₁, hb₁⟩) hprod₁
  exact Prod.ext rfl (Prod.ext
    (congrArg (fun x => (x.1 : D.points K)) hp)
    (congrArg (fun x => (x.2 : D.points K)) hp))

/-- **Existential sharp Bruhat normal form on `D.extendedElementarySubgroup K`:** every
`g ∈ D.extendedElementarySubgroup K` factors as `u * (n : D.points K) * b` with
`n ∈ D.weylSubgroup K`, `u ∈ D.inversionPoints K (D.weylProjection K n)`, and
`b ∈ D.borelSubgroup K`. -/
theorem exists_bruhatNormalForm {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃ (n : D.weylSubgroup K) (u b : D.points K),
      u ∈ D.inversionPoints K (D.weylProjection K n) ∧
      b ∈ D.borelSubgroup K ∧
      u * (n : D.points K) * b = g := by
  let rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K :=
    fun w => (D.weylProjection_surjective K w).choose
  have hrep : ∀ w, D.weylProjection K (rep w) = w :=
    fun w => (D.weylProjection_surjective K w).choose_spec
  obtain ⟨⟨w, u, b⟩, ⟨hu, hb, hprod⟩, -⟩ :=
    D.existsUnique_bruhatNormalForm K rep hrep hg
  exact ⟨rep w, u, b, (hrep w).symm ▸ hu, hb, hprod⟩

end Field

