/-!
# Bruhat decomposition and sharp Bruhat normal form for Chevalley groups

Over any commutative ring `A`, for `g : D.points A`, the unipotent subgroup
`D.bruhatPositivePoints A g = U(A) ∩ g U⁻(A) g⁻¹` meets the conjugate Borel subgroup
`g B(A) g⁻¹` trivially (`disjoint_bruhatPositivePoints_map_conj_borelSubgroup`), so the product
map `(u, b) ↦ u * g * b` on `(U(A) ∩ g U⁻(A) g⁻¹) × B(A)` is injective.

Over any field `K`, transporting the Bruhat decomposition of `D.titsSystem K` along the Weyl-group
isomorphism `D.titsSystemWeylGroupMulEquiv K` decomposes the extended elementary Chevalley group
`E_D(K)` into pairwise disjoint Bruhat cells `D.bruhatCell K w = B(K) n_w B(K)` indexed by the
root-datum Weyl group `W = (t.simplyConnectedRootDatum ht).weylGroup` (`iUnion_bruhatCell`,
`disjoint_bruhatCell_iff`, `existsUnique_mem_bruhatCell`). Descending by root-system inversions via
the parabolic simple-root factorization of `U(K)` identifies `U(K) ∩ n U⁻(K) n⁻¹` for `n ∈ N(K)`
with the subgroup generated by the positive root subgroups inverted by `(D.weylProjection K n)⁻¹`
(`bruhatPositivePoints_eq_iSup`) and establishes Steinberg's sharp Bruhat normal form: each cell
`B(K) n B(K)` is parametrized bijectively by `(U(K) ∩ n U⁻(K) n⁻¹) × B(K)` (`bruhatCellEquiv`),
and for any section `rep : W → N(K)` of `D.weylProjection K`, multiplication gives a global
bijection `(w : W) × (U(K) ∩ rep w U⁻(K) (rep w)⁻¹) × B(K) ≃ E_D(K)` (`bruhatNormalFormEquiv`,
`existsUnique_bruhatNormalForm`).

## Main definitions and results

* `TauCeti.DynkinType.ChevalleyDatum.bruhatPositivePoints`: the subgroup `U(A) ∩ g U⁻(A) g⁻¹`.
* `TauCeti.DynkinType.ChevalleyDatum.bruhatPositivePoints_mul_mul_borelSubgroup_injective`:
  injectivity of `(u, b) ↦ u * g * b` on `bruhatPositivePoints A g × B(A)` over any commutative
  ring `A`.
* `TauCeti.DynkinType.ChevalleyDatum.bruhatCell`: the Bruhat cell `B(K) w B(K) ⊆ G_D(K)` indexed
  by `w : (t.simplyConnectedRootDatum ht).weylGroup`.
* `TauCeti.DynkinType.ChevalleyDatum.iUnion_bruhatCell` and
  `TauCeti.DynkinType.ChevalleyDatum.existsUnique_mem_bruhatCell`: the disjoint Bruhat
  decomposition of `E_D(K)`.
* `TauCeti.DynkinType.ChevalleyDatum.bruhatPositivePoints_eq_iSup`: `U(K) ∩ n U⁻(K) n⁻¹` is the
  subgroup generated by `(D.rootSubgroupPoints γ K).range` for `γ ∈ inversions P b₀ w⁻¹`.
* `TauCeti.DynkinType.ChevalleyDatum.bruhatCellEquiv`,
  `TauCeti.DynkinType.ChevalleyDatum.bruhatNormalFormEquiv`, and
  `TauCeti.DynkinType.ChevalleyDatum.existsUnique_bruhatNormalForm`: the sharp Bruhat normal form
  in each cell and globally on `E_D(K)`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorems 4 and 4′.
* R. W. Carter, *Simple Groups of Lie Type*, §§8.3–8.4.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open Multiplicative

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

section CommRing

variable (A : Type v) [CommRing A]

/-- The unipotent Bruhat coordinate subgroup `U(A) ∩ g U⁻(A) g⁻¹` attached to `g : D.points A`. -/
noncomputable def bruhatPositivePoints (g : D.points A) : Subgroup (D.points A) :=
  D.positivePoints A ⊓ (D.negativePoints A).map (MulAut.conj g).toMonoidHom

theorem bruhatPositivePoints_def (g : D.points A) :
    D.bruhatPositivePoints A g =
      D.positivePoints A ⊓ (D.negativePoints A).map (MulAut.conj g).toMonoidHom :=
  (rfl)

theorem bruhatPositivePoints_le_positivePoints (g : D.points A) :
    D.bruhatPositivePoints A g ≤ D.positivePoints A :=
  inf_le_left

/-- At the identity element, `U(A) ∩ U⁻(A)` is trivial. -/
@[simp]
theorem bruhatPositivePoints_one : D.bruhatPositivePoints A 1 = ⊥ := by
  rw [← le_bot_iff, ← D.negativePoints_inf_borelSubgroup A]
  rintro x ⟨hxpos, hxneg⟩
  obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp hxneg
  rw [map_one, MulEquiv.coe_toMonoidHom, MulAut.one_apply] at hxpos ⊢
  exact ⟨hu, D.positivePoints_le_borelSubgroup A hxpos⟩

/-- Over any commutative ring, `U(A) ∩ g U⁻(A) g⁻¹` meets `g B(A) g⁻¹` trivially because
`U⁻(A) ∩ B(A) = ⊥`. -/
theorem disjoint_bruhatPositivePoints_map_conj_borelSubgroup (g : D.points A) :
    Disjoint (D.bruhatPositivePoints A g)
      ((D.borelSubgroup A).map (MulAut.conj g).toMonoidHom) := by
  rw [disjoint_iff, ← le_bot_iff]
  rintro x ⟨⟨_, hxneg⟩, hxB⟩
  obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp hxneg
  obtain ⟨b, hb, hbeq⟩ := Subgroup.mem_map.mp hxB
  have hub : u = b := (MulAut.conj g).injective hbeq.symm
  have hu_bot : u ∈ (⊥ : Subgroup (D.points A)) := by
    rw [← D.negativePoints_inf_borelSubgroup A]
    exact ⟨hu, hub ▸ hb⟩
  rw [Subgroup.mem_bot.mp hu_bot, map_one]
  exact Subgroup.mem_bot.mpr rfl

/-- Over any commutative ring, the Bruhat coordinate map `(u, b) ↦ u * g * b` on
`(U(A) ∩ g U⁻(A) g⁻¹) × B(A)` is injective. -/
theorem bruhatPositivePoints_mul_mul_borelSubgroup_injective (g : D.points A) :
    Function.Injective
      (fun p : D.bruhatPositivePoints A g × D.borelSubgroup A => (p.1 : D.points A) * g * p.2) :=
  Subgroup.mul_mul_injective_of_disjoint _ _
    (D.disjoint_bruhatPositivePoints_map_conj_borelSubgroup A g)

end CommRing

section Field

variable (K : Type v) [Field K]

private theorem image_subtype_titsSystem_subgroupB :
    (D.extendedElementarySubgroup K).subtype '' ((D.titsSystem K).subgroupB : Set _) =
      (D.borelSubgroup K : Set (D.points K)) := by
  ext x
  simp only [D.titsSystem_subgroupB, Set.mem_image, SetLike.mem_coe, Subgroup.mem_subgroupOf,
    Subgroup.coe_subtype, Subtype.exists, exists_and_left, exists_prop, exists_eq_right_right,
    and_iff_left_iff_imp]
  exact fun hx => D.borelSubgroup_le_extendedElementarySubgroup K hx

/-- The Bruhat cell `B(K) w B(K) ⊆ G_D(K)` indexed by an element `w` of the Weyl group of
`t.simplyConnectedRootDatum ht`. -/
noncomputable def bruhatCell (w : (t.simplyConnectedRootDatum ht).weylGroup) : Set (D.points K) :=
  (D.extendedElementarySubgroup K).subtype ''
    (D.titsSystem K).bruhatCell ((D.titsSystemWeylGroupMulEquiv K).symm w)

/-- For any lift `n ∈ N(K)`, the Bruhat cell indexed by `D.weylProjection K n` is the double coset
`B(K) n B(K)`. -/
@[simp]
theorem bruhatCell_weylProjection (n : D.weylSubgroup K) :
    D.bruhatCell K (D.weylProjection K n) =
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  let n_E : (D.titsSystem K).subgroupN :=
    ⟨⟨n.1, D.weylSubgroup_le_extendedElementarySubgroup K n.2⟩,
      by rw [D.titsSystem_subgroupN]; exact n.2⟩
  have hsymm : (D.titsSystemWeylGroupMulEquiv K).symm (D.weylProjection K n) =
      QuotientGroup.mk n_E :=
    (D.titsSystemWeylGroupMulEquiv K).symm_apply_eq.mpr
      (D.titsSystemWeylGroupMulEquiv_mk K n_E).symm
  rw [bruhatCell, hsymm, TitsSystem.bruhatCell_mk, DoubleCoset.image_doubleCoset,
    D.image_subtype_titsSystem_subgroupB]
  rfl

/-- Every Bruhat cell is contained in the extended elementary Chevalley group `E_D(K)`. -/
theorem bruhatCell_subset_extendedElementarySubgroup
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.bruhatCell K w ⊆ (D.extendedElementarySubgroup K : Set (D.points K)) := by
  rintro _ ⟨x, -, rfl⟩
  exact x.2

/-- The Bruhat cell indexed by `1` is the Borel subgroup `B(K)`. -/
@[simp]
theorem bruhatCell_one : D.bruhatCell K 1 = (D.borelSubgroup K : Set (D.points K)) := by
  rw [bruhatCell, map_one, TitsSystem.bruhatCell_one, D.image_subtype_titsSystem_subgroupB]

/-- Membership in `D.bruhatCell K w` is witnessed by any lift `n ∈ N(K)` of `w`. -/
theorem mem_bruhatCell_iff {g : D.points K} {w : (t.simplyConnectedRootDatum ht).weylGroup} :
    g ∈ D.bruhatCell K w ↔
      ∃ n : D.weylSubgroup K, D.weylProjection K n = w ∧
        g ∈ DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  obtain ⟨n, rfl⟩ := D.weylProjection_surjective K w
  rw [D.bruhatCell_weylProjection]
  refine ⟨fun hg => ⟨n, rfl, hg⟩, ?_⟩
  rintro ⟨m, hm, hg⟩
  rwa [← D.bruhatCell_weylProjection K, ← hm, D.bruhatCell_weylProjection K]

/-- Distinct Weyl-group elements index distinct Bruhat cells in `G_D(K)`. -/
theorem bruhatCell_injective : Function.Injective (D.bruhatCell K) :=
  (Set.image_injective.mpr (Subgroup.subtype_injective _)).comp
    ((D.titsSystem K).bruhatCell_injective.comp (D.titsSystemWeylGroupMulEquiv K).symm.injective)

@[simp]
theorem bruhatCell_inj {w v : (t.simplyConnectedRootDatum ht).weylGroup} :
    D.bruhatCell K w = D.bruhatCell K v ↔ w = v :=
  (D.bruhatCell_injective K).eq_iff

/-- Two Bruhat cells sharing an element have the same Weyl-group index. -/
theorem eq_of_mem_bruhatCell_of_mem {g : D.points K}
    {w v : (t.simplyConnectedRootDatum ht).weylGroup}
    (hw : g ∈ D.bruhatCell K w) (hv : g ∈ D.bruhatCell K v) : w = v := by
  obtain ⟨x, hx, rfl⟩ := hw
  obtain ⟨y, hy, hxy⟩ := hv
  exact (D.titsSystemWeylGroupMulEquiv K).symm.injective
    ((D.titsSystem K).eq_of_mem_bruhatCell_of_mem hx (Subtype.ext hxy ▸ hy))

/-- Two Bruhat cells are disjoint if and only if their Weyl-group indices differ. -/
@[simp]
theorem disjoint_bruhatCell_iff {w v : (t.simplyConnectedRootDatum ht).weylGroup} :
    Disjoint (D.bruhatCell K w) (D.bruhatCell K v) ↔ w ≠ v := by
  rw [bruhatCell, bruhatCell, Set.disjoint_image_iff (Subgroup.subtype_injective _),
    TitsSystem.disjoint_bruhatCell_iff, ne_eq, MulEquiv.apply_eq_iff_eq]

/-- **Bruhat covering of `E_D(K)`**: the union of the Weyl-indexed Bruhat cells is the extended
elementary Chevalley group `E_D(K)`. -/
@[simp]
theorem iUnion_bruhatCell :
    (⋃ w : (t.simplyConnectedRootDatum ht).weylGroup, D.bruhatCell K w) =
      (D.extendedElementarySubgroup K : Set (D.points K)) := by
  simp only [bruhatCell, ← Set.image_iUnion]
  rw [(D.titsSystemWeylGroupMulEquiv K).symm.surjective.iUnion_comp,
    ← TitsSystem.bruhatCells_eq_iUnion_bruhatCell, TitsSystem.bruhatCells_eq_univ,
    Set.image_univ, Subgroup.coe_subtype, Subtype.range_coe_subtype, SetLike.setOfPred_mem_eq]

/-- For simply connected Chevalley data (`D.weightLattice = ⊤`), the Bruhat cells partition the
elementary Chevalley group `D.elementarySubgroup K`. -/
theorem iUnion_bruhatCell_of_weightLattice_eq_top (hΛ : D.weightLattice = ⊤) :
    (⋃ w : (t.simplyConnectedRootDatum ht).weylGroup, D.bruhatCell K w) =
      (D.elementarySubgroup K : Set (D.points K)) := by
  rw [D.iUnion_bruhatCell K,
    D.extendedElementarySubgroup_eq_elementarySubgroup_of_weightLattice_eq_top K hΛ]

/-- **Bruhat decomposition of `E_D(K)`** (Steinberg, *Lectures on Chevalley Groups*, Chapter 3,
Theorem 4): every element of `E_D(K)` belongs to a unique Weyl-indexed Bruhat cell. -/
theorem existsUnique_mem_bruhatCell {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup, g ∈ D.bruhatCell K w := by
  obtain ⟨q, hq, _⟩ := (D.titsSystem K).existsUnique_mem_bruhatCell ⟨g, hg⟩
  refine ⟨D.titsSystemWeylGroupMulEquiv K q, ?_, fun w hw => ?_⟩
  · refine ⟨⟨g, hg⟩, ?_, rfl⟩
    simpa only [MulEquiv.symm_apply_apply] using hq
  · exact D.eq_of_mem_bruhatCell_of_mem K hw
      ⟨⟨g, hg⟩, by simpa only [MulEquiv.symm_apply_apply] using hq, rfl⟩

/-! ### Sharp Bruhat normal form -/

private theorem iSup_inversions_inv_le_bruhatPositivePoints (n : D.weylSubgroup K) :
    (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹,
      (D.rootSubgroupPoints γ K).range) ≤ D.bruhatPositivePoints K (n : D.points K) := by
  refine iSup₂_le fun γ hγ => le_inf ?_ ?_
  · have hpos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [t.posRoots_rationalRootSystem ht]
      exact inversions_subset_posRoots _ _ _ hγ
    rintro _ ⟨a, rfl⟩
    exact D.rootSubgroupPoints_mem_positivePoints K hpos a
  · let δ := (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹ γ
    have hneg : δ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [← not_mem_posRoots_iff_mem_negRoots, t.posRoots_rationalRootSystem ht,
        not_mem_posRoots_iff_mem_negRoots]
      exact mapsTo_inversions_negRoots (t.simplyConnectedRootDatum ht)
        (t.simplyConnectedBase ht) (D.weylProjection K n)⁻¹ hγ
    have hδ_le : (D.rootSubgroupPoints δ K).range ≤ D.negativePoints K := by
      rintro _ ⟨a, rfl⟩
      exact D.rootSubgroupPoints_mem_negativePoints K hneg a
    have hconj : (D.rootSubgroupPoints δ K).range.map
        (MulAut.conj (n : D.points K)).toMonoidHom = (D.rootSubgroupPoints γ K).range := by
      rw [D.map_range_rootSubgroupPoints_conj K n δ]
      have hwδ : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n) δ = γ := by
        dsimp only [δ]
        rw [map_inv, Equiv.Perm.inv_def, Equiv.apply_symm_apply]
      rw [hwδ]
    exact hconj ▸ Subgroup.map_mono hδ_le

private theorem image_reflectionPerm_inversions_mul_ofIdx_subset (i : Fin t.rank)
    {w : (t.simplyConnectedRootDatum ht).weylGroup}
    (hi : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹) :
    (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) ''
        inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (w⁻¹ * RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht)
            (t.simpleIndex ht i)) ⊆
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹ := by
  let _ := t.isReduced_simplyConnectedRootDatum ht
  have hi_supp : t.simpleIndex ht i ∈ (t.simplyConnectedBase ht).support := by
    rw [← t.support_rationalBase ht]
    exact simpleIndex_mem_support i
  rintro _ ⟨γ, hγ, rfl⟩
  have hnot : t.simpleIndex ht i ∉
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (w⁻¹ * RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht)
          (t.simpleIndex ht i)) := fun h =>
    (mem_inversions_mul_ofIdx_iff_not_mem (t.simplyConnectedRootDatum ht) w⁻¹
      (t.simplyConnectedBase ht)
      ((t.simplyConnectedBase ht).isPos_of_mem_support hi_supp)).mp h hi
  have hne : γ ≠ t.simpleIndex ht i := fun h => hnot (h ▸ hγ)
  obtain ⟨hγ_pos, hγ_neg⟩ := (mem_inversions _ _ _ _).mp hγ
  rw [RootPairing.weylGroupToPerm_mul_ofIdx_apply] at hγ_neg
  exact (mem_inversions _ _ _ _).mpr ⟨hγ_pos.reflectionPerm hi_supp hne, hγ_neg⟩

private noncomputable abbrev simpleWeylSubgroupElement (i : Fin t.rank) : D.weylSubgroup K :=
  ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩

private theorem weylElement_conj_mem_iSup_inversions (n : D.weylSubgroup K) (i : Fin t.rank)
    (hi : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹)
    {u' : D.points K}
    (hu' : u' ∈ ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K ((D.simpleWeylSubgroupElement K i)⁻¹ * n))⁻¹,
      (D.rootSubgroupPoints γ K).range) :
    MulAut.conj (D.weylElement (t.simpleIndex ht i) K 1) u' ∈
      ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹, (D.rootSubgroupPoints γ K).range := by
  let r_N := D.simpleWeylSubgroupElement K i
  have hmap : MulAut.conj (r_N : D.points K) u' ∈
      (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K (r_N⁻¹ * n))⁻¹,
        (D.rootSubgroupPoints γ K).range).map (MulAut.conj (r_N : D.points K)).toMonoidHom :=
    Subgroup.mem_map_of_mem _ hu'
  rw [D.map_iSup_rootSubgroupPoints_conj K r_N] at hmap
  have hperm : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K r_N) =
      (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) := by
    ext γ
    simp only [r_N, simpleWeylSubgroupElement, D.weylProjection_weylElement,
      RootPairing.weylGroupToPerm_ofIdx_apply]
  have hproj : (D.weylProjection K (r_N⁻¹ * n))⁻¹ =
      (D.weylProjection K n)⁻¹ *
        RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
    simp only [r_N, simpleWeylSubgroupElement, map_mul, map_inv, mul_inv_rev, inv_inv,
      D.weylProjection_weylElement]
  rw [hperm, hproj] at hmap
  exact biSup_mono (f := fun γ => (D.rootSubgroupPoints γ K).range)
    (image_reflectionPerm_inversions_mul_ofIdx_subset i hi) hmap

private theorem exists_mem_iSup_inversions_step (n : D.weylSubgroup K) (i : Fin t.rank)
    (hi : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹)
    (ih : ∀ {g' : D.points K},
      g' ∈ DoubleCoset.doubleCoset
        ((((D.simpleWeylSubgroupElement K i)⁻¹ * n : D.weylSubgroup K) : D.points K))
        (D.borelSubgroup K) (D.borelSubgroup K) →
      ∃ u' ∈ ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K ((D.simpleWeylSubgroupElement K i)⁻¹ * n))⁻¹,
          (D.rootSubgroupPoints γ K).range,
        ∃ b' ∈ D.borelSubgroup K,
          u' * ((((D.simpleWeylSubgroupElement K i)⁻¹ * n : D.weylSubgroup K) : D.points K)) *
            b' = g')
    {g : D.points K}
    (hg : g ∈ DoubleCoset.doubleCoset (n : D.points K)
      (D.borelSubgroup K) (D.borelSubgroup K)) :
    ∃ u ∈ ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹, (D.rootSubgroupPoints γ K).range,
      ∃ b ∈ D.borelSubgroup K, u * (n : D.points K) * b = g := by
  let r_N := D.simpleWeylSubgroupElement K i
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
  obtain ⟨u₁, hu₁, s₁, rfl⟩ := (D.mem_borelSubgroup_iff K).mp hb₁
  obtain ⟨a, v, hv, rfl⟩ :=
    (D.mem_positivePoints_iff_exists_rootSubgroupPoints_mul_mem_puncturedPositivePoints
      i K u₁).mp hu₁
  let t' := (n : D.points K)⁻¹ * D.torusPoints K s₁ * (n : D.points K)
  have ht' : t' ∈ D.borelSubgroup K := D.range_torusPoints_le_borelSubgroup K (by
    simpa only [t', Subgroup.coe_inv, inv_inv] using
      (Subgroup.mem_normalizer_iff.mp
        (D.weylSubgroup_le_normalizer_range_torusPoints K n⁻¹.2) (D.torusPoints K s₁)).mp ⟨s₁, rfl⟩)
  let v' := (r_N : D.points K)⁻¹ * v * (r_N : D.points K)
  have hv' : v' ∈ D.borelSubgroup K := D.positivePoints_le_borelSubgroup K
    (D.puncturedPositivePoints_le_positivePoints i K (by
      simpa only [v', r_N, simpleWeylSubgroupElement, inv_inv] using
        (Subgroup.mem_normalizer_iff.mp
          (Subgroup.inv_mem _
            (D.weylElement_mem_normalizer_puncturedPositivePoints i K)) v).mp hv))
  obtain ⟨u', hu', b', hb', hu'b'⟩ := ih (DoubleCoset.mem_doubleCoset.mpr
    ⟨v', hv', t' * b₂, (D.borelSubgroup K).mul_mem ht' hb₂, rfl⟩)
  refine ⟨D.rootSubgroupPoints (t.simpleIndex ht i) K a * MulAut.conj (r_N : D.points K) u',
    Subgroup.mul_mem _ (Subgroup.mem_iSup_of_mem _ (Subgroup.mem_iSup_of_mem hi ⟨a, rfl⟩))
      (D.weylElement_conj_mem_iSup_inversions K n i hi hu'), b', hb', ?_⟩
  calc D.rootSubgroupPoints (t.simpleIndex ht i) K a * MulAut.conj (r_N : D.points K) u' *
          (n : D.points K) * b'
      = D.rootSubgroupPoints (t.simpleIndex ht i) K a * (r_N : D.points K) *
          (u' * ((r_N⁻¹ * n : D.weylSubgroup K) : D.points K) * b') := by
          simp only [MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv]
          group
    _ = D.rootSubgroupPoints (t.simpleIndex ht i) K a * (r_N : D.points K) *
          (v' * ((r_N⁻¹ * n : D.weylSubgroup K) : D.points K) * (t' * b₂)) := by rw [hu'b']
    _ = D.rootSubgroupPoints (t.simpleIndex ht i) K a * v * D.torusPoints K s₁ *
          (n : D.points K) * b₂ := by
          simp only [v', t', Subgroup.coe_mul, Subgroup.coe_inv]
          group

private theorem exists_mem_iSup_inversions_mul_borelSubgroup_eq_aux :
    ∀ (m : ℕ) (n : D.weylSubgroup K),
      (inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹).ncard = m →
      ∀ {g : D.points K},
        g ∈ DoubleCoset.doubleCoset (n : D.points K)
          (D.borelSubgroup K) (D.borelSubgroup K) →
        ∃ u ∈ ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
            (D.weylProjection K n)⁻¹, (D.rootSubgroupPoints γ K).range,
          ∃ b ∈ D.borelSubgroup K, u * (n : D.points K) * b = g := by
  let _ := t.isReduced_simplyConnectedRootDatum ht
  intro m
  induction m with
  | zero =>
    intro n hm g hg
    have hempty : inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹ = ∅ := (Set.ncard_eq_zero (Set.toFinite _)).mp hm
    have hn_ker : n ∈ (D.weylProjection K).ker :=
      MonoidHom.mem_ker.mpr (inv_eq_one.mp (eq_one_of_inversions_eq_empty hempty))
    have hnB : (n : D.points K) ∈ D.borelSubgroup K :=
      D.range_torusPoints_le_borelSubgroup K ((D.mem_ker_weylProjection_iff K n).mp hn_ker)
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    have hgB : b₁ * (n : D.points K) * b₂ ∈ D.borelSubgroup K :=
      (D.borelSubgroup K).mul_mem ((D.borelSubgroup K).mul_mem hb₁ hnB) hb₂
    refine ⟨1, Subgroup.one_mem _, (n : D.points K)⁻¹ * (b₁ * (n : D.points K) * b₂),
      (D.borelSubgroup K).mul_mem ((D.borelSubgroup K).inv_mem hnB) hgB, by group⟩
  | succ m ih =>
    intro n hm g hg
    have hne : (D.weylProjection K n)⁻¹ ≠ 1 := fun h => by
      rw [h, ncard_inversions_one] at hm
      omega
    obtain ⟨γ, hγ_supp, hγ_inv⟩ := exists_mem_support_mem_inversions_of_ne_one
      (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) hne
    obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support
      ((t.support_rationalBase ht).symm ▸ hγ_supp)
    let r_N : D.weylSubgroup K :=
      ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩
    have hproj : (D.weylProjection K (r_N⁻¹ * n))⁻¹ =
        (D.weylProjection K n)⁻¹ *
          RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
      simp only [r_N, map_mul, map_inv, mul_inv_rev, inv_inv, D.weylProjection_weylElement]
    have hdrop := ncard_inversions_mul_ofIdx_of_mem (t.simplyConnectedRootDatum ht)
      (D.weylProjection K n)⁻¹ (t.simplyConnectedBase ht) hγ_supp hγ_inv
    have hm' : (inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K (r_N⁻¹ * n))⁻¹).ncard = m := by
      rw [hproj]
      omega
    exact D.exists_mem_iSup_inversions_step K n i hγ_inv
      (fun hg' => ih (r_N⁻¹ * n) hm' hg') hg

/-- Over a field, for any Weyl lift `n ∈ N(K)`, the unipotent Bruhat coordinate subgroup
`U(K) ∩ n U⁻(K) n⁻¹` is generated by the positive root subgroups inverted by
`(D.weylProjection K n)⁻¹`. -/
theorem bruhatPositivePoints_eq_iSup (n : D.weylSubgroup K) :
    D.bruhatPositivePoints K (n : D.points K) =
      ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K n)⁻¹,
        (D.rootSubgroupPoints γ K).range := by
  refine le_antisymm (fun u₀ hu₀ => ?_) (D.iSup_inversions_inv_le_bruhatPositivePoints K n)
  have hmem : u₀ * (n : D.points K) * 1 ∈
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) :=
    DoubleCoset.mem_doubleCoset.mpr
      ⟨u₀, D.positivePoints_le_borelSubgroup K (D.bruhatPositivePoints_le_positivePoints K _ hu₀),
        1, (D.borelSubgroup K).one_mem, rfl⟩
  obtain ⟨u, hu, b, hb, heq⟩ :=
    D.exists_mem_iSup_inversions_mul_borelSubgroup_eq_aux K _ n rfl hmem
  have hu_bp : u ∈ D.bruhatPositivePoints K (n : D.points K) :=
    D.iSup_inversions_inv_le_bruhatPositivePoints K n hu
  have hinj := D.bruhatPositivePoints_mul_mul_borelSubgroup_injective K (n : D.points K)
    (a₁ := (⟨u, hu_bp⟩, ⟨b, hb⟩)) (a₂ := (⟨u₀, hu₀⟩, ⟨1, (D.borelSubgroup K).one_mem⟩)) heq
  have hu_eq : u = u₀ := congrArg (fun p => (p.1 : D.points K)) hinj
  exact hu_eq ▸ hu

/-- **Sharp Bruhat cell parametrization** (Steinberg, *Lectures on Chevalley Groups*, Chapter 3,
Theorem 4′): for any Weyl lift `n ∈ N(K)`, every element of the Bruhat cell `B(K) n B(K)` writes
uniquely as `u * n * b` with `u ∈ U(K) ∩ n U⁻(K) n⁻¹` and `b ∈ B(K)`. -/
theorem existsUnique_bruhatPositivePoints_mul_mul_borelSubgroup_eq (n : D.weylSubgroup K)
    {g : D.points K} (hg : g ∈ D.bruhatCell K (D.weylProjection K n)) :
    ∃! p : D.bruhatPositivePoints K (n : D.points K) × D.borelSubgroup K,
      (p.1 : D.points K) * (n : D.points K) * p.2 = g := by
  rw [D.bruhatCell_weylProjection] at hg
  obtain ⟨u, hu, b, hb, rfl⟩ :=
    D.exists_mem_iSup_inversions_mul_borelSubgroup_eq_aux K _ n rfl hg
  refine ⟨(⟨u, D.iSup_inversions_inv_le_bruhatPositivePoints K n hu⟩, ⟨b, hb⟩), rfl, ?_⟩
  intro p hp
  exact D.bruhatPositivePoints_mul_mul_borelSubgroup_injective K (n : D.points K) hp

private theorem bruhatPositivePoints_mul_mul_mem_bruhatCell (n : D.weylSubgroup K)
    {w : (t.simplyConnectedRootDatum ht).weylGroup} (hw : D.weylProjection K n = w)
    (p : D.bruhatPositivePoints K (n : D.points K) × D.borelSubgroup K) :
    (p.1 : D.points K) * (n : D.points K) * p.2 ∈ D.bruhatCell K w := by
  rw [← hw, D.bruhatCell_weylProjection]
  exact DoubleCoset.mem_doubleCoset.mpr
    ⟨p.1, D.positivePoints_le_borelSubgroup K
      (D.bruhatPositivePoints_le_positivePoints K _ p.1.2), p.2, p.2.2, rfl⟩

/-- Equivalence `(U(K) ∩ n U⁻(K) n⁻¹) × B(K) ≃ B(K) n B(K)` given by `(u, b) ↦ u * n * b`. -/
noncomputable def bruhatCellEquiv (n : D.weylSubgroup K) :
    D.bruhatPositivePoints K (n : D.points K) × D.borelSubgroup K ≃
      D.bruhatCell K (D.weylProjection K n) :=
  Equiv.ofBijective
    (fun p => ⟨(p.1 : D.points K) * (n : D.points K) * p.2,
      D.bruhatPositivePoints_mul_mul_mem_bruhatCell K n rfl p⟩)
    ⟨fun p₁ p₂ h => D.bruhatPositivePoints_mul_mul_borelSubgroup_injective K (n : D.points K)
      (congrArg Subtype.val h),
     fun ⟨g, hg⟩ => by
      obtain ⟨p, hp, -⟩ := D.existsUnique_bruhatPositivePoints_mul_mul_borelSubgroup_eq K n hg
      exact ⟨p, Subtype.ext hp⟩⟩

@[simp]
theorem coe_bruhatCellEquiv_apply (n : D.weylSubgroup K)
    (p : D.bruhatPositivePoints K (n : D.points K) × D.borelSubgroup K) :
    ((D.bruhatCellEquiv K n p : D.bruhatCell K (D.weylProjection K n)) : D.points K) =
      (p.1 : D.points K) * (n : D.points K) * p.2 :=
  (rfl)

/-- **Global sharp Bruhat normal form** (Steinberg, *Lectures on Chevalley Groups*, Chapter 3,
Theorem 4′): for any section `rep : W → N(K)` of `D.weylProjection K`, multiplication
`(w, u, b) ↦ u * rep w * b` gives an equivalence onto `E_D(K)`. -/
noncomputable def bruhatNormalFormEquiv
    {rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K}
    (hrep : Function.RightInverse rep (D.weylProjection K)) :
    ((w : (t.simplyConnectedRootDatum ht).weylGroup) ×
      D.bruhatPositivePoints K (rep w : D.points K) × D.borelSubgroup K) ≃
      D.extendedElementarySubgroup K :=
  Equiv.ofBijective
    (fun q => ⟨(q.2.1 : D.points K) * (rep q.1 : D.points K) * q.2.2,
      D.bruhatCell_subset_extendedElementarySubgroup K q.1
        (D.bruhatPositivePoints_mul_mul_mem_bruhatCell K (rep q.1) (hrep q.1) q.2)⟩)
    ⟨by
      rintro ⟨w₁, p₁⟩ ⟨w₂, p₂⟩ h
      have heq : (p₁.1 : D.points K) * (rep w₁ : D.points K) * p₁.2 =
          (p₂.1 : D.points K) * (rep w₂ : D.points K) * p₂.2 := congrArg Subtype.val h
      have hw₁ := D.bruhatPositivePoints_mul_mul_mem_bruhatCell K (rep w₁) (hrep w₁) p₁
      have hw₂ := D.bruhatPositivePoints_mul_mul_mem_bruhatCell K (rep w₂) (hrep w₂) p₂
      have hw : w₁ = w₂ := D.eq_of_mem_bruhatCell_of_mem K hw₁ (heq ▸ hw₂)
      subst hw
      exact congrArg (Sigma.mk w₁)
        (D.bruhatPositivePoints_mul_mul_borelSubgroup_injective K (rep w₁ : D.points K) heq),
     fun ⟨g, hg⟩ => by
      obtain ⟨w, hw, -⟩ := D.existsUnique_mem_bruhatCell K hg
      rw [← hrep w] at hw
      obtain ⟨p, hp, -⟩ := D.existsUnique_bruhatPositivePoints_mul_mul_borelSubgroup_eq K (rep w) hw
      exact ⟨⟨w, p⟩, Subtype.ext hp⟩⟩

@[simp]
theorem coe_bruhatNormalFormEquiv_apply
    {rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K}
    (hrep : Function.RightInverse rep (D.weylProjection K))
    (q : (w : (t.simplyConnectedRootDatum ht).weylGroup) ×
      D.bruhatPositivePoints K (rep w : D.points K) × D.borelSubgroup K) :
    ((D.bruhatNormalFormEquiv K hrep q : D.extendedElementarySubgroup K) : D.points K) =
      (q.2.1 : D.points K) * (rep q.1 : D.points K) * q.2.2 :=
  (rfl)

/-- Every element of `E_D(K)` admits a unique sharp Bruhat normal form `u * rep w * b` with
`w ∈ W`, `u ∈ U(K) ∩ rep w U⁻(K) (rep w)⁻¹`, and `b ∈ B(K)`. -/
theorem existsUnique_bruhatNormalForm
    {rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K}
    (hrep : Function.RightInverse rep (D.weylProjection K))
    {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! q : (w : (t.simplyConnectedRootDatum ht).weylGroup) ×
        D.bruhatPositivePoints K (rep w : D.points K) × D.borelSubgroup K,
      (q.2.1 : D.points K) * (rep q.1 : D.points K) * q.2.2 = g := by
  refine ⟨(D.bruhatNormalFormEquiv K hrep).symm ⟨g, hg⟩, ?_, fun q hq => ?_⟩
  · exact congrArg Subtype.val ((D.bruhatNormalFormEquiv K hrep).apply_symm_apply ⟨g, hg⟩)
  · exact (D.bruhatNormalFormEquiv K hrep).eq_symm_apply.mpr (Subtype.ext hq)

end Field

