/-!
# The Tits system and Weyl quotient of a Chevalley datum

For a Chevalley datum `D` over a field `k`, let `B(k) = D.borelSubgroup k` be generated by the
positive root subgroups and the actual weight-lattice torus `T_D(k)`, and let
`N(k) = D.weylSubgroup k` be generated by `T_D(k)` and the pinned simple Weyl representatives
`n_{αᵢ}(1)`. Both subgroups sit inside the extended elementary subgroup
`D.extendedElementarySubgroup k`, which they generate over every commutative ring.

Over every field `k` (including `𝔽₂` and fields of bad characteristic), `B(k)` and `N(k)` form a
Tits system in `D.extendedElementarySubgroup k` whose simple reflections are represented by the
pinned elements `n_{αᵢ}(1)`. Comparing Tits-system word length with inversion sets along the Weyl
projection `D.weylProjection k` shows that the induced map from the Tits-system Weyl group to
`(t.simplyConnectedRootDatum ht).weylGroup` is an isomorphism. Consequently the kernel of
`D.weylProjection k` is `T_D(k)`, giving the canonical isomorphism
`N(k) ⧸ T_D(k) ≃* (t.simplyConnectedRootDatum ht).weylGroup`, and pulling the Tits system back
along `D.elementarySubgroup k ≤ D.extendedElementarySubgroup k` equips the elementary Chevalley
group itself with a Tits system having the same Weyl group.

## Main declarations

* `ChevalleyDatum.borelSubgroup_sup_weylSubgroup_eq_extendedElementarySubgroup`:
  `B(A) ⊔ N(A) = D.extendedElementarySubgroup A` over every commutative ring `A`.
* `ChevalleyDatum.doubleCoset_weylElement_mul_subset_of_notMem_inversions` and
  `ChevalleyDatum.doubleCoset_weylElement_mul_subset_union`: the rank-one multiplication laws for
  `B(k)`-double cosets inside `D.points k`.
* `ChevalleyDatum.titsSystem`: the Tits system on `D.extendedElementarySubgroup k`.
* `ChevalleyDatum.titsSystemWeylGroupMulEquiv`: the isomorphism
  `(D.titsSystem k).WeylGroup ≃* (t.simplyConnectedRootDatum ht).weylGroup`.
* `ChevalleyDatum.ker_weylProjection` and `ChevalleyDatum.weylQuotientMulEquiv`:
  `(D.weylProjection k).ker = T_D(k)` and `N(k) ⧸ T_D(k) ≃* W`.
* `ChevalleyDatum.wordLength_lt_wordLength_titsSystemSimpleRep_mul_iff`:
  left multiplication by the `i`-th simple reflection increases Tits-system word length precisely
  when `αᵢ` is not an inversion of the inverse Weyl element.
* `ChevalleyDatum.elementaryTitsSystem` and
  `ChevalleyDatum.elementaryTitsSystemWeylGroupMulEquiv`: the pulled-back Tits system on
  `D.elementarySubgroup k` and its Weyl-group identification.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 25–28 and Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§7.2 and 8.2.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Chapter IV, §2.
-/

public section

open Multiplicative
open scoped Pointwise

namespace TauCeti.DynkinType.ChevalleyDatum

noncomputable section

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

section CommRing

variable (A : Type v) [CommRing A]

/-- Conjugating any point of the actual weight-lattice torus by an element of `D.weylSubgroup A`
stays inside `D.borelSubgroup A`. -/
theorem weylSubgroup_conj_torusPoints_mem_borelSubgroup
    (w : D.weylSubgroup A) (s : Fin t.rank → Aˣ) :
    (w : D.points A) * D.torusPoints A s * (w : D.points A)⁻¹ ∈ D.borelSubgroup A :=
  D.range_torusPoints_le_borelSubgroup A <|
    (Subgroup.mem_normalizer_iff.mp
      (D.weylSubgroup_le_normalizer_range_torusPoints A w.property)
      (D.torusPoints A s)).mp ⟨s, rfl⟩

/-- The positive Borel-type subgroup lies inside the extended elementary subgroup over every
commutative ring. -/
theorem borelSubgroup_le_extendedElementarySubgroup :
    D.borelSubgroup A ≤ D.extendedElementarySubgroup A := by
  rw [D.borelSubgroup_le_iff]
  exact ⟨fun γ _ u ↦ D.elementarySubgroup_le_extendedElementarySubgroup A
    (D.rootSubgroupPoints_mem_elementarySubgroup A γ u),
    D.torusPoints_mem_extendedElementarySubgroup A⟩

/-- The Weyl subgroup lies inside the extended elementary subgroup over every commutative ring. -/
theorem weylSubgroup_le_extendedElementarySubgroup :
    D.weylSubgroup A ≤ D.extendedElementarySubgroup A := by
  rw [D.weylSubgroup_def, Subgroup.closure_le]
  rintro _ (⟨s, rfl⟩ | ⟨i, rfl⟩)
  · exact D.torusPoints_mem_extendedElementarySubgroup A s
  · dsimp only
    rw [D.weylElement_def]
    exact D.elementarySubgroup_le_extendedElementarySubgroup A
      (mul_mem (mul_mem (D.rootSubgroupPoints_mem_elementarySubgroup A _ _)
        (D.rootSubgroupPoints_mem_elementarySubgroup A _ _))
        (D.rootSubgroupPoints_mem_elementarySubgroup A _ _))

/-- Over every commutative ring, the positive Borel-type subgroup and the Weyl subgroup generate
the extended elementary subgroup. -/
@[simp]
theorem borelSubgroup_sup_weylSubgroup_eq_extendedElementarySubgroup :
    D.borelSubgroup A ⊔ D.weylSubgroup A = D.extendedElementarySubgroup A := by
  apply le_antisymm
    (sup_le (D.borelSubgroup_le_extendedElementarySubgroup A)
      (D.weylSubgroup_le_extendedElementarySubgroup A))
  rw [D.extendedElementarySubgroup_def]
  refine sup_le ?_ (le_sup_of_le_left (D.range_torusPoints_le_borelSubgroup A))
  rw [D.elementarySubgroup_eq_closure_simpleRootPair, Subgroup.closure_le, Set.iUnion_subset_iff]
  intro i
  have hpair : Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
      Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      D.borelSubgroup A ⊔ D.weylSubgroup A := by
    rw [D.closure_simpleRootPair_eq, Subgroup.closure_le]
    rintro g ((⟨u, rfl⟩ | ⟨s, rfl⟩) | rfl)
    · exact Subgroup.mem_sup_left (D.positivePoints_le_borelSubgroup A
        (D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u))
    · rw [D.simpleCorootPoints_eq_torusPoints]
      exact Subgroup.mem_sup_left (D.range_torusPoints_le_borelSubgroup A ⟨_, rfl⟩)
    · exact Subgroup.mem_sup_right (D.weylElement_mem_weylSubgroup A i)
  exact Subgroup.subset_closure.trans hpair

end CommRing

section Field

variable (k : Type v) [Field k]

private theorem simpleIndex_isPos (i : Fin t.rank) :
    (t.simplyConnectedBase ht).IsPos (t.simpleIndex ht i) :=
  RootPairing.Base.isPos_of_mem_support (t.support_rationalBase ht ▸ t.simpleIndex_mem_support i)

/-- **Length-increasing Bruhat multiplication in `D.points k`.** If `αᵢ` is not an inversion of
`(D.weylProjection k w)⁻¹`, then multiplying the simple double coset `B nᵢ B` with `B w B` stays
inside the single double coset `B (nᵢ w) B`. -/
theorem doubleCoset_weylElement_mul_subset_of_notMem_inversions
    (i : Fin t.rank) (w : D.weylSubgroup k)
    (hinv : t.simpleIndex ht i ∉
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection k w)⁻¹) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1)
        (D.borelSubgroup k) (D.borelSubgroup k) *
      DoubleCoset.doubleCoset (w : D.points k)
        (D.borelSubgroup k) (D.borelSubgroup k) ⊆
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1 * w)
        (D.borelSubgroup k) (D.borelSubgroup k) := by
  set n := D.weylElement (t.simpleIndex ht i) k 1
  intro z hz
  obtain ⟨_, hz₁, _, hz₂, rfl⟩ := Set.mem_mul.mp hz
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hz₁
  obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hz₂
  obtain ⟨u, hu, s, hs⟩ := (D.mem_borelSubgroup_iff k).mp (mul_mem hb₂ hb₃)
  obtain ⟨v, hv, a, rfl⟩ := (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints k i u).mp hu
  have hvB : n * v * n⁻¹ ∈ D.borelSubgroup k :=
    D.positivePoints_le_borelSubgroup k
      (D.iSup_rootSubgroupPoints_diff_singleton_le_positivePoints k i
        ((Subgroup.mem_normalizer_iff.mp
          (D.weylElement_mem_normalizer_positivePoints_diff_singleton k i 1) v).mp hv))
  have htB : (w : D.points k)⁻¹ * D.torusPoints k s * (w : D.points k) ∈ D.borelSubgroup k := by
    simpa using D.weylSubgroup_conj_torusPoints_mem_borelSubgroup k w⁻¹ s
  have hβpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k w)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [t.posRoots_rationalRootSystem ht, mem_posRoots]
    by_contra hnot
    exact hinv ((mem_inversions _ _ _ _).mpr ⟨simpleIndex_isPos i, hnot⟩)
  have hx_range : (w : D.points k)⁻¹ * D.rootSubgroupPoints (t.simpleIndex ht i) k a *
      (w : D.points k) ∈ (D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k w)⁻¹
          (t.simpleIndex ht i)) k).range := by
    rw [← map_inv (D.weylProjection k) w,
      ← D.map_range_rootSubgroupPoints_conj k w⁻¹ (t.simpleIndex ht i)]
    exact ⟨D.rootSubgroupPoints (t.simpleIndex ht i) k a, ⟨a, rfl⟩, rfl⟩
  obtain ⟨a', ha'⟩ := hx_range
  have hxB : (w : D.points k)⁻¹ * D.rootSubgroupPoints (t.simpleIndex ht i) k a *
      (w : D.points k) ∈ D.borelSubgroup k := by
    rw [← ha']
    exact D.positivePoints_le_borelSubgroup k
      (D.rootSubgroupPoints_mem_positivePoints k hβpos a')
  rw [DoubleCoset.mem_doubleCoset]
  refine ⟨b₁ * (n * v * n⁻¹), mul_mem hb₁ hvB,
    ((w : D.points k)⁻¹ * D.rootSubgroupPoints (t.simpleIndex ht i) k a * (w : D.points k)) *
      ((w : D.points k)⁻¹ * D.torusPoints k s * (w : D.points k)) * b₄,
    mul_mem (mul_mem hxB htB) hb₄, ?_⟩
  calc
    b₁ * n * b₂ * (b₃ * (w : D.points k) * b₄)
        = b₁ * n * (b₂ * b₃) * (w : D.points k) * b₄ := by group
    _ = b₁ * n * (v * D.rootSubgroupPoints (t.simpleIndex ht i) k a * D.torusPoints k s) *
          (w : D.points k) * b₄ := by rw [← hs]
    _ = _ := by group

/-- **The rank-one Tits multiplication law in `D.points k`.** Over any field, multiplying the
simple double coset `B nᵢ B` with `B w B` lands in `B (nᵢ w) B ∪ B w B`. -/
theorem doubleCoset_weylElement_mul_subset_union
    (i : Fin t.rank) (w : D.weylSubgroup k) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1)
        (D.borelSubgroup k) (D.borelSubgroup k) *
      DoubleCoset.doubleCoset (w : D.points k)
        (D.borelSubgroup k) (D.borelSubgroup k) ⊆
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) k 1 * w)
        (D.borelSubgroup k) (D.borelSubgroup k) ∪
      DoubleCoset.doubleCoset (w : D.points k)
        (D.borelSubgroup k) (D.borelSubgroup k) := by
  classical
  by_cases hinv : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection k w)⁻¹
  · set n := D.weylElement (t.simpleIndex ht i) k 1
    let x := D.rootSubgroupPoints (t.simpleIndex ht i) k
    intro z hz
    obtain ⟨_, hz₁, _, hz₂, rfl⟩ := Set.mem_mul.mp hz
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hz₁
    obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hz₂
    obtain ⟨u, hu, s, hs⟩ := (D.mem_borelSubgroup_iff k).mp (mul_mem hb₂ hb₃)
    obtain ⟨v, hv, a, rfl⟩ :=
      (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints k i u).mp hu
    have hvB : n * v * n⁻¹ ∈ D.borelSubgroup k :=
      D.positivePoints_le_borelSubgroup k
        (D.iSup_rootSubgroupPoints_diff_singleton_le_positivePoints k i
          ((Subgroup.mem_normalizer_iff.mp
            (D.weylElement_mem_normalizer_positivePoints_diff_singleton k i 1) v).mp hv))
    have htB : (w : D.points k)⁻¹ * D.torusPoints k s * (w : D.points k) ∈ D.borelSubgroup k := by
      simpa using D.weylSubgroup_conj_torusPoints_mem_borelSubgroup k w⁻¹ s
    by_cases ha : toAdd a = 0
    · have ha1 : a = 1 := toAdd.injective (ha.trans toAdd_one.symm)
      refine Or.inl (DoubleCoset.mem_doubleCoset.mpr
        ⟨b₁ * (n * v * n⁻¹), mul_mem hb₁ hvB,
          ((w : D.points k)⁻¹ * D.torusPoints k s * (w : D.points k)) * b₄,
          mul_mem htB hb₄, ?_⟩)
      calc
        b₁ * n * b₂ * (b₃ * (w : D.points k) * b₄)
            = b₁ * n * (b₂ * b₃) * (w : D.points k) * b₄ := by group
        _ = b₁ * n * (v * x a * D.torusPoints k s) * (w : D.points k) * b₄ := by rw [← hs]
        _ = b₁ * n * (v * 1 * D.torusPoints k s) * (w : D.points k) * b₄ := by
              rw [ha1, map_one]
        _ = _ := by group
    · -- For a unit root parameter, the rank-one exchange identity absorbs `n` and conjugates the
      -- trailing root factor to `-αᵢ`, which `(D.weylProjection k w)⁻¹` sends back to `posRoots`.
      let u₀ : kˣ := Units.mk0 (toAdd a) ha
      have ha_eq : x a = x (ofAdd (u₀ : k)) := by simp [u₀]
      have hexch : n * x (ofAdd (u₀ : k)) =
          x (ofAdd (-((u₀⁻¹ : kˣ) : k))) * D.simpleCorootPoints i k (-u₀⁻¹) *
            (n * x (ofAdd (-((u₀⁻¹ : kˣ) : k))) * n⁻¹) := by
        have h := D.weylElement_mul_rootSubgroup_mul_weylElement i k u₀
        dsimp only at h
        calc
          n * x (ofAdd (u₀ : k)) = (n * x (ofAdd (u₀ : k)) * n) * n⁻¹ := by group
          _ = (x (ofAdd (-((u₀⁻¹ : kˣ) : k))) * D.simpleCorootPoints i k (-u₀⁻¹) * n *
                x (ofAdd (-((u₀⁻¹ : kˣ) : k)))) * n⁻¹ := by rw [h]
          _ = _ := by group
      have hxL : x (ofAdd (-((u₀⁻¹ : kˣ) : k))) ∈ D.borelSubgroup k :=
        D.positivePoints_le_borelSubgroup k
          (D.rootSubgroupPoints_mem_positivePoints k (simpleIndex_mem_posRoots i) _)
      have hhL : D.simpleCorootPoints i k (-u₀⁻¹) ∈ D.borelSubgroup k := by
        rw [D.simpleCorootPoints_eq_torusPoints]
        exact D.range_torusPoints_le_borelSubgroup k ⟨_, rfl⟩
      let α_neg := (t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)
      have hβpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k w)⁻¹
          α_neg ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
        rw [t.posRoots_rationalRootSystem ht, mem_posRoots]
        have hnot : t.simpleIndex ht i ∉
            inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
              ((D.weylProjection k w)⁻¹ * RootPairing.weylGroup.ofIdx
                (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) := by
          rw [mem_inversions_mul_ofIdx_iff_not_mem _ _ _ (simpleIndex_isPos i)]
          exact not_not.mpr hinv
        have hpos' : (t.simplyConnectedBase ht).IsPos
            ((t.simplyConnectedRootDatum ht).weylGroupToPerm
              ((D.weylProjection k w)⁻¹ * RootPairing.weylGroup.ofIdx
                (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) (t.simpleIndex ht i)) := by
          by_contra hc
          exact hnot ((mem_inversions _ _ _ _).mpr ⟨simpleIndex_isPos i, hc⟩)
        simpa only [α_neg, map_mul, Equiv.Perm.mul_apply,
          RootPairing.weylGroupToPerm_ofIdx_apply] using hpos'
      have hy_range : (w : D.points k)⁻¹ * (n * x (ofAdd (-((u₀⁻¹ : kˣ) : k))) * n⁻¹) *
          (w : D.points k) ∈ (D.rootSubgroupPoints
            ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k w)⁻¹
              α_neg) k).range := by
        rw [← map_inv (D.weylProjection k) w,
          ← D.map_range_rootSubgroupPoints_conj k w⁻¹ α_neg]
        refine ⟨n * x (ofAdd (-((u₀⁻¹ : kˣ) : k))) * n⁻¹, ?_, rfl⟩
        rw [D.weylElement_conj_rootSubgroupPoints]
        exact ⟨_, rfl⟩
      obtain ⟨a', ha'⟩ := hy_range
      have hyB : (w : D.points k)⁻¹ * (n * x (ofAdd (-((u₀⁻¹ : kˣ) : k))) * n⁻¹) *
          (w : D.points k) ∈ D.borelSubgroup k := by
        rw [← ha']
        exact D.positivePoints_le_borelSubgroup k
          (D.rootSubgroupPoints_mem_positivePoints k hβpos a')
      refine Or.inr (DoubleCoset.mem_doubleCoset.mpr
        ⟨b₁ * (n * v * n⁻¹) * x (ofAdd (-((u₀⁻¹ : kˣ) : k))) *
            D.simpleCorootPoints i k (-u₀⁻¹),
          mul_mem (mul_mem (mul_mem hb₁ hvB) hxL) hhL,
          ((w : D.points k)⁻¹ * (n * x (ofAdd (-((u₀⁻¹ : kˣ) : k))) * n⁻¹) *
              (w : D.points k)) *
            ((w : D.points k)⁻¹ * D.torusPoints k s * (w : D.points k)) * b₄,
          mul_mem (mul_mem hyB htB) hb₄, ?_⟩)
      calc
        b₁ * n * b₂ * (b₃ * (w : D.points k) * b₄)
            = b₁ * n * (b₂ * b₃) * (w : D.points k) * b₄ := by group
        _ = b₁ * n * (v * x a * D.torusPoints k s) * (w : D.points k) * b₄ := by rw [← hs]
        _ = b₁ * (n * v * n⁻¹) * (n * x (ofAdd (u₀ : k))) * D.torusPoints k s *
              (w : D.points k) * b₄ := by
              rw [ha_eq]; group
        _ = b₁ * (n * v * n⁻¹) *
              (x (ofAdd (-((u₀⁻¹ : kˣ) : k))) * D.simpleCorootPoints i k (-u₀⁻¹) *
                (n * x (ofAdd (-((u₀⁻¹ : kˣ) : k))) * n⁻¹)) *
              D.torusPoints k s * (w : D.points k) * b₄ := by rw [hexch]
        _ = _ := by group
  · exact (D.doubleCoset_weylElement_mul_subset_of_notMem_inversions k i w hinv).trans
      Set.subset_union_left

private abbrev ExtElemB : Subgroup (D.extendedElementarySubgroup k) :=
  (D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k)

private abbrev ExtElemN : Subgroup (D.extendedElementarySubgroup k) :=
  (D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k)

private theorem extElemB_subgroupOf_extElemN :
    (D.ExtElemB k).subgroupOf (D.ExtElemN k) =
      (((D.torusPoints k).range).subgroupOf (D.weylSubgroup k)).comap
        (Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup k)).toMonoidHom
      := by
  ext n
  -- Expose membership of the underlying datum point on both sides.
  change ((n : D.extendedElementarySubgroup k) : D.points k) ∈ D.borelSubgroup k ↔
    ((n : D.extendedElementarySubgroup k) : D.points k) ∈ (D.torusPoints k).range
  rw [← D.borelSubgroup_inf_weylSubgroup_eq_range_torusPoints k]
  exact ⟨fun h ↦ ⟨h, n.2⟩, fun h ↦ h.1⟩

private instance : ((D.ExtElemB k).subgroupOf (D.ExtElemN k)).Normal := by
  rw [D.extElemB_subgroupOf_extElemN k]
  exact Subgroup.Normal.comap inferInstance _

private def extElemSimpleRep (i : Fin t.rank) : D.ExtElemN k :=
  ⟨⟨D.weylElement (t.simpleIndex ht i) k 1,
    D.weylSubgroup_le_extendedElementarySubgroup k (D.weylElement_mem_weylSubgroup k i)⟩,
    D.weylElement_mem_weylSubgroup k i⟩

private theorem closure_range_mk_extElemSimpleRep :
    Subgroup.closure (Set.range fun i : Fin t.rank ↦
      (QuotientGroup.mk (D.extElemSimpleRep k i) :
        D.ExtElemN k ⧸ (D.ExtElemB k).subgroupOf (D.ExtElemN k))) = ⊤ := by
  let S : Set (D.ExtElemN k ⧸ (D.ExtElemB k).subgroupOf (D.ExtElemN k)) :=
    Set.range fun i : Fin t.rank ↦ QuotientGroup.mk (D.extElemSimpleRep k i)
  refine eq_top_iff.mpr fun q _ ↦ ?_
  induction q using QuotientGroup.induction_on with
  | H n =>
    have hn : ((n : D.extendedElementarySubgroup k) : D.points k) ∈ D.weylSubgroup k := n.2
    suffices ∀ x : D.points k, (hx : x ∈ D.weylSubgroup k) →
        (QuotientGroup.mk (⟨⟨x, D.weylSubgroup_le_extendedElementarySubgroup k hx⟩, hx⟩ :
          D.ExtElemN k) : D.ExtElemN k ⧸ (D.ExtElemB k).subgroupOf (D.ExtElemN k)) ∈
          Subgroup.closure S by
      exact this _ hn
    intro x hx
    have hx' := hx
    rw [D.weylSubgroup_def] at hx'
    induction hx' using Subgroup.closure_induction with
    | mem x hx_mem =>
      rcases hx_mem with ⟨s, rfl⟩ | ⟨i, rfl⟩
      · have hmem : (⟨⟨D.torusPoints k s,
            D.weylSubgroup_le_extendedElementarySubgroup k hx⟩, hx⟩ : D.ExtElemN k) ∈
            (D.ExtElemB k).subgroupOf (D.ExtElemN k) :=
          D.range_torusPoints_le_borelSubgroup k ⟨s, rfl⟩
        rw [(QuotientGroup.eq_one_iff _).mpr hmem]
        exact one_mem _
      · exact Subgroup.subset_closure ⟨i, rfl⟩
    | one =>
      -- Rewrite the packaged identity element as `1 : D.ExtElemN k`.
      change QuotientGroup.mk (1 : D.ExtElemN k) ∈ Subgroup.closure S
      rw [QuotientGroup.mk_one]
      exact one_mem _
    | mul x y hx_w hy_w ihx ihy =>
      have hxW : x ∈ D.weylSubgroup k := by
        rw [D.weylSubgroup_def]
        exact hx_w
      have hyW : y ∈ D.weylSubgroup k := by
        rw [D.weylSubgroup_def]
        exact hy_w
      -- Rewrite the packaged product as a product in `D.ExtElemN k`.
      change QuotientGroup.mk
        ((⟨⟨x, D.weylSubgroup_le_extendedElementarySubgroup k hxW⟩, hxW⟩ : D.ExtElemN k) *
          ⟨⟨y, D.weylSubgroup_le_extendedElementarySubgroup k hyW⟩, hyW⟩) ∈ Subgroup.closure S
      rw [QuotientGroup.mk_mul]
      exact mul_mem (ihx hxW) (ihy hyW)
    | inv x hx_w ihx =>
      have hxW : x ∈ D.weylSubgroup k := by
        rw [D.weylSubgroup_def]
        exact hx_w
      -- Rewrite the packaged inverse as an inverse in `D.ExtElemN k`.
      change QuotientGroup.mk
        ((⟨⟨x, D.weylSubgroup_le_extendedElementarySubgroup k hxW⟩, hxW⟩ : D.ExtElemN k)⁻¹) ∈
        Subgroup.closure S
      rw [QuotientGroup.mk_inv]
      exact inv_mem (ihx hxW)

private theorem doubleCoset_extElemB_coe {x z : D.extendedElementarySubgroup k} :
    z ∈ DoubleCoset.doubleCoset x (D.ExtElemB k) (D.ExtElemB k) ↔
      (z : D.points k) ∈
        DoubleCoset.doubleCoset (x : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) := by
  simp only [DoubleCoset.mem_doubleCoset, SetLike.mem_coe]
  constructor
  · rintro ⟨b₁, hb₁, b₂, hb₂, rfl⟩
    exact ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · rintro ⟨b₁, hb₁, b₂, hb₂, hz⟩
    exact ⟨⟨b₁, D.borelSubgroup_le_extendedElementarySubgroup k hb₁⟩, hb₁,
      ⟨b₂, D.borelSubgroup_le_extendedElementarySubgroup k hb₂⟩, hb₂, Subtype.ext hz⟩

/-- The **Tits system of a Chevalley datum** over any field `k`, inside its extended elementary
subgroup `D.extendedElementarySubgroup k`: `B` is `D.borelSubgroup k`, `N` is `D.weylSubgroup k`,
and the simple reflections are the classes of the pinned Weyl elements `n_{αᵢ}(1)`. -/
def titsSystem : TitsSystem (D.extendedElementarySubgroup k) where
  subgroupB := D.ExtElemB k
  subgroupN := D.ExtElemN k
  closure_subgroupB_union_subgroupN := by
    rw [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq]
    apply Subgroup.map_injective (D.extendedElementarySubgroup k).subtype_injective
    rw [Subgroup.map_sup,
      Subgroup.map_subgroupOf_eq_of_le (D.borelSubgroup_le_extendedElementarySubgroup k),
      Subgroup.map_subgroupOf_eq_of_le (D.weylSubgroup_le_extendedElementarySubgroup k),
      D.borelSubgroup_sup_weylSubgroup_eq_extendedElementarySubgroup k,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  intersection_normal := inferInstance
  simple := Set.range fun i : Fin t.rank ↦ QuotientGroup.mk (D.extElemSimpleRep k i)
  closure_simple := D.closure_range_mk_extElemSimpleRep k
  exists_simpleRep_mul_self_mem s hs := by
    obtain ⟨i, rfl⟩ := hs
    refine ⟨D.extElemSimpleRep k i, rfl, ?_⟩
    -- Unfold subgroup membership of `r * r` to `D.points k`.
    change D.weylElement (t.simpleIndex ht i) k 1 * D.weylElement (t.simpleIndex ht i) k 1 ∈
      D.borelSubgroup k
    rw [D.weylElement_mul_self i k, D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup k ⟨_, rfl⟩
  mul_doubleCoset_subset s hs := by
    obtain ⟨i, rfl⟩ := hs
    refine ⟨D.extElemSimpleRep k i, rfl, fun w z hz ↦ ?_⟩
    obtain ⟨z₁, hz₁, z₂, hz₂, rfl⟩ := Set.mem_mul.mp hz
    rw [D.doubleCoset_extElemB_coe k] at hz₁ hz₂
    have hmem := D.doubleCoset_weylElement_mul_subset_union k i
      ⟨((w : D.extendedElementarySubgroup k) : D.points k), w.2⟩ (Set.mul_mem_mul hz₁ hz₂)
    rw [Set.mem_union, D.doubleCoset_extElemB_coe k, D.doubleCoset_extElemB_coe k]
    simpa only [Set.mem_union, Subgroup.coe_mul, extElemSimpleRep] using hmem
  exists_conj_not_mem s hs := by
    obtain ⟨i, rfl⟩ := hs
    obtain ⟨b, hb⟩ := D.exists_weylElement_conj_notMem_borelSubgroup k i
    exact ⟨D.extElemSimpleRep k i, rfl,
      ⟨⟨b.1, D.borelSubgroup_le_extendedElementarySubgroup k b.2⟩, b.2⟩, hb⟩

/-- The `B` subgroup of `D.titsSystem k` is `D.borelSubgroup k` restricted to the extended
elementary subgroup. -/
@[simp]
theorem titsSystem_subgroupB :
    (D.titsSystem k).subgroupB = (D.borelSubgroup k).subgroupOf (D.extendedElementarySubgroup k) :=
  (rfl)

/-- The `N` subgroup of `D.titsSystem k` is `D.weylSubgroup k` restricted to the extended
elementary subgroup. -/
@[simp]
theorem titsSystem_subgroupN :
    (D.titsSystem k).subgroupN = (D.weylSubgroup k).subgroupOf (D.extendedElementarySubgroup k) :=
  (rfl)

/-- Underlying datum points of `(D.titsSystem k).subgroupN` belong to `D.weylSubgroup k`. -/
theorem titsSystem_subgroupN_coe_mem (n : (D.titsSystem k).subgroupN) :
    ((n : D.extendedElementarySubgroup k) : D.points k) ∈ D.weylSubgroup k := by
  let x : D.extendedElementarySubgroup k := n
  have h : x ∈ (D.titsSystem k).subgroupN := n.property
  rwa [D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] at h

/-- Embed an element of `D.weylSubgroup k` into `(D.titsSystem k).subgroupN`. -/
def toTitsSystemSubgroupN (n : D.weylSubgroup k) : (D.titsSystem k).subgroupN :=
  ⟨⟨n.1, D.weylSubgroup_le_extendedElementarySubgroup k n.2⟩, n.2⟩

/-- Coercing `D.toTitsSystemSubgroupN k n` back to `D.points k` recovers `n`. -/
@[simp]
theorem coe_toTitsSystemSubgroupN (n : D.weylSubgroup k) :
    (((D.toTitsSystemSubgroupN k n : (D.titsSystem k).subgroupN) :
      D.extendedElementarySubgroup k) : D.points k) = n :=
  (rfl)

/-- Membership in `B ∩ N` for `D.titsSystem k` means lying in the actual torus `T_D(k)`. -/
theorem titsSystem_mem_intersection (n : (D.titsSystem k).subgroupN) :
    n ∈ (D.titsSystem k).intersection ↔
      ((n : D.extendedElementarySubgroup k) : D.points k) ∈ (D.torusPoints k).range := by
  rw [TitsSystem.mem_intersection, titsSystem_subgroupB, Subgroup.mem_subgroupOf,
    ← D.borelSubgroup_inf_weylSubgroup_eq_range_torusPoints k]
  exact ⟨fun h ↦ ⟨h, D.titsSystem_subgroupN_coe_mem k n⟩, fun h ↦ h.1⟩

/-- The pinned simple representative `n_{αᵢ}(1)` as an element of `(D.titsSystem k).subgroupN`. -/
def titsSystemSimpleRep (i : Fin t.rank) : (D.titsSystem k).subgroupN :=
  D.extElemSimpleRep k i

/-- Coercing `D.titsSystemSimpleRep k i` to `D.points k` recovers `n_{αᵢ}(1)`. -/
@[simp]
theorem coe_titsSystemSimpleRep (i : Fin t.rank) :
    (((D.titsSystemSimpleRep k i : (D.titsSystem k).subgroupN) :
      D.extendedElementarySubgroup k) : D.points k) =
      D.weylElement (t.simpleIndex ht i) k 1 :=
  (rfl)

/-- The simple reflections of `D.titsSystem k` are the classes of `D.titsSystemSimpleRep k i`. -/
@[simp]
theorem titsSystem_simple :
    (D.titsSystem k).simple =
      Set.range fun i : Fin t.rank ↦
        (QuotientGroup.mk (D.titsSystemSimpleRep k i) : (D.titsSystem k).WeylGroup) :=
  (rfl)

private theorem doubleCoset_titsSystem_subgroupB_coe {x z : D.extendedElementarySubgroup k} :
    z ∈ DoubleCoset.doubleCoset x (D.titsSystem k).subgroupB (D.titsSystem k).subgroupB ↔
      (z : D.points k) ∈
        DoubleCoset.doubleCoset (x : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) := by
  rw [D.titsSystem_subgroupB]
  exact D.doubleCoset_extElemB_coe k

/-- Membership in the Bruhat cell of `D.toTitsSystemSubgroupN k n` inside
`D.extendedElementarySubgroup k` coincides with membership in the `B(k)`-double coset of `n`
inside `D.points k`. -/
theorem mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff
    (n : D.weylSubgroup k) {x : D.extendedElementarySubgroup k} :
    x ∈ (D.titsSystem k).bruhatCell (QuotientGroup.mk (D.toTitsSystemSubgroupN k n)) ↔
      (x : D.points k) ∈
        DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) := by
  rw [(D.titsSystem k).bruhatCell_mk]
  exact D.doubleCoset_titsSystem_subgroupB_coe k

private def titsSystemWeylGroupHom :
    (D.titsSystem k).WeylGroup →* (t.simplyConnectedRootDatum ht).weylGroup :=
  QuotientGroup.lift (D.titsSystem k).intersection
    ((D.weylProjection k).comp
      (Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup k)).toMonoidHom)
    fun _ hn ↦ D.weylProjection_eq_one_of_mem_borelSubgroup k hn

private theorem titsSystemWeylGroupHom_mk (n : (D.titsSystem k).subgroupN) :
    D.titsSystemWeylGroupHom k (QuotientGroup.mk n) =
      D.weylProjection k ⟨((n : D.extendedElementarySubgroup k) : D.points k),
        D.titsSystem_subgroupN_coe_mem k n⟩ :=
  rfl

private theorem titsSystemWeylGroupHom_surjective :
    Function.Surjective (D.titsSystemWeylGroupHom k) := by
  intro w
  obtain ⟨g, rfl⟩ := D.weylProjection_surjective k w
  exact ⟨QuotientGroup.mk (D.toTitsSystemSubgroupN k g), rfl⟩

private theorem wordLength_lt_of_notMem_inversions_titsSystemWeylGroupHom
    (i : Fin t.rank) (q : (D.titsSystem k).WeylGroup)
    (hinv : t.simpleIndex ht i ∉
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.titsSystemWeylGroupHom k q)⁻¹) :
    (D.titsSystem k).simpleGenerators.wordLength q <
      (D.titsSystem k).simpleGenerators.wordLength
        (QuotientGroup.mk (D.titsSystemSimpleRep k i) * q) := by
  obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective q
  rw [D.titsSystemWeylGroupHom_mk] at hinv
  let T := D.titsSystem k
  let s : T.WeylGroup := QuotientGroup.mk (D.titsSystemSimpleRep k i)
  have hs : s ∈ T.simple := by
    rw [D.titsSystem_simple]
    exact ⟨i, rfl⟩
  by_contra! hle
  have hlt : T.simpleGenerators.wordLength (s * QuotientGroup.mk n) <
      T.simpleGenerators.wordLength (QuotientGroup.mk n) :=
    lt_of_le_of_ne hle (T.wordLength_simple_mul_ne hs (QuotientGroup.mk n))
  have hn_cell : (n : D.extendedElementarySubgroup k) ∈ T.bruhatCell (QuotientGroup.mk n) := by
    rw [T.bruhatCell_mk]
    exact DoubleCoset.mem_doubleCoset_self _ _ _
  have hn_prod : (n : D.extendedElementarySubgroup k) ∈
      T.bruhatCell s * T.bruhatCell (QuotientGroup.mk n) := by
    rw [T.bruhatCell_mul_eq_union_of_wordLength_lt hs hlt]
    exact Or.inr hn_cell
  obtain ⟨z₁, hz₁, z₂, hz₂, hzn⟩ := Set.mem_mul.mp hn_prod
  rw [T.bruhatCell_mk, D.doubleCoset_titsSystem_subgroupB_coe k] at hz₁ hz₂
  rw [D.coe_titsSystemSimpleRep] at hz₁
  have hsub := D.doubleCoset_weylElement_mul_subset_of_notMem_inversions k i
    ⟨((n : D.extendedElementarySubgroup k) : D.points k), D.titsSystem_subgroupN_coe_mem k n⟩
    hinv (Set.mul_mem_mul hz₁ hz₂)
  have hcoe : (z₁ : D.points k) * (z₂ : D.points k) =
      ((n : D.extendedElementarySubgroup k) : D.points k) :=
    (Subgroup.coe_mul _ z₁ z₂).symm.trans (congrArg Subtype.val hzn)
  have hrep_mul :
      (((D.titsSystemSimpleRep k i * n : T.subgroupN) :
        D.extendedElementarySubgroup k) : D.points k) =
        D.weylElement (t.simpleIndex ht i) k 1 *
          ((n : D.extendedElementarySubgroup k) : D.points k) := by
    rw [Subgroup.coe_mul, Subgroup.coe_mul, D.coe_titsSystemSimpleRep]
  rw [hcoe, ← hrep_mul,
    ← D.doubleCoset_titsSystem_subgroupB_coe k (x := (D.titsSystemSimpleRep k i * n : T.subgroupN))]
    at hsub
  have hn_sw : (n : D.extendedElementarySubgroup k) ∈
      T.bruhatCell (s * QuotientGroup.mk n) := by
    simpa only [s, ← QuotientGroup.mk_mul, T.bruhatCell_mk] using hsub
  have heq := T.eq_of_mem_bruhatCell_of_mem hn_sw hn_cell
  exact T.simple_ne_one hs (mul_right_cancel (heq.trans (one_mul _).symm))

private theorem titsSystemWeylGroupHom_injective :
    Function.Injective (D.titsSystemWeylGroupHom k) := by
  refine (injective_iff_map_eq_one (D.titsSystemWeylGroupHom k)).mpr fun q hq ↦ ?_
  by_contra hne
  obtain ⟨l, hl, hlen, hprod⟩ := (D.titsSystem k).exists_prod_eq_of_wordLength q
  rcases l with _ | ⟨s, l'⟩
  · exact hne (hprod.symm.trans List.prod_nil)
  · rw [List.forall_mem_cons] at hl
    obtain ⟨hs, hl'⟩ := hl
    have hs' := hs
    rw [D.titsSystem_simple] at hs'
    obtain ⟨i, rfl⟩ := hs'
    dsimp only at hs hlen hprod
    have hinv : t.simpleIndex ht i ∉
        inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.titsSystemWeylGroupHom k q)⁻¹ := by
      rw [hq, inv_one, inversions_one]
      exact Set.notMem_empty _
    have hlt := D.wordLength_lt_of_notMem_inversions_titsSystemWeylGroupHom k i q hinv
    have hsq : (QuotientGroup.mk (D.titsSystemSimpleRep k i) : (D.titsSystem k).WeylGroup) * q =
        l'.prod := by
      rw [← hprod, List.prod_cons, (D.titsSystem k).simple_mul_simple_cancel_left hs]
    have hle := (D.titsSystem k).wordLength_prod_le hl'
    rw [hsq] at hlt
    rw [List.length_cons] at hlen
    omega

/-- The Weyl group of `D.titsSystem k` is canonically isomorphic to the Weyl group of the pinned
root datum `(t.simplyConnectedRootDatum ht).weylGroup`. -/
def titsSystemWeylGroupMulEquiv :
    (D.titsSystem k).WeylGroup ≃* (t.simplyConnectedRootDatum ht).weylGroup :=
  MulEquiv.ofBijective (D.titsSystemWeylGroupHom k)
    ⟨D.titsSystemWeylGroupHom_injective k, D.titsSystemWeylGroupHom_surjective k⟩

/-- On a representative `n ∈ N(k)`, `D.titsSystemWeylGroupMulEquiv k` agrees with
`D.weylProjection k`. -/
@[simp]
theorem titsSystemWeylGroupMulEquiv_mk (n : (D.titsSystem k).subgroupN) :
    D.titsSystemWeylGroupMulEquiv k (QuotientGroup.mk n) =
      D.weylProjection k ⟨((n : D.extendedElementarySubgroup k) : D.points k),
        D.titsSystem_subgroupN_coe_mem k n⟩ :=
  (rfl)

/-- Evaluating `D.titsSystemWeylGroupMulEquiv k` on the class of `D.toTitsSystemSubgroupN k n`
recovers `D.weylProjection k n`. -/
theorem titsSystemWeylGroupMulEquiv_mk_toTitsSystemSubgroupN (n : D.weylSubgroup k) :
    D.titsSystemWeylGroupMulEquiv k (QuotientGroup.mk (D.toTitsSystemSubgroupN k n)) =
      D.weylProjection k n :=
  (rfl)

/-- The `i`-th simple reflection of `D.titsSystem k` corresponds to the simple reflection
`ofIdx (t.simpleIndex ht i)` of the root datum. -/
theorem titsSystemWeylGroupMulEquiv_simpleRep (i : Fin t.rank) :
    D.titsSystemWeylGroupMulEquiv k (QuotientGroup.mk (D.titsSystemSimpleRep k i)) =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) :=
  D.weylProjection_weylElement k i

/-- Under `D.titsSystemWeylGroupMulEquiv k`, the simple reflections of `D.titsSystem k` are the
simple reflections `ofIdx (t.simpleIndex ht i)` of the root datum. -/
theorem titsSystem_simple_eq_preimage :
    (D.titsSystem k).simple =
      D.titsSystemWeylGroupMulEquiv k ⁻¹'
        Set.range fun i : Fin t.rank ↦
          RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  ext q
  simp only [titsSystem_simple, Set.mem_range, Set.mem_preimage]
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i, (D.titsSystemWeylGroupMulEquiv_simpleRep k i).symm⟩
  · rintro ⟨i, hi⟩
    exact ⟨i, (D.titsSystemWeylGroupMulEquiv k).injective
      (by rw [D.titsSystemWeylGroupMulEquiv_simpleRep, hi])⟩

/-- **Length vs. inversions.** Left multiplication by the `i`-th simple reflection increases word
length in `D.titsSystem k` precisely when `αᵢ` is not an inversion of the inverse Weyl element. -/
theorem wordLength_lt_wordLength_titsSystemSimpleRep_mul_iff
    (i : Fin t.rank) (q : (D.titsSystem k).WeylGroup) :
    (D.titsSystem k).simpleGenerators.wordLength q <
        (D.titsSystem k).simpleGenerators.wordLength
          (QuotientGroup.mk (D.titsSystemSimpleRep k i) * q) ↔
      t.simpleIndex ht i ∉
        inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.titsSystemWeylGroupMulEquiv k q)⁻¹ := by
  refine ⟨fun hlt hmem ↦ ?_,
    D.wordLength_lt_of_notMem_inversions_titsSystemWeylGroupHom k i q⟩
  let s : (D.titsSystem k).WeylGroup := QuotientGroup.mk (D.titsSystemSimpleRep k i)
  have hs : s ∈ (D.titsSystem k).simple := by
    rw [D.titsSystem_simple]
    exact ⟨i, rfl⟩
  have hinv_sq : (D.titsSystemWeylGroupMulEquiv k (s * q))⁻¹ =
      (D.titsSystemWeylGroupMulEquiv k q)⁻¹ *
        RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
    rw [map_mul, mul_inv_rev, D.titsSystemWeylGroupMulEquiv_simpleRep,
      RootPairing.weylGroup.ofIdx_inv_eq]
  have hnot_sq : t.simpleIndex ht i ∉
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.titsSystemWeylGroupMulEquiv k (s * q))⁻¹ := by
    rw [hinv_sq, mem_inversions_mul_ofIdx_iff_not_mem _ _ _ (simpleIndex_isPos i)]
    exact not_not.mpr hmem
  have hlt' := D.wordLength_lt_of_notMem_inversions_titsSystemWeylGroupHom k i (s * q) hnot_sq
  rw [(D.titsSystem k).simple_mul_simple_cancel_left hs] at hlt'
  exact lt_asymm hlt hlt'

/-- Over any field, the kernel of `D.weylProjection k` is the actual weight-lattice torus inside
`D.weylSubgroup k`. -/
@[simp]
theorem ker_weylProjection :
    (D.weylProjection k).ker = ((D.torusPoints k).range).subgroupOf (D.weylSubgroup k) := by
  ext g
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
  constructor
  · intro hg
    let n := D.toTitsSystemSubgroupN k g
    have hmk : (QuotientGroup.mk n : (D.titsSystem k).WeylGroup) = 1 :=
      (D.titsSystemWeylGroupMulEquiv k).injective
        ((D.titsSystemWeylGroupMulEquiv_mk_toTitsSystemSubgroupN k g).trans
          (hg.trans (map_one _).symm))
    exact (D.titsSystem_mem_intersection k n).mp ((QuotientGroup.eq_one_iff n).mp hmk)
  · rintro ⟨s, hs⟩
    have hg : g = ⟨D.torusPoints k s, D.torusPoints_mem_weylSubgroup k s⟩ := Subtype.ext hs.symm
    rw [hg, D.weylProjection_torusPoints]

/-- Over any field, the quotient of `D.weylSubgroup k` by the actual torus `T_D(k)` is canonically
isomorphic to the Weyl group `(t.simplyConnectedRootDatum ht).weylGroup`. -/
def weylQuotientMulEquiv :
    D.weylSubgroup k ⧸ ((D.torusPoints k).range).subgroupOf (D.weylSubgroup k) ≃*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  (QuotientGroup.quotientMulEquivOfEq (D.ker_weylProjection k).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (D.weylProjection k)
      (D.weylProjection_surjective k))

/-- `D.weylQuotientMulEquiv k` evaluates on a coset representative via `D.weylProjection k`. -/
@[simp]
theorem weylQuotientMulEquiv_mk (g : D.weylSubgroup k) :
    D.weylQuotientMulEquiv k (QuotientGroup.mk g) = D.weylProjection k g :=
  (rfl)

private theorem exists_inclusion_mul_mem_inf (g : D.extendedElementarySubgroup k) :
    ∃ x : D.elementarySubgroup k,
      ∃ t_el ∈ (D.titsSystem k).subgroupB ⊓ (D.titsSystem k).subgroupN,
        Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup k) x * t_el = g := by
  obtain ⟨e, he, s, hes⟩ := (D.mem_extendedElementarySubgroup_iff k g.1).mp g.2
  refine ⟨⟨e, he⟩, ⟨D.torusPoints k s, D.torusPoints_mem_extendedElementarySubgroup k s⟩,
    ⟨D.range_torusPoints_le_borelSubgroup k ⟨s, rfl⟩, D.torusPoints_mem_weylSubgroup k s⟩,
    Subtype.ext hes⟩

/-- The **Tits system on the elementary Chevalley subgroup** `D.elementarySubgroup k` over any
field `k`, obtained by pulling `D.titsSystem k` back along the inclusion into
`D.extendedElementarySubgroup k`. -/
def elementaryTitsSystem : TitsSystem (D.elementarySubgroup k) :=
  (D.titsSystem k).comap
    (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup k))
    (D.exists_inclusion_mul_mem_inf k)

/-- The `B` subgroup of `D.elementaryTitsSystem k` is `D.borelSubgroup k` intersected with
`D.elementarySubgroup k`. -/
@[simp]
theorem elementaryTitsSystem_subgroupB :
    (D.elementaryTitsSystem k).subgroupB =
      (D.borelSubgroup k).subgroupOf (D.elementarySubgroup k) := by
  rw [elementaryTitsSystem, TitsSystem.comap_subgroupB, titsSystem_subgroupB]
  ext x
  rfl

/-- The `N` subgroup of `D.elementaryTitsSystem k` is `D.weylSubgroup k` intersected with
`D.elementarySubgroup k`. -/
@[simp]
theorem elementaryTitsSystem_subgroupN :
    (D.elementaryTitsSystem k).subgroupN =
      (D.weylSubgroup k).subgroupOf (D.elementarySubgroup k) := by
  rw [elementaryTitsSystem, TitsSystem.comap_subgroupN, titsSystem_subgroupN]
  ext x
  rfl

/-- Underlying datum points of `(D.elementaryTitsSystem k).subgroupN` belong to
`D.weylSubgroup k`. -/
theorem elementaryTitsSystem_subgroupN_coe_mem (n : (D.elementaryTitsSystem k).subgroupN) :
    ((n : D.elementarySubgroup k) : D.points k) ∈ D.weylSubgroup k := by
  let x : D.elementarySubgroup k := n
  have h : x ∈ (D.elementaryTitsSystem k).subgroupN := n.property
  rwa [D.elementaryTitsSystem_subgroupN, Subgroup.mem_subgroupOf] at h

/-- The Weyl group of `D.elementaryTitsSystem k` is canonically isomorphic to
`(t.simplyConnectedRootDatum ht).weylGroup`. -/
def elementaryTitsSystemWeylGroupMulEquiv :
    (D.elementaryTitsSystem k).WeylGroup ≃* (t.simplyConnectedRootDatum ht).weylGroup :=
  ((D.titsSystem k).comapWeylGroupMulEquiv
    (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup k))
    (D.exists_inclusion_mul_mem_inf k)).trans (D.titsSystemWeylGroupMulEquiv k)

/-- On a representative `n`, `D.elementaryTitsSystemWeylGroupMulEquiv k` agrees with
`D.weylProjection k`. -/
@[simp]
theorem elementaryTitsSystemWeylGroupMulEquiv_mk (n : (D.elementaryTitsSystem k).subgroupN) :
    D.elementaryTitsSystemWeylGroupMulEquiv k (QuotientGroup.mk n) =
      D.weylProjection k ⟨((n : D.elementarySubgroup k) : D.points k),
        D.elementaryTitsSystem_subgroupN_coe_mem k n⟩ :=
  -- Unfold `elementaryTitsSystemWeylGroupMulEquiv` as `comapWeylGroupMulEquiv` followed by
  -- `titsSystemWeylGroupMulEquiv`.
  congrArg (D.titsSystemWeylGroupMulEquiv k)
    ((D.titsSystem k).comapWeylGroupMulEquiv_mk
      (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup k))
      (D.exists_inclusion_mul_mem_inf k) n)

/-- Under `D.elementaryTitsSystemWeylGroupMulEquiv k`, the simple reflections of
`D.elementaryTitsSystem k` are the simple reflections `ofIdx (t.simpleIndex ht i)`. -/
@[simp]
theorem elementaryTitsSystem_simple :
    (D.elementaryTitsSystem k).simple =
      D.elementaryTitsSystemWeylGroupMulEquiv k ⁻¹'
        Set.range fun i : Fin t.rank ↦
          RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  have h := (D.titsSystem k).comap_simple
    (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup k))
    (D.exists_inclusion_mul_mem_inf k)
  rw [D.titsSystem_simple_eq_preimage k, ← Set.preimage_comp] at h
  exact h

end Field

end

end TauCeti.DynkinType.ChevalleyDatum
