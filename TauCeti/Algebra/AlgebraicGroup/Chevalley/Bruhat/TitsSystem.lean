namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (K : Type v) [Field K]

private theorem weylProjection_eq_one_of_mem_borelSubgroup {g : D.points K}
    (hgB : g ∈ D.borelSubgroup K) (hgN : g ∈ D.weylSubgroup K) :
    D.weylProjection K ⟨g, hgN⟩ = 1 := by
  let _ := t.isReduced_simplyConnectedRootDatum ht
  by_contra hw
  obtain ⟨γ, hγ⟩ := inversions_nonempty_of_ne_one
    (P := t.simplyConnectedRootDatum ht) (b := t.simplyConnectedBase ht) hw
  have hγpos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [t.posRoots_rationalRootSystem ht]
    exact inversions_subset_posRoots _ _ _ hγ
  have hγneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K ⟨g, hgN⟩) γ ∈
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [← not_mem_posRoots_iff_mem_negRoots, t.posRoots_rationalRootSystem ht,
      not_mem_posRoots_iff_mem_negRoots]
    exact mapsTo_inversions_negRoots _ _ _ hγ
  obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints K ⟨g, hgN⟩ γ
  have hxB : D.rootSubgroupPoints γ K (ofAdd ((c⁻¹ : Kˣ) : K)) ∈ D.borelSubgroup K :=
    D.positivePoints_le_borelSubgroup K (D.rootSubgroupPoints_mem_positivePoints K hγpos _)
  have hconjB : g * D.rootSubgroupPoints γ K (ofAdd ((c⁻¹ : Kˣ) : K)) * g⁻¹ ∈
      D.borelSubgroup K :=
    (D.borelSubgroup K).mul_mem ((D.borelSubgroup K).mul_mem hgB hxB)
      ((D.borelSubgroup K).inv_mem hgB)
  have hconj : g * D.rootSubgroupPoints γ K (ofAdd ((c⁻¹ : Kˣ) : K)) * g⁻¹ =
      D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K ⟨g, hgN⟩) γ) K
        (ofAdd 1) := by
    simpa [MulAut.conj_apply] using hc ((c⁻¹ : Kˣ) : K)
  rw [hconj, D.rootSubgroupPoints_mem_borelSubgroup_iff_of_mem_negRoots K hγneg] at hconjB
  exact D.rootSubgroupPoints_ofAdd_one_ne_one K _ hconjB

/-- Over any field, the Borel-type subgroup and the Weyl subgroup intersect in the actual
character-lattice torus. -/
@[simp]
theorem borelSubgroup_inf_weylSubgroup :
    D.borelSubgroup K ⊓ D.weylSubgroup K = (D.torusPoints K).range := by
  apply le_antisymm
  · rintro g ⟨hgB, hgN⟩
    have hw := D.weylProjection_eq_one_of_mem_borelSubgroup K hgB hgN
    obtain ⟨u, hu, s, rfl⟩ := (D.mem_borelSubgroup_iff K).mp hgB
    suffices hu1 : u = 1 by simp [hu1]
    let Kbar := AlgebraicClosure K
    let ι : K →+* Kbar := algebraMap K Kbar
    let φ := (D.pointsPresentation K).map (D.pointsPresentation Kbar) ι
    have hφ_inj : Function.Injective φ :=
      (D.pointsPresentation K).map_injective (D.pointsPresentation Kbar) ι.injective
    have hφg_cent : φ (u * D.torusPoints K s) ∈
        Subgroup.centralizer (Set.range (D.torusPoints Kbar)) := by
      rw [Subgroup.mem_centralizer_iff]
      rintro _ ⟨r, rfl⟩
      obtain ⟨s', rfl⟩ := D.fullWeightTorusRestriction_surjective Kbar r
      have heq := (D.weylProjection_eq_iff K ⟨u * D.torusPoints K s, hgN⟩ 1).mp hw s'
      simp only [map_one, MulAut.one_apply] at heq
      apply Subtype.ext
      have htor : ((D.torusPoints Kbar (D.fullWeightTorusRestriction Kbar s') : D.points Kbar) :
          Matrix.GeneralLinearGroup (Fin D.dim) Kbar) =
          diagGL (fun j => torusCharacter s' (D.weight j)) := by
        rw [D.coe_torusPoints, ← D.kostantTorusMatrix_weight, kostantTorusMatrix_apply]
      have hmapg : ((φ (u * D.torusPoints K s) : D.points Kbar) :
          Matrix.GeneralLinearGroup (Fin D.dim) Kbar) =
          Matrix.GeneralLinearGroup.map ι
            ((u * D.torusPoints K s : D.points K) : Matrix.GeneralLinearGroup (Fin D.dim) K) := by
        rw [GeneralLinear.IntegralPointsPresentation.coe_map]
      simp only [Subgroup.coe_mul, htor, hmapg]
      exact (mul_inv_eq_iff_eq_mul.mp heq).symm
    have hφs_cent : φ (D.torusPoints K s) ∈
        Subgroup.centralizer (Set.range (D.torusPoints Kbar)) := by
      rw [D.map_torusPoints]
      exact Subgroup.le_centralizer (D.torusPoints Kbar).range ⟨_, rfl⟩
    have hφu_mem : φ u ∈ D.positivePoints Kbar ⊓
        Subgroup.centralizer (Set.range (D.torusPoints Kbar)) := by
      refine ⟨D.map_positivePoints_le ι ⟨u, hu, rfl⟩, ?_⟩
      have hmul : φ u = φ (u * D.torusPoints K s) * (φ (D.torusPoints K s))⁻¹ := by
        rw [map_mul, mul_inv_cancel_right]
      rw [hmul]
      exact Subgroup.mul_mem _ hφg_cent (Subgroup.inv_mem _ hφs_cent)
    rw [D.positivePoints_inf_centralizer_range_torusPoints Kbar, Subgroup.mem_bot] at hφu_mem
    exact hφ_inj (hφu_mem.trans (map_one φ).symm)
  · refine le_inf (D.range_torusPoints_le_borelSubgroup K) ?_
    rintro _ ⟨s, rfl⟩
    exact D.torusPoints_mem_weylSubgroup K s

private theorem doubleCoset_weylElement_mul_doubleCoset_reduction (i : Fin t.rank)
    (w : D.weylSubgroup K) {g : D.points K}
    (hg : g ∈ DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K) (D.borelSubgroup K) *
      DoubleCoset.doubleCoset (w : D.points K) (D.borelSubgroup K) (D.borelSubgroup K)) :
    ∃ b₁ ∈ D.borelSubgroup K, ∃ a : K, ∃ b₂ ∈ D.borelSubgroup K,
      g = b₁ * D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) * (w : D.points K) * b₂ := by
  let n := D.weylElement (t.simpleIndex ht i) K 1
  obtain ⟨x, hx, y, hy, rfl⟩ := Set.mem_mul.mp hg
  obtain ⟨c₁, hc₁, c₂, hc₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
  obtain ⟨d₁, hd₁, d₂, hd₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hy
  obtain ⟨u, hu, s, hcd⟩ := (D.mem_borelSubgroup_iff K).mp ((D.borelSubgroup K).mul_mem hc₂ hd₁)
  obtain ⟨v, hv, a, rfl⟩ := (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints K i u).mp hu
  have hnv_mem : n * v * n⁻¹ ∈
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ K).range : Subgroup (D.points K)) :=
    (Subgroup.mem_normalizer_iff.mp
      (D.weylElement_mem_normalizer_positivePoints_diff_singleton K i) v).mp hv
  have hnvB : n * v * n⁻¹ ∈ D.borelSubgroup K := by
    apply D.positivePoints_le_borelSubgroup K
    have hle : (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
        {t.simpleIndex ht i}, (D.rootSubgroupPoints γ K).range : Subgroup (D.points K)) ≤
        D.positivePoints K := by
      refine iSup₂_le fun γ hγ => ?_
      rintro _ ⟨r, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints K hγ.1 r
    exact hle hnv_mem
  have hwtT : (w : D.points K)⁻¹ * D.torusPoints K s * (w : D.points K) ∈
      (D.torusPoints K).range := by
    have h := (Subgroup.mem_normalizer_iff.mp
      (D.weylSubgroup_le_normalizer_range_torusPoints K ((D.weylSubgroup K).inv_mem w.2))
      (D.torusPoints K s)).mp ⟨s, rfl⟩
    simpa only [inv_inv] using h
  have hwtB : (w : D.points K)⁻¹ * D.torusPoints K s * (w : D.points K) ∈ D.borelSubgroup K :=
    D.range_torusPoints_le_borelSubgroup K hwtT
  refine ⟨c₁ * (n * v * n⁻¹), (D.borelSubgroup K).mul_mem hc₁ hnvB, toAdd a,
    ((w : D.points K)⁻¹ * D.torusPoints K s * (w : D.points K)) * d₂,
    (D.borelSubgroup K).mul_mem hwtB hd₂, ?_⟩
  have hmid : c₂ * d₁ = v * D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (toAdd a)) *
      D.torusPoints K s := by
    simpa only [ofAdd_toAdd] using hcd.symm
  calc
    c₁ * n * c₂ * (d₁ * (w : D.points K) * d₂)
      = c₁ * n * (c₂ * d₁) * (w : D.points K) * d₂ := by group
    _ = c₁ * n * (v * D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (toAdd a)) *
          D.torusPoints K s) * (w : D.points K) * d₂ := by rw [hmid]
    _ = c₁ * (n * v * n⁻¹) * n * D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (toAdd a)) *
          (w : D.points K) * ((w : D.points K)⁻¹ * D.torusPoints K s * (w : D.points K) * d₂) := by
        group

/-- **Length-increasing Bruhat cell multiplication.** If `w⁻¹(αᵢ)` is a positive root, then
`(B nᵢ B)(B w B) = B (nᵢ w) B`. -/
theorem doubleCoset_weylElement_mul_doubleCoset_eq_of_mem_posRoots (i : Fin t.rank)
    (w : D.weylSubgroup K)
    (hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K w)⁻¹
        (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K) (D.borelSubgroup K) *
      DoubleCoset.doubleCoset (w : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) =
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * (w : D.points K))
        (D.borelSubgroup K) (D.borelSubgroup K) := by
  let n := D.weylElement (t.simpleIndex ht i) K 1
  apply Set.Subset.antisymm
  · intro g hg
    obtain ⟨b₁, hb₁, a, b₂, hb₂, rfl⟩ :=
      D.doubleCoset_weylElement_mul_doubleCoset_reduction K i w hg
    obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints K w⁻¹ (t.simpleIndex ht i)
    have hconj : (w : D.points K)⁻¹ * D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) *
        (w : D.points K) ∈ D.borelSubgroup K := by
      have h := hc a
      rw [MulAut.conj_apply, Subgroup.coe_inv, inv_inv, map_inv] at h
      rw [h]
      exact D.positivePoints_le_borelSubgroup K (D.rootSubgroupPoints_mem_positivePoints K hpos _)
    refine DoubleCoset.mem_doubleCoset.mpr
      ⟨b₁, hb₁, ((w : D.points K)⁻¹ * D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) *
        (w : D.points K)) * b₂, (D.borelSubgroup K).mul_mem hconj hb₂, ?_⟩
    group
  · intro g hg
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    refine Set.mem_mul.mpr
      ⟨b₁ * n * 1, DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, 1, (D.borelSubgroup K).one_mem, rfl⟩,
       1 * (w : D.points K) * b₂,
       DoubleCoset.mem_doubleCoset.mpr ⟨1, (D.borelSubgroup K).one_mem, b₂, hb₂, rfl⟩, ?_⟩
    dsimp only [n]
    group

private theorem doubleCoset_weylElement_mul_doubleCoset_mem_right (i : Fin t.rank)
    (w : D.weylSubgroup K)
    (hneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K w)⁻¹
        (t.simpleIndex ht i) ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    {b₁ b₂ : D.points K} (hb₁ : b₁ ∈ D.borelSubgroup K) (hb₂ : b₂ ∈ D.borelSubgroup K)
    (u : Kˣ) :
    b₁ * D.weylElement (t.simpleIndex ht i) K 1 *
      D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) * (w : D.points K) * b₂ ∈
      DoubleCoset.doubleCoset (w : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  let P := t.simplyConnectedRootDatum ht
  let α := t.simpleIndex ht i
  let n := D.weylElement α K 1
  have hneg_pos : P.weylGroupToPerm (D.weylProjection K w)⁻¹ (P.reflectionPerm α α) ∈
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    have hperm : P.weylGroupToPerm (D.weylProjection K w)⁻¹ (P.reflectionPerm α α) =
        P.reflectionPerm (P.weylGroupToPerm (D.weylProjection K w)⁻¹ α)
          (P.weylGroupToPerm (D.weylProjection K w)⁻¹ α) := by
      simpa only [RootPairing.indexNeg_neg] using
        RootPairing.weylGroupToPerm_neg P (D.weylProjection K w)⁻¹ α
    rw [hperm, ← t.reflectionPerm_rationalRootSystem ht]
    exact (reflectionPerm_self_mem_posRoots_iff_mem_negRoots _ _ _).mpr hneg
  have hrank' : n * D.rootSubgroupPoints α K (ofAdd (u : K)) =
      D.rootSubgroupPoints α K (ofAdd (-((u⁻¹ : Kˣ) : K))) * D.simpleCorootPoints i K (-u⁻¹) *
        (n * D.rootSubgroupPoints α K (ofAdd (-((u⁻¹ : Kˣ) : K))) * n⁻¹) := by
    have h := congrArg (· * n⁻¹) (D.weylElement_mul_rootSubgroup_mul_weylElement i K u)
    dsimp only [n, α] at h ⊢
    calc
      D.weylElement (t.simpleIndex ht i) K 1 *
          D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K))
        = D.weylElement (t.simpleIndex ht i) K 1 *
            D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) *
            D.weylElement (t.simpleIndex ht i) K 1 *
            (D.weylElement (t.simpleIndex ht i) K 1)⁻¹ := by group
      _ = _ := by rw [h]; group
  have hαpos : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) :=
    support_subset_posRoots _ _ (t.simpleIndex_mem_support i)
  have hb' : D.rootSubgroupPoints α K (ofAdd (-((u⁻¹ : Kˣ) : K))) *
      D.simpleCorootPoints i K (-u⁻¹) ∈ D.borelSubgroup K := by
    refine (D.borelSubgroup K).mul_mem
      (D.positivePoints_le_borelSubgroup K (D.rootSubgroupPoints_mem_positivePoints K hαpos _)) ?_
    rw [D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints K w⁻¹ (P.reflectionPerm α α)
  have hconj_w : (w : D.points K)⁻¹ *
      (n * D.rootSubgroupPoints α K (ofAdd (-((u⁻¹ : Kˣ) : K))) * n⁻¹) * (w : D.points K) ∈
      D.borelSubgroup K := by
    rw [D.weylElement_conj_rootSubgroupPoints]
    have h := hc ((((t.chevalleyWeylSign ht α α : ℤˣ) : ℤ) : K) * (-((u⁻¹ : Kˣ) : K)))
    rw [MulAut.conj_apply, Subgroup.coe_inv, inv_inv, map_inv] at h
    rw [h]
    exact D.positivePoints_le_borelSubgroup K
      (D.rootSubgroupPoints_mem_positivePoints K hneg_pos _)
  refine DoubleCoset.mem_doubleCoset.mpr
    ⟨b₁ * (D.rootSubgroupPoints α K (ofAdd (-((u⁻¹ : Kˣ) : K))) * D.simpleCorootPoints i K (-u⁻¹)),
     (D.borelSubgroup K).mul_mem hb₁ hb',
     ((w : D.points K)⁻¹ *
      (n * D.rootSubgroupPoints α K (ofAdd (-((u⁻¹ : Kˣ) : K))) * n⁻¹) * (w : D.points K)) * b₂,
     (D.borelSubgroup K).mul_mem hconj_w hb₂, ?_⟩
  calc
    b₁ * n * D.rootSubgroupPoints α K (ofAdd (u : K)) * (w : D.points K) * b₂
      = b₁ * (n * D.rootSubgroupPoints α K (ofAdd (u : K))) * (w : D.points K) * b₂ := by group
    _ = b₁ * (D.rootSubgroupPoints α K (ofAdd (-((u⁻¹ : Kˣ) : K))) *
          D.simpleCorootPoints i K (-u⁻¹) *
          (n * D.rootSubgroupPoints α K (ofAdd (-((u⁻¹ : Kˣ) : K))) * n⁻¹)) *
          (w : D.points K) * b₂ := by rw [hrank']
    _ = _ := by group

/-- **The Tits double-coset multiplication axiom.** For every simple Weyl representative `nᵢ` and
every `w ∈ N`, `(B nᵢ B)(B w B) ⊆ B (nᵢ w) B ∪ B w B`. -/
theorem doubleCoset_weylElement_mul_doubleCoset_subset (i : Fin t.rank) (w : D.weylSubgroup K) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K) (D.borelSubgroup K) *
      DoubleCoset.doubleCoset (w : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) ⊆
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * (w : D.points K))
        (D.borelSubgroup K) (D.borelSubgroup K) ∪
      DoubleCoset.doubleCoset (w : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  by_cases hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K w)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)
  · rw [D.doubleCoset_weylElement_mul_doubleCoset_eq_of_mem_posRoots K i w hpos]
    exact Set.subset_union_left
  · intro g hg
    obtain ⟨b₁, hb₁, a, b₂, hb₂, rfl⟩ :=
      D.doubleCoset_weylElement_mul_doubleCoset_reduction K i w hg
    by_cases ha : a = 0
    · left
      subst ha
      refine DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, b₂, hb₂, ?_⟩
      simp only [ofAdd_zero, map_one, mul_one, mul_assoc]
    · right
      have hneg := (not_mem_posRoots_iff_mem_negRoots _ _ _).mp hpos
      simpa only [Units.val_mk0 ha] using
        D.doubleCoset_weylElement_mul_doubleCoset_mem_right K i w hneg hb₁ hb₂ (Units.mk0 a ha)

/-- The pinned simple Weyl representative `nᵢ` viewed inside `N` as a subgroup of
`D.extendedElementarySubgroup K`. -/
private noncomputable def extendedSimpleWeyl (i : Fin t.rank) :
    (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  ⟨⟨D.weylElement (t.simpleIndex ht i) K 1,
    D.weylSubgroup_le_extendedElementarySubgroup K (D.weylElement_mem_weylSubgroup K i)⟩,
    D.weylElement_mem_weylSubgroup K i⟩

private theorem extendedIntersection_normal :
    (((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)).subgroupOf
      ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K))).Normal := by
  constructor
  intro x hx n
  have hxT : (x.1.1 : D.points K) ∈ (D.torusPoints K).range := by
    rw [← D.borelSubgroup_inf_weylSubgroup K]
    exact ⟨hx, x.2⟩
  have hconjT : (n.1.1 : D.points K) * x.1.1 * (n.1.1 : D.points K)⁻¹ ∈
      (D.torusPoints K).range :=
    (Subgroup.mem_normalizer_iff.mp
      (D.weylSubgroup_le_normalizer_range_torusPoints K n.2) x.1.1).mp hxT
  exact D.range_torusPoints_le_borelSubgroup K hconjT

private theorem doubleCoset_subgroupOf_iff (H : Subgroup (D.points K))
    (hH : H ≤ D.extendedElementarySubgroup K)
    (a g : D.extendedElementarySubgroup K) :
    g ∈ DoubleCoset.doubleCoset a
        (H.subgroupOf (D.extendedElementarySubgroup K))
        (H.subgroupOf (D.extendedElementarySubgroup K)) ↔
      (g : D.points K) ∈ DoubleCoset.doubleCoset (a : D.points K) H H := by
  simp only [DoubleCoset.mem_doubleCoset]
  constructor
  · rintro ⟨b₁, hb₁, b₂, hb₂, rfl⟩
    exact ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · rintro ⟨b₁, hb₁, b₂, hb₂, h⟩
    exact ⟨⟨b₁, hH hb₁⟩, hb₁, ⟨b₂, hH hb₂⟩, hb₂, Subtype.ext h⟩

private theorem extendedClosure_simple :
    let _ := D.extendedIntersection_normal K
    Subgroup.closure (Set.range (fun i : Fin t.rank =>
      (QuotientGroup.mk (D.extendedSimpleWeyl K i) :
        ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)) ⧸
          ((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)).subgroupOf
            ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K))))) = ⊤ := by
  let _ := D.extendedIntersection_normal K
  let e : (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K) ≃* D.weylSubgroup K :=
    Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup K)
  let N := ((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)).subgroupOf
    ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K))
  let S : Set (((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)) ⧸ N) :=
    Set.range (fun i : Fin t.rank => QuotientGroup.mk (D.extendedSimpleWeyl K i))
  let qmk : D.weylSubgroup K →* _ := (QuotientGroup.mk' N).comp e.symm.toMonoidHom
  have hle : D.weylSubgroup K ≤
      ((Subgroup.closure S).comap qmk).map (D.weylSubgroup K).subtype := by
    apply (D.weylSubgroup_def K).le.trans
    apply (Subgroup.closure_le _).mpr
    rintro _ (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · refine ⟨⟨D.torusPoints K s, D.torusPoints_mem_weylSubgroup K s⟩, ?_, rfl⟩
      change (QuotientGroup.mk (e.symm ⟨D.torusPoints K s, _⟩) : _ ⧸ N) ∈ Subgroup.closure S
      have h1 : (QuotientGroup.mk (e.symm ⟨D.torusPoints K s,
          D.torusPoints_mem_weylSubgroup K s⟩) : _ ⧸ N) = 1 :=
        (QuotientGroup.eq_one_iff _).mpr (D.range_torusPoints_le_borelSubgroup K ⟨s, rfl⟩)
      rw [h1]
      exact Subgroup.one_mem _
    · refine ⟨⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩,
        ?_, rfl⟩
      exact Subgroup.subset_closure ⟨i, rfl⟩
  apply eq_top_iff.mpr
  intro q _
  obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective q
  obtain ⟨m, hm, hmeq⟩ := hle n.2
  have hmn : m = e n := Subtype.ext hmeq
  simpa [qmk, hmn] using hm

/-- **The Tits system of a Chevalley group over a field.** The Borel-type subgroup
`D.borelSubgroup K` and the Weyl subgroup `D.weylSubgroup K`, regarded inside the extended
elementary subgroup `D.extendedElementarySubgroup K`, form a Tits system (BN-pair) with simple
reflections given by the classes of the pinned simple Weyl representatives `nᵢ`. -/
noncomputable def titsSystem : TauCeti.TitsSystem (D.extendedElementarySubgroup K) where
  subgroupB := (D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)
  subgroupN := (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)
  closure_subgroupB_union_subgroupN := by
    rw [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq]
    apply Subgroup.map_injective (D.extendedElementarySubgroup K).subtype_injective
    rw [Subgroup.map_sup,
      Subgroup.map_subgroupOf_eq_of_le (D.borelSubgroup_le_extendedElementarySubgroup K),
      Subgroup.map_subgroupOf_eq_of_le (D.weylSubgroup_le_extendedElementarySubgroup K),
      D.borelSubgroup_sup_weylSubgroup K, Subgroup.map_top, Subgroup.range_subtype]
  intersection_normal := D.extendedIntersection_normal K
  simple := Set.range (fun i : Fin t.rank =>
    (QuotientGroup.mk (D.extendedSimpleWeyl K i) :
      ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)) ⧸
        ((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)).subgroupOf
          ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K))))
  closure_simple := D.extendedClosure_simple K
  exists_simpleRep_mul_self_mem := by
    rintro _ ⟨i, rfl⟩
    refine ⟨D.extendedSimpleWeyl K i, rfl, ?_⟩
    change D.weylElement (t.simpleIndex ht i) K 1 * D.weylElement (t.simpleIndex ht i) K 1 ∈
      D.borelSubgroup K
    rw [D.weylElement_mul_self, D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  mul_doubleCoset_subset := by
    rintro _ ⟨i, rfl⟩
    refine ⟨D.extendedSimpleWeyl K i, rfl, fun w g hg => ?_⟩
    obtain ⟨x, hx, y, hy, rfl⟩ := Set.mem_mul.mp hg
    rw [D.doubleCoset_subgroupOf_iff K (D.borelSubgroup K)
        (D.borelSubgroup_le_extendedElementarySubgroup K)] at hx hy
    have hmem := D.doubleCoset_weylElement_mul_doubleCoset_subset K i ⟨w.1.1, w.2⟩
      (Set.mem_mul.mpr ⟨x, hx, y, hy, rfl⟩)
    rcases hmem with h1 | h2
    · left
      exact (D.doubleCoset_subgroupOf_iff K (D.borelSubgroup K)
        (D.borelSubgroup_le_extendedElementarySubgroup K) _ _).mpr h1
    · right
      exact (D.doubleCoset_subgroupOf_iff K (D.borelSubgroup K)
        (D.borelSubgroup_le_extendedElementarySubgroup K) _ _).mpr h2
  exists_conj_not_mem := by
    rintro _ ⟨i, rfl⟩
    obtain ⟨b, hb⟩ := D.exists_weylElement_conj_notMem_borelSubgroup K i
    exact ⟨D.extendedSimpleWeyl K i, rfl,
      ⟨⟨b.1, D.borelSubgroup_le_extendedElementarySubgroup K b.2⟩, b.2⟩, hb⟩

/-- The Borel subgroup of `D.titsSystem K` is `D.borelSubgroup K` inside
`D.extendedElementarySubgroup K`. -/
@[simp]
theorem titsSystem_subgroupB :
    (D.titsSystem K).subgroupB =
      (D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  (rfl)

/-- The normalizer subgroup of `D.titsSystem K` is `D.weylSubgroup K` inside
`D.extendedElementarySubgroup K`. -/
@[simp]
theorem titsSystem_subgroupN :
    (D.titsSystem K).subgroupN =
      (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  (rfl)

private theorem mem_doubleCoset_titsSystem_iff (a g : D.extendedElementarySubgroup K) :
    g ∈ DoubleCoset.doubleCoset a (D.titsSystem K).subgroupB (D.titsSystem K).subgroupB ↔
      (g : D.points K) ∈ DoubleCoset.doubleCoset (a : D.points K)
        (D.borelSubgroup K) (D.borelSubgroup K) :=
  D.doubleCoset_subgroupOf_iff K (D.borelSubgroup K)
    (D.borelSubgroup_le_extendedElementarySubgroup K) a g

private noncomputable def titsSubgroupNOfWeyl (n : D.weylSubgroup K) :
    (D.titsSystem K).subgroupN :=
  ⟨⟨n.1, D.weylSubgroup_le_extendedElementarySubgroup K n.2⟩, n.2⟩

/-- The Weyl projection descends from `(D.titsSystem K).WeylGroup` to the root-datum Weyl group. -/
private noncomputable def titsSystemWeylProjection :
    (D.titsSystem K).WeylGroup →* (t.simplyConnectedRootDatum ht).weylGroup :=
  QuotientGroup.lift (D.titsSystem K).intersection
    ((D.weylProjection K).comp
      (Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup K)).toMonoidHom)
    (by
      intro n hn
      have hnT : (n.1.1 : D.points K) ∈ (D.torusPoints K).range := by
        rw [← D.borelSubgroup_inf_weylSubgroup K]
        exact ⟨hn, n.2⟩
      obtain ⟨s, hs⟩ := hnT
      have hsub : (⟨n.1.1, n.2⟩ : D.weylSubgroup K) =
          ⟨D.torusPoints K s, D.torusPoints_mem_weylSubgroup K s⟩ := Subtype.ext hs.symm
      change D.weylProjection K ⟨n.1.1, n.2⟩ = 1
      rw [hsub, D.weylProjection_torusPoints])

private theorem bruhatCell_simple_mul_eq_of_weylProjection_eq_one (i : Fin t.rank)
    (n : (D.titsSystem K).subgroupN)
    (hproj : D.weylProjection K ⟨n.1.1, (D.titsSystem_subgroupN K).le n.2⟩ = 1) :
    (D.titsSystem K).bruhatCell
        (QuotientGroup.mk (D.extendedSimpleWeyl K i) : (D.titsSystem K).WeylGroup) *
      (D.titsSystem K).bruhatCell (QuotientGroup.mk n) =
      (D.titsSystem K).bruhatCell
        ((QuotientGroup.mk (D.extendedSimpleWeyl K i) : (D.titsSystem K).WeylGroup) *
          QuotientGroup.mk n) := by
  let r : (D.titsSystem K).subgroupN := D.extendedSimpleWeyl K i
  have hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm
      (D.weylProjection K ⟨n.1.1, (D.titsSystem_subgroupN K).le n.2⟩)⁻¹ (t.simpleIndex ht i) ∈
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [hproj, inv_one, map_one, Equiv.Perm.one_apply]
    exact support_subset_posRoots _ _ (t.simpleIndex_mem_support i)
  change (D.titsSystem K).bruhatCell (QuotientGroup.mk r) *
      (D.titsSystem K).bruhatCell (QuotientGroup.mk n) =
    (D.titsSystem K).bruhatCell (QuotientGroup.mk r * QuotientGroup.mk n)
  rw [(D.titsSystem K).bruhatCell_mk, (D.titsSystem K).bruhatCell_mk,
    ← QuotientGroup.mk_mul, (D.titsSystem K).bruhatCell_mk]
  ext g
  rw [D.mem_doubleCoset_titsSystem_iff K]
  have hrn : ((r * n : (D.titsSystem K).subgroupN) : D.points K) =
      D.weylElement (t.simpleIndex ht i) K 1 * (n.1.1 : D.points K) := rfl
  have hr_coe : ((r : (D.titsSystem K).subgroupN) : D.points K) =
      D.weylElement (t.simpleIndex ht i) K 1 := rfl
  rw [hrn]
  constructor
  · intro hg
    obtain ⟨x, hx, y, hy, rfl⟩ := Set.mem_mul.mp hg
    rw [D.mem_doubleCoset_titsSystem_iff K] at hx hy
    rw [hr_coe] at hx
    rw [← D.doubleCoset_weylElement_mul_doubleCoset_eq_of_mem_posRoots K i
      ⟨n.1.1, (D.titsSystem_subgroupN K).le n.2⟩ hpos]
    exact Set.mem_mul.mpr ⟨x, hx, y, hy, rfl⟩
  · intro hg
    rw [← D.doubleCoset_weylElement_mul_doubleCoset_eq_of_mem_posRoots K i
      ⟨n.1.1, (D.titsSystem_subgroupN K).le n.2⟩ hpos] at hg
    obtain ⟨x, hx, y, hy, hxy⟩ := Set.mem_mul.mp hg
    have hxE : x ∈ D.extendedElementarySubgroup K := by
      obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
      exact (D.extendedElementarySubgroup K).mul_mem
        ((D.extendedElementarySubgroup K).mul_mem
          (D.borelSubgroup_le_extendedElementarySubgroup K hb₁)
          (D.weylSubgroup_le_extendedElementarySubgroup K (D.weylElement_mem_weylSubgroup K i)))
        (D.borelSubgroup_le_extendedElementarySubgroup K hb₂)
    have hyE : y ∈ D.extendedElementarySubgroup K := by
      obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hy
      exact (D.extendedElementarySubgroup K).mul_mem
        ((D.extendedElementarySubgroup K).mul_mem
          (D.borelSubgroup_le_extendedElementarySubgroup K hb₁) n.1.2)
        (D.borelSubgroup_le_extendedElementarySubgroup K hb₂)
    refine Set.mem_mul.mpr ⟨⟨x, hxE⟩, ?_, ⟨y, hyE⟩, ?_, Subtype.ext hxy⟩
    · exact (D.mem_doubleCoset_titsSystem_iff K r.1 ⟨x, hxE⟩).mpr (hr_coe.symm ▸ hx)
    · exact (D.mem_doubleCoset_titsSystem_iff K n.1 ⟨y, hyE⟩).mpr hy

private theorem titsSystemWeylProjection_bijective :
    Function.Bijective (D.titsSystemWeylProjection K) := by
  constructor
  · rw [injective_iff_map_eq_one]
    intro w hw
    obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective w
    have hproj : D.weylProjection K ⟨n.1.1, (D.titsSystem_subgroupN K).le n.2⟩ = 1 := hw
    have hlt : ∀ s ∈ (D.titsSystem K).simple,
        (D.titsSystem K).simpleGenerators.wordLength (QuotientGroup.mk n) <
          (D.titsSystem K).simpleGenerators.wordLength (s * QuotientGroup.mk n) := by
      rintro s ⟨i, rfl⟩
      have hr : (QuotientGroup.mk (D.extendedSimpleWeyl K i) : (D.titsSystem K).WeylGroup) ∈
          (D.titsSystem K).simple := ⟨i, rfl⟩
      exact ((D.titsSystem K).bruhatCell_mul_eq_iff_wordLength_lt hr (QuotientGroup.mk n)).mp
        (D.bruhatCell_simple_mul_eq_of_weylProjection_eq_one K i n hproj)
    by_contra hne
    obtain ⟨l, hl, hlen, hprod⟩ :=
      (D.titsSystem K).exists_prod_eq_of_wordLength (QuotientGroup.mk n)
    cases l with
    | nil => exact hne (by simpa using hprod.symm)
    | cons s l' =>
      rw [List.forall_mem_cons] at hl
      have hsw : s * QuotientGroup.mk n = l'.prod := by
        rw [← hprod, List.prod_cons, (D.titsSystem K).simple_mul_simple_cancel_left hl.1]
      have hle := (D.titsSystem K).wordLength_prod_le hl.2
      have hcontra := hlt s hl.1
      rw [hsw, ← hlen, List.length_cons] at hcontra
      omega
  · intro w
    obtain ⟨m, rfl⟩ := D.weylProjection_surjective K w
    exact ⟨QuotientGroup.mk (D.titsSubgroupNOfWeyl K m), rfl⟩

/-- The Weyl group of `D.titsSystem K` is canonically isomorphic to the Weyl group of the
root datum. -/
noncomputable def titsSystemWeylGroupEquiv :
    (D.titsSystem K).WeylGroup ≃* (t.simplyConnectedRootDatum ht).weylGroup :=
  MulEquiv.ofBijective (D.titsSystemWeylProjection K) (D.titsSystemWeylProjection_bijective K)

/-- The Weyl group isomorphism evaluates on cosets of `N` via `D.weylProjection K`. -/
@[simp]
theorem titsSystemWeylGroupEquiv_mk (n : (D.titsSystem K).subgroupN) :
    D.titsSystemWeylGroupEquiv K (QuotientGroup.mk n) =
      D.weylProjection K ⟨n.1.1, (D.titsSystem_subgroupN K).le n.2⟩ :=
  (rfl)

/-- Over any field, the kernel of the Weyl projection is precisely the actual character-lattice
torus inside `D.weylSubgroup K`. -/
@[simp]
theorem ker_weylProjection :
    (D.weylProjection K).ker = (D.torusPoints K).range.subgroupOf (D.weylSubgroup K) := by
  ext n
  constructor
  · intro hn
    let n' : (D.titsSystem K).subgroupN := D.titsSubgroupNOfWeyl K n
    have hq : QuotientGroup.mk n' = (1 : (D.titsSystem K).WeylGroup) := by
      apply (D.titsSystemWeylGroupEquiv K).injective
      rw [map_one, D.titsSystemWeylGroupEquiv_mk]
      exact hn
    have hmem : n' ∈ (D.titsSystem K).intersection := (QuotientGroup.eq_one_iff n').mp hq
    change (n : D.points K) ∈ (D.torusPoints K).range
    rw [← D.borelSubgroup_inf_weylSubgroup K]
    exact ⟨hmem, n.2⟩
  · rintro ⟨s, hs⟩
    have hsub : n = ⟨D.torusPoints K s, D.torusPoints_mem_weylSubgroup K s⟩ := Subtype.ext hs.symm
    rw [MonoidHom.mem_ker, hsub, D.weylProjection_torusPoints]

/-- Over any field, the Weyl quotient `N(K) / T(K)` of a Chevalley datum is canonically
isomorphic to the Weyl group of the root datum. -/
noncomputable def weylQuotientEquiv :
    (D.weylSubgroup K ⧸ (D.torusPoints K).range.subgroupOf (D.weylSubgroup K)) ≃*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  (QuotientGroup.quotientMulEquivOfEq (D.ker_weylProjection K).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (D.weylProjection K)
      (D.weylProjection_surjective K))

/-- On a coset of `T(K)` in `N(K)`, `weylQuotientEquiv` recovers the Weyl projection. -/
@[simp]
theorem weylQuotientEquiv_mk (n : D.weylSubgroup K) :
    D.weylQuotientEquiv K (QuotientGroup.mk n) = D.weylProjection K n :=
  (rfl)

/-- Two elements of `N(K)` define the same `B(K)`-double coset if and only if they have the same
Weyl projection. -/
theorem doubleCoset_eq_iff_weylProjection_eq (n m : D.weylSubgroup K) :
    DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) =
        DoubleCoset.doubleCoset (m : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) ↔
      D.weylProjection K n = D.weylProjection K m := by
  let n' : (D.titsSystem K).subgroupN := D.titsSubgroupNOfWeyl K n
  let m' : (D.titsSystem K).subgroupN := D.titsSubgroupNOfWeyl K m
  have hcell : (D.titsSystem K).bruhatCell (QuotientGroup.mk n') =
      (D.titsSystem K).bruhatCell (QuotientGroup.mk m') ↔
      D.weylProjection K n = D.weylProjection K m := by
    rw [(D.titsSystem K).bruhatCell_inj, ← (D.titsSystemWeylGroupEquiv K).injective.eq_iff,
      D.titsSystemWeylGroupEquiv_mk, D.titsSystemWeylGroupEquiv_mk]
    rfl
  rw [← hcell, (D.titsSystem K).bruhatCell_mk, (D.titsSystem K).bruhatCell_mk]
  constructor
  · intro h
    ext g
    rw [D.mem_doubleCoset_titsSystem_iff K, D.mem_doubleCoset_titsSystem_iff K]
    exact Set.ext_iff.mp h g.1
  · intro h
    ext g
    by_cases hg : g ∈ D.extendedElementarySubgroup K
    · have h' := Set.ext_iff.mp h ⟨g, hg⟩
      simpa only [D.mem_doubleCoset_titsSystem_iff K, n', m', titsSubgroupNOfWeyl] using h'
    · have hnot (k : D.weylSubgroup K) :
          g ∉ DoubleCoset.doubleCoset (k : D.points K)
            (D.borelSubgroup K) (D.borelSubgroup K) := by
        intro hmem
        obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hmem
        exact hg ((D.extendedElementarySubgroup K).mul_mem
          ((D.extendedElementarySubgroup K).mul_mem
            (D.borelSubgroup_le_extendedElementarySubgroup K hb₁)
            (D.weylSubgroup_le_extendedElementarySubgroup K k.2))
          (D.borelSubgroup_le_extendedElementarySubgroup K hb₂))
      simp [hnot n, hnot m]

/-- Two `B(K)`-double cosets of elements of `N(K)` are disjoint if and only if their Weyl
projections are distinct. -/
theorem disjoint_doubleCoset_iff_weylProjection_ne (n m : D.weylSubgroup K) :
    Disjoint (DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K))
        (DoubleCoset.doubleCoset (m : D.points K) (D.borelSubgroup K) (D.borelSubgroup K)) ↔
      D.weylProjection K n ≠ D.weylProjection K m := by
  constructor
  · intro h heq
    rw [(D.doubleCoset_eq_iff_weylProjection_eq K n m).mpr heq] at h
    exact Set.disjoint_left.mp h
      (DoubleCoset.mem_doubleCoset_self (D.borelSubgroup K) (D.borelSubgroup K) m.1)
      (DoubleCoset.mem_doubleCoset_self (D.borelSubgroup K) (D.borelSubgroup K) m.1)
  · intro h
    rw [Set.disjoint_left]
    intro g hgn hgm
    have heq := (DoubleCoset.doubleCoset_eq_of_mem hgn).symm.trans
      (DoubleCoset.doubleCoset_eq_of_mem hgm)
    exact h ((D.doubleCoset_eq_iff_weylProjection_eq K n m).mp heq)

/-- **Bruhat decomposition.** Given any section `n : W → N(K)` of the Weyl projection, every
element of the extended elementary subgroup `D.extendedElementarySubgroup K` lies in the
`B(K)`-double coset `B(K) n(w) B(K)` for a unique `w ∈ W`. -/
theorem existsUnique_weyl_mem_doubleCoset
    (n : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hn : ∀ w, D.weylProjection K (n w) = w)
    {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup,
      g ∈ DoubleCoset.doubleCoset (n w : D.points K)
        (D.borelSubgroup K) (D.borelSubgroup K) := by
  obtain ⟨q, hq, huniq⟩ := (D.titsSystem K).existsUnique_mem_bruhatCell ⟨g, hg⟩
  have hmk (m : D.weylSubgroup K) :
      D.titsSystemWeylGroupEquiv K (QuotientGroup.mk (D.titsSubgroupNOfWeyl K m)) =
        D.weylProjection K m := rfl
  let w := D.titsSystemWeylGroupEquiv K q
  have hnw : D.titsSystemWeylGroupEquiv K
      (QuotientGroup.mk (D.titsSubgroupNOfWeyl K (n w))) = w := by
    rw [hmk, hn]
  have hqeq : q = QuotientGroup.mk (D.titsSubgroupNOfWeyl K (n w)) :=
    (D.titsSystemWeylGroupEquiv K).injective hnw.symm
  refine ⟨w, ?_, ?_⟩
  · rw [hqeq, (D.titsSystem K).bruhatCell_mk, D.mem_doubleCoset_titsSystem_iff K] at hq
    exact hq
  · intro w' hw'
    have hq' : ⟨g, hg⟩ ∈ (D.titsSystem K).bruhatCell
        (QuotientGroup.mk (D.titsSubgroupNOfWeyl K (n w'))) := by
      rw [(D.titsSystem K).bruhatCell_mk, D.mem_doubleCoset_titsSystem_iff K]
      exact hw'
    have heq := huniq _ hq'
    simpa only [w, hmk, hn] using congrArg (D.titsSystemWeylGroupEquiv K) heq

/-- Membership in `D.extendedElementarySubgroup K` is equivalent to lying in some `B(K)`-double
coset of an element of `N(K)`. -/
theorem mem_extendedElementarySubgroup_iff_exists_mem_doubleCoset (g : D.points K) :
    g ∈ D.extendedElementarySubgroup K ↔
      ∃ n : D.weylSubgroup K,
        g ∈ DoubleCoset.doubleCoset (n : D.points K)
          (D.borelSubgroup K) (D.borelSubgroup K) := by
  constructor
  · intro hg
    obtain ⟨n, hn⟩ := (D.titsSystem K).exists_mem_doubleCoset ⟨g, hg⟩
    rw [D.mem_doubleCoset_titsSystem_iff K] at hn
    exact ⟨⟨n.1.1, n.2⟩, hn⟩
  · rintro ⟨n, hn⟩
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hn
    exact (D.extendedElementarySubgroup K).mul_mem
      ((D.extendedElementarySubgroup K).mul_mem
        (D.borelSubgroup_le_extendedElementarySubgroup K hb₁)
        (D.weylSubgroup_le_extendedElementarySubgroup K n.2))
      (D.borelSubgroup_le_extendedElementarySubgroup K hb₂)

end TauCeti.DynkinType.ChevalleyDatum
