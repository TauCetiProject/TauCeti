/-!
# The Tits system and Weyl quotient of a Chevalley datum over a field

For any Chevalley datum `D` and any field `K` (including finite fields and fields of small
characteristic), let `E(K)` (`ChevalleyDatum.extendedElementarySubgroup`) be the subgroup of
`D.points K` generated by all root subgroups together with the actual character-lattice torus
`T(K)`, `B(K)` (`ChevalleyDatum.borelSubgroup`) the positive Borel-type subgroup, and `N(K)`
(`ChevalleyDatum.weylSubgroup`) the subgroup generated by `T(K)` and the pinned simple Weyl
representatives `n_{αᵢ}(1)`.

Combining the simple-root factorization of `U(K)` (`ChevalleyDatum.puncturedPositivePoints`), the
rank-one exchange relation (`ChevalleyDatum.weylElement_mul_rootSubgroup_mul_weylElement`), the
intersection `N(K) ∩ B(K) = T(K)` (`ChevalleyDatum.weylSubgroup_inf_borelSubgroup`), and the joint
generation `B(K) ⊔ N(K) = E(K)` (`ChevalleyDatum.borelSubgroup_sup_weylSubgroup`), this file
constructs a `TauCeti.TitsSystem` on `E(K)` with `B` and `N` induced from `B(K)` and `N(K)` and
simple reflections represented by the `n_{αᵢ}(1)`.

Using the length-increasing cell multiplication law of that Tits system, it then proves that the
kernel of `ChevalleyDatum.weylProjection` is precisely `T(K)`, giving canonical multiplicative
isomorphisms `N(K) / T(K) ≃* W` and `(D.titsSystem K).WeylGroup ≃* W` sending each pinned simple
Weyl representative to its simple reflection in `(t.simplyConnectedRootDatum ht).weylGroup`.

## Main declarations

* `TauCeti.DynkinType.ChevalleyDatum.doubleCoset_weylElement_mul_doubleCoset_subset`: the rank-one
  double-coset multiplication axiom `B n_{αᵢ}(1) B · B w B ⊆ B (n_{αᵢ}(1) w) B ∪ B w B`.
* `TauCeti.DynkinType.ChevalleyDatum.titsSystem`: the Tits system on
  `D.extendedElementarySubgroup K`.
* `TauCeti.DynkinType.ChevalleyDatum.ker_weylProjection`: `ker (D.weylProjection K) = T(K)` over
  every field `K`.
* `TauCeti.DynkinType.ChevalleyDatum.weylQuotientMulEquiv`: `N(K) / T(K) ≃* W`.
* `TauCeti.DynkinType.ChevalleyDatum.titsSystemWeylGroupMulEquiv`:
  `(D.titsSystem K).WeylGroup ≃* W`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 27 and Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§8.2–8.3.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Chapter IV, §2.
-/

public section

open scoped Pointwise
open Multiplicative

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (K : Type v) [Field K]

/-! ### Rank-one double-coset multiplication -/

private theorem doubleCoset_mul_borelSubgroup_subset (g : D.points K)
    {b₁ b₂ : D.points K} (hb₁ : b₁ ∈ D.borelSubgroup K) (hb₂ : b₂ ∈ D.borelSubgroup K)
    {x : D.points K}
    (hx : x ∈ DoubleCoset.doubleCoset g (D.borelSubgroup K) (D.borelSubgroup K)) :
    b₁ * x * b₂ ∈ DoubleCoset.doubleCoset g (D.borelSubgroup K) (D.borelSubgroup K) := by
  obtain ⟨c₁, hc₁, c₂, hc₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
  exact DoubleCoset.mem_doubleCoset.mpr
    ⟨b₁ * c₁, (D.borelSubgroup K).mul_mem hb₁ hc₁,
      c₂ * b₂, (D.borelSubgroup K).mul_mem hc₂ hb₂, by group⟩

private theorem weylElement_mul_rootSubgroup_simpleIndex_mul_mem_of_pos
    (i : Fin t.rank) (w : D.weylSubgroup K) (u : Kˣ)
    (hδ : (t.simplyConnectedRootDatum ht).weylGroupToPerm
      (D.weylProjection K
        (w⁻¹ * ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩))
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) * (w : D.points K) ∈
      DoubleCoset.doubleCoset (w : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  let r := D.weylElement (t.simpleIndex ht i) K 1
  let r_sub : D.weylSubgroup K := ⟨r, D.weylElement_mem_weylSubgroup K i⟩
  let x' := D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (-((u⁻¹ : Kˣ) : K)))
  let b₁ := x' * D.simpleCorootPoints i K (-u⁻¹)
  have hx'B : x' ∈ D.borelSubgroup K := D.positivePoints_le_borelSubgroup K
    (D.rootSubgroupPoints_mem_positivePoints K (simpleIndex_mem_posRoots i) _)
  have hb₁ : b₁ ∈ D.borelSubgroup K := (D.borelSubgroup K).mul_mem hx'B (by
    rw [D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩)
  have hb₂ : MulAut.conj ((w⁻¹ * r_sub : D.weylSubgroup K) : D.points K) x' ∈
      D.borelSubgroup K := by
    have hmem : MulAut.conj ((w⁻¹ * r_sub : D.weylSubgroup K) : D.points K) x' ∈
        (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).weylGroupToPerm
          (D.weylProjection K (w⁻¹ * r_sub)) (t.simpleIndex ht i)) K).range := by
      rw [← D.map_range_rootSubgroupPoints_conj K (w⁻¹ * r_sub) (t.simpleIndex ht i)]
      exact Subgroup.mem_map_of_mem _ ⟨_, rfl⟩
    obtain ⟨c, hc⟩ := hmem
    exact D.positivePoints_le_borelSubgroup K
      (hc ▸ D.rootSubgroupPoints_mem_positivePoints K hδ c)
  refine DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, _, hb₂, ?_⟩
  have hrel := D.weylElement_mul_rootSubgroup_mul_weylElement i K u
  calc r * D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) * (w : D.points K)
      = (r * D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) * r) *
          (r⁻¹ * (w : D.points K)) := by group
    _ = (b₁ * r * x') * (r⁻¹ * (w : D.points K)) := by rw [hrel]
    _ = b₁ * (w : D.points K) *
          MulAut.conj ((w⁻¹ * r_sub : D.weylSubgroup K) : D.points K) x' := by
          simp only [MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv, r_sub]
          group

private theorem weylElement_mul_rootSubgroup_simpleIndex_mul_mem
    (i : Fin t.rank) (w : D.weylSubgroup K) (a : Multiplicative K) :
    D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K a * (w : D.points K) ∈
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * w)
          (D.borelSubgroup K) (D.borelSubgroup K) ∪
        DoubleCoset.doubleCoset (w : D.points K)
          (D.borelSubgroup K) (D.borelSubgroup K) := by
  let β := (t.simplyConnectedRootDatum ht).weylGroupToPerm
    (D.weylProjection K w⁻¹) (t.simpleIndex ht i)
  rcases mem_posRoots_or_mem_negRoots (t.rationalRootSystem ht) (t.rationalBase ht) β with hβ | hβ
  · have hconj : MulAut.conj ((w⁻¹ : D.weylSubgroup K) : D.points K)
        (D.rootSubgroupPoints (t.simpleIndex ht i) K a) ∈ D.borelSubgroup K := by
      have hmem : MulAut.conj ((w⁻¹ : D.weylSubgroup K) : D.points K)
          (D.rootSubgroupPoints (t.simpleIndex ht i) K a) ∈ (D.rootSubgroupPoints β K).range := by
        rw [← D.map_range_rootSubgroupPoints_conj K w⁻¹ (t.simpleIndex ht i)]
        exact Subgroup.mem_map_of_mem _ ⟨a, rfl⟩
      obtain ⟨u, hu⟩ := hmem
      exact D.positivePoints_le_borelSubgroup K
        (hu ▸ D.rootSubgroupPoints_mem_positivePoints K hβ u)
    refine Or.inl (DoubleCoset.mem_doubleCoset.mpr
      ⟨1, (D.borelSubgroup K).one_mem, _, hconj, ?_⟩)
    simp only [MulAut.conj_apply, Subgroup.coe_inv]
    group
  · by_cases ha : toAdd a = 0
    · refine Or.inl (DoubleCoset.mem_doubleCoset.mpr
        ⟨1, (D.borelSubgroup K).one_mem, 1, (D.borelSubgroup K).one_mem, ?_⟩)
      rw [toAdd_eq_zero.mp ha, map_one, mul_one, mul_one, one_mul]
    · refine Or.inr ?_
      have hδ : (t.simplyConnectedRootDatum ht).weylGroupToPerm
          (D.weylProjection K (w⁻¹ *
            ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩))
          (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
        have hδ_eq : (t.simplyConnectedRootDatum ht).weylGroupToPerm
            (D.weylProjection K (w⁻¹ *
              ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩))
            (t.simpleIndex ht i) = (t.rationalRootSystem ht).reflectionPerm β β := by
          rw [t.reflectionPerm_rationalRootSystem ht, map_mul (D.weylProjection K),
            D.weylProjection_weylElement, RootPairing.weylGroupToPerm_mul_ofIdx_apply]
          simpa only [RootPairing.indexNeg_neg, β] using
            (t.simplyConnectedRootDatum ht).weylGroupToPerm_neg
              (D.weylProjection K w⁻¹) (t.simpleIndex ht i)
        rwa [hδ_eq, reflectionPerm_self_mem_posRoots_iff_mem_negRoots]
      simpa only [Units.val_mk0, ofAdd_toAdd] using
        D.weylElement_mul_rootSubgroup_simpleIndex_mul_mem_of_pos K i w (Units.mk0 (toAdd a) ha)
          hδ

private theorem weylElement_mul_borelSubgroup_mul_mem (i : Fin t.rank) (w : D.weylSubgroup K)
    {b : D.points K} (hb : b ∈ D.borelSubgroup K) :
    D.weylElement (t.simpleIndex ht i) K 1 * b * (w : D.points K) ∈
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * w)
          (D.borelSubgroup K) (D.borelSubgroup K) ∪
        DoubleCoset.doubleCoset (w : D.points K)
          (D.borelSubgroup K) (D.borelSubgroup K) := by
  let r := D.weylElement (t.simpleIndex ht i) K 1
  obtain ⟨u, hu, s, rfl⟩ := (D.mem_borelSubgroup_iff K).mp hb
  obtain ⟨v, hv, a, rfl⟩ :=
    (D.mem_positivePoints_iff_exists_mem_puncturedPositivePoints_mul i K u).mp hu
  have hv' : r * v * r⁻¹ ∈ D.borelSubgroup K := by
    apply D.positivePoints_le_borelSubgroup K
    apply D.puncturedPositivePoints_le_positivePoints i K
    exact (Subgroup.mem_normalizer_iff.mp
      (D.weylElement_mem_normalizer_puncturedPositivePoints i K) v).mp hv
  have ht' : (w : D.points K)⁻¹ * D.torusPoints K s * (w : D.points K) ∈ D.borelSubgroup K := by
    apply D.range_torusPoints_le_borelSubgroup K
    have hnorm := Subgroup.mem_normalizer_iff.mp
      (D.weylSubgroup_le_normalizer_range_torusPoints K w⁻¹.2) (D.torusPoints K s)
    simpa only [Subgroup.coe_inv, inv_inv] using hnorm.mp ⟨s, rfl⟩
  have heq : r * (v * D.rootSubgroupPoints (t.simpleIndex ht i) K a * D.torusPoints K s) *
      (w : D.points K) =
      (r * v * r⁻¹) * (r * D.rootSubgroupPoints (t.simpleIndex ht i) K a * (w : D.points K)) *
        ((w : D.points K)⁻¹ * D.torusPoints K s * (w : D.points K)) := by group
  rw [heq]
  exact (D.weylElement_mul_rootSubgroup_simpleIndex_mul_mem K i w a).imp
    (D.doubleCoset_mul_borelSubgroup_subset K _ hv' ht')
    (D.doubleCoset_mul_borelSubgroup_subset K _ hv' ht')

/-- Over every field, multiplying a Bruhat double coset on the left by a simple Weyl double coset
produces at most the adjacent cell and the original cell. -/
theorem doubleCoset_weylElement_mul_doubleCoset_subset (i : Fin t.rank) (w : D.weylSubgroup K) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K) (D.borelSubgroup K) *
      DoubleCoset.doubleCoset (w : D.points K)
        (D.borelSubgroup K) (D.borelSubgroup K) ⊆
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * w)
        (D.borelSubgroup K) (D.borelSubgroup K) ∪
      DoubleCoset.doubleCoset (w : D.points K)
        (D.borelSubgroup K) (D.borelSubgroup K) := by
  rintro _ ⟨_, hy₁, _, hy₂, rfl⟩
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hy₁
  obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hy₂
  dsimp only
  have heq : b₁ * D.weylElement (t.simpleIndex ht i) K 1 * b₂ * (b₃ * (w : D.points K) * b₄) =
      b₁ * (D.weylElement (t.simpleIndex ht i) K 1 * (b₂ * b₃) * (w : D.points K)) * b₄ := by
    group
  rw [heq]
  exact (D.weylElement_mul_borelSubgroup_mul_mem K i w ((D.borelSubgroup K).mul_mem hb₂ hb₃)).imp
    (D.doubleCoset_mul_borelSubgroup_subset K _ hb₁ hb₄)
    (D.doubleCoset_mul_borelSubgroup_subset K _ hb₁ hb₄)

/-! ### The Tits system on the extended elementary subgroup -/

private noncomputable def simpleWeylSubgroupOf (i : Fin t.rank) :
    (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  ⟨⟨D.weylElement (t.simpleIndex ht i) K 1,
      D.weylSubgroup_le_extendedElementarySubgroup K (D.weylElement_mem_weylSubgroup K i)⟩,
    D.weylElement_mem_weylSubgroup K i⟩

private theorem intersection_subgroupOf_eq_comap :
    ((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)).subgroupOf
        ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)) =
      ((D.borelSubgroup K).subgroupOf (D.weylSubgroup K)).comap
        (Subgroup.subgroupOfEquivOfLe
          (D.weylSubgroup_le_extendedElementarySubgroup K)).toMonoidHom := by
  ext n
  exact Iff.rfl

private instance normal_borelSubgroup_subgroupOf_weylSubgroup_extendedElementarySubgroup :
    (((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)).subgroupOf
      ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K))).Normal := by
  rw [D.intersection_subgroupOf_eq_comap K]
  exact Subgroup.Normal.comap inferInstance _

private theorem closure_simpleWeylSubgroupOf_quotient :
    Subgroup.closure (Set.range fun i : Fin t.rank =>
      (QuotientGroup.mk (D.simpleWeylSubgroupOf K i) :
        (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K) ⧸
          ((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)).subgroupOf
            ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)))) = ⊤ := by
  let E := D.extendedElementarySubgroup K
  let N_E := (D.weylSubgroup K).subgroupOf E
  let B_E := (D.borelSubgroup K).subgroupOf E
  let S := Set.range fun i : Fin t.rank =>
    (QuotientGroup.mk (D.simpleWeylSubgroupOf K i) : N_E ⧸ B_E.subgroupOf N_E)
  let eN := Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup K)
  let π : D.weylSubgroup K →* N_E ⧸ B_E.subgroupOf N_E :=
    (QuotientGroup.mk' (B_E.subgroupOf N_E)).comp eN.symm.toMonoidHom
  have hle : D.weylSubgroup K ≤ ((Subgroup.closure S).comap π).map (D.weylSubgroup K).subtype := by
    apply (D.weylSubgroup_def K).le.trans
    apply (Subgroup.closure_le _).mpr
    rintro g (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · refine ⟨⟨D.torusPoints K s, D.torusPoints_mem_weylSubgroup K s⟩, ?_, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap]
      have hmem : eN.symm ⟨D.torusPoints K s, D.torusPoints_mem_weylSubgroup K s⟩ ∈
          B_E.subgroupOf N_E :=
        D.range_torusPoints_le_borelSubgroup K ⟨s, rfl⟩
      have hmk : π ⟨D.torusPoints K s, D.torusPoints_mem_weylSubgroup K s⟩ = 1 :=
        (QuotientGroup.eq_one_iff _).mpr hmem
      rw [hmk]
      exact (Subgroup.closure S).one_mem
    · refine ⟨⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩,
        ?_, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap]
      exact Subgroup.subset_closure ⟨i, rfl⟩
  rw [eq_top_iff]
  intro q _
  induction q using QuotientGroup.induction_on with
  | H n =>
    obtain ⟨m, hm, hm_eq⟩ := hle n.2
    have hmn : eN.symm m = n := by
      apply eN.injective
      rw [MulEquiv.apply_symm_apply]
      exact Subtype.ext hm_eq
    rw [SetLike.mem_coe, Subgroup.mem_comap] at hm
    simpa only [π, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, hmn,
      QuotientGroup.mk'_apply] using hm

private theorem mem_doubleCoset_extendedElementarySubgroup_iff
    (g : D.extendedElementarySubgroup K) (z : D.extendedElementarySubgroup K) :
    z ∈ DoubleCoset.doubleCoset g
        ((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K))
        ((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)) ↔
      (z : D.points K) ∈
        DoubleCoset.doubleCoset (g : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  constructor
  · rintro h
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp h
    exact DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · rintro h
    obtain ⟨b₁, hb₁, b₂, hb₂, hz⟩ := DoubleCoset.mem_doubleCoset.mp h
    refine DoubleCoset.mem_doubleCoset.mpr
      ⟨⟨b₁, D.borelSubgroup_le_extendedElementarySubgroup K hb₁⟩, hb₁,
        ⟨b₂, D.borelSubgroup_le_extendedElementarySubgroup K hb₂⟩, hb₂, ?_⟩
    exact Subtype.ext hz

/-- **The Tits system of a Chevalley datum over a field.** On `E(K)`
(`ChevalleyDatum.extendedElementarySubgroup`), the positive Borel-type subgroup `B(K)`, the Weyl
subgroup `N(K)`, and the classes of the pinned simple Weyl representatives `n_{αᵢ}(1)` form a
`TauCeti.TitsSystem` over every field `K`. -/
noncomputable def titsSystem : TauCeti.TitsSystem (D.extendedElementarySubgroup K) where
  subgroupB := (D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)
  subgroupN := (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)
  closure_subgroupB_union_subgroupN := by
    rw [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq]
    apply Subgroup.map_injective (D.extendedElementarySubgroup K).subtype_injective
    rw [Subgroup.map_sup,
      Subgroup.map_subgroupOf_eq_of_le (D.borelSubgroup_le_extendedElementarySubgroup K),
      Subgroup.map_subgroupOf_eq_of_le (D.weylSubgroup_le_extendedElementarySubgroup K),
      D.borelSubgroup_sup_weylSubgroup K, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  intersection_normal := inferInstance
  simple := Set.range fun i : Fin t.rank => QuotientGroup.mk (D.simpleWeylSubgroupOf K i)
  closure_simple := D.closure_simpleWeylSubgroupOf_quotient K
  exists_simpleRep_mul_self_mem := by
    rintro _ ⟨i, rfl⟩
    refine ⟨D.simpleWeylSubgroupOf K i, rfl, ?_⟩
    -- Unfold the subtype product to the ambient square of `n_{αᵢ}(1)` in `D.points K`.
    change (D.weylElement (t.simpleIndex ht i) K 1 *
      D.weylElement (t.simpleIndex ht i) K 1) ∈ D.borelSubgroup K
    rw [D.weylElement_mul_self, D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  mul_doubleCoset_subset := by
    rintro _ ⟨i, rfl⟩
    refine ⟨D.simpleWeylSubgroupOf K i, rfl, fun w z hz => ?_⟩
    obtain ⟨z₁, hz₁, z₂, hz₂, rfl⟩ := Set.mem_mul.mp hz
    rw [D.mem_doubleCoset_extendedElementarySubgroup_iff K] at hz₁ hz₂
    have hmem := D.doubleCoset_weylElement_mul_doubleCoset_subset K i ⟨(w : D.points K), w.2⟩
      ⟨z₁, hz₁, z₂, hz₂, rfl⟩
    simpa only [Set.mem_union, D.mem_doubleCoset_extendedElementarySubgroup_iff K,
      Subgroup.coe_mul, simpleWeylSubgroupOf] using hmem
  exists_conj_not_mem := by
    rintro _ ⟨i, rfl⟩
    obtain ⟨b, hb⟩ := D.exists_weylElement_conj_notMem_borelSubgroup K i
    refine ⟨D.simpleWeylSubgroupOf K i, rfl,
      ⟨⟨b.1, D.borelSubgroup_le_extendedElementarySubgroup K b.2⟩, b.2⟩, ?_⟩
    exact hb

/-- The `B` subgroup of `D.titsSystem K` is `B(K)` inside `E(K)`. -/
@[simp]
theorem titsSystem_subgroupB :
    (D.titsSystem K).subgroupB =
      (D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  (rfl)

/-- The `N` subgroup of `D.titsSystem K` is `N(K)` inside `E(K)`. -/
@[simp]
theorem titsSystem_subgroupN :
    (D.titsSystem K).subgroupN =
      (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  (rfl)

/-- The `i`-th pinned simple Weyl representative viewed in `(D.titsSystem K).subgroupN`. -/
noncomputable def titsSystemSimpleRepresentative (i : Fin t.rank) :
    (D.titsSystem K).subgroupN :=
  ⟨⟨D.weylElement (t.simpleIndex ht i) K 1,
      D.weylSubgroup_le_extendedElementarySubgroup K (D.weylElement_mem_weylSubgroup K i)⟩,
    by rw [D.titsSystem_subgroupN]; exact D.weylElement_mem_weylSubgroup K i⟩

@[simp]
theorem coe_titsSystemSimpleRepresentative (i : Fin t.rank) :
    (((D.titsSystemSimpleRepresentative K i : D.extendedElementarySubgroup K) : D.points K)) =
      D.weylElement (t.simpleIndex ht i) K 1 :=
  (rfl)

/-- The simple reflections of `D.titsSystem K` are the classes of `n_{αᵢ}(1)`. -/
theorem titsSystem_simple_def :
    (D.titsSystem K).simple =
      Set.range fun i : Fin t.rank => QuotientGroup.mk (D.titsSystemSimpleRepresentative K i) :=
  (rfl)

/-! ### Kernel of the Weyl projection and the Weyl-group isomorphism -/

private theorem mul_rootSubgroup_one_mul_mem_bruhatCell_of_weylProjection_eq_one
    (i : Fin t.rank) (w_E : (D.titsSystem K).subgroupN)
    (hproj_inv : D.weylProjection K
      (⟨((w_E : D.extendedElementarySubgroup K) : D.points K),
        by simpa only [D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] using w_E.2⟩⁻¹ *
        ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩) = 1) :
    (D.titsSystemSimpleRepresentative K i : D.extendedElementarySubgroup K) *
        ⟨D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd 1),
          D.elementarySubgroup_le_extendedElementarySubgroup K
            (D.rootSubgroupPoints_mem_elementarySubgroup K _ _)⟩ * w_E ∈
      (D.titsSystem K).bruhatCell (QuotientGroup.mk w_E) := by
  rw [(D.titsSystem K).bruhatCell_mk, D.titsSystem_subgroupB,
    D.mem_doubleCoset_extendedElementarySubgroup_iff K]
  let w_N : D.weylSubgroup K :=
    ⟨((w_E : D.extendedElementarySubgroup K) : D.points K),
      by simpa only [D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] using w_E.2⟩
  have hδ : (t.simplyConnectedRootDatum ht).weylGroupToPerm
      (D.weylProjection K (w_N⁻¹ *
        ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩))
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [hproj_inv, map_one, Equiv.Perm.one_apply]
    exact simpleIndex_mem_posRoots i
  simpa only [Units.val_one, Subgroup.coe_mul, D.coe_titsSystemSimpleRepresentative] using
    D.weylElement_mul_rootSubgroup_simpleIndex_mul_mem_of_pos K i w_N 1 hδ

private theorem weylProjection_inv_mul_weylElement_eq_one (i : Fin t.rank)
    {g w_N : D.weylSubgroup K} (hg : D.weylProjection K g = 1)
    (hdiff_B :
      ((((⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩ * w_N)⁻¹ *
        g : D.weylSubgroup K) : D.points K)) ∈ D.borelSubgroup K) :
    D.weylProjection K
      (w_N⁻¹ * ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩) =
        1 := by
  let r_N : D.weylSubgroup K :=
    ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩
  have h1 := D.weylProjection_eq_one_of_mem_borelSubgroup K hdiff_B
  rw [map_mul, map_inv, hg, mul_one, inv_eq_one, map_mul] at h1
  have hr_inv : (D.weylProjection K r_N)⁻¹ = D.weylProjection K r_N := by
    simp only [r_N, D.weylProjection_weylElement, RootPairing.weylGroup.ofIdx_inv_eq]
  rw [map_mul, map_inv, ← inv_eq_one, mul_inv_rev, hr_inv, inv_inv]
  exact h1

private theorem mul_rootSubgroup_one_mul_mem_bruhatCell_mul (i : Fin t.rank)
    {s q' : (D.titsSystem K).WeylGroup} (hs : s ∈ (D.titsSystem K).simple)
    (hsi : (QuotientGroup.mk (D.titsSystemSimpleRepresentative K i) :
      (D.titsSystem K).WeylGroup) = s)
    (hlen_le : (D.titsSystem K).simpleGenerators.wordLength q' ≤
      (D.titsSystem K).simpleGenerators.wordLength (s * q'))
    (w_E : (D.titsSystem K).subgroupN) (hw_E : (QuotientGroup.mk w_E : _) = q') :
    (D.titsSystemSimpleRepresentative K i : D.extendedElementarySubgroup K) *
        ⟨D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd 1),
          D.elementarySubgroup_le_extendedElementarySubgroup K
            (D.rootSubgroupPoints_mem_elementarySubgroup K _ _)⟩ * w_E ∈
      (D.titsSystem K).bruhatCell (s * q') := by
  let x₁ : D.extendedElementarySubgroup K :=
    ⟨D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd 1),
      D.elementarySubgroup_le_extendedElementarySubgroup K
        (D.rootSubgroupPoints_mem_elementarySubgroup K _ _)⟩
  have hx₁B : x₁ ∈ (D.titsSystem K).subgroupB := by
    rw [D.titsSystem_subgroupB, Subgroup.mem_subgroupOf]
    exact D.positivePoints_le_borelSubgroup K
      (D.rootSubgroupPoints_mem_positivePoints K (simpleIndex_mem_posRoots i) _)
  rw [← (D.titsSystem K).bruhatCell_mul_eq_of_wordLength_le hs hlen_le]
  refine ⟨(D.titsSystemSimpleRepresentative K i : _) * x₁, ?_, w_E, ?_, rfl⟩
  · rw [← hsi, (D.titsSystem K).bruhatCell_mk]
    exact DoubleCoset.mem_doubleCoset.mpr ⟨1, (D.titsSystem K).subgroupB.one_mem, x₁, hx₁B, by simp⟩
  · rw [← hw_E, (D.titsSystem K).bruhatCell_mk]
    exact DoubleCoset.mem_doubleCoset_self _ _ _

private theorem mem_borelSubgroup_of_weylProjection_eq_one {g : D.weylSubgroup K}
    (hg : D.weylProjection K g = 1) :
    (g : D.points K) ∈ D.borelSubgroup K := by
  let T := D.titsSystem K
  let g_E : T.subgroupN :=
    ⟨⟨g.1, D.weylSubgroup_le_extendedElementarySubgroup K g.2⟩,
      by rw [D.titsSystem_subgroupN]; exact g.2⟩
  let q : T.WeylGroup := QuotientGroup.mk g_E
  suffices hq : q = 1 by
    simpa only [T, TitsSystem.mem_intersection, D.titsSystem_subgroupB,
      Subgroup.mem_subgroupOf] using (QuotientGroup.eq_one_iff g_E).mp hq
  by_contra hq
  obtain ⟨l, hl, hlen, hprod⟩ := T.exists_prod_eq_of_wordLength q
  rcases l with _ | ⟨s, l'⟩
  · exact hq (by simpa using hprod.symm)
  have hs : s ∈ T.simple := hl s List.mem_cons_self
  have hl' : ∀ s' ∈ l', s' ∈ T.simple := fun s' hs' => hl s' (List.mem_cons_of_mem s hs')
  let q' := l'.prod
  have hsq' : s * q' = q := by simpa [q'] using hprod
  have hlen_le : T.simpleGenerators.wordLength q' ≤ T.simpleGenerators.wordLength (s * q') := by
    rw [hsq', ← hlen, List.length_cons]
    exact (T.wordLength_prod_le hl').trans (Nat.le_succ _)
  obtain ⟨i, hsi⟩ := (D.titsSystem_simple_def K ▸ hs)
  dsimp only at hsi
  obtain ⟨w_E, hw_E⟩ := QuotientGroup.mk_surjective q'
  let w_N : D.weylSubgroup K :=
    ⟨((w_E : D.extendedElementarySubgroup K) : D.points K),
      by simpa only [T, D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] using w_E.2⟩
  have hdiff_B :
      ((((⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩ * w_N)⁻¹ *
        g : D.weylSubgroup K) : D.points K)) ∈ D.borelSubgroup K := by
    have hrw_eq :
        (QuotientGroup.mk (D.titsSystemSimpleRepresentative K i * w_E) : T.WeylGroup) =
          QuotientGroup.mk g_E := by
      change (QuotientGroup.mk (D.titsSystemSimpleRepresentative K i * w_E) : T.WeylGroup) = q
      rw [QuotientGroup.mk_mul, hsi, hw_E, hsq']
    simpa only [T, TitsSystem.mem_intersection, D.titsSystem_subgroupB, Subgroup.mem_subgroupOf,
      Subgroup.coe_mul, Subgroup.coe_inv, D.coe_titsSystemSimpleRepresentative, w_N, g_E]
      using (T.mem_intersection _).mp (QuotientGroup.eq.mp hrw_eq)
  have hz₁ := D.mul_rootSubgroup_one_mul_mem_bruhatCell_mul K i hs hsi hlen_le w_E hw_E
  have hz₂ : (D.titsSystemSimpleRepresentative K i : D.extendedElementarySubgroup K) *
      ⟨D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd 1),
        D.elementarySubgroup_le_extendedElementarySubgroup K
          (D.rootSubgroupPoints_mem_elementarySubgroup K _ _)⟩ * w_E ∈ T.bruhatCell q' := by
    rw [← hw_E]
    exact D.mul_rootSubgroup_one_mul_mem_bruhatCell_of_weylProjection_eq_one K i w_E
      (D.weylProjection_inv_mul_weylElement_eq_one K i hg hdiff_B)
  exact T.simple_ne_one hs
    (mul_right_cancel ((T.eq_of_mem_bruhatCell_of_mem hz₁ hz₂).trans (one_mul q').symm))

/-- Over every field, an element of `N(K)` projects to `1` in the Weyl group if and only if it
belongs to the actual character-lattice torus `T(K)`. -/
theorem mem_ker_weylProjection_iff (g : D.weylSubgroup K) :
    g ∈ (D.weylProjection K).ker ↔ (g : D.points K) ∈ (D.torusPoints K).range := by
  rw [MonoidHom.mem_ker, ← D.weylSubgroup_inf_borelSubgroup K, Subgroup.mem_inf]
  refine ⟨fun hg => ⟨g.2, D.mem_borelSubgroup_of_weylProjection_eq_one K hg⟩, fun ⟨_, hgB⟩ => ?_⟩
  exact D.weylProjection_eq_one_of_mem_borelSubgroup K hgB

/-- Over every field, the kernel of `D.weylProjection K` is the actual torus inside `N(K)`. -/
@[simp]
theorem ker_weylProjection :
    (D.weylProjection K).ker = ((D.torusPoints K).range).subgroupOf (D.weylSubgroup K) := by
  ext g
  exact D.mem_ker_weylProjection_iff K g

/-- **The Weyl quotient isomorphism.** Over every field `K`, the quotient `N(K) / T(K)` of the
Chevalley Weyl subgroup by the actual character-lattice torus is canonically isomorphic to the Weyl
group of `t.simplyConnectedRootDatum ht`. -/
noncomputable def weylQuotientMulEquiv :
    D.weylSubgroup K ⧸ ((D.torusPoints K).range).subgroupOf (D.weylSubgroup K) ≃*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  (QuotientGroup.quotientMulEquivOfEq (D.ker_weylProjection K).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (D.weylProjection K)
      (D.weylProjection_surjective K))

/-- `D.weylQuotientMulEquiv K` evaluates on coset representatives via `D.weylProjection K`. -/
@[simp]
theorem weylQuotientMulEquiv_mk (g : D.weylSubgroup K) :
    D.weylQuotientMulEquiv K (QuotientGroup.mk g) = D.weylProjection K g :=
  (rfl)

/-- `D.weylQuotientMulEquiv K` sends each pinned simple Weyl representative `n_{αᵢ}(1)` to the
corresponding simple reflection `s_{αᵢ}`. -/
theorem weylQuotientMulEquiv_mk_weylElement (i : Fin t.rank) :
    D.weylQuotientMulEquiv K
        (QuotientGroup.mk
          ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩) =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  rw [D.weylQuotientMulEquiv_mk, D.weylProjection_weylElement]

/-- The Weyl projection restricted to `(D.titsSystem K).subgroupN`. -/
noncomputable def titsSystemWeylProjection :
    (D.titsSystem K).subgroupN →* (t.simplyConnectedRootDatum ht).weylGroup where
  toFun n := D.weylProjection K
    ⟨((n : D.extendedElementarySubgroup K) : D.points K),
      by simpa only [D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] using n.2⟩
  map_one' := map_one (D.weylProjection K)
  map_mul' x y := by
    rw [← map_mul (D.weylProjection K)]
    rfl

@[simp]
theorem titsSystemWeylProjection_apply (n : (D.titsSystem K).subgroupN) :
    D.titsSystemWeylProjection K n =
      D.weylProjection K
        ⟨((n : D.extendedElementarySubgroup K) : D.points K),
          by simpa only [D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] using n.2⟩ :=
  (rfl)

private theorem ker_titsSystemWeylProjection :
    (D.titsSystemWeylProjection K).ker = (D.titsSystem K).intersection := by
  ext n
  have hn : ((n : D.extendedElementarySubgroup K) : D.points K) ∈ D.weylSubgroup K := by
    simpa only [D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] using n.2
  rw [MonoidHom.mem_ker, D.titsSystemWeylProjection_apply]
  have h := D.mem_ker_weylProjection_iff K ⟨((n : D.extendedElementarySubgroup K) : D.points K), hn⟩
  rw [MonoidHom.mem_ker, ← D.weylSubgroup_inf_borelSubgroup K, Subgroup.mem_inf] at h
  exact h.trans ⟨fun ⟨_, hB⟩ => by simpa only [TitsSystem.mem_intersection,
    D.titsSystem_subgroupB, Subgroup.mem_subgroupOf] using hB,
    fun hB => ⟨hn, by simpa only [TitsSystem.mem_intersection,
      D.titsSystem_subgroupB, Subgroup.mem_subgroupOf] using hB⟩⟩

private theorem titsSystemWeylProjection_surjective :
    Function.Surjective (D.titsSystemWeylProjection K) := by
  intro w
  obtain ⟨g, hg⟩ := D.weylProjection_surjective K w
  refine ⟨⟨⟨g.1, D.weylSubgroup_le_extendedElementarySubgroup K g.2⟩,
    by rw [D.titsSystem_subgroupN]; exact g.2⟩, ?_⟩
  rw [D.titsSystemWeylProjection_apply]
  exact hg

/-- The Weyl group of `D.titsSystem K` is canonically isomorphic to the root-datum Weyl group. -/
noncomputable def titsSystemWeylGroupMulEquiv :
    (D.titsSystem K).WeylGroup ≃* (t.simplyConnectedRootDatum ht).weylGroup :=
  (QuotientGroup.quotientMulEquivOfEq (D.ker_titsSystemWeylProjection K).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (D.titsSystemWeylProjection K)
      (D.titsSystemWeylProjection_surjective K))

/-- `D.titsSystemWeylGroupMulEquiv K` evaluates on representatives via `D.weylProjection K`. -/
@[simp]
theorem titsSystemWeylGroupMulEquiv_mk (n : (D.titsSystem K).subgroupN) :
    D.titsSystemWeylGroupMulEquiv K (QuotientGroup.mk n) =
      D.weylProjection K
        ⟨((n : D.extendedElementarySubgroup K) : D.points K),
          by simpa only [D.titsSystem_subgroupN, Subgroup.mem_subgroupOf] using n.2⟩ :=
  (rfl)

/-- Under `D.titsSystemWeylGroupMulEquiv K`, the simple reflections of `D.titsSystem K` correspond
to the simple reflections of `t.simplyConnectedRootDatum ht`. -/
@[simp]
theorem image_titsSystemWeylGroupMulEquiv_simple :
    D.titsSystemWeylGroupMulEquiv K '' (D.titsSystem K).simple =
      Set.range fun i : Fin t.rank =>
        RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  ext w
  rw [D.titsSystem_simple_def]
  simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and,
    D.titsSystemWeylGroupMulEquiv_mk, D.coe_titsSystemSimpleRepresentative,
    D.weylProjection_weylElement]

end TauCeti.DynkinType.ChevalleyDatum
