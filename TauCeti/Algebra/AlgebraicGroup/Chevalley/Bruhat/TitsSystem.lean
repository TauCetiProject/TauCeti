/-!
# The Tits system of a Chevalley datum over a field

Over every field `K`, the Borel-type subgroup `B(K)` and Weyl subgroup `N(K)` of a Chevalley
datum `D` form a `TauCeti.TitsSystem` inside the extended elementary subgroup `E(K)` generated by
all root subgroups and the actual character-lattice torus `T(K)`. The intersection `B(K) ∩ N(K)`
is `T(K)` itself, with no restriction on the field size or characteristic and no requirement that
the datum have the full weight lattice.

To identify `B(K) ∩ N(K)`, any element of `B(K)` normalizes the positive subgroup `U(K)`, so if
it also lies in `N(K)` its Weyl projection preserves the positive roots and therefore equals `1`.
After scalar extension to `AlgebraicClosure K`, an element of `U(K) ∩ N(K)` then centralizes all
represented full-weight torus matrices while acting as the identity on each weight block, forcing
it to be `1`; the modular law yields `B(K) ∩ N(K) = T(K)`.

For the Tits double-coset axiom, punctured-positive factorization splits the positive part of the
middle `B(K)` factor in `B(K) nᵢ B(K) n B(K)` as a punctured-positive element normalized by `nᵢ`
times an `αᵢ`-root element. Depending on whether `w⁻¹(αᵢ)` is positive or negative for
`w = weylProjection n`, the remaining product either passes directly through `n` into
`B(K) (nᵢ n) B(K)`, or sends parameter `0` into `B(K) (nᵢ n) B(K)` while nonzero parameters are
rewritten via the rank-one exchange identity `weylElement_mul_rootSubgroup_mul_weylElement` into
`B(K) n B(K)`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 21–22 and Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§8.1–8.2.
-/

public section

open Multiplicative
open scoped Pointwise

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (K : Type v) [Field K]

attribute [local instance high] Ring.toIntAlgebra
attribute [local instance high] Algebra.toModule

/-! ## Intersection of the Borel and Weyl subgroups -/

/-- Any Weyl-subgroup element lying in the Borel-type subgroup has trivial Weyl projection,
because it normalizes the positive subgroup and therefore preserves the positive roots. -/
theorem weylProjection_eq_one_of_mem_borelSubgroup {g : D.weylSubgroup K}
    (hg : (g : D.points K) ∈ D.borelSubgroup K) :
    D.weylProjection K g = 1 := by
  let _ := t.isReduced_simplyConnectedRootDatum ht
  apply eq_one_of_mapsTo_posRoots (P := t.simplyConnectedRootDatum ht)
    (b := t.simplyConnectedBase ht)
  rw [← t.posRoots_rationalRootSystem ht]
  intro γ hγ
  by_contra hnotpos
  have hneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ ∈
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht) :=
    (not_mem_posRoots_iff_mem_negRoots _ _ _).mp hnotpos
  have hnorm : (D.positivePoints K).map (MulAut.conj (g : D.points K)).toMonoidHom =
      D.positivePoints K := by
    ext x
    rw [Subgroup.mem_map_equiv, MulAut.conj_symm_apply]
    exact (Subgroup.mem_normalizer_iff.mp
      (inv_mem (D.borelSubgroup_le_normalizer_positivePoints K hg)) x).symm
  have himg : D.rootSubgroupPoints
      ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ) K (ofAdd 1) ∈
      (D.positivePoints K).map (MulAut.conj (g : D.points K)).toMonoidHom := by
    rw [D.positivePoints_eq_iSup, D.map_iSup_rootSubgroupPoints_conj]
    exact le_iSup₂ (f := fun δ _ => (D.rootSubgroupPoints δ K).range) _ ⟨γ, hγ, rfl⟩ ⟨ofAdd 1, rfl⟩
  rw [hnorm] at himg
  exact D.rootSubgroupPoints_ofAdd_one_ne_one K _
    ((D.rootSubgroupPoints_mem_borelSubgroup_iff_of_mem_negRoots K hneg (ofAdd 1)).mp
      (D.positivePoints_le_borelSubgroup K himg))

/-- The positive point subgroup meets the Weyl subgroup trivially over every field, including
finite fields where torus characters need not separate weights before scalar extension. -/
@[simp]
theorem positivePoints_inf_weylSubgroup_eq_bot :
    D.positivePoints K ⊓ D.weylSubgroup K = ⊥ := by
  apply eq_bot_iff.mpr
  rintro g ⟨hu, hn⟩
  have hproj : D.weylProjection K ⟨g, hn⟩ = 1 :=
    D.weylProjection_eq_one_of_mem_borelSubgroup K (D.positivePoints_le_borelSubgroup K hu)
  let f : K →+* AlgebraicClosure K := algebraMap K (AlgebraicClosure K)
  let g' : D.points (AlgebraicClosure K) :=
    (D.pointsPresentation K).map (D.pointsPresentation (AlgebraicClosure K)) f g
  have hu' : g' ∈ D.positivePoints (AlgebraicClosure K) :=
    D.map_positivePoints_le f ⟨g, hu, rfl⟩
  have hg'eq : (g' : Matrix.GeneralLinearGroup (Fin D.dim) (AlgebraicClosure K)) =
      Matrix.GeneralLinearGroup.map f (g : Matrix.GeneralLinearGroup (Fin D.dim) K) :=
    GeneralLinear.IntegralPointsPresentation.coe_map
      (D.pointsPresentation K) (D.pointsPresentation (AlgebraicClosure K)) f g
  have hcomm := (D.weylProjection_eq_iff K ⟨g, hn⟩ 1).mp hproj
  have hg'one : ((g' : Matrix.GeneralLinearGroup (Fin D.dim) (AlgebraicClosure K)) :
      Matrix (Fin D.dim) (Fin D.dim) (AlgebraicClosure K)) = 1 := by
    ext i j
    by_cases hij : D.weight i = D.weight j
    · exact D.coe_apply_eq_one_apply_of_mem_positivePoints_of_weight_eq (AlgebraicClosure K) hu' hij
    · rw [Matrix.one_apply_ne (fun heq => hij (congrArg D.weight heq))]
      obtain ⟨s, hs⟩ := exists_torusCharacter_ne (K := AlgebraicClosure K) hij
      have hs' := mul_inv_eq_iff_eq_mul.mp (by
        simpa only [← hg'eq, map_one, MulAut.one_apply] using hcomm s)
      have hmat := congrArg
        (fun y : Matrix.GeneralLinearGroup (Fin D.dim) (AlgebraicClosure K) =>
          (y : Matrix (Fin D.dim) (Fin D.dim) (AlgebraicClosure K))) hs'
      simp only [Units.val_mul, diagGL_coe] at hmat
      rw [hg'eq]
      exact apply_eq_zero_of_commute_diagonal hmat.symm fun h => hs (Units.ext h)
  refine Subgroup.mem_bot.mpr (Subtype.ext (Matrix.GeneralLinearGroup.map_injective f.injective
    (Units.ext ?_)))
  simpa only [hg'eq, Subgroup.coe_one, map_one, Units.val_one] using hg'one

/-- Over every field, the intersection of the Borel-type subgroup and the Weyl subgroup is
precisely the actual character-lattice torus. -/
@[simp]
theorem borelSubgroup_inf_weylSubgroup_eq_range_torusPoints :
    D.borelSubgroup K ⊓ D.weylSubgroup K = (D.torusPoints K).range := by
  have hT : (D.torusPoints K).range ≤ D.weylSubgroup K := by
    rintro _ ⟨s, rfl⟩; exact D.torusPoints_mem_weylSubgroup K s
  rw [D.borelSubgroup_def, inf_comm,
    ← Subgroup.inf_sup_assoc_of_le
      (Subgroup.coe_mul_of_right_le_normalizer_left _ _
        (D.range_torusPoints_le_normalizer_positivePoints K))
      hT,
    inf_comm, D.positivePoints_inf_weylSubgroup_eq_bot K, bot_sup_eq]

/-! ## Double-coset multiplication laws -/

private theorem rootSubgroup_mul_mem_doubleCoset_of_mem_posRoots (i : Fin t.rank)
    (n : D.weylSubgroup K)
    (hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Multiplicative K) :
    D.weylElement (t.simpleIndex ht i) K 1 * D.rootSubgroupPoints (t.simpleIndex ht i) K u *
        (n : D.points K) ∈
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * (n : D.points K))
        (D.borelSubgroup K) (D.borelSubgroup K) := by
  obtain ⟨v, hv⟩ := D.conj_rootSubgroupPoints_mem_range K n⁻¹ (t.simpleIndex ht i) u
  rw [(D.weylProjection K).map_inv] at hv
  have hconj : (n : D.points K)⁻¹ * D.rootSubgroupPoints (t.simpleIndex ht i) K u *
      (n : D.points K) ∈ D.borelSubgroup K := by
    apply D.positivePoints_le_borelSubgroup K
    have hmem := D.rootSubgroupPoints_mem_positivePoints K hpos v
    rw [hv] at hmem
    simpa only [MulAut.conj_apply, Subgroup.coe_inv, inv_inv] using hmem
  exact DoubleCoset.mem_doubleCoset.mpr ⟨1, (D.borelSubgroup K).one_mem, _, hconj, by group⟩

/-- When `w⁻¹(αᵢ)` is negative for `w = D.weylProjection K n`, every nonzero simple-root
parameter `u : Kˣ` puts `nᵢ xᵢ(u) n` back inside the double coset `B(K) n B(K)`. -/
theorem weylElement_mul_rootSubgroupPoints_mul_mem_doubleCoset_of_mem_negRoots (i : Fin t.rank)
    (n : D.weylSubgroup K)
    (hneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
      (t.simpleIndex ht i) ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Kˣ) :
    D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) * (n : D.points K) ∈
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  let ni : D.weylSubgroup K :=
    ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩
  have hrootpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm
      (D.weylProjection K (n⁻¹ * ni)) (t.simpleIndex ht i) ∈
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    let _ := (t.simplyConnectedRootDatum ht).indexNeg
    have hneg' : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
        (t.simpleIndex ht i) ∈
        negRoots (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) := by
      rwa [← not_mem_posRoots_iff_mem_negRoots, ← t.posRoots_rationalRootSystem ht,
        not_mem_posRoots_iff_mem_negRoots]
    rw [t.posRoots_rationalRootSystem ht, map_mul, map_inv, D.weylProjection_weylElement,
      RootPairing.weylGroupToPerm_mul_ofIdx_apply, ← RootPairing.indexNeg_neg,
      RootPairing.weylGroupToPerm_neg, RootPairing.indexNeg_neg]
    exact (reflectionPerm_self_mem_posRoots_iff_mem_negRoots _ _ _).mpr hneg'
  have hleft : D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (-((u⁻¹ : Kˣ) : K))) *
      D.simpleCorootPoints i K (-u⁻¹) ∈ D.borelSubgroup K := by
    refine mul_mem (D.positivePoints_le_borelSubgroup K
      (D.rootSubgroupPoints_mem_positivePoints K (simpleIndex_mem_posRoots i) _)) ?_
    rw [D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  obtain ⟨v, hv⟩ := D.conj_rootSubgroupPoints_mem_range K (n⁻¹ * ni) (t.simpleIndex ht i)
    (ofAdd (-((u⁻¹ : Kˣ) : K)))
  have hright : (n : D.points K)⁻¹ *
      (D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (-((u⁻¹ : Kˣ) : K))) *
        (D.weylElement (t.simpleIndex ht i) K 1)⁻¹) * (n : D.points K) ∈
      D.borelSubgroup K := by
    apply D.positivePoints_le_borelSubgroup K
    have hmem := D.rootSubgroupPoints_mem_positivePoints K hrootpos v
    rw [hv] at hmem
    have heq : MulAut.conj ((n⁻¹ * ni : D.weylSubgroup K) : D.points K)
        (D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (-((u⁻¹ : Kˣ) : K)))) =
        (n : D.points K)⁻¹ *
          (D.weylElement (t.simpleIndex ht i) K 1 *
            D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (-((u⁻¹ : Kˣ) : K))) *
            (D.weylElement (t.simpleIndex ht i) K 1)⁻¹) * (n : D.points K) := by
      simp only [ni, MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv]
      group
    rwa [heq] at hmem
  have hexch := mul_inv_eq_of_eq_mul (D.weylElement_mul_rootSubgroup_mul_weylElement i K u).symm
  refine DoubleCoset.mem_doubleCoset.mpr ⟨_, hleft, _, hright, ?_⟩
  calc
    D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) * (n : D.points K)
      = (D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (-((u⁻¹ : Kˣ) : K))) *
          D.simpleCorootPoints i K (-u⁻¹) * D.weylElement (t.simpleIndex ht i) K 1 *
          D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (-((u⁻¹ : Kˣ) : K))) *
          (D.weylElement (t.simpleIndex ht i) K 1)⁻¹) * (n : D.points K) := by rw [← hexch]
    _ = _ := by group

private theorem exists_mem_doubleCoset_weylElement_mul_rootSubgroupPoints (i : Fin t.rank)
    (n : D.weylSubgroup K) {x : D.points K}
    (hx : x ∈ DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K) (D.borelSubgroup K) *
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K)) :
    ∃ a : Multiplicative K,
      x ∈ DoubleCoset.doubleCoset
        (D.weylElement (t.simpleIndex ht i) K 1 * D.rootSubgroupPoints (t.simpleIndex ht i) K a *
          (n : D.points K))
        (D.borelSubgroup K) (D.borelSubgroup K) := by
  obtain ⟨_, hx₁, _, hx₂, rfl⟩ := hx
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx₁
  obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx₂
  obtain ⟨u, hu, s, hus⟩ := (D.mem_borelSubgroup_iff K).mp (mul_mem hb₂ hb₃)
  obtain ⟨q, hq, a, rfl⟩ := (D.mem_positivePoints_iff_exists_puncturedPositivePoints_mul i K).mp hu
  let ni := D.weylElement (t.simpleIndex ht i) K 1
  have hqn : ni * q * ni⁻¹ ∈ D.borelSubgroup K :=
    D.positivePoints_le_borelSubgroup K (D.puncturedPositivePoints_le_positivePoints i K
      ((Subgroup.mem_normalizer_iff.mp
        (D.weylElement_mem_normalizer_puncturedPositivePoints i K 1) q).mp hq))
  refine ⟨a, DoubleCoset.mem_doubleCoset.mpr ⟨b₁ * (ni * q * ni⁻¹), mul_mem hb₁ hqn,
    ((n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K)) * b₄,
    mul_mem (D.inv_mul_torusPoints_mul_mem_borelSubgroup K n s) hb₄, ?_⟩⟩
  calc
    (b₁ * ni * b₂) * (b₃ * (n : D.points K) * b₄)
      = b₁ * ni * (b₂ * b₃) * (n : D.points K) * b₄ := by group
    _ = b₁ * ni * ((q * D.rootSubgroupPoints (t.simpleIndex ht i) K a) * D.torusPoints K s) *
          (n : D.points K) * b₄ := by rw [← hus]
    _ = _ := by simp only [ni]; group

/-- When `w⁻¹(αᵢ)` is positive for `w = D.weylProjection K n`, multiplying `B(K) n B(K)` on the
left by the simple double coset `B(K) nᵢ B(K)` lands entirely inside `B(K) (nᵢ n) B(K)`. -/
theorem mul_doubleCoset_borelSubgroup_subset_of_mem_posRoots (i : Fin t.rank)
    (n : D.weylSubgroup K)
    (hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K) (D.borelSubgroup K) *
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) ⊆
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * (n : D.points K))
        (D.borelSubgroup K) (D.borelSubgroup K) := by
  intro x hx
  obtain ⟨a, hxa⟩ := D.exists_mem_doubleCoset_weylElement_mul_rootSubgroupPoints K i n hx
  rwa [DoubleCoset.doubleCoset_eq_of_mem
    (D.rootSubgroup_mul_mem_doubleCoset_of_mem_posRoots K i n hpos a)] at hxa

/-- **The Tits double-coset multiplication law** in `D.points K`: multiplying `B(K) n B(K)` on the
left by `B(K) nᵢ B(K)` lands in `B(K) (nᵢ n) B(K) ∪ B(K) n B(K)`. -/
theorem mul_doubleCoset_borelSubgroup_subset_union (i : Fin t.rank) (n : D.weylSubgroup K) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K) (D.borelSubgroup K) *
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) ⊆
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * (n : D.points K))
        (D.borelSubgroup K) (D.borelSubgroup K) ∪
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  rcases mem_posRoots_or_mem_negRoots (t.rationalRootSystem ht) (t.rationalBase ht)
    ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
      (t.simpleIndex ht i)) with hpos | hneg
  · exact (D.mul_doubleCoset_borelSubgroup_subset_of_mem_posRoots K i n hpos).trans
      Set.subset_union_left
  · intro x hx
    obtain ⟨a, hxa⟩ := D.exists_mem_doubleCoset_weylElement_mul_rootSubgroupPoints K i n hx
    by_cases ha : toAdd a = 0
    · left
      have ha1 : a = 1 := toAdd.injective ha
      simpa only [ha1, map_one, mul_one] using hxa
    · right
      have h := D.weylElement_mul_rootSubgroupPoints_mul_mem_doubleCoset_of_mem_negRoots K i n
        hneg (Units.mk0 (toAdd a) ha)
      simp only [Units.val_mk0, ofAdd_toAdd] at h
      rwa [DoubleCoset.doubleCoset_eq_of_mem h] at hxa

/-! ## The Tits system on the extended elementary subgroup -/

private noncomputable def simpleRepAux (i : Fin t.rank) :
    (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  ⟨⟨D.weylElement (t.simpleIndex ht i) K 1,
      D.weylSubgroup_le_extendedElementarySubgroup K (D.weylElement_mem_weylSubgroup K i)⟩,
    D.weylElement_mem_weylSubgroup K i⟩

@[simp]
private theorem coe_simpleRepAux (i : Fin t.rank) :
    (((D.simpleRepAux K i : (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)) :
        D.extendedElementarySubgroup K) : D.points K) =
      D.weylElement (t.simpleIndex ht i) K 1 :=
  (rfl)

private theorem intersection_extendedElementarySubgroup_eq :
    ((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)).subgroupOf
        ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)) =
      (((D.torusPoints K).range).subgroupOf (D.weylSubgroup K)).comap
        (Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup K)) := by
  ext n
  simp only [Subgroup.mem_subgroupOf, Subgroup.mem_comap, MonoidHom.coe_ofClass,
    Subgroup.subgroupOfEquivOfLe_apply_coe]
  rw [← D.borelSubgroup_inf_weylSubgroup_eq_range_torusPoints K, Subgroup.mem_inf]
  exact ⟨fun hb => ⟨hb, Subgroup.mem_subgroupOf.mp n.2⟩, fun h => h.1⟩

private instance normal_intersection_extendedElementarySubgroup :
    (((D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)).subgroupOf
      ((D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K))).Normal := by
  rw [D.intersection_extendedElementarySubgroup_eq K]
  exact Subgroup.Normal.comap (D.normal_torusPoints_subgroupOf_weylSubgroup K) _

private theorem closure_titsSystemSimple :
    let B := (D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)
    let N := (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)
    Subgroup.closure
        (Set.range fun i : Fin t.rank => (QuotientGroup.mk (D.simpleRepAux K i) :
          N ⧸ B.subgroupOf N)) = ⊤ := by
  intro B N
  let S : Set (N ⧸ B.subgroupOf N) :=
    Set.range fun i : Fin t.rank => QuotientGroup.mk (D.simpleRepAux K i)
  let ιN : N →* D.points K := (D.extendedElementarySubgroup K).subtype.comp N.subtype
  have hle : D.weylSubgroup K ≤
      ((Subgroup.closure S).comap (QuotientGroup.mk' (B.subgroupOf N))).map ιN := by
    rw [D.weylSubgroup_def K, Subgroup.closure_le]
    rintro _ (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · let tN : N := ⟨⟨D.torusPoints K s, D.torusPoints_mem_extendedElementarySubgroup K s⟩,
        D.torusPoints_mem_weylSubgroup K s⟩
      refine ⟨tN, ?_, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap, QuotientGroup.mk'_apply,
        (QuotientGroup.eq_one_iff tN).mpr
          (Subgroup.mem_subgroupOf.mpr (Subgroup.mem_subgroupOf.mpr
            (D.range_torusPoints_le_borelSubgroup K ⟨s, rfl⟩)))]
      exact (Subgroup.closure S).one_mem
    · refine ⟨D.simpleRepAux K i, ?_, D.coe_simpleRepAux K i⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap, QuotientGroup.mk'_apply]
      exact Subgroup.subset_closure ⟨i, rfl⟩
  rw [eq_top_iff]
  rintro q -
  induction q using QuotientGroup.induction_on with
  | H n =>
    obtain ⟨m, hm, hmn⟩ := hle n.2
    exact ((D.extendedElementarySubgroup K).subtype_injective.comp N.subtype_injective hmn) ▸ hm

/-- **The Tits system (BN-pair) of a Chevalley datum over an arbitrary field.** Its ambient group
is the extended elementary subgroup `E(K)` generated by all root subgroups and the actual
character-lattice torus, with `B = B(K)`, `N = N(K)`, and simple reflections given by the pinned
simple Weyl representatives. -/
noncomputable def titsSystem : TitsSystem (D.extendedElementarySubgroup K) where
  subgroupB := (D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)
  subgroupN := (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)
  closure_subgroupB_union_subgroupN := by
    rw [← Subgroup.sup_eq_closure]
    apply Subgroup.map_injective (D.extendedElementarySubgroup K).subtype_injective
    rw [Subgroup.map_sup,
      Subgroup.map_subgroupOf_eq_of_le (D.borelSubgroup_le_extendedElementarySubgroup K),
      Subgroup.map_subgroupOf_eq_of_le (D.weylSubgroup_le_extendedElementarySubgroup K),
      D.borelSubgroup_sup_weylSubgroup K, Subgroup.map_top, Subgroup.range_subtype]
  intersection_normal := D.normal_intersection_extendedElementarySubgroup K
  simple := Set.range fun i : Fin t.rank => QuotientGroup.mk (D.simpleRepAux K i)
  closure_simple := D.closure_titsSystemSimple K
  exists_simpleRep_mul_self_mem := by
    rintro _ ⟨i, rfl⟩
    refine ⟨D.simpleRepAux K i, rfl, ?_⟩
    simp only [Subgroup.mem_subgroupOf, Subgroup.coe_mul, D.coe_simpleRepAux K i]
    rw [D.weylElement_mul_self, D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  mul_doubleCoset_subset := by
    rintro _ ⟨i, rfl⟩
    refine ⟨D.simpleRepAux K i, rfl, fun w z hz => ?_⟩
    have hB := D.borelSubgroup_le_extendedElementarySubgroup K
    obtain ⟨x, hx, y, hy, rfl⟩ := Set.mem_mul.mp hz
    have hprod : ((x * y : D.extendedElementarySubgroup K) : D.points K) ∈
        DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
          (D.borelSubgroup K) (D.borelSubgroup K) *
        DoubleCoset.doubleCoset (((w : _) : D.extendedElementarySubgroup K) : D.points K)
          (D.borelSubgroup K) (D.borelSubgroup K) :=
      ⟨x, (DoubleCoset.mem_doubleCoset_subgroupOf_iff hB hB).mp hx,
       y, (DoubleCoset.mem_doubleCoset_subgroupOf_iff hB hB).mp hy, rfl⟩
    exact (D.mul_doubleCoset_borelSubgroup_subset_union K i
      ⟨(w : D.extendedElementarySubgroup K), w.2⟩ hprod).imp
      (DoubleCoset.mem_doubleCoset_subgroupOf_iff hB hB).mpr
      (DoubleCoset.mem_doubleCoset_subgroupOf_iff hB hB).mpr
  exists_conj_not_mem := by
    rintro _ ⟨i, rfl⟩
    obtain ⟨b, hb⟩ := D.exists_weylElement_conj_notMem_borelSubgroup K i
    refine ⟨D.simpleRepAux K i, rfl,
      ⟨⟨b.1, D.borelSubgroup_le_extendedElementarySubgroup K b.2⟩, b.2⟩, ?_⟩
    simpa only [Subgroup.mem_subgroupOf, Subgroup.coe_mul, Subgroup.coe_inv,
      D.coe_simpleRepAux K i] using hb

/-- The Borel subgroup of `D.titsSystem K` is `D.borelSubgroup K` restricted to `E(K)`. -/
@[simp]
theorem titsSystem_subgroupB :
    (D.titsSystem K).subgroupB =
      (D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  (rfl)

/-- The Weyl subgroup of `D.titsSystem K` is `D.weylSubgroup K` restricted to `E(K)`. -/
@[simp]
theorem titsSystem_subgroupN :
    (D.titsSystem K).subgroupN =
      (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  (rfl)

/-- The canonical isomorphism identifying `(D.titsSystem K).subgroupN` with `D.weylSubgroup K`. -/
noncomputable def titsSystemSubgroupNEquiv :
    (D.titsSystem K).subgroupN ≃* D.weylSubgroup K :=
  (MulEquiv.subgroupCongr (D.titsSystem_subgroupN K)).trans
    (Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup K))

/-- `titsSystemSubgroupNEquiv` preserves the underlying point in `D.points K`. -/
@[simp]
theorem coe_titsSystemSubgroupNEquiv (n : (D.titsSystem K).subgroupN) :
    ((D.titsSystemSubgroupNEquiv K n : D.weylSubgroup K) : D.points K) =
      (((n : (D.titsSystem K).subgroupN) : D.extendedElementarySubgroup K) : D.points K) := by
  simp only [titsSystemSubgroupNEquiv, MulEquiv.trans_apply,
    Subgroup.subgroupOfEquivOfLe_apply_coe, MulEquiv.subgroupCongr_apply]

/-- The inverse of `titsSystemSubgroupNEquiv` lifts `n : D.weylSubgroup K` into
`(D.titsSystem K).subgroupN` without changing its underlying point. -/
@[simp]
theorem coe_titsSystemSubgroupNEquiv_symm (n : D.weylSubgroup K) :
    ((((D.titsSystemSubgroupNEquiv K).symm n : (D.titsSystem K).subgroupN) :
        D.extendedElementarySubgroup K) : D.points K) = (n : D.points K) := by
  simpa only [MulEquiv.apply_symm_apply] using
    (D.coe_titsSystemSubgroupNEquiv K ((D.titsSystemSubgroupNEquiv K).symm n)).symm

/-- The pinned simple Weyl representative at Bourbaki node `i`, regarded in
`(D.titsSystem K).subgroupN`. -/
noncomputable def titsSystemSimpleRep (i : Fin t.rank) : (D.titsSystem K).subgroupN :=
  D.simpleRepAux K i

/-- Coercing `titsSystemSimpleRep` to `D.points K` recovers the pinned simple Weyl
representative. -/
@[simp]
theorem coe_titsSystemSimpleRep (i : Fin t.rank) :
    (((D.titsSystemSimpleRep K i : (D.titsSystem K).subgroupN) :
        D.extendedElementarySubgroup K) : D.points K) =
      D.weylElement (t.simpleIndex ht i) K 1 :=
  (rfl)

/-- `titsSystemSubgroupNEquiv` sends `D.titsSystemSimpleRep K i` to the `i`-th pinned Weyl
representative in `D.weylSubgroup K`. -/
@[simp]
theorem titsSystemSubgroupNEquiv_titsSystemSimpleRep (i : Fin t.rank) :
    D.titsSystemSubgroupNEquiv K (D.titsSystemSimpleRep K i) =
      ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩ :=
  Subtype.ext (by rw [D.coe_titsSystemSubgroupNEquiv K, D.coe_titsSystemSimpleRep K i])

/-- The `i`-th simple reflection in `(D.titsSystem K).WeylGroup`. -/
noncomputable def titsSystemSimple (i : Fin t.rank) : (D.titsSystem K).WeylGroup :=
  QuotientGroup.mk (D.titsSystemSimpleRep K i)

/-- Unfolds `titsSystemSimple` as the quotient class of `titsSystemSimpleRep`. -/
theorem titsSystemSimple_def (i : Fin t.rank) :
    D.titsSystemSimple K i = QuotientGroup.mk (D.titsSystemSimpleRep K i) :=
  (rfl)

/-- The simple reflections of `D.titsSystem K` are the classes of the pinned simple Weyl
representatives. -/
theorem titsSystem_simple :
    (D.titsSystem K).simple = Set.range (D.titsSystemSimple K) :=
  (rfl)

/-- Every numbered simple reflection belongs to `(D.titsSystem K).simple`. -/
@[simp]
theorem titsSystemSimple_mem_simple (i : Fin t.rank) :
    D.titsSystemSimple K i ∈ (D.titsSystem K).simple := by
  rw [D.titsSystem_simple K]
  exact ⟨i, rfl⟩

end TauCeti.DynkinType.ChevalleyDatum
