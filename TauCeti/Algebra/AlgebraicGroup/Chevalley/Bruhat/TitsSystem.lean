-- Match the integral algebra scalar action used by the Kostant and algebraic-closure formulas.
attribute [local instance high] Ring.toIntAlgebra
attribute [local instance high] Algebra.toModule

/-! ## Intersection of the Borel and Weyl subgroups -/

/-- An element of the Weyl subgroup that lies in the Borel-type subgroup has trivial Weyl
projection, over every field. -/
theorem weylProjection_eq_one_of_mem_borelSubgroup (g : D.weylSubgroup K)
    (hg : (g : D.points K) ∈ D.borelSubgroup K) :
    D.weylProjection K g = 1 := by
  let _ := t.isReduced_simplyConnectedRootDatum ht
  refine eq_one_of_mapsTo_posRoots (P := t.simplyConnectedRootDatum ht)
    (b := t.simplyConnectedBase ht) fun γ hγ => ?_
  rw [← t.posRoots_rationalRootSystem ht] at hγ ⊢
  by_contra hnotpos
  have hneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ ∈
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht) :=
    (not_mem_posRoots_iff_mem_negRoots _ _ _).mp hnotpos
  have hmem_range : D.rootSubgroupPoints
      ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ) K (ofAdd 1) ∈
      (D.rootSubgroupPoints γ K).range.map (MulAut.conj (g : D.points K)).toMonoidHom := by
    rw [D.map_range_rootSubgroupPoints_conj K g γ]
    exact ⟨ofAdd 1, rfl⟩
  obtain ⟨_, ⟨u, rfl⟩, hconj⟩ := hmem_range
  have hmemB : D.rootSubgroupPoints
      ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ) K (ofAdd 1) ∈
      D.borelSubgroup K := by
    rw [← hconj, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    exact (D.borelSubgroup K).mul_mem
      ((D.borelSubgroup K).mul_mem hg
        (D.positivePoints_le_borelSubgroup K (D.rootSubgroupPoints_mem_positivePoints K hγ u)))
      ((D.borelSubgroup K).inv_mem hg)
  exact D.rootSubgroupPoints_ofAdd_one_ne_one K _
    ((D.rootSubgroupPoints_mem_borelSubgroup_iff_of_mem_negRoots K hneg (ofAdd 1)).mp hmemB)

/-- Extending a kernel element of `weylProjection` to the algebraic closure yields an element
centralizing the actual torus there. -/
private theorem map_algebraicClosure_mem_centralizer_range_torusPoints
    (g : D.weylSubgroup K) (hw : D.weylProjection K g = 1) :
    (D.pointsPresentation K).map (D.pointsPresentation (AlgebraicClosure K))
        (algebraMap K (AlgebraicClosure K)) (g : D.points K) ∈
      Subgroup.centralizer (Set.range (D.torusPoints (AlgebraicClosure K))) := by
  let _ : RootableBy (AlgebraicClosure K)ˣ ℕ :=
    TauCeti.IsAlgClosed.unitsRootableByNat (AlgebraicClosure K)
  rw [Subgroup.mem_centralizer_iff]
  rintro _ ⟨r', rfl⟩
  obtain ⟨r, rfl⟩ := D.fullWeightTorusRestriction_surjective (AlgebraicClosure K) r'
  have hconj := (D.weylProjection_eq_iff K g 1).mp hw r
  rw [map_one, MulAut.one_apply, mul_inv_eq_iff_eq_mul] at hconj
  apply Subtype.ext
  have htorus :
      (D.torusPoints (AlgebraicClosure K)
          (D.fullWeightTorusRestriction (AlgebraicClosure K) r) :
        Matrix.GeneralLinearGroup (Fin D.dim) (AlgebraicClosure K)) =
      diagGL (fun j => torusCharacter r (D.weight j)) := by
    rw [D.coe_torusPoints, ← D.kostantTorusMatrix_weight (AlgebraicClosure K) r,
      kostantTorusMatrix_apply]
  rw [Subgroup.coe_mul, Subgroup.coe_mul, GeneralLinear.IntegralPointsPresentation.coe_map,
    htorus]
  exact hconj.symm

/-- **The Borel and Weyl subgroups meet in the actual torus**, over every field (including finite
fields and fields of small characteristic). -/
@[simp]
theorem borelSubgroup_inf_weylSubgroup :
    D.borelSubgroup K ⊓ D.weylSubgroup K = (D.torusPoints K).range := by
  apply le_antisymm
  · rintro g ⟨hgB, hgN⟩
    have hw : D.weylProjection K ⟨g, hgN⟩ = 1 :=
      D.weylProjection_eq_one_of_mem_borelSubgroup K ⟨g, hgN⟩ hgB
    obtain ⟨u, hu, s, hgus⟩ := (D.mem_borelSubgroup_iff K).mp hgB
    let φ := (D.pointsPresentation K).map (D.pointsPresentation (AlgebraicClosure K))
      (algebraMap K (AlgebraicClosure K))
    have hφ_inj : Function.Injective φ :=
      (D.pointsPresentation K).map_injective (D.pointsPresentation (AlgebraicClosure K))
        (algebraMap K (AlgebraicClosure K)).injective
    have hφg_cent :
        φ g ∈ Subgroup.centralizer (Set.range (D.torusPoints (AlgebraicClosure K))) :=
      D.map_algebraicClosure_mem_centralizer_range_torusPoints K ⟨g, hgN⟩ hw
    have hφs_cent :
        φ (D.torusPoints K s) ∈
          Subgroup.centralizer (Set.range (D.torusPoints (AlgebraicClosure K))) := by
      rw [D.map_torusPoints, ← MonoidHom.coe_range]
      exact Subgroup.le_centralizer (D.torusPoints (AlgebraicClosure K)).range ⟨_, rfl⟩
    have hφu_cent :
        φ u ∈ Subgroup.centralizer (Set.range (D.torusPoints (AlgebraicClosure K))) := by
      have hu_eq : φ u = φ g * (φ (D.torusPoints K s))⁻¹ := by
        rw [← hgus, map_mul, mul_inv_cancel_right]
      rw [hu_eq]
      exact mul_mem hφg_cent (inv_mem hφs_cent)
    have hφu_pos : φ u ∈ D.positivePoints (AlgebraicClosure K) :=
      D.map_positivePoints_le (algebraMap K (AlgebraicClosure K)) ⟨u, hu, rfl⟩
    have hφu_one : φ u = 1 :=
      Subgroup.mem_bot.mp <|
        (D.positivePoints_inf_centralizer_range_torusPoints (AlgebraicClosure K)) ▸
          ⟨hφu_pos, hφu_cent⟩
    have hu_one : u = 1 := hφ_inj (hφu_one.trans (map_one φ).symm)
    rw [← hgus, hu_one, one_mul]
    exact ⟨s, rfl⟩
  · exact le_inf (D.range_torusPoints_le_borelSubgroup K) (by
      rintro _ ⟨s, rfl⟩
      exact D.torusPoints_mem_weylSubgroup K s)

/-! ## The Tits system on the extended elementary subgroup -/

/-- The Borel subgroup regarded inside the extended elementary subgroup. -/
private abbrev extB : Subgroup (D.extendedElementarySubgroup K) :=
  (D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K)

/-- The Weyl subgroup regarded inside the extended elementary subgroup. -/
private abbrev extN : Subgroup (D.extendedElementarySubgroup K) :=
  (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K)

/-- Membership in a double coset of `extB` inside `D.extendedElementarySubgroup K` is equivalent to
membership in the corresponding double coset of `D.borelSubgroup K` in `D.points K`. -/
private theorem mem_doubleCoset_extB_iff (g n : D.extendedElementarySubgroup K) :
    g ∈ DoubleCoset.doubleCoset n (D.extB K) (D.extB K) ↔
      (g : D.points K) ∈
        DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  constructor
  · intro hg
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    exact DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · intro hg
    obtain ⟨b₁, hb₁, b₂, hb₂, heq⟩ := DoubleCoset.mem_doubleCoset.mp hg
    exact DoubleCoset.mem_doubleCoset.mpr
      ⟨⟨b₁, D.borelSubgroup_le_extendedElementarySubgroup K hb₁⟩, hb₁,
        ⟨b₂, D.borelSubgroup_le_extendedElementarySubgroup K hb₂⟩, hb₂, Subtype.ext heq⟩

/-- Inside `extN`, the intersection `extB ∩ extN` is the actual torus. -/
private theorem extB_subgroupOf_extN_eq_torus :
    (D.extB K).subgroupOf (D.extN K) =
      (((D.torusPoints K).range).subgroupOf (D.weylSubgroup K)).comap
        (Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup K)).toMonoidHom
      := by
  ext ⟨⟨g, _⟩, hgN⟩
  simp only [Subgroup.mem_subgroupOf, Subgroup.mem_comap, MulEquiv.coe_toMonoidHom,
    Subgroup.subgroupOfEquivOfLe_apply_coe, ← D.borelSubgroup_inf_weylSubgroup K,
    Subgroup.mem_inf]
  exact ⟨fun h => ⟨h, hgN⟩, fun h => h.1⟩

private instance normal_extB_subgroupOf_extN :
    ((D.extB K).subgroupOf (D.extN K)).Normal := by
  rw [D.extB_subgroupOf_extN_eq_torus K]
  exact Subgroup.Normal.comap inferInstance _

/-- The `i`-th pinned simple Weyl representative as an element of `extN`. -/
private def extSimpleRep (i : Fin t.rank) : D.extN K :=
  ⟨⟨D.weylElement (t.simpleIndex ht i) K 1,
      D.weylSubgroup_le_extendedElementarySubgroup K (D.weylElement_mem_weylSubgroup K i)⟩,
    D.weylElement_mem_weylSubgroup K i⟩

private theorem closure_range_mk_extSimpleRep :
    Subgroup.closure
        (Set.range fun i : Fin t.rank =>
          (QuotientGroup.mk (D.extSimpleRep K i) : D.extN K ⧸ (D.extB K).subgroupOf (D.extN K))) =
      ⊤ := by
  rw [eq_top_iff]
  rintro q -
  obtain ⟨⟨⟨g, hgE⟩, hgN⟩, rfl⟩ := QuotientGroup.mk_surjective q
  have hmem : g ∈ D.weylSubgroup K := hgN
  rw [D.weylSubgroup_def] at hmem
  induction hmem using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with ⟨s, rfl⟩ | ⟨i, rfl⟩
    · have h1 : (QuotientGroup.mk (⟨⟨D.torusPoints K s, hgE⟩, hgN⟩ : D.extN K) :
          D.extN K ⧸ (D.extB K).subgroupOf (D.extN K)) = 1 :=
        (QuotientGroup.eq_one_iff _).mpr (D.range_torusPoints_le_borelSubgroup K ⟨s, rfl⟩)
      rw [h1]
      exact one_mem _
    · exact Subgroup.subset_closure ⟨i, rfl⟩
  | one => exact one_mem _
  | mul x y hx hy ihx ihy =>
    have hx' : x ∈ D.weylSubgroup K := (D.weylSubgroup_def K).symm ▸ hx
    have hy' : y ∈ D.weylSubgroup K := (D.weylSubgroup_def K).symm ▸ hy
    have hmul : (⟨⟨x * y, hgE⟩, hgN⟩ : D.extN K) =
        ⟨⟨x, D.weylSubgroup_le_extendedElementarySubgroup K hx'⟩, hx'⟩ *
          ⟨⟨y, D.weylSubgroup_le_extendedElementarySubgroup K hy'⟩, hy'⟩ := rfl
    rw [hmul, QuotientGroup.mk_mul]
    exact mul_mem (ihx _ _) (ihy _ _)
  | inv x hx ihx =>
    have hx' : x ∈ D.weylSubgroup K := (D.weylSubgroup_def K).symm ▸ hx
    have hinv : (⟨⟨x⁻¹, hgE⟩, hgN⟩ : D.extN K) =
        (⟨⟨x, D.weylSubgroup_le_extendedElementarySubgroup K hx'⟩, hx'⟩ : D.extN K)⁻¹ := rfl
    rw [hinv, QuotientGroup.mk_inv]
    exact inv_mem (ihx _ _)

/-- **The Tits system on `D.extendedElementarySubgroup K`**: `B` is the Borel-type subgroup,
`N` is the Weyl subgroup, and the simple reflections are the classes of the pinned simple Weyl
representatives. Holds for every valid Dynkin type, every Chevalley datum, and every field. -/
def extendedElementaryTitsSystem : TitsSystem (D.extendedElementarySubgroup K) where
  subgroupB := D.extB K
  subgroupN := D.extN K
  closure_subgroupB_union_subgroupN := by
    rw [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq]
    apply Subgroup.map_injective (D.extendedElementarySubgroup K).subtype_injective
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le
        (D.borelSubgroup_le_extendedElementarySubgroup K),
      Subgroup.map_subgroupOf_eq_of_le (D.weylSubgroup_le_extendedElementarySubgroup K),
      D.borelSubgroup_sup_weylSubgroup K, Subgroup.map_top, Subgroup.range_subtype]
  intersection_normal := D.normal_extB_subgroupOf_extN K
  simple := Set.range fun i : Fin t.rank => QuotientGroup.mk (D.extSimpleRep K i)
  closure_simple := D.closure_range_mk_extSimpleRep K
  exists_simpleRep_mul_self_mem s hs := by
    obtain ⟨i, rfl⟩ := hs
    refine ⟨D.extSimpleRep K i, rfl, ?_⟩
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_subgroupOf, Subgroup.coe_mul, Subgroup.coe_mul]
    dsimp only [extSimpleRep]
    rw [D.weylElement_mul_self, D.simpleCorootPoints_eq_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  mul_doubleCoset_subset s hs := by
    obtain ⟨i, rfl⟩ := hs
    refine ⟨D.extSimpleRep K i, rfl, fun w z hz => ?_⟩
    obtain ⟨z₁, hz₁, z₂, hz₂, rfl⟩ := Set.mem_mul.mp hz
    have hmem := Set.mul_mem_mul ((D.mem_doubleCoset_extB_iff K z₁ _).mp hz₁)
      ((D.mem_doubleCoset_extB_iff K z₂ _).mp hz₂)
    rcases D.doubleCoset_weylElement_mul_subset_union K i
        ⟨(w : D.extendedElementarySubgroup K), w.2⟩ hmem with h | h
    · exact Or.inl ((D.mem_doubleCoset_extB_iff K (z₁ * z₂) _).mpr h)
    · exact Or.inr ((D.mem_doubleCoset_extB_iff K (z₁ * z₂) _).mpr h)
  exists_conj_not_mem s hs := by
    obtain ⟨i, rfl⟩ := hs
    obtain ⟨b, hb⟩ := D.exists_weylElement_conj_notMem_borelSubgroup K i
    refine ⟨D.extSimpleRep K i, rfl,
      ⟨⟨b.1, D.borelSubgroup_le_extendedElementarySubgroup K b.2⟩, b.2⟩, hb⟩

/-- The `B` subgroup of `extendedElementaryTitsSystem` is `D.borelSubgroup K` inside
`D.extendedElementarySubgroup K`. -/
@[simp]
theorem extendedElementaryTitsSystem_subgroupB :
    (D.extendedElementaryTitsSystem K).subgroupB =
      (D.borelSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  (rfl)

/-- The `N` subgroup of `extendedElementaryTitsSystem` is `D.weylSubgroup K` inside
`D.extendedElementarySubgroup K`. -/
@[simp]
theorem extendedElementaryTitsSystem_subgroupN :
    (D.extendedElementaryTitsSystem K).subgroupN =
      (D.weylSubgroup K).subgroupOf (D.extendedElementarySubgroup K) :=
  (rfl)

/-- An element of `N` lies in the intersection `B ∩ N` of `extendedElementaryTitsSystem` exactly
when it belongs to the actual character-lattice torus. -/
@[simp]
theorem mem_extendedElementaryTitsSystem_intersection_iff
    (g : (D.extendedElementaryTitsSystem K).subgroupN) :
    g ∈ (D.extendedElementaryTitsSystem K).intersection ↔
      ((g : D.extendedElementarySubgroup K) : D.points K) ∈ (D.torusPoints K).range := by
  rw [TitsSystem.mem_intersection, D.extendedElementaryTitsSystem_subgroupB,
    Subgroup.mem_subgroupOf, ← D.borelSubgroup_inf_weylSubgroup K, Subgroup.mem_inf]
  have hgN : ((g : D.extendedElementarySubgroup K) : D.points K) ∈ D.weylSubgroup K := by
    simpa only [extendedElementaryTitsSystem_subgroupN, Subgroup.mem_subgroupOf] using g.2
  exact ⟨fun h => ⟨h, hgN⟩, fun h => h.1⟩

/-- The `i`-th pinned simple Weyl representative as an element of
`(D.extendedElementaryTitsSystem K).subgroupN`. -/
def extendedElementaryTitsSystemSimpleRep (i : Fin t.rank) :
    (D.extendedElementaryTitsSystem K).subgroupN :=
  D.extSimpleRep K i

/-- The underlying datum point of the `i`-th simple Weyl representative is the pinned simple Weyl
element `D.weylElement (t.simpleIndex ht i) K 1`. -/
@[simp]
theorem coe_extendedElementaryTitsSystemSimpleRep (i : Fin t.rank) :
    ((D.extendedElementaryTitsSystemSimpleRep K i : D.extendedElementarySubgroup K) : D.points K) =
      D.weylElement (t.simpleIndex ht i) K 1 :=
  (rfl)

/-- The simple reflections of `extendedElementaryTitsSystem` are the classes of the pinned simple
Weyl representatives. -/
@[simp]
theorem extendedElementaryTitsSystem_simple :
    (D.extendedElementaryTitsSystem K).simple =
      Set.range fun i : Fin t.rank =>
        (QuotientGroup.mk (D.extendedElementaryTitsSystemSimpleRep K i) :
          (D.extendedElementaryTitsSystem K).WeylGroup) :=
  (rfl)

/-! ## The kernel of the Weyl projection and the Weyl quotient isomorphisms -/

/-- Lifting `doubleCoset_weylElement_mul_subset_of_mem_posRoots` to Bruhat cells of
`extendedElementaryTitsSystem`. -/
private theorem extendedElementaryTitsSystem_bruhatCell_mul_subset_of_mem_posRoots
    (i : Fin t.rank) (n : D.weylSubgroup K)
    (hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
        (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    let T := D.extendedElementaryTitsSystem K
    let n' : T.subgroupN :=
      ⟨⟨(n : D.points K), D.weylSubgroup_le_extendedElementarySubgroup K n.2⟩, n.2⟩
    T.bruhatCell (QuotientGroup.mk (D.extendedElementaryTitsSystemSimpleRep K i)) *
        T.bruhatCell (QuotientGroup.mk n') ⊆
      T.bruhatCell
        (QuotientGroup.mk (D.extendedElementaryTitsSystemSimpleRep K i) * QuotientGroup.mk n') := by
  intro T n'
  simp only [← QuotientGroup.mk_mul, TitsSystem.bruhatCell_mk]
  rintro z ⟨z₁, hz₁, z₂, hz₂, rfl⟩
  have hmem := Set.mul_mem_mul ((D.mem_doubleCoset_extB_iff K z₁ _).mp hz₁)
    ((D.mem_doubleCoset_extB_iff K z₂ _).mp hz₂)
  exact (D.mem_doubleCoset_extB_iff K (z₁ * z₂) _).mpr
    (D.doubleCoset_weylElement_mul_subset_of_mem_posRoots K i n hpos hmem)

/-- **The kernel of `D.weylProjection K` is the actual torus**, over every field `K` (finite or
infinite, of any characteristic). -/
@[simp]
theorem ker_weylProjection :
    (D.weylProjection K).ker = ((D.torusPoints K).range).subgroupOf (D.weylSubgroup K) := by
  let T := D.extendedElementaryTitsSystem K
  ext n
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
  constructor
  · intro hn
    let n' : T.subgroupN :=
      ⟨⟨(n : D.points K), D.weylSubgroup_le_extendedElementarySubgroup K n.2⟩, n.2⟩
    let q : T.WeylGroup := QuotientGroup.mk n'
    -- Show `q = 1`: otherwise a reduced word for `q` starts with a simple reflection decreasing
    -- length, contradicting length-increasing cell multiplication at `D.weylProjection K n = 1`.
    have hq : q = 1 := by
      by_contra hqne
      obtain ⟨l, hl, hlen, hprod⟩ := T.exists_prod_eq_of_wordLength q
      cases l with
      | nil => exact hqne (by simpa using hprod.symm)
      | cons s l' =>
        have hs : s ∈ T.simple := hl s List.mem_cons_self
        have hl' : ∀ x ∈ l', x ∈ T.simple := fun x hx => hl x (List.mem_cons_of_mem s hx)
        have hlt : T.simpleGenerators.wordLength (s * q) < T.simpleGenerators.wordLength q := by
          have hsq : s * q = l'.prod := by
            rw [← hprod, List.prod_cons, T.simple_mul_simple_cancel_left hs]
          rw [hsq, ← hlen, List.length_cons]
          exact Nat.lt_succ_of_le (T.wordLength_prod_le hl')
        obtain ⟨i, rfl⟩ := hs
        have hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
            (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
          rw [hn, inv_one, map_one, Equiv.Perm.one_apply]
          exact support_subset_posRoots _ _ (t.simpleIndex_mem_support i)
        have hcell_eq := Set.Subset.antisymm
          (D.extendedElementaryTitsSystem_bruhatCell_mul_subset_of_mem_posRoots K i n hpos)
          (T.subset_bruhatCell_mul_of_mem_simple ⟨i, rfl⟩ q)
        have hgt := (T.bruhatCell_mul_eq_iff_wordLength_lt ⟨i, rfl⟩ q).mp hcell_eq
        omega
    exact (D.mem_extendedElementaryTitsSystem_intersection_iff K n').mp
      ((QuotientGroup.eq_one_iff n').mp hq)
  · rintro ⟨s, hs⟩
    have hn_eq : n = ⟨D.torusPoints K s, D.torusPoints_mem_weylSubgroup K s⟩ :=
      Subtype.ext hs.symm
    rw [hn_eq, D.weylProjection_torusPoints]

/-- An element of `D.weylSubgroup K` has trivial Weyl projection if and only if it lies in the
actual character-lattice torus, over every field `K`. -/
theorem weylProjection_eq_one_iff_mem_range_torusPoints (g : D.weylSubgroup K) :
    D.weylProjection K g = 1 ↔ (g : D.points K) ∈ (D.torusPoints K).range := by
  simpa only [MonoidHom.mem_ker, Subgroup.mem_subgroupOf] using
    SetLike.ext_iff.mp (D.ker_weylProjection K) g

/-- **The Weyl quotient isomorphism `N(K) / T(K) ≃* W`**: the Weyl subgroup modulo the actual
character-lattice torus is canonically isomorphic to the Weyl group of the pinned root datum, over
every field `K`. -/
def weylQuotientMulEquiv :
    D.weylSubgroup K ⧸ ((D.torusPoints K).range).subgroupOf (D.weylSubgroup K) ≃*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  (QuotientGroup.quotientMulEquivOfEq (D.ker_weylProjection K).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (D.weylProjection K)
      (D.weylProjection_surjective K))

/-- On cosets, `weylQuotientMulEquiv` evaluates `D.weylProjection K`. -/
@[simp]
theorem weylQuotientMulEquiv_mk (g : D.weylSubgroup K) :
    D.weylQuotientMulEquiv K (QuotientGroup.mk g) = D.weylProjection K g := by
  rw [weylQuotientMulEquiv, MulEquiv.trans_apply, QuotientGroup.quotientMulEquivOfEq_mk]
  rfl

/-- `weylQuotientMulEquiv` sends the class of the `i`-th pinned simple Weyl representative to the
`i`-th simple reflection. -/
theorem weylQuotientMulEquiv_weylElement (i : Fin t.rank) :
    D.weylQuotientMulEquiv K
        (QuotientGroup.mk
          ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩) =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  rw [D.weylQuotientMulEquiv_mk, D.weylProjection_weylElement]

/-- The Weyl projection read on `(D.extendedElementaryTitsSystem K).subgroupN`. -/
private def extendedElementaryWeylHom :
    (D.extendedElementaryTitsSystem K).subgroupN →*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  (D.weylProjection K).comp
    (Subgroup.subgroupOfEquivOfLe (D.weylSubgroup_le_extendedElementarySubgroup K)).toMonoidHom

private theorem ker_extendedElementaryWeylHom :
    (D.extendedElementaryWeylHom K).ker = (D.extendedElementaryTitsSystem K).intersection := by
  ext g
  rw [MonoidHom.mem_ker, D.mem_extendedElementaryTitsSystem_intersection_iff]
  exact D.weylProjection_eq_one_iff_mem_range_torusPoints K _

private theorem extendedElementaryWeylHom_surjective :
    Function.Surjective (D.extendedElementaryWeylHom K) :=
  (D.weylProjection_surjective K).comp (MulEquiv.surjective _)

/-- **The Weyl group of `extendedElementaryTitsSystem` is the Weyl group of the pinned root
datum.** -/
def extendedElementaryTitsSystemWeylGroupMulEquiv :
    (D.extendedElementaryTitsSystem K).WeylGroup ≃*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  (QuotientGroup.quotientMulEquivOfEq (D.ker_extendedElementaryWeylHom K).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (D.extendedElementaryWeylHom K)
      (D.extendedElementaryWeylHom_surjective K))

/-- On cosets, `extendedElementaryTitsSystemWeylGroupMulEquiv` evaluates `D.weylProjection K`. -/
@[simp]
theorem extendedElementaryTitsSystemWeylGroupMulEquiv_mk
    (g : (D.extendedElementaryTitsSystem K).subgroupN) :
    D.extendedElementaryTitsSystemWeylGroupMulEquiv K (QuotientGroup.mk g) =
      D.weylProjection K
        ⟨((g : D.extendedElementarySubgroup K) : D.points K), by
          simpa only [extendedElementaryTitsSystem_subgroupN, Subgroup.mem_subgroupOf]
            using g.2⟩ := by
  rw [extendedElementaryTitsSystemWeylGroupMulEquiv, MulEquiv.trans_apply,
    QuotientGroup.quotientMulEquivOfEq_mk]
  rfl

/-- Under `extendedElementaryTitsSystemWeylGroupMulEquiv`, the `i`-th simple Weyl representative
maps to the `i`-th simple reflection. -/
theorem extendedElementaryTitsSystemWeylGroupMulEquiv_simpleRep (i : Fin t.rank) :
    D.extendedElementaryTitsSystemWeylGroupMulEquiv K
        (QuotientGroup.mk (D.extendedElementaryTitsSystemSimpleRep K i)) =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  rw [D.extendedElementaryTitsSystemWeylGroupMulEquiv_mk]
  exact D.weylProjection_weylElement K i

/-- The simple reflections of `extendedElementaryTitsSystem` correspond to the simple reflections
of the pinned root datum. -/
theorem extendedElementaryTitsSystem_simple_eq_preimage :
    (D.extendedElementaryTitsSystem K).simple =
      D.extendedElementaryTitsSystemWeylGroupMulEquiv K ⁻¹'
        Set.range fun i : Fin t.rank =>
          RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  ext w
  simp only [D.extendedElementaryTitsSystem_simple, Set.mem_range, Set.mem_preimage]
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i, (D.extendedElementaryTitsSystemWeylGroupMulEquiv_simpleRep K i).symm⟩
  · rintro ⟨i, hi⟩
    refine ⟨i, (D.extendedElementaryTitsSystemWeylGroupMulEquiv K).injective ?_⟩
    rw [D.extendedElementaryTitsSystemWeylGroupMulEquiv_simpleRep, hi]

/-! ## Bruhat double-coset decomposition -/

/-- A Bruhat cell of `extendedElementaryTitsSystem` indexed by `D.weylProjection K n` consists of
the elements of `D.extendedElementarySubgroup K` belonging to the double coset `B n B` in
`D.points K`. -/
theorem mem_extendedElementaryTitsSystem_bruhatCell_symm_iff
    (g : D.extendedElementarySubgroup K) (n : D.weylSubgroup K) :
    g ∈ (D.extendedElementaryTitsSystem K).bruhatCell
        ((D.extendedElementaryTitsSystemWeylGroupMulEquiv K).symm (D.weylProjection K n)) ↔
      (g : D.points K) ∈
        DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  let n' : (D.extendedElementaryTitsSystem K).subgroupN :=
    ⟨⟨(n : D.points K), D.weylSubgroup_le_extendedElementarySubgroup K n.2⟩, n.2⟩
  have hmk : (D.extendedElementaryTitsSystemWeylGroupMulEquiv K).symm (D.weylProjection K n) =
      QuotientGroup.mk n' :=
    (D.extendedElementaryTitsSystemWeylGroupMulEquiv K).injective (by simp [n'])
  rw [hmk, TitsSystem.bruhatCell_mk, D.extendedElementaryTitsSystem_subgroupB]
  exact D.mem_doubleCoset_extB_iff K g _

/-- Two Weyl lifts determine the same Borel double coset if and only if they have the same Weyl
projection. -/
@[simp]
theorem doubleCoset_borelSubgroup_eq_iff_weylProjection_eq (n₁ n₂ : D.weylSubgroup K) :
    DoubleCoset.doubleCoset (n₁ : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) =
        DoubleCoset.doubleCoset (n₂ : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) ↔
      D.weylProjection K n₁ = D.weylProjection K n₂ := by
  constructor
  · intro heq
    have hmem : (n₁ : D.points K) ∈
        DoubleCoset.doubleCoset (n₂ : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
      rw [← heq]
      exact DoubleCoset.mem_doubleCoset_self _ _ _
    let g : D.extendedElementarySubgroup K :=
      ⟨(n₁ : D.points K), D.weylSubgroup_le_extendedElementarySubgroup K n₁.2⟩
    have hg₁ := (D.mem_extendedElementaryTitsSystem_bruhatCell_symm_iff K g n₁).mpr
      (DoubleCoset.mem_doubleCoset_self _ _ _)
    have hg₂ := (D.mem_extendedElementaryTitsSystem_bruhatCell_symm_iff K g n₂).mpr hmem
    exact (D.extendedElementaryTitsSystemWeylGroupMulEquiv K).symm.injective
      ((D.extendedElementaryTitsSystem K).eq_of_mem_bruhatCell_of_mem hg₁ hg₂)
  · intro heq
    have hdiff : (n₁⁻¹ * n₂ : D.weylSubgroup K) ∈ (D.weylProjection K).ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, heq, inv_mul_cancel]
    rw [D.ker_weylProjection, Subgroup.mem_subgroupOf] at hdiff
    apply DoubleCoset.doubleCoset_eq_of_mem
    refine DoubleCoset.mem_doubleCoset.mpr
      ⟨1, one_mem _, ((n₁⁻¹ * n₂ : D.weylSubgroup K) : D.points K)⁻¹,
        inv_mem (D.range_torusPoints_le_borelSubgroup K hdiff), ?_⟩
    simp

/-- Two Borel double cosets represented in `N` are disjoint if and only if their Weyl projections
differ. -/
@[simp]
theorem disjoint_doubleCoset_borelSubgroup_iff_weylProjection_ne (n₁ n₂ : D.weylSubgroup K) :
    Disjoint
        (DoubleCoset.doubleCoset (n₁ : D.points K) (D.borelSubgroup K) (D.borelSubgroup K))
        (DoubleCoset.doubleCoset (n₂ : D.points K) (D.borelSubgroup K) (D.borelSubgroup K)) ↔
      D.weylProjection K n₁ ≠ D.weylProjection K n₂ := by
  constructor
  · intro hdisj heq
    rw [(D.doubleCoset_borelSubgroup_eq_iff_weylProjection_eq K n₁ n₂).mpr heq] at hdisj
    exact Set.disjoint_left.mp hdisj
      (DoubleCoset.mem_doubleCoset_self _ _ _) (DoubleCoset.mem_doubleCoset_self _ _ _)
  · intro hne
    rw [Set.disjoint_left]
    intro x hx₁ hx₂
    apply hne
    exact (D.doubleCoset_borelSubgroup_eq_iff_weylProjection_eq K n₁ n₂).mp
      ((DoubleCoset.doubleCoset_eq_of_mem hx₁).symm.trans (DoubleCoset.doubleCoset_eq_of_mem hx₂))

/-- **Bruhat double-coset decomposition.** Every element of `D.extendedElementarySubgroup K` lies
in the Borel double coset `B n B` for a unique Weyl-group element `w = D.weylProjection K n`. -/
theorem existsUnique_weylProjection_mem_doubleCoset_borelSubgroup
    {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup,
      ∃ n : D.weylSubgroup K, D.weylProjection K n = w ∧
        g ∈ DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  obtain ⟨q, hq, huniq⟩ :=
    (D.extendedElementaryTitsSystem K).existsUnique_mem_bruhatCell ⟨g, hg⟩
  let w := D.extendedElementaryTitsSystemWeylGroupMulEquiv K q
  obtain ⟨n, hn⟩ := D.weylProjection_surjective K w
  refine ⟨w, ⟨n, hn, ?_⟩, ?_⟩
  · apply (D.mem_extendedElementaryTitsSystem_bruhatCell_symm_iff K ⟨g, hg⟩ n).mp
    simpa only [hn, w, MulEquiv.symm_apply_apply] using hq
  · rintro w' ⟨n', rfl, hn'⟩
    have hq' := (D.mem_extendedElementaryTitsSystem_bruhatCell_symm_iff K ⟨g, hg⟩ n').mpr hn'
    have heq := huniq _ hq'
    simpa only [w, MulEquiv.apply_symm_apply] using
      congrArg (D.extendedElementaryTitsSystemWeylGroupMulEquiv K) heq

/-! ## The Tits system on the elementary subgroup -/

/-- Every element of `D.extendedElementarySubgroup K` is an elementary element times an element of
`B ∩ N`. -/
private theorem exists_elementarySubgroup_mul_mem_inf (g : D.extendedElementarySubgroup K) :
    ∃ x : D.elementarySubgroup K,
      ∃ r ∈ (D.extendedElementaryTitsSystem K).subgroupB ⊓
          (D.extendedElementaryTitsSystem K).subgroupN,
        Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup K) x * r = g := by
  obtain ⟨e, he, s, hges⟩ := (D.mem_extendedElementarySubgroup_iff K g).mp g.2
  refine ⟨⟨e, he⟩, ⟨D.torusPoints K s, D.torusPoints_mem_extendedElementarySubgroup K s⟩,
    ⟨D.range_torusPoints_le_borelSubgroup K ⟨s, rfl⟩, D.torusPoints_mem_weylSubgroup K s⟩,
    Subtype.ext hges⟩

/-- **The Tits system on the elementary Chevalley subgroup `D.elementarySubgroup K`**, obtained by
pulling back `D.extendedElementaryTitsSystem K` along the inclusion into
`D.extendedElementarySubgroup K`. Its subgroups are `B ∩ E` and `N ∩ E`, and its Weyl group is
again the Weyl group of the pinned root datum. -/
def elementaryTitsSystem : TitsSystem (D.elementarySubgroup K) :=
  (D.extendedElementaryTitsSystem K).comap
    (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup K))
    (D.exists_elementarySubgroup_mul_mem_inf K)

/-- The `B` subgroup of `elementaryTitsSystem` is `D.borelSubgroup K` inside
`D.elementarySubgroup K`. -/
@[simp]
theorem elementaryTitsSystem_subgroupB :
    (D.elementaryTitsSystem K).subgroupB =
      (D.borelSubgroup K).subgroupOf (D.elementarySubgroup K) := by
  rw [elementaryTitsSystem, TitsSystem.comap_subgroupB, D.extendedElementaryTitsSystem_subgroupB]
  ext x
  simp only [Subgroup.mem_comap, Subgroup.mem_subgroupOf, Subgroup.coe_inclusion]

/-- The `N` subgroup of `elementaryTitsSystem` is `D.weylSubgroup K` inside
`D.elementarySubgroup K`. -/
@[simp]
theorem elementaryTitsSystem_subgroupN :
    (D.elementaryTitsSystem K).subgroupN =
      (D.weylSubgroup K).subgroupOf (D.elementarySubgroup K) := by
  rw [elementaryTitsSystem, TitsSystem.comap_subgroupN, D.extendedElementaryTitsSystem_subgroupN]
  ext x
  simp only [Subgroup.mem_comap, Subgroup.mem_subgroupOf, Subgroup.coe_inclusion]

/-- An element of `N ∩ E` lies in `B ∩ N ∩ E` exactly when it lies in the actual torus. -/
@[simp]
theorem mem_elementaryTitsSystem_intersection_iff
    (g : (D.elementaryTitsSystem K).subgroupN) :
    g ∈ (D.elementaryTitsSystem K).intersection ↔
      ((g : D.elementarySubgroup K) : D.points K) ∈ (D.torusPoints K).range := by
  rw [TitsSystem.mem_intersection, D.elementaryTitsSystem_subgroupB,
    Subgroup.mem_subgroupOf, ← D.borelSubgroup_inf_weylSubgroup K, Subgroup.mem_inf]
  have hgN : ((g : D.elementarySubgroup K) : D.points K) ∈ D.weylSubgroup K := by
    simpa only [elementaryTitsSystem_subgroupN, Subgroup.mem_subgroupOf] using g.2
  exact ⟨fun h => ⟨h, hgN⟩, fun h => h.1⟩

/-- **The Weyl group of `elementaryTitsSystem` is the Weyl group of the pinned root datum.** -/
def elementaryTitsSystemWeylGroupMulEquiv :
    (D.elementaryTitsSystem K).WeylGroup ≃* (t.simplyConnectedRootDatum ht).weylGroup :=
  ((D.extendedElementaryTitsSystem K).comapWeylGroupMulEquiv
      (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup K))
      (D.exists_elementarySubgroup_mul_mem_inf K)).trans
    (D.extendedElementaryTitsSystemWeylGroupMulEquiv K)

/-- On cosets, `elementaryTitsSystemWeylGroupMulEquiv` evaluates `D.weylProjection K`. -/
@[simp]
theorem elementaryTitsSystemWeylGroupMulEquiv_mk
    (g : (D.elementaryTitsSystem K).subgroupN) :
    D.elementaryTitsSystemWeylGroupMulEquiv K (QuotientGroup.mk g) =
      D.weylProjection K
        ⟨((g : D.elementarySubgroup K) : D.points K), by
          simpa only [elementaryTitsSystem_subgroupN, Subgroup.mem_subgroupOf] using g.2⟩ :=
  (congrArg (D.extendedElementaryTitsSystemWeylGroupMulEquiv K)
    ((D.extendedElementaryTitsSystem K).comapWeylGroupMulEquiv_mk
      (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup K))
      (D.exists_elementarySubgroup_mul_mem_inf K) g)).trans
    (D.extendedElementaryTitsSystemWeylGroupMulEquiv_mk K _)

/-- The simple reflections of `elementaryTitsSystem` correspond to the simple reflections of the
pinned root datum. -/
@[simp]
theorem elementaryTitsSystem_simple :
    (D.elementaryTitsSystem K).simple =
      D.elementaryTitsSystemWeylGroupMulEquiv K ⁻¹'
        Set.range fun i : Fin t.rank =>
          RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  have h := (D.extendedElementaryTitsSystem K).comap_simple
    (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup K))
    (D.exists_elementarySubgroup_mul_mem_inf K)
  rw [D.extendedElementaryTitsSystem_simple_eq_preimage K, ← Set.preimage_comp] at h
  exact h

/-- A Bruhat cell of `elementaryTitsSystem` indexed by `D.weylProjection K n` consists of the
elements of `D.elementarySubgroup K` belonging to the double coset `B n B` in `D.points K`. -/
theorem mem_elementaryTitsSystem_bruhatCell_symm_iff
    (g : D.elementarySubgroup K) (n : D.weylSubgroup K) :
    g ∈ (D.elementaryTitsSystem K).bruhatCell
        ((D.elementaryTitsSystemWeylGroupMulEquiv K).symm (D.weylProjection K n)) ↔
      (g : D.points K) ∈
        DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  have hcell :
      (D.elementaryTitsSystem K).bruhatCell
          ((D.elementaryTitsSystemWeylGroupMulEquiv K).symm (D.weylProjection K n)) =
        Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup K) ⁻¹'
          (D.extendedElementaryTitsSystem K).bruhatCell
            ((D.extendedElementaryTitsSystem K).comapWeylGroupMulEquiv
              (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup K))
              (D.exists_elementarySubgroup_mul_mem_inf K)
              ((D.elementaryTitsSystemWeylGroupMulEquiv K).symm (D.weylProjection K n))) :=
    (D.extendedElementaryTitsSystem K).comap_bruhatCell
      (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup K))
      (D.exists_elementarySubgroup_mul_mem_inf K)
      ((D.elementaryTitsSystemWeylGroupMulEquiv K).symm (D.weylProjection K n))
  have harg : (D.extendedElementaryTitsSystem K).comapWeylGroupMulEquiv
      (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup K))
      (D.exists_elementarySubgroup_mul_mem_inf K)
      ((D.elementaryTitsSystemWeylGroupMulEquiv K).symm (D.weylProjection K n)) =
      (D.extendedElementaryTitsSystemWeylGroupMulEquiv K).symm (D.weylProjection K n) := by
    apply (D.extendedElementaryTitsSystemWeylGroupMulEquiv K).injective
    exact ((D.elementaryTitsSystemWeylGroupMulEquiv K).apply_symm_apply
      (D.weylProjection K n)).trans
      ((D.extendedElementaryTitsSystemWeylGroupMulEquiv K).apply_symm_apply _).symm
  rw [hcell, harg, Set.mem_preimage]
  exact D.mem_extendedElementaryTitsSystem_bruhatCell_symm_iff K
    ⟨(g : D.points K), D.elementarySubgroup_le_extendedElementarySubgroup K g.2⟩ n

end

end TauCeti.DynkinType.ChevalleyDatum
