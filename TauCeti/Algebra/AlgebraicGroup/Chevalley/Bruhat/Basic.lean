module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Borel
import TauCeti.Algebra.AlgebraicGroup.Chevalley.Torus.Weyl
public import Mathlib.GroupTheory.DoubleCoset

/-!
# Simple Weyl cells

For a Chevalley datum of any valid Dynkin type, let `B` be the subgroup generated by all
positive root subgroups and the actual character-lattice torus, and let `nᵢ` be the pinned
simple Weyl representative. Then `nᵢ B ⊆ B nᵢ Xᵢ` and
`B nᵢ B = B nᵢ Xᵢ`. This is the local collection step for simple-reflection Bruhat
multiplication, not a global Bruhat decomposition. Uniqueness of the factors is not proved here.

The statements hold over every commutative ring and use the actual torus, without requiring
surjectivity of restriction from the full weight lattice or generation of all scheme points.
Punctured-positive normalization and factorization are supplied by `Chevalley.Positive.Basic`.
The representatives and torus pinning equation are those of `Chevalley.Root.Subgroup`;
their action on the actual torus is developed in `Chevalley.Torus.Weyl`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §8.3.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type*) [CommRing A]

/-- Left multiplication of a Borel-type point by a simple Weyl representative can be collected
into a Borel-type point, that Weyl representative, and a simple-root element. -/
theorem exists_mem_borelSubgroup_weylElement_mul_eq_mul_weylElement_mul_rootSubgroupPoints
    (i : Fin t.rank)
    {b : D.points A} (hb : b ∈ D.borelSubgroup A) :
    ∃ b' ∈ D.borelSubgroup A, ∃ u : Multiplicative A,
      D.weylElement (t.simpleIndex ht i) A 1 * b =
        b' * D.weylElement (t.simpleIndex ht i) A 1 *
          D.rootSubgroupPoints (t.simpleIndex ht i) A u := by
  let U : Subgroup (D.points A) := ⨆ γ ∈
    posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range
  let n := D.weylElement (t.simpleIndex ht i) A 1
  -- The Weyl representative belongs to the normalizing rank-one subgroup.
  have hn : n ∈ Subgroup.normalizer U :=
    D.closure_simpleRootPair_le_normalizer_positivePoints_diff_singleton A i
      (D.weylElement_mem_closure_rootPair (t.simpleIndex ht i) A 1)
  have hU : U ≤ D.borelSubgroup A := by
    refine iSup₂_le fun γ hγ => ?_
    rintro _ ⟨u, rfl⟩
    exact D.positivePoints_le_borelSubgroup A
      (D.rootSubgroupPoints_mem_positivePoints A hγ.1 u)
  obtain ⟨v, hv, s, rfl⟩ := D.mem_borelSubgroup_iff A |>.mp hb
  obtain ⟨w, hw, u, rfl⟩ :=
    (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints A i v).mp hv
  have hw' : n * w * n⁻¹ ∈ D.borelSubgroup A :=
    hU ((Subgroup.mem_normalizer_iff.mp hn w).mp hw)
  -- Move the torus to the left using its Weyl conjugate, and scale the remaining
  -- root parameter by the inverse torus character.
  refine ⟨(n * w * n⁻¹) *
    D.torusPoints A (D.simpleReflectionTorusParameter i A s),
    (D.borelSubgroup A).mul_mem hw'
      (D.range_torusPoints_le_borelSubgroup A ⟨_, rfl⟩),
    Multiplicative.ofAdd
      ((torusCharacter (s⁻¹) (D.coordinateRoot (t.simpleIndex ht i)) : A) * u.toAdd), ?_⟩
  rw [← D.torusPoints_conj_rootSubgroupPoints (t.simpleIndex ht i) A (s⁻¹) u.toAdd,
    ofAdd_toAdd, map_inv, inv_inv, ← D.weylElement_conj_torusPoints i A s]
  dsimp only [n]
  group

/-- A simple Weyl double coset of the Borel-type subgroup has representatives `b nᵢ xᵢ(u)`.
This asserts existence, not uniqueness, of the factors. -/
theorem mem_doubleCoset_weylElement_borelSubgroup_iff_exists_mul_rootSubgroupPoints
    (i : Fin t.rank)
    (g : D.points A) :
    g ∈ DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) A 1)
        (D.borelSubgroup A) (D.borelSubgroup A) ↔
      ∃ b ∈ D.borelSubgroup A, ∃ u : Multiplicative A,
        g = b * D.weylElement (t.simpleIndex ht i) A 1 *
          D.rootSubgroupPoints (t.simpleIndex ht i) A u := by
  constructor
  · intro hg
    obtain ⟨a, ha, b, hb, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    obtain ⟨c, hc, u, hu⟩ :=
      D.exists_mem_borelSubgroup_weylElement_mul_eq_mul_weylElement_mul_rootSubgroupPoints
        A i hb
    refine ⟨a * c, (D.borelSubgroup A).mul_mem ha hc, u, ?_⟩
    simpa only [mul_assoc] using congrArg (a * ·) hu
  · rintro ⟨b, hb, u, rfl⟩
    exact DoubleCoset.mem_doubleCoset.mpr ⟨b, hb, _,
      D.positivePoints_le_borelSubgroup A
        (D.rootSubgroupPoints_mem_positivePoints A (simpleIndex_mem_posRoots i) u), rfl⟩

end TauCeti.DynkinType.ChevalleyDatum
