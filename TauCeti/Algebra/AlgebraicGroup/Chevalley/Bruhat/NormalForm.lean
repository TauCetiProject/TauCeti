/-!
# Unique Bruhat normal form for Chevalley groups

For any Chevalley datum `D`, any Weyl element `w`, and any commutative ring `A`, we define the
Bruhat unipotent subgroup

```text
U_w(A) = ⟨ X_γ(A) | γ > 0, w⁻¹(γ) < 0 ⟩ = ⨆ γ ∈ inversions(w⁻¹), range(x_γ).
```

Over any field `K` and any lift `n ∈ N(K)` of `w`:

* `ChevalleyDatum.bruhatUnipotentSubgroup_eq_positivePoints_inf_map_conj_negativePoints`:
  `U_w(K) = U⁺(K) ∩ n U⁻(K) n⁻¹`, independently of the choice of lift `n`.
* `ChevalleyDatum.disjoint_bruhatUnipotentSubgroup_map_conj_borelSubgroup`:
  `U_w(K)` is disjoint from `n B(K) n⁻¹`, because `n⁻¹ U_w(K) n ≤ U⁻(K)` and `U⁻(K) ∩ B(K) = 1`.
* `ChevalleyDatum.existsUnique_mul_weyl_mul_eq_of_mem_doubleCoset`: every element of the Bruhat
  cell `B(K) n B(K)` has a unique factorization `g = u * n * b` with `u ∈ U_w(K)` and `b ∈ B(K)`.
* `ChevalleyDatum.existsUnique_bruhatNormalForm` and `ChevalleyDatum.bruhatNormalFormEquiv`:
  given any section `n : W → N(K)` of `D.weylProjection K`, every element of
  `D.extendedElementarySubgroup K` has a unique Bruhat normal form `g = u * n(w) * b` with
  `w ∈ W`, `u ∈ U_w(K)`, and `b ∈ B(K)`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorem 4′.
* R. W. Carter, *Simple Groups of Lie Type*, §8.4.
-/

public section

open Multiplicative

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-- The Bruhat unipotent subgroup `U_w(A)` generated by the positive root subgroups whose roots
are made negative by `w⁻¹`. -/
noncomputable def bruhatUnipotentSubgroup
    (w : (t.simplyConnectedRootDatum ht).weylGroup) (A : Type v) [CommRing A] :
    Subgroup (D.points A) :=
  ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹,
    (D.rootSubgroupPoints γ A).range

/-- Definitional unfolding of `bruhatUnipotentSubgroup`. -/
theorem bruhatUnipotentSubgroup_def
    (w : (t.simplyConnectedRootDatum ht).weylGroup) (A : Type v) [CommRing A] :
    D.bruhatUnipotentSubgroup w A =
      ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹,
        (D.rootSubgroupPoints γ A).range :=
  (rfl)

/-- Every Bruhat unipotent subgroup is contained in the positive subgroup `U⁺(A)`. -/
theorem bruhatUnipotentSubgroup_le_positivePoints
    (w : (t.simplyConnectedRootDatum ht).weylGroup) (A : Type v) [CommRing A] :
    D.bruhatUnipotentSubgroup w A ≤ D.positivePoints A := by
  rw [D.bruhatUnipotentSubgroup_def]
  refine iSup₂_le fun γ hγ => ?_
  rintro _ ⟨u, rfl⟩
  have hpos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [t.posRoots_rationalRootSystem ht]
    exact inversions_subset_posRoots _ _ _ hγ
  exact D.rootSubgroupPoints_mem_positivePoints A hpos u

/-- For the identity Weyl element, the Bruhat unipotent subgroup is trivial. -/
@[simp]
theorem bruhatUnipotentSubgroup_one (A : Type v) [CommRing A] :
    D.bruhatUnipotentSubgroup 1 A = ⊥ := by
  rw [D.bruhatUnipotentSubgroup_def, inv_one, inversions_one]
  simp

/-- The actual character-lattice torus normalizes every Bruhat unipotent subgroup, over every
commutative ring. -/
theorem range_torusPoints_le_normalizer_bruhatUnipotentSubgroup
    (w : (t.simplyConnectedRootDatum ht).weylGroup) (A : Type v) [CommRing A] :
    (D.torusPoints A).range ≤
      Subgroup.normalizer (D.bruhatUnipotentSubgroup w A : Set _) := by
  rintro _ ⟨s, rfl⟩
  rw [Subgroup.mem_normalizer_iff]
  have hconj (r : Fin t.rank → Aˣ) :
      (D.bruhatUnipotentSubgroup w A).map (MulAut.conj (D.torusPoints A r)).toMonoidHom ≤
        D.bruhatUnipotentSubgroup w A := by
    rw [D.bruhatUnipotentSubgroup_def, Subgroup.map_iSup]
    refine iSup_le fun γ => ?_
    rw [Subgroup.map_iSup]
    refine iSup_le fun hγ => ?_
    rintro _ ⟨_, ⟨u, rfl⟩, rfl⟩
    refine le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ A).range) γ hγ ?_
    refine ⟨ofAdd ((torusCharacter r (D.coordinateRoot γ) : A) * toAdd u), ?_⟩
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, ofAdd_toAdd] using
      (D.torusPoints_conj_rootSubgroupPoints γ A r (toAdd u)).symm
  intro g
  constructor
  · intro hg
    exact hconj s ⟨g, hg, rfl⟩
  · intro hg
    have h := hconj s⁻¹ ⟨D.torusPoints A s * g * (D.torusPoints A s)⁻¹, hg, rfl⟩
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, map_inv] at h
    have hge : (D.torusPoints A s)⁻¹ * (D.torusPoints A s * g * (D.torusPoints A s)⁻¹) *
        ((D.torusPoints A s)⁻¹)⁻¹ = g := by group
    rwa [hge] at h

variable (K : Type v) [Field K]

/-- Conjugating `U_w(K)` by the inverse of any lift `n ∈ N(K)` of `w` lands inside `U⁻(K)`. -/
theorem map_bruhatUnipotentSubgroup_conj_inv_le_negativePoints (n : D.weylSubgroup K) :
    (D.bruhatUnipotentSubgroup (D.weylProjection K n) K).map
        (MulAut.conj (n : D.points K)⁻¹).toMonoidHom ≤
      D.negativePoints K := by
  rw [D.bruhatUnipotentSubgroup_def]
  have hmap := D.map_iSup_rootSubgroupPoints_conj K n⁻¹
    (inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
      (D.weylProjection K n)⁻¹)
  rw [Subgroup.coe_inv, (D.weylProjection K).map_inv] at hmap
  rw [hmap]
  refine iSup₂_le fun δ hδ => ?_
  obtain ⟨γ, hγ, rfl⟩ := hδ
  have hneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹ γ ∈
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [← not_mem_posRoots_iff_mem_negRoots, t.posRoots_rationalRootSystem ht,
      not_mem_posRoots_iff_mem_negRoots]
    exact mapsTo_inversions_negRoots _ _ _ hγ
  rintro _ ⟨u, rfl⟩
  exact D.rootSubgroupPoints_mem_negativePoints K hneg u

private theorem map_complement_conj_inv_le_positivePoints (n : D.weylSubgroup K) :
    (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) ∩
        {γ | γ ∉ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K n)⁻¹},
        (D.rootSubgroupPoints γ K).range).map
        (MulAut.conj (n : D.points K)⁻¹).toMonoidHom ≤
      D.positivePoints K := by
  have hmap := D.map_iSup_rootSubgroupPoints_conj K n⁻¹
    (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) ∩
      {γ | γ ∉ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹})
  rw [Subgroup.coe_inv, (D.weylProjection K).map_inv] at hmap
  rw [hmap]
  refine iSup₂_le fun δ hδ => ?_
  obtain ⟨γ, ⟨hγpos, hγnot⟩, rfl⟩ := hδ
  rw [t.posRoots_rationalRootSystem ht] at hγpos
  have hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹ γ ∈
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [t.posRoots_rationalRootSystem ht, mem_posRoots]
    exact ((mem_posRoots_sdiff_inversions _ _ _ γ).mp ⟨hγpos, hγnot⟩).2
  rintro _ ⟨u, rfl⟩
  exact D.rootSubgroupPoints_mem_positivePoints K hpos u

/-- For any lift `n ∈ N(K)` of `w`, `U_w(K) = U⁺(K) ∩ n U⁻(K) n⁻¹`. -/
theorem bruhatUnipotentSubgroup_eq_positivePoints_inf_map_conj_negativePoints
    (n : D.weylSubgroup K) :
    D.bruhatUnipotentSubgroup (D.weylProjection K n) K =
      D.positivePoints K ⊓
        (D.negativePoints K).map (MulAut.conj (n : D.points K)).toMonoidHom := by
  apply le_antisymm
  · refine le_inf (D.bruhatUnipotentSubgroup_le_positivePoints _ K) ?_
    intro g hg
    have hinv : (n : D.points K)⁻¹ * g * (n : D.points K) ∈ D.negativePoints K :=
      D.map_bruhatUnipotentSubgroup_conj_inv_le_negativePoints K n
        ⟨g, hg, by simp⟩
    refine ⟨(n : D.points K)⁻¹ * g * (n : D.points K), hinv, ?_⟩
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    group
  · rintro g ⟨hgpos, hgneg⟩
    obtain ⟨u₁, hu₁, u₂, hu₂, rfl⟩ := D.exists_mul_eq_of_mem_positivePoints K
      (· ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹) hgpos
    have hS : posRoots (t.rationalRootSystem ht) (t.rationalBase ht) ∩
        {γ | γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K n)⁻¹} =
        inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K n)⁻¹ := by
      rw [t.posRoots_rationalRootSystem ht]
      exact Set.inter_eq_right.mpr (inversions_subset_posRoots _ _ _)
    rw [hS, ← D.bruhatUnipotentSubgroup_def] at hu₁
    have hconj_g : (n : D.points K)⁻¹ * (u₁ * u₂) * (n : D.points K) ∈ D.negativePoints K := by
      obtain ⟨y, hy, hy_eq⟩ := hgneg
      have : (n : D.points K)⁻¹ * (u₁ * u₂) * (n : D.points K) = y := by
        rw [← hy_eq, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
        group
      rwa [this]
    have hconj_u₁ : (n : D.points K)⁻¹ * u₁ * (n : D.points K) ∈ D.negativePoints K :=
      D.map_bruhatUnipotentSubgroup_conj_inv_le_negativePoints K n ⟨u₁, hu₁, by simp⟩
    have hconj_u₂_neg : (n : D.points K)⁻¹ * u₂ * (n : D.points K) ∈ D.negativePoints K := by
      have heq : (n : D.points K)⁻¹ * u₂ * (n : D.points K) =
          ((n : D.points K)⁻¹ * u₁ * (n : D.points K))⁻¹ *
            ((n : D.points K)⁻¹ * (u₁ * u₂) * (n : D.points K)) := by group
      rw [heq]
      exact (D.negativePoints K).mul_mem ((D.negativePoints K).inv_mem hconj_u₁) hconj_g
    have hconj_u₂_pos : (n : D.points K)⁻¹ * u₂ * (n : D.points K) ∈ D.borelSubgroup K :=
      D.positivePoints_le_borelSubgroup K
        (D.map_complement_conj_inv_le_positivePoints K n ⟨u₂, hu₂, by simp⟩)
    have hconj_u₂_one : (n : D.points K)⁻¹ * u₂ * (n : D.points K) = 1 := by
      rw [← Subgroup.mem_bot, ← D.negativePoints_inf_borelSubgroup_eq_bot K]
      exact ⟨hconj_u₂_neg, hconj_u₂_pos⟩
    have hu₂_one : u₂ = 1 := by
      have h := congrArg (fun x => (n : D.points K) * x * (n : D.points K)⁻¹) hconj_u₂_one
      simpa [mul_assoc] using h
    simpa [hu₂_one] using hu₁

/-- For any lift `n ∈ N(K)` of `w`, `U_w(K)` is disjoint from `n B(K) n⁻¹`. -/
theorem disjoint_bruhatUnipotentSubgroup_map_conj_borelSubgroup (n : D.weylSubgroup K) :
    Disjoint (D.bruhatUnipotentSubgroup (D.weylProjection K n) K)
      ((D.borelSubgroup K).map (MulAut.conj (n : D.points K)).toMonoidHom) := by
  apply Subgroup.disjoint_def.mpr
  intro x hxU hxB
  have hxneg : (n : D.points K)⁻¹ * x * (n : D.points K) ∈ D.negativePoints K :=
    D.map_bruhatUnipotentSubgroup_conj_inv_le_negativePoints K n ⟨x, hxU, by simp⟩
  have hxb : (n : D.points K)⁻¹ * x * (n : D.points K) ∈ D.borelSubgroup K := by
    obtain ⟨b, hb, hbx⟩ := hxB
    have : (n : D.points K)⁻¹ * x * (n : D.points K) = b := by
      rw [← hbx, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      group
    rwa [this]
  have h1 : (n : D.points K)⁻¹ * x * (n : D.points K) = 1 := by
    rw [← Subgroup.mem_bot, ← D.negativePoints_inf_borelSubgroup_eq_bot K]
    exact ⟨hxneg, hxb⟩
  have h := congrArg (fun y => (n : D.points K) * y * (n : D.points K)⁻¹) h1
  simpa [mul_assoc] using h

/-- On each Bruhat cell `B n B`, the multiplication map `U_w(K) × B(K) → D.points K`,
`(u, b) ↦ u * n * b`, is injective. -/
theorem bruhatUnipotentSubgroup_mul_weyl_mul_borelSubgroup_injective (n : D.weylSubgroup K) :
    Function.Injective (fun p : D.bruhatUnipotentSubgroup (D.weylProjection K n) K ×
        D.borelSubgroup K =>
      (p.1 : D.points K) * (n : D.points K) * p.2) :=
  Subgroup.mul_mul_injective_of_disjoint _ _
    (D.disjoint_bruhatUnipotentSubgroup_map_conj_borelSubgroup K n)

/-- Every element of a Bruhat cell `B(K) n B(K)` has a unique factorization `u * n * b` with
`u ∈ U_w(K)` and `b ∈ B(K)`. -/
theorem existsUnique_mul_weyl_mul_eq_of_mem_doubleCoset (n : D.weylSubgroup K) {g : D.points K}
    (hg : g ∈ DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K)) :
    ∃! p : D.bruhatUnipotentSubgroup (D.weylProjection K n) K × D.borelSubgroup K,
      (p.1 : D.points K) * (n : D.points K) * p.2 = g := by
  apply (D.bruhatUnipotentSubgroup_mul_weyl_mul_borelSubgroup_injective K n
    ).existsUnique_iff_exists.mpr
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
  obtain ⟨u, hu, s, hb₁eq⟩ := (D.mem_borelSubgroup_iff K).mp hb₁
  obtain ⟨u₁, hu₁, u₂, hu₂, hu_eq⟩ := D.exists_mul_eq_of_mem_positivePoints K
    (· ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
      (D.weylProjection K n)⁻¹) hu
  have hS : posRoots (t.rationalRootSystem ht) (t.rationalBase ht) ∩
      {γ | γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹} =
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹ := by
    rw [t.posRoots_rationalRootSystem ht]
    exact Set.inter_eq_right.mpr (inversions_subset_posRoots _ _ _)
  rw [hS, ← D.bruhatUnipotentSubgroup_def] at hu₁
  have hconj_u₂ : (n : D.points K)⁻¹ * u₂ * (n : D.points K) ∈ D.borelSubgroup K :=
    D.positivePoints_le_borelSubgroup K
      (D.map_complement_conj_inv_le_positivePoints K n ⟨u₂, hu₂, by simp⟩)
  have hconj_t : (n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K) ∈
      D.borelSubgroup K := by
    apply D.range_torusPoints_le_borelSubgroup K
    have h := (Subgroup.mem_normalizer_iff.mp
      (D.weylSubgroup_le_normalizer_range_torusPoints K ((D.weylSubgroup K).inv_mem n.2))
      (D.torusPoints K s)).mp ⟨s, rfl⟩
    simpa only [inv_inv] using h
  refine ⟨(⟨u₁, hu₁⟩, ⟨((n : D.points K)⁻¹ * u₂ * (n : D.points K)) *
      ((n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K)) * b₂,
    (D.borelSubgroup K).mul_mem ((D.borelSubgroup K).mul_mem hconj_u₂ hconj_t) hb₂⟩), ?_⟩
  dsimp only
  rw [← hb₁eq, ← hu_eq]
  group

/-- Version of `existsUnique_mul_weyl_mul_eq_of_mem_doubleCoset` indexed by an explicit Weyl
element `w` equal to `D.weylProjection K n`. -/
theorem existsUnique_mul_weyl_mul_eq_of_weylProjection_eq
    (n : D.weylSubgroup K) {w : (t.simplyConnectedRootDatum ht).weylGroup}
    (hw : D.weylProjection K n = w) {g : D.points K}
    (hg : g ∈ DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K)) :
    ∃! p : D.bruhatUnipotentSubgroup w K × D.borelSubgroup K,
      (p.1 : D.points K) * (n : D.points K) * p.2 = g := by
  subst hw
  exact D.existsUnique_mul_weyl_mul_eq_of_mem_doubleCoset K n hg

/-- **Unique Bruhat normal form (Steinberg Theorem 4′).** Given any section `n : W → N(K)` of
the Weyl projection, every element of `D.extendedElementarySubgroup K` is uniquely expressible as
`u * n(w) * b` with `w ∈ W`, `u ∈ U_w(K)`, and `b ∈ B(K)`. -/
theorem existsUnique_bruhatNormalForm
    (n : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hn : ∀ w, D.weylProjection K (n w) = w)
    {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! p : Σ w : (t.simplyConnectedRootDatum ht).weylGroup,
        D.bruhatUnipotentSubgroup w K × D.borelSubgroup K,
      (p.2.1 : D.points K) * (n p.1 : D.points K) * p.2.2 = g := by
  obtain ⟨w, hw, hw_uniq⟩ := D.existsUnique_weyl_mem_doubleCoset K n hn hg
  obtain ⟨p, hp, hp_uniq⟩ :=
    D.existsUnique_mul_weyl_mul_eq_of_weylProjection_eq K (n w) (hn w) hw
  refine ⟨⟨w, p⟩, hp, ?_⟩
  rintro ⟨w', u', b'⟩ hp'
  have hw'_mem : g ∈ DoubleCoset.doubleCoset (n w' : D.points K)
      (D.borelSubgroup K) (D.borelSubgroup K) :=
    DoubleCoset.mem_doubleCoset.mpr
      ⟨u'.1, D.positivePoints_le_borelSubgroup K
        (D.bruhatUnipotentSubgroup_le_positivePoints w' K u'.2), b'.1, b'.2, hp'.symm⟩
  have hww' : w' = w := hw_uniq w' hw'_mem
  subst hww'
  exact congrArg (Sigma.mk w') (hp_uniq (u', b') hp')

/-- The Bruhat normal form as a bijection between `Σ w : W, U_w(K) × B(K)` and
`D.extendedElementarySubgroup K`, for any chosen section `n : W → N(K)` of the Weyl projection. -/
noncomputable def bruhatNormalFormEquiv
    (n : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hn : ∀ w, D.weylProjection K (n w) = w) :
    (Σ w : (t.simplyConnectedRootDatum ht).weylGroup,
      D.bruhatUnipotentSubgroup w K × D.borelSubgroup K) ≃
      D.extendedElementarySubgroup K :=
  Equiv.ofBijective
    (fun p => ⟨(p.2.1 : D.points K) * (n p.1 : D.points K) * p.2.2,
      (D.extendedElementarySubgroup K).mul_mem
        ((D.extendedElementarySubgroup K).mul_mem
          (D.borelSubgroup_le_extendedElementarySubgroup K
            (D.positivePoints_le_borelSubgroup K
              (D.bruhatUnipotentSubgroup_le_positivePoints p.1 K p.2.1.2)))
          (D.weylSubgroup_le_extendedElementarySubgroup K (n p.1).2))
        (D.borelSubgroup_le_extendedElementarySubgroup K p.2.2.2)⟩)
    ⟨by
      intro p₁ p₂ h
      have hg : ((p₂.2.1 : D.points K) * (n p₂.1 : D.points K) * p₂.2.2) ∈
          D.extendedElementarySubgroup K :=
        (D.extendedElementarySubgroup K).mul_mem
          ((D.extendedElementarySubgroup K).mul_mem
            (D.borelSubgroup_le_extendedElementarySubgroup K
              (D.positivePoints_le_borelSubgroup K
                (D.bruhatUnipotentSubgroup_le_positivePoints p₂.1 K p₂.2.1.2)))
            (D.weylSubgroup_le_extendedElementarySubgroup K (n p₂.1).2))
          (D.borelSubgroup_le_extendedElementarySubgroup K p₂.2.2.2)
      obtain ⟨_, _, huniq⟩ := D.existsUnique_bruhatNormalForm K n hn hg
      exact (huniq p₁ (congrArg Subtype.val h)).trans (huniq p₂ rfl).symm,
    by
      intro ⟨g, hg⟩
      obtain ⟨p, hp, _⟩ := D.existsUnique_bruhatNormalForm K n hn hg
      exact ⟨p, Subtype.ext hp⟩⟩

/-- The Bruhat normal form bijection multiplies `(w, (u, b))` to `u * n(w) * b`. -/
@[simp]
theorem coe_bruhatNormalFormEquiv
    (n : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hn : ∀ w, D.weylProjection K (n w) = w)
    (p : Σ w : (t.simplyConnectedRootDatum ht).weylGroup,
      D.bruhatUnipotentSubgroup w K × D.borelSubgroup K) :
    (D.bruhatNormalFormEquiv K n hn p : D.points K) =
      (p.2.1 : D.points K) * (n p.1 : D.points K) * p.2.2 :=
  (rfl)

end TauCeti.DynkinType.ChevalleyDatum
