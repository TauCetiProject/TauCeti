/-!
# Bruhat cells, inversion root subgroups, and Steinberg's Bruhat normal form

Let `D` be a Chevalley datum of valid Dynkin type `t` and `K` any field. Having constructed the
Tits systems `D.titsSystem K` on `D.extendedElementarySubgroup K` and `D.elementaryTitsSystem K` on
`D.elementarySubgroup K`, this file refines the disjoint Bruhat cell decomposition into Steinberg's
unique normal form:

1. **Inversion root subgroups.** For every `n : D.weylSubgroup K` with Weyl projection `w`, the
   intersection `U(K) ∩ n U⁻(K) n⁻¹` equals the subgroup generated by the root subgroups indexed
   by `inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹`, and its
   counterpart `U(K) ∩ n U(K) n⁻¹` equals the subgroup generated by the remaining positive root
   subgroups.
2. **Cell normal form.** Every element of the Bruhat cell `B(K) n B(K)` writes uniquely as
   `u * n * b` with `u ∈ U(K) ∩ n U⁻(K) n⁻¹` and `b ∈ B(K)`. Existence factors the left positive
   factor across the inversion set of `w⁻¹` (`mem_positivePoints_iff_exists_mul_mem_iSup_diff`) and
   sweeps the non-inverted positive factor and torus factor to the right of `n`; uniqueness uses
   `U⁻(K) ∩ B(K) = 1` (`negativePoints_inf_borelSubgroup_eq_bot`).
3. **Global Bruhat normal form.** For any section `rep : W → D.weylSubgroup K` of
   `D.weylProjection K` (and every `w : W` admits a lift already in `D.elementarySubgroup K`), the
   Bruhat cells `B(K) (rep w) B(K)` are pairwise disjoint, cover `D.extendedElementarySubgroup K`,
   and assemble into the bijection `D.bruhatNormalFormEquiv K rep hrep` between
   `Σ w : W, (U(K) ∩ (rep w) U⁻(K) (rep w)⁻¹) × B(K)` and `D.extendedElementarySubgroup K`. When
   `D.weightLattice = ⊤` (in particular for `t.scChevalleyDatum ht`), this decomposes the
   elementary Chevalley group `E_D(K)` itself (`scBruhatNormalFormEquiv`).

## Main declarations

* `ChevalleyDatum.positivePoints_inf_map_conj_negativePoints_eq_iSup_inversions`:
  `U(K) ∩ n U⁻(K) n⁻¹ = ⨆ γ ∈ inversions ... w⁻¹, X_γ`.
* `ChevalleyDatum.positivePoints_inf_map_conj_positivePoints_eq_iSup_sdiff_inversions`:
  `U(K) ∩ n U(K) n⁻¹ = ⨆ γ ∈ posRoots \ inversions ... w⁻¹, X_γ`.
* `ChevalleyDatum.mem_doubleCoset_borelSubgroup_iff_existsUnique_normalForm`:
  existence and uniqueness of `u * n * b` on a single Bruhat cell `B(K) n B(K)`.
* `ChevalleyDatum.existsUnique_mem_doubleCoset_borelSubgroup`: disjoint Bruhat cell decomposition
  of `D.extendedElementarySubgroup K`.
* `ChevalleyDatum.bruhatNormalFormEquiv`: Steinberg's global Bruhat normal-form bijection on
  `D.extendedElementarySubgroup K`.
* `DynkinType.scBruhatNormalFormEquiv`: Steinberg's Bruhat normal-form bijection on the simply
  connected elementary Chevalley group `(t.scChevalleyDatum ht).elementarySubgroup K`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorem 4 and Theorem 4'.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 8.4.3.
-/

public section

open scoped Pointwise

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-! ## Inversion root subgroups -/

private theorem negRoots_rationalRootSystem_eq :
    negRoots (t.rationalRootSystem ht) (t.rationalBase ht) =
      negRoots (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) := by
  rw [negRoots_eq_compl, negRoots_eq_compl, posRoots_rationalRootSystem]

private theorem iSup_inversions_le_positivePoints_inf_map_conj_negativePoints
    (K : Type v) [Field K] (n : D.weylSubgroup K) :
    (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹,
      (D.rootSubgroupPoints γ K).range) ≤
      D.positivePoints K ⊓
        (D.negativePoints K).map (MulAut.conj (n : D.points K)) := by
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  let w := D.weylProjection K n
  refine iSup₂_le fun γ hγ => le_inf ?_ ?_
  · have hγpos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [posRoots_rationalRootSystem]
      exact inversions_subset_posRoots P b w⁻¹ hγ
    rintro _ ⟨u, rfl⟩
    exact D.rootSubgroupPoints_mem_positivePoints K hγpos u
  · rw [D.negativePoints_eq_iSup, negRoots_rationalRootSystem_eq, ← MulEquiv.toMonoidHom_eq_coe,
      D.map_iSup_rootSubgroupPoints_conj K n]
    have hmem : γ ∈ P.weylGroupToPerm w '' negRoots P b :=
      ⟨P.weylGroupToPerm w⁻¹ γ, mapsTo_inversions_negRoots P b w⁻¹ hγ, by simp⟩
    exact le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ K).range) γ hmem

/-- For every `n : D.weylSubgroup K` with Weyl projection `w`, the intersection
`U(K) ∩ n U⁻(K) n⁻¹` is the join of the root subgroups indexed by the inversions of `w⁻¹`. -/
theorem positivePoints_inf_map_conj_negativePoints_eq_iSup_inversions
    (K : Type v) [Field K] (n : D.weylSubgroup K) :
    D.positivePoints K ⊓ (D.negativePoints K).map (MulAut.conj (n : D.points K)) =
      ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K n)⁻¹,
        (D.rootSubgroupPoints γ K).range := by
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  let w := D.weylProjection K n
  have hright_le := D.iSup_inversions_le_positivePoints_inf_map_conj_negativePoints K n
  refine le_antisymm ?_ hright_le
  rintro u ⟨huU, huNeg⟩
  have hS : inversions P b w⁻¹ ⊆ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [posRoots_rationalRootSystem]
    exact inversions_subset_posRoots P b w⁻¹
  obtain ⟨u₁, hu₁, u₂, hu₂, rfl⟩ :=
    (D.mem_positivePoints_iff_exists_mul_mem_iSup_diff K hS u).mp huU
  have hu₂Neg : u₂ ∈ (D.negativePoints K).map (MulAut.conj (n : D.points K)) := by
    simpa only [inv_mul_cancel_left] using
      Subgroup.mul_mem _ (Subgroup.inv_mem _ (hright_le hu₁).2) huNeg
  let v := MulAut.conj (n⁻¹ : D.weylSubgroup K).val u₂
  have hvNeg : v ∈ D.negativePoints K := by
    obtain ⟨x, hx, hxu₂⟩ := hu₂Neg
    have hvx : v = x := by simp [v, ← hxu₂, MulAut.conj_apply, ← mul_assoc]
    rwa [hvx]
  have hvPos : v ∈ D.positivePoints K := by
    have hmap : v ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
        inversions P b w⁻¹, (D.rootSubgroupPoints γ K).range).map
          (MulAut.conj (n⁻¹ : D.weylSubgroup K).val).toMonoidHom := ⟨u₂, hu₂, rfl⟩
    rw [posRoots_rationalRootSystem, D.map_iSup_rootSubgroupPoints_conj K n⁻¹, map_inv] at hmap
    have hle : (⨆ δ ∈ P.weylGroupToPerm w⁻¹ '' (posRoots P b \ inversions P b w⁻¹),
        (D.rootSubgroupPoints δ K).range) ≤ D.positivePoints K := iSup₂_le fun δ hδ => by
      obtain ⟨γ, hγ, rfl⟩ := hδ
      have hδpos : P.weylGroupToPerm w⁻¹ γ ∈
          posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
        rw [posRoots_rationalRootSystem, mem_posRoots]
        exact ((mem_posRoots_sdiff_inversions P b w⁻¹ γ).mp hγ).2
      rintro _ ⟨a, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints K hδpos a
    exact hle hmap
  have hv1 : v = 1 := by
    have hv : v ∈ D.positivePoints K ⊓ D.negativePoints K := ⟨hvPos, hvNeg⟩
    rwa [D.positivePoints_inf_negativePoints_eq_bot K, Subgroup.mem_bot] at hv
  have hu₂1 : u₂ = 1 := (MulAut.conj (n⁻¹ : D.weylSubgroup K).val).injective
    (hv1.trans (map_one _).symm)
  simpa only [hu₂1, mul_one] using hu₁

private theorem iSup_sdiff_inversions_le_positivePoints_inf_map_conj_positivePoints
    (K : Type v) [Field K] (n : D.weylSubgroup K) :
    (⨆ γ ∈ posRoots (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) \
        inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K n)⁻¹,
      (D.rootSubgroupPoints γ K).range) ≤
      D.positivePoints K ⊓
        (D.positivePoints K).map (MulAut.conj (n : D.points K)) := by
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  let w := D.weylProjection K n
  refine iSup₂_le fun γ hγ => le_inf ?_ ?_
  · have hγpos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [posRoots_rationalRootSystem]
      exact hγ.1
    rintro _ ⟨u, rfl⟩
    exact D.rootSubgroupPoints_mem_positivePoints K hγpos u
  · rw [D.positivePoints_eq_iSup, posRoots_rationalRootSystem, ← MulEquiv.toMonoidHom_eq_coe,
      D.map_iSup_rootSubgroupPoints_conj K n]
    have hmem : γ ∈ P.weylGroupToPerm w '' posRoots P b :=
      ⟨P.weylGroupToPerm w⁻¹ γ,
        (mem_posRoots P b _).mpr ((mem_posRoots_sdiff_inversions P b w⁻¹ γ).mp hγ).2, by simp⟩
    exact le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ K).range) γ hmem

private theorem conj_inv_mem_negativePoints_of_mem_iSup_inversions
    (K : Type v) [Field K] (n : D.weylSubgroup K) {u : D.points K}
    (hu : u ∈ ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹, (D.rootSubgroupPoints γ K).range) :
    MulAut.conj (n⁻¹ : D.weylSubgroup K).val u ∈ D.negativePoints K := by
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  let w := D.weylProjection K n
  have hmap : MulAut.conj (n⁻¹ : D.weylSubgroup K).val u ∈
      (⨆ γ ∈ inversions P b w⁻¹, (D.rootSubgroupPoints γ K).range).map
        (MulAut.conj (n⁻¹ : D.weylSubgroup K).val).toMonoidHom := ⟨u, hu, rfl⟩
  rw [D.map_iSup_rootSubgroupPoints_conj K n⁻¹, map_inv] at hmap
  have hle : (⨆ δ ∈ P.weylGroupToPerm w⁻¹ '' inversions P b w⁻¹,
      (D.rootSubgroupPoints δ K).range) ≤ D.negativePoints K := iSup₂_le fun δ hδ => by
    obtain ⟨γ, hγ, rfl⟩ := hδ
    have hδneg : P.weylGroupToPerm w⁻¹ γ ∈
        negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [negRoots_rationalRootSystem_eq]
      exact mapsTo_inversions_negRoots P b w⁻¹ hγ
    rintro _ ⟨a, rfl⟩
    exact D.rootSubgroupPoints_mem_negativePoints K hδneg a
  exact hle hmap

/-- For every `n : D.weylSubgroup K` with Weyl projection `w`, the intersection
`U(K) ∩ n U(K) n⁻¹` is the join of the positive root subgroups outside the inversions of `w⁻¹`. -/
theorem positivePoints_inf_map_conj_positivePoints_eq_iSup_sdiff_inversions
    (K : Type v) [Field K] (n : D.weylSubgroup K) :
    D.positivePoints K ⊓ (D.positivePoints K).map (MulAut.conj (n : D.points K)) =
      ⨆ γ ∈ posRoots (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) \
          inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
            (D.weylProjection K n)⁻¹,
        (D.rootSubgroupPoints γ K).range := by
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  let w := D.weylProjection K n
  have hright_le := D.iSup_sdiff_inversions_le_positivePoints_inf_map_conj_positivePoints K n
  refine le_antisymm ?_ hright_le
  rintro u ⟨huU, huPos⟩
  have hS : posRoots P b \ inversions P b w⁻¹ ⊆
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [posRoots_rationalRootSystem]
    exact Set.sdiff_subset
  obtain ⟨u₁, hu₁, u₂, hu₂, rfl⟩ :=
    (D.mem_positivePoints_iff_exists_mul_mem_iSup_diff K hS u).mp huU
  have hu₂Pos : u₂ ∈ (D.positivePoints K).map (MulAut.conj (n : D.points K)) := by
    simpa only [inv_mul_cancel_left] using
      Subgroup.mul_mem _ (Subgroup.inv_mem _ (hright_le hu₁).2) huPos
  let v := MulAut.conj (n⁻¹ : D.weylSubgroup K).val u₂
  have hvPos : v ∈ D.positivePoints K := by
    obtain ⟨x, hx, hxu₂⟩ := hu₂Pos
    have hvx : v = x := by simp [v, ← hxu₂, MulAut.conj_apply, ← mul_assoc]
    rwa [hvx]
  have hdiff : posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
      (posRoots P b \ inversions P b w⁻¹) = inversions P b w⁻¹ := by
    rw [posRoots_rationalRootSystem, Set.sdiff_sdiff_right_self]
    exact inf_eq_right.mpr (inversions_subset_posRoots P b w⁻¹)
  rw [hdiff] at hu₂
  have hv1 : v = 1 := by
    have hv : v ∈ D.positivePoints K ⊓ D.negativePoints K :=
      ⟨hvPos, D.conj_inv_mem_negativePoints_of_mem_iSup_inversions K n hu₂⟩
    rwa [D.positivePoints_inf_negativePoints_eq_bot K, Subgroup.mem_bot] at hv
  have hu₂1 : u₂ = 1 := (MulAut.conj (n⁻¹ : D.weylSubgroup K).val).injective
    (hv1.trans (map_one _).symm)
  simpa only [hu₂1, mul_one] using hu₁

/-! ## Normal form on a single Bruhat cell -/

/-- Multiplication `(u, b) ↦ u * n * b` is injective on
`(U(K) ∩ n U⁻(K) n⁻¹) × B(K)` for every `n : D.weylSubgroup K`. -/
theorem bruhatCellNormalForm_injective (K : Type v) [Field K] (n : D.weylSubgroup K) :
    Function.Injective (fun p :
        ↥(D.positivePoints K ⊓
            (D.negativePoints K).map (MulAut.conj (n : D.points K))) ×
          ↥(D.borelSubgroup K) =>
      (p.1 : D.points K) * (n : D.points K) * (p.2 : D.points K)) := by
  rintro ⟨u, b⟩ ⟨u', b'⟩ h
  dsimp only at h
  have hconj : (n : D.points K)⁻¹ * ((u' : D.points K)⁻¹ * (u : D.points K)) * (n : D.points K) =
      (b' : D.points K) * (b : D.points K)⁻¹ := by
    calc
      (n : D.points K)⁻¹ * ((u' : D.points K)⁻¹ * (u : D.points K)) * (n : D.points K) =
          (n : D.points K)⁻¹ * (u' : D.points K)⁻¹ * ((u : D.points K) * (n : D.points K) *
            (b : D.points K)) * (b : D.points K)⁻¹ := by group
      _ = (n : D.points K)⁻¹ * (u' : D.points K)⁻¹ * ((u' : D.points K) * (n : D.points K) *
            (b' : D.points K)) * (b : D.points K)⁻¹ := by rw [h]
      _ = _ := by group
  have hneg : (n : D.points K)⁻¹ * ((u' : D.points K)⁻¹ * (u : D.points K)) * (n : D.points K) ∈
      D.negativePoints K := by
    obtain ⟨x, hx, hxu⟩ := Subgroup.mul_mem _ (Subgroup.inv_mem _ u'.2.2) u.2.2
    have heq : (n : D.points K)⁻¹ * ((u' : D.points K)⁻¹ * (u : D.points K)) * (n : D.points K) =
        x := by
      simp [← hxu, MulAut.conj_apply, ← mul_assoc]
    rwa [heq]
  have hB : (b' : D.points K) * (b : D.points K)⁻¹ ∈ D.borelSubgroup K :=
    Subgroup.mul_mem _ b'.2 (Subgroup.inv_mem _ b.2)
  have hb1 : (b' : D.points K) * (b : D.points K)⁻¹ = 1 := by
    have hmem : (b' : D.points K) * (b : D.points K)⁻¹ ∈
        D.negativePoints K ⊓ D.borelSubgroup K := ⟨hconj ▸ hneg, hB⟩
    rwa [D.negativePoints_inf_borelSubgroup_eq_bot K, Subgroup.mem_bot] at hmem
  have hbeq : b = b' := Subtype.ext (mul_inv_eq_one.mp hb1).symm
  subst hbeq
  have hueq : (u : D.points K) = (u' : D.points K) :=
    mul_right_cancel (mul_right_cancel h)
  exact Prod.ext (Subtype.ext hueq) rfl

/-- **Normal form on a Bruhat cell.** For every `n : D.weylSubgroup K`, an element `g : D.points K`
lies in the double coset `B(K) n B(K)` if and only if it writes uniquely as `u * n * b` with
`u ∈ U(K) ∩ n U⁻(K) n⁻¹` and `b ∈ B(K)`. -/
theorem mem_doubleCoset_borelSubgroup_iff_existsUnique_normalForm (K : Type v) [Field K]
    (n : D.weylSubgroup K) (g : D.points K) :
    g ∈ DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) ↔
      ∃! p : ↥(D.positivePoints K ⊓
          (D.negativePoints K).map (MulAut.conj (n : D.points K))) ×
        ↥(D.borelSubgroup K),
        (p.1 : D.points K) * (n : D.points K) * (p.2 : D.points K) = g := by
  constructor
  · intro hg
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    obtain ⟨u, huU, s, rfl⟩ := (D.mem_borelSubgroup_iff K).mp hb₁
    let P := t.simplyConnectedRootDatum ht
    let b := t.simplyConnectedBase ht
    let w := D.weylProjection K n
    have hS : inversions P b w⁻¹ ⊆ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [posRoots_rationalRootSystem]
      exact inversions_subset_posRoots P b w⁻¹
    obtain ⟨u₁, hu₁, u₂, hu₂, rfl⟩ :=
      (D.mem_positivePoints_iff_exists_mul_mem_iSup_diff K hS u).mp huU
    rw [← D.positivePoints_inf_map_conj_negativePoints_eq_iSup_inversions K n] at hu₁
    rw [posRoots_rationalRootSystem,
      ← D.positivePoints_inf_map_conj_positivePoints_eq_iSup_sdiff_inversions K n] at hu₂
    have hu₂B : (n : D.points K)⁻¹ * u₂ * (n : D.points K) ∈ D.borelSubgroup K := by
      obtain ⟨x, hx, hxu₂⟩ := hu₂.2
      have heq : (n : D.points K)⁻¹ * u₂ * (n : D.points K) = x := by
        simp [← hxu₂, MulAut.conj_apply, ← mul_assoc]
      rw [heq]
      exact D.positivePoints_le_borelSubgroup K hx
    have htB : (n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K) ∈ D.borelSubgroup K := by
      apply D.range_torusPoints_le_borelSubgroup K
      have hnorm :=
        D.weylSubgroup_le_normalizer_range_torusPoints K ((D.weylSubgroup K).inv_mem n.2)
      simpa only [inv_inv] using
        (Subgroup.mem_normalizer_iff.mp hnorm (D.torusPoints K s)).mp ⟨s, rfl⟩
    let bRight : D.borelSubgroup K :=
      ⟨((n : D.points K)⁻¹ * u₂ * (n : D.points K)) *
          ((n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K)) * b₂,
        Subgroup.mul_mem _ (Subgroup.mul_mem _ hu₂B htB) hb₂⟩
    refine ⟨(⟨u₁, hu₁⟩, bRight), ?_, fun p hp =>
      D.bruhatCellNormalForm_injective K n (hp.trans ?_)⟩
    · simp only [bRight]
      group
    · simp only [bRight]
      group
  · rintro ⟨⟨u, b⟩, rfl, -⟩
    exact DoubleCoset.mem_doubleCoset.mpr
      ⟨u.1, D.positivePoints_le_borelSubgroup K u.2.1, b.1, b.2, rfl⟩

/-! ## Global Bruhat decomposition and Steinberg's normal form -/

/-- Every Weyl-group element lifts to a representative in `D.weylSubgroup K` that already belongs
to the elementary Chevalley subgroup `D.elementarySubgroup K`. -/
theorem exists_mem_elementarySubgroup_weylProjection_eq (K : Type v) [Field K]
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    ∃ n : D.weylSubgroup K,
      (n : D.points K) ∈ D.elementarySubgroup K ∧ D.weylProjection K n = w := by
  have hword (l : List (Fin t.rank)) :
      ∃ n : D.weylSubgroup K,
        (n : D.points K) ∈ D.elementarySubgroup K ∧
          D.weylProjection K n = t.geckWeylWordProd ht l := by
    induction l with
    | nil => exact ⟨1, one_mem _, by simp⟩
    | cons i l ih =>
      obtain ⟨n, hnE, hnW⟩ := ih
      refine ⟨⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩ * n,
        Subgroup.mul_mem _
          (D.weylElement_mem_elementarySubgroup (t.simpleIndex ht i) K 1) hnE,
        by simp [hnW]⟩
  obtain ⟨l, rfl⟩ := t.geckWeylWordProd_surjective ht w
  exact hword l

private theorem mem_bruhatCell_titsSystem_iff_mem_doubleCoset (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w)
    (g : D.extendedElementarySubgroup K) (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    g ∈ (D.titsSystem K).bruhatCell ((D.titsSystemWeylGroupEquiv K).symm w) ↔
      (g : D.points K) ∈ DoubleCoset.doubleCoset (rep w : D.points K)
        (D.borelSubgroup K) (D.borelSubgroup K) := by
  let nE : (D.titsSystem K).subgroupN :=
    ⟨⟨(rep w).1, D.weylSubgroup_le_extendedElementarySubgroup K (rep w).2⟩, by
      rw [D.titsSystem_subgroupN]
      exact (rep w).2⟩
  have hmk : (D.titsSystemWeylGroupEquiv K).symm w = QuotientGroup.mk nE := by
    apply (D.titsSystemWeylGroupEquiv K).injective
    rw [MulEquiv.apply_symm_apply, D.titsSystemWeylGroupEquiv_mk]
    exact (hrep w).symm
  rw [hmk, TauCeti.TitsSystem.bruhatCell_mk]
  simp only [titsSystem_subgroupB, DoubleCoset.mem_doubleCoset, SetLike.mem_coe,
    Subgroup.mem_subgroupOf]
  constructor
  · rintro ⟨b₁, hb₁, b₂, hb₂, rfl⟩
    exact ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · rintro ⟨b₁, hb₁, b₂, hb₂, hg⟩
    exact ⟨⟨b₁, D.borelSubgroup_le_extendedElementarySubgroup K hb₁⟩, hb₁,
      ⟨b₂, D.borelSubgroup_le_extendedElementarySubgroup K hb₂⟩, hb₂, Subtype.ext hg⟩

/-- For any section `rep` of `D.weylProjection K`, Bruhat cells `B(K) (rep w) B(K)` indexed by
distinct Weyl-group elements are disjoint. -/
theorem disjoint_doubleCoset_borelSubgroup_of_ne (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w)
    {w v : (t.simplyConnectedRootDatum ht).weylGroup} (hwv : w ≠ v) :
    Disjoint
      (DoubleCoset.doubleCoset (rep w : D.points K) (D.borelSubgroup K) (D.borelSubgroup K))
      (DoubleCoset.doubleCoset (rep v : D.points K) (D.borelSubgroup K) (D.borelSubgroup K)) := by
  rw [Set.disjoint_left]
  intro g hgw hgv
  have hgE : g ∈ D.extendedElementarySubgroup K := by
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hgw
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _ (D.borelSubgroup_le_extendedElementarySubgroup K hb₁)
        (D.weylSubgroup_le_extendedElementarySubgroup K (rep w).2))
      (D.borelSubgroup_le_extendedElementarySubgroup K hb₂)
  have hw' := (D.mem_bruhatCell_titsSystem_iff_mem_doubleCoset K rep hrep ⟨g, hgE⟩ w).mpr hgw
  have hv' := (D.mem_bruhatCell_titsSystem_iff_mem_doubleCoset K rep hrep ⟨g, hgE⟩ v).mpr hgv
  exact hwv ((D.titsSystemWeylGroupEquiv K).symm.injective
    ((D.titsSystem K).eq_of_mem_bruhatCell_of_mem hw' hv'))

/-- **Bruhat cell decomposition:** for any section `rep` of `D.weylProjection K`, every element of
`D.extendedElementarySubgroup K` belongs to `B(K) (rep w) B(K)` for a unique Weyl-group element
`w`. -/
theorem existsUnique_mem_doubleCoset_borelSubgroup (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w)
    {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup,
      g ∈ DoubleCoset.doubleCoset (rep w : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  obtain ⟨q, hq, hquniq⟩ := (D.titsSystem K).existsUnique_mem_bruhatCell ⟨g, hg⟩
  refine ⟨D.titsSystemWeylGroupEquiv K q, ?_, fun v hv => ?_⟩
  · exact (D.mem_bruhatCell_titsSystem_iff_mem_doubleCoset K rep hrep ⟨g, hg⟩ _).mp
      (by simpa only [MulEquiv.symm_apply_apply] using hq)
  · have hv' := (D.mem_bruhatCell_titsSystem_iff_mem_doubleCoset K rep hrep ⟨g, hg⟩ v).mpr hv
    exact (MulEquiv.symm_apply_eq (D.titsSystemWeylGroupEquiv K)).mp (hquniq _ hv')

/-- Parameter triples `(w, u, b)` for Steinberg's Bruhat normal form relative to a Weyl-group
section `rep`, with `u ∈ U(K) ∩ (rep w) U⁻(K) (rep w)⁻¹` and `b ∈ B(K)`. -/
abbrev BruhatNormalFormParams (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K) : Type v :=
  Σ w : (t.simplyConnectedRootDatum ht).weylGroup,
    ↥(D.positivePoints K ⊓ (D.negativePoints K).map (MulAut.conj (rep w : D.points K))) ×
      ↥(D.borelSubgroup K)

/-- **Steinberg's Bruhat normal form (existence and uniqueness).** For any section `rep` of
`D.weylProjection K`, every element `g ∈ D.extendedElementarySubgroup K` writes uniquely as
`u * rep w * b` with `w : W`, `u ∈ U(K) ∩ (rep w) U⁻(K) (rep w)⁻¹`, and `b ∈ B(K)`. -/
theorem existsUnique_bruhatNormalForm (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w)
    {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! p : D.BruhatNormalFormParams K rep,
      (p.2.1 : D.points K) * (rep p.1 : D.points K) * (p.2.2 : D.points K) = g := by
  obtain ⟨w, hgw, hwuniq⟩ := D.existsUnique_mem_doubleCoset_borelSubgroup K rep hrep hg
  obtain ⟨ub, hub, hubuniq⟩ :=
    (D.mem_doubleCoset_borelSubgroup_iff_existsUnique_normalForm K (rep w) g).mp hgw
  refine ⟨⟨w, ub⟩, hub, ?_⟩
  rintro ⟨w', ub'⟩ h'
  have hgw' : g ∈ DoubleCoset.doubleCoset (rep w' : D.points K)
      (D.borelSubgroup K) (D.borelSubgroup K) :=
    DoubleCoset.mem_doubleCoset.mpr
      ⟨ub'.1.1, D.positivePoints_le_borelSubgroup K ub'.1.2.1, ub'.2.1, ub'.2.2, h'.symm⟩
  have hww' : w' = w := hwuniq w' hgw'
  subst hww'
  exact congrArg (Sigma.mk w') (hubuniq ub' h')

/-- **Steinberg's global Bruhat normal-form equivalence** on `D.extendedElementarySubgroup K`. -/
noncomputable def bruhatNormalFormEquiv (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w) :
    D.BruhatNormalFormParams K rep ≃ D.extendedElementarySubgroup K :=
  Equiv.ofBijective
    (fun p => ⟨(p.2.1 : D.points K) * (rep p.1 : D.points K) * (p.2.2 : D.points K),
      Subgroup.mul_mem _
        (Subgroup.mul_mem _
          (D.borelSubgroup_le_extendedElementarySubgroup K
            (D.positivePoints_le_borelSubgroup K p.2.1.2.1))
          (D.weylSubgroup_le_extendedElementarySubgroup K (rep p.1).2))
        (D.borelSubgroup_le_extendedElementarySubgroup K p.2.2.2)⟩)
    ⟨fun p q hpq => by
      have hg : ((p.2.1 : D.points K) * (rep p.1 : D.points K) * (p.2.2 : D.points K)) ∈
          D.extendedElementarySubgroup K :=
        Subgroup.mul_mem _
          (Subgroup.mul_mem _
            (D.borelSubgroup_le_extendedElementarySubgroup K
              (D.positivePoints_le_borelSubgroup K p.2.1.2.1))
            (D.weylSubgroup_le_extendedElementarySubgroup K (rep p.1).2))
          (D.borelSubgroup_le_extendedElementarySubgroup K p.2.2.2)
      obtain ⟨_, _, huniq⟩ := D.existsUnique_bruhatNormalForm K rep hrep hg
      exact (huniq p rfl).trans (huniq q (congrArg Subtype.val hpq).symm).symm,
    fun g => by
      obtain ⟨p, hp, _⟩ := D.existsUnique_bruhatNormalForm K rep hrep g.2
      exact ⟨p, Subtype.ext hp⟩⟩

/-- Evaluating `bruhatNormalFormEquiv` computes `u * rep w * b`. -/
@[simp]
theorem coe_bruhatNormalFormEquiv_apply (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w)
    (p : D.BruhatNormalFormParams K rep) :
    (D.bruhatNormalFormEquiv K rep hrep p : D.points K) =
      (p.2.1 : D.points K) * (rep p.1 : D.points K) * (p.2.2 : D.points K) :=
  (rfl)

/-- When `D.weightLattice = ⊤`, Steinberg's Bruhat normal-form equivalence decomposes the
elementary Chevalley group `D.elementarySubgroup K` itself. -/
noncomputable def bruhatNormalFormEquivOfWeightLatticeEqTop (hD : D.weightLattice = ⊤)
    (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w) :
    D.BruhatNormalFormParams K rep ≃ D.elementarySubgroup K :=
  (D.bruhatNormalFormEquiv K rep hrep).trans
    (Equiv.subtypeEquivRight fun g => by
      rw [D.extendedElementarySubgroup_eq_elementarySubgroup_of_weightLattice_eq_top K hD])

/-- Evaluating `bruhatNormalFormEquivOfWeightLatticeEqTop` computes `u * rep w * b`. -/
@[simp]
theorem coe_bruhatNormalFormEquivOfWeightLatticeEqTop_apply (hD : D.weightLattice = ⊤)
    (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w)
    (p : D.BruhatNormalFormParams K rep) :
    (D.bruhatNormalFormEquivOfWeightLatticeEqTop hD K rep hrep p : D.points K) =
      (p.2.1 : D.points K) * (rep p.1 : D.points K) * (p.2.2 : D.points K) :=
  (rfl)

end TauCeti.DynkinType.ChevalleyDatum

namespace TauCeti.DynkinType

universe v

variable (t : DynkinType) (ht : t.Valid)

/-- **Steinberg's Bruhat normal-form equivalence for the simply connected Chevalley group**
`(t.scChevalleyDatum ht).elementarySubgroup K` over any field `K`. -/
noncomputable def scBruhatNormalFormEquiv (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → (t.scChevalleyDatum ht).weylSubgroup K)
    (hrep : ∀ w, (t.scChevalleyDatum ht).weylProjection K (rep w) = w) :
    (t.scChevalleyDatum ht).BruhatNormalFormParams K rep ≃
      (t.scChevalleyDatum ht).elementarySubgroup K :=
  (t.scChevalleyDatum ht).bruhatNormalFormEquivOfWeightLatticeEqTop
    (t.scChevalleyDatum_weightLattice ht) K rep hrep

/-- Evaluating `scBruhatNormalFormEquiv` computes `u * rep w * b`. -/
@[simp]
theorem coe_scBruhatNormalFormEquiv_apply (K : Type v) [Field K]
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → (t.scChevalleyDatum ht).weylSubgroup K)
    (hrep : ∀ w, (t.scChevalleyDatum ht).weylProjection K (rep w) = w)
    (p : (t.scChevalleyDatum ht).BruhatNormalFormParams K rep) :
    (t.scBruhatNormalFormEquiv ht K rep hrep p : (t.scChevalleyDatum ht).points K) =
      (p.2.1 : (t.scChevalleyDatum ht).points K) *
        (rep p.1 : (t.scChevalleyDatum ht).points K) *
        (p.2.2 : (t.scChevalleyDatum ht).points K) :=
  (rfl)

end TauCeti.DynkinType
