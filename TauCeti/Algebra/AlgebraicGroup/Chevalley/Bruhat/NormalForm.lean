/-!
# Sharp Bruhat normal form and point-level Bruhat decomposition

For a Chevalley datum `D` over a field `k` and a Weyl representative `n ∈ D.weylSubgroup k`, let
`U⁺(k) = D.positivePoints k`, `U⁻(k) = D.negativePoints k`, and `B(k) = D.borelSubgroup k`. Every
element `g` of the double coset `B(k) n B(k)` can be written uniquely as `u * n * b` with
`u ∈ U⁺(k) ∩ n U⁻(k) n⁻¹` and `b ∈ B(k)`. Moreover, the unipotent subgroup
`U⁺(k) ∩ n U⁻(k) n⁻¹` is generated by the root subgroups `X_γ(k)` for `γ` in the inversion set
`inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) (D.weylProjection k n)⁻¹`.

Uniqueness of `(u, b)` in fact holds over an arbitrary commutative ring `A` and for any middle
point `g : D.points A`, as an immediate consequence of `U⁻(A) ∩ B(A) = 1`. Existence over a field
proceeds by induction on the Tits-system word length of the Weyl element, peeling off one simple
reflection at a time via `ChevalleyDatum.mem_positivePoints_iff_exists_rootSubgroupPoints_mul`.
Combining existence and uniqueness identifies `U⁺(k) ∩ n U⁻(k) n⁻¹` with the inversion-indexed root
join and yields the point-level Bruhat decomposition of `D.extendedElementarySubgroup k`.

## Main results

* `ChevalleyDatum.eq_and_eq_of_mul_mul_eq_of_mem_positivePoints_inf_map_negativePoints_conj`:
  uniqueness of `(u, b)` in `u * g * b` for `u ∈ U⁺(A) ∩ g U⁻(A) g⁻¹` and `b ∈ B(A)` over any
  commutative ring `A`.
* `ChevalleyDatum.exists_mem_iSup_inversions_mul_borelSubgroup_eq`: every element of `B(k) n B(k)`
  factors as `u * n * b` with `u` in the join of root subgroups over the inversions of `w⁻¹` and
  `b ∈ B(k)`.
* `ChevalleyDatum.positivePoints_inf_map_negativePoints_conj_eq_iSup`: identifies
  `U⁺(k) ∩ n U⁻(k) n⁻¹` with that inversion-indexed join of root subgroups.
* `ChevalleyDatum.existsUnique_bruhatNormalForm`: unique factorization `u * n * b = g` within each
  Bruhat cell `B(k) n B(k)`.
* `ChevalleyDatum.doubleCoset_borelSubgroup_eq_iff`,
  `ChevalleyDatum.disjoint_doubleCoset_borelSubgroup_iff`,
  `ChevalleyDatum.mem_extendedElementarySubgroup_iff_exists_mem_doubleCoset`, and
  `ChevalleyDatum.existsUnique_bruhatDecomposition_of_mem_extendedElementarySubgroup`:
  point-level Bruhat cell separation, covering, and unique `(w, u, b)` normal form on
  `D.extendedElementarySubgroup k`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorem 4 and its corollary.
* R. W. Carter, *Simple Groups of Lie Type*, §§8.3–8.4.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Chapter IV, §2.
-/

public section

open Multiplicative
open scoped Pointwise

namespace TauCeti.DynkinType.ChevalleyDatum

noncomputable section

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

section CommRing

variable (A : Type v) [CommRing A]

/-- **Uniqueness in the sharp Bruhat normal form over any commutative ring.** If `g : D.points A`,
`u₁, u₂ ∈ U⁺(A) ∩ g U⁻(A) g⁻¹`, and `b₁, b₂ ∈ B(A)` satisfy `u₁ * g * b₁ = u₂ * g * b₂`, then
`u₁ = u₂` and `b₁ = b₂`. -/
theorem eq_and_eq_of_mul_mul_eq_of_mem_positivePoints_inf_map_negativePoints_conj
    {g u₁ u₂ b₁ b₂ : D.points A}
    (hu₁ : u₁ ∈ D.positivePoints A ⊓ (D.negativePoints A).map (MulAut.conj g).toMonoidHom)
    (hu₂ : u₂ ∈ D.positivePoints A ⊓ (D.negativePoints A).map (MulAut.conj g).toMonoidHom)
    (hb₁ : b₁ ∈ D.borelSubgroup A) (hb₂ : b₂ ∈ D.borelSubgroup A)
    (heq : u₁ * g * b₁ = u₂ * g * b₂) :
    u₁ = u₂ ∧ b₁ = b₂ := by
  have hu_diff : u₂⁻¹ * u₁ ∈ (D.negativePoints A).map (MulAut.conj g).toMonoidHom :=
    mul_mem (inv_mem hu₂.2) hu₁.2
  obtain ⟨v, hv, hgv⟩ := hu_diff
  have hv_eq : v = b₂ * b₁⁻¹ := by
    have h1 : (u₂⁻¹ * u₁) * g = g * (b₂ * b₁⁻¹) := by
      calc
        (u₂⁻¹ * u₁) * g = u₂⁻¹ * (u₁ * g * b₁) * b₁⁻¹ := by group
        _ = u₂⁻¹ * (u₂ * g * b₂) * b₁⁻¹ := by rw [heq]
        _ = g * (b₂ * b₁⁻¹) := by group
    have h2 : g * v = g * (b₂ * b₁⁻¹) := by
      calc
        g * v = (g * v * g⁻¹) * g := by group
        _ = (u₂⁻¹ * u₁) * g := by
              rw [← MulAut.conj_apply, ← MulEquiv.coe_toMonoidHom, hgv]
        _ = g * (b₂ * b₁⁻¹) := h1
    exact mul_left_cancel h2
  have hb_diff : b₂ * b₁⁻¹ ∈ D.borelSubgroup A := mul_mem hb₂ (inv_mem hb₁)
  have hv_bot : v ∈ (⊥ : Subgroup (D.points A)) := by
    rw [← D.negativePoints_inf_borelSubgroup_eq_bot A]
    exact ⟨hv, hv_eq ▸ hb_diff⟩
  have hv1 : v = 1 := Subgroup.mem_bot.mp hv_bot
  have hb : b₁ = b₂ := (eq_of_mul_inv_eq_one (hv_eq.symm.trans hv1)).symm
  have hu : u₁ = u₂ := by
    rw [hv1, map_one] at hgv
    exact (eq_of_inv_mul_eq_one hgv.symm).symm
  exact ⟨hu, hb⟩

end CommRing

section Field

variable (k : Type v) [Field k]

/-- For any `n ∈ D.weylSubgroup k`, every root subgroup indexed by an inversion of
`(D.weylProjection k n)⁻¹` lies inside `U⁺(k) ∩ n U⁻(k) n⁻¹`. -/
theorem iSup_rootSubgroupPoints_inversions_le_positivePoints_inf_map_negativePoints_conj
    (n : D.weylSubgroup k) :
    (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection k n)⁻¹,
      (D.rootSubgroupPoints γ k).range) ≤
      D.positivePoints k ⊓
        (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom := by
  refine iSup₂_le fun γ hγ ↦ ?_
  rintro _ ⟨u, rfl⟩
  have hγ' := (mem_inversions _ _ _ _).mp hγ
  have hγ_pos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [t.posRoots_rationalRootSystem ht, mem_posRoots]
    exact hγ'.1
  refine ⟨D.rootSubgroupPoints_mem_positivePoints k hγ_pos u, ?_⟩
  let β := (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k n)⁻¹ γ
  have hβ_neg : β ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [negRoots_eq_compl, t.posRoots_rationalRootSystem ht, Set.mem_compl_iff, mem_posRoots]
    exact hγ'.2
  have hnβ : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k n) β = γ := by
    simp only [β, ← Equiv.Perm.mul_apply, ← map_mul, mul_inv_cancel, map_one,
      Equiv.Perm.one_apply]
  have hmem_range : D.rootSubgroupPoints γ k u ∈
      (D.rootSubgroupPoints β k).range.map (MulAut.conj (n : D.points k)).toMonoidHom := by
    rw [D.map_range_rootSubgroupPoints_conj k n β, hnβ]
    exact ⟨u, rfl⟩
  obtain ⟨x, ⟨a, rfl⟩, hx⟩ := hmem_range
  exact ⟨D.rootSubgroupPoints β k a, D.rootSubgroupPoints_mem_negativePoints k hβ_neg a, hx⟩

private theorem map_iSup_inversions_conj_weylElement_le
    (i : Fin t.rank) (w : (t.simplyConnectedRootDatum ht).weylGroup)
    (hnot : t.simpleIndex ht i ∉
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w) :
    (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w,
        (D.rootSubgroupPoints γ k).range).map
      (MulAut.conj (D.weylElement (t.simpleIndex ht i) k 1)).toMonoidHom ≤
    ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (w * RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)),
      (D.rootSubgroupPoints γ k).range := by
  have := t.isReduced_simplyConnectedRootDatum ht
  let n_i : D.weylSubgroup k :=
    ⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩
  -- Express the conjugation point via its subtype representative `n_i` in `D.weylSubgroup k`.
  change (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w,
      (D.rootSubgroupPoints γ k).range).map (MulAut.conj (n_i : D.points k)).toMonoidHom ≤ _
  rw [D.map_iSup_rootSubgroupPoints_conj k n_i]
  refine iSup₂_le fun γ hγ ↦ ?_
  obtain ⟨δ, hδ, rfl⟩ := hγ
  have hδ_ne : δ ≠ t.simpleIndex ht i := fun h ↦ hnot (h ▸ hδ)
  have hδ' := (mem_inversions _ _ _ _).mp hδ
  have hi_supp : t.simpleIndex ht i ∈ (t.simplyConnectedBase ht).support := by
    rw [← t.support_rationalBase ht]
    exact simpleIndex_mem_support i
  have hperm : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k n_i) δ =
      (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) δ := by
    simp only [n_i, D.weylProjection_weylElement, RootPairing.weylGroupToPerm_ofIdx_apply]
  have hmem_new : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection k n_i) δ ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (w * RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) := by
    rw [hperm, mem_inversions]
    refine ⟨hδ'.1.reflectionPerm hi_supp hδ_ne, ?_⟩
    rw [RootPairing.weylGroupToPerm_mul_ofIdx_apply,
      (t.simplyConnectedRootDatum ht).reflectionPerm_self]
    exact hδ'.2
  exact le_iSup₂_of_le _ hmem_new le_rfl

/-- **Existence of the sharp Bruhat normal form in root coordinates.** Over any field `k`, every
element `g` of the double coset `B(k) n B(k)` factors as `u * n * b = g` with `b ∈ B(k)` and `u`
in the subgroup generated by the root subgroups indexed by the inversions of
`(D.weylProjection k n)⁻¹`. -/
theorem exists_mem_iSup_inversions_mul_borelSubgroup_eq
    (n : D.weylSubgroup k) {g : D.points k}
    (hg : g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k)) :
    ∃ u ∈ (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection k n)⁻¹, (D.rootSubgroupPoints γ k).range),
      ∃ b ∈ D.borelSubgroup k, u * (n : D.points k) * b = g := by
  suffices key : ∀ m : ℕ, ∀ q : (D.titsSystem k).WeylGroup,
      (D.titsSystem k).simpleGenerators.wordLength q = m →
      ∀ n : D.weylSubgroup k, D.titsSystemWeylGroupMulEquiv k q = D.weylProjection k n →
      ∀ g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k),
      ∃ u ∈ (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection k n)⁻¹, (D.rootSubgroupPoints γ k).range),
        ∃ b ∈ D.borelSubgroup k, u * (n : D.points k) * b = g by
    let q := (D.titsSystemWeylGroupMulEquiv k).symm (D.weylProjection k n)
    exact key _ q rfl n ((D.titsSystemWeylGroupMulEquiv k).apply_symm_apply _) g hg
  intro m
  induction m with
  | zero =>
    intro q hlen n hqn g hg
    have hq1 : q = 1 := (Group.Generators.wordLength_eq_zero_iff _).mp hlen
    have hn_ker : n ∈ (D.weylProjection k).ker := by
      rw [MonoidHom.mem_ker, ← hqn, hq1, map_one]
    rw [D.ker_weylProjection k, Subgroup.mem_subgroupOf] at hn_ker
    have hnB : (n : D.points k) ∈ D.borelSubgroup k :=
      D.range_torusPoints_le_borelSubgroup k hn_ker
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    refine ⟨1, one_mem _, (n : D.points k)⁻¹ * (b₁ * (n : D.points k) * b₂),
      mul_mem (inv_mem hnB) (mul_mem (mul_mem hb₁ hnB) hb₂), by group⟩
  | succ m ih =>
    intro q hlen n hqn g hg
    obtain ⟨l, hl, hllen, hprod⟩ := (D.titsSystem k).exists_prod_eq_of_wordLength q
    rcases l with _ | ⟨s, l'⟩
    · rw [List.length_nil] at hllen
      omega
    · rw [List.forall_mem_cons] at hl
      obtain ⟨hs, hl'⟩ := hl
      have hs' := hs
      rw [D.titsSystem_simple] at hs'
      obtain ⟨i, rfl⟩ := hs'
      dsimp only at hs hllen hprod
      let q' : (D.titsSystem k).WeylGroup := l'.prod
      have hq_eq : (QuotientGroup.mk (D.titsSystemSimpleRep k i) :
          (D.titsSystem k).WeylGroup) * q' = q := by
        simpa only [q', List.prod_cons] using hprod
      have hlen_q' : (D.titsSystem k).simpleGenerators.wordLength q' = m := by
        have hle1 : (D.titsSystem k).simpleGenerators.wordLength q' ≤ l'.length :=
          (D.titsSystem k).wordLength_prod_le hl'
        have hle2 := (D.titsSystem k).wordLength_simple_mul_le hs q'
        rw [hq_eq, hlen] at hle2
        rw [List.length_cons, hlen] at hllen
        omega
      have hlt_q' : (D.titsSystem k).simpleGenerators.wordLength q' <
          (D.titsSystem k).simpleGenerators.wordLength
            (QuotientGroup.mk (D.titsSystemSimpleRep k i) * q') := by
        rw [hq_eq, hlen, hlen_q']
        exact Nat.lt_succ_self m
      have hnot_inv_q' : t.simpleIndex ht i ∉
          inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
            (D.titsSystemWeylGroupMulEquiv k q')⁻¹ :=
        (D.wordLength_lt_wordLength_titsSystemSimpleRep_mul_iff k i q').mp hlt_q'
      let n_i : D.weylSubgroup k :=
        ⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩
      let n' : D.weylSubgroup k := n_i⁻¹ * n
      have hq'n' : D.titsSystemWeylGroupMulEquiv k q' = D.weylProjection k n' := by
        have h1 : D.weylProjection k n_i =
            D.titsSystemWeylGroupMulEquiv k (QuotientGroup.mk (D.titsSystemSimpleRep k i)) := by
          rw [D.titsSystemWeylGroupMulEquiv_simpleRep, D.weylProjection_weylElement]
        calc
          D.titsSystemWeylGroupMulEquiv k q'
              = (D.titsSystemWeylGroupMulEquiv k
                  (QuotientGroup.mk (D.titsSystemSimpleRep k i)))⁻¹ *
                D.titsSystemWeylGroupMulEquiv k
                  (QuotientGroup.mk (D.titsSystemSimpleRep k i) * q') := by
                rw [map_mul, inv_mul_cancel_left]
          _ = (D.weylProjection k n_i)⁻¹ * D.weylProjection k n := by rw [← h1, hq_eq, hqn]
          _ = D.weylProjection k n' := by simp [n']
      have hnot_inv : t.simpleIndex ht i ∉
          inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
            (D.weylProjection k n')⁻¹ := by
        rwa [← hq'n']
      obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
      obtain ⟨v, hv, r, hvr⟩ := (D.mem_borelSubgroup_iff k).mp hb₁
      have htR : (n : D.points k)⁻¹ * D.torusPoints k r * (n : D.points k) ∈
          D.borelSubgroup k := by
        simpa using D.weylSubgroup_conj_torusPoints_mem_borelSubgroup k n⁻¹ r
      obtain ⟨a, v₀, hv₀, rfl⟩ :=
        (D.mem_positivePoints_iff_exists_rootSubgroupPoints_mul k i v).mp hv
      have hv₀'B : (n_i : D.points k)⁻¹ * v₀ * (n_i : D.points k) ∈ D.borelSubgroup k := by
        refine D.positivePoints_le_borelSubgroup k
          (D.iSup_rootSubgroupPoints_diff_singleton_le_positivePoints k i ?_)
        have hnorm := inv_mem (D.weylElement_mem_normalizer_positivePoints_diff_singleton k i 1)
        exact (Subgroup.mem_normalizer_iff.mp hnorm v₀).mp (by simpa [n_i] using hv₀)
      have hcell' : ((n_i : D.points k)⁻¹ * v₀ * (n_i : D.points k)) * (n' : D.points k) ∈
          DoubleCoset.doubleCoset (n' : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) :=
        DoubleCoset.mem_doubleCoset.mpr ⟨_, hv₀'B, 1, one_mem _, (mul_one _).symm⟩
      obtain ⟨u', hu', b', hb', hub'⟩ := ih q' hlen_q' n' hq'n' _ hcell'
      have hn_proj_inv : (D.weylProjection k n)⁻¹ =
          (D.weylProjection k n')⁻¹ *
            RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
        have hn_eq : n = n_i * n' := by simp [n']
        rw [hn_eq, map_mul, mul_inv_rev, D.weylProjection_weylElement,
          RootPairing.weylGroup.ofIdx_inv_eq]
      have hi_pos : (t.simplyConnectedBase ht).IsPos (t.simpleIndex ht i) :=
        RootPairing.Base.isPos_of_mem_support
          (t.support_rationalBase ht ▸ t.simpleIndex_mem_support i)
      have hi_mem_inv : t.simpleIndex ht i ∈
          inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
            (D.weylProjection k n)⁻¹ := by
        rw [hn_proj_inv, mem_inversions_mul_ofIdx_iff_not_mem _ _ _ hi_pos]
        exact hnot_inv
      have hx_mem : D.rootSubgroupPoints (t.simpleIndex ht i) k a ∈
          ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
            (D.weylProjection k n)⁻¹, (D.rootSubgroupPoints γ k).range :=
        (le_iSup₂ (f := fun γ _ ↦ (D.rootSubgroupPoints γ k).range)
          (t.simpleIndex ht i) hi_mem_inv) ⟨a, rfl⟩
      have hu'_conj_mem : (n_i : D.points k) * u' * (n_i : D.points k)⁻¹ ∈
          ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
            (D.weylProjection k n)⁻¹, (D.rootSubgroupPoints γ k).range := by
        rw [hn_proj_inv]
        exact D.map_iSup_inversions_conj_weylElement_le k i (D.weylProjection k n')⁻¹ hnot_inv
          ⟨u', hu', rfl⟩
      refine ⟨D.rootSubgroupPoints (t.simpleIndex ht i) k a *
          ((n_i : D.points k) * u' * (n_i : D.points k)⁻¹),
        mul_mem hx_mem hu'_conj_mem,
        b' * ((n : D.points k)⁻¹ * D.torusPoints k r * (n : D.points k)) * b₂,
        mul_mem (mul_mem hb' htR) hb₂, ?_⟩
      have hn_coe : (n : D.points k) = (n_i : D.points k) * (n' : D.points k) := by
        simp [n']
      calc
        D.rootSubgroupPoints (t.simpleIndex ht i) k a *
            ((n_i : D.points k) * u' * (n_i : D.points k)⁻¹) * (n : D.points k) *
            (b' * ((n : D.points k)⁻¹ * D.torusPoints k r * (n : D.points k)) * b₂)
            = D.rootSubgroupPoints (t.simpleIndex ht i) k a * (n_i : D.points k) *
                (u' * (n' : D.points k) * b') *
                ((n : D.points k)⁻¹ * D.torusPoints k r * (n : D.points k)) * b₂ := by
              rw [hn_coe]; group
        _ = D.rootSubgroupPoints (t.simpleIndex ht i) k a * (n_i : D.points k) *
              (((n_i : D.points k)⁻¹ * v₀ * (n_i : D.points k)) * (n' : D.points k)) *
              ((n : D.points k)⁻¹ * D.torusPoints k r * (n : D.points k)) * b₂ := by
              rw [hub']
        _ = (D.rootSubgroupPoints (t.simpleIndex ht i) k a * v₀ * D.torusPoints k r) *
              (n : D.points k) * b₂ := by
              rw [hn_coe]; group
        _ = b₁ * (n : D.points k) * b₂ := by rw [hvr]

/-- **Explicit root-subgroup description of `U⁺(k) ∩ n U⁻(k) n⁻¹`.** Over any field `k`, for every
`n ∈ D.weylSubgroup k`, the intersection of `D.positivePoints k` with the `n`-conjugate of
`D.negativePoints k` is generated by the root subgroups indexed by the inversions of
`(D.weylProjection k n)⁻¹`. -/
theorem positivePoints_inf_map_negativePoints_conj_eq_iSup
    (n : D.weylSubgroup k) :
    D.positivePoints k ⊓
        (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom =
      ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection k n)⁻¹, (D.rootSubgroupPoints γ k).range := by
  apply le_antisymm _
    (D.iSup_rootSubgroupPoints_inversions_le_positivePoints_inf_map_negativePoints_conj k n)
  intro u₀ hu₀
  have hcell : u₀ * (n : D.points k) ∈
      DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) :=
    DoubleCoset.mem_doubleCoset.mpr
      ⟨u₀, D.positivePoints_le_borelSubgroup k hu₀.1, 1, one_mem _, (mul_one _).symm⟩
  obtain ⟨u, hu, b, hb, hub⟩ := D.exists_mem_iSup_inversions_mul_borelSubgroup_eq k n hcell
  have hu_inf :=
    D.iSup_rootSubgroupPoints_inversions_le_positivePoints_inf_map_negativePoints_conj k n hu
  have heq := D.eq_and_eq_of_mul_mul_eq_of_mem_positivePoints_inf_map_negativePoints_conj k
    hu_inf hu₀ hb (one_mem _) (hub.trans (mul_one _).symm)
  exact heq.1 ▸ hu

/-- **Sharp Bruhat normal form within a Bruhat cell.** Over any field `k`, every element `g` of the
double coset `B(k) n B(k)` can be written uniquely as `u * n * b = g` with
`u ∈ U⁺(k) ∩ n U⁻(k) n⁻¹` and `b ∈ B(k)`. -/
theorem existsUnique_bruhatNormalForm
    (n : D.weylSubgroup k) {g : D.points k}
    (hg : g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k)) :
    ∃! p :
        ↥(D.positivePoints k ⊓
          (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom) ×
        ↥(D.borelSubgroup k),
      (p.1 : D.points k) * (n : D.points k) * (p.2 : D.points k) = g := by
  obtain ⟨u, hu, b, hb, hub⟩ := D.exists_mem_iSup_inversions_mul_borelSubgroup_eq k n hg
  rw [← D.positivePoints_inf_map_negativePoints_conj_eq_iSup k n] at hu
  refine ⟨(⟨u, hu⟩, ⟨b, hb⟩), hub, ?_⟩
  rintro ⟨⟨u', hu'⟩, ⟨b', hb'⟩⟩ hub'
  have h := D.eq_and_eq_of_mul_mul_eq_of_mem_positivePoints_inf_map_negativePoints_conj k
    hu' hu hb' hb (hub'.trans hub.symm)
  exact Prod.ext (Subtype.ext h.1) (Subtype.ext h.2)

private theorem doubleCoset_borelSubgroup_le_extendedElementary
    (n : D.weylSubgroup k) {g : D.points k}
    (hg : g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k)) :
    g ∈ D.extendedElementarySubgroup k := by
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
  exact mul_mem
    (mul_mem (D.borelSubgroup_le_extendedElementarySubgroup k hb₁)
      (D.weylSubgroup_le_extendedElementarySubgroup k n.2))
    (D.borelSubgroup_le_extendedElementarySubgroup k hb₂)

/-- Over any field, two `B(k)`-double cosets represented by `n₁, n₂ ∈ D.weylSubgroup k` coincide
inside `D.points k` precisely when `n₁` and `n₂` have the same Weyl projection. -/
@[simp]
theorem doubleCoset_borelSubgroup_eq_iff (n₁ n₂ : D.weylSubgroup k) :
    DoubleCoset.doubleCoset (n₁ : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) =
        DoubleCoset.doubleCoset (n₂ : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) ↔
      D.weylProjection k n₁ = D.weylProjection k n₂ := by
  constructor
  · intro h
    have hcell : (D.titsSystem k).bruhatCell (QuotientGroup.mk (D.toTitsSystemSubgroupN k n₁)) =
        (D.titsSystem k).bruhatCell (QuotientGroup.mk (D.toTitsSystemSubgroupN k n₂)) := by
      ext x
      rw [D.mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff k n₁,
        D.mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff k n₂, h]
    have hmk := (D.titsSystem k).bruhatCell_injective hcell
    simpa only [D.titsSystemWeylGroupMulEquiv_mk_toTitsSystemSubgroupN] using
      congrArg (D.titsSystemWeylGroupMulEquiv k) hmk
  · intro h
    have hmk : (QuotientGroup.mk (D.toTitsSystemSubgroupN k n₁) : (D.titsSystem k).WeylGroup) =
        QuotientGroup.mk (D.toTitsSystemSubgroupN k n₂) :=
      (D.titsSystemWeylGroupMulEquiv k).injective
        (by simpa only [D.titsSystemWeylGroupMulEquiv_mk_toTitsSystemSubgroupN] using h)
    ext g
    constructor
    · intro hg
      let x : D.extendedElementarySubgroup k :=
        ⟨g, D.doubleCoset_borelSubgroup_le_extendedElementary k n₁ hg⟩
      exact (D.mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff k n₂ (x := x)).mp
        (hmk ▸ (D.mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff k n₁ (x := x)).mpr hg)
    · intro hg
      let x : D.extendedElementarySubgroup k :=
        ⟨g, D.doubleCoset_borelSubgroup_le_extendedElementary k n₂ hg⟩
      exact (D.mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff k n₁ (x := x)).mp
        (hmk.symm ▸
          (D.mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff k n₂ (x := x)).mpr hg)

/-- Over any field, two `B(k)`-double cosets represented by `n₁, n₂ ∈ D.weylSubgroup k` are
disjoint inside `D.points k` precisely when `n₁` and `n₂` have distinct Weyl projections. -/
@[simp]
theorem disjoint_doubleCoset_borelSubgroup_iff (n₁ n₂ : D.weylSubgroup k) :
    Disjoint
        (DoubleCoset.doubleCoset (n₁ : D.points k) (D.borelSubgroup k) (D.borelSubgroup k))
        (DoubleCoset.doubleCoset (n₂ : D.points k) (D.borelSubgroup k) (D.borelSubgroup k)) ↔
      D.weylProjection k n₁ ≠ D.weylProjection k n₂ := by
  constructor
  · rintro h heq
    rw [← D.doubleCoset_borelSubgroup_eq_iff k n₁ n₂] at heq
    have hmem := DoubleCoset.mem_doubleCoset_self (D.borelSubgroup k) (D.borelSubgroup k)
      (n₁ : D.points k)
    exact Set.disjoint_left.mp h hmem (heq ▸ hmem)
  · intro hne
    rw [Set.disjoint_left]
    intro g hg₁ hg₂
    let x : D.extendedElementarySubgroup k :=
      ⟨g, D.doubleCoset_borelSubgroup_le_extendedElementary k n₁ hg₁⟩
    have hx₁ := (D.mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff k n₁ (x := x)).mpr hg₁
    have hx₂ := (D.mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff k n₂ (x := x)).mpr hg₂
    have hmk := (D.titsSystem k).eq_of_mem_bruhatCell_of_mem hx₁ hx₂
    apply hne
    simpa only [D.titsSystemWeylGroupMulEquiv_mk_toTitsSystemSubgroupN] using
      congrArg (D.titsSystemWeylGroupMulEquiv k) hmk

/-- Over any field, `D.extendedElementarySubgroup k` is the union of the `B(k)`-double cosets of
`D.weylSubgroup k`. -/
theorem mem_extendedElementarySubgroup_iff_exists_mem_doubleCoset (g : D.points k) :
    g ∈ D.extendedElementarySubgroup k ↔
      ∃ n : D.weylSubgroup k,
        g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) := by
  constructor
  · intro hg
    obtain ⟨n_ext, hn_ext⟩ := (D.titsSystem k).exists_mem_doubleCoset ⟨g, hg⟩
    let n : D.weylSubgroup k :=
      ⟨((n_ext : D.extendedElementarySubgroup k) : D.points k),
        D.titsSystem_subgroupN_coe_mem k n_ext⟩
    have hlift : D.toTitsSystemSubgroupN k n = n_ext :=
      Subtype.ext (Subtype.ext (D.coe_toTitsSystemSubgroupN k n))
    refine ⟨n, ?_⟩
    rw [← D.mem_bruhatCell_titsSystem_mk_toTitsSystemSubgroupN_iff k n (x := ⟨g, hg⟩), hlift,
      (D.titsSystem k).bruhatCell_mk]
    exact hn_ext
  · rintro ⟨n, hn⟩
    exact D.doubleCoset_borelSubgroup_le_extendedElementary k n hn

/-- **Point-level Bruhat cell uniqueness.** Every element of `D.extendedElementarySubgroup k`
belongs to the `B(k)`-double coset of a unique Weyl-group element. -/
theorem existsUnique_weylProjection_of_mem_extendedElementarySubgroup
    {g : D.points k} (hg : g ∈ D.extendedElementarySubgroup k) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup,
      ∃ n : D.weylSubgroup k, D.weylProjection k n = w ∧
        g ∈ DoubleCoset.doubleCoset (n : D.points k)
          (D.borelSubgroup k) (D.borelSubgroup k) := by
  obtain ⟨n₀, hn₀⟩ := (D.mem_extendedElementarySubgroup_iff_exists_mem_doubleCoset k g).mp hg
  refine ⟨D.weylProjection k n₀, ⟨n₀, rfl, hn₀⟩, ?_⟩
  rintro w ⟨n, rfl, hn⟩
  by_contra hne
  exact Set.disjoint_left.mp
    ((D.disjoint_doubleCoset_borelSubgroup_iff k n n₀).mpr hne) hn hn₀

/-- **Sharp Bruhat decomposition of `D.extendedElementarySubgroup k`.** Given any set-theoretic
section `σ` of `D.weylProjection k`, every `g ∈ D.extendedElementarySubgroup k` can be written
uniquely as `u * σ w * b = g` with `w : (t.simplyConnectedRootDatum ht).weylGroup`,
`u ∈ U⁺(k) ∩ (σ w) U⁻(k) (σ w)⁻¹`, and `b ∈ B(k)`. -/
theorem existsUnique_bruhatDecomposition_of_mem_extendedElementarySubgroup
    (σ : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup k)
    (hσ : ∀ w, D.weylProjection k (σ w) = w)
    {g : D.points k} (hg : g ∈ D.extendedElementarySubgroup k) :
    ∃! x : (t.simplyConnectedRootDatum ht).weylGroup × D.points k × D.points k,
      x.2.1 ∈ D.positivePoints k ⊓
          (D.negativePoints k).map (MulAut.conj (σ x.1 : D.points k)).toMonoidHom ∧
        x.2.2 ∈ D.borelSubgroup k ∧
        x.2.1 * (σ x.1 : D.points k) * x.2.2 = g := by
  obtain ⟨n₀, hn₀⟩ := (D.mem_extendedElementarySubgroup_iff_exists_mem_doubleCoset k g).mp hg
  let w₀ := D.weylProjection k n₀
  have hcell : g ∈ DoubleCoset.doubleCoset (σ w₀ : D.points k)
      (D.borelSubgroup k) (D.borelSubgroup k) := by
    have heq : DoubleCoset.doubleCoset (σ w₀ : D.points k)
          (D.borelSubgroup k) (D.borelSubgroup k) =
        DoubleCoset.doubleCoset (n₀ : D.points k)
          (D.borelSubgroup k) (D.borelSubgroup k) :=
      (D.doubleCoset_borelSubgroup_eq_iff k (σ w₀) n₀).mpr (hσ w₀)
    exact heq.symm ▸ hn₀
  obtain ⟨⟨u₀, b₀⟩, hub₀, -⟩ := D.existsUnique_bruhatNormalForm k (σ w₀) hcell
  refine ⟨(w₀, u₀.1, b₀.1), ⟨u₀.2, b₀.2, hub₀⟩, ?_⟩
  rintro ⟨w, u, b⟩ ⟨hu, hb, hub⟩
  have hg_w : g ∈ DoubleCoset.doubleCoset (σ w : D.points k)
      (D.borelSubgroup k) (D.borelSubgroup k) :=
    DoubleCoset.mem_doubleCoset.mpr
      ⟨u, D.positivePoints_le_borelSubgroup k hu.1, b, hb, hub.symm⟩
  have hw : w = w₀ := by
    by_contra hne
    have hproj_ne : D.weylProjection k (σ w) ≠ D.weylProjection k (σ w₀) := by
      rwa [hσ, hσ]
    exact Set.disjoint_left.mp
      ((D.disjoint_doubleCoset_borelSubgroup_iff k (σ w) (σ w₀)).mpr hproj_ne) hg_w hcell
  subst hw
  have hpair := D.eq_and_eq_of_mul_mul_eq_of_mem_positivePoints_inf_map_negativePoints_conj k
    hu u₀.2 hb b₀.2 (hub.trans hub₀.symm)
  exact Prod.ext rfl (Prod.ext hpair.1 hpair.2)

end Field

