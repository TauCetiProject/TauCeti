/-!
# Steinberg's sharpened Bruhat normal form for Chevalley groups

For every valid Dynkin type `t` and Chevalley datum `D` of type `t` over an arbitrary field `k`,
splitting `D.positivePoints k` along the inversion set of `(D.weylProjection k n⁻¹)` and
conjugating the non-inverted root subgroups across `n : D.weylSubgroup k` identifies the
unipotent Bruhat cell factor
`U_n(k) :=`
`  D.positivePoints k ⊓ (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom`
with the subgroup generated by the inverted positive root subgroups
(`ChevalleyDatum.positivePoints_inf_map_negativePoints_eq_iSup`). Together with the integral
disjointness `ChevalleyDatum.disjoint_positivePoints_inf_map_negativePoints_map_borelSubgroup`,
this establishes existence and uniqueness of Steinberg's sharpened normal form `g = u * n * b` on
every Bruhat double coset `B(k) n B(k)`
(`ChevalleyDatum.mem_doubleCoset_borelSubgroup_iff_exists_mul`,
`ChevalleyDatum.existsUnique_mul_weylSubgroup_mul_eq_of_mem_doubleCoset_borelSubgroup`).

## Main results

* `ChevalleyDatum.positivePoints_inf_map_negativePoints_eq_iSup`:
  root-subgroup characterization of `U(k) ∩ n U⁻(k) n⁻¹` over any field `k`.
* `ChevalleyDatum.mem_doubleCoset_borelSubgroup_iff_exists_mul` and
  `ChevalleyDatum.existsUnique_mul_weylSubgroup_mul_eq_of_mem_doubleCoset_borelSubgroup`:
  Steinberg's existence and uniqueness normal form on each Bruhat cell over any field `k`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorem 4′.
* R. W. Carter, *Simple Groups of Lie Type*, §§8.2–8.4.
-/

public section

open Multiplicative

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

private theorem iSup_inversions_le_positivePoints_inf_map_negativePoints (k : Type v) [Field k]
    (n : D.weylSubgroup k) :
    (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection k n⁻¹),
      (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)) ≤
      D.positivePoints k ⊓
        (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom := by
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  let S := inversions P b (D.weylProjection k n⁻¹)
  refine le_inf (iSup₂_le fun γ hγ => ?_) ?_
  · rintro _ ⟨c, rfl⟩
    have hγ' : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [posRoots_rationalRootSystem]
      exact inversions_subset_posRoots P b _ hγ
    exact D.rootSubgroupPoints_mem_positivePoints k hγ' c
  · have hconj :
        (⨆ γ ∈ S, (D.rootSubgroupPoints γ k).range).map
            (MulAut.conj ((n⁻¹ : D.weylSubgroup k) : D.points k)).toMonoidHom ≤
          D.negativePoints k := by
      rw [D.map_iSup_rootSubgroupPoints_conj]
      refine iSup₂_le fun δ hδ => ?_
      obtain ⟨γ, hγ, rfl⟩ := hδ
      have hneg : P.weylGroupToPerm (D.weylProjection k n⁻¹) γ ∈
          negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
        rw [← not_mem_posRoots_iff_mem_negRoots, posRoots_rationalRootSystem,
          not_mem_posRoots_iff_mem_negRoots]
        exact mapsTo_inversions_negRoots P b _ hγ
      rintro _ ⟨c, rfl⟩
      exact D.rootSubgroupPoints_mem_negativePoints k hneg c
    intro u hu
    refine ⟨MulAut.conj ((n⁻¹ : D.weylSubgroup k) : D.points k) u,
      hconj ⟨u, hu, rfl⟩, ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, Subgroup.coe_inv]
    group

private theorem exists_mul_conj_inv_mem_borelSubgroup_of_mem_positivePoints
    (k : Type v) [Field k] (n : D.weylSubgroup k) {u : D.points k}
    (hu : u ∈ D.positivePoints k) :
    ∃ u₁ ∈ (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection k n⁻¹),
      (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)),
      ∃ u₂ : D.points k,
        u₁ * u₂ = u ∧
        (n : D.points k)⁻¹ * u₂ * (n : D.points k) ∈ D.borelSubgroup k := by
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  let S := inversions P b (D.weylProjection k n⁻¹)
  have hS : S ⊆ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [posRoots_rationalRootSystem]
    exact inversions_subset_posRoots P b _
  obtain ⟨u₁, hu₁, u₂, hu₂, hmul⟩ :=
    (D.mem_positivePoints_iff_exists_mul_of_subset hS k u).mp hu
  refine ⟨u₁, hu₁, u₂, hmul, ?_⟩
  have hconj :
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ S,
        (D.rootSubgroupPoints γ k).range).map
          (MulAut.conj ((n⁻¹ : D.weylSubgroup k) : D.points k)).toMonoidHom ≤
        D.borelSubgroup k := by
    rw [D.map_iSup_rootSubgroupPoints_conj]
    refine (iSup₂_le fun δ hδ => ?_).trans (D.positivePoints_le_borelSubgroup k)
    obtain ⟨γ, hγ, rfl⟩ := hδ
    rw [posRoots_rationalRootSystem] at hγ
    have hpos : P.weylGroupToPerm (D.weylProjection k n⁻¹) γ ∈
        posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [posRoots_rationalRootSystem, mem_posRoots]
      exact ((mem_posRoots_sdiff_inversions P b _ γ).mp hγ).2
    rintro _ ⟨c, rfl⟩
    exact D.rootSubgroupPoints_mem_positivePoints k hpos c
  simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, Subgroup.coe_inv, inv_inv] using
    hconj ⟨u₂, hu₂, rfl⟩

private theorem exists_mul_mem_iSup_inversions_of_mem_doubleCoset
    (k : Type v) [Field k] (n : D.weylSubgroup k) {g : D.points k}
    (hg : g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k)) :
    ∃ u₁ ∈ (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection k n⁻¹),
      (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)),
      ∃ b ∈ D.borelSubgroup k, u₁ * (n : D.points k) * b = g := by
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
  obtain ⟨u₀, hu₀, s, hs⟩ := (D.mem_borelSubgroup_iff k).mp hb₁
  obtain ⟨u₁, hu₁, u₂, rfl, hu₂_conj⟩ :=
    D.exists_mul_conj_inv_mem_borelSubgroup_of_mem_positivePoints k n hu₀
  have htn :
      (n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k) ∈ D.borelSubgroup k := by
    simpa only [Subgroup.coe_inv, inv_inv] using
      D.weylSubgroup_conj_torusPoints_mem_borelSubgroup k n⁻¹ s
  refine ⟨u₁, hu₁,
    ((n : D.points k)⁻¹ * u₂ * (n : D.points k)) *
      ((n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k)) * b₂,
    (D.borelSubgroup k).mul_mem ((D.borelSubgroup k).mul_mem hu₂_conj htn) hb₂, ?_⟩
  rw [← hs]
  group

/-- **Root-subgroup characterization of the unipotent Bruhat cell factor
`U(k) ∩ n U⁻(k) n⁻¹`**: over any field `k`, it is generated by the positive root subgroups
sent to negative roots by `n⁻¹`. -/
theorem positivePoints_inf_map_negativePoints_eq_iSup (k : Type v) [Field k]
    (n : D.weylSubgroup k) :
    D.positivePoints k ⊓
        (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom =
      ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection k n⁻¹),
        (D.rootSubgroupPoints γ k).range := by
  apply le_antisymm _ (D.iSup_inversions_le_positivePoints_inf_map_negativePoints k n)
  intro u hu
  have hmem : u * (n : D.points k) ∈
      DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) :=
    DoubleCoset.mem_doubleCoset.mpr
      ⟨u, D.positivePoints_le_borelSubgroup k hu.1, 1, (D.borelSubgroup k).one_mem, by simp⟩
  obtain ⟨u₁, hu₁, b, hb, heq⟩ :=
    D.exists_mul_mem_iSup_inversions_of_mem_doubleCoset k n hmem
  have hinj := Subgroup.mul_mul_injective_of_disjoint
    (D.positivePoints k ⊓ (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom)
    (D.borelSubgroup k)
    (D.disjoint_positivePoints_inf_map_negativePoints_map_borelSubgroup k (n : D.points k))
  have hpair := hinj
    (a₁ := (⟨u₁, D.iSup_inversions_le_positivePoints_inf_map_negativePoints k n hu₁⟩,
      ⟨b, hb⟩))
    (a₂ := (⟨u, hu⟩, ⟨1, (D.borelSubgroup k).one_mem⟩)) (by simpa using heq)
  have hu_eq : u₁ = u := congrArg (Subtype.val ∘ Prod.fst) hpair
  exact hu_eq ▸ hu₁

/-- **Steinberg's Bruhat cell factorization over a field**: every element of the `B`-double coset
of `n : D.weylSubgroup k` factors as `u * n * b` with `u ∈ U(k) ∩ n U⁻(k) n⁻¹` and
`b ∈ B(k)`. -/
theorem mem_doubleCoset_borelSubgroup_iff_exists_mul (k : Type v) [Field k]
    (n : D.weylSubgroup k) {g : D.points k} :
    g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) ↔
      ∃ u ∈ D.positivePoints k ⊓
          (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom,
        ∃ b ∈ D.borelSubgroup k, u * (n : D.points k) * b = g := by
  constructor
  · intro hg
    rw [D.positivePoints_inf_map_negativePoints_eq_iSup k n]
    exact D.exists_mul_mem_iSup_inversions_of_mem_doubleCoset k n hg
  · rintro ⟨u, hu, b, hb, rfl⟩
    exact DoubleCoset.mem_doubleCoset.mpr
      ⟨u, D.positivePoints_le_borelSubgroup k hu.1, b, hb, rfl⟩

/-- **Steinberg's unique normal form on each Bruhat cell over a field**: every element of the
`B`-double coset of `n : D.weylSubgroup k` factors uniquely as `u * n * b` with
`u ∈ U(k) ∩ n U⁻(k) n⁻¹` and `b ∈ B(k)`. -/
theorem existsUnique_mul_weylSubgroup_mul_eq_of_mem_doubleCoset_borelSubgroup
    (k : Type v) [Field k] (n : D.weylSubgroup k) {g : D.points k}
    (hg : g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k)) :
    ∃! p : ↥(D.positivePoints k ⊓
        (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom) ×
      D.borelSubgroup k,
      (p.1 : D.points k) * (n : D.points k) * (p.2 : D.points k) = g := by
  obtain ⟨u, hu, b, hb, rfl⟩ := (D.mem_doubleCoset_borelSubgroup_iff_exists_mul k n).mp hg
  exact ⟨(⟨u, hu⟩, ⟨b, hb⟩), rfl, fun p hp =>
    Subgroup.mul_mul_injective_of_disjoint _ _
      (D.disjoint_positivePoints_inf_map_negativePoints_map_borelSubgroup k (n : D.points k)) hp⟩

end TauCeti.DynkinType.ChevalleyDatum
