import TauCeti.LinearAlgebra.RootSystem.Weyl.Group

/-!
# The Bruhat multiplication axiom for Chevalley data

Let `D` be a Chevalley datum of simply-laced type and `k` a field. Let `B` be the Borel-type
subgroup of the points of `D` over `k`, generated by the positive root subgroups and the actual
character-lattice torus, and let `nᵢ = n_{αᵢ}(1)` be the pinned Weyl representative of a simple
root. For every element `w` of the Weyl subgroup generated by the torus and the `nᵢ`,

```text
(B nᵢ B) (B w B) ⊆ B nᵢ w B ∪ B w B,
```

and if `w⁻¹ αᵢ` is a positive root then `(B nᵢ B) (B w B) ⊆ B nᵢ w B`. This is the
multiplication axiom of a Tits system with `B` and the Weyl subgroup. Here `w⁻¹ αᵢ` is computed
from the Weyl projection of `w`; the projection is not assumed injective on cosets of the torus.

The proof is Steinberg's. First `nᵢ B ⊆ B nᵢ Xᵢ`, where `Xᵢ` is the root subgroup of `αᵢ`:
every positive point is a product `q x` with `q` generated by the positive root subgroups other
than `Xᵢ`, which `nᵢ` permutes, and `x ∈ Xᵢ`. If `w⁻¹ αᵢ` is positive then `w⁻¹ Xᵢ w ⊆ B`.
Otherwise `nᵢ x nᵢ` is collected by the rank-one Bruhat forms of the pair `X_{±αᵢ}`, and the
positive case applies to `nᵢ⁻¹ w`.

The factorization of the positive points is transported from the punctured-positive
factorization `TauCeti.DynkinType.mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul` on
the admissible lattice, which is proved for simply-laced types. This is the only use of the
hypothesis `t.IsSimplyLaced`. The other ingredients, the Weyl-lift conjugation
`ChevalleyDatum.exists_unit_conj_rootSubgroupPoints` and the rank-one Bruhat forms
`ChevalleyDatum.mem_closure_simpleRootPair_iff`, hold in every type. The factorization and the
inclusion `nᵢ B ⊆ B nᵢ Xᵢ` hold over every commutative ring. No Bruhat decomposition of the
whole point group and no generation of all scheme points is asserted.

## Main results

* `ChevalleyDatum.exists_weylElement_mul_eq_mul_weylElement_mul_rootSubgroupPoints`:
  `nᵢ B ⊆ B nᵢ Xᵢ`.
* `ChevalleyDatum.doubleCoset_weylElement_mul_doubleCoset_subset_of_mem_posRoots`: the case
  where `w⁻¹ αᵢ` is positive.
* `ChevalleyDatum.doubleCoset_weylElement_mul_doubleCoset_subset_union`: the multiplication
  axiom.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17 and the proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, Chapter 8.
-/

public section

open DoubleCoset Multiplicative
open scoped Pointwise

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

section Ring

variable (A : Type v) [CommRing A]

/-- The simple Weyl representative `nᵢ` conjugates the punctured positive subgroup into itself,
since the simple reflection `sᵢ` permutes the positive roots other than `αᵢ`. -/
private theorem weylElement_mul_mul_inv_mem_iSup (i : Fin t.rank) {q : D.points A}
    (hq : q ∈ ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
      {t.simpleIndex ht i}, (D.rootSubgroupPoints γ A).range) :
    D.weylElement (t.simpleIndex ht i) A 1 * q * (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ ∈
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ A).range := by
  let n := D.weylElement (t.simpleIndex ht i) A 1
  let Q := ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (D.rootSubgroupPoints γ A).range
  have hle : Q ≤ Q.comap (MulAut.conj n).toMonoidHom := by
    refine iSup₂_le fun γ hγ => ?_
    rintro _ ⟨u, rfl⟩
    have hperm := (reflectionPerm_mem_posRoots_diff_singleton_iff (t.rationalRootSystem ht)
      (t.rationalBase ht) (simpleIndex_mem_support i) γ).mpr hγ
    rw [reflectionPerm_rationalRootSystem] at hperm
    simp only [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    rw [← ofAdd_toAdd u, D.weylElement_conj_rootSubgroupPoints]
    exact Subgroup.mem_iSup_of_mem _ (Subgroup.mem_iSup_of_mem hperm ⟨_, rfl⟩)
  simpa only [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using hle hq

/-- In a simply-laced type, `nᵢ B ⊆ B nᵢ Xᵢ` for the Borel-type subgroup `B` and the root
subgroup `Xᵢ` of the simple root `αᵢ`, over every commutative ring. Multiplying by `B` on the
left gives `B nᵢ B = B nᵢ Xᵢ`. -/
theorem exists_weylElement_mul_eq_mul_weylElement_mul_rootSubgroupPoints
    (hs : t.IsSimplyLaced) (i : Fin t.rank) {b : D.points A} (hb : b ∈ D.borelSubgroup A) :
    ∃ c ∈ D.borelSubgroup A, ∃ u : A,
      D.weylElement (t.simpleIndex ht i) A 1 * b =
        c * D.weylElement (t.simpleIndex ht i) A 1 *
          D.rootSubgroupPoints (t.simpleIndex ht i) A (ofAdd u) := by
  let n := D.weylElement (t.simpleIndex ht i) A 1
  let T := D.torusPoints A
  obtain ⟨p, hp, s, rfl⟩ := (D.mem_borelSubgroup_iff A).mp hb
  obtain ⟨q, hq, a, rfl⟩ := (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints A hs i).mp hp
  -- Move the torus point to the left of `xᵢ(a)`, then conjugate `q` and the torus point by `n`.
  have hx := D.torusPoints_conj_rootSubgroupPoints (t.simpleIndex ht i) A s⁻¹ a
  have hT : n * T s * n⁻¹ ∈ T.range :=
    (Subgroup.mem_normalizer_iff.mp (D.weylElement_mem_normalizer_range_torusPoints i A)
      (T s)).mp ⟨s, rfl⟩
  refine ⟨n * q * n⁻¹ * (n * T s * n⁻¹), mul_mem ?_ ?_,
    (torusCharacter s⁻¹ (D.coordinateRoot (t.simpleIndex ht i)) : A) * a, ?_⟩
  · exact D.positivePoints_le_borelSubgroup A <|
      (D.mem_positivePoints_iff_exists_mul_rootSubgroupPoints A hs i).mpr
        ⟨_, D.weylElement_mul_mul_inv_mem_iSup A i hq, 0, by simp [n]⟩
  · exact D.range_torusPoints_le_borelSubgroup A hT
  · rw [← hx, map_inv]
    simp only [n, T]
    group

end Ring

section Field

variable (K : Type v) [Field K]

/-- Reduce the product of double cosets to the elements `nᵢ xᵢ(a) w`. -/
private theorem doubleCoset_weylElement_mul_doubleCoset_subset_of_forall (hs : t.IsSimplyLaced)
    (i : Fin t.rank) (w : D.points K) {Z : Set (D.points K)}
    (hZ : ∀ b ∈ D.borelSubgroup K, ∀ z ∈ Z, ∀ b' ∈ D.borelSubgroup K, b * z * b' ∈ Z)
    (h : ∀ a : K, D.weylElement (t.simpleIndex ht i) K 1 *
      D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) * w ∈ Z) :
    doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) *
      doubleCoset w (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) ⊆ Z := by
  intro g hg
  obtain ⟨y, hy, z, hz, rfl⟩ := Set.mem_mul.mp hg
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := mem_doubleCoset.mp hy
  obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := mem_doubleCoset.mp hz
  obtain ⟨c, hc, a, he⟩ := D.exists_weylElement_mul_eq_mul_weylElement_mul_rootSubgroupPoints K
    hs i (mul_mem hb₂ hb₃)
  have heq : b₁ * D.weylElement (t.simpleIndex ht i) K 1 * b₂ * (b₃ * w * b₄) =
      b₁ * c * (D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) * w) * b₄ := by
    calc
      _ = b₁ * (D.weylElement (t.simpleIndex ht i) K 1 * (b₂ * b₃)) * w * b₄ := by group
      _ = _ := by rw [he]; group
  rw [heq]
  exact hZ _ (mul_mem hb₁ hc) _ (h a) _ hb₄

/-- If `w⁻¹ αᵢ` is positive, then `nᵢ xᵢ(a) w ∈ B nᵢ w B`. -/
private theorem weylElement_mul_rootSubgroupPoints_mul_mem_of_mem_posRoots (i : Fin t.rank)
    (w : D.weylSubgroup K)
    (hw : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K w)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (a : K) :
    D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) * (w : D.points K) ∈
      doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * w)
        (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) := by
  have hconj := D.mul_rootSubgroupPoints_mul_inv_mem_positivePoints K w⁻¹
    (γ := t.simpleIndex ht i) (by rw [map_inv]; exact hw) a
  refine mem_doubleCoset.mpr ⟨1, one_mem _, _, D.positivePoints_le_borelSubgroup K hconj, ?_⟩
  simp only [Subgroup.coe_inv, inv_inv]
  group

/-- **Steinberg's multiplication lemma, positive case.** If `w` lies in the Weyl subgroup and
`w⁻¹ αᵢ` is a positive root, then `(B nᵢ B) (B w B) ⊆ B nᵢ w B`. -/
theorem doubleCoset_weylElement_mul_doubleCoset_subset_of_mem_posRoots (hs : t.IsSimplyLaced)
    (i : Fin t.rank) (w : D.weylSubgroup K)
    (hw : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K w)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) *
      doubleCoset (w : D.points K) (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) ⊆
      doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * w)
        (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) :=
  D.doubleCoset_weylElement_mul_doubleCoset_subset_of_forall K hs i w
    (fun _ hb _ hz _ hb' => doubleCoset_eq_of_mem hz ▸ mem_doubleCoset.mpr ⟨_, hb, _, hb', rfl⟩)
    (D.weylElement_mul_rootSubgroupPoints_mul_mem_of_mem_posRoots K i w hw)

/-- If `w⁻¹ αᵢ` is negative, then `w⁻¹ nᵢ` sends `αᵢ` to its negative, a positive root. -/
private theorem weylGroupToPerm_weylProjection_inv_mul_weylElement_mem_posRoots (i : Fin t.rank)
    (w : D.weylSubgroup K)
    (hw : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K w)⁻¹
      (t.simpleIndex ht i) ∉ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    (t.simplyConnectedRootDatum ht).weylGroupToPerm
        (D.weylProjection K (w⁻¹ * ⟨_, D.weylElement_mem_weylSubgroup K i⟩))
        (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
  have hneg := RootPairing.weylGroupToPerm_neg (t.simplyConnectedRootDatum ht)
    (D.weylProjection K w)⁻¹ (t.simpleIndex ht i)
  simp only [RootPairing.indexNeg_neg] at hneg
  rw [map_mul, map_inv, D.weylProjection_weylElement,
    RootPairing.weylGroupToPerm_mul_ofIdx_apply, hneg, ← reflectionPerm_rationalRootSystem]
  exact (reflectionPerm_self_mem_posRoots_iff_mem_negRoots _ _ _).mpr
    ((not_mem_posRoots_iff_mem_negRoots _ _ _).mp hw)

/-- If `w⁻¹ αᵢ` is negative, then `nᵢ xᵢ(a) w` lies in `B nᵢ w B ∪ B w B`. -/
private theorem weylElement_mul_rootSubgroupPoints_mul_mem_of_not_mem_posRoots (i : Fin t.rank)
    (w : D.weylSubgroup K)
    (hw : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K w)⁻¹
      (t.simpleIndex ht i) ∉ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (a : K) :
    D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) * (w : D.points K) ∈
      doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * w)
          (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) ∪
        doubleCoset (w : D.points K) (D.borelSubgroup K : Set (D.points K))
          (D.borelSubgroup K) := by
  let n := D.weylElement (t.simpleIndex ht i) K 1
  let x := D.rootSubgroupPoints (t.simpleIndex ht i) K
  let h := D.simpleCorootPoints i K
  let B := D.borelSubgroup K
  have hxB (b : K) : x (ofAdd b) ∈ B :=
    D.positivePoints_le_borelSubgroup K
      (D.rootSubgroupPoints_mem_positivePoints K (simpleIndex_mem_posRoots i) _)
  have hhB (s : Kˣ) : h s ∈ B := by
    simpa only [h, D.simpleCorootPoints_eq_torusPoints] using
      D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  -- `nᵢ xᵢ(a) nᵢ` lies in the rank-one group of the pair `X_{±αᵢ}`, so it has a Bruhat form.
  have hn : n ∈ Subgroup.closure (Set.range x ∪ Set.range (D.rootSubgroupPoints
      ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
        (t.simpleIndex ht i)) K)) := by
    rw [D.closure_simpleRootPair_eq]
    exact Subgroup.subset_closure (Or.inr rfl)
  have hnxn := mul_mem (mul_mem hn (Subgroup.subset_closure (Or.inl ⟨ofAdd a, rfl⟩))) hn
  rcases (D.mem_closure_simpleRootPair_iff i K _).mp hnxn with ⟨a', s, he⟩ | ⟨a', s, b, he⟩
  · -- `nᵢ xᵢ(a) w = xᵢ(a') h(s) (nᵢ²)⁻¹ (nᵢ w)` with `nᵢ² = h(-1)` in the torus.
    refine Or.inl (mem_doubleCoset.mpr ⟨x (ofAdd a') * h s * (h (-1))⁻¹,
      mul_mem (mul_mem (hxB a') (hhB s)) (inv_mem (hhB (-1))), 1, one_mem _, ?_⟩)
    have hsq : n * n = h (-1) := D.weylElement_mul_self i K
    calc
      n * x (ofAdd a) * (w : D.points K) = (n * x (ofAdd a) * n) * (n * n)⁻¹ * (n * w) := by
        group
      _ = _ := by rw [he, hsq]; simp only [x, h, n, mul_one]
  · -- Otherwise `nᵢ xᵢ(a) w = xᵢ(a') h(s) w (g xᵢ(b) g⁻¹)` with `g = w⁻¹ nᵢ`, and `g αᵢ`
    -- is the negative of the root `w⁻¹ αᵢ`, hence positive.
    let g : D.weylSubgroup K := w⁻¹ * ⟨n, D.weylElement_mem_weylSubgroup K i⟩
    have hg := D.weylGroupToPerm_weylProjection_inv_mul_weylElement_mem_posRoots K i w hw
    have hconj := D.mul_rootSubgroupPoints_mul_inv_mem_positivePoints K g hg b
    refine Or.inr (mem_doubleCoset.mpr ⟨x (ofAdd a') * h s, mul_mem (hxB a') (hhB s), _,
      D.positivePoints_le_borelSubgroup K hconj, ?_⟩)
    calc
      n * x (ofAdd a) * (w : D.points K) = (n * x (ofAdd a) * n) * n⁻¹ * w := by group
      _ = _ := by rw [he]; simp only [g, x, h, n, Subgroup.coe_mul, Subgroup.coe_inv]; group

/-- **Steinberg's multiplication lemma.** For every element `w` of the Weyl subgroup of a
simply-laced Chevalley datum over a field, `(B nᵢ B) (B w B) ⊆ B nᵢ w B ∪ B w B`, where `B` is
the Borel-type subgroup and `nᵢ` the pinned representative of the simple reflection `sᵢ`. This is
the multiplication axiom of a Tits system. -/
theorem doubleCoset_weylElement_mul_doubleCoset_subset_union (hs : t.IsSimplyLaced)
    (i : Fin t.rank) (w : D.weylSubgroup K) :
    doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) *
      doubleCoset (w : D.points K) (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) ⊆
      doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * w)
          (D.borelSubgroup K : Set (D.points K)) (D.borelSubgroup K) ∪
        doubleCoset (w : D.points K) (D.borelSubgroup K : Set (D.points K))
          (D.borelSubgroup K) := by
  refine D.doubleCoset_weylElement_mul_doubleCoset_subset_of_forall K hs i w ?_ fun a => ?_
  · rintro b hb z (hz | hz) b' hb' <;>
      [left; right] <;>
      exact doubleCoset_eq_of_mem hz ▸ mem_doubleCoset.mpr ⟨_, hb, _, hb', rfl⟩
  · by_cases hw : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K w)⁻¹
        (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)
    · exact Or.inl (D.weylElement_mul_rootSubgroupPoints_mul_mem_of_mem_posRoots K i w hw a)
    · exact D.weylElement_mul_rootSubgroupPoints_mul_mem_of_not_mem_posRoots K i w hw a

end Field

end TauCeti.DynkinType.ChevalleyDatum
