/-!
# Simple-reflection Bruhat double-coset multiplication

For a Chevalley datum `D` of any valid Dynkin type over any field `K`, let `B = D.borelSubgroup K`
be the Borel-type subgroup generated by the positive root subgroups and the actual character-lattice
torus, let `N = D.weylSubgroup K` be the Weyl subgroup, and let `nᵢ` be the `i`-th pinned simple
Weyl representative.

This file proves the two double-coset multiplication laws for `B`-double cosets in `D.points K`:

* `TauCeti.DynkinType.ChevalleyDatum.doubleCoset_weylElement_mul_subset_of_mem_posRoots`:
  when `w⁻¹(αᵢ)` is positive (where `w = D.weylProjection K n`), `(B nᵢ B)(B n B) ⊆ B (nᵢ n) B`.
* `TauCeti.DynkinType.ChevalleyDatum.doubleCoset_weylElement_mul_subset_union`:
  unconditionally, `(B nᵢ B)(B n B) ⊆ B (nᵢ n) B ∪ B n B`.

Both laws factor an element of `B` through the punctured positive subgroup omitting `αᵢ` and the
`i`-th simple root subgroup, conjugate the torus and punctured positive parts past `nᵢ` into `B`,
and either push the remaining simple-root factor across `n` when `w⁻¹(αᵢ) > 0` or apply the
rank-one exchange identity `weylElement_mul_rootSubgroup_mul_weylElement` when `w⁻¹(αᵢ) < 0`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §8.2.
* J. E. Humphreys, *Linear Algebraic Groups*, §29.2.
-/

public section

open Multiplicative TensorProduct
open scoped Pointwise
open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

noncomputable section

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (K : Type v) [Field K]

-- Match the integral algebra scalar action used by the Kostant root-subgroup formulas.
attribute [local instance high] Ring.toIntAlgebra
attribute [local instance high] Algebra.toModule

/-- A simple Weyl representative stabilizes the punctured positive subgroup obtained by omitting
its simple root. -/
private theorem map_posRoots_diff_singleton_conj_weylElement (i : Fin t.rank) :
    (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ K).range).map
      (MulAut.conj (D.weylElement (t.simpleIndex ht i) K 1)).toMonoidHom =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ K).range := by
  have hconj := D.map_iSup_rootSubgroupPoints_conj K
    ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩
    (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
  have himg : (t.simplyConnectedRootDatum ht).weylGroupToPerm
      (D.weylProjection K
        ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩) ''
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}) =
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i} := by
    rw [D.weylProjection_weylElement]
    calc
      (t.simplyConnectedRootDatum ht).weylGroupToPerm
          (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) ''
        (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
        = (t.rationalRootSystem ht).reflectionPerm (t.simpleIndex ht i) ''
            (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}) :=
          Set.image_congr fun γ _ => by
            rw [RootPairing.weylGroupToPerm_ofIdx_apply, ← t.reflectionPerm_rationalRootSystem ht]
      _ = posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i} :=
          image_reflectionPerm_posRoots_diff_singleton
            (t.rationalRootSystem ht) (t.rationalBase ht) (t.simpleIndex_mem_support i)
  simpa only [himg] using hconj

/-- Every element of `D.positivePoints K` factors as an element of the punctured positive subgroup
omitting `αᵢ` times an element of the `i`-th simple root subgroup. -/
private theorem exists_posRoots_diff_singleton_mul_of_mem_positivePoints (i : Fin t.rank)
    {u : D.points K} (hu : u ∈ D.positivePoints K) :
    ∃ q ∈ ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ K).range,
      ∃ a : K, u = q * D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) := by
  obtain ⟨v, hv, hvu⟩ := D.mem_positivePoints_iff.mp hu
  rw [D.positiveSubgroup_eq_iSup] at hv
  obtain ⟨q₀, hq₀, a, hvqa⟩ :=
    (DynkinType.mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul
      D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator i (CommAlgCat.of ℤ K) v).mp hv
  let m := Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange K)).toMulEquiv.toMonoidHom
  let U_i : Subgroup (D.points K) :=
    ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
      (D.rootSubgroupPoints γ K).range
  have hmap_Ui :
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ K)).range).map m =
      U_i.map (D.points K).subtype := by
    simp only [U_i, Subgroup.map_iSup, MonoidHom.map_range]
    refine iSup_congr fun γ => iSup_congr fun _ => congrArg MonoidHom.range ?_
    exact MonoidHom.ext fun x => (D.coe_rootSubgroupPoints γ K x).symm
  have hmq₀ : m q₀ ∈ U_i.map (D.points K).subtype := by
    rw [← hmap_Ui]
    exact ⟨q₀, hq₀, rfl⟩
  obtain ⟨q, hq, hq_eq⟩ := hmq₀
  refine ⟨q, hq, toAdd a, Subtype.ext ?_⟩
  rw [ofAdd_toAdd, Subgroup.coe_mul, ← hvu, hvqa, map_mul, D.coe_rootSubgroupPoints]
  exact congrArg (· * _) hq_eq.symm

/-- Moving a simple Weyl representative past a Borel element leaves a Borel element on the left
and a single simple-root element on the right. -/
private theorem exists_weylElement_mul_borelSubgroup (i : Fin t.rank) {b : D.points K}
    (hb : b ∈ D.borelSubgroup K) :
    ∃ b' ∈ D.borelSubgroup K, ∃ a : K,
      D.weylElement (t.simpleIndex ht i) K 1 * b =
        b' * D.weylElement (t.simpleIndex ht i) K 1 *
          D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) := by
  obtain ⟨u, hu, s, rfl⟩ := (D.mem_borelSubgroup_iff K).mp hb
  let u' : D.points K := (D.torusPoints K s)⁻¹ * u * D.torusPoints K s
  have hu' : u' ∈ D.positivePoints K :=
    (Subgroup.mem_normalizer_iff''.mp
      (D.range_torusPoints_le_normalizer_positivePoints K ⟨s, rfl⟩) u).mp hu
  obtain ⟨q, hq, a, hu'_eq⟩ :=
    D.exists_posRoots_diff_singleton_mul_of_mem_positivePoints K i hu'
  let n_i := D.weylElement (t.simpleIndex ht i) K 1
  have hnt : n_i * D.torusPoints K s * n_i⁻¹ ∈ D.borelSubgroup K := by
    rw [D.weylElement_conj_torusPoints]
    exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  have hnq : n_i * q * n_i⁻¹ ∈ D.borelSubgroup K := by
    have hmem : n_i * q * n_i⁻¹ ∈
        ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ K).range := by
      rw [← D.map_posRoots_diff_singleton_conj_weylElement K i]
      exact ⟨q, hq, rfl⟩
    have hUi_le :
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (D.rootSubgroupPoints γ K).range) ≤ D.positivePoints K :=
      iSup₂_le fun γ hγ => by
        rintro _ ⟨x, rfl⟩
        exact D.rootSubgroupPoints_mem_positivePoints K hγ.1 x
    exact D.positivePoints_le_borelSubgroup K (hUi_le hmem)
  refine ⟨(n_i * D.torusPoints K s * n_i⁻¹) * (n_i * q * n_i⁻¹),
    (D.borelSubgroup K).mul_mem hnt hnq, a, ?_⟩
  have hu_eq : u * D.torusPoints K s = D.torusPoints K s * u' := by
    simp only [u']
    group
  dsimp only [n_i]
  rw [hu_eq, hu'_eq]
  group

/-- **Length-increasing simple-reflection Bruhat cell multiplication.** When the inverse Weyl
projection of `n` keeps the `i`-th simple root positive, `(B nᵢ B)(B n B) ⊆ B (nᵢ n) B`. -/
theorem doubleCoset_weylElement_mul_subset_of_mem_posRoots (i : Fin t.rank)
    (n : D.weylSubgroup K)
    (hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
        (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K) (D.borelSubgroup K) *
      DoubleCoset.doubleCoset (n : D.points K)
        (D.borelSubgroup K) (D.borelSubgroup K) ⊆
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * (n : D.points K))
        (D.borelSubgroup K) (D.borelSubgroup K) := by
  rintro z ⟨_, hz₁, _, hz₂, rfl⟩
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hz₁
  obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hz₂
  obtain ⟨b', hb', a, hmove⟩ :=
    D.exists_weylElement_mul_borelSubgroup K i ((D.borelSubgroup K).mul_mem hb₂ hb₃)
  let x := D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a)
  have hconj : (n : D.points K)⁻¹ * x * (n : D.points K) ∈ D.borelSubgroup K := by
    have hmem : (n : D.points K)⁻¹ * x * (n : D.points K) ∈
        (D.rootSubgroupPoints
          ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
            (t.simpleIndex ht i)) K).range := by
      rw [← map_inv, ← D.map_range_rootSubgroupPoints_conj K n⁻¹ (t.simpleIndex ht i)]
      exact ⟨x, ⟨ofAdd a, rfl⟩, by simp⟩
    obtain ⟨u, hu⟩ := hmem
    rw [← hu]
    exact D.positivePoints_le_borelSubgroup K (D.rootSubgroupPoints_mem_positivePoints K hpos u)
  refine DoubleCoset.mem_doubleCoset.mpr ⟨b₁ * b', (D.borelSubgroup K).mul_mem hb₁ hb',
    ((n : D.points K)⁻¹ * x * (n : D.points K)) * b₄,
    (D.borelSubgroup K).mul_mem hconj hb₄, ?_⟩
  calc
    b₁ * D.weylElement (t.simpleIndex ht i) K 1 * b₂ * (b₃ * (n : D.points K) * b₄)
      = b₁ * (D.weylElement (t.simpleIndex ht i) K 1 * (b₂ * b₃)) * (n : D.points K) * b₄ := by
        group
    _ = b₁ * (b' * D.weylElement (t.simpleIndex ht i) K 1 * x) * (n : D.points K) * b₄ := by
        rw [hmove]
    _ = b₁ * b' * (D.weylElement (t.simpleIndex ht i) K 1 * (n : D.points K)) *
          ((n : D.points K)⁻¹ * x * (n : D.points K) * b₄) := by
        group

/-- Rank-one exchange step: when `w⁻¹(-αᵢ)` is positive and `u ≠ 0`, `nᵢ x_i(u) n` lies in
`B n B`. -/
private theorem weylElement_mul_rootSubgroup_mul_mem_doubleCoset (i : Fin t.rank)
    (n : D.weylSubgroup K) (u : Kˣ)
    (hneg_pos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) (t.simpleIndex ht i)) ∈
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) * (n : D.points K) ∈
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  let c : D.points K :=
    D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (-((u⁻¹ : Kˣ) : K))) *
      D.simpleCorootPoints i K (-u⁻¹)
  let y : D.points K :=
    D.weylElement (t.simpleIndex ht i) K 1 *
      D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (-((u⁻¹ : Kˣ) : K))) *
      (D.weylElement (t.simpleIndex ht i) K 1)⁻¹
  have hcy :
      D.weylElement (t.simpleIndex ht i) K 1 *
          D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) =
        c * y := by
    have hexch := congrArg (· * (D.weylElement (t.simpleIndex ht i) K 1)⁻¹)
      (D.weylElement_mul_rootSubgroup_mul_weylElement i K u)
    dsimp only [c, y]
    simpa only [mul_assoc, mul_inv_cancel, mul_one] using hexch
  have hcB : c ∈ D.borelSubgroup K := by
    apply (D.borelSubgroup K).mul_mem
    · exact D.positivePoints_le_borelSubgroup K (D.rootSubgroupPoints_mem_positivePoints K
        (support_subset_posRoots _ _ (t.simpleIndex_mem_support i)) _)
    · rw [D.simpleCorootPoints_eq_torusPoints]
      exact D.range_torusPoints_le_borelSubgroup K ⟨_, rfl⟩
  have hnyB : (n : D.points K)⁻¹ * y * (n : D.points K) ∈ D.borelSubgroup K := by
    have hy_neg : y ∈ (D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) K).range :=
      ⟨ofAdd _, (D.weylElement_conj_rootSubgroupPoints i (t.simpleIndex ht i) K _).symm⟩
    have hmem : (n : D.points K)⁻¹ * y * (n : D.points K) ∈
        (D.rootSubgroupPoints
          ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
            ((t.simplyConnectedRootDatum ht).reflectionPerm
              (t.simpleIndex ht i) (t.simpleIndex ht i))) K).range := by
      rw [← map_inv, ← D.map_range_rootSubgroupPoints_conj K n⁻¹]
      exact ⟨y, hy_neg, by simp⟩
    obtain ⟨v, hv⟩ := hmem
    rw [← hv]
    exact D.positivePoints_le_borelSubgroup K (D.rootSubgroupPoints_mem_positivePoints K hneg_pos v)
  refine DoubleCoset.mem_doubleCoset.mpr ⟨c, hcB, (n : D.points K)⁻¹ * y * (n : D.points K), hnyB,
    ?_⟩
  calc
    D.weylElement (t.simpleIndex ht i) K 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd (u : K)) * (n : D.points K)
      = c * y * (n : D.points K) := by rw [hcy]
    _ = c * (n : D.points K) * ((n : D.points K)⁻¹ * y * (n : D.points K)) := by group

/-- When a Weyl element sends a root index to a negative root, it sends the opposite root index to
a positive root. -/
private theorem weylGroupToPerm_reflectionPerm_self_mem_posRoots
    (w : (t.simplyConnectedRootDatum ht).weylGroup) (γ : Fin t.numRoots)
    (hnotpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm w γ ∉
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    (t.simplyConnectedRootDatum ht).weylGroupToPerm w
        ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) ∈
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
  have hcomm : (t.simplyConnectedRootDatum ht).weylGroupToPerm w
      ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) =
      (t.simplyConnectedRootDatum ht).reflectionPerm
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm w γ)
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm w γ) := by
    let _ := (t.simplyConnectedRootDatum ht).indexNeg
    simpa only [RootPairing.indexNeg_neg] using
      (t.simplyConnectedRootDatum ht).weylGroupToPerm_neg w γ
  rw [hcomm, ← t.reflectionPerm_rationalRootSystem ht]
  exact (reflectionPerm_self_mem_posRoots_iff_mem_negRoots _ _ _).mpr
    ((not_mem_posRoots_iff_mem_negRoots _ _ _).mp hnotpos)

/-- **Simple-reflection Bruhat cell multiplication.** For every simple reflection and every Weyl
lift `n`, `(B nᵢ B)(B n B) ⊆ B (nᵢ n) B ∪ B n B`. -/
theorem doubleCoset_weylElement_mul_subset_union (i : Fin t.rank) (n : D.weylSubgroup K) :
    DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1)
        (D.borelSubgroup K) (D.borelSubgroup K) *
      DoubleCoset.doubleCoset (n : D.points K)
        (D.borelSubgroup K) (D.borelSubgroup K) ⊆
      DoubleCoset.doubleCoset (D.weylElement (t.simpleIndex ht i) K 1 * (n : D.points K))
          (D.borelSubgroup K) (D.borelSubgroup K) ∪
        DoubleCoset.doubleCoset (n : D.points K)
          (D.borelSubgroup K) (D.borelSubgroup K) := by
  by_cases hpos : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹
      (t.simpleIndex ht i) ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)
  · exact (D.doubleCoset_weylElement_mul_subset_of_mem_posRoots K i n hpos).trans
      Set.subset_union_left
  · have hneg_pos := weylGroupToPerm_reflectionPerm_self_mem_posRoots (ht := ht)
      (D.weylProjection K n)⁻¹ (t.simpleIndex ht i) hpos
    rintro z ⟨_, hz₁, _, hz₂, rfl⟩
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hz₁
    obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hz₂
    obtain ⟨b', hb', a, hmove⟩ :=
      D.exists_weylElement_mul_borelSubgroup K i ((D.borelSubgroup K).mul_mem hb₂ hb₃)
    by_cases ha : a = 0
    · left
      refine DoubleCoset.mem_doubleCoset.mpr
        ⟨b₁ * b', (D.borelSubgroup K).mul_mem hb₁ hb', b₄, hb₄, ?_⟩
      calc
        b₁ * D.weylElement (t.simpleIndex ht i) K 1 * b₂ * (b₃ * (n : D.points K) * b₄)
          = b₁ * (D.weylElement (t.simpleIndex ht i) K 1 * (b₂ * b₃)) * (n : D.points K) * b₄ := by
            group
        _ = b₁ * (b' * D.weylElement (t.simpleIndex ht i) K 1 *
              D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd 0)) * (n : D.points K) * b₄ := by
            rw [hmove, ha]
        _ = b₁ * b' * (D.weylElement (t.simpleIndex ht i) K 1 * (n : D.points K)) * b₄ := by
            rw [ofAdd_zero, map_one, mul_one]
            group
    · right
      obtain ⟨c₁, hc₁, c₂, hc₂, heq⟩ := DoubleCoset.mem_doubleCoset.mp
        (D.weylElement_mul_rootSubgroup_mul_mem_doubleCoset K i n (Units.mk0 a ha) hneg_pos)
      refine DoubleCoset.mem_doubleCoset.mpr
        ⟨b₁ * b' * c₁, (D.borelSubgroup K).mul_mem ((D.borelSubgroup K).mul_mem hb₁ hb') hc₁,
          c₂ * b₄, (D.borelSubgroup K).mul_mem hc₂ hb₄, ?_⟩
      calc
        b₁ * D.weylElement (t.simpleIndex ht i) K 1 * b₂ * (b₃ * (n : D.points K) * b₄)
          = b₁ * (D.weylElement (t.simpleIndex ht i) K 1 * (b₂ * b₃)) * (n : D.points K) * b₄ := by
            group
        _ = b₁ * b' * (D.weylElement (t.simpleIndex ht i) K 1 *
              D.rootSubgroupPoints (t.simpleIndex ht i) K (ofAdd a) * (n : D.points K)) * b₄ := by
            rw [hmove]
            group
        _ = b₁ * b' * (c₁ * (n : D.points K) * c₂) * b₄ := by rw [← Units.val_mk0 ha, heq]
        _ = b₁ * b' * c₁ * (n : D.points K) * (c₂ * b₄) := by group

end

end TauCeti.DynkinType.ChevalleyDatum
