module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Coroot
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.RootSubgroup
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Torus

/-!
# Generating the torus of a Chevalley datum by simple root subgroups

The actual torus of a Chevalley datum has character lattice `Λ(D)`, which may be a proper
sublattice of the full weight lattice `P`. Each simple coroot is a word in the positive and
negative simple root subgroups. Their products reach the image of `Hom(P, Aˣ)` in
`Hom(Λ(D), Aˣ)`. When the units of `A` are divisible, restriction is surjective, so every
point of the actual torus is generated by the simple root subgroups.

Consequently, over an algebraically closed field the subgroup generated by all root subgroups
and the actual torus equals the subgroup generated by the positive and negative simple root
subgroups. This does not assert that either subgroup contains all points of the group scheme;
that requires the geometric point-generation theorem. Over a general field the torus cannot
be removed: in the adjoint form of type A₁ over `ℚ`, the image of the full-weight torus misses
the class of `diag(2, 1)`.

The root-word identity is `ChevalleyDatum.coe_simpleCorootPoints_eq_root_word`, and extension
of characters is `ChevalleyDatum.fullWeightTorusRestriction_surjective`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19 and 28(c).
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type*) [CommRing A]

/-- Restricting a full-weight torus parameter and evaluating the actual torus gives the product
of the simple coroot values in increasing node order. No divisibility of the units is needed. -/
theorem torusPoints_fullWeightTorusRestriction (s : Fin t.rank → Aˣ) :
    D.torusPoints A (D.fullWeightTorusRestriction A s) =
      (List.ofFn fun i => D.simpleCorootPoints i A (s i)).prod := by
  have hp : D.fullWeightTorusRestriction A s =
      (List.ofFn fun i => D.simpleCorootParameter i A (s i)).prod := by
    ext j
    simp [List.prod_ofFn, fullWeightTorusRestriction_apply, simpleCorootParameter_apply,
      torusCharacter_def]
  simp only [hp, map_list_prod, List.map_ofFn, Function.comp_def,
    simpleCorootPoints_eq_torusPoints]

/-- A simple coroot value belongs to the subgroup generated by the positive and negative
simple root subgroups, over every commutative ring. -/
theorem simpleCorootPoints_mem_closure_rootSubgroup (i : Fin t.rank) (s : Aˣ) :
    D.simpleCorootPoints i A s ∈ Subgroup.closure (⋃ j : Fin t.rank,
      Set.range (D.rootSubgroup (t.simpleIndex ht j) A) ∪
        Set.range (D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht j) (t.simpleIndex ht j)) A)) := by
  let H := Subgroup.closure (⋃ j : Fin t.rank,
    Set.range (D.rootSubgroup (t.simpleIndex ht j) A) ∪
      Set.range (D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht j) (t.simpleIndex ht j)) A))
  have hpos (u : A) : D.rootSubgroup (t.simpleIndex ht i) A (Multiplicative.ofAdd u) ∈ H :=
    Subgroup.subset_closure (Set.mem_iUnion.2 ⟨i, Or.inl ⟨_, rfl⟩⟩)
  have hneg (u : A) : D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm
      (t.simpleIndex ht i) (t.simpleIndex ht i)) A (Multiplicative.ofAdd u) ∈ H :=
    Subgroup.subset_closure (Set.mem_iUnion.2 ⟨i, Or.inr ⟨_, rfl⟩⟩)
  have hword : D.simpleCorootPoints i A s =
      D.weylElement (t.simpleIndex ht i) A s *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ := by
    apply Subtype.ext
    rw [D.coe_simpleCorootPoints_eq_root_word]
    simp [weylElement_def]
  rw [hword]
  simp only [weylElement_def, inv_one, Units.val_one]
  exact H.mul_mem (H.mul_mem (H.mul_mem (hpos s) (hneg _)) (hpos s))
    (H.inv_mem (H.mul_mem (H.mul_mem (hpos 1) (hneg _)) (hpos 1)))

/-- If the units are divisible, every point of the actual torus belongs to the subgroup
generated by the positive and negative simple root subgroups. This applies in particular to
algebraically closed fields, even for a proper weight lattice. -/
theorem torusPoints_mem_closure_rootSubgroup [RootableBy Aˣ ℕ] (s : Fin t.rank → Aˣ) :
    D.torusPoints A s ∈ Subgroup.closure (⋃ i : Fin t.rank,
      Set.range (D.rootSubgroup (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) := by
  obtain ⟨u, rfl⟩ := D.fullWeightTorusRestriction_surjective A s
  rw [D.torusPoints_fullWeightTorusRestriction]
  apply Subgroup.list_prod_mem
  simp only [List.mem_ofFn, forall_exists_index, forall_apply_eq_imp_iff]
  exact fun i => D.simpleCorootPoints_mem_closure_rootSubgroup A i (u i)

/-- With divisible units, adjoining all roots and the actual torus gives the same subgroup
as the positive and negative simple root subgroups. This is equality of generated subgroups,
not a point-generation theorem for the ambient group scheme. -/
theorem closure_rootSubgroup_union_range_torusPoints [RootableBy Aˣ ℕ] :
    Subgroup.closure ((⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroup γ A)) ∪
        Set.range (D.torusPoints A)) =
      Subgroup.closure (⋃ i : Fin t.rank,
        Set.range (D.rootSubgroup (t.simpleIndex ht i) A) ∪
          Set.range (D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm
            (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) := by
  apply le_antisymm
  · refine (Subgroup.closure_le _).2 ?_
    rintro g (hg | ⟨s, rfl⟩)
    · obtain ⟨γ, u, rfl⟩ := Set.mem_iUnion.1 hg
      exact D.rootSubgroup_mem_closure γ A u
    · exact D.torusPoints_mem_closure_rootSubgroup A s
  · apply Subgroup.closure_mono
    rintro g hg
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hg
    exact Or.inl (hi.elim
      (fun ⟨u, hu⟩ => Set.mem_iUnion.2 ⟨_, u, hu⟩)
      (fun ⟨u, hu⟩ => Set.mem_iUnion.2 ⟨_, u, hu⟩))

end

end TauCeti.DynkinType.ChevalleyDatum
