module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Coroot
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Root.Subgroup
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Torus.Basic
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Torus.Coroot

/-!
# Generating the torus of a Chevalley datum by simple root subgroups

The actual torus of a Chevalley datum has character lattice `Λ(D)`, which may be a proper
sublattice of the full weight lattice `P`. Each simple coroot is a word in the positive and
negative simple root subgroups. Their products reach the image of `Hom(P, Aˣ)` in
`Hom(Λ(D), Aˣ)`. Whenever `ChevalleyDatum.fullWeightTorusRestriction` is surjective, every
point of the actual torus is generated by the simple root subgroups. This holds for full-weight
data over every commutative ring, and for arbitrary data when the units of `A` are divisible.

Consequently, over an algebraically closed field the subgroup generated by all root subgroups
and the actual torus equals the subgroup generated by the positive and negative simple root
subgroups. This does not assert that either subgroup contains all points of the group scheme;
that requires the geometric point-generation theorem. Over a general field the torus cannot
be removed: in the adjoint form of type A₁ over `ℚ`, the image of the full-weight torus misses
the class of `diag(2, 1)`.

The group-level root-word identity is `ChevalleyDatum.simpleCorootPoints_eq_weylElement_mul_inv`.
Torus membership transports `kostantTorusSubgroup_le_kostantElementarySubgroup` through
`ChevalleyDatum.kostantTorusMatrix_weight` on the image of full-weight restriction.
`ChevalleyDatum.fullWeightTorusRestriction_surjective` reaches every actual torus parameter
when units are divisible.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19 and 28(c).
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type*) [CommRing A]

/-- The simple coroot value is the product of a simple Weyl element and the inverse of its
value at one, as an equality of datum points over every commutative ring. -/
theorem simpleCorootPoints_eq_weylElement_mul_inv (i : Fin t.rank) (s : Aˣ) :
    D.simpleCorootPoints i A s =
      D.weylElement (t.simpleIndex ht i) A s *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ := by
  apply Subtype.ext
  rw [D.coe_simpleCorootPoints_eq_root_word]
  simp [weylElement_def]

/-- The full-weight torus of a Chevalley datum lies in its Kostant elementary subgroup over
every commutative ring, without any divisibility assumption on the units. -/
theorem kostantTorusSubgroup_weight_le_kostantElementarySubgroup (A : CommAlgCat ℤ) :
    kostantTorusSubgroup D.lattice D.basis D.weight A ≤
      kostantElementarySubgroup (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
        D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator A := by
  exact kostantTorusSubgroup_le_kostantElementarySubgroup
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h D.representation D.lattice
    D.representation_mem_lattice D.isNilpotent_representation_rootGenerator D.basis D.weight
    D.isCartanWeightVector_basis (t.rootGeneratorWeight ht) (t.lie_lieBasis_h_rootGenerator ht)
    Sum.inl Sum.inr D.isSl2Triple_representation_rootGenerator
    (fun i => by ext j; simp only [t.rootGeneratorWeight_inr, t.rootGeneratorWeight_inl,
      Pi.neg_apply]) A

/-- An actual torus point whose parameter extends to the full weight lattice is generated
by the positive and negative simple root subgroups. -/
theorem torusPoints_mem_closure_rootSubgroup_of_mem_range (s : Fin t.rank → Aˣ)
    (hs : s ∈ (D.fullWeightTorusRestriction A).range) :
    D.torusPoints A s ∈ Subgroup.closure (⋃ i : Fin t.rank,
      Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) := by
  rw [← Subgroup.mem_map_iff_mem (D.points A).subtype_injective]
  apply D.map_kostantElementarySubgroup_le_closure_rootSubgroup A
  obtain ⟨u, hu⟩ := hs
  have hu_matrix : kostantTorusMatrix D.lattice D.basis D.weight u =
      kostantTorusMatrix D.lattice D.basis D.coordinateWeight s := by
    rw [D.kostantTorusMatrix_weight, hu]
  have hmem := D.kostantTorusSubgroup_weight_le_kostantElementarySubgroup (CommAlgCat.of ℤ A)
  rw [kostantTorusSubgroup_eq_range] at hmem
  have hu_mem := Subgroup.mem_map_of_mem
    (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMonoidHom)
    (hmem ⟨u, rfl⟩)
  simpa only [Subgroup.coe_subtype, coe_torusPoints, MulEquiv.toMonoidHom_eq_coe,
    basisMatrix_kostantTorusPoints, hu_matrix]
    using hu_mem

/-- If the units are divisible, every point of the actual torus belongs to the subgroup
generated by the positive and negative simple root subgroups. This applies in particular to
algebraically closed fields, even for a proper weight lattice. -/
theorem torusPoints_mem_closure_rootSubgroup [RootableBy Aˣ ℕ] (s : Fin t.rank → Aˣ) :
    D.torusPoints A s ∈ Subgroup.closure (⋃ i : Fin t.rank,
      Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) :=
  D.torusPoints_mem_closure_rootSubgroup_of_mem_range A s
    (D.fullWeightTorusRestriction_surjective A s)

/-- If full-weight restriction is surjective, adjoining all roots and the actual torus gives
the same subgroup as the positive and negative simple root subgroups. This is equality of
generated subgroups, not a point-generation theorem for the ambient group scheme. -/
theorem rootTorusSubgroup_eq_closure_rootSubgroup_of_surjective
    (hs : Function.Surjective (D.fullWeightTorusRestriction A)) :
    D.rootTorusSubgroup A =
      Subgroup.closure (⋃ i : Fin t.rank,
        Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
          Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
            (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) := by
  rw [rootTorusSubgroup_def]
  apply le_antisymm
  · refine (Subgroup.closure_le _).2 ?_
    rintro g (hg | ⟨s, rfl⟩)
    · obtain ⟨γ, u, rfl⟩ := Set.mem_iUnion.1 hg
      exact D.rootSubgroupPoints_mem_closure γ A u
    · exact D.torusPoints_mem_closure_rootSubgroup_of_mem_range A s (hs s)
  · apply Subgroup.closure_mono
    rintro g hg
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hg
    exact Or.inl (hi.elim
      (fun ⟨u, hu⟩ => Set.mem_iUnion.2 ⟨_, u, hu⟩)
      (fun ⟨u, hu⟩ => Set.mem_iUnion.2 ⟨_, u, hu⟩))

/-- With full weight lattice, adjoining all roots and the actual torus gives the same
subgroup as the positive and negative simple root subgroups over every commutative ring. -/
theorem rootTorusSubgroup_eq_closure_rootSubgroup_of_weightLattice_eq_top
    (hD : D.weightLattice = ⊤) :
    D.rootTorusSubgroup A =
      Subgroup.closure (⋃ i : Fin t.rank,
        Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
          Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
            (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) :=
  D.rootTorusSubgroup_eq_closure_rootSubgroup_of_surjective A
    (D.fullWeightTorusRestriction_surjective_of_weightLattice_eq_top A hD)

/-- With divisible units, adjoining all roots and the actual torus gives the same subgroup
as the positive and negative simple root subgroups. This is equality of generated subgroups,
not a point-generation theorem for the ambient group scheme. -/
theorem rootTorusSubgroup_eq_closure_rootSubgroup [RootableBy Aˣ ℕ] :
    D.rootTorusSubgroup A =
      Subgroup.closure (⋃ i : Fin t.rank,
        Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
          Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
            (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) :=
  D.rootTorusSubgroup_eq_closure_rootSubgroup_of_surjective A
    (D.fullWeightTorusRestriction_surjective A)

end

end TauCeti.DynkinType.ChevalleyDatum
