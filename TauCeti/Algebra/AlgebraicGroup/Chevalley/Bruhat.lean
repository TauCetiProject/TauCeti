module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Weyl.Quotient
public import TauCeti.LinearAlgebra.RootSystem.Inversions.Basic
import TauCeti.GroupTheory.TitsSystem.Bruhat.Uniqueness
import TauCeti.LinearAlgebra.RootSystem.Inversions.Exchange
import TauCeti.LinearAlgebra.RootSystem.Inversions.StrongExchange

/-!
# Bruhat decomposition and Steinberg's sharp normal form for a Chevalley datum

Over any field `K`, transporting the Bruhat decomposition of `D.titsSystem K` along the Weyl-group
isomorphism `D.titsSystemWeylGroupEquiv K` decomposes the extended elementary subgroup
`D.extendedElementarySubgroup K` into pairwise disjoint double cosets `D.bruhatCell K w` indexed by
the root-datum Weyl group `(t.simplyConnectedRootDatum ht).weylGroup`, with
`D.bruhatCell K (D.weylProjection K n) = B(K) n B(K)` for every Weyl lift `n ∈ N(K)`.

Within each Bruhat cell `B(K) n B(K)` (with `w = D.weylProjection K n`), Steinberg's sharp normal
form refines the left Borel factor to the inversion subgroup

```text
U_w(K) = ⨆ γ ∈ inversions P b w⁻¹, X_γ(K) = U(K) ∩ n U⁻(K) n⁻¹.
```

Uniqueness of `(u, b) ∈ (n U⁻(A) n⁻¹) × B(A)` in `u * n * b` holds over every commutative ring `A`
because `U⁻(A) ∩ B(A) = 1`. Existence of `(u, b) ∈ U_w(K) × B(K)` is proved by induction on the
inversion count `|inversions P b w⁻¹|`, peeling off a simple root `αᵢ` sent negative by `w⁻¹` via
the rank-one parabolic factorization `U(K) = X_{αᵢ}(K) * U^{αᵢ}(K)` and the normalization of
`U^{αᵢ}(K)` by `nᵢ`. Combining existence and uniqueness identifies
`U(K) ∩ n U⁻(K) n⁻¹ = U_w(K)` and establishes unique factorization on every cell and across
`D.extendedElementarySubgroup K`.

## Main definitions

* `TauCeti.DynkinType.ChevalleyDatum.bruhatCell`: the Bruhat cell `B(K) w B(K) ⊆ D.points K`
  indexed by `w : (t.simplyConnectedRootDatum ht).weylGroup`.
* `TauCeti.DynkinType.ChevalleyDatum.inversionPoints`: the subgroup `U_w(A) ≤ D.points A` generated
  by the positive root subgroups sent negative by `w⁻¹`.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.bruhatCell_weylProjection`,
  `TauCeti.DynkinType.ChevalleyDatum.disjoint_bruhatCell_iff`,
  `TauCeti.DynkinType.ChevalleyDatum.iUnion_bruhatCell`, and
  `TauCeti.DynkinType.ChevalleyDatum.existsUnique_mem_bruhatCell`: the disjoint double-coset Bruhat
  decomposition of `D.extendedElementarySubgroup K`.
* `TauCeti.DynkinType.ChevalleyDatum.positivePoints_inf_map_negativePoints_conj`:
  `D.positivePoints K ⊓ (D.negativePoints K).map (MulAut.conj n) = D.inversionPoints K w`.
* `TauCeti.DynkinType.ChevalleyDatum.existsUnique_mul_mul_eq_of_mem_bruhatCell` and
  `TauCeti.DynkinType.ChevalleyDatum.existsUnique_bruhatNormalForm`: Steinberg's sharp Bruhat
  normal form on each cell and on `D.extendedElementarySubgroup K`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorems 4 and 4'.
* R. W. Carter, *Simple Groups of Lie Type*, §§8.3--8.4.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

section Ring

variable (A : Type v) [CommRing A]

/-- The subgroup `U_w(A) ≤ D.points A` generated by the positive root subgroups whose root indices
are sent negative by `w⁻¹`. -/
noncomputable def inversionPoints (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    Subgroup (D.points A) :=
  ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹,
    (D.rootSubgroupPoints γ A).range

/-- The inversion subgroup at `1` is trivial. -/
@[simp]
theorem inversionPoints_one : D.inversionPoints A 1 = ⊥ := by
  simp [inversionPoints, inversions_one]

/-- Every inversion subgroup is contained in `D.positivePoints A`. -/
theorem inversionPoints_le_positivePoints (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.inversionPoints A w ≤ D.positivePoints A := by
  refine iSup₂_le fun γ hγ => ?_
  have hpos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [t.posRoots_rationalRootSystem ht]
    exact inversions_subset_posRoots _ _ _ hγ
  rintro _ ⟨u, rfl⟩
  exact D.rootSubgroupPoints_mem_positivePoints A hpos u

/-- Over every commutative ring, the factors `u ∈ n U⁻(A) n⁻¹` and `b ∈ B(A)` in `u * n * b` are
uniquely determined by their product. -/
theorem eq_and_eq_of_mem_map_negativePoints_conj_of_mul_eq {n u₁ u₂ b₁ b₂ : D.points A}
    (hu₁ : u₁ ∈ (D.negativePoints A).map (MulAut.conj n).toMonoidHom)
    (hu₂ : u₂ ∈ (D.negativePoints A).map (MulAut.conj n).toMonoidHom)
    (hb₁ : b₁ ∈ D.borelSubgroup A) (hb₂ : b₂ ∈ D.borelSubgroup A)
    (heq : u₁ * n * b₁ = u₂ * n * b₂) :
    u₁ = u₂ ∧ b₁ = b₂ := by
  obtain ⟨v₁, hv₁, rfl⟩ := hu₁
  obtain ⟨v₂, hv₂, rfl⟩ := hu₂
  have hvb : v₁ * b₁ = v₂ * b₂ := by
    apply mul_left_cancel (a := n)
    calc
      n * (v₁ * b₁) = MulAut.conj n v₁ * n * b₁ := by simp [MulAut.conj_apply, mul_assoc]
      _ = MulAut.conj n v₂ * n * b₂ := heq
      _ = n * (v₂ * b₂) := by simp [MulAut.conj_apply, mul_assoc]
  have hv21 : v₂⁻¹ * v₁ = b₂ * b₁⁻¹ := by
    calc
      v₂⁻¹ * v₁ = v₂⁻¹ * (v₁ * b₁) * b₁⁻¹ := by group
      _ = v₂⁻¹ * (v₂ * b₂) * b₁⁻¹ := by rw [hvb]
      _ = b₂ * b₁⁻¹ := by group
  have hbot : v₂⁻¹ * v₁ ∈ (⊥ : Subgroup (D.points A)) := by
    rw [← D.negativePoints_inf_borelSubgroup_eq_bot A]
    refine ⟨mul_mem (Subgroup.inv_mem _ hv₂) hv₁, ?_⟩
    rw [hv21]
    exact mul_mem hb₂ (Subgroup.inv_mem _ hb₁)
  have hv : v₁ = v₂ := (inv_mul_eq_one.mp (Subgroup.mem_bot.mp hbot)).symm
  subst hv
  exact ⟨rfl, mul_left_cancel hvb⟩

end Ring

section Field

variable (K : Type v) [Field K]

/-- The Bruhat cell `B(K) w B(K) ⊆ D.points K` indexed by an element `w` of the root-datum Weyl
group. -/
noncomputable def bruhatCell (w : (t.simplyConnectedRootDatum ht).weylGroup) : Set (D.points K) :=
  Subtype.val '' (D.titsSystem K).bruhatCell ((D.titsSystemWeylGroupEquiv K).symm w)

/-- Every Bruhat cell is contained in the extended elementary subgroup. -/
theorem bruhatCell_subset_extendedElementarySubgroup
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.bruhatCell K w ⊆ (D.extendedElementarySubgroup K : Set (D.points K)) := by
  rintro _ ⟨g, _, rfl⟩
  exact g.2

/-- For every Weyl lift `n ∈ D.weylSubgroup K`, the Bruhat cell at `D.weylProjection K n` is the
`D.borelSubgroup K` double coset of `n` inside `D.points K`. -/
@[simp]
theorem bruhatCell_weylProjection (n : D.weylSubgroup K) :
    D.bruhatCell K (D.weylProjection K n) =
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  let nE := (D.titsSystemSubgroupNEquiv K).symm n
  have hmk : (D.titsSystemWeylGroupEquiv K).symm (D.weylProjection K n) = QuotientGroup.mk nE := by
    apply (D.titsSystemWeylGroupEquiv K).injective
    simp [nE]
  have hnval : ((nE : D.extendedElementarySubgroup K) : D.points K) = (n : D.points K) := by
    rw [← D.coe_titsSystemSubgroupNEquiv, MulEquiv.apply_symm_apply]
  ext g
  simp only [bruhatCell, hmk, TitsSystem.bruhatCell_mk, Set.mem_image, D.titsSystem_subgroupB,
    D.mem_doubleCoset_subgroupOf_borelSubgroup_iff K, hnval]
  constructor
  · rintro ⟨_, hx, rfl⟩
    exact hx
  · intro hg
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    have hgE : b₁ * (n : D.points K) * b₂ ∈ D.extendedElementarySubgroup K :=
      mul_mem (mul_mem (D.borelSubgroup_le_extendedElementarySubgroup K hb₁)
        (D.weylSubgroup_le_extendedElementarySubgroup K n.2))
        (D.borelSubgroup_le_extendedElementarySubgroup K hb₂)
    exact ⟨⟨_, hgE⟩, DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, b₂, hb₂, rfl⟩, rfl⟩

/-- If `D.weylProjection K n = w`, then `D.bruhatCell K w = B(K) n B(K)`. -/
theorem bruhatCell_eq_doubleCoset {n : D.weylSubgroup K}
    {w : (t.simplyConnectedRootDatum ht).weylGroup} (hn : D.weylProjection K n = w) :
    D.bruhatCell K w =
      DoubleCoset.doubleCoset (n : D.points K) (D.borelSubgroup K) (D.borelSubgroup K) := by
  rw [← hn, D.bruhatCell_weylProjection]

/-- The Bruhat cell indexed by `1` is `D.borelSubgroup K`. -/
@[simp]
theorem bruhatCell_one : D.bruhatCell K 1 = (D.borelSubgroup K : Set (D.points K)) := by
  ext g
  simp only [bruhatCell, map_one, TitsSystem.bruhatCell_one, D.titsSystem_subgroupB, Set.mem_image,
    SetLike.mem_coe, Subgroup.mem_subgroupOf]
  exact ⟨fun ⟨_, hx, hval⟩ => hval ▸ hx,
    fun hg => ⟨⟨g, D.borelSubgroup_le_extendedElementarySubgroup K hg⟩, hg, rfl⟩⟩

/-- Distinct Weyl-group elements index distinct Bruhat cells in `D.points K`. -/
theorem bruhatCell_injective : Function.Injective (D.bruhatCell K) := by
  intro w v h
  apply (D.titsSystemWeylGroupEquiv K).symm.injective
  apply (D.titsSystem K).bruhatCell_injective
  exact Set.image_injective.mpr Subtype.val_injective h

/-- Equality of Bruhat cells is equality of their Weyl-group indices. -/
@[simp]
theorem bruhatCell_inj {w v : (t.simplyConnectedRootDatum ht).weylGroup} :
    D.bruhatCell K w = D.bruhatCell K v ↔ w = v :=
  (D.bruhatCell_injective K).eq_iff

/-- Two Bruhat cells sharing an element have the same Weyl-group index. -/
theorem eq_of_mem_bruhatCell_of_mem {g : D.points K}
    {w v : (t.simplyConnectedRootDatum ht).weylGroup}
    (hw : g ∈ D.bruhatCell K w) (hv : g ∈ D.bruhatCell K v) : w = v := by
  obtain ⟨x, hx, hvalx⟩ := hw
  obtain ⟨y, hy, hvaly⟩ := hv
  have hxy : x = y := Subtype.ext (hvalx.trans hvaly.symm)
  subst hxy
  exact (D.titsSystemWeylGroupEquiv K).symm.injective
    ((D.titsSystem K).eq_of_mem_bruhatCell_of_mem hx hy)

/-- Containment of Bruhat cells is equality of their Weyl-group indices. -/
@[simp]
theorem bruhatCell_subset_iff {w v : (t.simplyConnectedRootDatum ht).weylGroup} :
    D.bruhatCell K w ⊆ D.bruhatCell K v ↔ w = v := by
  rw [bruhatCell, bruhatCell, Set.image_subset_image_iff Subtype.val_injective,
    (D.titsSystem K).bruhatCell_subset_iff, MulEquiv.apply_eq_iff_eq]

/-- Two Bruhat cells are disjoint if and only if their Weyl-group indices differ. -/
@[simp]
theorem disjoint_bruhatCell_iff {w v : (t.simplyConnectedRootDatum ht).weylGroup} :
    Disjoint (D.bruhatCell K w) (D.bruhatCell K v) ↔ w ≠ v := by
  rw [bruhatCell, bruhatCell, Set.disjoint_image_iff Subtype.val_injective,
    (D.titsSystem K).disjoint_bruhatCell_iff, ne_eq, MulEquiv.apply_eq_iff_eq]

/-- **Bruhat decomposition of `D.extendedElementarySubgroup K`:** every extended elementary point
belongs to a unique Weyl-indexed Bruhat cell. -/
theorem existsUnique_mem_bruhatCell {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup, g ∈ D.bruhatCell K w := by
  obtain ⟨u, hu, huniq⟩ := (D.titsSystem K).existsUnique_mem_bruhatCell ⟨g, hg⟩
  refine ⟨D.titsSystemWeylGroupEquiv K u, ?_, fun w hw => ?_⟩
  · refine ⟨⟨g, hg⟩, ?_, rfl⟩
    simpa only [MulEquiv.symm_apply_apply] using hu
  · obtain ⟨x, hx, hval⟩ := hw
    have hxg : x = ⟨g, hg⟩ := Subtype.ext hval
    subst hxg
    simpa only [MulEquiv.apply_symm_apply] using
      congrArg (D.titsSystemWeylGroupEquiv K) (huniq _ hx)

/-- The Bruhat cells partition the extended elementary subgroup. -/
theorem iUnion_bruhatCell :
    (⋃ w : (t.simplyConnectedRootDatum ht).weylGroup, D.bruhatCell K w) =
      (D.extendedElementarySubgroup K : Set (D.points K)) := by
  ext g
  simp only [Set.mem_iUnion, SetLike.mem_coe]
  exact ⟨fun ⟨w, hw⟩ => D.bruhatCell_subset_extendedElementarySubgroup K w hw,
    fun hg => ⟨_, (D.existsUnique_mem_bruhatCell K hg).exists.choose_spec⟩⟩

/-- Every element of `D.elementarySubgroup K` belongs to a unique Bruhat cell. -/
theorem existsUnique_mem_bruhatCell_of_mem_elementarySubgroup {g : D.points K}
    (hg : g ∈ D.elementarySubgroup K) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup, g ∈ D.bruhatCell K w :=
  D.existsUnique_mem_bruhatCell K (D.elementarySubgroup_le_extendedElementarySubgroup K hg)

/-- For every Weyl lift `n ∈ D.weylSubgroup K`, the inversion subgroup at `D.weylProjection K n` is
contained in `n U⁻(K) n⁻¹`. -/
theorem inversionPoints_le_map_negativePoints_conj (n : D.weylSubgroup K) :
    D.inversionPoints K (D.weylProjection K n) ≤
      (D.negativePoints K).map (MulAut.conj (n : D.points K)).toMonoidHom := by
  rw [D.negativePoints_eq_iSup K, D.map_iSup_rootSubgroupPoints_conj K n]
  refine iSup₂_le fun γ hγ => ?_
  have hpre : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n)⁻¹ γ ∈
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    simpa only [mem_negRoots, RootPairing.Base.isPos_iff, height_rationalBase] using
      mapsTo_inversions_negRoots _ _ _ hγ
  have himg : γ ∈ (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n) ''
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    refine ⟨_, hpre, ?_⟩
    rw [← Equiv.Perm.mul_apply, ← map_mul, mul_inv_cancel, map_one, Equiv.Perm.one_apply]
  exact le_iSup₂ (f := fun δ _ => (D.rootSubgroupPoints δ K).range) γ himg

private theorem map_inversionPoints_weylElement_conj_le (i : Fin t.rank)
    (w : (t.simplyConnectedRootDatum ht).weylGroup)
    (hαinv : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹) :
    (D.inversionPoints K
        ((RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i))⁻¹ *
          w)).map
        (MulAut.conj (D.weylElement (t.simpleIndex ht i) K 1)).toMonoidHom ≤
      D.inversionPoints K w := by
  let : (t.simplyConnectedRootDatum ht).IsReduced := t.isReduced_simplyConnectedRootDatum ht
  have hinv_eq :
      ((RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i))⁻¹ *
        w)⁻¹ =
      w⁻¹ * RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
    rw [mul_inv_rev, inv_inv]
  have hconj := D.map_iSup_rootSubgroupPoints_conj K
    ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩
    (inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
      (w⁻¹ * RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)))
  rw [D.weylProjection_weylElement K i] at hconj
  rw [inversionPoints, hinv_eq, hconj]
  have hαsupp : t.simpleIndex ht i ∈ (t.simplyConnectedBase ht).support := by
    rw [← support_rationalBase]
    exact t.simpleIndex_mem_support i
  have hαpos : (t.simplyConnectedBase ht).IsPos (t.simpleIndex ht i) :=
    (t.simplyConnectedBase ht).isPos_of_mem_support hαsupp
  have hαnot : t.simpleIndex ht i ∉ inversions (t.simplyConnectedRootDatum ht)
      (t.simplyConnectedBase ht)
      (w⁻¹ * RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) :=
    fun hmem => ((mem_inversions_mul_ofIdx_iff_not_mem _ w⁻¹ _ hαpos).mp hmem) hαinv
  refine iSup₂_le fun δ hδ => ?_
  obtain ⟨γ, hγ, rfl⟩ := hδ
  have hγα : γ ≠ t.simpleIndex ht i := fun heq => hαnot (heq ▸ hγ)
  have hγ' := (mem_inversions _ _ _ _).mp hγ
  have hδinv : (t.simplyConnectedRootDatum ht).weylGroupToPerm
      (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) γ ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹ := by
    rw [RootPairing.weylGroupToPerm_ofIdx_apply, mem_inversions]
    refine ⟨hγ'.1.reflectionPerm hαsupp hγα, ?_⟩
    have hneg := hγ'.2
    rwa [RootPairing.weylGroupToPerm_mul_ofIdx_apply] at hneg
  exact le_iSup₂ (f := fun β _ => (D.rootSubgroupPoints β K).range) _ hδinv

private theorem exists_inversionPoints_mul_borelSubgroup_step (i : Fin t.rank)
    (n : D.weylSubgroup K)
    (hαinv : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹)
    (ih : ∀ {u₁ : D.points K}, u₁ ∈ D.positivePoints K →
      ∃ u ∈ D.inversionPoints K
        (D.weylProjection K
          (⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩⁻¹ * n)),
        ∃ b₀ ∈ D.borelSubgroup K,
          u * ((⟨D.weylElement (t.simpleIndex ht i) K 1,
            D.weylElement_mem_weylSubgroup K i⟩⁻¹ * n : D.weylSubgroup K) : D.points K) * b₀ =
            u₁ * ((⟨D.weylElement (t.simpleIndex ht i) K 1,
              D.weylElement_mem_weylSubgroup K i⟩⁻¹ * n : D.weylSubgroup K) : D.points K))
    {u₁ : D.points K} (hu₁ : u₁ ∈ D.positivePoints K) :
    ∃ u ∈ D.inversionPoints K (D.weylProjection K n),
      ∃ b₀ ∈ D.borelSubgroup K, u * (n : D.points K) * b₀ = u₁ * (n : D.points K) := by
  let n_i : D.weylSubgroup K :=
    ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩
  let m : D.weylSubgroup K := n_i⁻¹ * n
  obtain ⟨a, v, hv, rfl⟩ :=
    (D.mem_positivePoints_iff_exists_rootSubgroupPoints_mul K i u₁).mp hu₁
  have hnorm := Subgroup.inv_mem _
    (D.weylElement_mem_normalizer_positivePoints_diff_singleton K i 1)
  have hv'pos : (n_i : D.points K)⁻¹ * v * (n_i : D.points K) ∈ D.positivePoints K :=
    D.positivePoints_diff_singleton_le_positivePoints K i
      (by simpa only [inv_inv, n_i] using (Subgroup.mem_normalizer_iff.mp hnorm v).mp hv)
  obtain ⟨u', hu', b₀, hb₀, hih⟩ := ih hv'pos
  have hih' : u' * (m : D.points K) * b₀ =
      (n_i : D.points K)⁻¹ * v * (n_i : D.points K) * (m : D.points K) := hih
  have hu'conj : (n_i : D.points K) * u' * (n_i : D.points K)⁻¹ ∈
      D.inversionPoints K (D.weylProjection K n) := by
    have hm_proj : D.weylProjection K m =
        (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i))⁻¹ *
          D.weylProjection K n := by simp [m, n_i]
    rw [hm_proj] at hu'
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, n_i] using
      D.map_inversionPoints_weylElement_conj_le K i (D.weylProjection K n) hαinv ⟨u', hu', rfl⟩
  have hx_mem : D.rootSubgroupPoints (t.simpleIndex ht i) K a ∈
      D.inversionPoints K (D.weylProjection K n) :=
    le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ K).range) _ hαinv ⟨a, rfl⟩
  refine ⟨D.rootSubgroupPoints (t.simpleIndex ht i) K a *
    ((n_i : D.points K) * u' * (n_i : D.points K)⁻¹),
    mul_mem hx_mem hu'conj, b₀, hb₀, ?_⟩
  have hnm : (n : D.points K) = (n_i : D.points K) * (m : D.points K) := by simp [m]
  calc
    D.rootSubgroupPoints (t.simpleIndex ht i) K a *
        ((n_i : D.points K) * u' * (n_i : D.points K)⁻¹) * (n : D.points K) * b₀
      = D.rootSubgroupPoints (t.simpleIndex ht i) K a * (n_i : D.points K) *
          (u' * (m : D.points K) * b₀) := by rw [hnm]; group
    _ = D.rootSubgroupPoints (t.simpleIndex ht i) K a * v * (n : D.points K) := by
          rw [hih', hnm]; group

private theorem exists_inversionPoints_mul_borelSubgroup_of_ncard_eq (k : ℕ) :
    ∀ (n : D.weylSubgroup K),
      (inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection K n)⁻¹).ncard = k →
      ∀ {u₁ : D.points K}, u₁ ∈ D.positivePoints K →
        ∃ u ∈ D.inversionPoints K (D.weylProjection K n),
          ∃ b₀ ∈ D.borelSubgroup K, u * (n : D.points K) * b₀ = u₁ * (n : D.points K) := by
  let : (t.simplyConnectedRootDatum ht).IsReduced := t.isReduced_simplyConnectedRootDatum ht
  induction k with
  | zero =>
    intro n hk u₁ hu₁
    have hw1 : D.weylProjection K n = 1 := by
      by_contra hne
      have hpos := ncard_inversions_pos_of_ne_one
        (P := t.simplyConnectedRootDatum ht) (b := t.simplyConnectedBase ht)
        (inv_ne_one.mpr hne)
      omega
    have hnB : (n : D.points K) ∈ D.borelSubgroup K :=
      D.range_torusPoints_le_borelSubgroup K
        ((D.weylProjection_eq_one_iff_mem_range_torusPoints K n).mp hw1)
    refine ⟨1, one_mem _, (n : D.points K)⁻¹ * u₁ * (n : D.points K),
      mul_mem (mul_mem (inv_mem hnB) (D.positivePoints_le_borelSubgroup K hu₁)) hnB, ?_⟩
    group
  | succ k ih =>
    intro n hk u₁ hu₁
    have hwne : (D.weylProjection K n)⁻¹ ≠ 1 := by
      intro h1
      rw [h1, inversions_one, Set.ncard_empty] at hk
      omega
    obtain ⟨α, hαsupp, hαinv⟩ := exists_mem_support_mem_inversions_of_ne_one
      (P := t.simplyConnectedRootDatum ht) (b := t.simplyConnectedBase ht) hwne
    obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support (by rwa [support_rationalBase])
    let n_i : D.weylSubgroup K :=
      ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩
    have hm_ncard :
        (inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection K (n_i⁻¹ * n))⁻¹).ncard = k := by
      have hm_inv : (D.weylProjection K (n_i⁻¹ * n))⁻¹ =
          (D.weylProjection K n)⁻¹ *
            RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
        simp [n_i, mul_inv_rev]
      have hstep := ncard_inversions_mul_ofIdx_of_mem
        (t.simplyConnectedRootDatum ht) (D.weylProjection K n)⁻¹ (t.simplyConnectedBase ht)
        hαsupp hαinv
      rw [hm_inv]
      omega
    exact D.exists_inversionPoints_mul_borelSubgroup_step K i n hαinv
      (ih (n_i⁻¹ * n) hm_ncard) hu₁

/-- **The positive subgroup meets the conjugate opposite unipotent subgroup in the inversion
subgroup:** `U(K) ∩ n U⁻(K) n⁻¹ = U_w(K)` for every Weyl lift `n ∈ D.weylSubgroup K` projecting to
`w`. -/
theorem positivePoints_inf_map_negativePoints_conj (n : D.weylSubgroup K) :
    D.positivePoints K ⊓
        (D.negativePoints K).map (MulAut.conj (n : D.points K)).toMonoidHom =
      D.inversionPoints K (D.weylProjection K n) := by
  apply le_antisymm
  · rintro u₁ ⟨hu₁pos, hu₁neg⟩
    obtain ⟨u₂, hu₂, b₀, hb₀, heq⟩ :=
      D.exists_inversionPoints_mul_borelSubgroup_of_ncard_eq K _ n rfl hu₁pos
    have hu₂neg := D.inversionPoints_le_map_negativePoints_conj K n hu₂
    have heq' : u₁ * (n : D.points K) * 1 = u₂ * (n : D.points K) * b₀ := by
      rw [mul_one, heq]
    obtain ⟨rfl, -⟩ := D.eq_and_eq_of_mem_map_negativePoints_conj_of_mul_eq K
      hu₁neg hu₂neg (one_mem _) hb₀ heq'
    exact hu₂
  · exact le_inf (D.inversionPoints_le_positivePoints K _)
      (D.inversionPoints_le_map_negativePoints_conj K n)

/-- **Steinberg's sharp Bruhat normal form on a cell:** for every Weyl lift `n ∈ D.weylSubgroup K`
and every `g ∈ D.bruhatCell K (D.weylProjection K n)`, there exist unique
`u ∈ D.inversionPoints K (D.weylProjection K n)` and `b ∈ D.borelSubgroup K` with `u * n * b = g`.
-/
theorem existsUnique_mul_mul_eq_of_mem_bruhatCell (n : D.weylSubgroup K) {g : D.points K}
    (hg : g ∈ D.bruhatCell K (D.weylProjection K n)) :
    ∃! p : D.inversionPoints K (D.weylProjection K n) × D.borelSubgroup K,
      (p.1 : D.points K) * (n : D.points K) * (p.2 : D.points K) = g := by
  rw [D.bruhatCell_weylProjection K n] at hg
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
  obtain ⟨u₁, hu₁, s, rfl⟩ := (D.mem_borelSubgroup_iff K).mp hb₁
  have ht' : (n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K) ∈ D.borelSubgroup K := by
    have hnorm := D.weylSubgroup_le_normalizer_range_torusPoints K n⁻¹.2
    exact D.range_torusPoints_le_borelSubgroup K
      ((Subgroup.mem_normalizer_iff.mp hnorm (D.torusPoints K s)).mp ⟨s, rfl⟩)
  obtain ⟨u, hu, b₀, hb₀, heq⟩ :=
    D.exists_inversionPoints_mul_borelSubgroup_of_ncard_eq K _ n rfl hu₁
  let bFinal := b₀ * ((n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K)) * b₂
  have hbFinal : bFinal ∈ D.borelSubgroup K := mul_mem (mul_mem hb₀ ht') hb₂
  have hprod : u * (n : D.points K) * bFinal =
      u₁ * D.torusPoints K s * (n : D.points K) * b₂ := by
    dsimp only [bFinal]
    calc
      u * (n : D.points K) *
          (b₀ * ((n : D.points K)⁻¹ * D.torusPoints K s * (n : D.points K)) * b₂)
        = (u * (n : D.points K) * b₀) * (n : D.points K)⁻¹ * D.torusPoints K s *
            (n : D.points K) * b₂ := by group
      _ = u₁ * D.torusPoints K s * (n : D.points K) * b₂ := by rw [heq]; group
  refine ⟨(⟨u, hu⟩, ⟨bFinal, hbFinal⟩), hprod, ?_⟩
  rintro ⟨⟨u', hu'⟩, ⟨b', hb'⟩⟩ h'
  have hEq := D.eq_and_eq_of_mem_map_negativePoints_conj_of_mul_eq K
    (D.inversionPoints_le_map_negativePoints_conj K n hu')
    (D.inversionPoints_le_map_negativePoints_conj K n hu)
    hb' hbFinal (h'.trans hprod.symm)
  exact Prod.ext (Subtype.ext hEq.1) (Subtype.ext hEq.2)

/-- **Global sharp Bruhat normal form on `D.extendedElementarySubgroup K`:** given any section
`rep : W → D.weylSubgroup K` of `D.weylProjection K`, every `g ∈ D.extendedElementarySubgroup K`
factors uniquely as `u * rep w * b` with `w ∈ W`, `u ∈ U_w(K)`, and `b ∈ B(K)`. -/
theorem existsUnique_bruhatNormalForm
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup K)
    (hrep : ∀ w, D.weylProjection K (rep w) = w)
    {g : D.points K} (hg : g ∈ D.extendedElementarySubgroup K) :
    ∃! q : (t.simplyConnectedRootDatum ht).weylGroup × D.points K × D.points K,
      q.2.1 ∈ D.inversionPoints K q.1 ∧
        q.2.2 ∈ D.borelSubgroup K ∧
        q.2.1 * (rep q.1 : D.points K) * q.2.2 = g := by
  obtain ⟨w, hw, hwuniq⟩ := D.existsUnique_mem_bruhatCell K hg
  have hw' : g ∈ D.bruhatCell K (D.weylProjection K (rep w)) := by rwa [hrep w]
  obtain ⟨⟨⟨u, hu⟩, ⟨b, hb⟩⟩, hprod, hpuniq⟩ :=
    D.existsUnique_mul_mul_eq_of_mem_bruhatCell K (rep w) hw'
  have hu' : u ∈ D.inversionPoints K w := by rwa [hrep w] at hu
  refine ⟨(w, u, b), ⟨hu', hb, hprod⟩, ?_⟩
  rintro ⟨w₁, u₁, b₁⟩ ⟨hu₁, hb₁, hprod₁⟩
  have hgcell : g ∈ D.bruhatCell K w₁ := by
    rw [← hrep w₁, D.bruhatCell_weylProjection, ← hprod₁]
    exact DoubleCoset.mem_doubleCoset.mpr
      ⟨u₁, D.positivePoints_le_borelSubgroup K
        (D.inversionPoints_le_positivePoints K w₁ hu₁), b₁, hb₁, rfl⟩
  have hww : w₁ = w := hwuniq w₁ hgcell
  subst hww
  have hu₁' : u₁ ∈ D.inversionPoints K (D.weylProjection K (rep w₁)) := by rwa [hrep w₁]
  have hp := hpuniq (⟨u₁, hu₁'⟩, ⟨b₁, hb₁⟩) hprod₁
  exact Prod.ext rfl (Prod.ext
    (congrArg (fun x => (x.1 : D.points K)) hp)
    (congrArg (fun x => (x.2 : D.points K)) hp))

end Field

