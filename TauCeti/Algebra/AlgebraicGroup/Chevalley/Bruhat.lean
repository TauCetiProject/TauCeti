/-!
# Bruhat decomposition and Steinberg's normal form for a Chevalley datum

For a Chevalley datum `D` of valid Dynkin type `t` over an arbitrary field `k` — including `𝔽₂`,
with no restriction on `kˣ` — this file establishes the Weyl-indexed Bruhat decomposition of the
extended elementary Chevalley group `D.extendedElementarySubgroup k` and Steinberg's sharpened
normal form on every Bruhat cell:

1. `D.bruhatCell k w`: the Bruhat cell in `D.points k` indexed by
   `w : (t.simplyConnectedRootDatum ht).weylGroup`, equal for any lift `n : D.weylSubgroup k` of `w`
   to the double coset `B(k) n B(k)` (`D.bruhatCell_weylProjection`).
2. `D.disjoint_bruhatCell_iff`, `D.iUnion_bruhatCell_eq_extendedElementarySubgroup`, and
   `D.existsUnique_mem_bruhatCell_of_mem_extendedElementarySubgroup`: distinct Weyl elements index
   disjoint Bruhat cells, and their disjoint union is `D.extendedElementarySubgroup k`.
3. `D.positivePoints_inf_conj_negativePoints_eq_iSup`: for any lift `n : D.weylSubgroup k` of `w`,
   the intersection `U(k) ∩ n U⁻(k) n⁻¹` equals the subgroup generated by the root subgroups at the
   inversions of `w⁻¹`.
4. `D.existsUnique_bruhatNormalForm_of_mem_doubleCoset` and
   `D.existsUnique_bruhatNormalForm_of_mem_extendedElementarySubgroup`: every element of
   `B(k) n B(k)` writes uniquely as `u * n * b` with `u ∈ U(k) ∩ n U⁻(k) n⁻¹` and `b ∈ B(k)`,
   giving a unique triple `(w, u, b)` for every element of `D.extendedElementarySubgroup k`
   relative to any choice of Weyl representatives.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorems 4 and 4′.
* R. W. Carter, *Simple Groups of Lie Type*, §§8.2–8.4.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Chapter IV, §2.
-/

public section

open Multiplicative
open scoped Pointwise

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (k : Type v) [Field k]

/-! ### Weyl-indexed Bruhat cells and Bruhat decomposition -/

/-- The Bruhat cell in `D.points k` indexed by an element of the root datum's Weyl group. -/
noncomputable def bruhatCell (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    Set (D.points k) :=
  (D.extendedElementarySubgroup k).subtype ''
    (D.extendedElementaryTitsSystem k).bruhatCell
      ((D.extendedElementaryTitsSystemWeylGroupMulEquiv k).symm w)

/-- Every Bruhat cell is contained in the extended elementary subgroup. -/
theorem bruhatCell_subset_extendedElementarySubgroup
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.bruhatCell k w ⊆ (D.extendedElementarySubgroup k : Set (D.points k)) := by
  rintro _ ⟨g, _, rfl⟩
  exact g.2

/-- For any lift `n : D.weylSubgroup k`, the Bruhat cell of `D.weylProjection k n` is the double
coset `B(k) n B(k)` in `D.points k`. -/
@[simp]
theorem bruhatCell_weylProjection (n : D.weylSubgroup k) :
    D.bruhatCell k (D.weylProjection k n) =
      DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) := by
  let n' : (D.extendedElementaryTitsSystem k).subgroupN :=
    ⟨⟨n.val, D.weylSubgroup_le_extendedElementarySubgroup k n.2⟩,
      by rw [D.extendedElementaryTitsSystem_subgroupN k]; exact n.2⟩
  have hsymm :
      (D.extendedElementaryTitsSystemWeylGroupMulEquiv k).symm (D.weylProjection k n) =
        QuotientGroup.mk n' :=
    (MulEquiv.symm_apply_eq _).mpr
      (D.extendedElementaryTitsSystemWeylGroupMulEquiv_mk k n').symm
  ext g
  simp only [bruhatCell, hsymm, TitsSystem.bruhatCell_mk,
    D.extendedElementaryTitsSystem_subgroupB k, Set.mem_image, Subgroup.coe_subtype]
  constructor
  · rintro ⟨x, hx, rfl⟩
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
    exact DoubleCoset.mem_doubleCoset.mpr ⟨b₁.val, hb₁, b₂.val, hb₂, rfl⟩
  · intro hg
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    have hb₁E := D.borelSubgroup_le_extendedElementarySubgroup k hb₁
    have hb₂E := D.borelSubgroup_le_extendedElementarySubgroup k hb₂
    have hnE := D.weylSubgroup_le_extendedElementarySubgroup k n.2
    exact ⟨⟨b₁ * n.val * b₂, mul_mem (mul_mem hb₁E hnE) hb₂E⟩,
      DoubleCoset.mem_doubleCoset.mpr ⟨⟨b₁, hb₁E⟩, hb₁, ⟨b₂, hb₂E⟩, hb₂, rfl⟩, rfl⟩

/-- A point belongs to the Bruhat cell of `w` iff it lies in `B(k) n B(k)` for a lift `n` of `w`. -/
theorem mem_bruhatCell_iff {w : (t.simplyConnectedRootDatum ht).weylGroup} {g : D.points k} :
    g ∈ D.bruhatCell k w ↔
      ∃ n : D.weylSubgroup k,
        D.weylProjection k n = w ∧
          g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k) := by
  constructor
  · intro hg
    obtain ⟨n, rfl⟩ := D.weylProjection_surjective k w
    exact ⟨n, rfl, by rwa [← D.bruhatCell_weylProjection k n]⟩
  · rintro ⟨n, rfl, hg⟩
    rwa [D.bruhatCell_weylProjection k n]

/-- The Bruhat cell of the identity Weyl element is the Borel-type subgroup. -/
@[simp]
theorem bruhatCell_one :
    D.bruhatCell k 1 = (D.borelSubgroup k : Set (D.points k)) := by
  have h1 : D.weylProjection k 1 = 1 := map_one _
  rw [← h1, D.bruhatCell_weylProjection k 1, Subgroup.coe_one]
  ext g
  constructor
  · intro hg
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    rw [mul_one]
    exact mul_mem hb₁ hb₂
  · intro hg
    exact DoubleCoset.mem_doubleCoset.mpr ⟨g, hg, 1, one_mem _, by rw [mul_one, mul_one]⟩

/-- Distinct elements of the Weyl group index distinct Bruhat cells in `D.points k`. -/
theorem bruhatCell_injective : Function.Injective (D.bruhatCell k) := by
  intro v w h
  have himg := Set.image_injective.mpr (D.extendedElementarySubgroup k).subtype_injective h
  exact (D.extendedElementaryTitsSystemWeylGroupMulEquiv k).symm.injective
    ((D.extendedElementaryTitsSystem k).bruhatCell_injective himg)

/-- Equality of Bruhat cells in `D.points k` is equality of their Weyl indices. -/
@[simp]
theorem bruhatCell_inj {v w : (t.simplyConnectedRootDatum ht).weylGroup} :
    D.bruhatCell k v = D.bruhatCell k w ↔ v = w :=
  (D.bruhatCell_injective k).eq_iff

/-- Two Bruhat cells sharing a point have the same Weyl index. -/
theorem eq_of_mem_bruhatCell_of_mem {g : D.points k}
    {v w : (t.simplyConnectedRootDatum ht).weylGroup}
    (hv : g ∈ D.bruhatCell k v) (hw : g ∈ D.bruhatCell k w) : v = w := by
  obtain ⟨g₁, hg₁, rfl⟩ := hv
  obtain ⟨g₂, hg₂, heq⟩ := hw
  obtain rfl := Subtype.ext heq
  exact (D.extendedElementaryTitsSystemWeylGroupMulEquiv k).symm.injective
    ((D.extendedElementaryTitsSystem k).eq_of_mem_bruhatCell_of_mem hg₁ hg₂)

/-- Two Bruhat cells are disjoint if and only if their Weyl indices differ. -/
@[simp]
theorem disjoint_bruhatCell_iff {v w : (t.simplyConnectedRootDatum ht).weylGroup} :
    Disjoint (D.bruhatCell k v) (D.bruhatCell k w) ↔ v ≠ w := by
  constructor
  · rintro h rfl
    obtain ⟨n, rfl⟩ := D.weylProjection_surjective k v
    have hn : (n : D.points k) ∈ D.bruhatCell k (D.weylProjection k n) := by
      rw [D.bruhatCell_weylProjection k n]
      exact DoubleCoset.mem_doubleCoset.mpr ⟨1, one_mem _, 1, one_mem _, by simp⟩
    exact Set.disjoint_left.mp h hn hn
  · intro h
    rw [Set.disjoint_left]
    intro g hv hw
    exact h (D.eq_of_mem_bruhatCell_of_mem k hv hw)

/-- **Bruhat covering.** The union of the Bruhat cells over the Weyl group is the extended
elementary Chevalley subgroup `D.extendedElementarySubgroup k`. -/
@[simp]
theorem iUnion_bruhatCell_eq_extendedElementarySubgroup :
    (⋃ w, D.bruhatCell k w) = (D.extendedElementarySubgroup k : Set (D.points k)) := by
  ext g
  constructor
  · intro hg
    obtain ⟨w, hg⟩ := Set.mem_iUnion.mp hg
    exact D.bruhatCell_subset_extendedElementarySubgroup k w hg
  · intro hg
    obtain ⟨w', hw'⟩ :=
      ((D.extendedElementaryTitsSystem k).existsUnique_mem_bruhatCell ⟨g, hg⟩).exists
    refine Set.mem_iUnion.mpr
      ⟨D.extendedElementaryTitsSystemWeylGroupMulEquiv k w', ⟨⟨g, hg⟩, ?_, rfl⟩⟩
    simpa only [MulEquiv.symm_apply_apply] using hw'

/-- **Bruhat decomposition of `E(k)`.** Every point of the extended elementary subgroup belongs to a
unique Weyl-indexed Bruhat cell. -/
theorem existsUnique_mem_bruhatCell_of_mem_extendedElementarySubgroup {g : D.points k}
    (hg : g ∈ D.extendedElementarySubgroup k) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup, g ∈ D.bruhatCell k w := by
  rw [← SetLike.mem_coe, ← D.iUnion_bruhatCell_eq_extendedElementarySubgroup k,
    Set.mem_iUnion] at hg
  obtain ⟨w, hw⟩ := hg
  exact ⟨w, hw, fun v hv => D.eq_of_mem_bruhatCell_of_mem k hv hw⟩

/-- Every point of the elementary Chevalley subgroup `E'(k)` belongs to a unique Weyl-indexed Bruhat
cell. -/
theorem existsUnique_mem_bruhatCell_of_mem_elementarySubgroup {g : D.points k}
    (hg : g ∈ D.elementarySubgroup k) :
    ∃! w : (t.simplyConnectedRootDatum ht).weylGroup, g ∈ D.bruhatCell k w :=
  D.existsUnique_mem_bruhatCell_of_mem_extendedElementarySubgroup k
    (D.elementarySubgroup_le_extendedElementarySubgroup k hg)

/-! ### Steinberg's Bruhat normal form and inversion subgroups -/

private theorem bruhatNormalForm_unique (n : D.weylSubgroup k)
    {u₁ u₂ :
      ↥(D.positivePoints k ⊓
          (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom)}
    {b₁ b₂ : D.borelSubgroup k}
    (heq : (u₁ : D.points k) * (n : D.points k) * (b₁ : D.points k) =
      (u₂ : D.points k) * (n : D.points k) * (b₂ : D.points k)) :
    (u₁, b₁) = (u₂, b₂) := by
  have hu_conj :
      (u₂ : D.points k)⁻¹ * (u₁ : D.points k) ∈
        (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom :=
    ((u₂⁻¹ * u₁).2).2
  obtain ⟨v, hv_neg, hv_eq⟩ := Subgroup.mem_map.mp hu_conj
  have hv_bor_eq : v = (b₂ : D.points k) * (b₁ : D.points k)⁻¹ := by
    have hconj : (n : D.points k) * v * (n : D.points k)⁻¹ =
        (u₂ : D.points k)⁻¹ * (u₁ : D.points k) := hv_eq
    calc
      v = (n : D.points k)⁻¹ * ((n : D.points k) * v * (n : D.points k)⁻¹) *
            (n : D.points k) := by group
      _ = (n : D.points k)⁻¹ * ((u₂ : D.points k)⁻¹ * (u₁ : D.points k)) *
            (n : D.points k) := by rw [hconj]
      _ = (n : D.points k)⁻¹ * (u₂ : D.points k)⁻¹ *
            ((u₁ : D.points k) * (n : D.points k) * (b₁ : D.points k)) *
            (b₁ : D.points k)⁻¹ := by group
      _ = (n : D.points k)⁻¹ * (u₂ : D.points k)⁻¹ *
            ((u₂ : D.points k) * (n : D.points k) * (b₂ : D.points k)) *
            (b₁ : D.points k)⁻¹ := by rw [heq]
      _ = (b₂ : D.points k) * (b₁ : D.points k)⁻¹ := by group
  have hv_inf : v ∈ D.negativePoints k ⊓ D.borelSubgroup k := by
    refine ⟨hv_neg, ?_⟩
    rw [hv_bor_eq]
    exact (D.borelSubgroup k).mul_mem b₂.2 ((D.borelSubgroup k).inv_mem b₁.2)
  rw [D.negativePoints_inf_borelSubgroup_eq_bot k, Subgroup.mem_bot] at hv_inf
  have hb : b₁ = b₂ :=
    Subtype.ext (mul_inv_eq_one.mp (hv_bor_eq.symm.trans hv_inf)).symm
  have hu : u₁ = u₂ := by
    have hmul : (u₂ : D.points k)⁻¹ * (u₁ : D.points k) = 1 := by
      rw [← hv_eq, hv_inf, map_one]
    exact Subtype.ext (inv_mul_eq_one.mp hmul).symm
  exact Prod.ext hu hb

private theorem iSup_inversions_le_positivePoints_inf_conj_negativePoints
    (n : D.weylSubgroup k) :
    (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (D.weylProjection k n)⁻¹,
      (D.rootSubgroupPoints γ k).range) ≤
      D.positivePoints k ⊓
        (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom := by
  refine iSup₂_le fun γ hγ => le_inf ?_ ?_
  · have hpos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [t.posRoots_rationalRootSystem ht]
      exact inversions_subset_posRoots _ _ _ hγ
    rintro _ ⟨u, rfl⟩
    exact D.rootSubgroupPoints_mem_positivePoints k hpos u
  · let w := D.weylProjection k n
    let δ := (t.simplyConnectedRootDatum ht).weylGroupToPerm w⁻¹ γ
    have hδ : δ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [← compl_posRoots, t.posRoots_rationalRootSystem ht, compl_posRoots]
      exact mapsTo_inversions_negRoots _ _ _ hγ
    have hwδ : (t.simplyConnectedRootDatum ht).weylGroupToPerm w δ = γ := by
      simp only [δ, map_inv, Equiv.Perm.inv_def, Equiv.apply_symm_apply]
    rw [← hwδ, ← D.map_range_rootSubgroupPoints_conj k n δ]
    refine Subgroup.map_mono ?_
    rintro _ ⟨u, rfl⟩
    exact D.rootSubgroupPoints_mem_negativePoints k hδ u

private theorem image_reflectionPerm_inversions_subset
    {w : (t.simplyConnectedRootDatum ht).weylGroup} {i : Fin t.rank}
    (hi : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹) :
    (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) ''
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht)
          (t.simpleIndex ht i) * w)⁻¹ ⊆
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹ := by
  have := t.isReduced_simplyConnectedRootDatum ht
  have hi_supp : t.simpleIndex ht i ∈ (t.simplyConnectedBase ht).support := by simp
  have hi_pos : (t.simplyConnectedBase ht).IsPos (t.simpleIndex ht i) :=
    (t.simplyConnectedBase ht).isPos_of_mem_support hi_supp
  rintro _ ⟨β, hβ, rfl⟩
  rw [mul_inv_rev, RootPairing.weylGroup.ofIdx_inv_eq] at hβ
  have hβ_ne : β ≠ t.simpleIndex ht i := by
    rintro rfl
    exact ((mem_inversions_mul_ofIdx_iff_not_mem (t.simplyConnectedRootDatum ht) w⁻¹
      (t.simplyConnectedBase ht) hi_pos).mp hβ) hi
  obtain ⟨hβ_pos, hβ_neg⟩ := (mem_inversions _ _ _ _).mp hβ
  rw [RootPairing.weylGroupToPerm_mul_ofIdx_apply] at hβ_neg
  exact (mem_inversions _ _ _ _).mpr ⟨hβ_pos.reflectionPerm hi_supp hβ_ne, hβ_neg⟩

private theorem conj_weylElement_mem_iSup_inversions
    {w : (t.simplyConnectedRootDatum ht).weylGroup} {i : Fin t.rank}
    (hi : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹)
    {u' : D.points k}
    (hu' : u' ∈ (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
        (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht)
          (t.simpleIndex ht i) * w)⁻¹,
      (D.rootSubgroupPoints γ k).range : Subgroup (D.points k))) :
    D.weylElement (t.simpleIndex ht i) k 1 * u' *
        (D.weylElement (t.simpleIndex ht i) k 1)⁻¹ ∈
      (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹,
        (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)) := by
  let P := t.simplyConnectedRootDatum ht
  let b₀ := t.simplyConnectedBase ht
  let ni : D.weylSubgroup k :=
    ⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩
  have hmap : (ni : D.points k) * u' * (ni : D.points k)⁻¹ ∈
      (⨆ γ ∈ inversions P b₀ (RootPairing.weylGroup.ofIdx P (t.simpleIndex ht i) * w)⁻¹,
        (D.rootSubgroupPoints γ k).range).map (MulAut.conj (ni : D.points k)).toMonoidHom :=
    Subgroup.mem_map.mpr ⟨u', hu', rfl⟩
  rw [D.map_iSup_rootSubgroupPoints_conj k ni] at hmap
  have hperm : P.weylGroupToPerm (D.weylProjection k ni) =
      P.reflectionPerm (t.simpleIndex ht i) := by
    rw [D.weylProjection_weylElement]
    exact Equiv.ext fun β => RootPairing.weylGroupToPerm_ofIdx_apply _ _ β
  rw [hperm] at hmap
  have hle :
      (⨆ γ ∈ P.reflectionPerm (t.simpleIndex ht i) ''
          inversions P b₀ (RootPairing.weylGroup.ofIdx P (t.simpleIndex ht i) * w)⁻¹,
        (D.rootSubgroupPoints γ k).range) ≤
      ⨆ γ ∈ inversions P b₀ w⁻¹, (D.rootSubgroupPoints γ k).range :=
    iSup₂_le fun γ hγ =>
      le_iSup₂ (f := fun δ _ => (D.rootSubgroupPoints δ k).range) γ
        (image_reflectionPerm_inversions_subset hi hγ)
  exact hle hmap

private theorem weylElement_inv_conj_mem_positivePoints (i : Fin t.rank) {v : D.points k}
    (hv : v ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
      (D.rootSubgroupPoints γ k).range : Subgroup (D.points k))) :
    (D.weylElement (t.simpleIndex ht i) k 1)⁻¹ * v *
        D.weylElement (t.simpleIndex ht i) k 1 ∈ D.positivePoints k := by
  have hnorm := inv_mem (D.weylElement_mem_normalizer_positivePoints_diff_singleton k i 1)
  have hv_sub : (D.weylElement (t.simpleIndex ht i) k 1)⁻¹ * v *
      D.weylElement (t.simpleIndex ht i) k 1 ∈
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)) := by
    simpa only [inv_inv] using (Subgroup.mem_normalizer_iff.mp hnorm v).mp hv
  have hle :
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (D.rootSubgroupPoints γ k).range) ≤ D.positivePoints k :=
    iSup₂_le fun γ hγ => by
      rintro _ ⟨u, rfl⟩
      exact D.rootSubgroupPoints_mem_positivePoints k hγ.1 u
  exact hle hv_sub

private theorem exists_bruhatStep_of_mem_inversions
    {w : (t.simplyConnectedRootDatum ht).weylGroup} {i : Fin t.rank}
    (hα_inv : t.simpleIndex ht i ∈
      inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹)
    (n : D.weylSubgroup k) (hn : D.weylProjection k n = w)
    (ih : ∀ (n' : D.weylSubgroup k),
      D.weylProjection k n' =
        RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) * w →
      ∀ {x : D.points k}, x ∈ D.positivePoints k →
        ∃ u ∈ (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
            (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht)
              (t.simpleIndex ht i) * w)⁻¹,
          (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)),
          ∃ b ∈ D.borelSubgroup k, x * (n' : D.points k) = u * (n' : D.points k) * b)
    {x : D.points k} (hx : x ∈ D.positivePoints k) :
    ∃ u ∈ (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹,
        (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)),
      ∃ b ∈ D.borelSubgroup k, x * (n : D.points k) = u * (n : D.points k) * b := by
  let ni : D.weylSubgroup k :=
    ⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩
  let n' : D.weylSubgroup k := ni⁻¹ * n
  have hn' : D.weylProjection k n' =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) * w := by
    rw [map_mul, map_inv, D.weylProjection_weylElement, RootPairing.weylGroup.ofIdx_inv_eq, hn]
  obtain ⟨a, v, hv, rfl⟩ := (D.mem_positivePoints_iff_exists_rootSubgroupPoints_mul k i x).mp hx
  obtain ⟨u', hu', b, hb, hv'n'⟩ :=
    ih n' hn' (D.weylElement_inv_conj_mem_positivePoints k i hv)
  refine ⟨D.rootSubgroupPoints (t.simpleIndex ht i) k a *
    ((ni : D.points k) * u' * (ni : D.points k)⁻¹),
    mul_mem ((le_iSup₂ (f := fun γ _ => (D.rootSubgroupPoints γ k).range)
      (t.simpleIndex ht i) hα_inv) ⟨a, rfl⟩)
      (D.conj_weylElement_mem_iSup_inversions k hα_inv hu'), b, hb, ?_⟩
  calc
    D.rootSubgroupPoints (t.simpleIndex ht i) k a * v * (n : D.points k) =
        D.rootSubgroupPoints (t.simpleIndex ht i) k a * (ni : D.points k) *
          (((ni : D.points k)⁻¹ * v * (ni : D.points k)) * (n' : D.points k)) := by
      simp only [n', Subgroup.coe_mul, Subgroup.coe_inv]
      group
    _ = D.rootSubgroupPoints (t.simpleIndex ht i) k a * (ni : D.points k) *
          (u' * (n' : D.points k) * b) := by rw [hv'n']
    _ = (D.rootSubgroupPoints (t.simpleIndex ht i) k a *
          ((ni : D.points k) * u' * (ni : D.points k)⁻¹)) * (n : D.points k) * b := by
      simp only [n', Subgroup.coe_mul, Subgroup.coe_inv]
      group

private theorem exists_mem_iSup_inversions_mul_borelSubgroup_of_ncard :
    ∀ (m : ℕ) {w : (t.simplyConnectedRootDatum ht).weylGroup},
      (inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w).ncard = m →
      ∀ (n : D.weylSubgroup k), D.weylProjection k n = w →
      ∀ {x : D.points k}, x ∈ D.positivePoints k →
        ∃ u ∈ (⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht) w⁻¹,
            (D.rootSubgroupPoints γ k).range : Subgroup (D.points k)),
          ∃ b ∈ D.borelSubgroup k, x * (n : D.points k) = u * (n : D.points k) * b := by
  have := t.isReduced_simplyConnectedRootDatum ht
  let P := t.simplyConnectedRootDatum ht
  let b₀ := t.simplyConnectedBase ht
  intro m
  induction m with
  | zero =>
    intro w hw n hn x hx
    have hempty : inversions P b₀ w = ∅ := (Set.ncard_eq_zero (Set.toFinite _)).mp hw
    have hw1 : w = 1 := eq_one_of_inversions_eq_empty hempty
    have hn_bor : (n : D.points k) ∈ D.borelSubgroup k :=
      D.range_torusPoints_le_borelSubgroup k
        ((D.weylProjection_eq_one_iff_mem_range_torusPoints k n).mp (hn.trans hw1))
    refine ⟨1, one_mem _, (n : D.points k)⁻¹ * x * (n : D.points k), ?_, by group⟩
    exact (D.borelSubgroup k).mul_mem
      ((D.borelSubgroup k).mul_mem ((D.borelSubgroup k).inv_mem hn_bor)
        (D.positivePoints_le_borelSubgroup k hx)) hn_bor
  | succ m ih =>
    intro w hw n hn x hx
    have hw_inv : (inversions P b₀ w⁻¹).ncard = m + 1 := (ncard_inversions_inv P b₀ w).trans hw
    have hw_ne : w⁻¹ ≠ 1 := fun h1 => by rw [h1, ncard_inversions_one] at hw_inv; omega
    obtain ⟨α, hα_supp, hα_inv⟩ := exists_mem_support_mem_inversions_of_ne_one P b₀ hw_ne
    obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support
      (by rwa [t.support_rationalBase ht])
    have hdrop :
        (inversions P b₀ (RootPairing.weylGroup.ofIdx P (t.simpleIndex ht i) * w)).ncard = m := by
      have h1 := ncard_inversions_ofIdx_mul P b₀ w (t.simpleIndex ht i)
      have h2 := ncard_inversions_mul_ofIdx_of_mem P w⁻¹ b₀ hα_supp hα_inv
      omega
    exact D.exists_bruhatStep_of_mem_inversions k hα_inv n hn (ih hdrop) hx

/-- **Inversion-subgroup characterization.** For any lift `n : D.weylSubgroup k` over a field `k`,
the intersection `U(k) ∩ n U⁻(k) n⁻¹` is generated by the root subgroups at the positive roots sent
to negative roots by `(D.weylProjection k n)⁻¹`. -/
theorem positivePoints_inf_conj_negativePoints_eq_iSup (n : D.weylSubgroup k) :
    D.positivePoints k ⊓ (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom =
      ⨆ γ ∈ inversions (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht)
          (D.weylProjection k n)⁻¹,
        (D.rootSubgroupPoints γ k).range := by
  apply le_antisymm
  · intro x hx
    obtain ⟨u, hu, b, hb, hmul⟩ :=
      D.exists_mem_iSup_inversions_mul_borelSubgroup_of_ncard k _ rfl n rfl hx.1
    have hu_inf := D.iSup_inversions_le_positivePoints_inf_conj_negativePoints k n hu
    have heq : (⟨x, hx⟩ : ↥(D.positivePoints k ⊓ _)).val * (n : D.points k) *
        (1 : D.borelSubgroup k).val =
        (⟨u, hu_inf⟩ : ↥(D.positivePoints k ⊓ _)).val * (n : D.points k) *
        (⟨b, hb⟩ : D.borelSubgroup k).val := by
      simpa only [Subgroup.coe_one, mul_one] using hmul
    have hpair := D.bruhatNormalForm_unique k n heq
    have hxu : x = u := congrArg (fun p => p.1.val) hpair
    rwa [hxu]
  · exact D.iSup_inversions_le_positivePoints_inf_conj_negativePoints k n

/-- **Steinberg's Bruhat normal form on a double coset.** Over every field `k`, each element of
`B(k) n B(k)` writes uniquely as `u * n * b` with `u ∈ U(k) ∩ n U⁻(k) n⁻¹` and `b ∈ B(k)`. -/
theorem existsUnique_bruhatNormalForm_of_mem_doubleCoset (n : D.weylSubgroup k) {g : D.points k}
    (hg : g ∈ DoubleCoset.doubleCoset (n : D.points k) (D.borelSubgroup k) (D.borelSubgroup k)) :
    ∃! p :
        ↥(D.positivePoints k ⊓
            (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom) ×
          D.borelSubgroup k,
      (p.1 : D.points k) * (n : D.points k) * (p.2 : D.points k) = g := by
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
  obtain ⟨x, hx, s, rfl⟩ := (D.mem_borelSubgroup_iff k).mp hb₁
  have ht'_bor : (n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k) ∈ D.borelSubgroup k := by
    let ts : D.weylSubgroup k := ⟨D.torusPoints k s, D.torusPoints_mem_weylSubgroup k s⟩
    have hconj : n⁻¹ * ts * n⁻¹⁻¹ ∈ ((D.torusPoints k).range).subgroupOf (D.weylSubgroup k) :=
      (D.normal_torusPoints_subgroupOf_weylSubgroup k).conj_mem ts ⟨s, rfl⟩ n⁻¹
    rw [inv_inv] at hconj
    exact D.range_torusPoints_le_borelSubgroup k hconj
  obtain ⟨u, hu, b₀, hb₀, hxn⟩ :=
    D.exists_mem_iSup_inversions_mul_borelSubgroup_of_ncard k _ rfl n rfl hx
  have hu_inf := D.iSup_inversions_le_positivePoints_inf_conj_negativePoints k n hu
  let p₀ :
      ↥(D.positivePoints k ⊓
          (D.negativePoints k).map (MulAut.conj (n : D.points k)).toMonoidHom) ×
        D.borelSubgroup k :=
    (⟨u, hu_inf⟩, ⟨b₀ * ((n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k)) * b₂,
      mul_mem (mul_mem hb₀ ht'_bor) hb₂⟩)
  have hp₀ : (p₀.1 : D.points k) * (n : D.points k) * (p₀.2 : D.points k) =
      x * D.torusPoints k s * (n : D.points k) * b₂ := by
    calc
      u * (n : D.points k) *
          (b₀ * ((n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k)) * b₂) =
          (u * (n : D.points k) * b₀) *
            ((n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k)) * b₂ := by group
      _ = (x * (n : D.points k)) *
            ((n : D.points k)⁻¹ * D.torusPoints k s * (n : D.points k)) * b₂ := by rw [← hxn]
      _ = x * D.torusPoints k s * (n : D.points k) * b₂ := by group
  exact ⟨p₀, hp₀, fun p hp => D.bruhatNormalForm_unique k n (hp.trans hp₀.symm)⟩

/-- **Global Steinberg normal form on `E(k)`.** Given any section `rep` of `D.weylProjection k`,
every element of `D.extendedElementarySubgroup k` decomposes into a unique triple `(w, u, b)` with
`w ∈ W`, `u ∈ U(k) ∩ rep(w) U⁻(k) rep(w)⁻¹`, and `b ∈ B(k)`. -/
theorem existsUnique_bruhatNormalForm_of_mem_extendedElementarySubgroup
    (rep : (t.simplyConnectedRootDatum ht).weylGroup → D.weylSubgroup k)
    (hrep : ∀ w, D.weylProjection k (rep w) = w) {g : D.points k}
    (hg : g ∈ D.extendedElementarySubgroup k) :
    ∃! q : Σ w : (t.simplyConnectedRootDatum ht).weylGroup,
        ↥(D.positivePoints k ⊓
            (D.negativePoints k).map (MulAut.conj (rep w : D.points k)).toMonoidHom) ×
          D.borelSubgroup k,
      (q.2.1 : D.points k) * (rep q.1 : D.points k) * (q.2.2 : D.points k) = g := by
  obtain ⟨w, hw, hw_uniq⟩ := D.existsUnique_mem_bruhatCell_of_mem_extendedElementarySubgroup k hg
  have hg_dc : g ∈ DoubleCoset.doubleCoset (rep w : D.points k)
      (D.borelSubgroup k) (D.borelSubgroup k) := by
    rwa [← D.bruhatCell_weylProjection k (rep w), hrep w]
  obtain ⟨p, hp, hp_uniq⟩ := D.existsUnique_bruhatNormalForm_of_mem_doubleCoset k (rep w) hg_dc
  refine ⟨⟨w, p⟩, hp, ?_⟩
  rintro ⟨w', p'⟩ hp'
  have hw' : g ∈ D.bruhatCell k w' := by
    rw [← hrep w', D.bruhatCell_weylProjection k (rep w')]
    exact DoubleCoset.mem_doubleCoset.mpr
      ⟨p'.1.val, D.positivePoints_le_borelSubgroup k p'.1.2.1, p'.2.val, p'.2.2, hp'.symm⟩
  have hweq : w' = w := hw_uniq w' hw'
  subst hweq
  exact congrArg (Sigma.mk w') (hp_uniq p' hp')

end TauCeti.DynkinType.ChevalleyDatum
