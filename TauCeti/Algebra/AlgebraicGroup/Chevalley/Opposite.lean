module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.OppositeBorel
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Weight.Order
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.WeightDegree

/-!
# Opposite root subgroups of a Chevalley datum

On the base-changed admissible lattice of a Chevalley datum, let `U⁺` and `U⁻` be generated
by all positive and all negative root subgroups, respectively. Over every commutative ring,
`U⁺ ∩ (U⁻ ⊔ T) = 1` and `U⁻ ∩ (U⁺ ⊔ T) = 1`, where `T` is the actual weight-lattice
torus, not merely the image of the full-weight parametrization. These are the
opposite-intersection inputs to uniqueness of
Bruhat and big-cell factorizations. No existence of those factorizations or generation of
all scheme points is asserted. The point-level subgroup `negativePoints` realizes `U⁻` inside
`D.points`; both opposite-Borel disjointness statements are transported to datum points.

The negative subgroup uses the same named root vectors and enumeration as the positive one.
The intersection specializes the generic opposite-intersection theorem in
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.OppositeBorel`:
height orders the weight basis, positive roots act upper unitriangularly, negative roots act
lower unitriangularly, and the actual torus acts diagonally. Its coordinate characters need
not be the Cartan weights.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorem 4 and its proof.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.3 and 8.3.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v v'

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

-- Use the module structure carried by the integer algebra in scalar extensions.
attribute [local instance high] Algebra.toModule

/-- The subgroup generated by all negative root subgroups on the base-changed admissible
lattice. Negativity is relative to the pinned Bourbaki base. -/
noncomputable def negativeSubgroup (A : CommAlgCat.{v} ℤ) :
    Subgroup (LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)) :=
  kostantSubsystemSubgroup (t.chevalleySystem ht) (t.lieBasis ht).h D.representation
    D.lattice (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
    (isNilpotent_apply_ι_chevalleySystem D.representation
      D.isNilpotent_representation_rootGenerator)
    (negRoots (t.rationalRootSystem ht) (t.rationalBase ht)) A

/-- The negative subgroup is generated by the existing all-root exponential maps. -/
theorem negativeSubgroup_eq_closure (A : CommAlgCat.{v} ℤ) :
    D.negativeSubgroup A = Subgroup.closure
      {g | ∃ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        ∃ u, chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ A u = g} := by
  simp only [negativeSubgroup, kostantSubsystemSubgroup_eq_closure,
    kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator]

/-- A subgroup contains the negative subgroup exactly when it contains every negative
root subgroup. -/
theorem negativeSubgroup_le_iff {A : CommAlgCat.{v} ℤ}
    {P : Subgroup (LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice))} :
    D.negativeSubgroup A ≤ P ↔
      ∀ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ u,
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ A u ∈ P := by
  simp only [negativeSubgroup, kostantSubsystemSubgroup_le_iff,
    kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator]

/-- Every negative root element belongs to the negative subgroup. -/
theorem chevalleyRootSubgroup_mem_negativeSubgroup (A : CommAlgCat.{v} ℤ)
    {γ : Fin t.numRoots}
    (hγ : γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Multiplicative A) :
    chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ A u ∈ D.negativeSubgroup A :=
  (D.negativeSubgroup_le_iff.mp le_rfl) γ hγ u

/-- The negative subgroup lies in the elementary subgroup generated by the positive and negative
simple root subgroups. -/
theorem negativeSubgroup_le_kostantElementarySubgroup (A : CommAlgCat.{v} ℤ) :
    D.negativeSubgroup A ≤ kostantElementarySubgroup (t.lieBasis ht).rootGenerator
      (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator A := by
  exact D.negativeSubgroup_le_iff.mpr fun γ _ u =>
    chevalleyRootSubgroup_mem_kostantElementarySubgroup D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A u

/-- The matrix image of the negative subgroup consists of points of the Chevalley datum. -/
theorem map_negativeSubgroup_le_points (A : Type v) [CommRing A] :
    (D.negativeSubgroup (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) ≤
      D.points A := by
  rw [D.points_eq_kostantToralPointsSubgroup]
  exact (Subgroup.map_mono
    (D.negativeSubgroup_le_kostantElementarySubgroup (CommAlgCat.of ℤ A))).trans
    ((map_kostantElementarySubgroup_le_generatedPoints (t.lieBasis ht).rootGenerator
      (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator D.basis A).trans
      (kostantGeneratedPointsSubgroup_le_toralPoints (t.lieBasis ht).rootGenerator
        (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator D.basis D.coordinateWeight A))

/-- Scalar extension carries the negative subgroup into the negative subgroup. -/
theorem map_negativeSubgroup_le {A B : CommAlgCat.{v} ℤ} (f : A ⟶ B) :
    (D.negativeSubgroup A).map
        (GeneralLinear.mapScalarExtensionAutomorphisms (V := D.lattice) f).hom ≤
      D.negativeSubgroup B := by
  unfold negativeSubgroup
  exact map_kostantSubsystemSubgroup_le _ _ _ _ _ _ _ f

/-- The negative subgroup inside the datum's points, in the given weight basis. -/
noncomputable def negativePoints (A : Type v) [CommRing A] : Subgroup (D.points A) :=
  ((D.negativeSubgroup (CommAlgCat.of ℤ A)).map
    (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv)).subgroupOf
      (D.points A)

/-- A datum point is negative exactly when its matrix comes from the negative lattice subgroup. -/
theorem mem_negativePoints_iff {A : Type v} [CommRing A] {g : D.points A} :
    g ∈ D.negativePoints A ↔
      g.val ∈ (D.negativeSubgroup (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) :=
  Iff.rfl

/-- Forgetting the datum-point subtype gives the matrix image of the negative lattice subgroup. -/
theorem map_negativePoints_subtype (A : Type v) [CommRing A] :
    (D.negativePoints A).map (D.points A).subtype =
      (D.negativeSubgroup (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) :=
  Subgroup.map_subgroupOf_eq_of_le (D.map_negativeSubgroup_le_points A)

/-- The negative point subgroup is generated by all negative root maps. -/
theorem negativePoints_eq_closure (A : Type v) [CommRing A] :
    D.negativePoints A = Subgroup.closure
      {g | ∃ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        ∃ u, D.rootSubgroupPoints γ A u = g} := by
  apply Subgroup.map_injective (D.points A).subtype_injective
  rw [D.map_negativePoints_subtype, D.negativeSubgroup_eq_closure,
    MonoidHom.map_closure, MonoidHom.map_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨_, ⟨γ, hγ, u, rfl⟩, h⟩
    exact ⟨D.rootSubgroupPoints γ A u, ⟨γ, hγ, u, rfl⟩,
      (D.coe_rootSubgroupPoints γ A u).trans h⟩
  · rintro ⟨_, ⟨γ, hγ, u, rfl⟩, h⟩
    exact ⟨_, ⟨γ, hγ, u, rfl⟩, (D.coe_rootSubgroupPoints γ A u).symm.trans h⟩

/-- Containment of negative points can be checked on all negative root parameters. -/
theorem negativePoints_le_iff {A : Type v} [CommRing A] {P : Subgroup (D.points A)} :
    D.negativePoints A ≤ P ↔
      ∀ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ u,
        D.rootSubgroupPoints γ A u ∈ P := by
  rw [D.negativePoints_eq_closure, Subgroup.closure_le]
  constructor
  · intro h γ hγ u
    exact h ⟨γ, hγ, u, rfl⟩
  · rintro h _ ⟨γ, hγ, u, rfl⟩
    exact h γ hγ u

/-- Each negative root element belongs to the negative point subgroup. -/
@[simp]
theorem rootSubgroupPoints_mem_negativePoints (A : Type v) [CommRing A] {γ : Fin t.numRoots}
    (hγ : γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Multiplicative A) : D.rootSubgroupPoints γ A u ∈ D.negativePoints A :=
  (D.negativePoints_le_iff.mp le_rfl) γ hγ u

/-- Ring maps preserve the negative point subgroup. -/
theorem map_negativePoints_le {A : Type v} {B : Type v'} [CommRing A] [CommRing B]
    (f : A →+* B) :
    (D.negativePoints A).map ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      D.negativePoints B := by
  rw [Subgroup.map_le_iff_le_comap, D.negativePoints_le_iff]
  intro γ hγ u
  simpa only [Subgroup.mem_comap, D.map_rootSubgroupPoints] using
    D.rootSubgroupPoints_mem_negativePoints B hγ (Multiplicative.ofAdd (f u.toAdd))

private theorem closure_inf_closure_sup_range_kostantTorusPoints_eq_bot
    (degree : (Fin t.rank → ℤ) →+ ℚ) {S S' : Set (Fin t.numRoots)}
    (hS : ∀ γ ∈ S, 0 < degree ((t.simplyConnectedRootDatum ht).root γ))
    (hS' : ∀ γ ∈ S', degree ((t.simplyConnectedRootDatum ht).root γ) < 0)
    (A : Type v) [CommRing A] :
    Subgroup.closure {g | ∃ γ ∈ S, ∃ u,
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) u = g} ⊓
      (Subgroup.closure {g | ∃ γ ∈ S', ∃ u,
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) u = g} ⊔
        (kostantTorusPoints D.lattice D.basis D.coordinateWeight (CommAlgCat.of ℤ A)).range) =
      ⊥ := by
  -- Order the existing basis without changing the actual torus or its coordinate characters.
  let e := orderedWeightIndexEquiv degree D.weight
  have hpos : ∀ γ ∈ S, ∀ {r s : Fin D.dim} {m : ℕ}, 0 < m →
      D.weight r = D.weight s + m • (t.simplyConnectedRootDatum ht).root γ → e r < e s := by
    intro γ hγ r s m hm hrs
    exact orderedWeightIndexEquiv_lt_of_eq_add_nsmul degree D.weight (hS γ hγ) hm hrs
  have hneg : ∀ γ ∈ S', ∀ {r s : Fin D.dim} {m : ℕ}, 0 < m →
      D.weight r = D.weight s + m • (t.simplyConnectedRootDatum ht).root γ → e s < e r := by
    intro γ hγ r s m hm hrs
    exact orderedWeightIndexEquiv_lt_of_eq_add_nsmul_of_neg degree D.weight (hS' γ hγ) hm hrs
  let : LinearOrder (Fin D.dim) := LinearOrder.lift' e e.injective
  have hinter :=
    kostantSubsystemSubgroup_inf_kostantSubsystemSubgroup_sup_range_kostantTorusPoints_eq_bot
    (t.chevalleySystem ht) (t.lieBasis ht).h D.representation D.lattice
    (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
    (isNilpotent_apply_ι_chevalleySystem D.representation
      D.isNilpotent_representation_rootGenerator)
    D.basis D.weight (t.simplyConnectedRootDatum ht).root D.coordinateWeight
    D.isCartanWeightVector_basis S S'
    (fun γ _ i => t.lie_lieBasis_h_chevalleySystem ht γ i)
    (fun γ _ i => t.lie_lieBasis_h_chevalleySystem ht γ i) hpos hneg A
  simpa only [kostantSubsystemSubgroup_eq_closure,
    kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator] using hinter

/-- The subgroup generated by all positive roots meets the subgroup generated by the negative
roots and the actual weight-lattice torus trivially. This holds over arbitrary commutative
rings, including nonreduced rings and fields of bad characteristic. -/
@[simp]
theorem positiveSubgroup_inf_negativeSubgroup_sup_range_kostantTorusPoints_eq_bot
    (A : Type v) [CommRing A] :
    D.positiveSubgroup (CommAlgCat.of ℤ A) ⊓
        (D.negativeSubgroup (CommAlgCat.of ℤ A) ⊔
          (kostantTorusPoints D.lattice D.basis D.coordinateWeight (CommAlgCat.of ℤ A)).range) =
      ⊥ := by
  rw [D.positiveSubgroup_eq_closure, D.negativeSubgroup_eq_closure]
  exact D.closure_inf_closure_sup_range_kostantTorusPoints_eq_bot (t.weightDegree ht)
    (fun _ hγ => t.weightDegree_root_pos ht hγ)
    (fun _ hγ => t.weightDegree_root_neg ht hγ) A

/-- The negative subgroup meets the subgroup generated by the positive roots and the actual
weight-lattice torus trivially, over every commutative value ring. -/
@[simp]
theorem negativeSubgroup_inf_positiveSubgroup_sup_range_kostantTorusPoints_eq_bot
    (A : Type v) [CommRing A] :
    D.negativeSubgroup (CommAlgCat.of ℤ A) ⊓
        (D.positiveSubgroup (CommAlgCat.of ℤ A) ⊔
          (kostantTorusPoints D.lattice D.basis D.coordinateWeight (CommAlgCat.of ℤ A)).range) =
      ⊥ := by
  rw [D.negativeSubgroup_eq_closure, D.positiveSubgroup_eq_closure]
  exact D.closure_inf_closure_sup_range_kostantTorusPoints_eq_bot (-t.weightDegree ht)
    (fun _ hγ => neg_pos.mpr (t.weightDegree_root_neg ht hγ))
    (fun _ hγ => neg_neg_of_pos (t.weightDegree_root_pos ht hγ)) A

private theorem opposite_points_disjoint (A : Type v) [CommRing A] :
    Disjoint (D.positivePoints A) (D.negativePoints A ⊔ (D.torusPoints A).range) ∧
    Disjoint (D.negativePoints A) (D.positivePoints A ⊔ (D.torusPoints A).range) := by
  let f := Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMonoidHom
  have hf : Function.Injective f :=
    Units.map_injective (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).injective
  have htorus : ((D.torusPoints A).range).map (D.points A).subtype =
      ((kostantTorusPoints D.lattice D.basis D.coordinateWeight
        (CommAlgCat.of ℤ A)).range).map f := by
    rw [MonoidHom.map_range, MonoidHom.map_range]
    congr 1
    apply MonoidHom.ext
    intro s
    simp only [MonoidHom.comp_apply, Subgroup.subtype_apply, D.coe_torusPoints, f,
      MulEquiv.toMonoidHom_eq_coe, basisMatrix_kostantTorusPoints]
  constructor
  · have hm := Subgroup.disjoint_map hf (disjoint_iff.mpr
      (D.positiveSubgroup_inf_negativeSubgroup_sup_range_kostantTorusPoints_eq_bot A))
    rw [Subgroup.map_sup] at hm
    simp only [f, MulEquiv.toMonoidHom_eq_coe] at hm htorus
    rw [← D.map_positivePoints_subtype A, ← D.map_negativePoints_subtype A,
      ← htorus, ← Subgroup.map_sup] at hm
    rw [Subgroup.disjoint_def] at hm ⊢
    intro g hg hn
    apply (D.points A).subtype_injective
    exact hm ⟨g, hg, rfl⟩ ⟨g, hn, rfl⟩
  · have hm := Subgroup.disjoint_map hf (disjoint_iff.mpr
      (D.negativeSubgroup_inf_positiveSubgroup_sup_range_kostantTorusPoints_eq_bot A))
    rw [Subgroup.map_sup] at hm
    simp only [f, MulEquiv.toMonoidHom_eq_coe] at hm htorus
    rw [← D.map_negativePoints_subtype A, ← D.map_positivePoints_subtype A,
      ← htorus, ← Subgroup.map_sup] at hm
    rw [Subgroup.disjoint_def] at hm ⊢
    intro g hg hn
    apply (D.points A).subtype_injective
    exact hm ⟨g, hg, rfl⟩ ⟨g, hn, rfl⟩

/-- Positive points meet the negative subgroup and actual torus trivially over every
commutative ring. -/
theorem disjoint_positivePoints_negativePoints_sup_range_torusPoints
    (A : Type v) [CommRing A] :
    Disjoint (D.positivePoints A) (D.negativePoints A ⊔ (D.torusPoints A).range) :=
  (D.opposite_points_disjoint A).1

/-- Negative points meet the positive subgroup and actual torus trivially over every
commutative ring. -/
theorem disjoint_negativePoints_positivePoints_sup_range_torusPoints
    (A : Type v) [CommRing A] :
    Disjoint (D.negativePoints A) (D.positivePoints A ⊔ (D.torusPoints A).range) :=
  (D.opposite_points_disjoint A).2

/-- Positive and negative datum points are disjoint over every commutative ring. -/
theorem disjoint_positivePoints_negativePoints (A : Type v) [CommRing A] :
    Disjoint (D.positivePoints A) (D.negativePoints A) :=
  (D.disjoint_positivePoints_negativePoints_sup_range_torusPoints A).mono_right le_sup_left

end TauCeti.DynkinType.ChevalleyDatum
