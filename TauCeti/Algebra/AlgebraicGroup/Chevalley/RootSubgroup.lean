module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Datum
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Subgroup

/-!
# Root subgroups of a Chevalley datum at every root

The group scheme of a Chevalley datum `D` of a valid Dynkin type `t` is generated inside `GLₙ` by
the root subgroups of the numbered Chevalley generators `eᵢ`, `fᵢ`, that is, of the simple roots
and their negatives, together with its torus. This file constructs, on the points of `D` with
values in any commutative ring `A`, the root subgroup

```text
x_γ(u) = ∑ₙ uⁿ ρ(e_γ)⁽ⁿ⁾
```

of **every** root `γ`, numbered as in `TauCeti.DynkinType.simplyConnectedRootDatum`, where `e_γ`
is the named root vector `TauCeti.DynkinType.chevalleySystem t ht γ`. In the coordinates of the
weight basis of `D` it is the matrix of `TauCeti.DynkinType.chevalleyRootSubgroup`; it lies in the
points of `D` because every root subgroup lies in the group generated by the simple ones
(`TauCeti.DynkinType.chevalleyRootSubgroup_mem_kostantElementarySubgroup`).

Following Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 19, write
`n_γ(s) = x_γ(s) x_{-γ}(-s⁻¹) x_γ(s)` for a root `γ` and a unit `s`. The main results are:

* at `±αᵢ` the root subgroup is the numbered root subgroup of the Kostant data from which the
  group scheme is generated;
* the root subgroups are natural in the ring of points;
* the Weyl element `nᵢ = n_{αᵢ}(1)` of a simple root conjugates root subgroups into root
  subgroups, `nᵢ x_γ(u) nᵢ⁻¹ = x_{sᵢ γ}(ε u)` with the sign `ε = ±1` of
  `TauCeti.DynkinType.chevalleyWeylSign`, so that every root subgroup lies in the subgroup of
  points generated by the root subgroups of the simple roots and their negatives;
* the **pinning equation** `t x_γ(u) t⁻¹ = x_γ(γ(t) u)` for every root `γ` and every point `t` of
  the torus of `D`, the split torus with character lattice `Λ(D)`. The root `γ` lies in `Λ(D)`
  (`TauCeti.DynkinType.ChevalleyDatum.root_mem_weightLattice`), and its value at the torus point
  with parameter `s` is the character of `s` given by the coordinate root
  `TauCeti.DynkinType.ChevalleyDatum.coordinateRoot`.

## Main definitions

* `TauCeti.DynkinType.ChevalleyDatum.rootSubgroup`: the root subgroup `x_γ` of every root on the
  points of a Chevalley datum.
* `TauCeti.DynkinType.ChevalleyDatum.weylElement`: the element `n_γ(s)`.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.coe_rootSubgroup_simpleIndex` and
  `TauCeti.DynkinType.ChevalleyDatum.coe_rootSubgroup_reflectionPerm_simpleIndex`: at `±αᵢ` these
  are the numbered root subgroups of the Kostant data.
* `TauCeti.DynkinType.ChevalleyDatum.map_rootSubgroup`: naturality in the ring of points.
* `TauCeti.DynkinType.ChevalleyDatum.weylElement_conj_rootSubgroup`: the signed conjugation
  identity `nᵢ x_γ(u) nᵢ⁻¹ = x_{sᵢ γ}(ε u)`.
* `TauCeti.DynkinType.ChevalleyDatum.rootSubgroup_mem_closure`: every root subgroup lies in the
  subgroup generated by the root subgroups of the simple roots and their negatives.
* `TauCeti.DynkinType.ChevalleyDatum.torusPoints_conj_rootSubgroup`: the pinning equation.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, AMS University Lecture Series 66 (2016),
  Chapter 3.
* R. W. Carter, *Simple Groups of Lie Type*, §§6.4 and 7.1.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v v'

-- Match tensor products to the `ℤ`-algebra instance stored by `CommAlgCat` objects.
attribute [local instance high] Algebra.toModule

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-! ## The root subgroups -/

/-- Written in the weight basis, every element of the root subgroup of a root is a point of the
datum: it lies in the group generated by the simple root subgroups. -/
private theorem basisMatrix_chevalleyRootSubgroup_mem_points (γ : Fin t.numRoots)
    (A : Type v) [CommRing A] (u : Multiplicative A) :
    Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
        (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) u) ∈
      D.points A := by
  rw [points_eq_kostantToralPointsSubgroup]
  exact kostantGeneratedPointsSubgroup_le_toralPoints _ _ _ _ _ _ _ _ A
    (map_kostantElementarySubgroup_le_generatedPoints _ _ _ _ _ _ _ A
      (Subgroup.mem_map_of_mem _
        (chevalleyRootSubgroup_mem_kostantElementarySubgroup D.representation D.lattice
          D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ
          (CommAlgCat.of ℤ A) u)))

/-- **The root subgroup of a root** `γ` on the points of a Chevalley datum with values in a
commutative ring `A`: the one-parameter subgroup `u ↦ x_γ(u) = ∑ₙ uⁿ ρ(e_γ)⁽ⁿ⁾` of the named
root vector `e_γ`, written in the weight basis of the datum. -/
noncomputable def rootSubgroup (γ : Fin t.numRoots) (A : Type v) [CommRing A] :
    Multiplicative A →* D.points A :=
  MonoidHom.codRestrict
    ((Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMonoidHom).comp
      (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A)))
    (D.points A) (D.basisMatrix_chevalleyRootSubgroup_mem_points γ A)

/-- An element of the root subgroup of a root is the matrix, in the weight basis, of the
divided-power exponential of the root vector. -/
-- Not `@[simp]`: at `±αᵢ` the normal form is the numbered Kostant root subgroup matrix of
-- `coe_rootSubgroup_simpleIndex`, which this unfolding would preempt.
theorem coe_rootSubgroup (γ : Fin t.numRoots) (A : Type v) [CommRing A] (u : Multiplicative A) :
    (D.rootSubgroup γ A u : Matrix.GeneralLinearGroup (Fin D.dim) A) =
      Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
        (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) u) :=
  (rfl)

/-- **At a simple root the root subgroup is the numbered root subgroup** `xᵢ` of the Kostant data
generating the group scheme. -/
@[simp]
theorem coe_rootSubgroup_simpleIndex (i : Fin t.rank) (A : Type v) [CommRing A]
    (u : Multiplicative A) :
    (D.rootSubgroup (t.simpleIndex ht i) A u : Matrix.GeneralLinearGroup (Fin D.dim) A) =
      kostantRootSubgroupMatrix (t.lieBasis ht).rootGenerator (t.lieBasis ht).h D.representation
        D.lattice D.representation_mem_lattice (.inl i)
        (D.isNilpotent_representation_rootGenerator (.inl i)) D.basis
        ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm u) := by
  rw [coe_rootSubgroup, chevalleyRootSubgroup_simpleIndex, basisMatrix_kostantRootSubgroupParam]

/-- **At a negative simple root the root subgroup is the numbered root subgroup** `x₋ᵢ` of the
Kostant data generating the group scheme. -/
@[simp]
theorem coe_rootSubgroup_reflectionPerm_simpleIndex (i : Fin t.rank) (A : Type v) [CommRing A]
    (u : Multiplicative A) :
    (D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
        (t.simpleIndex ht i)) A u : Matrix.GeneralLinearGroup (Fin D.dim) A) =
      kostantRootSubgroupMatrix (t.lieBasis ht).rootGenerator (t.lieBasis ht).h D.representation
        D.lattice D.representation_mem_lattice (.inr i)
        (D.isNilpotent_representation_rootGenerator (.inr i)) D.basis
        ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm u) := by
  rw [coe_rootSubgroup, chevalleyRootSubgroup_reflectionPerm_simpleIndex,
    basisMatrix_kostantRootSubgroupParam]

/-- **The root subgroups are natural in the ring of points.** Applying a ring homomorphism
`φ : A →+* B` entrywise to `x_γ(u)` gives `x_γ(φ u)`. -/
theorem map_rootSubgroup {A : Type v} {B : Type v'} [CommRing A] [CommRing B] (φ : A →+* B)
    (γ : Fin t.numRoots) (u : Multiplicative A) :
    Matrix.GeneralLinearGroup.map φ
        (D.rootSubgroup γ A u : Matrix.GeneralLinearGroup (Fin D.dim) A) =
      (D.rootSubgroup γ B (Multiplicative.ofAdd (φ (Multiplicative.toAdd u))) :
        Matrix.GeneralLinearGroup (Fin D.dim) B) := by
  have hmatrix := Module.Basis.map_toMatrixAlgEquiv_baseChange D.basis φ.toIntAlgHom
    (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A) u).val
    (chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ B)
      (Multiplicative.ofAdd (φ (Multiplicative.toAdd u)))).val
    (fun z => by
      rw [chevalleyRootSubgroup_val, chevalleyRootSubgroup_val, toAdd_ofAdd]
      exact map_baseChangeExp_algHom φ.toIntAlgHom _ _ _ _ z)
  refine Matrix.GeneralLinearGroup.ext fun r c => ?_
  rw [Matrix.GeneralLinearGroup.map_apply, coe_rootSubgroup, coe_rootSubgroup]
  simpa [LinearMap.toMatrixAlgEquiv_apply] using congrFun (congrFun hmatrix r) c

/-! ## Weyl elements -/

/-- **Steinberg's element** `n_γ(s) = x_γ(s) x_{-γ}(-s⁻¹) x_γ(s)` of a root `γ` and a unit `s`,
a point of the Chevalley datum. At `s = 1` and a simple root it is Chevalley's Weyl element, which
conjugates root subgroups into root subgroups
(`TauCeti.DynkinType.ChevalleyDatum.weylElement_conj_rootSubgroup`). -/
noncomputable def weylElement (γ : Fin t.numRoots) (A : Type v) [CommRing A] (s : Aˣ) :
    D.points A :=
  D.rootSubgroup γ A (Multiplicative.ofAdd (s : A)) *
    D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) A
      (Multiplicative.ofAdd (-((s⁻¹ : Aˣ) : A))) *
    D.rootSubgroup γ A (Multiplicative.ofAdd (s : A))

/-- Steinberg's element is the product `x_γ(s) x_{-γ}(-s⁻¹) x_γ(s)` of root subgroup elements. -/
theorem weylElement_def (γ : Fin t.numRoots) (A : Type v) [CommRing A] (s : Aˣ) :
    D.weylElement γ A s =
      D.rootSubgroup γ A (Multiplicative.ofAdd (s : A)) *
        D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) A
          (Multiplicative.ofAdd (-((s⁻¹ : Aˣ) : A))) *
        D.rootSubgroup γ A (Multiplicative.ofAdd (s : A)) :=
  (rfl)

/-- At a simple root, the Weyl element `n_{αᵢ}(1)` is the Weyl element of the Kostant data, written
in the weight basis. -/
theorem coe_weylElement_simpleIndex_one (i : Fin t.rank) (A : Type v) [CommRing A] :
    (D.weylElement (t.simpleIndex ht i) A 1 : Matrix.GeneralLinearGroup (Fin D.dim) A) =
      Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv
        (kostantWeylGL (t.lieBasis ht).rootGenerator (t.lieBasis ht).h D.representation D.lattice
          D.representation_mem_lattice (D.isNilpotent_representation_rootGenerator (.inl i))
          (D.isNilpotent_representation_rootGenerator (.inr i)) (CommAlgCat.of ℤ A)) := by
  rw [weylElement_def, Subgroup.coe_mul, Subgroup.coe_mul, coe_rootSubgroup, coe_rootSubgroup,
    chevalleyRootSubgroup_simpleIndex, chevalleyRootSubgroup_reflectionPerm_simpleIndex,
    kostantWeylGL_eq_kostantRootSubgroupParam_mul, map_mul, map_mul, inv_one, Units.val_one]

/-- **Conjugating a root subgroup by a simple Weyl element.** Over every ring of points,
`nᵢ x_γ(u) nᵢ⁻¹ = x_{sᵢ γ}(ε u)` for the Weyl element `nᵢ = n_{αᵢ}(1)` of the simple root `αᵢ`
and the sign `ε = chevalleyWeylSign αᵢ γ`. -/
theorem weylElement_conj_rootSubgroup (i : Fin t.rank) (γ : Fin t.numRoots) (A : Type v)
    [CommRing A] (u : A) :
    D.weylElement (t.simpleIndex ht i) A 1 * D.rootSubgroup γ A (Multiplicative.ofAdd u) *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ =
      D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A
        (Multiplicative.ofAdd (((t.chevalleyWeylSign ht (t.simpleIndex ht i) γ : ℤ) : A) * u)) := by
  apply Subtype.ext
  rw [Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv, coe_weylElement_simpleIndex_one,
    coe_rootSubgroup, coe_rootSubgroup, ← map_inv, ← map_mul, ← map_mul]
  exact congrArg _ (kostantWeylGL_conj_chevalleyRootSubgroup D.representation D.lattice
    D.representation_mem_lattice D.isNilpotent_representation_rootGenerator i γ
    (CommAlgCat.of ℤ A) u)

/-- **Every root subgroup lies in the subgroup generated by the simple ones**: over every ring of
points, `x_γ(u)` is a product of elements of the root subgroups of the simple roots and their
negatives. This is `TauCeti.DynkinType.chevalleyRootSubgroup_mem_kostantElementarySubgroup`
written in the weight basis. -/
theorem rootSubgroup_mem_closure (γ : Fin t.numRoots) (A : Type v) [CommRing A]
    (u : Multiplicative A) :
    D.rootSubgroup γ A u ∈ Subgroup.closure (⋃ i : Fin t.rank,
      Set.range (D.rootSubgroup (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) := by
  rw [← Subgroup.mem_map_iff_mem (D.points A).subtype_injective, MonoidHom.map_closure]
  have hmem := Subgroup.mem_map_of_mem
    (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMonoidHom)
    (chevalleyRootSubgroup_mem_kostantElementarySubgroup D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ
      (CommAlgCat.of ℤ A) u)
  rw [kostantElementarySubgroup_eq_closure, MonoidHom.map_closure] at hmem
  refine Subgroup.closure_mono ?_ hmem
  rintro - ⟨-, ⟨-, ⟨i | i, rfl⟩, v, rfl⟩, rfl⟩
  · refine ⟨D.rootSubgroup (t.simpleIndex ht i) A v, Set.mem_iUnion.2 ⟨i, Or.inl ⟨v, rfl⟩⟩, ?_⟩
    rw [Subgroup.coe_subtype, coe_rootSubgroup, chevalleyRootSubgroup_simpleIndex]
    rfl
  · refine ⟨D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
      (t.simpleIndex ht i)) A v, Set.mem_iUnion.2 ⟨i, Or.inr ⟨v, rfl⟩⟩, ?_⟩
    rw [Subgroup.coe_subtype, coe_rootSubgroup, chevalleyRootSubgroup_reflectionPerm_simpleIndex]
    rfl

/-! ## The pinning equation -/

/-- A torus point acts on a weight vector, whose weight `μ` lies in the weight lattice, by the
value of the character given by the coordinates of `μ`. -/
private theorem kostantTorusPoints_coordinateWeight_tmul (A : Type v) [CommRing A]
    {μ : Fin t.rank → ℤ} (hμ : μ ∈ D.weightLattice) {m : D.lattice}
    (hm : IsCartanWeightVector (t.lieBasis ht).h D.representation μ (m : D.carrier))
    (s : Fin t.rank → Aˣ) (a : A) :
    (kostantTorusPoints D.lattice D.basis D.coordinateWeight A s).val (a ⊗ₜ[ℤ] m) =
      ((torusCharacter s (D.weightLatticeBasis.repr ⟨μ, hμ⟩) : A) * a) ⊗ₜ[ℤ] m := by
  rw [kostantTorusPoints_apply,
    basisWeightTorus_apply_of_repr_eq_zero (D.basis.baseChange A) D.coordinateWeight s
      (μ := D.weightLatticeBasis.repr ⟨μ, hμ⟩) (m := a ⊗ₜ[ℤ] m) (fun x hx => ?_),
    smul_tmul', smul_eq_mul]
  have hne : D.weight x ≠ μ := by
    rintro rfl
    exact hx (D.coordinateWeight_def x)
  rw [Module.Basis.baseChange_repr_tmul,
    repr_eq_zero_of_isCartanWeightVector (t.lieBasis ht).h D.representation D.lattice D.basis
      D.weight D.isCartanWeightVector_basis hm hne]
  simp [Algebra.smul_def]

/-- The pinning equation on the automorphisms of the base-changed lattice. -/
private theorem kostantTorusPoints_mul_chevalleyRootSubgroup (γ : Fin t.numRoots) (A : Type v)
    [CommRing A] (s : Fin t.rank → Aˣ) (u : A) :
    kostantTorusPoints D.lattice D.basis D.coordinateWeight A s *
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A)
          (Multiplicative.ofAdd u) =
      chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ (CommAlgCat.of ℤ A)
          (Multiplicative.ofAdd ((torusCharacter s (D.coordinateRoot γ) : A) * u)) *
        kostantTorusPoints D.lattice D.basis D.coordinateWeight A s := by
  refine Units.ext ((D.basis.baseChange A).ext fun x => ?_)
  rw [Units.val_mul, Units.val_mul, mul_apply_eq_comp, mul_apply_eq_comp,
    Module.Basis.baseChange_apply, kostantTorusPoints_tmul_basis, chevalleyRootSubgroup_val,
    chevalleyRootSubgroup_val, toAdd_ofAdd, toAdd_ofAdd, baseChangeExp_tmul, baseChangeExp_tmul,
    map_sum]
  refine Finset.sum_congr rfl fun n _ => ?_
  -- the `n`-th divided power of `e_γ` carries `b x` to a weight vector of weight `wt x + n γ`
  have hμ : D.weight x + n • (t.simplyConnectedRootDatum ht).root γ ∈ D.weightLattice :=
    add_mem (D.weight_mem_weightLattice x) (nsmul_mem (D.root_mem_weightLattice γ) n)
  have hw : IsCartanWeightVector (t.lieBasis ht).h D.representation
      (D.weight x + n • (t.simplyConnectedRootDatum ht).root γ)
      ((integralDividedPower (D.representation
          (_root_.UniversalEnvelopingAlgebra.ι ℚ (t.chevalleySystem ht γ))) D.lattice n
        (dividedPower_chevalleySystem_smul_mem D.representation D.lattice
          D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ n)
        (D.basis x) : D.lattice) : D.carrier) := by
    rw [coe_integralDividedPower_apply]
    exact IsCartanWeightVector.integralDividedPower (t.chevalleySystem ht)
      (t.lie_lieBasis_h_chevalleySystem ht γ) (D.isCartanWeightVector_basis x) n
  have hcoord : D.weightLatticeBasis.repr ⟨_, hμ⟩ =
      D.weightLatticeBasis.repr ⟨D.weight x, D.weight_mem_weightLattice x⟩ +
        n • D.weightLatticeBasis.repr ⟨_, D.root_mem_weightLattice γ⟩ := by
    have hsum : (⟨_, hμ⟩ : D.weightLattice) =
        ⟨D.weight x, D.weight_mem_weightLattice x⟩ + n • ⟨_, D.root_mem_weightLattice γ⟩ :=
      rfl
    rw [hsum, map_add, map_nsmul]
  rw [D.kostantTorusPoints_coordinateWeight_tmul A hμ hw, hcoord, Finsupp.coe_add,
    Finsupp.coe_smul, torusCharacter_add, torusCharacter_nsmul, ← coordinateWeight_def,
    ← coordinateRoot_def]
  push_cast
  ring_nf

/-- **The pinning equation.** For every root `γ`, conjugation by the point of the torus of the
datum with parameter `s` carries `x_γ(u)` to `x_γ(γ(s) u)`, where the value `γ(s)` of the root is
the character of `s` given by the coordinates of `γ` in the chosen basis of the weight lattice. -/
theorem torusPoints_conj_rootSubgroup (γ : Fin t.numRoots) (A : Type v) [CommRing A]
    (s : Fin t.rank → Aˣ) (u : A) :
    D.torusPoints A s * D.rootSubgroup γ A (Multiplicative.ofAdd u) * (D.torusPoints A s)⁻¹ =
      D.rootSubgroup γ A
        (Multiplicative.ofAdd ((torusCharacter s (D.coordinateRoot γ) : A) * u)) := by
  rw [mul_inv_eq_iff_eq_mul]
  apply Subtype.ext
  rw [Subgroup.coe_mul, Subgroup.coe_mul, coe_torusPoints, coe_rootSubgroup, coe_rootSubgroup,
    ← basisMatrix_kostantTorusPoints, ← map_mul, ← map_mul,
    kostantTorusPoints_mul_chevalleyRootSubgroup]

end TauCeti.DynkinType.ChevalleyDatum
