module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Generation
public import TauCeti.Algebra.Group.Subgroup.Pointwise

/-!
# Elementary groups and the actual torus of a Chevalley datum

For a Chevalley datum `D`, `elementarySubgroup` is generated by all root subgroups, whereas
`extendedElementarySubgroup` also includes the actual torus with character lattice
`D.weightLattice`. The pinning equation shows that this torus normalizes the elementary
subgroup. Hence every element of the extended group is a product of an elementary element
and an actual torus point. The elementary subgroup is normal in the extended group, and
both constructions respect a change of coefficient ring. If the units are divisible, the
actual torus is already elementary, so the extended and elementary subgroups coincide.

This factorization is the input for extending comparisons between elementary Chevalley
groups by restriction on their character-lattice tori. It does not assert that these groups
contain all points of the group scheme, nor that the torus factor extends to the full weight
lattice: for an adjoint datum that extension need not exist over the value ring. No uniqueness
of the two factors is claimed; their intersection can be nontrivial.

The root maps and their pinning equation are those of
`TauCeti.DynkinType.ChevalleyDatum.rootSubgroupPoints`. The factorization uses
`Subgroup.mem_sup_of_right_le_normalizer_left`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 28 and Corollary 5 to
  Theorem 4′.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v w

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

/-- The elementary Chevalley subgroup, generated by the root subgroups alone. It need not
contain every point of the actual torus. -/
noncomputable def elementarySubgroup : Subgroup (D.points A) :=
  Subgroup.closure (⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroupPoints γ A))

/-- The elementary subgroup is the closure of all numbered root subgroups. -/
theorem elementarySubgroup_def :
    D.elementarySubgroup A =
      Subgroup.closure (⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroupPoints γ A)) :=
  (rfl)

/-- Every root value belongs to the elementary subgroup. -/
@[simp]
theorem rootSubgroupPoints_mem_elementarySubgroup (γ : Fin t.numRoots) (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.elementarySubgroup A :=
  Subgroup.subset_closure (Set.mem_iUnion.2 ⟨γ, u, rfl⟩)

/-- To contain the elementary subgroup it suffices to contain every root subgroup. -/
theorem elementarySubgroup_le_iff (H : Subgroup (D.points A)) :
    D.elementarySubgroup A ≤ H ↔ ∀ γ u, D.rootSubgroupPoints γ A u ∈ H := by
  simp only [elementarySubgroup_def, Subgroup.closure_le, Set.iUnion_subset_iff,
    Set.range_subset_iff, SetLike.mem_coe]

/-- The positive and negative simple root subgroups already generate the elementary subgroup,
without a field hypothesis. -/
theorem elementarySubgroup_eq_closure_simpleRootPair :
    D.elementarySubgroup A = Subgroup.closure (⋃ i : Fin t.rank,
      Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
        Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) := by
  apply le_antisymm
  · exact (D.elementarySubgroup_le_iff A _).mpr fun γ u =>
      D.rootSubgroupPoints_mem_closure γ A u
  · apply (Subgroup.closure_le _).mpr
    rintro g hg
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hg
    rcases hi with ⟨u, rfl⟩ | ⟨u, rfl⟩ <;>
      exact D.rootSubgroupPoints_mem_elementarySubgroup A _ u

/-- Adjoin the actual character-lattice torus to the elementary subgroup. No equality with
the ambient point group is part of this definition. -/
noncomputable def extendedElementarySubgroup : Subgroup (D.points A) :=
  D.elementarySubgroup A ⊔ (D.torusPoints A).range

/-- The extended elementary subgroup is the join with the actual torus. -/
theorem extendedElementarySubgroup_def :
    D.extendedElementarySubgroup A = D.elementarySubgroup A ⊔ (D.torusPoints A).range :=
  (rfl)

/-- To contain the extended elementary subgroup it suffices to contain every root subgroup
and every actual torus point. -/
theorem extendedElementarySubgroup_le_iff (H : Subgroup (D.points A)) :
    D.extendedElementarySubgroup A ≤ H ↔
      (∀ γ u, D.rootSubgroupPoints γ A u ∈ H) ∧ ∀ s, D.torusPoints A s ∈ H := by
  rw [extendedElementarySubgroup_def, sup_le_iff, D.elementarySubgroup_le_iff]
  refine and_congr Iff.rfl ⟨?_, ?_⟩
  · exact fun h s => h ⟨s, rfl⟩
  · rintro h _ ⟨s, rfl⟩
    exact h s

/-- If the units are divisible, the actual torus lies in the elementary subgroup. -/
theorem range_torusPoints_le_elementarySubgroup [RootableBy Aˣ ℕ] :
    (D.torusPoints A).range ≤ D.elementarySubgroup A := by
  rintro _ ⟨s, rfl⟩
  rw [D.elementarySubgroup_eq_closure_simpleRootPair]
  exact D.torusPoints_mem_closure_rootSubgroup A s

/-- With divisible units, adjoining the actual torus does not enlarge the elementary subgroup.
This applies in particular over algebraically closed fields. -/
@[simp]
theorem extendedElementarySubgroup_eq_elementarySubgroup [RootableBy Aˣ ℕ] :
    D.extendedElementarySubgroup A = D.elementarySubgroup A := by
  rw [extendedElementarySubgroup_def, sup_eq_left]
  exact D.range_torusPoints_le_elementarySubgroup A

/-- Every elementary element belongs to the extended elementary subgroup. -/
theorem elementarySubgroup_le_extendedElementarySubgroup :
    D.elementarySubgroup A ≤ D.extendedElementarySubgroup A :=
  le_sup_left

/-- Every actual torus point belongs to the extended elementary subgroup. -/
@[simp]
theorem torusPoints_mem_extendedElementarySubgroup (s : Fin t.rank → Aˣ) :
    D.torusPoints A s ∈ D.extendedElementarySubgroup A :=
  (le_sup_right : (D.torusPoints A).range ≤ D.extendedElementarySubgroup A) ⟨s, rfl⟩

/-- The actual torus normalizes the elementary subgroup, not just its full-weight
parametrized image. -/
theorem range_torusPoints_le_normalizer_elementarySubgroup :
    (D.torusPoints A).range ≤ Subgroup.normalizer (D.elementarySubgroup A) := by
  rw [elementarySubgroup_def]
  apply Subgroup.le_normalizer_closure_iff.mpr
  rintro _ ⟨s, rfl⟩ _ hg
  obtain ⟨γ, u, rfl⟩ := Set.mem_iUnion.1 hg
  rw [← ofAdd_toAdd u, D.torusPoints_conj_rootSubgroupPoints]
  exact Subgroup.subset_closure (Set.mem_iUnion.2 ⟨γ, _, rfl⟩)

/-- The elementary subgroup is normal inside the group obtained by adjoining the actual torus. -/
instance normal_elementarySubgroup_subgroupOf_extendedElementarySubgroup :
    ((D.elementarySubgroup A).subgroupOf (D.extendedElementarySubgroup A)).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer
    (sup_le (D.elementarySubgroup A).le_normalizer
      (D.range_torusPoints_le_normalizer_elementarySubgroup A))

/-- Every element of the extended elementary subgroup is an elementary element followed by an
actual torus point. This asserts existence, not uniqueness, of the factors. -/
theorem mem_extendedElementarySubgroup_iff (g : D.points A) :
    g ∈ D.extendedElementarySubgroup A ↔
      ∃ e ∈ D.elementarySubgroup A, ∃ s : Fin t.rank → Aˣ, e * D.torusPoints A s = g := by
  rw [extendedElementarySubgroup_def,
    Subgroup.mem_sup_of_right_le_normalizer_left
      (D.range_torusPoints_le_normalizer_elementarySubgroup A)]
  constructor
  · rintro ⟨e, he, _, ⟨s, rfl⟩, h⟩
    exact ⟨e, he, s, h⟩
  · rintro ⟨e, he, s, h⟩
    exact ⟨e, he, _, ⟨s, rfl⟩, h⟩

variable {A} {B : Type w} [CommRing B]

/-- Changing the coefficient ring sends elementary elements to elementary elements. -/
theorem map_elementarySubgroup_le (f : A →+* B) :
    (D.elementarySubgroup A).map ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      D.elementarySubgroup B := by
  rw [Subgroup.map_le_iff_le_comap, D.elementarySubgroup_le_iff]
  intro γ u
  rw [Subgroup.mem_comap, D.map_rootSubgroupPoints]
  exact D.rootSubgroupPoints_mem_elementarySubgroup B _ _

/-- Changing the coefficient ring preserves the extended elementary subgroup, including its
actual torus factor. -/
theorem map_extendedElementarySubgroup_le (f : A →+* B) :
    (D.extendedElementarySubgroup A).map
        ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      D.extendedElementarySubgroup B := by
  rw [Subgroup.map_le_iff_le_comap, D.extendedElementarySubgroup_le_iff]
  constructor
  · intro γ u
    rw [Subgroup.mem_comap, D.map_rootSubgroupPoints]
    exact D.elementarySubgroup_le_extendedElementarySubgroup B
      (D.rootSubgroupPoints_mem_elementarySubgroup B _ _)
  · intro s
    rw [Subgroup.mem_comap, D.map_torusPoints]
    exact D.torusPoints_mem_extendedElementarySubgroup B _

end TauCeti.DynkinType.ChevalleyDatum
