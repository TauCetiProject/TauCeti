module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.RootSubgroup
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Subgroup
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.PositiveSubsystem
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Weight.Order
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.WeightDegree

/-!
# The positive-root subgroup of a Chevalley datum

For a Chevalley datum `D`, the subgroup generated by **all** positive root subgroups on its
base-changed lattice is nilpotent over every commutative ring. Its matrix image lies in the
points of `D`. No assertion that positive simple root subgroups generate this group is made:
that assertion can fail over small fields.

The proof uses the height degree on integral weights and the generic ordered-weight-basis
construction. Every positive root has strictly positive degree, so the whole subgroup embeds
in an upper-unitriangular group. This supplies the nilpotent positive part used in constructing
Borel subgroups. `positivePoints` realizes the same subgroup inside the datum's points; it has
the all-positive-root generation API and is preserved by ring maps. Neither a unique
ordered-product expression nor a scheme-theoretic unipotent radical is asserted here.

The ordered-basis argument specializes the generic Kostant subsystem theory, as does the
simple-root-only argument in `DynkinType.isNilpotent_geckPositiveSubgroup`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17.
* R. W. Carter, *Simple Groups of Lie Type*, §§4.4 and 5.3.
-/

public section

open CategoryTheory TensorProduct
open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v v'

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

-- Use the module structure carried by the integer algebra structure in scalar extensions.
attribute [local instance high] Algebra.toModule

/-- The subgroup generated by every positive root subgroup on the base-changed admissible
lattice of a Chevalley datum. Positivity is measured in the pinned Bourbaki base. -/
noncomputable def positiveSubgroup (A : CommAlgCat.{v} ℤ) :
    Subgroup (LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)) :=
  kostantSubsystemSubgroup (t.chevalleySystem ht) (t.lieBasis ht).h D.representation
    D.lattice (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
    (isNilpotent_apply_ι_chevalleySystem D.representation
      D.isNilpotent_representation_rootGenerator)
    (posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) A

/-- The positive subgroup is generated by the existing all-root exponential maps, without a
choice of root words or an additional root enumeration. -/
theorem positiveSubgroup_eq_closure (A : CommAlgCat.{v} ℤ) :
    D.positiveSubgroup A = Subgroup.closure
      {g | ∃ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        ∃ u, chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ A u = g} := by
  simp only [positiveSubgroup, kostantSubsystemSubgroup_eq_closure,
    kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator]

/-- A subgroup contains the positive subgroup exactly when it contains each positive root
subgroup. -/
theorem positiveSubgroup_le_iff {A : CommAlgCat.{v} ℤ}
    {P : Subgroup (LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice))} :
    D.positiveSubgroup A ≤ P ↔
      ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ u,
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ A u ∈ P := by
  simp only [positiveSubgroup, kostantSubsystemSubgroup_le_iff,
    kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator]

/-- Each positive root element belongs to the positive subgroup. -/
theorem chevalleyRootSubgroup_mem_positiveSubgroup (A : CommAlgCat.{v} ℤ)
    {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Multiplicative A) :
    chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ A u ∈ D.positiveSubgroup A :=
  (D.positiveSubgroup_le_iff.mp le_rfl) γ hγ u

/-- The positive subgroup lies in the elementary subgroup generated by the positive and negative
simple root subgroups. -/
theorem positiveSubgroup_le_kostantElementarySubgroup (A : CommAlgCat.{v} ℤ) :
    D.positiveSubgroup A ≤ kostantElementarySubgroup (t.lieBasis ht).rootGenerator
      (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator A := by
  exact D.positiveSubgroup_le_iff.mpr fun γ _ u =>
    chevalleyRootSubgroup_mem_kostantElementarySubgroup D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A u

/-- The matrix image of the positive subgroup consists of points of the Chevalley datum. -/
theorem map_positiveSubgroup_le_points (A : Type v) [CommRing A] :
    (D.positiveSubgroup (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) ≤
      D.points A := by
  rw [D.points_eq_kostantToralPointsSubgroup]
  exact (Subgroup.map_mono
    (D.positiveSubgroup_le_kostantElementarySubgroup (CommAlgCat.of ℤ A))).trans
    ((map_kostantElementarySubgroup_le_generatedPoints (t.lieBasis ht).rootGenerator
      (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator D.basis A).trans
      (kostantGeneratedPointsSubgroup_le_toralPoints (t.lieBasis ht).rootGenerator
        (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator D.basis D.coordinateWeight A))

/-- Scalar extension carries the positive subgroup into the positive subgroup over the target
ring. No surjectivity of the ring map is required. -/
theorem map_positiveSubgroup_le {A B : CommAlgCat.{v} ℤ} (f : A ⟶ B) :
    (D.positiveSubgroup A).map
        (GeneralLinear.mapScalarExtensionAutomorphisms (V := D.lattice) f).hom ≤
      D.positiveSubgroup B := by
  unfold positiveSubgroup
  exact map_kostantSubsystemSubgroup_le _ _ _ _ _ _ _ f

/-- The subgroup generated by any subset of positive roots on a Chevalley datum's lattice is
nilpotent over every commutative ring. No closure condition on the root subset is required. -/
theorem isNilpotent_kostantSubsystemSubgroup_of_subset_posRoots
    {S : Set (Fin t.numRoots)}
    (hS : S ⊆ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : Type v) [CommRing A] :
    Group.IsNilpotent (kostantSubsystemSubgroup (t.chevalleySystem ht) (t.lieBasis ht).h
      D.representation D.lattice
      (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
      (isNilpotent_apply_ι_chevalleySystem D.representation
        D.isNilpotent_representation_rootGenerator) S (CommAlgCat.of ℤ A)) := by
  exact isNilpotent_kostantSubsystemSubgroup_of_isPositive
    (t.chevalleySystem ht) (t.lieBasis ht).h D.representation D.lattice
    (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
    (isNilpotent_apply_ι_chevalleySystem D.representation
      D.isNilpotent_representation_rootGenerator)
    (orderedWeightBasis (t.weightDegree ht) D.weight D.basis)
    (orderedWeight (t.weightDegree ht) D.weight) (t.simplyConnectedRootDatum ht).root
    S
    (isCartanWeightVector_coe_orderedWeightBasis (t.lieBasis ht).h D.representation
      D.lattice D.basis D.weight (t.weightDegree ht) D.isCartanWeightVector_basis)
    (fun γ _ i => t.lie_lieBasis_h_chevalleySystem ht γ i)
    (fun γ hγ {_ _ _} hn heq =>
      orderedWeight_lt_of_eq_add_nsmul _ _ (t.weightDegree_root_pos ht (hS hγ)) hn heq) A

/-- The subgroup generated by all positive roots of a Chevalley datum is nilpotent over every
commutative ring. In particular, this does not need an algebraically closed field or a lower
bound on its characteristic. -/
theorem isNilpotent_positiveSubgroup (A : Type v) [CommRing A] :
    Group.IsNilpotent (D.positiveSubgroup (CommAlgCat.of ℤ A)) := by
  unfold positiveSubgroup
  exact D.isNilpotent_kostantSubsystemSubgroup_of_subset_posRoots (Set.Subset.refl _) A

/-- The positive subgroup inside the group of datum points, obtained by writing its lattice
operators in the datum's weight basis. -/
noncomputable def positivePoints (A : Type v) [CommRing A] : Subgroup (D.points A) :=
  ((D.positiveSubgroup (CommAlgCat.of ℤ A)).map
    (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv)).subgroupOf
      (D.points A)

/-- Forgetting that positive elements are datum points gives exactly their existing matrix image.
-/
theorem map_positivePoints_subtype (A : Type v) [CommRing A] :
    (D.positivePoints A).map (D.points A).subtype =
      (D.positiveSubgroup (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) :=
  Subgroup.map_subgroupOf_eq_of_le (D.map_positiveSubgroup_le_points A)

/-- The positive point subgroup is generated by all positive root maps, not just the simple ones.
-/
theorem positivePoints_eq_closure (A : Type v) [CommRing A] :
    D.positivePoints A = Subgroup.closure
      {g | ∃ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        ∃ u, D.rootSubgroup γ A u = g} := by
  apply Subgroup.map_injective (D.points A).subtype_injective
  rw [D.map_positivePoints_subtype, D.positiveSubgroup_eq_closure,
    MonoidHom.map_closure, MonoidHom.map_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨_, ⟨γ, hγ, u, rfl⟩, h⟩
    exact ⟨D.rootSubgroup γ A u, ⟨γ, hγ, u, rfl⟩, (D.coe_rootSubgroup γ A u).trans h⟩
  · rintro ⟨_, ⟨γ, hγ, u, rfl⟩, h⟩
    exact ⟨_, ⟨γ, hγ, u, rfl⟩, (D.coe_rootSubgroup γ A u).symm.trans h⟩

/-- Containment of the positive point subgroup can be checked on all positive root parameters. -/
theorem positivePoints_le_iff {A : Type v} [CommRing A] {P : Subgroup (D.points A)} :
    D.positivePoints A ≤ P ↔
      ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ u,
        D.rootSubgroup γ A u ∈ P := by
  rw [D.positivePoints_eq_closure, Subgroup.closure_le]
  constructor
  · intro h γ hγ u
    exact h ⟨γ, hγ, u, rfl⟩
  · rintro h _ ⟨γ, hγ, u, rfl⟩
    exact h γ hγ u

/-- Each positive root element belongs to the positive point subgroup. -/
@[simp]
theorem rootSubgroup_mem_positivePoints (A : Type v) [CommRing A] {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Multiplicative A) : D.rootSubgroup γ A u ∈ D.positivePoints A :=
  (D.positivePoints_le_iff.mp le_rfl) γ hγ u

/-- The positive point subgroup is nilpotent over every commutative ring. -/
theorem isNilpotent_positivePoints (A : Type v) [CommRing A] :
    Group.IsNilpotent (D.positivePoints A) := by
  let := D.isNilpotent_positiveSubgroup A
  let e := (D.positiveSubgroup (CommAlgCat.of ℤ A)).equivMapOfInjective
    (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMonoidHom)
    (Units.map_injective (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).injective)
  exact Group.nilpotent_of_mulEquiv
    (e.trans (Subgroup.subgroupOfEquivOfLe (D.map_positiveSubgroup_le_points A)).symm)

/-- A ring map carries every positive point into the positive subgroup over the target ring. -/
theorem map_positivePoints_le {A : Type v} {B : Type v'} [CommRing A] [CommRing B]
    (f : A →+* B) :
    (D.positivePoints A).map ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      D.positivePoints B := by
  rw [Subgroup.map_le_iff_le_comap, D.positivePoints_le_iff]
  intro γ hγ u
  simpa only [Subgroup.mem_comap, D.map_rootSubgroup] using
    D.rootSubgroup_mem_positivePoints B hγ (Multiplicative.ofAdd (f u.toAdd))

end TauCeti.DynkinType.ChevalleyDatum
