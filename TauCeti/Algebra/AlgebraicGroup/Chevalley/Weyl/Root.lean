module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Weyl.Basic
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive.Basic
import TauCeti.LinearAlgebra.RootSystem.Weyl.Group

/-!
# The root action of the Chevalley Weyl subgroup

The subgroup generated by the actual torus and the pinned simple Weyl representatives acts
on all root subgroups through its Weyl projection. More precisely, conjugation by any lift
of a Weyl element carries each root parameter to a unit multiple of that parameter at the
image root. Thus the root subgroup, unlike its parametrization, is independent of the lift.
These formulas allow Weyl lifts to transport the root-generated subgroups used in Bruhat
cells. They do not identify the kernel of the Weyl projection with the torus.

The proof combines the existing pinning equation and the signed simple Weyl conjugation
formula in `ChevalleyDatum.weylElement_conj_rootSubgroupPoints`. It works over finite fields
as well as infinite ones; the Weyl projection already uses scalar extension to distinguish
characters when the original field is finite.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19 and 22.
* R. W. Carter, *Simple Groups of Lie Type*, §7.2.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open Multiplicative

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (K : Type v) [Field K]

private def RescalesRoots (g : D.weylSubgroup K) : Prop :=
  ∀ γ : Fin t.numRoots, ∃ c : Kˣ, ∀ u : K,
    MulAut.conj (g : D.points K) (D.rootSubgroupPoints γ K (ofAdd u)) =
      D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ) K
        (ofAdd ((c : K) * u))

private theorem rescalesRoots_one : D.RescalesRoots K 1 := by
  intro γ
  exact ⟨1, fun u => by simp⟩

private theorem RescalesRoots.mul {g h : D.weylSubgroup K}
    (hg : D.RescalesRoots K g) (hh : D.RescalesRoots K h) :
    D.RescalesRoots K (g * h) := by
  intro γ
  obtain ⟨d, hd⟩ := hh γ
  obtain ⟨c, hc⟩ := hg
    ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K h) γ)
  refine ⟨c * d, fun u => ?_⟩
  simp only [Subgroup.coe_mul, map_mul, MulAut.mul_apply, Equiv.Perm.mul_apply,
    hd, hc, Units.val_mul, mul_assoc]

private theorem RescalesRoots.inv {g : D.weylSubgroup K}
    (hg : D.RescalesRoots K g) : D.RescalesRoots K g⁻¹ := by
  intro γ
  let w := (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g)
  obtain ⟨c, hc⟩ := hg (w⁻¹ γ)
  refine ⟨c⁻¹, fun u => ?_⟩
  rw [Subgroup.coe_inv, map_inv, MulAut.inv_apply, map_inv, map_inv]
  apply (MulAut.conj (g : D.points K)).symm_apply_eq.mpr
  have hw : (t.simplyConnectedRootDatum ht).weylGroupToPerm
      (D.weylProjection K g) (w⁻¹ γ) = γ := w.apply_symm_apply γ
  simpa only [hw, ← mul_assoc, Units.val_inv_eq_inv_val,
    mul_inv_cancel₀ (Units.ne_zero c), one_mul] using
    (hc (((c⁻¹ : Kˣ) : K) * u)).symm

/-- Every Weyl lift acts on a root subgroup by a unit rescaling of its additive parameter.
The target root is specified by the existing Weyl projection, not by a choice of word. -/
theorem exists_unit_conj_rootSubgroupPoints (g : D.weylSubgroup K) (γ : Fin t.numRoots) :
    ∃ c : Kˣ, ∀ u : K,
      MulAut.conj (g : D.points K) (D.rootSubgroupPoints γ K (ofAdd u)) =
        D.rootSubgroupPoints
          ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ) K
          (ofAdd ((c : K) * u)) := by
  let H : Subgroup (D.weylSubgroup K) :=
    { carrier := {g | D.RescalesRoots K g}
      one_mem' := D.rescalesRoots_one K
      mul_mem' := RescalesRoots.mul D K
      inv_mem' := RescalesRoots.inv D K }
  have hle : D.weylSubgroup K ≤ H.map (D.weylSubgroup K).subtype := by
    apply (D.weylSubgroup_def K).le.trans
    apply (Subgroup.closure_le _).mpr
    rintro _ (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · refine ⟨⟨_, D.torusPoints_mem_weylSubgroup K s⟩, ?_, rfl⟩
      intro δ
      refine ⟨torusCharacter s (D.coordinateRoot δ), fun u => ?_⟩
      simp only [D.weylProjection_torusPoints, map_one, Equiv.Perm.one_apply]
      exact D.torusPoints_conj_rootSubgroupPoints δ K s u
    · refine ⟨⟨_, D.weylElement_mem_weylSubgroup K i⟩, ?_, rfl⟩
      intro δ
      refine ⟨Units.map (Int.castRingHom K).toMonoidHom
        (t.chevalleyWeylSign ht (t.simpleIndex ht i) δ), fun u => ?_⟩
      simp only [D.weylProjection_weylElement, RootPairing.weylGroupToPerm_ofIdx_apply,
        Units.coe_map]
      exact D.weylElement_conj_rootSubgroupPoints i δ K u
  obtain ⟨h, hh, heq⟩ := hle g.property
  have heq' : h = g := Subtype.ext heq
  subst h
  exact hh γ

/-- Conjugation by a Weyl lift transports a root subgroup to the root subgroup at the
projected root. The parameter scaling disappears on taking ranges. -/
theorem map_range_rootSubgroupPoints_conj (g : D.weylSubgroup K) (γ : Fin t.numRoots) :
    (D.rootSubgroupPoints γ K).range.map (MulAut.conj (g : D.points K)).toMonoidHom =
      (D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ) K).range := by
  obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints K g γ
  apply le_antisymm
  · rintro _ ⟨_, ⟨u, rfl⟩, rfl⟩
    refine ⟨ofAdd ((c : K) * toAdd u), ?_⟩
    simpa [MulAut.conj_apply] using (hc (toAdd u)).symm
  · rintro _ ⟨u, rfl⟩
    refine ⟨D.rootSubgroupPoints γ K (ofAdd (((c⁻¹ : Kˣ) : K) * toAdd u)),
      ⟨_, rfl⟩, ?_⟩
    simp [hc]

/-- A Weyl lift transports the subgroup generated by any set of root subgroups to the
subgroup generated by the image root set. No closure condition on the root set is required. -/
theorem map_iSup_rootSubgroupPoints_conj (g : D.weylSubgroup K)
    (S : Set (Fin t.numRoots)) :
    (⨆ γ ∈ S, (D.rootSubgroupPoints γ K).range).map
        (MulAut.conj (g : D.points K)).toMonoidHom =
      ⨆ γ ∈ (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) '' S,
        (D.rootSubgroupPoints γ K).range := by
  simp only [Subgroup.map_iSup, D.map_range_rootSubgroupPoints_conj, iSup_image]

/-- Conjugation by a Weyl lift `g` sends the root subgroup of `γ` into the positive points
whenever the projected root `w γ` is positive, `w` being the Weyl projection of `g`. -/
theorem mul_rootSubgroupPoints_mul_inv_mem_positivePoints (g : D.weylSubgroup K)
    {γ : Fin t.numRoots}
    (hγ : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ ∈
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : K) :
    (g : D.points K) * D.rootSubgroupPoints γ K (ofAdd u) * (g : D.points K)⁻¹ ∈
      D.positivePoints K := by
  obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints K g γ
  rw [← MulAut.conj_apply, hc u]
  exact D.rootSubgroupPoints_mem_positivePoints K hγ _

end TauCeti.DynkinType.ChevalleyDatum
