module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Subsystem
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Weyl.Basic
import TauCeti.Algebra.AlgebraicGroup.Chevalley.Root.Weyl
import TauCeti.LinearAlgebra.RootSystem.Weyl.Orbit.Basic

/-!
# The root action of the Chevalley Weyl subgroup

The subgroup generated by the actual torus and the pinned simple Weyl representatives acts
on all root subgroups through its Weyl projection. More precisely, conjugation by any lift
of a Weyl element carries each root parameter to a unit multiple of that parameter at the
image root. Thus the root subgroup, unlike its parametrization, is independent of the lift.
These formulas allow Weyl lifts to transport the root-generated subgroups used in Bruhat
cells. They do not identify the kernel of the Weyl projection with the torus.

By simple-reflection induction and `ChevalleyDatum.weylElement_conj_weylElement`, the Weyl
subgroup also contains Steinberg's Weyl element `n_γ(s)` for every root `γ` and unit `s`
(`ChevalleyDatum.weylElement_mem_weylSubgroup`), and over a field `n_γ(s)` projects to
the reflection `s_γ` in the Weyl group (`ChevalleyDatum.weylProjection_weylElement`).
Consequently `D.weylSubgroup A` is also generated by the actual torus together with all root
Weyl representatives (`ChevalleyDatum.weylSubgroup_eq_closure_weylElement_one`,
`ChevalleyDatum.weylSubgroup_eq_closure_weylElement`).

The proof combines the existing pinning equation and the signed simple Weyl conjugation
formula in `ChevalleyDatum.weylElement_conj_rootSubgroupPoints`. It works over finite fields
as well as infinite ones; the Weyl projection already uses scalar extension to distinguish
characters when the original field is finite.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19 and 22.
* R. W. Carter, *Simple Groups of Lie Type*, §7.2.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open Multiplicative

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

section Field

variable (K : Type v) [Field K]

private def RescalesRoots (g : D.weylSubgroup K) : Prop :=
  ∀ γ : Fin t.numRoots, ∃ c : Kˣ, ∀ u : K,
    MulAut.conj (g : D.points K) (D.rootSubgroupPoints γ K (ofAdd u)) =
      D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ) K
        (ofAdd ((c : K) * u))

private theorem rescalesRoots_one : D.RescalesRoots K 1 := by
  intro γ
  exact ⟨1, fun u => by simp⟩

private theorem RescalesRoots.mul {g h : D.weylSubgroup K}
    (hg : D.RescalesRoots K g) (hh : D.RescalesRoots K h) :
    D.RescalesRoots K (g * h) := by
  intro γ
  obtain ⟨d, hd⟩ := hh γ
  obtain ⟨c, hc⟩ := hg
    ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K h) γ)
  refine ⟨c * d, fun u => ?_⟩
  simp only [Subgroup.coe_mul, map_mul, MulAut.mul_apply, Equiv.Perm.mul_apply,
    hd, hc, Units.val_mul, mul_assoc]

private theorem RescalesRoots.inv {g : D.weylSubgroup K}
    (hg : D.RescalesRoots K g) : D.RescalesRoots K g⁻¹ := by
  intro γ
  let w := (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g)
  obtain ⟨c, hc⟩ := hg (w⁻¹ γ)
  refine ⟨c⁻¹, fun u => ?_⟩
  rw [Subgroup.coe_inv, map_inv, MulAut.inv_apply, map_inv, map_inv]
  apply (MulAut.conj (g : D.points K)).symm_apply_eq.mpr
  have hw : (t.simplyConnectedRootDatum ht).weylGroupToPerm
      (D.weylProjection K g) (w⁻¹ γ) = γ := w.apply_symm_apply γ
  simpa only [hw, ← mul_assoc, Units.val_inv_eq_inv_val,
    mul_inv_cancel₀ (Units.ne_zero c), one_mul] using
    (hc (((c⁻¹ : Kˣ) : K) * u)).symm

/-- Every Weyl lift acts on a root subgroup by a unit rescaling of its additive parameter.
The target root is specified by the existing Weyl projection, not by a choice of word. -/
theorem exists_unit_conj_rootSubgroupPoints (g : D.weylSubgroup K) (γ : Fin t.numRoots) :
    ∃ c : Kˣ, ∀ u : K,
      MulAut.conj (g : D.points K) (D.rootSubgroupPoints γ K (ofAdd u)) =
        D.rootSubgroupPoints
          ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ) K
          (ofAdd ((c : K) * u)) := by
  let H : Subgroup (D.weylSubgroup K) :=
    { carrier := {g | D.RescalesRoots K g}
      one_mem' := D.rescalesRoots_one K
      mul_mem' := RescalesRoots.mul D K
      inv_mem' := RescalesRoots.inv D K }
  have hle : D.weylSubgroup K ≤ H.map (D.weylSubgroup K).subtype := by
    apply (D.weylSubgroup_def K).le.trans
    apply (Subgroup.closure_le _).mpr
    rintro _ (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · refine ⟨⟨_, D.torusPoints_mem_weylSubgroup K s⟩, ?_, rfl⟩
      intro δ
      refine ⟨torusCharacter s (D.coordinateRoot δ), fun u => ?_⟩
      simp only [D.weylProjection_torusPoints, map_one, Equiv.Perm.one_apply]
      exact D.torusPoints_conj_rootSubgroupPoints δ K s u
    · refine ⟨D.simpleWeylLift K i, ?_, D.coe_simpleWeylLift K i⟩
      intro δ
      refine ⟨Units.map (Int.castRingHom K).toMonoidHom
        (t.chevalleyWeylSign ht (t.simpleIndex ht i) δ), fun u => ?_⟩
      simp only [D.weylProjection_simpleWeylLift,
        RootPairing.weylGroupToPerm_ofIdx_apply, Units.coe_map,
        MulAut.conj_apply, D.coe_simpleWeylLift]
      exact D.weylElement_conj_rootSubgroupPoints i δ K u
  obtain ⟨h, hh, heq⟩ := hle g.property
  have heq' : h = g := Subtype.ext heq
  subst h
  exact hh γ

/-- Conjugation by a Weyl lift transports a root subgroup to the root subgroup at the
projected root. The parameter scaling disappears on taking ranges. -/
theorem map_range_rootSubgroupPoints_conj (g : D.weylSubgroup K) (γ : Fin t.numRoots) :
    (D.rootSubgroupPoints γ K).range.map (MulAut.conj (g : D.points K)).toMonoidHom =
      (D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) γ) K).range := by
  obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints K g γ
  apply le_antisymm
  · rintro _ ⟨_, ⟨u, rfl⟩, rfl⟩
    refine ⟨ofAdd ((c : K) * toAdd u), ?_⟩
    simpa [MulAut.conj_apply] using (hc (toAdd u)).symm
  · rintro _ ⟨u, rfl⟩
    refine ⟨D.rootSubgroupPoints γ K (ofAdd (((c⁻¹ : Kˣ) : K) * toAdd u)),
      ⟨_, rfl⟩, ?_⟩
    simp [hc]

/-- A Weyl lift transports the subgroup generated by any set of root subgroups to the
subgroup generated by the image root set. No closure condition on the root set is required. -/
theorem map_iSup_rootSubgroupPoints_conj (g : D.weylSubgroup K)
    (S : Set (Fin t.numRoots)) :
    (⨆ γ ∈ S, (D.rootSubgroupPoints γ K).range).map
        (MulAut.conj (g : D.points K)).toMonoidHom =
      ⨆ γ ∈ (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) '' S,
        (D.rootSubgroupPoints γ K).range := by
  simp only [Subgroup.map_iSup, D.map_range_rootSubgroupPoints_conj, iSup_image]

/-- A Weyl lift transports the point subgroup generated by any set of root subgroups to the
point subgroup generated by the image root set. No closure condition on the root set is required.
-/
theorem map_subsystemPoints_conj (g : D.weylSubgroup K) (S : Set (Fin t.numRoots)) :
    (D.subsystemPoints S K).map (MulAut.conj (g : D.points K)).toMonoidHom =
      D.subsystemPoints
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K g) '' S) K := by
  rw [D.subsystemPoints_eq_iSup, D.subsystemPoints_eq_iSup]
  exact D.map_iSup_rootSubgroupPoints_conj K g S

end Field

private theorem weylElement_reflectionPerm_eq_conj (i : Fin t.rank) (γ : Fin t.numRoots)
    (A : Type v) [CommRing A] (s : Aˣ) :
    D.weylElement ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A s =
      D.weylElement (t.simpleIndex ht i) A 1 *
        D.weylElement γ A ((Units.map (Int.castRingHom A).toMonoidHom
          (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ))⁻¹ * s) *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ := by
  have hconj := D.weylElement_conj_weylElement i γ A
    ((Units.map (Int.castRingHom A).toMonoidHom
      (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ))⁻¹ * s)
  rw [mul_inv_cancel_left] at hconj
  exact hconj.symm

/-- **Steinberg's Weyl element `n_γ(s)` lies in `D.weylSubgroup A` for every root `γ` and unit
`s`**, over every commutative ring `A`. -/
@[simp]
theorem weylElement_mem_weylSubgroup (γ : Fin t.numRoots) (A : Type v) [CommRing A]
    (s : Aˣ) : D.weylElement γ A s ∈ D.weylSubgroup A := by
  revert s
  refine (t.rationalBase ht).induction_simple_reflect γ
    (p := fun k => ∀ s : Aˣ, D.weylElement k A s ∈ D.weylSubgroup A)
    (fun k hk s => ?_) (fun k j hk hj s => ?_)
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hk
    rw [D.weylElement_simpleIndex_eq_torusPoints_mul]
    exact Subgroup.mul_mem _ (D.torusPoints_mem_weylSubgroup A _)
      (D.weylElement_simpleIndex_one_mem_weylSubgroup A i)
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
    rw [t.reflectionPerm_rationalRootSystem ht, D.weylElement_reflectionPerm_eq_conj]
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _ (D.weylElement_simpleIndex_one_mem_weylSubgroup A i) (hk _))
      (Subgroup.inv_mem _ (D.weylElement_simpleIndex_one_mem_weylSubgroup A i))

private theorem weylElement_simpleIndex_subgroup_eq (i : Fin t.rank)
    (A : Type v) [CommRing A] (s : Aˣ) :
    (⟨D.weylElement (t.simpleIndex ht i) A s, D.weylElement_mem_weylSubgroup _ A s⟩ :
        D.weylSubgroup A) =
      ⟨D.torusPoints A (D.simpleCorootParameter i A s),
        D.torusPoints_mem_weylSubgroup A _⟩ *
        D.simpleWeylLift A i :=
  Subtype.ext (by
    simpa only [Subgroup.coe_mul, D.coe_simpleWeylLift] using
      D.weylElement_simpleIndex_eq_torusPoints_mul A i s)

private theorem weylElement_reflectionPerm_subgroup_eq (i : Fin t.rank) (γ : Fin t.numRoots)
    (A : Type v) [CommRing A] (s : Aˣ) :
    (⟨D.weylElement ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A s,
        D.weylElement_mem_weylSubgroup _ A s⟩ : D.weylSubgroup A) =
      D.simpleWeylLift A i *
        ⟨D.weylElement γ A ((Units.map (Int.castRingHom A).toMonoidHom
          (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ))⁻¹ * s),
          D.weylElement_mem_weylSubgroup γ A _⟩ *
        (D.simpleWeylLift A i)⁻¹ :=
  Subtype.ext (by
    simpa only [Subgroup.coe_mul, Subgroup.coe_inv, D.coe_simpleWeylLift] using
      D.weylElement_reflectionPerm_eq_conj i γ A s)

/-- Scalar extension on the Weyl subgroup sends Steinberg's Weyl element `n_γ(s)` to `n_γ(f s)`. -/
-- Concrete Dynkin-type rules can normalize root indices inside `Subtype.mk` before matching.
@[simp↓]
theorem weylSubgroupMap_weylElement (A : Type*) [CommRing A] {B : Type*} [CommRing B]
    (f : A →+* B) (γ : Fin t.numRoots) (s : Aˣ)
    (hx : D.weylElement γ A s ∈ D.weylSubgroup A) :
    D.weylSubgroupMap A f ⟨D.weylElement γ A s, hx⟩ =
      ⟨D.weylElement γ B (Units.map f.toMonoidHom s),
        D.weylElement_mem_weylSubgroup γ B _⟩ := by
  apply Subtype.ext
  rw [D.coe_weylSubgroupMap]
  apply Subtype.ext
  rw [GeneralLinear.IntegralPointsPresentation.coe_map]
  exact D.map_weylElement f γ s

/-- **Over a field, Steinberg's Weyl element `n_γ(s)` of any root `γ` projects to the reflection
`s_γ` in the Weyl group.** -/
-- Concrete Dynkin-type rules can normalize root indices inside `Subtype.mk` before matching.
@[simp↓]
theorem weylProjection_weylElement (k : Type v) [Field k] (γ : Fin t.numRoots) (s : kˣ) :
    D.weylProjection k ⟨D.weylElement γ k s, D.weylElement_mem_weylSubgroup γ k s⟩ =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) γ := by
  revert s
  refine (t.rationalBase ht).induction_simple_reflect γ
    (p := fun γ => ∀ s : kˣ,
      D.weylProjection k
          ⟨D.weylElement γ k s, D.weylElement_mem_weylSubgroup γ k s⟩ =
        RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) γ)
    (fun γ hγ s => ?_) (fun γ j hγ hj s => ?_)
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hγ
    rw [D.weylElement_simpleIndex_subgroup_eq i k s, map_mul,
      D.weylProjection_torusPoints, one_mul, D.weylProjection_simpleWeylLift]
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
    rw [t.reflectionPerm_rationalRootSystem ht,
      D.weylElement_reflectionPerm_subgroup_eq i γ k s,
      map_mul, map_mul, map_inv, D.weylProjection_simpleWeylLift, hγ,
      ← RootPairing.weylGroup.ofIdx_weylGroupToPerm_eq_conj,
      RootPairing.weylGroupToPerm_ofIdx_apply]

section Ring

variable (A : Type v) [CommRing A]

/-- `D.weylSubgroup A` coincides with the subgroup generated by the actual torus and the
Steinberg Weyl representatives `n_γ(1)` of all roots `γ`, over every commutative ring `A`. -/
theorem weylSubgroup_eq_closure_weylElement_one :
    D.weylSubgroup A = Subgroup.closure (Set.range (D.torusPoints A) ∪
      Set.range (fun γ : Fin t.numRoots => D.weylElement γ A 1)) := by
  apply le_antisymm
  · rw [D.weylSubgroup_def]
    apply Subgroup.closure_mono
    rintro x (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · exact Or.inl ⟨s, rfl⟩
    · exact Or.inr ⟨t.simpleIndex ht i, rfl⟩
  · rw [Subgroup.closure_le]
    rintro x (⟨s, rfl⟩ | ⟨γ, rfl⟩)
    · exact D.torusPoints_mem_weylSubgroup A s
    · exact D.weylElement_mem_weylSubgroup γ A 1

/-- `D.weylSubgroup A` coincides with the subgroup generated by the actual torus and the
Steinberg Weyl representatives `n_γ(s)` of all roots `γ` and units `s : Aˣ`, over every
commutative ring `A`. -/
theorem weylSubgroup_eq_closure_weylElement :
    D.weylSubgroup A = Subgroup.closure (Set.range (D.torusPoints A) ∪
      ⋃ γ : Fin t.numRoots, Set.range (D.weylElement γ A)) := by
  apply le_antisymm
  · rw [D.weylSubgroup_def]
    apply Subgroup.closure_mono
    rintro x (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · exact Or.inl ⟨s, rfl⟩
    · exact Or.inr (Set.mem_iUnion.mpr ⟨t.simpleIndex ht i, 1, rfl⟩)
  · rw [Subgroup.closure_le]
    rintro x (⟨s, rfl⟩ | hx)
    · exact D.torusPoints_mem_weylSubgroup A s
    · obtain ⟨γ, s, rfl⟩ := Set.mem_iUnion.mp hx
      exact D.weylElement_mem_weylSubgroup γ A s

end Ring

end TauCeti.DynkinType.ChevalleyDatum
