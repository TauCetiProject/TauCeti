/-!
# Weyl-word decomposition for Chevalley data

For a Chevalley datum `D` of valid Dynkin type `t` over any commutative ring `A`, the pinned
simple Weyl representatives `nᵢ(1) = D.weylElement (t.simpleIndex ht i) A 1` satisfy
`nᵢ(1)² = αᵢ∨(-1) ∈ T_D(A)` (`ChevalleyDatum.weylElement_mul_self`) and normalize the actual
torus `T_D(A) = (D.torusPoints A).range`
(`ChevalleyDatum.weylSubgroup_le_normalizer_range_torusPoints`).

Consequently:
* Every element of `D.weylSubgroup A` decomposes as a positive word in the pinned simple Weyl
  representatives followed by an actual torus point
  (`ChevalleyDatum.mem_weylSubgroup_iff_exists_list_prod_mul_torusPoints`), without requiring the
  Coxeter presentation or braid relations. (See `Chevalley.Weyl.Lift` for the Coxeter lift on the
  Weyl-subgroup quotient.)
* Conjugating any root Weyl representative `n_γ(1)` by a simple representative `nᵢ(1)` yields a
  coroot torus factor times `n_{sᵢ γ}(1)`
  (`ChevalleyDatum.weylElement_simpleIndex_conj_weylElement`), so every root Weyl representative
  `n_γ(s)` lies in `D.weylSubgroup A` (`ChevalleyDatum.weylElement_root_mem_weylSubgroup`), and
  `D.weylSubgroup A` coincides with the subgroup generated by `T_D(A)` and all root Weyl
  representatives (`ChevalleyDatum.weylSubgroup_eq_closure_weylElement_one`,
  `ChevalleyDatum.weylSubgroup_eq_closure_weylElement`).

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.mem_weylSubgroup_iff_exists_list_prod_mul_torusPoints`:
  word factorization of `D.weylSubgroup A`.
* `TauCeti.DynkinType.ChevalleyDatum.weylElement_root_mem_weylSubgroup`,
  `TauCeti.DynkinType.ChevalleyDatum.weylSubgroup_eq_closure_weylElement_one`, and
  `TauCeti.DynkinType.ChevalleyDatum.weylSubgroup_eq_closure_weylElement`: identification of
  `D.weylSubgroup A` with the subgroup generated by the actual torus and all root Weyl
  representatives.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 22.
* R. W. Carter, *Simple Groups of Lie Type*, §7.2.
-/

public noncomputable section

namespace TauCeti.DynkinType.ChevalleyDatum

open Multiplicative

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-- Every element of `D.weylSubgroup A` is a positive word in the pinned simple Weyl
representatives followed by a point of the actual torus, over every commutative ring. -/
theorem mem_weylSubgroup_iff_exists_list_prod_mul_torusPoints (A : Type v) [CommRing A]
    {g : D.points A} :
    g ∈ D.weylSubgroup A ↔
      ∃ (l : List (Fin t.rank)) (s : Fin t.rank → Aˣ),
        (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod *
          D.torusPoints A s = g := by
  let r : Fin t.rank → D.points A := fun i => D.weylElement (t.simpleIndex ht i) A 1
  have htorus_mul (s₀ : Fin t.rank → Aˣ) (l : List (Fin t.rank)) (s : Fin t.rank → Aˣ) :
      ∃ s' : Fin t.rank → Aˣ,
        D.torusPoints A s₀ * ((l.map r).prod * D.torusPoints A s) =
          (l.map r).prod * D.torusPoints A s' := by
    have hnorm := D.weylSubgroup_le_normalizer_range_torusPoints A
      (inv_mem (D.list_prod_map_weylElement_mem_weylSubgroup A l))
    obtain ⟨s₁, hs₁⟩ := (Subgroup.mem_normalizer_iff.mp hnorm (D.torusPoints A s₀)).mp
      ⟨s₀, rfl⟩
    refine ⟨s₁ * s, ?_⟩
    have hcomm : D.torusPoints A s₀ * (l.map r).prod = (l.map r).prod * D.torusPoints A s₁ := by
      rw [hs₁]
      dsimp only [r]
      group
    rw [← mul_assoc, hcomm, mul_assoc, (D.torusPoints A).map_mul]
  constructor
  · intro hg
    rw [D.weylSubgroup_def] at hg
    induction hg using Subgroup.closure_induction_left with
    | one =>
      exact ⟨[], 1, by simp⟩
    | mul_left x hx y _ ih =>
      obtain ⟨l, s, rfl⟩ := ih
      rcases hx with ⟨s₀, rfl⟩ | ⟨i, rfl⟩
      · obtain ⟨s', hs'⟩ := htorus_mul s₀ l s
        exact ⟨l, s', hs'.symm⟩
      · exact ⟨i :: l, s, by simp [mul_assoc]⟩
    | inv_mul_cancel x hx y _ ih =>
      obtain ⟨l, s, rfl⟩ := ih
      rcases hx with ⟨s₀, rfl⟩ | ⟨i, rfl⟩
      · rw [← map_inv]
        obtain ⟨s', hs'⟩ := htorus_mul s₀⁻¹ l s
        exact ⟨l, s', hs'.symm⟩
      · have hri_inv : (r i)⁻¹ =
            r i * D.torusPoints A (D.simpleCorootParameter i A (-1))⁻¹ := by
          apply inv_eq_of_mul_eq_one_right
          rw [← mul_assoc, D.weylElement_mul_self i A, D.simpleCorootPoints_eq_torusPoints,
            ← (D.torusPoints A).map_mul, mul_inv_cancel, map_one]
        rw [hri_inv, mul_assoc]
        obtain ⟨s', hs'⟩ := htorus_mul (D.simpleCorootParameter i A (-1))⁻¹ l s
        refine ⟨i :: l, s', ?_⟩
        dsimp only [r] at hs' ⊢
        simp only [List.map_cons, List.prod_cons, mul_assoc]
        rw [← hs']
  · rintro ⟨l, s, rfl⟩
    exact mul_mem (D.list_prod_map_weylElement_mem_weylSubgroup A l)
      (D.torusPoints_mem_weylSubgroup A s)

private theorem chevalleyWeylSign_reflectionPerm_self (α β : Fin t.numRoots) :
    t.chevalleyWeylSign ht α ((t.simplyConnectedRootDatum ht).reflectionPerm β β) =
      t.chevalleyWeylSign ht α β := by
  let ω := (t.chevalleyInvolution ht : t.lieAlgebra ht →ₗ⁅ℚ⁆ t.lieAlgebra ht)
  have hωf :
      ω (t.chevalleySystem ht ((t.simplyConnectedRootDatum ht).reflectionPerm α α)) =
        -t.chevalleySystem ht α := by
    change (t.chevalleyInvolution ht) _ = _
    rw [t.chevalleyInvolution_chevalleySystem, RootPairing.reflectionPerm_reflectionPerm_self]
  have hcomm := ω.map_weylAut (t.isSl2Triple_chevalleySystem ht α)
    (t.isNilpotent_ad_chevalleySystem ht α).exists_pow_apply_eq_zero
    (t.isNilpotent_ad_chevalleySystem ht _).exists_pow_apply_eq_zero
    (t.chevalleyInvolution_chevalleySystem ht α) hωf (t.chevalleySystem ht β)
  have hidx :
      (t.simplyConnectedRootDatum ht).reflectionPerm α
          ((t.simplyConnectedRootDatum ht).reflectionPerm β β) =
        (t.simplyConnectedRootDatum ht).reflectionPerm
          ((t.simplyConnectedRootDatum ht).reflectionPerm α β)
          ((t.simplyConnectedRootDatum ht).reflectionPerm α β) := by
    simpa only [RootPairing.weylGroupToPerm_ofIdx_apply] using
      (t.simplyConnectedRootDatum ht).weylGroupToPerm_reflectionPerm_self
        (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) α) β
  have hL :
      ω (TauCeti.weylAut (t.isSl2Triple_chevalleySystem ht α)
          (t.isNilpotent_ad_chevalleySystem ht α).exists_pow_apply_eq_zero
          (t.isNilpotent_ad_chevalleySystem ht _).exists_pow_apply_eq_zero
          (t.chevalleySystem ht β)) =
        -((t.chevalleyWeylSign ht α β : ℤ) •
          t.chevalleySystem ht ((t.simplyConnectedRootDatum ht).reflectionPerm
            ((t.simplyConnectedRootDatum ht).reflectionPerm α β)
            ((t.simplyConnectedRootDatum ht).reflectionPerm α β))) := by
    rw [t.weylAut_chevalleySystem ht α β, map_zsmul]
    change (t.chevalleyWeylSign ht α β : ℤ) • (t.chevalleyInvolution ht) _ = _
    rw [t.chevalleyInvolution_chevalleySystem, smul_neg]
  have hR :
      TauCeti.weylAut (t.isSl2Triple_chevalleySystem ht α)
          (t.isNilpotent_ad_chevalleySystem ht α).exists_pow_apply_eq_zero
          (t.isNilpotent_ad_chevalleySystem ht _).exists_pow_apply_eq_zero
          (ω (t.chevalleySystem ht β)) =
        -TauCeti.weylAut (t.isSl2Triple_chevalleySystem ht α)
          (t.isNilpotent_ad_chevalleySystem ht α).exists_pow_apply_eq_zero
          (t.isNilpotent_ad_chevalleySystem ht _).exists_pow_apply_eq_zero
          (t.chevalleySystem ht ((t.simplyConnectedRootDatum ht).reflectionPerm β β)) := by
    change TauCeti.weylAut _ _ _ ((t.chevalleyInvolution ht) _) = _
    rw [t.chevalleyInvolution_chevalleySystem, map_neg]
  rw [hL, hR, neg_inj, ← hidx] at hcomm
  exact (eq_chevalleyWeylSign_iff.mpr hcomm.symm).symm

/-- Conjugating any root Weyl representative `n_γ(1)` by a pinned simple Weyl representative
`n_i(1)` produces `n_{s_i γ}(ε)` (`ε = ±1`), equal to a coroot torus factor times
`n_{s_i γ}(1)`. -/
theorem weylElement_simpleIndex_conj_weylElement (i : Fin t.rank) (γ : Fin t.numRoots)
    (A : Type v) [CommRing A] :
    D.weylElement (t.simpleIndex ht i) A 1 * D.weylElement γ A 1 *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ =
      D.corootPoints ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A
          (Units.map (Int.castRingHom A).toMonoidHom
            (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ)) *
        D.weylElement ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ)
          A 1 := by
  let n := D.weylElement (t.simpleIndex ht i) A 1
  let γ' := (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ
  let ε := t.chevalleyWeylSign ht (t.simpleIndex ht i) γ
  let s : Aˣ := Units.map (Int.castRingHom A).toMonoidHom ε
  have hs_inv : s⁻¹ = s := by
    rcases Int.units_eq_one_or ε with hε | hε <;> simp [s, hε]
  have hneg :
      (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
          ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) =
        (t.simplyConnectedRootDatum ht).reflectionPerm γ' γ' := by
    simpa only [RootPairing.weylGroupToPerm_ofIdx_apply] using
      (t.simplyConnectedRootDatum ht).weylGroupToPerm_reflectionPerm_self
        (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) γ
  have hconj :
      n * D.weylElement γ A 1 * n⁻¹ =
        (n * D.rootSubgroupPoints γ A (ofAdd 1) * n⁻¹) *
          (n * D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) A
            (ofAdd (-1)) * n⁻¹) *
          (n * D.rootSubgroupPoints γ A (ofAdd 1) * n⁻¹) := by
    rw [D.weylElement_def]
    simp only [inv_one, Units.val_one]
    group
  rw [hconj, D.weylElement_conj_rootSubgroupPoints i γ A 1,
    D.weylElement_conj_rootSubgroupPoints i _ A (-1),
    chevalleyWeylSign_reflectionPerm_self, hneg]
  have hweyl :
      D.rootSubgroupPoints γ' A (ofAdd (((ε : ℤ) : A) * 1)) *
          D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm γ' γ') A
            (ofAdd (((ε : ℤ) : A) * (-1))) *
          D.rootSubgroupPoints γ' A (ofAdd (((ε : ℤ) : A) * 1)) =
        D.weylElement γ' A s := by
    rw [D.weylElement_def, hs_inv]
    simp only [s, Units.coe_map, RingHom.toMonoidHom_eq_coe, MonoidHom.coe_ofClass, eq_intCast,
      mul_one, mul_neg]
  rw [hweyl, D.weylElement_eq_corootPoints_mul γ' A s]

/-- Every Steinberg Weyl representative `n_γ(s)` of an arbitrary root `γ` and unit `s` belongs
to `D.weylSubgroup A` over every commutative ring `A`. -/
theorem weylElement_root_mem_weylSubgroup (A : Type v) [CommRing A]
    (γ : Fin t.numRoots) (s : Aˣ) :
    D.weylElement γ A s ∈ D.weylSubgroup A := by
  have h_one : ∀ δ : Fin t.numRoots, D.weylElement δ A 1 ∈ D.weylSubgroup A := by
    intro δ
    induction δ using (t.rationalBase ht).induction_simple_reflect with
    | h₁ δ hδ =>
      obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hδ
      exact D.weylElement_mem_weylSubgroup A i
    | h₂ δ j hδ hj =>
      obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
      rw [t.reflectionPerm_rationalRootSystem ht]
      set γ' := (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) δ
      set sε : Aˣ := Units.map (Int.castRingHom A).toMonoidHom
        (t.chevalleyWeylSign ht (t.simpleIndex ht i) δ)
      have hconj := D.weylElement_simpleIndex_conj_weylElement i δ A
      have hweyl :
          D.weylElement γ' A 1 =
            (D.corootPoints γ' A sε)⁻¹ *
              (D.weylElement (t.simpleIndex ht i) A 1 * D.weylElement δ A 1 *
                (D.weylElement (t.simpleIndex ht i) A 1)⁻¹) := by
        rw [hconj, inv_mul_cancel_left]
      rw [hweyl]
      refine mul_mem (inv_mem ?_)
        (mul_mem (mul_mem (D.weylElement_mem_weylSubgroup A i) hδ)
          (inv_mem (D.weylElement_mem_weylSubgroup A i)))
      rw [D.corootPoints_apply]
      exact D.torusPoints_mem_weylSubgroup A _
  rw [D.weylElement_eq_corootPoints_mul γ A s, D.corootPoints_apply]
  exact mul_mem (D.torusPoints_mem_weylSubgroup A _) (h_one γ)

/-- `D.weylSubgroup A` coincides with the subgroup generated by the actual torus and the
Steinberg Weyl representatives `n_γ(1)` of all roots `γ`, over every commutative ring `A`. -/
theorem weylSubgroup_eq_closure_weylElement_one (A : Type v) [CommRing A] :
    D.weylSubgroup A = Subgroup.closure (Set.range (D.torusPoints A) ∪
      Set.range (fun γ : Fin t.numRoots => D.weylElement γ A 1)) := by
  apply le_antisymm
  · rw [D.weylSubgroup_def]
    apply Subgroup.closure_mono
    rintro x (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · exact Or.inl ⟨s, rfl⟩
    · exact Or.inr ⟨t.simpleIndex ht i, rfl⟩
  · rw [Subgroup.closure_le]
    rintro x (⟨s, rfl⟩ | ⟨γ, rfl⟩)
    · exact D.torusPoints_mem_weylSubgroup A s
    · exact D.weylElement_root_mem_weylSubgroup A γ 1

/-- `D.weylSubgroup A` coincides with the subgroup generated by the actual torus and the
Steinberg Weyl representatives `n_γ(s)` of all roots `γ` and units `s : Aˣ`, over every
commutative ring `A`. -/
theorem weylSubgroup_eq_closure_weylElement (A : Type v) [CommRing A] :
    D.weylSubgroup A = Subgroup.closure (Set.range (D.torusPoints A) ∪
      ⋃ γ : Fin t.numRoots, Set.range (D.weylElement γ A)) := by
  apply le_antisymm
  · rw [D.weylSubgroup_def]
    apply Subgroup.closure_mono
    rintro x (⟨s, rfl⟩ | ⟨i, rfl⟩)
    · exact Or.inl ⟨s, rfl⟩
    · exact Or.inr (Set.mem_iUnion.mpr ⟨t.simpleIndex ht i, 1, rfl⟩)
  · rw [Subgroup.closure_le]
    rintro x (⟨s, rfl⟩ | hx)
    · exact D.torusPoints_mem_weylSubgroup A s
    · obtain ⟨γ, s, rfl⟩ := Set.mem_iUnion.mp hx
      exact D.weylElement_root_mem_weylSubgroup A γ s

end TauCeti.DynkinType.ChevalleyDatum
