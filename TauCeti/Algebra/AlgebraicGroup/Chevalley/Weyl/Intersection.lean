-- Match the scalar-extension algebra instances used by `D.points` and `AlgebraicClosure`.
attribute [local instance high] Ring.toIntAlgebra
attribute [local instance high] Algebra.toModule
attribute [local instance 100] LieRing.ofAssociativeRing

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-! ## All-root Weyl elements over commutative rings -/

/-- Conjugation by a pinned simple Weyl element `n_{αᵢ}(1)` carries `n_γ(s)` to
`n_{sᵢ γ}(η_{αᵢ,γ} s)` over every commutative ring. -/
theorem weylElement_conj_weylElement (i : Fin t.rank) (γ : Fin t.numRoots)
    (A : Type v) [CommRing A] (s : Aˣ) :
    D.weylElement (t.simpleIndex ht i) A 1 * D.weylElement γ A s *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ =
      D.weylElement ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A
        (Units.map (Int.castRingHom A).toMonoidHom
          (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ) * s) := by
  have hneg : (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
      ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) =
      (t.simplyConnectedRootDatum ht).reflectionPerm
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ)
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) := by
    have h := (t.simplyConnectedRootDatum ht).weylGroupToPerm_neg
      (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) γ
    simpa only [RootPairing.indexNeg_neg, RootPairing.weylGroupToPerm_ofIdx_apply] using h
  let ε := t.chevalleyWeylSign ht (t.simpleIndex ht i) γ
  let εA : Aˣ := Units.map (Int.castRingHom A).toMonoidHom ε
  have h1 : D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A
        (ofAdd (((ε : ℤ) : A) * (s : A))) =
      D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A
        (ofAdd ((εA * s : Aˣ) : A)) := by
    simp [εA]
  have h2 : D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).reflectionPerm
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ)
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ)) A
        (ofAdd (((ε : ℤ) : A) * -((s⁻¹ : Aˣ) : A))) =
      D.rootSubgroupPoints
        ((t.simplyConnectedRootDatum ht).reflectionPerm
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ)
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ)) A
        (ofAdd (-(((εA * s)⁻¹ : Aˣ) : A))) := by
    rcases Int.units_eq_one_or ε with hε | hε <;> simp [εA, hε]
  rw [D.weylElement_def γ A s, D.weylElement_def _ A (εA * s),
    ← MulAut.conj_apply, map_mul, map_mul]
  simp only [MulAut.conj_apply, D.weylElement_conj_rootSubgroupPoints, hneg,
    t.chevalleyWeylSign_reflectionPerm_self ht]
  rw [h1, h2]

/-- Every all-root Weyl element `n_γ(s)` (`s : Aˣ`) belongs to `D.weylSubgroup A` over every
commutative ring. -/
theorem weylElement_unit_mem_weylSubgroup (A : Type v) [CommRing A] (γ : Fin t.numRoots)
    (s : Aˣ) : D.weylElement γ A s ∈ D.weylSubgroup A := by
  refine (t.rationalBase ht).induction_simple_reflect γ
    (p := fun k => ∀ s : Aˣ, D.weylElement k A s ∈ D.weylSubgroup A)
    (fun γ hγ s => ?_) (fun γ j ih hj s => ?_) s
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hγ
    rw [D.simpleWeylElement_eq_coroot_mul i A s]
    exact Subgroup.mul_mem _ (D.torusPoints_mem_weylSubgroup A _)
      (D.weylElement_mem_weylSubgroup A i)
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
    rw [t.reflectionPerm_rationalRootSystem ht]
    let ε : Aˣ := Units.map (Int.castRingHom A).toMonoidHom
      (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ)
    have hε : ε * (ε * s) = s := by
      rcases Int.units_eq_one_or (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ) with h | h <;>
        ext <;> simp [ε, h]
    have hconj := D.weylElement_conj_weylElement i γ A (ε * s)
    rw [hε] at hconj
    rw [← hconj]
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _ (D.weylElement_mem_weylSubgroup A i) (ih (ε * s)))
      (Subgroup.inv_mem _ (D.weylElement_mem_weylSubgroup A i))

/-- The Weyl subgroup is generated by the actual torus together with the pinned Weyl elements
`n_γ(1)` for all roots `γ`, not only the simple ones. -/
theorem weylSubgroup_eq_closure_allRoots (A : Type v) [CommRing A] :
    D.weylSubgroup A = Subgroup.closure
      (Set.range (D.torusPoints A) ∪ Set.range fun γ : Fin t.numRoots => D.weylElement γ A 1) := by
  apply le_antisymm
  · rw [D.weylSubgroup_def]
    refine Subgroup.closure_mono (Set.union_subset_union_right _ ?_)
    rintro _ ⟨i, rfl⟩
    exact ⟨t.simpleIndex ht i, rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ (⟨s, rfl⟩ | ⟨γ, rfl⟩)
    · exact D.torusPoints_mem_weylSubgroup A s
    · exact D.weylElement_unit_mem_weylSubgroup A γ 1

/-- Over any field, `D.weylProjection K` sends every all-root Weyl element `n_γ(s)` (`s : Kˣ`)
to the reflection `s_γ` in `γ`. -/
@[simp]
theorem weylProjection_weylElement_unit (K : Type v) [Field K] (γ : Fin t.numRoots) (s : Kˣ) :
    D.weylProjection K ⟨D.weylElement γ K s, D.weylElement_unit_mem_weylSubgroup K γ s⟩ =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) γ := by
  refine (t.rationalBase ht).induction_simple_reflect γ
    (p := fun k => ∀ s : Kˣ,
      D.weylProjection K ⟨D.weylElement k K s, D.weylElement_unit_mem_weylSubgroup K k s⟩ =
        RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) k)
    (fun γ hγ s => ?_) (fun γ j ih hj s => ?_) s
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hγ
    have hsub : (⟨D.weylElement (t.simpleIndex ht i) K s,
        D.weylElement_unit_mem_weylSubgroup K (t.simpleIndex ht i) s⟩ : D.weylSubgroup K) =
        ⟨D.torusPoints K (D.simpleCorootParameter i K s), D.torusPoints_mem_weylSubgroup K _⟩ *
          ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩ :=
      Subtype.ext (D.simpleWeylElement_eq_coroot_mul i K s)
    rw [hsub, map_mul, D.weylProjection_torusPoints, one_mul, D.weylProjection_weylElement]
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
    let ε : Kˣ := Units.map (Int.castRingHom K).toMonoidHom
      (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ)
    have hε : ε * (ε * s) = s := by
      rcases Int.units_eq_one_or (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ) with h | h <;>
        ext <;> simp [ε, h]
    have hconj := D.weylElement_conj_weylElement i γ K (ε * s)
    rw [hε] at hconj
    have hsub : (⟨D.weylElement
          ((t.rationalRootSystem ht).reflectionPerm (t.simpleIndex ht i) γ) K s,
        D.weylElement_unit_mem_weylSubgroup K _ s⟩ : D.weylSubgroup K) =
        ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩ *
          ⟨D.weylElement γ K (ε * s), D.weylElement_unit_mem_weylSubgroup K γ (ε * s)⟩ *
          ⟨D.weylElement (t.simpleIndex ht i) K 1, D.weylElement_mem_weylSubgroup K i⟩⁻¹ := by
      apply Subtype.ext
      simpa only [t.reflectionPerm_rationalRootSystem ht, Subgroup.coe_mul, Subgroup.coe_inv] using
        hconj.symm
    rw [hsub, map_mul, map_mul, map_inv, D.weylProjection_weylElement, ih (ε * s),
      t.reflectionPerm_rationalRootSystem ht,
      ← RootPairing.weylGroupToPerm_ofIdx_apply (t.simplyConnectedRootDatum ht),
      RootPairing.weylGroup.ofIdx_weylGroupToPerm_eq_conj]

/-! ## Diagonal entries and equal-weight vanishing on `positivePoints` -/

/-- Auxiliary copy of `Fin D.dim` carrying the decreasing weight-degree order with either the
standard or reversed index order as tie-breaker. -/
private def LexWeightIndex (_rev : Bool) : Type :=
  Fin D.dim

private instance (rev : Bool) : Fintype (D.LexWeightIndex rev) :=
  inferInstanceAs (Fintype (Fin D.dim))

private noncomputable instance (rev : Bool) : LinearOrder (D.LexWeightIndex rev) :=
  match rev with
  | false =>
    LinearOrder.lift'
      (fun x : Fin D.dim => toLex (OrderDual.toDual (t.weightDegree ht (D.weight x)), x))
      (fun _ _ h => congrArg (fun z => (ofLex z).2) h)
  | true =>
    LinearOrder.lift'
      (fun x : Fin D.dim =>
        toLex (OrderDual.toDual (t.weightDegree ht (D.weight x)), OrderDual.toDual x))
      (fun _ _ h => OrderDual.toDual.injective (congrArg (fun z => (ofLex z).2) h))

private def lexWeightIndexEquiv (rev : Bool) : Fin D.dim ≃ D.LexWeightIndex rev :=
  Equiv.refl (Fin D.dim)

private theorem isUpperUnitriangular_positiveSubgroup_lexWeightIndex (rev : Bool)
    (A : Type v) [CommRing A] {g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)}
    (hg : g ∈ D.positiveSubgroup (CommAlgCat.of ℤ A)) :
    ((Units.map (LinearMap.toMatrixAlgEquiv
        ((D.basis.reindex (D.lexWeightIndexEquiv rev)).baseChange A)).toMulEquiv g :
        Matrix.GeneralLinearGroup (D.LexWeightIndex rev) A) :
      Matrix (D.LexWeightIndex rev) (D.LexWeightIndex rev) A).IsUpperUnitriangular := by
  have hwt (x : D.LexWeightIndex rev) :
      IsCartanWeightVector (t.lieBasis ht).h D.representation
        (D.weight ((D.lexWeightIndexEquiv rev).symm x))
        (((D.basis.reindex (D.lexWeightIndexEquiv rev) x : D.lattice) : D.carrier)) := by
    rw [Module.Basis.reindex_apply]
    exact D.isCartanWeightVector_basis _
  have hpos : ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      ∀ {r s : D.LexWeightIndex rev} {m : ℕ}, 0 < m →
        D.weight ((D.lexWeightIndexEquiv rev).symm r) =
          D.weight ((D.lexWeightIndexEquiv rev).symm s) +
            m • (t.simplyConnectedRootDatum ht).root γ → r < s := by
    intro γ hγ r s m hm hrs
    have hdeg : t.weightDegree ht (D.weight ((D.lexWeightIndexEquiv rev).symm s)) <
        t.weightDegree ht (D.weight ((D.lexWeightIndexEquiv rev).symm r)) := by
      rw [hrs, map_add, map_nsmul]
      exact lt_add_of_pos_right _ (nsmul_pos (t.weightDegree_root_pos ht hγ) hm.ne')
    cases rev
    · exact Prod.Lex.left _ _ hdeg
    · exact Prod.Lex.left _ _ hdeg
  have hg' : g ∈ kostantSubsystemSubgroup (t.chevalleySystem ht) (t.lieBasis ht).h
      D.representation D.lattice
      (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
      (isNilpotent_apply_ι_chevalleySystem D.representation
        D.isNilpotent_representation_rootGenerator)
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (CommAlgCat.of ℤ A) := by
    simpa only [kostantSubsystemSubgroup_eq_iSup,
      kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator,
      ← D.positiveSubgroup_eq_iSup] using hg
  exact UpperUnitriangularGroup.mem_iff.mp <|
    map_kostantSubsystemSubgroup_le_upperUnitriangular
      (t.chevalleySystem ht) (t.lieBasis ht).h D.representation D.lattice
      (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
      (isNilpotent_apply_ι_chevalleySystem D.representation
        D.isNilpotent_representation_rootGenerator)
      (D.basis.reindex (D.lexWeightIndexEquiv rev))
      (fun x => D.weight ((D.lexWeightIndexEquiv rev).symm x))
      (t.simplyConnectedRootDatum ht).root
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
      hwt (fun γ _ j => t.lie_lieBasis_h_chevalleySystem ht γ j) hpos A ⟨g, hg', rfl⟩

private theorem toMatrix_reindex_lexWeightIndex_apply (rev : Bool) (A : Type v) [CommRing A]
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)) (p q : Fin D.dim) :
    ((Units.map (LinearMap.toMatrixAlgEquiv
        ((D.basis.reindex (D.lexWeightIndexEquiv rev)).baseChange A)).toMulEquiv g :
        Matrix.GeneralLinearGroup (D.LexWeightIndex rev) A) :
      Matrix (D.LexWeightIndex rev) (D.LexWeightIndex rev) A)
        (D.lexWeightIndexEquiv rev p) (D.lexWeightIndexEquiv rev q) =
      ((Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv g :
        Matrix.GeneralLinearGroup (Fin D.dim) A) :
        Matrix (Fin D.dim) (Fin D.dim) A) p q := by
  simp [Module.Basis.baseChange_reindex, LinearMap.toMatrixAlgEquiv_apply,
    Module.Basis.reindex_apply]

/-- Every positive point has diagonal matrix entries equal to `1` in the datum's weight basis,
over every commutative ring. -/
theorem coe_positivePoints_apply_self (A : Type v) [CommRing A] {u : D.points A}
    (hu : u ∈ D.positivePoints A) (p : Fin D.dim) :
    ((u : Matrix.GeneralLinearGroup (Fin D.dim) A) : Matrix (Fin D.dim) (Fin D.dim) A) p p = 1 := by
  obtain ⟨g, hg, hgu⟩ := (D.mem_positivePoints_iff).mp hu
  rw [← hgu, ← D.toMatrix_reindex_lexWeightIndex_apply false A g p p]
  exact (D.isUpperUnitriangular_positiveSubgroup_lexWeightIndex false A hg).apply_diag _

/-- Every positive point has zero off-diagonal matrix entries between basis vectors of equal
weight, over every commutative ring. -/
theorem coe_positivePoints_apply_eq_zero_of_weight_eq (A : Type v) [CommRing A] {u : D.points A}
    (hu : u ∈ D.positivePoints A) {p q : Fin D.dim} (hpq : p ≠ q)
    (hwt : D.weight p = D.weight q) :
    ((u : Matrix.GeneralLinearGroup (Fin D.dim) A) : Matrix (Fin D.dim) (Fin D.dim) A) p q = 0 := by
  obtain ⟨g, hg, hgu⟩ := (D.mem_positivePoints_iff).mp hu
  rw [← hgu]
  rcases lt_or_gt_of_ne hpq with hpq' | hqp'
  · rw [← D.toMatrix_reindex_lexWeightIndex_apply true A g p q]
    refine (D.isUpperUnitriangular_positiveSubgroup_lexWeightIndex true A hg).isUpperTriangular ?_
    change toLex (OrderDual.toDual (t.weightDegree ht (D.weight q)), OrderDual.toDual q) <
      toLex (OrderDual.toDual (t.weightDegree ht (D.weight p)), OrderDual.toDual p)
    rw [hwt]
    exact Prod.Lex.right _ hpq'
  · rw [← D.toMatrix_reindex_lexWeightIndex_apply false A g p q]
    refine (D.isUpperUnitriangular_positiveSubgroup_lexWeightIndex false A hg).isUpperTriangular ?_
    change toLex (OrderDual.toDual (t.weightDegree ht (D.weight q)), q) <
      toLex (OrderDual.toDual (t.weightDegree ht (D.weight p)), p)
    rw [hwt]
    exact Prod.Lex.right _ hqp'

/-! ## The Borel–Weyl intersection over a field -/

/-- Any point lying in both `D.borelSubgroup K` and `D.weylSubgroup K` has trivial Weyl
projection. -/
theorem weylProjection_eq_one_of_mem_borelSubgroup (K : Type v) [Field K] {g : D.points K}
    (hgB : g ∈ D.borelSubgroup K) (hgN : g ∈ D.weylSubgroup K) :
    D.weylProjection K ⟨g, hgN⟩ = 1 := by
  let _ := t.isReduced_simplyConnectedRootDatum ht
  by_contra hw
  obtain ⟨γ, hγ⟩ := inversions_nonempty_of_ne_one
    (P := t.simplyConnectedRootDatum ht) (b := t.simplyConnectedBase ht) hw
  have hγpos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [posRoots_rationalRootSystem]
    exact inversions_subset_posRoots _ _ _ hγ
  have hγneg : (t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K ⟨g, hgN⟩) γ ∈
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [negRoots_eq_compl, posRoots_rationalRootSystem, ← negRoots_eq_compl]
    exact mapsTo_inversions_negRoots _ _ _ hγ
  obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints K ⟨g, hgN⟩ γ
  have hxB : D.rootSubgroupPoints γ K (ofAdd 1) ∈ D.borelSubgroup K :=
    D.positivePoints_le_borelSubgroup K (D.rootSubgroupPoints_mem_positivePoints K hγpos _)
  have hconjB : g * D.rootSubgroupPoints γ K (ofAdd 1) * g⁻¹ ∈ D.borelSubgroup K :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ hgB hxB) (Subgroup.inv_mem _ hgB)
  rw [← MulAut.conj_apply, hc 1] at hconjB
  have hconj1 := (D.rootSubgroupPoints_mem_borelSubgroup_iff_of_mem_negRoots K hγneg _).mp hconjB
  rw [← hc 1, MulAut.conj_apply, conj_eq_one_iff] at hconj1
  exact D.rootSubgroupPoints_ofAdd_one_ne_one K γ hconj1

private theorem coe_positivePoints_eq_one_of_comm_diagGL (L : Type v) [Field L] [Infinite L]
    {u : D.points L} (hu : u ∈ D.positivePoints L)
    (hcomm : ∀ s : Fin t.rank → Lˣ,
      (u : Matrix.GeneralLinearGroup (Fin D.dim) L) *
          diagGL (fun j => torusCharacter s (D.weight j)) =
        diagGL (fun j => torusCharacter s (D.weight j)) *
          (u : Matrix.GeneralLinearGroup (Fin D.dim) L)) :
    (u : Matrix.GeneralLinearGroup (Fin D.dim) L) = 1 := by
  apply Units.ext
  apply Matrix.ext
  intro p q
  by_cases hpq : p = q
  · subst hpq
    simpa using D.coe_positivePoints_apply_self L hu p
  · simp only [Units.val_one, Matrix.one_apply_ne hpq]
    by_cases hwt : D.weight p = D.weight q
    · exact D.coe_positivePoints_apply_eq_zero_of_weight_eq L hu hpq hwt
    · have hchar : weightChar L (D.weight p) ≠ weightChar L (D.weight q) :=
        (weightChar_injective (K := L)).ne hwt
      obtain ⟨s, hs⟩ := DFunLike.ne_iff.mp hchar
      simp only [weightChar_apply] at hs
      have hentry := congrArg
        (fun x : Matrix.GeneralLinearGroup (Fin D.dim) L =>
          (x : Matrix (Fin D.dim) (Fin D.dim) L) p q) (hcomm s)
      simp only [Units.val_mul, diagGL_coe, Matrix.mul_diagonal, Matrix.diagonal_mul] at hentry
      have hsub : ((torusCharacter s (D.weight p) : L) - (torusCharacter s (D.weight q) : L)) *
          ((u : Matrix.GeneralLinearGroup (Fin D.dim) L) :
            Matrix (Fin D.dim) (Fin D.dim) L) p q = 0 := by
        linear_combination hentry.symm
      have hne : (torusCharacter s (D.weight p) : L) - (torusCharacter s (D.weight q) : L) ≠ 0 :=
        sub_ne_zero.mpr (fun h => hs (Units.ext h))
      exact (mul_eq_zero.mp hsub).resolve_left hne

/-- Over any field, `D.positivePoints K` meets `D.weylSubgroup K` trivially. -/
@[simp]
theorem positivePoints_inf_weylSubgroup_eq_bot (K : Type v) [Field K] :
    D.positivePoints K ⊓ D.weylSubgroup K = ⊥ := by
  rw [eq_bot_iff]
  rintro u ⟨huU, huN⟩
  have hw : D.weylProjection K ⟨u, huN⟩ = 1 :=
    D.weylProjection_eq_one_of_mem_borelSubgroup K (D.positivePoints_le_borelSubgroup K huU) huN
  let φ := algebraMap K (AlgebraicClosure K)
  let ubar : D.points (AlgebraicClosure K) :=
    (D.pointsPresentation K).map (D.pointsPresentation (AlgebraicClosure K)) φ u
  have hubar_coe : (ubar : Matrix.GeneralLinearGroup (Fin D.dim) (AlgebraicClosure K)) =
      Matrix.GeneralLinearGroup.map φ (u : Matrix.GeneralLinearGroup (Fin D.dim) K) :=
    GeneralLinear.IntegralPointsPresentation.coe_map
      (D.pointsPresentation K) (D.pointsPresentation (AlgebraicClosure K)) φ u
  have hubar1 : (ubar : Matrix.GeneralLinearGroup (Fin D.dim) (AlgebraicClosure K)) = 1 :=
    D.coe_positivePoints_eq_one_of_comm_diagGL (AlgebraicClosure K)
      (D.map_positivePoints_le φ ⟨u, huU, rfl⟩) fun s => by
        have hs := (D.weylProjection_eq_iff K ⟨u, huN⟩ 1).mp hw s
        rwa [← hubar_coe, map_one, MulAut.one_apply, mul_inv_eq_iff_eq_mul] at hs
  rw [Subgroup.mem_bot]
  apply Subtype.ext
  apply Matrix.GeneralLinearGroup.map_injective φ.injective
  simpa only [hubar_coe, Subgroup.coe_one, map_one] using hubar1

/-- Over any field, `D.weylSubgroup K` meets `D.positivePoints K` trivially. -/
@[simp]
theorem weylSubgroup_inf_positivePoints_eq_bot (K : Type v) [Field K] :
    D.weylSubgroup K ⊓ D.positivePoints K = ⊥ := by
  rw [inf_comm, D.positivePoints_inf_weylSubgroup_eq_bot K]

/-- Over any field, the intersection of the positive Borel-type subgroup with the Weyl subgroup is
the actual torus: `B(K) ∩ N(K) = T(K)`. -/
@[simp]
theorem borelSubgroup_inf_weylSubgroup_eq_range_torusPoints (K : Type v) [Field K] :
    D.borelSubgroup K ⊓ D.weylSubgroup K = (D.torusPoints K).range := by
  apply le_antisymm
  · rintro g ⟨hgB, hgN⟩
    obtain ⟨u, huU, s, rfl⟩ := (D.mem_borelSubgroup_iff K).mp hgB
    have huN : u ∈ D.weylSubgroup K := by
      have h : u = u * D.torusPoints K s * (D.torusPoints K s)⁻¹ := by
        rw [mul_inv_cancel_right]
      rw [h]
      exact Subgroup.mul_mem _ hgN (Subgroup.inv_mem _ (D.torusPoints_mem_weylSubgroup K s))
    have hu1 : u = 1 := by
      have hmem : u ∈ D.positivePoints K ⊓ D.weylSubgroup K := ⟨huU, huN⟩
      rwa [D.positivePoints_inf_weylSubgroup_eq_bot K, Subgroup.mem_bot] at hmem
    rw [hu1, one_mul]
    exact ⟨s, rfl⟩
  · refine le_inf (D.range_torusPoints_le_borelSubgroup K) ?_
    rintro _ ⟨s, rfl⟩
    exact D.torusPoints_mem_weylSubgroup K s

/-- Over any field, `N(K) ∩ B(K) = T(K)`. -/
@[simp]
theorem weylSubgroup_inf_borelSubgroup_eq_range_torusPoints (K : Type v) [Field K] :
    D.weylSubgroup K ⊓ D.borelSubgroup K = (D.torusPoints K).range := by
  rw [inf_comm, D.borelSubgroup_inf_weylSubgroup_eq_range_torusPoints K]

end TauCeti.DynkinType.ChevalleyDatum
