module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Weyl.Quotient

/-!
# Normality of the Borel–Weyl intersection

For a Chevalley datum `D` and a commutative ring `A`, let `N = D.weylSubgroup A` be the subgroup
generated by the actual torus `T = T_D(A)` and the pinned simple Weyl representatives
`nᵢ = nᵢ(1)`, and let `B = D.borelSubgroup A`. Over every commutative ring, `B ∩ N = T`
(`TauCeti.DynkinType.ChevalleyDatum.borelSubgroup_inf_weylSubgroup`), and over every field the
kernel of `D.weylProjection k` is `T` (`TauCeti.DynkinType.ChevalleyDatum.ker_weylProjection`,
pointwise `TauCeti.DynkinType.ChevalleyDatum.weylProjection_eq_one_iff_mem_range_torusPoints`).
This file records the resulting normality of `B ∩ N` in `N`.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.normal_borelSubgroup_subgroupOf_weylSubgroup`: `B ∩ N` is
  normal in `N`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3.
* R. W. Carter, *Simple Groups of Lie Type*, §7.2 and §8.1.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (k : Type v) [CommRing k]

/-- `B ∩ N` is normal in `N`: it is the actual torus, which `N` normalizes. This is the normality
axiom of a Tits system with these subgroups. -/
instance normal_borelSubgroup_subgroupOf_weylSubgroup :
    ((D.borelSubgroup k).subgroupOf (D.weylSubgroup k)).Normal := by
  rw [← Subgroup.inf_subgroupOf_left, inf_comm,
    D.borelSubgroup_inf_weylSubgroup k]
  infer_instance

end TauCeti.DynkinType.ChevalleyDatum
