module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Weyl.Lift
import TauCeti.Algebra.AlgebraicGroup.Chevalley.BigCell.Positive

/-!
# The Weyl quotient of a Chevalley datum

For a Chevalley datum `D` of a valid Dynkin type `t`, write `N(A) = D.weylSubgroup A` for the
subgroup generated by the actual character-lattice torus `T(A) = (D.torusPoints A).range` and
the pinned simple Weyl representatives `D.weylElement (t.simpleIndex ht i) A 1`, which coincides
over every commutative ring `A` with the subgroup generated by `T(A)` and all Steinberg Weyl
representatives `D.weylElement γ A s` (`ChevalleyDatum.weylSubgroup_eq_closure_weylElement_one`,
`ChevalleyDatum.weylSubgroup_eq_closure_weylElement`). Write
`W = (t.simplyConnectedRootDatum ht).weylGroup` for the Weyl group of the pinned root datum.
The torus `T(A)` is normal in `N(A)` over every commutative ring `A`
(`ChevalleyDatum.normal_torusPoints_subgroupOf_weylSubgroup`).

This file identifies the quotient `N(A) ⧸ T(A)` with `W` for every valid Dynkin type (including
type `G₂`) over every nontrivial commutative ring `A`, and identifies the kernel of
`D.weylProjection k` over every field `k`:

1. Over every commutative ring `A`, `ChevalleyDatum.weylQuotientLift A : W →* N(A) ⧸ T(A)` is
   surjective (`ChevalleyDatum.weylQuotientLift_surjective`).
2. Over any nontrivial commutative ring `A` (`Nontrivial A` being necessary since every valid
   Dynkin type has positive rank and hence a nontrivial Weyl group),
   `ChevalleyDatum.geckWeylWordProd_eq_one_of_mem_borelSubgroup` forces `weylQuotientLift` to be
   injective (`ChevalleyDatum.weylQuotientLift_injective`), yielding the canonical isomorphism
   `weylQuotientEquiv : N(A) ⧸ T(A) ≃* W` sending `[n_γ(s)]` to `s_γ` for every root `γ` and
   unit `s : Aˣ` (`ChevalleyDatum.weylQuotientEquiv_mk_weylElement`).
3. Over any field `k` (including finite fields and bad characteristic), `weylQuotientEquiv`
   agrees on cosets with `D.weylProjection k`
   (`ChevalleyDatum.weylQuotientEquiv_mk_eq_weylProjection`), sending every `n_γ(s)` to `s_γ`
   (`ChevalleyDatum.weylProjection_weylElement_root`), whence
   `(D.weylProjection k).ker = T(k)` (`ChevalleyDatum.ker_weylProjection`).

No identification of `D.weylSubgroup A` with the full scheme-theoretic normalizer of the torus
in `D.points A` or Bruhat decomposition of `D.points A` is asserted here.

## Main definitions

* `TauCeti.DynkinType.ChevalleyDatum.weylQuotientEquiv`: the isomorphism
  `N(A) ⧸ T(A) ≃* W` sending `[n_γ(s)]` to `s_γ` over any nontrivial commutative ring `A`.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.weylQuotientLift_injective`: injectivity of `weylQuotientLift`
  over any nontrivial commutative ring `A`.
* `TauCeti.DynkinType.ChevalleyDatum.weylQuotientEquiv_mk_weylElement`: `weylQuotientEquiv` sends
  the coset of every Steinberg Weyl representative `n_γ(s)` to `s_γ`.
* `TauCeti.DynkinType.ChevalleyDatum.weylQuotientEquiv_mk_eq_weylProjection`,
  `TauCeti.DynkinType.ChevalleyDatum.weylProjection_weylElement_root`,
  `TauCeti.DynkinType.ChevalleyDatum.weylProjection_eq_one_iff_mem_range_torusPoints`, and
  `TauCeti.DynkinType.ChevalleyDatum.ker_weylProjection`: over any field `k`, the quotient map
  is `D.weylProjection k` and its kernel is the actual torus.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 22 and Chapter 5, Theorem 7.
* R. W. Carter, *Simple Groups of Lie Type*, §§7.2 and 8.2.
-/

public noncomputable section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-! ## The Weyl quotient isomorphism -/

/-- Over any nontrivial commutative ring `A`, `weylQuotientLift` is injective. -/
theorem weylQuotientLift_injective (A : Type v) [CommRing A] [Nontrivial A] :
    Function.Injective (D.weylQuotientLift A) := by
  rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
  intro w hw
  obtain ⟨l, rfl⟩ := t.geckWeylWordProd_surjective ht w
  rw [MonoidHom.mem_ker, D.weylQuotientLift_geckWeylWordProd A l,
    QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at hw
  exact D.geckWeylWordProd_eq_one_of_mem_borelSubgroup A l
    (D.range_torusPoints_le_borelSubgroup A hw)

/-- **The Weyl quotient isomorphism** `N(A) ⧸ T(A) ≃* W`. Over every nontrivial commutative
ring `A` (`Nontrivial A` being necessary since every valid Dynkin type has positive rank and
hence a nontrivial Weyl group), the quotient of `D.weylSubgroup A` by the actual torus
`(D.torusPoints A).range` is canonically isomorphic to
`(t.simplyConnectedRootDatum ht).weylGroup`, sending the coset of each Steinberg Weyl
representative `n_γ(s)` to the root reflection `s_γ`. -/
def weylQuotientEquiv (A : Type v) [CommRing A] [Nontrivial A] :
    D.weylSubgroup A ⧸ (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A)) ≃*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  (MulEquiv.ofBijective (D.weylQuotientLift A)
    ⟨D.weylQuotientLift_injective A, D.weylQuotientLift_surjective A⟩).symm

/-- The inverse of `weylQuotientEquiv` is `weylQuotientLift`. -/
@[simp]
theorem weylQuotientEquiv_symm_apply (A : Type v) [CommRing A] [Nontrivial A]
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    (D.weylQuotientEquiv A).symm w = D.weylQuotientLift A w :=
  (rfl)

/-- `weylQuotientEquiv` is a left inverse to `weylQuotientLift`. -/
@[simp]
theorem weylQuotientEquiv_weylQuotientLift (A : Type v) [CommRing A] [Nontrivial A]
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.weylQuotientEquiv A (D.weylQuotientLift A w) = w :=
  (D.weylQuotientEquiv A).apply_symm_apply w

/-- `weylQuotientLift` is a left inverse to `weylQuotientEquiv`. -/
@[simp]
theorem weylQuotientLift_weylQuotientEquiv (A : Type v) [CommRing A] [Nontrivial A]
    (x : D.weylSubgroup A ⧸ (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A))) :
    D.weylQuotientLift A (D.weylQuotientEquiv A x) = x :=
  (D.weylQuotientEquiv A).symm_apply_apply x

/-- `weylQuotientEquiv` sends the coset of every Steinberg Weyl representative `n_γ(s)` to the
root reflection `s_γ`. -/
@[simp]
theorem weylQuotientEquiv_mk_weylElement (A : Type v) [CommRing A] [Nontrivial A]
    (γ : Fin t.numRoots) (s : Aˣ) :
    D.weylQuotientEquiv A
        (QuotientGroup.mk
          ⟨D.weylElement γ A s, D.weylElement_root_mem_weylSubgroup A γ s⟩) =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) γ := by
  rw [D.mk_weylElement_eq_mk_one A γ s, ← D.weylQuotientLift_ofIdx A γ,
    D.weylQuotientEquiv_weylQuotientLift]

/-- `weylQuotientEquiv` sends the coset of a word in the pinned simple Weyl representatives to
the Weyl element spelled by that word. -/
@[simp]
theorem weylQuotientEquiv_mk_weylWord (A : Type v) [CommRing A] [Nontrivial A]
    (l : List (Fin t.rank)) :
    D.weylQuotientEquiv A
        (QuotientGroup.mk ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod,
          D.list_prod_map_weylElement_mem_weylSubgroup A l⟩) =
      t.geckWeylWordProd ht l := by
  rw [← D.weylQuotientLift_geckWeylWordProd A l, D.weylQuotientEquiv_weylQuotientLift]

/-- Cosets of points of the actual torus map to `1` under `weylQuotientEquiv`. -/
@[simp]
theorem weylQuotientEquiv_mk_torusPoints (A : Type v) [CommRing A] [Nontrivial A]
    (s : Fin t.rank → Aˣ) :
    D.weylQuotientEquiv A
        (QuotientGroup.mk ⟨D.torusPoints A s, D.torusPoints_mem_weylSubgroup A s⟩) = 1 := by
  have hmk : (QuotientGroup.mk ⟨D.torusPoints A s, D.torusPoints_mem_weylSubgroup A s⟩ :
      D.weylSubgroup A ⧸ (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A))) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr ⟨s, rfl⟩
  rw [hmk, map_one]

/-! ## Comparison with `weylProjection` over a field -/

/-- Over any field `k`, `weylQuotientEquiv` composed with the quotient map agrees with
`D.weylProjection k`. -/
@[simp]
theorem weylQuotientEquiv_mk_eq_weylProjection (k : Type v) [Field k] (g : D.weylSubgroup k) :
    D.weylQuotientEquiv k (QuotientGroup.mk g) = D.weylProjection k g := by
  obtain ⟨l, s, hg⟩ := (D.mem_weylSubgroup_iff_exists_list_prod_mul_torusPoints k).mp g.property
  have hfac : g =
      ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) k 1).prod,
        D.list_prod_map_weylElement_mem_weylSubgroup k l⟩ *
        ⟨D.torusPoints k s, D.torusPoints_mem_weylSubgroup k s⟩ :=
    Subtype.ext hg.symm
  have hproj : D.weylProjection k g = t.geckWeylWordProd ht l := by
    have hsub : g =
        ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) k 1).prod * D.torusPoints k s,
          mul_mem (D.list_prod_map_weylElement_mem_weylSubgroup k l)
            (D.torusPoints_mem_weylSubgroup k s)⟩ :=
      Subtype.ext hg.symm
    rw [hsub, D.weylProjection_list_prod_mul_torusPoints k l s]
  rw [hproj, hfac, QuotientGroup.mk_mul, map_mul, D.weylQuotientEquiv_mk_weylWord,
    D.weylQuotientEquiv_mk_torusPoints, mul_one]

/-- Over any field `k`, `D.weylProjection k` sends every Steinberg Weyl representative `n_γ(s)`
to the root reflection `s_γ`. -/
@[simp]
theorem weylProjection_weylElement_root (k : Type v) [Field k]
    (γ : Fin t.numRoots) (s : kˣ) :
    D.weylProjection k ⟨D.weylElement γ k s, D.weylElement_root_mem_weylSubgroup k γ s⟩ =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) γ := by
  rw [← D.weylQuotientEquiv_mk_eq_weylProjection, D.weylQuotientEquiv_mk_weylElement]

/-- A point of `D.weylSubgroup k` has trivial Weyl projection if and only if it belongs to the
actual character-lattice torus `(D.torusPoints k).range`, over every field `k`. -/
theorem weylProjection_eq_one_iff_mem_range_torusPoints (k : Type v) [Field k]
    (g : D.weylSubgroup k) :
    D.weylProjection k g = 1 ↔ (g : D.points k) ∈ (D.torusPoints k).range := by
  rw [← D.weylQuotientEquiv_mk_eq_weylProjection k g, MulEquiv.map_eq_one_iff,
    QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]

/-- Over every field, the kernel of `D.weylProjection k` is precisely the actual torus inside
`D.weylSubgroup k`. -/
@[simp]
theorem ker_weylProjection (k : Type v) [Field k] :
    (D.weylProjection k).ker = ((D.torusPoints k).range).subgroupOf (D.weylSubgroup k) := by
  ext g
  exact D.weylProjection_eq_one_iff_mem_range_torusPoints k g

end TauCeti.DynkinType.ChevalleyDatum
