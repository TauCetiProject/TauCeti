/-!
# The Weyl-group quotient and Borel intersection of a Chevalley datum

For a Chevalley datum `D`, `D.weylSubgroup` is generated by the actual character-lattice torus
`T_D` and the pinned simple Weyl representatives `n_{αᵢ}(1)`. Over any commutative ring `A`,
conjugation by `n_{αᵢ}(1)` sends Steinberg's Weyl element `n_γ(s)` of an arbitrary root `γ` to
`n_{sᵢ γ}(ε s)` (`weylElement_conj_weylElement`), because the Weyl sign agrees at `γ` and `-γ`.
Hence `D.weylSubgroup A` contains `n_γ(s)` for *every* root `γ` and unit `s`, and every element of
`D.weylSubgroup A` factors as a torus point times a word in the simple Weyl representatives
(`mem_weylSubgroup_iff`).

Replaying the root-system strong exchange condition on words of simple Weyl representatives shows
that any word spelling `1` in the Weyl group already lies in `T_D(A)` over an arbitrary commutative
ring (`weylWord_mem_range_torusPoints_of_geckWeylWordProd_eq_one`). Over any field `k`, this
identifies the kernel of `D.weylProjection k` with `T_D(k)` (`ker_weylProjection`), establishes
the quotient isomorphism `D.weylSubgroup k ⧸ T_D(k) ≃* W` (`weylSubgroupQuotientMulEquiv`), and
shows that `D.borelSubgroup k ⊓ D.weylSubgroup k = T_D(k)` (`borelSubgroup_inf_weylSubgroup`).

## Main definitions

* `TauCeti.DynkinType.ChevalleyDatum.weylSubgroupQuotientMulEquiv`: the multiplicative equivalence
  `D.weylSubgroup k ⧸ T_D(k) ≃* (t.simplyConnectedRootDatum ht).weylGroup` over any field `k`.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.weylElement_conj_weylElement`: conjugating `n_γ(s)` by
  `n_{αᵢ}(1)` produces `n_{sᵢ γ}(ε s)`.
* `TauCeti.DynkinType.ChevalleyDatum.weylElement_mem_weylSubgroup_of_root` and
  `TauCeti.DynkinType.ChevalleyDatum.weylProjection_weylElement_of_root`: every root's Weyl
  elements lie in `D.weylSubgroup` and project to the reflection in that root.
* `TauCeti.DynkinType.ChevalleyDatum.mem_weylSubgroup_iff`: every element of `D.weylSubgroup A` is
  a torus point times a word in the simple Weyl representatives.
* `TauCeti.DynkinType.ChevalleyDatum.ker_weylProjection`: the kernel of `D.weylProjection k` is the
  actual torus `T_D(k)`.
* `TauCeti.DynkinType.ChevalleyDatum.borelSubgroup_inf_weylSubgroup`:
  `D.borelSubgroup k ⊓ D.weylSubgroup k = (D.torusPoints k).range`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19–22 and Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §7.2 and §8.2.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open Multiplicative

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-! ## Conjugation of Weyl elements at arbitrary roots -/

/-- **Conjugating Steinberg's Weyl element by a simple Weyl representative.** Over every
commutative ring `A`, `nᵢ * n_γ(s) * nᵢ⁻¹ = n_{sᵢ γ}(ε s)` where `ε = chevalleyWeylSign αᵢ γ`. -/
theorem weylElement_conj_weylElement (i : Fin t.rank) (γ : Fin t.numRoots) (A : Type v)
    [CommRing A] (s : Aˣ) :
    D.weylElement (t.simpleIndex ht i) A 1 * D.weylElement γ A s *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ =
      D.weylElement
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A
        (Units.map (Int.castRingHom A).toMonoidHom
          (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ) * s) := by
  let P := t.simplyConnectedRootDatum ht
  let nᵢ := D.weylElement (t.simpleIndex ht i) A 1
  let ε := t.chevalleyWeylSign ht (t.simpleIndex ht i) γ
  let εA : Aˣ := Units.map (Int.castRingHom A).toMonoidHom ε
  have hp : P.reflectionPerm (t.simpleIndex ht i) (P.reflectionPerm γ γ) =
      P.reflectionPerm (P.reflectionPerm (t.simpleIndex ht i) γ)
        (P.reflectionPerm (t.simpleIndex ht i) γ) :=
    P.root.injective <| by
      rw [RootPairing.root_reflectionPerm, RootPairing.root_reflectionPerm,
        RootPairing.reflection_apply_self, map_neg, ← RootPairing.root_reflectionPerm,
        ← RootPairing.reflection_apply_self, ← RootPairing.root_reflectionPerm]
  have hε_inv : ε⁻¹ = ε := inv_eq_of_mul_eq_one_left (Int.units_mul_self ε)
  have hval_pos : ((ε : ℤ) : A) * (s : A) = ((εA * s : Aˣ) : A) := by
    simp [εA]
  have hval_neg : ((ε : ℤ) : A) * -((s⁻¹ : Aˣ) : A) = -(((εA * s)⁻¹ : Aˣ) : A) := by
    rw [mul_inv_rev, ← map_inv, hε_inv, Units.val_mul, mul_comm ((s⁻¹ : Aˣ) : A)]
    simp [mul_neg]
  calc
    nᵢ * D.weylElement γ A s * nᵢ⁻¹
        = MulAut.conj nᵢ (D.weylElement γ A s) := (MulAut.conj_apply _ _).symm
    _ = MulAut.conj nᵢ (D.rootSubgroupPoints γ A (ofAdd (s : A))) *
          MulAut.conj nᵢ (D.rootSubgroupPoints (P.reflectionPerm γ γ) A
            (ofAdd (-((s⁻¹ : Aˣ) : A)))) *
          MulAut.conj nᵢ (D.rootSubgroupPoints γ A (ofAdd (s : A))) := by
        rw [D.weylElement_def, map_mul, map_mul]
    _ = D.weylElement (P.reflectionPerm (t.simpleIndex ht i) γ) A (εA * s) := by
        dsimp only [MulAut.conj_apply, nᵢ]
        rw [D.weylElement_conj_rootSubgroupPoints, D.weylElement_conj_rootSubgroupPoints,
          t.chevalleyWeylSign_reflectionPerm_self, hp, hval_pos, hval_neg, D.weylElement_def]

/-- Every Weyl element `n_γ(s)` differs from `n_γ(1)` on the left by a point of the actual torus,
over an arbitrary commutative ring. -/
theorem exists_torusPoints_mul_weylElement_one (γ : Fin t.numRoots) (A : Type v) [CommRing A]
    (s : Aˣ) :
    ∃ r : Fin t.rank → Aˣ, D.weylElement γ A s = D.torusPoints A r * D.weylElement γ A 1 := by
  revert s
  refine (t.rationalBase ht).induction_simple_reflect γ
    (p := fun k => ∀ s : Aˣ, ∃ r, D.weylElement k A s = D.torusPoints A r * D.weylElement k A 1)
    (fun k hk s => ?_) (fun k j hk hj s => ?_)
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hk
    exact ⟨D.simpleCorootParameter i A s, D.simpleWeylElement_eq_coroot_mul i A s⟩
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
    rw [t.reflectionPerm_rationalRootSystem ht]
    let ε := t.chevalleyWeylSign ht (t.simpleIndex ht i) k
    let εA : Aˣ := Units.map (Int.castRingHom A).toMonoidHom ε
    have hε_sq : εA * εA = 1 := by
      rw [← map_mul, Int.units_mul_self, map_one]
    obtain ⟨r₁, hr₁⟩ := hk (εA * s)
    obtain ⟨r₂, hr₂⟩ := hk εA
    have hrel :
        D.weylElement k A (εA * s) = D.torusPoints A (r₁ * r₂⁻¹) * D.weylElement k A εA := by
      rw [map_mul, map_inv, hr₁, hr₂]
      group
    have hconj_s :
        D.weylElement (t.simpleIndex ht i) A 1 * D.weylElement k A (εA * s) *
            (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ =
          D.weylElement ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) k)
            A s := by
      rw [D.weylElement_conj_weylElement, ← mul_assoc, hε_sq, one_mul]
    have hconj_one :
        D.weylElement (t.simpleIndex ht i) A 1 * D.weylElement k A εA *
            (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ =
          D.weylElement ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) k)
            A 1 := by
      rw [D.weylElement_conj_weylElement, hε_sq]
    refine ⟨D.simpleReflectionTorusParameter i A (r₁ * r₂⁻¹), ?_⟩
    rw [← hconj_s, hrel, ← D.weylElement_conj_torusPoints, ← hconj_one]
    group

/-- **Steinberg's Weyl element `n_γ(s)` lies in `D.weylSubgroup A` for every root `γ` and unit
`s`**, over every commutative ring `A`. -/
theorem weylElement_mem_weylSubgroup_of_root (γ : Fin t.numRoots) (A : Type v) [CommRing A]
    (s : Aˣ) : D.weylElement γ A s ∈ D.weylSubgroup A := by
  revert s
  refine (t.rationalBase ht).induction_simple_reflect γ
    (p := fun k => ∀ s : Aˣ, D.weylElement k A s ∈ D.weylSubgroup A)
    (fun k hk s => ?_) (fun k j hk hj s => ?_)
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hk
    rw [D.simpleWeylElement_eq_coroot_mul]
    exact Subgroup.mul_mem _ (D.torusPoints_mem_weylSubgroup A _)
      (D.weylElement_mem_weylSubgroup A i)
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
    rw [t.reflectionPerm_rationalRootSystem ht]
    let εA : Aˣ := Units.map (Int.castRingHom A).toMonoidHom
      (t.chevalleyWeylSign ht (t.simpleIndex ht i) k)
    have hconj := D.weylElement_conj_weylElement i k A (εA⁻¹ * s)
    rw [mul_inv_cancel_left] at hconj
    rw [← hconj]
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _ (D.weylElement_mem_weylSubgroup A i) (hk _))
      (Subgroup.inv_mem _ (D.weylElement_mem_weylSubgroup A i))

/-- **Over a field, Steinberg's Weyl element `n_γ(s)` of any root `γ` projects to the reflection
`s_γ` in the Weyl group.** -/
@[simp]
theorem weylProjection_weylElement_of_root (k : Type v) [Field k] (γ : Fin t.numRoots) (s : kˣ) :
    D.weylProjection k ⟨D.weylElement γ k s, D.weylElement_mem_weylSubgroup_of_root γ k s⟩ =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) γ := by
  revert s
  refine (t.rationalBase ht).induction_simple_reflect γ
    (p := fun γ => ∀ s : kˣ,
      D.weylProjection k ⟨D.weylElement γ k s, D.weylElement_mem_weylSubgroup_of_root γ k s⟩ =
        RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) γ)
    (fun γ hγ s => ?_) (fun γ j hγ hj s => ?_)
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hγ
    have hsub :
        (⟨D.weylElement (t.simpleIndex ht i) k s,
            D.weylElement_mem_weylSubgroup_of_root _ k s⟩ : D.weylSubgroup k) =
          ⟨D.torusPoints k (D.simpleCorootParameter i k s),
            D.torusPoints_mem_weylSubgroup k _⟩ *
          ⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩ :=
      Subtype.ext (D.simpleWeylElement_eq_coroot_mul i k s)
    rw [hsub, map_mul, D.weylProjection_torusPoints, one_mul, D.weylProjection_weylElement]
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
    rw [t.reflectionPerm_rationalRootSystem ht]
    let εk : kˣ := Units.map (Int.castRingHom k).toMonoidHom
      (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ)
    have hconj := D.weylElement_conj_weylElement i γ k (εk⁻¹ * s)
    rw [mul_inv_cancel_left] at hconj
    have hsub :
        (⟨D.weylElement ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) k s,
            D.weylElement_mem_weylSubgroup_of_root _ k s⟩ : D.weylSubgroup k) =
          ⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩ *
          ⟨D.weylElement γ k (εk⁻¹ * s), D.weylElement_mem_weylSubgroup_of_root γ k _⟩ *
          (⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩)⁻¹ :=
      Subtype.ext hconj.symm
    rw [hsub, map_mul, map_mul, map_inv, D.weylProjection_weylElement, hγ,
      ← RootPairing.weylGroup.ofIdx_weylGroupToPerm_eq_conj,
      RootPairing.weylGroupToPerm_ofIdx_apply]

/-! ## Word factorization and strong-exchange reduction in `weylSubgroup` -/

/-- Every product of pinned simple Weyl representatives lies in `D.weylSubgroup A`. -/
theorem weylWord_mem_weylSubgroup (A : Type v) [CommRing A] (l : List (Fin t.rank)) :
    (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod ∈ D.weylSubgroup A :=
  Subgroup.list_prod_mem _ fun x hx => by
    rw [List.mem_map] at hx
    obtain ⟨i, _, rfl⟩ := hx
    exact D.weylElement_mem_weylSubgroup A i

/-- **Normal form of elements in `D.weylSubgroup A`.** Over any commutative ring `A`, every element
of `D.weylSubgroup A` is a torus point times a word in the simple Weyl representatives. -/
theorem mem_weylSubgroup_iff (A : Type v) [CommRing A] {g : D.points A} :
    g ∈ D.weylSubgroup A ↔
      ∃ (s : Fin t.rank → Aˣ) (l : List (Fin t.rank)),
        D.torusPoints A s * (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod = g := by
  constructor
  · intro hg
    rw [D.weylSubgroup_def] at hg
    induction hg using Subgroup.closure_induction_left with
    | one => exact ⟨1, [], by simp⟩
    | mul_left x hx y _ ih =>
      obtain ⟨s, l, rfl⟩ := ih
      rcases hx with ⟨r, rfl⟩ | ⟨i, rfl⟩
      · exact ⟨r * s, l, by rw [map_mul, mul_assoc]⟩
      · refine ⟨D.simpleReflectionTorusParameter i A s, i :: l, ?_⟩
        rw [List.map_cons, List.prod_cons, ← D.weylElement_conj_torusPoints]
        group
    | inv_mul_cancel x hx y _ ih =>
      obtain ⟨s, l, rfl⟩ := ih
      rcases hx with ⟨r, rfl⟩ | ⟨i, rfl⟩
      · exact ⟨r⁻¹ * s, l, by rw [map_mul, map_inv, mul_assoc]⟩
      · refine ⟨(D.simpleCorootParameter i A (-1))⁻¹ * D.simpleReflectionTorusParameter i A s,
            i :: l, ?_⟩
        have hinv :
            (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ =
              D.torusPoints A (D.simpleCorootParameter i A (-1))⁻¹ *
                D.weylElement (t.simpleIndex ht i) A 1 := by
          apply inv_eq_of_mul_eq_one_left
          rw [mul_assoc, D.weylElement_mul_self, D.simpleCorootPoints_eq_torusPoints, ← map_mul,
            inv_mul_cancel, map_one]
        rw [List.map_cons, List.prod_cons, hinv, map_mul, map_inv, ← D.weylElement_conj_torusPoints]
        group
  · rintro ⟨s, l, rfl⟩
    exact Subgroup.mul_mem _ (D.torusPoints_mem_weylSubgroup A s) (D.weylWord_mem_weylSubgroup A l)

private theorem exists_unit_weylWord_conj_weylElement (A : Type v) [CommRing A]
    (l : List (Fin t.rank)) (γ : Fin t.numRoots) (s : Aˣ) :
    ∃ s' : Aˣ,
      (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod * D.weylElement γ A s *
          ((l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod)⁻¹ =
        D.weylElement
          ((t.simplyConnectedRootDatum ht).weylGroupToPerm (t.geckWeylWordProd ht l) γ) A s' := by
  induction l generalizing γ s with
  | nil => exact ⟨s, by simp⟩
  | cons i l ih =>
    obtain ⟨s₁, hs₁⟩ := ih γ s
    refine ⟨Units.map (Int.castRingHom A).toMonoidHom
      (t.chevalleyWeylSign ht (t.simpleIndex ht i)
        ((t.simplyConnectedRootDatum ht).weylGroupToPerm (t.geckWeylWordProd ht l) γ)) * s₁, ?_⟩
    rw [List.map_cons, List.prod_cons, mul_inv_rev, geckWeylWordProd_cons,
      RootPairing.weylGroupToPerm_ofIdx_mul_apply]
    calc
      D.weylElement (t.simpleIndex ht i) A 1 *
            (l.map fun j => D.weylElement (t.simpleIndex ht j) A 1).prod *
            D.weylElement γ A s *
            (((l.map fun j => D.weylElement (t.simpleIndex ht j) A 1).prod)⁻¹ *
              (D.weylElement (t.simpleIndex ht i) A 1)⁻¹)
          = D.weylElement (t.simpleIndex ht i) A 1 *
              ((l.map fun j => D.weylElement (t.simpleIndex ht j) A 1).prod *
                D.weylElement γ A s *
                ((l.map fun j => D.weylElement (t.simpleIndex ht j) A 1).prod)⁻¹) *
              (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ := by group
      _ = _ := by rw [hs₁, D.weylElement_conj_weylElement]

/-- **Strong-exchange shortening of Weyl words in `D.points A`.** If `l` spells a Weyl element
sending a positive root `γ` to a negative root, multiplying the lifted word on the right by
`n_γ(1)` deletes a letter from `l` up to a left factor in the actual torus `T_D(A)`. -/
private theorem exists_eraseIdx_weylWord_mul_weylElement (A : Type v) [CommRing A]
    {γ : Fin t.numRoots} (hγ : (t.simplyConnectedBase ht).IsPos γ) (l : List (Fin t.rank))
    (h : ¬(t.simplyConnectedBase ht).IsPos
      ((t.simplyConnectedRootDatum ht).weylGroupToPerm (t.geckWeylWordProd ht l) γ)) :
    ∃ p < l.length,
      t.geckWeylWordProd ht (l.eraseIdx p) =
        t.geckWeylWordProd ht l *
          RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) γ ∧
      ∃ r : Fin t.rank → Aˣ,
        (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod * D.weylElement γ A 1 =
          D.torusPoints A r *
            ((l.eraseIdx p).map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod := by
  let _ := t.isReduced_simplyConnectedRootDatum ht
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  induction l with
  | nil => exact absurd (by simpa using hγ) h
  | cons j l ih =>
    rw [geckWeylWordProd_cons, RootPairing.weylGroupToPerm_ofIdx_mul_apply] at h
    by_cases hpos : b.IsPos (P.weylGroupToPerm (t.geckWeylWordProd ht l) γ)
    · have hkey : P.weylGroupToPerm (t.geckWeylWordProd ht l) γ = t.simpleIndex ht j := by
        by_contra hne
        have hmem : P.weylGroupToPerm (t.geckWeylWordProd ht l) γ ∈
            posRoots P b \ {t.simpleIndex ht j} :=
          ⟨(mem_posRoots P b _).mpr hpos, hne⟩
        have hjmem : t.simpleIndex ht j ∈ b.support := by
          rw [← support_rationalBase]
          exact simpleIndex_mem_support j
        exact h ((mem_posRoots P b _).mp
          ((reflectionPerm_mem_posRoots_diff_singleton_iff P b hjmem _).mpr hmem).1)
      refine ⟨0, by simp, ?_, ?_⟩
      · rw [List.eraseIdx_cons_zero, geckWeylWordProd_cons, ← hkey,
          RootPairing.weylGroup.ofIdx_weylGroupToPerm_eq_conj,
          inv_mul_cancel_right, mul_assoc, RootPairing.weylGroup.ofIdx_mul_self, mul_one]
      · obtain ⟨s', hs'⟩ := D.exists_unit_weylWord_conj_weylElement A l γ 1
        rw [hkey, D.simpleWeylElement_eq_coroot_mul] at hs'
        have hW :
            (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod * D.weylElement γ A 1 =
              D.torusPoints A (D.simpleCorootParameter j A s') *
                D.weylElement (t.simpleIndex ht j) A 1 *
                (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod :=
          mul_inv_eq_iff_eq_mul.mp hs'
        refine ⟨D.simpleReflectionTorusParameter j A (D.simpleCorootParameter j A s') *
            D.simpleCorootParameter j A (-1), ?_⟩
        rw [List.eraseIdx_cons_zero, List.map_cons, List.prod_cons, mul_assoc, hW,
          map_mul, ← D.simpleCorootPoints_eq_torusPoints j A (-1), ← D.weylElement_mul_self,
          ← D.weylElement_conj_torusPoints]
        group
    · obtain ⟨p, hp, hw, r, hr⟩ := ih hpos
      refine ⟨p + 1, by simpa using hp, ?_, D.simpleReflectionTorusParameter j A r, ?_⟩
      · rw [List.eraseIdx_cons_succ, geckWeylWordProd_cons, hw, geckWeylWordProd_cons, mul_assoc]
      · rw [List.eraseIdx_cons_succ, List.map_cons, List.prod_cons, List.map_cons, List.prod_cons,
          mul_assoc, hr, ← D.weylElement_conj_torusPoints]
        group

/-- **Any word of simple Weyl representatives spelling `1` in the Weyl group lies in the actual
torus `T_D(A)`**, over an arbitrary commutative ring `A`. -/
theorem weylWord_mem_range_torusPoints_of_geckWeylWordProd_eq_one (A : Type v) [CommRing A]
    (l : List (Fin t.rank)) (hl : t.geckWeylWordProd ht l = 1) :
    (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod ∈ (D.torusPoints A).range := by
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  suffices ∀ n (l' : List (Fin t.rank)), l'.length = n → t.geckWeylWordProd ht l' = 1 →
      (l'.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod ∈ (D.torusPoints A).range from
    this l.length l rfl hl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro l' hlen hl'
    rcases List.eq_nil_or_concat l' with rfl | ⟨l₁, k, rfl⟩
    · exact ⟨1, by simp⟩
    · rw [List.concat_eq_append, geckWeylWordProd_append, geckWeylWordProd_cons,
        geckWeylWordProd_nil, mul_one] at hl'
      have hl₁ : t.geckWeylWordProd ht l₁ = RootPairing.weylGroup.ofIdx P (t.simpleIndex ht k) := by
        calc
          t.geckWeylWordProd ht l₁
              = t.geckWeylWordProd ht l₁ *
                  (RootPairing.weylGroup.ofIdx P (t.simpleIndex ht k) *
                    RootPairing.weylGroup.ofIdx P (t.simpleIndex ht k)) := by
                rw [RootPairing.weylGroup.ofIdx_mul_self, mul_one]
          _ = (t.geckWeylWordProd ht l₁ * RootPairing.weylGroup.ofIdx P (t.simpleIndex ht k)) *
                RootPairing.weylGroup.ofIdx P (t.simpleIndex ht k) := (mul_assoc _ _ _).symm
          _ = RootPairing.weylGroup.ofIdx P (t.simpleIndex ht k) := by rw [hl', one_mul]
      have hkpos : b.IsPos (t.simpleIndex ht k) := by
        rw [← mem_posRoots, ← posRoots_rationalRootSystem]
        exact simpleIndex_mem_posRoots k
      have hkneg :
          ¬b.IsPos (P.weylGroupToPerm (t.geckWeylWordProd ht l₁) (t.simpleIndex ht k)) := by
        rw [hl₁, RootPairing.weylGroupToPerm_ofIdx_apply, ← mem_posRoots]
        exact reflectionPerm_self_notMem_posRoots P b ((mem_posRoots P b _).mpr hkpos)
      obtain ⟨p, hp, hwp, r, hr⟩ :=
        D.exists_eraseIdx_weylWord_mul_weylElement A hkpos l₁ hkneg
      have hlen_lt : (l₁.eraseIdx p).length < n := by
        have hlen' := List.length_eraseIdx_add_one hp
        rw [← hlen, List.concat_eq_append, List.length_append]
        omega
      obtain ⟨s, hs⟩ := ih _ hlen_lt (l₁.eraseIdx p) rfl (hwp.trans hl')
      rw [List.concat_eq_append, List.map_append, List.prod_append, List.map_singleton,
        List.prod_singleton, hr, ← hs, ← map_mul]
      exact ⟨r * s, rfl⟩

/-! ## Kernel, quotient isomorphism, and Borel intersection over a field -/

/-- A word in the simple Weyl representatives projects to the word product in the Weyl group. -/
@[simp]
theorem weylProjection_weylWord (k : Type v) [Field k] (l : List (Fin t.rank)) :
    D.weylProjection k
        ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) k 1).prod,
          D.weylWord_mem_weylSubgroup k l⟩ =
      t.geckWeylWordProd ht l := by
  induction l with
  | nil =>
    have h1 :
        (⟨([].map fun i => D.weylElement (t.simpleIndex ht i) k 1).prod,
            D.weylWord_mem_weylSubgroup k []⟩ : D.weylSubgroup k) = 1 :=
      rfl
    rw [h1, map_one, geckWeylWordProd_nil]
  | cons i l ih =>
    have hsub :
        (⟨((i :: l).map fun j => D.weylElement (t.simpleIndex ht j) k 1).prod,
            D.weylWord_mem_weylSubgroup k (i :: l)⟩ : D.weylSubgroup k) =
          ⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩ *
          ⟨(l.map fun j => D.weylElement (t.simpleIndex ht j) k 1).prod,
            D.weylWord_mem_weylSubgroup k l⟩ :=
      Subtype.ext (by simp)
    rw [hsub, map_mul, D.weylProjection_weylElement, ih, geckWeylWordProd_cons]

/-- **Over any field `k`, the kernel of `D.weylProjection k` is the actual torus `T_D(k)`.** -/
@[simp]
theorem ker_weylProjection (k : Type v) [Field k] :
    (D.weylProjection k).ker = ((D.torusPoints k).range).subgroupOf (D.weylSubgroup k) := by
  ext g
  simp only [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
  constructor
  · intro hg
    obtain ⟨s, l, hsl⟩ := (D.mem_weylSubgroup_iff k).mp g.property
    have hsub :
        g = ⟨D.torusPoints k s, D.torusPoints_mem_weylSubgroup k s⟩ *
            ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) k 1).prod,
              D.weylWord_mem_weylSubgroup k l⟩ :=
      Subtype.ext hsl.symm
    have hl : t.geckWeylWordProd ht l = 1 := by
      rw [hsub, map_mul, D.weylProjection_torusPoints, one_mul, D.weylProjection_weylWord] at hg
      exact hg
    rw [← hsl]
    exact Subgroup.mul_mem _ ⟨s, rfl⟩
      (D.weylWord_mem_range_torusPoints_of_geckWeylWordProd_eq_one k l hl)
  · rintro ⟨s, hs⟩
    have hsub : g = ⟨D.torusPoints k s, D.torusPoints_mem_weylSubgroup k s⟩ := Subtype.ext hs.symm
    rw [hsub, D.weylProjection_torusPoints]

/-- **The Weyl quotient isomorphism**: over any field `k`, the quotient of `D.weylSubgroup k` by
the actual torus `T_D(k)` is canonically isomorphic to
`(t.simplyConnectedRootDatum ht).weylGroup`. -/
noncomputable def weylSubgroupQuotientMulEquiv (k : Type v) [Field k] :
    D.weylSubgroup k ⧸ ((D.torusPoints k).range).subgroupOf (D.weylSubgroup k) ≃*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  (QuotientGroup.quotientMulEquivOfEq (D.ker_weylProjection k).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (D.weylProjection k)
      (D.weylProjection_surjective k))

/-- `weylSubgroupQuotientMulEquiv` evaluates on a coset representative via `weylProjection`. -/
@[simp]
theorem weylSubgroupQuotientMulEquiv_mk (k : Type v) [Field k] (g : D.weylSubgroup k) :
    D.weylSubgroupQuotientMulEquiv k (QuotientGroup.mk g) = D.weylProjection k g :=
  (rfl)

/-- **Intersection of the Borel and Weyl subgroups.** Over any field `k`,
`D.borelSubgroup k ⊓ D.weylSubgroup k = (D.torusPoints k).range`. -/
@[simp]
theorem borelSubgroup_inf_weylSubgroup (k : Type v) [Field k] :
    D.borelSubgroup k ⊓ D.weylSubgroup k = (D.torusPoints k).range := by
  let _ := t.isReduced_simplyConnectedRootDatum ht
  let P := t.simplyConnectedRootDatum ht
  let b := t.simplyConnectedBase ht
  apply le_antisymm
  · rintro g ⟨hgB, hgN⟩
    let n : D.weylSubgroup k := ⟨g, hgN⟩
    suffices hw : D.weylProjection k n = 1 by
      have hker : n ∈ (D.weylProjection k).ker := hw
      rwa [D.ker_weylProjection, Subgroup.mem_subgroupOf] at hker
    refine eq_one_of_forall_mem_support_mem_posRoots P b fun γ hγ => ?_
    by_contra hneg
    have hγ_pos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [posRoots_rationalRootSystem]
      exact support_subset_posRoots P b hγ
    have hneg_rat :
        P.weylGroupToPerm (D.weylProjection k n) γ ∈
          negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
      rw [← not_mem_posRoots_iff_mem_negRoots, posRoots_rationalRootSystem]
      exact hneg
    obtain ⟨c, hc⟩ := D.exists_unit_conj_rootSubgroupPoints k n γ
    have hconj := hc ((c⁻¹ : kˣ) : k)
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one] at hconj
    have hmemB :
        D.rootSubgroupPoints (P.weylGroupToPerm (D.weylProjection k n) γ) k (ofAdd 1) ∈
          D.borelSubgroup k := by
      rw [← hconj, MulAut.conj_apply]
      exact Subgroup.mul_mem _
        (Subgroup.mul_mem _ hgB
          (D.positivePoints_le_borelSubgroup k
            (D.rootSubgroupPoints_mem_positivePoints k hγ_pos _)))
        (Subgroup.inv_mem _ hgB)
    rw [D.rootSubgroupPoints_mem_borelSubgroup_iff_of_mem_negRoots k hneg_rat] at hmemB
    exact D.rootSubgroupPoints_ofAdd_one_ne_one k _ hmemB
  · refine le_inf (D.range_torusPoints_le_borelSubgroup k) ?_
    rintro _ ⟨s, rfl⟩
    exact D.torusPoints_mem_weylSubgroup k s

end TauCeti.DynkinType.ChevalleyDatum
