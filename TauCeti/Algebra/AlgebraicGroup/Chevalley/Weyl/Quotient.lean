/-!
# The Weyl quotient and Borel intersection of a Chevalley datum

For a Chevalley datum `D` of a valid Dynkin type `t`, the subgroup `D.weylSubgroup A` is
generated by the actual character-lattice torus `(D.torusPoints A).range` and the pinned
simple Weyl representatives `D.weylElement (t.simpleIndex ht i) A 1`, and the torus is normal
in `D.weylSubgroup A` over every commutative ring `A`
(`ChevalleyDatum.normal_torusPoints_subgroupOf_weylSubgroup`).

This file identifies the quotient `D.weylSubgroup A ⧸ T(A)` with the Weyl group of the pinned
root datum and proves `D.weylSubgroup A ⊓ D.borelSubgroup A = (D.torusPoints A).range`:

1. Over every commutative ring `A`, each pinned simple Weyl representative squares into the
   actual torus (`ChevalleyDatum.weylElement_mul_self`) and satisfies the Artin--Tits braid
   relations in `D.points A` (`ChevalleyDatum.prod_map_weylElement_braidWord`). By Tits'
   Coxeter presentation of the Weyl group (`DynkinType.simplyConnectedWeylCoxeterSystem`),
   the assignment `s_i ↦ [n_i(1)]` extends to a surjective homomorphism `weylQuotientLift`
   from `(t.simplyConnectedRootDatum ht).weylGroup` onto the quotient `N(A) ⧸ T(A)`.
2. Ordering the distinct representation weights by decreasing height makes `D.positivePoints A`
   weight-block unitriangular while `(D.torusPoints A).range` is diagonal. Over any nontrivial
   commutative ring `A`, the matrix big-cell test (`ChevalleyDatum.exists_blockLDU_weylWord_iff`)
   therefore forces any Weyl word lying in `D.borelSubgroup A` to spell `1` in the Weyl group,
   hence to lie in `(D.torusPoints A).range` via `weylQuotientLift`.
3. Consequently `D.weylSubgroup A ⊓ D.borelSubgroup A = (D.torusPoints A).range` over every
   commutative ring `A` (the subsingleton ring case being degenerate), and for every
   nontrivial commutative ring `A` (`Nontrivial A` being necessary whenever `t.rank ≥ 1`),
   `weylQuotientEquiv` is an isomorphism `N(A) ⧸ T(A) ≃* W` sending `[n_i(1)]` to `s_i`.
4. Over any field `k` (including finite fields and bad characteristic), `weylQuotientEquiv`
   agrees on cosets with `D.weylProjection k`, identifying `(D.weylProjection k).ker` with
   the actual torus without an infinite-field assumption.

No identification of `D.weylSubgroup A` with the full scheme-theoretic normalizer of the torus
in `D.points A` or Bruhat decomposition of `D.points A` is asserted here.

## Main definitions

* `TauCeti.DynkinType.ChevalleyDatum.weylQuotientLift`: the surjective homomorphism
  `W →* N(A) ⧸ T(A)` over any commutative ring `A`.
* `TauCeti.DynkinType.ChevalleyDatum.weylQuotientEquiv`: the isomorphism
  `N(A) ⧸ T(A) ≃* W` sending `[n_i(1)]` to `s_i` over any nontrivial commutative ring `A`.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.mem_weylSubgroup_iff`: every element of `D.weylSubgroup A`
  is a torus point times a word in the pinned simple Weyl representatives.
* `TauCeti.DynkinType.ChevalleyDatum.weylWord_mem_borelSubgroup_iff`: over a nontrivial ring,
  a word in the pinned simple Weyl elements lies in `D.borelSubgroup A` iff it spells `1`.
* `TauCeti.DynkinType.ChevalleyDatum.weylSubgroup_inf_borelSubgroup`:
  `D.weylSubgroup A ⊓ D.borelSubgroup A = (D.torusPoints A).range` over any commutative ring.
* `TauCeti.DynkinType.ChevalleyDatum.weylQuotientEquiv_mk_eq_weylProjection` and
  `TauCeti.DynkinType.ChevalleyDatum.ker_weylProjection`: over any field `k`, the quotient map
  is `D.weylProjection k` and its kernel is the actual torus.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 22 and Chapter 5, Theorem 7.
* R. W. Carter, *Simple Groups of Lie Type*, §7.2 and §8.2.
-/

public noncomputable section

open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

attribute [local instance high] Algebra.toModule

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-! ## Normal form in the Weyl subgroup -/

/-- A word in the pinned simple Weyl representatives belongs to `D.weylSubgroup A`. -/
theorem weylWord_mem_weylSubgroup (A : Type v) [CommRing A] (l : List (Fin t.rank)) :
    (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod ∈ D.weylSubgroup A :=
  (D.weylSubgroup A).list_prod_mem fun _ hg => by
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hg
    exact D.weylElement_mem_weylSubgroup A i

/-- Every element of `D.weylSubgroup A` factors as a point of the actual torus followed by a
product of pinned simple Weyl representatives, over any commutative ring `A`. -/
theorem mem_weylSubgroup_iff (A : Type v) [CommRing A] {g : D.points A} :
    g ∈ D.weylSubgroup A ↔
      ∃ (s : Fin t.rank → Aˣ) (l : List (Fin t.rank)),
        g = D.torusPoints A s *
          (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod := by
  constructor
  · intro hg
    have hmul_weyl (i : Fin t.rank) (s : Fin t.rank → Aˣ) (l : List (Fin t.rank)) :
        D.weylElement (t.simpleIndex ht i) A 1 *
          (D.torusPoints A s * (l.map fun j => D.weylElement (t.simpleIndex ht j) A 1).prod) =
          D.torusPoints A (D.simpleReflectionTorusParameter i A s) *
            ((i :: l).map fun j => D.weylElement (t.simpleIndex ht j) A 1).prod := by
      rw [← D.weylElement_conj_torusPoints i A s, List.map_cons, List.prod_cons]
      group
    rw [D.weylSubgroup_def] at hg
    induction hg using Subgroup.closure_induction_left with
    | one => exact ⟨1, [], by simp⟩
    | mul_left x hx y _ ih =>
      obtain ⟨s, l, rfl⟩ := ih
      rcases hx with ⟨r, rfl⟩ | ⟨i, rfl⟩
      · exact ⟨r * s, l, by rw [(D.torusPoints A).map_mul, mul_assoc]⟩
      · exact ⟨D.simpleReflectionTorusParameter i A s, i :: l, hmul_weyl i s l⟩
    | inv_mul_cancel x hx y _ ih =>
      obtain ⟨s, l, rfl⟩ := ih
      rcases hx with ⟨r, rfl⟩ | ⟨i, rfl⟩
      · exact ⟨r⁻¹ * s, l, by rw [(D.torusPoints A).map_mul, map_inv, mul_assoc]⟩
      · have hinv : (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ =
            D.torusPoints A (D.simpleCorootParameter i A (-1))⁻¹ *
              D.weylElement (t.simpleIndex ht i) A 1 := by
          apply inv_eq_of_mul_eq_one_left
          rw [mul_assoc, D.weylElement_mul_self i A, D.simpleCorootPoints_eq_torusPoints,
            ← (D.torusPoints A).map_mul, inv_mul_cancel, map_one]
        refine ⟨(D.simpleCorootParameter i A (-1))⁻¹ *
          D.simpleReflectionTorusParameter i A s, i :: l, ?_⟩
        rw [hinv, mul_assoc, hmul_weyl i s l, ← mul_assoc, ← (D.torusPoints A).map_mul]
  · rintro ⟨s, l, rfl⟩
    exact (D.weylSubgroup A).mul_mem
      (D.torusPoints_mem_weylSubgroup A s) (D.weylWord_mem_weylSubgroup A l)

/-! ## Lifting the Coxeter presentation to the Weyl quotient -/

/-- A family of involutions in a group satisfying the braid-word equations of a Coxeter matrix
satisfies `CoxeterMatrix.IsLiftable`. -/
private theorem isLiftable_of_mul_self_of_braidWord {B Q : Type*} [Group Q]
    (M : CoxeterMatrix B) (f : B → Q) (hsq : ∀ i, f i * f i = 1)
    (hbraid : ∀ i j, ((CoxeterSystem.braidWord M i j).map f).prod =
      ((CoxeterSystem.braidWord M j i).map f).prod) :
    M.IsLiftable f := by
  have hinv (i : B) : (f i)⁻¹ = f i := inv_eq_of_mul_eq_one_right (hsq i)
  intro i j
  have hrev : f j * f i = (f i * f j)⁻¹ := by rw [mul_inv_rev, hinv, hinv]
  have hb := hbraid i j
  rw [CoxeterSystem.braidWord, CoxeterSystem.braidWord, M.symmetric j i,
    TauCeti.prod_map_alternatingWord, TauCeti.prod_map_alternatingWord, hrev, inv_pow] at hb
  rcases Nat.even_or_odd' (M i j) with ⟨k, hm | hm⟩
  · rw [hm] at hb ⊢
    simp only [even_two, Even.mul_right, ↓reduceIte, one_mul,
      Nat.mul_div_right _ zero_lt_two] at hb
    rw [Nat.mul_comm, pow_mul, pow_two]
    nth_rw 2 [hb]
    exact mul_inv_cancel _
  · rw [hm] at hb ⊢
    have hnot : ¬ Even (2 * k + 1) := by simp [parity_simps]
    have hdiv : (2 * k + 1) / 2 = k := by omega
    simp only [hnot, ↓reduceIte, hdiv] at hb
    have hmul : f i * (f j * (f i * f j) ^ k) * (f i * f j) ^ k =
        f i * (f i * ((f i * f j) ^ k)⁻¹) * (f i * f j) ^ k :=
      congrArg (fun x => f i * x * (f i * f j) ^ k) hb
    rw [← mul_assoc (f i) (f i), hsq i, one_mul, inv_mul_cancel] at hmul
    calc
      (f i * f j) ^ (2 * k + 1) =
          (f i * f j) * (f i * f j) ^ k * (f i * f j) ^ k := by
        rw [← pow_succ', ← pow_add]
        congr 1
        omega
      _ = 1 := by simpa only [mul_assoc] using hmul

private theorem isLiftable_weylQuotient (A : Type v) [CommRing A] :
    t.coxeterMatrix.IsLiftable (fun i : Fin t.rank =>
      (QuotientGroup.mk
        ⟨D.weylElement (t.simpleIndex ht i) A 1, D.weylElement_mem_weylSubgroup A i⟩ :
        D.weylSubgroup A ⧸ (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A)))) := by
  let n_sub (k : Fin t.rank) : D.weylSubgroup A :=
    ⟨D.weylElement (t.simpleIndex ht k) A 1, D.weylElement_mem_weylSubgroup A k⟩
  let q := QuotientGroup.mk' (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A))
  have hcoe (l : List (Fin t.rank)) :
      ((l.map n_sub).prod : D.points A) =
        (l.map fun k => D.weylElement (t.simpleIndex ht k) A 1).prod := by
    simpa only [Subgroup.coe_subtype, List.map_map, Function.comp_def] using
      (D.weylSubgroup A).subtype.map_list_prod (l.map n_sub)
  apply isLiftable_of_mul_self_of_braidWord t.coxeterMatrix (fun i => q (n_sub i))
  · intro i
    rw [← map_mul, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf,
      Subgroup.coe_mul, D.weylElement_mul_self i A, D.simpleCorootPoints_eq_torusPoints]
    exact ⟨_, rfl⟩
  · intro i j
    have hsub : ((CoxeterSystem.braidWord t.coxeterMatrix i j).map n_sub).prod =
        ((CoxeterSystem.braidWord t.coxeterMatrix j i).map n_sub).prod :=
      Subtype.ext <| (hcoe _).trans <|
        (D.prod_map_weylElement_braidWord i j A).trans (hcoe _).symm
    simpa only [map_list_prod, List.map_map, Function.comp_def] using congrArg q hsub

/-- **The Coxeter lift from the Weyl group to the torus-normalizer quotient.** Over every
commutative ring `A`, sending the `i`-th simple reflection to the coset of the pinned simple
Weyl representative `n_i(1)` extends uniquely to a group homomorphism from
`(t.simplyConnectedRootDatum ht).weylGroup` to `N(A) ⧸ T(A)`. -/
def weylQuotientLift (A : Type v) [CommRing A] :
    (t.simplyConnectedRootDatum ht).weylGroup →*
      D.weylSubgroup A ⧸ (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A)) :=
  (t.simplyConnectedWeylCoxeterSystem ht).lift ⟨_, D.isLiftable_weylQuotient A⟩

/-- `weylQuotientLift` sends each Bourbaki simple reflection to the coset of its pinned simple
Weyl representative. -/
-- Concrete rank equations can normalize dependent indices before matching.
@[simp↓]
theorem weylQuotientLift_ofIdx (A : Type v) [CommRing A] (i : Fin t.rank) :
    D.weylQuotientLift A
        (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) =
      QuotientGroup.mk
        ⟨D.weylElement (t.simpleIndex ht i) A 1, D.weylElement_mem_weylSubgroup A i⟩ := by
  rw [weylQuotientLift, ← t.simplyConnectedWeylCoxeterSystem_simple ht i,
    CoxeterSystem.lift_apply_simple]

/-- `weylQuotientLift` sends the Weyl element spelled by a node word `l` to the coset of the
corresponding product of pinned simple Weyl representatives. -/
@[simp]
theorem weylQuotientLift_geckWeylWordProd (A : Type v) [CommRing A] (l : List (Fin t.rank)) :
    D.weylQuotientLift A (t.geckWeylWordProd ht l) =
      QuotientGroup.mk ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod,
        D.weylWord_mem_weylSubgroup A l⟩ := by
  induction l with
  | nil =>
    rw [geckWeylWordProd_nil, map_one, eq_comm, QuotientGroup.eq_one_iff]
    exact Subgroup.one_mem _
  | cons i l ih =>
    rw [geckWeylWordProd_cons, map_mul, D.weylQuotientLift_ofIdx A i, ih, ← QuotientGroup.mk_mul]
    rfl

/-- `weylQuotientLift` is surjective over every commutative ring `A`. -/
theorem weylQuotientLift_surjective (A : Type v) [CommRing A] :
    Function.Surjective (D.weylQuotientLift A) := by
  intro x
  obtain ⟨⟨g, hg⟩, rfl⟩ := QuotientGroup.mk_surjective x
  obtain ⟨s, l, rfl⟩ := (D.mem_weylSubgroup_iff A).mp hg
  refine ⟨t.geckWeylWordProd ht l, ?_⟩
  have htorus : (QuotientGroup.mk ⟨D.torusPoints A s, D.torusPoints_mem_weylSubgroup A s⟩ :
      D.weylSubgroup A ⧸ (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A))) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr ⟨s, rfl⟩
  have hmul : (⟨D.torusPoints A s * (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod,
      hg⟩ : D.weylSubgroup A) =
      ⟨D.torusPoints A s, D.torusPoints_mem_weylSubgroup A s⟩ *
        ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod,
          D.weylWord_mem_weylSubgroup A l⟩ := rfl
  rw [D.weylQuotientLift_geckWeylWordProd A l, hmul, QuotientGroup.mk_mul, htorus, one_mul]

/-- Over every commutative ring `A`, any word in the pinned simple Weyl representatives that
spells `1` in the Weyl group lies in the actual torus `(D.torusPoints A).range`. -/
theorem weylWord_mem_range_torusPoints_of_geckWeylWordProd_eq_one
    (A : Type v) [CommRing A] {l : List (Fin t.rank)} (hl : t.geckWeylWordProd ht l = 1) :
    (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod ∈ (D.torusPoints A).range := by
  have hq := D.weylQuotientLift_geckWeylWordProd A l
  rw [hl, map_one, eq_comm, QuotientGroup.eq_one_iff] at hq
  exact hq

/-! ## Intersection with the Borel subgroup -/

/-- Ranking the basis indices of `D` by decreasing height of their distinct weights makes every
point of `D.positivePoints A` weight-block unitriangular. -/
private theorem blockUnitriangular_of_mem_positivePoints (A : Type v) [CommRing A]
    {u : D.points A} (hu : u ∈ D.positivePoints A) :
    let r := orderedWeightIndexEquiv (t.weightDegree ht)
      (Subtype.val : Set.range D.weight → Fin t.rank → ℤ)
    (((u : Matrix.GeneralLinearGroup (Fin D.dim) A) : Matrix (Fin D.dim) (Fin D.dim) A)
      ).BlockUnitriangular fun j => r ⟨D.weight j, Set.mem_range_self j⟩ := by
  dsimp only
  rw [D.positivePoints_eq_closure] at hu
  induction hu using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨γ, hγ, a, rfl⟩ := hg
    have hmat : ((D.rootSubgroupPoints γ A a : Matrix.GeneralLinearGroup (Fin D.dim) A) :
        Matrix (Fin D.dim) (Fin D.dim) A) =
        kostantRootSubgroupMatrix (t.chevalleySystem ht) (t.lieBasis ht).h D.representation
          D.lattice (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
            D.representation_mem_lattice D.isNilpotent_representation_rootGenerator) γ
          (isNilpotent_apply_ι_chevalleySystem D.representation
            D.isNilpotent_representation_rootGenerator γ) D.basis
          ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm a) := by
      rw [D.coe_rootSubgroupPoints, ← kostantRootSubgroupParam_chevalleySystem,
        basisMatrix_kostantRootSubgroupParam]
    rw [hmat]
    refine Matrix.blockUnitriangular_of_apply_eq_one_apply_of_not_lt fun i j hij => ?_
    apply kostantRootSubgroupMatrix_apply_eq_one_apply_of_forall_weight_ne
      (t.chevalleySystem ht) (t.lieBasis ht).h D.representation D.lattice _ D.basis D.weight γ _
      D.isCartanWeightVector_basis (t.lie_lieBasis_h_chevalleySystem ht γ) _
    intro n hn heq
    apply hij
    exact orderedWeightIndexEquiv_lt_of_eq_add_nsmul (t.weightDegree ht) Subtype.val
      (t.weightDegree_root_pos ht hγ) hn heq
  | one => exact Matrix.blockUnitriangular_one
  | mul x y _ _ hx hy => exact hx.mul hy
  | inv x _ hx =>
    rw [Subgroup.coe_inv, Matrix.coe_units_inv]
    exact hx.inv

/-- **A Weyl word lies in the positive Borel subgroup if and only if it spells `1`.** Over any
nontrivial commutative ring `A`, a product of pinned simple Weyl representatives belongs to
`D.borelSubgroup A` precisely when its image in the Weyl group is the identity. -/
theorem weylWord_mem_borelSubgroup_iff (A : Type v) [CommRing A] [Nontrivial A]
    (l : List (Fin t.rank)) :
    (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod ∈ D.borelSubgroup A ↔
      t.geckWeylWordProd ht l = 1 := by
  constructor
  · intro hmem
    obtain ⟨u, hu, s, hs⟩ := (D.mem_borelSubgroup_iff A).mp ((D.borelSubgroup A).inv_mem hmem)
    let r := orderedWeightIndexEquiv (t.weightDegree ht)
      (Subtype.val : Set.range D.weight → Fin t.rank → ℤ)
    let b (j : Fin D.dim) := r ⟨D.weight j, Set.mem_range_self j⟩
    have hprod : (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod =
        D.torusPoints A s⁻¹ * u⁻¹ := by
      have hinv := congrArg Inv.inv hs
      rwa [mul_inv_rev, ← map_inv, inv_inv, eq_comm] at hinv
    let N : Matrix (Fin D.dim) (Fin D.dim) A :=
      ((D.torusPoints A s⁻¹ : Matrix.GeneralLinearGroup (Fin D.dim) A) :
        Matrix (Fin D.dim) (Fin D.dim) A)
    have hNdiag {i j : Fin D.dim} (hne : i ≠ j) : N i j = 0 := by
      dsimp only [N]
      rw [D.coe_torusPoints A s⁻¹, kostantTorusMatrix_apply, diagGL_apply]
      simp only [hne, ↓reduceIte]
    refine (D.exists_blockLDU_weylWord_iff l A r).mp ⟨1, N,
      ((u⁻¹ : D.points A) : Matrix.GeneralLinearGroup (Fin D.dim) A),
      Matrix.blockUnitriangular_one,
      fun i j hlt => hNdiag fun hij => (ne_of_lt hlt) (congrArg b hij.symm),
      fun i j hlt => hNdiag fun hij => (ne_of_lt hlt) (congrArg (OrderDual.toDual ∘ b) hij.symm),
      D.blockUnitriangular_of_mem_positivePoints A ((D.positivePoints A).inv_mem hu),
      (Matrix.GeneralLinearGroup.det
        (D.torusPoints A s⁻¹ : Matrix.GeneralLinearGroup (Fin D.dim) A)).isUnit, ?_⟩
    rw [one_mul, hprod, Subgroup.coe_mul, Units.val_mul]
  · intro hl
    exact D.range_torusPoints_le_borelSubgroup A
      (D.weylWord_mem_range_torusPoints_of_geckWeylWordProd_eq_one A hl)

/-- **The Weyl subgroup meets the Borel subgroup in the actual torus**, over every commutative
ring `A` (including nonreduced rings, finite fields, bad characteristic, and the zero ring). -/
@[simp]
theorem weylSubgroup_inf_borelSubgroup (A : Type v) [CommRing A] :
    D.weylSubgroup A ⊓ D.borelSubgroup A = (D.torusPoints A).range := by
  refine le_antisymm ?_ (le_inf
    (by rintro _ ⟨s, rfl⟩; exact D.torusPoints_mem_weylSubgroup A s)
    (D.range_torusPoints_le_borelSubgroup A))
  rintro g ⟨hgW, hgB⟩
  by_cases hA : Nontrivial A
  · obtain ⟨s, l, rfl⟩ := (D.mem_weylSubgroup_iff A).mp hgW
    have hwordB : (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod ∈
        D.borelSubgroup A := by
      have hsB : (D.torusPoints A s)⁻¹ ∈ D.borelSubgroup A :=
        (D.borelSubgroup A).inv_mem (D.range_torusPoints_le_borelSubgroup A ⟨s, rfl⟩)
      simpa only [← mul_assoc, inv_mul_cancel, one_mul] using (D.borelSubgroup A).mul_mem hsB hgB
    have hl : t.geckWeylWordProd ht l = 1 := (D.weylWord_mem_borelSubgroup_iff A l).mp hwordB
    exact (D.torusPoints A).range.mul_mem ⟨s, rfl⟩
      (D.weylWord_mem_range_torusPoints_of_geckWeylWordProd_eq_one A hl)
  · have : Subsingleton A := not_nontrivial_iff_subsingleton.mp hA
    refine ⟨1, ?_⟩
    apply Subtype.ext
    apply Matrix.GeneralLinearGroup.ext
    intro i j
    exact Subsingleton.elim _ _

/-- Symmetric form of `weylSubgroup_inf_borelSubgroup`: `B(A) ∩ N(A) = T(A)` over every
commutative ring `A`. -/
@[simp]
theorem borelSubgroup_inf_weylSubgroup (A : Type v) [CommRing A] :
    D.borelSubgroup A ⊓ D.weylSubgroup A = (D.torusPoints A).range := by
  rw [inf_comm, D.weylSubgroup_inf_borelSubgroup A]

/-! ## The Weyl quotient isomorphism -/

/-- Over any nontrivial commutative ring `A`, `weylQuotientLift` is injective. -/
theorem weylQuotientLift_injective (A : Type v) [CommRing A] [Nontrivial A] :
    Function.Injective (D.weylQuotientLift A) := by
  rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
  intro w hw
  obtain ⟨l, rfl⟩ := t.geckWeylWordProd_surjective ht w
  rw [MonoidHom.mem_ker, D.weylQuotientLift_geckWeylWordProd A l,
    QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at hw
  exact (D.weylWord_mem_borelSubgroup_iff A l).mp (D.range_torusPoints_le_borelSubgroup A hw)

/-- **The Weyl quotient isomorphism** `N(A) ⧸ T(A) ≃* W`. Over every nontrivial commutative
ring `A` (`Nontrivial A` being necessary whenever `t.rank ≥ 1`), the quotient of
`D.weylSubgroup A` by the actual torus `(D.torusPoints A).range` is canonically isomorphic to
`(t.simplyConnectedRootDatum ht).weylGroup`, sending the coset of each pinned simple Weyl
representative `n_i(1)` to the simple reflection `s_i`. -/
def weylQuotientEquiv (A : Type v) [CommRing A] [Nontrivial A] :
    D.weylSubgroup A ⧸ (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A)) ≃*
      (t.simplyConnectedRootDatum ht).weylGroup :=
  (MulEquiv.ofBijective (D.weylQuotientLift A)
    ⟨D.weylQuotientLift_injective A, D.weylQuotientLift_surjective A⟩).symm

/-- The inverse of `weylQuotientEquiv` is `weylQuotientLift`. -/
@[simp]
theorem weylQuotientEquiv_symm_apply (A : Type v) [CommRing A] [Nontrivial A]
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    (D.weylQuotientEquiv A).symm w = D.weylQuotientLift A w :=
  (rfl)

/-- `weylQuotientEquiv` sends the coset of the `i`-th pinned simple Weyl representative to the
`i`-th Bourbaki simple reflection. -/
-- Concrete rank equations can normalize dependent indices before matching.
@[simp↓]
theorem weylQuotientEquiv_mk_weylElement (A : Type v) [CommRing A] [Nontrivial A]
    (i : Fin t.rank) :
    D.weylQuotientEquiv A
        (QuotientGroup.mk
          ⟨D.weylElement (t.simpleIndex ht i) A 1, D.weylElement_mem_weylSubgroup A i⟩) =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) := by
  rw [← D.weylQuotientLift_ofIdx A i, ← D.weylQuotientEquiv_symm_apply A]
  exact (D.weylQuotientEquiv A).apply_symm_apply _

/-- `weylQuotientEquiv` sends the coset of a word in the pinned simple Weyl representatives to
the Weyl element spelled by that word. -/
@[simp]
theorem weylQuotientEquiv_mk_weylWord (A : Type v) [CommRing A] [Nontrivial A]
    (l : List (Fin t.rank)) :
    D.weylQuotientEquiv A
        (QuotientGroup.mk ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod,
          D.weylWord_mem_weylSubgroup A l⟩) =
      t.geckWeylWordProd ht l := by
  rw [← D.weylQuotientLift_geckWeylWordProd A l, ← D.weylQuotientEquiv_symm_apply A]
  exact (D.weylQuotientEquiv A).apply_symm_apply _

/-- Cosets of points of the actual torus map to `1` under `weylQuotientEquiv`. -/
@[simp]
theorem weylQuotientEquiv_mk_torusPoints (A : Type v) [CommRing A] [Nontrivial A]
    (s : Fin t.rank → Aˣ) :
    D.weylQuotientEquiv A
        (QuotientGroup.mk ⟨D.torusPoints A s, D.torusPoints_mem_weylSubgroup A s⟩) = 1 := by
  have hmk : (QuotientGroup.mk ⟨D.torusPoints A s, D.torusPoints_mem_weylSubgroup A s⟩ :
      D.weylSubgroup A ⧸ (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A))) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr ⟨s, rfl⟩
  rw [hmk, map_one]

/-! ## Comparison with `weylProjection` over a field -/

/-- Over any field `k`, `weylProjection` sends a word in the pinned simple Weyl representatives
to the Weyl element spelled by that word. -/
@[simp]
theorem weylProjection_weylWord (k : Type v) [Field k] (l : List (Fin t.rank)) :
    D.weylProjection k ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) k 1).prod,
      D.weylWord_mem_weylSubgroup k l⟩ = t.geckWeylWordProd ht l := by
  induction l with
  | nil =>
    have h1 : (⟨(([].map fun i => D.weylElement (t.simpleIndex ht i) k 1).prod),
        D.weylWord_mem_weylSubgroup k []⟩ : D.weylSubgroup k) = 1 :=
      Subtype.ext (by simp)
    rw [h1, map_one, geckWeylWordProd_nil]
  | cons i l ih =>
    have hcons : (⟨((i :: l).map fun j => D.weylElement (t.simpleIndex ht j) k 1).prod,
        D.weylWord_mem_weylSubgroup k (i :: l)⟩ : D.weylSubgroup k) =
        ⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩ *
          ⟨(l.map fun j => D.weylElement (t.simpleIndex ht j) k 1).prod,
            D.weylWord_mem_weylSubgroup k l⟩ := rfl
    rw [hcons, map_mul, D.weylProjection_weylElement k i, ih, geckWeylWordProd_cons]

/-- Over any field `k`, `weylQuotientEquiv` composed with the quotient map agrees with
`D.weylProjection k`. -/
@[simp]
theorem weylQuotientEquiv_mk_eq_weylProjection (k : Type v) [Field k] (g : D.weylSubgroup k) :
    D.weylQuotientEquiv k (QuotientGroup.mk g) = D.weylProjection k g := by
  obtain ⟨s, l, hg⟩ := (D.mem_weylSubgroup_iff k).mp g.property
  have hfac : g = ⟨D.torusPoints k s, D.torusPoints_mem_weylSubgroup k s⟩ *
      ⟨(l.map fun i => D.weylElement (t.simpleIndex ht i) k 1).prod,
        D.weylWord_mem_weylSubgroup k l⟩ := Subtype.ext hg
  rw [hfac, QuotientGroup.mk_mul, map_mul, map_mul, D.weylQuotientEquiv_mk_torusPoints,
    D.weylQuotientEquiv_mk_weylWord, D.weylProjection_torusPoints, D.weylProjection_weylWord,
    one_mul]

/-- **The kernel of `D.weylProjection k` is the actual torus**, over every field `k` (including
finite fields and bad characteristic, without requiring `[Infinite k]`). -/
@[simp]
theorem ker_weylProjection (k : Type v) [Field k] :
    (D.weylProjection k).ker = ((D.torusPoints k).range).subgroupOf (D.weylSubgroup k) := by
  ext g
  rw [MonoidHom.mem_ker, ← D.weylQuotientEquiv_mk_eq_weylProjection k g,
    MulEquiv.map_eq_one_iff, QuotientGroup.eq_one_iff]

/-- A point of `D.weylSubgroup k` has trivial Weyl projection if and only if it belongs to the
actual character-lattice torus `(D.torusPoints k).range`, over every field `k`. -/
theorem weylProjection_eq_one_iff_mem_range_torusPoints (k : Type v) [Field k]
    (g : D.weylSubgroup k) :
    D.weylProjection k g = 1 ↔ (g : D.points k) ∈ (D.torusPoints k).range := by
  rw [← MonoidHom.mem_ker, D.ker_weylProjection k, Subgroup.mem_subgroupOf]

end TauCeti.DynkinType.ChevalleyDatum
