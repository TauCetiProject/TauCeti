module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Datum
public import TauCeti.RingTheory.Ideal.TensorProduct
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Flat

/-!
# Recovering the integral Chevalley scheme from its generic fibre

The defining ideal of a Chevalley datum's integral group scheme is the contraction of its
extension to the rational coordinate algebra. Thus this integral closed subgroup of `GLₙ` is
the schematic closure of its generic fibre, retaining the scheme structure, not just the
underlying closed set.

The ideal here uses the datum's actual coordinate weights, that is, the characters in its
chosen basis of the lattice spanned by its weights. It is precisely the ideal defining
`ChevalleyDatum.groupScheme`, rather than an ideal from a different torus parametrization.

Flatness is supplied by
`TauCeti.UniversalEnvelopingAlgebra.isTorsionFree_kostantToralCoordinateHopfAlgebra` and
Mathlib's torsion-free flatness criterion over `ℤ`. The contraction theorem is then applied
to this actual quotient. This does not identify the special fibre with the group scheme
generated by the reduced root subgroups and torus, and asserts neither smoothness nor
point generation.

## References

* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
* The Stacks Project, Tag 0AUW, for flatness of torsion-free modules over Dedekind domains.
-/

public section

open scoped TensorProduct

namespace TauCeti.DynkinType.ChevalleyDatum

-- Use the algebra's scalar action in both the tensor algebra and its quotient.
attribute [local instance high] Algebra.toModule

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

local notation "H" => GeneralLinear.coordinateHopfAlgebra ℤ D.dim
local notation "I" => UniversalEnvelopingAlgebra.kostantToralDefiningIdeal
  (LieAlgebra.Basis.rootGenerator (t.lieBasis ht)) (LieAlgebra.Basis.h (t.lieBasis ht))
  D.representation D.lattice
  D.representation_mem_lattice D.isNilpotent_representation_rootGenerator D.basis
  D.coordinateWeight

/-- The integral defining ideal of a Chevalley datum is the contraction of its rational
extension. Equivalently, the integral group scheme is the schematic closure of its generic
fibre inside the integral general linear group. -/
@[simp]
theorem comap_map_definingIdeal_rat :
    ((I).toIdeal.map (Algebra.TensorProduct.includeRight : H →ₐ[ℤ] ℚ ⊗[ℤ] H)).comap
      (Algebra.TensorProduct.includeRight : H →ₐ[ℤ] ℚ ⊗[ℤ] H) = (I).toIdeal := by
  exact (I).toIdeal.comap_map_includeRight_of_flat_quotient (R := ℤ) Int.cast_injective

end TauCeti.DynkinType.ChevalleyDatum
