module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Root.Subgroup
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Subsystem

/-!
# Root-set subgroups of a Chevalley datum

For any set of roots, `subsystemSubgroup` is the subgroup generated by their lattice
operators and `subsystemPoints` is its matrix realization inside the datum's points.
No closure condition on the root set is required. The generation and ring-map API is
shared by the positive and negative subgroups used in Borel and big-cell factorizations.

`subsystemSubgroup` specializes `kostantSubsystemSubgroup`, and `subsystemPoints`
transports its operators into `D.points A` in the weight basis. `Chevalley.Positive.Basic`
and `Chevalley.Opposite` specialize both constructions to positive and negative roots.
-/

public section

open CategoryTheory TensorProduct
open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v w z

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (S : Set (Fin t.numRoots))

attribute [local instance high] Algebra.toModule

/-- The lattice subgroup generated by the root operators indexed by `S`. -/
noncomputable def subsystemSubgroup (A : CommAlgCat.{v} ℤ) :
    Subgroup (LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)) :=
  kostantSubsystemSubgroup (t.chevalleySystem ht) (t.lieBasis ht).h D.representation
    D.lattice (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
    (isNilpotent_apply_ι_chevalleySystem D.representation
      D.isNilpotent_representation_rootGenerator) S A

/-- The root-set subgroup is the corresponding Kostant subsystem subgroup. -/
theorem subsystemSubgroup_def (A : CommAlgCat.{v} ℤ) :
    D.subsystemSubgroup S A =
      kostantSubsystemSubgroup (t.chevalleySystem ht) (t.lieBasis ht).h D.representation
        D.lattice (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
          D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
        (isNilpotent_apply_ι_chevalleySystem D.representation
          D.isNilpotent_representation_rootGenerator) S A :=
  (rfl)

/-- The root-set subgroup is generated by the root-subgroup exponentials indexed by `S`. -/
theorem subsystemSubgroup_eq_closure (A : CommAlgCat.{v} ℤ) :
    D.subsystemSubgroup S A = Subgroup.closure
      {g | ∃ γ ∈ S, ∃ u,
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ A u = g} := by
  simp only [subsystemSubgroup, kostantSubsystemSubgroup_eq_closure,
    kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator]

/-- Containment of a root-set subgroup can be checked on its root parameters. -/
theorem subsystemSubgroup_le_iff {S : Set (Fin t.numRoots)} {A : CommAlgCat.{v} ℤ}
    {P : Subgroup (LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice))} :
    D.subsystemSubgroup S A ≤ P ↔ ∀ γ ∈ S, ∀ u,
      chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ A u ∈ P := by
  simp only [subsystemSubgroup, kostantSubsystemSubgroup_le_iff,
    kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator]

/-- Each root element indexed by `S` belongs to the corresponding lattice subgroup. -/
theorem chevalleyRootSubgroup_mem_subsystemSubgroup {S : Set (Fin t.numRoots)}
    (A : CommAlgCat.{v} ℤ) {γ : Fin t.numRoots} (hγ : γ ∈ S) (u : Multiplicative A) :
    chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator γ A u ∈ D.subsystemSubgroup S A :=
  (D.subsystemSubgroup_le_iff.mp le_rfl) γ hγ u

/-- Every root-set subgroup lies in the elementary subgroup. -/
theorem subsystemSubgroup_le_kostantElementarySubgroup (A : CommAlgCat.{v} ℤ) :
    D.subsystemSubgroup S A ≤ kostantElementarySubgroup (t.lieBasis ht).rootGenerator
      (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator A :=
  D.subsystemSubgroup_le_iff.mpr fun γ _ u =>
    chevalleyRootSubgroup_mem_kostantElementarySubgroup D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A u

/-- Scalar extension preserves the lattice subgroup generated by a fixed root set. -/
theorem map_subsystemSubgroup_le {A B : CommAlgCat.{v} ℤ} (f : A ⟶ B) :
    (D.subsystemSubgroup S A).map
      (GeneralLinear.mapScalarExtensionAutomorphisms (V := D.lattice) f).hom ≤
        D.subsystemSubgroup S B := by
  simp only [D.subsystemSubgroup_def]
  exact map_kostantSubsystemSubgroup_le _ _ _ _ _ _ _ f

/-- Enlarging the root set enlarges its lattice subgroup. -/
@[gcongr]
theorem subsystemSubgroup_mono {S T : Set (Fin t.numRoots)} (hST : S ⊆ T)
    (A : CommAlgCat.{v} ℤ) : D.subsystemSubgroup S A ≤ D.subsystemSubgroup T A :=
  D.subsystemSubgroup_le_iff.mpr fun _ hγ u =>
    D.chevalleyRootSubgroup_mem_subsystemSubgroup A (hST hγ) u

/-- The empty root set generates the trivial lattice subgroup. -/
@[simp]
theorem subsystemSubgroup_empty (A : CommAlgCat.{v} ℤ) :
    D.subsystemSubgroup ∅ A = ⊥ := by
  rw [D.subsystemSubgroup_def, kostantSubsystemSubgroup_empty]

/-- The matrix image of every root-set subgroup consists of datum points. -/
theorem map_subsystemSubgroup_le_points (A : Type v) [CommRing A] :
    (D.subsystemSubgroup S (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) ≤
      D.points A := by
  rw [D.points_eq_kostantToralPointsSubgroup]
  exact (Subgroup.map_mono
    (D.subsystemSubgroup_le_kostantElementarySubgroup S (CommAlgCat.of ℤ A))).trans
    ((map_kostantElementarySubgroup_le_generatedPoints (t.lieBasis ht).rootGenerator
      (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator D.basis A).trans
      (kostantGeneratedPointsSubgroup_le_toralPoints (t.lieBasis ht).rootGenerator
        (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator D.basis D.coordinateWeight A))

/-- The subgroup generated by `S`, realized inside the datum's point group. -/
noncomputable def subsystemPoints (A : Type v) [CommRing A] : Subgroup (D.points A) :=
  ((D.subsystemSubgroup S (CommAlgCat.of ℤ A)).map
    (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv)).subgroupOf
      (D.points A)

/-- The point subgroup is the matrix image of the lattice subgroup, restricted to datum points. -/
theorem subsystemPoints_def (A : Type v) [CommRing A] :
    D.subsystemPoints S A =
      ((D.subsystemSubgroup S (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv)).subgroupOf
          (D.points A) :=
  (rfl)

/-- Membership in the point subgroup is membership in the matrix image of its lattice subgroup. -/
theorem mem_subsystemPoints_iff {S : Set (Fin t.numRoots)} {A : Type v} [CommRing A]
    {g : D.points A} :
    g ∈ D.subsystemPoints S A ↔
      g.val ∈ (D.subsystemSubgroup S (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) :=
  Iff.rfl

/-- Forgetting the ambient datum points recovers the lattice subgroup's matrix image. -/
theorem map_subsystemPoints_subtype (A : Type v) [CommRing A] :
    (D.subsystemPoints S A).map (D.points A).subtype =
      (D.subsystemSubgroup S (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) :=
  Subgroup.map_subgroupOf_eq_of_le (D.map_subsystemSubgroup_le_points S A)

/-- The point subgroup is generated by all root maps indexed by `S`. -/
theorem subsystemPoints_eq_closure (A : Type v) [CommRing A] :
    D.subsystemPoints S A = Subgroup.closure
      {g | ∃ γ ∈ S, ∃ u, D.rootSubgroupPoints γ A u = g} := by
  apply Subgroup.map_injective (D.points A).subtype_injective
  rw [D.map_subsystemPoints_subtype, D.subsystemSubgroup_eq_closure,
    MonoidHom.map_closure, MonoidHom.map_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨_, ⟨γ, hγ, u, rfl⟩, h⟩
    exact ⟨D.rootSubgroupPoints γ A u, ⟨γ, hγ, u, rfl⟩,
      (D.coe_rootSubgroupPoints γ A u).trans h⟩
  · rintro ⟨_, ⟨γ, hγ, u, rfl⟩, h⟩
    exact ⟨_, ⟨γ, hγ, u, rfl⟩, (D.coe_rootSubgroupPoints γ A u).symm.trans h⟩

/-- Containment of the point subgroup can be checked on its root parameters. -/
theorem subsystemPoints_le_iff {S : Set (Fin t.numRoots)} {A : Type v} [CommRing A]
    {P : Subgroup (D.points A)} :
    D.subsystemPoints S A ≤ P ↔ ∀ γ ∈ S, ∀ u, D.rootSubgroupPoints γ A u ∈ P := by
  rw [D.subsystemPoints_eq_closure, Subgroup.closure_le]
  constructor
  · intro h γ hγ u
    exact h ⟨γ, hγ, u, rfl⟩
  · rintro h _ ⟨γ, hγ, u, rfl⟩
    exact h γ hγ u

/-- Each root parameter indexed by `S` belongs to its point subgroup. -/
@[simp]
theorem rootSubgroupPoints_mem_subsystemPoints {S : Set (Fin t.numRoots)}
    (A : Type v) [CommRing A] {γ : Fin t.numRoots}
    (hγ : γ ∈ S) (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.subsystemPoints S A :=
  (D.subsystemPoints_le_iff.mp le_rfl) γ hγ u

/-- Ring maps preserve the point subgroup generated by any fixed root set. -/
theorem map_subsystemPoints_le {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    (f : A →+* B) :
    (D.subsystemPoints S A).map ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      D.subsystemPoints S B := by
  rw [Subgroup.map_le_iff_le_comap, D.subsystemPoints_le_iff]
  intro γ hγ u
  simpa only [Subgroup.mem_comap, D.map_rootSubgroupPoints] using
    D.rootSubgroupPoints_mem_subsystemPoints B hγ (Multiplicative.ofAdd (f u.toAdd))

/-- Enlarging the root set enlarges its point subgroup. -/
@[gcongr]
theorem subsystemPoints_mono {S T : Set (Fin t.numRoots)} (hST : S ⊆ T)
    (A : Type v) [CommRing A] : D.subsystemPoints S A ≤ D.subsystemPoints T A :=
  D.subsystemPoints_le_iff.mpr fun _ hγ u =>
    D.rootSubgroupPoints_mem_subsystemPoints A (hST hγ) u

/-- The empty root set generates the trivial point subgroup. -/
@[simp]
theorem subsystemPoints_empty (A : Type v) [CommRing A] :
    D.subsystemPoints ∅ A = ⊥ := by
  simp only [D.subsystemPoints_def, D.subsystemSubgroup_empty, Subgroup.map_bot,
    Subgroup.bot_subgroupOf]

/-- Writing lattice operators in the weight basis identifies the lattice and point subgroups. -/
noncomputable def subsystemSubgroupMulEquivPoints (A : Type v) [CommRing A] :
    D.subsystemSubgroup S (CommAlgCat.of ℤ A) ≃* D.subsystemPoints S A :=
  ((Units.mapEquiv (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv).subgroupMap
    _).trans (Subgroup.subgroupOfEquivOfLe (D.map_subsystemSubgroup_le_points S A)).symm

/-- The lattice-to-points equivalence is the weight-basis matrix map. -/
@[simp]
theorem coe_subsystemSubgroupMulEquivPoints_apply (A : Type v) [CommRing A]
    (g : D.subsystemSubgroup S (CommAlgCat.of ℤ A)) :
    ((D.subsystemSubgroupMulEquivPoints S A g : D.points A) :
      Matrix.GeneralLinearGroup (Fin D.dim) A) =
      Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv g.val :=
  (rfl)

/-- Change of value ring, restricted to a fixed root-set point subgroup. -/
noncomputable def mapSubsystemPoints {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    (f : A →+* B) : D.subsystemPoints S A →* D.subsystemPoints S B :=
  (((D.pointsPresentation A).map (D.pointsPresentation B) f).domRestrict
    (D.subsystemPoints S A)).codRestrict (D.subsystemPoints S B) fun g =>
      D.map_subsystemPoints_le S f (Subgroup.mem_map_of_mem _ g.property)

/-- The restricted ring map agrees with the ambient point map. -/
@[simp]
theorem coe_mapSubsystemPoints_apply {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    (f : A →+* B) (g : D.subsystemPoints S A) :
    (D.mapSubsystemPoints S f g : D.points B) =
      (D.pointsPresentation A).map (D.pointsPresentation B) f g.val :=
  (rfl)

/-- Identity ring maps act identically on root-set points. -/
@[simp]
theorem mapSubsystemPoints_id (A : Type v) [CommRing A] :
    D.mapSubsystemPoints S (RingHom.id A) = MonoidHom.id _ := by
  ext g : 1
  apply Subtype.ext
  simp only [D.coe_mapSubsystemPoints_apply, GeneralLinear.IntegralPointsPresentation.map_id,
    MonoidHom.id_apply]

/-- Restricted point maps respect composition of ring homomorphisms. -/
theorem mapSubsystemPoints_comp {A : Type v} {B : Type w} {C : Type z}
    [CommRing A] [CommRing B] [CommRing C] (f : A →+* B) (g : B →+* C) :
    D.mapSubsystemPoints S (g.comp f) =
      (D.mapSubsystemPoints S g).comp (D.mapSubsystemPoints S f) := by
  ext x : 1
  apply Subtype.ext
  simp only [D.coe_mapSubsystemPoints_apply, MonoidHom.comp_apply,
    GeneralLinear.IntegralPointsPresentation.map_comp (D.pointsPresentation A)
      (D.pointsPresentation B) (D.pointsPresentation C)]

end TauCeti.DynkinType.ChevalleyDatum
