module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Datum
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Subgroup
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Subsystem

/-!
# Root-subset subgroups of a Chevalley datum

For a Chevalley datum `D` and a set `S` of roots, `D.subsystemSubgroup S A` is generated by
the root subgroups indexed by `S` on the base-changed admissible lattice. No closure condition
on `S` is required. This specializes the generic Kostant subsystem construction and provides
the common generation, containment, and scalar-extension API for the positive and negative
subgroups. Its matrix image lies in the points of `D` over every commutative ring.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3.
-/

public section

open CategoryTheory TensorProduct
open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

-- Use the module structure carried by the integer algebra structure in scalar extensions.
attribute [local instance high] Algebra.toModule

/-- The subgroup generated by the root subgroups indexed by `S` on the base-changed admissible
lattice. No closure condition on the root subset is required. -/
noncomputable def subsystemSubgroup (S : Set (Fin t.numRoots)) (A : CommAlgCat.{v} ℤ) :
    Subgroup (LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice)) :=
  kostantSubsystemSubgroup (t.chevalleySystem ht) (t.lieBasis ht).h D.representation
    D.lattice (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
    (isNilpotent_apply_ι_chevalleySystem D.representation
      D.isNilpotent_representation_rootGenerator) S A

/-- The root-subset subgroup is the Kostant subsystem group for the datum's named root vectors.
This identifies its carrier when applying the generic Kostant subsystem theory. -/
theorem subsystemSubgroup_def (S : Set (Fin t.numRoots)) (A : CommAlgCat.{v} ℤ) :
    D.subsystemSubgroup S A =
      kostantSubsystemSubgroup (t.chevalleySystem ht) (t.lieBasis ht).h D.representation
        D.lattice (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
          D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
        (isNilpotent_apply_ι_chevalleySystem D.representation
          D.isNilpotent_representation_rootGenerator) S A := (rfl)

/-- The root-subset subgroup is generated by the existing all-root exponential maps. -/
theorem subsystemSubgroup_eq_closure (S : Set (Fin t.numRoots)) (A : CommAlgCat.{v} ℤ) :
    D.subsystemSubgroup S A = Subgroup.closure
      {g | ∃ γ ∈ S,
        ∃ u, chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ A u = g} := by
  simp only [subsystemSubgroup, kostantSubsystemSubgroup_eq_closure,
    kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator]

/-- A subgroup contains the root-subset subgroup exactly when it contains each generating
root subgroup. -/
theorem subsystemSubgroup_le_iff {S : Set (Fin t.numRoots)} {A : CommAlgCat.{v} ℤ}
    {P : Subgroup (LinearMap.GeneralLinearGroup A (A ⊗[ℤ] D.lattice))} :
    D.subsystemSubgroup S A ≤ P ↔
      ∀ γ ∈ S, ∀ u,
        chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
          D.isNilpotent_representation_rootGenerator γ A u ∈ P := by
  simp only [subsystemSubgroup, kostantSubsystemSubgroup_le_iff,
    kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator]

/-- Each root element indexed by `S` belongs to the root-subset subgroup. -/
theorem chevalleyRootSubgroup_mem_subsystemSubgroup (S : Set (Fin t.numRoots))
    (A : CommAlgCat.{v} ℤ) {γ : Fin t.numRoots} (hγ : γ ∈ S) (u : Multiplicative A) :
    chevalleyRootSubgroup D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator γ A u ∈ D.subsystemSubgroup S A :=
  (D.subsystemSubgroup_le_iff.mp le_rfl) γ hγ u

/-- Every root-subset subgroup lies in the elementary subgroup generated by the positive and
negative simple root subgroups. -/
theorem subsystemSubgroup_le_kostantElementarySubgroup (S : Set (Fin t.numRoots))
    (A : CommAlgCat.{v} ℤ) :
    D.subsystemSubgroup S A ≤ kostantElementarySubgroup (t.lieBasis ht).rootGenerator
      (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator A := by
  exact D.subsystemSubgroup_le_iff.mpr fun γ _ u =>
    chevalleyRootSubgroup_mem_kostantElementarySubgroup D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator γ A u

/-- The matrix image of every root-subset subgroup consists of points of the Chevalley datum. -/
theorem map_subsystemSubgroup_le_points (S : Set (Fin t.numRoots))
    (A : Type v) [CommRing A] :
    (D.subsystemSubgroup S (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMulEquiv) ≤
      D.points A := by
  rw [D.points_eq_kostantToralPointsSubgroup]
  exact (Subgroup.map_mono
    (D.subsystemSubgroup_le_kostantElementarySubgroup S (CommAlgCat.of ℤ A))).trans
    ((map_kostantElementarySubgroup_le_generatedPoints (t.lieBasis ht).rootGenerator
      (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator D.basis A).trans
      (kostantGeneratedPointsSubgroup_le_toralPoints (t.lieBasis ht).rootGenerator
        (t.lieBasis ht).h D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator D.basis D.coordinateWeight A))

/-- Scalar extension carries a root-subset subgroup into the subgroup for the same root subset
over the target ring. No surjectivity of the ring map is required. -/
theorem map_subsystemSubgroup_le (S : Set (Fin t.numRoots))
    {A B : CommAlgCat.{v} ℤ} (f : A ⟶ B) :
    (D.subsystemSubgroup S A).map
        (GeneralLinear.mapScalarExtensionAutomorphisms (V := D.lattice) f).hom ≤
      D.subsystemSubgroup S B := by
  unfold subsystemSubgroup
  exact map_kostantSubsystemSubgroup_le _ _ _ _ _ _ _ f

end TauCeti.DynkinType.ChevalleyDatum
