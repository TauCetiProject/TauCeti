module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.RootSubgroup
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Weyl.Action
import TauCeti.LinearAlgebra.RootSystem.Weyl.Group
public import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure

/-!
# The Weyl-group quotient map for a Chevalley datum

For a Chevalley datum `D`, the subgroup `D.weylSubgroup k` is generated by its actual torus
`T_D(k)` and the pinned simple Weyl representatives. Its conjugation action on the represented
weight torus after extension to an algebraic closure determines a unique element of the root
datum's Weyl group. This gives a surjective homomorphism, sending the torus to the identity and
each simple Weyl representative to its simple reflection.

The actual torus is used in the generating set, even when its full-weight parametrization has
a smaller image. The latter is used only to detect the Weyl action. Identifying the kernel with
the torus requires further structure and is not asserted here.

The torus action and its character equation are reused from
`DynkinType.geckWeylTorusAction`; that construction depends only on the pinned root datum.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3.
* R. W. Carter, *Simple Groups of Lie Type*, §7.2.
-/

public section

open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

-- Match the coefficient structure used by `D.points`, including on an algebraic closure.
attribute [local instance high] Ring.toIntAlgebra
attribute [local instance high] Algebra.toModule
attribute [local instance 100] LieRing.ofAssociativeRing

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-- The subgroup generated by the actual weight-lattice torus and the pinned simple Weyl
representatives. No equality with the full torus normalizer is implicit in this definition. -/
noncomputable def weylSubgroup (A : Type v) [CommRing A] : Subgroup (D.points A) :=
  Subgroup.closure (Set.range (D.torusPoints A) ∪
    Set.range (fun i => D.weylElement (t.simpleIndex ht i) A 1))

/-- The defining generating set of the Weyl subgroup. -/
theorem weylSubgroup_def (A : Type v) [CommRing A] :
    D.weylSubgroup A = Subgroup.closure (Set.range (D.torusPoints A) ∪
      Set.range (fun i => D.weylElement (t.simpleIndex ht i) A 1)) :=
  (rfl)

/-- Every point of the actual torus belongs to the Weyl subgroup. -/
theorem torusPoints_mem_weylSubgroup (A : Type v) [CommRing A] (s : Fin t.rank → Aˣ) :
    D.torusPoints A s ∈ D.weylSubgroup A :=
  Subgroup.subset_closure (Or.inl ⟨s, rfl⟩)

/-- Each pinned simple Weyl representative belongs to the Weyl subgroup. -/
theorem weylElement_mem_weylSubgroup (A : Type v) [CommRing A] (i : Fin t.rank) :
    D.weylElement (t.simpleIndex ht i) A 1 ∈ D.weylSubgroup A :=
  Subgroup.subset_closure (Or.inr ⟨i, rfl⟩)

private theorem isSl2Triple_representation (i : Fin t.rank) :
    IsSl2Triple
      (D.representation (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).h i)))
      (D.representation
        (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator (.inl i))))
      (D.representation
        (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator (.inr i)))) := by
  simpa only [LieHom.comp_apply, AlgHom.toLieHom_apply,
    LieAlgebra.Basis.rootGenerator_inl, LieAlgebra.Basis.rootGenerator_inr] using
    ((t.lieBasis ht).sl2 i).map
      (D.representation.toLieHom.comp (_root_.UniversalEnvelopingAlgebra.ι ℚ))
      (by
        intro hzero
        apply ((t.lieBasis ht).sl2 i).h_ne_zero
        apply D.injective_representation_ι
        simpa only [LieHom.comp_apply, AlgHom.toLieHom_apply, map_zero] using hzero)

private theorem weylElement_conj_weightTorus (A : Type v) [CommRing A]
    (i : Fin t.rank) (s : Fin t.rank → Aˣ) :
    (D.weylElement (t.simpleIndex ht i) A 1 : Matrix.GeneralLinearGroup (Fin D.dim) A) *
        kostantTorusMatrix D.lattice D.basis D.weight s *
        (D.weylElement (t.simpleIndex ht i) A 1 :
          Matrix.GeneralLinearGroup (Fin D.dim) A)⁻¹ =
      kostantTorusMatrix D.lattice D.basis D.weight
        (t.geckWeylTorusAction ht A
          (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht)
            (t.simpleIndex ht i)) s) := by
  classical
  have h := kostantWeylGL_conj_kostantTorusPoints
    (i := Sum.inl i) (j := Sum.inr i) (c := i)
    (α := (t.simplyConnectedRootDatum ht).root (t.simpleIndex ht i))
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h D.representation D.lattice
    D.representation_mem_lattice (D.isNilpotent_representation_rootGenerator (.inl i))
    (D.isNilpotent_representation_rootGenerator (.inr i)) (D.isSl2Triple_representation i)
    (fun q => by
      rw [← t.rootGeneratorWeight_inl_eq_root_simpleIndex ht i]
      exact t.lie_lieBasis_h_rootGenerator ht (.inl i) q)
    (fun q => by
      have hneg := t.lie_lieBasis_h_rootGenerator ht (.inr i) q
      rw [t.rootGeneratorWeight_inr_eq_neg_root_simpleIndex ht i,
        Pi.neg_apply, Int.cast_neg, neg_smul] at hneg
      exact hneg)
    D.basis D.weight D.isCartanWeightVector_basis s
  have hmatrix := congrArg
    (Units.map (LinearMap.toMatrixAlgEquiv (D.basis.baseChange A)).toMonoidHom) h
  have hact : t.geckWeylTorusAction ht A
      (RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i)) s =
      weylReflectTorusPoint ((t.simplyConnectedRootDatum ht).root (t.simpleIndex ht i)) i s :=
    by simpa only [t.geckSimpleReflectionTorusPoint_def ht,
      ← MulEquiv.toMonoidHom_eq_coe, MulEquiv.coe_toMonoidHom] using
      DFunLike.congr_fun (t.geckWeylTorusAction_ofIdx ht i A) s
  rw [coe_weylElement_simpleIndex_one, hact]
  simpa only [map_mul, map_inv, MulEquiv.toMonoidHom_eq_coe,
    basisMatrix_kostantTorusPoints, t.geckWeylTorusAction_ofIdx ht,
    t.geckSimpleReflectionTorusPoint_def ht] using hmatrix

private def RealizesWeyl (k : Type v) [CommRing k] (g : Matrix.GeneralLinearGroup (Fin D.dim) k)
    (w : (t.simplyConnectedRootDatum ht).weylGroup) : Prop :=
  ∀ s : Fin t.rank → kˣ,
    (g : Matrix.GeneralLinearGroup (Fin D.dim) k) *
        kostantTorusMatrix D.lattice D.basis D.weight s *
        (g : Matrix.GeneralLinearGroup (Fin D.dim) k)⁻¹ =
      kostantTorusMatrix D.lattice D.basis D.weight (t.geckWeylTorusAction ht k w s)

private theorem realizesWeyl_one (k : Type v) [CommRing k] :
    D.RealizesWeyl k 1 1 := by
  intro s
  simp

private theorem RealizesWeyl.mul {k : Type v} [CommRing k]
    {g g' : Matrix.GeneralLinearGroup (Fin D.dim) k}
    {w w' : (t.simplyConnectedRootDatum ht).weylGroup}
    (h : D.RealizesWeyl k g w) (h' : D.RealizesWeyl k g' w') :
    D.RealizesWeyl k (g * g') (w * w') := by
  intro s
  simp only [mul_inv_rev, map_mul, MulAut.mul_apply]
  calc
    _ = (g : Matrix.GeneralLinearGroup (Fin D.dim) k) *
        ((g' : Matrix.GeneralLinearGroup (Fin D.dim) k) *
          kostantTorusMatrix D.lattice D.basis D.weight s *
          (g' : Matrix.GeneralLinearGroup (Fin D.dim) k)⁻¹) *
        (g : Matrix.GeneralLinearGroup (Fin D.dim) k)⁻¹ := by group
    _ = _ := by rw [h' s, h]

private theorem RealizesWeyl.inv {k : Type v} [CommRing k]
    {g : Matrix.GeneralLinearGroup (Fin D.dim) k}
    {w : (t.simplyConnectedRootDatum ht).weylGroup} (h : D.RealizesWeyl k g w) :
    D.RealizesWeyl k g⁻¹ w⁻¹ := by
  intro s
  have heq := h (t.geckWeylTorusAction ht k w⁻¹ s)
  rw [← MulAut.mul_apply, ← map_mul, mul_inv_cancel, map_one, MulAut.one_apply] at heq
  simp only [inv_inv]
  rw [← heq]
  group

private theorem realizesWeyl_torusPoints (k : Type v) [CommRing k]
    (r : Fin t.rank → kˣ) :
    D.RealizesWeyl k (D.torusPoints k r : Matrix.GeneralLinearGroup (Fin D.dim) k) 1 := by
  intro s
  simp only [map_one, MulAut.one_apply, coe_torusPoints, kostantTorusMatrix_apply]
  have hc : Commute (diagGL fun i => torusCharacter r (D.coordinateWeight i))
      (diagGL fun i => torusCharacter s (D.weight i)) :=
    (Commute.all _ _).map diagGL
  exact hc.mul_inv_cancel

private theorem realizesWeyl_unique {k : Type v} [Field k] [Infinite k]
    {g : Matrix.GeneralLinearGroup (Fin D.dim) k}
    {w w' : (t.simplyConnectedRootDatum ht).weylGroup}
    (h : D.RealizesWeyl k g w) (h' : D.RealizesWeyl k g w') : w = w' := by
  have hwt (j : Fin D.dim) : w⁻¹ • D.weight j = w'⁻¹ • D.weight j := by
    apply weightChar_injective (K := k)
    apply MonoidHom.ext
    intro s
    have hs := (h s).symm.trans (h' s)
    simp only [kostantTorusMatrix_apply] at hs
    have heq := congrFun (diagGL_injective hs) j
    simpa only [weightChar_apply, t.torusCharacter_geckWeylTorusAction ht] using heq
  let f := (w⁻¹ : (t.simplyConnectedRootDatum ht).weylGroup).val.weightEquiv.toLinearMap
  let f' := (w'⁻¹ : (t.simplyConnectedRootDatum ht).weylGroup).val.weightEquiv.toLinearMap
  have heq : ∀ x ∈ D.weightLattice, f x = f' x := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      exact hwt j
    | zero => simp
    | add x y _ _ hx hy => simp [map_add, hx, hy]
    | smul a x _ hx =>
      simpa only [map_smul] using congrArg (fun y => a • y) hx
  apply inv_injective
  apply Subtype.ext
  apply RootPairing.Equiv.indexHom_injective_of_corootSpan_eq_top
    (t.simplyConnectedRootDatum ht) (t.span_coroot_simplyConnectedRootDatum ht)
  apply Equiv.ext
  intro γ
  apply (t.simplyConnectedRootDatum ht).root.injective
  simpa only [f, f', LinearEquiv.coe_coe, RootPairing.Equiv.weightEquiv_apply,
    RootPairing.Hom.root_weightMap_apply, RootPairing.Equiv.indexHom_apply] using
    heq _ (D.root_mem_weightLattice γ)

private theorem exists_realizesWeyl_algebraicClosure (k : Type v) [Field k]
    {g : D.points k} (hg : g ∈ D.weylSubgroup k) :
    ∃ w, D.RealizesWeyl (AlgebraicClosure k)
      (Matrix.GeneralLinearGroup.map (algebraMap k (AlgebraicClosure k))
        (g : Matrix.GeneralLinearGroup (Fin D.dim) k)) w := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with ⟨s, rfl⟩ | ⟨i, rfl⟩
    · refine ⟨1, ?_⟩
      simpa only [coe_torusPoints, map_kostantTorusMatrix] using
        D.realizesWeyl_torusPoints (AlgebraicClosure k)
          (fun j => Units.map (algebraMap k (AlgebraicClosure k) : k →* AlgebraicClosure k) (s j))
    · refine ⟨RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht)
        (t.simpleIndex ht i), ?_⟩
      simpa only [RealizesWeyl, map_weylElement, map_one] using
        D.weylElement_conj_weightTorus (AlgebraicClosure k) i
  | one =>
    exact ⟨1, by simpa only [Subgroup.coe_one, map_one] using
      D.realizesWeyl_one (AlgebraicClosure k)⟩
  | mul g g' _ _ hg hg' =>
    obtain ⟨w, hw⟩ := hg
    obtain ⟨w', hw'⟩ := hg'
    exact ⟨w * w', by simpa only [Subgroup.coe_mul, map_mul] using hw.mul D hw'⟩
  | inv g _ hg =>
    obtain ⟨w, hw⟩ := hg
    exact ⟨w⁻¹, by simpa only [Subgroup.coe_inv, map_inv] using hw.inv D⟩

/-- The Weyl-group element induced by a point of the subgroup generated by the actual torus
and the pinned simple Weyl representatives. Its action on the represented weight torus after
extension to the algebraic closure characterizes it uniquely. -/
noncomputable def weylProjection (k : Type v) [Field k] :
    D.weylSubgroup k →* (t.simplyConnectedRootDatum ht).weylGroup where
  toFun g := (D.exists_realizesWeyl_algebraicClosure k g.property).choose
  map_one' := D.realizesWeyl_unique
    (D.exists_realizesWeyl_algebraicClosure k (1 : D.weylSubgroup k).property).choose_spec
    (by simpa only [Subgroup.coe_one, map_one] using D.realizesWeyl_one (AlgebraicClosure k))
  map_mul' g g' := D.realizesWeyl_unique
    (D.exists_realizesWeyl_algebraicClosure k (g * g').property).choose_spec
    (by
      simpa only [Subgroup.coe_mul, map_mul] using
        (D.exists_realizesWeyl_algebraicClosure k g.property).choose_spec.mul D
          (D.exists_realizesWeyl_algebraicClosure k g'.property).choose_spec)

/-- A Weyl-group element is the projection of `g` exactly when it gives its conjugation action
on the weight torus after extension to the infinite algebraic closure. This detects
the Weyl element even over a finite field, where torus characters need not separate weights. -/
theorem weylProjection_eq_iff (k : Type v) [Field k] (g : D.weylSubgroup k)
    (w : (t.simplyConnectedRootDatum ht).weylGroup) :
    D.weylProjection k g = w ↔
      ∀ s : Fin t.rank → (AlgebraicClosure k)ˣ,
        Matrix.GeneralLinearGroup.map (algebraMap k (AlgebraicClosure k))
            ((g : D.points k) : Matrix.GeneralLinearGroup (Fin D.dim) k) *
          diagGL (fun j => torusCharacter s (D.weight j)) *
          (Matrix.GeneralLinearGroup.map (algebraMap k (AlgebraicClosure k))
            ((g : D.points k) : Matrix.GeneralLinearGroup (Fin D.dim) k))⁻¹ =
        diagGL (fun j => torusCharacter
          (t.geckWeylTorusAction ht (AlgebraicClosure k) w s) (D.weight j)) := by
  constructor
  · intro h
    subst w
    simpa only [weylProjection, MonoidHom.coe_mk, OneHom.coe_mk, RealizesWeyl,
      kostantTorusMatrix_apply] using
      (D.exists_realizesWeyl_algebraicClosure k g.property).choose_spec
  · intro h
    apply D.realizesWeyl_unique (D.exists_realizesWeyl_algebraicClosure k g.property).choose_spec
    simpa only [RealizesWeyl, kostantTorusMatrix_apply] using h

/-- The Weyl projection gives the conjugation action on the represented weight torus over the
original field. The actual torus, rather than its full-weight image, generates `weylSubgroup`. -/
theorem weylProjection_conj_weightTorus (k : Type v) [Field k]
    (g : D.weylSubgroup k) (s : Fin t.rank → kˣ) :
    ((g : D.points k) : Matrix.GeneralLinearGroup (Fin D.dim) k) *
        diagGL (fun j => torusCharacter s (D.weight j)) *
        ((g : D.points k) : Matrix.GeneralLinearGroup (Fin D.dim) k)⁻¹ =
      diagGL (fun j => torusCharacter
        (t.geckWeylTorusAction ht k (D.weylProjection k g) s) (D.weight j)) := by
  apply Matrix.GeneralLinearGroup.map_injective (algebraMap k (AlgebraicClosure k)).injective
  simpa only [map_mul, map_inv, map_diagGL, map_torusCharacter,
    t.map_geckWeylTorusAction ht] using
    (D.weylProjection_eq_iff k g _).mp rfl
      (fun j => Units.map (algebraMap k (AlgebraicClosure k) : k →* AlgebraicClosure k) (s j))

/-- Actual torus points have trivial Weyl projection. -/
@[simp]
theorem weylProjection_torusPoints (k : Type v) [Field k]
    (s : Fin t.rank → kˣ) :
    D.weylProjection k ⟨D.torusPoints k s, D.torusPoints_mem_weylSubgroup k s⟩ = 1 :=
  D.realizesWeyl_unique
    (D.exists_realizesWeyl_algebraicClosure k (D.torusPoints_mem_weylSubgroup k s)).choose_spec
    (by simpa only [coe_torusPoints, map_kostantTorusMatrix] using
      (D.realizesWeyl_torusPoints (AlgebraicClosure k)
        (fun j => Units.map (algebraMap k (AlgebraicClosure k) : k →* AlgebraicClosure k) (s j))))

/-- Each pinned simple Weyl representative projects to the corresponding simple reflection. -/
-- Concrete rank and root-count equations can normalize the dependent indices before matching.
@[simp↓]
theorem weylProjection_weylElement (k : Type v) [Field k] (i : Fin t.rank) :
    D.weylProjection k
        ⟨D.weylElement (t.simpleIndex ht i) k 1, D.weylElement_mem_weylSubgroup k i⟩ =
      RootPairing.weylGroup.ofIdx (t.simplyConnectedRootDatum ht) (t.simpleIndex ht i) :=
  D.realizesWeyl_unique
    (D.exists_realizesWeyl_algebraicClosure k (D.weylElement_mem_weylSubgroup k i)).choose_spec
    (by simpa only [RealizesWeyl, map_weylElement, map_one] using
      D.weylElement_conj_weightTorus (AlgebraicClosure k) i)

/-- The Weyl projection is surjective: the pinned representatives lift every word in the
simple reflections. -/
theorem weylProjection_surjective (k : Type v) [Field k] :
    Function.Surjective (D.weylProjection k) := by
  have hword (l : List (Fin t.rank)) :
      ∃ g : D.weylSubgroup k, D.weylProjection k g = t.geckWeylWordProd ht l := by
    induction l with
    | nil => exact ⟨1, by simp⟩
    | cons i l ih =>
      obtain ⟨g, hg⟩ := ih
      exact ⟨⟨D.weylElement (t.simpleIndex ht i) k 1,
        D.weylElement_mem_weylSubgroup k i⟩ * g, by simp [hg]⟩
  intro w
  obtain ⟨l, rfl⟩ := t.geckWeylWordProd_surjective ht w
  exact hword l

/-- The kernel consists of those points that commute with all represented full-weight torus
points. Identifying these points with the actual torus is a separate assertion. -/
theorem weylProjection_eq_one_iff (k : Type v) [Field k] [Infinite k]
    (g : D.weylSubgroup k) :
    D.weylProjection k g = 1 ↔
      ∀ s : Fin t.rank → kˣ,
        Commute ((g : D.points k) : Matrix.GeneralLinearGroup (Fin D.dim) k)
          (diagGL (fun j => torusCharacter s (D.weight j))) := by
  constructor
  · intro hg s
    have h := D.weylProjection_conj_weightTorus k g s
    rw [hg, map_one, MulAut.one_apply, mul_inv_eq_iff_eq_mul] at h
    exact h
  · intro hg
    have hw : D.RealizesWeyl k
        ((g : D.points k) : Matrix.GeneralLinearGroup (Fin D.dim) k)
        (D.weylProjection k g) := by
      intro s
      simpa only [kostantTorusMatrix_apply] using D.weylProjection_conj_weightTorus k g s
    apply D.realizesWeyl_unique hw
    intro s
    simpa only [map_one, MulAut.one_apply, kostantTorusMatrix_apply] using (hg s).mul_inv_cancel

end TauCeti.DynkinType.ChevalleyDatum
