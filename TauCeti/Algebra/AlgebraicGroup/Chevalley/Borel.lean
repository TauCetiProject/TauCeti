module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Positive
public import TauCeti.Algebra.Group.Subgroup.Pointwise

/-!
# The positive-root and torus subgroup of a Chevalley datum

Inside the points of a Chevalley datum, let `U` be the subgroup generated by all positive
root subgroups and `T` the image of the actual character-lattice torus. The pinning equation
shows that `T` normalizes `U`. Thus their join `B` consists exactly of products `u * t`, and
`U` is normal in `B`. These constructions commute with scalar extension in the sense that
ring maps carry each subgroup into the corresponding subgroup over the target ring.

The torus here is parametrized in the chosen basis of the datum's weight lattice, rather than
by restriction from the full weight lattice. The latter can miss torus points, already for
adjoint type A₁ over ℚ. All results hold over every commutative ring. We call the generated
subgroup `borelSubgroup`; we do not identify it with all points of a Borel subgroup scheme
or assert maximal solvability here. No ordered-product normal form for `U` is assumed.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 17 and 18.
* R. W. Carter, *Simple Groups of Lie Type*, §5.3.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v w

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

/-- The actual character-lattice torus normalizes the subgroup generated by all positive roots.
-/
theorem range_torusPoints_le_normalizer_positivePoints :
    (D.torusPoints A).range ≤ Subgroup.normalizer (D.positivePoints A : Set _) := by
  rw [D.positivePoints_eq_closure]
  apply Subgroup.le_normalizer_closure_iff.mpr
  rintro _ ⟨s, rfl⟩ _ ⟨γ, hγ, u, rfl⟩
  rw [← ofAdd_toAdd u, D.torusPoints_conj_rootSubgroup]
  exact Subgroup.subset_closure ⟨γ, hγ, _, rfl⟩

/-- The subgroup of datum points generated by all positive roots and the actual torus. -/
noncomputable def borelSubgroup : Subgroup (D.points A) :=
  D.positivePoints A ⊔ (D.torusPoints A).range

/-- The Borel-type subgroup is the join of the positive subgroup and the actual torus image. -/
theorem borelSubgroup_def :
    D.borelSubgroup A = D.positivePoints A ⊔ (D.torusPoints A).range :=
  (rfl)

/-- A subgroup contains the Borel-type subgroup exactly when it contains every positive root
parameter and every point of the actual torus. -/
theorem borelSubgroup_le_iff {P : Subgroup (D.points A)} :
    D.borelSubgroup A ≤ P ↔
      (∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ u,
        D.rootSubgroup γ A u ∈ P) ∧ (∀ s, D.torusPoints A s ∈ P) := by
  rw [D.borelSubgroup_def, sup_le_iff, D.positivePoints_le_iff]
  simp only [IsConcreteLE.le_iff, MonoidHom.mem_range, forall_exists_index,
    forall_apply_eq_imp_iff]

/-- The positive subgroup is contained in the Borel-type subgroup. -/
theorem positivePoints_le_borelSubgroup : D.positivePoints A ≤ D.borelSubgroup A :=
  le_sup_left

/-- The actual torus image is contained in the Borel-type subgroup. -/
theorem range_torusPoints_le_borelSubgroup : (D.torusPoints A).range ≤ D.borelSubgroup A :=
  le_sup_right

/-- The Borel-type subgroup normalizes its positive subgroup. -/
theorem borelSubgroup_le_normalizer_positivePoints :
    D.borelSubgroup A ≤ Subgroup.normalizer (D.positivePoints A : Set _) :=
  sup_le (D.positivePoints A).le_normalizer
    (D.range_torusPoints_le_normalizer_positivePoints A)

/-- The positive subgroup is normal inside the Borel-type subgroup. -/
instance normal_positivePoints_subgroupOf_borelSubgroup :
    ((D.positivePoints A).subgroupOf (D.borelSubgroup A)).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer
    (D.positivePoints_le_borelSubgroup A)).mpr
      (D.borelSubgroup_le_normalizer_positivePoints A)

/-- Membership in the Borel-type subgroup is precisely a product of a positive element followed
by an actual torus point. This is existence of factors, not a root-coordinate normal form. -/
theorem mem_borelSubgroup_iff {g : D.points A} :
    g ∈ D.borelSubgroup A ↔
      ∃ u ∈ D.positivePoints A, ∃ s : Fin t.rank → Aˣ, u * D.torusPoints A s = g := by
  rw [D.borelSubgroup_def, Subgroup.mem_sup_of_right_le_normalizer_left
    (D.range_torusPoints_le_normalizer_positivePoints A)]
  simp only [MonoidHom.mem_range, exists_exists_eq_and]

/-- Scalar extension carries the Borel-type subgroup into the corresponding subgroup over the
target ring, without a surjectivity assumption on the ring map. -/
theorem map_borelSubgroup_le {B : Type w} [CommRing B] (f : A →+* B) :
    (D.borelSubgroup A).map ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      D.borelSubgroup B := by
  rw [D.borelSubgroup_def, Subgroup.map_sup]
  apply sup_le
  · exact (D.map_positivePoints_le f).trans (D.positivePoints_le_borelSubgroup B)
  · rw [Subgroup.map_le_iff_le_comap]
    rintro _ ⟨s, rfl⟩
    simpa only [Subgroup.mem_comap, D.map_torusPoints] using
      D.range_torusPoints_le_borelSubgroup B
        ⟨fun i => Units.map f.toMonoidHom (s i), rfl⟩

end TauCeti.DynkinType.ChevalleyDatum
