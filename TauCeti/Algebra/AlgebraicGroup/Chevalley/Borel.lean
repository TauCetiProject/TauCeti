/-!
# Borel and opposite Borel subgroups of a Chevalley datum

Inside the points of a Chevalley datum `D`, let `U` (`positivePoints`) and `U⁻` (`negativePoints`)
be the subgroups generated by all positive and all negative root subgroups, and `T` the image of
the actual character-lattice torus `D.torusPoints A`. The pinning equation shows that `T`
normalizes both `U` and `U⁻`. Thus their joins `B = U ⊔ T` (`borelSubgroup`) and `B⁻ = U⁻ ⊔ T`
(`oppositeBorelSubgroup`) consist of unique products `u * t`, with `U` normal in `B` and `U⁻`
normal in `B⁻`. Over every commutative ring, `U ∩ B⁻ = 1`, `U⁻ ∩ B = 1`, and `B ∩ B⁻ = T`. Ring
maps carry each subgroup into the corresponding subgroup over the target ring.

The torus here is parametrized in the chosen basis of the datum's weight lattice, rather than
by restriction from the full weight lattice, which can miss torus points already for adjoint type
`A₁` over `ℚ`. We call the generated subgroups `borelSubgroup` and `oppositeBorelSubgroup`; we do
not identify them with all points of Borel subgroup schemes or assert maximal solvability here, and
no ordered-product normal form on `U` or `U⁻` is assumed in this file.

Combining the opposite-intersection theorems with integral root-subgroup injectivity
(`ChevalleyDatum.rootSubgroupPoints_eq_one_iff`) shows that a negative root element lies in `B`
(or a positive root element lies in `B⁻`) if and only if its additive parameter is `0` (the
identity `1` of `Multiplicative A`). Over every nontrivial commutative ring, the simple-root element
with additive parameter `1` witnesses that each pinned simple Weyl representative conjugates some
element of `B` outside `B`, supplying the noncontainment required by the last Tits-system axiom
without assuming a Bruhat decomposition.

Positive root points are block upper unitriangular in the datum's original weight basis ordered by
decreasing weight degree, and negative root points are block upper unitriangular for the negated
weight degree; since the actual torus is diagonal, `borelSubgroup` and `oppositeBorelSubgroup` are
block upper triangular in the respective weight-block orders.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 17 and 18, Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §5.3 and §8.1.
-/

public section

open Multiplicative TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v w

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

/-- The subgroup of datum points generated by all positive roots and the actual torus. -/
noncomputable def borelSubgroup : Subgroup (D.points A) :=
  D.positivePoints A ⊔ (D.torusPoints A).range

/-- The Borel-type subgroup is the join of the positive subgroup and the actual torus image. -/
theorem borelSubgroup_def :
    D.borelSubgroup A = D.positivePoints A ⊔ (D.torusPoints A).range :=
  (rfl)

/-- A subgroup contains the Borel-type subgroup exactly when it contains every positive root
parameter and every point of the actual torus. -/
theorem borelSubgroup_le_iff {P : Subgroup (D.points A)} :
    D.borelSubgroup A ≤ P ↔
      (∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ u,
        D.rootSubgroupPoints γ A u ∈ P) ∧ (∀ s, D.torusPoints A s ∈ P) := by
  rw [D.borelSubgroup_def, sup_le_iff, D.positivePoints_le_iff]
  simp only [IsConcreteLE.le_iff, MonoidHom.mem_range, forall_exists_index,
    forall_apply_eq_imp_iff]

/-- The opposite Borel-type subgroup of datum points generated by all negative roots and the
actual torus. -/
noncomputable def oppositeBorelSubgroup : Subgroup (D.points A) :=
  D.negativePoints A ⊔ (D.torusPoints A).range

/-- The opposite Borel-type subgroup is the join of the negative subgroup and the actual torus
image. -/
theorem oppositeBorelSubgroup_def :
    D.oppositeBorelSubgroup A = D.negativePoints A ⊔ (D.torusPoints A).range :=
  (rfl)

/-- A subgroup contains the opposite Borel-type subgroup exactly when it contains every negative
root parameter and every point of the actual torus. -/
theorem oppositeBorelSubgroup_le_iff {P : Subgroup (D.points A)} :
    D.oppositeBorelSubgroup A ≤ P ↔
      (∀ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ u,
        D.rootSubgroupPoints γ A u ∈ P) ∧ (∀ s, D.torusPoints A s ∈ P) := by
  rw [D.oppositeBorelSubgroup_def, sup_le_iff, D.negativePoints_le_iff]
  simp only [IsConcreteLE.le_iff, MonoidHom.mem_range, forall_exists_index,
    forall_apply_eq_imp_iff]

section WeightBlocks

open TauCeti.UniversalEnvelopingAlgebra

attribute [local instance high] Algebra.toModule

private theorem blockTriangular_of_mem_subsystemPoints_sup_torus
    (degree : (Fin t.rank → ℤ) →+ ℚ) {S : Set (Fin t.numRoots)}
    (hdeg : ∀ γ ∈ S, 0 < degree ((t.simplyConnectedRootDatum ht).root γ))
    {g : D.points A} (hg : g ∈ D.subsystemPoints S A ⊔ (D.torusPoints A).range) :
    ((g : Matrix.GeneralLinearGroup (Fin D.dim) A) :
      Matrix (Fin D.dim) (Fin D.dim) A).BlockTriangular
        (orderedWeightBlock degree D.weight) := by
  let P : Subgroup (D.points A) :=
    { carrier := {g | ((g : Matrix.GeneralLinearGroup (Fin D.dim) A) :
          Matrix (Fin D.dim) (Fin D.dim) A).BlockTriangular
            (orderedWeightBlock degree D.weight)}
      one_mem' := by
        simpa only [Set.mem_ofPred_eq, Subgroup.coe_one, Units.val_one] using
          (Matrix.blockTriangular_one (b := orderedWeightBlock degree D.weight) (R := A))
      mul_mem' := fun hg hh => by
        simpa only [Set.mem_ofPred_eq, Subgroup.coe_mul, Units.val_mul] using hg.mul hh
      inv_mem' := fun {g} hg => by
        simpa only [Set.mem_ofPred_eq, Subgroup.coe_inv, Matrix.coe_units_inv] using
          Matrix.blockTriangular_inv_of_blockTriangular hg }
  have mem_P {x : D.points A} :
      x ∈ P ↔ ((x : Matrix.GeneralLinearGroup (Fin D.dim) A) :
        Matrix (Fin D.dim) (Fin D.dim) A).BlockTriangular
          (orderedWeightBlock degree D.weight) := Iff.rfl
  have hle : D.subsystemPoints S A ⊔ (D.torusPoints A).range ≤ P := by
    apply sup_le
    · exact D.subsystemPoints_le_iff.mpr fun γ hγ u =>
        mem_P.mpr (D.blockUnitriangular_rootSubgroupPoints_of_degree_pos A degree
          (hdeg γ hγ) u).blockTriangular
    · rintro _ ⟨s, rfl⟩
      exact mem_P.mpr (D.blockTriangular_torusPoints A _ s)
  exact mem_P.mp (hle hg)

/-- The subgroup generated by all positive root groups and the actual torus is upper
triangular in the weight-space blocks. No point-generation or torus-surjectivity assumption
is needed. -/
theorem blockTriangular_of_mem_borelSubgroup {g : D.points A}
    (hg : g ∈ D.borelSubgroup A) :
    ((g : Matrix.GeneralLinearGroup (Fin D.dim) A) :
      Matrix (Fin D.dim) (Fin D.dim) A).BlockTriangular
        (orderedWeightBlock (t.weightDegree ht) D.weight) := by
  rw [D.borelSubgroup_def, D.positivePoints_def] at hg
  exact D.blockTriangular_of_mem_subsystemPoints_sup_torus A (t.weightDegree ht)
    (fun _ hγ => t.weightDegree_root_pos ht hγ) hg

/-- The opposite Borel-type subgroup is block upper triangular in the weight-space blocks ordered
by negated height degree. -/
theorem blockTriangular_of_mem_oppositeBorelSubgroup {g : D.points A}
    (hg : g ∈ D.oppositeBorelSubgroup A) :
    ((g : Matrix.GeneralLinearGroup (Fin D.dim) A) :
      Matrix (Fin D.dim) (Fin D.dim) A).BlockTriangular
        (orderedWeightBlock (-t.weightDegree ht) D.weight) := by
  rw [D.oppositeBorelSubgroup_def, D.negativePoints_def] at hg
  exact D.blockTriangular_of_mem_subsystemPoints_sup_torus A (-t.weightDegree ht)
    (fun _ hγ => neg_pos.mpr (t.weightDegree_root_neg ht hγ)) hg

end WeightBlocks

/-- The positive subgroup is contained in the Borel-type subgroup. -/
theorem positivePoints_le_borelSubgroup : D.positivePoints A ≤ D.borelSubgroup A :=
  le_sup_left

/-- The actual torus image is contained in the Borel-type subgroup. -/
theorem range_torusPoints_le_borelSubgroup : (D.torusPoints A).range ≤ D.borelSubgroup A :=
  le_sup_right

/-- Every positive root element belongs to the Borel-type subgroup. -/
@[simp]
theorem rootSubgroupPoints_mem_borelSubgroup_of_mem_posRoots {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.borelSubgroup A :=
  D.positivePoints_le_borelSubgroup A (D.rootSubgroupPoints_mem_positivePoints A hγ u)

/-- Every point of the actual torus belongs to the Borel-type subgroup. -/
@[simp]
theorem torusPoints_mem_borelSubgroup (s : Fin t.rank → Aˣ) :
    D.torusPoints A s ∈ D.borelSubgroup A :=
  D.range_torusPoints_le_borelSubgroup A ⟨s, rfl⟩

/-- The Borel-type subgroup normalizes its positive subgroup. -/
theorem borelSubgroup_le_normalizer_positivePoints :
    D.borelSubgroup A ≤ Subgroup.normalizer (D.positivePoints A : Set _) :=
  sup_le (D.positivePoints A).le_normalizer
    (D.range_torusPoints_le_normalizer_positivePoints A)

/-- The positive subgroup is normal inside the Borel-type subgroup. -/
instance normal_positivePoints_subgroupOf_borelSubgroup :
    ((D.positivePoints A).subgroupOf (D.borelSubgroup A)).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer
    (D.positivePoints_le_borelSubgroup A)).mpr
      (D.borelSubgroup_le_normalizer_positivePoints A)

private theorem mem_sup_range_torusPoints_iff_existsUnique {U : Subgroup (D.points A)}
    (hnorm : (D.torusPoints A).range ≤ Subgroup.normalizer (U : Set _))
    (hdisj : U ⊓ (D.torusPoints A).range = ⊥) {g : D.points A} :
    g ∈ U ⊔ (D.torusPoints A).range ↔
      ∃! p : U × (Fin t.rank → Aˣ), p.fst.val * D.torusPoints A p.snd = g := by
  have hinj : Function.Injective (fun p : U × (Fin t.rank → Aˣ) =>
      p.fst.val * D.torusPoints A p.snd) := by
    intro p q hpq
    have hm := Subgroup.mul_injective_of_disjoint (H₂ := (D.torusPoints A).range)
      (disjoint_iff.mpr hdisj)
      (a₁ := (p.fst, ⟨D.torusPoints A p.snd, ⟨p.snd, rfl⟩⟩))
      (a₂ := (q.fst, ⟨D.torusPoints A q.snd, ⟨q.snd, rfl⟩⟩)) hpq
    exact Prod.ext (congrArg (fun x => x.fst) hm)
      (D.torusPoints_injective A (congrArg (fun x => x.snd.val) hm))
  rw [Subgroup.mem_sup_of_right_le_normalizer_left hnorm, hinj.existsUnique_iff_exists]
  constructor
  · rintro ⟨u, hu, _, ⟨s, rfl⟩, rfl⟩
    exact ⟨(⟨u, hu⟩, s), rfl⟩
  · rintro ⟨⟨u, s⟩, rfl⟩
    exact ⟨u.val, u.property, D.torusPoints A s, ⟨s, rfl⟩, rfl⟩

private theorem map_sup_range_torusPoints_le {B : Type w} [CommRing B] (f : A →+* B)
    {UA : Subgroup (D.points A)} {UB : Subgroup (D.points B)}
    (hU : UA.map ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤ UB) :
    (UA ⊔ (D.torusPoints A).range).map
        ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      UB ⊔ (D.torusPoints B).range := by
  rw [Subgroup.map_sup]
  apply sup_le
  · exact hU.trans le_sup_left
  · rw [Subgroup.map_le_iff_le_comap]
    rintro _ ⟨s, rfl⟩
    simpa only [Subgroup.mem_comap, D.map_torusPoints] using
      (le_sup_right : (D.torusPoints B).range ≤ UB ⊔ (D.torusPoints B).range)
        ⟨fun i => Units.map f.toMonoidHom (s i), rfl⟩

/-- Membership in the Borel-type subgroup is precisely a product of a positive element followed
by an actual torus point. This is existence of factors, not a root-coordinate normal form. -/
theorem mem_borelSubgroup_iff {g : D.points A} :
    g ∈ D.borelSubgroup A ↔
      ∃ u ∈ D.positivePoints A, ∃ s : Fin t.rank → Aˣ, u * D.torusPoints A s = g := by
  rw [D.borelSubgroup_def, Subgroup.mem_sup_of_right_le_normalizer_left
    (D.range_torusPoints_le_normalizer_positivePoints A)]
  simp only [MonoidHom.mem_range, exists_exists_eq_and]

/-- Every element of the Borel-type subgroup decomposes uniquely as `u * D.torusPoints A s` with
`u : D.positivePoints A` and `s : Fin t.rank → Aˣ`, over any commutative ring. -/
theorem mem_borelSubgroup_iff_existsUnique {g : D.points A} :
    g ∈ D.borelSubgroup A ↔
      ∃! p : D.positivePoints A × (Fin t.rank → Aˣ), p.fst.val * D.torusPoints A p.snd = g :=
  D.mem_sup_range_torusPoints_iff_existsUnique A
    (D.range_torusPoints_le_normalizer_positivePoints A)
    (D.positivePoints_inf_range_torusPoints_eq_bot A)

/-- Scalar extension carries the Borel-type subgroup into the corresponding subgroup over the
target ring, without a surjectivity assumption on the ring map. -/
theorem map_borelSubgroup_le {B : Type w} [CommRing B] (f : A →+* B) :
    (D.borelSubgroup A).map ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      D.borelSubgroup B :=
  D.map_sup_range_torusPoints_le A f (D.map_positivePoints_le f)

/-- The negative subgroup is contained in the opposite Borel-type subgroup. -/
theorem negativePoints_le_oppositeBorelSubgroup : D.negativePoints A ≤ D.oppositeBorelSubgroup A :=
  le_sup_left

/-- The actual torus image is contained in the opposite Borel-type subgroup. -/
theorem range_torusPoints_le_oppositeBorelSubgroup :
    (D.torusPoints A).range ≤ D.oppositeBorelSubgroup A :=
  le_sup_right

/-- Every negative root element belongs to the opposite Borel-type subgroup. -/
@[simp]
theorem rootSubgroupPoints_mem_oppositeBorelSubgroup_of_mem_negRoots {γ : Fin t.numRoots}
    (hγ : γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Multiplicative A) :
    D.rootSubgroupPoints γ A u ∈ D.oppositeBorelSubgroup A :=
  D.negativePoints_le_oppositeBorelSubgroup A (D.rootSubgroupPoints_mem_negativePoints A hγ u)

/-- Every point of the actual torus belongs to the opposite Borel-type subgroup. -/
@[simp]
theorem torusPoints_mem_oppositeBorelSubgroup (s : Fin t.rank → Aˣ) :
    D.torusPoints A s ∈ D.oppositeBorelSubgroup A :=
  D.range_torusPoints_le_oppositeBorelSubgroup A ⟨s, rfl⟩

/-- The opposite Borel-type subgroup normalizes its negative subgroup. -/
theorem oppositeBorelSubgroup_le_normalizer_negativePoints :
    D.oppositeBorelSubgroup A ≤ Subgroup.normalizer (D.negativePoints A : Set _) :=
  sup_le (D.negativePoints A).le_normalizer
    (D.range_torusPoints_le_normalizer_negativePoints A)

/-- The negative subgroup is normal inside the opposite Borel-type subgroup. -/
instance normal_negativePoints_subgroupOf_oppositeBorelSubgroup :
    ((D.negativePoints A).subgroupOf (D.oppositeBorelSubgroup A)).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer
    (D.negativePoints_le_oppositeBorelSubgroup A)).mpr
      (D.oppositeBorelSubgroup_le_normalizer_negativePoints A)

/-- Membership in the opposite Borel-type subgroup is precisely a product of a negative element
followed by an actual torus point. -/
theorem mem_oppositeBorelSubgroup_iff {g : D.points A} :
    g ∈ D.oppositeBorelSubgroup A ↔
      ∃ u ∈ D.negativePoints A, ∃ s : Fin t.rank → Aˣ, u * D.torusPoints A s = g := by
  rw [D.oppositeBorelSubgroup_def, Subgroup.mem_sup_of_right_le_normalizer_left
    (D.range_torusPoints_le_normalizer_negativePoints A)]
  simp only [MonoidHom.mem_range, exists_exists_eq_and]

/-- Every element of the opposite Borel-type subgroup decomposes uniquely as
`u * D.torusPoints A s` with `u : D.negativePoints A` and `s : Fin t.rank → Aˣ`, over any
commutative ring. -/
theorem mem_oppositeBorelSubgroup_iff_existsUnique {g : D.points A} :
    g ∈ D.oppositeBorelSubgroup A ↔
      ∃! p : D.negativePoints A × (Fin t.rank → Aˣ), p.fst.val * D.torusPoints A p.snd = g :=
  D.mem_sup_range_torusPoints_iff_existsUnique A
    (D.range_torusPoints_le_normalizer_negativePoints A)
    (D.negativePoints_inf_range_torusPoints_eq_bot A)

/-- Scalar extension carries the opposite Borel-type subgroup into the corresponding subgroup
over the target ring, without a surjectivity assumption on the ring map. -/
theorem map_oppositeBorelSubgroup_le {B : Type w} [CommRing B] (f : A →+* B) :
    (D.oppositeBorelSubgroup A).map ((D.pointsPresentation A).map (D.pointsPresentation B) f) ≤
      D.oppositeBorelSubgroup B :=
  D.map_sup_range_torusPoints_le A f (D.map_negativePoints_le f)

/-- The positive point subgroup intersects the opposite Borel-type subgroup trivially over every
commutative ring. -/
@[simp]
theorem positivePoints_inf_oppositeBorelSubgroup_eq_bot :
    D.positivePoints A ⊓ D.oppositeBorelSubgroup A = ⊥ := by
  rw [D.oppositeBorelSubgroup_def]
  exact D.positivePoints_inf_negativePoints_sup_range_torusPoints_eq_bot A

/-- The opposite Borel-type subgroup intersects the positive point subgroup trivially over every
commutative ring. -/
@[simp]
theorem oppositeBorelSubgroup_inf_positivePoints_eq_bot :
    D.oppositeBorelSubgroup A ⊓ D.positivePoints A = ⊥ := by
  rw [inf_comm, D.positivePoints_inf_oppositeBorelSubgroup_eq_bot]

/-- The negative point subgroup meets the positive Borel-type subgroup trivially over every
commutative ring. -/
@[simp]
theorem negativePoints_inf_borelSubgroup_eq_bot :
    D.negativePoints A ⊓ D.borelSubgroup A = ⊥ := by
  rw [D.borelSubgroup_def]
  exact D.negativePoints_inf_positivePoints_sup_range_torusPoints_eq_bot A

/-- The positive Borel-type subgroup meets the negative point subgroup trivially over every
commutative ring. -/
@[simp]
theorem borelSubgroup_inf_negativePoints_eq_bot :
    D.borelSubgroup A ⊓ D.negativePoints A = ⊥ := by
  rw [inf_comm, D.negativePoints_inf_borelSubgroup_eq_bot]

/-- The Borel-type subgroup and the opposite Borel-type subgroup intersect in the actual torus
over every commutative ring. -/
@[simp]
theorem borelSubgroup_inf_oppositeBorelSubgroup :
    D.borelSubgroup A ⊓ D.oppositeBorelSubgroup A = (D.torusPoints A).range := by
  apply le_antisymm
  · rintro g ⟨hgB, hgBopp⟩
    obtain ⟨u, hu, s, rfl⟩ := (D.mem_borelSubgroup_iff A).mp hgB
    have hu_opp : u ∈ D.oppositeBorelSubgroup A := by
      have hmul := (D.oppositeBorelSubgroup A).mul_mem hgBopp
        ((D.oppositeBorelSubgroup A).inv_mem (D.torusPoints_mem_oppositeBorelSubgroup A s))
      rwa [mul_inv_cancel_right] at hmul
    have hu1 : u = 1 := Subgroup.mem_bot.mp
      (D.positivePoints_inf_oppositeBorelSubgroup_eq_bot A ▸ ⟨hu, hu_opp⟩)
    rw [hu1, one_mul]
    exact ⟨s, rfl⟩
  · exact le_inf (D.range_torusPoints_le_borelSubgroup A)
      (D.range_torusPoints_le_oppositeBorelSubgroup A)

/-- The opposite Borel-type subgroup and the Borel-type subgroup intersect in the actual torus
over every commutative ring. -/
@[simp]
theorem oppositeBorelSubgroup_inf_borelSubgroup :
    D.oppositeBorelSubgroup A ⊓ D.borelSubgroup A = (D.torusPoints A).range := by
  rw [inf_comm, D.borelSubgroup_inf_oppositeBorelSubgroup]

/-- A negative root element belongs to the positive Borel-type subgroup if and only if its
multiplicative parameter is `1`. -/
@[simp]
theorem rootSubgroupPoints_mem_borelSubgroup_iff_of_mem_negRoots {γ : Fin t.numRoots}
    (hγ : γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (a : Multiplicative A) :
    D.rootSubgroupPoints γ A a ∈ D.borelSubgroup A ↔ a = 1 := by
  rw [← D.rootSubgroupPoints_eq_one_iff]
  refine ⟨fun ha => Subgroup.mem_bot.mp ?_, fun ha => ha ▸ (D.borelSubgroup A).one_mem⟩
  rw [← D.negativePoints_inf_borelSubgroup_eq_bot A]
  exact ⟨D.rootSubgroupPoints_mem_negativePoints A hγ a, ha⟩

/-- A positive root element belongs to the opposite Borel-type subgroup if and only if its
multiplicative parameter is `1`. -/
@[simp]
theorem rootSubgroupPoints_mem_oppositeBorelSubgroup_iff_of_mem_posRoots {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (a : Multiplicative A) :
    D.rootSubgroupPoints γ A a ∈ D.oppositeBorelSubgroup A ↔ a = 1 := by
  rw [← D.rootSubgroupPoints_eq_one_iff]
  refine ⟨fun ha => Subgroup.mem_bot.mp ?_, fun ha => ha ▸ (D.oppositeBorelSubgroup A).one_mem⟩
  rw [← D.positivePoints_inf_oppositeBorelSubgroup_eq_bot A]
  exact ⟨D.rootSubgroupPoints_mem_positivePoints A hγ a, ha⟩

/-- Conjugating a positive simple-root element by its pinned Weyl representative lands
in the positive Borel-type subgroup if and only if its multiplicative parameter is `1`. -/
@[simp]
theorem weylElement_conj_rootSubgroupPoints_simpleIndex_mem_borelSubgroup_iff
    (i : Fin t.rank) (u : Multiplicative A) :
    D.weylElement (t.simpleIndex ht i) A 1 *
        D.rootSubgroupPoints (t.simpleIndex ht i) A u *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ ∈ D.borelSubgroup A ↔
      u = 1 := by
  have hneg : (t.simplyConnectedRootDatum ht).reflectionPerm
      (t.simpleIndex ht i) (t.simpleIndex ht i) ∈
      negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [← t.reflectionPerm_rationalRootSystem ht]
    exact (reflectionPerm_self_mem_negRoots_iff_mem_posRoots _ _ _).mpr
      (simpleIndex_mem_posRoots i)
  let ε : ℤˣ := t.chevalleyWeylSign ht (t.simpleIndex ht i) (t.simpleIndex ht i)
  have hunit : IsUnit ((ε : ℤ) : A) := by
    simpa only [Int.coe_castRingHom] using ε.isUnit.map (Int.castRingHom A)
  rw [← ofAdd_toAdd u, D.weylElement_conj_rootSubgroupPoints,
    D.rootSubgroupPoints_mem_borelSubgroup_iff_of_mem_negRoots A hneg,
    ofAdd_eq_one, hunit.mul_right_eq_zero, toAdd_eq_zero, ofAdd_toAdd]

/-- Every pinned simple Weyl representative conjugates some element of the positive Borel
outside that Borel, for every Chevalley datum over a nontrivial commutative ring. -/
theorem exists_weylElement_conj_notMem_borelSubgroup [Nontrivial A] (i : Fin t.rank) :
    ∃ b : D.borelSubgroup A,
      D.weylElement (t.simpleIndex ht i) A 1 * b.val *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ ∉ D.borelSubgroup A := by
  refine ⟨⟨D.rootSubgroupPoints (t.simpleIndex ht i) A (Multiplicative.ofAdd 1),
    D.rootSubgroupPoints_mem_borelSubgroup_of_mem_posRoots A (simpleIndex_mem_posRoots i) _⟩, ?_⟩
  simp

/-- Conjugating any point of the actual weight-lattice torus by an element of `D.weylSubgroup A`
stays inside `D.borelSubgroup A`. -/
theorem weylSubgroup_conj_torusPoints_mem_borelSubgroup (w : D.weylSubgroup A)
    (s : Fin t.rank → Aˣ) :
    (w : D.points A) * D.torusPoints A s * (w : D.points A)⁻¹ ∈ D.borelSubgroup A :=
  D.range_torusPoints_le_borelSubgroup A <|
    (Subgroup.mem_normalizer_iff.mp
      (D.weylSubgroup_le_normalizer_range_torusPoints A w.property)
      (D.torusPoints A s)).mp ⟨s, rfl⟩

/-- Conjugating any point of the actual weight-lattice torus by the inverse of an element of
`D.weylSubgroup A` stays inside `D.borelSubgroup A`. -/
theorem weylSubgroup_inv_conj_torusPoints_mem_borelSubgroup (w : D.weylSubgroup A)
    (s : Fin t.rank → Aˣ) :
    (w : D.points A)⁻¹ * D.torusPoints A s * (w : D.points A) ∈ D.borelSubgroup A := by
  simpa only [Subgroup.coe_inv, inv_inv] using
    D.weylSubgroup_conj_torusPoints_mem_borelSubgroup A w⁻¹ s

end TauCeti.DynkinType.ChevalleyDatum
