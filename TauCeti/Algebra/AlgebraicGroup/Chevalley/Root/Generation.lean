module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Generation
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Root.Scheme
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Generation

/-!
# Simple root morphisms generate every Chevalley datum

The group scheme of a Chevalley datum is defined using its simple root morphisms and its
actual character-lattice torus. The torus can be removed from these scheme generators, even
when the weight lattice is proper. Consequently homomorphisms to affine group schemes are
determined by the positive and negative simple root morphisms, with no separate torus condition.
This supplies uniqueness for comparisons between integral Chevalley models.

The full-weight torus is generated pointwise by the simple coroot words. Although it need not
surject onto the actual torus on ring-valued points, the inclusion of character lattices is
injective, so both torus parametrizations generate the same closed subgroup scheme. Combining
these facts gives equality of the integral defining Hopf ideals. This does not assert that
all field-valued points are elementary, or that a non-flat specialization is generated anew
by the specialized roots.

We use `ChevalleyDatum.kostantTorusSubgroup_weight_le_kostantElementarySubgroup`, the universal
point criterion in `Kostant.RootSubgroup.Scheme.ToralClosure.Generation`, and the invariance
under injective character maps in `Kostant.RootSubgroup.Scheme.ToralClosure.LinearMap`.
The ideal-to-rigidity argument follows the full-weight construction in
`SimplyConnectedRootDatum.LieAlgebra.SimplyConnectedModule.Generation`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19 and 28(c), and
  Corollary 5 to Theorem 4′.
* J. C. Jantzen, *Representations of Algebraic Groups*, Part II, Chapter 1.
-/

public section

open AlgebraicGeometry CategoryTheory
open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

noncomputable section

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

/-- The actual-torus and root-generated integral defining Hopf ideals of a Chevalley datum
coincide. No fullness assumption on its weight lattice is needed. -/
theorem toralDefiningIdeal_eq_generated :
    kostantToralDefiningIdeal (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
        D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator D.basis D.coordinateWeight =
      kostantGeneratedDefiningIdeal (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
        D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator D.basis := by
  have hweights : (fun j => D.weightLatticeEmbedding (D.coordinateWeight j)) = D.weight := by
    funext j
    exact D.weightLatticeEmbedding_coordinateWeight j
  have htoral := kostantToralDefiningIdeal_linearMap
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h D.representation D.lattice
    D.representation_mem_lattice D.isNilpotent_representation_rootGenerator D.basis
    D.coordinateWeight D.weightLatticeEmbedding_injective
  rw [hweights] at htoral
  rw [← htoral]
  apply kostantToralDefiningIdeal_eq_kostantGeneratedDefiningIdeal_of_universal_torus_mem_elementary
  exact ((kostantTorusSubgroup_eq_range D.lattice D.basis D.weight _).symm.trans_le
    (D.kostantTorusSubgroup_weight_le_kostantElementarySubgroup _)) ⟨_, rfl⟩

/-- The integral group scheme of a Chevalley datum is generated by its numbered positive
and negative simple root morphisms alone. This is scheme generation, not point generation. -/
theorem groupScheme_eq_generated :
    D.groupScheme =
      kostantGeneratedGroupScheme (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
        D.representation D.lattice D.representation_mem_lattice
        D.isNilpotent_representation_rootGenerator D.basis := by
  exact congrArg (CommHopfAlgCat.quotientSpec (GeneralLinear.coordinateHopfAlgebra ℤ D.dim))
    D.toralDefiningIdeal_eq_generated

/-- The canonical inclusion of the simple-root-generated scheme in the datum's group scheme
is an isomorphism, also for a proper weight lattice. -/
instance isIso_generatedToToral :
    IsIso (kostantGeneratedToToral (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
      D.representation D.lattice D.representation_mem_lattice
      D.isNilpotent_representation_rootGenerator D.basis D.coordinateWeight) :=
  isIso_kostantGeneratedToToral_of_definingIdeal_eq _ _ _ _ _ _ _ _
    D.toralDefiningIdeal_eq_generated

/-- Morphisms from a Chevalley datum's group scheme to an affine group scheme are equal
if they agree on both signs of the simple roots. No torus equation is required. -/
theorem groupScheme_hom_ext_of_simpleRoot {Y : _root_.CommHopfAlgCat.{0} ℤ}
    (f g : D.groupScheme ⟶ (hopfSpec (CommRingCat.of ℤ)).obj (Opposite.op Y))
    (hpos : ∀ i, D.rootSubgroup (t.simpleIndex ht i) ≫ f =
      D.rootSubgroup (t.simpleIndex ht i) ≫ g)
    (hneg : ∀ i, D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) ≫ f =
      D.rootSubgroup ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) ≫ g) :
    f = g := by
  apply kostantToralGroupScheme_hom_ext_of_isIso_kostantGeneratedToToral
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h D.representation D.lattice
    D.representation_mem_lattice D.isNilpotent_representation_rootGenerator D.basis
    D.coordinateWeight f g
  rintro (i | i)
  · simpa only [D.rootSubgroup_simpleIndex_eq_kostantRootSubgroupToToral] using hpos i
  · simpa only [D.rootSubgroup_reflectionPerm_simpleIndex_eq_kostantRootSubgroupToToral]
      using hneg i

end

end TauCeti.DynkinType.ChevalleyDatum
