module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Commutator.Basic
import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Orthogonal rank-one subgroups of a Chevalley datum

The subgroups generated by opposite root pairs centralize one another when neither the sum
nor the difference of the roots is a root or zero. This includes simple roots at orthogonal
nodes. In particular, their pinned Weyl elements commute, even with independent unit
parameters. This proves the length-two braid relation on the actual Chevalley points, not
just on their images in the abstract Weyl group. These relations are inputs to collecting
Weyl words and identifying the torus-normalizer quotient.

The statements hold for every Chevalley datum and every commutative value ring, including
nonreduced rings and bad characteristic. They do not identify Weyl words with the same
Weyl-group image. The proof uses `ChevalleyDatum.commute_rootSubgroup`, which supplies the
represented Kostant commutation theorem from the pinned Lie-bracket relations. The simple-node
case uses Mathlib's root-string formulas for a base. The root-word argument follows the Geck
and type-B spin orthogonal Weyl calculations, now for arbitrary Chevalley data.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 15 and 19.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 7.2.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

/-- Opposite root pairs generate mutually centralizing subgroups when their sum and
difference are neither roots nor zero. -/
theorem closure_rootPair_le_centralizer (α β : Fin t.numRoots)
    (hadd : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (hadd₀ : (t.simplyConnectedRootDatum ht).root α +
      (t.simplyConnectedRootDatum ht).root β ≠ 0)
    (hsub : (t.simplyConnectedRootDatum ht).root α - (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (hsub₀ : (t.simplyConnectedRootDatum ht).root α -
      (t.simplyConnectedRootDatum ht).root β ≠ 0) :
    Subgroup.closure (Set.range (D.rootSubgroupPoints α A) ∪
      Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm α α) A)) ≤
      Subgroup.centralizer (Subgroup.closure
        (Set.range (D.rootSubgroupPoints β A) ∪
          Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm β β) A)) :
            Set (D.points A)) := by
  have hnegsub : -(t.simplyConnectedRootDatum ht).root α +
      (t.simplyConnectedRootDatum ht).root β =
      -((t.simplyConnectedRootDatum ht).root α - (t.simplyConnectedRootDatum ht).root β) := by abel
  have hnegadd : -(t.simplyConnectedRootDatum ht).root α +
      -(t.simplyConnectedRootDatum ht).root β =
      -((t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β) := by abel
  rw [Subgroup.centralizer_closure, Subgroup.closure_le]
  rintro _ (⟨u, rfl⟩ | ⟨u, rfl⟩)
  all_goals
    apply Subgroup.mem_centralizer_iff.mpr
    rintro _ (⟨w, rfl⟩ | ⟨w, rfl⟩)
  all_goals
    apply Commute.symm
    rw [← ofAdd_toAdd u, ← ofAdd_toAdd w]
  · -- The pair (α, β) uses the sum hypotheses.
    exact D.commute_rootSubgroup hadd hadd₀ A _ _
  · -- The pair (α, -β) uses the difference hypotheses.
    apply D.commute_rootSubgroup
    · simpa only [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self,
        ← sub_eq_add_neg] using hsub
    · simpa only [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self,
        ← sub_eq_add_neg] using hsub₀
  · -- The pair (-α, β) has sum -(α - β).
    apply D.commute_rootSubgroup
    · simpa only [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self,
        hnegsub, RootPairing.neg_mem_range_root_iff] using hsub
    · simpa only [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self,
        hnegsub, neg_ne_zero] using hsub₀
  · -- The pair (-α, -β) has sum -(α + β).
    apply D.commute_rootSubgroup
    · simpa only [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self,
        hnegadd, RootPairing.neg_mem_range_root_iff] using hadd
    · simpa only [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self,
        hnegadd, neg_ne_zero] using hadd₀

/-- Opposite simple-root pairs at orthogonal nodes generate mutually centralizing subgroups.
This concerns the entire rank-one subgroups, not only their Weyl representatives. -/
theorem closure_simpleRootPair_le_centralizer (i j : Fin t.rank)
    (hij : t.cartanMatrix i j = 0) :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
      Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      Subgroup.centralizer (Subgroup.closure
        (Set.range (D.rootSubgroupPoints (t.simpleIndex ht j) A) ∪
          Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
            (t.simpleIndex ht j) (t.simpleIndex ht j)) A)) : Set (D.points A)) := by
  let b := t.simplyConnectedBase ht
  let e := t.simpleSupportEquivSimplyConnectedBase ht
  have hne : i ≠ j := by rintro rfl; simp at hij
  have hindices : t.simpleIndex ht i ≠ t.simpleIndex ht j := by
    intro h
    exact hne (Fin.ext (by simpa using congrArg Fin.val h))
  apply D.closure_rootPair_le_centralizer
  · have hpair : (t.simplyConnectedRootDatum ht).pairingIn ℤ (e i) (e j) = 0 := by
      simpa only [e, coe_simpleSupportEquivSimplyConnectedBase_apply,
        pairingIn_simpleIndex] using hij
    simpa only [e, coe_simpleSupportEquivSimplyConnectedBase_apply] using
      (b.cartanMatrix_apply_eq_zero_iff (e.injective.ne hne)).mp hpair
  · intro h
    apply b.root_ne_neg_of_ne (e i).property (e j).property
      (by simpa only [e, coe_simpleSupportEquivSimplyConnectedBase_apply] using hindices)
    simpa only [e, coe_simpleSupportEquivSimplyConnectedBase_apply] using
      add_eq_zero_iff_eq_neg.mp h
  · simpa only [e, coe_simpleSupportEquivSimplyConnectedBase_apply] using
      b.sub_notMem_range_root (e i).property (e j).property
  · exact sub_ne_zero.mpr ((t.simplyConnectedRootDatum ht).root.injective.ne hindices)

/-- Weyl elements commute when the sum and difference of their roots are neither roots
nor zero, with arbitrary independent unit parameters. -/
theorem commute_weylElement (α β : Fin t.numRoots)
    (hadd : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (hadd₀ : (t.simplyConnectedRootDatum ht).root α +
      (t.simplyConnectedRootDatum ht).root β ≠ 0)
    (hsub : (t.simplyConnectedRootDatum ht).root α - (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (hsub₀ : (t.simplyConnectedRootDatum ht).root α -
      (t.simplyConnectedRootDatum ht).root β ≠ 0)
    (s r : Aˣ) : Commute (D.weylElement α A s) (D.weylElement β A r) := by
  exact (Subgroup.mem_centralizer_iff.mp
    (D.closure_rootPair_le_centralizer A α β hadd hadd₀ hsub hsub₀
      (D.weylElement_mem_closure_rootPair α A s)) _
    (D.weylElement_mem_closure_rootPair β A r)).symm

/-- Weyl elements at orthogonal simple roots commute, with arbitrary independent unit
parameters. At parameters one this is the length-two braid relation. -/
theorem commute_weylElement_simpleIndex (i j : Fin t.rank) (hij : t.cartanMatrix i j = 0)
    (s r : Aˣ) :
    Commute (D.weylElement (t.simpleIndex ht i) A s)
      (D.weylElement (t.simpleIndex ht j) A r) := by
  exact (Subgroup.mem_centralizer_iff.mp
    (D.closure_simpleRootPair_le_centralizer A i j hij
      (D.weylElement_mem_closure_rootPair _ A s)) _
    (D.weylElement_mem_closure_rootPair _ A r)).symm

end TauCeti.DynkinType.ChevalleyDatum
