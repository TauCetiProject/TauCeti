module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.RootSubgroup
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.SimpleRootRelations
import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Orthogonal rank-one subgroups of a Chevalley datum

The subgroups generated by opposite simple-root pairs at orthogonal nodes centralize one
another. In particular, their pinned Weyl elements commute, even with independent unit
parameters. This proves the length-two braid relation on the actual Chevalley points, not
just on their images in the abstract Weyl group. These relations are inputs to collecting
Weyl words and identifying the torus-normalizer quotient.

The statements hold for every Chevalley datum and every commutative value ring, including
nonreduced rings and bad characteristic. They do not identify Weyl words with the same
Weyl-group image. The proof uses the pinned Lie-bracket relations from
`DynkinType.lie_geckSimpleRaising_eq_zero` and its signed variants, and the represented
Kostant commutation theorem. The root-word argument follows the existing Geck and type-B
spin orthogonal Weyl calculations, now for arbitrary Chevalley data.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 15 and 19.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 7.2.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open TauCeti.UniversalEnvelopingAlgebra

universe v

-- Use the integral scalar action carried by the Kostant matrix formulas.
attribute [local instance high] Algebra.toModule
attribute [local instance 100] LieRing.ofAssociativeRing

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

private theorem commute_signedSimpleRootSubgroup
    (i j : Fin t.rank ⊕ Fin t.rank)
    (hij : t.cartanMatrix (i.elim id id) (j.elim id id) = 0)
    (u w : Multiplicative A) :
    Commute
      (D.rootSubgroupPoints (i.elim (t.simpleIndex ht) (fun k =>
        (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht k)
          (t.simpleIndex ht k))) A u)
      (D.rootSubgroupPoints (j.elim (t.simpleIndex ht) (fun k =>
        (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht k)
          (t.simpleIndex ht k))) A w) := by
  have hne : i.elim id id ≠ j.elim id id := by
    intro h
    rw [h] at hij
    simp at hij
  have hlie : ⁅(t.lieBasis ht).rootGenerator i, (t.lieBasis ht).rootGenerator j⁆ = 0 := by
    cases i <;> cases j <;>
      simp only [Sum.elim_inl, Sum.elim_inr, id_eq] at hij hne <;>
      simp only [LieAlgebra.Basis.rootGenerator_inl, LieAlgebra.Basis.rootGenerator_inr]
    · exact t.lie_geckSimpleRaising_eq_zero ht _ _ hij
    · exact t.lie_geckSimpleRaising_lowering_eq_zero ht _ _ hne
    · rw [← lie_skew, t.lie_geckSimpleRaising_lowering_eq_zero ht _ _ hne.symm, neg_zero]
    · exact t.lie_geckSimpleLowering_eq_zero ht _ _ hij
  have hmatrix := commute_kostantRootSubgroupMatrix
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h D.representation D.lattice
    D.representation_mem_lattice D.basis hlie
    (D.isNilpotent_representation_rootGenerator i)
    (D.isNilpotent_representation_rootGenerator j)
    ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm u)
    ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm w)
  apply Commute.of_map (D.points A).subtype_injective
  cases i <;> cases j <;>
    simpa only [Sum.elim_inl, Sum.elim_inr, Subgroup.coe_subtype,
      D.coe_rootSubgroupPoints_simpleIndex, D.coe_rootSubgroupPoints_reflectionPerm_simpleIndex]
      using hmatrix

/-- Opposite simple-root pairs at orthogonal nodes generate mutually centralizing subgroups.
This concerns the entire rank-one subgroups, not only their Weyl representatives. -/
theorem closure_simpleRootPair_le_centralizer (i j : Fin t.rank)
    (hij : t.cartanMatrix i j = 0) :
    Subgroup.closure (Set.range (D.rootSubgroupPoints (t.simpleIndex ht i) A) ∪
      Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) A)) ≤
      Subgroup.centralizer (Subgroup.closure
        (Set.range (D.rootSubgroupPoints (t.simpleIndex ht j) A) ∪
          Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
            (t.simpleIndex ht j) (t.simpleIndex ht j)) A)) : Set (D.points A)) := by
  rw [Subgroup.centralizer_closure, Subgroup.closure_le]
  rintro _ (⟨u, rfl⟩ | ⟨u, rfl⟩)
  all_goals
    apply Subgroup.mem_centralizer_iff.mpr
    rintro _ (⟨w, rfl⟩ | ⟨w, rfl⟩)
  · exact (D.commute_signedSimpleRootSubgroup A (.inl i) (.inl j) hij u w).eq.symm
  · exact (D.commute_signedSimpleRootSubgroup A (.inl i) (.inr j) hij u w).eq.symm
  · exact (D.commute_signedSimpleRootSubgroup A (.inr i) (.inl j) hij u w).eq.symm
  · exact (D.commute_signedSimpleRootSubgroup A (.inr i) (.inr j) hij u w).eq.symm

/-- Weyl elements at orthogonal simple roots commute, with arbitrary independent unit
parameters. At parameters one this is the length-two braid relation. -/
theorem commute_weylElement (i j : Fin t.rank) (hij : t.cartanMatrix i j = 0)
    (s r : Aˣ) :
    Commute (D.weylElement (t.simpleIndex ht i) A s)
      (D.weylElement (t.simpleIndex ht j) A r) := by
  have hmem (k : Fin t.rank) (v : Aˣ) :
      D.weylElement (t.simpleIndex ht k) A v ∈ Subgroup.closure
        (Set.range (D.rootSubgroupPoints (t.simpleIndex ht k) A) ∪
          Set.range (D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
            (t.simpleIndex ht k) (t.simpleIndex ht k)) A)) := by
    rw [D.weylElement_def]
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _ (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))
        (Subgroup.subset_closure (Or.inr ⟨_, rfl⟩)))
      (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))
  exact (Subgroup.mem_centralizer_iff.mp
    (D.closure_simpleRootPair_le_centralizer A i j hij (hmem i s)) _ (hmem j r)).symm

end TauCeti.DynkinType.ChevalleyDatum
