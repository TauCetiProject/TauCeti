module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.BigCell.Weyl
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Weight.Blocks
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.WeightDegree

/-!
# Separating Weyl words from the positive torus subgroup

In a faithful Chevalley datum, a Weyl-word representative that belongs to the subgroup
generated by all positive root subgroups and the actual character-lattice torus represents
the identity Weyl element. This is a separation result for Bruhat cells, not an identification
of the kernel of the Weyl projection with the torus.

The positive root matrices are upper unitriangular in the blocks of distinct weights; the
actual torus is diagonal. Their generated subgroup is therefore block upper triangular.
Its leading weight-block minors are units, so the Weyl-word minor criterion forces the
Weyl element to be the identity. This argument works over every nontrivial commutative ring,
including finite fields and nonreduced rings, and allows weight multiplicities.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorem 4 and Chapter 5, Theorem 7.
* R. W. Carter, *Simple Groups of Lie Type*, §8.3.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open TauCeti.UniversalEnvelopingAlgebra

universe v

attribute [local instance high] Algebra.toModule

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

/-- A positive root subgroup is upper unitriangular in the blocks of distinct weights,
ordered by decreasing height degree. This uses the datum's original weight basis. -/
theorem blockUnitriangular_rootSubgroupPoints {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (u : Multiplicative A) :
    ((D.rootSubgroupPoints γ A u : Matrix.GeneralLinearGroup (Fin D.dim) A) :
      Matrix (Fin D.dim) (Fin D.dim) A).BlockUnitriangular
        (orderedWeightBlock (t.weightDegree ht) D.weight) := by
  rw [D.coe_rootSubgroupPoints,
    ← kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
      D.representation_mem_lattice D.isNilpotent_representation_rootGenerator,
    basisMatrix_kostantRootSubgroupParam]
  exact blockUnitriangular_kostantRootSubgroupMatrix
    (t.chevalleySystem ht) (t.lieBasis ht).h D.representation D.lattice _ D.basis D.weight
    (t.weightDegree ht) γ _ D.isCartanWeightVector_basis
    (t.lie_lieBasis_h_chevalleySystem ht γ) (t.weightDegree_root_pos ht hγ) _

/-- The subgroup generated by all positive root groups and the actual torus is upper
triangular in the weight-space blocks. No point-generation or torus-surjectivity assumption
is needed. -/
theorem blockTriangular_of_mem_positive_torus_closure {g : D.points A}
    (hg : g ∈ Subgroup.closure
      ({g | ∃ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        ∃ u, D.rootSubgroupPoints γ A u = g} ∪ Set.range (D.torusPoints A))) :
    ((g : Matrix.GeneralLinearGroup (Fin D.dim) A) :
      Matrix (Fin D.dim) (Fin D.dim) A).BlockTriangular
        (orderedWeightBlock (t.weightDegree ht) D.weight) := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
      rcases hg with ⟨γ, hγ, u, rfl⟩ | ⟨s, rfl⟩
      · exact (D.blockUnitriangular_rootSubgroupPoints A hγ u).blockTriangular
      · rw [D.coe_torusPoints, kostantTorusMatrix_apply, diagGL_coe]
        exact Matrix.blockTriangular_diagonal _
  | one => exact Matrix.blockTriangular_one
  | mul g h _ _ hg hh => exact hg.mul hh
  | inv g _ hg =>
      have hi := Matrix.blockTriangular_inv_of_blockTriangular hg
      simpa only [Subgroup.coe_inv, Matrix.coe_units_inv] using hi

/-- A Weyl-word representative in the subgroup generated by the positive roots and the
actual torus spells the identity Weyl element. In particular a representative of a nonidentity
Weyl element cannot lie in the identity Bruhat cell. This does not identify the projection
kernel. -/
theorem geckWeylWordProd_eq_one_of_mem_positive_torus_closure [Nontrivial A]
    (l : List (Fin t.rank))
    (hl : (l.map fun i => D.weylElement (t.simpleIndex ht i) A 1).prod ∈
      Subgroup.closure
        ({g | ∃ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
          ∃ u, D.rootSubgroupPoints γ A u = g} ∪ Set.range (D.torusPoints A))) :
    t.geckWeylWordProd ht l = 1 := by
  classical
  let r := orderedWeightBlockEquiv (t.weightDegree ht) D.weight
  apply (D.isUnit_leading_weight_minors_weylWord_iff l A r).mp
  intro a
  have hp : (fun j => r ⟨D.weight j, Set.mem_range_self j⟩ ≤ a) =
      (fun j => orderedWeightBlock (t.weightDegree ht) D.weight j ≤ a) := by
    funext j
    exact congrArg (fun k => k ≤ a) (orderedWeightBlock_def (t.weightDegree ht) D.weight j).symm
  -- The two leading-block predicates have different decidability and subtype Fintype
  -- instances, so transport their determinants rather than rewriting the subtype itself.
  rw [Matrix.equiv_block_det _ (q := fun j => orderedWeightBlock
    (t.weightDegree ht) D.weight j ≤ a) (fun j => iff_of_eq (congrFun hp j).symm)]
  have htri := D.blockTriangular_of_mem_positive_torus_closure A hl
  exact htri.isUnit_det_toSquareBlockProp (Matrix.isUnits_det_units _)
    (fun _ _ hji hi => hji.trans hi)

end TauCeti.DynkinType.ChevalleyDatum
