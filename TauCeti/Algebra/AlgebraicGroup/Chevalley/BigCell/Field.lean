/-!
# The big cell of a Chevalley datum over a field

Let `D` be a Chevalley datum, `K` a field, `E(K)` the subgroup of the points of `D` generated by
the root subgroups and the actual torus `T(K)`, and `U(K)`, `U⁻(K)` the subgroups generated by the
positive and the negative root subgroups. Order the weight basis of `D` by the blocks of distinct
weights, numbered by decreasing height (`TauCeti.UniversalEnvelopingAlgebra.orderedWeightBlock`).
This file identifies the big cell `U⁻(K) T(K) U(K)` inside `E(K)` by matrix minors: a point of
`E(K)` is a product `v * t * u` with `v ∈ U⁻(K)`, `t ∈ T(K)` and `u ∈ U(K)` exactly when all its
leading weight-block minors are units. Together with the uniqueness of the three factors
(`ChevalleyDatum.bigCellMul_injective`), this describes `E(K) ∩ GLₙ^{LDU}(K)` as the image of
`U⁻(K) × T(K) × U(K)`.

The minor condition holds on every big-cell product over every commutative ring, because negative
points are block lower unitriangular, torus points are diagonal and positive points are block upper
unitriangular. For the converse, a Weyl lift `n₀` of the longest Weyl element conjugates `U⁻(K)`
onto `U(K)` (`ChevalleyDatum.map_negativePoints_conj_eq_positivePoints`). Applying the Bruhat
decomposition to `n₀ g` writes every `g ∈ E(K)` as `v * m * b` with `v ∈ U⁻(K)`, `m` in the Weyl
subgroup `N(K)` and `b` in the Borel subgroup `B(K)`. The leading minors of `v * m * b` are units
exactly when `m` projects to the identity Weyl element, and then `m` is a torus point.

## Main results

* `ChevalleyDatum.mem_extendedElementarySubgroup_iff_exists_negativePoints_mul_mul`:
  `E(K) = U⁻(K) N(K) B(K)`.
* `ChevalleyDatum.isUnit_det_toSquareBlockProp_of_mem_range_bigCellMul`: every big-cell product,
  over every commutative ring, has unit leading weight-block minors.
* `ChevalleyDatum.mem_range_bigCellMul_iff_forall_isUnit_det_toSquareBlockProp`: over a field, a
  point of `E(K)` lies in the big cell exactly when its leading weight-block minors are units.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Theorem 4, and Chapter 5, Theorem 7.
* J. C. Jantzen, *Representations of Algebraic Groups*, Part II, Chapter 1.
-/

public section

open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

section Ring

variable {A : Type v} [CommRing A]

/-- Every big-cell product lies in the subgroup generated by the root subgroups and the actual
torus. -/
theorem bigCellMul_mem_extendedElementarySubgroup
    (x : D.negativePoints A × ((Fin t.rank → Aˣ) × D.positivePoints A)) :
    D.bigCellMul A x ∈ D.extendedElementarySubgroup A := by
  rw [bigCellMul_apply]
  exact mul_mem (mul_mem (D.negativePoints_le_extendedElementarySubgroup A x.1.property)
      (D.torusPoints_mem_extendedElementarySubgroup A _))
    (D.borelSubgroup_le_extendedElementarySubgroup A
      (D.positivePoints_le_borelSubgroup A x.2.2.property))

/-- **Big-cell products have unit leading minors.** Over every commutative ring, every leading
principal minor of `v * t * u`, with `v ∈ U⁻`, `t` an actual torus point and `u ∈ U`, taken at a
boundary between the weight blocks ordered by decreasing height, is a unit. -/
theorem isUnit_det_toSquareBlockProp_of_mem_range_bigCellMul {g : D.points A}
    (hg : g ∈ Set.range (D.bigCellMul A)) (a : Fin (Nat.card (Set.range D.weight))) :
    IsUnit (((g : Matrix.GeneralLinearGroup (Fin D.dim) A) :
      Matrix (Fin D.dim) (Fin D.dim) A).toSquareBlockProp
        fun j => orderedWeightBlock (t.weightDegree ht) D.weight j ≤ a).det := by
  obtain ⟨⟨v, s, u⟩, rfl⟩ := hg
  let b := orderedWeightBlock (t.weightDegree ht) D.weight
  let L : Matrix (Fin D.dim) (Fin D.dim) A :=
    ((v.val : Matrix.GeneralLinearGroup (Fin D.dim) A) : Matrix (Fin D.dim) (Fin D.dim) A)
  let U : Matrix (Fin D.dim) (Fin D.dim) A :=
    ((D.torusPoints A s * u.val : D.points A) : Matrix.GeneralLinearGroup (Fin D.dim) A)
  have hL : L.BlockUnitriangular (OrderDual.toDual ∘ b) :=
    D.blockUnitriangular_toDual_of_mem_negativePoints A v.property
  have hU : U.BlockTriangular b := by
    simpa only [U, Subgroup.coe_mul, Units.val_mul] using
      (D.blockTriangular_torusPoints A b s).mul
        (D.blockUnitriangular_of_mem_positivePoints A u.property).blockTriangular
  have hUdet : IsUnit U.det := (Matrix.isUnit_iff_isUnit_det U).mp (Units.isUnit _)
  have hmat : ((D.bigCellMul A (v, s, u) : Matrix.GeneralLinearGroup (Fin D.dim) A) :
      Matrix (Fin D.dim) (Fin D.dim) A) = L * 1 * U := by
    simp only [L, U, bigCellMul_apply, mul_assoc, Subgroup.coe_mul, Units.val_mul, Matrix.mul_one]
  rw [hmat, Matrix.isUnit_det_toSquareBlockProp_mul_mul_iff hL.blockTriangular hU
    hL.isUnit_det hUdet fun _ _ hji hi => hji.trans hi]
  exact (Matrix.blockUnitriangular_one (R := A) (b := b)).toSquareBlockProp _ |>.isUnit_det

end Ring

section Field

variable (K : Type v) [Field K]

/-- **The opposite Bruhat covering** `E(K) = U⁻(K) N(K) B(K)`: a point lies in the subgroup
generated by the root subgroups and the actual torus exactly when it is a product `v * m * b` of a
negative point, an element of the Weyl subgroup and an element of the Borel subgroup. -/
theorem mem_extendedElementarySubgroup_iff_exists_negativePoints_mul_mul
    {g : D.points K} :
    g ∈ D.extendedElementarySubgroup K ↔
      ∃ v ∈ D.negativePoints K, ∃ m ∈ D.weylSubgroup K, ∃ b ∈ D.borelSubgroup K,
        v * m * b = g := by
  constructor
  · intro hg
    have := isReduced_simplyConnectedRootDatum t ht
    obtain ⟨n, hn⟩ := D.weylProjection_surjective K
      (longestElement (t.simplyConnectedRootDatum ht) (t.simplyConnectedBase ht))
    have hn' := D.map_negativePoints_conj_eq_positivePoints K n
      (by rw [hn, inversions_longestElement])
    -- Apply the Bruhat decomposition to `n * g` and move the left positive factor across `n`.
    have hng : (n : D.points K) * g ∈ D.extendedElementarySubgroup K :=
      mul_mem (D.weylSubgroup_le_extendedElementarySubgroup K n.property) hg
    rw [← SetLike.mem_coe, ← D.iUnion_bruhatCell_eq_extendedElementarySubgroup K,
      Set.mem_iUnion] at hng
    obtain ⟨w, hw⟩ := hng
    obtain ⟨m, rfl⟩ := D.weylProjection_surjective K w
    rw [D.bruhatCell_weylProjection_eq_doubleCoset_positivePoints_left K m] at hw
    obtain ⟨u, hu, b, hb, hub⟩ := DoubleCoset.mem_doubleCoset.mp hw
    rw [← hn'] at hu
    obtain ⟨v, hv, rfl⟩ := hu
    refine ⟨v, hv, (n : D.points K)⁻¹ * m, mul_mem (inv_mem n.property) m.property, b, hb, ?_⟩
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at hub
    rw [← inv_mul_cancel_left (n : D.points K) g, hub]
    group
  · rintro ⟨v, hv, m, hm, b, hb, rfl⟩
    exact mul_mem (mul_mem (D.negativePoints_le_extendedElementarySubgroup K hv)
      (D.weylSubgroup_le_extendedElementarySubgroup K hm))
      (D.borelSubgroup_le_extendedElementarySubgroup K hb)

/-- **The big cell over a field.** A point of the subgroup `E(K)` generated by the root subgroups
and the actual torus is a product `v * t * u` with `v ∈ U⁻(K)`, `t ∈ T(K)` and `u ∈ U(K)` exactly
when every leading principal minor at a boundary between the weight blocks, ordered by decreasing
height, is a unit. -/
theorem mem_range_bigCellMul_iff_forall_isUnit_det_toSquareBlockProp {g : D.points K}
    (hg : g ∈ D.extendedElementarySubgroup K) :
    g ∈ Set.range (D.bigCellMul K) ↔
      ∀ a : Fin (Nat.card (Set.range D.weight)),
        IsUnit (((g : Matrix.GeneralLinearGroup (Fin D.dim) K) :
          Matrix (Fin D.dim) (Fin D.dim) K).toSquareBlockProp
            fun j => orderedWeightBlock (t.weightDegree ht) D.weight j ≤ a).det := by
  refine ⟨fun h => D.isUnit_det_toSquareBlockProp_of_mem_range_bigCellMul h, fun hminor => ?_⟩
  obtain ⟨v, hv, m, hm, b, hb, rfl⟩ :=
    (D.mem_extendedElementarySubgroup_iff_exists_negativePoints_mul_mul K).mp hg
  obtain ⟨l, s, rfl⟩ := (D.mem_weylSubgroup_iff_exists_list_prod_mul_torusPoints K).mp hm
  -- The leading minors of `v * word * (t * b)` detect whether the Weyl word spells `1`.
  have hfun : (fun j => weightBlockEquiv (t.weightDegree ht) D.weight
      ⟨D.weight j, Set.mem_range_self j⟩) = orderedWeightBlock (t.weightDegree ht) D.weight :=
    funext fun j => weightBlockEquiv_mk (t.weightDegree ht) D.weight j
  let L : Matrix (Fin D.dim) (Fin D.dim) K :=
    ((v : Matrix.GeneralLinearGroup (Fin D.dim) K) : Matrix (Fin D.dim) (Fin D.dim) K)
  let U : Matrix (Fin D.dim) (Fin D.dim) K :=
    ((D.torusPoints K s * b : D.points K) : Matrix.GeneralLinearGroup (Fin D.dim) K)
  have hL : L.BlockTriangular (OrderDual.toDual ∘ fun j => weightBlockEquiv (t.weightDegree ht)
      D.weight ⟨D.weight j, Set.mem_range_self j⟩) := by
    rw [hfun]
    exact (D.blockUnitriangular_toDual_of_mem_negativePoints K hv).blockTriangular
  have hU : U.BlockTriangular fun j => weightBlockEquiv (t.weightDegree ht) D.weight
      ⟨D.weight j, Set.mem_range_self j⟩ := by
    rw [hfun]
    exact D.blockTriangular_of_mem_borelSubgroup K
      (mul_mem (D.range_torusPoints_le_borelSubgroup K ⟨s, rfl⟩) hb)
  have hLdet : IsUnit L.det := (Matrix.isUnit_iff_isUnit_det L).mp (Units.isUnit _)
  have hUdet : IsUnit U.det := (Matrix.isUnit_iff_isUnit_det U).mp (Units.isUnit _)
  have hword := (D.isUnit_leading_weight_minors_mul_weylWord_mul_iff l K
    (weightBlockEquiv (t.weightDegree ht) D.weight) L U hL hU hLdet hUdet).mp fun a => by
      -- The block predicate fixes the type of the minor and its decidability instance, so the
      -- block numbering is changed by congruence rather than by rewriting.
      convert hminor a using 4 <;>
        simp only [weightBlockEquiv_mk, L, U, mul_assoc, Subgroup.coe_mul, Units.val_mul]
  -- A Weyl word spelling `1`, followed by a torus point, is itself a torus point.
  have hproj := D.weylProjection_list_prod_mul_torusPoints K l s
  rw [hword] at hproj
  obtain ⟨s', hs'⟩ := (D.weylProjection_eq_one_iff_mem_range_torusPoints K _).mp hproj
  have hs'' : D.torusPoints K s' =
      (l.map fun i => D.weylElement (t.simpleIndex ht i) K 1).prod * D.torusPoints K s := hs'
  obtain ⟨u, hu, s₂, rfl⟩ := (D.mem_borelSubgroup_iff K).mp hb
  have hu' : D.torusPoints K s₂⁻¹ * u * (D.torusPoints K s₂⁻¹)⁻¹ ∈ D.positivePoints K :=
    (Subgroup.mem_normalizer_iff.mp
      (D.range_torusPoints_le_normalizer_positivePoints K ⟨s₂⁻¹, rfl⟩) u).mp hu
  refine (D.mem_range_bigCellMul_iff (A := K)).mpr ⟨v, hv, s' * s₂, _, hu', ?_⟩
  rw [← hs'', map_mul, map_inv]
  group

end Field

end TauCeti.DynkinType.ChevalleyDatum
