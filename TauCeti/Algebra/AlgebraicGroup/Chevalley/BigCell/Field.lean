public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Bruhat.Basic
public import TauCeti.LinearAlgebra.RootSystem.Inversions.Basic
import TauCeti.Algebra.AlgebraicGroup.Chevalley.BigCell.Triangular
import TauCeti.Algebra.AlgebraicGroup.Chevalley.Bruhat.Decomposition
