/-!
# The matrix big cell on the extended elementary Chevalley group

Over a field, a point of the group generated by the root subgroups and the actual weight-lattice
torus has invertible leading weight-block minors exactly when it has a Gauss factorization
`u₋ T(s) u₊`. Conjugating by a lift of the longest Weyl element turns ordinary Bruhat
factorization into an opposite factorization. The weight-block test then rules out every
nonidentity Weyl component via `ChevalleyDatum.isUnit_leading_weight_minors_mul_weylWord_mul_iff`.

This identifies the intersection with the matrix open on the extended elementary group. It does
not assert that the root subgroups and torus generate every point of the group scheme.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapters 3 and 5, Theorems 4 and 7.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open TauCeti.UniversalEnvelopingAlgebra

universe v

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)

attribute [local instance high] Algebra.toModule

/-- Negative Chevalley points are lower unitriangular for the same weight blocks in which
positive points are upper unitriangular. -/
theorem blockUnitriangular_toDual_of_mem_negativePoints (A : Type v) [CommRing A]
    {g : D.points A} (hg : g ∈ D.negativePoints A) :
    (g.val.val).BlockUnitriangular (OrderDual.toDual ∘ orderedWeightBlock (t.weightDegree ht)
      D.weight) := by
  rw [D.negativePoints_eq_closure] at hg
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨γ, hγ, u, rfl⟩ := hg
    rw [D.coe_rootSubgroupPoints,
      ← kostantRootSubgroupParam_chevalleySystem D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator,
      basisMatrix_kostantRootSubgroupParam]
    exact blockUnitriangular_toDual_kostantRootSubgroupMatrix (t.chevalleySystem ht)
      (t.lieBasis ht).h D.representation D.lattice
      (kostantForm_chevalleySystem_smul_mem D.representation D.lattice
        D.representation_mem_lattice D.isNilpotent_representation_rootGenerator)
      D.basis D.weight (t.weightDegree ht) γ _ D.isCartanWeightVector_basis
      (t.lie_lieBasis_h_chevalleySystem ht γ) (t.weightDegree_root_neg ht hγ) _
  | one => exact Matrix.blockUnitriangular_one
  | mul g h _ _ hg hh => exact hg.mul hh
  | inv g _ hg => simpa only [Subgroup.coe_inv, Matrix.coe_units_inv] using hg.inv

/-- Multiplication of a negative point, an actual torus point and a positive point lands in the
matrix big cell over every commutative ring. -/
theorem isUnit_leading_weight_minors_negative_torus_positive (A : Type v) [CommRing A]
    (l : D.negativePoints A) (s : Fin t.rank → Aˣ) (u : D.positivePoints A) :
    ∀ a, IsUnit (((l.val * D.torusPoints A s * u.val).val.val.toSquareBlockProp fun j =>
      orderedWeightBlock (t.weightDegree ht) D.weight j ≤ a).det) := by
  intro a
  have hL := D.blockUnitriangular_toDual_of_mem_negativePoints A l.property
  have hU := D.blockUnitriangular_of_mem_positivePoints A u.property
  have hT : (D.torusPoints A s).val.val.BlockTriangular
      (orderedWeightBlock (t.weightDegree ht) D.weight) := by
    rw [D.coe_torusPoints, kostantTorusMatrix_apply, diagGL_coe]
    exact Matrix.blockTriangular_diagonal _
  rw [Subgroup.coe_mul, Subgroup.coe_mul, Units.val_mul, Units.val_mul,
    Matrix.det_toSquareBlockProp_blockLDU hL hU (fun _ _ hji hi => hji.trans hi)]
  exact hT.isUnit_det_toSquareBlockProp (Matrix.isUnits_det_units _)
    (fun _ _ hji hi => hji.trans hi)

variable (K : Type v) [Field K]

/-- A Weyl lift which sends positive roots to negative roots conjugates the positive point
subgroup into the negative one. -/
theorem map_positivePoints_conj_le_negativePoints (n : D.weylSubgroup K)
    (hn : Set.MapsTo ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n))
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
      (negRoots (t.rationalRootSystem ht) (t.rationalBase ht))) :
    (D.positivePoints K).map (MulAut.conj (n : D.points K)).toMonoidHom ≤ D.negativePoints K := by
  rw [D.positivePoints_eq_iSup, Subgroup.map_iSup]
  refine iSup_le fun γ => ?_
  rw [Subgroup.map_iSup]
  refine iSup_le fun hγ => ?_
  rw [D.map_range_rootSubgroupPoints_conj]
  rintro _ ⟨u, rfl⟩
  exact D.rootSubgroupPoints_mem_negativePoints K (hn hγ) u

/-- Every point of the extended elementary group factors into a negative point, a Weyl lift
and a point of the positive Borel. -/
theorem exists_negativePoints_mul_weylSubgroup_mul_borelSubgroup
    (g : D.extendedElementarySubgroup K) :
    ∃ (l : D.negativePoints K) (n : D.weylSubgroup K) (b : D.borelSubgroup K),
      (g : D.points K) = l * n * b := by
  let w₀ := longestElement (t.rationalRootSystem ht) (t.rationalBase ht)
  -- Rational base change preserves the permutation of the numbered roots.
  have hbaseChange (w : (t.rationalRootSystem ht).weylGroup) :
      ∃ v : (t.simplyConnectedRootDatum ht).weylGroup,
        (t.simplyConnectedRootDatum ht).weylGroupToPerm v =
          (t.rationalRootSystem ht).weylGroupToPerm w := by
    revert w
    rw [t.rationalRootSystem_def ht]
    intro w
    exact ⟨(weylGroupBaseChangeEquiv ℚ _ _).symm w,
      weylGroupToPerm_weylGroupBaseChangeEquiv_symm ℚ _ _ w⟩
  obtain ⟨w₀', hw₀'⟩ := hbaseChange w₀
  obtain ⟨n₀, hn₀⟩ := D.weylProjection_surjective K w₀'
  have hneg : Set.MapsTo ((t.simplyConnectedRootDatum ht).weylGroupToPerm (D.weylProjection K n₀))
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
      (negRoots (t.rationalRootSystem ht) (t.rationalBase ht)) := by
    rw [hn₀, hw₀']
    exact mapsTo_posRoots_negRoots_longestElement _ _
  have h₀ := D.weylSubgroup_le_extendedElementarySubgroup K n₀.property
  obtain ⟨w, hw, _⟩ := D.existsUnique_mem_bruhatCell_of_mem_extendedElementarySubgroup K
    (mul_mem (inv_mem h₀) g.property)
  obtain ⟨n, rfl⟩ := D.weylProjection_surjective K w
  rw [D.bruhatCell_weylProjection_eq_doubleCoset_positivePoints_left K n] at hw
  obtain ⟨u, hu, b, hb, h⟩ := DoubleCoset.mem_doubleCoset.mp hw
  have hl := D.map_positivePoints_conj_le_negativePoints K n₀ hneg
    (Subgroup.mem_map_of_mem (MulAut.conj (n₀ : D.points K)).toMonoidHom hu)
  refine ⟨⟨_, hl⟩, n₀ * n, ⟨b, hb⟩, ?_⟩
  calc
    (g : D.points K) = (n₀ : D.points K) * ((n₀ : D.points K)⁻¹ * g) := by simp
    _ = (n₀ : D.points K) * (u * n * b) := by rw [h]
    _ = MulAut.conj (n₀ : D.points K) u * ((n₀ * n : D.weylSubgroup K) : D.points K) * b := by
      simp only [MulAut.conj_apply, Subgroup.coe_mul]
      group

/-- For a negative point times a Weyl lift times a positive Borel point, the leading
weight-block minors are units exactly when the Weyl lift belongs to the actual torus. -/
private theorem isUnit_leading_weight_minors_mul_weylSubgroup_mul_borelSubgroup_iff
    (l : D.negativePoints K) (n : D.weylSubgroup K) (b : D.borelSubgroup K) :
    (∀ a, IsUnit ((((l.val * n.val * b.val).val.val : Matrix _ _ K).toSquareBlockProp
      fun j => orderedWeightBlock (t.weightDegree ht) D.weight j ≤ a).det)) ↔
      n.val ∈ (D.torusPoints K).range := by
  classical
  obtain ⟨w, s, h⟩ := (D.mem_weylSubgroup_iff_exists_list_prod_mul_torusPoints K).mp n.property
  let b' : D.borelSubgroup K := ⟨D.torusPoints K s * b,
    mul_mem (D.range_torusPoints_le_borelSubgroup K ⟨s, rfl⟩) b.property⟩
  let r := weightBlockEquiv (t.weightDegree ht) D.weight
  have hr : (fun j => r ⟨D.weight j, Set.mem_range_self j⟩) =
      orderedWeightBlock (t.weightDegree ht) D.weight :=
    funext (weightBlockEquiv_mk (t.weightDegree ht) D.weight)
  have hL := D.blockUnitriangular_toDual_of_mem_negativePoints K l.property
  have hU := D.blockTriangular_of_mem_borelSubgroup K b'.property
  have htri := D.isUnit_leading_weight_minors_mul_weylWord_mul_iff w K r l.val.val.val
    b'.val.val.val (by rw [hr]; exact hL.blockTriangular) (by rwa [hr])
    (Matrix.isUnits_det_units _) (Matrix.isUnits_det_units _)
  have hmul : l.val * n.val * b.val =
      l.val * (w.map fun i => D.weylElement (t.simpleIndex ht i) K 1).prod * b'.val := by
    simp only [← h, b', mul_assoc]
  have hproj : D.weylProjection K n = t.geckWeylWordProd ht w := by
    have hn : n = ⟨_, mul_mem (D.list_prod_map_weylElement_mem_weylSubgroup K w)
        (D.torusPoints_mem_weylSubgroup K s)⟩ := Subtype.ext h.symm
    rw [hn, D.weylProjection_list_prod_mul_torusPoints]
  rw [← Subgroup.mem_subgroupOf, ← D.ker_weylProjection K, MonoidHom.mem_ker, hproj]
  rw [hmul, Subgroup.coe_mul, Subgroup.coe_mul, Units.val_mul, Units.val_mul]
  refine Iff.trans (forall_congr' fun a => ?_) htri
  rw [Matrix.equiv_block_det _
    (p := fun j => orderedWeightBlock (t.weightDegree ht) D.weight j ≤ a)
    (q := fun j => r ⟨D.weight j, Set.mem_range_self j⟩ ≤ a)
    (fun j => iff_of_eq (congrArg (· ≤ a) (congrFun hr j)))]

/-- On the extended elementary group of a Chevalley datum over a field, the matrix big cell
consists exactly of the products `u₋ T(s) u₊`. The torus parameter uses the datum's actual
character lattice. The leading minors are taken at the boundaries of the ordered weight blocks. -/
theorem isUnit_leading_weight_minors_iff_exists_negative_torus_positive
    (g : D.points K) :
    (g ∈ D.extendedElementarySubgroup K ∧ ∀ a, IsUnit ((g.val.val.toSquareBlockProp fun j =>
      orderedWeightBlock (t.weightDegree ht) D.weight j ≤ a).det)) ↔
      ∃ (l : D.negativePoints K) (s : Fin t.rank → Kˣ) (u : D.positivePoints K),
        g = (l : D.points K) * D.torusPoints K s * u := by
  constructor
  · rintro ⟨hg, h⟩
    obtain ⟨l, n, b, heq⟩ := D.exists_negativePoints_mul_weylSubgroup_mul_borelSubgroup K ⟨g, hg⟩
    rw [Subtype.coe_mk] at heq
    subst g
    obtain ⟨s, hs⟩ :=
      (D.isUnit_leading_weight_minors_mul_weylSubgroup_mul_borelSubgroup_iff K l n b).mp h
    obtain ⟨u, hu, s', hb⟩ := (D.mem_borelSubgroup_iff K).mp b.property
    have hnorm := D.range_torusPoints_le_normalizer_positivePoints K ⟨s'⁻¹, rfl⟩
    have hu' := (Subgroup.mem_normalizer_iff.mp hnorm u).mp hu
    refine ⟨l, s * s', ⟨_, hu'⟩, ?_⟩
    simp only [← hs, ← hb, map_mul, map_inv]
    group
  · rintro ⟨l, s, u, rfl⟩
    have hl : l.val ∈ D.extendedElementarySubgroup K :=
      (D.negativePoints_le_iff.mpr fun γ _ a => D.elementarySubgroup_le_extendedElementarySubgroup K
        (D.rootSubgroupPoints_mem_elementarySubgroup K γ a)) l.property
    have hb := D.positivePoints_le_borelSubgroup K u.property
    refine ⟨mul_mem (mul_mem hl (D.weylSubgroup_le_extendedElementarySubgroup K
      (D.torusPoints_mem_weylSubgroup K s))) (D.borelSubgroup_le_extendedElementarySubgroup K hb),
      D.isUnit_leading_weight_minors_negative_torus_positive K l s u⟩

end TauCeti.DynkinType.ChevalleyDatum
