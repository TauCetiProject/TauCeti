module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Opposite.Basic
import TauCeti.Algebra.AlgebraicGroup.Chevalley.Torus.Basic

/-!
# Uniqueness of Chevalley big-cell factors

For every Chevalley datum and every commutative value ring, multiplication of a negative
root element, an actual torus point, and a positive root element is injective. Here the
negative and positive factors range over the subgroups generated by all roots of the
respective sign, not just the simple roots. The torus uses coordinates in the datum's
actual character lattice, including for proper sublattices of the full weight lattice.

`ChevalleyDatum.bigCellMul` takes values in the datum's point group and commutes with ring
maps. Injectivity supplies uniqueness of factors in its image; no assertion that the image
is open, or that Weyl translates cover the group scheme, is made.

The proof uses the opposite-intersection theorems from
`TauCeti.Algebra.AlgebraicGroup.Chevalley.Opposite.Basic` and `Subgroup.mul_injective_of_disjoint`.
Those intersections follow from the triangularity of the root subgroups in a height-ordered
weight basis. The coordinate weights span the actual character lattice, making its torus
parametrization faithful even over nonreduced rings, as proved by
`ChevalleyDatum.torusPoints_injective` in
`TauCeti.Algebra.AlgebraicGroup.Chevalley.Torus.Basic`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapters 3 and 5, Theorem 7.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType.ChevalleyDatum

universe v w

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (A : Type v) [CommRing A]

/-- Multiplication of negative, actual-torus and positive factors inside the datum points.
Its image is the set of points admitting a big-cell factorization. -/
noncomputable def bigCellMul
    (x : D.negativePoints A × ((Fin t.rank → Aˣ) × D.positivePoints A)) : D.points A :=
  x.1.val * D.torusPoints A x.2.1 * x.2.2.val

/-- The big-cell multiplication uses the actual torus between the two unipotent factors. -/
theorem bigCellMul_apply
    (x : D.negativePoints A × ((Fin t.rank → Aˣ) × D.positivePoints A)) :
    D.bigCellMul A x = x.1.val * D.torusPoints A x.2.1 * x.2.2.val :=
  (rfl)

/-- A big-cell factorization determines both root-subgroup factors and the actual torus
parameter uniquely, over every commutative ring. -/
theorem bigCellMul_injective : Function.Injective (D.bigCellMul A) := by
  rintro ⟨u, s, v⟩ ⟨u', s', v'⟩ h
  have houter := Subgroup.mul_injective_of_disjoint
    (disjoint_iff.mpr (D.negativePoints_inf_positivePoints_sup_range_torusPoints_eq_bot A))
    (a₁ := (u, ⟨D.torusPoints A s * v.val,
      Subgroup.mul_mem _ (Subgroup.mem_sup_right ⟨s, rfl⟩)
        (Subgroup.mem_sup_left v.property)⟩))
    (a₂ := (u', ⟨D.torusPoints A s' * v'.val,
      Subgroup.mul_mem _ (Subgroup.mem_sup_right ⟨s', rfl⟩)
        (Subgroup.mem_sup_left v'.property)⟩))
    (by simpa only [bigCellMul_apply, mul_assoc] using h)
  have hinner := Subgroup.mul_injective_of_disjoint
    (disjoint_iff.mpr (D.positivePoints_inf_range_torusPoints_eq_bot A)).symm
    (a₁ := (⟨D.torusPoints A s, ⟨s, rfl⟩⟩, v))
    (a₂ := (⟨D.torusPoints A s', ⟨s', rfl⟩⟩, v'))
    (congrArg (fun x => x.2.val) houter)
  have hu := congrArg Prod.fst houter
  have hs := D.torusPoints_injective A (congrArg (fun x => x.1.val) hinner)
  have hv := congrArg Prod.snd hinner
  exact Prod.ext hu (Prod.ext hs hv)

/-- The identity factors multiply to the identity point. -/
@[simp]
theorem bigCellMul_one : D.bigCellMul A 1 = 1 := by
  simp only [bigCellMul_apply, Prod.fst_one, Prod.snd_one, OneMemClass.coe_one,
    map_one, mul_one]

variable {A}

/-- Equality of big-cell products is equality of their three factors. -/
@[simp]
theorem bigCellMul_inj
    {x y : D.negativePoints A × ((Fin t.rank → Aˣ) × D.positivePoints A)} :
    D.bigCellMul A x = D.bigCellMul A y ↔ x = y :=
  (D.bigCellMul_injective A).eq_iff

/-- A big-cell product is the identity exactly when all three factors are identities. -/
@[simp]
theorem bigCellMul_eq_one
    {x : D.negativePoints A × ((Fin t.rank → Aˣ) × D.positivePoints A)} :
    D.bigCellMul A x = 1 ↔ x = 1 :=
  (D.bigCellMul_injective A).eq_iff' (D.bigCellMul_one A)

/-- A point is in the big-cell image exactly when it admits three such factors. -/
theorem mem_range_bigCellMul_iff {g : D.points A} :
    g ∈ Set.range (D.bigCellMul A) ↔
      ∃ u ∈ D.negativePoints A, ∃ s : Fin t.rank → Aˣ,
        ∃ v ∈ D.positivePoints A, u * D.torusPoints A s * v = g := by
  constructor
  · rintro ⟨⟨u, s, v⟩, h⟩
    exact ⟨u.val, u.property, s, v.val, v.property, h⟩
  · rintro ⟨u, hu, s, v, hv, h⟩
    exact ⟨(⟨u, hu⟩, s, ⟨v, hv⟩), h⟩

/-- Equality of negative-torus-positive products determines each factor. -/
theorem eq_of_negativePoints_mul_torusPoints_mul_positivePoints_eq
    {u u' v v' : D.points A}
    (hu : u ∈ D.negativePoints A) (hu' : u' ∈ D.negativePoints A)
    (hv : v ∈ D.positivePoints A) (hv' : v' ∈ D.positivePoints A)
    {s s' : Fin t.rank → Aˣ}
    (h : u * D.torusPoints A s * v = u' * D.torusPoints A s' * v') :
    u = u' ∧ s = s' ∧ v = v' := by
  have heq := D.bigCellMul_injective A
    (a₁ := (⟨u, hu⟩, s, ⟨v, hv⟩)) (a₂ := (⟨u', hu'⟩, s', ⟨v', hv'⟩)) h
  exact ⟨congrArg (fun x => x.1.val) heq, congrArg (fun x => x.2.1) heq,
    congrArg (fun x => x.2.2.val) heq⟩

/-- Ring maps preserve big-cell multiplication and each of its three factors. -/
@[simp]
theorem map_bigCellMul {B : Type w} [CommRing B] (f : A →+* B)
    (x : D.negativePoints A × ((Fin t.rank → Aˣ) × D.positivePoints A)) :
    (D.pointsPresentation A).map (D.pointsPresentation B) f (D.bigCellMul A x) =
      D.bigCellMul B (D.mapNegativePoints f x.1,
        (fun i => Units.map f.toMonoidHom (x.2.1 i)), D.mapPositivePoints f x.2.2) := by
  simp only [bigCellMul_apply, map_mul, D.map_torusPoints,
    D.coe_mapNegativePoints_apply, D.coe_mapPositivePoints_apply]

end TauCeti.DynkinType.ChevalleyDatum
