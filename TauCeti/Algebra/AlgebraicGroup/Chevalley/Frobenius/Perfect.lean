module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Frobenius.Basic
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.HopfIdealPoints.Equiv
public import Mathlib.FieldTheory.Perfect

/-!
# Frobenius automorphisms of perfect-valued Chevalley points

Over a perfect commutative ring of exponential characteristic `p`, every iterated Frobenius
of a Chevalley datum's entire point group is an automorphism. Its inverse applies the unique
`p ^ k`-th root map entrywise, on every root parameter, and on the actual character-lattice
torus. These inverse maps are natural under arbitrary homomorphisms of perfect value rings.
No point-generation theorem, field assumption, or restriction on the weight lattice is needed.

This gives the invertibility input for exceptional point isogenies: an endomorphism whose
square is Frobenius is bijective over a perfect field. Perfection is essential; the assertion
is not made for a general value ring of positive characteristic.

The construction lifts Mathlib's `iterateFrobeniusEquiv` through
`GeneralLinear.IntegralPointsPresentation.mapEquiv`. Thus the inverse preserves the integral
defining equations, rather than only the subgroup generated by root elements.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 10, Theorem 28.
* R. W. Carter, *Finite Groups of Lie Type: Conjugacy Classes and Complex Characters*, §1.17.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v v'

noncomputable section

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (p k : ℕ) (A : Type v) [CommRing A] [ExpChar A p] [PerfectRing A p]

/-- The `p ^ k`-power Frobenius automorphism of all perfect-valued points of a Chevalley datum. -/
def frobeniusEquiv : D.points A ≃* D.points A :=
  (D.pointsPresentation A).mapEquiv (D.pointsPresentation A) (iterateFrobeniusEquiv A p k)

/-- The forward map of the Frobenius automorphism is the Frobenius endomorphism. -/
@[simp]
theorem frobeniusEquiv_apply (g : D.points A) :
    D.frobeniusEquiv p k A g = D.frobenius p k A g := by
  rw [frobeniusEquiv, GeneralLinear.IntegralPointsPresentation.mapEquiv_apply, frobenius_def]
  apply congrArg (fun f : A →+* A =>
    (D.pointsPresentation A).map (D.pointsPresentation A) f g)
  ext x
  simp

/-- Inverse Frobenius is induced by the inverse Frobenius of the coefficient ring. -/
theorem frobeniusEquiv_symm_apply (g : D.points A) :
    (D.frobeniusEquiv p k A).symm g =
      (D.pointsPresentation A).map (D.pointsPresentation A)
        (iterateFrobeniusEquiv A p k).symm.toRingHom g := by
  rw [frobeniusEquiv, GeneralLinear.IntegralPointsPresentation.mapEquiv_symm,
    GeneralLinear.IntegralPointsPresentation.mapEquiv_apply]

/-- Every iterated Frobenius on perfect-valued Chevalley points is bijective. -/
theorem frobenius_bijective : Function.Bijective (D.frobenius p k A) := by
  have h : ⇑(D.frobeniusEquiv p k A) = D.frobenius p k A :=
    funext (D.frobeniusEquiv_apply p k A)
  rw [← h]
  exact (D.frobeniusEquiv p k A).bijective

-- Cancel before the root and torus parameter formulas rewrite the inner point.
/-- Frobenius cancels its inverse on every point. -/
@[simp↓]
theorem frobenius_frobeniusEquiv_symm (g : D.points A) :
    D.frobenius p k A ((D.frobeniusEquiv p k A).symm g) = g := by
  simpa only [frobeniusEquiv_apply] using (D.frobeniusEquiv p k A).apply_symm_apply g

/-- Inverse Frobenius cancels Frobenius on every point. -/
@[simp↓]
theorem frobeniusEquiv_symm_frobenius (g : D.points A) :
    (D.frobeniusEquiv p k A).symm (D.frobenius p k A g) = g := by
  simpa only [frobeniusEquiv_apply] using (D.frobeniusEquiv p k A).symm_apply_apply g

/-- Inverse Frobenius takes the unique `p ^ k`-th root of each matrix entry. -/
@[simp]
theorem coe_frobeniusEquiv_symm (g : D.points A) :
    ((D.frobeniusEquiv p k A).symm g : Matrix.GeneralLinearGroup (Fin D.dim) A) =
      Matrix.GeneralLinearGroup.map (iterateFrobeniusEquiv A p k).symm.toRingHom g := by
  rw [frobeniusEquiv_symm_apply, GeneralLinear.IntegralPointsPresentation.coe_map]

/-- Inverse Frobenius takes the unique `p ^ k`-th root of every root parameter, including
negative and nonsimple roots. -/
@[simp]
theorem frobeniusEquiv_symm_rootSubgroupPoints (γ : Fin t.numRoots) (u : A) :
    (D.frobeniusEquiv p k A).symm (D.rootSubgroupPoints γ A (Multiplicative.ofAdd u)) =
      D.rootSubgroupPoints γ A
        (Multiplicative.ofAdd ((iterateFrobeniusEquiv A p k).symm u)) := by
  rw [frobeniusEquiv_symm_apply, map_rootSubgroupPoints, toAdd_ofAdd]
  simp only [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]

/-- Inverse Frobenius acts coordinatewise on the actual weight-lattice torus. -/
@[simp]
theorem frobeniusEquiv_symm_torusPoints (s : Fin t.rank → Aˣ) :
    (D.frobeniusEquiv p k A).symm (D.torusPoints A s) =
      D.torusPoints A (fun i =>
        Units.map (iterateFrobeniusEquiv A p k).symm.toMonoidHom (s i)) := by
  rw [frobeniusEquiv_symm_apply, map_torusPoints]

/-- The zeroth Frobenius automorphism is the identity. -/
@[simp]
theorem frobeniusEquiv_zero : D.frobeniusEquiv p 0 A = MulEquiv.refl _ := by
  ext g
  simp

/-- Adding Frobenius iteration indices composes the automorphisms. -/
theorem frobeniusEquiv_add (m : ℕ) :
    D.frobeniusEquiv p (k + m) A =
      (D.frobeniusEquiv p m A).trans (D.frobeniusEquiv p k A) := by
  ext g
  simp [frobenius_add]

/-- Inverse Frobenius commutes with any homomorphism between perfect value rings of the same
exponential characteristic, including noninjective maps and maps between different universes. -/
theorem map_frobeniusEquiv_symm {B : Type v'} [CommRing B] [ExpChar B p] [PerfectRing B p]
    (f : A →+* B) (g : D.points A) :
    (D.pointsPresentation A).map (D.pointsPresentation B) f
        ((D.frobeniusEquiv p k A).symm g) =
      (D.frobeniusEquiv p k B).symm
        ((D.pointsPresentation A).map (D.pointsPresentation B) f g) := by
  apply (D.frobenius_bijective p k B).injective
  rw [← map_frobenius]
  simp only [← frobeniusEquiv_apply, MulEquiv.apply_symm_apply]

end

end TauCeti.DynkinType.ChevalleyDatum
