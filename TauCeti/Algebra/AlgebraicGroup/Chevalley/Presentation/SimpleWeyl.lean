/-!
# Simple Weyl elements of Steinberg's presented group

For a valid Dynkin type `t`, a commutative ring `A` and a simple root `αᵢ`, let `St` be the group
presented by Steinberg's relations, `Û` its positive subgroup and `Û⁽ⁱ⁾` the subgroup generated by
the generators `X_γ(u)` at the positive roots `γ ≠ αᵢ`. This file proves, inside `St` itself:

* `Û⁽ⁱ⁾` is normalized by `Û` and by the generators `X_{-αᵢ}(u)` of the negative simple root, hence
  by Steinberg's Weyl element `W_{αᵢ}(s) = X_{αᵢ}(s) X_{-αᵢ}(-s⁻¹) X_{αᵢ}(s)`;
* every element of `Û` factors as `v X_{αᵢ}(u)` with `v ∈ Û⁽ⁱ⁾`;
* for every positive root `γ ≠ αᵢ`, Steinberg's relation

  ```text
  W_{αᵢ}(s) X_γ(u) W_{αᵢ}(s)⁻¹ = X_{sᵢγ}(s ^ ⟨sᵢγ, αᵢ^∨⟩ ε u),
  ```

  with `sᵢγ` the reflection of `γ` in `αᵢ` and `ε = ±1` the sign
  `TauCeti.DynkinType.chevalleyWeylSign` of the pinned Chevalley system.

The normalization by `Û` and the conjugation relation are transported from the simply connected
Chevalley group `G_sc(t)`, where they hold by
`TauCeti.DynkinType.ChevalleyDatum.positivePoints_le_normalizer_puncturedPositivePoints` and
`TauCeti.DynkinType.ChevalleyDatum.weylElement_simpleIndex_conj_rootSubgroupPoints`, through
Steinberg's homomorphism, which is injective on `Û`
(`TauCeti.DynkinType.injOn_steinbergLift_steinbergPositiveSubgroup`). The negative simple root
generators do not lie in `Û`, so their normalization is read off the commutator relators
directly: for a positive root `γ ≠ αᵢ` every root `-jαᵢ + kγ` with `j, k > 0` is again positive and
different from `αᵢ`, and the commutator lies in the subgroup generated by the generators at these
roots, by `TauCeti.DynkinType.commutatorElement_mem_of_root_eq_add`.

All statements hold over every commutative ring. In Steinberg's proof that his relations present
the simply connected Chevalley group over a field, these are the identities that make the simple
Weyl elements of the presented group act on its positive part as in the Chevalley group.

## Main definitions

All declarations are in the namespace `TauCeti.DynkinType`.

* `steinbergPuncturedPositiveSubgroup`: the subgroup `Û⁽ⁱ⁾`.

## Main results

* `steinbergPositiveSubgroup_le_normalizer_steinbergPuncturedPositiveSubgroup`:
  `Û` normalizes `Û⁽ⁱ⁾`.
* `closure_steinbergSimpleRootPair_le_normalizer_steinbergPuncturedPositiveSubgroup`:
  the generators at `±αᵢ` normalize `Û⁽ⁱ⁾`.
* `steinbergWeylElement_simpleIndex_mem_normalizer_steinbergPuncturedPositiveSubgroup`:
  so does `W_{αᵢ}(s)`.
* `range_steinbergRootSubgroup_simpleIndex_le_normalizer_steinbergPuncturedPositiveSubgroup`:
  the generators at `αᵢ` normalize `Û⁽ⁱ⁾`.
* `mem_steinbergPositiveSubgroup_iff_exists_mul_steinbergRootSubgroup`: the
  factorization `Û = Û⁽ⁱ⁾ X_{αᵢ}`.
* `steinbergWeylElement_simpleIndex_conj_steinbergRootSubgroup`: Steinberg's
  conjugation relation for `W_{αᵢ}(s)` at the positive roots `γ ≠ αᵢ`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 17 and 20, and Chapter 6, proof
  of Theorem 8.
* R. W. Carter, *Simple Groups of Lie Type*, Chapter 12.
-/

public section

open scoped commutatorElement
open Multiplicative

namespace TauCeti.DynkinType

universe u

/-! ## The punctured positive subgroup -/

section Definition

variable (t : DynkinType) (ht : t.Valid) (A : Type u) [CommRing A]

/-- **The punctured positive subgroup `Û⁽ⁱ⁾`** of Steinberg's presented group: the subgroup
generated by the generators `X_γ(u)` at the positive roots `γ` other than the simple root `αᵢ`. -/
noncomputable def steinbergPuncturedPositiveSubgroup (i : Fin t.rank) :
    Subgroup (PresentedGroup (t.steinbergRelators ht A)) :=
  t.steinbergSubsystemSubgroup ht A
    (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})

/-- The punctured positive subgroup is the join of the ranges of the positive root generators
other than the one at `αᵢ`. -/
theorem steinbergPuncturedPositiveSubgroup_def (i : Fin t.rank) :
    t.steinbergPuncturedPositiveSubgroup ht A i =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (t.steinbergRootSubgroup ht A γ).range :=
  t.steinbergSubsystemSubgroup_def ht A _

variable {t ht A} in
/-- Each generator at a positive root other than `αᵢ` lies in the punctured positive subgroup. -/
theorem steinbergRootSubgroup_mem_steinbergPuncturedPositiveSubgroup {i : Fin t.rank}
    {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
    (a : Multiplicative A) :
    t.steinbergRootSubgroup ht A γ a ∈ t.steinbergPuncturedPositiveSubgroup ht A i :=
  steinbergRootSubgroup_mem_steinbergSubsystemSubgroup hγ a

variable {t ht A} in
/-- Containment of the punctured positive subgroup can be checked on the positive root generators
other than the one at `αᵢ`. -/
theorem steinbergPuncturedPositiveSubgroup_le_iff {i : Fin t.rank}
    {H : Subgroup (PresentedGroup (t.steinbergRelators ht A))} :
    t.steinbergPuncturedPositiveSubgroup ht A i ≤ H ↔
      ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}, ∀ a,
        t.steinbergRootSubgroup ht A γ a ∈ H :=
  steinbergSubsystemSubgroup_le_iff

/-- The punctured positive subgroup lies in the positive subgroup. -/
theorem steinbergPuncturedPositiveSubgroup_le_steinbergPositiveSubgroup (i : Fin t.rank) :
    t.steinbergPuncturedPositiveSubgroup ht A i ≤ t.steinbergPositiveSubgroup ht A :=
  steinbergPuncturedPositiveSubgroup_le_iff.mpr fun _ hγ a =>
    steinbergRootSubgroup_mem_steinbergPositiveSubgroup hγ.1 a

/-- The positive subgroup is generated by the punctured positive subgroup and the generators at
the simple root `αᵢ`. -/
theorem steinbergPositiveSubgroup_eq_steinbergPuncturedPositiveSubgroup_sup (i : Fin t.rank) :
    t.steinbergPositiveSubgroup ht A =
      t.steinbergPuncturedPositiveSubgroup ht A i ⊔
        (t.steinbergRootSubgroup ht A (t.simpleIndex ht i)).range := by
  rw [steinbergPuncturedPositiveSubgroup_def]
  conv_lhs => rw [steinbergPositiveSubgroup_def, posRoots_eq_diff_union_simpleIndex i, iSup_union,
    iSup_singleton]

end Definition

variable {t : DynkinType} {ht : t.Valid} {A : Type u} [CommRing A]

/-! ## Normalization by the positive subgroup -/

namespace ChevalleyDatum

variable (D : ChevalleyDatum t ht) (A)

/-- **Steinberg's homomorphism maps `Û⁽ⁱ⁾` onto the punctured positive points** of every
Chevalley datum, the subgroup generated by the root subgroups at the positive roots `γ ≠ αᵢ`. -/
@[simp]
theorem map_steinbergLift_steinbergPuncturedPositiveSubgroup (i : Fin t.rank) :
    (t.steinbergPuncturedPositiveSubgroup ht A i).map (D.steinbergLift A) =
      D.puncturedPositivePoints A i := by
  rw [puncturedPositivePoints_def]
  exact D.map_steinbergLift_steinbergSubsystemSubgroup A _

end ChevalleyDatum

/-- Conjugation by an element of `Û` keeps `Û⁽ⁱ⁾`: the image in `G_sc(t)` lies in the punctured
positive points, and is the image of an element of `Û⁽ⁱ⁾`, by injectivity the conjugate itself. -/
private theorem mul_mul_inv_mem_steinbergPuncturedPositiveSubgroup (i : Fin t.rank)
    {x : PresentedGroup (t.steinbergRelators ht A)} (hx : x ∈ t.steinbergPositiveSubgroup ht A)
    {g : PresentedGroup (t.steinbergRelators ht A)}
    (hg : g ∈ t.steinbergPuncturedPositiveSubgroup ht A i) :
    x * g * x⁻¹ ∈ t.steinbergPuncturedPositiveSubgroup ht A i := by
  let D := t.scChevalleyDatum ht
  have hle := t.steinbergPuncturedPositiveSubgroup_le_steinbergPositiveSubgroup ht A i
  have hxG : D.steinbergLift A x ∈ D.positivePoints A := by
    rw [← D.map_steinbergLift_steinbergPositiveSubgroup A]
    exact ⟨x, hx, rfl⟩
  have hgG : D.steinbergLift A g ∈
      (t.steinbergPuncturedPositiveSubgroup ht A i).map (D.steinbergLift A) := ⟨g, hg, rfl⟩
  have himage : D.steinbergLift A (x * g * x⁻¹) ∈
      (t.steinbergPuncturedPositiveSubgroup ht A i).map (D.steinbergLift A) := by
    rw [D.map_steinbergLift_steinbergPuncturedPositiveSubgroup A i] at hgG ⊢
    rw [map_mul, map_mul, map_inv]
    exact (Subgroup.mem_normalizer_iff.mp
      (D.positivePoints_le_normalizer_puncturedPositivePoints A i hxG) _).mp hgG
  obtain ⟨g', hg', he⟩ := himage
  rwa [← injOn_steinbergLift_steinbergPositiveSubgroup A (hle hg')
    (mul_mem (mul_mem hx (hle hg)) (inv_mem hx)) he]

/-- **The positive subgroup `Û` normalizes the punctured positive subgroup `Û⁽ⁱ⁾`**, over every
commutative ring. -/
theorem steinbergPositiveSubgroup_le_normalizer_steinbergPuncturedPositiveSubgroup
    (i : Fin t.rank) :
    t.steinbergPositiveSubgroup ht A ≤
      Subgroup.normalizer (t.steinbergPuncturedPositiveSubgroup ht A i : Set _) := by
  intro x hx
  refine Subgroup.mem_normalizer_iff.mpr fun g =>
    ⟨mul_mul_inv_mem_steinbergPuncturedPositiveSubgroup i hx, fun h => ?_⟩
  simpa only [inv_inv, mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using
    mul_mul_inv_mem_steinbergPuncturedPositiveSubgroup i (inv_mem hx) h

/-- **The generators at `αᵢ` normalize `Û⁽ⁱ⁾`**, as they lie in `Û`. -/
theorem range_steinbergRootSubgroup_simpleIndex_le_normalizer_steinbergPuncturedPositiveSubgroup
    (i : Fin t.rank) :
    (t.steinbergRootSubgroup ht A (t.simpleIndex ht i)).range ≤
      Subgroup.normalizer (t.steinbergPuncturedPositiveSubgroup ht A i : Set _) := by
  refine le_trans ?_ (steinbergPositiveSubgroup_le_normalizer_steinbergPuncturedPositiveSubgroup i)
  rw [steinbergPositiveSubgroup_eq_steinbergPuncturedPositiveSubgroup_sup t ht A i]
  exact le_sup_right

/-- **Factorization along a simple root.** Every element of `Û` is a product `v X_{αᵢ}(u)` with
`v ∈ Û⁽ⁱ⁾`. No uniqueness of the factors is asserted. -/
theorem mem_steinbergPositiveSubgroup_iff_exists_mul_steinbergRootSubgroup (i : Fin t.rank)
    (g : PresentedGroup (t.steinbergRelators ht A)) :
    g ∈ t.steinbergPositiveSubgroup ht A ↔
      ∃ v ∈ t.steinbergPuncturedPositiveSubgroup ht A i, ∃ u : Multiplicative A,
        g = v * t.steinbergRootSubgroup ht A (t.simpleIndex ht i) u := by
  rw [steinbergPositiveSubgroup_eq_steinbergPuncturedPositiveSubgroup_sup t ht A i,
    Subgroup.mem_sup_of_right_le_normalizer_left]
  · simp only [MonoidHom.mem_range, exists_exists_eq_and]
    exact exists_congr fun _ => and_congr_right' (exists_congr fun _ => eq_comm)
  · exact range_steinbergRootSubgroup_simpleIndex_le_normalizer_steinbergPuncturedPositiveSubgroup i

/-! ## Normalization by the negative simple root -/

/-- A generator at a positive root other than `αᵢ`, written as the class of a letter, lies in
`Û⁽ⁱ⁾`. -/
private theorem mk_steinbergRoot_mem_steinbergPuncturedPositiveSubgroup {i : Fin t.rank}
    {δ : Fin t.numRoots}
    (hδ : δ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
    (w : A) :
    PresentedGroup.mk (t.steinbergRelators ht A) (steinbergRoot δ w) ∈
      t.steinbergPuncturedPositiveSubgroup ht A i := by
  have h := steinbergRootSubgroup_mem_steinbergPuncturedPositiveSubgroup hδ (ofAdd w)
  rwa [steinbergRootSubgroup_ofAdd] at h

/-- Generators whose roots sum to neither a root nor zero have trivial commutator, which lies in
`Û⁽ⁱ⁾`. -/
private theorem commutatorElement_mem_of_root_add_notMem_range {i : Fin t.rank}
    {β γ : Fin t.numRoots}
    (hsum : (t.simplyConnectedRootDatum ht).root β + (t.simplyConnectedRootDatum ht).root γ ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (h₀ : (t.simplyConnectedRootDatum ht).root β + (t.simplyConnectedRootDatum ht).root γ ≠ 0)
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A β (ofAdd u), t.steinbergRootSubgroup ht A γ (ofAdd v)⁆ ∈
      t.steinbergPuncturedPositiveSubgroup ht A i := by
  rw [commutatorElement_eq_one_of_root_add_notMem_range hsum h₀ u v]
  exact Subgroup.one_mem _

/-- If `-αᵢ + γ` is a root for a positive root `γ ≠ αᵢ`, the commutator of the generators at `-αᵢ`
and `γ` lies in `Û⁽ⁱ⁾`: the roots `-jαᵢ + kγ` with `j, k > 0` are positive and different from
`αᵢ`. -/
private theorem commutatorElement_neg_simpleIndex_mem_of_root_eq_add (i : Fin t.rank)
    {γ δ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
    (hδ : (t.simplyConnectedRootDatum ht).root δ = (t.simplyConnectedRootDatum ht).root
      ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) (t.simpleIndex ht i)) +
        (t.simplyConnectedRootDatum ht).root γ)
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) (ofAdd u),
      t.steinbergRootSubgroup ht A γ (ofAdd v)⁆ ∈ t.steinbergPuncturedPositiveSubgroup ht A i := by
  set β := (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) (t.simpleIndex ht i)
  have hδQ : (t.rationalRootSystem ht).root δ =
      (t.rationalRootSystem ht).root β + (t.rationalRootSystem ht).root γ := by
    simpa only [one_nsmul] using
      (t.root_rationalRootSystem_eq_nsmul_add_iff ht β γ δ 1).mpr (by rwa [one_nsmul])
  have hβ : (t.rationalRootSystem ht).reflectionPerm (t.simpleIndex ht i) (t.simpleIndex ht i) =
      β := by
    rw [reflectionPerm_rationalRootSystem]
  have hlin := (t.rationalRootSystem ht).linearIndependent_of_add_mem_range_root' ⟨δ, hδQ⟩
  rw [← hβ] at hlin
  exact commutatorElement_mem_of_root_eq_add hδ (fun _ _ _ _ hk hε => by
    rw [← hβ] at hε
    exact mk_steinbergRoot_mem_steinbergPuncturedPositiveSubgroup
      ⟨mem_posRoots_of_root_eq_nsmul_reflectionPerm_self_add (simpleIndex_mem_support i) hγ hlin
        hk hε, ne_of_root_eq_nsmul_reflectionPerm_self_add hlin hk hε⟩) u v

/-- The commutator of a generator at `-αᵢ` with one at a positive root `γ ≠ αᵢ` lies in `Û⁽ⁱ⁾`. -/
private theorem commutatorElement_neg_simpleIndex_mem (i : Fin t.rank) {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) (ofAdd u),
      t.steinbergRootSubgroup ht A γ (ofAdd v)⁆ ∈ t.steinbergPuncturedPositiveSubgroup ht A i := by
  let R := t.simplyConnectedRootDatum ht
  by_cases hsum : R.root (R.reflectionPerm (t.simpleIndex ht i) (t.simpleIndex ht i)) +
      R.root γ ∈ Set.range R.root
  · obtain ⟨δ, hδ⟩ := hsum
    exact commutatorElement_neg_simpleIndex_mem_of_root_eq_add i hγ hδ u v
  · -- Without a root sum the generators commute; the sum is not zero as `γ ≠ αᵢ`.
    refine commutatorElement_mem_of_root_add_notMem_range hsum (fun h => hγ.2 ?_) u v
    rw [RootPairing.root_reflectionPerm_self] at h
    exact R.root.injective (neg_add_eq_zero.mp h).symm

/-- **The generators at `-αᵢ` normalize `Û⁽ⁱ⁾`**, over every commutative ring. -/
theorem range_steinbergRootSubgroup_neg_simpleIndex_le_normalizer_steinbergPuncturedPositiveSubgroup
    (i : Fin t.rank) :
    (t.steinbergRootSubgroup ht A ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i))).range ≤
      Subgroup.normalizer (t.steinbergPuncturedPositiveSubgroup ht A i : Set _) := by
  rw [steinbergPuncturedPositiveSubgroup_def, ← iSup_subtype'']
  apply Subgroup.le_normalizer_iSup_of_commutator_le
  intro γ
  refine Subgroup.commutator_le.mpr fun _ ⟨x, hx⟩ _ ⟨y, hy⟩ => ?_
  subst hx hy
  have h := commutatorElement_neg_simpleIndex_mem i γ.property x.toAdd y.toAdd
  rw [steinbergPuncturedPositiveSubgroup_def] at h
  simpa only [iSup_subtype, ofAdd_toAdd] using h

/-- **The generators at `±αᵢ` normalize the punctured positive subgroup `Û⁽ⁱ⁾`**, over every
commutative ring. -/
theorem closure_steinbergSimpleRootPair_le_normalizer_steinbergPuncturedPositiveSubgroup
    (i : Fin t.rank) :
    Subgroup.closure (Set.range (t.steinbergRootSubgroup ht A (t.simpleIndex ht i)) ∪
        Set.range (t.steinbergRootSubgroup ht A ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)))) ≤
      Subgroup.normalizer (t.steinbergPuncturedPositiveSubgroup ht A i : Set _) := by
  rw [← MonoidHom.coe_range, ← MonoidHom.coe_range, ← Subgroup.sup_eq_closure]
  exact sup_le
    (range_steinbergRootSubgroup_simpleIndex_le_normalizer_steinbergPuncturedPositiveSubgroup i)
    (range_steinbergRootSubgroup_neg_simpleIndex_le_normalizer_steinbergPuncturedPositiveSubgroup i)

/-! ## Conjugation by simple Weyl elements -/

/-- **Steinberg's simple Weyl element `W_{αᵢ}(s)` normalizes `Û⁽ⁱ⁾`**, for every unit `s`. -/
theorem steinbergWeylElement_simpleIndex_mem_normalizer_steinbergPuncturedPositiveSubgroup
    (i : Fin t.rank) (s : Aˣ) :
    t.steinbergWeylElement ht A (t.simpleIndex ht i) s ∈
      Subgroup.normalizer (t.steinbergPuncturedPositiveSubgroup ht A i : Set _) := by
  apply closure_steinbergSimpleRootPair_le_normalizer_steinbergPuncturedPositiveSubgroup i
  rw [steinbergWeylElement_eq]
  exact mul_mem (mul_mem (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))
    (Subgroup.subset_closure (Or.inr ⟨_, rfl⟩))) (Subgroup.subset_closure (Or.inl ⟨_, rfl⟩))

/-- **Steinberg's conjugation relation for a simple Weyl element** in the presented group. For a
positive root `γ ≠ αᵢ`, a unit `s` and every `u`,
`W_{αᵢ}(s) X_γ(u) W_{αᵢ}(s)⁻¹ = X_{sᵢγ}(s ^ ⟨sᵢγ, αᵢ^∨⟩ ε u)`, where `sᵢγ` is the reflection of `γ`
in `αᵢ` and `ε = ±1` is the sign `TauCeti.DynkinType.chevalleyWeylSign` of the pinned Chevalley
system. This holds over every commutative ring. -/
theorem steinbergWeylElement_simpleIndex_conj_steinbergRootSubgroup (i : Fin t.rank)
    {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
    (s : Aˣ) (u : A) :
    t.steinbergWeylElement ht A (t.simpleIndex ht i) s * t.steinbergRootSubgroup ht A γ (ofAdd u) *
        (t.steinbergWeylElement ht A (t.simpleIndex ht i) s)⁻¹ =
      t.steinbergRootSubgroup ht A
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ)
        (ofAdd (((s ^ (t.simplyConnectedRootDatum ht).pairing
            ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ)
            (t.simpleIndex ht i) : Aˣ) : A) *
          (((t.chevalleyWeylSign ht (t.simpleIndex ht i) γ : ℤ) : A) * u))) := by
  have hle := t.steinbergPuncturedPositiveSubgroup_le_steinbergPositiveSubgroup ht A i
  have hrefl : (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ ∈
      posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i} := by
    rw [← reflectionPerm_rationalRootSystem,
      reflectionPerm_mem_posRoots_diff_singleton_iff _ _ (simpleIndex_mem_support i)]
    exact hγ
  refine injOn_steinbergLift_steinbergPositiveSubgroup A
    (hle ((Subgroup.mem_normalizer_iff.mp
      (steinbergWeylElement_simpleIndex_mem_normalizer_steinbergPuncturedPositiveSubgroup i s) _).mp
        (steinbergRootSubgroup_mem_steinbergPuncturedPositiveSubgroup hγ _)))
    (hle (steinbergRootSubgroup_mem_steinbergPuncturedPositiveSubgroup hrefl _)) ?_
  simp only [map_mul, map_inv, ChevalleyDatum.steinbergLift_steinbergWeylElement,
    steinbergRootSubgroup_apply, ChevalleyDatum.steinbergLift_of, toAdd_ofAdd]
  exact (t.scChevalleyDatum ht).weylElement_simpleIndex_conj_rootSubgroupPoints γ A i s u

end TauCeti.DynkinType
