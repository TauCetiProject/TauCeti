public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Presentation
public import TauCeti.Algebra.Group.RankOne.Bruhat

/-!
# Rank-one collection in Steinberg's presented group

The Weyl and coroot words in Steinberg's presented group satisfy the rank-one identities,
including the Weyl square and the exchange identity. Consequently, over a field the subgroup
generated by an opposite root pair has the two Bruhat forms `X(a) H(s)` and
`X(a) H(s) W(1) X(b)`.

These identities are proved from the defining relators, not pulled back from a represented
Chevalley group. They provide the rank-one word reduction needed to prove injectivity of
`ChevalleyDatum.steinbergLift`. No injectivity or uniqueness of the two forms is asserted here.
The collection step uses `MonoidHom.mem_closure_rankOne_iff`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19–20, and Chapter 6,
  proof of Theorem 8.
* R. W. Carter, *Simple Groups of Lie Type*, §6.4.
-/

public section

namespace TauCeti.DynkinType

open Multiplicative

noncomputable section

variable (t : DynkinType) (ht : t.Valid) (A : Type*) [CommRing A]

/-- The Weyl word `W_γ(s)` in Steinberg's presented group. -/
def steinbergWeylElement (γ : Fin t.numRoots) (s : Aˣ) :
    PresentedGroup (t.steinbergRelators ht A) :=
  PresentedGroup.mk _ (steinbergWeylWord ht γ s)

/-- The Weyl word is the product of three opposite-root elements. -/
theorem steinbergWeylElement_def (γ : Fin t.numRoots) (s : Aˣ) :
    t.steinbergWeylElement ht A γ s =
      t.steinbergRootSubgroup ht A γ (ofAdd (s : A)) *
        t.steinbergRootSubgroup ht A
          ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ)
          (ofAdd (-((s⁻¹ : Aˣ) : A))) *
        t.steinbergRootSubgroup ht A γ (ofAdd (s : A)) := by
  simp [steinbergWeylElement, steinbergWeylWord_def, steinbergRoot, PresentedGroup.of]

/-- The coroot word `H_γ(s) = W_γ(s) W_γ(1)⁻¹`, bundled using the coroot relators. -/
def steinbergCoroot (γ : Fin t.numRoots) :
    Aˣ →* PresentedGroup (t.steinbergRelators ht A) :=
  MonoidHom.mk' (fun s => t.steinbergWeylElement ht A γ s *
    (t.steinbergWeylElement ht A γ 1)⁻¹) fun s s' => by
      have h := PresentedGroup.one_of_mem (rels := t.steinbergRelators ht A)
        ((mem_steinbergRelators t ht A).mpr (IsSteinbergRelator.coroot_mul γ s s'))
      simp only [map_mul, map_inv, mul_inv_eq_one] at h
      simpa only [steinbergWeylElement] using h.symm

/-- A coroot value is the quotient of Weyl words at `s` and at `1`. -/
theorem steinbergCoroot_apply (γ : Fin t.numRoots) (s : Aˣ) :
    t.steinbergCoroot ht A γ s = t.steinbergWeylElement ht A γ s *
      (t.steinbergWeylElement ht A γ 1)⁻¹ := (rfl)

variable {t ht A}

/-- Negating the Weyl parameter inverts the Weyl word. -/
@[simp]
theorem steinbergWeylElement_neg (γ : Fin t.numRoots) (s : Aˣ) :
    t.steinbergWeylElement ht A γ (-s) = (t.steinbergWeylElement ht A γ s)⁻¹ := by
  simp only [steinbergWeylElement_def, inv_neg, Units.val_neg, mul_inv_rev,
    ← map_inv, ← ofAdd_neg, neg_neg, mul_assoc]

/-- The defining rank-one conjugation relation in the presented group. -/
theorem steinbergWeylElement_conj_rootSubgroup (γ : Fin t.numRoots) (s : Aˣ) (u : A) :
    t.steinbergWeylElement ht A γ s * t.steinbergRootSubgroup ht A γ (ofAdd u) *
        (t.steinbergWeylElement ht A γ s)⁻¹ =
      t.steinbergRootSubgroup ht A
        ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ)
        (ofAdd (-(((s⁻¹ : Aˣ) : A) ^ 2 * u))) := by
  have h := PresentedGroup.one_of_mem (rels := t.steinbergRelators ht A)
    ((mem_steinbergRelators t ht A).mpr (IsSteinbergRelator.weyl_conj γ s u))
  simpa only [map_mul, map_inv, mul_inv_eq_one, steinbergWeylElement,
    steinbergRootSubgroup_apply, steinbergRoot, PresentedGroup.of, toAdd_ofAdd] using h

/-- A Weyl word also exchanges the negative root group with the positive root group. -/
theorem steinbergWeylElement_conj_negativeRootSubgroup (γ : Fin t.numRoots) (s : Aˣ)
    (u : A) :
    t.steinbergWeylElement ht A γ s *
        t.steinbergRootSubgroup ht A
          ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) (ofAdd u) *
        (t.steinbergWeylElement ht A γ s)⁻¹ =
      t.steinbergRootSubgroup ht A γ (ofAdd (-((s : A) ^ 2 * u))) := by
  have h := steinbergWeylElement_conj_rootSubgroup (ht := ht) γ (-s)
    (-((s : A) ^ 2 * u))
  simp only [steinbergWeylElement_neg, inv_neg, Units.val_neg, neg_sq,
    inv_inv, ← mul_assoc, ← mul_pow, Units.inv_mul, one_pow, one_mul,
    mul_neg, neg_neg] at h
  rw [← h]
  group

/-- A coroot rescales its root parameter by the square of the unit. -/
theorem steinbergCoroot_conj_rootSubgroup (γ : Fin t.numRoots) (s : Aˣ) (u : A) :
    t.steinbergCoroot ht A γ s * t.steinbergRootSubgroup ht A γ (ofAdd u) *
        (t.steinbergCoroot ht A γ s)⁻¹ =
      t.steinbergRootSubgroup ht A γ (ofAdd ((s : A) ^ 2 * u)) := by
  have h := steinbergWeylElement_conj_rootSubgroup (ht := ht) γ (-1 : Aˣ) u
  simp only [steinbergWeylElement_neg, inv_neg, inv_one, Units.val_neg,
    Units.val_one, neg_one_sq, one_mul] at h
  calc
    _ = t.steinbergWeylElement ht A γ s *
        (t.steinbergRootSubgroup ht A
          ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) (ofAdd (-u))) *
        (t.steinbergWeylElement ht A γ s)⁻¹ := by
      rw [← h, steinbergCoroot_apply]
      group
    _ = _ := by rw [steinbergWeylElement_conj_negativeRootSubgroup]; simp

/-- A Weyl word can equally be written with the negative root on the outside. -/
theorem steinbergWeylElement_eq_negative_positive_negative (γ : Fin t.numRoots) (s : Aˣ) :
    t.steinbergWeylElement ht A γ s =
      t.steinbergRootSubgroup ht A
          ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ)
          (ofAdd (-((s⁻¹ : Aˣ) : A))) *
        t.steinbergRootSubgroup ht A γ (ofAdd (s : A)) *
        t.steinbergRootSubgroup ht A
          ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ)
          (ofAdd (-((s⁻¹ : Aˣ) : A))) := by
  have h := steinbergWeylElement_conj_rootSubgroup (ht := ht) γ s (s : A)
  simp only [pow_two, mul_assoc, Units.inv_mul, mul_one] at h
  have h' := congrArg (fun g => g * t.steinbergRootSubgroup ht A γ (ofAdd (s : A)) *
    t.steinbergRootSubgroup ht A
      ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ)
      (ofAdd (-((s⁻¹ : Aˣ) : A)))) h
  rw [steinbergWeylElement_def] at h' ⊢
  group at h'
  simpa only [zpow_neg_one] using h'

/-- Conjugation by the unit-parameter Weyl word inverts every Weyl parameter. -/
theorem steinbergWeylElement_one_conj (γ : Fin t.numRoots) (s : Aˣ) :
    t.steinbergWeylElement ht A γ 1 * t.steinbergWeylElement ht A γ s *
        (t.steinbergWeylElement ht A γ 1)⁻¹ =
      t.steinbergWeylElement ht A γ s⁻¹ := by
  let n := t.steinbergWeylElement ht A γ 1
  let x := t.steinbergRootSubgroup ht A γ
  let y := t.steinbergRootSubgroup ht A
    ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ)
  calc
    _ = (n * x (ofAdd (s : A)) * n⁻¹) *
        (n * y (ofAdd (-((s⁻¹ : Aˣ) : A))) * n⁻¹) *
        (n * x (ofAdd (s : A)) * n⁻¹) := by
      rw [steinbergWeylElement_def (s := s)]
      dsimp only [n, x, y]
      group
    _ = y (ofAdd (-(s : A))) * x (ofAdd ((s⁻¹ : Aˣ) : A)) *
        y (ofAdd (-(s : A))) := by
      rw [steinbergWeylElement_conj_rootSubgroup,
        steinbergWeylElement_conj_negativeRootSubgroup]
      simp only [inv_one, Units.val_one, one_pow, one_mul, neg_neg, x, y]
    _ = _ := by
      rw [steinbergWeylElement_eq_negative_positive_negative]
      simp only [inv_inv, x, y]

/-- The unit-parameter Weyl word inverts the coroot parameter. -/
theorem steinbergWeylElement_mul_steinbergCoroot (γ : Fin t.numRoots) (s : Aˣ) :
    t.steinbergWeylElement ht A γ 1 * t.steinbergCoroot ht A γ s =
      t.steinbergCoroot ht A γ s⁻¹ * t.steinbergWeylElement ht A γ 1 := by
  have h := steinbergWeylElement_one_conj (ht := ht) γ s
  simp only [steinbergCoroot_apply]
  calc
    _ = t.steinbergWeylElement ht A γ 1 * t.steinbergWeylElement ht A γ s *
        (t.steinbergWeylElement ht A γ 1)⁻¹ := by group
    _ = _ := h.trans (by group)

/-- The square of the unit-parameter Weyl word is the coroot at `-1`. -/
@[simp]
theorem steinbergWeylElement_mul_self (γ : Fin t.numRoots) :
    t.steinbergWeylElement ht A γ 1 * t.steinbergWeylElement ht A γ 1 =
      t.steinbergCoroot ht A γ (-1) := by
  have h : (t.steinbergCoroot ht A γ (-1))⁻¹ = t.steinbergCoroot ht A γ (-1) := by
    rw [← map_inv]
    simp only [inv_neg, inv_one]
  simpa only [steinbergCoroot_apply, steinbergWeylElement_neg, mul_inv_rev, inv_inv] using h

/-- The rank-one exchange identity follows from the presented relations, over any ring. -/
theorem steinbergWeylElement_mul_rootSubgroup_mul_steinbergWeylElement
    (γ : Fin t.numRoots) (u : Aˣ) :
    t.steinbergWeylElement ht A γ 1 *
        t.steinbergRootSubgroup ht A γ (ofAdd (u : A)) *
        t.steinbergWeylElement ht A γ 1 =
      t.steinbergRootSubgroup ht A γ (ofAdd (-((u⁻¹ : Aˣ) : A))) *
        t.steinbergCoroot ht A γ (-u⁻¹) * t.steinbergWeylElement ht A γ 1 *
        t.steinbergRootSubgroup ht A γ (ofAdd (-((u⁻¹ : Aˣ) : A))) := by
  let n := t.steinbergWeylElement ht A γ 1
  let x := t.steinbergRootSubgroup ht A γ
  let y := t.steinbergRootSubgroup ht A
    ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ)
  let h := t.steinbergCoroot ht A γ
  have hy : y (ofAdd (-(u : A))) =
      x (ofAdd (-((u⁻¹ : Aˣ) : A))) * t.steinbergWeylElement ht A γ u⁻¹ *
        x (ofAdd (-((u⁻¹ : Aˣ) : A))) := by
    dsimp only [x, y]
    rw [steinbergWeylElement_def]
    simp only [inv_inv, ofAdd_neg, map_inv]
    group
  have hm : h (-1) * x (ofAdd (-((u⁻¹ : Aˣ) : A))) =
      x (ofAdd (-((u⁻¹ : Aˣ) : A))) * h (-1) := by
    apply mul_inv_eq_iff_eq_mul.mp
    simpa only [Units.val_neg, Units.val_one, neg_one_sq, one_mul] using
      steinbergCoroot_conj_rootSubgroup (ht := ht) γ (-1 : Aˣ) (-((u⁻¹ : Aˣ) : A))
  calc
    _ = y (ofAdd (-(u : A))) * h (-1) := by
      have hc := steinbergWeylElement_conj_rootSubgroup (ht := ht) γ (1 : Aˣ) (u : A)
      simp only [inv_one, Units.val_one, one_pow, one_mul] at hc
      rw [← hc, ← steinbergWeylElement_mul_self]
      group
    _ = x (ofAdd (-((u⁻¹ : Aˣ) : A))) * t.steinbergWeylElement ht A γ u⁻¹ *
        (h (-1) * x (ofAdd (-((u⁻¹ : Aˣ) : A)))) := by rw [hy, hm]; group
    _ = x (ofAdd (-((u⁻¹ : Aˣ) : A))) * h u⁻¹ *
        (n * h (-1)) * x (ofAdd (-((u⁻¹ : Aˣ) : A))) := by
      dsimp only [h, n]
      rw [steinbergCoroot_apply (s := u⁻¹)]
      group
    _ = _ := by
      dsimp only [x, h, n]
      rw [steinbergWeylElement_mul_steinbergCoroot]
      simp only [inv_neg, inv_one]
      rw [← mul_neg_one u⁻¹, map_mul]
      group

/-- An opposite root pair generates precisely its root group, coroot and Weyl word. -/
theorem closure_steinbergRootPair_eq (γ : Fin t.numRoots) :
    Subgroup.closure (Set.range (t.steinbergRootSubgroup ht A γ) ∪
      Set.range (t.steinbergRootSubgroup ht A
        ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ))) =
      Subgroup.closure (Set.range (t.steinbergRootSubgroup ht A γ) ∪
        Set.range (t.steinbergCoroot ht A γ) ∪ {t.steinbergWeylElement ht A γ 1}) := by
  let S := Subgroup.closure (Set.range (t.steinbergRootSubgroup ht A γ) ∪
    Set.range (t.steinbergRootSubgroup ht A
      ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ)))
  have hx u : t.steinbergRootSubgroup ht A γ u ∈ S :=
    Subgroup.subset_closure (Or.inl ⟨u, rfl⟩)
  have hy u : t.steinbergRootSubgroup ht A
      ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) u ∈ S :=
    Subgroup.subset_closure (Or.inr ⟨u, rfl⟩)
  have hw s : t.steinbergWeylElement ht A γ s ∈ S := by
    rw [steinbergWeylElement_def]
    exact S.mul_mem (S.mul_mem (hx _) (hy _)) (hx _)
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro g (⟨u, rfl⟩ | ⟨u, rfl⟩)
    · exact Subgroup.subset_closure (Or.inl (Or.inl ⟨u, rfl⟩))
    · have hc := steinbergWeylElement_conj_rootSubgroup (ht := ht) γ (1 : Aˣ) (-u.toAdd)
      simp only [inv_one, Units.val_one, one_pow, one_mul, neg_neg, ofAdd_toAdd] at hc
      rw [← hc]
      exact Subgroup.mul_mem _
        (Subgroup.mul_mem _ (Subgroup.subset_closure (Or.inr rfl))
          (Subgroup.subset_closure (Or.inl (Or.inl ⟨_, rfl⟩))))
        (Subgroup.inv_mem _ (Subgroup.subset_closure (Or.inr rfl)))
  · apply (Subgroup.closure_le _).mpr
    rintro g ((⟨u, rfl⟩ | ⟨s, rfl⟩) | rfl)
    · exact hx u
    · rw [steinbergCoroot_apply]
      exact S.mul_mem (hw s) (S.inv_mem (hw 1))
    · exact hw 1

/-- Over a field, the subgroup of the presented group generated by an opposite root pair
has the two rank-one Bruhat forms. This is an existence theorem, not cell separation. -/
theorem mem_closure_steinbergRootPair_iff {K : Type*} [Field K] (γ : Fin t.numRoots)
    (g : PresentedGroup (t.steinbergRelators ht K)) :
    g ∈ Subgroup.closure (Set.range (t.steinbergRootSubgroup ht K γ) ∪
      Set.range (t.steinbergRootSubgroup ht K
        ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ))) ↔
      (∃ a s, g = t.steinbergRootSubgroup ht K γ (ofAdd a) *
        t.steinbergCoroot ht K γ s) ∨
      ∃ a s b, g = t.steinbergRootSubgroup ht K γ (ofAdd a) *
        t.steinbergCoroot ht K γ s * t.steinbergWeylElement ht K γ 1 *
        t.steinbergRootSubgroup ht K γ (ofAdd b) := by
  rw [closure_steinbergRootPair_eq]
  exact MonoidHom.mem_closure_rankOne_iff _ _ _
    (steinbergCoroot_conj_rootSubgroup γ)
    (steinbergWeylElement_mul_steinbergCoroot γ) (steinbergWeylElement_mul_self γ)
    (steinbergWeylElement_mul_rootSubgroup_mul_steinbergWeylElement γ) g

namespace ChevalleyDatum

variable (D : ChevalleyDatum t ht) (A)

/-- The presentation map sends a Weyl word to the Weyl element of the datum. -/
@[simp]
theorem steinbergLift_steinbergWeylElement (γ : Fin t.numRoots) (s : Aˣ) :
    D.steinbergLift A (t.steinbergWeylElement ht A γ s) = D.weylElement γ A s := by
  -- The named Weyl element is the class of the free-group Weyl word.
  exact D.steinbergLift_mk_steinbergWeylWord A γ s

/-- The presentation map sends coroot words to the actual weight-lattice coroots. -/
@[simp]
theorem steinbergLift_steinbergCoroot (γ : Fin t.numRoots) (s : Aˣ) :
    D.steinbergLift A (t.steinbergCoroot ht A γ s) = D.corootPoints γ A s := by
  simp only [steinbergCoroot_apply, map_mul, map_inv, steinbergLift_steinbergWeylElement,
    weylElement_mul_inv_weylElement, inv_one, mul_one]

end ChevalleyDatum

end

end TauCeti.DynkinType
