/-!
# The positive subgroup of Steinberg's presented group

For a valid Dynkin type `t` and a commutative ring `A`, let `St` be the group presented by
Steinberg's relations, `TauCeti.DynkinType.steinbergRelators`, and `Û` its subgroup generated by
the generators `X_γ(u)` at the positive roots `γ`. This file proves that the relations of `St`
already force the structure of the unipotent radical of a Chevalley group on `Û`:

* every element of `Û` is an ordered product `∏_{γ > 0} X_γ(u_γ)`, in any fixed enumeration of
  the positive roots;
* Steinberg's homomorphism `X_γ(u) ↦ x_γ(u)` maps `Û` onto the positive point subgroup `U(A)` of
  every Chevalley datum;
* for the full-weight datum of `G_sc(t)` it is injective on `Û`, so `Û ≅ U(A)`.

The first statement holds because, by the commutator relations, the commutator of two distinct
positive root generators is a product of generators at roots of strictly larger height, or of
strictly larger index in the native root table in type `G₂`. The generic collection theorem
`TauCeti.mem_biSup_range_iff_exists_list_prod_map` then applies. The root-string case analysis
is the one used for the root subgroups of a Kostant lattice in
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2` and
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.G2`, here
read off the relators of the presentation. The injectivity combines it with uniqueness of ordered
positive-root products in `G_sc(t)`,
`TauCeti.DynkinType.list_prod_map_scChevalleyDatum_rootSubgroupPoints_inj`.

All statements hold over every commutative ring. In Steinberg's proof that the relations present
the simply connected Chevalley group over a field, `Û ≅ U` is the first step: identities between
elements of `Û` that hold in the Chevalley group therefore already hold in `St`.

## Main definitions

* `TauCeti.DynkinType.steinbergPositiveSubgroup`: the subgroup `Û` of the presented group.
* `TauCeti.DynkinType.steinbergPositiveSubgroupEquiv`: the isomorphism `Û ≃* U(A)` onto the
  positive points of `G_sc(t)`.

## Main results

* `TauCeti.DynkinType.mem_steinbergPositiveSubgroup_iff_exists_list_prod`: every element of `Û`
  is an ordered product of positive root generators.
* `TauCeti.DynkinType.ChevalleyDatum.map_steinbergLift_steinbergPositiveSubgroup`: Steinberg's
  homomorphism maps `Û` onto the positive points of a Chevalley datum.
* `TauCeti.DynkinType.injOn_steinbergLift_steinbergPositiveSubgroup`: for `G_sc(t)`, Steinberg's
  homomorphism is injective on `Û`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17, and Chapter 6, proof of
  Theorem 8.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.3.3 and Chapter 12.
-/

public section

open scoped commutatorElement
open Multiplicative

namespace TauCeti.DynkinType

universe u

/-! ## The positive subgroup -/

section Definition

variable (t : DynkinType) (ht : t.Valid) (A : Type u) [CommRing A]

/-- **The positive subgroup `Û` of Steinberg's presented group**: the subgroup generated by the
generators `X_γ(u)` at the positive roots `γ`. -/
def steinbergPositiveSubgroup : Subgroup (PresentedGroup (t.steinbergRelators ht A)) :=
  ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
    (t.steinbergRootSubgroup ht A γ).range

/-- The positive subgroup is the join of the ranges of the positive root generators. -/
theorem steinbergPositiveSubgroup_def :
    t.steinbergPositiveSubgroup ht A =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (t.steinbergRootSubgroup ht A γ).range :=
  (rfl)

variable {t ht A} in
/-- Each positive root generator lies in the positive subgroup. -/
-- Not `@[simp]`: `steinbergRootSubgroup_apply` rewrites the generator first.
theorem steinbergRootSubgroup_mem_steinbergPositiveSubgroup {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (a : Multiplicative A) :
    t.steinbergRootSubgroup ht A γ a ∈ t.steinbergPositiveSubgroup ht A :=
  le_iSup₂ (f := fun γ _ => (t.steinbergRootSubgroup ht A γ).range) γ hγ ⟨a, rfl⟩

variable {t ht A} in
/-- Containment of the positive subgroup can be checked on the positive root generators. -/
theorem steinbergPositiveSubgroup_le_iff
    {H : Subgroup (PresentedGroup (t.steinbergRelators ht A))} :
    t.steinbergPositiveSubgroup ht A ≤ H ↔
      ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ a,
        t.steinbergRootSubgroup ht A γ a ∈ H := by
  simp only [steinbergPositiveSubgroup_def, iSup₂_le_iff]
  exact forall₂_congr fun γ _ => ⟨fun h a => h ⟨a, rfl⟩, fun h _ ⟨a, ha⟩ => ha ▸ h a⟩

end Definition

/-! ## Commutators of positive root generators -/

variable {t : DynkinType} {ht : t.Valid} {A : Type u} [CommRing A]

/-- A root generator of the presented group is the class of the corresponding letter. -/
private theorem steinbergRootSubgroup_ofAdd (γ : Fin t.numRoots) (a : A) :
    t.steinbergRootSubgroup ht A γ (ofAdd a) =
      PresentedGroup.mk (t.steinbergRelators ht A) (steinbergRoot γ a) := by
  rw [steinbergRootSubgroup_apply, toAdd_ofAdd]
  -- `PresentedGroup.of` is by definition the class of the letter.
  rfl

/-- A relator `⁅X_α(u), X_β(v)⁆ w⁻¹` of the presentation gives the equation
`⁅X_α(u), X_β(v)⁆ = w` in the presented group. -/
private theorem commutatorElement_eq_of_isSteinbergRelator {α β : Fin t.numRoots} {u v : A}
    {w : FreeGroup (Fin t.numRoots × A)}
    (hr : IsSteinbergRelator A t ht (⁅steinbergRoot α u, steinbergRoot β v⁆ * w⁻¹)) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ =
      PresentedGroup.mk (t.steinbergRelators ht A) w := by
  rw [steinbergRootSubgroup_ofAdd, steinbergRootSubgroup_ofAdd, ← map_commutatorElement]
  exact PresentedGroup.mk_eq_mk_of_mul_inv_mem ((t.mem_steinbergRelators ht A).mpr hr)

/-- Root generators commute when the sum of their roots is neither a root nor zero. -/
private theorem commutatorElement_eq_one_of_isSteinbergRelator {α β : Fin t.numRoots}
    (h : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (h₀ : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ≠ 0)
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ = 1 := by
  rw [steinbergRootSubgroup_ofAdd, steinbergRootSubgroup_ofAdd, ← map_commutatorElement]
  exact PresentedGroup.one_of_mem ((t.mem_steinbergRelators ht A).mpr (.commute h h₀ u v))

/-- A generator at a positive root of height larger than those of `α` and `β` lies in the join
of the root generators of such roots. -/
private theorem steinbergRootSubgroup_mem_iSup_height {α β d : Fin t.numRoots}
    (hd : d ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hheight : max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
      (t.rationalBase ht).height d) (w : A) :
    t.steinbergRootSubgroup ht A d (ofAdd w) ∈
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
        (t.steinbergRootSubgroup ht A γ).range :=
  (le_iSup₂ (f := fun γ _ => (t.steinbergRootSubgroup ht A γ).range) d
    (Finset.mem_filter.mpr ⟨(mem_posRootsFinset _ _ d).mpr hd, hheight⟩)) ⟨ofAdd w, rfl⟩

/-- Outside `G₂`, two linearly independent roots `α`, `β` never have both `2α + β` and
`α + 2β` as roots. -/
private theorem add_two_nsmul_notMem_range_root [(t.rationalRootSystem ht).IsNotG2]
    {α β : Fin t.numRoots}
    (hlin : LinearIndependent ℚ
      ![(t.rationalRootSystem ht).root α, (t.rationalRootSystem ht).root β])
    (hdouble : 2 • (t.simplyConnectedRootDatum ht).root α +
      (t.simplyConnectedRootDatum ht).root β ∈ Set.range (t.simplyConnectedRootDatum ht).root) :
    (t.simplyConnectedRootDatum ht).root α + 2 • (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root := by
  obtain ⟨δ, hδ⟩ := hdouble
  rintro ⟨ε, hε⟩
  refine (t.rationalRootSystem ht).not_double_root_add_and_root_add_double_mem hlin
    ⟨⟨δ, (t.root_rationalRootSystem_eq_nsmul_add_iff ht α β δ 2).mpr hδ⟩, ⟨ε, ?_⟩⟩
  rw [(t.root_rationalRootSystem_eq_nsmul_add_iff ht β α ε 2).mpr (by rw [hε, add_comm]),
    add_comm]

/-- Outside `G₂`, if the sum of two positive roots `α` and `β` is a root `γ`, the commutator of
their generators is a product of generators at `γ` and possibly `2α + β` or `α + 2β`, all of
strictly larger height. -/
private theorem commutatorElement_mem_iSup_height_of_root_eq_add
    [(t.rationalRootSystem ht).IsNotG2] {α β γ : Fin t.numRoots}
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hγ : (t.simplyConnectedRootDatum ht).root γ =
      (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ ∈
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
        (t.steinbergRootSubgroup ht A γ).range := by
  classical
  let P := t.rationalRootSystem ht
  let R := t.simplyConnectedRootDatum ht
  have hapos := one_le_height_of_mem_posRoots P (t.rationalBase ht) hα
  have hbpos := one_le_height_of_mem_posRoots P (t.rationalBase ht) hβ
  have hγQ : P.root γ = P.root α + P.root β := by
    simpa only [one_nsmul] using
      (t.root_rationalRootSystem_eq_nsmul_add_iff ht α β γ 1).mpr (by rwa [one_nsmul])
  have hγpos := add_mem_posRoots P (t.rationalBase ht) hα hβ hγQ
  have hγheight := (t.rationalBase ht).height_add hγQ
  have hlin := P.linearIndependent_of_add_mem_range_root' ⟨γ, hγQ⟩
  by_cases hdouble : 2 • R.root α + R.root β ∈ Set.range R.root
  · -- The root string `β, α + β, 2α + β`.
    obtain ⟨δ, hδ⟩ := hdouble
    have hδQ : P.root δ = P.root α + P.root γ := by
      rw [(t.root_rationalRootSystem_eq_nsmul_add_iff ht α β δ 2).mpr hδ, hγQ, two_nsmul]; abel
    have hδpos := add_mem_posRoots P (t.rationalBase ht) hα hγpos hδQ
    have hδheight := (t.rationalBase ht).height_add hδQ
    rw [commutatorElement_eq_of_isSteinbergRelator (IsSteinbergRelator.commutator_two_nsmul_add
      hγ hδ (three_nsmul_add_notMem_range_root α β)
      (add_two_nsmul_notMem_range_root hlin ⟨δ, hδ⟩) u v), map_mul,
      ← steinbergRootSubgroup_ofAdd, ← steinbergRootSubgroup_ofAdd]
    exact Subgroup.mul_mem _ (steinbergRootSubgroup_mem_iSup_height hγpos (by omega) _)
      (steinbergRootSubgroup_mem_iSup_height hδpos (by omega) _)
  · by_cases hdouble' : R.root α + 2 • R.root β ∈ Set.range R.root
    · -- The root string `α, α + β, α + 2β`.
      obtain ⟨δ, hδ⟩ := hdouble'
      have hδQ : P.root δ = P.root β + P.root γ := by
        rw [(t.root_rationalRootSystem_eq_nsmul_add_iff ht β α δ 2).mpr (by rw [hδ, add_comm]),
          hγQ, two_nsmul]
        abel
      have hδpos := add_mem_posRoots P (t.rationalBase ht) hβ hγpos hδQ
      have hδheight := (t.rationalBase ht).height_add hδQ
      have hthree : R.root α + 3 • R.root β ∉ Set.range R.root := by
        rw [add_comm]
        exact three_nsmul_add_notMem_range_root β α
      rw [commutatorElement_eq_of_isSteinbergRelator
        (IsSteinbergRelator.commutator_add_two_nsmul hγ hδ hdouble hthree u v),
        map_mul, ← steinbergRootSubgroup_ofAdd, ← steinbergRootSubgroup_ofAdd]
      exact Subgroup.mul_mem _ (steinbergRootSubgroup_mem_iSup_height hγpos (by omega) _)
        (steinbergRootSubgroup_mem_iSup_height hδpos (by omega) _)
    · -- Neither double string: the one-factor relation.
      rw [commutatorElement_eq_of_isSteinbergRelator
        (IsSteinbergRelator.commutator_add hγ hdouble hdouble' u v), ← steinbergRootSubgroup_ofAdd]
      exact steinbergRootSubgroup_mem_iSup_height hγpos (by omega) _

/-- Outside `G₂`, the commutator of two positive root generators is a product of generators at
positive roots of strictly larger height. -/
private theorem commutatorElement_mem_iSup_height [(t.rationalRootSystem ht).IsNotG2]
    {α β : Fin t.numRoots}
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ ∈
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
        (t.steinbergRootSubgroup ht A γ).range := by
  by_cases hsum : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∈
      Set.range (t.simplyConnectedRootDatum ht).root
  · obtain ⟨γ, hγ⟩ := hsum
    exact commutatorElement_mem_iSup_height_of_root_eq_add hα hβ hγ u v
  · -- Without a root sum the generators commute; positivity rules out opposite roots.
    have hzero : (t.simplyConnectedRootDatum ht).root α +
        (t.simplyConnectedRootDatum ht).root β ≠ 0 := by
      intro hz
      have hdeg := congrArg (t.weightDegree ht) hz
      have ha := t.weightDegree_root_pos ht hα
      have hb := t.weightDegree_root_pos ht hβ
      rw [map_add, map_zero] at hdeg
      linarith
    rw [commutatorElement_eq_one_of_isSteinbergRelator hsum hzero u v]
    exact Subgroup.one_mem _

-- The finite certificates repeatedly expose the same opaque root and length tables of `G₂`.
local macro "g2_table" : tactic => `(tactic|
  (try simp only [simplyConnectedRootDatum_G2, g2SimplyConnectedRootDatum_root, Set.mem_range]
   try dsimp +instances only [numRoots, rank]
   simp only [g2Root_apply, g2Length_apply]
   try dsimp +instances only [numRoots, rank]
   decide))

/-- A generator at a positive root of `G₂` of larger index in the native table lies in the
join of the generators at such roots. -/
private theorem g2_mk_steinbergRoot_mem_iSup {ht : G2.Valid} {j k : Fin 6} (hk : j < k) (a : A) :
    PresentedGroup.mk (G2.steinbergRelators ht A) (steinbergRoot (Fin.castAdd 6 k) a) ∈
      ⨆ k : Fin 6, ⨆ (_ : j < k), (G2.steinbergRootSubgroup ht A (Fin.castAdd 6 k)).range :=
  (le_iSup₂ (f := fun k _ => (G2.steinbergRootSubgroup ht A (Fin.castAdd 6 k)).range) k hk)
    ⟨ofAdd a, steinbergRootSubgroup_ofAdd _ a⟩

/-- In type `G₂`, the commutator of two positive root generators is a product of generators at
positive roots of strictly larger index in the native root table. -/
private theorem g2_commutatorElement_mem_iSup {ht : G2.Valid} (i j : Fin 6) (hij : i < j)
    (u v : A) :
    ⁅G2.steinbergRootSubgroup ht A (Fin.castAdd 6 i) (ofAdd u),
        G2.steinbergRootSubgroup ht A (Fin.castAdd 6 j) (ofAdd v)⁆ ∈
      ⨆ k : Fin 6, ⨆ (_ : j < k), (G2.steinbergRootSubgroup ht A (Fin.castAdd 6 k)).range := by
  let P := ⨆ k : Fin 6, ⨆ (_ : j < k), (G2.steinbergRootSubgroup ht A (Fin.castAdd 6 k)).range
  have mem (k : Fin 6) (hk : j < k) (a : A) := g2_mk_steinbergRoot_mem_iSup (A := A) (ht := ht) hk a
  have one_factor (k : Fin 6) (hk : j < k)
      (hsum : (G2.simplyConnectedRootDatum ht).root (Fin.castAdd 6 k) =
        (G2.simplyConnectedRootDatum ht).root (Fin.castAdd 6 i) +
          (G2.simplyConnectedRootDatum ht).root (Fin.castAdd 6 j))
      (hleft : 2 • (G2.simplyConnectedRootDatum ht).root (Fin.castAdd 6 i) +
        (G2.simplyConnectedRootDatum ht).root (Fin.castAdd 6 j) ∉
          Set.range (G2.simplyConnectedRootDatum ht).root)
      (hright : (G2.simplyConnectedRootDatum ht).root (Fin.castAdd 6 i) +
        2 • (G2.simplyConnectedRootDatum ht).root (Fin.castAdd 6 j) ∉
          Set.range (G2.simplyConnectedRootDatum ht).root) :
      ⁅G2.steinbergRootSubgroup ht A (Fin.castAdd 6 i) (ofAdd u),
        G2.steinbergRootSubgroup ht A (Fin.castAdd 6 j) (ofAdd v)⁆ ∈ P := by
    rw [commutatorElement_eq_of_isSteinbergRelator
      (IsSteinbergRelator.commutator_add hsum hleft hright u v)]
    exact mem k hk _
  -- Three sum pairs use the one-factor relation, (0, 1) the short–long relation and (0, 2) the
  -- short–short relation; all other pairs commute.
  by_cases hsum : (G2.simplyConnectedRootDatum ht).root (Fin.castAdd 6 i) +
      (G2.simplyConnectedRootDatum ht).root (Fin.castAdd 6 j) ∈
        Set.range (G2.simplyConnectedRootDatum ht).root
  · rcases index_pair_of_root_add_mem_range_root_g2 ht i j hij hsum with
      ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · -- State the equation through the generators, so that the indices of the relator are
      -- normalized to the concrete indices of the goal.
      have h : ⁅G2.steinbergRootSubgroup ht A (Fin.castAdd 6 0) (ofAdd u),
          G2.steinbergRootSubgroup ht A (Fin.castAdd 6 1) (ofAdd v)⁆ = _ :=
        commutatorElement_eq_of_isSteinbergRelator (IsSteinbergRelator.g2_short_long
          (α := Fin.castAdd 6 (0 : Fin 6)) (β := Fin.castAdd 6 (1 : Fin 6))
          (γ := Fin.castAdd 6 (2 : Fin 6)) (δ := Fin.castAdd 6 (3 : Fin 6))
          (ε := Fin.castAdd 6 (4 : Fin 6)) (ζ := Fin.castAdd 6 (5 : Fin 6))
          (by g2_table) (by g2_table) (by g2_table) (by g2_table) u v)
      rw [h, map_mul, map_mul, map_mul]
      exact P.mul_mem (P.mul_mem (P.mul_mem (mem 2 (by decide) _) (mem 3 (by decide) _))
        (mem 4 (by decide) _)) (mem 5 (by decide) _)
    · -- As above, normalize the indices of the relator to those of the goal.
      have h : ⁅G2.steinbergRootSubgroup ht A (Fin.castAdd 6 0) (ofAdd u),
          G2.steinbergRootSubgroup ht A (Fin.castAdd 6 2) (ofAdd v)⁆ = _ :=
        commutatorElement_eq_of_isSteinbergRelator (IsSteinbergRelator.g2_short_pair
          (i := Fin.castAdd 6 (0 : Fin 6)) (j := Fin.castAdd 6 (2 : Fin 6))
          (k := Fin.castAdd 6 (3 : Fin 6)) (l := Fin.castAdd 6 (4 : Fin 6))
          (m := Fin.castAdd 6 (5 : Fin 6))
          (by g2_table) (by g2_table) (by g2_table) (by g2_table) (by g2_table) (by g2_table) u v)
      rw [h, map_mul, map_mul]
      exact P.mul_mem (P.mul_mem (mem 3 (by decide) _) (mem 4 (by decide) _))
        (mem 5 (by decide) _)
    · exact one_factor 4 (by decide) (by g2_table) (by g2_table) (by g2_table)
    · exact one_factor 5 (by decide) (by g2_table) (by g2_table) (by g2_table)
    · exact one_factor 5 (by decide) (by g2_table) (by g2_table) (by g2_table)
  · rw [commutatorElement_eq_one_of_isSteinbergRelator hsum (root_add_root_ne_zero_g2 ht i j) u v]
    exact P.one_mem

/-! ## Collection in the positive subgroup -/

/-- The positive subgroup as a join indexed by the finite set of positive roots. -/
private theorem steinbergPositiveSubgroup_eq_biSup_posRootsFinset :
    t.steinbergPositiveSubgroup ht A =
      ⨆ γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht),
        (t.steinbergRootSubgroup ht A γ).range := by
  simp only [steinbergPositiveSubgroup_def, mem_posRootsFinset]

/-- **Ordered products in the positive subgroup of Steinberg's presented group.** Every element
of `Û` is a product `∏_{γ ∈ l} X_γ(u_γ)` with one generator per positive root, for every
enumeration `l` of the positive roots without repetitions. Only the additivity and commutator
relations are used, so this holds over every commutative ring and in every characteristic. -/
theorem mem_steinbergPositiveSubgroup_iff_exists_list_prod {l : List (Fin t.numRoots)}
    (hl : l.Nodup)
    (hlpos : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    {g : PresentedGroup (t.steinbergRelators ht A)} :
    g ∈ t.steinbergPositiveSubgroup ht A ↔
      ∃ u : Fin t.numRoots → A,
        (l.map fun γ => t.steinbergRootSubgroup ht A γ (ofAdd (u γ))).prod = g := by
  classical
  have hlS (γ : Fin t.numRoots) :
      γ ∈ l ↔ γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) :=
    (hlpos γ).trans (mem_posRootsFinset _ _ γ).symm
  rw [steinbergPositiveSubgroup_eq_biSup_posRootsFinset]
  by_cases hG2 : t = G2
  · -- In type `G₂`, grade the positive roots by their index in the native root table.
    subst hG2
    refine mem_biSup_range_iff_exists_list_prod_map (ht := fun γ : Fin G2.numRoots => (γ : ℕ))
      (fun r hr s hs hrs => ?_) hl hlS
    have hr6 : (r : ℕ) < 6 :=
      (mem_posRoots_rational_g2_iff ht r).mp ((mem_posRootsFinset _ _ _).mp hr)
    have hs6 : (s : ℕ) < 6 :=
      (mem_posRoots_rational_g2_iff ht s).mp ((mem_posRootsFinset _ _ _).mp hs)
    -- A positive root of `G₂` is the entry of the native table at its index.
    obtain ⟨i, rfl⟩ : ∃ i : Fin 6, Fin.castAdd 6 i = r := ⟨⟨r, hr6⟩, Fin.ext rfl⟩
    obtain ⟨j, rfl⟩ : ∃ j : Fin 6, Fin.castAdd 6 j = s := ⟨⟨s, hs6⟩, Fin.ext rfl⟩
    have hle (m n : Fin 6) (hmn : m < n) :
        ⁅(G2.steinbergRootSubgroup ht A (Fin.castAdd 6 m)).range,
            (G2.steinbergRootSubgroup ht A (Fin.castAdd 6 n)).range⁆ ≤
          ⨆ q ∈ (posRootsFinset (G2.rationalRootSystem ht) (G2.rationalBase ht)).filter
            (fun q : Fin G2.numRoots => max (m : ℕ) (n : ℕ) < (q : ℕ)),
            (G2.steinbergRootSubgroup ht A q).range := by
      have hk : (⨆ k : Fin 6, ⨆ (_ : n < k),
            (G2.steinbergRootSubgroup ht A (Fin.castAdd 6 k)).range) ≤
          ⨆ q ∈ (posRootsFinset (G2.rationalRootSystem ht) (G2.rationalBase ht)).filter
            (fun q : Fin G2.numRoots => max (m : ℕ) (n : ℕ) < (q : ℕ)),
            (G2.steinbergRootSubgroup ht A q).range := by
        refine iSup₂_le fun k hk => le_iSup₂_of_le
          (f := fun q _ => (G2.steinbergRootSubgroup ht A q).range) (Fin.castAdd 6 k)
          (Finset.mem_filter.mpr ⟨(mem_posRootsFinset _ _ _).mpr
            ((mem_posRoots_rational_g2_iff ht _).mpr k.isLt), ?_⟩) le_rfl
        simp only [Fin.val_castAdd, max_lt_iff]
        exact ⟨Fin.lt_def.mp (hmn.trans hk), Fin.lt_def.mp hk⟩
      refine Subgroup.commutator_le.mpr fun _ ⟨x, hx⟩ _ ⟨y, hy⟩ => ?_
      subst hx hy
      exact hk (g2_commutatorElement_mem_iSup m n hmn x.toAdd y.toAdd)
    rcases lt_or_gt_of_ne (fun h : i = j => hrs (by rw [h])) with h | h
    · exact hle _ _ h
    · rw [Subgroup.commutator_comm, max_comm]
      exact hle _ _ h
  · -- Outside `G₂`, grade the positive roots by height.
    have := isNotG2_rationalRootSystem_of_ne_G2 (ht := ht) hG2
    refine mem_biSup_range_iff_exists_list_prod_map (ht := (t.rationalBase ht).height)
      (fun r hr s hs _ => ?_) hl hlS
    refine Subgroup.commutator_le.mpr fun _ ⟨x, hx⟩ _ ⟨y, hy⟩ => ?_
    subst hx hy
    exact commutatorElement_mem_iSup_height ((mem_posRootsFinset _ _ _).mp hr)
      ((mem_posRootsFinset _ _ _).mp hs) x.toAdd y.toAdd

/-! ## Steinberg's homomorphism on the positive subgroup -/

namespace ChevalleyDatum

variable (D : ChevalleyDatum t ht) (A)

/-- **Steinberg's homomorphism maps `Û` onto the positive points** of every Chevalley datum. -/
@[simp]
theorem map_steinbergLift_steinbergPositiveSubgroup :
    (t.steinbergPositiveSubgroup ht A).map (D.steinbergLift A) = D.positivePoints A := by
  simp only [steinbergPositiveSubgroup_def, Subgroup.map_iSup, MonoidHom.map_range,
    steinbergLift_comp_steinbergRootSubgroup, positivePoints_eq_iSup]

end ChevalleyDatum

variable (A) in
/-- **Steinberg's homomorphism is injective on `Û` for `G_sc(t)`.** Two elements of the positive
subgroup of the presented group with the same image in the simply connected Chevalley group are
equal, over every commutative ring. -/
theorem injOn_steinbergLift_steinbergPositiveSubgroup :
    Set.InjOn ((t.scChevalleyDatum ht).steinbergLift A) (t.steinbergPositiveSubgroup ht A) := by
  classical
  let S := posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht)
  have hlpos (γ : Fin t.numRoots) :
      γ ∈ S.toList ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [Finset.mem_toList, mem_posRootsFinset]
  intro g hg g' hg' hgg'
  obtain ⟨u, rfl⟩ :=
    (mem_steinbergPositiveSubgroup_iff_exists_list_prod S.nodup_toList hlpos).mp hg
  obtain ⟨v, rfl⟩ :=
    (mem_steinbergPositiveSubgroup_iff_exists_list_prod S.nodup_toList hlpos).mp hg'
  have hlift (w : Fin t.numRoots → A) :
      (t.scChevalleyDatum ht).steinbergLift A
          (S.toList.map fun γ => t.steinbergRootSubgroup ht A γ (ofAdd (w γ))).prod =
        (S.toList.map fun γ =>
          (t.scChevalleyDatum ht).rootSubgroupPoints γ A (ofAdd (w γ))).prod := by
    rw [map_list_prod, List.map_map]
    congr 1
    refine List.map_congr_left fun γ _ => ?_
    simp only [Function.comp_apply, steinbergRootSubgroup_apply, toAdd_ofAdd]
    exact (t.scChevalleyDatum ht).steinbergLift_of A γ (w γ)
  rw [hlift, hlift, list_prod_map_scChevalleyDatum_rootSubgroupPoints_inj t ht A S.nodup_toList
    (fun γ hγ => (hlpos γ).mp hγ)] at hgg'
  exact congrArg List.prod (List.map_congr_left fun γ hγ => by rw [hgg' γ hγ])

variable (t ht A) in
/-- **The positive subgroup `Û` of Steinberg's presented group is isomorphic to the positive
points `U(A)` of `G_sc(t)`**, through Steinberg's homomorphism `X_γ(u) ↦ x_γ(u)`, over every
commutative ring. -/
noncomputable def steinbergPositiveSubgroupEquiv :
    t.steinbergPositiveSubgroup ht A ≃* (t.scChevalleyDatum ht).positivePoints A :=
  (MonoidHom.ofInjective (f := ((t.scChevalleyDatum ht).steinbergLift A).domRestrict
      (t.steinbergPositiveSubgroup ht A)) fun g g' h =>
    Subtype.ext (injOn_steinbergLift_steinbergPositiveSubgroup A g.property g'.property h)).trans
    (MulEquiv.subgroupCongr (by
      rw [MonoidHom.domRestrict_range,
        ChevalleyDatum.map_steinbergLift_steinbergPositiveSubgroup]))

/-- The isomorphism `Û ≃* U(A)` is Steinberg's homomorphism. -/
@[simp]
theorem coe_steinbergPositiveSubgroupEquiv_apply (g : t.steinbergPositiveSubgroup ht A) :
    (t.steinbergPositiveSubgroupEquiv ht A g : (t.scChevalleyDatum ht).points A) =
      (t.scChevalleyDatum ht).steinbergLift A g :=
  (rfl)

end TauCeti.DynkinType
