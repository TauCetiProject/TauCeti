/-!
# The positive subgroup of Steinberg's presented group

For a valid Dynkin type `t` and a commutative ring `A`, let `St` be the group presented by
Steinberg's relations, `TauCeti.DynkinType.steinbergRelators`, and `Û` its subgroup generated by
the generators `X_γ(u)` at the positive roots `γ`. This file proves that the relations of `St`
already force the structure of the unipotent radical of a Chevalley group on `Û`:

* every element of `Û` is an ordered product `∏_{γ > 0} X_γ(u_γ)`, in any fixed enumeration of
  the positive roots;
* Steinberg's homomorphism `X_γ(u) ↦ x_γ(u)` maps `Û` onto the positive point subgroup `U(A)` of
  every Chevalley datum;
* for the full-weight datum of `G_sc(t)` it is injective on `Û`, so `Û ≅ U(A)`.

The first statement holds because, by the commutator relations, the commutator of the
generators at roots `α` and `β` whose sum is a root lies in the subgroup generated by the
generators at the roots `jα + kβ` with `j, k > 0`
(`TauCeti.DynkinType.commutatorElement_mem_of_root_eq_add`); for positive `α` and `β` these
roots are positive of strictly larger height. The generic collection theorem
`TauCeti.mem_biSup_range_iff_exists_list_prod_map` then applies. The root-string case analysis
is the one used for the root subgroups of a Kostant lattice in
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2` and
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.G2`, here
read off the relators of the presentation; in type `G₂` it is driven by the root-string facts
of `TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.G2.RootString`.
The injectivity combines it with uniqueness of ordered positive-root products in `G_sc(t)`,
`TauCeti.DynkinType.list_prod_map_scChevalleyDatum_rootSubgroupPoints_inj`.

All statements hold over every commutative ring. In Steinberg's proof that the relations present
the simply connected Chevalley group over a field, `Û ≅ U` is the first step: identities between
elements of `Û` that hold in the Chevalley group therefore already hold in `St`.

## Main definitions

* `TauCeti.DynkinType.steinbergPositiveSubgroup`: the subgroup `Û` of the presented group.
* `TauCeti.DynkinType.steinbergPositiveSubgroupEquiv`: the isomorphism `Û ≃* U(A)` onto the
  positive points of `G_sc(t)`.

## Main results

* `TauCeti.DynkinType.commutatorElement_mem_of_root_eq_add`: the commutator of the generators
  at roots `α`, `β` with `α + β` a root lies in every subgroup containing the generators at the
  roots `jα + kβ` with `j, k > 0`. Its two cases are
  `TauCeti.DynkinType.commutatorElement_mem_of_isNotG2_of_root_eq_add` outside `G₂` and
  `TauCeti.DynkinType.commutatorElement_mem_of_g2_of_root_eq_add` in type `G₂`.
* `TauCeti.DynkinType.mem_steinbergPositiveSubgroup_iff_exists_list_prod`: every element of `Û`
  is an ordered product of positive root generators.
* `TauCeti.DynkinType.ChevalleyDatum.map_steinbergLift_steinbergPositiveSubgroup`: Steinberg's
  homomorphism maps `Û` onto the positive points of a Chevalley datum.
* `TauCeti.DynkinType.injOn_steinbergLift_steinbergPositiveSubgroup`: for `G_sc(t)`, Steinberg's
  homomorphism is injective on `Û`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17, and Chapter 6, proof of
  Theorem 8.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.3.3 and Chapter 12.
-/

public section

open scoped commutatorElement
open Multiplicative

namespace TauCeti.DynkinType

universe u

/-! ## The positive subgroup -/

section Definition

variable (t : DynkinType) (ht : t.Valid) (A : Type u) [CommRing A]

/-- **The positive subgroup `Û` of Steinberg's presented group**: the subgroup generated by the
generators `X_γ(u)` at the positive roots `γ`. -/
def steinbergPositiveSubgroup : Subgroup (PresentedGroup (t.steinbergRelators ht A)) :=
  ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
    (t.steinbergRootSubgroup ht A γ).range

/-- The positive subgroup is the join of the ranges of the positive root generators. -/
theorem steinbergPositiveSubgroup_def :
    t.steinbergPositiveSubgroup ht A =
      ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (t.steinbergRootSubgroup ht A γ).range :=
  (rfl)

variable {t ht A} in
/-- Each positive root generator lies in the positive subgroup. -/
-- Not `@[simp]`: `steinbergRootSubgroup_apply` rewrites the generator first.
theorem steinbergRootSubgroup_mem_steinbergPositiveSubgroup {γ : Fin t.numRoots}
    (hγ : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (a : Multiplicative A) :
    t.steinbergRootSubgroup ht A γ a ∈ t.steinbergPositiveSubgroup ht A :=
  le_iSup₂ (f := fun γ _ => (t.steinbergRootSubgroup ht A γ).range) γ hγ ⟨a, rfl⟩

variable {t ht A} in
/-- Containment of the positive subgroup can be checked on the positive root generators. -/
theorem steinbergPositiveSubgroup_le_iff
    {H : Subgroup (PresentedGroup (t.steinbergRelators ht A))} :
    t.steinbergPositiveSubgroup ht A ≤ H ↔
      ∀ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ a,
        t.steinbergRootSubgroup ht A γ a ∈ H := by
  simp only [steinbergPositiveSubgroup_def, iSup₂_le_iff]
  exact forall₂_congr fun γ _ => ⟨fun h a => h ⟨a, rfl⟩, fun h _ ⟨a, ha⟩ => ha ▸ h a⟩

end Definition

/-! ## Commutators of positive root generators -/

variable {t : DynkinType} {ht : t.Valid} {A : Type u} [CommRing A]

/-- Positive root generators commute when the sum of their roots is not a root: as positive roots
never cancel, the sum is not zero either. -/
private theorem commutatorElement_eq_one_of_mem_posRoots {α β : Fin t.numRoots}
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (h : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ = 1 := by
  rw [posRoots_rationalRootSystem] at hα hβ
  exact commutatorElement_eq_one_of_root_add_notMem_range h
    (root_add_ne_zero_of_mem_posRoots_of_mem_posRootCone _ _ hα
      (root_mem_posRootCone_of_mem_posRoots _ _ hβ)) u v

/-- A generator at a positive root of height larger than those of `α` and `β` lies in the join
of the root generators of such roots. -/
private theorem mk_steinbergRoot_mem_iSup_height {α β d : Fin t.numRoots}
    (hd : d ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hheight : max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
      (t.rationalBase ht).height d) (w : A) :
    PresentedGroup.mk (t.steinbergRelators ht A) (steinbergRoot d w) ∈
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
        (t.steinbergRootSubgroup ht A γ).range :=
  (le_iSup₂ (f := fun γ _ => (t.steinbergRootSubgroup ht A γ).range) d
    (Finset.mem_filter.mpr ⟨(mem_posRootsFinset _ _ d).mpr hd, hheight⟩))
    ⟨ofAdd w, t.steinbergRootSubgroup_ofAdd ht A d w⟩

/-- **Commutators of root generators outside `G₂`.** If the roots `α` and `β` sum to a root `γ`,
the commutator of the generators at `α` and `β` lies in every subgroup that contains the generators
at all roots `jα + kβ` with `j, k > 0`: by the root-string relators it is a product of generators
at `α + β` and possibly `2α + β` or `α + 2β`. -/
theorem commutatorElement_mem_of_isNotG2_of_root_eq_add [(t.rationalRootSystem ht).IsNotG2]
    {α β γ : Fin t.numRoots} {H : Subgroup (PresentedGroup (t.steinbergRelators ht A))}
    (hγ : (t.simplyConnectedRootDatum ht).root γ =
      (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
    (hH : ∀ (δ : Fin t.numRoots) (j k : ℕ), 0 < j → 0 < k →
      (t.rationalRootSystem ht).root δ =
        j • (t.rationalRootSystem ht).root α + k • (t.rationalRootSystem ht).root β →
      ∀ w : A, PresentedGroup.mk (t.steinbergRelators ht A) (steinbergRoot δ w) ∈ H)
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ ∈ H := by
  let P := t.rationalRootSystem ht
  let R := t.simplyConnectedRootDatum ht
  have hγQ : P.root γ = P.root α + P.root β := by
    simpa only [one_nsmul] using
      (t.root_rationalRootSystem_eq_nsmul_add_iff ht α β γ 1).mpr (by rwa [one_nsmul])
  have hlin := P.linearIndependent_of_add_mem_range_root' ⟨γ, hγQ⟩
  have hγH := hH γ 1 1 one_pos one_pos (by rwa [one_nsmul, one_nsmul])
  by_cases hdouble : 2 • R.root α + R.root β ∈ Set.range R.root
  · -- The root string `β, α + β, 2α + β`.
    obtain ⟨δ, hδ⟩ := hdouble
    rw [commutatorElement_eq_of_isSteinbergRelator (IsSteinbergRelator.commutator_two_nsmul_add
      hγ hδ (three_nsmul_add_notMem_range_root α β)
      (add_two_nsmul_notMem_range_root hlin ⟨δ, hδ⟩) u v), map_mul]
    exact H.mul_mem (hγH _) (hH δ 2 1 two_pos one_pos (by
      rw [(t.root_rationalRootSystem_eq_nsmul_add_iff ht α β δ 2).mpr hδ, one_nsmul]) _)
  · by_cases hdouble' : R.root α + 2 • R.root β ∈ Set.range R.root
    · -- The root string `α, α + β, α + 2β`.
      obtain ⟨δ, hδ⟩ := hdouble'
      have hthree : R.root α + 3 • R.root β ∉ Set.range R.root := by
        rw [add_comm]
        exact three_nsmul_add_notMem_range_root β α
      rw [commutatorElement_eq_of_isSteinbergRelator
        (IsSteinbergRelator.commutator_add_two_nsmul hγ hδ hdouble hthree u v), map_mul]
      exact H.mul_mem (hγH _) (hH δ 1 2 one_pos two_pos (by
        rw [(t.root_rationalRootSystem_eq_nsmul_add_iff ht β α δ 2).mpr (by rw [hδ, add_comm]),
          one_nsmul, add_comm]) _)
    · -- Neither double string: the one-factor relation.
      rw [commutatorElement_eq_of_isSteinbergRelator
        (IsSteinbergRelator.commutator_add hγ hdouble hdouble' u v)]
      exact hγH _

/-- In type `G₂`, if the roots `α` and `β` sum to a short root `γ`, the commutator of their
generators is a product of generators at `γ` and at two or three further roots `jα + kβ` with
`j, k > 0`, by the three- or four-factor relation. The hypothesis `hmem` is stated for the
integral roots, in which the relators are written. -/
private theorem g2_commutatorElement_mem_of_short_sum {ht : G2.Valid} {α β γ : Fin G2.numRoots}
    {H : Subgroup (PresentedGroup (G2.steinbergRelators ht A))} (hγs : g2Length γ = 1)
    (hγ : (G2.simplyConnectedRootDatum ht).root γ =
      (G2.simplyConnectedRootDatum ht).root α + (G2.simplyConnectedRootDatum ht).root β)
    (hmem : ∀ (δ : Fin G2.numRoots) (j k : ℕ), 0 < j → 0 < k →
      (G2.simplyConnectedRootDatum ht).root δ =
        j • (G2.simplyConnectedRootDatum ht).root α + k • (G2.simplyConnectedRootDatum ht).root β →
      ∀ w : A, PresentedGroup.mk (G2.steinbergRelators ht A) (steinbergRoot δ w) ∈ H)
    (u v : A) :
    ⁅G2.steinbergRootSubgroup ht A α (ofAdd u), G2.steinbergRootSubgroup ht A β (ofAdd v)⁆ ∈
      H := by
  -- The `G₂` root-string facts are stated for the native datum, which is the assembled one.
  have hγn : g2SimplyConnectedRootDatum.root γ =
      g2SimplyConnectedRootDatum.root α + g2SimplyConnectedRootDatum.root β := by
    rwa [← simplyConnectedRootDatum_G2 ht]
  set R := G2.simplyConnectedRootDatum ht
  have hγH := hmem γ 1 1 one_pos one_pos (by rw [hγ, one_nsmul, one_nsmul])
  rcases g2Length_eq_one_or_eq_three α with hαs | hαl <;>
    rcases g2Length_eq_one_or_eq_three β with hβs | hβl
  · -- Two short roots: the three-factor relation, with factors at `2α + β` and `α + 2β`.
    obtain ⟨l, m, hl, hm⟩ : ∃ l m : Fin G2.numRoots,
        R.root l = R.root α + R.root γ ∧ R.root m = R.root γ + R.root β := by
      have h := g2_exists_root_eq_add_of_short_add_short_eq_short α β γ hαs hβs hγs hγn
      rwa [← simplyConnectedRootDatum_G2 ht] at h
    rw [commutatorElement_eq_of_isSteinbergRelator
      (IsSteinbergRelator.g2_short_pair hαs hβs hγs hγ hl hm u v), map_mul, map_mul]
    exact H.mul_mem (H.mul_mem (hγH _) (hmem l 2 1 two_pos one_pos (by
      rw [hl, hγ]; module) _)) (hmem m 1 2 one_pos two_pos (by rw [hm, hγ]; module) _)
  · -- Short root first: factors at `2α + β`, `3α + β` and `3α + 2β`.
    obtain ⟨δ, ε, ζ, hδ, hε, hζ⟩ : ∃ δ ε ζ : Fin G2.numRoots, R.root δ = R.root α + R.root γ ∧
        R.root ε = R.root α + R.root δ ∧ R.root ζ = R.root δ + R.root γ := by
      have h := g2_exists_root_eq_add_of_short_add_long_eq_root α β γ hαs hβl hγn
      rwa [← simplyConnectedRootDatum_G2 ht] at h
    rw [commutatorElement_eq_of_isSteinbergRelator
      (IsSteinbergRelator.g2_short_long hγ hδ hε hζ u v), map_mul, map_mul, map_mul]
    exact H.mul_mem (H.mul_mem (H.mul_mem (hγH _)
      (hmem δ 2 1 two_pos one_pos (by rw [hδ, hγ]; module) _))
      (hmem ε 3 1 three_pos one_pos (by rw [hε, hδ, hγ]; module) _))
      (hmem ζ 3 2 three_pos two_pos (by rw [hζ, hδ, hγ]; module) _)
  · -- Long root first: factors at `α + 2β`, `α + 3β` and `2α + 3β`.
    have hγ' : R.root γ = R.root β + R.root α := hγ.trans (add_comm _ _)
    obtain ⟨δ, ε, ζ, hδ, hε, hζ⟩ : ∃ δ ε ζ : Fin G2.numRoots, R.root δ = R.root β + R.root γ ∧
        R.root ε = R.root β + R.root δ ∧ R.root ζ = R.root δ + R.root γ := by
      have h := g2_exists_root_eq_add_of_short_add_long_eq_root β α γ hβs hαl
        (hγn.trans (add_comm _ _))
      rwa [← simplyConnectedRootDatum_G2 ht] at h
    rw [commutatorElement_eq_of_isSteinbergRelator
      (IsSteinbergRelator.g2_long_short hγ' hδ hε hζ v u), map_mul, map_mul, map_mul]
    exact H.mul_mem (H.mul_mem (H.mul_mem (hγH _)
      (hmem δ 1 2 one_pos two_pos (by rw [hδ, hγ]; module) _))
      (hmem ε 1 3 one_pos three_pos (by rw [hε, hδ, hγ]; module) _))
      (hmem ζ 2 3 two_pos three_pos (by rw [hζ, hδ, hγ]; module) _)
  · -- Two long roots have a long sum.
    have := g2Length_eq_three_of_long_add_long_eq_root α β γ hαl hβl hγn
    omega

/-- **Commutators of root generators in type `G₂`.** If the roots `α` and `β` of `G₂` sum to a
root `γ`, the commutator of the generators at `α` and `β` lies in every subgroup containing the
generators at all roots `jα + kβ` with `j, k > 0`: by the relators it is a product of generators
at `α + β` and, depending on the lengths of `α`, `β` and `γ`, at none, two or three further such
roots. -/
theorem commutatorElement_mem_of_g2_of_root_eq_add {ht : G2.Valid} {α β γ : Fin G2.numRoots}
    {H : Subgroup (PresentedGroup (G2.steinbergRelators ht A))}
    (hγ : (G2.simplyConnectedRootDatum ht).root γ =
      (G2.simplyConnectedRootDatum ht).root α + (G2.simplyConnectedRootDatum ht).root β)
    (hH : ∀ (δ : Fin G2.numRoots) (j k : ℕ), 0 < j → 0 < k →
      (G2.rationalRootSystem ht).root δ =
        j • (G2.rationalRootSystem ht).root α + k • (G2.rationalRootSystem ht).root β →
      ∀ w : A, PresentedGroup.mk (G2.steinbergRelators ht A) (steinbergRoot δ w) ∈ H)
    (u v : A) :
    ⁅G2.steinbergRootSubgroup ht A α (ofAdd u), G2.steinbergRootSubgroup ht A β (ofAdd v)⁆ ∈
      H := by
  -- The relators are stated for the integral roots; `hH` asks for the rational ones.
  have hmem (δ : Fin G2.numRoots) (j k : ℕ) (hj : 0 < j) (hk : 0 < k)
      (hδ : (G2.simplyConnectedRootDatum ht).root δ =
        j • (G2.simplyConnectedRootDatum ht).root α + k • (G2.simplyConnectedRootDatum ht).root β)
      (w : A) : PresentedGroup.mk (G2.steinbergRelators ht A) (steinbergRoot δ w) ∈ H := by
    refine hH δ j k hj hk (funext fun l => ?_) w
    simp only [Pi.add_apply, Pi.smul_apply, root_rationalRootSystem, hδ]
    simp only [nsmul_eq_mul]
    push_cast
    ring
  rcases g2Length_eq_one_or_eq_three γ with hγs | hγl
  · exact g2_commutatorElement_mem_of_short_sum hγs hγ hmem u v
  · -- A long sum: neither `2α + β = α + γ` nor `α + 2β = β + γ` is a root, so the one-factor
    -- relation applies.
    have hγn : g2SimplyConnectedRootDatum.root γ =
        g2SimplyConnectedRootDatum.root α + g2SimplyConnectedRootDatum.root β := by
      rwa [← simplyConnectedRootDatum_G2 ht]
    have hα := g2_root_add_notMem_range_of_add_eq_long α β γ hγl hγn
    have hβ := g2_root_add_notMem_range_of_add_eq_long β α γ hγl (hγn.trans (add_comm _ _))
    rw [← simplyConnectedRootDatum_G2 ht] at hα hβ
    set R := G2.simplyConnectedRootDatum ht
    have h2α : 2 • R.root α + R.root β = R.root α + R.root γ := by rw [hγ]; module
    have h2β : R.root α + 2 • R.root β = R.root β + R.root γ := by rw [hγ]; module
    rw [commutatorElement_eq_of_isSteinbergRelator (IsSteinbergRelator.commutator_add hγ
      (by rwa [h2α]) (by rwa [h2β]) u v)]
    exact hmem γ 1 1 one_pos one_pos (by rw [hγ, one_nsmul, one_nsmul]) _

/-- **Commutators of root generators.** If the roots `α` and `β` sum to a root `γ`, the
commutator of the generators at `α` and `β` lies in every subgroup containing the generators at
all roots `jα + kβ` with `j, k > 0`. -/
theorem commutatorElement_mem_of_root_eq_add {α β γ : Fin t.numRoots}
    {H : Subgroup (PresentedGroup (t.steinbergRelators ht A))}
    (hγ : (t.simplyConnectedRootDatum ht).root γ =
      (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
    (hH : ∀ (δ : Fin t.numRoots) (j k : ℕ), 0 < j → 0 < k →
      (t.rationalRootSystem ht).root δ =
        j • (t.rationalRootSystem ht).root α + k • (t.rationalRootSystem ht).root β →
      ∀ w : A, PresentedGroup.mk (t.steinbergRelators ht A) (steinbergRoot δ w) ∈ H)
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ ∈ H := by
  by_cases htG2 : t = G2
  · subst htG2
    exact commutatorElement_mem_of_g2_of_root_eq_add hγ hH u v
  · have := isNotG2_rationalRootSystem_of_ne_G2 (ht := ht) htG2
    exact commutatorElement_mem_of_isNotG2_of_root_eq_add hγ hH u v

/-- The commutator of two positive root generators is a product of generators at positive roots
of strictly larger height. -/
private theorem commutatorElement_mem_iSup_height {α β : Fin t.numRoots}
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ ∈
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
        (t.steinbergRootSubgroup ht A γ).range := by
  by_cases hsum : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∈
      Set.range (t.simplyConnectedRootDatum ht).root
  · obtain ⟨γ, hγ⟩ := hsum
    exact commutatorElement_mem_of_root_eq_add hγ (fun _ _ _ hj hk hδ _ =>
      have h := mem_posRoots_and_max_height_lt hα hβ hj hk hδ
      mk_steinbergRoot_mem_iSup_height h.1 h.2 _) u v
  · -- Without a root sum the generators commute.
    rw [commutatorElement_eq_one_of_mem_posRoots hα hβ hsum u v]
    exact Subgroup.one_mem _

/-! ## Collection in the positive subgroup -/

/-- The positive subgroup as a join indexed by the finite set of positive roots. -/
private theorem steinbergPositiveSubgroup_eq_biSup_posRootsFinset :
    t.steinbergPositiveSubgroup ht A =
      ⨆ γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht),
        (t.steinbergRootSubgroup ht A γ).range := by
  simp only [steinbergPositiveSubgroup_def, mem_posRootsFinset]

/-- **Ordered products in the positive subgroup of Steinberg's presented group.** Every element
of `Û` is a product `∏_{γ ∈ l} X_γ(u_γ)` with one generator per positive root, for every
enumeration `l` of the positive roots without repetitions. Only the additivity and commutator
relations are used, so this holds over every commutative ring and in every characteristic. -/
theorem mem_steinbergPositiveSubgroup_iff_exists_list_prod {l : List (Fin t.numRoots)}
    (hl : l.Nodup)
    (hlpos : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    {g : PresentedGroup (t.steinbergRelators ht A)} :
    g ∈ t.steinbergPositiveSubgroup ht A ↔
      ∃ u : Fin t.numRoots → A,
        (l.map fun γ => t.steinbergRootSubgroup ht A γ (ofAdd (u γ))).prod = g := by
  classical
  have hlS (γ : Fin t.numRoots) :
      γ ∈ l ↔ γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) :=
    (hlpos γ).trans (mem_posRootsFinset _ _ γ).symm
  rw [steinbergPositiveSubgroup_eq_biSup_posRootsFinset]
  refine mem_biSup_range_iff_exists_list_prod_map (ht := (t.rationalBase ht).height)
    (fun r hr s hs _ => ?_) hl hlS
  refine Subgroup.commutator_le.mpr fun _ ⟨x, hx⟩ _ ⟨y, hy⟩ => ?_
  subst hx hy
  exact commutatorElement_mem_iSup_height ((mem_posRootsFinset _ _ _).mp hr)
    ((mem_posRootsFinset _ _ _).mp hs) x.toAdd y.toAdd

/-! ## Steinberg's homomorphism on the positive subgroup -/

namespace ChevalleyDatum

variable (D : ChevalleyDatum t ht) (A)

/-- **Steinberg's homomorphism maps `Û` onto the positive points** of every Chevalley datum. -/
@[simp]
theorem map_steinbergLift_steinbergPositiveSubgroup :
    (t.steinbergPositiveSubgroup ht A).map (D.steinbergLift A) = D.positivePoints A := by
  simp only [steinbergPositiveSubgroup_def, Subgroup.map_iSup, MonoidHom.map_range,
    steinbergLift_comp_steinbergRootSubgroup, positivePoints_eq_iSup]

end ChevalleyDatum

variable (A) in
/-- **Steinberg's homomorphism is injective on `Û` for `G_sc(t)`.** Two elements of the positive
subgroup of the presented group with the same image in the simply connected Chevalley group are
equal, over every commutative ring. -/
theorem injOn_steinbergLift_steinbergPositiveSubgroup :
    Set.InjOn ((t.scChevalleyDatum ht).steinbergLift A) (t.steinbergPositiveSubgroup ht A) := by
  classical
  let S := posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht)
  have hlpos (γ : Fin t.numRoots) :
      γ ∈ S.toList ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [Finset.mem_toList, mem_posRootsFinset]
  intro g hg g' hg' hgg'
  obtain ⟨u, rfl⟩ :=
    (mem_steinbergPositiveSubgroup_iff_exists_list_prod S.nodup_toList hlpos).mp hg
  obtain ⟨v, rfl⟩ :=
    (mem_steinbergPositiveSubgroup_iff_exists_list_prod S.nodup_toList hlpos).mp hg'
  have hlift (w : Fin t.numRoots → A) :
      (t.scChevalleyDatum ht).steinbergLift A
          (S.toList.map fun γ => t.steinbergRootSubgroup ht A γ (ofAdd (w γ))).prod =
        (S.toList.map fun γ =>
          (t.scChevalleyDatum ht).rootSubgroupPoints γ A (ofAdd (w γ))).prod := by
    rw [map_list_prod, List.map_map]
    congr 1
    refine List.map_congr_left fun γ _ => ?_
    simp only [Function.comp_apply, steinbergRootSubgroup_apply, toAdd_ofAdd]
    exact (t.scChevalleyDatum ht).steinbergLift_of A γ (w γ)
  rw [hlift, hlift, list_prod_map_scChevalleyDatum_rootSubgroupPoints_inj t ht A S.nodup_toList
    (fun γ hγ => (hlpos γ).mp hγ)] at hgg'
  exact congrArg List.prod (List.map_congr_left fun γ hγ => by rw [hgg' γ hγ])

variable (t ht A) in
/-- **The positive subgroup `Û` of Steinberg's presented group is isomorphic to the positive
points `U(A)` of `G_sc(t)`**, through Steinberg's homomorphism `X_γ(u) ↦ x_γ(u)`, over every
commutative ring. -/
noncomputable def steinbergPositiveSubgroupEquiv :
    t.steinbergPositiveSubgroup ht A ≃* (t.scChevalleyDatum ht).positivePoints A :=
  (MonoidHom.ofInjective (f := ((t.scChevalleyDatum ht).steinbergLift A).domRestrict
      (t.steinbergPositiveSubgroup ht A)) fun g g' h =>
    Subtype.ext (injOn_steinbergLift_steinbergPositiveSubgroup A g.property g'.property h)).trans
    (MulEquiv.subgroupCongr (by
      rw [MonoidHom.domRestrict_range,
        ChevalleyDatum.map_steinbergLift_steinbergPositiveSubgroup]))

/-- The isomorphism `Û ≃* U(A)` is Steinberg's homomorphism. -/
@[simp]
theorem coe_steinbergPositiveSubgroupEquiv_apply (g : t.steinbergPositiveSubgroup ht A) :
    (t.steinbergPositiveSubgroupEquiv ht A g : (t.scChevalleyDatum ht).points A) =
      (t.scChevalleyDatum ht).steinbergLift A g :=
  (rfl)

end TauCeti.DynkinType
