/-!
# The negative subgroup of Steinberg's presented group

For a valid Dynkin type `t` and a commutative ring `A`, let `St` be the group presented by
Steinberg's relations, `TauCeti.DynkinType.steinbergRelators`, and `Û⁻` its subgroup generated by
the generators `X_γ(u)` at the negative roots `γ`. This file proves the statements for `Û⁻` that
`TauCeti.Algebra.AlgebraicGroup.Chevalley.Presentation.Positive` proves for the positive subgroup
`Û`:

* every element of `Û⁻` is an ordered product `∏_{γ < 0} X_γ(u_γ)`, in any fixed enumeration of
  the negative roots;
* Steinberg's homomorphism `X_γ(u) ↦ x_γ(u)` maps `Û⁻` onto the negative point subgroup `U⁻(A)`
  of every Chevalley datum;
* for the full-weight datum of `G_sc(t)` it is injective on `Û⁻`, so `Û⁻ ≅ U⁻(A)`.

The commutator of two negative root generators lies, by
`TauCeti.DynkinType.commutatorElement_mem_of_root_eq_add`, in the subgroup generated by the
generators at the roots `jα + kβ` with `j, k > 0`. These are negative roots whose negatives are
strictly taller than `-α` and `-β`, so grading a negative root by the height of its negative, the
generic collection theorem `TauCeti.mem_biSup_range_iff_exists_list_prod_map` applies in every
type, `G₂` included. The injectivity combines the ordered products with uniqueness of ordered
negative-root products in `G_sc(t)`,
`TauCeti.DynkinType.list_prod_map_scChevalleyDatum_rootSubgroupPoints_inj_of_mem_negRoots`.

All statements hold over every commutative ring. In Steinberg's proof that his relations present
the simply connected Chevalley group over a field, `Û⁻ ≅ U⁻` lets identities between elements of
`Û⁻` that hold in the Chevalley group be pulled back to `St`, as `Û ≅ U` does for `Û`.

## Main definitions

* `TauCeti.DynkinType.steinbergNegativeSubgroup`: the subgroup `Û⁻` of the presented group.
* `TauCeti.DynkinType.steinbergNegativeSubgroupEquiv`: the isomorphism `Û⁻ ≃* U⁻(A)` onto the
  negative points of `G_sc(t)`.

## Main results

* `TauCeti.DynkinType.mem_steinbergNegativeSubgroup_iff_exists_list_prod`: every element of `Û⁻`
  is an ordered product of negative root generators.
* `TauCeti.DynkinType.ChevalleyDatum.map_steinbergLift_steinbergNegativeSubgroup`: Steinberg's
  homomorphism maps `Û⁻` onto the negative points of a Chevalley datum.
* `TauCeti.DynkinType.injOn_steinbergLift_steinbergNegativeSubgroup`: for `G_sc(t)`, Steinberg's
  homomorphism is injective on `Û⁻`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17, and Chapter 6, proof of
  Theorem 8.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.3.3 and Chapter 12.
-/

public section

open scoped commutatorElement
open Multiplicative

namespace TauCeti.DynkinType

universe u

/-! ## The negative subgroup -/

section Definition

variable (t : DynkinType) (ht : t.Valid) (A : Type u) [CommRing A]

/-- **The negative subgroup `Û⁻` of Steinberg's presented group**: the subgroup generated by the
generators `X_γ(u)` at the negative roots `γ`. -/
def steinbergNegativeSubgroup : Subgroup (PresentedGroup (t.steinbergRelators ht A)) :=
  ⨆ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht),
    (t.steinbergRootSubgroup ht A γ).range

/-- The negative subgroup is the join of the ranges of the negative root generators. -/
theorem steinbergNegativeSubgroup_def :
    t.steinbergNegativeSubgroup ht A =
      ⨆ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (t.steinbergRootSubgroup ht A γ).range :=
  (rfl)

variable {t ht A} in
/-- Each negative root generator lies in the negative subgroup. -/
-- Not `@[simp]`: `steinbergRootSubgroup_apply` rewrites the generator first.
theorem steinbergRootSubgroup_mem_steinbergNegativeSubgroup {γ : Fin t.numRoots}
    (hγ : γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (a : Multiplicative A) :
    t.steinbergRootSubgroup ht A γ a ∈ t.steinbergNegativeSubgroup ht A :=
  le_iSup₂ (f := fun γ _ => (t.steinbergRootSubgroup ht A γ).range) γ hγ ⟨a, rfl⟩

variable {t ht A} in
/-- Containment of the negative subgroup can be checked on the negative root generators. -/
theorem steinbergNegativeSubgroup_le_iff
    {H : Subgroup (PresentedGroup (t.steinbergRelators ht A))} :
    t.steinbergNegativeSubgroup ht A ≤ H ↔
      ∀ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht), ∀ a,
        t.steinbergRootSubgroup ht A γ a ∈ H := by
  simp only [steinbergNegativeSubgroup_def, iSup₂_le_iff]
  exact forall₂_congr fun γ _ => ⟨fun h a => h ⟨a, rfl⟩, fun h _ ⟨a, ha⟩ => ha ▸ h a⟩

end Definition

/-! ## Commutators of negative root generators -/

variable {t : DynkinType} {ht : t.Valid} {A : Type u} [CommRing A]

/-- The height of the negative of a root, by which the negative roots are graded. -/
private noncomputable abbrev negHeight (t : DynkinType) (ht : t.Valid) (γ : Fin t.numRoots) : ℤ :=
  (t.rationalBase ht).height ((t.rationalRootSystem ht).reflectionPerm γ γ)

/-- Negative root generators commute when the sum of their roots is not a root: as negative roots
never cancel, the sum is not zero either. -/
private theorem commutatorElement_eq_one_of_mem_negRoots {α β : Fin t.numRoots}
    (hα : α ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (h : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ = 1 := by
  refine commutatorElement_eq_one_of_root_add_notMem_range h (fun h₀ => ?_) u v
  -- A vanishing sum would make `β = -α`, which is positive.
  rw [negRoots_rationalRootSystem] at hα hβ
  have hβα : β = (t.simplyConnectedRootDatum ht).reflectionPerm α α :=
    (t.simplyConnectedRootDatum ht).root.injective (by
      rw [RootPairing.root_reflectionPerm_self]
      exact eq_neg_of_add_eq_zero_right h₀)
  exact reflectionPerm_self_notMem_negRoots _ _ hα (hβα ▸ hβ)

/-- A generator at a negative root whose negative is taller than `-α` and `-β` lies in the join
of the root generators of such roots. -/
private theorem mk_steinbergRoot_mem_iSup_negHeight {α β δ : Fin t.numRoots}
    (hd : δ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hheight : max (negHeight t ht α) (negHeight t ht β) < negHeight t ht δ) (w : A) :
    PresentedGroup.mk (t.steinbergRelators ht A) (steinbergRoot δ w) ∈
      ⨆ γ ∈ {γ ∈ negRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max (negHeight t ht α) (negHeight t ht β) < negHeight t ht γ},
        (t.steinbergRootSubgroup ht A γ).range :=
  (le_iSup₂ (f := fun γ _ => (t.steinbergRootSubgroup ht A γ).range) δ
    (Finset.mem_filter.mpr ⟨(mem_negRootsFinset _ _ δ).mpr hd, hheight⟩))
    ⟨ofAdd w, t.steinbergRootSubgroup_ofAdd ht A δ w⟩

/-- The commutator of two negative root generators is a product of generators at negative roots
whose negatives are strictly taller than those of the two roots. -/
private theorem commutatorElement_mem_iSup_negHeight {α β : Fin t.numRoots}
    (hα : α ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht)) (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ ∈
      ⨆ γ ∈ {γ ∈ negRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max (negHeight t ht α) (negHeight t ht β) < negHeight t ht γ},
        (t.steinbergRootSubgroup ht A γ).range := by
  by_cases hsum : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∈
      Set.range (t.simplyConnectedRootDatum ht).root
  · obtain ⟨γ, hγ⟩ := hsum
    refine commutatorElement_mem_of_root_eq_add hγ (fun δ j k hj hk hδ w => ?_) u v
    -- Negating, `-δ = j(-α) + k(-β)` is a positive root taller than `-α` and `-β`.
    have h := mem_posRoots_and_max_height_lt
      ((reflectionPerm_self_mem_posRoots_iff_mem_negRoots _ _ α).mpr hα)
      ((reflectionPerm_self_mem_posRoots_iff_mem_negRoots _ _ β).mpr hβ)
      hj hk (δ := (t.rationalRootSystem ht).reflectionPerm δ δ) (by
        simp only [RootPairing.root_reflectionPerm_self, hδ, smul_neg, neg_add])
    exact mk_steinbergRoot_mem_iSup_negHeight
      ((reflectionPerm_self_mem_posRoots_iff_mem_negRoots _ _ δ).mp h.1) h.2 w
  · -- Without a root sum the generators commute.
    rw [commutatorElement_eq_one_of_mem_negRoots hα hβ hsum u v]
    exact Subgroup.one_mem _

/-! ## Collection in the negative subgroup -/

variable (t ht A) in
/-- The negative subgroup as a join indexed by the finite set of negative roots. -/
private theorem steinbergNegativeSubgroup_eq_biSup_negRootsFinset :
    t.steinbergNegativeSubgroup ht A =
      ⨆ γ ∈ negRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht),
        (t.steinbergRootSubgroup ht A γ).range := by
  simp only [steinbergNegativeSubgroup_def, mem_negRootsFinset]

/-- **Ordered products in the negative subgroup of Steinberg's presented group.** Every element
of `Û⁻` is a product `∏_{γ ∈ l} X_γ(u_γ)` with one generator per negative root, for every
enumeration `l` of the negative roots without repetitions. Only the additivity and commutator
relations are used, so this holds over every commutative ring and in every characteristic. -/
theorem mem_steinbergNegativeSubgroup_iff_exists_list_prod {l : List (Fin t.numRoots)}
    (hl : l.Nodup)
    (hlneg : ∀ γ, γ ∈ l ↔ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    {g : PresentedGroup (t.steinbergRelators ht A)} :
    g ∈ t.steinbergNegativeSubgroup ht A ↔
      ∃ u : Fin t.numRoots → A,
        (l.map fun γ => t.steinbergRootSubgroup ht A γ (ofAdd (u γ))).prod = g := by
  classical
  rw [steinbergNegativeSubgroup_eq_biSup_negRootsFinset]
  refine mem_biSup_range_iff_exists_list_prod_map (ht := negHeight t ht)
    (fun r hr s hs _ => ?_) hl fun γ => (hlneg γ).trans (mem_negRootsFinset _ _ γ).symm
  refine Subgroup.commutator_le.mpr fun _ ⟨x, hx⟩ _ ⟨y, hy⟩ => ?_
  subst hx hy
  exact commutatorElement_mem_iSup_negHeight ((mem_negRootsFinset _ _ _).mp hr)
    ((mem_negRootsFinset _ _ _).mp hs) x.toAdd y.toAdd

/-! ## Steinberg's homomorphism on the negative subgroup -/

namespace ChevalleyDatum

variable (D : ChevalleyDatum t ht) (A)

/-- **Steinberg's homomorphism maps `Û⁻` onto the negative points** of every Chevalley datum. -/
@[simp]
theorem map_steinbergLift_steinbergNegativeSubgroup :
    (t.steinbergNegativeSubgroup ht A).map (D.steinbergLift A) = D.negativePoints A := by
  simp only [steinbergNegativeSubgroup_def, Subgroup.map_iSup, MonoidHom.map_range,
    steinbergLift_comp_steinbergRootSubgroup, negativePoints_eq_iSup]

end ChevalleyDatum

variable (A) in
/-- **Steinberg's homomorphism is injective on `Û⁻` for `G_sc(t)`.** Two elements of the negative
subgroup of the presented group with the same image in the simply connected Chevalley group are
equal, over every commutative ring. -/
theorem injOn_steinbergLift_steinbergNegativeSubgroup :
    Set.InjOn ((t.scChevalleyDatum ht).steinbergLift A) (t.steinbergNegativeSubgroup ht A) := by
  classical
  let S := negRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht)
  have hlneg (γ : Fin t.numRoots) :
      γ ∈ S.toList ↔ γ ∈ negRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
    rw [Finset.mem_toList, mem_negRootsFinset]
  intro g hg g' hg' hgg'
  obtain ⟨u, rfl⟩ :=
    (mem_steinbergNegativeSubgroup_iff_exists_list_prod S.nodup_toList hlneg).mp hg
  obtain ⟨v, rfl⟩ :=
    (mem_steinbergNegativeSubgroup_iff_exists_list_prod S.nodup_toList hlneg).mp hg'
  have hlift (w : Fin t.numRoots → A) :
      (t.scChevalleyDatum ht).steinbergLift A
          (S.toList.map fun γ => t.steinbergRootSubgroup ht A γ (ofAdd (w γ))).prod =
        (S.toList.map fun γ =>
          (t.scChevalleyDatum ht).rootSubgroupPoints γ A (ofAdd (w γ))).prod := by
    rw [map_list_prod, List.map_map]
    congr 1
    refine List.map_congr_left fun γ _ => ?_
    simp only [Function.comp_apply, steinbergRootSubgroup_apply, toAdd_ofAdd]
    exact (t.scChevalleyDatum ht).steinbergLift_of A γ (w γ)
  rw [hlift, hlift, list_prod_map_scChevalleyDatum_rootSubgroupPoints_inj_of_mem_negRoots t ht A
    S.nodup_toList (fun γ hγ => (hlneg γ).mp hγ)] at hgg'
  exact congrArg List.prod (List.map_congr_left fun γ hγ => by rw [hgg' γ hγ])

variable (t ht A) in
/-- **The negative subgroup `Û⁻` of Steinberg's presented group is isomorphic to the negative
points `U⁻(A)` of `G_sc(t)`**, through Steinberg's homomorphism `X_γ(u) ↦ x_γ(u)`, over every
commutative ring. -/
noncomputable def steinbergNegativeSubgroupEquiv :
    t.steinbergNegativeSubgroup ht A ≃* (t.scChevalleyDatum ht).negativePoints A :=
  (MonoidHom.ofInjective (f := ((t.scChevalleyDatum ht).steinbergLift A).domRestrict
      (t.steinbergNegativeSubgroup ht A)) fun g g' h =>
    Subtype.ext (injOn_steinbergLift_steinbergNegativeSubgroup A g.property g'.property h)).trans
    (MulEquiv.subgroupCongr (by
      rw [MonoidHom.domRestrict_range,
        ChevalleyDatum.map_steinbergLift_steinbergNegativeSubgroup]))

/-- The isomorphism `Û⁻ ≃* U⁻(A)` is Steinberg's homomorphism. -/
@[simp]
theorem coe_steinbergNegativeSubgroupEquiv_apply (g : t.steinbergNegativeSubgroup ht A) :
    (t.steinbergNegativeSubgroupEquiv ht A g : (t.scChevalleyDatum ht).points A) =
      (t.scChevalleyDatum ht).steinbergLift A g :=
  (rfl)

end TauCeti.DynkinType
