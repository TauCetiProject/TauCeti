/-!
# Root-set subgroups of Steinberg's presented group

For a valid Dynkin type `t`, a commutative ring `A` and a set `S` of roots, let `St` be the group
presented by Steinberg's relations, `TauCeti.DynkinType.steinbergRelators`, and `Û_S` its subgroup
generated by the generators `X_γ(u)` at the roots `γ ∈ S`. Steinberg's homomorphism
`X_γ(u) ↦ x_γ(u)` maps `Û_S` onto the matching root-set subgroup `U_S(A)` of every Chevalley datum.

When `S` is the set of roots of positive degree for a degree map on integral weights, as are the
positive roots for the height degree and the negative roots for its negative, the relations of
`St` force on `Û_S` the structure of `U_S(A)`:

* every element of `Û_S` is an ordered product `∏_{γ ∈ S} X_γ(u_γ)`, in any fixed enumeration of
  `S`;
* for the full-weight datum of `G_sc(t)`, Steinberg's homomorphism is injective on `Û_S`, so
  `Û_S ≅ U_S(A)`.

The commutator of the generators at roots `α, β ∈ S` lies, by
`TauCeti.DynkinType.commutatorElement_mem_of_root_eq_add`, in the subgroup generated by the
generators at the roots `jα + kβ` with `j, k > 0`; these have degree larger than those of `α` and
`β`, so they lie in `S`. If `α + β` is not a root, it is not zero either, since its degree is
positive, and the generators commute. Grading the roots by degree, the generic collection theorem
`TauCeti.mem_biSup_range_iff_exists_list_prod_map` therefore applies. The injectivity combines the
ordered products with their uniqueness in `G_sc(t)`,
`TauCeti.DynkinType.list_prod_map_scChevalleyDatum_rootSubgroupPoints_inj_of_degree`.

## Main definitions

* `TauCeti.DynkinType.steinbergSubsystemSubgroup`: the subgroup `Û_S` of the presented group.
* `TauCeti.DynkinType.steinbergSubsystemSubgroupEquiv`: the isomorphism `Û_S ≃* U_S(A)` onto the
  root-set points of `G_sc(t)`, for `S` the roots of positive degree.

## Main results

* `TauCeti.DynkinType.ChevalleyDatum.map_steinbergLift_steinbergSubsystemSubgroup`: Steinberg's
  homomorphism maps `Û_S` onto the root-set points of a Chevalley datum.
* `TauCeti.DynkinType.mem_steinbergSubsystemSubgroup_iff_exists_list_prod`: for `S` the roots of
  positive degree, every element of `Û_S` is an ordered product of generators at the roots of `S`.
* `TauCeti.DynkinType.injOn_steinbergLift_steinbergSubsystemSubgroup`: for `S` the roots of
  positive degree, Steinberg's homomorphism to `G_sc(t)` is injective on `Û_S`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17, and Chapter 6, proof of
  Theorem 8.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.3.3 and Chapter 12.
-/

public section

open scoped commutatorElement
open Multiplicative

namespace TauCeti.DynkinType

universe u

/-! ## The root-set subgroup -/

section Definition

variable (t : DynkinType) (ht : t.Valid) (A : Type u) [CommRing A]

/-- **The subgroup `Û_S` of Steinberg's presented group generated by a root set `S`**: the
subgroup generated by the generators `X_γ(u)` at the roots `γ ∈ S`. -/
def steinbergSubsystemSubgroup (S : Set (Fin t.numRoots)) :
    Subgroup (PresentedGroup (t.steinbergRelators ht A)) :=
  ⨆ γ ∈ S, (t.steinbergRootSubgroup ht A γ).range

/-- The root-set subgroup is the join of the ranges of its root generators. -/
theorem steinbergSubsystemSubgroup_def (S : Set (Fin t.numRoots)) :
    t.steinbergSubsystemSubgroup ht A S = ⨆ γ ∈ S, (t.steinbergRootSubgroup ht A γ).range :=
  (rfl)

variable {t ht A} in
/-- Each generator at a root of `S` lies in the root-set subgroup. -/
-- Not `@[simp]`: `steinbergRootSubgroup_apply` rewrites the generator first.
theorem steinbergRootSubgroup_mem_steinbergSubsystemSubgroup {S : Set (Fin t.numRoots)}
    {γ : Fin t.numRoots} (hγ : γ ∈ S) (a : Multiplicative A) :
    t.steinbergRootSubgroup ht A γ a ∈ t.steinbergSubsystemSubgroup ht A S :=
  le_iSup₂ (f := fun γ _ => (t.steinbergRootSubgroup ht A γ).range) γ hγ ⟨a, rfl⟩

variable {t ht A} in
/-- Containment of the root-set subgroup can be checked on its root generators. -/
theorem steinbergSubsystemSubgroup_le_iff {S : Set (Fin t.numRoots)}
    {H : Subgroup (PresentedGroup (t.steinbergRelators ht A))} :
    t.steinbergSubsystemSubgroup ht A S ≤ H ↔
      ∀ γ ∈ S, ∀ a, t.steinbergRootSubgroup ht A γ a ∈ H := by
  simp only [steinbergSubsystemSubgroup_def, iSup₂_le_iff]
  exact forall₂_congr fun γ _ => ⟨fun h a => h ⟨a, rfl⟩, fun h _ ⟨a, ha⟩ => ha ▸ h a⟩

end Definition

namespace ChevalleyDatum

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht) (A : Type u) [CommRing A]

/-- **Steinberg's homomorphism maps `Û_S` onto the root-set points `U_S(A)`** of every Chevalley
datum. -/
@[simp]
theorem map_steinbergLift_steinbergSubsystemSubgroup (S : Set (Fin t.numRoots)) :
    (t.steinbergSubsystemSubgroup ht A S).map (D.steinbergLift A) = D.subsystemPoints S A := by
  simp only [steinbergSubsystemSubgroup_def, Subgroup.map_iSup, MonoidHom.map_range,
    steinbergLift_comp_steinbergRootSubgroup, subsystemPoints_eq_iSup]

end ChevalleyDatum

/-! ## Collection for the roots of positive degree -/

variable {t : DynkinType} {ht : t.Valid} {A : Type u} [CommRing A]

/-- For roots `α`, `β` of positive degree, a root `δ = jα + kβ` with `j, k > 0` has degree larger
than those of `α` and `β`. -/
private theorem max_lt_degree_of_root_eq_nsmul_add (degree : (Fin t.rank → ℤ) →+ ℚ)
    {α β δ : Fin t.numRoots} {j k : ℕ}
    (hα : 0 < degree ((t.simplyConnectedRootDatum ht).root α))
    (hβ : 0 < degree ((t.simplyConnectedRootDatum ht).root β)) (hj : 0 < j) (hk : 0 < k)
    (hδ : (t.rationalRootSystem ht).root δ =
      j • (t.rationalRootSystem ht).root α + k • (t.rationalRootSystem ht).root β) :
    max (degree ((t.simplyConnectedRootDatum ht).root α))
        (degree ((t.simplyConnectedRootDatum ht).root β)) <
      degree ((t.simplyConnectedRootDatum ht).root δ) := by
  have hj' : (1 : ℚ) ≤ j := by exact_mod_cast hj
  have hk' : (1 : ℚ) ≤ k := by exact_mod_cast hk
  rw [(t.root_rationalRootSystem_eq_nsmul_add_nsmul_iff ht α β δ j k).mp hδ, map_add, map_nsmul,
    map_nsmul, nsmul_eq_mul, nsmul_eq_mul, max_lt_iff]
  constructor <;> nlinarith

/-- **Ordered products in a root-set subgroup of Steinberg's presented group.** If `S` is the set
of roots of positive degree for a degree map on integral weights, every element of `Û_S` is a
product `∏_{γ ∈ l} X_γ(u_γ)` with one generator per root of `S`, for every enumeration `l` of `S`
without repetitions. Only the additivity and commutator relations are used, so this holds over
every commutative ring and in every characteristic. -/
theorem mem_steinbergSubsystemSubgroup_iff_exists_list_prod {S : Set (Fin t.numRoots)}
    (degree : (Fin t.rank → ℤ) →+ ℚ)
    (hS : ∀ γ, 0 < degree ((t.simplyConnectedRootDatum ht).root γ) ↔ γ ∈ S)
    {l : List (Fin t.numRoots)} (hl : l.Nodup) (hlS : ∀ γ, γ ∈ l ↔ γ ∈ S)
    {g : PresentedGroup (t.steinbergRelators ht A)} :
    g ∈ t.steinbergSubsystemSubgroup ht A S ↔
      ∃ u : Fin t.numRoots → A,
        (l.map fun γ => t.steinbergRootSubgroup ht A γ (ofAdd (u γ))).prod = g := by
  classical
  set R := t.simplyConnectedRootDatum ht
  have hS' : t.steinbergSubsystemSubgroup ht A S =
      ⨆ γ ∈ l.toFinset, (t.steinbergRootSubgroup ht A γ).range := by
    simp only [steinbergSubsystemSubgroup_def, List.mem_toFinset, hlS]
  rw [hS']
  refine mem_biSup_range_iff_exists_list_prod_map (ht := fun γ => degree (R.root γ))
    (fun r hr s hs _ => ?_) hl fun γ => List.mem_toFinset.symm
  rw [List.mem_toFinset, hlS, ← hS] at hr hs
  refine Subgroup.commutator_le.mpr fun _ ⟨x, hx⟩ _ ⟨y, hy⟩ => ?_
  subst hx hy
  obtain ⟨u, rfl⟩ : ∃ u, ofAdd u = x := ⟨x.toAdd, rfl⟩
  obtain ⟨v, rfl⟩ : ∃ v, ofAdd v = y := ⟨y.toAdd, rfl⟩
  by_cases hsum : R.root r + R.root s ∈ Set.range R.root
  · -- The commutator is a product of generators at roots of larger degree.
    obtain ⟨γ, hγ⟩ := hsum
    refine commutatorElement_mem_of_root_eq_add hγ (fun δ j k hj hk hδ w => ?_) u v
    have hmax := max_lt_degree_of_root_eq_nsmul_add degree hr hs hj hk hδ
    have hδS : δ ∈ l.toFinset := by
      rw [List.mem_toFinset, hlS, ← hS]
      exact hr.trans_le ((le_max_left _ _).trans hmax.le)
    exact le_iSup₂ (f := fun γ _ => (t.steinbergRootSubgroup ht A γ).range) δ
      (Finset.mem_filter.mpr ⟨hδS, hmax⟩) ⟨ofAdd w, t.steinbergRootSubgroup_ofAdd ht A δ w⟩
  · -- Without a root sum the generators commute: the sum has positive degree, so is not zero.
    rw [commutatorElement_eq_one_of_root_add_notMem_range hsum (fun h₀ => by
      have h := congrArg degree h₀
      rw [map_add, map_zero] at h
      linarith) u v]
    exact Subgroup.one_mem _

/-! ## Steinberg's homomorphism on the root-set subgroup -/

variable (A) in
/-- **Steinberg's homomorphism is injective on `Û_S` for `G_sc(t)`** when `S` is the set of roots
of positive degree for a degree map on integral weights. Two elements of `Û_S` with the same image
in the simply connected Chevalley group are equal, over every commutative ring. -/
theorem injOn_steinbergLift_steinbergSubsystemSubgroup {S : Set (Fin t.numRoots)}
    (degree : (Fin t.rank → ℤ) →+ ℚ)
    (hS : ∀ γ, 0 < degree ((t.simplyConnectedRootDatum ht).root γ) ↔ γ ∈ S) :
    Set.InjOn ((t.scChevalleyDatum ht).steinbergLift A) (t.steinbergSubsystemSubgroup ht A S) := by
  classical
  let l := (Finset.univ.filter (· ∈ S)).toList
  have hlS (γ : Fin t.numRoots) : γ ∈ l ↔ γ ∈ S := by
    simp only [l, Finset.mem_toList, Finset.mem_filter, Finset.mem_univ, true_and]
  intro g hg g' hg' hgg'
  obtain ⟨u, rfl⟩ :=
    (mem_steinbergSubsystemSubgroup_iff_exists_list_prod degree hS (Finset.nodup_toList _)
      hlS).mp hg
  obtain ⟨v, rfl⟩ :=
    (mem_steinbergSubsystemSubgroup_iff_exists_list_prod degree hS (Finset.nodup_toList _)
      hlS).mp hg'
  have hlift (w : Fin t.numRoots → A) :
      (t.scChevalleyDatum ht).steinbergLift A
          (l.map fun γ => t.steinbergRootSubgroup ht A γ (ofAdd (w γ))).prod =
        (l.map fun γ => (t.scChevalleyDatum ht).rootSubgroupPoints γ A (ofAdd (w γ))).prod := by
    rw [map_list_prod, List.map_map]
    congr 1
    refine List.map_congr_left fun γ _ => ?_
    simp only [Function.comp_apply, steinbergRootSubgroup_apply, toAdd_ofAdd]
    exact (t.scChevalleyDatum ht).steinbergLift_of A γ (w γ)
  rw [hlift, hlift, list_prod_map_scChevalleyDatum_rootSubgroupPoints_inj_of_degree t ht A
    (Finset.nodup_toList _) degree fun γ hγ => (hS γ).mpr ((hlS γ).mp hγ)] at hgg'
  exact congrArg List.prod (List.map_congr_left fun γ hγ => by rw [hgg' γ hγ])

variable (t ht A) in
/-- **The root-set subgroup `Û_S` of Steinberg's presented group is isomorphic to the root-set
points `U_S(A)` of `G_sc(t)`** when `S` is the set of roots of positive degree for a degree map on
integral weights, through Steinberg's homomorphism `X_γ(u) ↦ x_γ(u)`, over every commutative
ring. -/
noncomputable def steinbergSubsystemSubgroupEquiv (S : Set (Fin t.numRoots))
    (degree : (Fin t.rank → ℤ) →+ ℚ)
    (hS : ∀ γ, 0 < degree ((t.simplyConnectedRootDatum ht).root γ) ↔ γ ∈ S) :
    t.steinbergSubsystemSubgroup ht A S ≃* (t.scChevalleyDatum ht).subsystemPoints S A :=
  (MonoidHom.ofInjective (f := ((t.scChevalleyDatum ht).steinbergLift A).domRestrict
      (t.steinbergSubsystemSubgroup ht A S)) fun g g' h =>
    Subtype.ext (injOn_steinbergLift_steinbergSubsystemSubgroup A degree hS g.property
      g'.property h)).trans
    (MulEquiv.subgroupCongr (by
      rw [MonoidHom.domRestrict_range,
        ChevalleyDatum.map_steinbergLift_steinbergSubsystemSubgroup]))

/-- The isomorphism `Û_S ≃* U_S(A)` is Steinberg's homomorphism. -/
@[simp]
theorem coe_steinbergSubsystemSubgroupEquiv_apply {S : Set (Fin t.numRoots)}
    {degree : (Fin t.rank → ℤ) →+ ℚ}
    {hS : ∀ γ, 0 < degree ((t.simplyConnectedRootDatum ht).root γ) ↔ γ ∈ S}
    (g : t.steinbergSubsystemSubgroup ht A S) :
    (t.steinbergSubsystemSubgroupEquiv ht A S degree hS g : (t.scChevalleyDatum ht).points A) =
      (t.scChevalleyDatum ht).steinbergLift A g :=
  (rfl)

end TauCeti.DynkinType
