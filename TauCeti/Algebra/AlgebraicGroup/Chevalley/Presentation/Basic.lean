public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Root.Weyl

/-!
# Steinberg's relations for Chevalley groups

For a valid Dynkin type `t` and a commutative ring `A`, this file defines the relators of
Steinberg's presentation of the simply connected Chevalley group. The generators are symbols
`X_γ(u)`, one for every root `γ` (numbered by `Fin t.numRoots`) and every `u : A`, and the
relators are:

* **additivity**, `X_γ(u) X_γ(v) = X_γ(u + v)`;
* **Chevalley's commutator formula** `⁅X_α(u), X_β(v)⁆ = ∏ X_{iα+jβ}(c_{ij} uⁱ vʲ)` for roots
  `α ≠ -β`, in the convention `⁅x, y⁆ = x y x⁻¹ y⁻¹`, with the coefficients `c_{ij}` given by the
  structure constants `N_{α,β}` of the pinned Chevalley system. It is imposed case by case, in the
  shapes in which `TauCeti.Algebra.AlgebraicGroup.Chevalley.Commutator.Basic` and
  `TauCeti.Algebra.AlgebraicGroup.Chevalley.Commutator.G2` prove it: commuting root subgroups when
  `α + β` is neither a root nor zero, one factor, the two root strings with two factors, and the
  three families of type `G₂` with three or four factors. As recorded in those two files, these
  shapes cover every pair of roots `α ≠ -β`;
* **Steinberg's rank-one relation** `W_γ(s) X_γ(u) W_γ(s)⁻¹ = X_{-γ}(-s⁻² u)` for every unit
  `s`, where `W_γ(s) = X_γ(s) X_{-γ}(-s⁻¹) X_γ(s)`;
* **multiplicativity of the coroot words**, `H_γ(s) H_γ(s') = H_γ(s s')` for units `s` and `s'`,
  where `H_γ(s) = W_γ(s) W_γ(1)⁻¹`.

Steinberg imposes the rank-one relation only in rank one, where the commutator formula is empty;
imposing it at every root adds relations that hold in every Chevalley group.

For every Chevalley datum `D`, sending `X_γ(u)` to the root element `x_γ(u)` respects all of these
relators, over every commutative ring. This gives a homomorphism
`ChevalleyDatum.steinbergLift` from the presented group to the points of `D`, whose range is the
elementary subgroup generated by the root subgroups. Steinberg's theorem is that for the simply
connected datum and a field this homomorphism is injective, so that the presented group is a
presentation of the elementary subgroup; that injectivity is not proved here.

## Main definitions

* `TauCeti.DynkinType.IsSteinbergRelator`: the relators of Steinberg's presentation.
* `TauCeti.DynkinType.steinbergRelators`: the set of these relators.
* `TauCeti.DynkinType.steinbergRootSubgroup`: the root subgroups `X_γ` of the presented group.
* `TauCeti.DynkinType.ChevalleyDatum.steinbergLift`: the homomorphism `X_γ(u) ↦ x_γ(u)` from the
  presented group to the points of a Chevalley datum.

## Main results

* `TauCeti.DynkinType.commutatorElement_eq_of_isSteinbergRelator`: a commutator relator gives the
  corresponding equation between root generators in the presented group;
  `TauCeti.DynkinType.commutatorElement_eq_one_of_root_add_notMem_range` is its commuting case.
* `TauCeti.DynkinType.ChevalleyDatum.lift_eq_one_of_isSteinbergRelator`: every relator holds among
  the root elements of every Chevalley datum over every commutative ring.
* `TauCeti.DynkinType.ChevalleyDatum.range_steinbergLift`: the range of `steinbergLift` is the
  elementary subgroup.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 15, 19 and 20, and Chapter 6,
  Theorem 8.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.2.2 and Chapter 12.
-/

public section

open scoped commutatorElement
open Multiplicative

namespace TauCeti.DynkinType

universe u

/-- The generator `X_γ(u)` of Steinberg's presentation: the letter `(γ, u)` of the free group. -/
abbrev steinbergRoot {t : DynkinType} {A : Type u} (γ : Fin t.numRoots) (a : A) :
    FreeGroup (Fin t.numRoots × A) :=
  FreeGroup.of (γ, a)

/-- Steinberg's word `W_γ(s) = X_γ(s) X_{-γ}(-s⁻¹) X_γ(s)` of a root `γ` and a unit `s`, in the
free group on the generators of Steinberg's presentation. -/
noncomputable def steinbergWeylWord {t : DynkinType} (ht : t.Valid) {A : Type u} [CommRing A]
    (γ : Fin t.numRoots) (s : Aˣ) : FreeGroup (Fin t.numRoots × A) :=
  steinbergRoot γ (s : A) *
    steinbergRoot ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) (-((s⁻¹ : Aˣ) : A)) *
    steinbergRoot γ (s : A)

theorem steinbergWeylWord_def {t : DynkinType} (ht : t.Valid) {A : Type u} [CommRing A]
    (γ : Fin t.numRoots) (s : Aˣ) :
    steinbergWeylWord ht γ s =
      steinbergRoot γ (s : A) *
        steinbergRoot ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ) (-((s⁻¹ : Aˣ) : A)) *
        steinbergRoot γ (s : A) :=
  (rfl)

/-- **The relators of Steinberg's presentation** of the Chevalley group of a Dynkin type `t` over
a commutative ring `A`: additivity of every root generator, Chevalley's commutator formula for
roots `α ≠ -β` in each of its shapes, Steinberg's rank-one relation, and multiplicativity of the
coroot words `H_γ(s) = W_γ(s) W_γ(1)⁻¹`. Each relator `r` stands for the relation `r = 1`. The
type `t` is an index so that the three families of type `G₂` are stated on `G₂` alone. -/
inductive IsSteinbergRelator (A : Type u) [CommRing A] :
    (t : DynkinType) → t.Valid → FreeGroup (Fin t.numRoots × A) → Prop
  /-- Additivity: `X_γ(u) X_γ(v) = X_γ(u + v)`. -/
  | add {t : DynkinType} {ht : t.Valid} (γ : Fin t.numRoots) (u v : A) :
      IsSteinbergRelator A t ht
        (steinbergRoot γ u * steinbergRoot γ v * (steinbergRoot γ (u + v))⁻¹)
  /-- Root generators commute when the sum of the roots is neither a root nor zero. -/
  | commute {t : DynkinType} {ht : t.Valid} {α β : Fin t.numRoots}
      (h : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
        Set.range (t.simplyConnectedRootDatum ht).root)
      (h₀ : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ≠ 0)
      (u v : A) :
      IsSteinbergRelator A t ht ⁅steinbergRoot α u, steinbergRoot β v⁆
  /-- The one-factor commutator formula `⁅X_α(u), X_β(v)⁆ = X_γ(N_{α,β} u v)` when `γ = α + β` is
  a root while `2α + β` and `α + 2β` are not. -/
  | commutator_add {t : DynkinType} {ht : t.Valid} {α β γ : Fin t.numRoots}
      (hγ : (t.simplyConnectedRootDatum ht).root γ =
        (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
      (hα : 2 • (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
        Set.range (t.simplyConnectedRootDatum ht).root)
      (hβ : (t.simplyConnectedRootDatum ht).root α + 2 • (t.simplyConnectedRootDatum ht).root β ∉
        Set.range (t.simplyConnectedRootDatum ht).root)
      (u v : A) :
      IsSteinbergRelator A t ht (⁅steinbergRoot α u, steinbergRoot β v⁆ *
        (steinbergRoot γ ((t.structureConstant ht α β : A) * (u * v)))⁻¹)
  /-- The two-factor commutator formula along the root string `β`, `α + β`, `2α + β`. -/
  | commutator_two_nsmul_add {t : DynkinType} {ht : t.Valid} {α β γ δ : Fin t.numRoots}
      (hγ : (t.simplyConnectedRootDatum ht).root γ =
        (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
      (hδ : (t.simplyConnectedRootDatum ht).root δ =
        2 • (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
      (hα : 3 • (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
        Set.range (t.simplyConnectedRootDatum ht).root)
      (hβ : (t.simplyConnectedRootDatum ht).root α + 2 • (t.simplyConnectedRootDatum ht).root β ∉
        Set.range (t.simplyConnectedRootDatum ht).root)
      (u v : A) :
      IsSteinbergRelator A t ht (⁅steinbergRoot α u, steinbergRoot β v⁆ *
        (steinbergRoot γ ((t.structureConstant ht α β : A) * (u * v)) *
          steinbergRoot δ (((t.structureConstant ht α β * t.structureConstant ht α γ / 2 : ℤ) : A) *
            (u ^ 2 * v)))⁻¹)
  /-- The two-factor commutator formula along the root string `α`, `α + β`, `α + 2β`. -/
  | commutator_add_two_nsmul {t : DynkinType} {ht : t.Valid} {α β γ δ : Fin t.numRoots}
      (hγ : (t.simplyConnectedRootDatum ht).root γ =
        (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
      (hδ : (t.simplyConnectedRootDatum ht).root δ =
        (t.simplyConnectedRootDatum ht).root α + 2 • (t.simplyConnectedRootDatum ht).root β)
      (hα : 2 • (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
        Set.range (t.simplyConnectedRootDatum ht).root)
      (hβ : (t.simplyConnectedRootDatum ht).root α + 3 • (t.simplyConnectedRootDatum ht).root β ∉
        Set.range (t.simplyConnectedRootDatum ht).root)
      (u v : A) :
      IsSteinbergRelator A t ht (⁅steinbergRoot α u, steinbergRoot β v⁆ *
        (steinbergRoot γ ((t.structureConstant ht α β : A) * (u * v)) *
          steinbergRoot δ
            ((-(t.structureConstant ht β α * t.structureConstant ht β γ / 2) : ℤ) *
              (u * v ^ 2)))⁻¹)
  /-- The three-factor commutator formula of type `G₂` for two short roots with short sum. -/
  | g2_short_pair {ht : G2.Valid} {i j k l m : Fin G2.numRoots}
      (hi : g2Length i = 1) (hj : g2Length j = 1) (hk : g2Length k = 1)
      (hij : (G2.simplyConnectedRootDatum ht).root k =
        (G2.simplyConnectedRootDatum ht).root i + (G2.simplyConnectedRootDatum ht).root j)
      (hik : (G2.simplyConnectedRootDatum ht).root l =
        (G2.simplyConnectedRootDatum ht).root i + (G2.simplyConnectedRootDatum ht).root k)
      (hkj : (G2.simplyConnectedRootDatum ht).root m =
        (G2.simplyConnectedRootDatum ht).root k + (G2.simplyConnectedRootDatum ht).root j)
      (u v : A) :
      IsSteinbergRelator A G2 ht (⁅steinbergRoot i u, steinbergRoot j v⁆ *
        (steinbergRoot k (((G2.structureConstant ht i j / 2 : ℤ) : A) * (2 * u * v)) *
          steinbergRoot l
            (((G2.structureConstant ht i j / 2 * (G2.structureConstant ht i k / 3) : ℤ) : A) *
              (3 * u ^ 2 * v)) *
          steinbergRoot m
            (-((G2.structureConstant ht i j / 2 * (G2.structureConstant ht k j / 3) : ℤ) : A) *
              (3 * u * v ^ 2)))⁻¹)
  /-- The four-factor commutator formula of type `G₂`, short root first. -/
  | g2_short_long {ht : G2.Valid} {α β γ δ ε ζ : Fin G2.numRoots}
      (hγ : (G2.simplyConnectedRootDatum ht).root γ =
        (G2.simplyConnectedRootDatum ht).root α + (G2.simplyConnectedRootDatum ht).root β)
      (hδ : (G2.simplyConnectedRootDatum ht).root δ =
        (G2.simplyConnectedRootDatum ht).root α + (G2.simplyConnectedRootDatum ht).root γ)
      (hε : (G2.simplyConnectedRootDatum ht).root ε =
        (G2.simplyConnectedRootDatum ht).root α + (G2.simplyConnectedRootDatum ht).root δ)
      (hζ : (G2.simplyConnectedRootDatum ht).root ζ =
        (G2.simplyConnectedRootDatum ht).root δ + (G2.simplyConnectedRootDatum ht).root γ)
      (u v : A) :
      IsSteinbergRelator A G2 ht (⁅steinbergRoot α u, steinbergRoot β v⁆ *
        (steinbergRoot γ ((G2.structureConstant ht α β : A) * (u * v)) *
          steinbergRoot δ
            (((G2.structureConstant ht α β * (G2.structureConstant ht α γ / 2) : ℤ) : A) *
              (u ^ 2 * v)) *
          steinbergRoot ε
            (((G2.structureConstant ht α β * (G2.structureConstant ht α γ / 2) *
                (G2.structureConstant ht α δ / 3) : ℤ) : A) * (u ^ 3 * v)) *
          steinbergRoot ζ
            (((2 * (G2.structureConstant ht α β * (G2.structureConstant ht α γ / 2) *
                G2.structureConstant ht α β * (G2.structureConstant ht δ γ / 3)) : ℤ) : A) *
              (u ^ 3 * v ^ 2)))⁻¹)
  /-- The four-factor commutator formula of type `G₂`, long root first. -/
  | g2_long_short {ht : G2.Valid} {α β γ δ ε ζ : Fin G2.numRoots}
      (hγ : (G2.simplyConnectedRootDatum ht).root γ =
        (G2.simplyConnectedRootDatum ht).root α + (G2.simplyConnectedRootDatum ht).root β)
      (hδ : (G2.simplyConnectedRootDatum ht).root δ =
        (G2.simplyConnectedRootDatum ht).root α + (G2.simplyConnectedRootDatum ht).root γ)
      (hε : (G2.simplyConnectedRootDatum ht).root ε =
        (G2.simplyConnectedRootDatum ht).root α + (G2.simplyConnectedRootDatum ht).root δ)
      (hζ : (G2.simplyConnectedRootDatum ht).root ζ =
        (G2.simplyConnectedRootDatum ht).root δ + (G2.simplyConnectedRootDatum ht).root γ)
      (u v : A) :
      IsSteinbergRelator A G2 ht (⁅steinbergRoot β v, steinbergRoot α u⁆ *
        (steinbergRoot γ (-(G2.structureConstant ht α β : A) * (u * v)) *
          steinbergRoot δ
            (-((G2.structureConstant ht α β * (G2.structureConstant ht α γ / 2) : ℤ) : A) *
              (u ^ 2 * v)) *
          steinbergRoot ε
            (-((G2.structureConstant ht α β * (G2.structureConstant ht α γ / 2) *
                (G2.structureConstant ht α δ / 3) : ℤ) : A) * (u ^ 3 * v)) *
          steinbergRoot ζ
            (((G2.structureConstant ht α β * (G2.structureConstant ht α γ / 2) *
                G2.structureConstant ht α β * (G2.structureConstant ht δ γ / 3) : ℤ) : A) *
              (u ^ 3 * v ^ 2)))⁻¹)
  /-- Steinberg's rank-one relation `W_γ(s) X_γ(u) W_γ(s)⁻¹ = X_{-γ}(-s⁻² u)`. -/
  | weyl_conj {t : DynkinType} {ht : t.Valid} (γ : Fin t.numRoots) (s : Aˣ) (u : A) :
      IsSteinbergRelator A t ht (steinbergWeylWord ht γ s * steinbergRoot γ u *
        (steinbergWeylWord ht γ s)⁻¹ *
        (steinbergRoot ((t.simplyConnectedRootDatum ht).reflectionPerm γ γ)
          (-(((s⁻¹ : Aˣ) : A) ^ 2 * u)))⁻¹)
  /-- Multiplicativity of the coroot words: `H_γ(s) H_γ(s') = H_γ(s s')` for
  `H_γ(s) = W_γ(s) W_γ(1)⁻¹`. -/
  | coroot_mul {t : DynkinType} {ht : t.Valid} (γ : Fin t.numRoots) (s s' : Aˣ) :
      IsSteinbergRelator A t ht (steinbergWeylWord ht γ s * (steinbergWeylWord ht γ 1)⁻¹ *
        (steinbergWeylWord ht γ s' * (steinbergWeylWord ht γ 1)⁻¹) *
        (steinbergWeylWord ht γ (s * s') * (steinbergWeylWord ht γ 1)⁻¹)⁻¹)

variable (t : DynkinType) (ht : t.Valid) (A : Type u) [CommRing A]

/-- The set of relators of Steinberg's presentation of the Chevalley group of type `t` over `A`. -/
def steinbergRelators : Set (FreeGroup (Fin t.numRoots × A)) :=
  {r | IsSteinbergRelator A t ht r}

@[simp]
theorem mem_steinbergRelators {r : FreeGroup (Fin t.numRoots × A)} :
    r ∈ t.steinbergRelators ht A ↔ IsSteinbergRelator A t ht r :=
  Iff.rfl

/-- **The root subgroups of Steinberg's presented group**: `u ↦ X_γ(u)` is a homomorphism by the
additivity relators. -/
def steinbergRootSubgroup (γ : Fin t.numRoots) :
    Multiplicative A →* PresentedGroup (t.steinbergRelators ht A) :=
  MonoidHom.mk' (fun a => PresentedGroup.of (γ, a.toAdd)) fun a b => by
    have h := PresentedGroup.one_of_mem (rels := t.steinbergRelators ht A)
      (IsSteinbergRelator.add γ a.toAdd b.toAdd)
    simp only [map_mul, map_inv, mul_inv_eq_one] at h
    exact h.symm

@[simp]
theorem steinbergRootSubgroup_apply (γ : Fin t.numRoots) (a : Multiplicative A) :
    t.steinbergRootSubgroup ht A γ a = PresentedGroup.of (γ, a.toAdd) :=
  (rfl)

variable {t ht A}

/-- A relator `⁅X_α(u), X_β(v)⁆ w⁻¹` of the presentation gives the equation
`⁅X_α(u), X_β(v)⁆ = w` in the presented group. -/
theorem commutatorElement_eq_of_isSteinbergRelator {α β : Fin t.numRoots} {u v : A}
    {w : FreeGroup (Fin t.numRoots × A)}
    (hr : IsSteinbergRelator A t ht (⁅steinbergRoot α u, steinbergRoot β v⁆ * w⁻¹)) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ =
      PresentedGroup.mk (t.steinbergRelators ht A) w := by
  rw [steinbergRootSubgroup_apply, steinbergRootSubgroup_apply, toAdd_ofAdd, toAdd_ofAdd,
    PresentedGroup.of, PresentedGroup.of, ← map_commutatorElement]
  exact PresentedGroup.mk_eq_mk_of_mul_inv_mem ((t.mem_steinbergRelators ht A).mpr hr)

/-- Root generators of the presented group commute when the sum of their roots is neither a root
nor zero. -/
theorem commutatorElement_eq_one_of_root_add_notMem_range {α β : Fin t.numRoots}
    (h : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (h₀ : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ≠ 0)
    (u v : A) :
    ⁅t.steinbergRootSubgroup ht A α (ofAdd u), t.steinbergRootSubgroup ht A β (ofAdd v)⁆ = 1 := by
  rw [steinbergRootSubgroup_apply, steinbergRootSubgroup_apply, toAdd_ofAdd, toAdd_ofAdd,
    PresentedGroup.of, PresentedGroup.of, ← map_commutatorElement]
  exact PresentedGroup.one_of_mem ((t.mem_steinbergRelators ht A).mpr (.commute h h₀ u v))

variable (t ht A)

namespace ChevalleyDatum

variable {t ht} (D : ChevalleyDatum t ht)

/-- Steinberg's word evaluates to Steinberg's element `n_γ(s)` of the datum. -/
@[simp]
theorem lift_steinbergWeylWord (γ : Fin t.numRoots) (s : Aˣ) :
    FreeGroup.lift (fun p : Fin t.numRoots × A => D.rootSubgroupPoints p.1 A (ofAdd p.2))
        (steinbergWeylWord ht γ s) =
      D.weylElement γ A s := by
  simp [steinbergWeylWord_def, weylElement_def]

/-- **Steinberg's relations hold in every Chevalley group.** Every relator of Steinberg's
presentation is trivial when each generator `X_γ(u)` is evaluated at the root element `x_γ(u)` of a
Chevalley datum, over every commutative ring. -/
theorem lift_eq_one_of_isSteinbergRelator {r : FreeGroup (Fin t.numRoots × A)}
    (hr : IsSteinbergRelator A t ht r) :
    FreeGroup.lift (fun p : Fin t.numRoots × A => D.rootSubgroupPoints p.1 A (ofAdd p.2)) r =
      1 := by
  -- Evaluate the free-group word letter by letter, then apply the relation in the datum.
  cases hr with
  | add γ u v => simp [ofAdd_add]
  | commute h h₀ u v =>
    simpa [map_commutatorElement, commutatorElement_eq_one_iff_commute] using
      D.commute_rootSubgroup h h₀ A u v
  | commutator_add hγ hα hβ u v =>
    simp only [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of]
    rw [D.commutatorElement_rootSubgroup_of_root_eq_add hγ hα hβ A u v, mul_inv_cancel]
  | commutator_two_nsmul_add hγ hδ hα hβ u v =>
    simp only [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of]
    rw [D.commutatorElement_rootSubgroup_of_root_eq_two_nsmul_add hγ hδ hα hβ A u v,
      mul_inv_cancel]
  | commutator_add_two_nsmul hγ hδ hα hβ u v =>
    simp only [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of]
    rw [D.commutatorElement_rootSubgroup_of_root_eq_add_two_nsmul hγ hδ hα hβ A u v,
      mul_inv_cancel]
  | g2_short_pair hi hj hk hij hik hkj u v =>
    simp only [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of]
    rw [D.commutatorElement_rootSubgroup_of_g2_short_pair hi hj hk hij hik hkj A u v,
      mul_inv_cancel]
  | g2_short_long hγ hδ hε hζ u v =>
    simp only [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of]
    rw [D.commutatorElement_rootSubgroup_of_g2_short_long hγ hδ hε hζ A u v, mul_inv_cancel]
  | g2_long_short hγ hδ hε hζ u v =>
    simp only [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of]
    rw [D.commutatorElement_rootSubgroup_of_g2_long_short hγ hδ hε hζ A u v, mul_inv_cancel]
  | weyl_conj γ s u =>
    simp only [map_mul, map_inv, FreeGroup.lift_apply_of, D.lift_steinbergWeylWord A]
    rw [D.weylElement_conj_rootSubgroupPoints_self, mul_inv_cancel]
  | coroot_mul γ s s' =>
    simp only [map_mul, map_inv, D.lift_steinbergWeylWord A]
    rw [D.weylElement_mul_inv_mul_weylElement_mul_inv, mul_inv_cancel]

/-- **Steinberg's homomorphism** from the group presented by Steinberg's relations to the points
of a Chevalley datum, sending each generator `X_γ(u)` to the root element `x_γ(u)`. -/
noncomputable def steinbergLift : PresentedGroup (t.steinbergRelators ht A) →* D.points A :=
  PresentedGroup.toGroup fun _ hr => D.lift_eq_one_of_isSteinbergRelator A hr

@[simp]
theorem steinbergLift_of (γ : Fin t.numRoots) (a : A) :
    D.steinbergLift A (PresentedGroup.of (γ, a)) = D.rootSubgroupPoints γ A (ofAdd a) :=
  PresentedGroup.toGroup.of _

/-- Steinberg's homomorphism carries the presented Weyl word `W_γ(s)` to Steinberg's element
`n_γ(s)` of the datum. -/
@[simp]
theorem steinbergLift_mk_steinbergWeylWord (γ : Fin t.numRoots) (s : Aˣ) :
    D.steinbergLift A (PresentedGroup.mk _ (steinbergWeylWord ht γ s)) = D.weylElement γ A s := by
  -- `PresentedGroup.toGroup` evaluates the class of a word by lifting that word.
  exact D.lift_steinbergWeylWord A γ s

/-- Steinberg's homomorphism carries the root subgroups of the presented group onto those of the
datum. -/
@[simp]
theorem steinbergLift_comp_steinbergRootSubgroup (γ : Fin t.numRoots) :
    (D.steinbergLift A).comp (t.steinbergRootSubgroup ht A γ) = D.rootSubgroupPoints γ A := by
  ext a
  simp

/-- **The range of Steinberg's homomorphism is the elementary subgroup**, generated by the root
subgroups of the datum. -/
theorem range_steinbergLift : (D.steinbergLift A).range = D.elementarySubgroup A := by
  rw [MonoidHom.range_eq_map, ← PresentedGroup.closure_range_of, MonoidHom.map_closure,
    elementarySubgroup_def, ← Set.range_comp]
  congr 1
  ext g
  simp only [Set.mem_range, Function.comp_apply, Prod.exists, steinbergLift_of, Set.mem_iUnion]
  exact ⟨fun ⟨γ, a, h⟩ => ⟨γ, ofAdd a, h⟩, fun ⟨γ, a, h⟩ => ⟨γ, a.toAdd, h⟩⟩

end ChevalleyDatum

end TauCeti.DynkinType
