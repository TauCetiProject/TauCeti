module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Elementary
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Torus.Equivariance
public import TauCeti.GroupTheory.Subgroup.NormalizedJoin

/-!
# Extending elementary Chevalley comparisons by the actual torus

Let `D` and `E` be Chevalley data of the same type with `Λ(E) ≤ Λ(D)`, and let `A` be a
commutative ring. Write `E'_D(A)` for the elementary subgroup of `D.points A`, generated by the
root subgroups, and `T_D(A) = Hom(Λ(D), Aˣ)` for the actual torus. Their join `E_D(A)` is
`D.extendedElementarySubgroup A`. Given a homomorphism `f : E'_D(A) → E.points A` with
`f (x_γ(u)) = x_γ(u)` for every root `γ`, this file constructs the homomorphism

```text
E_D(A) → E.points A,    e t ↦ f(e) res(t),
```

where `res : T_D(A) → T_E(A)` is restriction of characters
(`TauCeti.DynkinType.ChevalleyDatum.torusRestriction`). The two factors of `e t` are not
unique, since `E'_D(A) ∩ T_D(A)` can be nontrivial, so the formula is well defined exactly when
`f` agrees with `res` on that intersection. `exists_extendedElementarySubgroup_hom_iff` proves
that this agreement is necessary as well as sufficient, and `extendedElementaryLift` is the
resulting homomorphism, characterized by its values on root subgroups and torus points.

The agreement always holds on the image `H_D(A)` of the full-weight parametrization, the
subgroup generated by the coroot values `h_α(s)`: a root-preserving `f` sends the simple coroot
words `n_i(s) n_i(1)⁻¹` to the corresponding words of `E`
(`map_mk_torusPoints_fullWeightTorusRestriction`). Hence `f` agrees with `res` on the whole
intersection as soon as `E'_D(A) ∩ T_D(A) = H_D(A)` (`map_mk_torusPoints_of_mem_range`). Over a
field this equality is a consequence of the uniqueness in the Bruhat decomposition; it is not
proved here. If full-weight restriction is surjective on torus parameters, for instance for a
datum with full weight lattice or over a ring with divisible units, it holds trivially.

Conjugation compatibility of `f` with the two tori is
`TauCeti.DynkinType.ChevalleyDatum.comp_rootGeneratedTorusAction`, and the gluing across the
normalizing join is `Subgroup.liftSupOfRightLeNormalizer`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 28 and Corollary 5 to
  Theorem 4′.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

universe v

variable {t : DynkinType} {ht : t.Valid} (D E : ChevalleyDatum t ht)
variable {A : Type v} [CommRing A]

/-! ## Restriction on the image of the actual torus -/

section Restriction

variable (h : E.weightLattice ≤ D.weightLattice)

/-- Restriction of characters from the actual torus of `D` to that of `E`, read on the image of
the torus in the points of `D`. The torus of `D` is injective on points, so this is well
defined. -/
private noncomputable def rangeTorusRestriction : (D.torusPoints A).range →* E.points A :=
  ((E.torusPoints A).comp (D.torusRestriction E h)).comp
    (MonoidHom.ofInjective (D.torusPoints_injective A)).symm.toMonoidHom

/-- On a torus point, `rangeTorusRestriction` is the torus point of `E` at the restricted
parameter. -/
@[simp]
private theorem rangeTorusRestriction_torusPoints (s : Fin t.rank → Aˣ) :
    D.rangeTorusRestriction E h ⟨D.torusPoints A s, s, rfl⟩ =
      E.torusPoints A (D.torusRestriction E h s) := by
  have hs : (MonoidHom.ofInjective (D.torusPoints_injective A)).symm
      ⟨D.torusPoints A s, s, rfl⟩ = s :=
    (MulEquiv.symm_apply_eq _).mpr (Subtype.ext (MonoidHom.ofInjective_apply _).symm)
  simp only [rangeTorusRestriction, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, hs]

end Restriction

/-! ## Root-preserving homomorphisms on the elementary subgroup -/

section Elementary

variable {D E}
variable (f : D.elementarySubgroup A →* E.points A)
  (hf : ∀ (γ : Fin t.numRoots) (u : Multiplicative A),
    f ⟨D.rootSubgroupPoints γ A u, D.rootSubgroupPoints_mem_elementarySubgroup A γ u⟩ =
      E.rootSubgroupPoints γ A u)

include hf

/-- A root-preserving homomorphism on the elementary subgroup takes values in the elementary
subgroup of the target. -/
theorem range_le_elementarySubgroup : f.range ≤ E.elementarySubgroup A := by
  have hS : (E.elementarySubgroup A).comap f = ⊤ :=
    D.eq_top_of_rootSubgroupPoints_mem A fun γ u => by
      rw [Subgroup.mem_comap, hf]
      exact E.rootSubgroupPoints_mem_elementarySubgroup A γ u
  rintro _ ⟨x, rfl⟩
  exact (hS ▸ Subgroup.mem_top x : x ∈ (E.elementarySubgroup A).comap f)

omit hf in
/-- A homomorphism on the elementary subgroup matching both signs of the `i`-th simple root
sends the simple coroot value `h_i(s) = n_i(s) n_i(1)⁻¹` to the corresponding simple coroot
value of the target. -/
theorem map_mk_simpleCorootPoints (i : Fin t.rank)
    (hpos : ∀ u, f ⟨D.rootSubgroupPoints (t.simpleIndex ht i) A u,
      D.rootSubgroupPoints_mem_elementarySubgroup A _ u⟩ =
        E.rootSubgroupPoints (t.simpleIndex ht i) A u)
    (hneg : ∀ u, f ⟨D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
      (t.simpleIndex ht i) (t.simpleIndex ht i)) A u,
        D.rootSubgroupPoints_mem_elementarySubgroup A _ u⟩ =
        E.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) (t.simpleIndex ht i)) A u)
    (s : Aˣ) :
    f ⟨D.simpleCorootPoints i A s, D.simpleCorootPoints_mem_elementarySubgroup A i s⟩ =
      E.simpleCorootPoints i A s := by
  -- Write the coroot value as a word in root elements inside the elementary subgroup.
  let x : Fin t.numRoots → A → D.elementarySubgroup A := fun γ u =>
    ⟨D.rootSubgroupPoints γ A (Multiplicative.ofAdd u),
      D.rootSubgroupPoints_mem_elementarySubgroup A γ _⟩
  have hword : (⟨D.simpleCorootPoints i A s, D.simpleCorootPoints_mem_elementarySubgroup A i s⟩ :
        D.elementarySubgroup A) =
      x (t.simpleIndex ht i) s *
          x ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
            (t.simpleIndex ht i)) (-((s⁻¹ : Aˣ) : A)) * x (t.simpleIndex ht i) s *
        (x (t.simpleIndex ht i) ((1 : Aˣ) : A) *
          x ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
            (t.simpleIndex ht i)) (-(((1 : Aˣ)⁻¹ : Aˣ) : A)) *
          x (t.simpleIndex ht i) ((1 : Aˣ) : A))⁻¹ := by
    apply Subtype.ext
    simp only [D.simpleCorootPoints_eq_weylElement_mul_inv, weylElement_def, x,
      Subgroup.coe_mul, Subgroup.coe_inv]
  rw [hword, E.simpleCorootPoints_eq_weylElement_mul_inv, weylElement_def, weylElement_def]
  simp only [map_mul, map_inv, x, hpos, hneg]

section SimpleRoots

variable
  (hpos : ∀ i u, f ⟨D.rootSubgroupPoints (t.simpleIndex ht i) A u,
    D.rootSubgroupPoints_mem_elementarySubgroup A _ u⟩ =
      E.rootSubgroupPoints (t.simpleIndex ht i) A u)
  (hneg : ∀ i u, f ⟨D.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
    (t.simpleIndex ht i) (t.simpleIndex ht i)) A u,
      D.rootSubgroupPoints_mem_elementarySubgroup A _ u⟩ =
      E.rootSubgroupPoints ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht i) (t.simpleIndex ht i)) A u)

include hpos hneg

omit hf in
/-- A homomorphism on the elementary subgroup matching both signs of every simple root sends
every point of the image of the full-weight parametrization to the point of the target with the
same full-weight parameter. This is the agreement with restriction of characters on the
subgroup generated by the coroot values. -/
theorem map_mk_torusPoints_fullWeightTorusRestriction
    (u : Fin t.rank → Aˣ) :
    f ⟨D.torusPoints A (D.fullWeightTorusRestriction A u),
      D.torusPoints_mem_elementarySubgroup_of_mem_range A _ ⟨u, rfl⟩⟩ =
      E.torusPoints A (E.fullWeightTorusRestriction A u) := by
  have hprod : (⟨D.torusPoints A (D.fullWeightTorusRestriction A u),
      D.torusPoints_mem_elementarySubgroup_of_mem_range A _ ⟨u, rfl⟩⟩ :
        D.elementarySubgroup A) =
      (List.ofFn fun i => (⟨D.simpleCorootPoints i A (u i),
        D.simpleCorootPoints_mem_elementarySubgroup A i (u i)⟩ : D.elementarySubgroup A)).prod := by
    apply Subtype.ext
    simp only [Subgroup.val_list_prod, List.map_ofFn]
    rw [D.torusPoints_fullWeightTorusRestriction_eq_prod_simpleCorootPoints]
    rfl
  rw [hprod, map_list_prod, List.map_ofFn,
    E.torusPoints_fullWeightTorusRestriction_eq_prod_simpleCorootPoints]
  congr 2
  funext i
  exact map_mk_simpleCorootPoints f i (hpos i) (hneg i) (u i)

omit hf in
/-- A homomorphism on the elementary subgroup matching both signs of every simple root agrees
with restriction of characters on every elementary torus point, provided each such point lies in
the image of the full-weight parametrization. Over a field the proviso is the equality
`E'_D(k) ∩ T_D(k) = H_D(k)`, a consequence of the Bruhat decomposition. -/
theorem map_mk_torusPoints_of_mem_range (h : E.weightLattice ≤ D.weightLattice)
    (hET : ∀ s, D.torusPoints A s ∈ D.elementarySubgroup A →
      s ∈ (D.fullWeightTorusRestriction A).range)
    (s : Fin t.rank → Aˣ) (hs : D.torusPoints A s ∈ D.elementarySubgroup A) :
    f ⟨D.torusPoints A s, hs⟩ = E.torusPoints A (D.torusRestriction E h s) := by
  obtain ⟨u, rfl⟩ := hET s hs
  rw [torusRestriction_fullWeightTorusRestriction]
  exact map_mk_torusPoints_fullWeightTorusRestriction f hpos hneg u

end SimpleRoots

/-- Conjugation by an actual torus point of `D` corresponds under a root-preserving `f` to
conjugation by the restricted torus point of `E`. This is
`TauCeti.DynkinType.ChevalleyDatum.map_rootGeneratedTorusAction`, read on
`D.elementarySubgroup A`. -/
private theorem map_mk_torusPoints_mul_mul_inv (h : E.weightLattice ≤ D.weightLattice)
    (s : Fin t.rank → Aˣ) (x : D.elementarySubgroup A)
    (hx : D.torusPoints A s * x * (D.torusPoints A s)⁻¹ ∈ D.elementarySubgroup A) :
    f ⟨D.torusPoints A s * x * (D.torusPoints A s)⁻¹, hx⟩ =
      E.torusPoints A (D.torusRestriction E h s) * f x *
        (E.torusPoints A (D.torusRestriction E h s))⁻¹ := by
  let f' : Subgroup.closure (⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroupPoints γ A)) →*
      E.points A :=
    f.comp (MulEquiv.subgroupCongr (D.elementarySubgroup_def A)).symm.toMonoidHom
  have hf' : ∀ z, f' z = f ⟨z, (D.elementarySubgroup_def A).ge z.property⟩ := fun z =>
    congrArg f (Subtype.ext (MulEquiv.subgroupCongr_symm_apply _ _))
  have key := D.map_rootGeneratedTorusAction E A h f'
    (fun γ u => (hf' _).trans (hf γ u)) s ⟨x, (D.elementarySubgroup_def A).le x.property⟩
  rw [hf', hf'] at key
  simpa only [coe_rootGeneratedTorusAction] using key

end Elementary

/-! ## The extension -/

section Extension

variable {D E} (h : E.weightLattice ≤ D.weightLattice)
variable (f : D.elementarySubgroup A →* E.points A)
  (hf : ∀ (γ : Fin t.numRoots) (u : Multiplicative A),
    f ⟨D.rootSubgroupPoints γ A u, D.rootSubgroupPoints_mem_elementarySubgroup A γ u⟩ =
      E.rootSubgroupPoints γ A u)
  (hT : ∀ (s : Fin t.rank → Aˣ) (hs : D.torusPoints A s ∈ D.elementarySubgroup A),
    f ⟨D.torusPoints A s, hs⟩ = E.torusPoints A (D.torusRestriction E h s))

include hf in
/-- The conjugation compatibility of `f`, in the form required for gluing across the join. -/
private theorem comp_normalizerMonoidHom (b : (D.torusPoints A).range) :
    f.comp ((((D.elementarySubgroup A).normalizerMonoidHom).comp
        (Subgroup.inclusion (D.range_torusPoints_le_normalizer_elementarySubgroup A))) b
          ).toMonoidHom =
      (MulAut.conj (D.rangeTorusRestriction E h b)).toMonoidHom.comp f := by
  obtain ⟨_, s, rfl⟩ := b
  refine MonoidHom.ext fun x => ?_
  simp only [rangeTorusRestriction_torusPoints, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulAut.conj_apply]
  rw [← map_mk_torusPoints_mul_mul_inv f hf h s x
      (D.range_torusPoints_le_normalizer_elementarySubgroup A ⟨s, rfl⟩ x |>.mp x.property)]
  exact congrArg f (Subtype.ext (by simp))

include hT in
/-- The torus agreement hypothesis, in the form required for gluing across the join. -/
private theorem agree_inf (a : ↥(D.elementarySubgroup A ⊓ (D.torusPoints A).range)) :
    f ⟨a, a.property.1⟩ = D.rangeTorusRestriction E h ⟨a, a.property.2⟩ := by
  obtain ⟨_, hE, s, rfl⟩ := a
  rw [rangeTorusRestriction_torusPoints]
  exact hT s hE

/-- **Extension of an elementary comparison by the actual torus.** For a root-preserving
homomorphism `f` on the elementary subgroup of `D` that agrees with restriction of characters
on the elementary torus points, this is the homomorphism `e t ↦ f(e) res(t)` on the subgroup
generated by the root subgroups and the actual torus of `D`. -/
noncomputable def extendedElementaryLift : D.extendedElementarySubgroup A →* E.points A :=
  (Subgroup.liftSupOfRightLeNormalizer (D.elementarySubgroup A) (D.torusPoints A).range
    (D.range_torusPoints_le_normalizer_elementarySubgroup A) f (D.rangeTorusRestriction E h)
    (comp_normalizerMonoidHom h f hf) (agree_inf h f hT)).comp
    (MulEquiv.subgroupCongr (D.extendedElementarySubgroup_def A)).toMonoidHom

/-- The extension sends an elementary element followed by a torus point to the image of the
elementary element followed by the restricted torus point. -/
@[simp]
theorem extendedElementaryLift_mul_torusPoints (e : D.elementarySubgroup A)
    (s : Fin t.rank → Aˣ) :
    extendedElementaryLift h f hf hT
        ⟨e * D.torusPoints A s, (D.extendedElementarySubgroup A).mul_mem
          (D.elementarySubgroup_le_extendedElementarySubgroup A e.property)
          (D.torusPoints_mem_extendedElementarySubgroup A s)⟩ =
      f e * E.torusPoints A (D.torusRestriction E h s) := by
  rw [extendedElementaryLift, MonoidHom.comp_apply, ← rangeTorusRestriction_torusPoints D E h s,
    ← Subgroup.liftSupOfRightLeNormalizer_mul _ _ _ f _ _ (agree_inf h f hT) e ⟨_, s, rfl⟩]
  exact congrArg _ (Subtype.ext (MulEquiv.subgroupCongr_apply _ _))

/-- The extension restricts to `f` on the elementary subgroup. -/
@[simp]
theorem extendedElementaryLift_inclusion (e : D.elementarySubgroup A) :
    extendedElementaryLift h f hf hT
        (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup A) e) = f e := by
  have he : Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup A) e =
      ⟨e * D.torusPoints A 1, (D.extendedElementarySubgroup A).mul_mem
        (D.elementarySubgroup_le_extendedElementarySubgroup A e.property)
        (D.torusPoints_mem_extendedElementarySubgroup A 1)⟩ :=
    Subtype.ext (by simp)
  simpa [he] using extendedElementaryLift_mul_torusPoints h f hf hT e 1

/-- The extension sends a point of the actual torus of `D` to the restricted torus point
of `E`. -/
@[simp]
theorem extendedElementaryLift_torusPoints (s : Fin t.rank → Aˣ) :
    extendedElementaryLift h f hf hT
        ⟨D.torusPoints A s, D.torusPoints_mem_extendedElementarySubgroup A s⟩ =
      E.torusPoints A (D.torusRestriction E h s) := by
  simpa using extendedElementaryLift_mul_torusPoints h f hf hT 1 s

/-- The extension matches every root subgroup of `D` with the same root subgroup of `E`. -/
@[simp]
theorem extendedElementaryLift_rootSubgroupPoints (γ : Fin t.numRoots) (u : Multiplicative A) :
    extendedElementaryLift h f hf hT
        ⟨D.rootSubgroupPoints γ A u, D.elementarySubgroup_le_extendedElementarySubgroup A
          (D.rootSubgroupPoints_mem_elementarySubgroup A γ u)⟩ =
      E.rootSubgroupPoints γ A u :=
  (extendedElementaryLift_inclusion h f hf hT
    ⟨_, D.rootSubgroupPoints_mem_elementarySubgroup A γ u⟩).trans (hf γ u)

/-- A homomorphism on the extended elementary subgroup that matches every root subgroup and
restricts characters on the actual torus is `extendedElementaryLift`. -/
theorem eq_extendedElementaryLift (F : D.extendedElementarySubgroup A →* E.points A)
    (hFγ : ∀ (γ : Fin t.numRoots) (u : Multiplicative A),
      F ⟨D.rootSubgroupPoints γ A u, D.elementarySubgroup_le_extendedElementarySubgroup A
        (D.rootSubgroupPoints_mem_elementarySubgroup A γ u)⟩ = E.rootSubgroupPoints γ A u)
    (hFT : ∀ s : Fin t.rank → Aˣ,
      F ⟨D.torusPoints A s, D.torusPoints_mem_extendedElementarySubgroup A s⟩ =
        E.torusPoints A (D.torusRestriction E h s)) :
    F = extendedElementaryLift h f hf hT := by
  refine MonoidHom.ext fun g => ?_
  obtain ⟨e, he, s, hg⟩ := (D.mem_extendedElementarySubgroup_iff A g).mp g.property
  have hFe : F.comp (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup A)) =
      f := D.elementarySubgroup_hom_ext A fun γ u => (hFγ γ u).trans (hf γ u).symm
  obtain rfl : g = ⟨e * D.torusPoints A s, (D.extendedElementarySubgroup A).mul_mem
      (D.elementarySubgroup_le_extendedElementarySubgroup A he)
      (D.torusPoints_mem_extendedElementarySubgroup A s)⟩ := Subtype.ext hg.symm
  rw [extendedElementaryLift_mul_torusPoints h f hf hT ⟨e, he⟩ s, ← hFe, ← hFT s,
    MonoidHom.comp_apply, ← map_mul]
  exact congrArg F (Subtype.ext (by simp))

/-- The extension takes values in the subgroup of `E.points A` generated by the root subgroups
and the actual torus of `E`. -/
theorem range_extendedElementaryLift_le :
    (extendedElementaryLift h f hf hT).range ≤ E.extendedElementarySubgroup A := by
  rintro _ ⟨⟨g, hg⟩, rfl⟩
  obtain ⟨e, he, s, rfl⟩ := (D.mem_extendedElementarySubgroup_iff A g).mp hg
  rw [extendedElementaryLift_mul_torusPoints h f hf hT ⟨e, he⟩ s]
  exact (E.extendedElementarySubgroup A).mul_mem
    (E.elementarySubgroup_le_extendedElementarySubgroup A
      (range_le_elementarySubgroup f hf ⟨⟨e, he⟩, rfl⟩))
    (E.torusPoints_mem_extendedElementarySubgroup A _)

include hf in
/-- A root-preserving homomorphism on the elementary subgroup extends to the extended
elementary subgroup, by restriction of characters on the actual torus, exactly when it agrees
with restriction of characters on the elementary torus points. -/
theorem exists_extendedElementarySubgroup_hom_iff :
    (∃ F : D.extendedElementarySubgroup A →* E.points A,
        F.comp (Subgroup.inclusion (D.elementarySubgroup_le_extendedElementarySubgroup A)) = f ∧
          ∀ s : Fin t.rank → Aˣ,
            F ⟨D.torusPoints A s, D.torusPoints_mem_extendedElementarySubgroup A s⟩ =
              E.torusPoints A (D.torusRestriction E h s)) ↔
      ∀ (s : Fin t.rank → Aˣ) (hs : D.torusPoints A s ∈ D.elementarySubgroup A),
        f ⟨D.torusPoints A s, hs⟩ = E.torusPoints A (D.torusRestriction E h s) := by
  refine ⟨fun ⟨F, hFf, hFT⟩ s hs => ?_, fun hT => ⟨extendedElementaryLift h f hf hT, ?_, ?_⟩⟩
  · rw [← hFf, MonoidHom.comp_apply, ← hFT s]
    exact congrArg F (Subtype.ext (Subgroup.coe_inclusion _ _))
  · exact MonoidHom.ext (extendedElementaryLift_inclusion h f hf hT)
  · exact extendedElementaryLift_torusPoints h f hf hT

end Extension

end TauCeti.DynkinType.ChevalleyDatum
