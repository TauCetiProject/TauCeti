module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Weyl
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Coroot

/-!
# Weyl representatives normalize the actual Chevalley torus

For a Chevalley datum `D`, a simple Weyl representative acts on its torus by
`s ↦ s / αᵢ∨(αᵢ(s))`. Here both the root character and the coroot are written in the
chosen basis of the actual character lattice `D.weightLattice`. This formula is an
involution over every commutative ring, including nonreduced rings. It proves that the
actual torus is normal in the subgroup generated by it and the simple Weyl representatives,
as needed to form the Weyl quotient.

This is not a statement only about the image of the full-weight parametrization: that
image can be smaller than the actual torus. The proof uses the existing pinning equation
and the simple-coroot root-word identity, rather than extending torus parameters to the
full weight lattice.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19 and 22.
* R. W. Carter, *Simple Groups of Lie Type*, §7.2.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

open Multiplicative
open TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {t : DynkinType} {ht : t.Valid} (D : ChevalleyDatum t ht)
variable (i : Fin t.rank) (A : Type*) [CommRing A]

/-- The simple reflection on the actual torus parameters: subtract the root times its
coroot pairing on characters, or divide by the corresponding coroot value on points. -/
def simpleReflectionTorusParameter : (Fin t.rank → Aˣ) →* (Fin t.rank → Aˣ) :=
  (MonoidHom.id _) / ((D.simpleCorootParameter i A).comp
    (weightChar A (D.coordinateRoot (t.simpleIndex ht i))))

/-- The reflection formula uses the actual-lattice root character and coroot coordinates. -/
theorem simpleReflectionTorusParameter_def (s : Fin t.rank → Aˣ) :
    D.simpleReflectionTorusParameter i A s =
      s / D.simpleCorootParameter i A
        (torusCharacter s (D.coordinateRoot (t.simpleIndex ht i))) := by
  simp only [simpleReflectionTorusParameter, MonoidHom.div_apply, MonoidHom.id_apply,
    MonoidHom.comp_apply, weightChar_apply]

/-- Each torus coordinate is divided by the root character to its coroot exponent. -/
@[simp]
theorem simpleReflectionTorusParameter_apply (s : Fin t.rank → Aˣ) (j : Fin t.rank) :
    D.simpleReflectionTorusParameter i A s j =
      s j / torusCharacter s (D.coordinateRoot (t.simpleIndex ht i)) ^
        (D.weightLatticeBasis j : Fin t.rank → ℤ) i := by
  rw [simpleReflectionTorusParameter_def, Pi.div_apply, simpleCorootParameter_apply]

/-- Character evaluation under a simple reflection, in the chosen character-lattice basis. -/
theorem torusCharacter_simpleReflectionTorusParameter (s : Fin t.rank → Aˣ)
    (μ : D.weightLattice) :
    torusCharacter (D.simpleReflectionTorusParameter i A s) (D.weightLatticeBasis.repr μ) =
      torusCharacter s (D.weightLatticeBasis.repr μ) /
        torusCharacter s (D.coordinateRoot (t.simpleIndex ht i)) ^ (μ : Fin t.rank → ℤ) i := by
  rw [simpleReflectionTorusParameter_def, ← weightChar_apply, map_div, weightChar_apply,
    weightChar_apply, torusCharacter_simpleCorootParameter]

/-- A simple reflection inverts its own root character. -/
@[simp]
theorem torusCharacter_simpleReflectionTorusParameter_simpleRoot (s : Fin t.rank → Aˣ) :
    torusCharacter (D.simpleReflectionTorusParameter i A s)
        (D.coordinateRoot (t.simpleIndex ht i)) =
      (torusCharacter s (D.coordinateRoot (t.simpleIndex ht i)))⁻¹ := by
  have h := D.torusCharacter_simpleReflectionTorusParameter i A s
    ⟨_, D.root_mem_weightLattice (t.simpleIndex ht i)⟩
  have hp : (t.simplyConnectedRootDatum ht).root (t.simpleIndex ht i) i = 2 := by simp
  simpa only [← D.coordinateRoot_def (t.simpleIndex ht i), Submodule.coe_mk, hp,
    zpow_ofNat, pow_two, div_mul_eq_div_div, div_self', one_div] using h

/-- The simple reflection on actual torus parameters is an involution over every ring. -/
@[simp]
theorem simpleReflectionTorusParameter_simpleReflectionTorusParameter
    (s : Fin t.rank → Aˣ) :
    D.simpleReflectionTorusParameter i A (D.simpleReflectionTorusParameter i A s) = s := by
  rw [simpleReflectionTorusParameter_def,
    torusCharacter_simpleReflectionTorusParameter_simpleRoot,
    simpleReflectionTorusParameter_def, map_inv]
  simp

private theorem torusPoints_conj_simpleWeylElement (s : Fin t.rank → Aˣ) :
    D.torusPoints A s * D.weylElement (t.simpleIndex ht i) A 1 * (D.torusPoints A s)⁻¹ =
      D.weylElement (t.simpleIndex ht i) A
        (torusCharacter s (D.coordinateRoot (t.simpleIndex ht i))) := by
  simp only [weylElement_def, inv_one, Units.val_one]
  rw [← MulAut.conj_apply, map_mul, map_mul]
  simp only [MulAut.conj_apply, D.torusPoints_conj_rootSubgroup,
    D.coordinateRoot_reflectionPerm_self, torusCharacter_neg, mul_one, mul_neg]

private theorem simpleWeylElement_eq_coroot_mul (s : Aˣ) :
    D.weylElement (t.simpleIndex ht i) A s =
      D.torusPoints A (D.simpleCorootParameter i A s) *
        D.weylElement (t.simpleIndex ht i) A 1 := by
  apply Subtype.ext
  have h := D.coe_simpleCorootPoints_eq_root_word i A s
  simpa only [coe_torusPoints, coe_simpleCorootPoints_eq_kostantTorusMatrix,
    weylElement_def, Subgroup.coe_mul, coe_rootSubgroup_simpleIndex,
    coe_rootSubgroup_reflectionPerm_simpleIndex, Subgroup.coe_inv,
    inv_one, Units.val_one] using (eq_mul_inv_iff_mul_eq.mp h).symm

/-- Conjugation by a pinned simple Weyl representative acts by the simple reflection on
all points of the actual torus, not just those extending to the full weight lattice. -/
theorem weylElement_conj_torusPoints (s : Fin t.rank → Aˣ) :
    D.weylElement (t.simpleIndex ht i) A 1 * D.torusPoints A s *
        (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ =
      D.torusPoints A (D.simpleReflectionTorusParameter i A s) := by
  have h := D.torusPoints_conj_simpleWeylElement i A s
  rw [D.simpleWeylElement_eq_coroot_mul i A
      (torusCharacter s (D.coordinateRoot (t.simpleIndex ht i))),
    mul_inv_eq_iff_eq_mul] at h
  rw [simpleReflectionTorusParameter_def, map_div]
  have hc := (Commute.all s
    (D.simpleCorootParameter i A (torusCharacter s (D.coordinateRoot (t.simpleIndex ht i))))).map
      (D.torusPoints A)
  calc
    _ = (D.torusPoints A
        (D.simpleCorootParameter i A
          (torusCharacter s (D.coordinateRoot (t.simpleIndex ht i)))))⁻¹ *
        D.torusPoints A s := by
      calc
        _ = (D.torusPoints A
            (D.simpleCorootParameter i A
              (torusCharacter s (D.coordinateRoot (t.simpleIndex ht i)))))⁻¹ *
            (D.torusPoints A s * D.weylElement (t.simpleIndex ht i) A 1) *
            (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ := by rw [h]; group
        _ = _ := by group
    _ = _ := by rw [div_eq_mul_inv, hc.inv_right.eq]

/-- Every simple Weyl representative normalizes the actual torus. -/
theorem weylElement_mem_normalizer_range_torusPoints :
    D.weylElement (t.simpleIndex ht i) A 1 ∈ Subgroup.normalizer (D.torusPoints A).range := by
  rw [Subgroup.mem_normalizer_iff]
  intro g
  constructor
  · rintro ⟨s, rfl⟩
    exact ⟨D.simpleReflectionTorusParameter i A s, (D.weylElement_conj_torusPoints i A s).symm⟩
  · rintro ⟨s, hs⟩
    refine ⟨D.simpleReflectionTorusParameter i A s, ?_⟩
    have h := D.weylElement_conj_torusPoints i A (D.simpleReflectionTorusParameter i A s)
    rw [D.simpleReflectionTorusParameter_simpleReflectionTorusParameter i A s] at h
    rw [hs] at h
    have h' := congrArg (fun x =>
      (D.weylElement (t.simpleIndex ht i) A 1)⁻¹ * x *
        D.weylElement (t.simpleIndex ht i) A 1) h
    simpa only [← mul_assoc, inv_mul_cancel, one_mul, inv_mul_cancel_right] using h'

/-- The subgroup generated by the actual torus and the simple Weyl representatives
normalizes that torus over every commutative ring. -/
theorem weylSubgroup_le_normalizer_range_torusPoints :
    D.weylSubgroup A ≤ Subgroup.normalizer (D.torusPoints A).range := by
  rw [weylSubgroup_def, Subgroup.closure_le]
  rintro g (⟨s, rfl⟩ | ⟨j, rfl⟩)
  · exact (D.torusPoints A).range.le_normalizer ⟨s, rfl⟩
  · exact D.weylElement_mem_normalizer_range_torusPoints j A

/-- The actual torus is normal in the subgroup generated by it and the simple Weyl
representatives; no field or algebraic-closure hypothesis is needed. -/
instance normal_torusPoints_subgroupOf_weylSubgroup :
    (((D.torusPoints A).range).subgroupOf (D.weylSubgroup A)).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer (D.weylSubgroup_le_normalizer_range_torusPoints A)

end

end TauCeti.DynkinType.ChevalleyDatum
