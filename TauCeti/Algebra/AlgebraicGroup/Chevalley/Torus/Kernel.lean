module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Torus.Comparison
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Root.Subgroup
public import TauCeti.LinearAlgebra.Basis.DiagonalTorus.FiniteKernel

/-!
# Finite central kernels of restriction between Chevalley tori

For Chevalley data `D` and `E` of the same type with `Λ(E) ≤ Λ(D)`, the kernel of
restriction `T_D(A) → T_E(A)` is finite over every integral domain. Its image in `D.points A`
centralizes the subgroup generated by all root subgroups and the actual torus, over every
commutative ring. Indeed, every root belongs to `Λ(E)`, so each root character is trivial on
this kernel, and the pinning equation gives commutation with the root subgroups.

These are the torus-kernel assertions needed when extending a root-preserving comparison by
the actual torus. They do not construct a comparison of the ambient groups, or assert that
its entire kernel lies in the torus. Nor do they identify all scheme points with the
root-and-torus-generated subgroup. Finiteness concerns points, not the rank or reducedness of
a scheme-theoretic kernel; in characteristic two, the kernel of squaring on field units is
trivial although the group scheme `μ₂` is not.

The finiteness proof uses `TauCeti.finite_ker_torusPointMap_of_injective`; centrality uses the
actual character-lattice restriction and `ChevalleyDatum.torusPoints_conj_rootSubgroupPoints`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 28 and Corollary 5 to
  Theorem 4′.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

variable {t : DynkinType} {ht : t.Valid} (D E : ChevalleyDatum t ht)
variable {A : Type*} [CommRing A]

/-- Restriction between the actual tori of two Chevalley data has finite kernel on points
over any integral domain, without a divisibility or separability assumption. -/
theorem finite_ker_torusRestriction [IsDomain A] (h : E.weightLattice ≤ D.weightLattice) :
    Finite (D.torusRestriction E (A := A) h).ker := by
  rw [torusRestriction_def]
  exact finite_ker_torusPointMap_of_injective _ (D.weightLatticeInclusion_injective E h) rfl

/-- The torus image of the restriction kernel centralizes the root-and-torus-generated
subgroup. Every root lies in the smaller character lattice, so restriction kills none of
the root characters needed by the pinning equation. -/
theorem map_ker_torusRestriction_le_centralizer_rootTorusSubgroup
    (h : E.weightLattice ≤ D.weightLattice) :
    (D.torusRestriction E (A := A) h).ker.map (D.torusPoints A) ≤
      Subgroup.centralizer (D.rootTorusSubgroup A : Set (D.points A)) := by
  rintro g ⟨s, hs, rfl⟩
  apply D.torusPoints_mem_centralizer_rootTorusSubgroup_of_root_eq_one s
  intro γ
  have heval := D.torusCharacter_torusRestriction E h s
    ⟨(t.simplyConnectedRootDatum ht).root γ, E.root_mem_weightLattice γ⟩
  simp only [SetLike.mem_coe, MonoidHom.mem_ker] at hs
  rw [hs, torusCharacter_one] at heval
  simpa only [coordinateRoot_def, Submodule.inclusion_apply] using heval.symm

end TauCeti.DynkinType.ChevalleyDatum
