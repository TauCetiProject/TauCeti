module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Root.Subgroup
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Torus.Comparison
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Torus equivariance of elementary Chevalley comparisons

A homomorphism on the subgroup generated by the roots which matches root parameters automatically
intertwines conjugation by the actual tori, with torus parameters transported by restriction of
characters. This is the equivariance needed to extend an elementary comparison by the torus.
It does not assume that the comparison already extends to the ambient group, or that every torus
point belongs to the elementary subgroup.

`rootGeneratedTorusAction` restricts conjugation to the root-generated subgroup, using the pinning
equation. `comp_rootGeneratedTorusAction` proves equivariance for an arbitrary root-preserving
homomorphism to another datum's points. Both constructions work over every commutative ring,
including when the character lattices are proper and their restriction map is not surjective.

The proof uses the native pinning equation and `torusRestriction`, together with Mathlib's
`Subgroup.normalizerMonoidHom` and homomorphism extensionality on a generated subgroup.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 28(c) and Corollary 5 to
  Theorem 4′.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.DynkinType.ChevalleyDatum

variable {t : DynkinType} {ht : t.Valid} (D E : ChevalleyDatum t ht)
variable (A : Type*) [CommRing A]

/-- Conjugation by the actual torus on the subgroup generated by all root subgroups. The torus
need not itself be contained in that subgroup. -/
noncomputable def rootGeneratedTorusAction :
    (Fin t.rank → Aˣ) →* MulAut
      (Subgroup.closure (⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroupPoints γ A))) :=
  (Subgroup.closure _).normalizerMonoidHom.comp
    ((D.torusPoints A).codRestrict _
      (fun s => D.range_torusPoints_le_normalizer_rootGenerated A ⟨s, rfl⟩))

/-- The torus action is conjugation in the original group of datum points. -/
@[simp]
theorem coe_rootGeneratedTorusAction (s : Fin t.rank → Aˣ)
    (g : Subgroup.closure (⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroupPoints γ A))) :
    (D.rootGeneratedTorusAction A s g : D.points A) =
      D.torusPoints A s * g * (D.torusPoints A s)⁻¹ :=
  (rfl)

/-- On a root generator the restricted torus action scales the additive parameter by the root
character, expressed in the actual character-lattice coordinates. -/
@[simp]
theorem rootGeneratedTorusAction_rootSubgroupPoints (s : Fin t.rank → Aˣ)
    (γ : Fin t.numRoots) (u : A) :
    D.rootGeneratedTorusAction A s
        ⟨D.rootSubgroupPoints γ A (Multiplicative.ofAdd u),
          Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨γ, _, rfl⟩)⟩ =
      ⟨D.rootSubgroupPoints γ A
          (Multiplicative.ofAdd ((torusCharacter s (D.coordinateRoot γ) : A) * u)),
        Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨γ, _, rfl⟩)⟩ := by
  apply Subtype.ext
  rw [D.coe_rootGeneratedTorusAction, D.torusPoints_conj_rootSubgroupPoints]

/-- An elementary comparison matching root parameters intertwines conjugation by the actual
tori. Only inclusion of character lattices is needed; neither surjectivity on torus points nor
an extension of the comparison to the ambient group is assumed. -/
theorem comp_rootGeneratedTorusAction (h : E.weightLattice ≤ D.weightLattice)
    (f : Subgroup.closure (⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroupPoints γ A)) →*
      E.points A)
    (hf : ∀ (γ : Fin t.numRoots) (u : Multiplicative A),
      f ⟨D.rootSubgroupPoints γ A u,
        Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨γ, u, rfl⟩)⟩ =
          E.rootSubgroupPoints γ A u)
    (s : Fin t.rank → Aˣ) :
    f.comp (D.rootGeneratedTorusAction A s).toMonoidHom =
      (MulAut.conj (E.torusPoints A (D.torusRestriction E h s))).toMonoidHom.comp f := by
  apply MonoidHom.eq_of_eqOn_dense (Subgroup.closure_preimage_eq_top _)
  intro x hx
  obtain ⟨γ, u, hu⟩ := Set.mem_iUnion.mp hx
  have hx' : x = ⟨D.rootSubgroupPoints γ A u,
      Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨γ, u, rfl⟩)⟩ :=
    Subtype.ext hu.symm
  rw [hx', ← ofAdd_toAdd u]
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    rootGeneratedTorusAction_rootSubgroupPoints, hf, MulAut.conj_apply,
    E.torusPoints_conj_rootSubgroupPoints, D.torusCharacter_torusRestriction_coordinateRoot E h]

/-- Pointwise torus equivariance of an elementary comparison matching root parameters. -/
theorem map_rootGeneratedTorusAction (h : E.weightLattice ≤ D.weightLattice)
    (f : Subgroup.closure (⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroupPoints γ A)) →*
      E.points A)
    (hf : ∀ (γ : Fin t.numRoots) (u : Multiplicative A),
      f ⟨D.rootSubgroupPoints γ A u,
        Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨γ, u, rfl⟩)⟩ =
          E.rootSubgroupPoints γ A u)
    (s : Fin t.rank → Aˣ)
    (g : Subgroup.closure (⋃ γ : Fin t.numRoots, Set.range (D.rootSubgroupPoints γ A))) :
    f (D.rootGeneratedTorusAction A s g) =
      E.torusPoints A (D.torusRestriction E h s) * f g *
        (E.torusPoints A (D.torusRestriction E h s))⁻¹ := by
  simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using
    DFunLike.congr_fun (D.comp_rootGeneratedTorusAction E A h f hf s) g

end TauCeti.DynkinType.ChevalleyDatum
