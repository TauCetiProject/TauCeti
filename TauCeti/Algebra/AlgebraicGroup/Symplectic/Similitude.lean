module

public import TauCeti.Algebra.AlgebraicGroup.ConstantForm.Similitude
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Symplectic.Similitude

/-!
# The symplectic similitude group scheme `GSp₂ₘ`

For a commutative ring `R` and `m : ℕ`, the symplectic similitude group scheme `GSp₂ₘ` is the
closed subgroup scheme of `GL (m + m) × 𝔾_m` of pairs `(h, r)` with

```text
h Jₘ hᵀ = r Jₘ,
```

for `Jₘ` the standard alternating form in `Fin (m + m)` coordinates: the specialization of
`TauCeti.ConstantFormSimilitude` at `C = Jₘ`. Its multiplier character `ν : GSp₂ₘ → 𝔾_m` is
`(h, r) ↦ r`. On every commutative `R`-algebra `A`, its points are the pairs `(h, r)` in
`GL (m + m) (A) × Aˣ` with `h Jₘ hᵀ = r Jₘ` (`TauCeti.SymplecticSimilitude.pointsMulEquiv`); since
`Jₘ² = -1`, this is equivalent to the column convention `hᵀ Jₘ h = r Jₘ`
(`TauCeti.SymplecticSimilitude.mem_pointsSubgroup_iff'`, via
`TauCeti.transpose_mul_JFin_mul_eq_smul`). The sign of `Jₘ` does not matter, so these are also
the similitudes of `-Jₘ = [[0, I], [-I, 0]]`.

A point lies in the kernel of the multiplier exactly when it is a pair `(h, 1)` with `h`
symplectic (`TauCeti.SymplecticSimilitude.mem_ker_multiplierPoints_iff`); such pairs are built
with `TauCeti.SymplecticSimilitude.mk_one_mem_pointsSubgroup`. For `m = 1` the multiplier is the
determinant, so that `GSp₂(A) ≃ GL₂(A)` (`TauCeti.SymplecticSimilitude.pointsMulEquivGLTwo`).

## Main declarations

* `TauCeti.SymplecticSimilitude.definingHopfIdeal`,
  `TauCeti.SymplecticSimilitude.coordinateHopfAlgebra`,
  `TauCeti.SymplecticSimilitude.groupScheme` and `TauCeti.SymplecticSimilitude.inclusion`: the
  Hopf ideal of `h Jₘ hᵀ - r Jₘ`, the coordinate Hopf algebra, and the group scheme `GSp₂ₘ` with
  its closed immersion into `GL (m + m) × 𝔾_m`.
* `TauCeti.SymplecticSimilitude.multiplier`: the multiplier character `ν : GSp₂ₘ → 𝔾_m`.
* `TauCeti.SymplecticSimilitude.pointsSubgroup` and
  `TauCeti.SymplecticSimilitude.pointsMulEquiv`: the group of points, natural in the value
  algebra (`TauCeti.SymplecticSimilitude.pointsMulEquiv_mapValue`).
* `TauCeti.SymplecticSimilitude.multiplierPoints` and
  `TauCeti.SymplecticSimilitude.mem_ker_multiplierPoints_iff`: the multiplier on points; a point
  is in its kernel exactly when it is a pair `(h, 1)` with `h` symplectic
  (`TauCeti.SymplecticSimilitude.mk_one_mem_pointsSubgroup` builds such pairs).
* `TauCeti.SymplecticSimilitude.pointsMulEquivGLTwo`: `GSp₂(A) ≃ GL₂(A)`, with multiplier the
  determinant (`TauCeti.SymplecticSimilitude.det_pointsMulEquivGLTwo`), natural in the value
  algebra (`TauCeti.SymplecticSimilitude.pointsMulEquivGLTwo_mapValue`).

## References

* J. S. Milne, *Algebraic Groups* (2017), 2.10, for the group-valued functors cut out of `GLₙ`
  by a constant form; `Sp₂ₘ` is the multiplier-one part of `GSp₂ₘ`.
-/

public section

open CategoryTheory Matrix

namespace TauCeti.SymplecticSimilitude

universe u w

variable (R : Type u) [CommRing R] (m : ℕ)

/-! ### The symplectic specialization of the similitude construction -/

/-- **The Hopf ideal of `GSp₂ₘ`**: the ideal of the coordinate Hopf algebra of
`GL (m + m) × 𝔾_m` generated by the entries of `X Jₘ Xᵀ - r Jₘ`. -/
noncomputable abbrev definingHopfIdeal :
    HopfIdeal R (ConstantFormSimilitude.ambientHopfAlgebra R (m + m)) :=
  ConstantFormSimilitude.definingHopfIdeal R (m + m) (JFin m R)

/-- The coordinate Hopf algebra of `GSp₂ₘ`. -/
noncomputable abbrev coordinateHopfAlgebra : _root_.CommHopfAlgCat.{u} R :=
  ConstantFormSimilitude.coordinateHopfAlgebra R (m + m) (JFin m R)

/-- **The symplectic similitude group scheme `GSp₂ₘ`** over `R`. -/
noncomputable abbrev groupScheme := ConstantFormSimilitude.groupScheme R (m + m) (JFin m R)

/-- The closed immersion of `GSp₂ₘ` into `GL (m + m) × 𝔾_m`. -/
noncomputable abbrev inclusion := ConstantFormSimilitude.inclusion R (m + m) (JFin m R)

/-- **The multiplier character** `ν : GSp₂ₘ → 𝔾_m`, `(h, r) ↦ r`. -/
noncomputable abbrev multiplier := ConstantFormSimilitude.multiplier R (m + m) (JFin m R)

/-! ### Algebra-valued points -/

section Points

variable (A : Type w) [CommRing A] [Algebra R A]

/-- The group `GSp₂ₘ(A)` of symplectic similitudes: pairs `(h, r)` in `GL (m + m) (A) × Aˣ` with
`h Jₘ hᵀ = r Jₘ`. -/
abbrev pointsSubgroup : Subgroup (GL (Fin (m + m)) A × Aˣ) :=
  ConstantFormSimilitude.pointsSubgroup R (m + m) (JFin m R) A

variable {R m A}

/-- Membership in `GSp₂ₘ(A)`, in the row convention `h Jₘ hᵀ = r Jₘ`. -/
theorem mem_pointsSubgroup_iff (p : GL (Fin (m + m)) A × Aˣ) :
    p ∈ pointsSubgroup R m A ↔
      (p.1 : Matrix (Fin (m + m)) (Fin (m + m)) A) * JFin m A *
          (p.1 : Matrix (Fin (m + m)) (Fin (m + m)) A)ᵀ = (p.2 : A) • JFin m A := by
  rw [ConstantFormSimilitude.mem_pointsSubgroup_iff, JFin_map]

/-- **Membership in `GSp₂ₘ(A)` in the column convention** `hᵀ Jₘ h = r Jₘ`. -/
theorem mem_pointsSubgroup_iff' (p : GL (Fin (m + m)) A × Aˣ) :
    p ∈ pointsSubgroup R m A ↔
      (p.1 : Matrix (Fin (m + m)) (Fin (m + m)) A)ᵀ * JFin m A *
          (p.1 : Matrix (Fin (m + m)) (Fin (m + m)) A) = (p.2 : A) • JFin m A := by
  rw [mem_pointsSubgroup_iff]
  refine ⟨transpose_mul_JFin_mul_eq_smul p.2, fun h => ?_⟩
  have := transpose_mul_JFin_mul_eq_smul (M := (p.1 : Matrix _ _ A)ᵀ) p.2
    (by rwa [Matrix.transpose_transpose])
  rwa [Matrix.transpose_transpose] at this

variable (R m A)

/-- **The points identification**: the group of algebra-valued points of the coordinate Hopf
algebra of `GSp₂ₘ` is `GSp₂ₘ(A)`. -/
noncomputable abbrev pointsMulEquiv :
    HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R m) (CommAlgCat.of R A) ≃*
      pointsSubgroup R m A :=
  ConstantFormSimilitude.pointsMulEquiv R (m + m) (JFin m R)

/-- The multiplier on points, `GSp₂ₘ(A) → Aˣ`, `(h, r) ↦ r`. -/
abbrev multiplierPoints : pointsSubgroup R m A →* Aˣ :=
  ConstantFormSimilitude.multiplierPoints R (m + m) (JFin m R) A

variable {R m A}

/-- The multiplier of a point is its unit component. -/
theorem multiplierPoints_apply (p : pointsSubgroup R m A) :
    multiplierPoints R m A p = (p : GL (Fin (m + m)) A × Aˣ).2 :=
  ConstantFormSimilitude.multiplierPoints_apply R (m + m) (JFin m R) p

/-- Under the points identification, the multiplier on points is the multiplier character. -/
theorem multiplierPoints_pointsMulEquiv
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R m) (CommAlgCat.of R A)) :
    ((multiplierPoints R m A (pointsMulEquiv R m A f) : Aˣ) : A) =
      f.ofConv ((ConstantFormSimilitude.multiplierCoordinateMap R (m + m) (JFin m R)).hom
        (LaurentPolynomial.T 1)) :=
  ConstantFormSimilitude.multiplierPoints_pointsMulEquiv R (m + m) (JFin m R) f

/-- **The points identification is natural in the value algebra**: post-composing a point with
`phi` maps its similitude `(h, r)` to `(phi h, phi r)`. -/
theorem pointsMulEquiv_mapValue {B : Type*} [CommRing B] [Algebra R B] (phi : A →ₐ[R] B)
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R m) (CommAlgCat.of R A)) :
    pointsMulEquiv R m B (AlgHom.mapValue (H := coordinateHopfAlgebra R m) phi f) =
      ConstantFormSimilitude.pointsSubgroupMap R (m + m) (JFin m R) phi
        (pointsMulEquiv R m A f) :=
  ConstantFormSimilitude.pointsMulEquiv_mapValue R (m + m) (JFin m R) phi f

/-- **The kernel of the multiplier**: a similitude lies in the kernel of the multiplier exactly
when it is a pair `(h, 1)` with `h` symplectic. Such pairs are built with
`TauCeti.SymplecticSimilitude.mk_one_mem_pointsSubgroup`. -/
theorem mem_ker_multiplierPoints_iff (p : pointsSubgroup R m A) :
    p ∈ (multiplierPoints R m A).ker ↔
      (p : GL (Fin (m + m)) A × Aˣ).1 ∈ GLSymplecticFin m A ∧
        (p : GL (Fin (m + m)) A × Aˣ).2 = 1 := by
  rw [MonoidHom.mem_ker, multiplierPoints_apply, GLSymplecticFin.mem_iff]
  refine ⟨fun h => ⟨?_, h⟩, fun h => h.2⟩
  have hp := (mem_pointsSubgroup_iff _).mp p.property
  rwa [h, Units.val_one, one_smul] at hp

/-- A symplectic matrix with multiplier `1` is a similitude. -/
theorem mk_one_mem_pointsSubgroup {h : GL (Fin (m + m)) A} (hh : h ∈ GLSymplecticFin m A) :
    (h, (1 : Aˣ)) ∈ pointsSubgroup R m A := by
  rw [mem_pointsSubgroup_iff, Units.val_one, one_smul]
  exact GLSymplecticFin.mem_iff.mp hh

/-! ### `GSp₂ = GL₂` -/

/-- **In rank two the multiplier is the determinant**: `(h, r) ∈ GSp₂(A)` exactly when
`r = det h`. -/
theorem mem_pointsSubgroup_one_iff (p : GL (Fin (1 + 1)) A × Aˣ) :
    p ∈ pointsSubgroup R 1 A ↔ p.2 = Matrix.GeneralLinearGroup.det p.1 := by
  rw [mem_pointsSubgroup_iff, mul_JFin_one_mul_transpose_eq_smul_iff, Units.ext_iff,
    Matrix.GeneralLinearGroup.val_det_apply, eq_comm]

variable (R A)

/-- **`GSp₂ = GL₂`**: every invertible `2 × 2` matrix is a symplectic similitude, with multiplier
its determinant. -/
noncomputable def pointsSubgroupOneMulEquiv :
    GL (Fin (1 + 1)) A ≃* pointsSubgroup R 1 A where
  toFun h := ⟨(h, Matrix.GeneralLinearGroup.det h), (mem_pointsSubgroup_one_iff _).mpr rfl⟩
  invFun p := (p : GL (Fin (1 + 1)) A × Aˣ).1
  left_inv _ := rfl
  right_inv p := Subtype.ext (Prod.ext rfl ((mem_pointsSubgroup_one_iff _).mp p.property).symm)
  map_mul' g h := Subtype.ext (Prod.ext rfl (map_mul _ g h))

variable {R A}

/-- The similitude attached to `h : GL₂(A)` is `(h, det h)`. -/
@[simp]
theorem coe_pointsSubgroupOneMulEquiv_apply (h : GL (Fin (1 + 1)) A) :
    (pointsSubgroupOneMulEquiv R A h : GL (Fin (1 + 1)) A × Aˣ) =
      (h, Matrix.GeneralLinearGroup.det h) := by
  unfold pointsSubgroupOneMulEquiv
  rfl

/-- The matrix of a rank-two similitude is its first component. -/
@[simp]
theorem pointsSubgroupOneMulEquiv_symm_apply (p : pointsSubgroup R 1 A) :
    (pointsSubgroupOneMulEquiv R A).symm p = (p : GL (Fin (1 + 1)) A × Aˣ).1 := by
  unfold pointsSubgroupOneMulEquiv
  rfl

variable (R A)

/-- **`GSp₂ = GL₂` on points**: the group of algebra-valued points of `GSp₂` is `GL₂(A)`. -/
noncomputable def pointsMulEquivGLTwo :
    HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R 1) (CommAlgCat.of R A) ≃*
      GL (Fin (1 + 1)) A :=
  (pointsMulEquiv R 1 A).trans (pointsSubgroupOneMulEquiv R A).symm

variable {R A}

/-- Under `GSp₂ = GL₂`, the multiplier is the determinant. -/
theorem multiplierPoints_pointsSubgroupOneMulEquiv (h : GL (Fin (1 + 1)) A) :
    multiplierPoints R 1 A (pointsSubgroupOneMulEquiv R A h) =
      Matrix.GeneralLinearGroup.det h := by
  rw [multiplierPoints_apply, coe_pointsSubgroupOneMulEquiv_apply]

/-- The invertible matrix attached to a point of `GSp₂` is the matrix of its similitude. -/
@[simp]
theorem pointsMulEquivGLTwo_apply
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R 1) (CommAlgCat.of R A)) :
    pointsMulEquivGLTwo R A f = (pointsMulEquiv R 1 A f : GL (Fin (1 + 1)) A × Aˣ).1 := by
  rw [pointsMulEquivGLTwo, MulEquiv.trans_apply, pointsSubgroupOneMulEquiv_symm_apply]

/-- **Under `GSp₂ = GL₂` on points, the multiplier is the determinant.** -/
theorem det_pointsMulEquivGLTwo
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R 1) (CommAlgCat.of R A)) :
    Matrix.GeneralLinearGroup.det (pointsMulEquivGLTwo R A f) =
      multiplierPoints R 1 A (pointsMulEquiv R 1 A f) := by
  rw [pointsMulEquivGLTwo_apply, multiplierPoints_apply]
  exact ((mem_pointsSubgroup_one_iff _).mp (pointsMulEquiv R 1 A f).property).symm

/-- **`GSp₂ = GL₂` on points is natural in the value algebra**: post-composing a point with
`phi` applies `phi` to the entries of its invertible matrix. -/
theorem pointsMulEquivGLTwo_mapValue {B : Type*} [CommRing B] [Algebra R B] (phi : A →ₐ[R] B)
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R 1) (CommAlgCat.of R A)) :
    pointsMulEquivGLTwo R B (AlgHom.mapValue (H := coordinateHopfAlgebra R 1) phi f) =
      Matrix.GeneralLinearGroup.map (phi : A →+* B) (pointsMulEquivGLTwo R A f) := by
  rw [pointsMulEquivGLTwo_apply, pointsMulEquivGLTwo_apply, pointsMulEquiv_mapValue,
    ConstantFormSimilitude.coe_pointsSubgroupMap, Prod.map_fst]

end Points

end TauCeti.SymplecticSimilitude
