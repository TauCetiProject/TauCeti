module

public import TauCeti.Algebra.AlgebraicGroup.SpecialLinear.Basic
public import TauCeti.Algebra.AlgebraicGroup.Symplectic.Basic

import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Symplectic.RankOne

/-!
# `Sp₂ = SL₂`

For `2 × 2` matrices, `X J Xᵀ = det(X) J`
(`TauCeti.mul_JFin_one_mul_transpose_eq_det_smul`), where `J = JFin 1` is the standard
alternating form. So the entries of `X J Xᵀ - J` generate the same ideal of the coordinate algebra
of `GL₂` as `det X - 1`, and the symplectic subgroup scheme `Sp₂` of `GL₂` is the special linear
group scheme `SL₂`, as subgroup schemes of `GL₂`.

## Main declarations

* `TauCeti.Symplectic.definingHopfIdeal_one`: the defining Hopf ideal of `Sp₂` in `GL₂` is that
  of `SL₂`, so the two closed subgroup schemes of `GL₂` agree.
-/

public section

open Matrix

namespace TauCeti

universe u

namespace Symplectic

variable (R : Type u) [CommRing R]

/-- **`Sp₂ = SL₂`**: the defining Hopf ideal of the symplectic group `Sp₂` in `GL₂`, generated by
the entries of `X J Xᵀ - J`, is that of `SL₂`, generated by `det X - 1`. -/
theorem definingHopfIdeal_one : definingHopfIdeal R 1 = SpecialLinear.definingHopfIdeal R 2 := by
  have hrel : ConstantForm.relationMatrix R (1 + 1) (JFin 1 R) =
      ((GeneralLinear.determinantGroupLike R 2 : GeneralLinear.coordinateHopfAlgebra R 2) - 1) •
        JFin 1 (GeneralLinear.coordinateHopfAlgebra R 2) := by
    rw [ConstantForm.relationMatrix_def, JFin_map, mul_JFin_one_mul_transpose_eq_det_smul,
      GeneralLinear.det_genericMatrix, sub_smul, one_smul]
  have hspan : (definingHopfIdeal R 1).toIdeal = (SpecialLinear.definingHopfIdeal R 2).toIdeal := by
    rw [ConstantForm.definingHopfIdeal_toIdeal, SpecialLinear.definingHopfIdeal_toIdeal]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ hx
      obtain ⟨i, j, rfl⟩ := (ConstantForm.mem_relationSet_iff _ _ _).1 hx
      rw [hrel, Matrix.smul_apply, smul_eq_mul]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    · rw [Ideal.span_singleton_le_iff_mem]
      refine Ideal.subset_span ((ConstantForm.mem_relationSet_iff _ _ _).2 ⟨1, 0, ?_⟩)
      rw [hrel, Matrix.smul_apply, JFin_one_eq]
      simp
  ext x
  rw [← HopfIdeal.mem_toIdeal, hspan, HopfIdeal.mem_toIdeal]

end Symplectic

end TauCeti
