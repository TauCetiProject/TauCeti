module

public import TauCeti.Algebra.AlgebraicGroup.SpecialLinear.Basic
public import TauCeti.Algebra.AlgebraicGroup.Symplectic.Basic

/-!
# `Sp₂ = SL₂`

For `2 × 2` matrices, `X J Xᵀ = det(X) J`, where `J = JFin 1` is the standard alternating form.
So the entries of `X J Xᵀ - J` generate the same ideal of the coordinate algebra of `GL₂` as
`det X - 1`, and the symplectic subgroup scheme `Sp₂` of `GL₂` is the special linear group
scheme `SL₂`, as subgroup schemes of `GL₂`.

## Main declarations

* `TauCeti.JFin_one_eq`: the standard alternating form in rank one, written out.
* `TauCeti.mul_JFin_one_mul_transpose`: `M J Mᵀ = det(M) J` for a `2 × 2` matrix `M`.
* `TauCeti.Symplectic.definingHopfIdeal_one`: the defining Hopf ideal of `Sp₂` in `GL₂` is that
  of `SL₂`, so the two closed subgroup schemes of `GL₂` agree.
-/

public section

open Matrix

namespace TauCeti

variable {S : Type*} [CommRing S]

variable (S) in
/-- The standard alternating form of `Sp₂`, written out. -/
theorem JFin_one_eq : JFin 1 S = !![0, -1; 1, 0] := by
  rw [JFin_eq_submatrix]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.J, finSumFinEquiv, Fin.addCases, Matrix.fromBlocks]

/-- For a `2 × 2` matrix `M`, the transported alternating form is `M J Mᵀ = det(M) J`. -/
theorem mul_JFin_one_mul_transpose (M : Matrix (Fin (1 + 1)) (Fin (1 + 1)) S) :
    M * JFin 1 S * Mᵀ = M.det • JFin 1 S := by
  rw [JFin_one_eq]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.det_fin_two, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

namespace Symplectic

universe u

variable (R : Type u) [CommRing R]

/-- The determinant of the generic matrix of `GLₙ` is the determinant group-like element. -/
private theorem det_genericMatrix (n : ℕ) :
    (GeneralLinear.genericMatrix R n).det = GeneralLinear.determinantGroupLike R n := by
  have hmap : GeneralLinear.genericMatrix R n =
      (GeneralLinear.coordinateHopfAlgebraAlgEquiv R n).mapMatrix
        (GeneralLinear.localizedGenericMatrix R n) := by
    ext i j
    simp [GeneralLinear.localizedGenericMatrix_apply]
  rw [hmap, ← AlgEquiv.map_det, GeneralLinear.determinantGroupLike_val]

/-- **`Sp₂ = SL₂`**: the defining Hopf ideal of the symplectic group `Sp₂` in `GL₂`, generated by
the entries of `X J Xᵀ - J`, is that of `SL₂`, generated by `det X - 1`. -/
theorem definingHopfIdeal_one : definingHopfIdeal R 1 = SpecialLinear.definingHopfIdeal R 2 := by
  have hrel : relationMatrix R 1 =
      ((GeneralLinear.determinantGroupLike R 2 : GeneralLinear.coordinateHopfAlgebra R 2) - 1) •
        JFin 1 (GeneralLinear.coordinateHopfAlgebra R 2) := by
    rw [relationMatrix_def, mul_JFin_one_mul_transpose, det_genericMatrix, sub_smul, one_smul]
  have hspan : (definingHopfIdeal R 1).toIdeal = (SpecialLinear.definingHopfIdeal R 2).toIdeal := by
    rw [ConstantForm.definingHopfIdeal_toIdeal, SpecialLinear.definingHopfIdeal_toIdeal]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ hx
      obtain ⟨i, j, rfl⟩ := (ConstantForm.mem_relationSet_iff _ _ _).1 hx
      change relationMatrix R 1 i j ∈ _
      rw [hrel, Matrix.smul_apply, smul_eq_mul]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    · rw [Ideal.span_singleton_le_iff_mem]
      refine Ideal.subset_span ((ConstantForm.mem_relationSet_iff _ _ _).2 ⟨1, 0, ?_⟩)
      change relationMatrix R 1 1 0 = _
      rw [hrel, Matrix.smul_apply, JFin_one_eq]
      simp
  ext x
  rw [← HopfIdeal.mem_toIdeal, hspan, HopfIdeal.mem_toIdeal]

end Symplectic

end TauCeti
