import TauCeti.Algebra.Group.Subgroup.Map

/-!
# The standard symplectic flag stabilizer scheme

Inside `Sp₂ₘ`, impose triangularity in the ordered basis
`e₀, …, eₘ₋₁, fₘ₋₁, …, f₀`. The resulting finite-type closed subgroup
has exactly the standard triangular symplectic matrices as its points over every
commutative coefficient algebra. In paired coordinates, the upper-left block is
upper triangular, the lower-left block vanishes, and the lower-right block is
lower triangular. Its point groups are solvable.

This constructs the closed subgroup underlying the standard symplectic Borel.
Smoothness, geometric connectedness, and maximality among connected solvable
subgroups are separate properties; none is assumed in the construction.

## References

* J. S. Milne, *Algebraic Groups* (2017), §24.6.
* B. Conrad, *Reductive Group Schemes* (2014), §5.1.
* The quotient and point comparison follow
  `TauCeti.Algebra.AlgebraicGroup.SpecialLinear.UpperTriangular.Basic`.
* The Hopf ideal uses `GeneralLinear.weightParabolicDefiningHopfIdeal`.
-/

public section

open CategoryTheory WithConv

namespace TauCeti.Symplectic.UpperTriangular

universe u v w

variable (R : Type u) [CommRing R] (m : ℕ)

/-- Distinct descending weights along the standard symplectic flag order. -/
def weights (i : Fin (m + m)) : ℤ :=
  (m + m : ℕ) - 1 - (GLSymplecticFin.flagOrder m (finSumFinEquiv.symm i) : ℕ)

/-- On a paired basis vector, the weight is its descending flag-order position. -/
@[simp] theorem weights_finSumFinEquiv (i : Fin m ⊕ Fin m) :
    weights m (finSumFinEquiv i) =
      (m + m : ℕ) - 1 - (GLSymplecticFin.flagOrder m i : ℕ) := by
  simp only [weights, Equiv.symm_apply_apply]

/-- The Hopf ideal defining the standard symplectic flag stabilizer. -/
noncomputable def definingHopfIdeal : HopfIdeal R (Symplectic.coordinateHopfAlgebra R m) :=
  (GeneralLinear.weightParabolicDefiningHopfIdeal R (weights m)).map
    (Symplectic.coordinateMap R m).hom

/-- The flag-stabilizer ideal is the image of the ambient weight-parabolic ideal. -/
theorem definingHopfIdeal_def :
    definingHopfIdeal R m =
      (GeneralLinear.weightParabolicDefiningHopfIdeal R (weights m)).map
        (Symplectic.coordinateMap R m).hom := (rfl)

/-- The flag-stabilizer ideal is generated by the forbidden matrix coordinates. -/
theorem definingHopfIdeal_toIdeal :
    (definingHopfIdeal R m).toIdeal =
      Ideal.span ((Symplectic.coordinateMap R m).hom ''
        GeneralLinear.weightParabolicRelationSet R (weights m)) := by
  rw [definingHopfIdeal_def, HopfIdeal.map_toIdeal,
    GeneralLinear.weightParabolicDefiningHopfIdeal_toIdeal, Ideal.map_span]
  rfl

/-- The standard symplectic flag stabilizer contains the paired diagonal torus,
expressed by the reversed containment of their defining Hopf ideals. -/
theorem definingHopfIdeal_le_diagonalTorusDefiningIdeal :
    definingHopfIdeal R m ≤ diagonalTorusDefiningIdeal R m := by
  rw [← HopfIdeal.toIdeal_le_toIdeal, definingHopfIdeal_toIdeal, Ideal.span_le]
  rintro x ⟨y, hy, rfl⟩
  obtain ⟨i, j, hij, rfl⟩ :=
    (GeneralLinear.mem_weightParabolicRelationSet_iff R (weights m) y).mp hy
  rw [SetLike.mem_coe, HopfIdeal.mem_toIdeal, mem_diagonalTorusDefiningIdeal]
  exact coordinateMap_comp_diagonalTorusCoordinateMap_X_of_ne i j
    (fun h => (lt_irrefl _ (h ▸ hij)))

private theorem tangentMatrix_blockTriangular_flagOrder
    {A : Type*} [CommRing A] (root : GLSymplecticFin.RootSubgroupIndex m)
    (hroot : (diagonalRootBase.{u} m).IsPos root) (c : A) :
    (root.tangentMatrix c).BlockTriangular (GLSymplecticFin.flagOrder m) := by
  have hpos (i j : Fin m) :
      GLSymplecticFin.flagOrder m (.inl i) ≤ GLSymplecticFin.flagOrder m (.inr j) := by
    simp only [GLSymplecticFin.flagOrder_inl, GLSymplecticFin.flagOrder_inr,
      Fin.le_def, Fin.val_castAdd, Fin.val_natAdd, Fin.val_rev]
    omega
  cases root with
  | positiveLong i =>
    rw [GLSymplecticFin.RootSubgroupIndex.tangentMatrix_positiveLong]
    exact Matrix.blockTriangular_single (hpos i i) c
  | negativeLong i => exact (not_diagonalRootBase_isPos_negativeLong i hroot).elim
  | difference i j hij =>
    have hij' := (diagonalRootBase_isPos_difference_iff hij).mp hroot
    rw [GLSymplecticFin.RootSubgroupIndex.tangentMatrix_difference]
    apply Matrix.BlockTriangular.sub <;> apply Matrix.blockTriangular_single
    · simp only [GLSymplecticFin.flagOrder_inl, Fin.le_def, Fin.val_castAdd]
      exact (Fin.le_def.mp hij'.le)
    · simp only [GLSymplecticFin.flagOrder_inr, Fin.le_def, Fin.val_natAdd, Fin.val_rev]
      have := Fin.lt_def.mp hij'
      omega
  | positiveSum i j hij =>
    rw [GLSymplecticFin.RootSubgroupIndex.tangentMatrix_positiveSum]
    exact (Matrix.blockTriangular_single (hpos i j) c).add
      (Matrix.blockTriangular_single (hpos j i) c)
  | negativeSum i j hij => exact (not_diagonalRootBase_isPos_negativeSum hij hroot).elim

/-- Every positive root subgroup factors through the standard symplectic flag stabilizer:
its coordinate morphism kills the defining ideal over the entire additive group scheme. -/
theorem definingHopfIdeal_toIdeal_le_ker_rootSubgroupCoordinateMap
    (root : GLSymplecticFin.RootSubgroupIndex m)
    (hroot : (diagonalRootBase.{u} m).IsPos root) :
    (definingHopfIdeal R m).toIdeal ≤
      RingHom.ker (rootSubgroupCoordinateMap (R := R) root).hom.toAlgHom.toRingHom := by
  rw [definingHopfIdeal_toIdeal, Ideal.span_le]
  rintro x ⟨y, hy, rfl⟩
  obtain ⟨i, j, hij, rfl⟩ :=
    (GeneralLinear.mem_weightParabolicRelationSet_iff R (weights m) y).mp hy
  obtain ⟨i, rfl⟩ := finSumFinEquiv.surjective i
  obtain ⟨j, rfl⟩ := finSumFinEquiv.surjective j
  rw [SetLike.mem_coe, RingHom.mem_ker]
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, BialgHom.coe_toAlgHom]
  rw [rootSubgroupCoordinateMap_apply_X]
  have htri := (Matrix.blockTriangular_one (b := GLSymplecticFin.flagOrder m)).add
    (tangentMatrix_blockTriangular_flagOrder m root hroot (SymmetricAlgebra.ι R R 1))
  apply htri
  simp only [weights_finSumFinEquiv] at hij
  omega

/-- The coordinate Hopf algebra of the standard symplectic flag stabilizer. -/
noncomputable abbrev coordinateHopfAlgebra : _root_.CommHopfAlgCat.{u} R :=
  CommHopfAlgCat.quotient (Symplectic.coordinateHopfAlgebra R m) (definingHopfIdeal R m)

/-- The quotient morphism from the symplectic coordinate Hopf algebra. -/
noncomputable abbrev coordinateMap :
    Symplectic.coordinateHopfAlgebra R m ⟶ coordinateHopfAlgebra R m :=
  CommHopfAlgCat.mkQuotient _ (definingHopfIdeal R m)

/-- The affine group scheme stabilizing the standard symplectic flag. -/
noncomputable abbrev groupScheme :=
  CommHopfAlgCat.quotientSpec (Symplectic.coordinateHopfAlgebra R m) (definingHopfIdeal R m)

/-- The closed inclusion of the standard flag stabilizer into the symplectic group scheme. -/
noncomputable abbrev inclusion : groupScheme R m ⟶ Symplectic.groupScheme R m :=
  CommHopfAlgCat.quotientSpecι (Symplectic.coordinateHopfAlgebra R m) (definingHopfIdeal R m)

/-- The flag-stabilizer inclusion is a closed immersion over every base ring. -/
instance : AlgebraicGeometry.IsClosedImmersion (inclusion R m).hom.hom.left := by
  infer_instance

/-- Its coordinate algebra is finitely generated over the base ring. -/
instance : Algebra.FiniteType R (coordinateHopfAlgebra R m) :=
  Algebra.FiniteType.quotient R (definingHopfIdeal R m).toIdeal

section Points

variable {A : Type v} [CommRing A] [Algebra R A]

/-- A symplectic point belongs to the closed flag stabilizer exactly when its
matrix lies in the standard triangular symplectic subgroup. -/
@[simp] theorem mem_definingPointsSubgroup_iff
    (g : HopfAlgebra.points (R := R) (H := Symplectic.coordinateHopfAlgebra R m)
      (CommAlgCat.of R A)) :
    g ∈ CommHopfAlgCat.quotientPointsSubgroup
        (Symplectic.coordinateHopfAlgebra R m) (definingHopfIdeal R m)
        (CommAlgCat.of R A) ↔
      Symplectic.pointsMulEquiv (R := R) (A := A) m g ∈ GLSymplecticFin.upperTriangular m A := by
  -- Restriction of a symplectic point along the coordinate quotient preserves its matrix.
  have hmatrix : GeneralLinear.pointsMulEquiv (m + m)
      ((CommHopfAlgCat.mapPointsFunctor (Symplectic.coordinateMap R m)).app
        (CommAlgCat.of R A) g) =
      (Symplectic.pointsMulEquiv R m (A := A) g : Matrix.GeneralLinearGroup _ A) := by
    rw [CommHopfAlgCat.mapPointsFunctor_app_apply, Symplectic.coordinateMap_def,
      ← CommHopfAlgCat.quotientPointsHom_apply]
    exact Symplectic.pointsMulEquiv_coe R m g
  rw [definingHopfIdeal_def,
    CommHopfAlgCat.mem_quotientPointsSubgroup_map_iff_of_surjective
      (Symplectic.coordinateMap R m)
      (by
        rw [Symplectic.coordinateMap_def]
        exact CommHopfAlgCat.mkQuotient_surjective _ _),
    GeneralLinear.mem_weightParabolicDefiningPointsSubgroup_iff_blockTriangular,
    hmatrix, GLSymplecticFin.mem_upperTriangular_iff]
  simp only [Matrix.BlockTriangular, Function.comp_apply, OrderDual.toDual_lt_toDual,
    Matrix.submatrix_apply]
  constructor
  · intro h i j hij
    exact h (by simp only [weights_finSumFinEquiv]; omega)
  · intro h i j hij
    obtain ⟨i, rfl⟩ := finSumFinEquiv.surjective i
    obtain ⟨j, rfl⟩ := finSumFinEquiv.surjective j
    apply h
    simp only [weights_finSumFinEquiv] at hij
    omega

private noncomputable def definingPointsSubgroupMulEquiv :
    CommHopfAlgCat.quotientPointsSubgroup
        (Symplectic.coordinateHopfAlgebra R m) (definingHopfIdeal R m) (CommAlgCat.of R A) ≃*
      GLSymplecticFin.upperTriangular m A :=
  Subgroup.congrOfMapEq (Symplectic.pointsMulEquiv (R := R) (A := A) m) <| by
    ext g
    rw [← (Symplectic.pointsMulEquiv (R := R) (A := A) m).toMonoidHom_eq_coe,
      Subgroup.mem_map_equiv, mem_definingPointsSubgroup_iff, MulEquiv.apply_symm_apply]

/-- The flag-stabilizer scheme represents triangular symplectic matrices over
every commutative coefficient algebra. -/
noncomputable def pointsMulEquiv :
    HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R m) (CommAlgCat.of R A) ≃*
      GLSymplecticFin.upperTriangular m A :=
  ((CommHopfAlgCat.quotientPointsSubgroupNatIso
      (Symplectic.coordinateHopfAlgebra R m) (definingHopfIdeal R m)).app
      (CommAlgCat.of R A)).groupIsoToMulEquiv.trans
    (definingPointsSubgroupMulEquiv R m)

/-- The point comparison preserves the ambient symplectic matrix. -/
@[simp] theorem pointsMulEquiv_coe
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R m) (CommAlgCat.of R A)) :
    Symplectic.pointsMulEquiv (R := R) (A := A) m
        (CommHopfAlgCat.quotientPointsHom
          (Symplectic.coordinateHopfAlgebra R m) (definingHopfIdeal R m)
          (CommAlgCat.of R A) f) =
      (pointsMulEquiv R m (A := A) f : GLSymplecticFin m A) := by
  have h := CommHopfAlgCat.quotientPointsSubgroupNatIso_hom_app_apply
    (Symplectic.coordinateHopfAlgebra R m) (definingHopfIdeal R m) (CommAlgCat.of R A) f
  calc
    _ = Symplectic.pointsMulEquiv (R := R) (A := A) m
          (((CommHopfAlgCat.quotientPointsSubgroupNatIso
            (Symplectic.coordinateHopfAlgebra R m) (definingHopfIdeal R m)).app
            (CommAlgCat.of R A)).hom f).val :=
      (congrArg (fun g => Symplectic.pointsMulEquiv (R := R) (A := A) m g.val) h).symm
    _ = _ := (Subgroup.coe_congrOfMapEq_apply _ _ _).symm

/-- The point comparison commutes with extension of the value algebra. -/
theorem pointsMulEquiv_mapValue {B : Type w} [CommRing B] [Algebra R B]
    (φ : A →ₐ[R] B)
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R m) (CommAlgCat.of R A)) :
    (pointsMulEquiv R m (A := B) (AlgHom.mapValue (H := coordinateHopfAlgebra R m) φ f) :
        GLSymplecticFin m B) =
      GLSymplecticFin.map m A φ.toRingHom (pointsMulEquiv R m (A := A) f) := by
  rw [← pointsMulEquiv_coe, ← CommHopfAlgCat.mapValue_quotientPointsHom,
    Symplectic.pointsMulEquiv_mapValue, pointsMulEquiv_coe]
  rfl

/-- Every algebra-valued point group of the symplectic flag stabilizer is solvable. -/
theorem isSolvable_points :
    Group.IsSolvable
      (HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R m) (CommAlgCat.of R A)) :=
  Group.isSolvable_of_isSolvable_injective (f := (pointsMulEquiv R m (A := A)).toMonoidHom)
    (pointsMulEquiv R m (A := A)).injective

end Points

/-- The standard symplectic flag stabilizer has solvable geometric points. -/
theorem geometricallySolvablePointsCommHopfAlgProperty_coordinateHopfAlgebra
    (k : Type u) [Field k] :
    geometricallySolvablePointsCommHopfAlgProperty k (coordinateHopfAlgebra k m) := by
  rw [geometricallySolvablePointsCommHopfAlgProperty_iff]
  exact isSolvable_points k m

end TauCeti.Symplectic.UpperTriangular
