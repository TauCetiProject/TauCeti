/-!
# The pieces of the loop group are affine

Let `H` be a commutative Hopf algebra over a commutative ring `k`, generated as a `k`-algebra by a
family `x : ι → H`. This file shows that each piece `LG_(≤N)` of pole-bounded loops
(`TauCeti.HopfAlgebra.poleBoundedLoops`) is represented by a commutative `k`-algebra, and that the
inclusion `LG_(≤N) ⊆ LG_(≤M)` for `N ≤ M` is induced by a surjection of these algebras. When `x`
is finite, the pieces moreover exhaust the loop group
(`TauCeti.HopfAlgebra.iUnion_poleBoundedLoops`), so that the loop group is an ind-affine functor.

A loop `g` of `LG_(≤N)(R)` is determined by the coefficients `a_(i,m) ∈ R` of
`g (x i) = Σ_(m ≥ 0) a_(i,m) X^(m - N)`. The representing algebra is the polynomial algebra
`k[a_(i,m)]` modulo the ideal `J_N` generated by

* every coefficient of `f(Σ_m a_(·,m) X^(m - N))`, for each relation `f` with `f(x) = 0`;
* every coefficient of `X`-degree below `-N` of `f(Σ_m a_(·,m) X^(m - N))`, for each `f` with
  `f(x) = S(x i)`, where `S` is the antipode: this bounds the poles of the inverse loop.

No finiteness is needed for the representability of each piece or for the transition maps: the
family `x` and the relations may be infinite. Exhaustion of the loop group by the pieces, and
the independence of the ind-affine presentation from the generators, require finite families.

## Main definitions

* `TauCeti.HopfAlgebra.poleBoundedSeries ι k N i`: the universal series
  `Σ_m a_(i,m) X^(m - N)` over `k[a_(i,m)]`.
* `TauCeti.HopfAlgebra.poleBoundedIdeal k x N`: the ideal `J_N`.
* `TauCeti.HopfAlgebra.poleBoundedAlgebra k x N`: the representing algebra `k[a_(i,m)] ⧸ J_N`.
* `TauCeti.HopfAlgebra.poleBoundedEquiv x hx N R`: the bijection between `k`-algebra maps
  `poleBoundedAlgebra k x N → R` and `LG_(≤N)(R)`.
* `TauCeti.HopfAlgebra.poleBoundedTransition x hx h`: for `N ≤ M`, the map of representing
  algebras inducing `LG_(≤N) ⊆ LG_(≤M)`.

## Main results

* `TauCeti.HopfAlgebra.poleBoundedEquiv_comp_apply`: the bijection is natural in `R`, the
  functoriality of `LG_(≤N)` being the coefficientwise map.
* `TauCeti.HopfAlgebra.poleBoundedEquiv_comp_poleBoundedTransition`: the transition maps induce
  the inclusions of the pieces.
* `TauCeti.HopfAlgebra.poleBoundedTransition_surjective`: the transition maps are surjective, so
  `LG_(≤N)` is a closed subfunctor of `LG_(≤M)`.

## References

* E. Frenkel, *Langlands correspondence for loop groups*, Cambridge Univ. Press (2007), §1.3.1.
-/

public section

open HahnSeries WithConv TauCeti.LaurentSeries MvPolynomial
open HopfAlgebraStruct (antipode)
open scoped LaurentSeries PowerSeries

namespace TauCeti

namespace HopfAlgebra

attribute [local instance 1100] HahnSeries.instAlgebra

universe u v w

section UniversalSeries

variable (ι : Type*) (k : Type u) [CommSemiring k]

/-- The universal Laurent series `Σ_(m ≥ 0) a_(i,m) X^(m - N)` of level `N`, with coefficients
the variables `a_(i,m) = X (i, m)` of the polynomial algebra `k[a_(i,m)]`. -/
noncomputable def poleBoundedSeries (N : ℕ) (i : ι) : (MvPolynomial (ι × ℕ) k)⸨X⸩ :=
  single (-(N : ℤ)) 1 * ofPowerSeries ℤ _ (PowerSeries.mk fun m ↦ X (i, m))

variable {ι k}

/-- The universal series of level `N` has no pole of order larger than `N`. -/
theorem poleBoundedSeries_mem_lattice (N : ℕ) (i : ι) :
    poleBoundedSeries ι k N i ∈ lattice (MvPolynomial (ι × ℕ) k) (MvPolynomial (ι × ℕ) k) (-N) :=
  mem_lattice_iff_exists.2 ⟨_, rfl⟩

/-- The coefficient of `X^(m - N)` in the universal series of level `N` is the variable
`a_(i,m)`. -/
@[simp]
theorem coeff_poleBoundedSeries (N : ℕ) (i : ι) (m : ℕ) :
    (poleBoundedSeries ι k N i).coeff (m - N) = X (i, m) := by
  rw [poleBoundedSeries, sub_eq_add_neg, coeff_single_mul_add, one_mul,
    LaurentSeries.coeff_coe_powerSeries, PowerSeries.coeff_mk]

/-- Specializing the universal series of level `N` along `ψ` gives the series with coefficients
`ψ (a_(i,m))`. -/
theorem coeff_map_poleBoundedSeries {R : Type*} [CommSemiring R] [Algebra k R]
    (ψ : MvPolynomial (ι × ℕ) k →ₐ[k] R) (N : ℕ) (i : ι) (m : ℕ) :
    ((poleBoundedSeries ι k N i).map ψ).coeff (m - N) = ψ (X (i, m)) := by
  rw [map_coeff, coeff_poleBoundedSeries]

/-- Every specialization of the universal series of level `N` has no pole of order larger than
`N`. -/
theorem map_poleBoundedSeries_mem_lattice {R : Type*} [CommSemiring R] [Algebra k R]
    (ψ : MvPolynomial (ι × ℕ) k →ₐ[k] R) (N : ℕ) (i : ι) :
    (poleBoundedSeries ι k N i).map ψ ∈ lattice R R (-N) :=
  mem_lattice_iff.2 fun n hn ↦ by
    rw [map_coeff, mem_lattice_iff.1 (poleBoundedSeries_mem_lattice N i) n hn, map_zero]

/-- Every family of Laurent series without poles of order larger than `N` is a specialization of
the universal series of level `N`, at the coefficients `a_(i,m) ↦ (F i).coeff (m - N)`. -/
theorem map_poleBoundedSeries_aeval_coeff {R : Type*} [CommSemiring R] [Algebra k R] {N : ℕ}
    {F : ι → R⸨X⸩} (hF : ∀ i, F i ∈ lattice R R (-N)) (i : ι) :
    (poleBoundedSeries ι k N i).map (aeval fun p : ι × ℕ ↦ (F p.1).coeff (p.2 - N)) = F i :=
  eq_of_mem_lattice_of_coeff_eq (map_poleBoundedSeries_mem_lattice _ N i) (hF i) fun n hn ↦ by
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, n = m - N := ⟨(n + N).toNat, by omega⟩
    rw [coeff_map_poleBoundedSeries, aeval_X]

end UniversalSeries

variable (k : Type u) [CommRing k] {H : Type v} [CommRing H] [_root_.HopfAlgebra k H]
  {ι : Type*} (x : ι → H)

/-- The ideal `J_N` of `k[a_(i,m)]` cutting out the piece `LG_(≤N)`: it is generated by the
coefficients of `f(Σ_m a_(·,m) X^(m - N))` for the relations `f(x) = 0`, and by its
coefficients of `X`-degree below `-N` when `f(x)` is the antipode of some `x i`. -/
noncomputable def poleBoundedIdeal (N : ℕ) : Ideal (MvPolynomial (ι × ℕ) k) :=
  Ideal.span ({a | ∃ (f : MvPolynomial ι k) (n : ℤ), aeval x f = 0 ∧
      (aeval (poleBoundedSeries ι k N) f).coeff n = a} ∪
    {a | ∃ (f : MvPolynomial ι k) (i : ι), ∃ n < -(N : ℤ), aeval x f = antipode k (x i) ∧
      (aeval (poleBoundedSeries ι k N) f).coeff n = a})

/-- The commutative `k`-algebra `k[a_(i,m)] ⧸ J_N` representing the piece `LG_(≤N)` of the loop
group (`poleBoundedEquiv`). -/
abbrev poleBoundedAlgebra (N : ℕ) : Type _ :=
  MvPolynomial (ι × ℕ) k ⧸ poleBoundedIdeal k x N

variable {k x}

/-- A map `ψ : k[a_(i,m)] → R` kills `J_N` exactly when the series
`f(Σ_m ψ(a_(·,m)) X^(m - N))` vanishes for every relation `f(x) = 0` and has no pole of order
larger than `N` whenever `f(x)` is the antipode of some `x i`. -/
theorem poleBoundedIdeal_le_ker_iff {R : Type*} [CommRing R] [Algebra k R] {N : ℕ}
    (ψ : MvPolynomial (ι × ℕ) k →ₐ[k] R) :
    poleBoundedIdeal k x N ≤ RingHom.ker ψ ↔
      (∀ f : MvPolynomial ι k, aeval x f = 0 →
        aeval (fun i ↦ (poleBoundedSeries ι k N i).map ψ) f = 0) ∧
      ∀ (f : MvPolynomial ι k) (i : ι), aeval x f = antipode k (x i) →
        aeval (fun i ↦ (poleBoundedSeries ι k N i).map ψ) f ∈ lattice R R (-N) := by
  simp only [poleBoundedIdeal, Ideal.span_le, Set.union_subset_iff, ← HahnSeries.map_aeval]
  refine and_congr ⟨fun h f hf ↦ ?_, fun h a ⟨f, n, hf, ha⟩ ↦ ?_⟩
    ⟨fun h f i hf ↦ mem_lattice_iff.2 fun n hn ↦ ?_, fun h a ⟨f, i, n, hn, hf, ha⟩ ↦ ?_⟩
  · ext n
    exact h ⟨f, n, hf, rfl⟩
  · rw [← ha, SetLike.mem_coe, RingHom.mem_ker, ← map_coeff (f := ψ), h f hf, coeff_zero]
  · exact h ⟨f, i, n, hn, hf, rfl⟩
  · rw [← ha, SetLike.mem_coe, RingHom.mem_ker, ← map_coeff (f := ψ)]
    exact mem_lattice_iff.1 (h f i hf) n hn

variable (x) (hx : Algebra.adjoin k (Set.range x) = ⊤)

variable {R : Type w} [CommRing R] [Algebra k R]

/-- The loop attached to a map `ψ : k[a_(i,m)] → R` killing `J_N`: the unique `k`-algebra map
`H → R⸨X⸩` sending `x i` to `Σ_m ψ(a_(i,m)) X^(m - N)`. -/
private noncomputable def loopOfHom {N : ℕ} (ψ : MvPolynomial (ι × ℕ) k →ₐ[k] R)
    (hψ : poleBoundedIdeal k x N ≤ RingHom.ker ψ) : H →ₐ[k] R⸨X⸩ :=
  AlgHom.liftOfSurjective (aeval x) (aeval_surjective_iff_adjoin_range_eq_top.2 hx)
    (aeval fun i ↦ (poleBoundedSeries ι k N i).map ψ)
    fun f hf ↦ ((poleBoundedIdeal_le_ker_iff ψ).1 hψ).1 f hf

private theorem loopOfHom_aeval {N : ℕ} (ψ : MvPolynomial (ι × ℕ) k →ₐ[k] R)
    (hψ : poleBoundedIdeal k x N ≤ RingHom.ker ψ) (f : MvPolynomial ι k) :
    loopOfHom x hx ψ hψ (aeval x f) = aeval (fun i ↦ (poleBoundedSeries ι k N i).map ψ) f :=
  AlgHom.liftOfSurjective_apply _ _ _ _ f

private theorem coeff_loopOfHom {N : ℕ} (ψ : MvPolynomial (ι × ℕ) k →ₐ[k] R)
    (hψ : poleBoundedIdeal k x N ≤ RingHom.ker ψ) (i : ι) (m : ℕ) :
    (loopOfHom x hx ψ hψ (x i)).coeff (m - N) = ψ (X (i, m)) := by
  rw [← aeval_X (R := k) x i, loopOfHom_aeval, aeval_X, coeff_map_poleBoundedSeries]

private theorem loopOfHom_mem {N : ℕ} (ψ : MvPolynomial (ι × ℕ) k →ₐ[k] R)
    (hψ : poleBoundedIdeal k x N ≤ RingHom.ker ψ) :
    toConv (loopOfHom x hx ψ hψ) ∈ poleBoundedLoops k x R N := by
  refine mem_poleBoundedLoops_iff_antipode.2 fun i ↦ ⟨?_, ?_⟩
  · rw [ofConv_toConv, ← aeval_X (R := k) x i, loopOfHom_aeval, aeval_X]
    exact map_poleBoundedSeries_mem_lattice ψ N i
  · obtain ⟨f, hf⟩ := aeval_surjective_iff_adjoin_range_eq_top.2 hx (antipode k (x i))
    rw [ofConv_toConv, ← hf, loopOfHom_aeval]
    exact ((poleBoundedIdeal_le_ker_iff ψ).1 hψ).2 f i hf

/-- The coefficient map `a_(i,m) ↦ (g (x i)).coeff (m - N)` of a loop `g`. -/
private noncomputable def coeffHom (N : ℕ) (g : WithConv (H →ₐ[k] R⸨X⸩)) :
    MvPolynomial (ι × ℕ) k →ₐ[k] R :=
  aeval fun p ↦ (g.ofConv (x p.1)).coeff (p.2 - N)

private theorem coeffHom_X (N : ℕ) (g : WithConv (H →ₐ[k] R⸨X⸩)) (i : ι) (m : ℕ) :
    coeffHom x N g (X (i, m)) = (g.ofConv (x i)).coeff (m - N) :=
  aeval_X _ _

private theorem map_poleBoundedSeries_coeffHom {N : ℕ} {g : WithConv (H →ₐ[k] R⸨X⸩)}
    (hg : g ∈ poleBoundedLoops k x R N) (i : ι) :
    (poleBoundedSeries ι k N i).map (coeffHom x N g) = g.ofConv (x i) :=
  map_poleBoundedSeries_aeval_coeff (fun i ↦ (mem_poleBoundedLoops_iff.1 hg i).1) i

private theorem poleBoundedIdeal_le_ker_coeffHom {N : ℕ} {g : WithConv (H →ₐ[k] R⸨X⸩)}
    (hg : g ∈ poleBoundedLoops k x R N) :
    poleBoundedIdeal k x N ≤ RingHom.ker (coeffHom x N g) := by
  have hval (f : MvPolynomial ι k) :
      aeval (fun i ↦ (poleBoundedSeries ι k N i).map (coeffHom x N g)) f =
        g.ofConv (aeval x f) := by
    simp only [map_poleBoundedSeries_coeffHom x hg]
    exact (DFunLike.congr_fun (comp_aeval (R := k) x g.ofConv) f).symm
  refine (poleBoundedIdeal_le_ker_iff _).2 ⟨fun f hf ↦ ?_, fun f i hf ↦ ?_⟩
  · rw [hval, hf, map_zero]
  · rw [hval, hf]
    exact (mem_poleBoundedLoops_iff_antipode.1 hg i).2

private theorem le_ker_comp_mkₐ {N : ℕ} (φ : poleBoundedAlgebra k x N →ₐ[k] R) :
    poleBoundedIdeal k x N ≤ RingHom.ker (φ.comp (Ideal.Quotient.mkₐ k _)) := fun a ha ↦ by
  rw [RingHom.mem_ker, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq_zero_iff_mem.2 ha, map_zero]

variable (R) in
/-- **The pieces of the loop group are affine.** For a generating family `x` of `H`, the
`k`-algebra maps `poleBoundedAlgebra k x N → R` correspond bijectively to the pole-bounded loops
`LG_(≤N)(R)`: a map `φ` corresponds to the loop sending `x i` to `Σ_m φ(a_(i,m)) X^(m - N)`. -/
noncomputable def poleBoundedEquiv (N : ℕ) :
    (poleBoundedAlgebra k x N →ₐ[k] R) ≃ poleBoundedLoops k x R N where
  toFun φ := ⟨toConv (loopOfHom x hx _ (le_ker_comp_mkₐ x φ)), loopOfHom_mem x hx _ _⟩
  invFun g := Ideal.Quotient.liftₐ _ (coeffHom x N g.val)
    fun _ ha ↦ RingHom.mem_ker.1 (poleBoundedIdeal_le_ker_coeffHom x g.property ha)
  left_inv φ := by
    refine Ideal.Quotient.algHom_ext _ (algHom_ext fun ⟨i, m⟩ ↦ ?_)
    dsimp only
    rw [Ideal.Quotient.liftₐ_comp, coeffHom_X, ofConv_toConv, coeff_loopOfHom]
  right_inv g := by
    refine Subtype.ext (ofConv_injective (AlgHom.ext_of_adjoin_eq_top hx ?_))
    rintro _ ⟨i, rfl⟩
    rw [ofConv_toConv, ← aeval_X (R := k) x i, loopOfHom_aeval, aeval_X, aeval_X]
    convert map_poleBoundedSeries_coeffHom x g.property i using 2
    exact Ideal.Quotient.liftₐ_comp _ _ _

/-- The loop attached to `φ` sends `x i` to the series with coefficient `φ(a_(i,m))` at
`X^(m - N)`. -/
@[simp]
theorem coeff_poleBoundedEquiv_apply {N : ℕ} (φ : poleBoundedAlgebra k x N →ₐ[k] R) (i : ι)
    (m : ℕ) :
    ((poleBoundedEquiv x hx R N φ).val.ofConv (x i)).coeff (m - N) =
      φ (Ideal.Quotient.mk _ (X (i, m))) := by
  simp only [poleBoundedEquiv, Equiv.coe_fn_mk, ofConv_toConv]
  rw [coeff_loopOfHom, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]

/-- The map attached to a loop `g` sends `a_(i,m)` to the coefficient of `X^(m - N)` in
`g (x i)`. -/
@[simp]
theorem poleBoundedEquiv_symm_apply_mk_X {N : ℕ} (g : poleBoundedLoops k x R N) (i : ι)
    (m : ℕ) :
    (poleBoundedEquiv x hx R N).symm g (Ideal.Quotient.mk _ (X (i, m))) =
      (g.val.ofConv (x i)).coeff (m - N) := by
  rw [poleBoundedEquiv, Equiv.coe_fn_symm_mk, ← Ideal.Quotient.mkₐ_eq_mk k, ← AlgHom.comp_apply,
    Ideal.Quotient.liftₐ_comp, coeffHom_X]

/-- **Naturality of `poleBoundedEquiv`.** Composing with a `k`-algebra map `ψ : R → S` acts on
the corresponding loops by applying `ψ` to every coefficient. -/
theorem poleBoundedEquiv_comp_apply {S : Type*} [CommRing S] [Algebra k S] {N : ℕ}
    (ψ : R →ₐ[k] S) (φ : poleBoundedAlgebra k x N →ₐ[k] R) (h : H) :
    (poleBoundedEquiv x hx S N (ψ.comp φ)).val.ofConv h =
      ((poleBoundedEquiv x hx R N φ).val.ofConv h).map ψ := by
  obtain ⟨f, rfl⟩ := aeval_surjective_iff_adjoin_range_eq_top.2 hx h
  simp only [poleBoundedEquiv, Equiv.coe_fn_mk, ofConv_toConv, loopOfHom_aeval,
    HahnSeries.map_aeval]
  refine congrArg (fun s ↦ aeval s f) (funext fun i ↦ HahnSeries.ext (funext fun n ↦ ?_))
  simp only [map_coeff, AlgHom.comp_apply]

variable {M N : ℕ}

/-- For `N ≤ M`, the map `poleBoundedAlgebra k x M → poleBoundedAlgebra k x N` of representing
algebras inducing the inclusion `LG_(≤N) ⊆ LG_(≤M)`: it corresponds to the universal loop of
level `N`, viewed as a loop of level `M`. -/
noncomputable def poleBoundedTransition (h : N ≤ M) :
    poleBoundedAlgebra k x M →ₐ[k] poleBoundedAlgebra k x N :=
  (poleBoundedEquiv x hx _ M).symm
    ⟨_, poleBoundedLoops_mono k x _ h (poleBoundedEquiv x hx _ N (AlgHom.id k _)).property⟩

/-- The transition map sends `a_(i, m + (M - N))` to `a_(i,m)`: shifting the coefficients of the
universal series. -/
@[simp]
theorem poleBoundedTransition_mk_X (h : N ≤ M) (i : ι) (m : ℕ) :
    poleBoundedTransition x hx h (Ideal.Quotient.mk _ (X (i, m + (M - N)))) =
      Ideal.Quotient.mk _ (X (i, m)) := by
  rw [poleBoundedTransition, poleBoundedEquiv_symm_apply_mk_X]
  have : ((m + (M - N) : ℕ) : ℤ) - M = m - N := by omega
  rw [this, coeff_poleBoundedEquiv_apply, AlgHom.id_apply]

/-- **The transition maps induce the inclusions of the pieces**: the loop of level `M` attached
to `φ ∘ poleBoundedTransition` is the loop of level `N` attached to `φ`. -/
theorem poleBoundedEquiv_comp_poleBoundedTransition (h : N ≤ M)
    (φ : poleBoundedAlgebra k x N →ₐ[k] R) :
    (poleBoundedEquiv x hx R M (φ.comp (poleBoundedTransition x hx h))).val =
      (poleBoundedEquiv x hx R N φ).val := by
  refine ofConv_injective (AlgHom.ext fun a ↦ ?_)
  rw [poleBoundedEquiv_comp_apply, poleBoundedTransition, Equiv.apply_symm_apply,
    ← poleBoundedEquiv_comp_apply, AlgHom.comp_id]

/-- **The transition maps are surjective**, so each piece `LG_(≤N)` is a closed subfunctor of
`LG_(≤M)` for `N ≤ M`. -/
theorem poleBoundedTransition_surjective (h : N ≤ M) :
    Function.Surjective (poleBoundedTransition x hx h) := by
  have hcomp : ((poleBoundedTransition x hx h).comp (Ideal.Quotient.mkₐ k _)).comp
      (rename fun p : ι × ℕ ↦ (p.1, p.2 + (M - N))) = Ideal.Quotient.mkₐ k _ :=
    algHom_ext fun p ↦ by simp
  refine Function.Surjective.of_comp (g := (Ideal.Quotient.mkₐ k _).comp
    (rename fun p : ι × ℕ ↦ (p.1, p.2 + (M - N)))) ?_
  rw [← AlgHom.coe_comp, ← AlgHom.comp_assoc, hcomp]
  exact Ideal.Quotient.mkₐ_surjective k _

end HopfAlgebra

end TauCeti
