/-!
# Spreading out affine groups over the `S`-integers

Let `R` be a Dedekind domain with fraction field `K`, for instance the ring of integers of a
number field, and let `H` be a finitely generated commutative Hopf algebra over `K`, the
coordinate ring of an affine group `G` over `K`. This file proves that `G` spreads out over the
`S`-integers `𝒪_{K,S} = S.integer K` for every set `S` of finite places containing a suitable
finite set `S₀`: there is a finitely presented commutative Hopf algebra `𝓗` over `𝒪_{K,S}`
with an isomorphism of bialgebras `K ⊗[𝒪_{K,S}] 𝓗 ≃ H` over `K`. Over a number field, `𝓗` is
an integral model of `G` away from `S` (the infinite places being understood to be in `S`).

The model is explicit. Choose generators `s` of `H` over `K` and write the comultiplication,
counit and antipode of each generator in terms of `s`. Only finitely many elements of `K` occur
as coefficients, and each lies in `𝒪_{K,S}` once `S` contains the finitely many places where it
is not integral. Then the `𝒪_{K,S}`-subalgebra generated by `s` is a Hopf form of `H`
(`Subalgebra.IsHopfForm`): it is finitely generated over the noetherian ring `𝒪_{K,S}`, hence
finitely presented, and torsion-free over the Dedekind domain `𝒪_{K,S}`, hence flat, so the Hopf
operations of `H` restrict to it and base change identifies its generic fibre with `H`.

## Main declarations

* `TauCeti.HopfAlgebra.exists_finset_forall_mem_adjoin`: an element of the algebra generated by
  `s` over `K` lies in the algebra generated by `s` over any subring containing a finite set of
  coefficients.
* `IsDedekindDomain.exists_finset_forall_subset_integer`: a finite subset of `K` lies in the
  `S`-integers for every `S` containing a suitable finite set of places.
* `TauCeti.HopfAlgebra.exists_finset_isHopfForm_adjoin`: generators `s` of `H` and a finite set
  `S₀` of places such that `s` generates a Hopf form of `H` over `𝒪_{K,S}` for every `S ⊇ S₀`.
* `TauCeti.CommHopfAlgCat.exists_finset_bialgEquiv_baseChange`: **spreading out**, a finitely
  presented commutative Hopf algebra over `𝒪_{K,S}` with generic fibre `H`, for every `S ⊇ S₀`.

## References

* B. Conrad, *Weil and Grothendieck approaches to adelic points*, Enseign. Math. (2) 58 (2012),
  Theorem 3.4(1) and Remark 3.5.
-/

public section

open scoped TensorProduct

open IsDedekindDomain

universe u v w

namespace IsDedekindDomain

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type u} [Field K] [Algebra R K]
  [IsFractionRing R K]

/-- Every finite set of elements of `K` lies in the `S`-integers for all `S` containing a suitable
finite set of places. -/
theorem exists_finset_forall_subset_integer (F : Finset K) :
    ∃ S₀ : Finset (HeightOneSpectrum R), ∀ S : Set (HeightOneSpectrum R), (S₀ : Set _) ⊆ S →
      (F : Set K) ⊆ S.integer K := by
  classical
  refine ⟨F.biUnion fun f ↦ (HeightOneSpectrum.Support.finite R f).toFinset, fun S hS f hf ↦ ?_⟩
  rw [SetLike.mem_coe, Set.mem_integer_iff]
  intro v hv
  by_contra h
  exact hv (hS (Finset.mem_biUnion.mpr ⟨f, hf, by simpa [HeightOneSpectrum.Support] using h⟩))

end IsDedekindDomain

namespace TauCeti.HopfAlgebra

/-- **Finitely many coefficients.** If `x` lies in the subalgebra generated by `s` over `K`,
there is a finite set `F` of elements of `K` such that `x` lies in the subalgebra generated by `s`
over every `O` whose image in `K` contains `F`. -/
theorem exists_finset_forall_mem_adjoin {K : Type u} {H : Type v} [CommSemiring K] [Semiring H]
    [Algebra K H] {s : Set H} {x : H} (hx : x ∈ Algebra.adjoin K s) :
    ∃ F : Finset K, ∀ (O : Type w) [CommSemiring O] [Algebra O K] [Algebra O H]
      [IsScalarTower O K H],
      (F : Set K) ⊆ Set.range (algebraMap O K) → x ∈ Algebra.adjoin O s := by
  classical
  induction hx using Algebra.adjoin_induction with
  | mem x hx => exact ⟨∅, fun O _ _ _ _ _ ↦ Algebra.subset_adjoin hx⟩
  | algebraMap k =>
    refine ⟨{k}, fun O _ _ _ _ hF ↦ ?_⟩
    obtain ⟨o, ho⟩ := hF (Finset.mem_singleton_self k)
    rw [← ho, ← IsScalarTower.algebraMap_apply]
    exact Subalgebra.algebraMap_mem _ o
  | add x y _ _ hx hy =>
    obtain ⟨F, hF⟩ := hx
    obtain ⟨G, hG⟩ := hy
    refine ⟨F ∪ G, fun O _ _ _ _ h ↦ add_mem (hF O ?_) (hG O ?_)⟩ <;>
      exact subset_trans (by simp) h
  | mul x y _ _ hx hy =>
    obtain ⟨F, hF⟩ := hx
    obtain ⟨G, hG⟩ := hy
    refine ⟨F ∪ G, fun O _ _ _ _ h ↦ mul_mem (hF O ?_) (hG O ?_)⟩ <;>
      exact subset_trans (by simp) h

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type u} [Field K] [Algebra R K]
  [IsFractionRing R K]

variable {H : Type v} [Ring H] [HopfAlgebra K H]

/-- **Spreading out the Hopf structure.** For a finitely generated Hopf algebra `H`
over `K`, there are generators `s` of `H` and a finite set `S₀` of places of `K` such that, for
every set `S ⊇ S₀`, the `S`-integral subalgebra generated by `s` is a Hopf form of `H`. -/
theorem exists_finset_isHopfForm_adjoin [Algebra.FiniteType K H] :
    ∃ (s : Finset H) (S₀ : Finset (HeightOneSpectrum R)),
      Algebra.adjoin K (s : Set H) = ⊤ ∧ ∀ S : Set (HeightOneSpectrum R), (S₀ : Set _) ⊆ S →
        (Algebra.adjoin (S.integer K) (s : Set H)).IsHopfForm K := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := K) (A := H)
  -- A representation of the comultiplication of each element as a sum of pure tensors.
  choose P hP using fun x : H ↦ TensorProduct.exists_finset (R := K) (Coalgebra.comul x)
  -- The elements of `H` to be made `S`-integral, and their coefficients over `s`.
  let T : Finset H := s.image (HopfAlgebra.antipode K) ∪
    s.biUnion fun x ↦ (P x).image Prod.fst ∪ (P x).image Prod.snd
  have hmem (y : H) : y ∈ Algebra.adjoin K (s : Set H) := hs ▸ Algebra.mem_top
  choose F hF using fun y : H ↦ exists_finset_forall_mem_adjoin.{u, v, u} (hmem y)
  obtain ⟨S₀, hS₀⟩ := exists_finset_forall_subset_integer (R := R)
    (T.biUnion F ∪ s.image (Coalgebra.counit (R := K)))
  refine ⟨s, S₀, hs, fun S hS ↦ ?_⟩
  have hint := hS₀ S hS
  have hT {y : H} (hy : y ∈ T) : y ∈ Algebra.adjoin (S.integer K) (s : Set H) := by
    refine hF y (S.integer K) fun f hf ↦ ⟨⟨f, hint ?_⟩, rfl⟩
    exact Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨y, hy, hf⟩)
  refine Subalgebra.IsHopfForm.adjoin (fun x hx ↦ ?_) (fun x hx ↦ ?_) (fun x hx ↦ ?_)
  · rw [hP x]
    refine Subalgebra.sum_mem _ fun i hi ↦ ?_
    have h₁ : i.1 ∈ Algebra.adjoin (S.integer K) (s : Set H) :=
      hT (Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨x, hx,
        Finset.mem_union_left _ (Finset.mem_image_of_mem _ hi)⟩))
    have h₂ : i.2 ∈ Algebra.adjoin (S.integer K) (s : Set H) :=
      hT (Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨x, hx,
        Finset.mem_union_right _ (Finset.mem_image_of_mem _ hi)⟩))
    exact ⟨⟨i.1, h₁⟩ ⊗ₜ ⟨i.2, h₂⟩, Subalgebra.tensorSquareMap_tmul _ _ _⟩
  · rw [Algebra.mem_bot]
    exact ⟨⟨_, hint (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hx))⟩, rfl⟩
  · exact hT (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hx))

end TauCeti.HopfAlgebra

namespace TauCeti.CommHopfAlgCat

open TauCeti.HopfAlgebra

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type u} [Field K] [Algebra R K]
  [IsFractionRing R K] {H : Type v} [CommRing H] [HopfAlgebra K H]

/-- **Spreading out.** A finitely generated commutative Hopf algebra `H` over the fraction field
`K` of a Dedekind domain has a model over the `S`-integers for every set `S` of places containing a
suitable finite set `S₀`: a finitely presented commutative Hopf algebra `𝓗` over `S.integer K`
with an isomorphism of bialgebras `K ⊗[S.integer K] 𝓗 ≃ H` over `K`. Over a number field this is
an integral model of the affine group `Spec H` away from `S` (Conrad, Theorem 3.4(1)). -/
theorem exists_finset_bialgEquiv_baseChange [Algebra.FiniteType K H] :
    ∃ S₀ : Finset (HeightOneSpectrum R), ∀ S : Set (HeightOneSpectrum R), (S₀ : Set _) ⊆ S →
      ∃ 𝓗 : _root_.CommHopfAlgCat.{v} (S.integer K),
        Algebra.FinitePresentation (S.integer K) 𝓗 ∧ Nonempty (K ⊗[S.integer K] 𝓗 ≃ₐc[K] H) := by
  obtain ⟨s, S₀, hs, hform⟩ := exists_finset_isHopfForm_adjoin (R := R) (K := K) (H := H)
  refine ⟨S₀, fun S hS ↦ ?_⟩
  set A := Algebra.adjoin (S.integer K) (s : Set H)
  have hA := hform S hS
  have : Module.IsTorsionFree (S.integer K) H :=
    Module.IsTorsionFree.trans K
  have : Module.IsTorsionFree (S.integer K) A :=
    Function.Injective.moduleIsTorsionFree _ Subtype.val_injective fun _ _ ↦ rfl
  have hspan : Submodule.span K (A : Set H) = ⊤ := by
    rw [eq_top_iff, ← Algebra.top_toSubmodule, ← hs, Algebra.adjoin_eq_span]
    refine Submodule.span_mono fun x hx ↦ ?_
    have : x ∈ Submodule.span (S.integer K) (Submonoid.closure (s : Set H) : Set H) :=
      Submodule.subset_span hx
    rwa [← Algebra.adjoin_eq_span] at this
  let : HopfAlgebra (S.integer K) A := hA.hopfAlgebra
  have : Algebra.FiniteType (S.integer K) A :=
    (Subalgebra.fg_iff_finiteType A).mp (Subalgebra.fg_adjoin_finset s)
  exact ⟨.of (S.integer K) A, Algebra.FinitePresentation.of_finiteType.mp this,
    ⟨hA.baseChangeBialgEquiv hspan⟩⟩

end TauCeti.CommHopfAlgCat
