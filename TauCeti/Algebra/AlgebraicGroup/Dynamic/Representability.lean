module

public import TauCeti.Algebra.AlgebraicGroup.Dynamic.Functor
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Representability
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Naturality
public import TauCeti.Algebra.Polynomial.Laurent.Polynomial

/-!
# Representability of dynamic parabolic subgroups

For a cocharacter of an affine group scheme, universal conjugation has values in the
Laurent polynomials over its coordinate algebra. Its negative coefficients generate the
ideal cutting out those points whose conjugation extends over the origin. These points
are exactly the dynamic parabolic, over every value algebra, including nonreduced ones.

The pointwise subgroup criterion makes this ideal a Hopf ideal. Thus the dynamic parabolic
is represented by a closed affine subgroup scheme, without a smoothness, finite-type,
field, or reductivity assumption. For a finite-type ambient group its coordinate algebra
is again of finite type. This does not assert smoothness or properness of the homogeneous
space, nor that the dynamic unipotent subgroup is the unipotent radical.

## References

* B. Conrad, O. Gabber, G. Prasad, *Pseudo-reductive Groups*, §2.1.
-/

public section

open CategoryTheory WithConv

namespace TauCeti.Cocharacter

universe u v w

variable {R : Type u} {H : Type v} [CommRing R] [CommRing H] [HopfAlgebra R H]
variable {A : Type w} [CommRing A] [Algebra R A]

/-- Universal conjugation by a cocharacter, evaluated at the identity algebra homomorphism
(the universal point of the ambient group, not its identity element). -/
noncomputable def conjugationAlgHom (l : H →ₐc[R] LaurentPolynomial R) :
    H →ₐ[R] LaurentPolynomial H :=
  (conjugate H l (toConv (AlgHom.id R H))).ofConv

/-- The coefficients of conjugation at any point are evaluations of the universal coefficients. -/
theorem coeff_conjugate (l : H →ₐc[R] LaurentPolynomial R)
    (g : WithConv (H →ₐ[R] A)) (h : H) (n : ℤ) :
    ((conjugate A l g).ofConv h).coeff n = g.ofConv ((conjugationAlgHom l h).coeff n) := by
  have heq := mapValue_conjugate_mapAlgHom g.ofConv l (toConv (AlgHom.id R H))
  simp only [AlgHom.mapValue_apply, AlgHom.comp_id, toConv_ofConv] at heq
  have hc := congrArg (fun p : WithConv (H →ₐ[R] LaurentPolynomial A) ↦
    (p.ofConv h).coeff n) heq
  simpa only [AddMonoidAlgebra.coeff_mapAlgHom, AlgHom.comp_apply, conjugationAlgHom] using hc.symm

private def negativeCoefficientIdeal (l : H →ₐc[R] LaurentPolynomial R) : Ideal H :=
  Ideal.span {x | ∃ h : H, ∃ n : ℤ, n < 0 ∧ (conjugationAlgHom l h).coeff n = x}

private theorem negativeCoefficientIdeal_le_ker_iff
    (l : H →ₐc[R] LaurentPolynomial R) (g : WithConv (H →ₐ[R] A)) :
    negativeCoefficientIdeal l ≤ RingHom.ker g.ofConv ↔ g ∈ parabolic A l := by
  rw [negativeCoefficientIdeal, Ideal.span_le, mem_parabolic_iff]
  have hext : (∃ F : WithConv (H →ₐ[R] Polynomial A), ofPolyPoint A F = conjugate A l g) ↔
      ∀ h : H, ∀ n : ℤ, n < 0 → ((conjugate A l g).ofConv h).coeff n = 0 := by
    rw [← exists_algHom_toLaurent_comp_eq_iff]
    constructor
    · rintro ⟨F, hF⟩
      rw [ofPolyPoint_apply] at hF
      exact ⟨F.ofConv, congrArg ofConv hF⟩
    · rintro ⟨F, hF⟩
      refine ⟨toConv F, ?_⟩
      rw [ofPolyPoint_apply]
      exact congrArg toConv hF
  rw [hext]
  constructor
  · intro hg h n hn
    rw [coeff_conjugate]
    exact RingHom.mem_ker.mp (hg ⟨h, n, hn, rfl⟩)
  · rintro hg x ⟨h, n, hn, rfl⟩
    exact RingHom.mem_ker.mpr ((coeff_conjugate l g h n).symm.trans (hg h n hn))

/-- The defining Hopf ideal of the dynamic parabolic, generated by the negative coefficients
of universal conjugation. -/
noncomputable def parabolicDefiningHopfIdeal (l : H →ₐc[R] LaurentPolynomial R) :
    HopfIdeal R H :=
  HopfIdeal.ofIdealOfPointsSubgroup (negativeCoefficientIdeal l)
    (fun A ↦ parabolic A l) (fun _ g ↦ (negativeCoefficientIdeal_le_ker_iff l g).symm)

/-- The ideal defining the dynamic parabolic is generated by the negative Laurent coefficients. -/
@[simp]
theorem parabolicDefiningHopfIdeal_toIdeal (l : H →ₐc[R] LaurentPolynomial R) :
    (parabolicDefiningHopfIdeal l).toIdeal =
      Ideal.span {x | ∃ h : H, ∃ n : ℤ, n < 0 ∧ (conjugationAlgHom l h).coeff n = x} := by
  rw [parabolicDefiningHopfIdeal, HopfIdeal.ofIdealOfPointsSubgroup_toIdeal]
  rfl

/-- Membership in the defining Hopf ideal is membership in the span of the negative coefficients. -/
@[simp]
theorem mem_parabolicDefiningHopfIdeal (l : H →ₐc[R] LaurentPolynomial R) (x : H) :
    x ∈ parabolicDefiningHopfIdeal l ↔
      x ∈ Ideal.span {x | ∃ h : H, ∃ n : ℤ, n < 0 ∧ (conjugationAlgHom l h).coeff n = x} := by
  rw [← HopfIdeal.mem_toIdeal, parabolicDefiningHopfIdeal_toIdeal]

/-- All negative coefficients of universal conjugation vanish on the dynamic parabolic. -/
theorem coeff_conjugationAlgHom_mem_parabolicDefiningHopfIdeal
    (l : H →ₐc[R] LaurentPolynomial R) (h : H) {n : ℤ} (hn : n < 0) :
    (conjugationAlgHom l h).coeff n ∈ parabolicDefiningHopfIdeal l := by
  rw [← HopfIdeal.mem_toIdeal, parabolicDefiningHopfIdeal_toIdeal]
  exact Ideal.subset_span ⟨h, n, hn, rfl⟩

/-- The dynamic parabolic is represented by the closed subgroup defined by its coefficient ideal. -/
@[simp]
theorem quotientPointsSubgroup_parabolicDefiningHopfIdeal
    (l : H →ₐc[R] LaurentPolynomial R) :
    CommHopfAlgCat.quotientPointsSubgroup (_root_.CommHopfAlgCat.of R H)
      (parabolicDefiningHopfIdeal l) (CommAlgCat.of R A) = parabolic A l := by
  ext g
  rw [CommHopfAlgCat.mem_quotientPointsSubgroup_iff]
  have hker : (∀ x ∈ parabolicDefiningHopfIdeal l, g.ofConv x = 0) ↔
      (parabolicDefiningHopfIdeal l).toIdeal ≤ RingHom.ker g.ofConv := by
    simp only [IsConcreteLE.le_iff, HopfIdeal.mem_toIdeal, RingHom.mem_ker]
  rw [hker, parabolicDefiningHopfIdeal_toIdeal]
  exact negativeCoefficientIdeal_le_ker_iff l g

/-- The coefficient ideal is the smallest Hopf ideal containing all the negative coefficients. -/
theorem parabolicDefiningHopfIdeal_le_iff (l : H →ₐc[R] LaurentPolynomial R)
    (I : HopfIdeal R H) :
    parabolicDefiningHopfIdeal l ≤ I ↔
      ∀ h : H, ∀ n : ℤ, n < 0 → (conjugationAlgHom l h).coeff n ∈ I := by
  rw [← HopfIdeal.toIdeal_le_toIdeal, parabolicDefiningHopfIdeal_toIdeal, Ideal.span_le]
  constructor
  · intro hi h n hn
    exact hi ⟨h, n, hn, rfl⟩
  · rintro hi x ⟨h, n, hn, rfl⟩
    exact hi h n hn

/-- The quotient by the negative-coefficient ideal represents the dynamic parabolic functor. -/
noncomputable def parabolicPointsIso (l : H →ₐc[R] LaurentPolynomial R) :
    HopfAlgebra.pointsFunctor (R := R)
        (H := CommHopfAlgCat.quotient (_root_.CommHopfAlgCat.of R H)
          (parabolicDefiningHopfIdeal l)) ≅ parabolicFunctor.{u, v, w} l :=
  CommHopfAlgCat.quotientPointsSubgroupRepresentingIso (_root_.CommHopfAlgCat.of R H)
    (parabolicDefiningHopfIdeal l) (fun A ↦ parabolic A l)
    (fun _ _ ↦ by rw [quotientPointsSubgroup_parabolicDefiningHopfIdeal])

/-- The representing isomorphism sends a quotient point to its ambient point. -/
@[simp]
theorem coe_parabolicPointsIso_hom_app_apply (l : H →ₐc[R] LaurentPolynomial R)
    (A : CommAlgCat.{w} R)
    (f : HopfAlgebra.points (R := R)
      (H := CommHopfAlgCat.quotient (_root_.CommHopfAlgCat.of R H)
        (parabolicDefiningHopfIdeal l)) A) :
    ((ConcreteCategory.hom
      (X := HopfAlgebra.pointsFunctor (R := R)
        (H := CommHopfAlgCat.quotient (_root_.CommHopfAlgCat.of R H)
          (parabolicDefiningHopfIdeal l)) |>.obj A)
      (Y := GrpCat.of (parabolic A l))
      ((parabolicPointsIso l).hom.app A) f : parabolic A l) :
        WithConv (H →ₐ[R] A)) =
      CommHopfAlgCat.quotientPointsHom (_root_.CommHopfAlgCat.of R H)
        (parabolicDefiningHopfIdeal l) A f := by
  unfold parabolicPointsIso
  exact CommHopfAlgCat.coe_quotientPointsSubgroupRepresentingIso_hom_app_apply
    (_root_.CommHopfAlgCat.of R H) (parabolicDefiningHopfIdeal l) _ _ A f

/-- Factoring a parabolic point through its representing algebra recovers its ambient point. -/
@[simp]
theorem quotientPointsHom_parabolicPointsIso_inv_app_apply
    (l : H →ₐc[R] LaurentPolynomial R) (A : CommAlgCat.{w} R) (g : parabolic A l) :
    CommHopfAlgCat.quotientPointsHom (_root_.CommHopfAlgCat.of R H)
        (parabolicDefiningHopfIdeal l) A ((parabolicPointsIso l).inv.app A g) = g.1 := by
  unfold parabolicPointsIso
  exact CommHopfAlgCat.quotientPointsHom_quotientPointsSubgroupRepresentingIso_inv_app_apply
    (_root_.CommHopfAlgCat.of R H) (parabolicDefiningHopfIdeal l) (fun A ↦ parabolic A l) _ A g

end TauCeti.Cocharacter
