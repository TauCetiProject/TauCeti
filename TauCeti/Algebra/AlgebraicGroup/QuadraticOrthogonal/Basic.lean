/-!
# The orthogonal group scheme of a quadratic form

For a commutative ring `R`, `n : ℕ` and a quadratic form `q` on `Rⁿ = Fin n → R`, the orthogonal
group scheme `O(q)` is the closed subgroup scheme of `GLₙ` whose points over a commutative
`R`-algebra `A` are the invertible matrices `g` with `q_A(g x) = q_A(x)` for all `x ∈ Aⁿ`. Here
`q_A` is the quadratic form on `Aⁿ` with the same coefficients as `q`: writing
`q(x) = xᵀ M x` for the upper triangular coefficient matrix `M` of `q`
(`QuadraticForm.coefficientMatrix`, Mathlib's `QuadraticMap.toBilin` in the standard basis),
`q_A(x) = xᵀ M x` with `M` read in `A` (`QuadraticForm.baseChangeForm`). Nothing here assumes
`2` invertible.

The defining ideal is generated by the coefficients of the polynomial identity
`q(X x) - q(x) = xᵀ (Xᵀ M X - M) x` in the coordinates of `x`, for `X` the generic matrix: the
diagonal entries `N i i` and, for `i < j`, the symmetric sums `N i j + N j i` of `N = Xᵀ M X - M`.
The generating set `TauCeti.QuadraticOrthogonal.relationSet` contains the symmetric sums for all
pairs `(i, j)`; those with `i ≥ j` are redundant. A matrix `N` whose diagonal entries and
symmetric sums lie in an ideal `I` is *alternating modulo `I`*
(`Matrix.IsAltMod`); then `xᵀ N x ∈ I` for every vector `x`, and `Pᵀ N P`
is again alternating modulo `I` for every matrix `P`. The three Hopf-ideal closure conditions
follow, as for `TauCeti.ConstantForm`, from the framing identities

```text
(Y Z)ᵀ M (Y Z) - M = Zᵀ (Yᵀ M Y - M) Z + (Zᵀ M Z - M),
X⁻ᵀ M X⁻¹ - M = -(X⁻ᵀ (Xᵀ M X - M) X⁻¹).
```

When `2` is invertible, `O(q)` is the subgroup preserving the polar form, but in general it is
smaller: over `𝔽₂` with `q = x²` the polar form is zero while `O(q)` is `μ₂`. Nothing is assumed of
`q`; the construction includes `n = 0` and the zero ring.

## Main declarations

* `TauCeti.QuadraticOrthogonal.definingHopfIdeal`: the Hopf ideal of `O(q)` in `O(GLₙ)`.
* `TauCeti.QuadraticOrthogonal.groupScheme` and `TauCeti.QuadraticOrthogonal.inclusion`: the
  orthogonal group scheme and its closed immersion into `GLₙ`.
* `TauCeti.QuadraticOrthogonal.pointsSubgroup` and `TauCeti.QuadraticOrthogonal.pointsMulEquiv`:
  the points of `O(q)` are the invertible matrices preserving `q_A`; by
  `TauCeti.QuadraticOrthogonal.hopfIdealPointsSubgroup_definingHopfIdeal` these are the matrices
  cut out by the defining Hopf ideal, and by
  `TauCeti.QuadraticOrthogonal.mem_definingPointsSubgroup_iff` an ambient quotient point lies in
  `O(q)` exactly when its matrix does. Transporting a point along an algebra morphism applies it to
  the entries of the matrix (`TauCeti.QuadraticOrthogonal.coe_pointsMulEquiv_mapPoints`).
* `TauCeti.QuadraticOrthogonal.pointsMulEquivOrthogonalGroup`: the points of `O(q)` are
  `TauCeti.QuadraticMap.orthogonalGroup (QuadraticForm.baseChangeForm q A)`, a point acting on
  `Aⁿ` by its matrix (`pointsMulEquivOrthogonalGroup_apply`).

## References

* B. Conrad, *Reductive group schemes*, Appendix C, §C.1, for the orthogonal group scheme of a
  quadratic space over a ring, in every characteristic.
-/

public section

open CategoryTheory Matrix WithConv
open QuadraticForm (coefficientMatrix baseChangeForm baseChangeForm_apply)

namespace TauCeti.QuadraticOrthogonal

universe u w

variable (R : Type u) [CommRing R] (n : ℕ)

/-! ### The defining relations -/

variable (q : QuadraticForm R (Fin n → R))

/-- **The matrix of defining relations** of `O(q)`: `Xᵀ M X - M` over the coordinate Hopf
algebra of `GLₙ`, for `M` the coefficient matrix of `q`. -/
noncomputable def relationMatrix :
    Matrix (Fin n) (Fin n) (GeneralLinear.coordinateHopfAlgebra R n) :=
  (GeneralLinear.genericMatrix R n)ᵀ *
      (coefficientMatrix q (Pi.basisFun R (Fin n))).map
        (algebraMap R (GeneralLinear.coordinateHopfAlgebra R n)) *
      GeneralLinear.genericMatrix R n -
    (coefficientMatrix q (Pi.basisFun R (Fin n))).map
      (algebraMap R (GeneralLinear.coordinateHopfAlgebra R n))

/-- The relation matrix is `Xᵀ M X - M`. -/
theorem relationMatrix_def :
    relationMatrix R n q =
      (GeneralLinear.genericMatrix R n)ᵀ *
          (coefficientMatrix q (Pi.basisFun R (Fin n))).map
            (algebraMap R (GeneralLinear.coordinateHopfAlgebra R n)) *
          GeneralLinear.genericMatrix R n -
        (coefficientMatrix q (Pi.basisFun R (Fin n))).map
          (algebraMap R (GeneralLinear.coordinateHopfAlgebra R n)) := by
  rw [relationMatrix]

/-- **The defining relations** of `O(q)`: the coefficients of `q(X x) - q(x)`, namely the
diagonal entries `N i i` and the symmetric sums `N i j + N j i` for `i < j` of the relation
matrix `N`. The set also contains the symmetric sums for `i ≥ j`, which are redundant: for `i = j`
the sum is `2 N i i`, and for `i > j` it repeats the pair `(j, i)`. -/
noncomputable def relationSet : Set (GeneralLinear.coordinateHopfAlgebra R n) :=
  (relationMatrix R n q).altRelationSet

/-- The defining relations are the alternating relations of the relation matrix: its diagonal
entries and its symmetric sums. -/
theorem relationSet_def : relationSet R n q = (relationMatrix R n q).altRelationSet := by
  rw [relationSet]

/-- Mapping the relation matrix through an algebra morphism gives the relation of the image of
the generic matrix. -/
theorem relationMatrix_map {T : Type*} [Ring T] [Algebra R T]
    (phi : GeneralLinear.coordinateHopfAlgebra R n →ₐ[R] T) :
    (relationMatrix R n q).map phi =
      ((GeneralLinear.genericMatrix R n).map phi)ᵀ *
          (coefficientMatrix q (Pi.basisFun R (Fin n))).map (algebraMap R T) *
          (GeneralLinear.genericMatrix R n).map phi -
        (coefficientMatrix q (Pi.basisFun R (Fin n))).map (algebraMap R T) := by
  rw [relationMatrix, Matrix.map_transpose_mul_mul_sub]

/-! ### The three Hopf-ideal closure conditions -/

/-- The counit vanishes on every defining relation. -/
private theorem counit_relationMatrix :
    (relationMatrix R n q).map (Bialgebra.counitAlgHom R (GeneralLinear.coordinateHopfAlgebra R n))
      = 0 := by
  rw [relationMatrix_map, GeneralLinear.map_counit_genericMatrix, Matrix.transpose_one,
    Matrix.one_mul, Matrix.mul_one, sub_self]

/-- The comultiplication of the relation matrix is the left tensor copy of the relations, framed
by the right tensor copy of the generic matrix, plus the right tensor copy of the relations:
`(Y Z)ᵀ M (Y Z) - M = Zᵀ (Yᵀ M Y - M) Z + (Zᵀ M Z - M)`. -/
private theorem relationMatrix_map_comul :
    (relationMatrix R n q).map
        (Bialgebra.comulAlgHom R (GeneralLinear.coordinateHopfAlgebra R n)) =
      ((GeneralLinear.genericMatrix R n).map
          (Algebra.TensorProduct.includeRight (R := R)))ᵀ *
          (relationMatrix R n q).map (Algebra.TensorProduct.includeLeft (R := R) (S := R)) *
          (GeneralLinear.genericMatrix R n).map (Algebra.TensorProduct.includeRight (R := R)) +
        (relationMatrix R n q).map (Algebra.TensorProduct.includeRight (R := R)) := by
  rw [relationMatrix_map, relationMatrix_map, relationMatrix_map,
    GeneralLinear.map_comul_genericMatrix, Matrix.transpose_mul, Matrix.mul_sub, Matrix.sub_mul]
  simp only [Matrix.mul_assoc]
  abel

/-- The image of the span of the relations under the comultiplication lies in the sum of the
left and right tensor ideals. -/
private theorem comul_relation_mem {x : GeneralLinear.coordinateHopfAlgebra R n}
    (hx : x ∈ relationSet R n q) :
    Coalgebra.comul (R := R) x ∈
      Ideal.leftTensorIdeal (R := R) (B := GeneralLinear.coordinateHopfAlgebra R n)
          (Ideal.span (relationSet R n q)) ⊔
        Ideal.rightTensorIdeal (R := R) (A := GeneralLinear.coordinateHopfAlgebra R n)
          (Ideal.span (relationSet R n q)) := by
  set J := Ideal.leftTensorIdeal (R := R) (B := GeneralLinear.coordinateHopfAlgebra R n)
      (Ideal.span (relationSet R n q)) ⊔
    Ideal.rightTensorIdeal (R := R) (A := GeneralLinear.coordinateHopfAlgebra R n)
      (Ideal.span (relationSet R n q))
  -- The two tensor ideals are the images of the span along the two tensor inclusions.
  have hL := (isAltMod_span_altRelationSet (relationMatrix R n q)).map (J := J)
    (Algebra.TensorProduct.includeLeft (R := R) (S := R)
      (B := GeneralLinear.coordinateHopfAlgebra R n))
    ((Ideal.leftTensorIdeal_def R (GeneralLinear.coordinateHopfAlgebra R n) _).ge.trans
      le_sup_left)
  have hR := (isAltMod_span_altRelationSet (relationMatrix R n q)).map (J := J)
    (Algebra.TensorProduct.includeRight (R := R) (A := GeneralLinear.coordinateHopfAlgebra R n))
    ((Ideal.rightTensorIdeal_def R (GeneralLinear.coordinateHopfAlgebra R n) _).ge.trans
      le_sup_right)
  have hcomul := (hL.transpose_mul_mul ((GeneralLinear.genericMatrix R n).map
    (Algebra.TensorProduct.includeRight (R := R)))).add hR
  rw [← relationMatrix_map_comul] at hcomul
  simpa only [Bialgebra.comulAlgHom_apply] using hcomul.apply_mem_of_map hx

/-- The antipode image of the relation matrix is the negative of the relation matrix framed by
the inverse matrix: `X⁻ᵀ M X⁻¹ - M = -(X⁻ᵀ (Xᵀ M X - M) X⁻¹)`. -/
private theorem relationMatrix_map_antipode :
    (relationMatrix R n q).map
        (HopfAlgebra.antipodeAlgHom (R := R) (A := GeneralLinear.coordinateHopfAlgebra R n)) =
      -(((GeneralLinear.genericMatrix R n)⁻¹)ᵀ * relationMatrix R n q *
        (GeneralLinear.genericMatrix R n)⁻¹) := by
  have h := GeneralLinear.isUnit_det_genericMatrix R n
  rw [relationMatrix_map, GeneralLinear.map_antipode_genericMatrix, relationMatrix,
    Matrix.mul_sub, Matrix.sub_mul, neg_sub]
  congr 1
  have hinv : ((GeneralLinear.genericMatrix R n)⁻¹)ᵀ * (GeneralLinear.genericMatrix R n)ᵀ = 1 := by
    rw [← Matrix.transpose_mul, Matrix.mul_nonsing_inv _ h, Matrix.transpose_one]
  simp only [← Matrix.mul_assoc, hinv, Matrix.one_mul, Matrix.mul_nonsing_inv_cancel_right _ _ h]

/-- The antipode carries every defining relation into the span of the relations. -/
private theorem antipode_relation_mem {x : GeneralLinear.coordinateHopfAlgebra R n}
    (hx : x ∈ relationSet R n q) :
    HopfAlgebra.antipode R x ∈ Ideal.span (relationSet R n q) := by
  have hS := ((isAltMod_span_altRelationSet (relationMatrix R n q)).transpose_mul_mul
    (GeneralLinear.genericMatrix R n)⁻¹).neg
  rw [← relationMatrix_map_antipode] at hS
  rw [relationSet_def] at hx ⊢
  simpa only [HopfAlgebra.antipodeAlgHom_apply] using hS.apply_mem_of_map hx

/-! ### The defining Hopf ideal and the group scheme -/

/-- **The Hopf ideal of `O(q)`**: the ideal of the coordinate Hopf algebra of `GLₙ` generated by
the coefficients of `q(X x) - q(x)`. -/
noncomputable def definingHopfIdeal : HopfIdeal R (GeneralLinear.coordinateHopfAlgebra R n) :=
  HopfIdeal.ofSpan (relationSet R n q)
    (fun _ hx => comul_relation_mem R n q hx)
    (fun _ hx => by
      have h0 : IsAltMod ⊥ ((relationMatrix R n q).map
          (Bialgebra.counitAlgHom R (GeneralLinear.coordinateHopfAlgebra R n))) := by
        rw [counit_relationMatrix]
        exact IsAltMod.zero
      simpa only [Bialgebra.counitAlgHom_apply, Ideal.mem_bot] using
        h0.apply_mem_of_map hx)
    (fun _ hx => antipode_relation_mem R n q hx)

/-- The underlying ideal of the defining Hopf ideal is the span of the defining relations. -/
@[simp]
theorem definingHopfIdeal_toIdeal :
    (definingHopfIdeal R n q).toIdeal = Ideal.span (relationSet R n q) := by
  rw [definingHopfIdeal, HopfIdeal.ofSpan_toIdeal]

/-- **A coordinate morphism kills the defining ideal exactly when the image `X'` of the generic
matrix preserves the coefficients of `q`**: `xᵀ (X'ᵀ M X' - M) x = 0` for every vector `x`. -/
theorem definingHopfIdeal_toIdeal_le_ker_iff {T : Type*} [CommRing T] [Algebra R T]
    (phi : GeneralLinear.coordinateHopfAlgebra R n →ₐ[R] T) :
    (definingHopfIdeal R n q).toIdeal ≤ RingHom.ker (phi : _ →+* T) ↔
      IsAltMod ⊥ ((relationMatrix R n q).map phi) := by
  rw [definingHopfIdeal_toIdeal, relationSet, span_altRelationSet_le_iff]
  simp only [isAltMod_iff, Matrix.map_apply, RingHom.mem_ker, Ideal.mem_bot, AlgHom.coe_toRingHom,
    map_add]

/-- The coordinate Hopf algebra of `O(q)`. -/
noncomputable abbrev coordinateHopfAlgebra : _root_.CommHopfAlgCat.{u} R :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra R n) (definingHopfIdeal R n q)

/-- **The orthogonal group scheme `O(q)`** of a quadratic form on `Rⁿ`. -/
noncomputable abbrev groupScheme :=
  CommHopfAlgCat.quotientSpec (GeneralLinear.coordinateHopfAlgebra R n) (definingHopfIdeal R n q)

/-- The closed-subgroup inclusion of `O(q)` into the general linear group scheme. -/
noncomputable def inclusion : groupScheme R n q ⟶ GeneralLinear.groupScheme R n :=
  GeneralLinear.hopfIdealInclusion R n (definingHopfIdeal R n q)

/-- The inclusion is the generic Hopf-ideal closed immersion at the defining Hopf ideal. -/
theorem inclusion_def :
    inclusion R n q = GeneralLinear.hopfIdealInclusion R n (definingHopfIdeal R n q) := by
  unfold inclusion
  rfl

/-- The inclusion of `O(q)` into `GLₙ` is a closed immersion. -/
instance isClosedImmersion_inclusion :
    AlgebraicGeometry.IsClosedImmersion (inclusion R n q).hom.hom.left := by
  rw [inclusion_def]
  infer_instance

/-! ### Algebra-valued points -/

section Points

variable (A : Type w) [CommRing A] [Algebra R A]

/-- **The group `O(q)(A)`**: invertible matrices `g` with `q_A(g x) = q_A(x)` for every
`x ∈ Aⁿ`, the preimage of `TauCeti.QuadraticMap.orthogonalGroup (baseChangeForm q A)` under the
identification `TauCeti.matrixLinearEquiv` of invertible matrices with linear automorphisms of
`Aⁿ`. -/
noncomputable def pointsSubgroup : Subgroup (GL (Fin n) A) :=
  (QuadraticMap.orthogonalGroup (baseChangeForm q A)).comap
    (matrixLinearEquiv (R := A) (n := Fin n) : GL (Fin n) A →* ((Fin n → A) ≃ₗ[A] (Fin n → A)))

variable {R n q A}

/-- Membership in `O(q)(A)`. -/
@[simp]
theorem mem_pointsSubgroup_iff (g : GL (Fin n) A) :
    g ∈ pointsSubgroup R n q A ↔
      ∀ x, baseChangeForm q A ((g : Matrix (Fin n) (Fin n) A) *ᵥ x) = baseChangeForm q A x := by
  rw [pointsSubgroup, Subgroup.mem_comap, QuadraticMap.mem_orthogonalGroup_iff]
  simp only [MonoidHom.coe_ofClass, MulEquiv.trans_apply, matrixGeneralLinearEquiv_apply]

/-- A matrix preserves `q_A` exactly when `gᵀ M g - M` is alternating. -/
theorem mem_pointsSubgroup_iff_isAltMod (g : GL (Fin n) A) :
    g ∈ pointsSubgroup R n q A ↔
      IsAltMod ⊥ ((g : Matrix (Fin n) (Fin n) A)ᵀ *
          (coefficientMatrix q (Pi.basisFun R (Fin n))).map (algebraMap R A) *
          (g : Matrix (Fin n) (Fin n) A) -
        (coefficientMatrix q (Pi.basisFun R (Fin n))).map (algebraMap R A)) := by
  simp only [mem_pointsSubgroup_iff, isAltMod_bot_iff, baseChangeForm_apply,
    Matrix.sub_mulVec, dotProduct_sub, Matrix.dotProduct_transpose_mul_mul_mulVec, sub_eq_zero]

variable (R n q A)

/-- **The ambient membership criterion**: the subgroup of `GLₙ(A)` cut out by the Hopf ideal of
`O(q)` is `O(q)(A)`. -/
theorem hopfIdealPointsSubgroup_definingHopfIdeal :
    GeneralLinear.hopfIdealPointsSubgroup n (definingHopfIdeal R n q) A =
      pointsSubgroup R n q A := by
  ext g
  obtain ⟨p, rfl⟩ := (GeneralLinear.pointsMulEquiv (R := R) (A := A) n).surjective g
  rw [GeneralLinear.pointsMulEquiv_apply, ← toConv_ofConv p,
    GeneralLinear.pointToGeneralLinear_mem_hopfIdealPointsSubgroup_iff_toIdeal_le_ker,
    AlgHom.toRingHom_eq_coe, definingHopfIdeal_toIdeal_le_ker_iff, mem_pointsSubgroup_iff_isAltMod]
  -- The matrix of the point `p` is the image of the generic matrix under `p`.
  rw [relationMatrix_map, GeneralLinear.map_genericMatrix_eq_coe_pointToGeneralLinear]

/-- **Membership in the points cut out by the defining Hopf ideal**: an ambient point of `GLₙ`
lies in the subgroup cut out by the Hopf ideal of `O(q)` exactly when its matrix lies in
`O(q)(A)`. -/
@[simp↓]
theorem mem_definingPointsSubgroup_iff
    (g : HopfAlgebra.points (R := R) (H := GeneralLinear.coordinateHopfAlgebra R n)
      (CommAlgCat.of R A)) :
    g ∈ CommHopfAlgCat.quotientPointsSubgroup (GeneralLinear.coordinateHopfAlgebra R n)
        (definingHopfIdeal R n q) (CommAlgCat.of R A) ↔
      GeneralLinear.pointsMulEquiv n g ∈ pointsSubgroup R n q A := by
  rw [← hopfIdealPointsSubgroup_definingHopfIdeal, GeneralLinear.mem_hopfIdealPointsSubgroup_iff,
    MulEquiv.symm_apply_apply, CommHopfAlgCat.mem_quotientPointsSubgroup_iff]

/-- **The points identification**: the group of algebra-valued points of the coordinate Hopf
algebra of `O(q)` is `O(q)(A)`. -/
noncomputable def pointsMulEquiv :
    HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n q) (CommAlgCat.of R A) ≃*
      pointsSubgroup R n q A :=
  (GeneralLinear.hopfIdealPointsSubgroupMulEquiv n (definingHopfIdeal R n q)
      (CommAlgCat.of R A)).trans
    (MulEquiv.subgroupCongr (hopfIdealPointsSubgroup_definingHopfIdeal R n q A))

/-- Under the points identifications, the quotient-point inclusion is the inclusion of `O(q)(A)`
into `GLₙ(A)`. -/
theorem pointsMulEquiv_coe
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n q) (CommAlgCat.of R A)) :
    GeneralLinear.pointsMulEquiv n
        (CommHopfAlgCat.quotientPointsHom (GeneralLinear.coordinateHopfAlgebra R n)
          (definingHopfIdeal R n q) (CommAlgCat.of R A) f) =
      (pointsMulEquiv R n q A f : GL (Fin n) A) := by
  simpa only [pointsMulEquiv, MulEquiv.trans_apply, MulEquiv.subgroupCongr_apply] using
    (GeneralLinear.coe_hopfIdealPointsSubgroupMulEquiv_apply n (definingHopfIdeal R n q)
      (CommAlgCat.of R A) f).symm

/-- **Naturality of the points identification**: transporting a point of `O(q)` along an algebra
morphism `f : A → B` applies `f` to the entries of its matrix. -/
theorem coe_pointsMulEquiv_mapPoints {B : Type w} [CommRing B] [Algebra R B]
    (f : CommAlgCat.of R A ⟶ CommAlgCat.of R B)
    (p : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n q) (CommAlgCat.of R A)) :
    (pointsMulEquiv R n q B (HopfAlgebra.mapPoints (H := coordinateHopfAlgebra R n q) f p) :
        GL (Fin n) B) =
      Matrix.GeneralLinearGroup.map (f.hom : A →+* B)
        (pointsMulEquiv R n q A p : GL (Fin n) A) := by
  simp only [pointsMulEquiv, MulEquiv.trans_apply, MulEquiv.subgroupCongr_apply]
  rw [GeneralLinear.hopfIdealPointsSubgroupMulEquiv_mapPoints,
    GeneralLinear.coe_mapHopfIdealPointsSubgroup]

/-! ### Comparison with the orthogonal group of `q_A` -/

/-- The image of `O(q)(A)` under the identification of invertible matrices with linear
automorphisms of `Aⁿ` is the orthogonal group of `q_A`. -/
private theorem map_pointsSubgroup :
    (pointsSubgroup R n q A).map (matrixLinearEquiv (R := A) (n := Fin n) :
        GL (Fin n) A →* ((Fin n → A) ≃ₗ[A] (Fin n → A))) =
      QuadraticMap.orthogonalGroup (baseChangeForm q A) :=
  Subgroup.map_comap_eq_self_of_surjective (matrixLinearEquiv (R := A) (n := Fin n)).surjective _

/-- **The points of `O(q)` are the orthogonal group of `q_A`**: the group of algebra-valued
points of the coordinate Hopf algebra of `O(q)` is
`TauCeti.QuadraticMap.orthogonalGroup (baseChangeForm q A)`, through the
identification of invertible matrices with linear automorphisms of `Aⁿ`. -/
noncomputable def pointsMulEquivOrthogonalGroup :
    HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n q) (CommAlgCat.of R A) ≃*
      QuadraticMap.orthogonalGroup (baseChangeForm q A) :=
  (pointsMulEquiv R n q A).trans
    (((matrixLinearEquiv (R := A) (n := Fin n)).subgroupMap _).trans
      (MulEquiv.subgroupCongr (map_pointsSubgroup R n q A)))

variable {R n q A}

/-- A point of `O(q)` acts on `Aⁿ` by multiplication by its matrix. -/
@[simp]
theorem pointsMulEquivOrthogonalGroup_apply
    (f : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n q) (CommAlgCat.of R A))
    (x : Fin n → A) :
    (pointsMulEquivOrthogonalGroup R n q A f : (Fin n → A) ≃ₗ[A] (Fin n → A)) x =
      ((pointsMulEquiv R n q A f : GL (Fin n) A) : Matrix (Fin n) (Fin n) A) *ᵥ x := by
  rw [pointsMulEquivOrthogonalGroup, MulEquiv.trans_apply, MulEquiv.trans_apply,
    MulEquiv.subgroupCongr_apply, MulEquiv.coe_subgroupMap_apply, MulEquiv.trans_apply,
    matrixGeneralLinearEquiv_apply]

end Points

end TauCeti.QuadraticOrthogonal
