module

public import TauCeti.Algebra.AlgebraicGroup.Fppf.Quotient.Homogeneous.Basic
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Coinvariants.Flat
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Coinvariants.LinearlyReductive
public import TauCeti.Algebra.AlgebraicGroup.Reductive.CompleteReducibility
import TauCeti.RingTheory.TensorProduct.Reduced

/-!
# Affine homogeneous quotients by linearly reductive subgroups

Let `G = Spec H` be an affine group and `N` the closed subgroup cut out by a Hopf ideal `I`.
The functions on `G` invariant under right translation by `N` form the subalgebra
`B = H^{co H/I}`, and restricting points of `G` to `B` is a morphism `G ⟶ Spec B` that is
constant on left cosets. It therefore descends to a morphism from the fppf homogeneous quotient
`G/N` to the fppf sheaf of points of `Spec B`.

This file proves that the descended morphism is an isomorphism when `I` is generated by the
coinvariants vanishing at the identity and `H` is faithfully flat and of finite presentation over
`B`. The first condition makes the fibres of `G ⟶ Spec B` exactly the left cosets of `N`; the
second lets every point of `Spec B` lift to `G` after an fppf extension of its value algebra.

Both conditions hold when `G` is a geometrically reduced affine group of finite type over a field
and `N` is linearly reductive. Then `G/N` is represented by the affine scheme `Spec B`, where
`B` is a finitely generated algebra by the Hilbert--Nagata theorem. The subgroup `N` need not be
normal, smooth, or connected, and the field is arbitrary. In characteristic zero reductive groups
are linearly reductive, so the quotient of any affine group of finite type by a reductive closed
subgroup is affine: this is the affine direction of Matsushima's criterion.

## Main declarations

* `TauCeti.HopfIdeal.toCoinvariantsPoints`: the restriction of points of `G` to the coinvariants.
* `TauCeti.HopfIdeal.fppfHomogeneousQuotientToCoinvariantsPoints`: the descended map
  `G/N ⟶ Spec B` of fppf sheaves.
* `TauCeti.HopfIdeal.isIso_fppfHomogeneousQuotientToCoinvariantsPoints`: it is an isomorphism
  when `I` is generated by `B⁺` and `H` is faithfully flat and finitely presented over `B`.
* `TauCeti.HopfIdeal.fppfHomogeneousQuotientIsoCoinvariantsPoints`: **the homogeneous quotient
  by a linearly reductive subgroup is represented by the spectrum of the invariants.**
* `TauCeti.HopfIdeal.coinvariantsPointsHomEquiv`: when it represents `G/N`, the space
  `Spec B` has the universal property of the quotient.
* `TauCeti.HopfIdeal.isIso_fppfHomogeneousQuotientToCoinvariantsPoints_of_reductive`: in
  characteristic zero, the same holds for every reductive closed subgroup.
* `TauCeti.HopfIdeal.isIso_fppfHomogeneousQuotientToCoinvariantsPoints_ker_of_reductive`: the
  same for a reductive group presented by a closed immersion.

## References

* J. S. Milne, *Algebraic Groups* (2017), §5.c (quotients as fppf sheaves) and Chapter 12
  (linearly reductive groups).
* M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*, Manuscripta Math.
  **7** (1972), 251--270.
* Y. Matsushima, *Espaces homogènes de Stein des groupes de Lie complexes*, Nagoya Math. J.
  **16** (1960), 205--218.
* W. C. Waterhouse, *Introduction to Affine Group Schemes*, §§14--16.

The descent argument is `CommHopfAlgCat.isIso_fppfHomogeneousQuotientHomEquiv_symm`, shared with
the representation of homogeneous quotients by projective orbits in
`TauCeti.Algebra.AlgebraicGroup.Representation.ProjectiveOrbit.Quotient`.
-/

public section

open CategoryTheory Opposite WithConv

namespace TauCeti.HopfIdeal

universe u

section Ring

variable {R : Type u} [CommRing R] {H : _root_.CommHopfAlgCat.{u} R} (I : HopfIdeal R H)

/-- Restriction of points of `G = Spec H` to the coinvariants `H^{co H/I}`: the morphism from the
points of `G` to the fppf sheaf of points of `Spec H^{co H/I}` induced by the inclusion of the
coinvariants. -/
noncomputable def toCoinvariantsPoints :
    HopfAlgebra.pointsPresheaf H ⋙ uliftFunctor.{u + 1, u} ⟶
      ((CommAlgCat.fppfTopology R).uliftYoneda.{u + 1}.obj
        (op (CommAlgCat.of R I.coinvariants))).obj where
  app _ := ↾fun g ↦ ULift.up (CommAlgCat.ofHom (g.down.ofConv.comp I.coinvariants.val)).op
  naturality _ _ χ := by
    ext ⟨g⟩
    exact congrArg ULift.up (Quiver.Hom.unop_inj (CommAlgCat.hom_ext (AlgHom.ext fun x ↦
      HopfAlgebra.pointsFunctor_map_apply_apply (H := H) χ.unop.unop g x)))

/-- The restriction of a point `g` to the coinvariants is `g ∘ val`. -/
@[simp]
theorem toCoinvariantsPoints_app_apply (A : ((CommAlgCat.{u} R)ᵒᵖ)ᵒᵖ)
    (g : HopfAlgebra.points (R := R) (H := H) A.unop.unop) :
    dsimp% I.toCoinvariantsPoints.app A (ULift.up g) =
      ULift.up (CommAlgCat.ofHom (g.ofConv.comp I.coinvariants.val)).op :=
  (rfl)

/-- Restriction to the coinvariants is invariant under right multiplication by the subgroup. -/
theorem toCoinvariantsPoints_app_mul (A : ((CommAlgCat.{u} R)ᵒᵖ)ᵒᵖ)
    (g : HopfAlgebra.points (R := R) (H := H) A.unop.unop)
    (n : CommHopfAlgCat.quotientPointsSubgroup H I A.unop.unop) :
    I.toCoinvariantsPoints.app A (ULift.up (g * n.val)) =
      I.toCoinvariantsPoints.app A (ULift.up g) := by
  rw [toCoinvariantsPoints_app_apply, toCoinvariantsPoints_app_apply]
  refine congrArg (fun f ↦ ULift.up (CommAlgCat.ofHom f).op) (AlgHom.ext fun x ↦ ?_)
  exact ofConv_mul_apply_of_mem_coinvariants x.2 g n.2

/-- The morphism `G/N ⟶ Spec H^{co H/I}` of fppf sheaves induced by restricting points of `G` to
the coinvariants. -/
noncomputable def fppfHomogeneousQuotientToCoinvariantsPoints :
    CommHopfAlgCat.fppfHomogeneousQuotient H I ⟶
      (CommAlgCat.fppfTopology R).uliftYoneda.{u + 1}.obj (op (CommAlgCat.of R I.coinvariants)) :=
  (CommHopfAlgCat.fppfHomogeneousQuotientHomEquiv H I _).symm
    ⟨I.toCoinvariantsPoints, I.toCoinvariantsPoints_app_mul⟩

/-- The descended map restricts to `toCoinvariantsPoints` along the projection `G ⟶ G/N`. -/
@[reassoc (attr := simp)]
theorem fppfHomogeneousQuotientProjection_comp_toCoinvariantsPoints :
    CommHopfAlgCat.fppfHomogeneousQuotientProjection H I ≫
        I.fppfHomogeneousQuotientToCoinvariantsPoints.hom =
      I.toCoinvariantsPoints :=
  CommHopfAlgCat.fppfHomogeneousQuotientHomEquiv_symm_apply H I _ _ _

/-- If `H` is faithfully flat and of finite presentation over the coinvariants, every point of
`Spec H^{co H/I}` lifts to `G` fppf locally. -/
theorem isLocallySurjective_toCoinvariantsPoints
    (hflat : I.coinvariants.val.toRingHom.FaithfullyFlat)
    (hfp : I.coinvariants.val.toRingHom.FinitePresentation) :
    Presheaf.IsLocallySurjective (CommAlgCat.fppfTopology R) I.toCoinvariantsPoints where
  imageSieve_mem {U} s := by
    obtain ⟨b⟩ := s
    obtain ⟨A, φ, z, hφflat, hφfp, hz⟩ :=
      I.coinvariants.val.exists_faithfullyFlat_lift hflat hfp b.unop.hom
    refine GrothendieckTopology.superset_covering _ ?_
      (CommAlgCat.generate_singleton_op_mem_fppfTopology φ hφflat hφfp)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨⟩
    refine ⟨ULift.up (toConv z), ?_⟩
    rw [toCoinvariantsPoints_app_apply]
    -- The restriction of `b` along `φ.op` is `(b.unop ≫ φ).op`, the coinvariant part of `z`.
    exact congrArg ULift.up (Quiver.Hom.unop_inj (CommAlgCat.hom_ext hz))

/-- **Homogeneous quotients represented by coinvariants.** Suppose that `I` is generated by the
coinvariants vanishing at the identity, and that `H` is faithfully flat and of finite
presentation over its coinvariants `B = H^{co H/I}`. Then restriction to `B` identifies the fppf
homogeneous quotient `G/N` with the fppf sheaf of points of `Spec B`. -/
theorem isIso_fppfHomogeneousQuotientToCoinvariantsPoints [Module.Flat R H]
    (hI : I.toIdeal = Ideal.span {h | h ∈ I.coinvariants ∧ Coalgebra.counit (R := R) h = 0})
    (hflat : I.coinvariants.val.toRingHom.FaithfullyFlat)
    (hfp : I.coinvariants.val.toRingHom.FinitePresentation) :
    IsIso I.fppfHomogeneousQuotientToCoinvariantsPoints := by
  have := I.isLocallySurjective_toCoinvariantsPoints hflat hfp
  -- The fibres of restriction to the coinvariants are exactly the cosets.
  exact CommHopfAlgCat.isIso_fppfHomogeneousQuotientHomEquiv_symm H I _ _ _ fun A g g' h ↦
    (inv_mul_mem_quotientPointsSubgroup_iff_comp_val_eq hI _ _).mpr
      (congrArg (fun t ↦ t.down.unop.hom) h)

/-- **Universal property of `Spec H^{co H/I}`.** When restriction to the coinvariants identifies
the homogeneous quotient `G/N` with `Spec B`, `B = H^{co H/I}`, morphisms from `Spec B` to an fppf
sheaf `F` are exactly the natural maps from `G` to `F` invariant under right multiplication by
`N`. The correspondence is composition with the quotient map `G ⟶ Spec B`. -/
noncomputable def coinvariantsPointsHomEquiv [IsIso I.fppfHomogeneousQuotientToCoinvariantsPoints]
    (F : Sheaf (CommAlgCat.fppfTopology R) (Type (u + 1))) :
    ((CommAlgCat.fppfTopology R).uliftYoneda.{u + 1}.obj (op (CommAlgCat.of R I.coinvariants)) ⟶
        F) ≃
      {f : HopfAlgebra.pointsPresheaf H ⋙ uliftFunctor.{u + 1, u} ⟶ F.obj //
        ∀ (A : ((CommAlgCat.{u} R)ᵒᵖ)ᵒᵖ)
          (g : HopfAlgebra.points (R := R) (H := H) A.unop.unop)
          (n : CommHopfAlgCat.quotientPointsSubgroup H I A.unop.unop),
          f.app A (ULift.up (g * n.val)) = f.app A (ULift.up g)} :=
  (asIso I.fppfHomogeneousQuotientToCoinvariantsPoints).homFromEquiv.symm.trans
    (CommHopfAlgCat.fppfHomogeneousQuotientHomEquiv H I F)

/-- The universal property sends a morphism out of `Spec H^{co H/I}` to its composite with the
quotient map. -/
@[simp]
theorem coinvariantsPointsHomEquiv_apply [IsIso I.fppfHomogeneousQuotientToCoinvariantsPoints]
    (F : Sheaf (CommAlgCat.fppfTopology R) (Type (u + 1)))
    (φ : (CommAlgCat.fppfTopology R).uliftYoneda.{u + 1}.obj
      (op (CommAlgCat.of R I.coinvariants)) ⟶ F) :
    (I.coinvariantsPointsHomEquiv F φ).val = I.toCoinvariantsPoints ≫ φ.hom := by
  simp [coinvariantsPointsHomEquiv]

/-- Descending a subgroup-invariant natural map through `Spec H^{co H/I}` and restricting along
the quotient map recovers that map. -/
@[simp]
theorem coinvariantsPointsHomEquiv_symm_apply
    [IsIso I.fppfHomogeneousQuotientToCoinvariantsPoints]
    (F : Sheaf (CommAlgCat.fppfTopology R) (Type (u + 1)))
    (f : HopfAlgebra.pointsPresheaf H ⋙ uliftFunctor.{u + 1, u} ⟶ F.obj)
    (hf : ∀ (A : ((CommAlgCat.{u} R)ᵒᵖ)ᵒᵖ)
      (g : HopfAlgebra.points (R := R) (H := H) A.unop.unop)
      (n : CommHopfAlgCat.quotientPointsSubgroup H I A.unop.unop),
      f.app A (ULift.up (g * n.val)) = f.app A (ULift.up g)) :
    I.toCoinvariantsPoints ≫ ((I.coinvariantsPointsHomEquiv F).symm ⟨f, hf⟩).hom = f :=
  (I.coinvariantsPointsHomEquiv_apply F _).symm.trans
    (congrArg Subtype.val ((I.coinvariantsPointsHomEquiv F).apply_symm_apply ⟨f, hf⟩))

/-- Morphisms out of `Spec H^{co H/I}` are determined by their composites with the quotient
map, when that space represents the homogeneous quotient. -/
theorem coinvariantsPoints_hom_ext [IsIso I.fppfHomogeneousQuotientToCoinvariantsPoints]
    {F : Sheaf (CommAlgCat.fppfTopology R) (Type (u + 1))}
    {φ ψ : (CommAlgCat.fppfTopology R).uliftYoneda.{u + 1}.obj
      (op (CommAlgCat.of R I.coinvariants)) ⟶ F}
    (h : I.toCoinvariantsPoints ≫ φ.hom = I.toCoinvariantsPoints ≫ ψ.hom) : φ = ψ :=
  (I.coinvariantsPointsHomEquiv F).injective (Subtype.ext (by simpa using h))

end Ring

section Field

variable {k : Type u} [Field k] {H : _root_.CommHopfAlgCat.{u} k}
  [Algebra.FiniteType k H] [Algebra.IsGeometricallyReduced k H] (I : HopfIdeal k H)

/-- For a linearly reductive closed subgroup of a geometrically reduced affine group of finite type
over a field, restriction to the invariant functions identifies the fppf homogeneous quotient with
the sheaf of points of the spectrum of the invariants. -/
theorem isIso_fppfHomogeneousQuotientToCoinvariantsPoints_of_isLinearlyReductive
    (hlr : Coalgebra.IsLinearlyReductive.{u, u, u} k (H ⧸ I.toIdeal)) :
    IsIso I.fppfHomogeneousQuotientToCoinvariantsPoints := by
  let B := I.coinvariants
  have : Algebra.FiniteType k B := I.finiteType_coinvariants_of_isLinearlyReductive hlr
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing k B
  have : Algebra.FiniteType B H := Algebra.FiniteType.of_restrictScalars_finiteType k B H
  have : Algebra.FinitePresentation B H := Algebra.FinitePresentation.of_finiteType.mp inferInstance
  exact I.isIso_fppfHomogeneousQuotientToCoinvariantsPoints
    (toIdeal_eq_span_coinvariants_counit_eq_zero_of_isLinearlyReductive I hlr)
    (faithfullyFlat_coinvariants_of_isLinearlyReductive I hlr)
    (RingHom.finitePresentation_algebraMap.mpr inferInstance)

/-- **The homogeneous quotient by a linearly reductive subgroup is affine.** Let `G` be a
geometrically reduced affine group of finite type over a field and `N` a linearly reductive
closed subgroup. Then the fppf homogeneous quotient `G/N` is represented by `Spec O(G)^N`, the
spectrum of the functions on `G` invariant under right translation by `N`. -/
noncomputable def fppfHomogeneousQuotientIsoCoinvariantsPoints
    (hlr : Coalgebra.IsLinearlyReductive.{u, u, u} k (H ⧸ I.toIdeal)) :
    CommHopfAlgCat.fppfHomogeneousQuotient H I ≅
      (CommAlgCat.fppfTopology k).uliftYoneda.{u + 1}.obj (op (CommAlgCat.of k I.coinvariants)) :=
  have := I.isIso_fppfHomogeneousQuotientToCoinvariantsPoints_of_isLinearlyReductive hlr
  asIso I.fppfHomogeneousQuotientToCoinvariantsPoints

/-- The forward map of the representing isomorphism is the descended restriction map. -/
@[simp]
theorem fppfHomogeneousQuotientIsoCoinvariantsPoints_hom
    (hlr : Coalgebra.IsLinearlyReductive.{u, u, u} k (H ⧸ I.toIdeal)) :
    (I.fppfHomogeneousQuotientIsoCoinvariantsPoints hlr).hom =
      I.fppfHomogeneousQuotientToCoinvariantsPoints :=
  (rfl)

/-- **Matsushima's criterion, affine direction, in characteristic zero.** For a reductive closed
subgroup `N` of an affine group `G` of finite type over a field of characteristic zero,
restriction to the invariant functions identifies the fppf homogeneous quotient `G/N` with the
sheaf of points of `Spec O(G)^N`. -/
theorem isIso_fppfHomogeneousQuotientToCoinvariantsPoints_of_reductive [CharZero k]
    {H : FiniteTypeCommHopfAlgCat.{u, u} k} (I : HopfIdeal k H)
    (hred : reductiveCommHopfAlgProperty k (FiniteTypeCommHopfAlgCat.quotient H I)) :
    IsIso (I.fppfHomogeneousQuotientToCoinvariantsPoints (H := H.obj)) := by
  have : IsReduced H := HopfAlgebra.isReduced_of_charZero k H
  exact I.isIso_fppfHomogeneousQuotientToCoinvariantsPoints_of_isLinearlyReductive
    ((linearlyReductiveCommHopfAlgProperty_iff k _).mp hred.linearlyReductive)

/-- **Matsushima's criterion for a closed immersion, in characteristic zero.** Let
`f : O(G) ⟶ O(N)` be a surjection of finite-type commutative Hopf algebras over a field of
characteristic zero, representing a closed immersion of a reductive group `N` into `G`. Then
restriction to the functions on `G` invariant under right translation by `N` identifies the fppf
homogeneous quotient `G/N` with the sheaf of points of `Spec O(G)^N`. -/
theorem isIso_fppfHomogeneousQuotientToCoinvariantsPoints_ker_of_reductive [CharZero k]
    {H K : FiniteTypeCommHopfAlgCat.{u, u} k} (f : H ⟶ K) (hf : Function.Surjective f.hom.hom)
    (hK : reductiveCommHopfAlgProperty k K) :
    IsIso ((ker f.hom.hom).fppfHomogeneousQuotientToCoinvariantsPoints (H := H.obj)) :=
  isIso_fppfHomogeneousQuotientToCoinvariantsPoints_of_reductive _
    ((reductiveCommHopfAlgProperty k).prop_of_iso (ObjectProperty.isoMk _
      (_root_.CommHopfAlgCat.Hom.quotientIsoOfKerOfSurjectiveEq f.hom hf
        (kerOfSurjective_eq_ker _ hf))).symm hK)

end Field

end TauCeti.HopfIdeal
