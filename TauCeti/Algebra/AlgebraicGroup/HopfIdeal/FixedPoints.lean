module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Equalizer
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Basic
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Equalizer

/-!
# The fixed-point closed subgroup scheme of a family of group-scheme endomorphisms

Given an indexed family `f : Θ → (H ⟶ H)` of endomorphisms of a commutative Hopf algebra `H` over
a commutative ring `R`, the **fixed-point Hopf ideal**
`TauCeti.CommHopfAlgCat.fixedPointsHopfIdeal f` is the supremum of the equalizer Hopf ideals
`equalizerHopfIdeal (f θ) (𝟙 H)` in the complete upper semilattice of Hopf ideals of `H`.

Contravariantly, each `f θ` is a group-scheme endomorphism of `Spec H`, and the quotient
`quotient H (fixedPointsHopfIdeal f)` represents the closed subgroup scheme of points of `Spec H`
fixed simultaneously by every `f θ`:

* Algebraically, `quotient H (fixedPointsHopfIdeal f)` is the joint coequalizer of the pairs
  `(f θ, 𝟙 H)` in `CommHopfAlgCat R` (`TauCeti.CommHopfAlgCat.liftFixedPoints`).
* On functors of points, for every commutative `R`-algebra `A`, the subgroup of `A`-points cut out
  by `fixedPointsHopfIdeal f` is precisely the subgroup of points fixed by every
  `BialgHom.mapDomain (f θ).hom`
  (`TauCeti.CommHopfAlgCat.mem_quotientPointsSubgroup_fixedPointsHopfIdeal_iff` and
  `TauCeti.CommHopfAlgCat.range_mapDomain_mkQuotient_fixedPointsHopfIdeal`).

When `H` is of finite type over `R`, the same construction produces a finite-type quotient in
`FiniteTypeCommHopfAlgCat R` (`TauCeti.FiniteTypeCommHopfAlgCat.fixedPointsHopfIdeal`).

## Main declarations

* `TauCeti.CommHopfAlgCat.fixedPointsHopfIdeal`: the Hopf ideal generated by the differences
  `(f θ).hom a - a`.
* `TauCeti.CommHopfAlgCat.fixedPointsHopfIdeal_le_iff`,
  `TauCeti.CommHopfAlgCat.fixedPointsHopfIdeal_le_ker_iff`,
  `TauCeti.CommHopfAlgCat.fixedPointsHopfIdeal_toIdeal_le_ker_iff`: universal properties of the
  fixed-point Hopf ideal.
* `TauCeti.CommHopfAlgCat.liftFixedPoints`,
  `TauCeti.CommHopfAlgCat.mkQuotient_comp_liftFixedPoints`,
  `TauCeti.CommHopfAlgCat.liftFixedPoints_unique`: the joint coequalizer universal property.
* `TauCeti.CommHopfAlgCat.mem_quotientPointsSubgroup_fixedPointsHopfIdeal_iff` and
  `TauCeti.CommHopfAlgCat.range_mapDomain_mkQuotient_fixedPointsHopfIdeal`: identification of the
  functor of points of the fixed-point closed subgroup scheme.
* `TauCeti.FiniteTypeCommHopfAlgCat.fixedPointsHopfIdeal` and
  `TauCeti.FiniteTypeCommHopfAlgCat.range_mapDomain_mkQuotient_fixedPointsHopfIdeal`: the
  finite-type specialization.

## References

* J. S. Milne, *Algebraic Groups* (2017), §1.h.
* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), §3.
-/

public section

open _root_.CommHopfAlgCat _root_.CommHopfAlgCat.Hom
open CategoryTheory WithConv

namespace TauCeti

universe u v w x

namespace CommHopfAlgCat

variable {R : Type u} [CommRing R]
variable {H T : _root_.CommHopfAlgCat.{v} R} {Θ : Sort w}

/-- The **fixed-point Hopf ideal** of an indexed family `f : Θ → (H ⟶ H)` of endomorphisms of a
commutative Hopf algebra `H`: the supremum of the equalizer Hopf ideals of `f θ` and `𝟙 H`.

Contravariantly, `quotient H (fixedPointsHopfIdeal f)` represents the closed subgroup scheme of
points of `Spec H` fixed by every `f θ`. -/
noncomputable def fixedPointsHopfIdeal (f : Θ → (H ⟶ H)) : HopfIdeal R H :=
  ⨆ θ : Θ, equalizerHopfIdeal (f θ) (𝟙 H)

/-- The fixed-point Hopf ideal is the supremum of the equalizer Hopf ideals `equalizerHopfIdeal
(f θ) (𝟙 H)`. -/
theorem fixedPointsHopfIdeal_eq_iSup (f : Θ → (H ⟶ H)) :
    fixedPointsHopfIdeal f = ⨆ θ : Θ, equalizerHopfIdeal (f θ) (𝟙 H) :=
  (rfl)

/-- The underlying ideal of `fixedPointsHopfIdeal f` is the supremum of the equalizer ideals of
`(f θ).hom` and `BialgHom.id R H`. -/
@[simp]
theorem fixedPointsHopfIdeal_toIdeal (f : Θ → (H ⟶ H)) :
    (fixedPointsHopfIdeal f).toIdeal =
      ⨆ θ : Θ, HopfIdeal.equalizerIdeal (f θ).hom (BialgHom.id R H) := by
  rw [fixedPointsHopfIdeal_eq_iSup, HopfIdeal.iSup_toIdeal]
  refine iSup_congr fun θ ↦ ?_
  exact equalizerHopfIdeal_toIdeal (f θ) (𝟙 H)

/-- Every difference `(f θ).hom a - a` belongs to `fixedPointsHopfIdeal f`. -/
theorem sub_mem_fixedPointsHopfIdeal (f : Θ → (H ⟶ H)) (θ : Θ) (a : H) :
    (f θ).hom a - a ∈ fixedPointsHopfIdeal f := by
  rw [← HopfIdeal.mem_toIdeal, fixedPointsHopfIdeal_toIdeal]
  exact le_iSup (fun i ↦ HopfIdeal.equalizerIdeal (f i).hom (BialgHom.id R H)) θ
    (HopfIdeal.sub_mem_equalizerIdeal (f θ).hom (BialgHom.id R H) a)

/-- Universal property of `fixedPointsHopfIdeal` in the lattice of Hopf ideals: it is the smallest
Hopf ideal containing every difference `(f θ).hom a - a`. -/
theorem fixedPointsHopfIdeal_le_iff {f : Θ → (H ⟶ H)} {J : HopfIdeal R H} :
    fixedPointsHopfIdeal f ≤ J ↔ ∀ (θ : Θ) (a : H), (f θ).hom a - a ∈ J := by
  rw [← HopfIdeal.toIdeal_le_toIdeal, fixedPointsHopfIdeal_eq_iSup, HopfIdeal.iSup_toIdeal,
    iSup_le_iff]
  exact forall_congr' fun θ ↦ by
    rw [HopfIdeal.toIdeal_le_toIdeal, equalizerHopfIdeal_le_iff]
    simp only [_root_.CommHopfAlgCat.id_apply]

/-- A ring homomorphism out of `H` kills `fixedPointsHopfIdeal f` if and only if it is invariant
under every `f θ`. -/
theorem fixedPointsHopfIdeal_le_ker_iff {A : Type x} [Ring A] (f : Θ → (H ⟶ H)) (φ : H →+* A) :
    (fixedPointsHopfIdeal f).toIdeal ≤ RingHom.ker φ ↔
      ∀ (θ : Θ) (a : H), φ ((f θ).hom a) = φ a := by
  rw [fixedPointsHopfIdeal_eq_iSup, HopfIdeal.iSup_toIdeal, iSup_le_iff]
  exact forall_congr' fun θ ↦ equalizerHopfIdeal_le_ker_iff (f θ) (𝟙 H) φ

/-- A morphism out of `H` kills `fixedPointsHopfIdeal f` if and only if it coequalizes every
`f θ` with `𝟙 H`. -/
theorem fixedPointsHopfIdeal_toIdeal_le_ker_iff (f : Θ → (H ⟶ H)) (p : H ⟶ T) :
    (fixedPointsHopfIdeal f).toIdeal ≤ RingHom.ker p.hom.toAlgHom.toRingHom ↔
      ∀ θ : Θ, f θ ≫ p = p := by
  rw [fixedPointsHopfIdeal_eq_iSup, HopfIdeal.iSup_toIdeal, iSup_le_iff]
  refine forall_congr' fun θ ↦ ?_
  simpa only [Category.id_comp] using equalizerHopfIdeal_toIdeal_le_ker_iff (f θ) (𝟙 H) p

/-- The fixed-point Hopf ideal vanishes if and only if every member of the family is the identity.
-/
@[simp]
theorem fixedPointsHopfIdeal_eq_bot_iff (f : Θ → (H ⟶ H)) :
    fixedPointsHopfIdeal f = ⊥ ↔ ∀ θ : Θ, f θ = 𝟙 H := by
  rw [← le_bot_iff, ← HopfIdeal.toIdeal_le_toIdeal, fixedPointsHopfIdeal_eq_iSup,
    HopfIdeal.iSup_toIdeal, iSup_le_iff]
  exact forall_congr' fun θ ↦ by
    rw [HopfIdeal.toIdeal_le_toIdeal, le_bot_iff, equalizerHopfIdeal_eq_bot_iff]

/-- The quotient morphism by `fixedPointsHopfIdeal f` is invariant under every `f θ`. -/
theorem comp_mkQuotient_fixedPointsHopfIdeal (f : Θ → (H ⟶ H)) (θ : Θ) :
    f θ ≫ mkQuotient H (fixedPointsHopfIdeal f) = mkQuotient H (fixedPointsHopfIdeal f) :=
  ((fixedPointsHopfIdeal_toIdeal_le_ker_iff f (mkQuotient H (fixedPointsHopfIdeal f))).mp
    (mkQuotient_ker H (fixedPointsHopfIdeal f)).ge) θ

/-- Joint coequalizer universal property: a morphism `p : H ⟶ T` invariant under every `f θ`
factors through `quotient H (fixedPointsHopfIdeal f)`. -/
noncomputable def liftFixedPoints {f : Θ → (H ⟶ H)} (p : H ⟶ T) (hp : ∀ θ : Θ, f θ ≫ p = p) :
    quotient H (fixedPointsHopfIdeal f) ⟶ T :=
  liftQuotient (fixedPointsHopfIdeal f) p ((fixedPointsHopfIdeal_toIdeal_le_ker_iff f p).mpr hp)

/-- Factoring along `liftFixedPoints` recovers the original morphism after precomposing with the
quotient morphism. -/
@[simp]
theorem mkQuotient_comp_liftFixedPoints {f : Θ → (H ⟶ H)} (p : H ⟶ T)
    (hp : ∀ θ : Θ, f θ ≫ p = p) :
    mkQuotient H (fixedPointsHopfIdeal f) ≫ liftFixedPoints p hp = p :=
  mkQuotient_comp_liftQuotient _ _ _

/-- Uniqueness of the factorization through `quotient H (fixedPointsHopfIdeal f)`. -/
theorem liftFixedPoints_unique {f : Θ → (H ⟶ H)} (p : H ⟶ T) (hp : ∀ θ : Θ, f θ ≫ p = p)
    (q : quotient H (fixedPointsHopfIdeal f) ⟶ T)
    (hq : mkQuotient H (fixedPointsHopfIdeal f) ≫ q = p) :
    q = liftFixedPoints p hp :=
  liftQuotient_unique _ _ _ q hq

/-- On `A`-points, the closed subgroup cut out by `fixedPointsHopfIdeal f` consists of the points
fixed by every `BialgHom.mapDomain (f θ).hom`. -/
theorem mem_quotientPointsSubgroup_fixedPointsHopfIdeal_iff (f : Θ → (H ⟶ H))
    (A : CommAlgCat.{x} R) (g : HopfAlgebra.points (R := R) (H := H) A) :
    g ∈ quotientPointsSubgroup H (fixedPointsHopfIdeal f) A ↔
      ∀ θ : Θ, BialgHom.mapDomain (f θ).hom g = g := by
  have hker (I : HopfIdeal R H) :
      (g ∈ quotientPointsSubgroup H I A) ↔
        I.toIdeal ≤ RingHom.ker (g.ofConv : H →ₐ[R] A).toRingHom := by
    rw [mem_quotientPointsSubgroup_iff]
    exact ⟨fun h _ hy ↦ RingHom.mem_ker.mpr (h _ (HopfIdeal.mem_toIdeal.mp hy)),
      fun h _ hy ↦ RingHom.mem_ker.mp (h (HopfIdeal.mem_toIdeal.mpr hy))⟩
  rw [hker, fixedPointsHopfIdeal_eq_iSup, HopfIdeal.iSup_toIdeal, iSup_le_iff]
  refine forall_congr' fun θ ↦ ?_
  rw [← hker, mem_quotientPointsSubgroup_equalizerHopfIdeal_iff]
  have hid : BialgHom.mapDomain (𝟙 H : H ⟶ H).hom g = g := by
    apply ofConv_injective
    ext a
    simp
  rw [hid]

/-- For every commutative `R`-algebra `A`, the image of `A`-points of
`quotient H (fixedPointsHopfIdeal f)` inside the `A`-points of `H` is precisely the set of
`f`-fixed `A`-points. -/
theorem range_mapDomain_mkQuotient_fixedPointsHopfIdeal (f : Θ → (H ⟶ H))
    (A : Type x) [CommRing A] [Algebra R A] :
    Set.range (BialgHom.mapDomain (A := A) (mkQuotient H (fixedPointsHopfIdeal f)).hom) =
      {g | ∀ θ : Θ, BialgHom.mapDomain (A := A) (f θ).hom g = g} := by
  have hfn : (BialgHom.mapDomain (A := A) (mkQuotient H (fixedPointsHopfIdeal f)).hom :
      WithConv ((quotient H (fixedPointsHopfIdeal f) : Type v) →ₐ[R] A) →
        WithConv ((H : Type v) →ₐ[R] A)) =
      quotientPointsHom H (fixedPointsHopfIdeal f) (CommAlgCat.of R A) := by
    funext p
    rw [BialgHom.mapDomain_apply, quotientPointsHom_apply]
  rw [hfn]
  ext g
  exact mem_quotientPointsSubgroup_fixedPointsHopfIdeal_iff f (CommAlgCat.of R A) g

end CommHopfAlgCat

namespace FiniteTypeCommHopfAlgCat

variable {R : Type u} [CommRing R]
variable {H : FiniteTypeCommHopfAlgCat.{u, v} R} {Θ : Sort w}

/-- The **fixed-point Hopf ideal** of an indexed family `f : Θ → (H ⟶ H)` of endomorphisms of a
finite-type commutative Hopf algebra `H`. -/
noncomputable abbrev fixedPointsHopfIdeal (f : Θ → (H ⟶ H)) : HopfIdeal R H :=
  CommHopfAlgCat.fixedPointsHopfIdeal (fun θ ↦ (f θ).hom)

/-- For every commutative `R`-algebra `A`, the image of `A`-points of the finite-type fixed-point
quotient `quotient H (fixedPointsHopfIdeal f)` inside the `A`-points of `H` is precisely the set
of `f`-fixed `A`-points. -/
theorem range_mapDomain_mkQuotient_fixedPointsHopfIdeal (f : Θ → (H ⟶ H))
    (A : Type x) [CommRing A] [Algebra R A] :
    Set.range (BialgHom.mapDomain (A := A) (mkQuotient H (fixedPointsHopfIdeal f)).hom.hom) =
      {g | ∀ θ : Θ, BialgHom.mapDomain (A := A) (f θ).hom.hom g = g} :=
  CommHopfAlgCat.range_mapDomain_mkQuotient_fixedPointsHopfIdeal (fun θ ↦ (f θ).hom) A

end FiniteTypeCommHopfAlgCat

end TauCeti
