module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Tangent
public import TauCeti.Algebra.AlgebraicGroup.Tangent.Lie.BaseChange

/-!
# The Lie algebra of a base-changed closed subgroup

Let `J` be a Hopf ideal of a commutative Hopf algebra `H` over `k`, cutting out a closed subgroup
of `Spec H`, and let `K` be a commutative `k`-algebra. The base change `J_K` of `J`
(`TauCeti.CommHopfAlgCat.baseChangeHopfIdeal`) is generated by `1 ⊗ J`, so a tangent vector of
`Spec (K ⊗[k] H)` lies in the Lie algebra of the base-changed subgroup exactly when it vanishes on
`1 ⊗ J`.

When the cotangent space of `H` is finite projective, the Lie algebra of `Spec (K ⊗[k] H)` is the
scalar extension of that of `Spec H` (`Derivation.cotangentDualBaseChangeEquiv`). Under this
comparison the scalar extension of a tangent vector of the subgroup is a tangent vector of the
base-changed subgroup, and along an injective map `k → K` a tangent vector of `Spec H` belongs to
the subgroup exactly when its extension `1 ⊗ x` belongs to the base-changed subgroup.

## Main results

* `TauCeti.CommHopfAlgCat.mem_lieSubalgebra_baseChangeHopfIdeal_iff`: the Lie algebra of `J_K`
  consists of the tangent vectors vanishing on `1 ⊗ J`.
* `TauCeti.CommHopfAlgCat.cotangentDualBaseChangeEquiv_tmul_mem_lieSubalgebra_baseChangeHopfIdeal`
  : scalar extension carries the Lie algebra of `J` into that of `J_K`.
* `CommHopfAlgCat.cotangentDualBaseChangeEquiv_one_tmul_mem_lieSubalgebra_baseChangeHopfIdeal_iff`:
  along an injective map `k → K`, the extension `1 ⊗ x` lies in the Lie algebra of `J_K` exactly
  when `x` lies in the Lie algebra of `J`.

## References

* J. S. Milne, *Algebraic Groups* (2017), §10.a.
-/

public section

open scoped TensorProduct

namespace TauCeti.CommHopfAlgCat

universe u v w x

variable {k : Type u} {K : Type w} [CommRing k] [CommRing K] [Algebra k K]
  {H : _root_.CommHopfAlgCat.{v} k}

/-- **The Lie algebra of a base-changed closed subgroup.** A tangent vector of
`Spec (K ⊗[k] H)` lies in the Lie algebra of the base change of the subgroup cut out by `J`
exactly when it vanishes on `1 ⊗ J`. -/
theorem mem_lieSubalgebra_baseChangeHopfIdeal_iff (J : HopfIdeal k H) {B : Type x} [CommRing B]
    [Algebra K B] (d : Derivation K (K ⊗[k] H) (Bialgebra.CounitAlgebra K (K ⊗[k] H) B)) :
    d ∈ (baseChangeHopfIdeal (K := K) J).lieSubalgebra (B := B) ↔ ∀ h ∈ J, d (1 ⊗ₜ h) = 0 := by
  rw [HopfIdeal.mem_lieSubalgebra_iff_of_toIdeal_eq_span _
    ((baseChangeHopfIdeal_toIdeal J).trans (Ideal.map.eq_1 _ _)), Set.forall_mem_image]
  simp only [Algebra.TensorProduct.includeRight_apply, SetLike.mem_coe, HopfIdeal.mem_toIdeal]

variable [Module.Finite k (Bialgebra.CotangentSpace k H)]
  [Module.Projective k (Bialgebra.CotangentSpace k H)]

/-- **Scalar extension preserves the Lie algebra of a closed subgroup**: if the tangent vector `x`
of `Spec H` lies in the Lie algebra of the subgroup cut out by `J`, then every `s ⊗ x` lies in the
Lie algebra of the base-changed subgroup. -/
theorem cotangentDualBaseChangeEquiv_tmul_mem_lieSubalgebra_baseChangeHopfIdeal
    {J : HopfIdeal k H} {y : Module.Dual k (Bialgebra.CotangentSpace k H)}
    (hy : Derivation.cotangentLinearEquiv (B := k) y ∈ J.lieSubalgebra (B := k)) (s : K) :
    Derivation.cotangentLinearEquiv (B := K)
        (Derivation.cotangentDualBaseChangeEquiv k K H (s ⊗ₜ y)) ∈
      (baseChangeHopfIdeal (K := K) J).lieSubalgebra (B := K) := by
  rw [HopfIdeal.mem_lieSubalgebra_iff] at hy
  rw [mem_lieSubalgebra_baseChangeHopfIdeal_iff]
  intro h hh
  apply (Bialgebra.CounitAlgebra.algEquivSelf K (K ⊗[k] H) K).injective
  have hyh := congrArg (Bialgebra.CounitAlgebra.algEquivSelf k H k) (hy h hh)
  rw [Derivation.algEquivSelf_cotangentLinearEquiv_apply, map_zero] at hyh
  rw [Derivation.algEquivSelf_cotangentLinearEquiv_cotangentDualBaseChangeEquiv_tmul_apply, hyh,
    map_zero, mul_zero, map_zero]

/-- **Along an injective scalar map, the Lie algebra of a closed subgroup is detected after base
change**: the extension `1 ⊗ x` of a tangent vector `x` of `Spec H` lies in the Lie algebra of the
base-changed subgroup exactly when `x` lies in the Lie algebra of the subgroup cut out by `J`. -/
theorem cotangentDualBaseChangeEquiv_one_tmul_mem_lieSubalgebra_baseChangeHopfIdeal_iff
    [FaithfulSMul k K] (J : HopfIdeal k H) (y : Module.Dual k (Bialgebra.CotangentSpace k H)) :
    Derivation.cotangentLinearEquiv (B := K)
        (Derivation.cotangentDualBaseChangeEquiv k K H (1 ⊗ₜ y)) ∈
      (baseChangeHopfIdeal (K := K) J).lieSubalgebra (B := K) ↔
      Derivation.cotangentLinearEquiv (B := k) y ∈ J.lieSubalgebra (B := k) := by
  refine ⟨fun hy ↦ ?_, fun hy ↦
    cotangentDualBaseChangeEquiv_tmul_mem_lieSubalgebra_baseChangeHopfIdeal hy 1⟩
  rw [mem_lieSubalgebra_baseChangeHopfIdeal_iff] at hy
  rw [HopfIdeal.mem_lieSubalgebra_iff]
  intro h hh
  apply (Bialgebra.CounitAlgebra.algEquivSelf k H k).injective
  have hyh := congrArg (Bialgebra.CounitAlgebra.algEquivSelf K (K ⊗[k] H) K) (hy h hh)
  rw [Derivation.algEquivSelf_cotangentLinearEquiv_cotangentDualBaseChangeEquiv_tmul_apply,
    one_mul, map_zero, FaithfulSMul.algebraMap_eq_zero_iff] at hyh
  rw [Derivation.algEquivSelf_cotangentLinearEquiv_apply, hyh, map_zero]

end TauCeti.CommHopfAlgCat
