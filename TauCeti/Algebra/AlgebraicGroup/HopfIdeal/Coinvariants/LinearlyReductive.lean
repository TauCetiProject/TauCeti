/-!
# Linearly reductive subgroups and extensions

Let `G` be an affine group over a field `k` with coordinate Hopf algebra `H`, and let `N` be a
closed subgroup cut out by the Hopf ideal `I`. Write `B = H^{co H/I}` for the functions on `G`
invariant under right translation by `N`, the candidate coordinate ring of `G / N`. If `N` is
linearly reductive, then `I` is generated by the elements of `B` vanishing at the identity
(`TauCeti.HopfIdeal.toIdeal_eq_span_coinvariants_counit_eq_zero_of_isLinearlyReductive`).
Equivalently, by
`TauCeti.HopfIdeal.canonicalMap_injective_iff_toIdeal_eq_span_coinvariants_counit_eq_zero`,
the canonical map

```text
H ⊗[B] H → H ⊗[k] (H ⧸ I),    a ⊗ b ↦ (a ⊗ 1) (id ⊗ π)(Δ b)
```

is bijective (`TauCeti.HopfIdeal.canonicalMap_bijective_of_isLinearlyReductive`): the morphism
`(g, n) ↦ (g, g n)` identifies `G × N` with `G ×_{Spec B} G`. This is the torsor half of the
identification of the homogeneous space `G / N` with the affine scheme `Spec B` when `N` is
linearly reductive; faithful flatness of `H` over `B` is a separate statement.

No normality, smoothness, connectedness or finite-type assumption is made: linear reductivity
enters only through exactness of invariants.

The proof uses exactness of invariants. For `x ∈ I`, the element `x ⊗ 1` of the cofree comodule
`H ⊗ (H ⧸ I)` is invariant, and it is a finite sum of values of the comodule morphisms
`I → H ⊗ (H ⧸ I)`, `m ↦ (b ⊗ 1) (id ⊗ π)(Δ m)`, at elements of `I`: this is where the Hopf ideal
axioms enter, through `TauCeti.HopfIdeal.leftTensorIdeal_le_map_comul_sup_rightTensorIdeal`. Over
a linearly reductive coalgebra the arguments can be chosen invariant
(`TauCeti.Comodule.Hom.exists_fixed_sum_eq_of_isLinearlyReductive`), and an invariant element of
`I` is a coinvariant with vanishing counit. Applying the counit to the second factor then writes
`x` as an `H`-linear combination of such coinvariants.

When `I` is normal, `B` is the coordinate ring of `G ⧸ N`. For a representation `V` of `G`, the
`N`-invariant vectors form a representation of `G ⧸ N`, whose invariant vectors are exactly the
`G`-invariant vectors. Consequently, if both `N` and `G ⧸ N` are linearly reductive, then so is
`G`. In particular, when `N` is linearly reductive, `G` is linearly reductive exactly when
`G ⧸ N` is.

## Main declarations

* `TauCeti.HopfIdeal.toIdeal_eq_span_coinvariants_counit_eq_zero_of_isLinearlyReductive`:
  a linearly reductive subgroup is cut out by its invariant functions vanishing at the identity.
* `TauCeti.HopfIdeal.canonicalMap_bijective_of_isLinearlyReductive`: the associated canonical map
  is bijective.
* `TauCeti.linearlyReductiveCommHopfAlgProperty.of_quotient_of_coinvariants`: an extension of
  linearly reductive groups is linearly reductive.
* `TauCeti.linearlyReductiveCommHopfAlgProperty_iff_coinvariants`: for a linearly reductive normal
  subgroup `N`, the group `G` is linearly reductive exactly when `G ⧸ N` is.

## References

* M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*, Manuscripta Math.
  **7** (1972), 251–270.
* H.-J. Schneider, *Principal homogeneous spaces for arbitrary Hopf algebras*, Israel J. Math.
  **72** (1990), 167–195.
* J. S. Milne, *Algebraic Groups* (2017), §7.d and Chapter 12.
* J. C. Jantzen, *Representations of Algebraic Groups*, I.6.
* W. C. Waterhouse, *Introduction to Affine Group Schemes*, §16.3.
-/

public section

open CategoryTheory
open scoped TensorProduct

namespace TauCeti

universe u v w

noncomputable section

variable {k : Type u} [Field k] {H : _root_.CommHopfAlgCat.{v} k} {I : HopfIdeal k H}
variable (V : Type w) [AddCommMonoid V] [Module k V] [Comodule k H V]

-- `CommHopfAlgCat.coinvariants` unfolds to a subalgebra, whose Hopf structure is not an instance.
private noncomputable abbrev coinvariantsHopfAlgebra (hI : I.IsNormal) :
    HopfAlgebra k (CommHopfAlgCat.coinvariants hI) :=
  (CommHopfAlgCat.coinvariants hI).hopfAlgebra

attribute [local instance] coinvariantsHopfAlgebra

/-- The inclusion of the coordinate ring of `G ⧸ N` as a coalgebra morphism. -/
private abbrev coinvariantsCoalgHom (hI : I.IsNormal) :
    CommHopfAlgCat.coinvariants hI →ₗc[k] H :=
  (CommHopfAlgCat.coinvariantsι hI).hom.toCoalgHom

private theorem lTensor_coinvariantsCoalgHom_injective (hI : I.IsNormal) (W : Type w)
    [AddCommMonoid W] [Module k W] :
    Function.Injective ((coinvariantsCoalgHom hI).toLinearMap.lTensor W) :=
  let _ : AddCommGroup W := Module.addCommMonoidToAddCommGroup k
  Module.Flat.lTensor_preserves_injective_linearMap (coinvariantsCoalgHom hI).toLinearMap
    (CommHopfAlgCat.hopfSubalgebraι_injective hI.isHopfSubalgebra_coinvariants)

private theorem lTensor_map_coinvariantsCoalgHom_injective (hI : I.IsNormal) (W : Type w)
    [AddCommMonoid W] [Module k W] :
    Function.Injective ((TensorProduct.map (coinvariantsCoalgHom hI).toLinearMap
      (coinvariantsCoalgHom hI).toLinearMap).lTensor W) :=
  let _ : AddCommGroup W := Module.addCommMonoidToAddCommGroup k
  have hι := CommHopfAlgCat.hopfSubalgebraι_injective hI.isHopfSubalgebra_coinvariants
  Module.Flat.lTensor_preserves_injective_linearMap _
    (TensorProduct.map_injective_of_flat_flat (coinvariantsCoalgHom hI).toLinearMap
      (coinvariantsCoalgHom hI).toLinearMap hι hι)

/-- The coaction on `N`-invariant vectors takes values in the coinvariants. -/
private theorem coact_mem_range_lTensor_coinvariantsCoalgHom (hI : I.IsNormal)
    (w : hI.weightSpaceOneSubcomodule V) :
    Comodule.coact (R := k) (C := H) w ∈
      LinearMap.range ((coinvariantsCoalgHom hI).toLinearMap.lTensor _) := by
  obtain ⟨z, hz⟩ := hI.coact_mem_range_lTensor_coinvariants w
  let e : Subalgebra.toSubmodule I.coinvariants ≃ₗ[k] CommHopfAlgCat.coinvariants hI :=
    LinearEquiv.refl k _
  have he : (coinvariantsCoalgHom hI).toLinearMap ∘ₗ e =
      (Subalgebra.toSubmodule I.coinvariants).subtype := by
    -- Both maps are the subtype inclusion of the same coinvariant carrier.
    rfl
  refine ⟨e.toLinearMap.lTensor _ z, ?_⟩
  rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp, he, hz]

/-- The representation of `G ⧸ N` on the `N`-invariant vectors of `V`. -/
@[implicit_reducible]
private noncomputable def coinvariantsComodule (hI : I.IsNormal) :
    Comodule k (CommHopfAlgCat.coinvariants hI) (hI.weightSpaceOneSubcomodule V) :=
  Comodule.ofCorestrict (coinvariantsCoalgHom hI) (lTensor_coinvariantsCoalgHom_injective hI _)
    (lTensor_map_coinvariantsCoalgHom_injective hI _)
    (coact_mem_range_lTensor_coinvariantsCoalgHom V hI)

/-- An `N`-invariant vector is fixed by `G ⧸ N` exactly when it is fixed by `G`. -/
private theorem mem_fixedSubcomodule_coinvariantsComodule_iff (hI : I.IsNormal)
    {w : hI.weightSpaceOneSubcomodule V} :
    w ∈ (letI := coinvariantsComodule V hI; Comodule.fixedSubcomodule k
      (CommHopfAlgCat.coinvariants hI) _) ↔
      w ∈ Comodule.fixedSubcomodule k H (hI.weightSpaceOneSubcomodule V) :=
  Comodule.mem_fixedSubcomodule_ofCorestrict_iff _ _ _ _
    (map_one (CommHopfAlgCat.coinvariantsι hI).hom)

/-- The quotient map `H → H ⧸ I` has the same underlying linear map whether it is bundled as a
coalgebra morphism or as an algebra morphism. -/
private theorem toLinearMap_toCoalgHom_mkBialgHom :
    (Bialgebra.Quotient.mkBialgHom (R := k) I.toIdeal).toCoalgHom.toLinearMap =
      (Ideal.Quotient.mkₐ k I.toIdeal).toLinearMap := by
  ext x
  simp [BialgHom.toCoalgHom_apply]

private theorem map_mem_weightSpace_one {V' : Type w}
    [AddCommMonoid V'] [Module k V'] [Comodule k H V'] (f : Comodule.Hom k H V V')
    {v : V} (hv : v ∈ I.weightSpace V 1) : f v ∈ I.weightSpace V' 1 := by
  let q := (Bialgebra.Quotient.mkBialgHom (R := k) I.toIdeal).toCoalgHom
  let _ : Comodule k (H ⧸ I.toIdeal) V := Comodule.Corestrict q
  let _ : Comodule k (H ⧸ I.toIdeal) V' := Comodule.Corestrict q
  have hq : q.toLinearMap = (Ideal.Quotient.mkₐ k I.toIdeal).toLinearMap :=
    toLinearMap_toCoalgHom_mkBialgHom
  have hv' : v ∈ _root_.GroupLike.weightSpace (M := V) (1 : GroupLike k (H ⧸ I.toIdeal)) := by
    rw [_root_.GroupLike.mem_weightSpace, Comodule.corestrict_coact_apply, hq]
    simpa using I.mem_weightSpace.mp hv
  have hfv := (Comodule.corestrictHom q f).map_mem_groupLikeWeightSpace hv'
  rw [_root_.GroupLike.mem_weightSpace, Comodule.corestrict_coact_apply, hq] at hfv
  exact I.mem_weightSpace.mpr <| by
    simpa only [Comodule.corestrictHom_apply, GroupLike.val_one] using hfv

/-- A morphism of representations of `G` restricts to a morphism of the representations of
`G ⧸ N` on `N`-invariant vectors. -/
private noncomputable def coinvariantsComoduleHom (hI : I.IsNormal) {V' : Type w}
    [AddCommMonoid V'] [Module k V'] [Comodule k H V'] (f : Comodule.Hom k H V V') :
    letI := coinvariantsComodule V hI
    letI := coinvariantsComodule V' hI
    Comodule.Hom k (CommHopfAlgCat.coinvariants hI) (hI.weightSpaceOneSubcomodule V)
      (hI.weightSpaceOneSubcomodule V') :=
  Comodule.Hom.ofCorestrict _ _ _ _ _ _ _ <|
    (f.comp (Subcomodule.subtype _)).codRestrict _ fun w ↦ by
      have hw : (w : V) ∈ I.weightSpace V 1 := by
        simpa only [← Subcomodule.mem_toSubmodule,
          hI.weightSpaceOneSubcomodule_toSubmodule] using w.2
      have hfw := map_mem_weightSpace_one V f hw
      simpa only [← Subcomodule.mem_toSubmodule, hI.weightSpaceOneSubcomodule_toSubmodule,
        Comodule.Hom.comp_apply, Subcomodule.subtype_apply] using hfw

/-- The restricted morphism acts as the original one on underlying vectors. -/
private theorem coe_coinvariantsComoduleHom_apply (hI : I.IsNormal) {V' : Type w}
    [AddCommMonoid V'] [Module k V'] [Comodule k H V'] (f : Comodule.Hom k H V V')
    (w : hI.weightSpaceOneSubcomodule V) :
    (coinvariantsComoduleHom V hI f w : V') = f w := by
  rw [coinvariantsComoduleHom, Comodule.Hom.ofCorestrict_apply, Comodule.Hom.codRestrict_apply,
    Comodule.Hom.comp_apply, Subcomodule.subtype_apply]

/-- **An extension of linearly reductive groups is linearly reductive.** Let `N` be the normal
closed subgroup of `G` cut out by a normal Hopf ideal `I`. If `N` and the quotient `G ⧸ N`, whose
coordinate ring is the coinvariants of `I`, are linearly reductive, then so is `G`. -/
theorem linearlyReductiveCommHopfAlgProperty.of_quotient_of_coinvariants
    (hI : I.IsNormal)
    (hN : linearlyReductiveCommHopfAlgProperty k (CommHopfAlgCat.quotient H I))
    (hQ : linearlyReductiveCommHopfAlgProperty k (CommHopfAlgCat.coinvariants hI)) :
    linearlyReductiveCommHopfAlgProperty k H := by
  rw [linearlyReductiveCommHopfAlgProperty_iff] at hN hQ ⊢
  refine Coalgebra.isLinearlyReductive_iff_forall_fixedMap_surjective_of_surjective.2
    fun M N f hf n ↦ ?_
  -- Restricted to the subgroup, every `N`-invariant vector of the target lifts.
  let q := (Bialgebra.Quotient.mkBialgHom (R := k) I.toIdeal).toCoalgHom
  have hmem {V : Type u} [AddCommMonoid V] [Module k V] [Comodule k H V] {v : V} :
      v ∈ hI.weightSpaceOneSubcomodule V ↔
        v ∈ (letI : Comodule k (H ⧸ I.toIdeal) V := Comodule.Corestrict q;
          Comodule.fixedSubcomodule k (H ⧸ I.toIdeal) V) := by
    let _ : Comodule k (H ⧸ I.toIdeal) V := Comodule.Corestrict q
    have hq : q.toLinearMap = (Ideal.Quotient.mkₐ k I.toIdeal).toLinearMap :=
      toLinearMap_toCoalgHom_mkBialgHom
    rw [HopfIdeal.IsNormal.mem_weightSpaceOneSubcomodule, Comodule.mem_fixedSubcomodule,
      Comodule.corestrict_coact_apply, hq]
  have hsurj : Function.Surjective (coinvariantsComoduleHom M hI f.hom) := by
    rintro ⟨y, hy⟩
    let _ : Comodule k (H ⧸ I.toIdeal) M := Comodule.Corestrict q
    let _ : Comodule k (H ⧸ I.toIdeal) N := Comodule.Corestrict q
    obtain ⟨⟨x, hx⟩, hxy⟩ :=
      (Comodule.corestrictHom q f.hom).fixedMap_surjective_of_isLinearlyReductive hN hf
        ⟨y, hmem.1 hy⟩
    refine ⟨⟨x, hmem.2 hx⟩, Subtype.ext ?_⟩
    rw [coe_coinvariantsComoduleHom_apply]
    simpa using congrArg Subtype.val hxy
  -- A `G`-invariant vector is `N`-invariant, and then fixed by `G ⧸ N`.
  have hnN : (n : N) ∈ hI.weightSpaceOneSubcomodule N := by
    rw [HopfIdeal.IsNormal.mem_weightSpaceOneSubcomodule, Comodule.mem_fixedSubcomodule.1 n.2,
      TensorProduct.map_tmul, LinearMap.id_apply, AlgHom.toLinearMap_apply, map_one]
  let n' : hI.weightSpaceOneSubcomodule N := ⟨n, hnN⟩
  have hn' : n' ∈ Comodule.fixedSubcomodule k H (hI.weightSpaceOneSubcomodule N) := by
    refine ((Subcomodule.subtype _).mem_fixedSubcomodule_iff_of_injective
      (fun a b h ↦ Subtype.ext (by simpa using h)) n').1 ?_
    simp [n']
  let _ := coinvariantsComodule M hI
  let _ := coinvariantsComodule N hI
  obtain ⟨⟨m, hm⟩, hmn⟩ :=
    (coinvariantsComoduleHom M hI f.hom).fixedMap_surjective_of_isLinearlyReductive hQ hsurj
      ⟨n', (mem_fixedSubcomodule_coinvariantsComodule_iff N hI).2 hn'⟩
  have hm' := (Subcomodule.subtype _).mem_fixedSubcomodule
    ((mem_fixedSubcomodule_coinvariantsComodule_iff M hI).1 hm)
  rw [Subcomodule.subtype_apply] at hm'
  refine ⟨⟨m, hm'⟩, Subtype.ext ?_⟩
  have hmn' := congrArg Subtype.val (congrArg Subtype.val hmn)
  rw [Comodule.Hom.fixedMap_apply, coe_coinvariantsComoduleHom_apply] at hmn'
  simpa using hmn'

/-- For a linearly reductive normal subgroup `N`, the group `G` is linearly reductive exactly when
the quotient `G ⧸ N` is. -/
theorem linearlyReductiveCommHopfAlgProperty_iff_coinvariants (hI : I.IsNormal)
    (hN : linearlyReductiveCommHopfAlgProperty k (CommHopfAlgCat.quotient H I)) :
    linearlyReductiveCommHopfAlgProperty k H ↔
      linearlyReductiveCommHopfAlgProperty k (CommHopfAlgCat.coinvariants hI) :=
  ⟨linearlyReductiveCommHopfAlgProperty.of_injective (CommHopfAlgCat.coinvariantsι hI)
      (CommHopfAlgCat.hopfSubalgebraι_injective hI.isHopfSubalgebra_coinvariants),
    linearlyReductiveCommHopfAlgProperty.of_quotient_of_coinvariants hI hN⟩

end

end TauCeti

open scoped TensorProduct
open Algebra.TensorProduct

namespace TauCeti.HopfIdeal

universe u v

section Ring

variable {R : Type u} {H : Type v} [CommRing R] [CommRing H] [HopfAlgebra R H] (I : HopfIdeal R H)

/-- The subgroup coaction of an element of `I` lies in `I ⊗ (H ⧸ I)`. -/
private theorem map_comul_mem_leftTensorIdeal {x : H} (hx : x ∈ I) :
    Algebra.TensorProduct.map (AlgHom.id R H) (Ideal.Quotient.mkₐ R I.toIdeal)
        (Coalgebra.comul (R := R) x) ∈ Ideal.leftTensorIdeal R (H ⧸ I.toIdeal) I.toIdeal := by
  have h := Ideal.mem_map_of_mem (Algebra.TensorProduct.map (AlgHom.id R H)
    (Ideal.Quotient.mkₐ R I.toIdeal) : H ⊗[R] H →+* H ⊗[R] (H ⧸ I.toIdeal)) (I.comul_mem hx)
  have hbot : Ideal.map (Ideal.Quotient.mkₐ R I.toIdeal).toRingHom I.toIdeal = ⊥ := by
    exact Ideal.map_quotient_self I.toIdeal
  rw [Ideal.map_sup, AlgHom.map_tensor_leftTensorIdeal, AlgHom.map_tensor_rightTensorIdeal,
    hbot, Ideal.rightTensorIdeal_def, Ideal.map_bot, sup_bot_eq] at h
  simpa using h

/-- For `x ∈ I`, the element `x ⊗ 1` of `H ⊗ (H ⧸ I)` is the image of an element of `H ⊗ I` under
the tensor shear followed by `id ⊗ π`. -/
private theorem tmul_one_mem_range_tensorShear {x : H} (hx : x ∈ I) :
    x ⊗ₜ[R] (1 : H ⧸ I.toIdeal) ∈ LinearMap.range
      ((Algebra.TensorProduct.map (AlgHom.id R H) (Ideal.Quotient.mkₐ R I.toIdeal)).toLinearMap ∘ₗ
        (HopfAlgebra.tensorShearMulRight (R := R) (H := H)).toLinearMap ∘ₗ
          (I.toIdeal.restrictScalars R).subtype.lTensor H) := by
  set P := Algebra.TensorProduct.map (AlgHom.id R H) (Ideal.Quotient.mkₐ R I.toIdeal)
  set σ := HopfAlgebra.tensorShearMulRight (R := R) (H := H)
  -- The shear carries `H ⊗ I` onto the ideal generated by `Δ I`.
  have hle : Ideal.map (Bialgebra.comulAlgHom R H) I.toIdeal ≤
      Ideal.map σ (Ideal.rightTensorIdeal R H I.toIdeal) := by
    refine Ideal.map_le_iff_le_comap.mpr fun i hi ↦ ?_
    have h : σ (1 ⊗ₜ[R] i) ∈ Ideal.map σ (Ideal.rightTensorIdeal R H I.toIdeal) :=
      Ideal.mem_map_of_mem σ (Ideal.tmul_mem_rightTensorIdeal R H 1 hi)
    rw [HopfAlgebra.tensorShearMulRight_tmul, ← Algebra.TensorProduct.one_def, one_mul] at h
    exact h
  -- Write `x ⊗ 1 = σ w + r` with `w, r ∈ H ⊗ I`; then `id ⊗ π` kills `r`.
  obtain ⟨a, ha, r, hr, hsum⟩ := Submodule.mem_sup.mp
    (I.leftTensorIdeal_le_map_comul_sup_rightTensorIdeal (Ideal.tmul_mem_leftTensorIdeal R H hx 1))
  obtain ⟨w, hw, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ σ.surjective).mp (hle ha)
  have hPr : P r = 0 := by
    rw [← RingHom.mem_ker, Ideal.ker_tensorProduct_map_id_quotient]
    exact hr
  rw [Ideal.mem_rightTensorIdeal_iff] at hw
  obtain ⟨w, rfl⟩ := hw
  refine ⟨w, ?_⟩
  have h := congrArg P hsum
  rw [map_add, hPr, add_zero] at h
  simp only [LinearMap.coe_comp, Function.comp_apply, AlgHom.toLinearMap_apply,
    AlgEquiv.toLinearMap_apply, h]
  simp [P]

end Ring

section Field

variable {k : Type u} {H : Type v} [Field k] [CommRing H] [HopfAlgebra k H] (I : HopfIdeal k H)

/-- The main step of `toIdeal_eq_span_coinvariants_counit_eq_zero_of_isLinearlyReductive`, for any
comodule structure on `H` given by the subgroup coaction. -/
private theorem mem_span_coinvariants_of_isLinearlyReductive
    [Comodule k (H ⧸ I.toIdeal) H]
    (hcoact : ∀ h : H, Comodule.coact (R := k) (C := H ⧸ I.toIdeal) (M := H) h =
      Algebra.TensorProduct.map (AlgHom.id k H) (Ideal.Quotient.mkₐ k I.toIdeal)
        (Coalgebra.comul (R := k) h))
    (hlr : Coalgebra.IsLinearlyReductive.{u, v, u} k (H ⧸ I.toIdeal)) {x : H} (hx : x ∈ I) :
    x ∈ Ideal.span {h | h ∈ I.coinvariants ∧ Coalgebra.counit (R := k) h = 0} := by
  set C := H ⧸ I.toIdeal
  set P := Algebra.TensorProduct.map (AlgHom.id k H) (Ideal.Quotient.mkₐ k I.toIdeal)
  -- The Hopf ideal is a subcomodule of `H`.
  let W : Subcomodule k C H :=
    { carrier := I.toIdeal.restrictScalars k
      coact_mem' := fun m hm ↦ by
        have h := map_comul_mem_leftTensorIdeal I hm
        rw [Ideal.mem_leftTensorIdeal_iff] at h
        rw [hcoact]
        exact h }
  let : Comodule k C (H ⊗[k] C) := Comodule.cofree k C H
  -- Multiplying the subgroup coaction by `b ⊗ 1` is a comodule morphism into the cofree
  -- comodule `H ⊗ C`.
  let f (b : H) : Comodule.Hom k C W (H ⊗[k] C) :=
    Comodule.Hom.cofreeLift (LinearMap.mulLeft k b ∘ₗ (Subcomodule.subtype W).toLinearMap)
  have hf (b : H) (w : W) : f b w = (b ⊗ₜ[k] (1 : C)) * P (Coalgebra.comul (R := k) (w : H)) := by
    simp only [f, Comodule.Hom.cofreeLift_apply, LinearMap.rTensor_comp, LinearMap.comp_apply,
      Subcomodule.subtype_toLinearMap, Subcomodule.subtype_rTensor_coact, hcoact]
    induction P (Coalgebra.comul (R := k) (w : H)) with
    | add y z hy hz => simp only [map_add, mul_add, hy, hz]
    | tmul a c => simp
  -- `x ⊗ 1` is a sum of values of the morphisms `f b`.
  obtain ⟨w, hw⟩ := tmul_one_mem_range_tensorShear I hx
  have hT : x ⊗ₜ[k] (1 : C) ∈ ⨆ b : H, LinearMap.range (f b).toLinearMap := by
    rw [← hw]
    clear hw
    induction w with
    | add y z hy hz =>
      rw [map_add]
      exact Submodule.add_mem _ hy hz
    | tmul b m =>
      refine Submodule.mem_iSup_of_mem b ⟨⟨m, m.property⟩, ?_⟩
      rw [Comodule.Hom.coe_toLinearMap, hf]
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.lTensor_tmul,
        Submodule.subtype_apply, AlgEquiv.toLinearMap_apply,
        HopfAlgebra.tensorShearMulRight_tmul, AlgHom.toLinearMap_apply, map_mul, P,
        Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]
  -- Exactness of invariants makes every summand invariant.
  obtain ⟨s, hs⟩ := Submodule.mem_iSup_iff_exists_finset.mp hT
  obtain ⟨μ, hμ⟩ := (Submodule.mem_iSup_finset_iff_exists_sum _ _).mp hs
  choose q hq using fun b ↦ LinearMap.mem_range.mp (μ b).property
  have hfix : x ⊗ₜ[k] (1 : C) ∈ Comodule.fixedSubcomodule k C (H ⊗[k] C) := by
    rw [Comodule.mem_fixedSubcomodule, Comodule.cofree_coact_tmul, Bialgebra.comul_one,
      Algebra.TensorProduct.one_def, TensorProduct.assoc_symm_tmul]
  obtain ⟨q', hq'fix, hq'⟩ := Comodule.Hom.exists_fixed_sum_eq_of_isLinearlyReductive hlr s f hfix
    ⟨q, by simpa only [← Comodule.Hom.coe_toLinearMap, hq] using hμ⟩
  -- An invariant element of `W` is a coinvariant of `I` with vanishing counit.
  have hcoinv (b : H) (hb : b ∈ s) : (q' b : H) ∈ I.coinvariants ∧
      Coalgebra.counit (R := k) (q' b : H) = 0 := by
    refine ⟨?_, I.counit_eq_zero (q' b).property⟩
    rw [mem_coinvariants_iff, ← hcoact]
    exact Subcomodule.coact_coe_eq_tmul_one W (Comodule.mem_fixedSubcomodule.mp (hq'fix b hb))
  have hsum : x ⊗ₜ[k] (1 : C) = (∑ b ∈ s, b * (q' b : H)) ⊗ₜ[k] (1 : C) := by
    rw [← hq', TensorProduct.sum_tmul]
    refine Finset.sum_congr rfl fun b hb ↦ ?_
    have hP : P (Coalgebra.comul (R := k) (q' b : H)) = (q' b : H) ⊗ₜ[k] (1 : C) :=
      mem_coinvariants_iff.mp (hcoinv b hb).1
    rw [hf, hP, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
  have hx' : x = ∑ b ∈ s, b * (q' b : H) := by
    simpa using congrArg (fun z ↦ TensorProduct.rid k H
      ((Coalgebra.counit (R := k) (A := C)).lTensor H z)) hsum
  rw [hx']
  exact Submodule.sum_mem _ fun b hb ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span (hcoinv b hb))

/-- **A linearly reductive closed subgroup is cut out by its invariant functions.** If the closed
subgroup `N` cut out by the Hopf ideal `I` is linearly reductive, then `I` is generated by the
functions on `G` which are invariant under right translation by `N` and vanish at the identity.
Geometrically, `N` is the scheme-theoretic fibre over the identity coset of `G → Spec O(G)^N`. -/
theorem toIdeal_eq_span_coinvariants_counit_eq_zero_of_isLinearlyReductive
    (hlr : Coalgebra.IsLinearlyReductive.{u, v, u} k (H ⧸ I.toIdeal)) :
    I.toIdeal = Ideal.span {h | h ∈ I.coinvariants ∧ Coalgebra.counit (R := k) h = 0} := by
  refine le_antisymm (fun x hx ↦ ?_) (span_coinvariants_counit_eq_zero_le I)
  let : Comodule k (H ⧸ I.toIdeal) H :=
    Comodule.Corestrict (Bialgebra.Quotient.mkBialgHom I.toIdeal).toCoalgHom
  refine mem_span_coinvariants_of_isLinearlyReductive I (fun h ↦ ?_) hlr hx
  rw [Comodule.corestrict_coact_apply, Comodule.instSelf_coact]
  induction Coalgebra.comul (R := k) h with
  | add y z hy hz => simp only [map_add, hy, hz]
  | tmul a b => simp [BialgHom.toCoalgHom_apply]

/-- **The canonical map of a linearly reductive closed subgroup is bijective.** For a linearly
reductive closed subgroup `N` of an affine group `G` over a field, with `B = O(G)^N`, the canonical
map `H ⊗[B] H → H ⊗[k] (H ⧸ I)` is an isomorphism: `G × N ≅ G ×_{Spec B} G` by
`(g, n) ↦ (g, g n)`. -/
theorem canonicalMap_bijective_of_isLinearlyReductive
    (hlr : Coalgebra.IsLinearlyReductive.{u, v, u} k (H ⧸ I.toIdeal)) :
    Function.Bijective I.canonicalMap :=
  ⟨(canonicalMap_injective_iff_toIdeal_eq_span_coinvariants_counit_eq_zero I).mpr
      (toIdeal_eq_span_coinvariants_counit_eq_zero_of_isLinearlyReductive I hlr),
    canonicalMap_surjective I⟩

end Field

