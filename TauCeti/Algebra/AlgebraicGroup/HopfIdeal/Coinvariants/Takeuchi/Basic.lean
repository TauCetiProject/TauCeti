module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Coinvariants.Quotient

/-!
# The Takeuchi Galois connection

Let `H` be a commutative Hopf algebra over a field `k`, the coordinate ring of an affine group
`G`. A Hopf subalgebra `B` of `H` generates the Hopf ideal `H·B⁺`, the kernel Hopf ideal of the
inclusion of `B`; it is normal. A normal Hopf ideal `I` has the Hopf subalgebra of right
coinvariants `H^{co H/I}`. These two maps form a Galois connection between Hopf subalgebras and
normal Hopf ideals, both ordered by inclusion: `H·B⁺ ≤ I ↔ B ≤ H^{co H/I}`. Geometrically, the
normal subgroup cut out by `H·B⁺` is the kernel of the quotient `G → Spec B`, and `H^{co H/I}` is
the coordinate ring of the quotient of `G` by the normal subgroup cut out by `I`.

The connection is `TauCeti.HopfIdeal.forall_hom_mem_coinvariants_iff` for the inclusion of `B`.
It holds for every commutative Hopf algebra over a field, with no finiteness hypothesis. Over a
field, flatness of every module is automatic, so every Hopf subalgebra is a commutative Hopf
algebra in its own right and every normal Hopf ideal has a Hopf subalgebra of coinvariants.

## Main declarations

* `TauCeti.CommHopfAlgCat.HopfSubalgebra`: the Hopf subalgebras of `H`, ordered by inclusion.
* `TauCeti.CommHopfAlgCat.NormalHopfIdeal`: the normal Hopf ideals of `H`, ordered by inclusion.
* `TauCeti.CommHopfAlgCat.HopfSubalgebra.kernelHopfIdeal`: `B ↦ H·B⁺`.
* `TauCeti.CommHopfAlgCat.NormalHopfIdeal.coinvariants`: `I ↦ H^{co H/I}`.
* `TauCeti.CommHopfAlgCat.gc_kernelHopfIdeal_coinvariants`: the Takeuchi Galois connection.

## References

* M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*, Manuscripta Math.
  **7** (1972), 251–270, §4.
* J. S. Milne, *Algebraic Groups* (2017), §5.c.
-/

public section

namespace TauCeti.CommHopfAlgCat

universe u v

variable {k : Type u} [Field k] (H : _root_.CommHopfAlgCat.{v} k)

/-- The Hopf subalgebras of a commutative Hopf algebra over a field, ordered by inclusion. -/
abbrev HopfSubalgebra : Type v :=
  {B : Subalgebra k H // B.IsHopfSubalgebra}

/-- The normal Hopf ideals of a commutative Hopf algebra over a field, ordered by inclusion. -/
abbrev NormalHopfIdeal : Type v :=
  {I : HopfIdeal k H // I.IsNormal}

variable {H}

/-- The normal Hopf ideal `H·B⁺` generated by the augmentation ideal of a Hopf subalgebra `B`:
the kernel Hopf ideal of the inclusion of `B`. -/
noncomputable def HopfSubalgebra.kernelHopfIdeal (B : HopfSubalgebra H) : NormalHopfIdeal H :=
  ⟨CommHopfAlgCat.kernelHopfIdeal (hopfSubalgebraι B.property), isNormal_kernelHopfIdeal _⟩

/-- The Hopf subalgebra `H^{co H/I}` of right coinvariants of a normal Hopf ideal `I`. -/
noncomputable def NormalHopfIdeal.coinvariants (I : NormalHopfIdeal H) : HopfSubalgebra H :=
  ⟨I.val.coinvariants, I.property.isHopfSubalgebra_coinvariants⟩

@[simp]
theorem HopfSubalgebra.coe_kernelHopfIdeal (B : HopfSubalgebra H) :
    (B.kernelHopfIdeal : HopfIdeal k H) =
      CommHopfAlgCat.kernelHopfIdeal (hopfSubalgebraι B.property) :=
  (rfl)

@[simp]
theorem NormalHopfIdeal.coe_coinvariants (I : NormalHopfIdeal H) :
    (I.coinvariants : Subalgebra k H) = I.val.coinvariants :=
  (rfl)

/-- **The Takeuchi Galois connection.** For a Hopf subalgebra `B` and a normal Hopf ideal `I` of a
commutative Hopf algebra `H` over a field, `H·B⁺ ≤ I` exactly when `B ≤ H^{co H/I}`. -/
theorem gc_kernelHopfIdeal_coinvariants :
    GaloisConnection (HopfSubalgebra.kernelHopfIdeal (H := H)) NormalHopfIdeal.coinvariants := by
  intro B I
  rw [← Subtype.coe_le_coe, ← Subtype.coe_le_coe, HopfSubalgebra.coe_kernelHopfIdeal,
    NormalHopfIdeal.coe_coinvariants, ← HopfIdeal.forall_hom_mem_coinvariants_iff]
  refine ⟨fun h x hx ↦ ?_, fun h x ↦ ?_⟩
  · have hx' := h ⟨x, hx⟩
    rwa [hopfSubalgebraι_apply] at hx'
  · rw [hopfSubalgebraι_apply]
    exact h x.property

end TauCeti.CommHopfAlgCat
