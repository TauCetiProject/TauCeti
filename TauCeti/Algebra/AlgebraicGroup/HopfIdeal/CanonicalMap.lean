/-!
# The canonical map over the coinvariants of a Hopf ideal

For a Hopf ideal `I` in a commutative Hopf algebra `H`, put `B = I.coinvariants`.
The canonical map

```text
H ⊗[B] H → H ⊗[R] (H / I),    a ⊗ b ↦ (a ⊗ 1) (id ⊗ π)(Δ b)
```

is an `H`-algebra homomorphism and is surjective. Geometrically, this says that
`(g, n) ↦ (g, gn)` is a closed immersion from `G × N` into
`G ×_{Spec B} G`. This supplies the surjectivity part of the canonical-map criterion
for a quotient torsor. Neither normality of `I` nor flatness over the base is needed here.

When `H` is flat,
`TauCeti.HopfIdeal.canonicalMap_injective_iff_toIdeal_eq_span_coinvariants_counit_eq_zero`
characterizes injectivity: the canonical map is injective exactly when `I` is generated by the
coinvariants on which the counit vanishes, that is, when `N` is the scheme-theoretic fibre of
`G → Spec B` over the identity. Faithful flatness of `H` over `B` is a separate question.

## References

* W. C. Waterhouse, *Introduction to Affine Group Schemes*, §16.3.
* M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*, Manuscripta Math.
  **7** (1972), 251–270.
-/

public section

open scoped TensorProduct
open Algebra.TensorProduct

namespace TauCeti.HopfIdeal

variable {R H : Type*} [CommSemiring R] [CommRing H] [HopfAlgebra R H]

/-- The quotient coaction regarded as a map over the coinvariant subalgebra. -/
private noncomputable def coinvariantCoaction (I : HopfIdeal R H) :
    H →ₐ[I.coinvariants] H ⊗[R] (H ⧸ I.toIdeal) where
  toRingHom := ((Algebra.TensorProduct.map (AlgHom.id R H) (Ideal.Quotient.mkₐ R I.toIdeal)).comp
    (Bialgebra.comulAlgHom R H)).toRingHom
  commutes' b := mem_coinvariants_iff.mp b.property

/-- The canonical map for a Hopf quotient, with the tensor product balanced over
the coinvariant subalgebra. It is linear over the first copy of `H`. -/
noncomputable def canonicalMap (I : HopfIdeal R H) :
    H ⊗[I.coinvariants] H →ₐ[H] H ⊗[R] (H ⧸ I.toIdeal) :=
  lift (Algebra.ofId H _) (coinvariantCoaction I) (fun _ _ ↦ .all _ _)

/-- On pure tensors the canonical map multiplies the left factor by the quotient
coaction of the right factor. -/
@[simp]
theorem canonicalMap_tmul (I : HopfIdeal R H) (a b : H) :
    I.canonicalMap (a ⊗ₜ[I.coinvariants] b) =
      (a ⊗ₜ[R] 1) * Algebra.TensorProduct.map (AlgHom.id R H) (Ideal.Quotient.mkₐ R I.toIdeal)
        (Coalgebra.comul (R := R) b) := by
  simp [canonicalMap, coinvariantCoaction]

/-- The absolute tensor-square map factors through balancing over the coinvariants.
Its other factorization is the tensor shear followed by the quotient in the second
factor. -/
theorem canonicalMap_comp_mapOfCompatibleSMul (I : HopfIdeal R H) :
    (I.canonicalMap.restrictScalars R).comp
        (mapOfCompatibleSMul I.coinvariants R R H H) =
      (Algebra.TensorProduct.map (AlgHom.id R H) (Ideal.Quotient.mkₐ R I.toIdeal)).comp
        (HopfAlgebra.tensorShearMulRight (R := R)).toAlgHom := by
  apply Algebra.TensorProduct.ext'
  intro a b
  simp

/-- The canonical map over the coinvariants of any Hopf ideal is surjective.
No normality or flatness hypothesis is required. -/
theorem canonicalMap_surjective (I : HopfIdeal R H) :
    Function.Surjective I.canonicalMap := by
  -- The algebra-map version requires a commutative ring base; the linear-map
  -- version applies to our commutative semiring base.
  have hmap : Function.Surjective
      (Algebra.TensorProduct.map (AlgHom.id R H) (Ideal.Quotient.mkₐ R I.toIdeal)) :=
    TensorProduct.map_surjective (g := (AlgHom.id R H).toLinearMap)
      (g' := (Ideal.Quotient.mkₐ R I.toIdeal).toLinearMap)
      Function.surjective_id Ideal.Quotient.mk_surjective
  have hcomp : Function.Surjective ((I.canonicalMap.restrictScalars R).comp
      (mapOfCompatibleSMul I.coinvariants R R H H)) := by
    rw [canonicalMap_comp_mapOfCompatibleSMul]
    exact hmap.comp (HopfAlgebra.tensorShearMulRight (R := R)).surjective
  exact Function.Surjective.of_comp (f := I.canonicalMap) hcomp

section Ring

variable {R H : Type*} [CommRing R] [CommRing H] [HopfAlgebra R H]

/-- A coinvariant right factor moves to the left across the tensor product balanced over the
coinvariants. -/
private theorem tmul_coe_eq_mul_tmul_one (I : HopfIdeal R H) (a : H) (β : I.coinvariants) :
    a ⊗ₜ[I.coinvariants] (β : H) = (a * β) ⊗ₜ[I.coinvariants] (1 : H) := by
  have h := TensorProduct.smul_tmul (R := I.coinvariants) β a (1 : H)
  simp only [Subalgebra.smul_def, smul_eq_mul, mul_one] at h
  rw [mul_comm, h]

/-- If the Hopf ideal `I` is generated by the coinvariants on which the counit vanishes, then the
canonical map is injective. -/
private theorem canonicalMap_injective_of_le_span [Module.Flat R H] (I : HopfIdeal R H)
    (hI : I.toIdeal ≤ Ideal.span {h | h ∈ I.coinvariants ∧ Coalgebra.counit (R := R) h = 0}) :
    Function.Injective I.canonicalMap := by
  set B := I.coinvariants
  let σ := HopfAlgebra.tensorShearMulRight (R := R) (H := H)
  let q := mapOfCompatibleSMul B R R H H
  -- Undoing the shear and balancing over `B` kills `H ⊗ I`.
  have hker : Ideal.rightTensorIdeal R H I.toIdeal ≤ RingHom.ker (q.comp σ.symm.toAlgHom) := by
    rw [Ideal.rightTensorIdeal_le_iff]
    refine hI.trans (Ideal.span_le.mpr ?_)
    rintro b ⟨hb, hb0⟩
    obtain ⟨w, hw⟩ := comul_mem_range_lTensor_of_mem_coinvariants hb
    have hq (y : H ⊗[R] B) : q ((HopfAlgebra.antipode R).rTensor H
        ((Subalgebra.toSubmodule B).subtype.lTensor H y)) =
        LinearMap.mul' R H ((HopfAlgebra.antipode R).rTensor H
          ((Subalgebra.toSubmodule B).subtype.lTensor H y)) ⊗ₜ[B] (1 : H) := by
      induction y with
      | add y z hy hz => simp only [map_add, hy, hz, TensorProduct.add_tmul]
      | tmul a β =>
        simp only [LinearMap.lTensor_tmul, LinearMap.rTensor_tmul, Submodule.subtype_apply,
          LinearMap.mul'_apply, q, mapOfCompatibleSMul_tmul]
        exact tmul_coe_eq_mul_tmul_one I _ β
    have hq' : q ((HopfAlgebra.antipode R).rTensor H (Coalgebra.comul (R := R) b)) =
        LinearMap.mul' R H ((HopfAlgebra.antipode R).rTensor H
          (Coalgebra.comul (R := R) b)) ⊗ₜ[B] (1 : H) := by
      rw [← hw]
      exact hq w
    apply Ideal.mem_comap.mpr
    apply RingHom.mem_ker.mpr
    rw [AlgHom.comp_apply]
    have hinclude : includeRight.toRingHom b = (1 : H) ⊗ₜ[R] b := by
      exact (congrFun (AlgHom.coe_toRingHom includeRight) b).trans
        (Algebra.TensorProduct.includeRight_apply (R := R) (A := H) b)
    rw [hinclude]
    simp only [AlgEquiv.coe_toAlgHom, σ]
    rw [HopfAlgebra.tensorShearMulRight_symm_tmul]
    rw [← Algebra.TensorProduct.one_def, one_mul]
    rw [← LinearMap.rTensor_def, hq', HopfAlgebra.mul_antipode_rTensor_comul_apply, hb0,
      map_zero, TensorProduct.zero_tmul]
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨y, rfl⟩ := mapOfCompatibleSMul_surjective B R R H H z
  have hy : σ y ∈ Ideal.rightTensorIdeal R H I.toIdeal := by
    rw [← Ideal.ker_tensorProduct_map_id_quotient, RingHom.mem_ker]
    have h := AlgHom.congr_fun (canonicalMap_comp_mapOfCompatibleSMul I) y
    rw [AlgHom.comp_apply, AlgHom.comp_apply] at h
    exact h.symm.trans hz
  simpa using hker hy

/-- If the canonical map is injective, then the Hopf ideal `I` is generated by the coinvariants
on which the counit vanishes. Geometrically, `N` is the fibre of `G → Spec B` over the identity. -/
private theorem le_span_of_canonicalMap_injective (I : HopfIdeal R H)
    (hinj : Function.Injective I.canonicalMap) :
    I.toIdeal ≤ Ideal.span {h | h ∈ I.coinvariants ∧ Coalgebra.counit (R := R) h = 0} := by
  set B := I.coinvariants
  set J := Ideal.span {h | h ∈ B ∧ Coalgebra.counit (R := R) h = 0}
  let σ := HopfAlgebra.tensorShearMulRight (R := R) (H := H)
  let q := mapOfCompatibleSMul B R R H H
  -- Restriction to the fibre over the identity, `H ⊗[B] H → k ⊗[B] H = H ⧸ J`.
  let ε : H →ₐ[B] H ⧸ J :=
    { toRingHom := ((Algebra.ofId R (H ⧸ J)).comp (Bialgebra.counitAlgHom R H)).toRingHom
      commutes' := fun β ↦ by
        have hβ : (β : H) - algebraMap R H (Coalgebra.counit (R := R) (β : H)) ∈ J :=
          Ideal.subset_span ⟨B.sub_mem β.property (B.algebraMap_mem _), by simp⟩
        rw [← Ideal.Quotient.eq, Ideal.Quotient.mk_algebraMap] at hβ
        exact hβ.symm }
  let ν := lift ε (Ideal.Quotient.mkₐ B J) (fun _ _ ↦ .all _ _)
  have hν_tmul (a b : H) : ν (a ⊗ₜ[B] b) =
      algebraMap R (H ⧸ J) (Coalgebra.counit (R := R) a) * Ideal.Quotient.mk J b := by
    simp only [ν, lift_tmul, Ideal.Quotient.mkₐ_eq_mk, ε, AlgHom.coe_mk, AlgHom.toRingHom_eq_coe,
      AlgHom.coe_toRingHom, AlgHom.comp_apply, Bialgebra.counitAlgHom_apply, Algebra.ofId_apply]
  intro x hx
  have hν (y : H ⊗[R] H) : ν (q (TensorProduct.map (HopfAlgebra.antipode R) LinearMap.id y)) =
      Ideal.Quotient.mk J (TensorProduct.lid R H ((Coalgebra.counit (R := R)).rTensor H y)) := by
    induction y with
    | add y z hy hz => simp only [map_add, hy, hz]
    | tmul a b =>
      simp only [TensorProduct.map_tmul, LinearMap.id_apply, q, mapOfCompatibleSMul_tmul, hν_tmul,
        HopfAlgebra.counit_antipode, LinearMap.rTensor_tmul, TensorProduct.lid_tmul,
        Algebra.smul_def, map_mul, Ideal.Quotient.mk_algebraMap]
  have h0 : q (σ.symm (1 ⊗ₜ[R] x)) = 0 := by
    apply hinj
    have h := AlgHom.congr_fun (canonicalMap_comp_mapOfCompatibleSMul I) (σ.symm (1 ⊗ₜ[R] x))
    rw [AlgHom.comp_apply, AlgHom.comp_apply] at h
    refine h.trans ?_
    rw [AlgEquiv.toAlgHom_apply, AlgEquiv.apply_symm_apply, map_zero,
      Algebra.TensorProduct.map_tmul, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.mpr hx, TensorProduct.tmul_zero]
  have h1 := congrArg ν h0
  simp only [σ, HopfAlgebra.tensorShearMulRight_symm_tmul, ← Algebra.TensorProduct.one_def,
    one_mul, hν, Coalgebra.rTensor_counit_comul, TensorProduct.lid_tmul, one_smul,
    map_zero] at h1
  exact Ideal.Quotient.eq_zero_iff_mem.mp h1

/-- **The canonical map is injective exactly when `I` is generated by its invariant functions.**
Over a flat Hopf algebra, `H ⊗[B] H → H ⊗[R] (H ⧸ I)` is injective if and only if `I` is generated,
as an ideal, by the coinvariants on which the counit vanishes. Geometrically, `G × N` is all of
`G ×_{Spec B} G` exactly when `N` is the scheme-theoretic fibre of `G → Spec B` over the identity.
-/
theorem canonicalMap_injective_iff_toIdeal_eq_span_coinvariants_counit_eq_zero [Module.Flat R H]
    (I : HopfIdeal R H) :
    Function.Injective I.canonicalMap ↔
      I.toIdeal = Ideal.span {h | h ∈ I.coinvariants ∧ Coalgebra.counit (R := R) h = 0} :=
  ⟨fun h ↦ le_antisymm (le_span_of_canonicalMap_injective I h)
      (span_coinvariants_counit_eq_zero_le I),
    fun h ↦ canonicalMap_injective_of_le_span I h.le⟩

end Ring

end TauCeti.HopfIdeal
