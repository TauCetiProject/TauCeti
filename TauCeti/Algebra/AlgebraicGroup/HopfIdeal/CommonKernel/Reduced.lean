module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Basic
public import TauCeti.Algebra.AlgebraicGroup.Smooth.CommHopfAlgCat
public import Mathlib.FieldTheory.IsAlgClosed.Basic
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Reduction
import TauCeti.Algebra.AlgebraicGroup.Smooth.AlgebraicallyClosed
import TauCeti.RingTheory.FiniteType.Tensor.Product

/-!
# Reducedness of closed subgroups generated by reduced group schemes

The closed subgroup scheme generated by affine group schemes is the common-kernel Hopf quotient:
the largest Hopf ideal killed by all generator maps. If its coordinate ring had a nilpotent, its
reduction would give a further Hopf ideal killed by the same maps, contradicting that maximality.

The reduction is a Hopf ideal whenever the tensor square of the reduced quotient is reduced. Over
an algebraically closed field, finite type supplies this tensor condition automatically. The
result applies to root-subgroup and torus generators in constructions of split reductive groups.
In that setting reducedness also makes the generated subgroup scheme smooth.

## References

* W. C. Waterhouse, *Introduction to Affine Group Schemes*, §11.4.
* J. S. Milne, *Algebraic Groups* (2017), §1.f.
-/

public section

open scoped TensorProduct

namespace TauCeti.CommHopfAlgCat

universe u v w

variable {R : Type u} [CommRing R] [IsReduced R]
variable {H : _root_.CommHopfAlgCat.{v} R}
variable {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} R}

/-- **The common-kernel Hopf quotient is reduced** when every generator algebra is reduced and
the tensor square of the quotient's reduction is reduced. The tensor condition makes the
nilradical a Hopf ideal, to which the common-kernel universal property applies. -/
theorem isReduced_quotient_commonKernelHopfIdeal_of_reduced_tensor (f : ∀ i, H ⟶ K i)
    [IsReduced (((quotient H (commonKernelHopfIdeal f) ⧸
      nilradical (quotient H (commonKernelHopfIdeal f))) ⊗[R]
      (quotient H (commonKernelHopfIdeal f) ⧸
        nilradical (quotient H (commonKernelHopfIdeal f)))))]
    [∀ i, IsReduced (K i)] :
    IsReduced (quotient H (commonKernelHopfIdeal f)) := by
  let Q := quotient H (commonKernelHopfIdeal f)
  let I := HopfIdeal.reduction R Q
  have hI : I ≤ commonKernelHopfIdeal (commonKernelLift f) := by
    apply (le_commonKernelHopfIdeal_iff _ _).mpr
    intro i x hx
    apply RingHom.mem_ker.mpr
    exact ((HopfIdeal.mem_reduction R Q).mp hx).map (commonKernelLift f i).hom |>.eq_zero
  have hbot : I = ⊥ :=
    eq_bot_iff.mpr (hI.trans (le_of_eq (commonKernelHopfIdeal_commonKernelLift_eq_bot f)))
  apply (nilradical_eq_bot_iff (R := Q)).mp
  calc
    nilradical Q = I.toIdeal := (HopfIdeal.reduction_toIdeal R Q).symm
    _ = ⊥ := by rw [hbot, HopfIdeal.bot_toIdeal]

/-- **A subgroup scheme generated by reduced affine group schemes is reduced** over an
algebraically closed field. The ambient coordinate algebra is of finite type; the generators
need not be of finite type. -/
theorem isReduced_quotient_commonKernelHopfIdeal
    {k : Type u} [Field k] [IsAlgClosed k]
    {H : _root_.CommHopfAlgCat.{v} k} [Algebra.FiniteType k H]
    {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} k}
    (f : ∀ i, H ⟶ K i) [∀ i, IsReduced (K i)] :
    IsReduced (quotient H (commonKernelHopfIdeal f)) := by
  let Q := quotient H (commonKernelHopfIdeal f)
  let _ : Algebra.FiniteType k Q := inferInstance
  let _ : Algebra.FiniteType k (Q ⧸ nilradical Q) := inferInstance
  let _ : IsReduced (Q ⧸ nilradical Q) :=
    (Ideal.isRadical_iff_quotient_reduced _).mp (Ideal.radical_isRadical ⊥)
  exact isReduced_quotient_commonKernelHopfIdeal_of_reduced_tensor f

/-- **A subgroup scheme generated by reduced affine group schemes is smooth** when its
coordinate algebra is of finite type over an algebraically closed field. -/
theorem smooth_quotient_commonKernelHopfIdeal
    {k : Type u} [Field k] [IsAlgClosed k]
    {H : _root_.CommHopfAlgCat.{v} k} [Algebra.FiniteType k H]
    {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} k}
    (f : ∀ i, H ⟶ K i) [∀ i, IsReduced (K i)] :
    smoothCommHopfAlgProperty k (quotient H (commonKernelHopfIdeal f)) := by
  let _ : IsReduced (quotient H (commonKernelHopfIdeal f)) :=
    isReduced_quotient_commonKernelHopfIdeal f
  exact smoothCommHopfAlgProperty_of_isAlgClosed_of_isReduced k _

end TauCeti.CommHopfAlgCat
