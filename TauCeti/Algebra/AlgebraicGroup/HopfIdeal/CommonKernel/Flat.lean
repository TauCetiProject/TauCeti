module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Basic
public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.ScalarTorsion
public import Mathlib.RingTheory.Flat.TorsionFree

/-!
# Flatness of subgroups generated by flat affine group schemes

Over a Dedekind domain the common-kernel quotient of scalar-torsion-free coordinate algebras
is scalar-torsion-free, hence flat. Its scalar-torsion Hopf ideal is killed by every lifted
generator map and therefore lies in their common kernel, which is zero.

In particular an integral carrier generated by additive root subgroups and a split torus is
flat over `ℤ`. No reducedness or smoothness of its special fibers follows from this alone.

## References

* The Stacks Project, [Tag 0AUW](https://stacks.math.columbia.edu/tag/0AUW), for flatness
  of torsion-free modules over Dedekind domains.

The maximality argument parallels `TauCeti.CommHopfAlgCat.isReduced_quotient_commonKernelHopfIdeal`;
the Hopf ideal used here is `TauCeti.HopfIdeal.scalarTorsion`.
-/

public section

open scoped TensorProduct nonZeroDivisors

namespace TauCeti.CommHopfAlgCat

universe u v w

variable {R : Type u} [CommRing R] [IsDedekindDomain R]
variable {H : _root_.CommHopfAlgCat.{v} R}
variable {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} R}

/-- A subgroup scheme generated by scalar-torsion-free affine group schemes over a Dedekind
domain has scalar-torsion-free coordinate algebra. Consequently it is flat over the base. -/
instance isTorsionFree_quotient_commonKernelHopfIdeal
    (f : ∀ i, H ⟶ K i) [∀ i, Module.IsTorsionFree R (K i)] :
    Module.IsTorsionFree R (quotient H (commonKernelHopfIdeal f)) := by
  let Q := quotient H (commonKernelHopfIdeal f)
  let T := HopfIdeal.scalarTorsion R Q
  have hT : T = ⊥ := by
    apply le_antisymm ?_ bot_le
    rw [← commonKernelHopfIdeal_commonKernelLift_eq_bot f]
    apply (le_commonKernelHopfIdeal_iff (commonKernelLift f) T).mpr
    intro i x hx
    rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
      BialgHom.coe_toAlgHom]
    obtain ⟨r, hr⟩ := (HopfIdeal.mem_scalarTorsion R Q).mp hx
    apply (smul_eq_zero_iff_right (nonZeroDivisors.coe_ne_zero r)).mp
    simpa only [Submonoid.smul_def, map_smul, map_zero] using
      congrArg (commonKernelLift f i).hom hr
  rw [Submodule.isTorsionFree_iff_torsion_eq_bot]
  have hI : scalarTorsionIdeal R Q = ⊥ := by
    simpa only [T, HopfIdeal.scalarTorsion_toIdeal, HopfIdeal.bot_toIdeal] using
      congrArg HopfIdeal.toIdeal hT
  rw [← scalarTorsionIdeal_restrictScalars, hI]
  rfl

end TauCeti.CommHopfAlgCat
