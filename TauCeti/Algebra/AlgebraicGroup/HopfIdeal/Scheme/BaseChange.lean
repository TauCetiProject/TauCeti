module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Scheme.Classification
public import TauCeti.AlgebraicGeometry.AffineGroupScheme.BaseChange.Coordinate
public import TauCeti.AlgebraicGeometry.GroupScheme.ClosedSubgroup.BaseChange

/-!
# Base change of the closed subgroup scheme cut out by a Hopf ideal

Let `H` be a commutative Hopf algebra over a commutative ring `R` and `I` a Hopf ideal of `H`, so
that `Spec (H ⧸ I)` is a closed subgroup scheme of `Spec H`
(`TauCeti.CommHopfAlgCat.quotientClosedSubgroup`). For an `R`-algebra `S`, the base change of
`Spec H` along `Spec S ⟶ Spec R` is `Spec (S ⊗[R] H)`
(`TauCeti.AffineGroupSchemeCat.hopfSpecBaseChangeGrpIso`). This file proves that, under this
identification, the base change of `Spec (H ⧸ I)` is the closed subgroup scheme of
`Spec (S ⊗[R] H)` cut out by the base change `I_S` of `I`, the ideal generated by `1 ⊗ I`
(`TauCeti.CommHopfAlgCat.baseChangeHopfIdeal`).

## Main results

* `TauCeti.CommHopfAlgCat.mapIso_baseChange_quotientClosedSubgroup`: the base change of the closed
  subgroup scheme cut out by `I` is the closed subgroup scheme cut out by `I_S`.

## References

* W. C. Waterhouse, *Introduction to Affine Group Schemes* (Springer, 1979), §2.1 and §16, for
  closed subgroup schemes of affine group schemes as quotients by Hopf ideals.
* J. S. Milne, *Algebraic Groups* (2017), §1.f, for base change of affine group schemes.
-/

public section

open _root_.CommHopfAlgCat CategoryTheory AlgebraicGeometry Opposite

namespace TauCeti.CommHopfAlgCat

universe u

variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]

/-- **Base change of the closed subgroup scheme cut out by a Hopf ideal.** For a Hopf ideal `I` of
`H` and an `R`-algebra `S`, the base change of the closed subgroup scheme `Spec (H ⧸ I)` of
`Spec H` along `Spec S ⟶ Spec R` is, under the identification of the base change of `Spec H` with
`Spec (S ⊗[R] H)`, the closed subgroup scheme cut out by the base change of `I`. -/
theorem mapIso_baseChange_quotientClosedSubgroup (H : _root_.CommHopfAlgCat.{u} R)
    (I : HopfIdeal R H) :
    ClosedSubgroupScheme.mapIso (AffineGroupSchemeCat.hopfSpecBaseChangeGrpIso (S := S) H)
        ((quotientClosedSubgroup H I).baseChange
          (Spec.map (CommRingCat.ofHom (algebraMap R S)))) =
      quotientClosedSubgroup (baseChange (K := S) H) (baseChangeHopfIdeal (K := S) I) := by
  rw [quotientClosedSubgroup_def, ClosedSubgroupScheme.baseChange_mk,
    ClosedSubgroupScheme.mapIso_mk,
    mk_eq_quotientClosedSubgroup_kerOfSurjective (baseChange (K := S) H)
      (baseChange (K := S) (quotient H I)) _
      (AffineGroupSchemeCat.hopfSpecBaseChangeGrpIso (S := S) (quotient H I)).symm
      (baseChangeMap (K := S) (mkQuotient H I))
      (baseChangeMap_surjective _ (mkQuotient_surjective H I)) (by
        rw [Iso.symm_hom, quotientSpecι_def,
          AffineGroupSchemeCat.hopfSpecBaseChangeGrpIso_hom_naturality, Iso.inv_hom_id_assoc])]
  congr 1
  ext y
  rw [HopfIdeal.mem_kerOfSurjective, mem_baseChangeHopfIdeal_iff]

end TauCeti.CommHopfAlgCat
