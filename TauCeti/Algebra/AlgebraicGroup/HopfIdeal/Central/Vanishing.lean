module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Central.Basic
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Vanishing
import TauCeti.RingTheory.FiniteType.PointSeparation
import TauCeti.RingTheory.TensorProduct.PointSeparation

/-!
# Closures of central subgroups of rational points

Over an algebraically closed field, the closed subgroup generated by a subgroup `S` of the
rational points of a reduced finite-type affine group is central exactly when `S` lies in the
center of the abstract group of rational points. Centrality of a closed subgroup is a
scheme-theoretic condition, quantified over all value algebras; reducedness of the ambient group
and of the closure lets point separation reduce it to commutation of rational points.

## Main declarations

* `TauCeti.HopfIdeal.isCentral_vanishingIdeal_iff`: the closure of `S` is central exactly when
  `S` is contained in the center of the group of rational points.

## References

* J. S. Milne, *Algebraic Groups* (2017), §1.k and §2, for central subgroups.
* W. C. Waterhouse, *Introduction to Affine Group Schemes*, §4, for closures of subgroups of
  rational points.
-/

public section

open WithConv
open scoped TensorProduct

namespace TauCeti.HopfIdeal

variable {k H : Type*} [Field k] [CommRing H] [_root_.HopfAlgebra k H]

/-- **The closure of a central subgroup of rational points is central.** For a reduced
finite-type affine group over an algebraically closed field, the closed subgroup generated by a
subgroup `S` of rational points is central exactly when `S` lies in the center of the group of
rational points. -/
theorem isCentral_vanishingIdeal_iff [IsAlgClosed k] [Algebra.FiniteType k H] [IsReduced H]
    (S : Subgroup (WithConv (H →ₐ[k] k))) :
    (vanishingIdeal S).IsCentral ↔ S ≤ Subgroup.center (WithConv (H →ₐ[k] k)) := by
  let G := _root_.CommHopfAlgCat.of k H
  let J := vanishingIdeal S
  -- Each point of `S` factors through the closure.
  have hS (s : S) : ∀ y : H, y ∈ J → s.val.ofConv y = 0 :=
    fun y hy ↦ (mem_vanishingIdeal S y).mp hy s
  let ev (s : S) := (CommHopfAlgCat.liftQuotientPoint G J (CommAlgCat.of k k) s.val (hS s)).ofConv
  have hev (s : S) (y : H) : ev s (Ideal.Quotient.mk J.toIdeal y) = s.val.ofConv y :=
    CommHopfAlgCat.liftQuotientPoint_mk G J (CommAlgCat.of k k) s.val (hS s) y
  constructor
  · -- A point of a central closed subgroup is a central point, so it commutes with all points.
    intro hJ s hs
    refine Subgroup.mem_center_iff.mpr fun g ↦ ?_
    have hmem : s ∈ CommHopfAlgCat.quotientPointsSubgroup G J (CommAlgCat.of k k) :=
      (le_vanishingIdeal_iff S J).mp le_rfl hs
    exact ((CommHopfAlgCat.isCentralPoint_of_mem_quotientPointsSubgroup G J hJ
      (CommAlgCat.of k k) hmem).commute g).symm
  · -- Conversely, test the centrality condition on products of points of `S` and of `G`.
    intro hcenter
    rw [isCentral_iff_conjugation_sub_mem]
    intro x
    rw [← Ideal.ker_tensorProduct_map_quotient_id J.toIdeal, RingHom.mem_ker]
    refine tensor_eq_zero_of_forall_productMap_eq_zero ev (fun g : H →ₐ[k] k ↦ g)
      (eq_zero_of_forall_liftQuotientPoint_apply_eq_zero S)
      (fun y hy ↦ eq_of_forall_algHom_apply_eq (k := k) (K := k) fun g ↦ by simpa using hy g)
      _ fun s g ↦ ?_
    have hcomp : (Algebra.TensorProduct.productMap (ev s) g).comp
        (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k J.toIdeal) (AlgHom.id k H)) =
          Algebra.TensorProduct.productMap s.val.ofConv g := by
      ext y <;> simp [hev]
    have hconj : s.val * toConv g * s.val⁻¹ = toConv g := by
      rw [((Subgroup.mem_center_iff.mp (hcenter s.property)) (toConv g)).symm, mul_inv_cancel_right]
    rw [← AlgHom.comp_apply, hcomp, map_sub, ← AlgHom.comp_apply,
      HopfAlgebra.productMap_comp_conjugationAlgHom s.val (toConv g), hconj]
    simp

end TauCeti.HopfIdeal
