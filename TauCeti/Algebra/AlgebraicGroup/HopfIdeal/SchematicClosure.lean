module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange
public import TauCeti.RingTheory.Ideal.SchematicClosure

/-!
# The schematic closure of a base-changed Hopf ideal

Let `O` be a domain with fraction field `K`, `H` a commutative Hopf `O`-algebra and `J` a Hopf
ideal of `H` whose quotient `H ⧸ J` is torsion-free over `O`, that is, an `O`-flat closed subgroup
scheme when `O` is a discrete valuation ring. Then the schematic closure in `Spec H` of its generic
fibre `V(K ⊗ J)` is `V(J)` again: the closure ideal `(K ⊗ J)^♮ = H ∩ (K ⊗ J)` is `J`. This is the
uniqueness of the flat closure (`TauCeti.SchematicClosure.closure_unique`) applied to the base
change `TauCeti.CommHopfAlgCat.baseChangeHopfIdeal`, whose underlying ideal is generated by
`1 ⊗ J` (`TauCeti.CommHopfAlgCat.baseChangeHopfIdeal_toIdeal`).

## Main declarations

* `TauCeti.CommHopfAlgCat.closureIdeal_baseChangeHopfIdeal`: `(K ⊗ J)^♮ = J` when `H ⧸ J` is
  torsion-free over `O`.

## References

* F. Bruhat and J. Tits, *Groupes réductifs sur un corps local. II*, Publ. Math. IHÉS 60 (1984),
  1.2.6–1.2.7, pp. 17–18.
-/

public section

namespace TauCeti.CommHopfAlgCat

universe u v w

variable {O : Type u} {K : Type w} [CommRing O] [CommRing K] [Algebra O K] [IsFractionRing O K]
  {H : _root_.CommHopfAlgCat.{v} O}

/-- **The schematic closure of the generic fibre of a flat closed subgroup is itself.** If `H ⧸ J`
is torsion-free over `O`, then the closure ideal of the base change `K ⊗ J` is `J`. -/
theorem closureIdeal_baseChangeHopfIdeal (J : HopfIdeal O H)
    [Module.IsTorsionFree O (H ⧸ J.toIdeal)] :
    SchematicClosure.closureIdeal K (baseChangeHopfIdeal (K := K) J).toIdeal = J.toIdeal :=
  (SchematicClosure.closure_unique (baseChangeHopfIdeal_toIdeal J).symm).symm

end TauCeti.CommHopfAlgCat
