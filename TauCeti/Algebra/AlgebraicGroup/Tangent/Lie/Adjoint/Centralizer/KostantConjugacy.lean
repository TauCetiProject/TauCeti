/-!
# Group-level Kostant conjugacy at fixed nilpositive element

Let `G = Spec H` be an affine group over a field `k` of characteristic zero, and write
`𝔤 = Module.Dual k (Bialgebra.CotangentSpace k H)` for its Lie algebra. For any `e ∈ 𝔤`, the first
step `ker (ad e) ⊓ [e, 𝔤]` of Kostant's centralizer filtration generates the subgroup
`TauCeti.expAdSubgroup k e` of linear automorphisms `exp (ad y)`.

Because every `y ∈ ker (ad e) ⊓ [e, 𝔤]` is a bracket `⁅e, z⁆` commuting with `e`, Jacobson's lemma
applied to the differentiated representation (`LieHom.isNilpotent_apply_of_mem_ker_inf_range`)
shows that `y` acts nilpotently in *every* finite-dimensional representation of `G` — without any
semisimplicity, Killing-form, or finite-type hypothesis on `G` or `𝔤`. Consequently:

* the left-invariant vector field of `y` is locally nilpotent on `H`;
* when `𝔤` is finite-dimensional, its exponential point is a unipotent `k`-point of the centralizer
  `C_G(e)` (and of its identity component `C_G(e)°` when `k` is algebraically closed and `G` is of
  finite type) acting on `𝔤` by `exp (ad y)`;
* `TauCeti.expAdSubgroup k e` is realized inside `Ad(C_G(e)(k))` (and `Ad(C_G(e)°(k))` when `k` is
  algebraically closed and `G` is of finite type) by products of unipotent points;
* any two `sl₂` triples `(h, e, f)` and `(h', e, f')` in `𝔤` sharing their nilpositive element `e`
  are conjugate by an element of the subgroup generated by unipotent `k`-points of `C_G(e)` (and
  of `C_G(e)°` when `k` is algebraically closed and `G` is of finite type).

Together with
`IsSl2Triple.exists_mem_quotientPointsSubgroup_identityComponent_basePointsRepresentation_eq`
(conjugacy at fixed neutral element `h` in `C_G(h)°`), this provides both group-level centralizer
conjugacy theorems for `sl₂` triples in `Lie(G)`.

## Main declarations

* `TauCeti.isNilpotent_differential_of_mem_ker_inf_range` and
  `TauCeti.exists_iterate_leftInvariantDerivation_of_mem_ker_inf_range`: elements of
  `ker (ad e) ⊓ [e, 𝔤]` act nilpotently on all finite-dimensional `G`-comodules and have locally
  nilpotent left-invariant derivations on `H`.
* `TauCeti.expAdSubgroup_le_map_closure_centralizerHopfIdeal_isUnipotentPoint` and
  `TauCeti.expAdSubgroup_le_map_closure_identityComponent_isUnipotentPoint`: `expAdSubgroup k e`
  lies in the adjoint image of the subgroup generated by unipotent `k`-points of `C_G(e)` (and of
  `C_G(e)°` over an algebraically closed field).
* `IsSl2Triple.exists_mem_closure_centralizerHopfIdeal_e_basePointsRepresentation_eq` and
  `IsSl2Triple.exists_mem_centralizerHopfIdeal_e_basePointsRepresentation_eq`: group-level Kostant
  conjugacy at fixed `e` in `C_G(e)(k)` over any field of characteristic zero.
* `IsSl2Triple.exists_mem_closure_identityComponent_e_basePointsRepresentation_eq` and
  `IsSl2Triple.exists_mem_identityComponent_e_basePointsRepresentation_eq`: group-level Kostant
  conjugacy at fixed `e` in `C_G(e)°(k)` over an algebraically closed field of characteristic zero.

## References

* B. Kostant, *The principal three-dimensional subgroup and the Betti numbers of a complex simple
  Lie group*, Amer. J. Math. **81** (1959), 973–1032, §3.
* D. H. Collingwood and W. M. McGovern, *Nilpotent Orbits in Semisimple Lie Algebras*, Van
  Nostrand Reinhold (1993), Theorem 3.4.10.
-/

public section

open WithConv

namespace TauCeti

open Derivation

universe u v

section Nilpotence

variable {k H : Type u} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]

attribute [local instance 100] LieRing.ofAssociativeRing

/-- Over a field of characteristic zero, every `y ∈ ker (ad e) ⊓ [e, 𝔤]` acts nilpotently in the
differentiated representation on every finite-dimensional `H`-comodule `M`. No Killing-form,
reductivity, or finite-type assumption on `G` is required. -/
theorem isNilpotent_differential_of_mem_ker_inf_range
    {M : Type v} [AddCommGroup M] [Module k M] [Comodule k H M] [Module.Finite k M]
    {e y : Module.Dual k (Bialgebra.CotangentSpace k H)}
    (hye : y ∈ LinearMap.ker
        (LieAlgebra.ad k (Module.Dual k (Bialgebra.CotangentSpace k H)) e) ⊓
      LinearMap.range
        (LieAlgebra.ad k (Module.Dual k (Bialgebra.CotangentSpace k H)) e)) :
    IsNilpotent (Comodule.differential (R := k) (H := H) (M := M)
      (cotangentDualLieEquiv (R := k) (H := H) y)) := by
  simpa using
    ((Comodule.differential (R := k) (H := H) (M := M)).comp
      (cotangentDualLieEquiv (R := k) (H := H)).toLieHom).isNilpotent_apply_of_mem_ker_inf_range
      hye

/-- Over a field of characteristic zero, for any affine group `G = Spec H` and
`y ∈ ker (ad e) ⊓ [e, 𝔤]`, the left-invariant vector field of `y` is locally nilpotent on `H`. -/
theorem exists_iterate_leftInvariantDerivation_of_mem_ker_inf_range
    {e y : Module.Dual k (Bialgebra.CotangentSpace k H)}
    (hye : y ∈ LinearMap.ker
        (LieAlgebra.ad k (Module.Dual k (Bialgebra.CotangentSpace k H)) e) ⊓
      LinearMap.range
        (LieAlgebra.ad k (Module.Dual k (Bialgebra.CotangentSpace k H)) e)) :
    ∀ h : H, ∃ m,
      (Bialgebra.leftInvariantDerivation (cotangentDualLieEquiv (R := k) (H := H) y))^[m] h = 0 :=
  exists_iterate_leftInvariantDerivation_eq_zero_of_forall_fgComodule
    (cotangentDualLieEquiv (R := k) (H := H) y)
    fun M => isNilpotent_differential_of_mem_ker_inf_range (M := M) hye

end Nilpotence

section CharZero

variable {k H : Type u} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]
  [Module.Finite k (Bialgebra.CotangentSpace k H)]

attribute [local instance] adjointComodule

/-- If a subgroup `Γ ≤ G(k)` contains the exponential point of every tangent vector in
`Lie(C_G(e))` whose left-invariant derivation is locally nilpotent, then `expAdSubgroup k e` lies
in the adjoint image of the subgroup generated by unipotent elements of `Γ`. -/
private theorem expAdSubgroup_le_map_closure_sep_isUnipotentPoint
    [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))]
    (e : Module.Dual k (Bialgebra.CotangentSpace k H))
    {Γ : Subgroup (WithConv (H →ₐ[k] k))}
    (hΓ : ∀ (d : Derivation k H (Bialgebra.CounitAlgebra k H k))
        (_ : d ∈ (centralizerHopfIdeal H e).lieSubalgebra (B := k))
        (hd : ∀ h : H, ∃ n, (Bialgebra.leftInvariantDerivation d)^[n] h = 0),
      letI : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
      toConv (Bialgebra.expPoint d hd) ∈ Γ) :
    expAdSubgroup k e ≤
      (Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ Γ ∧ HopfAlgebra.IsUnipotentPoint u}).map
        ((LinearMap.GeneralLinearGroup.generalLinearEquiv k
          (Module.Dual k (Bialgebra.CotangentSpace k H))).toMonoidHom.comp
          (Representation.asGroupHom (Comodule.basePointsRepresentation
            (Module.Dual k (Bialgebra.CotangentSpace k H))))) := by
  let : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
  refine expAdSubgroup_le_iff.mpr fun y hy hye => ?_
  have hd := exists_iterate_leftInvariantDerivation_of_mem_ker_inf_range (H := H) hye
  have hdI := cotangentDualLieEquiv_mem_lieSubalgebra_centralizerHopfIdeal_of_mem_ker (H := H)
    (Submodule.mem_inf.mp hye).left
  refine ⟨toConv (Bialgebra.expPoint (cotangentDualLieEquiv (R := k) (H := H) y) hd),
    Subgroup.subset_closure ⟨hΓ _ hdI hd,
      HopfAlgebra.isUnipotentPoint_expPoint _ hd fun M =>
        isNilpotent_differential_of_mem_ker_inf_range (M := M) hye⟩, ?_⟩
  rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    asGroupHom_basePointsRepresentation_expPoint (R := k) (H := H) hy hd]
  ext z
  simp

/-- **Group realization of `expAdSubgroup` in `C_G(e)(k)`.** Over a field `k` of characteristic
zero, Kostant's subgroup `TauCeti.expAdSubgroup k e` lies in the adjoint image of the subgroup
generated by unipotent `k`-points of `C_G(e)`. -/
theorem expAdSubgroup_le_map_closure_centralizerHopfIdeal_isUnipotentPoint
    [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))]
    (e : Module.Dual k (Bialgebra.CotangentSpace k H)) :
    expAdSubgroup k e ≤
      (Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ CommHopfAlgCat.quotientPointsSubgroup (_root_.CommHopfAlgCat.of k H)
          (centralizerHopfIdeal H e) (CommAlgCat.of k k) ∧
        HopfAlgebra.IsUnipotentPoint u}).map
        ((LinearMap.GeneralLinearGroup.generalLinearEquiv k
          (Module.Dual k (Bialgebra.CotangentSpace k H))).toMonoidHom.comp
          (Representation.asGroupHom (Comodule.basePointsRepresentation
            (Module.Dual k (Bialgebra.CotangentSpace k H))))) :=
  expAdSubgroup_le_map_closure_sep_isUnipotentPoint e fun _ hdI hd => by
    let : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
    exact (centralizerHopfIdeal H e).toConv_expPoint_mem_quotientPointsSubgroup hdI hd

end CharZero

section AlgClosed

variable {k : Type u} [Field k] [CharZero k] [IsAlgClosed k]
  {H : FiniteTypeCommHopfAlgCat.{u, u} k}

attribute [local instance] adjointComodule

/-- **Group realization of `expAdSubgroup` in `C_G(e)°(k)`.** Over an algebraically closed field
`k` of characteristic zero, Kostant's subgroup `TauCeti.expAdSubgroup k e` lies in the adjoint
image of the subgroup generated by unipotent `k`-points of the connected centralizer `C_G(e)°`. -/
theorem expAdSubgroup_le_map_closure_identityComponent_isUnipotentPoint
    [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))]
    (e : Module.Dual k (Bialgebra.CotangentSpace k H)) :
    expAdSubgroup k e ≤
      (Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
          (centralizerHopfIdeal H e).identityComponent (CommAlgCat.of k k) ∧
        HopfAlgebra.IsUnipotentPoint u}).map
        ((LinearMap.GeneralLinearGroup.generalLinearEquiv k
          (Module.Dual k (Bialgebra.CotangentSpace k H))).toMonoidHom.comp
          (Representation.asGroupHom (Comodule.basePointsRepresentation
            (Module.Dual k (Bialgebra.CotangentSpace k H))))) :=
  expAdSubgroup_le_map_closure_sep_isUnipotentPoint e fun _ hdI hd => by
    let : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
    rw [← Bialgebra.expPointAt_one]
    exact (centralizerHopfIdeal H e).expPointAt_mem_quotientPointsSubgroup_identityComponent
      hdI hd (1 : k)

end AlgClosed

end TauCeti

namespace IsSl2Triple

open TauCeti

universe u

section CharZero

variable {k H : Type u} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]
  [Module.Finite k (Bialgebra.CotangentSpace k H)]
  {h e f h' f' : Module.Dual k (Bialgebra.CotangentSpace k H)}

attribute [local instance] Derivation.adjointComodule

/-- Lift Lie-level Kostant conjugacy of `sl₂` triples sharing `e` along any subgroup `Γ ≤ G(k)`
whose unipotent elements realize `expAdSubgroup k e`. -/
private theorem exists_mem_closure_sep_isUnipotentPoint_basePointsRepresentation_eq
    {Γ : Subgroup (WithConv (H →ₐ[k] k))}
    (hΓ : ∀ [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))],
      expAdSubgroup k e ≤
        (Subgroup.closure {u : WithConv (H →ₐ[k] k) |
          u ∈ Γ ∧ HopfAlgebra.IsUnipotentPoint u}).map
          ((LinearMap.GeneralLinearGroup.generalLinearEquiv k
            (Module.Dual k (Bialgebra.CotangentSpace k H))).toMonoidHom.comp
            (Representation.asGroupHom (Comodule.basePointsRepresentation
              (Module.Dual k (Bialgebra.CotangentSpace k H))))))
    (t : IsSl2Triple h e f) (t' : IsSl2Triple h' e f') :
    ∃ g ∈ Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ Γ ∧ HopfAlgebra.IsUnipotentPoint u},
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g h = h' ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g e = e ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g f =
          f' := by
  let _ : LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H)) :=
    TauCeti.ratLieAlgebra k _
  obtain ⟨φ, hφ, hφe, hφh, hφf⟩ := t.exists_lieEquiv_apply_eq (K := k) t'
  obtain ⟨g, hg, hgeq⟩ := hΓ hφ
  have happ (z : Module.Dual k (Bialgebra.CotangentSpace k H)) :
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g z =
        φ z := by
    simpa [Representation.asGroupHom_apply] using DFunLike.congr_fun hgeq z
  exact ⟨g, hg, (happ h).trans hφh, (happ e).trans hφe, (happ f).trans hφf⟩

/-- Weakening `exists_mem_closure_sep_isUnipotentPoint_basePointsRepresentation_eq` from the
unipotent closure inside `Γ` to `Γ` itself. -/
private theorem exists_mem_subgroup_basePointsRepresentation_eq
    {Γ : Subgroup (WithConv (H →ₐ[k] k))}
    (hΓ : ∀ [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))],
      expAdSubgroup k e ≤
        (Subgroup.closure {u : WithConv (H →ₐ[k] k) |
          u ∈ Γ ∧ HopfAlgebra.IsUnipotentPoint u}).map
          ((LinearMap.GeneralLinearGroup.generalLinearEquiv k
            (Module.Dual k (Bialgebra.CotangentSpace k H))).toMonoidHom.comp
            (Representation.asGroupHom (Comodule.basePointsRepresentation
              (Module.Dual k (Bialgebra.CotangentSpace k H))))))
    (t : IsSl2Triple h e f) (t' : IsSl2Triple h' e f') :
    ∃ g ∈ Γ,
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g h = h' ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g e = e ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g f =
          f' := by
  obtain ⟨g, hg, hh, he, hf⟩ :=
    t.exists_mem_closure_sep_isUnipotentPoint_basePointsRepresentation_eq (fun [_] => hΓ) t'
  exact ⟨g, Γ.closure_sep_le _ hg, hh, he, hf⟩

/-- **Kostant conjugacy at fixed nilpositive element by unipotent points of `C_G(e)`.** Over any
field `k` of characteristic zero, when `Lie(G)` is finite-dimensional, any two `sl₂` triples
`(h, e, f)` and `(h', e, f')` in `Lie(G)` sharing `e` are conjugate under the adjoint action of an
element in the subgroup generated by unipotent `k`-points of `C_G(e)`. -/
theorem exists_mem_closure_centralizerHopfIdeal_e_basePointsRepresentation_eq
    (t : IsSl2Triple h e f) (t' : IsSl2Triple h' e f') :
    ∃ g ∈ Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ CommHopfAlgCat.quotientPointsSubgroup (_root_.CommHopfAlgCat.of k H)
          (centralizerHopfIdeal H e) (CommAlgCat.of k k) ∧
        HopfAlgebra.IsUnipotentPoint u},
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g h = h' ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g e = e ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g f =
          f' :=
  t.exists_mem_closure_sep_isUnipotentPoint_basePointsRepresentation_eq
    (fun [_] => expAdSubgroup_le_map_closure_centralizerHopfIdeal_isUnipotentPoint (H := H) e) t'

/-- Any two `sl₂` triples `(h, e, f)` and `(h', e, f')` in `Lie(G)` sharing `e` are conjugate by a
rational point of `C_G(e)`. -/
theorem exists_mem_centralizerHopfIdeal_e_basePointsRepresentation_eq
    (t : IsSl2Triple h e f) (t' : IsSl2Triple h' e f') :
    ∃ g ∈ CommHopfAlgCat.quotientPointsSubgroup (_root_.CommHopfAlgCat.of k H)
        (centralizerHopfIdeal H e) (CommAlgCat.of k k),
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g h = h' ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g e = e ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g f =
          f' :=
  t.exists_mem_subgroup_basePointsRepresentation_eq
    (fun [_] => expAdSubgroup_le_map_closure_centralizerHopfIdeal_isUnipotentPoint (H := H) e) t'

end CharZero

section AlgClosed

variable {k : Type u} [Field k] [CharZero k] [IsAlgClosed k]
  {H : FiniteTypeCommHopfAlgCat.{u, u} k}
  {h e f h' f' : Module.Dual k (Bialgebra.CotangentSpace k H)}

attribute [local instance] Derivation.adjointComodule

/-- **Kostant conjugacy at fixed nilpositive element in `C_G(e)°` by unipotent points.** Over an
algebraically closed field `k` of characteristic zero, any two `sl₂` triples `(h, e, f)` and
`(h', e, f')` in `Lie(G)` sharing `e` are conjugate under the adjoint action of an element in the
subgroup generated by unipotent `k`-points of the connected centralizer `C_G(e)°`. -/
theorem exists_mem_closure_identityComponent_e_basePointsRepresentation_eq
    (t : IsSl2Triple h e f) (t' : IsSl2Triple h' e f') :
    ∃ g ∈ Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
          (centralizerHopfIdeal H e).identityComponent (CommAlgCat.of k k) ∧
        HopfAlgebra.IsUnipotentPoint u},
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g h = h' ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g e = e ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g f =
          f' :=
  t.exists_mem_closure_sep_isUnipotentPoint_basePointsRepresentation_eq
    (fun [_] => expAdSubgroup_le_map_closure_identityComponent_isUnipotentPoint (H := H) e) t'

/-- **Kostant conjugacy at fixed nilpositive element in `C_G(e)°`.** Over an algebraically closed
field `k` of characteristic zero, any two `sl₂` triples `(h, e, f)` and `(h', e, f')` in `Lie(G)`
sharing `e` are conjugate by a rational point of the connected centralizer `C_G(e)°` (requiring no
Killing-form or reductivity hypothesis on `G`). -/
theorem exists_mem_identityComponent_e_basePointsRepresentation_eq
    (t : IsSl2Triple h e f) (t' : IsSl2Triple h' e f') :
    ∃ g ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
        (centralizerHopfIdeal H e).identityComponent (CommAlgCat.of k k),
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g h = h' ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g e = e ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g f =
          f' :=
  t.exists_mem_subgroup_basePointsRepresentation_eq
    (fun [_] => expAdSubgroup_le_map_closure_identityComponent_isUnipotentPoint (H := H) e) t'

end AlgClosed

end IsSl2Triple
