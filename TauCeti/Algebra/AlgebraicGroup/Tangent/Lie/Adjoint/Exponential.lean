/-!
# Exponential points in the adjoint representation and lifting inner automorphisms

Let `G = Spec H` be an affine group of finite type over a field `k` of characteristic zero whose
tangent Lie algebra `𝔤` has nondegenerate Killing form. This file connects the Lie-algebraic
exponentials `exp (ad x)` (`TauCeti.expAd`) and the groups they generate (`TauCeti.intLieAlgebra`
and `TauCeti.expAdSubgroup`) to actual unipotent rational points of `G`, its identity component
`G°`, and the centralizers `C_G(e)` and `C_G(e)°`.

The key step is local nilpotence of the left-invariant derivation attached to an `ad`-nilpotent
element `x ∈ 𝔤`: embed `G` into some `GLₙ` via a finite-dimensional subcomodule `M` of the
regular comodule (`TauCeti.Comodule.exists_coordinateBialgHom_surjective`). Because `𝔤` is
Killing in characteristic zero, `x` acts nilpotently on `M`
(`TauCeti.isNilpotent_apply_of_isNilpotent_ad`), so its left-invariant derivation is locally
nilpotent on `H` (`Derivation.exists_iterate_leftInvariantDerivation_eq_zero_of_isNilpotent_ad`).

Exponentiating such a tangent vector produces a unipotent rational point of `G` whose adjoint
action on `𝔤` is `exp (ad x)` (`TauCeti.basePointsAdjointLieEquiv_expPoint`). Whenever a closed
subgroup cut out by `I : HopfIdeal k H` has `x` in its tangent Lie algebra, the exponential point
lies in that subgroup (`TauCeti.HopfIdeal.expPointAt_mem_quotientPointsSubgroup`). Subgroup
induction therefore lifts:

* every element of `Int(𝔤)` to a product of unipotent rational points in any closed subgroup with
  full Lie algebra, in particular `G` and (over an algebraically closed field) `G°`;
* every element of `TauCeti.expAdSubgroup k e` to a product of unipotent rational points in any
  closed subgroup whose Lie algebra contains `ker (ad e)`, in particular `C_G(e)` and (over an
  algebraically closed field) `C_G(e)°`.

Combining this lift with Lie-algebraic Kostant conjugacy (`IsSl2Triple.exists_lieEquiv_apply_eq`)
gives **group-level Kostant conjugacy**: any two `sl₂` triples `(h, e, f)` and `(h', e, f')`
sharing `e` are conjugate by a point in the subgroup generated by unipotent rational points of
`C_G(e)` (over any field of characteristic zero) and of `C_G(e)°` (over an algebraically closed
field of characteristic zero).

## Main declarations

* `Derivation.exists_iterate_leftInvariantDerivation_eq_zero_of_isNilpotent_ad` and
  `TauCeti.exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero_of_isNilpotent_ad`:
  an `ad`-nilpotent element of a Killing tangent Lie algebra has locally nilpotent left-invariant
  derivation on `H`.
* `TauCeti.basePointsAdjointLieEquiv_expPointAt_toLinearMap` and
  `TauCeti.basePointsAdjointLieEquiv_expPoint`: the adjoint action of the exponential point of `x`
  is `exp (ad x)`.
* `TauCeti.exists_mem_closure_unipotent_quotientPointsSubgroup_of_mem_intLieAlgebra`,
  `TauCeti.exists_mem_closure_unipotent_of_mem_intLieAlgebra`, and
  `TauCeti.exists_mem_closure_unipotent_identityComponent_of_mem_intLieAlgebra`: every inner
  automorphism in `Int(𝔤)` is realized by a product of unipotent rational points of `G` (and `G°`).
* `TauCeti.exists_mem_closure_unipotent_quotientPointsSubgroup_of_mem_expAdSubgroup`: every element
  of `expAdSubgroup k e` is realized by a product of unipotent rational points of any closed
  subgroup whose Lie algebra contains `ker (ad e)`.
* `IsSl2Triple.exists_mem_closure_unipotent_centralizerHopfIdeal_eq` and
  `IsSl2Triple.exists_mem_closure_unipotent_centralizerHopfIdeal_identityComponent_eq`:
  group-level Kostant conjugacy in `C_G(e)(k)` and `C_G(e)°(k)`.

## References

* B. Kostant, *The principal three-dimensional subgroup and the Betti numbers of a complex simple
  Lie group*, Amer. J. Math. **81** (1959), 973–1032.
* D. H. Collingwood and W. M. McGovern, *Nilpotent Orbits in Semisimple Lie Algebras*, Van
  Nostrand Reinhold, 1993, §3.4.
* J. S. Milne, *Algebraic Groups* (2017), Chapter 10.
-/

public section

open WithConv

namespace Derivation

open TauCeti

universe u v

variable {k : Type u} {H : Type v} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]
  [Algebra.FiniteType k H]

attribute [local instance 100] LieRing.ofAssociativeRing

/-- **Local nilpotence of `ad`-nilpotent tangent vectors.** In a finite-type affine group over a
field of characteristic zero whose tangent Lie algebra has nondegenerate Killing form, every
`ad`-nilpotent tangent vector has locally nilpotent left-invariant derivation on `H`. -/
theorem exists_iterate_leftInvariantDerivation_eq_zero_of_isNilpotent_ad
    [LieAlgebra.IsKilling k (Derivation k H (Bialgebra.CounitAlgebra k H k))]
    (d : Derivation k H (Bialgebra.CounitAlgebra k H k))
    (hd : IsNilpotent (LieAlgebra.ad k (Derivation k H (Bialgebra.CounitAlgebra k H k)) d)) :
    ∀ h : H, ∃ m, (Bialgebra.leftInvariantDerivation d)^[m] h = 0 := by
  obtain ⟨M, n, b, hf⟩ := Comodule.exists_coordinateBialgHom_surjective (k := k) (H := H)
  let _ : AddCommGroup M := Module.addCommMonoidToAddCommGroup k
  let _ : Module.Finite k M := Module.Finite.of_basis b
  have hnil : IsNilpotent (Comodule.differential (R := k) (H := H) (M := M) d) :=
    isNilpotent_apply_of_isNilpotent_ad (ρ := Comodule.differential (R := k) (H := H) (M := M)) hd
  exact d.exists_iterate_leftInvariantDerivation_eq_zero_of_isNilpotent_differential b hf hnil

end Derivation

namespace TauCeti

section LocalNilpotence

universe u v

variable {k : Type u} {H : Type v} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]
  [Algebra.FiniteType k H]

attribute [local instance 100] LieRing.ofAssociativeRing

/-- **Local nilpotence from `ad`-nilpotence in the cotangent-dual Lie algebra.** For a finite-type
affine group over a field of characteristic zero whose cotangent-dual Lie algebra has nondegenerate
Killing form, an `ad`-nilpotent element has locally nilpotent left-invariant derivation on `H`. -/
theorem exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero_of_isNilpotent_ad
    [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]
    (x : Module.Dual k (Bialgebra.CotangentSpace k H))
    (hx : IsNilpotent (LieAlgebra.ad k (Module.Dual k (Bialgebra.CotangentSpace k H)) x)) :
    ∀ h : H, ∃ m,
      (Bialgebra.leftInvariantDerivation
        (Derivation.cotangentDualLieEquiv (R := k) (H := H) x))^[m] h = 0 := by
  obtain ⟨M, n, b, hf⟩ := Comodule.exists_coordinateBialgHom_surjective (k := k) (H := H)
  let _ : AddCommGroup M := Module.addCommMonoidToAddCommGroup k
  let _ : Module.Finite k M := Module.Finite.of_basis b
  let ρ : Module.Dual k (Bialgebra.CotangentSpace k H) →ₗ⁅k⁆ Module.End k M :=
    (Comodule.differential (R := k) (H := H) (M := M)).comp
      (Derivation.cotangentDualLieEquiv (R := k) (H := H)).toLieHom
  have hnil : IsNilpotent (Comodule.differential (R := k) (H := H) (M := M)
      (Derivation.cotangentDualLieEquiv (R := k) (H := H) x)) :=
    isNilpotent_apply_of_isNilpotent_ad (ρ := ρ) hx
  exact Derivation.exists_iterate_leftInvariantDerivation_eq_zero_of_isNilpotent_differential
    _ b hf hnil

end LocalNilpotence

section AdjointExponential

universe u

variable {R H : Type u} [CommRing R] [CommRing H] [HopfAlgebra R H]
variable [Module.Finite R (Bialgebra.CotangentSpace R H)]
variable [Module.Projective R (Bialgebra.CotangentSpace R H)]

attribute [local instance] Derivation.adjointComodule

local notation "𝔤" => Module.Dual R (Bialgebra.CotangentSpace R H)

/-- A tangent vector whose left-invariant derivation is locally nilpotent on `H` has nilpotent
adjoint action on the finite projective cotangent-dual Lie algebra `𝔤`. -/
theorem isNilpotent_ad_of_exists_iterate_leftInvariantDerivation_eq_zero (x : 𝔤)
    (hd : ∀ h : H, ∃ n,
      (Bialgebra.leftInvariantDerivation
        (Derivation.cotangentDualLieEquiv (R := R) (H := H) x))^[n] h = 0) :
    IsNilpotent (LieAlgebra.ad R 𝔤 x) := by
  have hdiff : Comodule.differential (R := R) (H := H) (M := 𝔤)
      (Derivation.cotangentDualLieEquiv (R := R) (H := H) x) = LieAlgebra.ad R 𝔤 x := by
    ext y
    rw [Derivation.differential_adjointComodule, LieEquiv.symm_apply_apply, LieAlgebra.ad_apply]
  rw [← hdiff]
  exact Comodule.isNilpotent_differential (R := R) (H := H) (M := 𝔤) hd

/-- **The adjoint action of a one-parameter exponential point.** For any parameter `t : R`, the
adjoint action of `expPointAt (cotangentDualLieEquiv x) hd t` on `𝔤` is `exp (t • ad x)`. -/
theorem basePointsAdjointLieEquiv_expPointAt_toLinearMap [Algebra ℚ H] [Algebra ℚ R]
    [Module ℚ 𝔤] (x : 𝔤)
    (hd : ∀ h : H, ∃ n,
      (Bialgebra.leftInvariantDerivation
        (Derivation.cotangentDualLieEquiv (R := R) (H := H) x))^[n] h = 0)
    (t : R) :
    (Derivation.basePointsAdjointLieEquiv (R := R) (H := H)
        (Bialgebra.expPointAt
          (Derivation.cotangentDualLieEquiv (R := R) (H := H) x) hd t)).toLinearMap =
      IsNilpotent.exp (t • LieAlgebra.ad R 𝔤 x) := by
  have hdiff : Comodule.differential (R := R) (H := H) (M := 𝔤)
      (Derivation.cotangentDualLieEquiv (R := R) (H := H) x) = LieAlgebra.ad R 𝔤 x := by
    ext y
    rw [Derivation.differential_adjointComodule, LieEquiv.symm_apply_apply, LieAlgebra.ad_apply]
  rw [Derivation.basePointsAdjointLieEquiv_toLinearMap,
    Comodule.basePointsRepresentation_expPointAt, hdiff]

/-- **The adjoint Lie automorphism of an exponential point is `exp (ad x)`.** -/
theorem basePointsAdjointLieEquiv_expPoint [Algebra ℚ H] [Algebra ℚ R] [LieAlgebra ℚ 𝔤] (x : 𝔤)
    (hd : ∀ h : H, ∃ n,
      (Bialgebra.leftInvariantDerivation
        (Derivation.cotangentDualLieEquiv (R := R) (H := H) x))^[n] h = 0)
    (hx : ∀ y : 𝔤, ∃ n, ((LieAlgebra.ad R 𝔤 x) ^ n) y = 0) :
    Derivation.basePointsAdjointLieEquiv (R := R) (H := H)
        (toConv (Bialgebra.expPoint
          (Derivation.cotangentDualLieEquiv (R := R) (H := H) x) hd)) =
      expAd x hx := by
  have hnil := isNilpotent_ad_of_exists_iterate_leftInvariantDerivation_eq_zero x hd
  refine LieEquiv.ext fun y ↦ ?_
  rw [expAd_apply x hnil y]
  change (Derivation.basePointsAdjointLieEquiv (R := R) (H := H)
    (toConv (Bialgebra.expPoint
      (Derivation.cotangentDualLieEquiv (R := R) (H := H) x) hd))).toLinearMap y = _
  rw [← Bialgebra.expPointAt_one, basePointsAdjointLieEquiv_expPointAt_toLinearMap, one_smul]
  convert rfl
  exact Subsingleton.elim _ _

end AdjointExponential

section SubgroupLifting

universe u

variable {k H : Type u} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]
  [Algebra.FiniteType k H]

local notation "𝔤" => Module.Dual k (Bialgebra.CotangentSpace k H)

private noncomputable def basePointsAdjointGLHom :
    WithConv (H →ₐ[k] k) →* LinearMap.GeneralLinearGroup k 𝔤 where
  toFun g := LinearMap.GeneralLinearGroup.ofLinearEquiv
    (Derivation.basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv
  map_one' := by
    ext x
    simp
  map_mul' g h := by
    ext x
    simp

private noncomputable def basePointsAdjointLinearEquivHom :
    WithConv (H →ₐ[k] k) →* (𝔤 ≃ₗ[k] 𝔤) where
  toFun g := (Derivation.basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv
  map_one' := by
    ext x
    simp
  map_mul' g h := by
    ext x
    simp

/-- **Lifting `Int(𝔤)` into any closed subgroup with full Lie algebra.** Let `G = Spec H` be a
finite-type affine group over a field `k` of characteristic zero whose Lie algebra `𝔤` has
nondegenerate Killing form, and let `I` cut out a closed subgroup whose tangent Lie algebra is all
of `𝔤`. Then every inner automorphism `φ ∈ Int(𝔤)` is realized as `Ad(g)` for a point `g` in the
subgroup generated by the unipotent rational points of that closed subgroup. -/
theorem exists_mem_closure_unipotent_quotientPointsSubgroup_of_mem_intLieAlgebra
    [LieAlgebra.IsKilling k 𝔤] [LieAlgebra ℚ 𝔤] (I : HopfIdeal k H)
    (hI : I.lieSubalgebra (B := k) = ⊤) {φ : LinearMap.GeneralLinearGroup k 𝔤}
    (hφ : φ ∈ intLieAlgebra k 𝔤) :
    ∃ g ∈ Subgroup.closure
        {u ∈ CommHopfAlgCat.quotientPointsSubgroup (_root_.CommHopfAlgCat.of k H) I
            (CommAlgCat.of k k) |
          HopfAlgebra.IsUnipotentPoint u},
      LinearMap.GeneralLinearGroup.ofLinearEquiv
        (Derivation.basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv = φ := by
  let _ : Algebra ℚ H := ((algebraMap k H).comp (algebraMap ℚ k)).toAlgebra
  let U : Subgroup (WithConv (H →ₐ[k] k)) :=
    Subgroup.closure
      {u ∈ CommHopfAlgCat.quotientPointsSubgroup (_root_.CommHopfAlgCat.of k H) I
          (CommAlgCat.of k k) |
        HopfAlgebra.IsUnipotentPoint u}
  have hle : intLieAlgebra k 𝔤 ≤ U.map (basePointsAdjointGLHom (k := k) (H := H)) := by
    rw [intLieAlgebra_le_iff]
    intro x hx
    have hd :=
      exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero_of_isNilpotent_ad
        (k := k) (H := H) x hx
    refine ⟨toConv (Bialgebra.expPoint
        (Derivation.cotangentDualLieEquiv (R := k) (H := H) x) hd),
      Subgroup.subset_closure ⟨?_, HopfAlgebra.isUnipotentPoint_expPoint _ hd⟩, ?_⟩
    · rw [← Bialgebra.expPointAt_one]
      exact I.expPointAt_mem_quotientPointsSubgroup
        (hI.symm ▸ LieSubalgebra.mem_top _) hd (1 : k)
    · simp only [basePointsAdjointGLHom, MonoidHom.coe_mk, OneHom.coe_mk,
        basePointsAdjointLieEquiv_expPoint x hd hx.exists_pow_apply_eq_zero]
  obtain ⟨g, hg, hgf⟩ := hle hφ
  exact ⟨g, hg, hgf⟩

/-- **Lifting `Int(𝔤)` to rational points of `G`.** Over any field `k` of characteristic zero,
every inner automorphism `φ ∈ Int(𝔤)` is realized as `Ad(g)` for a point `g` in the subgroup
generated by the unipotent rational points of `G`. -/
theorem exists_mem_closure_unipotent_of_mem_intLieAlgebra [LieAlgebra.IsKilling k 𝔤]
    [LieAlgebra ℚ 𝔤] {φ : LinearMap.GeneralLinearGroup k 𝔤} (hφ : φ ∈ intLieAlgebra k 𝔤) :
    ∃ g ∈ Subgroup.closure {u : WithConv (H →ₐ[k] k) | HopfAlgebra.IsUnipotentPoint u},
      LinearMap.GeneralLinearGroup.ofLinearEquiv
        (Derivation.basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv = φ := by
  have hbot : (⊥ : HopfIdeal k H).lieSubalgebra (B := k) = ⊤ := by
    rw [eq_top_iff]
    intro d _
    rw [HopfIdeal.mem_lieSubalgebra_iff]
    intro x hx
    have hx0 : x = 0 := hx
    simp [hx0]
  obtain ⟨g, hg, hgf⟩ :=
    exists_mem_closure_unipotent_quotientPointsSubgroup_of_mem_intLieAlgebra (⊥ : HopfIdeal k H)
      hbot hφ
  exact ⟨g, Subgroup.closure_mono (by rintro _ ⟨_, hu⟩; exact hu) hg, hgf⟩

/-- **Lifting `Int(𝔤)` to rational points of the identity component `G°`.** Over an algebraically
closed field of characteristic zero, every inner automorphism `φ ∈ Int(𝔤)` is realized as `Ad(g)`
for a point `g` in the subgroup generated by the unipotent rational points of `G°`. -/
theorem exists_mem_closure_unipotent_identityComponent_of_mem_intLieAlgebra [IsAlgClosed k]
    {H : FiniteTypeCommHopfAlgCat.{u, u} k}
    [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]
    [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))]
    {φ : LinearMap.GeneralLinearGroup k (Module.Dual k (Bialgebra.CotangentSpace k H))}
    (hφ : φ ∈ intLieAlgebra k (Module.Dual k (Bialgebra.CotangentSpace k H))) :
    ∃ g ∈ Subgroup.closure
        {u ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
            (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k) |
          HopfAlgebra.IsUnipotentPoint u},
      LinearMap.GeneralLinearGroup.ofLinearEquiv
        (Derivation.basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv = φ :=
  exists_mem_closure_unipotent_quotientPointsSubgroup_of_mem_intLieAlgebra
    (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H))
    HopfIdeal.lieSubalgebra_identityComponentHopfIdeal_eq_top hφ

/-- **Lifting `expAdSubgroup k e` into closed subgroups containing `ker (ad e)`.** If `I` cuts out
a closed subgroup whose tangent Lie algebra contains `Lie(C_G(e))`, then every automorphism in
`TauCeti.expAdSubgroup k e` is realized as `Ad(g)` for a point `g` in the subgroup generated by the
unipotent rational points of that closed subgroup. -/
theorem exists_mem_closure_unipotent_quotientPointsSubgroup_of_mem_expAdSubgroup
    [LieAlgebra.IsKilling k 𝔤] [LieAlgebra ℚ 𝔤] (e : 𝔤) (I : HopfIdeal k H)
    (hI : (centralizerHopfIdeal H e).lieSubalgebra (B := k) ≤ I.lieSubalgebra (B := k))
    {ψ : 𝔤 ≃ₗ[k] 𝔤} (hψ : ψ ∈ expAdSubgroup k e) :
    ∃ g ∈ Subgroup.closure
        {u ∈ CommHopfAlgCat.quotientPointsSubgroup (_root_.CommHopfAlgCat.of k H) I
            (CommAlgCat.of k k) |
          HopfAlgebra.IsUnipotentPoint u},
      (Derivation.basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv = ψ := by
  let _ : Algebra ℚ H := ((algebraMap k H).comp (algebraMap ℚ k)).toAlgebra
  let U : Subgroup (WithConv (H →ₐ[k] k)) :=
    Subgroup.closure
      {u ∈ CommHopfAlgCat.quotientPointsSubgroup (_root_.CommHopfAlgCat.of k H) I
          (CommAlgCat.of k k) |
        HopfAlgebra.IsUnipotentPoint u}
  have hle : expAdSubgroup k e ≤ U.map (basePointsAdjointLinearEquivHom (k := k) (H := H)) := by
    rw [expAdSubgroup_le_iff]
    intro y hy hy_mem
    have hd :=
      exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero_of_isNilpotent_ad
        (k := k) (H := H) y hy
    have hy_ker : ⁅e, y⁆ = 0 := by
      simpa [LinearMap.mem_ker, LieAlgebra.ad_apply] using (Submodule.mem_inf.mp hy_mem).1
    have hy_lie : Derivation.cotangentDualLieEquiv (R := k) (H := H) y ∈
        I.lieSubalgebra (B := k) :=
      hI ((mem_lieSubalgebra_centralizerHopfIdeal_iff e _).mpr <| by
        rw [← LieEquiv.map_lie, hy_ker, map_zero])
    refine ⟨toConv (Bialgebra.expPoint
        (Derivation.cotangentDualLieEquiv (R := k) (H := H) y) hd),
      Subgroup.subset_closure ⟨?_, HopfAlgebra.isUnipotentPoint_expPoint _ hd⟩, ?_⟩
    · rw [← Bialgebra.expPointAt_one]
      exact I.expPointAt_mem_quotientPointsSubgroup hy_lie hd (1 : k)
    · simp only [basePointsAdjointLinearEquivHom, MonoidHom.coe_mk, OneHom.coe_mk,
        basePointsAdjointLieEquiv_expPoint y hd hy.exists_pow_apply_eq_zero]
  obtain ⟨g, hg, hgf⟩ := hle hψ
  exact ⟨g, hg, hgf⟩

end SubgroupLifting

end TauCeti

namespace IsSl2Triple

open TauCeti

universe u

variable {k : Type u} [Field k] [CharZero k]

attribute [local instance] Derivation.adjointComodule

/-- **Group-level Kostant conjugacy in `C_G(e)(k)`.** Over any field `k` of characteristic zero,
let `G = Spec H` be a finite-type affine group whose Lie algebra `𝔤` has nondegenerate Killing
form. Any two `sl₂` triples `(h, e, f)` and `(h', e, f')` in `𝔤` sharing `e` are conjugate by a
point `g` in the subgroup generated by the unipotent rational points of `C_G(e)(k)`. -/
theorem exists_mem_closure_unipotent_centralizerHopfIdeal_eq
    {H : Type u} [CommRing H] [HopfAlgebra k H] [Algebra.FiniteType k H]
    [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]
    {h e f h' f' : Module.Dual k (Bialgebra.CotangentSpace k H)}
    (t : IsSl2Triple h e f) (t' : IsSl2Triple h' e f') :
    ∃ g ∈ Subgroup.closure
        {u ∈ CommHopfAlgCat.quotientPointsSubgroup (_root_.CommHopfAlgCat.of k H)
            (centralizerHopfIdeal H e) (CommAlgCat.of k k) |
          HopfAlgebra.IsUnipotentPoint u},
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g h = h' ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g e = e ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g f =
          f' := by
  let _ : LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H)) :=
    ratLieAlgebra k (Module.Dual k (Bialgebra.CotangentSpace k H))
  obtain ⟨φ, hφ, hφe, hφh, hφf⟩ := t.exists_lieEquiv_apply_eq (K := k) t'
  obtain ⟨g, hg, hgeq⟩ :=
    exists_mem_closure_unipotent_quotientPointsSubgroup_of_mem_expAdSubgroup e
      (centralizerHopfIdeal H e) le_rfl hφ
  have hact (x : Module.Dual k (Bialgebra.CotangentSpace k H)) :
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g x =
        φ x := by
    rw [← Derivation.basePointsAdjointLieEquiv_apply, ← LieEquiv.coe_toLinearEquiv, hgeq,
      LieEquiv.coe_toLinearEquiv]
  exact ⟨g, hg, hact h ▸ hφh, hact e ▸ hφe, hact f ▸ hφf⟩

/-- **Group-level Kostant conjugacy in `C_G(e)°(k)`.** Over an algebraically closed field of
characteristic zero, any two `sl₂` triples `(h, e, f)` and `(h', e, f')` in the Killing Lie algebra
of a finite-type affine group `G = Spec H` sharing `e` are conjugate by a point `g` in the subgroup
generated by the unipotent rational points of the connected centralizer `C_G(e)°(k)`. -/
theorem exists_mem_closure_unipotent_centralizerHopfIdeal_identityComponent_eq [IsAlgClosed k]
    {H : FiniteTypeCommHopfAlgCat.{u, u} k}
    [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]
    {h e f h' f' : Module.Dual k (Bialgebra.CotangentSpace k H)}
    (t : IsSl2Triple h e f) (t' : IsSl2Triple h' e f') :
    ∃ g ∈ Subgroup.closure
        {u ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
            (centralizerHopfIdeal H e).identityComponent (CommAlgCat.of k k) |
          HopfAlgebra.IsUnipotentPoint u},
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g h = h' ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g e = e ∧
        Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g f =
          f' := by
  let _ : LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H)) :=
    ratLieAlgebra k (Module.Dual k (Bialgebra.CotangentSpace k H))
  obtain ⟨φ, hφ, hφe, hφh, hφf⟩ := t.exists_lieEquiv_apply_eq (K := k) t'
  obtain ⟨g, hg, hgeq⟩ :=
    exists_mem_closure_unipotent_quotientPointsSubgroup_of_mem_expAdSubgroup e
      (centralizerHopfIdeal H e).identityComponent
      (HopfIdeal.lieSubalgebra_identityComponent _).ge hφ
  have hact (x : Module.Dual k (Bialgebra.CotangentSpace k H)) :
      Comodule.basePointsRepresentation (Module.Dual k (Bialgebra.CotangentSpace k H)) g x =
        φ x := by
    rw [← Derivation.basePointsAdjointLieEquiv_apply, ← LieEquiv.coe_toLinearEquiv, hgeq,
      LieEquiv.coe_toLinearEquiv]
  exact ⟨g, hg, hact h ▸ hφh, hact e ▸ hφe, hact f ▸ hφf⟩

end IsSl2Triple
