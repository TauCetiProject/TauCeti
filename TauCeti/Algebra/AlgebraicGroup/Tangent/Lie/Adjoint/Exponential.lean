/-!
# Adjoint action of exponential points and group realization of `Int(Lie(G))`

Let `G = Spec H` be an affine group over a commutative ring `R` with finite projective augmentation
cotangent space, and write `𝔤 = Module.Dual R (Bialgebra.CotangentSpace R H)` for its Lie algebra.
By `TauCeti.differential_adjointComodule_cotangentDualLieEquiv`, the differentiated representation
of the adjoint comodule is `ad : 𝔤 → End(𝔤)`. Combining this with the comodule exponential formula
`TauCeti.Comodule.basePointsRepresentation_expPoint` shows that whenever `x ∈ 𝔤` has nilpotent
`ad x` and locally nilpotent left-invariant vector field on `H`, its exponential point acts on `𝔤`
by the inner automorphism `TauCeti.expAd x`.

Over a field `k` of characteristic zero, when `𝔤` is a Killing Lie algebra, Hochschild's nilpotence
criterion (`TauCeti.isNilpotent_apply_of_isNilpotent_ad`) ensures that every `ad`-nilpotent `x ∈ 𝔤`
acts nilpotently in every finite-dimensional representation of `G`. Hence its left-invariant vector
field is automatically locally nilpotent on `H` (without any finite-type assumption on `H`), its
exponential point is unipotent (`TauCeti.HopfAlgebra.IsUnipotentPoint`), and when `𝔤` is
finite-dimensional the subgroup `TauCeti.intLieAlgebra k 𝔤` of inner automorphisms is realized
inside `Ad(G(k))` by products of unipotent rational points. When `k` is algebraically closed and `G`
is of finite type, every exponential curve factors through the identity component `G°`, so `Int(𝔤)`
is realized inside `Ad(G°(k))`.

## Main declarations

* `TauCeti.basePointsAdjointLieEquiv_expPoint`: the exponential point of `x` acts on `𝔤` by
  `TauCeti.expAd x`.
* `TauCeti.isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad` and
  `TauCeti.exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero_of_isNilpotent_ad`:
  in characteristic zero when `𝔤` is Killing, every `ad`-nilpotent element acts nilpotently on all
  finite-dimensional comodules and has locally nilpotent left-invariant derivation on `H`.
* `TauCeti.intLieAlgebra_le_map_asGroupHom_closure_isUnipotentPoint`: in characteristic zero with
  Killing Lie algebra, `Int(𝔤)` lies in the adjoint image of the subgroup generated by unipotent
  `k`-points.
* `TauCeti.intLieAlgebra_le_map_asGroupHom_closure_identityComponentHopfIdeal_isUnipotentPoint` and
  `TauCeti.exists_mem_identityComponentHopfIdeal_ofLinearEquiv_basePointsAdjointLieEquiv_eq`: over
  an algebraically closed field of characteristic zero, `Int(𝔤)` is realized by products of
  unipotent `k`-points of `G°`.

## References

* A. Borel, *Linear Algebraic Groups* (2nd ed.), Springer GTM 126 (1991), §7.
* J. E. Humphreys, *Linear Algebraic Groups*, Springer GTM 21 (1975), §13 and §15.
* D. H. Collingwood and W. M. McGovern, *Nilpotent Orbits in Semisimple Lie Algebras*, Van
  Nostrand Reinhold (1993), §3.2.
-/

public section

open WithConv

namespace TauCeti

open Derivation

section General

universe u

variable {R H : Type u} [CommRing R] [CommRing H] [HopfAlgebra R H]
variable [Module.Finite R (Bialgebra.CotangentSpace R H)]
variable [Module.Projective R (Bialgebra.CotangentSpace R H)]

attribute [local instance] adjointComodule

/-- **Adjoint action of an exponential point.** When `x ∈ 𝔤` has nilpotent `ad x` and locally
nilpotent left-invariant derivation on `H`, the exponential point of `x` acts on `𝔤` by the inner
automorphism `TauCeti.expAd x`. -/
theorem basePointsAdjointLieEquiv_expPoint [Algebra ℚ H]
    [LieAlgebra ℚ (Module.Dual R (Bialgebra.CotangentSpace R H))]
    {x : Module.Dual R (Bialgebra.CotangentSpace R H)}
    (hx : IsNilpotent (LieAlgebra.ad R (Module.Dual R (Bialgebra.CotangentSpace R H)) x))
    (hd : ∀ h : H, ∃ n,
      (Bialgebra.leftInvariantDerivation (cotangentDualLieEquiv (R := R) (H := H) x))^[n] h = 0) :
    basePointsAdjointLieEquiv (R := R) (H := H)
        (toConv (Bialgebra.expPoint (cotangentDualLieEquiv (R := R) (H := H) x) hd)) =
      expAd x hx.exists_pow_apply_eq_zero := by
  have hdiff : IsNilpotent (Comodule.differential (R := R) (H := H)
      (M := Module.Dual R (Bialgebra.CotangentSpace R H))
      (cotangentDualLieEquiv (R := R) (H := H) x)) := by
    rwa [differential_adjointComodule_cotangentDualLieEquiv]
  refine LieEquiv.ext fun y => ?_
  rw [basePointsAdjointLieEquiv_apply, Comodule.basePointsRepresentation_expPoint _ hd hdiff,
    differential_adjointComodule_cotangentDualLieEquiv, ← expAd_apply x hx y]

/-- As an element of `GL(𝔤)`, the base-point representation of the exponential point of `x` is
`ofLinearEquiv (expAd x).toLinearEquiv`. -/
theorem asGroupHom_basePointsRepresentation_expPoint [Algebra ℚ H]
    [LieAlgebra ℚ (Module.Dual R (Bialgebra.CotangentSpace R H))]
    {x : Module.Dual R (Bialgebra.CotangentSpace R H)}
    (hx : IsNilpotent (LieAlgebra.ad R (Module.Dual R (Bialgebra.CotangentSpace R H)) x))
    (hd : ∀ h : H, ∃ n,
      (Bialgebra.leftInvariantDerivation (cotangentDualLieEquiv (R := R) (H := H) x))^[n] h = 0) :
    Representation.asGroupHom (Comodule.basePointsRepresentation
        (Module.Dual R (Bialgebra.CotangentSpace R H)))
        (toConv (Bialgebra.expPoint (cotangentDualLieEquiv (R := R) (H := H) x) hd)) =
      LinearMap.GeneralLinearGroup.ofLinearEquiv
        (expAd x hx.exists_pow_apply_eq_zero).toLinearEquiv := by
  refine Units.ext <| LinearMap.ext fun y => ?_
  simpa [Representation.asGroupHom_apply] using
    DFunLike.congr_fun (basePointsAdjointLieEquiv_expPoint (R := R) (H := H) hx hd) y

end General

section IsKilling

universe u v

attribute [local instance 100] LieRing.ofAssociativeRing

/-- Over a field of characteristic zero, if `𝔤 = Lie(G)` is a Killing Lie algebra, every
`ad`-nilpotent element `x ∈ 𝔤` acts nilpotently in the differentiated action on every
finite-dimensional comodule `M`. -/
theorem isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad
    {k : Type u} {H : Type u} {M : Type v} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]
    [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]
    [AddCommGroup M] [Module k M] [Comodule k H M] [Module.Finite k M]
    {x : Module.Dual k (Bialgebra.CotangentSpace k H)}
    (hx : IsNilpotent (LieAlgebra.ad k (Module.Dual k (Bialgebra.CotangentSpace k H)) x)) :
    IsNilpotent (Comodule.differential (R := k) (H := H) (M := M)
      (cotangentDualLieEquiv (R := k) (H := H) x)) := by
  simpa using isNilpotent_apply_of_isNilpotent_ad
    (ρ := (Comodule.differential (R := k) (H := H) (M := M)).comp
      (cotangentDualLieEquiv (R := k) (H := H)).toLieHom) hx

/-- Over a field of characteristic zero, if `𝔤 = Lie(G)` is a Killing Lie algebra, then the
left-invariant vector field of every `ad`-nilpotent `x ∈ 𝔤` is locally nilpotent on `H`. -/
theorem exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero_of_isNilpotent_ad
    {k H : Type u} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]
    [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]
    {x : Module.Dual k (Bialgebra.CotangentSpace k H)}
    (hx : IsNilpotent (LieAlgebra.ad k (Module.Dual k (Bialgebra.CotangentSpace k H)) x)) :
    ∀ h : H, ∃ m,
      (Bialgebra.leftInvariantDerivation (cotangentDualLieEquiv (R := k) (H := H) x))^[m] h = 0 :=
  exists_iterate_leftInvariantDerivation_eq_zero_of_forall_fgComodule
    (cotangentDualLieEquiv (R := k) (H := H) x)
    fun M => isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad (M := M) hx

end IsKilling

universe u

section CharZero

variable {k H : Type u} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]
  [Module.Finite k (Bialgebra.CotangentSpace k H)]
  [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]

attribute [local instance] adjointComodule

/-- **Realization of `Int(Lie(G))` by unipotent rational points.** For an affine group `G = Spec H`
over a field `k` of characteristic zero with finite-dimensional Killing Lie algebra `𝔤`, the inner
automorphism group `Int(𝔤)` lies in the adjoint image of the subgroup of `G(k)` generated by
unipotent points. -/
theorem intLieAlgebra_le_map_asGroupHom_closure_isUnipotentPoint
    [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))] :
    intLieAlgebra k (Module.Dual k (Bialgebra.CotangentSpace k H)) ≤
      (Subgroup.closure {u : WithConv (H →ₐ[k] k) | HopfAlgebra.IsUnipotentPoint u}).map
        (Representation.asGroupHom (Comodule.basePointsRepresentation
          (Module.Dual k (Bialgebra.CotangentSpace k H)))) := by
  let : Algebra ℚ H := ((algebraMap k H).comp (algebraMap ℚ k)).toAlgebra
  refine intLieAlgebra_le_iff.mpr fun x hx => ?_
  have hd :=
    exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero_of_isNilpotent_ad
      (k := k) (H := H) hx
  refine ⟨toConv (Bialgebra.expPoint (cotangentDualLieEquiv (R := k) (H := H) x) hd),
    Subgroup.subset_closure ?_,
    asGroupHom_basePointsRepresentation_expPoint (R := k) (H := H) hx hd⟩
  exact HopfAlgebra.isUnipotentPoint_expPoint _ hd fun M =>
    isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad (M := M) hx

/-- Every inner automorphism in `Int(Lie(G))` is the adjoint action of a product of unipotent
`k`-points of `G`. -/
theorem exists_mem_closure_isUnipotentPoint_ofLinearEquiv_basePointsAdjointLieEquiv_eq
    [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))]
    {φ : LinearMap.GeneralLinearGroup k (Module.Dual k (Bialgebra.CotangentSpace k H))}
    (hφ : φ ∈ intLieAlgebra k (Module.Dual k (Bialgebra.CotangentSpace k H))) :
    ∃ g ∈ Subgroup.closure {u : WithConv (H →ₐ[k] k) | HopfAlgebra.IsUnipotentPoint u},
      LinearMap.GeneralLinearGroup.ofLinearEquiv
          (basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv = φ ∧
        ∀ y, Comodule.basePointsRepresentation
          (Module.Dual k (Bialgebra.CotangentSpace k H)) g y = φ • y := by
  obtain ⟨g, hg, rfl⟩ := intLieAlgebra_le_map_asGroupHom_closure_isUnipotentPoint hφ
  refine ⟨g, hg, ?_, fun y => rfl⟩
  refine Units.ext <| LinearMap.ext fun y => ?_
  simp [Representation.asGroupHom_apply]

end CharZero

section AlgClosed

variable {k : Type u} [Field k] [CharZero k] [IsAlgClosed k]
  {H : FiniteTypeCommHopfAlgCat.{u, u} k}
  [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]

attribute [local instance] adjointComodule

/-- **Realization of `Int(Lie(G))` inside `Ad(G°(k))`.** Over an algebraically closed field `k` of
characteristic zero, for any finite-type affine group `G = Spec H` with Killing Lie algebra `𝔤`,
the inner automorphism group `Int(𝔤)` lies in the adjoint image of the subgroup generated by
unipotent `k`-points of the identity component `G°`. -/
theorem intLieAlgebra_le_map_asGroupHom_closure_identityComponentHopfIdeal_isUnipotentPoint
    [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))] :
    intLieAlgebra k (Module.Dual k (Bialgebra.CotangentSpace k H)) ≤
      (Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
          (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k) ∧
        HopfAlgebra.IsUnipotentPoint u}).map
        (Representation.asGroupHom (Comodule.basePointsRepresentation
          (Module.Dual k (Bialgebra.CotangentSpace k H)))) := by
  let : Algebra ℚ H := ((algebraMap k H).comp (algebraMap ℚ k)).toAlgebra
  refine intLieAlgebra_le_iff.mpr fun x hx => ?_
  have hd :=
    exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero_of_isNilpotent_ad
      (k := k) (H := H) hx
  let u := toConv (Bialgebra.expPoint (cotangentDualLieEquiv (R := k) (H := H) x) hd)
  refine ⟨u, Subgroup.subset_closure ⟨?_, ?_⟩,
    asGroupHom_basePointsRepresentation_expPoint (R := k) (H := H) hx hd⟩
  · simpa [u, Bialgebra.expPointAt_one] using
      HopfAlgebra.expPointAt_mem_quotientPointsSubgroup_identityComponentHopfIdeal
        (k := k) (H := H) hd (1 : k)
  · exact HopfAlgebra.isUnipotentPoint_expPoint _ hd fun M =>
      isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad (M := M) hx

/-- Over an algebraically closed field of characteristic zero, every inner automorphism
`φ ∈ Int(Lie(G))` is realized by a rational point of the identity component `G°` lying in the
subgroup generated by unipotent points of `G°`. -/
theorem exists_mem_identityComponentHopfIdeal_ofLinearEquiv_basePointsAdjointLieEquiv_eq
    [LieAlgebra ℚ (Module.Dual k (Bialgebra.CotangentSpace k H))]
    {φ : LinearMap.GeneralLinearGroup k (Module.Dual k (Bialgebra.CotangentSpace k H))}
    (hφ : φ ∈ intLieAlgebra k (Module.Dual k (Bialgebra.CotangentSpace k H))) :
    ∃ g ∈ Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
          (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k) ∧
        HopfAlgebra.IsUnipotentPoint u},
      g ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
          (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k) ∧
        LinearMap.GeneralLinearGroup.ofLinearEquiv
          (basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv = φ ∧
        ∀ y, Comodule.basePointsRepresentation
          (Module.Dual k (Bialgebra.CotangentSpace k H)) g y = φ • y := by
  obtain ⟨g, hg, rfl⟩ :=
    intLieAlgebra_le_map_asGroupHom_closure_identityComponentHopfIdeal_isUnipotentPoint hφ
  have hg₀ : g ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
      (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k) :=
    (Subgroup.closure_le
      (CommHopfAlgCat.quotientPointsSubgroup H.obj
        (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k))).mpr
      (fun _ hu => (Set.mem_ofPred.mp hu).1) hg
  refine ⟨g, hg, hg₀, ?_, fun y => rfl⟩
  refine Units.ext <| LinearMap.ext fun y => ?_
  simp [Representation.asGroupHom_apply]

end AlgClosed

end TauCeti
