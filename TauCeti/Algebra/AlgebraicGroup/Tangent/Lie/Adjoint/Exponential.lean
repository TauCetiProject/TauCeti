/-!
# Integrating `ad`-nilpotent elements and `Int(𝔤)` into `G°(k)`

Let `G = Spec H` be an affine group over a commutative ring `R` with finite projective augmentation
cotangent space, and write `𝔤 = Module.Dual R (Bialgebra.CotangentSpace R H)` for its Lie algebra.
By `TauCeti.differential_adjointComodule_cotangentDualLieEquiv`, the differentiated representation
of the adjoint comodule is `ad : 𝔤 → End(𝔤)`. Combining this with the comodule exponential formula
`TauCeti.Comodule.basePointsRepresentation_expPoint` shows that whenever `x ∈ 𝔤` has nilpotent
`ad x` and locally nilpotent left-invariant vector field on `H`, its exponential point acts on `𝔤`
by the inner automorphism `TauCeti.expAd x` (`TauCeti.basePointsAdjointLieEquiv_expPoint`).

Now let `k` be a field of characteristic zero and suppose `𝔤` has nondegenerate Killing form. An
`ad`-nilpotent element `x ∈ 𝔤` acts nilpotently in every finite-dimensional representation of `𝔤`
(`TauCeti.isNilpotent_apply_of_isNilpotent_ad`), hence on every finite-dimensional `G`-comodule
(`TauCeti.Comodule.isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad`). By local
finiteness of comodules
(`Derivation.exists_iterate_leftInvariantDerivation_eq_zero_of_forall_fgComodule`),
the left-invariant vector field of `x` on `H` is automatically locally nilpotent without any
finite-type assumption on `H`
(`TauCeti.exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero`).

Its Taylor exponential therefore defines a unipotent `k`-point `TauCeti.expAdPoint hx : G(k)`
(`TauCeti.isUnipotentPoint_expAdPoint`) whose action on any finite-dimensional `ℚ`-module comodule
`M` is `IsNilpotent.exp (differential (cotangentDualLieEquiv x))`
(`TauCeti.Comodule.basePointsRepresentation_expAdPoint`), whose adjoint action on `𝔤` is the
operator exponential `IsNilpotent.exp (ad x) = expAd x`
(`TauCeti.basePointsRepresentation_expAdPoint`, `TauCeti.basePointsAdjointLieEquiv_expAdPoint`),
which is injective in `x` (`TauCeti.expAdPoint_eq_iff`, `TauCeti.expAdPoint_eq_one_iff`), and which
lands in any closed subgroup `Spec (H / I)` whose Lie algebra contains `x`
(`TauCeti.expAdPoint_mem_quotientPointsSubgroup`). Consequently `Int(𝔤)` lies in the adjoint image
of the subgroup generated by unipotent `k`-points of `G`
(`TauCeti.intLieAlgebra_le_map_asGroupHom_closure_isUnipotentPoint`).

Over an algebraically closed field when `G` is of finite type, `expAdPoint hx` lies in the identity
component `G°(k)` and in `C_G(y)°(k)` whenever `⁅x, y⁆ = 0`, so the entire inner automorphism group
`Int(𝔤)` is realized by products of unipotent rational points of `G°`
(`TauCeti.intLieAlgebra_le_map_asGroupHom_closure_identityComponentHopfIdeal_isUnipotentPoint`,
`TauCeti.intLieAlgebra_le_map_quotientPointsSubgroup_identityComponent`).

## Main declarations

* `TauCeti.basePointsAdjointLieEquiv_expPoint` and
  `TauCeti.asGroupHom_basePointsRepresentation_expPoint`: over any commutative ring, the exponential
  point of `x` acts on `𝔤` by `TauCeti.expAd x`.
* `TauCeti.Comodule.isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad` and
  `TauCeti.exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero`: in characteristic
  zero when `𝔤` is Killing, every `ad`-nilpotent element acts nilpotently on all finite-dimensional
  comodules and has locally nilpotent left-invariant derivation on `H`.
* `TauCeti.expAdPoint`: the rational point `exp x ∈ G(k)` attached to an `ad`-nilpotent `x ∈ 𝔤`,
  with characteristic lemmas `TauCeti.expAdPoint_def`, `TauCeti.expAdPoint_zero`,
  `TauCeti.isUnipotentPoint_expAdPoint`, `TauCeti.expAdPoint_eq_iff`,
  `TauCeti.expAdPoint_eq_one_iff`, `TauCeti.Comodule.basePointsRepresentation_expAdPoint`,
  `TauCeti.basePointsRepresentation_expAdPoint`, `TauCeti.basePointsAdjointLieEquiv_expAdPoint`,
  `TauCeti.toHomUnits_basePointsRepresentation_expAdPoint`, and
  `TauCeti.expAdPoint_mem_quotientPointsSubgroup`.
* `TauCeti.intLieAlgebra_le_map_asGroupHom_closure_isUnipotentPoint` and
  `TauCeti.intLieAlgebra_le_range_basePointsRepresentation`: `Int(𝔤)` lies in the adjoint image of
  the subgroup generated by unipotent `k`-points of `G`.
* `TauCeti.expAdPoint_mem_identityComponent` and
  `TauCeti.expAdPoint_mem_centralizer_identityComponent`: subgroup memberships in `G°(k)` and
  `C_G(y)°(k)`.
* `TauCeti.intLieAlgebra_le_map_asGroupHom_closure_identityComponentHopfIdeal_isUnipotentPoint`,
  `TauCeti.exists_mem_identityComponentHopfIdeal_ofLinearEquiv_basePointsAdjointLieEquiv_eq`, and
  `TauCeti.intLieAlgebra_le_map_quotientPointsSubgroup_identityComponent`: over an algebraically
  closed field of characteristic zero, `Int(𝔤)` is realized inside `Ad(G°(k))` by products of
  unipotent `k`-points of `G°`.

## References

* A. Borel, *Linear Algebraic Groups* (2nd ed.), Springer GTM 126, §7.3.
* D. H. Collingwood and W. M. McGovern, *Nilpotent Orbits in Semisimple Lie Algebras*, Van
  Nostrand Reinhold, 1993, §§3.2 and 3.4.
* J. S. Milne, *Algebraic Groups* (2017), Chapters 10 and 14.
-/

public section

open CategoryTheory WithConv

namespace TauCeti.Comodule

attribute [local instance 100] LieRing.ofAssociativeRing

/-- **An `ad`-nilpotent element of a Killing Lie algebra acts nilpotently on every
finite-dimensional comodule.** -/
theorem isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad
    {k H M : Type*} [Field k] [CharZero k] [CommRing H] [Bialgebra k H]
    [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]
    [AddCommGroup M] [Module k M] [FiniteDimensional k M] [Comodule k H M]
    {x : Module.Dual k (Bialgebra.CotangentSpace k H)}
    (hx : IsNilpotent (LieAlgebra.ad k (Module.Dual k (Bialgebra.CotangentSpace k H)) x)) :
    IsNilpotent (differential (R := k) (H := H) (M := M)
      (Derivation.cotangentDualLieEquiv (R := k) (H := H) x)) :=
  TauCeti.isNilpotent_apply_of_isNilpotent_ad
    (ρ := (differential (R := k) (H := H) (M := M)).comp
      (Derivation.cotangentDualLieEquiv (R := k) (H := H)).toLieHom) hx

end TauCeti.Comodule

namespace TauCeti

section General

universe u

variable {R H : Type u} [CommRing R] [CommRing H] [HopfAlgebra R H]
variable [Module.Finite R (Bialgebra.CotangentSpace R H)]
variable [Module.Projective R (Bialgebra.CotangentSpace R H)]

attribute [local instance] Derivation.adjointComodule

/-- **Adjoint action of an exponential point.** When `x ∈ 𝔤` has nilpotent `ad x` and locally
nilpotent left-invariant derivation on `H`, the exponential point of `x` acts on `𝔤` by the inner
automorphism `TauCeti.expAd x`. -/
theorem basePointsAdjointLieEquiv_expPoint [Algebra ℚ H]
    [LieAlgebra ℚ (Module.Dual R (Bialgebra.CotangentSpace R H))]
    {x : Module.Dual R (Bialgebra.CotangentSpace R H)}
    (hx : IsNilpotent (LieAlgebra.ad R (Module.Dual R (Bialgebra.CotangentSpace R H)) x))
    (hd : ∀ h : H, ∃ n,
      (Bialgebra.leftInvariantDerivation
        (Derivation.cotangentDualLieEquiv (R := R) (H := H) x))^[n] h = 0) :
    Derivation.basePointsAdjointLieEquiv (R := R) (H := H)
        (toConv (Bialgebra.expPoint
          (Derivation.cotangentDualLieEquiv (R := R) (H := H) x) hd)) =
      expAd x hx.exists_pow_apply_eq_zero := by
  have hdiff : IsNilpotent (Comodule.differential (R := R) (H := H)
      (M := Module.Dual R (Bialgebra.CotangentSpace R H))
      (Derivation.cotangentDualLieEquiv (R := R) (H := H) x)) := by
    rwa [differential_adjointComodule_cotangentDualLieEquiv]
  refine LieEquiv.ext fun y => ?_
  rw [Derivation.basePointsAdjointLieEquiv_apply,
    Comodule.basePointsRepresentation_expPoint hd hdiff,
    differential_adjointComodule_cotangentDualLieEquiv, ← expAd_apply x hx y]

/-- As an element of `GL(𝔤)`, the base-point representation of the exponential point of `x` is
`ofLinearEquiv (expAd x).toLinearEquiv`. -/
theorem asGroupHom_basePointsRepresentation_expPoint [Algebra ℚ H]
    [LieAlgebra ℚ (Module.Dual R (Bialgebra.CotangentSpace R H))]
    {x : Module.Dual R (Bialgebra.CotangentSpace R H)}
    (hx : IsNilpotent (LieAlgebra.ad R (Module.Dual R (Bialgebra.CotangentSpace R H)) x))
    (hd : ∀ h : H, ∃ n,
      (Bialgebra.leftInvariantDerivation
        (Derivation.cotangentDualLieEquiv (R := R) (H := H) x))^[n] h = 0) :
    Representation.asGroupHom (Comodule.basePointsRepresentation
        (Module.Dual R (Bialgebra.CotangentSpace R H)))
        (toConv (Bialgebra.expPoint
          (Derivation.cotangentDualLieEquiv (R := R) (H := H) x) hd)) =
      LinearMap.GeneralLinearGroup.ofLinearEquiv
        (expAd x hx.exists_pow_apply_eq_zero).toLinearEquiv := by
  rw [Derivation.asGroupHom_basePointsRepresentation_adjointComodule,
    basePointsAdjointLieEquiv_expPoint (R := R) (H := H) hx hd]

end General

universe u v

attribute [local instance] Derivation.adjointComodule

section Bialgebra

/-- **An `ad`-nilpotent element of a Killing tangent Lie algebra induces a locally nilpotent
left-invariant derivation on `H`.** -/
theorem exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero
    {k H : Type*} [Field k] [CharZero k] [CommRing H] [Bialgebra k H]
    [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]
    {x : Module.Dual k (Bialgebra.CotangentSpace k H)}
    (hx : IsNilpotent (LieAlgebra.ad k (Module.Dual k (Bialgebra.CotangentSpace k H)) x)) :
    ∀ a : H, ∃ m,
      (Bialgebra.leftInvariantDerivation
        (Derivation.cotangentDualLieEquiv (R := k) (H := H) x))^[m] a = 0 :=
  Derivation.exists_iterate_leftInvariantDerivation_eq_zero_of_forall_fgComodule
    (Derivation.cotangentDualLieEquiv (R := k) (H := H) x)
    fun M => Comodule.isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad (M := M) hx

end Bialgebra

section Field

variable {k H : Type u} [Field k] [CharZero k] [CommRing H] [HopfAlgebra k H]
  [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]

local notation "𝔤" => Module.Dual k (Bialgebra.CotangentSpace k H)

/-- **The exponential `k`-point `exp x ∈ G(k)` attached to an `ad`-nilpotent element `x ∈ 𝔤`.** -/
noncomputable def expAdPoint {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) :
    WithConv (H →ₐ[k] k) :=
  letI : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
  toConv (Bialgebra.expPoint (Derivation.cotangentDualLieEquiv (R := k) (H := H) x)
    (exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero hx))

/-- **`expAdPoint` unfolds to the Taylor exponential point of `cotangentDualLieEquiv x`.** -/
theorem expAdPoint_def {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) :
    expAdPoint (H := H) hx =
      let : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
      toConv (Bialgebra.expPoint (Derivation.cotangentDualLieEquiv (R := k) (H := H) x)
        (exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero hx)) :=
  (rfl)

/-- **The exponential of `0 ∈ 𝔤` is the identity point of `G(k)`.** -/
@[simp]
theorem expAdPoint_zero (h0 : IsNilpotent (LieAlgebra.ad k 𝔤 (0 : 𝔤))) :
    expAdPoint (H := H) h0 = 1 := by
  let _ : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
  simp only [expAdPoint_def, map_zero, Bialgebra.expPoint_zero]
  rfl

/-- **On any finite-dimensional comodule, `expAdPoint hx` acts by the operator exponential of its
differentiated action.** -/
theorem Comodule.basePointsRepresentation_expAdPoint
    {M : Type v} [AddCommGroup M] [Module k M] [Module ℚ M] [FiniteDimensional k M]
    [Comodule k H M] {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) :
    Comodule.basePointsRepresentation (R := k) (H := H) M (expAdPoint (H := H) hx) =
      IsNilpotent.exp (Comodule.differential (R := k) (H := H) (M := M)
        (Derivation.cotangentDualLieEquiv (R := k) (H := H) x)) := by
  let _ : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
  exact Comodule.basePointsRepresentation_expPoint
    (exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero hx)
    (Comodule.isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad hx)

/-- **Every exponential point `expAdPoint hx` is a unipotent point of `G`.** -/
theorem isUnipotentPoint_expAdPoint {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) :
    HopfAlgebra.IsUnipotentPoint (expAdPoint (H := H) hx) := by
  let _ : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
  exact HopfAlgebra.isUnipotentPoint_expPoint _
    (exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero hx)
    fun M => Comodule.isNilpotent_differential_cotangentDualLieEquiv_of_isNilpotent_ad (M := M) hx

/-- **If `x` lies in the Lie algebra of a closed subgroup `Spec (H / I)`, then `expAdPoint hx`
lies in that subgroup's `k`-points.** -/
theorem expAdPoint_mem_quotientPointsSubgroup (I : HopfIdeal k H)
    {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x))
    (hxI : Derivation.cotangentDualLieEquiv (R := k) (H := H) x ∈ I.lieSubalgebra (B := k)) :
    expAdPoint (H := H) hx ∈
      CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of k H) I (CommAlgCat.of k k) := by
  let _ : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
  exact I.toConv_expPoint_mem_quotientPointsSubgroup hxI
    (exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero hx)

variable [Module.Finite k (Bialgebra.CotangentSpace k H)]

/-- **The adjoint action of `expAdPoint hx` on `𝔤` is the operator exponential `exp (ad x)`.** -/
@[simp]
theorem basePointsRepresentation_expAdPoint {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) :
    Comodule.basePointsRepresentation (R := k) (H := H) 𝔤 (expAdPoint hx) =
      IsNilpotent.exp (LieAlgebra.ad k 𝔤 x) := by
  rw [Comodule.basePointsRepresentation_expAdPoint (M := 𝔤) hx,
    differential_adjointComodule_cotangentDualLieEquiv]

/-- **Two `ad`-nilpotent elements have the same exponential point if and only if they are equal.**
-/
@[simp]
theorem expAdPoint_eq_iff {x y : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x))
    (hy : IsNilpotent (LieAlgebra.ad k 𝔤 y)) :
    expAdPoint (H := H) hx = expAdPoint (H := H) hy ↔ x = y := by
  refine ⟨fun h ↦ ?_, by rintro rfl; rfl⟩
  have had : IsNilpotent.exp (LieAlgebra.ad k 𝔤 x) = IsNilpotent.exp (LieAlgebra.ad k 𝔤 y) := by
    simpa [basePointsRepresentation_expAdPoint] using
      congrArg (Comodule.basePointsRepresentation (R := k) (H := H) 𝔤) h
  let _ : Algebra ℚ (Module.End k 𝔤) := Algebra.compHom (Module.End k 𝔤) (algebraMap ℚ k)
  have hexp (z : 𝔤) :
      IsNilpotent.exp (LieAlgebra.ad k 𝔤 z) =
        @IsNilpotent.exp (Module.End k 𝔤) _ Algebra.toModule (LieAlgebra.ad k 𝔤 z) := by
    congr 1; exact Subsingleton.elim _ _
  rw [hexp x, hexp y] at had
  have hlog : LieAlgebra.ad k 𝔤 x = LieAlgebra.ad k 𝔤 y := by
    simpa only [IsNilpotent.log_exp hx, IsNilpotent.log_exp hy] using
      congrArg (@IsNilpotent.log (Module.End k 𝔤) _ Algebra.toModule) had
  exact LieModule.IsFaithful.injective_toEnd (R := k) (L := 𝔤) (M := 𝔤) hlog

/-- **The exponential point of an `ad`-nilpotent element is `1` if and only if the element is `0`.**
-/
@[simp]
theorem expAdPoint_eq_one_iff {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) :
    expAdPoint (H := H) hx = 1 ↔ x = 0 := by
  rw [← expAdPoint_zero (k := k) (H := H) (by simp), expAdPoint_eq_iff]

/-- **As a Lie automorphism, `expAdPoint hx` acts on `𝔤` by `expAd x`.** -/
theorem basePointsAdjointLieEquiv_expAdPoint [LieAlgebra ℚ 𝔤]
    {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) :
    Derivation.basePointsAdjointLieEquiv (R := k) (H := H) (expAdPoint hx) =
      expAd (K := k) x hx.exists_pow_apply_eq_zero := by
  let _ : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
  rw [expAdPoint_def]
  exact basePointsAdjointLieEquiv_expPoint hx
    (exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero hx)

/-- **As a linear automorphism unit, `expAdPoint hx` acts on `𝔤` by `expAd x`.** -/
theorem toHomUnits_basePointsRepresentation_expAdPoint [LieAlgebra ℚ 𝔤]
    {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) :
    (Comodule.basePointsRepresentation (R := k) (H := H) 𝔤).toHomUnits (expAdPoint hx) =
      LinearMap.GeneralLinearGroup.ofLinearEquiv
        (expAd (K := k) x hx.exists_pow_apply_eq_zero).toLinearEquiv := by
  let _ : Algebra ℚ H := Algebra.compHom H (algebraMap ℚ k)
  simpa only [Representation.asGroupHom, expAdPoint_def] using
    asGroupHom_basePointsRepresentation_expPoint hx
      (exists_iterate_leftInvariantDerivation_cotangentDualLieEquiv_eq_zero hx)

/-- **Realization of `Int(Lie(G))` by unipotent rational points.** For an affine group `G = Spec H`
over a field `k` of characteristic zero with finite-dimensional Killing Lie algebra `𝔤`, the inner
automorphism group `Int(𝔤)` lies in the adjoint image of the subgroup of `G(k)` generated by
unipotent points. -/
theorem intLieAlgebra_le_map_asGroupHom_closure_isUnipotentPoint [LieAlgebra ℚ 𝔤] :
    intLieAlgebra k 𝔤 ≤
      (Subgroup.closure {u : WithConv (H →ₐ[k] k) | HopfAlgebra.IsUnipotentPoint u}).map
        (Representation.asGroupHom (Comodule.basePointsRepresentation 𝔤)) :=
  intLieAlgebra_le_iff.mpr fun _ hx ↦
    ⟨expAdPoint hx, Subgroup.subset_closure (isUnipotentPoint_expAdPoint hx),
      by simpa only [Representation.asGroupHom] using
        toHomUnits_basePointsRepresentation_expAdPoint hx⟩

/-- Every inner automorphism in `Int(Lie(G))` is the adjoint action of a product of unipotent
`k`-points of `G`. -/
theorem exists_mem_closure_isUnipotentPoint_ofLinearEquiv_basePointsAdjointLieEquiv_eq
    [LieAlgebra ℚ 𝔤]
    {φ : LinearMap.GeneralLinearGroup k 𝔤}
    (hφ : φ ∈ intLieAlgebra k 𝔤) :
    ∃ g ∈ Subgroup.closure {u : WithConv (H →ₐ[k] k) | HopfAlgebra.IsUnipotentPoint u},
      LinearMap.GeneralLinearGroup.ofLinearEquiv
          (Derivation.basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv = φ ∧
        ∀ y, Comodule.basePointsRepresentation 𝔤 g y = φ • y := by
  obtain ⟨g, hg, rfl⟩ := intLieAlgebra_le_map_asGroupHom_closure_isUnipotentPoint hφ
  exact ⟨g, hg, (Derivation.asGroupHom_basePointsRepresentation_adjointComodule g).symm,
    fun _ => rfl⟩

/-- **Every inner automorphism in `Int(𝔤)` is the adjoint action of a `k`-point of `G`.** -/
theorem intLieAlgebra_le_range_basePointsRepresentation [LieAlgebra ℚ 𝔤] :
    intLieAlgebra k 𝔤 ≤
      (Comodule.basePointsRepresentation (R := k) (H := H) 𝔤).toHomUnits.range :=
  intLieAlgebra_le_iff.mpr fun _ hx ↦
    ⟨expAdPoint hx, toHomUnits_basePointsRepresentation_expAdPoint hx⟩

end Field

section IsAlgClosed

variable {k : Type u} [Field k] [CharZero k] [IsAlgClosed k]
  {H : FiniteTypeCommHopfAlgCat.{u, u} k}
  [LieAlgebra.IsKilling k (Module.Dual k (Bialgebra.CotangentSpace k H))]

local notation "𝔤" => Module.Dual k (Bialgebra.CotangentSpace k H)

/-- **Over an algebraically closed field, `expAdPoint hx` lies in the identity component `G°(k)`.**
-/
theorem expAdPoint_mem_identityComponent {x : 𝔤} (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) :
    expAdPoint (H := H.obj) hx ∈
      CommHopfAlgCat.quotientPointsSubgroup H.obj
        (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k) :=
  expAdPoint_mem_quotientPointsSubgroup
    (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) hx (by
      rw [HopfIdeal.lieSubalgebra_identityComponentHopfIdeal_eq_top]
      exact LieSubalgebra.mem_top _)

/-- **If `⁅x, y⁆ = 0`, `expAdPoint hx` lies in the connected centralizer `C_G(y)°(k)`.** -/
theorem expAdPoint_mem_centralizer_identityComponent {x y : 𝔤}
    (hx : IsNilpotent (LieAlgebra.ad k 𝔤 x)) (hxy : ⁅x, y⁆ = 0) :
    expAdPoint (H := H.obj) hx ∈
      CommHopfAlgCat.quotientPointsSubgroup H.obj
        (centralizerHopfIdeal H.obj y).identityComponent (CommAlgCat.of k k) :=
  expAdPoint_mem_quotientPointsSubgroup
    (centralizerHopfIdeal H.obj y).identityComponent hx (by
      rw [(centralizerHopfIdeal H.obj y).lieSubalgebra_identityComponent,
        mem_lieSubalgebra_centralizerHopfIdeal_iff, ← LieEquiv.map_lie, ← lie_skew, hxy, neg_zero,
        map_zero])

/-- **Realization of `Int(Lie(G))` inside `Ad(G°(k))` by unipotent points.** Over an algebraically
closed field `k` of characteristic zero, for any finite-type affine group `G = Spec H` with Killing
Lie algebra `𝔤`, the inner automorphism group `Int(𝔤)` lies in the adjoint image of the subgroup
generated by unipotent `k`-points of the identity component `G°`. -/
theorem intLieAlgebra_le_map_asGroupHom_closure_identityComponentHopfIdeal_isUnipotentPoint
    [LieAlgebra ℚ 𝔤] :
    intLieAlgebra k 𝔤 ≤
      (Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
          (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k) ∧
        HopfAlgebra.IsUnipotentPoint u}).map
        (Representation.asGroupHom (Comodule.basePointsRepresentation 𝔤)) :=
  intLieAlgebra_le_iff.mpr fun _ hx ↦
    ⟨expAdPoint hx,
      Subgroup.subset_closure ⟨expAdPoint_mem_identityComponent hx, isUnipotentPoint_expAdPoint hx⟩,
      by simpa only [Representation.asGroupHom] using
        toHomUnits_basePointsRepresentation_expAdPoint hx⟩

/-- Over an algebraically closed field of characteristic zero, every inner automorphism
`φ ∈ Int(Lie(G))` is realized by a rational point of the identity component `G°` lying in the
subgroup generated by unipotent points of `G°`. -/
theorem exists_mem_identityComponentHopfIdeal_ofLinearEquiv_basePointsAdjointLieEquiv_eq
    [LieAlgebra ℚ 𝔤]
    {φ : LinearMap.GeneralLinearGroup k 𝔤}
    (hφ : φ ∈ intLieAlgebra k 𝔤) :
    ∃ g ∈ Subgroup.closure {u : WithConv (H →ₐ[k] k) |
        u ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
          (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k) ∧
        HopfAlgebra.IsUnipotentPoint u},
      g ∈ CommHopfAlgCat.quotientPointsSubgroup H.obj
          (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H)) (CommAlgCat.of k k) ∧
        LinearMap.GeneralLinearGroup.ofLinearEquiv
          (Derivation.basePointsAdjointLieEquiv (R := k) (H := H) g).toLinearEquiv = φ ∧
        ∀ y, Comodule.basePointsRepresentation 𝔤 g y = φ • y := by
  obtain ⟨g, hg, rfl⟩ :=
    intLieAlgebra_le_map_asGroupHom_closure_identityComponentHopfIdeal_isUnipotentPoint hφ
  exact ⟨g, hg, (CommHopfAlgCat.quotientPointsSubgroup H.obj
      (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H))
      (CommAlgCat.of k k)).closure_sep_le _ hg,
    (Derivation.asGroupHom_basePointsRepresentation_adjointComodule g).symm, fun _ => rfl⟩

/-- **Every inner automorphism in `Int(𝔤)` is the adjoint action of a point in `G°(k)`.** -/
theorem intLieAlgebra_le_map_quotientPointsSubgroup_identityComponent [LieAlgebra ℚ 𝔤] :
    intLieAlgebra k 𝔤 ≤
      (CommHopfAlgCat.quotientPointsSubgroup H.obj
        (HopfAlgebra.identityComponentHopfIdeal (k := k) (H := H))
        (CommAlgCat.of k k)).map
          (Comodule.basePointsRepresentation (R := k) (H := H.obj) 𝔤).toHomUnits :=
  intLieAlgebra_le_iff.mpr fun _ hx ↦
    ⟨expAdPoint hx, expAdPoint_mem_identityComponent hx,
      toHomUnits_basePointsRepresentation_expAdPoint hx⟩

end IsAlgClosed

