import TauCeti.Algebra.Bialgebra.MonoidAlgebra.Augmentation

/-!
# Fixed-point subgroup of `𝔾ₘ` under inversion is `μ₂`

On the coordinate Hopf algebra `MonoidAlgebra R (Multiplicative ℤ)` of the multiplicative group
`𝔾ₘ`, inversion `t ↦ t⁻¹` corresponds to `MonoidAlgebra.mapDomainBialgHom R (MulEquiv.inv _)`
(`ofAdd k ↦ ofAdd (-k)`). This file computes the equalizer Hopf ideal of inversion with the
identity:

1. Its underlying ideal is generated by `single (ofAdd 2) 1 - 1` (`T² - 1`), matching the defining
   ideal of `μ₂ ⊂ 𝔾ₘ` (`equalizer_inv_monoidAlgebra_int_toIdeal`,
   `equalizer_inv_monoidAlgebra_int_eq_kerOfSurjective`).
2. Quotienting `R[Multiplicative ℤ]` by this equalizer Hopf ideal yields a bialgebra canonically
   isomorphic to `R[Multiplicative (ZMod 2)]` (`quotientEqualizerInvMonoidAlgebraIntBialgEquiv`),
   compatible with the canonical coordinate surjection `𝔾ₘ ↠ μ₂`
   (`quotientEqualizerInvMonoidAlgebraIntBialgEquiv_mk`).
3. Over `R`, this inversion-fixed quotient is étale whenever `IsUnit (2 : R)`
   (`etale_quotient_equalizer_inv_monoidAlgebra_int`), and over a field `k` it is smooth if and only
   if `IsUnit (2 : k)` (`smooth_quotient_equalizer_inv_monoidAlgebra_int_iff`), illustrating the
   sharpness of the tameness hypothesis in Edixhoven's fixed-point smoothness theorem.

## Main definitions

* `TauCeti.RootsOfUnityGroup.quotientEqualizerInvMonoidAlgebraIntBialgEquiv`: the canonical
  bialgebra isomorphism between the inversion-fixed quotient of `R[Multiplicative ℤ]` (`𝔾ₘ`) and
  `R[Multiplicative (ZMod 2)]` (`μ₂`).

## Main results

* `TauCeti.RootsOfUnityGroup.equalizer_inv_monoidAlgebra_int_toIdeal`: the underlying ideal of the
  inversion equalizer on `R[Multiplicative ℤ]` is `(T² - 1)`.
* `TauCeti.RootsOfUnityGroup.quotientEqualizerInvMonoidAlgebraIntBialgEquiv_mk`: evaluating the
  isomorphism on a coset applies `MonoidAlgebra.mapDomainBialgHom R (toMultiplicativeZMod 2)`.
* `TauCeti.RootsOfUnityGroup.smooth_quotient_equalizer_inv_monoidAlgebra_int_iff`: over a field `k`,
  the inversion-fixed subgroup `μ₂ ⊂ 𝔾ₘ` is smooth if and only if `IsUnit (2 : k)`.

## References

* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), Proposition 3.4,
  p. 295.
* J. S. Milne, *Algebraic Groups*, Cambridge University Press (2017), §1.h and §12.
-/

public section

namespace TauCeti.RootsOfUnityGroup

open HopfIdeal

universe u

/-- **The fixed-point ideal of inversion on `𝔾ₘ` is `(T² - 1)`.** On the coordinate Hopf algebra
`MonoidAlgebra R (Multiplicative ℤ)` of `𝔾ₘ`, the equalizer Hopf ideal of the inversion
endomorphism `ofAdd k ↦ ofAdd (-k)` with the identity has underlying ideal generated by
`single (ofAdd 2) 1 - 1`, matching the defining ideal of `μ₂ ⊂ 𝔾ₘ`. -/
theorem equalizer_inv_monoidAlgebra_int_toIdeal (R : Type u) [CommRing R] :
    (equalizer
        (MonoidAlgebra.mapDomainBialgHom R
          (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ))
        (BialgHom.id R (MonoidAlgebra R (Multiplicative ℤ)))).toIdeal =
      Ideal.span {MonoidAlgebra.single (Multiplicative.ofAdd (2 : ℤ)) (1 : R) - 1} := by
  let invHom := MonoidAlgebra.mapDomainBialgHom R
    (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ)
  have hker := ker_mapDomainRingHom_toMultiplicativeZMod R 2
  simp only [Nat.cast_ofNat] at hker
  rw [← hker]
  refine le_antisymm ?_ ?_
  · rw [equalizer_le_ker_iff]
    intro x
    induction x using MonoidAlgebra.induction_linear with
    | zero => simp
    | add y z hy hz => rw [map_add, map_add, map_add, map_add, hy, hz]
    | single m r =>
      induction m using Multiplicative.rec with | ofAdd k => ?_
      rw [MonoidAlgebra.mapDomainBialgHom_single, BialgHom.id_apply]
      simp [← ofAdd_neg, ZMod.neg_eq_self_mod_two]
  · rw [hker, Ideal.span_singleton_le_iff_mem]
    have hmem : invHom (MonoidAlgebra.single (Multiplicative.ofAdd (1 : ℤ)) (1 : R)) -
        MonoidAlgebra.single (Multiplicative.ofAdd (1 : ℤ)) (1 : R) ∈
        (equalizer invHom (BialgHom.id R _)).toIdeal :=
      sub_mem_equalizer (MonoidAlgebra.single (Multiplicative.ofAdd (1 : ℤ)) (1 : R))
    have hmul := (equalizer invHom (BialgHom.id R _)).toIdeal.mul_mem_left
      (-MonoidAlgebra.single (Multiplicative.ofAdd (1 : ℤ)) (1 : R)) hmem
    have hcalc : -MonoidAlgebra.single (Multiplicative.ofAdd (1 : ℤ)) (1 : R) *
          (invHom (MonoidAlgebra.single (Multiplicative.ofAdd (1 : ℤ)) (1 : R)) -
            MonoidAlgebra.single (Multiplicative.ofAdd (1 : ℤ)) (1 : R)) =
        MonoidAlgebra.single (Multiplicative.ofAdd (2 : ℤ)) (1 : R) - 1 := by
      have hinv :
          (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ)
            (Multiplicative.ofAdd (1 : ℤ)) = Multiplicative.ofAdd (-1 : ℤ) := by
        simp [← ofAdd_neg]
      rw [neg_mul, mul_sub, neg_sub, MonoidAlgebra.mapDomainBialgHom_single, hinv,
        MonoidAlgebra.single_mul_single, MonoidAlgebra.single_mul_single,
        ← ofAdd_add, ← ofAdd_add, one_add_one_eq_two, add_neg_cancel, ofAdd_zero, mul_one,
        MonoidAlgebra.one_def]
    rwa [hcalc] at hmul

/-- The equalizer Hopf ideal of inversion on `𝔾ₘ` equals the kernel Hopf ideal of the canonical
coordinate surjection `R[Multiplicative ℤ] ↠ R[Multiplicative (ZMod 2)]`. -/
theorem equalizer_inv_monoidAlgebra_int_eq_kerOfSurjective (R : Type u) [CommRing R] :
    equalizer
        (MonoidAlgebra.mapDomainBialgHom R
          (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ))
        (BialgHom.id R (MonoidAlgebra R (Multiplicative ℤ))) =
      kerOfSurjective (MonoidAlgebra.mapDomainBialgHom R (toMultiplicativeZMod 2))
        (_root_.MonoidAlgebra.mapDomain_surjective (toMultiplicativeZMod_surjective 2)) := by
  have hker := ker_mapDomainRingHom_toMultiplicativeZMod R 2
  simp only [Nat.cast_ofNat] at hker
  have hEq : (equalizer
        (MonoidAlgebra.mapDomainBialgHom R
          (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ))
        (BialgHom.id R (MonoidAlgebra R (Multiplicative ℤ)))).toIdeal =
      (kerOfSurjective
        (MonoidAlgebra.mapDomainBialgHom R (toMultiplicativeZMod 2))
        (_root_.MonoidAlgebra.mapDomain_surjective (toMultiplicativeZMod_surjective 2))).toIdeal :=
    (equalizer_inv_monoidAlgebra_int_toIdeal R).trans <| hker.symm.trans <|
      (congrArg RingHom.ker
        (MonoidAlgebra.mapDomainBialgHom_toRingHom R (toMultiplicativeZMod 2)).symm).trans
        (kerOfSurjective_toIdeal _ _).symm
  exact le_antisymm (toIdeal_le_toIdeal.mp hEq.le) (toIdeal_le_toIdeal.mp hEq.ge)

/-- **Fixed-point subgroup of `𝔾ₘ` under inversion is `μ₂`.** Quotienting
`MonoidAlgebra R (Multiplicative ℤ)` by the equalizer Hopf ideal of inversion gives a bialgebra
canonically isomorphic to `MonoidAlgebra R (Multiplicative (ZMod 2))`. -/
noncomputable def quotientEqualizerInvMonoidAlgebraIntBialgEquiv (R : Type u) [CommRing R] :
    (MonoidAlgebra R (Multiplicative ℤ) ⧸
        (equalizer
          (MonoidAlgebra.mapDomainBialgHom R
            (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ))
          (BialgHom.id R (MonoidAlgebra R (Multiplicative ℤ)))).toIdeal) ≃ₐc[R]
      MonoidAlgebra R (Multiplicative (ZMod 2)) :=
  _root_.CommHopfAlgCat.ofIso
    (CommHopfAlgCat.Hom.quotientIsoOfKerOfSurjectiveEq
      (H := _root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative ℤ)))
      (K := _root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative (ZMod 2))))
      (_root_.CommHopfAlgCat.ofHom
        (MonoidAlgebra.mapDomainBialgHom R (toMultiplicativeZMod 2)))
      (_root_.MonoidAlgebra.mapDomain_surjective (toMultiplicativeZMod_surjective 2))
      (equalizer_inv_monoidAlgebra_int_eq_kerOfSurjective R).symm)

/-- `quotientEqualizerInvMonoidAlgebraIntBialgEquiv` acts on quotient classes via the coordinate
surjection `MonoidAlgebra.mapDomainBialgHom R (toMultiplicativeZMod 2)`. -/
@[simp]
theorem quotientEqualizerInvMonoidAlgebraIntBialgEquiv_mk (R : Type u) [CommRing R]
    (x : MonoidAlgebra R (Multiplicative ℤ)) :
    quotientEqualizerInvMonoidAlgebraIntBialgEquiv R
        (Ideal.Quotient.mk
          (equalizer
            (MonoidAlgebra.mapDomainBialgHom R
              (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ))
            (BialgHom.id R (MonoidAlgebra R (Multiplicative ℤ)))).toIdeal x) =
      MonoidAlgebra.mapDomainBialgHom R (toMultiplicativeZMod 2) x := by
  have h := CommHopfAlgCat.Hom.mkQuotient_comp_quotientIsoOfKerOfSurjectiveEq_hom
    (H := _root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative ℤ)))
    (K := _root_.CommHopfAlgCat.of R (MonoidAlgebra R (Multiplicative (ZMod 2))))
    (_root_.CommHopfAlgCat.ofHom (MonoidAlgebra.mapDomainBialgHom R (toMultiplicativeZMod 2)))
    (_root_.MonoidAlgebra.mapDomain_surjective (toMultiplicativeZMod_surjective 2))
    (equalizer_inv_monoidAlgebra_int_eq_kerOfSurjective R).symm
  have hx := congrArg (fun m ↦ m.hom x) h
  simpa only [_root_.CommHopfAlgCat.hom_comp, BialgHom.comp_apply, _root_.CommHopfAlgCat.hom_ofHom,
    CommHopfAlgCat.hom_mkQuotient, Bialgebra.Quotient.mkBialgHom_apply,
    quotientEqualizerInvMonoidAlgebraIntBialgEquiv, ← TauCeti.CommHopfAlgCat.coe_ofIso,
    BialgEquiv.coe_toBialgHom] using hx

/-- On basis elements, `quotientEqualizerInvMonoidAlgebraIntBialgEquiv` sends the coset of
`single (ofAdd k) r` to `single (ofAdd (k : ZMod 2)) r`.
Not `@[simp]` because `quotientEqualizerInvMonoidAlgebraIntBialgEquiv_mk` already simplifies the
left-hand side. -/
theorem quotientEqualizerInvMonoidAlgebraIntBialgEquiv_mk_single (R : Type u) [CommRing R]
    (k : ℤ) (r : R) :
    quotientEqualizerInvMonoidAlgebraIntBialgEquiv R
        (Ideal.Quotient.mk
          (equalizer
            (MonoidAlgebra.mapDomainBialgHom R
              (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ))
            (BialgHom.id R (MonoidAlgebra R (Multiplicative ℤ)))).toIdeal
          (MonoidAlgebra.single (Multiplicative.ofAdd k) r)) =
      MonoidAlgebra.single (Multiplicative.ofAdd (k : ZMod 2)) r := by
  simp

/-- The inverse of `quotientEqualizerInvMonoidAlgebraIntBialgEquiv` lifts
`single (ofAdd (k : ZMod 2)) r` to the coset of `single (ofAdd k) r`. -/
@[simp]
theorem quotientEqualizerInvMonoidAlgebraIntBialgEquiv_symm_single_ofAdd_intCast
    (R : Type u) [CommRing R] (k : ℤ) (r : R) :
    (quotientEqualizerInvMonoidAlgebraIntBialgEquiv R).symm
        (MonoidAlgebra.single (Multiplicative.ofAdd (k : ZMod 2)) r) =
      Ideal.Quotient.mk
        (equalizer
          (MonoidAlgebra.mapDomainBialgHom R
            (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ))
          (BialgHom.id R (MonoidAlgebra R (Multiplicative ℤ)))).toIdeal
        (MonoidAlgebra.single (Multiplicative.ofAdd k) r) :=
  (quotientEqualizerInvMonoidAlgebraIntBialgEquiv R).symm_apply_eq.mpr
    (quotientEqualizerInvMonoidAlgebraIntBialgEquiv_mk_single R k r).symm

/-- When `2` is invertible in `R`, the inversion-fixed quotient of `𝔾ₘ` is étale (hence smooth)
over `R`. -/
theorem etale_quotient_equalizer_inv_monoidAlgebra_int (R : Type u) [CommRing R]
    (h2 : IsUnit (2 : R)) :
    Algebra.Etale R
      (MonoidAlgebra R (Multiplicative ℤ) ⧸
        (equalizer
          (MonoidAlgebra.mapDomainBialgHom R
            (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ))
          (BialgHom.id R (MonoidAlgebra R (Multiplicative ℤ)))).toIdeal) := by
  have _ : Algebra.Etale R (MonoidAlgebra R (Multiplicative (ZMod 2))) :=
    MonoidAlgebra.etale_of_isUnit_card R (Multiplicative (ZMod 2))
      (by simpa [Nat.card_eq_fintype_card, Fintype.card_multiplicative] using h2)
  exact Algebra.Etale.of_equiv (quotientEqualizerInvMonoidAlgebraIntBialgEquiv R).symm.toAlgEquiv

/-- **Sharpness of tameness for inversion on `𝔾ₘ`.** Over a field `k`, the inversion-fixed subgroup
quotient of `𝔾ₘ` (`μ₂`) is smooth over `k` if and only if `2` is invertible in `k`. -/
theorem smooth_quotient_equalizer_inv_monoidAlgebra_int_iff (k : Type u) [Field k] :
    Algebra.Smooth k
      (MonoidAlgebra k (Multiplicative ℤ) ⧸
        (equalizer
          (MonoidAlgebra.mapDomainBialgHom k
            (MulEquiv.inv (Multiplicative ℤ) : Multiplicative ℤ →* Multiplicative ℤ))
          (BialgHom.id k (MonoidAlgebra k (Multiplicative ℤ)))).toIdeal) ↔
      IsUnit (2 : k) := by
  let e := (quotientEqualizerInvMonoidAlgebraIntBialgEquiv k).toAlgEquiv
  refine ⟨fun hs ↦ ?_, fun h2 ↦ ?_⟩
  · have hs' : Algebra.Smooth k (MonoidAlgebra k (Multiplicative (ZMod 2))) :=
      Algebra.Smooth.of_equiv e
    simpa [Nat.card_eq_fintype_card, Fintype.card_multiplicative] using
      (MonoidAlgebra.smooth_iff_isUnit_card k (Multiplicative (ZMod 2))).mp hs'
  · have _ := etale_quotient_equalizer_inv_monoidAlgebra_int k h2
    infer_instance

end TauCeti.RootsOfUnityGroup
