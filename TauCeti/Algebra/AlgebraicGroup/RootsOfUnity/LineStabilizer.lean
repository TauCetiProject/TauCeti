/-!
# `μ_n` as the stabilizer of a point of the projective line

The multiplicative group `𝔾ₘ = D(ℤ)` acts on `k²` by `t · (u, v) = (tⁿ u, v)`, that is, on the
projective line by `t · [u : v] = [tⁿ u : v]`. This is the diagonal representation with weights
`n` and `0`. This file computes the scheme-theoretic stabilizer of the point `[1 : 1]`: it is
`μ_n`, embedded in `𝔾ₘ` as the closed subgroup cut out by `Tⁿ - 1`.

The defining ideal of `μ_n ⊂ 𝔾ₘ`, the kernel of the coordinate surjection
`k[ℤ] ↠ k[ℤ/n]`, is generated by `Tⁿ - 1`
(`TauCeti.RootsOfUnityGroup.ker_mapDomainRingHom_toMultiplicativeZMod`). The stabilizer
computation is the case of two weight vectors in
`Submodule.stabilizerHopfIdeal_span_singleton_add_toIdeal`.

For `n ≠ 0` the stabilizer is smooth exactly when `n` is invertible in `k`. For `n = p` in
characteristic `p` it is the nonsmooth group `μ_p`, and its Lie algebra is all of `Lie 𝔾ₘ`,
since every tangent vector kills `Tᵖ`; equivalently, the orbit map of `[1 : 1]` has zero
differential at the identity. So in positive characteristic the differential of an orbit map
need not detect the dimension of the orbit, and a scheme-theoretic stabilizer need not be
smooth.

## Main declarations

* `TauCeti.RootsOfUnityGroup.ker_mapDomainRingHom_toMultiplicativeZMod`: the ideal of
  `μ_n ⊂ 𝔾ₘ` is `(Tⁿ - 1)`.
* `TauCeti.RootsOfUnityGroup.stabilizerHopfIdeal_ofWeights_toIdeal`: for
  `t · [u : v] = [tⁿ u : v]`, the stabilizer of `[1 : 1]` is `μ_n`.
* `TauCeti.RootsOfUnityGroup.smooth_quotient_stabilizerHopfIdeal_ofWeights_iff`: for `n ≠ 0`,
  this stabilizer is smooth exactly when `n` is invertible in `k`.
* `TauCeti.RootsOfUnityGroup.lieSubalgebra_stabilizerHopfIdeal_ofWeights_eq_top`: when `n = 0`
  in `k`, its Lie algebra is all of `Lie 𝔾ₘ`.

## References

* J. S. Milne, *Algebraic Groups* (2017), §§7.c–7.f, §12.c and Example 7.17.
* A. Borel, *Linear Algebraic Groups*, 2nd ed. (1991), §6.7.
-/

public section

open TauCeti

open scoped TensorProduct

universe u

noncomputable section

namespace TauCeti.RootsOfUnityGroup

section Ring

variable (R : Type u) [CommRing R]

/-- **The ideal of `μ_n` in `𝔾ₘ` is generated by `Tⁿ - 1`.** The kernel of the coordinate
surjection `R[ℤ] ↠ R[ℤ/n]` of the inclusion `μ_n ↪ 𝔾ₘ` is spanned by the single element
`Tⁿ - 1`. -/
theorem ker_mapDomainRingHom_toMultiplicativeZMod (n : ℕ) :
    RingHom.ker (MonoidAlgebra.mapDomainRingHom R (toMultiplicativeZMod n)) =
      Ideal.span {MonoidAlgebra.single (Multiplicative.ofAdd (n : ℤ)) (1 : R) - 1} := by
  set x := MonoidAlgebra.single (Multiplicative.ofAdd (n : ℤ)) (1 : R)
  rw [MonoidAlgebra.ker_mapDomainRingHom_eq_span]
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_le]
    rintro _ ⟨⟨g, hg⟩, rfl⟩
    have hd := hg
    rw [MonoidHom.mem_ker, ← ofAdd_toAdd g, toMultiplicativeZMod_ofAdd, ofAdd_eq_one,
      ZMod.intCast_zmod_eq_zero_iff_dvd] at hd
    obtain ⟨j, hj⟩ := hd
    obtain rfl : g = Multiplicative.ofAdd ((n : ℤ) * j) := by rw [← hj, ofAdd_toAdd]
    dsimp only
    -- `T^(n m) = xᵐ` for every natural number `m`.
    have hpow (m : ℕ) :
        MonoidAlgebra.single (Multiplicative.ofAdd ((n : ℤ) * m)) (1 : R) = x ^ m := by
      rw [MonoidAlgebra.single_pow, one_pow, ← ofAdd_nsmul, nsmul_eq_mul, mul_comm]
    have hmem (m : ℕ) : x ^ m - 1 ∈ Ideal.span {x - 1} :=
      Ideal.mem_span_singleton.mpr (sub_one_dvd_pow_sub_one x m)
    obtain ⟨m, rfl | rfl⟩ := Int.eq_nat_or_neg j
    · rw [hpow]
      exact hmem m
    · -- `T^(-n m) - 1 = -T^(-n m) (T^(n m) - 1)`, since `T^(-n m) T^(n m) = 1`.
      have hinv : MonoidAlgebra.single (Multiplicative.ofAdd ((n : ℤ) * -m)) (1 : R) * x ^ m =
          1 := by
        rw [← hpow, MonoidAlgebra.single_mul_single, ← ofAdd_add, one_mul, mul_neg,
          neg_add_cancel, ofAdd_zero, MonoidAlgebra.one_def]
      have h : MonoidAlgebra.single (Multiplicative.ofAdd ((n : ℤ) * -m)) (1 : R) - 1 =
          -MonoidAlgebra.single (Multiplicative.ofAdd ((n : ℤ) * -m)) (1 : R) * (x ^ m - 1) := by
        linear_combination hinv
      rw [h]
      exact Ideal.mul_mem_left _ _ (hmem m)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    refine Ideal.subset_span ⟨⟨Multiplicative.ofAdd (n : ℤ), ?_⟩, rfl⟩
    rw [MonoidHom.mem_ker, toMultiplicativeZMod_ofAdd, Int.cast_natCast, ZMod.natCast_self,
      ofAdd_zero]

end Ring

section Field

variable {k : Type u} [Field k]

/-- The two coordinate vectors are linearly independent, in the form used for the line through
their sum. -/
private theorem linearIndependent_basisFun_pair :
    LinearIndependent k ![Pi.basisFun k (Fin 2) 0, Pi.basisFun k (Fin 2) 1] := by
  convert (Pi.basisFun k (Fin 2)).linearIndependent using 1
  ext i : 1
  fin_cases i <;> rfl

/-- The point `[1 : 1]` is the line through the sum of the two coordinate vectors. -/
private theorem one_eq_basisFun_add :
    (1 : Fin 2 → k) = Pi.basisFun k (Fin 2) 0 + Pi.basisFun k (Fin 2) 1 := by
  ext i
  fin_cases i <;> simp

/-- The first coordinate vector has weight `n`. -/
private theorem ofWeights_coact_basisFun_zero (n : ℕ) :
    letI : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) :=
      Comodule.ofWeights (Pi.basisFun k (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1]
    Comodule.coact (R := k) (C := MonoidAlgebra k (Multiplicative ℤ))
        (Pi.basisFun k (Fin 2) 0) =
      Pi.basisFun k (Fin 2) 0 ⊗ₜ[k] MonoidAlgebra.single (Multiplicative.ofAdd (n : ℤ)) 1 :=
  Comodule.ofWeights_coact_basis _ _ 0

/-- The second coordinate vector has weight `0`. -/
private theorem ofWeights_coact_basisFun_one (n : ℕ) :
    letI : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) :=
      Comodule.ofWeights (Pi.basisFun k (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1]
    Comodule.coact (R := k) (C := MonoidAlgebra k (Multiplicative ℤ))
        (Pi.basisFun k (Fin 2) 1) =
      Pi.basisFun k (Fin 2) 1 ⊗ₜ[k] (1 : MonoidAlgebra k (Multiplicative ℤ)) :=
  Comodule.ofWeights_coact_basis _ _ 1

/-- **`μ_n` is the stabilizer of `[1 : 1]` under `t · [u : v] = [tⁿ u : v]`.** For the
representation of `𝔾ₘ = D(ℤ)` on `k²` with weights `n` and `0`, the scheme-theoretic stabilizer
of the line through `(1, 1)` is the closed subgroup `μ_n`, the kernel of the coordinate surjection
`k[ℤ] ↠ k[ℤ/n]`. -/
theorem stabilizerHopfIdeal_ofWeights_toIdeal (n : ℕ) :
    letI : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) :=
      Comodule.ofWeights (Pi.basisFun k (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1]
    ((k ∙ (1 : Fin 2 → k)).stabilizerHopfIdeal (MonoidAlgebra k (Multiplicative ℤ))).toIdeal =
      RingHom.ker (MonoidAlgebra.mapDomainRingHom k (toMultiplicativeZMod n)) := by
  let : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) :=
    Comodule.ofWeights (Pi.basisFun k (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1]
  rw [ker_mapDomainRingHom_toMultiplicativeZMod, one_eq_basisFun_add]
  exact Submodule.stabilizerHopfIdeal_span_singleton_add_toIdeal _
    linearIndependent_basisFun_pair (ofWeights_coact_basisFun_zero n)
    (ofWeights_coact_basisFun_one n)

/-- **The stabilizer of `[1 : 1]` is smooth exactly when `n` is invertible.** For `n ≠ 0` and
the action `t · [u : v] = [tⁿ u : v]` of `𝔾ₘ`, the coordinate algebra of the stabilizer of
`[1 : 1]` is smooth if and only if `n` is a unit in `k`. In characteristic `p` the stabilizer
`μ_p` of the action `t · [u : v] = [tᵖ u : v]` is therefore not smooth. -/
theorem smooth_quotient_stabilizerHopfIdeal_ofWeights_iff (n : ℕ) [NeZero n] :
    letI : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) :=
      Comodule.ofWeights (Pi.basisFun k (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1]
    Algebra.Smooth k (MonoidAlgebra k (Multiplicative ℤ) ⧸
        ((k ∙ (1 : Fin 2 → k)).stabilizerHopfIdeal
          (MonoidAlgebra k (Multiplicative ℤ))).toIdeal) ↔
      IsUnit (n : k) := by
  let : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) :=
    Comodule.ofWeights (Pi.basisFun k (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1]
  -- The stabilizer's coordinate algebra is the group algebra `k[ℤ/n]`.
  let e := (Ideal.quotientEquivAlgOfEq k (stabilizerHopfIdeal_ofWeights_toIdeal n)).trans
    (Ideal.quotientKerAlgEquivOfSurjective (f := MonoidAlgebra.mapDomainAlgHom k k
      (toMultiplicativeZMod n))
      (MonoidAlgebra.mapDomain_surjective (toMultiplicativeZMod_surjective n)))
  have hcard : Nat.card (Multiplicative (ZMod n)) = n :=
    (Nat.card_congr Multiplicative.toAdd).trans (Nat.card_zmod n)
  have hsmooth := MonoidAlgebra.smooth_iff_isUnit_card k (Multiplicative (ZMod n))
  rw [hcard] at hsmooth
  rw [← hsmooth]
  exact ⟨fun _ ↦ .of_equiv e, fun _ ↦ .of_equiv e.symm⟩

/-- **The orbit map of `[1 : 1]` has zero differential when `n = 0` in `k`.** If `n` vanishes in
`k`, for instance `n = p` in characteristic `p`, then every tangent vector of `𝔾ₘ` lies in the Lie
algebra of the stabilizer of `[1 : 1]` under `t · [u : v] = [tⁿ u : v]`, although for `n ≠ 0`
this stabilizer is the proper subgroup `μ_n`. -/
theorem lieSubalgebra_stabilizerHopfIdeal_ofWeights_eq_top {n : ℕ} (hn : (n : k) = 0) :
    letI : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) :=
      Comodule.ofWeights (Pi.basisFun k (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1]
    ((k ∙ (1 : Fin 2 → k)).stabilizerHopfIdeal
      (MonoidAlgebra k (Multiplicative ℤ))).lieSubalgebra (B := k) = ⊤ := by
  let : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) :=
    Comodule.ofWeights (Pi.basisFun k (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1]
  rw [one_eq_basisFun_add]
  refine eq_top_iff.mpr fun d _ ↦ ?_
  rw [Submodule.mem_lieSubalgebra_stabilizerHopfIdeal_span_singleton_add_iff
    (linearIndependent_basisFun_pair (k := k)) (ofWeights_coact_basisFun_zero (k := k) n)
    (ofWeights_coact_basisFun_one (k := k) n)]
  -- `Tⁿ` is the `n`th power of `T`, so `d (Tⁿ) = n • Tⁿ⁻¹ • d T = 0`.
  have hT : MonoidAlgebra.single (Multiplicative.ofAdd (n : ℤ)) (1 : k) =
      MonoidAlgebra.single (Multiplicative.ofAdd (1 : ℤ)) 1 ^ n := by
    rw [MonoidAlgebra.single_pow, one_pow, ← ofAdd_nsmul, nsmul_one]
  rw [hT, Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul k, hn, zero_smul,
    Derivation.map_one_eq_zero]

end Field

end TauCeti.RootsOfUnityGroup
