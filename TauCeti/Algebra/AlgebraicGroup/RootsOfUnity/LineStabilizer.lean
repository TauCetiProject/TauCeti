/-!
# `μ_n` as the stabilizer of a point of the projective line

The multiplicative group `𝔾ₘ = D(ℤ)` acts on `k²` by `t · (u, v) = (tⁿ u, v)`, that is, on the
projective line by `t · [u : v] = [tⁿ u : v]`. This is the diagonal representation with weights
`n` and `0`. This file computes the scheme-theoretic stabilizer of the point `[1 : 1]`: it is
`μ_n`, embedded in `𝔾ₘ` as the closed subgroup cut out by `Tⁿ - 1`.

The defining ideal of `μ_n ⊂ 𝔾ₘ`, the kernel of the coordinate surjection
`k[ℤ] ↠ k[ℤ/n]`, is generated by `Tⁿ - 1`
(`TauCeti.RootsOfUnityGroup.ker_mapDomainRingHom_toMultiplicativeZMod`). The stabilizer
computation is the case of two weight vectors in
`Submodule.stabilizerHopfIdeal_span_singleton_add_toIdeal`.

For `n ≠ 0` the stabilizer is smooth exactly when `n` is invertible in `k`. For `n = p` in
characteristic `p` it is the nonsmooth group `μ_p`, and its Lie algebra is all of `Lie 𝔾ₘ`,
since every tangent vector kills `Tᵖ`; equivalently, the orbit map of `[1 : 1]` has zero
differential at the identity. So in positive characteristic the differential of an orbit map
need not detect the dimension of the orbit, and a scheme-theoretic stabilizer need not be
smooth.

## Main declarations

* `TauCeti.RootsOfUnityGroup.projLineComodule`: the representation `t · (u, v) = (tⁿ u, v)` of
  `𝔾ₘ` on `R²`, diagonal with weights `n` and `0`.
* `TauCeti.RootsOfUnityGroup.projLineComodule_def`: it is `Comodule.ofWeights` for the standard
  basis with weights `n` and `0`.
* `TauCeti.RootsOfUnityGroup.projLineComodule_coact_basisFun_zero` and
  `TauCeti.RootsOfUnityGroup.projLineComodule_coact_basisFun_one`: its coaction on the two
  coordinate vectors.
* `TauCeti.RootsOfUnityGroup.stabilizerHopfIdeal_projLineComodule_toIdeal`: for
  `t · [u : v] = [tⁿ u : v]`, the stabilizer of `[1 : 1]` is `μ_n`.
* `TauCeti.RootsOfUnityGroup.smooth_quotient_stabilizerHopfIdeal_projLineComodule_iff`: for
  `n ≠ 0`, this stabilizer is smooth exactly when `n` is invertible in `k`.
* `TauCeti.RootsOfUnityGroup.lieSubalgebra_stabilizerHopfIdeal_projLineComodule_eq_top`: when
  `n = 0` in `k`, its Lie algebra is all of `Lie 𝔾ₘ`.

## References

* J. S. Milne, *Algebraic Groups* (2017), §§7.c–7.f, §12.c and Example 7.17.
* A. Borel, *Linear Algebraic Groups*, 2nd ed. (1991), §6.7.
-/

public section

open TauCeti

open scoped TensorProduct

universe u

noncomputable section

namespace TauCeti.RootsOfUnityGroup

section Ring

variable (R : Type u) [CommSemiring R]

/-- The representation `t · (u, v) = (tⁿ u, v)` of `𝔾ₘ = D(ℤ)` on `R²`: the comodule structure
over `R[ℤ]` that is diagonal in the standard basis with weights `n` and `0`. It induces the action
`t · [u : v] = [tⁿ u : v]` on the projective line. -/
@[instance_reducible] noncomputable def projLineComodule (n : ℕ) :
    Comodule R (MonoidAlgebra R (Multiplicative ℤ)) (Fin 2 → R) :=
  Comodule.ofWeights (Pi.basisFun R (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1]

/-- `projLineComodule` is the diagonal comodule `Comodule.ofWeights` with weights `n` and `0`,
so the general `Comodule.ofWeights` API applies to it. -/
theorem projLineComodule_def (n : ℕ) :
    projLineComodule R n =
      Comodule.ofWeights (Pi.basisFun R (Fin 2)) ![Multiplicative.ofAdd (n : ℤ), 1] :=
  (rfl)

/-- The first coordinate vector has weight `n`. -/
theorem projLineComodule_coact_basisFun_zero (n : ℕ) :
    letI := projLineComodule R n
    Comodule.coact (R := R) (C := MonoidAlgebra R (Multiplicative ℤ))
        (Pi.basisFun R (Fin 2) 0) =
      Pi.basisFun R (Fin 2) 0 ⊗ₜ[R] MonoidAlgebra.single (Multiplicative.ofAdd (n : ℤ)) 1 :=
  Comodule.ofWeights_coact_basis _ _ 0

/-- The second coordinate vector has weight `0`. -/
theorem projLineComodule_coact_basisFun_one (n : ℕ) :
    letI := projLineComodule R n
    Comodule.coact (R := R) (C := MonoidAlgebra R (Multiplicative ℤ))
        (Pi.basisFun R (Fin 2) 1) =
      Pi.basisFun R (Fin 2) 1 ⊗ₜ[R] (1 : MonoidAlgebra R (Multiplicative ℤ)) :=
  Comodule.ofWeights_coact_basis _ _ 1

end Ring

section Field

variable {k : Type u} [Field k]

/-- **`μ_n` is the stabilizer of `[1 : 1]` under `t · [u : v] = [tⁿ u : v]`.** For the
representation of `𝔾ₘ = D(ℤ)` on `k²` with weights `n` and `0`, the scheme-theoretic stabilizer
of the line through `(1, 1)` is the closed subgroup `μ_n`, the kernel of the coordinate surjection
`k[ℤ] ↠ k[ℤ/n]`. -/
theorem stabilizerHopfIdeal_projLineComodule_toIdeal (n : ℕ) :
    letI := projLineComodule k n
    ((k ∙ (1 : Fin 2 → k)).stabilizerHopfIdeal (MonoidAlgebra k (Multiplicative ℤ))).toIdeal =
      RingHom.ker (MonoidAlgebra.mapDomainRingHom k (toMultiplicativeZMod n)) := by
  let : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) := projLineComodule k n
  -- `[1 : 1]` is the line through the sum of the two coordinate vectors.
  rw [ker_mapDomainRingHom_toMultiplicativeZMod,
    show (1 : Fin 2 → k) = Pi.basisFun k (Fin 2) 0 + Pi.basisFun k (Fin 2) 1 by
      simpa [Fin.sum_univ_two] using (Finset.univ_sum_single (1 : Fin 2 → k)).symm]
  exact Submodule.stabilizerHopfIdeal_span_singleton_add_toIdeal _
    (FinVec.etaExpand_eq (Pi.basisFun k (Fin 2)) ▸ (Pi.basisFun k (Fin 2)).linearIndependent)
    (projLineComodule_coact_basisFun_zero k n) (projLineComodule_coact_basisFun_one k n)

/-- **The stabilizer of `[1 : 1]` is smooth exactly when `n` is invertible.** For `n ≠ 0` and
the action `t · [u : v] = [tⁿ u : v]` of `𝔾ₘ`, the coordinate algebra of the stabilizer of
`[1 : 1]` is smooth if and only if `n` is a unit in `k`. In characteristic `p` the stabilizer
`μ_p` of the action `t · [u : v] = [tᵖ u : v]` is therefore not smooth. -/
theorem smooth_quotient_stabilizerHopfIdeal_projLineComodule_iff (n : ℕ) [NeZero n] :
    letI := projLineComodule k n
    Algebra.Smooth k (MonoidAlgebra k (Multiplicative ℤ) ⧸
        ((k ∙ (1 : Fin 2 → k)).stabilizerHopfIdeal
          (MonoidAlgebra k (Multiplicative ℤ))).toIdeal) ↔
      IsUnit (n : k) := by
  let : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) := projLineComodule k n
  -- The stabilizer's coordinate algebra is the group algebra `k[ℤ/n]`.
  let e := (Ideal.quotientEquivAlgOfEq k (stabilizerHopfIdeal_projLineComodule_toIdeal n)).trans
    (Ideal.quotientKerAlgEquivOfSurjective (f := MonoidAlgebra.mapDomainAlgHom k k
      (toMultiplicativeZMod n))
      (MonoidAlgebra.mapDomain_surjective (toMultiplicativeZMod_surjective n)))
  have hcard : Nat.card (Multiplicative (ZMod n)) = n :=
    (Nat.card_congr Multiplicative.toAdd).trans (Nat.card_zmod n)
  have hsmooth := MonoidAlgebra.smooth_iff_isUnit_card k (Multiplicative (ZMod n))
  rw [hcard] at hsmooth
  rw [← hsmooth]
  exact ⟨fun _ ↦ .of_equiv e, fun _ ↦ .of_equiv e.symm⟩

/-- **The orbit map of `[1 : 1]` has zero differential when `n = 0` in `k`.** If `n` vanishes in
`k`, for instance `n = p` in characteristic `p`, then every tangent vector of `𝔾ₘ` lies in the Lie
algebra of the stabilizer of `[1 : 1]` under `t · [u : v] = [tⁿ u : v]`, with values in any
commutative `k`-algebra `B`, although for `n ≠ 0` this stabilizer is the proper subgroup `μ_n`. -/
theorem lieSubalgebra_stabilizerHopfIdeal_projLineComodule_eq_top {n : ℕ} (hn : (n : k) = 0)
    (B : Type*) [CommRing B] [Algebra k B] :
    letI := projLineComodule k n
    ((k ∙ (1 : Fin 2 → k)).stabilizerHopfIdeal
      (MonoidAlgebra k (Multiplicative ℤ))).lieSubalgebra (B := B) = ⊤ := by
  let : Comodule k (MonoidAlgebra k (Multiplicative ℤ)) (Fin 2 → k) := projLineComodule k n
  refine eq_top_iff.mpr fun d _ ↦ ?_
  -- The stabilizer ideal is spanned by `Tⁿ - 1`, so it suffices that `d (Tⁿ - 1) = 0`.
  rw [HopfIdeal.mem_lieSubalgebra_iff_of_toIdeal_eq_span _
    ((stabilizerHopfIdeal_projLineComodule_toIdeal n).trans
      (ker_mapDomainRingHom_toMultiplicativeZMod k n)),
    Set.forall_mem_singleton, map_sub, Derivation.map_one_eq_zero, sub_zero]
  -- `Tⁿ` is the `n`th power of `T`, so `d (Tⁿ) = n • Tⁿ⁻¹ • d T = 0`.
  have hT : MonoidAlgebra.single (Multiplicative.ofAdd (n : ℤ)) (1 : k) =
      MonoidAlgebra.single (Multiplicative.ofAdd (1 : ℤ)) 1 ^ n := by
    rw [MonoidAlgebra.single_pow, one_pow, ← ofAdd_nsmul, nsmul_one]
  rw [hT, Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul k, hn, zero_smul]

end Field

end TauCeti.RootsOfUnityGroup
