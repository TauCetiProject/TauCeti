public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.OpenImmersion
public import TauCeti.Algebra.AlgebraicGroup.RootsOfUnity.Basic
public import TauCeti.RingTheory.Polynomial.Cyclotomic.Separable

/-!
# The scheme of primitive `n`th roots of unity

For a commutative ring `R` and `n > 0`, the scheme of primitive `n`th roots of unity is

`μ_n^prim = Spec R[X]/(Φ_n)`,

where `Φ_n` is the `n`th cyclotomic polynomial. Its points with values in an `R`-algebra `A` are
the roots of `Φ_n` in `A`. Since `Φ_n` divides `X ^ n - 1`, the root of `Φ_n` in `R[X]/(Φ_n)` is
an `n`th root of unity (`TauCeti.RootsOfUnityGroup.universalPrimitiveRoot`), and so it defines a
point of `μ_n = Spec R[Multiplicative (ZMod n)]` with values in `R[X]/(Φ_n)`. Its coordinate map
`TauCeti.RootsOfUnityGroup.primitiveRootsMap : R[Multiplicative (ZMod n)] →ₐ[R] R[X]/(Φ_n)`
sends the standard generator to the root of `Φ_n`. It is surjective, so `μ_n^prim → μ_n` is a
closed immersion.

When `n` is invertible in `R`, `Φ_n` is coprime to `(X ^ n - 1) / Φ_n`, and the kernel of
`primitiveRootsMap` is generated by an idempotent. Hence `μ_n^prim` is then also open in `μ_n`:
it is an open and closed subscheme. Its points are the exact-order-`n` locus of `μ_n`: a point of
`μ_n` with values in `A`, that is an `n`th root of unity `ζ ∈ A`, lies in `μ_n^prim` exactly when
`ζ` is a root of `Φ_n`, and, if `n` is invertible in `A`, exactly when the image of `ζ` in
`A ⧸ p` is a primitive `n`th root of unity for every prime ideal `p` of `A`. The scheme
`μ_n^prim` is finite and free over `R`, of rank `φ(n)` when `R` is nontrivial
(`Polynomial.finrank_adjoinRoot_cyclotomic`), and étale over `R` when `n` is invertible
(`Polynomial.etale_adjoinRoot_cyclotomic`).

Over a base on which `n` is invertible, the Weil pairing of a basis of the `n`-torsion of an
elliptic curve is a primitive `n`th root of unity, so `μ_n^prim` is the target of the determinant
of a full level-`n` structure, and a section of `μ_n^prim` fixes that determinant.

## Main definitions

* `TauCeti.RootsOfUnityGroup.universalPrimitiveRoot`: the root of `Φ_n` in `R[X]/(Φ_n)`, as an
  `n`th root of unity.
* `TauCeti.RootsOfUnityGroup.primitiveRootsMap`: the coordinate map
  `R[Multiplicative (ZMod n)] →ₐ[R] R[X]/(Φ_n)` of the inclusion `μ_n^prim → μ_n`.

## Main results

* `TauCeti.RootsOfUnityGroup.primitiveRootsMap_surjective` and
  `TauCeti.RootsOfUnityGroup.isClosedImmersion_primitiveRootsMap`: `μ_n^prim → μ_n` is a closed
  immersion.
* `TauCeti.RootsOfUnityGroup.exists_isIdempotentElem_ker_primitiveRootsMap` and
  `TauCeti.RootsOfUnityGroup.isOpenImmersion_primitiveRootsMap`: if `n` is invertible, it is also
  an open immersion.
* `TauCeti.RootsOfUnityGroup.exists_comp_primitiveRootsMap_iff`: a point of `μ_n` lies in
  `μ_n^prim` exactly when its root of unity is a root of `Φ_n`;
  `TauCeti.RootsOfUnityGroup.exists_comp_primitiveRootsMap_iff_forall_isPrimitiveRoot` is the
  fibrewise form when `n` is invertible.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, Annals of Mathematics Studies
  108, Princeton University Press, 1985, where `μ_N^prim` receives the determinant of the Weil
  pairing on a level-`N` structure.
-/

public section

open Polynomial WithConv AlgebraicGeometry

namespace TauCeti

namespace RootsOfUnityGroup

universe u v

section

variable (R : Type u) [CommRing R] (n : ℕ) [NeZero n]

/-- The root of the cyclotomic polynomial `Φ_n` in `R[X]/(Φ_n)`, as an `n`th root of unity: the
universal primitive `n`th root of unity. -/
noncomputable def universalPrimitiveRoot : rootsOfUnity n (AdjoinRoot (cyclotomic n R)) :=
  rootsOfUnity.mkOfPowEq (AdjoinRoot.root (cyclotomic n R)) <| by
    rw [← sub_eq_zero]
    simpa using AdjoinRoot.mk_eq_zero.mpr (cyclotomic.dvd_X_pow_sub_one n R)

/-- The universal primitive `n`th root of unity is the root of `Φ_n`. -/
@[simp]
theorem coe_universalPrimitiveRoot :
    ((universalPrimitiveRoot R n : (AdjoinRoot (cyclotomic n R))ˣ) : AdjoinRoot (cyclotomic n R)) =
      AdjoinRoot.root (cyclotomic n R) :=
  rootsOfUnity.coe_mkOfPowEq _

/-- The coordinate map `R[Multiplicative (ZMod n)] →ₐ[R] R[X]/(Φ_n)` of the inclusion
`μ_n^prim → μ_n`: the point of `μ_n` with values in `R[X]/(Φ_n)` given by the universal primitive
`n`th root of unity. -/
noncomputable def primitiveRootsMap :
    MonoidAlgebra R (Multiplicative (ZMod n)) →ₐ[R] AdjoinRoot (cyclotomic n R) :=
  ((pointsMulEquiv (R := R) n).symm (universalPrimitiveRoot R n)).ofConv

/-- The inclusion `μ_n^prim → μ_n` sends the standard generator of `μ_n` to the root of `Φ_n`. -/
@[simp]
theorem primitiveRootsMap_single_generator :
    primitiveRootsMap R n (MonoidAlgebra.single (generator n) 1) =
      AdjoinRoot.root (cyclotomic n R) := by
  rw [primitiveRootsMap, pointsMulEquiv_symm_apply_single_generator, coe_universalPrimitiveRoot]

/-- The inclusion `μ_n^prim → μ_n` is a closed immersion: its coordinate map is surjective. -/
theorem primitiveRootsMap_surjective : Function.Surjective (primitiveRootsMap R n) := by
  rw [← AlgHom.range_eq_top, eq_top_iff, ← AdjoinRoot.adjoinRoot_eq_top, Algebra.adjoin_le_iff,
    Set.singleton_subset_iff]
  exact ⟨_, primitiveRootsMap_single_generator R n⟩

/-- The inclusion `μ_n^prim → μ_n` is a closed immersion. -/
instance isClosedImmersion_primitiveRootsMap :
    IsClosedImmersion (Spec.map (CommRingCat.ofHom (primitiveRootsMap R n).toRingHom)) :=
  .spec_of_surjective _ (primitiveRootsMap_surjective R n)

/-- **`μ_n^prim` is open in `μ_n` when `n` is invertible.** If `n` is a unit in `R`, the kernel of
the coordinate map of `μ_n^prim → μ_n` is generated by an idempotent. -/
theorem exists_isIdempotentElem_ker_primitiveRootsMap (hn : IsUnit (n : R)) :
    ∃ e, IsIdempotentElem e ∧ RingHom.ker (primitiveRootsMap R n) = Ideal.span {e} := by
  obtain ⟨a, b, hab⟩ := isCoprime_cyclotomic_prod_properDivisors hn
  set g := MonoidAlgebra.single (generator n) (1 : R) with hg
  set Ψ := ∏ d ∈ n.properDivisors, cyclotomic d R
  -- `Φ_n(g) Ψ(g) = g ^ n - 1 = 0`.
  have hg₁ : g ^ n = 1 := single_generator_pow n
  have hΦΨ : aeval g (cyclotomic n R) * aeval g Ψ = 0 := by
    rw [← map_mul, (eq_cyclotomic_iff (Nat.pos_of_ne_zero (NeZero.ne n)) (cyclotomic n R)).mp rfl]
    simp [hg₁]
  -- The idempotent is `e = a(g) Φ_n(g)`; its complement is `1 - e = b(g) Ψ(g)`.
  set e := aeval g (a * cyclotomic n R) with he_def
  have hab' : e + aeval g b * aeval g Ψ = 1 := by
    rw [he_def, ← map_mul, ← map_add, hab, map_one]
  have he : IsIdempotentElem e := by
    rw [IsIdempotentElem]
    rw [he_def, map_mul] at hab' ⊢
    linear_combination (aeval g a * aeval g (cyclotomic n R)) * hab' -
      (aeval g a * aeval g b) * hΦΨ
  refine ⟨e, he, le_antisymm (fun x hx ↦ ?_) ?_⟩
  · -- `Φ_n(g)` lies in the ideal `(e)`, so the quotient map `R[ℤ/n] → R[ℤ/n] ⧸ (e)` factors
    -- through `primitiveRootsMap`, and its kernel contains that of `primitiveRootsMap`.
    let q := Ideal.Quotient.mkₐ R (Ideal.span {e})
    have hmem : aeval g (cyclotomic n R) = aeval g (cyclotomic n R) * e := by
      linear_combination (-aeval g (cyclotomic n R)) * hab' + aeval g b * hΦΨ
    have hqe : q e = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self e)
    have hΦ : (cyclotomic n R).eval₂
        (Algebra.ofId R (MonoidAlgebra R (Multiplicative (ZMod n)) ⧸ Ideal.span {e}) :
          R →+* _) (q g) = 0 :=
      (by rw [aeval_algHom_apply, hmem, map_mul, hqe, mul_zero] : aeval (q g) (cyclotomic n R) = 0)
    let ψ := AdjoinRoot.liftAlgHom (cyclotomic n R) (Algebra.ofId R _) (q g) hΦ
    have hψ : ψ.comp (primitiveRootsMap R n) = q := by
      refine algHom_ext n ?_
      rw [AlgHom.comp_apply, primitiveRootsMap_single_generator, AdjoinRoot.liftAlgHom_root, hg]
    have hqx := congr($hψ x)
    rw [AlgHom.comp_apply, RingHom.mem_ker.mp hx, map_zero] at hqx
    exact Ideal.Quotient.eq_zero_iff_mem.mp hqx.symm
  · -- `e` maps to `a(ζ) Φ_n(ζ) = 0`, where `ζ` is the root of `Φ_n`.
    simp [Ideal.span_le, he_def, ← aeval_algHom_apply, hg]

/-- **`μ_n^prim` is open and closed in `μ_n` when `n` is invertible.** If `n` is a unit in `R`,
the inclusion `μ_n^prim → μ_n` is an open immersion; it is always a closed immersion
(`TauCeti.RootsOfUnityGroup.isClosedImmersion_primitiveRootsMap`). -/
theorem isOpenImmersion_primitiveRootsMap (hn : IsUnit (n : R)) :
    IsOpenImmersion (Spec.map (CommRingCat.ofHom (primitiveRootsMap R n).toRingHom)) :=
  (isOpenImmersion_SpecMap_iff_of_surjective _ (primitiveRootsMap_surjective R n)).mpr
    (exists_isIdempotentElem_ker_primitiveRootsMap R n hn)

end

section Points

variable {R : Type u} [CommRing R] {n : ℕ} [NeZero n] {A : Type v} [CommRing A] [Algebra R A]

/-- **The points of `μ_n^prim`.** A point of `μ_n` with values in `A` lies in `μ_n^prim` exactly
when its root of unity is a root of the cyclotomic polynomial `Φ_n`. -/
theorem exists_comp_primitiveRootsMap_iff (x : MonoidAlgebra R (Multiplicative (ZMod n)) →ₐ[R] A) :
    (∃ y : AdjoinRoot (cyclotomic n R) →ₐ[R] A, y.comp (primitiveRootsMap R n) = x) ↔
      (cyclotomic n A).IsRoot ((pointsMulEquiv n (toConv x) : Aˣ) : A) := by
  rw [pointsMulEquiv_apply, ofConv_toConv, ← map_cyclotomic n (algebraMap R A), IsRoot,
    eval_map_algebraMap]
  constructor
  · rintro ⟨y, rfl⟩
    rw [AlgHom.comp_apply, primitiveRootsMap_single_generator]
    exact AdjoinRoot.aeval_algHom_eq_zero _ y
  · intro h
    have h' : (cyclotomic n R).eval₂ (Algebra.ofId R A : R →+* A)
        (x (MonoidAlgebra.single (generator n) 1)) = 0 := h
    refine ⟨AdjoinRoot.liftAlgHom (cyclotomic n R) (Algebra.ofId R A) _ h', algHom_ext n ?_⟩
    rw [AlgHom.comp_apply, primitiveRootsMap_single_generator, AdjoinRoot.liftAlgHom_root]

/-- **`μ_n^prim` is the fibrewise exact-order-`n` locus of `μ_n`.** If `n` is invertible in `A`,
a point of `μ_n` with values in `A`, with root of unity `ζ`, lies in `μ_n^prim` exactly when the
image of `ζ` in `A ⧸ p` is a primitive `n`th root of unity for every prime ideal `p` of `A`. -/
theorem exists_comp_primitiveRootsMap_iff_forall_isPrimitiveRoot (hn : IsUnit (n : A))
    (x : MonoidAlgebra R (Multiplicative (ZMod n)) →ₐ[R] A) :
    (∃ y : AdjoinRoot (cyclotomic n R) →ₐ[R] A, y.comp (primitiveRootsMap R n) = x) ↔
      ∀ p : Ideal A, p.IsPrime →
        IsPrimitiveRoot (Ideal.Quotient.mk p ((pointsMulEquiv n (toConv x) : Aˣ) : A)) n := by
  rw [exists_comp_primitiveRootsMap_iff, isRoot_cyclotomic_iff_forall_isPrimitiveRoot hn,
    and_iff_right_iff_imp]
  exact fun _ ↦ (mem_rootsOfUnity' n _).mp (pointsMulEquiv n (toConv x)).2

end Points

end RootsOfUnityGroup

end TauCeti
