/-!
# Geometric connectedness of Mumford–Tate groups

Let `G` be an affine group of finite type over `ℚ` and `h : S → G_ℝ` a homomorphism from the
Deligne torus. Its Mumford–Tate group `MT(h)` (`TauCeti.DeligneTorus.mumfordTateHopfIdeal`) is
the smallest closed `ℚ`-subgroup of `G` through whose real extension `h` factors. This file proves
that `MT(h)` is geometrically connected; no polarization is assumed. For `G = GL(V)` this is the
connectedness of the Mumford–Tate group of a rational Hodge structure.

The proof follows the identity component of `MT(h)`. Over `ℚ^alg = AlgebraicClosure ℚ` the
identity component of `MT(h)_{ℚ^alg}` is cut out by the Hopf ideal generated by `1 - e`, where `e`
is the idempotent selecting the connected component of the identity
(`TauCeti.HopfAlgebra.identityComponentHopfIdeal`). The Galois group of `ℚ^alg / ℚ` acts on the
scalar factor by ring automorphisms compatible with the counit, so it fixes the identity point
and hence `e`; Galois descent (`TauCeti.CommHopfAlgCat.existsUnique_baseChangeHopfIdeal_eq_iff`)
then defines the identity component over `ℚ`. Since `S` is geometrically connected, `h` kills
it: after embedding `ℚ^alg` into `ℂ`, the image of `e` in `ℂ ⊗[ℝ] O(S)` is an idempotent of a
ring with connected spectrum on which the counit is one, so it is one. Minimality of `MT(h)`
then forces the identity component to be all of `MT(h)`.

## Main declarations

* `TauCeti.CommHopfAlgCat.map_mem_identityComponentHopfIdeal_baseChange`: over an algebraically
  closed extension `L / k`, the identity component of a base-changed affine group is stable under
  the action of `Aut(L / k)` on the scalar factor.
* `TauCeti.CommHopfAlgCat.apply_one_tmul_eq_zero_of_mem_identityComponentHopfIdeal`: a
  homomorphism from a geometrically connected real group to the real extension of an affine group
  over `ℚ` kills every function defined over `ℚ` lying in its geometric identity component.
* `TauCeti.DeligneTorus.geometricallyConnected_quotient_mumfordTateHopfIdeal`: the Mumford–Tate
  group is geometrically connected.

## References

* J. S. Milne, *Introduction to Shimura varieties*, §2, p. 31 (the aside after Definition 2.16).
* P. Deligne, *Hodge cycles on abelian varieties* (notes by J. S. Milne), §3, pp. 24–25.
* J. S. Milne, *Algebraic Groups* (2017), Proposition 2.37 (the identity component) and
  Appendix A (Galois descent).
-/

public section

open CategoryTheory _root_.CommHopfAlgCat TauCeti.CommHopfAlgCat
open scoped TensorProduct

namespace TauCeti.CommHopfAlgCat

universe u v w

section GaloisStable

variable {k : Type u} {L : Type w} [CommRing k] [Field L] [IsAlgClosed L] [Algebra k L]
variable {A : _root_.CommHopfAlgCat.{v} k} [Algebra.FiniteType k A]

/-- **The geometric identity component is Galois stable.** Let `A` be the coordinate Hopf algebra
of an affine group of finite type over `k`, and `L / k` an algebraically closed extension. Every
automorphism `σ` of `L / k`, acting on the scalar factor of `L ⊗[k] A`, preserves the Hopf ideal
cutting out the identity component of the base change: `σ` is compatible with the counit, so it
fixes the identity point and its connected component. -/
theorem map_mem_identityComponentHopfIdeal_baseChange (σ : L ≃ₐ[k] L) {x : L ⊗[k] A}
    (hx : x ∈ HopfAlgebra.identityComponentHopfIdeal (k := L) (H := baseChange (K := L) A)) :
    TensorProduct.map σ.toLinearMap LinearMap.id x ∈
      HopfAlgebra.identityComponentHopfIdeal (k := L) (H := baseChange (K := L) A) := by
  let _ : IsNoetherianRing (baseChange (K := L) A) := Algebra.FiniteType.isNoetherianRing L _
  let τ : (L ⊗[k] A) ≃+* (L ⊗[k] A) :=
    (Algebra.TensorProduct.congr σ (AlgEquiv.refl : A ≃ₐ[k] A)).toRingEquiv
  have hτ : τ x = TensorProduct.map σ.toLinearMap LinearMap.id x := rfl
  have hε : ∀ y : baseChange (K := L) A,
      Bialgebra.counitAlgHom L (baseChange (K := L) A) (τ y) =
        σ (Bialgebra.counitAlgHom L (baseChange (K := L) A) y) := by
    intro y
    induction y using TensorProduct.inductionOn with
    | tmul l a =>
      simp [τ, Bialgebra.counitAlgHom_apply]
    | add a b ha hb => simp only [map_add, ha, hb]
  have hz : PrimeSpectrum.comap (τ : (L ⊗[k] A) →+* (L ⊗[k] A))
      (Bialgebra.augmentationPoint L (baseChange (K := L) A)) =
        Bialgebra.augmentationPoint L (baseChange (K := L) A) := by
    ext y
    change τ y ∈ (Bialgebra.augmentationPoint L (baseChange (K := L) A)).asIdeal ↔ _
    rw [AlgHom.kernelPoint_asIdeal, RingHom.mem_ker, RingHom.mem_ker]
    exact (Eq.congr_left (hε y)).trans (map_eq_zero_iff σ σ.injective)
  rw [HopfAlgebra.mem_identityComponentHopfIdeal] at hx ⊢
  rw [← hτ]
  exact (PrimeSpectrum.apply_mem_connectedComponentIdeal_iff_of_comap_eq_self τ _ hz).mpr hx

end GaloisStable

/-- **A connected real group maps into the identity component.** Let `A` be the coordinate Hopf
algebra of an affine group `G` of finite type over `ℚ`, and `g : M → G_ℝ` a homomorphism from a
geometrically connected real affine group `M` with coordinate Hopf algebra `T`. A function `x` on
`G` whose base change to `ℚ^alg = AlgebraicClosure ℚ` lies in the ideal of the identity component
of `G_{ℚ^alg}` is killed by `g`. The proof embeds `ℚ^alg` into `ℂ`: the image of the
identity-component idempotent in `ℂ ⊗[ℝ] T` is an idempotent with counit one in a ring with
connected spectrum. -/
theorem apply_one_tmul_eq_zero_of_mem_identityComponentHopfIdeal
    {A : _root_.CommHopfAlgCat.{v} ℚ} [Algebra.FiniteType ℚ A] {T : _root_.CommHopfAlgCat.{v} ℝ}
    (hT : geometricallyConnectedCommHopfAlgProperty ℝ T) (g : baseChange (K := ℝ) A ⟶ T) {x : A}
    (hx : (1 : AlgebraicClosure ℚ) ⊗ₜ[ℚ] x ∈
      HopfAlgebra.identityComponentHopfIdeal (k := AlgebraicClosure ℚ)
        (H := baseChange (K := AlgebraicClosure ℚ) A)) :
    g.hom ((1 : ℝ) ⊗ₜ[ℚ] x) = 0 := by
  let L := AlgebraicClosure ℚ
  let _ : IsNoetherianRing (baseChange (K := L) A) := Algebra.FiniteType.isNoetherianRing L _
  let ι : L →ₐ[ℚ] ℂ := IsAlgClosed.lift
  let f₁ : L →ₐ[ℚ] ℂ ⊗[ℝ] T := (IsScalarTower.toAlgHom ℚ ℂ (ℂ ⊗[ℝ] T)).comp ι
  let f₂ : A →ₐ[ℚ] ℂ ⊗[ℝ] T := RingHom.toRatAlgHom
    ((Algebra.TensorProduct.includeRight : T →ₐ[ℝ] ℂ ⊗[ℝ] T).toRingHom.comp
      (g.hom.toAlgHom.toRingHom.comp
        (Algebra.TensorProduct.includeRight : A →ₐ[ℚ] ℝ ⊗[ℚ] A).toRingHom))
  let φ : L ⊗[ℚ] A →ₐ[ℚ] ℂ ⊗[ℝ] T :=
    Algebra.TensorProduct.lift f₁ f₂ fun _ _ ↦ Commute.all _ _
  let ψ : ℂ ⊗[ℝ] T →ₐ[ℝ] ℂ := Algebra.TensorProduct.lift (AlgHom.id ℝ ℂ)
    ((Algebra.ofId ℝ ℂ).comp (Bialgebra.counitAlgHom ℝ T)) fun _ _ ↦ Commute.all _ _
  have hψφ : ∀ y : baseChange (K := L) A,
      ψ (φ y) = ι (Bialgebra.counitAlgHom L (baseChange (K := L) A) y) := by
    intro y
    induction y using TensorProduct.inductionOn with
    | tmul l a =>
      simp [φ, ψ, f₁, f₂, Bialgebra.counitAlgHom_apply, Rat.smul_def, mul_comm]
    | add a b ha hb => simp only [map_add, ha, hb]
  let e := PrimeSpectrum.connectedComponentIdempotent
    (Bialgebra.augmentationPoint L (baseChange (K := L) A))
  have hconn : ConnectedSpace (PrimeSpectrum (ℂ ⊗[ℝ] T)) :=
    (PrimeSpectrum.homeomorphOfRingEquiv
      (Algebra.TensorProduct.comm ℝ T ℂ).toRingEquiv).connectedSpace_iff.mp
      ((geometricallyConnectedCommHopfAlgProperty_iff _ _).mp hT ℂ)
  let _ : Nontrivial (ℂ ⊗[ℝ] T) := ψ.toRingHom.domain_nontrivial
  have he : φ e = 1 := by
    have hidem : IsIdempotentElem (φ e) :=
      (PrimeSpectrum.isIdempotentElem_connectedComponentIdempotent _).map φ
    rcases connectedSpace_primeSpectrum_iff_idempotent_eq_zero_or_one.mp hconn _ hidem with
      h0 | h1
    · have h := hψφ e
      rw [h0, map_zero, AlgHom.map_connectedComponentIdempotent_kernelPoint_eq_one,
        map_one] at h
      exact absurd h zero_ne_one
    · exact h1
  rw [HopfAlgebra.mem_identityComponentHopfIdeal] at hx
  obtain ⟨a, ha⟩ := PrimeSpectrum.mem_connectedComponentIdeal_iff.mp hx
  have h₁ : φ (1 ⊗ₜ x) = (1 : ℂ) ⊗ₜ[ℝ] g.hom (1 ⊗ₜ x) := by
    simp [φ, f₁, f₂]
  have h₂ : φ (1 ⊗ₜ x) = 0 := by
    rw [← ha, map_mul, map_sub, map_one]
    change φ a * (1 - φ e) = 0
    rw [he, sub_self, mul_zero]
  exact (Module.FaithfullyFlat.one_tmul_eq_zero_iff ℝ T _).mp (h₁.symm.trans h₂)

end TauCeti.CommHopfAlgCat

namespace TauCeti.DeligneTorus

/-- **The Mumford–Tate group is geometrically connected.** For an affine group `G` of finite type
over `ℚ` and a homomorphism `h : S → G_ℝ` from the Deligne torus, the Mumford–Tate group `MT(h)`
is geometrically connected. Its geometric identity component is defined over `ℚ` by Galois
descent, and `h` factors through its real extension because `S` is geometrically connected, so
minimality of `MT(h)` makes the two equal. No polarization is needed. -/
theorem geometricallyConnected_quotient_mumfordTateHopfIdeal
    {H : _root_.CommHopfAlgCat.{0} ℚ} [Algebra.FiniteType ℚ H]
    (h : baseChange (K := ℝ) H ⟶ _root_.CommHopfAlgCat.of ℝ S) :
    geometricallyConnectedCommHopfAlgProperty ℚ (quotient H (mumfordTateHopfIdeal h)) := by
  set J := mumfordTateHopfIdeal h
  let L := AlgebraicClosure ℚ
  let E : HopfIdeal L (baseChange (K := L) (quotient H J)) :=
    HopfAlgebra.identityComponentHopfIdeal
  obtain ⟨I, hI, -⟩ := (existsUnique_baseChangeHopfIdeal_eq_iff E).mpr
    fun σ _ hx ↦ map_mem_identityComponentHopfIdeal_baseChange σ hx
  let I' := I.comapOfSurjective (mkQuotient H J).hom (mkQuotient_surjective H J)
  have hI'J : I' ≤ J := by
    rw [le_mumfordTateHopfIdeal_iff, baseChangeHopfIdeal_toIdeal, Ideal.map_le_iff_le_comap]
    intro y hy
    have hy' : (mkQuotient H J).hom y ∈ I := HopfIdeal.mem_comapOfSurjective.mp hy
    have hmem : (1 : L) ⊗ₜ[ℚ] (mkQuotient H J).hom y ∈ E :=
      hI ▸ one_tmul_mem_baseChangeHopfIdeal hy'
    have hcomp := congrArg (fun f ↦ f.hom ((1 : ℝ) ⊗ₜ[ℚ] y))
      (baseChangeMap_mkQuotient_comp_mumfordTateLift h)
    simp only [_root_.CommHopfAlgCat.hom_comp, BialgHom.comp_apply] at hcomp
    rw [Ideal.mem_comap, RingHom.mem_ker]
    simpa [← hcomp] using
      apply_one_tmul_eq_zero_of_mem_identityComponentHopfIdeal
        (Algebra.WeilRestriction.geometricallyConnectedCommHopfAlgProperty_multiplicativeGroup
          (k := ℝ) (B := ℂ)) (mumfordTateLift h) hmem
  have hIbot : I = ⊥ := by
    refine HopfIdeal.ext fun x ↦ ?_
    obtain ⟨y, rfl⟩ := mkQuotient_surjective H J x
    rw [HopfIdeal.mem_bot, mkQuotient_eq_zero_iff]
    refine ⟨fun hx ↦ hI'J (HopfIdeal.mem_comapOfSurjective.mpr hx), fun hy ↦ ?_⟩
    rw [(mkQuotient_eq_zero_iff H J y).mpr hy]
    exact zero_mem I
  have hE : E = ⊥ := by rw [← hI, hIbot, baseChangeHopfIdeal_bot]
  rw [geometricallyConnectedCommHopfAlgProperty_iff_connectedSpace_baseChange ℚ L]
  exact HopfAlgebra.identityComponentHopfIdeal_eq_bot_iff_connectedSpace.mp hE

end TauCeti.DeligneTorus
