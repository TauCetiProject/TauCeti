/-!
# Eigenvalues of points in faithful representations

Let `G` be an affine group over a field `k`, with coordinate Hopf algebra `H`, let `V` be a
faithful finite-dimensional representation of `G` (a closed immersion `G → GL(V)`), and let `W`
be any representation. For a point `g ∈ G(Ω)` with values in an algebraically closed field `Ω`,
every eigenvalue of `g` on `W` lies in the subgroup of `Ωˣ` generated by the eigenvalues of `g`
on `V`. For a `k`-point this says that the roots in `Ω` of the characteristic polynomial of `g`
on `W` lie in the group generated by the roots of its characteristic polynomial on `V`.
Properties of points defined by their eigenvalues in every representation, such as being neat or
being a Weil point, can therefore be tested in one faithful representation. No assumption on the
characteristic of `k` is needed, and `W` need not be finite-dimensional.

The comparison goes through the coordinate algebra. A point `g` acts on the scalar extension
`Ω ⊗ H` of the regular comodule by right translation, an algebra endomorphism. Matrix-coefficient
morphisms `W → H` intertwine the actions of `g`, so the eigenvalues of `g` on `W` are eigenvalues
of right translation, and right translation is the sum of its generalized eigenspaces for the
eigenvalues in the group generated by the eigenvalues of `g` on `V`: the coefficients of `V` and
of its dual generate `H`, and generalized eigenvalues of an algebra endomorphism multiply.

## Main declarations

* `TauCeti.Comodule.endOfPoint_regular_mul`, `TauCeti.Comodule.endOfPoint_regular_one`: a point
  acts on the regular comodule by an algebra endomorphism.
* `TauCeti.Comodule.regularEndOfPoint`: right translation by a point, as an algebra
  endomorphism.
* `TauCeti.Comodule.hasEigenvalue_endOfPoint_regular`: an eigenvalue of a point on any comodule is
  an eigenvalue of right translation on the coordinate algebra.
* `TauCeti.Comodule.one_tmul_matrixCoefficient_mem_iSup_maxGenEigenspace`: a matrix coefficient
  of a finite-dimensional comodule is a sum of generalized eigenvectors of right translation, for
  eigenvalues of the point on the comodule.
* `TauCeti.Comodule.mem_aroots_charpoly_endOfPoint_iff`: the roots of the characteristic
  polynomial of a rational point are the eigenvalues of the point after scalar extension.
* `TauCeti.Comodule.ne_zero_of_hasEigenvalue_endOfPoint`: eigenvalues of points are nonzero.
* `TauCeti.Comodule.hasEigenvalue_inv_of_hasEigenvalue_endOfPoint_dual`: every eigenvalue of a
  point on the dual comodule is the inverse of an eigenvalue on the comodule.
* `TauCeti.Comodule.iSup_maxGenEigenspace_endOfPoint_regular_eq_top`: for a faithful comodule,
  right translation is the sum of its generalized eigenspaces for eigenvalues in any submonoid
  containing the eigenvalues on the comodule and their inverses.
* `TauCeti.Comodule.exists_mem_closure_hasEigenvalue_of_isFaithful`: eigenvalues on any
  representation lie in the group generated by the eigenvalues on a faithful one.
* `TauCeti.Comodule.exists_mem_closure_mem_aroots_charpoly_of_isFaithful`: the same for a
  rational point, in terms of roots of characteristic polynomials.

## References

* J. S. Milne, *Introduction to Shimura varieties*, §3, p. 34.
* P. Deligne and J. S. Milne, *Tannakian categories*, Proposition 2.20.
-/

public section

open TensorProduct WithConv

namespace TauCeti.Comodule

universe u

section Regular

variable {R H A : Type*} [CommSemiring R] [Semiring H] [Bialgebra R H] [CommSemiring A]
  [Algebra R A]

/-- The point action on the regular comodule, on a pure tensor: the comultiplication pushed
through the point, read as an algebra map `H → A ⊗ H`. -/
private theorem endOfPoint_regular_tmul (g : H →ₐ[R] A) (a : A) (h : H) :
    endOfPoint H g (a ⊗ₜ[R] h) =
      a • ((Algebra.TensorProduct.comm R H A).toAlgHom.comp
        ((Algebra.TensorProduct.map (AlgHom.id R H) g).comp (Bialgebra.comulAlgHom R H))) h := by
  rw [endOfPoint_tmul, instSelf_coact]
  refine congrArg (a • ·) ?_
  simp only [AlgHom.comp_apply, Bialgebra.comulAlgHom_apply]
  induction Coalgebra.comul (R := R) h using TensorProduct.inductionOn with
  | tmul x y => simp
  | add x y hx hy => simp only [map_add, hx, hy]

/-- **A point acts on the regular comodule by an algebra endomorphism.** Right translation by
an `A`-point on the scalar extension `A ⊗ H` of the coordinate algebra is multiplicative. -/
theorem endOfPoint_regular_mul (g : H →ₐ[R] A) (x y : A ⊗[R] H) :
    endOfPoint H g (x * y) = endOfPoint H g x * endOfPoint H g y := by
  induction x using TensorProduct.inductionOn with
  | add x x' hx hx' => simp only [add_mul, map_add, hx, hx']
  | tmul a h =>
    induction y using TensorProduct.inductionOn with
    | add y y' hy hy' => simp only [mul_add, map_add, hy, hy']
    | tmul b h' =>
      rw [Algebra.TensorProduct.tmul_mul_tmul, endOfPoint_regular_tmul, endOfPoint_regular_tmul,
        endOfPoint_regular_tmul, map_mul, smul_mul_smul_comm]

/-- Right translation by a point fixes the unit of the coordinate algebra. -/
@[simp]
theorem endOfPoint_regular_one (g : H →ₐ[R] A) : endOfPoint H g 1 = 1 := by
  rw [Algebra.TensorProduct.one_def, endOfPoint_regular_tmul, map_one, one_smul,
    Algebra.TensorProduct.one_def]

/-- Right translation by an `A`-point, as an `A`-algebra endomorphism of the scalar extension
`A ⊗ H` of the regular comodule. Its underlying linear map is `endOfPoint H g`. -/
noncomputable def regularEndOfPoint (g : H →ₐ[R] A) : A ⊗[R] H →ₐ[A] A ⊗[R] H :=
  AlgHom.ofLinearMap (endOfPoint H g) (endOfPoint_regular_one g) (endOfPoint_regular_mul g)

/-- The underlying linear map of `regularEndOfPoint g` is the point action on the regular
comodule. -/
@[simp]
theorem regularEndOfPoint_toLinearMap (g : H →ₐ[R] A) :
    (regularEndOfPoint g).toLinearMap = endOfPoint H g :=
  (rfl)

/-- `regularEndOfPoint g` acts as the point action on the regular comodule. -/
@[simp]
theorem regularEndOfPoint_apply (g : H →ₐ[R] A) (x : A ⊗[R] H) :
    regularEndOfPoint g x = endOfPoint H g x :=
  (rfl)

end Regular

section Coalgebra

variable {k H Ω : Type*} [Field k] [Semiring H] [Algebra k H] [Coalgebra k H] [Field Ω]
  [Algebra k Ω]

/-- **Eigenvalues on a comodule are eigenvalues of right translation.** If a point `g` has the
eigenvalue `ν` on a comodule `W`, then right translation by `g` on the scalar extension of the
coordinate algebra has the eigenvalue `ν`: a matrix-coefficient morphism `W → H` carries an
eigenvector to a nonzero eigenvector. -/
theorem hasEigenvalue_endOfPoint_regular {W : Type*} [AddCommGroup W] [Module k W]
    [Comodule k H W] (g : H →ₐ[k] Ω) {ν : Ω}
    (hν : Module.End.HasEigenvalue (endOfPoint W g) ν) :
    Module.End.HasEigenvalue (endOfPoint H g) ν := by
  obtain ⟨x, hx⟩ := hν.exists_hasEigenvector
  -- Some functional of `W` does not vanish on `x` after scalar extension.
  obtain ⟨φ, hφ⟩ : ∃ φ : Module.Dual k W, φ.baseChange Ω x ≠ 0 := by
    by_contra! h
    exact hx.2 (TauCeti.Module.Dual.eq_of_baseChange_eq fun φ ↦ by simp [h φ])
  let c := (matrixCoefficientHom (C := H) φ).toLinearMap.baseChange Ω
  refine Module.End.hasEigenvalue_of_hasEigenvector (x := c x) ⟨?_, fun h0 ↦ hφ ?_⟩
  · rw [Module.End.mem_eigenspace_iff, ← LinearMap.comp_apply,
      ← baseChange_comp_endOfPoint, LinearMap.comp_apply, hx.apply_eq_smul, map_smul]
  · have h0' : (matrixCoefficientHom (C := H) φ).toLinearMap.baseChange Ω x = 0 := h0
    rw [← counit_baseChange_matrixCoefficientHom (C := H) Ω φ x, h0', map_zero, map_zero]

/-- **Matrix coefficients are sums of generalized eigenvectors of right translation.** For a
finite-dimensional comodule `W` and a point `g` with values in an algebraically closed field,
each matrix coefficient of `W` lies in the sum of the generalized eigenspaces of right
translation by `g` for eigenvalues in any set `S` containing the eigenvalues of `g` on `W`. -/
theorem one_tmul_matrixCoefficient_mem_iSup_maxGenEigenspace [IsAlgClosed Ω]
    {W : Type*} [AddCommGroup W] [Module k W] [Comodule k H W] [Module.Finite k W]
    (g : H →ₐ[k] Ω) {S : Set Ω}
    (hS : ∀ μ, Module.End.HasEigenvalue (endOfPoint W g) μ → μ ∈ S)
    (φ : Module.Dual k W) (w : W) :
    (1 : Ω) ⊗ₜ[k] matrixCoefficient (C := H) φ w ∈
      ⨆ μ ∈ S, Module.End.maxGenEigenspace (endOfPoint H g) μ := by
  let c := (matrixCoefficientHom (C := H) φ).toLinearMap.baseChange Ω
  have hc : (1 : Ω) ⊗ₜ[k] matrixCoefficient (C := H) φ w = c (1 ⊗ₜ[k] w) := by
    simp [c]
  have hle : ∀ μ, (Module.End.maxGenEigenspace (endOfPoint W g) μ).map c ≤
      ⨆ μ ∈ S, Module.End.maxGenEigenspace (endOfPoint H g) μ := fun μ ↦ by
    by_cases hμ : Module.End.maxGenEigenspace (endOfPoint W g) μ = ⊥
    · simp [hμ]
    · refine le_trans ?_ (le_biSup _ (hS μ (Module.End.HasUnifEigenvalue.lt zero_lt_one hμ)))
      exact Module.End.map_genEigenspace_le c (baseChange_comp_endOfPoint _ g).symm μ ⊤
  have hmap : (⨆ μ, Module.End.maxGenEigenspace (endOfPoint W g) μ).map c ≤
      ⨆ μ ∈ S, Module.End.maxGenEigenspace (endOfPoint H g) μ := by
    rw [Submodule.map_iSup]
    exact iSup_le hle
  rw [hc]
  refine hmap (Submodule.mem_map_of_mem ?_)
  rw [Module.End.iSup_maxGenEigenspace_eq_top]
  exact Submodule.mem_top

/-- For a `k`-point `γ`, the roots in a field `Ω` of the characteristic polynomial of `γ` on a
finite-dimensional comodule are the eigenvalues of the induced `Ω`-point. -/
theorem mem_aroots_charpoly_endOfPoint_iff {M : Type*} [AddCommGroup M] [Module k M]
    [Comodule k H M] [Module.Finite k M] (γ : H →ₐ[k] k) (μ : Ω) :
    μ ∈ (endOfPoint M γ).charpoly.aroots Ω ↔
      Module.End.HasEigenvalue (endOfPoint M ((Algebra.ofId k Ω).comp γ)) μ := by
  rw [Module.End.hasEigenvalue_iff_isRoot_charpoly, charpoly_endOfPoint_comp,
    Polynomial.mem_aroots, Polynomial.IsRoot.def, Algebra.toRingHom_ofId,
    Polynomial.eval_map_algebraMap]
  exact and_iff_right (endOfPoint M γ).charpoly_monic.ne_zero

end Coalgebra

section Nonzero

variable {k H Ω : Type*} [CommRing k] [Semiring H] [HopfAlgebra k H] [CommRing Ω] [Algebra k Ω]

/-- The eigenvalues of a point on a comodule are nonzero, since the point acts invertibly. -/
theorem ne_zero_of_hasEigenvalue_endOfPoint {V : Type*} [AddCommGroup V] [Module k V]
    [Comodule k H V] (g : WithConv (H →ₐ[k] Ω)) {μ : Ω}
    (hμ : Module.End.HasEigenvalue (endOfPoint V g.ofConv) μ) : μ ≠ 0 := by
  rintro rfl
  obtain ⟨x, hx⟩ := hμ.exists_hasEigenvector
  have := congrArg (endOfPoint V (g⁻¹).ofConv) hx.apply_eq_smul
  rw [zero_smul, map_zero, ← LinearMap.comp_apply, endOfPoint_inv_comp,
    LinearMap.id_apply] at this
  exact hx.2 this

end Nonzero

section HopfAlgebra

variable {k H Ω : Type*} [Field k] [Semiring H] [HopfAlgebra k H] [Field Ω] [Algebra k Ω]

attribute [local instance] Comodule.dual

/-- **Eigenvalues on the dual comodule are inverse eigenvalues.** If a point `g` has the
eigenvalue `ν` on the dual of a finite-dimensional comodule `V`, then `ν⁻¹` is an eigenvalue of
`g` on `V`. The action on the dual is adjoint to the action of `g⁻¹` on `V`. -/
theorem hasEigenvalue_inv_of_hasEigenvalue_endOfPoint_dual {V : Type*} [AddCommGroup V] [Module k V]
    [Comodule k H V] [Module.Finite k V] (g : WithConv (H →ₐ[k] Ω)) {ν : Ω}
    (hν : Module.End.HasEigenvalue (endOfPoint (Module.Dual k V) g.ofConv) ν) :
    Module.End.HasEigenvalue (endOfPoint V g.ofConv) ν⁻¹ := by
  obtain ⟨ξ, hξ⟩ := hν.exists_hasEigenvector
  set G := endOfPoint V (g⁻¹).ofConv
  set ψ := TauCeti.Module.Dual.baseChangeEvaluationEquiv (R := k) (A := Ω) (M := V) ξ
  have hψ : ψ ≠ 0 := (LinearEquiv.map_ne_zero_iff _).mpr hξ.2
  set D : Module.End Ω (Ω ⊗[k] V) := G - ν • 1
  -- The functional `ψ` vanishes on the range of `D = G - ν`.
  have hrange (z : Ω ⊗[k] V) : ψ (D z) = 0 := by
    have := baseChangeEvaluation_dual_endOfPoint (R := k) (H := H) (M := V) g ξ z
    rw [hξ.apply_eq_smul, map_smul, LinearMap.smul_apply] at this
    simp only [ψ, TauCeti.Module.Dual.baseChangeEvaluationEquiv_apply, D, LinearMap.sub_apply,
      LinearMap.smul_apply, one_apply_eq_self, map_sub, map_smul, smul_eq_mul, G, ← this,
      sub_self]
  -- So `D` is not surjective, hence not injective.
  obtain ⟨z, hz, hz0⟩ : ∃ z, D z = 0 ∧ z ≠ 0 := by
    by_contra! h
    have hinj : Function.Injective D := (injective_iff_map_eq_zero _).mpr h
    exact hψ (LinearMap.ext fun y ↦ by
      obtain ⟨z, rfl⟩ := (LinearMap.injective_iff_surjective.mp hinj) y
      exact hrange z)
  have hGz : G z = ν • z := sub_eq_zero.mp <| by
    simpa only [D, LinearMap.sub_apply, LinearMap.smul_apply, one_apply_eq_self] using hz
  -- Applying `g` to `G z = ν • z` gives `z = ν • g z`.
  have hgz : z = ν • endOfPoint V g.ofConv z := by
    rw [← map_smul, ← hGz, ← LinearMap.comp_apply, endOfPoint_comp_inv, LinearMap.id_apply]
  have hν0 : ν ≠ 0 := fun h ↦ hz0 (by rw [hgz, h, zero_smul])
  refine Module.End.hasEigenvalue_of_hasEigenvector (x := z) ⟨?_, hz0⟩
  rw [Module.End.mem_eigenspace_iff]
  conv_rhs => rw [hgz]
  rw [smul_smul, inv_mul_cancel₀ hν0, one_smul]

end HopfAlgebra

section Faithful

attribute [local instance] Comodule.dual

/-- **Right translation is a sum of generalized eigenspaces.** Let `V` be a faithful comodule of
a commutative Hopf algebra `H` over a field `k`, and `g` a point with values in an algebraically
closed field `Ω`. If a submonoid `S` of `Ω` contains every eigenvalue of `g` on `V` and its
inverse, then the scalar extension `Ω ⊗ H` of the coordinate algebra is the sum of the generalized
eigenspaces of right translation by `g` for the eigenvalues in `S`. -/
theorem iSup_maxGenEigenspace_endOfPoint_regular_eq_top {k H V : Type u} [Field k]
    [CommRing H] [HopfAlgebra k H] [AddCommGroup V] [Module k V] [Comodule k H V]
    (hV : IsFaithful (k := k) (H := H) (V := V)) {Ω : Type*} [Field Ω] [IsAlgClosed Ω]
    [Algebra k Ω] (g : WithConv (H →ₐ[k] Ω)) {S : Submonoid Ω}
    (hS : ∀ μ, Module.End.HasEigenvalue (endOfPoint V g.ofConv) μ → μ ∈ S ∧ μ⁻¹ ∈ S) :
    ⨆ μ ∈ S, Module.End.maxGenEigenspace (endOfPoint H g.ofConv) μ = ⊤ := by
  have := hV.finite
  set B := ⨆ μ ∈ S, Module.End.maxGenEigenspace (endOfPoint H g.ofConv) μ
  -- `B` is an `Ω`-subalgebra, since right translation is an algebra endomorphism.
  have hone : (1 : Ω ⊗[k] H) ∈ B := by
    simpa using (regularEndOfPoint g.ofConv).one_mem_iSup_maxGenEigenspace S
  have hmul (x y : Ω ⊗[k] H) (hx : x ∈ B) (hy : y ∈ B) : x * y ∈ B := by
    have := (regularEndOfPoint g.ofConv).mul_mem_iSup_maxGenEigenspace (S := S) (x := x) (y := y)
    simp only [regularEndOfPoint_toLinearMap] at this
    exact this hx hy
  -- The functions whose scalar extension lies in `B` form a `k`-subalgebra `C` of `H`.
  let C : Subalgebra k H := ((B.toSubalgebra hone hmul).restrictScalars k).comap
    (Algebra.TensorProduct.includeRight (R := k) (A := Ω) (B := H))
  have hmemC (h : H) : h ∈ C ↔ (1 : Ω) ⊗ₜ[k] h ∈ B := by
    simp only [C, Subalgebra.mem_comap, Subalgebra.mem_restrictScalars,
      Algebra.TensorProduct.includeRight_apply]
    exact Submodule.mem_toSubalgebra
  -- It contains the coefficients of `V` and of its dual, which generate `H`.
  have hCV : matrixCoefficientSubalgebra (R := k) (C := H) (M := V) ≤ C :=
    matrixCoefficientSubalgebra_le fun φ v ↦ (hmemC _).mpr <|
      one_tmul_matrixCoefficient_mem_iSup_maxGenEigenspace g.ofConv
        (fun μ hμ ↦ (hS μ hμ).1) φ v
  have hCV' : matrixCoefficientSubalgebra (R := k) (C := H) (M := Module.Dual k V) ≤ C :=
    matrixCoefficientSubalgebra_le fun φ v ↦ (hmemC _).mpr <|
      one_tmul_matrixCoefficient_mem_iSup_maxGenEigenspace g.ofConv (fun μ hμ ↦ by
        simpa using (hS _ (hasEigenvalue_inv_of_hasEigenvalue_endOfPoint_dual g hμ)).2) φ v
  have hCtop : C = ⊤ := by
    rw [eq_top_iff, ← (isFaithful_iff_matrixCoefficientSubalgebra_sup_antipode_eq_top
      (Module.finBasis k V)).mp hV, ← matrixCoefficientSubalgebra_dual]
    exact sup_le hCV hCV'
  -- Hence `B` contains every pure tensor.
  refine eq_top_iff.mpr fun x _ ↦ ?_
  induction x using TensorProduct.inductionOn with
  | add x y hx hy => exact B.add_mem (hx Submodule.mem_top) (hy Submodule.mem_top)
  | tmul a h =>
    have hh : (1 : Ω) ⊗ₜ[k] h ∈ B := (hmemC h).mp (hCtop ▸ Algebra.mem_top)
    simpa [TensorProduct.smul_tmul'] using B.smul_mem a hh

/-- **Eigenvalues in a faithful representation control all eigenvalues.** Let `V` be a faithful
comodule of a commutative Hopf algebra `H` over a field `k` (a closed immersion of the affine
group into `GL(V)`), `W` any comodule, and `g` a point with values in an algebraically closed
field `Ω`. Then every eigenvalue of `g` on `W` lies in the subgroup of `Ωˣ` generated by the
eigenvalues of `g` on `V`.

A faithful representation is needed, not merely an injective one on points: the coefficients of
`V` and of its dual must generate the coordinate algebra. -/
theorem exists_mem_closure_hasEigenvalue_of_isFaithful {k H V : Type u} [Field k] [CommRing H]
    [HopfAlgebra k H] [AddCommGroup V] [Module k V] [Comodule k H V]
    (hV : IsFaithful (k := k) (H := H) (V := V)) {W : Type*} [AddCommGroup W] [Module k W]
    [Comodule k H W] {Ω : Type*} [Field Ω] [IsAlgClosed Ω] [Algebra k Ω]
    (g : WithConv (H →ₐ[k] Ω)) {ν : Ω}
    (hν : Module.End.HasEigenvalue (endOfPoint W g.ofConv) ν) :
    ∃ u ∈ Subgroup.closure {u : Ωˣ | Module.End.HasEigenvalue (endOfPoint V g.ofConv) (u : Ω)},
      (u : Ω) = ν := by
  set Γ := Subgroup.closure {u : Ωˣ | Module.End.HasEigenvalue (endOfPoint V g.ofConv) (u : Ω)}
  set S := Γ.toSubmonoid.map (Units.coeHom Ω)
  have hS (μ : Ω) (hμ : Module.End.HasEigenvalue (endOfPoint V g.ofConv) μ) :
      μ ∈ S ∧ μ⁻¹ ∈ S := by
    have hu : Units.mk0 μ (ne_zero_of_hasEigenvalue_endOfPoint g hμ) ∈ Γ :=
      Subgroup.subset_closure hμ
    exact ⟨⟨_, hu, rfl⟩, ⟨_, Γ.inv_mem hu, by simp⟩⟩
  -- An eigenvector of right translation for `ν` would otherwise be independent of the
  -- generalized eigenspaces for eigenvalues in `S`, which span everything.
  obtain ⟨z, hz⟩ := (hasEigenvalue_endOfPoint_regular g.ofConv hν).exists_hasEigenvector
  by_contra! hνS
  have hle : ⨆ μ ∈ S, Module.End.maxGenEigenspace (endOfPoint H g.ofConv) μ ≤
      ⨆ (μ) (_ : μ ≠ ν), Module.End.maxGenEigenspace (endOfPoint H g.ofConv) μ :=
    iSup₂_le fun μ hμ ↦ le_iSup₂_of_le μ (by
      rintro rfl
      obtain ⟨u, hu, rfl⟩ := hμ
      exact hνS u hu rfl) le_rfl
  rw [iSup_maxGenEigenspace_endOfPoint_regular_eq_top hV g hS, top_le_iff] at hle
  refine hz.2 (Submodule.disjoint_def.mp
    (Module.End.independent_maxGenEigenspace (endOfPoint H g.ofConv) ν) z
    (Module.End.eigenspace_le_maxGenEigenspace hz.1) ?_)
  exact hle ▸ Submodule.mem_top

/-- **Eigenvalues of a rational point.** Let `V` be a faithful comodule and `W` a
finite-dimensional comodule of a commutative Hopf algebra over a field `k`, and let `γ` be a
`k`-point. Every root, in an algebraically closed field `Ω` containing `k`, of the characteristic
polynomial of `γ` on `W` lies in the subgroup of `Ωˣ` generated by the roots of its characteristic
polynomial on `V`. -/
theorem exists_mem_closure_mem_aroots_charpoly_of_isFaithful {k H V : Type u} [Field k]
    [CommRing H] [HopfAlgebra k H] [AddCommGroup V] [Module k V] [Comodule k H V]
    [Module.Finite k V] (hV : IsFaithful (k := k) (H := H) (V := V)) {W : Type*}
    [AddCommGroup W] [Module k W] [Comodule k H W] [Module.Finite k W] {Ω : Type*} [Field Ω]
    [IsAlgClosed Ω] [Algebra k Ω]
    (γ : WithConv (H →ₐ[k] k)) {α : Ω}
    (hα : α ∈ (endOfPoint W γ.ofConv).charpoly.aroots Ω) :
    ∃ u ∈ Subgroup.closure
        {u : Ωˣ | (u : Ω) ∈ (endOfPoint V γ.ofConv).charpoly.aroots Ω},
      (u : Ω) = α := by
  let g : WithConv (H →ₐ[k] Ω) := toConv ((Algebra.ofId k Ω).comp γ.ofConv)
  have hset : {u : Ωˣ | (u : Ω) ∈ (endOfPoint V γ.ofConv).charpoly.aroots Ω} =
      {u : Ωˣ | Module.End.HasEigenvalue (endOfPoint V g.ofConv) (u : Ω)} :=
    Set.ext fun u ↦ mem_aroots_charpoly_endOfPoint_iff γ.ofConv (u : Ω)
  rw [hset]
  exact exists_mem_closure_hasEigenvalue_of_isFaithful hV g
    ((mem_aroots_charpoly_endOfPoint_iff γ.ofConv α).mp hα)

end Faithful

end TauCeti.Comodule
