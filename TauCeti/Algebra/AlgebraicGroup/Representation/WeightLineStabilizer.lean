module

public import TauCeti.Algebra.AlgebraicGroup.Representation.Stabilizer
public import TauCeti.Algebra.Coalgebra.Comodule.Weight.Vector
public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.GroupLike
import Mathlib.Tactic.Module

/-!
# The stabilizer of the line through a sum of two weight vectors

Let `M` be a representation of an affine group `G = Spec H` over a field `k`, and let `e₁, e₂` be
linearly independent weight vectors of `M` with characters `χ₁, χ₂`, so that the coaction sends
`eᵢ` to `eᵢ ⊗ χᵢ`. A point `g` of `G` sends `e₁ + e₂` to `χ₁(g) e₁ + χ₂(g) e₂`, which lies on the
line through `e₁ + e₂` exactly when `χ₁(g) = χ₂(g)`.

This file proves the scheme-theoretic form of that computation: the ideal of the stabilizer of the
line `k ∙ (e₁ + e₂)` is generated by the single element `χ₁ - χ₂`. Thus the stabilizer is the
kernel of the character `χ₁ χ₂⁻¹` as a closed subgroup scheme, not only on reduced points. Its
points with values in any commutative `k`-algebra are those on which `χ₁` and `χ₂` agree, and its
Lie algebra, with values in any commutative `k`-algebra, consists of the tangent vectors `d` with
`d χ₁ = d χ₂`.

The Lie algebra statement is where the scheme structure is visible. In characteristic `p` the
character `χ₁ χ₂⁻¹` can be a `p`th power. Then every tangent vector satisfies `d χ₁ = d χ₂`, so the
stabilizer has the full Lie algebra of `G` and the orbit map of the line has zero differential,
although the stabilizer can be a proper, nonreduced subgroup such as `μ_p ⊂ 𝔾ₘ`.

## Main declarations

* `Submodule.stabilizerHopfIdeal_span_singleton_add_toIdeal`: the stabilizer ideal of
  `k ∙ (e₁ + e₂)` is `(χ₁ - χ₂)`.
* `Submodule.stabilizerHopfIdeal_span_singleton_add_le_ker_iff`: a point lies in the stabilizer
  exactly when `χ₁` and `χ₂` take the same value at it.
* `Submodule.mem_lieSubalgebra_stabilizerHopfIdeal_span_singleton_add_iff`: a tangent vector lies
  in the Lie algebra of the stabilizer exactly when it takes the same value on `χ₁` and `χ₂`.

## References

* J. S. Milne, *Algebraic Groups* (2017), §§7.c–7.f and §12.c.
* A. Borel, *Linear Algebraic Groups*, 2nd ed. (1991), §1.8 and §6.7.
-/

public section

open scoped TensorProduct

open TauCeti

universe u v w

noncomputable section

namespace Submodule

variable {k : Type u} {H : Type v} {M : Type w} [Field k] [CommRing H] [HopfAlgebra k H]
variable [AddCommGroup M] [Module k M] [Comodule k H M]

variable (H) in
/-- **The stabilizer of the line through a sum of two weight vectors.** If `e₁, e₂` are linearly
independent with coactions `eᵢ ↦ eᵢ ⊗ χᵢ`, then the ideal of the stabilizer of the line
`k ∙ (e₁ + e₂)` is generated by `χ₁ - χ₂`: the stabilizer is the closed subgroup scheme on which
the characters `χ₁` and `χ₂` agree. -/
theorem stabilizerHopfIdeal_span_singleton_add_toIdeal {e₁ e₂ : M} {χ₁ χ₂ : H}
    (he : LinearIndependent k ![e₁, e₂])
    (h₁ : Comodule.coact (R := k) (C := H) e₁ = e₁ ⊗ₜ[k] χ₁)
    (h₂ : Comodule.coact (R := k) (C := H) e₂ = e₂ ⊗ₜ[k] χ₂) :
    ((k ∙ (e₁ + e₂)).stabilizerHopfIdeal H).toIdeal = Ideal.span {χ₁ - χ₂} := by
  have hχ₁ := Comodule.isGroupLikeElem_of_coact_eq_tmul (he.ne_zero 0) h₁
  have hχ₂ := Comodule.isGroupLikeElem_of_coact_eq_tmul (he.ne_zero 1) h₂
  set L := k ∙ (e₁ + e₂)
  -- The matrix coefficient of `e₁ + e₂` against a functional `φ` is `φ e₁ • χ₁ + φ e₂ • χ₂`.
  have hcoeff (φ : Module.Dual k M) :
      Comodule.matrixCoefficient (R := k) (C := H) φ (e₁ + e₂) = φ e₁ • χ₁ + φ e₂ • χ₂ := by
    simp [Comodule.matrixCoefficient_def, h₁, h₂]
  -- A functional on `M ⧸ L` takes opposite values on `e₁` and `e₂`.
  have hq (ψ : Module.Dual k (M ⧸ L)) : ψ (L.mkQ e₂) = -ψ (L.mkQ e₁) := by
    have hL : ψ (L.mkQ e₁) + ψ (L.mkQ e₂) = 0 := by
      rw [← map_add, ← map_add, mkQ_apply,
        (Quotient.mk_eq_zero L).mpr (mem_span_singleton_self _), map_zero]
    linear_combination hL
  refine le_antisymm ?_ ?_
  · -- Every generator `c(ψ ∘ q, a • (e₁ + e₂))` is a multiple of `χ₁ - χ₂`.
    rw [← HopfIdeal.ofGroupLikeSub_toIdeal hχ₁ hχ₂, HopfIdeal.toIdeal_le_toIdeal,
      stabilizerHopfIdeal_le_iff]
    intro ψ w hw
    obtain ⟨a, rfl⟩ := mem_span_singleton.mp hw
    rw [← HopfIdeal.mem_toIdeal]
    convert Submodule.smul_of_tower_mem _ (a * ψ (L.mkQ e₁))
      (HopfIdeal.mem_toIdeal.2 (HopfIdeal.sub_mem_ofGroupLikeSub hχ₁ hχ₂)) using 1
    simp only [Comodule.matrixCoefficient_smul, hcoeff, LinearMap.comp_apply, hq]
    module
  · -- A functional on `M ⧸ L` taking `e₁` to `1` takes `e₂` to `-1`.
    rw [← HopfIdeal.ofGroupLikeSub_toIdeal hχ₁ hχ₂, HopfIdeal.toIdeal_le_toIdeal,
      HopfIdeal.ofGroupLikeSub_le_iff]
    have he₁ : L.mkQ e₁ ≠ 0 := by
      rw [mkQ_apply, Ne, Quotient.mk_eq_zero, mem_span_singleton]
      rintro ⟨a, ha⟩
      obtain ⟨h1, h2⟩ := LinearIndependent.pair_iff.mp he (a - 1) a (by
        rw [sub_smul, one_smul, sub_add_eq_add_sub, ← smul_add, ha, sub_self])
      rw [h2, zero_sub, neg_eq_zero] at h1
      exact one_ne_zero h1
    obtain ⟨ψ, hψ⟩ := Module.Projective.exists_dual_eq_one k he₁
    have hmem := matrixCoefficient_mem_stabilizerHopfIdeal (H := H) L ψ
      (mem_span_singleton_self (e₁ + e₂))
    simp only [hcoeff, LinearMap.comp_apply, hq, hψ] at hmem
    convert hmem using 1
    module

/-- **Points of the stabilizer of the line through a sum of two weight vectors.** An
algebra-valued point stabilizes `k ∙ (e₁ + e₂)` exactly when the characters `χ₁` and `χ₂` take
the same value at it. -/
theorem stabilizerHopfIdeal_span_singleton_add_le_ker_iff {e₁ e₂ : M} {χ₁ χ₂ : H}
    (he : LinearIndependent k ![e₁, e₂])
    (h₁ : Comodule.coact (R := k) (C := H) e₁ = e₁ ⊗ₜ[k] χ₁)
    (h₂ : Comodule.coact (R := k) (C := H) e₂ = e₂ ⊗ₜ[k] χ₂)
    {A : Type*} [CommRing A] [Algebra k A] (g : H →ₐ[k] A) :
    ((k ∙ (e₁ + e₂)).stabilizerHopfIdeal H).toIdeal ≤ RingHom.ker g ↔ g χ₁ = g χ₂ := by
  have hχ₁ := Comodule.isGroupLikeElem_of_coact_eq_tmul (he.ne_zero 0) h₁
  have hχ₂ := Comodule.isGroupLikeElem_of_coact_eq_tmul (he.ne_zero 1) h₂
  rw [stabilizerHopfIdeal_span_singleton_add_toIdeal H he h₁ h₂,
    ← HopfIdeal.ofGroupLikeSub_toIdeal hχ₁ hχ₂]
  exact HopfIdeal.ofGroupLikeSub_le_ker_iff hχ₁ hχ₂ g

/-- **The Lie algebra of the stabilizer of the line through a sum of two weight vectors.** A
tangent vector lies in it exactly when it takes the same value on the characters `χ₁` and
`χ₂`. -/
theorem mem_lieSubalgebra_stabilizerHopfIdeal_span_singleton_add_iff {e₁ e₂ : M} {χ₁ χ₂ : H}
    (he : LinearIndependent k ![e₁, e₂])
    (h₁ : Comodule.coact (R := k) (C := H) e₁ = e₁ ⊗ₜ[k] χ₁)
    (h₂ : Comodule.coact (R := k) (C := H) e₂ = e₂ ⊗ₜ[k] χ₂)
    {B : Type*} [CommRing B] [Algebra k B] (d : Derivation k H (Bialgebra.CounitAlgebra k H B)) :
    d ∈ ((k ∙ (e₁ + e₂)).stabilizerHopfIdeal H).lieSubalgebra (B := B) ↔ d χ₁ = d χ₂ := by
  rw [HopfIdeal.mem_lieSubalgebra_iff_of_toIdeal_eq_span _
    (stabilizerHopfIdeal_span_singleton_add_toIdeal H he h₁ h₂)]
  simp [sub_eq_zero]

end Submodule
