module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Weight.Parabolic
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Basic
public import TauCeti.Algebra.AlgebraicGroup.Representation.Coordinate
public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Map

/-!
# Split flags for generated affine group schemes

A based representation preserves its decreasing weight filtration exactly when its coefficient
matrix is block triangular. This file expresses the same condition for the closed subgroup scheme
generated by a family of morphisms: the image of the weight-parabolic ideal under the
representation's coordinate morphism lies in the family's common-kernel Hopf ideal exactly when
every member of the family has block-triangular coefficient matrix.

This is entirely scheme theoretic. It makes no assertion about density of algebra-valued points.
Related criteria for tensors preserved by generated subgroup schemes are developed in
`TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Generated.Preserves`.

## Main declaration

* `TauCeti.Comodule.weightParabolic_map_coordinateBialgHom_le_commonKernel_iff_blockTriangular`:
  a family of generators preserves a split weighted flag exactly when the generated closed
  subgroup scheme does.
* `TauCeti.Comodule.coefficientMatrix_commonKernelQuotient_blockTriangular`: the representation
  corestricted to the generated group's coordinate algebra has block-triangular coefficient
  matrix.
-/

public section

namespace TauCeti.Comodule

open CategoryTheory

universe u v w x

noncomputable section

variable {R : Type u} [CommRing R]
variable {H : _root_.CommHopfAlgCat.{v} R}
variable {M : Type w} [AddCommMonoid M] [Module R M] [Comodule R H M]
variable {n : ℕ} {ι : Type x} {K : ι → _root_.CommHopfAlgCat.{v} R}

/-- The image of the weight-parabolic ideal under a representation's coordinate morphism lies in
the common-kernel ideal of a family precisely when every member of the family makes the
coefficient matrix block triangular.

Contravariantly, the right side says that every generating subgroup scheme preserves the split
decreasing weight filtration, while the left side says the closed subgroup scheme they generate
does so. -/
theorem weightParabolic_map_coordinateBialgHom_le_commonKernel_iff_blockTriangular
    (f : ∀ a, H ⟶ K a) (b : Module.Basis (Fin n) R M) (weight : Fin n → ℤ) :
    (GeneralLinear.weightParabolicDefiningHopfIdeal R weight).map
        (coordinateBialgHom (H := H) b) ≤
        CommHopfAlgCat.commonKernelHopfIdeal f ↔
      ∀ a, ((coefficientMatrix (C := H) b).map (f a).hom).BlockTriangular
        (OrderDual.toDual ∘ weight) := by
  let g (a : ι) : HopfAlgebra.points (R := R)
      (H := GeneralLinear.coordinateHopfAlgebra R n) (CommAlgCat.of R (K a)) :=
    WithConv.toConv ((f a).hom.toAlgHom.comp (coordinateBialgHom (H := H) b).toAlgHom)
  have g_matrix (a : ι) :
      (GeneralLinear.pointsMulEquiv n (g a) : Matrix (Fin n) (Fin n) (K a)) =
        (coefficientMatrix (C := H) b).map (f a).hom :=
    (f a).hom.toAlgHom.pointsMulEquiv_comp_coordinateBialgHom b
  rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  constructor
  · intro h a
    rw [← g_matrix a]
    apply (GeneralLinear.mem_weightParabolicDefiningPointsSubgroup_iff_blockTriangular
      R weight (g a)).mp
    apply (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mpr
    intro z hz
    have hmap := HopfIdeal.mem_map_of_mem (coordinateBialgHom (H := H) b) hz
    have hzero := RingHom.mem_ker.mp (h a (HopfIdeal.mem_toIdeal.mpr hmap))
    simpa only [g, WithConv.ofConv_toConv, AlgHom.comp_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, BialgHom.coe_toAlgHom] using hzero
  · intro h a
    rw [HopfIdeal.map_toIdeal, Ideal.map_le_iff_le_comap]
    intro z hz
    apply Ideal.mem_comap.mpr
    apply RingHom.mem_ker.mpr
    have hg : g a ∈ CommHopfAlgCat.quotientPointsSubgroup
        (GeneralLinear.coordinateHopfAlgebra R n)
        (GeneralLinear.weightParabolicDefiningHopfIdeal R weight)
        (CommAlgCat.of R (K a)) :=
      (GeneralLinear.mem_weightParabolicDefiningPointsSubgroup_iff_blockTriangular
        R weight (g a)).mpr (g_matrix a ▸ h a)
    have hzero := (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mp hg z hz
    simpa only [g, WithConv.ofConv_toConv, AlgHom.comp_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, BialgHom.coe_toAlgHom] using hzero

/-- If every member of a family has block-triangular coefficient matrix, then so does the
representation corestricted to the common-kernel quotient, the coordinate algebra of the closed
subgroup scheme generated by that family. Consequently,
`Module.Basis.weightCoordinateSpanSubcomodule` constructs every step of the split decreasing
weight filtration as a subcomodule over the generated group. -/
theorem coefficientMatrix_commonKernelQuotient_blockTriangular
    (f : ∀ a, H ⟶ K a) (b : Module.Basis (Fin n) R M) (weight : Fin n → ℤ)
    (h : ∀ a, ((coefficientMatrix (C := H) b).map (f a).hom).BlockTriangular
      (OrderDual.toDual ∘ weight)) :
    let J := CommHopfAlgCat.commonKernelHopfIdeal f
    letI : Comodule R (CommHopfAlgCat.quotient H J) M :=
      Corestrict (CommHopfAlgCat.mkQuotient H J).hom.toCoalgHom
    (coefficientMatrix (C := CommHopfAlgCat.quotient H J) b).BlockTriangular
      (OrderDual.toDual ∘ weight) := by
  dsimp only
  let J := CommHopfAlgCat.commonKernelHopfIdeal f
  let q := CommHopfAlgCat.mkQuotient H J
  let _ : Comodule R (CommHopfAlgCat.quotient H J) M := Corestrict q.hom.toCoalgHom
  let g : HopfAlgebra.points (R := R)
      (H := GeneralLinear.coordinateHopfAlgebra R n)
      (CommAlgCat.of R (CommHopfAlgCat.quotient H J)) :=
    WithConv.toConv (q.hom.toAlgHom.comp (coordinateBialgHom (H := H) b).toAlgHom)
  have g_matrix :
      (GeneralLinear.pointsMulEquiv n g :
          Matrix (Fin n) (Fin n) (CommHopfAlgCat.quotient H J)) =
        coefficientMatrix (C := CommHopfAlgCat.quotient H J) b := by
    rw [coefficientMatrix_corestrict]
    exact q.hom.toAlgHom.pointsMulEquiv_comp_coordinateBialgHom b
  rw [← g_matrix]
  apply (GeneralLinear.mem_weightParabolicDefiningPointsSubgroup_iff_blockTriangular
    R weight g).mp
  apply (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mpr
  intro z hz
  have hle :
      (GeneralLinear.weightParabolicDefiningHopfIdeal R weight).map
          (coordinateBialgHom (H := H) b) ≤ J :=
    (weightParabolic_map_coordinateBialgHom_le_commonKernel_iff_blockTriangular f b weight).mpr h
  have hmem : coordinateBialgHom (H := H) b z ∈ J :=
    hle (HopfIdeal.mem_map_of_mem (coordinateBialgHom (H := H) b) hz)
  have hzero := (CommHopfAlgCat.mkQuotient_eq_zero_iff H J _).mpr hmem
  simpa only [g, WithConv.ofConv_toConv, AlgHom.comp_apply, AlgHom.toRingHom_eq_coe,
    RingHom.coe_coe, BialgHom.coe_toAlgHom] using hzero

end

end TauCeti.Comodule
