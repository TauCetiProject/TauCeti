/-!
# The unipotence ideal of a representation

Let `M` be a finite free comodule over a commutative coalgebra `H`, so that `M` is a
representation `ρ` of the affine scheme `Spec H`. Its **unipotence ideal** `J_ρ ⊆ H` is generated
by the coefficients of `det (T - ρ(g)) - (T - 1) ^ dim M`, the characteristic polynomial of the
universal point `g = id : H → H` acting on `H ⊗ M`, minus that of the identity. A point
`g : H → B` annihilates `J_ρ` exactly when its action on `B ⊗ M` has characteristic polynomial
`(T - 1) ^ dim M`.

For a Hopf algebra these equations cut out unipotence of the point action only over a reduced
value ring. Over a nonreduced ring they are strictly stronger than nilpotence of `ρ(g) - 1`, and
different faithful representations can give ideals with different nilpotent structure: for
example, for the multiplicative group the characters `t` and `t⁻¹` together give the ideal
`((t - 1) ^ 2)`, whereas the character `t` alone gives `(t - 1)`. What is intrinsic is
the radical: when `H` is of finite type over a field `k` and `ρ` is faithful, the radical of
`J_ρ` is the ideal of functions vanishing at every unipotent point with values in an
algebraically closed field. In particular it does not depend on the faithful representation, and
its points with values in a perfect field are exactly the unipotent points. This radical is the
defining ideal of the reduced unipotent variety of the group.

## Main declarations

* `TauCeti.Comodule.unipotenceIdeal`: the ideal of characteristic-polynomial equations
  `det (T - ρ(g)) = (T - 1) ^ dim M`.
* `TauCeti.Comodule.unipotenceIdeal_le_ker_iff`: a point annihilates the unipotence ideal exactly
  when its action has characteristic polynomial `(T - 1) ^ dim M`.
* `TauCeti.Comodule.unipotenceIdeal_eq_contentIdeal_coefficientMatrix_charpoly`: the generators
  in terms of the coefficient matrix in a basis.
* `TauCeti.Comodule.unipotenceIdeal_le_ker_iff_isUnipotent`: over a reduced value ring, the
  points of the unipotence ideal are those acting unipotently.
* `TauCeti.Comodule.unipotenceIdeal_le_ker_iff_isUnipotentPoint` and
  `TauCeti.Comodule.radical_unipotenceIdeal_le_ker_iff_isUnipotentPoint`: for a faithful
  representation, the points with values in a perfect field are the unipotent points.
* `TauCeti.Comodule.mem_radical_unipotenceIdeal_iff`: for a faithful representation of a group
  of finite type, the radical is the vanishing ideal of the geometric unipotent points.
* `TauCeti.Comodule.radical_unipotenceIdeal_eq`: this radical does not depend on the faithful
  representation.

## References

* A. Borel, *Linear Algebraic Groups*, §4.4 and §4.8.
* T. A. Springer, *Linear Algebraic Groups*, §2.4.
* A. Bertoloni Meli, N. Imai and A. Youcis, *The Jacobson–Morozov morphism for Langlands
  parameters in the relative setting*, §2.1, Proposition 2.3.
-/

public section

open Module Polynomial

namespace TauCeti.Comodule

universe u v w x

noncomputable section

section Coalgebra

variable {R : Type u} {H : Type v} {M : Type w}
variable [CommRing R] [CommRing H] [Algebra R H] [Coalgebra R H]
variable [AddCommGroup M] [Module R M] [Comodule R H M] [Module.Free R M] [Module.Finite R M]

variable (R H M) in
/-- The **unipotence ideal** of a finite free comodule `M` over a commutative coalgebra `H`.
It is the content ideal, generated by the coefficients, of `χ - (X - 1) ^ rank M`, where `χ` is
the characteristic polynomial of the action of the universal point `AlgHom.id R H` on
`H ⊗[R] M`. In a basis these are the coefficients of `det (X - ρ) - (X - 1) ^ rank M` for the
coefficient matrix `ρ`, see `unipotenceIdeal_eq_contentIdeal_coefficientMatrix_charpoly`. -/
def unipotenceIdeal : Ideal H :=
  ((endOfPoint M (AlgHom.id R H)).charpoly - (X - 1) ^ finrank R M).contentIdeal

/-- The unipotence ideal is the content ideal of `χ - (X - 1) ^ rank M`, where `χ` is the
characteristic polynomial of the action of the universal point. -/
theorem unipotenceIdeal_def :
    unipotenceIdeal R H M =
      ((endOfPoint M (AlgHom.id R H)).charpoly - (X - 1) ^ finrank R M).contentIdeal := (rfl)

variable (M) in
/-- Each coefficient of `χ - (X - 1) ^ rank M` lies in the unipotence ideal, where `χ` is the
characteristic polynomial of the action of the universal point. -/
theorem coeff_mem_unipotenceIdeal (n : ℕ) :
    ((endOfPoint M (AlgHom.id R H)).charpoly - (X - 1) ^ finrank R M).coeff n ∈
      unipotenceIdeal R H M := by
  rw [unipotenceIdeal_def]
  exact coeff_mem_contentIdeal _ n

/-- A point annihilates the unipotence ideal exactly when its action on the scalar extension has
characteristic polynomial `(X - 1) ^ rank M`. No hypothesis on the value ring is needed. -/
theorem unipotenceIdeal_le_ker_iff {B : Type x} [CommRing B] [Algebra R B] (g : H →ₐ[R] B) :
    unipotenceIdeal R H M ≤ RingHom.ker g ↔
      (endOfPoint M g).charpoly = (X - 1) ^ finrank R M := by
  have hg : (endOfPoint M g).charpoly =
      ((endOfPoint M (AlgHom.id R H)).charpoly).map g := by
    simpa using charpoly_endOfPoint_comp (M := M) (AlgHom.id R H) g
  have hpow : ((X - 1 : B[X]) ^ finrank R M) = ((X - 1 : H[X]) ^ finrank R M).map g := by
    simp
  rw [unipotenceIdeal_def, ← RingHom.ker_coe_toRingHom, ← Ideal.map_eq_bot_iff_le_ker,
    ← contentIdeal_map_eq_map_contentIdeal,
    contentIdeal_eq_bot_iff, Polynomial.map_sub, hg, hpow, sub_eq_zero]

/-- In a basis of `M`, the unipotence ideal is generated by the coefficients of
`det (X - ρ) - (X - 1) ^ rank M`, where `ρ` is the coefficient matrix. -/
theorem unipotenceIdeal_eq_contentIdeal_coefficientMatrix_charpoly {ι : Type x} [Fintype ι]
    [DecidableEq ι] (b : Basis ι R M) :
    unipotenceIdeal R H M =
      ((coefficientMatrix (C := H) b).charpoly - (X - 1) ^ finrank R M).contentIdeal := by
  rw [unipotenceIdeal_def, ← LinearMap.charpoly_toMatrix _ (b.baseChange H), toMatrix_endOfPoint,
    AlgHom.coe_id, Matrix.map_id]

end Coalgebra

section HopfAlgebra

variable {R : Type u} {H : Type v} {M : Type w}
variable [CommRing R] [CommRing H] [HopfAlgebra R H]
variable [AddCommGroup M] [Module R M] [Comodule R H M] [Module.Free R M] [Module.Finite R M]
variable {B : Type x} [CommRing B] [Algebra R B]

/-- A point annihilating the unipotence ideal acts unipotently on the scalar extension, for any
commutative value ring. -/
theorem isUnipotent_pointsAction_of_unipotenceIdeal_le_ker (g : WithConv (H →ₐ[R] B))
    (hg : unipotenceIdeal R H M ≤ RingHom.ker g.ofConv) :
    LinearMap.GeneralLinearGroup.IsUnipotent
      (LinearMap.GeneralLinearGroup.ofLinearEquiv (pointsAction M g)) := by
  refine LinearMap.GeneralLinearGroup.isUnipotent_of_charpoly_eq _ (n := finrank R M) ?_
  rw [LinearMap.GeneralLinearGroup.val_ofLinearEquiv, pointsAction_toLinearMap]
  exact (unipotenceIdeal_le_ker_iff g.ofConv).mp hg

/-- Over a reduced value ring, a point annihilates the unipotence ideal exactly when it acts
unipotently on the scalar extension. Reducedness is needed: over `B = k[ε] / (ε ^ 2)`, the point
`t ↦ 1 + ε` of the multiplicative group acts unipotently on the character `t`, but its
characteristic polynomial there is `X - 1 - ε` rather than `X - 1`. -/
theorem unipotenceIdeal_le_ker_iff_isUnipotent [IsReduced B] (g : WithConv (H →ₐ[R] B)) :
    unipotenceIdeal R H M ≤ RingHom.ker g.ofConv ↔
      LinearMap.GeneralLinearGroup.IsUnipotent
        (LinearMap.GeneralLinearGroup.ofLinearEquiv (pointsAction M g)) := by
  refine ⟨isUnipotent_pointsAction_of_unipotenceIdeal_le_ker g, fun h ↦ ?_⟩
  rw [unipotenceIdeal_le_ker_iff]
  rcases subsingleton_or_nontrivial B with hB | hB
  · exact Subsingleton.elim _ _
  -- Over a nontrivial value ring the rank of `M` is preserved by scalar extension.
  have : Nontrivial R := (algebraMap R B).domain_nontrivial
  rwa [LinearMap.GeneralLinearGroup.isUnipotent_iff_charpoly,
    LinearMap.GeneralLinearGroup.val_ofLinearEquiv, pointsAction_toLinearMap,
    Module.finrank_baseChange] at h

end HopfAlgebra

section Faithful

variable {k H K : Type u} [Field k] [CommRing H] [HopfAlgebra k H]

attribute [local instance 1100] Module.Free.of_divisionRing

/-- For a faithful representation, a point with values in a perfect field annihilates the
unipotence ideal exactly when it is a unipotent point of the group. -/
theorem unipotenceIdeal_le_ker_iff_isUnipotentPoint [Field K] [Algebra k K] [PerfectField K]
    (M : FGComoduleCat.{u, u, u} k H) (hM : IsFaithful (k := k) (H := H) (V := M))
    (g : WithConv (H →ₐ[k] K)) :
    unipotenceIdeal k H M ≤ RingHom.ker g.ofConv ↔ HopfAlgebra.IsUnipotentPoint g := by
  rw [HopfAlgebra.isUnipotentPoint_iff_isUnipotent_pointsAction_of_isFaithful M hM,
    unipotenceIdeal_le_ker_iff_isUnipotent]

/-- For a faithful representation, the points of the radical of the unipotence ideal with values
in a perfect field are exactly the unipotent points of the group. -/
theorem radical_unipotenceIdeal_le_ker_iff_isUnipotentPoint [Field K] [Algebra k K]
    [PerfectField K] (M : FGComoduleCat.{u, u, u} k H)
    (hM : IsFaithful (k := k) (H := H) (V := M)) (g : WithConv (H →ₐ[k] K)) :
    (unipotenceIdeal k H M).radical ≤ RingHom.ker g.ofConv ↔ HopfAlgebra.IsUnipotentPoint g := by
  rw [(RingHom.ker_isPrime g.ofConv).radical_le_iff,
    unipotenceIdeal_le_ker_iff_isUnipotentPoint M hM]

variable [Algebra.FiniteType k H]

/-- For a faithful representation of an affine group of finite type, the radical of the
unipotence ideal is the ideal of functions vanishing at every unipotent point with values in a
fixed algebraically closed extension of the ground field. -/
theorem mem_radical_unipotenceIdeal_iff (K : Type u) [Field K] [Algebra k K] [IsAlgClosed K]
    (M : FGComoduleCat.{u, u, u} k H) (hM : IsFaithful (k := k) (H := H) (V := M)) (x : H) :
    x ∈ (unipotenceIdeal k H M).radical ↔
      ∀ g : WithConv (H →ₐ[k] K), HopfAlgebra.IsUnipotentPoint g → g.ofConv x = 0 := by
  rw [mem_radical_iff_forall_algHom_apply_eq_zero (k := k) (K := K)]
  refine ⟨fun h g hg ↦ h g.ofConv ((unipotenceIdeal_le_ker_iff_isUnipotentPoint M hM g).mpr hg),
    fun h g hg ↦ h (WithConv.toConv g) ?_⟩
  exact (unipotenceIdeal_le_ker_iff_isUnipotentPoint M hM (WithConv.toConv g)).mp hg

/-- The radical of the unipotence ideal of a faithful representation of an affine group of
finite type does not depend on the faithful representation. -/
theorem radical_unipotenceIdeal_eq (M N : FGComoduleCat.{u, u, u} k H)
    (hM : IsFaithful (k := k) (H := H) (V := M)) (hN : IsFaithful (k := k) (H := H) (V := N)) :
    (unipotenceIdeal k H M).radical = (unipotenceIdeal k H N).radical := by
  ext x
  rw [mem_radical_unipotenceIdeal_iff (AlgebraicClosure k) M hM,
    mem_radical_unipotenceIdeal_iff (AlgebraicClosure k) N hN]

end Faithful

end

end TauCeti.Comodule
