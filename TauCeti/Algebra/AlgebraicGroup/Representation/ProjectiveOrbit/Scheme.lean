module

public import TauCeti.Algebra.AlgebraicGroup.Representation.ProjectiveOrbit.LocallyClosed
public import TauCeti.AlgebraicGeometry.SchemeTheoreticImage.LocallyClosed

/-!
# Projective orbit schemes

For a finite-dimensional representation of a finite-type affine group scheme over an
algebraically closed field, the orbit of a line has a locally closed scheme structure.
Construct it as the scheme-theoretic image of the projective orbit morphism inside the
coborder of its topological image. The resulting immersion has exactly the full orbit
image, including its nonclosed points. The map from the group to the orbit scheme is
surjective, quasi-compact, locally of finite type, and scheme-theoretically dominant.

This is the scheme on which to study flatness of the orbit map and its comparison with
the homogeneous quotient by the stabilizer of the line. Flatness and that quotient
comparison are separate results. No smoothness or reducedness hypothesis is imposed on
the group; when the group is reduced, so is the orbit scheme.

The construction combines `Comodule.isLocallyClosed_range_projectiveOrbitMap` with
`Scheme.Hom.locallyClosedImage` and its factorization API.

## References

* J. S. Milne, *Algebraic Groups* (2017), §§7.c–7.f, orbits and homogeneous spaces.
* The Stacks Project, Tag 01R5, scheme-theoretic images.
-/

public section

open CategoryTheory AlgebraicGeometry

namespace TauCeti.Comodule

universe u

variable {k H M : Type u} [Field k] [IsAlgClosed k] [CommRing H] [HopfAlgebra k H]
  [Algebra.FiniteType k H] [AddCommGroup M] [Module k M] [Comodule k H M]
  [Module.Finite k M]

/-- The projective orbit scheme of the line generated by a unimodular vector.
Its scheme structure is the scheme-theoretic image inside the coborder of the orbit. -/
noncomputable abbrev projectiveOrbitScheme (m : M) (hm : Module.IsUnimodular k m) : Scheme.{u} :=
  (projectiveOrbitMap (H := H) m hm).locallyClosedImage
    (isLocallyClosed_range_projectiveOrbitMap m hm)

/-- The inclusion of the projective orbit scheme into projective space. -/
noncomputable def projectiveOrbitι (m : M) (hm : Module.IsUnimodular k m) :
    projectiveOrbitScheme (H := H) m hm ⟶
      Proj (SymmetricAlgebra.homogeneousSubmodule k (Module.Dual k M)) :=
  (projectiveOrbitMap (H := H) m hm).locallyClosedImageι
    (isLocallyClosed_range_projectiveOrbitMap m hm)

/-- The orbit morphism with its target restricted to the projective orbit scheme. -/
noncomputable def toProjectiveOrbit (m : M) (hm : Module.IsUnimodular k m) :
    Spec (.of H) ⟶ projectiveOrbitScheme (H := H) m hm :=
  (projectiveOrbitMap (H := H) m hm).toLocallyClosedImage
    (isLocallyClosed_range_projectiveOrbitMap m hm)

/-- The orbit inclusion is the inclusion of the locally closed scheme image. -/
theorem projectiveOrbitι_def (m : M) (hm : Module.IsUnimodular k m) :
    projectiveOrbitι (H := H) m hm =
      (projectiveOrbitMap (H := H) m hm).locallyClosedImageι
        (isLocallyClosed_range_projectiveOrbitMap m hm) := (rfl)

/-- The orbit factorization is the canonical map onto the locally closed scheme image. -/
theorem toProjectiveOrbit_def (m : M) (hm : Module.IsUnimodular k m) :
    toProjectiveOrbit (H := H) m hm =
      (projectiveOrbitMap (H := H) m hm).toLocallyClosedImage
        (isLocallyClosed_range_projectiveOrbitMap m hm) := (rfl)

/-- The projective orbit scheme is a locally closed subscheme of projective space. -/
instance instIsImmersionProjectiveOrbitι (m : M) (hm : Module.IsUnimodular k m) :
    IsImmersion (projectiveOrbitι (H := H) m hm) := by
  rw [projectiveOrbitι_def]
  infer_instance

/-- The map onto the orbit scheme followed by its inclusion is the original orbit morphism. -/
@[reassoc (attr := simp)]
theorem toProjectiveOrbit_projectiveOrbitι (m : M) (hm : Module.IsUnimodular k m) :
    toProjectiveOrbit (H := H) m hm ≫ projectiveOrbitι (H := H) m hm =
      projectiveOrbitMap (H := H) m hm := by
  rw [toProjectiveOrbit_def, projectiveOrbitι_def]
  exact Scheme.Hom.toLocallyClosedImage_locallyClosedImageι _ _

/-- Every point of the orbit scheme comes from a point of the group scheme. -/
instance instSurjectiveToProjectiveOrbit (m : M) (hm : Module.IsUnimodular k m) :
    Surjective (toProjectiveOrbit (H := H) m hm) := by
  rw [toProjectiveOrbit_def]
  infer_instance

/-- The orbit scheme has exactly the topological image of the original orbit morphism. -/
@[simp]
theorem range_projectiveOrbitι (m : M) (hm : Module.IsUnimodular k m) :
    Set.range (projectiveOrbitι (H := H) m hm) =
      Set.range (projectiveOrbitMap (H := H) m hm) := by
  rw [projectiveOrbitι_def, Scheme.Hom.range_locallyClosedImageι]

/-- The orbit map does not factor through any proper closed subscheme of the orbit scheme. -/
instance instIsSchemeTheoreticallyDominantToProjectiveOrbit
    (m : M) (hm : Module.IsUnimodular k m) :
    IsSchemeTheoreticallyDominant (toProjectiveOrbit (H := H) m hm) := by
  rw [toProjectiveOrbit_def]
  infer_instance

/-- The map onto the orbit scheme is locally of finite type. -/
instance instLocallyOfFiniteTypeToProjectiveOrbit (m : M) (hm : Module.IsUnimodular k m) :
    LocallyOfFiniteType (toProjectiveOrbit (H := H) m hm) := by
  rw [toProjectiveOrbit_def]
  infer_instance

/-- The orbit scheme of a reduced affine group scheme is reduced. -/
instance instIsReducedProjectiveOrbitScheme [_root_.IsReduced H]
    (m : M) (hm : Module.IsUnimodular k m) :
    IsReduced (projectiveOrbitScheme (H := H) m hm) := by
  let := Algebra.FiniteType.isNoetherianRing k H
  exact IsSchemeTheoreticallyDominant.isReduced (toProjectiveOrbit (H := H) m hm)

/-- The orbit scheme is Noetherian, including when the group is nonreduced. -/
instance instIsNoetherianProjectiveOrbitScheme (m : M) (hm : Module.IsUnimodular k m) :
    IsNoetherian (projectiveOrbitScheme (H := H) m hm) where
  toIsLocallyNoetherian := LocallyOfFiniteType.isLocallyNoetherian
    (projectiveOrbitι (H := H) m hm)
  toCompactSpace := Function.Surjective.compactSpace
    (toProjectiveOrbit (H := H) m hm).continuous
    (toProjectiveOrbit (H := H) m hm).surjective

/-- The structural morphism of the projective orbit scheme over the base field. -/
noncomputable def projectiveOrbitToSpec (m : M) (hm : Module.IsUnimodular k m) :
    projectiveOrbitScheme (H := H) m hm ⟶ Spec (.of k) :=
  projectiveOrbitι (H := H) m hm ≫ SymmetricAlgebra.projToSpec k (Module.Dual k M)

/-- The structural morphism is inherited from the ambient projective space. -/
theorem projectiveOrbitToSpec_def (m : M) (hm : Module.IsUnimodular k m) :
    projectiveOrbitToSpec (H := H) m hm =
      projectiveOrbitι (H := H) m hm ≫ SymmetricAlgebra.projToSpec k (Module.Dual k M) := (rfl)

/-- The orbit factorization is a morphism over the base field. -/
@[reassoc (attr := simp)]
theorem toProjectiveOrbit_projectiveOrbitToSpec (m : M) (hm : Module.IsUnimodular k m) :
    toProjectiveOrbit (H := H) m hm ≫ projectiveOrbitToSpec (H := H) m hm =
      Spec.map (CommRingCat.ofHom (algebraMap k H)) := by
  simp [projectiveOrbitToSpec_def, ← Category.assoc]

/-- The projective orbit scheme is locally of finite type over its base field. -/
instance instLocallyOfFiniteTypeProjectiveOrbitToSpec
    (m : M) (hm : Module.IsUnimodular k m) :
    LocallyOfFiniteType (projectiveOrbitToSpec (H := H) m hm) := by
  rw [projectiveOrbitToSpec_def]
  infer_instance

/-- Closed points are dense in every locally closed subset of the orbit scheme. -/
instance instJacobsonSpaceProjectiveOrbitScheme (m : M) (hm : Module.IsUnimodular k m) :
    JacobsonSpace (projectiveOrbitScheme (H := H) m hm) :=
  LocallyOfFiniteType.jacobsonSpace (projectiveOrbitToSpec (H := H) m hm)

end TauCeti.Comodule
