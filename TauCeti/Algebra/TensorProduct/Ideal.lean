module

public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Ideals in tensor products of algebras

For an ideal `I` of an `R`-algebra `A` and an `R`-algebra `B`,
`I.leftTensorIdeal R B` is the ideal of `A ⊗[R] B` generated by the image of `I` under
`includeLeft`. For an ideal `J` of `B`, `J.rightTensorIdeal R A` is generated by its image
under `includeRight`. They represent the images of `I ⊗[R] B` and `A ⊗[R] J`.

The constructions preserve joins and arbitrary suprema and commute with tensor-product
maps. Over a commutative ring, tensoring a quotient map has the corresponding tensor ideal
as its kernel; tensoring two surjective algebra maps has the sum of the two tensor ideals
as its kernel. Quotients of a noncommutative algebra require a two-sided ideal.

The kernel formulas use Mathlib's tensor-product right-exactness theorems.
-/

public section

open scoped TensorProduct

universe u v w

namespace Ideal

section Left

variable (R : Type u) {A : Type v} (B : Type w)
variable [CommSemiring R] [Semiring A] [Semiring B] [Algebra R A] [Algebra R B]

/-- The ideal of `A ⊗[R] B` generated by the left inclusion of `I`, representing `I ⊗ B`. -/
def leftTensorIdeal (I : Ideal A) : Ideal (A ⊗[R] B) :=
  Ideal.map (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := B)).toRingHom I

theorem leftTensorIdeal_def (I : Ideal A) :
    leftTensorIdeal R B I =
      Ideal.map (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := B)).toRingHom
        I :=
  (rfl)

/-- The left tensor inclusion sends elements of `I` into `I ⊗ B`. -/
theorem includeLeft_mem_leftTensorIdeal {I : Ideal A} {x : A} (hx : x ∈ I) :
    Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := B) x ∈
      leftTensorIdeal R B I :=
  Ideal.mem_map_of_mem _ hx

/-- A pure tensor `x ⊗ₜ y` with `x ∈ I` lies in `I ⊗ B`. -/
theorem tmul_mem_leftTensorIdeal {I : Ideal A} {x : A} (hx : x ∈ I) (y : B) :
    x ⊗ₜ[R] y ∈ leftTensorIdeal R B I := by
  have h : x ⊗ₜ[R] y =
      Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B) y *
        Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := B) x := by
    rw [Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.includeRight_apply,
      Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  rw [h]
  exact Ideal.mul_mem_left _ _ (includeLeft_mem_leftTensorIdeal R B hx)

theorem mem_leftTensorIdeal {I : Ideal A} {x : A ⊗[R] B} :
    x ∈ leftTensorIdeal R B I ↔
      x ∈ Ideal.map
        (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := B)).toRingHom I :=
  Iff.rfl

/-- The order universal property for `I ⊗ B`. -/
theorem leftTensorIdeal_le_iff {I : Ideal A} {J : Ideal (A ⊗[R] B)} :
    leftTensorIdeal R B I ≤ J ↔
      I ≤ Ideal.comap
        (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := B)).toRingHom J :=
  Ideal.map_le_iff_le_comap

/-- The construction `I ↦ I ⊗ B` is monotone. -/
theorem leftTensorIdeal_mono {I J : Ideal A} (hIJ : I ≤ J) :
    leftTensorIdeal R B I ≤ leftTensorIdeal R B J :=
  Ideal.map_mono hIJ

/-- The construction `I ↦ I ⊗ B` distributes over arbitrary suprema of ideals. -/
@[simp]
theorem leftTensorIdeal_iSup {ι : Sort*} (I : ι → Ideal A) :
    leftTensorIdeal R B (⨆ i, I i) = ⨆ i, leftTensorIdeal R B (I i) :=
  Ideal.map_iSup
    (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := B)).toRingHom I

/-- The construction `I ↦ I ⊗ B` distributes over joins of ideals. -/
@[simp]
theorem leftTensorIdeal_sup (I J : Ideal A) :
    leftTensorIdeal R B (I ⊔ J) = leftTensorIdeal R B I ⊔ leftTensorIdeal R B J :=
  Ideal.map_sup
    (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := B)).toRingHom I J

end Left

section Right

variable (R : Type u) (A : Type v) {B : Type w}
variable [CommSemiring R] [Semiring A] [Semiring B] [Algebra R A] [Algebra R B]

/-- The ideal of `A ⊗[R] B` generated by the right inclusion of `I`, representing `A ⊗ I`. -/
def rightTensorIdeal (I : Ideal B) : Ideal (A ⊗[R] B) :=
  Ideal.map (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom I

theorem rightTensorIdeal_def (I : Ideal B) :
    rightTensorIdeal R A I =
      Ideal.map (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom I :=
  (rfl)

/-- The right tensor inclusion sends elements of `I` into `A ⊗ I`. -/
theorem includeRight_mem_rightTensorIdeal {I : Ideal B} {x : B} (hx : x ∈ I) :
    Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B) x ∈
      rightTensorIdeal R A I :=
  Ideal.mem_map_of_mem _ hx

/-- A pure tensor `x ⊗ₜ y` with `y ∈ I` lies in `A ⊗ I`. -/
theorem tmul_mem_rightTensorIdeal {I : Ideal B} (x : A) {y : B} (hy : y ∈ I) :
    x ⊗ₜ[R] y ∈ rightTensorIdeal R A I := by
  have h : x ⊗ₜ[R] y =
      Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := B) x *
        Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B) y := by
    rw [Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.includeRight_apply,
      Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  rw [h]
  exact Ideal.mul_mem_left _ _ (includeRight_mem_rightTensorIdeal R A hy)

theorem mem_rightTensorIdeal {I : Ideal B} {x : A ⊗[R] B} :
    x ∈ rightTensorIdeal R A I ↔
      x ∈ Ideal.map
        (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom I :=
  Iff.rfl

/-- The order universal property for `A ⊗ I`. -/
theorem rightTensorIdeal_le_iff {I : Ideal B} {J : Ideal (A ⊗[R] B)} :
    rightTensorIdeal R A I ≤ J ↔
      I ≤ Ideal.comap
        (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom J :=
  Ideal.map_le_iff_le_comap

/-- The construction `I ↦ A ⊗ I` is monotone. -/
theorem rightTensorIdeal_mono {I J : Ideal B} (hIJ : I ≤ J) :
    rightTensorIdeal R A I ≤ rightTensorIdeal R A J :=
  Ideal.map_mono hIJ

/-- The construction `I ↦ A ⊗ I` distributes over arbitrary suprema of ideals. -/
@[simp]
theorem rightTensorIdeal_iSup {ι : Sort*} (I : ι → Ideal B) :
    rightTensorIdeal R A (⨆ i, I i) = ⨆ i, rightTensorIdeal R A (I i) :=
  Ideal.map_iSup
    (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom I

/-- The construction `I ↦ A ⊗ I` distributes over joins of ideals. -/
@[simp]
theorem rightTensorIdeal_sup (I J : Ideal B) :
    rightTensorIdeal R A (I ⊔ J) = rightTensorIdeal R A I ⊔ rightTensorIdeal R A J :=
  Ideal.map_sup
    (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom I J

end Right

section Quotient

variable {R A B : Type*} [CommRing R] [Ring A] [Ring B] [Algebra R A] [Algebra R B]

/-- The kernel of tensoring the quotient map on the right is the right tensor ideal. -/
theorem ker_tensorProduct_map_id_quotient (I : Ideal B) [I.IsTwoSided] :
    RingHom.ker (Algebra.TensorProduct.map (AlgHom.id R A) (Ideal.Quotient.mkₐ R I)) =
      rightTensorIdeal R A I := by
  simpa only [rightTensorIdeal_def, AlgHom.coe_ideal_map, AlgHom.toRingHom_eq_coe,
    AlgHom.ker_coe, Ideal.Quotient.mkₐ_ker] using
    Algebra.TensorProduct.lTensor_ker (A := A) (Ideal.Quotient.mkₐ R I)
      (Ideal.Quotient.mkₐ_surjective R I)

/-- The kernel of tensoring the quotient map on the left is the left tensor ideal. -/
theorem ker_tensorProduct_map_quotient_id (I : Ideal A) [I.IsTwoSided] :
    RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ R I) (AlgHom.id R B)) =
      leftTensorIdeal R B I := by
  simpa only [leftTensorIdeal_def, AlgHom.coe_ideal_map, AlgHom.toRingHom_eq_coe,
    AlgHom.ker_coe, Ideal.Quotient.mkₐ_ker] using
    Algebra.TensorProduct.rTensor_ker (C := B) (Ideal.Quotient.mkₐ R I)
      (Ideal.Quotient.mkₐ_surjective R I)

end Quotient

end Ideal

namespace AlgHom

section Semiring

variable {R A B C D : Type*} [CommSemiring R]
variable [Semiring A] [Semiring B] [Semiring C] [Semiring D]
variable [Algebra R A] [Algebra R B] [Algebra R C] [Algebra R D]

/-- A tensor-product map carries the left tensor ideal generated by `I` onto the left tensor
ideal generated by its image in the left codomain factor. -/
@[simp] theorem map_tensor_leftTensorIdeal (f : A →ₐ[R] C) (g : B →ₐ[R] D) (I : Ideal A) :
    Ideal.map (Algebra.TensorProduct.map f g : (A ⊗[R] B) →+* (C ⊗[R] D))
      (Ideal.leftTensorIdeal R B I) =
      Ideal.leftTensorIdeal R D (Ideal.map f.toRingHom I) := by
  rw [Ideal.leftTensorIdeal_def, Ideal.leftTensorIdeal_def, Ideal.map_map, Ideal.map_map]
  congr 1
  ext x
  exact DFunLike.congr_fun (Algebra.TensorProduct.map_comp_includeLeft f g) x

/-- A tensor-product map carries the right tensor ideal generated by `I` onto the right tensor
ideal generated by its image in the right codomain factor. -/
@[simp] theorem map_tensor_rightTensorIdeal (f : A →ₐ[R] C) (g : B →ₐ[R] D) (I : Ideal B) :
    Ideal.map (Algebra.TensorProduct.map f g : (A ⊗[R] B) →+* (C ⊗[R] D))
      (Ideal.rightTensorIdeal R A I) =
      Ideal.rightTensorIdeal R C (Ideal.map g.toRingHom I) := by
  rw [Ideal.rightTensorIdeal_def, Ideal.rightTensorIdeal_def, Ideal.map_map, Ideal.map_map]
  congr 1
  ext x
  exact DFunLike.congr_fun (Algebra.TensorProduct.map_comp_includeRight f g) x

end Semiring

section Ring

variable {R A B C D : Type*} [CommRing R]
variable [Ring A] [Ring B] [Ring C] [Ring D]
variable [Algebra R A] [Algebra R B] [Algebra R C] [Algebra R D]

/-- The kernel of a tensor product of two surjective algebra maps is the sum of the tensor
ideals generated by their kernels. -/
theorem ker_tensorProduct_map_eq_leftTensorIdeal_sup_rightTensorIdeal
    (f : A →ₐ[R] C) (g : B →ₐ[R] D)
    (hf : Function.Surjective f) (hg : Function.Surjective g) :
    RingHom.ker (Algebra.TensorProduct.map f g) =
      Ideal.leftTensorIdeal R B (RingHom.ker f) ⊔
        Ideal.rightTensorIdeal R A (RingHom.ker g) := by
  simpa only [Ideal.leftTensorIdeal_def, Ideal.rightTensorIdeal_def, AlgHom.coe_ideal_map,
    AlgHom.toRingHom_eq_coe] using Algebra.TensorProduct.map_ker f g hf hg

end Ring

end AlgHom
