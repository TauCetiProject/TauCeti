namespace FormalVertexAxioms

variable {R V W U : Type*} [CommRing R]
  [AddCommGroup V] [Module R V] [AddCommGroup W] [Module R W] [AddCommGroup U] [Module R U]

/-- A vertex subalgebra of a formal vertex algebra `A` on `V`: a submodule containing the vacuum
and closed under every mode, `a₍ₙ₎ b ∈ S` for `a, b ∈ S`. -/
structure VertexSubalgebra (A : FormalVertexAxioms R V) extends Submodule R V where
  /-- A vertex subalgebra contains the vacuum. -/
  vacuum_mem' : A.vacuum ∈ carrier
  /-- A vertex subalgebra is closed under every mode. -/
  ncoeff_field_apply_mem' : ∀ {a b : V} (n : ℤ), a ∈ carrier → b ∈ carrier →
    ((A.field a)[[n]]) b ∈ carrier

/-- The span of the vacuum is closed under all modes, since `|0⟩₍ₙ₎ = δ_{n,-1}`. -/
theorem ncoeff_field_apply_mem_span_vacuum (A : FormalVertexAxioms R V) {a b : V} (n : ℤ)
    (ha : a ∈ R ∙ A.vacuum) (hb : b ∈ R ∙ A.vacuum) : ((A.field a)[[n]]) b ∈ R ∙ A.vacuum := by
  obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.1 ha
  obtain ⟨s, rfl⟩ := Submodule.mem_span_singleton.1 hb
  by_cases hn : n = -1
  · subst hn
    simpa [smul_smul] using Submodule.smul_mem _ (s * r) (Submodule.mem_span_singleton_self _)
  · simp [A.ncoeff_field_vacuum_of_ne hn]

namespace VertexSubalgebra

variable {A : FormalVertexAxioms R V} {B : FormalVertexAxioms R W} {C : FormalVertexAxioms R U}

theorem toSubmodule_injective :
    Function.Injective (toSubmodule : A.VertexSubalgebra → Submodule R V) := by
  rintro ⟨p, -, -⟩ ⟨q, -, -⟩ rfl
  rfl

instance : SetLike A.VertexSubalgebra V where
  coe S := S.carrier
  coe_injective _ _ h := toSubmodule_injective (SetLike.coe_injective h)

instance : PartialOrder A.VertexSubalgebra := .ofSetLike A.VertexSubalgebra

instance : AddSubgroupClass A.VertexSubalgebra V where
  add_mem {S} := S.toSubmodule.add_mem
  zero_mem S := S.toSubmodule.zero_mem
  neg_mem {S} _ := S.toSubmodule.neg_mem

instance : SMulMemClass A.VertexSubalgebra R V where
  smul_mem {S} r _ := S.toSubmodule.smul_mem r

@[simp]
theorem mem_toSubmodule {S : A.VertexSubalgebra} {v : V} : v ∈ S.toSubmodule ↔ v ∈ S :=
  Iff.rfl

@[simp]
theorem mem_mk {p : Submodule R V} (h₁ h₂) {v : V} :
    v ∈ (⟨p, h₁, h₂⟩ : A.VertexSubalgebra) ↔ v ∈ p :=
  Iff.rfl

@[simp]
theorem coe_toSubmodule (S : A.VertexSubalgebra) : (S.toSubmodule : Set V) = S := (rfl)

theorem toSubmodule_inj {S T : A.VertexSubalgebra} : S.toSubmodule = T.toSubmodule ↔ S = T :=
  toSubmodule_injective.eq_iff

@[simp]
theorem toSubmodule_le_toSubmodule {S T : A.VertexSubalgebra} :
    S.toSubmodule ≤ T.toSubmodule ↔ S ≤ T :=
  Iff.rfl

@[ext]
theorem ext {S T : A.VertexSubalgebra} (h : ∀ v, v ∈ S ↔ v ∈ T) : S = T :=
  SetLike.ext h

/-- A vertex subalgebra contains the vacuum. -/
@[simp]
theorem vacuum_mem (S : A.VertexSubalgebra) : A.vacuum ∈ S :=
  S.vacuum_mem'

/-- A vertex subalgebra is closed under every mode. -/
theorem ncoeff_field_apply_mem (S : A.VertexSubalgebra) {a b : V} (n : ℤ) (ha : a ∈ S)
    (hb : b ∈ S) : ((A.field a)[[n]]) b ∈ S :=
  S.ncoeff_field_apply_mem' n ha hb

/-- A vertex subalgebra is stable under translation, since `T a = a₍₋₂₎|0⟩`. -/
theorem translation_mem (S : A.VertexSubalgebra) {a : V} (ha : a ∈ S) : A.translation a ∈ S := by
  rw [A.translation_apply]
  exact S.ncoeff_field_apply_mem _ ha S.vacuum_mem

/-! ### The induced formal vertex algebra -/

/-- A vertex subalgebra is a formal vertex algebra, with the restricted fields, vacuum and
translation. -/
def formalVertexAxioms (S : A.VertexSubalgebra) : FormalVertexAxioms R S where
  field :=
    { toFun a := (A.field a).restrict (p := S) fun n _ hv ↦
        S.ncoeff_field_apply_mem n a.property hv
      map_add' a b := ext_ncoeff fun n ↦ LinearMap.ext fun v ↦ Subtype.ext <| by
        simp
      map_smul' r a := ext_ncoeff fun n ↦ LinearMap.ext fun v ↦ Subtype.ext <| by
        simp }
  vacuum := ⟨A.vacuum, S.vacuum_mem⟩
  translation :=
    { toFun a := ⟨A.translation a, S.translation_mem a.property⟩
      map_add' _ _ := Subtype.ext (map_add _ _ _)
      map_smul' _ _ := Subtype.ext (map_smul _ _ _) }
  translation_vacuum := Subtype.ext A.translation_vacuum
  ncoeff_field_vacuum n := by
    ext v
    simp only [LinearMap.coe_mk, AddHom.coe_mk, coe_ncoeff_restrict_apply, A.ncoeff_field_vacuum]
    split_ifs <;> simp
  ncoeff_field_apply_vacuum_of_nonneg a n hn := Subtype.ext <| by
    simp [hn]
  ncoeff_neg_one_field_apply_vacuum a := Subtype.ext <| by
    simp
  field_translation a := ext_ncoeff fun n ↦ LinearMap.ext fun v ↦ Subtype.ext <| by
    simp
  lie_translation_ncoeff a n := LinearMap.ext fun v ↦ Subtype.ext <| by
    have h := LinearMap.congr_fun (A.lie_translation_ncoeff a n) v
    simp only [Ring.lie_def, LinearMap.sub_apply, mul_apply_eq_comp] at h ⊢
    simpa using h
  exists_isLocalOfOrder a b := by
    obtain ⟨N, h⟩ := A.exists_isLocalOfOrder a b
    exact ⟨N, h.restrict _ _⟩

/-- The induced field of a state is the restriction of its field in `A`. -/
theorem formalVertexAxioms_field_apply (S : A.VertexSubalgebra) (a : S) :
    S.formalVertexAxioms.field a =
      (A.field a).restrict (p := S) fun n _ hv ↦ S.ncoeff_field_apply_mem n a.property hv :=
  (rfl)

/-- The modes of the induced fields are the modes of `A`. -/
@[simp]
theorem coe_ncoeff_field_apply (S : A.VertexSubalgebra) (a b : S) (n : ℤ) :
    (((S.formalVertexAxioms.field a)[[n]]) b : V) = ((A.field a)[[n]]) b :=
  coe_ncoeff_restrict_apply ..

@[simp]
theorem coe_vacuum (S : A.VertexSubalgebra) : (S.formalVertexAxioms.vacuum : V) = A.vacuum :=
  (rfl)

@[simp]
theorem coe_translation_apply (S : A.VertexSubalgebra) (a : S) :
    (S.formalVertexAxioms.translation a : V) = A.translation a :=
  (rfl)

/-- The inclusion of a vertex subalgebra, as a morphism of formal vertex algebras. -/
def subtype (S : A.VertexSubalgebra) : S.formalVertexAxioms.Hom A where
  toLinearMap := S.toSubmodule.subtype
  map_vacuum' := (rfl)
  map_ncoeff_field_apply' a b n := S.coe_ncoeff_field_apply a b n

@[simp]
theorem coe_subtype (S : A.VertexSubalgebra) : ⇑S.subtype = Subtype.val := (rfl)

@[simp]
theorem toLinearMap_subtype (S : A.VertexSubalgebra) :
    S.subtype.toLinearMap = S.toSubmodule.subtype := (rfl)

theorem subtype_injective (S : A.VertexSubalgebra) : Function.Injective S.subtype :=
  Subtype.val_injective

/-! ### The complete lattice of vertex subalgebras -/

instance : Top A.VertexSubalgebra :=
  ⟨{ (⊤ : Submodule R V) with
    vacuum_mem' := trivial
    ncoeff_field_apply_mem' := fun _ _ _ ↦ trivial }⟩

/-- The smallest vertex subalgebra: the span of the vacuum. -/
instance : Bot A.VertexSubalgebra :=
  ⟨{ (R ∙ A.vacuum) with
    vacuum_mem' := Submodule.mem_span_singleton_self A.vacuum
    ncoeff_field_apply_mem' := A.ncoeff_field_apply_mem_span_vacuum }⟩

instance : Min A.VertexSubalgebra :=
  ⟨fun S T ↦
    { S.toSubmodule ⊓ T.toSubmodule with
      vacuum_mem' := ⟨S.vacuum_mem, T.vacuum_mem⟩
      ncoeff_field_apply_mem' := fun n ha hb ↦
        ⟨S.ncoeff_field_apply_mem n ha.1 hb.1, T.ncoeff_field_apply_mem n ha.2 hb.2⟩ }⟩

instance : InfSet A.VertexSubalgebra :=
  ⟨fun s ↦
    { sInf (toSubmodule '' s) with
      vacuum_mem' := by
        simp
      ncoeff_field_apply_mem' := fun n ha hb ↦ Submodule.mem_sInf.2 <| Set.forall_mem_image.2
        fun S hS ↦ S.ncoeff_field_apply_mem n (Submodule.mem_sInf.1 ha _ ⟨S, hS, rfl⟩)
          (Submodule.mem_sInf.1 hb _ ⟨S, hS, rfl⟩) }⟩

@[simp]
theorem mem_top (v : V) : v ∈ (⊤ : A.VertexSubalgebra) :=
  trivial

/-- The smallest vertex subalgebra is the span of the vacuum. -/
@[simp]
theorem mem_bot {v : V} : v ∈ (⊥ : A.VertexSubalgebra) ↔ v ∈ R ∙ A.vacuum :=
  Iff.rfl

@[simp]
theorem mem_inf {S T : A.VertexSubalgebra} {v : V} : v ∈ S ⊓ T ↔ v ∈ S ∧ v ∈ T :=
  Iff.rfl

@[simp]
theorem coe_top : ((⊤ : A.VertexSubalgebra) : Set V) = Set.univ :=
  (rfl)

@[simp]
theorem coe_bot : ((⊥ : A.VertexSubalgebra) : Set V) = (R ∙ A.vacuum : Submodule R V) :=
  (rfl)

@[simp]
theorem coe_inf (S T : A.VertexSubalgebra) :
    ((S ⊓ T : A.VertexSubalgebra) : Set V) = (S : Set V) ∩ T :=
  (rfl)

@[simp]
theorem top_toSubmodule : (⊤ : A.VertexSubalgebra).toSubmodule = ⊤ :=
  (rfl)

@[simp]
theorem bot_toSubmodule : (⊥ : A.VertexSubalgebra).toSubmodule = R ∙ A.vacuum :=
  (rfl)

@[simp]
theorem inf_toSubmodule (S T : A.VertexSubalgebra) :
    (S ⊓ T).toSubmodule = S.toSubmodule ⊓ T.toSubmodule :=
  (rfl)

@[simp]
theorem sInf_toSubmodule (s : Set A.VertexSubalgebra) :
    (sInf s).toSubmodule = sInf (toSubmodule '' s) :=
  (rfl)

@[simp]
theorem mem_sInf {s : Set A.VertexSubalgebra} {v : V} : v ∈ sInf s ↔ ∀ S ∈ s, v ∈ S := by
  rw [← mem_toSubmodule, sInf_toSubmodule]
  simp [Submodule.mem_sInf]

@[simp]
theorem coe_sInf (s : Set A.VertexSubalgebra) : ((sInf s : A.VertexSubalgebra) : Set V) =
    ⋂ S ∈ s, (S : Set V) := by
  ext v
  simp

instance : CompleteLattice A.VertexSubalgebra :=
  { completeLatticeOfInf A.VertexSubalgebra fun s ↦
      ⟨fun _ hS _ hv ↦ mem_sInf.1 hv _ hS, fun _ hT _ hv ↦ mem_sInf.2 fun _ hS ↦ hT hS hv⟩ with
    top := ⊤
    le_top := fun _ v _ ↦ mem_top v
    bot := ⊥
    bot_le := fun S v hv ↦ by
      obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.1 (mem_bot.1 hv)
      exact SMulMemClass.smul_mem r S.vacuum_mem
    inf := (· ⊓ ·)
    le_inf := fun _ _ _ hS hT _ hv ↦ ⟨hS hv, hT hv⟩
    inf_le_left := fun _ _ _ ↦ And.left
    inf_le_right := fun _ _ _ ↦ And.right }

@[simp]
theorem mem_iInf {ι : Sort*} {S : ι → A.VertexSubalgebra} {v : V} :
    v ∈ ⨅ i, S i ↔ ∀ i, v ∈ S i := by
  simp [iInf]

@[simp]
theorem coe_iInf {ι : Sort*} (S : ι → A.VertexSubalgebra) :
    ((⨅ i, S i : A.VertexSubalgebra) : Set V) = ⋂ i, (S i : Set V) := by
  ext v
  simp

@[simp]
theorem iInf_toSubmodule {ι : Sort*} (S : ι → A.VertexSubalgebra) :
    (⨅ i, S i).toSubmodule = ⨅ i, (S i).toSubmodule :=
  SetLike.coe_injective (by simp)

theorem eq_top_iff' (S : A.VertexSubalgebra) : S = ⊤ ↔ ∀ v, v ∈ S :=
  eq_top_iff.trans ⟨fun h v ↦ h (mem_top v), fun h v _ ↦ h v⟩

/-! ### Generated vertex subalgebras -/

variable (A) in
/-- The vertex subalgebra generated by a set of states: the smallest vertex subalgebra
containing it. -/
def adjoin (s : Set V) : A.VertexSubalgebra :=
  sInf {S | s ⊆ S}

@[simp]
theorem subset_adjoin (s : Set V) : s ⊆ adjoin A s :=
  fun _ hv ↦ mem_sInf.2 fun _ hS ↦ hS hv

theorem adjoin_le {s : Set V} {S : A.VertexSubalgebra} (h : s ⊆ S) : adjoin A s ≤ S :=
  sInf_le h

@[simp]
theorem adjoin_le_iff {s : Set V} {S : A.VertexSubalgebra} : adjoin A s ≤ S ↔ s ⊆ S :=
  ⟨fun h ↦ (subset_adjoin s).trans h, adjoin_le⟩

variable (A) in
/-- `adjoin A` is left adjoint to the inclusion of vertex subalgebras into sets of states. -/
theorem gc_adjoin : GaloisConnection (adjoin A) ((↑) : A.VertexSubalgebra → Set V) :=
  fun _ _ ↦ adjoin_le_iff

variable (A) in
/-- `adjoin A` is a Galois insertion: a vertex subalgebra is generated by its own states. -/
def gi : GaloisInsertion (adjoin A) ((↑) : A.VertexSubalgebra → Set V) :=
  (gc_adjoin A).toGaloisInsertion fun S ↦ subset_adjoin (S : Set V)

@[gcongr]
theorem adjoin_mono {s t : Set V} (h : s ⊆ t) : adjoin A s ≤ adjoin A t :=
  (gc_adjoin A).monotone_l h

@[simp]
theorem adjoin_empty : adjoin A ∅ = ⊥ :=
  (gc_adjoin A).l_bot

@[simp]
theorem adjoin_univ : adjoin A Set.univ = ⊤ :=
  (gi A).l_top

@[simp]
theorem adjoin_eq (S : A.VertexSubalgebra) : adjoin A S = S :=
  (gi A).l_u_eq S

theorem adjoin_union (s t : Set V) : adjoin A (s ∪ t) = adjoin A s ⊔ adjoin A t :=
  (gc_adjoin A).l_sup

theorem adjoin_iUnion {ι : Sort*} (s : ι → Set V) : adjoin A (⋃ i, s i) = ⨆ i, adjoin A (s i) :=
  (gc_adjoin A).l_iSup

theorem sup_eq_adjoin (S T : A.VertexSubalgebra) : S ⊔ T = adjoin A ((S : Set V) ∪ T) :=
  ((gi A).l_sup_u S T).symm

/-- An induction principle for the vertex subalgebra generated by `s`: a property of its states
holds everywhere if it holds on `s` and on the vacuum, and is preserved by sums, scalar multiples
and all modes. -/
@[elab_as_elim]
theorem adjoin_induction {s : Set V} {p : (v : V) → v ∈ adjoin A s → Prop}
    (mem : ∀ v (hv : v ∈ s), p v (subset_adjoin s hv))
    (vacuum : p A.vacuum (adjoin A s).vacuum_mem)
    (add : ∀ v w hv hw, p v hv → p w hw → p (v + w) (add_mem hv hw))
    (smul : ∀ (r : R) v hv, p v hv → p (r • v) (SMulMemClass.smul_mem r hv))
    (ncoeff : ∀ (n : ℤ) a b ha hb, p a ha → p b hb →
      p (((A.field a)[[n]]) b) ((adjoin A s).ncoeff_field_apply_mem n ha hb))
    {v : V} (hv : v ∈ adjoin A s) : p v hv := by
  let T : A.VertexSubalgebra :=
    { carrier := {v | ∃ hv, p v hv}
      add_mem' := fun ⟨_, hv⟩ ⟨_, hw⟩ ↦ ⟨_, add _ _ _ _ hv hw⟩
      zero_mem' := by
        have h := smul 0 _ _ vacuum
        simp only [zero_smul] at h
        exact ⟨_, h⟩
      smul_mem' := fun r _ ⟨_, hv⟩ ↦ ⟨_, smul r _ _ hv⟩
      vacuum_mem' := ⟨_, vacuum⟩
      ncoeff_field_apply_mem' := fun n ⟨_, ha⟩ ⟨_, hb⟩ ↦ ⟨_, ncoeff n _ _ _ _ ha hb⟩ }
  obtain ⟨_, h⟩ := adjoin_le (S := T) (fun v hv ↦ ⟨_, mem v hv⟩) hv
  exact h

/-! ### Images and preimages -/

/-- The preimage of a vertex subalgebra under a morphism. -/
def comap (f : A.Hom B) (S : B.VertexSubalgebra) : A.VertexSubalgebra where
  toSubmodule := S.toSubmodule.comap (f : V →ₗ[R] W)
  vacuum_mem' := by
    simp
  ncoeff_field_apply_mem' n ha hb := by
    simpa using S.ncoeff_field_apply_mem n ha hb

@[simp]
theorem mem_comap {f : A.Hom B} {S : B.VertexSubalgebra} {v : V} : v ∈ S.comap f ↔ f v ∈ S :=
  Iff.rfl

@[simp]
theorem coe_comap (f : A.Hom B) (S : B.VertexSubalgebra) :
    (S.comap f : Set V) = f ⁻¹' (S : Set W) :=
  (rfl)

@[simp]
theorem comap_id (S : A.VertexSubalgebra) : S.comap (Hom.id A) = S := by
  ext
  simp

theorem comap_comap (g : B.Hom C) (f : A.Hom B) (S : C.VertexSubalgebra) :
    (S.comap g).comap f = S.comap (g.comp f) := by
  ext
  simp

@[gcongr]
theorem comap_mono {f : A.Hom B} {S T : B.VertexSubalgebra} (h : S ≤ T) : S.comap f ≤ T.comap f :=
  fun _ hv ↦ h hv

/-- The image of a vertex subalgebra under a morphism. -/
def map (f : A.Hom B) (S : A.VertexSubalgebra) : B.VertexSubalgebra where
  toSubmodule := S.toSubmodule.map (f : V →ₗ[R] W)
  vacuum_mem' := ⟨A.vacuum, S.vacuum_mem, f.map_vacuum⟩
  ncoeff_field_apply_mem' := by
    rintro _ _ n ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
    exact ⟨_, S.ncoeff_field_apply_mem n ha hb, f.map_ncoeff_field_apply a b n⟩

@[simp]
theorem mem_map {f : A.Hom B} {S : A.VertexSubalgebra} {w : W} :
    w ∈ S.map f ↔ ∃ v ∈ S, f v = w :=
  Iff.rfl

@[simp]
theorem coe_map (f : A.Hom B) (S : A.VertexSubalgebra) : (S.map f : Set W) = f '' S :=
  (rfl)

@[simp]
theorem map_id (S : A.VertexSubalgebra) : S.map (Hom.id A) = S := by
  ext
  simp

@[gcongr]
theorem map_mono {f : A.Hom B} {S T : A.VertexSubalgebra} (h : S ≤ T) : S.map f ≤ T.map f :=
  Set.image_mono h

theorem map_le_iff_le_comap {f : A.Hom B} {S : A.VertexSubalgebra} {T : B.VertexSubalgebra} :
    S.map f ≤ T ↔ S ≤ T.comap f :=
  Set.image_subset_iff

theorem gc_map_comap (f : A.Hom B) : GaloisConnection (map f) (comap f) :=
  fun _ _ ↦ map_le_iff_le_comap

@[simp]
theorem map_bot (f : A.Hom B) : (⊥ : A.VertexSubalgebra).map f = ⊥ :=
  (gc_map_comap f).l_bot

@[simp]
theorem comap_top (f : A.Hom B) : (⊤ : B.VertexSubalgebra).comap f = ⊤ :=
  (gc_map_comap f).u_top

theorem map_map (g : B.Hom C) (f : A.Hom B) (S : A.VertexSubalgebra) :
    (S.map f).map g = S.map (g.comp f) := by
  ext
  simp

/-- The image of the vertex subalgebra generated by `s` is generated by the image of `s`. -/
theorem map_adjoin (f : A.Hom B) (s : Set V) : (adjoin A s).map f = adjoin B (f '' s) :=
  Set.image_preimage.l_comm_of_u_comm (gc_map_comap f) (gc_adjoin B) (gc_adjoin A) fun _ ↦ rfl

end VertexSubalgebra

open VertexSubalgebra

namespace Hom

variable {A : FormalVertexAxioms R V} {B : FormalVertexAxioms R W}

/-- The range of a morphism, as a vertex subalgebra of its target. -/
def range (f : A.Hom B) : B.VertexSubalgebra :=
  (⊤ : A.VertexSubalgebra).map f

@[simp]
theorem mem_range {f : A.Hom B} {w : W} : w ∈ f.range ↔ ∃ v, f v = w := by
  simp [range]

theorem map_top (f : A.Hom B) : (⊤ : A.VertexSubalgebra).map f = f.range :=
  (rfl)

@[simp]
theorem coe_range (f : A.Hom B) : (f.range : Set W) = Set.range f := by
  ext
  simp

theorem mem_range_self (f : A.Hom B) (v : V) : f v ∈ f.range :=
  mem_range.2 ⟨v, rfl⟩

theorem range_eq_top {f : A.Hom B} : f.range = ⊤ ↔ Function.Surjective f := by
  simp [eq_top_iff', Function.Surjective]

@[simp]
theorem range_id : (Hom.id A).range = ⊤ :=
  range_eq_top.2 fun v ↦ ⟨v, id_apply A v⟩

theorem range_comp {C : FormalVertexAxioms R U} (g : B.Hom C) (f : A.Hom B) :
    (g.comp f).range = f.range.map g := by
  ext
  simp

/-- The states on which two morphisms agree, as a vertex subalgebra. -/
def eqLocus (f g : A.Hom B) : A.VertexSubalgebra where
  toSubmodule := LinearMap.eqLocus (f : V →ₗ[R] W) g
  vacuum_mem' := by
    simp [LinearMap.mem_eqLocus]
  ncoeff_field_apply_mem' n ha hb := by
    simp_all [LinearMap.mem_eqLocus]

@[simp]
theorem mem_eqLocus {f g : A.Hom B} {v : V} : v ∈ f.eqLocus g ↔ f v = g v :=
  Iff.rfl

theorem le_eqLocus {f g : A.Hom B} {S : A.VertexSubalgebra} :
    S ≤ f.eqLocus g ↔ Set.EqOn f g S :=
  Iff.rfl

theorem eqLocus_eq_top {f g : A.Hom B} : f.eqLocus g = ⊤ ↔ f = g := by
  simp [eq_top_iff', Hom.ext_iff]

@[simp]
theorem eqLocus_self (f : A.Hom B) : f.eqLocus f = ⊤ :=
  eqLocus_eq_top.2 rfl

/-- Two morphisms that agree on a set of states agree on the vertex subalgebra it generates. -/
theorem eqOn_adjoin {f g : A.Hom B} {s : Set V} (h : Set.EqOn f g s) :
    Set.EqOn f g (adjoin A s) :=
  fun _ hv ↦ adjoin_le (S := f.eqLocus g) h hv

/-- Two morphisms that agree on a generating set are equal. -/
theorem ext_of_adjoin_eq_top {f g : A.Hom B} {s : Set V} (hs : adjoin A s = ⊤)
    (h : Set.EqOn f g s) : f = g :=
  ext fun v ↦ eqOn_adjoin h (hs ▸ mem_top v)

section OfAdjoin

variable [HasUniqueDiv V] [HasUniqueDiv W]

/-- For a linear map `f` preserving the vacuum, the states `a` whose modes `f` carries to the modes
of `f a`, `f ∘ a₍ₙ₎ = (f a)₍ₙ₎ ∘ f`, form a vertex subalgebra: the fields of products are `n`-th
products of fields, which are natural for such maps. -/
private def intertwiningSubalgebra (f : V →ₗ[R] W) (hvac : f A.vacuum = B.vacuum) :
    A.VertexSubalgebra where
  carrier := {a | ∀ n : ℤ, f ∘ₗ (A.field a)[[n]] = (B.field (f a))[[n]] ∘ₗ f}
  add_mem' {a b} ha hb n := by
    simp only [map_add, Pi.add_apply, LinearMap.comp_add, LinearMap.add_comp,
      ha n, hb n]
  zero_mem' n := by simp
  smul_mem' r a ha n := by
    simp only [map_smul, Pi.smul_apply, LinearMap.comp_smul, LinearMap.smul_comp,
      ha n]
  vacuum_mem' n := by
    simp only [hvac, field_vacuum, ncoeff_idField]
    split_ifs <;> simp [Module.End.one_eq_id]
  ncoeff_field_apply_mem' {a b} n ha hb m := by
    have hab : f (((A.field a)[[n]]) b) = ((B.field (f a))[[n]]) (f b) :=
      LinearMap.congr_fun (ha n) b
    rw [A.field_ncoeff_apply, hab, B.field_ncoeff_apply]
    exact comp_ncoeff_nthProduct f ha hb n m

/-- **Morphisms out of a generated formal vertex algebra.** If the states `s` generate `A`, a linear
map `f` which preserves the vacuum and carries the modes of every `a ∈ s` to those of `f a`,
`f (a₍ₙ₎ b) = (f a)₍ₙ₎ (f b)`, is a morphism. -/
def ofAdjoinEqTop (f : V →ₗ[R] W) {s : Set V} (hs : adjoin A s = ⊤)
    (hvac : f A.vacuum = B.vacuum)
    (hf : ∀ a ∈ s, ∀ (n : ℤ) (b : V), f (((A.field a)[[n]]) b) = ((B.field (f a))[[n]]) (f b)) :
    A.Hom B where
  toLinearMap := f
  map_vacuum' := hvac
  map_ncoeff_field_apply' a b n := by
    have ha : a ∈ intertwiningSubalgebra f hvac :=
      adjoin_le (S := intertwiningSubalgebra f hvac) (fun a ha n ↦ LinearMap.ext (hf a ha n))
        (hs ▸ mem_top a)
    exact LinearMap.congr_fun (ha n) b

@[simp]
theorem coe_ofAdjoinEqTop (f : V →ₗ[R] W) {s : Set V} (hs : adjoin A s = ⊤)
    (hvac : f A.vacuum = B.vacuum)
    (hf : ∀ a ∈ s, ∀ (n : ℤ) (b : V), f (((A.field a)[[n]]) b) = ((B.field (f a))[[n]]) (f b)) :
    ⇑(ofAdjoinEqTop f hs hvac hf) = f :=
  (rfl)

end OfAdjoin

/-- A morphism whose values lie in a vertex subalgebra, as a morphism into it. -/
def codRestrict (f : A.Hom B) (S : B.VertexSubalgebra) (hf : ∀ v, f v ∈ S) :
    A.Hom S.formalVertexAxioms where
  toFun v := ⟨f v, hf v⟩
  map_add' _ _ := Subtype.ext (map_add f _ _)
  map_smul' _ _ := Subtype.ext (map_smul f _ _)
  map_vacuum' := Subtype.ext f.map_vacuum
  map_ncoeff_field_apply' a b n := Subtype.ext <| by
    simp

@[simp]
theorem coe_codRestrict_apply (f : A.Hom B) (S : B.VertexSubalgebra) (hf : ∀ v, f v ∈ S)
    (v : V) : (f.codRestrict S hf v : W) = f v :=
  (rfl)

@[simp]
theorem subtype_comp_codRestrict (f : A.Hom B) (S : B.VertexSubalgebra) (hf : ∀ v, f v ∈ S) :
    S.subtype.comp (f.codRestrict S hf) = f := by
  ext
  simp

@[simp]
theorem injective_codRestrict {f : A.Hom B} {S : B.VertexSubalgebra} (hf : ∀ v, f v ∈ S) :
    Function.Injective (f.codRestrict S hf) ↔ Function.Injective f :=
  Set.injective_codRestrict hf

/-- A morphism, as a surjective morphism onto its range. -/
def rangeRestrict (f : A.Hom B) : A.Hom f.range.formalVertexAxioms :=
  f.codRestrict f.range fun v ↦ mem_range.2 ⟨v, rfl⟩

@[simp]
theorem coe_rangeRestrict_apply (f : A.Hom B) (v : V) : (f.rangeRestrict v : W) = f v :=
  (rfl)

@[simp]
theorem subtype_comp_rangeRestrict (f : A.Hom B) : f.range.subtype.comp f.rangeRestrict = f :=
  subtype_comp_codRestrict ..

theorem rangeRestrict_surjective (f : A.Hom B) : Function.Surjective f.rangeRestrict := by
  rintro ⟨w, hw⟩
  obtain ⟨v, rfl⟩ := mem_range.1 hw
  exact ⟨v, rfl⟩

/-- An injective morphism is a bijection onto its range. -/
theorem rangeRestrict_bijective {f : A.Hom B} (hf : Function.Injective f) :
    Function.Bijective f.rangeRestrict :=
  ⟨fun _ _ h ↦ hf (congrArg Subtype.val h), f.rangeRestrict_surjective⟩

end Hom

namespace VertexSubalgebra

variable {A : FormalVertexAxioms R V}

@[simp]
theorem range_subtype (S : A.VertexSubalgebra) : S.subtype.range = S := by
  ext v
  simp

end VertexSubalgebra

namespace Equiv

variable {A : FormalVertexAxioms R V} {B : FormalVertexAxioms R W}

/-- An injective morphism identifies its source with its range. -/
def ofInjective (f : A.Hom B) (hf : Function.Injective f) : A.Equiv f.range.formalVertexAxioms :=
  ofBijective f.rangeRestrict (Hom.rangeRestrict_bijective hf)

@[simp]
theorem coe_ofInjective_apply (f : A.Hom B) (hf : Function.Injective f) (v : V) :
    (ofInjective f hf v : W) = f v := by
  simp [ofInjective]

@[simp]
theorem toHom_ofInjective (f : A.Hom B) (hf : Function.Injective f) :
    (ofInjective f hf).toHom = f.rangeRestrict :=
  toHom_ofBijective ..

@[simp]
theorem apply_ofInjective_symm (f : A.Hom B) (hf : Function.Injective f) (w : f.range) :
    f ((ofInjective f hf).symm w) = w := by
  rw [← coe_ofInjective_apply f hf, apply_symm_apply]

end Equiv

end FormalVertexAxioms

