/-!
# Free curved differential graded right modules over graded modules

Every graded right module `V` over a curved differential graded algebra `(A, d, w)` generates a
curved right module `freeObj h V`, Positselski's functor `G⁺` in the right-module convention.
Elements of `freeObj h V` represent formal expressions `u + d v` with `u, v ∈ V`: in degree `p`,
`u` has degree `p` and `v` has degree `p - 1`.

When `d ≠ 0`, the right `A`-action cannot be the untwisted product action: the right Leibniz rule
on `d v` forces
`op a • (u, v) = (op a • u - op (d a) • τ v, op a • v)`,
where `τ` is the degree-one Koszul twist of `V`, while the differential is `(u, v) ↦ (op w • v, u)`.
Associativity of the right action uses the graded Leibniz rule of `A`, and the curved module laws
use `d (d a) = a * w - w * a` together with `d w = 0`.

After forgetting the differential, `freeObj h V` sits in a canonical short exact sequence of
graded right modules
`0 ⟶ V ⟶ toGradedModuleCat (freeObj h V) ⟶ V{1} ⟶ 0`,
which need not split over `A` when `d ≠ 0` yet still transfers projectivity from `V` to
`toGradedModuleCat (freeObj h V)`. Meanwhile the map `(u, v) ↦ (v, 0)` is strictly right
`A`-linear of degree `-1` and contracts the identity of `freeObj h V`, so `freeObj h V` is always
zero in the curved homotopy category. Extending a graded morphism `V ⟶ toGradedModuleCat M` by
`(u, v) ↦ f u + d_M (f v)` gives the left adjoint `freeFunctor ⊣ forgetDifferential` and exhibits
every curved right module as a quotient of a contractible graded-projective curved right module.

## Main definitions

* `TauCeti.CurvedDGRightModuleCat.freeObj`: the curved right module freely generated by a graded
  right module.
* `TauCeti.CurvedDGRightModuleCat.freeι`, `TauCeti.CurvedDGRightModuleCat.freeUnit`,
  `TauCeti.CurvedDGRightModuleCat.freeProj`: the generator inclusion into `freeObj h V`, the unit
  morphism `V ⟶ toGradedModuleCat (freeObj h V)`, and the projection to `V{1}`.
* `TauCeti.CurvedDGRightModuleCat.freeDesc`, `TauCeti.CurvedDGRightModuleCat.freeHomEquiv`: the
  universal closed morphism out of `freeObj h V` and the resulting `R`-linear hom-equivalence.
* `TauCeti.CurvedDGRightModuleCat.freeFunctor`,
  `TauCeti.CurvedDGRightModuleCat.freeForgetDifferentialAdjunction`: the left adjoint to
  `forgetDifferential`.

## Main results

* `TauCeti.CurvedDGRightModuleCat.freeShortExact`: the short exact sequence
  `0 ⟶ V ⟶ toGradedModuleCat (freeObj h V) ⟶ V{1} ⟶ 0` of graded right modules.
* `TauCeti.CurvedDGRightModuleCat.isZero_homotopy_freeObj`: `freeObj h V` is contractible.
* `TauCeti.CurvedDGRightModuleCat.exists_epi_contractible_gradedProjective`: every curved right
  module is an epimorphic image of a contractible graded-projective curved right module.

## References

* L. Positselski, *Two kinds of derived categories, Koszul duality, and comodule-contramodule
  correspondence*, Mem. Amer. Math. Soc. **212** (2011), no. 996, Section 3.6.
* L. Positselski, *Differential graded Koszul duality: an introductory survey*, Bull. Lond. Math.
  Soc. **55** (2023), 1553–1640, Sections 6.2 and 7.6.
-/

public section

noncomputable section

open CategoryTheory CategoryTheory.Limits MulOpposite

namespace TauCeti.CurvedDGRightModuleCat

universe uR uA uM u

section Objects

variable {R : Type uR} {A : Type uA} [CommRing R] [Ring A] [Algebra R A]
  {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜] {d : A →ₗ[R] A} {w : A}

/-- Private pair carrier of the free curved right module on `V`, kept distinct from `V × V` so
its twisted right `A`-action does not collide with the product `Aᵐᵒᵖ`-module structure. -/
@[ext]
private structure FreeCarrier (h : IsCurvedDGAlgebra 𝒜 d w)
    (V : GradedModuleCat.{uM} (InternalGrading.ofDecomposition 𝒜).opposite.piece) where
  fst : V
  snd : V

section Carrier

variable (h : IsCurvedDGAlgebra 𝒜 d w)
  (V : GradedModuleCat.{uM} (InternalGrading.ofDecomposition 𝒜).opposite.piece)

private theorem koszulTwist_one_eq_negOnePow_smul {V : GradedModuleCat.{uM}
    (InternalGrading.ofDecomposition 𝒜).opposite.piece} {e : ℤ} {x : V}
    (hx : x ∈ V.grading.piece e) :
    V.grading.koszulTwist 1 x = e.negOnePow • x := by
  rw [V.grading.koszulTwist_one_apply_of_mem hx, Int.cast_smul_eq_zsmul, Units.smul_def]

private instance : Zero (FreeCarrier h V) := ⟨⟨0, 0⟩⟩
private instance : Add (FreeCarrier h V) := ⟨fun x y ↦ ⟨x.fst + y.fst, x.snd + y.snd⟩⟩
private instance : Neg (FreeCarrier h V) := ⟨fun x ↦ ⟨-x.fst, -x.snd⟩⟩
private instance : Sub (FreeCarrier h V) := ⟨fun x y ↦ ⟨x.fst - y.fst, x.snd - y.snd⟩⟩
private instance : SMul ℕ (FreeCarrier h V) := ⟨fun n x ↦ ⟨n • x.fst, n • x.snd⟩⟩
private instance : SMul ℤ (FreeCarrier h V) := ⟨fun n x ↦ ⟨n • x.fst, n • x.snd⟩⟩
private instance : SMul R (FreeCarrier h V) := ⟨fun r x ↦ ⟨r • x.fst, r • x.snd⟩⟩

private def freeToProd : FreeCarrier h V → V × V := fun x ↦ (x.fst, x.snd)

private theorem freeToProd_injective : Function.Injective (freeToProd h V) :=
  fun _ _ hxy ↦ FreeCarrier.ext (congrArg Prod.fst hxy) (congrArg Prod.snd hxy)

private instance : AddCommGroup (FreeCarrier h V) :=
  (freeToProd_injective h V).addCommGroup _ rfl (fun _ _ ↦ rfl) (fun _ ↦ rfl)
    (fun _ _ ↦ rfl) (fun _ _ ↦ rfl) (fun _ _ ↦ rfl)

private instance : Module R (FreeCarrier h V) :=
  Function.Injective.module R
    { toFun := freeToProd h V, map_zero' := rfl, map_add' := fun _ _ ↦ rfl }
    (freeToProd_injective h V) (fun _ _ ↦ rfl)

private def freeProdLinearEquiv : FreeCarrier h V ≃ₗ[R] V × V where
  toFun := freeToProd h V
  invFun x := ⟨x.1, x.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

private instance : SMul Aᵐᵒᵖ (FreeCarrier h V) where
  smul z x := ⟨z • x.fst - op (d z.unop) • V.grading.koszulTwist 1 x.snd, z • x.snd⟩

include h in
/-- The Leibniz identity on `d (b * a)` makes the twisted right `A`-action associative in its
first coordinate. -/
private theorem freeTwist_mul (a b : A) (v : V) :
    op (d (b * a)) • V.grading.koszulTwist 1 v =
      op a • (op (d b) • V.grading.koszulTwist 1 v) +
        op (d a) • V.grading.koszulTwist 1 (op b • v) := by
  induction b using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => simp
  | add b₁ b₂ hb₁ hb₂ =>
    rw [add_mul, map_add, MulOpposite.op_add, add_smul, hb₁, hb₂, map_add,
      MulOpposite.op_add, add_smul, smul_add, MulOpposite.op_add, add_smul, map_add, smul_add]
    abel
  | @homogeneous i b =>
    rcases b with ⟨b, hb⟩
    induction v using DirectSum.Decomposition.inductionOn V.grading.piece with
    | zero => simp
    | add v₁ v₂ hv₁ hv₂ =>
      rw [map_add, smul_add, hv₁, hv₂, smul_add, smul_add, smul_add, map_add, smul_add]
      abel
    | @homogeneous q v =>
      rcases v with ⟨v, hv⟩
      have hbv : op b • v ∈ V.grading.piece (q + i) := op_smul_mem_of_mem_graded hb hv
      rw [h.leibniz hb a, koszulTwist_one_eq_negOnePow_smul hv,
        koszulTwist_one_eq_negOnePow_smul hbv, MulOpposite.op_add, add_smul, op_mul, mul_smul]
      congr 1
      rw [Units.smul_def i.negOnePow, MulOpposite.op_smul, ← Units.smul_def, smul_assoc,
        smul_comm (op (b * d a)) q.negOnePow, smul_smul, ← Int.negOnePow_add, add_comm i q,
        op_mul, mul_smul, smul_comm]

private instance : Module Aᵐᵒᵖ (FreeCarrier h V) where
  one_smul x := by
    refine FreeCarrier.ext ?_ (one_smul Aᵐᵒᵖ x.snd)
    -- Unfold the twisted `Aᵐᵒᵖ`-action at `1` on the first coordinate.
    change (1 : Aᵐᵒᵖ) • x.fst - op (d (1 : A)) • V.grading.koszulTwist 1 x.snd = x.fst
    rw [one_smul, h.map_one_eq_zero, MulOpposite.op_zero, zero_smul, sub_zero]
  mul_smul z₁ z₂ x := by
    induction z₁ using MulOpposite.rec' with | h a =>
    induction z₂ using MulOpposite.rec' with | h b =>
    refine FreeCarrier.ext ?_ (mul_smul (op a) (op b) x.snd)
    -- Unfold the twisted `Aᵐᵒᵖ`-action on both sides to compare first coordinates in `V`.
    change op (b * a) • x.fst - op (d (b * a)) • V.grading.koszulTwist 1 x.snd =
      op a • (op b • x.fst - op (d b) • V.grading.koszulTwist 1 x.snd) -
        op (d a) • V.grading.koszulTwist 1 (op b • x.snd)
    rw [op_mul, mul_smul, smul_sub, freeTwist_mul h V a b x.snd, sub_add_eq_sub_sub]
  smul_zero z := by
    refine FreeCarrier.ext ?_ (smul_zero z)
    -- Unfold the twisted `Aᵐᵒᵖ`-action on `(0, 0)`.
    change z • (0 : V) - op (d z.unop) • V.grading.koszulTwist 1 (0 : V) = 0
    simp
  smul_add z x y := by
    refine FreeCarrier.ext ?_ (smul_add z x.snd y.snd)
    -- Unfold the twisted `Aᵐᵒᵖ`-action on a sum in `FreeCarrier`.
    change z • (x.fst + y.fst) - op (d z.unop) • V.grading.koszulTwist 1 (x.snd + y.snd) =
      (z • x.fst - op (d z.unop) • V.grading.koszulTwist 1 x.snd) +
        (z • y.fst - op (d z.unop) • V.grading.koszulTwist 1 y.snd)
    rw [map_add, smul_add, smul_add]
    abel
  add_smul z₁ z₂ x := by
    refine FreeCarrier.ext ?_ (add_smul z₁ z₂ x.snd)
    -- Unfold the twisted `Aᵐᵒᵖ`-action of `z₁ + z₂` on the first coordinate.
    change (z₁ + z₂) • x.fst - op (d (z₁ + z₂).unop) • V.grading.koszulTwist 1 x.snd =
      (z₁ • x.fst - op (d z₁.unop) • V.grading.koszulTwist 1 x.snd) +
        (z₂ • x.fst - op (d z₂.unop) • V.grading.koszulTwist 1 x.snd)
    rw [MulOpposite.unop_add, map_add, MulOpposite.op_add, add_smul, add_smul]
    abel
  zero_smul x := by
    refine FreeCarrier.ext ?_ (zero_smul Aᵐᵒᵖ x.snd)
    -- Unfold the twisted `Aᵐᵒᵖ`-action at `0` on the first coordinate.
    change (0 : Aᵐᵒᵖ) • x.fst - op (d (0 : Aᵐᵒᵖ).unop) • V.grading.koszulTwist 1 x.snd = 0
    simp

private instance : IsScalarTower R Aᵐᵒᵖ (FreeCarrier h V) where
  smul_assoc r z x := by
    refine FreeCarrier.ext ?_ (smul_assoc r z x.snd)
    -- Unfold the twisted `Aᵐᵒᵖ`-action and ground-ring scalar action on the first coordinate.
    change (r • z) • x.fst - op (d (r • z).unop) • V.grading.koszulTwist 1 x.snd =
      r • (z • x.fst - op (d z.unop) • V.grading.koszulTwist 1 x.snd)
    rw [unop_smul, d.map_smul, op_smul, smul_assoc, smul_assoc, smul_sub]

private def freeInternalGrading : InternalGrading R (FreeCarrier h V) ℤ :=
  (V.grading.prod (V.grading.shift (-1))).map (freeProdLinearEquiv h V).symm

private theorem mem_freeInternalGrading_piece_iff (p : ℤ) (x : FreeCarrier h V) :
    x ∈ (freeInternalGrading h V).piece p ↔
      x.fst ∈ V.grading.piece p ∧ x.snd ∈ V.grading.piece (p - 1) := by
  rw [freeInternalGrading, InternalGrading.mem_map_piece_iff, LinearEquiv.symm_symm,
    InternalGrading.prod_piece, Submodule.mem_prod, InternalGrading.shift_piece, sub_eq_add_neg]
  rfl

private instance :
    SetLike.GradedSMul (InternalGrading.ofDecomposition 𝒜).opposite.piece
      (freeInternalGrading h V).piece where
  smul_mem {i p z x} hz hx := by
    induction z using MulOpposite.rec' with | h a =>
    rw [InternalGrading.op_mem_opposite_piece_iff, InternalGrading.ofDecomposition_piece] at hz
    rw [mem_freeInternalGrading_piece_iff] at hx ⊢
    refine ⟨Submodule.sub_mem _ ?_ ?_, ?_⟩
    · simpa only [vadd_eq_add, add_comm i p] using op_smul_mem_of_mem_graded hz hx.1
    · have hda : d a ∈ 𝒜 (i + 1) := h.map_mem hz
      have hτ : V.grading.koszulTwist 1 x.snd ∈ V.grading.piece (p - 1) :=
        V.grading.koszulTwist_mem_piece hx.2 1
      have hsmul := op_smul_mem_of_mem_graded hda hτ
      have hdeg : p - 1 + (i + 1) = i + p := by omega
      rwa [vadd_eq_add, ← hdeg]
    · have hsmul := op_smul_mem_of_mem_graded hz hx.2
      have hdeg : p - 1 + i = (i + p) - 1 := by omega
      rwa [vadd_eq_add, ← hdeg]

private def freeDifferential : FreeCarrier h V →ₗ[R] FreeCarrier h V where
  toFun x := ⟨op w • x.snd, x.fst⟩
  map_add' x y := FreeCarrier.ext (smul_add (op w) x.snd y.snd) rfl
  map_smul' r x := FreeCarrier.ext (smul_comm (op w) r x.snd) rfl

private theorem isCurvedDGRightModule_freeCarrier :
    IsCurvedDGRightModule h (freeInternalGrading h V).piece (freeDifferential h V) where
  isHomogeneous := LinearMap.isHomogeneous_def.mpr fun p x hx ↦ by
    rw [mem_freeInternalGrading_piece_iff] at hx ⊢
    have hw : op w • x.snd ∈ V.grading.piece (p - 1 + 2) :=
      op_smul_mem_of_mem_graded h.curvature_mem hx.2
    have hdeg : p - 1 + 2 = p + 1 := by omega
    exact ⟨hdeg ▸ hw,
      by simpa only [freeDifferential, LinearMap.coe_mk, AddHom.coe_mk, add_sub_cancel_right]
        using hx.1⟩
  leibniz {p x} hx a := by
    rw [mem_freeInternalGrading_piece_iff] at hx
    have hsign : (p - 1).negOnePow = -p.negOnePow :=
      Int.negOnePow_eq_neg_of_odd_sub ⟨-1, by omega⟩
    have hc (X Y Z : V) : X - Y + (Y + Z) = X + Z := by abel
    refine FreeCarrier.ext ?_ ?_
    · -- Unfold `freeDifferential` and the twisted `Aᵐᵒᵖ`-action on the first coordinate.
      change op w • (op a • x.snd) =
        (op a • (op w • x.snd) - op (d a) • V.grading.koszulTwist 1 x.fst) +
          p.negOnePow • (op (d a) • x.fst - op (d (d a)) • V.grading.koszulTwist 1 x.snd)
      rw [koszulTwist_one_eq_negOnePow_smul hx.1, koszulTwist_one_eq_negOnePow_smul hx.2, hsign,
        Units.neg_smul, smul_neg, sub_neg_eq_add, smul_comm (op (d a)) p.negOnePow, smul_add,
        smul_comm (op (d (d a))) p.negOnePow, negOnePow_smul_negOnePow_smul,
        ← mul_smul, ← mul_smul, ← op_mul, ← op_mul, hc,
        ← add_smul, ← MulOpposite.op_add, h.sq_eq a, add_sub_cancel]
    · -- Unfold `freeDifferential` and the twisted `Aᵐᵒᵖ`-action on the second coordinate.
      change op a • x.fst - op (d a) • V.grading.koszulTwist 1 x.snd =
        op a • x.fst + p.negOnePow • (op (d a) • x.snd)
      rw [koszulTwist_one_eq_negOnePow_smul hx.2, hsign, Units.neg_smul, smul_neg,
        sub_neg_eq_add, smul_comm]
  sq_eq x := by
    refine FreeCarrier.ext ?_ rfl
    -- Unfold `freeDifferential ∘ freeDifferential` and `op w • x` on the first coordinate.
    change op w • x.fst = op w • x.fst - op (d w) • V.grading.koszulTwist 1 x.snd
    rw [h.map_curvature, MulOpposite.op_zero, zero_smul, sub_zero]

end Carrier

variable (h : IsCurvedDGAlgebra 𝒜 d w)
  (V : GradedModuleCat.{uM} (InternalGrading.ofDecomposition 𝒜).opposite.piece)

/-- The **free curved differential graded right module** generated by a graded right module `V`
(Positselski's functor `G⁺`). -/
def freeObj : CurvedDGRightModuleCat.{uR, uA, uM} h where
  carrier := FreeCarrier h V
  grading := (freeInternalGrading h V).piece
  differential := freeDifferential h V
  isCurvedDGRightModule := isCurvedDGRightModule_freeCarrier h V

/-- The right `A`-linear generator inclusion `V →ₗ[Aᵐᵒᵖ] freeObj h V`. -/
def freeι : V →ₗ[Aᵐᵒᵖ] freeObj h V where
  toFun v := (⟨v, 0⟩ : FreeCarrier h V)
  map_add' _ _ := FreeCarrier.ext rfl (add_zero 0).symm
  map_smul' z v := FreeCarrier.ext
    (by
      -- Unfold the twisted `Aᵐᵒᵖ`-action on `(v, 0)`.
      change z • v = z • v - op (d z.unop) • V.grading.koszulTwist 1 (0 : V)
      simp)
    (smul_zero z).symm

/-- The canonical graded right-linear unit inclusion `V ⟶ toGradedModuleCat (freeObj h V)`. -/
def freeUnit : V ⟶ toGradedModuleCat (freeObj h V) :=
  GradedModuleCat.ofHom (freeι h V)
    (LinearMap.isHomogeneous_def.mpr fun p v hv ↦ by
      rw [toGradedModuleCat_piece, add_zero]
      exact (mem_freeInternalGrading_piece_iff h V p ⟨v, 0⟩).mpr ⟨hv, Submodule.zero_mem _⟩)

/-- The underlying right-linear map of `freeUnit h V` is `freeι h V`. -/
@[simp]
theorem hom_freeUnit : (freeUnit h V).hom = freeι h V :=
  (rfl)

/-- The canonical graded right-linear projection `toGradedModuleCat (freeObj h V) ⟶ V{1}`. -/
def freeProj : toGradedModuleCat (freeObj h V) ⟶ V.shiftObj 1 :=
  GradedModuleCat.ofHom
    { toFun := fun x : FreeCarrier h V ↦ x.snd
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
    (LinearMap.isHomogeneous_def.mpr fun p x hx ↦ by
      rw [toGradedModuleCat_piece] at hx
      rw [add_zero, V.mem_shiftObj_piece_iff]
      exact ((mem_freeInternalGrading_piece_iff h V p x).mp hx).2)

/-- The unit inclusion into `freeObj h V` followed by the projection to `V{1}` is zero. -/
@[reassoc (attr := simp)]
theorem freeUnit_comp_freeProj : freeUnit h V ≫ freeProj h V = 0 :=
  GradedModuleCat.hom_ext (LinearMap.ext fun _ ↦ rfl)

/-- Applying the differential of `freeObj h V` to a generator `freeι h V v` and projecting to
`V{1}` recovers `v`. -/
@[simp]
theorem freeProj_differential_freeι_apply (v : V) :
    (freeProj h V).hom ((freeObj h V).differential (freeι h V v)) = v :=
  (rfl)

private theorem freeCarrier_eq_freeι_add_differential_freeι (x : FreeCarrier h V) :
    (x : freeObj h V) =
      freeι h V x.fst + (freeObj h V).differential (freeι h V x.snd) :=
  FreeCarrier.ext
    (by
      -- Unfold `freeι`, `freeDifferential`, and componentwise addition on the first coordinate.
      change x.fst = x.fst + op w • (0 : V)
      simp)
    (zero_add x.snd).symm

/-- Every element of `freeObj h V` decomposes as `ι u + d (ι v)` for `u, v ∈ V`. -/
theorem exists_eq_freeι_add_differential_freeι (x : freeObj h V) :
    ∃ u v : V, x = freeι h V u + (freeObj h V).differential (freeι h V v) :=
  ⟨x.fst, x.snd, freeCarrier_eq_freeι_add_differential_freeι h V x⟩

/-- After forgetting the differential, `freeObj h V` sits in the short exact sequence
`0 ⟶ V ⟶ toGradedModuleCat (freeObj h V) ⟶ V{1} ⟶ 0` of graded right modules. -/
theorem freeShortExact :
    (ShortComplex.mk (freeUnit h V) (freeProj h V) (freeUnit_comp_freeProj h V)).ShortExact := by
  have : Mono (freeUnit h V) :=
    (GradedModuleCat.mono_iff_injective _).2 fun _ _ huv ↦ congrArg FreeCarrier.fst huv
  have : Epi (freeProj h V) :=
    (GradedModuleCat.epi_iff_surjective _).2 fun v ↦ ⟨(⟨0, v⟩ : FreeCarrier h V), rfl⟩
  exact
    { exact := GradedModuleCat.exact_iff.2 fun x ↦
        ⟨fun hx ↦ ⟨x.fst, FreeCarrier.ext rfl hx.symm⟩, by rintro ⟨u, rfl⟩; rfl⟩ }

/-- If `V` is projective in the category of graded right modules, then the underlying graded
right module of `freeObj h V` is projective as well, as an extension of `V{1}` by `V`. -/
instance [Projective V] : Projective (toGradedModuleCat (freeObj h V)) :=
  projective_iff_hasProjectiveDimensionLT_one.mpr
    ((freeShortExact h V).hasProjectiveDimensionLT_X₂ 1 inferInstance inferInstance)

end Objects

-- Keep the closed and homotopy categories transparent on objects.
attribute [local implicit_reducible] ForgetEnrichment dgClosedToHomotopy
  DGHomotopyCategory.of DGHomotopyCategory.underlying

variable {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
  {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜] {d : A →ₗ[R] A} {w : A}

section Homotopy

variable (h : IsCurvedDGAlgebra 𝒜 d w)
  (V : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece)

/-- For a projective graded right module `V`, `freeObj h V` is graded-projective. -/
theorem gradedProjective_freeObj [Projective V] :
    gradedProjective R h (DGHomotopyCategory.of R (freeObj h V)) := by
  rw [gradedProjective_iff, DGHomotopyCategory.underlying_of]
  infer_instance

/-- The free curved right module `freeObj h V` is contractible: `(u, v) ↦ (v, 0)` is a right
`A`-linear cochain of degree `-1` contracting its identity. -/
theorem isZero_homotopy_freeObj : IsZero (DGHomotopyCategory.of R (freeObj h V)) := by
  refine (isZero_homotopy_iff_exists_contraction (freeObj h V)).mpr ⟨⟨?_, ?_⟩, fun x ↦ ?_⟩
  · exact freeι h V ∘ₗ (freeProj h V).hom
  · rw [dgRightModuleCochains.mem_iff, LinearMap.isHomogeneous_def]
    intro p x hx
    have hx' := ((mem_freeInternalGrading_piece_iff h V p x).mp hx).2
    exact (mem_freeInternalGrading_piece_iff h V (p + -1) ⟨x.snd, 0⟩).mpr
      ⟨by rwa [← sub_eq_add_neg], Submodule.zero_mem _⟩
  · refine FreeCarrier.ext ?_ (add_zero x.snd)
    -- Unfold `freeDifferential` and `(u, v) ↦ (v, 0)` on the first coordinate.
    change op w • (0 : V) + x.fst = x.fst
    simp

end Homotopy

section UniversalProperty

variable {h : IsCurvedDGAlgebra 𝒜 d w}
  {V W : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece}
  {M N : CurvedDGRightModuleCat.{u, u, u} h}

/-- Extend a graded right-linear morphism `f : V ⟶ toGradedModuleCat M` to a closed morphism
`freeObj h V ⟶ M` sending `ι u + d (ι v)` to `f u + d_M (f v)`. -/
def freeDesc (f : V ⟶ toGradedModuleCat M) :
    ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h V) ⟶
      ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M := by
  let f' : V →ₗ[Aᵐᵒᵖ] M := f.hom
  have hsmul (a : A) (v : V) :
      M.differential (f' (op a • v)) - f' (op (d a) • V.grading.koszulTwist 1 v) =
        op a • M.differential (f' v) := by
    induction v using DirectSum.Decomposition.inductionOn V.grading.piece with
    | zero => simp
    | add v₁ v₂ hv₁ hv₂ =>
      rw [smul_add, map_add, map_add, map_add, smul_add, map_add, map_add, map_add, smul_add,
        ← hv₁, ← hv₂]
      abel
    | @homogeneous q v =>
      rcases v with ⟨v, hv⟩
      have hfv : f' v ∈ M.grading q := by
        simpa only [toGradedModuleCat_piece] using GradedModuleCat.map_mem f hv
      rw [f'.map_smul, M.isCurvedDGRightModule.leibniz hfv a,
        koszulTwist_one_eq_negOnePow_smul hv]
      simp_rw [Units.smul_def, smul_comm (op (d a)) (q.negOnePow : ℤ), map_zsmul, f'.map_smul,
        add_sub_cancel_right]
  refine closedHomOf
    { toFun := fun x : FreeCarrier h V ↦ f' x.fst + M.differential (f' x.snd)
      map_add' := fun x y ↦ by
        -- Unfold componentwise addition on `FreeCarrier`.
        change f' (x.fst + y.fst) + M.differential (f' (x.snd + y.snd)) =
          (f' x.fst + M.differential (f' x.snd)) + (f' y.fst + M.differential (f' y.snd))
        rw [map_add, map_add, map_add]
        abel
      map_smul' := fun z x ↦ by
        induction z using MulOpposite.rec' with | h a =>
        -- Unfold the twisted `Aᵐᵒᵖ`-action on `FreeCarrier` and the action on `M`.
        change f' (op a • x.fst - op (d a) • V.grading.koszulTwist 1 x.snd) +
            M.differential (f' (op a • x.snd)) =
          op a • (f' x.fst + M.differential (f' x.snd))
        rw [map_sub, f'.map_smul, smul_add, ← hsmul a x.snd]
        abel }
    (fun p x hx ↦ by
      obtain ⟨hx₁, hx₂⟩ := (mem_freeInternalGrading_piece_iff h V p x).mp hx
      have hf₁ : f' x.fst ∈ M.grading p := by
        simpa only [toGradedModuleCat_piece] using GradedModuleCat.map_mem f hx₁
      have hf₂ : f' x.snd ∈ M.grading (p - 1) := by
        simpa only [toGradedModuleCat_piece] using GradedModuleCat.map_mem f hx₂
      have hdf₂ := M.isCurvedDGRightModule.isHomogeneous.map_mem hf₂
      rw [sub_add_cancel] at hdf₂
      exact Submodule.add_mem _ hf₁ hdf₂)
    (fun x ↦ by
      -- Unfold `freeDifferential` and the map `(u, v) ↦ f' u + d_M (f' v)`.
      change M.differential (f' x.fst + M.differential (f' x.snd)) =
        f' (op w • x.snd) + M.differential (f' x.fst)
      rw [map_add, M.isCurvedDGRightModule.sq_eq, f'.map_smul, add_comm])

/-- On generators `freeι h V u`, `freeDesc f` evaluates to `f u`. -/
@[simp]
theorem closedHom_freeDesc_freeι_apply (f : V ⟶ toGradedModuleCat M) (u : V) :
    closedHom (freeDesc f) (freeι h V u) = f.hom u := by
  dsimp only [freeDesc]
  rw [closedHom_closedHomOf]
  let f' : V →ₗ[Aᵐᵒᵖ] M := f.hom
  -- Evaluate `(u, v) ↦ f' u + d_M (f' v)` at `(u, 0)`.
  change f' u + M.differential (f' 0) = f' u
  rw [map_zero, map_zero, add_zero]

/-- On differentials of generators, `freeDesc f` evaluates to `d_M (f v)`. -/
@[simp]
theorem closedHom_freeDesc_differential_freeι_apply (f : V ⟶ toGradedModuleCat M) (v : V) :
    closedHom (freeDesc f) ((freeObj h V).differential (freeι h V v)) =
      M.differential (f.hom v) := by
  rw [← differential_closedHom, closedHom_freeDesc_freeι_apply]

/-- Forgetting the differential of `freeDesc f` and precomposing with `freeUnit h V` recovers
`f`. -/
@[reassoc (attr := simp)]
theorem freeUnit_comp_forgetDifferential_map_freeDesc (f : V ⟶ toGradedModuleCat M) :
    freeUnit h V ≫ (forgetDifferential (h := h)).map (freeDesc f) = f :=
  GradedModuleCat.hom_ext (LinearMap.ext fun u ↦ closedHom_freeDesc_freeι_apply f u)

/-- Closed morphisms out of `freeObj h V` are uniquely determined by their restriction along
`freeUnit h V`. -/
theorem freeObj_hom_ext
    {φ ψ : ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h V) ⟶
      ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M}
    (hφψ : freeUnit h V ≫ (forgetDifferential (h := h)).map φ =
      freeUnit h V ≫ (forgetDifferential (h := h)).map ψ) :
    φ = ψ := by
  apply closedHom_ext
  intro x
  have hu (v : V) : closedHom φ (freeι h V v) = closedHom ψ (freeι h V v) :=
    congrArg (fun g : V ⟶ toGradedModuleCat M ↦ (g.hom v : M)) hφψ
  obtain ⟨u, v, rfl⟩ := exists_eq_freeι_add_differential_freeι h V x
  rw [map_add, map_add, ← differential_closedHom, ← differential_closedHom, hu u, hu v]

/-- Postcomposing `freeDesc f` with a closed morphism `g` extends `f ≫ forgetDifferential.map g`. -/
@[reassoc (attr := simp)]
theorem freeDesc_comp (f : V ⟶ toGradedModuleCat M)
    (g : ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M ⟶
      ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) N) :
    freeDesc f ≫ g = freeDesc (f ≫ (forgetDifferential (h := h)).map g) :=
  freeObj_hom_ext (by
    rw [CategoryTheory.Functor.map_comp, ← Category.assoc,
      freeUnit_comp_forgetDifferential_map_freeDesc,
      freeUnit_comp_forgetDifferential_map_freeDesc])

/-- The `R`-linear universal property of `freeObj h V`: closed morphisms `freeObj h V ⟶ M`
correspond `R`-linearly to graded right-linear morphisms `V ⟶ toGradedModuleCat M`. -/
def freeHomEquiv
    (V : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece)
    (M : CurvedDGRightModuleCat.{u, u, u} h) :
    (ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h V) ⟶
        ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M) ≃ₗ[R]
      (V ⟶ toGradedModuleCat M) where
  toFun φ := freeUnit h V ≫ (forgetDifferential (h := h)).map φ
  invFun := freeDesc
  left_inv _ := freeObj_hom_ext (freeUnit_comp_forgetDifferential_map_freeDesc _)
  right_inv _ := freeUnit_comp_forgetDifferential_map_freeDesc _
  map_add' φ ψ := GradedModuleCat.hom_ext (LinearMap.ext fun u ↦ by
    -- Unfold graded composition and addition to underlying closed right-linear maps.
    change closedHom (φ + ψ) (freeι h V u) =
      closedHom φ (freeι h V u) + closedHom ψ (freeι h V u)
    rw [closedHom_add, LinearMap.add_apply])
  map_smul' r φ := GradedModuleCat.hom_ext (LinearMap.ext fun u ↦ by
    -- Unfold graded composition and scalar multiplication to underlying closed right-linear maps.
    change closedHom (r • φ) (freeι h V u) = r • closedHom φ (freeι h V u)
    rw [closedHom_smul, LinearMap.smul_apply])

/-- Forward direction of `freeHomEquiv`: restrict a closed morphism along `freeUnit h V`. -/
@[simp]
theorem freeHomEquiv_apply
    (φ : ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h V) ⟶
      ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M) :
    freeHomEquiv V M φ = freeUnit h V ≫ (forgetDifferential (h := h)).map φ :=
  (rfl)

/-- Inverse direction of `freeHomEquiv`: extend a graded morphism by `freeDesc`. -/
@[simp]
theorem freeHomEquiv_symm_apply (f : V ⟶ toGradedModuleCat M) :
    (freeHomEquiv V M).symm f = freeDesc f :=
  (rfl)

/-- Extending an epimorphism of graded right modules gives an epimorphism in the closed category
of curved right modules. -/
instance epi_freeDesc_of_epi (f : V ⟶ toGradedModuleCat M) [Epi f] : Epi (freeDesc f) := by
  refine (forgetDifferential (h := h)).epi_of_epi_map ((GradedModuleCat.epi_iff_surjective _).2 ?_)
  intro y
  obtain ⟨u, rfl⟩ := (GradedModuleCat.epi_iff_surjective f).1 inferInstance y
  exact ⟨freeι h V u, closedHom_freeDesc_freeι_apply f u⟩

/-- The **free curved right module functor** (`G⁺`), sending a graded right module to the curved
right module it freely generates. Its object map computes during type inference, matching
`forgetDifferential`, while `freeObj` itself remains sealed. -/
@[expose, implicit_reducible]
def freeFunctor :
    GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece ⥤
      ForgetEnrichment (CochainComplex (ModuleCat R) ℤ) (CurvedDGRightModuleCat.{u, u, u} h) where
  obj V := ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h V)
  map f := freeDesc (f ≫ freeUnit h _)
  map_id V := by
    refine freeObj_hom_ext ?_
    have hid :
        (forgetDifferential (h := h)).map
          (𝟙 (ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h V))) =
          𝟙 (toGradedModuleCat (freeObj h V)) :=
      GradedModuleCat.hom_ext (closedHom_id _)
    rw [freeUnit_comp_forgetDifferential_map_freeDesc, Category.id_comp, hid, Category.comp_id]
  map_comp _ _ := freeObj_hom_ext (by
    rw [freeUnit_comp_forgetDifferential_map_freeDesc, CategoryTheory.Functor.map_comp,
      ← Category.assoc, freeUnit_comp_forgetDifferential_map_freeDesc, Category.assoc,
      Category.assoc, freeUnit_comp_forgetDifferential_map_freeDesc])

/-- The free curved right module functor sends `V` to `freeObj h V` in the closed category. -/
@[simp]
theorem freeFunctor_obj
    (V : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece) :
    (freeFunctor (h := h)).obj V =
      ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h V) :=
  (rfl)

/-- Action of `freeFunctor` on morphisms via `freeDesc`. -/
theorem freeFunctor_map (f : V ⟶ W) :
    (freeFunctor (h := h)).map f = freeDesc (f ≫ freeUnit h W) :=
  (rfl)

/-- Naturality of `freeUnit` with respect to `freeFunctor`. -/
@[reassoc (attr := simp)]
theorem freeUnit_comp_forgetDifferential_map_freeFunctor_map (f : V ⟶ W) :
    freeUnit h V ≫ (forgetDifferential (h := h)).map ((freeFunctor (h := h)).map f) =
      f ≫ freeUnit h W :=
  freeUnit_comp_forgetDifferential_map_freeDesc (f ≫ freeUnit h W)

instance : (freeFunctor (h := h)).Additive where
  map_add {X Y f g} := by
    rw [freeFunctor_map, freeFunctor_map, freeFunctor_map,
      ← freeHomEquiv_symm_apply ((f + g) ≫ freeUnit h Y),
      ← freeHomEquiv_symm_apply (f ≫ freeUnit h Y),
      ← freeHomEquiv_symm_apply (g ≫ freeUnit h Y), Preadditive.add_comp, map_add]

instance : (freeFunctor (h := h)).Linear R where
  map_smul {X Y} f r := by
    rw [freeFunctor_map, freeFunctor_map,
      ← freeHomEquiv_symm_apply ((r • f) ≫ freeUnit h Y),
      ← freeHomEquiv_symm_apply (f ≫ freeUnit h Y), Linear.smul_comp, map_smul]

/-- The free curved right module functor is left adjoint to forgetting the differential. -/
def freeForgetDifferentialAdjunction :
    freeFunctor (h := h) ⊣ forgetDifferential (h := h) :=
  Adjunction.mkOfHomEquiv
    { homEquiv := fun V Y ↦ (freeHomEquiv V (ForgetEnrichment.to _ Y)).toEquiv
      homEquiv_naturality_left_symm := fun f g ↦
        ((freeDesc_comp (f ≫ freeUnit h _) (freeDesc g)).trans
          (congrArg freeDesc
            (by rw [Category.assoc, freeUnit_comp_forgetDifferential_map_freeDesc]))).symm
      homEquiv_naturality_right := fun φ ψ ↦
        GradedModuleCat.hom_ext (LinearMap.ext fun u ↦
          congrArg (fun l : _ →ₗ[Aᵐᵒᵖ] _ ↦ l (freeι h _ u)) (closedHom_comp φ ψ)) }

/-- The unit of `freeForgetDifferentialAdjunction` at `V` is `freeUnit h V`. -/
@[simp]
theorem freeForgetDifferentialAdjunction_unit_app
    (V : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece) :
    (freeForgetDifferentialAdjunction (h := h)).unit.app V = freeUnit h V :=
  GradedModuleCat.hom_ext (LinearMap.ext fun u ↦ by
    -- Unfold `Adjunction.mkOfHomEquiv` unit to `closedHom (𝟙 _) (freeι h V u)`.
    change closedHom (𝟙 (ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h V)))
      (freeι h V u) = freeι h V u
    rw [closedHom_id, LinearMap.id_apply])

/-- The counit of `freeForgetDifferentialAdjunction` at `M` extends `𝟙 (toGradedModuleCat M)`. -/
@[simp]
theorem freeForgetDifferentialAdjunction_counit_app (M : CurvedDGRightModuleCat.{u, u, u} h) :
    (freeForgetDifferentialAdjunction (h := h)).counit.app
        (ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M) =
      freeDesc (𝟙 (toGradedModuleCat M)) :=
  (rfl)

/-- **Existence of contractible graded-projective covers.** Every curved right module receives an
epimorphism in the closed category from a contractible curved right module whose underlying graded
right module is projective. -/
theorem exists_epi_contractible_gradedProjective (M : CurvedDGRightModuleCat.{u, u, u} h) :
    ∃ (Q : CurvedDGRightModuleCat.{u, u, u} h)
      (π : ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) Q ⟶
        ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M),
      Epi π ∧ Projective (toGradedModuleCat Q) ∧ IsZero (DGHomotopyCategory.of R Q) :=
  ⟨freeObj h (Projective.over (toGradedModuleCat M)),
    freeDesc (Projective.π (toGradedModuleCat M)),
    inferInstance, inferInstance, isZero_homotopy_freeObj h _⟩

end UniversalProperty

end TauCeti.CurvedDGRightModuleCat
