module

public import TauCeti.Algebra.Homology.Curved.Module.Right.Stable
public import TauCeti.CategoryTheory.Exact.Stable.Connecting
public import TauCeti.CategoryTheory.Exact.Stable.Shift
public import TauCeti.CategoryTheory.Exact.Stable.Suspension

/-!
# Stable suspension of curved right modules is the cohomological shift

The graded-split exact structure on curved right modules is Frobenius, and every module `M` has
the relative injective presentation `M ⟶ cone(𝟙 M) ⟶ M[1]`: its middle term is contractible.
A closed map `f` induces a map of these cone sequences whose cokernel component is the shift
of `f`. Since stable suspension may be computed from any relative injective presentation, it is
naturally the cohomological shift by one in the stable category.

Consequently the stable-to-homotopy equivalence `gradedSplitStableToHomotopy` intertwines stable
suspension with the existing shift by one on the curved homotopy category, and so commutes with
all the integral shifts: the one generated by stable suspension and the coherent cohomological
shift. This is the shift compatibility along which Happel's triangulation is transported to the
curved homotopy category.

## Main definitions

* `TauCeti.CurvedDGRightModuleCat.gradedSplitStableSuspensionIsoShift`: stable suspension of
  the graded-split exact structure is naturally the image of the cohomological shift by one.
* `TauCeti.CurvedDGRightModuleCat.stableSuspensionCompGradedSplitStableToHomotopyIso`: the
  stable-to-homotopy comparison intertwines stable suspension with the shift by one.
* `TauCeti.CurvedDGRightModuleCat.gradedSplitStableToHomotopyCommShift`: the stable-to-homotopy
  comparison commutes with the shifts by `ℤ`.
* `TauCeti.CurvedDGRightModuleCat.gradedSplitStableToHomotopy_map_connectingMap`: identity-cone
  extensions compute the transported stable connecting arrows of graded-split conflations.

## References

* L. Positselski, *Differential graded Koszul duality: an introductory survey*, Section 7.6.
* D. Happel, *Triangulated Categories in the Representation Theory of Finite Dimensional
  Algebras*, Chapter I, Section 2: suspension in the stable category of a Frobenius category.
* The Tau Ceti contributors, `TauCeti.Algebra.Homology.Periodic.Suspension`: the natural
  isomorphism and its transport to the homotopy category follow the identity-cone comparison
  for periodic complexes.
-/

public section

open CategoryTheory CategoryTheory.Limits

namespace TauCeti.CurvedDGRightModuleCat

universe u

-- The closed category and the quotient retain the original curved-module carriers.
attribute [local implicit_reducible] ForgetEnrichment dgClosedToHomotopy
  DGHomotopyCategory.of DGHomotopyCategory.underlying

variable {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
  {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜] {d : A →ₗ[R] A} {w : A}
  {h : IsCurvedDGAlgebra 𝒜 d w}

/-- The map induced on the cokernels of identity-cone presentations is the shift of the original
closed map, in the projective stable category. -/
@[simp]
theorem projectiveStableFunctor_map_coneIdentityInjectivePresentation_cokernelMap
    {M N : CurvedDGRightModuleCat.{u, u, u} h}
    (f : ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M ⟶
      ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) N) :
    (gradedSplitExact (h := h)).projectiveStableFunctor.map
        ((coneIdentityInjectivePresentation M).cokernelMap
          (coneIdentityInjectivePresentation N) f) =
      (gradedSplitExact (h := h)).projectiveStableFunctor.map
        ((shiftFunctor _ (1 : ℤ)).map f) := by
  refine ExactStructure.projectiveStableFunctor_map_cokernelMap_eq
    (coneIdentityInjectivePresentation M) (coneIdentityInjectivePresentation N)
    (gradedSplitExact_isFrobenius.isProjective_I _) f
    (coneMap (𝟙 _) (𝟙 _) f f 0 ?_) ((shiftFunctor _ (1 : ℤ)).map f) ?_ ?_
  · intro x
    simp
  · exact coneInclusion_comp_coneMap _ _ _ _ _ _
  · -- The shift by one on the closed category is `closedShiftFunctor 1` by construction.
    exact (coneMap_comp_coneProjection _ _ _ _ _ _).symm

/-- The identity comparison of the cokernel terms of identity-cone presentations with the
shifted modules is natural in the projective stable category. -/
private theorem projectiveStableFunctor_map_coneIdentityInjectivePresentation_cokernelMap_comp
    {X Y : ForgetEnrichment (CochainComplex (ModuleCat R) ℤ)
      (CurvedDGRightModuleCat.{u, u, u} h)} (f : X ⟶ Y) :
    (gradedSplitExact (h := h)).projectiveStableFunctor.map
        ((coneIdentityInjectivePresentation (ForgetEnrichment.to _ X)).cokernelMap
          (coneIdentityInjectivePresentation (ForgetEnrichment.to _ Y)) f) ≫
        (Iso.refl ((gradedSplitExact (h := h)).projectiveStableFunctor.obj
          ((shiftFunctor _ (1 : ℤ)).obj Y))).hom =
      (Iso.refl ((gradedSplitExact (h := h)).projectiveStableFunctor.obj
          ((shiftFunctor _ (1 : ℤ)).obj X))).hom ≫
        (gradedSplitExact (h := h)).projectiveStableFunctor.map ((shiftFunctor _ (1 : ℤ)).map f) :=
  -- The cokernel terms are the shifted modules only definitionally, beyond the reach of `simp`.
  (Category.comp_id _).trans
    ((projectiveStableFunctor_map_coneIdentityInjectivePresentation_cokernelMap f).trans
      (Category.id_comp _).symm)

/-- **Stable suspension of curved right modules is the cohomological shift.** For the
graded-split exact structure, the stable suspension of (the image of) a curved module is (the
image of) its shift by one, naturally. -/
noncomputable def gradedSplitStableSuspensionIsoShift :
    (gradedSplitExact (h := h)).projectiveStableFunctor ⋙
        gradedSplitExact_isFrobenius.stableSuspension ≅
      shiftFunctor _ (1 : ℤ) ⋙ (gradedSplitExact (h := h)).projectiveStableFunctor :=
  gradedSplitExact_isFrobenius.stableSuspensionIsoOfPresentations _
    (fun X ↦ coneIdentityInjectivePresentation (ForgetEnrichment.to _ X)) (fun _ ↦ Iso.refl _)
    projectiveStableFunctor_map_coneIdentityInjectivePresentation_cokernelMap_comp

/-- The component of `gradedSplitStableSuspensionIsoShift` at `X` is induced by the identity of
`X`, from the chosen suspension presentation to the identity-cone presentation. -/
@[simp]
theorem gradedSplitStableSuspensionIsoShift_hom_app
    (X : ForgetEnrichment (CochainComplex (ModuleCat R) ℤ)
      (CurvedDGRightModuleCat.{u, u, u} h)) :
    gradedSplitStableSuspensionIsoShift.hom.app X =
      eqToHom (gradedSplitExact_isFrobenius.stableSuspension_obj_projectiveStableFunctor_obj X) ≫
        (gradedSplitExact (h := h)).projectiveStableFunctor.map
          ((gradedSplitExact_isFrobenius.suspensionPresentation X).cokernelMap
            (coneIdentityInjectivePresentation (ForgetEnrichment.to _ X)) (𝟙 X)) :=
  (gradedSplitExact_isFrobenius.stableSuspensionIsoOfPresentations_hom_app _ _ _
    projectiveStableFunctor_map_coneIdentityInjectivePresentation_cokernelMap_comp X).trans
    (congrArg (_ ≫ ·) (Category.comp_id _))

/-- The inverse component of `gradedSplitStableSuspensionIsoShift` at `X` is induced by the
identity of `X`, from the identity-cone presentation to the chosen suspension presentation. -/
@[simp]
theorem gradedSplitStableSuspensionIsoShift_inv_app
    (X : ForgetEnrichment (CochainComplex (ModuleCat R) ℤ)
      (CurvedDGRightModuleCat.{u, u, u} h)) :
    gradedSplitStableSuspensionIsoShift.inv.app X =
      (gradedSplitExact (h := h)).projectiveStableFunctor.map
          ((coneIdentityInjectivePresentation (ForgetEnrichment.to _ X)).cokernelMap
            (gradedSplitExact_isFrobenius.suspensionPresentation X) (𝟙 X)) ≫
        eqToHom
          (gradedSplitExact_isFrobenius.stableSuspension_obj_projectiveStableFunctor_obj
            X).symm :=
  (gradedSplitExact_isFrobenius.stableSuspensionIsoOfPresentations_inv_app _ _ _
    projectiveStableFunctor_map_coneIdentityInjectivePresentation_cokernelMap_comp X).trans
    (Category.id_comp _)

/-- The stable-to-homotopy comparison intertwines stable suspension with the shift by one on the
curved homotopy category. -/
noncomputable def stableSuspensionCompGradedSplitStableToHomotopyIso :
    gradedSplitExact_isFrobenius.stableSuspension ⋙ gradedSplitStableToHomotopy ≅
      gradedSplitStableToHomotopy ⋙
        shiftFunctor (DGHomotopyCategory R (CurvedDGRightModuleCat.{u, u, u} h)) (1 : ℤ) :=
  gradedSplitExact_isFrobenius.stableSuspensionCompIsoOfFactorization
    projectiveStableFunctor_comp_gradedSplitStableToHomotopy gradedSplitStableSuspensionIsoShift
    ((dgClosedToHomotopy R).commShiftIso (1 : ℤ))

/-- On the stable image of a curved module, the intertwining isomorphism is the image of the
suspension comparison, followed by the quotient's shift comparison. -/
@[simp]
theorem stableSuspensionCompGradedSplitStableToHomotopyIso_hom_app
    (X : ForgetEnrichment (CochainComplex (ModuleCat R) ℤ)
      (CurvedDGRightModuleCat.{u, u, u} h)) :
    stableSuspensionCompGradedSplitStableToHomotopyIso.hom.app
        ((gradedSplitExact (h := h)).projectiveStableFunctor.obj X) =
      gradedSplitStableToHomotopy.map (gradedSplitStableSuspensionIsoShift.hom.app X) ≫
        eqToHom (by simp) ≫ ((dgClosedToHomotopy R).commShiftIso (1 : ℤ)).hom.app X ≫
          eqToHom (by simp) := by
  simp [stableSuspensionCompGradedSplitStableToHomotopyIso]

/-- The comparison from the graded-split stable category to the curved homotopy category
commutes with the shifts by `ℤ`: the one generated by stable suspension and the coherent
cohomological shift. -/
@[instance_reducible]
noncomputable def gradedSplitStableToHomotopyCommShift :
    letI := (gradedSplitExact_isFrobenius (h := h)).stableHasShift
    (gradedSplitStableToHomotopy (h := h)).CommShift ℤ :=
  gradedSplitExact_isFrobenius.commShiftOfIntertwiningStableSuspensionShift _
    stableSuspensionCompGradedSplitStableToHomotopyIso

/-- In degree one, the shift compatibility of the stable-to-homotopy comparison is the
identification of stable suspension with the cohomological shift. -/
theorem gradedSplitStableToHomotopyCommShift_iso_one :
    letI := (gradedSplitExact_isFrobenius (h := h)).stableHasShift
    letI := gradedSplitStableToHomotopyCommShift (h := h)
    (gradedSplitStableToHomotopy (h := h)).commShiftIso (1 : ℤ) =
      Functor.isoWhiskerRight gradedSplitExact_isFrobenius.stableShiftFunctorOneIso _ ≪≫
        stableSuspensionCompGradedSplitStableToHomotopyIso :=
  gradedSplitExact_isFrobenius.commShiftOfIntertwiningStableSuspensionShift_iso_one _ _

section Connecting

attribute [local implicit_reducible] coneIdentityInjectivePresentation
  EnrichedFunctor.ofDGMap EnrichedFunctor.mapDGHomotopyCategory

/-- The stable connecting arrow of a graded-split conflation is the homotopy class of the map
induced by an extension to the identity-cone presentation. The canonical suspension and shift
comparisons identify its target with the cohomological shift, with positive sign. -/
theorem gradedSplitStableToHomotopy_map_connectingMap
    {S : ShortComplex (ForgetEnrichment (CochainComplex (ModuleCat R) ℤ)
      (CurvedDGRightModuleCat.{u, u, u} h))}
    (hS : (gradedSplitExact (h := h)).Conflation S)
    (a : S.X₂ ⟶ (coneIdentityInjectivePresentation (ForgetEnrichment.to _ S.X₁)).I)
    (δ : S.X₃ ⟶ (coneIdentityInjectivePresentation (ForgetEnrichment.to _ S.X₁)).K)
    (ha : S.f ≫ a = (coneIdentityInjectivePresentation (ForgetEnrichment.to _ S.X₁)).i)
    (hδ : S.g ≫ δ = a ≫ (coneIdentityInjectivePresentation (ForgetEnrichment.to _ S.X₁)).p) :
    letI := (gradedSplitExact_isFrobenius (h := h)).stableHasShift
    letI := gradedSplitStableToHomotopyCommShift (h := h)
    (gradedSplitStableToHomotopy (h := h)).map
        ((gradedSplitExact (h := h)).projectiveStableFunctor.map
            ((gradedSplitExact_isFrobenius (h := h)).connectingMap hS) ≫
          eqToHom
            (gradedSplitExact_isFrobenius.stableSuspension_obj_projectiveStableFunctor_obj
              S.X₁).symm ≫
          (gradedSplitExact_isFrobenius (h := h)).stableShiftFunctorOneIso.inv.app
            ((gradedSplitExact (h := h)).projectiveStableFunctor.obj S.X₁)) ≫
        ((gradedSplitStableToHomotopy (h := h)).commShiftIso (1 : ℤ)).hom.app
          ((gradedSplitExact (h := h)).projectiveStableFunctor.obj S.X₁) =
      eqToHom (gradedSplitStableToHomotopy_obj_projectiveStableFunctor_obj S.X₃) ≫
        (dgClosedToHomotopy R).map δ ≫ eqToHom (by simp) := by
  let := (gradedSplitExact_isFrobenius (h := h)).stableHasShift
  let := gradedSplitStableToHomotopyCommShift (h := h)
  have key := congrArg ((gradedSplitStableToHomotopy (h := h)).map)
    ((gradedSplitExact_isFrobenius (h := h)).projectiveStableFunctor_map_eq_connectingMap_comp
      hS (coneIdentityInjectivePresentation (ForgetEnrichment.to _ S.X₁)) a δ ha hδ)
  -- The generic factorization is typed at represented stable objects, while δ is a closed
  -- map. Align its image first, then normalize the public comparison transports.
  erw [gradedSplitStableToHomotopy_map_projectiveStableFunctor_map (h := h) δ] at key
  simp only [gradedSplitStableToHomotopy_map_projectiveStableFunctor_map, Functor.map_comp,
    ExactStructure.IsFrobenius.projectiveStableIsoSuspensionObj_inv, Category.assoc,
    eqToHom_trans_assoc, eqToHom_refl, Category.id_comp] at key
  rw [eqToHom_comp_iff, comp_eqToHom_iff] at key
  simp only [Functor.map_comp, gradedSplitStableToHomotopy_map_projectiveStableFunctor_map,
    gradedSplitStableToHomotopyCommShift_iso_one, Iso.trans_hom,
    Functor.isoWhiskerRight_hom, NatTrans.comp_app, Functor.comp_obj,
    Functor.whiskerRight_app, stableSuspensionCompGradedSplitStableToHomotopyIso_hom_app,
    gradedSplitStableSuspensionIsoShift_hom_app, Category.assoc,
    Iso.inv_hom_id_app_map_assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  simp only [key, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp, Category.assoc,
    eqToHom_map]
  simp only [dgClosedToHomotopy_commShiftIso_hom_app, eqToHom_trans]

end Connecting

end TauCeti.CurvedDGRightModuleCat
