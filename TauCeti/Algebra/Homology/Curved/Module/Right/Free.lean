module

public import Mathlib.CategoryTheory.Adjunction.Basic
public import TauCeti.Algebra.Category.GradedModuleCat.Free
public import TauCeti.Algebra.Homology.Curved.Module.Right.Graded.Basic
public import TauCeti.Algebra.Homology.Curved.Module.Right.Homotopy
public import TauCeti.Algebra.Module.GradedModule.Prod

/-!
# Free curved differential graded right modules

For a graded right module `X` over the underlying graded algebra of a curved differential graded
algebra `(𝒜, d, w)`, the **free curved module** `G⁺(X)` generated by `X` has underlying `R`-module
`X × X` (thought of as formal expressions `x + δy`), grading `(G⁺(X))ᵖ = Xᵖ × Xᵖ⁻¹`, differential
`d(x, y) = (y * w, x)`, and twisted right `A`-action

`(x, y) * a = (x * a - (-1) ^ |y| * (y * d a), y * a)`

on homogeneous `y`, written globally with the degreewise sign involution `koszulTwist 1`. The
Leibniz rule for `d` on `A` makes this an associative right action, and the right-module curvature
equation `d (d a) = a * w - w * a` together with `d w = 0` makes `G⁺(X)` a curved differential
graded right module with curvature `w`.

The resulting functor `freeFunctor` is left adjoint to `forgetDifferential`: a closed morphism
`G⁺(X) ⟶ M` corresponds uniquely to a degree-zero graded right-linear map `f : X ⟶ M` via
`(x, y) ↦ f x + dM (f y)`. Every `G⁺(X)` is contractible via `(x, y) ↦ (y, 0)` and fits into a
short exact sequence `0 ⟶ X ⟶ G⁺(X) ⟶ X{1} ⟶ 0` of graded right modules. Consequently `G⁺(X)` is
graded-projective whenever `X` is projective, and applying `G⁺` to a graded projective presentation
produces a surjective closed morphism from a graded-projective curved module onto any curved right
module.

## Main definitions

* `TauCeti.CurvedDGRightModuleCat.freeObj`: the free curved right module `G⁺(X)`.
* `TauCeti.CurvedDGRightModuleCat.freeFunctor`: the left adjoint functor from graded right modules
  to the closed category of curved right modules.
* `TauCeti.CurvedDGRightModuleCat.freeForgetAdjunction`: the adjunction
  `freeFunctor ⊣ forgetDifferential`.

## Main results

* `TauCeti.CurvedDGRightModuleCat.freeShortExact`: the canonical short exact sequence
  `0 ⟶ X ⟶ toGradedModuleCat (freeObj X) ⟶ X{1} ⟶ 0` of graded right modules.
* `TauCeti.CurvedDGRightModuleCat.isZero_homotopy_freeObj`: every free curved module `G⁺(X)` is
  contractible, hence zero in the curved homotopy category.
* `TauCeti.CurvedDGRightModuleCat.projective_toGradedModuleCat_freeObj`: `G⁺(X)` is
  graded-projective whenever `X` is projective.
* `TauCeti.CurvedDGRightModuleCat.exists_gradedProjective_surjective`: every curved right module
  admits a surjective closed morphism from a graded-projective curved module.

## References

* L. Positselski, *Two kinds of derived categories, Koszul duality, and comodule-contramodule
  correspondence*, Mem. Amer. Math. Soc. **212** (2011), no. 996, Section 3.6.
* L. Positselski, *Differential graded Koszul duality: an introductory survey*, Bull. Lond. Math.
  Soc. **55** (2023), 1553–1640, Section 7.6.
-/

public section

open CategoryTheory CategoryTheory.Limits DirectSum MulOpposite

namespace TauCeti.CurvedDGRightModuleCat

universe u

-- The closed and homotopy categories keep the original curved module objects.
attribute [local implicit_reducible] ForgetEnrichment dgClosedToHomotopy
  DGHomotopyCategory.of DGHomotopyCategory.underlying

variable {R A : Type u} [CommRing R] [Ring A] [Algebra R A]
  {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜] {d : A →ₗ[R] A} {w : A}
  {h : IsCurvedDGAlgebra 𝒜 d w}

local instance : SetLike.GradedMonoid (InternalGrading.ofDecomposition 𝒜).piece := by
  rw [InternalGrading.ofDecomposition_piece]
  infer_instance

section Carrier

variable (h) (X : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece)

/-- The underlying type of the free curved module `G⁺(X)`. Kept separate from `X × X` so that it
can carry the twisted right `A`-module action without conflicting with `Prod.instModule`. -/
@[ext]
private structure FreeCarrier
    (_h : IsCurvedDGAlgebra 𝒜 d w)
    (X : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece) where
  fst : X
  snd : X

private def freeCarrierEquivData : FreeCarrier h X ≃ X × X where
  toFun z := (z.fst, z.snd)
  invFun p := ⟨p.1, p.2⟩
  left_inv z := by cases z; rfl
  right_inv _ := rfl

private instance : AddCommGroup (FreeCarrier h X) where
  add x y := ⟨x.fst + y.fst, x.snd + y.snd⟩
  add_assoc x y z := by ext <;> exact add_assoc _ _ _
  zero := ⟨0, 0⟩
  zero_add x := by ext <;> exact zero_add _
  add_zero x := by ext <;> exact add_zero _
  nsmul n x := ⟨n • x.fst, n • x.snd⟩
  nsmul_zero x := by ext <;> exact zero_nsmul _
  nsmul_succ n x := by ext <;> exact succ_nsmul _ _
  neg x := ⟨-x.fst, -x.snd⟩
  zsmul n x := ⟨n • x.fst, n • x.snd⟩
  zsmul_zero' x := by ext <;> exact zero_zsmul _
  zsmul_succ' n x := by ext <;> exact SubNegMonoid.zsmul_succ' n _
  zsmul_neg' n x := by ext <;> exact SubNegMonoid.zsmul_neg' n _
  neg_add_cancel x := by ext <;> exact neg_add_cancel _
  add_comm x y := by ext <;> exact add_comm _ _

private instance : Module R (FreeCarrier h X) where
  smul r x := ⟨r • x.fst, r • x.snd⟩
  one_smul x := by ext <;> exact one_smul R _
  mul_smul r s x := by ext <;> exact mul_smul r s _
  smul_zero r := by ext <;> exact smul_zero r
  smul_add r x y := by ext <;> exact smul_add r _ _
  add_smul r s x := by ext <;> exact add_smul r s _
  zero_smul x := by ext <;> exact zero_smul R _

@[simp] private theorem freeCarrier_zero_fst : (0 : FreeCarrier h X).fst = 0 := rfl
@[simp] private theorem freeCarrier_zero_snd : (0 : FreeCarrier h X).snd = 0 := rfl
@[simp] private theorem freeCarrier_add_fst (x y : FreeCarrier h X) :
    (x + y).fst = x.fst + y.fst := rfl
@[simp] private theorem freeCarrier_add_snd (x y : FreeCarrier h X) :
    (x + y).snd = x.snd + y.snd := rfl
@[simp] private theorem freeCarrier_smulR_fst (r : R) (x : FreeCarrier h X) :
    (r • x).fst = r • x.fst := rfl
@[simp] private theorem freeCarrier_smulR_snd (r : R) (x : FreeCarrier h X) :
    (r • x).snd = r • x.snd := rfl
@[simp] private theorem freeCarrier_zsmul_fst (n : ℤ) (x : FreeCarrier h X) :
    (n • x).fst = n • x.fst := rfl
@[simp] private theorem freeCarrier_zsmul_snd (n : ℤ) (x : FreeCarrier h X) :
    (n • x).snd = n • x.snd := rfl

include h in
/-- On `X`, the degreewise sign involution `koszulTwist 1` satisfies the graded commutation rule
with right multiplication by `A`, giving the associativity identity for the twisted action. -/
private theorem koszulTwist_smul_leibniz (u v : A) (y : X) :
    op (d (v * u)) • X.grading.koszulTwist 1 y =
      op u • (op (d v) • X.grading.koszulTwist 1 y) +
        op (d u) • X.grading.koszulTwist 1 (op v • y) := by
  classical
  have hop_sum (s : Finset ℤ) (f : ℤ → A) :
      op (∑ i ∈ s, f i) = ∑ i ∈ s, op (f i) :=
    map_sum MulOpposite.opAddEquiv f s
  -- Decompose `v` in `𝒜` and `y` in `X.grading.piece` into homogeneous pieces.
  conv_lhs =>
    rw [← DirectSum.sum_support_decompose 𝒜 v, Finset.sum_mul, map_sum,
      hop_sum, Finset.sum_smul]
  conv_rhs =>
    arg 1
    rw [← DirectSum.sum_support_decompose 𝒜 v, map_sum, hop_sum,
      Finset.sum_smul, Finset.smul_sum]
  conv_rhs =>
    arg 2
    rw [← DirectSum.sum_support_decompose 𝒜 v, hop_sum, Finset.sum_smul,
      map_sum, Finset.smul_sum]
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun p _ ↦ ?_
  set vp : A := (DirectSum.decompose 𝒜 v p : A)
  have hvp : vp ∈ 𝒜 p := (DirectSum.decompose 𝒜 v p).2
  have hvp_op : op vp ∈ (InternalGrading.ofDecomposition 𝒜).opposite.piece p := by
    rw [InternalGrading.mem_opposite_piece_iff, InternalGrading.ofDecomposition_piece]
    exact hvp
  rw [← DirectSum.sum_support_decompose X.grading.piece y]
  simp only [map_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun q _ ↦ ?_
  set yq : X := (DirectSum.decompose X.grading.piece y q : X)
  have hyq : yq ∈ X.grading.piece q := (DirectSum.decompose X.grading.piece y q).2
  have hvyq : op vp • yq ∈ X.grading.piece (p + q) :=
    SetLike.GradedSMul.smul_mem hvp_op hyq
  rw [h.leibniz hvp u, MulOpposite.op_add, add_smul, op_mul, mul_smul,
    X.grading.koszulTwist_one_apply_of_mem hyq,
    X.grading.koszulTwist_one_apply_of_mem hvyq]
  congr 1
  -- Align the unit `ℤˣ`-smul on `A` with the `R`-scalar cast in `koszulTwist`.
  rw [Units.smul_def, Int.cast_smul_eq_zsmul R, Int.cast_smul_eq_zsmul R,
    MulOpposite.op_smul, smul_assoc, op_mul, mul_smul,
    smul_comm (op vp) (q.negOnePow : ℤ), smul_comm (op (d u)) (q.negOnePow : ℤ),
    ← mul_zsmul, ← Units.val_mul, ← Int.negOnePow_add,
    smul_comm ((p + q).negOnePow : ℤ) (op (d u))]

private noncomputable instance : SMul Aᵐᵒᵖ (FreeCarrier h X) where
  smul a z := ⟨a • z.fst - op (d a.unop) • X.grading.koszulTwist 1 z.snd, a • z.snd⟩

@[simp] private theorem freeCarrier_smulA_fst (a : Aᵐᵒᵖ) (z : FreeCarrier h X) :
    (a • z).fst = a • z.fst - op (d a.unop) • X.grading.koszulTwist 1 z.snd := rfl
@[simp] private theorem freeCarrier_smulA_snd (a : Aᵐᵒᵖ) (z : FreeCarrier h X) :
    (a • z).snd = a • z.snd := rfl

private noncomputable instance : Module Aᵐᵒᵖ (FreeCarrier h X) where
  one_smul z := by
    ext <;> simp [h.map_one_eq_zero]
  mul_smul a b z := by
    ext
    · simp only [freeCarrier_smulA_fst, freeCarrier_smulA_snd, unop_mul, smul_sub, mul_smul,
        koszulTwist_smul_leibniz h X]
      abel
    · simp [mul_smul]
  smul_zero a := by
    ext <;> simp
  smul_add a z₁ z₂ := by
    ext
    · simp only [freeCarrier_smulA_fst, freeCarrier_add_fst, freeCarrier_add_snd, map_add, smul_add]
      abel
    · simp [smul_add]
  add_smul a b z := by
    ext
    · simp only [freeCarrier_smulA_fst, freeCarrier_add_fst, MulOpposite.unop_add, map_add,
        MulOpposite.op_add, add_smul]
      abel
    · simp [add_smul]
  zero_smul z := by
    ext <;> simp

private instance : IsScalarTower R Aᵐᵒᵖ (FreeCarrier h X) where
  smul_assoc r a z := by
    ext
    · simp only [freeCarrier_smulA_fst, freeCarrier_smulR_fst, MulOpposite.unop_smul, map_smul,
        MulOpposite.op_smul, smul_assoc, smul_sub]
    · simp [smul_assoc]

/-- The `R`-linear equivalence identifying `FreeCarrier h X` with `X × X`. -/
private def freeCarrierEquiv : FreeCarrier h X ≃ₗ[R] X × X where
  toEquiv := freeCarrierEquivData h X
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The internal grading on `FreeCarrier h X`, with degree-`p` piece `Xᵖ × Xᵖ⁻¹`. -/
private noncomputable def freeCarrierGrading : InternalGrading R (FreeCarrier h X) ℤ :=
  (X.grading.prod (X.shiftObj 1).grading).map (freeCarrierEquiv h X).symm

private theorem mem_freeCarrierGrading_iff {p : ℤ} {z : FreeCarrier h X} :
    z ∈ (freeCarrierGrading h X).piece p ↔
      z.fst ∈ X.grading.piece p ∧ z.snd ∈ X.grading.piece (p - 1) := by
  rw [freeCarrierGrading, InternalGrading.map_piece, InternalGrading.prod_piece,
    Submodule.mem_map]
  constructor
  · rintro ⟨⟨x, y⟩, ⟨hx, hy⟩, rfl⟩
    exact ⟨hx, by simpa [sub_eq_add_neg, freeCarrierEquiv, freeCarrierEquivData] using hy⟩
  · rintro ⟨hx, hy⟩
    refine ⟨(z.fst, z.snd), ⟨hx, ?_⟩, ?_⟩
    · simpa [sub_eq_add_neg] using hy
    · cases z; rfl

private noncomputable instance :
    SetLike.GradedSMul (InternalGrading.ofDecomposition 𝒜).opposite.piece
      (freeCarrierGrading h X).piece where
  smul_mem {i j} a z ha hz := by
    rw [mem_freeCarrierGrading_iff] at hz ⊢
    have hda : op (d a.unop) ∈ (InternalGrading.ofDecomposition 𝒜).opposite.piece (i + 1) := by
      rw [InternalGrading.mem_opposite_piece_iff, InternalGrading.ofDecomposition_piece] at ha ⊢
      exact h.map_mem ha
    have hτ : X.grading.koszulTwist 1 z.snd ∈ X.grading.piece (j - 1) :=
      X.grading.koszulTwist_mem_piece hz.2 1
    simp only [freeCarrier_smulA_fst, freeCarrier_smulA_snd, vadd_eq_add]
    refine ⟨(X.grading.piece (i + j)).sub_mem (SetLike.GradedSMul.smul_mem ha hz.1) ?_, ?_⟩
    · convert SetLike.GradedSMul.smul_mem hda hτ using 2
      rw [vadd_eq_add]
      omega
    · convert SetLike.GradedSMul.smul_mem ha hz.2 using 2
      rw [vadd_eq_add]
      omega

/-- The differential `(x, y) ↦ (y * w, x)` on `FreeCarrier h X`. -/
private def freeCarrierDifferential : FreeCarrier h X →ₗ[R] FreeCarrier h X where
  toFun z := ⟨op w • z.snd, z.fst⟩
  map_add' _ _ := by ext <;> simp [smul_add]
  map_smul' r z := by ext <;> simp [smul_comm r (op w)]

@[simp] private theorem freeCarrierDifferential_fst (z : FreeCarrier h X) :
    (freeCarrierDifferential h X z).fst = op w • z.snd := rfl
@[simp] private theorem freeCarrierDifferential_snd (z : FreeCarrier h X) :
    (freeCarrierDifferential h X z).snd = z.fst := rfl

private theorem isCurvedDGRightModule_freeCarrier :
    IsCurvedDGRightModule h (freeCarrierGrading h X).piece (freeCarrierDifferential h X) where
  isHomogeneous := by
    rw [LinearMap.isHomogeneous_def]
    intro p z hz
    rw [mem_freeCarrierGrading_iff] at hz ⊢
    have hw : op w ∈ (InternalGrading.ofDecomposition 𝒜).opposite.piece 2 := by
      rw [InternalGrading.mem_opposite_piece_iff, InternalGrading.ofDecomposition_piece]
      exact h.curvature_mem
    simp only [freeCarrierDifferential_fst, freeCarrierDifferential_snd]
    refine ⟨?_, ?_⟩
    · convert SetLike.GradedSMul.smul_mem hw hz.2 using 2
      rw [vadd_eq_add]
      omega
    · simpa using hz.1
  leibniz {p} z hz a := by
    rw [mem_freeCarrierGrading_iff] at hz
    have hτx : X.grading.koszulTwist 1 z.fst = p.negOnePow • z.fst := by
      rw [X.grading.koszulTwist_one_apply_of_mem hz.1, Int.cast_smul_eq_zsmul R, Units.smul_def]
    have hτy : X.grading.koszulTwist 1 z.snd = -(p.negOnePow • z.snd) := by
      rw [X.grading.koszulTwist_one_apply_of_mem hz.2, Int.cast_smul_eq_zsmul R,
        Int.negOnePow_sub, Int.negOnePow_one, Units.val_mul, Units.val_neg, Units.val_one,
        mul_neg_one, neg_zsmul, Units.smul_def]
    ext
    · -- First component: `w * (y * a) = (y * w) * a + (-1)^p (x * d a - (-1)^{p-1} y * d² a)`.
      have hsq1 : p.negOnePow * p.negOnePow = 1 := by
        rw [← Int.negOnePow_add, Int.negOnePow_even _ ⟨p, rfl⟩]
      simp only [freeCarrierDifferential_fst, freeCarrier_add_fst, freeCarrier_smulA_fst,
        freeCarrier_smulA_snd, freeCarrierDifferential_snd, Units.smul_def, freeCarrier_zsmul_fst,
        unop_op, hτx, hτy, smul_neg, smul_sub, smul_comm (op (d a)), smul_smul,
        ← op_mul, h.sq_eq a, MulOpposite.op_sub, sub_smul, smul_comm (op (a * w)),
        smul_comm (op (w * a)), ← Units.val_mul, hsq1, Units.val_one, one_zsmul]
      abel
    · -- Second component: `x * a - (-1)^{p-1} (y * d a) = x * a + (-1)^p (y * d a)`.
      simp only [freeCarrierDifferential_snd, freeCarrier_add_snd, freeCarrier_smulA_fst,
        freeCarrier_smulA_snd, Units.smul_def, freeCarrier_zsmul_snd, unop_op, hτy, smul_neg,
        sub_neg_eq_add, smul_comm (op (d a))]
  sq_eq z := by
    ext <;> simp [h.map_curvature]

end Carrier

/-! ### The free curved module and its carrier interface -/

variable (h) in
/-- The **free curved differential graded right module** `G⁺(X)` generated by a graded right module
`X`. Its underlying graded `R`-module is `X × X{1}`, its differential sends `(x, y)` to
`(y * w, x)`, and its right `A`-action is twisted by `d` via `koszulTwist 1`. -/
noncomputable def freeObj
    (X : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece) :
    CurvedDGRightModuleCat.{u, u, u} h where
  carrier := FreeCarrier h X
  grading := (freeCarrierGrading h X).piece
  differential := freeCarrierDifferential h X
  isCurvedDGRightModule := isCurvedDGRightModule_freeCarrier h X

variable (X : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece)

/-- The `R`-linear equivalence identifying the underlying `R`-module of `freeObj h X` with
`X × X`. Consumers access coordinates through this equivalence rather than unfolding `freeObj`. -/
noncomputable def freeEquiv : freeObj h X ≃ₗ[R] X × X :=
  freeCarrierEquiv h X

/-- An element of `freeObj h X` is homogeneous of degree `p` exactly when its first coordinate has
degree `p` and its second coordinate has degree `p - 1`. -/
@[simp]
theorem mem_freeObj_grading_iff {p : ℤ} {z : freeObj h X} :
    z ∈ (freeObj h X).grading p ↔
      (freeEquiv (h := h) X z).1 ∈ X.grading.piece p ∧
        (freeEquiv (h := h) X z).2 ∈ X.grading.piece (p - 1) := by
  dsimp only [freeObj, freeEquiv, freeCarrierEquiv, freeCarrierEquivData]
  exact mem_freeCarrierGrading_iff h X

/-- The twisted right `A`-action on `freeObj h X`, expressed in coordinates via `freeEquiv`. -/
@[simp]
theorem freeEquiv_smul (a : Aᵐᵒᵖ) (z : freeObj h X) :
    freeEquiv (h := h) X (a • z) =
      (a • (freeEquiv (h := h) X z).1 -
          op (d a.unop) • X.grading.koszulTwist 1 (freeEquiv (h := h) X z).2,
        a • (freeEquiv (h := h) X z).2) := by
  dsimp only [freeObj, freeEquiv, freeCarrierEquiv, freeCarrierEquivData]
  rfl

/-- The differential on `freeObj h X` sends `(x, y)` to `(y * w, x)`. -/
@[simp]
theorem freeEquiv_differential (z : freeObj h X) :
    freeEquiv (h := h) X ((freeObj h X).differential z) =
      (op w • (freeEquiv (h := h) X z).2, (freeEquiv (h := h) X z).1) := by
  dsimp only [freeObj, freeEquiv, freeCarrierEquiv, freeCarrierEquivData]
  rfl

/-! ### Canonical short exact sequence of graded modules -/

/-- The unit inclusion `X ⟶ toGradedModuleCat (freeObj h X)`, sending `x` to `(x, 0)`. -/
noncomputable def freeUnit : X ⟶ toGradedModuleCat (freeObj h X) :=
  GradedModuleCat.ofHom
    { toFun x := (freeEquiv (h := h) X).symm (x, 0)
      map_add' x₁ x₂ := by
        apply (freeEquiv (h := h) X).injective
        simp
      map_smul' a x := by
        apply (freeEquiv (h := h) X).injective
        rw [LinearEquiv.apply_symm_apply, RingHom.id_apply, freeEquiv_smul]
        simp }
    (LinearMap.isHomogeneous_def.mpr fun p x hx ↦ by
      rw [toGradedModuleCat_piece, mem_freeObj_grading_iff, add_zero]
      simp [hx])

/-- The unit inclusion sends `x` to `(x, 0)` in `freeEquiv` coordinates. -/
@[simp]
theorem freeEquiv_freeUnit_apply (x : X) :
    freeEquiv (h := h) X ((freeUnit (h := h) X).hom x) = (x, 0) :=
  (freeEquiv (h := h) X).apply_symm_apply (x, 0)

/-- The canonical projection `toGradedModuleCat (freeObj h X) ⟶ X{1}`, sending `(x, y)` to `y`. -/
noncomputable def freeProj : toGradedModuleCat (freeObj h X) ⟶ X.shiftObj 1 :=
  GradedModuleCat.ofHom
    { toFun z := (freeEquiv (h := h) X z).2
      map_add' z₁ z₂ := by simp
      map_smul' a z := by
        rw [RingHom.id_apply, freeEquiv_smul] }
    (LinearMap.isHomogeneous_def.mpr fun p z hz ↦ by
      rw [toGradedModuleCat_piece, mem_freeObj_grading_iff] at hz
      simpa [sub_eq_add_neg] using hz.2)

/-- The canonical projection reads the second coordinate in `freeEquiv`. -/
@[simp]
theorem freeProj_apply (z : toGradedModuleCat (freeObj h X)) :
    (freeProj (h := h) X).hom z = (freeEquiv (h := h) X z).2 :=
  (rfl)

/-- The unit inclusion followed by the canonical projection vanishes. -/
@[reassoc (attr := simp)]
theorem freeUnit_comp_freeProj : freeUnit (h := h) X ≫ freeProj (h := h) X = 0 := by
  apply GradedModuleCat.hom_ext
  ext x
  simp only [GradedModuleCat.hom_comp, LinearMap.comp_apply, GradedModuleCat.hom_zero,
    LinearMap.zero_apply]
  rw [freeProj_apply, freeEquiv_freeUnit_apply]

/-- The underlying graded module of `G⁺(X)` sits in a short exact sequence
`0 ⟶ X ⟶ toGradedModuleCat (G⁺(X)) ⟶ X{1} ⟶ 0`. -/
theorem freeShortExact :
    (ShortComplex.mk (freeUnit (h := h) X) (freeProj (h := h) X)
      (freeUnit_comp_freeProj (h := h) X)).ShortExact where
  exact := GradedModuleCat.exact_iff.mpr fun z ↦ by
    dsimp only [ShortComplex.mk]
    constructor
    · intro hz
      refine ⟨(freeEquiv (h := h) X z).1, (freeEquiv (h := h) X).injective ?_⟩
      rw [freeProj_apply] at hz
      rw [freeEquiv_freeUnit_apply]
      exact Prod.ext rfl hz.symm
    · rintro ⟨x, rfl⟩
      rw [freeProj_apply, freeEquiv_freeUnit_apply]
  mono_f := (GradedModuleCat.mono_iff_injective _).mpr fun x₁ x₂ hx ↦ by
    dsimp only [ShortComplex.mk] at hx
    simpa using congrArg (fun z ↦ (freeEquiv (h := h) X z).1) hx
  epi_g := (GradedModuleCat.epi_iff_surjective _).mpr fun y ↦ by
    dsimp only [ShortComplex.mk]
    exact ⟨(freeEquiv (h := h) X).symm (0, y), by rw [freeProj_apply]; simp⟩

/-! ### Universal property and adjunction `G⁺ ⊣ forgetDifferential` -/

section Universal

variable {X} {M : CurvedDGRightModuleCat.{u, u, u} h}

/-- A graded right-linear map `f : X ⟶ toGradedModuleCat M` extends uniquely to a closed morphism
`freeObj h X ⟶ M`, sending `(x, y)` to `f x + dM (f y)`. -/
noncomputable def freeDesc (f : X ⟶ toGradedModuleCat M) :
    ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h X) ⟶
      ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M :=
  let f₀ : X →ₗ[Aᵐᵒᵖ] M := f.hom
  closedHomOf
    { toFun z := f₀ (freeEquiv (h := h) X z).1 + M.differential (f₀ (freeEquiv (h := h) X z).2)
      map_add' z₁ z₂ := by
        simp only [map_add, Prod.fst_add, Prod.snd_add]
        abel
      map_smul' a z := by
        classical
        simp only [freeEquiv_smul, map_sub, map_smul, RingHom.id_apply, smul_add]
        -- Expand `M.differential (a • f₀ y)` via the right Leibniz rule on homogeneous pieces.
        set y : X := (freeEquiv (h := h) X z).2
        have hleib : M.differential (a • f₀ y) =
            a • M.differential (f₀ y) +
              op (d a.unop) • f₀ (X.grading.koszulTwist 1 y) := by
          rw [← DirectSum.sum_support_decompose X.grading.piece y]
          simp only [Finset.smul_sum, map_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun q _ ↦ ?_
          set yq : X := (DirectSum.decompose X.grading.piece y q : X)
          have hyq : yq ∈ X.grading.piece q := (DirectSum.decompose X.grading.piece y q).2
          have hfyq : f₀ yq ∈ M.grading q := by
            simpa only [toGradedModuleCat_piece, add_zero] using f.isHomogeneous.map_mem hyq
          conv_lhs => rw [← op_unop a, M.isCurvedDGRightModule.leibniz hfyq a.unop]
          rw [op_unop, X.grading.koszulTwist_one_apply_of_mem hyq, Int.cast_smul_eq_zsmul R,
            map_zsmul, smul_comm (op (d a.unop)), Units.smul_def]
        rw [hleib]
        abel }
    (fun p z hz ↦ by
      rw [mem_freeObj_grading_iff] at hz
      have h1 : f₀ (freeEquiv (h := h) X z).1 ∈ M.grading p := by
        simpa only [toGradedModuleCat_piece, add_zero] using f.isHomogeneous.map_mem hz.1
      have h2 : f₀ (freeEquiv (h := h) X z).2 ∈ M.grading (p - 1) := by
        simpa only [toGradedModuleCat_piece, add_zero] using f.isHomogeneous.map_mem hz.2
      refine (M.grading p).add_mem h1 ?_
      convert M.isCurvedDGRightModule.isHomogeneous.map_mem h2 using 2
      omega)
    (fun z ↦ by
      -- Expose the underlying linear map formula before rewriting by `freeEquiv_differential`.
      change M.differential (f₀ (freeEquiv (h := h) X z).1 +
          M.differential (f₀ (freeEquiv (h := h) X z).2)) =
        f₀ (freeEquiv (h := h) X ((freeObj h X).differential z)).1 +
          M.differential (f₀ (freeEquiv (h := h) X ((freeObj h X).differential z)).2)
      rw [freeEquiv_differential, map_add, M.isCurvedDGRightModule.sq_eq, map_smul, add_comm])

/-- On elements, `freeDesc f` sends `(x, y)` to `f x + dM (f y)`. -/
@[simp]
theorem closedHom_freeDesc_apply (f : X ⟶ toGradedModuleCat M) (z : freeObj h X) :
    closedHom (freeDesc f) z =
      HAdd.hAdd (α := M) (β := M) (f.hom (freeEquiv (h := h) X z).1)
        (M.differential (f.hom (freeEquiv (h := h) X z).2)) := by
  dsimp only [freeDesc]
  rw [closedHom_closedHomOf]
  rfl

/-- Restricting `freeDesc f` along the unit inclusion recovers `f`. -/
@[simp]
theorem freeUnit_comp_forgetDifferential_map_freeDesc (f : X ⟶ toGradedModuleCat M) :
    freeUnit (h := h) X ≫ (forgetDifferential (h := h)).map (freeDesc f) = f := by
  apply GradedModuleCat.hom_ext
  ext x
  simp only [GradedModuleCat.hom_comp, LinearMap.comp_apply, forgetDifferential_map_hom]
  rw [closedHom_freeDesc_apply, freeEquiv_freeUnit_apply]
  simp

/-- Every closed morphism out of `freeObj h X` is the extension of its restriction along the
unit inclusion. -/
theorem freeDesc_freeUnit_comp
    (g : ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h X) ⟶
      ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M) :
    freeDesc (freeUnit (h := h) X ≫ (forgetDifferential (h := h)).map g) = g := by
  apply closedHom_ext
  intro z
  have hz : z = (freeEquiv (h := h) X).symm ((freeEquiv (h := h) X z).1, 0) +
      (freeObj h X).differential
        ((freeEquiv (h := h) X).symm ((freeEquiv (h := h) X z).2, 0)) := by
    apply (freeEquiv (h := h) X).injective
    simp
  rw [closedHom_freeDesc_apply]
  conv_rhs => rw [hz]
  have hunit (x : X) : (freeUnit (h := h) X).hom x = (freeEquiv (h := h) X).symm (x, 0) :=
    (freeEquiv (h := h) X).injective (by simp)
  simp only [GradedModuleCat.hom_comp, LinearMap.comp_apply, forgetDifferential_map_hom, map_add,
    hunit]
  rw [differential_closedHom]

/-- Closed morphisms out of `freeObj h X` into `M` correspond naturally to graded right-linear maps
`X ⟶ toGradedModuleCat M`. -/
noncomputable def freeHomEquiv
    (X : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece)
    (M : ForgetEnrichment (CochainComplex (ModuleCat R) ℤ) (CurvedDGRightModuleCat.{u, u, u} h)) :
    (ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h X) ⟶ M) ≃
      (X ⟶ (forgetDifferential (h := h)).obj M) where
  toFun g := freeUnit (h := h) X ≫ (forgetDifferential (h := h)).map g
  invFun f := freeDesc f
  left_inv g := freeDesc_freeUnit_comp g
  right_inv f := freeUnit_comp_forgetDifferential_map_freeDesc f

/-- The forward direction of `freeHomEquiv` restricts along `freeUnit`. -/
@[simp]
theorem freeHomEquiv_apply
    (X : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece)
    (M : ForgetEnrichment (CochainComplex (ModuleCat R) ℤ) (CurvedDGRightModuleCat.{u, u, u} h))
    (g : ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h X) ⟶ M) :
    freeHomEquiv X M g = freeUnit (h := h) X ≫ (forgetDifferential (h := h)).map g :=
  (rfl)

/-- The inverse direction of `freeHomEquiv` extends via `freeDesc`. -/
@[simp]
theorem freeHomEquiv_symm_apply
    (X : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece)
    (M : ForgetEnrichment (CochainComplex (ModuleCat R) ℤ) (CurvedDGRightModuleCat.{u, u, u} h))
    (f : X ⟶ (forgetDifferential (h := h)).obj M) :
    (freeHomEquiv X M).symm f = freeDesc f :=
  (rfl)

end Universal

variable (h) in
/-- The **free curved module functor** `G⁺`, left adjoint to `forgetDifferential`. -/
@[expose, implicit_reducible]
noncomputable def freeFunctor :
    GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece ⥤
      ForgetEnrichment (CochainComplex (ModuleCat R) ℤ) (CurvedDGRightModuleCat.{u, u, u} h) where
  obj X := ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h X)
  map f := freeDesc (f ≫ freeUnit (h := h) _)
  map_id X := by
    apply closedHom_ext
    intro z
    apply (freeEquiv (h := h) X).injective
    simp
  map_comp f g := by
    apply closedHom_ext
    intro z
    apply (freeEquiv (h := h) _).injective
    simp

/-- On objects, `freeFunctor h` sends `X` to `freeObj h X`. -/
@[simp]
theorem freeFunctor_obj
    (X : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece) :
    (freeFunctor h).obj X = ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) (freeObj h X) :=
  (rfl)

/-- On morphisms, `freeFunctor h` sends `f : X ⟶ Y` to `freeDesc (f ≫ freeUnit Y)`. -/
@[simp]
theorem freeFunctor_map
    {X Y : GradedModuleCat.{u} (InternalGrading.ofDecomposition 𝒜).opposite.piece} (f : X ⟶ Y) :
    (freeFunctor h).map f = freeDesc (f ≫ freeUnit (h := h) Y) :=
  (rfl)

/-- The free curved module functor `G⁺` is left adjoint to `forgetDifferential`. -/
noncomputable def freeForgetAdjunction :
    freeFunctor h ⊣ forgetDifferential (h := h) :=
  Adjunction.mkOfHomEquiv
    { homEquiv := fun X M ↦ freeHomEquiv X M
      homEquiv_naturality_left_symm := fun {X Y M} f g ↦ by
        apply closedHom_ext
        intro z
        simp only [freeHomEquiv_symm_apply, closedHom_comp, LinearMap.comp_apply,
          freeFunctor]
        rw [closedHom_freeDesc_apply, closedHom_freeDesc_apply, closedHom_freeDesc_apply]
        simp only [GradedModuleCat.hom_comp, LinearMap.comp_apply, map_add,
          freeEquiv_freeUnit_apply, freeEquiv_differential, Prod.fst_add, Prod.snd_add,
          smul_zero, add_zero, zero_add]
      homEquiv_naturality_right := fun {X M N} g k ↦ by
        dsimp only [freeFunctor]
        simp [freeHomEquiv_apply, Category.assoc] }

/-! ### Contractibility, graded-projectivity, and covers -/

/-- Every free curved module `G⁺(X)` is contractible, hence zero in the curved homotopy category,
via the degree-minus-one right-linear homotopy `(x, y) ↦ (y, 0)`. -/
theorem isZero_homotopy_freeObj :
    IsZero (DGHomotopyCategory.of R (freeObj h X)) := by
  rw [isZero_homotopy_iff_exists_contraction]
  let k : freeObj h X →ₗ[Aᵐᵒᵖ] freeObj h X :=
    { toFun z := (freeEquiv (h := h) X).symm ((freeEquiv (h := h) X z).2, 0)
      map_add' z₁ z₂ := by
        apply (freeEquiv (h := h) X).injective
        simp
      map_smul' a z := by
        apply (freeEquiv (h := h) X).injective
        simp }
  refine ⟨⟨k, dgRightModuleCochains.mem_iff.mpr (LinearMap.isHomogeneous_def.mpr fun p z hz ↦ ?_)⟩,
    fun z ↦ ?_⟩
  · rw [mem_freeObj_grading_iff] at hz ⊢
    simpa [k, sub_eq_add_neg] using hz.2
  · apply (freeEquiv (h := h) X).injective
    simp [k]

/-- If `X` is a projective graded right module, then the free curved module `G⁺(X)` is
graded-projective. -/
instance projective_toGradedModuleCat_freeObj [Projective X] :
    Projective (toGradedModuleCat (freeObj h X)) := by
  have hS := freeShortExact (h := h) X
  have : Projective (X.shiftObj 1) := GradedModuleCat.projective_shiftObj X 1
  let s := hS.splittingOfProjective
  refine ⟨fun {E Y} f e _ ↦ ⟨s.r ≫ Projective.factorThru (freeUnit (h := h) X ≫ f) e +
    freeProj (h := h) X ≫ Projective.factorThru (s.s ≫ f) e, ?_⟩⟩
  calc
    (s.r ≫ Projective.factorThru (freeUnit (h := h) X ≫ f) e +
        freeProj (h := h) X ≫ Projective.factorThru (s.s ≫ f) e) ≫ e
      = (s.r ≫ freeUnit (h := h) X + freeProj (h := h) X ≫ s.s) ≫ f := by
        simp only [Preadditive.add_comp, Category.assoc, Projective.factorThru_comp]
    _ = f := by
        rw [s.id, Category.id_comp]

/-- Every curved right module admits a surjective closed morphism from a graded-projective
curved right module. -/
theorem exists_gradedProjective_surjective (M : CurvedDGRightModuleCat.{u, u, u} h) :
    ∃ (P : CurvedDGRightModuleCat.{u, u, u} h)
      (p : ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) P ⟶
        ForgetEnrichment.of (CochainComplex (ModuleCat R) ℤ) M),
      Projective (toGradedModuleCat P) ∧ Function.Surjective (closedHom p) := by
  let X := Projective.over (toGradedModuleCat M)
  let π : X ⟶ toGradedModuleCat M := Projective.π (toGradedModuleCat M)
  refine ⟨freeObj h X, freeDesc π, inferInstance, fun y ↦ ?_⟩
  obtain ⟨x, hx⟩ := (GradedModuleCat.epi_iff_surjective π).mp inferInstance y
  refine ⟨(freeEquiv (h := h) X).symm (x, 0), ?_⟩
  simp [hx]

end TauCeti.CurvedDGRightModuleCat
