/-!
# Monomorphic quasi-isomorphisms are generated by small ones

Let `C` be a Grothendieck abelian category. For a cardinal `κ`, let
`CochainComplex.monoQuasiIsoOfCardinalLT κ` be the class of monomorphisms of unbounded cochain
complexes in `C` that are quasi-isomorphisms and whose target has fewer than `κ` subobjects. For
all sufficiently large `κ`, every monomorphic quasi-isomorphism is a transfinite composition of
pushouts of morphisms in this class
(`CochainComplex.exists_transfiniteCompositionOfShape_monoQuasiIsoOfCardinalLT`). Hence a
morphism has the right lifting property with respect to all monomorphic quasi-isomorphisms as
soon as it has it with respect to the small ones
(`CochainComplex.exists_rlp_monoQuasiIsoOfCardinalLT_eq`), and a complex is a K-injective
complex of injective objects exactly when its morphism to zero has the right lifting property
with respect to the small monomorphic quasi-isomorphisms
(`CochainComplex.exists_rlp_monoQuasiIsoOfCardinalLT_iff_of_isZero`).

In the injective model structure on unbounded complexes these morphisms play the role of
generating trivial cofibrations: the small object argument applied to them is the standard route
to a monomorphic quasi-isomorphism from any complex into a K-injective complex of injectives.

The key step enlarges a proper subcomplex `A` of a complex `M` with acyclic quotient `M / A`.
A nonzero acyclic subcomplex `N` of `M / A` with terms of bounded size exists by
`CategoryTheory.IsSeparator.exists_bounded_nonzero_acyclic_subcomplex`. Its terms are lifted
along `M ⟶ M / A` by families of morphisms out of coproducts of copies of a separator, which
define a morphism `ψ` from a free complex of bounded size (`CochainComplex.free`) to `M`. The
pushout of `A ⟵ A ×_M F ⟶ F` along `ψ` is then a subcomplex of `M` strictly containing `A`, and
the morphism `A ×_M F ⟶ F` is a monomorphic quasi-isomorphism because its cokernel is `N`.
Iterating transfinitely
(`CategoryTheory.IsGrothendieckAbelian.IsEnlargeable.exists_transfiniteCompositionOfShape`)
exhausts `M`, since quasi-isomorphisms are stable under filtered colimits.

## References

* [Stacks: Lemma 079L](https://stacks.math.columbia.edu/tag/079L) and
  [Stacks: Theorem 079P](https://stacks.math.columbia.edu/tag/079P).
* J. Lurie, *Higher Algebra*, Proposition 1.3.5.3.
* The proof of `CategoryTheory.IsGrothendieckAbelian.generatingMonomorphisms_rlp` in Mathlib's
  `Mathlib.CategoryTheory.Abelian.GrothendieckCategory.EnoughInjectives`, by Joël Riou, which
  is followed for the passage from enlargements to lifting properties.
-/

public section

universe w v u

open CategoryTheory Limits MorphismProperty

namespace CochainComplex

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- The monomorphisms of cochain complexes that are quasi-isomorphisms and whose target has
fewer than `κ` subobjects. -/
def monoQuasiIsoOfCardinalLT (κ : Cardinal.{w}) : MorphismProperty (CochainComplex C ℤ) :=
  fun _ L f ↦ Mono f ∧ QuasiIso f ∧ HasCardinalLT (Subobject L) κ

lemma monoQuasiIsoOfCardinalLT_iff {κ : Cardinal.{w}} {K L : CochainComplex C ℤ} (f : K ⟶ L) :
    monoQuasiIsoOfCardinalLT κ f ↔ Mono f ∧ QuasiIso f ∧ HasCardinalLT (Subobject L) κ :=
  Iff.rfl

lemma monoQuasiIsoOfCardinalLT_le (κ : Cardinal.{w}) :
    monoQuasiIsoOfCardinalLT.{w} (C := C) κ ≤
      monomorphisms _ ⊓ HomologicalComplex.quasiIso C (.up ℤ) :=
  fun _ _ _ h ↦ ⟨h.1, h.2.1⟩

variable [IsGrothendieckAbelian.{w} C]

namespace MonoQuasiIso

variable (G : C) (B : ℕ → C)

/-- The coproduct of copies of `G` indexed by the subobjects of `B j`. Morphisms out of it lift
quotients of `B j` along epimorphisms. -/
private noncomputable abbrev gen (j : ℕ) : C :=
  ∐ fun _ : Shrink.{w} (Subobject (B j)) ↦ G

variable {G B}

/-- If the terms of a subcomplex `N` of the target of an epimorphism `π : M ⟶ Q` are quotients of
objects `B j`, there is a free complex with terms built from coproducts of copies of a separator
`G`, mapping to `M` and epimorphically onto `N`, compatibly with `π`. -/
private lemma exists_free_lift (hG : IsSeparator G) {M Q N : CochainComplex C ℤ} (π : M ⟶ Q)
    [Epi π] (ι : N ⟶ Q) (hN : ∀ m, ∃ (j : ℕ) (q : B j ⟶ N.X m), Epi q) :
    ∃ (j : ℤ → ℕ) (ψ : free (fun n ↦ gen G B (j n)) ⟶ M)
      (e : free (fun n ↦ gen G B (j n)) ⟶ N), Epi e ∧ ψ ≫ π = e ≫ ι := by
  choose j q hq using hN
  choose g e he hge using fun n ↦
    hG.exists_sigma_lift (q n) (π.f n) (ι.f n) _ (equivShrink.{w} _).symm.surjective
  refine ⟨j, free.desc g, free.desc e,
    HomologicalComplex.epi_of_epi_f _ fun n ↦ epi_of_epi_fac (free.ι_desc_f e n), ?_⟩
  ext n
  simp [hge]

variable (G B) in
/-- The type indexing the families of subobjects of the terms of the free complexes in
`exists_free_lift`. When it has fewer than `κ` elements, these complexes have fewer than `κ`
subobjects. -/
private abbrev SubobjectFamilies : Type _ :=
  ℤ → Σ j : ℕ × ℕ, Subobject (gen G B j.1 ⊞ gen G B j.2)

private lemma hasCardinalLT_subobject_free {κ : Cardinal.{w}}
    (hκ : HasCardinalLT (SubobjectFamilies G B) κ) (j : ℤ → ℕ) :
    HasCardinalLT (Subobject (free (fun n ↦ gen G B (j n)))) κ :=
  HomologicalComplex.hasCardinalLT_subobject _ (hκ.of_injective
    (fun S n ↦ ⟨(j n, j (n - 1)), cast (congrArg (fun Y : C ↦ Subobject Y) (free_X _ n)) (S n)⟩)
    fun _ _ h ↦ funext fun n ↦ (cast_inj _).1 (eq_of_heq (Sigma.mk.inj_iff.1 (congrFun h n)).2))

omit [IsGrothendieckAbelian.{w} C] in
/-- The cokernel of the base change `A ×_M F ⟶ F` of a monomorphism `p : A ⟶ M` along
`ψ : F ⟶ M` is the image of `F` in the cokernel of `p`: if `ψ` followed by the projection to the
cokernel of `p` is `e ≫ ι` with `e` an epimorphism and `ι` a monomorphism, the cokernel of
`A ×_M F ⟶ F` is isomorphic to the source `N` of `ι`, hence acyclic when `N` is. -/
private lemma acyclic_cokernel_pullback_snd {A M F N : CochainComplex C ℤ} (p : A ⟶ M)
    (ψ : F ⟶ M) (e : F ⟶ N) [Epi e] (ι : N ⟶ cokernel p) [Mono ι]
    (hψ : ψ ≫ cokernel.π p = e ≫ ι) (hN : N.Acyclic) :
    (cokernel (pullback.snd p ψ)).Acyclic := by
  let u : cokernel (pullback.snd p ψ) ⟶ N := cokernel.desc _ e (by
    rw [← cancel_mono ι, Category.assoc, ← hψ, ← pullback.condition_assoc, cokernel.condition,
      comp_zero, zero_comp])
  have hu : u ≫ ι = cokernel.map _ _ _ _ (IsPullback.of_hasPullback p ψ).flip.w := by
    rw [← cancel_epi (cokernel.π (pullback.snd p ψ))]
    simp [u, hψ]
  have : Mono (u ≫ ι) := by
    rw [hu]
    exact Abelian.mono_cokernel_map_of_isPullback (IsPullback.of_hasPullback p ψ).flip
  have : Mono u := mono_of_mono u ι
  have : Epi u := epi_of_epi_fac (cokernel.π_desc _ e _)
  have : IsIso u := isIso_of_mono_of_epi u
  exact fun n ↦ (hN n).of_iso (asIso u).symm

/-- **The enlargement step.** A monomorphic quasi-isomorphism `p : A ⟶ M` that is not an
isomorphism factors as a pushout `i : A ⟶ A'` of a monomorphic quasi-isomorphism with target
a free complex of bounded size, which is not an isomorphism, followed by a monomorphism
`A' ⟶ M`. -/
private lemma exists_pushouts (hG : IsSeparator G)
    (hB : ∀ (M : CochainComplex C ℤ), M.Acyclic → ¬ IsZero M →
      ∃ (N : CochainComplex C ℤ) (i : N ⟶ M) (_ : Mono i) (n : ℤ),
        ¬ IsZero N ∧ N.Acyclic ∧ N.IsStrictlyLE n ∧ ∀ m, ∃ (j : ℕ) (p : B j ⟶ N.X m), Epi p)
    {κ : Cardinal.{w}} (hκ : HasCardinalLT (SubobjectFamilies G B) κ)
    {A M : CochainComplex C ℤ} (p : A ⟶ M) [Mono p] [QuasiIso p] (hp : ¬ IsIso p) :
    ∃ (A' : CochainComplex C ℤ) (i : A ⟶ A') (p' : A' ⟶ M),
      (monoQuasiIsoOfCardinalLT κ).pushouts i ∧ ¬ IsIso i ∧ Mono p' ∧ i ≫ p' = p := by
  have hQ : (cokernel p).Acyclic := (TauCeti.cokernelSequence_shortExact p).quasiIso_f_iff.1 ‹_›
  have hQ' : ¬ IsZero (cokernel p) := fun h ↦ hp (by
    have : Epi p := Preadditive.epi_of_cokernel_zero (h.eq_of_tgt _ _)
    exact isIso_of_mono_of_epi p)
  obtain ⟨N, ι, _, -, hNz, hN, -, hNB⟩ := hB _ hQ hQ'
  obtain ⟨j, ψ, e, _, hψ⟩ := exists_free_lift hG (cokernel.π p) ι hNB
  have hS : monoQuasiIsoOfCardinalLT κ (pullback.snd p ψ) :=
    ⟨(inferInstance : Mono (pullback.snd p ψ)),
      (TauCeti.cokernelSequence_shortExact (pullback.snd p ψ)).quasiIso_f_iff.2
      (acyclic_cokernel_pullback_snd p ψ e ι hψ hN), hasCardinalLT_subobject_free hκ j⟩
  refine ⟨pushout (pullback.fst p ψ) (pullback.snd p ψ), pushout.inl _ _,
    pushout.desc p ψ pullback.condition,
    ⟨_, _, _, _, _, hS, IsPushout.of_hasPushout _ _⟩, fun hi ↦ hNz ?_,
    (IsPushout.of_hasPushout _ _).mono_of_isPullback_of_mono (IsPullback.of_hasPullback p ψ) _
      (pushout.inl_desc _ _ _) (pushout.inr_desc _ _ _), pushout.inl_desc _ _ _⟩
  -- If the pushout of `A ×_M F ⟶ F` were an isomorphism, `ψ` would factor through `p`, so the
  -- image `N` of `F` in the cokernel of `p` would vanish.
  have hψ' : ψ = (pushout.inr _ _ ≫ inv (pushout.inl (pullback.fst p ψ) (pullback.snd p ψ))) ≫
      p := by
    refine Eq.trans ?_ (congrArg _ (pushout.inl_desc p ψ pullback.condition))
    rw [Category.assoc, IsIso.inv_hom_id_assoc, pushout.inr_desc]
  refine IsZero.of_mono_eq_zero ι ((cancel_epi e).1 ?_)
  rw [← hψ, hψ', Category.assoc, cokernel.condition, comp_zero, comp_zero]

/-- The subcomplexes of `M` included by a quasi-isomorphism can be enlarged transfinitely, along
pushouts of monomorphic quasi-isomorphisms with small target, until they exhaust `M`. -/
private lemma isEnlargeable (hG : IsSeparator G)
    (hB : ∀ (M : CochainComplex C ℤ), M.Acyclic → ¬ IsZero M →
      ∃ (N : CochainComplex C ℤ) (i : N ⟶ M) (_ : Mono i) (n : ℤ),
        ¬ IsZero N ∧ N.Acyclic ∧ N.IsStrictlyLE n ∧ ∀ m, ∃ (j : ℕ) (p : B j ⟶ N.X m), Epi p)
    {κ : Cardinal.{w}} (hκ : HasCardinalLT (SubobjectFamilies G B) κ) (M : CochainComplex C ℤ) :
    IsGrothendieckAbelian.IsEnlargeable (monoQuasiIsoOfCardinalLT.{w} κ).pushouts
      (fun A : Subobject M ↦ QuasiIso A.arrow) where
  exists_lt A hA hA' := by
    obtain ⟨A', i, p', hi, hi', _, fac⟩ := exists_pushouts hG hB hκ A.arrow
      (by rwa [Subobject.isIso_arrow_iff_eq_top])
    have : QuasiIso i := (pushouts_le_iff.2 (monoQuasiIsoOfCardinalLT_le κ) _ hi).2
    have : QuasiIso (i ≫ p') := by rwa [fac]
    have : QuasiIso p' := quasiIso_of_comp_left i p'
    have hlt : A < Subobject.mk p' := by simpa using Subobject.mk_lt_mk_of_comm i fac hi'
    refine ⟨Subobject.mk p', hlt, ?_, (MorphismProperty.arrow_mk_iso_iff _
      (Arrow.isoMk (Iso.refl _) (Subobject.underlyingIso p').symm ?_ :
        Arrow.mk i ≅ Arrow.mk (Subobject.ofLE A _ hlt.le))).1 hi⟩
    · rw [← Subobject.underlyingIso_hom_comp_eq_mk]
      infer_instance
    · simp [← cancel_mono (Subobject.mk p').arrow, fac]
  top := inferInstance
  iSup A hA hQ := HomologicalComplex.quasiIso_iSup_arrow A hA hQ

end MonoQuasiIso

open MonoQuasiIso in
/-- For all sufficiently large cardinals `κ`, every monomorphic quasi-isomorphism of cochain
complexes over a Grothendieck abelian category is a transfinite composition of pushouts of
monomorphic quasi-isomorphisms whose targets have fewer than `κ` subobjects. -/
theorem exists_transfiniteCompositionOfShape_monoQuasiIsoOfCardinalLT :
    ∃ κ₀ : Cardinal.{w}, ∀ κ : Cardinal.{w}, κ₀ < κ →
      ∀ {K L : CochainComplex C ℤ} (f : K ⟶ L) [Mono f] [QuasiIso f],
        ∃ (J : Type w) (_ : LinearOrder J) (_ : OrderBot J) (_ : SuccOrder J)
          (_ : WellFoundedLT J),
          Nonempty (MorphismProperty.TransfiniteCompositionOfShape
            (monoQuasiIsoOfCardinalLT (C := C) κ).pushouts J f) := by
  obtain ⟨B, hB⟩ := (isSeparator_separator C).exists_bounded_nonzero_acyclic_subcomplex
  refine ⟨Cardinal.mk (Shrink.{w} (SubobjectFamilies (separator C) B)),
    fun κ hκ K L f _ _ ↦ ?_⟩
  have hκ' : HasCardinalLT (SubobjectFamilies (separator C) B) κ :=
    ((hasCardinalLT_iff_cardinal_mk_lt _ _).2 hκ).of_injective _ (equivShrink _).injective
  refine (isEnlargeable (isSeparator_separator C) hB hκ' L).exists_transfiniteCompositionOfShape
    f ?_
  rw [← Subobject.underlyingIso_hom_comp_eq_mk]
  infer_instance

/-- For all sufficiently large cardinals `κ`, a morphism of cochain complexes over a Grothendieck
abelian category has the right lifting property with respect to all monomorphic
quasi-isomorphisms if and only if it has it with respect to those whose targets have fewer than
`κ` subobjects. -/
theorem exists_rlp_monoQuasiIsoOfCardinalLT_eq :
    ∃ κ₀ : Cardinal.{w}, ∀ κ : Cardinal.{w}, κ₀ < κ →
      (monoQuasiIsoOfCardinalLT (C := C) κ).rlp =
        (monomorphisms _ ⊓ HomologicalComplex.quasiIso C (.up ℤ)).rlp := by
  obtain ⟨κ₀, h⟩ := exists_transfiniteCompositionOfShape_monoQuasiIsoOfCardinalLT.{w} (C := C)
  refine ⟨κ₀, fun κ hκ ↦ le_antisymm ?_ (antitone_rlp (monoQuasiIsoOfCardinalLT_le κ))⟩
  intro X Y p hp A B i hi
  have : Mono i := hi.1
  have : QuasiIso i := hi.2
  obtain ⟨J, _, _, _, _, ⟨t⟩⟩ := h κ hκ i
  exact transfiniteCompositionsOfShape_le_llp_rlp _ _ _ t.mem _ (by simpa)

/-- For all sufficiently large cardinals `κ`, a cochain complex `I` over a Grothendieck abelian
category is a K-injective complex of injective objects if and only if its morphism to a zero
complex has the right lifting property with respect to the monomorphic quasi-isomorphisms whose
targets have fewer than `κ` subobjects. -/
theorem exists_rlp_monoQuasiIsoOfCardinalLT_iff_of_isZero :
    ∃ κ₀ : Cardinal.{w}, ∀ κ : Cardinal.{w}, κ₀ < κ →
      ∀ {I Z : CochainComplex C ℤ} (p : I ⟶ Z), IsZero Z →
        ((monoQuasiIsoOfCardinalLT κ).rlp p ↔ (∀ n, Injective (I.X n)) ∧ I.IsKInjective) := by
  obtain ⟨κ₀, h⟩ := exists_rlp_monoQuasiIsoOfCardinalLT_eq.{w} (C := C)
  exact ⟨κ₀, fun κ hκ I Z p hZ ↦ by
    rw [h κ hκ, rlp_monomorphisms_inf_quasiIso_iff_of_isZero p hZ]⟩

end CochainComplex
