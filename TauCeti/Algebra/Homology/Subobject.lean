module

public import Mathlib.Algebra.Homology.QuasiIso
public import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex
public import Mathlib.CategoryTheory.Subobject.Lattice
public import Mathlib.Algebra.Category.ModuleCat.Basic
import Mathlib.Algebra.Category.ModuleCat.EpiMono

/-!
# Homology of subcomplexes

The bottom subobject of a homological complex and the quotient by its top subobject have
vanishing homology. These facts apply to any complex shape, assuming only that the homology
in the requested degree exists. They supply the vanishing conditions at the ends of a finite
filtration.

We also record how quasi-isomorphisms interact with subobjects: the inclusion of
`Subobject.mk f` is a quasi-isomorphism exactly when `f` is, and the inclusion of a subcomplex
`A ≤ B` is a quasi-isomorphism when the inclusions of `A` and `B` are.

filtration. For complexes of modules, the arrow of the subobject generated by a
monomorphism has the same degreewise range as the monomorphism.
-/

public section

open CategoryTheory Limits

namespace CategoryTheory.Subobject

universe u

section

variable {C ι : Type*} [Category* C] [HasZeroMorphisms C] {c : ComplexShape ι}
  {K : HomologicalComplex C c}

/-- The bottom subcomplex has vanishing homology. -/
lemma isZero_homology_of_eq_bot [HasZeroObject C] (S : Subobject K) (hS : S = ⊥)
    (i : ι) [(S : HomologicalComplex C c).HasHomology i] :
    IsZero ((S : HomologicalComplex C c).homology i) := by
  apply HomologicalComplex.ExactAt.isZero_homology
  apply HomologicalComplex.acyclic_of_isZero
  rw [hS]
  exact IsZero.of_iso (isZero_zero _) botCoeIsoZero

/-- The quotient by the top subcomplex has vanishing homology. -/
lemma isZero_homology_cokernel_of_eq_top (S : Subobject K) (hS : S = ⊤)
    [HasCokernel S.arrow] (i : ι) [(cokernel S.arrow).HasHomology i] :
    IsZero ((cokernel S.arrow).homology i) := by
  have : IsIso S.arrow := by rw [hS]; infer_instance
  exact (HomologicalComplex.acyclic_of_isZero _ (isZero_cokernel_of_epi _) i).isZero_homology

section QuasiIso

variable [∀ i, K.HasHomology i]

/-- The inclusion of `Subobject.mk f` is a quasi-isomorphism exactly when `f` is. -/
lemma quasiIso_mk_arrow_iff {A : HomologicalComplex C c} (f : A ⟶ K) [Mono f]
    [∀ i, A.HasHomology i] [∀ i, (Subobject.mk f : HomologicalComplex C c).HasHomology i] :
    QuasiIso (Subobject.mk f).arrow ↔ QuasiIso f := by
  rw [← underlyingIso_hom_comp_eq_mk, quasiIso_iff_comp_left]

/-- If the inclusions of subcomplexes `A ≤ B` are quasi-isomorphisms, then so is the inclusion
`A ⟶ B`. -/
lemma quasiIso_ofLE {A B : Subobject K} (h : A ≤ B)
    [∀ i, (A : HomologicalComplex C c).HasHomology i]
    [∀ i, (B : HomologicalComplex C c).HasHomology i] (hA : QuasiIso A.arrow)
    (hB : QuasiIso B.arrow) : QuasiIso (ofLE A B h) := by
  have : QuasiIso (ofLE A B h ≫ B.arrow) := by
    rw [ofLE_arrow]
    infer_instance
  exact quasiIso_of_comp_right _ B.arrow

end QuasiIso

end

/-- In each degree, the arrow of the subobject generated by a monomorphism of complexes of
modules has the same range as the monomorphism itself. -/
theorem range_mk_arrow_f_hom {S : Type*} [Ring S] {ι : Type*} {c : ComplexShape ι}
    {K L : HomologicalComplex (ModuleCat.{u} S) c} (i : K ⟶ L) [Mono i] (n : ι) :
    LinearMap.range ((Subobject.mk i).arrow.f n).hom = LinearMap.range (i.f n).hom := by
  rw [← underlyingIso_hom_comp_eq_mk, HomologicalComplex.comp_f, ModuleCat.hom_comp,
    LinearMap.range_comp_of_range_eq_top _ (ModuleCat.range_eq_top_of_epi _)]

end CategoryTheory.Subobject
