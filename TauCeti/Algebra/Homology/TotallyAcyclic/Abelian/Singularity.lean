/-!
# Gorenstein-projective objects in the singularity category

Let `C` be an abelian category, `G` a Gorenstein-projective object of `C` and `Y` any object of
`C`. The map `Hom_C(G, Y) ⟶ Hom_{D_sg(C)}(G, Y)` induced by the singularity category
`D_sg(C) = Dᵇ(C) / Perf(C)` is surjective, and its kernel consists of the morphisms factoring
through a projective object. Hence the functor from the stable category of Gorenstein-projective
objects to the singularity category is fully faithful (X.-W. Chen).

Let `P` be a complete resolution of `G = Z⁰`, with cycles `Zᵐ`. The short exact sequences
`0 ⟶ Zᵐ ⟶ Pᵐ ⟶ Zᵐ⁺¹ ⟶ 0` give morphisms `Zᵐ⁺¹[-m-1] ⟶ Zᵐ[-m]` in the bounded derived category
whose cones `Pᵐ[-m]` are perfect, and their composites `δₘ : Zᵐ[-m] ⟶ G`. Every morphism from
`G` to a perfect object `K` is killed by `δₘ` for `m` large, since `Hom(Zᵐ[-m], K) = 0` for `m`
large: this holds for `K` a projective object in degree zero because the cycles have no higher
extensions by projectives, and passes to the thick subcategory generated by these objects. By the
calculus of fractions of the Verdier quotient, every morphism `G ⟶ Y` of `D_sg(C)` then comes from
a morphism `Zᵐ[-m] ⟶ Y`, and every morphism `G ⟶ Y` vanishing in `D_sg(C)` is killed by some
`δₘ`. Finally `Ext^{>0}(Pᵐ, Y) = 0` lets morphisms `Zᵐ[-m] ⟶ Y` extend along `δₘ`, and lets the
vanishing of `δₘ ≫ f` descend to `δ₁ ≫ f = 0`, which says that `f` factors through `G ⟶ P⁰`.

## Main definitions

* `CategoryTheory.GorensteinProjective.toSingularityCategory`: the functor from the stable
  category of Gorenstein-projective objects to the singularity category.

## Main results

* `TauCeti.SingularityCategory.map_surjective_of_isGorensteinProjective`: for `G`
  Gorenstein-projective, every morphism `G ⟶ Y` of the singularity category comes from `C`.
* `TauCeti.SingularityCategory.map_eq_zero_iff_of_isGorensteinProjective`: a morphism `G ⟶ Y` of
  `C` vanishes in the singularity category if and only if it factors through a projective object.
* `CategoryTheory.GorensteinProjective.fullyFaithfulToSingularityCategory`: **Chen's theorem**,
  the functor from the stable category of Gorenstein-projective objects to the singularity
  category is fully faithful.

## References

* Xiao-Wu Chen, *Relative singularity categories and Gorenstein-projective modules*, Math. Nachr.
  **284** (2011), 199–212.
* Ragnar-Olaf Buchweitz, *Maximal Cohen–Macaulay Modules and Tate Cohomology*, Mathematical
  Surveys and Monographs **262**, American Mathematical Society (2021), Section 4.4.
-/

public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated CategoryTheory.Abelian
  ZeroObject TauCeti

universe w' w v u

namespace DerivedCategory

variable {C : Type u} [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

/-- A triangle transported along isomorphisms of its vertices is distinguished. -/
private lemma distinguished_of_iso {T : Triangle (DerivedCategory C)} (hT : T ∈ distTriang _)
    {A₁ A₂ A₃ : DerivedCategory C} (e₁ : T.obj₁ ≅ A₁) (e₂ : T.obj₂ ≅ A₂) (e₃ : T.obj₃ ≅ A₃) :
    Triangle.mk (e₁.inv ≫ T.mor₁ ≫ e₂.hom) (e₂.inv ≫ T.mor₂ ≫ e₃.hom)
      (e₃.inv ≫ T.mor₃ ≫ (shiftFunctor _ (1 : ℤ)).map e₁.hom) ∈ distTriang _ :=
  isomorphic_distinguished _ hT _ (Triangle.isoMk _ _ e₁.symm e₂.symm e₃.symm (by simp) (by simp)
    (by simp [← Functor.map_comp]))

/-- A triangle transported along an isomorphism of its first vertex is distinguished. -/
private lemma distinguished_of_iso₁ {T : Triangle (DerivedCategory C)} (hT : T ∈ distTriang _)
    {A₁ : DerivedCategory C} (e₁ : T.obj₁ ≅ A₁) :
    Triangle.mk (e₁.inv ≫ T.mor₁) T.mor₂ (T.mor₃ ≫ (shiftFunctor _ (1 : ℤ)).map e₁.hom) ∈
      distTriang _ :=
  isomorphic_distinguished _ hT _ (Triangle.isoMk _ _ e₁.symm (Iso.refl _) (Iso.refl _) (by simp)
    (by simp) (by simp [← Functor.map_comp]))

section Cycles

variable {P : CochainComplex C ℤ} (hP : P.IsTotallyAcyclicProjective)
include hP

omit [HasDerivedCategory C] in
/-- `HomologicalComplex.cyclesShortComplex_shortExact` with the short complex of cycles written out,
via `HomologicalComplex.cyclesShortComplex_def`, so that its terms are the cycles themselves. -/
private lemma shortExact_mk_cycles (m m' : ℤ) (hm : m + 1 = m') :
    (ShortComplex.mk (P.iCycles m) (P.toCycles m m') (P.iCycles_toCycles m m')).ShortExact :=
  P.cyclesShortComplex_def m m' ▸ P.cyclesShortComplex_shortExact m m' hm (hP.acyclic m')

/-- The triangle `Zᵐ ⟶ Pᵐ ⟶ Zᵐ' ⟶ Zᵐ[1]` of the short exact sequence of cycles, with its vertices
placed in degree `m` by `singleFunctor C m`: the triangle `triangleOfSES` transported along
`singleFunctorIsoCompQ`. -/
private noncomputable abbrev cyclesSESTriangle (m m' : ℤ) (hm : m + 1 = m') :
    Triangle (DerivedCategory C) :=
  let T := triangleOfSES ((shortExact_mk_cycles hP m m' hm).map_of_exact
    (CochainComplex.singleFunctor C m))
  let e := singleFunctorIsoCompQ C m
  Triangle.mk ((e.app (P.cycles m)).hom ≫ T.mor₁ ≫ (e.app (P.X m)).inv)
    ((e.app (P.X m)).hom ≫ T.mor₂ ≫ (e.app (P.cycles m')).inv)
    ((e.app (P.cycles m')).hom ≫ T.mor₃ ≫ (shiftFunctor _ (1 : ℤ)).map (e.app (P.cycles m)).inv)

private lemma cyclesSESTriangle_distinguished (m m' : ℤ) (hm : m + 1 = m') :
    cyclesSESTriangle hP m m' hm ∈ distTriang _ :=
  distinguished_of_iso (triangleOfSES_distinguished
    ((shortExact_mk_cycles hP m m' hm).map_of_exact (CochainComplex.singleFunctor C m)))
    ((singleFunctorIsoCompQ C m).app (P.cycles m)).symm
    ((singleFunctorIsoCompQ C m).app (P.X m)).symm
    ((singleFunctorIsoCompQ C m).app (P.cycles m')).symm

/-- The first morphism of `cyclesSESTriangle` is the inclusion of the cycles placed in degree `m`,
by naturality of `singleFunctorIsoCompQ`. -/
private lemma cyclesSESTriangle_mor₁ (m m' : ℤ) (hm : m + 1 = m') :
    (cyclesSESTriangle hP m m' hm).mor₁ = (singleFunctor C m).map (P.iCycles m) :=
  NatIso.naturality_2 (singleFunctorIsoCompQ C m) (P.iCycles m)

/-- The first vertex `Zᵐ'[-1]` of the inverse rotation of `cyclesSESTriangle`, as `Zᵐ'` placed in
degree `m'`. -/
private noncomputable def cyclesShiftIso (m m' : ℤ) (hm : m + 1 = m') :
    (cyclesSESTriangle hP m m' hm).invRotate.obj₁ ≅ (singleFunctor C m').obj (P.cycles m') :=
  ((singleFunctors C).shiftIso (-1) m' m (by lia)).app (P.cycles m')

/-- The distinguished triangle `Zᵐ' ⟶ Zᵐ ⟶ Pᵐ` of the derived category obtained from the short
exact sequence `0 ⟶ Zᵐ ⟶ Pᵐ ⟶ Zᵐ' ⟶ 0` of cycles, with `Zᵐ'` placed in degree `m' = m + 1` and
`Zᵐ`, `Pᵐ` in degree `m`. -/
private noncomputable abbrev cyclesTriangle (m m' : ℤ) (hm : m + 1 = m') :
    Triangle (DerivedCategory C) :=
  Triangle.mk ((cyclesShiftIso hP m m' hm).inv ≫ (cyclesSESTriangle hP m m' hm).invRotate.mor₁)
    (cyclesSESTriangle hP m m' hm).invRotate.mor₂
    ((cyclesSESTriangle hP m m' hm).invRotate.mor₃ ≫
      (shiftFunctor _ (1 : ℤ)).map (cyclesShiftIso hP m m' hm).hom)

private lemma cyclesTriangle_distinguished (m m' : ℤ) (hm : m + 1 = m') :
    cyclesTriangle hP m m' hm ∈ distTriang _ :=
  distinguished_of_iso₁ (inv_rot_of_distTriang _ (cyclesSESTriangle_distinguished hP m m' hm))
    (cyclesShiftIso hP m m' hm)

/-- The second morphism of `cyclesTriangle` is the inclusion of the cycles placed in degree `m`. -/
private lemma cyclesTriangle_mor₂ (m m' : ℤ) (hm : m + 1 = m') :
    (cyclesTriangle hP m m' hm).mor₂ = (singleFunctor C m).map (P.iCycles m) :=
  cyclesSESTriangle_mor₁ hP m m' hm

/-- **Extension along a cycle step**: for `m ≥ 0`, every morphism from `Zᵐ'` in degree `m'` to an
object in degree zero factors through the first morphism of `cyclesTriangle`, since
`Ext^{m'}(Pᵐ, Y) = 0`. -/
private lemma exists_eq_cyclesTriangle_mor₁_comp (m m' : ℤ) (hm : m + 1 = m') (hm₀ : 0 ≤ m)
    {Y : C} (h : (singleFunctor C m').obj (P.cycles m') ⟶ (singleFunctor C 0).obj Y) :
    ∃ h' : (singleFunctor C m).obj (P.cycles m) ⟶ (singleFunctor C 0).obj Y,
      h = (cyclesTriangle hP m m' hm).mor₁ ≫ h' := by
  have := hP.projective m
  refine Triangle.yoneda_exact₂ _
    (inv_rot_of_distTriang _ (cyclesTriangle_distinguished hP m m' hm)) h ?_
  -- The source is `Pᵐ` placed in degree `m'`, which has no morphisms to `Y` in degree zero.
  let e : (cyclesTriangle hP m m' hm).invRotate.obj₁ ≅ (singleFunctor C m').obj (P.X m) :=
    ((singleFunctors C).shiftIso (-1) m' m (by lia)).app (P.X m)
  have h0 : e.inv ≫ (cyclesTriangle hP m m' hm).invRotate.mor₁ ≫ h = 0 :=
    singleFunctor_hom_eq_zero_of_projective (by lia) _
  calc _ = e.hom ≫ e.inv ≫ (cyclesTriangle hP m m' hm).invRotate.mor₁ ≫ h :=
        (e.hom_inv_id_assoc _).symm
    _ = 0 := by rw [h0]; exact comp_zero

/-- **Injectivity along a cycle step**: for `m > 0`, a morphism from `Zᵐ` in degree `m` to an
object in degree zero which vanishes on the first morphism of `cyclesTriangle` is zero, since
`Extᵐ(Pᵐ, Y) = 0`. -/
private lemma eq_zero_of_cyclesTriangle_mor₁_comp_eq_zero (m m' : ℤ) (hm : m + 1 = m') (hm₀ : 0 < m)
    {Y : C} (h : (singleFunctor C m).obj (P.cycles m) ⟶ (singleFunctor C 0).obj Y)
    (hh : (cyclesTriangle hP m m' hm).mor₁ ≫ h = 0) : h = 0 := by
  have := hP.projective m
  obtain ⟨k, rfl⟩ := Triangle.yoneda_exact₂ _ (cyclesTriangle_distinguished hP m m' hm) h hh
  -- `Pᵐ` placed in degree `m > 0` has no morphisms to `Y` in degree zero.
  rw [singleFunctor_hom_eq_zero_of_projective hm₀ k]
  exact comp_zero

/-- **The first cycle step**: a morphism from `Z⁰` to `Y` in degree zero which vanishes on the
first morphism of `cyclesTriangle` factors through the inclusion `Z⁰ ⟶ P⁰`. -/
private lemma exists_eq_iCycles_comp_of_cyclesTriangle_mor₁_comp_eq_zero {Y : C}
    (h : (singleFunctor C 0).obj (P.cycles 0) ⟶ (singleFunctor C 0).obj Y)
    (hh : (cyclesTriangle hP 0 1 (zero_add 1)).mor₁ ≫ h = 0) :
    ∃ k : P.X 0 ⟶ Y, h = (singleFunctor C 0).map (P.iCycles 0 ≫ k) := by
  obtain ⟨k, rfl⟩ :=
    Triangle.yoneda_exact₂ _ (cyclesTriangle_distinguished hP 0 1 (zero_add 1)) h hh
  obtain ⟨k₀, rfl⟩ := (singleFunctor C 0).map_surjective k
  exact ⟨k₀, (congrArg (· ≫ (singleFunctor C 0).map k₀)
    (cyclesTriangle_mor₂ hP 0 1 (zero_add 1))).trans ((singleFunctor C 0).map_comp _ _).symm⟩

end Cycles

section Approximation

variable (P : CochainComplex C ℤ) in
/-- The cycles `Zᵏ` placed in degree `k`, in the bounded derived category. -/
private noncomputable abbrev cyclesObj (k : ℕ) : DerivedCategory.Bounded C :=
  (TauCeti.DerivedCategory.Bounded.singleFunctor C k).obj (P.cycles k)

variable {P : CochainComplex C ℤ} (hP : P.IsTotallyAcyclicProjective)

/-- The morphism `Zᵏ⁺¹[-k-1] ⟶ Zᵏ[-k]` of the bounded derived category. -/
private noncomputable def cyclesHom (k : ℕ) : cyclesObj P (k + 1) ⟶ cyclesObj P k :=
  ObjectProperty.homMk (cyclesTriangle hP k (k + 1 : ℕ) (Nat.cast_succ k).symm).mor₁

/-- The composite `δₖ : Zᵏ[-k] ⟶ Z⁰` of the morphisms `cyclesHom`. -/
private noncomputable def cyclesδ : (k : ℕ) → cyclesObj P k ⟶ cyclesObj P 0
  | 0 => 𝟙 _
  | k + 1 => cyclesHom hP k ≫ cyclesδ k

include hP

private lemma trW_cyclesHom (k : ℕ) :
    (TauCeti.DerivedCategory.Bounded.perfect C).trW (cyclesHom hP k) := by
  have := hP.projective k
  exact TauCeti.DerivedCategory.Bounded.perfect_trW_of_distinguished
    (Z := (TauCeti.DerivedCategory.Bounded.singleFunctor C k).obj (P.X k)) (cyclesHom hP k) _ _
    (cyclesTriangle_distinguished hP k _ (Nat.cast_succ k).symm)
    (TauCeti.DerivedCategory.Bounded.perfect_singleFunctor_obj C k inferInstance)

private lemma trW_cyclesδ : ∀ k, (TauCeti.DerivedCategory.Bounded.perfect C).trW (cyclesδ hP k)
  | 0 => MorphismProperty.id_mem _ _
  | k + 1 => MorphismProperty.comp_mem _ _ _ (trW_cyclesHom hP k) (trW_cyclesδ k)

/-- Every morphism from `Z⁰` to a perfect object is killed by `δₖ` for `k` large. -/
private lemma exists_cyclesδ_comp_eq_zero (K : DerivedCategory.Bounded C)
    (hK : TauCeti.DerivedCategory.Bounded.perfect C K) (a : cyclesObj P 0 ⟶ K) :
    ∃ k, cyclesδ hP k ≫ a = 0 := by
  let := HasExt.standard C
  obtain ⟨n₀, hn₀⟩ := exists_singleHom_eq_zero_of_perfect hK
  refine ⟨n₀.toNat, DerivedCategory.Bounded.ι.map_injective ?_⟩
  rw [Functor.map_zero]
  exact hn₀ _ (by lia) _ (hP.extLeftOrthogonal_cycles _) _

/-- Every morphism from `Zᵏ[-k]` to an object of `C` in degree zero extends along `δₖ`. -/
private lemma exists_eq_cyclesδ_comp {Y : C} : ∀ (k : ℕ)
    (h : cyclesObj P k ⟶ (TauCeti.DerivedCategory.Bounded.singleFunctor C 0).obj Y),
    ∃ φ : cyclesObj P 0 ⟶ (TauCeti.DerivedCategory.Bounded.singleFunctor C 0).obj Y,
      h = cyclesδ hP k ≫ φ
  | 0, h => ⟨h, by simp [cyclesδ]⟩
  | k + 1, h => by
    obtain ⟨h', hh'⟩ := exists_eq_cyclesTriangle_mor₁_comp hP k (k + 1 : ℕ) (Nat.cast_succ k).symm
      (by positivity) (DerivedCategory.Bounded.ι.map h)
    obtain ⟨φ, hφ⟩ := exists_eq_cyclesδ_comp k (ObjectProperty.homMk h')
    refine ⟨φ, ?_⟩
    rw [cyclesδ, Category.assoc, ← hφ]
    exact ObjectProperty.hom_ext _ hh'

/-- A morphism from `Z⁰` to an object of `C` in degree zero which is killed by some `δₖ` factors
through the inclusion `Z⁰ ⟶ P⁰`. -/
private lemma exists_eq_iCycles_comp_of_cyclesδ_comp_eq_zero {Y : C} : ∀ (k : ℕ)
    (f : cyclesObj P 0 ⟶ (TauCeti.DerivedCategory.Bounded.singleFunctor C 0).obj Y),
    cyclesδ hP k ≫ f = 0 →
      ∃ k₀ : P.X 0 ⟶ Y, DerivedCategory.Bounded.ι.map f = (singleFunctor C 0).map (P.iCycles 0 ≫ k₀)
  | 0, f, hf => ⟨0, by
      rw [cyclesδ, Category.id_comp] at hf
      rw [hf, Functor.map_zero, comp_zero, Functor.map_zero]⟩
  | 1, f, hf => by
    have h := congrArg DerivedCategory.Bounded.ι.map hf
    rw [cyclesδ, cyclesδ, Category.comp_id, Functor.map_comp, Functor.map_zero] at h
    exact exists_eq_iCycles_comp_of_cyclesTriangle_mor₁_comp_eq_zero hP _ h
  | k + 2, f, hf => by
    refine exists_eq_iCycles_comp_of_cyclesδ_comp_eq_zero (k + 1) f ?_
    rw [cyclesδ, Category.assoc] at hf
    have h := congrArg DerivedCategory.Bounded.ι.map hf
    rw [Functor.map_comp, Functor.map_zero] at h
    exact DerivedCategory.Bounded.ι.map_injective (by
      rw [Functor.map_zero]
      exact eq_zero_of_cyclesTriangle_mor₁_comp_eq_zero hP (k + 1 : ℕ) (k + 2 : ℕ)
        (by push_cast; ring) (by positivity) _ h)

end Approximation

end DerivedCategory

namespace TauCeti.SingularityCategory

variable {C : Type u} [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

open _root_.DerivedCategory in
/-- For a complete resolution `P`, every morphism from `Z⁰` to `Y` in the singularity category
comes from `C`. -/
private lemma map_surjective_cycles {P : CochainComplex C ℤ} (hP : P.IsTotallyAcyclicProjective)
    (Y : C) (g : (Q C).obj (cyclesObj P 0) ⟶
      (Q C).obj ((DerivedCategory.Bounded.singleFunctor C 0).obj Y)) :
    ∃ f : P.cycles (0 : ℕ) ⟶ Y,
      (Q C).map ((DerivedCategory.Bounded.singleFunctor C 0).map f) = g := by
  obtain ⟨k, h, hh⟩ := ObjectProperty.TrWLocalization.exists_map_comp_eq_map
    (DerivedCategory.Bounded.perfect C) (Q C) (cyclesδ hP)
    (fun K hK a ↦ exists_cyclesδ_comp_eq_zero hP K hK a) g
  obtain ⟨φ, rfl⟩ := exists_eq_cyclesδ_comp hP k h
  have := Localization.inverts (Q C) (DerivedCategory.Bounded.perfect C).trW _ (trW_cyclesδ hP k)
  obtain ⟨f, hf⟩ := (singleFunctor C 0).map_surjective (DerivedCategory.Bounded.ι.map φ)
  obtain rfl : (DerivedCategory.Bounded.singleFunctor C 0).map f = φ :=
    DerivedCategory.Bounded.ι.map_injective hf
  exact ⟨f, (cancel_epi ((Q C).map (cyclesδ hP k))).1 (by rw [hh, Functor.map_comp])⟩

open _root_.DerivedCategory in
/-- For a complete resolution `P`, a morphism from `Z⁰` to `Y` vanishing in the singularity
category factors through the inclusion `Z⁰ ⟶ P⁰`. -/
private lemma exists_eq_iCycles_comp_of_map_eq_zero {P : CochainComplex C ℤ}
    (hP : P.IsTotallyAcyclicProjective) {Y : C} (f : P.cycles (0 : ℕ) ⟶ Y)
    (hf : (Q C).map ((DerivedCategory.Bounded.singleFunctor C 0).map f) = 0) :
    ∃ k₀ : P.X 0 ⟶ Y, f = P.iCycles 0 ≫ k₀ := by
  obtain ⟨k, hk⟩ := ObjectProperty.TrWLocalization.exists_comp_eq_zero_of_map_eq_zero
    (DerivedCategory.Bounded.perfect C) (Q C) (cyclesδ hP)
    (fun K hK a ↦ exists_cyclesδ_comp_eq_zero hP K hK a) _ hf
  obtain ⟨k₀, hk₀⟩ := exists_eq_iCycles_comp_of_cyclesδ_comp_eq_zero hP k _ hk
  exact ⟨k₀, (singleFunctor C 0).map_injective hk₀⟩

/-- **Morphisms out of a Gorenstein-projective object in the singularity category.** For `G`
Gorenstein-projective and `Y` any object of an abelian category `C`, every morphism from `G` to
`Y` in the singularity category comes from a morphism `G ⟶ Y` of `C`. -/
theorem map_surjective_of_isGorensteinProjective {G : C} (hG : isGorensteinProjective C G)
    (Y : C) : Function.Surjective fun f : G ⟶ Y ↦
      (Q C).map ((DerivedCategory.Bounded.singleFunctor C 0).map f) := by
  obtain ⟨P, hP, ⟨e⟩⟩ := (isGorensteinProjective_iff G).1 hG
  intro g
  obtain ⟨f, hf⟩ := map_surjective_cycles hP Y
    ((Q C).map ((DerivedCategory.Bounded.singleFunctor C 0).map e.hom) ≫ g)
  refine ⟨e.inv ≫ f, ?_⟩
  simp [hf, ← Functor.map_comp_assoc]

/-- **The kernel on a Gorenstein-projective object.** For `G` Gorenstein-projective and `Y` any
object of an abelian category `C`, a morphism `G ⟶ Y` vanishes in the singularity category if and
only if it factors through a projective object. -/
theorem map_eq_zero_iff_of_isGorensteinProjective {G Y : C} (hG : isGorensteinProjective C G)
    (f : G ⟶ Y) : (Q C).map ((DerivedCategory.Bounded.singleFunctor C 0).map f) = 0 ↔
      (isProjective C).FactorsThrough f := by
  rw [ObjectProperty.factorsThrough_iff]
  refine ⟨fun hf ↦ ?_, fun ⟨P, hP, p, q, hpq⟩ ↦ ?_⟩
  · obtain ⟨P, hP, ⟨e⟩⟩ := (isGorensteinProjective_iff G).1 hG
    obtain ⟨k₀, hk₀⟩ := exists_eq_iCycles_comp_of_map_eq_zero hP (e.hom ≫ f)
      (by rw [Functor.map_comp, Functor.map_comp, hf, comp_zero])
    exact ⟨P.X 0, hP.projective 0, e.inv ≫ P.iCycles 0, k₀, by
      rw [Category.assoc, ← hk₀, e.inv_hom_id_assoc]⟩
  · rw [hpq, Functor.map_comp, Functor.map_comp,
      (isZero_Q_obj_singleFunctor_obj hP).eq_of_src ((Q C).map _) 0, comp_zero]

end TauCeti.SingularityCategory

namespace CategoryTheory.GorensteinProjective

variable (C : Type u) [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

/-- The functor from Gorenstein-projective objects to the singularity category, placing an
object in degree zero. -/
-- Exposed so that `toSingularityCategoryFunctor_map` can be stated: its two sides have the same
-- type only after unfolding the definition on objects.
@[expose] noncomputable def toSingularityCategoryFunctor :
    GorensteinProjective C ⥤ TauCeti.SingularityCategory C :=
  (isGorensteinProjective C).ι ⋙ DerivedCategory.Bounded.singleFunctor C 0 ⋙
    TauCeti.SingularityCategory.Q C

instance : (toSingularityCategoryFunctor C).Additive := by
  unfold toSingularityCategoryFunctor
  infer_instance

variable {C} in
/-- The functor `toSingularityCategoryFunctor` places an object in degree zero. -/
@[simp]
theorem toSingularityCategoryFunctor_obj (X : GorensteinProjective C) :
    (toSingularityCategoryFunctor C).obj X =
      (TauCeti.SingularityCategory.Q C).obj
        ((DerivedCategory.Bounded.singleFunctor C 0).obj X.obj) :=
  (rfl)

variable {C} in
/-- The functor `toSingularityCategoryFunctor` places a morphism in degree zero. -/
@[simp]
theorem toSingularityCategoryFunctor_map {X Y : GorensteinProjective C} (f : X ⟶ Y) :
    (toSingularityCategoryFunctor C).map f =
      (TauCeti.SingularityCategory.Q C).map
        ((DerivedCategory.Bounded.singleFunctor C 0).map f.hom) :=
  (rfl)

/-- **Chen's functor** from the stable category of Gorenstein-projective objects to the
singularity category, induced by placing an object in degree zero. It is well defined because
projective objects vanish in the singularity category. -/
-- Exposed so that `toSingularityCategory_map_projectiveStableFunctor_map` can be stated, as for
-- `toSingularityCategoryFunctor`.
@[expose] noncomputable def toSingularityCategory :
    (exactStructure C).ProjectiveStableCategory ⥤ TauCeti.SingularityCategory C :=
  (exactStructure C).projectiveStableIdeal.lift (toSingularityCategoryFunctor C)
    fun X Y f hf ↦ by
      rw [Functor.mem_kerIdeal_hom]
      exact (TauCeti.SingularityCategory.map_eq_zero_iff_of_isGorensteinProjective X.property
        f.hom).2 ((exactStructure_isProjective_factorsThrough_iff f).1
          ((ExactStructure.mem_projectiveStableIdeal_iff _).1 hf))

instance : (toSingularityCategory C).Additive := by
  unfold toSingularityCategory
  infer_instance

/-- Chen's functor restricts to placing objects in degree zero along the quotient functor. -/
theorem projectiveStableFunctor_comp_toSingularityCategory :
    (exactStructure C).projectiveStableFunctor ⋙ toSingularityCategory C =
      toSingularityCategoryFunctor C := by
  unfold toSingularityCategory
  exact CategoryTheory.Quotient.lift_spec _ _ _

variable {C} in
/-- Chen's functor sends the class of an object to that object placed in degree zero. -/
@[simp]
theorem toSingularityCategory_obj_projectiveStableFunctor_obj (X : GorensteinProjective C) :
    (toSingularityCategory C).obj ((exactStructure C).projectiveStableFunctor.obj X) =
      (TauCeti.SingularityCategory.Q C).obj
        ((DerivedCategory.Bounded.singleFunctor C 0).obj X.obj) :=
  (rfl)

variable {C} in
/-- Chen's functor sends the class of a morphism `f` of Gorenstein-projective objects to `f`
placed in degree zero. -/
@[simp]
theorem toSingularityCategory_map_projectiveStableFunctor_map {X Y : GorensteinProjective C}
    (f : X ⟶ Y) :
    (toSingularityCategory C).map ((exactStructure C).projectiveStableFunctor.map f) =
      (TauCeti.SingularityCategory.Q C).map
        ((DerivedCategory.Bounded.singleFunctor C 0).map f.hom) := by
  unfold toSingularityCategory
  exact CategoryTheory.Quotient.lift_map_functor_map _ _ _ _

/-- **Chen's theorem**, fullness: every morphism of the singularity category between
Gorenstein-projective objects comes from a morphism of `C`. -/
instance : (toSingularityCategory C).Full where
  map_surjective {X Y} g := by
    -- Every object of the stable category is the class of its underlying object, so `g` is a
    -- morphism between objects placed in degree zero
    -- (`toSingularityCategory_obj_projectiveStableFunctor_obj`).
    obtain ⟨f, hf⟩ := TauCeti.SingularityCategory.map_surjective_of_isGorensteinProjective
      X.as.property Y.as.obj (show (TauCeti.SingularityCategory.Q C).obj
        ((DerivedCategory.Bounded.singleFunctor C 0).obj X.as.obj) ⟶ _ from g)
    exact ⟨(exactStructure C).projectiveStableFunctor.map (ObjectProperty.homMk f),
      (toSingularityCategory_map_projectiveStableFunctor_map _).trans hf⟩

/-- **Chen's theorem**, faithfulness: a morphism of Gorenstein-projective objects vanishing in the
singularity category factors through a projective object. -/
instance : (toSingularityCategory C).Faithful where
  map_injective {X Y} f₁ f₂ h := by
    obtain ⟨g₁, rfl⟩ := (exactStructure C).projectiveStableFunctor.map_surjective f₁
    obtain ⟨g₂, rfl⟩ := (exactStructure C).projectiveStableFunctor.map_surjective f₂
    rw [toSingularityCategory_map_projectiveStableFunctor_map,
      toSingularityCategory_map_projectiveStableFunctor_map] at h
    rw [← sub_eq_zero, ← Functor.map_sub, ExactStructure.projectiveStableFunctor_map_eq_zero_iff,
      exactStructure_isProjective_factorsThrough_iff,
      ← TauCeti.SingularityCategory.map_eq_zero_iff_of_isGorensteinProjective X.as.property]
    have : (g₁ - g₂).hom = g₁.hom - g₂.hom := by
      simpa using (isGorensteinProjective C).ι.map_sub (f := g₁) (g := g₂)
    rw [this, Functor.map_sub, Functor.map_sub, h, sub_self]

/-- **Chen's theorem**: the functor from the stable category of Gorenstein-projective objects of an
abelian category to its singularity category is fully faithful. -/
noncomputable def fullyFaithfulToSingularityCategory : (toSingularityCategory C).FullyFaithful :=
  .ofFullyFaithful _

end CategoryTheory.GorensteinProjective
