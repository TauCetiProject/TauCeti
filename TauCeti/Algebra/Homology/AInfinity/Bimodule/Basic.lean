module

public import TauCeti.Algebra.Coalgebra.Comodule.GradedCoderivation
public import TauCeti.Algebra.Coalgebra.Comodule.LeftCoderivation
public import TauCeti.Algebra.Homology.AInfinity.Algebra.CoaugmentedBar
public import TauCeti.LinearAlgebra.TensorCoalgebra.Coaugmented.Grading

/-!
# A-infinity bimodules: the suspended two-sided bar differential

An `(A, B)` `A∞` bimodule, left over the `A∞` algebra `A` and right over the `A∞` algebra `B`, is
stored on its cofree bar bicomodule

`Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB)`,

with `A` coacting by deconcatenating the left word and `B` by deconcatenating the right word.  Its
structure map is a degree-one square-zero coderivation of this bicomodule: a coderivation over the
bar differential of `A` for the left coaction, and over the bar differential of `B` for the right
coaction.  The two co-Leibniz laws carry the Koszul signs of the suspended convention: the module
differential passes the left word with the sign of its total degree, and the bar differential of
`B` passes the left word and the module factor.  On the summand `(sA)^{⊗ i} ⊗ sM ⊗ (sB)^{⊗ j}` the
counit component of the structure map is the suspended operation
`b_{i,j} : (sA)^{⊗ i} ⊗ sM ⊗ (sB)^{⊗ j} ⟶ sM`, the empty words recording the unary differential.

The carrier is associated as `(Tᶜ(sA) ⊗ sM) ⊗ Tᶜ(sB)`, the cofree right comodule over `Tᶜ(sB)`
cogenerated by `Tᶜ(sA) ⊗ sM`, so the right co-Leibniz law is the one of right `A∞` modules
(`TauCeti.Comodule.IsGradedCoderivationOver`).  The left co-Leibniz law is
`TauCeti.Comodule.IsLeftGradedCoderivationOver` for the left coaction of `Tᶜ(sA)` on the left
factor.  As for right modules, the Taylor map is not stored: the bicomodule is cofree on both
sides, so a coderivation is determined by its counit component, and the square-zero law can be
checked after applying both counits.  Concretely, the projection forgetting the right word is
compatible with the left coactions; on its image the left cofree uniqueness applies, and on the
whole carrier the right cofree uniqueness does.

## Main definitions

* `TauCeti.AInfinityBimodule`: an `(A, B)` `A∞` bimodule in suspended bar form.
* `TauCeti.AInfinityBimodule.barGrading`: the total grading on `Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB)`.
* `TauCeti.AInfinityBimodule.taylorProj`: the two-sided counit projection onto `sM`.
* `TauCeti.AInfinityBimodule.taylor`: the counit component of the bimodule bar differential.
* `TauCeti.AInfinityBimodule.ofBarDifferential`: construct a bimodule by checking the square-zero
  law on its Taylor component.

## Main results

* `TauCeti.AInfinityBimodule.barDifferential_sq_iff_taylor_comp_eq_zero`: a degree-one
  bicomodule coderivation squares to zero exactly when its Taylor component after one further
  application vanishes, the suspended form of the bimodule Stasheff identities.
* `TauCeti.AInfinityBimodule.eq_of_taylorProj_comp_eq`: a bicomodule coderivation over the two
  bar differentials is determined by its Taylor component.
* `TauCeti.AInfinityBimodule.ext`: a bimodule is determined by its grading and its Taylor map.

## References

* E. Getzler and J. D. S. Jones, *A-infinity algebras and the cyclic bar complex*, Sections 1--2.
* B. Keller, *Introduction to A-infinity algebras and modules*, Sections 3--5.
* V. Lyubashenko and O. Manzyuk, *A-infinity-bimodules and Serre A-infinity-functors*.
-/

public section

open scoped TensorProduct

namespace TauCeti

universe uR uA uB uM

variable {R : Type uR} {A : Type uA} {B : Type uB} {M : Type uM}
  [CommRing R] [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B]
  [AddCommGroup M] [Module R M]

namespace AInfinityBimodule

/-- The total suspended grading on the cofree bar bicomodule `Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB)`. -/
noncomputable def barGrading (AA : AInfinityAlgebra R A) (BB : AInfinityAlgebra R B)
    (G : InternalGrading R M) :
    InternalGrading R ((TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) :=
  ((TensorWords.grading (AA.grading.shift 1)).tensorProduct (G.shift 1)).tensorProduct
    (TensorWords.grading (BB.grading.shift 1))

/-- The bicomodule grading is the total grading of the suspended left words, the suspended module
grading, and the suspended right words. -/
theorem barGrading_def (AA : AInfinityAlgebra R A) (BB : AInfinityAlgebra R B)
    (G : InternalGrading R M) :
    barGrading AA BB G =
      ((TensorWords.grading (AA.grading.shift 1)).tensorProduct (G.shift 1)).tensorProduct
        (TensorWords.grading (BB.grading.shift 1)) :=
  (rfl)

/-- The degree-`p` part of the bicomodule grading is the total-degree part of the suspended left
words, the suspended module grading, and the suspended right words. -/
@[simp]
theorem barGrading_piece (AA : AInfinityAlgebra R A) (BB : AInfinityAlgebra R B)
    (G : InternalGrading R M) (p : ℤ) :
    (barGrading AA BB G).piece p =
      (((TensorWords.grading (AA.grading.shift 1)).tensorProduct (G.shift 1)).tensorProduct
        (TensorWords.grading (BB.grading.shift 1))).piece p :=
  (rfl)

variable (R A B M) in
/-- The two-sided counit projection of the cofree bar bicomodule `Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB)` onto
`sM`: the counit of `Tᶜ(sB)` forgets the right word, and then the cofree counit projection of
`Tᶜ(sA)` forgets the left word. -/
noncomputable def taylorProj : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M :=
  Comodule.leftCofreeCounit R (TensorWords R A) M ∘ₗ
    (TensorProduct.rid R (TensorWords R A ⊗[R] M)).toLinearMap ∘ₗ
      (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor (TensorWords R A ⊗[R] M)

/-- The two-sided counit projection applies the counit of the right words, the right unitor, and
the cofree counit projection of the left words. -/
theorem taylorProj_def :
    taylorProj R A B M =
      Comodule.leftCofreeCounit R (TensorWords R A) M ∘ₗ
        (TensorProduct.rid R (TensorWords R A ⊗[R] M)).toLinearMap ∘ₗ
          (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor (TensorWords R A ⊗[R] M) :=
  (rfl)

/-- The two-sided counit projection on a pure tensor `(w ⊗ m) ⊗ v` scales `m` by the counits of
both words. -/
@[simp]
theorem taylorProj_tmul (w : TensorWords R A) (m : M) (v : TensorWords R B) :
    taylorProj R A B M ((w ⊗ₜ m) ⊗ₜ v) =
      Coalgebra.counit (R := R) v • Coalgebra.counit (R := R) w • m := by
  simp [taylorProj_def]

end AInfinityBimodule

attribute [local instance] Comodule.cofree

/-- An `(A, B)` `A∞` bimodule, stored as a square-zero degree-one coderivation of the cofree bar
bicomodule `Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB)`: for the left coaction of `Tᶜ(sA)` it is a coderivation over the
bar coderivation of `AA`, and for the right coaction of `Tᶜ(sB)` over the bar coderivation of
`BB`.

The carrier types model suspension by shifting their internal gradings; no new carrier type is
introduced.  Thus `barDifferential` acts on `(Tᶜ(A) ⊗ M) ⊗ Tᶜ(B)`, while `barGrading` interprets
that carrier as `Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB)`. -/
structure AInfinityBimodule (AA : AInfinityAlgebra R A) (BB : AInfinityAlgebra R B)
    (M : Type uM) [AddCommGroup M] [Module R M] where
  /-- The internal cohomological grading of the bimodule carrier. -/
  grading : InternalGrading R M
  /-- The suspended bimodule bar differential on the cofree bar bicomodule. -/
  barDifferential :
    (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R]
      (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B
  /-- The bimodule bar differential has degree one for the total suspended grading. -/
  isHomogeneous_barDifferential :
    LinearMap.IsHomogeneous barDifferential
      (AInfinityBimodule.barGrading AA BB grading).piece
      (AInfinityBimodule.barGrading AA BB grading).piece 1
  /-- For the left coaction, the bimodule bar differential is a coderivation over the bar
  differential of `AA`. -/
  isLeftGradedCoderivation_barDifferential :
    Comodule.IsLeftGradedCoderivationOver
      (Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M))
      (TensorWords.grading (AA.grading.shift 1)) 1 AA.coaugmentedBarDifferential barDifferential
  /-- For the right coaction, the bimodule bar differential is a coderivation over the bar
  differential of `BB`. -/
  isGradedCoderivation_barDifferential :
    Comodule.IsGradedCoderivationOver (AInfinityBimodule.barGrading AA BB grading) 1
      BB.coaugmentedBarDifferential barDifferential
  /-- The bimodule bar differential squares to zero. -/
  bar_square_zero : barDifferential ∘ₗ barDifferential = 0

namespace AInfinityBimodule

variable {AA : AInfinityAlgebra R A} {BB : AInfinityAlgebra R B}

/-- The Taylor map of an `A∞` bimodule, obtained by applying the counits of both tensor
coalgebras to the output of its bar differential.  On the summand `(sA)^{⊗ i} ⊗ sM ⊗ (sB)^{⊗ j}`,
this is the suspended operation `b_{i,j}`. -/
noncomputable def taylor (MM : AInfinityBimodule AA BB M) :
    (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M :=
  taylorProj R A B M ∘ₗ MM.barDifferential

/-- The Taylor map is the two-sided counit component of the bimodule bar differential. -/
theorem taylor_def (MM : AInfinityBimodule AA BB M) :
    MM.taylor = taylorProj R A B M ∘ₗ MM.barDifferential :=
  (rfl)

/-- Evaluating the Taylor map means applying the bar differential and then the two-sided counit
projection. -/
@[simp]
theorem taylor_apply (MM : AInfinityBimodule AA BB M)
    (x : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) :
    MM.taylor x = taylorProj R A B M (MM.barDifferential x) :=
  (rfl)

/-- The Taylor map has degree one from the total suspended bicomodule grading to the suspended
module grading. -/
theorem isHomogeneous_taylor (MM : AInfinityBimodule AA BB M) :
    LinearMap.IsHomogeneous MM.taylor (barGrading AA BB MM.grading).piece
      (MM.grading.shift 1).piece 1 := by
  have hD := MM.isHomogeneous_barDifferential
  rw [barGrading_def] at hD ⊢
  rw [taylor_def, taylorProj_def, Comodule.leftCofreeCounit_def]
  simpa only [LinearMap.comp_assoc, add_zero] using
    ((TensorWords.isHomogeneous_lid_comp_rTensor_counit (AA.grading.shift 1)
      (MM.grading.shift 1)).comp (TensorWords.isHomogeneous_rid_comp_lTensor_counit
        ((TensorWords.grading (AA.grading.shift 1)).tensorProduct (MM.grading.shift 1))
        (BB.grading.shift 1))).comp hD

/-- The stored bimodule bar differential squares to zero. -/
@[simp]
theorem barDifferential_sq (MM : AInfinityBimodule AA BB M) :
    MM.barDifferential ∘ₗ MM.barDifferential = 0 :=
  MM.bar_square_zero

/-- The Taylor component of the square of the bimodule bar differential vanishes.  This is the
suspended form of all bimodule Stasheff identities. -/
@[simp]
theorem taylor_comp_barDifferential (MM : AInfinityBimodule AA BB M) :
    MM.taylor ∘ₗ MM.barDifferential = 0 := by
  simp only [taylor_def, LinearMap.comp_assoc, MM.barDifferential_sq, LinearMap.comp_zero]

/-- A degree-one bicomodule coderivation over the bar differentials of `AA` and `BB` squares to
zero if and only if its Taylor component after one further application vanishes. -/
theorem barDifferential_sq_iff_taylor_comp_eq_zero (G : InternalGrading R M)
    (D : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R]
      (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B)
    (hD : LinearMap.IsHomogeneous D (barGrading AA BB G).piece (barGrading AA BB G).piece 1)
    (hleft : Comodule.IsLeftGradedCoderivationOver
      (Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M))
      (TensorWords.grading (AA.grading.shift 1)) 1 AA.coaugmentedBarDifferential D)
    (hright : Comodule.IsGradedCoderivationOver (barGrading AA BB G) 1
      BB.coaugmentedBarDifferential D) :
    D ∘ₗ D = 0 ↔
      taylorProj R A B M ∘ₗ D ∘ₗ D = 0 := by
  have hb : LinearMap.IsHomogeneous AA.coaugmentedBarDifferential
      (TensorWords.grading (AA.grading.shift 1)).piece
      (TensorWords.grading (AA.grading.shift 1)).piece 1 := by
    rw [TensorWords.grading_piece]
    exact AA.isHomogeneous_coaugmentedBarDifferential
  have hleft' := hleft.comp_square_eq_zero_iff_counit_of_negOnePow_eq_neg_one
    (Comodule.comp_rid_comp_lTensor_eq_lTensor_comp_leftCoactRTensor _
      (Coalgebra.counit (R := R) (A := TensorWords R B)))
    hb (by norm_num) AA.coaugmentedBarDifferential_sq
  rw [taylorProj_def, LinearMap.comp_assoc, ← hleft', LinearMap.comp_assoc]
  exact hright.square_eq_zero_iff_counit (barGrading AA BB G) _ D hD
    BB.coaugmentedBarDifferential_sq

/-- Construct an `A∞` bimodule from a homogeneous bicomodule coderivation over the bar
differentials of `AA` and `BB`.  By cofreeness, it suffices to check the square-zero law on the
Taylor component. -/
noncomputable def ofBarDifferential (G : InternalGrading R M)
    (D : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R]
      (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B)
    (hD : LinearMap.IsHomogeneous D (barGrading AA BB G).piece (barGrading AA BB G).piece 1)
    (hleft : Comodule.IsLeftGradedCoderivationOver
      (Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M))
      (TensorWords.grading (AA.grading.shift 1)) 1 AA.coaugmentedBarDifferential D)
    (hright : Comodule.IsGradedCoderivationOver (barGrading AA BB G) 1
      BB.coaugmentedBarDifferential D)
    (hsq : taylorProj R A B M ∘ₗ D ∘ₗ D = 0) :
    AInfinityBimodule AA BB M where
  grading := G
  barDifferential := D
  isHomogeneous_barDifferential := hD
  isLeftGradedCoderivation_barDifferential := hleft
  isGradedCoderivation_barDifferential := hright
  bar_square_zero := (barDifferential_sq_iff_taylor_comp_eq_zero G D hD hleft hright).2 hsq

@[simp]
theorem ofBarDifferential_grading (G : InternalGrading R M)
    (D : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R]
      (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) (hD hleft hright hsq) :
    (ofBarDifferential (AA := AA) (BB := BB) G D hD hleft hright hsq).grading = G :=
  (rfl)

@[simp]
theorem ofBarDifferential_barDifferential (G : InternalGrading R M)
    (D : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R]
      (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) (hD hleft hright hsq) :
    (ofBarDifferential (AA := AA) (BB := BB) G D hD hleft hright hsq).barDifferential = D :=
  (rfl)

@[simp]
theorem ofBarDifferential_taylor (G : InternalGrading R M)
    (D : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R]
      (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) (hD hleft hright hsq) :
    (ofBarDifferential (AA := AA) (BB := BB) G D hD hleft hright hsq).taylor =
      taylorProj R A B M ∘ₗ D :=
  (rfl)

/-- Two degree-one bicomodule coderivations over the bar differentials of `AA` and `BB` agree as
soon as their two-sided counit components agree: by cofreeness on both sides, such a coderivation
is determined by its Taylor component. -/
theorem eq_of_taylorProj_comp_eq {G : InternalGrading R M}
    {D E : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R]
      (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B}
    (hDl : Comodule.IsLeftGradedCoderivationOver
      (Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M))
      (TensorWords.grading (AA.grading.shift 1)) 1 AA.coaugmentedBarDifferential D)
    (hDr : Comodule.IsGradedCoderivationOver (barGrading AA BB G) 1
      BB.coaugmentedBarDifferential D)
    (hEl : Comodule.IsLeftGradedCoderivationOver
      (Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M))
      (TensorWords.grading (AA.grading.shift 1)) 1 AA.coaugmentedBarDifferential E)
    (hEr : Comodule.IsGradedCoderivationOver (barGrading AA BB G) 1
      BB.coaugmentedBarDifferential E)
    (h : taylorProj R A B M ∘ₗ D = taylorProj R A B M ∘ₗ E) : D = E := by
  have hleft := hDl.comp_eq_comp_of_counit_comp_eq
    (Comodule.comp_rid_comp_lTensor_eq_lTensor_comp_leftCoactRTensor _
      (Coalgebra.counit (R := R) (A := TensorWords R B)))
    hEl (by simpa only [taylorProj_def, LinearMap.comp_assoc] using h)
  exact hDr.eq_of_counit_comp_eq (barGrading AA BB G) BB.coaugmentedBarDifferential D E hEr
    (by simpa only [LinearMap.comp_assoc] using hleft)

/-- `A∞` bimodules on a fixed carrier are determined by their grading and Taylor map.  In
particular, the stored bar differential contains no data beyond its two-sided counit component. -/
@[ext]
theorem ext {MM NN : AInfinityBimodule AA BB M} (hG : MM.grading = NN.grading)
    (htaylor : MM.taylor = NN.taylor) : MM = NN := by
  cases MM with
  | mk G D hD hDl hDr hsq =>
    cases NN with
    | mk H E hE hEl hEr hesq =>
      subst hG
      obtain rfl : D = E := eq_of_taylorProj_comp_eq hDl hDr hEl hEr htaylor
      rfl

end AInfinityBimodule

end TauCeti
