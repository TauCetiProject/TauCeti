module

public import TauCeti.Algebra.Homology.AInfinity.Bimodule.Cohomology
public import TauCeti.Algebra.Homology.AInfinity.Bimodule.Taylor
public import TauCeti.Algebra.Homology.AInfinity.Module.Right.Transfer

/-!
# The unary and higher parts of an A-infinity bimodule bar differential

An `(A, B)` `A∞` bimodule `M` is stored on its cofree bar bicomodule `Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB)` by a
square-zero coderivation `D`, over the bar differential `b_A` of `A` for the left coaction and over
`b_B` for the right one.  Split it as `D = D₀ + δ`, where on `w ⊗ x ⊗ v`

`D₀ (w ⊗ x ⊗ v) = b_A w ⊗ x ⊗ v + τ w ⊗ m₁ x ⊗ v + τ w ⊗ τ x ⊗ b_B v`

(`TauCeti.AInfinityBimodule.unaryBarDifferential`) only involves the unary operation, with `τ`
the Koszul twists of the suspended gradings, and the *higher* part `δ`
(`TauCeti.AInfinityBimodule.higherBarDifferential`) applies the operations `b_{i,j}` with
`i + j ≥ 1` to the middle blocks of a word.  Thus `δ` strictly lowers the total length of the two
algebra words, and, unlike `D₀`, it is an odd map of left comodules and a map of right comodules.

This splitting is the input of homological transfer of bimodules,
`TauCeti.AInfinityBimodule.transfer` in `TauCeti.Algebra.Homology.AInfinity.Bimodule.Transfer`,
where `δ` is the perturbation.

## Main definitions

* `TauCeti.AInfinityBimodule.leftUnaryDifferential`: the differential `b_A ⊗ 1 + τ ⊗ d` of
  `Tᶜ(sA) ⊗ M`.
* `TauCeti.AInfinityBimodule.unaryBarDifferential`: the unary part of a bimodule bar differential.
* `TauCeti.AInfinityBimodule.higherTaylor` and `TauCeti.AInfinityBimodule.higherBarDifferential`:
  the operations with at least one algebra input, and the rest of the bar differential.

## Main results

* `TauCeti.AInfinityBimodule.unaryBarDifferential_eq_gradedCoderiv`: the unary part is the
  bicomodule coderivation generated by the unary operation.
* `TauCeti.AInfinityBimodule.higherBarDifferential_tmul_of_tprod`: the higher part applies the
  higher operations to the middle blocks of a word.
* `TauCeti.AInfinityBimodule.isUnit_one_add_higherBarDifferential_mul`: the unit required by the
  perturbation lemma.
* `TauCeti.AInfinityBimodule.leftCoact_comp_higherBarDifferential` and
  `TauCeti.AInfinityBimodule.coact_comp_higherBarDifferential`: the higher part is an odd map of
  left comodules and a map of right comodules.
* `TauCeti.AInfinityBimodule.leftCoact_comp_rTensor_map_koszulTwist` and
  `TauCeti.AInfinityBimodule.leftCoact_comp_rTensor_lTensor`: maps `τ ⊗ g ⊗ 1` and `1 ⊗ g ⊗ 1`
  are odd and even maps of left comodules.

## References

* B. Keller, *Introduction to A-infinity algebras and modules*, Sections 4 and 5.
* V. Lyubashenko and O. Manzyuk, *A-infinity-bimodules and Serre A-infinity-functors*.
-/

public section

open scoped TensorProduct

universe uR uA uB uM uN

namespace TauCeti

open TensorWords

variable {R : Type uR} {A : Type uA} {B : Type uB} {M : Type uM} {N : Type uN}
  [CommRing R] [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

namespace AInfinityBimodule

attribute [local instance] Comodule.cofree

/-- The additive group structure of `Tᶜ(sA) ⊗ (Tᶜ(sA) ⊗ X ⊗ Tᶜ(sB))`, the target of the left
coaction of the bar bicomodule, built on its additive monoid structure.  The structure found by
instance search does not unfold at instance transparency to the additive monoid structure in the
types of the bar maps, because the direct-sum instances of the tensor words go through auxiliary
definitions; this instance lets differences of maps into the left coaction target elaborate. -/
noncomputable local instance leftCoactCarrierAddCommGroup {X : Type*} [AddCommMonoid X]
    [Module R X] :
    AddCommGroup (TensorWords R A ⊗[R] ((TensorWords R A ⊗[R] X) ⊗[R] TensorWords R B)) :=
  Module.addCommMonoidToAddCommGroup R

/-! ### The unary part of the bar differential -/

section Unary

variable (AA : AInfinityAlgebra R A) (BB : AInfinityAlgebra R B) (G : InternalGrading R M ℤ)
  (d : Module.End R M)

/-- The differential `b_A ⊗ 1 + τ ⊗ d` of `Tᶜ(sA) ⊗ M`: the bar differential of `A` on the left
word plus the operator `d` on the module factor, with the Koszul sign `τ` of moving `d` past the
suspended left word. -/
-- `@[expose]` is mandated by the module system: the contraction of `Tᶜ(sA) ⊗ M` in the transfer
-- of bimodules is typed by `leftUnaryDifferential`, which must unfold to the tensor endomorphism
-- `b ⊗ 1 + τ ⊗ d` of `TauCeti.LinearSpecialContraction.lTensor`.
@[expose]
noncomputable def leftUnaryDifferential : Module.End R (TensorWords R A ⊗[R] M) :=
  AA.coaugmentedBarDifferential.rTensor M +
    TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1) d

/-- The left unary differential is `b_A ⊗ 1 + τ ⊗ d`. -/
theorem leftUnaryDifferential_def :
    leftUnaryDifferential AA d = AA.coaugmentedBarDifferential.rTensor M +
      TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1) d := (rfl)

/-- The left unary differential on `w ⊗ x` is `b_A w ⊗ x + τ w ⊗ d x`. -/
@[simp]
theorem leftUnaryDifferential_tmul (w : TensorWords R A) (x : M) :
    leftUnaryDifferential AA d (w ⊗ₜ x) = AA.coaugmentedBarDifferential w ⊗ₜ x +
      TensorWords.map ((AA.grading.shift 1).koszulTwist 1) w ⊗ₜ d x := by
  simp [leftUnaryDifferential_def, koszulTwist_grading]

/-- The **unary part** of the bar differential of an `(A, B)` bimodule with unary operation `d`:
on `w ⊗ x ⊗ v` it is `b_A w ⊗ x ⊗ v + τ w ⊗ d x ⊗ v + τ w ⊗ τ x ⊗ b_B v`, the differential of the
tensor product of the bar construction of `A`, the module `(M, d)` and the bar construction of `B`.
It is the unary part of the right module bar differential over `B` with unary operation
`b_A ⊗ 1 + τ ⊗ d` on `Tᶜ(sA) ⊗ M`. -/
noncomputable def unaryBarDifferential :
    Module.End R ((TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) :=
  AInfinityRightModule.unaryBarDifferential (M := TensorWords R A ⊗[R] M) BB (leftGrading AA G)
    (leftUnaryDifferential AA d)

/-- The unary part is the right module unary part for the left unary differential. -/
theorem unaryBarDifferential_def :
    unaryBarDifferential AA BB G d =
      AInfinityRightModule.unaryBarDifferential (M := TensorWords R A ⊗[R] M) BB
        (leftGrading AA G) (leftUnaryDifferential AA d) := (rfl)

/-- The unary part on `w ⊗ x ⊗ v`. -/
@[simp]
theorem unaryBarDifferential_tmul (w : TensorWords R A) (x : M) (v : TensorWords R B) :
    unaryBarDifferential AA BB G d ((w ⊗ₜ x) ⊗ₜ v) =
      (AA.coaugmentedBarDifferential w ⊗ₜ x +
          TensorWords.map ((AA.grading.shift 1).koszulTwist 1) w ⊗ₜ d x) ⊗ₜ v +
        (TensorWords.map ((AA.grading.shift 1).koszulTwist 1) w ⊗ₜ (G.shift 1).koszulTwist 1 x)
          ⊗ₜ BB.coaugmentedBarDifferential v := by
  rw [unaryBarDifferential_def, AInfinityRightModule.unaryBarDifferential_tmul,
    shift_one_leftGrading, InternalGrading.koszulTwist_tensorProduct, koszulTwist_grading,
    leftUnaryDifferential_tmul, TensorProduct.map_tmul]

/-- The left cofree part of the Taylor map `d ∘ π` is the left unary differential after the
counit of the right word. -/
theorem leftTaylor_comp_taylorProj :
    leftTaylor AA (d ∘ₗ taylorProj R A B M) =
      (TensorProduct.rid R (TensorWords R A ⊗[R] M)).toLinearMap ∘ₗ
        (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor (TensorWords R A ⊗[R] M) ∘ₗ
          (leftUnaryDifferential AA d).rTensor (TensorWords R B) := by
  -- The two-sided counit projection is a map of left comodules onto the cofree comodule
  -- `Tᶜ(sA) ⊗ M`, whose counit undoes its coaction.
  have hcounit : (taylorProj R A B M).lTensor (TensorWords R A) ∘ₗ
        Comodule.leftCoactRTensor (TensorWords R B)
          (Comodule.leftCofreeCoact R (TensorWords R A) M) =
      (TensorProduct.rid R (TensorWords R A ⊗[R] M)).toLinearMap ∘ₗ
        (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor (TensorWords R A ⊗[R] M) := by
    rw [taylorProj_def, LinearMap.lTensor_comp, LinearMap.comp_assoc,
      ← Comodule.comp_rid_comp_lTensor_eq_lTensor_comp_leftCoactRTensor, ← LinearMap.comp_assoc,
      Comodule.lTensor_leftCofreeCounit_comp_leftCofreeCoact, LinearMap.id_comp]
  -- So the twisted coaction term of `leftTaylor` is `τ ⊗ d` after the counit of the right word.
  have hcoact : TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1))
        (d ∘ₗ taylorProj R A B M) ∘ₗ
          Comodule.leftCoactRTensor (TensorWords R B)
            (Comodule.leftCofreeCoact R (TensorWords R A) M) =
      TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1) d ∘ₗ
        (TensorProduct.rid R (TensorWords R A ⊗[R] M)).toLinearMap ∘ₗ
          (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor (TensorWords R A ⊗[R] M) := by
    rw [← LinearMap.map_comp_lTensor, LinearMap.comp_assoc, hcounit, koszulTwist_grading]
  -- The counit of the right word commutes with `(b_A ⊗ 1 + τ ⊗ d) ⊗ 1`.
  rw [Comodule.rid_comp_lTensor_counit_comp_rTensor, leftTaylor_def, hcoact,
    leftUnaryDifferential_def, LinearMap.add_comp, add_comm]

/-- The unary part is the bicomodule coderivation generated by the Taylor map
`w ⊗ x ⊗ v ↦ ε(w) ε(v) d x`. -/
theorem unaryBarDifferential_eq_gradedCoderiv :
    unaryBarDifferential AA BB G d = gradedCoderiv AA BB G (d ∘ₗ taylorProj R A B M) := by
  rw [unaryBarDifferential_def, AInfinityRightModule.unaryBarDifferential_eq_gradedCoderiv,
    gradedCoderiv_eq_rightModule_gradedCoderiv, leftTaylor_comp_taylorProj]

/-- The unary part is a coderivation over the bar differential of `A` for the left coaction. -/
theorem isLeftGradedCoderivationOver_unaryBarDifferential :
    Comodule.IsLeftGradedCoderivationOver
      (Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M))
      (TensorWords.grading (AA.grading.shift 1)) 1 AA.coaugmentedBarDifferential
      (unaryBarDifferential AA BB G d) := by
  rw [unaryBarDifferential_eq_gradedCoderiv]
  exact isLeftGradedCoderivationOver_gradedCoderiv _ _ _ _

/-- The unary part is a coderivation over the bar differential of `B` for the right coaction. -/
theorem isGradedCoderivationOver_unaryBarDifferential :
    Comodule.IsGradedCoderivationOver (barGrading AA BB G) 1 BB.coaugmentedBarDifferential
      (unaryBarDifferential AA BB G d) := by
  rw [unaryBarDifferential_eq_gradedCoderiv]
  exact isGradedCoderivationOver_gradedCoderiv _ _ _ _

/-- The bar differential of `A` has degree one for the grading of the suspended words. -/
theorem isHomogeneous_coaugmentedBarDifferential_grading :
    LinearMap.IsHomogeneous AA.coaugmentedBarDifferential
      (TensorWords.grading (AA.grading.shift 1)).piece
      (TensorWords.grading (AA.grading.shift 1)).piece 1 := by
  simpa only [grading_piece] using AA.isHomogeneous_coaugmentedBarDifferential

/-- The Koszul twist of the suspended words anticommutes with the bar differential of `A`. -/
private theorem map_koszulTwist_coaugmentedBarDifferential (w : TensorWords R A) :
    TensorWords.map ((AA.grading.shift 1).koszulTwist 1) (AA.coaugmentedBarDifferential w) =
      -AA.coaugmentedBarDifferential (TensorWords.map ((AA.grading.shift 1).koszulTwist 1) w) := by
  rw [← koszulTwist_grading]
  simpa using (isHomogeneous_coaugmentedBarDifferential_grading AA).koszulTwist_apply 1 w

variable {d}

/-- The left unary differential has degree one when `d` does for the suspended grading. -/
theorem isHomogeneous_leftUnaryDifferential
    (hd : LinearMap.IsHomogeneous d (G.shift 1).piece (G.shift 1).piece 1) :
    LinearMap.IsHomogeneous (leftUnaryDifferential AA d) ((leftGrading AA G).shift 1).piece
      ((leftGrading AA G).shift 1).piece 1 := by
  let W := TensorWords.grading (AA.grading.shift 1)
  have hτ : LinearMap.IsHomogeneous (W.koszulTwist 1) W.piece W.piece 0 :=
    LinearMap.isHomogeneous_def.2 fun _ _ hx ↦ by
      simpa only [add_zero] using W.koszulTwist_mem_piece hx 1
  rw [shift_one_leftGrading, leftUnaryDifferential_def]
  simpa only [zero_add] using
    ((isHomogeneous_coaugmentedBarDifferential_grading AA).rTensor (G.shift 1)).add
      (hτ.tensorProduct hd)

/-- The left unary differential squares to zero when `d` does, since the Koszul twist
anticommutes with the bar differential of `A`. -/
theorem leftUnaryDifferential_comp_self (hdd : d ∘ₗ d = 0) :
    leftUnaryDifferential AA d ∘ₗ leftUnaryDifferential AA d = 0 := by
  refine TensorProduct.ext' fun w x ↦ ?_
  have hdd := LinearMap.congr_fun hdd x
  have hbb := LinearMap.congr_fun AA.coaugmentedBarDifferential_sq w
  have hττ : TensorWords.map ((AA.grading.shift 1).koszulTwist 1)
      (TensorWords.map ((AA.grading.shift 1).koszulTwist 1) w) = w := by
    rw [← koszulTwist_grading, InternalGrading.koszulTwist_koszulTwist]
  simp only [LinearMap.comp_apply, LinearMap.zero_apply] at hdd hbb
  simp only [LinearMap.comp_apply, leftUnaryDifferential_tmul, map_add, LinearMap.zero_apply,
    hdd, hbb, hττ, map_koszulTwist_coaugmentedBarDifferential, TensorProduct.zero_tmul,
    TensorProduct.tmul_zero, TensorProduct.neg_tmul]
  abel

/-- The unary part has degree one when `d` does for the suspended grading. -/
theorem isHomogeneous_unaryBarDifferential
    (hd : LinearMap.IsHomogeneous d (G.shift 1).piece (G.shift 1).piece 1) :
    LinearMap.IsHomogeneous (unaryBarDifferential AA BB G d) (barGrading AA BB G).piece
      (barGrading AA BB G).piece 1 := by
  have h := AInfinityRightModule.isHomogeneous_unaryBarDifferential (M := TensorWords R A ⊗[R] M)
    BB (leftGrading AA G) (isHomogeneous_leftUnaryDifferential AA G hd)
  rwa [rightModule_barGrading_leftGrading] at h

/-- The unary part squares to zero when `d` has degree one and squares to zero. -/
theorem unaryBarDifferential_comp_self
    (hd : LinearMap.IsHomogeneous d (G.shift 1).piece (G.shift 1).piece 1) (hdd : d ∘ₗ d = 0) :
    unaryBarDifferential AA BB G d ∘ₗ unaryBarDifferential AA BB G d = 0 := by
  rw [unaryBarDifferential_def]
  exact AInfinityRightModule.unaryBarDifferential_comp_self (M := TensorWords R A ⊗[R] M) BB
    (leftGrading AA G) (isHomogeneous_leftUnaryDifferential AA G hd)
    (leftUnaryDifferential_comp_self AA hdd)

end Unary

/-! ### The higher part of the bar differential -/

section Higher

variable {AA : AInfinityAlgebra R A} {BB : AInfinityAlgebra R B} (MM : AInfinityBimodule AA BB M)

/-- The differential of a bimodule has degree one for the suspended grading. -/
private theorem isHomogeneous_differential_shift :
    LinearMap.IsHomogeneous MM.differential (MM.grading.shift 1).piece
      (MM.grading.shift 1).piece 1 :=
  LinearMap.isHomogeneous_shift_piece_iff.2 MM.isHomogeneous_differential

/-- The **higher Taylor map** of a bimodule: its Taylor map minus the unary operation, that is,
the suspended operations `b_{i,j}` with `i + j ≥ 1`. -/
noncomputable def higherTaylor : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M :=
  MM.taylor - MM.differential ∘ₗ taylorProj R A B M

/-- The higher Taylor map is the Taylor map minus the unary operation after both counits. -/
theorem higherTaylor_def :
    MM.higherTaylor = MM.taylor - MM.differential ∘ₗ taylorProj R A B M := (rfl)

/-- The higher Taylor map vanishes on the two empty words. -/
@[simp]
theorem higherTaylor_one_tmul_tmul_one (x : M) : MM.higherTaylor ((1 ⊗ₜ x) ⊗ₜ 1) = 0 := by
  rw [higherTaylor_def, LinearMap.sub_apply, LinearMap.comp_apply, ← differential_apply,
    taylorProj_tmul]
  simp [TensorWords.counit_eq_counit, TensorWords.counit_one]

/-- The **higher part** of the bar differential of a bimodule: the difference between the bar
differential and its unary part.  It applies the operations with at least one algebra input
(`TauCeti.AInfinityBimodule.higherBarDifferential_tmul_of_tprod`). -/
noncomputable def higherBarDifferential :
    Module.End R ((TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) :=
  MM.barDifferential - unaryBarDifferential AA BB MM.grading MM.differential

/-- The higher part is the bar differential minus its unary part. -/
theorem higherBarDifferential_def :
    MM.higherBarDifferential =
      MM.barDifferential - unaryBarDifferential AA BB MM.grading MM.differential := (rfl)

/-- The bar differential is the sum of its unary and higher parts. -/
theorem unaryBarDifferential_add_higherBarDifferential :
    unaryBarDifferential AA BB MM.grading MM.differential + MM.higherBarDifferential =
      MM.barDifferential :=
  add_sub_cancel _ _

/-- The left cofree parts of two Taylor maps differ by the twisted left coaction followed by the
difference of the Taylor maps. -/
private theorem leftTaylor_eq_leftTaylor_add
    (F F' : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    leftTaylor AA F =
      leftTaylor AA F' +
        TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1)) (F - F') ∘ₗ
          Comodule.leftCoactRTensor (TensorWords R B)
            (Comodule.leftCofreeCoact R (TensorWords R A) M) := by
  conv_lhs => rw [← add_sub_cancel F' F]
  rw [leftTaylor_def, leftTaylor_def, TensorProduct.map_add_right, LinearMap.add_comp]
  abel

/-- The left cofree part of `F - F'` on a pure left word, before the module input. -/
private theorem map_comp_leftCoactRTensor_tmul_of_tprod
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) (i : ℕ) (a : Fin i → A) (x : M)
    (u : TensorWords R B) :
    (TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1)) F ∘ₗ
        Comodule.leftCoactRTensor (TensorWords R B)
          (Comodule.leftCofreeCoact R (TensorWords R A) M))
        ((TensorWords.of R A i (PiTensorProduct.tprod R a) ⊗ₜ x) ⊗ₜ u) =
      ∑ l ∈ Finset.range (i + 1),
        subword R (fun t ↦ (AA.grading.shift 1).koszulTwist 1 (a t)) 0 l ⊗ₜ
          F ((subword R a l (i - l) ⊗ₜ x) ⊗ₜ u) := by
  rw [of_tprod_eq_subword]
  simp [Comodule.leftCofreeCoact_tmul, comul_eq_deconcatenation, deconcatenation_subword,
    TensorProduct.sum_tmul, map_subword]

/-- The higher part on a pure tensor `(a₁ ⋯ aᵢ) ⊗ x ⊗ (b₁ ⋯ bⱼ)`: the higher Taylor map applied to
every middle block `a_{l+1} ⋯ aᵢ ⊗ x ⊗ b₁ ⋯ b_k`, with the twisted prefix on the left and the
suffix on the right. -/
theorem higherBarDifferential_tmul_of_tprod (i j : ℕ) (a : Fin i → A) (x : M) (b : Fin j → B) :
    MM.higherBarDifferential
        ((TensorWords.of R A i (PiTensorProduct.tprod R a) ⊗ₜ x) ⊗ₜ
          TensorWords.of R B j (PiTensorProduct.tprod R b)) =
      ∑ k ∈ Finset.range (j + 1), ∑ l ∈ Finset.range (i + 1),
        (subword R (fun t ↦ (AA.grading.shift 1).koszulTwist 1 (a t)) 0 l ⊗ₜ
          MM.higherTaylor ((subword R a l (i - l) ⊗ₜ x) ⊗ₜ subword R b 0 k)) ⊗ₜ
            subword R b k (j - k) := by
  -- Both parts are coderivations, expanded over the deconcatenation of the right word: they
  -- apply the left cofree parts of their Taylor maps to each prefix, and their `b_B` terms cancel.
  have hexpand : MM.higherBarDifferential
        ((TensorWords.of R A i (PiTensorProduct.tprod R a) ⊗ₜ x) ⊗ₜ
          TensorWords.of R B j (PiTensorProduct.tprod R b)) =
      ∑ k ∈ Finset.range (j + 1),
        (leftTaylor AA MM.taylor
              ((TensorWords.of R A i (PiTensorProduct.tprod R a) ⊗ₜ x) ⊗ₜ subword R b 0 k) ⊗ₜ
            subword R b k (j - k) -
          leftTaylor AA (MM.differential ∘ₗ taylorProj R A B M)
              ((TensorWords.of R A i (PiTensorProduct.tprod R a) ⊗ₜ x) ⊗ₜ subword R b 0 k) ⊗ₜ
            subword R b k (j - k)) := by
    rw [higherBarDifferential_def, LinearMap.sub_apply, barDifferential_eq,
      unaryBarDifferential_eq_gradedCoderiv, gradedCoderiv_eq_rightModule_gradedCoderiv,
      gradedCoderiv_eq_rightModule_gradedCoderiv,
      AInfinityRightModule.gradedCoderiv_tmul_of_tprod,
      AInfinityRightModule.gradedCoderiv_tmul_of_tprod, add_sub_add_right_eq_sub,
      ← Finset.sum_sub_distrib]
  -- The two left cofree parts differ by the twisted left coaction followed by the higher Taylor
  -- map.
  have hleft :
      leftTaylor AA MM.taylor =
        leftTaylor AA (MM.differential ∘ₗ taylorProj R A B M) +
          TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1))
              MM.higherTaylor ∘ₗ
            Comodule.leftCoactRTensor (TensorWords R B)
              (Comodule.leftCofreeCoact R (TensorWords R A) M) :=
    leftTaylor_eq_leftTaylor_add _ _
  -- On a pure left word, that coaction deconcatenates the word around the middle block.
  rw [hexpand]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [hleft, LinearMap.add_apply, TensorProduct.add_tmul, add_sub_cancel_left,
    map_comp_leftCoactRTensor_tmul_of_tprod, TensorProduct.sum_tmul]

/-- **Local nilpotence.**  Followed by any map `τ ⊗ e ⊗ 1` acting on the module input, with `τ`
the Koszul twist of the left word, the higher part is locally nilpotent, since it strictly lowers
the total length of the two algebra words. -/
theorem exists_pow_higherBarDifferential_comp_apply_eq_zero (e : Module.End R M)
    (z : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) :
    ∃ n, ((MM.higherBarDifferential ∘ₗ
      (TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1) e).rTensor
        (TensorWords R B)) ^ n) z = 0 := by
  set f : Module.End R ((TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) :=
    MM.higherBarDifferential ∘ₗ
      (TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1) e).rTensor
        (TensorWords R B) with hf
  -- The vectors killed by a power of `f` form the submodule `P`.
  let P := Module.End.maxGenEigenspace f 0
  have hmem (z) : z ∈ P ↔ ∃ n, (f ^ n) z = 0 := by
    simp only [P, Module.End.mem_maxGenEigenspace, zero_smul, sub_zero]
  -- By strong induction on the total word length, `f` sends a pure tensor into `P`.
  have hpure : ∀ n i j (a : Fin i → A) (x : M) (b : Fin j → B), i + j ≤ n →
      (TensorWords.of R A i (PiTensorProduct.tprod R a) ⊗ₜ x) ⊗ₜ
        TensorWords.of R B j (PiTensorProduct.tprod R b) ∈ P := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro i j a x b hij
      have hfz : f ((TensorWords.of R A i (PiTensorProduct.tprod R a) ⊗ₜ x) ⊗ₜ
          TensorWords.of R B j (PiTensorProduct.tprod R b)) ∈ P := by
        rw [hf, LinearMap.comp_apply, LinearMap.rTensor_tmul, TensorProduct.map_tmul,
          koszulTwist_grading, map_of_tprod, higherBarDifferential_tmul_of_tprod]
        refine Submodule.sum_mem _ fun k hk ↦ Submodule.sum_mem _ fun l hl ↦ ?_
        have hk := Finset.mem_range.1 hk
        have hl := Finset.mem_range.1 hl
        by_cases h0 : l = i ∧ k = 0
        · obtain ⟨rfl, rfl⟩ := h0
          rw [Nat.sub_self, subword_length_zero R _ le_rfl, subword_length_zero R b (Nat.zero_le j),
            higherTaylor_one_tmul_tmul_one, TensorProduct.tmul_zero, TensorProduct.zero_tmul]
          exact P.zero_mem
        · rw [subword_eq_of_tprod R _ (by omega : 0 + l ≤ i),
            subword_eq_of_tprod R b (by omega : k + (j - k) ≤ j)]
          exact ih (l + (j - k)) (by omega) _ _ _ _ _ le_rfl
      obtain ⟨m, hm⟩ := (hmem _).1 hfz
      exact (hmem _).2 ⟨m + 1, by rw [pow_succ, mul_apply_eq_comp, hm]⟩
  have hP : P.mkQ = 0 := TensorWords.linearMap_ext_threefold R A fun i j a x b ↦ by
    rw [Submodule.mkQ_apply, LinearMap.zero_apply, Submodule.Quotient.mk_eq_zero]
    exact hpure _ i j a x b le_rfl
  have hz := LinearMap.congr_fun hP z
  rw [Submodule.mkQ_apply, LinearMap.zero_apply, Submodule.Quotient.mk_eq_zero] at hz
  exact (hmem z).1 hz

/-- The unit required by the perturbation lemma: `1 + δ (τ ⊗ e ⊗ 1)` is invertible. -/
theorem isUnit_one_add_higherBarDifferential_mul (e : Module.End R M) :
    IsUnit (1 + MM.higherBarDifferential *
      (TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1) e).rTensor
        (TensorWords R B)) :=
  Module.End.isUnit_one_add_of_forall_exists_pow_apply_eq_zero _
    (MM.exists_pow_higherBarDifferential_comp_apply_eq_zero e)

/-- The higher part is an odd map of left comodules: it is the difference of two coderivations
over the same bar differential of `A`. -/
theorem leftCoact_comp_higherBarDifferential :
    Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M) ∘ₗ MM.higherBarDifferential =
      TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1)
          MM.higherBarDifferential ∘ₗ
        Comodule.leftCoactRTensor (TensorWords R B)
          (Comodule.leftCofreeCoact R (TensorWords R A) M) := by
  refine LinearMap.ext fun z ↦ ?_
  have e1 := MM.isLeftGradedCoderivation_barDifferential.coact_apply z
  have e2 := (isLeftGradedCoderivationOver_unaryBarDifferential AA BB MM.grading
    MM.differential).coact_apply z
  rw [← MM.unaryBarDifferential_add_higherBarDifferential] at e1
  simp only [LinearMap.add_apply, map_add, TensorProduct.map_add_right] at e1
  rw [e2, ← add_assoc] at e1
  exact add_left_cancel e1

/-- The higher part commutes with the right coaction: it is the difference of two coderivations
over the same bar differential of `B`. -/
theorem coact_comp_higherBarDifferential :
    Comodule.coact (R := R) (C := TensorWords R B)
        (M := (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) ∘ₗ MM.higherBarDifferential =
      MM.higherBarDifferential.rTensor (TensorWords R B) ∘ₗ
        Comodule.coact (R := R) (C := TensorWords R B)
          (M := (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B) := by
  refine LinearMap.ext fun z ↦ ?_
  have e1 := MM.isGradedCoderivation_barDifferential.coact_apply z
  have e2 := (isGradedCoderivationOver_unaryBarDifferential AA BB MM.grading
    MM.differential).coact_apply z
  rw [← MM.unaryBarDifferential_add_higherBarDifferential] at e1
  simp only [LinearMap.add_apply, map_add, LinearMap.rTensor_add] at e1
  rw [e2] at e1
  exact add_left_cancel (e1.trans (add_right_comm _ _ _))

/-- The higher part vanishes on the two empty words. -/
@[simp]
theorem higherBarDifferential_one_tmul_tmul_one (x : M) :
    MM.higherBarDifferential ((1 ⊗ₜ x) ⊗ₜ (1 : TensorWords R B)) = 0 := by
  have hA : TensorWords.of R A 0 (PiTensorProduct.tprod R (fun i ↦ i.elim0 : Fin 0 → A)) = 1 := by
    rw [of_tprod_eq_subword, subword_length_zero R _ le_rfl]
  have hB : TensorWords.of R B 0 (PiTensorProduct.tprod R (fun i ↦ i.elim0 : Fin 0 → B)) = 1 := by
    rw [of_tprod_eq_subword, subword_length_zero R _ le_rfl]
  rw [← hA, ← hB, higherBarDifferential_tmul_of_tprod]
  simp [subword_length_zero]

end Higher

/-! ### Odd and even maps of left comodules -/

section LeftComodule

variable {AA : AInfinityAlgebra R A} {P Q : Type*} [AddCommGroup P] [Module R P] [AddCommGroup Q]
  [Module R Q]

/-- A map `τ ⊗ g ⊗ 1` on the cofree bicomodule, with `τ` the Koszul twist of the left word, is an
odd map of left comodules. -/
theorem leftCoact_comp_rTensor_map_koszulTwist (g : P →ₗ[R] Q) :
    Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) Q) ∘ₗ
      (TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1) g).rTensor
        (TensorWords R B) =
      TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1)
          ((TensorProduct.map ((TensorWords.grading (AA.grading.shift 1)).koszulTwist 1) g).rTensor
            (TensorWords R B)) ∘ₗ
        Comodule.leftCoactRTensor (TensorWords R B)
          (Comodule.leftCofreeCoact R (TensorWords R A) P) := by
  have hτ : Coalgebra.comul ∘ₗ TensorWords.map ((AA.grading.shift 1).koszulTwist 1) =
      TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1))
          (TensorWords.map ((AA.grading.shift 1).koszulTwist 1)) ∘ₗ
        (Coalgebra.comul : TensorWords R A →ₗ[R] TensorWords R A ⊗[R] TensorWords R A) := by
    rw [comul_eq_deconcatenation, deconcatenation_natural]
  have h := Comodule.leftCoactRTensor_comp_lTensor_comp_rTensor_map hτ g
    (LinearMap.id : TensorWords R B →ₗ[R] TensorWords R B)
  simpa only [LinearMap.lTensor_id, LinearMap.id_comp, ← koszulTwist_grading] using h

/-- A map `1 ⊗ g ⊗ 1` on the cofree bicomodule is a map of left comodules. -/
theorem leftCoact_comp_rTensor_lTensor (g : P →ₗ[R] Q) :
    Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) Q) ∘ₗ
      (g.lTensor (TensorWords R A)).rTensor (TensorWords R B) =
      ((g.lTensor (TensorWords R A)).rTensor (TensorWords R B)).lTensor (TensorWords R A) ∘ₗ
        Comodule.leftCoactRTensor (TensorWords R B)
          (Comodule.leftCofreeCoact R (TensorWords R A) P) := by
  have h := Comodule.leftCoactRTensor_comp_lTensor_comp_rTensor_map
    (τ := (LinearMap.id : TensorWords R A →ₗ[R] TensorWords R A))
    (by rw [LinearMap.comp_id, TensorProduct.map_id, LinearMap.id_comp]) g
    (LinearMap.id : TensorWords R B →ₗ[R] TensorWords R B)
  simpa only [LinearMap.lTensor_id, LinearMap.id_comp, ← LinearMap.lTensor_def] using h

end LeftComodule

