module

public import TauCeti.Algebra.Homology.AInfinity.Bimodule.Basic
public import TauCeti.Algebra.Homology.AInfinity.Module.Right.Components

/-!
# A-infinity bimodules from their Taylor maps

An `(A, B)` `A∞` bimodule is stored as a square-zero degree-one coderivation of the cofree bar
bicomodule `Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB)`, and by cofreeness on both sides such a coderivation is determined
by its Taylor map `F : Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB) → sM`, the family of suspended operations `b_{i,j}`.
This file constructs the coderivation generated by an arbitrary Taylor map, and with it the
bimodule determined by a Taylor map satisfying the bimodule Stasheff identities.

On `w ⊗ m ⊗ v` the coderivation generated by `F` is

`∑ (-1)^{|w'|} w' ⊗ F(w'' ⊗ m ⊗ v') ⊗ v'' + b_A(w) ⊗ m ⊗ v + (-1)^{|w| + |m|} w ⊗ m ⊗ b_B(v)`,

summed over the deconcatenations `w = w' w''` and `v = v' v''`, with suspended degrees.  It is
assembled in two steps, which identify the bar bicomodule of an `(A, B)` bimodule with the bar
comodule of a right `B`-module on the left cofree comodule `Tᶜ(sA) ⊗ sM`.

* `leftTaylor F : Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB) → Tᶜ(sA) ⊗ sM` collects the terms that do not involve the
  bar differential of `B` and keep the right word whole: `F` applied after deconcatenating the left
  word, plus the bar differential of `A` on the left word when the right word is empty.
* `gradedCoderiv` is the right-module coderivation over the bar differential of `B`
  (`TauCeti.AInfinityRightModule.gradedCoderiv`) generated by `leftTaylor F`.  This gives the right
  co-Leibniz law for free.  The left co-Leibniz law follows from coassociativity of
  deconcatenation, from the co-Leibniz law of the bar differential of `A`, and from the fact that
  the left and right coactions of the cofree bicomodule commute.

## Main definitions

* `TauCeti.AInfinityBimodule.leftTaylor`: the left cofree part of the coderivation generated by a
  Taylor map.
* `TauCeti.AInfinityBimodule.gradedCoderiv`: the bicomodule coderivation generated by a Taylor
  map.
* `TauCeti.AInfinityBimodule.ofTaylor`: the bimodule determined by a Taylor map whose generated
  coderivation squares to zero, checked on the Taylor component.

## Main results

* `TauCeti.AInfinityBimodule.isLeftGradedCoderivationOver_gradedCoderiv` and
  `TauCeti.AInfinityBimodule.isGradedCoderivationOver_gradedCoderiv`: the map generated by `F` is
  a coderivation over the bar differential of `A` for the left coaction and over the bar
  differential of `B` for the right coaction.
* `TauCeti.AInfinityBimodule.taylorProj_comp_gradedCoderiv`: its Taylor component is `F`.
* `TauCeti.AInfinityBimodule.barDifferential_eq` and `TauCeti.AInfinityBimodule.ofTaylor_self`:
  the bar differential of a bimodule is the coderivation generated by its Taylor map, and every
  bimodule is built from its Taylor map.

## References

* E. Getzler and J. D. S. Jones, *A-infinity algebras and the cyclic bar complex*, Sections 1--2.
* B. Keller, *Introduction to A-infinity algebras and modules*, Sections 3--5.
* V. Lyubashenko and O. Manzyuk, *A-infinity-bimodules and Serre A-infinity-functors*.
-/

public section

open scoped TensorProduct

namespace TauCeti

universe uR uA uB uM

variable {R : Type uR} {A : Type uA} {B : Type uB} {M : Type uM}
  [CommRing R] [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B]
  [AddCommGroup M] [Module R M]

namespace AInfinityBimodule

open TensorWords

section LeftTaylor

variable (AA : AInfinityAlgebra R A)

/-- The left cofree part of the coderivation generated by a Taylor map
`F : Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB) → sM`.  On `w ⊗ m ⊗ v` it is
`∑ (-1)^{|w'|} w' ⊗ F(w'' ⊗ m ⊗ v) + ε(v) • b_A(w) ⊗ m`, summed over the deconcatenations
`w = w' w''`, where `ε` is the counit of `Tᶜ(sB)`.  The bimodule coderivation generated by `F` is
the right-module coderivation over the bar differential of `B` generated by this map. -/
noncomputable def leftTaylor (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] TensorWords R A ⊗[R] M :=
  TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1)) F ∘ₗ
      Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M) +
    AA.coaugmentedBarDifferential.rTensor M ∘ₗ
      (TensorProduct.rid R (TensorWords R A ⊗[R] M)).toLinearMap ∘ₗ
        (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor (TensorWords R A ⊗[R] M)

/-- The left cofree part applies `F` after the twisted left coaction, and adds the bar
differential of `A` after the counit of the right words. -/
theorem leftTaylor_def (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    leftTaylor AA F =
      TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1)) F ∘ₗ
          Comodule.leftCoactRTensor (TensorWords R B)
            (Comodule.leftCofreeCoact R (TensorWords R A) M) +
        AA.coaugmentedBarDifferential.rTensor M ∘ₗ
          (TensorProduct.rid R (TensorWords R A ⊗[R] M)).toLinearMap ∘ₗ
            (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor (TensorWords R A ⊗[R] M) :=
  (rfl)

/-- The letterwise Koszul twist of the suspended words is compatible with deconcatenation. -/
private theorem comul_comp_map_koszulTwist :
    Coalgebra.comul ∘ₗ TensorWords.map ((AA.grading.shift 1).koszulTwist 1) =
      TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1))
          (TensorWords.map ((AA.grading.shift 1).koszulTwist 1)) ∘ₗ
        (Coalgebra.comul : TensorWords R A →ₗ[R] TensorWords R A ⊗[R] TensorWords R A) := by
  rw [comul_eq_deconcatenation, deconcatenation_natural]

/-- The co-Leibniz law of the bar differential of `A`, in the form used by the cofree left
coaction. -/
private theorem comul_comp_coaugmentedBarDifferential :
    Coalgebra.comul ∘ₗ AA.coaugmentedBarDifferential =
      AA.coaugmentedBarDifferential.rTensor (TensorWords R A) ∘ₗ Coalgebra.comul +
        TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1))
            AA.coaugmentedBarDifferential ∘ₗ Coalgebra.comul := by
  rw [comul_eq_deconcatenation,
    isGradedCoderivation_iff.mp AA.isGradedCoderivation_coaugmentedBarDifferential,
    LinearMap.lTensor_comp_rTensor]

/-- The left co-Leibniz law of the left cofree part: after the cofree left coaction, it splits into
the bar differential of `A` on the coalgebra factor, with the right word removed by the counit,
and the twisted left cofree part on the remaining factor. -/
theorem leftCofreeCoact_comp_leftTaylor
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    Comodule.leftCofreeCoact R (TensorWords R A) M ∘ₗ leftTaylor AA F =
      TensorProduct.map AA.coaugmentedBarDifferential
          ((TensorProduct.rid R (TensorWords R A ⊗[R] M)).toLinearMap ∘ₗ
            (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor
              (TensorWords R A ⊗[R] M)) ∘ₗ
          Comodule.leftCoactRTensor (TensorWords R B)
            (Comodule.leftCofreeCoact R (TensorWords R A) M) +
        TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1))
            (leftTaylor AA F) ∘ₗ
          Comodule.leftCoactRTensor (TensorWords R B)
            (Comodule.leftCofreeCoact R (TensorWords R A) M) := by
  have h1 := Comodule.leftCofreeCoact_comp_map (comul_comp_map_koszulTwist AA) F
  have h2 := Comodule.leftCofreeCoact_comp_rTensor (P := M)
    (comul_comp_coaugmentedBarDifferential AA)
  have h3 := Comodule.comp_rid_comp_lTensor_eq_lTensor_comp_leftCoactRTensor
    (Comodule.leftCofreeCoact R (TensorWords R A) M)
    (Coalgebra.counit (R := R) (A := TensorWords R B))
  -- Pass the coaction through the outer maps, then through the inner ones, then regroup.
  simp only [leftTaylor_def, LinearMap.comp_add, LinearMap.add_comp, TensorProduct.map_add_right,
    ← LinearMap.comp_assoc, h1, h2]
  simp only [LinearMap.comp_assoc, h3,
    Comodule.leftCofreeCoact_comp_leftCoactRTensor_leftCofreeCoact]
  simp only [← LinearMap.comp_assoc, LinearMap.map_comp_lTensor, LinearMap.rTensor_comp_lTensor]
  abel

/-- The counit projection of the left cofree comodule recovers `F` from the left cofree part: the
bar differential of `A` has no counit component. -/
@[simp]
theorem leftCofreeCounit_comp_leftTaylor
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    Comodule.leftCofreeCounit R (TensorWords R A) M ∘ₗ leftTaylor AA F = F := by
  have hτ : Coalgebra.counit ∘ₗ TensorWords.map ((AA.grading.shift 1).koszulTwist 1) =
      (Coalgebra.counit : TensorWords R A →ₗ[R] R) := by
    rw [counit_eq_counit, counit_comp_map]
  have hb : Comodule.leftCofreeCounit R (TensorWords R A) M ∘ₗ
      AA.coaugmentedBarDifferential.rTensor M = 0 := by
    simp only [Comodule.leftCofreeCounit_def, LinearMap.comp_assoc, ← LinearMap.rTensor_comp,
      counit_eq_counit, AA.isGradedCoderivation_coaugmentedBarDifferential.counit_comp,
      LinearMap.rTensor_zero, LinearMap.comp_zero]
  simp only [leftTaylor_def, LinearMap.comp_add, ← LinearMap.comp_assoc,
    Comodule.leftCofreeCounit_comp_map hτ, hb, LinearMap.zero_comp, add_zero]
  rw [LinearMap.comp_assoc, Comodule.leftCofreeCounit_comp_leftCoactRTensor_leftCofreeCoact,
    LinearMap.comp_id]

end LeftTaylor

section Coderivation

attribute [local instance] Comodule.cofree

variable (AA : AInfinityAlgebra R A) (BB : AInfinityAlgebra R B)

/-- The grading on `Tᶜ(sA) ⊗ M` whose suspension is the total grading of `Tᶜ(sA) ⊗ sM`.  With it,
`Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB)` is the cofree bar comodule of a right `B`-module on `Tᶜ(sA) ⊗ M`. -/
private noncomputable def leftGrading (G : InternalGrading R M) :
    InternalGrading R (TensorWords R A ⊗[R] M) :=
  ((TensorWords.grading (AA.grading.shift 1)).tensorProduct (G.shift 1)).shift (-1)

private theorem shift_one_leftGrading (G : InternalGrading R M) :
    (leftGrading AA G).shift 1 =
      (TensorWords.grading (AA.grading.shift 1)).tensorProduct (G.shift 1) := by
  rw [leftGrading, InternalGrading.shift_shift, add_neg_cancel, InternalGrading.shift_zero]

private theorem rightModule_barGrading_leftGrading (G : InternalGrading R M) :
    AInfinityRightModule.barGrading (M := TensorWords R A ⊗[R] M) BB (leftGrading AA G) =
      barGrading AA BB G := by
  ext p
  rw [AInfinityRightModule.barGrading_piece, shift_one_leftGrading, barGrading_piece]

/-- The bicomodule coderivation generated by a Taylor map `F : Tᶜ(sA) ⊗ sM ⊗ Tᶜ(sB) → sM`: the
coderivation over the bar differentials of `AA` and `BB` whose Taylor component is `F`
(`TauCeti.AInfinityBimodule.taylorProj_comp_gradedCoderiv`).  It is the right-module coderivation
over the bar differential of `BB` generated by the left cofree part `leftTaylor AA F`. -/
noncomputable def gradedCoderiv (G : InternalGrading R M)
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R]
      (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B :=
  AInfinityRightModule.gradedCoderiv (M := TensorWords R A ⊗[R] M) BB (leftGrading AA G)
    (leftTaylor AA F)

/-- The coderivation generated by `F` applies the left cofree part `leftTaylor AA F` to each prefix
of the deconcatenation of the right word, and adds the bar differential of `BB` on the right word,
with the Koszul sign of moving it past the suspended left word and module factor. -/
theorem gradedCoderiv_def (G : InternalGrading R M)
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    gradedCoderiv AA BB G F =
      (leftTaylor AA F).rTensor (TensorWords R B) ∘ₗ
          (TensorProduct.assoc R (TensorWords R A ⊗[R] M) (TensorWords R B)
            (TensorWords R B)).symm.toLinearMap ∘ₗ
            Coalgebra.comul.lTensor (TensorWords R A ⊗[R] M) +
        BB.coaugmentedBarDifferential.lTensor (TensorWords R A ⊗[R] M) ∘ₗ
          (TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1))
            ((G.shift 1).koszulTwist 1)).rTensor (TensorWords R B) := by
  rw [gradedCoderiv, AInfinityRightModule.gradedCoderiv_def, shift_one_leftGrading,
    InternalGrading.koszulTwist_tensorProduct, koszulTwist_grading, comul_eq_deconcatenation]

/-- The coderivation generated by a degree-one Taylor map has degree one. -/
theorem isHomogeneous_gradedCoderiv (G : InternalGrading R M)
    {F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M}
    (hF : LinearMap.IsHomogeneous F (barGrading AA BB G).piece (G.shift 1).piece 1) :
    LinearMap.IsHomogeneous (gradedCoderiv AA BB G F) (barGrading AA BB G).piece
      (barGrading AA BB G).piece 1 := by
  let W := TensorWords.grading (AA.grading.shift 1)
  let Y := W.tensorProduct (G.shift 1)
  let V := TensorWords.grading (BB.grading.shift 1)
  have hX : barGrading AA BB G = Y.tensorProduct V := barGrading_def AA BB G
  -- The left cofree part has degree one into the total grading of `Tᶜ(sA) ⊗ sM`.
  have hL : LinearMap.IsHomogeneous (leftTaylor AA F) (barGrading AA BB G).piece
      ((leftGrading AA G).shift 1).piece 1 := by
    rw [shift_one_leftGrading, hX]
    rw [hX] at hF
    have hδ : LinearMap.IsHomogeneous (Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M)) (Y.tensorProduct V).piece
        (W.tensorProduct (Y.tensorProduct V)).piece 0 := by
      rw [Comodule.leftCoactRTensor_def, Comodule.leftCofreeCoact_def, LinearMap.rTensor_def,
        LinearMap.rTensor_def, comul_eq_deconcatenation]
      simpa only [add_zero] using (InternalGrading.isHomogeneous_assoc W Y V).comp
        ((((InternalGrading.isHomogeneous_assoc W W (G.shift 1)).comp
          ((isHomogeneous_deconcatenation (AA.grading.shift 1)).tensorProduct
            (LinearMap.isHomogeneous_id (G.shift 1).piece))).tensorProduct
              (LinearMap.isHomogeneous_id V.piece)))
    have hτ : LinearMap.IsHomogeneous (TensorWords.map ((AA.grading.shift 1).koszulTwist 1))
        W.piece W.piece 0 := by
      rw [← koszulTwist_grading]
      exact LinearMap.isHomogeneous_def.2 fun _ _ hx ↦ by
        simpa only [add_zero] using W.koszulTwist_mem_piece hx 1
    have hb : LinearMap.IsHomogeneous AA.coaugmentedBarDifferential W.piece W.piece 1 := by
      simpa only [W, grading_piece] using AA.isHomogeneous_coaugmentedBarDifferential
    have h1 := (hτ.tensorProduct hF).comp hδ
    have h2 := (hb.tensorProduct (LinearMap.isHomogeneous_id (G.shift 1).piece)).comp
      (isHomogeneous_rid_comp_lTensor_counit Y (BB.grading.shift 1))
    simp only [zero_add, add_zero] at h1 h2
    exact h1.add h2
  have h := AInfinityRightModule.isHomogeneous_gradedCoderiv (M := TensorWords R A ⊗[R] M)
    (AA := BB) (leftGrading AA G) (F := leftTaylor AA F)
    (by rwa [rightModule_barGrading_leftGrading])
  rwa [rightModule_barGrading_leftGrading] at h

/-- The coderivation generated by any Taylor map is a coderivation over the bar differential of
`BB` for the right coaction: it is a right-module coderivation over `BB`. -/
theorem isGradedCoderivationOver_gradedCoderiv (G : InternalGrading R M)
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    Comodule.IsGradedCoderivationOver (barGrading AA BB G) 1 BB.coaugmentedBarDifferential
      (gradedCoderiv AA BB G F) := by
  rw [← rightModule_barGrading_leftGrading]
  exact AInfinityRightModule.isGradedCoderivationOver_gradedCoderiv _ _

/-- The coderivation generated by any Taylor map is a coderivation over the bar differential of
`AA` for the left coaction. -/
theorem isLeftGradedCoderivationOver_gradedCoderiv (G : InternalGrading R M)
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    Comodule.IsLeftGradedCoderivationOver
      (Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M))
      (TensorWords.grading (AA.grading.shift 1)) 1 AA.coaugmentedBarDifferential
      (gradedCoderiv AA BB G F) := by
  have key : Comodule.leftCoactRTensor (TensorWords R B)
        (Comodule.leftCofreeCoact R (TensorWords R A) M) ∘ₗ gradedCoderiv AA BB G F =
      AA.coaugmentedBarDifferential.rTensor _ ∘ₗ Comodule.leftCoactRTensor (TensorWords R B)
          (Comodule.leftCofreeCoact R (TensorWords R A) M) +
        TensorProduct.map (TensorWords.map ((AA.grading.shift 1).koszulTwist 1))
            (gradedCoderiv AA BB G F) ∘ₗ
          Comodule.leftCoactRTensor (TensorWords R B)
            (Comodule.leftCofreeCoact R (TensorWords R A) M) := by
    -- The left cofree part satisfies the left co-Leibniz law after deconcatenating the right
    -- word, because the left and right coactions commute; the term with the bar differential of
    -- `BB` passes the left coaction with the twist of the left word.
    rw [gradedCoderiv_def, ← Comodule.cofreeCoact_def]
    simp only [LinearMap.comp_add, LinearMap.add_comp,
      TensorProduct.map_add_right, ← LinearMap.comp_assoc, Comodule.leftCoactRTensor_comp_rTensor,
      leftCofreeCoact_comp_leftTaylor, LinearMap.rTensor_add]
    simp only [LinearMap.comp_assoc,
      Comodule.assoc_comp_rTensor_map_counit_comp_cofreeCoact]
    simp only [Comodule.assoc_comp_rTensor_comp_cofreeCoact,
      Comodule.leftCoactRTensor_comp_lTensor_comp_rTensor_map (comul_comp_map_koszulTwist AA)]
    abel
  refine Comodule.isLeftGradedCoderivationOver_iff_coact_apply.2 fun x ↦ ?_
  rw [koszulTwist_grading]
  exact LinearMap.congr_fun key x

/-- The Taylor component of the coderivation generated by `F` is `F`. -/
@[simp]
theorem taylorProj_comp_gradedCoderiv (G : InternalGrading R M)
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M) :
    taylorProj R A B M ∘ₗ gradedCoderiv AA BB G F = F := by
  have h := AInfinityRightModule.rid_comp_lTensor_counit_comp_gradedCoderiv
    (M := TensorWords R A ⊗[R] M) (AA := BB) (leftGrading AA G) (leftTaylor AA F)
  rw [taylorProj_def, gradedCoderiv, LinearMap.comp_assoc, LinearMap.comp_assoc]
  -- `h` is stated with the additive structure of `Tᶜ(sA) ⊗ M` coming from `AddCommGroup`, which
  -- agrees with the one in the goal only up to unfolding instances, so it is applied by `congrArg`
  -- rather than by rewriting.
  exact (congrArg (Comodule.leftCofreeCounit R (TensorWords R A) M ∘ₗ ·) h).trans
    (leftCofreeCounit_comp_leftTaylor AA F)

variable {AA BB}

/-- Construct an `(A, B)` `A∞` bimodule from a degree-one Taylor map whose generated coderivation
squares to zero.  By cofreeness, the square-zero law is checked on the Taylor component: this is
the suspended form of the bimodule Stasheff identities. -/
noncomputable def ofTaylor (G : InternalGrading R M)
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M)
    (hF : LinearMap.IsHomogeneous F (barGrading AA BB G).piece (G.shift 1).piece 1)
    (hsq : F ∘ₗ gradedCoderiv AA BB G F = 0) : AInfinityBimodule AA BB M :=
  ofBarDifferential G (gradedCoderiv AA BB G F) (isHomogeneous_gradedCoderiv AA BB G hF)
    (isLeftGradedCoderivationOver_gradedCoderiv AA BB G F)
    (isGradedCoderivationOver_gradedCoderiv AA BB G F)
    (by rw [← LinearMap.comp_assoc, taylorProj_comp_gradedCoderiv, hsq])

/-- The grading of the bimodule built from a Taylor map is the given grading. -/
@[simp]
theorem ofTaylor_grading (G : InternalGrading R M)
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M)
    (hF : LinearMap.IsHomogeneous F (barGrading AA BB G).piece (G.shift 1).piece 1)
    (hsq : F ∘ₗ gradedCoderiv AA BB G F = 0) : (ofTaylor G F hF hsq).grading = G :=
  ofBarDifferential_grading _ _ _ _ _ _

/-- The bar differential of the bimodule built from a Taylor map is the coderivation it
generates. -/
@[simp]
theorem ofTaylor_barDifferential (G : InternalGrading R M)
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M)
    (hF : LinearMap.IsHomogeneous F (barGrading AA BB G).piece (G.shift 1).piece 1)
    (hsq : F ∘ₗ gradedCoderiv AA BB G F = 0) :
    (ofTaylor G F hF hsq).barDifferential = gradedCoderiv AA BB G F :=
  ofBarDifferential_barDifferential _ _ _ _ _ _

/-- The Taylor map of the bimodule built from a Taylor map is that map. -/
@[simp]
theorem ofTaylor_taylor (G : InternalGrading R M)
    (F : (TensorWords R A ⊗[R] M) ⊗[R] TensorWords R B →ₗ[R] M)
    (hF : LinearMap.IsHomogeneous F (barGrading AA BB G).piece (G.shift 1).piece 1)
    (hsq : F ∘ₗ gradedCoderiv AA BB G F = 0) : (ofTaylor G F hF hsq).taylor = F := by
  rw [ofTaylor, ofBarDifferential_taylor, taylorProj_comp_gradedCoderiv]

/-- The bar differential of a bimodule is the coderivation generated by its Taylor map. -/
theorem barDifferential_eq (MM : AInfinityBimodule AA BB M) :
    MM.barDifferential = gradedCoderiv AA BB MM.grading MM.taylor :=
  eq_of_taylorProj_comp_eq MM.isLeftGradedCoderivation_barDifferential
    MM.isGradedCoderivation_barDifferential (isLeftGradedCoderivationOver_gradedCoderiv _ _ _ _)
    (isGradedCoderivationOver_gradedCoderiv _ _ _ _)
    (by rw [taylorProj_comp_gradedCoderiv, taylor_def])

/-- The Taylor map of a bimodule vanishes after the coderivation it generates: the suspended
bimodule Stasheff identities. -/
theorem taylor_comp_gradedCoderiv (MM : AInfinityBimodule AA BB M) :
    MM.taylor ∘ₗ gradedCoderiv AA BB MM.grading MM.taylor = 0 := by
  rw [← barDifferential_eq, taylor_comp_barDifferential]

/-- Every `A∞` bimodule is built from its own Taylor map. -/
@[simp]
theorem ofTaylor_self (MM : AInfinityBimodule AA BB M) :
