/-!
# An `A∞` algebra as a bimodule over itself

An `A∞` algebra `A` is an `(A, A)` `A∞` bimodule over itself, the diagonal bimodule, whose
operations are those of the algebra: on suspended letters,
`b_{i,j}(a₁ ⋯ aᵢ ⊗ x ⊗ c₁ ⋯ cⱼ) = b_{i+1+j}(a₁ ⋯ aᵢ x c₁ ⋯ cⱼ)`.  Hochschild cochains with
coefficients in it compute the Hochschild cohomology of `A`, and smoothness of `A` is perfection
of this bimodule.

The construction is made on the suspended bar side.  Concatenation around a letter,
`w ⊗ x ⊗ v ↦ w x v` (`TauCeti.TensorWords.concatLetter`), maps the cofree bar bicomodule
`Tᶜ(sA) ⊗ sA ⊗ Tᶜ(sA)` to the reduced bar construction `ReducedTensorWords R A`.  The Taylor map
of the bimodule is the Taylor map of the algebra read through concatenation.  Concatenation then
carries the bicomodule coderivation this Taylor map generates to the bar differential of `A`
(`TauCeti.AInfinityAlgebra.concatLetter_comp_barDifferential_toBimodule`): a block of the word
`w x v` collapsed by the bar differential either contains the letter `x`, which is a term of the
Taylor expansion of the bimodule, or lies in `w` or in `v`, which are the terms in which the bar
differential of `A` acts on the left or the right word.  The Koszul twists match, because in each
case the letters before the collapsed block are twisted.  The bimodule square-zero law is
therefore the square-zero law of the algebra.

## Main definitions

* `TauCeti.AInfinityAlgebra.toBimodule`: an `A∞` algebra as a bimodule over itself.

## Main results

* `TauCeti.AInfinityAlgebra.concatLetter_comp_barDifferential_toBimodule`: concatenation
  intertwines the bimodule bar differential with the algebra bar differential.
* `TauCeti.AInfinityAlgebra.toBimodule_taylor_of_tprod`: the suspended bimodule operation
  `b_{i,j}` is the suspended algebra operation `b_{i+1+j}`.

## References

* B. Keller, *Introduction to A-infinity algebras and modules*, Sections 4--5.
* E. Getzler and J. D. S. Jones, *A-infinity algebras and the cyclic bar complex*, Sections 1--2.
* V. Lyubashenko and O. Manzyuk, *A-infinity-bimodules and Serre A-infinity-functors*.
-/

public section

open scoped BigOperators TensorProduct

namespace TauCeti

universe uR uA

variable {R : Type uR} {A : Type uA} [CommRing R] [AddCommGroup A] [Module R A]

namespace AInfinityAlgebra

open TensorWords InternalGrading Finset

variable (AA : AInfinityAlgebra R A)

/-- Twisting every letter of a block twists that block of the ambient tuple. -/
private theorem map_koszulTwist_subword {N : ℕ} (z : Fin N → A) (a j : ℕ) :
    TensorWords.map ((AA.grading.shift 1).koszulTwist 1) (subword R z a j) =
      subword R ((AA.grading.shift 1).twistedTuple 1 z a j) a j := by
  rw [map_subword]
  by_cases h : a + j ≤ N
  · refine subword_congr R _ _ h h fun i hi ↦ ?_
    rw [twistedTuple_apply, ite_eq_left ⟨by dsimp only; omega, by dsimp only; omega⟩]
  · rw [subword_eq_zero_of_lt_add R _ (by omega), subword_eq_zero_of_lt_add R _ (by omega)]

/-- The left cofree part of a bimodule coderivation, on a block of an ambient tuple followed by a
letter and a word. -/
private theorem leftTaylor_tmul_subword
    (F : (TensorWords R A ⊗[R] A) ⊗[R] TensorWords R A →ₗ[R] A) {N : ℕ} (z : Fin N → A)
    (a l : ℕ) (x : A) (v : TensorWords R A) :
    AInfinityBimodule.leftTaylor AA F ((subword R z a l ⊗ₜ x) ⊗ₜ v) =
      ∑ j ∈ range (l + 1), subword R ((AA.grading.shift 1).twistedTuple 1 z a j) a j ⊗ₜ
          F ((subword R z (a + j) (l - j) ⊗ₜ x) ⊗ₜ v) +
        Coalgebra.counit (R := R) v • (AA.coaugmentedBarDifferential (subword R z a l) ⊗ₜ x) := by
  rw [AInfinityBimodule.leftTaylor_def]
  simp only [LinearMap.add_apply, LinearMap.comp_apply, Comodule.leftCoactRTensor_tmul,
    Comodule.leftCofreeCoact_tmul, comul_eq_deconcatenation, deconcatenation_subword,
    TensorProduct.sum_tmul, map_sum, TensorProduct.assoc_tmul, TensorProduct.map_tmul,
    map_koszulTwist_subword, LinearMap.lTensor_tmul, LinearEquiv.coe_coe,
    TensorProduct.rid_tmul]
  rw [map_smul, LinearMap.rTensor_tmul]

/-- The bimodule coderivation generated by `F`, on a block of an ambient tuple followed by a letter
and a second block: the right word is deconcatenated, and the bar differential acts on it with the
twist of the left word and the letter. -/
private theorem gradedCoderiv_tmul_subword
    (F : (TensorWords R A ⊗[R] A) ⊗[R] TensorWords R A →ₗ[R] A) {N : ℕ} (z : Fin N → A)
    (a l : ℕ) (x : A) (c n : ℕ) :
    AInfinityBimodule.gradedCoderiv AA AA AA.grading F
        ((subword R z a l ⊗ₜ x) ⊗ₜ subword R z c n) =
      ∑ k ∈ range (n + 1), AInfinityBimodule.leftTaylor AA F
          ((subword R z a l ⊗ₜ x) ⊗ₜ subword R z c k) ⊗ₜ subword R z (c + k) (n - k) +
        (subword R ((AA.grading.shift 1).twistedTuple 1 z a l) a l ⊗ₜ
            (AA.grading.shift 1).koszulTwist 1 x) ⊗ₜ
          AA.coaugmentedBarDifferential (subword R z c n) := by
  rw [AInfinityBimodule.gradedCoderiv_def]
  simp only [LinearMap.add_apply, LinearMap.comp_apply, LinearMap.lTensor_tmul,
    comul_eq_deconcatenation, deconcatenation_subword, TensorProduct.tmul_sum, map_sum,
    LinearEquiv.coe_coe, TensorProduct.assoc_symm_tmul, LinearMap.rTensor_tmul,
    TensorProduct.map_tmul, map_koszulTwist_subword]

/-- The collapse of the block of length `d` at relative position `p` in the block of length `b`
at `a`, with the letters before it twisted: a summand of the bar differential of that block. -/
private noncomputable abbrev barSummand {N : ℕ} (z : Fin N → A) (a b p d : ℕ) :
    ReducedTensorWords R A :=
  ReducedTensorWords.splice R ((AA.grading.shift 1).twistedTuple 1 z a p) a b p d
    (AA.taylor (ReducedTensorWords.subword R z (a + p) d))

/-- A term of the bimodule coderivation whose collapsed block contains the letter at position
`a + l` becomes, after concatenation, the collapse of that block of the concatenated word. -/
private theorem concatLetter_tmul_taylor_subword {N : ℕ} (z : Fin N → A) {a l n j k : ℕ}
    (h : a + l + 1 + n ≤ N) (hj : j ≤ l) (hk : k ≤ n) :
    concatLetter R A ((subword R ((AA.grading.shift 1).twistedTuple 1 z a j) a j ⊗ₜ
        (AA.taylor ∘ₗ concatLetter R A) ((subword R z (a + j) (l - j) ⊗ₜ
          z ⟨a + l, by omega⟩) ⊗ₜ subword R z (a + l + 1) k)) ⊗ₜ
        subword R z (a + l + 1 + k) (n - k)) =
      barSummand AA z a (l + 1 + n) j (l - j + 1 + k) := by
  have hc := concatLetter_subword (R := R) z (a := a + j) (l := l - j) (k := k) (by omega)
  simp only [show a + j + (l - j) = a + l by omega] at hc
  rw [LinearMap.comp_apply, hc,
    subword_congr R z ((AA.grading.shift 1).twistedTuple 1 z a j)
      (a' := a + j + (l - j + 1 + k)) (by omega) (by omega) fun i hi ↦ ?_,
    concatLetter_eq_splice (R := R) _ _ (by omega) (by omega),
    show j + (l - j + 1 + k) + (n - k) = l + 1 + n by omega]
  rw [twistedTuple_apply, ite_eq_right (by dsimp only; omega)]
  exact congrArg z (Fin.ext (by dsimp only; omega))

/-- The terms of the bimodule coderivation in which the bar differential acts on the left word
occur only when the right word is not cut.  After concatenation they are the collapses of the
blocks of the concatenated word that end before the letter at position `a + l`. -/
private theorem sum_concatLetter_counit_smul_tmul {N : ℕ} (z : Fin N → A) {a l n : ℕ}
    (h : a + l + 1 + n ≤ N) :
    ∑ k ∈ range (n + 1), concatLetter R A
        ((Coalgebra.counit (R := R) (subword R z (a + l + 1) k) •
          (AA.coaugmentedBarDifferential (subword R z a l) ⊗ₜ z ⟨a + l, by omega⟩)) ⊗ₜ
        subword R z (a + l + 1 + k) (n - k)) =
      ∑ p ∈ range (l + 1), ∑ d ∈ range (l + 1 + 1),
        if p + d ≤ l then barSummand AA z a (l + 1 + n) p d else 0 := by
  rw [sum_eq_single 0 (fun k _ hk ↦ by
      rw [counit_eq_counit, counit_subword_of_pos R z (by omega), zero_smul,
        TensorProduct.zero_tmul, map_zero])
    (fun h ↦ absurd (mem_range.2 (by omega)) h),
    counit_eq_counit, subword_length_zero R z (by omega), counit_one, one_smul, add_zero,
    Nat.sub_zero, coaugmentedBarDifferential_subword, barDifferential_def,
    ReducedTensorWords.gradedCoderiv_subword (K := l + 1) _ _ _ _ (by omega)]
  simp only [map_sum, TensorProduct.sum_tmul]
  refine sum_congr rfl fun p _ ↦ sum_congr rfl fun d _ ↦ ?_
  split_ifs with hpd
  · have hz : z ⟨a + l, by omega⟩ =
        (AA.grading.shift 1).twistedTuple 1 z a p ⟨a + l, by omega⟩ := by
      rw [twistedTuple_apply, ite_eq_right (by dsimp only; omega)]
    rw [hz, subword_congr R z ((AA.grading.shift 1).twistedTuple 1 z a p) (a' := a + l + 1) h h
        fun i hi ↦ by rw [twistedTuple_apply, ite_eq_right (by dsimp only; omega)],
      concatLetter_reducedInclusion_splice_left (R := R) _ _ hpd h]
  · rw [ReducedTensorWords.splice_eq_zero_of_block_lt_add _ _ _ (by omega), map_zero,
      TensorProduct.zero_tmul, TensorProduct.zero_tmul, map_zero]

/-- The term of the bimodule coderivation in which the bar differential acts on the right word,
with the twist of the left word and the letter, becomes after concatenation the collapses of the
blocks of the concatenated word that start after the letter at position `a + l`. -/
private theorem concatLetter_tmul_coaugmentedBarDifferential_subword {N : ℕ} (z : Fin N → A)
    {a l n : ℕ} (h : a + l + 1 + n ≤ N) :
    concatLetter R A ((subword R ((AA.grading.shift 1).twistedTuple 1 z a l) a l ⊗ₜ
        (AA.grading.shift 1).koszulTwist 1 (z ⟨a + l, by omega⟩)) ⊗ₜ
          AA.coaugmentedBarDifferential (subword R z (a + l + 1) n)) =
      ∑ p ∈ range n, ∑ d ∈ range (n + 1), barSummand AA z a (l + 1 + n) (l + 1 + p) d := by
  set G := AA.grading.shift 1
  rw [coaugmentedBarDifferential_subword, barDifferential_def,
    ReducedTensorWords.gradedCoderiv_subword (K := n) _ _ _ _ le_rfl]
  simp only [map_sum, TensorProduct.tmul_sum]
  refine sum_congr rfl fun p hp ↦ sum_congr rfl fun d _ ↦ ?_
  rw [mem_range] at hp
  -- Twist the letters before the collapsed block in one tuple.
  have hz : G.koszulTwist 1 (z ⟨a + l, by omega⟩) =
      G.twistedTuple 1 z a (l + 1 + p) ⟨a + l, by omega⟩ := by
    rw [twistedTuple_apply, ite_eq_left ⟨by dsimp only; omega, by dsimp only; omega⟩]
  rw [hz, subword_congr R (G.twistedTuple 1 z a l) (G.twistedTuple 1 z a (l + 1 + p))
      (a' := a) (by omega) (by omega) fun i hi ↦ by
        rw [twistedTuple_apply, twistedTuple_apply, ite_eq_left ⟨by dsimp only; omega,
          by dsimp only; omega⟩, ite_eq_left ⟨by dsimp only; omega, by dsimp only; omega⟩],
    ReducedTensorWords.splice_congr R (G.twistedTuple 1 z (a + l + 1) p)
      (G.twistedTuple 1 z a (l + 1 + p)) (a' := a + l + 1) _ h h fun i hi ↦ by
        rw [twistedTuple_apply, twistedTuple_apply]
        dsimp only
        split_ifs <;> first | rfl | omega,
    concatLetter_reducedInclusion_splice_right (R := R) _ _ h, barSummand,
    show a + (l + 1 + p) = a + l + 1 + p by omega]

/-- Concatenation carries the bimodule coderivation generated by the concatenated Taylor map,
evaluated on consecutive blocks of an ambient tuple, to the bar differential of the concatenated
block.  The collapsed blocks of the concatenated word that contain the letter, end before it, or
start after it are the three kinds of terms of the bimodule coderivation. -/
private theorem concatLetter_gradedCoderiv_subword {N : ℕ} (z : Fin N → A) {a l n : ℕ}
    (h : a + l + 1 + n ≤ N) :
    concatLetter R A (AInfinityBimodule.gradedCoderiv AA AA AA.grading
        (AA.taylor ∘ₗ concatLetter R A)
        ((subword R z a l ⊗ₜ z ⟨a + l, by omega⟩) ⊗ₜ subword R z (a + l + 1) n)) =
      AA.barDifferential (ReducedTensorWords.subword R z a (l + 1 + n)) := by
  rw [gradedCoderiv_tmul_subword, map_add, map_sum]
  simp only [leftTaylor_tmul_subword, TensorProduct.add_tmul, map_add, TensorProduct.sum_tmul,
    map_sum, sum_add_distrib]
  rw [sum_congr rfl fun k hk ↦ sum_congr rfl fun j hj ↦ concatLetter_tmul_taylor_subword AA z h
      (Nat.lt_succ_iff.mp (mem_range.mp hj)) (Nat.lt_succ_iff.mp (mem_range.mp hk)),
    sum_concatLetter_counit_smul_tmul AA z h,
    concatLetter_tmul_coaugmentedBarDifferential_subword AA z h, barDifferential_def,
    ReducedTensorWords.gradedCoderiv_subword (K := l + 1 + n) _ _ _ _ le_rfl]
  exact (sum_sum_range_split_blocks l n (barSummand AA z a (l + 1 + n)) fun p d hpd ↦
    ReducedTensorWords.splice_eq_zero_of_block_lt_add _ _ _ hpd).symm

/-- Concatenation carries the bimodule coderivation generated by the concatenated Taylor map to
the bar differential of the algebra. -/
private theorem concatLetter_comp_gradedCoderiv :
    concatLetter R A ∘ₗ AInfinityBimodule.gradedCoderiv AA AA AA.grading
        (AA.taylor ∘ₗ concatLetter R A) =
      AA.barDifferential ∘ₗ concatLetter R A := by
  refine TensorProduct.ext (TensorProduct.ext (TensorWords.linearMap_ext R A fun l w ↦
    LinearMap.ext fun x ↦ TensorWords.linearMap_ext R A fun n v ↦ ?_))
  simp only [LinearMap.compr₂ₛₗ_apply, TensorProduct.mk_apply, LinearMap.comp_apply]
  -- Read the three factors as consecutive blocks of the concatenated tuple.
  set z : Fin (l + (n + 1)) → A := Fin.append w (Fin.cons x v) with hz
  have hw : of R A l (PiTensorProduct.tprod R w) = subword R z 0 l := by
    rw [subword_eq_of_tprod R z (by omega)]
    refine of_tprod_congr R A fun i ↦ ?_
    rw [hz, show (⟨0 + i, by omega⟩ : Fin (l + (n + 1))) = Fin.castAdd (n + 1) i from
      Fin.ext (by simp), Fin.append_left]
  have hx : x = z ⟨0 + l, by omega⟩ := by
    rw [hz, show (⟨0 + l, by omega⟩ : Fin (l + (n + 1))) = Fin.natAdd l 0 from
      Fin.ext (by simp), Fin.append_right, Fin.cons_zero]
  have hv : of R A n (PiTensorProduct.tprod R v) = subword R z (0 + l + 1) n := by
    rw [subword_eq_of_tprod R z (by omega)]
    refine of_tprod_congr R A fun i ↦ ?_
    rw [hz, show (⟨0 + l + 1 + i, by omega⟩ : Fin (l + (n + 1))) = Fin.natAdd l i.succ from
      Fin.ext (by simp; omega), Fin.append_right, Fin.cons_succ]
  rw [hw, hv, hx, concatLetter_gradedCoderiv_subword AA z (by omega),
    concatLetter_subword (R := R) z (by omega)]

/-- The Taylor map of the algebra, read on `Tᶜ(sA) ⊗ sA ⊗ Tᶜ(sA)` through concatenation, has
degree one. -/
private theorem isHomogeneous_taylor_comp_concatLetter :
    LinearMap.IsHomogeneous (AA.taylor ∘ₗ concatLetter R A)
      (AInfinityBimodule.barGrading AA AA AA.grading).piece (AA.grading.shift 1).piece 1 := by
  rw [AInfinityBimodule.barGrading_def]
  simpa only [zero_add] using (AA.taylor_isSuspension.isHomogeneous AA.m_degree).comp
    (isHomogeneous_concatLetter (AA.grading.shift 1))

/-- An `A∞` algebra as an `(A, A)` `A∞` bimodule over itself, the diagonal bimodule.  Its Taylor
map evaluates the Taylor map of the algebra on the concatenated word `a₁ ⋯ aᵢ x b₁ ⋯ bⱼ`, so that
its operations `b_{i,j}` are the operations `b_{i+1+j}` of the algebra. -/
noncomputable def toBimodule : AInfinityBimodule AA AA A :=
  AInfinityBimodule.ofTaylor AA.grading (AA.taylor ∘ₗ concatLetter R A)
    (isHomogeneous_taylor_comp_concatLetter AA) (by
      rw [LinearMap.comp_assoc, concatLetter_comp_gradedCoderiv, ← LinearMap.comp_assoc,
        ← letter_comp_barDifferential,
        LinearMap.comp_assoc AA.barDifferential AA.barDifferential (ReducedTensorWords.letter R A),
        barDifferential_sq, LinearMap.comp_zero, LinearMap.zero_comp])

/-- The diagonal bimodule carries the grading of the algebra. -/
@[simp]
theorem toBimodule_grading : AA.toBimodule.grading = AA.grading :=
  AInfinityBimodule.ofTaylor_grading _ _ _ _

/-- The Taylor map of the diagonal bimodule is the Taylor map of the algebra after
concatenation. -/
theorem toBimodule_taylor : AA.toBimodule.taylor = AA.taylor ∘ₗ concatLetter R A :=
  AInfinityBimodule.ofTaylor_taylor _ _ _ _

/-- The Taylor map of the diagonal bimodule on `w ⊗ x ⊗ v` is the Taylor map of the algebra on
the word `w x v`. -/
theorem toBimodule_taylor_tmul (w : TensorWords R A) (x : A) (v : TensorWords R A) :
    AA.toBimodule.taylor ((w ⊗ₜ x) ⊗ₜ v) = AA.taylor (concatLetter R A ((w ⊗ₜ x) ⊗ₜ v)) := by
  rw [toBimodule_taylor, LinearMap.comp_apply]

/-- The suspended operation `b_{i,j}` of the diagonal bimodule is the suspended operation
`b_{i+1+j}` of the algebra on the concatenated letters. -/
theorem toBimodule_taylor_of_tprod {i j : ℕ} (a : Fin i → A) (x : A) (b : Fin j → A) :
    AA.toBimodule.taylor ((of R A i (PiTensorProduct.tprod R a) ⊗ₜ x) ⊗ₜ
        of R A j (PiTensorProduct.tprod R b)) =
      AA.taylor (ReducedTensorWords.of R A ⟨i + (j + 1), by omega⟩
        (PiTensorProduct.tprod R (Fin.append a (Fin.cons x b)))) := by
  rw [toBimodule_taylor_tmul, concatLetter_of_tprod]

/-- Concatenation intertwines the bar differential of the diagonal bimodule with the bar
differential of the algebra: it is a chain map from the cofree bar bicomodule
`Tᶜ(sA) ⊗ sA ⊗ Tᶜ(sA)` to the reduced bar construction. -/
theorem concatLetter_comp_barDifferential_toBimodule :
    concatLetter R A ∘ₗ AA.toBimodule.barDifferential =
      AA.barDifferential ∘ₗ concatLetter R A := by
  rw [toBimodule, AInfinityBimodule.ofTaylor_barDifferential, concatLetter_comp_gradedCoderiv]

end AInfinityAlgebra

end TauCeti
