module

public import TauCeti.Algebra.Homology.AInfinity.Algebra.DG
public import TauCeti.Algebra.Homology.AInfinity.Algebra.Hom.Augmented
public import TauCeti.Algebra.Homology.AInfinity.Algebra.Hom.Unital
public import TauCeti.Algebra.Homology.DG.Algebra.Augmentation

/-!
# Differential graded algebra augmentations as `A∞` augmentations

Every augmentation `e : DGAlgAugmentation h` of a differential graded algebra `(A, d)` induces
an `A∞` augmentation `e.toAInfinityAugmentation` on `h.toIsNonUnitalDGAlgebra.toAInfinityAlgebra`
with selected strict unit `1`.  Its augmentation ideal and reduced-part projection coincide with
those of `e`, and a DG algebra morphism `φ : A → B` between augmented DG algebras is augmented
as an `A∞` morphism precisely when `e_B.comp φ = e_A`.

## Main definitions

* `TauCeti.DGAlgAugmentation.toAInfinityAugmentation`: view a DG algebra augmentation as an `A∞`
  algebra augmentation.

## Main results

* `TauCeti.DGAlgAugmentation.toAInfinityAugmentation_augmentationIdeal` and
  `TauCeti.DGAlgAugmentation.coe_toAInfinityAugmentation_reducedPart`: compatibility of the
  augmentation ideal and reduced-part projection.
* `TauCeti.DGAlgHom.isAugmented_toAInfinityHom_iff`: a DG algebra morphism induces an augmented
  `A∞` morphism if and only if it commutes with the augmentations.

## References

* B. Keller, *Introduction to A-infinity algebras and modules*, Section 3.6.
-/

public section

namespace TauCeti

universe uR uA uB

namespace DGAlgAugmentation

variable {R : Type uR} {A : Type uA} [CommRing R] [Ring A] [Algebra R A]
  {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜] {dA : A →ₗ[R] A}
  {h : IsDGAlgebra 𝒜 dA} (e : DGAlgAugmentation h)

/-- An augmentation of a differential graded algebra as an augmentation of its `A∞` algebra, with
selected strict unit `1`. -/
noncomputable def toAInfinityAugmentation :
    h.toIsNonUnitalDGAlgebra.toAInfinityAlgebra.Augmentation where
  unit := 1
  isStrictUnit := h.strictUnit_one
  toLinearMap := e.toGradedAlgHom.toAlgHom.toLinearMap
  map_unit := map_one e
  map_of_mem_ne_zero p x hx hp := by
    rw [IsNonUnitalDGAlgebra.toAInfinityAlgebra_grading, InternalGrading.ofDecomposition_piece]
      at hx
    exact ((mem_trivialGrading_iff R R).mp (GradedFunLike.map_mem e hx)).resolve_left hp
  map_binary x y := by
    rw [IsNonUnitalDGAlgebra.toAInfinityAlgebra_m_two_apply]
    exact map_mul e x y
  map_m_of_ne_two n hn0 hn2 x := by
    rcases n with _ | _ | _ | n
    · omega
    · rw [IsNonUnitalDGAlgebra.toAInfinityAlgebra_m_one_apply]
      exact e.map_d (x 0)
    · exact absurd rfl hn2
    · simp

/-- The selected strict unit of `e.toAInfinityAugmentation` is `1`. -/
@[simp]
theorem toAInfinityAugmentation_unit : e.toAInfinityAugmentation.unit = 1 := (rfl)

/-- Strict unitality into an augmented DG algebra with respect to
`e.toAInfinityAugmentation.isStrictUnit` is equivalent to strict unitality with respect to
`h.strictUnit_one`. -/
theorem isStrictlyUnital_toAInfinityAugmentation_iff
    {C : Type*} [AddCommGroup C] [Module R C] {𝒞 : AInfinityAlgebra R C}
    {eC : C} {heC : 𝒞.StrictUnit eC}
    (f : AInfinityHom 𝒞 h.toIsNonUnitalDGAlgebra.toAInfinityAlgebra) :
    f.IsStrictlyUnital heC e.toAInfinityAugmentation.isStrictUnit ↔
      f.IsStrictlyUnital heC h.strictUnit_one :=
  Iff.rfl

/-- The underlying linear map of `e.toAInfinityAugmentation` is that of `e`. -/
@[simp]
theorem toAInfinityAugmentation_toLinearMap :
    e.toAInfinityAugmentation.toLinearMap = e.toGradedAlgHom.toAlgHom.toLinearMap := (rfl)

/-- Evaluating `e.toAInfinityAugmentation` agrees with evaluating `e`. -/
theorem toAInfinityAugmentation_apply (a : A) :
    e.toAInfinityAugmentation a = e a := (rfl)

/-- Membership in the `A∞` augmentation ideal of `e.toAInfinityAugmentation` agrees with
membership in the DG augmentation ideal of `e`. -/
theorem mem_toAInfinityAugmentation_augmentationIdeal {a : A} :
    a ∈ e.toAInfinityAugmentation.augmentationIdeal ↔ a ∈ e.augmentationIdeal := by
  simp

/-- The `A∞` augmentation ideal of `e.toAInfinityAugmentation` is the underlying submodule of
`e.augmentationIdeal`. -/
@[simp]
theorem toAInfinityAugmentation_augmentationIdeal :
    e.toAInfinityAugmentation.augmentationIdeal = e.augmentationIdeal.toSubmodule := by
  ext a
  simp

/-- The scalar inclusion generated by the strict unit `1` of an augmented DG algebra is the
`R`-linear algebra map. -/
@[simp]
theorem toAInfinityAugmentation_unitHom :
    e.toAInfinityAugmentation.unitHom = Algebra.linearMap R A := by
  refine LinearMap.ext fun r ↦ ?_
  simp [Algebra.algebraMap_eq_smul_one]

/-- In `A`, the `A∞` reduced-part projection of `e.toAInfinityAugmentation` agrees pointwise with
the DG reduced-part projection `e.reducedPart`. -/
theorem coe_toAInfinityAugmentation_reducedPart (a : A) :
    (e.toAInfinityAugmentation.reducedPart a : A) = (e.reducedPart a : A) := by
  simp [Algebra.algebraMap_eq_smul_one]

end DGAlgAugmentation

namespace DGAlgHom

variable {R : Type uR} {A : Type uA} {B : Type uB}
  [CommRing R] [Ring A] [Ring B] [Algebra R A] [Algebra R B]
  {𝒜 : ℤ → Submodule R A} {ℬ : ℤ → Submodule R B}
  [GradedAlgebra 𝒜] [GradedAlgebra ℬ]
  {dA : A →ₗ[R] A} {dB : B →ₗ[R] B}
  {hA : IsDGAlgebra 𝒜 dA} {hB : IsDGAlgebra ℬ dB}

/-- A morphism of DG algebras between augmented DG algebras induces an augmented `A∞` morphism if
and only if it commutes with the augmentations. -/
@[simp]
theorem isAugmented_toAInfinityHom_iff (φ : DGAlgHom hA hB)
    (eA : DGAlgAugmentation hA) (eB : DGAlgAugmentation hB) :
    φ.toNonUnitalDGAlgHom.toAInfinityStrictHom.toAInfinityHom.IsAugmented
        eA.toAInfinityAugmentation eB.toAInfinityAugmentation ↔
      eB.comp φ = eA := by
  rw [(AInfinityHom.isStrict_toAInfinityHom _).isAugmented_iff, DGAlgHom.ext_iff]
  simp

/-- An augmentation-preserving DG algebra morphism induces an augmented `A∞` morphism. -/
theorem isAugmented_toAInfinityHom {φ : DGAlgHom hA hB}
    {eA : DGAlgAugmentation hA} {eB : DGAlgAugmentation hB} (hφ : eB.comp φ = eA) :
    φ.toNonUnitalDGAlgHom.toAInfinityStrictHom.toAInfinityHom.IsAugmented
      eA.toAInfinityAugmentation eB.toAInfinityAugmentation :=
  (φ.isAugmented_toAInfinityHom_iff eA eB).2 hφ

end DGAlgHom

end TauCeti
