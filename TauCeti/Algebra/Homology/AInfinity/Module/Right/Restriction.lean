public import TauCeti.Algebra.Homology.AInfinity.Algebra.Hom.CoaugmentedBar
public import TauCeti.Algebra.Homology.AInfinity.Module.Right.Category
public import TauCeti.Algebra.Homology.AInfinity.Module.Right.Hom.Cohomology

/-!
# Restriction of right A-infinity modules along A-infinity morphisms

Let `f : A ⟶ B` be a morphism of `A∞` algebras, with coaugmented bar map
`F : Tᶜ(sA) ⟶ Tᶜ(sB)`.  A right `A∞` module `M` over `B` becomes a right `A∞` module over `A`
whose Taylor map is the Taylor map of `M` read through `id ⊗ F`:

`sM ⊗ Tᶜ(sA) ⟶ sM ⊗ Tᶜ(sB) ⟶ sM`.

On the module input `x` and algebra inputs `a₁, …, aₙ`, the operations of the restricted module
are therefore the sums of the operations `m^M_{k+1}(x, f_{i₁}(…), …, f_{iₖ}(…))` over all ways of
cutting the inputs into consecutive blocks, with the signs coming from the bar construction.
Along a strict morphism `f` this is simply `m^M_{n+1}(x, f a₁, …, f aₙ)`
(`TauCeti.AInfinityRightModule.restrictScalars_toAInfinityHom_m`).

The square-zero law of the restricted module is not checked by hand.  The map `id ⊗ F` between
the cofree bar comodules is compatible with the coactions along the coalgebra morphism `F`, so
maps out of it into the cofree comodule `sM ⊗ Tᶜ(sB)` are determined by their counit components
(`TauCeti.Comodule.eq_rTensor_comp_of_coact_comp_eq`).  This shows that `id ⊗ F` intertwines the
coderivation generated by `G ∘ (id ⊗ F)` over the bar differential of `A` with the coderivation
generated by `G` over the bar differential of `B`
(`TauCeti.AInfinityRightModule.lTensor_coaugmentedBarMap_comp_gradedCoderiv`), so the module
equation of the restriction is the module equation of `M` precomposed with `id ⊗ F`.  In the same
way, the cofree lifts of Taylor maps are natural along `id ⊗ F`, which restricts module morphisms.

Restriction keeps the carrier and the grading, and it does not change the differential, the
cycles, the boundaries or the linear parts of morphisms; in particular it preserves and reflects
quasi-isomorphisms.  It is strictly functorial in the
algebra morphism: restriction along the identity is the identity, and restriction along a
composite is the composite of the restrictions, as equalities of module structures.  On the
categories of modules it is a functor `AInfinityRightModuleCat B ⥤ AInfinityRightModuleCat A`.
This is the change-of-algebra functor through which `A∞` quasi-isomorphisms of algebras act on
categories of `A∞` modules.

## Main definitions

* `TauCeti.AInfinityRightModule.restrictScalars`: the restriction of a right `A∞` module along an
  `A∞` morphism.
* `TauCeti.AInfinityRightModuleHom.restrictScalars`: the restriction of a module morphism.
* `TauCeti.AInfinityRightModuleCat.restrictScalars`: the restriction functor.

## Main results

* `TauCeti.AInfinityRightModule.lTensor_coaugmentedBarMap_comp_gradedCoderiv` and
  `TauCeti.AInfinityRightModule.lTensor_coaugmentedBarMap_comp_cofreeLift`: generated
  coderivations and cofree lifts are natural along `id ⊗ F`.
* `TauCeti.AInfinityRightModule.restrictScalars_taylor`: the Taylor map of the restriction is the
  Taylor map of the module after `id ⊗ F`.
* `TauCeti.AInfinityRightModule.barDifferential_comp_lTensor_coaugmentedBarMap`: `id ⊗ F`
  intertwines the bar differentials of the restriction and of the module.
* `TauCeti.AInfinityRightModule.restrictScalars_differential`: restriction does not change the
  differential.
* `TauCeti.AInfinityRightModule.restrictScalars_id` and
  `TauCeti.AInfinityRightModule.restrictScalars_comp`: strict functoriality in the algebra
  morphism.
* `TauCeti.AInfinityRightModule.restrictScalars_toAInfinityHom_m`: along a strict morphism, the
  restricted operations apply the morphism to every algebra input.
* `TauCeti.AInfinityRightModuleHom.linearPart_restrictScalars`: restriction does not change the
  linear part of a module morphism.
* `TauCeti.AInfinityRightModuleHom.isQuasiIso_restrictScalars_iff`: restriction preserves and
  reflects quasi-isomorphisms.

## References

* B. Keller, *Introduction to A-infinity algebras and modules*, Section 4.
* K. Lefèvre-Hasegawa, *Sur les A-infini catégories*, thèse de doctorat, Université Paris 7
  (2003), Chapter 4.
-/

public section

open CategoryTheory
open scoped TensorProduct

namespace TauCeti

universe uR uA uB uC uM uN uP

variable {R : Type uR} {A : Type uA} {B : Type uB} {C : Type uC} [CommRing R]
  [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B] [AddCommGroup C] [Module R C]
  {AA : AInfinityAlgebra R A} {BB : AInfinityAlgebra R B} {CC : AInfinityAlgebra R C}
  {M : Type uM} {N : Type uN} {P : Type uP}
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [AddCommGroup P] [Module R P]

attribute [local instance] Comodule.cofree

namespace AInfinityRightModule

/-! ### The cofree bar comodules along an `A∞` morphism -/

section BarComodule

variable (f : AInfinityHom AA BB)

/-- The map `id ⊗ F` of cofree bar comodules induced by an `A∞` morphism has degree zero. -/
theorem isHomogeneous_lTensor_coaugmentedBarMap (G : InternalGrading R M) :
    LinearMap.IsHomogeneous (f.coaugmentedBarMap.lTensor M) (barGrading AA G).piece
      (barGrading BB G).piece 0 := by
  have hF : LinearMap.IsHomogeneous f.coaugmentedBarMap
      (TensorWords.grading (AA.grading.shift 1)).piece
      (TensorWords.grading (BB.grading.shift 1)).piece 0 := by
    simpa only [TensorWords.grading_piece] using f.isHomogeneous_coaugmentedBarMap
  have h := (LinearMap.isHomogeneous_id (R := R) (G.shift 1).piece).tensorProduct hF
  simp only [add_zero] at h
  have hA : barGrading AA G =
      (G.shift 1).tensorProduct (TensorWords.grading (AA.grading.shift 1)) := by
    ext p
    rw [barGrading_piece]
  have hB : barGrading BB G =
      (G.shift 1).tensorProduct (TensorWords.grading (BB.grading.shift 1)) := by
    ext p
    rw [barGrading_piece]
  rw [hA, hB]
  exact h

/-- `id ⊗ F` commutes with the Koszul twist of the bar gradings. -/
private theorem koszulTwist_comp_lTensor_coaugmentedBarMap (G : InternalGrading R M) :
    (barGrading BB G).koszulTwist 1 ∘ₗ f.coaugmentedBarMap.lTensor M =
      f.coaugmentedBarMap.lTensor M ∘ₗ (barGrading AA G).koszulTwist 1 := by
  simpa using (isHomogeneous_lTensor_coaugmentedBarMap f G).koszulTwist_comp 1

/-- `id ⊗ F` is compatible with the cofree coactions along the coalgebra morphism `F`. -/
private theorem coact_comp_lTensor_coaugmentedBarMap :
    Comodule.coact (R := R) (C := TensorWords R B) (M := M ⊗[R] TensorWords R B) ∘ₗ
        f.coaugmentedBarMap.lTensor M =
      TensorProduct.map (f.coaugmentedBarMap.lTensor M) f.coaugmentedBarMap ∘ₗ
        Comodule.coact (R := R) (C := TensorWords R A) (M := M ⊗[R] TensorWords R A) := by
  simpa using Comodule.coact_comp_lTensor_coalgHom (M := M) f.coaugmentedBarCoalgHom

/-- `id ⊗ F` preserves the counit components. -/
private theorem rid_comp_lTensor_counit_comp_lTensor_coaugmentedBarMap
    (X : P →ₗ[R] M ⊗[R] TensorWords R A) :
    (TensorProduct.rid R M).toLinearMap ∘ₗ
        (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor M ∘ₗ
          f.coaugmentedBarMap.lTensor M ∘ₗ X =
      (TensorProduct.rid R M).toLinearMap ∘ₗ
        (Coalgebra.counit (R := R) (A := TensorWords R A)).lTensor M ∘ₗ X := by
  rw [← LinearMap.comp_assoc X, ← LinearMap.lTensor_comp, TensorWords.counit_eq_counit,
    TensorWords.counit_eq_counit, f.counit_comp_coaugmentedBarMap]

/-- The coaction of `sM ⊗ Tᶜ(sA)` followed by `F` on the coalgebra factor: the map along which
maps of cofree bar comodules over `F` are compatible with the coactions. -/
private noncomputable abbrev coactAlong :
    (M ⊗[R] TensorWords R A) →ₗ[R] (M ⊗[R] TensorWords R A) ⊗[R] TensorWords R B :=
  f.coaugmentedBarMap.lTensor (M ⊗[R] TensorWords R A) ∘ₗ
    Comodule.coact (R := R) (C := TensorWords R A) (M := M ⊗[R] TensorWords R A)

/-- **Naturality of cofree lifts.**  The map `id ⊗ F` intertwines the cofree lift over `Tᶜ(sA)` of
`G ∘ (id ⊗ F)` with the cofree lift over `Tᶜ(sB)` of `G`. -/
theorem lTensor_coaugmentedBarMap_comp_cofreeLift
    (G : (M ⊗[R] TensorWords R B) →ₗ[R] N) :
    f.coaugmentedBarMap.lTensor N ∘ₗ
        (Comodule.Hom.cofreeLift (C := TensorWords R A)
          (G ∘ₗ f.coaugmentedBarMap.lTensor M)).toLinearMap =
      (Comodule.Hom.cofreeLift (C := TensorWords R B) G).toLinearMap ∘ₗ
        f.coaugmentedBarMap.lTensor M := by
  have hX := Comodule.eq_rTensor_comp_of_coact_comp_eq (coactAlong f)
    (E := f.coaugmentedBarMap.lTensor N ∘ₗ
      (Comodule.Hom.cofreeLift (C := TensorWords R A)
        (G ∘ₗ f.coaugmentedBarMap.lTensor M)).toLinearMap) (by
    rw [← LinearMap.comp_assoc, coact_comp_lTensor_coaugmentedBarMap, LinearMap.comp_assoc,
      ← (Comodule.Hom.cofreeLift (C := TensorWords R A) (P := M ⊗[R] TensorWords R A)
        (G ∘ₗ f.coaugmentedBarMap.lTensor M)).map_coact_eq]
    simp only [← LinearMap.comp_assoc, ← TensorProduct.map_comp, LinearMap.comp_id,
      LinearMap.rTensor_comp_lTensor])
  have hY := Comodule.eq_rTensor_comp_of_coact_comp_eq (coactAlong f)
    (E := (Comodule.Hom.cofreeLift (C := TensorWords R B) G).toLinearMap ∘ₗ
      f.coaugmentedBarMap.lTensor M) (by
    rw [← LinearMap.comp_assoc,
      ← (Comodule.Hom.cofreeLift (C := TensorWords R B) (P := M ⊗[R] TensorWords R B)
        G).map_coact_eq,
      LinearMap.comp_assoc, coact_comp_lTensor_coaugmentedBarMap]
    simp only [← LinearMap.comp_assoc, ← TensorProduct.map_comp, LinearMap.id_comp,
      LinearMap.rTensor_comp_lTensor])
  have hX' : (TensorProduct.rid R N).toLinearMap ∘ₗ
      (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor N ∘ₗ
        f.coaugmentedBarMap.lTensor N ∘ₗ (Comodule.Hom.cofreeLift (C := TensorWords R A)
          (G ∘ₗ f.coaugmentedBarMap.lTensor M)).toLinearMap =
        G ∘ₗ f.coaugmentedBarMap.lTensor M := by
    rw [rid_comp_lTensor_counit_comp_lTensor_coaugmentedBarMap,
      Comodule.Hom.rid_comp_lTensor_counit_comp_cofreeLift]
  have hY' : (TensorProduct.rid R N).toLinearMap ∘ₗ
      (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor N ∘ₗ
        (Comodule.Hom.cofreeLift (C := TensorWords R B) G).toLinearMap ∘ₗ
          f.coaugmentedBarMap.lTensor M = G ∘ₗ f.coaugmentedBarMap.lTensor M := by
    rw [← LinearMap.comp_assoc (f.coaugmentedBarMap.lTensor M),
      ← LinearMap.comp_assoc (f.coaugmentedBarMap.lTensor M),
      Comodule.Hom.rid_comp_lTensor_counit_comp_cofreeLift]
  rw [hX, hY, hX', hY']

/-- **Naturality of generated coderivations.**  The map `id ⊗ F` intertwines the coderivation
generated by `G ∘ (id ⊗ F)` over the bar differential of `A` with the coderivation generated by
`G` over the bar differential of `B`. -/
theorem lTensor_coaugmentedBarMap_comp_gradedCoderiv (G : InternalGrading R M)
    (F : (M ⊗[R] TensorWords R B) →ₗ[R] M) :
    f.coaugmentedBarMap.lTensor M ∘ₗ gradedCoderiv AA G (F ∘ₗ f.coaugmentedBarMap.lTensor M) =
      gradedCoderiv BB G F ∘ₗ f.coaugmentedBarMap.lTensor M := by
  set L := f.coaugmentedBarMap.lTensor M with hLdef
  set DA := gradedCoderiv AA G (F ∘ₗ L)
  set DB := gradedCoderiv BB G F
  have hA : Comodule.coact (R := R) (C := TensorWords R A) (M := M ⊗[R] TensorWords R A) ∘ₗ DA =
      DA.rTensor _ ∘ₗ Comodule.coact (R := R) (C := TensorWords R A)
          (M := M ⊗[R] TensorWords R A) +
        (AA.coaugmentedBarDifferential.lTensor _ ∘ₗ ((barGrading AA G).koszulTwist 1).rTensor _) ∘ₗ
          Comodule.coact (R := R) (C := TensorWords R A) (M := M ⊗[R] TensorWords R A) :=
    LinearMap.ext fun z ↦ Comodule.isGradedCoderivationOver_iff_coact_apply.1
      (isGradedCoderivationOver_gradedCoderiv (AA := AA) G (F ∘ₗ L)) z
  have hB : Comodule.coact (R := R) (C := TensorWords R B) (M := M ⊗[R] TensorWords R B) ∘ₗ DB =
      DB.rTensor _ ∘ₗ Comodule.coact (R := R) (C := TensorWords R B)
          (M := M ⊗[R] TensorWords R B) +
        (BB.coaugmentedBarDifferential.lTensor _ ∘ₗ ((barGrading BB G).koszulTwist 1).rTensor _) ∘ₗ
          Comodule.coact (R := R) (C := TensorWords R B) (M := M ⊗[R] TensorWords R B) :=
    LinearMap.ext fun z ↦ Comodule.isGradedCoderivationOver_iff_coact_apply.1
      (isGradedCoderivationOver_gradedCoderiv (AA := BB) G F) z
  have hL : Comodule.coact (R := R) (C := TensorWords R B) (M := M ⊗[R] TensorWords R B) ∘ₗ L =
      TensorProduct.map L f.coaugmentedBarMap ∘ₗ
        Comodule.coact (R := R) (C := TensorWords R A) (M := M ⊗[R] TensorWords R A) :=
    coact_comp_lTensor_coaugmentedBarMap f
  have hτ : (barGrading BB G).koszulTwist 1 ∘ₗ L = L ∘ₗ (barGrading AA G).koszulTwist 1 :=
    koszulTwist_comp_lTensor_coaugmentedBarMap f G
  have hb := f.coaugmentedBarDifferential_comp_coaugmentedBarMap
  -- The difference of the two sides is compatible with the coactions along `F`: the terms in
  -- which a bar differential acts on the coalgebra factor cancel because `F` is a chain map of
  -- degree zero.
  have hE := Comodule.eq_rTensor_comp_of_coact_comp_eq (coactAlong f) (E := L ∘ₗ DA - DB ∘ₗ L) (by
    rw [LinearMap.comp_sub, ← LinearMap.comp_assoc, hL, LinearMap.comp_assoc, hA,
      ← LinearMap.comp_assoc _ DB, hB]
    simp only [LinearMap.comp_assoc, LinearMap.comp_add, LinearMap.add_comp, hL]
    simp only [← LinearMap.comp_assoc, coactAlong, LinearMap.map_comp_rTensor,
      LinearMap.rTensor_comp_map, LinearMap.lTensor_comp_map,
      LinearMap.lTensor_comp_rTensor,
      ← TensorProduct.map_comp, LinearMap.rTensor_sub, LinearMap.sub_comp,
      LinearMap.rTensor_comp_lTensor, hτ, hb]
    abel)
  have hπ : (TensorProduct.rid R M).toLinearMap ∘ₗ
      (Coalgebra.counit (R := R) (A := TensorWords R B)).lTensor M ∘ₗ (L ∘ₗ DA - DB ∘ₗ L) = 0 := by
    rw [LinearMap.comp_sub, LinearMap.comp_sub,
      rid_comp_lTensor_counit_comp_lTensor_coaugmentedBarMap,
      rid_comp_lTensor_counit_comp_gradedCoderiv, ← LinearMap.comp_assoc L DB,
      ← LinearMap.comp_assoc L, rid_comp_lTensor_counit_comp_gradedCoderiv, sub_self]
  rw [hπ, LinearMap.rTensor_zero, LinearMap.zero_comp] at hE
  exact sub_eq_zero.mp hE

end BarComodule

/-! ### Restriction of modules -/

section Restriction

variable (MM : AInfinityRightModule BB M) (f : AInfinityHom AA BB)

/-- The **restriction** of a right `A∞` module over `B` along an `A∞` morphism `f : A ⟶ B`: the
right `A∞` module over `A` on the same graded carrier whose Taylor map is the Taylor map of the
module after `id ⊗ F`, for `F` the coaugmented bar map of `f`. -/
noncomputable def restrictScalars : AInfinityRightModule AA M :=
  ofTaylor MM.grading (MM.taylor ∘ₗ f.coaugmentedBarMap.lTensor M)
    (by simpa only [zero_add] using
      MM.isHomogeneous_taylor.comp (isHomogeneous_lTensor_coaugmentedBarMap f MM.grading))
    (by rw [LinearMap.comp_assoc, lTensor_coaugmentedBarMap_comp_gradedCoderiv,
      ← barDifferential_eq, ← LinearMap.comp_assoc, taylor_comp_barDifferential,
      LinearMap.zero_comp])

/-- Restriction keeps the grading of the carrier. -/
@[simp]
theorem restrictScalars_grading : (MM.restrictScalars f).grading = MM.grading :=
  ofTaylor_grading _ _ _ _

/-- The Taylor map of the restriction is the Taylor map of the module after `id ⊗ F`. -/
@[simp]
theorem restrictScalars_taylor :
    (MM.restrictScalars f).taylor = MM.taylor ∘ₗ f.coaugmentedBarMap.lTensor M :=
  ofTaylor_taylor _ _ _ _

/-- The bar differential of the restriction is the coderivation over the bar differential of `A`
generated by its Taylor map. -/
theorem restrictScalars_barDifferential :
    (MM.restrictScalars f).barDifferential =
      gradedCoderiv AA MM.grading (MM.taylor ∘ₗ f.coaugmentedBarMap.lTensor M) :=
  ofTaylor_barDifferential _ _ _ _

/-- The map `id ⊗ F` intertwines the bar differential of the restriction with the bar
differential of the module. -/
theorem barDifferential_comp_lTensor_coaugmentedBarMap :
    MM.barDifferential ∘ₗ f.coaugmentedBarMap.lTensor M =
      f.coaugmentedBarMap.lTensor M ∘ₗ (MM.restrictScalars f).barDifferential := by
  rw [restrictScalars_barDifferential, lTensor_coaugmentedBarMap_comp_gradedCoderiv,
    ← barDifferential_eq]

/-- Restriction does not change the differential: the unary operation only sees the empty
algebra word, which `F` fixes. -/
@[simp]
theorem restrictScalars_differential :
    (MM.restrictScalars f).differential = MM.differential := by
  ext x
  rw [← taylor_tmul_one_eq_differential, ← taylor_tmul_one_eq_differential,
    restrictScalars_taylor, LinearMap.comp_apply, LinearMap.lTensor_tmul,
    AInfinityHom.coaugmentedBarMap_one]

/-- Restriction does not change the cycles. -/
@[simp]
theorem restrictScalars_cycles : (MM.restrictScalars f).cycles = MM.cycles := by
  rw [cycles_def, cycles_def, restrictScalars_differential]

/-- Restriction does not change the boundaries. -/
@[simp]
theorem restrictScalars_boundaries : (MM.restrictScalars f).boundaries = MM.boundaries := by
  rw [boundaries_def, boundaries_def, restrictScalars_differential]

/-- Restriction along the identity morphism is the identity. -/
@[simp]
theorem restrictScalars_id : MM.restrictScalars (AInfinityHom.id BB) = MM :=
  ext (restrictScalars_grading _ _) (by
    rw [restrictScalars_taylor, AInfinityHom.coaugmentedBarMap_id, LinearMap.lTensor_id,
      LinearMap.comp_id])

/-- Restriction along a composite is the composite of the restrictions. -/
theorem restrictScalars_comp (g : AInfinityHom BB CC) (MM : AInfinityRightModule CC M) :
    MM.restrictScalars (g.comp f) = (MM.restrictScalars g).restrictScalars f :=
  ext (by simp) (by
    rw [restrictScalars_taylor, restrictScalars_taylor, restrictScalars_taylor,
      AInfinityHom.coaugmentedBarMap_comp, LinearMap.lTensor_comp, LinearMap.comp_assoc])

/-- Along a strict morphism `g`, the restricted operations apply `g` to every algebra input:
`m_{n+1}(x, a₁, …, aₙ) = m^M_{n+1}(x, g a₁, …, g aₙ)`. -/
theorem restrictScalars_toAInfinityHom_m (g : AInfinityStrictHom AA BB) (n : ℕ) (x : M)
    (a : Fin n → A) :
    (MM.restrictScalars g.toAInfinityHom).m (n + 1) x a = MM.m (n + 1) x fun i ↦ g (a i) := by
  have hg (k : ℤ) (y : A) : g (AA.grading.koszulTwist k y) = BB.grading.koszulTwist k (g y) := by
    simpa using (LinearMap.congr_fun (g.isHomogeneous.koszulTwist_comp k) y).symm
  rw [m_apply, m_apply, ← taylor_tmul_of, ← taylor_tmul_of, restrictScalars_taylor,
    restrictScalars_grading, LinearMap.comp_apply, LinearMap.lTensor_tmul,
    AInfinityStrictHom.coaugmentedBarMap_toAInfinityHom, TensorWords.map_of_tprod]
  simp only [AInfinityStrictHom.coe_toLinearMap, hg]
  -- `MM.m (n + 1)` is multilinear in `n + 1 - 1` arguments, which is `n` only up to unfolding,
  -- so the two sides differ only in how the letter indices are cast.
  rfl

end Restriction

end AInfinityRightModule

/-! ### Restriction of module morphisms -/

namespace AInfinityRightModuleHom

variable {MM : AInfinityRightModule BB M} {NN : AInfinityRightModule BB N}
  {PP : AInfinityRightModule BB P} (f : AInfinityHom AA BB)

/-- The restriction of a morphism of right `A∞` modules along an `A∞` morphism `f`: its Taylor
map is the Taylor map of the morphism after `id ⊗ F`. -/
noncomputable def restrictScalars (φ : AInfinityRightModuleHom MM NN) :
    AInfinityRightModuleHom (MM.restrictScalars f) (NN.restrictScalars f) :=
  ofTaylor (φ.taylor ∘ₗ f.coaugmentedBarMap.lTensor M)
    (by
      have h := φ.isHomogeneous_taylor.comp
        (AInfinityRightModule.isHomogeneous_lTensor_coaugmentedBarMap f MM.grading)
      simpa only [AInfinityRightModule.restrictScalars_grading, zero_add] using h)
    (by rw [AInfinityRightModule.restrictScalars_taylor, LinearMap.comp_assoc,
      AInfinityRightModule.lTensor_coaugmentedBarMap_comp_cofreeLift,
      ← φ.barMap_eq_cofreeLift, ← LinearMap.comp_assoc, φ.taylor_comp_barMap,
      LinearMap.comp_assoc, AInfinityRightModule.barDifferential_comp_lTensor_coaugmentedBarMap,
      LinearMap.comp_assoc])

/-- The Taylor map of the restriction of a morphism is its Taylor map after `id ⊗ F`. -/
@[simp]
theorem taylor_restrictScalars (φ : AInfinityRightModuleHom MM NN) :
    (φ.restrictScalars f).taylor = φ.taylor ∘ₗ f.coaugmentedBarMap.lTensor M := by
  unfold restrictScalars
  exact taylor_ofTaylor (MM := MM.restrictScalars f) (NN := NN.restrictScalars f) _ _ _

/-- The map `id ⊗ F` intertwines the bar map of the restriction of a morphism with its bar map. -/
theorem lTensor_coaugmentedBarMap_comp_barMap_restrictScalars (φ : AInfinityRightModuleHom MM NN) :
    f.coaugmentedBarMap.lTensor N ∘ₗ (φ.restrictScalars f).barMap =
      φ.barMap ∘ₗ f.coaugmentedBarMap.lTensor M := by
  rw [barMap_eq_cofreeLift, taylor_restrictScalars,
    AInfinityRightModule.lTensor_coaugmentedBarMap_comp_cofreeLift, ← φ.barMap_eq_cofreeLift]

/-- Restriction does not change the linear part of a morphism. -/
@[simp]
theorem linearPart_restrictScalars (φ : AInfinityRightModuleHom MM NN) :
    (φ.restrictScalars f).linearPart = φ.linearPart := by
  ext x
  rw [linearPart_apply, linearPart_apply, taylor_restrictScalars, LinearMap.comp_apply,
    LinearMap.lTensor_tmul, AInfinityHom.coaugmentedBarMap_one]

/-- Restriction preserves and reflects quasi-isomorphisms: it changes neither the differentials
nor the linear part. -/
@[simp]
theorem isQuasiIso_restrictScalars_iff (φ : AInfinityRightModuleHom MM NN) :
    (φ.restrictScalars f).IsQuasiIso ↔ φ.IsQuasiIso := by
  simp only [isQuasiIso_iff, AInfinityRightModule.restrictScalars_cycles,
    AInfinityRightModule.restrictScalars_boundaries, linearPart_restrictScalars]

/-- Restriction preserves identity morphisms. -/
@[simp]
theorem restrictScalars_id (MM : AInfinityRightModule BB M) :
    (AInfinityRightModuleHom.id MM).restrictScalars f =
      AInfinityRightModuleHom.id (MM.restrictScalars f) := by
  apply ext
  rw [taylor_restrictScalars, taylor_id, taylor_id, LinearMap.comp_assoc]
  simpa only [LinearMap.comp_id] using
    AInfinityRightModule.rid_comp_lTensor_counit_comp_lTensor_coaugmentedBarMap (M := M) f
      LinearMap.id

/-- Restriction preserves composition of morphisms. -/
@[simp]
theorem restrictScalars_comp (ψ : AInfinityRightModuleHom NN PP)
    (φ : AInfinityRightModuleHom MM NN) :
    (ψ.comp φ).restrictScalars f = (ψ.restrictScalars f).comp (φ.restrictScalars f) := by
  apply ext
  rw [taylor_restrictScalars, taylor_comp, taylor_comp, taylor_restrictScalars,
    LinearMap.comp_assoc (φ.restrictScalars f).barMap,
    lTensor_coaugmentedBarMap_comp_barMap_restrictScalars, LinearMap.comp_assoc]

end AInfinityRightModuleHom

/-! ### The restriction functor -/

namespace AInfinityRightModuleCat

/-- Restriction along an `A∞` morphism `f : A ⟶ B`, as a functor from right `A∞` modules over `B`
to right `A∞` modules over `A`.  Its body is exposed so that the carrier of a restricted object is
the original carrier. -/
@[expose]
noncomputable def restrictScalars (f : AInfinityHom AA BB) :
    AInfinityRightModuleCat.{uR, uB, uM} BB ⥤ AInfinityRightModuleCat.{uR, uA, uM} AA where
  obj M := of (M.str.restrictScalars f)
  map φ := AInfinityRightModuleHom.restrictScalars f φ
  map_id M := AInfinityRightModuleHom.restrictScalars_id f M.str
  map_comp φ ψ := AInfinityRightModuleHom.restrictScalars_comp f ψ φ

/-- The restriction functor restricts the module structure. -/
@[simp]
theorem restrictScalars_obj_str (f : AInfinityHom AA BB)
    (M : AInfinityRightModuleCat.{uR, uB, uM} BB) :
    ((restrictScalars f).obj M).str = M.str.restrictScalars f :=
  (rfl)

/-- The restriction functor restricts module morphisms. -/
@[simp]
theorem restrictScalars_map (f : AInfinityHom AA BB)
    {M N : AInfinityRightModuleCat.{uR, uB, uM} BB} (φ : M ⟶ N) :
    (restrictScalars f).map φ = AInfinityRightModuleHom.restrictScalars f φ :=
  (rfl)

end AInfinityRightModuleCat

end TauCeti
