module

public import Mathlib.Algebra.Homology.HomologicalComplex
public import Mathlib.CategoryTheory.Limits.Shapes.BinaryBiproducts

/-!
# The free cochain complex on a family of objects

For a family of objects `T : ℤ → C`, the free cochain complex `CochainComplex.free T` has
`T n ⊞ T (n - 1)` in degree `n`, and its differential sends the summand `T n` of degree `n`
identically to the summand `T n` of degree `n + 1`. It is the sum over `n` of the complexes
`T n --𝟙--> T n` in degrees `n` and `n + 1`, whose terms are finite biproducts.

A morphism from `CochainComplex.free T` to a complex `K` is the same as a family of morphisms
`T n ⟶ K.X n` (`CochainComplex.free.desc`, `CochainComplex.free.ι_desc_f` and
`CochainComplex.free.hom_ext`), which is the universal property of a left adjoint to forgetting
the differential. It thus provides complexes with prescribed terms mapping to a given complex,
for instance to lift degreewise generators of a complex along an epimorphism.

## Main definitions

* `CochainComplex.free T`: the free cochain complex on `T`.
* `CochainComplex.free.ι T n : T n ⟶ (free T).X n`: the inclusion of the generators of degree `n`.
* `CochainComplex.free.desc g : free T ⟶ K`: the morphism induced by `g n : T n ⟶ K.X n`.

The differential on the generators is computed by `CochainComplex.free.ι_d` and
`CochainComplex.free.ι_d_of_add_one_eq`.
-/

public section

open CategoryTheory Limits

namespace CochainComplex

variable {C : Type*} [Category* C] [HasZeroMorphisms C] [HasBinaryBiproducts C] (T : ℤ → C)

/-- The free cochain complex on a family of objects `T : ℤ → C`: its term in degree `n` is
`T n ⊞ T (n - 1)`, and the differential maps the summand `T n` of degree `n` identically to the
summand `T n` of degree `n + 1`. -/
noncomputable def free : CochainComplex C ℤ where
  X n := T n ⊞ T (n - 1)
  d i j := if h : i + 1 = j then
    biprod.fst ≫ eqToHom (congrArg T (by omega)) ≫ biprod.inr else 0
  shape i j hij := dite_eq_right hij
  d_comp_d' i j k hij hjk := by
    have hij : i + 1 = j := hij
    have hjk : j + 1 = k := hjk
    simp [dite_eq_left hij, dite_eq_left hjk]

lemma free_X (n : ℤ) : (free T).X n = (T n ⊞ T (n - 1)) := (rfl)

namespace free

/-- The inclusion of the generators `T n` into the degree `n` term of `CochainComplex.free T`. -/
noncomputable def ι (n : ℤ) : T n ⟶ (free T).X n := biprod.inl

variable {T}

/-- The differential of the free complex sends the generators `T i` of degree `i` identically to
the second summand `T (j - 1)` of the term of degree `j = i + 1`. -/
lemma ι_d_of_add_one_eq {i j : ℤ} (hij : i + 1 = j) :
    ι T i ≫ (free T).d i j =
      eqToHom (congrArg T (by omega)) ≫ biprod.inr ≫ eqToHom (free_X T j).symm := by
  dsimp only [free, ι]
  rw [dite_eq_left hij]
  simp

/-- The image of the generators of degree `n - 1` under the differential is the second summand
`T (n - 1)` of the term of degree `n`. -/
@[reassoc (attr := simp)]
lemma ι_d (n : ℤ) :
    ι T (n - 1) ≫ (free T).d (n - 1) n = biprod.inr ≫ eqToHom (free_X T n).symm := by
  simp [ι_d_of_add_one_eq (sub_add_cancel n 1)]

/-- The term of degree `n` of the free complex is generated by `T n` and by the image of
`T (n - 1)` under the differential. -/
lemma X_hom_ext {n : ℤ} {Z : C} {f g : (free T).X n ⟶ Z} (h₁ : ι T n ≫ f = ι T n ≫ g)
    (h₂ : ι T (n - 1) ≫ (free T).d (n - 1) n ≫ f = ι T (n - 1) ≫ (free T).d (n - 1) n ≫ g) :
    f = g := by
  -- `free_X` holds by `rfl`, so the `eqToHom` it induces is an identity.
  have e (h : (free T).X n ⟶ Z) : eqToHom (free_X T n).symm ≫ h = h := Category.id_comp h
  rw [ι_d_assoc, ι_d_assoc, e, e] at h₂
  exact biprod.hom_ext' _ _ h₁ h₂

variable {K : CochainComplex C ℤ}

/-- The morphism from the free complex `CochainComplex.free T` to `K` given by morphisms
`g n : T n ⟶ K.X n` on the generators. -/
noncomputable def desc (g : ∀ n, T n ⟶ K.X n) : free T ⟶ K where
  f n := biprod.desc (g n) (g (n - 1) ≫ K.d (n - 1) n)
  comm' i j hij := by
    have hij : i + 1 = j := hij
    have key : ∀ (a b : ℤ) (hab : a = b),
        eqToHom (congrArg T hab) ≫ g b ≫ K.d b j = g a ≫ K.d a j := by
      rintro a b rfl
      simp
    dsimp only [free]
    rw [dite_eq_left hij]
    ext
    · simpa using (key i (j - 1) (by omega)).symm
    · simp

@[reassoc (attr := simp)]
lemma ι_desc_f (g : ∀ n, T n ⟶ K.X n) (n : ℤ) : ι T n ≫ (desc g).f n = g n :=
  biprod.inl_desc (g n) (g (n - 1) ≫ K.d (n - 1) n)

/-- Morphisms out of the free complex are determined by their values on the generators. -/
@[ext]
lemma hom_ext {φ ψ : free T ⟶ K} (h : ∀ n, ι T n ≫ φ.f n = ι T n ≫ ψ.f n) : φ = ψ := by
  ext n
  refine X_hom_ext (h n) ?_
  rw [← HomologicalComplex.Hom.comm, ← HomologicalComplex.Hom.comm, ← Category.assoc,
    ← Category.assoc, h]

@[simp, reassoc]
lemma desc_comp (g : ∀ n, T n ⟶ K.X n) {L : CochainComplex C ℤ} (φ : K ⟶ L) :
    desc g ≫ φ = desc fun n ↦ g n ≫ φ.f n := by
  ext n
  simp

end free

end CochainComplex
