module

public import Mathlib.Algebra.Homology.Embedding.CochainComplex
public import Mathlib.CategoryTheory.Generator.Basic
public import Mathlib.CategoryTheory.Subobject.WellPowered
public import TauCeti.Algebra.Homology.HomologicalComplex.OfSubobjects

import Mathlib.CategoryTheory.Abelian.Exact
import TauCeti.CategoryTheory.Generator.Abelian

/-!
# Small acyclic subcomplexes of acyclic complexes

Let `C` be an abelian category with coproducts indexed by `Type w`, whose subobject lattices are
`w`-small, and let `G` be a separator of `C`; every Grothendieck abelian category is an example.
We show that acyclic cochain complexes are exhausted by bounded above acyclic subcomplexes whose
terms have bounded size (`CochainComplex.exists_bounded_acyclic_subcomplex`).

More precisely, there is a sequence of objects `B : ℕ → C` such that, given an acyclic complex
`M` and a morphism `ψ : G ⟶ M.X n`, there is an acyclic subcomplex `N` of `M`, concentrated in
degrees `≤ n + 1`, through which `ψ` factors and whose terms are quotients of objects `B j`.
In particular, every nonzero acyclic complex contains a nonzero such subcomplex
(`CochainComplex.exists_bounded_nonzero_acyclic_subcomplex`). As the quotients of a fixed object
are indexed by its subobjects, these subcomplexes form an essentially small family. This bound is
the input of the transfinite constructions of K-injective resolutions and of the injective model
structure on unbounded complexes over a Grothendieck abelian category.

The subcomplex is built downwards from degree `n`: if its term in degree `k` is the image of a
morphism from `B j`, then by acyclicity the cycles it contains are boundaries, and the term in
degree `k - 1` is generated by one morphism `G ⟶ M.X (k - 1)` for each subobject of `B j`
(`CategoryTheory.IsSeparator.exists_epi_sigmaDesc_comp_of_le_imageSubobject`). This is a
quotient of `B (j + 1)`, the coproduct of copies of `G` indexed by the subobjects of `B j`.

## References

* [Stacks: Lemma 079K](https://stacks.math.columbia.edu/tag/079K)
-/

public section

open CategoryTheory Limits

universe w v u

namespace CochainComplex

variable {C : Type u} [Category.{v} C] [Abelian C] [HasCoproducts.{w} C] [LocallySmall.{w} C]
  [WellPowered.{w} C]

namespace AcyclicSubcomplex

variable (G : C)

/-- The objects bounding the terms of the acyclic subcomplexes: `bound G 0 = G`, and
`bound G (j + 1)` is the coproduct of copies of `G` indexed by the subobjects of `bound G j`. -/
private noncomputable def bound : ℕ → C
  | 0 => G
  | j + 1 => ∐ fun _ : Shrink.{w} (Subobject (bound j)) ↦ G

variable {G} (hG : IsSeparator G) {M : CochainComplex C ℤ} (hM : M.Acyclic)
include hG hM

/-- The inductive step: the cycles of `M` contained in the image of a morphism `g` from `P` are
the differentials of the image of a morphism from the coproduct of copies of `G` indexed by the
subobjects of `P`. -/
private lemma exists_step (k : ℤ) {P : C} (g : P ⟶ M.X k) :
    ∃ g' : (∐ fun _ : Shrink.{w} (Subobject P) ↦ G) ⟶ M.X (k - 1),
      imageSubobject (g' ≫ M.d (k - 1) k) =
        imageSubobject g ⊓ kernelSubobject (M.d k (k + 1)) := by
  set K := imageSubobject g ⊓ kernelSubobject (M.d k (k + 1))
  have hK : K ≤ imageSubobject (M.d (k - 1) k) := by
    have := ((M.exactAt_iff' (k - 1) k (k + 1) (by simp) (by simp)).1 (hM k))
    rw [ShortComplex.exact_iff_image_eq_kernel] at this
    exact inf_le_right.trans this.ge
  have := Subobject.epi_pullbackπ_of_le_imageSubobject (M.d (k - 1) k) hK
  obtain ⟨φ, hφ⟩ := hG.exists_epi_sigmaDesc_comp_of_le_imageSubobject g inf_le_left
    (Subobject.pullbackπ (M.d (k - 1) k) K) (equivShrink.{w} (Subobject P)).symm
    (equivShrink _).symm.surjective
  refine ⟨Sigma.desc φ ≫ ((Subobject.pullback (M.d (k - 1) k)).obj K).arrow, ?_⟩
  rw [Category.assoc, ← (Subobject.isPullback (M.d (k - 1) k) K).w, ← Category.assoc,
    imageSubobject_comp_eq_of_epi, imageSubobject_mono, Subobject.mk_arrow]

variable (n : ℤ) (ψ : G ⟶ M.X n)

/-- The morphisms whose images are the terms of the acyclic subcomplex generated by `ψ`: `ψ`
itself in degree `n`, its composites with the differentials above `n`, and the morphisms given
by `exists_step` below `n`. -/
private noncomputable def generator (m : ℤ) : Σ j : ℕ, (bound.{w} G j ⟶ M.X m) :=
  Int.inductionOn' m n ⟨0, ψ⟩ (fun k _ x ↦ ⟨x.1, x.2 ≫ M.d k (k + 1)⟩)
    (fun k _ x ↦ ⟨x.1 + 1, (exists_step hG hM k x.2).choose⟩)

private lemma generator_self : generator hG hM n ψ n = ⟨0, ψ⟩ :=
  Int.inductionOn'_self

private lemma generator_add_one {k : ℤ} (hk : n ≤ k) :
    generator hG hM n ψ (k + 1) =
      ⟨(generator hG hM n ψ k).1, (generator hG hM n ψ k).2 ≫ M.d k (k + 1)⟩ :=
  Int.inductionOn'_add_one hk

private lemma generator_sub_one {k : ℤ} (hk : k ≤ n) :
    generator hG hM n ψ (k - 1) =
      ⟨(generator hG hM n ψ k).1 + 1, (exists_step hG hM k (generator hG hM n ψ k).2).choose⟩ :=
  Int.inductionOn'_sub_one hk

private lemma generator_snd_eq_zero (m : ℤ) (hm : n + 2 ≤ m) :
    (generator hG hM n ψ m).2 = 0 := by
  obtain ⟨t, rfl⟩ : ∃ t : ℕ, m = n + 2 + t := ⟨(m - (n + 2)).toNat, by omega⟩
  induction t with
  | zero =>
    rw [show n + 2 + ((0 : ℕ) : ℤ) = n + 1 + 1 by omega, generator_add_one _ _ _ _ (by omega),
      generator_add_one _ _ _ _ le_rfl, generator_self]
    exact (Category.assoc _ _ _).trans (by rw [M.d_comp_d, comp_zero])
  | succ t ih =>
    rw [show n + 2 + ((t + 1 : ℕ) : ℤ) = n + 2 + t + 1 by omega,
      generator_add_one _ _ _ _ (by omega)]
    simp [ih (by omega)]

omit hG hM in
private lemma imageSubobject_snd_congr {m : ℤ} {x y : Σ j : ℕ, (bound.{w} G j ⟶ M.X m)}
    (h : x = y) : imageSubobject x.2 = imageSubobject y.2 := by
  subst h
  rfl

/-- The terms of the acyclic subcomplex generated by `ψ`. -/
private noncomputable abbrev term (m : ℤ) : Subobject (M.X m) :=
  imageSubobject (generator hG hM n ψ m).2

private lemma term_self : term hG hM n ψ n = imageSubobject ψ :=
  imageSubobject_snd_congr (generator_self hG hM n ψ)

private lemma exists_term_of_le {k : ℤ} (hk : n ≤ k) :
    (Subobject.exists (M.d k (k + 1))).obj (term hG hM n ψ k) = term hG hM n ψ (k + 1) :=
  (Subobject.exists_obj_imageSubobject _ _).trans
    (imageSubobject_snd_congr (generator_add_one hG hM n ψ hk)).symm

private lemma exists_term_of_le' {k : ℤ} (hk : k ≤ n) :
    (Subobject.exists (M.d (k - 1) k)).obj (term hG hM n ψ (k - 1)) =
      term hG hM n ψ k ⊓ kernelSubobject (M.d k (k + 1)) := by
  rw [show term hG hM n ψ (k - 1) = imageSubobject (exists_step hG hM k _).choose from
    imageSubobject_snd_congr (generator_sub_one hG hM n ψ hk), Subobject.exists_obj_imageSubobject]
  exact (exists_step hG hM k _).choose_spec

private lemma term_eq_bot (m : ℤ) (hm : n + 2 ≤ m) : term hG hM n ψ m = ⊥ :=
  (congrArg (fun f : bound.{w} G _ ⟶ M.X m ↦ imageSubobject f)
    (generator_snd_eq_zero hG hM n ψ m hm)).trans imageSubobject_zero

private lemma factors_term (i j : ℤ) (hij : (ComplexShape.up ℤ).Rel i j) :
    (term hG hM n ψ j).Factors ((term hG hM n ψ i).arrow ≫ M.d i j) := by
  have hle : (Subobject.exists (M.d i j)).obj (term hG hM n ψ i) ≤ term hG hM n ψ j := by
    have hij : i + 1 = j := hij
    subst hij
    by_cases hi : n ≤ i
    · exact (exists_term_of_le _ _ _ _ hi).le
    · obtain ⟨k, rfl⟩ : ∃ k, i = k - 1 := ⟨i + 1, by omega⟩
      rw [show k - 1 + 1 = k by omega, exists_term_of_le' _ _ _ _ (by omega)]
      exact inf_le_left
  refine Subobject.factors_of_le _ hle ?_
  rw [Subobject.exists_eq_imageSubobject]
  simpa using imageSubobject_factors_comp_self ((term hG hM n ψ i).arrow ≫ M.d i j) (𝟙 _)

private lemma term_inf_kernelSubobject_le (j : ℤ) :
    term hG hM n ψ j ⊓ kernelSubobject (M.d j (j + 1)) ≤
      (Subobject.exists (M.d (j - 1) j)).obj (term hG hM n ψ (j - 1)) := by
  by_cases hj : j ≤ n
  · exact (exists_term_of_le' _ _ _ _ hj).ge
  · obtain ⟨k, rfl⟩ : ∃ k, j = k + 1 := ⟨j - 1, by omega⟩
    rw [show k + 1 - 1 = k by omega, ← exists_term_of_le _ _ _ _ (by omega)]
    exact inf_le_left

end AcyclicSubcomplex

open AcyclicSubcomplex in
/-- Let `G` be a separator of `C`. There is a sequence of objects `B j` of `C` such that for every
acyclic complex `M` and every morphism `ψ : G ⟶ M.X n`, there is an acyclic subcomplex `N` of `M`,
concentrated in degrees `≤ n + 1`, through which `ψ` factors, and whose terms are all quotients
of objects `B j`. -/
theorem exists_bounded_acyclic_subcomplex {G : C} (hG : IsSeparator G) :
    ∃ B : ℕ → C, ∀ (M : CochainComplex C ℤ), M.Acyclic → ∀ (n : ℤ) (ψ : G ⟶ M.X n),
      ∃ (N : CochainComplex C ℤ) (i : N ⟶ M) (_ : Mono i) (ψ' : G ⟶ N.X n),
        ψ' ≫ i.f n = ψ ∧ N.Acyclic ∧ N.IsStrictlyLE (n + 1) ∧
          ∀ m, ∃ (j : ℕ) (p : B j ⟶ N.X m), Epi p := by
  refine ⟨bound.{w} G, fun M hM n ψ ↦ ?_⟩
  have hψ : (term hG hM n ψ n).Factors ψ := by
    rw [term_self]
    simpa using imageSubobject_factors_comp_self ψ (𝟙 _)
  refine ⟨M.ofSubobjects _ (factors_term hG hM n ψ), M.ofSubobjectsι _ _, inferInstance,
    (term hG hM n ψ n).factorThru ψ hψ ≫ (M.ofSubobjectsXIso _ _ n).inv, by simp,
    fun j ↦ (M.exactAt_ofSubobjects_iff _ _ (i := j - 1) (k := j + 1) (by simp) (by simp)).2
      (term_inf_kernelSubobject_le hG hM n ψ j), ?_, fun m ↦
    ⟨(generator hG hM n ψ m).1,
      factorThruImageSubobject (generator hG hM n ψ m).2 ≫
        (M.ofSubobjectsXIso (term hG hM n ψ) (factors_term hG hM n ψ) m).inv,
      epi_comp _ _⟩⟩
  rw [isStrictlyLE_iff]
  exact fun i hi ↦ M.isZero_ofSubobjects_X _ _ i (term_eq_bot hG hM n ψ i (by omega))

/-- Let `G` be a separator of `C`. There is a sequence of objects `B j` of `C` such that every
nonzero acyclic complex contains a nonzero bounded above acyclic subcomplex whose terms are all
quotients of objects `B j`. -/
theorem exists_bounded_nonzero_acyclic_subcomplex {G : C} (hG : IsSeparator G) :
    ∃ B : ℕ → C, ∀ (M : CochainComplex C ℤ), M.Acyclic → ¬ IsZero M →
      ∃ (N : CochainComplex C ℤ) (i : N ⟶ M) (_ : Mono i) (n : ℤ),
        ¬ IsZero N ∧ N.Acyclic ∧ N.IsStrictlyLE n ∧
          ∀ m, ∃ (j : ℕ) (p : B j ⟶ N.X m), Epi p := by
  obtain ⟨B, hB⟩ := exists_bounded_acyclic_subcomplex hG
  refine ⟨B, fun M hM hMz ↦ ?_⟩
  obtain ⟨n, hn⟩ : ∃ n, ¬ IsZero (M.X n) := by
    by_contra! h
    apply hMz
    rw [IsZero.iff_id_eq_zero]
    ext i
    exact (h i).eq_of_src _ _
  obtain ⟨ψ, hψ⟩ : ∃ ψ : G ⟶ M.X n, ψ ≠ 0 := by
    by_contra! h
    apply hn
    rw [IsZero.iff_id_eq_zero]
    exact hG.def _ _ fun ψ ↦ by simp [h ψ]
  obtain ⟨N, i, hi, ψ', hψ', hN, hN', hNB⟩ := hB M hM n ψ
  refine ⟨N, i, hi, n + 1, fun hNz ↦ hψ ?_, hN, hN', hNB⟩
  rw [← hψ', ((HomologicalComplex.eval C _ n).map_isZero hNz).eq_of_tgt ψ' 0, zero_comp]

end CochainComplex
