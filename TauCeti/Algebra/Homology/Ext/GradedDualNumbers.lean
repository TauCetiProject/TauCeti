/-!
# Bigraded `Ext` over the graded dual numbers

Let `k` be a commutative ring and grade the dual numbers `A = k[ε]` with `ε` in degree two
(`TauCeti.dualNumberIntegerGrade`). The residue module `S = A/(ε)` is concentrated in degree zero.
Multiplication by `ε` raises degrees by two, so the ungraded periodic resolution of `S` becomes
the graded projective resolution

```text
⋯ ⟶ A{4} --ε--> A{2} --ε--> A ⟶ S ⟶ 0
```

whose `n`th term `A{2n}` is generated in internal degree `2n`. Its differentials take values in
`A₊ = (ε)`, so it is minimal, and graded Hom from it into any internal shift of `S` has zero
differentials. Hence `Extⁿ(S, S{j})` is the degree-`2n` piece of `S{j}`, that is the degree
`2n - j` piece of `S`. Over a field this gives

```text
dim_k Extⁿ(S, S{j}) = 1 if j = 2n, and 0 otherwise.
```

Thus every cohomological degree carries exactly one internal degree, and no cohomological degree
vanishes. This is the graded refinement of `TauCeti.finrank_ext_dualNumberResidue`.

## Main definitions

* `TauCeti.dualNumberGradedResidue`: the graded residue module `S = A/(ε)`, the graded head of
  `A`.
* `TauCeti.dualNumberGradedResolution`: the `ε`-periodic graded projective resolution of `S`,
  with `n`th term `A{2n}` (`TauCeti.dualNumberGradedResolution_termObj`).
* `TauCeti.extDualNumberGradedResidueShiftEquiv`: the `k`-linear equivalence
  `Extⁿ(S, S{j}) ≃ₗ[k] S_{2n - j}`.

## Main results

* `TauCeti.isMinimal_dualNumberGradedResolution`: the periodic graded resolution is minimal.
* `TauCeti.finrank_dualNumberGradedResidue_piece`: `S` is one-dimensional, in degree zero.
* `TauCeti.finrank_ext_dualNumberGradedResidue_shiftObj`: over a field,
  `dim_k Extⁿ(S, S{j})` is `1` if `j = 2n` and `0` otherwise.

## References

* Charles A. Weibel, *An Introduction to Homological Algebra*, Cambridge Studies in Advanced
  Mathematics 38, Cambridge University Press (1994), Section 2.5 and Chapter 4.
* A. Beilinson, V. Ginzburg and W. Soergel, "Koszul duality patterns in representation theory",
  *Journal of the AMS* 9 (1996), Section 1.2, for computing Ext from minimal graded resolutions.
-/

public section

noncomputable section

namespace TauCeti

open CategoryTheory CategoryTheory.Abelian TrivSqZeroExt DualNumber

universe w u

attribute [local instance] dualNumberIntegerGradedAlgebra

section CommRing

variable (k : Type u) [CommRing k]

/-- The **graded residue module** `S = k[ε]/(ε)`, concentrated in degree zero: the graded head
`A / A₊` of the regular module `A`. -/
abbrev dualNumberGradedResidue : GradedModuleCat.{u} (dualNumberIntegerGrade k) :=
  gradedPositiveMulQuotient (dualNumberIntegerGrade k) (one_mem_dualNumberIntegerGrade_zero k)

/-- The left ideal `A₊` generated by the positive-degree elements consists of the dual numbers
with vanishing constant term. -/
private theorem mem_gradedPositiveMulIdeal_one_iff {x : DualNumber k} :
    x ∈ gradedPositiveMulIdeal (dualNumberIntegerGrade k) 1 ↔ fst x = 0 := by
  constructor
  · intro hx
    have hle : gradedPositiveMulIdeal (dualNumberIntegerGrade k) 1 ≤
        RingHom.ker (TrivSqZeroExt.fstHom k k k) := by
      refine (gradedPositiveMulIdeal_le_iff _).2 fun p hp y hy => ?_
      obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hp.le
      rw [dualNumberIntegerGrade_ofNat] at hy
      rw [mul_one, RingHom.mem_ker, TrivSqZeroExt.fstHom_apply]
      rcases eq_or_ne n 2 with rfl | h2
      · exact (mem_dualNumberGrade_two k).1 hy
      · rw [dualNumberGrade_eq_bot k (by omega) h2, Submodule.mem_bot] at hy
        rw [hy, TrivSqZeroExt.fst_zero]
    simpa using hle hx
  · intro hx
    obtain ⟨y, rfl⟩ := fst_eq_zero_iff_eps_dvd.1 hx
    rw [mul_comm]
    exact Ideal.mul_mem_left _ y (by
      simpa using mul_mem_gradedPositiveMulIdeal (e := 1) (dualNumberIntegerGrade k) two_pos
        (eps_mem_dualNumberIntegerGrade_two k))

/-- **The `ε`-periodic graded projective resolution** `⋯ ⟶ A{4} ⟶ A{2} ⟶ A ⟶ S ⟶ 0` of the
graded residue module, for `ε` in degree two. Every differential is multiplication by `ε`, and the
`n`th term is `A{2n}` (`TauCeti.dualNumberGradedResolution_termObj`). -/
def dualNumberGradedResolution :
    GradedProjectiveResolution.{u, u, u, u} (dualNumberIntegerGrade k)
      (dualNumberGradedResidue k).grading where
  X _ := DualNumber k
  grading n :=
    ((GradedModuleCat.regular (𝒜 := dualNumberIntegerGrade k)).shiftObj (2 * n : ℤ)).grading
  gradedSMul n :=
    ((GradedModuleCat.regular (𝒜 := dualNumberIntegerGrade k)).shiftObj (2 * n : ℤ)).gradedSMul
  projective _ := inferInstanceAs (Module.Projective (DualNumber k) (DualNumber k))
  d _ := LinearMap.toSpanSingleton _ _ ε
  π := (gradedPositiveMulQuotientMk (one_mem_dualNumberIntegerGrade_zero k)).comp
    (LinearMap.id.codRestrict _ fun x => by simp)
  isHomogeneous_d n := LinearMap.isHomogeneous_def.2 fun p x hx => by
    have hx' : x ∈ dualNumberIntegerGrade k (p - 2 * (n + 1 : ℕ)) := by
      simpa [sub_eq_add_neg] using hx
    have h := SetLike.GradedMul.mul_mem hx' (eps_mem_dualNumberIntegerGrade_two k)
    -- multiplying by `ε` raises the internal degree `p - 2(n + 1)` by two
    have hdeg : p - 2 * (n + 1 : ℕ) + 2 = p + 0 + -(2 * (n : ℤ)) := by omega
    rw [hdeg] at h
    simpa using h
  isHomogeneous_π := LinearMap.isHomogeneous_def.2 fun p x hx =>
    (mem_gradedPositiveMulQuotient_piece_iff _).2 ⟨⟨x, by simp⟩, by simpa using hx, rfl⟩
  surjective_π y := by
    obtain ⟨x, rfl⟩ := gradedPositiveMulQuotientMk_surjective _ y
    exact ⟨x, rfl⟩
  exact_d_π x := by
    rw [LinearMap.comp_apply, gradedPositiveMulQuotientMk_eq_zero_iff, LinearMap.codRestrict_apply,
      LinearMap.id_apply, mem_gradedPositiveMulIdeal_one_iff, fst_eq_zero_iff_eps_dvd]
    refine ⟨fun ⟨y, hy⟩ => ⟨y, by simp [hy, mul_comm]⟩, fun ⟨y, hy⟩ => ⟨y, ?_⟩⟩
    rw [← hy, LinearMap.toSpanSingleton_apply, smul_eq_mul, mul_comm]
  exact_d_d _ := dualNumber_mul_eps_exact

/-- The `n`th term of the periodic graded resolution is the shifted regular module `A{2n}`. -/
theorem dualNumberGradedResolution_termObj (n : ℕ) :
    (dualNumberGradedResolution k).termObj n =
      (GradedModuleCat.regular (𝒜 := dualNumberIntegerGrade k)).shiftObj (2 * n : ℤ) :=
  (rfl)

/-- Every differential of the periodic graded resolution is multiplication by `ε`. -/
private theorem dualNumberGradedResolution_d_apply (n : ℕ)
    (x : (dualNumberGradedResolution k).X (n + 1)) :
    (dualNumberGradedResolution k).d n x = ((ε : DualNumber k) • x : DualNumber k) :=
  mul_comm (G := DualNumber k) x ε

/-- Every differential of the periodic graded resolution, read through
`TauCeti.dualNumberGradedResolution_termObj` as a map `A{2n + 2} ⟶ A{2n}`, sends `1` to `ε`. -/
theorem dualNumberGradedResolution_differential_hom_one (n : ℕ) :
    (eqToHom (dualNumberGradedResolution_termObj k (n + 1)).symm ≫
        (dualNumberGradedResolution k).differential n ≫
          eqToHom (dualNumberGradedResolution_termObj k n)).hom 1 = ε :=
  -- both transports are identities, and the differential is multiplication by `ε`
  (dualNumberGradedResolution_d_apply k n (1 : DualNumber k)).trans (mul_one (ε : DualNumber k))

/-- The augmentation of the periodic graded resolution, read through
`TauCeti.dualNumberGradedResolution_termObj` as a map `A ⟶ S`, sends `1` to the class of `1`. -/
theorem dualNumberGradedResolution_augmentation_hom_one :
    (eqToHom (dualNumberGradedResolution_termObj k 0).symm ≫
        (dualNumberGradedResolution k).augmentation).hom 1 =
      gradedPositiveMulQuotientMk (one_mem_dualNumberIntegerGrade_zero k) ⟨1, by simp⟩ :=
  -- the transport is an identity, and the augmentation is the quotient map
  (rfl)

/-- **The periodic graded resolution is minimal**: every differential is multiplication by `ε`,
which has positive degree. -/
theorem isMinimal_dualNumberGradedResolution : (dualNumberGradedResolution k).IsMinimal :=
  GradedProjectiveResolution.isMinimal_iff.2 fun n x => by
    rw [dualNumberGradedResolution_d_apply]
    exact Submodule.smul_mem_smul
      (Submodule.mem_iSup_of_mem 2 (Submodule.mem_iSup_of_mem two_pos
        (eps_mem_dualNumberIntegerGrade_two k))) Submodule.mem_top

/-- The graded residue module vanishes outside degree zero. -/
theorem dualNumberGradedResidue_piece_eq_bot {p : ℤ} (hp : p ≠ 0) :
    (dualNumberGradedResidue k).grading.piece p = ⊥ := by
  refine (Submodule.eq_bot_iff _).2 fun y hy => ?_
  obtain ⟨x, hx, rfl⟩ := (mem_gradedPositiveMulQuotient_piece_iff _).1 hy
  rw [gradedPositiveMulQuotientMk_eq_zero_iff, mem_gradedPositiveMulIdeal_one_iff]
  rcases lt_or_gt_of_ne hp with hp | hp
  · rw [dualNumberIntegerGrade_eq_bot_of_neg k hp, Submodule.mem_bot] at hx
    rw [hx, TrivSqZeroExt.fst_zero]
  · rw [← mem_gradedPositiveMulIdeal_one_iff]
    simpa using mul_mem_gradedPositiveMulIdeal (e := 1) _ hp hx

/-- Positive-degree scalars annihilate every internal shift of the graded residue module. -/
theorem positive_smul_top_shiftObj_dualNumberGradedResidue_eq_bot (j : ℤ) :
    (⨆ (i : ℤ) (_ : 0 < i), dualNumberIntegerGrade k i) •
      (⊤ : Submodule k ((dualNumberGradedResidue k).shiftObj j)) = ⊥ :=
  GradedModuleCat.positive_smul_top_eq_bot_of_concentrated _ j fun q hq => by
    simpa [sub_eq_add_neg] using
      dualNumberGradedResidue_piece_eq_bot k (p := q - j) (sub_ne_zero.2 hq)

variable [HasExt.{w} (GradedModuleCat.{u} (dualNumberIntegerGrade k))]

/-- **`Extⁿ(S, S{j})` is the degree-`(2n - j)` piece of `S`**, for the graded residue module `S`
of the dual numbers with `ε` in degree two: the minimal periodic resolution identifies it with
graded Hom from `A{2n}` to `S{j}`, that is with the degree-`2n` piece of `S{j}`. -/
def extDualNumberGradedResidueShiftEquiv (n : ℕ) (j : ℤ) :
    Ext.{w} (dualNumberGradedResidue k) ((dualNumberGradedResidue k).shiftObj j) n ≃ₗ[k]
      (dualNumberGradedResidue k).grading.piece (2 * n - j) :=
  ((isMinimal_dualNumberGradedResolution k).extLinearEquiv
      (positive_smul_top_shiftObj_dualNumberGradedResidue_eq_bot k j) n).symm ≪≫ₗ
    GradedModuleCat.regularShiftHomEquiv _ _ ≪≫ₗ
    LinearEquiv.ofEq _ _ (by ext; simp [sub_eq_add_neg])

/-- The inverse of `TauCeti.extDualNumberGradedResidueShiftEquiv` sends `m ∈ S_{2n - j}` to the
class, computed by the minimal periodic resolution, of the graded map `A{2n} ⟶ S{j}` sending `1`
to `m`. -/
theorem extDualNumberGradedResidueShiftEquiv_symm_apply (n : ℕ) (j : ℤ)
    (m : (dualNumberGradedResidue k).grading.piece (2 * n - j)) :
    (extDualNumberGradedResidueShiftEquiv k n j).symm m =
      (isMinimal_dualNumberGradedResolution k).extLinearEquiv
        (positive_smul_top_shiftObj_dualNumberGradedResidue_eq_bot k j) n
        (eqToHom (dualNumberGradedResolution_termObj k n) ≫
          (GradedModuleCat.regularShiftHomEquiv _ _).symm ⟨m, by simp⟩) :=
  (rfl)

end CommRing

section Field

open scoped Pointwise

variable (k : Type u) [Field k]

/-- **The graded residue module is one-dimensional, concentrated in degree zero.** -/
theorem finrank_dualNumberGradedResidue_piece (p : ℤ) :
    Module.finrank k ((dualNumberGradedResidue k).grading.piece p) = if p = 0 then 1 else 0 := by
  have h := congrArg (fun f : LaurentPolynomial ℤ => f.coeff p)
    (smulGradedDimension_gradedIdempotentHead (I := Unit) (e := fun _ => (1 : DualNumber k))
      (fun _ => dualNumberIntegerGrade_eq_bot_of_neg k)
      (CompleteOrthogonalIdempotents.unique_iff.2 rfl).toOrthogonalIdempotents
      (fun _ => one_mem_dualNumberIntegerGrade_zero k)
      (by rw [Set.range_const, dualNumberIntegerGrade_zero_eq_span_one]) () () one_ne_zero)
  simp only [GradedModuleCat.coeff_smulGradedDimension, ite_true,
    LaurentPolynomial.coeff_one] at h
  rw [one_smul (DualNumber k)] at h
  exact_mod_cast h

variable [HasExt.{w} (GradedModuleCat.{u} (dualNumberIntegerGrade k))]

/-- **`dim_k Extⁿ(S, S{j})` is `1` if `j = 2n` and `0` otherwise**, for the graded residue field
`S` of the dual numbers with `ε` in degree two. Each cohomological degree contributes exactly one
internal degree, and none vanishes. -/
theorem finrank_ext_dualNumberGradedResidue_shiftObj (n : ℕ) (j : ℤ) :
    Module.finrank k
        (Ext.{w} (dualNumberGradedResidue k) ((dualNumberGradedResidue k).shiftObj j) n) =
      if j = 2 * n then 1 else 0 := by
  rw [(extDualNumberGradedResidueShiftEquiv k n j).finrank_eq,
    finrank_dualNumberGradedResidue_piece]
  exact if_congr (by omega) rfl rfl

end Field

end TauCeti
