/-!
# Morphisms of differential graded algebras out of generated algebras

A graded algebra map `φ : A → B` between differential graded algebras commutes with the
differentials as soon as it does so on a set of algebra generators of `A`. Indeed, both
`dB ∘ φ` and `φ ∘ dA` are `φ`-derivations of degree `+1`,

`D (a * b) = D a * φ b + (-1) ^ |a| φ a * D b`,

so the elements on which they agree form a subalgebra.

Combined with `AlgHom.map_mem_of_adjoin_range_eq_top`, this says that an algebra map out of a DG
algebra generated by homogeneous elements `x i` is a morphism of DG algebras exactly when it sends
each `x i` to an element of the same degree and commutes with the differentials on each `x i`.
For a free graded-commutative algebra `ΛV` this describes the DG maps out of `ΛV` by the images of
the generators, the description used to construct maps out of Sullivan algebras one generator at a
time in rational homotopy theory.

## Main results

* `TauCeti.IsDGAlgebra.map_d_eq_of_mem_adjoin`: a graded algebra map commutes with the
  differentials on the subalgebra generated by a set on which it does.
* `TauCeti.DGAlgHom.ofAdjoinRangeEqTop`: an algebra map out of an algebra generated by
  homogeneous elements, preserving their degrees and commuting with the differentials on them, as
  a morphism of DG algebras.
* `TauCeti.IsDGAlgebra.exists_dgAlgHom_iff_of_adjoin_range_eq_top`: such an algebra map underlies
  a morphism of DG algebras if and only if it commutes with the differentials on the generators.

## References

* J. W. Morgan, *The algebraic topology of smooth algebraic varieties*, Publ. Math. IHÉS 48
  (1978), Definition 5.1 and the remark after it.
* Y. Félix, S. Halperin, J.-C. Thomas, *Rational homotopy theory*, Graduate Texts in
  Mathematics 205, Springer, 2001, §3.
-/

public section

namespace TauCeti

variable {R A B : Type*} [CommRing R] [Ring A] [Ring B] [Algebra R A] [Algebra R B]
  {𝒜 : ℤ → Submodule R A} {ℬ : ℤ → Submodule R B} [GradedAlgebra 𝒜] [GradedAlgebra ℬ]
  {dA : A →ₗ[R] A} {dB : B →ₗ[R] B}

namespace IsDGAlgebra

/-- A graded algebra map between differential graded algebras commutes with the differentials on
the subalgebra generated by any set on which it commutes with them. -/
theorem map_d_eq_of_mem_adjoin (hA : IsDGAlgebra 𝒜 dA) (hB : IsDGAlgebra ℬ dB)
    (φ : 𝒜 →ₐᵍ[R] ℬ) {s : Set A} (hs : ∀ a ∈ s, dB (φ a) = φ (dA a)) {a : A}
    (ha : a ∈ Algebra.adjoin R s) : dB (φ a) = φ (dA a) := by
  induction ha using Algebra.adjoin_induction with
  | mem a ha => exact hs a ha
  | algebraMap r => rw [AlgHomClass.commutes, hA.map_algebraMap, hB.map_algebraMap, map_zero]
  | add a b _ _ ha hb => rw [map_add, map_add, ha, hb, map_add, map_add]
  | mul a b _ _ ha hb =>
    -- `φ` commutes with the Koszul twist `a ↦ (-1) ^ |a| a` of the Leibniz rule for an
    -- arbitrary left factor.
    rw [map_mul, hB.toIsNonUnitalDGAlgebra.leibniz_koszulTwist,
      hA.toIsNonUnitalDGAlgebra.leibniz_koszulTwist, map_add, map_mul, map_mul, ha, hb,
      φ.map_koszulTwist]

end IsDGAlgebra

namespace DGAlgHom

variable {ι : Type*} {x : ι → A} {deg : ι → ℤ}

/-- An algebra map out of a differential graded algebra generated by homogeneous elements `x i`
of degrees `deg i`, sending each `x i` to an element of degree `deg i` and commuting with the
differentials on each `x i`, as a morphism of differential graded algebras. -/
def ofAdjoinRangeEqTop (hA : IsDGAlgebra 𝒜 dA) (hB : IsDGAlgebra ℬ dB) (φ : A →ₐ[R] B)
    (hx : Algebra.adjoin R (Set.range x) = ⊤) (hx𝒜 : ∀ i, x i ∈ 𝒜 (deg i))
    (hφ : ∀ i, φ (x i) ∈ ℬ (deg i)) (hd : ∀ i, dB (φ (x i)) = φ (dA (x i))) :
    DGAlgHom hA hB where
  toGradedAlgHom := GradedAlgHom.ofAdjoinRangeEqTop φ hx hx𝒜 hφ
  map_d' _ := hA.map_d_eq_of_mem_adjoin hB _
    (by simpa only [Set.forall_mem_range, GradedAlgHom.coe_ofAdjoinRangeEqTop] using hd)
    (hx ▸ Algebra.mem_top)

@[simp]
theorem coe_ofAdjoinRangeEqTop (hA : IsDGAlgebra 𝒜 dA) (hB : IsDGAlgebra ℬ dB) (φ : A →ₐ[R] B)
    (hx : Algebra.adjoin R (Set.range x) = ⊤) (hx𝒜 : ∀ i, x i ∈ 𝒜 (deg i))
    (hφ : ∀ i, φ (x i) ∈ ℬ (deg i)) (hd : ∀ i, dB (φ (x i)) = φ (dA (x i))) :
    ⇑(ofAdjoinRangeEqTop hA hB φ hx hx𝒜 hφ hd) = φ :=
  GradedAlgHom.coe_ofAdjoinRangeEqTop φ hx hx𝒜 hφ

end DGAlgHom

namespace IsDGAlgebra

variable {ι : Type*} {x : ι → A} {deg : ι → ℤ}

/-- **Morphisms out of a generated differential graded algebra.** Let `A` be generated as an
algebra by homogeneous elements `x i` of degrees `deg i`, and let `φ : A → B` be an algebra map
sending each `x i` to an element of degree `deg i`. Then `φ` underlies a morphism of differential
graded algebras if and only if `dB (φ (x i)) = φ (dA (x i))` for every `i`. -/
theorem exists_dgAlgHom_iff_of_adjoin_range_eq_top (hA : IsDGAlgebra 𝒜 dA)
    (hB : IsDGAlgebra ℬ dB) (hx : Algebra.adjoin R (Set.range x) = ⊤)
    (hx𝒜 : ∀ i, x i ∈ 𝒜 (deg i)) (φ : A →ₐ[R] B) (hφ : ∀ i, φ (x i) ∈ ℬ (deg i)) :
    (∃ f : DGAlgHom hA hB, ⇑f = φ) ↔ ∀ i, dB (φ (x i)) = φ (dA (x i)) := by
  refine ⟨?_, fun hd ↦ ⟨DGAlgHom.ofAdjoinRangeEqTop hA hB φ hx hx𝒜 hφ hd,
    DGAlgHom.coe_ofAdjoinRangeEqTop hA hB φ hx hx𝒜 hφ hd⟩⟩
  rintro ⟨f, hf⟩ i
  simpa only [hf] using f.map_d (x i)

end IsDGAlgebra

end TauCeti
