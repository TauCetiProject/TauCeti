module

public import TauCeti.Algebra.Homology.DerivedCategory.Bounded.Localization
public import TauCeti.Algebra.Homology.HomotopyCategory.Bounded.Generation
public import Mathlib.Algebra.Homology.DerivedCategory.KProjective
public import Mathlib.CategoryTheory.Abelian.Projective.Extend
public import Mathlib.CategoryTheory.Abelian.Projective.Resolution

/-!
# Projective resolutions of bounded complexes

In an abelian category with enough projectives, every object of the bounded derived category is
represented by a bounded above complex of projective objects.

The objects of the derived category represented by bounded above complexes of projectives form a
triangulated subcategory (`DerivedCategory.boundedAboveProjective`): a morphism between
two of them lifts to a chain map, since bounded above complexes of projectives are K-projective,
and its mapping cone is again a bounded above complex of projectives. It contains every object
placed in degree zero, through a projective resolution of that object. The bounded homotopy
category is generated by such objects (`TauCeti.HomotopyCategory.Bounded.prop_quotient_obj`), so
it contains the bounded derived category.

A bounded complex of projectives is K-projective, so in the bounded homotopy category it has no
nonzero morphisms to acyclic complexes, and the localization `K^b(C) ⥤ D^b(C)` is bijective on
morphisms out of it.

## Main definitions

* `DerivedCategory.boundedAboveProjective`: the objects of the derived category
  isomorphic to a bounded above complex of projective objects.

## Main results

* `DerivedCategory.boundedAboveProjective_of_bounded`: in an abelian category with
  enough projectives, every object of the bounded derived category is represented by a bounded
  above complex of projective objects.
* `DerivedCategory.exists_projective_isGE_isStrictlyLE_of_bounded`: such a complex can moreover
  be chosen with cohomology bounded below.
* `DerivedCategory.Bounded.exists_bounded_projective_iff_exists_projective_Qh_obj_iso`: an object
  of the bounded derived category is represented by a bounded complex of projectives if and only
  if it is the image of one from the bounded homotopy category.
* `TauCeti.DerivedCategory.Bounded.leftOrthogonal_quotient_obj_of_projective`: a bounded complex
  of projectives is left orthogonal to the acyclic objects of the bounded homotopy category.
* `TauCeti.DerivedCategory.Bounded.Qh_map_bijective_of_projective`: the localization
  `K^b(C) ⥤ D^b(C)` is bijective on morphisms out of a bounded complex of projectives.
-/

public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated ZeroObject

universe w v u

namespace DerivedCategory

variable (C : Type u) [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

/-- The objects of the derived category isomorphic to a bounded above complex of projective
objects. -/
def boundedAboveProjective : ObjectProperty (DerivedCategory C) :=
  fun X ↦ ∃ (K : CochainComplex C ℤ) (d : ℤ), K.IsStrictlyLE d ∧ (∀ n, Projective (K.X n)) ∧
    Nonempty (DerivedCategory.Q.obj K ≅ X)

variable {C}

lemma boundedAboveProjective_iff (X : DerivedCategory C) :
    boundedAboveProjective C X ↔ ∃ (K : CochainComplex C ℤ) (d : ℤ), K.IsStrictlyLE d ∧
      (∀ n, Projective (K.X n)) ∧ Nonempty (DerivedCategory.Q.obj K ≅ X) :=
  Iff.rfl

instance : (boundedAboveProjective C).IsClosedUnderIsomorphisms where
  of_iso e := fun ⟨K, d, hd, hK, ⟨e'⟩⟩ ↦ ⟨K, d, hd, hK, ⟨e' ≪≫ e⟩⟩

instance : (boundedAboveProjective C).ContainsZero where
  exists_zero := ⟨_, DerivedCategory.Q.map_isZero (isZero_zero _),
    ⟨0, 0, inferInstance, fun n ↦ Projective.of_iso ((isZero_zero C).iso
      ((HomologicalComplex.eval C _ n).map_isZero (isZero_zero _))) inferInstance,
      ⟨Iso.refl _⟩⟩⟩

instance : (boundedAboveProjective C).IsStableUnderShift ℤ where
  isStableUnderShiftBy a := ⟨fun _ ⟨K, d, hd, hK, ⟨e⟩⟩ ↦
    ⟨K⟦a⟧, d - a, K.isStrictlyLE_shift d a _ (by lia), fun n ↦ hK (n + a),
      ⟨(DerivedCategory.Q.commShiftIso a).app K ≪≫ (shiftFunctor _ a).mapIso e⟩⟩⟩

/-- The cone of a morphism between bounded above complexes of projectives, in the derived
category, is again represented by such a complex: the morphism lifts to a chain map, and the
mapping cone of a chain map between bounded above complexes of projectives is one. -/
private lemma boundedAboveProjective_ext₃ {T : Triangle (DerivedCategory C)}
    (hT : T ∈ distTriang _) (h₁ : boundedAboveProjective C T.obj₁)
    (h₂ : boundedAboveProjective C T.obj₂) : boundedAboveProjective C T.obj₃ := by
  obtain ⟨K, d, _, hK, ⟨e₁⟩⟩ := h₁
  obtain ⟨L, d', _, hL, ⟨e₂⟩⟩ := h₂
  have := CochainComplex.isKProjective_of_projective K d
  -- The morphism `T.mor₁`, transported to `Q.obj K ⟶ Q.obj L`, comes from a chain map.
  let f₀ : DerivedCategory.Qh.obj ((HomotopyCategory.quotient _ _).obj K) ⟶
      DerivedCategory.Qh.obj ((HomotopyCategory.quotient _ _).obj L) :=
    (DerivedCategory.quotientCompQhIso C).hom.app K ≫ e₁.hom ≫ T.mor₁ ≫ e₂.inv ≫
      (DerivedCategory.quotientCompQhIso C).inv.app L
  obtain ⟨g, hg⟩ := (CochainComplex.IsKProjective.Qh_map_bijective K _).2 f₀
  obtain ⟨φ, rfl⟩ := (HomotopyCategory.quotient C _).map_surjective g
  have hφ : DerivedCategory.Q.map φ = e₁.hom ≫ T.mor₁ ≫ e₂.inv := by
    have := DerivedCategory.quotientCompQhIso_hom_naturality φ
    simp only [Functor.comp_obj] at this
    rw [← cancel_epi ((DerivedCategory.quotientCompQhIso C).hom.app K), ← this, hg]
    simp [f₀]
  refine ⟨CochainComplex.mappingCone φ, max (d - 1) d',
    CochainComplex.isStrictlyLE_mappingCone φ d d' _, fun n ↦ ?_, ⟨?_⟩⟩
  · exact Projective.of_iso (HomologicalComplex.homotopyCofiber.XIsoBiprod φ n (n + 1) rfl).symm
      inferInstance
  · -- Compare the triangle of the mapping cone with `T` on the first two vertices.
    refine Triangle.π₃.mapIso (isoTriangleOfIso₁₂ _ _
      (DerivedCategory.mappingCone_triangle_distinguished φ) hT e₁ e₂ ?_)
    simp [hφ]

instance : (boundedAboveProjective C).IsTriangulatedClosed₃ :=
  ObjectProperty.IsTriangulatedClosed₃.mk' fun _ hT h₁ h₂ ↦ boundedAboveProjective_ext₃ hT h₁ h₂

instance : (boundedAboveProjective C).IsTriangulatedClosed₂ :=
  ObjectProperty.IsTriangulatedClosed₂.of_isTriangulatedClosed₃

instance : (boundedAboveProjective C).IsTriangulated where

/-- An object placed in degree zero is represented by its projective resolution. -/
lemma boundedAboveProjective_singleFunctor_obj [EnoughProjectives C] (X : C) :
    boundedAboveProjective C ((DerivedCategory.singleFunctor C 0).obj X) := by
  let R := projectiveResolution X
  exact ⟨R.cochainComplex, 0, inferInstance, fun n ↦ inferInstance,
    ⟨asIso (DerivedCategory.Q.map R.π') ≪≫
      ((DerivedCategory.singleFunctorIsoCompQ C 0).app X).symm⟩⟩

/-- **Every object of the bounded derived category is represented by a bounded above complex of
projective objects**, in an abelian category with enough projectives. -/
theorem boundedAboveProjective_of_bounded [EnoughProjectives C]
    (X : DerivedCategory.Bounded C) :
    boundedAboveProjective C (DerivedCategory.Bounded.ι.obj X) := by
  let P := ((boundedAboveProjective C).inverseImage DerivedCategory.Bounded.ι).inverseImage
    (TauCeti.DerivedCategory.Bounded.Qh C)
  obtain ⟨Y, ⟨e⟩⟩ := Functor.EssSurj.mem_essImage (F := TauCeti.DerivedCategory.Bounded.Qh C) X
  -- `Y` is the homotopy class of its underlying bounded complex.
  let K : CochainComplex.Bounded C :=
    ⟨TauCeti.HomotopyCategory.Bounded.rep Y, TauCeti.HomotopyCategory.Bounded.bounded_rep Y⟩
  have eY : (TauCeti.HomotopyCategory.Bounded.quotient C).obj K ≅ Y :=
    (TauCeti.HomotopyCategory.Bounded.fullyFaithfulι C).preimageIso (eqToIso
      ((TauCeti.HomotopyCategory.Bounded.quotient_obj_obj C K).trans
        (TauCeti.HomotopyCategory.Bounded.quotient_obj_rep Y)))
  have hK : P ((TauCeti.HomotopyCategory.Bounded.quotient C).obj K) :=
    TauCeti.HomotopyCategory.Bounded.prop_quotient_obj P K fun n ↦
      (boundedAboveProjective C).prop_of_iso
        (DerivedCategory.Bounded.ι.mapIso
          ((TauCeti.DerivedCategory.Bounded.singleFunctorCompQhIso C 0).app (K.obj.X n))).symm
        (boundedAboveProjective_singleFunctor_obj (K.obj.X n))
  exact (boundedAboveProjective C).prop_of_iso
    (DerivedCategory.Bounded.ι.mapIso
      ((TauCeti.DerivedCategory.Bounded.Qh C).mapIso eY ≪≫ e)) hK

/-- In an abelian category with enough projectives, every object `X` of the bounded derived
category is represented by a complex `K` of projective objects which is strictly `≤ b` and has no
cohomology in degrees `< a`, for some `a` and `b`. -/
theorem exists_projective_isGE_isStrictlyLE_of_bounded [EnoughProjectives C]
    (X : DerivedCategory.Bounded C) :
    ∃ (K : CochainComplex C ℤ) (a b : ℤ), K.IsGE a ∧ K.IsStrictlyLE b ∧
      (∀ n, Projective (K.X n)) ∧
        Nonempty (DerivedCategory.Q.obj K ≅ DerivedCategory.Bounded.ι.obj X) := by
  obtain ⟨K, b, _, hK, ⟨e⟩⟩ :=
    (boundedAboveProjective_iff _).1 (boundedAboveProjective_of_bounded X)
  -- `X` lies in the bounded derived category, so it is `≥ a` for the canonical t-structure.
  obtain ⟨a, ha⟩ := X.property.1
  have : TStructure.t.IsGE (DerivedCategory.Bounded.ι.obj X) a := ha
  exact ⟨K, a, b, (isGE_Q_obj_iff K a).1 (TStructure.t.isGE_of_iso e.symm a), ‹_›, hK, ⟨e⟩⟩

end DerivedCategory

namespace DerivedCategory.Bounded

variable {C : Type u} [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

open TauCeti.DerivedCategory.Bounded in
/-- An object of the bounded derived category is represented by a bounded complex `K` of
projective objects if and only if it is the image of such a complex, as an object of the bounded
homotopy category. -/
theorem exists_bounded_projective_iff_exists_projective_Qh_obj_iso
    (X : DerivedCategory.Bounded C) :
    (∃ (K : CochainComplex C ℤ) (a b : ℤ), K.IsStrictlyGE a ∧ K.IsStrictlyLE b ∧
      (∀ n, Projective (K.X n)) ∧ Nonempty (Q.obj K ≅ DerivedCategory.Bounded.ι.obj X)) ↔
    ∃ K : CochainComplex.Bounded C, (∀ n, Projective (K.obj.X n)) ∧
      Nonempty ((TauCeti.DerivedCategory.Bounded.Qh C).obj
        ((TauCeti.HomotopyCategory.Bounded.quotient C).obj K) ≅ X) := by
  -- Both sides compare `X` with the image of the same complex, along this isomorphism.
  let φ (K : CochainComplex.Bounded C) : DerivedCategory.Bounded.ι.obj
      ((TauCeti.DerivedCategory.Bounded.Qh C).obj
        ((TauCeti.HomotopyCategory.Bounded.quotient C).obj K)) ≅ Q.obj K.obj :=
    (QhCompιIsoιCompQh C).app _ ≪≫ DerivedCategory.Qh.mapIso (eqToIso
      (TauCeti.HomotopyCategory.Bounded.quotient_obj_obj C K)) ≪≫ (quotientCompQhIso C).app K.obj
  refine ⟨fun ⟨K, a, b, _, _, hK, ⟨e⟩⟩ ↦ ?_, fun ⟨K, hK, ⟨e⟩⟩ ↦ ?_⟩
  · let K' : CochainComplex.Bounded C :=
      ⟨K, (CochainComplex.bounded_iff _ _).2 ⟨a, b, ‹_›, ‹_›⟩⟩
    exact ⟨K', hK, ⟨DerivedCategory.Bounded.ι.preimageIso (φ K' ≪≫ e)⟩⟩
  · obtain ⟨a, b, _, _⟩ := (CochainComplex.bounded_iff C K.obj).1 K.property
    exact ⟨K.obj, a, b, ‹_›, ‹_›, hK, ⟨(φ K).symm ≪≫ DerivedCategory.Bounded.ι.mapIso e⟩⟩

end DerivedCategory.Bounded

namespace TauCeti.DerivedCategory.Bounded

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- A bounded complex of projective objects is left orthogonal, in the bounded homotopy category,
to the acyclic complexes: it is K-projective. -/
theorem leftOrthogonal_quotient_obj_of_projective (K : CochainComplex.Bounded C)
    (hK : ∀ n, Projective (K.obj.X n)) :
    (HomotopyCategory.Bounded.subcategoryAcyclic C).leftOrthogonal
      ((HomotopyCategory.Bounded.quotient C).obj K) := by
  obtain ⟨_, b, _, _⟩ := (CochainComplex.bounded_iff C K.obj).1 K.property
  have := CochainComplex.isKProjective_of_projective K.obj b
  intro L f hL
  ext
  simpa using CochainComplex.IsKProjective.leftOrthogonal K.obj
    (eqToHom (HomotopyCategory.Bounded.quotient_obj_obj C K).symm ≫ f.hom) hL

variable [HasDerivedCategory.{w} C]

/-- The localization `K^b(C) ⥤ D^b(C)` is bijective on morphisms out of a bounded complex of
projective objects. -/
theorem Qh_map_bijective_of_projective (K : CochainComplex.Bounded C)
    (hK : ∀ n, Projective (K.obj.X n)) (L : HomotopyCategory.Bounded C) :
    Function.Bijective ((Qh C).map : ((HomotopyCategory.Bounded.quotient C).obj K ⟶ L) → _) :=
  (leftOrthogonal_quotient_obj_of_projective K hK).map_bijective_of_isTriangulated _ _

end TauCeti.DerivedCategory.Bounded
