module

public import TauCeti.Algebra.Homology.DerivedCategory.Bounded.Basic
public import TauCeti.Algebra.Homology.DerivedCategory.Bounded.Localization
public import TauCeti.Algebra.Homology.HomotopyCategory.Bounded.Generation
public import Mathlib.Algebra.Category.FGModuleCat.Abelian
public import Mathlib.CategoryTheory.Localization.Triangulated
public import Mathlib.CategoryTheory.Triangulated.Generators

/-!
# The singularity category

The singularity category of an abelian category `C` is the Verdier quotient

`D_sg(C) = Dᵇ(C) / Perf(C)`

of the bounded derived category by its perfect objects. Here `Perf(C)` is the thick subcategory
generated by the projective objects of `C`, viewed as complexes concentrated in degree zero:
the smallest triangulated subcategory closed under retracts that contains them,
`ObjectProperty.triangEnvelope`. Every bounded complex of projective objects is perfect
(`TauCeti.DerivedCategory.Bounded.perfect_Qh_obj_quotient_obj`). When `C` has enough
projectives, the perfect objects are exactly those represented by bounded complexes of
projectives; that converse is not proved here. The
quotient is the localization at the morphisms whose cone is perfect (`ObjectProperty.trW`),
with the triangulated structure of `Triangulated.Localization`.

For a left noetherian ring `A`, the finitely generated left `A`-modules form the abelian category
`FGModuleCat A`, and `ModuleCat.SingularityCategory A` is Buchweitz's singularity category
`Dᵇ(mod-A) / Kᵇ(proj-A)`. Right modules are left modules over `Aᵐᵒᵖ`.

## Main definitions

* `TauCeti.DerivedCategory.Bounded.perfect`: the thick subcategory of `Dᵇ(C)` generated by the
  projective objects of `C` in degree zero.
* `TauCeti.SingularityCategory`: the Verdier quotient `Dᵇ(C) / Perf(C)`, with its quotient
  functor `TauCeti.SingularityCategory.Q`, a triangulated localization.
* `TauCeti.ModuleCat.SingularityCategory`: the singularity category of a left noetherian ring.

## Main results

* `TauCeti.DerivedCategory.Bounded.perfect_Qh_obj_quotient_obj`: a bounded complex of projective
  objects is perfect.
* `TauCeti.DerivedCategory.Bounded.perfect_singleFunctor_obj`: a projective object placed in any
  degree is perfect.
* `TauCeti.DerivedCategory.Bounded.perfect_le_inverseImage_ι`: a thick subcategory of the derived
  category containing the projective objects in degree zero contains the perfect objects.
* `TauCeti.DerivedCategory.Bounded.perfect_trW_of_distinguished`: a morphism whose image in the
  derived category has a perfect cone is in `(perfect C).trW`.
* `TauCeti.SingularityCategory.isZero_Q_obj_of_perfect`: perfect objects vanish in the
  singularity category; in particular so do the projective objects of `C`.

## References

* Ragnar-Olaf Buchweitz, *Maximal Cohen–Macaulay Modules and Tate Cohomology*, Section 1.2.
* Dmitri Orlov, *Triangulated categories of singularities and D-branes in Landau–Ginzburg
  models*, Section 1.
-/

public section

namespace TauCeti

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated ZeroObject

universe w v u

variable (C : Type u) [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

namespace DerivedCategory.Bounded

/-- The projective objects of `C`, as complexes concentrated in degree zero, up to
isomorphism. -/
def projectiveSingle : ObjectProperty (DerivedCategory.Bounded C) :=
  fun X ↦ ∃ P : C, Projective P ∧ Nonempty (X ≅ (singleFunctor C 0).obj P)

/-- The objects of `projectiveSingle C` are the projective objects of `C` in degree zero, up to
isomorphism. -/
lemma projectiveSingle_iff (X : DerivedCategory.Bounded C) :
    projectiveSingle C X ↔ ∃ P : C, Projective P ∧ Nonempty (X ≅ (singleFunctor C 0).obj P) :=
  Iff.rfl

instance : (projectiveSingle C).Nonempty :=
  ⟨⟨(singleFunctor C 0).obj 0, 0, inferInstance, ⟨Iso.refl _⟩⟩⟩

/-- The **perfect objects** of the bounded derived category: the thick subcategory generated by
the projective objects of `C` in degree zero. -/
def perfect : ObjectProperty (DerivedCategory.Bounded C) :=
  (projectiveSingle C).triangEnvelope

/-- The perfect objects are the thick closure of the projective objects in degree zero. -/
lemma perfect_eq : perfect C = (projectiveSingle C).triangEnvelope := (rfl)

instance : (perfect C).IsTriangulated := by
  dsimp only [perfect]
  infer_instance

instance : (perfect C).IsStableUnderRetracts := by
  dsimp only [perfect]
  infer_instance

/-- A projective object of `C` placed in any degree is perfect. -/
lemma perfect_singleFunctor_obj (n : ℤ) {P : C} (hP : Projective P) :
    perfect C ((singleFunctor C n).obj P) :=
  -- The degree-zero object is a generator; shifting by `-n` moves it to degree `n`.
  (perfect C).prop_of_iso (((singleFunctors C).shiftIso (-n) n 0 (by lia)).app P)
    ((perfect C).le_shift (-n) _ ((projectiveSingle C).le_triangEnvelope _ ⟨P, hP, ⟨Iso.refl _⟩⟩))

variable {C} in
/-- **Perfect objects lie in every thick subcategory containing the projectives**: a triangulated
subcategory of the derived category which is stable under retracts and contains the projective
objects placed in degree zero contains the perfect objects of the bounded derived category. -/
theorem perfect_le_inverseImage_ι (Q : ObjectProperty (_root_.DerivedCategory C))
    [Q.IsClosedUnderIsomorphisms] [Q.IsTriangulated] [Q.IsStableUnderRetracts]
    (hQ : ∀ P : C, Projective P → Q ((_root_.DerivedCategory.singleFunctor C 0).obj P)) :
    perfect C ≤ Q.inverseImage _root_.DerivedCategory.Bounded.ι := by
  have : (Q.inverseImage _root_.DerivedCategory.Bounded.ι).IsStableUnderRetracts :=
    ⟨fun r h ↦ Q.prop_of_retract (r.map _root_.DerivedCategory.Bounded.ι) h⟩
  rw [perfect_eq, ObjectProperty.triangEnvelope_le_iff]
  intro Y hY
  obtain ⟨P, hP, ⟨e⟩⟩ := (projectiveSingle_iff C Y).1 hY
  exact Q.prop_of_iso (_root_.DerivedCategory.Bounded.ι.mapIso e).symm (hQ P hP)

variable {C} in
/-- A morphism of the bounded derived category whose image in the derived category is the first
morphism of a distinguished triangle with perfect third vertex has a perfect cone. -/
theorem perfect_trW_of_distinguished {A B Z : _root_.DerivedCategory.Bounded C} (f : A ⟶ B)
    (g : _root_.DerivedCategory.Bounded.ι.obj B ⟶ _root_.DerivedCategory.Bounded.ι.obj Z)
    (h : _root_.DerivedCategory.Bounded.ι.obj Z ⟶
      (_root_.DerivedCategory.Bounded.ι.obj A)⟦(1 : ℤ)⟧)
    (hT : Triangle.mk (_root_.DerivedCategory.Bounded.ι.map f) g h ∈ distTriang _)
    (hZ : perfect C Z) : (perfect C).trW f := by
  -- Compare a cone of `f` in the bounded derived category with the given triangle.
  obtain ⟨Z', g', h', hT'⟩ := distinguished_cocone_triangle f
  let e := isoTriangleOfIso₁₂ _ _ (_root_.DerivedCategory.Bounded.ι.map_distinguished _ hT') hT
    (Iso.refl _) (Iso.refl _) (by simp)
  exact ObjectProperty.trW.mk _ hT' ((perfect C).prop_of_iso
    ((ObjectProperty.fullyFaithfulι _).preimageIso (Triangle.π₃.mapIso e)).symm hZ)

/-- **A bounded complex of projective objects is perfect.** -/
theorem perfect_Qh_obj_quotient_obj (K : CochainComplex.Bounded C)
    (hK : ∀ n, Projective (K.obj.X n)) :
    perfect C ((Qh C).obj ((HomotopyCategory.Bounded.quotient C).obj K)) :=
  HomotopyCategory.Bounded.prop_quotient_obj ((perfect C).inverseImage (Qh C)) K fun n ↦
    (perfect C).prop_of_iso ((singleFunctorCompQhIso C 0).app (K.obj.X n)).symm
      (perfect_singleFunctor_obj C 0 (hK n))

end DerivedCategory.Bounded

/-- The **singularity category** `Dᵇ(C) / Perf(C)` of an abelian category: the Verdier quotient
of the bounded derived category by the thick subcategory generated by the projective objects. -/
abbrev SingularityCategory :=
  (DerivedCategory.Bounded.perfect C).trW.Localization

namespace SingularityCategory

/-- The Verdier quotient functor `Dᵇ(C) ⥤ D_sg(C)`. -/
noncomputable def Q : DerivedCategory.Bounded C ⥤ SingularityCategory C :=
  (DerivedCategory.Bounded.perfect C).trW.Q

/-- The quotient functor is the localization functor of `(perfect C).trW`. -/
lemma Q_eq : Q C = (DerivedCategory.Bounded.perfect C).trW.Q := (rfl)

instance : (Q C).IsLocalization (DerivedCategory.Bounded.perfect C).trW := by
  dsimp only [Q]
  infer_instance

noncomputable instance : Preadditive (SingularityCategory C) :=
  Localization.preadditive (Q C) (DerivedCategory.Bounded.perfect C).trW

instance : (Q C).Additive :=
  Localization.functor_additive (Q C) (DerivedCategory.Bounded.perfect C).trW

noncomputable instance : HasZeroObject (SingularityCategory C) :=
  (Q C).hasZeroObject_of_additive

noncomputable instance : HasShift (SingularityCategory C) ℤ :=
  HasShift.localized (Q C) (DerivedCategory.Bounded.perfect C).trW ℤ

noncomputable instance : (Q C).CommShift ℤ :=
  Functor.CommShift.localized (Q C) (DerivedCategory.Bounded.perfect C).trW ℤ

instance (n : ℤ) : (shiftFunctor (SingularityCategory C) n).Additive := by
  rw [Localization.functor_additive_iff (Q C) (DerivedCategory.Bounded.perfect C).trW]
  exact Functor.additive_of_iso ((Q C).commShiftIso n)

noncomputable instance : Pretriangulated (SingularityCategory C) :=
  Triangulated.Localization.pretriangulated (Q C) (DerivedCategory.Bounded.perfect C).trW

instance : (Q C).IsTriangulated :=
  Triangulated.Localization.isTriangulated_functor (Q C) (DerivedCategory.Bounded.perfect C).trW

instance : IsTriangulated (SingularityCategory C) :=
  Triangulated.Localization.isTriangulated (Q C) (DerivedCategory.Bounded.perfect C).trW

variable {C}

/-- **Perfect objects vanish in the singularity category.** -/
lemma isZero_Q_obj_of_perfect {X : DerivedCategory.Bounded C}
    (hX : DerivedCategory.Bounded.perfect C X) : IsZero ((Q C).obj X) := by
  -- The map from zero to `X` has cone `X`, which is perfect, so it becomes invertible.
  have h : (DerivedCategory.Bounded.perfect C).trW (0 : 0 ⟶ X) :=
    ObjectProperty.trW.mk _ (contractible_distinguished₁ X) hX
  have := Localization.inverts (Q C) _ _ h
  exact ((Q C).map_isZero (isZero_zero _)).of_iso (asIso ((Q C).map (0 : 0 ⟶ X))).symm

/-- A projective object of `C`, in degree zero, vanishes in the singularity category. -/
lemma isZero_Q_obj_singleFunctor_obj {P : C} (hP : Projective P) :
    IsZero ((Q C).obj ((DerivedCategory.Bounded.singleFunctor C 0).obj P)) :=
  isZero_Q_obj_of_perfect (DerivedCategory.Bounded.perfect_singleFunctor_obj C 0 hP)

end SingularityCategory

/-- The **singularity category of a left noetherian ring** `A`, `Dᵇ(mod-A) / Kᵇ(proj-A)`, for
the abelian category of finitely generated left `A`-modules. Use `Aᵐᵒᵖ` for right modules. -/
abbrev ModuleCat.SingularityCategory (A : Type u) [Ring A] [IsNoetherianRing A]
    [HasDerivedCategory.{w} (FGModuleCat.{u} A)] :=
  TauCeti.SingularityCategory (FGModuleCat.{u} A)

end TauCeti
