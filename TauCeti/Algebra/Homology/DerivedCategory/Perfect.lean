/-!
# Perfect objects are bounded complexes of projectives

Let `C` be an abelian category with enough projectives. An object of the bounded derived category
is perfect, that is, lies in the thick subcategory generated by the projective objects in degree
zero, if and only if it is represented by a bounded complex of projective objects.

One direction is `TauCeti.DerivedCategory.Bounded.perfect_Qh_obj_quotient_obj`. For the other,
a perfect object `X` has no morphisms to `W[-n]` for `W` in `C` and `n` small enough, since the
projective objects in degree zero have this property and it is inherited by the thick subcategory
they generate. Represent `X` by a bounded above complex `K` of projectives, and let `m` be so small
that `K` is exact below `m` and `X` has no morphisms to objects of `C` placed in degree `m - 1`.
The canonical truncation `K.truncGE m` is quasi-isomorphic to `K`, its terms are those of `K` above
`m`, and its term in degree `m` is `K.opcycles m`, the cokernel of `d : K^{m-1} ⟶ K^m`. The chain
map `K ⟶ (K.opcycles (m - 1))[1 - m]` given by the projection is zero in the derived category,
hence null-homotopic since `K` is K-projective, and the null-homotopy splits off `K.opcycles m`
as a retract of `K^m` (`CochainComplex.retractOpcyclesOfHomotopy`). So `K.truncGE m` is a bounded
complex of projective objects.

The same truncation shows that in finite global dimension every object of the bounded derived
category is represented by a bounded complex of projectives. If every object of `C` has projective
dimension `< d` and `K` is exact below `a`, then along the short exact sequences
`0 ⟶ Zʲ ⟶ Kʲ ⟶ Zʲ⁺¹ ⟶ 0` the cycles `Zᵐ⁺¹` are a `d`-th syzygy of `Zᵐ⁺¹⁺ᵈ` for `m` far below
`a`, hence projective, and `K.opcycles m ≅ Zᵐ⁺¹`.

## Main results

* `DerivedCategory.singleFunctor_hom_eq_zero_of_projective`: a projective object placed in degree
  `n` has no nonzero morphisms to objects placed in lower degrees.
* `DerivedCategory.exists_homSingle_eq_zero_of_perfect`: a perfect object has no morphisms to
  objects of `C` placed in sufficiently negative degrees.
* `DerivedCategory.exists_singleHom_eq_zero_of_perfect`: a perfect object has no morphisms from
  objects of `C` without higher extensions by projectives, placed in sufficiently positive
  degrees.
* `DerivedCategory.exists_bounded_projective_of_projective_opcycles`: a bounded above complex of
  projectives, exact below `m`, with projective `K.opcycles m` is quasi-isomorphic to a bounded
  complex of projectives.
* `DerivedCategory.exists_bounded_projective_of_perfect`: a perfect object is represented by a
  bounded complex of projective objects.
* `DerivedCategory.exists_bounded_projective_of_hasProjectiveDimensionLT`,
  `DerivedCategory.Bounded.exists_projective_Qh_obj_iso_of_hasProjectiveDimensionLT`: in finite
  global dimension, every object of the bounded derived category is represented by a bounded
  complex of projective objects.
* `DerivedCategory.Bounded.perfect_iff`: an object of the bounded derived category is
  perfect if and only if it is the image of a bounded complex of projective objects.
-/

public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated ZeroObject

universe w' w v u

namespace DerivedCategory

variable {C : Type u} [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

/-- A projective object placed in degree `n` has no nonzero morphisms to an object placed in a
lower degree `m < n`: Mathlib's `from_singleFunctor_obj_eq_zero_of_projective`, transported along
`singleFunctorIsoCompQ`. -/
theorem singleFunctor_hom_eq_zero_of_projective {Q : C} [Projective Q] {m n : ℤ} (hmn : m < n)
    {Y : C} (f : (singleFunctor C n).obj Q ⟶ (singleFunctor C m).obj Y) : f = 0 := by
  rw [← cancel_epi ((singleFunctorIsoCompQ C n).inv.app Q),
    ← cancel_mono ((singleFunctorIsoCompQ C m).hom.app Y), comp_zero, zero_comp]
  exact from_singleFunctor_obj_eq_zero_of_projective _ m hmn

variable (C) in
/-- The objects of `C` placed in degree `-n`, up to isomorphism. -/
private def singleNeg (n : ℤ) : ObjectProperty (DerivedCategory C) :=
  fun Y ↦ ∃ (m : ℤ) (W : C), m + n = 0 ∧ Nonempty (Y ≅ (singleFunctor C m).obj W)

/-- Shifting by `-a` moves objects placed in degree `-n` to degree `-(n - a)`. -/
private lemma singleNeg_shift (a : ℤ) :
    ∃ c : ℤ, ∀ n (Y : DerivedCategory C), singleNeg C n Y → singleNeg C (n + c) (Y⟦-a⟧) :=
  ⟨-a, fun _ _ ⟨m, W, hm, ⟨e⟩⟩ ↦ ⟨m + a, W, by lia,
    ⟨(shiftFunctor _ (-a)).mapIso e ≪≫
      ((singleFunctors C).shiftIso (-a) (m + a) m (by lia)).app W⟩⟩⟩

/-- **Perfect objects have bounded morphisms to objects of `C`**: a perfect object of the bounded
derived category has no nonzero morphisms to `W[-n]` for `W` in `C` and `n` small enough. -/
theorem exists_homSingle_eq_zero_of_perfect {X : DerivedCategory.Bounded C}
    (hX : TauCeti.DerivedCategory.Bounded.perfect C X) :
    ∃ n₀ : ℤ, ∀ n ≤ n₀, ∀ (W : C) (f : DerivedCategory.Bounded.ι.obj X ⟶ (singleFunctor C n).obj W),
      f = 0 := by
  have := ObjectProperty.isStableUnderShift_eventuallyLeftOrthogonal (singleNeg_shift (C := C))
  have : (ObjectProperty.eventuallyLeftOrthogonal (singleNeg C)).IsTriangulated := {}
  -- A projective object in degree zero has no morphisms to objects in negative degrees.
  obtain ⟨n₀, h⟩ := ObjectProperty.eventuallyLeftOrthogonal_iff.1
    (TauCeti.DerivedCategory.Bounded.perfect_le_inverseImage_ι
    (ObjectProperty.eventuallyLeftOrthogonal (singleNeg C))
    (fun P (_ : Projective P) ↦ ObjectProperty.eventuallyLeftOrthogonal_iff.2
      ⟨1, fun n hn Y f ⟨m, W, hm, ⟨e⟩⟩ ↦ by
        rw [← cancel_mono e.hom, zero_comp]
        exact singleFunctor_hom_eq_zero_of_projective (by lia) _⟩) X hX)
  exact ⟨-n₀, fun n hn W f ↦ h (-n) (by lia) f ⟨n, W, by lia, ⟨Iso.refl _⟩⟩⟩

section ExtOrthogonal

variable [HasExt.{w'} C]

variable (C) in
/-- The objects of `C` without higher extensions by projectives placed in degree `n`, up to
isomorphism. -/
private def singleExtProjOrth (n : ℤ) : ObjectProperty (DerivedCategory C) :=
  fun Y ↦ ∃ X : C, (∀ i : ℕ, (isProjective C).extLeftOrthogonal (i + 1) X) ∧
    Nonempty (Y ≅ (singleFunctor C n).obj X)

/-- Shifting by `-a` moves objects placed in degree `n` to degree `n + a`. -/
private lemma singleExtProjOrth_shift (a : ℤ) :
    ∃ c : ℤ, ∀ n (Y : DerivedCategory C), singleExtProjOrth C n Y →
      singleExtProjOrth C (n + c) (Y⟦-a⟧) :=
  ⟨a, fun n _ ⟨X, hX, ⟨e⟩⟩ ↦ ⟨X, hX,
    ⟨(shiftFunctor _ (-a)).mapIso e ≪≫
      ((singleFunctors C).shiftIso (-a) (n + a) n (by lia)).app X⟩⟩⟩

/-- **Perfect objects receive no morphisms from Ext-orthogonal objects in high degrees**: for a
perfect object `K` of the bounded derived category there is `n₀` such that every morphism to `K`
from an object of `C` without higher extensions by projectives, placed in a degree `n ≥ n₀`,
vanishes. -/
theorem exists_singleHom_eq_zero_of_perfect {K : DerivedCategory.Bounded C}
    (hK : TauCeti.DerivedCategory.Bounded.perfect C K) :
    ∃ n₀ : ℤ, ∀ n ≥ n₀, ∀ X : C, (∀ i : ℕ, (isProjective C).extLeftOrthogonal (i + 1) X) →
      ∀ f : (singleFunctor C n).obj X ⟶ DerivedCategory.Bounded.ι.obj K, f = 0 := by
  have := ObjectProperty.isStableUnderShift_eventuallyRightOrthogonal
    (singleExtProjOrth_shift (C := C))
  have : (ObjectProperty.eventuallyRightOrthogonal (singleExtProjOrth C)).IsTriangulated := {}
  -- A projective object in degree zero receives no morphisms from such objects in positive degrees.
  obtain ⟨n₀, h⟩ := ObjectProperty.eventuallyRightOrthogonal_iff.1
    (TauCeti.DerivedCategory.Bounded.perfect_le_inverseImage_ι
    (ObjectProperty.eventuallyRightOrthogonal (singleExtProjOrth C))
    (fun Q hQ ↦ ObjectProperty.eventuallyRightOrthogonal_iff.2 ⟨1, fun n hn Y f ⟨X, hX, ⟨e⟩⟩ ↦ by
      obtain ⟨m, rfl⟩ : ∃ m : ℕ, n = (m + 1 : ℕ) := ⟨(n - 1).toNat, by lia⟩
      rw [← e.hom_inv_id_assoc f, singleFunctor_hom_eq_zero_of_ext
        (ObjectProperty.extLeftOrthogonal_iff.1 (hX m) hQ) (e.inv ≫ f), comp_zero]⟩) K hK)
  exact ⟨n₀, fun n hn X hX f ↦ h n hn f ⟨X, hX, ⟨Iso.refl _⟩⟩⟩

end ExtOrthogonal

/-- Let `K` be a complex of projective objects which is strictly `≤ b` and has no cohomology in
degrees `< m`, for some `m ≤ b`. If the cokernel `K.opcycles m` of the differential into degree
`m` is projective, then `K` is isomorphic in the derived category to a bounded complex of
projective objects (namely its canonical truncation `K.truncGE m`). -/
theorem exists_bounded_projective_of_projective_opcycles {K : CochainComplex C ℤ} {m b : ℤ}
    (hmb : m ≤ b) [K.IsStrictlyLE b] [K.IsGE m] (hK : ∀ n, Projective (K.X n))
    [Projective (K.opcycles m)] :
    ∃ (L : CochainComplex C ℤ) (a b : ℤ), L.IsStrictlyGE a ∧ L.IsStrictlyLE b ∧
      (∀ n, Projective (L.X n)) ∧ Nonempty (Q.obj L ≅ Q.obj K) := by
  have : QuasiIso (K.πTruncGE m) := (K.quasiIso_πTruncGE_iff m).2 inferInstance
  refine ⟨K.truncGE m, m, b, inferInstance, ?_, fun i ↦ ?_,
    ⟨(asIso (Q.map (K.πTruncGE m))).symm⟩⟩
  · rw [CochainComplex.isStrictlyLE_iff]
    intro i hi
    exact (K.isZero_of_isStrictlyLE b i hi).of_iso (K.truncGEXIso m i (by lia))
  · obtain hi | rfl | hi := lt_trichotomy i m
    · exact Projective.of_iso ((K.truncGE m).isZero_of_isStrictlyGE m i hi).isoZero.symm
        inferInstance
    · exact Projective.of_iso (K.truncGEXIsoOpcycles _).symm inferInstance
    · exact Projective.of_iso (K.truncGEXIso m i hi).symm inferInstance

/-- **Perfect objects are bounded complexes of projectives**: in an abelian category with enough
projectives, a perfect object of the bounded derived category is represented by a bounded complex
of projective objects. -/
theorem exists_bounded_projective_of_perfect [EnoughProjectives C] {X : DerivedCategory.Bounded C}
    (hX : TauCeti.DerivedCategory.Bounded.perfect C X) :
    ∃ (K : CochainComplex C ℤ) (a b : ℤ), K.IsStrictlyGE a ∧ K.IsStrictlyLE b ∧
      (∀ n, Projective (K.X n)) ∧ Nonempty (Q.obj K ≅ DerivedCategory.Bounded.ι.obj X) := by
  obtain ⟨n₀, hn₀⟩ := exists_homSingle_eq_zero_of_perfect hX
  obtain ⟨K, a, d, _, _, hK, ⟨e⟩⟩ := exists_projective_isGE_isStrictlyLE_of_bounded X
  have := CochainComplex.isKProjective_of_projective K d
  -- Truncate `K` in a degree `m` below which `K` is exact and `X` has no maps to `C[1 - m]`.
  let m := min (min a (n₀ + 1)) d
  have : K.IsGE m := K.isGE_of_ge m a (by lia)
  -- The projection of `K` to its opcycles in degree `m - 1` is null-homotopic.
  let f := K.toSingleOpcycles (m - 1)
  have hf : Q.map f = 0 := by
    have := hn₀ (m - 1) (by lia) (K.opcycles (m - 1))
      (e.inv ≫ Q.map f ≫ (singleFunctorIsoCompQ C (m - 1)).inv.app _)
    simpa using this
  have hf' : (HomotopyCategory.quotient C (.up ℤ)).map f = 0 := by
    apply (CochainComplex.IsKProjective.Qh_map_bijective K _).1
    rw [Functor.map_zero, ← cancel_mono ((quotientCompQhIso C).hom.app _),
      quotientCompQhIso_hom_naturality, hf, comp_zero, zero_comp]
  have : Projective (K.opcycles m) :=
    (K.retractOpcyclesOfHomotopy (by lia) (HomotopyCategory.homotopyOfEq f 0
      (by rw [hf', Functor.map_zero]))).projective
  obtain ⟨L, a', b', _, _, hL, ⟨e'⟩⟩ :=
    exists_bounded_projective_of_projective_opcycles (m := m) (b := d) (by lia) hK
  exact ⟨L, a', b', ‹_›, ‹_›, hL, ⟨e' ≪≫ e⟩⟩

/-- **Bounded complexes of projectives in finite global dimension**: in an abelian category with
enough projectives in which every object has projective dimension `< d`, every object of the
bounded derived category is represented by a bounded complex of projective objects. -/
theorem exists_bounded_projective_of_hasProjectiveDimensionLT [EnoughProjectives C] (d : ℕ)
    (hd : ∀ Y : C, HasProjectiveDimensionLT Y d) (X : DerivedCategory.Bounded C) :
    ∃ (K : CochainComplex C ℤ) (a b : ℤ), K.IsStrictlyGE a ∧ K.IsStrictlyLE b ∧
      (∀ n, Projective (K.X n)) ∧ Nonempty (Q.obj K ≅ DerivedCategory.Bounded.ι.obj X) := by
  obtain ⟨K, a, b, _, _, hK, ⟨e⟩⟩ := exists_projective_isGE_isStrictlyLE_of_bounded X
  -- Truncate `K` in a degree `m` such that `K` is exact in degrees `m, …, m + d + 1`.
  let m := min (a - d - 2) b
  have : K.IsGE m := K.isGE_of_ge m a (by lia)
  -- Along the exact range of projectives `K^(m+1) ⟶ ⋯ ⟶ K^(m+d)`, the cycles `Z^(m+1)` are a
  -- `d`-th syzygy of `Z^(m+1+d)`, which has projective dimension `< d`, so they are projective.
  have := hd (K.cycles (m + 1 + d))
  have : Projective (K.cycles (m + 1)) := projective_iff_hasProjectiveDimensionLT_one.mpr
    (CochainComplex.hasProjectiveDimensionLT_cycles_of_add (m + 1) d (fun _ _ ↦ hK _)
      (fun _ _ ↦ K.exactAt_of_isGE a _ (by lia)) 0
      (hasProjectiveDimensionLT_of_ge _ d (0 + 1 + d) (by lia)))
  -- Since `K` is exact in degrees `m` and `m + 1`, the opcycles in degree `m` are these cycles.
  have := K.isIso_opcyclesToCycles (i := m) (j := m + 1) rfl (K.exactAt_of_isGE a m (by lia))
    (K.exactAt_of_isGE a (m + 1) (by lia))
  have : Projective (K.opcycles m) :=
    Projective.of_iso (asIso (K.opcyclesToCycles m (m + 1))).symm inferInstance
  obtain ⟨L, a', b', _, _, hL, ⟨e'⟩⟩ := exists_bounded_projective_of_projective_opcycles
    (by lia : m ≤ b) hK
  exact ⟨L, a', b', ‹_›, ‹_›, hL, ⟨e' ≪≫ e⟩⟩

end DerivedCategory

namespace DerivedCategory.Bounded

variable {C : Type u} [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

open TauCeti.DerivedCategory.Bounded in
/-- **Perfect objects are the bounded complexes of projectives**: in an abelian category with
enough projectives, an object of the bounded derived category is perfect if and only if it is the
image of a bounded complex of projective objects. -/
theorem perfect_iff [EnoughProjectives C] (X : DerivedCategory.Bounded C) :
    TauCeti.DerivedCategory.Bounded.perfect C X ↔
      ∃ K : CochainComplex.Bounded C, (∀ n, Projective (K.obj.X n)) ∧
        Nonempty ((TauCeti.DerivedCategory.Bounded.Qh C).obj
          ((TauCeti.HomotopyCategory.Bounded.quotient C).obj K) ≅ X) :=
  ⟨fun hX ↦ (exists_bounded_projective_iff_exists_projective_Qh_obj_iso X).1
      (exists_bounded_projective_of_perfect hX),
    fun ⟨K, hK, ⟨e⟩⟩ ↦ (perfect C).prop_of_iso e (perfect_Qh_obj_quotient_obj C K hK)⟩

/-- **Bounded complexes of projectives in finite global dimension**: in an abelian category with
enough projectives in which every object has projective dimension `< d`, every object of the
bounded derived category is the image of a bounded complex of projective objects. -/
theorem exists_projective_Qh_obj_iso_of_hasProjectiveDimensionLT [EnoughProjectives C] (d : ℕ)
    (hd : ∀ Y : C, HasProjectiveDimensionLT Y d) (X : DerivedCategory.Bounded C) :
    ∃ K : CochainComplex.Bounded C, (∀ n, Projective (K.obj.X n)) ∧
      Nonempty ((TauCeti.DerivedCategory.Bounded.Qh C).obj
        ((TauCeti.HomotopyCategory.Bounded.quotient C).obj K) ≅ X) :=
  (exists_bounded_projective_iff_exists_projective_Qh_obj_iso X).1
    (exists_bounded_projective_of_hasProjectiveDimensionLT d hd X)

end DerivedCategory.Bounded
