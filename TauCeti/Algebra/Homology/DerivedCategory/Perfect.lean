module

public import TauCeti.Algebra.Homology.CochainComplex.Opcycles
public import TauCeti.Algebra.Homology.DerivedCategory.ProjectiveResolution
public import TauCeti.Algebra.Homology.DerivedCategory.Singularity
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.EnoughProjectives

/-!
# Perfect objects are bounded complexes of projectives

Let `C` be an abelian category with enough projectives. An object of the bounded derived category
is perfect, that is, lies in the thick subcategory generated by the projective objects in degree
zero, if and only if it is represented by a bounded complex of projective objects.

One direction is `TauCeti.DerivedCategory.Bounded.perfect_Qh_obj_quotient_obj`. For the other,
a perfect object `X` has no morphisms to `W[-n]` for `W` in `C` and `n` small enough, since the
projective objects in degree zero have this property and it is inherited by the thick subcategory
they generate. Represent `X` by a bounded above complex `K` of projectives, and let `m` be so small
that `K` is exact below `m` and `X` has no morphisms to objects of `C` placed in degree `m - 1`.
The canonical truncation `K.truncGE m` is quasi-isomorphic to `K`, its terms are those of `K` above
`m`, and its term in degree `m` is `K.opcycles m`, the cokernel of `d : K^{m-1} ⟶ K^m`. The chain
map `K ⟶ (K.opcycles (m - 1))[1 - m]` given by the projection is zero in the derived category,
hence null-homotopic since `K` is K-projective, and the null-homotopy splits off `K.opcycles m`
as a retract of `K^m` (`CochainComplex.retractOpcyclesOfHomotopy`). So `K.truncGE m` is a bounded
complex of projective objects.

## Main results

* `DerivedCategory.exists_homSingle_eq_zero_of_perfect`: a perfect object has no morphisms to
  objects of `C` placed in sufficiently negative degrees.
* `DerivedCategory.exists_bounded_projective_of_perfect`: a perfect object is represented by a
  bounded complex of projective objects.
* `DerivedCategory.Bounded.perfect_iff`: an object of the bounded derived category is
  perfect if and only if it is the image of a bounded complex of projective objects.
-/

public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated ZeroObject

universe w v u

namespace DerivedCategory

variable {C : Type u} [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

variable (C) in
/-- The objects `X` of the derived category with no nonzero morphisms to `W[-n]` for `W` in `C`
and `n` small enough. -/
private def homSingleVanishing : ObjectProperty (DerivedCategory C) :=
  fun X ↦ ∃ n₀ : ℤ, ∀ n ≤ n₀, ∀ (W : C) (f : X ⟶ (singleFunctor C n).obj W), f = 0

private instance : (homSingleVanishing C).IsClosedUnderIsomorphisms where
  of_iso e := fun ⟨n₀, h⟩ ↦ ⟨n₀, fun n hn W f ↦ (cancel_epi e.hom).1 (by
    rw [h n hn W (e.hom ≫ f), comp_zero])⟩

private instance : (homSingleVanishing C).IsStableUnderRetracts where
  of_retract r := fun ⟨n₀, h⟩ ↦ ⟨n₀, fun n hn W f ↦ by
    rw [← Category.id_comp f, ← r.retract, Category.assoc, h n hn W (r.r ≫ f), comp_zero]⟩

private instance : (homSingleVanishing C).ContainsZero where
  exists_zero := ⟨0, isZero_zero _, 0, fun _ _ _ _ ↦ (isZero_zero _).eq_of_src _ _⟩

private instance : (homSingleVanishing C).IsStableUnderShift ℤ where
  isStableUnderShiftBy a := ⟨fun X ⟨n₀, h⟩ ↦ ⟨n₀ - a, fun n hn W f ↦ by
    -- Transport `f : X⟦a⟧ ⟶ W[-n]` to `X ⟶ W[-(n + a)]`.
    apply (shiftFunctor (DerivedCategory C) (-a)).map_injective
    have := h (n + a) (by lia) W ((shiftFunctorCompIsoId _ a (-a) (by lia)).inv.app X ≫
      (shiftFunctor _ (-a)).map f ≫ ((singleFunctors C).shiftIso (-a) (n + a) n (by lia)).hom.app W)
    rw [← cancel_epi ((shiftFunctorCompIsoId _ a (-a) (by lia)).inv.app X),
      ← cancel_mono (((singleFunctors C).shiftIso (-a) (n + a) n (by lia)).hom.app W),
      Functor.map_zero, comp_zero, zero_comp]
    simpa using this⟩⟩

private instance : (homSingleVanishing C).IsTriangulatedClosed₂ :=
  .mk' fun T hT ⟨n₁, h₁⟩ ⟨n₃, h₃⟩ ↦ ⟨min n₁ n₃, fun n hn W f ↦ by
    obtain ⟨g, rfl⟩ := Triangle.yoneda_exact₂ T hT f (h₁ n (by lia) W _)
    rw [h₃ n (by lia) W g, comp_zero]⟩

private instance : (homSingleVanishing C).IsTriangulated where

/-- The projective objects in degree zero have no nonzero morphisms to objects placed in negative
degrees. -/
private lemma homSingleVanishing_singleFunctor_obj {P : C} [Projective P] :
    homSingleVanishing C ((singleFunctor C 0).obj P) := by
  refine ⟨-1, fun n hn W f ↦ ?_⟩
  have := from_singleFunctor_obj_eq_zero_of_projective
    ((singleFunctorIsoCompQ C 0).inv.app P ≫ f ≫ (singleFunctorIsoCompQ C n).hom.app W) n
    (by lia)
  simpa using this

/-- **Perfect objects have bounded morphisms to objects of `C`**: a perfect object of the bounded
derived category has no nonzero morphisms to `W[-n]` for `W` in `C` and `n` small enough. -/
theorem exists_homSingle_eq_zero_of_perfect {X : DerivedCategory.Bounded C}
    (hX : TauCeti.DerivedCategory.Bounded.perfect C X) :
    ∃ n₀ : ℤ, ∀ n ≤ n₀, ∀ (W : C) (f : DerivedCategory.Bounded.ι.obj X ⟶ (singleFunctor C n).obj W),
      f = 0 := by
  have : (homSingleVanishing C).inverseImage DerivedCategory.Bounded.ι |>.IsStableUnderRetracts :=
    ⟨fun r h ↦ (homSingleVanishing C).prop_of_retract (r.map DerivedCategory.Bounded.ι) h⟩
  have hle : TauCeti.DerivedCategory.Bounded.perfect C ≤
      (homSingleVanishing C).inverseImage DerivedCategory.Bounded.ι := by
    rw [TauCeti.DerivedCategory.Bounded.perfect_eq, ObjectProperty.triangEnvelope_le_iff]
    intro Y hY
    obtain ⟨P, hP, ⟨e⟩⟩ := (TauCeti.DerivedCategory.Bounded.projectiveSingle_iff C Y).1 hY
    exact (homSingleVanishing C).prop_of_iso (DerivedCategory.Bounded.ι.mapIso e).symm
      homSingleVanishing_singleFunctor_obj
  exact hle _ hX

/-- **Perfect objects are bounded complexes of projectives**: in an abelian category with enough
projectives, a perfect object of the bounded derived category is represented by a bounded complex
of projective objects. -/
theorem exists_bounded_projective_of_perfect [EnoughProjectives C] {X : DerivedCategory.Bounded C}
    (hX : TauCeti.DerivedCategory.Bounded.perfect C X) :
    ∃ (K : CochainComplex C ℤ) (a b : ℤ), K.IsStrictlyGE a ∧ K.IsStrictlyLE b ∧
      (∀ n, Projective (K.X n)) ∧ Nonempty (Q.obj K ≅ DerivedCategory.Bounded.ι.obj X) := by
  obtain ⟨n₀, hn₀⟩ := exists_homSingle_eq_zero_of_perfect hX
  obtain ⟨K, d, _, hK, ⟨e⟩⟩ :=
    (boundedAboveProjective_iff _).1 (boundedAboveProjective_of_bounded X)
  obtain ⟨a, ha⟩ := X.property.1
  have : TStructure.t.IsGE (DerivedCategory.Bounded.ι.obj X) a := ha
  have : K.IsGE a := (isGE_Q_obj_iff K a).1 (TStructure.t.isGE_of_iso e.symm a)
  have := CochainComplex.isKProjective_of_projective K d
  -- Truncate `K` in a degree `m` below which `K` is exact and `X` has no maps to `C[1 - m]`.
  let m := min (min a (n₀ + 1)) d
  have : K.IsGE m := K.isGE_of_ge m a (by lia)
  have : QuasiIso (K.πTruncGE m) := (K.quasiIso_πTruncGE_iff m).2 inferInstance
  -- The projection of `K` to its opcycles in degree `m - 1` is null-homotopic.
  let f := K.toSingleOpcycles (m - 1)
  have hf : Q.map f = 0 := by
    have := hn₀ (m - 1) (by lia) (K.opcycles (m - 1))
      (e.inv ≫ Q.map f ≫ (singleFunctorIsoCompQ C (m - 1)).inv.app _)
    simpa using this
  have hf' : (HomotopyCategory.quotient C (.up ℤ)).map f = 0 := by
    apply (CochainComplex.IsKProjective.Qh_map_bijective K _).1
    rw [Functor.map_zero, ← cancel_mono ((quotientCompQhIso C).hom.app _),
      quotientCompQhIso_hom_naturality, hf, comp_zero, zero_comp]
  have : Projective (K.opcycles m) :=
    (K.retractOpcyclesOfHomotopy (by lia) (HomotopyCategory.homotopyOfEq f 0
      (by rw [hf', Functor.map_zero]))).projective
  refine ⟨K.truncGE m, m, d, inferInstance, ?_, fun i ↦ ?_,
    ⟨(asIso (Q.map (K.πTruncGE m))).symm ≪≫ e⟩⟩
  · rw [CochainComplex.isStrictlyLE_iff]
    intro i hi
    exact (K.isZero_of_isStrictlyLE d i hi).of_iso (K.truncGEXIso m i (by lia))
  · obtain hi | rfl | hi := lt_trichotomy i m
    · exact Projective.of_iso ((K.truncGE m).isZero_of_isStrictlyGE m i hi).isoZero.symm
        inferInstance
    · exact Projective.of_iso (K.truncGEXIsoOpcycles m).symm inferInstance
    · exact Projective.of_iso (K.truncGEXIso m i hi).symm inferInstance

end DerivedCategory

namespace DerivedCategory.Bounded

variable {C : Type u} [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

open TauCeti.DerivedCategory.Bounded in
/-- **Perfect objects are the bounded complexes of projectives**: in an abelian category with
enough projectives, an object of the bounded derived category is perfect if and only if it is the
image of a bounded complex of projective objects. -/
theorem perfect_iff [EnoughProjectives C] (X : DerivedCategory.Bounded C) :
    TauCeti.DerivedCategory.Bounded.perfect C X ↔
      ∃ K : CochainComplex.Bounded C, (∀ n, Projective (K.obj.X n)) ∧
        Nonempty ((TauCeti.DerivedCategory.Bounded.Qh C).obj
          ((TauCeti.HomotopyCategory.Bounded.quotient C).obj K) ≅ X) := by
  refine ⟨fun hX ↦ ?_, fun ⟨K, hK, ⟨e⟩⟩ ↦ (perfect C).prop_of_iso e
    (perfect_Qh_obj_quotient_obj C K hK)⟩
  obtain ⟨K, a, b, _, _, hK, ⟨e⟩⟩ := exists_bounded_projective_of_perfect hX
  let K' : CochainComplex.Bounded C :=
    ⟨K, (CochainComplex.bounded_iff _ _).2 ⟨a, b, ‹_›, ‹_›⟩⟩
  exact ⟨K', hK, ⟨ι.preimageIso
    ((QhCompιIsoιCompQh C).app _ ≪≫ DerivedCategory.Qh.mapIso (eqToIso
      (TauCeti.HomotopyCategory.Bounded.quotient_obj_obj C K')) ≪≫
      (quotientCompQhIso C).app K ≪≫ e)⟩⟩

end DerivedCategory.Bounded
