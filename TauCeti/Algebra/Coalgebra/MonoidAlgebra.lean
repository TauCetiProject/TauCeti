module

public import Mathlib.RingTheory.Coalgebra.MonoidAlgebra
public import Mathlib.RingTheory.TensorProduct.MonoidAlgebra

/-!
# Comultiplication of monoid algebras in tensor-product coordinates

Under the linear equivalence `MonoidAlgebra.tensorEquiv` identifying `R[H] ⊗[R] R[H]` with
`R[H × H]`, the comultiplication of a monoid algebra pushes every index forward along the
diagonal map `g ↦ (g, g)`. Consequently, the `(g, h)`-coefficient of `Coalgebra.comul x`
vanishes off the diagonal and equals `x.coeff g` on the diagonal. No multiplication or unit
on the index type `H` is needed.

## Main declarations

* `MonoidAlgebra.tensorEquiv_comul`: `MonoidAlgebra.tensorEquiv` sends `Coalgebra.comul x` to
  `MonoidAlgebra.mapDomain (fun g ↦ (g, g)) x`.
* `MonoidAlgebra.tensorEquiv_comul_apply`: diagonal formula for the `(g, h)`-coefficient of
  `MonoidAlgebra.tensorEquiv R (Coalgebra.comul x)`.
* `AddMonoidAlgebra.tensorEquiv_comul` and `AddMonoidAlgebra.tensorEquiv_comul_apply`: the
  additive counterparts generated by `to_additive`.
-/

public section

universe u v

namespace MonoidAlgebra

variable {R : Type u} [CommSemiring R] {H : Type v}

/-- Under `MonoidAlgebra.tensorEquiv`, comultiplication maps indices along the diagonal. -/
@[to_additive (dont_translate := R) (attr := simp)
/-- Under `AddMonoidAlgebra.tensorEquiv`, comultiplication maps indices along the diagonal. -/]
theorem tensorEquiv_comul (x : MonoidAlgebra R H) :
    tensorEquiv R (Coalgebra.comul x) = mapDomain (fun g ↦ (g, g)) x := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => simp [hx, hy, mapDomain_add]
  | single k r => simp

/-- In product-index coordinates, the `(g, h)`-coefficient of `Coalgebra.comul x` is `x.coeff g`
on the diagonal and `0` off the diagonal. -/
@[to_additive (dont_translate := R)
/-- In product-index coordinates, the `(g, h)`-coefficient of `Coalgebra.comul x` is `x.coeff g`
on the diagonal and `0` off the diagonal. -/]
theorem tensorEquiv_comul_apply [DecidableEq H] (x : MonoidAlgebra R H) (g h : H) :
    (tensorEquiv R (Coalgebra.comul x)).coeff (g, h) =
      if g = h then x.coeff g else 0 := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy =>
      by_cases hgh : g = h <;> simp_all
  | single k r =>
      by_cases hgh : g = h <;> simp_all [Finsupp.single_apply]

end MonoidAlgebra
