module

public import TauCeti.Algebra.Lie.HighestWeight.Weyl.Dimension
public import TauCeti.LinearAlgebra.RootSystem.Weyl.WeylVectorMultiple

/-!
# Modules whose highest weight is a multiple of the Weyl vector

Let `L` be a finite-dimensional Lie algebra with non-degenerate Killing form over an algebraically
closed field of characteristic zero, `H` a Cartan subalgebra and `b` a base of its root system,
with Weyl vector `ρ`. For a finite-dimensional module `M` generated by a highest weight vector of
weight `k ρ`, the Weyl character formula divides out in closed form:

`ch M = e^{k ρ} ∏_{α>0} (1 + e^{-α} + ⋯ + e^{-k α})`, and `dim M = (k + 1) ^ |Φ⁺|`.

At the even multiples `n · 2ρ` the root strings are centred, `ch M = ∏_{α>0} ∑_{j=-n}^{n} e^{j α}`;
these modules, of dimension `(2 n + 1) ^ |Φ⁺|`, are the ones whose weight multiplicities
equidistribute modulo finite quotients of the root lattice.

The closed form is `TauCeti.eq_single_nsmul_weylVector_mul_prod_of_mul_weylDenominator_eq` for
the root system of `H`, which needs the denominator identity `Δ = N(0)`. Over the unordered field
`K` that identity is not available from the root-pairing theory; it is the character formula of
the trivial module `L(0)`, `TauCeti.weylDenominator_rootSystem_eq_weylNumerator_zero`.

## Main results

* `TauCeti.formalCharacter_eq_single_nsmul_weylVector_mul_prod`:
  `ch M = e^{k ρ} ∏_{α>0} ∑_{j=0}^{k} e^{-j α}` at highest weight `k ρ`.
* `TauCeti.formalCharacter_eq_prod_sum_Icc`: `ch M = ∏_{α>0} ∑_{j=-n}^{n} e^{j α}` at highest
  weight `n · 2ρ`.
* `TauCeti.finrank_eq_pow_card_posRootsFinset`: `dim M = (k + 1) ^ |Φ⁺|` at highest weight `k ρ`.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §24.3.
* C. Fu, *Stability of elliptic Fargues–Scholze L-packets*, arXiv:2501.00652, Lemma 3.1.2.
-/

public section

namespace TauCeti

open AddMonoidAlgebra Finset LieAlgebra LieModule Module

universe u v w

variable {K : Type u} {L : Type v} [Field K] [CharZero K] [IsAlgClosed K]
  [LieRing L] [LieAlgebra K L] [IsKilling K L] [FiniteDimensional K L]
  {H : LieSubalgebra K L} [H.IsCartanSubalgebra]

variable {M : Type w} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  [FiniteDimensional K M] {b : (IsKilling.rootSystem H).Base} {v : M}

section HighestWeightModule

/-- **The character at a multiple of the Weyl vector.** A finite-dimensional module generated by a
highest weight vector of weight `k ρ` has character

`ch M = e^{k ρ} ∏_{α>0} (1 + e^{-α} + ⋯ + e^{-k α})`. -/
theorem formalCharacter_eq_single_nsmul_weylVector_mul_prod {k : ℕ}
    (hv : IsHighestWeightVector b (k • weylVector (IsKilling.rootSystem H) b) v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) :
    formalCharacter K H M = single (k • weylVector (IsKilling.rootSystem H) b) 1 *
      ∏ i ∈ posRootsFinset (IsKilling.rootSystem H) b,
        ∑ j ∈ range (k + 1), single (-(j • (IsKilling.rootSystem H).root i)) 1 := by
  have _ := RootPairing.finite_weylGroup (IsKilling.rootSystem H)
  let _ := Fintype.ofFinite (IsKilling.rootSystem H).weylGroup
  exact eq_single_nsmul_weylVector_mul_prod_of_mul_weylDenominator_eq
    (weylDenominator_rootSystem_eq_weylNumerator_zero b)
    (formalCharacter_mul_weylDenominator_eq_weylNumerator hv hgen)

/-- **The character at an even multiple of the Weyl vector is a product of centred root
strings.** A finite-dimensional module generated by a highest weight vector of weight `n · 2ρ`
has character

`ch M = ∏_{α>0} ∑_{j=-n}^{n} e^{j α}`. -/
theorem formalCharacter_eq_prod_sum_Icc {n : ℕ}
    (hv : IsHighestWeightVector b (n • twoWeylVector (IsKilling.rootSystem H) b) v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) :
    formalCharacter K H M = ∏ i ∈ posRootsFinset (IsKilling.rootSystem H) b,
      ∑ j ∈ Icc (-(n : ℤ)) n, single (j • (IsKilling.rootSystem H).root i) 1 := by
  have _ := RootPairing.finite_weylGroup (IsKilling.rootSystem H)
  let _ := Fintype.ofFinite (IsKilling.rootSystem H).weylGroup
  exact eq_prod_sum_Icc_of_mul_weylDenominator_eq
    (weylDenominator_rootSystem_eq_weylNumerator_zero b)
    (formalCharacter_mul_weylDenominator_eq_weylNumerator hv hgen)

/-- **The dimension at a multiple of the Weyl vector.** A finite-dimensional module generated by a
highest weight vector of weight `k ρ` has dimension `(k + 1) ^ |Φ⁺|`, one factor `k + 1` for the
root string of each positive root. -/
theorem finrank_eq_pow_card_posRootsFinset {k : ℕ}
    (hv : IsHighestWeightVector b (k • weylVector (IsKilling.rootSystem H) b) v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) :
    finrank K M = (k + 1) ^ (posRootsFinset (IsKilling.rootSystem H) b).card := by
  -- The augmentation `e^χ ↦ 1` sends the character to the dimension and each string to `k + 1`.
  let ε := AddMonoidAlgebra.lift ℤ ℤ (Dual K H) 1
  have hε (f : AddMonoidAlgebra ℤ (Dual K H)) : ε f = f.coeff.sum fun _ n ↦ n := by
    simp [ε, AddMonoidAlgebra.lift_apply]
  have h := congrArg ε (formalCharacter_eq_single_nsmul_weylVector_mul_prod hv hgen)
  rw [hε, sum_formalCharacter_coeff_eq_finrank] at h
  simp only [map_mul, map_prod, map_sum, ε, AddMonoidAlgebra.lift_single, one_smul,
    MonoidHom.one_apply, sum_const, card_range, nsmul_eq_mul, mul_one, prod_const, one_mul] at h
  exact_mod_cast h

end HighestWeightModule

end TauCeti
