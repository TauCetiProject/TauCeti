module

public import TauCeti.Algebra.Lie.HighestWeight.Basis
public import TauCeti.Algebra.Lie.HighestWeight.FiniteDimensional
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.HighestWeight
public import Mathlib.Algebra.Module.Lattice
import TauCeti.Algebra.Lie.UniversalEnveloping.Module

/-!
# Integral lattices in rational highest-weight modules

For a rational split semisimple Lie algebra with a `LieAlgebra.Basis`, the integral form of
`L(λ)` is the orbit of its distinguished highest vector under the simple-generator Kostant
form. At every dominant integral weight this is a full finite free integral lattice, with a
finite basis of integral weight vectors. Thus the rational highest-weight construction provides
integral matrix data, without an algebraically closed coefficient field or an assumed lattice.

* `LieAlgebra.Basis.highestWeightLattice` is the specified integral orbit in the existing
  irreducible quotient of the Verma module.
* `LieAlgebra.Basis.isLattice_highestWeightLattice` proves fullness and finite generation.
* `LieAlgebra.Basis.exists_weightBasis_highestWeightLattice` supplies a numbered integral
  weight basis.

Only the simple-generator Kostant form is used here. Identification with the form generated by
all root vectors and by a larger cocharacter lattice is not asserted.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 2, Corollary 1 to Theorem 2.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §§21 and 27.1.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace LieAlgebra.Basis

open TauCeti TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {ι L : Type*} [Fintype ι] [LieRing L] [LieAlgebra ℚ L]
  [LieAlgebra.IsKilling ℚ L] [FiniteDimensional ℚ L]
  {H : LieSubalgebra ℚ L} [hH : H.IsCartanSubalgebra] [LieModule.IsTriangularizable ℚ H L]
  (b : LieAlgebra.Basis ι H) (lam : Module.Dual ℚ H)

/-- The integral orbit of the distinguished highest vector of `L(λ)` under the
simple-generator Kostant form. It is a full lattice when `λ` is dominant integral. -/
def highestWeightLattice : Submodule ℤ (irreducibleQuotient b.base lam) :=
  Subring.orbitOfRep b.kostantForm
    (representation ℚ L (irreducibleQuotient b.base lam))
    {irreducibleQuotientGenerator b.base lam}

omit hH

/-- The integral form is the Kostant orbit of the distinguished highest vector. -/
theorem highestWeightLattice_def :
    b.highestWeightLattice lam = Subring.orbitOfRep b.kostantForm
      (representation ℚ L (irreducibleQuotient b.base lam))
      {irreducibleQuotientGenerator b.base lam} :=
  (rfl)

/-- The distinguished highest vector belongs to its integral form. -/
@[simp]
theorem irreducibleQuotientGenerator_mem_highestWeightLattice :
    irreducibleQuotientGenerator b.base lam ∈ b.highestWeightLattice lam :=
  Subring.subset_orbitOfRep _ _ _ (Set.mem_singleton _)

/-- The integral highest-weight form is stable under its defining Kostant form. -/
theorem representation_mem_highestWeightLattice
    {u : _root_.UniversalEnvelopingAlgebra ℚ L} (hu : u ∈ b.kostantForm)
    {x : irreducibleQuotient b.base lam} (hx : x ∈ b.highestWeightLattice lam) :
    representation ℚ L (irreducibleQuotient b.base lam) u x ∈ b.highestWeightLattice lam :=
  Subring.apply_mem_orbitOfRep_of_mem _ _ _ hu hx

/-- The integral form spans the rational highest-weight module, since the Kostant form spans
its enveloping algebra and the distinguished highest vector is cyclic. -/
theorem span_highestWeightLattice_eq_top :
    Submodule.span ℚ (b.highestWeightLattice lam : Set (irreducibleQuotient b.base lam)) = ⊤ := by
  let _ := b.isCartanSubalgebra
  rw [highestWeightLattice_def,
    Subring.span_orbitOfRep_eq_span _ _ _ b.span_kostantForm_eq_top]
  refine top_unique fun x _ => ?_
  obtain ⟨u, hu⟩ := exists_representation_apply_eq_of_lieSpan_eq_top
    (lieSpan_irreducibleQuotientGenerator_eq_top b.base lam) x
  exact Submodule.subset_span ⟨u, _, Set.mem_singleton _, hu⟩

include hH in
/-- At an integral highest weight, the canonical vector has integral Cartan coordinates. -/
private theorem exists_isCartanWeightVector_generator
    (hlam : IsIntegralWeight lam) :
    ∃ wt : ι → ℤ, IsCartanWeightVector b.h
      (representation ℚ L (irreducibleQuotient b.base lam)) wt
      (irreducibleQuotientGenerator b.base lam) := by
  let _ := b.isCartanSubalgebra
  have hint (i : ι) : ∃ n : ℤ, lam (b.h' i) = n := by
    simpa only [b.coroot_eq_h'] using
      hlam.exists_int_apply_coroot (b.baseSupportEquiv i : LieModule.Weight ℚ H L)
  choose n hn using hint
  refine ⟨n, (isCartanWeightVector_iff _ _).2 fun i => ?_⟩
  rw [representation_ι_apply]
  have h := (isHighestWeightVector_irreducibleQuotientGenerator b.base lam).lie_eq_smul
    (b.h' i)
  rw [hn] at h
  simpa only [← b.cartanBasis_apply, b.coe_cartanBasis] using h

/-- Every raising generator kills the distinguished highest vector. -/
private theorem representation_e_generator (i : ι) :
    representation ℚ L (irreducibleQuotient b.base lam)
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i))
      (irreducibleQuotientGenerator b.base lam) = 0 := by
  let _ := b.isCartanSubalgebra
  rw [representation_ι_apply]
  exact (b.isHighestWeightVector_iff_forall_e.mp
    (isHighestWeightVector_irreducibleQuotientGenerator b.base lam)).2.2 i

include hH in
/-- At an integral highest weight, the integral form is spanned by the lowering words applied to
its distinguished highest vector. -/
theorem highestWeightLattice_eq_span_loweringWord
    (hlam : IsIntegralWeight lam) :
    b.highestWeightLattice lam = Submodule.span ℤ (Set.range fun l =>
      representation ℚ L (irreducibleQuotient b.base lam) (b.loweringWord l)
        (irreducibleQuotientGenerator b.base lam)) := by
  obtain ⟨wt, hwt⟩ := b.exists_isCartanWeightVector_generator lam hlam
  rw [highestWeightLattice_def]
  exact b.orbitOfRep_kostantForm_singleton_eq_span_loweringWord _ hwt
    (b.representation_e_generator lam)

/-- At a dominant integral weight, the integral orbit is a full lattice: it is finitely
generated over `ℤ` and spans `L(λ)` over `ℚ`. -/
theorem isLattice_highestWeightLattice (hlam : IsDominantIntegral b.base lam) :
    Submodule.IsLattice ℚ (b.highestWeightLattice lam) := by
  let _ := b.isCartanSubalgebra
  let := finiteDimensional_irreducibleQuotient_of_isDominantIntegral hlam
  obtain ⟨wt, hwt⟩ := b.exists_isCartanWeightVector_generator lam hlam.isIntegralWeight
  exact ⟨b.fg_orbitOfRep_kostantForm_singleton _ hwt (b.representation_e_generator lam),
    b.span_highestWeightLattice_eq_top lam⟩

include hH in
/-- At an integral highest weight, the integral form lies in the span of the integral joint
weight spaces. -/
theorem mem_iSup_jointWeightSpace_of_mem_highestWeightLattice
    (hlam : IsIntegralWeight lam) {x : irreducibleQuotient b.base lam}
    (hx : x ∈ b.highestWeightLattice lam) :
    x ∈ ⨆ wt : ι → ℤ,
      jointWeightSpace b.h (representation ℚ L (irreducibleQuotient b.base lam)) wt := by
  obtain ⟨wt, hwt⟩ := b.exists_isCartanWeightVector_generator lam hlam
  exact b.mem_iSup_jointWeightSpace_of_mem_orbitOfRep_kostantForm_singleton _ hwt
    (b.representation_e_generator lam) hx

/-- Every dominant integral rational highest-weight module has a finite integral weight basis
of its specified highest-weight lattice. -/
theorem exists_weightBasis_highestWeightLattice (hlam : IsDominantIntegral b.base lam) :
    ∃ (n : ℕ) (B : Module.Basis (Fin n) ℤ (b.highestWeightLattice lam))
      (wt : Fin n → ι → ℤ),
      ∀ i, IsCartanWeightVector b.h
        (representation ℚ L (irreducibleQuotient b.base lam)) (wt i)
        ((B i : b.highestWeightLattice lam) : irreducibleQuotient b.base lam) := by
  let _ := b.isCartanSubalgebra
  let := b.isLattice_highestWeightLattice lam hlam
  let M := (b.highestWeightLattice lam).toAddSubgroup
  let _ : Module.Finite ℤ M := inferInstanceAs (Module.Finite ℤ (b.highestWeightLattice lam))
  have hM : ∀ u ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm (rootGenerator b) b.h, ∀ v ∈ M,
      representation ℚ L (irreducibleQuotient b.base lam) u v ∈ M := by
    intro u hu v hv
    exact b.representation_mem_highestWeightLattice lam (by rwa [← kostantForm_def] at hu) hv
  have hV : ∀ x : M, (x : irreducibleQuotient b.base lam) ∈
      ⨆ wt : ι → ℤ,
        jointWeightSpace b.h (representation ℚ L (irreducibleQuotient b.base lam)) wt :=
    fun x => b.mem_iSup_jointWeightSpace_of_mem_highestWeightLattice lam hlam.isIntegralWeight x.2
  exact ⟨_, kostantWeightBasisFin (rootGenerator b) b.h _ M hM hV,
    kostantWeightFin (rootGenerator b) b.h _ M hM hV,
    isCartanWeightVector_kostantWeightBasisFin (rootGenerator b) b.h _ M hM hV⟩

end

end LieAlgebra.Basis
