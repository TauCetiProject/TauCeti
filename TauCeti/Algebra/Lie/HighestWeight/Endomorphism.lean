module

public import TauCeti.Algebra.Lie.HighestWeight.Module
public import TauCeti.Algebra.Lie.UniversalEnveloping.Module
import TauCeti.RingTheory.Semisimple.DoubleCentralizer
import TauCeti.Algebra.Lie.Weights.Eigenvector

/-!
# Endomorphisms of split highest-weight modules

A module generated by a highest-weight vector has only scalar equivariant endomorphisms:
an endomorphism preserves the one-dimensional highest-weight space and is determined on the
generator. This holds over the splitting field itself, without algebraic closedness or finite
dimensionality of the module.

If the module is also irreducible and finite-dimensional, its enveloping representation maps
onto its full linear endomorphism algebra. This is the density input for comparing irreducible
highest-weight modules under extension of their splitting field.

## Main results

* `TauCeti.IsHighestWeightVector.exists_eq_smul_id`: scalar equivariant endomorphisms of a
  cyclic highest-weight module.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §20.3.
* N. Jacobson, *Basic Algebra II*, Chapter 4 (density).

The density step uses `Algebra.lsmul_surjective_of_forall_end_eq_smul`, derived from Mathlib's
`Module.Finite.toModuleEnd_moduleEnd_surjective`.
-/

public section

namespace TauCeti

open LieAlgebra LieModule Module

universe u v w

variable {K : Type u} {L : Type v} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [IsKilling K L] [FiniteDimensional K L]
  {H : LieSubalgebra K L} [H.IsCartanSubalgebra] [IsTriangularizable K H L]
  {M : Type w} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  {b : (IsKilling.rootSystem H).Base} {lam : Dual K H} {v : M}

/-- Every equivariant endomorphism of a module generated by a highest-weight vector is scalar.
The module need not be irreducible or finite-dimensional, and the field need not be
algebraically closed. -/
theorem IsHighestWeightVector.exists_eq_smul_id (hv : IsHighestWeightVector b lam v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) (f : M →ₗ⁅K,L⁆ M) :
    ∃ c : K, f = c • (LieModuleHom.id : M →ₗ⁅K,L⁆ M) := by
  have hmem : f v ∈ (genWeightSpace M (lam : H → K) : Submodule K M) :=
    mem_genWeightSpace_of_forall_lie_eq_smul fun x => by
      rw [← f.map_lie, hv.lie_eq_smul, map_smul]
  rw [genWeightSpace_eq_span_singleton_of_isHighestWeightVector_of_lieSpan_eq_top hv hgen]
    at hmem
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
  refine ⟨c, ?_⟩
  have heq : (f : M →ₗ[K] M) = c • LinearMap.id :=
    LinearMap.ext_on_of_lieSpan_eq_top hgen id f.map_lie
      (fun x m => by simp [lie_smul]) (by simpa using hc.symm)
  exact LieModuleHom.ext fun m => LinearMap.congr_fun heq m

end TauCeti
