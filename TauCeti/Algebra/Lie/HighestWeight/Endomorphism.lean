/-!
# Endomorphisms of split highest-weight modules

A module generated by a highest-weight vector has only scalar equivariant endomorphisms:
an endomorphism preserves the one-dimensional highest-weight space and is determined on the
generator. So its endomorphism space is a line. This holds over the splitting field itself,
without algebraic closedness or finite dimensionality of the module.

For irreducible highest-weight modules this replaces Schur's lemma, which in its dimension form
(`TauCeti.LieModule.finrank_lieModuleHom_self`) needs an algebraically closed field. Two such
modules are equivalent exactly when their highest weights agree
(`TauCeti.nonempty_lieModuleEquiv_iff_eq_of_isHighestWeightVector`), so the isotypic multiplicity
of one in the other, the dimension of the space of morphisms between them, is `1` when the
weights agree and `0` otherwise.

## Main results

* `TauCeti.IsHighestWeightVector.exists_eq_smul_id`: scalar equivariant endomorphisms of a
  cyclic highest-weight module.
* `TauCeti.IsHighestWeightVector.finrank_lieModuleHom_self`: the endomorphism space of a cyclic
  highest-weight module is a line.
* `TauCeti.isotypicMultiplicity_of_isHighestWeightVector`: the multiplicity of one irreducible
  highest-weight module in another, and
  `TauCeti.isotypicMultiplicity_irreducibleQuotient_of_isHighestWeightVector` its form for the
  irreducible quotient `L(λ)`.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §20.3.
-/

public section

namespace TauCeti

-- `TauCeti.LieModule` exists in the imports, so the root namespace is named explicitly.
open LieAlgebra _root_.LieModule Module

universe u v w w₁

variable {K : Type u} {L : Type v} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [IsKilling K L] [FiniteDimensional K L]
  {H : LieSubalgebra K L} [H.IsCartanSubalgebra] [IsTriangularizable K H L]
  {M : Type w} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  {N : Type w₁} [AddCommGroup N] [Module K N] [LieRingModule L N] [LieModule K L N]
  {b : (IsKilling.rootSystem H).Base} {lam mu : Dual K H} {v : M} {w : N}

/-- Every equivariant endomorphism of a module generated by a highest-weight vector is scalar.
The module need not be irreducible or finite-dimensional, and the field need not be
algebraically closed. -/
theorem IsHighestWeightVector.exists_eq_smul_id (hv : IsHighestWeightVector b lam v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) (f : M →ₗ⁅K,L⁆ M) :
    ∃ c : K, f = c • (LieModuleHom.id : M →ₗ⁅K,L⁆ M) := by
  have hmem : f v ∈ (genWeightSpace M (lam : H → K) : Submodule K M) :=
    mem_genWeightSpace_of_forall_lie_eq_smul fun x => by
      rw [← f.map_lie, hv.lie_eq_smul, map_smul]
  rw [genWeightSpace_eq_span_singleton_of_isHighestWeightVector_of_lieSpan_eq_top hv hgen]
    at hmem
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
  refine ⟨c, ?_⟩
  have heq : (f : M →ₗ[K] M) = c • LinearMap.id :=
    LinearMap.ext_on_of_lieSpan_eq_top hgen id f.map_lie
      (fun x m => by simp [lie_smul]) (by simpa using hc.symm)
  exact LieModuleHom.ext fun m => LinearMap.congr_fun heq m

/-- **The endomorphism space of a module generated by a highest-weight vector is a line**,
spanned by the identity. The module need not be irreducible or finite-dimensional, and the field
need not be algebraically closed. -/
theorem IsHighestWeightVector.finrank_lieModuleHom_self (hv : IsHighestWeightVector b lam v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) : finrank K (M →ₗ⁅K,L⁆ M) = 1 := by
  refine (finrank_eq_one_iff_of_ne_zero' (LieModuleHom.id : M →ₗ⁅K,L⁆ M) fun h ↦ ?_).2
    fun f ↦ ?_
  · exact hv.ne_zero (by simpa using LieModuleHom.congr_fun h v)
  · obtain ⟨c, hc⟩ := hv.exists_eq_smul_id hgen f
    exact ⟨c, hc.symm⟩

open scoped Classical in
/-- **The multiplicity of one irreducible highest-weight module in another.** If `M` and `N` are
irreducible and carry highest-weight vectors of weights `mu` and `lam`, then `N` occurs in `M`
with multiplicity `1` if `lam = mu` and `0` otherwise. Neither module need be finite-dimensional,
and the field need not be algebraically closed. -/
theorem isotypicMultiplicity_of_isHighestWeightVector [LieModule.IsIrreducible K L M]
    [LieModule.IsIrreducible K L N] (hv : IsHighestWeightVector b mu v)
    (hw : IsHighestWeightVector b lam w) :
    LieModule.isotypicMultiplicity K L M N = if lam = mu then 1 else 0 := by
  split_ifs with h
  · subst h
    obtain ⟨e⟩ := nonempty_lieModuleEquiv_of_isHighestWeightVector hw hv
    rw [LieModule.isotypicMultiplicity_eq_of_lieModuleEquiv_type e,
      LieModule.isotypicMultiplicity_def]
    exact hv.finrank_lieModuleHom_self (lieSpan_singleton_eq_top_of_ne_zero hv.ne_zero)
  · rw [LieModule.isotypicMultiplicity_def]
    exact LieModule.finrank_lieModuleHom_eq_zero_of_isEmpty_lieModuleEquiv
      (not_nonempty_iff.mp fun he ↦
        h ((nonempty_lieModuleEquiv_iff_eq_of_isHighestWeightVector hw hv).mp he))

open scoped Classical in
/-- **`L(lam)` occurs in an irreducible highest-weight module of weight `mu` exactly when
`lam = mu`, and then once.** -/
theorem isotypicMultiplicity_irreducibleQuotient_of_isHighestWeightVector
    [LieModule.IsIrreducible K L M] (hv : IsHighestWeightVector b mu v) (lam : Dual K H) :
    LieModule.isotypicMultiplicity K L M (irreducibleQuotient b lam) =
      if lam = mu then 1 else 0 :=
  isotypicMultiplicity_of_isHighestWeightVector hv
    (isHighestWeightVector_irreducibleQuotientGenerator b lam)

end TauCeti
