module

public import TauCeti.Algebra.Lie.HighestWeight.Character
public import TauCeti.Algebra.Lie.HighestWeight.Verma
public import TauCeti.LinearAlgebra.RootSystem.Weyl.WeightOrbitSum

/-!
# The orbit-sum expansion of the character of a highest weight module

Let `L` be a finite-dimensional Lie algebra with non-degenerate Killing form over an algebraically
closed field of characteristic zero, let `H` be a Cartan subalgebra and `b` a base of its root
system. For a finite-dimensional module `M` generated by a highest weight vector of weight `lam`
(for instance the irreducible module `L(lam)` of a dominant integral weight), the formal character
of `M` expands in the Weyl orbit sums `m_mu = ∑_{nu ∈ W mu} e^nu` as

`ch M = m_lam + ∑_{mu < lam} c_mu m_mu`,

the sum running over the dominant integral weights `mu ≠ lam` with `lam - mu` in the positive root
cone, of which there are finitely many. The coefficient `c_mu` is the multiplicity of `mu` in `M`,
a natural number (`TauCeti.formalCharacter_coeff_nonneg`), and the leading coefficient is `1`. So
the characters of the irreducible modules are unitriangular against the orbit sums with respect to
the dominance order, which is what a downward induction on the dominant weights needs in order to
pass between combinations of characters and combinations of orbit sums.

The expansion uses neither the Weyl character formula nor the Harish-Chandra theory. It is the
orbit-sum expansion `TauCeti.IsWeylInvariant.eq_sum_coeff_smul_weightOrbitSum` of an arbitrary
Weyl-invariant element of the integral group algebra, fed with three facts about the character of
`M`: it is Weyl-invariant (`TauCeti.isWeylInvariant_formalCharacter`), supported in `lam - Q⁺` on
integral weights, and its coefficient at `lam` is `1`, the top weight space being a line.

## Main results

* `TauCeti.mem_dominantWeightsBelow_iff_isDominantIntegral`: the dominant integral weights below
  `lam`, in the Lie-theoretic language of `TauCeti.IsDominantIntegral`.
* `TauCeti.formalCharacter_eq_orbitSum_add_lower`: **the orbit-sum expansion of the character of a
  highest weight module**, `ch M = m_lam + ∑_{mu < lam} c_mu m_mu`.
* `TauCeti.formalCharacter_irreducibleQuotient_eq_orbitSum_add_lower`: the same expansion for
  `L(lam)`.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §22.5 and §23.1.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 7-9*, Ch. VIII, §7.
-/

public section

namespace TauCeti

open LieAlgebra LieModule Module

universe u v w

variable {K : Type u} {L : Type v} [Field K] [CharZero K]
  [LieRing L] [LieAlgebra K L] [IsKilling K L] [FiniteDimensional K L]
  {H : LieSubalgebra K L} [H.IsCartanSubalgebra] [IsTriangularizable K H L]
  {b : (IsKilling.rootSystem H).Base}

/-- The dominant integral weights below `lam` are the dominant integral weights `mu`, in the sense
of `TauCeti.IsDominantIntegral`, with `lam - mu` in the positive root cone. -/
theorem mem_dominantWeightsBelow_iff_isDominantIntegral {lam mu : Dual K H} :
    mu ∈ dominantWeightsBelow (IsKilling.rootSystem H) b lam ↔
      lam - mu ∈ posRootCone (IsKilling.rootSystem H) b ∧ IsDominantIntegral b mu := by
  simp only [mem_dominantWeightsBelow, rootSystem_coroot'_apply, isDominantIntegral_iff]

variable [IsAlgClosed K]
  {M : Type w} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  [FiniteDimensional K M] [Finite (IsKilling.rootSystem H).weylGroup] {lam : Dual K H} {v : M}

-- `Finset.erase` asks for decidable equality of weights, which only classical logic supplies.
open scoped Classical in
/-- **The orbit-sum expansion of the character of a highest weight module.** Let `M` be a
finite-dimensional module generated by a highest weight vector of weight `lam`. Then

`ch M = m_lam + ∑_{mu} c_mu m_mu`,

the sum running over the dominant integral weights `mu ≠ lam` below `lam`, where `m_mu` is the
Weyl orbit sum of `mu` and `c_mu` is the multiplicity of the weight `mu` in `M`, a natural number by
`TauCeti.formalCharacter_coeff_nonneg`.

Such an `M` is irreducible, by `TauCeti.isIrreducible_of_isHighestWeightVector_of_lieSpan_eq_top`,
so this is the expansion of the character of `L(lam)`; it is stated for `M` itself so that no
identification with `L(lam)` is needed to use it. -/
theorem formalCharacter_eq_orbitSum_add_lower (hv : IsHighestWeightVector b lam v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) :
    formalCharacter K H M = weightOrbitSum (IsKilling.rootSystem H) lam +
      ∑ mu ∈ (dominantWeightsBelow (IsKilling.rootSystem H) b lam).erase lam,
        (formalCharacter K H M).coeff mu • weightOrbitSum (IsKilling.rootSystem H) mu := by
  have hlam : lam ∈ dominantWeightsBelow (IsKilling.rootSystem H) b lam :=
    mem_dominantWeightsBelow_iff_isDominantIntegral.mpr ⟨by simp, hv.isDominantIntegral⟩
  have hint : ∀ chi : Dual K H, (formalCharacter K H M).coeff chi ≠ 0 →
      ∀ i ∈ b.support, ∃ z : ℤ, (IsKilling.rootSystem H).coroot' i chi = (z : K) :=
    fun chi hchi i _ ↦ by
      obtain ⟨z, hz⟩ :=
        (isIntegralWeight_of_formalCharacter_coeff_ne_zero hchi).exists_int_apply_coroot
          (i : Weight K H L)
      exact ⟨z, by rw [rootSystem_coroot'_apply, IsKilling.rootSystem_coroot_apply, hz]⟩
  conv_lhs => rw [isWeylInvariant_formalCharacter.eq_sum_coeff_smul_weightOrbitSum
    (fun _ ↦ sub_mem_posRootCone_of_formalCharacter_coeff_ne_zero hv hgen) hint]
  rw [← Finset.add_sum_erase _ _ hlam,
    formalCharacter_coeff_eq_one_of_isHighestWeightVector_of_lieSpan_eq_top hv hgen, one_smul]

open scoped Classical in
/-- **The orbit-sum expansion of the character of `L(lam)`**:
`ch L(lam) = m_lam + ∑_{mu} c_mu m_mu`, the sum running over the dominant integral weights
`mu ≠ lam` below `lam`, with `c_mu` the multiplicity of `mu` in `L(lam)`. The module `L(lam)` is
finite-dimensional exactly when `lam` is dominant integral
(`TauCeti.finiteDimensional_irreducibleQuotient_of_isDominantIntegral`). -/
theorem formalCharacter_irreducibleQuotient_eq_orbitSum_add_lower
    [FiniteDimensional K (irreducibleQuotient b lam)] :
    formalCharacter K H (irreducibleQuotient b lam) = weightOrbitSum (IsKilling.rootSystem H) lam +
      ∑ mu ∈ (dominantWeightsBelow (IsKilling.rootSystem H) b lam).erase lam,
        (formalCharacter K H (irreducibleQuotient b lam)).coeff mu •
          weightOrbitSum (IsKilling.rootSystem H) mu :=
  formalCharacter_eq_orbitSum_add_lower (isHighestWeightVector_irreducibleQuotientGenerator b lam)
    (lieSpan_irreducibleQuotientGenerator_eq_top b lam)

end TauCeti
