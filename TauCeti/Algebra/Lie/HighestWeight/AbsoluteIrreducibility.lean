module

public import TauCeti.Algebra.Lie.HighestWeight.Module
public import TauCeti.Algebra.Lie.UniversalEnveloping.Density
public import TauCeti.Algebra.Lie.BaseChange.Irreducible
import TauCeti.Algebra.Lie.Weights.Eigenvector

/-!
# Scalar endomorphisms and absolute irreducibility of highest weight modules

An endomorphism of a cyclic highest weight module preserves its highest weight line and is
therefore a scalar on the whole module. Neither irreducibility nor finite dimensionality is
required for this assertion, and the field need not be algebraically closed. In particular it
applies to rational split highest weight modules. For a finite-dimensional irreducible module,
Jacobson density then identifies the image of the enveloping algebra with all linear operators,
and the module remains irreducible after every field extension.

The highest weight line is the one constructed in
`TauCeti.genWeightSpace_eq_span_singleton_of_isHighestWeightVector_of_lieSpan_eq_top`.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §20.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, Part II, §1.
-/

public section

namespace TauCeti

open LieAlgebra LieModule Module
open scoped TensorProduct

variable {K L M : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [IsKilling K L] [FiniteDimensional K L]
  {H : LieSubalgebra K L} [H.IsCartanSubalgebra] [IsTriangularizable K H L]
  [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  {b : (IsKilling.rootSystem H).Base} {lam : Dual K H} {v : M}

/-- Every endomorphism of a module generated by a highest weight vector is a unique scalar
multiple of the identity, over the original split field. -/
theorem IsHighestWeightVector.existsUnique_endomorphism_eq_smul
    (hv : IsHighestWeightVector b lam v) (hgen : LieSubmodule.lieSpan K L {v} = ⊤)
    (f : M →ₗ⁅K,L⁆ M) : ∃! c : K, f = c • LieModuleHom.id := by
  have hmem : f v ∈ (genWeightSpace M (lam : H → K) : Submodule K M) :=
    mem_genWeightSpace_of_forall_lie_eq_smul fun x => by
      rw [← f.map_lie, hv.lie_eq_smul, map_smul]
  rw [genWeightSpace_eq_span_singleton_of_isHighestWeightVector_of_lieSpan_eq_top hv hgen,
    Submodule.mem_span_singleton] at hmem
  obtain ⟨c, hc⟩ := hmem
  have hf : f = c • LieModuleHom.id := by
    have hlin := LinearMap.ext_on_of_lieSpan_eq_top hgen id
      f.map_lie (c • LieModuleHom.id : M →ₗ⁅K,L⁆ M).map_lie (by simpa using hc.symm)
    exact LieModuleHom.ext (fun m => LinearMap.congr_fun hlin m)
  refine ⟨c, hf, fun d hd => ?_⟩
  exact smul_left_injective K hv.ne_zero
    ((congrArg (fun g : M →ₗ⁅K,L⁆ M => g v) hd).symm.trans hc.symm)

/-- On a finite-dimensional irreducible highest weight module over a split field, the
universal enveloping algebra realizes every linear operator. -/
theorem IsHighestWeightVector.representation_surjective [FiniteDimensional K M]
    [LieModule.IsIrreducible K L M] (hv : IsHighestWeightVector b lam v) :
    Function.Surjective (UniversalEnvelopingAlgebra.representation K L M) :=
  UniversalEnvelopingAlgebra.representation_surjective_of_endomorphisms_eq_smul fun f =>
    (hv.existsUnique_endomorphism_eq_smul
      (lieSpan_singleton_eq_top_of_ne_zero hv.ne_zero) f).exists

/-- A finite-dimensional irreducible highest weight module over a split field remains
irreducible after every field extension. -/
theorem IsHighestWeightVector.isIrreducible_baseChange [FiniteDimensional K M]
    [LieModule.IsIrreducible K L M] (hv : IsHighestWeightVector b lam v)
    (A : Type*) [Field A] [Algebra K A] :
    LieModule.IsIrreducible A (A ⊗[K] L) (A ⊗[K] M) := by
  have : Nontrivial M := LieModule.nontrivial_of_isIrreducible K L M
  exact UniversalEnvelopingAlgebra.isIrreducible_baseChange_of_representation_surjective
    hv.representation_surjective A

end TauCeti
