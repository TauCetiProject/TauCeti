import TauCeti.Algebra.MvPolynomial.Eval
import TauCeti.LinearAlgebra.SymmetricAlgebra.Semilinear

/-!
# Basic invariants of a Lie algebra with nondegenerate Killing form

Let `L` be a finite-dimensional Lie algebra over an algebraically closed field `K` of
characteristic zero whose Killing form is nondegenerate, and `H` a Cartan subalgebra, with root
system `R = LieAlgebra.IsKilling.rootSystem H` and Weyl group `W`. **Chevalley's theorem** says that
the invariant polynomials form a polynomial algebra: there are homogeneous invariants
`f₁, …, f_r` of positive degree, `r = rank L`, such that `K[X₁, …, X_r] → S(L)^L`, `Xᵢ ↦ fᵢ`, is an
isomorphism (`TauCeti.exists_bijective_aeval_lieInvariants`). The same holds for the invariant
polynomial functions `S(L*)^L` on `L` (`TauCeti.exists_bijective_aeval_lieInvariants_dual`), the
form in which the generators cut out the nilpotent cone.

The proof combines Chevalley's restriction theorem with Chevalley's theorem for the Weyl group.

* Restriction to `H` is a degree-preserving isomorphism `S(L)^L ≃ S(H)^W`
  (`LieSubalgebra.lieChevalleyRestrictionIso`,
  `LieSubalgebra.lieChevalleyRestrictionIso_mem_homogeneousSubmodule_iff`). So a system of basic
  invariants of `W` acting on `H` gives one of `L`, with the same degrees
  (`LieSubalgebra.exists_bijective_aeval_lieInvariants_of_linearInvariants`).
* `S(H)^W` is the invariant algebra of the Weyl group acting on `H`, the coroot space of `R`
  (`TauCeti.linearInvariants_eq_symmetricAlgebraInvariants`), which the root pairing identifies with
  the Weyl invariant polynomials on the weight space
  (`RootPairing.weylGroupCorootRepInvariantsEquiv`). These form a polynomial algebra on `dim H`
  generators (`RootPairing.exists_bijective_aeval_weylGroupCorootRep_of_base`).

So every system of basic invariants of the Weyl invariants `Sym(M*)^W` of `R` gives a system of
basic invariants of `S(L)^L` with exactly the same degrees
(`LieSubalgebra.exists_bijective_aeval_lieInvariants_of_weylGroupRootRep_dual`), and any degree
identity proved for a system of basic invariants of a root system holds for the system of `L` built
from it.

## Main results

* `LieSubalgebra.exists_bijective_aeval_lieInvariants_of_linearInvariants`: basic invariants of the
  Weyl group acting on `H` give basic invariants of `L` of the same degrees.
* `LieSubalgebra.exists_bijective_aeval_lieInvariants_of_weylGroupCorootRep`: basic invariants of
  the coroot representation of the root system of `H` give basic invariants of `L` of the same
  degrees.
* `LieSubalgebra.exists_bijective_aeval_lieInvariants_of_weylGroupRootRep_dual`: basic invariants
  of the root system give basic invariants of `L` of the same degrees.
* `TauCeti.exists_bijective_aeval_lieInvariants`: **Chevalley's theorem**, `S(L)^L` is a polynomial
  algebra on `rank L` homogeneous invariants of positive degree.
* `TauCeti.exists_bijective_aeval_lieInvariants_dual`: the same for the invariant polynomial
  functions `S(L*)^L`.

## References

* C. Chevalley, *Invariants of finite groups generated by reflections*, Amer. J. Math. **77**
  (1955), 778–782.
* J. Dixmier, *Enveloping Algebras*, §7.3.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 7–9*, Ch. VIII, §8, no. 3.
-/

public section

open LieAlgebra LieAlgebra.IsKilling Module TauCeti TauCeti.SymmetricAlgebra

variable {K L : Type*} [Field K] [CharZero K] [IsAlgClosed K] [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [IsKilling K L]

namespace LieSubalgebra

variable (H : LieSubalgebra K L) [H.IsCartanSubalgebra]

/-- **A system of basic invariants of the Weyl group acting on `H` gives one of `L`.** If
homogeneous Weyl invariants `f k ∈ S(H)^W` of degrees `d k` are polynomial generators of `S(H)^W`,
then their preimages under Chevalley's restriction isomorphism are homogeneous invariants of `L`
of the same degrees and polynomial generators of `S(L)^L`. -/
theorem exists_bijective_aeval_lieInvariants_of_linearInvariants {κ : Type*}
    {f : κ → linearInvariants H} {d : κ → ℕ}
    (hf : ∀ k, (f k : _root_.SymmetricAlgebra K H) ∈ homogeneousSubmodule K H (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∃ g : κ → lieInvariants K L L,
      (∀ k, (g k : _root_.SymmetricAlgebra K L) ∈ homogeneousSubmodule K L (d k)) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) g) := by
  refine ⟨(lieChevalleyRestrictionIso H).symm ∘ f, fun k ↦ ?_,
    (MvPolynomial.bijective_aeval_algEquiv_comp_iff _).mpr hbij⟩
  rw [Function.comp_apply, ← lieChevalleyRestrictionIso_mem_homogeneousSubmodule_iff H,
    AlgEquiv.apply_symm_apply]
  exact hf k

/-- **A system of basic invariants of the coroot representation gives one of `L`.** If
homogeneous invariants `f k` of degrees `d k` of the Weyl group acting on `H`, the coroot space of
the root system of `H`, are polynomial generators of these invariants, then the corresponding
homogeneous invariants of `L` of the same degrees are polynomial generators of `S(L)^L`. -/
theorem exists_bijective_aeval_lieInvariants_of_weylGroupCorootRep {κ : Type*}
    {f : κ → (rootSystem H).weylGroupCorootRep.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ k, (f k : _root_.SymmetricAlgebra K H) ∈ homogeneousSubmodule K H (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∃ g : κ → lieInvariants K L L,
      (∀ k, (g k : _root_.SymmetricAlgebra K L) ∈ homogeneousSubmodule K L (d k)) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) g) := by
  -- `S(H)^W` is the invariant algebra of the coroot representation.
  let e := Subalgebra.equivOfEq _ _ (linearInvariants_eq_symmetricAlgebraInvariants (H := H)).symm
  exact H.exists_bijective_aeval_lieInvariants_of_linearInvariants (f := e ∘ f) hf
    ((MvPolynomial.bijective_aeval_algEquiv_comp_iff e).mpr hbij)

/-- **A system of basic invariants of the root system gives one of `L` with the same degrees.**
Every system of basic invariants of the Weyl invariant polynomials `Sym(M*)^W` on the weight space
`M = H*` of the root system of `H` gives a system of basic invariants of `S(L)^L` with the same
degrees. -/
theorem exists_bijective_aeval_lieInvariants_of_weylGroupRootRep_dual {κ : Type*}
    {f : κ → (rootSystem H).weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ k, (f k : _root_.SymmetricAlgebra K (Dual K (Dual K H))) ∈
      homogeneousSubmodule K (Dual K (Dual K H)) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∃ g : κ → lieInvariants K L L,
      (∀ k, (g k : _root_.SymmetricAlgebra K L) ∈ homogeneousSubmodule K L (d k)) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) g) := by
  obtain ⟨g, hg, hgbij⟩ :=
    (rootSystem H).exists_bijective_aeval_weylGroupCorootRep_of_weylGroupRootRep_dual hf hbij
  exact H.exists_bijective_aeval_lieInvariants_of_weylGroupCorootRep hg hgbij

end LieSubalgebra

namespace TauCeti

variable (K L)

/-- **Chevalley's theorem: the invariants of `L` form a polynomial algebra.** For a
finite-dimensional Lie algebra `L` with nondegenerate Killing form over an algebraically closed
field of characteristic zero, there are `rank L` homogeneous invariants of positive degree in
`S(L)^L` that are polynomial generators of `S(L)^L`. -/
theorem exists_bijective_aeval_lieInvariants :
    ∃ f : Fin (LieAlgebra.rank K L) → lieInvariants K L L,
      (∀ i, ∃ d, 0 < d ∧ (f i : _root_.SymmetricAlgebra K L) ∈ homogeneousSubmodule K L d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  obtain ⟨H, _, ⟨b⟩⟩ := exists_isCartanSubalgebra_base K L
  rw [H.rank_eq_finrank_cartan]
  obtain ⟨f, hf, hbij⟩ := (rootSystem H).exists_bijective_aeval_weylGroupCorootRep_of_base b
  choose d hd hfd using hf
  obtain ⟨g, hg, hgbij⟩ := H.exists_bijective_aeval_lieInvariants_of_weylGroupCorootRep hfd hbij
  exact ⟨g, fun i ↦ ⟨d i, hd i, hg i⟩, hgbij⟩

/-- **Chevalley's theorem for the invariant polynomial functions on `L`.** For a
finite-dimensional Lie algebra `L` with nondegenerate Killing form over an algebraically closed
field of characteristic zero, there are `rank L` homogeneous invariant polynomial functions of
positive degree in `S(L*)^L` that are polynomial generators of `S(L*)^L`. -/
theorem exists_bijective_aeval_lieInvariants_dual :
    ∃ f : Fin (LieAlgebra.rank K L) → lieInvariants K L (Dual K L),
      (∀ i, ∃ d, 0 < d ∧
        (f i : _root_.SymmetricAlgebra K (Dual K L)) ∈ homogeneousSubmodule K (Dual K L) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  obtain ⟨f, hf, hbij⟩ := exists_bijective_aeval_lieInvariants K L
  -- The Killing identification `S(L) ≃ S(L*)` carries `S(L)^L` onto `S(L*)^L`, preserving degrees.
  let e := ((killingSymmetricEquiv K L).subalgebraMap (lieInvariants K L L)).trans
    (Subalgebra.equivOfEq _ _ (map_killingSymmetricEquiv_lieInvariants K L))
  refine ⟨e ∘ f, fun i ↦ ?_, (MvPolynomial.bijective_aeval_algEquiv_comp_iff e).mpr hbij⟩
  obtain ⟨d, hd, hfd⟩ := hf i
  refine ⟨d, hd, ?_⟩
  simp only [e, Function.comp_apply, AlgEquiv.trans_apply, Subalgebra.equivOfEq_apply,
    AlgEquiv.subalgebraMap_apply_coe, killingSymmetricEquiv_apply]
  exact map_mem_homogeneousSubmodule _ hfd

end TauCeti
