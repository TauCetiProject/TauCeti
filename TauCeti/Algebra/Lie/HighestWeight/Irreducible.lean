/-!
# Irreducible highest weight modules are classified by their weight

An **irreducible highest weight module of weight `lam`** is an irreducible `L`-module carrying a
highest weight vector of weight `lam`; it is automatically generated by that vector, an irreducible
module being generated by any of its nonzero elements
(`TauCeti.lieSpan_singleton_eq_top_of_ne_zero`). This file proves that such a module is
determined by `lam` up to isomorphism, and determines `lam` in turn:

`TauCeti.nonempty_lieModuleEquiv_iff_eq_of_isHighestWeightVector`, two irreducible modules carrying
highest weight vectors of weights `lam` and `mu` are isomorphic if and only if `lam = mu`.

Neither module is assumed finite-dimensional, so this is the classification of *all* irreducible
highest weight modules, and it is what makes the irreducible quotient `L(lam)` of a highest weight
module well defined: any two constructions of it agree.

## The argument

Uniqueness of the weight is a transport: an isomorphism carries a highest weight vector to a
highest weight vector of the same weight
(`TauCeti.IsHighestWeightVector.congr`), and a module is a highest weight module for at most one
weight (`TauCeti.eq_of_isHighestWeightVector_of_lieSpan_eq_top`).

Uniqueness of the module is the classical diagonal argument, and it is the reason this file needs
the product of two Lie modules of `TauCeti/Algebra/Lie/Prod.lean`. Given highest weight vectors
`v : M` and `w : N` of the *same* weight `lam`, the vector `(v, w)` is a highest weight vector of
`M × N`, and the submodule `D` it generates is the graph of the isomorphism sought. Two facts
identify it as such.

* `D` is a *proper* submodule of `M × N`. Were it everything, `M × N` would be a highest weight
  module of weight `lam`, so its `lam`-weight space would be the line `K ∙ (v, w)`
  (`TauCeti.genWeightSpace_eq_span_singleton_of_isHighestWeightVector_of_lieSpan_eq_top`); but
  `(v, 0)` is another highest weight vector of weight `lam`, and it is not a multiple of `(v, w)`.
* Consequently `D` meets neither factor. If it met `N`, then by irreducibility it would contain
  `(0, w)`, hence also `(v, w) - (0, w) = (v, 0)`, hence — again by irreducibility — both factors
  whole, so `D = ⊤`; the same argument runs with the factors exchanged.

The two projections restricted to `D` are therefore injective, and they are surjective because
their images are nonzero submodules of irreducible modules. So `M ≃ D ≃ N`.

## Main results

* `TauCeti.lieModuleEquivOfIsHighestWeightVector`: the equivalence between two irreducible modules
  of the same highest weight, chosen to carry one specified highest weight vector to the other.
* `TauCeti.nonempty_lieModuleEquiv_of_isHighestWeightVector`: **two irreducible modules carrying
  highest weight vectors of the same weight are isomorphic.**
* `TauCeti.nonempty_lieModuleEquiv_iff_eq_of_isHighestWeightVector`: **and conversely**, so
  isomorphism of irreducible highest weight modules is exactly equality of their weights.
* `TauCeti.IsHighestWeightVector.unique_of_isIrreducible`: an irreducible module carries highest
  weight vectors of at most one weight.
* `TauCeti.twistedEquivOfIsHighestWeightVector`: **the twisted form of the classification.** For a
  surjective endomorphism `φ` of `L`, a vector `w` of an irreducible module `N` on which `φ x`
  acts as `x` acts on a highest weight vector `v : M` gives a linear equivalence `M ≃ N` carrying
  `v` to `w` and the action of `x` to that of `φ x`; it is unique
  (`TauCeti.eq_twistedEquivOfIsHighestWeightVector`).

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §20.3.
-/

public section

namespace TauCeti

open LieAlgebra LieModule Module

universe u v w w₁

/-! ### The diagonal submodule of a product

Everything below compares two modules `M` and `N` through the submodule of `M × N` generated by the
diagonal vector `(v, w)`. -/

section Diagonal

variable {K : Type u} {L : Type v} [CommRing K] [LieRing L]
  {M : Type w} [AddCommGroup M] [Module K M] [LieRingModule L M]
  {N : Type w₁} [AddCommGroup N] [Module K N] [LieRingModule L N]
  {v : M} {w : N}

variable (K L v w) in
/-- The elements of `N` whose image `(0, ·)` lies in the diagonal submodule. -/
private def diagonalComapInr : LieSubmodule K L N :=
  (LieSubmodule.lieSpan K L {((v, w) : M × N)}).comap (LieModuleHom.inr K L M N)

private theorem mem_diagonalComapInr {n : N} :
    n ∈ diagonalComapInr K L v w ↔ ((0, n) : M × N) ∈ LieSubmodule.lieSpan K L {((v, w) : M × N)} :=
  by simp only [diagonalComapInr, LieSubmodule.mem_comap, LieModuleHom.inr_apply]

end Diagonal

/-! ### The twist of a module by a surjective endomorphism

For a surjective Lie algebra endomorphism `φ` of `L`, the *twist* of `N` by `φ` is the same vector
space with `x` acting as `φ x`. It is irreducible when `N` is. It only serves to apply the
classification below to linear maps carrying the action of `x` to that of `φ x`. -/

section Twist

variable {K : Type u} {L : Type v} [CommRing K] [LieRing L] [LieAlgebra K L]
  {N : Type w₁} [AddCommGroup N] [Module K N] [LieRingModule L N]

/-- The twist of `P` by `φ`: `P`, with `x : L` acting as `φ x`. -/
private def Twist (_φ : L →ₗ⁅K⁆ L) (P : Type w₁) : Type w₁ := P

namespace Twist

variable (φ : L →ₗ⁅K⁆ L)

private instance : AddCommGroup (Twist φ N) := inferInstanceAs (AddCommGroup N)

private instance : Module K (Twist φ N) := inferInstanceAs (Module K N)

private instance : LieRingModule L (Twist φ N) := LieRingModule.compLieHom N φ

/-- The identity of `N`, read as a map into the twist. -/
private def equiv : N ≃ₗ[K] Twist φ N := LinearEquiv.refl K N

/-- The defining equation of the twisted action. -/
private theorem lie_equiv (x : L) (n : N) : ⁅x, equiv φ n⁆ = equiv φ ⁅φ x, n⁆ :=
  (rfl)

private instance [LieModule K L N] : LieModule K L (Twist φ N) := LieModule.compLieHom N φ

private theorem isIrreducible (hφ : Function.Surjective φ) [LieModule.IsIrreducible K L N] :
    LieModule.IsIrreducible K L (Twist φ N) := by
  have := LieModule.nontrivial_of_isIrreducible K L N
  have : Nontrivial (Twist φ N) := (equiv φ).injective.nontrivial
  refine LieModule.IsIrreducible.mk fun P hP => ?_
  -- `P` is stable under every `φ x`, hence under all of `L` as `φ` is onto: a Lie submodule of `N`.
  let Q : LieSubmodule K L N :=
    { (P : Submodule K (Twist φ N)).comap (equiv φ).toLinearMap with
      lie_mem := fun {y n} hn => by
        obtain ⟨x, rfl⟩ := hφ y
        simp only [Submodule.mem_carrier, SetLike.mem_coe, Submodule.mem_comap,
          LinearEquiv.coe_coe] at hn ⊢
        rw [← lie_equiv]
        exact P.lie_mem hn }
  have hmem (m : Twist φ N) : m ∈ P ↔ (equiv φ).symm m ∈ Q := by
    simp [Q, ← LieSubmodule.mem_toSubmodule]
  rcases IsSimpleOrder.eq_bot_or_eq_top Q with hQ | hQ
  · refine absurd ((LieSubmodule.eq_bot_iff P).mpr fun m hm => ?_) hP
    rw [hmem, hQ, LieSubmodule.mem_bot] at hm
    simpa using congr(equiv φ $hm)
  · exact eq_top_iff.mpr fun m _ => (hmem m).mpr (hQ ▸ LieSubmodule.mem_top _)

end Twist

end Twist

/-! ### The diagonal highest weight vector -/

variable {K : Type u} {L : Type v} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [IsKilling K L] [FiniteDimensional K L]
  {H : LieSubalgebra K L} [H.IsCartanSubalgebra] [IsTriangularizable K H L]
  {M : Type w} [AddCommGroup M] [Module K M] [LieRingModule L M]
  {N : Type w₁} [AddCommGroup N] [Module K N] [LieRingModule L N]
  {b : (IsKilling.rootSystem H).Base} {lam mu : Dual K H} {v : M} {w : N}

/-- The diagonal of two highest weight vectors of the same weight is a highest weight vector of the
product. -/
private theorem isHighestWeightVector_prod (hv : IsHighestWeightVector b lam v)
    (hw : IsHighestWeightVector b lam w) : IsHighestWeightVector b lam ((v, w) : M × N) :=
  isHighestWeightVector_iff.mpr
    ⟨fun h => hv.ne_zero (Prod.mk_eq_zero.mp h).1, fun x => by
      rw [lie_prod_apply, hv.lie_eq_smul x, hw.lie_eq_smul x, Prod.smul_mk], fun x hx => by
      rw [lie_prod_apply, hv.lie_eq_zero_of_mem_positiveNilradical hx,
        hw.lie_eq_zero_of_mem_positiveNilradical hx, Prod.mk_zero_zero]⟩

/-- A highest weight vector of `M`, pushed into `M × N` along the first inclusion, is again one. -/
private theorem isHighestWeightVector_inl (hv : IsHighestWeightVector b lam v) :
    IsHighestWeightVector b lam ((v, 0) : M × N) :=
  by
    simpa only [LieModuleHom.inl_apply] using
      hv.map (LieModuleHom.inl K L M N) (by simpa using hv.ne_zero)

variable [LieModule K L M] [LieModule K L N]

/-- **The diagonal generates a proper submodule of the product.** If it generated everything, then
`M × N` would be a highest weight module of weight `lam`, whose `lam`-weight space is the line
through `(v, w)`; but `(v, 0)` lies in that weight space and is not a multiple of `(v, w)`. -/
private theorem lieSpan_diagonal_ne_top (hv : IsHighestWeightVector b lam v)
    (hw : IsHighestWeightVector b lam w) :
    LieSubmodule.lieSpan K L {((v, w) : M × N)} ≠ ⊤ := by
  intro htop
  have hline := genWeightSpace_eq_span_singleton_of_isHighestWeightVector_of_lieSpan_eq_top
    (isHighestWeightVector_prod hv hw) htop
  have hmem : ((v, 0) : M × N) ∈
      (genWeightSpace (M × N) ((lam : Dual K H) : H → K) : Submodule K (M × N)) :=
    (isHighestWeightVector_inl hv).mem_genWeightSpace
  rw [hline] at hmem
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
  have hcw : c • w = 0 := by simpa using congrArg Prod.snd hc
  have hc0 : c = 0 := (smul_eq_zero.mp hcw).resolve_right hw.ne_zero
  refine hv.ne_zero ?_
  have hcv : c • v = v := by simpa using congrArg Prod.fst hc
  rw [hc0, zero_smul] at hcv
  exact hcv.symm

/-- **The diagonal submodule meets the second factor trivially.** -/
private theorem diagonalComapInr_eq_bot [LieModule.IsIrreducible K L M]
    [LieModule.IsIrreducible K L N] (hv : IsHighestWeightVector b lam v)
    (hw : IsHighestWeightVector b lam w) : diagonalComapInr K L v w = ⊥ := by
  refine (IsSimpleOrder.eq_bot_or_eq_top _).resolve_right fun hr => ?_
  have hw_mem : ((0, w) : M × N) ∈ LieSubmodule.lieSpan K L {((v, w) : M × N)} :=
    mem_diagonalComapInr.mp (hr ▸ LieSubmodule.mem_top w)
  exact lieSpan_diagonal_ne_top hv hw (eq_top_of_comap_inl_eq_top_of_comap_inr_eq_top
    (comap_lieSpan_diagonal_inl_eq_top_of_mem hv.ne_zero hw_mem) hr)

private theorem bijective_diagonalFst [LieModule.IsIrreducible K L M]
    [LieModule.IsIrreducible K L N] (hv : IsHighestWeightVector b lam v)
    (hw : IsHighestWeightVector b lam w) :
    Function.Bijective (LieSubmodule.lieSpan K L {(v, w)}).prodFst := by
  constructor
  · intro p q hpq
    have hfst : (p : M × N).1 = (q : M × N).1 := by
      simpa using hpq
    have hd : ((p : M × N) - q) ∈ LieSubmodule.lieSpan K L {((v, w) : M × N)} := sub_mem p.2 q.2
    have h1 : ((p : M × N) - q).1 = 0 := sub_eq_zero.mpr hfst
    have hmem : ((p : M × N) - q).2 ∈ diagonalComapInr K L v w := by
      refine mem_diagonalComapInr.mpr ?_
      have hpair : ((0, ((p : M × N) - q).2) : M × N) = (p : M × N) - q :=
        Prod.ext h1.symm rfl
      rwa [hpair]
    rw [diagonalComapInr_eq_bot hv hw] at hmem
    have h2 : ((p : M × N) - q).2 = 0 := by simpa using hmem
    exact Subtype.ext (sub_eq_zero.mp (Prod.ext_iff.mpr ⟨h1, h2⟩))
  · exact (LieSubmodule.lieSpan K L {(v, w)}).prodFst_surjective_of_mem_of_ne_zero
      (LieSubmodule.subset_lieSpan rfl) hv.ne_zero

private theorem bijective_diagonalSnd [LieModule.IsIrreducible K L M]
    [LieModule.IsIrreducible K L N] (hv : IsHighestWeightVector b lam v)
    (hw : IsHighestWeightVector b lam w) :
    Function.Bijective (LieSubmodule.lieSpan K L {(v, w)}).prodSnd := by
  refine ⟨?_, (LieSubmodule.lieSpan K L {(v, w)}).prodSnd_surjective_of_mem_of_ne_zero
    (LieSubmodule.subset_lieSpan rfl) hw.ne_zero⟩
  intro p q hpq
  have hp := prodComm_mem_lieSpan_diagonal p.2
  have hq := prodComm_mem_lieSpan_diagonal q.2
  have hswap : (⟨(p : M × N).swap, hp⟩ : LieSubmodule.lieSpan K L {(w, v)}) =
      ⟨(q : M × N).swap, hq⟩ :=
    (bijective_diagonalFst hw hv).1 (by simpa using hpq)
  exact Subtype.ext (Prod.swap_injective (congrArg Subtype.val hswap))

/-! ### The classification -/

/-- **The equivalence between two irreducible modules of the same highest weight.** It is obtained
by identifying both modules with the diagonal submodule of their product. -/
noncomputable def lieModuleEquivOfIsHighestWeightVector [LieModule.IsIrreducible K L M]
    [LieModule.IsIrreducible K L N] (hv : IsHighestWeightVector b lam v)
    (hw : IsHighestWeightVector b lam w) : M ≃ₗ⁅K,L⁆ N :=
  (LieModuleEquiv.ofBijective _ (bijective_diagonalFst hv hw)).symm.trans
    (LieModuleEquiv.ofBijective _ (bijective_diagonalSnd hv hw))

@[simp]
theorem lieModuleEquivOfIsHighestWeightVector_apply [LieModule.IsIrreducible K L M]
    [LieModule.IsIrreducible K L N] (hv : IsHighestWeightVector b lam v)
    (hw : IsHighestWeightVector b lam w) : lieModuleEquivOfIsHighestWeightVector hv hw v = w := by
  let p : LieSubmodule.lieSpan K L {((v, w) : M × N)} :=
    ⟨(v, w), LieSubmodule.subset_lieSpan rfl⟩
  let eF := LieModuleEquiv.ofBijective _ (bijective_diagonalFst hv hw)
  let eS := LieModuleEquiv.ofBijective _ (bijective_diagonalSnd hv hw)
  have hp : eF p = v := by simp [eF, p]
  have hinv : eF.symm v = p := eF.symm_apply_eq.mpr hp.symm
  have hresult : eS (eF.symm v) = w := by
    rw [hinv]
    simp [eS, p]
  simpa only [lieModuleEquivOfIsHighestWeightVector, LieModuleEquiv.trans_apply, eF, eS]
    using hresult

/-- **Two irreducible Lie modules carrying highest weight vectors of the same weight are
isomorphic.** Both are isomorphic to the submodule of their product generated by the diagonal
vector, which is the graph of the isomorphism between them. -/
theorem nonempty_lieModuleEquiv_of_isHighestWeightVector [LieModule.IsIrreducible K L M]
    [LieModule.IsIrreducible K L N] (hv : IsHighestWeightVector b lam v)
    (hw : IsHighestWeightVector b lam w) : Nonempty (M ≃ₗ⁅K,L⁆ N) :=
  ⟨lieModuleEquivOfIsHighestWeightVector hv hw⟩

/-- **The classification of the irreducible highest weight modules.** Two irreducible modules
carrying highest weight vectors of weights `lam` and `mu` are isomorphic exactly when
`lam = mu`; neither module is assumed finite-dimensional. -/
theorem nonempty_lieModuleEquiv_iff_eq_of_isHighestWeightVector [LieModule.IsIrreducible K L M]
    [LieModule.IsIrreducible K L N] (hv : IsHighestWeightVector b lam v)
    (hw : IsHighestWeightVector b mu w) : Nonempty (M ≃ₗ⁅K,L⁆ N) ↔ lam = mu := by
  refine ⟨fun ⟨e⟩ => ?_, fun h => ?_⟩
  · exact (hv.congr e).unique_of_isIrreducible hw
  · subst h
    exact nonempty_lieModuleEquiv_of_isHighestWeightVector hv hw

/-! ### Twisted equivalences -/

section TwistedEquiv

variable (φ : L →ₗ⁅K⁆ L)

omit [LieModule K L N] in
/-- A nonzero vector of `N` on which `L`, acting through `φ`, acts as on a highest weight vector of
weight `lam` is a highest weight vector of weight `lam` of the twist of `N` by `φ`. -/
private theorem isHighestWeightVector_twist_equiv (hw0 : w ≠ 0)
    (hwH : ∀ x : H, ⁅φ x, w⁆ = lam x • w) (hwn : ∀ x ∈ positiveNilradical H b, ⁅φ x, w⁆ = 0) :
    IsHighestWeightVector b lam (Twist.equiv φ w) :=
  isHighestWeightVector_iff.mpr ⟨(map_ne_zero_iff _ (Twist.equiv φ).injective).mpr hw0,
    fun x => by rw [Twist.lie_equiv, hwH, map_smul],
    fun x hx => by rw [Twist.lie_equiv, hwn x hx, map_zero]⟩

/-- **The twisted equivalence between irreducible highest weight modules.** Let `φ` be a
surjective endomorphism of `L`, let `v : M` be a highest weight vector of weight `lam`, and let
`w : N` be a nonzero vector on which `φ` makes `L` act as on a highest weight vector of weight
`lam`: `φ x` acts on `w` by the scalar `lam x` for `x ∈ H`, and by zero for `x ∈ n⁺`. If `M` and
`N` are irreducible, this is the linear equivalence `M ≃ N` carrying `v` to `w`
(`TauCeti.twistedEquivOfIsHighestWeightVector_apply_self`) and the action of each `x` on `M` to
the action of `φ x` on `N` (`TauCeti.twistedEquivOfIsHighestWeightVector_lie`). It is the unique
such linear map (`TauCeti.eq_twistedEquivOfIsHighestWeightVector`).

For `φ` the identity this is `TauCeti.lieModuleEquivOfIsHighestWeightVector`. -/
noncomputable def twistedEquivOfIsHighestWeightVector (hφ : Function.Surjective φ)
    [LieModule.IsIrreducible K L M] [LieModule.IsIrreducible K L N]
    (hv : IsHighestWeightVector b lam v) (hw0 : w ≠ 0) (hwH : ∀ x : H, ⁅φ x, w⁆ = lam x • w)
    (hwn : ∀ x ∈ positiveNilradical H b, ⁅φ x, w⁆ = 0) : M ≃ₗ[K] N :=
  haveI := Twist.isIrreducible φ hφ (N := N)
  (lieModuleEquivOfIsHighestWeightVector hv
    (isHighestWeightVector_twist_equiv φ hw0 hwH hwn)).toLinearEquiv.trans (Twist.equiv φ).symm

variable {φ} (hφ : Function.Surjective φ) [LieModule.IsIrreducible K L M]
  [LieModule.IsIrreducible K L N] (hv : IsHighestWeightVector b lam v) (hw0 : w ≠ 0)
  (hwH : ∀ x : H, ⁅φ x, w⁆ = lam x • w) (hwn : ∀ x ∈ positiveNilradical H b, ⁅φ x, w⁆ = 0)

/-- The twisted equivalence carries the highest weight vector `v` to `w`. -/
@[simp]
theorem twistedEquivOfIsHighestWeightVector_apply_self :
    twistedEquivOfIsHighestWeightVector φ hφ hv hw0 hwH hwn v = w := by
  have := Twist.isIrreducible φ hφ (N := N)
  rw [twistedEquivOfIsHighestWeightVector, LinearEquiv.trans_apply,
    LieModuleEquiv.coe_toLinearEquiv, lieModuleEquivOfIsHighestWeightVector_apply,
    LinearEquiv.symm_apply_apply]

/-- **The twisted equivalence carries the action of `x` to the action of `φ x`.** -/
theorem twistedEquivOfIsHighestWeightVector_lie (x : L) (m : M) :
    twistedEquivOfIsHighestWeightVector φ hφ hv hw0 hwH hwn ⁅x, m⁆ =
      ⁅φ x, twistedEquivOfIsHighestWeightVector φ hφ hv hw0 hwH hwn m⁆ := by
  rw [twistedEquivOfIsHighestWeightVector, LinearEquiv.trans_apply, LinearEquiv.trans_apply,
    LieModuleEquiv.coe_toLinearEquiv, ← LieModuleEquiv.coe_coe, LieModuleHom.map_lie,
    LinearEquiv.symm_apply_eq, ← Twist.lie_equiv, LinearEquiv.apply_symm_apply]

/-- **Uniqueness of the twisted equivalence**: a linear map `M → N` carrying `v` to `w` and the
action of each `x` to the action of `φ x` is the twisted equivalence. -/
theorem eq_twistedEquivOfIsHighestWeightVector {f : M →ₗ[K] N}
    (hf : ∀ (x : L) (m : M), f ⁅x, m⁆ = ⁅φ x, f m⁆) (hfv : f v = w) :
    f = twistedEquivOfIsHighestWeightVector φ hφ hv hw0 hwH hwn :=
  LinearMap.ext_on_of_lieSpan_eq_top (lieSpan_singleton_eq_top_of_ne_zero hv.ne_zero) φ hf
    (twistedEquivOfIsHighestWeightVector_lie hφ hv hw0 hwH hwn) (by simp [hfv])

end TwistedEquiv

end TauCeti
