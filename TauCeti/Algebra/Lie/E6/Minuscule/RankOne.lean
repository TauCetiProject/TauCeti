module

public import TauCeti.Algebra.Lie.E6.Minuscule.GroupScheme
public import TauCeti.Algebra.Lie.Presentation.MinusculeWeightTable.RankOne.Basic
public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Diagonal.Basic
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.RankOne

/-!
# Rank-one subgroups of the E6 minuscule carrier

Each opposite pair of numbered simple-root subgroups of the twenty-seven-dimensional E6
minuscule carrier generates a faithful copy of `SL₂` over every field. The map `rankOnePoints`
uses the existing minuscule weight-table block action. Its upper and lower transvections have
exactly the carrier's root parameters, and its diagonal is the numbered simple coroot in the
weight torus. `range_rankOnePoints` identifies its image with the subgroup generated by those
two root families; no recognition of the full carrier as a pinned reductive group is asserted.

The block action and its root/coroot comparisons are valid over arbitrary commutative rings.
Only containment in the carrier and the generated-image statement use the field hypothesis,
through generation of `SL₂` by transvections.

The construction follows `TauCeti.Algebra.Lie.E7.Minuscule.RankOne`, using the common
`MinusculeWeightTable.sl2BlockSL` representation rather than constructing another block action.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, Chapter 6.
-/

public section

open scoped Matrix MatrixGroups

namespace TauCeti.E6Minuscule

open TauCeti.DynkinType

noncomputable section

/-- The upper transvection in the block action is the positive simple-root point. -/
@[simp]
theorem sl2BlockSL_upper_transvection {R : Type*} [CommRing R] (i : Fin 6) (t : R) :
    weightTable.sl2BlockSL i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        (rootSubgroupPoints (.inl i) R (Multiplicative.ofAdd t) : GL (Fin 27) R) := by
  apply Units.ext
  rw [weightTable.coe_sl2BlockSL, weightTable.sl2BlockMatrix_upper_transvection,
    coe_rootSubgroupPoints_inl, toAdd_ofAdd]

/-- The lower transvection in the block action is the negative simple-root point. -/
@[simp]
theorem sl2BlockSL_lower_transvection {R : Type*} [CommRing R] (i : Fin 6) (t : R) :
    weightTable.sl2BlockSL i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        (rootSubgroupPoints (.inr i) R (Multiplicative.ofAdd t) : GL (Fin 27) R) := by
  apply Units.ext
  rw [weightTable.coe_sl2BlockSL, weightTable.sl2BlockMatrix_lower_transvection,
    coe_rootSubgroupPoints_inr, toAdd_ofAdd]

/-- The diagonal in the block action is the numbered simple-coroot point. -/
@[simp high] -- Prefer the carrier equation to the generic weight-table diagonal equation.
theorem sl2BlockSL_diag2nUnit {R : Type*} [CommRing R] (i : Fin 6) (u : Rˣ) :
    weightTable.sl2BlockSL i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) =
        (weightTorusPoints R (Pi.mulSingle i u) : GL (Fin 27) R) := by
  apply Units.ext
  rw [weightTable.coe_sl2BlockSL, Matrix.SpecialLinearGroup.diag2nUnit_coe,
    weightTable.sl2BlockMatrix_diagonal, coe_weightTorusPoints,
    UniversalEnvelopingAlgebra.kostantTorusMatrix_apply, diagGL_coe]
  congr 1
  funext a
  rw [torusCharacter_mulSingle]
  rcases weightTable.weight_eq_neg_one_or_eq_zero_or_eq_one a i with h | h | h
  all_goals simp [h]

variable (K : Type*) [Field K] (i : Fin 6)

/-- The faithful rank-one map at the numbered simple node, with the prescribed positive and
negative root parameters. -/
def rankOnePoints : SL(2, K) →* points K :=
  (weightTable.sl2BlockSL i).codRestrict (points K)
    (by
      intro g
      refine (weightTable.sl2BlockSL i).sl2_range_le_of_transvection_mem
        ?_ ?_ ⟨g, rfl⟩
      · intro t
        rw [sl2BlockSL_upper_transvection]
        exact (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t)).property
      · intro t
        rw [sl2BlockSL_lower_transvection]
        exact (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t)).property)

/-- On underlying invertible matrices, the rank-one map is the weight-table block action. -/
@[simp]
theorem coe_rankOnePoints (g : SL(2, K)) :
    (rankOnePoints K i g : GL (Fin 27) K) = weightTable.sl2BlockSL i g := by
  rw [rankOnePoints, MonoidHom.codRestrict_apply]

/-- The numbered rank-one map is injective at every simple node. -/
theorem rankOnePoints_injective : Function.Injective (rankOnePoints K i) := by
  rw [rankOnePoints, MonoidHom.injective_codRestrict]
  exact weightTable.sl2BlockSL_injective i
    (by simpa only [weightTable_weight] using exists_e6MinusculeWeight_apply_eq_neg_one i)

/-- Upper transvections retain their positive-root parameters. -/
@[simp]
theorem rankOnePoints_upper_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, sl2BlockSL_upper_transvection]

/-- Lower transvections retain their negative-root parameters. -/
@[simp]
theorem rankOnePoints_lower_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, sl2BlockSL_lower_transvection]

/-- The rank-one diagonal maps to the numbered simple coroot in the weight torus. -/
@[simp]
theorem rankOnePoints_diag2nUnit (u : Kˣ) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints K (Pi.mulSingle i u) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, sl2BlockSL_diag2nUnit]

/-- The image is exactly the subgroup generated by the two opposite simple-root families. -/
theorem range_rankOnePoints :
    (rankOnePoints K i).range =
      Subgroup.closure (Set.range (rootSubgroupPoints (.inl i) K) ∪
        Set.range (rootSubgroupPoints (.inr i) K)) := by
  rw [(rankOnePoints K i).sl2_range_eq_closure]
  congr 2 <;>
    simpa only [Function.comp_def, rankOnePoints_upper_transvection,
      rankOnePoints_lower_transvection] using
      (Multiplicative.ofAdd : K ≃ Multiplicative K).surjective.range_comp
        (rootSubgroupPoints _ K)

end

end TauCeti.E6Minuscule
