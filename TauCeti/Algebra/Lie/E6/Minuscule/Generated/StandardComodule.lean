module

public import TauCeti.Algebra.Lie.E6.Minuscule.Generated.Basic
public import TauCeti.Algebra.Lie.E6.Minuscule.StandardComodule
import TauCeti.Algebra.Coalgebra.Subcomodule.Corestrict

/-!
# The standard representation of the generated E₆ minuscule subgroup

The subgroup of `GL₂₇` generated over a commutative ring by the numbered minuscule root
subgroups and weight torus has a faithful standard representation. Over a field this representation
is simple: the torus separates its 27 weight lines, and the root points connect them by simple
reflections. This applies to the subgroup generated after specialization, not just to the
specialization of the integral carrier, which may contain it strictly.

Faithfulness and simplicity supply the representation-theoretic input for eliminating normal
smooth unipotent subgroups of this generated group.

## References

* J. C. Jantzen, *Representations of Algebraic Groups*, I.2 and II.2.
* J. E. Humphreys, *Linear Algebraic Groups*, §26.

The construction follows `TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.Generated.StandardComodule`.
The reflection argument is shared with `TauCeti.Algebra.Lie.E6.Minuscule.StandardComodule`.
-/

public section

open CategoryTheory WithConv TauCeti.UniversalEnvelopingAlgebra
open scoped Matrix

namespace TauCeti.E6Minuscule

universe u

variable (R : Type u) [CommRing R]

/-- The standard right comodule of the subgroup generated by the E₆ minuscule roots and torus. -/
@[instance_reducible]
noncomputable def generatedStandardComodule :
    Comodule R (generatedCoordinateHopfAlgebra R) (Fin 27 → R) :=
  GeneralLinear.corestrictStandardComodule R 27 (generatedCoordinateMap R).hom

attribute [local instance] generatedStandardComodule

/-- The standard representation of the generated E₆ minuscule subgroup is faithful. -/
theorem isFaithful_generatedStandardComodule :
    Comodule.IsFaithful (k := R) (H := generatedCoordinateHopfAlgebra R) (V := Fin 27 → R) :=
  GeneralLinear.isFaithful_corestrictStandardComodule R 27
    (generatedCoordinateMap R).hom (generatedCoordinateMap_surjective R)

/-- Subcomodules of the generated group's standard representation are invariant under the
numbered root-subgroup points. -/
theorem generated_rootSubgroupPoints_mulVec_mem
    (N : Subcomodule R (generatedCoordinateHopfAlgebra R) (Fin 27 → R))
    (j : Fin 6 ⊕ Fin 6) (u : Multiplicative R) {w : Fin 27 → R} (hw : w ∈ N) :
    ((rootSubgroupPoints j R u : Matrix.GeneralLinearGroup (Fin 27) R) :
      Matrix (Fin 27) (Fin 27) R) *ᵥ w ∈ N := by
  let q := (AdditiveGroup.gaPointsMulEquiv (R := R) (A := R)).symm u
  have h := GeneralLinear.corestrictStandardComodule_mulVec_mem R 27
    (generatedCoordinateMap R).hom N
    (toConv (q.ofConv.comp (generatedCoordinateLift R (.inl j)).hom.toAlgHom)) hw
  have hcomp : (generatedCoordinateLift R (.inl j)).hom.comp
      (generatedCoordinateMap R).hom = (generatorCoordinateMap R (.inl j)).hom := by
    rw [← _root_.CommHopfAlgCat.hom_comp, generatedCoordinateMap_comp_generatedCoordinateLift]
  have hpoint : AlgHom.mapDomain (generatedCoordinateMap R).hom
      (toConv (q.ofConv.comp (generatedCoordinateLift R (.inl j)).hom.toAlgHom)) =
      toConv (q.ofConv.comp (generatorCoordinateMap R (.inl j)).hom.toAlgHom) := by
    apply WithConv.ext
    rw [AlgHom.mapDomain_apply, AlgHom.comp_assoc, ← BialgHom.comp_toAlgHom, hcomp]
  rw [hpoint] at h
  have hmatrix := pointsMulEquiv_kostantRootSubgroupToralBaseChangeCoordinateMap
    (TauCeti.serreRootGenerator weightTable.cartanMatrix)
    (TauCeti.serreH ℚ weightTable.cartanMatrix) weightTable.rep
    (TauCeti.coordinateLattice (Fin 27)).toAddSubgroup
    weightTable.rep_kostantForm_mem_lattice weightTable.isNilpotent_rep_serreRootGenerator
    (TauCeti.coordinateLatticeBasis (Fin 27)) weightTable.weight R definingIdeal_def j
    (CommAlgCat.of R R) q
  rw [CommHopfAlgCat.mapPointsFunctor_app_apply,
    CommHopfAlgCat.quotientPointsHom_apply, GeneralLinear.pointsMulEquiv_apply] at hmatrix
  have hgen := mkQuotient_comp_kostantRootSubgroupToralBaseChangePresentationCoordinateMap
    (TauCeti.serreRootGenerator weightTable.cartanMatrix)
    (TauCeti.serreH ℚ weightTable.cartanMatrix) weightTable.rep
    (TauCeti.coordinateLattice (Fin 27)).toAddSubgroup
    weightTable.rep_kostantForm_mem_lattice weightTable.isNilpotent_rep_serreRootGenerator
    (TauCeti.coordinateLatticeBasis (Fin 27)) weightTable.weight R j
  have hgen' := congrArg (fun f ↦ f.hom.toAlgHom) hgen
  rw [_root_.CommHopfAlgCat.hom_comp, BialgHom.comp_toAlgHom] at hgen'
  rw [AlgHom.comp_assoc, hgen', ← generatorCoordinateMap_inl] at hmatrix
  simp only [q, MulEquiv.apply_symm_apply] at hmatrix
  rw [coe_rootSubgroupPoints]
  rwa [hmatrix] at h

/-- The standard representation restricted to the weight torus is the sum of the 27 minuscule
weight lines. -/
theorem generatedTorusCorestrict_eq_ofWeights :
    Comodule.Corestrict (generatedCoordinateLift R (.inr ())).hom.toCoalgHom =
      Comodule.ofWeights (Pi.basisFun R (Fin 27)) minusculeCharacter := by
  apply GeneralLinear.corestrict_corestrict_standardComodule_eq_ofWeights
    (generatedCoordinateMap R).hom (generatedCoordinateLift R (.inr ())).hom
    DynkinType.e6MinusculeWeight
  rw [← _root_.CommHopfAlgCat.hom_comp,
    generatedCoordinateMap_comp_generatedCoordinateLift, generatorCoordinateMap_inr,
    GeneralLinear.hom_weightTorusBaseChangeCoordinateMap, weightTable_weight]

/-- The standard representation of the generated E₆ minuscule subgroup is simple over every
field, in arbitrary characteristic. -/
instance instIsSimpleOrderGeneratedSubcomodule (k : Type u) [Field k] :
    let _ := generatedStandardComodule k
    IsSimpleOrder (Subcomodule k (generatedCoordinateHopfAlgebra k) (Fin 27 → k)) := by
  let _ := generatedStandardComodule k
  exact Subcomodule.isSimpleOrder_of_corestrict_eq_ofWeights
    (generatedCoordinateLift k (.inr ())).hom.toCoalgHom minusculeCharacter
    minusculeCharacter_injective (generatedTorusCorestrict_eq_ofWeights k)
    (fun i a ↦ DynkinType.e6MinusculeReflection i a)
    (fun i ↦ DynkinType.e6MinusculeReflection_apply_apply i)
    (fun N a i ↦ single_reflection_mem_of_rootSubgroup_invariant k N.toSubmodule
      (fun j _ hw ↦ generated_rootSubgroupPoints_mulVec_mem k N j (Multiplicative.ofAdd 1) hw)
      a i) 0 DynkinType.exists_e6MinusculeReflections_eq

end TauCeti.E6Minuscule
