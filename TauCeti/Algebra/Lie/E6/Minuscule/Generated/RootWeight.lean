/-!
# Root vectors of the generated E₆ minuscule subgroup and their adjoint weights

Over a commutative ring `R`, the closed subgroup of `GL₂₇` generated by the twelve numbered
simple-root subgroups and the rank-six weight torus of the full-weight type-`E₆` minuscule carrier
is `TauCeti.E6Minuscule.generatedCoordinateHopfAlgebra R`; over a field it is reductive by
`TauCeti.E6Minuscule.reductiveCommHopfAlgProperty_generatedCoordinateHopfAlgebra`. This file reads
the numbered root vectors of that subgroup off its root-subgroup maps and places them in its
adjoint weight spaces for the weight torus.

The differential of the `k`th root subgroup `𝔾ₐ → G` is injective, and in the minuscule basis it
sends a tangent vector of `𝔾ₐ` to its parameter times the integral raising or lowering matrix
`TauCeti.E6Minuscule.raisingMatrix` or `TauCeti.E6Minuscule.loweringMatrix`. The image of the unit
tangent vector is the normalized root vector `TauCeti.E6Minuscule.generatedRootVector R k`.

The weight torus acts on the `(a, b)` entry of a tangent matrix through the difference of the
minuscule weights of `a` and `b`. A raising or lowering matrix is supported on entries whose weight
difference is the corresponding positive or negative simple root, so each normalized root vector
lies in the adjoint weight space of the simple-root character `TauCeti.E6.rootGeneratorWeight k`,
which `TauCeti.E6Minuscule.rootGeneratorWeight_inl_eq_root_simpleIndex` and its negative
counterpart identify with a signed simple root of the simply connected type-`E₆` root datum.
Since the root vector is nonzero over every nontrivial ring, each of the twelve signed simple roots
is a nontrivial adjoint weight of the generated subgroup. The weight-space statements assume that
the augmentation cotangent module is projective, which holds over every field.

These are the root-vector components of a pinning `(G, T, B, {X_α})` of the generated subgroup.
Nothing here identifies a simple root line with the entire weight space, proves that the weight
torus is maximal, or identifies the generated subgroup with an independently constructed pinned
simply connected group scheme of type `E₆`.

## Main definitions

* `TauCeti.E6Minuscule.generatedRootVector`: the normalized tangent vector of the `k`th numbered
  root subgroup of the generated subgroup.

## Main results

* `TauCeti.E6Minuscule.derivationComp_generatedCoordinateLift_injective`: each numbered
  root-subgroup differential is injective, with values in every commutative algebra.
* `TauCeti.E6Minuscule.tangentMatrix_derivationComp_generatedCoordinateLift` and
  `TauCeti.E6Minuscule.tangentMatrix_generatedRootVector`: the root-subgroup differential is the
  tangent parameter times the integral raising or lowering matrix.
* `TauCeti.E6Minuscule.generatedRootVector_ne_zero`: the normalized root vectors are nonzero.
* `TauCeti.E6Minuscule.mem_adjointWeightSpace_generatedWeightTorusCoordinateMap_iff`: the
  entrywise criterion for membership in an adjoint weight space of the generated subgroup.
* `TauCeti.E6Minuscule.generatedRootVector_mem_adjointWeightSpace`: each normalized root vector
  has its signed simple-root character.
* `TauCeti.E6Minuscule.weightCharacter_rootGeneratorWeight_mem_nontrivialAdjointWeights`: the
  twelve signed simple-root characters are nontrivial adjoint weights.

## References

* J. S. Milne, *Algebraic Groups* (2017), §§10.a and 21.1.
* B. Conrad, *Reductive Group Schemes* (2014), §5.1.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Plate V.

The differential is read off the restriction of the generic matrix to each root subgroup, through
`TauCeti.GeneralLinear.tangentMatrix_derivationComp_eq_smul_of_map_genericMatrix`, as in
`TauCeti.Algebra.Lie.E7.Minuscule.Root.Differential`; the weight-space argument applies the
general criterion
`TauCeti.HopfIdeal.mem_adjointWeightSpace_iff_of_weightTorus`, as
`TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.Root.Space` does for the short-root `G₂` carrier.
-/

public section

open CategoryTheory WithConv

namespace TauCeti.E6Minuscule

open TauCeti.DynkinType

universe u v

noncomputable section

/-! ## The numbered root differentials -/

section Differential

variable (R : Type u) [CommRing R]

/-- The numbered root-subgroup coordinate maps of the generated subgroup are surjective, so the
root subgroups are closed subgroups of it. -/
theorem generatedCoordinateLift_inl_surjective (k : Fin 6 ⊕ Fin 6) :
    Function.Surjective (generatedCoordinateLift R (.inl k)).hom := by
  have h : Function.Surjective
      (generatedCoordinateMap R ≫ generatedCoordinateLift R (.inl k)).hom := by
    rw [generatedCoordinateMap_comp_generatedCoordinateLift, generatorCoordinateMap_inl,
      ← coordinateMap_comp_rootSubgroupToBaseChangeCoordinateMap,
      _root_.CommHopfAlgCat.hom_comp, BialgHom.coe_comp]
    exact (rootSubgroupToBaseChangeCoordinateMap_surjective R k).comp
      (coordinateMap_surjective R)
  rw [_root_.CommHopfAlgCat.hom_comp, BialgHom.coe_comp] at h
  exact Function.Surjective.of_comp h

/-- The generic matrix of `GL₂₇`, restricted to the `k`th numbered root subgroup, is
`1 + t X_k` for the coordinate `t` of `𝔾ₐ` and the integral raising or lowering matrix `X_k`. -/
private theorem map_genericMatrix_generatedCoordinateLift (k : Fin 6 ⊕ Fin 6) :
    (GeneralLinear.genericMatrix R 27).map
        ((generatedCoordinateLift R (.inl k)).hom.toAlgHom.comp
          (generatedCoordinateMap R).hom.toAlgHom) =
      1 + SymmetricAlgebra.ι R R 1 •
        (Sum.elim raisingMatrix loweringMatrix k).map
          (Int.cast : ℤ → AdditiveGroup.coordinateHopfAlgebra R) := by
  let A := CommAlgCat.of R (AdditiveGroup.coordinateHopfAlgebra R)
  let q : HopfAlgebra.points (R := R) (H := AdditiveGroup.coordinateHopfAlgebra R) A :=
    toConv (AlgHom.id R (AdditiveGroup.coordinateHopfAlgebra R))
  have hu : AdditiveGroup.gaPointsMulEquiv (R := R) q =
      Multiplicative.ofAdd (SymmetricAlgebra.ι R R 1) := by
    rw [← ofAdd_toAdd (AdditiveGroup.gaPointsMulEquiv (R := R) q),
      AdditiveGroup.toAdd_gaPointsMulEquiv]
    simp [q]
  have h := congrArg (fun g : Matrix.GeneralLinearGroup (Fin 27) A =>
    (g : Matrix (Fin 27) (Fin 27) A))
    (pointToGeneralLinear_mapDomain_generatedCoordinateLift_inl_eq_rootSubgroupPoints R k A q)
  rw [← GeneralLinear.map_genericMatrix_eq_coe_pointToGeneralLinear,
    AlgHom.mapDomain_apply] at h
  simp only [q, AlgHom.id_comp] at h
  rw [h, hu]
  -- The carrier states its root points through the weight table's matrices, whose identification
  -- with the named matrices is entrywise.
  rcases k with i | i
  · have hX : weightTable.raisingMatrix i = raisingMatrix i := by
      ext a b
      rw [raisingMatrix_apply, MinusculeWeightTable.raisingMatrix_apply, weightTable_weight,
        weightTable_reflection]
    rw [coe_rootSubgroupPoints_inl, toAdd_ofAdd, hX, Sum.elim_inl]
  · have hX : weightTable.loweringMatrix i = loweringMatrix i := by
      ext a b
      rw [loweringMatrix_apply, MinusculeWeightTable.loweringMatrix_apply, weightTable_weight,
        weightTable_reflection]
    rw [coe_rootSubgroupPoints_inr, toAdd_ofAdd, hX, Sum.elim_inr]

variable {B : Type v} [CommRing B] [Algebra R B]

/-- Each numbered root-subgroup differential of the generated subgroup is injective, with
coefficients in every commutative algebra, including nonreduced ones. -/
theorem derivationComp_generatedCoordinateLift_injective (k : Fin 6 ⊕ Fin 6) :
    Function.Injective (derivationComp (B := B) (generatedCoordinateLift R (.inl k)).hom) :=
  derivationComp_injective_of_surjective _ (generatedCoordinateLift_inl_surjective R k)

/-- **The differential of a numbered root subgroup of the generated subgroup.** In the minuscule
basis, the tangent vector obtained by differentiating the `k`th root subgroup along a tangent
vector of `𝔾ₐ` is its parameter times the integral raising or lowering matrix. -/
theorem tangentMatrix_derivationComp_generatedCoordinateLift (k : Fin 6 ⊕ Fin 6)
    (d : Derivation R (AdditiveGroup.coordinateHopfAlgebra R)
      (Bialgebra.CounitAlgebra R (AdditiveGroup.coordinateHopfAlgebra R) B)) :
    GeneralLinear.tangentMatrix 27
        (derivationComp (B := B) (generatedCoordinateMap R).hom
          (derivationComp (B := B) (generatedCoordinateLift R (.inl k)).hom d)) =
      AdditiveGroup.gaTangentLinearEquiv d •
        (Sum.elim raisingMatrix loweringMatrix k).map (Int.cast : ℤ → B) := by
  rw [← LinearMap.comp_apply, ← derivationComp_comp]
  exact GeneralLinear.tangentMatrix_derivationComp_eq_smul_of_map_genericMatrix _ _
    (map_genericMatrix_generatedCoordinateLift R k) d

/-- The normalized tangent vector of the `k`th numbered root subgroup of the generated
subgroup: the image of the unit tangent vector of `𝔾ₐ`. -/
def generatedRootVector (k : Fin 6 ⊕ Fin 6) :
    Derivation R (generatedCoordinateHopfAlgebra R)
      (Bialgebra.CounitAlgebra R (generatedCoordinateHopfAlgebra R) R) :=
  derivationComp (B := R) (generatedCoordinateLift R (.inl k)).hom
    ((AdditiveGroup.gaTangentLinearEquiv (R := R) (B := R)).symm 1)

/-- The normalized root vector is the differential of the root subgroup at the unit tangent
vector of `𝔾ₐ`. -/
theorem generatedRootVector_def (k : Fin 6 ⊕ Fin 6) :
    generatedRootVector R k =
      derivationComp (B := R) (generatedCoordinateLift R (.inl k)).hom
        ((AdditiveGroup.gaTangentLinearEquiv (R := R) (B := R)).symm 1) :=
  (rfl)

/-- The differential of the `k`th root subgroup along a tangent vector of `𝔾ₐ` is its parameter
times the normalized root vector. -/
theorem derivationComp_generatedCoordinateLift_eq_smul_generatedRootVector
    (k : Fin 6 ⊕ Fin 6)
    (d : Derivation R (AdditiveGroup.coordinateHopfAlgebra R)
      (Bialgebra.CounitAlgebra R (AdditiveGroup.coordinateHopfAlgebra R) R)) :
    derivationComp (B := R) (generatedCoordinateLift R (.inl k)).hom d =
      AdditiveGroup.gaTangentLinearEquiv d • generatedRootVector R k :=
  AdditiveGroup.derivationComp_eq_smul _ d

/-- The matrix of a normalized root vector is its integral raising or lowering matrix. -/
@[simp]
theorem tangentMatrix_generatedRootVector (k : Fin 6 ⊕ Fin 6) :
    GeneralLinear.tangentMatrix 27
        (derivationComp (B := R) (generatedCoordinateMap R).hom (generatedRootVector R k)) =
      (Sum.elim raisingMatrix loweringMatrix k).map (Int.cast : ℤ → R) := by
  rw [generatedRootVector_def, tangentMatrix_derivationComp_generatedCoordinateLift,
    LinearEquiv.apply_symm_apply, one_smul]

/-- A normalized root vector is nonzero over every nontrivial commutative ring. -/
theorem generatedRootVector_ne_zero [Nontrivial R] (k : Fin 6 ⊕ Fin 6) :
    generatedRootVector R k ≠ 0 :=
  AdditiveGroup.derivationComp_gaTangentLinearEquiv_symm_one_ne_zero _
    (derivationComp_generatedCoordinateLift_injective (B := R) R k)

end Differential

/-! ## Adjoint weights -/

section Weights

-- The closed-subgroup weight criterion takes the base ring in the universe of the torus index.
variable (R : Type) [CommRing R]

/-- A raising or lowering matrix vanishes off the entries whose weight difference is its signed
simple root. -/
private theorem rootMatrix_apply_eq_zero (k : Fin 6 ⊕ Fin 6) (a b : Fin 27)
    (h : e6MinusculeWeight a - e6MinusculeWeight b ≠ E6.rootGeneratorWeight k) :
    Sum.elim raisingMatrix loweringMatrix k a b = 0 := by
  rcases k with i | i
  · rw [Sum.elim_inl, raisingMatrix_apply, ite_eq_right_iff]
    rintro ⟨hb, rfl⟩
    refine absurd ?_ h
    rw [e6MinusculeWeight_reflection, hb, E6.rootGeneratorWeight_inl_eq_e6Root_e6SimpleIndex]
    abel
  · rw [Sum.elim_inr, loweringMatrix_apply, ite_eq_right_iff]
    rintro ⟨hb, rfl⟩
    refine absurd ?_ h
    rw [e6MinusculeWeight_reflection, hb, E6.rootGeneratorWeight_inr_eq_neg_e6Root_e6SimpleIndex]
    abel

/-- The entrywise weight-space criterion
`TauCeti.HopfIdeal.mem_adjointWeightSpace_iff_of_weightTorus` for the quotient by
`generatedDefiningIdeal R`, stated for any Hopf algebra `G` equal to that quotient. The generated
coordinate Hopf algebra is such a `G` by `generatedCoordinateHopfAlgebra_def`, whose body is not
exposed, so the criterion is transported along that equation. -/
private theorem mem_adjointWeightSpace_iff_of_eq {G : CommHopfAlgCat R}
    (hG : CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra R 27)
      (generatedDefiningIdeal R) = G)
    (π : G ⟶ (DiagonalizableGroup.coordinateRing R (SplitTorus.characterGroup (Fin 6))).obj)
    (hπ : CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra R 27)
        (generatedDefiningIdeal R) ≫ eqToHom hG ≫ π =
      GeneralLinear.weightTorusCoordinateMap (R := R) e6MinusculeWeight)
    [Module.Finite R (Bialgebra.CotangentSpace R G)]
    [Module.Projective R (Bialgebra.CotangentSpace R G)]
    (α : Multiplicative (Fin 6 →₀ ℤ)) (x : Module.Dual R (Bialgebra.CotangentSpace R G)) :
    x ∈ Derivation.adjointWeightSpace π.hom α ↔
      ∀ a b, SplitTorus.weightCharacter (e6MinusculeWeight a - e6MinusculeWeight b) ≠ α →
        GeneralLinear.tangentMatrix 27
          (derivationComp (B := R) (CommHopfAlgCat.mkQuotient
              (GeneralLinear.coordinateHopfAlgebra R 27) (generatedDefiningIdeal R) ≫
            eqToHom hG).hom (Derivation.cotangentLinearEquiv (B := R) x)) a b = 0 := by
  subst hG
  rw [eqToHom_refl, Category.id_comp] at hπ
  rw [eqToHom_refl, Category.comp_id, CommHopfAlgCat.hom_mkQuotient]
  have hπ' : π.hom.comp (Bialgebra.Quotient.mkBialgHom (generatedDefiningIdeal R).toIdeal) =
      (GeneralLinear.weightTorusCoordinateMap (R := R) e6MinusculeWeight).hom := by
    rw [← CommHopfAlgCat.hom_mkQuotient, ← _root_.CommHopfAlgCat.hom_comp, hπ]
  simpa only [HopfIdeal.quotientLieHom_apply] using
    HopfIdeal.mem_adjointWeightSpace_iff_of_weightTorus (generatedDefiningIdeal R)
      e6MinusculeWeight π.hom hπ' α x

variable [Module.Projective R
  (Bialgebra.CotangentSpace R (generatedCoordinateHopfAlgebra R))]

/-- **The entrywise criterion for the adjoint weight spaces of the generated subgroup.** A tangent
vector has weight `α` for the weight torus exactly when its matrix vanishes at every entry
`(a, b)` whose minuscule weight difference is a different character. -/
theorem mem_adjointWeightSpace_generatedWeightTorusCoordinateMap_iff
    (α : Multiplicative (Fin 6 →₀ ℤ))
    (x : Module.Dual R (Bialgebra.CotangentSpace R (generatedCoordinateHopfAlgebra R))) :
    x ∈ Derivation.adjointWeightSpace (generatedWeightTorusCoordinateMap R).hom α ↔
      ∀ a b, SplitTorus.weightCharacter (e6MinusculeWeight a - e6MinusculeWeight b) ≠ α →
        GeneralLinear.tangentMatrix 27
          (derivationComp (B := R) (generatedCoordinateMap R).hom
            (Derivation.cotangentLinearEquiv (B := R) x)) a b = 0 := by
  have hπ := generatedCoordinateMap_comp_generatedWeightTorusCoordinateMap R
  rw [generatedCoordinateMap_def, Category.assoc,
    GeneralLinear.weightTorusBaseChangeCoordinateMap_eq, weightTable_weight] at hπ
  rw [generatedCoordinateMap_def]
  exact mem_adjointWeightSpace_iff_of_eq R (generatedCoordinateHopfAlgebra_def R).symm _ hπ α x

/-- **Each normalized root vector has its signed simple-root character.** The tangent vector of
the `k`th numbered root subgroup lies in the adjoint weight space of
`TauCeti.E6.rootGeneratorWeight k` for the weight torus of the generated subgroup. -/
theorem generatedRootVector_mem_adjointWeightSpace (k : Fin 6 ⊕ Fin 6) :
    (Derivation.cotangentLinearEquiv (B := R)).symm (generatedRootVector R k) ∈
      Derivation.adjointWeightSpace (generatedWeightTorusCoordinateMap R).hom
        (SplitTorus.weightCharacter (E6.rootGeneratorWeight k)) := by
  rw [mem_adjointWeightSpace_generatedWeightTorusCoordinateMap_iff]
  intro a b hab
  rw [LinearEquiv.apply_symm_apply, tangentMatrix_generatedRootVector, Matrix.map_apply,
    rootMatrix_apply_eq_zero k a b (fun h => hab (congrArg SplitTorus.weightCharacter h)),
    Int.cast_zero]

/-- A signed simple-root character of type `E₆` is nontrivial: its value at its own node is
`±2`. -/
private theorem weightCharacter_rootGeneratorWeight_ne_one (k : Fin 6 ⊕ Fin 6) :
    SplitTorus.weightCharacter (E6.rootGeneratorWeight k) ≠ 1 := by
  intro h
  rcases k with i | i
  · have hi := SplitTorus.toAdd_weightCharacter (E6.rootGeneratorWeight (.inl i)) i
    rw [h, toAdd_one, Finsupp.zero_apply, E6.rootGeneratorWeight_inl, CartanMatrix.E_diag] at hi
    exact two_ne_zero hi.symm
  · have hi := SplitTorus.toAdd_weightCharacter (E6.rootGeneratorWeight (.inr i)) i
    rw [h, toAdd_one, Finsupp.zero_apply, E6.rootGeneratorWeight_inr, CartanMatrix.E_diag] at hi
    exact two_ne_zero (neg_eq_zero.mp hi.symm)

/-- **The twelve signed simple roots are nontrivial adjoint weights of the generated subgroup.**
Over every nontrivial ring with projective augmentation cotangent module, in particular over
every field, the adjoint weight space of each signed simple-root character contains the nonzero
normalized root vector. -/
theorem weightCharacter_rootGeneratorWeight_mem_nontrivialAdjointWeights [Nontrivial R]
    (k : Fin 6 ⊕ Fin 6) :
    SplitTorus.weightCharacter (E6.rootGeneratorWeight k) ∈
      Derivation.nontrivialAdjointWeights (generatedWeightTorusCoordinateMap R).hom := by
  refine Derivation.mem_nontrivialAdjointWeights.2
    ⟨weightCharacter_rootGeneratorWeight_ne_one k, fun hbot => ?_⟩
  have hz := generatedRootVector_mem_adjointWeightSpace R k
  rw [hbot, Submodule.mem_bot, LinearEquiv.map_eq_zero_iff] at hz
  exact generatedRootVector_ne_zero R k hz

end Weights

end

end TauCeti.E6Minuscule
