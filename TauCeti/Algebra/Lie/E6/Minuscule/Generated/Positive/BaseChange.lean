module

public import TauCeti.Algebra.Lie.E6.Minuscule.Generated.Positive.Basic

/-!
# Base change of the generated positive E₆ minuscule subgroup

For any extension of commutative rings, the positive subgroup generated after extension is a
closed subgroup of the scalar extension of the positive subgroup. The surjective coordinate map
`coordinateHopfAlgebraBaseChangeHom` realizes this inclusion and respects every positive root
and weight-torus coordinate lift. It is uniquely determined by its ambient general-linear square.
No flatness or reducedness assumption is needed for this comparison.

The closed subgroup generated by the six positive numbered root subgroups and the weight torus
commutes with free scalar extension, in particular with every extension of fields. The comparison
commutes with its inclusions into `GL₂₇` and the full generated minuscule carrier. It also
transports the defining ideal inside that carrier. Thus the positive subgroup and its ambient
group can be compared together on geometric fibres when constructing a Borel subgroup.

The generator comparisons hold over arbitrary commutative rings. The reverse containment, and
hence equality of the generated subgroups under base change, is established here under freeness.
No identification with the specialization of the integral positive subgroup, or Borel maximality,
is asserted.

For Borel recognition, `HopfIdeal.IsBorel` tests maximality after extension to an algebraic
closure. The equation `map_baseChangeHopfIdeal_carrierDefiningIdeal` at that extension
identifies the ideal in this test with `carrierDefiningIdeal` over the closure, inside the full
generated carrier there.
Thus `HopfIdeal.IsBorelOverAlgClosed.of_map_eq` transports a Borel maximality proof for that
concrete positive subgroup back to the required geometric fibre. Identification with the
integral specialization remains a separate step in constructing a pinned integral group.

## Main declarations

* `coordinateHopfAlgebraBaseChangeHom`: the comparison for arbitrary scalar extensions.
* `map_baseChangeHopfIdeal_definingIdeal`: transport of the ambient defining ideal.
* `coordinateHopfAlgebraBaseChangeIso`: the positive-subgroup comparison.
* `baseChangeMap_restriction_comp_coordinateHopfAlgebraBaseChangeIso_hom`: compatibility with
  restriction from the full generated carrier.
* `map_baseChangeHopfIdeal_carrierDefiningIdeal`: transport of the ideal inside the full carrier.

## References

* B. Conrad, *Reductive Group Schemes*, §1.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26–28.

The construction follows the generated positive Geck comparison in
`GeckLattice.Positive.Generated.BaseChange` under
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum`,
using the E₆ generator comparisons in `TauCeti.Algebra.Lie.E6.Minuscule.Generated.Basic` and the
common-kernel and quotient-transport API in `TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange`.
The carrier-level restriction and intrinsic-ideal transport proofs adapt
`TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.Positive.BaseChange`.
-/

public section

open CategoryTheory

namespace TauCeti.E6Minuscule.Generated.Positive

universe v w

noncomputable section

variable (k : Type v) (K : Type max v w) [CommRing k] [CommRing K] [Algebra k K]

/-- Scalar extension respects each positive root and weight-torus coordinate map. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_generator_comp_baseChangeIso_hom (j : Fin 6 ⊕ Unit) :
    CommHopfAlgCat.baseChangeMap (K := K) (generator k j) ≫
        (generatorCoordinateAlgebraBaseChangeIso k K (match j with
          | .inl i => .inl (.inl i)
          | .inr u => .inr u)).hom =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom ≫ generator K j := by
  apply (Iso.inv_comp_eq (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27)).mp
  cases j with
  | inl i =>
    simpa only [generator_inl, Category.assoc] using
      generatorCoordinateMap_baseChange k K (.inl (.inl i))
  | inr u =>
    cases u
    simpa only [generator_inr, Category.assoc] using
      generatorCoordinateMap_baseChange k K (.inr ())

/-- The positive subgroup generated after any scalar extension lies in the scalar extension
of the positive subgroup generated over the ground ring, contravariantly on defining ideals. -/
theorem map_baseChangeHopfIdeal_definingIdeal_le :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (definingIdeal k)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom.hom ≤
      definingIdeal K := by
  calc
    _ ≤ (CommHopfAlgCat.commonKernelHopfIdeal
        (fun j ↦ CommHopfAlgCat.baseChangeMap (K := K) (generator k j))).map
          (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom.hom :=
      HopfIdeal.map_mono _
        (CommHopfAlgCat.baseChangeHopfIdeal_commonKernelHopfIdeal_le (generator k))
    _ = definingIdeal K := by
      rw [CommHopfAlgCat.map_commonKernelHopfIdeal]
      rw [← CommHopfAlgCat.commonKernelHopfIdeal_comp_of_injective
        (fun j ↦ (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).inv ≫
          CommHopfAlgCat.baseChangeMap (K := K) (generator k j))
        (fun j ↦ (generatorCoordinateAlgebraBaseChangeIso k K (match j with
          | .inl i => .inl (.inl i)
          | .inr u => .inr u)).hom)
        (fun j ↦ (ConcreteCategory.bijective_of_isIso _).1)]
      congr 1
      funext j
      rw [Category.assoc, baseChangeMap_generator_comp_baseChangeIso_hom,
        Iso.inv_hom_id_assoc]

private theorem baseChange_definingIdeal_le_ker :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (definingIdeal k)).toIdeal ≤
      RingHom.ker ((GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal K)).hom.toAlgHom.toRingHom := by
  intro x hx
  simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
    _root_.CommHopfAlgCat.hom_comp, BialgHom.coe_toAlgHom, BialgHom.comp_apply]
  exact (CommHopfAlgCat.mkQuotient_eq_zero_iff _ _ _).mpr
    (map_baseChangeHopfIdeal_definingIdeal_le k K (HopfIdeal.mem_map_of_mem _ hx))

/-- The coordinate surjection from the base-changed positive subgroup to the positive subgroup
generated over the extension ring. Contravariantly this is a closed immersion, not in general
an asserted isomorphism. -/
def coordinateHopfAlgebraBaseChangeHom :
    CommHopfAlgCat.baseChange (K := K) (coordinateHopfAlgebra k) ⟶
      coordinateHopfAlgebra K :=
  (CommHopfAlgCat.quotientBaseChangeIso (K := K) (definingIdeal k)).inv ≫
    CommHopfAlgCat.liftQuotient _
      ((GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal K))
      (baseChange_definingIdeal_le_ker k K)

/-- The arbitrary-extension comparison respects the ambient general-linear inclusion. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeHom :
    CommHopfAlgCat.baseChangeMap (K := K)
        (CommHopfAlgCat.mkQuotient _ (definingIdeal k)) ≫
        coordinateHopfAlgebraBaseChangeHom k K =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal K) := by
  have hbase :
      CommHopfAlgCat.baseChangeMap (K := K)
          (CommHopfAlgCat.mkQuotient _ (definingIdeal k)) ≫
          (CommHopfAlgCat.quotientBaseChangeIso (K := K) (definingIdeal k)).inv =
        CommHopfAlgCat.mkQuotient _
          (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (definingIdeal k)) := by
    rw [← cancel_mono
      (CommHopfAlgCat.quotientBaseChangeIso (K := K) (definingIdeal k)).hom,
      Category.assoc, Iso.inv_hom_id, Category.comp_id,
      CommHopfAlgCat.mkQuotient_comp_quotientBaseChangeIso_hom]
  rw [coordinateHopfAlgebraBaseChangeHom, ← Category.assoc, hbase,
    CommHopfAlgCat.mkQuotient_comp_liftQuotient]

private instance : Epi (CommHopfAlgCat.baseChangeMap (K := K)
    (CommHopfAlgCat.mkQuotient _ (definingIdeal k))) :=
  ConcreteCategory.epi_of_surjective _ (CommHopfAlgCat.baseChangeMap_surjective _
    (CommHopfAlgCat.mkQuotient_surjective _ _))

/-- The ambient general-linear square characterizes the arbitrary-extension comparison. -/
theorem coordinateHopfAlgebraBaseChangeHom_unique
    (f : CommHopfAlgCat.baseChange (K := K) (coordinateHopfAlgebra k) ⟶
      coordinateHopfAlgebra K)
    (hf : CommHopfAlgCat.baseChangeMap (K := K)
        (CommHopfAlgCat.mkQuotient _ (definingIdeal k)) ≫ f =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal K)) :
    f = coordinateHopfAlgebraBaseChangeHom k K := by
  apply (cancel_epi (CommHopfAlgCat.baseChangeMap (K := K)
    (CommHopfAlgCat.mkQuotient _ (definingIdeal k)))).mp
  rw [hf, baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeHom]

/-- The arbitrary-extension comparison is a closed immersion on affine group schemes. -/
theorem coordinateHopfAlgebraBaseChangeHom_surjective :
    Function.Surjective (coordinateHopfAlgebraBaseChangeHom k K).hom := by
  have h : Function.Surjective
      ((GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal K)).hom :=
    (CommHopfAlgCat.mkQuotient_surjective _ (definingIdeal K)).comp
      (ConcreteCategory.bijective_of_isIso
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom).2
  rw [← baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeHom k K] at h
  exact Function.Surjective.of_comp h

/-- The arbitrary-extension comparison respects every positive numbered root and the weight
torus, expressed on the common-kernel coordinate lifts. -/
@[reassoc (attr := simp)]
theorem coordinateHopfAlgebraBaseChangeHom_comp_commonKernelLift (j : Fin 6 ⊕ Unit) :
    coordinateHopfAlgebraBaseChangeHom k K ≫
        CommHopfAlgCat.commonKernelLift (generator K) j =
      CommHopfAlgCat.baseChangeMap (K := K)
          (CommHopfAlgCat.commonKernelLift (generator k) j) ≫
        (generatorCoordinateAlgebraBaseChangeIso k K (match j with
          | .inl i => .inl (.inl i)
          | .inr u => .inr u)).hom := by
  apply (cancel_epi (CommHopfAlgCat.baseChangeMap (K := K)
    (CommHopfAlgCat.mkQuotient _ (definingIdeal k)))).mp
  rw [← Category.assoc,
    baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeHom,
    Category.assoc, CommHopfAlgCat.mkQuotient_comp_commonKernelLift,
    ← Category.assoc, ← (CommHopfAlgCat.baseChangeFunctor (K := K)).map_comp,
    CommHopfAlgCat.mkQuotient_comp_commonKernelLift,
    baseChangeMap_generator_comp_baseChangeIso_hom]

variable [Module.Free k K]

/-- Free scalar extension carries the positive generated defining ideal onto the positive
generated defining ideal over the extension ring. -/
@[simp]
theorem map_baseChangeHopfIdeal_definingIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (definingIdeal k)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom.hom =
      definingIdeal K := by
  apply CommHopfAlgCat.map_baseChangeHopfIdeal_commonKernelHopfIdeal
    (generator k) (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27)
    (fun j ↦ match j with
      | .inl i => generatorCoordinateAlgebraBaseChangeIso k K (.inl (.inl i))
      | .inr u => generatorCoordinateAlgebraBaseChangeIso k K (.inr u))
    (generator K)
  rintro (i | u)
  · simpa only [generator_inl] using
      generatorCoordinateMap_baseChange k K (.inl (.inl i))
  · cases u
    simpa only [generator_inr] using generatorCoordinateMap_baseChange k K (.inr ())

/-- The base change of the positive subgroup generated over `k` is the positive subgroup
generated over `K`, for any free extension of commutative rings. -/
def coordinateHopfAlgebraBaseChangeIso :
    CommHopfAlgCat.baseChange (K := K) (coordinateHopfAlgebra k) ≅
      coordinateHopfAlgebra K :=
  CommHopfAlgCat.quotientBaseChangeIsoOfMapEq (definingIdeal k) (definingIdeal K)
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27)
    (map_baseChangeHopfIdeal_definingIdeal k K)

/-- The positive-subgroup comparison commutes with the closed inclusion into `GL₂₇`. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := K)
        (CommHopfAlgCat.mkQuotient _ (definingIdeal k)) ≫
        (coordinateHopfAlgebraBaseChangeIso k K).hom =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 27).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal K) :=
  CommHopfAlgCat.baseChangeMap_mkQuotient_comp_quotientBaseChangeIsoOfMapEq_hom _ _ _ _

/-- The positive-subgroup comparison commutes with restriction from the full generated carrier. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_restriction_comp_coordinateHopfAlgebraBaseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := K) (restriction k) ≫
        (coordinateHopfAlgebraBaseChangeIso k K).hom =
      (generatedCoordinateHopfAlgebraBaseChangeIso k K).hom ≫ restriction K := by
  let q := CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateMap k)
  let _ : Epi q := ConcreteCategory.epi_of_surjective q
    (CommHopfAlgCat.baseChangeMap_surjective (generatedCoordinateMap k)
      (generatedCoordinateMap_surjective k))
  apply (cancel_epi q).mp
  dsimp only [q]
  rw [← Category.assoc, ← (CommHopfAlgCat.baseChangeFunctor (K := K)).map_comp,
    generatedCoordinateMap_comp_restriction,
    baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeIso_hom]
  rw [← Category.assoc,
    baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeIso_hom,
    Category.assoc, generatedCoordinateMap_comp_restriction]

/-- The full-carrier comparison carries the scalar extension of the positive subgroup's
intrinsic ideal onto the intrinsic ideal over the extension ring. -/
@[simp]
theorem map_baseChangeHopfIdeal_carrierDefiningIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (carrierDefiningIdeal k)).map
        (generatedCoordinateHopfAlgebraBaseChangeIso k K).hom.hom =
      carrierDefiningIdeal K := by
  rw [carrierDefiningIdeal_def, carrierDefiningIdeal_def]
  apply CommHopfAlgCat.map_baseChangeHopfIdeal_kerOfSurjective
    (generatedCoordinateHopfAlgebraBaseChangeIso k K)
    (coordinateHopfAlgebraBaseChangeIso k K) (restriction_surjective k)
    (restriction_surjective K)
  rw [baseChangeMap_restriction_comp_coordinateHopfAlgebraBaseChangeIso_hom,
    Iso.inv_hom_id_assoc]

/-- Over a free extension the canonical comparison is the existing base-change isomorphism. -/
theorem coordinateHopfAlgebraBaseChangeIso_hom_eq :
    (coordinateHopfAlgebraBaseChangeIso k K).hom =
      coordinateHopfAlgebraBaseChangeHom k K :=
  coordinateHopfAlgebraBaseChangeHom_unique k K _
    (baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeIso_hom k K)

end

end TauCeti.E6Minuscule.Generated.Positive
