module

public import TauCeti.Algebra.Lie.E6.Minuscule.BaseChange

/-!
# The subgroup generated by the type-E₆ minuscule roots and weight torus

The twelve numbered simple-root subgroups and the rank-six weight torus of the full-weight
type-`E₆` minuscule carrier are morphisms into `GL₂₇` over any commutative ring. The closed
subgroup they generate is cut out by the largest Hopf ideal killed by all of them, that is by the
common kernel of their coordinate maps.

This file names that ideal and the resulting coordinate Hopf algebra, and records the two facts a
consumer needs about them: each generator factors uniquely through the quotient, and the quotient
lies inside the base change of the integral carrier.

Equality of the generated subgroup with the base change of the integral carrier is not asserted:
extra equations can appear after specialization to a non-flat base. Nor is the generated subgroup
identified with a pinned simply connected group scheme of type `E₆`.

## Main declarations

* `TauCeti.E6Minuscule.generatedDefiningIdeal`: the common kernel of the generator coordinate
  maps.
* `TauCeti.E6Minuscule.generatedCoordinateHopfAlgebra`: the coordinate Hopf algebra of the
  generated closed subgroup.

## Main results

* `TauCeti.E6Minuscule.le_generatedDefiningIdeal_iff`: a Hopf ideal lies below the generated
  subgroup's defining ideal exactly when every generator coordinate map kills it.
* `TauCeti.E6Minuscule.baseChangeDefiningIdeal_le_generatedDefiningIdeal`: the base-changed
  integral carrier contains the generated subgroup.
* `TauCeti.E6Minuscule.existsUnique_generatorCoordinateMap_factor`: each generator factors
  uniquely through the generated subgroup.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.

-/

public section

namespace TauCeti.E6Minuscule

open CategoryTheory

universe v

variable (A : Type v) [CommRing A]

-- The construction follows the sibling generated-subgroup API in
-- `TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.Basic`.
/-- The defining ideal of the subgroup generated by the numbered root subgroups and the weight
torus of the type-`E₆` minuscule carrier. -/
noncomputable def generatedDefiningIdeal :
    HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A 27) :=
  CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap A)

/-- The generated subgroup is defined by the common kernel of its generator maps. -/
@[simp]
theorem generatedDefiningIdeal_def :
    generatedDefiningIdeal A =
      CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap A) := by
  simp [generatedDefiningIdeal]

/-- A Hopf ideal lies below the generated subgroup's defining ideal exactly when all generator
coordinate maps kill it. -/
theorem le_generatedDefiningIdeal_iff
    (J : HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A 27)) :
    J ≤ generatedDefiningIdeal A ↔
      ∀ j, J.toIdeal ≤ RingHom.ker
        (generatorCoordinateMap A j).hom.toAlgHom.toRingHom := by
  rw [generatedDefiningIdeal_def]
  exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff (generatorCoordinateMap A) J

/-- The base-changed integral carrier contains the generated subgroup. -/
theorem baseChangeDefiningIdeal_le_generatedDefiningIdeal :
    baseChangeDefiningIdeal A ≤ generatedDefiningIdeal A := by
  rw [generatedDefiningIdeal_def]
  apply (CommHopfAlgCat.le_commonKernelHopfIdeal_iff (generatorCoordinateMap A) _).2
  rintro (i | ⟨⟩)
  · rw [generatorCoordinateMap_inl]
    exact CommHopfAlgCat.toIdeal_le_ker_of_mkQuotient_comp
      (mkQuotient_comp_rootSubgroupToBaseChangeCoordinateMap A i)
  · rw [generatorCoordinateMap_inr]
    intro x hx
    have hxker : x ∈ RingHom.ker (coordinateMap A).hom.toAlgHom := by
      rw [coordinateMap_ker]
      exact hx
    have hx0 : (coordinateMap A).hom x = 0 := RingHom.mem_ker.mp hxker
    apply RingHom.mem_ker.mpr
    change (GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ A weightTable.weight).hom x = 0
    rw [← coordinateMap_comp_weightTorusToBaseChangeCoordinateMap A]
    change (weightTorusToBaseChangeCoordinateMap A).hom ((coordinateMap A).hom x) = 0
    rw [hx0, map_zero]

/-- The coordinate Hopf algebra of the subgroup generated by the numbered root subgroups and the
weight torus of the type-`E₆` minuscule carrier. -/
noncomputable def generatedCoordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A 27)
    (generatedDefiningIdeal A)

/-- The generated subgroup has the quotient coordinate Hopf algebra of its defining ideal. -/
@[simp]
theorem generatedCoordinateHopfAlgebra_def :
    generatedCoordinateHopfAlgebra A =
      CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A 27)
        (generatedDefiningIdeal A) := by
  simp [generatedCoordinateHopfAlgebra]

/-- Each generator factors uniquely through the generated subgroup's coordinate quotient. -/
theorem existsUnique_generatorCoordinateMap_factor (j : Sum (Fin 6 ⊕ Fin 6) Unit) :
    ∃! g : CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A 27)
        (generatedDefiningIdeal A) ⟶ generatorCoordinateAlgebra A j,
      CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra A 27)
        (generatedDefiningIdeal A) ≫ g = generatorCoordinateMap A j := by
  rw [generatedDefiningIdeal_def]
  refine ⟨CommHopfAlgCat.commonKernelLift (generatorCoordinateMap A) j, ?_, ?_⟩
  · exact CommHopfAlgCat.mkQuotient_comp_commonKernelLift (generatorCoordinateMap A) j
  · intro g hg
    exact CommHopfAlgCat.commonKernelLift_unique (generatorCoordinateMap A) j g hg

end TauCeti.E6Minuscule
