module

public import TauCeti.Algebra.Lie.E6.Minuscule.Generated.Smooth
public import TauCeti.Algebra.Lie.E6.Minuscule.Generated.StandardComodule
public import TauCeti.Algebra.AlgebraicGroup.Unipotent.Radical.Faithful

/-!
# The unipotent radical of the generated E₆ minuscule subgroup

Over an algebraically closed field, every normal smooth unipotent closed subgroup of the subgroup
of `GL₂₇` generated by the numbered E₆ minuscule root subgroups and weight torus is trivial.
Consequently this generated subgroup has trivial unipotent radical.

The generated subgroup has reduced coordinate algebra, and its standard comodule is faithful and
simple. The generic faithful-comodule elimination theorem applies without assuming reducedness
of the specialization of the integral carrier: the subgroup generated after specialization is the
object considered here. Identifying it with that specialization or with a pinned simply connected
group scheme is a separate question.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§19 and 26.
* J. C. Jantzen, *Representations of Algebraic Groups*, I.2 and II.2.

The statements follow `TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.Generated.UnipotentRadical`
and `TauCeti.Algebra.Lie.E6.Minuscule.UnipotentRadical`, using
`TauCeti.HopfIdeal.eq_augmentation_of_isNormal_of_smoothUnipotent_of_isFaithful`.
-/

public section

namespace TauCeti.E6Minuscule

universe u

variable (k : Type u) [Field k] [IsAlgClosed k]

attribute [local instance] generatedStandardComodule

/-- Every normal smooth unipotent closed subgroup of the generated E₆ minuscule subgroup is
trivial, over an algebraically closed field in arbitrary characteristic. -/
theorem generated_eq_augmentation_of_isNormal_of_smoothUnipotent
    (I : HopfIdeal k (generatedCoordinateHopfAlgebra k)) (hI : I.IsNormal)
    (hU : smoothUnipotentCommHopfAlgProperty k
      (FiniteTypeCommHopfAlgCat.quotient (finiteTypeGeneratedCoordinateHopfAlgebra k) I)) :
    I = HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra k) := by
  let : IsReduced (generatedCoordinateHopfAlgebra k) :=
    isReduced_generatedCoordinateHopfAlgebra k
  exact HopfIdeal.eq_augmentation_of_isNormal_of_smoothUnipotent_of_isFaithful k
    (finiteTypeGeneratedCoordinateHopfAlgebra k) (Fin 27 → k)
    Comodule.isCompletelyReducible_of_isSimpleOrder (isFaithful_generatedStandardComodule k)
    I hI hU

/-- The unipotent radical of the generated E₆ minuscule subgroup over an algebraically closed
field is trivial. -/
theorem generated_unipotentRadicalDefiningIdeal_eq_augmentation :
    FiniteTypeCommHopfAlgCat.unipotentRadicalDefiningIdeal
        (finiteTypeGeneratedCoordinateHopfAlgebra k) =
      HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra k) := by
  let : IsReduced (generatedCoordinateHopfAlgebra k) :=
    isReduced_generatedCoordinateHopfAlgebra k
  exact FiniteTypeCommHopfAlgCat.unipotentRadicalDefiningIdeal_eq_augmentation_of_isFaithful k
    (finiteTypeGeneratedCoordinateHopfAlgebra k) (Fin 27 → k)
    Comodule.isCompletelyReducible_of_isSimpleOrder (isFaithful_generatedStandardComodule k)

end TauCeti.E6Minuscule
