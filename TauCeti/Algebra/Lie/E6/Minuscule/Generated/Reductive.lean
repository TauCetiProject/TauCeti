module

public import TauCeti.Algebra.AlgebraicGroup.Connected.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.Reductive.Basic
public import TauCeti.Algebra.Lie.E6.Minuscule.Generated.Connected
public import TauCeti.Algebra.Lie.E6.Minuscule.Generated.UnipotentRadical
import Mathlib.RingTheory.Etale.Descent

/-!
# Reductivity of the generated type-E₆ minuscule subgroup

Over every field `k`, the closed subgroup of `GL₂₇` generated by the numbered type-`E₆`
minuscule root subgroups and the weight torus is reductive: it is smooth and geometrically
connected, and after extension to an algebraic closure it has no nontrivial connected normal
smooth unipotent closed subgroup.

Since generation commutes with field extension
(`TauCeti.E6Minuscule.generatedCoordinateHopfAlgebraBaseChangeIso`), the geometric fibre is the
subgroup generated over the algebraic closure. Over an algebraically closed field that subgroup
is smooth, connected, and its faithful simple 27-dimensional representation eliminates every
normal smooth unipotent closed subgroup. Smoothness and geometric connectedness then descend to
`k`.

The result concerns the subgroup generated over `k`, not the base change of the integral
minuscule carrier, which contains it. Nor is the generated subgroup identified with the pinned
simply connected group scheme of type `E₆`; constructions on it transfer to that group only along
such an identification.

## Main results

* `TauCeti.E6Minuscule.reductiveCommHopfAlgProperty_generatedCoordinateHopfAlgebra`: the
  generated type-`E₆` minuscule subgroup is reductive over every field.

## References

* J. S. Milne, *Algebraic Groups* (2017), §2.h and Chapter 19.
* J. E. Humphreys, *Linear Algebraic Groups*, §§19 and 26.

The argument follows the type-`Bₙ₊₁` spin carrier in
`TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.Reductive`.
-/

public section

open CategoryTheory
open scoped TensorProduct

namespace TauCeti.E6Minuscule

universe u

variable (k : Type u) [Field k]

/-- **The generated type-`E₆` minuscule subgroup is reductive over every field.** The closed
subgroup of `GL₂₇` generated over `k` by the numbered minuscule root subgroups and the weight torus
is smooth and geometrically connected, with no nontrivial connected normal smooth unipotent closed
subgroup after extension to an algebraic closure. -/
theorem reductiveCommHopfAlgProperty_generatedCoordinateHopfAlgebra :
    reductiveCommHopfAlgProperty k
      (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra k)) := by
  let K := AlgebraicClosure k
  let e := generatedCoordinateHopfAlgebraBaseChangeIso.{u, u} k K
  have hsmooth : smoothCommHopfAlgProperty K
      (CommHopfAlgCat.baseChange (K := K) (generatedCoordinateHopfAlgebra k)) :=
    (smoothCommHopfAlgProperty K).prop_of_iso e.symm
      (smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra K)
  -- `baseChange` bundles the tensor product; `coe_of` identifies its underlying algebra.
  let _ : Algebra.Smooth K (K ⊗[k] generatedCoordinateHopfAlgebra k) := by
    simpa only [CommHopfAlgCat.baseChange, _root_.CommHopfAlgCat.coe_of] using
      (smoothCommHopfAlgProperty_iff _).mp hsmooth
  exact reductiveCommHopfAlgProperty_of_geometricFiber_iso k _
    (FiniteTypeCommHopfAlgCat.of K (generatedCoordinateHopfAlgebra K))
    (Algebra.Smooth.of_smooth_tensorProduct_of_faithfullyFlat
      (R := k) (S := generatedCoordinateHopfAlgebra k) K)
    (geometricallyConnectedCommHopfAlgProperty.of_baseChange k K _
      ((geometricallyConnectedCommHopfAlgProperty K).prop_of_iso e.symm
        (geometricallyConnectedCommHopfAlgProperty_generatedCoordinateHopfAlgebra K)))
    (ObjectProperty.isoMk _ e)
    (eq_augmentation_generated_of_isNormal_of_smoothUnipotent K)

end TauCeti.E6Minuscule
