module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.Positive.Basic

/-!
# Free base change of the generated positive doubled E₆ subgroup

The subgroup of `GL₅₄` generated by the six positive numbered root subgroups and the weight
torus on `V(ϖ₁) ⊕ V(ϖ₆)` commutes with free scalar extension, hence with every extension of
fields. The comparison respects both its ambient general-linear inclusion and restriction from
the full generated doubled carrier. It also identifies the defining ideal inside that carrier.

In particular, extension to an algebraic closure identifies the concrete positive subgroup
there with the geometric fibre of the positive subgroup over the original field. The intrinsic
ideal equation is the comparison needed to transport a proof of Borel maximality over the closure
back through `HopfIdeal.IsBorelOverAlgClosed.of_map_eq`. No maximality or identification with the
specialization of the integral toral closure is asserted here.

The generator comparisons used below hold over arbitrary commutative rings; freeness is used
only for base change of the common-kernel ideal.

## Main declarations

* `map_baseChangeHopfIdeal_definingIdeal`: transport of the ideal in general-linear coordinates.
* `coordinateHopfAlgebraBaseChangeIso`: scalar extension of the positive subgroup.
* `baseChangeMap_restriction_comp_coordinateHopfAlgebraBaseChangeIso_hom`: compatibility with
  its inclusion into the full generated carrier.
* `map_baseChangeHopfIdeal_carrierDefiningIdeal`: transport of its intrinsic defining ideal.

## References

* B. Conrad, *Reductive Group Schemes*, §1.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26–28.

The construction follows
`TauCeti.Algebra.Lie.E6.Minuscule.Generated.Positive.BaseChange`, using the doubled carrier's
generator comparisons and the common-kernel and quotient-transport API of
`TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange`.
-/

public section

open CategoryTheory

namespace TauCeti.E6DoubledMinuscule.Generated.Positive

universe v w

noncomputable section

variable (k : Type v) (K : Type max v w) [CommRing k] [CommRing K] [Algebra k K]
  [Module.Free k K]

/-- Free scalar extension carries the positive generated ideal onto the positive generated
ideal over the extension ring, under the canonical general-linear coordinate comparison. -/
@[simp]
theorem map_baseChangeHopfIdeal_definingIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (definingIdeal k)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 54).hom.hom =
      definingIdeal K := by
  apply CommHopfAlgCat.map_baseChangeHopfIdeal_commonKernelHopfIdeal
    (generator k) (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 54)
    (fun j ↦ match j with
      | .inl i => generatorCoordinateAlgebraBaseChangeIso k K (.inl (.inl i))
      | .inr u => generatorCoordinateAlgebraBaseChangeIso k K (.inr u))
    (generator K)
  rintro (i | u)
  · simpa only [generator_inl] using
      generatorCoordinateMap_baseChange k K (.inl (.inl i))
  · cases u
    simpa only [generator_inr] using generatorCoordinateMap_baseChange k K (.inr ())

/-- The base change of the positive subgroup generated over `k` is the positive subgroup
generated over `K`, for any free extension of commutative rings. -/
def coordinateHopfAlgebraBaseChangeIso :
    CommHopfAlgCat.baseChange (K := K) (coordinateHopfAlgebra k) ≅
      coordinateHopfAlgebra K :=
  CommHopfAlgCat.quotientBaseChangeIsoOfMapEq (definingIdeal k) (definingIdeal K)
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 54)
    (map_baseChangeHopfIdeal_definingIdeal k K)

/-- The positive-subgroup comparison commutes with the closed inclusion into `GL₅₄`. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := K)
        (CommHopfAlgCat.mkQuotient _ (definingIdeal k)) ≫
        (coordinateHopfAlgebraBaseChangeIso k K).hom =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 54).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal K) :=
  CommHopfAlgCat.baseChangeMap_mkQuotient_comp_quotientBaseChangeIsoOfMapEq_hom _ _ _ _

/-- The positive-subgroup comparison commutes with restriction from the full generated carrier.
Thus both subgroup inclusions are compared over the same extension ring. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_restriction_comp_coordinateHopfAlgebraBaseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := K) (restriction k) ≫
        (coordinateHopfAlgebraBaseChangeIso k K).hom =
      (generatedCoordinateHopfAlgebraBaseChangeIso k K).hom ≫ restriction K := by
  let q := CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateMap k)
  let _ : Epi q := ConcreteCategory.epi_of_surjective q
    (CommHopfAlgCat.baseChangeMap_surjective (generatedCoordinateMap k)
      (generatedCoordinateMap_surjective k))
  apply (cancel_epi q).mp
  dsimp only [q]
  rw [← Category.assoc, ← (CommHopfAlgCat.baseChangeFunctor (K := K)).map_comp,
    generatedCoordinateMap_comp_restriction,
    baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeIso_hom]
  rw [← Category.assoc,
    baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeIso_hom,
    Category.assoc, generatedCoordinateMap_comp_restriction]

/-- The full-carrier comparison carries the scalar extension of the positive subgroup's
intrinsic ideal onto its intrinsic ideal over the extension ring. -/
@[simp]
theorem map_baseChangeHopfIdeal_carrierDefiningIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (carrierDefiningIdeal k)).map
        (generatedCoordinateHopfAlgebraBaseChangeIso k K).hom.hom =
      carrierDefiningIdeal K := by
  rw [← kerOfSurjective_restriction, ← kerOfSurjective_restriction]
  apply CommHopfAlgCat.map_baseChangeHopfIdeal_kerOfSurjective
    (generatedCoordinateHopfAlgebraBaseChangeIso k K)
    (coordinateHopfAlgebraBaseChangeIso k K) (restriction_surjective k)
    (restriction_surjective K)
  rw [baseChangeMap_restriction_comp_coordinateHopfAlgebraBaseChangeIso_hom,
    Iso.inv_hom_id_assoc]

end

end TauCeti.E6DoubledMinuscule.Generated.Positive
