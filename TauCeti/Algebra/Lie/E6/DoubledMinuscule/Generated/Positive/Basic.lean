module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.Smooth
public import TauCeti.Algebra.AlgebraicGroup.Connected.Generated
import TauCeti.Algebra.AlgebraicGroup.AdditiveGroup.CoordinateBaseChange
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.SmoothConnected

/-!
# The positive subgroup of the generated doubled E₆ carrier

The six positive numbered root subgroups and the rank-six weight torus generate a closed
subgroup of the doubled minuscule carrier on `V(ϖ₁) ⊕ V(ϖ₆)`. Its coordinate algebra is the
quotient of `O(GL₅₄)` by the largest Hopf ideal killed by these seven coordinate maps.
The positive root and torus maps factor through it, and restriction from the full generated
carrier is surjective. Over every field the positive subgroup is smooth and geometrically
connected, including over imperfect fields.

This supplies the positive closed subgroup from which a Borel member of a pinning can be
constructed. Solvability and maximality are not asserted here. The subgroup is generated over
the chosen ground ring; it is not identified with the specialization of an integral positive
subgroup or with a Borel of an independently pinned simply connected E₆ group.

## Main declarations

* `coordinateHopfAlgebra`: the closed subgroup generated by the positive roots and torus.
* `restriction`: restriction of coordinates from the full generated carrier.
* `carrierDefiningIdeal`: the same subgroup's defining ideal inside that carrier.
* `le_carrierDefiningIdeal_iff`: its minimality among closed subgroups containing the generators.
* `smooth_coordinateHopfAlgebra` and `geometricallyConnected_coordinateHopfAlgebra`:
  its geometric regularity over fields.

## References

* J. S. Milne, *Algebraic Groups* (2017), §2.h and Chapter 17.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26–28.

The construction and interface follow
`TauCeti.Algebra.Lie.E7.Minuscule.Generated.Positive.Basic` and
`TauCeti.Algebra.Lie.E6.Minuscule.Generated.Positive.Basic`, using the doubled carrier's
numbered coordinate maps rather than either single minuscule summand.
-/

public section

open CategoryTheory
open TauCeti.CommHopfAlgCat
  (geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient_of_geometricallyConnected)

namespace TauCeti.E6DoubledMinuscule.Generated.Positive

universe u

noncomputable section

variable (A : Type u) [CommRing A]

/-- The coordinate algebras of the six positive numbered roots and the weight torus. -/
abbrev generatorCodomain (j : Fin 6 ⊕ Unit) : CommHopfAlgCat A :=
  generatorCoordinateAlgebra A (match j with
    | .inl i => .inl (.inl i)
    | .inr u => .inr u)

/-- The positive root and weight-torus coordinate maps into `GL₅₄`. -/
def generator : ∀ j, GeneralLinear.coordinateHopfAlgebra A 54 ⟶ generatorCodomain A j
  | .inl i => generatorCoordinateMap A (.inl (.inl i))
  | .inr u => generatorCoordinateMap A (.inr u)

@[simp]
theorem generator_inl (i : Fin 6) :
    generator A (.inl i) = generatorCoordinateMap A (.inl (.inl i)) := (rfl)

@[simp]
theorem generator_inr : generator A (.inr ()) = generatorCoordinateMap A (.inr ()) := (rfl)

/-- The largest Hopf ideal killed by the six positive root maps and the weight-torus map. -/
abbrev definingIdeal : HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A 54) :=
  CommHopfAlgCat.commonKernelHopfIdeal (generator A)

/-- The positive subgroup is the smallest closed subgroup containing the positive numbered
roots and the weight torus, expressed contravariantly on defining ideals. -/
theorem le_definingIdeal_iff (I : HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A 54)) :
    I ≤ definingIdeal A ↔
      (∀ i : Fin 6, I.toIdeal ≤ RingHom.ker
        (generatorCoordinateMap A (.inl (.inl i))).hom.toAlgHom.toRingHom) ∧
      I.toIdeal ≤ RingHom.ker (generatorCoordinateMap A (.inr ())).hom.toAlgHom.toRingHom := by
  rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  constructor
  · intro h
    exact ⟨fun i ↦ h (.inl i), h (.inr ())⟩
  · rintro ⟨hroot, htorus⟩ (i | ⟨⟩)
    · exact hroot i
    · exact htorus

/-- The full generated carrier contains the positive subgroup. -/
theorem generatedDefiningIdeal_le : generatedDefiningIdeal A ≤ definingIdeal A := by
  rw [le_definingIdeal_iff]
  have h := (le_generatedDefiningIdeal_iff A _).mp le_rfl
  exact ⟨fun i ↦ h (.inl (.inl i)), h (.inr ())⟩

/-- The coordinate Hopf algebra of the positive subgroup generated over the ground ring. -/
abbrev coordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A 54) (definingIdeal A)

/-- Restriction of the full generated carrier's coordinates to the positive subgroup. -/
def restriction : generatedCoordinateHopfAlgebra A ⟶ coordinateHopfAlgebra A :=
  generatedCoordinateDesc A (CommHopfAlgCat.mkQuotient _ (definingIdeal A)) (by
    rw [CommHopfAlgCat.mkQuotient_ker]
    exact generatedDefiningIdeal_le A)

/-- Restricting the ambient quotient coordinates recovers the positive quotient map. -/
@[reassoc (attr := simp)]
theorem generatedCoordinateMap_comp_restriction :
    generatedCoordinateMap A ≫ restriction A =
      CommHopfAlgCat.mkQuotient _ (definingIdeal A) :=
  generatedCoordinateMap_comp_generatedCoordinateDesc A _ _

/-- Restriction to the positive subgroup is surjective, so it defines a closed immersion. -/
theorem restriction_surjective : Function.Surjective (restriction A).hom := by
  have h := CommHopfAlgCat.mkQuotient_surjective
    (GeneralLinear.coordinateHopfAlgebra A 54) (definingIdeal A)
  rw [← generatedCoordinateMap_comp_restriction] at h
  exact Function.Surjective.of_comp h

/-- The positive subgroup's defining ideal inside the full generated carrier: the common
kernel of its positive numbered root and weight-torus coordinate lifts. -/
def carrierDefiningIdeal : HopfIdeal A (generatedCoordinateHopfAlgebra A) :=
  CommHopfAlgCat.commonKernelHopfIdeal fun j : Fin 6 ⊕ Unit ↦
    generatedCoordinateLift A (match j with
      | .inl i => .inl (.inl i)
      | .inr u => .inr u)

/-- The positive subgroup's defining ideal is the kernel of restriction to it. -/
theorem kerOfSurjective_restriction :
    HopfIdeal.kerOfSurjective (restriction A).hom (restriction_surjective A) =
      carrierDefiningIdeal A :=
  CommHopfAlgCat.kerOfSurjective_eq_commonKernelHopfIdeal_of_comp (generatedCoordinateMap A)
    (generatedCoordinateMap_surjective A) (generator A) _
    (by rintro (i | ⟨⟩) <;> exact generatedCoordinateMap_comp_generatedCoordinateLift A _)
    (restriction A) (generatedCoordinateMap_comp_restriction A)

/-- Membership in the positive subgroup's carrier defining ideal is equivalent to vanishing
after restriction to the positive subgroup. -/
@[simp]
theorem mem_carrierDefiningIdeal (x : generatedCoordinateHopfAlgebra A) :
    x ∈ carrierDefiningIdeal A ↔ (restriction A).hom x = 0 := by
  rw [← kerOfSurjective_restriction, HopfIdeal.mem_kerOfSurjective]

/-- The carrier's positive generators factor through the positive subgroup's generator lifts. -/
@[reassoc (attr := simp)]
theorem restriction_comp_commonKernelLift (j : Fin 6 ⊕ Unit) :
    restriction A ≫ CommHopfAlgCat.commonKernelLift (generator A) j =
      generatedCoordinateLift A (match j with
        | .inl i => .inl (.inl i)
        | .inr u => .inr u) := by
  apply generatedCoordinateLift_unique
  rw [← Category.assoc, generatedCoordinateMap_comp_restriction,
    CommHopfAlgCat.mkQuotient_comp_commonKernelLift]
  cases j <;> rfl

/-- The positive subgroup contains every positive numbered root subgroup and the weight torus. -/
theorem carrierDefiningIdeal_toIdeal_le_ker_generatedCoordinateLift (j : Fin 6 ⊕ Unit) :
    (carrierDefiningIdeal A).toIdeal ≤ RingHom.ker
      (generatedCoordinateLift A (match j with
        | .inl i => .inl (.inl i)
        | .inr u => .inr u)).hom.toAlgHom.toRingHom :=
  CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker _ j

/-- A closed subgroup of the full generated carrier contains the positive subgroup exactly
when it contains the six positive numbered root subgroups and the weight torus. -/
theorem le_carrierDefiningIdeal_iff (I : HopfIdeal A (generatedCoordinateHopfAlgebra A)) :
    I ≤ carrierDefiningIdeal A ↔
      ∀ j : Fin 6 ⊕ Unit, I.toIdeal ≤ RingHom.ker
        (generatedCoordinateLift A (match j with
          | .inl i => .inl (.inl i)
          | .inr u => .inr u)).hom.toAlgHom.toRingHom :=
  CommHopfAlgCat.le_commonKernelHopfIdeal_iff _ I

variable (k : Type u) [Field k]

/-- The positive subgroup generated over any field is smooth, including over imperfect fields. -/
theorem smooth_coordinateHopfAlgebra :
    smoothCommHopfAlgProperty k (coordinateHopfAlgebra k) := by
  let : ∀ j, Algebra.IsGeometricallyReduced k (generatorCodomain k j) := by
    rintro (i | ⟨⟩)
    · exact isGeometricallyReduced_generatorCoordinateAlgebra k (.inl (.inl i))
    · exact isGeometricallyReduced_generatorCoordinateAlgebra k (.inr ())
  exact
    CommHopfAlgCat.smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal_of_geometricallyReduced
      (generator k)

/-- The positive subgroup generated over any field is geometrically connected. -/
theorem geometricallyConnected_coordinateHopfAlgebra :
    geometricallyConnectedCommHopfAlgProperty k (coordinateHopfAlgebra k) := by
  apply geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient_of_geometricallyConnected
    (generator k)
  rintro (i | ⟨⟩)
  · exact AdditiveGroup.geometricallyConnectedCommHopfAlgProperty_coordinateHopfAlgebra k
  · exact DiagonalizableGroup.geometricallyConnected_coordinateRing k
      (SplitTorus.characterGroup (Fin 6))

end

end TauCeti.E6DoubledMinuscule.Generated.Positive
