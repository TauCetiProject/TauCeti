module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.WeightTorus
public import TauCeti.Algebra.AlgebraicGroup.Torus.Maximal
import TauCeti.Algebra.Lie.E6.DoubledMinuscule.MaximalTorus
import TauCeti.Algebra.Lie.E6.DoubledMinuscule.StandardComodule
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Separation
import TauCeti.Algebra.AlgebraicGroup.Torus.SmoothConnected

/-!
# The maximal torus of the generated doubled E₆ group

The closed rank-six weight torus is a maximal torus of the subgroup generated by the
numbered roots and torus of `V(ϖ₁) ⊕ V(ϖ₆)`, over every field. Over an algebraically closed
field, any reduced commutative closed subgroup containing this torus equals it. Its points
embed into the specialized integral carrier, whose weight torus is its own centralizer.
Point separation then identifies the closed subgroups, and maximality over an arbitrary
field follows by descent from its algebraic closure.

The main result is `isMaximalTorus_weightTorusDefiningIdeal`. This supplies the maximal-torus
condition for a pinning of the generated group. It does not identify that group with the
specialization of the integral carrier or with an independently pinned simply connected group.

## References

* J. S. Milne, *Algebraic Groups* (2017), Chapters 3 and 17.
* The point-separation and descent argument adapts
  `TauCeti.Algebra.Lie.D4.Tripled.Generated.MaximalTorus`.
* The pointwise self-centralization theorem is
  `TauCeti.E6DoubledMinuscule.centralizer_range_weightTorusPoints_eq_range`.
-/

public section

open CategoryTheory

namespace TauCeti.E6DoubledMinuscule.Generated

universe u

noncomputable section

variable (k : Type u) [Field k]

-- Only the inclusion in the integral specialization is used, not equality of the carriers.
private def carrierRestriction : coordinateHopfAlgebra k ⟶ generatedCoordinateHopfAlgebra k :=
  CommHopfAlgCat.liftQuotient (baseChangeDefiningIdeal k) (generatedCoordinateMap k) (by
    intro x hx
    have hmem : x ∈ (generatedDefiningIdeal k).toIdeal :=
      baseChangeDefiningIdeal_le_generatedDefiningIdeal k hx
    rw [← generatedCoordinateMap_ker] at hmem
    exact hmem)

private theorem coordinateMap_comp_carrierRestriction :
    CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra k 54)
        (baseChangeDefiningIdeal k) ≫ carrierRestriction k = generatedCoordinateMap k := by
  unfold carrierRestriction
  exact CommHopfAlgCat.mkQuotient_comp_liftQuotient _ _ _

private def carrierPointsHom :
    HopfAlgebra.points (R := k) (H := generatedCoordinateHopfAlgebra k) (CommAlgCat.of k k) →*
      points k :=
  (specializedPointsMulEquiv k).toMonoidHom.comp
    ((CommHopfAlgCat.Hom.mapPointsFunctor (carrierRestriction k)).app (CommAlgCat.of k k)).hom

private theorem coe_carrierPointsHom
    (g : HopfAlgebra.points (R := k) (H := generatedCoordinateHopfAlgebra k)
      (CommAlgCat.of k k)) :
    (carrierPointsHom k g : Matrix.GeneralLinearGroup (Fin 54) k) =
      GeneralLinear.pointsMulEquiv 54
        ((CommHopfAlgCat.Hom.mapPointsFunctor (generatedCoordinateMap k)).app
          (CommAlgCat.of k k) g) := by
  let q := (CommHopfAlgCat.Hom.mapPointsFunctor (carrierRestriction k)).app (CommAlgCat.of k k) g
  have h := quotientPointsHom_specializedPointsMulEquiv_symm k (specializedPointsMulEquiv k q)
  -- The categorical point object and the explicit convolution-point type have different
  -- wrappers; `erw` reconciles them when cancelling the point equivalence.
  erw [MulEquiv.symm_apply_apply] at h
  have hmatrix := congrArg (GeneralLinear.pointsMulEquiv (R := k) 54) h
  rw [MulEquiv.apply_symm_apply] at hmatrix
  -- The composite point map is the ambient quotient point, by the quotient's universal property.
  have hq := CommHopfAlgCat.mapPointsFunctor_eq_quotientPointsHom_of_mkQuotient_comp
    (baseChangeDefiningIdeal k) (carrierRestriction k) (generatedCoordinateMap k)
    (coordinateMap_comp_carrierRestriction k) (CommAlgCat.of k k) g
  exact hmatrix.symm.trans (congrArg (GeneralLinear.pointsMulEquiv 54) hq.symm)

private theorem carrierPointsHom_injective : Function.Injective (carrierPointsHom k) := by
  intro g h heq
  apply CommHopfAlgCat.Hom.mapPointsFunctor_app_injective_of_surjective
    (generatedCoordinateMap k) (generatedCoordinateMap_surjective k) (CommAlgCat.of k k)
  apply (GeneralLinear.pointsMulEquiv 54).injective
  rw [← coe_carrierPointsHom, ← coe_carrierPointsHom, heq]

private theorem map_torus_carrierPointsHom :
    (CommHopfAlgCat.quotientPointsSubgroup (generatedCoordinateHopfAlgebra k)
        (weightTorusDefiningIdeal k) (CommAlgCat.of k k)).map (carrierPointsHom k) =
      (weightTorusPoints k).range := by
  apply Subgroup.map_injective (points k).subtype_injective
  have hcomp : (points k).subtype.comp (carrierPointsHom k) =
      (GeneralLinear.pointsMulEquiv 54).toMonoidHom.comp
        ((CommHopfAlgCat.Hom.mapPointsFunctor (generatedCoordinateMap k)).app
          (CommAlgCat.of k k)).hom := MonoidHom.ext (coe_carrierPointsHom k)
  rw [Subgroup.map_map, hcomp]
  -- The underlying algebra of `CommAlgCat.of k k` is `k`, so the matrix subgroups agree.
  exact map_quotientPointsSubgroup_weightTorusDefiningIdeal k (CommAlgCat.of k k)

/-- Over an algebraically closed field, every reduced commutative closed subgroup containing
the generated doubled E₆ weight torus is that torus. -/
theorem eq_weightTorusDefiningIdeal_of_le_of_isCocomm [IsAlgClosed k]
    (I : HopfIdeal k (generatedCoordinateHopfAlgebra k))
    [IsReduced (CommHopfAlgCat.quotient (generatedCoordinateHopfAlgebra k) I)]
    [Coalgebra.IsCocomm k (CommHopfAlgCat.quotient (generatedCoordinateHopfAlgebra k) I)]
    (hI : I ≤ weightTorusDefiningIdeal k) : I = weightTorusDefiningIdeal k := by
  let H := generatedCoordinateHopfAlgebra k
  let A := CommAlgCat.of k k
  let GI := CommHopfAlgCat.quotientPointsSubgroup H I A
  let GT := CommHopfAlgCat.quotientPointsSubgroup H (weightTorusDefiningIdeal k) A
  let _ : IsMulCommutative GI :=
    CommHopfAlgCat.instIsMulCommutativeQuotientPointsSubgroup H I A
  let _ : IsMulCommutative (GI.map (carrierPointsHom k)) :=
    Subgroup.map_isMulCommutative GI (carrierPointsHom k)
  have hTG : GT ≤ GI := CommHopfAlgCat.quotientPointsSubgroup_le_of_le H hI A
  have hmap : GI.map (carrierPointsHom k) = GT.map (carrierPointsHom k) := by
    rw [map_torus_carrierPointsHom]
    apply eq_range_weightTorusPoints_of_le_of_isMulCommutative
    rw [← map_torus_carrierPointsHom k]
    exact Subgroup.map_mono hTG
  have hpoints : GI = GT := Subgroup.map_injective (carrierPointsHom_injective k) hmap
  exact le_antisymm hI (HopfIdeal.le_of_quotientPointsSubgroup_le hpoints.le)

private theorem isMaximalTorus_weightTorusDefiningIdeal_of_isAlgClosed [IsAlgClosed k] :
    HopfIdeal.IsMaximalTorus k (generatedCoordinateHopfAlgebra k)
      (weightTorusDefiningIdeal k) := by
  rw [HopfIdeal.isMaximalTorus_iff]
  refine ⟨(splitTorusCommHopfAlgProperty_quotient_weightTorusDefiningIdeal k).torus k _, ?_⟩
  intro I hI hIT
  let _ : IsReduced (CommHopfAlgCat.quotient (generatedCoordinateHopfAlgebra k) I) :=
    hI.geometricallyReduced.isReduced
  let _ : Coalgebra.IsCocomm k
      (CommHopfAlgCat.quotient (generatedCoordinateHopfAlgebra k) I) := hI.isCocomm k _
  exact (eq_weightTorusDefiningIdeal_of_le_of_isCocomm k I hIT).ge

/-- Over every field, the closed rank-six weight torus is a maximal torus of the generated
doubled E₆ group, with no characteristic restriction or assumption on the integral carrier. -/
theorem isMaximalTorus_weightTorusDefiningIdeal :
    HopfIdeal.IsMaximalTorus k (generatedCoordinateHopfAlgebra k)
      (weightTorusDefiningIdeal k) :=
  HopfIdeal.isMaximalTorus_of_baseChange (weightTorusDefiningIdeal k)
    (weightTorusDefiningIdeal (AlgebraicClosure k))
    (generatedCoordinateHopfAlgebraBaseChangeIso k (AlgebraicClosure k))
    ((splitTorusCommHopfAlgProperty_quotient_weightTorusDefiningIdeal k).torus k _)
    (map_baseChange_weightTorusDefiningIdeal k (AlgebraicClosure k))
    (isMaximalTorus_weightTorusDefiningIdeal_of_isAlgClosed (AlgebraicClosure k))

end

end TauCeti.E6DoubledMinuscule.Generated
