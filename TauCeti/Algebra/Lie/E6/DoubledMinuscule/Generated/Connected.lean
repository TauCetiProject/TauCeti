module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.Basic
public import TauCeti.Algebra.AlgebraicGroup.Connected.Generated
import Mathlib.LinearAlgebra.SymmetricAlgebra.Basis
import Mathlib.Algebra.MonoidAlgebra.NoZeroDivisors
import Mathlib.RingTheory.Spectrum.Prime.Topology
import Mathlib.Topology.Connected.Basic

/-!
# Connectedness of the generated doubled type-E₆ subgroup

The numbered root subgroups and the weight torus of the doubled minuscule carrier generate a
closed subgroup of `GL₅₄`. Over an algebraically closed field this subgroup is connected: the
coordinate algebras of its generators have connected spectra, and the closed subgroup they
generate inherits this property. This supplies the connectedness input for recognizing the
explicit carrier as a pinned split group of type `E₆`.

The integral carrier is presently known to contain the generated subgroup. The result here
concerns the generated subgroup; identifying it with the integral carrier after base change
requires a separate comparison.

## References

* J. S. Milne, *Algebraic Groups* (2017), Propositions 2.37 and 2.48.
* R. Steinberg, *Lectures on Chevalley Groups*, Section 3.
* `TauCeti.Algebra.AlgebraicGroup.Connected.Generated`, connectedness of common-kernel quotients.
* `TauCeti.Algebra.Lie.D4.Tripled.GeneratedConnected`, the analogous result for the tripled
  type-`D₄` generated subgroup.
-/

public section

namespace TauCeti.E6DoubledMinuscule

open CategoryTheory

universe u

variable (k : Type u) [Field k]

private theorem connectedSpace_generatorCoordinateAlgebra :
    ∀ j, ConnectedSpace (PrimeSpectrum (generatorCoordinateAlgebra k j)) := by
  intro j
  -- The generator coordinate objects have, definitionally, the additive group's symmetric
  -- algebra and the torus's monoid algebra as carriers. Exposing these rings lets typeclass
  -- synthesis use their connected-spectrum instances.
  cases j with
  | inl _ =>
    change ConnectedSpace (PrimeSpectrum (SymmetricAlgebra k k))
    infer_instance
  | inr _ =>
    change ConnectedSpace (PrimeSpectrum
      (MonoidAlgebra k (SplitTorus.characterGroup (Fin 6))))
    infer_instance

/-- The closed subgroup generated by the doubled type-`E₆` numbered root subgroups and weight
torus is geometrically connected over an algebraically closed field. -/
theorem geometricallyConnectedCommHopfAlgProperty_generatedCoordinateHopfAlgebra
    [IsAlgClosed k] :
    geometricallyConnectedCommHopfAlgProperty k (generatedCoordinateHopfAlgebra k) := by
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact CommHopfAlgCat.geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient
    (generatorCoordinateMap k) (connectedSpace_generatorCoordinateAlgebra k)

end TauCeti.E6DoubledMinuscule
