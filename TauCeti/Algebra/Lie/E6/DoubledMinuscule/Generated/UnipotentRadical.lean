module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.StandardComodule
public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.Smooth
public import TauCeti.Algebra.AlgebraicGroup.Unipotent.Radical.Faithful
import TauCeti.Algebra.AlgebraicGroup.Unipotent.Radical.BaseChange
import TauCeti.Algebra.AlgebraicGroup.Unipotent.Radical.Isomorphism

/-!
# Triviality of the generated doubled E₆ subgroup's unipotent radical

Over an algebraically closed field, the subgroup of `GL₅₄` generated by the doubled minuscule
root subgroups and weight torus has no nontrivial normal smooth unipotent closed subgroup, and
over every field its unipotent radical is trivial. Its standard comodule is faithful and
completely reducible, and its coordinate algebra is reduced by the reducedness theorem for
generated subgroups. No reducedness hypothesis remains.

This concerns the subgroup generated over the field, not the specialization of the integral
toral closure. An identification between these subgroup schemes is needed to transfer this
conclusion to that carrier. Identification with the pinned simply connected group of type `E₆`
is also not asserted.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§19 and 26.
* J. C. Jantzen, *Representations of Algebraic Groups*, I.2 and II.2.

The elimination argument follows
`TauCeti.Algebra.Lie.E6.Minuscule.Generated.UnipotentRadical` and
`TauCeti.Algebra.Lie.E6.DoubledMinuscule.UnipotentRadical`, using
`TauCeti.HopfIdeal.eq_augmentation_of_isNormal_of_smoothUnipotent_of_isFaithful`.
-/

public section

namespace TauCeti.E6DoubledMinuscule

open CategoryTheory

universe u

noncomputable section

variable (k : Type u) [Field k] [IsAlgClosed k]

attribute [local instance] generatedStandardComodule

/-- Every normal smooth unipotent closed subgroup of the subgroup generated over the field by
the doubled minuscule root subgroups and weight torus is trivial. -/
theorem eq_augmentation_generated_of_isNormal_of_smoothUnipotent
    (I : HopfIdeal k (generatedCoordinateHopfAlgebra k)) (hI : I.IsNormal)
    (hU : smoothUnipotentCommHopfAlgProperty k
      (FiniteTypeCommHopfAlgCat.quotient
        (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra k)) I)) :
    I = HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra k) := by
  let _ := isReduced_generatedCoordinateHopfAlgebra k
  exact HopfIdeal.eq_augmentation_of_isNormal_of_smoothUnipotent_of_isFaithful k
    (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra k)) (Fin 54 → k)
    (isCompletelyReducible_generatedStandardComodule k)
    (isFaithful_generatedStandardComodule k) I hI hU

/-- Over an algebraically closed field, the unipotent radical of the subgroup generated by the
doubled minuscule root subgroups and weight torus is trivial. -/
private theorem unipotentRadicalDefiningIdeal_generated_eq_augmentation_of_isAlgClosed :
    FiniteTypeCommHopfAlgCat.unipotentRadicalDefiningIdeal
        (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra k)) =
      HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra k) := by
  let _ := isReduced_generatedCoordinateHopfAlgebra k
  exact FiniteTypeCommHopfAlgCat.unipotentRadicalDefiningIdeal_eq_augmentation_of_isFaithful k
    (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra k)) (Fin 54 → k)
    (isCompletelyReducible_generatedStandardComodule k) (isFaithful_generatedStandardComodule k)

open FiniteTypeCommHopfAlgCat in
omit [IsAlgClosed k] in
/-- The unipotent radical of the subgroup generated over a field by the doubled minuscule root
subgroups and weight torus is trivial. -/
theorem unipotentRadicalDefiningIdeal_generated_eq_augmentation :
    FiniteTypeCommHopfAlgCat.unipotentRadicalDefiningIdeal
        (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra k)) =
      HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra k) := by
  let K := AlgebraicClosure k
  let e : (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra k)).baseChange (K := K) ≅
      FiniteTypeCommHopfAlgCat.of K (generatedCoordinateHopfAlgebra K) :=
    ObjectProperty.isoMk _ (generatedCoordinateHopfAlgebraBaseChangeIso.{u, u} k K)
  apply unipotentRadicalDefiningIdeal_eq_augmentation_of_baseChange_eq_augmentation
    (K := K)
  rw [← FiniteTypeCommHopfAlgCat.comapOfSurjective_unipotentRadicalDefiningIdeal e,
    unipotentRadicalDefiningIdeal_generated_eq_augmentation_of_isAlgClosed,
    HopfIdeal.comapOfSurjective_augmentation]

end

end TauCeti.E6DoubledMinuscule
