module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.WeightTorus
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Weight.Differential
public import TauCeti.Algebra.AlgebraicGroup.SplitTorus.Cocharacter
public import TauCeti.Algebra.AlgebraicGroup.SplitTorus.Tangent
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.Assembly

/-!
# Simple-coroot differentials in the generated doubled E₆ group

The fundamental-weight coordinates of the closed weight torus give actual simple-coroot
cocharacters of the group generated by the roots and torus of `V(ϖ₁) ⊕ V(ϖ₆)`. Their
differentials are diagonal matrices of weight–coroot pairings in the faithful matrix
representation. They form an independent basis of the toral tangent image over every
commutative coefficient algebra, including in characteristic three. No Cartan determinant
is inverted.

This supplies the toral normalization for comparing the numbered root datum with the
Lie algebra of the generated group. It does not identify these vectors with opposite-root
brackets, assert maximality of the torus, or identify the generated group with either the
specialized integral carrier or an independently pinned simply connected group.

## Main declarations

* `generatedCorootCocharacter`: the actual numbered simple-coroot cocharacters.
* `tangentMatrix_derivationComp_generatedCorootCocharacter`: their represented differentials.
* `generatedCorootDifferential`: their normalized tangent vectors.
* `range_derivationCompLieHom_generatedWeightTorusCoordinateMap_eq_span`: the toral tangent image.
* `generatedCorootBasis`: its basis of independent simple-coroot differentials.

## References

* B. Conrad, *Reductive Group Schemes* (2014), §5.1.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Plate V.

The cocharacter and tangent-basis interface follows
`TauCeti.Algebra.Lie.E7.Minuscule.Generated.Coroot`, using the generated doubled carrier's
closed weight torus and the general represented weight-torus differential formula.
-/

public section

open CategoryTheory

namespace TauCeti.E6DoubledMinuscule

noncomputable section

variable (R : Type*) [CommRing R]

/-- The simple-coroot cocharacter obtained by evaluating the corresponding
fundamental-weight coordinate of the generated group's weight torus. -/
def generatedCorootCocharacter (i : Fin 6) :
    generatedCoordinateHopfAlgebra R →ₐc[R] LaurentPolynomial R :=
  (generatedWeightTorusCoordinateMap R).hom.cocharacter
    (Finsupp.applyAddHom i).toMultiplicative

/-- The cocharacter evaluates the `i`-th fundamental-weight coordinate. -/
theorem generatedCorootCocharacter_def (i : Fin 6) :
    generatedCorootCocharacter R i =
      (generatedWeightTorusCoordinateMap R).hom.cocharacter
        (Finsupp.applyAddHom i).toMultiplicative :=
  (rfl)

/-- The coordinate cocharacter is the Bourbaki-numbered simple coroot of the named
simply connected E₆ datum. -/
theorem generatedCorootCocharacter_eq_cocharacter_coroot_simpleIndex
    (ht : DynkinType.E6.Valid) (i : Fin 6) :
    generatedCorootCocharacter R i =
      (generatedWeightTorusCoordinateMap R).hom.cocharacter
        (SplitTorus.cocharEquiv.symm
          ((DynkinType.E6.simplyConnectedRootDatum ht).coroot
            (DynkinType.E6.simpleIndex ht i))) := by
  rw [generatedCorootCocharacter_def]
  congr 1
  apply SplitTorus.cocharEquiv.eq_symm_apply.mpr
  rw [SplitTorus.cocharEquiv_applyAddHom]
  -- The named datum uses `Fin E6.rank`; its fundamental-weight coordinates are `Fin 6`.
  exact (DynkinType.E6.coroot_simpleIndex ht i).symm

variable {B : Type*} [CommRing B] [Algebra R B]

/-- The represented differential of a simple coroot is diagonal, with entries given by
its pairings with the doubled minuscule weights, times the multiplicative tangent parameter. -/
@[simp↓]
theorem tangentMatrix_derivationComp_generatedCorootCocharacter (i : Fin 6)
    (d : Derivation R (LaurentPolynomial R)
      (Bialgebra.CounitAlgebra R (LaurentPolynomial R) B)) :
    GeneralLinear.tangentMatrix 54
        (derivationComp (generatedCoordinateMap R).hom
          (derivationComp (generatedCorootCocharacter R i) d)) =
      Matrix.diagonal (fun a ↦ matrixWeight a i •
        MultiplicativeGroup.tangentLinearEquiv d) := by
  have hπ : (generatedWeightTorusCoordinateMap R).hom.comp (generatedCoordinateMap R).hom =
      GeneralLinear.weightTorusCoordinateBialgHom (S := R) matrixWeight := by
    rw [← _root_.CommHopfAlgCat.hom_comp,
      generatedCoordinateMap_comp_generatedWeightTorusCoordinateMap,
      GeneralLinear.hom_weightTorusBaseChangeCoordinateMap]
  rw [generatedCorootCocharacter_def,
    GeneralLinear.tangentMatrix_derivationComp_cocharacter_of_weightTorus _ _ _ hπ]
  simp only [AddMonoidHom.coe_toMultiplicative, Function.comp_apply, toAdd_ofAdd,
    Finsupp.applyAddHom_apply, Finsupp.equivFunOnFinite_symm_apply_apply]

/-- The normalized differential of the numbered simple-coroot cocharacter, with values in
any commutative coefficient algebra. The tangent parameter of `𝔾ₘ` is one. -/
def generatedCorootDifferential (i : Fin 6) :
    Derivation R (generatedCoordinateHopfAlgebra R)
      (Bialgebra.CounitAlgebra R (generatedCoordinateHopfAlgebra R) B) :=
  derivationComp (generatedCorootCocharacter R i)
    (MultiplicativeGroup.tangentLinearEquiv.symm (1 : B))

/-- The normalized simple-coroot differential uses the unit multiplicative tangent vector. -/
theorem generatedCorootDifferential_def (i : Fin 6) :
    generatedCorootDifferential R (B := B) i =
      derivationComp (generatedCorootCocharacter R i)
        (MultiplicativeGroup.tangentLinearEquiv.symm (1 : B)) :=
  (rfl)

/-- The normalized differential has the integral weight coordinates on its diagonal. -/
@[simp↓]
theorem tangentMatrix_generatedCorootDifferential (i : Fin 6) :
    GeneralLinear.tangentMatrix 54
        (derivationComp (generatedCoordinateMap R).hom
          (generatedCorootDifferential R (B := B) i)) =
      Matrix.diagonal (fun a ↦ (matrixWeight a i : B)) := by
  rw [generatedCorootDifferential_def,
    tangentMatrix_derivationComp_generatedCorootCocharacter]
  simp only [LinearEquiv.apply_symm_apply, zsmul_one]

/-- The weight-torus differential sends a coordinate tangent vector to its simple-coroot
differential. -/
@[simp↓]
theorem derivationCompLieHom_generatedWeightTorusCoordinateMap_tangentBasis (i : Fin 6) :
    derivationCompLieHom (B := B) (generatedWeightTorusCoordinateMap R).hom
        (SplitTorus.tangentBasis (R := R) (B := B) i) =
      generatedCorootDifferential R i := by
  rw [SplitTorus.derivationCompLieHom_tangentBasis,
    generatedCorootDifferential_def, generatedCorootCocharacter_def, derivationCompLieHom_apply]

/-- The toral tangent image is exactly the span of the normalized simple-coroot differentials. -/
theorem range_derivationCompLieHom_generatedWeightTorusCoordinateMap_eq_span :
    LinearMap.range
        (derivationCompLieHom (B := B) (generatedWeightTorusCoordinateMap R).hom).toLinearMap =
      Submodule.span B (Set.range (generatedCorootDifferential R (B := B))) := by
  simpa only [derivationCompLieHom_apply, ← generatedCorootCocharacter_def R,
    ← generatedCorootDifferential_def R] using
    SplitTorus.range_derivationCompLieHom (B := B) (generatedWeightTorusCoordinateMap R).hom

/-- The closed weight torus has injective differential over every coefficient algebra. -/
theorem derivationCompLieHom_generatedWeightTorusCoordinateMap_injective :
    Function.Injective
      (derivationCompLieHom (B := B) (generatedWeightTorusCoordinateMap R).hom) :=
  derivationCompLieHom_injective_of_surjective _ (generatedWeightTorusCoordinateMap_surjective R)

/-- The numbered simple-coroot differentials are independent, without restrictions on the
characteristic or reducedness of the coefficient algebra. -/
theorem linearIndependent_generatedCorootDifferential :
    LinearIndependent B (generatedCorootDifferential R (B := B)) := by
  simpa only [derivationCompLieHom_apply, ← generatedCorootCocharacter_def R,
    ← generatedCorootDifferential_def R] using
    SplitTorus.linearIndependent_derivationComp_cocharacter
      (B := B) (generatedWeightTorusCoordinateMap R).hom
      (derivationCompLieHom_generatedWeightTorusCoordinateMap_injective R)

/-- The normalized simple-coroot differentials form a basis of their span,
the tangent image of the closed weight torus. -/
def generatedCorootBasis : Module.Basis (Fin 6) B
    (Submodule.span B (Set.range (generatedCorootDifferential R (B := B)))) :=
  Module.Basis.span (linearIndependent_generatedCorootDifferential R)

/-- Including a simple-coroot basis vector gives its normalized differential. -/
@[simp]
theorem coe_generatedCorootBasis (i : Fin 6) :
    (generatedCorootBasis R (B := B) i :
      Derivation R (generatedCoordinateHopfAlgebra R)
        (Bialgebra.CounitAlgebra R (generatedCoordinateHopfAlgebra R) B)) =
      generatedCorootDifferential R i :=
  Module.Basis.coe_span_apply (linearIndependent_generatedCorootDifferential R) i

end

end TauCeti.E6DoubledMinuscule
