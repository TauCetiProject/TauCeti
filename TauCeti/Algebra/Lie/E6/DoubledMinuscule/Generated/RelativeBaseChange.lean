module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.Basic
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange

/-!
# Base change of the generated doubled type-E₆ subgroup

The subgroup generated by the numbered root subgroups and weight torus of the doubled
type-`E₆` minuscule representation commutes with free scalar extension. In particular, this
identifies the subgroup generated over a field extension with the scalar extension of the subgroup
over the base field. The comparison is compatible with the closed immersions into the corresponding
general linear groups.

This is a statement about the generated subgroup. It does not identify that subgroup with the
base change of the integral toral-closure carrier, whose defining ideal is only known to be
contained in the generated subgroup's defining ideal over general coefficient rings.

## References

* B. Conrad, *Reductive Group Schemes*, §1.
* R. W. Carter, *Simple Groups of Lie Type*, §4.4.
* `TauCeti.Algebra.Lie.E6.Minuscule.Generated.Basic`, the corresponding comparison for the
  minuscule type-`E₆` representation.
-/

public section

open CategoryTheory

namespace TauCeti.E6DoubledMinuscule

universe u v

variable (k : Type u) (K : Type max u v) [CommRing k] [CommRing K] [Algebra k K]

/-- Scalar extension of a generator's coordinate Hopf algebra is the corresponding generator over
the extended coefficient ring. -/
noncomputable def generatorCoordinateAlgebraBaseChangeIso
    (j : Sum (Fin 6 ⊕ Fin 6) Unit) :
    CommHopfAlgCat.baseChange (K := K) (generatorCoordinateAlgebra k j) ≅
      generatorCoordinateAlgebra K j :=
  match j with
  | .inl _ => AdditiveGroup.coordinateHopfAlgebraBaseChangeIso k K
  | .inr _ => _root_.CommHopfAlgCat.isoMk
      (TauCeti.MonoidAlgebra.scalarTensorBialgEquiv k K
        (G := SplitTorus.characterGroup (Fin 6)))

/-- Each numbered root or torus generator over `K` is the scalar extension of the corresponding
generator over `k`, under the canonical coordinate identifications. -/
theorem generatorCoordinateMap_baseChange (j : Sum (Fin 6 ⊕ Fin 6) Unit) :
    ((GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 54).inv ≫
        CommHopfAlgCat.baseChangeMap (generatorCoordinateMap k j)) ≫
        (generatorCoordinateAlgebraBaseChangeIso k K j).hom =
      generatorCoordinateMap K j := by
  rcases j with j | _
  · rw [Category.assoc, generatorCoordinateMap_inl, generatorCoordinateMap_inl]
    exact
      UniversalEnvelopingAlgebra.kostantRootSubgroupBaseChangePresentationCoordinateMap_baseChange
        _ _ _ _ _ _ _ k K j
  · rw [Category.assoc, generatorCoordinateMap_inr, generatorCoordinateMap_inr]
    exact GeneralLinear.weightTorusBaseChangeCoordinateMap_baseChange ℤ k K _

/-- For a free extension `K/k`, the common-kernel ideal of the generators over `k` extends to the
common-kernel ideal of the generators over `K`. -/
theorem map_baseChangeHopfIdeal_generatedDefiningIdeal [Module.Free k K] :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (generatedDefiningIdeal k)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 54).hom.hom =
      generatedDefiningIdeal K := by
  rw [generatedDefiningIdeal_def, generatedDefiningIdeal_def,
    CommHopfAlgCat.baseChangeHopfIdeal_commonKernelHopfIdeal,
    CommHopfAlgCat.map_commonKernelHopfIdeal, ← funext (generatorCoordinateMap_baseChange k K),
    CommHopfAlgCat.commonKernelHopfIdeal_comp_of_injective _ _ fun j ↦
      (ConcreteCategory.bijective_of_isIso (generatorCoordinateAlgebraBaseChangeIso k K j).hom).1]

/-- For a free extension `K/k`, the subgroup generated by the doubled type-`E₆` roots and torus
over `K` is the scalar extension of the subgroup generated over `k`. -/
noncomputable def generatedCoordinateHopfAlgebraBaseChangeIso [Module.Free k K] :
    CommHopfAlgCat.baseChange (K := K) (generatedCoordinateHopfAlgebra k) ≅
      generatedCoordinateHopfAlgebra K :=
  eqToIso (congrArg (CommHopfAlgCat.baseChange (K := K))
      (generatedCoordinateHopfAlgebra_def k)) ≪≫
    CommHopfAlgCat.quotientBaseChangeIsoOfMapEq
      (generatedDefiningIdeal k) (generatedDefiningIdeal K)
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 54)
      (map_baseChangeHopfIdeal_generatedDefiningIdeal k K) ≪≫
    eqToIso (generatedCoordinateHopfAlgebra_def K).symm

/-- The base-change isomorphism intertwines the generated subgroup's coordinate maps into the
general linear groups. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeIso_hom
    [Module.Free k K] :
    CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateMap k) ≫
        (generatedCoordinateHopfAlgebraBaseChangeIso k K).hom =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K 54).hom ≫
        generatedCoordinateMap K := by
  have hbase :
      CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateMap k) ≫
          (eqToIso (congrArg (CommHopfAlgCat.baseChange (K := K))
            (generatedCoordinateHopfAlgebra_def k))).hom =
        CommHopfAlgCat.baseChangeMap (K := K)
          (CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra k 54)
            (generatedDefiningIdeal k)) := by
    let F := CommHopfAlgCat.baseChangeFunctor (k := k) (K := K)
    calc
      _ = F.map (generatedCoordinateMap k) ≫
          F.map (eqToIso (generatedCoordinateHopfAlgebra_def k)).hom := by
        rw [CommHopfAlgCat.baseChangeFunctor_map]
        congr 1
        simpa only [eqToIso.hom] using
          (eqToHom_map F (generatedCoordinateHopfAlgebra_def k)).symm
      _ = F.map (generatedCoordinateMap k ≫
          (eqToIso (generatedCoordinateHopfAlgebra_def k)).hom) :=
        (F.map_comp _ _).symm
      _ = F.map (CommHopfAlgCat.mkQuotient
          (GeneralLinear.coordinateHopfAlgebra k 54) (generatedDefiningIdeal k)) := by
        rw [generatedCoordinateMap_comp_eqToIso_hom]
      _ = _ := CommHopfAlgCat.baseChangeFunctor_map _
  simp only [generatedCoordinateHopfAlgebraBaseChangeIso, Iso.trans_hom]
  rw [← Category.assoc, hbase, ← Category.assoc,
    CommHopfAlgCat.baseChangeMap_mkQuotient_comp_quotientBaseChangeIsoOfMapEq_hom,
    Category.assoc, ← generatedCoordinateMap_comp_eqToIso_hom K]
  simp

end TauCeti.E6DoubledMinuscule
