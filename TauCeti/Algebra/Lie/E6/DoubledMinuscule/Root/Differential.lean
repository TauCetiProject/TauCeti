module

public import TauCeti.Algebra.AlgebraicGroup.AdditiveGroup.Differential
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Tangent
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Tangent
public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.ClosedRootSubgroup
public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.IntegralMatrix
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent

/-!
# Integral root differentials of the doubled minuscule E₆ carrier

The twelve numbered root-subgroup differentials of the integral carrier on
`V(ϖ₁) ⊕ V(ϖ₆)` send the additive unit tangent vector to its represented integral root
operator. Each differential is injective and its image is the line generated by that
normalized vector, with values in every commutative ring, including nonreduced rings.
Coefficient change preserves the normalization.

These are the differential normalization equations needed to compare root parametrizations
with root vectors in a pinning. No assertion that these lines exhaust adjoint weight spaces,
that the chosen torus is maximal, or that the carrier has a Borel or a complete pinning is made.

The matrix calculation uses the general Kostant root-subgroup tangent theorem in
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent`.
The root-vector interface follows
`TauCeti.Algebra.AlgebraicGroup.Symplectic.RootSubgroup.Differential`, using the general
additive differential API for the image calculation.

## References

* J. S. Milne, *Algebraic Groups* (2017), §10.a and §21.1.
* B. Conrad, *Reductive Group Schemes* (2014), §5.1.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1–2.
-/

public section

open TauCeti.UniversalEnvelopingAlgebra
open scoped Matrix

namespace TauCeti.E6DoubledMinuscule

universe v

noncomputable section

-- Use the algebra-induced integer module consistently for the counit coefficient synonyms.
attribute [local instance high] Algebra.toModule

local notation "H" => CommHopfAlgCat.quotient
  (GeneralLinear.coordinateHopfAlgebra ℤ 54) definingIdeal

variable {B : Type v} [CommRing B]

/-- The differential of a numbered integral root subgroup is its represented root operator
multiplied by the additive tangent parameter, over every coefficient ring. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem tangentMatrix_derivationComp_rootSubgroup (k : Fin 6 ⊕ Fin 6)
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    GeneralLinear.tangentMatrix 54
        (HopfIdeal.quotientLieHom (B := B) definingIdeal
          (derivationComp (B := B) (rootSubgroupIntegralCoordinateMap k).hom d)) =
      AdditiveGroup.gaTangentLinearEquiv d • (rootIntMatrix k).map (Int.cast : ℤ → B) := by
  have hcomp : (rootSubgroupIntegralCoordinateMap k).hom.comp
      (Bialgebra.Quotient.mkBialgHom definingIdeal.toIdeal) =
      (kostantRootSubgroupCoordinateMap
        (TauCeti.serreRootGenerator (CartanMatrix.E 6)ᵀ)
        (TauCeti.serreH ℚ (CartanMatrix.E 6)ᵀ) rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice k (isNilpotent_rep_serreRootGenerator k)
        matrixBasis).hom := by
    rw [← CommHopfAlgCat.hom_mkQuotient, ← CommHopfAlgCat.hom_comp,
      mkQuotient_comp_rootSubgroupIntegralCoordinateMap]
  rw [HopfIdeal.quotientLieHom_apply, ← LinearMap.comp_apply, ← derivationComp_comp, hcomp]
  simpa only [rootIntMatrix_eq_toMatrix, algebraMap_int_eq, Int.coe_castRingHom] using
    tangentMatrix_derivationComp_kostantRootSubgroupCoordinateMap
      (TauCeti.serreRootGenerator (CartanMatrix.E 6)ᵀ)
      (TauCeti.serreH ℚ (CartanMatrix.E 6)ᵀ) rep lattice.toAddSubgroup
      rep_kostantForm_mem_lattice k (isNilpotent_rep_serreRootGenerator k) matrixBasis d

/-- Every numbered integral root-subgroup differential is injective, including when its
coefficient ring has nilpotents. -/
theorem derivationComp_rootSubgroup_injective (k : Fin 6 ⊕ Fin 6) :
    Function.Injective (derivationComp (B := B) (rootSubgroupIntegralCoordinateMap k).hom) :=
  derivationComp_injective_of_surjective _ (rootSubgroupIntegralCoordinateMap_surjective k)

/-- The normalized root vector of the integral doubled E₆ carrier, with values in `B`, is the
image of the additive unit tangent vector under its numbered root-subgroup differential. -/
def rootVector (k : Fin 6 ⊕ Fin 6) :
    Derivation ℤ H (Bialgebra.CounitAlgebra ℤ H B) :=
  derivationComp (B := B) (rootSubgroupIntegralCoordinateMap k).hom
    ((AdditiveGroup.gaTangentLinearEquiv (R := ℤ) (B := B)).symm 1)

/-- The matrix of a normalized root vector is its integral represented root matrix. -/
@[simp]
theorem tangentMatrix_rootVector (k : Fin 6 ⊕ Fin 6) :
    GeneralLinear.tangentMatrix 54
        (HopfIdeal.quotientLieHom (B := B) definingIdeal (rootVector (B := B) k)) =
      (rootIntMatrix k).map (Int.cast : ℤ → B) := by
  rw [rootVector, tangentMatrix_derivationComp_rootSubgroup,
    LinearEquiv.apply_symm_apply, one_smul]

/-- The differential with additive parameter `c` is `c` times the normalized root vector. -/
theorem derivationComp_rootSubgroup_eq_smul_rootVector (k : Fin 6 ⊕ Fin 6)
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    derivationComp (B := B) (rootSubgroupIntegralCoordinateMap k).hom d =
      AdditiveGroup.gaTangentLinearEquiv d • rootVector (B := B) k := by
  exact AdditiveGroup.derivationComp_eq_smul _ d

/-- Coefficient change preserves the normalized integral root vector. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem mapValue_rootVector {C : Type*} [CommRing C] (φ : B →ₐ[ℤ] C)
    (k : Fin 6 ⊕ Fin 6) :
    Derivation.mapValue φ (rootVector (B := B) k) = rootVector (B := C) k := by
  exact AdditiveGroup.mapValue_derivationComp_gaTangentLinearEquiv_symm_one φ _

/-- The image of each root-subgroup differential is precisely its normalized root line. -/
theorem range_derivationCompLieHom_rootSubgroup_eq_span (k : Fin 6 ⊕ Fin 6) :
    (derivationCompLieHom (B := B) (rootSubgroupIntegralCoordinateMap k).hom).range.toSubmodule =
      B ∙ rootVector (B := B) k := by
  rw [rootVector]
  exact AdditiveGroup.range_derivationCompLieHom_eq_span B _

/-- A normalized root vector is nonzero over every nontrivial coefficient ring.
Use this directly: simplification changes the inherited integer module in the zero derivation
before this statement can match. -/
theorem rootVector_ne_zero [Nontrivial B] (k : Fin 6 ⊕ Fin 6) :
    rootVector (B := B) k ≠ 0 := by
  exact AdditiveGroup.derivationComp_gaTangentLinearEquiv_symm_one_ne_zero _
    (derivationComp_rootSubgroup_injective (B := B) k)

end

end TauCeti.E6DoubledMinuscule
