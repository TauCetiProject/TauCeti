module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Reduced

/-!
# Smoothness of the subgroup generated by the doubled type-E6 pinning candidates

The twelve numbered root subgroups and the weight torus of the doubled minuscule type-`E₆`
carrier generate a closed subgroup of `GL₅₄`. Its defining Hopf ideal is the common kernel of
their coordinate maps. Over an algebraically closed field, the generated subgroup is smooth:
its coordinate algebra is reduced because each generator has reduced coordinate algebra.

The base change of the integral toral-closure carrier contains this generated subgroup. The
two schemes are not identified here; neither reductivity nor an identification with the pinned
simply connected type-`E₆` group scheme follows from smoothness alone.

The construction follows the generated subgroup API of
`TauCeti.Algebra.Lie.E7.Minuscule.GeneratedSmooth`.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§26–27.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.
-/

public section

open scoped Matrix

namespace TauCeti.E6DoubledMinuscule

open CategoryTheory
open TauCeti.UniversalEnvelopingAlgebra

universe u

variable (A : Type u) [CommRing A]

/-- The defining ideal of the subgroup generated by the numbered roots and weight torus. -/
noncomputable def generatedDefiningIdeal :
    HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A 54) :=
  CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap A)

/-- The generated subgroup is defined by the common kernel of its generator maps. -/
@[simp]
theorem generatedDefiningIdeal_def :
    generatedDefiningIdeal A =
      CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap A) := by
  simp [generatedDefiningIdeal]

/-- A Hopf ideal lies below the generated subgroup's defining ideal exactly when all generator
coordinate maps kill it. -/
theorem le_generatedDefiningIdeal_iff
    (J : HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A 54)) :
    J ≤ generatedDefiningIdeal A ↔
      ∀ j, J.toIdeal ≤ RingHom.ker
        (generatorCoordinateMap A j).hom.toAlgHom.toRingHom := by
  rw [generatedDefiningIdeal_def]
  exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff (generatorCoordinateMap A) J

/-- The base-changed integral carrier contains the generated subgroup. -/
theorem baseChangeDefiningIdeal_le_generatedDefiningIdeal :
    baseChangeDefiningIdeal A ≤ generatedDefiningIdeal A := by
  rw [generatedDefiningIdeal_def]
  exact baseChangeDefiningIdeal_le_commonKernel A

/-- The coordinate Hopf algebra of the subgroup generated by the numbered roots and torus. -/
noncomputable def generatedCoordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A 54)
    (generatedDefiningIdeal A)

/-- The generated subgroup has the quotient coordinate Hopf algebra of its defining ideal. -/
@[simp]
theorem generatedCoordinateHopfAlgebra_def :
    generatedCoordinateHopfAlgebra A =
      CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A 54)
        (generatedDefiningIdeal A) := by
  simp [generatedCoordinateHopfAlgebra]

variable (k : Type u) [Field k]

private theorem isReduced_generatorCoordinateAlgebra :
    ∀ j, IsReduced (generatorCoordinateAlgebra k j) := by
  let : IsReduced (AdditiveGroup.coordinateHopfAlgebra k) :=
    isReduced_of_injective (AdditiveGroup.coordinateAlgEquiv k).toRingHom
      (AdditiveGroup.coordinateAlgEquiv k).injective
  let : IsReduced (DiagonalizableGroup.coordinateRing k
      (SplitTorus.characterGroup (Fin 6))).obj := inferInstance
  intro j
  cases j with
  | inl i => exact inferInstance
  | inr _ => exact inferInstance

/-- The generated subgroup's coordinate algebra is reduced over an algebraically closed field. -/
theorem isReduced_generatedCoordinateHopfAlgebra [IsAlgClosed k] :
    IsReduced (generatedCoordinateHopfAlgebra k) := by
  let : ∀ j, IsReduced (generatorCoordinateAlgebra k j) :=
    isReduced_generatorCoordinateAlgebra k
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact CommHopfAlgCat.isReduced_quotient_commonKernelHopfIdeal (generatorCoordinateMap k)

/-- The subgroup generated by the doubled type-`E₆` root subgroups and torus is smooth over an
algebraically closed field. -/
theorem smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra [IsAlgClosed k] :
    smoothCommHopfAlgProperty k (generatedCoordinateHopfAlgebra k) := by
  let : ∀ j, IsReduced (generatorCoordinateAlgebra k j) :=
    isReduced_generatorCoordinateAlgebra k
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact CommHopfAlgCat.smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal
    (generatorCoordinateMap k)

end TauCeti.E6DoubledMinuscule
