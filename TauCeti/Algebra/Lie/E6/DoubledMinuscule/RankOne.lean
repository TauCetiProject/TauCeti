module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.IntegralMatrix
public import TauCeti.Algebra.Lie.Presentation.MinusculeWeightTable.RankOne
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Elementary
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Equivalence
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.InverseTranspose
public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Diagonal.Basic

/-!
# Rank-one maps for the doubled E₆ minuscule carrier

At each numbered simple root, the block action of `SL₂` on the minuscule weight pairs,
together with its contragredient on the second summand, integrates the two opposite root
parameters of `V(ϖ₁) ⊕ V(ϖ₆)`. The inverse transpose on the second block is essential: the
dual root operators have negative coefficients. The diagonal maps to the specified simple
coroot, with the inverse weights on the dual summand.

The matrix construction and its faithfulness work over any commutative ring. Over a field,
transvection generation puts its image in the carrier and identifies the image with exactly
the subgroup generated by the two numbered root families. No identification with an
independently pinned simply connected group scheme is asserted here.

The containment and image arguments follow `TauCeti.E7Minuscule.rankOnePoints` in
`TauCeti.Algebra.Lie.E7.Minuscule.RankOne`; the block action is
`TauCeti.MinusculeWeightTable.sl2BlockGL`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, Chapter 6 and §12.2.
-/

public section

open scoped Matrix MatrixGroups

namespace TauCeti.E6DoubledMinuscule

open TauCeti.DynkinType

noncomputable section

variable (R : Type*) [CommRing R] (i : Fin 6)

/-- The rank-one matrix action on the doubled module: the minuscule block action and its
contragredient, in the carrier's `Fin 54` coordinates. -/
def rankOneGL : SL(2, R) →* GL (Fin 54) R :=
  (matrixIndexEquiv.reindexGL R).toMonoidHom.comp
    (fromBlocksGL.comp ((E6Minuscule.weightTable.sl2BlockSL i).prod
      ((E6Minuscule.weightTable.sl2BlockGL i).comp
        (Matrix.GeneralLinearGroup.inverseTranspose.toMonoidHom.comp
          Matrix.SpecialLinearGroup.toGL))))

/-- The two diagonal blocks of the rank-one action, before reindexing. -/
theorem coe_rankOneGL (g : SL(2, R)) :
    (rankOneGL R i g : Matrix (Fin 54) (Fin 54) R) =
      Matrix.reindex matrixIndexEquiv matrixIndexEquiv
        (Matrix.fromBlocks
          (E6Minuscule.weightTable.sl2BlockMatrix i (g : Matrix (Fin 2) (Fin 2) R)) 0 0
          (E6Minuscule.weightTable.sl2BlockMatrix i
            ((Matrix.GeneralLinearGroup.inverseTranspose
              (Matrix.SpecialLinearGroup.toGL g) : GL (Fin 2) R) :
                Matrix (Fin 2) (Fin 2) R))) := by
  simp [rankOneGL, Equiv.coe_reindexGL, coe_fromBlocksGL,
    MinusculeWeightTable.coe_sl2BlockSL, MinusculeWeightTable.coe_sl2BlockGL]

/-- The doubled action is faithful, already on its first minuscule summand. -/
theorem rankOneGL_injective : Function.Injective (rankOneGL R i) := by
  intro g h heq
  apply E6Minuscule.weightTable.sl2BlockSL_injective i
    (by simpa only [E6Minuscule.weightTable_weight] using
      exists_e6MinusculeWeight_apply_eq_neg_one i)
  apply Units.ext
  ext a b
  have he := congrArg (fun x : GL (Fin 54) R ↦
    (x : Matrix (Fin 54) (Fin 54) R)
      (matrixIndexEquiv (.inl a)) (matrixIndexEquiv (.inl b))) heq
  simpa [coe_rankOneGL, Matrix.reindex_apply, Matrix.submatrix_apply,
    MinusculeWeightTable.coe_sl2BlockSL] using he

/-- The upper transvection acts by the positive root parameter, including its negative dual
block coefficient. -/
@[simp]
theorem rankOneGL_upper_transvection (t : R) :
    rankOneGL R i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        (rootSubgroupPoints (.inl i) R (Multiplicative.ofAdd t) : GL (Fin 54) R) := by
  apply Units.ext
  rw [coe_rankOneGL, toGL_transvection_eq_transvectionUnit,
    inverseTranspose_transvectionUnit]
  rw [← toGL_transvection_eq_transvectionUnit]
  simp only [Matrix.SpecialLinearGroup.coe_GL_coe_matrix,
    MinusculeWeightTable.sl2BlockMatrix_upper_transvection,
    MinusculeWeightTable.sl2BlockMatrix_lower_transvection,
    E6Minuscule.weightTable_raisingMatrix, E6Minuscule.weightTable_loweringMatrix,
    coe_rootSubgroupPoints_eq_one_add_smul, toAdd_ofAdd, rootIntMatrix_inl]
  ext a b
  obtain ⟨a, rfl⟩ := matrixIndexEquiv.surjective a
  obtain ⟨b, rfl⟩ := matrixIndexEquiv.surjective b
  cases a <;> cases b <;>
    simp [Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.fromBlocks,
      Matrix.one_apply, neg_ite]

/-- The lower transvection acts by the negative root parameter. -/
@[simp]
theorem rankOneGL_lower_transvection (t : R) :
    rankOneGL R i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        (rootSubgroupPoints (.inr i) R (Multiplicative.ofAdd t) : GL (Fin 54) R) := by
  apply Units.ext
  rw [coe_rankOneGL, toGL_transvection_eq_transvectionUnit,
    inverseTranspose_transvectionUnit]
  rw [← toGL_transvection_eq_transvectionUnit]
  simp only [Matrix.SpecialLinearGroup.coe_GL_coe_matrix,
    MinusculeWeightTable.sl2BlockMatrix_upper_transvection,
    MinusculeWeightTable.sl2BlockMatrix_lower_transvection,
    E6Minuscule.weightTable_raisingMatrix, E6Minuscule.weightTable_loweringMatrix,
    coe_rootSubgroupPoints_eq_one_add_smul, toAdd_ofAdd, rootIntMatrix_inr]
  ext a b
  obtain ⟨a, rfl⟩ := matrixIndexEquiv.surjective a
  obtain ⟨b, rfl⟩ := matrixIndexEquiv.surjective b
  cases a <;> cases b <;>
    simp [Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.fromBlocks,
      Matrix.one_apply, neg_ite, neg_eq_iff_eq_neg]

/-- The diagonal matrix maps to the numbered simple-coroot point. -/
@[simp]
theorem rankOneGL_diag2nUnit (u : Rˣ) :
    rankOneGL R i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) =
        (weightTorusPoints R (Pi.mulSingle i u) : GL (Fin 54) R) := by
  have hd : Matrix.SpecialLinearGroup.toGL
      (Matrix.SpecialLinearGroup.diag2nUnit (by decide : (0 : Fin 2) ≠ 1) u) =
        diagGL (![u, u⁻¹]) := by
    apply Units.ext
    simp [Matrix.SpecialLinearGroup.diag2nUnit_coe, diagGL_coe]
  apply Units.ext
  rw [coe_rankOneGL, hd, inverseTranspose_diagGL]
  simp only [diagGL_coe, Matrix.SpecialLinearGroup.diag2nUnit_coe,
    MinusculeWeightTable.sl2BlockMatrix_diagonal, coe_weightTorusPoints,
    UniversalEnvelopingAlgebra.kostantTorusMatrix_apply, diagGL_coe]
  ext a b
  obtain ⟨a, rfl⟩ := matrixIndexEquiv.surjective a
  obtain ⟨b, rfl⟩ := matrixIndexEquiv.surjective b
  have hw := E6Minuscule.weightTable.weight_eq_neg_one_or_eq_zero_or_eq_one
    (Sum.elim id id b) i
  cases a <;> cases b <;> rcases hw with hw | hw | hw <;>
    simp_all [Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.diagonal_apply,
      Matrix.fromBlocks, matrixWeight_apply, torusCharacter_mulSingle,
      E6Minuscule.weightTable_weight]

variable (K : Type*) [Field K] (i : Fin 6)

private theorem rankOneGL_mem_of_rootSubgroupPoints_mem {H : Subgroup (GL (Fin 54) K)}
    (hpos : ∀ t : K, (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) :
      GL (Fin 54) K) ∈ H)
    (hneg : ∀ t : K, (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) :
      GL (Fin 54) K) ∈ H) (g : SL(2, K)) : rankOneGL K i g ∈ H := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · simpa only [rankOneGL_upper_transvection] using hpos t
    · simpa only [rankOneGL_lower_transvection] using hneg t
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using H.mul_mem hg hh

/-- The rank-one map into the doubled E₆ carrier over a field. -/
def rankOnePoints : SL(2, K) →* points K :=
  (rankOneGL K i).codRestrict (points K)
    (rankOneGL_mem_of_rootSubgroupPoints_mem K i
      (fun t ↦ (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t)).property)
      (fun t ↦ (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t)).property))

/-- Forgetting carrier membership recovers the explicit matrix action. -/
@[simp]
theorem coe_rankOnePoints (g : SL(2, K)) :
    (rankOnePoints K i g : GL (Fin 54) K) = rankOneGL K i g := (rfl)

/-- Each numbered rank-one map into the carrier is faithful. -/
theorem rankOnePoints_injective : Function.Injective (rankOnePoints K i) := by
  rw [rankOnePoints, MonoidHom.injective_codRestrict]
  exact rankOneGL_injective K i

/-- The upper transvection maps to the positive root point with the same parameter. -/
@[simp]
theorem rankOnePoints_upper_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  exact rankOneGL_upper_transvection K i t

/-- The lower transvection maps to the negative root point with the same parameter. -/
@[simp]
theorem rankOnePoints_lower_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  exact rankOneGL_lower_transvection K i t

/-- The diagonal maps to the numbered simple-coroot point in the carrier. -/
@[simp]
theorem rankOnePoints_diag2nUnit (u : Kˣ) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints K (Pi.mulSingle i u) := by
  apply Subtype.ext
  exact rankOneGL_diag2nUnit K i u

/-- The image is exactly the subgroup generated by the opposite root families at the node. -/
theorem range_rankOnePoints :
    (rankOnePoints K i).range = Subgroup.closure
      (Set.range (rootSubgroupPoints (.inl i) K) ∪
        Set.range (rootSubgroupPoints (.inr i) K)) := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [← Subgroup.mem_map_iff_mem (points K).subtype_injective, Subgroup.subtype_apply,
      coe_rankOnePoints]
    apply rankOneGL_mem_of_rootSubgroupPoints_mem K i
    · intro t
      exact Subgroup.mem_map.mpr ⟨_,
        Subgroup.subset_closure (Set.mem_union_left _ (Set.mem_range_self _)), rfl⟩
    · intro t
      exact Subgroup.mem_map.mpr ⟨_,
        Subgroup.subset_closure (Set.mem_union_right _ (Set.mem_range_self _)), rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
    · exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
        (Multiplicative.toAdd t), by simp⟩
    · exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0)
        (Multiplicative.toAdd t), by simp⟩

end

end TauCeti.E6DoubledMinuscule
