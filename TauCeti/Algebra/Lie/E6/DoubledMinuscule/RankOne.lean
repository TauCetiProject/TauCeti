module

public import TauCeti.Algebra.Lie.E6.DoubledMinuscule.IntegralMatrix
public import TauCeti.Algebra.Lie.Presentation.MinusculeWeightTable.RankOne.Basic
public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Transvection
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Elementary
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.InverseTranspose
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.RankOne

/-!
# Rank-one maps into the doubled E₆ minuscule carrier

At each numbered simple node, the two opposite root families of the doubled minuscule
carrier integrate to a faithful copy of `SL₂` over a field. The matrix action is defined over
every commutative ring: on the first minuscule summand it is the weight-table block action,
and on the dual summand it is that action precomposed with inverse transpose on `SL₂`.
Thus the positive generator acts by `E_i ⊕ (-F_i)` and the negative generator by
`F_i ⊕ (-E_i)`, with the signs prescribed by the doubled representation.

The diagonal maps to the numbered simple-coroot point. Over a field the image is exactly
the subgroup generated by the two root parameter families; no recognition of the entire
carrier as a pinned reductive group is asserted.

The carrier-containment and image arguments follow
`TauCeti.Algebra.Lie.E7.Minuscule.RankOne.Basic`, using the existing minuscule block action
and Mathlib's transvection induction rather than a new integration construction.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, Chapters 6 and 12.
-/

public section

open scoped Matrix MatrixGroups

namespace TauCeti.E6DoubledMinuscule

open TauCeti.DynkinType

noncomputable section

variable (R : Type*) [CommRing R] (i : Fin 6)

/-- The rank-one action on the doubled minuscule module, in the carrier's `Fin 54` order.
The second summand uses the inverse-transpose action on the two-dimensional source. -/
def rankOneMatrix : SL(2, R) →* GL (Fin 54) R :=
  (matrixIndexEquiv.reindexGL R).toMonoidHom.comp
    (fromBlocksGL.comp ((E6Minuscule.weightTable.sl2BlockSL i).prod
      ((E6Minuscule.weightTable.sl2BlockGL i).comp
        (Matrix.GeneralLinearGroup.inverseTranspose.toMonoidHom.comp
          Matrix.SpecialLinearGroup.toGL))))

/-- The two diagonal blocks of the rank-one action are the minuscule block actions of
`g` and `(g⁻¹)ᵀ`, transported to the fixed carrier coordinates. -/
@[simp]
theorem coe_rankOneMatrix (g : SL(2, R)) :
    (rankOneMatrix R i g : Matrix (Fin 54) (Fin 54) R) =
      Matrix.reindex matrixIndexEquiv matrixIndexEquiv
        (Matrix.fromBlocks
          (E6Minuscule.weightTable.sl2BlockMatrix i (g : Matrix (Fin 2) (Fin 2) R)) 0 0
          (E6Minuscule.weightTable.sl2BlockMatrix i
            ((g⁻¹ : SL(2, R)) : Matrix (Fin 2) (Fin 2) R)ᵀ)) := by
  simp only [rankOneMatrix, MonoidHom.comp_apply, MonoidHom.prod_apply,
    MulEquiv.coe_toMonoidHom, Equiv.coe_reindexGL, coe_fromBlocksGL,
    E6Minuscule.weightTable.coe_sl2BlockSL,
    E6Minuscule.weightTable.coe_sl2BlockGL, Matrix.GeneralLinearGroup.coe_inverseTranspose,
    ← map_inv, Matrix.SpecialLinearGroup.coe_GL_coe_matrix, Matrix.reindex_apply]

/-- The first minuscule summand already makes the doubled rank-one action faithful. -/
theorem rankOneMatrix_injective : Function.Injective (rankOneMatrix R i) := by
  intro g h hgh
  apply E6Minuscule.weightTable.sl2BlockSL_injective i
    (by simpa only [E6Minuscule.weightTable_weight] using
      exists_e6MinusculeWeight_apply_eq_neg_one i)
  apply Units.ext
  ext a b
  have hab := congrArg (fun x : GL (Fin 54) R ↦
    (x : Matrix (Fin 54) (Fin 54) R)
      (matrixIndexEquiv (.inl a)) (matrixIndexEquiv (.inl b))) hgh
  simpa only [coe_rankOneMatrix, Matrix.reindex_apply, Matrix.submatrix_apply,
    Equiv.symm_apply_apply, Matrix.fromBlocks_apply₁₁,
    E6Minuscule.weightTable.coe_sl2BlockSL] using hab

private theorem reindex_root_blocks (A B : Matrix (Fin 27) (Fin 27) ℤ) (t : R) :
    Matrix.reindex matrixIndexEquiv matrixIndexEquiv
      (Matrix.fromBlocks (1 + t • A.map (Int.cast : ℤ → R)) 0 0
        (1 + (-t) • B.map (Int.cast : ℤ → R))) =
      1 + t • (Matrix.reindex matrixIndexEquiv matrixIndexEquiv
        (Matrix.fromBlocks A 0 0 (-B))).map (Int.cast : ℤ → R) := by
  -- The dual root block has the negative coefficient; scalar extension and reindexing
  -- preserve the resulting block-diagonal sum.
  have hblocks : Matrix.fromBlocks (1 + t • A.map (Int.cast : ℤ → R)) 0 0
      (1 + (-t) • B.map (Int.cast : ℤ → R)) =
      1 + t • (Matrix.fromBlocks A 0 0 (-B)).map (Int.cast : ℤ → R) := by
    rw [Matrix.fromBlocks_map, ← Matrix.fromBlocks_one,
      Matrix.fromBlocks_smul, Matrix.fromBlocks_add]
    simp [Matrix.map_zero (Int.cast : ℤ → R) Int.cast_zero,
      Matrix.map_neg (Int.cast : ℤ → R) Int.cast_neg]
  rw [hblocks]
  simp [Matrix.reindex_apply, Matrix.submatrix_add, Matrix.submatrix_smul,
    Matrix.submatrix_one_equiv, Matrix.submatrix_map]

/-- An upper transvection is the numbered positive simple-root point. -/
@[simp]
theorem rankOneMatrix_upper_transvection (t : R) :
    rankOneMatrix R i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
      (rootSubgroupPoints (.inl i) R (Multiplicative.ofAdd t) : GL (Fin 54) R) := by
  apply Units.ext
  rw [coe_rankOneMatrix, coe_rootSubgroupPoints_eq_one_add_smul, rootIntMatrix_inl,
    Matrix.SpecialLinearGroup.transvection_inv]
  rw [Matrix.SpecialLinearGroup.transpose_coe_transvection,
    E6Minuscule.weightTable.sl2BlockMatrix_upper_transvection,
    E6Minuscule.weightTable.sl2BlockMatrix_lower_transvection,
    E6Minuscule.weightTable_raisingMatrix, E6Minuscule.weightTable_loweringMatrix,
    raisingMatrix_eq_fromBlocks]
  exact reindex_root_blocks R _ _ t

/-- A lower transvection is the numbered negative simple-root point. -/
@[simp]
theorem rankOneMatrix_lower_transvection (t : R) :
    rankOneMatrix R i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
      (rootSubgroupPoints (.inr i) R (Multiplicative.ofAdd t) : GL (Fin 54) R) := by
  apply Units.ext
  rw [coe_rankOneMatrix, coe_rootSubgroupPoints_eq_one_add_smul, rootIntMatrix_inr,
    Matrix.SpecialLinearGroup.transvection_inv]
  rw [Matrix.SpecialLinearGroup.transpose_coe_transvection,
    E6Minuscule.weightTable.sl2BlockMatrix_lower_transvection,
    E6Minuscule.weightTable.sl2BlockMatrix_upper_transvection,
    E6Minuscule.weightTable_raisingMatrix, E6Minuscule.weightTable_loweringMatrix,
    loweringMatrix_eq_fromBlocks]
  exact reindex_root_blocks R _ _ t

/-- The diagonal of the rank-one map is the numbered simple-coroot value. -/
@[simp]
theorem rankOneMatrix_diag2nUnit (u : Rˣ) :
    rankOneMatrix R i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) =
      (weightTorusPoints R (Pi.mulSingle i u) : GL (Fin 54) R) := by
  apply Units.ext
  rw [coe_rankOneMatrix, coe_weightTorusPoints,
    UniversalEnvelopingAlgebra.kostantTorusMatrix_apply, diagGL_coe,
    Matrix.SpecialLinearGroup.diag2nUnit_inv]
  simp only [Matrix.SpecialLinearGroup.diag2nUnit_coe, Matrix.diagonal_transpose, inv_inv]
  rw [E6Minuscule.weightTable.sl2BlockMatrix_diagonal_unit]
  have hdual := E6Minuscule.weightTable.sl2BlockMatrix_diagonal_unit i u⁻¹
  simp only [inv_inv] at hdual
  rw [hdual, Matrix.fromBlocks_diagonal, Matrix.reindex_apply,
    Matrix.submatrix_diagonal_equiv]
  congr 1
  funext a
  obtain ⟨a, rfl⟩ := matrixIndexEquiv.surjective a
  -- The doubled weight is the minuscule weight on the first block and its negative
  -- on the dual block; inversion of the unit realizes the latter character.
  cases a <;>
    simp [matrixWeight_apply, torusCharacter_mulSingle, E6Minuscule.weightTable_weight]

end

noncomputable section

variable (K : Type*) [Field K] (i : Fin 6)

private theorem rankOneMatrix_mem_of_root_mem {H : Subgroup (GL (Fin 54) K)}
    (hpos : ∀ t : K, (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) :
      GL (Fin 54) K) ∈ H)
    (hneg : ∀ t : K, (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) :
      GL (Fin 54) K) ∈ H) (g : SL(2, K)) : rankOneMatrix K i g ∈ H := by
  refine (rankOneMatrix K i).sl2_range_le_of_transvection_mem ?_ ?_ ⟨g, rfl⟩
  · intro t
    rw [rankOneMatrix_upper_transvection]
    exact hpos t
  · intro t
    rw [rankOneMatrix_lower_transvection]
    exact hneg t

/-- The numbered rank-one homomorphism into the doubled minuscule carrier over a field. -/
def rankOnePoints : SL(2, K) →* points K :=
  (rankOneMatrix K i).codRestrict (points K)
    (rankOneMatrix_mem_of_root_mem K i
      (fun t ↦ (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t)).property)
      (fun t ↦ (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t)).property))

/-- Inclusion in the ambient general linear group recovers the explicit matrix action. -/
@[simp]
theorem coe_rankOnePoints (g : SL(2, K)) :
    (rankOnePoints K i g : GL (Fin 54) K) = rankOneMatrix K i g :=
  (rfl)

/-- The numbered rank-one homomorphism is faithful. -/
theorem rankOnePoints_injective : Function.Injective (rankOnePoints K i) := by
  rw [rankOnePoints, MonoidHom.injective_codRestrict]
  exact rankOneMatrix_injective K i

/-- The positive transvection retains its root parameter in the carrier. -/
@[simp]
theorem rankOnePoints_upper_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
      rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  exact rankOneMatrix_upper_transvection K i t

/-- The negative transvection retains its root parameter in the carrier. -/
@[simp]
theorem rankOnePoints_lower_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
      rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  exact rankOneMatrix_lower_transvection K i t

/-- The diagonal in the carrier is the numbered simple coroot. -/
@[simp]
theorem rankOnePoints_diag2nUnit (u : Kˣ) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints K (Pi.mulSingle i u) := by
  apply Subtype.ext
  exact rankOneMatrix_diag2nUnit K i u

/-- The image is exactly the subgroup generated by the two opposite numbered root families. -/
theorem range_rankOnePoints : (rankOnePoints K i).range =
    Subgroup.closure (Set.range (rootSubgroupPoints (.inl i) K) ∪
      Set.range (rootSubgroupPoints (.inr i) K)) := by
  rw [(rankOnePoints K i).sl2_range_eq_closure]
  congr 2 <;>
    simpa only [Function.comp_def, rankOnePoints_upper_transvection,
      rankOnePoints_lower_transvection] using
      (Multiplicative.ofAdd : K ≃ Multiplicative K).surjective.range_comp
        (rootSubgroupPoints _ K)

end

end TauCeti.E6DoubledMinuscule
