module

public import Mathlib.Algebra.Lie.Solvable
public import TauCeti.Algebra.Lie.Presentation.Serre
public import TauCeti.LinearAlgebra.Matrix.Cartan.Realization

/-!
# The Kac–Moody algebra of a realization, by generators and relations

Let `A` be a square matrix of integers and `R` a realization of `A` over a field `K`
(`TauCeti.CartanRealization`): simple coroots `hᵢ` in a `K`-vector space `H` and simple roots
`αᵢ` in its dual with `αⱼ(hᵢ) = Aᵢⱼ`. This file defines the Lie algebra generated by the whole
space `H` together with elements `eᵢ`, `fᵢ`, subject to

* `H` is abelian, `⁅h, eⱼ⁆ = αⱼ(h) eⱼ` and `⁅h, fⱼ⁆ = -αⱼ(h) fⱼ` for `h ∈ H`;
* `⁅eᵢ, fᵢ⁆ = hᵢ` and `⁅eᵢ, fⱼ⁆ = 0` for `i ≠ j`;
* Serre's relations `(ad eᵢ) ^ (-Aᵢⱼ) ⁅eᵢ, eⱼ⁆ = 0` and `(ad fᵢ) ^ (-Aᵢⱼ) ⁅fᵢ, fⱼ⁆ = 0`.

For a symmetrizable generalized Cartan matrix and a minimal realization this is the Kac–Moody
algebra `𝔤(A)` of Kac's book, by the Gabber–Kac theorem [Kac, Theorem 9.11], which is not proved
here; a larger realization adds central directions. For a generalized Cartan matrix and `i ≠ j`
the last relations are `(ad eᵢ) ^ (1 - Aᵢⱼ) eⱼ = 0` and its lowering analogue; the exponent is
truncated at zero exactly as in Mathlib's `Matrix.ToLieAlgebra`, so that the derived algebra below
is compared with that presentation relator by relator.

Unlike `Matrix.ToLieAlgebra`, which only has the generators `hᵢ`, `eᵢ`, `fᵢ` and presents the
derived algebra, this presentation uses the full realization. That is what makes the simple roots
linearly independent characters of `H` even when `A` is singular, as in affine type. The space `H`
enters through free generators indexed by its elements, and the linearity of `h ↦ h` is imposed by
relators, so that `TauCeti.KacMoody.cartanElement` is a linear map.

## Main definitions

* `TauCeti.KacMoody.IsRelator`: the defining relators in the free Lie algebra.
* `TauCeti.KacMoody.PresentedLieAlgebra`: the quotient of the free Lie algebra by the Lie ideal
  `TauCeti.KacMoody.presentationIdeal` they generate.
* `TauCeti.KacMoody.cartanElement`, `TauCeti.KacMoody.positiveGenerator` and
  `TauCeti.KacMoody.negativeGenerator`: the images of the generators.
* `TauCeti.KacMoody.SatisfiesRelations`: a linear map on `H` and two families of elements of a Lie
  algebra satisfying the defining relations.
* `TauCeti.KacMoody.lift`: the homomorphism out of the presented algebra determined by such data.
* `TauCeti.KacMoody.serreHom`: the homomorphism from `Matrix.ToLieAlgebra K A` sending its
  generators to `cartanElement R hᵢ`, `eᵢ` and `fᵢ`.

## Main results

* `TauCeti.KacMoody.lift_cartanElement` and its companions, with `TauCeti.KacMoody.hom_ext`: the
  universal property of the presentation.
* `TauCeti.KacMoody.lieSpan_generators_eq_top`: the generators generate the presented algebra.
* `TauCeti.KacMoody.range_serreHom_sup_range_cartanElement`: `𝔤 = 𝔤' + H`, where `𝔤'` is the
  image of `Matrix.ToLieAlgebra K A`.
* `TauCeti.KacMoody.range_serreHom_eq_derivedSeries`: that image is the derived algebra `⁅𝔤, 𝔤⁆`.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, §1.2 (the auxiliary algebra on
  a realization), §1.3 (the algebra `𝔤(A)`, its derived algebra and `𝔤(A) = 𝔤'(A) + 𝔥`) and
  Theorem 9.11 (the presentation of `𝔤(A)` by Serre's relations in the symmetrizable case).
-/

public section

open LieAlgebra

namespace TauCeti

namespace KacMoody

/-- The generators of the free Lie algebra presenting the Kac–Moody algebra: one Cartan generator
for each element of the realization `H`, and a raising and a lowering generator for each node. -/
inductive Generator (I H : Type*)
  /-- The Cartan generator attached to an element of the realization. -/
  | cartan : H → Generator I H
  /-- The raising generator `eᵢ`. -/
  | positive : I → Generator I H
  /-- The lowering generator `fᵢ`. -/
  | negative : I → Generator I H

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

open _root_.FreeLieAlgebra Generator in
/-- The defining relators of the Kac–Moody algebra of a realization `R`, as elements of the free
Lie algebra on `TauCeti.KacMoody.Generator I H`. The first two families make the Cartan
generators depend linearly on `H`; the others are the Chevalley and Serre relations. -/
inductive IsRelator : FreeLieAlgebra K (Generator I H) → Prop
  /-- Additivity of the Cartan generators. -/
  | cartan_add (x y : H) :
      IsRelator (of K (cartan (x + y)) - of K (cartan x) - of K (cartan y))
  /-- Homogeneity of the Cartan generators. -/
  | cartan_smul (c : K) (x : H) : IsRelator (of K (cartan (c • x)) - c • of K (cartan x))
  /-- The Cartan generators commute. -/
  | lie_cartan_cartan (x y : H) :
      IsRelator ⁅of K (cartan x : Generator I H), of K (cartan y)⁆
  /-- `eⱼ` has weight `αⱼ`. -/
  | lie_cartan_positive (x : H) (j : I) :
      IsRelator (⁅of K (cartan x : Generator I H), of K (positive j)⁆ -
        R.root j x • of K (positive j))
  /-- `fⱼ` has weight `-αⱼ`. -/
  | lie_cartan_negative (x : H) (j : I) :
      IsRelator (⁅of K (cartan x : Generator I H), of K (negative j)⁆ +
        R.root j x • of K (negative j))
  /-- `⁅eᵢ, fᵢ⁆ = hᵢ`. -/
  | lie_positive_negative_self (i : I) :
      IsRelator (⁅of K (positive i : Generator I H), of K (negative i)⁆ -
        of K (cartan (R.coroot i)))
  /-- `⁅eᵢ, fⱼ⁆ = 0` for `i ≠ j`. -/
  | lie_positive_negative_of_ne (i j : I) (hij : i ≠ j) :
      IsRelator ⁅of K (positive i : Generator I H), of K (negative j)⁆
  /-- Serre's relation on the raising generators. -/
  | serre_positive (i j : I) :
      IsRelator ((ad K _ (of K (positive i : Generator I H)) ^ (-A i j).toNat)
        ⁅of K (positive i : Generator I H), of K (positive j)⁆)
  /-- Serre's relation on the lowering generators. -/
  | serre_negative (i j : I) :
      IsRelator ((ad K _ (of K (negative i : Generator I H)) ^ (-A i j).toNat)
        ⁅of K (negative i : Generator I H), of K (negative j)⁆)

/-- The Lie ideal of the free Lie algebra generated by the defining relators. -/
noncomputable def presentationIdeal : LieIdeal K (FreeLieAlgebra K (Generator I H)) :=
  LieSubmodule.lieSpan K _ {x | IsRelator R x}

/-- The Kac–Moody algebra of the realization `R`, presented by generators and relations. -/
def PresentedLieAlgebra : Type _ :=
  FreeLieAlgebra K (Generator I H) ⧸ presentationIdeal R

noncomputable instance : LieRing (PresentedLieAlgebra R) :=
  inferInstanceAs (LieRing (FreeLieAlgebra K (Generator I H) ⧸ presentationIdeal R))

noncomputable instance : LieAlgebra K (PresentedLieAlgebra R) :=
  inferInstanceAs (LieAlgebra K (FreeLieAlgebra K (Generator I H) ⧸ presentationIdeal R))

/-! ## The generators and their relations -/

/-- The quotient map presenting `TauCeti.KacMoody.PresentedLieAlgebra R`. -/
noncomputable def presentationMk :
    FreeLieAlgebra K (Generator I H) →ₗ⁅K⁆ PresentedLieAlgebra R :=
  LieIdeal.mkQ (presentationIdeal R)

/-- The kernel of the presentation map is the ideal generated by the relators. -/
@[simp]
theorem ker_presentationMk : (presentationMk R).ker = presentationIdeal R :=
  LieIdeal.mkQ_ker _

/-- Every element of the presented algebra is the class of an element of the free Lie algebra. -/
theorem presentationMk_surjective : Function.Surjective (presentationMk R) :=
  (presentationIdeal R).surjective_mkQ

/-- A defining relator vanishes in the presented algebra. -/
theorem presentationMk_eq_zero_of_isRelator {x : FreeLieAlgebra K (Generator I H)}
    (hx : IsRelator R x) :
    presentationMk R x = 0 :=
  (LieIdeal.mkQ_apply _ x).trans
    (LieSubmodule.Quotient.mk_eq_zero'.mpr (LieSubmodule.subset_lieSpan hx))

/-- The embedding of the realization `H` into the presented algebra. -/
noncomputable def cartanElement : H →ₗ[K] PresentedLieAlgebra R where
  toFun x := presentationMk R (FreeLieAlgebra.of K (Generator.cartan x))
  map_add' x y := by
    have h := presentationMk_eq_zero_of_isRelator R (.cartan_add x y)
    rwa [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  map_smul' c x := by
    have h := presentationMk_eq_zero_of_isRelator R (.cartan_smul c x)
    rwa [map_sub, map_smul, sub_eq_zero] at h

/-- The raising generator `eᵢ` of the presented algebra. -/
noncomputable def positiveGenerator (i : I) : PresentedLieAlgebra R :=
  presentationMk R (FreeLieAlgebra.of K (Generator.positive i))

/-- The lowering generator `fᵢ` of the presented algebra. -/
noncomputable def negativeGenerator (i : I) : PresentedLieAlgebra R :=
  presentationMk R (FreeLieAlgebra.of K (Generator.negative i))

/-- The quotient map sends the free Cartan generator of `x` to `TauCeti.KacMoody.cartanElement`. -/
@[simp]
theorem presentationMk_of_cartan (x : H) :
    presentationMk R (FreeLieAlgebra.of K (Generator.cartan x)) = cartanElement R x := (rfl)

/-- The quotient map sends the free generator `eᵢ` to `TauCeti.KacMoody.positiveGenerator`. -/
@[simp]
theorem presentationMk_of_positive (i : I) :
    presentationMk R (FreeLieAlgebra.of K (Generator.positive i)) = positiveGenerator R i := (rfl)

/-- The quotient map sends the free generator `fᵢ` to `TauCeti.KacMoody.negativeGenerator`. -/
@[simp]
theorem presentationMk_of_negative (i : I) :
    presentationMk R (FreeLieAlgebra.of K (Generator.negative i)) = negativeGenerator R i := (rfl)

/-- The Cartan elements commute. -/
@[simp]
theorem lie_cartanElement_cartanElement (x y : H) :
    ⁅cartanElement R x, cartanElement R y⁆ = 0 := by
  simpa using presentationMk_eq_zero_of_isRelator R (.lie_cartan_cartan x y)

/-- The raising generator `eⱼ` has weight `αⱼ`. -/
@[simp]
theorem lie_cartanElement_positiveGenerator (x : H) (j : I) :
    ⁅cartanElement R x, positiveGenerator R j⁆ = R.root j x • positiveGenerator R j := by
  simpa [sub_eq_zero] using presentationMk_eq_zero_of_isRelator R (.lie_cartan_positive x j)

/-- The lowering generator `fⱼ` has weight `-αⱼ`. -/
@[simp]
theorem lie_cartanElement_negativeGenerator (x : H) (j : I) :
    ⁅cartanElement R x, negativeGenerator R j⁆ = -(R.root j x • negativeGenerator R j) := by
  simpa [add_eq_zero_iff_eq_neg] using
    presentationMk_eq_zero_of_isRelator R (.lie_cartan_negative x j)

/-- The bracket of `eᵢ` and `fᵢ` is the simple coroot `hᵢ`. -/
@[simp]
theorem lie_positiveGenerator_negativeGenerator_self (i : I) :
    ⁅positiveGenerator R i, negativeGenerator R i⁆ = cartanElement R (R.coroot i) := by
  simpa [sub_eq_zero] using presentationMk_eq_zero_of_isRelator R (.lie_positive_negative_self i)

/-- The generators `eᵢ` and `fⱼ` commute for `i ≠ j`. -/
@[simp]
theorem lie_positiveGenerator_negativeGenerator_of_ne {i j : I} (hij : i ≠ j) :
    ⁅positiveGenerator R i, negativeGenerator R j⁆ = 0 := by
  simpa using presentationMk_eq_zero_of_isRelator R (.lie_positive_negative_of_ne i j hij)

/-- Serre's relation `(ad eᵢ) ^ (-Aᵢⱼ) ⁅eᵢ, eⱼ⁆ = 0` on the raising generators. -/
@[simp]
theorem ad_pow_lie_positiveGenerator_positiveGenerator (i j : I) :
    (ad K (PresentedLieAlgebra R) (positiveGenerator R i) ^ (-A i j).toNat)
      ⁅positiveGenerator R i, positiveGenerator R j⁆ = 0 := by
  have h := presentationMk_eq_zero_of_isRelator R (.serre_positive i j)
  rwa [LieHom.map_ad_pow, LieHom.map_lie] at h

/-- Serre's relation `(ad fᵢ) ^ (-Aᵢⱼ) ⁅fᵢ, fⱼ⁆ = 0` on the lowering generators. -/
@[simp]
theorem ad_pow_lie_negativeGenerator_negativeGenerator (i j : I) :
    (ad K (PresentedLieAlgebra R) (negativeGenerator R i) ^ (-A i j).toNat)
      ⁅negativeGenerator R i, negativeGenerator R j⁆ = 0 := by
  have h := presentationMk_eq_zero_of_isRelator R (.serre_negative i j)
  rwa [LieHom.map_ad_pow, LieHom.map_lie] at h

/-! ## The universal property -/

variable {L : Type*} [LieRing L] [LieAlgebra K L]

/-- A linear map `φ : H → L` and families `E`, `F` of elements of a Lie algebra `L` *satisfy the
relations* of the Kac–Moody algebra of `R` when they satisfy the defining relations, `φ` playing
the role of the Cartan generators, `E` of the raising and `F` of the lowering generators. -/
structure SatisfiesRelations (φ : H →ₗ[K] L) (E F : I → L) : Prop where
  /-- The image of `H` is abelian. -/
  lie_cartan_cartan : ∀ x y, ⁅φ x, φ y⁆ = 0
  /-- `E j` has weight `αⱼ`. -/
  lie_cartan_positive : ∀ x j, ⁅φ x, E j⁆ = R.root j x • E j
  /-- `F j` has weight `-αⱼ`. -/
  lie_cartan_negative : ∀ x j, ⁅φ x, F j⁆ = -(R.root j x • F j)
  /-- `⁅E i, F i⁆` is the image of the simple coroot `hᵢ`. -/
  lie_positive_negative_self : ∀ i, ⁅E i, F i⁆ = φ (R.coroot i)
  /-- `E i` and `F j` commute for `i ≠ j`. -/
  lie_positive_negative_of_ne : ∀ i j, i ≠ j → ⁅E i, F j⁆ = 0
  /-- Serre's relation on the raising family. -/
  serre_positive : ∀ i j, (ad K L (E i) ^ (-A i j).toNat) ⁅E i, E j⁆ = 0
  /-- Serre's relation on the lowering family. -/
  serre_negative : ∀ i j, (ad K L (F i) ^ (-A i j).toNat) ⁅F i, F j⁆ = 0

/-- The generators of the presented algebra satisfy its relations. -/
theorem satisfiesRelations_generators :
    SatisfiesRelations R (cartanElement R) (positiveGenerator R) (negativeGenerator R) where
  lie_cartan_cartan := lie_cartanElement_cartanElement R
  lie_cartan_positive := lie_cartanElement_positiveGenerator R
  lie_cartan_negative := lie_cartanElement_negativeGenerator R
  lie_positive_negative_self := lie_positiveGenerator_negativeGenerator_self R
  lie_positive_negative_of_ne _ _ := lie_positiveGenerator_negativeGenerator_of_ne R
  serre_positive := ad_pow_lie_positiveGenerator_positiveGenerator R
  serre_negative := ad_pow_lie_negativeGenerator_negativeGenerator R

variable {R}

/-- Relations are carried along Lie algebra homomorphisms. -/
theorem SatisfiesRelations.map {φ : H →ₗ[K] L} {E F : I → L} (h : SatisfiesRelations R φ E F)
    {L' : Type*} [LieRing L'] [LieAlgebra K L'] (g : L →ₗ⁅K⁆ L') :
    SatisfiesRelations R ((g : L →ₗ[K] L') ∘ₗ φ) (g ∘ E) (g ∘ F) where
  lie_cartan_cartan x y := by simp [← LieHom.map_lie, h.lie_cartan_cartan]
  lie_cartan_positive x j := by simp [← LieHom.map_lie, h.lie_cartan_positive]
  lie_cartan_negative x j := by simp [← LieHom.map_lie, h.lie_cartan_negative]
  lie_positive_negative_self i := by simp [← LieHom.map_lie, h.lie_positive_negative_self]
  lie_positive_negative_of_ne i j hij := by
    simp [← LieHom.map_lie, h.lie_positive_negative_of_ne i j hij]
  serre_positive i j := by
    simp only [Function.comp_apply, ← LieHom.map_lie, ← LieHom.map_ad_pow, h.serre_positive,
      map_zero]
  serre_negative i j := by
    simp only [Function.comp_apply, ← LieHom.map_lie, ← LieHom.map_ad_pow, h.serre_negative,
      map_zero]

/-- The zero map satisfies the relations. -/
theorem satisfiesRelations_zero : SatisfiesRelations R (0 : H →ₗ[K] L) 0 0 where
  lie_cartan_cartan _ _ := by simp
  lie_cartan_positive _ _ := by simp
  lie_cartan_negative _ _ := by simp
  lie_positive_negative_self _ := by simp
  lie_positive_negative_of_ne _ _ _ := by simp
  serre_positive _ _ := by simp
  serre_negative _ _ := by simp

variable {φ : H →ₗ[K] L} {E F : I → L}

/-- The values on the free generators of the homomorphism induced by relation-satisfying data. -/
private def generatorMap (φ : H →ₗ[K] L) (E F : I → L) : Generator I H → L
  | .cartan x => φ x
  | .positive i => E i
  | .negative i => F i

/-- Relation-satisfying data kill every relator. -/
private theorem presentationIdeal_le_ker (h : SatisfiesRelations R φ E F) :
    presentationIdeal R ≤ (FreeLieAlgebra.lift K (generatorMap φ E F)).ker := by
  refine LieSubmodule.lieSpan_le.mpr fun x hx => ?_
  rw [SetLike.mem_coe, LieHom.mem_ker]
  induction hx with
  | cartan_add x y => simp [generatorMap]
  | cartan_smul c x => simp [generatorMap]
  | lie_cartan_cartan x y => simpa [generatorMap] using h.lie_cartan_cartan x y
  | lie_cartan_positive x j => simpa [generatorMap, sub_eq_zero] using h.lie_cartan_positive x j
  | lie_cartan_negative x j =>
    simpa [generatorMap, add_eq_zero_iff_eq_neg] using h.lie_cartan_negative x j
  | lie_positive_negative_self i =>
    simpa [generatorMap, sub_eq_zero] using h.lie_positive_negative_self i
  | lie_positive_negative_of_ne i j hij =>
    simpa [generatorMap] using h.lie_positive_negative_of_ne i j hij
  | serre_positive i j =>
    simpa [LieHom.map_ad_pow, generatorMap] using h.serre_positive i j
  | serre_negative i j =>
    simpa [LieHom.map_ad_pow, generatorMap] using h.serre_negative i j

/-- The homomorphism out of the presented algebra determined by data satisfying its relations:
the universal property of the presentation. -/
noncomputable def lift (h : SatisfiesRelations R φ E F) : PresentedLieAlgebra R →ₗ⁅K⁆ L :=
  (presentationIdeal R).liftQ (FreeLieAlgebra.lift K (generatorMap φ E F))
    (presentationIdeal_le_ker h)

private theorem lift_presentationMk (h : SatisfiesRelations R φ E F)
    (g : Generator I H) :
    lift h (presentationMk R (FreeLieAlgebra.of K g)) = generatorMap φ E F g :=
  (LieIdeal.liftQ_apply _ _ _ _).trans (FreeLieAlgebra.lift_of_apply _ _)

/-- The lift sends the Cartan elements along `φ`. -/
@[simp]
theorem lift_cartanElement (h : SatisfiesRelations R φ E F) (x : H) :
    lift h (cartanElement R x) = φ x :=
  lift_presentationMk h (Generator.cartan x)

/-- The lift sends `eᵢ` to `E i`. -/
@[simp]
theorem lift_positiveGenerator (h : SatisfiesRelations R φ E F) (i : I) :
    lift h (positiveGenerator R i) = E i :=
  lift_presentationMk h (Generator.positive i)

/-- The lift sends `fᵢ` to `F i`. -/
@[simp]
theorem lift_negativeGenerator (h : SatisfiesRelations R φ E F) (i : I) :
    lift h (negativeGenerator R i) = F i :=
  lift_presentationMk h (Generator.negative i)

/-- Two homomorphisms out of the presented algebra agreeing on the generators are equal. -/
@[ext]
theorem hom_ext {g₁ g₂ : PresentedLieAlgebra R →ₗ⁅K⁆ L}
    (hH : ∀ x, g₁ (cartanElement R x) = g₂ (cartanElement R x))
    (hE : ∀ i, g₁ (positiveGenerator R i) = g₂ (positiveGenerator R i))
    (hF : ∀ i, g₁ (negativeGenerator R i) = g₂ (negativeGenerator R i)) : g₁ = g₂ := by
  refine (presentationIdeal R).lieHom_qext fun x => ?_
  have hcomp : g₁.comp (presentationMk R) = g₂.comp (presentationMk R) := by
    refine FreeLieAlgebra.hom_ext fun g => ?_
    cases g with
    | cartan x => exact hH x
    | positive i => exact hE i
    | negative i => exact hF i
  exact DFunLike.congr_fun hcomp x

/-- `TauCeti.KacMoody.lift` is the unique homomorphism with the prescribed values on the
generators. -/
theorem eq_lift {h : SatisfiesRelations R φ E F} {g : PresentedLieAlgebra R →ₗ⁅K⁆ L}
    (hH : ∀ x, g (cartanElement R x) = φ x) (hE : ∀ i, g (positiveGenerator R i) = E i)
    (hF : ∀ i, g (negativeGenerator R i) = F i) : g = lift h :=
  hom_ext (by simpa using hH) (by simpa using hE) (by simpa using hF)

variable (R)

/-- Every homomorphism out of the presented algebra is the lift of the images of the
generators. -/
theorem lift_map_satisfiesRelations_generators (g : PresentedLieAlgebra R →ₗ⁅K⁆ L) :
    lift ((satisfiesRelations_generators R).map g) = g :=
  (eq_lift (fun _ => rfl) (fun _ => rfl) fun _ => rfl).symm

/-- Composing a lift with a homomorphism lifts the composed data. -/
theorem comp_lift (h : SatisfiesRelations R φ E F) {L' : Type*} [LieRing L'] [LieAlgebra K L']
    (g : L →ₗ⁅K⁆ L') : g.comp (lift h) = lift (h.map g) := by
  ext <;> simp

/-- Lifting the generators of the presented algebra along themselves gives the identity. -/
@[simp]
theorem lift_generators : lift (satisfiesRelations_generators R) = LieHom.id := by
  ext <;> simp

/-- Lifting the zero data gives the zero homomorphism. -/
@[simp]
theorem lift_zero : lift (satisfiesRelations_zero (R := R) (L := L)) = 0 := by
  ext <;> simp

/-- The Cartan elements and the raising and lowering generators generate the presented algebra
as a Lie algebra. -/
theorem lieSpan_generators_eq_top :
    LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (cartanElement R) ∪
      Set.range (positiveGenerator R) ∪ Set.range (negativeGenerator R)) = ⊤ := by
  set S := LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (cartanElement R) ∪
    Set.range (positiveGenerator R) ∪ Set.range (negativeGenerator R))
  have hle : LieSubalgebra.lieSpan K (FreeLieAlgebra K (Generator I H))
      (Set.range (FreeLieAlgebra.of K)) ≤ S.comap (presentationMk R) := by
    refine LieSubalgebra.lieSpan_le.mpr ?_
    rintro _ ⟨g, rfl⟩
    refine LieSubalgebra.subset_lieSpan ?_
    cases g with
    | cartan x => exact Or.inl (Or.inl ⟨x, rfl⟩)
    | positive i => exact Or.inl (Or.inr ⟨i, rfl⟩)
    | negative i => exact Or.inr ⟨i, rfl⟩
  refine eq_top_iff.2 fun y _ => ?_
  obtain ⟨x, rfl⟩ := presentationMk_surjective R y
  exact hle (by rw [FreeLieAlgebra.lieSpan_range_of_eq_top]; trivial)

/-! ## The derived algebra and Serre's presentation

Mathlib's `Matrix.ToLieAlgebra K A` presents a Lie algebra on generators `hᵢ`, `eᵢ`, `fᵢ` alone. The
relations of the full realization restrict to its relations, giving a homomorphism
`TauCeti.KacMoody.serreHom` into the presented algebra. Its image is the derived algebra, and
together with the Cartan elements it spans the whole algebra. -/

section Serre

variable {R}

/-- Data satisfying the relations of the full realization restrict to a Serre system for `A` on
the images of the simple coroots. -/
theorem SatisfiesRelations.isSerreSystem (h : SatisfiesRelations R φ E F) :
    IsSerreSystem K A (fun i => φ (R.coroot i)) E F where
  lie_H_H _ _ := h.lie_cartan_cartan _ _
  lie_E_F_self := h.lie_positive_negative_self
  lie_E_F_of_ne := h.lie_positive_negative_of_ne
  lie_H_E i j := by simp [h.lie_cartan_positive, Int.cast_smul_eq_zsmul]
  lie_H_F i j := by simp [h.lie_cartan_negative, Int.cast_smul_eq_zsmul]
  ad_pow_lie_E_E := h.serre_positive
  ad_pow_lie_F_F := h.serre_negative

variable [DecidableEq I] (R)

/-- The homomorphism from Serre's presentation `Matrix.ToLieAlgebra K A` to the Kac–Moody algebra
of the realization `R`, sending `hᵢ`, `eᵢ`, `fᵢ` to the simple coroot `cartanElement R hᵢ` and to
the generators `eᵢ`, `fᵢ`. -/
noncomputable def serreHom : Matrix.ToLieAlgebra K A →ₗ⁅K⁆ PresentedLieAlgebra R :=
  serreLift (satisfiesRelations_generators R).isSerreSystem

/-- `TauCeti.KacMoody.serreHom` sends `hᵢ` to the simple coroot. -/
@[simp]
theorem serreHom_serreH (i : I) : serreHom R (serreH K A i) = cartanElement R (R.coroot i) :=
  serreLift_serreH _ i

/-- `TauCeti.KacMoody.serreHom` sends `eᵢ` to `eᵢ`. -/
@[simp]
theorem serreHom_serreE (i : I) : serreHom R (serreE K A i) = positiveGenerator R i :=
  serreLift_serreE _ i

/-- `TauCeti.KacMoody.serreHom` sends `fᵢ` to `fᵢ`. -/
@[simp]
theorem serreHom_serreF (i : I) : serreHom R (serreF K A i) = negativeGenerator R i :=
  serreLift_serreF _ i

/-- The image of Serre's presentation is the Lie subalgebra generated by the `eᵢ` and `fᵢ`. -/
theorem range_serreHom : (serreHom R).range = LieSubalgebra.lieSpan K (PresentedLieAlgebra R)
    (Set.range (positiveGenerator R) ∪ Set.range (negativeGenerator R)) := by
  rw [LieHom.range_eq_map, ← lieSpan_serreE_union_serreF_eq_top K A, LieSubalgebra.map_lieSpan,
    Set.image_union, ← Set.range_comp, ← Set.range_comp]
  congr <;> funext i <;> simp

/-- Bracketing with a Cartan element preserves the image of Serre's presentation. -/
private theorem lie_cartanElement_mem_range_serreHom (x : H) {y : PresentedLieAlgebra R}
    (hy : y ∈ (serreHom R).range) : ⁅cartanElement R x, y⁆ ∈ (serreHom R).range := by
  rw [range_serreHom] at hy ⊢
  induction hy using LieSubalgebra.lieSpan_induction with
  | mem y hy =>
    rcases hy with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · rw [lie_cartanElement_positiveGenerator]
      exact LieSubalgebra.smul_mem _ _ (LieSubalgebra.subset_lieSpan (Or.inl ⟨i, rfl⟩))
    · rw [lie_cartanElement_negativeGenerator]
      exact neg_mem (LieSubalgebra.smul_mem _ _ (LieSubalgebra.subset_lieSpan (Or.inr ⟨i, rfl⟩)))
  | zero => simp
  | add y z _ _ hy hz => simpa only [lie_add] using add_mem hy hz
  | smul c y _ hy => simpa only [lie_smul] using LieSubalgebra.smul_mem _ c hy
  | lie y z hy' hz' hy hz =>
    rw [leibniz_lie]
    exact add_mem (LieSubalgebra.lie_mem _ hy hz') (LieSubalgebra.lie_mem _ hy' hz)

/-- The bracket of two elements of `𝔤' + H` lies in `𝔤'`, the image of Serre's presentation. -/
private theorem lie_mem_range_serreHom {x y : PresentedLieAlgebra R}
    (hx : x ∈ (serreHom R).range.toSubmodule ⊔ LinearMap.range (cartanElement R))
    (hy : y ∈ (serreHom R).range.toSubmodule ⊔ LinearMap.range (cartanElement R)) :
    ⁅x, y⁆ ∈ (serreHom R).range := by
  obtain ⟨a, ha, _, ⟨u, rfl⟩, rfl⟩ := Submodule.mem_sup.mp hx
  obtain ⟨b, hb, _, ⟨v, rfl⟩, rfl⟩ := Submodule.mem_sup.mp hy
  have hav : ⁅a, cartanElement R v⁆ ∈ (serreHom R).range := by
    rw [← lie_skew]
    exact neg_mem (lie_cartanElement_mem_range_serreHom R v ha)
  simp only [add_lie, lie_add, lie_cartanElement_cartanElement, add_zero]
  exact add_mem (add_mem (LieSubalgebra.lie_mem _ ha hb)
    (lie_cartanElement_mem_range_serreHom R u hb)) hav

/-- The Kac–Moody algebra is the sum of the image `𝔤'` of Serre's presentation and the Cartan
elements: `𝔤 = 𝔤' + H`. -/
theorem range_serreHom_sup_range_cartanElement :
    (serreHom R).range.toSubmodule ⊔ LinearMap.range (cartanElement R) = ⊤ := by
  rw [eq_top_iff]
  rintro z -
  have hz : z ∈ LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (cartanElement R) ∪
      Set.range (positiveGenerator R) ∪ Set.range (negativeGenerator R)) := by
    rw [lieSpan_generators_eq_top]
    trivial
  induction hz using LieSubalgebra.lieSpan_induction with
  | mem y hy =>
    rcases hy with (⟨x, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩
    · exact Submodule.mem_sup_right ⟨x, rfl⟩
    · exact Submodule.mem_sup_left ⟨serreE K A i, serreHom_serreE R i⟩
    · exact Submodule.mem_sup_left ⟨serreF K A i, serreHom_serreF R i⟩
  | zero => exact zero_mem _
  | add y z _ _ hy hz => exact add_mem hy hz
  | smul c y _ hy => exact Submodule.smul_mem _ c hy
  | lie y z _ _ hy hz => exact Submodule.mem_sup_left (lie_mem_range_serreHom R hy hz)

/-- The image of Serre's presentation is the derived algebra `⁅𝔤, 𝔤⁆` of the Kac–Moody algebra. -/
theorem range_serreHom_eq_derivedSeries :
    (serreHom R).range =
      (derivedSeries K (PresentedLieAlgebra R) 1 : LieSubalgebra K (PresentedLieAlgebra R)) := by
  have hD : derivedSeries K (PresentedLieAlgebra R) 1 =
      ⁅(⊤ : LieIdeal K (PresentedLieAlgebra R)), ⊤⁆ := by
    rw [derivedSeries_def, derivedSeriesOfIdeal_succ, derivedSeriesOfIdeal_zero]
  refine le_antisymm ?_ fun y hy => ?_
  · rw [range_serreHom, LieSubalgebra.lieSpan_le, hD]
    rintro _ (⟨i, rfl⟩ | ⟨i, rfl⟩) <;>
      obtain ⟨x, hx⟩ : ∃ x, R.root i x = 1 := by
        obtain ⟨x, hx⟩ := DFunLike.ne_iff.mp (R.root_linearIndependent.ne_zero i)
        exact ⟨(R.root i x)⁻¹ • x, by simpa using inv_mul_cancel₀ hx⟩
    · have h := lie_cartanElement_positiveGenerator R x i
      rw [hx, one_smul] at h
      rw [SetLike.mem_coe, LieIdeal.mem_toLieSubalgebra, ← h]
      exact LieSubmodule.lie_mem_lie trivial trivial
    · have h := lie_cartanElement_negativeGenerator R x i
      rw [hx, one_smul, ← neg_eq_iff_eq_neg] at h
      rw [SetLike.mem_coe, LieIdeal.mem_toLieSubalgebra, ← h]
      exact neg_mem (LieSubmodule.lie_mem_lie trivial trivial)
  · rw [LieIdeal.mem_toLieSubalgebra, hD, ← LieSubmodule.mem_toSubmodule,
      LieSubmodule.lieIdeal_oper_eq_linear_span'] at hy
    refine Submodule.span_le.mpr ?_ hy
    rintro _ ⟨a, -, b, -, rfl⟩
    have hsup := range_serreHom_sup_range_cartanElement R
    exact lie_mem_range_serreHom R (hsup ▸ Submodule.mem_top) (hsup ▸ Submodule.mem_top)

