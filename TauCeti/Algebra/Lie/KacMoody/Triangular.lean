public import Mathlib.LinearAlgebra.Matrix.Cartan.Basic
public import TauCeti.Algebra.Lie.KacMoody.Basic

import TauCeti.Algebra.Lie.Abelian
import TauCeti.Algebra.Lie.KacMoody.Auxiliary
