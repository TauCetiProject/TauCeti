import TauCeti.Algebra.Lie.Sl2.WeightString

/-!
# The Chevalley involution, triangular decomposition, and weight spaces of `PresentedLieAlgebra`

Let `A` be a square matrix of integers indexed by a type `I` and `R` a realization of `A` on a
vector space `H` over a field `K` (`TauCeti.CartanRealization`). This file develops the basic
structural properties of the presented Kac–Moody algebra `TauCeti.KacMoody.PresentedLieAlgebra R`:

1. **The Chevalley involution** (`TauCeti.KacMoody.chevalleyInvolution`): the involutive Lie
   algebra automorphism sending `h ↦ -h`, `eᵢ ↦ -fᵢ`, and `fᵢ ↦ -eᵢ`.
2. **The triangular decomposition**
   (`TauCeti.KacMoody.nMinus_sup_range_cartanElement_sup_nPlus_eq_top`): pushing forward the Serre
   triangular decomposition of `Matrix.ToLieAlgebra K A` along `serreHom R` yields
   `𝔤 = 𝔫⁻ ⊔ H ⊔ 𝔫⁺`, where `𝔫⁺` and `𝔫⁻` are generated by `eᵢ` and `fᵢ` respectively.
3. **Simultaneous `H`-weight spaces** (`TauCeti.KacMoody.rootWeightSpace`): when `I` is finite and
   `CharZero K`, linear independence of the simple roots `R.root` makes `β ↦ ∑ k, β k • αₖ`
   (`TauCeti.KacMoody.rootCombination`) injective on `I → ℤ`. The simultaneous `H`-weight spaces
   `rootWeightSpace R β` are therefore independent (`TauCeti.KacMoody.iSupIndep_rootWeightSpace`)
   and span the whole algebra (`TauCeti.KacMoody.iSup_rootWeightSpace_eq_top`), so every
   `ad(H)`-invariant submodule splits into its `H`-weight components
   (`TauCeti.KacMoody.eq_iSup_inf_rootWeightSpace_of_lie_cartanElement_mem`).
4. **An ideal vanishing criterion**
   (`TauCeti.KacMoody.lieIdeal_eq_bot_of_disjoint_cartan_of_derived_eq_self`): when `A` has
   diagonal entries `2`, any Lie ideal `J` of `PresentedLieAlgebra R` meeting `H` trivially,
   satisfying `⁅𝔤', J'⁆ = J'` in the derived algebra `𝔤' = (serreHom R).range`, and annihilated by
   a strictly positive integer linear combination of the simple coroots must vanish. The proof
   decomposes `J = (J ∩ 𝔫⁻) ⊔ (J ∩ 𝔫⁺)` into Lie ideals, uses the Chevalley involution to reduce
   `J ∩ 𝔫⁻` to `J ∩ 𝔫⁺`, and applies an `sl₂` weight-2 lemma at a minimal-height weight space of
   `J ∩ 𝔫⁺`.

## Main definitions

* `TauCeti.KacMoody.chevalleyInvolution`: the Chevalley involution on `PresentedLieAlgebra R`.
* `TauCeti.KacMoody.nPlus` and `TauCeti.KacMoody.nMinus`: the subalgebras generated by `eᵢ` and
  `fᵢ`.
* `TauCeti.KacMoody.rootCombination`: the functional `∑ k, β k • αₖ` for `β : I → ℤ`.
* `TauCeti.KacMoody.rootWeightSpace`: the simultaneous `H`-weight space for weight `β : I → ℤ`.

## Main results

* `TauCeti.KacMoody.nMinus_sup_range_cartanElement_sup_nPlus_eq_top`: `𝔤 = 𝔫⁻ ⊔ H ⊔ 𝔫⁺`.
* `TauCeti.KacMoody.iSupIndep_rootWeightSpace` and `TauCeti.KacMoody.iSup_rootWeightSpace_eq_top`:
  `PresentedLieAlgebra R` is the direct sum of its `H`-weight spaces.
* `TauCeti.KacMoody.eq_iSup_inf_rootWeightSpace_of_lie_cartanElement_mem`: every `ad(H)`-invariant
  submodule splits into its `H`-weight components.
* `TauCeti.KacMoody.lieIdeal_eq_bot_of_disjoint_cartan_of_derived_eq_self`: vanishing of ideals
  disjoint from `H` that are fixed by `ad(𝔤')` and killed by a positive coroot combination.

## References

* V. G. Kac, *Infinite-Dimensional Lie Algebras*, 3rd ed., §§1.2–1.3 and §7.4.
-/

public section

open LieAlgebra LieModule Module Matrix

namespace TauCeti.KacMoody

/-! ### The Chevalley involution on `PresentedLieAlgebra` -/

section ChevalleyInvolution

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

private theorem ad_neg_pow_apply {L : Type*} [LieRing L] [LieAlgebra K L] (x y : L) (n : ℕ) :
    (ad K L (-x) ^ n) y = (-1 : K) ^ n • (ad K L x ^ n) y := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', mul_apply_eq_comp, ad_apply, neg_lie, ih, lie_smul, pow_succ', mul_smul,
      neg_one_smul, ← smul_neg, ← ad_apply (R := K), ← mul_apply_eq_comp, ← pow_succ', smul_neg]

/-- The negated swapped generators `(-h, -fᵢ, -eᵢ)` satisfy the Kac–Moody relations of `R`. -/
theorem satisfiesRelations_chevalleyInvolution :
    SatisfiesRelations R (-cartanElement R) (fun i ↦ -negativeGenerator R i)
      (fun i ↦ -positiveGenerator R i) where
  lie_cartan_cartan x y := by simp
  lie_cartan_positive x j := by simp
  lie_cartan_negative x j := by simp
  lie_positive_negative_self i := by
    simp [← lie_skew (negativeGenerator R i) (positiveGenerator R i)]
  lie_positive_negative_of_ne i j hij := by
    simp [← lie_skew (negativeGenerator R i) (positiveGenerator R j), hij.symm]
  serre_positive i j := by
    rw [neg_lie, lie_neg, neg_neg, ad_neg_pow_apply,
      ad_pow_lie_negativeGenerator_negativeGenerator, smul_zero]
  serre_negative i j := by
    rw [neg_lie, lie_neg, neg_neg, ad_neg_pow_apply,
      ad_pow_lie_positiveGenerator_positiveGenerator, smul_zero]

/-- **The Chevalley involution** on `PresentedLieAlgebra R`, sending `h ↦ -h`, `eᵢ ↦ -fᵢ`, and
`fᵢ ↦ -eᵢ`. -/
noncomputable def chevalleyInvolution :
    PresentedLieAlgebra R ≃ₗ⁅K⁆ PresentedLieAlgebra R :=
  let ω := lift (satisfiesRelations_chevalleyInvolution R)
  have hinv : ω.comp ω = LieHom.id := by
    ext x
    · simp [ω]
    · simp [ω]
    · simp [ω]
  { __ := ω
    invFun := ω
    left_inv x := DFunLike.congr_fun hinv x
    right_inv x := DFunLike.congr_fun hinv x }

@[simp]
theorem chevalleyInvolution_cartanElement (h : H) :
    chevalleyInvolution R (cartanElement R h) = -cartanElement R h :=
  lift_cartanElement (satisfiesRelations_chevalleyInvolution R) h

@[simp]
theorem chevalleyInvolution_positiveGenerator (i : I) :
    chevalleyInvolution R (positiveGenerator R i) = -negativeGenerator R i :=
  lift_positiveGenerator (satisfiesRelations_chevalleyInvolution R) i

@[simp]
theorem chevalleyInvolution_negativeGenerator (i : I) :
    chevalleyInvolution R (negativeGenerator R i) = -positiveGenerator R i :=
  lift_negativeGenerator (satisfiesRelations_chevalleyInvolution R) i

@[simp]
theorem chevalleyInvolution_symm :
    (chevalleyInvolution R).symm = chevalleyInvolution R := by
  ext x
  rfl

@[simp]
theorem chevalleyInvolution_chevalleyInvolution (x : PresentedLieAlgebra R) :
    chevalleyInvolution R (chevalleyInvolution R x) = x :=
  (chevalleyInvolution R).left_inv x

end ChevalleyInvolution

/-! ### The triangular decomposition of `PresentedLieAlgebra` -/

section Triangular

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- The positive nilpotent subalgebra `𝔫⁺` generated by the raising generators `eᵢ`. -/
noncomputable def nPlus : LieSubalgebra K (PresentedLieAlgebra R) :=
  LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (positiveGenerator R))

/-- The negative nilpotent subalgebra `𝔫⁻` generated by the lowering generators `fᵢ`. -/
noncomputable def nMinus : LieSubalgebra K (PresentedLieAlgebra R) :=
  LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (negativeGenerator R))

/-- The derived algebra `𝔤' = (serreHom R).range` decomposes triangularly as
`𝔫⁻ ⊔ span {hᵢ} ⊔ 𝔫⁺`. -/
private theorem range_serreHom_eq_triangular [DecidableEq I] :
    (serreHom R).range.toSubmodule =
      (nMinus R).toSubmodule ⊔
        Submodule.span K (Set.range fun i : I ↦ cartanElement R (R.coroot i)) ⊔
        (nPlus R).toSubmodule := by
  have hS := lieSpan_serreF_sup_span_serreH_sup_lieSpan_serreE_eq_top K A
  have hmap := congrArg (Submodule.map (serreHom R).toLinearMap) hS
  rw [Submodule.map_sup, Submodule.map_sup, Submodule.map_top, Submodule.map_span] at hmap
  have hE : (LieSubalgebra.lieSpan K (Matrix.ToLieAlgebra K A)
        (Set.range (serreE K A))).toSubmodule.map (serreHom R).toLinearMap =
      (nPlus R).toSubmodule := by
    change ((LieSubalgebra.lieSpan K _ _).map (serreHom R)).toSubmodule = (nPlus R).toSubmodule
    rw [LieSubalgebra.map_lieSpan, ← Set.range_comp]
    congr 3; funext i; exact serreHom_serreE R i
  have hF : (LieSubalgebra.lieSpan K (Matrix.ToLieAlgebra K A)
        (Set.range (serreF K A))).toSubmodule.map (serreHom R).toLinearMap =
      (nMinus R).toSubmodule := by
    change ((LieSubalgebra.lieSpan K _ _).map (serreHom R)).toSubmodule = (nMinus R).toSubmodule
    rw [LieSubalgebra.map_lieSpan, ← Set.range_comp]
    congr 3; funext i; exact serreHom_serreF R i
  have hH : (serreHom R).toLinearMap '' Set.range (serreH K A) =
      Set.range fun i : I ↦ cartanElement R (R.coroot i) := by
    rw [← Set.range_comp]
    congr 1; funext i; exact serreHom_serreH R i
  rw [hF, hH, hE] at hmap
  exact hmap.symm

/-- **The triangular decomposition of `PresentedLieAlgebra R`**: `𝔤 = 𝔫⁻ ⊔ H ⊔ 𝔫⁺`. -/
theorem nMinus_sup_range_cartanElement_sup_nPlus_eq_top :
    (nMinus R).toSubmodule ⊔ LinearMap.range (cartanElement R) ⊔ (nPlus R).toSubmodule = ⊤ := by
  classical
  have hcor : Submodule.span K (Set.range fun i : I ↦ cartanElement R (R.coroot i)) ≤
      LinearMap.range (cartanElement R) := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact ⟨R.coroot i, rfl⟩
  rw [eq_top_iff, ← range_serreHom_sup_range_cartanElement R, range_serreHom_eq_triangular R]
  refine sup_le (sup_le (sup_le ?_ ?_) ?_) ?_
  · exact le_sup_of_le_left le_sup_left
  · exact hcor.trans (le_sup_of_le_left le_sup_right)
  · exact le_sup_right
  · exact le_sup_of_le_left le_sup_right

end Triangular

/-! ### Simultaneous `H`-weight spaces -/

/-- The set of nonzero nonnegative root combinations in `I → ℤ`. -/
private def posWeights {I : Type*} : Set (I → ℤ) := {β | (∀ k, 0 ≤ β k) ∧ β ≠ 0}

/-- The set of nonzero nonpositive root combinations in `I → ℤ`. -/
private def negWeights {I : Type*} : Set (I → ℤ) := {β | (∀ k, β k ≤ 0) ∧ β ≠ 0}

private theorem posWeights_add {I : Type*} {β γ : I → ℤ}
    (hβ : β ∈ posWeights) (hγ : γ ∈ posWeights) : β + γ ∈ posWeights := by
  refine ⟨fun k ↦ add_nonneg (hβ.1 k) (hγ.1 k), fun hzero ↦ hβ.2 ?_⟩
  funext k
  have hk := congrFun hzero k
  simp only [Pi.add_apply, Pi.zero_apply] at hk ⊢
  have := hβ.1 k
  have := hγ.1 k
  omega

private theorem negWeights_add {I : Type*} {β γ : I → ℤ}
    (hβ : β ∈ negWeights) (hγ : γ ∈ negWeights) : β + γ ∈ negWeights := by
  refine ⟨fun k ↦ add_nonpos (hβ.1 k) (hγ.1 k), fun hzero ↦ hβ.2 ?_⟩
  funext k
  have hk := congrFun hzero k
  simp only [Pi.add_apply, Pi.zero_apply] at hk ⊢
  have := hβ.1 k
  have := hγ.1 k
  omega

section WeightSpaceDefs

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] [Fintype I] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- The `H`-weight linear functional `∑ k, β k • αₖ` attached to an integral root combination
`β : I → ℤ`. -/
noncomputable def rootCombination (β : I → ℤ) : Module.Dual K H :=
  ∑ k : I, (β k : K) • R.root k

theorem rootCombination_apply (β : I → ℤ) (h : H) :
    rootCombination R β h = ∑ k : I, (β k : K) * R.root k h := by
  simp [rootCombination]

theorem rootCombination_zero : rootCombination R 0 = 0 := by
  simp [rootCombination]

theorem rootCombination_add (β γ : I → ℤ) :
    rootCombination R (β + γ) = rootCombination R β + rootCombination R γ := by
  simp only [rootCombination, Pi.add_apply, Int.cast_add, add_smul, Finset.sum_add_distrib]

theorem rootCombination_single [DecidableEq I] (k : I) :
    rootCombination R (Pi.single k 1) = R.root k := by
  ext h
  rw [rootCombination_apply, Finset.sum_eq_single k]
  · simp
  · intro j _ hjk
    simp [Pi.single_eq_of_ne hjk]
  · intro hk
    exact absurd (Finset.mem_univ k) hk

theorem rootCombination_neg_single [DecidableEq I] (k : I) :
    rootCombination R (-Pi.single k 1) = -R.root k := by
  ext h
  rw [rootCombination_apply, Finset.sum_eq_single k]
  · simp
  · intro j _ hjk
    simp [Pi.single_eq_of_ne hjk]
  · intro hk
    exact absurd (Finset.mem_univ k) hk

/-- **The `H`-weight space of `PresentedLieAlgebra R`** for an integral root combination
`β : I → ℤ`: the simultaneous eigenspace of `ad (cartanElement R h)` with eigenvalue
`∑ k, β k * αₖ(h)`. -/
noncomputable def rootWeightSpace (β : I → ℤ) : Submodule K (PresentedLieAlgebra R) :=
  ⨅ h : H, (ad K (PresentedLieAlgebra R) (cartanElement R h)).eigenspace (rootCombination R β h)

theorem mem_rootWeightSpace_iff {β : I → ℤ} {x : PresentedLieAlgebra R} :
    x ∈ rootWeightSpace R β ↔
      ∀ h : H, ⁅cartanElement R h, x⁆ = rootCombination R β h • x := by
  simp [rootWeightSpace]

theorem cartanElement_mem_rootWeightSpace_zero (h : H) :
    cartanElement R h ∈ rootWeightSpace R 0 := by
  rw [mem_rootWeightSpace_iff]
  intro h'
  simp [rootCombination_zero]

theorem positiveGenerator_mem_rootWeightSpace [DecidableEq I] (k : I) :
    positiveGenerator R k ∈ rootWeightSpace R (Pi.single k 1) := by
  rw [mem_rootWeightSpace_iff]
  intro h
  rw [lie_cartanElement_positiveGenerator, rootCombination_single]

theorem negativeGenerator_mem_rootWeightSpace [DecidableEq I] (k : I) :
    negativeGenerator R k ∈ rootWeightSpace R (-Pi.single k 1) := by
  rw [mem_rootWeightSpace_iff]
  intro h
  rw [lie_cartanElement_negativeGenerator, rootCombination_neg_single, LinearMap.neg_apply,
    neg_smul]

/-- The Lie bracket adds `H`-weights. -/
theorem lie_mem_rootWeightSpace {β γ : I → ℤ} {x y : PresentedLieAlgebra R}
    (hx : x ∈ rootWeightSpace R β) (hy : y ∈ rootWeightSpace R γ) :
    ⁅x, y⁆ ∈ rootWeightSpace R (β + γ) := by
  rw [mem_rootWeightSpace_iff] at hx hy ⊢
  intro h
  rw [leibniz_lie, hx h, hy h, smul_lie, lie_smul, ← add_smul, rootCombination_add,
    LinearMap.add_apply]

/-- The `H`-weight spaces span the whole presented Kac–Moody algebra. -/
theorem iSup_rootWeightSpace_eq_top : ⨆ β : I → ℤ, rootWeightSpace R β = ⊤ := by
  classical
  have hlie : ∀ {x y : PresentedLieAlgebra R},
      x ∈ ⨆ β : I → ℤ, rootWeightSpace R β →
      y ∈ ⨆ β : I → ℤ, rootWeightSpace R β →
      ⁅x, y⁆ ∈ ⨆ β : I → ℤ, rootWeightSpace R β := by
    intro x y hx hy
    induction hx using Submodule.iSup_induction' with
    | mem β x hx =>
      induction hy using Submodule.iSup_induction' with
      | mem γ y hy =>
        exact Submodule.mem_iSup_of_mem (β + γ) (lie_mem_rootWeightSpace R hx hy)
      | zero => simp
      | add _ _ _ _ hy₁ hy₂ => rw [lie_add]; exact add_mem hy₁ hy₂
    | zero => simp
    | add _ _ _ _ hx₁ hx₂ => rw [add_lie]; exact add_mem hx₁ hx₂
  let S : LieSubalgebra K (PresentedLieAlgebra R) :=
    { toSubmodule := ⨆ β : I → ℤ, rootWeightSpace R β
      lie_mem' := fun hx hy ↦ hlie hx hy }
  have hS : S = ⊤ := by
    rw [eq_top_iff, ← lieSpan_generators_eq_top R, LieSubalgebra.lieSpan_le]
    rintro _ ((⟨h, rfl⟩ | ⟨k, rfl⟩) | ⟨k, rfl⟩)
    · exact Submodule.mem_iSup_of_mem 0 (cartanElement_mem_rootWeightSpace_zero R h)
    · exact Submodule.mem_iSup_of_mem (Pi.single k 1) (positiveGenerator_mem_rootWeightSpace R k)
    · exact Submodule.mem_iSup_of_mem (-Pi.single k 1) (negativeGenerator_mem_rootWeightSpace R k)
  rw [eq_top_iff]
  intro x _
  change x ∈ S
  rw [hS]
  exact LieSubalgebra.mem_top x

private theorem nPlus_le_biSup_rootWeightSpace :
    (nPlus R).toSubmodule ≤ ⨆ β ∈ posWeights (I := I), rootWeightSpace R β := by
  classical
  have hlie : ∀ {x y : PresentedLieAlgebra R},
      x ∈ ⨆ β ∈ posWeights (I := I), rootWeightSpace R β →
      y ∈ ⨆ β ∈ posWeights (I := I), rootWeightSpace R β →
      ⁅x, y⁆ ∈ ⨆ β ∈ posWeights (I := I), rootWeightSpace R β := by
    intro x y hx hy
    induction hx using Submodule.iSup_induction' with
    | mem β x hx =>
      induction hx using Submodule.iSup_induction' with
      | mem hβ x hx =>
        induction hy using Submodule.iSup_induction' with
        | mem γ y hy =>
          induction hy using Submodule.iSup_induction' with
          | mem hγ y hy =>
            exact Submodule.mem_iSup_of_mem (β + γ) <|
              Submodule.mem_iSup_of_mem (posWeights_add hβ hγ) (lie_mem_rootWeightSpace R hx hy)
          | zero => simp
          | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
        | zero => simp
        | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
      | zero => simp
      | add _ _ _ _ h₁ h₂ => rw [add_lie]; exact add_mem h₁ h₂
    | zero => simp
    | add _ _ _ _ h₁ h₂ => rw [add_lie]; exact add_mem h₁ h₂
  intro x hx
  induction hx using LieSubalgebra.lieSpan_induction with
  | mem _ hx =>
    obtain ⟨k, rfl⟩ := hx
    refine Submodule.mem_iSup_of_mem (Pi.single k 1) <|
      Submodule.mem_iSup_of_mem ⟨fun j ↦ by by_cases h : j = k <;> simp [h], fun h ↦ by
        simpa using congrFun h k⟩ (positiveGenerator_mem_rootWeightSpace R k)
  | zero => exact zero_mem _
  | add _ _ _ _ hx hy => exact add_mem hx hy
  | smul c _ _ hx => exact Submodule.smul_mem _ c hx
  | lie _ _ _ _ hx hy => exact hlie hx hy

private theorem nMinus_le_biSup_rootWeightSpace :
    (nMinus R).toSubmodule ≤ ⨆ β ∈ negWeights (I := I), rootWeightSpace R β := by
  classical
  have hlie : ∀ {x y : PresentedLieAlgebra R},
      x ∈ ⨆ β ∈ negWeights (I := I), rootWeightSpace R β →
      y ∈ ⨆ β ∈ negWeights (I := I), rootWeightSpace R β →
      ⁅x, y⁆ ∈ ⨆ β ∈ negWeights (I := I), rootWeightSpace R β := by
    intro x y hx hy
    induction hx using Submodule.iSup_induction' with
    | mem β x hx =>
      induction hx using Submodule.iSup_induction' with
      | mem hβ x hx =>
        induction hy using Submodule.iSup_induction' with
        | mem γ y hy =>
          induction hy using Submodule.iSup_induction' with
          | mem hγ y hy =>
            exact Submodule.mem_iSup_of_mem (β + γ) <|
              Submodule.mem_iSup_of_mem (negWeights_add hβ hγ) (lie_mem_rootWeightSpace R hx hy)
          | zero => simp
          | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
        | zero => simp
        | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
      | zero => simp
      | add _ _ _ _ h₁ h₂ => rw [add_lie]; exact add_mem h₁ h₂
    | zero => simp
    | add _ _ _ _ h₁ h₂ => rw [add_lie]; exact add_mem h₁ h₂
  intro x hx
  induction hx using LieSubalgebra.lieSpan_induction with
  | mem _ hx =>
    obtain ⟨k, rfl⟩ := hx
    refine Submodule.mem_iSup_of_mem (-Pi.single k 1) <|
      Submodule.mem_iSup_of_mem ⟨fun j ↦ by by_cases h : j = k <;> simp [h], fun h ↦ by
        simpa using congrFun h k⟩ (negativeGenerator_mem_rootWeightSpace R k)
  | zero => exact zero_mem _
  | add _ _ _ _ hx hy => exact add_mem hx hy
  | smul c _ _ hx => exact Submodule.smul_mem _ c hx
  | lie _ _ _ _ hx hy => exact hlie hx hy

end WeightSpaceDefs

section WeightSpaces

variable {I K H : Type*} [Field K] [CharZero K] [AddCommGroup H] [Module K H]
  [Fintype I] {A : Matrix I I ℤ} (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- Linear independence of the simple roots makes `β ↦ ∑ k, β k • αₖ` injective on `I → ℤ`. -/
theorem rootCombination_injective : Function.Injective (rootCombination R) := by
  intro β γ hβγ
  have hzero : ∑ k : I, ((β k : K) - (γ k : K)) • R.root k = 0 := by
    ext h
    have hβγh := congrArg (fun f : Module.Dual K H ↦ f h) hβγ
    simp only [LinearMap.coe_sum, Finset.sum_apply, LinearMap.smul_apply, smul_eq_mul,
      LinearMap.zero_apply, sub_mul, Finset.sum_sub_distrib]
    simpa only [rootCombination_apply, sub_eq_zero] using hβγh
  funext k
  have hk := Fintype.linearIndependent_iff.mp R.root_linearIndependent _ hzero k
  exact Int.cast_injective (sub_eq_zero.mp hk)

/-- The `H`-weight spaces for distinct integral root combinations are independent. -/
theorem iSupIndep_rootWeightSpace : iSupIndep (rootWeightSpace R) := by
  have hcomm : ∀ h₁ h₂ : H, Commute (ad K (PresentedLieAlgebra R) (cartanElement R h₁))
      (ad K (PresentedLieAlgebra R) (cartanElement R h₂)) := fun h₁ h₂ ↦
    (commute_iff_eq _ _).mpr <| LinearMap.ext fun z ↦ by
      simp only [mul_apply_eq_comp, ad_apply]
      rw [leibniz_lie, lie_cartanElement_cartanElement, zero_lie, zero_add]
  have hindep := Module.End.independent_iInf_maxGenEigenspace_of_forall_mapsTo
    (fun h : H ↦ ad K (PresentedLieAlgebra R) (cartanElement R h))
    fun h₁ h₂ φ ↦ Module.End.mapsTo_maxGenEigenspace_of_comm (hcomm h₂ h₁) φ
  refine (hindep.comp (f := fun β : I → ℤ ↦ (rootCombination R β : H → K)) fun β γ h ↦
    rootCombination_injective R (LinearMap.ext (congrFun h))).mono fun β ↦
    iInf_mono fun h ↦ Module.End.eigenspace_le_maxGenEigenspace

/-- **Every `ad(H)`-invariant submodule splits into its `H`-weight components.** -/
theorem eq_iSup_inf_rootWeightSpace_of_lie_cartanElement_mem
    (M : Submodule K (PresentedLieAlgebra R))
    (hM : ∀ (h : H) {x : PresentedLieAlgebra R}, x ∈ M → ⁅cartanElement R h, x⁆ ∈ M) :
    M = ⨆ β : I → ℤ, M ⊓ rootWeightSpace R β := by
  classical
  refine le_antisymm ?_ (iSup_le fun _ ↦ inf_le_left)
  have hcomp : ∀ n : ℕ, ∀ (s : Finset (I → ℤ)) (f : (I → ℤ) → PresentedLieAlgebra R),
      s.card ≤ n → (∀ β ∈ s, f β ∈ rootWeightSpace R β) →
      (∑ β ∈ s, f β) ∈ M → ∀ β ∈ s, f β ∈ M := by
    intro n
    induction n with
    | zero =>
      intro s f hcard _ _ β hβ
      exact absurd (Finset.card_pos.mpr ⟨β, hβ⟩) (by omega)
    | succ n ih =>
      intro s f hcard hf hsum β hβ
      by_cases hsub : ∃ γ ∈ s, γ ≠ β
      · obtain ⟨γ, hγ, hγβ⟩ := hsub
        have hne : rootCombination R γ ≠ rootCombination R β := fun heq ↦
          hγβ (rootCombination_injective R heq)
        obtain ⟨h, hh⟩ : ∃ h : H, rootCombination R γ h ≠ rootCombination R β h := by
          by_contra! hall
          exact hne (LinearMap.ext hall)
        let g : (I → ℤ) → PresentedLieAlgebra R := fun δ ↦
          (rootCombination R δ h - rootCombination R γ h) • f δ
        have hgM : (∑ δ ∈ s.erase γ, g δ) ∈ M := by
          have heq : ∑ δ ∈ s.erase γ, g δ =
              ⁅cartanElement R h, ∑ δ ∈ s, f δ⁆ - rootCombination R γ h • ∑ δ ∈ s, f δ := by
            rw [lie_sum, Finset.smul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_erase_add s _ hγ]
            have hγzero : ⁅cartanElement R h, f γ⁆ - rootCombination R γ h • f γ = 0 := by
              rw [(mem_rootWeightSpace_iff R).mp (hf γ hγ) h, sub_self]
            rw [hγzero, add_zero]
            refine Finset.sum_congr rfl fun δ hδ ↦ ?_
            rw [(mem_rootWeightSpace_iff R).mp (hf δ (Finset.mem_of_mem_erase hδ)) h, ← sub_smul]
          rw [heq]
          exact M.sub_mem (hM h hsum) (M.smul_mem _ hsum)
        have hcard' : (s.erase γ).card ≤ n := by
          have := Finset.card_erase_of_mem hγ
          omega
        have hβ' : β ∈ s.erase γ := Finset.mem_erase.mpr ⟨hγβ.symm, hβ⟩
        have hgf : ∀ δ ∈ s.erase γ, g δ ∈ rootWeightSpace R δ := fun δ hδ ↦
          (rootWeightSpace R δ).smul_mem _ (hf δ (Finset.mem_of_mem_erase hδ))
        have hgβ := ih (s.erase γ) g hcard' hgf hgM β hβ'
        have hnz : rootCombination R β h - rootCombination R γ h ≠ 0 := sub_ne_zero.mpr hh.symm
        simpa [g, hnz] using M.smul_mem (rootCombination R β h - rootCombination R γ h)⁻¹ hgβ
      · push Not at hsub
        have hs : s = {β} := Finset.eq_singleton_iff_unique_mem.mpr ⟨hβ, hsub⟩
        simpa [hs] using hsum
  intro x hx
  have hxtop : x ∈ ⨆ β : I → ℤ, rootWeightSpace R β := by
    rw [iSup_rootWeightSpace_eq_top]
    exact Submodule.mem_top
  obtain ⟨f, hf, rfl⟩ := (Submodule.mem_iSup_iff_exists_finsupp _ _).mp hxtop
  refine Submodule.sum_mem _ fun β hβ ↦ Submodule.mem_iSup_of_mem β ⟨?_, hf β⟩
  exact hcomp f.support.card f.support f le_rfl (fun δ _ ↦ hf δ) hx β hβ

private theorem rootWeightSpace_zero_eq :
    rootWeightSpace R 0 = LinearMap.range (cartanElement R) := by
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · have hmem : x ∈ (nMinus R).toSubmodule ⊔ LinearMap.range (cartanElement R) ⊔
        (nPlus R).toSubmodule := by
      rw [nMinus_sup_range_cartanElement_sup_nPlus_eq_top]
      exact Submodule.mem_top
    obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.mp hmem
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hab
    have h0mem : b ∈ rootWeightSpace R 0 := by
      obtain ⟨h, rfl⟩ := hb
      exact cartanElement_mem_rootWeightSpace_zero R h
    have hac0 : a + c = 0 := by
      have hdisj := (iSupIndep_rootWeightSpace R).disjoint_biSup
        (x := (0 : I → ℤ)) (y := negWeights ∪ posWeights) (by rintro (h | h) <;> exact h.2 rfl)
      refine (Submodule.disjoint_def.mp hdisj) (a + c) ?_ ?_
      · have := sub_mem hx h0mem
        rwa [add_right_comm, add_sub_cancel_right] at this
      · have hle1 : (⨆ β ∈ negWeights (I := I), rootWeightSpace R β) ≤
            ⨆ β ∈ negWeights (I := I) ∪ posWeights, rootWeightSpace R β :=
          biSup_mono Set.subset_union_left
        have hle2 : (⨆ β ∈ posWeights (I := I), rootWeightSpace R β) ≤
            ⨆ β ∈ negWeights (I := I) ∪ posWeights, rootWeightSpace R β :=
          biSup_mono Set.subset_union_right
        exact add_mem (hle1 (nMinus_le_biSup_rootWeightSpace R ha))
          (hle2 (nPlus_le_biSup_rootWeightSpace R hc))
    rwa [add_right_comm, hac0, zero_add]
  · rintro _ ⟨h, rfl⟩
    exact cartanElement_mem_rootWeightSpace_zero R h

private theorem rootWeightSpace_le_nPlus_of_isPos {β : I → ℤ} (hβ : β ∈ posWeights) :
    rootWeightSpace R β ≤ (nPlus R).toSubmodule := by
  intro x hx
  have hmem : x ∈ (nMinus R).toSubmodule ⊔ LinearMap.range (cartanElement R) ⊔
      (nPlus R).toSubmodule := by
    rw [nMinus_sup_range_cartanElement_sup_nPlus_eq_top]
    exact Submodule.mem_top
  obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.mp hmem
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hab
  have h0mem : b ∈ rootWeightSpace R 0 := by
    obtain ⟨h, rfl⟩ := hb
    exact cartanElement_mem_rootWeightSpace_zero R h
  have hc' : c ∈ ⨆ γ ∈ posWeights (I := I), rootWeightSpace R γ :=
    nPlus_le_biSup_rootWeightSpace R hc
  have hdisj : Disjoint (⨆ γ ∈ negWeights (I := I) ∪ {(0 : I → ℤ)}, rootWeightSpace R γ)
      (⨆ γ ∈ posWeights (I := I), rootWeightSpace R γ) := by
    refine (iSupIndep_rootWeightSpace R).disjoint_biSup_biSup ?_
    refine Set.disjoint_left.mpr fun γ hγ hδ ↦ ?_
    rcases hγ with hneg | rfl
    · exact hδ.2 (funext fun k ↦ le_antisymm (hneg.1 k) (hδ.1 k))
    · exact hδ.2 rfl
  have hab0 : a + b = 0 := by
    refine (Submodule.disjoint_def.mp hdisj) (a + b) ?_ ?_
    · have hle : (⨆ γ ∈ negWeights (I := I), rootWeightSpace R γ) ≤
          ⨆ γ ∈ negWeights (I := I) ∪ {(0 : I → ℤ)}, rootWeightSpace R γ :=
        biSup_mono Set.subset_union_left
      refine add_mem (hle (nMinus_le_biSup_rootWeightSpace R ha)) ?_
      exact Submodule.mem_iSup_of_mem 0
        (Submodule.mem_iSup_of_mem (Set.mem_union_right _ rfl) h0mem)
    · have hsub : a + b = (a + b + c) - c := by abel
      rw [hsub]
      exact sub_mem (Submodule.mem_iSup_of_mem β (Submodule.mem_iSup_of_mem hβ hx)) hc'
  rwa [hab0, zero_add]

private theorem rootWeightSpace_le_nMinus_of_isNeg {β : I → ℤ} (hβ : β ∈ negWeights) :
    rootWeightSpace R β ≤ (nMinus R).toSubmodule := by
  intro x hx
  have hmem : x ∈ (nMinus R).toSubmodule ⊔ LinearMap.range (cartanElement R) ⊔
      (nPlus R).toSubmodule := by
    rw [nMinus_sup_range_cartanElement_sup_nPlus_eq_top]
    exact Submodule.mem_top
  obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.mp hmem
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hab
  have h0mem : b ∈ rootWeightSpace R 0 := by
    obtain ⟨h, rfl⟩ := hb
    exact cartanElement_mem_rootWeightSpace_zero R h
  have hdisj : Disjoint (⨆ γ ∈ posWeights (I := I) ∪ {(0 : I → ℤ)}, rootWeightSpace R γ)
      (⨆ γ ∈ negWeights (I := I), rootWeightSpace R γ) := by
    refine (iSupIndep_rootWeightSpace R).disjoint_biSup_biSup ?_
    refine Set.disjoint_left.mpr fun γ hγ hδ ↦ ?_
    rcases hγ with hpos | rfl
    · exact hδ.2 (funext fun k ↦ le_antisymm (hδ.1 k) (hpos.1 k))
    · exact hδ.2 rfl
  have hbc0 : b + c = 0 := by
    refine (Submodule.disjoint_def.mp hdisj) (b + c) ?_ ?_
    · have hle : (⨆ γ ∈ posWeights (I := I), rootWeightSpace R γ) ≤
          ⨆ γ ∈ posWeights (I := I) ∪ {(0 : I → ℤ)}, rootWeightSpace R γ :=
        biSup_mono Set.subset_union_left
      refine add_mem ?_ (hle (nPlus_le_biSup_rootWeightSpace R hc))
      exact Submodule.mem_iSup_of_mem 0
        (Submodule.mem_iSup_of_mem (Set.mem_union_right _ rfl) h0mem)
    · have hsub : b + c = (a + b + c) - a := by abel
      rw [hsub]
      exact sub_mem (Submodule.mem_iSup_of_mem β (Submodule.mem_iSup_of_mem hβ hx))
        (nMinus_le_biSup_rootWeightSpace R ha)
  rwa [add_assoc, hbc0, add_zero]

private theorem rootWeightSpace_eq_bot_of_mixed {β : I → ℤ}
    (h0 : β ≠ 0) (hpos : β ∉ posWeights) (hneg : β ∉ negWeights) :
    rootWeightSpace R β = ⊥ := by
  let T : Set (I → ℤ) := negWeights ∪ {(0 : I → ℤ)} ∪ posWeights
  have htop : ⨆ γ ∈ T, rootWeightSpace R γ = ⊤ := by
    refine eq_top_iff.mpr fun x _ ↦ ?_
    have hmem : x ∈ (nMinus R).toSubmodule ⊔ LinearMap.range (cartanElement R) ⊔
        (nPlus R).toSubmodule := by
      rw [nMinus_sup_range_cartanElement_sup_nPlus_eq_top]
      exact Submodule.mem_top
    obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.mp hmem
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hab
    obtain ⟨h, rfl⟩ := hb
    have hleM : (⨆ γ ∈ negWeights (I := I), rootWeightSpace R γ) ≤
        ⨆ γ ∈ T, rootWeightSpace R γ :=
      biSup_mono (Set.subset_union_left.trans Set.subset_union_left)
    have hleP : (⨆ γ ∈ posWeights (I := I), rootWeightSpace R γ) ≤
        ⨆ γ ∈ T, rootWeightSpace R γ :=
      biSup_mono Set.subset_union_right
    exact add_mem
      (add_mem (hleM (nMinus_le_biSup_rootWeightSpace R ha))
        (Submodule.mem_iSup_of_mem 0
          (Submodule.mem_iSup_of_mem (Or.inl (Or.inr rfl))
            (cartanElement_mem_rootWeightSpace_zero R h))))
      (hleP (nPlus_le_biSup_rootWeightSpace R hc))
  have hβT : β ∉ T := by
    rintro ((h | h) | h)
    · exact hneg h
    · exact h0 h
    · exact hpos h
  have hd := (iSupIndep_rootWeightSpace R).disjoint_biSup hβT
  rwa [htop, disjoint_top] at hd

omit [Fintype I] in
private theorem disjoint_nMinus_nPlus [Finite I] :
    Disjoint (nMinus R).toSubmodule (nPlus R).toSubmodule := by
  let _ : Fintype I := Fintype.ofFinite I
  refine Disjoint.mono (nMinus_le_biSup_rootWeightSpace R) (nPlus_le_biSup_rootWeightSpace R) ?_
  refine (iSupIndep_rootWeightSpace R).disjoint_biSup_biSup ?_
  refine Set.disjoint_left.mpr fun γ hneg hpos ↦ ?_
  exact hpos.2 (funext fun k ↦ le_antisymm (hneg.1 k) (hpos.1 k))

/-! ### An `sl₂` weight-2 killing lemma and ideal vanishing -/

/-- If `(h, e, f)` is an `sl₂` triple and `w` has `h`-weight `2`, satisfies `⁅f, ⁅f, w⁆⁆ = 0`,
and both `w` and `⁅f, w⁆` are killed by powers of `ad e`, then `w = 0`. -/
private theorem eq_zero_of_isSl2Triple_weight_two {L : Type*} [LieRing L] [LieAlgebra K L]
    {h e f w : L} (t : IsSl2Triple h e f)
    (hhw : ⁅h, w⁆ = (2 : K) • w) (hffw : ⁅f, ⁅f, w⁆⁆ = 0)
    (hNe : ∃ N : ℕ, (ad K L e ^ N) ⁅f, w⁆ = 0)
    (hMw : ∃ M : ℕ, (ad K L e ^ M) w = 0) : w = 0 := by
  have hhu : ⁅h, ⁅f, w⁆⁆ = (0 : K) • ⁅f, w⁆ := by
    rw [leibniz_lie, t.lie_h_f_nsmul, hhw, ← Nat.cast_smul_eq_nsmul K, Nat.cast_ofNat, neg_lie,
      smul_lie, lie_smul, neg_add_cancel, zero_smul]
  have heu : ⁅e, ⁅f, w⁆⁆ = 0 := by
    obtain ⟨N, hN⟩ := hNe
    have hkill : ∀ k : ℕ, (ad K L e ^ (k + 1)) ⁅f, w⁆ = 0 → (ad K L e ^ 1) ⁅f, w⁆ = 0 := by
      intro k
      induction k with
      | zero => intro hk; exact hk
      | succ k ih =>
        intro hk
        apply ih
        have hcoeff := t.lie_f_pow_succ_toEnd_e (R := K) hhu hffw (k + 1)
        simp only [← ad_eq_toEnd] at hcoeff
        rw [show k + 1 + 1 = (k + 1) + 1 from rfl, hk, lie_zero] at hcoeff
        have hc : (((k + 1 : ℕ) : K) + 1) * (-0 - ((k + 1 : ℕ) : K)) ≠ 0 := by
          push_cast
          have h1 : (k : K) + 1 + 1 ≠ 0 := by exact_mod_cast (show k + 1 + 1 ≠ 0 by omega)
          have h2 : -((k : K) + 1) ≠ 0 :=
            neg_ne_zero.mpr (by exact_mod_cast (show k + 1 ≠ 0 by omega))
          simpa using mul_ne_zero h1 h2
        exact (smul_eq_zero.mp hcoeff.symm).resolve_left (by simpa using hc)
    rcases N with _ | N
    · simp only [pow_zero, one_apply_eq_self] at hN
      rw [hN, lie_zero]
    · simpa using hkill N hN
  have hhpow : ∀ k : ℕ, ⁅h, (ad K L e ^ k) w⁆ = (2 * ((k : K) + 1)) • (ad K L e ^ k) w := by
    intro k
    induction k with
    | zero => simpa using hhw
    | succ k ih =>
      rw [pow_succ', mul_apply_eq_comp, ad_apply, leibniz_lie, t.lie_h_e_nsmul,
        ← Nat.cast_smul_eq_nsmul K, Nat.cast_ofNat, smul_lie, ih, lie_smul, ← add_smul]
      congr 1
      push_cast
      ring
  have hfpow : ∀ k : ℕ, ⁅f, (ad K L e ^ (k + 1)) w⁆ =
      -((((k + 1) * (k + 2) : ℕ) : K)) • (ad K L e ^ k) w := by
    intro k
    induction k with
    | zero =>
      rw [pow_one, ad_apply, leibniz_lie, ← lie_skew f e, t.lie_e_f, neg_lie, hhw, heu, add_zero]
      simp [neg_smul]
    | succ k ih =>
      rw [pow_succ', mul_apply_eq_comp, ad_apply, leibniz_lie, ← lie_skew f e, t.lie_e_f,
        neg_lie, hhpow (k + 1), ih, lie_smul,
        ← ad_apply (R := K) (L := L) e, ← mul_apply_eq_comp, ← pow_succ', ← neg_smul, ← add_smul]
      congr 1
      push_cast
      ring
  obtain ⟨M, hM⟩ := hMw
  induction M with
  | zero => simpa using hM
  | succ M ih =>
    apply ih
    have h0 := hfpow M
    rw [hM, lie_zero] at h0
    have hnz : -((((M + 1) * (M + 2) : ℕ) : K)) ≠ 0 :=
      neg_ne_zero.mpr (Nat.cast_ne_zero.mpr (by positivity))
    exact (smul_eq_zero.mp h0.symm).resolve_left hnz

/-- If `J : LieIdeal K (PresentedLieAlgebra R)` lies in `𝔫⁺`, is fixed by bracketing with `𝔤'`,
and is annihilated by a strictly positive integer combination of simple coroots, then `J = ⊥`. -/
private theorem lieIdeal_eq_bot_of_le_nPlus_of_derived_eq_self [DecidableEq I]
    (hdiag : ∀ k : I, A k k = 2)
    {J : LieIdeal K (PresentedLieAlgebra R)}
    (hJplus : J.toSubmodule ≤ (nPlus R).toSubmodule)
    (hJder : ⁅(⊤ : LieIdeal K (serreHom R).range),
      LieIdeal.comap (serreHom R).range.incl J⁆ =
      LieIdeal.comap (serreHom R).range.incl J)
    {a : I → ℤ} (ha : ∀ k, 0 < a k)
    (hkill : ∀ u ∈ J, ⁅cartanElement R (∑ k : I, (a k : K) • R.coroot k), u⁆ = 0) :
    J = ⊥ := by
  classical
  by_contra hne
  have hsplit := eq_iSup_inf_rootWeightSpace_of_lie_cartanElement_mem R J.toSubmodule
    fun h _ hx ↦ J.lie_mem hx
  have hpos_of_ne : ∀ β : I → ℤ, J.toSubmodule ⊓ rootWeightSpace R β ≠ ⊥ → β ∈ posWeights := by
    intro β hβ
    by_contra hnot
    apply hβ
    rw [eq_bot_iff]
    rintro x ⟨hxJ, hxβ⟩
    have hxplus : x ∈ ⨆ γ ∈ posWeights (I := I), rootWeightSpace R γ :=
      nPlus_le_biSup_rootWeightSpace R (hJplus hxJ)
    exact (Submodule.disjoint_def.mp ((iSupIndep_rootWeightSpace R).disjoint_biSup hnot)) x hxβ
      hxplus
  -- Choose a nonzero weight `β` of `J` with minimal height `∑ k, (β k).toNat`.
  have hex : ∃ n : ℕ, ∃ β : I → ℤ, (∑ k : I, (β k).toNat) = n ∧
      J.toSubmodule ⊓ rootWeightSpace R β ≠ ⊥ := by
    by_contra! hall
    apply hne
    rw [← LieSubmodule.toSubmodule_inj, LieSubmodule.bot_toSubmodule, hsplit]
    exact iSup_eq_bot.mpr fun β ↦ hall _ β rfl
  set n₀ := Nat.find hex
  obtain ⟨β, hβht, hβne⟩ := Nat.find_spec hex
  have hβpos : β ∈ posWeights := hpos_of_ne β hβne
  have hmin : ∀ γ : I → ℤ, (∑ k : I, (γ k).toNat) < n₀ →
      J.toSubmodule ⊓ rootWeightSpace R γ = ⊥ := fun γ hlt ↦ by
    by_contra hγne
    exact Nat.find_min hex hlt ⟨γ, rfl, hγne⟩
  have hlower_bot : ∀ k : I, J.toSubmodule ⊓ rootWeightSpace R (β - Pi.single k 1) = ⊥ := by
    intro k
    by_cases hpos' : β - Pi.single k 1 ∈ posWeights
    · apply hmin (β - Pi.single k 1)
      rw [show n₀ = ∑ k : I, (β k).toNat from hβht.symm]
      refine Finset.sum_lt_sum (fun j _ ↦ ?_) ⟨k, Finset.mem_univ k, ?_⟩
      · by_cases hjk : j = k
        · subst hjk; simp only [Pi.sub_apply, Pi.single_eq_same]; have := hβpos.1 j; omega
        · simp [Pi.single_eq_of_ne hjk]
      · simp only [Pi.sub_apply, Pi.single_eq_same]
        have h1 := hpos'.1 k
        simp only [Pi.sub_apply, Pi.single_eq_same] at h1
        have := hβpos.1 k
        omega
    · by_contra hne'
      exact hpos' (hpos_of_ne _ hne')
  have hfk_zero : ∀ k : I, ∀ u ∈ J.toSubmodule ⊓ rootWeightSpace R β,
      ⁅negativeGenerator R k, u⁆ = 0 := by
    intro k u ⟨huJ, huβ⟩
    have hmem :
        ⁅negativeGenerator R k, u⁆ ∈ J.toSubmodule ⊓ rootWeightSpace R (β - Pi.single k 1) := by
      refine ⟨J.lie_mem huJ, ?_⟩
      rw [sub_eq_add_neg, add_comm]
      exact lie_mem_rootWeightSpace R (negativeGenerator_mem_rootWeightSpace R k) huβ
    rwa [hlower_bot k, Submodule.mem_bot] at hmem
  obtain ⟨u₀, hu₀mem, hu₀ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hβne
  -- Local nilpotence of `ad eₖ` on `𝔤'`, pushed forward from `Matrix.ToLieAlgebra K A`.
  have heng : ∀ k : I, ∀ v ∈ (serreHom R).range,
      ∃ N : ℕ, (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ N) v = 0 := by
    rintro k _ ⟨w, rfl⟩
    have hmem : w ∈ LieSubalgebra.engel K (serreE K A k) := by
      rw [engel_serreE_eq_top K A k]; trivial
    obtain ⟨N, hN⟩ := (LieSubalgebra.mem_engel_iff K _ _).mp hmem
    refine ⟨N, ?_⟩
    have h := congrArg (serreHom R) hN
    rwa [LieHom.map_ad_pow, serreHom_serreE, map_zero] at h
  -- First show `β(hₖ) = -(rₖ : K)` for some `rₖ : ℕ`, for every `k : I`.
  have hβ_coroot_neg_nat : ∀ k : I, ∃ r : ℕ, rootCombination R β (R.coroot k) = -(r : K) := by
    intro k
    have hu₀' : u₀ ∈ (serreHom R).range := by
      rw [← LieSubalgebra.mem_toSubmodule, range_serreHom_eq_triangular R]
      exact Submodule.mem_sup_right (hJplus hu₀mem.1)
    obtain ⟨N, hN⟩ := heng k u₀ hu₀'
    have hex_nz : ∃ m : ℕ, (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ m) u₀ ≠ 0 ∧
        (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ (m + 1)) u₀ = 0 := by
      have h0 : (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ 0) u₀ ≠ 0 := by
        simpa using hu₀ne
      have hfin : ∃ m : ℕ, (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ m) u₀ = 0 :=
        ⟨N, hN⟩
      let m₁ := Nat.find hfin
      have hm₁ : (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ m₁) u₀ = 0 :=
        Nat.find_spec hfin
      have hm₁_pos : 0 < m₁ := by
        by_contra h
        have : m₁ = 0 := by omega
        exact h0 (this ▸ hm₁)
      refine ⟨m₁ - 1, Nat.find_min hfin (by omega), ?_⟩
      rwa [Nat.sub_add_cancel hm₁_pos]
    obtain ⟨r, hrne, hrzero⟩ := hex_nz
    have hlow : ∀ m : ℕ, ⁅negativeGenerator R k,
        (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ (m + 1)) u₀⁆ =
        (((m : K) + 1) * (-rootCombination R β (R.coroot k) - (m : K))) •
          (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ m) u₀ := by
      intro m
      induction m with
      | zero =>
        rw [pow_one, ad_apply, leibniz_lie, ← lie_skew (negativeGenerator R k),
          lie_positiveGenerator_negativeGenerator_self, neg_lie,
          (mem_rootWeightSpace_iff R).mp hu₀mem.2 (R.coroot k), hfk_zero k u₀ hu₀mem, lie_zero,
          add_zero, pow_zero, one_apply_eq_self]
        simp [neg_smul]
      | succ m ih =>
        have hhm : ⁅cartanElement R (R.coroot k),
            (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ (m + 1)) u₀⁆ =
            (rootCombination R β (R.coroot k) + 2 * ((m : K) + 1)) •
              (ad K (PresentedLieAlgebra R) (positiveGenerator R k) ^ (m + 1)) u₀ := by
          clear ih hrne hrzero
          induction m with
          | zero =>
            rw [pow_one, ad_apply, leibniz_lie, lie_cartanElement_positiveGenerator,
              R.root_coroot, Matrix.map_apply, hdiag k, Int.cast_ofNat, smul_lie,
              (mem_rootWeightSpace_iff R).mp hu₀mem.2 (R.coroot k), lie_smul, ← add_smul]
            congr 1; ring
          | succ m ihm =>
            rw [pow_succ', mul_apply_eq_comp, ad_apply, leibniz_lie,
              lie_cartanElement_positiveGenerator, R.root_coroot, Matrix.map_apply, hdiag k,
              Int.cast_ofNat, smul_lie, ihm, lie_smul, ← add_smul]
            congr 1; push_cast; ring
        rw [pow_succ', mul_apply_eq_comp, ad_apply, leibniz_lie,
          ← lie_skew (negativeGenerator R k), lie_positiveGenerator_negativeGenerator_self, neg_lie,
          hhm, ih, lie_smul,
          ← ad_apply (R := K) (L := PresentedLieAlgebra R) (positiveGenerator R k),
          ← mul_apply_eq_comp, ← pow_succ', ← neg_smul, ← add_smul]
        congr 1
        push_cast
        ring
    have hr := hlow r
    rw [hrzero, lie_zero] at hr
    have hcoeff0 : ((r : K) + 1) * (-rootCombination R β (R.coroot k) - (r : K)) = 0 :=
      (smul_eq_zero.mp hr.symm).resolve_right hrne
    have hnz : (r : K) + 1 ≠ 0 := by exact_mod_cast (Nat.succ_ne_zero r)
    have hval := (mul_eq_zero.mp hcoeff0).resolve_left hnz
    exact ⟨r, by linear_combination -hval⟩
  choose r hr using hβ_coroot_neg_nat
  -- Since `∑ aₖ hₖ` kills `u₀ ∈ J ∩ W_β` and `aₖ > 0`, every `r k = 0`, so `β(hₖ) = 0`.
  have hβ_coroot_zero : ∀ k : I, rootCombination R β (R.coroot k) = 0 := by
    have hsum0 : (∑ k : I, (a k : K) * rootCombination R β (R.coroot k)) • u₀ = 0 := by
      have hk := hkill u₀ hu₀mem.1
      rw [(mem_rootWeightSpace_iff R).mp hu₀mem.2, map_sum] at hk
      simpa only [map_smul, smul_eq_mul] using hk
    have hsumK : ∑ k : I, (a k : K) * (-(r k : K)) = 0 := by
      simpa only [hr] using (smul_eq_zero.mp hsum0).resolve_right hu₀ne
    have hsumZ : ∑ k : I, a k * (r k : ℤ) = 0 := by
      simp only [mul_neg, Finset.sum_neg_distrib, neg_eq_zero] at hsumK
      exact Int.cast_injective (α := K) (by push_cast; exact hsumK)
    have hnonneg : ∀ k ∈ Finset.univ, (0 : ℤ) ≤ a k * (r k : ℤ) := fun k _ ↦
      mul_nonneg (ha k).le (Int.natCast_nonneg _)
    intro k
    have hterm : a k * (r k : ℤ) = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg hnonneg).mp hsumZ k (Finset.mem_univ k)
    have hrk : r k = 0 := by
      have := (mul_eq_zero.mp hterm).resolve_left (ha k).ne'
      exact_mod_cast this
    rw [hr k, hrk, Nat.cast_zero, neg_zero]
  -- Use `⁅𝔤', J'⁆ = J'` to write `u₀` as a sum of `⁅fₖ, wₖ⁆` with `wₖ ∈ J ∩ W_{β + εₖ}`.
  have hu₀_in_S : u₀ ∈ ⨆ k : I,
      (J.toSubmodule ⊓ rootWeightSpace R (β + Pi.single k 1)).map
        (ad K (PresentedLieAlgebra R) (negativeGenerator R k)) := by
    let S : Submodule K (PresentedLieAlgebra R) :=
      ⨆ k : I, J.toSubmodule.map (ad K (PresentedLieAlgebra R) (negativeGenerator R k))
    have hnMinus_S : ∀ x ∈ nMinus R, ∀ v ∈ J, ⁅x, v⁆ ∈ S := by
      intro x hx
      induction hx using LieSubalgebra.lieSpan_induction with
      | mem _ hx =>
        obtain ⟨k, rfl⟩ := hx
        intro v hv
        exact Submodule.mem_iSup_of_mem k ⟨v, hv, rfl⟩
      | zero => intro v _; simp
      | add x y _ _ hx hy => intro v hv; rw [add_lie]; exact add_mem (hx v hv) (hy v hv)
      | smul c x _ hx => intro v hv; rw [smul_lie]; exact S.smul_mem c (hx v hv)
      | lie x y _ _ hx hy =>
        intro v hv
        rw [lie_lie]
        exact sub_mem (hx _ (J.lie_mem hv)) (hy _ (J.lie_mem hv))
    have hu₀_range : u₀ ∈ (serreHom R).range := by
      rw [← LieSubalgebra.mem_toSubmodule, range_serreHom_eq_triangular R]
      exact Submodule.mem_sup_right (hJplus hu₀mem.1)
    have hu₀' : (⟨u₀, hu₀_range⟩ : (serreHom R).range) ∈
        ⁅(⊤ : LieIdeal K (serreHom R).range), LieIdeal.comap (serreHom R).range.incl J⁆ := by
      rw [hJder]
      exact hu₀mem.1
    rw [← LieSubmodule.mem_toSubmodule, LieSubmodule.lieIdeal_oper_eq_linear_span'] at hu₀'
    let Target : Submodule K (PresentedLieAlgebra R) :=
      ⨆ k : I, (J.toSubmodule ⊓ rootWeightSpace R (β + Pi.single k 1)).map
        (ad K (PresentedLieAlgebra R) (negativeGenerator R k))
    let Rest : Submodule K (PresentedLieAlgebra R) :=
      ⨆ γ ∈ ({γ : I → ℤ | γ ≠ β} : Set (I → ℤ)), rootWeightSpace R γ
    have hTarget_le : Target ≤ rootWeightSpace R β := by
      refine iSup_le fun k ↦ ?_
      rintro _ ⟨w, ⟨_, hw⟩, rfl⟩
      have hmem := lie_mem_rootWeightSpace R (negativeGenerator_mem_rootWeightSpace R k) hw
      rwa [show -Pi.single k 1 + (β + Pi.single k 1) = β by abel] at hmem
    have hS_le : S ≤ Target ⊔ Rest := by
      refine iSup_le fun k ↦ ?_
      rintro _ ⟨w, hwJ, rfl⟩
      have hwsplit : w ∈ ⨆ δ : I → ℤ, J.toSubmodule ⊓ rootWeightSpace R δ := by
        rw [← hsplit]; exact hwJ
      clear hwJ
      induction hwsplit using Submodule.iSup_induction' with
      | mem δ w hw =>
        by_cases hδ : δ = β + Pi.single k 1
        · subst hδ
          exact Submodule.mem_sup_left (Submodule.mem_iSup_of_mem k ⟨w, hw, rfl⟩)
        · refine Submodule.mem_sup_right (Submodule.mem_iSup_of_mem (-Pi.single k 1 + δ) <|
            Submodule.mem_iSup_of_mem ?_
              (lie_mem_rootWeightSpace R (negativeGenerator_mem_rootWeightSpace R k) hw.2))
          intro heq
          apply hδ
          rw [← heq]
          abel
      | zero => simp
      | add _ _ _ _ h₁ h₂ => simp only [ad_apply, lie_add] at h₁ h₂ ⊢; exact add_mem h₁ h₂
    have hcoroot_mem : ∀ {b v : PresentedLieAlgebra R},
        b ∈ Submodule.span K (Set.range fun i : I ↦ cartanElement R (R.coroot i)) →
        v ∈ ⨆ δ : I → ℤ, J.toSubmodule ⊓ rootWeightSpace R δ →
        ⁅b, v⁆ ∈ Target ⊔ Rest := by
      intro b v hb hvsplit
      induction hvsplit using Submodule.iSup_induction' with
      | mem δ w hw =>
        by_cases hδ : δ = β
        · subst hδ
          have hbw : ⁅b, w⁆ = 0 := by
            induction hb using Submodule.span_induction with
            | mem _ hb =>
              obtain ⟨i, rfl⟩ := hb
              rw [(mem_rootWeightSpace_iff R).mp hw.2 (R.coroot i), hβ_coroot_zero i, zero_smul]
            | zero => simp
            | add _ _ _ _ h₁ h₂ => rw [add_lie, h₁, h₂, add_zero]
            | smul c _ _ h => rw [smul_lie, h, smul_zero]
          rw [hbw]
          exact zero_mem _
        · have hb0 : b ∈ rootWeightSpace R 0 := by
            rw [rootWeightSpace_zero_eq R]
            refine Submodule.span_le.mpr ?_ hb
            rintro _ ⟨i, rfl⟩
            exact ⟨R.coroot i, rfl⟩
          have hmem : ⁅b, w⁆ ∈ rootWeightSpace R δ := by
            simpa using lie_mem_rootWeightSpace R hb0 hw.2
          exact Submodule.mem_sup_right (Submodule.mem_iSup_of_mem δ
            (Submodule.mem_iSup_of_mem hδ hmem))
      | zero => simp
      | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
    have hnPlus_mem : ∀ {c v : PresentedLieAlgebra R},
        c ∈ ⨆ γ ∈ posWeights (I := I), rootWeightSpace R γ →
        v ∈ ⨆ δ : I → ℤ, J.toSubmodule ⊓ rootWeightSpace R δ →
        ⁅c, v⁆ ∈ Target ⊔ Rest := by
      intro c v hc' hvsplit
      induction hc' using Submodule.iSup_induction' with
      | mem γ c hcγ =>
        induction hcγ using Submodule.iSup_induction' with
        | mem hγ c hcγ =>
          induction hvsplit using Submodule.iSup_induction' with
          | mem δ w hw =>
            by_cases hw0 : w = 0
            · simp [hw0]
            · have hδne : J.toSubmodule ⊓ rootWeightSpace R δ ≠ ⊥ := fun hbot ↦
                hw0 (by rwa [hbot, Submodule.mem_bot] at hw)
              have hδpos : δ ∈ posWeights := hpos_of_ne δ hδne
              have hδge : n₀ ≤ ∑ k : I, (δ k).toNat := by
                by_contra hlt
                exact hδne (hmin δ (by omega))
              have hγpos_ht : 0 < ∑ k : I, (γ k).toNat := by
                obtain ⟨k, hk⟩ : ∃ k, γ k ≠ 0 := by
                  by_contra! h0
                  exact hγ.2 (funext h0)
                have hk1 := hγ.1 k
                exact Finset.sum_pos' (fun _ _ ↦ Nat.zero_le _) ⟨k, Finset.mem_univ k, by omega⟩
              have hne_β : γ + δ ≠ β := by
                intro heq
                have hsum_eq : ∑ k : I, ((γ + δ) k).toNat =
                    (∑ k : I, (γ k).toNat) + (∑ k : I, (δ k).toNat) := by
                  rw [← Finset.sum_add_distrib]
                  refine Finset.sum_congr rfl fun k _ ↦ ?_
                  have := hγ.1 k
                  have := hδpos.1 k
                  simp only [Pi.add_apply]
                  omega
                rw [heq, hβht] at hsum_eq
                omega
              exact Submodule.mem_sup_right (Submodule.mem_iSup_of_mem (γ + δ)
                (Submodule.mem_iSup_of_mem hne_β (lie_mem_rootWeightSpace R hcγ hw.2)))
          | zero => simp
          | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
        | zero => simp
        | add _ _ _ _ h₁ h₂ => rw [add_lie]; exact add_mem h₁ h₂
      | zero => simp
      | add _ _ _ _ h₁ h₂ => rw [add_lie]; exact add_mem h₁ h₂
    have hbracket : ∀ (x : PresentedLieAlgebra R), x ∈ (serreHom R).range →
        ∀ v ∈ J, ⁅x, v⁆ ∈ Target ⊔ Rest := by
      intro x hx v hv
      rw [← LieSubalgebra.mem_toSubmodule, range_serreHom_eq_triangular R] at hx
      obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.mp hx
      obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hab
      have hvsplit : v ∈ ⨆ δ : I → ℤ, J.toSubmodule ⊓ rootWeightSpace R δ := by
        rw [← hsplit]; exact hv
      rw [add_lie, add_lie]
      exact add_mem (add_mem (hS_le (hnMinus_S a ha v hv)) (hcoroot_mem hb hvsplit))
        (hnPlus_mem (nPlus_le_biSup_rootWeightSpace R hc) hvsplit)
    have hu₀_sup : u₀ ∈ Target ⊔ Rest := by
      refine Submodule.span_induction (p := fun y _ ↦ y.1 ∈ Target ⊔ Rest) ?_ ?_ ?_ ?_ hu₀'
      · rintro _ ⟨x, -, v, hv, rfl⟩
        exact hbracket x.1 x.2 v.1 hv
      · exact zero_mem _
      · intro _ _ _ _ h₁ h₂
        exact add_mem h₁ h₂
      · intro c _ _ h
        exact Submodule.smul_mem _ c h
    obtain ⟨t, ht, r, hr, htr⟩ := Submodule.mem_sup.mp hu₀_sup
    have hr0 : r = 0 := by
      have hdisj := (iSupIndep_rootWeightSpace R).disjoint_biSup
        (x := β) (y := {γ : I → ℤ | γ ≠ β}) (fun h ↦ h rfl)
      have hrW : r ∈ rootWeightSpace R β := by
        have : r = u₀ - t := by rw [← htr]; abel
        rw [this]
        exact sub_mem hu₀mem.2 (hTarget_le ht)
      exact (Submodule.disjoint_def.mp hdisj) r hrW hr
    rw [hr0, add_zero] at htr
    rwa [← htr]
  -- Each term `⁅fₖ, wₖ⁆` with `wₖ ∈ J ∩ W_{β + εₖ}` vanishes by the `sl₂` weight-2 lemma.
  have htarget_bot : (⨆ k : I,
      (J.toSubmodule ⊓ rootWeightSpace R (β + Pi.single k 1)).map
        (ad K (PresentedLieAlgebra R) (negativeGenerator R k))) = ⊥ := by
    rw [iSup_eq_bot]
    intro k
    rw [eq_bot_iff]
    rintro _ ⟨w, ⟨hwJ, hwβ⟩, rfl⟩
    rw [Submodule.mem_bot, ad_apply]
    have hhw : ⁅cartanElement R (R.coroot k), w⁆ = (2 : K) • w := by
      rw [(mem_rootWeightSpace_iff R).mp hwβ (R.coroot k), rootCombination_add,
        LinearMap.add_apply, hβ_coroot_zero k, zero_add, rootCombination_single, R.root_coroot,
        Matrix.map_apply, hdiag k, Int.cast_ofNat]
    by_cases hhk0 : cartanElement R (R.coroot k) = 0
    · rw [hhk0, zero_lie] at hhw
      have hw0 : w = 0 := (smul_eq_zero.mp hhw.symm).resolve_left two_ne_zero
      rw [hw0, lie_zero]
    · have ht : IsSl2Triple (cartanElement R (R.coroot k)) (positiveGenerator R k)
          (negativeGenerator R k) :=
        { h_ne_zero := hhk0
          lie_e_f := lie_positiveGenerator_negativeGenerator_self R k
          lie_h_e_nsmul := by
            rw [lie_cartanElement_positiveGenerator, R.root_coroot, Matrix.map_apply, hdiag k,
              Int.cast_ofNat, ← Nat.cast_smul_eq_nsmul K, Nat.cast_ofNat]
          lie_h_f_nsmul := by
            rw [lie_cartanElement_negativeGenerator, R.root_coroot, Matrix.map_apply, hdiag k,
              Int.cast_ofNat, ← Nat.cast_smul_eq_nsmul K, Nat.cast_ofNat] }
      have hfw_mem : ⁅negativeGenerator R k, w⁆ ∈ J.toSubmodule ⊓ rootWeightSpace R β := by
        refine ⟨J.lie_mem hwJ, ?_⟩
        have hmem := lie_mem_rootWeightSpace R (negativeGenerator_mem_rootWeightSpace R k) hwβ
        rwa [show -Pi.single k 1 + (β + Pi.single k 1) = β by abel] at hmem
      have hffw : ⁅negativeGenerator R k, ⁅negativeGenerator R k, w⁆⁆ = 0 :=
        hfk_zero k _ hfw_mem
      have hw' : w ∈ (serreHom R).range := by
        rw [← LieSubalgebra.mem_toSubmodule, range_serreHom_eq_triangular R]
        exact Submodule.mem_sup_right (hJplus hwJ)
      have hfw' : ⁅negativeGenerator R k, w⁆ ∈ (serreHom R).range := by
        rw [← LieSubalgebra.mem_toSubmodule, range_serreHom_eq_triangular R]
        exact Submodule.mem_sup_right (hJplus hfw_mem.1)
      have hw0 := eq_zero_of_isSl2Triple_weight_two ht hhw hffw (heng k _ hfw') (heng k _ hw')
      rw [hw0, lie_zero]
  rw [htarget_bot, Submodule.mem_bot] at hu₀_in_S
  exact hu₀ne hu₀_in_S

omit [Fintype I] in
/-- For any Lie ideal `J` meeting `H` trivially, `J ⊓ 𝔫⁺` is closed under brackets with `𝔤`. -/
private theorem lie_mem_inf_nPlus [Finite I] {J : LieIdeal K (PresentedLieAlgebra R)}
    (hJcartan : J.toSubmodule ⊓ LinearMap.range (cartanElement R) = ⊥) :
    ∀ x : PresentedLieAlgebra R, ∀ u ∈ J.toSubmodule ⊓ (nPlus R).toSubmodule,
      ⁅x, u⁆ ∈ J.toSubmodule ⊓ (nPlus R).toSubmodule := by
  classical
  let _ : Fintype I := Fintype.ofFinite I
  have hsplit := eq_iSup_inf_rootWeightSpace_of_lie_cartanElement_mem R J.toSubmodule
    fun h _ hx ↦ J.lie_mem hx
  have hzero_bot : J.toSubmodule ⊓ rootWeightSpace R 0 = ⊥ := by
    rwa [rootWeightSpace_zero_eq R]
  have hpos_split : ∀ {u : PresentedLieAlgebra R},
      u ∈ J.toSubmodule ⊓ (nPlus R).toSubmodule →
      u ∈ ⨆ β ∈ posWeights (I := I), J.toSubmodule ⊓ rootWeightSpace R β := by
    rintro u ⟨huJ, huP⟩
    have h1 : u ∈ ⨆ β : I → ℤ, J.toSubmodule ⊓ rootWeightSpace R β := by
      rw [← hsplit]; exact huJ
    have h2 := nPlus_le_biSup_rootWeightSpace R huP
    obtain ⟨f, hf, rfl⟩ := (Submodule.mem_iSup_iff_exists_finsupp _ _).mp h1
    refine Submodule.sum_mem _ fun β hβ ↦ ?_
    by_cases hβp : β ∈ posWeights
    · exact Submodule.mem_iSup_of_mem β (Submodule.mem_iSup_of_mem hβp (hf β))
    · have hdisj := (iSupIndep_rootWeightSpace R).disjoint_biSup
        (x := β) (y := {γ : I → ℤ | γ ≠ β}) (fun h ↦ h rfl)
      have hzero : f β = 0 := by
        have hsum_eq : f β =
            (∑ γ ∈ f.support, f γ) - ∑ γ ∈ f.support.erase β, f γ := by
          rw [← Finset.sum_erase_add f.support _ hβ]; abel
        have hmem_other : ∑ γ ∈ f.support.erase β, f γ ∈
            ⨆ γ ∈ ({γ : I → ℤ | γ ≠ β} : Set (I → ℤ)), rootWeightSpace R γ :=
          Submodule.sum_mem _ fun γ hγ ↦
            Submodule.mem_iSup_of_mem γ
              (Submodule.mem_iSup_of_mem (Finset.ne_of_mem_erase hγ) (hf γ).2)
        have hpos_le : (⨆ γ ∈ posWeights (I := I), rootWeightSpace R γ) ≤
            ⨆ γ ∈ ({γ : I → ℤ | γ ≠ β} : Set (I → ℤ)), rootWeightSpace R γ :=
          biSup_mono fun γ hγ heq ↦ hβp (heq ▸ hγ)
        refine (Submodule.disjoint_def.mp hdisj) _ (hf β).2 ?_
        rw [hsum_eq]
        exact sub_mem (hpos_le h2) hmem_other
      rw [hzero]
      exact zero_mem _
  have hcartan_mem : ∀ (h : H) {u : PresentedLieAlgebra R},
      u ∈ ⨆ β ∈ posWeights (I := I), J.toSubmodule ⊓ rootWeightSpace R β →
      ⁅cartanElement R h, u⁆ ∈ (nPlus R).toSubmodule := by
    intro h u hu_w
    induction hu_w using Submodule.iSup_induction' with
    | mem β y hy =>
      induction hy using Submodule.iSup_induction' with
      | mem hβ y hy =>
        rw [(mem_rootWeightSpace_iff R).mp hy.2 h]
        exact (nPlus R).smul_mem _ (rootWeightSpace_le_nPlus_of_isPos R hβ hy.2)
      | zero => simp
      | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
    | zero => simp
    | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
  have hneg_mem : ∀ (k : I) {u : PresentedLieAlgebra R},
      u ∈ ⨆ β ∈ posWeights (I := I), J.toSubmodule ⊓ rootWeightSpace R β →
      ⁅negativeGenerator R k, u⁆ ∈ (nPlus R).toSubmodule := by
    intro k u hu_w
    induction hu_w using Submodule.iSup_induction' with
    | mem β y hy =>
      induction hy using Submodule.iSup_induction' with
      | mem hβ y hy =>
        have hmem : ⁅negativeGenerator R k, y⁆ ∈
            J.toSubmodule ⊓ rootWeightSpace R (-Pi.single k 1 + β) :=
          ⟨J.lie_mem hy.1,
            lie_mem_rootWeightSpace R (negativeGenerator_mem_rootWeightSpace R k) hy.2⟩
        by_cases hpos' : -Pi.single k 1 + β ∈ posWeights
        · exact rootWeightSpace_le_nPlus_of_isPos R hpos' hmem.2
        · by_cases h0' : -Pi.single k 1 + β = 0
          · rw [h0', hzero_bot, Submodule.mem_bot] at hmem
            rw [hmem]; exact zero_mem _
          · have hneg' : -Pi.single k 1 + β ∉ negWeights := by
              intro hneg'
              have hk : ∀ j ≠ k, β j = 0 := fun j hjk ↦ by
                have h1 := hβ.1 j
                have h2 := hneg'.1 j
                simp only [Pi.add_apply, Pi.neg_apply, Pi.single_eq_of_ne hjk, neg_zero,
                  zero_add] at h2
                omega
              have hbk := hβ.1 k
              have h2 := hneg'.1 k
              simp only [Pi.add_apply, Pi.neg_apply, Pi.single_eq_same] at h2
              by_cases hbk0 : β k = 0
              · exact hβ.2 (funext fun j ↦ by by_cases hjk : j = k <;> simp [hjk, hbk0, hk])
              · apply h0'
                funext j
                by_cases hjk : j = k
                · subst hjk
                  simp only [Pi.add_apply, Pi.neg_apply, Pi.single_eq_same, Pi.zero_apply]
                  omega
                · simp [Pi.single_eq_of_ne hjk, hk j hjk]
            have hbot : ⁅negativeGenerator R k, y⁆ ∈ rootWeightSpace R (-Pi.single k 1 + β) :=
              hmem.2
            rw [rootWeightSpace_eq_bot_of_mixed R h0' hpos' hneg', Submodule.mem_bot] at hbot
            rw [hbot]
            exact zero_mem _
      | zero => simp
      | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
    | zero => simp
    | add _ _ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
  intro x
  have hx : x ∈ LieSubalgebra.lieSpan K (PresentedLieAlgebra R)
      (Set.range (cartanElement R) ∪ Set.range (positiveGenerator R) ∪
        Set.range (negativeGenerator R)) := by
    rw [lieSpan_generators_eq_top R]; trivial
  induction hx using LieSubalgebra.lieSpan_induction with
  | mem _ hx =>
    rintro u ⟨huJ, huP⟩
    rcases hx with (⟨h, rfl⟩ | ⟨k, rfl⟩) | ⟨k, rfl⟩
    · exact ⟨J.lie_mem huJ, hcartan_mem h (hpos_split ⟨huJ, huP⟩)⟩
    · exact ⟨J.lie_mem huJ, LieSubalgebra.lie_mem _
        (LieSubalgebra.subset_lieSpan (Set.mem_range_self k)) huP⟩
    · exact ⟨J.lie_mem huJ, hneg_mem k (hpos_split ⟨huJ, huP⟩)⟩
  | zero => intro u _; simp
  | add _ _ _ _ hx hy => intro u hu; rw [add_lie]; exact add_mem (hx u hu) (hy u hu)
  | smul c _ _ hx => intro u hu; rw [smul_lie]; exact Submodule.smul_mem _ c (hx u hu)
  | lie _ _ _ _ hx hy =>
    intro u hu
    rw [lie_lie]
    exact sub_mem (hx _ (hy u hu)) (hy _ (hx u hu))

omit [Fintype I] in
/-- For any Lie ideal `J` meeting `H` trivially, `J ⊓ 𝔫⁺` is itself a Lie ideal of
`PresentedLieAlgebra R`. -/
private noncomputable def idealInfNPlus [Finite I] {J : LieIdeal K (PresentedLieAlgebra R)}
    (hJcartan : J.toSubmodule ⊓ LinearMap.range (cartanElement R) = ⊥) :
    LieIdeal K (PresentedLieAlgebra R) where
  toSubmodule := J.toSubmodule ⊓ (nPlus R).toSubmodule
  lie_mem {x m} hm := lie_mem_inf_nPlus R hJcartan x m hm

/-- **General ideal vanishing criterion on `PresentedLieAlgebra R`**: if `J` is a Lie ideal
meeting `H` trivially, satisfying `⁅𝔤', J'⁆ = J'` in the derived algebra `𝔤'`, and annihilated by
a strictly positive integer combination of the simple coroots, then `J = ⊥`. -/
theorem lieIdeal_eq_bot_of_disjoint_cartan_of_derived_eq_self [DecidableEq I]
    (hdiag : ∀ k : I, A k k = 2)
    {J : LieIdeal K (PresentedLieAlgebra R)}
    (hJcartan : J.toSubmodule ⊓ LinearMap.range (cartanElement R) = ⊥)
    (hJder : ⁅(⊤ : LieIdeal K (serreHom R).range),
      LieIdeal.comap (serreHom R).range.incl J⁆ =
      LieIdeal.comap (serreHom R).range.incl J)
    {a : I → ℤ} (ha : ∀ k, 0 < a k)
    (hkill : ∀ u ∈ J, ⁅cartanElement R (∑ k : I, (a k : K) • R.coroot k), u⁆ = 0) :
    J = ⊥ := by
  let ω := chevalleyInvolution R
  have hω_nMinus : (nMinus R).map ω.toLieHom = nPlus R := by
    rw [nMinus, nPlus, LieSubalgebra.map_lieSpan, ← Set.range_comp]
    refine le_antisymm (LieSubalgebra.lieSpan_le.mpr ?_) (LieSubalgebra.lieSpan_le.mpr ?_)
    · rintro _ ⟨k, rfl⟩
      simpa [ω] using neg_mem (LieSubalgebra.subset_lieSpan (Set.mem_range_self k) :
        positiveGenerator R k ∈ LieSubalgebra.lieSpan K _ (Set.range (positiveGenerator R)))
    · rintro _ ⟨k, rfl⟩
      have hk : -positiveGenerator R k ∈
          LieSubalgebra.lieSpan K _ (Set.range (ω.toLieHom ∘ negativeGenerator R)) :=
        LieSubalgebra.subset_lieSpan ⟨k, by simp [ω]⟩
      simpa using neg_mem hk
  have hω_nPlus : (nPlus R).map ω.toLieHom = nMinus R := by
    rw [nPlus, nMinus, LieSubalgebra.map_lieSpan, ← Set.range_comp]
    refine le_antisymm (LieSubalgebra.lieSpan_le.mpr ?_) (LieSubalgebra.lieSpan_le.mpr ?_)
    · rintro _ ⟨k, rfl⟩
      simpa [ω] using neg_mem (LieSubalgebra.subset_lieSpan (Set.mem_range_self k) :
        negativeGenerator R k ∈ LieSubalgebra.lieSpan K _ (Set.range (negativeGenerator R)))
    · rintro _ ⟨k, rfl⟩
      have hk : -negativeGenerator R k ∈
          LieSubalgebra.lieSpan K _ (Set.range (ω.toLieHom ∘ positiveGenerator R)) :=
        LieSubalgebra.subset_lieSpan ⟨k, by simp [ω]⟩
      simpa using neg_mem hk
  -- Conjugate `J` by `ω` to construct `Jminus = J ⊓ 𝔫⁻` as a Lie ideal.
  let Jω : LieIdeal K (PresentedLieAlgebra R) := LieIdeal.comap ω.toLieHom J
  have hJω_cartan : Jω.toSubmodule ⊓ LinearMap.range (cartanElement R) = ⊥ := by
    rw [eq_bot_iff]
    rintro z ⟨hzJω, ⟨h, rfl⟩⟩
    rw [Submodule.mem_bot]
    have hneg : cartanElement R (-h) ∈ J.toSubmodule ⊓ LinearMap.range (cartanElement R) := by
      refine ⟨?_, -h, rfl⟩
      simpa [Jω, ω] using hzJω
    rw [hJcartan, Submodule.mem_bot, map_neg, neg_eq_zero] at hneg
    exact hneg
  let Jplus : LieIdeal K (PresentedLieAlgebra R) := idealInfNPlus R hJcartan
  let Jωplus : LieIdeal K (PresentedLieAlgebra R) := idealInfNPlus R hJω_cartan
  let Jminus : LieIdeal K (PresentedLieAlgebra R) := LieIdeal.comap ω.toLieHom Jωplus
  have hJminus_mem : ∀ x, x ∈ Jminus ↔ x ∈ J ∧ x ∈ nMinus R := fun x ↦ by
    have h1 : x ∈ Jminus ↔ x ∈ J ∧ ω x ∈ nPlus R := by
      simp [Jminus, Jωplus, idealInfNPlus, Jω, ω]
    rw [h1]
    constructor
    · rintro ⟨hxJ, hxP⟩
      refine ⟨hxJ, ?_⟩
      have hback : ω (ω x) ∈ (nPlus R).map ω.toLieHom := ⟨ω x, hxP, rfl⟩
      simpa [ω, hω_nPlus] using hback
    · rintro ⟨hxJ, hxM⟩
      refine ⟨hxJ, ?_⟩
      rw [← hω_nMinus]
      exact ⟨x, hxM, rfl⟩
  -- Every element of `J` decomposes into `Jminus ⊔ Jplus`.
  have hJ_eq : J = Jminus ⊔ Jplus := by
    refine le_antisymm ?_ (sup_le (fun x hx ↦ (hJminus_mem x).mp hx |>.1) (fun x hx ↦ hx.1))
    have hsplit := eq_iSup_inf_rootWeightSpace_of_lie_cartanElement_mem R J.toSubmodule
      fun h _ hx ↦ J.lie_mem hx
    have hzero_bot : J.toSubmodule ⊓ rootWeightSpace R 0 = ⊥ := by
      rwa [rootWeightSpace_zero_eq R]
    have hle : (⨆ β : I → ℤ, J.toSubmodule ⊓ rootWeightSpace R β) ≤
        (Jminus ⊔ Jplus).toSubmodule := by
      refine iSup_le fun β y hy ↦ ?_
      by_cases hpos : β ∈ posWeights
      · exact LieSubmodule.mem_sup_right ⟨hy.1, rootWeightSpace_le_nPlus_of_isPos R hpos hy.2⟩
      · by_cases hneg : β ∈ negWeights
        · exact LieSubmodule.mem_sup_left <|
            (hJminus_mem y).mpr ⟨hy.1, rootWeightSpace_le_nMinus_of_isNeg R hneg hy.2⟩
        · by_cases h0 : β = 0
          · subst h0
            rw [hzero_bot, Submodule.mem_bot] at hy
            rw [hy]; exact zero_mem _
          · have hy0 : y ∈ rootWeightSpace R β := hy.2
            rw [rootWeightSpace_eq_bot_of_mixed R h0 hpos hneg, Submodule.mem_bot] at hy0
            rw [hy0]; exact zero_mem _
    intro x hx
    exact hle (hsplit ▸ hx)
  -- Pull back `J = Jminus ⊔ Jplus` to `𝔤' = (serreHom R).range`.
  let ι := (serreHom R).range.incl
  let J' : LieIdeal K (serreHom R).range := LieIdeal.comap ι J
  let Jplus' : LieIdeal K (serreHom R).range := LieIdeal.comap ι Jplus
  let Jminus' : LieIdeal K (serreHom R).range := LieIdeal.comap ι Jminus
  have hJ'_eq : J' = Jminus' ⊔ Jplus' := by
    refine le_antisymm ?_ (sup_le (fun x hx ↦ (hJminus_mem x.1).mp hx |>.1) (fun x hx ↦ hx.1))
    intro x hx
    have hx' : x.1 ∈ Jminus ⊔ Jplus := hJ_eq ▸ hx
    obtain ⟨u, hu, v, hv, huv⟩ := (LieSubmodule.mem_sup _ _ x.1).mp hx'
    have hu' : u ∈ (serreHom R).range := by
      rw [← LieSubalgebra.mem_toSubmodule, range_serreHom_eq_triangular R]
      exact Submodule.mem_sup_left (Submodule.mem_sup_left ((hJminus_mem u).mp hu).2)
    have hv' : v ∈ (serreHom R).range := by
      rw [← LieSubalgebra.mem_toSubmodule, range_serreHom_eq_triangular R]
      exact Submodule.mem_sup_right hv.2
    exact (LieSubmodule.mem_sup _ _ x).mpr ⟨⟨u, hu'⟩, hu, ⟨v, hv'⟩, hv, Subtype.ext huv⟩
  have hdisj' : Disjoint Jminus' Jplus' := by
    rw [disjoint_iff, eq_bot_iff]
    rintro x ⟨hxm, hxp⟩
    rw [LieSubmodule.mem_bot]
    exact Subtype.ext ((Submodule.disjoint_def.mp (disjoint_nMinus_nPlus R)) x.1
      ((hJminus_mem x.1).mp hxm).2 hxp.2)
  have hsplit_der :
      ⁅(⊤ : LieIdeal K (serreHom R).range), Jminus'⁆ = Jminus' ∧
      ⁅(⊤ : LieIdeal K (serreHom R).range), Jplus'⁆ = Jplus' := by
    have hsup : ⁅(⊤ : LieIdeal K (serreHom R).range), Jminus'⁆ ⊔
        ⁅(⊤ : LieIdeal K (serreHom R).range), Jplus'⁆ = Jminus' ⊔ Jplus' := by
      rw [← LieSubmodule.lie_sup, ← hJ'_eq]
      exact hJder
    have hleM : ⁅(⊤ : LieIdeal K (serreHom R).range), Jminus'⁆ ≤ Jminus' :=
      LieSubmodule.lie_le_right _ _
    have hleP : ⁅(⊤ : LieIdeal K (serreHom R).range), Jplus'⁆ ≤ Jplus' :=
      LieSubmodule.lie_le_right _ _
    constructor
    · refine le_antisymm hleM fun x hx ↦ ?_
      have hxsup : x ∈ ⁅(⊤ : LieIdeal K (serreHom R).range), Jminus'⁆ ⊔
          ⁅(⊤ : LieIdeal K (serreHom R).range), Jplus'⁆ :=
        hsup.symm ▸ LieSubmodule.mem_sup_left hx
      obtain ⟨a, ha, b, hb, rfl⟩ := (LieSubmodule.mem_sup _ _ x).mp hxsup
      have hb0 : b = 0 := by
        have hb_mem : b ∈ Jminus' ⊓ Jplus' := by
          refine ⟨?_, hleP hb⟩
          have : b = (a + b) - a := by abel
          rw [this]
          exact sub_mem hx (hleM ha)
        rwa [hdisj'.eq_bot, LieSubmodule.mem_bot] at hb_mem
      rwa [hb0, add_zero]
    · refine le_antisymm hleP fun x hx ↦ ?_
      have hxsup : x ∈ ⁅(⊤ : LieIdeal K (serreHom R).range), Jminus'⁆ ⊔
          ⁅(⊤ : LieIdeal K (serreHom R).range), Jplus'⁆ :=
        hsup.symm ▸ LieSubmodule.mem_sup_right hx
      obtain ⟨a, ha, b, hb, rfl⟩ := (LieSubmodule.mem_sup _ _ x).mp hxsup
      have ha0 : a = 0 := by
        have ha_mem : a ∈ Jminus' ⊓ Jplus' := by
          refine ⟨hleM ha, ?_⟩
          have : a = (a + b) - b := by abel
          rw [this]
          exact sub_mem hx (hleP hb)
        rwa [hdisj'.eq_bot, LieSubmodule.mem_bot] at ha_mem
      rwa [ha0, zero_add]
  -- Apply the positive vanishing lemma to `Jplus`.
  have hJplus_bot : Jplus = ⊥ :=
    lieIdeal_eq_bot_of_le_nPlus_of_derived_eq_self R hdiag inf_le_right hsplit_der.2 ha
      fun u hu ↦ hkill u hu.1
  -- Restrict `ω` to an automorphism `ω'` of `𝔤'` to transfer `⁅𝔤', Jminus'⁆ = Jminus'` to `Jωplus`.
  have hω_mem_range : ∀ x ∈ (serreHom R).range, ω x ∈ (serreHom R).range := by
    intro x hx
    rw [range_serreHom] at hx ⊢
    induction hx using LieSubalgebra.lieSpan_induction with
    | mem _ h =>
      rcases h with ⟨k, rfl⟩ | ⟨k, rfl⟩
      · simpa [ω] using neg_mem (LieSubalgebra.subset_lieSpan (Or.inr ⟨k, rfl⟩) :
          negativeGenerator R k ∈ LieSubalgebra.lieSpan K _ _)
      · simpa [ω] using neg_mem (LieSubalgebra.subset_lieSpan (Or.inl ⟨k, rfl⟩) :
          positiveGenerator R k ∈ LieSubalgebra.lieSpan K _ _)
    | zero => simp
    | add _ _ _ _ h₁ h₂ => rw [map_add]; exact add_mem h₁ h₂
    | smul c _ _ h => rw [map_smul]; exact LieSubalgebra.smul_mem _ c h
    | lie _ _ _ _ h₁ h₂ => rw [LieEquiv.map_lie]; exact LieSubalgebra.lie_mem _ h₁ h₂
  let ω' : (serreHom R).range ≃ₗ⁅K⁆ (serreHom R).range :=
    { toFun := fun x ↦ ⟨ω x.1, hω_mem_range x.1 x.2⟩
      invFun := fun x ↦ ⟨ω x.1, hω_mem_range x.1 x.2⟩
      left_inv := fun x ↦ Subtype.ext (chevalleyInvolution_chevalleyInvolution R x.1)
      right_inv := fun x ↦ Subtype.ext (chevalleyInvolution_chevalleyInvolution R x.1)
      map_add' := fun x y ↦ Subtype.ext (map_add ω x.1 y.1)
      map_smul' := fun c x ↦ Subtype.ext (map_smul ω c x.1)
      map_lie' := fun {x y} ↦ Subtype.ext (LieEquiv.map_lie ω x.1 y.1) }
  have hJωplus_der : ⁅(⊤ : LieIdeal K (serreHom R).range),
      LieIdeal.comap ι Jωplus⁆ = LieIdeal.comap ι Jωplus := by
    have hmap_top : LieIdeal.map ω'.toLieHom (⊤ : LieIdeal K (serreHom R).range) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have h : ω' (ω' x) ∈ LieIdeal.map ω'.toLieHom ⊤ :=
        LieIdeal.mem_map (LieSubmodule.mem_top (ω' x))
      have hxx : ω' (ω' x) = x := Subtype.ext (chevalleyInvolution_chevalleyInvolution R x.1)
      rwa [hxx] at h
    have hmap_J : LieIdeal.map ω'.toLieHom Jminus' = LieIdeal.comap ι Jωplus := by
      ext x
      rw [LieIdeal.mem_map_equiv]
      change ω (ω x.1) ∈ Jωplus ↔ x.1 ∈ Jωplus
      simp [ω]
    have h := congrArg (LieIdeal.map ω'.toLieHom) hsplit_der.1
    rw [LieIdeal.map_bracket_eq ω'.toLieHom ω'.surjective, hmap_top, hmap_J] at h
    exact h
  have hJωplus_kill : ∀ u ∈ Jωplus,
      ⁅cartanElement R (∑ k : I, (a k : K) • R.coroot k), u⁆ = 0 := by
    intro u hu
    have hωu : ω u ∈ J := hu.1
    have hc := hkill (ω u) hωu
    have hωc : ω ⁅cartanElement R (∑ k : I, (a k : K) • R.coroot k), ω u⁆ = 0 := by
      rw [hc, map_zero]
    rw [LieEquiv.map_lie, chevalleyInvolution_cartanElement,
      chevalleyInvolution_chevalleyInvolution, neg_lie, neg_eq_zero] at hωc
    exact hωc
  have hJωplus_bot : Jωplus = ⊥ :=
    lieIdeal_eq_bot_of_le_nPlus_of_derived_eq_self R hdiag inf_le_right hJωplus_der ha hJωplus_kill
  have hJminus_bot : Jminus = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    change ω x ∈ Jωplus at hx
    rw [hJωplus_bot, LieSubmodule.mem_bot] at hx
    rw [LieSubmodule.mem_bot]
    exact ω.injective (by simpa using hx)
  rw [hJ_eq, hJminus_bot, hJplus_bot, bot_sup_eq]

end WeightSpaces

