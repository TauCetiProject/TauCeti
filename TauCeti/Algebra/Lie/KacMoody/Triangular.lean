public import TauCeti.Algebra.Lie.KacMoody.Basic
-- Proof-only: Serre triangular decomposition, Engel nilpotence, and `sl₂` lowest-weight calculus.
import Mathlib.LinearAlgebra.Eigenspace.Pi
