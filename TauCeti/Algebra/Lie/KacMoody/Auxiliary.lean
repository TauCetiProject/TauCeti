/-!
# The auxiliary Kac–Moody presentation and Kac's representation

Let `R` be a realization of an integral matrix `A` over a field `K`. This file introduces the Serre
ideal `TauCeti.KacMoody.serreIdeal` of `FreeLieAlgebra K I` and the canonical homomorphisms
`TauCeti.KacMoody.positiveQuotientHom` and `TauCeti.KacMoody.negativeQuotientHom` from
`FreeLieAlgebra K I ⧸ serreIdeal K A` into `TauCeti.KacMoody.PresentedLieAlgebra R`.

To establish Cartan injectivity and the triangular decomposition of `PresentedLieAlgebra R` when
`A` is a generalized Cartan matrix (`Matrix.IsGeneralizedCartan A`), we construct Kac's auxiliary
presentation without Serre relations, build Kac's Verma-type representation on formal words
`List I →₀ K` to prove the triangular directness of the auxiliary algebra using the PBW embedding of
`FreeLieAlgebra K I`, and verify `ad fₖ`-invariance of the Serre ideal in the auxiliary algebra.
Passing to the quotient yields `TauCeti.KacMoody.quotientTriangular_eq_zero`, from which
`TauCeti/Algebra/Lie/KacMoody/Triangular.lean` deduces Cartan injectivity, the triangular
equivalence, generator independence, and the embedding of `Matrix.ToLieAlgebra K A`.

All results hold over an arbitrary field `K`, with no characteristic or finiteness assumption.

## Main definitions

* `TauCeti.KacMoody.serreIdeal`: the Lie ideal of `FreeLieAlgebra R₀ I` generated by Serre's
  relators `(ad xᵢ) ^ (-Aᵢⱼ).toNat ⁅xᵢ, xⱼ⁆`.
* `TauCeti.KacMoody.positiveQuotientHom` and `TauCeti.KacMoody.negativeQuotientHom`: the canonical
  homomorphisms `FreeLieAlgebra K I ⧸ serreIdeal K A →ₗ⁅K⁆ PresentedLieAlgebra R`.

## Main results

* `TauCeti.KacMoody.serreIdeal_le_ker_lift`: any family satisfying Serre's relations factors
  through `FreeLieAlgebra R₀ I ⧸ serreIdeal R₀ A`.
* `TauCeti.KacMoody.quotientTriangular_eq_zero`: for a generalized Cartan matrix `A`, a sum
  `negativeQuotientHom R a + cartanElement R x + positiveQuotientHom R b` vanishes only when
  `a = 0`, `x = 0`, and `b = 0`.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Cambridge University Press, 1990,
  §§1.2–1.3, Theorem 1.2, and §3.3.
-/

public section

open LieAlgebra

namespace TauCeti

namespace KacMoody

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-! ## The Serre ideal of the free Lie algebra -/

section SerreIdeal

/-- The Lie ideal of `FreeLieAlgebra R₀ I` generated by Serre's relators
`(ad xᵢ) ^ (-Aᵢⱼ).toNat ⁅xᵢ, xⱼ⁆`. -/
noncomputable def serreIdeal (R₀ : Type*) [CommRing R₀] {I : Type*} (A : Matrix I I ℤ) :
    LieIdeal R₀ (FreeLieAlgebra R₀ I) :=
  LieSubmodule.lieSpan R₀ (FreeLieAlgebra R₀ I)
    {x | ∃ i j : I, x = (ad R₀ _ (FreeLieAlgebra.of R₀ i) ^ (-A i j).toNat)
      ⁅FreeLieAlgebra.of R₀ i, FreeLieAlgebra.of R₀ j⁆}

/-- If a family `E : I → L` satisfies Serre's relations for `A`, then `serreIdeal R₀ A` lies in the
kernel of `FreeLieAlgebra.lift R₀ E`. -/
theorem serreIdeal_le_ker_lift {R₀ L : Type*} [CommRing R₀] [LieRing L] [LieAlgebra R₀ L]
    {I : Type*} {A : Matrix I I ℤ} {E : I → L}
    (hE : ∀ i j, (ad R₀ L (E i) ^ (-A i j).toNat) ⁅E i, E j⁆ = 0) :
    serreIdeal R₀ A ≤ (FreeLieAlgebra.lift R₀ E).ker := by
  refine LieSubmodule.lieSpan_le.mpr ?_
  rintro _ ⟨i, j, rfl⟩
  simpa [LieHom.map_ad_pow] using hE i j

/-- The canonical homomorphism from `FreeLieAlgebra K I ⧸ serreIdeal K A` to
`PresentedLieAlgebra R` sending the `i`-th generator to `eᵢ`. -/
noncomputable def positiveQuotientHom :
    FreeLieAlgebra K I ⧸ serreIdeal K A →ₗ⁅K⁆ PresentedLieAlgebra R :=
  (serreIdeal K A).liftQ (FreeLieAlgebra.lift K (positiveGenerator R))
    (serreIdeal_le_ker_lift (ad_pow_lie_positiveGenerator_positiveGenerator R))

theorem positiveQuotientHom_mk_of (i : I) :
    positiveQuotientHom R ((serreIdeal K A).mkQ (FreeLieAlgebra.of K i)) =
      positiveGenerator R i := by
  simp [positiveQuotientHom]

/-- The canonical homomorphism from `FreeLieAlgebra K I ⧸ serreIdeal K A` to
`PresentedLieAlgebra R` sending the `i`-th generator to `fᵢ`. -/
noncomputable def negativeQuotientHom :
    FreeLieAlgebra K I ⧸ serreIdeal K A →ₗ⁅K⁆ PresentedLieAlgebra R :=
  (serreIdeal K A).liftQ (FreeLieAlgebra.lift K (negativeGenerator R))
    (serreIdeal_le_ker_lift (ad_pow_lie_negativeGenerator_negativeGenerator R))

theorem negativeQuotientHom_mk_of (i : I) :
    negativeQuotientHom R ((serreIdeal K A).mkQ (FreeLieAlgebra.of K i)) =
      negativeGenerator R i := by
  simp [negativeQuotientHom]

end SerreIdeal

/-! ## Auxiliary presentation and Kac's representation -/

section Auxiliary

open _root_.FreeLieAlgebra Generator in
private inductive IsAuxRelator : FreeLieAlgebra K (Generator I H) → Prop
  | cartan_add (x y : H) :
      IsAuxRelator (of K (cartan (x + y)) - of K (cartan x) - of K (cartan y))
  | cartan_smul (c : K) (x : H) : IsAuxRelator (of K (cartan (c • x)) - c • of K (cartan x))
  | lie_cartan_cartan (x y : H) :
      IsAuxRelator ⁅of K (cartan x : Generator I H), of K (cartan y)⁆
  | lie_cartan_positive (x : H) (j : I) :
      IsAuxRelator (⁅of K (cartan x : Generator I H), of K (positive j)⁆ -
        R.root j x • of K (positive j))
  | lie_cartan_negative (x : H) (j : I) :
      IsAuxRelator (⁅of K (cartan x : Generator I H), of K (negative j)⁆ +
        R.root j x • of K (negative j))
  | lie_positive_negative_self (i : I) :
      IsAuxRelator (⁅of K (positive i : Generator I H), of K (negative i)⁆ -
        of K (cartan (R.coroot i)))
  | lie_positive_negative_of_ne (i j : I) (hij : i ≠ j) :
      IsAuxRelator ⁅of K (positive i : Generator I H), of K (negative j)⁆

private noncomputable def auxIdeal : LieIdeal K (FreeLieAlgebra K (Generator I H)) :=
  LieSubmodule.lieSpan K _ {x | IsAuxRelator R x}

private def AuxLieAlgebra : Type _ :=
  FreeLieAlgebra K (Generator I H) ⧸ auxIdeal R

private noncomputable instance : LieRing (AuxLieAlgebra R) :=
  inferInstanceAs (LieRing (FreeLieAlgebra K (Generator I H) ⧸ auxIdeal R))

private noncomputable instance : LieAlgebra K (AuxLieAlgebra R) :=
  inferInstanceAs (LieAlgebra K (FreeLieAlgebra K (Generator I H) ⧸ auxIdeal R))

private noncomputable def auxMk :
    FreeLieAlgebra K (Generator I H) →ₗ⁅K⁆ AuxLieAlgebra R :=
  LieIdeal.mkQ (auxIdeal R)

private theorem auxMk_eq_zero_of_isAuxRelator {x : FreeLieAlgebra K (Generator I H)}
    (hx : IsAuxRelator R x) : auxMk R x = 0 :=
  (LieIdeal.mkQ_apply _ x).trans
    (LieSubmodule.Quotient.mk_eq_zero'.mpr (LieSubmodule.subset_lieSpan hx))

private noncomputable def auxCartan : H →ₗ[K] AuxLieAlgebra R where
  toFun x := auxMk R (FreeLieAlgebra.of K (Generator.cartan x))
  map_add' x y := by
    have h := auxMk_eq_zero_of_isAuxRelator R (.cartan_add x y)
    rwa [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  map_smul' c x := by
    have h := auxMk_eq_zero_of_isAuxRelator R (.cartan_smul c x)
    rwa [map_sub, map_smul, sub_eq_zero] at h

private noncomputable def auxPos (i : I) : AuxLieAlgebra R :=
  auxMk R (FreeLieAlgebra.of K (Generator.positive i))

private noncomputable def auxNeg (i : I) : AuxLieAlgebra R :=
  auxMk R (FreeLieAlgebra.of K (Generator.negative i))

@[simp]
private theorem auxMk_of_cartan (x : H) :
    auxMk R (FreeLieAlgebra.of K (Generator.cartan x)) = auxCartan R x := rfl

@[simp]
private theorem auxMk_of_pos (i : I) :
    auxMk R (FreeLieAlgebra.of K (Generator.positive i)) = auxPos R i := rfl

@[simp]
private theorem auxMk_of_neg (i : I) :
    auxMk R (FreeLieAlgebra.of K (Generator.negative i)) = auxNeg R i := rfl

@[simp]
private theorem lie_auxCartan_auxCartan (x y : H) :
    ⁅auxCartan R x, auxCartan R y⁆ = 0 := by
  simpa using auxMk_eq_zero_of_isAuxRelator R (.lie_cartan_cartan x y)

@[simp]
private theorem lie_auxCartan_auxPos (x : H) (j : I) :
    ⁅auxCartan R x, auxPos R j⁆ = R.root j x • auxPos R j := by
  simpa [sub_eq_zero] using auxMk_eq_zero_of_isAuxRelator R (.lie_cartan_positive x j)

@[simp]
private theorem lie_auxCartan_auxNeg (x : H) (j : I) :
    ⁅auxCartan R x, auxNeg R j⁆ = -(R.root j x • auxNeg R j) := by
  simpa [add_eq_zero_iff_eq_neg] using auxMk_eq_zero_of_isAuxRelator R (.lie_cartan_negative x j)

@[simp]
private theorem lie_auxPos_auxNeg_self (i : I) :
    ⁅auxPos R i, auxNeg R i⁆ = auxCartan R (R.coroot i) := by
  simpa [sub_eq_zero] using auxMk_eq_zero_of_isAuxRelator R (.lie_positive_negative_self i)

@[simp]
private theorem lie_auxPos_auxNeg_of_ne {i j : I} (hij : i ≠ j) :
    ⁅auxPos R i, auxNeg R j⁆ = 0 := by
  simpa using auxMk_eq_zero_of_isAuxRelator R (.lie_positive_negative_of_ne i j hij)

section AuxUniversal

variable {L : Type*} [LieRing L] [LieAlgebra K L]

private structure SatisfiesAuxRelations (φ : H →ₗ[K] L) (E F : I → L) : Prop where
  lie_cartan_cartan : ∀ x y, ⁅φ x, φ y⁆ = 0
  lie_cartan_positive : ∀ x j, ⁅φ x, E j⁆ = R.root j x • E j
  lie_cartan_negative : ∀ x j, ⁅φ x, F j⁆ = -(R.root j x • F j)
  lie_positive_negative_self : ∀ i, ⁅E i, F i⁆ = φ (R.coroot i)
  lie_positive_negative_of_ne : ∀ i j, i ≠ j → ⁅E i, F j⁆ = 0

private def auxGenMap (φ : H →ₗ[K] L) (E F : I → L) : Generator I H → L
  | .cartan x => φ x
  | .positive i => E i
  | .negative i => F i

variable {R} in
private noncomputable def auxLift {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) : AuxLieAlgebra R →ₗ⁅K⁆ L :=
  (auxIdeal R).liftQ (FreeLieAlgebra.lift K (auxGenMap φ E F)) <| by
    refine LieSubmodule.lieSpan_le.mpr fun x hx => ?_
    rw [SetLike.mem_coe, LieHom.mem_ker]
    induction hx with
    | cartan_add x y => simp [auxGenMap]
    | cartan_smul c x => simp [auxGenMap]
    | lie_cartan_cartan x y => simp [auxGenMap, h.lie_cartan_cartan]
    | lie_cartan_positive x j => simp [auxGenMap, h.lie_cartan_positive]
    | lie_cartan_negative x j => simp [auxGenMap, h.lie_cartan_negative]
    | lie_positive_negative_self i => simp [auxGenMap, h.lie_positive_negative_self]
    | lie_positive_negative_of_ne i j hij => simp [auxGenMap, h.lie_positive_negative_of_ne i j hij]

variable {R} in
@[simp]
private theorem auxLift_auxCartan {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) (x : H) : auxLift h (auxCartan R x) = φ x :=
  (LieIdeal.liftQ_apply _ _ _ _).trans (FreeLieAlgebra.lift_of_apply _ _)

variable {R} in
@[simp]
private theorem auxLift_auxPos {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) (i : I) : auxLift h (auxPos R i) = E i :=
  (LieIdeal.liftQ_apply _ _ _ _).trans (FreeLieAlgebra.lift_of_apply _ _)

variable {R} in
@[simp]
private theorem auxLift_auxNeg {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) (i : I) : auxLift h (auxNeg R i) = F i :=
  (LieIdeal.liftQ_apply _ _ _ _).trans (FreeLieAlgebra.lift_of_apply _ _)

variable {R} in
private theorem aux_hom_ext {g₁ g₂ : AuxLieAlgebra R →ₗ⁅K⁆ L}
    (hH : ∀ x, g₁ (auxCartan R x) = g₂ (auxCartan R x))
    (hE : ∀ i, g₁ (auxPos R i) = g₂ (auxPos R i))
    (hF : ∀ i, g₁ (auxNeg R i) = g₂ (auxNeg R i)) : g₁ = g₂ := by
  refine (auxIdeal R).lieHom_qext fun x => ?_
  have hc : g₁.comp (auxMk R) = g₂.comp (auxMk R) := FreeLieAlgebra.hom_ext fun
    | .cartan x => hH x
    | .positive i => hE i
    | .negative i => hF i
  exact DFunLike.congr_fun hc x

end AuxUniversal

private theorem lieSpan_auxGenerators_eq_top :
    LieSubalgebra.lieSpan K (AuxLieAlgebra R)
      (Set.range (auxCartan R) ∪ Set.range (auxPos R) ∪ Set.range (auxNeg R)) = ⊤ := by
  set S := LieSubalgebra.lieSpan K (AuxLieAlgebra R)
    (Set.range (auxCartan R) ∪ Set.range (auxPos R) ∪ Set.range (auxNeg R))
  have hle : LieSubalgebra.lieSpan K (FreeLieAlgebra K (Generator I H))
      (Set.range (FreeLieAlgebra.of K)) ≤ S.comap (auxMk R) := by
    refine LieSubalgebra.lieSpan_le.mpr ?_
    rintro _ ⟨g, rfl⟩
    refine LieSubalgebra.subset_lieSpan ?_
    cases g with
    | cartan x => exact Or.inl (Or.inl ⟨x, rfl⟩)
    | positive i => exact Or.inl (Or.inr ⟨i, rfl⟩)
    | negative i => exact Or.inr ⟨i, rfl⟩
  refine eq_top_iff.mpr fun y _ => ?_
  obtain ⟨x, rfl⟩ := (auxIdeal R).surjective_mkQ y
  exact hle (by rw [FreeLieAlgebra.lieSpan_range_of_eq_top]; trivial)

private noncomputable def auxChevalleyHom : AuxLieAlgebra R →ₗ⁅K⁆ AuxLieAlgebra R :=
  auxLift (φ := -auxCartan R) (E := -auxNeg R) (F := -auxPos R)
    { lie_cartan_cartan := fun x y => by simp
      lie_cartan_positive := fun x j => by simp
      lie_cartan_negative := fun x j => by simp
      lie_positive_negative_self := fun i => by simp [← lie_skew (auxNeg R i) (auxPos R i)]
      lie_positive_negative_of_ne := fun i j hij => by
        simp [← lie_skew (auxNeg R i) (auxPos R j), lie_auxPos_auxNeg_of_ne R hij.symm] }

private noncomputable def auxChevalley : AuxLieAlgebra R ≃ₗ⁅K⁆ AuxLieAlgebra R :=
  have hcomp : (auxChevalleyHom R).comp (auxChevalleyHom R) = LieHom.id :=
    aux_hom_ext (by simp [auxChevalleyHom]) (by simp [auxChevalleyHom]) (by simp [auxChevalleyHom])
  { toLieHom := auxChevalleyHom R
    invFun := auxChevalleyHom R
    left_inv := fun x => DFunLike.congr_fun hcomp x
    right_inv := fun x => DFunLike.congr_fun hcomp x }

private noncomputable def auxPosHom : FreeLieAlgebra K I →ₗ⁅K⁆ AuxLieAlgebra R :=
  FreeLieAlgebra.lift K (auxPos R)

private noncomputable def auxNegHom : FreeLieAlgebra K I →ₗ⁅K⁆ AuxLieAlgebra R :=
  FreeLieAlgebra.lift K (auxNeg R)

private noncomputable def freeNeg (K I : Type*) [CommRing K] :
    FreeLieAlgebra K I ≃ₗ⁅K⁆ FreeLieAlgebra K I :=
  let f : FreeLieAlgebra K I →ₗ⁅K⁆ FreeLieAlgebra K I :=
    FreeLieAlgebra.lift K fun i => -FreeLieAlgebra.of K i
  have hf : f.comp f = LieHom.id := FreeLieAlgebra.hom_ext fun i => by simp [f]
  { toLieHom := f
    invFun := f
    left_inv := fun x => DFunLike.congr_fun hf x
    right_inv := fun x => DFunLike.congr_fun hf x }

private theorem auxChevalley_auxPosHom (b : FreeLieAlgebra K I) :
    auxChevalley R (auxPosHom R b) = auxNegHom R (freeNeg K I b) :=
  DFunLike.congr_fun (FreeLieAlgebra.hom_ext fun i => by
    simp [auxChevalley, auxChevalleyHom, auxPosHom, auxNegHom, freeNeg] :
    (auxChevalley R).toLieHom.comp (auxPosHom R) = (auxNegHom R).comp (freeNeg K I).toLieHom) b

private theorem auxChevalley_auxNegHom (b : FreeLieAlgebra K I) :
    auxChevalley R (auxNegHom R b) = auxPosHom R (freeNeg K I b) :=
  DFunLike.congr_fun (FreeLieAlgebra.hom_ext fun i => by
    simp [auxChevalley, auxChevalleyHom, auxPosHom, auxNegHom, freeNeg] :
    (auxChevalley R).toLieHom.comp (auxNegHom R) = (auxPosHom R).comp (freeNeg K I).toLieHom) b

private noncomputable def auxToPresented : AuxLieAlgebra R →ₗ⁅K⁆ PresentedLieAlgebra R :=
  auxLift (φ := cartanElement R) (E := positiveGenerator R) (F := negativeGenerator R)
    { lie_cartan_cartan := lie_cartanElement_cartanElement R
      lie_cartan_positive := lie_cartanElement_positiveGenerator R
      lie_cartan_negative := lie_cartanElement_negativeGenerator R
      lie_positive_negative_self := lie_positiveGenerator_negativeGenerator_self R
      lie_positive_negative_of_ne := fun _ _ => lie_positiveGenerator_negativeGenerator_of_ne R }

/-! ### Kac's Verma-type representation on formal words -/

section AuxRep

attribute [local instance 100] LieRing.ofAssociativeRing

private def wordWeight (lam : Module.Dual K H) (w : List I) : Module.Dual K H :=
  lam - (w.map R.root).sum

@[simp]
private theorem wordWeight_nil (lam : Module.Dual K H) : wordWeight R lam [] = lam := by
  simp [wordWeight]

@[simp]
private theorem wordWeight_cons (lam : Module.Dual K H) (j : I) (w : List I) :
    wordWeight R lam (j :: w) = wordWeight R lam w - R.root j := by
  simp only [wordWeight, List.map_cons, List.sum_cons]
  abel

private noncomputable def fOp (i : I) : Module.End K (List I →₀ K) :=
  Finsupp.lmapDomain K K (List.cons i)

@[simp]
private theorem fOp_single (i : I) (w : List I) (c : K) :
    fOp (K := K) i (Finsupp.single w c) = Finsupp.single (i :: w) c := by
  simp [fOp, Finsupp.mapDomain_single]

private noncomputable def hOp (lam : Module.Dual K H) : H →ₗ[K] Module.End K (List I →₀ K) where
  toFun x := Finsupp.lsum K fun w =>
    wordWeight R lam w x • LinearMap.toSpanSingleton K (List I →₀ K) (Finsupp.single w 1)
  map_add' x y := Finsupp.lhom_ext' fun _ => LinearMap.ext_ring <| by simp [add_smul]
  map_smul' c x := Finsupp.lhom_ext' fun _ => LinearMap.ext_ring <| by simp [mul_smul]

@[simp]
private theorem hOp_single (lam : Module.Dual K H) (x : H) (w : List I) (c : K) :
    hOp R lam x (Finsupp.single w c) = c • wordWeight R lam w x • Finsupp.single w 1 := by
  simp [hOp, mul_comm]

open scoped Classical in
private noncomputable def eWord (lam : Module.Dual K H) (i : I) : List I → (List I →₀ K)
  | [] => 0
  | j :: w => fOp j (eWord lam i w) +
      if i = j then wordWeight R lam w (R.coroot i) • Finsupp.single w 1 else 0

open scoped Classical in
private noncomputable def eOp (lam : Module.Dual K H) (i : I) : Module.End K (List I →₀ K) :=
  Finsupp.lsum K fun w => LinearMap.toSpanSingleton K (List I →₀ K) (eWord R lam i w)

open scoped Classical in
@[simp]
private theorem eOp_single (lam : Module.Dual K H) (i : I) (w : List I) (c : K) :
    eOp R lam i (Finsupp.single w c) = c • eWord R lam i w := by
  simp [eOp]

private theorem hOp_fOp (lam : Module.Dual K H) (x : H) (j : I) (v : List I →₀ K) :
    hOp R lam x (fOp j v) = fOp j (hOp R lam x v) - R.root j x • fOp j v := by
  have heq : (hOp R lam x).comp (fOp j) = (fOp j).comp (hOp R lam x) - R.root j x • fOp j := by
    refine Finsupp.lhom_ext' fun w => LinearMap.ext_ring ?_
    simp only [LinearMap.comp_apply, Finsupp.lsingle_apply, LinearMap.sub_apply,
      LinearMap.smul_apply, fOp_single, hOp_single, one_smul, map_smul, wordWeight_cons]
    rw [sub_smul]
  simpa using LinearMap.congr_fun heq v

open scoped Classical in
private theorem hOp_eWord (lam : Module.Dual K H) (x : H) (i : I) (w : List I) :
    hOp R lam x (eWord R lam i w) = (wordWeight R lam w x + R.root i x) • eWord R lam i w := by
  induction w with
  | nil => simp [eWord]
  | cons j w ih =>
    have hf : hOp R lam x (fOp j (eWord R lam i w)) =
        (wordWeight R lam (j :: w) x + R.root i x) • fOp j (eWord R lam i w) := by
      rw [hOp_fOp, ih, map_smul, wordWeight_cons, LinearMap.sub_apply]
      module
    simp only [eWord, map_add, hf]
    split_ifs with hij
    · subst hij
      simp only [map_smul, hOp_single, one_smul, wordWeight_cons, LinearMap.sub_apply]
      module
    · simp

open scoped Classical in
private theorem satisfiesAuxRelations_auxRep (lam : Module.Dual K H) :
    SatisfiesAuxRelations R (hOp R lam) (eOp R lam) (fOp (K := K)) where
  lie_cartan_cartan x y := by
    refine Finsupp.lhom_ext' fun w => LinearMap.ext_ring ?_
    rw [LieRing.of_associative_ring_bracket]
    simp [mul_apply_eq_comp, mul_comm]
  lie_cartan_positive x j := by
    refine Finsupp.lhom_ext' fun w => LinearMap.ext_ring ?_
    rw [LieRing.of_associative_ring_bracket]
    simp only [LinearMap.comp_apply, Finsupp.lsingle_apply, LinearMap.sub_apply, mul_apply_eq_comp,
      eOp_single, hOp_single, one_smul, map_smul, hOp_eWord, LinearMap.smul_apply]
    module
  lie_cartan_negative x j := by
    refine Finsupp.lhom_ext' fun w => LinearMap.ext_ring ?_
    rw [LieRing.of_associative_ring_bracket]
    simp only [LinearMap.comp_apply, Finsupp.lsingle_apply, LinearMap.sub_apply, mul_apply_eq_comp,
      fOp_single, hOp_single, one_smul, map_smul, wordWeight_cons, LinearMap.neg_apply,
      LinearMap.smul_apply]
    module
  lie_positive_negative_self i := by
    refine Finsupp.lhom_ext' fun w => LinearMap.ext_ring ?_
    rw [LieRing.of_associative_ring_bracket]
    simp [mul_apply_eq_comp, eWord]
  lie_positive_negative_of_ne i j hij := by
    refine Finsupp.lhom_ext' fun w => LinearMap.ext_ring ?_
    rw [LieRing.of_associative_ring_bracket]
    simp [mul_apply_eq_comp, eWord, hij]

open scoped Classical in
private noncomputable def auxRep (lam : Module.Dual K H) :
    AuxLieAlgebra R →ₗ⁅K⁆ Module.End K (List I →₀ K) :=
  auxLift (satisfiesAuxRelations_auxRep R lam)

open scoped Classical in
private theorem auxRep_auxPosHom_single_nil (lam : Module.Dual K H) (b : FreeLieAlgebra K I) :
    auxRep R lam (auxPosHom R b) (Finsupp.single [] 1) = 0 := by
  have hb : b ∈ LieSubalgebra.lieSpan K _ (Set.range (FreeLieAlgebra.of K)) := by
    rw [FreeLieAlgebra.lieSpan_range_of_eq_top]; trivial
  induction hb using LieSubalgebra.lieSpan_induction with
  | mem _ hx => rcases hx with ⟨i, rfl⟩; simp [auxRep, auxPosHom, eWord]
  | zero => simp
  | add _ _ _ _ hx hy => simp [map_add, hx, hy]
  | smul c _ _ hx => simp [map_smul, hx]
  | lie _ _ _ _ hx hy =>
    rw [LieHom.map_lie, LieHom.map_lie, LieRing.of_associative_ring_bracket]
    simp [mul_apply_eq_comp, hx, hy]

open scoped Classical in
private theorem auxRep_auxNegHom_apply_nil (lam : Module.Dual K H) (a : FreeLieAlgebra K I) :
    auxRep R lam (auxNegHom R a) (Finsupp.single [] 1) [] = 0 := by
  suffices ∀ v : List I →₀ K, auxRep R lam (auxNegHom R a) v [] = 0 from this _
  have ha : a ∈ LieSubalgebra.lieSpan K _ (Set.range (FreeLieAlgebra.of K)) := by
    rw [FreeLieAlgebra.lieSpan_range_of_eq_top]; trivial
  induction ha using LieSubalgebra.lieSpan_induction with
  | mem _ hx =>
    rcases hx with ⟨i, rfl⟩
    intro v
    simp only [auxNegHom, FreeLieAlgebra.lift_of_apply, auxRep, auxLift_auxNeg]
    induction v using Finsupp.induction_linear with
    | zero => simp
    | add _ _ hu hw => simp [map_add, hu, hw]
    | single w c => simp [fOp_single]
  | zero => intro v; simp
  | add _ _ _ _ hx hy => intro v; simp [map_add, hx v, hy v]
  | smul c _ _ hx => intro v; simp [map_smul, hx v]
  | lie _ _ _ _ hx hy =>
    intro v
    rw [LieHom.map_lie, LieHom.map_lie, LieRing.of_associative_ring_bracket]
    simp [mul_apply_eq_comp, hx, hy]

private noncomputable def wordToFreeAlg : (List I →₀ K) →ₗ[K] FreeAlgebra K I :=
  Finsupp.lsum K fun w =>
    LinearMap.toSpanSingleton K (FreeAlgebra K I) (w.map (FreeAlgebra.ι K)).prod

private theorem wordToFreeAlg_fOp (i : I) (v : List I →₀ K) :
    wordToFreeAlg (fOp i v) = FreeAlgebra.ι K i * wordToFreeAlg v := by
  induction v using Finsupp.induction_linear with
  | zero => simp
  | add _ _ hu hw => simp [map_add, hu, hw, mul_add]
  | single w c => simp [wordToFreeAlg]

private theorem wordToFreeAlg_freeAlgLift_fOp (r : FreeAlgebra K I) (v : List I →₀ K) :
    wordToFreeAlg ((FreeAlgebra.lift K (fOp (K := K)) r) v) = r * wordToFreeAlg v := by
  induction r using FreeAlgebra.induction generalizing v with
  | grade0 c =>
    rw [AlgHom.commutes, Module.algebraMap_end_apply, map_smul, Algebra.algebraMap_eq_smul_one,
      smul_mul_assoc, one_mul]
  | grade1 i => simp [wordToFreeAlg_fOp]
  | mul r s hr hs => rw [map_mul, mul_apply_eq_comp, hr, hs, mul_assoc]
  | add r s hr hs => rw [map_add, LinearMap.add_apply, map_add, hr, hs, add_mul]

open scoped Classical in
private theorem auxRep_auxNegHom_injective (lam : Module.Dual K H) :
    Function.Injective fun a : FreeLieAlgebra K I =>
      auxRep R lam (auxNegHom R a) (Finsupp.single [] 1) := by
  let ιFA : FreeLieAlgebra K I →ₗ⁅K⁆ FreeAlgebra K I := FreeLieAlgebra.lift K (FreeAlgebra.ι K)
  have hιFA_eq : ∀ a, ιFA a = FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra K I
      (UniversalEnvelopingAlgebra.ι K a) := fun a => by
    simp [ιFA, FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra]
  have hιFA_inj : Function.Injective ιFA := fun a b hab =>
    TauCeti.UniversalEnvelopingAlgebra.ι_injective K (FreeLieAlgebra K I) <|
      (FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra K I).injective <| by
        rwa [← hιFA_eq, ← hιFA_eq]
  have hcomp : (auxRep R lam).comp (auxNegHom R) =
      (FreeAlgebra.lift K (fOp (K := K))).toLieHom.comp ιFA :=
    FreeLieAlgebra.hom_ext fun i => by simp [auxRep, auxNegHom, ιFA]
  intro a b hab
  have ha := LinearMap.congr_fun (DFunLike.congr_fun hcomp a) (Finsupp.single [] 1)
  have hb := LinearMap.congr_fun (DFunLike.congr_fun hcomp b) (Finsupp.single [] 1)
  have h2 := congrArg wordToFreeAlg (ha.symm.trans (hab.trans hb))
  simp only [LieHom.comp_apply, AlgHom.toLieHom_apply, wordToFreeAlg_freeAlgLift_fOp] at h2
  have hnil : wordToFreeAlg (Finsupp.single ([] : List I) (1 : K)) = 1 := by simp [wordToFreeAlg]
  rw [hnil, mul_one, mul_one] at h2
  exact hιFA_inj h2

private theorem auxTriangular_eq_zero {a b : FreeLieAlgebra K I} {x : H}
    (h : auxNegHom R a + auxCartan R x + auxPosHom R b = 0) :
    a = 0 ∧ x = 0 ∧ b = 0 := by
  classical
  have hx : x = 0 := by
    refine (Module.forall_dual_apply_eq_zero_iff K x).mp fun lam => ?_
    have h0 := congrArg (fun z => auxRep R lam z (Finsupp.single [] 1) []) h
    simp only [map_add, LinearMap.add_apply, Finsupp.add_apply, map_zero, LinearMap.zero_apply,
      Finsupp.coe_zero, Pi.zero_apply, auxRep_auxNegHom_apply_nil,
      auxRep_auxPosHom_single_nil, add_zero, zero_add] at h0
    have hcart : auxRep R lam (auxCartan R x) (Finsupp.single [] 1) =
        lam x • Finsupp.single [] 1 := by simp [auxRep]
    simpa [hcart] using h0
  subst hx
  simp only [map_zero, add_zero] at h
  have ha : a = 0 := auxRep_auxNegHom_injective R 0 <| by
    simpa [map_add, auxRep_auxPosHom_single_nil] using
      congrArg (fun z => auxRep R 0 z (Finsupp.single [] 1)) h
  subst ha
  simp only [map_zero, zero_add] at h
  have hb : b = 0 := by
    apply (freeNeg K I).injective
    rw [map_zero]
    apply auxRep_auxNegHom_injective R 0
    have hchev := congrArg (auxChevalley R) h
    rw [map_zero, auxChevalley_auxPosHom] at hchev
    simp [hchev]
  exact ⟨rfl, rfl, hb⟩

end AuxRep

/-! ### Invariance of the Serre ideal in the auxiliary algebra -/

section AuxSerre

private theorem lie_auxCartan_mem_range_auxPosHom (x : H) {y : AuxLieAlgebra R}
    (hy : y ∈ (auxPosHom R).range) : ⁅auxCartan R x, y⁆ ∈ (auxPosHom R).range := by
  rw [auxPosHom, FreeLieAlgebra.range_lift_eq_lieSpan] at hy ⊢
  refine LieSubalgebra.lie_mem_of_mem_lieSpan ?_ hy
  rintro _ ⟨j, rfl⟩
  rw [lie_auxCartan_auxPos]
  exact LieSubalgebra.smul_mem _ _ (LieSubalgebra.subset_lieSpan (Set.mem_range_self j))

private theorem lie_auxNeg_mem_range_auxPosHom_sup_range_auxCartan (k : I) {y : AuxLieAlgebra R}
    (hy : y ∈ (auxPosHom R).range) :
    ⁅auxNeg R k, y⁆ ∈ (auxPosHom R).range.toSubmodule ⊔ LinearMap.range (auxCartan R) := by
  have hrange : (auxPosHom R).range = LieSubalgebra.lieSpan K _ (Set.range (auxPos R)) :=
    FreeLieAlgebra.range_lift_eq_lieSpan (auxPos R)
  rw [hrange] at hy ⊢
  refine LieSubalgebra.lie_mem_sup_of_mem_lieSpan ?_ ?_ hy
  · rintro _ ⟨x, rfl⟩ z hz
    rw [← hrange] at hz ⊢
    exact lie_auxCartan_mem_range_auxPosHom R x hz
  · rintro _ ⟨j, rfl⟩
    rw [← lie_skew (auxNeg R k) (auxPos R j)]
    rcases eq_or_ne j k with rfl | hjk
    · rw [lie_auxPos_auxNeg_self]
      exact Submodule.mem_sup_right ⟨-R.coroot j, map_neg _ _⟩
    · rw [lie_auxPos_auxNeg_of_ne R hjk, neg_zero]
      exact zero_mem _

private theorem lie_auxCartan_ad_auxPos_pow (x : H) (i j : I) (n : ℕ) :
    ⁅auxCartan R x, (ad K _ (auxPos R i) ^ n) (auxPos R j)⁆ =
      (n • R.root i x + R.root j x) • (ad K _ (auxPos R i) ^ n) (auxPos R j) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [ad_pow_succ_apply', leibniz_lie, lie_auxCartan_auxPos, ih, smul_lie, lie_smul, succ_nsmul]
    module

private theorem lie_auxNeg_ad_auxPos_pow_self (hA : A.IsGeneralizedCartan) {i j : I} (hij : i ≠ j) :
    ∀ m : ℕ, ⁅auxNeg R i, (ad K _ (auxPos R i) ^ m) (auxPos R j)⁆ =
      (-(m : ℤ) * (A i j + m - 1)) • (ad K _ (auxPos R i) ^ (m - 1)) (auxPos R j)
  | 0 => by simp [← lie_skew (auxNeg R i) (auxPos R j), lie_auxPos_auxNeg_of_ne R hij.symm]
  | 1 => by
    rw [pow_one, ad_apply, leibniz_lie, ← lie_skew (auxNeg R i) (auxPos R i),
      lie_auxPos_auxNeg_self, ← lie_skew (auxNeg R i) (auxPos R j),
      lie_auxPos_auxNeg_of_ne R hij.symm, neg_zero, lie_zero, add_zero, neg_lie,
      lie_auxCartan_auxPos, R.root_coroot, Matrix.map_apply]
    simp [Int.cast_smul_eq_zsmul]
  | m + 2 => by
    have ih := lie_auxNeg_ad_auxPos_pow_self hA hij (m + 1)
    have hweight := lie_auxCartan_ad_auxPos_pow R (R.coroot i) i j (m + 1)
    simp only [R.root_coroot, Matrix.map_apply, hA.diag] at hweight
    rw [ad_pow_succ_apply' _ _ (m + 1), leibniz_lie, ← lie_skew (auxNeg R i) (auxPos R i),
      lie_auxPos_auxNeg_self, neg_lie, hweight, ih, Nat.add_sub_cancel, lie_zsmul,
      ← ad_pow_succ_apply', ← Int.cast_smul_eq_zsmul K, ← Int.cast_smul_eq_zsmul K, ← neg_smul,
      ← add_smul]
    congr 1
    simp only [nsmul_eq_mul]
    push_cast
    ring

private theorem lie_auxNeg_serreRelator_eq_zero (hA : A.IsGeneralizedCartan) (k i j : I) :
    ⁅auxNeg R k, (ad K _ (auxPos R i) ^ (-A i j).toNat) ⁅auxPos R i, auxPos R j⁆⁆ = 0 := by
  rcases eq_or_ne i j with rfl | hij
  · simp
  · rcases eq_or_ne i k with rfl | hik
    · have h := lie_auxNeg_ad_auxPos_pow_self R hA hij ((-A i j).toNat + 1)
      rw [ad_pow_succ_apply] at h
      have htoNat : ((-A i j).toNat : ℤ) = -A i j :=
        Int.toNat_of_nonneg (neg_nonneg.mpr (hA.offDiag_nonpos i j hij))
      have hcoef : -((((-A i j).toNat + 1 : ℕ) : ℤ)) *
          (A i j + (((-A i j).toNat + 1 : ℕ) : ℤ) - 1) = 0 := by
        push_cast; rw [htoNat]; ring
      rwa [hcoef, zero_zsmul] at h
    · have hcomm : ∀ n : ℕ, ∀ y : AuxLieAlgebra R,
          ⁅auxNeg R k, (ad K _ (auxPos R i) ^ n) y⁆ =
            (ad K _ (auxPos R i) ^ n) ⁅auxNeg R k, y⁆ := by
        intro n
        induction n with
        | zero => simp
        | succ n ih =>
          intro y
          rw [ad_pow_succ_apply', leibniz_lie, ← lie_skew (auxNeg R k) (auxPos R i),
            lie_auxPos_auxNeg_of_ne R hik, neg_zero, zero_lie, zero_add, ih, ad_pow_succ_apply']
      rw [← ad_pow_succ_apply, hcomm]
      rcases eq_or_ne j k with rfl | hjk
      · rw [← lie_skew (auxNeg R j) (auxPos R j), lie_auxPos_auxNeg_self, map_neg, neg_eq_zero]
        cases hnat : (-A i j).toNat with
        | zero =>
          have hnonneg : 0 ≤ -A i j := neg_nonneg.mpr (hA.offDiag_nonpos i j hij)
          have hAij : A i j = 0 := by have := Int.toNat_of_nonneg hnonneg; omega
          have hAji : A j i = 0 := (hA.zero_comm i j).mp hAij
          simp [pow_one, ad_apply, ← lie_skew (auxPos R i) (auxCartan R (R.coroot j)), hAji]
        | succ n =>
          rw [ad_pow_succ_apply, ← lie_skew (auxPos R i) (auxCartan R (R.coroot j)),
            lie_auxCartan_auxPos, ad_pow_succ_apply]
          simp
      · rw [← lie_skew (auxNeg R k) (auxPos R j), lie_auxPos_auxNeg_of_ne R hjk, neg_zero, map_zero]

private noncomputable def auxSerrePosSubmodule : Submodule K (AuxLieAlgebra R) :=
  (serreIdeal K A).toSubmodule.map (auxPosHom R).toLinearMap

private theorem auxPosHom_serreRelator (i j : I) :
    auxPosHom R ((ad K _ (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
      ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆) =
      (ad K _ (auxPos R i) ^ (-A i j).toNat) ⁅auxPos R i, auxPos R j⁆ := by
  simp [auxPosHom]

private theorem lie_range_auxPosHom_auxSerrePosSubmodule {u y : AuxLieAlgebra R}
    (hu : u ∈ (auxPosHom R).range) (hy : y ∈ auxSerrePosSubmodule R) :
    ⁅u, y⁆ ∈ auxSerrePosSubmodule R := by
  rcases hu with ⟨a, rfl⟩
  rcases hy with ⟨b, hb, rfl⟩
  exact ⟨⁅a, b⁆, LieSubmodule.lie_mem (serreIdeal K A) hb, (auxPosHom R).map_lie a b⟩

private theorem lie_auxCartan_auxSerrePosSubmodule (x : H) {y : AuxLieAlgebra R}
    (hy : y ∈ auxSerrePosSubmodule R) : ⁅auxCartan R x, y⁆ ∈ auxSerrePosSubmodule R := by
  rcases hy with ⟨b, hb, rfl⟩
  rw [SetLike.mem_coe, LieSubmodule.mem_toSubmodule] at hb
  simp only [LieHom.coe_toLinearMap]
  induction hb using LieSubmodule.lieSpan_induction with
  | mem _ hb =>
    rcases hb with ⟨i, j, rfl⟩
    rw [auxPosHom_serreRelator, ← ad_pow_succ_apply, lie_auxCartan_ad_auxPos_pow]
    refine Submodule.smul_mem _ _ ⟨(ad K _ (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
      ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆,
      LieSubmodule.subset_lieSpan ⟨i, j, rfl⟩, ?_⟩
    simp only [LieHom.coe_toLinearMap, auxPosHom_serreRelator, ad_pow_succ_apply]
  | zero => simp
  | add _ _ _ _ hu hv => simpa [map_add, lie_add] using add_mem hu hv
  | smul c _ _ hu => simpa [map_smul, lie_smul] using Submodule.smul_mem _ c hu
  | lie u v hv ih =>
    rw [LieHom.map_lie, leibniz_lie]
    exact add_mem
      (lie_range_auxPosHom_auxSerrePosSubmodule R
        (lie_auxCartan_mem_range_auxPosHom R x ⟨u, rfl⟩) ⟨v, hv, rfl⟩)
      (lie_range_auxPosHom_auxSerrePosSubmodule R ⟨u, rfl⟩ ih)

private theorem lie_auxNeg_auxSerrePosSubmodule (hA : A.IsGeneralizedCartan) (k : I)
    {y : AuxLieAlgebra R} (hy : y ∈ auxSerrePosSubmodule R) :
    ⁅auxNeg R k, y⁆ ∈ auxSerrePosSubmodule R := by
  rcases hy with ⟨b, hb, rfl⟩
  rw [SetLike.mem_coe, LieSubmodule.mem_toSubmodule] at hb
  simp only [LieHom.coe_toLinearMap]
  induction hb using LieSubmodule.lieSpan_induction with
  | mem _ hb =>
    rcases hb with ⟨i, j, rfl⟩
    rw [auxPosHom_serreRelator, lie_auxNeg_serreRelator_eq_zero R hA]
    exact zero_mem _
  | zero => simp
  | add _ _ _ _ hu hv => simpa [map_add, lie_add] using add_mem hu hv
  | smul c _ _ hu => simpa [map_smul, lie_smul] using Submodule.smul_mem _ c hu
  | lie u v hv ih =>
    rw [LieHom.map_lie, leibniz_lie]
    refine add_mem ?_ (lie_range_auxPosHom_auxSerrePosSubmodule R ⟨u, rfl⟩ ih)
    obtain ⟨p, hp, _, ⟨x, rfl⟩, hsum⟩ := Submodule.mem_sup.mp
      (lie_auxNeg_mem_range_auxPosHom_sup_range_auxCartan R k ⟨u, rfl⟩)
    simp only [LieHom.coe_toLinearMap] at hsum
    rw [← hsum, add_lie]
    exact add_mem (lie_range_auxPosHom_auxSerrePosSubmodule R hp ⟨v, hv, rfl⟩)
      (lie_auxCartan_auxSerrePosSubmodule R x ⟨v, hv, rfl⟩)

private noncomputable def auxSerrePosIdeal (hA : A.IsGeneralizedCartan) :
    LieIdeal K (AuxLieAlgebra R) :=
  { auxSerrePosSubmodule R with
    lie_mem := fun {z y} hy => by
      suffices ∀ v ∈ auxSerrePosSubmodule R, ⁅z, v⁆ ∈ auxSerrePosSubmodule R from this y hy
      have hz : z ∈ LieSubalgebra.lieSpan K (AuxLieAlgebra R)
          (Set.range (auxCartan R) ∪ Set.range (auxPos R) ∪ Set.range (auxNeg R)) := by
        rw [lieSpan_auxGenerators_eq_top R]; trivial
      induction hz using LieSubalgebra.lieSpan_induction with
      | mem _ hg =>
        rintro v hv
        rcases hg with (⟨x, rfl⟩ | ⟨i, rfl⟩) | ⟨k, rfl⟩
        · exact lie_auxCartan_auxSerrePosSubmodule R x hv
        · exact lie_range_auxPosHom_auxSerrePosSubmodule R
            ⟨FreeLieAlgebra.of K i, FreeLieAlgebra.lift_of_apply _ i⟩ hv
        · exact lie_auxNeg_auxSerrePosSubmodule R hA k hv
      | zero => intro _ _; simp
      | add _ _ _ _ h₁ h₂ => intro v hv; rw [add_lie]; exact add_mem (h₁ v hv) (h₂ v hv)
      | smul c _ _ hw => intro v hv; rw [smul_lie]; exact Submodule.smul_mem _ c (hw v hv)
      | lie _ _ _ _ h₁ h₂ =>
        intro v hv; rw [lie_lie]; exact sub_mem (h₁ _ (h₂ v hv)) (h₂ _ (h₁ v hv)) }

private theorem freeNeg_mem_serreIdeal {b : FreeLieAlgebra K I} (hb : b ∈ serreIdeal K A) :
    freeNeg K I b ∈ serreIdeal K A := by
  induction hb using LieSubmodule.lieSpan_induction with
  | mem _ hb =>
    rcases hb with ⟨i, j, rfl⟩
    have hof : ∀ k, freeNeg K I (FreeLieAlgebra.of K k) = -FreeLieAlgebra.of K k :=
      FreeLieAlgebra.lift_of_apply _
    rw [← LieEquiv.coe_toLieHom, LieHom.map_ad_pow, LieHom.map_lie, LieEquiv.coe_toLieHom,
      hof, hof, neg_lie, lie_neg, neg_neg]
    have hsign : ∀ n : ℕ, ∀ y : FreeLieAlgebra K I,
        (ad K _ (-FreeLieAlgebra.of K i) ^ n) y =
          ((-1 : ℤ) ^ n) • (ad K _ (FreeLieAlgebra.of K i) ^ n) y := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        intro y
        rw [ad_pow_succ_apply', neg_lie, ih, lie_zsmul, ← neg_zsmul, pow_succ', neg_one_mul,
          ← ad_pow_succ_apply']
    rw [hsign]
    exact (serreIdeal K A).toSubmodule.toAddSubgroup.zsmul_mem
      (LieSubmodule.subset_lieSpan ⟨i, j, rfl⟩) _
  | zero => simp
  | add _ _ _ _ hu hv => simpa [map_add] using add_mem hu hv
  | smul c _ _ hu => simpa [map_smul] using Submodule.smul_mem _ c hu
  | lie _ _ _ ih => simpa [LieEquiv.map_lie] using LieSubmodule.lie_mem (serreIdeal K A) ih

private noncomputable def auxSerreNegIdeal (hA : A.IsGeneralizedCartan) :
    LieIdeal K (AuxLieAlgebra R) :=
  { (serreIdeal K A).toSubmodule.map (auxNegHom R).toLinearMap with
    lie_mem := fun {z y} hy => by
      rcases hy with ⟨b, hb, rfl⟩
      have hb' : auxChevalley R (auxNegHom R b) ∈ auxSerrePosIdeal R hA :=
        ⟨freeNeg K I b, freeNeg_mem_serreIdeal hb, (auxChevalley_auxNegHom R b).symm⟩
      have hlie : ⁅auxChevalley R z, auxChevalley R (auxNegHom R b)⁆ ∈ auxSerrePosIdeal R hA :=
        LieSubmodule.lie_mem (auxSerrePosIdeal R hA) hb'
      rcases hlie with ⟨a, ha, haEq⟩
      refine ⟨freeNeg K I a, freeNeg_mem_serreIdeal ha, ?_⟩
      simp only [LieHom.coe_toLinearMap] at haEq ⊢
      rw [← auxChevalley_auxPosHom, haEq, ← LieEquiv.map_lie]
      exact (auxChevalley R).left_inv _ }

private theorem ker_auxToPresented_eq (hA : A.IsGeneralizedCartan) :
    (auxToPresented R).ker = auxSerreNegIdeal R hA ⊔ auxSerrePosIdeal R hA := by
  refine le_antisymm ?_ ?_
  · set J := auxSerreNegIdeal R hA ⊔ auxSerrePosIdeal R hA
    have hsat : SatisfiesRelations R (J.mkQ.toLinearMap ∘ₗ auxCartan R)
        (J.mkQ ∘ auxPos R) (J.mkQ ∘ auxNeg R) :=
      { lie_cartan_cartan := fun x y => by
          simp only [LinearMap.comp_apply, LieHom.coe_toLinearMap, ← J.mkQ.map_lie]; simp
        lie_cartan_positive := fun x j => by
          simp only [LinearMap.comp_apply, Function.comp_apply, LieHom.coe_toLinearMap,
            ← J.mkQ.map_lie]; simp
        lie_cartan_negative := fun x j => by
          simp only [LinearMap.comp_apply, Function.comp_apply, LieHom.coe_toLinearMap,
            ← J.mkQ.map_lie]; simp
        lie_positive_negative_self := fun i => by
          simp only [LinearMap.comp_apply, Function.comp_apply, LieHom.coe_toLinearMap,
            ← J.mkQ.map_lie]; simp
        lie_positive_negative_of_ne := fun i j hij => by
          simp only [Function.comp_apply, ← J.mkQ.map_lie]
          simp [lie_auxPos_auxNeg_of_ne R hij]
        serre_positive := fun i j => by
          simp only [Function.comp_apply, ← LieHom.map_lie, ← LieHom.map_ad_pow]
          rw [← LieHom.mem_ker, LieIdeal.mkQ_ker]
          exact LieSubmodule.mem_sup_right ⟨(ad K _ (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
            ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆,
            LieSubmodule.subset_lieSpan ⟨i, j, rfl⟩, auxPosHom_serreRelator R i j⟩
        serre_negative := fun i j => by
          simp only [Function.comp_apply, ← LieHom.map_lie, ← LieHom.map_ad_pow]
          rw [← LieHom.mem_ker, LieIdeal.mkQ_ker]
          refine LieSubmodule.mem_sup_left ⟨(ad K _ (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
            ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆,
            LieSubmodule.subset_lieSpan ⟨i, j, rfl⟩, ?_⟩
          simp [auxNegHom] }
    have hcomp : (lift hsat).comp (auxToPresented R) = J.mkQ :=
      aux_hom_ext (fun _ => by simp [auxToPresented])
        (fun _ => by simp [auxToPresented]) (fun _ => by simp [auxToPresented])
    intro z hz
    rw [LieHom.mem_ker] at hz
    have hz' : J.mkQ z = 0 := by rw [← hcomp, LieHom.comp_apply, hz, map_zero]
    rwa [← LieHom.mem_ker, LieIdeal.mkQ_ker] at hz'
  · refine sup_le ?_ ?_
    · rintro _ ⟨a, ha, rfl⟩
      have hcomp : (auxToPresented R).comp (auxNegHom R) =
          FreeLieAlgebra.lift K (negativeGenerator R) :=
        FreeLieAlgebra.hom_ext fun i => by simp [auxToPresented, auxNegHom]
      have hker := serreIdeal_le_ker_lift (ad_pow_lie_negativeGenerator_negativeGenerator R) ha
      rw [LieHom.mem_ker, ← hcomp] at hker
      exact hker
    · rintro _ ⟨b, hb, rfl⟩
      have hcomp : (auxToPresented R).comp (auxPosHom R) =
          FreeLieAlgebra.lift K (positiveGenerator R) :=
        FreeLieAlgebra.hom_ext fun i => by simp [auxToPresented, auxPosHom]
      have hker := serreIdeal_le_ker_lift (ad_pow_lie_positiveGenerator_positiveGenerator R) hb
      rw [LieHom.mem_ker, ← hcomp] at hker
      exact hker

/-- **Directness of the triangular sum.** For a generalized Cartan matrix `A`, a sum
`negativeQuotientHom R a + cartanElement R x + positiveQuotientHom R b` vanishes in
`PresentedLieAlgebra R` only when `a = 0`, `x = 0`, and `b = 0`. -/
theorem quotientTriangular_eq_zero (hA : A.IsGeneralizedCartan)
    {a b : FreeLieAlgebra K I ⧸ serreIdeal K A} {x : H}
    (h : negativeQuotientHom R a + cartanElement R x + positiveQuotientHom R b = 0) :
    a = 0 ∧ x = 0 ∧ b = 0 := by
  obtain ⟨a₀, rfl⟩ := (serreIdeal K A).surjective_mkQ a
  obtain ⟨b₀, rfl⟩ := (serreIdeal K A).surjective_mkQ b
  have hneg : negativeQuotientHom R ((serreIdeal K A).mkQ a₀) =
      auxToPresented R (auxNegHom R a₀) :=
    DFunLike.congr_fun (FreeLieAlgebra.hom_ext fun _ => by
      simp [negativeQuotientHom, auxToPresented, auxNegHom] :
      (negativeQuotientHom R).comp (serreIdeal K A).mkQ =
        (auxToPresented R).comp (auxNegHom R)) a₀
  have hpos : positiveQuotientHom R ((serreIdeal K A).mkQ b₀) =
      auxToPresented R (auxPosHom R b₀) :=
    DFunLike.congr_fun (FreeLieAlgebra.hom_ext fun _ => by
      simp [positiveQuotientHom, auxToPresented, auxPosHom] :
      (positiveQuotientHom R).comp (serreIdeal K A).mkQ =
        (auxToPresented R).comp (auxPosHom R)) b₀
  have hcart : cartanElement R x = auxToPresented R (auxCartan R x) := (auxLift_auxCartan _ x).symm
  rw [hneg, hcart, hpos, ← map_add, ← map_add, ← LieHom.mem_ker, ker_auxToPresented_eq R hA] at h
  obtain ⟨_, ⟨a', ha', rfl⟩, _, ⟨b', hb', rfl⟩, heq⟩ := (LieSubmodule.mem_sup _ _ _).mp h
  simp only [LieHom.coe_toLinearMap] at heq
  have hsub : auxNegHom R (a₀ - a') + auxCartan R x + auxPosHom R (b₀ - b') = 0 := by
    calc auxNegHom R (a₀ - a') + auxCartan R x + auxPosHom R (b₀ - b')
      _ = (auxNegHom R a₀ + auxCartan R x + auxPosHom R b₀) -
            (auxNegHom R a' + auxPosHom R b') := by simp only [map_sub]; abel
      _ = 0 := sub_eq_zero.mpr heq.symm
  obtain ⟨ha₀, rfl, hb₀⟩ := auxTriangular_eq_zero R hsub
  refine ⟨?_, rfl, ?_⟩
  · rw [← LieHom.mem_ker, LieIdeal.mkQ_ker]; rwa [sub_eq_zero.mp ha₀]
  · rw [← LieHom.mem_ker, LieIdeal.mkQ_ker]; rwa [sub_eq_zero.mp hb₀]

