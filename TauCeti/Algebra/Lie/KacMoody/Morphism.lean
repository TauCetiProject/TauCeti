public import Mathlib.Algebra.Lie.Abelian
public import Mathlib.Algebra.Lie.Prod
public import Mathlib.LinearAlgebra.Projection
public import TauCeti.Algebra.Lie.KacMoody.Triangular
public import TauCeti.LinearAlgebra.Matrix.Cartan.Realization.CentralSplitting

/-!
# Morphisms and central splittings of presented Kac–Moody algebras

A compatible pair `(f, φ)` consisting of an injective map `f : J → I` of Dynkin nodes and a linear
map `φ : H₁ →ₗ[K] H₂` between realizations of integral matrices `A₁` and `A₂` satisfying
`A₁ i j = A₂ (f i) (f j)`, `φ (R₁.coroot j) = R₂.coroot (f j)`, and
`R₁.root j x = R₂.root (f j) (φ x)` induces a Lie algebra homomorphism
`TauCeti.KacMoody.subdiagramHom` from `PresentedLieAlgebra R₁` to `PresentedLieAlgebra R₂`. This
covers Levi embeddings along submatrices, Dynkin diagram automorphisms, and same-matrix morphisms
between realizations (`TauCeti.KacMoody.mapLinear` and `TauCeti.KacMoody.mapEquiv`). For a
generalized Cartan matrix, the triangular decomposition identifies the kernel, injectivity, and
surjectivity of `mapLinear` with those of `φ`.

Applied to `CartanRealization.restrict`, the subspace inclusion induces an unconditionally
injective Lie algebra homomorphism `TauCeti.KacMoody.restrictHom`. Whenever `Z ≤ R.cartanCenter` is
a linear complement to `M`, the projection onto `M` along `Z` induces a left-inverse Lie algebra
homomorphism `TauCeti.KacMoody.restrictProj` whose kernel is the central ideal
`TauCeti.KacMoody.centralIdeal R Z hZ`, giving a Lie algebra isomorphism
`TauCeti.KacMoody.centralSplittingEquiv` between
`PresentedLieAlgebra (R.restrict M hc hs) × centralIdeal R Z hZ` and `PresentedLieAlgebra R`.
Combined with `CartanRealization.exists_isMinimal_restrict_isCompl`, every finite-index Kac–Moody
presentation splits as the Lie algebra of a minimal sub-realization direct-summed with an abelian
central ideal.

## Main definitions

* `TauCeti.KacMoody.subdiagramHom`: functorial homomorphism along an injective node map and
  compatible linear map on Cartan realizations.
* `TauCeti.KacMoody.mapLinear`, `TauCeti.KacMoody.mapEquiv`: functoriality for same-matrix
  realization morphisms and `CartanRealization.map`.
* `TauCeti.KacMoody.restrictHom`, `TauCeti.KacMoody.restrictProj`: inclusion and central-projection
  homomorphisms for `CartanRealization.restrict`.
* `TauCeti.KacMoody.centralIdeal`, `TauCeti.KacMoody.restrictIdeal`: the central ideal generated by
  a subspace of `R.cartanCenter` and its complementary ideal.
* `TauCeti.KacMoody.centralSplittingEquiv`: the Lie algebra isomorphism
  `PresentedLieAlgebra (R.restrict M hc hs) × centralIdeal R Z hZ ≃ₗ⁅K⁆ PresentedLieAlgebra R`.
* `TauCeti.KacMoody.cartanElementEquivOfIsEmpty`: for an empty index set, `cartanElement R` is a
  linear equivalence onto the abelian algebra `PresentedLieAlgebra R`.

## Main results

* `TauCeti.KacMoody.ker_mapLinear`, `TauCeti.KacMoody.mapLinear_injective_iff`,
  `TauCeti.KacMoody.mapLinear_surjective_iff`: for a generalized Cartan matrix, `mapLinear` has
  kernel `(ker φ).map (cartanElement R₁)` and reflects injectivity and surjectivity of `φ`.
* `TauCeti.KacMoody.restrictHom_injective`: `restrictHom` is injective for every integral matrix.
* `TauCeti.KacMoody.cartanElement_mem_center_iff`, `TauCeti.KacMoody.centralIdeal_le_center`,
  `TauCeti.KacMoody.ker_restrictProj`, `TauCeti.KacMoody.isCompl_restrictIdeal_centralIdeal`:
  central Cartan elements and central ideal splitting of `PresentedLieAlgebra R`.
* `TauCeti.KacMoody.exists_isMinimal_centralSplitting`: every finite-index realization splits into
  a minimal sub-realization and a central ideal.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Cambridge University Press, 1990,
  §§1.1–1.3.
-/

public section

open LieAlgebra

namespace TauCeti.KacMoody

section Functoriality

variable {J I K H₁ H₂ : Type*} [Field K] [AddCommGroup H₁] [Module K H₁]
  [AddCommGroup H₂] [Module K H₂] {A₁ : Matrix J J ℤ} {A₂ : Matrix I I ℤ}
  {R₁ : CartanRealization (A₁.map (Int.cast : ℤ → K)) H₁}
  {R₂ : CartanRealization (A₂.map (Int.cast : ℤ → K)) H₂}

/-- Generators pushed forward along an injective map of Dynkin nodes and a root/coroot-compatible
linear map satisfy the defining relations of the source realization. -/
theorem satisfiesRelations_subdiagram {f : J → I} (hf : Function.Injective f)
    (hA : ∀ i j, A₁ i j = A₂ (f i) (f j)) {φ : H₁ →ₗ[K] H₂}
    (hc : ∀ j, φ (R₁.coroot j) = R₂.coroot (f j))
    (hr : ∀ x j, R₁.root j x = R₂.root (f j) (φ x)) :
    SatisfiesRelations R₁ ((cartanElement R₂).comp φ)
      (positiveGenerator R₂ ∘ f) (negativeGenerator R₂ ∘ f) where
  lie_cartan_cartan x y := by simp
  lie_cartan_positive x j := by simp [hr]
  lie_cartan_negative x j := by simp [hr]
  lie_positive_negative_self j := by simp [hc]
  lie_positive_negative_of_ne i j hij := by
    simpa using lie_positiveGenerator_negativeGenerator_of_ne R₂ (hf.ne hij)
  serre_positive i j := by
    simp [hA i j]
  serre_negative i j := by
    simp [hA i j]

/-- The Lie algebra homomorphism `PresentedLieAlgebra R₁ →ₗ⁅K⁆ PresentedLieAlgebra R₂` induced by
an injective map `f : J → I` of Dynkin nodes and a compatible linear map `φ : H₁ →ₗ[K] H₂`. -/
noncomputable def subdiagramHom {f : J → I} (hf : Function.Injective f)
    (hA : ∀ i j, A₁ i j = A₂ (f i) (f j)) (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ j, φ (R₁.coroot j) = R₂.coroot (f j))
    (hr : ∀ x j, R₁.root j x = R₂.root (f j) (φ x)) :
    PresentedLieAlgebra R₁ →ₗ⁅K⁆ PresentedLieAlgebra R₂ :=
  lift (satisfiesRelations_subdiagram hf hA hc hr)

@[simp]
theorem subdiagramHom_cartanElement {f : J → I} (hf : Function.Injective f)
    (hA : ∀ i j, A₁ i j = A₂ (f i) (f j)) (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ j, φ (R₁.coroot j) = R₂.coroot (f j))
    (hr : ∀ x j, R₁.root j x = R₂.root (f j) (φ x)) (x : H₁) :
    subdiagramHom hf hA φ hc hr (cartanElement R₁ x) = cartanElement R₂ (φ x) := by
  simp [subdiagramHom]

@[simp]
theorem subdiagramHom_positiveGenerator {f : J → I} (hf : Function.Injective f)
    (hA : ∀ i j, A₁ i j = A₂ (f i) (f j)) (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ j, φ (R₁.coroot j) = R₂.coroot (f j))
    (hr : ∀ x j, R₁.root j x = R₂.root (f j) (φ x)) (j : J) :
    subdiagramHom hf hA φ hc hr (positiveGenerator R₁ j) = positiveGenerator R₂ (f j) := by
  simp [subdiagramHom]

@[simp]
theorem subdiagramHom_negativeGenerator {f : J → I} (hf : Function.Injective f)
    (hA : ∀ i j, A₁ i j = A₂ (f i) (f j)) (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ j, φ (R₁.coroot j) = R₂.coroot (f j))
    (hr : ∀ x j, R₁.root j x = R₂.root (f j) (φ x)) (j : J) :
    subdiagramHom hf hA φ hc hr (negativeGenerator R₁ j) = negativeGenerator R₂ (f j) := by
  simp [subdiagramHom]

/-- A Dynkin-diagram equivalence `e : J ≃ I` together with a compatible linear equivalence
`φ : H₁ ≃ₗ[K] H₂` induces a Lie algebra isomorphism of presented Kac–Moody algebras. -/
noncomputable def reindexEquiv (e : J ≃ I) (hA : ∀ i j, A₁ i j = A₂ (e i) (e j))
    (φ : H₁ ≃ₗ[K] H₂) (hc : ∀ j, φ (R₁.coroot j) = R₂.coroot (e j))
    (hr : ∀ x j, R₁.root j x = R₂.root (e j) (φ x)) :
    PresentedLieAlgebra R₁ ≃ₗ⁅K⁆ PresentedLieAlgebra R₂ :=
  have hA' : ∀ i j, A₂ i j = A₁ (e.symm i) (e.symm j) := fun i j => by
    simpa using (hA (e.symm i) (e.symm j)).symm
  have hc' : ∀ i, φ.symm (R₂.coroot i) = R₁.coroot (e.symm i) := fun i =>
    φ.injective (by simpa using (hc (e.symm i)).symm)
  have hr' : ∀ y i, R₂.root i y = R₁.root (e.symm i) (φ.symm y) := fun y i => by
    simpa using (hr (φ.symm y) (e.symm i)).symm
  let f₁ := subdiagramHom e.injective hA φ.toLinearMap hc hr
  let f₂ := subdiagramHom e.symm.injective hA' φ.symm.toLinearMap hc' hr'
  LieEquiv.mk f₁ f₂
    (fun x => DFunLike.congr_fun (by ext <;> simp [f₁, f₂] : f₂.comp f₁ = LieHom.id) x)
    (fun y => DFunLike.congr_fun (by ext <;> simp [f₁, f₂] : f₁.comp f₂ = LieHom.id) y)

end Functoriality

section SameMatrix

variable {I K H₁ H₂ H₃ : Type*} [Field K]
  [AddCommGroup H₁] [Module K H₁] [AddCommGroup H₂] [Module K H₂] [AddCommGroup H₃] [Module K H₃]
  {A : Matrix I I ℤ}
  {R₁ : CartanRealization (A.map (Int.cast : ℤ → K)) H₁}
  {R₂ : CartanRealization (A.map (Int.cast : ℤ → K)) H₂}
  {R₃ : CartanRealization (A.map (Int.cast : ℤ → K)) H₃}

/-- The Lie algebra homomorphism induced by a root- and coroot-preserving linear map between two
realizations of the same integral matrix `A`. -/
noncomputable def mapLinear (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) :
    PresentedLieAlgebra R₁ →ₗ⁅K⁆ PresentedLieAlgebra R₂ :=
  subdiagramHom Function.injective_id (fun _ _ => rfl) φ hc hr

@[simp]
theorem mapLinear_cartanElement (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) (x : H₁) :
    mapLinear φ hc hr (cartanElement R₁ x) = cartanElement R₂ (φ x) := by
  simp [mapLinear]

@[simp]
theorem mapLinear_positiveGenerator (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) (i : I) :
    mapLinear φ hc hr (positiveGenerator R₁ i) = positiveGenerator R₂ i := by
  simp [mapLinear]

@[simp]
theorem mapLinear_negativeGenerator (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) (i : I) :
    mapLinear φ hc hr (negativeGenerator R₁ i) = negativeGenerator R₂ i := by
  simp [mapLinear]

@[simp]
theorem mapLinear_id (R : CartanRealization (A.map (Int.cast : ℤ → K)) H₁) :
    mapLinear (R₁ := R) (R₂ := R) LinearMap.id (fun _ => rfl) (fun _ _ => rfl) = LieHom.id := by
  ext <;> simp

theorem mapLinear_comp (φ : H₁ →ₗ[K] H₂) (hc₁ : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr₁ : ∀ x i, R₁.root i x = R₂.root i (φ x))
    (ψ : H₂ →ₗ[K] H₃) (hc₂ : ∀ i, ψ (R₂.coroot i) = R₃.coroot i)
    (hr₂ : ∀ y i, R₂.root i y = R₃.root i (ψ y)) :
    (mapLinear ψ hc₂ hr₂).comp (mapLinear φ hc₁ hr₁) =
      mapLinear (ψ.comp φ) (fun i => by simp [hc₁, hc₂])
        (fun x i => (hr₁ x i).trans (hr₂ (φ x) i)) := by
  ext <;> simp

@[simp]
theorem mapLinear_comp_positiveQuotientHom (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) :
    (mapLinear φ hc hr).comp (positiveQuotientHom R₁) = positiveQuotientHom R₂ :=
  (serreIdeal K A).lieHom_qext fun x => DFunLike.congr_fun
    (FreeLieAlgebra.hom_ext (fun i => by
      change mapLinear φ hc hr
        (positiveQuotientHom R₁ ((serreIdeal K A).mkQ (FreeLieAlgebra.of K i))) =
        positiveQuotientHom R₂ ((serreIdeal K A).mkQ (FreeLieAlgebra.of K i))
      rw [positiveQuotientHom_mk_of, positiveQuotientHom_mk_of, mapLinear_positiveGenerator]) :
      ((mapLinear φ hc hr).comp (positiveQuotientHom R₁)).comp (serreIdeal K A).mkQ =
        (positiveQuotientHom R₂).comp (serreIdeal K A).mkQ) x

@[simp]
theorem mapLinear_comp_negativeQuotientHom (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) :
    (mapLinear φ hc hr).comp (negativeQuotientHom R₁) = negativeQuotientHom R₂ :=
  (serreIdeal K A).lieHom_qext fun x => DFunLike.congr_fun
    (FreeLieAlgebra.hom_ext (fun i => by
      change mapLinear φ hc hr
        (negativeQuotientHom R₁ ((serreIdeal K A).mkQ (FreeLieAlgebra.of K i))) =
        negativeQuotientHom R₂ ((serreIdeal K A).mkQ (FreeLieAlgebra.of K i))
      rw [negativeQuotientHom_mk_of, negativeQuotientHom_mk_of, mapLinear_negativeGenerator]) :
      ((mapLinear φ hc hr).comp (negativeQuotientHom R₁)).comp (serreIdeal K A).mkQ =
        (negativeQuotientHom R₂).comp (serreIdeal K A).mkQ) x

@[simp]
theorem mapLinear_comp_serreHom [DecidableEq I] (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) :
    (mapLinear φ hc hr).comp (serreHom R₁) = serreHom R₂ :=
  serre_hom_ext (fun i => by simp) (fun i => by simp)

/-- Transporting a realization `R` along a linear equivalence `e : H₁ ≃ₗ[K] H₂` induces a Lie
algebra isomorphism `PresentedLieAlgebra R ≃ₗ⁅K⁆ PresentedLieAlgebra (R.map e)`. -/
noncomputable def mapEquiv (R : CartanRealization (A.map (Int.cast : ℤ → K)) H₁)
    (e : H₁ ≃ₗ[K] H₂) :
    PresentedLieAlgebra R ≃ₗ⁅K⁆ PresentedLieAlgebra (R.map e) :=
  reindexEquiv (Equiv.refl I) (fun _ _ => rfl) e (fun i => (R.map_coroot e i).symm)
    (fun x i => by simp)

private theorem eq_zero_of_quotient_sum_eq_zero (hA : A.IsGeneralizedCartan)
    {a b : FreeLieAlgebra K I ⧸ serreIdeal K A} {y : H₂}
    (h : negativeQuotientHom R₂ a + cartanElement R₂ y + positiveQuotientHom R₂ b = 0) :
    a = 0 ∧ y = 0 ∧ b = 0 := by
  rw [← coe_negativeEquiv_apply R₂ hA, ← coe_positiveEquiv_apply R₂ hA] at h
  have htri : (negativeEquiv R₂ hA a, y, positiveEquiv R₂ hA b) = (0, 0, 0) :=
    (triangularEquiv R₂ hA).injective (by simpa using h)
  exact ⟨(negativeEquiv R₂ hA).injective (by simpa using congrArg Prod.fst htri),
    congrArg (fun p => p.2.1) htri,
    (positiveEquiv R₂ hA).injective (by simpa using congrArg (fun p => p.2.2) htri)⟩

/-- **Kernel of `mapLinear`.** For a generalized Cartan matrix `A`, the kernel of
`mapLinear φ hc hr` is the image of `ker φ` under `cartanElement R₁`. -/
theorem ker_mapLinear (hA : A.IsGeneralizedCartan) (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) :
    ((mapLinear φ hc hr).ker : Submodule K (PresentedLieAlgebra R₁)) =
      (LinearMap.ker φ).map (cartanElement R₁) := by
  refine le_antisymm ?_ ?_
  · intro z hz
    simp only [LieSubalgebra.mem_toSubmodule, LieIdeal.mem_toLieSubalgebra, LieHom.mem_ker] at hz
    obtain ⟨⟨u, x, w⟩, rfl⟩ := triangularLinearMap_surjective R₁ z
    obtain ⟨a, rfl⟩ := (negativeEquiv R₁ hA).surjective u
    obtain ⟨b, rfl⟩ := (positiveEquiv R₁ hA).surjective w
    simp only [triangularLinearMap_apply, LieEquiv.coe_toLieHom, coe_negativeEquiv_apply,
      coe_positiveEquiv_apply] at hz ⊢
    have hF : mapLinear φ hc hr (negativeQuotientHom R₁ a) = negativeQuotientHom R₂ a :=
      DFunLike.congr_fun (mapLinear_comp_negativeQuotientHom φ hc hr) a
    have hE : mapLinear φ hc hr (positiveQuotientHom R₁ b) = positiveQuotientHom R₂ b :=
      DFunLike.congr_fun (mapLinear_comp_positiveQuotientHom φ hc hr) b
    rw [map_add, map_add, hF, mapLinear_cartanElement, hE] at hz
    obtain ⟨rfl, hφx, rfl⟩ := eq_zero_of_quotient_sum_eq_zero hA hz
    exact ⟨x, hφx, by simp⟩
  · rintro _ ⟨x, hx, rfl⟩
    simp only [LieSubalgebra.mem_toSubmodule, LieIdeal.mem_toLieSubalgebra, LieHom.mem_ker,
      mapLinear_cartanElement, LinearMap.mem_ker.mp hx, map_zero]

/-- For a generalized Cartan matrix, `mapLinear φ hc hr` is injective iff `φ` is injective. -/
theorem mapLinear_injective_iff (hA : A.IsGeneralizedCartan) (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) :
    Function.Injective (mapLinear φ hc hr) ↔ Function.Injective φ := by
  constructor
  · intro hinj x y hxy
    exact cartanElement_injective R₁ hA <| hinj <| by
      rw [mapLinear_cartanElement, mapLinear_cartanElement, hxy]
  · intro hinj
    rw [← LieHom.ker_eq_bot, ← LieSubmodule.toSubmodule_eq_bot]
    change ((mapLinear φ hc hr).ker : Submodule K (PresentedLieAlgebra R₁)) = ⊥
    rw [ker_mapLinear hA φ hc hr, LinearMap.ker_eq_bot.mpr hinj, Submodule.map_bot]

/-- For a generalized Cartan matrix, `mapLinear φ hc hr` is surjective iff `φ` is surjective. -/
theorem mapLinear_surjective_iff (hA : A.IsGeneralizedCartan) (φ : H₁ →ₗ[K] H₂)
    (hc : ∀ i, φ (R₁.coroot i) = R₂.coroot i)
    (hr : ∀ x i, R₁.root i x = R₂.root i (φ x)) :
    Function.Surjective (mapLinear φ hc hr) ↔ Function.Surjective φ := by
  constructor
  · intro hsurj y
    obtain ⟨z, hz⟩ := hsurj (cartanElement R₂ y)
    obtain ⟨⟨u, x, w⟩, rfl⟩ := triangularLinearMap_surjective R₁ z
    obtain ⟨a, rfl⟩ := (negativeEquiv R₁ hA).surjective u
    obtain ⟨b, rfl⟩ := (positiveEquiv R₁ hA).surjective w
    simp only [triangularLinearMap_apply, LieEquiv.coe_toLieHom, coe_negativeEquiv_apply,
      coe_positiveEquiv_apply] at hz
    have hF : mapLinear φ hc hr (negativeQuotientHom R₁ a) = negativeQuotientHom R₂ a :=
      DFunLike.congr_fun (mapLinear_comp_negativeQuotientHom φ hc hr) a
    have hE : mapLinear φ hc hr (positiveQuotientHom R₁ b) = positiveQuotientHom R₂ b :=
      DFunLike.congr_fun (mapLinear_comp_positiveQuotientHom φ hc hr) b
    rw [map_add, map_add, hF, mapLinear_cartanElement, hE] at hz
    have hzero : negativeQuotientHom R₂ a + cartanElement R₂ (φ x - y) +
        positiveQuotientHom R₂ b = 0 := by
      rw [map_sub]
      calc
        negativeQuotientHom R₂ a + (cartanElement R₂ (φ x) - cartanElement R₂ y) +
            positiveQuotientHom R₂ b =
          (negativeQuotientHom R₂ a + cartanElement R₂ (φ x) + positiveQuotientHom R₂ b) -
            cartanElement R₂ y := by abel
        _ = 0 := sub_eq_zero.mpr hz
    exact ⟨x, sub_eq_zero.mp (eq_zero_of_quotient_sum_eq_zero hA hzero).2.1⟩
  · intro hsurj z
    obtain ⟨⟨u, y, w⟩, rfl⟩ := triangularLinearMap_surjective R₂ z
    obtain ⟨a, rfl⟩ := (negativeEquiv R₂ hA).surjective u
    obtain ⟨b, rfl⟩ := (positiveEquiv R₂ hA).surjective w
    obtain ⟨x, rfl⟩ := hsurj y
    refine ⟨negativeQuotientHom R₁ a + cartanElement R₁ x + positiveQuotientHom R₁ b, ?_⟩
    have hF : mapLinear φ hc hr (negativeQuotientHom R₁ a) = negativeQuotientHom R₂ a :=
      DFunLike.congr_fun (mapLinear_comp_negativeQuotientHom φ hc hr) a
    have hE : mapLinear φ hc hr (positiveQuotientHom R₁ b) = positiveQuotientHom R₂ b :=
      DFunLike.congr_fun (mapLinear_comp_positiveQuotientHom φ hc hr) b
    simp [triangularLinearMap_apply, hF, hE]

end SameMatrix

section CentralSplitting

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- The canonical Lie algebra homomorphism from the presented algebra of a restricted realization
`R.restrict M hc hs` to `PresentedLieAlgebra R`. -/
noncomputable def restrictHom (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) :
    PresentedLieAlgebra (R.restrict M hc hs) →ₗ⁅K⁆ PresentedLieAlgebra R :=
  mapLinear M.subtype
    (fun i => (Submodule.subtype_apply _).trans (R.coe_restrict_coroot M hc hs i))
    (fun m i => (R.restrict_root_apply M hc hs i m).trans
      (congrArg (R.root i) (Submodule.subtype_apply m).symm))

@[simp]
theorem restrictHom_cartanElement (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (m : M) :
    restrictHom R M hc hs (cartanElement (R.restrict M hc hs) m) = cartanElement R m :=
  mapLinear_cartanElement _ _ _ m

@[simp]
theorem restrictHom_positiveGenerator (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (i : I) :
    restrictHom R M hc hs (positiveGenerator (R.restrict M hc hs) i) = positiveGenerator R i :=
  mapLinear_positiveGenerator _ _ _ i

@[simp]
theorem restrictHom_negativeGenerator (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (i : I) :
    restrictHom R M hc hs (negativeGenerator (R.restrict M hc hs) i) = negativeGenerator R i :=
  mapLinear_negativeGenerator _ _ _ i

/-- When `Z ≤ R.cartanCenter` is complementary to `M`, projecting `H` onto `M` along `Z` induces a
Lie algebra retraction `PresentedLieAlgebra R →ₗ⁅K⁆ PresentedLieAlgebra (R.restrict M hc hs)`. -/
noncomputable def restrictProj (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z) :
    PresentedLieAlgebra R →ₗ⁅K⁆ PresentedLieAlgebra (R.restrict M hc hs) :=
  mapLinear (M.projectionOnto Z hMZ)
    (fun i => Subtype.ext <| (Submodule.coe_projectionOnto_apply hMZ _).trans <|
      (Submodule.projection_apply_of_mem_left hMZ (hc (R.coroot_mem_corootSpan i))).trans
        (R.coe_restrict_coroot M hc hs i).symm)
    (fun x i => by
      have hdecomp := M.projection_add_projection_eq_self hMZ x
      have hz : Z.projection M hMZ.symm x ∈ R.cartanCenter :=
        hZ (Submodule.projection_apply_mem _ _)
      conv_lhs => rw [← hdecomp]
      rw [map_add, (R.mem_cartanCenter_iff _).mp hz i, add_zero, R.restrict_root_apply,
        Submodule.coe_projectionOnto_apply])

@[simp]
theorem restrictProj_cartanElement (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z) (x : H) :
    restrictProj R M Z hc hs hZ hMZ (cartanElement R x) =
      cartanElement (R.restrict M hc hs) (M.projectionOnto Z hMZ x) := by
  simp [restrictProj]

@[simp]
theorem restrictProj_positiveGenerator (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z) (i : I) :
    restrictProj R M Z hc hs hZ hMZ (positiveGenerator R i) =
      positiveGenerator (R.restrict M hc hs) i := by
  simp [restrictProj]

@[simp]
theorem restrictProj_negativeGenerator (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z) (i : I) :
    restrictProj R M Z hc hs hZ hMZ (negativeGenerator R i) =
      negativeGenerator (R.restrict M hc hs) i := by
  simp [restrictProj]

@[simp]
theorem restrictProj_comp_restrictHom (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z) :
    (restrictProj R M Z hc hs hZ hMZ).comp (restrictHom R M hc hs) = LieHom.id := by
  ext x <;> simp

/-- **Unconditional injectivity of `restrictHom`.** Extending `M ⊓ R.cartanCenter` to a complement
inside `R.cartanCenter` produces a left-inverse Lie algebra homomorphism `restrictProj`, so
`restrictHom` is injective for every integral matrix `A` without assuming `IsGeneralizedCartan`. -/
theorem restrictHom_injective (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) :
    Function.Injective (restrictHom R M hc hs) := by
  obtain ⟨Z, hd, hsup⟩ := IsModularLattice.exists_disjoint_and_sup_eq
    (inf_le_right : M ⊓ R.cartanCenter ≤ R.cartanCenter)
  have hZ : Z ≤ R.cartanCenter := hsup ▸ le_sup_right
  have hdisj : Disjoint M Z := by
    rw [disjoint_iff] at hd ⊢
    calc
      M ⊓ Z = M ⊓ (R.cartanCenter ⊓ Z) := by rw [inf_eq_right.mpr hZ]
      _ = (M ⊓ R.cartanCenter) ⊓ Z := (inf_assoc M R.cartanCenter Z).symm
      _ = ⊥ := hd
  have hMZ : IsCompl M Z :=
    IsCompl.of_eq hdisj.eq_bot <| top_unique <| by
      rw [← hs, ← hsup, ← sup_assoc, (sup_eq_left.mpr (inf_le_left : M ⊓ R.cartanCenter ≤ M))]
  exact Function.LeftInverse.injective
    (DFunLike.congr_fun (restrictProj_comp_restrictHom R M Z hc hs hZ hMZ))

/-- Every element of `R.cartanCenter` maps into the Lie center of `PresentedLieAlgebra R`. -/
theorem cartanElement_mem_center {z : H} (hz : z ∈ R.cartanCenter) :
    cartanElement R z ∈ LieAlgebra.center K (PresentedLieAlgebra R) := by
  rw [LieAlgebra.center, LieModule.mem_maxTrivSubmodule]
  have hsub : ∀ y ∈ LieSubalgebra.lieSpan K (PresentedLieAlgebra R)
      (Set.range (cartanElement R) ∪ Set.range (positiveGenerator R) ∪
        Set.range (negativeGenerator R)),
      ⁅y, cartanElement R z⁆ = 0 := by
    intro y hy
    induction hy using LieSubalgebra.lieSpan_induction with
    | mem w hw =>
      rcases hw with (⟨x, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩
      · simp
      · rw [← lie_skew, lie_cartanElement_positiveGenerator, (R.mem_cartanCenter_iff z).mp hz i,
          zero_smul, neg_zero]
      · rw [← lie_skew, lie_cartanElement_negativeGenerator, (R.mem_cartanCenter_iff z).mp hz i,
          zero_smul, neg_zero, neg_zero]
    | zero => simp
    | add _ _ _ _ h₁ h₂ => simp [add_lie, h₁, h₂]
    | smul c _ _ h₁ => simp [smul_lie, h₁]
    | lie u v _ _ hu hv => rw [lie_lie, hu, hv, lie_zero, lie_zero, sub_self]
  intro y
  exact hsub y (by rw [lieSpan_generators_eq_top R]; trivial)

/-- For a generalized Cartan matrix, `cartanElement R z` lies in the Lie center of
`PresentedLieAlgebra R` if and only if `z ∈ R.cartanCenter`. -/
theorem cartanElement_mem_center_iff (hA : A.IsGeneralizedCartan) {z : H} :
    cartanElement R z ∈ LieAlgebra.center K (PresentedLieAlgebra R) ↔ z ∈ R.cartanCenter := by
  refine ⟨fun hz => (R.mem_cartanCenter_iff z).mpr fun i => ?_, cartanElement_mem_center R⟩
  rw [LieAlgebra.center, LieModule.mem_maxTrivSubmodule] at hz
  have hi := hz (positiveGenerator R i)
  rw [← lie_skew, lie_cartanElement_positiveGenerator, neg_eq_zero, smul_eq_zero] at hi
  exact hi.resolve_right (positiveGenerator_ne_zero R hA i)

/-- The central Lie ideal of `PresentedLieAlgebra R` spanned by the image of a subspace
`Z ≤ R.cartanCenter` under `cartanElement R`. -/
noncomputable def centralIdeal (Z : Submodule K H) (hZ : Z ≤ R.cartanCenter) :
    LieIdeal K (PresentedLieAlgebra R) :=
  { Z.map (cartanElement R) with
    lie_mem := by
      rintro x _ ⟨z, hz, rfl⟩
      have hzc := cartanElement_mem_center R (hZ hz)
      rw [LieAlgebra.center, LieModule.mem_maxTrivSubmodule] at hzc
      rw [hzc x]
      exact (Z.map (cartanElement R)).zero_mem }

theorem centralIdeal_toSubmodule (Z : Submodule K H) (hZ : Z ≤ R.cartanCenter) :
    (centralIdeal R Z hZ : Submodule K (PresentedLieAlgebra R)) = Z.map (cartanElement R) :=
  (rfl)

theorem mem_centralIdeal_iff (Z : Submodule K H) (hZ : Z ≤ R.cartanCenter)
    {y : PresentedLieAlgebra R} :
    y ∈ centralIdeal R Z hZ ↔ ∃ z ∈ Z, cartanElement R z = y :=
  Iff.rfl

/-- `centralIdeal R Z hZ` lies in the Lie center of `PresentedLieAlgebra R`. -/
theorem centralIdeal_le_center (Z : Submodule K H) (hZ : Z ≤ R.cartanCenter) :
    centralIdeal R Z hZ ≤ LieAlgebra.center K (PresentedLieAlgebra R) := by
  rintro _ ⟨z, hz, rfl⟩
  exact cartanElement_mem_center R (hZ hz)

instance isLieAbelian_centralIdeal (Z : Submodule K H) (hZ : Z ≤ R.cartanCenter) :
    IsLieAbelian (centralIdeal R Z hZ) :=
  ⟨fun x y => Subtype.ext <| by
    have hy := centralIdeal_le_center R Z hZ y.2
    rw [LieAlgebra.center, LieModule.mem_maxTrivSubmodule] at hy
    exact hy x.1⟩

/-- For a generalized Cartan matrix, `cartanElement R` restricts to a `K`-linear isomorphism
`Z ≃ₗ[K] centralIdeal R Z hZ`. -/
noncomputable def centralIdealLinearEquiv (hA : A.IsGeneralizedCartan)
    (Z : Submodule K H) (hZ : Z ≤ R.cartanCenter) :
    Z ≃ₗ[K] centralIdeal R Z hZ :=
  Z.equivMapOfInjective (cartanElement R) (cartanElement_injective R hA)

private theorem sub_restrictHom_restrictProj_mem_centralIdeal (M Z : Submodule K H)
    (hc : R.corootSpan ≤ M) (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter)
    (hMZ : IsCompl M Z) (y : PresentedLieAlgebra R) :
    y - restrictHom R M hc hs (restrictProj R M Z hc hs hZ hMZ y) ∈ centralIdeal R Z hZ := by
  set f := (restrictHom R M hc hs).comp (restrictProj R M Z hc hs hZ hMZ)
  have hf_idem : ∀ z, f (f z) = f z := fun z => by
    simp only [f, LieHom.comp_apply]
    rw [← LieHom.comp_apply (restrictProj R M Z hc hs hZ hMZ), restrictProj_comp_restrictHom,
      LieHom.id_apply]
  let S : LieSubalgebra K (PresentedLieAlgebra R) :=
    { carrier := {w | w - f w ∈ centralIdeal R Z hZ}
      zero_mem' := by simp
      add_mem' := fun {a b} ha hb => by
        change (a + b) - f (a + b) ∈ centralIdeal R Z hZ
        rw [map_add, add_sub_add_comm]
        exact add_mem ha hb
      smul_mem' := fun c {a} ha => by
        change c • a - f (c • a) ∈ centralIdeal R Z hZ
        rw [map_smul, ← smul_sub]
        exact Submodule.smul_mem _ c ha
      lie_mem' := fun {a b} ha hb => by
        change ⁅a, b⁆ - f ⁅a, b⁆ ∈ centralIdeal R Z hZ
        have ha' : ⁅a - f a, b⁆ = 0 := by
          have hc_a := centralIdeal_le_center R Z hZ ha
          rw [LieAlgebra.center, LieModule.mem_maxTrivSubmodule] at hc_a
          rw [← lie_skew, hc_a b, neg_zero]
        have hb' : ⁅f a, b - f b⁆ = 0 := by
          have hc_b := centralIdeal_le_center R Z hZ hb
          rw [LieAlgebra.center, LieModule.mem_maxTrivSubmodule] at hc_b
          exact hc_b (f a)
        have hlie : ⁅a, b⁆ = ⁅f a, f b⁆ := by
          calc
            ⁅a, b⁆ = ⁅(a - f a) + f a, b⁆ := by rw [sub_add_cancel]
            _ = ⁅f a, (b - f b) + f b⁆ := by rw [add_lie, ha', zero_add, sub_add_cancel]
            _ = ⁅f a, f b⁆ := by rw [lie_add, hb', zero_add]
        rw [hlie, ← f.map_lie, hf_idem, sub_self]
        exact zero_mem _ }
  have htop : S = ⊤ := by
    rw [eq_top_iff, ← lieSpan_generators_eq_top R, LieSubalgebra.lieSpan_le]
    rintro _ ((⟨x, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩)
    · refine ⟨Z.projection M hMZ.symm x, Submodule.projection_apply_mem _ _, ?_⟩
      change cartanElement R (Z.projection M hMZ.symm x) = cartanElement R x -
        restrictHom R M hc hs (restrictProj R M Z hc hs hZ hMZ (cartanElement R x))
      rw [restrictProj_cartanElement, restrictHom_cartanElement, Submodule.coe_projectionOnto_apply,
        ← map_sub]
      congr 1
      exact M.projection_eq_self_sub_projection hMZ x
    · change positiveGenerator R i - f (positiveGenerator R i) ∈ centralIdeal R Z hZ
      simp [f]
    · change negativeGenerator R i - f (negativeGenerator R i) ∈ centralIdeal R Z hZ
      simp [f]
  have hy : y ∈ S := by rw [htop]; trivial
  exact hy

/-- The kernel of `restrictProj` is `centralIdeal R Z hZ`. -/
@[simp]
theorem ker_restrictProj (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z) :
    (restrictProj R M Z hc hs hZ hMZ).ker = centralIdeal R Z hZ := by
  ext y
  constructor
  · intro hy
    rw [LieHom.mem_ker] at hy
    simpa [hy] using sub_restrictHom_restrictProj_mem_centralIdeal R M Z hc hs hZ hMZ y
  · rintro ⟨z, hz, rfl⟩
    rw [LieHom.mem_ker, restrictProj_cartanElement,
      M.projectionOnto_apply_of_mem_right hMZ hz, map_zero]

/-- **Central splitting as a Lie algebra product.** Given `Z ≤ R.cartanCenter` complementary to
`M`, addition identifies `PresentedLieAlgebra (R.restrict M hc hs) × centralIdeal R Z hZ` with
`PresentedLieAlgebra R` as Lie algebras. -/
noncomputable def centralSplittingEquiv (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z) :
    (PresentedLieAlgebra (R.restrict M hc hs) × centralIdeal R Z hZ) ≃ₗ⁅K⁆ PresentedLieAlgebra R
    where
  toFun p := restrictHom R M hc hs p.1 + (p.2 : PresentedLieAlgebra R)
  map_add' _ _ := by simp; abel
  map_smul' _ _ := by simp [smul_add]
  map_lie' {p q} := by
    have hp := centralIdeal_le_center R Z hZ p.2.2
    have hq := centralIdeal_le_center R Z hZ q.2.2
    rw [LieAlgebra.center, LieModule.mem_maxTrivSubmodule] at hp hq
    have hp' : ∀ u : PresentedLieAlgebra R, ⁅(p.2 : PresentedLieAlgebra R), u⁆ = 0 := fun u => by
      rw [← lie_skew, hp u, neg_zero]
    have hpq : ⁅p.2, q.2⁆ = 0 := Subtype.ext (hq p.2.1)
    simp [add_lie, lie_add, hp', hq, hpq]
  invFun y :=
    (restrictProj R M Z hc hs hZ hMZ y,
      ⟨y - restrictHom R M hc hs (restrictProj R M Z hc hs hZ hMZ y),
        sub_restrictHom_restrictProj_mem_centralIdeal R M Z hc hs hZ hMZ y⟩)
  left_inv := by
    rintro ⟨w, z, hz⟩
    have hz0 : restrictProj R M Z hc hs hZ hMZ z = 0 := by
      rw [← LieHom.mem_ker, ker_restrictProj]
      exact hz
    have hw : restrictProj R M Z hc hs hZ hMZ (restrictHom R M hc hs w) = w :=
      DFunLike.congr_fun (restrictProj_comp_restrictHom R M Z hc hs hZ hMZ) w
    ext
    · simp [hw, hz0]
    · simp [hw, hz0]
  right_inv y := by simp

@[simp]
theorem centralSplittingEquiv_apply (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z)
    (p : PresentedLieAlgebra (R.restrict M hc hs) × centralIdeal R Z hZ) :
    centralSplittingEquiv R M Z hc hs hZ hMZ p =
      restrictHom R M hc hs p.1 + (p.2 : PresentedLieAlgebra R) :=
  (rfl)

/-- In a central splitting `H = M ⊕ Z`, the image of `restrictHom R M hc hs` is a Lie ideal of
`PresentedLieAlgebra R`. -/
noncomputable def restrictIdeal (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z) :
    LieIdeal K (PresentedLieAlgebra R) :=
  { (restrictHom R M hc hs).range.toSubmodule with
    lie_mem := by
      rintro y _ ⟨w, rfl⟩
      obtain ⟨⟨u, z⟩, rfl⟩ := (centralSplittingEquiv R M Z hc hs hZ hMZ).surjective y
      have hz := centralIdeal_le_center R Z hZ z.2
      rw [LieAlgebra.center, LieModule.mem_maxTrivSubmodule] at hz
      have hz' : ⁅(z : PresentedLieAlgebra R), restrictHom R M hc hs w⁆ = 0 := by
        rw [← lie_skew, hz _, neg_zero]
      simp only [LieEquiv.coe_toLieHom, LieHom.coe_toLinearMap]
      rw [centralSplittingEquiv_apply, add_lie, hz', add_zero, ← LieHom.map_lie]
      exact ⟨⁅u, w⁆, rfl⟩ }

/-- `restrictIdeal` and `centralIdeal` are complementary Lie ideals of `PresentedLieAlgebra R`. -/
theorem isCompl_restrictIdeal_centralIdeal (M Z : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (hZ : Z ≤ R.cartanCenter) (hMZ : IsCompl M Z) :
    IsCompl (restrictIdeal R M Z hc hs hZ hMZ) (centralIdeal R Z hZ) := by
  refine IsCompl.of_eq ?_ ?_
  · ext y
    simp only [LieSubmodule.mem_inf, LieSubmodule.mem_bot]
    constructor
    · rintro ⟨⟨w, rfl⟩, hyZ⟩
      have h0 : restrictProj R M Z hc hs hZ hMZ (restrictHom R M hc hs w) = 0 := by
        rwa [← LieHom.mem_ker, ker_restrictProj]
      have hw : w = 0 :=
        (DFunLike.congr_fun (restrictProj_comp_restrictHom R M Z hc hs hZ hMZ) w).symm.trans h0
      simp [hw]
    · rintro rfl
      exact ⟨zero_mem _, zero_mem _⟩
  · refine eq_top_iff.mpr fun y _ => ?_
    rw [← LieSubmodule.mem_toSubmodule, LieSubmodule.sup_toSubmodule]
    change y ∈ (restrictHom R M hc hs).range.toSubmodule ⊔
      (centralIdeal R Z hZ : Submodule K (PresentedLieAlgebra R))
    exact Submodule.mem_sup.mpr ⟨restrictHom R M hc hs (restrictProj R M Z hc hs hZ hMZ y),
      ⟨restrictProj R M Z hc hs hZ hMZ y, rfl⟩,
      y - restrictHom R M hc hs (restrictProj R M Z hc hs hZ hMZ y),
      sub_restrictHom_restrictProj_mem_centralIdeal R M Z hc hs hZ hMZ y, add_sub_cancel _ _⟩

/-- **Minimal-realization central splitting.** For a finite index type `I`, every Kac–Moody
presentation `PresentedLieAlgebra R` is isomorphic as a Lie algebra to the product of the presented
algebra of a minimal sub-realization `R.restrict M hc hs` and a central ideal
`centralIdeal R Z hZ`. -/
theorem exists_isMinimal_centralSplitting [Fintype I] :
    ∃ (M Z : Submodule K H) (hc : R.corootSpan ≤ M) (hs : M ⊔ R.cartanCenter = ⊤)
      (hZ : Z ≤ R.cartanCenter),
      (R.restrict M hc hs).IsMinimal ∧ IsCompl M Z ∧
        Nonempty ((PresentedLieAlgebra (R.restrict M hc hs) × centralIdeal R Z hZ) ≃ₗ⁅K⁆
          PresentedLieAlgebra R) := by
  obtain ⟨M, Z, hc, hs, hmin, hMZ, hZ⟩ := R.exists_isMinimal_restrict_isCompl
  exact ⟨M, Z, hc, hs, hZ, hmin, hMZ, ⟨centralSplittingEquiv R M Z hc hs hZ hMZ⟩⟩

/-! ### Empty index set -/

@[simp]
theorem positiveSubalgebra_eq_bot_of_isEmpty [IsEmpty I] : positiveSubalgebra R = ⊥ := by
  simp [positiveSubalgebra_def, Set.range_eq_empty]

@[simp]
theorem negativeSubalgebra_eq_bot_of_isEmpty [IsEmpty I] : negativeSubalgebra R = ⊥ := by
  simp [negativeSubalgebra_def, Set.range_eq_empty]

/-- When `I` is empty, `cartanElement R : H →ₗ[K] PresentedLieAlgebra R` is a `K`-linear
isomorphism onto `PresentedLieAlgebra R`. -/
noncomputable def cartanElementEquivOfIsEmpty [IsEmpty I] : H ≃ₗ[K] PresentedLieAlgebra R :=
  LinearEquiv.ofBijective (cartanElement R) ⟨
    cartanElement_injective R (Matrix.IsGeneralizedCartan.of_isEmpty A),
    by
      rw [← LinearMap.range_eq_top]
      have hsup := negativeSubalgebra_sup_range_cartanElement_sup_positiveSubalgebra R
      simpa [positiveSubalgebra_eq_bot_of_isEmpty, negativeSubalgebra_eq_bot_of_isEmpty] using hsup⟩

instance isLieAbelian_of_isEmpty [IsEmpty I] : IsLieAbelian (PresentedLieAlgebra R) :=
  ⟨fun x y => by
    obtain ⟨u, rfl⟩ := (cartanElementEquivOfIsEmpty R).surjective x
    obtain ⟨v, rfl⟩ := (cartanElementEquivOfIsEmpty R).surjective y
    exact lie_cartanElement_cartanElement R u v⟩

end CentralSplitting

section Examples

-- Empty index set: `Matrix.ToLieAlgebra ℚ ![]` is trivial while `PresentedLieAlgebra R` on `ℚ`
-- is isomorphic to `ℚ` via `cartanElementEquivOfIsEmpty`.
example :
    let A : Matrix Empty Empty ℤ := Matrix.of isEmptyElim
    let R : CartanRealization (A.map (Int.cast : ℤ → ℚ)) ℚ :=
      { coroot := isEmptyElim
        root := isEmptyElim
        coroot_linearIndependent := linearIndependent_empty_type
        root_linearIndependent := linearIndependent_empty_type
        root_coroot := isEmptyElim }
    Subsingleton (Matrix.ToLieAlgebra ℚ A) ∧
      Nonempty (ℚ ≃ₗ[ℚ] PresentedLieAlgebra R) := by
  intro A R
  refine ⟨⟨fun x y => ?_⟩, ⟨cartanElementEquivOfIsEmpty R⟩⟩
  have htop : (⊥ : LieSubalgebra ℚ (Matrix.ToLieAlgebra ℚ A)) = ⊤ := by
    simpa [Set.range_eq_empty] using lieSpan_serreE_union_serreF_eq_top ℚ A
  have hx : x ∈ (⊥ : LieSubalgebra ℚ (Matrix.ToLieAlgebra ℚ A)) := htop ▸ trivial
  have hy : y ∈ (⊥ : LieSubalgebra ℚ (Matrix.ToLieAlgebra ℚ A)) := htop ▸ trivial
  simp only [LieSubalgebra.mem_bot] at hx hy
  exact hx.trans hy.symm

end Examples

end TauCeti.KacMoody
