/-!
# The Cartan subalgebra embeds in the Kac–Moody algebra

Let `A` be a generalized Cartan matrix: `Aᵢᵢ = 2`, `Aᵢⱼ ≤ 0` for `i ≠ j`, and `Aᵢⱼ = 0` exactly when
`Aⱼᵢ = 0`. For every realization `R` of `A` over a field `K`, the map
`TauCeti.KacMoody.cartanElement R : H → 𝔤` into the Lie algebra presented by the Chevalley and
Serre relations is injective (`TauCeti.KacMoody.cartanElement_injective`). Neither
symmetrizability, nor characteristic zero, nor the independence of the simple roots and coroots
is used.

The proof constructs, for each functional `μ` on `H`, a representation of the presented algebra
in which `h ∈ H` acts on a nonzero vector by `μ(h)`; letting `μ` vary detects every nonzero
`h`. Following Kac's proof of his Theorem 1.2, the representation is built on the tensor algebra
`T` of the vector space with basis indexed by the nodes, realized as the monoid algebra of the
free monoid on the nodes. On a word `w = j₁ ⋯ jₛ`:

* `fᵢ` acts by left multiplication by the letter `i`;
* `h ∈ H` acts by the scalar `(μ - αⱼ₁ - ⋯ - αⱼₛ)(h)`;
* `eᵢ` acts by `eᵢ 1 = 0` and `eᵢ (j w) = j (eᵢ w) + δᵢⱼ (μ - α(w))(hᵢ) w`, with `α(w)` the
  sum of the simple roots along `w`.

These operators satisfy the Chevalley relations, so they define Kac's representation of the
auxiliary algebra. A generalized Cartan matrix makes the raising Serre relations hold as well:
the raising Serre elements commute with every `fₖ` (`sl₂` string coefficients, through
`IsSl2Triple.lie_f_pow_succ_toEnd_e`) and kill `1`, which generates `T` under the `fₖ`
(Kac, §3.3). The lowering Serre relations hold after passing to the quotient of `T` by the
two-sided ideal generated by the lowering Serre elements, which the dual computation shows to be
stable under every `eₖ`. This ideal lies in the augmentation ideal, so the class of `1` is a
nonzero vector of weight `μ`.

## Main results

* `TauCeti.KacMoody.cartanElement_injective`: Cartan injectivity of the Kac–Moody algebra of a
  realization of a generalized Cartan matrix.
* `TauCeti.KacMoody.lie_ad_pow_lie_eq_zero`: for a generalized Cartan matrix, the lowering
  generators kill the raising Serre elements in any Lie algebra where the Chevalley relations
  hold (Kac, §3.3).

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Theorem 1.2 (the representation
  of the auxiliary algebra on the tensor algebra) and §3.3 (the Serre elements are killed by the
  opposite generators).
-/

public section

open LieAlgebra
open scoped MonoidAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti

namespace KacMoody

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  {R : CartanRealization (A.map (Int.cast : ℤ → K)) H}

/-! ## Lowering kills the raising Serre elements -/

section SerreElement

variable {L : Type*} [LieRing L] [LieAlgebra K L] {φ : H →ₗ[K] L} {E F : I → L}

/-- For a generalized Cartan matrix, every `F k` commutes with each raising Serre element
`(ad (E i)) ^ (-Aᵢⱼ) ⁅E i, E j⁆`, as soon as `φ`, `E` and `F` satisfy the Chevalley relations
(Kac, §3.3). Neither Serre relation is used. -/
theorem lie_ad_pow_lie_eq_zero (hdiag : ∀ i, A i i = 2)
    (hneg : ∀ i j, i ≠ j → A i j ≤ 0) (hzero : ∀ i j, A i j = 0 → A j i = 0)
    (hφE : ∀ x j, ⁅φ x, E j⁆ = R.root j x • E j) (hφF : ∀ x j, ⁅φ x, F j⁆ = -(R.root j x • F j))
    (hself : ∀ i, ⁅E i, F i⁆ = φ (R.coroot i)) (hne : ∀ i j, i ≠ j → ⁅E i, F j⁆ = 0)
    (i j k : I) : ⁅F k, (ad K L (E i) ^ (-A i j).toNat) ⁅E i, E j⁆⁆ = 0 := by
  obtain rfl | hij := eq_or_ne i j
  · simp
  -- If `⁅f, e⁆ = 0`, then `ad f` commutes with the powers of `ad e`.
  have lie_ad_pow_of_lie_eq_zero {e f : L} (hfe : ⁅f, e⁆ = 0) (n : ℕ) (y : L) :
      ⁅f, (ad K L e ^ n) y⁆ = (ad K L e ^ n) ⁅f, y⁆ := by
    simpa only [mul_apply_eq_comp, ad_apply] using
      LinearMap.congr_fun ((LieAlgebra.commute_ad_of_lie_eq_zero hfe).pow_right n).eq y
  have hFE (a b : I) (hab : a ≠ b) : ⁅F b, E a⁆ = 0 := by rw [← lie_skew, hne a b hab, neg_zero]
  have hroot (a b : I) : R.root b (R.coroot a) = (A a b : K) := by simp
  rw [← ad_pow_succ_apply]
  obtain rfl | hki := eq_or_ne k i
  · by_cases h0 : φ (R.coroot k) = 0
    · rw [lie_ad_pow_of_lie_eq_zero (by rw [← lie_skew, hself, h0, neg_zero]), hFE j k hij.symm,
        map_zero]
    have t : IsSl2Triple (φ (R.coroot k)) (E k) (F k) :=
      { h_ne_zero := h0
        lie_e_f := hself k
        lie_h_e_nsmul := by rw [hφE, hroot, hdiag]; simp [two_smul]
        lie_h_f_nsmul := by rw [hφF, hroot, hdiag]; simp [two_smul] }
    have hstring := t.lie_f_pow_succ_toEnd_e (y := E j) (μ := (A k j : K))
      (by rw [hφE, hroot]) (hFE j k hij.symm) (-A k j).toNat
    rw [← ad_eq_toEnd] at hstring
    rw [hstring]
    have hn : (((-A k j).toNat : ℕ) : K) = -(A k j : K) := by
      rw [← Int.cast_natCast, Int.toNat_of_nonneg (by linarith [hneg k j hij]), Int.cast_neg]
    rw [hn, sub_neg_eq_add, neg_add_cancel, mul_zero, zero_smul]
  rw [lie_ad_pow_of_lie_eq_zero (hFE i k hki.symm)]
  obtain rfl | hkj := eq_or_ne k j
  · rw [← lie_skew, hself, pow_succ, mul_apply_eq_comp, map_neg, ad_apply, lie_skew, hφE,
      hroot]
    rcases h : (-A i k).toNat with _ | n
    · have hik : A i k = 0 := le_antisymm (hneg i k hij) (by omega)
      simp [hzero i k hik]
    · rw [map_smul, pow_succ, mul_apply_eq_comp, ad_apply, lie_self, map_zero, smul_zero]
  · rw [hFE j k hkj.symm, map_zero]

end SerreElement

/-! ## Kac's representation on the tensor algebra -/

section TensorAlgebra

open MonoidAlgebra

variable (R) (μ : Module.Dual K H)

/-- The sum of the simple roots along a word. -/
private def rootSum (w : FreeMonoid I) : Module.Dual K H := (w.toList.map R.root).sum

private theorem rootSum_one : rootSum R (1 : FreeMonoid I) = 0 := by
  simp [rootSum]

private theorem rootSum_of_mul (i : I) (w : FreeMonoid I) :
    rootSum R (.of i * w) = R.root i + rootSum R w := by
  simp [rootSum]

private theorem rootSum_of (i : I) : rootSum R (.of i) = R.root i := by
  simp [rootSum]

private theorem rootSum_mul (w w' : FreeMonoid I) :
    rootSum R (w * w') = rootSum R w + rootSum R w' := by
  simp [rootSum]

/-- The derivation of the tensor algebra multiplying each word by the value at `x` of the sum of
the simple roots along it, as a linear function of `x ∈ H`. -/
private noncomputable def weightDerivation : H →ₗ[K] Module.End K K[FreeMonoid I] :=
  ((MonoidAlgebra.basis (FreeMonoid I) K).constr K).toLinearMap ∘ₗ
    LinearMap.pi fun w => (rootSum R w).smulRight (single w (1 : K))

private theorem weightDerivation_single (x : H) (w : FreeMonoid I) (c : K) :
    weightDerivation R x (single w c) = rootSum R w x • single w c := by
  have hc : single w c = c • MonoidAlgebra.basis (FreeMonoid I) K w := by
    rw [basis_apply, smul_single', mul_one]
  rw [hc, map_smul, weightDerivation, LinearMap.comp_apply, LinearEquiv.coe_coe,
    Module.Basis.constr_basis, LinearMap.pi_apply, LinearMap.smulRight_apply, basis_apply,
    smul_comm]

/-- The weight derivation is a derivation of the tensor algebra. -/
private theorem weightDerivation_mul (x : H) (y z : K[FreeMonoid I]) :
    weightDerivation R x (y * z) = weightDerivation R x y * z + y * weightDerivation R x z := by
  let b := MonoidAlgebra.basis (FreeMonoid I) K
  have key : (LinearMap.mul K K[FreeMonoid I]).compr₂ (weightDerivation R x) =
      (LinearMap.mul K K[FreeMonoid I]).compl₁₂ (weightDerivation R x) LinearMap.id +
        (LinearMap.mul K K[FreeMonoid I]).compl₁₂ LinearMap.id (weightDerivation R x) :=
    b.ext fun w => b.ext fun w' => by
      simp [b, weightDerivation_single, single_mul_single, rootSum_mul, add_smul]
  exact LinearMap.congr_fun₂ key y z

/-- The Cartan operators: `x ∈ H` acts on a word `w` by `(μ - α(w))(x)`, where `α(w)` is the sum
of the simple roots along `w`. -/
private noncomputable def cartanAction : H →ₗ[K] Module.End K K[FreeMonoid I] :=
  μ.smulRight 1 - weightDerivation R

private theorem cartanAction_single (x : H) (w : FreeMonoid I) (c : K) :
    cartanAction R μ x (single w c) = (μ x - rootSum R w x) • single w c := by
  simp [cartanAction, weightDerivation_single, sub_smul]

/-- The lowering operator: left multiplication by a letter. -/
private noncomputable def lowering (i : I) : Module.End K K[FreeMonoid I] :=
  Algebra.lmul K K[FreeMonoid I] (single (FreeMonoid.of i) 1)

private theorem lowering_apply (i : I) (y : K[FreeMonoid I]) :
    lowering i y = single (FreeMonoid.of i) 1 * y := rfl

private theorem lowering_single (i : I) (w : FreeMonoid I) (c : K) :
    lowering i (single w c) = single (FreeMonoid.of i * w) c := by
  rw [lowering_apply, single_mul_single, one_mul]

/-- `D_x fⱼ = fⱼ D_x + αⱼ(x) fⱼ` for the weight derivation `D_x`. -/
private theorem weightDerivation_lowering (x : H) (j : I) (y : K[FreeMonoid I]) :
    weightDerivation R x (lowering j y) =
      lowering j (weightDerivation R x y) + R.root j x • lowering j y := by
  rw [lowering_apply, lowering_apply, weightDerivation_mul, weightDerivation_single, rootSum_of,
    add_comm, smul_mul_assoc]

variable [DecidableEq I]

/-- The raising operator `eₖ` on words: `eₖ 1 = 0` and
`eₖ (j w) = j (eₖ w) + δⱼₖ (μ - α(w))(hₖ) w`. -/
private noncomputable def raisingWord (k : I) (w : FreeMonoid I) : K[FreeMonoid I] :=
  w.mulRecOn 0 fun j w r => single (FreeMonoid.of j) 1 * r +
    if j = k then (μ (R.coroot k) - rootSum R w (R.coroot k)) • single w 1 else 0

/-- The raising operator `eₖ`, extended linearly from words. -/
private noncomputable def raising (k : I) : Module.End K K[FreeMonoid I] :=
  (MonoidAlgebra.basis (FreeMonoid I) K).constr K (raisingWord R μ k)

private theorem raising_single_one (k : I) (w : FreeMonoid I) :
    raising R μ k (single w 1) = raisingWord R μ k w := by
  rw [raising, ← basis_apply, Module.Basis.constr_basis]

private theorem raisingWord_one (k : I) : raisingWord R μ k 1 = 0 := by
  simp [raisingWord]

private theorem raisingWord_of_mul (k j : I) (w : FreeMonoid I) :
    raisingWord R μ k (.of j * w) = single (FreeMonoid.of j) 1 * raisingWord R μ k w +
      if j = k then (μ (R.coroot k) - rootSum R w (R.coroot k)) • single w 1 else 0 := by
  simp [raisingWord]

/-- `eₖ fⱼ = fⱼ eₖ + δⱼₖ hₖ` on the tensor algebra. -/
private theorem raising_lowering (k j : I) (y : K[FreeMonoid I]) :
    raising R μ k (lowering j y) = lowering j (raising R μ k y) +
      if j = k then cartanAction R μ (R.coroot k) y else 0 := by
  let b := MonoidAlgebra.basis (FreeMonoid I) K
  have key : raising R μ k ∘ₗ lowering j = lowering j ∘ₗ raising R μ k +
      if j = k then cartanAction R μ (R.coroot k) else 0 :=
    b.ext fun w => by
      rw [LinearMap.comp_apply, LinearMap.add_apply, LinearMap.comp_apply, basis_apply,
        lowering_single, raising_single_one, raising_single_one, raisingWord_of_mul,
        lowering_apply]
      split_ifs <;> simp [cartanAction_single, sub_smul]
  have := LinearMap.congr_fun key y
  split_ifs at this ⊢ <;> simpa using this

/-- The raising operator lowers the weight by a simple root. -/
private theorem weightDerivation_raisingWord (x : H) (k : I) (w : FreeMonoid I) :
    weightDerivation R x (raisingWord R μ k w) =
      (rootSum R w x - R.root k x) • raisingWord R μ k w := by
  induction w using FreeMonoid.inductionOn' with
  | one => simp [raisingWord_one]
  | of_mul j w ih =>
    rw [raisingWord_of_mul, map_add, ← lowering_apply, weightDerivation_lowering, ih,
      rootSum_of_mul]
    split_ifs with hjk
    · subst hjk
      simp only [map_smul, weightDerivation_single, LinearMap.add_apply, smul_add, smul_smul,
        lowering_apply]
      module
    · simp only [map_zero, add_zero, map_smul, lowering_apply, LinearMap.add_apply]
      module

/-! ### The Chevalley relations on the tensor algebra -/

omit [DecidableEq I] in
private theorem lie_cartanAction_cartanAction (x y : H) :
    ⁅cartanAction R μ x, cartanAction R μ y⁆ = 0 := by
  refine (MonoidAlgebra.basis (FreeMonoid I) K).ext fun w => ?_
  simp only [basis_apply, Ring.lie_def, LinearMap.sub_apply, mul_apply_eq_comp,
    cartanAction_single, map_smul, smul_smul, mul_comm, sub_self, LinearMap.zero_apply]

private theorem lie_cartanAction_raising (x : H) (k : I) :
    ⁅cartanAction R μ x, raising R μ k⁆ = R.root k x • raising R μ k := by
  refine (MonoidAlgebra.basis (FreeMonoid I) K).ext fun w => ?_
  simp only [basis_apply, Ring.lie_def, LinearMap.sub_apply, mul_apply_eq_comp,
    LinearMap.smul_apply, cartanAction_single, map_smul, raising_single_one]
  simp only [cartanAction, LinearMap.sub_apply, LinearMap.smulRight_apply, LinearMap.smul_apply,
    one_apply_eq_self, weightDerivation_raisingWord]
  module

omit [DecidableEq I] in
private theorem lie_cartanAction_lowering (x : H) (j : I) :
    ⁅cartanAction R μ x, lowering j⁆ = -(R.root j x • lowering (K := K) j) := by
  refine (MonoidAlgebra.basis (FreeMonoid I) K).ext fun w => ?_
  simp only [basis_apply, Ring.lie_def, LinearMap.sub_apply, mul_apply_eq_comp,
    LinearMap.neg_apply, LinearMap.smul_apply, lowering_single, cartanAction_single,
    map_smul, rootSum_of_mul, LinearMap.add_apply]
  module

private theorem lie_raising_lowering_self (k : I) :
    ⁅raising R μ k, lowering k⁆ = cartanAction R μ (R.coroot k) := by
  refine LinearMap.ext fun y => ?_
  simp [Ring.lie_def, raising_lowering]

private theorem lie_raising_lowering_of_ne {k j : I} (h : k ≠ j) :
    ⁅raising R μ k, lowering (K := K) j⁆ = 0 := by
  refine LinearMap.ext fun y => ?_
  simp [Ring.lie_def, raising_lowering, Ne.symm h]

/-! ### The Serre relations on the tensor algebra -/

variable (hdiag : ∀ i, A i i = 2) (hneg : ∀ i j, i ≠ j → A i j ≤ 0)
  (hzero : ∀ i j, A i j = 0 → A j i = 0)

include hdiag hneg hzero in
/-- The raising Serre relations hold on the tensor algebra: a raising Serre element kills `1` and
commutes with the lowering operators, which generate the tensor algebra from `1`. -/
private theorem ad_pow_lie_raising_raising (i j : I) :
    (ad K _ (raising R μ i) ^ (-A i j).toNat) ⁅raising R μ i, raising R μ j⁆ = 0 := by
  have hcomm (k : I) := lie_ad_pow_lie_eq_zero hdiag hneg hzero (lie_cartanAction_raising R μ)
    (lie_cartanAction_lowering R μ) (lie_raising_lowering_self R μ)
    (fun _ _ h => lie_raising_lowering_of_ne R μ h) i j k
  have hone (n : ℕ) :
      ((ad K _ (raising R μ i) ^ n) ⁅raising R μ i, raising R μ j⁆) (single 1 1) = 0 := by
    induction n with
    | zero => simp [Ring.lie_def, raising_single_one, raisingWord_one]
    | succ n ih =>
      rw [pow_succ', mul_apply_eq_comp, ad_apply, Module.End.commutator_apply, ih]
      simp [raising_single_one, raisingWord_one]
  refine (MonoidAlgebra.basis (FreeMonoid I) K).ext fun w => ?_
  rw [basis_apply, LinearMap.zero_apply]
  induction w using FreeMonoid.inductionOn' with
  | one => exact hone _
  | of_mul k w ih =>
    have h := LinearMap.congr_fun (hcomm k) (single w 1)
    simpa [ih, lowering_single] using h

variable (K A) in
/-- The lowering Serre element `(ad i) ^ (-Aᵢⱼ) ⁅i, j⁆` of the tensor algebra. -/
private noncomputable def serreElement (i j : I) : K[FreeMonoid I] :=
  (ad K K[FreeMonoid I] (single (FreeMonoid.of i) 1) ^ (-A i j).toNat)
    ⁅single (FreeMonoid.of i) (1 : K), single (FreeMonoid.of j) 1⁆

omit [DecidableEq I] in
/-- The lowering Serre relators act on the tensor algebra by left multiplication by the lowering
Serre elements. -/
private theorem ad_pow_lie_lowering_lowering (i j : I) :
    (ad K _ (lowering (K := K) i) ^ (-A i j).toNat) ⁅lowering (K := K) i, lowering (K := K) j⁆ =
      Algebra.lmul K K[FreeMonoid I] (serreElement K A i j) := by
  simp only [lowering, serreElement, ← AlgHom.toLieHom_apply, ← LieHom.map_lie,
    LieHom.map_ad_pow]

variable (K A) in
/-- The two-sided ideal of the tensor algebra generated by the lowering Serre elements. -/
private noncomputable def serreIdeal : Submodule K K[FreeMonoid I] :=
  Submodule.span K {t | ∃ (a c : K[FreeMonoid I]) (i j : I), a * serreElement K A i j * c = t}

omit [DecidableEq I] in
private theorem mul_serreElement_mul_mem (a c : K[FreeMonoid I]) (i j : I) :
    a * serreElement K A i j * c ∈ serreIdeal K A :=
  Submodule.subset_span ⟨a, c, i, j, rfl⟩

omit [DecidableEq I] in
/-- A linear operator preserves the Serre ideal once it carries every spanning element
`a * serreElement K A i j * c` into it. -/
private theorem map_mem_serreIdeal (f : Module.End K K[FreeMonoid I])
    (hf : ∀ a c i j, f (a * serreElement K A i j * c) ∈ serreIdeal K A) {t : K[FreeMonoid I]}
    (ht : t ∈ serreIdeal K A) : f t ∈ serreIdeal K A :=
  (Submodule.span_le (p := (serreIdeal K A).comap f)).mpr
    (by rintro _ ⟨a, c, i, j, rfl⟩; exact hf a c i j) ht

omit [DecidableEq I] in
/-- The Serre ideal lies in the augmentation ideal, so it does not contain `1`. -/
private theorem one_notMem_serreIdeal : (1 : K[FreeMonoid I]) ∉ serreIdeal K A := by
  let ε := MonoidAlgebra.lift K K (FreeMonoid I) 1
  have hle : serreIdeal K A ≤ LinearMap.ker ε.toLinearMap := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨a, c, i, j, rfl⟩
    have hs : ε (serreElement K A i j) = 0 := by
      rw [serreElement, ← ad_pow_succ_apply, pow_succ', mul_apply_eq_comp, ad_apply,
        map_lie_eq_zero]
    simp [hs]
  intro h
  simpa [ε] using hle h

omit [DecidableEq I] in
private theorem lowering_mem_serreIdeal (k : I) {t : K[FreeMonoid I]} (ht : t ∈ serreIdeal K A) :
    lowering k t ∈ serreIdeal K A := by
  refine map_mem_serreIdeal _ (fun a c i j => ?_) ht
  rw [lowering_apply, ← mul_assoc, ← mul_assoc]
  exact mul_serreElement_mul_mem _ _ _ _

omit [DecidableEq I] in
private theorem weightDerivation_lie (x : H) (a b : K[FreeMonoid I]) :
    weightDerivation R x ⁅a, b⁆ = ⁅weightDerivation R x a, b⁆ + ⁅a, weightDerivation R x b⁆ := by
  simp only [Ring.lie_def, map_sub, weightDerivation_mul]
  abel

omit [DecidableEq I] in
/-- The lowering Serre elements are eigenvectors of the weight derivation. -/
private theorem exists_weightDerivation_serreElement (x : H) (i j : I) :
    ∃ c : K, weightDerivation R x (serreElement K A i j) = c • serreElement K A i j := by
  have ha : weightDerivation R x (single (FreeMonoid.of i) 1) =
      R.root i x • single (FreeMonoid.of i) 1 := by
    rw [weightDerivation_single, rootSum_of]
  have hb : weightDerivation R x ⁅single (FreeMonoid.of i) (1 : K), single (FreeMonoid.of j) 1⁆ =
      (R.root i x + R.root j x) •
        ⁅single (FreeMonoid.of i) (1 : K), single (FreeMonoid.of j) 1⁆ := by
    rw [weightDerivation_lie, ha, weightDerivation_single, rootSum_of, smul_lie, lie_smul,
      add_smul]
  suffices ∀ (n : ℕ) (b : K[FreeMonoid I]) (q : K), weightDerivation R x b = q • b →
      weightDerivation R x ((ad K _ (single (FreeMonoid.of i) 1) ^ n) b) =
        (n * R.root i x + q) • (ad K _ (single (FreeMonoid.of i) 1) ^ n) b from
    ⟨_, this _ _ _ hb⟩
  intro n b q hq
  induction n with
  | zero => simpa using hq
  | succ n ih =>
    rw [pow_succ', mul_apply_eq_comp, ad_apply, weightDerivation_lie, ha, ih, smul_lie, lie_smul,
      ← add_smul]
    congr 1
    push_cast
    ring

omit [DecidableEq I] in
private theorem cartanAction_mem_serreIdeal (x : H) {t : K[FreeMonoid I]}
    (ht : t ∈ serreIdeal K A) : cartanAction R μ x t ∈ serreIdeal K A := by
  have hD : weightDerivation R x t ∈ serreIdeal K A := by
    refine map_mem_serreIdeal _ (fun a c i j => ?_) ht
    obtain ⟨σ, hσ⟩ := exists_weightDerivation_serreElement R x i j
    rw [weightDerivation_mul, weightDerivation_mul, hσ, mul_smul_comm, add_mul, smul_mul_assoc]
    exact add_mem (add_mem (mul_serreElement_mul_mem _ _ _ _)
      (Submodule.smul_mem _ _ (mul_serreElement_mul_mem _ _ _ _)))
      (mul_serreElement_mul_mem _ _ _ _)
  simpa [cartanAction] using sub_mem (Submodule.smul_mem _ (μ x) ht) hD

include hdiag hneg hzero in
/-- The raising operators preserve the Serre ideal: a raising operator commutes with the lowering
Serre elements, and its commutator with a lowering operator is a Cartan operator. -/
private theorem raising_mem_serreIdeal (k : I) {t : K[FreeMonoid I]} (ht : t ∈ serreIdeal K A) :
    raising R μ k t ∈ serreIdeal K A := by
  have hcomm (i j : I) : ⁅raising R μ k, Algebra.lmul K K[FreeMonoid I] (serreElement K A i j)⁆ =
      0 := by
    rw [← ad_pow_lie_lowering_lowering]
    refine lie_ad_pow_lie_eq_zero (R := R) (φ := -cartanAction R μ) hdiag hneg hzero
      (fun x j => ?_) (fun x j => ?_) (fun i => ?_) (fun i j h => ?_) i j k
    · rw [LinearMap.neg_apply, neg_lie, lie_cartanAction_lowering, neg_neg]
    · rw [LinearMap.neg_apply, neg_lie, lie_cartanAction_raising]
    · rw [← lie_skew, lie_raising_lowering_self, LinearMap.neg_apply]
    · rw [← lie_skew, lie_raising_lowering_of_ne R μ (Ne.symm h), neg_zero]
  refine map_mem_serreIdeal _ (fun a c i j => ?_) ht
  induction a using MonoidAlgebra.induction_on with
  | of w =>
    rw [MonoidAlgebra.of_apply]
    induction w using FreeMonoid.inductionOn' with
    | one =>
      have h := LinearMap.congr_fun (hcomm i j) c
      rw [Module.End.commutator_apply, LinearMap.zero_apply, sub_eq_zero, Algebra.coe_lmul_eq_mul,
        LinearMap.mul_apply', LinearMap.mul_apply'] at h
      rw [← MonoidAlgebra.one_def, one_mul, h, ← one_mul (serreElement K A i j)]
      exact mul_serreElement_mul_mem _ _ _ _
    | of_mul j' w ih =>
      rw [← lowering_single, lowering_apply, mul_assoc, mul_assoc, ← lowering_apply,
        raising_lowering, ← mul_assoc]
      refine add_mem (lowering_mem_serreIdeal _ ih) ?_
      split_ifs
      · exact cartanAction_mem_serreIdeal R μ _ (mul_serreElement_mul_mem _ _ _ _)
      · exact zero_mem _
  | add a a' h h' =>
    rw [add_mul, add_mul, map_add]
    exact add_mem h h'
  | smul r a h =>
    rw [smul_mul_assoc, smul_mul_assoc, map_smul]
    exact Submodule.smul_mem _ r h

/-! ### The quotient module -/

/-- The Lie algebra of operators on the tensor algebra generated by the Cartan, raising and
lowering operators. -/
private noncomputable def operatorAlgebra : LieSubalgebra K (Module.End K K[FreeMonoid I]) :=
  LieSubalgebra.lieSpan K _
    (Set.range (cartanAction R μ) ∪ Set.range (raising R μ) ∪ Set.range lowering)

private theorem cartanAction_mem_operatorAlgebra (x : H) :
    cartanAction R μ x ∈ operatorAlgebra R μ :=
  LieSubalgebra.subset_lieSpan (Or.inl (Or.inl ⟨x, rfl⟩))

private theorem raising_mem_operatorAlgebra (k : I) : raising R μ k ∈ operatorAlgebra R μ :=
  LieSubalgebra.subset_lieSpan (Or.inl (Or.inr ⟨k, rfl⟩))

private theorem lowering_mem_operatorAlgebra (k : I) : lowering k ∈ operatorAlgebra R μ :=
  LieSubalgebra.subset_lieSpan (Or.inr ⟨k, rfl⟩)

include hdiag hneg hzero in
private theorem apply_mem_serreIdeal {X : Module.End K K[FreeMonoid I]}
    (hX : X ∈ operatorAlgebra R μ) : ∀ t ∈ serreIdeal K A, X t ∈ serreIdeal K A := by
  induction hX using LieSubalgebra.lieSpan_induction with
  | mem X hX =>
    rcases hX with (⟨x, rfl⟩ | ⟨k, rfl⟩) | ⟨k, rfl⟩
    · exact fun t => cartanAction_mem_serreIdeal R μ x
    · exact fun t => raising_mem_serreIdeal R μ hdiag hneg hzero k
    · exact fun t => lowering_mem_serreIdeal k
  | zero => simp
  | add X Y _ _ hX hY => exact fun t ht => add_mem (hX t ht) (hY t ht)
  | smul c X _ hX => exact fun t ht => Submodule.smul_mem _ c (hX t ht)
  | lie X Y _ _ hX hY =>
    exact fun t ht => sub_mem (hX _ (hY t ht)) (hY _ (hX t ht))

/-- The Serre ideal, as a submodule of the tensor algebra for the operator Lie algebra. -/
private noncomputable def serreSubmodule :
    LieSubmodule K (operatorAlgebra R μ) K[FreeMonoid I] where
  toSubmodule := serreIdeal K A
  lie_mem {X t} ht := apply_mem_serreIdeal R μ hdiag hneg hzero X.property t ht

/-- The quotient of the tensor algebra by the Serre ideal, on which the operators act. -/
private abbrev SerreQuotient := K[FreeMonoid I] ⧸ serreSubmodule R μ hdiag hneg hzero

/-- The action of an operator on the quotient by the Serre ideal. -/
private noncomputable def quotientAction :
    operatorAlgebra R μ →ₗ⁅K⁆ Module.End K (SerreQuotient R μ hdiag hneg hzero) :=
  LieModule.toEnd K _ _

private theorem quotientAction_mk (X : operatorAlgebra R μ) (t : K[FreeMonoid I]) :
    quotientAction R μ hdiag hneg hzero X (LieSubmodule.Quotient.mk' _ t) =
      LieSubmodule.Quotient.mk' _ ((X : Module.End K K[FreeMonoid I]) t) := by
  rw [quotientAction, LieModule.toEnd_apply_apply, ← LieModuleHom.map_lie,
    LieSubalgebra.coe_bracket_of_module, Module.End.lie_apply]

/-- An operator carrying the tensor algebra into the Serre ideal acts by zero on the quotient. -/
private theorem quotientAction_eq_zero {X : operatorAlgebra R μ}
    (hX : ∀ t, (X : Module.End K K[FreeMonoid I]) t ∈ serreIdeal K A) :
    quotientAction R μ hdiag hneg hzero X = 0 := by
  ext m
  obtain ⟨t, rfl⟩ := LieSubmodule.Quotient.surjective_mk' _ m
  rw [quotientAction_mk, LinearMap.zero_apply, LieSubmodule.Quotient.mk_eq_zero]
  exact hX t

/-- The Cartan operators on the quotient. -/
private noncomputable def quotientCartan :
    H →ₗ[K] Module.End K (SerreQuotient R μ hdiag hneg hzero) where
  toFun x := quotientAction R μ hdiag hneg hzero ⟨_, cartanAction_mem_operatorAlgebra R μ x⟩
  map_add' x y := by
    rw [← map_add]
    exact congrArg _ (Subtype.ext (map_add _ x y))
  map_smul' c x := by
    rw [RingHom.id_apply, ← map_smul]
    exact congrArg _ (Subtype.ext (map_smul _ c x))

private theorem quotientCartan_apply (x : H) :
    quotientCartan R μ hdiag hneg hzero x =
      quotientAction R μ hdiag hneg hzero ⟨_, cartanAction_mem_operatorAlgebra R μ x⟩ :=
  rfl

/-- The raising operators on the quotient. -/
private noncomputable def quotientRaising (k : I) :
    Module.End K (SerreQuotient R μ hdiag hneg hzero) :=
  quotientAction R μ hdiag hneg hzero ⟨_, raising_mem_operatorAlgebra R μ k⟩

/-- The lowering operators on the quotient. -/
private noncomputable def quotientLowering (k : I) :
    Module.End K (SerreQuotient R μ hdiag hneg hzero) :=
  quotientAction R μ hdiag hneg hzero ⟨_, lowering_mem_operatorAlgebra R μ k⟩

/-- The operators on the quotient satisfy all the relations of the Kac–Moody algebra. -/
private theorem satisfiesRelations_quotient :
    SatisfiesRelations R (quotientCartan R μ hdiag hneg hzero)
      (quotientRaising R μ hdiag hneg hzero) (quotientLowering R μ hdiag hneg hzero) where
  lie_cartan_cartan x y := by
    rw [quotientCartan_apply, quotientCartan_apply, ← LieHom.map_lie,
      ← map_zero (quotientAction R μ hdiag hneg hzero)]
    exact congrArg _ (Subtype.ext (lie_cartanAction_cartanAction R μ x y))
  lie_cartan_positive x j := by
    rw [quotientCartan_apply, quotientRaising, ← LieHom.map_lie,
      ← map_smul]
    exact congrArg _ (Subtype.ext (lie_cartanAction_raising R μ x j))
  lie_cartan_negative x j := by
    rw [quotientCartan_apply, quotientLowering, ← LieHom.map_lie,
      ← map_smul, ← map_neg]
    exact congrArg _ (Subtype.ext (lie_cartanAction_lowering R μ x j))
  lie_positive_negative_self i := by
    rw [quotientCartan_apply, quotientRaising, quotientLowering,
      ← LieHom.map_lie]
    exact congrArg _ (Subtype.ext (lie_raising_lowering_self R μ i))
  lie_positive_negative_of_ne i j hij := by
    rw [quotientRaising, quotientLowering, ← LieHom.map_lie,
      ← map_zero (quotientAction R μ hdiag hneg hzero)]
    exact congrArg _ (Subtype.ext (lie_raising_lowering_of_ne R μ hij))
  serre_positive i j := by
    rw [quotientRaising, quotientRaising, ← LieHom.map_lie, ← LieHom.map_ad_pow,
      ← map_zero (quotientAction R μ hdiag hneg hzero)]
    refine congrArg _ (Subtype.ext ?_)
    rw [LieSubalgebra.coe_ad_pow]
    exact ad_pow_lie_raising_raising R μ hdiag hneg hzero i j
  serre_negative i j := by
    have h (X Y : operatorAlgebra R μ) (n : ℕ) :
        (ad K _ (quotientAction R μ hdiag hneg hzero X) ^ n)
            ⁅quotientAction R μ hdiag hneg hzero X, quotientAction R μ hdiag hneg hzero Y⁆ =
          quotientAction R μ hdiag hneg hzero ((ad K _ X ^ n) ⁅X, Y⁆) := by
      rw [← LieHom.map_lie, ← LieHom.map_ad_pow]
    simp only [quotientLowering]
    rw [h]
    refine quotientAction_eq_zero R μ hdiag hneg hzero fun t => ?_
    rw [LieSubalgebra.coe_ad_pow, LieSubalgebra.coe_bracket, ad_pow_lie_lowering_lowering,
      Algebra.coe_lmul_eq_mul, LinearMap.mul_apply', ← one_mul (serreElement K A i j)]
    exact mul_serreElement_mul_mem _ _ _ _

private theorem quotientCartan_mk_one (x : H) :
    quotientCartan R μ hdiag hneg hzero x (LieSubmodule.Quotient.mk' _ 1) =
      μ x • LieSubmodule.Quotient.mk' (serreSubmodule R μ hdiag hneg hzero) 1 := by
  rw [quotientCartan_apply, quotientAction_mk, MonoidAlgebra.one_def,
    cartanAction_single, rootSum_one, LinearMap.zero_apply, sub_zero, map_smul]

end TensorAlgebra

/-- **Cartan injectivity.** For a generalized Cartan matrix `A`, that is `Aᵢᵢ = 2`, `Aᵢⱼ ≤ 0`
for `i ≠ j` and `Aᵢⱼ = 0 → Aⱼᵢ = 0`, the map from a realization `H` of `A` into the Lie algebra
presented by the Chevalley and Serre relations is injective. -/
theorem cartanElement_injective (hdiag : ∀ i, A i i = 2) (hneg : ∀ i j, i ≠ j → A i j ≤ 0)
    (hzero : ∀ i j, A i j = 0 → A j i = 0) : Function.Injective (cartanElement R) := by
  classical
  refine (injective_iff_map_eq_zero _).mpr fun x hx =>
    (Module.forall_dual_apply_eq_zero_iff K x).mp fun μ => ?_
  have h := LinearMap.congr_fun
    (congrArg (lift (satisfiesRelations_quotient R μ hdiag hneg hzero)) hx)
    (LieSubmodule.Quotient.mk' (serreSubmodule R μ hdiag hneg hzero) 1)
  rw [lift_cartanElement, map_zero, LinearMap.zero_apply, quotientCartan_mk_one] at h
  refine (smul_eq_zero.mp h).resolve_right fun h1 => one_notMem_serreIdeal (K := K) (A := A) ?_
  exact (LieSubmodule.Quotient.mk_eq_zero _).mp h1

end KacMoody

end TauCeti
