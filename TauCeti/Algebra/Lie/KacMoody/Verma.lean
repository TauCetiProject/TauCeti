module

public import TauCeti.Algebra.Lie.KacMoody.CartanInjective
public import TauCeti.Algebra.Lie.KacMoody.HighestWeight
public import TauCeti.Algebra.Lie.UniversalEnveloping.Cyclic

/-!
# Verma modules of a Kac–Moody algebra

Let `R` be a realization of an integer matrix `A` over a field `K`, with Cartan space `H`, and let
`𝔤 = TauCeti.KacMoody.PresentedLieAlgebra R` be the Lie algebra it presents, with Cartan elements
`h ∈ H`, raising generators `eᵢ` and lowering generators `fᵢ`. For a functional `λ` on `H`, the
**Verma module** `M(λ)` is the universal `𝔤`-module generated by a vector `v_λ` of weight `λ`
killed by every `eᵢ`. It is the quotient of the universal enveloping algebra `U(𝔤)` by the left
ideal `TauCeti.KacMoody.vermaIdeal R λ` generated by the elements `ι(h) - λ(h)` for `h ∈ H` and
`ι(eᵢ)`, and `v_λ` is the class of `1`: the cyclic module
`TauCeti.UniversalEnvelopingAlgebra.CyclicModule` of this left ideal, read as a `𝔤`-module through
`TauCeti.UniversalEnvelopingAlgebra.asLieRingModule`. Its projection, its generation by `v_λ` and
the criterion `v_λ = 0 ↔ vermaIdeal R λ = ⊤` are those of the cyclic module.

The construction and its API (relations, left ideal, generator, universal property and
nonvanishing criterion) are adapted from the finite-type `TauCeti.VermaModule` of
`TauCeti.Algebra.Lie.HighestWeight.Verma`, from which the cyclic-module API was extracted.

The universal property `TauCeti.KacMoody.existsUnique_lieModuleHom_apply_vermaGenerator` does not
presuppose that `M(λ)` is nonzero: for any vector `v`, zero allowed, of weight `λ` and killed by
every `eᵢ` in a `𝔤`-module `N`, there is a unique homomorphism `M(λ) → N` sending `v_λ` to `v`.
Applied to the nonzero vector of weight `λ` in Kac's representation on the tensor algebra
(`TauCeti.KacMoody.exists_highestWeightVector`), it shows that `v_λ ≠ 0` whenever `A` is a
generalized Cartan matrix, so that the left ideal is proper. No symmetrizability, no finiteness of
the index set and no Poincaré–Birkhoff–Witt theorem is used for this.

Since `v_λ` generates `M(λ)`, the results of `TauCeti.Algebra.Lie.KacMoody.HighestWeight` describe
its weights: `M(λ)` is spanned by the vectors `f_(j₁) ⋯ f_(jₛ) · v_λ`, it is the sum of its weight
spaces, its weights lie below `λ`, and over a field of characteristic zero its weight spaces are
finite-dimensional and the weight space of `λ` is spanned by `v_λ`, so that it is a line when `A` is
a generalized Cartan matrix.

## Main definitions

* `TauCeti.KacMoody.vermaRelations R λ` and `TauCeti.KacMoody.vermaIdeal R λ`: the defining
  relations of weight `λ` and the left ideal of `U(𝔤)` they generate.
* `TauCeti.KacMoody.VermaModule R λ`: the Verma module `M(λ)`, the cyclic module of the Verma
  ideal.
* `TauCeti.KacMoody.vermaGenerator R λ`: the canonical generator `v_λ`, the class of `1`.

## Main results

* `TauCeti.KacMoody.vermaGenerator_mem_weightSpace` and
  `TauCeti.KacMoody.lie_positiveGenerator_vermaGenerator`: `v_λ` has weight `λ` and every `eᵢ`
  kills it.
* `TauCeti.KacMoody.existsUnique_lieModuleHom_apply_vermaGenerator`: the universal property.
* `TauCeti.KacMoody.exists_surjective_lieModuleHom_vermaModule`: every module generated by a
  vector of weight `λ` killed by every `eᵢ` is a quotient of `M(λ)`.
* `TauCeti.KacMoody.vermaGenerator_ne_zero` and `TauCeti.KacMoody.vermaIdeal_ne_top`: for a
  generalized Cartan matrix, `v_λ ≠ 0` and the left ideal is proper.
* `TauCeti.KacMoody.span_range_negativeWord_vermaGenerator_eq_top`,
  `TauCeti.KacMoody.weightSpace_vermaModule_self_eq_span_singleton` and
  `TauCeti.KacMoody.finrank_weightSpace_vermaModule_self`: the lowering words span `M(λ)`, and in
  characteristic zero its weight space of `λ` is spanned by `v_λ`, and is one-dimensional for a
  generalized Cartan matrix.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, §9.2.
-/

public section

open LieAlgebra LieModule UniversalEnvelopingAlgebra

namespace TauCeti

namespace KacMoody

open TauCeti.UniversalEnvelopingAlgebra

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H) (lam : Module.Dual K H)

local notation "U" => _root_.UniversalEnvelopingAlgebra K (PresentedLieAlgebra R)

/-! ## The defining left ideal -/

/-- The **Verma relations** of weight `lam`: the elements `ι(h) - lam(h)` of `U(𝔤)` for `h ∈ H`,
together with the images `ι(eᵢ)` of the raising generators. -/
noncomputable def vermaRelations : Set U :=
  Set.range (fun x : H => (ι K (cartanElement R x) : U) - algebraMap K U (lam x)) ∪
    Set.range (fun i : I => (ι K (positiveGenerator R i) : U))

/-- The **Verma ideal** of weight `lam`: the left ideal of `U(𝔤)` generated by the Verma
relations. -/
noncomputable def vermaIdeal : Submodule U U :=
  Submodule.span U (vermaRelations R lam)

theorem vermaIdeal_def : vermaIdeal R lam = Submodule.span U (vermaRelations R lam) :=
  (rfl)

theorem ι_cartanElement_sub_algebraMap_mem_vermaIdeal (x : H) :
    (ι K (cartanElement R x) : U) - algebraMap K U (lam x) ∈ vermaIdeal R lam :=
  Submodule.subset_span (Or.inl ⟨x, rfl⟩)

theorem ι_positiveGenerator_mem_vermaIdeal (i : I) :
    (ι K (positiveGenerator R i) : U) ∈ vermaIdeal R lam :=
  Submodule.subset_span (Or.inr ⟨i, rfl⟩)

/-! ## The Verma module -/

/-- **The Verma module** `M(lam)`: the cyclic module `U(𝔤) ⧸ vermaIdeal R lam`, so that the
projection, generator, universal property and nonvanishing criterion of
`TauCeti.UniversalEnvelopingAlgebra.CyclicModule` apply to it. -/
abbrev VermaModule : Type _ :=
  CyclicModule (vermaIdeal R lam)

/-- **The canonical generator** `v_lam` of the Verma module, the class of `1`. -/
noncomputable abbrev vermaGenerator : VermaModule R lam :=
  cyclicGenerator (vermaIdeal R lam)

/-- Every Cartan element `h` acts on the canonical generator by `lam(h)`. -/
@[simp]
theorem lie_cartanElement_vermaGenerator (x : H) :
    ⁅cartanElement R x, vermaGenerator R lam⁆ = lam x • vermaGenerator R lam :=
  lie_cyclicGenerator_eq_smul_of_sub_mem _ (ι_cartanElement_sub_algebraMap_mem_vermaIdeal R lam x)

/-- The canonical generator has weight `lam`. -/
theorem vermaGenerator_mem_weightSpace :
    vermaGenerator R lam ∈ weightSpace R (VermaModule R lam) lam :=
  mem_weightSpace_iff.mpr (lie_cartanElement_vermaGenerator R lam)

/-- Every raising generator kills the canonical generator. -/
@[simp]
theorem lie_positiveGenerator_vermaGenerator (i : I) :
    ⁅positiveGenerator R i, vermaGenerator R lam⁆ = 0 :=
  lie_cyclicGenerator_eq_zero_of_mem _ (ι_positiveGenerator_mem_vermaIdeal R lam i)

/-! ## The universal property -/

section UniversalProperty

variable {N : Type*} [AddCommGroup N] [Module K N] [LieRingModule (PresentedLieAlgebra R) N]
  [LieModule K (PresentedLieAlgebra R) N]

/-- A vector of weight `lam` killed by every raising generator is annihilated by the Verma
ideal. -/
private theorem representation_eq_zero_of_mem_vermaIdeal {v : N}
    (hv : v ∈ weightSpace R N lam) (hpos : ∀ i, ⁅positiveGenerator R i, v⁆ = 0) {u : U}
    (hu : u ∈ vermaIdeal R lam) : representation K (PresentedLieAlgebra R) N u v = 0 := by
  refine representation_eq_zero_of_mem_span (fun u hu => ?_) hu
  rcases hu with ⟨x, rfl⟩ | ⟨i, rfl⟩
  · exact representation_ι_sub_algebraMap_apply_eq_zero (mem_weightSpace_iff.mp hv x)
  · rw [representation_ι_apply, hpos]

/-- **The universal property of the Verma module.** If `v` is a vector of weight `lam` killed by
every raising generator in a `𝔤`-module `N`, then there is a unique homomorphism of `𝔤`-modules
`M(lam) → N` sending the canonical generator to `v`. The vector `v` may be zero. -/
theorem existsUnique_lieModuleHom_apply_vermaGenerator {v : N} (hv : v ∈ weightSpace R N lam)
    (hpos : ∀ i, ⁅positiveGenerator R i, v⁆ = 0) :
    ∃! φ : VermaModule R lam →ₗ⁅K, PresentedLieAlgebra R⁆ N, φ (vermaGenerator R lam) = v :=
  existsUnique_lieModuleHom_apply_cyclicGenerator _ fun _ hu =>
    representation_eq_zero_of_mem_vermaIdeal R lam hv hpos hu

/-- **Every highest-weight module of weight `lam` is a quotient of the Verma module**: if `v` has
weight `lam`, is killed by every raising generator and generates `N`, then a surjective
homomorphism `M(lam) → N` sends the canonical generator to `v`. -/
theorem exists_surjective_lieModuleHom_vermaModule {v : N} (hv : v ∈ weightSpace R N lam)
    (hpos : ∀ i, ⁅positiveGenerator R i, v⁆ = 0)
    (hgen : LieSubmodule.lieSpan K (PresentedLieAlgebra R) {v} = ⊤) :
    ∃ φ : VermaModule R lam →ₗ⁅K, PresentedLieAlgebra R⁆ N,
      Function.Surjective φ ∧ φ (vermaGenerator R lam) = v :=
  exists_surjective_lieModuleHom_cyclicModule _
    (fun _ hu => representation_eq_zero_of_mem_vermaIdeal R lam hv hpos hu) hgen

end UniversalProperty

/-! ## Nonvanishing -/

section GeneralizedCartanMatrix

variable {R} (hdiag : ∀ i, A i i = 2) (hneg : ∀ i j, i ≠ j → A i j ≤ 0)
  (hzero : ∀ i j, A i j = 0 → A j i = 0)
include hdiag hneg hzero

/-- **The Verma module is nonzero.** For a generalized Cartan matrix, the canonical generator of
`M(lam)` is nonzero for every weight `lam`. -/
theorem vermaGenerator_ne_zero : vermaGenerator R lam ≠ 0 := by
  obtain ⟨V, _, _, _, _, w, hw, hcartan, hpos⟩ := exists_highestWeightVector hdiag hneg hzero lam
  obtain ⟨φ, hφ, -⟩ := existsUnique_lieModuleHom_apply_vermaGenerator R lam
    (mem_weightSpace_iff.mpr hcartan) hpos
  intro h
  rw [h, map_zero] at hφ
  exact hw hφ.symm

/-- For a generalized Cartan matrix, the Verma ideal is a proper left ideal of `U(𝔤)`. -/
theorem vermaIdeal_ne_top : vermaIdeal R lam ≠ ⊤ :=
  (cyclicGenerator_eq_zero_iff _).not.mp (vermaGenerator_ne_zero lam hdiag hneg hzero)

/-- For a generalized Cartan matrix, every Verma module is nontrivial. -/
theorem nontrivial_vermaModule : Nontrivial (VermaModule R lam) :=
  ⟨⟨vermaGenerator R lam, 0, vermaGenerator_ne_zero lam hdiag hneg hzero⟩⟩

end GeneralizedCartanMatrix

/-! ## Weights -/

/-- The lowering words `f_(j₁) ⋯ f_(jₛ) · v_lam` span the Verma module. -/
theorem span_range_negativeWord_vermaGenerator_eq_top :
    Submodule.span K (Set.range (negativeWord R (vermaGenerator R lam))) = ⊤ :=
  span_range_negativeWord_eq_top (vermaGenerator_mem_weightSpace R lam)
    (lie_positiveGenerator_vermaGenerator R lam) (lieSpan_cyclicGenerator_eq_top _)

/-- Every weight `μ` of the Verma module `M(lam)` satisfies `μ ≤ lam`. -/
theorem rootLE_of_weightSpace_vermaModule_ne_bot {μ : Module.Dual K H}
    (h : weightSpace R (VermaModule R lam) μ ≠ ⊥) : R.RootLE μ lam :=
  rootLE_of_weightSpace_ne_bot (vermaGenerator_mem_weightSpace R lam)
    (lie_positiveGenerator_vermaGenerator R lam) (lieSpan_cyclicGenerator_eq_top _) h

variable [CharZero K]

/-- Over a field of characteristic zero, the weight space of `lam` in `M(lam)` is spanned by the
canonical generator. It is one-dimensional for a generalized Cartan matrix
(`TauCeti.KacMoody.finrank_weightSpace_vermaModule_self`). -/
theorem weightSpace_vermaModule_self_eq_span_singleton :
    weightSpace R (VermaModule R lam) lam = K ∙ vermaGenerator R lam :=
  weightSpace_self_eq_span_singleton (vermaGenerator_mem_weightSpace R lam)
    (lie_positiveGenerator_vermaGenerator R lam) (lieSpan_cyclicGenerator_eq_top _)

/-- Over a field of characteristic zero, every weight space of a Verma module is
finite-dimensional. -/
instance (μ : Module.Dual K H) : FiniteDimensional K (weightSpace R (VermaModule R lam) μ) :=
  finiteDimensional_weightSpace (vermaGenerator_mem_weightSpace R lam)
    (lie_positiveGenerator_vermaGenerator R lam) (lieSpan_cyclicGenerator_eq_top _) μ

/-- For a generalized Cartan matrix over a field of characteristic zero, the weight space of `lam`
in `M(lam)` is one-dimensional. -/
theorem finrank_weightSpace_vermaModule_self (hdiag : ∀ i, A i i = 2)
    (hneg : ∀ i j, i ≠ j → A i j ≤ 0) (hzero : ∀ i j, A i j = 0 → A j i = 0) :
    Module.finrank K (weightSpace R (VermaModule R lam) lam) = 1 := by
  rw [weightSpace_vermaModule_self_eq_span_singleton, finrank_span_singleton]
  exact vermaGenerator_ne_zero lam hdiag hneg hzero

end KacMoody

end TauCeti
