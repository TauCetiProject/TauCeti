/-!
# Weight spaces and highest-weight modules of a Kac–Moody algebra

Let `R` be a realization of an integer matrix `A` over a field `K`, with simple roots `αᵢ` in the
dual of the Cartan space `H`, and let `𝔤 = TauCeti.KacMoody.PresentedLieAlgebra R` be the Lie
algebra it presents, with Cartan elements `h ∈ H`, raising generators `eᵢ` and lowering generators
`fᵢ`. For a `𝔤`-module `M` and a functional `μ` on `H`, the **weight space**
`TauCeti.KacMoody.weightSpace R M μ` is the joint eigenspace `M_μ = {m | h · m = μ(h) m for all h}`.
Weight spaces of distinct weights are independent, `eᵢ` maps `M_μ` into `M_(μ + αᵢ)` and `fᵢ` maps
it into `M_(μ - αᵢ)`. For the adjoint module they are the root spaces, and since `𝔤` is the sum of
its root spaces, the sum of the weight spaces of any module is a submodule: a module generated by a
weight vector is the sum of its weight spaces.

A vector `v` of weight `λ` killed by every `eᵢ` is what Kac calls a highest-weight vector.
Applying lowering generators along a word `w = j₁ ⋯ jₛ` gives the vector
`TauCeti.KacMoody.negativeWord R v w = f_(j₁) ⋯ f_(jₛ) · v` of weight `λ - (αⱼ₁ + ⋯ + αⱼₛ)`.
These vectors span the submodule generated by `v`: their span contains `v`, is stable under `H`
and the `fⱼ`, and is stable under the `eᵢ` by the relation `eᵢ fⱼ = fⱼ eᵢ + δᵢⱼ hᵢ`; since `H`,
the `eᵢ` and the `fᵢ` generate `𝔤`, it is a submodule.

So when `v` generates `M`, every weight space is spanned by the vectors of the words whose roots
sum to `λ - μ` (`TauCeti.KacMoody.weightSpace_eq_span_negativeWord`). Consequently every weight
`μ` of `M` satisfies `μ ≤ λ` in the dominance order, and over a field of characteristic zero the
weight space `M_λ` is spanned by `v` and every weight space is finite-dimensional, since
only finitely many words have roots summing to a given element. These are the properties that put
the highest-weight modules of `𝔤`, the Verma modules and their quotients, into category `O`. No
symmetrizability and no finiteness of the index set is assumed.

## Main definitions

* `TauCeti.KacMoody.weightSpace R M μ`: the weight space of weight `μ` of a `𝔤`-module `M`.
* `TauCeti.KacMoody.negativeWord R v w`: the lowering generators applied to `v` along a word `w`.

## Main results

* `TauCeti.KacMoody.iSupIndep_weightSpace`: weight spaces of distinct weights are independent.
* `TauCeti.KacMoody.lie_mem_weightSpace_of_mem_rootSpace`: a root vector of root `α` shifts
  weights by `α`; in particular `eᵢ` and `fᵢ` shift them by `±αᵢ`.
* `TauCeti.KacMoody.iSup_weightSpace_eq_top`: a module generated by a weight vector is the sum of
  its weight spaces.
* `TauCeti.KacMoody.span_range_negativeWord_eq_lieSpan`: the lowering words applied to a
  highest-weight vector span the submodule it generates.
* `TauCeti.KacMoody.weightSpace_eq_span_negativeWord`: the weight spaces of a module generated by a
  highest-weight vector.
* `TauCeti.KacMoody.rootLE_of_weightSpace_ne_bot`,
  `TauCeti.KacMoody.weightSpace_self_eq_span_singleton` and
  `TauCeti.KacMoody.finiteDimensional_weightSpace`: the weights of such a module lie below the
  highest weight, and in characteristic zero the highest weight space is spanned by the
  highest-weight vector and every weight space is finite-dimensional.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, §§9.1–9.2.
-/

public section

open LieAlgebra LieModule

namespace TauCeti

namespace KacMoody

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)
  (M : Type*) [AddCommGroup M] [Module K M] [LieRingModule (PresentedLieAlgebra R) M]
  [LieModule K (PresentedLieAlgebra R) M]

/-! ## Weight spaces -/

/-- The **weight space** `M_μ` of a module `M` over the Kac–Moody algebra: the vectors on which
every Cartan element `h ∈ H` acts by the scalar `μ(h)`. Unlike Mathlib's `LieModule.weightSpace`,
whose weights are functions on the whole Lie algebra, the weights here are functionals on the
realization `H`, the space in which the simple roots live. -/
noncomputable def weightSpace (μ : Module.Dual K H) : Submodule K M :=
  ⨅ x : H, (toEnd K (PresentedLieAlgebra R) M (cartanElement R x)).eigenspace (μ x)

theorem weightSpace_def (μ : Module.Dual K H) :
    weightSpace R M μ =
      ⨅ x : H, (toEnd K (PresentedLieAlgebra R) M (cartanElement R x)).eigenspace (μ x) :=
  (rfl)

variable {R M}

theorem mem_weightSpace_iff {μ : Module.Dual K H} {m : M} :
    m ∈ weightSpace R M μ ↔ ∀ x : H, ⁅cartanElement R x, m⁆ = μ x • m := by
  simp [weightSpace]

variable (R M) in
/-- Weight spaces of distinct weights are supremum-independent. -/
theorem iSupIndep_weightSpace : iSupIndep (weightSpace R M) :=
  (iSupIndep_iInf_eigenspace fun x : H =>
    toEnd K (PresentedLieAlgebra R) M (cartanElement R x)).comp DFunLike.coe_injective

variable (R) in
/-- The weight spaces of the adjoint module are the root spaces. -/
theorem weightSpace_eq_rootSpace (α : Module.Dual K H) :
    weightSpace R (PresentedLieAlgebra R) α = rootSpace R α := by
  ext x
  rw [mem_weightSpace_iff, mem_rootSpace_iff]

/-- A root vector of root `α` maps the weight space of `μ` into that of `α + μ`. -/
theorem lie_mem_weightSpace_of_mem_rootSpace {α μ : Module.Dual K H} {x : PresentedLieAlgebra R}
    {m : M} (hx : x ∈ rootSpace R α) (hm : m ∈ weightSpace R M μ) :
    ⁅x, m⁆ ∈ weightSpace R M (α + μ) := by
  rw [mem_weightSpace_iff] at hm ⊢
  intro y
  rw [leibniz_lie, (mem_rootSpace_iff R).mp hx y, hm, smul_lie, lie_smul, LinearMap.add_apply,
    add_smul]

/-- The raising generator `eᵢ` maps the weight space of `μ` into that of `μ + αᵢ`. -/
theorem lie_positiveGenerator_mem_weightSpace {μ : Module.Dual K H} {m : M}
    (hm : m ∈ weightSpace R M μ) (i : I) :
    ⁅positiveGenerator R i, m⁆ ∈ weightSpace R M (μ + R.root i) := by
  rw [add_comm]
  exact lie_mem_weightSpace_of_mem_rootSpace (positiveGenerator_mem_rootSpace R i) hm

/-- The lowering generator `fᵢ` maps the weight space of `μ` into that of `μ - αᵢ`. -/
theorem lie_negativeGenerator_mem_weightSpace {μ : Module.Dual K H} {m : M}
    (hm : m ∈ weightSpace R M μ) (i : I) :
    ⁅negativeGenerator R i, m⁆ ∈ weightSpace R M (μ - R.root i) := by
  rw [← neg_add_eq_sub]
  exact lie_mem_weightSpace_of_mem_rootSpace (negativeGenerator_mem_rootSpace R i) hm

/-- The sum of the weight spaces of a `𝔤`-module is stable under `𝔤`, since `𝔤` is the sum of its
root spaces. -/
theorem lie_mem_iSup_weightSpace (x : PresentedLieAlgebra R) {m : M}
    (hm : m ∈ ⨆ μ, weightSpace R M μ) : ⁅x, m⁆ ∈ ⨆ μ, weightSpace R M μ := by
  have hx : x ∈ ⨆ α, rootSpace R α := by
    rw [iSup_rootSpace_eq_top]
    exact Submodule.mem_top
  induction hx using Submodule.iSup_induction' with
  | mem α x hx =>
    induction hm using Submodule.iSup_induction' with
    | mem μ m hm =>
      exact Submodule.mem_iSup_of_mem (α + μ) (lie_mem_weightSpace_of_mem_rootSpace hx hm)
    | zero => rw [lie_zero]; exact zero_mem _
    | add m₁ m₂ _ _ h₁ h₂ => rw [lie_add]; exact add_mem h₁ h₂
  | zero => rw [zero_lie]; exact zero_mem _
  | add x₁ x₂ _ _ h₁ h₂ => rw [add_lie]; exact add_mem h₁ h₂

/-- A module generated by a weight vector is the sum of its weight spaces. -/
theorem iSup_weightSpace_eq_top {lam : Module.Dual K H} {v : M} (hv : v ∈ weightSpace R M lam)
    (hgen : LieSubmodule.lieSpan K (PresentedLieAlgebra R) {v} = ⊤) :
    ⨆ μ, weightSpace R M μ = ⊤ := by
  have hle := LieSubmodule.lieSpan_toSubmodule_le_of_lie_mem
    (Set.singleton_subset_iff.mpr (Submodule.mem_iSup_of_mem lam hv))
    fun x _ hm => lie_mem_iSup_weightSpace x hm
  rwa [hgen, LieSubmodule.top_toSubmodule, top_le_iff] at hle

/-! ## Lowering words -/

variable (R) in
/-- The lowering generators applied to `m` along a word `w = [j₁, …, jₛ]`:
`f_(j₁) · (f_(j₂) · (⋯ (f_(jₛ) · m)))`. -/
noncomputable def negativeWord (m : M) (w : List I) : M :=
  w.foldr (fun j n => ⁅negativeGenerator R j, n⁆) m

omit [Module K M] [LieModule K (PresentedLieAlgebra R) M] in
@[simp]
theorem negativeWord_nil (m : M) : negativeWord R m [] = m :=
  (rfl)

omit [Module K M] [LieModule K (PresentedLieAlgebra R) M] in
@[simp]
theorem negativeWord_cons (m : M) (j : I) (w : List I) :
    negativeWord R m (j :: w) = ⁅negativeGenerator R j, negativeWord R m w⁆ :=
  (rfl)

/-- Lowering a vector of weight `μ` along a word `w` gives a vector of weight `μ` minus the sum of
the simple roots along `w`. -/
theorem negativeWord_mem_weightSpace {μ : Module.Dual K H} {m : M} (hm : m ∈ weightSpace R M μ)
    (w : List I) : negativeWord R m w ∈ weightSpace R M (μ - (w.map R.root).sum) := by
  induction w with
  | nil => simpa using hm
  | cons j w ih =>
    rw [negativeWord_cons, List.map_cons, List.sum_cons, sub_add_eq_sub_sub_swap]
    exact lie_negativeGenerator_mem_weightSpace ih j

omit [LieModule K (PresentedLieAlgebra R) M] in
/-- The lowering words applied to `m` lie in the submodule generated by `m`. -/
theorem negativeWord_mem_lieSpan (m : M) (w : List I) :
    negativeWord R m w ∈ LieSubmodule.lieSpan K (PresentedLieAlgebra R) {m} := by
  induction w with
  | nil => exact LieSubmodule.subset_lieSpan rfl
  | cons j w ih => exact LieSubmodule.lie_mem _ ih

section HighestWeight

variable {lam : Module.Dual K H} {v : M}

/-- An element of `𝔤` that maps every lowering word applied to `v` into the span of these words
maps the whole span into itself. -/
private theorem lie_mem_span_negativeWord {x : PresentedLieAlgebra R}
    (hx : ∀ w, ⁅x, negativeWord R v w⁆ ∈ Submodule.span K (Set.range (negativeWord R v))) {m : M}
    (hm : m ∈ Submodule.span K (Set.range (negativeWord R v))) :
    ⁅x, m⁆ ∈ Submodule.span K (Set.range (negativeWord R v)) := by
  have hle : Submodule.span K (Set.range (negativeWord R v)) ≤
      (Submodule.span K (Set.range (negativeWord R v))).comap
        (toEnd K (PresentedLieAlgebra R) M x) :=
    Submodule.span_le.mpr <| Set.range_subset_iff.mpr fun w => by
      rw [SetLike.mem_coe, Submodule.mem_comap, toEnd_apply_apply]
      exact hx w
  simpa only [Submodule.mem_comap, toEnd_apply_apply] using hle hm

/-- The span of the lowering words applied to `v` is stable under every lowering generator. -/
private theorem lie_negativeGenerator_mem_span {m : M}
    (hm : m ∈ Submodule.span K (Set.range (negativeWord R v))) (j : I) :
    ⁅negativeGenerator R j, m⁆ ∈ Submodule.span K (Set.range (negativeWord R v)) :=
  lie_mem_span_negativeWord (fun w => Submodule.subset_span ⟨j :: w, rfl⟩) hm

/-- If `v` is a weight vector, the span of the lowering words applied to `v` is stable under every
Cartan element. -/
private theorem lie_cartanElement_mem_span (hv : v ∈ weightSpace R M lam) {m : M}
    (hm : m ∈ Submodule.span K (Set.range (negativeWord R v))) (x : H) :
    ⁅cartanElement R x, m⁆ ∈ Submodule.span K (Set.range (negativeWord R v)) := by
  refine lie_mem_span_negativeWord (fun w => ?_) hm
  rw [mem_weightSpace_iff.mp (negativeWord_mem_weightSpace hv w) x]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨w, rfl⟩)

/-- If `v` has weight `lam` and is killed by every raising generator, then `eᵢ` maps each lowering
word applied to `v` into the span of these words, by the relation `eᵢ fⱼ = fⱼ eᵢ + δᵢⱼ hᵢ`. -/
private theorem lie_positiveGenerator_negativeWord_mem_span (hv : v ∈ weightSpace R M lam)
    (hpos : ∀ i, ⁅positiveGenerator R i, v⁆ = 0) (i : I) (w : List I) :
    ⁅positiveGenerator R i, negativeWord R v w⁆ ∈
      Submodule.span K (Set.range (negativeWord R v)) := by
  induction w with
  | nil => rw [negativeWord_nil, hpos]; exact zero_mem _
  | cons j w ih =>
    rw [negativeWord_cons, leibniz_lie]
    refine add_mem ?_ (lie_negativeGenerator_mem_span ih j)
    obtain rfl | hij := eq_or_ne i j
    · rw [lie_positiveGenerator_negativeGenerator_self]
      exact lie_cartanElement_mem_span hv (Submodule.subset_span ⟨w, rfl⟩) _
    · rw [lie_positiveGenerator_negativeGenerator_of_ne R hij, zero_lie]
      exact zero_mem _

/-- **The lowering words span a highest-weight submodule.** If `v` has weight `lam` and every
raising generator kills it, then the vectors `f_(j₁) ⋯ f_(jₛ) · v` span the submodule generated by
`v`. -/
theorem span_range_negativeWord_eq_lieSpan (hv : v ∈ weightSpace R M lam)
    (hpos : ∀ i, ⁅positiveGenerator R i, v⁆ = 0) :
    Submodule.span K (Set.range (negativeWord R v)) =
      (LieSubmodule.lieSpan K (PresentedLieAlgebra R) {v}).toSubmodule := by
  refine le_antisymm (Submodule.span_le.mpr ?_) ?_
  · rintro _ ⟨w, rfl⟩
    exact negativeWord_mem_lieSpan v w
  -- The span contains `v`, and every element of `𝔤` maps it into itself since the generators do.
  refine LieSubmodule.lieSpan_toSubmodule_le_of_lie_mem
    (Set.singleton_subset_iff.mpr (Submodule.subset_span ⟨[], rfl⟩))
    (LieSubalgebra.lie_mem_of_lieSpan_eq_top (lieSpan_generators_eq_top R) ?_)
  rintro _ ((⟨x, rfl⟩ | ⟨i, rfl⟩) | ⟨j, rfl⟩) m hm
  · exact lie_cartanElement_mem_span hv hm x
  · exact lie_mem_span_negativeWord (lie_positiveGenerator_negativeWord_mem_span hv hpos i) hm
  · exact lie_negativeGenerator_mem_span hm j

variable (hv : v ∈ weightSpace R M lam) (hpos : ∀ i, ⁅positiveGenerator R i, v⁆ = 0)
  (hgen : LieSubmodule.lieSpan K (PresentedLieAlgebra R) {v} = ⊤)
include hv hpos hgen

/-- The lowering words applied to a highest-weight vector `v` span the module `v` generates. -/
theorem span_range_negativeWord_eq_top : Submodule.span K (Set.range (negativeWord R v)) = ⊤ := by
  rw [span_range_negativeWord_eq_lieSpan hv hpos, hgen, LieSubmodule.top_toSubmodule]

/-- **The weight spaces of a highest-weight module.** If `v` has weight `lam`, is killed by every
raising generator and generates `M`, then the weight space of `μ` is spanned by the lowering words
applied to `v` along the words whose simple roots sum to `lam - μ`. -/
theorem weightSpace_eq_span_negativeWord (μ : Module.Dual K H) :
    weightSpace R M μ =
      Submodule.span K (negativeWord R v '' {w | (w.map R.root).sum = lam - μ}) := by
  have h := iInf_eigenspace_eq_of_iSup_eq_top
    (fun x : H => toEnd K (PresentedLieAlgebra R) M (cartanElement R x))
    (W := fun ν : Module.Dual K H =>
      Submodule.span K (negativeWord R v '' {w | (w.map R.root).sum = ν}))
    (g := fun ν : Module.Dual K H => ⇑(lam - ν)) ?_ ?_ ?_ (lam - μ)
  · rwa [sub_sub_cancel] at h
  · intro ν
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨w, (hw : (w.map R.root).sum = ν), rfl⟩
    have := negativeWord_mem_weightSpace hv w
    rwa [hw] at this
  · refine eq_top_iff.mpr ?_
    rw [← span_range_negativeWord_eq_top hv hpos hgen, Submodule.span_le]
    rintro _ ⟨w, rfl⟩
    exact Submodule.mem_iSup_of_mem (w.map R.root).sum (Submodule.subset_span ⟨w, rfl, rfl⟩)
  · intro ν ν' h
    exact sub_right_injective (DFunLike.coe_injective h)

/-- **The weights of a highest-weight module lie below the highest weight**: every weight `μ` of
a module generated by a highest-weight vector of weight `lam` satisfies `μ ≤ lam`, that is,
`lam - μ` is a sum of simple roots. -/
theorem rootLE_of_weightSpace_ne_bot {μ : Module.Dual K H} (h : weightSpace R M μ ≠ ⊥) :
    R.RootLE μ lam := by
  rw [weightSpace_eq_span_negativeWord hv hpos hgen] at h
  obtain ⟨w, hw : (w.map R.root).sum = lam - μ⟩ :
      {w : List I | (w.map R.root).sum = lam - μ}.Nonempty := by
    by_contra hS
    rw [Set.not_nonempty_iff_eq_empty] at hS
    simp [hS] at h
  rw [CartanRealization.rootLE_iff, ← hw]
  exact list_sum_mem fun _ hx => by
    obtain ⟨i, -, rfl⟩ := List.mem_map.mp hx
    exact R.root_mem_posRootCone i

/-- **The highest weight space is spanned by the highest-weight vector.** Over a field of
characteristic zero, the weight space of the highest weight `lam` of a module generated by a
highest-weight vector `v` is spanned by `v`; it is a line exactly when `v ≠ 0`. -/
theorem weightSpace_self_eq_span_singleton [CharZero K] : weightSpace R M lam = K ∙ v := by
  rw [weightSpace_eq_span_negativeWord hv hpos hgen, sub_self]
  have hS : {w : List I | (w.map R.root).sum = 0} = {[]} := by
    ext w
    refine ⟨fun hw => ?_, fun hw => by simp [Set.mem_singleton_iff.mp hw]⟩
    exact List.Perm.eq_nil (R.root_linearIndependent.perm_of_sum_map_eq (l₂ := []) hw)
  rw [hS, Set.image_singleton, negativeWord_nil]

/-- **Weight spaces of a highest-weight module are finite-dimensional** over a field of
characteristic zero, since only finitely many words have simple roots summing to a given element. -/
theorem finiteDimensional_weightSpace [CharZero K] (μ : Module.Dual K H) :
    FiniteDimensional K (weightSpace R M μ) := by
  rw [weightSpace_eq_span_negativeWord hv hpos hgen]
  exact FiniteDimensional.span_of_finite K
    ((R.root_linearIndependent.finite_setOf_sum_map_eq (lam - μ)).image _)

end HighestWeight

end KacMoody

