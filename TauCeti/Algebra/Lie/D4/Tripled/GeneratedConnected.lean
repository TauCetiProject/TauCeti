module

public import TauCeti.Algebra.Lie.D4.Tripled.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.Connected.Generated
import Mathlib.LinearAlgebra.SymmetricAlgebra.Basis
import Mathlib.Algebra.MonoidAlgebra.NoZeroDivisors
import Mathlib.RingTheory.Spectrum.Prime.Topology
import Mathlib.Topology.Connected.Basic

/-!
# Connectedness of the subgroup generated by the tripled type-D₄ roots and torus

Over an algebraically closed field, the eight numbered root subgroups and the rank-four weight
torus of the tripled type-`D₄` carrier generate a connected closed subgroup of `GL₂₄`. Its
coordinate Hopf algebra is the common-kernel quotient of the ambient coordinate algebra. The
base-changed integral carrier contains this subgroup; equality of the two closed subgroups is a
separate question.

Connectedness is one geometric input to identifying this explicit generated group with a pinned
split reductive group. It follows from connectedness of the additive root groups and split torus,
using the common-kernel connectedness theorem.

## References

* J. S. Milne, *Algebraic Groups* (2017), Propositions 2.37 and 2.48.
* R. Steinberg, *Lectures on Chevalley Groups*, Section 3.
-/

public section

open CategoryTheory
open TauCeti.DynkinType TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.D4Tripled

universe u

variable (k : Type u) [Field k]

/-- The coordinate Hopf algebras of the numbered root groups and the split weight torus. -/
noncomputable abbrev generatorCoordinateAlgebra :
    Sum (Fin 4 ⊕ Fin 4) Unit → CommHopfAlgCat k
  | .inl _ => AdditiveGroup.coordinateHopfAlgebra k
  | .inr _ => (DiagonalizableGroup.coordinateRing k
      (SplitTorus.characterGroup (Fin 4))).obj

/-- The coordinate maps of the numbered root subgroups and split weight torus into `GL₂₄`. -/
noncomputable def generatorCoordinateMap (j : Sum (Fin 4 ⊕ Fin 4) Unit) :
    GeneralLinear.coordinateHopfAlgebra k 24 ⟶ generatorCoordinateAlgebra k j :=
  match j with
  | .inl i => kostantRootSubgroupBaseChangePresentationCoordinateMap
      (TauCeti.serreRootGenerator weightTable.cartanMatrix)
      (TauCeti.serreH ℚ weightTable.cartanMatrix) rep lattice.toAddSubgroup
      rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis k i
  | .inr _ => GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ k d4TripledWeight

/-- The numbered branches of the generator family are the transported root maps. -/
@[simp] theorem generatorCoordinateMap_inl (i : Fin 4 ⊕ Fin 4) :
    generatorCoordinateMap k (.inl i) =
      kostantRootSubgroupBaseChangePresentationCoordinateMap
        (TauCeti.serreRootGenerator weightTable.cartanMatrix)
        (TauCeti.serreH ℚ weightTable.cartanMatrix) rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis k i := (rfl)

/-- The final branch of the generator family is the transported weight torus. -/
@[simp] theorem generatorCoordinateMap_inr :
    generatorCoordinateMap k (.inr ()) =
      GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ k d4TripledWeight := (rfl)

/-- The ideal of the closed subgroup generated by the numbered roots and weight torus. -/
noncomputable def generatedDefiningIdeal :
    HopfIdeal k (GeneralLinear.coordinateHopfAlgebra k 24) :=
  CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap k)

@[simp] theorem generatedDefiningIdeal_def :
    generatedDefiningIdeal k =
      CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap k) := (rfl)

/-- An ideal is contained in the defining ideal of the generated group exactly when each
numbered generator kills it. -/
theorem le_generatedDefiningIdeal_iff
    (J : HopfIdeal k (GeneralLinear.coordinateHopfAlgebra k 24)) :
    J ≤ generatedDefiningIdeal k ↔
      ∀ j, J.toIdeal ≤ RingHom.ker
        (generatorCoordinateMap k j).hom.toAlgHom.toRingHom := by
  rw [generatedDefiningIdeal_def]
  exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff (generatorCoordinateMap k) J

/-- The generated subgroup is contained in the base change of the integral carrier. -/
theorem baseChangeDefiningIdeal_le_generatedDefiningIdeal :
    baseChangeDefiningIdeal k ≤ generatedDefiningIdeal k := by
  rw [generatedDefiningIdeal]
  convert baseChangeDefiningIdeal_le_commonKernel k using 1
  congr 1

/-- The coordinate Hopf algebra of the subgroup generated by the roots and torus. -/
noncomputable def generatedCoordinateHopfAlgebra : CommHopfAlgCat k :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra k 24)
    (generatedDefiningIdeal k)

@[simp] theorem generatedCoordinateHopfAlgebra_def :
    generatedCoordinateHopfAlgebra k =
      CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra k 24)
        (generatedDefiningIdeal k) := (rfl)

/-- The generated closed subgroup is geometrically connected over an algebraically closed field. -/
theorem geometricallyConnected_generatedCoordinateHopfAlgebra [IsAlgClosed k] :
    geometricallyConnectedCommHopfAlgProperty k (generatedCoordinateHopfAlgebra k) := by
  have hK : ∀ j, ConnectedSpace (PrimeSpectrum (generatorCoordinateAlgebra k j)) := by
    intro j
    cases j with
    | inl i =>
      exact (inferInstance : ConnectedSpace (PrimeSpectrum (SymmetricAlgebra k k)))
    | inr _ =>
      exact (inferInstance : ConnectedSpace (PrimeSpectrum
        (MonoidAlgebra k (SplitTorus.characterGroup (Fin 4)))))
  exact CommHopfAlgCat.geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient
    (generatorCoordinateMap k) hK

end TauCeti.D4Tripled
