module

public import TauCeti.Algebra.Lie.D4.Tripled.GroupScheme
public import TauCeti.Algebra.Lie.Presentation.MinusculeWeightTable.RankOne
public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Diagonal.Basic

/-!
# Rank-one maps into the tripled D₄ carrier

Each pair of opposite numbered simple-root subgroups of the tripled D₄ carrier integrates,
over a field, to a faithful `SL₂` map. Its image is exactly the subgroup generated by the two
root families. The upper and lower transvections retain their parameters, and the diagonal
`diag(u, u⁻¹)` maps to the simple-coroot value in the weight torus. These normalizations are
needed to compare the carrier's numbered root subgroups with a pinned group.

The matrix comparisons hold over every commutative ring; carrier containment and the image
calculation use generation of `SL₂` by transvections over a field. No identification with an
independently pinned simply connected D₄ group scheme is asserted. Constructions on this
carrier transfer to that pinned group only along such an identification, once proved.

## Main declarations

* `TauCeti.D4Tripled.rankOnePoints`: the faithful numbered `SL₂` map into the carrier.
* `TauCeti.D4Tripled.rankOnePoints_diag2nUnit`: the simple-coroot normalization.
* `TauCeti.D4Tripled.range_rankOnePoints`: its image is generated by the opposite root families.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, Chapter 6.

The block representation is `TauCeti.MinusculeWeightTable.sl2BlockSL`. The containment and
image arguments adapt `TauCeti.Algebra.Lie.E7.Minuscule.RankOne`, using Mathlib's
`Matrix.SL2.transvection_induction`.
-/

public section

open scoped Matrix MatrixGroups

namespace TauCeti.D4Tripled

open DynkinType

noncomputable section

variable {R : Type*} [CommRing R]

/-- The upper transvection acts as the positive simple-root point over any commutative ring. -/
@[simp]
theorem sl2BlockSL_upper_transvection (i : Fin 4) (t : R) :
    weightTable.sl2BlockSL i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        (rootSubgroupPoints (.inl i) R (Multiplicative.ofAdd t) : GL (Fin 24) R) := by
  apply Units.ext
  rw [weightTable.coe_sl2BlockSL, weightTable.sl2BlockMatrix_upper_transvection,
    coe_rootSubgroupPoints_inl, raisingMatrix_def, toAdd_ofAdd]

/-- The lower transvection acts as the negative simple-root point over any commutative ring. -/
@[simp]
theorem sl2BlockSL_lower_transvection (i : Fin 4) (t : R) :
    weightTable.sl2BlockSL i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        (rootSubgroupPoints (.inr i) R (Multiplicative.ofAdd t) : GL (Fin 24) R) := by
  apply Units.ext
  rw [weightTable.coe_sl2BlockSL, weightTable.sl2BlockMatrix_lower_transvection,
    coe_rootSubgroupPoints_inr, loweringMatrix_def, toAdd_ofAdd]

/-- The diagonal block action is the numbered simple-coroot point over any commutative ring. -/
@[simp]
theorem sl2BlockSL_diag2nUnit (i : Fin 4) (u : Rˣ) :
    weightTable.sl2BlockSL i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) =
        (weightTorusPoints R (Pi.mulSingle i u) : GL (Fin 24) R) := by
  apply Units.ext
  rw [weightTable.coe_sl2BlockSL, Matrix.SpecialLinearGroup.diag2nUnit_coe,
    weightTable.sl2BlockMatrix_diagonal, coe_weightTorusPoints,
    UniversalEnvelopingAlgebra.kostantTorusMatrix_apply, diagGL_coe]
  congr 1
  funext a
  rw [torusCharacter_mulSingle]
  rcases weightTable.weight_eq_neg_one_or_eq_zero_or_eq_one a i with h | h | h
  all_goals simp_all only [weightTable_weight]
  all_goals simp

variable (K : Type*) [Field K] (i : Fin 4)

private theorem sl2BlockSL_mem_of_rootSubgroupPoints_mem {H : Subgroup (GL (Fin 24) K)}
    (hinl : ∀ t : K, (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) : GL (Fin 24) K) ∈ H)
    (hinr : ∀ t : K, (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) : GL (Fin 24) K) ∈ H)
    (g : SL(2, K)) : weightTable.sl2BlockSL i g ∈ H := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · rw [sl2BlockSL_upper_transvection]
      exact hinl t
    · rw [sl2BlockSL_lower_transvection]
      exact hinr t
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using mul_mem hg hh

private theorem sl2BlockSL_mem_points (g : SL(2, K)) : weightTable.sl2BlockSL i g ∈ points K :=
  sl2BlockSL_mem_of_rootSubgroupPoints_mem K i
    (fun t ↦ (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t)).property)
    (fun t ↦ (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t)).property) g

/-- The rank-one homomorphism into the tripled carrier at the numbered simple node `i`.
It acts by the defining two-dimensional representation on each weight string of length two
and fixes the basis vectors whose pairing with the `i`-th simple coroot is zero. -/
def rankOnePoints : SL(2, K) →* points K :=
  (weightTable.sl2BlockSL i).codRestrict (points K) (sl2BlockSL_mem_points K i)

/-- The rank-one map on underlying matrices is the minuscule block action. -/
@[simp]
theorem coe_rankOnePoints (g : SL(2, K)) :
    (rankOnePoints K i g : GL (Fin 24) K) = weightTable.sl2BlockSL i g := by
  rw [rankOnePoints, MonoidHom.codRestrict_apply]

/-- The rank-one map is faithful at every numbered simple node. -/
theorem rankOnePoints_injective : Function.Injective (rankOnePoints K i) := by
  rw [rankOnePoints, MonoidHom.injective_codRestrict]
  exact weightTable.sl2BlockSL_injective i
    (by simpa only [weightTable_weight] using exists_d4TripledWeight_apply_eq_neg_one i)

/-- The rank-one map preserves the positive-root parameter. -/
@[simp]
theorem rankOnePoints_upper_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, sl2BlockSL_upper_transvection]

/-- The rank-one map preserves the negative-root parameter. -/
@[simp]
theorem rankOnePoints_lower_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, sl2BlockSL_lower_transvection]

/-- The diagonal of the rank-one map is the numbered simple-coroot value. -/
@[simp]
theorem rankOnePoints_diag2nUnit (u : Kˣ) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints K (Pi.mulSingle i u) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, sl2BlockSL_diag2nUnit]

/-- The image of the rank-one map is exactly the subgroup generated by the two opposite
numbered simple-root families. -/
theorem range_rankOnePoints :
    (rankOnePoints K i).range = Subgroup.closure
      (Set.range (rootSubgroupPoints (.inl i) K) ∪
        Set.range (rootSubgroupPoints (.inr i) K)) := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [← Subgroup.mem_map_iff_mem (points K).subtype_injective,
      Subgroup.subtype_apply, coe_rankOnePoints]
    apply sl2BlockSL_mem_of_rootSubgroupPoints_mem K i
    · intro t
      exact Subgroup.mem_map.mpr ⟨_,
        Subgroup.subset_closure (Set.mem_union_left _ (Set.mem_range_self _)), rfl⟩
    · intro t
      exact Subgroup.mem_map.mpr ⟨_,
        Subgroup.subset_closure (Set.mem_union_right _ (Set.mem_range_self _)), rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
    · refine ⟨Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
        (Multiplicative.toAdd t), ?_⟩
      rw [rankOnePoints_upper_transvection, ofAdd_toAdd]
    · refine ⟨Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0)
        (Multiplicative.toAdd t), ?_⟩
      rw [rankOnePoints_lower_transvection, ofAdd_toAdd]

end

end TauCeti.D4Tripled
