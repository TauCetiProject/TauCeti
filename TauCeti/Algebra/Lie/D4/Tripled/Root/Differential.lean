module

public import TauCeti.Algebra.Lie.D4.Tripled.ClosedRootSubgroup
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Tangent
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent

/-!
# Integral root differentials of the tripled type-D4 carrier

The eight numbered root-subgroup differentials of the integral tripled type-`D₄` carrier on
`V(ϖ₁) ⊕ V(ϖ₃) ⊕ V(ϖ₄)` send the additive unit tangent vector to the integral raising or lowering
matrix of the tripled weight table. Each differential is injective, and its image is the line
generated by that normalized vector, with values in every commutative ring, including nonreduced
rings. Coefficient change preserves the normalization. The integral root matrices are supported on
the pairs of tripled weights whose difference is the corresponding signed simple root.

These are the equations that compare the root parametrizations of the carrier with the root
vectors of a pinning. Nothing here asserts that these lines exhaust the adjoint weight spaces,
that the weight torus is maximal, or that the carrier has a Borel subgroup or a pinning; nor is
the carrier identified with an independently pinned simply connected group scheme of type `D₄`.

## Main declarations

* `TauCeti.D4Tripled.rootMatrix_eq_zero_of_weight_ne`: the integral root matrices have the
  expected signed simple-root weight support.
* `TauCeti.D4Tripled.tangentMatrix_derivationComp_rootSubgroup`: the differential of a numbered
  root subgroup is the tangent parameter times its integral root matrix.
* `TauCeti.D4Tripled.rootVector`: the normalized root vector, with
  `TauCeti.D4Tripled.tangentMatrix_rootVector` and
  `TauCeti.D4Tripled.range_derivationCompLieHom_rootSubgroup_eq_span`.

## References

* J. S. Milne, *Algebraic Groups* (2017), §10.a and §21.1.
* B. Conrad, *Reductive Group Schemes* (2014), §5.1.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1–2.

The matrix calculation is the general Kostant root-subgroup tangent theorem of
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent`, and the weight
support is `TauCeti.UniversalEnvelopingAlgebra.kostantRootGeneratorIntMatrix_eq_zero_of_weight_ne`.
The root-vector interface follows the type-`D` spin carrier in
`TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.Root.Differential`.
-/

public section

open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.D4Tripled

open TauCeti.DynkinType

universe v

noncomputable section

-- Use the algebra-induced integer module consistently for the counit coefficient synonyms.
attribute [local instance high] Algebra.toModule

/-! ## The integral root matrices -/

/-- The Kostant integral matrix of a represented numbered root generator in the tripled lattice
basis is its raising or lowering matrix. -/
theorem kostantRootGeneratorIntMatrix_eq_rootMatrix (k : Fin 4 ⊕ Fin 4) :
    kostantRootGeneratorIntMatrix (TauCeti.serreRootGenerator weightTable.cartanMatrix)
        (TauCeti.serreH ℚ weightTable.cartanMatrix) rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice k latticeBasis =
      rootMatrix k := by
  apply kostantRootGeneratorIntMatrix_eq_of_action
  cases k with
  | inl i => simpa only [rootMatrix_inl] using rep_serreRootGenerator_inl_latticeBasis_eq_sum i
  | inr i => simpa only [rootMatrix_inr] using rep_serreRootGenerator_inr_latticeBasis_eq_sum i

/-- **A numbered integral root matrix has no entries outside its signed simple-root weight
difference.** The weights are the integral tripled weights, before any change of coefficient
ring. -/
theorem rootMatrix_eq_zero_of_weight_ne (k : Fin 4 ⊕ Fin 4) {a b : Fin 24}
    (hab : d4TripledWeight a - d4TripledWeight b ≠ TypeDStd.rootGeneratorWeight 4 k) :
    rootMatrix k a b = 0 := by
  rw [← kostantRootGeneratorIntMatrix_eq_rootMatrix]
  exact kostantRootGeneratorIntMatrix_eq_zero_of_weight_ne
    (TauCeti.serreRootGenerator weightTable.cartanMatrix)
    (TauCeti.serreH ℚ weightTable.cartanMatrix) rep lattice.toAddSubgroup
    rep_kostantForm_mem_lattice latticeBasis d4TripledWeight k
    (lie_serreH_serreRootGenerator k) isCartanWeightVector_latticeBasis hab

/-! ## The root differentials -/

variable {B : Type v} [CommRing B]

/-- The differential of a numbered integral root subgroup is its integral root matrix multiplied
by the additive tangent parameter, over every coefficient ring. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem tangentMatrix_derivationComp_rootSubgroup (k : Fin 4 ⊕ Fin 4)
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    GeneralLinear.tangentMatrix 24
        (HopfIdeal.quotientLieHom (B := B) definingIdeal
          (derivationComp (B := B) (rootSubgroupIntegralCoordinateMap k).hom d)) =
      AdditiveGroup.gaTangentLinearEquiv d • (rootMatrix k).map (Int.cast : ℤ → B) := by
  have hcomp : (rootSubgroupIntegralCoordinateMap k).hom.comp
      (Bialgebra.Quotient.mkBialgHom definingIdeal.toIdeal) =
      (kostantRootSubgroupCoordinateMap
        (TauCeti.serreRootGenerator weightTable.cartanMatrix)
        (TauCeti.serreH ℚ weightTable.cartanMatrix) rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice k (isNilpotent_rep_serreRootGenerator k)
        latticeBasis).hom := by
    rw [← CommHopfAlgCat.hom_mkQuotient, ← CommHopfAlgCat.hom_comp,
      mkQuotient_comp_rootSubgroupIntegralCoordinateMap]
  rw [HopfIdeal.quotientLieHom_apply, ← LinearMap.comp_apply, ← derivationComp_comp, hcomp,
    ← kostantRootGeneratorIntMatrix_eq_rootMatrix]
  simpa only [kostantRootGeneratorIntMatrix_eq_toMatrix, algebraMap_int_eq,
    Int.coe_castRingHom] using
    tangentMatrix_derivationComp_kostantRootSubgroupCoordinateMap
      (TauCeti.serreRootGenerator weightTable.cartanMatrix)
      (TauCeti.serreH ℚ weightTable.cartanMatrix) rep lattice.toAddSubgroup
      rep_kostantForm_mem_lattice k (isNilpotent_rep_serreRootGenerator k) latticeBasis d

/-- Every numbered integral root-subgroup differential is injective, including when its
coefficient ring has nilpotents. -/
theorem derivationComp_rootSubgroup_injective (k : Fin 4 ⊕ Fin 4) :
    Function.Injective (derivationComp (B := B) (rootSubgroupIntegralCoordinateMap k).hom) :=
  derivationComp_injective_of_surjective _ (rootSubgroupIntegralCoordinateMap_surjective k)

/-- The normalized root vector of the integral tripled type-`D₄` carrier, with values in `B`, is
the image of the additive unit tangent vector under its numbered root-subgroup differential. -/
def rootVector (k : Fin 4 ⊕ Fin 4) :
    Derivation ℤ (GeneralLinear.coordinateHopfAlgebra ℤ 24 ⧸ definingIdeal.toIdeal)
      (Bialgebra.CounitAlgebra ℤ (GeneralLinear.coordinateHopfAlgebra ℤ 24 ⧸
        definingIdeal.toIdeal) B) :=
  derivationComp (B := B) (rootSubgroupIntegralCoordinateMap k).hom
    ((AdditiveGroup.gaTangentLinearEquiv (R := ℤ) (B := B)).symm 1)

/-- The normalized root vector is the differential of the numbered root subgroup at the additive
unit tangent vector. -/
theorem rootVector_def (k : Fin 4 ⊕ Fin 4) :
    rootVector (B := B) k =
      derivationComp (B := B) (rootSubgroupIntegralCoordinateMap k).hom
        ((AdditiveGroup.gaTangentLinearEquiv (R := ℤ) (B := B)).symm 1) := by
  rw [rootVector]

/-- The matrix of a normalized root vector is its integral root matrix. -/
@[simp]
theorem tangentMatrix_rootVector (k : Fin 4 ⊕ Fin 4) :
    GeneralLinear.tangentMatrix 24
        (HopfIdeal.quotientLieHom (B := B) definingIdeal (rootVector (B := B) k)) =
      (rootMatrix k).map (Int.cast : ℤ → B) := by
  rw [rootVector_def, tangentMatrix_derivationComp_rootSubgroup, LinearEquiv.apply_symm_apply,
    one_smul]

/-- The differential with additive parameter `c` is `c` times the normalized root vector. -/
theorem derivationComp_rootSubgroup_eq_smul_rootVector (k : Fin 4 ⊕ Fin 4)
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    derivationComp (B := B) (rootSubgroupIntegralCoordinateMap k).hom d =
      AdditiveGroup.gaTangentLinearEquiv d • rootVector (B := B) k :=
  AdditiveGroup.derivationComp_eq_smul _ d

/-- Coefficient change preserves the normalized integral root vector. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem mapValue_rootVector {C : Type*} [CommRing C] (φ : B →ₐ[ℤ] C) (k : Fin 4 ⊕ Fin 4) :
    Derivation.mapValue φ (rootVector (B := B) k) = rootVector (B := C) k :=
  AdditiveGroup.mapValue_derivationComp_gaTangentLinearEquiv_symm_one φ _

/-- The image of each root-subgroup differential is precisely its normalized root line. -/
theorem range_derivationCompLieHom_rootSubgroup_eq_span (k : Fin 4 ⊕ Fin 4) :
    (derivationCompLieHom (B := B) (rootSubgroupIntegralCoordinateMap k).hom).range.toSubmodule =
      B ∙ rootVector (B := B) k :=
  AdditiveGroup.range_derivationCompLieHom_eq_span B _

/-- A normalized root vector is nonzero over every nontrivial coefficient ring.
Use this directly: simplification changes the inherited integer module in the zero derivation
before this statement can match. -/
theorem rootVector_ne_zero [Nontrivial B] (k : Fin 4 ⊕ Fin 4) : rootVector (B := B) k ≠ 0 :=
  AdditiveGroup.derivationComp_gaTangentLinearEquiv_symm_one_ne_zero _
    (derivationComp_rootSubgroup_injective (B := B) k)

end

end TauCeti.D4Tripled
