module

public import TauCeti.Algebra.Lie.D4.Tripled.Generated.Positive.Basic
public import TauCeti.Algebra.Lie.D4.Tripled.Generated.BaseChange

/-!
# Free base change of the generated positive tripled D₄ subgroup

The closed subgroup generated by the four positive numbered simple-root subgroups and the
weight torus of the tripled D₄ carrier commutes with free scalar extension, including every
field extension. The intrinsic defining ideal inside the full generated carrier transports
to the positive subgroup generated over the extension ring. Its coordinate Hopf algebra is
therefore the scalar extension of the positive coordinate Hopf algebra, compatibly with the
inclusion into the full generated carrier.

This comparison identifies the positive subgroup on geometric fibres for Borel recognition.
It concerns generation over each ground ring; comparison with specialization of the integral
toral closure and Borel maximality are separate assertions.

## References

* B. Conrad, *Reductive Group Schemes*, §1.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26–28.

The construction follows
`TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.Positive.BaseChange`, using
the full tripled-carrier generator comparisons in `Generated.BaseChange` and the
common-kernel and quotient-transport constructions in
`TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange`. Here the positive subgroup is
defined directly inside the full generated carrier, so no ambient ideal or second
restriction map is needed.
-/

public section

open CategoryTheory

namespace TauCeti.D4Tripled.Generated.Positive

universe v w

noncomputable section

variable (k : Type v) (K : Type max v w)
  [CommRing k] [CommRing K] [Algebra k K] [Module.Free k K]

/-- Free scalar extension carries the positive subgroup's intrinsic defining ideal onto the
ideal of the positive subgroup generated over the extension ring. -/
theorem map_baseChangeHopfIdeal_definingIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (definingIdeal k)).map
        (generatedCoordinateHopfAlgebraBaseChangeIso k K).hom.hom =
      definingIdeal K := by
  apply CommHopfAlgCat.map_baseChangeHopfIdeal_commonKernelHopfIdeal
    (generator k) (generatedCoordinateHopfAlgebraBaseChangeIso k K)
    (fun j ↦ generatorCoordinateAlgebraBaseChangeIso k K (match j with
      | .inl i => .inl (.inl i)
      | .inr u => .inr u))
    (generator K)
  rintro (i | u)
  · rw [generator_inl, generator_inl, Category.assoc,
      baseChangeMap_generatedCoordinateLift_comp_generatorCoordinateAlgebraBaseChangeIso_hom k K,
      Iso.inv_hom_id_assoc]
  · cases u
    rw [generator_inr, generator_inr, Category.assoc,
      baseChangeMap_generatedCoordinateLift_comp_generatorCoordinateAlgebraBaseChangeIso_hom k K,
      Iso.inv_hom_id_assoc]

/-- The scalar extension of the positive coordinate Hopf algebra is the coordinate algebra
of the positive subgroup generated over the extension ring. -/
def coordinateHopfAlgebraBaseChangeIso :
    CommHopfAlgCat.baseChange (K := K) (coordinateHopfAlgebra k) ≅
      coordinateHopfAlgebra K :=
  CommHopfAlgCat.quotientBaseChangeIsoOfMapEq (definingIdeal k) (definingIdeal K)
    (generatedCoordinateHopfAlgebraBaseChangeIso k K)
    (map_baseChangeHopfIdeal_definingIdeal k K)

/-- The positive-subgroup comparison respects its closed inclusion into the full generated
tripled D₄ carrier. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_mkQuotient_comp_baseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := K)
        (CommHopfAlgCat.mkQuotient _ (definingIdeal k)) ≫
        (coordinateHopfAlgebraBaseChangeIso k K).hom =
      (generatedCoordinateHopfAlgebraBaseChangeIso k K).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal K) :=
  CommHopfAlgCat.baseChangeMap_mkQuotient_comp_quotientBaseChangeIsoOfMapEq_hom _ _ _
    (map_baseChangeHopfIdeal_definingIdeal k K)

end

end TauCeti.D4Tripled.Generated.Positive
