module

public import TauCeti.Algebra.Lie.D4.Tripled.Generated.Connected
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.GeometricallyReduced
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.SmoothConnected
import TauCeti.RingTheory.Smooth.GeometricallyReduced

/-!
# The positive subgroup of the generated tripled D₄ carrier

Inside the subgroup of `GL₂₄` generated by the tripled D₄ roots and weight torus, take the
smallest closed subgroup containing the four positive numbered simple-root subgroups and the
rank-four weight torus. Its defining Hopf ideal is the common kernel of those five generator
maps. The quotient construction supplies the closed inclusion and the factorizations of the
positive roots and torus via `CommHopfAlgCat.commonKernelLift`.

Over every field this subgroup is smooth and geometrically connected, including over imperfect
fields. These are two of the geometric conditions for the positive subgroup to be a Borel.
The subgroup is generated over the chosen base; comparison with an integral positive subgroup
and Borel maximality require further results.

## References

* J. S. Milne, *Algebraic Groups* (2017), §2.h and Chapter 17.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26–28.
* The construction follows `TauCeti.Algebra.Lie.E6.Minuscule.Generated.Positive.Basic`,
  using the generator lifts inside the full carrier as the ambient family.
-/

public section

open CategoryTheory
open TauCeti.CommHopfAlgCat
  (geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient_of_geometricallyConnected)

namespace TauCeti.D4Tripled.Generated.Positive

universe u

noncomputable section

variable (A : Type u) [CommRing A]

/-- The coordinate algebras of the four positive numbered roots and the weight torus. -/
abbrev generatorCodomain (j : Fin 4 ⊕ Unit) : CommHopfAlgCat A :=
  generatorCoordinateAlgebra A (match j with
    | .inl i => .inl (.inl i)
    | .inr u => .inr u)

/-- The positive numbered root and weight-torus maps into the full generated tripled carrier. -/
def generator : ∀ j, generatedCoordinateHopfAlgebra A ⟶ generatorCodomain A j
  | .inl i => generatedCoordinateLift A (.inl (.inl i))
  | .inr u => generatedCoordinateLift A (.inr u)

@[simp]
theorem generator_inl (i : Fin 4) :
    generator A (.inl i) = generatedCoordinateLift A (.inl (.inl i)) := (rfl)

@[simp]
theorem generator_inr : generator A (.inr ()) = generatedCoordinateLift A (.inr ()) := (rfl)

/-- The defining ideal of the smallest closed subgroup of the generated tripled carrier
containing its four positive numbered roots and its weight torus. -/
abbrev definingIdeal : HopfIdeal A (generatedCoordinateHopfAlgebra A) :=
  CommHopfAlgCat.commonKernelHopfIdeal (generator A)

/-- Minimality of the positive subgroup, expressed contravariantly on defining Hopf ideals. -/
theorem le_definingIdeal_iff (I : HopfIdeal A (generatedCoordinateHopfAlgebra A)) :
    I ≤ definingIdeal A ↔
      (∀ i : Fin 4, I.toIdeal ≤ RingHom.ker
        (generatedCoordinateLift A (.inl (.inl i))).hom.toAlgHom.toRingHom) ∧
      I.toIdeal ≤ RingHom.ker (generatedCoordinateLift A (.inr ())).hom.toAlgHom.toRingHom := by
  rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  constructor
  · intro h
    exact ⟨fun i ↦ h (.inl i), h (.inr ())⟩
  · rintro ⟨hroot, htorus⟩ (i | ⟨⟩)
    · exact hroot i
    · exact htorus

/-- The coordinate Hopf algebra of the positive subgroup, generated over the ground ring. -/
abbrev coordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (generatedCoordinateHopfAlgebra A) (definingIdeal A)

variable (k : Type u) [Field k]

/-- The positive subgroup is smooth over every field. -/
theorem smooth_coordinateHopfAlgebra :
    smoothCommHopfAlgProperty k (coordinateHopfAlgebra k) := by
  let : ∀ j, Algebra.IsGeometricallyReduced k (generatorCodomain k j) := by
    rintro (i | ⟨⟩)
    · exact isGeometricallyReduced_of_smooth k _
    · exact (DiagonalizableGroup.geometricallyReduced_coordinateRing k
        (SplitTorus.characterGroup (Fin 4))).isGeometricallyReduced
  exact
    CommHopfAlgCat.smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal_of_geometricallyReduced
      (generator k)

/-- The positive subgroup is geometrically connected over every field. -/
theorem geometricallyConnected_coordinateHopfAlgebra :
    geometricallyConnectedCommHopfAlgProperty k (coordinateHopfAlgebra k) := by
  apply geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient_of_geometricallyConnected
    (generator k)
  rintro (i | ⟨⟩)
  · exact AdditiveGroup.geometricallyConnectedCommHopfAlgProperty_coordinateHopfAlgebra k
  · exact DiagonalizableGroup.geometricallyConnected_coordinateRing k
      (SplitTorus.characterGroup (Fin 4))

end

end TauCeti.D4Tripled.Generated.Positive
