module

public import TauCeti.Algebra.Lie.D4.Tripled.Generated.Connected
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange

/-!
# Relative base change of the generated tripled type-D₄ subgroup

The subgroup of `GL₂₄` generated by the numbered tripled root subgroups and weight torus commutes
with free scalar extension. The comparison identifies the ambient general-linear coordinates and
each generating coordinate map, hence also the common-kernel ideal and quotient coordinate algebra.
This lets geometric properties be checked after extension to an algebraic closure; it does not
identify the generated subgroup with the specialization of the integral carrier.

## Main declarations

* `TauCeti.D4Tripled.generatorCoordinateMap_baseChange`: scalar extension commutes with each
  generating coordinate map.
* `TauCeti.D4Tripled.generatedCoordinateHopfAlgebraBaseChangeIso`: the generated subgroup
  commutes with free scalar extension.
* `TauCeti.D4Tripled.finiteTypeGeneratedCoordinateHopfAlgebraBaseChangeIso`: the same comparison
  in the finite-type category.

## References

* B. Conrad, *Reductive Group Schemes*, §1.
* R. W. Carter, *Simple Groups of Lie Type*, §4.4.

The construction follows `TauCeti.Algebra.Lie.E7.Minuscule.Generated.RelativeBaseChange`.
-/

public section

open CategoryTheory

namespace TauCeti.D4Tripled

universe u

attribute [local instance high] Algebra.toModule

variable (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Free R S]

/-- Scalar extension of a numbered root or weight-torus coordinate algebra. -/
noncomputable def generatorCoordinateAlgebraBaseChangeIso
    (j : Sum (Fin 4 ⊕ Fin 4) Unit) :
    CommHopfAlgCat.baseChange (K := S) (generatorCoordinateAlgebra R j) ≅
      generatorCoordinateAlgebra S j :=
  match j with
  | .inl _ => AdditiveGroup.coordinateHopfAlgebraBaseChangeIso R S
  | .inr _ => _root_.CommHopfAlgCat.isoMk
      (TauCeti.MonoidAlgebra.scalarTensorBialgEquiv R S
        (G := SplitTorus.characterGroup (Fin 4)))

omit [Module.Free R S] in
/-- **The tripled type-D₄ generators commute with scalar extension.** Under the canonical
coordinate identifications, each root-subgroup or weight-torus map over `R` extends to the
corresponding map over `S`. -/
theorem generatorCoordinateMap_baseChange (j : Sum (Fin 4 ⊕ Fin 4) Unit) :
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 24).inv ≫
        CommHopfAlgCat.baseChangeMap (generatorCoordinateMap R j) ≫
        (generatorCoordinateAlgebraBaseChangeIso R S j).hom =
      generatorCoordinateMap S j := by
  let _ : IsScalarTower ℤ R S := IsScalarTower.of_algebraMap_eq fun x ↦ by
    exact (map_intCast (algebraMap R S) x).symm
  apply _root_.CommHopfAlgCat.hom_ext
  apply GeneralLinear.coordinateHopfAlgebra_bialgHom_ext S 24
  intro i k
  cases j with
  | inl j =>
      rw [generatorCoordinateMap_inl, generatorCoordinateMap_inl,
        GeneralLinear.coordinateHopfAlgebraBaseChangeMap_X]
      rw [UniversalEnvelopingAlgebra.kostantRootSubgroupBaseChangePresentationCoordinateMap_def,
        UniversalEnvelopingAlgebra.kostantRootSubgroupBaseChangePresentationCoordinateMap_def]
      simp only [generatorCoordinateAlgebraBaseChangeIso,
        _root_.CommHopfAlgCat.hom_comp, BialgHom.comp_apply]
      rw [GeneralLinear.coordinateHopfAlgebraBaseChangeIso_inv_X,
        CommHopfAlgCat.baseChangeMap_apply_tmul,
        GeneralLinear.coordinateHopfAlgebraBaseChangeIso_inv_X,
        CommHopfAlgCat.baseChangeMap_apply_tmul]
      exact AdditiveGroup.gaScalarTensorBialgEquiv_one_tmul_gaScalarTensorBialgEquiv_one_tmul _
  | inr j =>
      rw [generatorCoordinateMap_inr, generatorCoordinateMap_inr,
        GeneralLinear.coordinateHopfAlgebraBaseChangeMap_X]
      rw [GeneralLinear.weightTorusBaseChangeCoordinateMap_def,
        GeneralLinear.weightTorusBaseChangeCoordinateMap_def]
      simp only [generatorCoordinateAlgebraBaseChangeIso,
        _root_.CommHopfAlgCat.hom_comp, BialgHom.comp_apply]
      rw [GeneralLinear.coordinateHopfAlgebraBaseChangeIso_inv_X,
        CommHopfAlgCat.baseChangeMap_apply_tmul,
        GeneralLinear.coordinateHopfAlgebraBaseChangeIso_inv_X,
        CommHopfAlgCat.baseChangeMap_apply_tmul,
        DiagonalizableGroup.baseChangeCoordinateHopfAlgebraIso_hom_apply,
        DiagonalizableGroup.baseChangeCoordinateHopfAlgebraIso_hom_apply]
      exact MonoidAlgebra.scalarTensorBialgEquiv_one_tmul_scalarTensorBialgEquiv_one_tmul _ _

/-- Scalar extension carries the generated tripled type-D₄ defining ideal to the ideal generated
over the extension ring. -/
theorem map_baseChange_generatedDefiningIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := S) (generatedDefiningIdeal R)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 24).hom.hom =
      generatedDefiningIdeal S := by
  rw [generatedDefiningIdeal_def, generatedDefiningIdeal_def,
    CommHopfAlgCat.baseChangeHopfIdeal_commonKernelHopfIdeal,
    CommHopfAlgCat.map_commonKernelHopfIdeal]
  rw [← CommHopfAlgCat.commonKernelHopfIdeal_comp_of_injective
    (fun j ↦ (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 24).inv ≫
      CommHopfAlgCat.baseChangeMap (generatorCoordinateMap R j))
    (fun j ↦ (generatorCoordinateAlgebraBaseChangeIso R S j).hom) fun j ↦
      (ConcreteCategory.bijective_of_isIso (generatorCoordinateAlgebraBaseChangeIso R S j).hom).1]
  congr 1
  funext j
  exact generatorCoordinateMap_baseChange R S j

/-- **The subgroup generated by the tripled type-D₄ root subgroups and weight torus commutes with
free scalar extension.** -/
noncomputable def generatedCoordinateHopfAlgebraBaseChangeIso :
    CommHopfAlgCat.baseChange (K := S) (generatedCoordinateHopfAlgebra R) ≅
      generatedCoordinateHopfAlgebra S :=
  eqToIso (congrArg (CommHopfAlgCat.baseChange (K := S))
      (generatedCoordinateHopfAlgebra_def R)) ≪≫
    CommHopfAlgCat.quotientBaseChangeIsoOfMapEq
      (generatedDefiningIdeal R) (generatedDefiningIdeal S)
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 24)
      (map_baseChange_generatedDefiningIdeal R S) ≪≫
    eqToIso (generatedCoordinateHopfAlgebra_def S).symm

/-- Scalar extension of the finite-type generated subgroup is the subgroup generated after
scalar extension. -/
noncomputable def finiteTypeGeneratedCoordinateHopfAlgebraBaseChangeIso :
    FiniteTypeCommHopfAlgCat.baseChange (K := S)
        (generatedFiniteTypeCoordinateHopfAlgebra R) ≅
      generatedFiniteTypeCoordinateHopfAlgebra S :=
  FiniteTypeCommHopfAlgCat.baseChangeIsoOfObjIso rfl rfl
    (generatedCoordinateHopfAlgebraBaseChangeIso R S)

/-- The relative base-change comparison intertwines the ambient quotient maps. -/
@[simp]
theorem baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := S) (generatedCoordinateMap R) ≫
        (generatedCoordinateHopfAlgebraBaseChangeIso R S).hom =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 24).hom ≫
        generatedCoordinateMap S := by
  have hbase :
      CommHopfAlgCat.baseChangeMap (K := S) (generatedCoordinateMap R) ≫
          (eqToIso (congrArg (CommHopfAlgCat.baseChange (K := S))
            (generatedCoordinateHopfAlgebra_def R))).hom =
        CommHopfAlgCat.baseChangeMap (K := S)
          (CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra R 24)
            (generatedDefiningIdeal R)) := by
    let F := CommHopfAlgCat.baseChangeFunctor (k := R) (K := S)
    calc
      _ = F.map (generatedCoordinateMap R) ≫
          F.map (eqToIso (generatedCoordinateHopfAlgebra_def R)).hom := by
        rw [CommHopfAlgCat.baseChangeFunctor_map]
        congr 1
        simpa only [eqToIso.hom] using
          (eqToHom_map F (generatedCoordinateHopfAlgebra_def R)).symm
      _ = F.map (generatedCoordinateMap R ≫
          (eqToIso (generatedCoordinateHopfAlgebra_def R)).hom) :=
        (F.map_comp _ _).symm
      _ = F.map (CommHopfAlgCat.mkQuotient
          (GeneralLinear.coordinateHopfAlgebra R 24) (generatedDefiningIdeal R)) := by
        rw [generatedCoordinateMap_comp_eqToIso_hom]
      _ = _ := CommHopfAlgCat.baseChangeFunctor_map _
  simp only [generatedCoordinateHopfAlgebraBaseChangeIso, Iso.trans_hom]
  rw [← Category.assoc, hbase, ← Category.assoc,
    CommHopfAlgCat.baseChangeMap_mkQuotient_comp_quotientBaseChangeIsoOfMapEq_hom,
    Category.assoc, ← generatedCoordinateMap_comp_eqToIso_hom]
  simp

end TauCeti.D4Tripled
