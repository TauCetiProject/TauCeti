module

public import TauCeti.Algebra.Lie.D4.Tripled.Generated.RelativeBaseChange
public import TauCeti.Algebra.Lie.D4.Tripled.Generated.UnipotentRadical
public import TauCeti.Algebra.AlgebraicGroup.Reductive.Basic

/-!
# Reductivity of the generated tripled type-D₄ subgroup

Over every field, the closed subgroup of `GL₂₄` generated by the eight numbered root subgroups and
the weight torus is reductive. Smoothness and geometric connectedness hold over the ground field.
Free base change identifies its geometric fibre with the subgroup generated over an algebraic
closure, where the faithful completely reducible standard comodule eliminates normal smooth
unipotent subgroups.

This proves reductivity of the generated subgroup. Identifying it with the specialization of the
integral carrier, and then with a pinned simply connected group of type `D₄`, remains separate.

## Main declaration

* `TauCeti.D4Tripled.reductiveCommHopfAlgProperty_finiteTypeGeneratedCoordinateHopfAlgebra`:
  reductivity of the subgroup generated over any field.

## References

* J. S. Milne, *Algebraic Groups* (2017), §6.46 and §19.b.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26–27.

The organization follows the type-`E₇` generated-subgroup result in
`TauCeti.Algebra.Lie.E7.Minuscule.Generated.Reductive`.
-/

public section

namespace TauCeti.D4Tripled

universe u

noncomputable section

/-- **The subgroup generated by the tripled type-D₄ root subgroups and weight torus is reductive
over every field.** -/
theorem reductiveCommHopfAlgProperty_finiteTypeGeneratedCoordinateHopfAlgebra
    (k : Type u) [Field k] :
    reductiveCommHopfAlgProperty k (generatedFiniteTypeCoordinateHopfAlgebra k) := by
  apply reductiveCommHopfAlgProperty_of_geometricFiber_iso k _
    (generatedFiniteTypeCoordinateHopfAlgebra (AlgebraicClosure k))
    ((smoothCommHopfAlgProperty_iff _).mp
      (smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra k))
    (geometricallyConnectedCommHopfAlgProperty_generatedCoordinateHopfAlgebra k)
    (finiteTypeGeneratedCoordinateHopfAlgebraBaseChangeIso k (AlgebraicClosure k))
  intro I hI hU
  exact eq_augmentation_of_isNormal_of_smoothUnipotent_generated
    (AlgebraicClosure k) I hI hU

end

end TauCeti.D4Tripled
