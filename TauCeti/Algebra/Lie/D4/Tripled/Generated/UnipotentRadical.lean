module

public import TauCeti.Algebra.Lie.D4.Tripled.Generated.StandardComodule
public import TauCeti.Algebra.Lie.D4.Tripled.Generated.Smooth
public import TauCeti.Algebra.AlgebraicGroup.Unipotent.Radical.Faithful

/-!
# The unipotent radical of the generated tripled type-D₄ subgroup

Over an algebraically closed field, every normal smooth unipotent closed subgroup of the
group generated by the eight numbered tripled root subgroups and weight torus is trivial.
In particular its unipotent radical is trivial.

The generated group is smooth, so its coordinate algebra is reduced without any hypothesis
on the specialization of the integral carrier. Its faithful, completely reducible
24-dimensional standard representation eliminates normal smooth unipotent subgroups:
their fixed vectors form an ambient subcomodule, and complete reducibility forces them to
act trivially. Faithfulness identifies their defining ideal with the augmentation ideal.

This result concerns the subgroup generated over the field. It neither identifies that subgroup
with the specialized integral toral closure nor with an independently pinned simply connected
group of type `D₄`.

## Main results

* `TauCeti.D4Tripled.eq_augmentation_of_isNormal_of_smoothUnipotent_generated`: normal smooth
  unipotent closed subgroups of the generated group are trivial.
* `TauCeti.D4Tripled.unipotentRadicalDefiningIdeal_generated_eq_augmentation`: its unipotent
  radical is trivial.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§19 and 26.
* J. C. Jantzen, *Representations of Algebraic Groups*, I.2 and II.2.

The elimination argument follows
`TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.Generated.UnipotentRadical`, using
`TauCeti.HopfIdeal.eq_augmentation_of_isNormal_of_smoothUnipotent_of_isFaithful`.
-/

public section

namespace TauCeti.D4Tripled

universe u

noncomputable section

variable (k : Type u) [Field k] [IsAlgClosed k]

attribute [local instance] generatedStandardComodule

/-- Every normal smooth unipotent closed subgroup of the generated tripled type-D₄ group
is trivial, over every algebraically closed field. -/
theorem eq_augmentation_of_isNormal_of_smoothUnipotent_generated
    (I : HopfIdeal k (generatedCoordinateHopfAlgebra k)) (hI : I.IsNormal)
    (hU : smoothUnipotentCommHopfAlgProperty k
      (FiniteTypeCommHopfAlgCat.quotient (generatedFiniteTypeCoordinateHopfAlgebra k) I)) :
    I = HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra k) := by
  let := isReduced_generatedCoordinateHopfAlgebra k
  exact HopfIdeal.eq_augmentation_of_isNormal_of_smoothUnipotent_of_isFaithful k
    (generatedFiniteTypeCoordinateHopfAlgebra k) (Fin 24 → k)
    (isCompletelyReducible_generatedStandardComodule k)
    (isFaithful_generatedStandardComodule k) I hI hU

/-- The unipotent radical of the generated tripled type-D₄ group over an algebraically closed
field is trivial. -/
theorem unipotentRadicalDefiningIdeal_generated_eq_augmentation :
    FiniteTypeCommHopfAlgCat.unipotentRadicalDefiningIdeal
        (generatedFiniteTypeCoordinateHopfAlgebra k) =
      HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra k) := by
  let := isReduced_generatedCoordinateHopfAlgebra k
  exact FiniteTypeCommHopfAlgCat.unipotentRadicalDefiningIdeal_eq_augmentation_of_isFaithful k
    (generatedFiniteTypeCoordinateHopfAlgebra k) (Fin 24 → k)
    (isCompletelyReducible_generatedStandardComodule k)
    (isFaithful_generatedStandardComodule k)

end

end TauCeti.D4Tripled
