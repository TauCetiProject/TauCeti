module

public import TauCeti.Algebra.Lie.D4.Tripled.Generated.Connected
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.GeometricallyReduced
import TauCeti.RingTheory.Smooth.GeometricallyReduced
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.SmoothConnected

/-!
# Smoothness of the subgroup generated by the tripled type-D₄ roots and torus

The numbered root subgroups and weight torus of the tripled type-`D₄` carrier have geometrically
reduced coordinate algebras over every field. The finite-type subgroup they generate is therefore
smooth and has reduced coordinate algebra. Together with the connectedness result, this gives
two geometric properties needed to compare the generated subgroup with the integral carrier and
ultimately with the pinned group of type `D₄`.

The result concerns the subgroup generated over the field; it does not assert that this subgroup
equals the base change of the integral carrier.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§26–27.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.
-/

public section

namespace TauCeti.D4Tripled

open CategoryTheory

universe u

variable (k : Type u) [Field k]

-- The proof follows the construction in `TauCeti.Algebra.Lie.E7.Minuscule.Generated.Smooth`.
private theorem isGeometricallyReduced_generatorCoordinateAlgebra :
    ∀ j, Algebra.IsGeometricallyReduced k (generatorCoordinateAlgebra k j) := by
  intro j
  cases j with
  | inl _ => exact isGeometricallyReduced_of_smooth k _
  | inr _ =>
      exact (DiagonalizableGroup.geometricallyReduced_coordinateRing k
        (SplitTorus.characterGroup (Fin 4))).isGeometricallyReduced

/-- The subgroup generated by the tripled type-`D₄` roots and torus is smooth over every field. -/
theorem smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra :
    smoothCommHopfAlgProperty k (generatedCoordinateHopfAlgebra k) := by
  let : ∀ j, Algebra.IsGeometricallyReduced k (generatorCoordinateAlgebra k j) :=
    isGeometricallyReduced_generatorCoordinateAlgebra k
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact
    CommHopfAlgCat.smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal_of_geometricallyReduced
      (generatorCoordinateMap k)

/-- The subgroup generated by the tripled type-`D₄` roots and torus has reduced coordinate
algebra over every field. -/
theorem isReduced_generatedCoordinateHopfAlgebra :
    IsReduced (generatedCoordinateHopfAlgebra k) := by
  let _ : Algebra.Smooth k (generatedCoordinateHopfAlgebra k) :=
    (smoothCommHopfAlgProperty_iff _).mp
      (smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra k)
  exact isReduced_of_smooth k _

end TauCeti.D4Tripled
