module

public import TauCeti.Algebra.Lie.D4.Tripled.Generated.WeightTorus
public import TauCeti.Algebra.AlgebraicGroup.Torus.Maximal
import TauCeti.Algebra.Lie.D4.Tripled.MaximalTorus

/-!
# The maximal torus of the generated tripled D₄ group

The closed rank-four weight torus is a maximal torus of the subgroup generated by the
tripled D₄ root subgroups and torus over every field. Over an algebraically closed field,
even a reduced commutative closed subgroup containing this torus equals it. Indeed, its
points embed into the integral carrier's points, where the weight torus is its own
centralizer. Reduced closed subgroups over an algebraically closed field are determined by
these points. Maximality over an arbitrary field follows by faithfully flat descent from
its algebraic closure.

This supplies the maximal-torus condition for a pinning of the generated group, without
identifying it with the specialization of the integral carrier or with an independently
pinned simply connected group.

## References

* J. S. Milne, *Algebraic Groups* (2017), Chapters 3 and 17.
* The point-separation and descent argument follows
  `TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.MaximalTorus`.
* The centralizer calculation is
  `TauCeti.D4Tripled.centralizer_range_weightTorusPoints_eq_range`.
-/

public section

open CategoryTheory

namespace TauCeti.D4Tripled.Generated

universe u

noncomputable section

variable (k : Type u) [Field k]

/-- Over an algebraically closed field, a reduced commutative closed subgroup containing the
weight torus of the generated tripled D₄ group is that torus. -/
theorem eq_weightTorusDefiningIdeal_of_le_of_isCocomm [IsAlgClosed k]
    (I : HopfIdeal k (generatedCoordinateHopfAlgebra k))
    [IsReduced (CommHopfAlgCat.quotient (generatedCoordinateHopfAlgebra k) I)]
    [Coalgebra.IsCocomm k (CommHopfAlgCat.quotient (generatedCoordinateHopfAlgebra k) I)]
    (hI : I ≤ weightTorusDefiningIdeal k) : I = weightTorusDefiningIdeal k := by
  exact HopfIdeal.eq_of_le_of_isCocomm_of_maximal_points (weightTorusDefiningIdeal k)
    (carrierPointsHom k (CommAlgCat.of k k)) (carrierPointsHom_injective k (CommAlgCat.of k k))
    (map_carrierPointsHom_quotientPointsSubgroup_weightTorusDefiningIdeal k (CommAlgCat.of k k))
    (fun P _ hP ↦ eq_range_weightTorusPoints_of_le_of_isMulCommutative k P hP) I hI

private theorem isMaximalTorus_weightTorusDefiningIdeal_of_isAlgClosed [IsAlgClosed k] :
    HopfIdeal.IsMaximalTorus k (generatedCoordinateHopfAlgebra k)
      (weightTorusDefiningIdeal k) :=
  HopfIdeal.isMaximalTorus_of_maximal_points (weightTorusDefiningIdeal k)
    ((splitTorusCommHopfAlgProperty_quotient_weightTorusDefiningIdeal k).torus k _)
    (carrierPointsHom k (CommAlgCat.of k k)) (carrierPointsHom_injective k (CommAlgCat.of k k))
    (map_carrierPointsHom_quotientPointsSubgroup_weightTorusDefiningIdeal k (CommAlgCat.of k k))
    (fun P _ hP ↦ eq_range_weightTorusPoints_of_le_of_isMulCommutative k P hP)

/-- Over every field, the closed rank-four weight torus is a maximal torus of the generated
tripled D₄ group. No assumption on the characteristic or on the integral carrier is needed. -/
theorem isMaximalTorus_weightTorusDefiningIdeal :
    HopfIdeal.IsMaximalTorus k (generatedCoordinateHopfAlgebra k)
      (weightTorusDefiningIdeal k) :=
  HopfIdeal.isMaximalTorus_of_baseChange (weightTorusDefiningIdeal k)
    (weightTorusDefiningIdeal (AlgebraicClosure k))
    (generatedCoordinateHopfAlgebraBaseChangeIso k (AlgebraicClosure k))
    ((splitTorusCommHopfAlgProperty_quotient_weightTorusDefiningIdeal k).torus k _)
    (map_baseChangeHopfIdeal_weightTorusDefiningIdeal k (AlgebraicClosure k))
    (isMaximalTorus_weightTorusDefiningIdeal_of_isAlgClosed (AlgebraicClosure k))

end

end TauCeti.D4Tripled.Generated
