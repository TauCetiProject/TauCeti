module

public import TauCeti.Algebra.Lie.GeneralLinear.QuantumMinor.Alternating
import TauCeti.Algebra.Lie.GeneralLinear.QuantumMinor.Commutator

/-!
# Centrality of principal quantum determinants

A principal quantum minor commutes with the matrix units of its block and with those of the
complementary block. In particular the full quantum determinant is central in the algebra
generated by the matrix units, and its values at different spectral parameters commute.
For centrality of the quantum determinant, see Molev, Nazarov and Olshanski,
*Yangians and classical Lie algebras*, Theorem 2.10 and Remark 2.11. The argument here uses
`Matrix.lie_quantumMinor` and the vanishing of minors with repeated rows or columns.
-/

public section

namespace Matrix

attribute [local instance 100] LieRing.ofAssociativeRing

variable {ι K A : Type*} [DecidableEq ι] [CommRing K] [Ring A] [Algebra K A] {n m : ℕ}

/-- A principal quantum minor commutes with entries in its block and in the complementary
block. Taking `a = id` gives centrality against each entry for the full quantum determinant. -/
theorem commute_quantumMinor_self (E : Matrix ι ι A) (hE : E.HasMatrixUnitLieRelations)
    (u : K) (a : Fin n → ι) {p q : ι} (h : p ∈ Set.range a ↔ q ∈ Set.range a) :
    Commute (E p q) (E.quantumMinor u a a) := by
  refine commute_iff_lie_eq.mpr ?_
  have hbracket := hasMatrixUnitLieRelations_iff.mp hE
  have hr (i j : Fin n) : ⁅E p q, E (a i) (a j)⁆ =
      (if q = a i then E p (a j) else 0) - (if p = a j then E (a i) q else 0) := by
    simpa only [Ring.lie_def, eq_comm (a := p)] using hbracket p q (a i) (a j)
  by_cases hpq : p = q
  · subst q
    exact E.lie_diagonal_quantumMinor_self u a hr
  rw [E.lie_quantumMinor u a a hr]
  have hcollision {i j : Fin n} {s t : ι} (hi : a i = s) (hj : a j = t) (hst : s ≠ t) :
      ¬ Function.Injective (Function.update a i t) := by
    have hji : j ≠ i := fun e ↦ hst (hi.symm.trans (e ▸ hj))
    intro hinj
    exact hji ((hinj (by simp [hji, hj])).symm)
  have hl : (∑ i, if q = a i then E.quantumMinor u (Function.update a i p) a else 0) = 0 := by
    refine Finset.sum_eq_zero fun i _ ↦ ?_
    split_ifs with hi
    · obtain ⟨j, hj⟩ := h.mpr ⟨i, hi.symm⟩
      exact E.quantumMinor_eq_zero_of_not_injective_left u _ _ (hcollision hi.symm hj (Ne.symm hpq))
    · rfl
  have hc : (∑ j, if p = a j then E.quantumMinor u a (Function.update a j q) else 0) = 0 := by
    refine Finset.sum_eq_zero fun j _ ↦ ?_
    split_ifs with hj
    · obtain ⟨i, hi⟩ := h.mp ⟨j, hj.symm⟩
      exact E.quantumMinor_eq_zero_of_not_injective_right hE u _ _ (hcollision hj.symm hi hpq)
    · rfl
  rw [hl, hc, sub_self]

/-- The value of a principal quantum determinant commutes with that of any principal minor
whose indices lie in the determinant's block. The spectral parameters are independent. -/
theorem commute_quantumMinor_self_of_range_subset (E : Matrix ι ι A)
    (hE : E.HasMatrixUnitLieRelations) (u v : K) (a : Fin n → ι) (b : Fin m → ι)
    (h : Set.range b ⊆ Set.range a) : Commute (E.quantumMinor u a a) (E.quantumMinor v b b) := by
  have hm : E.quantumMinor v b b ∈ Subalgebra.centralizer K {E.quantumMinor u a a} := by
    apply E.quantumMinor_mem_subalgebra
    intro i j
    rw [Subalgebra.mem_centralizer_iff]
    intro z hz
    rw [Set.mem_singleton_iff.mp hz]
    exact (E.commute_quantumMinor_self hE u a
      (iff_of_true (h (Set.mem_range_self i)) (h (Set.mem_range_self j)))).symm.eq
  rw [Subalgebra.mem_centralizer_iff] at hm
  exact hm _ (Set.mem_singleton _)

end Matrix
