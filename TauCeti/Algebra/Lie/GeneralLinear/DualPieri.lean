module

public import Mathlib.Algebra.Lie.TensorProduct
public import TauCeti.Algebra.Lie.GeneralLinear.Isotypic
public import TauCeti.Algebra.Lie.GeneralLinear.Standard
-- Non-public: these declarations appear only inside proofs.
import TauCeti.Algebra.Lie.GeneralLinear.CompleteReducibility

/-!
# Highest weight vectors in the dual standard module tensored with a module

Let `V = n → R` be the standard module of `gl n R` and `V* = Module.Dual R V` its dual, with dual
basis functionals `fₛ = LinearMap.proj s` of weight `-εₛ`. Every vector of `V* ⊗ M` is uniquely
`∑ₛ fₛ ⊗ wₛ`, and the matrix unit `Eᵢⱼ` sends `fₛ` to `-δᵢₛ fⱼ`, so the `s`-th coefficient of
`Eᵢⱼ · x` is `Eᵢⱼ · wₛ - δⱼₛ wᵢ`. For a highest weight vector `x` of weight `ν` this says that `wₛ`
has weight `ν + εₛ` and that the raising operators act on the coefficients by `Eᵢⱼ wₛ = δⱼₛ wᵢ`.
At the least index `t` with `wₜ ≠ 0` the right-hand side vanishes, so `wₜ` is a highest weight
vector of `M` of weight `ν + εₜ`
(`TauCeti.exists_isGlHighestWeightVector_add_single_of_dual_tensor`).

For `M = L(μ)` the named irreducible of a dominant weight `μ`, whose only highest weight vectors
are the multiples of its generator, this pins the highest weights of `V* ⊗ L(μ)` to the tuples
`μ - εₜ`, and the least nonzero coefficient of a highest weight vector of weight `μ - εₜ` sits at
index `t`, where it is a multiple of the generator. Two such vectors therefore have a combination
whose coefficients vanish up to index `t`, and which is consequently zero. So every highest weight
space of `V* ⊗ L(μ)` has dimension at most one. Since `L(ν)` is generated by a highest weight
vector of weight `ν`, the multiplicity of `L(ν)` in `V* ⊗ L(μ)` is at most one, and it vanishes
unless `ν = μ - εₜ` for some `t`. For `t` the last index, `f_last ⊗ g` is a highest weight vector of
weight `μ - ε_last`, and the identity matrix acts on `V* ⊗ L(μ)` by a scalar, so `V* ⊗ L(μ)` is
completely reducible and `L(μ - ε_last)` occurs exactly once.

These are the multiplicity-freeness and the constraint on the constituents in the dual standard
Pieri rule `V* ⊗ L(μ) ≅ ⨁ₜ L(μ - εₜ)`, the sum over those `t` for which `μ - εₜ` is dominant. That
every such `L(μ - εₜ)` does occur is proved here only for the last index.

## Main results

* `TauCeti.exists_isGlHighestWeightVector_add_single_of_dual_tensor`: a highest weight vector of
  weight `ν` in `V* ⊗ M` yields a highest weight vector of weight `ν + εₜ` in `M`, for some `t`.
* `TauCeti.exists_eq_sub_single_of_isGlHighestWeightVector_dual_tensor_glIrreducible`: every
  highest weight of `V* ⊗ L(μ)` is `μ - εₜ` for some `t`.
* `TauCeti.exists_eq_smul_of_isGlHighestWeightVector_dual_tensor_glIrreducible`: two highest weight
  vectors of the same weight in `V* ⊗ L(μ)` are proportional.
* `TauCeti.isGlHighestWeightVector_proj_tmul`: the dual basis functional at the greatest index
  tensored with a highest weight vector of weight `λ` is a highest weight vector of weight
  `λ - ε_last`.
* `TauCeti.isotypicMultiplicity_dual_tensor_glIrreducible_le_one`: `V* ⊗ L(μ)` is multiplicity
  free.
* `TauCeti.isotypicMultiplicity_dual_tensor_glIrreducible_eq_zero`: `L(ν)` does not occur in
  `V* ⊗ L(μ)` unless `ν = μ - εₜ` for some `t`.
* `TauCeti.isotypicMultiplicity_dual_tensor_glIrreducible_sub_single_last`: `L(μ - ε_last)` occurs
  in `V* ⊗ L(μ)` exactly once.

## References

* W. Fulton, J. Harris, *Representation Theory: A First Course*, Springer GTM 129 (1991), §15.3,
  for Pieri's formula.
-/

public section

namespace TauCeti

open _root_.LieModule Matrix Module TensorProduct

attribute [local instance 100] LieRing.ofAssociativeRing

universe u

/-! ### Coefficients along the dual basis -/

section CommRing

variable {R : Type*} [CommRing R] {n : Type*} [DecidableEq n] [Fintype n]
variable {M : Type*} [AddCommGroup M] [Module R M]

/-- The coefficient of a vector of `V* ⊗ M` at the dual basis functional `fₜ`: the `t`-th
coordinate of `TensorProduct.equivFinsuppOfBasisLeft` for the dual basis of the standard basis. -/
private noncomputable def dualCoeff (t : n) : Dual R (n → R) ⊗[R] M →ₗ[R] M :=
  (Finsupp.lapply t).comp
    (TensorProduct.equivFinsuppOfBasisLeft (Pi.basisFun R n).dualBasis).toLinearMap

private theorem dualCoeff_tmul (t : n) (f : Dual R (n → R)) (m : M) :
    dualCoeff t (f ⊗ₜ m) = f (Pi.single t 1) • m := by
  simp [dualCoeff]

/-- A vector of `V* ⊗ M` all of whose coefficients vanish is zero. -/
private theorem eq_zero_of_forall_dualCoeff_eq_zero {x : Dual R (n → R) ⊗[R] M}
    (h : ∀ t, dualCoeff t x = 0) : x = 0 :=
  (TensorProduct.equivFinsuppOfBasisLeft (Pi.basisFun R n).dualBasis).map_eq_zero_iff.mp
    (Finsupp.ext h)

variable [LieRingModule (Matrix n n R) M] [LieModule R (Matrix n n R) M]

/-- **The coefficients of a bracket with a matrix unit.** The `s`-th coefficient of `Eᵢⱼ · x` is
`Eᵢⱼ · wₛ - δⱼₛ wᵢ`, where `wₛ` are the coefficients of `x`. -/
private theorem dualCoeff_lie_single (i j s : n) (x : Dual R (n → R) ⊗[R] M) :
    dualCoeff s ⁅(single i j 1 : Matrix n n R), x⁆ =
      ⁅(single i j 1 : Matrix n n R), dualCoeff s x⁆ - if j = s then dualCoeff i x else 0 := by
  induction x using TensorProduct.inductionOn with
  | tmul f m =>
    rw [LieModule.lie_tmul_right, map_add, dualCoeff_tmul, dualCoeff_tmul, dualCoeff_tmul,
      dualCoeff_tmul, Module.Dual.lie_apply, lie_single_one_pi, lie_smul]
    by_cases h : j = s
    · subst h
      simp [neg_smul, sub_eq_neg_add]
    · simp [h]
  | add x y hx hy =>
    rw [lie_add (L := Matrix n n R) (M := Dual R (n → R) ⊗[R] M), map_add, hx, hy]
    simp only [map_add, lie_add]
    split_ifs <;> abel

variable [LinearOrder n] {nu : n → R} {x : Dual R (n → R) ⊗[R] M}

/-- The coefficients of a highest weight vector of weight `ν` of `V* ⊗ M` are killed by the raising
operators up to the shift `Eᵢⱼ wₛ = δⱼₛ wᵢ`. -/
private theorem lie_single_dualCoeff_of_isGlHighestWeightVector (hx : IsGlHighestWeightVector nu x)
    {i j : n} (hij : i < j) (s : n) :
    ⁅(single i j 1 : Matrix n n R), dualCoeff s x⁆ = if j = s then dualCoeff i x else 0 := by
  have h := dualCoeff_lie_single i j s x
  rw [hx.lie_single_eq_zero hij, map_zero, eq_comm, sub_eq_zero] at h
  exact h

/-- The `s`-th coefficient of a highest weight vector of weight `ν` of `V* ⊗ M` has weight
`ν + εₛ`. -/
private theorem lie_single_self_dualCoeff_of_isGlHighestWeightVector
    (hx : IsGlHighestWeightVector nu x) (i s : n) :
    ⁅(single i i 1 : Matrix n n R), dualCoeff s x⁆ =
      (nu + Pi.single s 1 : n → R) i • dualCoeff s x := by
  have h := dualCoeff_lie_single i i s x
  rw [hx.lie_single_self_eq_smul i, map_smul, eq_comm, sub_eq_iff_eq_add] at h
  rw [h, Pi.add_apply, add_smul]
  by_cases his : i = s
  · subst his
    simp
  · simp [his]

/-- **The least nonzero coefficient of a highest weight vector is a highest weight vector.** If the
coefficients of a highest weight vector `x` of weight `ν` of `V* ⊗ M` vanish below `t` and not at
`t`, then the coefficient at `t` is a highest weight vector of `M` of weight `ν + εₜ`. -/
private theorem isGlHighestWeightVector_dualCoeff (hx : IsGlHighestWeightVector nu x) {t : n}
    (hlt : ∀ s < t, dualCoeff s x = 0) (ht : dualCoeff t x ≠ 0) :
    IsGlHighestWeightVector (nu + Pi.single t 1) (dualCoeff t x) := by
  refine isGlHighestWeightVector_iff.mpr ⟨ht, fun i =>
    lie_single_self_dualCoeff_of_isGlHighestWeightVector hx i t, fun i j hij => ?_⟩
  rw [lie_single_dualCoeff_of_isGlHighestWeightVector hx hij]
  split_ifs with hjt
  · exact hlt i (hjt ▸ hij)
  · rfl

omit [LieRingModule (Matrix n n R) M] [LieModule R (Matrix n n R) M] in
/-- A nonzero vector of `V* ⊗ M` has a least index with a nonzero coefficient. -/
private theorem exists_dualCoeff_ne_zero_forall_lt (hx : x ≠ 0) :
    ∃ t, dualCoeff t x ≠ 0 ∧ ∀ s < t, dualCoeff s x = 0 := by
  have hex : ∃ t, dualCoeff t x ≠ 0 := by
    by_contra h
    push Not at h
    exact hx (eq_zero_of_forall_dualCoeff_eq_zero h)
  obtain ⟨t, ht, hmin⟩ := WellFounded.has_min wellFounded_lt {t | dualCoeff t x ≠ 0} hex
  exact ⟨t, ht, fun s hs => by_contra fun h => hmin s h hs⟩

/-- **The highest weights of `V* ⊗ M`.** A highest weight vector of weight `ν` in `V* ⊗ M` yields
a highest weight vector of `M` of weight `ν + εₜ` for some index `t`: its coefficient at the least
index where it is nonzero. -/
theorem exists_isGlHighestWeightVector_add_single_of_dual_tensor
    (hx : IsGlHighestWeightVector nu x) :
    ∃ (t : n) (w : M), IsGlHighestWeightVector (nu + Pi.single t 1) w := by
  obtain ⟨t, ht, hlt⟩ := exists_dualCoeff_ne_zero_forall_lt hx.ne_zero
  exact ⟨t, _, isGlHighestWeightVector_dualCoeff hx hlt ht⟩

/-- A nonzero combination `y - c • x` of two highest weight vectors of the same weight is again a
highest weight vector of that weight. -/
private theorem isGlHighestWeightVector_sub_smul {P : Type*} [AddCommGroup P] [Module R P]
    [LieRingModule (Matrix n n R) P] [LieModule R (Matrix n n R) P] {x y : P} {c : R}
    (hx : IsGlHighestWeightVector nu x) (hy : IsGlHighestWeightVector nu y) (h : y - c • x ≠ 0) :
    IsGlHighestWeightVector nu (y - c • x) := by
  refine isGlHighestWeightVector_iff.mpr ⟨h, fun i => ?_, fun i j hij => ?_⟩
  · rw [lie_sub, lie_smul, hx.lie_single_self_eq_smul, hy.lie_single_self_eq_smul, smul_sub,
      smul_comm]
  · rw [lie_sub, lie_smul, hx.lie_single_eq_zero hij, hy.lie_single_eq_zero hij, smul_zero,
      sub_zero]

/-- **The dual basis functional at the top index tensored with a highest weight vector** is a
highest weight vector, of weight `λ - εₜ`: the functional at the greatest index `t` is a highest
weight vector of weight `-εₜ` of `V*`. -/
theorem isGlHighestWeightVector_proj_tmul {t : n} (ht : ∀ i, i ≤ t) {lam : n → R} {w : M}
    (hw : IsGlHighestWeightVector lam w) :
    IsGlHighestWeightVector (lam - Pi.single t 1)
      ((LinearMap.proj t : Dual R (n → R)) ⊗ₜ[R] w) := by
  refine isGlHighestWeightVector_iff.mpr ⟨fun h => hw.ne_zero ?_, fun i => ?_, fun i j hij => ?_⟩
  · simpa [dualCoeff_tmul] using congrArg (dualCoeff t) h
  · rw [LieModule.lie_tmul_right, lie_single_self_proj, hw.lie_single_self_eq_smul,
      ← smul_tmul', tmul_smul, ← add_smul, Pi.sub_apply, Pi.neg_apply, neg_add_eq_sub]
  · simp [(hij.trans_le (ht j)).ne, hw.lie_single_eq_zero hij]

end CommRing

/-! ### The tensor product of the dual standard module with `L(μ)` -/

section Carrier

variable {K : Type u} [Field K] [CharZero K] {N : ℕ} {mu nu : Fin N → K}

/-- **The highest weights of `V* ⊗ L(μ)`.** Every highest weight vector of the dual standard
module tensored with `L(μ)` has weight `μ - εₜ` for some index `t`. -/
theorem exists_eq_sub_single_of_isGlHighestWeightVector_dual_tensor_glIrreducible
    (hmu : IsGlDominantIntegral mu) {x : Dual K (Fin N → K) ⊗[K] glIrreducible N mu}
    (hx : IsGlHighestWeightVector nu x) : ∃ t, nu = mu - Pi.single t 1 := by
  obtain ⟨t, w, hw⟩ := exists_isGlHighestWeightVector_add_single_of_dual_tensor hx
  exact ⟨t, eq_sub_of_add_eq (weight_eq_of_isGlHighestWeightVector_glIrreducible hmu hw)⟩

/-- For a highest weight vector `z` of weight `ν` of `V* ⊗ L(μ)` with `ν + εₜ = μ`, the least index
with a nonzero coefficient is `t`. -/
private theorem dualCoeff_eq_zero_of_lt (hmu : IsGlDominantIntegral mu)
    {z : Dual K (Fin N → K) ⊗[K] glIrreducible N mu} (hz : IsGlHighestWeightVector nu z) {t : Fin N}
    (ht : nu + Pi.single t 1 = mu) : (∀ s < t, dualCoeff s z = 0) ∧ dualCoeff t z ≠ 0 := by
  obtain ⟨t', ht', hlt'⟩ := exists_dualCoeff_ne_zero_forall_lt hz.ne_zero
  have hsingle : (Pi.single t' 1 : Fin N → K) = Pi.single t 1 := add_left_cancel
    ((weight_eq_of_isGlHighestWeightVector_glIrreducible hmu
      (isGlHighestWeightVector_dualCoeff hz hlt' ht')).trans ht.symm)
  have htt : t' = t := by
    by_contra hne
    simpa [Pi.single_eq_of_ne hne] using congrFun hsingle t'
  subst htt
  exact ⟨hlt', ht'⟩

/-- **The highest weight spaces of `V* ⊗ L(μ)` are lines.** Two highest weight vectors of the same
weight in the dual standard module tensored with `L(μ)` are proportional. -/
theorem exists_eq_smul_of_isGlHighestWeightVector_dual_tensor_glIrreducible
    (hmu : IsGlDominantIntegral mu) {x y : Dual K (Fin N → K) ⊗[K] glIrreducible N mu}
    (hx : IsGlHighestWeightVector nu x) (hy : IsGlHighestWeightVector nu y) :
    ∃ c : K, y = c • x := by
  obtain ⟨t, hxt, hxlt⟩ := exists_dualCoeff_ne_zero_forall_lt hx.ne_zero
  have ht : nu + Pi.single t 1 = mu := weight_eq_of_isGlHighestWeightVector_glIrreducible hmu
    (isGlHighestWeightVector_dualCoeff hx hxlt hxt)
  have hg := isGlHighestWeightVector_glIrreducibleGenerator hmu
  -- The coefficients at `t` are vectors of weight `μ` of `L(μ)`, so multiples of its generator.
  have hcoeff (z : Dual K (Fin N → K) ⊗[K] glIrreducible N mu)
      (hz : IsGlHighestWeightVector nu z) :
      ∃ c : K, dualCoeff t z = c • glIrreducibleGenerator N mu :=
    exists_eq_smul_of_isGlHighestWeightVector_of_mem_lieSpan hg
      (by rw [lieSpan_glIrreducibleGenerator_eq_top hmu]; exact LieSubmodule.mem_top _)
      fun i => ht ▸ lie_single_self_dualCoeff_of_isGlHighestWeightVector hz i t
  obtain ⟨a, ha⟩ := hcoeff x hx
  obtain ⟨b, hb⟩ := hcoeff y hy
  have ha0 : a ≠ 0 := by
    rintro rfl
    exact hxt (by rw [ha, zero_smul])
  refine ⟨b / a, ?_⟩
  -- The combination `y - (b / a) • x` has vanishing coefficients up to `t`, so it is zero.
  by_contra hne
  have hz := isGlHighestWeightVector_sub_smul hx hy (sub_ne_zero.mpr hne)
  refine (dualCoeff_eq_zero_of_lt hmu hz ht).2 ?_
  rw [map_sub, map_smul, ha, hb, smul_smul, div_mul_cancel₀ b ha0, sub_self]

/-- A morphism out of `L(ν)` vanishing at the generator is zero. -/
private theorem eq_zero_of_apply_glIrreducibleGenerator_eq_zero (hnu : IsGlDominantIntegral nu)
    {P : Type*} [AddCommGroup P] [Module K P] [LieRingModule (Matrix (Fin N) (Fin N) K) P]
    (φ : glIrreducible N nu →ₗ⁅K,Matrix (Fin N) (Fin N) K⁆ P)
    (h : φ (glIrreducibleGenerator N nu) = 0) : φ = 0 :=
  lieModuleHom_ext_glIrreducible hnu (by rw [h, _root_.zero_apply])

/-- Every morphism `L(ν) → V* ⊗ L(μ)` is a multiple of any nonzero one. -/
private theorem exists_smul_eq_of_ne_zero (hmu : IsGlDominantIntegral mu)
    (hnu : IsGlDominantIntegral nu)
    {φ : glIrreducible N nu →ₗ⁅K,Matrix (Fin N) (Fin N) K⁆
      Dual K (Fin N → K) ⊗[K] glIrreducible N mu} (hφ : φ ≠ 0)
    (ψ : glIrreducible N nu →ₗ⁅K,Matrix (Fin N) (Fin N) K⁆
      Dual K (Fin N → K) ⊗[K] glIrreducible N mu) : ∃ c : K, c • φ = ψ := by
  have hg := isGlHighestWeightVector_glIrreducibleGenerator hnu
  by_cases hψ : ψ (glIrreducibleGenerator N nu) = 0
  · refine ⟨0, ?_⟩
    rw [eq_zero_of_apply_glIrreducibleGenerator_eq_zero hnu ψ hψ]
    ext m
    simp
  obtain ⟨c, hc⟩ := exists_eq_smul_of_isGlHighestWeightVector_dual_tensor_glIrreducible hmu
    (hg.map φ fun h0 => hφ (eq_zero_of_apply_glIrreducibleGenerator_eq_zero hnu φ h0))
    (hg.map ψ hψ)
  refine ⟨c, (sub_eq_zero.mp
    (eq_zero_of_apply_glIrreducibleGenerator_eq_zero hnu (ψ - c • φ) ?_)).symm⟩
  simp [hc]

/-- **The dual standard module tensored with `L(μ)` is multiplicity free**: for dominant `μ` and
`ν`, the irreducible `L(ν)` occurs in `V* ⊗ L(μ)` at most once. -/
theorem isotypicMultiplicity_dual_tensor_glIrreducible_le_one (hmu : IsGlDominantIntegral mu)
    (hnu : IsGlDominantIntegral nu) :
    isotypicMultiplicity K (Matrix (Fin N) (Fin N) K)
      (Dual K (Fin N → K) ⊗[K] glIrreducible N mu) (glIrreducible N nu) ≤ 1 := by
  rw [isotypicMultiplicity_def]
  by_cases h : ∀ φ : glIrreducible N nu →ₗ⁅K,Matrix (Fin N) (Fin N) K⁆
      Dual K (Fin N → K) ⊗[K] glIrreducible N mu, φ = 0
  · have : Subsingleton (glIrreducible N nu →ₗ⁅K,Matrix (Fin N) (Fin N) K⁆
        Dual K (Fin N → K) ⊗[K] glIrreducible N mu) := ⟨fun a b => (h a).trans (h b).symm⟩
    rw [finrank_zero_of_subsingleton]
    exact zero_le_one
  push Not at h
  obtain ⟨φ, hφ⟩ := h
  exact finrank_le_one φ (exists_smul_eq_of_ne_zero hmu hnu hφ)

/-- **The constituents of `V* ⊗ L(μ)`**: for dominant `μ` and `ν`, the irreducible `L(ν)` does not
occur in the dual standard module tensored with `L(μ)` unless `ν = μ - εₜ` for some `t`. -/
theorem isotypicMultiplicity_dual_tensor_glIrreducible_eq_zero (hmu : IsGlDominantIntegral mu)
    (hnu : IsGlDominantIntegral nu) (h : ∀ t, nu ≠ mu - Pi.single t 1) :
    isotypicMultiplicity K (Matrix (Fin N) (Fin N) K)
      (Dual K (Fin N → K) ⊗[K] glIrreducible N mu) (glIrreducible N nu) = 0 := by
  rw [isotypicMultiplicity_def]
  have : Subsingleton (glIrreducible N nu →ₗ⁅K,Matrix (Fin N) (Fin N) K⁆
      Dual K (Fin N → K) ⊗[K] glIrreducible N mu) := by
    refine ⟨fun φ ψ => ?_⟩
    have hzero (χ : glIrreducible N nu →ₗ⁅K,Matrix (Fin N) (Fin N) K⁆
        Dual K (Fin N → K) ⊗[K] glIrreducible N mu) : χ = 0 := by
      by_contra hχ
      obtain ⟨t, ht⟩ := exists_eq_sub_single_of_isGlHighestWeightVector_dual_tensor_glIrreducible
        hmu ((isGlHighestWeightVector_glIrreducibleGenerator hnu).map χ fun h0 =>
          hχ (eq_zero_of_apply_glIrreducibleGenerator_eq_zero hnu χ h0))
      exact h t ht
    rw [hzero φ, hzero ψ]
  exact finrank_zero_of_subsingleton

/-- The identity matrix acts on `V* ⊗ L(μ)` by the scalar `∑ i, μ i - 1`. -/
private theorem one_lie_dual_tensor_glIrreducible (hmu : IsGlDominantIntegral mu)
    (x : Dual K (Fin N → K) ⊗[K] glIrreducible N mu) :
    ⁅(1 : Matrix (Fin N) (Fin N) K), x⁆ = (∑ i, mu i - 1) • x := by
  induction x using TensorProduct.inductionOn with
  | tmul f m =>
    rw [LieModule.lie_tmul_right, Module.Dual.one_lie_pi, one_lie_glIrreducible_eq_smul hmu,
      tmul_smul, neg_tmul]
    module
  | add x y hx hy =>
    rw [lie_add (L := Matrix (Fin N) (Fin N) K)
      (M := Dual K (Fin N → K) ⊗[K] glIrreducible N mu), hx, hy, smul_add]

/-- **`L(μ - ε_last)` occurs in `V* ⊗ L(μ)` exactly once**: `f_last ⊗ g` is a highest weight vector
of that weight, and the identity matrix acts on `V* ⊗ L(μ)` by a scalar, so this vector generates a
copy of `L(μ - ε_last)`. -/
theorem isotypicMultiplicity_dual_tensor_glIrreducible_sub_single_last {mu : Fin (N + 1) → K}
    (hmu : IsGlDominantIntegral mu) :
    isotypicMultiplicity K (Matrix (Fin (N + 1)) (Fin (N + 1)) K)
      (Dual K (Fin (N + 1) → K) ⊗[K] glIrreducible (N + 1) mu)
      (glIrreducible (N + 1) (mu - Pi.single (Fin.last N) 1)) = 1 := by
  have hnu : IsGlDominantIntegral (mu - Pi.single (Fin.last N) (1 : K)) := by
    simpa [sub_eq_add_neg] using hmu.add (isGlDominantIntegral_neg_pi_single_last (R := K) N)
  have _ := complementedLattice_lieSubmodule_gl_of_forall_one_lie_eq_smul K (Fin (N + 1))
    (Dual K (Fin (N + 1) → K) ⊗[K] glIrreducible (N + 1) mu)
    (one_lie_dual_tensor_glIrreducible hmu)
  obtain ⟨φ, hφ⟩ := exists_lieModuleHom_glIrreducible_apply_eq hnu
    (isGlHighestWeightVector_proj_tmul Fin.le_last
      (isGlHighestWeightVector_glIrreducibleGenerator hmu))
  have hφ0 : φ ≠ 0 := by
    rintro rfl
    exact (isGlHighestWeightVector_proj_tmul Fin.le_last
      (isGlHighestWeightVector_glIrreducibleGenerator hmu)).ne_zero hφ.symm
  rw [isotypicMultiplicity_def]
  exact (finrank_eq_one_iff_of_nonzero' φ hφ0).mpr (exists_smul_eq_of_ne_zero hmu hnu hφ0)

end Carrier

end TauCeti
