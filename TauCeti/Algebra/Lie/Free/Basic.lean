module

public import Mathlib.Algebra.Lie.Free
import Mathlib.Data.Fin.Tuple.Reflection
import TauCeti.Algebra.Lie.Hom

/-!
# Basic API for free Lie algebras

General results on `FreeLieAlgebra R X` complementing Mathlib's universal property:

* `TauCeti.FreeLieAlgebra.lieSpan_range_of_eq_top`: the generators of a free Lie algebra generate
  it as a Lie subalgebra.
* `TauCeti.FreeLieAlgebra.comp_lift`: composing the lift of a family with a Lie homomorphism
  lifts the composed family; `TauCeti.FreeLieAlgebra.comp_lift_pair` is its form for a pair.
* `TauCeti.FreeLieAlgebra.range_lift_eq_lieSpan`: the range of a homomorphism out of a free Lie
  algebra is the Lie subalgebra generated by the images of the generators.
* `TauCeti.FreeLieAlgebra.freeNeg`: the involutive Lie automorphism of `FreeLieAlgebra R X`
  negating every generator.
-/

public section

namespace TauCeti

namespace FreeLieAlgebra

section

variable (R : Type*) [CommRing R] (X : Type*)

/-- The generators of a free Lie algebra generate it as a Lie subalgebra. -/
theorem lieSpan_range_of_eq_top :
    LieSubalgebra.lieSpan R (FreeLieAlgebra R X) (Set.range (FreeLieAlgebra.of R)) = ⊤ := by
  set K := LieSubalgebra.lieSpan R (FreeLieAlgebra R X) (Set.range (FreeLieAlgebra.of R))
  have hmem (x : X) : FreeLieAlgebra.of R x ∈ K :=
    LieSubalgebra.subset_lieSpan (Set.mem_range_self x)
  set g : FreeLieAlgebra R X →ₗ⁅R⁆ K := FreeLieAlgebra.lift R fun x => ⟨_, hmem x⟩ with hg
  have hid : K.incl.comp g = LieHom.id := by
    refine FreeLieAlgebra.hom_ext fun x => ?_
    simp [hg, LieHom.comp_apply, FreeLieAlgebra.lift_of_apply]
  refine eq_top_iff.2 fun y _ => ?_
  have hy : K.incl (g y) = y :=
    congrArg (fun F : FreeLieAlgebra R X →ₗ⁅R⁆ FreeLieAlgebra R X => F y) hid
  exact hy ▸ (g y).property

variable {R X} in
/-- Composing the lift of a family with a Lie homomorphism lifts the composed family. -/
theorem comp_lift {L L' : Type*} [LieRing L] [LieAlgebra R L] [LieRing L'] [LieAlgebra R L']
    (F : L →ₗ⁅R⁆ L') (v : X → L) :
    F.comp (_root_.FreeLieAlgebra.lift R v) = _root_.FreeLieAlgebra.lift R (F ∘ v) :=
  _root_.FreeLieAlgebra.hom_ext fun x => by simp

variable {R} in
/-- Composing the lift of a pair with a Lie homomorphism lifts the image pair. -/
theorem comp_lift_pair {L L' : Type*} [LieRing L] [LieAlgebra R L] [LieRing L'] [LieAlgebra R L']
    (F : L →ₗ⁅R⁆ L') (x y : L) :
    F.comp (_root_.FreeLieAlgebra.lift R ![x, y]) = _root_.FreeLieAlgebra.lift R ![F x, F y] := by
  rw [comp_lift, ← FinVec.map_eq]
  rfl

/-- The involutive Lie automorphism of `FreeLieAlgebra R X` negating every generator. -/
noncomputable def freeNeg :
    _root_.FreeLieAlgebra R X ≃ₗ⁅R⁆ _root_.FreeLieAlgebra R X :=
  let f : _root_.FreeLieAlgebra R X →ₗ⁅R⁆ _root_.FreeLieAlgebra R X :=
    _root_.FreeLieAlgebra.lift R fun i => -_root_.FreeLieAlgebra.of R i
  have hf : f.comp f = LieHom.id := _root_.FreeLieAlgebra.hom_ext fun i => by simp [f]
  LieEquiv.ofLieHoms f f hf hf

/-- `TauCeti.FreeLieAlgebra.freeNeg` is its own inverse. -/
@[simp]
theorem freeNeg_symm : (freeNeg R X).symm = freeNeg R X :=
  LieEquiv.symm_ofLieHoms _ _ _ _

/-- `TauCeti.FreeLieAlgebra.freeNeg` is involutive. -/
theorem freeNeg_involutive : Function.Involutive (freeNeg R X) := fun x => by
  simpa using (freeNeg R X).symm_apply_apply x

end

/-- `TauCeti.FreeLieAlgebra.freeNeg` negates each free generator. -/
@[simp]
theorem freeNeg_of {R : Type*} [CommRing R] {X : Type*} (i : X) :
    freeNeg R X (_root_.FreeLieAlgebra.of R i) = -_root_.FreeLieAlgebra.of R i := by
  simp [freeNeg]

/-- Applying `TauCeti.FreeLieAlgebra.freeNeg` twice is the identity. -/
@[simp]
theorem freeNeg_apply_apply {R X : Type*} [CommRing R] (x : _root_.FreeLieAlgebra R X) :
    freeNeg R X (freeNeg R X x) = x :=
  freeNeg_involutive R X x

/-- The range of `FreeLieAlgebra.lift R E` is the Lie subalgebra generated by the range of `E`. -/
theorem range_lift_eq_lieSpan {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    {I : Type*} (E : I → L) :
    (_root_.FreeLieAlgebra.lift R E).range = LieSubalgebra.lieSpan R L (Set.range E) := by
  have hcomp : ⇑(_root_.FreeLieAlgebra.lift R E) ∘ _root_.FreeLieAlgebra.of R = E :=
    funext (_root_.FreeLieAlgebra.lift_of_apply E)
  rw [LieHom.range_eq_map, ← lieSpan_range_of_eq_top, LieSubalgebra.map_lieSpan,
    ← Set.range_comp, hcomp]

end FreeLieAlgebra

end TauCeti
