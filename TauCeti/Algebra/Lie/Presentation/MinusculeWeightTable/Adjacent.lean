/-!
# Adjacent root strings and Heisenberg subgroups from a minuscule weight table

Let `T` be a minuscule weight table and `i`, `j` two nodes with
`T.cartanMatrix i j = T.cartanMatrix j i = -1`, and write `Eᵢ` and `Eⱼ` for the raising matrices
`T.raisingMatrix i` and `T.raisingMatrix j` cast into a commutative ring `R`. The raising strings
through such a pair have length at most two, `Eᵢ Eⱼ Eᵢ = 0`, so the commutator matrix
`[Eᵢ, Eⱼ] = Eᵢ Eⱼ - Eⱼ Eᵢ` annihilates `Eᵢ` and `Eⱼ` on both sides and squares to zero, and the
unipotent elements `1 + s • Eᵢ` and `1 + t • Eⱼ` satisfy the adjacent case of the Chevalley
commutator formula

  `(1 + s • Eᵢ) (1 + t • Eⱼ) (1 - s • Eᵢ) (1 - t • Eⱼ) = 1 + (s * t) • [Eᵢ, Eⱼ]`.

When some weight has coordinate `-1` at `i`, the commutator matrix has an entry equal to `1` or
`-1`, and the Heisenberg matrix parametrization
`(x, y, z) ↦ 1 + x • Eᵢ + y • Eⱼ + (x * y) • Eⱼ Eᵢ + z • [Eᵢ, Eⱼ]` is an injective
multiplicative map from `TauCeti.HeisenbergGroup R` to `Matrix ι ι R`, in every characteristic.

The second half transports this to a subgroup `G` of `GL ι R` carrying two one-parameter
subgroups `x y : Multiplicative R →* G` whose matrices are `1 + t • Eᵢ` and `1 + t • Eⱼ`. The
commutator `⁅x(s), y(t)⁆` depends only on `s * t`, the subgroup generated by `x` and `y` is a copy
of the Heisenberg group through `(x, y, z) ↦ y(y) x(x) ⁅x(z), y(1)⁆`, and the central parameter
`z ↦ ⁅x(z), y(1)⁆` is faithful. Carriers built from a weight table instantiate `G` with their
points and `x`, `y` with their simple-root subgroups, the table being `T` for positive roots and
`T.negWeights` for negative roots; see `TauCeti.Algebra.Lie.E7.Minuscule.Adjacent`.

## Main definitions

* `MonoidHom.adjacentRootCommutator`: the commutator `⁅x(t), y(1)⁆` of two one-parameter
  subgroups `x` and `y` of a group.
* `TauCeti.MinusculeWeightTable.raisingCommutatorMatrix`: the commutator `[Eᵢ, Eⱼ]`.
* `TauCeti.MinusculeWeightTable.raisingHeisenbergMatrix`: the Heisenberg matrix parametrization
  `(x, y, z) ↦ 1 + x • Eᵢ + y • Eⱼ + (x * y) • Eⱼ Eᵢ + z • [Eᵢ, Eⱼ]`.
* `TauCeti.MinusculeWeightTable.adjacentHeisenbergHom` and `adjacentRootCommutatorHom`: the
  Heisenberg parametrization `(x, y, z) ↦ y(y) x(x) ⁅x(z), y(1)⁆` of the subgroup
  `x.range ⊔ y.range` generated by `x` and `y`, and its central one-parameter subgroup
  `z ↦ ⁅x(z), y(1)⁆`.
* `TauCeti.MinusculeWeightTable.adjacentHeisenbergEquiv`: the identification of `x.range ⊔ y.range`
  with `TauCeti.HeisenbergGroup R`.

## Main results

* `raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one` (in the
  namespace `TauCeti.MinusculeWeightTable`, like everything below): `Eᵢ Eⱼ Eᵢ = 0`.
* `TauCeti.MinusculeWeightTable.raisingMatrix_mul_raisingCommutatorMatrix_left`, `_right`,
  `raisingCommutatorMatrix_mul_raisingMatrix_left`, `_right` and
  `raisingCommutatorMatrix_mul_self`: `[Eᵢ, Eⱼ]` kills `Eᵢ` and `Eⱼ` on both sides and squares
  to zero.
* `TauCeti.MinusculeWeightTable.exists_raisingCommutatorMatrix_apply_eq_one_or_eq_neg_one`:
  `[Eᵢ, Eⱼ]` has an entry `1` or `-1` when some weight has coordinate `-1` at `i`.
* `one_add_smul_raisingMatrix_mul_eq_one_add_smul_raisingCommutatorMatrix`: the adjacent
  Chevalley commutator formula displayed above.
* `TauCeti.MinusculeWeightTable.raisingHeisenbergMatrix_mul`, `raisingHeisenbergMatrix_eq_mul` and
  `raisingHeisenbergMatrix_injective`: the Heisenberg parametrization is multiplicative, factors
  as `(1 + y • Eⱼ) (1 + x • Eᵢ) (1 + z • [Eᵢ, Eⱼ])`, and is injective when some weight has
  coordinate `-1` at `i`.
* `TauCeti.MinusculeWeightTable.coe_commutatorElement_eq_one_add_smul_raisingCommutatorMatrix`
  and `commutatorElement_eq_adjacentRootCommutator`: `⁅x(s), y(t)⁆` has matrix
  `1 + (s * t) • [Eᵢ, Eⱼ]` and equals `⁅x(s * t), y(1)⁆`.
* `TauCeti.MinusculeWeightTable.coe_adjacentHeisenbergHom`, `adjacentHeisenbergHom_injective` and
  `range_adjacentHeisenbergHom`: the Heisenberg parametrization has matrix
  `raisingHeisenbergMatrix`, is injective, and has range `x.range ⊔ y.range`.
* `TauCeti.MinusculeWeightTable.adjacentRootCommutator_injective`,
  `commute_adjacentRootCommutator_left`, `commute_adjacentRootCommutator_right` and
  `adjacentRootCommutator_swap`: the central parameter is faithful, commutes with `x` and `y`,
  and changes sign when the pair is reversed.

## References

* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.2.2.
* R. Steinberg, *Lectures on Chevalley Groups*, §3.
-/

public section

open scoped commutatorElement
open Multiplicative

/-! ## The commutator of two one-parameter subgroups -/

namespace MonoidHom

variable {R : Type*} [AddMonoid R] [One R] {G : Type*} [Group G] (x y : Multiplicative R →* G)

/-- The commutator `⁅x(t), y(1)⁆` of two one-parameter subgroups `x` and `y`, as a function of
the parameter `t` of the first. For adjacent root subgroups it is the central parameter of the
Heisenberg group they generate. -/
def adjacentRootCommutator (t : R) : G :=
  ⁅x (ofAdd t), y (ofAdd 1)⁆

/-- The commutator formula `⁅x(t), y(1)⁆` defining the central parameter. -/
theorem adjacentRootCommutator_def (t : R) :
    x.adjacentRootCommutator y t = ⁅x (ofAdd t), y (ofAdd 1)⁆ :=
  (rfl)

/-- The central parameter vanishes at `0`. -/
@[simp]
theorem adjacentRootCommutator_zero : x.adjacentRootCommutator y 0 = 1 := by
  rw [adjacentRootCommutator, ofAdd_zero, map_one, commutatorElement_one_left]

end MonoidHom

namespace TauCeti.MinusculeWeightTable

variable {B ι : Type*} (T : MinusculeWeightTable B ι) [Fintype ι] [DecidableEq ι]
  {R : Type*} [CommRing R]

/-! ## Adjacent raising strings -/

/-- An alternating triple of raising operators at nodes joined by a Cartan entry `-1` vanishes:
raising strings through such a pair have length at most two. -/
theorem raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one (i j : B)
    (hij : T.cartanMatrix i j = -1) :
    (T.raisingMatrix i).map (Int.cast : ℤ → R) *
        (T.raisingMatrix j).map (Int.cast : ℤ → R) *
          (T.raisingMatrix i).map (Int.cast : ℤ → R) = 0 := by
  ext a b
  rw [T.mul_raisingMatrix_map_apply, T.mul_raisingMatrix_map_apply]
  by_cases hi : T.weight b i = -1
  · by_cases hj : T.weight (T.reflection i b) j = -1
    · have hlast : T.weight (T.reflection j (T.reflection i b)) i ≠ -1 := by
        rw [T.weight_reflection, T.weight_reflection_self, hi, hj, hij]
        norm_num
      simp [hi, hj, hlast]
    · simp [hi, hj]
  · simp [hi]

omit [Fintype ι] [DecidableEq ι] in
/-- A weight with coordinate `-1` at one end of an edge with Cartan entries `-1` supplies a
two-step raising string: a weight with coordinates `(-1, 0)` or `(0, -1)` at the two nodes. -/
theorem exists_raising_string_of_cartanMatrix_eq_neg_one (i j : B)
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1)
    (hi : ∃ a, T.weight a i = -1) :
    ∃ a, (T.weight a i = -1 ∧ T.weight a j = 0) ∨
      (T.weight a i = 0 ∧ T.weight a j = -1) := by
  obtain ⟨a, ha⟩ := hi
  rcases T.weight_eq_neg_one_or_eq_zero_or_eq_one a j with hj | hj | hj
  · have h := T.weight_eq_neg_one_or_eq_zero_or_eq_one (T.reflection i a) j
    rw [T.weight_reflection, ha, hj, hji] at h
    omega
  · exact ⟨a, Or.inl ⟨ha, hj⟩⟩
  · refine ⟨T.reflection j a, Or.inr ⟨?_, ?_⟩⟩
    · rw [T.weight_reflection, ha, hj, hij]
      norm_num
    · simp [hj]

private theorem raisingMatrix_mul_raisingMatrix_mul_self (i j : B) :
    (T.raisingMatrix i).map (Int.cast : ℤ → R) * (T.raisingMatrix j).map (Int.cast : ℤ → R) *
      (T.raisingMatrix j).map (Int.cast : ℤ → R) = 0 := by
  rw [mul_assoc, T.raisingMatrix_map_mul_self, mul_zero]

/-! ## The commutator matrix -/

/-- The commutator matrix `[Eᵢ, Eⱼ] = Eᵢ Eⱼ - Eⱼ Eᵢ` of the raising matrices at two nodes, cast
into a commutative ring. -/
def raisingCommutatorMatrix (i j : B) : Matrix ι ι R :=
  ⁅(T.raisingMatrix i).map (Int.cast : ℤ → R), (T.raisingMatrix j).map (Int.cast : ℤ → R)⁆

/-- The commutator matrix is the ring commutator `⁅Eᵢ, Eⱼ⁆` of the two cast raising matrices;
`Ring.lie_def` expands it to `Eᵢ Eⱼ - Eⱼ Eᵢ`. -/
theorem raisingCommutatorMatrix_def (i j : B) :
    T.raisingCommutatorMatrix (R := R) i j =
      ⁅(T.raisingMatrix i).map (Int.cast : ℤ → R), (T.raisingMatrix j).map (Int.cast : ℤ → R)⁆ :=
  (rfl)

/-- The raising matrix at `i` kills the commutator matrix `[Eᵢ, Eⱼ]` from the left when
`T.cartanMatrix i j = -1`. -/
theorem raisingMatrix_mul_raisingCommutatorMatrix_left (i j : B)
    (hij : T.cartanMatrix i j = -1) :
    (T.raisingMatrix i).map (Int.cast : ℤ → R) * T.raisingCommutatorMatrix i j = 0 := by
  rw [raisingCommutatorMatrix, Ring.lie_def, mul_sub, ← mul_assoc, ← mul_assoc,
    T.raisingMatrix_map_mul_self,
    T.raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one i j hij,
    zero_mul, sub_zero]

/-- The raising matrix at `j` kills the commutator matrix `[Eᵢ, Eⱼ]` from the left when
`T.cartanMatrix j i = -1`. -/
theorem raisingMatrix_mul_raisingCommutatorMatrix_right (i j : B)
    (hji : T.cartanMatrix j i = -1) :
    (T.raisingMatrix j).map (Int.cast : ℤ → R) * T.raisingCommutatorMatrix i j = 0 := by
  rw [raisingCommutatorMatrix, Ring.lie_def, mul_sub, ← mul_assoc, ← mul_assoc,
    T.raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one j i hji,
    T.raisingMatrix_map_mul_self, zero_mul, sub_zero]

/-- The raising matrix at `i` kills the commutator matrix `[Eᵢ, Eⱼ]` from the right when
`T.cartanMatrix i j = -1`. -/
theorem raisingCommutatorMatrix_mul_raisingMatrix_left (i j : B)
    (hij : T.cartanMatrix i j = -1) :
    T.raisingCommutatorMatrix i j * (T.raisingMatrix i).map (Int.cast : ℤ → R) = 0 := by
  rw [raisingCommutatorMatrix, Ring.lie_def, sub_mul,
    T.raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one i j hij,
    mul_assoc, T.raisingMatrix_map_mul_self, mul_zero, sub_zero]

/-- The raising matrix at `j` kills the commutator matrix `[Eᵢ, Eⱼ]` from the right when
`T.cartanMatrix j i = -1`. -/
theorem raisingCommutatorMatrix_mul_raisingMatrix_right (i j : B)
    (hji : T.cartanMatrix j i = -1) :
    T.raisingCommutatorMatrix i j * (T.raisingMatrix j).map (Int.cast : ℤ → R) = 0 := by
  rw [raisingCommutatorMatrix, Ring.lie_def, sub_mul,
    T.raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one j i hji,
    mul_assoc, T.raisingMatrix_map_mul_self, mul_zero, sub_zero]

/-- The commutator matrix of an adjacent pair squares to zero over every commutative ring. -/
theorem raisingCommutatorMatrix_mul_self (i j : B)
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) :
    T.raisingCommutatorMatrix (R := R) i j * T.raisingCommutatorMatrix i j = 0 := by
  nth_rw 2 [raisingCommutatorMatrix]
  rw [Ring.lie_def, mul_sub, ← mul_assoc, ← mul_assoc,
    T.raisingCommutatorMatrix_mul_raisingMatrix_left i j hij,
    T.raisingCommutatorMatrix_mul_raisingMatrix_right i j hji, zero_mul, zero_mul, sub_zero]

/-- The commutator matrix of an adjacent pair has an entry equal to `1` or `-1`, over any
commutative ring, when some weight has coordinate `-1` at `i`. -/
theorem exists_raisingCommutatorMatrix_apply_eq_one_or_eq_neg_one (i j : B)
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1)
    (hi : ∃ a, T.weight a i = -1) :
    ∃ a b, T.raisingCommutatorMatrix (R := R) i j a b = 1 ∨
      T.raisingCommutatorMatrix (R := R) i j a b = -1 := by
  obtain ⟨b, hb | hb⟩ := T.exists_raising_string_of_cartanMatrix_eq_neg_one i j hij hji hi
  · refine ⟨T.reflection j (T.reflection i b), b, Or.inr ?_⟩
    have hj : T.weight (T.reflection i b) j = -1 := by
      rw [T.weight_reflection, hb.1, hb.2, hji]
      norm_num
    simp [raisingCommutatorMatrix, Ring.lie_def, Matrix.sub_apply, T.mul_raisingMatrix_map_apply,
      hb, hj]
  · refine ⟨T.reflection i (T.reflection j b), b, Or.inl ?_⟩
    have hi' : T.weight (T.reflection j b) i = -1 := by
      rw [T.weight_reflection, hb.1, hb.2, hij]
      norm_num
    simp [raisingCommutatorMatrix, Ring.lie_def, Matrix.sub_apply, T.mul_raisingMatrix_map_apply,
      hb, hi']

/-- Scalar multiples of the commutator matrix of an adjacent pair have unique parameters, over any
commutative ring, when some weight has coordinate `-1` at `i`. -/
theorem smul_raisingCommutatorMatrix_injective (i j : B)
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1)
    (hi : ∃ a, T.weight a i = -1) :
    Function.Injective (fun t : R ↦ t • T.raisingCommutatorMatrix (R := R) i j) := by
  obtain ⟨a, b, hab | hab⟩ :=
    T.exists_raisingCommutatorMatrix_apply_eq_one_or_eq_neg_one (R := R) i j hij hji hi
  all_goals
    intro t u h
    have he := congrFun (congrFun h a) b
    simpa [Matrix.smul_apply, hab, smul_eq_mul] using he

/-- **The adjacent Chevalley commutator formula** for the unipotent matrices `1 + s • Eᵢ` and
`1 + t • Eⱼ`: their commutator is `1 + (s * t) • [Eᵢ, Eⱼ]`. -/
theorem one_add_smul_raisingMatrix_mul_eq_one_add_smul_raisingCommutatorMatrix (i j : B)
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (s t : R) :
    (1 + s • (T.raisingMatrix i).map Int.cast) *
        (1 + t • (T.raisingMatrix j).map Int.cast) *
        (1 + (-s) • (T.raisingMatrix i).map Int.cast) *
        (1 + (-t) • (T.raisingMatrix j).map Int.cast) =
      1 + (s * t) • T.raisingCommutatorMatrix (R := R) i j := by
  simp only [raisingCommutatorMatrix, Ring.lie_def, smul_sub, add_mul, mul_add,
    smul_mul_assoc, mul_smul_comm, one_mul, mul_one]
  simp only [T.raisingMatrix_map_mul_self (R := R) i, T.raisingMatrix_map_mul_self (R := R) j,
    T.raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one (R := R) i j hij,
    T.raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one (R := R) j i hji,
    T.raisingMatrix_mul_raisingMatrix_mul_self (R := R) i j, zero_mul, smul_zero, add_zero]
  module

/-! ## The Heisenberg matrix parametrization -/

/-- The Heisenberg matrix parametrization of an adjacent pair of raising strings:
`(x, y, z) ↦ 1 + x • Eᵢ + y • Eⱼ + (x * y) • Eⱼ Eᵢ + z • [Eᵢ, Eⱼ]`, the matrix of the product
`(1 + y • Eⱼ) (1 + x • Eᵢ) (1 + z • [Eᵢ, Eⱼ])`. -/
def raisingHeisenbergMatrix (i j : B) (g : HeisenbergGroup R) : Matrix ι ι R :=
  1 + g.x • (T.raisingMatrix i).map Int.cast + g.y • (T.raisingMatrix j).map Int.cast +
    (g.x * g.y) • ((T.raisingMatrix j).map Int.cast * (T.raisingMatrix i).map Int.cast) +
      g.z • T.raisingCommutatorMatrix i j

/-- The five-term formula for the Heisenberg matrix parametrization. -/
theorem raisingHeisenbergMatrix_def (i j : B) (g : HeisenbergGroup R) :
    T.raisingHeisenbergMatrix i j g =
      1 + g.x • (T.raisingMatrix i).map Int.cast + g.y • (T.raisingMatrix j).map Int.cast +
        (g.x * g.y) • ((T.raisingMatrix j).map Int.cast * (T.raisingMatrix i).map Int.cast) +
          g.z • T.raisingCommutatorMatrix i j :=
  (rfl)

/-- The identity of the Heisenberg group is parametrized by the identity matrix. -/
@[simp]
theorem raisingHeisenbergMatrix_one (i j : B) :
    T.raisingHeisenbergMatrix i j (1 : HeisenbergGroup R) = 1 := by
  simp [raisingHeisenbergMatrix]

/-- The Heisenberg matrix parametrization of an adjacent pair is multiplicative for the
multiplication `(x, y, z) * (x', y', z') = (x + x', y + y', z + z' + x * y')` of
`TauCeti.HeisenbergGroup`. -/
theorem raisingHeisenbergMatrix_mul (i j : B)
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1)
    (g h : HeisenbergGroup R) :
    T.raisingHeisenbergMatrix i j (g * h) =
      T.raisingHeisenbergMatrix i j g * T.raisingHeisenbergMatrix i j h := by
  simp only [raisingHeisenbergMatrix, raisingCommutatorMatrix, Ring.lie_def, HeisenbergGroup.mul_x,
    HeisenbergGroup.mul_y, HeisenbergGroup.mul_z, smul_sub, add_mul, sub_mul, mul_add, mul_sub,
    smul_mul_assoc, mul_smul_comm, one_mul, mul_one]
  simp only [← mul_assoc, T.raisingMatrix_map_mul_self (R := R) i,
    T.raisingMatrix_map_mul_self (R := R) j,
    T.raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one (R := R) i j hij,
    T.raisingMatrix_mul_raisingMatrix_mul_raisingMatrix_of_cartanMatrix_eq_neg_one (R := R) j i hji,
    T.raisingMatrix_mul_raisingMatrix_mul_self (R := R) i j,
    T.raisingMatrix_mul_raisingMatrix_mul_self (R := R) j i, zero_mul, smul_zero, add_zero,
    sub_zero]
  module

private theorem raisingCoordinates_apply_reflection (i j : B)
    (hij : T.cartanMatrix i j = -1) (b : ι) (hb : T.weight b i = -1) (x y z w : R) :
    (1 + x • (T.raisingMatrix i).map Int.cast + y • (T.raisingMatrix j).map Int.cast +
      z • ((T.raisingMatrix i).map Int.cast * (T.raisingMatrix j).map Int.cast) +
      w • ((T.raisingMatrix j).map Int.cast * (T.raisingMatrix i).map Int.cast) : Matrix ι ι R)
        (T.reflection i b) b = x := by
  have hd : T.weight (T.reflection i b) i - T.weight b i = 2 := by simp [hb]
  have hne : T.reflection i b ≠ b := by
    intro h
    rw [h] at hd
    omega
  have hB := T.raisingMatrix_map_apply_eq_zero_of_weight_sub_ne (R := R) j i (T.reflection i b) b
    (by rw [hd, hij]; omega)
  have hAB := T.raisingMatrix_mul_raisingMatrix_apply_eq_zero_of_weight_sub_ne_add (R := R) i j i
    (T.reflection i b) b (by rw [hd, T.cartanMatrix_diag, hij]; omega)
  have hBA := T.raisingMatrix_mul_raisingMatrix_apply_eq_zero_of_weight_sub_ne_add (R := R) j i i
    (T.reflection i b) b (by rw [hd, hij, T.cartanMatrix_diag]; omega)
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, hB, hAB, hBA, mul_zero,
    add_zero]
  simp [hne, hb]

/-- **The Heisenberg matrix parametrization of an adjacent pair is injective** over every
commutative ring, in every characteristic, as soon as some weight has coordinate `-1` at `i`. -/
theorem raisingHeisenbergMatrix_injective (i j : B)
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1)
    (hi : ∃ a, T.weight a i = -1) :
    Function.Injective (T.raisingHeisenbergMatrix (R := R) i j) := by
  have hj : ∃ a, T.weight a j = -1 := by
    obtain ⟨a, ha | ha⟩ := T.exists_raising_string_of_cartanMatrix_eq_neg_one i j hij hji hi
    · refine ⟨T.reflection i a, ?_⟩
      rw [T.weight_reflection, ha.1, ha.2, hji]
      norm_num
    · exact ⟨a, ha.2⟩
  have hform (g : HeisenbergGroup R) : T.raisingHeisenbergMatrix i j g =
      1 + g.x • (T.raisingMatrix i).map Int.cast + g.y • (T.raisingMatrix j).map Int.cast +
        g.z • ((T.raisingMatrix i).map Int.cast * (T.raisingMatrix j).map Int.cast) +
          (g.x * g.y - g.z) •
            ((T.raisingMatrix j).map Int.cast * (T.raisingMatrix i).map Int.cast) := by
    simp only [raisingHeisenbergMatrix, raisingCommutatorMatrix, Ring.lie_def, smul_sub, sub_smul]
    abel
  intro g h he
  have hx : g.x = h.x := by
    obtain ⟨b, hb⟩ := hi
    have he' := congrFun (congrFun he (T.reflection i b)) b
    simpa only [hform, T.raisingCoordinates_apply_reflection i j hij b hb] using he'
  have hy : g.y = h.y := by
    obtain ⟨b, hb⟩ := hj
    have hswap (g : HeisenbergGroup R) : T.raisingHeisenbergMatrix i j g =
        1 + g.y • (T.raisingMatrix j).map Int.cast + g.x • (T.raisingMatrix i).map Int.cast +
          (g.x * g.y - g.z) •
            ((T.raisingMatrix j).map Int.cast * (T.raisingMatrix i).map Int.cast) +
          g.z • ((T.raisingMatrix i).map Int.cast * (T.raisingMatrix j).map Int.cast) := by
      rw [hform]
      abel
    have he' := congrFun (congrFun he (T.reflection j b)) b
    simpa only [hswap, T.raisingCoordinates_apply_reflection j i hji b hb] using he'
  have hz : g.z = h.z := by
    apply T.smul_raisingCommutatorMatrix_injective i j hij hji hi
    simpa only [raisingHeisenbergMatrix, hx, hy, add_right_inj] using he
  exact HeisenbergGroup.ext hx hy hz

/-- The Heisenberg matrix parametrization factors as the product
`(1 + y • Eⱼ) (1 + x • Eᵢ) (1 + z • [Eᵢ, Eⱼ])` of two unipotent root elements and a central
factor. -/
theorem raisingHeisenbergMatrix_eq_mul (i j : B)
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (g : HeisenbergGroup R) :
    T.raisingHeisenbergMatrix i j g =
      (1 + g.y • (T.raisingMatrix j).map Int.cast) *
        (1 + g.x • (T.raisingMatrix i).map Int.cast) *
          (1 + g.z • T.raisingCommutatorMatrix i j) := by
  simp only [raisingHeisenbergMatrix, add_mul, mul_add,
    smul_mul_assoc, mul_smul_comm, one_mul, mul_one]
  simp only [mul_assoc, T.raisingMatrix_mul_raisingCommutatorMatrix_left i j hij,
    T.raisingMatrix_mul_raisingCommutatorMatrix_right i j hji, mul_zero, smul_zero, add_zero]
  module

/-! ## The Heisenberg subgroup generated by two adjacent root subgroups -/

section HeisenbergSubgroup

variable {G : Subgroup (GL ι R)} (x y : Multiplicative R →* G) {i j : B}

/-- **The adjacent Chevalley commutator formula** in a matrix group: for one-parameter subgroups
`x` and `y` with matrices `1 + s • Eᵢ` and `1 + t • Eⱼ` at nodes joined by Cartan entries `-1`,
the commutator `⁅x(s), y(t)⁆` has matrix `1 + (s * t) • [Eᵢ, Eⱼ]`. -/
theorem coe_commutatorElement_eq_one_add_smul_raisingCommutatorMatrix
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (s t : R) :
    (((⁅x (ofAdd s), y (ofAdd t)⁆ : G) : GL ι R) : Matrix ι ι R) =
      1 + (s * t) • T.raisingCommutatorMatrix i j := by
  have h := T.one_add_smul_raisingMatrix_mul_eq_one_add_smul_raisingCommutatorMatrix i j hij hji s t
  simpa only [commutatorElement_def, ← map_inv, ← ofAdd_neg, Subgroup.coe_mul, Units.val_mul, hx,
    hy] using h

/-- The commutator of two adjacent root elements depends only on the product of their
parameters: `⁅x(s), y(t)⁆ = ⁅x(s * t), y(1)⁆`. -/
theorem commutatorElement_eq_adjacentRootCommutator
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (s t : R) :
    ⁅x (ofAdd s), y (ofAdd t)⁆ = x.adjacentRootCommutator y (s * t) := by
  apply Subtype.ext
  apply Units.ext
  rw [MonoidHom.adjacentRootCommutator,
    T.coe_commutatorElement_eq_one_add_smul_raisingCommutatorMatrix x y hx hy hij hji,
    T.coe_commutatorElement_eq_one_add_smul_raisingCommutatorMatrix x y hx hy hij hji, mul_one]

/-- The central parameter `⁅x(t), y(1)⁆` has matrix `1 + t • [Eᵢ, Eⱼ]`. -/
theorem coe_adjacentRootCommutator
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (t : R) :
    (((x.adjacentRootCommutator y t : G) : GL ι R) : Matrix ι ι R) =
      1 + t • T.raisingCommutatorMatrix i j := by
  rw [MonoidHom.adjacentRootCommutator,
    T.coe_commutatorElement_eq_one_add_smul_raisingCommutatorMatrix x y hx hy hij hji, mul_one]

private theorem coe_mul_mul_adjacentRootCommutator
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (g : HeisenbergGroup R) :
    (((y (ofAdd g.y) * x (ofAdd g.x) * x.adjacentRootCommutator y g.z : G) : GL ι R) :
      Matrix ι ι R) = T.raisingHeisenbergMatrix i j g := by
  rw [T.raisingHeisenbergMatrix_eq_mul i j hij hji]
  simp only [Subgroup.coe_mul, Units.val_mul, hx, hy,
    T.coe_adjacentRootCommutator x y hx hy hij hji]

/-- **The Heisenberg parametrization** `(x, y, z) ↦ y(y) x(x) ⁅x(z), y(1)⁆` of the subgroup
generated by two adjacent root subgroups, a homomorphism from `TauCeti.HeisenbergGroup R`. -/
def adjacentHeisenbergHom
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) :
    HeisenbergGroup R →* G where
  toFun g := y (ofAdd g.y) * x (ofAdd g.x) * x.adjacentRootCommutator y g.z
  map_one' := by simp
  map_mul' g h := by
    apply Subtype.ext
    apply Units.ext
    have hmul := T.raisingHeisenbergMatrix_mul i j hij hji g h
    simpa only [← T.coe_mul_mul_adjacentRootCommutator x y hx hy hij hji, Subgroup.coe_mul,
      Units.val_mul] using hmul

/-- The Heisenberg parametrization sends `(x, y, z)` to `y(y) x(x) ⁅x(z), y(1)⁆`. -/
theorem adjacentHeisenbergHom_apply
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (g : HeisenbergGroup R) :
    T.adjacentHeisenbergHom x y hx hy hij hji g =
      y (ofAdd g.y) * x (ofAdd g.x) * x.adjacentRootCommutator y g.z :=
  (rfl)

/-- The Heisenberg parametrization `(x, y, z) ↦ y(y) x(x) ⁅x(z), y(1)⁆` has matrix
`1 + x • Eᵢ + y • Eⱼ + (x * y) • Eⱼ Eᵢ + z • [Eᵢ, Eⱼ]`, the Heisenberg matrix parametrization. -/
theorem coe_adjacentHeisenbergHom
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (g : HeisenbergGroup R) :
    ((T.adjacentHeisenbergHom x y hx hy hij hji g : GL ι R) : Matrix ι ι R) =
      T.raisingHeisenbergMatrix i j g :=
  T.coe_mul_mul_adjacentRootCommutator x y hx hy hij hji g

/-- The first Heisenberg coordinate parametrizes the first root subgroup. -/
@[simp]
theorem adjacentHeisenbergHom_x
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (a : R) :
    T.adjacentHeisenbergHom x y hx hy hij hji ⟨a, 0, 0⟩ = x (ofAdd a) := by
  simp [adjacentHeisenbergHom_apply]

/-- The second Heisenberg coordinate parametrizes the second root subgroup. -/
@[simp]
theorem adjacentHeisenbergHom_y
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (a : R) :
    T.adjacentHeisenbergHom x y hx hy hij hji ⟨0, a, 0⟩ = y (ofAdd a) := by
  simp [adjacentHeisenbergHom_apply]

/-- The central Heisenberg coordinate parametrizes the commutator `⁅x(z), y(1)⁆`. -/
@[simp]
theorem adjacentHeisenbergHom_z
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (a : R) :
    T.adjacentHeisenbergHom x y hx hy hij hji ⟨0, 0, a⟩ = x.adjacentRootCommutator y a := by
  simp [adjacentHeisenbergHom_apply]

/-- The central parameter is additive: `⁅x(s + t), y(1)⁆ = ⁅x(s), y(1)⁆ ⁅x(t), y(1)⁆`. -/
theorem adjacentRootCommutator_add
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (s t : R) :
    x.adjacentRootCommutator y (s + t) =
      x.adjacentRootCommutator y s * x.adjacentRootCommutator y t := by
  have h := (T.adjacentHeisenbergHom x y hx hy hij hji).map_mul ⟨0, 0, s⟩ ⟨0, 0, t⟩
  have he : (⟨0, 0, s⟩ : HeisenbergGroup R) * ⟨0, 0, t⟩ = ⟨0, 0, s + t⟩ := by
    ext <;> simp
  rwa [he, adjacentHeisenbergHom_z, adjacentHeisenbergHom_z, adjacentHeisenbergHom_z] at h

/-- The central parameter inverts under negation: `⁅x(-t), y(1)⁆ = ⁅x(t), y(1)⁆⁻¹`. -/
theorem adjacentRootCommutator_neg
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (t : R) :
    x.adjacentRootCommutator y (-t) = (x.adjacentRootCommutator y t)⁻¹ := by
  apply eq_inv_of_mul_eq_one_left
  rw [← T.adjacentRootCommutator_add x y hx hy hij hji, neg_add_cancel,
    MonoidHom.adjacentRootCommutator_zero]

/-- The central parameter `t ↦ ⁅x(t), y(1)⁆` as a one-parameter subgroup. -/
def adjacentRootCommutatorHom
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) :
    Multiplicative R →* G where
  toFun u := x.adjacentRootCommutator y (toAdd u)
  map_one' := by simp
  map_mul' u v := by
    simp only [toAdd_mul]
    exact T.adjacentRootCommutator_add x y hx hy hij hji _ _

/-- The central one-parameter subgroup evaluates to the commutator `⁅x(toAdd u), y(1)⁆`. -/
@[simp]
theorem adjacentRootCommutatorHom_apply
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (u : Multiplicative R) :
    T.adjacentRootCommutatorHom x y hx hy hij hji u = x.adjacentRootCommutator y (toAdd u) :=
  (rfl)

/-- **The Heisenberg parametrization is injective** over every commutative ring, in every
characteristic, when some weight has coordinate `-1` at `i`. -/
theorem adjacentHeisenbergHom_injective
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1)
    (hi : ∃ a, T.weight a i = -1) :
    Function.Injective (T.adjacentHeisenbergHom x y hx hy hij hji) := by
  intro g h he
  apply T.raisingHeisenbergMatrix_injective i j hij hji hi
  have he' := congrArg (fun g : G ↦ ((g : GL ι R) : Matrix ι ι R)) he
  simpa only [T.coe_adjacentHeisenbergHom x y hx hy hij hji] using he'

/-- The central parameter `t ↦ ⁅x(t), y(1)⁆` is injective over every commutative ring, without
inverting `2` or `3`, when some weight has coordinate `-1` at `i`. -/
theorem adjacentRootCommutator_injective
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1)
    (hi : ∃ a, T.weight a i = -1) :
    Function.Injective (x.adjacentRootCommutator y) := by
  intro s t h
  have he : T.adjacentHeisenbergHom x y hx hy hij hji ⟨0, 0, s⟩ =
      T.adjacentHeisenbergHom x y hx hy hij hji ⟨0, 0, t⟩ := by
    simpa using h
  exact congrArg HeisenbergGroup.z (T.adjacentHeisenbergHom_injective x y hx hy hij hji hi he)

/-- The central parameter commutes with the first root subgroup. -/
theorem commute_adjacentRootCommutator_left
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (s t : R) :
    Commute (x.adjacentRootCommutator y s) (x (ofAdd t)) := by
  have h : Commute (⟨0, 0, s⟩ : HeisenbergGroup R) ⟨t, 0, 0⟩ := by
    apply HeisenbergGroup.ext <;> simp
  simpa using h.map (T.adjacentHeisenbergHom x y hx hy hij hji)

/-- The central parameter commutes with the second root subgroup. -/
theorem commute_adjacentRootCommutator_right
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (s t : R) :
    Commute (x.adjacentRootCommutator y s) (y (ofAdd t)) := by
  have h : Commute (⟨0, 0, s⟩ : HeisenbergGroup R) ⟨0, t, 0⟩ := by
    apply HeisenbergGroup.ext <;> simp
  simpa using h.map (T.adjacentHeisenbergHom x y hx hy hij hji)

/-- Reversing the pair negates the central parameter: `⁅y(t), x(1)⁆ = ⁅x(-t), y(1)⁆`. -/
theorem adjacentRootCommutator_swap
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) (t : R) :
    y.adjacentRootCommutator x t = x.adjacentRootCommutator y (-t) := by
  apply Subtype.ext
  apply Units.ext
  rw [T.coe_adjacentRootCommutator y x hy hx hji hij,
    T.coe_adjacentRootCommutator x y hx hy hij hji, raisingCommutatorMatrix,
    raisingCommutatorMatrix, Ring.lie_def, Ring.lie_def]
  module

/-- **The Heisenberg parametrization has range the join `x.range ⊔ y.range` of the two root
subgroups.** -/
theorem range_adjacentHeisenbergHom
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1) :
    (T.adjacentHeisenbergHom x y hx hy hij hji).range = x.range ⊔ y.range := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    have hx' (u : Multiplicative R) : x u ∈ x.range ⊔ y.range := Subgroup.mem_sup_left ⟨u, rfl⟩
    have hy' (u : Multiplicative R) : y u ∈ x.range ⊔ y.range := Subgroup.mem_sup_right ⟨u, rfl⟩
    rw [adjacentHeisenbergHom_apply, MonoidHom.adjacentRootCommutator, commutatorElement_def]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (hy' _) (hx' _))
      (Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ (hx' _) (hy' _))
        (Subgroup.inv_mem _ (hx' _))) (Subgroup.inv_mem _ (hy' _)))
  · rw [sup_le_iff]
    constructor
    · rintro _ ⟨u, rfl⟩
      exact ⟨⟨toAdd u, 0, 0⟩, by simp⟩
    · rintro _ ⟨u, rfl⟩
      exact ⟨⟨0, toAdd u, 0⟩, by simp⟩

/-- **The join of two adjacent root subgroups is a Heisenberg group**, through the coordinates
`(x, y, z) ↦ y(y) x(x) ⁅x(z), y(1)⁆`, over every commutative ring. -/
noncomputable def adjacentHeisenbergEquiv
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1)
    (hi : ∃ a, T.weight a i = -1) :
    HeisenbergGroup R ≃* ↥(x.range ⊔ y.range) :=
  (MonoidHom.ofInjective (T.adjacentHeisenbergHom_injective x y hx hy hij hji hi)).trans
    (MulEquiv.subgroupCongr (T.range_adjacentHeisenbergHom x y hx hy hij hji))

/-- The Heisenberg equivalence is the Heisenberg parametrization on underlying elements. -/
@[simp]
theorem coe_adjacentHeisenbergEquiv
    (hx : ∀ t : R, ((x (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix i).map (Int.cast : ℤ → R))
    (hy : ∀ t : R, ((y (ofAdd t) : GL ι R) : Matrix ι ι R) =
      1 + t • (T.raisingMatrix j).map (Int.cast : ℤ → R))
    (hij : T.cartanMatrix i j = -1) (hji : T.cartanMatrix j i = -1)
    (hi : ∃ a, T.weight a i = -1) (g : HeisenbergGroup R) :
    (T.adjacentHeisenbergEquiv x y hx hy hij hji hi g : G) =
      T.adjacentHeisenbergHom x y hx hy hij hji g :=
  (rfl)

end HeisenbergSubgroup

end TauCeti.MinusculeWeightTable
