module

public import TauCeti.Algebra.Lie.Presentation.Serre.RootWeight
public import TauCeti.LinearAlgebra.RootSystem.Weyl.Orbit.IntegralWeight

/-!
# Serre's theorem: the presentation of a split semisimple Lie algebra

Let `L` be a finite-dimensional Lie algebra with nondegenerate Killing form over a field `K` of
characteristic zero, let `H` be a splitting Cartan subalgebra, and let `b` be a base of its root
system. **Serre's theorem** says that `L` is the Lie algebra presented by the Serre relations of its
Cartan matrix. More precisely, the surjection `TauCeti.serreLift` attached to a generating Serre
system of simple-root `sl₂` triples is injective, hence an isomorphism.

The kernel of that surjection lies in the weight spaces of the presented algebra whose weight is
neither zero nor the weight of a root (`TauCeti.ker_serreLift_le_iSup_iInf_eigenspace_ad`). These
weight spaces vanish in any Lie algebra generated by such a Serre system: the simple reflections
permute the weight spaces, every weight outside the positive and negative cones has zero weight
space, and so do the multiples `m ≥ 2` of the weights of roots. The orbit argument combining these
is `RootPairing.Base.induction_integralWeight_reflection`.

## Main definitions

* `TauCeti.serreLiftEquiv`: the isomorphism from the presented algebra onto `L`.

## Main results

* `TauCeti.IsSerreSystem.iInf_eigenspace_ad_eq_bot_of_forall_ne_pairingIn`: the weight spaces of a
  Lie algebra generated by a Serre system vanish on the nonzero weights other than those of roots.
* `TauCeti.serreLift_injective_of_base`: **Serre's theorem**, the injectivity of the lift.
* `TauCeti.serre_presentation_equiv`: `L` is isomorphic to the Lie algebra presented by the Serre
  relations of its Cartan matrix.

## References

* [J.P. Serre, *Complex Semisimple Lie Algebras*][serre1965], chapter VI, appendix
* [J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*][humphreys1972],
  §18.3
-/

public section

open LieAlgebra LieSubalgebra Matrix

namespace TauCeti

/-- **The weight spaces of a Lie algebra generated by a Serre system vanish away from the roots.**
In a Lie algebra generated by a Serre system for the transposed Cartan matrix of a base of a finite
reduced crystallographic root system, the simultaneous eigenspace of the `ad Hₖ` for a nonzero
integral weight `χ` vanishes unless `χ` is the weight `k ↦ ⟨αⱼ, αₖ∨⟩` of a root. -/
theorem IsSerreSystem.iInf_eigenspace_ad_eq_bot_of_forall_ne_pairingIn {ι R M N K L : Type*}
    [Finite ι] [Field R] [CharZero R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {P : RootPairing ι R M N} [P.IsRootSystem] [P.IsCrystallographic] [P.IsReduced] {b : P.Base}
    [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] {H E F : b.support → L}
    (h : IsSerreSystem K b.cartanMatrixᵀ H E F)
    (hspan : lieSpan K L (Set.range E ∪ Set.range F) = ⊤) {χ : b.support → ℤ} (h0 : χ ≠ 0)
    (hroot : ∀ j : ι, χ ≠ fun k : b.support ↦ P.pairingIn ℤ j k) :
    ⨅ k, (ad K L (H k)).eigenspace (χ k : K) = ⊥ := by
  refine b.induction_integralWeight_reflection
    (Q := fun χ ↦ ⨅ k, (ad K L (H k)).eigenspace (χ k : K) = ⊥) (fun ψ i hψ ↦ ?_)
    (fun ψ h₀ hpos hneg ↦ ?_) (fun j m hm ↦ h.iInf_eigenspace_ad_mul_pairingIn_eq_bot hspan j hm)
    h0 hroot
  · obtain ⟨τ, -, hτ⟩ := h.exists_lieEquiv_map_iInf_eigenspace hspan (i := i) (by simp)
    have hmap := hτ ψ
    rw [hψ, Submodule.map_bot, col_transpose] at hmap
    exact hmap.symm
  · exact h.iInf_eigenspace_ad_eq_bot hspan h₀ (by rwa [transpose_transpose])
      (by rwa [transpose_transpose])

section Killing

open LieAlgebra.IsKilling

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [IsKilling K L] {H : LieSubalgebra K L} [H.IsCartanSubalgebra]
  [LieModule.IsTriangularizable K H L]

section Lift

variable {b : (rootSystem H).Base} [DecidableEq b.support] {e f : b.support → L}
  (hS : IsSerreSystem K b.cartanMatrixᵀ (fun i ↦ (((rootSystem H).coroot i : H) : L)) e f)
  (hspan : lieSpan K L (Set.range e ∪ Set.range f) = ⊤)

include hspan in
/-- **Serre's theorem.** Let `L` be a split semisimple Lie algebra over a field of characteristic
zero, generated by a Serre system for the transposed Cartan matrix of a base with the simple coroots
as Cartan generators. Then the surjection onto `L` from the Lie algebra presented by Serre's
relations is injective. -/
theorem serreLift_injective_of_base : Function.Injective (serreLift hS) := by
  have hker : LinearMap.ker (serreLift hS : Matrix.ToLieAlgebra K b.cartanMatrixᵀ →ₗ[K] L) = ⊥ := by
    refine eq_bot_iff.2 ((ker_serreLift_le_iSup_iInf_eigenspace_ad hS hspan).trans ?_)
    refine iSup₂_le fun χ hχ ↦ ?_
    rw [(isSerreSystem_serre K b.cartanMatrixᵀ).iInf_eigenspace_ad_eq_bot_of_forall_ne_pairingIn
      (lieSpan_serreE_union_serreF_eq_top K b.cartanMatrixᵀ) hχ.1 hχ.2]
  simpa only [LieHom.coe_toLinearMap] using LinearMap.ker_eq_bot.1 hker

/-- **Serre's presentation of a split semisimple Lie algebra.** The lift of a generating Serre
system of simple coroots is an isomorphism from the Lie algebra presented by Serre's relations
onto `L`. -/
noncomputable def serreLiftEquiv : Matrix.ToLieAlgebra K b.cartanMatrixᵀ ≃ₗ⁅K⁆ L :=
  LieEquiv.ofBijective (serreLift hS)
    ⟨serreLift_injective_of_base hS hspan, serreLift_surjective hS hspan⟩

/-- The isomorphism `TauCeti.serreLiftEquiv` is the lift `TauCeti.serreLift`. -/
@[simp]
theorem serreLiftEquiv_apply (x : Matrix.ToLieAlgebra K b.cartanMatrixᵀ) :
    serreLiftEquiv hS hspan x = serreLift hS x :=
  (rfl)

/-- The isomorphism `TauCeti.serreLiftEquiv` sends the generator `Hᵢ` to the simple coroot `αᵢ∨`. -/
theorem serreLiftEquiv_serreH (i : b.support) :
    serreLiftEquiv hS hspan (serreH K b.cartanMatrixᵀ i) = (((rootSystem H).coroot i : H) : L) := by
  simp [serreLift_serreH]

/-- The isomorphism `TauCeti.serreLiftEquiv` sends the generator `Eᵢ` to `e i`. -/
theorem serreLiftEquiv_serreE (i : b.support) :
    serreLiftEquiv hS hspan (serreE K b.cartanMatrixᵀ i) = e i := by
  simp [serreLift_serreE]

/-- The isomorphism `TauCeti.serreLiftEquiv` sends the generator `Fᵢ` to `f i`. -/
theorem serreLiftEquiv_serreF (i : b.support) :
    serreLiftEquiv hS hspan (serreF K b.cartanMatrixᵀ i) = f i := by
  simp [serreLift_serreF]

end Lift

open scoped Classical in
/-- **A split semisimple Lie algebra is presented by the Serre relations of its Cartan matrix.** -/
theorem serre_presentation_equiv (b : (rootSystem H).Base) :
    Nonempty (Matrix.ToLieAlgebra K b.cartanMatrixᵀ ≃ₗ⁅K⁆ L) := by
  obtain ⟨e, f, hS, hspan⟩ := exists_isSerreSystem_of_base b
  exact ⟨serreLiftEquiv hS hspan⟩

end Killing

end TauCeti
