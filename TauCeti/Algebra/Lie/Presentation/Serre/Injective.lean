module

public import TauCeti.Algebra.Lie.Presentation.Serre.Basis
public import TauCeti.Algebra.Lie.Presentation.Serre.RootWeight
import TauCeti.Algebra.Lie.Basis.Root

/-!
# Serre's theorem

Let `L` be a finite-dimensional Lie algebra with nondegenerate Killing form over a field of
characteristic zero, split by a Cartan subalgebra `H`, and let `b` be a base of its root system.
The simple-root `sl₂` triples `(hᵢ, eᵢ, fᵢ)`, with `hᵢ` the simple coroots, form a Serre system for
the transposed Cartan matrix of `b`, and when the `eᵢ` and `fᵢ` generate `L` they induce a
surjection `TauCeti.serreLift` onto `L` from the Lie algebra `Matrix.ToLieAlgebra K b.cartanMatrixᵀ`
presented by Serre's relations. **Serre's theorem** says that this surjection is an isomorphism.

The proof compares weight spaces of the two algebras for the `ad hᵢ`. The lift is injective on the
weight spaces of zero and of the roots, and its kernel lies in the remaining weight spaces
(`TauCeti.ker_serreLift_le_iSup_iInf_eigenspace_ad`); those vanish in any Lie algebra generated by
a Serre system for a Cartan matrix of a root system
(`TauCeti.IsSerreSystem.iInf_eigenspace_ad_eq_bot_of_ne_pairingIn`). Hence the kernel is zero.

The theorem is also recorded for the generators of a `LieAlgebra.Basis`, numbered by an arbitrary
index type rather than by the simple roots of the base they determine: the induced map out of the
presentation for the transposed matrix `LieAlgebra.Basis.A` is injective. This is the form in which
a concrete split Lie algebra, such as the pinned rational algebra of a Dynkin type, is identified
with its Serre presentation.

## Main definitions

* `TauCeti.serreLiftEquiv`: the Serre presentation `Matrix.ToLieAlgebra K b.cartanMatrixᵀ ≃ₗ⁅K⁆ L`.

## Main results

* `TauCeti.serreLift_injective_of_base`: Serre's theorem.
* `TauCeti.serreLiftEquiv_symm_coroot`, `TauCeti.serreLiftEquiv_symm_e` and
  `TauCeti.serreLiftEquiv_symm_f`: the inverse of the presentation on the generators.
* `LieAlgebra.Basis.serreLift_injective`: Serre's theorem for the generators of a Lie algebra
  basis.

## References

* [J.P. Serre, *Complex Semisimple Lie Algebras*][serre1965], chapter VI, appendix
* [J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*][humphreys1972],
  §18.3
-/

public section

open LieAlgebra LieAlgebra.IsKilling LieModule LieSubalgebra Matrix

namespace TauCeti

section Base

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [IsKilling K L] {H : LieSubalgebra K L} [H.IsCartanSubalgebra]
  [IsTriangularizable K H L] {b : (rootSystem H).Base} [DecidableEq b.support]
  {e f : b.support → L}
  (hS : IsSerreSystem K b.cartanMatrixᵀ (fun i ↦ (((rootSystem H).coroot i : H) : L)) e f)
  (hspan : lieSpan K L (Set.range e ∪ Set.range f) = ⊤)

include hspan

/-- **Serre's theorem.** Let `L` be a split semisimple Lie algebra, generated by a Serre system of
simple-root `sl₂` triples for a base of its root system. Then the surjection onto `L` from the Lie
algebra presented by Serre's relations for the transposed Cartan matrix of the base is
injective. -/
theorem serreLift_injective_of_base : Function.Injective (serreLift hS) := by
  rw [← LieHom.coe_toLinearMap, ← LinearMap.ker_eq_bot, _root_.eq_bot_iff]
  refine (ker_serreLift_le_iSup_iInf_eigenspace_ad hS hspan).trans (iSup₂_le fun χ hχ ↦ ?_)
  rw [(isSerreSystem_serre K b.cartanMatrixᵀ).iInf_eigenspace_ad_eq_bot_of_ne_pairingIn
    (lieSpan_serreE_union_serreF_eq_top K b.cartanMatrixᵀ) hχ.1 hχ.2]

/-- **The Serre presentation of a split semisimple Lie algebra**: the isomorphism onto `L` from the
Lie algebra presented by Serre's relations for the transposed Cartan matrix of a base, induced by
a Serre system of simple-root `sl₂` triples generating `L`. -/
noncomputable def serreLiftEquiv : Matrix.ToLieAlgebra K b.cartanMatrixᵀ ≃ₗ⁅K⁆ L :=
  LieEquiv.ofBijective (serreLift hS)
    ⟨serreLift_injective_of_base hS hspan, serreLift_surjective hS hspan⟩

/-- The Serre presentation isomorphism is the Serre lift. -/
@[simp]
theorem coe_serreLiftEquiv : ⇑(serreLiftEquiv hS hspan) = serreLift hS :=
  (rfl)

/-- The inverse of the Serre presentation sends each simple coroot to the corresponding Cartan
generator of the presentation. -/
@[simp]
theorem serreLiftEquiv_symm_coroot (i : b.support) :
    (serreLiftEquiv hS hspan).symm ((coroot ((i : H.root) : Weight K H L) : H) : L) =
      serreH K b.cartanMatrixᵀ i := by
  rw [LieEquiv.symm_apply_eq, coe_serreLiftEquiv, serreLift_serreH, rootSystem_coroot_apply]

/-- The inverse of the Serre presentation sends each raising generator `eᵢ` to the corresponding
raising generator of the presentation. -/
@[simp]
theorem serreLiftEquiv_symm_e (i : b.support) :
    (serreLiftEquiv hS hspan).symm (e i) = serreE K b.cartanMatrixᵀ i := by
  rw [LieEquiv.symm_apply_eq, coe_serreLiftEquiv, serreLift_serreE]

/-- The inverse of the Serre presentation sends each lowering generator `fᵢ` to the corresponding
lowering generator of the presentation. -/
@[simp]
theorem serreLiftEquiv_symm_f (i : b.support) :
    (serreLiftEquiv hS hspan).symm (f i) = serreF K b.cartanMatrixᵀ i := by
  rw [LieEquiv.symm_apply_eq, coe_serreLiftEquiv, serreLift_serreF]

end Base

end TauCeti

namespace LieAlgebra.Basis

open TauCeti

variable {ι K L : Type*} [Finite ι] [DecidableEq ι] [Field K] [CharZero K] [LieRing L]
  [LieAlgebra K L] [FiniteDimensional K L] [IsKilling K L] {H : LieSubalgebra K L}

/-- **Serre's theorem for a Lie algebra basis.** For a `LieAlgebra.Basis` of a finite-dimensional
Lie algebra with nondegenerate Killing form over a field of characteristic zero, the homomorphism
onto `L` from the Lie algebra presented by Serre's relations for the transposed matrix
`LieAlgebra.Basis.A`, sending the generators to those of the basis, is injective. -/
theorem serreLift_injective (b : LieAlgebra.Basis ι H) :
    Function.Injective (serreLift (isSerreSystem_lieBasis b)) := by
  classical
  let _ := Fintype.ofFinite ι
  let _ := b.isCartanSubalgebra
  have _ := b.isTriangularizable
  set φ := b.baseSupportEquiv
  set CM := b.base.cartanMatrixᵀ
  have hCM : CM.submatrix φ φ = b.Aᵀ := by
    ext i j
    simp [CM, φ, LieAlgebra.Basis.cartanMatrix_base_eq]
  have hCM' : b.Aᵀ.submatrix φ.symm φ.symm = CM := by
    rw [← hCM, Matrix.submatrix_submatrix, Equiv.self_comp_symm, Matrix.submatrix_id_id]
  -- The generators of the basis, renumbered by the simple roots of the base they determine, form
  -- a Serre system of simple-root `sl₂` triples for that base.
  have hH : b.h ∘ φ.symm = fun i : b.base.support ↦ (((rootSystem H).coroot i : H) : L) := by
    funext i
    obtain ⟨j, rfl⟩ := φ.surjective i
    rw [Function.comp_apply, Equiv.symm_apply_apply, rootSystem_coroot_apply,
      LieAlgebra.Basis.coroot_eq_h']
    -- `b.h' j` is defined as the element `b.h j` of `H`, so its coercion to `L` is `b.h j`.
    rfl
  have hS := (isSerreSystem_lieBasis b).submatrix φ.symm.injective
  rw [hCM', hH] at hS
  have hspan : lieSpan K L (Set.range (b.e ∘ φ.symm) ∪ Set.range (b.f ∘ φ.symm)) = ⊤ := by
    rw [φ.symm.surjective.range_comp, φ.symm.surjective.range_comp]
    exact b.span_ef
  -- The presentations numbered by `ι` and by the simple roots of the base are identified by
  -- renumbering their generators: `α` renumbers, and `β` is a left inverse of `α`.
  have hα := (isSerreSystem_serre K CM).submatrix φ.injective
  rw [hCM] at hα
  have hβ := (isSerreSystem_serre K b.Aᵀ).submatrix φ.symm.injective
  rw [hCM'] at hβ
  have hβα : (serreLift hβ).comp (serreLift hα) = LieHom.id :=
    serre_hom_ext (fun i ↦ by simp) (fun i ↦ by simp) fun i ↦ by simp
  have hfac : serreLift (isSerreSystem_lieBasis b) = (serreLift hS).comp (serreLift hα) := by
    refine (eq_serreLift (fun i ↦ ?_) (fun i ↦ ?_) fun i ↦ ?_).symm
    · simpa using (congrFun hH (φ i)).symm
    · simp [φ]
    · simp [φ]
  rw [hfac, LieHom.coe_comp]
  exact (serreLift_injective_of_base hS hspan).comp
    (Function.LeftInverse.injective (g := serreLift hβ) fun x ↦ DFunLike.congr_fun hβα x)

end LieAlgebra.Basis
