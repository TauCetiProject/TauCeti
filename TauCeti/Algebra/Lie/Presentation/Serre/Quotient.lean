/-!
# One-sided Serre ideal and quotient

The Lie ideal `TauCeti.serreIdeal R CM` of `FreeLieAlgebra R B` generated by the same-sign Serre
relators `(ad xᵢ) ^ (-CMᵢⱼ).toNat ⁅xᵢ, xⱼ⁆`, together with its quotient universal property
(`TauCeti.serreIdealLift`), the defining relations on the quotient generator classes
(`TauCeti.ad_pow_lie_serreIdeal_mk_of`), linear independence of the generator classes
(`TauCeti.linearIndependent_serreIdeal_mk_of`), induction on membership
(`TauCeti.serreIdeal_induction`), and stability under negating the free generators
(`TauCeti.freeNeg_mem_serreIdeal`).

## Main definitions

* `TauCeti.serreIdeal`: the Lie ideal of `FreeLieAlgebra R B` generated by the same-sign Serre
  relators.
* `TauCeti.serreIdealLift`: the homomorphism out of `FreeLieAlgebra R B ⧸ serreIdeal R CM`
  determined by a family satisfying the same-sign Serre relations.

## Main results

* `TauCeti.serreIdeal_le_ker_lift`: a family satisfying the same-sign Serre relations kills
  `TauCeti.serreIdeal`.
* `TauCeti.serreIdealLift_comp_mkQ`, `TauCeti.serreIdealLift_mk_of`, and
  `TauCeti.range_serreIdealLift`: compatibility of `TauCeti.serreIdealLift` with `mkQ`, evaluation
  on generator classes, and its range.
* `TauCeti.relator_mem_serreIdeal` and `TauCeti.ad_pow_lie_serreIdeal_mk_of`: the same-sign Serre
  relators belong to the ideal and vanish on the quotient generator classes.
* `TauCeti.linearIndependent_serreIdeal_mk_of`: the quotient generator classes are linearly
  independent over `R`.
* `TauCeti.serreIdeal_induction`: induction principle for membership in `TauCeti.serreIdeal`.
* `TauCeti.freeNeg_mem_serreIdeal`: negating every free generator preserves `TauCeti.serreIdeal`.
-/

public section

namespace TauCeti

open LieAlgebra

/-- The Lie ideal of `FreeLieAlgebra R B` generated by the same-sign Serre relators
`(ad xᵢ) ^ (-CMᵢⱼ).toNat ⁅xᵢ, xⱼ⁆`. -/
noncomputable def serreIdeal (R : Type*) [CommRing R] {B : Type*} (CM : Matrix B B ℤ) :
    LieIdeal R (FreeLieAlgebra R B) :=
  LieSubmodule.lieSpan R (FreeLieAlgebra R B)
    {x | ∃ i j : B, x = (ad R _ (FreeLieAlgebra.of R i) ^ (-CM i j).toNat)
      ⁅FreeLieAlgebra.of R i, FreeLieAlgebra.of R j⁆}

/-- If a family `E : B → L` satisfies the same-sign Serre relations for `CM`, then `serreIdeal R CM`
lies in the kernel of `FreeLieAlgebra.lift R E`. -/
theorem serreIdeal_le_ker_lift {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    {B : Type*} {CM : Matrix B B ℤ} {E : B → L}
    (hE : ∀ i j, (ad R L (E i) ^ (-CM i j).toNat) ⁅E i, E j⁆ = 0) :
    serreIdeal R CM ≤ (FreeLieAlgebra.lift R E).ker := by
  refine LieSubmodule.lieSpan_le.mpr ?_
  rintro _ ⟨i, j, rfl⟩
  simpa [LieHom.map_ad_pow] using hE i j

/-- The Lie algebra homomorphism out of `FreeLieAlgebra R B ⧸ serreIdeal R CM` determined by a
family satisfying the same-sign Serre relations. -/
noncomputable def serreIdealLift {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    {B : Type*} {CM : Matrix B B ℤ} {E : B → L}
    (hE : ∀ i j, (ad R L (E i) ^ (-CM i j).toNat) ⁅E i, E j⁆ = 0) :
    FreeLieAlgebra R B ⧸ serreIdeal R CM →ₗ⁅R⁆ L :=
  (serreIdeal R CM).liftQ (FreeLieAlgebra.lift R E) (serreIdeal_le_ker_lift hE)

/-- Composing `TauCeti.serreIdealLift` with the quotient map recovers the lift on the free Lie
algebra. -/
@[simp]
theorem serreIdealLift_comp_mkQ {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    {B : Type*} {CM : Matrix B B ℤ} {E : B → L}
    (hE : ∀ i j, (ad R L (E i) ^ (-CM i j).toNat) ⁅E i, E j⁆ = 0) :
    (serreIdealLift hE).comp (serreIdeal R CM).mkQ = FreeLieAlgebra.lift R E :=
  (serreIdeal R CM).liftQ_mkQ _ _

/-- `TauCeti.serreIdealLift` sends the quotient class of the `i`-th free generator to `E i`. -/
@[simp]
theorem serreIdealLift_mk_of {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    {B : Type*} {CM : Matrix B B ℤ} {E : B → L}
    (hE : ∀ i j, (ad R L (E i) ^ (-CM i j).toNat) ⁅E i, E j⁆ = 0) (i : B) :
    serreIdealLift hE (LieSubmodule.Quotient.mk (FreeLieAlgebra.of R i)) = E i :=
  (DFunLike.congr_fun (serreIdealLift_comp_mkQ hE) _).trans (FreeLieAlgebra.lift_of_apply _ _)

/-- The range of `TauCeti.serreIdealLift` is the Lie subalgebra generated by the target family. -/
theorem range_serreIdealLift {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    {B : Type*} {CM : Matrix B B ℤ} {E : B → L}
    (hE : ∀ i j, (ad R L (E i) ^ (-CM i j).toNat) ⁅E i, E j⁆ = 0) :
    (serreIdealLift hE).range = LieSubalgebra.lieSpan R L (Set.range E) :=
  (LieIdeal.range_liftQ _ _ _).trans (FreeLieAlgebra.range_lift_eq_lieSpan E)

/-- Every same-sign Serre relator lies in `TauCeti.serreIdeal`. -/
theorem relator_mem_serreIdeal (R : Type*) [CommRing R] {B : Type*} (CM : Matrix B B ℤ)
    (i j : B) :
    (ad R _ (FreeLieAlgebra.of R i) ^ (-CM i j).toNat)
      ⁅FreeLieAlgebra.of R i, FreeLieAlgebra.of R j⁆ ∈ serreIdeal R CM :=
  LieSubmodule.subset_lieSpan ⟨i, j, rfl⟩

/-- The quotient generator classes in `FreeLieAlgebra R B ⧸ serreIdeal R CM` satisfy the
same-sign Serre relations. -/
@[simp]
theorem ad_pow_lie_serreIdeal_mk_of (R : Type*) [CommRing R] {B : Type*}
    (CM : Matrix B B ℤ) (i j : B) :
    (ad R (FreeLieAlgebra R B ⧸ serreIdeal R CM)
      (LieSubmodule.Quotient.mk (FreeLieAlgebra.of R i)) ^ (-CM i j).toNat)
      ⁅(LieSubmodule.Quotient.mk (FreeLieAlgebra.of R i) :
          FreeLieAlgebra R B ⧸ serreIdeal R CM),
        LieSubmodule.Quotient.mk (FreeLieAlgebra.of R j)⁆ = 0 := by
  have h := (serreIdeal R CM).mkQ_eq_zero.mpr (relator_mem_serreIdeal R CM i j)
  simpa [LieHom.map_ad_pow] using h

/-- Induction principle for membership in `TauCeti.serreIdeal`. -/
@[elab_as_elim]
theorem serreIdeal_induction {R : Type*} [CommRing R] {B : Type*} {CM : Matrix B B ℤ}
    {motive : (x : FreeLieAlgebra R B) → x ∈ serreIdeal R CM → Prop}
    (relator : ∀ i j : B,
      motive ((ad R _ (FreeLieAlgebra.of R i) ^ (-CM i j).toNat)
        ⁅FreeLieAlgebra.of R i, FreeLieAlgebra.of R j⁆) (relator_mem_serreIdeal R CM i j))
    (zero : motive 0 (LieSubmodule.zero_mem _))
    (add : ∀ x y hx hy, motive x hx → motive y hy → motive (x + y) (add_mem hx hy))
    (smul : ∀ (c : R) x hx, motive x hx → motive (c • x) (SMulMemClass.smul_mem _ hx))
    (lie : ∀ (x : FreeLieAlgebra R B) y hy, motive y hy → motive ⁅x, y⁆ (LieSubmodule.lie_mem _ hy))
    {x : FreeLieAlgebra R B} (hx : x ∈ serreIdeal R CM) : motive x hx := by
  induction hx using LieSubmodule.lieSpan_induction with
  | mem _ hx => rcases hx with ⟨i, j, rfl⟩; exact relator i j
  | zero => exact zero
  | add _ _ hx hy hu hv => exact add _ _ hx hy hu hv
  | smul c _ hx hu => exact smul c _ hx hu
  | lie u _ hv ih => exact lie u _ hv ih

/-- Negating every free generator preserves the same-sign Serre ideal. -/
theorem freeNeg_mem_serreIdeal {R : Type*} [CommRing R] {B : Type*} {CM : Matrix B B ℤ}
    {b : FreeLieAlgebra R B} (hb : b ∈ serreIdeal R CM) :
    TauCeti.FreeLieAlgebra.freeNeg R B b ∈ serreIdeal R CM := by
  induction hb using serreIdeal_induction with
  | relator i j =>
    have hmem := Submodule.smul_mem (serreIdeal R CM).toSubmodule ((-1 : R) ^ (-CM i j).toNat)
      (relator_mem_serreIdeal R CM i j)
    rw [← LieEquiv.coe_toLieHom]
    simpa [LieHom.map_ad_pow, ad_neg_pow_apply, -map_neg] using hmem
  | zero => simp
  | add _ _ _ _ hu hv => simpa [map_add] using add_mem hu hv
  | smul c _ _ hu => simpa [map_smul] using Submodule.smul_mem _ c hu
  | lie _ _ _ ih => simpa [LieEquiv.map_lie] using LieSubmodule.lie_mem (serreIdeal R CM) ih

/-- The generator classes in `FreeLieAlgebra R B ⧸ serreIdeal R CM` are linearly independent over
`R`. -/
theorem linearIndependent_serreIdeal_mk_of (R : Type*) [CommRing R] {B : Type*}
    (CM : Matrix B B ℤ) :
    LinearIndependent R fun i : B =>
      (LieSubmodule.Quotient.mk (FreeLieAlgebra.of R i) :
        FreeLieAlgebra R B ⧸ serreIdeal R CM) := by
  classical
  let eBasis : B → TauCeti.AbelianLieAlgebra (B →₀ R) :=
    fun i => (TauCeti.AbelianLieAlgebra.equiv R (B →₀ R)).symm (Finsupp.single i 1)
  let abHom : FreeLieAlgebra R B ⧸ serreIdeal R CM →ₗ⁅R⁆ TauCeti.AbelianLieAlgebra (B →₀ R) :=
    serreIdealLift (E := eBasis) fun i j => by simp
  let proj : (FreeLieAlgebra R B ⧸ serreIdeal R CM) →ₗ[R] (B →₀ R) :=
    (TauCeti.AbelianLieAlgebra.equiv R (B →₀ R)).toLinearMap.comp abHom.toLinearMap
  have hcomp : proj ∘ (fun i : B =>
      (LieSubmodule.Quotient.mk (FreeLieAlgebra.of R i) :
        FreeLieAlgebra R B ⧸ serreIdeal R CM)) = fun i => Finsupp.single i (1 : R) := by
    ext i
    simp [proj, abHom, eBasis]
  exact LinearIndependent.of_comp proj
    (hcomp ▸ (Finsupp.basisSingleOne (ι := B) (R := R)).linearIndependent)

end TauCeti
