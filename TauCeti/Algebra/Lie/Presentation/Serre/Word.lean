module

public import TauCeti.LinearAlgebra.LinearIndependent.NonnegCombination
public import TauCeti.Algebra.Lie.Presentation.Serre.Triangular

/-!
# The positive weight spaces of a Serre system are spanned by bracket words

Let `(H, E, F)` be a Serre system for a matrix of integers `CM` in a Lie algebra `L`
(`TauCeti.IsSerreSystem`), and suppose that the raising and lowering families `E` and `F` generate
`L`. The motivating example is the Lie algebra `Matrix.ToLieAlgebra R CM` presented by Serre's
relations, with its own generators.

A **bracket word** is a right-normed bracket `⁅E w₀, ⁅E w₁, … ⁅E wₙ₋₁, E i⁆…⁆⁆` of raising
generators (`TauCeti.rightNormedBracket E i w`). Each `Eⱼ` has weight the `j`-th column
`CM.col j` of `CM` and the bracket adds weights, so a bracket word lies in the simultaneous
eigenspace of the `ad Hₖ` (it may be zero) whose weight is the sum of the columns of its letters,
counted with multiplicity. The bracket words span the Lie subalgebra `n⁺` generated by the `Eᵢ`
(`LieSubalgebra.coe_lieSpan_range_eq_span_rightNormedBracket`). Combined with the triangular
decomposition `L = n⁻ + 𝔥 + n⁺` and the independence of the weight spaces, this gives:

* over a characteristic-zero domain on which `L` is torsion-free, the weight space `L_χ` of a
  nonzero weight `χ` that is not a sum of negated columns is exactly the span of the bracket words
  of weight `χ` (`TauCeti.IsSerreSystem.iInf_eigenspace_ad_eq_span_rightNormedBracket`).

When the columns of `CM` are linearly independent over `ℤ`, as they are for a matrix of nonzero
determinant such as the Cartan matrix of a finite root system, the weight of a bracket word
determines how often each letter occurs. A word of weight `m` times the `i`-th column then has `m`
letters, all equal to `i`, and such a word vanishes for `m ≥ 2`. So:

* the weight space of the `i`-th column is the line spanned by `Eᵢ`
  (`TauCeti.IsSerreSystem.iInf_eigenspace_ad_col_eq_span_singleton`);
* the weight space of `m` times the `i`-th column vanishes for `m ≥ 2`
  (`TauCeti.IsSerreSystem.iInf_eigenspace_ad_nsmul_col_eq_bot`).

These are the simple-root cases of Serre's theorem identifying `Matrix.ToLieAlgebra K CM`, for a
Cartan matrix `CM` over a field `K` of characteristic zero, with the finite-dimensional split
semisimple Lie algebra of that Cartan matrix: once the Weyl group acts on the weight spaces, every
root space is carried to a simple-root one, which is a line, and every integer multiple `m • α`
of a root `α` with `|m| ≥ 2` to such a multiple of a simple root, whose weight space vanishes.

## Main results

* `TauCeti.IsSerreSystem.rightNormedBracket_mem_iInf_eigenspace_ad`: a bracket word lies in the
  simultaneous eigenspace of the `ad Hₖ` whose weight is the sum of the columns of its letters.
* `TauCeti.IsSerreSystem.iInf_eigenspace_ad_eq_span_rightNormedBracket`: the weight space of a
  nonzero weight that is not a sum of negated columns is spanned by the bracket words of that
  weight.
* `TauCeti.IsSerreSystem.iInf_eigenspace_ad_col_eq_span_singleton`: for linearly independent
  columns, the weight space of a column is spanned by the corresponding raising generator.
* `TauCeti.IsSerreSystem.iInf_eigenspace_ad_nsmul_col_eq_bot`: for linearly independent columns,
  the weight space of a multiple `m ≥ 2` of a column vanishes.
* `TauCeti.iInf_eigenspace_ad_serreH_eq_span_rightNormedBracket`,
  `TauCeti.iInf_eigenspace_ad_serreH_col_eq_span_singleton` and
  `TauCeti.iInf_eigenspace_ad_serreH_nsmul_col_eq_bot`: the same statements for the Lie algebra
  presented by Serre's relations over a field of characteristic zero.

## References

* [J.P. Serre, *Complex Semisimple Lie Algebras*][serre1965], chapter VI, appendix
* [J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*][humphreys1972],
  §18.3
-/

public section

open LieAlgebra LieSubalgebra Matrix

namespace TauCeti

variable {B R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] {CM : Matrix B B ℤ}
  {H E F : B → L}

namespace IsSerreSystem

variable (h : IsSerreSystem R CM H E F)
include h

/-- **The weight of a bracket word.** The right-normed bracket `⁅E w₀, … ⁅E wₙ₋₁, E i⁆…⁆` lies in
the simultaneous eigenspace of the `ad Hₖ` whose eigenvalues are the sum of the columns of `CM` of
its letters. It may be zero, so it need not be an eigenvector. -/
theorem rightNormedBracket_mem_iInf_eigenspace_ad (i : B) (w : List B) :
    rightNormedBracket E i w ∈
      ⨅ k, (ad R L (H k)).eigenspace ((((i :: w).map CM.col).sum k : ℤ) : R) := by
  have hE : ∀ j, E j ∈ ⨅ k, (ad R L (H k)).eigenspace ((CM.col j k : ℤ) : R) := fun j => by
    simp [h.lie_H_E, Int.cast_smul_eq_zsmul]
  induction w with
  | nil => simpa using hE i
  | cons j w ih =>
    have hsum : ((i :: j :: w).map CM.col).sum = CM.col j + ((i :: w).map CM.col).sum := by
      simp only [List.map_cons, List.sum_cons]
      abel
    rw [rightNormedBracket_cons, hsum]
    simpa only [Pi.add_apply, Int.cast_add] using lie_mem_iInf_eigenspace_ad (hE j) ih

/-- The bracket words of a given weight span a subspace of the weight space of that weight. -/
private theorem span_rightNormedBracket_le_iInf_eigenspace_ad (S : Set (B → ℤ)) :
    Submodule.span R ((fun p : B × List B => rightNormedBracket E p.1 p.2) ''
        {p | ((p.1 :: p.2).map CM.col).sum ∈ S}) ≤
      ⨆ χ ∈ S, ⨅ k, (ad R L (H k)).eigenspace (χ k : R) := by
  rw [Submodule.span_le]
  rintro _ ⟨⟨i, w⟩, hw, rfl⟩
  exact Submodule.mem_iSup_of_mem _
    (Submodule.mem_iSup_of_mem hw (h.rightNormedBracket_mem_iInf_eigenspace_ad i w))

variable [IsDomain R] [CharZero R] [Module.IsTorsionFree R L]

/-- **The weight spaces of the positive part are spanned by bracket words.** Over a
characteristic-zero domain on which `L` is torsion-free, in a Lie algebra generated by the raising
and lowering families of a Serre system, the simultaneous eigenspace of the `ad Hₖ` for a nonzero
integral weight `χ` that is not a sum of negated columns of `CM` is the span of the right-normed
brackets `⁅E w₀, … ⁅E wₙ₋₁, E i⁆…⁆` whose letters have columns summing to `χ`. -/
theorem iInf_eigenspace_ad_eq_span_rightNormedBracket
    (hspan : lieSpan R L (Set.range E ∪ Set.range F) = ⊤) {χ : B → ℤ} (h0 : χ ≠ 0)
    (hneg : χ ∉ AddSubsemigroup.closure (Set.range (-CM.col))) :
    ⨅ k, (ad R L (H k)).eigenspace (χ k : R) =
      Submodule.span R ((fun p : B × List B => rightNormedBracket E p.1 p.2) ''
        {p | ((p.1 :: p.2).map CM.col).sum = χ}) := by
  set Wχ := Submodule.span R ((fun p : B × List B => rightNormedBracket E p.1 p.2) ''
    {p | ((p.1 :: p.2).map CM.col).sum = χ})
  set T : Set (B → ℤ) := {ψ | ψ ≠ χ}
  have hWχ : Wχ ≤ ⨅ k, (ad R L (H k)).eigenspace (χ k : R) := by
    simpa only [Set.mem_singleton_iff, iSup_iSup_eq_left] using
      h.span_rightNormedBracket_le_iInf_eigenspace_ad (S := {χ})
  refine le_antisymm (fun x hx => ?_) hWχ
  -- Split `x` along the triangular decomposition, and the positive part along the bracket words
  -- of weight `χ` and those of other weights.
  have hx' : x ∈ (lieSpan R L (Set.range F)).toSubmodule ⊔ Submodule.span R (Set.range H) ⊔
      (lieSpan R L (Set.range E)).toSubmodule := by
    rw [h.lieSpan_F_sup_span_H_sup_lieSpan_E_eq_top hspan]
    exact Submodule.mem_top
  obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.1 hx'
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hab
  have hc' : c ∈ Wχ ⊔ Submodule.span R ((fun p : B × List B => rightNormedBracket E p.1 p.2) ''
      {p | ((p.1 :: p.2).map CM.col).sum ∈ T}) := by
    rw [← Submodule.span_union, ← Set.image_union]
    have hc'' : c ∈ (lieSpan R L (Set.range E) : Submodule R L) := hc
    rw [coe_lieSpan_range_eq_span_rightNormedBracket, ← Set.image_univ] at hc''
    convert hc'' using 3
    ext p
    simp only [Set.mem_union, Set.mem_ofPred_eq, Set.mem_univ, iff_true, T]
    exact eq_or_ne _ _
  obtain ⟨c₁, hc₁, c₂, hc₂, rfl⟩ := Submodule.mem_sup.1 hc'
  -- Everything but `c₁` lies in the weight spaces of weights other than `χ`.
  have hrest : a + b + c₂ ∈ ⨆ ψ ∈ T, ⨅ k, (ad R L (H k)).eigenspace (ψ k : R) := by
    refine add_mem (add_mem ?_ ?_) (h.span_rightNormedBracket_le_iInf_eigenspace_ad T hc₂)
    · refine IsConcreteLE.le_iff.1 (biSup_mono fun ψ hψ => ?_)
        (h.lieSpan_F_le_biSup_iInf_eigenspace_ad ha)
      rintro rfl
      -- `Serre/Triangular.lean` writes the columns of `CM` as `CMᵀ`; entrywise they are `CM.col`.
      have hcol : -CMᵀ = -CM.col := funext₂ fun j k => by simp
      exact hneg (hcol ▸ hψ)
    · have h0T : (0 : B → ℤ) ∈ T := Ne.symm h0
      refine IsConcreteLE.le_iff.1
        (le_biSup (fun ψ : B → ℤ => ⨅ k, (ad R L (H k)).eigenspace (ψ k : R)) h0T) ?_
      simpa using h.span_H_le_iInf_eigenspace_ad_zero hb
  -- That part also has weight `χ`, so it vanishes by the independence of the weight spaces.
  have hzero : a + b + c₂ = 0 := by
    have hd := h.iSupIndep_iInf_eigenspace_ad.disjoint_biSup (x := χ) (y := T) (by simp [T])
    refine (Submodule.disjoint_def.1 hd) _ ?_ hrest
    have hsub : a + b + (c₁ + c₂) - c₁ = a + b + c₂ := by abel
    simpa only [hsub] using sub_mem hx (hWχ hc₁)
  have hx'' : a + b + (c₁ + c₂) = a + b + c₂ + c₁ := by abel
  rwa [hx'', hzero, zero_add]

/-- **The weight space of a column is spanned by its raising generator.** Over a
characteristic-zero domain on which `L` is torsion-free, in a Lie algebra generated by the raising
and lowering families of a Serre system for a matrix `CM` with linearly independent columns, the
simultaneous eigenspace of the `ad Hₖ` whose weight is the `i`-th column of `CM` is the line spanned
by `Eᵢ`. -/
theorem iInf_eigenspace_ad_col_eq_span_singleton
    (hspan : lieSpan R L (Set.range E ∪ Set.range F) = ⊤) (hCM : LinearIndependent ℤ CM.col)
    (i : B) :
    ⨅ k, (ad R L (H k)).eigenspace (CM k i : R) = R ∙ E i := by
  have hneg : CM.col i ∉ AddSubsemigroup.closure (Set.range (-CM.col)) := by
    simpa using hCM.nsmul_notMem_closure_range_neg i one_ne_zero
  have hspan' := h.iInf_eigenspace_ad_eq_span_rightNormedBracket hspan (hCM.ne_zero i) hneg
  simp only [col_apply] at hspan'
  rw [hspan']
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_ofPred_eq, Prod.exists, Set.mem_singleton_iff]
  refine ⟨?_, fun hx => ⟨i, [], by simp, by simp [hx]⟩⟩
  rintro ⟨j, w, hw, rfl⟩
  -- The only word of weight the `i`-th column is the one-letter word `i`.
  have hrep : j :: w = List.replicate 1 i :=
    hCM.eq_replicate_of_sum_map_eq_nsmul (by rwa [one_nsmul])
  rw [List.replicate_one, List.cons.injEq] at hrep
  rw [hrep.1, hrep.2, rightNormedBracket_nil]

/-- **The weight space of a multiple of a column vanishes.** Over a characteristic-zero domain on
which `L` is torsion-free, in a Lie algebra generated by the raising and lowering families of a
Serre system for a matrix `CM` with linearly independent columns, the simultaneous eigenspace of the
`ad Hₖ` whose weight is `m` times the `i`-th column of `CM` is zero for `m ≥ 2`. -/
theorem iInf_eigenspace_ad_nsmul_col_eq_bot
    (hspan : lieSpan R L (Set.range E ∪ Set.range F) = ⊤) (hCM : LinearIndependent ℤ CM.col)
    (i : B) {m : ℕ} (hm : 2 ≤ m) :
    ⨅ k, (ad R L (H k)).eigenspace ((m * CM k i : ℤ) : R) = ⊥ := by
  have h0 : m • CM.col i ≠ 0 := fun h0 => hCM.ne_zero i <| by
    rw [← natCast_zsmul] at h0
    exact (smul_eq_zero.1 h0).resolve_left (by omega)
  have hspan' := h.iInf_eigenspace_ad_eq_span_rightNormedBracket hspan h0
    (hCM.nsmul_notMem_closure_range_neg i (by omega))
  simp only [Pi.smul_apply, col_apply, nsmul_eq_mul] at hspan'
  rw [hspan', Submodule.span_eq_bot]
  rintro _ ⟨⟨j, w⟩, hw, rfl⟩
  -- A word of weight `m` times the `i`-th column consists of `m ≥ 2` letters `i`.
  have hrep : j :: w = List.replicate m i := hCM.eq_replicate_of_sum_map_eq_nsmul hw
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le' hm
  rw [List.replicate_succ, List.cons.injEq] at hrep
  dsimp only
  rw [hrep.1, hrep.2]
  exact rightNormedBracket_eq_zero_of_forall_mem_eq E (by simp)
    fun k hk => List.eq_of_mem_replicate hk

end IsSerreSystem

/-! ## The presented algebra -/

section Presented

variable [DecidableEq B] (CM) (K : Type*) [Field K] [CharZero K]

/-- Over a field of characteristic zero, a weight space of the Lie algebra presented by Serre's
relations whose weight is neither zero nor a sum of negated columns of `CM` is spanned by the
right-normed brackets of the generators `Eᵢ` of that weight. -/
theorem iInf_eigenspace_ad_serreH_eq_span_rightNormedBracket {χ : B → ℤ} (h0 : χ ≠ 0)
    (hneg : χ ∉ AddSubsemigroup.closure (Set.range (-CM.col))) :
    ⨅ k, (ad K (Matrix.ToLieAlgebra K CM) (serreH K CM k)).eigenspace (χ k : K) =
      Submodule.span K ((fun p : B × List B => rightNormedBracket (serreE K CM) p.1 p.2) ''
        {p | ((p.1 :: p.2).map CM.col).sum = χ}) :=
  (isSerreSystem_serre K CM).iInf_eigenspace_ad_eq_span_rightNormedBracket
    (lieSpan_serreE_union_serreF_eq_top K CM) h0 hneg

/-- Over a field of characteristic zero, if the columns of `CM` are linearly independent, the
weight space of the `i`-th column in the Lie algebra presented by Serre's relations is the line
spanned by the generator `Eᵢ`. -/
theorem iInf_eigenspace_ad_serreH_col_eq_span_singleton (hCM : LinearIndependent ℤ CM.col)
    (i : B) :
    ⨅ k, (ad K (Matrix.ToLieAlgebra K CM) (serreH K CM k)).eigenspace (CM k i : K) =
      K ∙ serreE K CM i :=
  (isSerreSystem_serre K CM).iInf_eigenspace_ad_col_eq_span_singleton
    (lieSpan_serreE_union_serreF_eq_top K CM) hCM i

/-- Over a field of characteristic zero, if the columns of `CM` are linearly independent, the
weight space of `m` times the `i`-th column in the Lie algebra presented by Serre's relations is
zero for `m ≥ 2`. -/
theorem iInf_eigenspace_ad_serreH_nsmul_col_eq_bot (hCM : LinearIndependent ℤ CM.col) (i : B)
    {m : ℕ} (hm : 2 ≤ m) :
    ⨅ k, (ad K (Matrix.ToLieAlgebra K CM) (serreH K CM k)).eigenspace ((m * CM k i : ℤ) : K) =
      ⊥ :=
  (isSerreSystem_serre K CM).iInf_eigenspace_ad_nsmul_col_eq_bot
    (lieSpan_serreE_union_serreF_eq_top K CM) hCM i hm

end Presented

end TauCeti
