module

public import TauCeti.Algebra.Group.Subsemigroup.Pointwise
public import TauCeti.Algebra.Lie.Presentation.Serre.Integrable
public import TauCeti.Algebra.Lie.Subalgebra.LieSpan

/-!
# The triangular decomposition of a Lie algebra generated by a Serre system

Let `(H, E, F)` be a Serre system for a matrix of integers `CM` in a Lie algebra `L`
(`TauCeti.IsSerreSystem`), and suppose that the raising and lowering families `E` and `F` generate
`L`. The motivating example is the Lie algebra `Matrix.ToLieAlgebra R CM` presented by Serre's
relations, with its own generators. Write `n⁺` and `n⁻` for the Lie subalgebras generated by the
`Eᵢ` and by the `Fᵢ`, and `𝔥` for the span of the `Hᵢ`. This file proves the **triangular
decomposition**

`L = n⁻ + 𝔥 + n⁺`

(`TauCeti.IsSerreSystem.lieSpan_F_sup_span_H_sup_lieSpan_E_eq_top`), and reads off where the
simultaneous eigenvalues of the `ad Hᵢ` can lie.

The decomposition comes from the adjoint action of the generators on `V = n⁻ + 𝔥 + n⁺`. Each
`ad Hᵢ` preserves `n⁺` and `n⁻`, since it rescales their generators. The bracket `⁅Eᵢ, Fⱼ⁆` is
`Hᵢ` or `0`, so `ad Eᵢ` carries each generator of `n⁻` into `𝔥`. As `ad Eᵢ` is a derivation and
`𝔥` normalizes `n⁻`, it then carries all of `n⁻` into `n⁻ + 𝔥`
(`LieSubalgebra.lie_mem_sup_of_mem_lieSpan`). It carries `𝔥` and `n⁺` into `n⁺`, so it
preserves `V`, and by the same argument with the roles of the two families exchanged so does
`ad Fᵢ`. The elements whose adjoint action preserves `V` form a Lie subalgebra by the Jacobi
identity, so they are all of `L`. Then `V` is a Lie subalgebra containing the generators, so it is
`L`. Only the first five of Serre's relations are used: the higher relations play no part.

Weights are integral eigenvalue families `χ : B → ℤ` of the commuting operators `ad Hᵢ`. The
generator `Eⱼ` has weight the `j`-th column `CMᵀ j` of `CM`, and the bracket adds weights, so
every element of `n⁺` is a sum of weight vectors whose weights lie in the additive subsemigroup
generated by the columns: the nonzero sums of columns with nonnegative integer coefficients
(`TauCeti.IsSerreSystem.lieSpan_E_le_biSup_iInf_eigenspace_ad`). Likewise the weights of `n⁻` are
sums of negated columns, and `𝔥` has weight `0`. Over a characteristic-zero domain on which `L` is
torsion-free, the weight spaces are independent
(`TauCeti.IsSerreSystem.iSupIndep_iInf_eigenspace_ad`), and the triangular decomposition gives:

* a weight space is zero unless its weight is `0`, a positive weight or a negative weight
  (`TauCeti.IsSerreSystem.iInf_eigenspace_ad_eq_bot`);
* when `0` is not a positive weight, the weight space of `0`, that is the common centralizer of
  the `Hᵢ`, is exactly `𝔥` (`TauCeti.IsSerreSystem.iInf_eigenspace_ad_zero_eq_span`).

The hypothesis that `0` is not a positive weight cannot simply be dropped: if `CM` is the zero
matrix, every `Eᵢ` has weight `0`. It holds whenever `CM` is nondegenerate, in particular for a
Cartan matrix, since a vanishing combination of columns is a vector in the kernel of `CM`.

These are the first steps of Serre's theorem identifying `Matrix.ToLieAlgebra K CM`, for a Cartan
matrix `CM` over a field `K` of characteristic zero, with the finite-dimensional split semisimple
Lie algebra of that Cartan matrix: they reduce the presented algebra to its Cartan part and the
positive and negative weight spaces, which the Weyl group symmetry of the integrable adjoint
representation (`TauCeti/Algebra/Lie/Presentation/Serre/Integrable.lean`) then controls.

## Main results

* `TauCeti.IsSerreSystem.lie_E_mem_lieSpan_F_sup_span_H` and
  `TauCeti.IsSerreSystem.lie_F_mem_lieSpan_E_sup_span_H`: `ad Eᵢ` carries `n⁻` into `n⁻ + 𝔥`, and
  `ad Fᵢ` carries `n⁺` into `n⁺ + 𝔥`.
* `TauCeti.IsSerreSystem.lieSpan_F_sup_span_H_sup_lieSpan_E_eq_top`: the triangular decomposition
  `L = n⁻ + 𝔥 + n⁺`.
* `TauCeti.IsSerreSystem.lieSpan_E_le_biSup_iInf_eigenspace_ad` and
  `TauCeti.IsSerreSystem.lieSpan_F_le_biSup_iInf_eigenspace_ad`: the weights of `n⁺` and `n⁻`
  are positive and negative.
* `TauCeti.IsSerreSystem.iInf_eigenspace_ad_eq_bot`: only `0`, positive and negative weights
  occur.
* `TauCeti.IsSerreSystem.iInf_eigenspace_ad_zero_eq_span`: the weight space of `0` is `𝔥`.
* `TauCeti.lieSpan_serreF_sup_span_serreH_sup_lieSpan_serreE_eq_top`,
  `TauCeti.iInf_eigenspace_ad_serreH_eq_bot` and `TauCeti.iInf_eigenspace_ad_serreH_zero_eq_span`:
  the same statements for the Lie algebra presented by Serre's relations.

## References

* [J.P. Serre, *Complex Semisimple Lie Algebras*][serre1965], chapter VI, appendix
* [J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*][humphreys1972],
  §18.2
* V. G. Kac, *Infinite Dimensional Lie Algebras*, 3rd ed., Theorem 1.2.
-/

public section

open LieAlgebra LieSubalgebra Matrix

namespace TauCeti

variable {B R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] {CM : Matrix B B ℤ}
  {H E F : B → L}

namespace IsSerreSystem

/-! ## The triangular decomposition -/

section Triangular

variable (h : IsSerreSystem R CM H E F)
include h

/-- The span of the Cartan generators normalizes the Lie subalgebra generated by the raising
generators, since each `ad Hᵢ` rescales each `Eⱼ`. -/
theorem lie_mem_lieSpan_E_of_mem_span_H {u y : L} (hu : u ∈ Submodule.span R (Set.range H))
    (hy : y ∈ lieSpan R L (Set.range E)) : ⁅u, y⁆ ∈ lieSpan R L (Set.range E) := by
  induction hu using Submodule.span_induction with
  | mem _ hu =>
    obtain ⟨i, rfl⟩ := hu
    refine lie_mem_of_mem_lieSpan ?_ hy
    rintro _ ⟨j, rfl⟩
    rw [h.lie_H_E]
    exact zsmul_mem (subset_lieSpan (Set.mem_range_self j)) _
  | zero => simp
  | add u v _ _ hu hv =>
    rw [add_lie]
    exact add_mem hu hv
  | smul a u _ hu =>
    rw [smul_lie]
    exact LieSubalgebra.smul_mem _ a hu

/-- The span of the Cartan generators normalizes the Lie subalgebra generated by the lowering
generators, since each `ad Hᵢ` rescales each `Fⱼ`. -/
theorem lie_mem_lieSpan_F_of_mem_span_H {u y : L} (hu : u ∈ Submodule.span R (Set.range H))
    (hy : y ∈ lieSpan R L (Set.range F)) : ⁅u, y⁆ ∈ lieSpan R L (Set.range F) := by
  induction hu using Submodule.span_induction with
  | mem _ hu =>
    obtain ⟨i, rfl⟩ := hu
    refine lie_mem_of_mem_lieSpan ?_ hy
    rintro _ ⟨j, rfl⟩
    rw [h.lie_H_F]
    exact neg_mem (zsmul_mem (subset_lieSpan (Set.mem_range_self j)) _)
  | zero => simp
  | add u v _ _ hu hv =>
    rw [add_lie]
    exact add_mem hu hv
  | smul a u _ hu =>
    rw [smul_lie]
    exact LieSubalgebra.smul_mem _ a hu

/-- `ad Eᵢ` carries the Lie subalgebra generated by the lowering generators into its sum with the
span of the Cartan generators: on the generators, `⁅Eᵢ, Fⱼ⁆` is `Hᵢ` or `0`. -/
theorem lie_E_mem_lieSpan_F_sup_span_H (i : B) {y : L} (hy : y ∈ lieSpan R L (Set.range F)) :
    ⁅E i, y⁆ ∈ (lieSpan R L (Set.range F)).toSubmodule ⊔ Submodule.span R (Set.range H) := by
  refine lie_mem_sup_of_mem_lieSpan (fun u hu z hz => h.lie_mem_lieSpan_F_of_mem_span_H hu hz)
    ?_ hy
  rintro _ ⟨j, rfl⟩
  rcases eq_or_ne i j with rfl | hij
  · rw [h.lie_E_F_self]
    exact Submodule.mem_sup_right (Submodule.subset_span ⟨i, rfl⟩)
  · rw [h.lie_E_F_of_ne i j hij]
    exact zero_mem _

/-- `ad Fᵢ` carries the Lie subalgebra generated by the raising generators into its sum with the
span of the Cartan generators: on the generators, `⁅Fᵢ, Eⱼ⁆` is `-Hᵢ` or `0`. -/
theorem lie_F_mem_lieSpan_E_sup_span_H (i : B) {y : L} (hy : y ∈ lieSpan R L (Set.range E)) :
    ⁅F i, y⁆ ∈ (lieSpan R L (Set.range E)).toSubmodule ⊔ Submodule.span R (Set.range H) := by
  refine lie_mem_sup_of_mem_lieSpan (fun u hu z hz => h.lie_mem_lieSpan_E_of_mem_span_H hu hz)
    ?_ hy
  rintro _ ⟨j, rfl⟩
  rw [← lie_skew]
  rcases eq_or_ne j i with rfl | hji
  · rw [h.lie_E_F_self]
    exact Submodule.mem_sup_right (neg_mem (Submodule.subset_span ⟨j, rfl⟩))
  · rw [h.lie_E_F_of_ne j i hji, neg_zero]
    exact zero_mem _

/-- **The triangular decomposition.** A Lie algebra generated by the raising and lowering families
of a Serre system is the sum `n⁻ + 𝔥 + n⁺` of the Lie subalgebra generated by the lowering
generators, the span of the Cartan generators, and the Lie subalgebra generated by the raising
generators. -/
theorem lieSpan_F_sup_span_H_sup_lieSpan_E_eq_top
    (hspan : lieSpan R L (Set.range E ∪ Set.range F) = ⊤) :
    (lieSpan R L (Set.range F)).toSubmodule ⊔ Submodule.span R (Set.range H) ⊔
      (lieSpan R L (Set.range E)).toSubmodule = ⊤ := by
  set V := (lieSpan R L (Set.range F)).toSubmodule ⊔ Submodule.span R (Set.range H) ⊔
    (lieSpan R L (Set.range E)).toSubmodule
  have hFV : ∀ y ∈ lieSpan R L (Set.range F), y ∈ V := fun y hy =>
    Submodule.mem_sup_left (Submodule.mem_sup_left hy)
  have hHV : ∀ y ∈ Submodule.span R (Set.range H), y ∈ V := fun y hy =>
    Submodule.mem_sup_left (Submodule.mem_sup_right hy)
  have hEV : ∀ y ∈ lieSpan R L (Set.range E), y ∈ V := fun y hy => Submodule.mem_sup_right hy
  -- The adjoint action of each generator preserves `V`.
  have hgen : ∀ x ∈ Set.range E ∪ Set.range F, ∀ v ∈ V, ⁅x, v⁆ ∈ V := by
    rintro _ (⟨i, rfl⟩ | ⟨i, rfl⟩) v hv
    all_goals
      obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.1 hv
      obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hab
      rw [lie_add, lie_add, ← lie_skew _ b]
      refine add_mem (add_mem ?_ (neg_mem ?_)) ?_
    · exact Submodule.mem_sup_left (h.lie_E_mem_lieSpan_F_sup_span_H i ha)
    · exact hEV _ (h.lie_mem_lieSpan_E_of_mem_span_H hb (subset_lieSpan (Set.mem_range_self i)))
    · exact hEV _ (lie_mem _ (subset_lieSpan (Set.mem_range_self i)) hc)
    · exact hFV _ (lie_mem _ (subset_lieSpan (Set.mem_range_self i)) ha)
    · exact hFV _ (h.lie_mem_lieSpan_F_of_mem_span_H hb (subset_lieSpan (Set.mem_range_self i)))
    · obtain ⟨a', ha', b', hb', hab'⟩ :=
        Submodule.mem_sup.1 (h.lie_F_mem_lieSpan_E_sup_span_H i hc)
      rw [← hab']
      exact add_mem (hEV _ ha') (hHV _ hb')
  -- Hence the adjoint action of every element of `L` preserves `V`.
  have hall : ∀ x : L, ∀ v ∈ V, ⁅x, v⁆ ∈ V := by
    intro x
    have hx : x ∈ lieSpan R L (Set.range E ∪ Set.range F) := hspan ▸ mem_top x
    induction hx using lieSpan_induction with
    | mem x hx => exact hgen x hx
    | zero => simp
    | add x y _ _ hx hy =>
      intro v hv
      rw [add_lie]
      exact add_mem (hx v hv) (hy v hv)
    | smul a x _ hx =>
      intro v hv
      rw [smul_lie]
      exact V.smul_mem a (hx v hv)
    | lie x y _ _ hx hy =>
      intro v hv
      rw [lie_lie]
      exact sub_mem (hx _ (hy v hv)) (hy _ (hx v hv))
  -- So `V` is a Lie subalgebra containing the generators.
  let V' : LieSubalgebra R L := { V with lie_mem' := fun {x _} _ hy => hall x _ hy }
  have hle : lieSpan R L (Set.range E ∪ Set.range F) ≤ V' := by
    rw [lieSpan_le]
    rintro _ (⟨i, rfl⟩ | ⟨i, rfl⟩)
    · exact hEV _ (subset_lieSpan (Set.mem_range_self i))
    · exact hFV _ (subset_lieSpan (Set.mem_range_self i))
  rw [eq_top_iff]
  intro x _
  exact hle (hspan ▸ mem_top x)

end Triangular

/-! ## Weights -/

section Weights

variable (h : IsSerreSystem R CM H E F)
include h

/-- **The weights of the raising part are positive.** Every element of the Lie subalgebra
generated by the raising generators is a sum of simultaneous eigenvectors of the `ad Hᵢ` whose
eigenvalues lie in the additive subsemigroup generated by the columns of `CM`. -/
theorem lieSpan_E_le_biSup_iInf_eigenspace_ad :
    (lieSpan R L (Set.range E)).toSubmodule ≤
      ⨆ χ ∈ AddSubsemigroup.closure (Set.range CMᵀ),
        ⨅ i, (ad R L (H i)).eigenspace (χ i : R) := by
  intro x hx
  induction hx using lieSpan_induction with
  | mem _ hx =>
    obtain ⟨j, rfl⟩ := hx
    refine Submodule.mem_iSup_of_mem (CMᵀ j) <|
      Submodule.mem_iSup_of_mem (AddSubsemigroup.subset_closure ⟨j, rfl⟩) ?_
    simp [h.lie_H_E, Int.cast_smul_eq_zsmul]
  | zero => exact zero_mem _
  | add _ _ _ _ hx hy => exact add_mem hx hy
  | smul a _ _ hx => exact Submodule.smul_mem _ a hx
  | lie _ _ _ _ hx hy => exact lie_mem_biSup_iInf_eigenspace_ad_intCast hx hy

/-- **The weights of the lowering part are negative.** Every element of the Lie subalgebra
generated by the lowering generators is a sum of simultaneous eigenvectors of the `ad Hᵢ` whose
eigenvalues lie in the additive subsemigroup generated by the negated columns of `CM`. -/
theorem lieSpan_F_le_biSup_iInf_eigenspace_ad :
    (lieSpan R L (Set.range F)).toSubmodule ≤
      ⨆ χ ∈ AddSubsemigroup.closure (Set.range (-CMᵀ)),
        ⨅ i, (ad R L (H i)).eigenspace (χ i : R) := by
  intro x hx
  induction hx using lieSpan_induction with
  | mem _ hx =>
    obtain ⟨j, rfl⟩ := hx
    refine Submodule.mem_iSup_of_mem ((-CMᵀ) j) <|
      Submodule.mem_iSup_of_mem (AddSubsemigroup.subset_closure ⟨j, rfl⟩) ?_
    simp [h.lie_H_F, Int.cast_smul_eq_zsmul]
  | zero => exact zero_mem _
  | add _ _ _ _ hx hy => exact add_mem hx hy
  | smul a _ _ hx => exact Submodule.smul_mem _ a hx
  | lie _ _ _ _ hx hy => exact lie_mem_biSup_iInf_eigenspace_ad_intCast hx hy

/-- The Cartan generators commute, so their span has weight `0`. -/
private theorem span_H_le_iInf_eigenspace_ad_zero :
    Submodule.span R (Set.range H) ≤ ⨅ i, (ad R L (H i)).eigenspace 0 := by
  rw [Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  simp [h.lie_H_H]

/-- Every element of `L` is the sum of an element of the span of the negative weight spaces, an
element of the span of the Cartan generators, and an element of the span of the positive weight
spaces. -/
private theorem exists_add_add_eq
    (hspan : lieSpan R L (Set.range E ∪ Set.range F) = ⊤) (x : L) :
    ∃ a ∈ ⨆ χ ∈ AddSubsemigroup.closure (Set.range (-CMᵀ)),
        ⨅ i, (ad R L (H i)).eigenspace (χ i : R),
      ∃ b ∈ Submodule.span R (Set.range H),
      ∃ c ∈ ⨆ χ ∈ AddSubsemigroup.closure (Set.range CMᵀ),
        ⨅ i, (ad R L (H i)).eigenspace (χ i : R),
      a + b + c = x := by
  have hx : x ∈ (lieSpan R L (Set.range F)).toSubmodule ⊔ Submodule.span R (Set.range H) ⊔
      (lieSpan R L (Set.range E)).toSubmodule := by
    rw [h.lieSpan_F_sup_span_H_sup_lieSpan_E_eq_top hspan]
    exact Submodule.mem_top
  obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.1 hx
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hab
  exact ⟨a, h.lieSpan_F_le_biSup_iInf_eigenspace_ad ha, b, hb, c,
    h.lieSpan_E_le_biSup_iInf_eigenspace_ad hc, rfl⟩

variable [IsDomain R] [CharZero R] [Module.IsTorsionFree R L]

/-- **Only zero, positive and negative weights occur.** Over a characteristic-zero domain on which
`L` is torsion-free, in a Lie algebra generated by the raising and lowering families of a Serre
system, the simultaneous eigenspace of the `ad Hᵢ` for an integral eigenvalue family `χ` vanishes
unless `χ` is `0`, a sum of columns of `CM`, or a sum of negated columns of `CM`. -/
theorem iInf_eigenspace_ad_eq_bot (hspan : lieSpan R L (Set.range E ∪ Set.range F) = ⊤)
    {χ : B → ℤ} (h0 : χ ≠ 0) (hpos : χ ∉ AddSubsemigroup.closure (Set.range CMᵀ))
    (hneg : χ ∉ AddSubsemigroup.closure (Set.range (-CMᵀ))) :
    ⨅ i, (ad R L (H i)).eigenspace (χ i : R) = ⊥ := by
  set T : Set (B → ℤ) := {ψ | ψ ∈ AddSubsemigroup.closure (Set.range (-CMᵀ)) ∨ ψ = 0 ∨
    ψ ∈ AddSubsemigroup.closure (Set.range CMᵀ)}
  have htop : ⨆ ψ ∈ T, ⨅ i, (ad R L (H i)).eigenspace (ψ i : R) = ⊤ := by
    refine eq_top_iff.2 fun x _ => ?_
    obtain ⟨a, ha, b, hb, c, hc, rfl⟩ := h.exists_add_add_eq hspan x
    refine add_mem (add_mem ?_ ?_) ?_
    · exact IsConcreteLE.le_iff.1 (biSup_mono fun ψ hψ => Or.inl hψ) ha
    · have h0T : (0 : B → ℤ) ∈ T := Or.inr (Or.inl rfl)
      refine IsConcreteLE.le_iff.1
        (le_biSup (fun ψ : B → ℤ => ⨅ i, (ad R L (H i)).eigenspace (ψ i : R)) h0T) ?_
      simpa using h.span_H_le_iInf_eigenspace_ad_zero hb
    · exact IsConcreteLE.le_iff.1 (biSup_mono fun ψ hψ => Or.inr (Or.inr hψ)) hc
  have hχT : χ ∉ T := by simp [T, hneg, h0, hpos]
  have hd := h.iSupIndep_iInf_eigenspace_ad.disjoint_biSup hχT
  rwa [htop, disjoint_top] at hd

/-- **The weight space of zero is the span of the Cartan generators.** Over a characteristic-zero
domain on which `L` is torsion-free, in a Lie algebra generated by the raising and lowering
families of a Serre system for a matrix `CM` no nonzero sum of whose columns with nonnegative
integer coefficients vanishes, the common centralizer of the `Hᵢ` is the span of the `Hᵢ`. -/
theorem iInf_eigenspace_ad_zero_eq_span (hspan : lieSpan R L (Set.range E ∪ Set.range F) = ⊤)
    (h0 : (0 : B → ℤ) ∉ AddSubsemigroup.closure (Set.range CMᵀ)) :
    ⨅ i, (ad R L (H i)).eigenspace 0 = Submodule.span R (Set.range H) := by
  refine le_antisymm (fun x hx => ?_) h.span_H_le_iInf_eigenspace_ad_zero
  obtain ⟨a, ha, b, hb, c, hc, rfl⟩ := h.exists_add_add_eq hspan x
  set T : Set (B → ℤ) := {ψ | ψ ∈ AddSubsemigroup.closure (Set.range (-CMᵀ)) ∨
    ψ ∈ AddSubsemigroup.closure (Set.range CMᵀ)}
  -- `a + c` has weight `0` and lies in the span of the nonzero weight spaces, so it vanishes.
  have hac : a + c = 0 := by
    have hd := h.iSupIndep_iInf_eigenspace_ad.disjoint_biSup (x := 0) (y := T) <| by
      rintro (h' | h')
      · -- The negated columns of `CM` are the negations of the columns of `CM`.
        have hs : Set.range (-CMᵀ) ⊆ -Set.range CMᵀ :=
          Set.range_subset_iff.2 fun j => Set.mem_neg.2 ⟨j, funext fun i => by simp⟩
        have h'' := (AddSubsemigroup.mem_closure_neg _ _).1 (AddSubsemigroup.closure_mono hs h')
        exact h0 (by simpa using h'')
      · exact h0 h'
    refine (Submodule.disjoint_def.1 hd) _ ?_ ?_
    · have hb' := h.span_H_le_iInf_eigenspace_ad_zero hb
      have := sub_mem hx hb'
      rw [add_right_comm, add_sub_cancel_right] at this
      simpa using this
    · exact add_mem (IsConcreteLE.le_iff.1 (biSup_mono fun ψ hψ => Or.inl hψ) ha)
        (IsConcreteLE.le_iff.1 (biSup_mono fun ψ hψ => Or.inr hψ) hc)
  rwa [add_right_comm, hac, zero_add]

end Weights

end IsSerreSystem

/-! ## The presented algebra -/

section Presented

variable [DecidableEq B] (R CM)

/-- **The triangular decomposition of the Lie algebra presented by Serre's relations**: it is the
sum of the Lie subalgebra generated by the `Fᵢ`, the span of the `Hᵢ`, and the Lie subalgebra
generated by the `Eᵢ`. -/
theorem lieSpan_serreF_sup_span_serreH_sup_lieSpan_serreE_eq_top :
    (lieSpan R (Matrix.ToLieAlgebra R CM) (Set.range (serreF R CM))).toSubmodule ⊔
        Submodule.span R (Set.range (serreH R CM)) ⊔
      (lieSpan R (Matrix.ToLieAlgebra R CM) (Set.range (serreE R CM))).toSubmodule = ⊤ :=
  (isSerreSystem_serre R CM).lieSpan_F_sup_span_H_sup_lieSpan_E_eq_top
    (lieSpan_serreE_union_serreF_eq_top R CM)

/-- Over a field of characteristic zero, the Lie algebra presented by Serre's relations has no
weights other than `0`, the sums of columns of `CM`, and the sums of negated columns of `CM`. -/
theorem iInf_eigenspace_ad_serreH_eq_bot (K : Type*) [Field K] [CharZero K] {χ : B → ℤ}
    (h0 : χ ≠ 0) (hpos : χ ∉ AddSubsemigroup.closure (Set.range CMᵀ))
    (hneg : χ ∉ AddSubsemigroup.closure (Set.range (-CMᵀ))) :
    ⨅ i, (ad K (Matrix.ToLieAlgebra K CM) (serreH K CM i)).eigenspace (χ i : K) = ⊥ :=
  (isSerreSystem_serre K CM).iInf_eigenspace_ad_eq_bot (lieSpan_serreE_union_serreF_eq_top K CM)
    h0 hpos hneg

/-- Over a field of characteristic zero, if no nonzero sum of columns of `CM` with nonnegative
integer coefficients vanishes, then the common centralizer of the generators `Hᵢ` of the Lie
algebra presented by Serre's relations is their span. -/
theorem iInf_eigenspace_ad_serreH_zero_eq_span (K : Type*) [Field K] [CharZero K]
    (h0 : (0 : B → ℤ) ∉ AddSubsemigroup.closure (Set.range CMᵀ)) :
    ⨅ i, (ad K (Matrix.ToLieAlgebra K CM) (serreH K CM i)).eigenspace 0 =
      Submodule.span K (Set.range (serreH K CM)) :=
  (isSerreSystem_serre K CM).iInf_eigenspace_ad_zero_eq_span
