/-!
# The root weight spaces of a Lie algebra generated by a Serre system

Let `b` be a base of a finite reduced crystallographic root system `P`, and let `(H, E, F)` be a
Serre system for the transposed Cartan matrix `b.cartanMatrixᵀ` that generates a Lie algebra `L`
over a field of characteristic zero; the motivating example is the presented algebra
`Matrix.ToLieAlgebra K b.cartanMatrixᵀ`. Write `L_χ` for the simultaneous eigenspace of the `ad Hₖ`
of an integral weight `χ`. A root `αⱼ` has the integral weight `k ↦ ⟨αⱼ, αₖ∨⟩`, which is the weight
of `Eⱼ` when `j` is simple. The simple reflections act on these weights as on the roots, and the
Weyl automorphisms of `L` permute its weight spaces accordingly, so the simple-root cases in
`TauCeti/Algebra/Lie/Presentation/Serre/Word.lean` spread to all the roots:

* the weight space of a root is spanned by one vector
  (`TauCeti.IsSerreSystem.exists_iInf_eigenspace_ad_pairingIn_eq_span_singleton`);
* the weight space of a multiple `m ≥ 2` of a root vanishes
  (`TauCeti.IsSerreSystem.iInf_eigenspace_ad_mul_pairingIn_eq_bot`);
* the weight space of every other nonzero weight vanishes
  (`TauCeti.IsSerreSystem.iInf_eigenspace_ad_eq_bot_of_ne_pairingIn`). The nonzero weights are
  positive or negative and are permuted by the simple reflections, and a weight whose whole orbit
  is signed is a positive multiple of a root
  (`RootPairing.Base.exists_eq_nsmul_pairingIn_of_reflection`).

Now let `P` be the root system of a finite-dimensional Lie algebra `L` with nondegenerate Killing
form and a splitting Cartan subalgebra `H`, and let the Serre system come from `sl₂` triples for the
simple roots generating `L`. Serre's theorem says that the resulting surjection
`TauCeti.serreLift : Matrix.ToLieAlgebra K b.cartanMatrixᵀ → L` is injective. This file proves that
its kernel can only live on weights that are neither zero nor a root:

* it carries the weight space of a root `α` onto `rootSpace H α`
  (`TauCeti.map_serreLift_iInf_eigenspace_ad_pairingIn`), and has trivial kernel there
  (`TauCeti.ker_serreLift_inf_iInf_eigenspace_ad_pairingIn`);
* it has trivial kernel on the weight space of `0`
  (`TauCeti.ker_serreLift_inf_iInf_eigenspace_ad_zero`);
* its kernel lies in the sum of the weight spaces of the remaining weights
  (`TauCeti.ker_serreLift_le_iSup_iInf_eigenspace_ad`).

Since those weight spaces vanish, the lift is injective; this is assembled in
`TauCeti/Algebra/Lie/Presentation/Serre/Injective.lean`.

The comparison of weight spaces rests on
`TauCeti.IsSerreSystem.map_iInf_eigenspace_ad_of_surjective` from
`TauCeti/Algebra/Lie/Presentation/Serre/Integrable.lean`.

## References

* [J.P. Serre, *Complex Semisimple Lie Algebras*][serre1965], chapter VI, appendix
* [J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*][humphreys1972],
  §18.3
-/

public section

open LieAlgebra LieSubalgebra Matrix

namespace TauCeti

namespace IsSerreSystem

section RootWeight

variable {ι R M N K L : Type*} [Finite ι] [CommRing R] [IsDomain R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] {P : RootPairing ι R M N}
  [P.IsRootSystem] [P.IsCrystallographic] [P.IsReduced] {b : P.Base}
  [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] {H E F : b.support → L}
  (h : IsSerreSystem K b.cartanMatrixᵀ H E F)
  (hspan : lieSpan K L (Set.range E ∪ Set.range F) = ⊤)

include h hspan

/-- **The weight space of a root is spanned by one vector.** In a Lie algebra generated by a Serre
system for the transposed Cartan matrix of a base of a reduced crystallographic root system, the
simultaneous eigenspace of the `ad Hₖ` with eigenvalues `⟨αⱼ, αₖ∨⟩` is spanned by a single
vector. -/
theorem exists_iInf_eigenspace_ad_pairingIn_eq_span_singleton (j : ι) :
    ∃ v : L, ⨅ k : b.support, (ad K L (H k)).eigenspace ((P.pairingIn ℤ j k : ℤ) : K) = K ∙ v := by
  refine b.induction_pairingIn_reflection
    (Q := fun χ ↦ ∃ v : L, ⨅ k, (ad K L (H k)).eigenspace (χ k : K) = K ∙ v) (fun i ↦ ?_)
    (fun χ i ↦ ?_) j
  · exact ⟨E i, h.iInf_eigenspace_ad_col_eq_span_singleton hspan
      b.linearIndependent_cartanMatrix_row i⟩
  · rintro ⟨v, hv⟩
    obtain ⟨τ, -, hτ⟩ := h.exists_lieEquiv_map_iInf_eigenspace hspan (i := i) (by simp)
    have hχ := hτ χ
    rw [col_transpose, hv, Submodule.map_span, Set.image_singleton] at hχ
    exact ⟨τ v, hχ.symm⟩

/-- **The weight space of a multiple of a root vanishes.** In a Lie algebra generated by a Serre
system for the transposed Cartan matrix of a base of a reduced crystallographic root system, the
simultaneous eigenspace of the `ad Hₖ` with eigenvalues `m * ⟨αⱼ, αₖ∨⟩` is zero for `m ≥ 2`. -/
theorem iInf_eigenspace_ad_mul_pairingIn_eq_bot (j : ι) {m : ℕ} (hm : 2 ≤ m) :
    ⨅ k : b.support, (ad K L (H k)).eigenspace ((m * P.pairingIn ℤ j k : ℤ) : K) = ⊥ := by
  refine b.induction_pairingIn_reflection
    (Q := fun χ ↦ ⨅ k, (ad K L (H k)).eigenspace ((m * χ k : ℤ) : K) = ⊥) (fun i ↦ ?_)
    (fun χ i hχ ↦ ?_) j
  · exact h.iInf_eigenspace_ad_nsmul_col_eq_bot hspan b.linearIndependent_cartanMatrix_row i hm
  · obtain ⟨τ, -, hτ⟩ := h.exists_lieEquiv_map_iInf_eigenspace hspan (i := i) (by simp)
    have hmap := hτ fun k ↦ m * χ k
    rw [hχ, Submodule.map_bot, col_transpose] at hmap
    have hmul (k : b.support) : (m : ℤ) * (χ - χ i • b.cartanMatrix.row i) k =
        ((fun k ↦ (m : ℤ) * χ k) - (m * χ i) • b.cartanMatrix.row i) k := by
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      ring
    simp only [hmul]
    exact hmap.symm

/-- **Only zero and the roots are weights.** In a Lie algebra generated by a Serre system for the
transposed Cartan matrix of a base of a reduced crystallographic root system, the simultaneous
eigenspace of the `ad Hₖ` with integral eigenvalues `χ` vanishes unless `χ` is zero or the weight
`k ↦ ⟨α, αₖ∨⟩` of a root `α`. -/
theorem iInf_eigenspace_ad_eq_bot_of_ne_pairingIn {χ : b.support → ℤ} (h0 : χ ≠ 0)
    (hroot : ∀ j : ι, χ ≠ fun k : b.support ↦ P.pairingIn ℤ j k) :
    ⨅ k : b.support, (ad K L (H k)).eigenspace (χ k : K) = ⊥ := by
  classical
  -- The nonzero weights form a set stable under the simple reflections, and each of them is
  -- positive or negative, so each is a positive multiple of the weight of a root.
  let Q (ψ : b.support → ℤ) : Prop := ψ ≠ 0 ∧ ⨅ k, (ad K L (H k)).eigenspace (ψ k : K) ≠ ⊥
  have hrefl (ψ : b.support → ℤ) (i : b.support) (hψ : Q ψ) :
      Q (ψ - ψ i • b.cartanMatrix.row i) := by
    obtain ⟨τ, -, hτ⟩ := h.exists_lieEquiv_map_iInf_eigenspace hspan (i := i) (by simp)
    rw [col_transpose] at hτ
    refine ⟨fun h0' ↦ hψ.1 ?_, ?_⟩
    · have hi := congrFun h0' i
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Matrix.row_apply,
        b.cartanMatrix_apply_same, Pi.zero_apply] at hi
      rw [sub_eq_zero.1 h0', show ψ i = 0 by omega, zero_smul]
    · rw [← hτ ψ]
      exact Submodule.map_eq_bot_iff.not.2 hψ.2
  have hsign (ψ : b.support → ℤ) (hψ : Q ψ) :
      ψ ∈ AddSubsemigroup.closure (Set.range b.cartanMatrix.row) ∨
        -ψ ∈ AddSubsemigroup.closure (Set.range b.cartanMatrix.row) := by
    by_contra! hsign
    -- `Matrix.row` is `Matrix.of.symm`, the identity equivalence from matrices to functions, so
    -- the rows of `CMᵀᵀ` are the rows of `A`.
    have hpos : ψ ∉ AddSubsemigroup.closure (Set.range b.cartanMatrixᵀᵀ) := by
      have h := hsign.1
      rw [Matrix.row_eq_self] at h
      rwa [transpose_transpose]
    refine hψ.2 (h.iInf_eigenspace_ad_eq_bot hspan hψ.1 hpos fun hneg ↦ hsign.2 ?_)
    -- The negated columns of `CM` are the negations of its columns.
    have hs : Set.range (-b.cartanMatrixᵀᵀ) ⊆ -Set.range b.cartanMatrix.row :=
      Set.range_subset_iff.2 fun j ↦ Set.mem_neg.2 ⟨j, funext fun i ↦ by simp⟩
    exact (AddSubsemigroup.mem_closure_neg _ _).1 (AddSubsemigroup.closure_mono hs hneg)
  by_contra hne
  obtain ⟨j, m, hm, rfl⟩ := b.exists_eq_nsmul_pairingIn_of_reflection hrefl hsign ⟨h0, hne⟩
  obtain rfl | hm2 : m = 1 ∨ 2 ≤ m := by omega
  · exact hroot j (one_smul _ _)
  · refine hne ?_
    simpa only [Pi.smul_apply, nsmul_eq_mul] using
      h.iInf_eigenspace_ad_mul_pairingIn_eq_bot hspan j hm2

end RootWeight

end IsSerreSystem

section Killing

open LieAlgebra.IsKilling LieModule

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [IsKilling K L] {H : LieSubalgebra K L} [H.IsCartanSubalgebra]
  [IsTriangularizable K H L] {b : (rootSystem H).Base} [DecidableEq b.support]
  {e f : b.support → L}
  (hS : IsSerreSystem K b.cartanMatrixᵀ (fun i ↦ (((rootSystem H).coroot i : H) : L)) e f)
  (hspan : lieSpan K L (Set.range e ∪ Set.range f) = ⊤)

include hspan in
/-- **The Serre lift carries the weight space of a root onto its root space.** Let `L` be a split
semisimple Lie algebra generated by a Serre system of simple-root `sl₂` triples. The induced
surjection from the Lie algebra presented by Serre's relations carries the weight space with
eigenvalues `⟨α, αₖ∨⟩` onto `rootSpace H α`, for every root `α`. -/
theorem map_serreLift_iInf_eigenspace_ad_pairingIn (j : H.root) :
    (⨅ k : b.support, (ad K (Matrix.ToLieAlgebra K b.cartanMatrixᵀ)
        (serreH K b.cartanMatrixᵀ k)).eigenspace (((rootSystem H).pairingIn ℤ j k : ℤ) : K)).map
          (serreLift hS : Matrix.ToLieAlgebra K b.cartanMatrixᵀ →ₗ[K] L) =
      (rootSpace H (j : Weight K H L)).toSubmodule := by
  rw [(isSerreSystem_serre K b.cartanMatrixᵀ).map_iInf_eigenspace_ad_of_surjective
    (lieSpan_serreE_union_serreF_eq_top K b.cartanMatrixᵀ) (serreLift hS)
    (serreLift_surjective hS hspan)]
  simp only [serreLift_serreH]
  have hpair (k : b.support) : (((rootSystem H).pairingIn ℤ j k : ℤ) : K) =
      (j : Weight K H L) ((rootSystem H).coroot k) := by
    have := (rootSystem H).algebraMap_pairingIn ℤ j (k : H.root)
    rwa [rootSystem_pairing_apply, algebraMap_int_eq] at this
  ext x
  simp only [Submodule.mem_iInf, Module.End.mem_eigenspace_iff, ad_apply, hpair,
    LieSubmodule.mem_toSubmodule]
  refine ⟨fun hx ↦ weightSpace_le_genWeightSpace L _ ((mem_weightSpace _ _).2 fun u ↦ ?_),
    fun hx k ↦ lie_eq_smul_of_mem_rootSpace hx _⟩
  -- The simple coroots span `H`, so the eigenvalue equations extend to all of `H`.
  have hu : u ∈ Submodule.span K ((rootSystem H).coroot '' b.support) := by
    rw [b.span_coroot_support]
    exact (RootPairing.IsRootSystem.span_coroot_eq_top (P := rootSystem H)).ge Submodule.mem_top
  induction hu using Submodule.span_induction with
  | mem _ hu =>
    obtain ⟨k, hk, rfl⟩ := hu
    exact hx ⟨k, hk⟩
  | zero => simp
  | add _ _ _ _ h₁ h₂ => simp [add_lie, add_smul, h₁, h₂]
  | smul c _ _ h₁ => simp [smul_lie, mul_smul, h₁]

include hspan in
/-- **The Serre lift is injective on the weight space of a root.** -/
theorem ker_serreLift_inf_iInf_eigenspace_ad_pairingIn (j : H.root) :
    LinearMap.ker (serreLift hS : Matrix.ToLieAlgebra K b.cartanMatrixᵀ →ₗ[K] L) ⊓
      ⨅ k : b.support, (ad K (Matrix.ToLieAlgebra K b.cartanMatrixᵀ)
        (serreH K b.cartanMatrixᵀ k)).eigenspace (((rootSystem H).pairingIn ℤ j k : ℤ) : K) =
      ⊥ := by
  obtain ⟨v, hv⟩ := (isSerreSystem_serre K
    b.cartanMatrixᵀ).exists_iInf_eigenspace_ad_pairingIn_eq_span_singleton
    (lieSpan_serreE_union_serreF_eq_top K b.cartanMatrixᵀ) j
  have hmap := map_serreLift_iInf_eigenspace_ad_pairingIn hS hspan j
  rw [hv] at hmap ⊢
  -- The weight space is a line, and its image is the nonzero root space.
  have hne : serreLift hS v ≠ 0 := fun h0 ↦ (j : Weight K H L).genWeightSpace_ne_bot L <| by
    rw [← LieSubmodule.toSubmodule_inj, ← hmap, LieSubmodule.bot_toSubmodule, Submodule.map_span,
      Set.image_singleton, Submodule.span_singleton_eq_bot]
    exact h0
  exact (Submodule.disjoint_span_singleton_of_notMem hne).eq_bot

/-- **The Serre lift is injective on the weight space of zero**, since that weight space is the
span of the Cartan generators, which the lift carries to the independent simple coroots. -/
theorem ker_serreLift_inf_iInf_eigenspace_ad_zero :
    LinearMap.ker (serreLift hS : Matrix.ToLieAlgebra K b.cartanMatrixᵀ →ₗ[K] L) ⊓
      ⨅ k : b.support, (ad K (Matrix.ToLieAlgebra K b.cartanMatrixᵀ)
        (serreH K b.cartanMatrixᵀ k)).eigenspace 0 = ⊥ := by
  have h0 : (0 : b.support → ℤ) ∉ AddSubsemigroup.closure (Set.range b.cartanMatrixᵀᵀ) := by
    rw [transpose_transpose]
    exact b.linearIndependent_cartanMatrix_row.zero_notMem_closure_range
  rw [iInf_eigenspace_ad_serreH_zero_eq_span b.cartanMatrixᵀ K h0]
  have hli : LinearIndependent K fun i : b.support ↦ (((rootSystem H).coroot i : H) : L) :=
    b.linearIndepOn_coroot.linearIndependent.map' H.toSubmodule.subtype
      (Submodule.ker_subtype _)
  refine (Submodule.range_ker_disjoint (v := serreH K b.cartanMatrixᵀ)
    (f := (serreLift hS : Matrix.ToLieAlgebra K b.cartanMatrixᵀ →ₗ[K] L)) ?_).symm.eq_bot
  simpa only [Function.comp_def, LieHom.coe_toLinearMap, serreLift_serreH] using hli

include hspan in
/-- **The kernel of the Serre lift lives on the weights that are neither zero nor a root.** The
kernel of the surjection from the Lie algebra presented by Serre's relations onto `L` lies in the
sum of the weight spaces whose weight is neither zero nor the weight `k ↦ ⟨α, αₖ∨⟩` of a root. -/
theorem ker_serreLift_le_iSup_iInf_eigenspace_ad :
    LinearMap.ker (serreLift hS : Matrix.ToLieAlgebra K b.cartanMatrixᵀ →ₗ[K] L) ≤
      ⨆ χ ∈ {χ : b.support → ℤ |
          χ ≠ 0 ∧ ∀ j : H.root, χ ≠ fun k : b.support ↦ (rootSystem H).pairingIn ℤ j k},
        ⨅ k, (ad K (Matrix.ToLieAlgebra K b.cartanMatrixᵀ)
          (serreH K b.cartanMatrixᵀ k)).eigenspace (χ k : K) := by
  have hS' := isSerreSystem_serre K b.cartanMatrixᵀ
  have hgen := lieSpan_serreE_union_serreF_eq_top K b.cartanMatrixᵀ
  rw [LinearMap.ker_eq_iSup_inf_of_map_le _ (hS'.iSup_iInf_eigenspace_ad_eq_top hgen)
    hS.iSupIndep_iInf_eigenspace_ad fun χ ↦ by
      simpa only [serreLift_serreH] using
        (hS'.map_iInf_eigenspace_ad_of_surjective hgen (serreLift hS)
          (serreLift_surjective hS hspan) χ).le]
  refine iSup_le fun χ ↦ ?_
  by_cases hχ : χ ≠ 0 ∧ ∀ j : H.root, χ ≠ fun k : b.support ↦ (rootSystem H).pairingIn ℤ j k
  · exact inf_le_right.trans (le_biSup (fun χ : b.support → ℤ ↦ ⨅ k, (ad K (Matrix.ToLieAlgebra K
      b.cartanMatrixᵀ) (serreH K b.cartanMatrixᵀ k)).eigenspace (χ k : K)) hχ)
  · have hbot : LinearMap.ker (serreLift hS : Matrix.ToLieAlgebra K b.cartanMatrixᵀ →ₗ[K] L) ⊓
        ⨅ k, (ad K (Matrix.ToLieAlgebra K b.cartanMatrixᵀ)
          (serreH K b.cartanMatrixᵀ k)).eigenspace (χ k : K) = ⊥ := by
      rcases not_and_or.1 hχ with h0 | h0
      · obtain rfl : χ = 0 := not_not.1 h0
        simpa only [Pi.zero_apply, Int.cast_zero] using
          ker_serreLift_inf_iInf_eigenspace_ad_zero hS
      · obtain ⟨j, rfl⟩ := not_forall_not.1 h0
        exact ker_serreLift_inf_iInf_eigenspace_ad_pairingIn hS hspan j
    rw [hbot]
    exact bot_le

end Killing

end TauCeti
