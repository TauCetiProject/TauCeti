/-!
# Conjugacy of Cartan involutions over `ℝ`

Over `ℝ`, any two Cartan involutions `θ` and `θ'` of the same Lie algebra `L` are conjugate by
an inner automorphism generated by an element `Z ∈ θ.cartanP` (Knapp, Ch. VI, Thm. 6.16 and
Cor. 6.19):

* `LieEquiv.IsCartanInvolution.exists_conj_spectral`: norm-free algebraic form producing an
  automorphism `φ : L ≃ₗ⁅ℝ⁆ L` intertwining `θ` and `θ'` and `Z ∈ θ.cartanP` such that `φ`
  acts as `Real.exp μ` on every `μ`-eigenvector of `ad Z`;
* `LieEquiv.IsCartanInvolution.exists_conj_exp_ad`: topological operator-exponential form showing
  that `θ' (exp (ad Z) y) = exp (ad Z) (θ y)` for all `y : L`.

Uniqueness of Cartan involutions lives in `TauCeti/Algebra/Lie/CartanInvolution/Basic.lean`,
spectral real powers and logarithmic derivations in
`TauCeti/Algebra/Lie/Automorphism/Spectral.lean`, and real adjoint diagonalizability in
`TauCeti/Algebra/Lie/CartanInvolution/Spectral.lean`.

## References

* A. W. Knapp, *Lie Groups Beyond an Introduction*, 2nd ed., Birkhäuser (2002), Chapter VI, §2,
  Theorem 6.16 and Corollary 6.19.
* S. Helgason, *Differential Geometry, Lie Groups, and Symmetric Spaces*, Academic Press (1978),
  Chapter III, §7, Theorem 7.1.
-/

public section

open LieAlgebra Module
open scoped InnerProductSpace

namespace LieEquiv

namespace IsCartanInvolution

/-! ### Inner conjugacy of Cartan involutions over `ℝ` -/

section RealConjugacy

variable {L : Type*} [LieRing L] [LieAlgebra ℝ L]

/-- For two Cartan involutions `θ` and `θ'` of a real Lie algebra, `P = (θ' ∘ θ)²` admits a
basis of eigenvectors with strictly positive eigenvalues. -/
private theorem exists_pos_eigenbasis_trans_sq {θ θ' : L ≃ₗ⁅ℝ⁆ L}
    (hθ : θ.IsCartanInvolution) (hθ' : θ'.IsCartanInvolution) :
    ∃ (B : Basis (Fin (finrank ℝ L)) ℝ L) (lam : Fin (finrank ℝ L) → ℝ),
      (∀ i, 0 < lam i) ∧
        ∀ i, ((θ.trans θ').trans (θ.trans θ')) (B i) = lam i • B i := by
  have := hθ.finiteDimensional
  let ω : L ≃ₗ⁅ℝ⁆ L := θ.trans θ'
  let P : L ≃ₗ⁅ℝ⁆ L := ω.trans ω
  have hω_symm_form (x y : L) : θ.twistedKillingForm (ω x) y = θ.twistedKillingForm x (ω y) := by
    simp only [twistedKillingForm_apply, ω, trans_apply]
    congr 1
    calc
      killingForm ℝ L (θ' (θ x)) (θ y)
        = killingForm ℝ L (θ' (θ' (θ x))) (θ' (θ y)) :=
            (LieAlgebra.killingForm_of_equiv_apply θ' (θ' (θ x)) (θ y)).symm
      _ = killingForm ℝ L (θ x) (θ' (θ y)) := by rw [hθ'.involutive]
      _ = killingForm ℝ L (θ (θ x)) (θ (θ' (θ y))) :=
            (LieAlgebra.killingForm_of_equiv_apply θ (θ x) (θ' (θ y))).symm
      _ = killingForm ℝ L x (θ (θ' (θ y))) := by rw [hθ.involutive]
  have hP_symm_form (x y : L) : θ.twistedKillingForm (P x) y = θ.twistedKillingForm x (P y) := by
    simp only [P, trans_apply, hω_symm_form]
  have hP_pos_form {x : L} (hx : x ≠ 0) : 0 < θ.twistedKillingForm (P x) x := by
    have hωne : ω x ≠ 0 := fun h ↦ hx (by simpa using congrArg ω.symm h)
    simpa only [P, trans_apply, hω_symm_form] using hθ.twistedKillingForm_pos hωne
  obtain ⟨e, he⟩ := LinearMap.BilinForm.exists_linearEquiv_euclideanSpace_apply_apply
    hθ.twistedKillingForm_isSymm (fun v hv ↦ hθ.twistedKillingForm_pos hv)
  let P_E :
      EuclideanSpace ℝ (Fin (finrank ℝ L)) →ₗ[ℝ] EuclideanSpace ℝ (Fin (finrank ℝ L)) :=
    e.symm.conj (P : L →ₗ[ℝ] L)
  have hP_E_apply (u : EuclideanSpace ℝ (Fin (finrank ℝ L))) : e (P_E u) = P (e u) := by
    simp [P_E, LinearEquiv.conj_apply_apply]
  have hP_E_symm : P_E.IsSymmetric := fun u v ↦ by
    rw [← he, ← he, hP_E_apply, hP_E_apply, hP_symm_form]
  have hn : finrank ℝ (EuclideanSpace ℝ (Fin (finrank ℝ L))) = finrank ℝ L := by simp
  let b := hP_E_symm.eigenvectorBasis hn
  refine ⟨b.toBasis.map e, hP_E_symm.eigenvalues hn, fun i ↦ ?_, fun i ↦ ?_⟩
  · have hbi := hP_E_symm.apply_eigenvectorBasis hn i
    have hinner : ⟪P_E (b i), b i⟫_ℝ = hP_E_symm.eigenvalues hn i := by
      rw [hbi, real_inner_smul_left, real_inner_self_eq_norm_sq, b.orthonormal.left i, one_pow,
        mul_one]
      simp only [RCLike.ofReal_real_eq_id, id_eq]
    rw [← hinner, ← he, hP_E_apply]
    exact hP_pos_form (fun h ↦ (b.orthonormal.ne_zero i) (by simpa using congrArg e.symm h))
  · have h2 := congrArg e (hP_E_symm.apply_eigenvectorBasis hn i)
    rw [hP_E_apply, map_smul] at h2
    simpa [b, P, ω] using h2



/-- Applying `θ` sends a `c`-eigenvector of `(θ' ∘ θ)²` to a `c⁻¹`-eigenvector. -/
private theorem trans_sq_apply_involutive {θ θ' : L ≃ₗ⁅ℝ⁆ L}
    (hθ : Function.Involutive θ) (hθ' : Function.Involutive θ')
    {v : L} {c : ℝ} (hc : c ≠ 0)
    (hv : ((θ.trans θ').trans (θ.trans θ')) v = c • v) :
    ((θ.trans θ').trans (θ.trans θ')) (θ v) = c⁻¹ • θ v := by
  let P : L ≃ₗ⁅ℝ⁆ L := (θ.trans θ').trans (θ.trans θ')
  have hθ_P (x : L) : θ (P x) = P.symm (θ x) := by
    symm
    rw [LieEquiv.symm_apply_eq]
    simp only [P, trans_apply, hθ _, hθ' _]
  have hPsymm : P.symm v = c⁻¹ • v := by
    rw [LieEquiv.symm_apply_eq, map_smul, hv, smul_smul, inv_mul_cancel₀ hc, one_smul]
  have hPθ : P (θ v) = θ (P.symm v) := by
    simpa only [P.apply_symm_apply] using congrArg P (hθ_P (P.symm v))
  rw [hPθ, hPsymm, map_smul]

/-- Intertwining `P^s (θ y) = θ (P^{-s} y)` for `P = (θ' ∘ θ)²`. -/
private theorem rpowLieEquiv_apply_involutive {ι : Type*} (B : Basis ι ℝ L)
    {lam : ι → ℝ} {θ θ' : L ≃ₗ⁅ℝ⁆ L}
    (hθ : Function.Involutive θ) (hθ' : Function.Involutive θ')
    (hlam : ∀ i, 0 < lam i)
    (hB : ∀ i, ((θ.trans θ').trans (θ.trans θ')) (B i) = lam i • B i)
    (s : ℝ) (y : L) :
    rpowLieEquiv B hlam hB s (θ y) = θ (rpowLieEquiv B hlam hB (-s) y) := by
  have h := B.diagEnd_comp_eq_comp_diagEnd
    (f := (((θ.trans θ').trans (θ.trans θ') : L ≃ₗ⁅ℝ⁆ L) : L →ₗ[ℝ] L))
    (φ := (θ : L →ₗ[ℝ] L)) hB (·⁻¹) (· ^ s) (· ^ (-s))
    (fun i ↦ trans_sq_apply_involutive hθ hθ' (hlam i).ne' (hB i))
    fun i ↦ by rw [Real.inv_rpow (hlam i).le, Real.rpow_neg (hlam i).le]
  simpa only [rpowLieEquiv_apply, LinearMap.comp_apply, LinearEquiv.coe_coe,
    coe_toLinearEquiv] using congr($h y)

/-- `θ.trans θ'` commutes with all real powers of `P = (θ.trans θ')²`. -/
private theorem rpowLieEquiv_comm_trans {ι : Type*} (B : Basis ι ℝ L)
    {lam : ι → ℝ} {θ θ' : L ≃ₗ⁅ℝ⁆ L} (hlam : ∀ i, 0 < lam i)
    (hB : ∀ i, ((θ.trans θ').trans (θ.trans θ')) (B i) = lam i • B i)
    (s : ℝ) (y : L) :
    (θ.trans θ') (rpowLieEquiv B hlam hB s y) =
      rpowLieEquiv B hlam hB s ((θ.trans θ') y) := by
  have h := B.diagEnd_comp_eq_comp_diagEnd
    (f := (((θ.trans θ').trans (θ.trans θ') : L ≃ₗ⁅ℝ⁆ L) : L →ₗ[ℝ] L))
    (φ := ((θ.trans θ' : L ≃ₗ⁅ℝ⁆ L) : L →ₗ[ℝ] L)) hB id (· ^ s) (· ^ s)
    (fun i ↦ by
      simp only [LinearEquiv.coe_coe, coe_toLinearEquiv]
      have hcomm : ((θ.trans θ').trans (θ.trans θ')) ((θ.trans θ') (B i)) =
          (θ.trans θ') (((θ.trans θ').trans (θ.trans θ')) (B i)) := by
        simp only [trans_apply]
      rw [hcomm, hB i, map_smul, id_eq])
    fun _ ↦ rfl
  simpa only [rpowLieEquiv_apply, LinearMap.comp_apply, LinearEquiv.coe_coe,
    coe_toLinearEquiv] using congr($h y).symm

/-- `log P` anticommutes with `θ` for `P = (θ' ∘ θ)²`. -/
private theorem logLieDerivation_apply_involutive {ι : Type*} (B : Basis ι ℝ L)
    {lam : ι → ℝ} {θ θ' : L ≃ₗ⁅ℝ⁆ L}
    (hθ : Function.Involutive θ) (hθ' : Function.Involutive θ')
    (hlam : ∀ i, 0 < lam i)
    (hB : ∀ i, ((θ.trans θ').trans (θ.trans θ')) (B i) = lam i • B i) (y : L) :
    logLieDerivation B hlam hB (θ y) = -θ (logLieDerivation B hlam hB y) := by
  have h := B.diagEnd_comp_eq_comp_diagEnd
    (f := (((θ.trans θ').trans (θ.trans θ') : L ≃ₗ⁅ℝ⁆ L) : L →ₗ[ℝ] L))
    (φ := (θ : L →ₗ[ℝ] L)) hB (·⁻¹) Real.log (fun r ↦ -Real.log r)
    (fun i ↦ trans_sq_apply_involutive hθ hθ' (hlam i).ne' (hB i))
    fun i ↦ Real.log_inv (lam i)
  rw [B.diagEnd_neg, LinearMap.comp_neg] at h
  simpa only [logLieDerivation_apply, LinearMap.comp_apply, LinearMap.neg_apply,
    LinearEquiv.coe_coe, coe_toLinearEquiv] using congr($h y)

/-- If `ad Z` anticommutes with an involution `θ` on a centerless Lie algebra, then
`Z ∈ θ.cartanP`. -/
private theorem mem_cartanP_of_ad_anticommute {θ : L ≃ₗ⁅ℝ⁆ L} (hθ : Function.Involutive θ)
    (hcenter : center ℝ L = ⊥) {Z : L} (hanti : ∀ y, ⁅Z, θ y⁆ = -θ ⁅Z, y⁆) :
    Z ∈ θ.cartanP := by
  rw [mem_cartanP]
  apply LieDerivation.injective_ad_of_center_eq_bot hcenter
  ext w
  have hequiv := LinearMap.congr_fun (LieAlgebra.conj_ad_apply θ Z) w
  simp only [LinearEquiv.conj_apply, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LieEquiv.coe_toLinearEquiv, LieAlgebra.ad_apply] at hequiv
  simp only [LieDerivation.ad_apply_apply, neg_lie]
  have hsymm : θ.toLinearEquiv.symm w = θ w := θ.symm_apply_eq.mpr (hθ w).symm
  rw [← hequiv, hsymm, hanti w, map_neg, hθ]

/-- **Conjugacy of Cartan involutions (spectral form)** (Knapp, Ch. VI, Thm. 6.16): for any two
Cartan involutions `θ` and `θ'` of a real Lie algebra `L`, there exist a Lie automorphism `φ`
intertwining `θ` and `θ'` (`θ' (φ y) = φ (θ y)`) and `Z ∈ θ.cartanP` such that `φ` acts by
`Real.exp μ` on every `μ`-eigenvector of `ad Z`. -/
theorem exists_conj_spectral {θ θ' : L ≃ₗ⁅ℝ⁆ L}
    (hθ : θ.IsCartanInvolution) (hθ' : θ'.IsCartanInvolution) :
    ∃ φ : L ≃ₗ⁅ℝ⁆ L, (∀ y, θ' (φ y) = φ (θ y)) ∧
      ∃ Z ∈ θ.cartanP,
        ∀ (μ : ℝ) (y : L), ⁅Z, y⁆ = μ • y → φ y = Real.exp μ • y := by
  have := hθ.isKilling
  have := hθ.finiteDimensional
  let ω : L ≃ₗ⁅ℝ⁆ L := θ.trans θ'
  obtain ⟨B, lam, hlam_pos, hB_eig⟩ := exists_pos_eigenbasis_trans_sq hθ hθ'
  let Ppow (s : ℝ) : L ≃ₗ⁅ℝ⁆ L := rpowLieEquiv B hlam_pos hB_eig s
  let D : LieDerivation ℝ L L := logLieDerivation B hlam_pos hB_eig
  have hθ_Ppow (s : ℝ) (y : L) : Ppow s (θ y) = θ (Ppow (-s) y) :=
    rpowLieEquiv_apply_involutive B hθ.involutive hθ'.involutive hlam_pos hB_eig s y
  have hω_Ppow (s : ℝ) (y : L) : ω (Ppow s y) = Ppow s (ω y) :=
    rpowLieEquiv_comm_trans B hlam_pos hB_eig s y
  have hθ'_Ppow (s : ℝ) (y : L) : θ' (Ppow s y) = Ppow (-s) (θ' y) := by
    have hθ'_eq (z : L) : θ' z = ω (θ z) := by simp only [ω, trans_apply, hθ.involutive z]
    have hθP : θ (Ppow s y) = Ppow (-s) (θ y) := by
      simpa only [neg_neg] using (hθ_Ppow (-s) y).symm
    rw [hθ'_eq (Ppow s y), hθP, hω_Ppow, ← hθ'_eq]
  -- `φ = P^{1/4}` conjugates `θ` to a Cartan involution commuting with `θ'`, hence `θ'`.
  let φ : L ≃ₗ⁅ℝ⁆ L := Ppow (1 / 4)
  let θ'' : L ≃ₗ⁅ℝ⁆ L := φ.symm.trans (θ.trans φ)
  have hθ''_apply (y : L) : θ'' y = Ppow (1 / 2) (θ y) := by
    simp only [θ'', trans_apply, φ, Ppow, rpowLieEquiv_symm_apply]
    rw [← hθ_Ppow (1 / 4) y, rpowLieEquiv_add]
    norm_num
  have hcomm_θ' : ∀ y, θ' (θ'' y) = θ'' (θ' y) := fun y ↦ by
    have hω_eq : ω y = Ppow 1 (ω.symm y) := by
      rw [rpowLieEquiv_one]
      simp [ω]
    calc
      θ' (θ'' y) = θ' (Ppow (1 / 2) (θ y)) := by rw [hθ''_apply]
      _ = Ppow (-(1 / 2)) (θ' (θ y)) := hθ'_Ppow (1 / 2) (θ y)
      _ = Ppow (-(1 / 2)) (Ppow 1 (ω.symm y)) := by rw [← trans_apply θ θ' y, hω_eq]
      _ = Ppow (1 / 2) (ω.symm y) := by dsimp only [Ppow]; rw [rpowLieEquiv_add]; norm_num
      _ = Ppow (1 / 2) (θ (θ' y)) := by
          simp only [ω, LieEquiv.symm_trans, hθ.symm_eq, hθ'.symm_eq, LieEquiv.trans_apply]
      _ = θ'' (θ' y) := (hθ''_apply (θ' y)).symm
  have hθ'_eq_θ'' : θ' = θ'' :=
    hθ'.eq_of_commute (hθ.conj φ) hcomm_θ'
  have hφ_intertwine (y : L) : θ' (φ y) = φ (θ y) := by
    rw [hθ'_eq_θ'']
    simp [θ'']
  -- Since `L` is Killing, `D = ad Z₀` for some `Z₀ ∈ θ.cartanP`; take `Z = (1/4) • Z₀`.
  obtain ⟨Z₀, hZ₀⟩ := LieDerivation.IsKilling.exists_eq_ad D
  have hZ₀_apply (y : L) : ⁅Z₀, y⁆ = D y := by
    simpa using congrArg (fun d : LieDerivation ℝ L L ↦ d y) hZ₀
  have hZ₀_cartanP : Z₀ ∈ θ.cartanP :=
    mem_cartanP_of_ad_anticommute hθ.involutive (LieAlgebra.center_eq_bot ℝ L) fun w ↦ by
      rw [hZ₀_apply, hZ₀_apply, logLieDerivation_apply_involutive B hθ.involutive hθ'.involutive]
  refine ⟨φ, hφ_intertwine, (1 / 4 : ℝ) • Z₀, θ.cartanP.smul_mem _ hZ₀_cartanP,
    fun μ y hy ↦ ?_⟩
  rw [smul_lie, hZ₀_apply] at hy
  exact rpowLieEquiv_apply_of_log_eq_smul B hlam_pos hB_eig hy

/-- **Conjugacy of Cartan involutions (operator exponential form)** (Knapp, Ch. VI, Cor. 6.19):
for any two Cartan involutions `θ` and `θ'` of a real Lie algebra `L` equipped with Hausdorff
topological vector space structures on `L` and `L →L[ℝ] L` (with topological ring multiplication
on `L →L[ℝ] L`), there exists `Z ∈ θ.cartanP` such that `exp (ad Z)` conjugates `θ` to `θ'`. -/
theorem exists_conj_exp_ad
    [TopologicalSpace L] [IsTopologicalAddGroup L] [ContinuousSMul ℝ L] [T2Space L]
    [TopologicalSpace (L →L[ℝ] L)] [IsTopologicalRing (L →L[ℝ] L)]
    [ContinuousSMul ℝ (L →L[ℝ] L)] [T2Space (L →L[ℝ] L)]
    {θ θ' : L ≃ₗ⁅ℝ⁆ L} (hθ : θ.IsCartanInvolution) (hθ' : θ'.IsCartanInvolution) :
    let _ : FiniteDimensional ℝ L := hθ.finiteDimensional
    ∃ Z ∈ θ.cartanP, ∀ y : L,
      θ' (NormedSpace.exp (LinearMap.toContinuousLinearMap (LieAlgebra.ad ℝ L Z)) y) =
        NormedSpace.exp (LinearMap.toContinuousLinearMap (LieAlgebra.ad ℝ L Z)) (θ y) := by
  have := hθ.finiteDimensional
  dsimp only
  obtain ⟨φ, hφ, Z, hZ, hspec⟩ := hθ.exists_conj_spectral hθ'
  refine ⟨Z, hZ, fun y ↦ ?_⟩
  let A : L →L[ℝ] L := LinearMap.toContinuousLinearMap (LieAlgebra.ad ℝ L Z)
  have hexp_eq : ∀ w : L, NormedSpace.exp A w = φ w := by
    have htop : LinearMap.eqLocus (NormedSpace.exp A).toLinearMap (φ : L →ₗ[ℝ] L) = ⊤ := by
      rw [eq_top_iff, ← hθ.iSup_eigenspace_ad_eq_top hZ]
      refine iSup_le fun μ w hw ↦ ?_
      rw [Module.End.mem_eigenspace_iff, LieAlgebra.ad_apply] at hw
      have h1 : NormedSpace.exp A w = Real.exp μ • w := by
        simpa only [← Real.exp_eq_exp_ℝ] using
          A.exp_apply_of_apply_eq_smul_of_finiteDimensional
            (by simpa only [A, LinearMap.coe_toContinuousLinearMap', LieAlgebra.ad_apply] using hw)
      rw [LinearMap.mem_eqLocus, ContinuousLinearMap.coe_coe, LinearEquiv.coe_coe,
        LieEquiv.coe_toLinearEquiv, h1, hspec μ w hw]
    intro w
    exact LinearMap.mem_eqLocus.mp (htop ▸ Submodule.mem_top)
  rw [hexp_eq y, hexp_eq (θ y), hφ y]

end RealConjugacy

end IsCartanInvolution

end LieEquiv
