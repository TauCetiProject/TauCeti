module

public import TauCeti.Algebra.Lie.E7.Minuscule.Generated.Positive.Basic
public import TauCeti.Algebra.Lie.E7.Minuscule.Generated.RelativeBaseChange

/-!
# Scalar extension of the generated positive E₇ subgroup

The subgroup generated by the seven positive numbered roots and the weight torus commutes
with free scalar extension. The comparison intertwines restriction from the full generated
E₇ carrier and transports the defining ideal inside that carrier. In particular, it applies
to field extensions, without a restriction on characteristic.
-/

public section

open CategoryTheory

namespace TauCeti.E7Minuscule.Generated.Positive

universe u

attribute [local instance high] Algebra.toModule

variable (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Free R S]

/-- Free scalar extension transports the positive subgroup's ambient defining ideal to
the defining ideal generated over the extension ring. -/
theorem map_baseChange_definingIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := S) (definingIdeal R)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 56).hom.hom =
      definingIdeal S := by
  apply CommHopfAlgCat.map_baseChangeHopfIdeal_commonKernelHopfIdeal
    (generator R) (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 56)
    (fun j ↦ generatorCoordinateAlgebraBaseChangeIso R S (match j with
      | .inl i => .inl (.inl i)
      | .inr u => .inr u))
  rintro (i | u)
  · simpa only [Category.assoc, generator_inl] using
      generatorCoordinateMap_baseChange R S (.inl (.inl i))
  · obtain rfl := Subsingleton.elim u ()
    simpa only [Category.assoc, generator_inr] using
      generatorCoordinateMap_baseChange R S (.inr ())

/-- The generated positive E₇ subgroup commutes with free scalar extension. -/
noncomputable def coordinateHopfAlgebraBaseChangeIso :
    CommHopfAlgCat.baseChange (K := S) (coordinateHopfAlgebra R) ≅
      coordinateHopfAlgebra S :=
  CommHopfAlgCat.quotientBaseChangeIsoOfMapEq
    (definingIdeal R) (definingIdeal S)
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 56)
    (map_baseChange_definingIdeal R S)

/-- The positive subgroup comparison intertwines the ambient quotient maps. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := S)
        (CommHopfAlgCat.mkQuotient _ (definingIdeal R)) ≫
        (coordinateHopfAlgebraBaseChangeIso R S).hom =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 56).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal S) :=
  CommHopfAlgCat.baseChangeMap_mkQuotient_comp_quotientBaseChangeIsoOfMapEq_hom
    (definingIdeal R) (definingIdeal S)
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso R S 56)
    (map_baseChange_definingIdeal R S)

/-- Scalar extension of restriction agrees with restriction after the two carrier
comparisons. Thus the positive subgroup comparison respects its ambient E₇ carrier. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_restriction_comp_coordinateHopfAlgebraBaseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := S) (restriction R) ≫
        (coordinateHopfAlgebraBaseChangeIso R S).hom =
      (generatedCoordinateHopfAlgebraBaseChangeIso R S).hom ≫ restriction S := by
  have hq :
      CommHopfAlgCat.baseChangeMap (K := S) (generatedCoordinateMap R) ≫
          CommHopfAlgCat.baseChangeMap (K := S) (restriction R) =
        CommHopfAlgCat.baseChangeMap (K := S)
          (CommHopfAlgCat.mkQuotient _ (definingIdeal R)) := by
    rw [← CommHopfAlgCat.baseChangeFunctor_map,
      ← CommHopfAlgCat.baseChangeFunctor_map, ← Functor.map_comp,
      generatedCoordinateMap_comp_restriction, CommHopfAlgCat.baseChangeFunctor_map]
  have := ConcreteCategory.epi_of_surjective _
    (CommHopfAlgCat.baseChangeMap_surjective (K := S) _
      (generatedCoordinateMap_surjective R))
  rw [← cancel_epi (CommHopfAlgCat.baseChangeMap (K := S) (generatedCoordinateMap R)),
    ← Category.assoc, hq,
    baseChangeMap_mkQuotient_comp_coordinateHopfAlgebraBaseChangeIso_hom,
    ← Category.assoc,
    baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeIso_hom,
    Category.assoc, generatedCoordinateMap_comp_restriction]

/-- The positive subgroup's defining ideal inside the full generated carrier commutes
with free scalar extension. -/
theorem map_baseChange_carrierDefiningIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := S) (carrierDefiningIdeal R)).map
        (generatedCoordinateHopfAlgebraBaseChangeIso R S).hom.hom =
      carrierDefiningIdeal S := by
  rw [← kerOfSurjective_restriction R, ← kerOfSurjective_restriction S]
  apply CommHopfAlgCat.map_baseChangeHopfIdeal_kerOfSurjective
    (generatedCoordinateHopfAlgebraBaseChangeIso R S)
    (coordinateHopfAlgebraBaseChangeIso R S)
    (restriction_surjective R) (restriction_surjective S)
  rw [baseChangeMap_restriction_comp_coordinateHopfAlgebraBaseChangeIso_hom,
    Iso.inv_hom_id_assoc]

end TauCeti.E7Minuscule.Generated.Positive
