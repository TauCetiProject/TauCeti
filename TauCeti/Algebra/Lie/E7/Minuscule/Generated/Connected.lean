module

public import TauCeti.Algebra.Lie.E7.Minuscule.Generated.Basic
public import TauCeti.Algebra.AlgebraicGroup.Connected.Generated
import TauCeti.Algebra.Lie.E7.Minuscule.Generated.RelativeBaseChange
import TauCeti.Algebra.AlgebraicGroup.Connected.BaseChange
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.SmoothConnected

/-!
# Connectedness of the generated type-E₇ subgroup

The numbered root subgroups and weight torus of the type-`E₇` minuscule carrier generate a
geometrically connected closed subgroup over every field. Over an algebraically closed field,
the coordinate algebras of the generators have connected spectra, and the closed subgroup they
generate inherits this property. Relative base change then descends the result to the original
field. This is a geometric input to recognizing the explicit carrier as a pinned split group of
type `E₇`.

The integral carrier is known to contain the generated subgroup. Its identification with the
generated subgroup after base change is a separate question.

## References

* J. S. Milne, *Algebraic Groups* (2017), Propositions 2.37 and 2.48.
* `TauCeti.Algebra.AlgebraicGroup.Connected.Generated`, connectedness of common-kernel quotients.
-/

public section

namespace TauCeti.E7Minuscule

open CategoryTheory

universe u

variable (k : Type u) [Field k]

private theorem connectedSpace_generatorCoordinateAlgebra :
    ∀ j, ConnectedSpace (PrimeSpectrum (generatorCoordinateAlgebra k j)) := by
  intro j
  cases j with
  | inl _ => exact AdditiveGroup.connectedSpace_primeSpectrum_coordinateHopfAlgebra k
  | inr _ =>
    exact DiagonalizableGroup.connectedSpace_primeSpectrum_coordinateRing k
      (SplitTorus.characterGroup (Fin 7))

private theorem geometricallyConnected_generatedCoordinateHopfAlgebra_of_isAlgClosed
    [IsAlgClosed k] :
    geometricallyConnectedCommHopfAlgProperty k (generatedCoordinateHopfAlgebra k) := by
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact CommHopfAlgCat.geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient
    (generatorCoordinateMap k) (connectedSpace_generatorCoordinateAlgebra k)

/-- The closed subgroup generated by the type-`E₇` numbered root subgroups and weight torus is
geometrically connected over every field. -/
theorem geometricallyConnectedCommHopfAlgProperty_generatedCoordinateHopfAlgebra :
    geometricallyConnectedCommHopfAlgProperty k (generatedCoordinateHopfAlgebra k) := by
  apply geometricallyConnectedCommHopfAlgProperty.of_baseChange
    k (AlgebraicClosure k) (generatedCoordinateHopfAlgebra k)
  exact (geometricallyConnectedCommHopfAlgProperty (AlgebraicClosure k)).prop_of_iso
    (generatedCoordinateHopfAlgebraBaseChangeIso k (AlgebraicClosure k)).symm
    (geometricallyConnected_generatedCoordinateHopfAlgebra_of_isAlgClosed
      (AlgebraicClosure k))

end TauCeti.E7Minuscule
