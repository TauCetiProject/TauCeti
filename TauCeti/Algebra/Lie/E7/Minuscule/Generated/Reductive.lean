module

public import TauCeti.Algebra.Lie.E7.Minuscule.Generated.Connected
public import TauCeti.Algebra.Lie.E7.Minuscule.Generated.UnipotentRadical
public import TauCeti.Algebra.AlgebraicGroup.Reductive.Basic
import TauCeti.Algebra.Lie.E7.Minuscule.Generated.RelativeBaseChange

/-!
# Reductivity of the generated type-E₇ subgroup

Over every field, the closed subgroup of `GL₅₆` generated by the fourteen numbered root
subgroups and the weight torus of the minuscule representation is reductive.  Smoothness and
geometric connectedness hold over the ground field.  Relative base change identifies its
geometric fibre with the subgroup generated over an algebraic closure, whose faithful simple
standard comodule eliminates every normal smooth unipotent closed subgroup.

This proves reductivity of the generated subgroup.  Identifying it with the specialized integral
minuscule carrier, and then recognizing its pinning and root datum, are separate steps.

## Main declaration

* `TauCeti.E7Minuscule.reductiveCommHopfAlgProperty_finiteTypeGeneratedCoordinateHopfAlgebra`:
  the generated subgroup is reductive over every field.

## References

* J. S. Milne, *Algebraic Groups* (2017), §6.46 and §19.b.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26–27.
-/

public section

namespace TauCeti.E7Minuscule

universe u

noncomputable section

/-- **The subgroup generated by the type-`E₇` minuscule root subgroups and weight torus is
reductive over every field.** -/
theorem reductiveCommHopfAlgProperty_finiteTypeGeneratedCoordinateHopfAlgebra
    (k : Type u) [Field k] :
    reductiveCommHopfAlgProperty k (finiteTypeGeneratedCoordinateHopfAlgebra k) := by
  apply reductiveCommHopfAlgProperty_of_geometricFiber_iso k _
    (finiteTypeGeneratedCoordinateHopfAlgebra (AlgebraicClosure k))
    ((smoothCommHopfAlgProperty_iff _).mp
      (smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra k))
    (geometricallyConnectedCommHopfAlgProperty_generatedCoordinateHopfAlgebra k)
    (finiteTypeGeneratedCoordinateHopfAlgebraBaseChangeIso k (AlgebraicClosure k))
  intro I hI hU
  exact eq_augmentation_generated_of_isNormal_of_smoothUnipotent
    (AlgebraicClosure k) I hI hU

end

end TauCeti.E7Minuscule
