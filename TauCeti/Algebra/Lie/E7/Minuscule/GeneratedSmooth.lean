module

public import TauCeti.Algebra.Lie.E7.Minuscule.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Reduced
public import TauCeti.Algebra.AlgebraicGroup.Smooth.AlgebraicallyClosed

/-!
# Smoothness of the subgroup generated by the type-E7 pinning candidates

Over an algebraically closed field, the fourteen numbered root subgroups and the weight torus of
the type-`E₇` minuscule carrier generate a smooth closed subgroup of `GL₅₆`. Its defining ideal is
the common kernel of their coordinate maps. The integral carrier's base change contains this
generated subgroup; equality with the integral carrier's fibre is a separate question.

The reducedness argument uses the common-kernel theorem: both the additive root groups and the
split torus have reduced coordinate algebras, and the generated quotient is of finite type.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§26–27.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.
-/

public section

namespace TauCeti.E7Minuscule

open CategoryTheory

universe u

variable (A : Type u) [CommRing A]

/-- The Hopf ideal defining the closed subgroup generated by the numbered root subgroups and
weight torus of the type-`E₇` minuscule carrier over `A`. -/
noncomputable abbrev generatedDefiningIdeal :
    HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A 56) :=
  CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap A)

/-- The base-changed integral carrier contains the subgroup generated by the numbered root
subgroups and weight torus. -/
theorem baseChangeDefiningIdeal_le_generatedDefiningIdeal :
    baseChangeDefiningIdeal A ≤ generatedDefiningIdeal A :=
  baseChangeDefiningIdeal_le_commonKernel A

/-- The coordinate algebra of the closed subgroup generated by the numbered root subgroups and
weight torus over `A`. -/
noncomputable abbrev generatedCoordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A 56)
    (generatedDefiningIdeal A)

variable (k : Type u) [Field k]

/-- The subgroup generated by the type-`E₇` root subgroups and torus has reduced coordinate
algebra over an algebraically closed field. -/
theorem isReduced_generatedCoordinateHopfAlgebra [IsAlgClosed k] :
    IsReduced (generatedCoordinateHopfAlgebra k) := by
  let : IsReduced (AdditiveGroup.coordinateHopfAlgebra k) :=
    isReduced_of_injective (AdditiveGroup.coordinateAlgEquiv k).toRingHom
      (AdditiveGroup.coordinateAlgEquiv k).injective
  let : IsReduced (DiagonalizableGroup.coordinateRing k
      (SplitTorus.characterGroup (Fin 7))).obj := inferInstance
  let : ∀ j, IsReduced (generatorCoordinateAlgebra k j) := by
    intro j
    cases j with
    | inl i => exact inferInstance
    | inr _ => exact inferInstance
  exact CommHopfAlgCat.isReduced_quotient_commonKernelHopfIdeal (generatorCoordinateMap k)

/-- The subgroup generated by the type-`E₇` root subgroups and torus is smooth over an
algebraically closed field. -/
theorem smooth_generatedCoordinateHopfAlgebra [IsAlgClosed k] :
    smoothCommHopfAlgProperty k (generatedCoordinateHopfAlgebra k) := by
  let : IsReduced (generatedCoordinateHopfAlgebra k) :=
    isReduced_generatedCoordinateHopfAlgebra k
  exact smoothCommHopfAlgProperty_of_isAlgClosed_of_isReduced k _

end TauCeti.E7Minuscule
