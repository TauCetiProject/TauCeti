module

public import TauCeti.Algebra.Lie.E7.Minuscule.Carrier
public import TauCeti.Algebra.Lie.Presentation.MinusculeWeightTable.RankOne
public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Borel
public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Diagonal.Basic
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.ModularGroup

/-!
# Rank-one subgroups of the E7 minuscule carrier

Over a field, each pair of opposite numbered root subgroups generates a faithful
copy of `SL₂`. The block action preserves the native root parameters and identifies
the diagonal subgroup with the designated simple-coroot torus. Its upper-triangular
subgroup and two disjoint Bruhat cells are described inside this exact rank-one
subgroup. These statements do not assert a Bruhat decomposition for the full E7 carrier.
-/

public section

open scoped Matrix MatrixGroups

namespace TauCeti.E7Minuscule

open TauCeti.DynkinType

noncomputable section

private theorem rankOneSL_upper {R : Type*} [CommRing R] (i : Fin 7) (t : R) :
    weightTable.rankOneSL i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        (rootSubgroupPoints (.inl i) R (Multiplicative.ofAdd t) : GL (Fin 56) R) := by
  apply Units.ext
  rw [weightTable.coe_rankOneSL, coe_rootSubgroupPoints_inl, ← weightTable_raisingMatrix]
  exact weightTable.rankOneMatrix_upper_transvection i t

private theorem rankOneSL_lower {R : Type*} [CommRing R] (i : Fin 7) (t : R) :
    weightTable.rankOneSL i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        (rootSubgroupPoints (.inr i) R (Multiplicative.ofAdd t) : GL (Fin 56) R) := by
  apply Units.ext
  have hl : weightTable.loweringMatrix i = loweringMatrix i := by
    ext a b
    simp [weightTable_weight, weightTable_reflection]
  rw [weightTable.coe_rankOneSL, coe_rootSubgroupPoints_inr, ← hl]
  exact weightTable.rankOneMatrix_lower_transvection i t

variable (K : Type*) [Field K] (i : Fin 7)

private theorem rankOneSL_mem_points (g : SL(2, K)) : weightTable.rankOneSL i g ∈ points K := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · rw [rankOneSL_upper]
      exact (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t)).property
    · rw [rankOneSL_lower]
      exact (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t)).property
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using mul_mem hg hh

/-- The faithful rank-one representation in the designated E7 carrier over a field. -/
def rankOnePoints : SL(2, K) →* points K :=
  (weightTable.rankOneSL i).codRestrict (points K) (rankOneSL_mem_points K i)

/-- Including the rank-one map in the general linear group recovers its block action. -/
@[simp]
theorem coe_rankOnePoints (g : SL(2, K)) :
    (rankOnePoints K i g : GL (Fin 56) K) = weightTable.rankOneSL i g := by
  rw [rankOnePoints, MonoidHom.codRestrict_apply]

/-- The rank-one map is injective at every simple E7 node. -/
theorem rankOnePoints_injective : Function.Injective (rankOnePoints K i) := by
  intro g h hgh
  apply weightTable.rankOneSL_injective i
    (by simpa only [weightTable_weight] using exists_e7MinusculeWeight_apply_eq_neg_one i)
  exact congrArg Subtype.val hgh

/-- The upper transvection has the native positive-root parameter. -/
@[simp]
theorem rankOnePoints_upper_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, rankOneSL_upper]

/-- The lower transvection has the native negative-root parameter. -/
@[simp]
theorem rankOnePoints_lower_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, rankOneSL_lower]

/-- The subgroup generated by the two full opposite simple-root parameter families. -/
def rankOneSubgroup : Subgroup (points K) :=
  Subgroup.closure (Set.range (rootSubgroupPoints (.inl i) K) ∪
    Set.range (rootSubgroupPoints (.inr i) K))

/-- The image of the rank-one map is exactly the subgroup generated by its opposite roots. -/
theorem range_rankOnePoints : (rankOnePoints K i).range = rankOneSubgroup K i := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    induction g using Matrix.SL2.transvection_induction with
    | htransvec a b hab t =>
      fin_cases a <;> fin_cases b
      · exact (hab rfl).elim
      · rw [rankOnePoints_upper_transvection]
        exact Subgroup.subset_closure (Or.inl ⟨_, rfl⟩)
      · rw [rankOnePoints_lower_transvection]
        exact Subgroup.subset_closure (Or.inr ⟨_, rfl⟩)
      · exact (hab rfl).elim
    | hmul g h hg hh => simpa only [map_mul] using mul_mem hg hh
  · rw [rankOneSubgroup, Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
    · exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
        (Multiplicative.toAdd t), rankOnePoints_upper_transvection K i _⟩
    · exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0)
        (Multiplicative.toAdd t), rankOnePoints_lower_transvection K i _⟩

/-- The generated opposite-root subgroup is isomorphic to `SL₂(K)`. -/
def rankOneEquiv : SL(2, K) ≃* rankOneSubgroup K i :=
  (MonoidHom.ofInjective (rankOnePoints_injective K i)).trans
    (MulEquiv.subgroupCongr (range_rankOnePoints K i))

/-- The diagonal of the rank-one copy is the designated simple-coroot torus. -/
@[simp]
theorem rankOnePoints_diag2nUnit (u : Kˣ) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints K (Pi.mulSingle i u) := by
  apply Subtype.ext
  apply Units.ext
  rw [coe_rankOnePoints, weightTable.coe_rankOneSL,
    Matrix.SpecialLinearGroup.diag2nUnit_coe, weightTable.rankOneMatrix_diagonal,
    coe_weightTorusPoints, UniversalEnvelopingAlgebra.kostantTorusMatrix_apply, diagGL_coe]
  congr 1
  funext a
  rw [torusCharacter_mulSingle]
  rcases weightTable.weight_eq_neg_one_or_eq_zero_or_eq_one a i with h | h | h
  all_goals simp_all only [weightTable_weight]
  all_goals simp

/-- Every designated simple-coroot point belongs to the opposite-root subgroup. -/
theorem weightTorusPoints_mulSingle_mem_rankOneSubgroup (u : Kˣ) :
    weightTorusPoints K (Pi.mulSingle i u) ∈ rankOneSubgroup K i := by
  rw [← range_rankOnePoints, ← rankOnePoints_diag2nUnit]
  exact ⟨_, rfl⟩

/-- The standard rank-one Weyl representative is the native three-root word. -/
theorem rankOnePoints_modularGroup_S :
    rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)) =
      rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd (-1)) *
        rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd 1) *
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd (-1)) := by
  have hS : ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)) =
      Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1) (-1) *
        Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0) 1 *
        Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1) (-1) := by
    apply Subtype.ext
    simp only [Matrix.SpecialLinearGroup.coe_mul,
      Matrix.SpecialLinearGroup.transvection_coe,
      TauCeti.Matrix.SpecialLinearGroup.coe_modularGroup_S]
    ext a b
    fin_cases a <;> fin_cases b <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two, Matrix.single]
  rw [hS, map_mul, map_mul, rankOnePoints_upper_transvection,
    rankOnePoints_lower_transvection]

/-- The upper-triangular subgroup in the designated rank-one copy of `SL₂`. -/
def rankOneBorel : Subgroup (points K) :=
  (SL2Borel K).map (rankOnePoints K i)

/-- The rank-one Borel lies in the subgroup generated by the two opposite roots. -/
theorem rankOneBorel_le_rankOneSubgroup : rankOneBorel K i ≤ rankOneSubgroup K i := by
  rintro _ ⟨g, _, rfl⟩
  rw [← range_rankOnePoints]
  exact ⟨g, rfl⟩

/-- The embedding detects the standard upper-triangular subgroup. -/
@[simp]
theorem rankOnePoints_mem_rankOneBorel_iff (g : SL(2, K)) :
    rankOnePoints K i g ∈ rankOneBorel K i ↔ g ∈ SL2Borel K := by
  constructor
  · rintro ⟨h, hh, heq⟩
    exact rankOnePoints_injective K i heq ▸ hh
  · intro hg
    exact ⟨g, hg, rfl⟩

private theorem rankOnePoints_borel_mk (u : Kˣ) (t : K) :
    rankOnePoints K i (SL2Borel.mk u t : SL(2, K)) =
      weightTorusPoints K (Pi.mulSingle i u) *
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd ((u⁻¹ : Kˣ) * t)) := by
  have hmk : (SL2Borel.mk u t : SL(2, K)) =
      Matrix.SpecialLinearGroup.diag2nUnit (by decide : (0 : Fin 2) ≠ 1) u *
        Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
          ((u⁻¹ : Kˣ) * t) := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_mul, SL2Borel.coe_mk,
      Matrix.SpecialLinearGroup.diag2nUnit_coe,
      Matrix.SpecialLinearGroup.transvection_coe]
    ext a b
    fin_cases a <;> fin_cases b <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two, Matrix.single]
  rw [hmk, map_mul, rankOnePoints_diag2nUnit, rankOnePoints_upper_transvection]

/-- The rank-one Borel is exactly the simple-coroot torus times the positive root subgroup. -/
theorem mem_rankOneBorel_iff {g : points K} :
    g ∈ rankOneBorel K i ↔ ∃ (u : Kˣ) (t : K),
      g = weightTorusPoints K (Pi.mulSingle i u) *
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) := by
  constructor
  · rintro ⟨h, hh, rfl⟩
    let b : SL2Borel K := ⟨h, hh⟩
    refine ⟨SL2Borel.diag b, ((SL2Borel.diag b)⁻¹ : Kˣ) * SL2Borel.upperRight b, ?_⟩
    rw [← rankOnePoints_borel_mk, SL2Borel.mk_diag_upperRight]
  · rintro ⟨u, t, rfl⟩
    refine ⟨SL2Borel.mk u ((u : K) * t), (SL2Borel.mk _ _).property, ?_⟩
    rw [rankOnePoints_borel_mk]
    simp

/-- The rank-one embedding transports the standard big Bruhat cell exactly. -/
theorem rankOnePoints_mem_doubleCoset_iff (g : SL(2, K)) :
    rankOnePoints K i g ∈
      DoubleCoset.doubleCoset
        (rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)))
        (rankOneBorel K i : Set (points K)) (rankOneBorel K i : Set (points K)) ↔
      g ∈ DoubleCoset.doubleCoset ((ModularGroup.S : SL(2, ℤ)) : SL(2, K))
        (SL2Borel K : Set SL(2, K)) (SL2Borel K : Set SL(2, K)) := by
  constructor
  · intro hg
    obtain ⟨x, ⟨a, ha, rfl⟩, y, ⟨b, hb, rfl⟩, hab⟩ :=
      DoubleCoset.mem_doubleCoset.mp hg
    refine DoubleCoset.mem_doubleCoset.mpr ⟨a, ha, b, hb, ?_⟩
    apply rankOnePoints_injective K i
    simpa only [map_mul] using hab
  · intro hg
    obtain ⟨a, ha, b, hb, hab⟩ := DoubleCoset.mem_doubleCoset.mp hg
    refine DoubleCoset.mem_doubleCoset.mpr
      ⟨rankOnePoints K i a, ⟨a, ha, rfl⟩, rankOnePoints K i b, ⟨b, hb, rfl⟩, ?_⟩
    simpa only [map_mul] using congrArg (rankOnePoints K i) hab

/-- The two rank-one Bruhat cells cover exactly the opposite-root subgroup. -/
theorem mem_rankOneSubgroup_iff {g : points K} :
    g ∈ rankOneSubgroup K i ↔ g ∈ rankOneBorel K i ∨
      g ∈ DoubleCoset.doubleCoset
        (rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)))
        (rankOneBorel K i : Set (points K)) (rankOneBorel K i : Set (points K)) := by
  constructor
  · rw [← range_rankOnePoints]
    rintro ⟨h, rfl⟩
    by_cases hh : h ∈ SL2Borel K
    · exact Or.inl ((rankOnePoints_mem_rankOneBorel_iff K i h).mpr hh)
    · exact Or.inr ((rankOnePoints_mem_doubleCoset_iff K i h).mpr
        (SL2Borel.mem_doubleCoset_modularGroup_S_of_notMem hh))
  · rintro (hg | hg)
    · exact rankOneBorel_le_rankOneSubgroup K i hg
    · obtain ⟨a, ha, b, hb, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
      have hS : rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)) ∈
          rankOneSubgroup K i := by
        rw [← range_rankOnePoints]
        exact ⟨_, rfl⟩
      exact mul_mem (mul_mem (rankOneBorel_le_rankOneSubgroup K i ha) hS)
        (rankOneBorel_le_rankOneSubgroup K i hb)

/-- The small and big rank-one Bruhat cells are disjoint, including in characteristics two
and three. -/
theorem disjoint_rankOneBorel_doubleCoset :
    Disjoint (rankOneBorel K i : Set (points K))
      (DoubleCoset.doubleCoset
        (rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)))
        (rankOneBorel K i : Set (points K)) (rankOneBorel K i : Set (points K))) := by
  rw [Set.disjoint_left]
  rintro _ ⟨g, hg, rfl⟩ hcell
  have hunit := SL2Borel.mem_doubleCoset_modularGroup_S_iff.mp
    ((rankOnePoints_mem_doubleCoset_iff K i g).mp hcell)
  exact hunit.ne_zero (SL2Borel.mem_iff.mp hg)

end

end TauCeti.E7Minuscule
