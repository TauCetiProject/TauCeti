/-!
# Rank-one subgroups of the E7 minuscule carrier

Over a field, each pair of opposite numbered root subgroups of the E7 minuscule carrier generates
a faithful copy of `SL₂`: the block action of the weight table at the node sends the upper and
lower transvections to the two root parameter families and `diag(u, u⁻¹)` to the simple-coroot
point. This copy sends `ModularGroup.S` to a Weyl representative for `s_i`, Carter's
`n_i(-1) = n_i⁻¹`, the inverse of the carrier's `kostantToralWeylPoint`, and supplies the
rank-one Bruhat calculus of the node: its upper-triangular subgroup and its two disjoint Bruhat
cells, which later root and torus computations in the carrier use. These statements do not assert
a Bruhat decomposition for the full E7 carrier.

## Main definitions

* `TauCeti.E7Minuscule.rankOnePoints`: the homomorphism `SL₂(K) → points K` at a simple node.
* `TauCeti.E7Minuscule.rankOneSubgroup`: the subgroup generated by the two opposite root families
  at the node, with `TauCeti.E7Minuscule.rankOneEquiv` the isomorphism from `SL₂(K)` onto it.
* `TauCeti.E7Minuscule.rankOneBorel`: the image of the upper-triangular subgroup of `SL₂(K)`.

## Main results

* `TauCeti.E7Minuscule.rankOnePoints_upper_transvection`, `rankOnePoints_lower_transvection` and
  `rankOnePoints_diag2nUnit`: the transvections and the diagonal map to the root and coroot
  points with their parameters.
* `TauCeti.E7Minuscule.rankOnePoints_modularGroup_S` and
  `TauCeti.E7Minuscule.coe_rankOnePoints_modularGroup_S`: the image of `ModularGroup.S` is the
  three-root word `x_i(-1) x_{-i}(1) x_i(-1)`, Carter's `n_i(-1) = n_i⁻¹`, the inverse of the
  carrier's Weyl representative `TauCeti.UniversalEnvelopingAlgebra.kostantToralWeylPoint`.
* `TauCeti.E7Minuscule.mem_rankOneSubgroup_iff` and
  `TauCeti.E7Minuscule.disjoint_rankOneBorel_doubleCoset_modularGroup_S`: the two rank-one Bruhat
  cells cover the rank-one subgroup and are disjoint.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, Chapter 6 (the homomorphism `φ_r` and the elements
  `h_r`, `n_r`).
* J. E. Humphreys, *Linear Algebraic Groups*, §28.3.
-/

public section

open scoped Matrix MatrixGroups

namespace TauCeti.E7Minuscule

open TauCeti.DynkinType

noncomputable section

private theorem sl2BlockSL_upper {R : Type*} [CommRing R] (i : Fin 7) (t : R) :
    weightTable.sl2BlockSL i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        (rootSubgroupPoints (.inl i) R (Multiplicative.ofAdd t) : GL (Fin 56) R) := by
  apply Units.ext
  rw [weightTable.coe_sl2BlockSL, weightTable.sl2BlockMatrix_upper_transvection,
    weightTable_raisingMatrix, coe_rootSubgroupPoints_inl, toAdd_ofAdd]

private theorem sl2BlockSL_lower {R : Type*} [CommRing R] (i : Fin 7) (t : R) :
    weightTable.sl2BlockSL i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        (rootSubgroupPoints (.inr i) R (Multiplicative.ofAdd t) : GL (Fin 56) R) := by
  apply Units.ext
  rw [weightTable.coe_sl2BlockSL, weightTable.sl2BlockMatrix_lower_transvection,
    weightTable_loweringMatrix, coe_rootSubgroupPoints_inr, toAdd_ofAdd]

variable (K : Type*) [Field K] (i : Fin 7)

/-- The homomorphism `SL₂(K) → points K` at the simple node `i`: `g` acts on each pair of basis
vectors whose `i`-th coroot coordinates are `(1, -1)`, in that order, and fixes the weight-zero
basis vectors. -/
def rankOnePoints : SL(2, K) →* points K :=
  (weightTable.sl2BlockSL i).codRestrict (points K)
    (by
      intro g
      apply (weightTable.sl2BlockSL i).map_mem_of_transvection_mem
      · intro t
        rw [sl2BlockSL_upper]
        exact (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t)).property
      · intro t
        rw [sl2BlockSL_lower]
        exact (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t)).property)

/-- The rank-one map followed by the inclusion into `GL₅₆(K)` is the block action. -/
@[simp]
theorem coe_rankOnePoints (g : SL(2, K)) :
    (rankOnePoints K i g : GL (Fin 56) K) = weightTable.sl2BlockSL i g := by
  rw [rankOnePoints, MonoidHom.codRestrict_apply]

/-- The rank-one map is injective at every simple E7 node. -/
theorem rankOnePoints_injective : Function.Injective (rankOnePoints K i) := by
  rw [rankOnePoints, MonoidHom.injective_codRestrict]
  exact weightTable.sl2BlockSL_injective i
    (by simpa only [weightTable_weight] using exists_e7MinusculeWeight_apply_eq_neg_one i)

/-- The upper transvection maps to the positive-root point with the same parameter. -/
@[simp]
theorem rankOnePoints_upper_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, sl2BlockSL_upper]

/-- The lower transvection maps to the negative-root point with the same parameter. -/
@[simp]
theorem rankOnePoints_lower_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, sl2BlockSL_lower]

/-- The subgroup generated by the two opposite simple-root parameter families at the node. -/
def rankOneSubgroup : Subgroup (points K) :=
  Subgroup.closure (Set.range (rootSubgroupPoints (.inl i) K) ∪
    Set.range (rootSubgroupPoints (.inr i) K))

/-- The rank-one subgroup is the closure of the two opposite root families at the node. -/
theorem rankOneSubgroup_def :
    rankOneSubgroup K i = Subgroup.closure (Set.range (rootSubgroupPoints (.inl i) K) ∪
      Set.range (rootSubgroupPoints (.inr i) K)) :=
  (rfl)

/-- The positive-root points at the node lie in the rank-one subgroup. -/
theorem rootSubgroupPoints_inl_mem_rankOneSubgroup (t : Multiplicative K) :
    rootSubgroupPoints (.inl i) K t ∈ rankOneSubgroup K i :=
  Subgroup.subset_closure (Set.mem_union_left _ (Set.mem_range_self t))

/-- The negative-root points at the node lie in the rank-one subgroup. -/
theorem rootSubgroupPoints_inr_mem_rankOneSubgroup (t : Multiplicative K) :
    rootSubgroupPoints (.inr i) K t ∈ rankOneSubgroup K i :=
  Subgroup.subset_closure (Set.mem_union_right _ (Set.mem_range_self t))

/-- The image of the rank-one map is the subgroup generated by its opposite roots. -/
theorem range_rankOnePoints : (rankOnePoints K i).range = rankOneSubgroup K i := by
  simpa only [MonoidHom.coe_comp, Function.comp_def,
    Matrix.SpecialLinearGroup.transvectionHom_apply, rankOnePoints_upper_transvection,
    rankOnePoints_lower_transvection, ofAdd_toAdd, rankOneSubgroup_def] using
    (rankOnePoints K i).range_eq_closure_transvection

/-- Every point in the image of the rank-one map lies in the rank-one subgroup. -/
@[simp]
theorem rankOnePoints_mem_rankOneSubgroup (g : SL(2, K)) :
    rankOnePoints K i g ∈ rankOneSubgroup K i := by
  rw [← range_rankOnePoints]
  exact ⟨g, rfl⟩

/-- The rank-one subgroup is isomorphic to `SL₂(K)`. -/
def rankOneEquiv : SL(2, K) ≃* rankOneSubgroup K i :=
  (MonoidHom.ofInjective (rankOnePoints_injective K i)).trans
    (MulEquiv.subgroupCongr (range_rankOnePoints K i))

/-- The rank-one isomorphism is the rank-one map on underlying points. -/
@[simp]
theorem coe_rankOneEquiv_apply (g : SL(2, K)) :
    (rankOneEquiv K i g : points K) = rankOnePoints K i g := by
  rw [rankOneEquiv, MulEquiv.trans_apply, MulEquiv.subgroupCongr_apply,
    MonoidHom.ofInjective_apply]

/-- The diagonal matrix `diag(u, u⁻¹)` maps to the simple-coroot point at the node. -/
@[simp]
theorem rankOnePoints_diag2nUnit (u : Kˣ) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints K (Pi.mulSingle i u) := by
  apply Subtype.ext
  apply Units.ext
  rw [coe_rankOnePoints, weightTable.coe_sl2BlockSL,
    Matrix.SpecialLinearGroup.diag2nUnit_coe, weightTable.sl2BlockMatrix_diagonal,
    coe_weightTorusPoints, UniversalEnvelopingAlgebra.kostantTorusMatrix_apply, diagGL_coe]
  congr 1
  funext a
  rw [torusCharacter_mulSingle]
  rcases weightTable.weight_eq_neg_one_or_eq_zero_or_eq_one a i with h | h | h
  all_goals simp_all only [weightTable_weight]
  all_goals simp

/-- Every simple-coroot point at the node lies in the rank-one subgroup. -/
theorem weightTorusPoints_mulSingle_mem_rankOneSubgroup (u : Kˣ) :
    weightTorusPoints K (Pi.mulSingle i u) ∈ rankOneSubgroup K i := by
  rw [← rankOnePoints_diag2nUnit]
  exact rankOnePoints_mem_rankOneSubgroup K i _

/-- The image of `ModularGroup.S` is the three-root word `x_i(-1) x_{-i}(1) x_i(-1)`, a Weyl
representative for `s_i` (Carter's `n_i(-1) = n_i⁻¹`). -/
theorem rankOnePoints_modularGroup_S :
    rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)) =
      rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd (-1)) *
        rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd 1) *
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd (-1)) := by
  rw [TauCeti.Matrix.SpecialLinearGroup.modularGroup_S_decompose, map_mul, map_mul,
    rankOnePoints_upper_transvection, rankOnePoints_lower_transvection]

/-- As a matrix, the image of `ModularGroup.S` is the inverse of the carrier's Weyl
representative `x_i(1) x_{-i}(-1) x_i(1)` at the node. -/
theorem coe_rankOnePoints_modularGroup_S :
    (rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)) : GL (Fin 56) K) =
      (TauCeti.UniversalEnvelopingAlgebra.kostantToralWeylPoint
        (TauCeti.serreRootGenerator (CartanMatrix.E 7)) (TauCeti.serreH ℚ (CartanMatrix.E 7))
        rep lattice.toAddSubgroup rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator
        latticeBasis e7MinusculeWeight (.inl i) (.inr i) K : GL (Fin 56) K)⁻¹ := by
  rw [rankOnePoints_modularGroup_S, ← Subgroup.coe_inv,
    TauCeti.UniversalEnvelopingAlgebra.kostantToralWeylPoint_inv]
  simp only [Subgroup.coe_mul, coe_rootSubgroupPoints,
    TauCeti.UniversalEnvelopingAlgebra.coe_kostantToralRootSubgroupPoints]

/-- The upper-triangular subgroup of the rank-one copy of `SL₂` at the node. -/
def rankOneBorel : Subgroup (points K) :=
  (SL2Borel K).map (rankOnePoints K i)

/-- The rank-one Borel is the image of the upper-triangular subgroup of `SL₂(K)`. -/
theorem rankOneBorel_def : rankOneBorel K i = (SL2Borel K).map (rankOnePoints K i) :=
  (rfl)

/-- The rank-one Borel lies in the rank-one subgroup. -/
theorem rankOneBorel_le_rankOneSubgroup : rankOneBorel K i ≤ rankOneSubgroup K i := by
  rw [rankOneBorel_def, ← range_rankOnePoints]
  exact Subgroup.map_le_range (rankOnePoints K i) (SL2Borel K)

/-- The rank-one map detects the upper-triangular subgroup. -/
@[simp]
theorem rankOnePoints_mem_rankOneBorel_iff (g : SL(2, K)) :
    rankOnePoints K i g ∈ rankOneBorel K i ↔ g ∈ SL2Borel K := by
  rw [rankOneBorel_def]
  exact Subgroup.mem_map_iff_mem (rankOnePoints_injective K i)

private theorem rankOnePoints_borel_mk (u : Kˣ) (t : K) :
    rankOnePoints K i (SL2Borel.mk u t : SL(2, K)) =
      weightTorusPoints K (Pi.mulSingle i u) *
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd ((u⁻¹ : Kˣ) * t)) := by
  rw [SL2Borel.coe_mk_eq_diag2nUnit_mul_transvection, map_mul, rankOnePoints_diag2nUnit,
    rankOnePoints_upper_transvection]

/-- The rank-one Borel is the simple-coroot torus times the positive root subgroup at the
node. -/
theorem mem_rankOneBorel_iff {g : points K} :
    g ∈ rankOneBorel K i ↔ ∃ (u : Kˣ) (t : K),
      g = weightTorusPoints K (Pi.mulSingle i u) *
        rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) := by
  rw [rankOneBorel_def, Subgroup.mem_map]
  constructor
  · rintro ⟨h, hh, rfl⟩
    let b : SL2Borel K := ⟨h, hh⟩
    refine ⟨SL2Borel.diag b, ((SL2Borel.diag b)⁻¹ : Kˣ) * SL2Borel.upperRight b, ?_⟩
    rw [← rankOnePoints_borel_mk, SL2Borel.mk_diag_upperRight]
  · rintro ⟨u, t, rfl⟩
    refine ⟨SL2Borel.mk u ((u : K) * t), (SL2Borel.mk _ _).property, ?_⟩
    rw [rankOnePoints_borel_mk]
    simp

/-- The rank-one map transports the big Bruhat cell of `ModularGroup.S`. -/
theorem rankOnePoints_mem_doubleCoset_modularGroup_S_iff (g : SL(2, K)) :
    rankOnePoints K i g ∈
      DoubleCoset.doubleCoset
        (rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)))
        (rankOneBorel K i : Set (points K)) (rankOneBorel K i : Set (points K)) ↔
      g ∈ DoubleCoset.doubleCoset ((ModularGroup.S : SL(2, ℤ)) : SL(2, K))
        (SL2Borel K : Set SL(2, K)) (SL2Borel K : Set SL(2, K)) := by
  rw [rankOneBorel_def, Subgroup.coe_map]
  exact DoubleCoset.mem_doubleCoset_image_iff (rankOnePoints_injective K i) _ _ _ g

/-- The two rank-one Bruhat cells cover exactly the rank-one subgroup. -/
theorem mem_rankOneSubgroup_iff {g : points K} :
    g ∈ rankOneSubgroup K i ↔ g ∈ rankOneBorel K i ∨
      g ∈ DoubleCoset.doubleCoset
        (rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)))
        (rankOneBorel K i : Set (points K)) (rankOneBorel K i : Set (points K)) := by
  rw [← range_rankOnePoints, rankOneBorel_def]
  exact SL2Borel.mem_range_iff_mem_map_or_mem_doubleCoset_modularGroup_S (rankOnePoints K i)

/-- The small and big rank-one Bruhat cells are disjoint, including in characteristics two
and three. -/
theorem disjoint_rankOneBorel_doubleCoset_modularGroup_S :
    Disjoint (rankOneBorel K i : Set (points K))
      (DoubleCoset.doubleCoset
        (rankOnePoints K i ((ModularGroup.S : SL(2, ℤ)) : SL(2, K)))
        (rankOneBorel K i : Set (points K)) (rankOneBorel K i : Set (points K))) := by
  rw [rankOneBorel_def]
  exact SL2Borel.disjoint_map_doubleCoset_modularGroup_S (rankOnePoints_injective K i)

end

end TauCeti.E7Minuscule
