module

public import TauCeti.Algebra.Lie.E7.Minuscule.Carrier
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Torus.Coroot
import TauCeti.Algebra.Lie.Sl2.Basic

/-!
# Generation of the E₇ minuscule weight torus by root subgroups

The type-`E₇` minuscule carrier is defined using both its fourteen numbered simple root
subgroups and its rank-seven weight torus. This file proves that, on the underlying
base-changed lattice over any commutative ring, the torus is already contained in the elementary
group generated by the root subgroups.

There are two concrete inputs. First, the represented positive and negative simple generators at
each node form an `sl₂` triple. This follows from the integral minuscule weight table, after
extension to `ℚ` and passage from matrices to endomorphisms. Second, every row of the type-`E₇`
Cartan matrix contains `-1`, so its entries have an explicit integral linear combination equal to
one. The generic coroot-generation theorem then puts every coordinate cocharacter, and hence the
whole weight torus, in the elementary group.

The conclusion concerns subgroups of the automorphism group of the base-changed admissible
lattice. Identifying those generated points with all points of the toral-closure group scheme is
a separate scheme-theoretic comparison.

## Main results

* `TauCeti.E7Minuscule.isSl2Triple_rep_serreRootGenerator`: the represented generators at every
  simple node form an `sl₂` triple.
* `TauCeti.E7Minuscule.weightTorusSubgroup_le_elementarySubgroup`: the weight torus lies in the
  elementary subgroup over every commutative ring.
* `TauCeti.E7Minuscule.torusRootSubgroup_eq_elementarySubgroup`: adjoining the weight torus to all
  numbered root subgroups gives exactly the elementary subgroup.

This is the root-generation input requested for the explicit type-`E₇` carrier in Layer 9 of the
`ReductiveGroups` roadmap, which is in turn an input to milestone L0 of the `CFSGStatement`
roadmap.
-/

public section

open scoped Matrix TensorProduct

universe v

namespace TauCeti.E7Minuscule

open TauCeti.DynkinType TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance high] Algebra.toModule

local notation "CM" => CartanMatrix.E 7
local notation "rootGen" => TauCeti.serreRootGenerator CM
local notation "cartanGen" => TauCeti.serreH ℚ CM

private theorem cartanMatrixRat_ne_zero (i : Fin 7) : cartanMatrixRat i ≠ 0 := by
  obtain ⟨a, ha⟩ := exists_e7MinusculeWeight_apply_eq_neg_one i
  intro hzero
  have h := congrFun (congrFun hzero a) a
  simp only [cartanMatrixRat_apply, ite_true, Matrix.zero_apply] at h
  norm_num [ha] at h

private theorem isSl2Triple_rat (i : Fin 7) :
    _root_.IsSl2Triple (cartanMatrixRat i) (raisingMatrixRat i) (loweringMatrixRat i) where
  h_ne_zero := cartanMatrixRat_ne_zero i
  lie_e_f := isSerreSystemRat.lie_E_F_self i
  lie_h_e_nsmul := by
    rw [isSerreSystemRat.lie_H_E, CartanMatrix.E_diag]
    simp
  lie_h_f_nsmul := by
    rw [isSerreSystemRat.lie_H_F, CartanMatrix.E_diag]
    simp

/-- The represented positive and negative simple generators at a common type-`E₇` node, together
with the represented Cartan generator, form an `sl₂` triple. -/
theorem isSl2Triple_rep_serreRootGenerator (i : Fin 7) :
    _root_.IsSl2Triple
      (rep (_root_.UniversalEnvelopingAlgebra.ι ℚ (cartanGen i)))
      (rep (_root_.UniversalEnvelopingAlgebra.ι ℚ (rootGen (.inl i))))
      (rep (_root_.UniversalEnvelopingAlgebra.ι ℚ (rootGen (.inr i)))) := by
  let φ : Matrix (Fin 56) (Fin 56) ℚ →ₗ⁅ℚ⁆ Module.End ℚ (Fin 56 → ℚ) :=
    (Matrix.toLinAlgEquiv' (R := ℚ) (n := Fin 56)).toAlgHom.toLieHom
  have hne : φ (cartanMatrixRat i) ≠ 0 := by
    obtain ⟨a, ha⟩ := exists_e7MinusculeWeight_apply_eq_neg_one i
    intro hzero
    have hz := DFunLike.congr_fun hzero (Pi.single a 1)
    have hza := congrFun hz a
    simp only [φ, AlgHom.toLieHom_apply, LinearMap.zero_apply, Pi.zero_apply] at hza
    simp [Matrix.mulVec, dotProduct, cartanMatrixRat_apply, Pi.single_apply, ha] at hza
  have h := (isSl2Triple_rat i).map φ hne
  change _root_.IsSl2Triple
    (Matrix.toLinAlgEquiv' (cartanMatrixRat i))
    (Matrix.toLinAlgEquiv' (raisingMatrixRat i))
    (Matrix.toLinAlgEquiv' (loweringMatrixRat i)) at h
  have hH : Matrix.toLinAlgEquiv' (cartanMatrixRat i) =
      rep (_root_.UniversalEnvelopingAlgebra.ι ℚ (cartanGen i)) := by
    apply LinearMap.ext
    intro v
    rw [rep_ι_apply, rationalSerreRepresentation_serreH, Matrix.toLinAlgEquiv'_apply]
  have hE : Matrix.toLinAlgEquiv' (raisingMatrixRat i) =
      rep (_root_.UniversalEnvelopingAlgebra.ι ℚ (rootGen (.inl i))) := by
    apply LinearMap.ext
    intro v
    rw [TauCeti.serreRootGenerator_inl, rep_ι_apply,
      rationalSerreRepresentation_serreE, Matrix.toLinAlgEquiv'_apply]
  have hF : Matrix.toLinAlgEquiv' (loweringMatrixRat i) =
      rep (_root_.UniversalEnvelopingAlgebra.ι ℚ (rootGen (.inr i))) := by
    apply LinearMap.ext
    intro v
    rw [TauCeti.serreRootGenerator_inr, rep_ι_apply,
      rationalSerreRepresentation_serreF, Matrix.toLinAlgEquiv'_apply]
  rwa [hH, hE, hF] at h

private def rootCharacter : Fin 7 ⊕ Fin 7 → Fin 7 → ℤ
  | .inl i => CM i
  | .inr i => -CM i

private theorem lie_cartanGenerator_rootGenerator' (k : Fin 7 ⊕ Fin 7) (j : Fin 7) :
    ⁅cartanGen j, rootGen k⁆ = ((rootCharacter k j : ℤ) : ℚ) • rootGen k := by
  cases k with
  | inl i =>
      rw [rootCharacter, TauCeti.serreRootGenerator_inl, TauCeti.lie_serreH_serreE,
        (CartanMatrix.E_isSymm 7).apply]
      simp only [Int.cast_smul_eq_zsmul]
  | inr i =>
      rw [rootCharacter, TauCeti.serreRootGenerator_inr, TauCeti.lie_serreH_serreF,
        (CartanMatrix.E_isSymm 7).apply]
      simp only [Pi.neg_apply, Int.cast_neg, neg_smul, Int.cast_smul_eq_zsmul]

private def cartanNeighbor : Fin 7 → Fin 7 :=
  ![2, 3, 0, 1, 3, 4, 5]

private def cartanBezout (i j : Fin 7) : ℤ :=
  if j = cartanNeighbor i then -1 else 0

private theorem cartan_sum_mul_bezout (i : Fin 7) :
    ∑ j, CM i j * cartanBezout i j = 1 := by
  fin_cases i <;> decide

private theorem rootWeight_sum_mul_bezout (i : Fin 7) :
    ∑ j, rootCharacter (.inl i) j * cartanBezout i j = 1 := by
  simpa only [rootCharacter] using cartan_sum_mul_bezout i

private theorem rootWeight_inr_eq_neg_inl (i : Fin 7) :
    rootCharacter (.inr i) = -rootCharacter (.inl i) := by
  rfl

/-- Over every commutative ring, the type-`E₇` minuscule weight torus on the base-changed
admissible lattice is contained in the elementary group generated by the fourteen positive and
negative numbered simple root subgroups. -/
theorem weightTorusSubgroup_le_elementarySubgroup (A : CommAlgCat.{v} ℤ) :
    kostantTorusSubgroup lattice.toAddSubgroup
        latticeBasis e7MinusculeWeight A ≤
      kostantElementarySubgroup rootGen cartanGen rep
        lattice.toAddSubgroup rep_kostantForm_mem_lattice
        isNilpotent_rep_serreRootGenerator A := by
  exact kostantTorusSubgroup_le_kostantElementarySubgroup
    rootGen cartanGen rep lattice.toAddSubgroup rep_kostantForm_mem_lattice
    isNilpotent_rep_serreRootGenerator latticeBasis e7MinusculeWeight
    isCartanWeightVector_latticeBasis rootCharacter lie_cartanGenerator_rootGenerator'
    Sum.inl Sum.inr isSl2Triple_rep_serreRootGenerator rootWeight_inr_eq_neg_inl cartanBezout
    rootWeight_sum_mul_bezout A

/-- Over every commutative ring, adjoining the type-`E₇` minuscule weight torus to all fourteen
numbered simple root subgroups does not enlarge their elementary subgroup. -/
theorem torusRootSubgroup_eq_elementarySubgroup (A : CommAlgCat.{v} ℤ) :
    kostantTorusSubsystemSubgroup rootGen cartanGen rep
        lattice.toAddSubgroup rep_kostantForm_mem_lattice
        isNilpotent_rep_serreRootGenerator latticeBasis e7MinusculeWeight Set.univ A =
      kostantElementarySubgroup rootGen cartanGen rep
        lattice.toAddSubgroup rep_kostantForm_mem_lattice
        isNilpotent_rep_serreRootGenerator A := by
  exact
    kostantTorusSubsystemSubgroup_univ_eq_kostantElementarySubgroup
      rootGen cartanGen rep lattice.toAddSubgroup rep_kostantForm_mem_lattice
      isNilpotent_rep_serreRootGenerator latticeBasis e7MinusculeWeight
      isCartanWeightVector_latticeBasis rootCharacter lie_cartanGenerator_rootGenerator'
      Sum.inl Sum.inr isSl2Triple_rep_serreRootGenerator rootWeight_inr_eq_neg_inl cartanBezout
      rootWeight_sum_mul_bezout A

end TauCeti.E7Minuscule
