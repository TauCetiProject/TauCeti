module

public import TauCeti.Algebra.Lie.E7.Minuscule.Carrier
public import TauCeti.Algebra.Lie.Presentation.MinusculeWeightTable.Adjacent

/-!
# Adjacent-root Heisenberg subgroups of the type-E₇ minuscule carrier

For either sign and every commutative ring `R`, two simple-root subgroups
`x_{±αᵢ}, x_{±αⱼ} : Multiplicative R →* points R` of the type-`E₇` minuscule carrier `points R`
at adjacent nodes `i`, `j` (Cartan entry `-1`) generate a copy of `TauCeti.HeisenbergGroup R`,
through the coordinates `(x, y, z) ↦ x_{±αⱼ}(y) x_{±αᵢ}(x) ⁅x_{±αᵢ}(z), x_{±αⱼ}(1)⁆`. The central
coordinate is the commutator `⁅x_{±αᵢ}(t), x_{±αⱼ}(1)⁆`, which satisfies the adjacent case of the
Chevalley commutator formula `⁅x_{±αᵢ}(s), x_{±αⱼ}(t)⁆ = ⁅x_{±αᵢ}(s * t), x_{±αⱼ}(1)⁆`, and the
three coordinates are unique in every characteristic, including two and three.

Everything is an instance of `TauCeti.Algebra.Lie.Presentation.MinusculeWeightTable.Adjacent`:
the positive simple-root points have matrices `1 + t • Eᵢ` for the raising matrices of
`TauCeti.E7Minuscule.weightTable`, and the negative ones `1 + t • Fᵢ` for its lowering matrices,
which are the raising matrices of `weightTable.negWeights`. The torus conjugation law for the
central parameter is particular to the carrier.

## Main definitions

* `TauCeti.E7Minuscule.adjacentRootCommutator`: the commutator `⁅x_{±αᵢ}(t), x_{±αⱼ}(1)⁆`.
* `TauCeti.E7Minuscule.adjacentHeisenbergHom` and `adjacentRootCommutatorHom`: the Heisenberg
  parametrization `(x, y, z) ↦ x_{±αⱼ}(y) x_{±αᵢ}(x) ⁅x_{±αᵢ}(z), x_{±αⱼ}(1)⁆` and its central
  one-parameter subgroup.
* `TauCeti.E7Minuscule.adjacentRootSubgroup` and `adjacentHeisenbergEquiv`: the join of the two
  signed simple-root subgroups, and its identification with `TauCeti.HeisenbergGroup R`.

## Main results

* `TauCeti.E7Minuscule.commutatorElement_rootSubgroupPoints_adjacent`,
  `coe_adjacentRootCommutator` and `coe_adjacentHeisenbergHom`: the adjacent Chevalley commutator
  formula, the matrix `1 + t • (Eᵢ Eⱼ - Eⱼ Eᵢ)` of the central parameter, and the matrix
  `1 + x • Eᵢ + y • Eⱼ + (x * y) • Eⱼ Eᵢ + z • (Eᵢ Eⱼ - Eⱼ Eᵢ)` of the Heisenberg parametrization,
  where `Eᵢ` is the raising or lowering matrix at `i` according to the sign.
* `TauCeti.E7Minuscule.adjacentHeisenbergHom_injective` and `range_adjacentHeisenbergHom`: the
  Heisenberg parametrization is injective, with range the subgroup generated by the two roots.
* `TauCeti.E7Minuscule.mem_adjacentRootSubgroup_iff`: an element lies in that subgroup exactly when
  it is `x_{±αⱼ}(y) x_{±αᵢ}(x) ⁅x_{±αᵢ}(z), x_{±αⱼ}(1)⁆` for some Heisenberg coordinates
  `(x, y, z)`.
* `TauCeti.E7Minuscule.adjacentRootCommutator_injective`,
  `commute_adjacentRootCommutator_rootSubgroupPoints_left`,
  `commute_adjacentRootCommutator_rootSubgroupPoints_right` and `adjacentRootCommutator_swap`:
  the central parameter is faithful, commutes with both root subgroups, and changes sign when the
  pair is reversed.
* `TauCeti.E7Minuscule.weightTorusPoints_conj_adjacentRootCommutator`: conjugation by the weight
  torus rescales the central parameter by the product of the two signed root characters.

## References

* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.2.2.
* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* The matrix-level and group-level statements are instantiated from
  `TauCeti.Algebra.Lie.Presentation.MinusculeWeightTable.Adjacent`.
-/

public section

open scoped commutatorElement
open Multiplicative TauCeti.DynkinType
open TauCeti.MinusculeWeightTable (signedRootIndex)

namespace TauCeti.E7Minuscule

variable (positive : Bool) (i j : Fin 7) (R : Type*) [CommRing R]

/-! ## The signed weight table -/

private theorem signedWeightTable_exists_neg_one :
    ∃ a, (weightTable.signed positive).weight a i = -1 :=
  weightTable.signed_exists_weight_eq_neg_one positive i
    (by simpa only [weightTable_weight] using exists_e7MinusculeWeight_apply_eq_neg_one i)

private theorem signedWeightTable_cartanMatrix_adjacent (hij : CartanMatrix.E 7 i j = -1) :
    (weightTable.signed positive).cartanMatrix i j = -1 := by
  rw [MinusculeWeightTable.signed_cartanMatrix, weightTable_cartanMatrix]
  exact hij

private theorem signedWeightTable_cartanMatrix_adjacent_symm (hij : CartanMatrix.E 7 i j = -1) :
    (weightTable.signed positive).cartanMatrix j i = -1 := by
  rw [MinusculeWeightTable.signed_cartanMatrix, weightTable_cartanMatrix,
    (CartanMatrix.E_isSymm 7).apply i j]
  exact hij

private theorem coe_rootSubgroupPoints_signedWeightTable (t : R) :
    ((rootSubgroupPoints (signedRootIndex positive i) R (ofAdd t) : GL (Fin 56) R) :
        Matrix (Fin 56) (Fin 56) R) =
      1 + t • ((weightTable.signed positive).raisingMatrix i).map (Int.cast : ℤ → R) := by
  rw [coe_rootSubgroupPoints_eq_one_add_smul, toAdd_ofAdd,
    MinusculeWeightTable.signed_raisingMatrix, funext weightTable_raisingMatrix,
    funext weightTable_loweringMatrix]

/-! ## The central parameter -/

/-- The commutator `⁅x_{±αᵢ}(t), x_{±αⱼ}(1)⁆` of two signed simple-root points, the central
parameter of the Heisenberg group they generate when the nodes are adjacent. -/
noncomputable def adjacentRootCommutator (t : R) : points R :=
  (rootSubgroupPoints (signedRootIndex positive i) R).adjacentRootCommutator
    (rootSubgroupPoints (signedRootIndex positive j) R) t

/-- The commutator formula `⁅x_{±αᵢ}(t), x_{±αⱼ}(1)⁆` defining the central parameter. -/
theorem adjacentRootCommutator_def (t : R) :
    adjacentRootCommutator positive i j R t =
      ⁅rootSubgroupPoints (signedRootIndex positive i) R (ofAdd t),
        rootSubgroupPoints (signedRootIndex positive j) R (ofAdd 1)⁆ := by
  rw [adjacentRootCommutator, MonoidHom.adjacentRootCommutator_def]

/-- The central parameter vanishes at `0`. -/
@[simp]
theorem adjacentRootCommutator_zero : adjacentRootCommutator positive i j R 0 = 1 :=
  MonoidHom.adjacentRootCommutator_zero (rootSubgroupPoints (signedRootIndex positive i) R)
    (rootSubgroupPoints (signedRootIndex positive j) R)

/-- **The adjacent Chevalley commutator formula** on the carrier points:
`⁅x_{±αᵢ}(s), x_{±αⱼ}(t)⁆ = ⁅x_{±αᵢ}(s * t), x_{±αⱼ}(1)⁆`. -/
theorem commutatorElement_rootSubgroupPoints_adjacent (hij : CartanMatrix.E 7 i j = -1) (s t : R) :
    ⁅rootSubgroupPoints (signedRootIndex positive i) R (ofAdd s),
      rootSubgroupPoints (signedRootIndex positive j) R (ofAdd t)⁆ =
        adjacentRootCommutator positive i j R (s * t) :=
  (weightTable.signed positive).commutatorElement_eq_adjacentRootCommutator _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij) s t

/-- The central parameter has matrix `1 + t • (Eᵢ Eⱼ - Eⱼ Eᵢ)`, where
`Eᵢ = Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive i)` is the raising or
lowering matrix at `i` according to the sign. -/
theorem coe_adjacentRootCommutator (hij : CartanMatrix.E 7 i j = -1) (t : R) :
    ((adjacentRootCommutator positive i j R t : GL (Fin 56) R) : Matrix (Fin 56) (Fin 56) R) =
      1 + t • ((Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive i)).map
            (Int.cast : ℤ → R) *
          (Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive j)).map Int.cast -
        (Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive j)).map Int.cast *
          (Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive i)).map Int.cast) := by
  rw [adjacentRootCommutator, (weightTable.signed positive).coe_adjacentRootCommutator _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij),
    MinusculeWeightTable.raisingCommutatorMatrix_def, Ring.lie_def,
    MinusculeWeightTable.signed_raisingMatrix, MinusculeWeightTable.signed_raisingMatrix,
    funext weightTable_raisingMatrix, funext weightTable_loweringMatrix]

/-- The central parameter is additive in `t`. -/
theorem adjacentRootCommutator_add (hij : CartanMatrix.E 7 i j = -1) (s t : R) :
    adjacentRootCommutator positive i j R (s + t) =
      adjacentRootCommutator positive i j R s * adjacentRootCommutator positive i j R t :=
  (weightTable.signed positive).adjacentRootCommutator_add _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij) s t

/-- The central parameter inverts under negation of `t`. -/
theorem adjacentRootCommutator_neg (hij : CartanMatrix.E 7 i j = -1) (t : R) :
    adjacentRootCommutator positive i j R (-t) = (adjacentRootCommutator positive i j R t)⁻¹ :=
  (weightTable.signed positive).adjacentRootCommutator_neg _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij) t

/-- The central parameter `t ↦ ⁅x_{±αᵢ}(t), x_{±αⱼ}(1)⁆` as a one-parameter subgroup of the
carrier points. -/
noncomputable def adjacentRootCommutatorHom (hij : CartanMatrix.E 7 i j = -1) :
    Multiplicative R →* points R :=
  (weightTable.signed positive).adjacentRootCommutatorHom _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij)

/-- The central one-parameter subgroup evaluates to the commutator at `toAdd u`. -/
@[simp]
theorem adjacentRootCommutatorHom_apply (hij : CartanMatrix.E 7 i j = -1) (u : Multiplicative R) :
    adjacentRootCommutatorHom positive i j R hij u =
      adjacentRootCommutator positive i j R (toAdd u) := by
  rw [adjacentRootCommutatorHom, MinusculeWeightTable.adjacentRootCommutatorHom_apply,
    adjacentRootCommutator]

/-- The central parameter is injective over every commutative ring, without inverting `2` or
`3`. -/
theorem adjacentRootCommutator_injective (hij : CartanMatrix.E 7 i j = -1) :
    Function.Injective (adjacentRootCommutator positive i j R) :=
  (weightTable.signed positive).adjacentRootCommutator_injective _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij)
    (signedWeightTable_exists_neg_one positive i)

/-- The central parameter commutes with the signed simple-root subgroup at `i`. -/
theorem commute_adjacentRootCommutator_rootSubgroupPoints_left (hij : CartanMatrix.E 7 i j = -1)
    (s t : R) :
    Commute (adjacentRootCommutator positive i j R s)
      (rootSubgroupPoints (signedRootIndex positive i) R (ofAdd t)) :=
  (weightTable.signed positive).commute_adjacentRootCommutator_left _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij) s t

/-- The central parameter commutes with the signed simple-root subgroup at `j`. -/
theorem commute_adjacentRootCommutator_rootSubgroupPoints_right (hij : CartanMatrix.E 7 i j = -1)
    (s t : R) :
    Commute (adjacentRootCommutator positive i j R s)
      (rootSubgroupPoints (signedRootIndex positive j) R (ofAdd t)) :=
  (weightTable.signed positive).commute_adjacentRootCommutator_right _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij) s t

/-- Reversing the adjacent pair negates the central parameter:
`⁅x_{±αⱼ}(t), x_{±αᵢ}(1)⁆ = ⁅x_{±αᵢ}(-t), x_{±αⱼ}(1)⁆`. -/
theorem adjacentRootCommutator_swap (hij : CartanMatrix.E 7 i j = -1) (t : R) :
    adjacentRootCommutator positive j i R t = adjacentRootCommutator positive i j R (-t) :=
  (weightTable.signed positive).adjacentRootCommutator_swap _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij) t

/-! ## The Heisenberg subgroup -/

/-- **The Heisenberg parametrization** `(x, y, z) ↦ x_{±αⱼ}(y) x_{±αᵢ}(x) ⁅x_{±αᵢ}(z), x_{±αⱼ}(1)⁆`
of the subgroup generated by two adjacent signed simple-root subgroups. -/
noncomputable def adjacentHeisenbergHom (hij : CartanMatrix.E 7 i j = -1) :
    HeisenbergGroup R →* points R :=
  (weightTable.signed positive).adjacentHeisenbergHom _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij)

/-- The Heisenberg parametrization sends `(x, y, z)` to
`x_{±αⱼ}(y) x_{±αᵢ}(x) ⁅x_{±αᵢ}(z), x_{±αⱼ}(1)⁆`. -/
theorem adjacentHeisenbergHom_apply (hij : CartanMatrix.E 7 i j = -1) (g : HeisenbergGroup R) :
    adjacentHeisenbergHom positive i j R hij g =
      rootSubgroupPoints (signedRootIndex positive j) R (ofAdd g.y) *
        rootSubgroupPoints (signedRootIndex positive i) R (ofAdd g.x) *
          adjacentRootCommutator positive i j R g.z := by
  rw [adjacentHeisenbergHom, MinusculeWeightTable.adjacentHeisenbergHom_apply,
    adjacentRootCommutator]

/-- The Heisenberg parametrization has matrix
`1 + x • Eᵢ + y • Eⱼ + (x * y) • Eⱼ Eᵢ + z • (Eᵢ Eⱼ - Eⱼ Eᵢ)`, where
`Eᵢ = Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive i)` is the raising or
lowering matrix at `i` according to the sign. -/
theorem coe_adjacentHeisenbergHom (hij : CartanMatrix.E 7 i j = -1) (g : HeisenbergGroup R) :
    ((adjacentHeisenbergHom positive i j R hij g : GL (Fin 56) R) : Matrix (Fin 56) (Fin 56) R) =
      1 + g.x • (Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive i)).map
            (Int.cast : ℤ → R) +
        g.y • (Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive j)).map Int.cast +
        (g.x * g.y) •
          ((Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive j)).map Int.cast *
            (Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive i)).map Int.cast) +
        g.z • ((Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive i)).map Int.cast *
            (Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive j)).map Int.cast -
          (Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive j)).map Int.cast *
            (Sum.elim raisingMatrix loweringMatrix (signedRootIndex positive i)).map Int.cast) := by
  rw [adjacentHeisenbergHom, (weightTable.signed positive).coe_adjacentHeisenbergHom _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij),
    MinusculeWeightTable.raisingHeisenbergMatrix_def,
    MinusculeWeightTable.raisingCommutatorMatrix_def, Ring.lie_def,
    MinusculeWeightTable.signed_raisingMatrix, MinusculeWeightTable.signed_raisingMatrix,
    funext weightTable_raisingMatrix, funext weightTable_loweringMatrix]

/-- The first Heisenberg coordinate parametrizes the signed simple-root subgroup at `i`. -/
@[simp]
theorem adjacentHeisenbergHom_x (hij : CartanMatrix.E 7 i j = -1) (x : R) :
    adjacentHeisenbergHom positive i j R hij ⟨x, 0, 0⟩ =
      rootSubgroupPoints (signedRootIndex positive i) R (ofAdd x) :=
  (weightTable.signed positive).adjacentHeisenbergHom_x _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij) x

/-- The second Heisenberg coordinate parametrizes the signed simple-root subgroup at `j`. -/
@[simp]
theorem adjacentHeisenbergHom_y (hij : CartanMatrix.E 7 i j = -1) (y : R) :
    adjacentHeisenbergHom positive i j R hij ⟨0, y, 0⟩ =
      rootSubgroupPoints (signedRootIndex positive j) R (ofAdd y) :=
  (weightTable.signed positive).adjacentHeisenbergHom_y _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij) y

/-- The central Heisenberg coordinate parametrizes the commutator `⁅x_{±αᵢ}(z), x_{±αⱼ}(1)⁆`. -/
@[simp]
theorem adjacentHeisenbergHom_z (hij : CartanMatrix.E 7 i j = -1) (z : R) :
    adjacentHeisenbergHom positive i j R hij ⟨0, 0, z⟩ = adjacentRootCommutator positive i j R z :=
  (weightTable.signed positive).adjacentHeisenbergHom_z _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij) z

/-- **The Heisenberg parametrization is injective** over every commutative ring, in every
characteristic. -/
theorem adjacentHeisenbergHom_injective (hij : CartanMatrix.E 7 i j = -1) :
    Function.Injective (adjacentHeisenbergHom positive i j R hij) :=
  (weightTable.signed positive).adjacentHeisenbergHom_injective _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij)
    (signedWeightTable_exists_neg_one positive i)

/-- The subgroup of the carrier points generated by the signed simple-root subgroups at `i` and
`j`: the join of their ranges. -/
noncomputable def adjacentRootSubgroup : Subgroup (points R) :=
  (rootSubgroupPoints (signedRootIndex positive i) R).range ⊔
    (rootSubgroupPoints (signedRootIndex positive j) R).range

/-- The adjacent-root subgroup is the join of the ranges of the two root subgroups. -/
theorem adjacentRootSubgroup_def :
    adjacentRootSubgroup positive i j R =
      (rootSubgroupPoints (signedRootIndex positive i) R).range ⊔
        (rootSubgroupPoints (signedRootIndex positive j) R).range :=
  (rfl)

/-- The signed simple-root subgroup at `i` lies in the adjacent-root subgroup. -/
theorem rootSubgroupPoints_mem_adjacentRootSubgroup_left (u : Multiplicative R) :
    rootSubgroupPoints (signedRootIndex positive i) R u ∈ adjacentRootSubgroup positive i j R :=
  Subgroup.mem_sup_left ⟨u, rfl⟩

/-- The signed simple-root subgroup at `j` lies in the adjacent-root subgroup. -/
theorem rootSubgroupPoints_mem_adjacentRootSubgroup_right (u : Multiplicative R) :
    rootSubgroupPoints (signedRootIndex positive j) R u ∈ adjacentRootSubgroup positive i j R :=
  Subgroup.mem_sup_right ⟨u, rfl⟩

/-- **The Heisenberg parametrization has range the adjacent-root subgroup.** -/
theorem range_adjacentHeisenbergHom (hij : CartanMatrix.E 7 i j = -1) :
    (adjacentHeisenbergHom positive i j R hij).range = adjacentRootSubgroup positive i j R :=
  (weightTable.signed positive).range_adjacentHeisenbergHom _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij)

/-- An element of the carrier points lies in the adjacent-root subgroup exactly when it has
Heisenberg coordinates: it is `x_{±αⱼ}(y) x_{±αᵢ}(x) ⁅x_{±αᵢ}(z), x_{±αⱼ}(1)⁆` for some
`x`, `y`, `z`. -/
theorem mem_adjacentRootSubgroup_iff (hij : CartanMatrix.E 7 i j = -1) {g : points R} :
    g ∈ adjacentRootSubgroup positive i j R ↔
      ∃ x y z : R, rootSubgroupPoints (signedRootIndex positive j) R (ofAdd y) *
          rootSubgroupPoints (signedRootIndex positive i) R (ofAdd x) *
            adjacentRootCommutator positive i j R z = g := by
  rw [← range_adjacentHeisenbergHom positive i j R hij, MonoidHom.mem_range]
  constructor
  · rintro ⟨h, rfl⟩
    exact ⟨h.x, h.y, h.z, (adjacentHeisenbergHom_apply positive i j R hij h).symm⟩
  · rintro ⟨x, y, z, rfl⟩
    exact ⟨⟨x, y, z⟩, adjacentHeisenbergHom_apply positive i j R hij _⟩

/-- **The adjacent-root subgroup is a Heisenberg group** over every commutative ring, through the
coordinates `(x, y, z) ↦ x_{±αⱼ}(y) x_{±αᵢ}(x) ⁅x_{±αᵢ}(z), x_{±αⱼ}(1)⁆`. -/
noncomputable def adjacentHeisenbergEquiv (hij : CartanMatrix.E 7 i j = -1) :
    HeisenbergGroup R ≃* adjacentRootSubgroup positive i j R :=
  (weightTable.signed positive).adjacentHeisenbergEquiv _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij)
    (signedWeightTable_exists_neg_one positive i)

/-- The Heisenberg equivalence is the Heisenberg parametrization on underlying points. -/
@[simp]
theorem coe_adjacentHeisenbergEquiv (hij : CartanMatrix.E 7 i j = -1) (g : HeisenbergGroup R) :
    (adjacentHeisenbergEquiv positive i j R hij g : points R) =
      adjacentHeisenbergHom positive i j R hij g :=
  (weightTable.signed positive).coe_adjacentHeisenbergEquiv _ _
    (coe_rootSubgroupPoints_signedWeightTable positive i R)
    (coe_rootSubgroupPoints_signedWeightTable positive j R)
    (signedWeightTable_cartanMatrix_adjacent positive i j hij)
    (signedWeightTable_cartanMatrix_adjacent_symm positive i j hij)
    (signedWeightTable_exists_neg_one positive i) g

/-! ## Torus conjugation -/

/-- Conjugation by a point `s` of the weight torus rescales the central parameter by the product
of the two signed root characters at `s`. -/
theorem weightTorusPoints_conj_adjacentRootCommutator (hij : CartanMatrix.E 7 i j = -1)
    (s : Fin 7 → Rˣ) (t : R) :
    weightTorusPoints R s * adjacentRootCommutator positive i j R t *
        (weightTorusPoints R s)⁻¹ =
      adjacentRootCommutator positive i j R
        ((torusCharacter s (DynkinType.E7.rootGeneratorWeight valid_E7
          (signedRootIndex positive i)) : R) *
          (torusCharacter s (DynkinType.E7.rootGeneratorWeight valid_E7
            (signedRootIndex positive j)) : R) * t) := by
  rw [adjacentRootCommutator_def positive i j R t, conjugate_commutatorElement,
    weightTorusPoints_conj_rootSubgroupPoints, weightTorusPoints_conj_rootSubgroupPoints,
    commutatorElement_rootSubgroupPoints_adjacent positive i j R hij]
  simp only [toAdd_ofAdd, mul_one]
  congr 1
  exact mul_right_comm _ _ _

end TauCeti.E7Minuscule
