module

public import TauCeti.Algebra.Lie.F4.ShortRoot.RankOne.Short

/-!
# Short-node rank-one groups in the integral F₄ carrier

Over every field, `shortRankOnePoints` integrates the two short simple-root pairs of the
integral carrier. Its image is exactly the subgroup generated by the corresponding opposite
root families. The root and coroot parameters agree with the integral matrix action.

This identifies a rank-one subgroup, not the full carrier with an independently pinned
simply connected group. No finiteness or simplicity assertion is made.

The subgroup-containment and range arguments follow
`TauCeti.Algebra.Lie.E7.Minuscule.RankOne` and use Mathlib's
`Matrix.SL2.transvection_induction`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, Chapter 6.
-/

public section

open scoped MatrixGroups
open Matrix

namespace TauCeti.F4ShortRoot

noncomputable section

variable (K : Type*) [Field K] (i : Fin 2)

private theorem shortRankOneGL_mem_of_root_mem {H : Subgroup (GL (Fin 26) K)}
    (hpos : ∀ t : K,
      (rootSubgroupPoints (.inl (i.natAdd 2)) K (Multiplicative.ofAdd t) : GL (Fin 26) K) ∈ H)
    (hneg : ∀ t : K,
      (rootSubgroupPoints (.inr (i.natAdd 2)) K (Multiplicative.ofAdd t) : GL (Fin 26) K) ∈ H)
    (g : SL(2, K)) : shortRankOneGL K i g ∈ H := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · simpa only [shortRankOneGL_upper_transvection] using hpos t
    · simpa only [shortRankOneGL_lower_transvection] using hneg t
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using H.mul_mem hg hh

/-- The faithful short-node SL₂ map into the integral carrier's points over any field. -/
def shortRankOnePoints : SL(2, K) →* points K :=
  (shortRankOneGL K i).codRestrict (points K)
    (shortRankOneGL_mem_of_root_mem K i
      (fun t => (rootSubgroupPoints (.inl (i.natAdd 2)) K (Multiplicative.ofAdd t)).property)
      (fun t => (rootSubgroupPoints (.inr (i.natAdd 2)) K (Multiplicative.ofAdd t)).property))

/-- The carrier-valued map has the prescribed matrix action. -/
@[simp]
theorem coe_shortRankOnePoints (g : SL(2, K)) :
    (shortRankOnePoints K i g : GL (Fin 26) K) = shortRankOneGL K i g := by
  rw [shortRankOnePoints, MonoidHom.codRestrict_apply]

/-- The carrier-valued rank-one map is faithful. -/
theorem shortRankOnePoints_injective : Function.Injective (shortRankOnePoints K i) := by
  rw [shortRankOnePoints, MonoidHom.injective_codRestrict]
  exact shortRankOneGL_injective K i

/-- Upper transvections give the positive short-root subgroup with its numbered parameter. -/
@[simp]
theorem shortRankOnePoints_upper_transvection (t : K) :
    shortRankOnePoints K i (SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
      rootSubgroupPoints (.inl (i.natAdd 2)) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  simp only [coe_shortRankOnePoints, shortRankOneGL_upper_transvection]

/-- Lower transvections give the negative short-root subgroup with its numbered parameter. -/
@[simp]
theorem shortRankOnePoints_lower_transvection (t : K) :
    shortRankOnePoints K i (SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
      rootSubgroupPoints (.inr (i.natAdd 2)) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  simp only [coe_shortRankOnePoints, shortRankOneGL_lower_transvection]

/-- The rank-one diagonal is the numbered simple-coroot point. -/
@[simp]
theorem shortRankOnePoints_diag2nUnit (u : Kˣ) :
    shortRankOnePoints K i (SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints K (Pi.mulSingle (i.natAdd 2) u) := by
  apply Subtype.ext
  simp only [coe_shortRankOnePoints, shortRankOneGL_diag2nUnit]

/-- The image is exactly the subgroup generated by the two opposite short-root families. -/
theorem range_shortRankOnePoints :
    (shortRankOnePoints K i).range = Subgroup.closure
      (Set.range (rootSubgroupPoints (.inl (i.natAdd 2)) K) ∪
        Set.range (rootSubgroupPoints (.inr (i.natAdd 2)) K)) := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [← Subgroup.mem_map_iff_mem (points K).subtype_injective, Subgroup.subtype_apply,
      coe_shortRankOnePoints]
    apply shortRankOneGL_mem_of_root_mem K i
    · intro t
      exact Subgroup.mem_map.mpr ⟨_,
        Subgroup.subset_closure (Set.mem_union_left _ (Set.mem_range_self _)), rfl⟩
    · intro t
      exact Subgroup.mem_map.mpr ⟨_,
        Subgroup.subset_closure (Set.mem_union_right _ (Set.mem_range_self _)), rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
    · exact ⟨SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
        (Multiplicative.toAdd t), by simp⟩
    · exact ⟨SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0)
        (Multiplicative.toAdd t), by simp⟩

end

end TauCeti.F4ShortRoot
