attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance high] Algebra.toModule

universe v

local notation "CM" => CartanMatrix.F₄ᵀ
local notation "rootGen" => TauCeti.serreRootGenerator CM
local notation "cartanGen" => TauCeti.serreH ℚ CM
local notation "rootWeight" => DynkinType.F4.rootGeneratorWeight DynkinType.valid_F4

namespace PrimeField

/-- The coordinate Hopf algebra receiving a reduced root-subgroup or weight-torus generator: that
of the additive group over `𝔽₂` at a root index, and that of the rank-four split torus over `𝔽₂`
at the torus index. -/
noncomputable abbrev generatorCodomain :
    (Fin 4 ⊕ Fin 4) ⊕ Unit → CommHopfAlgCat (ZMod 2)
  | .inl _ => AdditiveGroup.coordinateHopfAlgebra (ZMod 2)
  | .inr _ => (DiagonalizableGroup.coordinateRing (ZMod 2)
      (SplitTorus.characterGroup (Fin 4))).obj

/-- The generating coordinate maps of the short-root type-`F₄` carrier over `𝔽₂`: the reductions
of the eight numbered simple root-subgroup coordinate maps and of the weight-torus coordinate map,
transported into the coordinate Hopf algebras formed directly over `𝔽₂`. -/
noncomputable def generator :
    ∀ j, TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 2) 26 ⟶ generatorCodomain j
  | .inl k => kostantRootSubgroupBaseChangePresentationCoordinateMap rootGen cartanGen rep
      lattice.toAddSubgroup rep_kostantForm_mem_lattice
      isNilpotent_rep_serreRootGenerator latticeBasis (ZMod 2) k
  | .inr _ => TauCeti.GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ (ZMod 2) f4ShortRootWeight

/-- At a root index the generating family is the reduced root-subgroup coordinate map. -/
theorem generator_inl (k : Fin 4 ⊕ Fin 4) :
    generator (.inl k) =
      kostantRootSubgroupBaseChangePresentationCoordinateMap rootGen cartanGen rep
        lattice.toAddSubgroup rep_kostantForm_mem_lattice
        isNilpotent_rep_serreRootGenerator latticeBasis (ZMod 2) k := by
  rw [generator]

/-- At the torus index the generating family is the reduced weight-torus coordinate map. -/
theorem generator_inr :
    generator (.inr ()) =
      TauCeti.GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ (ZMod 2) f4ShortRootWeight := by
  rw [generator]

/-- The Hopf ideal cutting out the short-root type-`F₄` carrier over `𝔽₂` inside `GL₂₆`: the
largest Hopf ideal of `O(GL₂₆/𝔽₂)` killed by all the reduced generators. -/
noncomputable def definingIdeal :
    HopfIdeal (ZMod 2) (TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 2) 26) :=
  CommHopfAlgCat.commonKernelHopfIdeal generator

/-- The defining ideal is the common-kernel ideal of the reduced generators. -/
theorem definingIdeal_def :
    definingIdeal = CommHopfAlgCat.commonKernelHopfIdeal generator := by
  rw [definingIdeal]

/-- **The short-root type-`F₄` carrier over `𝔽₂`**: the closed subgroup scheme of `GL₂₆` over `𝔽₂`
generated by the reductions of the numbered simple root subgroups and of the weight torus. -/
noncomputable abbrev groupScheme : Grp (Over (Spec (CommRingCat.of (ZMod 2)))) :=
  TauCeti.GeneralLinear.generatedGroupScheme 26 generator

/-- The quotient-spectrum presentation of the carrier over `𝔽₂`. -/
theorem groupScheme_def :
    groupScheme = CommHopfAlgCat.quotientSpec
      (TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 2) 26) definingIdeal := by
  rw [groupScheme, definingIdeal]

/-- The canonical inclusion of the carrier over `𝔽₂` into `GL₂₆`. -/
noncomputable def carrierι : groupScheme ⟶ TauCeti.GeneralLinear.groupScheme (ZMod 2) 26 :=
  TauCeti.GeneralLinear.generatedGroupSchemeι 26 generator

/-- The ambient inclusion is the one of the generated subgroup scheme. -/
theorem carrierι_def :
    carrierι = TauCeti.GeneralLinear.generatedGroupSchemeι 26 generator := by
  rw [carrierι]

/-- The carrier over `𝔽₂` is a closed subgroup scheme of `GL₂₆`. -/
instance isClosedImmersion_carrierι : IsClosedImmersion carrierι.hom.hom.left := by
  rw [carrierι]
  exact TauCeti.GeneralLinear.isClosedImmersion_generatedGroupSchemeι 26 generator

/-- A positive or negative numbered simple root subgroup of the carrier over `𝔽₂`. -/
noncomputable def rootSubgroup (k : Fin 4 ⊕ Fin 4) :
    AdditiveGroup.groupScheme (ZMod 2) ⟶ groupScheme :=
  eqToHom (AdditiveGroup.groupScheme_def (ZMod 2)) ≫
    TauCeti.GeneralLinear.generatedGroupSchemeGenerator 26 generator (.inl k)

/-- The numbered root subgroup is the generator of the generated subgroup scheme it indexes. -/
theorem rootSubgroup_def (k : Fin 4 ⊕ Fin 4) :
    rootSubgroup k =
      eqToHom (AdditiveGroup.groupScheme_def (ZMod 2)) ≫
        TauCeti.GeneralLinear.generatedGroupSchemeGenerator 26 generator (.inl k) := by
  rw [rootSubgroup]

/-- The rank-four split weight torus in the carrier over `𝔽₂`. -/
noncomputable def weightTorus : SplitTorus.groupScheme (ZMod 2) (Fin 4) ⟶ groupScheme :=
  eqToHom (DiagonalizableGroup.groupScheme_def (ZMod 2) (SplitTorus.characterGroup (Fin 4))) ≫
    TauCeti.GeneralLinear.generatedGroupSchemeGenerator 26 generator (.inr ())

/-- The weight torus is the generator of the generated subgroup scheme it indexes. -/
theorem weightTorus_def :
    weightTorus =
      eqToHom
          (DiagonalizableGroup.groupScheme_def (ZMod 2) (SplitTorus.characterGroup (Fin 4))) ≫
        TauCeti.GeneralLinear.generatedGroupSchemeGenerator 26 generator (.inr ()) := by
  rw [weightTorus]

/-- **The carrier over `𝔽₂` is a closed subgroup scheme of the base change of the integral
short-root carrier.** The reverse containment is not claimed: the integral defining ideal is the
largest Hopf ideal killed by the generators over `ℤ` only, and new equations can appear over a
base that is not flat. -/
theorem baseChangePresentationIdeal_le_definingIdeal :
    kostantToralBaseChangePresentationIdeal rootGen cartanGen rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis
        f4ShortRootWeight
        (ZMod 2) ≤
      definingIdeal := by
  rw [definingIdeal_def, CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  rintro (k | ⟨⟩)
  · rw [generator_inl]
    exact kostantToralBaseChangePresentationIdeal_toIdeal_le_root_ker rootGen cartanGen rep
      lattice.toAddSubgroup rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator
      latticeBasis f4ShortRootWeight (ZMod 2) k
  · rw [generator_inr]
    exact kostantToralBaseChangePresentationIdeal_toIdeal_le_torus_ker rootGen cartanGen rep
      lattice.toAddSubgroup rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator
      latticeBasis f4ShortRootWeight (ZMod 2)

/-! ## Matrix-valued points -/

/-- The matrix-valued points of the short-root type-`F₄` carrier over `𝔽₂`. -/
noncomputable def points (A : Type v) [CommRing A] [Algebra (ZMod 2) A] :
    Subgroup (_root_.Matrix.GeneralLinearGroup (Fin 26) A) :=
  TauCeti.GeneralLinear.generatedPointsSubgroup 26 generator A

/-- The points of the carrier over `𝔽₂` are the points of the subgroup scheme generated by the
reduced generators. -/
theorem points_def (A : Type v) [CommRing A] [Algebra (ZMod 2) A] :
    points A = TauCeti.GeneralLinear.generatedPointsSubgroup 26 generator A := by
  rw [points]

/-- The points of the carrier over `𝔽₂` are cut out by its defining Hopf ideal. -/
theorem points_eq_hopfIdealPointsSubgroup (A : Type v) [CommRing A] [Algebra (ZMod 2) A] :
    points A = TauCeti.GeneralLinear.hopfIdealPointsSubgroup 26 definingIdeal A := by
  rw [points, definingIdeal]
  exact TauCeti.GeneralLinear.generatedPointsSubgroup_def 26 generator A

/-- A matrix is a point of the carrier over `𝔽₂` exactly when its associated convolution point
kills the carrier's defining Hopf ideal. -/
@[simp]
theorem mem_points_iff (A : Type v) [CommRing A] [Algebra (ZMod 2) A]
    (g : _root_.Matrix.GeneralLinearGroup (Fin 26) A) :
    g ∈ points A ↔ ∀ x ∈ definingIdeal,
      ((TauCeti.GeneralLinear.pointsMulEquiv (R := ZMod 2) 26).symm g).ofConv x = 0 := by
  rw [points_eq_hopfIdealPointsSubgroup]
  exact TauCeti.GeneralLinear.mem_hopfIdealPointsSubgroup_iff 26 definingIdeal A g

/-- **Every point of the carrier over `𝔽₂` is a point of the base change of the integral
short-root carrier.** -/
theorem points_le_baseChangePresentationPoints (A : Type v) [CommRing A] [Algebra (ZMod 2) A] :
    points A ≤ TauCeti.GeneralLinear.hopfIdealPointsSubgroup 26
      (kostantToralBaseChangePresentationIdeal rootGen cartanGen rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis
        f4ShortRootWeight
        (ZMod 2)) A := by
  rw [points_eq_hopfIdealPointsSubgroup]
  exact TauCeti.GeneralLinear.hopfIdealPointsSubgroup_le_of_le 26
    baseChangePresentationIdeal_le_definingIdeal A

/-- The parametrized numbered simple root subgroup inside the points of the carrier over `𝔽₂`. -/
noncomputable def rootSubgroupPoints (k : Fin 4 ⊕ Fin 4) (A : Type v) [CommRing A]
    [Algebra (ZMod 2) A] : Multiplicative A →* points A :=
  MonoidHom.codRestrict
    (((TauCeti.GeneralLinear.pointsMulEquiv (R := ZMod 2) 26).toMonoidHom.comp
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inl k))).app
          (CommAlgCat.of (ZMod 2) A)).hom).comp
      (AdditiveGroup.gaPointsMulEquiv (R := ZMod 2) (A := A)).symm.toMonoidHom)
    (points A)
    fun _ => TauCeti.GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup
      26 generator (.inl k) A _

/-- **A numbered simple-root point of the carrier over `𝔽₂` is the corresponding point of the
integral carrier**, as a matrix. -/
theorem coe_rootSubgroupPoints (k : Fin 4 ⊕ Fin 4) (A : Type v) [CommRing A]
    [Algebra (ZMod 2) A] (u : Multiplicative A) :
    (rootSubgroupPoints k A u : _root_.Matrix.GeneralLinearGroup (Fin 26) A) =
      (_root_.TauCeti.F4ShortRoot.rootSubgroupPoints k A u :
        _root_.Matrix.GeneralLinearGroup (Fin 26) A) := by
  set q : HopfAlgebra.points (R := ZMod 2)
      (H := AdditiveGroup.coordinateHopfAlgebra (ZMod 2)) (CommAlgCat.of (ZMod 2) A) :=
    (AdditiveGroup.gaPointsMulEquiv (R := ZMod 2) (A := A)).symm u with hqdef
  have hu : AdditiveGroup.gaPointsMulEquiv (R := ZMod 2) (A := A) q = u := by
    rw [hqdef, MulEquiv.apply_symm_apply]
  have hq := pointsMulEquiv_kostantRootSubgroupToralBaseChangeCoordinateMap rootGen cartanGen
    rep lattice.toAddSubgroup rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator
    latticeBasis f4ShortRootWeight (ZMod 2) _root_.TauCeti.F4ShortRoot.definingIdeal_def k
    (CommAlgCat.of (ZMod 2) A) q
  rw [hu] at hq
  have hcomp :
      (CommHopfAlgCat.mapPointsFunctor (generator (.inl k))).app (CommAlgCat.of (ZMod 2) A) q =
        CommHopfAlgCat.quotientPointsHom
          (TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 2) 26)
          (kostantToralBaseChangePresentationIdeal rootGen cartanGen rep lattice.toAddSubgroup
            rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis
        f4ShortRootWeight
            (ZMod 2))
          (CommAlgCat.of (ZMod 2) A)
          ((CommHopfAlgCat.mapPointsFunctor
            (kostantRootSubgroupToralBaseChangePresentationCoordinateMap rootGen cartanGen rep
              lattice.toAddSubgroup rep_kostantForm_mem_lattice
              isNilpotent_rep_serreRootGenerator latticeBasis f4ShortRootWeight (ZMod 2) k)).app
            (CommAlgCat.of (ZMod 2) A) q) := by
    rw [CommHopfAlgCat.quotientPointsHom, generator_inl,
      ← mkQuotient_comp_kostantRootSubgroupToralBaseChangePresentationCoordinateMap
        rootGen cartanGen rep lattice.toAddSubgroup rep_kostantForm_mem_lattice
        isNilpotent_rep_serreRootGenerator latticeBasis f4ShortRootWeight (ZMod 2) k,
      CommHopfAlgCat.mapPointsFunctor_comp]
    rfl
  rw [_root_.TauCeti.F4ShortRoot.coe_rootSubgroupPoints, ← hq, ← hcomp]
  rfl

/-- A numbered simple-root point of the carrier over `𝔽₂` is the image of the corresponding point
of `𝔾ₐ` under the generating coordinate map. -/
theorem coe_rootSubgroupPoints_gaPointsMulEquiv (k : Fin 4 ⊕ Fin 4) (A : Type v) [CommRing A]
    [Algebra (ZMod 2) A]
    (q : HopfAlgebra.points (R := ZMod 2)
      (H := AdditiveGroup.coordinateHopfAlgebra (ZMod 2)) (CommAlgCat.of (ZMod 2) A)) :
    (rootSubgroupPoints k A (AdditiveGroup.gaPointsMulEquiv (R := ZMod 2) q) :
        _root_.Matrix.GeneralLinearGroup (Fin 26) A) =
      TauCeti.GeneralLinear.pointsMulEquiv 26
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inl k))).app
          (CommAlgCat.of (ZMod 2) A) q) := by
  rw [rootSubgroupPoints]
  exact congrArg _ (congrArg _ (MulEquiv.symm_apply_apply _ q))

/-- The split weight torus inside the points of the carrier over `𝔽₂`. -/
noncomputable def weightTorusPoints (A : Type v) [CommRing A] [Algebra (ZMod 2) A] :
    (Fin 4 → Aˣ) →* points A :=
  MonoidHom.codRestrict
    (((TauCeti.GeneralLinear.pointsMulEquiv (R := ZMod 2) 26).toMonoidHom.comp
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inr ()))).app
          (CommAlgCat.of (ZMod 2) A)).hom).comp
      (SplitTorus.pointsMulEquiv (R := ZMod 2) (A := CommAlgCat.of (ZMod 2) A)
        (σ := Fin 4)).symm.toMonoidHom)
    (points A)
    fun _ => TauCeti.GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup
      26 generator (.inr ()) A _

/-- **A weight-torus point of the carrier over `𝔽₂` is the corresponding point of the integral
carrier**, as a matrix. -/
theorem coe_weightTorusPoints (A : Type v) [CommRing A] [Algebra (ZMod 2) A] (s : Fin 4 → Aˣ) :
    (weightTorusPoints A s : _root_.Matrix.GeneralLinearGroup (Fin 26) A) =
      (_root_.TauCeti.F4ShortRoot.weightTorusPoints A s :
        _root_.Matrix.GeneralLinearGroup (Fin 26) A) := by
  set q : HopfAlgebra.points (R := ZMod 2)
      (H := (DiagonalizableGroup.coordinateRing (ZMod 2)
        (SplitTorus.characterGroup (Fin 4))).obj) (CommAlgCat.of (ZMod 2) A) :=
    (SplitTorus.pointsMulEquiv (R := ZMod 2) (A := CommAlgCat.of (ZMod 2) A)
      (σ := Fin 4)).symm s with hqdef
  have hs : SplitTorus.pointsMulEquiv q = s := by
    rw [hqdef, MulEquiv.apply_symm_apply]
  have hq := pointsMulEquiv_kostantWeightTorusToralBaseChangeCoordinateMap rootGen cartanGen
    rep lattice.toAddSubgroup rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator
    latticeBasis f4ShortRootWeight (ZMod 2) _root_.TauCeti.F4ShortRoot.definingIdeal_def
    (CommAlgCat.of (ZMod 2) A) q
  rw [hs] at hq
  have hcomp :
      (CommHopfAlgCat.mapPointsFunctor (generator (.inr ()))).app (CommAlgCat.of (ZMod 2) A) q =
        CommHopfAlgCat.quotientPointsHom
          (TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 2) 26)
          (kostantToralBaseChangePresentationIdeal rootGen cartanGen rep lattice.toAddSubgroup
            rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis
        f4ShortRootWeight
            (ZMod 2))
          (CommAlgCat.of (ZMod 2) A)
          ((CommHopfAlgCat.mapPointsFunctor
            (kostantWeightTorusToralBaseChangePresentationCoordinateMap rootGen cartanGen rep
              lattice.toAddSubgroup rep_kostantForm_mem_lattice
              isNilpotent_rep_serreRootGenerator latticeBasis f4ShortRootWeight (ZMod 2))).app
            (CommAlgCat.of (ZMod 2) A) q) := by
    rw [CommHopfAlgCat.quotientPointsHom, generator_inr,
      ← mkQuotient_comp_kostantWeightTorusToralBaseChangePresentationCoordinateMap
        rootGen cartanGen rep lattice.toAddSubgroup rep_kostantForm_mem_lattice
        isNilpotent_rep_serreRootGenerator latticeBasis f4ShortRootWeight (ZMod 2),
      CommHopfAlgCat.mapPointsFunctor_comp]
    rfl
  rw [_root_.TauCeti.F4ShortRoot.coe_weightTorusPoints, ← hq, ← hcomp]
  rfl

/-- A weight-torus point of the carrier over `𝔽₂` is the image of the corresponding point of the
split torus under the generating coordinate map. -/
theorem coe_weightTorusPoints_pointsMulEquiv (A : Type v) [CommRing A] [Algebra (ZMod 2) A]
    (q : HopfAlgebra.points (R := ZMod 2)
      (H := (DiagonalizableGroup.coordinateRing (ZMod 2)
        (SplitTorus.characterGroup (Fin 4))).obj) (CommAlgCat.of (ZMod 2) A)) :
    (weightTorusPoints A (SplitTorus.pointsMulEquiv q) :
        _root_.Matrix.GeneralLinearGroup (Fin 26) A) =
      TauCeti.GeneralLinear.pointsMulEquiv 26
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inr ()))).app
          (CommAlgCat.of (ZMod 2) A) q) := by
  rw [weightTorusPoints]
  exact congrArg _ (congrArg _ (MulEquiv.symm_apply_apply _ q))

/-- **The pinning equation on matrix-valued points of the carrier over `𝔽₂`**: conjugation by a
point `s` of the weight torus rescales the parameter of each numbered simple root subgroup by the
corresponding type-`F₄` root character evaluated at `s`. -/
@[simp]
theorem weightTorusPoints_conj_rootSubgroupPoints (k : Fin 4 ⊕ Fin 4) (A : Type v) [CommRing A]
    [Algebra (ZMod 2) A] (s : Fin 4 → Aˣ) (u : Multiplicative A) :
    weightTorusPoints A s * rootSubgroupPoints k A u * (weightTorusPoints A s)⁻¹ =
      rootSubgroupPoints k A
        (Multiplicative.ofAdd
          ((TauCeti.torusCharacter s (rootWeight k) : A) * Multiplicative.toAdd u)) := by
  apply Subtype.ext
  have hint := congrArg Subtype.val
    (_root_.TauCeti.F4ShortRoot.weightTorusPoints_conj_rootSubgroupPoints k A s u)
  simpa only [Subgroup.coe_mul, Subgroup.coe_inv, coe_weightTorusPoints,
    coe_rootSubgroupPoints] using hint

/-! ## Functoriality and the Frobenius -/

/-- The map on the points of the carrier over `𝔽₂` induced by a homomorphism of `𝔽₂`-algebras. -/
noncomputable def pointsMap {A B : Type v} [CommRing A] [CommRing B] [Algebra (ZMod 2) A]
    [Algebra (ZMod 2) B] (f : A →ₐ[ZMod 2] B) : points A →* points B :=
  MonoidHom.codRestrict
    ((_root_.Matrix.GeneralLinearGroup.map (f : A →+* B)).comp (points A).subtype)
    (points B) fun g => by
      rw [points_eq_hopfIdealPointsSubgroup]
      exact TauCeti.GeneralLinear.map_mem_hopfIdealPointsSubgroup 26 definingIdeal f
        (by rw [← points_eq_hopfIdealPointsSubgroup]; exact g.2)

/-- The induced map on points applies the algebra homomorphism entrywise. -/
@[simp]
theorem coe_pointsMap {A B : Type v} [CommRing A] [CommRing B] [Algebra (ZMod 2) A]
    [Algebra (ZMod 2) B] (f : A →ₐ[ZMod 2] B) (g : points A) :
    (pointsMap f g : _root_.Matrix.GeneralLinearGroup (Fin 26) B) =
      _root_.Matrix.GeneralLinearGroup.map (f : A →+* B) g := by
  rw [pointsMap]
  rfl

/-- **The `2 ^ m`-power Frobenius endomorphism of the carrier over `𝔽₂`**, the map on points
induced by the iterated Frobenius of the value algebra.

For `m` positive and `A` an algebraic closure of `𝔽₂`, this is the `2 ^ m`-power Frobenius of the
carrier's points; at `m = 0` it is the identity. -/
noncomputable def frobenius (m : ℕ) (A : Type v) [CommRing A] [Algebra (ZMod 2) A]
    [ExpChar A 2] : points A →* points A :=
  pointsMap (TauCeti.iterateFrobeniusAlgHom 2 m A)

/-- The Frobenius endomorphism of the carrier over `𝔽₂` acts by the entrywise Frobenius. -/
theorem coe_frobenius (m : ℕ) (A : Type v) [CommRing A] [Algebra (ZMod 2) A] [ExpChar A 2]
    (g : points A) :
    (frobenius m A g : _root_.Matrix.GeneralLinearGroup (Fin 26) A) =
      _root_.Matrix.GeneralLinearGroup.map (iterateFrobenius A 2 m) g := by
  rw [frobenius, coe_pointsMap, TauCeti.coe_iterateFrobeniusAlgHom]

/-- Entrywise, the Frobenius endomorphism of the carrier over `𝔽₂` raises each matrix coefficient
to its `2 ^ m`-th power. -/
@[simp]
theorem coe_frobenius_apply (m : ℕ) (A : Type v) [CommRing A] [Algebra (ZMod 2) A] [ExpChar A 2]
    (g : points A) (i j : Fin 26) :
    ((frobenius m A g : _root_.Matrix.GeneralLinearGroup (Fin 26) A) :
        Matrix (Fin 26) (Fin 26) A) i j =
      ((g : _root_.Matrix.GeneralLinearGroup (Fin 26) A) :
        Matrix (Fin 26) (Fin 26) A) i j ^ 2 ^ m := by
  rw [coe_frobenius, _root_.Matrix.GeneralLinearGroup.map_apply, iterateFrobenius_def]

/-- The zeroth Frobenius iterate is the identity on the carrier's point group. -/
@[simp]
theorem frobenius_zero (A : Type v) [CommRing A] [Algebra (ZMod 2) A] [ExpChar A 2] :
    frobenius 0 A = MonoidHom.id _ := by
  refine MonoidHom.ext fun g => ?_
  apply Subtype.ext
  apply _root_.Units.ext
  ext a b
  rw [coe_frobenius_apply]
  simp

/-- Frobenius iterates add under composition on the carrier's point group. -/
theorem frobenius_add (m k : ℕ) (A : Type v) [CommRing A] [Algebra (ZMod 2) A] [ExpChar A 2] :
    frobenius (m + k) A = (frobenius m A).comp (frobenius k A) := by
  refine MonoidHom.ext fun g => ?_
  apply Subtype.ext
  apply _root_.Units.ext
  ext a b
  rw [coe_frobenius_apply, MonoidHom.comp_apply, coe_frobenius_apply, coe_frobenius_apply,
    ← pow_mul, ← pow_add, Nat.add_comm k m]

/-- **Frobenius raises the parameter of every numbered simple root subgroup to its `2 ^ m`-th
power.** -/
@[simp]
theorem frobenius_rootSubgroupPoints (m : ℕ) (A : Type v) [CommRing A] [Algebra (ZMod 2) A]
    [ExpChar A 2] (k : Fin 4 ⊕ Fin 4) (u : Multiplicative A) :
    frobenius m A (rootSubgroupPoints k A u) =
      rootSubgroupPoints k A (Multiplicative.ofAdd (Multiplicative.toAdd u ^ 2 ^ m)) := by
  apply Subtype.ext
  rw [coe_frobenius, coe_rootSubgroupPoints, coe_rootSubgroupPoints,
    ← _root_.TauCeti.F4ShortRoot.coe_pointsMap (iterateFrobenius A 2 m),
    _root_.TauCeti.F4ShortRoot.pointsMap_rootSubgroupPoints]
  rfl

/-- **Frobenius raises every coordinate of the pinned split weight torus to its `2 ^ m`-th
power.** -/
@[simp]
theorem frobenius_weightTorusPoints (m : ℕ) (A : Type v) [CommRing A] [Algebra (ZMod 2) A]
    [ExpChar A 2] (s : Fin 4 → Aˣ) :
    frobenius m A (weightTorusPoints A s) = weightTorusPoints A (s ^ 2 ^ m) := by
  apply Subtype.ext
  rw [coe_frobenius, coe_weightTorusPoints, coe_weightTorusPoints,
    ← _root_.TauCeti.F4ShortRoot.coe_pointsMap (iterateFrobenius A 2 m),
    _root_.TauCeti.F4ShortRoot.pointsMap_weightTorusPoints,
    _root_.TauCeti.map_iterateFrobenius_units_eq_pow]

end PrimeField

