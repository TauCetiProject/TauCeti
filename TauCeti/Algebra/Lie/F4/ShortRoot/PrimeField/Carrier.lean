/-!
# The short-root type-F4 carrier over the prime field of characteristic two

The short-root type-`F₄` carrier over `ℤ` is the Kostant toral closure of the twenty-six-dimensional
module `V(ϖ₄)` inside `GL₂₆`: the largest Hopf ideal of `O(GL₂₆/ℤ)` killed by the coordinate maps of
the eight numbered simple root subgroups and of the rank-four weight torus. This file forms the
companion carrier over the prime field `𝔽₂`: the closed subgroup scheme of `GL₂₆` over `𝔽₂`
generated by the reductions of those same coordinate maps.

Over `𝔽₂` the defining ideal is again maximal among Hopf ideals killed by the generators, this
time by construction. That maximality is what lets a homomorphism to `GL₂₆` satisfying the
generator equations be restricted to an endomorphism of the carrier, and it is not available for
the base change of the integral carrier, whose defining ideal is maximal over `ℤ` only: new
equations can appear over a base that is not flat. The two carriers are compared in the honest
direction only, and no flatness is asserted.

The root subgroups and weight torus are the reductions of the integral ones. Their matrix-valued
points and functoriality are developed in `PrimeField.PointsFunctor`; Frobenius is developed in
`PrimeField.Frobenius`.

The carrier is not identified with the pinned simply connected group scheme of type `F₄`, and
constructions on it transfer to that group scheme only along such an identification, once one is
proved.

## Main definitions

* `TauCeti.F4ShortRoot.PrimeField.generator`: the reduced coordinate maps of the eight numbered
  simple root subgroups and of the weight torus.
* `TauCeti.F4ShortRoot.PrimeField.groupScheme`: the closed subgroup scheme of `GL₂₆` over `𝔽₂`
  they generate, with `carrierι` its closed immersion into `GL₂₆`.
* `TauCeti.F4ShortRoot.PrimeField.rootSubgroup` and
  `TauCeti.F4ShortRoot.PrimeField.weightTorus`: the generators, factored through it.

## Main results

* `TauCeti.F4ShortRoot.PrimeField.baseChangePresentationIdeal_le_definingIdeal` and
  `TauCeti.F4ShortRoot.PrimeField.groupScheme_hom_ext`: the honest one-way comparison with the
  integral presentation and rigidity of morphisms out of the generated carrier.

## References

The construction is motivated by the Chevalley--Demazure construction on the
twenty-six-dimensional module over the prime field; see R. W. Carter, *Simple Groups of Lie
Type*, §§4.4 and 7.1, and
J. E. Humphreys, *Linear Algebraic Groups*, §26. The weight conventions follow N. Bourbaki, *Lie
Groups and Lie Algebras, Chapters 4--6*, Plate VIII.
-/

public section

open AlgebraicGeometry CategoryTheory

open scoped Matrix

namespace TauCeti.F4ShortRoot

open TauCeti.DynkinType
open TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance high] Algebra.toModule

local notation "CM" => CartanMatrix.F₄ᵀ
local notation "rootGen" => TauCeti.serreRootGenerator CM
local notation "cartanGen" => TauCeti.serreH ℚ CM
local notation "rootWeight" => DynkinType.F4.rootGeneratorWeight DynkinType.valid_F4

namespace PrimeField

/-- The coordinate Hopf algebra receiving a reduced root-subgroup or weight-torus generator: that
of the additive group over `𝔽₂` at a root index, and that of the rank-four split torus over `𝔽₂`
at the torus index. -/
noncomputable abbrev generatorCodomain :
    (Fin 4 ⊕ Fin 4) ⊕ Unit → CommHopfAlgCat (ZMod 2)
  | .inl _ => AdditiveGroup.coordinateHopfAlgebra (ZMod 2)
  | .inr _ => (DiagonalizableGroup.coordinateRing (ZMod 2)
      (SplitTorus.characterGroup (Fin 4))).obj

/-- The generating coordinate maps of the short-root type-`F₄` carrier over `𝔽₂`: the reductions
of the eight numbered simple root-subgroup coordinate maps and of the weight-torus coordinate map,
transported into the coordinate Hopf algebras formed directly over `𝔽₂`. -/
noncomputable def generator :
    ∀ j, TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 2) 26 ⟶ generatorCodomain j
  | .inl k => kostantRootSubgroupBaseChangePresentationCoordinateMap rootGen cartanGen rep
      lattice.toAddSubgroup rep_kostantForm_mem_lattice
      isNilpotent_rep_serreRootGenerator latticeBasis (ZMod 2) k
  | .inr _ => TauCeti.GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ (ZMod 2) f4ShortRootWeight

/-- At a root index the generating family is the reduced root-subgroup coordinate map. -/
theorem generator_inl (k : Fin 4 ⊕ Fin 4) :
    generator (.inl k) =
      kostantRootSubgroupBaseChangePresentationCoordinateMap rootGen cartanGen rep
        lattice.toAddSubgroup rep_kostantForm_mem_lattice
        isNilpotent_rep_serreRootGenerator latticeBasis (ZMod 2) k := by
  rw [generator]

/-- At the torus index the generating family is the reduced weight-torus coordinate map. -/
theorem generator_inr :
    generator (.inr ()) =
      TauCeti.GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ (ZMod 2) f4ShortRootWeight := by
  rw [generator]

/-- The Hopf ideal cutting out the short-root type-`F₄` carrier over `𝔽₂` inside `GL₂₆`: the
largest Hopf ideal of `O(GL₂₆/𝔽₂)` killed by all the reduced generators. -/
noncomputable def definingIdeal :
    HopfIdeal (ZMod 2) (TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 2) 26) :=
  CommHopfAlgCat.commonKernelHopfIdeal generator

/-- The defining ideal is the common-kernel ideal of the reduced generators. -/
theorem definingIdeal_def :
    definingIdeal = CommHopfAlgCat.commonKernelHopfIdeal generator := by
  rw [definingIdeal]

/-- **The short-root type-`F₄` carrier over `𝔽₂`**: the closed subgroup scheme of `GL₂₆` over `𝔽₂`
generated by the reductions of the numbered simple root subgroups and of the weight torus. -/
noncomputable abbrev groupScheme : Grp (Over (Spec (CommRingCat.of (ZMod 2)))) :=
  TauCeti.GeneralLinear.generatedGroupScheme 26 generator

/-- The quotient-spectrum presentation of the carrier over `𝔽₂`. -/
theorem groupScheme_def :
    groupScheme = CommHopfAlgCat.quotientSpec
      (TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 2) 26) definingIdeal := by
  rw [definingIdeal_def]
  exact TauCeti.GeneralLinear.generatedGroupScheme_def 26 generator

/-- The canonical inclusion of the carrier over `𝔽₂` into `GL₂₆`. -/
noncomputable def carrierι : groupScheme ⟶ TauCeti.GeneralLinear.groupScheme (ZMod 2) 26 :=
  TauCeti.GeneralLinear.generatedGroupSchemeι 26 generator

/-- The ambient inclusion is the one of the generated subgroup scheme. -/
theorem carrierι_def :
    carrierι = TauCeti.GeneralLinear.generatedGroupSchemeι 26 generator := by
  rw [carrierι]

/-- The carrier over `𝔽₂` is a closed subgroup scheme of `GL₂₆`. -/
instance isClosedImmersion_carrierι : IsClosedImmersion carrierι.hom.hom.left := by
  rw [carrierι]
  exact TauCeti.GeneralLinear.isClosedImmersion_generatedGroupSchemeι 26 generator

/-- A positive or negative numbered simple root subgroup of the carrier over `𝔽₂`. -/
noncomputable def rootSubgroup (k : Fin 4 ⊕ Fin 4) :
    AdditiveGroup.groupScheme (ZMod 2) ⟶ groupScheme :=
  eqToHom (AdditiveGroup.groupScheme_def (ZMod 2)) ≫
    TauCeti.GeneralLinear.generatorToGeneratedGroupScheme 26 generator (.inl k)

/-- The numbered root subgroup is the generator of the generated subgroup scheme it indexes. -/
theorem rootSubgroup_def (k : Fin 4 ⊕ Fin 4) :
    rootSubgroup k =
      eqToHom (AdditiveGroup.groupScheme_def (ZMod 2)) ≫
        TauCeti.GeneralLinear.generatorToGeneratedGroupScheme 26 generator (.inl k) := by
  rw [rootSubgroup]

/-- The rank-four split weight torus in the carrier over `𝔽₂`. -/
noncomputable def weightTorus : SplitTorus.groupScheme (ZMod 2) (Fin 4) ⟶ groupScheme :=
  eqToHom (DiagonalizableGroup.groupScheme_def (ZMod 2) (SplitTorus.characterGroup (Fin 4))) ≫
    TauCeti.GeneralLinear.generatorToGeneratedGroupScheme 26 generator (.inr ())

/-- The weight torus is the generator of the generated subgroup scheme it indexes. -/
theorem weightTorus_def :
    weightTorus =
      eqToHom
        (DiagonalizableGroup.groupScheme_def (ZMod 2) (SplitTorus.characterGroup (Fin 4))) ≫
        TauCeti.GeneralLinear.generatorToGeneratedGroupScheme 26 generator (.inr ()) := by
  rw [weightTorus]

/-- Including a numbered root subgroup into `GL₂₆` recovers the reduced generating morphism. -/
@[simp]
theorem rootSubgroup_comp_carrierι (k : Fin 4 ⊕ Fin 4) :
    rootSubgroup k ≫ carrierι =
      eqToHom (AdditiveGroup.groupScheme_def (ZMod 2)) ≫
        (hopfSpec (CommRingCat.of (ZMod 2))).map (generator (.inl k)).op ≫
          eqToHom (TauCeti.GeneralLinear.groupScheme_def (ZMod 2) 26).symm := by
  rw [rootSubgroup_def, carrierι_def, Category.assoc,
    TauCeti.GeneralLinear.generatorToGeneratedGroupScheme_comp_ι]

/-- Including the weight torus into `GL₂₆` recovers the reduced generating morphism. -/
@[simp]
theorem weightTorus_comp_carrierι :
    weightTorus ≫ carrierι =
      eqToHom
          (DiagonalizableGroup.groupScheme_def (ZMod 2) (SplitTorus.characterGroup (Fin 4))) ≫
        (hopfSpec (CommRingCat.of (ZMod 2))).map (generator (.inr ())).op ≫
          eqToHom (TauCeti.GeneralLinear.groupScheme_def (ZMod 2) 26).symm := by
  rw [weightTorus_def, carrierι_def, Category.assoc,
    TauCeti.GeneralLinear.generatorToGeneratedGroupScheme_comp_ι]

/-- Two morphisms out of the prime-field carrier agree when they agree on all eight numbered
root subgroups and on the weight torus. -/
@[ext]
theorem groupScheme_hom_ext {Y : _root_.CommHopfAlgCat.{0} (ZMod 2)}
    (f g : groupScheme ⟶
      (hopfSpec (CommRingCat.of (ZMod 2))).obj (Opposite.op Y))
    (hroot : ∀ k, rootSubgroup k ≫ f = rootSubgroup k ≫ g)
    (htorus : weightTorus ≫ f = weightTorus ≫ g) : f = g := by
  apply (cancel_epi (eqToHom groupScheme_def.symm)).1
  refine CommHopfAlgCat.hom_ext_of_preimage_unop_eq
    (eqToHom groupScheme_def.symm ≫ f) (eqToHom groupScheme_def.symm ≫ g) ?_
  apply CommHopfAlgCat.commonKernelLift_hom_ext generator
  rintro (k | u)
  · refine CommHopfAlgCat.preimage_unop_comp_eq_of_hopfSpec_map_comp_eq _
      (eqToHom groupScheme_def.symm ≫ f) (eqToHom groupScheme_def.symm ≫ g) ?_
    have hk := hroot k
    rw [rootSubgroup_def, TauCeti.GeneralLinear.generatorToGeneratedGroupScheme_def,
      Category.assoc, Category.assoc] at hk
    exact (cancel_epi (eqToHom (AdditiveGroup.groupScheme_def (ZMod 2)))).1 hk
  · rcases u with ⟨⟩
    refine CommHopfAlgCat.preimage_unop_comp_eq_of_hopfSpec_map_comp_eq _
      (eqToHom groupScheme_def.symm ≫ f) (eqToHom groupScheme_def.symm ≫ g) ?_
    rw [weightTorus_def, TauCeti.GeneralLinear.generatorToGeneratedGroupScheme_def,
      Category.assoc, Category.assoc] at htorus
    exact (cancel_epi (eqToHom
      (DiagonalizableGroup.groupScheme_def (ZMod 2)
        (SplitTorus.characterGroup (Fin 4))))).1 htorus

/-- **The carrier over `𝔽₂` is a closed subgroup scheme of the base change of the integral
short-root carrier.** The reverse containment is not claimed: the integral defining ideal is the
largest Hopf ideal killed by the generators over `ℤ` only, and new equations can appear over a
base that is not flat. -/
theorem baseChangePresentationIdeal_le_definingIdeal :
    kostantToralBaseChangePresentationIdeal rootGen cartanGen rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis
        f4ShortRootWeight
        (ZMod 2) ≤
      definingIdeal := by
  have h := kostantToralBaseChangePresentationIdeal_le_commonKernelHopfIdeal rootGen cartanGen rep
    lattice.toAddSubgroup rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator
    latticeBasis f4ShortRootWeight (ZMod 2)
  dsimp only at h
  rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff] at h
  rw [definingIdeal_def, CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  rintro (k | u)
  · simpa only [generator_inl] using h (.inl k)
  · rcases u with ⟨⟩
    rw [generator_inr]
    exact h (.inr ())


end PrimeField

end TauCeti.F4ShortRoot
