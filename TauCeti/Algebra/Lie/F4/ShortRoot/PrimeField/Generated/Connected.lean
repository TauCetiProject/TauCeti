module

public import TauCeti.Algebra.Lie.F4.ShortRoot.PrimeField.Generated.Smooth
public import TauCeti.Algebra.AlgebraicGroup.Connected.Generated
public import TauCeti.Algebra.AlgebraicGroup.Connected.BaseChange
public import Mathlib.Algebra.Field.ZMod
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.SmoothConnected
import TauCeti.Algebra.AlgebraicGroup.AdditiveGroup.CoordinateBaseChange
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.BaseChange

/-!
# Geometric connectedness of the generated short-root type-F₄ carrier

After scalar extension to any field of characteristic 2, the numbered root subgroups and
rank-4 weight torus generate a geometrically connected closed subgroup of `GL_26`. The
generated coordinate algebra is the common-kernel quotient over that field. Existing coordinate
isomorphisms identify each generator codomain with an affine line or split torus. Both are
geometrically connected, so the shared common-kernel criterion applies directly.

The prime-field carrier corollary below follows from this result. Geometric connectedness is
one carrier property for Layer 9B of the ReductiveGroups roadmap; identification with a pinned
group requires a separate argument.

The general criterion is in `TauCeti.Algebra.AlgebraicGroup.Connected.Generated`.
-/

public section

open TauCeti.CommHopfAlgCat

namespace TauCeti.F4ShortRoot.PrimeField

universe u

variable (k : Type u) [Field k] [Algebra (ZMod 2) k]

private theorem geometricallyConnected_baseChangeGeneratorCodomain :
    ∀ j, geometricallyConnectedCommHopfAlgProperty k (baseChangeGeneratorCodomain k j) := by
  intro j
  cases j with
  | inl _ =>
    exact (geometricallyConnectedCommHopfAlgProperty k).prop_of_iso
      (AdditiveGroup.coordinateHopfAlgebraBaseChangeIso (ZMod 2) k).symm
      (AdditiveGroup.geometricallyConnectedCommHopfAlgProperty_coordinateHopfAlgebra k)
  | inr _ =>
    exact (geometricallyConnectedCommHopfAlgProperty k).prop_of_iso
      (DiagonalizableGroup.baseChangeCoordinateHopfAlgebraIso (ZMod 2) k
        (SplitTorus.characterGroup (Fin 4))).symm
      (DiagonalizableGroup.geometricallyConnected_coordinateRing k
        (SplitTorus.characterGroup (Fin 4)))

/-- The closed subgroup generated by the scalar-extended short-root type-`F₄` root subgroups
and weight torus is geometrically connected over every field of characteristic 2. -/
theorem geometricallyConnectedCommHopfAlgProperty_generatedCoordinateHopfAlgebra :
    geometricallyConnectedCommHopfAlgProperty k (generatedCoordinateHopfAlgebra k) := by
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient_of_geometricallyConnected
    (baseChangeGenerator k) (geometricallyConnected_baseChangeGeneratorCodomain k)

/-- **The short-root type-`F₄` carrier over `𝔽₂` is geometrically connected.** -/
theorem geometricallyConnectedCommHopfAlgProperty_quotient_definingIdeal :
    geometricallyConnectedCommHopfAlgProperty (ZMod 2)
      (CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra (ZMod 2) 26) definingIdeal) :=
  geometricallyConnectedCommHopfAlgProperty.of_baseChange (ZMod 2) (AlgebraicClosure (ZMod 2)) _
    ((geometricallyConnectedCommHopfAlgProperty _).prop_of_iso
      (coordinateHopfAlgebraGeneratedIso _).symm
      (geometricallyConnectedCommHopfAlgProperty_generatedCoordinateHopfAlgebra _))

end TauCeti.F4ShortRoot.PrimeField
