module

public import TauCeti.Algebra.Lie.F4.ShortRoot.RankOne.Short
public import TauCeti.Algebra.Lie.F4.ShortRoot.PrimeField.PointsFunctor

/-!
# The short-node SL₂ subgroups in the F₄ carrier over 𝔽₂

Over a characteristic-two field, each opposite short simple-root pair generates a faithful
copy of SL₂ in the carrier generated over 𝔽₂. The integral block action restricts to this
carrier because SL₂ over a field is generated by its upper and lower transvections. No
equality with the specialization of the integral carrier is used. The root parameters and
simple coroot are the numbered ones already supplied by the prime-field carrier.

The containment and exact-image arguments follow `TauCeti.E7Minuscule.rankOnePoints` and
`TauCeti.E7Minuscule.range_rankOnePoints`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, Chapter 6.
-/

public section

open scoped Matrix MatrixGroups

namespace TauCeti.F4ShortRoot.PrimeField

noncomputable section

variable (K : Type*) [Field K] [Algebra (ZMod 2) K] (i : Fin 2)

private theorem shortRankOneGL_mem_of_rootSubgroupPoints_mem
    {H : Subgroup (GL (Fin 26) K)}
    (hpos : ∀ t : K, (rootSubgroupPoints (.inl (i.natAdd 2)) K
      (Multiplicative.ofAdd t) : GL (Fin 26) K) ∈ H)
    (hneg : ∀ t : K, (rootSubgroupPoints (.inr (i.natAdd 2)) K
      (Multiplicative.ofAdd t) : GL (Fin 26) K) ∈ H)
    (g : SL(2, K)) : F4ShortRoot.shortRankOneGL i g ∈ H := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · rw [F4ShortRoot.shortRankOneGL_upper_transvection, ← coe_rootSubgroupPoints]
      exact hpos t
    · rw [F4ShortRoot.shortRankOneGL_lower_transvection, ← coe_rootSubgroupPoints]
      exact hneg t
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using mul_mem hg hh

/-- The faithful SL₂ map into the prime-field carrier at the short node `i + 2`. -/
def shortRankOnePoints : SL(2, K) →* points K :=
  (F4ShortRoot.shortRankOneGL i).codRestrict (points K)
    (shortRankOneGL_mem_of_rootSubgroupPoints_mem K i
      (fun t ↦ (rootSubgroupPoints (.inl (i.natAdd 2)) K (Multiplicative.ofAdd t)).property)
      (fun t ↦ (rootSubgroupPoints (.inr (i.natAdd 2)) K (Multiplicative.ofAdd t)).property))

/-- The carrier-valued map has the integral short-node block matrix. -/
@[simp]
theorem coe_shortRankOnePoints (g : SL(2, K)) :
    (shortRankOnePoints K i g : GL (Fin 26) K) = F4ShortRoot.shortRankOneGL i g :=
  (rfl)

/-- The short-node rank-one map is injective, also in characteristic two. -/
theorem shortRankOnePoints_injective : Function.Injective (shortRankOnePoints K i) := by
  rw [shortRankOnePoints, MonoidHom.injective_codRestrict]
  exact F4ShortRoot.shortRankOneGL_injective i

/-- The upper transvection has the prescribed positive-root parameter. -/
@[simp]
theorem shortRankOnePoints_upper_transvection (t : K) :
    shortRankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        rootSubgroupPoints (.inl (i.natAdd 2)) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  simp only [coe_shortRankOnePoints, coe_rootSubgroupPoints,
    F4ShortRoot.shortRankOneGL_upper_transvection]

/-- The lower transvection has the prescribed negative-root parameter. -/
@[simp]
theorem shortRankOnePoints_lower_transvection (t : K) :
    shortRankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        rootSubgroupPoints (.inr (i.natAdd 2)) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  simp only [coe_shortRankOnePoints, coe_rootSubgroupPoints,
    F4ShortRoot.shortRankOneGL_lower_transvection]

/-- The diagonal maps to the numbered simple coroot in the prime-field carrier. -/
@[simp]
theorem shortRankOnePoints_diag2nUnit (u : Kˣ) :
    shortRankOnePoints K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) =
        weightTorusPoints K (Pi.mulSingle (i.natAdd 2) u) := by
  apply Subtype.ext
  simp only [coe_shortRankOnePoints, coe_weightTorusPoints,
    F4ShortRoot.shortRankOneGL_diag2nUnit]

/-- The image is exactly the subgroup generated by the two opposite short-root families. -/
theorem range_shortRankOnePoints :
    (shortRankOnePoints K i).range =
      Subgroup.closure (Set.range (rootSubgroupPoints (.inl (i.natAdd 2)) K) ∪
        Set.range (rootSubgroupPoints (.inr (i.natAdd 2)) K)) := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [← Subgroup.mem_map_iff_mem (points K).subtype_injective, Subgroup.subtype_apply,
      coe_shortRankOnePoints]
    apply shortRankOneGL_mem_of_rootSubgroupPoints_mem K i
    · intro t
      exact Subgroup.mem_map.mpr ⟨_, Subgroup.subset_closure
        (Set.mem_union_left _ (Set.mem_range_self _)), rfl⟩
    · intro t
      exact Subgroup.mem_map.mpr ⟨_, Subgroup.subset_closure
        (Set.mem_union_right _ (Set.mem_range_self _)), rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
    · refine ⟨Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
        (Multiplicative.toAdd t), ?_⟩
      simp only [shortRankOnePoints_upper_transvection, ofAdd_toAdd]
    · refine ⟨Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0)
        (Multiplicative.toAdd t), ?_⟩
      simp only [shortRankOnePoints_lower_transvection, ofAdd_toAdd]

end

end TauCeti.F4ShortRoot.PrimeField
