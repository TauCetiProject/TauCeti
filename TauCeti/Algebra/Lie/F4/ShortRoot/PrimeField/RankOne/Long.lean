module

public import TauCeti.Algebra.Lie.F4.ShortRoot.RankOne.Long
public import TauCeti.Algebra.Lie.F4.ShortRoot.PrimeField.PointsFunctor

/-!
# Long rank-one subgroups of the short-root F4 prime-field carrier

Over every field of characteristic two, the opposite root subgroups at either long simple node
of the twenty-six-dimensional F₄ carrier generate a faithful copy of SL₂. Its root and coroot
parameters are those of the existing numbered pinning. Containment uses generation of SL₂ by
transvections, not an identification of the prime-field carrier with the specialization of the
integral closure. No such identification, nor agreement with the independently pinned simply
connected group scheme, is asserted here.

The construction follows the image and containment argument in
`TauCeti.Algebra.Lie.E7.Minuscule.RankOne`, using `TauCeti.F4ShortRoot.longRankOneGL` for the
actual matrix action.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, Chapter 6.
-/

public section

open scoped Matrix MatrixGroups

namespace TauCeti.F4ShortRoot.PrimeField

variable (K : Type*) [Field K] [Algebra (ZMod 2) K] (i : Fin 2)

private theorem longRankOneGL_mem_of_root_mem {H : Subgroup (GL (Fin 26) K)}
    (hpos : ∀ t : Multiplicative K,
      (rootSubgroupPoints (.inl (i.castAdd 2)) K t : GL (Fin 26) K) ∈ H)
    (hneg : ∀ t : Multiplicative K,
      (rootSubgroupPoints (.inr (i.castAdd 2)) K t : GL (Fin 26) K) ∈ H)
    (g : SL(2, K)) : longRankOneGL K i g ∈ H := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · rw [longRankOneGL_upper_transvection, ← coe_rootSubgroupPoints]
      exact hpos _
    · rw [longRankOneGL_lower_transvection, ← coe_rootSubgroupPoints]
      exact hneg _
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using H.mul_mem hg hh

/-- The faithful SL₂ map at a long simple node into the short-root F₄ prime-field carrier. -/
noncomputable def longRankOnePoints : SL(2, K) →* points K :=
  (longRankOneGL K i).codRestrict (points K)
    (longRankOneGL_mem_of_root_mem K i (fun t => (rootSubgroupPoints _ K t).property)
      (fun t => (rootSubgroupPoints _ K t).property))

/-- Including the rank-one map into GL₂₆ recovers its explicit matrix action. -/
@[simp]
theorem coe_longRankOnePoints (g : SL(2, K)) :
    (longRankOnePoints K i g : GL (Fin 26) K) = longRankOneGL K i g := by
  rw [longRankOnePoints, MonoidHom.codRestrict_apply]

/-- The long-node map into the prime-field carrier is injective. -/
theorem longRankOnePoints_injective : Function.Injective (longRankOnePoints K i) := by
  rw [longRankOnePoints, MonoidHom.injective_codRestrict]
  exact longRankOneGL_injective K i

/-- The upper transvection has exactly the prescribed positive-root parameter. -/
@[simp]
theorem longRankOnePoints_upper_transvection (t : K) :
    longRankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        rootSubgroupPoints (.inl (i.castAdd 2)) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_longRankOnePoints, coe_rootSubgroupPoints, longRankOneGL_upper_transvection]

/-- The lower transvection has exactly the prescribed negative-root parameter. -/
@[simp]
theorem longRankOnePoints_lower_transvection (t : K) :
    longRankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        rootSubgroupPoints (.inr (i.castAdd 2)) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_longRankOnePoints, coe_rootSubgroupPoints, longRankOneGL_lower_transvection]

/-- The diagonal maps to the simple-coroot value in the existing weight torus. -/
@[simp]
theorem longRankOnePoints_diag2nUnit (u : Kˣ) :
    longRankOnePoints K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) =
        weightTorusPoints K (Pi.mulSingle (i.castAdd 2) u) := by
  apply Subtype.ext
  rw [coe_longRankOnePoints, coe_weightTorusPoints, longRankOneGL_diag2nUnit]

/-- The image is exactly the subgroup generated by the two opposite long-root families. -/
theorem range_longRankOnePoints :
    (longRankOnePoints K i).range = Subgroup.closure
      (Set.range (rootSubgroupPoints (.inl (i.castAdd 2)) K) ∪
        Set.range (rootSubgroupPoints (.inr (i.castAdd 2)) K)) := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [← Subgroup.mem_map_iff_mem (points K).subtype_injective, Subgroup.subtype_apply,
      coe_longRankOnePoints]
    apply longRankOneGL_mem_of_root_mem K i
    · intro t
      exact Subgroup.mem_map.mpr ⟨_, Subgroup.subset_closure
        (Set.mem_union_left _ (Set.mem_range_self t)), rfl⟩
    · intro t
      exact Subgroup.mem_map.mpr ⟨_, Subgroup.subset_closure
        (Set.mem_union_right _ (Set.mem_range_self t)), rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
    · refine ⟨Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
        (Multiplicative.toAdd t), ?_⟩
      rw [longRankOnePoints_upper_transvection, ofAdd_toAdd]
    · refine ⟨Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0)
        (Multiplicative.toAdd t), ?_⟩
      rw [longRankOnePoints_lower_transvection, ofAdd_toAdd]

end TauCeti.F4ShortRoot.PrimeField
