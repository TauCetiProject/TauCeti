/-- **At most two of the multiplication operators are nonzero at a given entry**, those of the
tabulated indices and with the tabulated values. -/
theorem multiplicationOperator_index (a i j : Fin 26) :
    multiplicationOperator a i j =
      (if a = multIndexOne i j then multIndexCoeffOne i j else 0) +
        (if a = multIndexTwo i j then multIndexCoeffTwo i j else 0) := by
  rw [multiplicationOperator_apply]
  revert a i j
  decide +kernel

/-- **An entry of the operator of multiplication by a vector** is a two-term sum. -/
theorem multiplicationBy_apply (v : Fin 26 → R) (i j : Fin 26) :
    multiplicationBy v i j = ((multIndexCoeffOne i j : ℤ) : R) * v (multIndexOne i j) +
      ((multIndexCoeffTwo i j : ℤ) : R) * v (multIndexTwo i j) := by
  have hentry : ∀ a : Fin 26,
      (v a • (multiplicationOperator a).map (Int.cast : ℤ → R)) i j =
        (if a = multIndexOne i j then ((multIndexCoeffOne i j : ℤ) : R) * v a else 0) +
          (if a = multIndexTwo i j then ((multIndexCoeffTwo i j : ℤ) : R) * v a else 0) := by
    intro a
    rw [Matrix.smul_apply, Matrix.map_apply, smul_eq_mul, multiplicationOperator_index]
    push_cast
    split_ifs <;> ring
  rw [multiplicationBy_def, Matrix.sum_apply, Finset.sum_congr rfl fun a _ => hentry a,
    Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.sum_ite_eq']
  simp

/-! ## The derivation equations -/

/-- The step structure of a multiplication operator over an arbitrary commutative ring. -/
theorem isDoubleStep_map_multiplicationOperator (a : Fin 26) :
    ((multiplicationOperator a).map (Int.cast : ℤ → R)).IsDoubleStep (multTargetOne a)
      (fun b => ((multCoeffOne a b : ℤ) : R)) (multTargetTwo a)
      fun b => ((multCoeffTwo a b : ℤ) : R) :=
  (isDoubleStep_multiplicationOperator a).map (Int.castRingHom R)

/-- The row structure of a multiplication operator over an arbitrary commutative ring. -/
theorem isDoubleStep_transpose_map_multiplicationOperator (a : Fin 26) :
    (((multiplicationOperator a).map (Int.cast : ℤ → R))ᵀ).IsDoubleStep (multRowTargetOne a)
      (fun b => ((multRowCoeffOne a b : ℤ) : R)) (multRowTargetTwo a)
      fun b => ((multRowCoeffTwo a b : ℤ) : R) :=
  Matrix.transpose_map ▸ (isDoubleStep_transpose_multiplicationOperator a).map (Int.castRingHom R)

/-- **The derivation equations, entry by entry.** The `(i, j)` entry of the derivation equation of
a matrix on the `k`th column is an identity between two-term sums of matrix entries against table
lookups. -/
theorem IsDerivation.entry {X : Matrix (Fin 26) (Fin 26) R} (hX : IsDerivation X)
    (k i j : Fin 26) :
    X i (multTargetOne k j) * ((multCoeffOne k j : ℤ) : R) +
          X i (multTargetTwo k j) * ((multCoeffTwo k j : ℤ) : R) -
        (((multRowCoeffOne k i : ℤ) : R) * X (multRowTargetOne k i) j +
          ((multRowCoeffTwo k i : ℤ) : R) * X (multRowTargetTwo k i) j) =
      ((multIndexCoeffOne i j : ℤ) : R) * X (multIndexOne i j) k +
        ((multIndexCoeffTwo i j : ℤ) : R) * X (multIndexTwo i j) k := by
  have h := congrFun (congrFun ((isDerivation_def X).mp hX k) i) j
  rwa [Matrix.sub_apply,
    Matrix.IsDoubleStep.mul_apply (isDoubleStep_map_multiplicationOperator k),
    Matrix.IsDoubleStep.transpose_mul_apply (isDoubleStep_transpose_map_multiplicationOperator k),
    multiplicationBy_apply] at h

