/-- **The transpose of a multiplication operator has at most two nonzero entries in each column**,
at the tabulated targets and with the tabulated coefficients. -/
theorem isDoubleStep_transpose_multiplicationOperator (a : Fin 26) :
    (multiplicationOperator a)ᵀ.IsDoubleStep (multRowTargetOne a) (multRowCoeffOne a)
      (multRowTargetTwo a) (multRowCoeffTwo a) := by
  intro i r
  rw [Matrix.transpose_apply, multiplicationOperator_apply]
  revert a i r
  decide +kernel

