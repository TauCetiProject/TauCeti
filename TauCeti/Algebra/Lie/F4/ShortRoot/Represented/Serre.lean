module

public import TauCeti.Algebra.Lie.F4.ShortRoot.Basic
public import TauCeti.Algebra.Lie.Matrix.IntegralCast

/-!
# The represented F₄ Serre algebra and its short-root ideal

The integral short-root matrices give a representation of the type-`F₄` Serre algebra after
base change to any commutative ring.  This file constructs its image as a Lie subalgebra of the
algebra of 26-by-26 matrices.  Over `ZMod 2` it also isolates the Lie ideal generated by the raising
and lowering matrices at the two short simple roots.

This construction first reduces the simple generators and then takes their Lie span. In bad
characteristic this must not be identified with the reduction of the full integral Chevalley
lattice: brackets can acquire coefficients that vanish after reduction. The full reduction used
for the characteristic-two special isogeny is
`TauCeti.DynkinType.f4ModularChevalleyLieAlgebra`, defined in
`TauCeti.Algebra.Lie.F4.ModularLattice`; its short-root ideal is constructed in
`TauCeti.Algebra.Lie.F4.ShortRoot.Modular.Lattice`.

## Main definitions

* `TauCeti.F4ShortRoot.serreRepresentationBaseChange`: the representation after base change.
* `TauCeti.F4ShortRoot.representedSerreAlgebra`: its image in the matrix algebra.
* `TauCeti.F4ShortRoot.representedSerreShortRootIdeal`: the ideal generated by the short simple
  root matrices in
  characteristic two.

## Main results

* `TauCeti.F4ShortRoot.representedSerreAlgebra_eq_lieSpan`: the image is exactly the Lie
  subalgebra generated by the base-changed simple raising and lowering matrices.
* `TauCeti.F4ShortRoot.representedSerreShortRootIdeal_le_iff`: the universal property of the
  short-root ideal.
* `TauCeti.F4ShortRoot.representedH_mem_representedSerreShortRootIdeal`: the short simple
  coroots belong to the
  ideal.

## References

* R. W. Carter, *Simple Groups of Lie Type*, §§12.3 and 13.4.
* R. Steinberg, *Endomorphisms of linear algebraic groups*, Memoirs AMS **80** (1968), §11.
-/

public section

open scoped Matrix

namespace TauCeti.F4ShortRoot

open LieAlgebra TauCeti.DynkinType

attribute [local instance 100] LieRing.ofAssociativeRing

variable (R : Type*) [CommRing R]

/-! ## Base change of the represented generators -/

/-- The integral Cartan generator, with its entries mapped to `R`. -/
noncomputable def cartanMatrixBaseChange (i : Fin 4) : Matrix (Fin 26) (Fin 26) R :=
  TauCeti.matrixIntCastLieHom R (cartanMatrix i)

/-- The integral raising generator, with its entries mapped to `R`. -/
noncomputable def raisingMatrixBaseChange (i : Fin 4) : Matrix (Fin 26) (Fin 26) R :=
  TauCeti.matrixIntCastLieHom R (raisingMatrix i)

/-- The integral lowering generator, with its entries mapped to `R`. -/
noncomputable def loweringMatrixBaseChange (i : Fin 4) : Matrix (Fin 26) (Fin 26) R :=
  TauCeti.matrixIntCastLieHom R (loweringMatrix i)

@[simp]
theorem cartanMatrixBaseChange_apply (i : Fin 4) (a b : Fin 26) :
    cartanMatrixBaseChange R i a b = (cartanMatrix i a b : R) := by
  rw [cartanMatrixBaseChange, TauCeti.matrixIntCastLieHom_apply]

@[simp]
theorem raisingMatrixBaseChange_apply (i : Fin 4) (a b : Fin 26) :
    raisingMatrixBaseChange R i a b = (raisingMatrix i a b : R) := by
  rw [raisingMatrixBaseChange, TauCeti.matrixIntCastLieHom_apply]

@[simp]
theorem loweringMatrixBaseChange_apply (i : Fin 4) (a b : Fin 26) :
    loweringMatrixBaseChange R i a b = (loweringMatrix i a b : R) := by
  rw [loweringMatrixBaseChange, TauCeti.matrixIntCastLieHom_apply]

/-- The base-changed matrices satisfy the type-`F₄` Chevalley--Serre relations. -/
theorem isSerreSystemBaseChange :
    IsSerreSystem R CartanMatrix.F₄ᵀ (cartanMatrixBaseChange R)
      (raisingMatrixBaseChange R) (loweringMatrixBaseChange R) :=
  (isSerreSystem.map (TauCeti.matrixIntCastLieHom R)).changeScalars

/-- The twenty-six-dimensional representation of the type-`F₄` Serre algebra over `R`
obtained by base change from the integral generator matrices. -/
noncomputable def serreRepresentationBaseChange :
    Matrix.ToLieAlgebra R CartanMatrix.F₄ᵀ →ₗ⁅R⁆ Matrix (Fin 26) (Fin 26) R :=
  serreLift (isSerreSystemBaseChange R)

@[simp]
theorem serreRepresentationBaseChange_serreH (i : Fin 4) :
    serreRepresentationBaseChange R (serreH R CartanMatrix.F₄ᵀ i) =
      cartanMatrixBaseChange R i := by
  rw [serreRepresentationBaseChange, serreLift_serreH]

@[simp]
theorem serreRepresentationBaseChange_serreE (i : Fin 4) :
    serreRepresentationBaseChange R (serreE R CartanMatrix.F₄ᵀ i) =
      raisingMatrixBaseChange R i := by
  rw [serreRepresentationBaseChange, serreLift_serreE]

@[simp]
theorem serreRepresentationBaseChange_serreF (i : Fin 4) :
    serreRepresentationBaseChange R (serreF R CartanMatrix.F₄ᵀ i) =
      loweringMatrixBaseChange R i := by
  rw [serreRepresentationBaseChange, serreLift_serreF]

/-! ## The represented Serre algebra -/

/-- The image of the base-changed type-`F₄` Serre representation in the algebra of
26-by-26 matrices. This takes the Lie span after base change, and does not assert an
identification with the base change of the full integral Chevalley lattice. -/
noncomputable def representedSerreAlgebra :
    LieSubalgebra R (Matrix (Fin 26) (Fin 26) R) :=
  (serreRepresentationBaseChange R).range

/-- The represented Serre algebra is generated, as a Lie algebra, by the base-changed raising
and lowering matrices. The Cartan matrices need not be included because `H_i = ⁅E_i, F_i⁆`. -/
theorem representedSerreAlgebra_eq_lieSpan :
    representedSerreAlgebra R =
      LieSubalgebra.lieSpan R (Matrix (Fin 26) (Fin 26) R)
        (Set.range (raisingMatrixBaseChange R) ∪ Set.range (loweringMatrixBaseChange R)) := by
  calc
    representedSerreAlgebra R =
        LieSubalgebra.lieSpan R (Matrix (Fin 26) (Fin 26) R)
          (Set.range (cartanMatrixBaseChange R) ∪ Set.range (raisingMatrixBaseChange R) ∪
            Set.range (loweringMatrixBaseChange R)) := by
      rw [representedSerreAlgebra, LieHom.range_eq_map,
        ← lieSpan_serreGenerators_eq_top R CartanMatrix.F₄ᵀ, LieSubalgebra.map_lieSpan]
      simp only [Set.image_union]
      congr 1
      all_goals ext x; simp
    _ = LieSubalgebra.lieSpan R (Matrix (Fin 26) (Fin 26) R)
        (Set.range (raisingMatrixBaseChange R) ∪ Set.range (loweringMatrixBaseChange R)) := by
      apply le_antisymm
      · rw [LieSubalgebra.lieSpan_le]
        rintro _ ((⟨i, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩)
        · rw [← (isSerreSystemBaseChange R).lie_E_F_self i]
          exact LieSubalgebra.lie_mem _
            (LieSubalgebra.subset_lieSpan (Or.inl ⟨i, rfl⟩))
            (LieSubalgebra.subset_lieSpan (Or.inr ⟨i, rfl⟩))
        · exact LieSubalgebra.subset_lieSpan (Or.inl ⟨i, rfl⟩)
        · exact LieSubalgebra.subset_lieSpan (Or.inr ⟨i, rfl⟩)
      · apply LieSubalgebra.lieSpan_mono
        rintro _ (⟨i, rfl⟩ | ⟨i, rfl⟩)
        · exact Or.inl (Or.inr ⟨i, rfl⟩)
        · exact Or.inr ⟨i, rfl⟩

/-- The represented Cartan generator as an element of the represented Serre algebra. -/
noncomputable def representedH (i : Fin 4) : representedSerreAlgebra R :=
  ⟨cartanMatrixBaseChange R i, by
    rw [← serreRepresentationBaseChange_serreH]
    exact (serreRepresentationBaseChange R).mem_range_self _⟩

/-- The represented raising generator as an element of the represented Serre algebra. -/
noncomputable def representedE (i : Fin 4) : representedSerreAlgebra R :=
  ⟨raisingMatrixBaseChange R i, by
    rw [← serreRepresentationBaseChange_serreE]
    exact (serreRepresentationBaseChange R).mem_range_self _⟩

/-- The represented lowering generator as an element of the represented Serre algebra. -/
noncomputable def representedF (i : Fin 4) : representedSerreAlgebra R :=
  ⟨loweringMatrixBaseChange R i, by
    rw [← serreRepresentationBaseChange_serreF]
    exact (serreRepresentationBaseChange R).mem_range_self _⟩

@[simp] theorem coe_representedH (i : Fin 4) :
    (representedH R i : Matrix (Fin 26) (Fin 26) R) = cartanMatrixBaseChange R i := by
  rw [representedH]

@[simp] theorem coe_representedE (i : Fin 4) :
    (representedE R i : Matrix (Fin 26) (Fin 26) R) = raisingMatrixBaseChange R i := by
  rw [representedE]

@[simp] theorem coe_representedF (i : Fin 4) :
    (representedF R i : Matrix (Fin 26) (Fin 26) R) = loweringMatrixBaseChange R i := by
  rw [representedF]

@[simp]
theorem lie_representedE_representedF_self (i : Fin 4) :
    ⁅representedE R i, representedF R i⁆ = representedH R i := by
  apply Subtype.ext
  exact (isSerreSystemBaseChange R).lie_E_F_self i

/-! ## The short-root ideal in characteristic two -/

/-- The represented raising and lowering matrices at the two short simple roots. -/
private noncomputable def shortSimpleRootGenerators :
    Set (representedSerreAlgebra (ZMod 2)) :=
  Set.range (fun i : {i : Fin 4 // ¬ F4.IsLongSimpleRoot i} => representedE (ZMod 2) i) ∪
    Set.range (fun i : {i : Fin 4 // ¬ F4.IsLongSimpleRoot i} => representedF (ZMod 2) i)

/-- The ideal of the represented Serre algebra generated by the positive and negative short
simple root matrices in characteristic two. The short simple coroots are already forced into it
by the Lie bracket. This is an ideal in the generated image, not in the full reduced Chevalley
lattice used for the special isogeny. -/
noncomputable def representedSerreShortRootIdeal : LieIdeal (ZMod 2) (representedSerreAlgebra
  (ZMod 2)) :=
  LieSubmodule.lieSpan (ZMod 2) (representedSerreAlgebra (ZMod 2))
    shortSimpleRootGenerators

/-- The universal property of the short-root ideal. -/
theorem representedSerreShortRootIdeal_le_iff (I : LieIdeal (ZMod 2) (representedSerreAlgebra
  (ZMod 2))) :
    representedSerreShortRootIdeal ≤ I ↔
      (∀ i, ¬ F4.IsLongSimpleRoot i → representedE (ZMod 2) i ∈ I) ∧
        ∀ i, ¬ F4.IsLongSimpleRoot i → representedF (ZMod 2) i ∈ I := by
  constructor
  · intro h
    rw [representedSerreShortRootIdeal, LieSubmodule.lieSpan_le] at h
    constructor
    · intro i hi
      apply h
      exact Or.inl ⟨⟨i, hi⟩, rfl⟩
    · intro i hi
      apply h
      exact Or.inr ⟨⟨i, hi⟩, rfl⟩
  · rintro ⟨hE, hF⟩
    rw [representedSerreShortRootIdeal, LieSubmodule.lieSpan_le]
    rintro _ (⟨i, rfl⟩ | ⟨i, rfl⟩)
    · exact hE i.1 i.2
    · exact hF i.1 i.2

/-- A represented raising matrix at a short simple root belongs to the short-root ideal. -/
theorem representedE_mem_representedSerreShortRootIdeal (i : Fin 4) (hi : ¬ F4.IsLongSimpleRoot i) :
    representedE (ZMod 2) i ∈ representedSerreShortRootIdeal := by
  apply LieSubmodule.subset_lieSpan
  exact Or.inl ⟨⟨i, hi⟩, rfl⟩

/-- A represented lowering matrix at a short simple root belongs to the short-root ideal. -/
theorem representedF_mem_representedSerreShortRootIdeal (i : Fin 4) (hi : ¬ F4.IsLongSimpleRoot i) :
    representedF (ZMod 2) i ∈ representedSerreShortRootIdeal := by
  apply LieSubmodule.subset_lieSpan
  exact Or.inr ⟨⟨i, hi⟩, rfl⟩

/-- The represented coroot at a short simple root belongs to the short-root ideal. -/
theorem representedH_mem_representedSerreShortRootIdeal (i : Fin 4) (hi : ¬ F4.IsLongSimpleRoot i) :
    representedH (ZMod 2) i ∈ representedSerreShortRootIdeal := by
  rw [← lie_representedE_representedF_self]
  exact lie_mem_right (R := ZMod 2) (L := representedSerreAlgebra (ZMod 2))
    representedSerreShortRootIdeal
    (representedE (ZMod 2) i)
    (representedF (ZMod 2) i) (representedF_mem_representedSerreShortRootIdeal i hi)

/-- The short-root ideal is nonzero: it contains the nonzero raising matrix at short node `2`. -/
theorem representedSerreShortRootIdeal_ne_bot : representedSerreShortRootIdeal ≠ ⊥ := by
  intro hbot
  have hmem := representedE_mem_representedSerreShortRootIdeal (i := 2) (by
    simp [DynkinType.isLongSimpleRoot_F4])
  rw [hbot] at hmem
  have hzero : representedE (ZMod 2) 2 = 0 := by simpa using hmem
  have hentry := congrArg
    (fun x : representedSerreAlgebra (ZMod 2) =>
      (x : Matrix (Fin 26) (Fin 26) (ZMod 2)) 1 2) hzero
  have hmatrix : raisingMatrix 2 1 2 = 1 := by
    rw [raisingMatrix_apply]
    decide +kernel
  rw [coe_representedE, raisingMatrixBaseChange_apply, hmatrix] at hentry
  norm_num at hentry

end TauCeti.F4ShortRoot
