module

public import Mathlib.Algebra.Lie.Semisimple.Defs

/-!
# Modules over a Lie subalgebra which is the whole algebra

A Lie subalgebra `L₁` of `L` acts on every `L`-module by restriction along the inclusion. When
`L₁ = ⊤` that restriction loses nothing, because every element of `L` is the underlying element of
one of `L₁`: the two actions have the same invariant subspaces, hence the same irreducibility, and
a map intertwining the one intertwines the other.

Mathlib has `LieSubalgebra.topEquiv`, the equivalence `(⊤ : LieSubalgebra R L) ≃ₗ⁅R⁆ L` of Lie
algebras. That equivalence does not by itself move module-level statements, because a module over
`L₁` is not the transport of a module over `L` along it but the same module with a restricted
action; the declarations below say what that restriction does to submodules, to irreducibility,
and to equivalences.

The intended use is a Lie algebra presented as generated by a distinguished family, where a
hypothesis is naturally stated over the subalgebra that family generates and the conclusion is
wanted over the whole algebra. `TauCeti/Algebra/Lie/Sl2/WeightString.lean` classifies modules
irreducible over the subalgebra generated by an `sl₂` triple, and
`TauCeti/Algebra/Lie/Sl2/Classification.lean` converts that into a statement about
`LieAlgebra.SpecialLinear.sl (Fin 2) K`-modules, the standard triple generating all of
`sl (Fin 2) K`.

## Main definitions

* `TauCeti.lieSubmoduleOrderIsoOfEqTop`: the submodules for a Lie subalgebra which is everything
  are those for the whole Lie algebra, as an order isomorphism inverse to `LieSubmodule.restr`.
* `TauCeti.lieModuleEquivOfEqTop`: an equivalence of modules over a Lie subalgebra which is
  everything, read as an equivalence of modules over the whole Lie algebra.

## Main results

* `TauCeti.isIrreducible_iff_of_eq_top`: a module is irreducible over a Lie subalgebra which is
  the whole algebra exactly when it is irreducible over the whole algebra.

## Implementation notes

Neither definition is exposed: each is a repackaging that changes no data, and the equations
`TauCeti.mem_lieSubmoduleOrderIsoOfEqTop_apply`,
`TauCeti.lieSubmoduleOrderIsoOfEqTop_apply_toSubmodule`,
`TauCeti.lieSubmoduleOrderIsoOfEqTop_symm_apply` and `TauCeti.lieModuleEquivOfEqTop_apply`
recording that are the whole elimination API, so nothing downstream needs to unfold further.
Those equations are proved by a parenthesised `(rfl)` or `(Iff.rfl)`, which elaborates against the
definitions themselves; a bare `rfl` in an exported theorem would demand that they be `@[expose]`d.
-/

public section

namespace TauCeti

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
variable {M : Type*} [AddCommGroup M] [Module R M] [LieRingModule L M]
variable {N : Type*} [AddCommGroup N] [Module R N] [LieRingModule L N]
variable {L₁ : LieSubalgebra R L}

/-- **The submodules for a Lie subalgebra which is everything are those for the whole algebra.** A
submodule for `L₁` is read as one for `L`, an element of `L` acting as the element of `L₁` it
underlies, and `LieSubmodule.restr` reads it back. -/
def lieSubmoduleOrderIsoOfEqTop (hL₁ : L₁ = ⊤) : LieSubmodule R L₁ M ≃o LieSubmodule R L M where
  toFun P :=
    { P.toSubmodule with
      lie_mem {x _} hm := P.lie_mem (x := ⟨x, hL₁ ▸ LieSubalgebra.mem_top x⟩) hm }
  invFun Q := Q.restr L₁
  left_inv _ := rfl
  right_inv _ := rfl
  map_rel_iff' := Iff.rfl

@[simp]
theorem mem_lieSubmoduleOrderIsoOfEqTop_apply {hL₁ : L₁ = ⊤} {P : LieSubmodule R L₁ M} {m : M} :
    m ∈ lieSubmoduleOrderIsoOfEqTop hL₁ P ↔ m ∈ P :=
  (Iff.rfl)

@[simp]
theorem lieSubmoduleOrderIsoOfEqTop_apply_toSubmodule (hL₁ : L₁ = ⊤) (P : LieSubmodule R L₁ M) :
    (lieSubmoduleOrderIsoOfEqTop hL₁ P).toSubmodule = P.toSubmodule :=
  (rfl)

@[simp]
theorem lieSubmoduleOrderIsoOfEqTop_symm_apply (hL₁ : L₁ = ⊤) (Q : LieSubmodule R L M) :
    (lieSubmoduleOrderIsoOfEqTop hL₁).symm Q = Q.restr L₁ :=
  (rfl)

/-- **Irreducibility over a Lie subalgebra which is everything is irreducibility over the whole
algebra.** The two lattices of submodules are isomorphic, so the one is simple exactly when the
other is. -/
theorem isIrreducible_iff_of_eq_top (hL₁ : L₁ = ⊤) :
    LieModule.IsIrreducible R L₁ M ↔ LieModule.IsIrreducible R L M :=
  (lieSubmoduleOrderIsoOfEqTop hL₁).isSimpleOrder_iff

/-- **An equivalence over a Lie subalgebra which is everything is an equivalence over the whole
algebra.** A linear equivalence intertwining the action of every element of `L₁` intertwines the
action of every element of `L`, each of which underlies one of `L₁`. -/
def lieModuleEquivOfEqTop (hL₁ : L₁ = ⊤) (φ : M ≃ₗ⁅R,L₁⁆ N) : M ≃ₗ⁅R,L⁆ N :=
  { φ.toLinearEquiv with
    map_lie' {x m} := by simpa using φ.map_lie ⟨x, hL₁ ▸ LieSubalgebra.mem_top x⟩ m }

@[simp]
theorem lieModuleEquivOfEqTop_apply (hL₁ : L₁ = ⊤) (φ : M ≃ₗ⁅R,L₁⁆ N) (m : M) :
    lieModuleEquivOfEqTop hL₁ φ m = φ m :=
  (rfl)

end TauCeti
