module

public import Mathlib.Algebra.Lie.Submodule
public import Mathlib.LinearAlgebra.LinearIndependent.Defs
import TauCeti.LinearAlgebra.LinearIndependent.NonnegCombination

/-!
# Adjoint operators on a generated Lie subalgebra

An adjoint operator `ad x` is a derivation, so whether it carries the Lie subalgebra `S` generated
by a set `s` into a given subspace can be decided on the generators alone, provided that subspace
is compatible with the bracket. The form proved here allows a correction term: if `U` is a
submodule whose bracket with `S` lands in `S`, and `ad x` carries every element of `s` into
`S + U`, then it carries all of `S` into `S + U`. By the Leibniz rule
`⁅x, ⁅y, z⁆⁆ = ⁅⁅x, y⁆, z⁆ + ⁅y, ⁅x, z⁆⁆`, each of the two terms is a bracket of an element of
`S + U` with an element of `S`, which lies in `S`.

This is the step behind the triangular decomposition of a Lie algebra presented by Serre's
relations: there `S` is generated by the lowering generators, `U` is spanned by the Cartan
generators, and `x` is a raising generator, which carries each lowering generator into `U`.

The same induction over the generated Lie subalgebra shows that a submodule of a Lie module
stable under the action of a generating set of `L` is stable under all of `L`, and so, when it
contains a set `t`, it contains the Lie submodule generated by `t`.

The same Leibniz-rule argument describes the generated Lie subalgebra as a submodule. For a
family `f : ι → L`, the **right-normed brackets** `⁅f w₀, ⁅f w₁, … ⁅f wₙ₋₁, f i⁆…⁆⁆`
(`TauCeti.rightNormedBracket`) span the Lie subalgebra generated by the range of `f`: their span
is stable under `ad (f j)`, which prepends the letter `j`, hence by the Jacobi identity under the
bracket with every right-normed bracket, and so it is a Lie subalgebra. A right-normed bracket all
of whose letters are equal vanishes as soon as it has two letters, since its innermost bracket is
`⁅f i, f i⁆ = 0`.

This is the step behind the description of the positive part of a Lie algebra presented by
Serre's relations and of Kac–Moody root spaces by their bracket words.

## Main definitions

* `TauCeti.rightNormedBracket`: the right-normed bracket of a family along a word.

## Main results

* `LieSubalgebra.lie_mem_sup_of_mem_lieSpan`: if `ad x` carries the generators of `S` into
  `S + U`, it carries `S` into `S + U`.
* `LieSubalgebra.lie_mem_of_mem_lieSpan`: if `ad x` carries the generators of `S` into `S`, it
  carries `S` into `S`.
* `LieSubalgebra.lieSpan_toSubmodule_le_of_lie_mem`: if a submodule contains `s` and is stable
  under `ad g` for every `g ∈ s`, it contains `lieSpan R L s`.
* `LieSubalgebra.lie_mem_of_lieSpan_eq_top`: a submodule of a Lie module stable under a generating
  set of `L` is stable under all of `L`.
* `LieSubmodule.lieSpan_toSubmodule_le_of_lie_mem`: a submodule of a Lie module that contains `t`
  and is stable under `L` contains the Lie submodule generated by `t`.
* `LieSubalgebra.coe_lieSpan_eq_span_of_forall_lie_mem_span`: if the brackets of elements of `s`
  lie in the linear span of `s`, the Lie subalgebra generated by `s` is that span.
* `LieSubalgebra.map_lieSpan_range_of_surjective`: a homomorphism carrying a family onto a
  surjective reindexing of another maps the generated Lie subalgebras onto each other.
* `LieHom.map_rightNormedBracket`: a Lie homomorphism commutes with right-normed brackets.
* `TauCeti.rightNormedBracket_smul` and `TauCeti.rightNormedBracket_neg`: scaling or negating the
  generator family multiplies a right-normed bracket by the corresponding power.
* `TauCeti.rightNormedBracket_mem_of_bracket_mem`: if brackets add weights across a family `ℒ`, a
  right-normed bracket lies in the piece indexed by the sum of its letters' weights.
* `TauCeti.rightNormedBracket_eq_zero_of_forall_mem_eq`: a right-normed bracket of at least two
  equal letters vanishes.
* `TauCeti.image_rightNormedBracket_sum_map_eq_self`,
  `TauCeti.rightNormedBracket_eq_zero_of_sum_map_eq_nsmul`, and
  `TauCeti.span_rightNormedBracket_sum_map_eq_nsmul`: for linearly independent weights in
  characteristic zero, the bracket words of weight `wt i` are `{f i}` and those of weight
  `m • wt i` vanish for `m ≥ 2`.
* `LieSubalgebra.coe_lieSpan_range_eq_span_rightNormedBracket`: the Lie subalgebra generated by the
  range of a family is the span of its right-normed brackets.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 1--3*, Chapter II, §2, for iterated
  brackets in free Lie algebras.
-/

public section

namespace LieSubalgebra

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] {s : Set L} {x y : L}

/-- Let `U` be a submodule whose bracket with the Lie subalgebra `S` generated by `s` lies in `S`.
If `ad x` carries every element of `s` into `S + U`, then it carries every element of `S` into
`S + U`. -/
theorem lie_mem_sup_of_mem_lieSpan {U : Submodule R L}
    (hU : ∀ u ∈ U, ∀ z ∈ lieSpan R L s, ⁅u, z⁆ ∈ lieSpan R L s)
    (hx : ∀ z ∈ s, ⁅x, z⁆ ∈ (lieSpan R L s).toSubmodule ⊔ U) (hy : y ∈ lieSpan R L s) :
    ⁅x, y⁆ ∈ (lieSpan R L s).toSubmodule ⊔ U := by
  -- The bracket of an element of `S + U` with an element of `S` lies in `S`.
  have hl : ∀ a ∈ (lieSpan R L s).toSubmodule ⊔ U, ∀ z ∈ lieSpan R L s,
      ⁅a, z⁆ ∈ lieSpan R L s := by
    intro a ha z hz
    obtain ⟨b, hb, u, hu, rfl⟩ := Submodule.mem_sup.1 ha
    rw [add_lie]
    exact add_mem (lie_mem _ hb hz) (hU u hu z hz)
  induction hy using lieSpan_induction with
  | mem z hz => exact hx z hz
  | zero => simp
  | add y z _ _ hy hz =>
    rw [lie_add]
    exact add_mem hy hz
  | smul a y _ hy =>
    rw [lie_smul]
    exact Submodule.smul_mem _ a hy
  | lie y z hy' hz' hy hz =>
    rw [leibniz_lie, ← lie_skew y, ← sub_eq_add_neg]
    exact Submodule.mem_sup_left (sub_mem (hl _ hy z hz') (hl _ hz y hy'))

/-- If `ad x` carries every element of `s` into the Lie subalgebra `S` generated by `s`, then it
carries `S` into itself. -/
theorem lie_mem_of_mem_lieSpan (hx : ∀ z ∈ s, ⁅x, z⁆ ∈ lieSpan R L s)
    (hy : y ∈ lieSpan R L s) : ⁅x, y⁆ ∈ lieSpan R L s := by
  have h := lie_mem_sup_of_mem_lieSpan (U := ⊥) (by simp)
    (fun z hz => Submodule.mem_sup_left (hx z hz)) hy
  rwa [sup_bot_eq] at h

/-- If a submodule `M` contains `s` and is stable under `ad g` for every `g ∈ s`, then `M`
contains the Lie subalgebra generated by `s`. -/
theorem lieSpan_toSubmodule_le_of_lie_mem {M : Submodule R L} (hs : s ⊆ M)
    (hlie : ∀ g ∈ s, ∀ y ∈ M, ⁅g, y⁆ ∈ M) :
    (lieSpan R L s).toSubmodule ≤ M := by
  suffices ∀ x ∈ lieSpan R L s, x ∈ M ∧ ∀ z ∈ M, ⁅x, z⁆ ∈ M from fun x hx ↦ (this x hx).1
  intro x hx
  induction hx using lieSpan_induction with
  | mem g hg => exact ⟨hs hg, hlie g hg⟩
  | zero => exact ⟨M.zero_mem, fun _ _ ↦ by simp⟩
  | add _ _ _ _ hx hy =>
    exact ⟨M.add_mem hx.1 hy.1, fun z hz ↦ by
      rw [add_lie]
      exact M.add_mem (hx.2 z hz) (hy.2 z hz)⟩
  | smul a _ _ hx =>
    exact ⟨M.smul_mem a hx.1, fun z hz ↦ by
      rw [smul_lie]
      exact M.smul_mem a (hx.2 z hz)⟩
  | lie x y _ _ hx hy =>
    exact ⟨hx.2 y hy.1, fun z hz ↦ by
      rw [lie_lie]
      exact M.sub_mem (hx.2 _ (hy.2 z hz)) (hy.2 _ (hx.2 z hz))⟩

section Module

variable {M : Type*} [AddCommGroup M] [Module R M] [LieRingModule L M] [LieModule R L M]

/-- **Stability under generators gives stability under the whole Lie algebra.** If `s` generates
`L` as a Lie algebra and a submodule `N` of a Lie module is stable under the action of every element
of `s`, then `N` is stable under the action of every element of `L`. -/
theorem lie_mem_of_lieSpan_eq_top (hs : lieSpan R L s = ⊤) {N : Submodule R M}
    (hN : ∀ g ∈ s, ∀ m ∈ N, ⁅g, m⁆ ∈ N) (x : L) {m : M} (hm : m ∈ N) : ⁅x, m⁆ ∈ N := by
  have hx : x ∈ lieSpan R L s := hs ▸ mem_top x
  induction hx using lieSpan_induction generalizing m with
  | mem g hg => exact hN g hg m hm
  | zero => rw [zero_lie]; exact N.zero_mem
  | add y z _ _ hy hz => rw [add_lie]; exact N.add_mem (hy hm) (hz hm)
  | smul c y _ hy => rw [smul_lie]; exact N.smul_mem c (hy hm)
  | lie y z _ _ hy hz => rw [lie_lie]; exact N.sub_mem (hy (hz hm)) (hz (hy hm))

end Module

/-- **A set whose brackets lie in its span generates its span.** If the bracket of any two
elements of `s` lies in the linear span of `s`, then the Lie subalgebra generated by `s` is that
span. This generalizes Mathlib's `LieSubalgebra.coe_lieSpan_eq_span_of_forall_lie_eq_zero`. -/
theorem coe_lieSpan_eq_span_of_forall_lie_mem_span
    (hs : ∀ x ∈ s, ∀ y ∈ s, ⁅x, y⁆ ∈ Submodule.span R s) :
    lieSpan R L s = Submodule.span R s := by
  refine le_antisymm (lieSpan_toSubmodule_le_of_lie_mem Submodule.subset_span
    fun g hg y hy ↦ ?_) submodule_span_le_lieSpan
  induction hy using Submodule.span_induction with
  | mem y hy => exact hs g hg y hy
  | zero => simp
  | add y z _ _ hy hz =>
    rw [lie_add]
    exact add_mem hy hz
  | smul a y _ hy =>
    rw [lie_smul]
    exact Submodule.smul_mem _ a hy

/-- A Lie algebra homomorphism sending each member of a family `f` to a member of a family `g`,
along a surjective reindexing `σ`, maps the Lie subalgebra generated by the range of `f` onto the
one generated by the range of `g`. -/
theorem map_lieSpan_range_of_surjective {L₂ ι κ : Type*} [LieRing L₂] [LieAlgebra R L₂]
    (e : L →ₗ⁅R⁆ L₂) {f : ι → L} {g : κ → L₂} {σ : ι → κ} (hσ : Function.Surjective σ)
    (h : ∀ i, e (f i) = g (σ i)) :
    (lieSpan R L (Set.range f)).map e = lieSpan R L₂ (Set.range g) := by
  rw [map_lieSpan, ← Set.range_comp, show ⇑e ∘ f = g ∘ σ from funext h, hσ.range_comp]

end LieSubalgebra

namespace LieSubmodule

variable {R L M : Type*} [CommRing R] [LieRing L] [AddCommGroup M] [Module R M]
  [LieRingModule L M]

/-- A submodule of a Lie module that contains `t` and is stable under the action of `L` contains
the Lie submodule generated by `t`. -/
theorem lieSpan_toSubmodule_le_of_lie_mem {t : Set M} {N : Submodule R M} (ht : t ⊆ N)
    (hN : ∀ (x : L), ∀ m ∈ N, ⁅x, m⁆ ∈ N) : (lieSpan R L t).toSubmodule ≤ N := by
  let N' : LieSubmodule R L M := { N with lie_mem := fun {x m} hm => hN x m hm }
  have hle : lieSpan R L t ≤ N' := lieSpan_le.mpr ht
  simpa only [toSubmodule_mk] using (toSubmodule_le_toSubmodule _ _).mpr hle

end LieSubmodule

namespace TauCeti

variable {L ι : Type*} [LieRing L] (f : ι → L)

/-- The **right-normed bracket** of a family `f` along a word: for a letter `i` and a list
`w = [w₀, …, wₙ₋₁]`, the iterated bracket `⁅f w₀, ⁅f w₁, … ⁅f wₙ₋₁, f i⁆…⁆⁆`. The letter `i` is
the innermost one, so the empty list gives `f i`. -/
def rightNormedBracket (i : ι) (w : List ι) : L :=
  w.foldr (fun j x => ⁅f j, x⁆) (f i)

/-- The right-normed bracket along the empty list is the innermost letter. -/
@[simp]
theorem rightNormedBracket_nil (i : ι) : rightNormedBracket f i [] = f i :=
  (rfl)

/-- Prepending a letter `j` to a word brackets its right-normed bracket with `f j`. -/
@[simp]
theorem rightNormedBracket_cons (i j : ι) (w : List ι) :
    rightNormedBracket f i (j :: w) = ⁅f j, rightNormedBracket f i w⁆ :=
  (rfl)

/-- A Lie homomorphism carries a right-normed bracket of `f` to the right-normed bracket of
`φ ∘ f`. -/
theorem _root_.LieHom.map_rightNormedBracket {R L' : Type*} [CommRing R] [LieAlgebra R L]
    [LieRing L'] [LieAlgebra R L'] (φ : L →ₗ⁅R⁆ L') (i : ι) (w : List ι) :
    φ (rightNormedBracket f i w) = rightNormedBracket (φ ∘ f) i w := by
  induction w with
  | nil => rfl
  | cons j w ih => simp [LieHom.map_lie, ih]

/-- Scaling the generating family by `c` scales a right-normed bracket by `c ^ (w.length + 1)`. -/
theorem rightNormedBracket_smul {R : Type*} [CommRing R] [LieAlgebra R L]
    (c : R) (i : ι) (w : List ι) :
    rightNormedBracket (c • f) i w = c ^ (w.length + 1) • rightNormedBracket f i w := by
  induction w with
  | nil => simp
  | cons j w ih =>
    rw [rightNormedBracket_cons, Pi.smul_apply, ih, smul_lie, lie_smul, smul_smul,
      List.length_cons, ← pow_succ', rightNormedBracket_cons]

/-- Negating the generating family multiplies a right-normed bracket by `(-1) ^ (w.length + 1)`. -/
theorem rightNormedBracket_neg (i : ι) (w : List ι) :
    rightNormedBracket (-f) i w = (-1 : ℤ) ^ (w.length + 1) • rightNormedBracket f i w := by
  simpa [neg_one_smul] using rightNormedBracket_smul f (-1 : ℤ) i w

/-- **Weight of a right-normed bracket.** If each letter `f j` lies in `ℒ (wt j)` and the Lie
bracket adds weights across `ℒ`, then `rightNormedBracket f i w` lies in
`ℒ ((i :: w).map wt).sum`. -/
theorem rightNormedBracket_mem_of_bracket_mem {M S : Type*} [AddCommMonoid M] [SetLike S L]
    (ℒ : M → S) (hbr : ∀ {α β x y}, x ∈ ℒ α → y ∈ ℒ β → ⁅x, y⁆ ∈ ℒ (α + β))
    {wt : ι → M} (hf : ∀ j, f j ∈ ℒ (wt j)) (i : ι) (w : List ι) :
    rightNormedBracket f i w ∈ ℒ ((i :: w).map wt).sum := by
  induction w with
  | nil => simpa using hf i
  | cons j w ih =>
    have hsum : ((i :: j :: w).map wt).sum = wt j + ((i :: w).map wt).sum := by
      simp only [List.map_cons, List.sum_cons]
      rw [add_left_comm]
    rw [rightNormedBracket_cons, hsum]
    exact hbr (hf j) ih

/-- **A right-normed bracket of at least two equal letters vanishes**: its innermost bracket is
`⁅f i, f i⁆ = 0`. -/
theorem rightNormedBracket_eq_zero_of_forall_mem_eq {i : ι} {w : List ι} (hw : w ≠ [])
    (hi : ∀ j ∈ w, j = i) : rightNormedBracket f i w = 0 := by
  induction w with
  | nil => exact absurd rfl hw
  | cons j w ih =>
    rw [rightNormedBracket_cons, hi j List.mem_cons_self]
    rcases eq_or_ne w [] with rfl | hw'
    · simp
    · rw [ih hw' fun k hk => hi k (List.mem_cons_of_mem j hk), lie_zero]

/-- For a weight family `wt` linearly independent over a characteristic-zero semiring, the only
right-normed bracket of weight `wt i` is `f i`. -/
theorem image_rightNormedBracket_sum_map_eq_self {R M : Type*} [Semiring R] [CharZero R]
    [AddCommMonoid M] [Module R M] {wt : ι → M} (hwt : LinearIndependent R wt) (i : ι) :
    (fun p : ι × List ι => rightNormedBracket f p.1 p.2) ''
      {p | ((p.1 :: p.2).map wt).sum = wt i} = {f i} := by
  ext x
  simp only [Set.mem_image, Set.mem_ofPred_eq, Prod.exists, Set.mem_singleton_iff]
  refine ⟨?_, fun hx => ⟨i, [], by simp, by simp [hx]⟩⟩
  rintro ⟨j, w, hw, rfl⟩
  have hrep : j :: w = List.replicate 1 i :=
    hwt.eq_replicate_of_sum_map_eq_nsmul (by rwa [one_nsmul])
  rw [List.replicate_one, List.cons.injEq] at hrep
  rw [hrep.1, hrep.2, rightNormedBracket_nil]

/-- For a weight family `wt` linearly independent over a characteristic-zero semiring, every
right-normed bracket of weight `m • wt i` with `m ≥ 2` vanishes. -/
theorem rightNormedBracket_eq_zero_of_sum_map_eq_nsmul {R M : Type*} [Semiring R] [CharZero R]
    [AddCommMonoid M] [Module R M] {wt : ι → M} (hwt : LinearIndependent R wt)
    {i j : ι} {w : List ι} {m : ℕ} (hm : 2 ≤ m)
    (hw : ((j :: w).map wt).sum = m • wt i) :
    rightNormedBracket f j w = 0 := by
  have hrep : j :: w = List.replicate m i := hwt.eq_replicate_of_sum_map_eq_nsmul hw
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le' hm
  rw [List.replicate_succ, List.cons.injEq] at hrep
  rw [hrep.1, hrep.2]
  exact rightNormedBracket_eq_zero_of_forall_mem_eq f (by simp)
    fun l hl => List.eq_of_mem_replicate hl

/-- For a weight family `wt` linearly independent over a characteristic-zero semiring, the
submodule spanned by right-normed brackets of weight `m • wt i` vanishes for every `m ≥ 2`. -/
theorem span_rightNormedBracket_sum_map_eq_nsmul {K R M : Type*} [Semiring K] [Semiring R]
    [CharZero R] [AddCommMonoid M] [Module R M] [Module K L] {wt : ι → M}
    (hwt : LinearIndependent R wt) (i : ι) {m : ℕ} (hm : 2 ≤ m) :
    Submodule.span K ((fun p : ι × List ι => rightNormedBracket f p.1 p.2) ''
      {p | ((p.1 :: p.2).map wt).sum = m • wt i}) = ⊥ := by
  rw [Submodule.span_eq_bot]
  rintro _ ⟨⟨j, w⟩, hw, rfl⟩
  exact rightNormedBracket_eq_zero_of_sum_map_eq_nsmul f hwt hm hw

end TauCeti

namespace LieSubalgebra

open TauCeti

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] (f : ι → L)

/-- A right-normed bracket of a family lies in the Lie subalgebra generated by its range. -/
theorem rightNormedBracket_mem_lieSpan (i : ι) (w : List ι) :
    rightNormedBracket f i w ∈ lieSpan R L (Set.range f) := by
  induction w with
  | nil => exact subset_lieSpan (Set.mem_range_self i)
  | cons j w ih =>
    rw [rightNormedBracket_cons]
    exact lie_mem _ (subset_lieSpan (Set.mem_range_self j)) ih

/-- **The generated Lie subalgebra is spanned by right-normed brackets.** The Lie subalgebra
generated by the range of a family `f` is, as a submodule, the span of the right-normed brackets
`⁅f w₀, ⁅f w₁, … ⁅f wₙ₋₁, f i⁆…⁆⁆` of `f`. -/
theorem coe_lieSpan_range_eq_span_rightNormedBracket :
    (lieSpan R L (Set.range f) : Submodule R L) =
      Submodule.span R (Set.range fun p : ι × List ι => rightNormedBracket f p.1 p.2) := by
  set W := Submodule.span R (Set.range fun p : ι × List ι => rightNormedBracket f p.1 p.2)
  -- The bracket with a letter prepends it, so it preserves `W`.
  have hf : ∀ j, ∀ x ∈ W, ⁅f j, x⁆ ∈ W := by
    intro j x hx
    induction hx using Submodule.span_induction with
    | mem _ hx =>
      obtain ⟨⟨i, w⟩, rfl⟩ := hx
      exact Submodule.subset_span ⟨(i, j :: w), rfl⟩
    | zero => simp
    | add _ _ _ _ hx hy =>
      rw [lie_add]
      exact add_mem hx hy
    | smul a _ _ hx =>
      rw [lie_smul]
      exact W.smul_mem a hx
  -- By the Jacobi identity, so does the bracket with every right-normed bracket.
  have hword : ∀ i w, ∀ x ∈ W, ⁅rightNormedBracket f i w, x⁆ ∈ W := by
    intro i w
    induction w with
    | nil => exact hf i
    | cons j w ih =>
      intro x hx
      rw [rightNormedBracket_cons, lie_lie]
      exact sub_mem (hf j _ (ih x hx)) (ih _ (hf j x hx))
  -- Hence `W` is closed under the bracket.
  have hall : ∀ y ∈ W, ∀ x ∈ W, ⁅y, x⁆ ∈ W := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem _ hy =>
      obtain ⟨⟨i, w⟩, rfl⟩ := hy
      exact hword i w
    | zero => simp
    | add _ _ _ _ hy hz =>
      intro x hx
      rw [add_lie]
      exact add_mem (hy x hx) (hz x hx)
    | smul a _ _ hy =>
      intro x hx
      rw [smul_lie]
      exact W.smul_mem a (hy x hx)
  let W' : LieSubalgebra R L := { W with lie_mem' := fun {y _} hy hx => hall y hy _ hx }
  have hle : lieSpan R L (Set.range f) ≤ W' := by
    rw [lieSpan_le]
    rintro _ ⟨i, rfl⟩
    exact Submodule.subset_span ⟨(i, []), rfl⟩
  refine le_antisymm (fun x hx => hle hx) ?_
  rw [Submodule.span_le]
  rintro _ ⟨⟨i, w⟩, rfl⟩
  exact rightNormedBracket_mem_lieSpan f i w

end LieSubalgebra
