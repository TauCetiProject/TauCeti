module

public import Mathlib.Algebra.Lie.Subalgebra

/-!
# Adjoint operators on a generated Lie subalgebra

An adjoint operator `ad x` is a derivation, so whether it carries the Lie subalgebra `S` generated
by a set `s` into a given subspace can be decided on the generators alone, provided that subspace
is compatible with the bracket. The form proved here allows a correction term: if `U` is a
submodule whose bracket with `S` lands in `S`, and `ad x` carries every element of `s` into
`S + U`, then it carries all of `S` into `S + U`. By the Leibniz rule
`⁅x, ⁅y, z⁆⁆ = ⁅⁅x, y⁆, z⁆ + ⁅y, ⁅x, z⁆⁆`, each of the two terms is a bracket of an element of
`S + U` with an element of `S`, which lies in `S`.

This is the step behind the triangular decomposition of a Lie algebra presented by Serre's
relations: there `S` is generated by the lowering generators, `U` is spanned by the Cartan
generators, and `x` is a raising generator, which carries each lowering generator into `U`.

## Main results

* `LieSubalgebra.lie_mem_sup_of_mem_lieSpan`: if `ad x` carries the generators of `S` into
  `S + U`, it carries `S` into `S + U`.
* `LieSubalgebra.lie_mem_of_mem_lieSpan`: if `ad x` carries the generators of `S` into `S`, it
  carries `S` into `S`.
-/

public section

namespace LieSubalgebra

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] {s : Set L} {x y : L}

/-- Let `U` be a submodule whose bracket with the Lie subalgebra `S` generated by `s` lies in `S`.
If `ad x` carries every element of `s` into `S + U`, then it carries every element of `S` into
`S + U`. -/
theorem lie_mem_sup_of_mem_lieSpan {U : Submodule R L}
    (hU : ∀ u ∈ U, ∀ z ∈ lieSpan R L s, ⁅u, z⁆ ∈ lieSpan R L s)
    (hx : ∀ z ∈ s, ⁅x, z⁆ ∈ (lieSpan R L s).toSubmodule ⊔ U) (hy : y ∈ lieSpan R L s) :
    ⁅x, y⁆ ∈ (lieSpan R L s).toSubmodule ⊔ U := by
  -- The bracket of an element of `S + U` with an element of `S` lies in `S`.
  have hl : ∀ a ∈ (lieSpan R L s).toSubmodule ⊔ U, ∀ z ∈ lieSpan R L s,
      ⁅a, z⁆ ∈ lieSpan R L s := by
    intro a ha z hz
    obtain ⟨b, hb, u, hu, rfl⟩ := Submodule.mem_sup.1 ha
    rw [add_lie]
    exact add_mem (lie_mem _ hb hz) (hU u hu z hz)
  induction hy using lieSpan_induction with
  | mem z hz => exact hx z hz
  | zero => simp
  | add y z _ _ hy hz =>
    rw [lie_add]
    exact add_mem hy hz
  | smul a y _ hy =>
    rw [lie_smul]
    exact Submodule.smul_mem _ a hy
  | lie y z hy' hz' hy hz =>
    rw [leibniz_lie, ← lie_skew y, ← sub_eq_add_neg]
    exact Submodule.mem_sup_left (sub_mem (hl _ hy z hz') (hl _ hz y hy'))

/-- If `ad x` carries every element of `s` into the Lie subalgebra `S` generated by `s`, then it
carries `S` into itself. -/
theorem lie_mem_of_mem_lieSpan (hx : ∀ z ∈ s, ⁅x, z⁆ ∈ lieSpan R L s)
    (hy : y ∈ lieSpan R L s) : ⁅x, y⁆ ∈ lieSpan R L s := by
  have h := lie_mem_sup_of_mem_lieSpan (U := ⊥) (by simp)
    (fun z hz => Submodule.mem_sup_left (hx z hz)) hy
  rwa [sup_bot_eq] at h

end LieSubalgebra
