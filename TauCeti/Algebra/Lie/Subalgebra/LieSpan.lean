module

public import Mathlib.Algebra.Lie.Subalgebra

/-!
# Adjoint operators on a generated Lie subalgebra

An adjoint operator `ad x` is a derivation, so whether it carries the Lie subalgebra `S` generated
by a set `s` into a given subspace can be decided on the generators alone, provided that subspace
is compatible with the bracket. The form proved here allows a correction term: if `U` is a
submodule whose bracket with `S` lands in `S`, and `ad x` carries every element of `s` into
`S + U`, then it carries all of `S` into `S + U`. By the Leibniz rule
`⁅x, ⁅y, z⁆⁆ = ⁅⁅x, y⁆, z⁆ + ⁅y, ⁅x, z⁆⁆`, each of the two terms is a bracket of an element of
`S + U` with an element of `S`, which lies in `S`.

This is the step behind the triangular decomposition of a Lie algebra presented by Serre's
relations: there `S` is generated by the lowering generators, `U` is spanned by the Cartan
generators, and `x` is a raising generator, which carries each lowering generator into `U`.

The same Leibniz-rule argument describes the generated Lie subalgebra as a submodule. For a
family `f : ι → L`, the **right-normed brackets** `⁅f w₀, ⁅f w₁, … ⁅f wₙ₋₁, f i⁆…⁆⁆`
(`TauCeti.rightNormedBracket`) span the Lie subalgebra generated by the range of `f`: their span
is stable under `ad (f j)`, which prepends the letter `j`, hence by the Jacobi identity under the
bracket with every right-normed bracket, and so it is a Lie subalgebra. A right-normed bracket all
of whose letters are equal vanishes as soon as it has two letters, since its innermost bracket is
`⁅f i, f i⁆ = 0`.

This is the step behind the description of the positive part of a Lie algebra presented by
Serre's relations by its bracket words.

## Main definitions

* `TauCeti.rightNormedBracket`: the right-normed bracket of a family along a word.

## Main results

* `LieSubalgebra.lie_mem_sup_of_mem_lieSpan`: if `ad x` carries the generators of `S` into
  `S + U`, it carries `S` into `S + U`.
* `LieSubalgebra.lie_mem_of_mem_lieSpan`: if `ad x` carries the generators of `S` into `S`, it
  carries `S` into `S`.
* `LieSubalgebra.coe_lieSpan_range_eq_span_rightNormedBracket`: the Lie subalgebra generated by the
  range of a family is the span of its right-normed brackets.
* `TauCeti.rightNormedBracket_eq_zero_of_forall_mem_eq`: a right-normed bracket of at least two
  equal letters vanishes.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 1--3*, Chapter II, §2, for iterated
  brackets in free Lie algebras.
-/

public section

namespace LieSubalgebra

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] {s : Set L} {x y : L}

/-- Let `U` be a submodule whose bracket with the Lie subalgebra `S` generated by `s` lies in `S`.
If `ad x` carries every element of `s` into `S + U`, then it carries every element of `S` into
`S + U`. -/
theorem lie_mem_sup_of_mem_lieSpan {U : Submodule R L}
    (hU : ∀ u ∈ U, ∀ z ∈ lieSpan R L s, ⁅u, z⁆ ∈ lieSpan R L s)
    (hx : ∀ z ∈ s, ⁅x, z⁆ ∈ (lieSpan R L s).toSubmodule ⊔ U) (hy : y ∈ lieSpan R L s) :
    ⁅x, y⁆ ∈ (lieSpan R L s).toSubmodule ⊔ U := by
  -- The bracket of an element of `S + U` with an element of `S` lies in `S`.
  have hl : ∀ a ∈ (lieSpan R L s).toSubmodule ⊔ U, ∀ z ∈ lieSpan R L s,
      ⁅a, z⁆ ∈ lieSpan R L s := by
    intro a ha z hz
    obtain ⟨b, hb, u, hu, rfl⟩ := Submodule.mem_sup.1 ha
    rw [add_lie]
    exact add_mem (lie_mem _ hb hz) (hU u hu z hz)
  induction hy using lieSpan_induction with
  | mem z hz => exact hx z hz
  | zero => simp
  | add y z _ _ hy hz =>
    rw [lie_add]
    exact add_mem hy hz
  | smul a y _ hy =>
    rw [lie_smul]
    exact Submodule.smul_mem _ a hy
  | lie y z hy' hz' hy hz =>
    rw [leibniz_lie, ← lie_skew y, ← sub_eq_add_neg]
    exact Submodule.mem_sup_left (sub_mem (hl _ hy z hz') (hl _ hz y hy'))

/-- If `ad x` carries every element of `s` into the Lie subalgebra `S` generated by `s`, then it
carries `S` into itself. -/
theorem lie_mem_of_mem_lieSpan (hx : ∀ z ∈ s, ⁅x, z⁆ ∈ lieSpan R L s)
    (hy : y ∈ lieSpan R L s) : ⁅x, y⁆ ∈ lieSpan R L s := by
  have h := lie_mem_sup_of_mem_lieSpan (U := ⊥) (by simp)
    (fun z hz => Submodule.mem_sup_left (hx z hz)) hy
  rwa [sup_bot_eq] at h

end LieSubalgebra

namespace TauCeti

variable {L ι : Type*} [LieRing L] (f : ι → L)

/-- The **right-normed bracket** of a family `f` along a word: for a letter `i` and a list
`w = [w₀, …, wₙ₋₁]`, the iterated bracket `⁅f w₀, ⁅f w₁, … ⁅f wₙ₋₁, f i⁆…⁆⁆`. The letter `i` is
the innermost one, so the empty list gives `f i`. -/
def rightNormedBracket (i : ι) (w : List ι) : L :=
  w.foldr (fun j x => ⁅f j, x⁆) (f i)

/-- The right-normed bracket along the empty list is the innermost letter. -/
@[simp]
theorem rightNormedBracket_nil (i : ι) : rightNormedBracket f i [] = f i :=
  (rfl)

/-- Prepending a letter `j` to a word brackets its right-normed bracket with `f j`. -/
@[simp]
theorem rightNormedBracket_cons (i j : ι) (w : List ι) :
    rightNormedBracket f i (j :: w) = ⁅f j, rightNormedBracket f i w⁆ :=
  (rfl)

/-- **A right-normed bracket of at least two equal letters vanishes**: its innermost bracket is
`⁅f i, f i⁆ = 0`. -/
theorem rightNormedBracket_eq_zero_of_forall_mem_eq {i : ι} {w : List ι} (hw : w ≠ [])
    (hi : ∀ j ∈ w, j = i) : rightNormedBracket f i w = 0 := by
  induction w with
  | nil => exact absurd rfl hw
  | cons j w ih =>
    rw [rightNormedBracket_cons, hi j List.mem_cons_self]
    rcases eq_or_ne w [] with rfl | hw'
    · simp
    · rw [ih hw' fun k hk => hi k (List.mem_cons_of_mem j hk), lie_zero]

end TauCeti

namespace LieSubalgebra

open TauCeti

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] (f : ι → L)

/-- A right-normed bracket of a family lies in the Lie subalgebra generated by its range. -/
theorem rightNormedBracket_mem_lieSpan (i : ι) (w : List ι) :
    rightNormedBracket f i w ∈ lieSpan R L (Set.range f) := by
  induction w with
  | nil => exact subset_lieSpan (Set.mem_range_self i)
  | cons j w ih =>
    rw [rightNormedBracket_cons]
    exact lie_mem _ (subset_lieSpan (Set.mem_range_self j)) ih

/-- **The generated Lie subalgebra is spanned by right-normed brackets.** The Lie subalgebra
generated by the range of a family `f` is, as a submodule, the span of the right-normed brackets
`⁅f w₀, ⁅f w₁, … ⁅f wₙ₋₁, f i⁆…⁆⁆` of `f`. -/
theorem coe_lieSpan_range_eq_span_rightNormedBracket :
    (lieSpan R L (Set.range f) : Submodule R L) =
      Submodule.span R (Set.range fun p : ι × List ι => rightNormedBracket f p.1 p.2) := by
  set W := Submodule.span R (Set.range fun p : ι × List ι => rightNormedBracket f p.1 p.2)
  -- The bracket with a letter prepends it, so it preserves `W`.
  have hf : ∀ j, ∀ x ∈ W, ⁅f j, x⁆ ∈ W := by
    intro j x hx
    induction hx using Submodule.span_induction with
    | mem _ hx =>
      obtain ⟨⟨i, w⟩, rfl⟩ := hx
      exact Submodule.subset_span ⟨(i, j :: w), rfl⟩
    | zero => simp
    | add _ _ _ _ hx hy =>
      rw [lie_add]
      exact add_mem hx hy
    | smul a _ _ hx =>
      rw [lie_smul]
      exact W.smul_mem a hx
  -- By the Jacobi identity, so does the bracket with every right-normed bracket.
  have hword : ∀ i w, ∀ x ∈ W, ⁅rightNormedBracket f i w, x⁆ ∈ W := by
    intro i w
    induction w with
    | nil => exact hf i
    | cons j w ih =>
      intro x hx
      rw [rightNormedBracket_cons, lie_lie]
      exact sub_mem (hf j _ (ih x hx)) (ih _ (hf j x hx))
  -- Hence `W` is closed under the bracket.
  have hall : ∀ y ∈ W, ∀ x ∈ W, ⁅y, x⁆ ∈ W := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem _ hy =>
      obtain ⟨⟨i, w⟩, rfl⟩ := hy
      exact hword i w
    | zero => simp
    | add _ _ _ _ hy hz =>
      intro x hx
      rw [add_lie]
      exact add_mem (hy x hx) (hz x hx)
    | smul a _ _ hy =>
      intro x hx
      rw [smul_lie]
      exact W.smul_mem a (hy x hx)
  let W' : LieSubalgebra R L := { W with lie_mem' := fun {y _} hy hx => hall y hy _ hx }
  have hle : lieSpan R L (Set.range f) ≤ W' := by
    rw [lieSpan_le]
    rintro _ ⟨i, rfl⟩
    exact Submodule.subset_span ⟨(i, []), rfl⟩
  refine le_antisymm (fun x hx => hle hx) ?_
  rw [Submodule.span_le]
  rintro _ ⟨⟨i, w⟩, rfl⟩
  exact rightNormedBracket_mem_lieSpan f i w

end LieSubalgebra
