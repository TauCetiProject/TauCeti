/-!
# Reductive Chevalley frames and the Kostant integral form

Given a crystallographic integral root datum `P : RootPairing ι ℤ X Y` equipped with a Chevalley
structure-constant table `c : P.ChevalleyConstants`, extending scalars from `ℤ` to `ℚ` produces
the rational reductive Lie algebra `ℚ ⊗[ℤ] ChevalleyLieAlgebra c`. Unlike the semisimple Killing
setting, its Cartan subalgebra `ℚ ⊗[ℤ] Y` contains the full cocharacter lattice `Y` (including any
central cocharacters annihilated by all roots), and its Killing form may be degenerate.

This file packages the resulting rational realization `RootPairing.ReductiveChevalleyFrame` for an
arbitrary `ℚ`-Lie algebra `L` and `ℤ`-basis `toralBasis : Basis J ℤ Y` of the full cocharacter
lattice, constructs the canonical frame on `ℚ ⊗[ℤ] ChevalleyLieAlgebra c`, connects it to
`TauCeti.UniversalEnvelopingAlgebra.kostantForm`, and proves that the Kostant `ℤ`-form stabilizes
the full integral Chevalley lattice spanned by all root vectors and the full cocharacter basis.

## Main definitions and results

* `RootPairing.isReduced_of_add_self_notMem_range_root`: a finite integral-valued root pairing over
  an integral domain of characteristic zero is reduced as soon as `α + α` is never a root.
* `RootPairing.ChevalleyConstants.isReduced`: the existence of Chevalley structure constants forces
  a finite integral root pairing to be reduced.
* `RootPairing.ReductiveChevalleyFrame`: a concrete rational Lie-algebra realization of an integral
  root datum `P` with a chosen `ℤ`-basis of the full cocharacter module `Y`.
* `RootPairing.ChevalleyLieAlgebra.reductiveChevalleyFrame`: the canonical reductive Chevalley frame
  on `ℚ ⊗[ℤ] ChevalleyLieAlgebra c`.
* `RootPairing.ReductiveChevalleyFrame.map`: transport of a reductive Chevalley frame along a
  `ℚ`-Lie equivalence.
* `RootPairing.ReductiveChevalleyFrame.lieSpan_eq_top`: the root vectors and toral basis vectors
  generate `L` as a `ℚ`-Lie algebra.
* `RootPairing.ReductiveChevalleyFrame.kostantForm` and
  `RootPairing.ReductiveChevalleyFrame.kostantFormBaseChange`: the Kostant `ℤ`-form generated by all
  root divided powers and full-`Y` toral binomials, together with the `ℚ`-algebra isomorphism
  `ℚ ⊗[ℤ] D.kostantForm ≃ₐ[ℚ] UniversalEnvelopingAlgebra ℚ L`.
* `RootPairing.ReductiveChevalleyFrame.integralLieAlgebra` and
  `RootPairing.ReductiveChevalleyFrame.integralBasis`: the full integral Chevalley Lie `ℤ`-lattice
  inside `L` and its `ℤ`-basis indexed by `J ⊕ ι`.
* `RootPairing.ReductiveChevalleyFrame.kostantForm_le_stabilizer` and
  `RootPairing.ReductiveChevalleyFrame.adjointRep`: the Kostant `ℤ`-form stabilizes the full
  integral Chevalley lattice under the adjoint representation, yielding a `ℤ`-algebra action
  `D.kostantForm →ₐ[ℤ] Module.End ℤ D.integralSubmodule`.

## References

* M. Demazure and P. Gabriel, *Groupes algébriques*, Masson, 1970, Exp. XXIII.
* J. C. Jantzen, *Representations of Algebraic Groups*, 2nd ed., Amer. Math. Soc., 2003, II.1.
* R. Steinberg, *Lectures on Chevalley Groups*, Amer. Math. Soc., 2016, §§1–2.
-/

public section

open Set
open scoped TensorProduct

namespace RootPairing

/-! ## Reducedness from absence of double roots -/

section Reduced

private theorem int_mul_eq_four_cases {a b : ℤ} (h : a * b = 4) :
    (a = 2 ∧ b = 2) ∨ (a = -2 ∧ b = -2) ∨ (a = 1 ∧ b = 4) ∨
      (b = 1 ∧ a = 4) ∨ (a = -1 ∧ b = -4) ∨ (b = -1 ∧ a = -4) := by
  have hab : a.natAbs * b.natAbs = 4 := by
    simpa [Int.natAbs_mul] using congrArg Int.natAbs h
  have ha : a.natAbs ≤ 4 := by
    rcases eq_or_ne b.natAbs 0 with hb | hb
    · simp [hb] at hab
    · exact Nat.le_of_dvd (by decide) ⟨b.natAbs, hab.symm⟩
  have ha_range : a = -4 ∨ a = -3 ∨ a = -2 ∨ a = -1 ∨ a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3 ∨ a = 4 := by
    have : (a.natAbs : ℤ) ≤ 4 := Nat.cast_le.mpr ha
    omega
  rcases ha_range with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> omega

/-- **A finite crystallographic root pairing is reduced as soon as `α + α` is never a root.** -/
theorem isReduced_of_add_self_notMem_range_root {ι R M N : Type*} [CommRing R] [CharZero R]
    [IsDomain R] [Finite ι] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsValuedIn ℤ]
    (h2 : ∀ i : ι, P.root i + P.root i ∉ range P.root) :
    P.IsReduced := by
  have : Module.IsReflexive R M := .of_isPerfPair P.toLinearMap
  have : Module.IsReflexive R N := .of_isPerfPair P.toLinearMap.flip
  rw [P.isReduced_iff']
  intro i j hij hdep
  have hcox : P.pairingIn ℤ i j * P.pairingIn ℤ j i = 4 :=
    (P.coxeterWeightIn_eq_four_iff_not_linearIndependent ℤ).mpr hdep
  rcases int_mul_eq_four_cases hcox with hp | hp | hp | hp | hp | hp
  · exact absurd ((P.pairingIn_two_two_iff ℤ i j).mp hp) hij
  · exact (P.pairingIn_neg_two_neg_two_iff ℤ i j).mp hp
  · have hj := (P.pairingIn_one_four_iff ℤ i j).mp hp
    rw [two_smul] at hj
    exact absurd ⟨j, hj⟩ (h2 i)
  · have hi := (P.pairingIn_one_four_iff ℤ j i).mp hp
    rw [two_smul] at hi
    exact absurd ⟨i, hi⟩ (h2 j)
  · have hj := (P.pairingIn_neg_one_neg_four_iff ℤ i j).mp hp
    have hneg : P.root (P.reflectionPerm j j) = P.root i + P.root i := by
      rw [P.root_reflectionPerm, P.reflection_apply_self, hj]
      module
    exact absurd ⟨P.reflectionPerm j j, hneg⟩ (h2 i)
  · have hi := (P.pairingIn_neg_one_neg_four_iff ℤ j i).mp hp
    have hneg : P.root (P.reflectionPerm i i) = P.root j + P.root j := by
      rw [P.root_reflectionPerm, P.reflection_apply_self, hi]
      module
    exact absurd ⟨P.reflectionPerm i i, hneg⟩ (h2 j)

/-- Any finite integral root pairing admitting Chevalley structure constants is reduced: skew
symmetry forces `N_{i,i} = 0`, whereas `P.root k = P.root i + P.root i` would require
`|N_{i,i}| = p + 1 ≥ 1`. -/
theorem ChevalleyConstants.isReduced {ι X Y : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    {P : RootPairing ι ℤ X Y} (c : P.ChevalleyConstants) : P.IsReduced :=
  P.isReduced_of_add_self_notMem_range_root fun i ⟨k, hk⟩ ↦ by
    have hnat := c.natAbs_structConst hk
    rw [c.structConst_self i] at hnat
    exact Nat.succ_ne_zero _ hnat.symm

end Reduced

/-! ## Reductive Chevalley frames -/

section Frame

variable {ι J X Y L L' : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
  [LieRing L] [LieAlgebra ℚ L] [LieRing L'] [LieAlgebra ℚ L']

/-- **A concrete rational Lie-algebra realization of a full integral reductive root datum.**

Given `P : RootPairing ι ℤ X Y`, a `ReductiveChevalleyFrame` equips a `ℚ`-Lie algebra `L` with a
`ℤ`-basis `toralBasis` of the full cocharacter lattice `Y` (including any central cocharacters), an
integral toral map `cartan : Y →ₗ[ℤ] L`, root vectors `rootVector : ι → L`, a `ℚ`-basis
`ambientBasis : Basis (J ⊕ ι) ℚ L` matching the toral basis and root vectors, and an integral
structure-constant table `rootConstant` realizing the Chevalley bracket relations. -/
@[ext]
structure ReductiveChevalleyFrame (P : RootPairing ι ℤ X Y) [Finite ι] (J L : Type*)
    [LieRing L] [LieAlgebra ℚ L] where
  /-- Chosen `ℤ`-basis of the full cocharacter lattice `Y`. -/
  toralBasis : Module.Basis J ℤ Y
  /-- Integral embedding of the cocharacter lattice into `L`. -/
  cartan : Y →ₗ[ℤ] L
  /-- Distinguished Chevalley root vectors indexed by `ι`. -/
  rootVector : ι → L
  /-- Ambient `ℚ`-basis of `L` formed by the toral basis vectors and the root vectors. -/
  ambientBasis : Module.Basis (J ⊕ ι) ℚ L
  /-- Integral structure constants for brackets of root vectors whose roots sum to a root. -/
  rootConstant : ι → ι → ℤ
  /-- Left indices of `ambientBasis` are the images of `toralBasis` under `cartan`. -/
  basis_toral (j : J) : ambientBasis (Sum.inl j) = cartan (toralBasis j)
  /-- Right indices of `ambientBasis` are the distinguished root vectors. -/
  basis_root (i : ι) : ambientBasis (Sum.inr i) = rootVector i
  /-- Elements of the Cartan image commute. -/
  toral_commute (y z : Y) : ⁅cartan y, cartan z⁆ = 0
  /-- Toral elements act diagonally on root vectors through the root-cocharacter pairing. -/
  toral_root (y : Y) (i : ι) :
    ⁅cartan y, rootVector i⁆ = ((P.toLinearMap (P.root i) y : ℤ) : ℚ) • rootVector i
  /-- Opposite root vectors bracket to the corresponding coroot in the Cartan image. -/
  opposite_root (i j : ι) (hij : P.root j = -P.root i) :
    ⁅rootVector i, rootVector j⁆ = cartan (P.coroot i)
  /-- Non-opposite root vectors whose roots sum to a root bracket according to `rootConstant`. -/
  root_sum (i j k : ι) (hijk : P.root k = P.root i + P.root j) :
    ⁅rootVector i, rootVector j⁆ = (rootConstant i j : ℚ) • rootVector k
  /-- Chevalley normalization `|N_{i,j}| = p + 1` on root sums. -/
  natAbs_rootConstant (i j k : ι) (hijk : P.root k = P.root i + P.root j) :
    (rootConstant i j).natAbs = P.chainBotCoeff i j + 1
  /-- Non-opposite root vectors whose roots do not sum to a root commute. -/
  root_zero (i j : ι) (hne : P.root i + P.root j ≠ 0)
      (hnot : ∀ k : ι, P.root k ≠ P.root i + P.root j) :
    ⁅rootVector i, rootVector j⁆ = 0

namespace ChevalleyLieAlgebra

/-- **The canonical reductive Chevalley frame on `ℚ ⊗[ℤ] ChevalleyLieAlgebra c`** attached to any
Chevalley structure-constant table `c : P.ChevalleyConstants` and `ℤ`-basis `bY` of `Y`. -/
noncomputable def reductiveChevalleyFrame {P : RootPairing ι ℤ X Y} (c : P.ChevalleyConstants)
    (bY : Module.Basis J ℤ Y) :
    P.ReductiveChevalleyFrame J (ℚ ⊗[ℤ] ChevalleyLieAlgebra c) where
  toralBasis := bY
  cartan :=
    { toFun y := 1 ⊗ₜ[ℤ] ChevalleyLieAlgebra.cartan c y
      map_add' y z := by rw [map_add, TensorProduct.tmul_add]
      map_smul' z y := by rw [map_smul, TensorProduct.tmul_smul]; rfl }
  rootVector i := 1 ⊗ₜ[ℤ] ChevalleyLieAlgebra.root c i
  ambientBasis := (ChevalleyLieAlgebra.basis c bY).baseChange ℚ
  rootConstant := c.structConst
  basis_toral j := by simp [Module.Basis.baseChange_apply]
  basis_root i := by simp [Module.Basis.baseChange_apply]
  toral_commute y z := by simp
  toral_root y i := by simp [Int.cast_smul_eq_zsmul]
  opposite_root i j hij := by
    have h0 : P.root i + P.root j = 0 := by rw [hij, add_neg_cancel]
    simp [ChevalleyLieAlgebra.root_lie_root_of_add_eq_zero c h0]
  root_sum i j k hijk := by
    simp [ChevalleyLieAlgebra.root_lie_root_of_root_eq_add c hijk, Int.cast_smul_eq_zsmul]
  natAbs_rootConstant _ _ _ hijk := c.natAbs_structConst hijk
  root_zero i j hne hnot := by
    have hnot' : P.root i + P.root j ∉ range P.root := fun ⟨k, hk⟩ ↦ hnot k hk
    simp [ChevalleyLieAlgebra.root_lie_root_of_notMem_of_add_ne_zero c hnot' hne]

/-- The toral basis of `reductiveChevalleyFrame c bY` is `bY`. -/
@[simp]
theorem reductiveChevalleyFrame_toralBasis {P : RootPairing ι ℤ X Y} (c : P.ChevalleyConstants)
    (bY : Module.Basis J ℤ Y) :
    (reductiveChevalleyFrame c bY).toralBasis = bY :=
  (rfl)

/-- The Cartan map of `reductiveChevalleyFrame c bY` sends `y` to `1 ⊗ₜ cartan c y`. -/
@[simp]
theorem reductiveChevalleyFrame_cartan_apply {P : RootPairing ι ℤ X Y} (c : P.ChevalleyConstants)
    (bY : Module.Basis J ℤ Y) (y : Y) :
    (reductiveChevalleyFrame c bY).cartan y = 1 ⊗ₜ[ℤ] ChevalleyLieAlgebra.cartan c y :=
  (rfl)

/-- The `i`-th root vector of `reductiveChevalleyFrame c bY` is `1 ⊗ₜ root c i`. -/
@[simp]
theorem reductiveChevalleyFrame_rootVector {P : RootPairing ι ℤ X Y} (c : P.ChevalleyConstants)
    (bY : Module.Basis J ℤ Y) (i : ι) :
    (reductiveChevalleyFrame c bY).rootVector i = 1 ⊗ₜ[ℤ] ChevalleyLieAlgebra.root c i :=
  (rfl)

/-- The structure-constant table of `reductiveChevalleyFrame c bY` is `c.structConst`. -/
@[simp]
theorem reductiveChevalleyFrame_rootConstant {P : RootPairing ι ℤ X Y} (c : P.ChevalleyConstants)
    (bY : Module.Basis J ℤ Y) :
    (reductiveChevalleyFrame c bY).rootConstant = c.structConst :=
  (rfl)

end ChevalleyLieAlgebra

namespace ReductiveChevalleyFrame

variable {P : RootPairing ι ℤ X Y} (D : P.ReductiveChevalleyFrame J L)

/-- Transport a reductive Chevalley frame along a `ℚ`-Lie equivalence `L ≃ₗ⁅ℚ⁆ L'`. -/
noncomputable def map (f : L ≃ₗ⁅ℚ⁆ L') : P.ReductiveChevalleyFrame J L' where
  toralBasis := D.toralBasis
  cartan := (f.toLinearEquiv.toLinearMap.restrictScalars ℤ).comp D.cartan
  rootVector i := f (D.rootVector i)
  ambientBasis := D.ambientBasis.map f.toLinearEquiv
  rootConstant := D.rootConstant
  basis_toral j := by simp [D.basis_toral]
  basis_root i := by simp [D.basis_root]
  toral_commute y z := by
    change ⁅f (D.cartan y), f (D.cartan z)⁆ = 0
    rw [← f.map_lie, D.toral_commute, map_zero]
  toral_root y i := by
    change ⁅f (D.cartan y), f (D.rootVector i)⁆ = _
    rw [← f.map_lie, D.toral_root, map_smul]
  opposite_root i j hij := by
    change ⁅f (D.rootVector i), f (D.rootVector j)⁆ = f (D.cartan (P.coroot i))
    rw [← f.map_lie, D.opposite_root i j hij]
  root_sum i j k hijk := by
    rw [← f.map_lie, D.root_sum i j k hijk, map_smul]
  natAbs_rootConstant := D.natAbs_rootConstant
  root_zero i j hne hnot := by
    rw [← f.map_lie, D.root_zero i j hne hnot, map_zero]

/-- Transporting `D` along `f` composes `D.cartan` with `f`. -/
@[simp]
theorem map_cartan_apply (f : L ≃ₗ⁅ℚ⁆ L') (y : Y) :
    (D.map f).cartan y = f (D.cartan y) :=
  (rfl)

/-- Transporting `D` along `f` sends `D.rootVector i` to `f (D.rootVector i)`. -/
@[simp]
theorem map_rootVector (f : L ≃ₗ⁅ℚ⁆ L') (i : ι) :
    (D.map f).rootVector i = f (D.rootVector i) :=
  (rfl)

/-- Every root vector in a reductive Chevalley frame is nonzero, being a `ℚ`-basis vector. -/
theorem rootVector_ne_zero (i : ι) : D.rootVector i ≠ 0 := by
  rw [← D.basis_root]
  exact D.ambientBasis.ne_zero (Sum.inr i)

/-- The integral toral embedding `D.cartan : Y →ₗ[ℤ] L` is injective. -/
theorem cartan_injective : Function.Injective D.cartan := by
  have hli : LinearIndependent ℤ (D.cartan ∘ D.toralBasis) := by
    have hfun : D.cartan ∘ D.toralBasis = D.ambientBasis ∘ Sum.inl := by
      ext j
      exact (D.basis_toral j).symm
    rw [hfun]
    exact (D.ambientBasis.linearIndependent.comp Sum.inl Sum.inl_injective).restrict_scalars' ℤ
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro y hy
  rw [LinearMap.mem_ker, ← D.toralBasis.linearCombination_repr y,
    Finsupp.apply_linearCombination] at hy
  exact D.toralBasis.repr.injective
    (by simpa using linearIndependent_iff.mp hli (D.toralBasis.repr y) hy)

include D in
/-- Any finite integral root datum admitting a reductive Chevalley frame is reduced. -/
theorem isReduced : P.IsReduced :=
  P.isReduced_of_add_self_notMem_range_root fun i ⟨k, hk⟩ ↦ by
    have hlie := D.root_sum i i k hk
    rw [lie_self] at hlie
    rcases smul_eq_zero.mp hlie.symm with h0 | hk0
    · have hc0 : D.rootConstant i i = 0 := Int.cast_eq_zero.mp h0
      have hnat := D.natAbs_rootConstant i i k hk
      rw [hc0] at hnat
      exact Nat.succ_ne_zero _ hnat.symm
    · exact D.rootVector_ne_zero k hk0

/-- The distinguished root vectors and full-`Y` toral basis vectors generate `L` as a `ℚ`-Lie
algebra; in fact their `ℚ`-linear span is already `⊤`. -/
theorem lieSpan_eq_top :
    LieSubalgebra.lieSpan ℚ L
      (range D.rootVector ∪ range fun j ↦ D.cartan (D.toralBasis j)) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have hx : x ∈ Submodule.span ℚ (range D.ambientBasis) := by
    rw [D.ambientBasis.span_eq]
    trivial
  change x ∈ (LieSubalgebra.lieSpan ℚ L _).toSubmodule
  refine (Submodule.span_le.mpr ?_) hx
  rintro _ ⟨j | i, rfl⟩
  · rw [D.basis_toral]
    exact LieSubalgebra.subset_lieSpan (Or.inr ⟨j, rfl⟩)
  · rw [D.basis_root]
    exact LieSubalgebra.subset_lieSpan (Or.inl ⟨i, rfl⟩)

/-! ## Kostant integral form of a reductive Chevalley frame -/

attribute [local instance] TauCeti.moduleNNRat

/-- **The Kostant `ℤ`-form of `UniversalEnvelopingAlgebra ℚ L` attached to a reductive Chevalley
frame**, generated by the divided powers of all root vectors and the binomial coefficients of all
full-`Y` toral basis vectors (including central cocharacters). -/
noncomputable def kostantForm : Subring (UniversalEnvelopingAlgebra ℚ L) :=
  TauCeti.UniversalEnvelopingAlgebra.kostantForm D.rootVector
    fun j ↦ D.cartan (D.toralBasis j)

/-- `D.kostantForm` unfolds to `TauCeti.UniversalEnvelopingAlgebra.kostantForm` on `D.rootVector`
and `fun j ↦ D.cartan (D.toralBasis j)`. -/
theorem kostantForm_def :
    D.kostantForm =
      TauCeti.UniversalEnvelopingAlgebra.kostantForm D.rootVector
        (fun j ↦ D.cartan (D.toralBasis j)) :=
  (rfl)

/-- The `n`-th divided power `(D.rootVector i)⁽ⁿ⁾` bundled as an element of `D.kostantForm`. -/
noncomputable def rootDividedPower (i : ι) (n : ℕ) : D.kostantForm :=
  ⟨TauCeti.Associative.dividedPower n (UniversalEnvelopingAlgebra.ι ℚ (D.rootVector i)),
    TauCeti.UniversalEnvelopingAlgebra.dividedPower_mem_kostantForm _ _ i n⟩

/-- Coercion of `D.rootDividedPower i n` to `UniversalEnvelopingAlgebra ℚ L`. -/
@[simp]
theorem coe_rootDividedPower (i : ι) (n : ℕ) :
    (D.rootDividedPower i n : UniversalEnvelopingAlgebra ℚ L) =
      TauCeti.Associative.dividedPower n (UniversalEnvelopingAlgebra.ι ℚ (D.rootVector i)) :=
  (rfl)

/-- The `n`-th binomial coefficient `(D.cartan (D.toralBasis j) choose n)` bundled as an element of
`D.kostantForm`. -/
noncomputable def toralBinomial (j : J) (n : ℕ) : D.kostantForm :=
  ⟨Ring.choose (UniversalEnvelopingAlgebra.ι ℚ (D.cartan (D.toralBasis j))) n,
    TauCeti.UniversalEnvelopingAlgebra.ringChoose_mem_kostantForm _ _ j n⟩

/-- Coercion of `D.toralBinomial j n` to `UniversalEnvelopingAlgebra ℚ L`. -/
@[simp]
theorem coe_toralBinomial (j : J) (n : ℕ) :
    (D.toralBinomial j n : UniversalEnvelopingAlgebra ℚ L) =
      Ring.choose (UniversalEnvelopingAlgebra.ι ℚ (D.cartan (D.toralBasis j))) n :=
  (rfl)

/-- **Base change of the reductive Kostant `ℤ`-form to `ℚ` recovers `U(L)`.** -/
noncomputable def kostantFormBaseChange :
    ℚ ⊗[ℤ] D.kostantForm ≃ₐ[ℚ] UniversalEnvelopingAlgebra ℚ L :=
  TauCeti.UniversalEnvelopingAlgebra.kostantFormBaseChange D.rootVector
    (fun j ↦ D.cartan (D.toralBasis j)) D.lieSpan_eq_top

/-- `D.kostantFormBaseChange` sends `q ⊗ₜ x` to `q • (x : UniversalEnvelopingAlgebra ℚ L)`. -/
@[simp]
theorem kostantFormBaseChange_tmul (q : ℚ) (x : D.kostantForm) :
    D.kostantFormBaseChange (q ⊗ₜ[ℤ] x) = q • (x : UniversalEnvelopingAlgebra ℚ L) :=
  TauCeti.UniversalEnvelopingAlgebra.kostantFormBaseChange_tmul _ _ _ q x

/-! ## Full integral Chevalley lattice and Kostant adjoint action -/

/-- The full integral Chevalley `ℤ`-submodule of `L`, spanned over `ℤ` by `D.ambientBasis` (the
toral basis of `Y` together with all root vectors). -/
noncomputable def integralSubmodule : Submodule ℤ L :=
  Submodule.span ℤ (range D.ambientBasis)

/-- Every toral basis vector lies in `D.integralSubmodule`. -/
theorem cartan_toralBasis_mem_integralSubmodule (j : J) :
    D.cartan (D.toralBasis j) ∈ D.integralSubmodule := by
  rw [← D.basis_toral]
  exact Submodule.subset_span (mem_range_self (Sum.inl j))

/-- The image of every cocharacter `y : Y` under `D.cartan` lies in `D.integralSubmodule`. -/
theorem cartan_mem_integralSubmodule (y : Y) :
    D.cartan y ∈ D.integralSubmodule := by
  have hy : y ∈ Submodule.span ℤ (range D.toralBasis) := by
    rw [D.toralBasis.span_eq]
    trivial
  induction hy using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨j, rfl⟩ := hv
    exact D.cartan_toralBasis_mem_integralSubmodule j
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add u v _ _ hu hv => rw [map_add]; exact Submodule.add_mem _ hu hv
  | smul z u _ hu => rw [map_smul]; exact Submodule.smul_mem _ z hu

/-- Every distinguished root vector lies in `D.integralSubmodule`. -/
theorem rootVector_mem_integralSubmodule (i : ι) :
    D.rootVector i ∈ D.integralSubmodule := by
  rw [← D.basis_root]
  exact Submodule.subset_span (mem_range_self (Sum.inr i))

private theorem lie_ambientBasis_mem_integralSubmodule (a b : J ⊕ ι) :
    ⁅D.ambientBasis a, D.ambientBasis b⁆ ∈ D.integralSubmodule := by
  rcases a with j₁ | i₁ <;> rcases b with j₂ | i₂
  · rw [D.basis_toral, D.basis_toral, D.toral_commute]
    exact Submodule.zero_mem _
  · rw [D.basis_toral, D.basis_root, D.toral_root, Int.cast_smul_eq_zsmul]
    exact Submodule.smul_mem _ _ (D.rootVector_mem_integralSubmodule i₂)
  · rw [D.basis_root, D.basis_toral, ← lie_skew, D.toral_root, Int.cast_smul_eq_zsmul]
    exact Submodule.neg_mem _ (Submodule.smul_mem _ _ (D.rootVector_mem_integralSubmodule i₁))
  · rw [D.basis_root, D.basis_root]
    by_cases h0 : P.root i₁ + P.root i₂ = 0
    · rw [D.opposite_root i₁ i₂ (eq_neg_of_add_eq_zero_right h0)]
      exact D.cartan_mem_integralSubmodule (P.coroot i₁)
    · by_cases hex : ∃ k, P.root k = P.root i₁ + P.root i₂
      · obtain ⟨k, hk⟩ := hex
        rw [D.root_sum i₁ i₂ k hk, Int.cast_smul_eq_zsmul]
        exact Submodule.smul_mem _ _ (D.rootVector_mem_integralSubmodule k)
      · rw [D.root_zero i₁ i₂ h0 (fun k hk ↦ hex ⟨k, hk⟩)]
        exact Submodule.zero_mem _

/-- **The full integral Chevalley Lie subalgebra of `L`**, closed under the Lie bracket over `ℤ`. -/
noncomputable def integralLieAlgebra : LieSubalgebra ℤ L :=
  { D.integralSubmodule with
    lie_mem' {u v} hu hv := by
      induction hu, hv using Submodule.span_induction₂ with
      | mem_mem _ _ ha hb =>
        obtain ⟨a, rfl⟩ := ha
        obtain ⟨b, rfl⟩ := hb
        exact D.lie_ambientBasis_mem_integralSubmodule a b
      | zero_left => rw [zero_lie]; exact Submodule.zero_mem _
      | zero_right => rw [lie_zero]; exact Submodule.zero_mem _
      | add_left _ _ _ _ _ _ h₁ h₂ => rw [add_lie]; exact Submodule.add_mem _ h₁ h₂
      | add_right _ _ _ _ _ _ h₁ h₂ => rw [lie_add]; exact Submodule.add_mem _ h₁ h₂
      | smul_left z _ _ _ _ h => rw [smul_lie]; exact Submodule.smul_mem _ z h
      | smul_right z _ _ _ _ h => rw [lie_smul]; exact Submodule.smul_mem _ z h }

/-- The underlying `ℤ`-submodule of `D.integralLieAlgebra` is `D.integralSubmodule`. -/
@[simp]
theorem integralLieAlgebra_toSubmodule :
    D.integralLieAlgebra.toSubmodule = D.integralSubmodule :=
  (rfl)

/-- **The `ℤ`-basis of the full integral Chevalley lattice** indexed by `J ⊕ ι`. -/
noncomputable def integralBasis : Module.Basis (J ⊕ ι) ℤ D.integralSubmodule :=
  Module.Basis.span (D.ambientBasis.linearIndependent.restrict_scalars' ℤ)

/-- Left indices of `D.integralBasis` coerce to the toral basis vectors
`D.cartan (D.toralBasis j)`. -/
@[simp]
theorem coe_integralBasis_inl (j : J) :
    (D.integralBasis (Sum.inl j) : L) = D.cartan (D.toralBasis j) := by
  have h : (D.integralBasis (Sum.inl j) : L) =
      (Module.Basis.span (D.ambientBasis.linearIndependent.restrict_scalars' ℤ)
        (Sum.inl j) : L) := rfl
  rw [h, Module.Basis.coe_span_apply, D.basis_toral]

/-- Right indices of `D.integralBasis` coerce to the distinguished root vectors
`D.rootVector i`. -/
@[simp]
theorem coe_integralBasis_inr (i : ι) :
    (D.integralBasis (Sum.inr i) : L) = D.rootVector i := by
  have h : (D.integralBasis (Sum.inr i) : L) =
      (Module.Basis.span (D.ambientBasis.linearIndependent.restrict_scalars' ℤ)
        (Sum.inr i) : L) := rfl
  rw [h, Module.Basis.coe_span_apply, D.basis_root]

/-- Every binomial coefficient of `ad (D.cartan (D.toralBasis j))` preserves `D.integralSubmodule`,
since `D.ambientBasis` consists of eigenvectors with integer eigenvalues. -/
theorem ringChoose_ad_toral_mem (j : J) (n : ℕ) {v : L} (hv : v ∈ D.integralSubmodule) :
    Ring.choose (LieAlgebra.ad ℚ L (D.cartan (D.toralBasis j))) n v ∈ D.integralSubmodule := by
  let weight : J ⊕ ι → ℤ
    | Sum.inl _ => 0
    | Sum.inr i => P.toLinearMap (P.root i) (D.toralBasis j)
  refine TauCeti.ringChoose_end_apply_mem_span_of_apply_eq_intCast_smul (weight := weight)
    (fun idx ↦ ?_) n hv
  rcases idx with j' | i
  · simp [weight, D.basis_toral, D.toral_commute]
  · simp [weight, D.basis_root, D.toral_root]

/-- Every toral binomial generator of `D.kostantForm` preserves `D.integralSubmodule` under the
adjoint representation of `U(L)`. -/
theorem ringChoose_representation_mem (j : J) (n : ℕ) {v : L} (hv : v ∈ D.integralSubmodule) :
    TauCeti.UniversalEnvelopingAlgebra.representation ℚ L L
        (Ring.choose (UniversalEnvelopingAlgebra.ι ℚ (D.cartan (D.toralBasis j))) n) v ∈
      D.integralSubmodule := by
  rw [Ring.map_choose (TauCeti.UniversalEnvelopingAlgebra.representation ℚ L L)
    (UniversalEnvelopingAlgebra.ι ℚ (D.cartan (D.toralBasis j))) n,
    TauCeti.UniversalEnvelopingAlgebra.representation_ι_ad]
  exact D.ringChoose_ad_toral_mem j n hv

omit [Finite ι] in
private theorem linearIndependent_pair_add_nsmul {a b : X}
    (h : LinearIndependent ℤ ![a, b]) (n : ℕ) :
    LinearIndependent ℤ ![a, b + n • a] := by
  rw [LinearIndependent.pair_iff] at h ⊢
  intro s t hst
  have hst' : (s + t * (n : ℤ)) • a + t • b = 0 := by
    rw [← hst, ← natCast_zsmul]
    module
  have ht : t = 0 := (h (s + t * n) t hst').2
  have hs : s + t * n = 0 := (h (s + t * n) t hst').1
  subst ht
  rw [zero_mul, add_zero] at hs
  exact ⟨hs, rfl⟩

/-- **Iterated adjoint action along a root string in a reductive Chevalley frame.** When `i ≠ j`
and `P.root i + P.root j ≠ 0`, the `n`-th power of `ad (D.rootVector i)` sends `D.rootVector j`
either to `0` or to `z • D.rootVector γ` where `P.root γ = P.root j + n • P.root i` and
`|z| = (p + 1)(p + 2) ⋯ (p + n)` for `p = P.chainBotCoeff i j`. -/
theorem ad_pow_rootVector_eq_zero_or_exists {i j : ι} (hij : i ≠ j)
    (h0 : P.root i + P.root j ≠ 0) (n : ℕ) :
    ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ n) (D.rootVector j) = 0 ∨
      ∃ γ : ι, P.root γ = P.root j + n • P.root i ∧
        P.chainBotCoeff i γ = P.chainBotCoeff i j + n ∧
        ∃ z : ℤ, z.natAbs = (P.chainBotCoeff i j + 1).ascFactorial n ∧
          ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ n) (D.rootVector j) =
            (z : ℚ) • D.rootVector γ := by
  have : P.IsReduced := D.isReduced
  have hli : LinearIndependent ℤ ![P.root i, P.root j] :=
    IsReduced.linearIndependent P hij fun h ↦ h0 (by rw [h, neg_add_cancel])
  induction n with
  | zero =>
    exact Or.inr ⟨j, by simp, by simp, 1, by simp, by simp⟩
  | succ n ih =>
    rcases ih with hzero | ⟨γ, hγ, hγbot, z, hznat, hz⟩
    · exact Or.inl (by rw [pow_succ', mul_apply_eq_comp, hzero, map_zero])
    have hli_γ : LinearIndependent ℤ ![P.root i, P.root γ] := by
      rw [hγ]
      exact linearIndependent_pair_add_nsmul hli n
    have hne_zero : P.root i + P.root γ ≠ 0 := by
      intro hsum
      have := (LinearIndependent.pair_iff.mp hli_γ) 1 1 (by simpa using hsum)
      omega
    have hstep : ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ (n + 1)) (D.rootVector j) =
        (z : ℚ) • ⁅D.rootVector i, D.rootVector γ⁆ := by
      rw [pow_succ', mul_apply_eq_comp, hz, map_smul, LieAlgebra.ad_apply]
    by_cases hex : ∃ δ : ι, P.root δ = P.root i + P.root γ
    · obtain ⟨δ, hδ⟩ := hex
      have hδ_shift : P.root δ = P.root j + (n + 1) • P.root i := by
        rw [hδ, hγ, add_nsmul, one_nsmul]
        abel
      have hbotδ : P.chainBotCoeff i δ = P.chainBotCoeff i j + (n + 1) := by
        have hstep_bot := P.chainBotCoeff_of_add hli_γ (by rw [hδ, add_comm])
        omega
      refine Or.inr ⟨δ, hδ_shift, hbotδ, z * D.rootConstant i γ, ?_, ?_⟩
      · rw [Int.natAbs_mul, hznat, D.natAbs_rootConstant i γ δ hδ, Nat.ascFactorial_succ, hγbot]
        ring
      · rw [hstep, D.root_sum i γ δ hδ, smul_smul, Int.cast_mul]
    · refine Or.inl ?_
      rw [hstep, D.root_zero i γ hne_zero (fun δ hδ ↦ hex ⟨δ, hδ⟩), smul_zero]

private theorem inv_factorial_smul_ad_pow_opposite_mem (i j : ι) (hij : P.root j = -P.root i)
    (n : ℕ) :
    (n.factorial : ℚ)⁻¹ • ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ n) (D.rootVector j) ∈
      D.integralSubmodule := by
  have h1 : (LieAlgebra.ad ℚ L (D.rootVector i)) (D.rootVector j) = D.cartan (P.coroot i) :=
    D.opposite_root i j hij
  have h2 : (LieAlgebra.ad ℚ L (D.rootVector i)) (D.cartan (P.coroot i)) =
      (-2 : ℚ) • D.rootVector i := by
    rw [LieAlgebra.ad_apply, ← lie_skew, D.toral_root, P.root_coroot_eq_pairing, P.pairing_same]
    norm_num [neg_smul]
  have h3 : (LieAlgebra.ad ℚ L (D.rootVector i)) ((-2 : ℚ) • D.rootVector i) = 0 := by
    rw [map_smul, LieAlgebra.ad_apply, lie_self, smul_zero]
  have h2' : ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ 2) (D.rootVector j) =
      (-2 : ℚ) • D.rootVector i := by
    rw [pow_succ', mul_apply_eq_comp, pow_one, h1, h2]
  have h3' : ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ 3) (D.rootVector j) = 0 := by
    rw [pow_succ', mul_apply_eq_comp, h2', h3]
  match n with
  | 0 => simpa using D.rootVector_mem_integralSubmodule j
  | 1 =>
    rw [pow_one, h1]
    simpa using D.cartan_mem_integralSubmodule (P.coroot i)
  | 2 =>
    have hcancel : ((Nat.factorial 2 : ℚ))⁻¹ • ((-2 : ℚ) • D.rootVector i) = -D.rootVector i := by
      rw [smul_smul]
      norm_num
    rw [h2', hcancel]
    exact Submodule.neg_mem _ (D.rootVector_mem_integralSubmodule i)
  | m + 3 =>
    rw [pow_add, mul_apply_eq_comp, h3', map_zero, smul_zero]
    exact Submodule.zero_mem _

/-- Divided powers of `ad (D.rootVector i)` send every root vector into `D.integralSubmodule`. -/
theorem inv_factorial_smul_ad_pow_rootVector_mem (i j : ι) (n : ℕ) :
    (n.factorial : ℚ)⁻¹ • ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ n) (D.rootVector j) ∈
      D.integralSubmodule := by
  rcases eq_or_ne i j with rfl | hij
  · match n with
    | 0 => simpa using D.rootVector_mem_integralSubmodule i
    | m + 1 =>
      have hself : (LieAlgebra.ad ℚ L (D.rootVector i)) (D.rootVector i) = 0 := lie_self _
      rw [pow_succ, mul_apply_eq_comp, hself, map_zero, smul_zero]
      exact Submodule.zero_mem _
  · by_cases h0 : P.root i + P.root j = 0
    · exact D.inv_factorial_smul_ad_pow_opposite_mem i j (eq_neg_of_add_eq_zero_right h0) n
    · rcases D.ad_pow_rootVector_eq_zero_or_exists hij h0 n with hzero | ⟨γ, -, -, z, hznat, hz⟩
      · rw [hzero, smul_zero]
        exact Submodule.zero_mem _
      · obtain ⟨w, hw⟩ : (n.factorial : ℤ) ∣ z := by
          refine Int.dvd_natAbs.mp ?_
          rw [hznat]
          exact Int.natCast_dvd_natCast.mpr (Nat.factorial_dvd_ascFactorial _ _)
        rw [hz, hw, smul_smul]
        have hfac : (n.factorial : ℚ)⁻¹ * (((n.factorial : ℤ) * w : ℤ) : ℚ) = (w : ℚ) := by
          have hne : (n.factorial : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr n.factorial_ne_zero
          push_cast
          field_simp
        rw [hfac, Int.cast_smul_eq_zsmul]
        exact Submodule.smul_mem _ w (D.rootVector_mem_integralSubmodule γ)

/-- Divided powers of `ad (D.rootVector i)` send every toral element `D.cartan y` (including central
cocharacters) into `D.integralSubmodule`. -/
theorem inv_factorial_smul_ad_pow_cartan_mem (i : ι) (y : Y) (n : ℕ) :
    (n.factorial : ℚ)⁻¹ • ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ n) (D.cartan y) ∈
      D.integralSubmodule := by
  let m : ℤ := P.toLinearMap (P.root i) y
  have h1 : (LieAlgebra.ad ℚ L (D.rootVector i)) (D.cartan y) =
      ((-m : ℤ) : ℚ) • D.rootVector i := by
    rw [LieAlgebra.ad_apply, ← lie_skew, D.toral_root, Int.cast_neg, neg_smul]
  have h2 : (LieAlgebra.ad ℚ L (D.rootVector i)) (((-m : ℤ) : ℚ) • D.rootVector i) = 0 := by
    rw [map_smul, LieAlgebra.ad_apply, lie_self, smul_zero]
  match n with
  | 0 => simpa using D.cartan_mem_integralSubmodule y
  | 1 =>
    rw [pow_one, h1]
    simpa [Int.cast_smul_eq_zsmul] using
      Submodule.smul_mem _ (-m) (D.rootVector_mem_integralSubmodule i)
  | k + 2 =>
    have h2' : ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ 2) (D.cartan y) = 0 := by
      rw [pow_succ', mul_apply_eq_comp, pow_one, h1, h2]
    rw [pow_add, mul_apply_eq_comp, h2', map_zero, smul_zero]
    exact Submodule.zero_mem _

/-- **The full integral Chevalley lattice is stable under all root divided powers
`(ad xᵢ)ⁿ / n!`.** -/
theorem inv_factorial_smul_ad_pow_mem (i : ι) (n : ℕ) {v : L}
    (hv : v ∈ D.integralSubmodule) :
    (n.factorial : ℚ)⁻¹ • ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ n) v ∈ D.integralSubmodule := by
  let f : L →ₗ[ℤ] L :=
    (((n.factorial : ℚ)⁻¹ • ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ n) :
      Module.End ℚ L)).restrictScalars ℤ
  change f v ∈ D.integralSubmodule
  induction hv using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨j | k, rfl⟩ := hw
    · change (n.factorial : ℚ)⁻¹ •
        ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ n) (D.ambientBasis (Sum.inl j)) ∈ _
      rw [D.basis_toral]
      exact D.inv_factorial_smul_ad_pow_cartan_mem i (D.toralBasis j) n
    · change (n.factorial : ℚ)⁻¹ •
        ((LieAlgebra.ad ℚ L (D.rootVector i)) ^ n) (D.ambientBasis (Sum.inr k)) ∈ _
      rw [D.basis_root]
      exact D.inv_factorial_smul_ad_pow_rootVector_mem i k n
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul z x _ hx => rw [map_smul]; exact Submodule.smul_mem _ z hx

/-- Every root divided-power generator of `D.kostantForm` preserves `D.integralSubmodule` under the
adjoint representation of `U(L)`. -/
theorem dividedPower_representation_mem (i : ι) (n : ℕ) {v : L}
    (hv : v ∈ D.integralSubmodule) :
    TauCeti.UniversalEnvelopingAlgebra.representation ℚ L L
        (TauCeti.Associative.dividedPower n (UniversalEnvelopingAlgebra.ι ℚ (D.rootVector i))) v ∈
      D.integralSubmodule := by
  rw [TauCeti.Associative.map_dividedPower,
    TauCeti.UniversalEnvelopingAlgebra.representation_ι_ad,
    TauCeti.Associative.dividedPower_def, LinearMap.smul_apply]
  exact D.inv_factorial_smul_ad_pow_mem i n hv

/-- **The Kostant `ℤ`-form of a reductive Chevalley frame stabilizes the full integral Chevalley
lattice** under the adjoint representation of `U(L)`. -/
theorem kostantForm_le_stabilizer :
    D.kostantForm ≤
      TauCeti.UniversalEnvelopingAlgebra.stabilizer
        (TauCeti.UniversalEnvelopingAlgebra.representation ℚ L L) D.integralSubmodule :=
  TauCeti.UniversalEnvelopingAlgebra.kostantForm_le_stabilizer _ _ _ _
    (fun i n _ hv ↦ D.dividedPower_representation_mem i n hv)
    (fun j n _ hv ↦ D.ringChoose_representation_mem j n hv)

/-- Every element of `D.kostantForm` maps `D.integralSubmodule` into itself under the adjoint
action of `U(L)`. -/
theorem kostantForm_apply_mem {u : UniversalEnvelopingAlgebra ℚ L}
    (hu : u ∈ D.kostantForm) {v : L} (hv : v ∈ D.integralSubmodule) :
    TauCeti.UniversalEnvelopingAlgebra.representation ℚ L L u v ∈ D.integralSubmodule :=
  (TauCeti.UniversalEnvelopingAlgebra.mem_stabilizer_iff _ _ u).mp
    (D.kostantForm_le_stabilizer hu) v hv

/-- **The integral adjoint representation of the Kostant `ℤ`-form on the full Chevalley
lattice.** -/
noncomputable def adjointRep :
    D.kostantForm →ₐ[ℤ] Module.End ℤ D.integralSubmodule :=
  TauCeti.UniversalEnvelopingAlgebra.kostantFormRep _ _
    (TauCeti.UniversalEnvelopingAlgebra.representation ℚ L L) D.integralSubmodule
    (fun i n _ hv ↦ D.dividedPower_representation_mem i n hv)
    (fun j n _ hv ↦ D.ringChoose_representation_mem j n hv)

/-- Applying `D.adjointRep u` to `v : D.integralSubmodule` agrees with the ambient `U(L)`-action. -/
@[simp]
theorem coe_adjointRep_apply (u : D.kostantForm) (v : D.integralSubmodule) :
    ((D.adjointRep u v : D.integralSubmodule) : L) =
      TauCeti.UniversalEnvelopingAlgebra.representation ℚ L L
        (u : UniversalEnvelopingAlgebra ℚ L) (v : L) :=
  TauCeti.UniversalEnvelopingAlgebra.coe_kostantFormRep_apply _ _ _ _ _ _ u v

