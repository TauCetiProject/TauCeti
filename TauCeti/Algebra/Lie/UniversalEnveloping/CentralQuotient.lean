/-!
# Enveloping algebras with a prescribed central value

For a Lie algebra `L` over a commutative ring `R`, an element `z : L` and a scalar `c : R`, the
algebra `TauCeti.UniversalEnvelopingAlgebra.CentralQuotient R z c` is the quotient of the universal
enveloping algebra `U(L)` by the two-sided ideal generated by `ι z - c`. Its representations are
the representations of `L` in which `z` acts by the scalar `c`: a Lie algebra morphism `f : L → A`
into an associative algebra with `f z = c` factors uniquely through it
(`TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.lift`).

The main case is a central element `z`, such as the central generator `K` of an affine Kac--Moody
algebra, where the quotient at `c = 1` is the enveloping algebra of the representations of level
one. For central `z` the two-sided ideal is the left ideal of multiples of `ι z - c`
(`TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.mk_eq_mk_iff`). Over a field, if `z` is
central and nonzero, the Poincaré--Birkhoff--Witt theorem describes the quotient in degree at
most one: the image of `x : L` is a scalar `a` exactly when `x = r • z` and `a = r * c` for some
`r`
(`TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.ι_eq_algebraMap_iff`). In particular the
scalars embed, so the quotient is nonzero, including when `c = 0`.

## Main definitions

* `TauCeti.UniversalEnvelopingAlgebra.CentralQuotient`: the quotient `U(L) / (ι z - c)`.
* `TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.mk`: the quotient map from `U(L)`.
* `TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.ι`: the canonical Lie algebra morphism.
* `TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.lift`: the universal property.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.mk_eq_mk_iff`: for central `z`, two
  elements of `U(L)` have the same image exactly when they differ by a multiple of `ι z - c`.
* `TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.ι_eq_algebraMap_iff`: over a field, for
  central nonzero `z`, the image of `x` is the scalar `a` exactly when `(x, a)` is a multiple of
  `(z, c)`.
* `TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.algebraMap_injective`: over a field, for
  central nonzero `z`, the scalars embed in the quotient.

## References

* J. Dixmier, *Enveloping Algebras*, §2.2 and §2.4 (universal property and quotients by central
  ideals), and §2.3 (the Poincaré--Birkhoff--Witt theorem).
-/

public section

noncomputable section

namespace TauCeti.UniversalEnvelopingAlgebra

open LieAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

universe u v

variable (R : Type u) {L : Type v} [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "U" => _root_.UniversalEnvelopingAlgebra R L

/-- The relation identifying the generator `ι z` of `U(L)` with the scalar `c`. -/
inductive CentralQuotient.Rel (z : L) (c : R) : U → U → Prop
  | ι_eq : CentralQuotient.Rel z c (_root_.UniversalEnvelopingAlgebra.ι R z) (algebraMap R U c)

/-- The ring congruence on `U(L)` generated by `ι z ~ c`. -/
def CentralQuotient.ringCon (z : L) (c : R) : RingCon U :=
  ringConGen (CentralQuotient.Rel R z c)

/-- The quotient of the universal enveloping algebra `U(L)` by the two-sided ideal generated by
`ι z - c`. When `z` is central, its modules are the `L`-modules on which `z` acts by `c`. -/
def CentralQuotient (z : L) (c : R) : Type (max u v) :=
  (CentralQuotient.ringCon R z c).Quotient
deriving Ring, Algebra R

namespace CentralQuotient

variable {R} (z : L) (c : R)

/-- The quotient map from the universal enveloping algebra. -/
def mk : U →ₐ[R] CentralQuotient R z c :=
  RingCon.mkₐ R (ringCon R z c)

/-- The quotient map is surjective. -/
theorem mk_surjective : Function.Surjective (mk z c) :=
  RingCon.mkₐ_surjective _

-- This is not a `simp` lemma: `simp` unfolds `ι` through Mathlib's
-- `UniversalEnvelopingAlgebra.ι_apply`; `mk_ι_self'` is the `simp`-normal form.
/-- The generator `ι z` becomes the scalar `c`. -/
theorem mk_ι_self : mk z c (_root_.UniversalEnvelopingAlgebra.ι R z) = algebraMap R _ c :=
  (RingCon.eq _).2 (RingCon.le_ringConGen _ _ Rel.ι_eq)

/-- The `simp`-normal form of `TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.mk_ι_self`. -/
@[simp]
theorem mk_ι_self' :
    mk z c (_root_.UniversalEnvelopingAlgebra.mkAlgHom R L (TensorAlgebra.ι R z)) =
      algebraMap R _ c :=
  mk_ι_self z c

/-- The canonical Lie algebra morphism from `L`. -/
def ι : L →ₗ⁅R⁆ CentralQuotient R z c :=
  (mk z c).toLieHom.comp (_root_.UniversalEnvelopingAlgebra.ι R)

/-- The canonical Lie algebra morphism is the image of the canonical map into `U(L)`. -/
theorem ι_apply (x : L) : ι z c x = mk z c (_root_.UniversalEnvelopingAlgebra.ι R x) :=
  (rfl)

/-- The canonical image of `z` is the scalar `c`. -/
@[simp]
theorem ι_self : ι z c z = algebraMap R _ c :=
  mk_ι_self z c

variable {z c} {A : Type*} [Ring A] [Algebra R A]

/-- **The universal property.** A Lie algebra morphism into an associative algebra which sends
`z` to the scalar `c` factors through the quotient. -/
def lift (f : L →ₗ⁅R⁆ A) (hf : f z = algebraMap R A c) : CentralQuotient R z c →ₐ[R] A :=
  RingCon.liftₐ _ (_root_.UniversalEnvelopingAlgebra.lift R f) <| by
    rw [ringCon, RingCon.ringConGen_le]
    rintro _ _ ⟨⟩
    simp [hf]

/-- The lift agrees with the lift of `f` to `U(L)`. -/
@[simp]
theorem lift_mk (f : L →ₗ⁅R⁆ A) (hf : f z = algebraMap R A c) (u : U) :
    lift f hf (mk z c u) = _root_.UniversalEnvelopingAlgebra.lift R f u :=
  (rfl)

/-- The lift extends `f`. -/
@[simp]
theorem lift_ι (f : L →ₗ⁅R⁆ A) (hf : f z = algebraMap R A c) (x : L) :
    lift f hf (ι z c x) = f x := by
  rw [ι_apply, lift_mk, _root_.UniversalEnvelopingAlgebra.lift_ι_apply]

/-- Algebra morphisms out of the quotient are determined by their values on the canonical
generators. -/
@[ext]
theorem algHom_ext {g₁ g₂ : CentralQuotient R z c →ₐ[R] A} (h : ∀ x, g₁ (ι z c x) = g₂ (ι z c x)) :
    g₁ = g₂ :=
  RingCon.Quotient.hom_extₐ <| _root_.UniversalEnvelopingAlgebra.hom_ext R <|
    LieHom.ext fun x ↦ h x

variable (c) in
/-- **The kernel of the quotient map.** For central `z`, two elements of `U(L)` have the same
image exactly when they differ by a multiple of `ι z - c`. -/
theorem mk_eq_mk_iff (hz : z ∈ center R L) {u v : U} :
    mk z c u = mk z c v ↔
      ∃ w : U, u - v = w * (_root_.UniversalEnvelopingAlgebra.ι R z - algebraMap R U c) := by
  set g := _root_.UniversalEnvelopingAlgebra.ι R z - algebraMap R U c
  have hg (y : U) : g * y = y * g := by
    have hι : _root_.UniversalEnvelopingAlgebra.ι R z ∈ Subalgebra.center R U :=
      (mem_center_iff_forall_lie_ι R L).2 fun x ↦ by
        rw [← LieHom.map_lie, ← lie_skew, (LieModule.mem_maxTrivSubmodule R L L z).1 hz x,
          neg_zero, map_zero]
    exact (Subalgebra.mem_center_iff.1
      ((Subalgebra.center R U).sub_mem hι (Subalgebra.algebraMap_mem _ c)) y).symm
  refine ⟨fun h ↦ ?_, fun ⟨w, hw⟩ ↦ ?_⟩
  · -- Follow the ring congruence generated by the defining relation.
    have hrel : RingConGen.Rel (Rel R z c) u v := (RingCon.eq _).1 h
    clear h
    induction hrel with
    | of _ _ h => cases h; exact ⟨1, (one_mul _).symm⟩
    | refl => exact ⟨0, by simp⟩
    | symm _ ih => obtain ⟨w, hw⟩ := ih; exact ⟨-w, by rw [← neg_sub, hw, neg_mul]⟩
    | trans _ _ ih₁ ih₂ =>
      obtain ⟨w₁, hw₁⟩ := ih₁
      obtain ⟨w₂, hw₂⟩ := ih₂
      exact ⟨w₁ + w₂, by rw [← sub_add_sub_cancel, hw₁, hw₂, add_mul]⟩
    | add _ _ ih₁ ih₂ =>
      obtain ⟨w₁, hw₁⟩ := ih₁
      obtain ⟨w₂, hw₂⟩ := ih₂
      exact ⟨w₁ + w₂, by rw [add_sub_add_comm, hw₁, hw₂, add_mul]⟩
    | @mul a b a' b' _ _ ih₁ ih₂ =>
      -- `a a' - b b' = (a - b) a' + b (a' - b')`, and `g` commutes with `a'`.
      obtain ⟨w₁, hw₁⟩ := ih₁
      obtain ⟨w₂, hw₂⟩ := ih₂
      refine ⟨w₁ * a' + b * w₂, ?_⟩
      rw [show a * a' - b * b' = (a - b) * a' + b * (a' - b') by rw [sub_mul, mul_sub]; abel,
        hw₁, hw₂,
        mul_assoc, hg, add_mul, mul_assoc, mul_assoc]
  · rw [← sub_eq_zero, ← map_sub, hw, map_mul]
    simp [g]

end CentralQuotient

section Field

namespace CentralQuotient

variable {K : Type u} {L : Type v} [Field K] [LieRing L] [LieAlgebra K L] {z : L} {c : K}

/-- **Degree-one elements of the quotient.** Over a field, for central nonzero `z`, the image of
`x : L` is the scalar `a` exactly when `x = r • z` and `a = r * c` for some scalar `r`. This is
the Poincaré--Birkhoff--Witt theorem in degree at most one. -/
theorem ι_eq_algebraMap_iff (hz : z ∈ center K L) (hz₀ : z ≠ 0) {x : L} {a : K} :
    ι z c x = algebraMap K _ a ↔ ∃ r : K, x = r • z ∧ a = r * c := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · -- The span of `z` is an abelian Lie subalgebra with a character sending `z` to `c`.
    obtain ⟨f, hf⟩ := Module.Projective.exists_dual_eq_one K hz₀
    have hlie {y y' : L} (hy : y ∈ K ∙ z) (hy' : y' ∈ K ∙ z) : ⁅y, y'⁆ = 0 := by
      obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.1 hy
      obtain ⟨s, rfl⟩ := Submodule.mem_span_singleton.1 hy'
      simp
    let B : LieSubalgebra K L :=
      { K ∙ z with
        lie_mem' := fun {y y'} hy hy' ↦ by
          rw [hlie hy hy']
          exact (K ∙ z).zero_mem }
    let χ : LieCharacter K B :=
      { toLinearMap := c • f ∘ₗ (B : Submodule K L).subtype
        map_lie' := fun {y y'} ↦ by
          have hyy : ⁅y, y'⁆ = 0 := Subtype.ext (hlie y.2 y'.2)
          simp only [hyy, AddHom.toFun_eq_coe, LinearMap.coe_toAddHom, map_zero]
          rw [LieRing.of_associative_ring_bracket, mul_comm, sub_self] }
    have hχ (r : K) (hr : r • z ∈ B) : χ ⟨r • z, hr⟩ = r * c := by
      -- `χ` is a local definition; `simp` cannot see through its value on the subtype `B`.
      change c • f (r • z) = r * c
      rw [map_smul, hf, smul_eq_mul, smul_eq_mul, mul_one, mul_comm]
    have hzB : z ∈ B := Submodule.mem_span_singleton_self z
    have hχz : χ ⟨z, hzB⟩ = c := by simpa using hχ 1 (by simpa using hzB)
    have h' : mk z c (_root_.UniversalEnvelopingAlgebra.ι K x) = mk z c (algebraMap K _ a) := by
      rw [AlgHom.commutes]
      exact h
    obtain ⟨w, hw⟩ := (mk_eq_mk_iff c hz).1 h'
    have hmem := (ι_sub_algebraMap_mem_span_range_ι_sub_algebraMap_iff χ (x := x) (a := a)).1 <| by
      rw [hw]
      refine Submodule.smul_mem _ w (Submodule.subset_span ⟨⟨z, hzB⟩, ?_⟩)
      dsimp only
      rw [hχz]
    obtain ⟨⟨y, hy⟩, rfl, rfl⟩ := hmem
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.1 hy
    exact ⟨r, rfl, hχ r hy⟩
  · rintro ⟨r, rfl, rfl⟩
    rw [map_smul, ι_self, Algebra.smul_def, map_mul]

/-- Over a field, for central nonzero `z`, the scalars embed in the quotient; in particular the
quotient is nontrivial. -/
theorem algebraMap_injective (hz : z ∈ center K L) (hz₀ : z ≠ 0) :
    Function.Injective (algebraMap K (CentralQuotient K z c)) := by
  intro a b hab
  obtain ⟨r, hr, hab'⟩ := (ι_eq_algebraMap_iff hz hz₀ (c := c) (x := 0) (a := a - b)).1 <| by
    rw [map_zero, map_sub, hab, sub_self]
  obtain rfl : r = 0 := by simpa [hz₀] using hr.symm
  simpa [sub_eq_zero] using hab'

end CentralQuotient

end Field

end TauCeti.UniversalEnvelopingAlgebra
