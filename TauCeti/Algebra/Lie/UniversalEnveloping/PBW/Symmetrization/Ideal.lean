/-!
# Symmetrization and the enveloping ideal of a Lie ideal

Let `K` be a Lie ideal of a Lie algebra `L` over a commutative `ℚ`-algebra `R`. The ideal of `U(L)`
generated by `ι K` is contained in the image under PBW symmetrization of the ideal of `Sym(L)`
generated by `K`
(`TauCeti.UniversalEnvelopingAlgebra.envelopingIdeal_le_map_symmetrization`). No freeness of `L`
is assumed, and the argument does not use injectivity of symmetrization.

This is the comparison needed to pass symmetrization to the quotient Lie algebra `L / K`: the
kernel of `U(L) → U(L / K)` is the ideal generated by `ι K`, so every element of it is the
symmetrization of an element of the kernel of `Sym(L) → Sym(L / K)`.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.envelopingIdeal_le_map_symmetrization`: every element of the
  enveloping ideal of `K` is the symmetrization of an element of the ideal generated by `K` in the
  symmetric algebra.
-/

public section

open scoped Pointwise

namespace TauCeti.UniversalEnvelopingAlgebra

open TauCeti.SymmetricAlgebra

universe u v

variable {R : Type u} {L : Type v} [CommRing R] [LieRing L] [LieAlgebra R L]

attribute [local instance 100] LieRing.ofAssociativeRing

local notation "U" => _root_.UniversalEnvelopingAlgebra R L
local notation "ι" => _root_.UniversalEnvelopingAlgebra.ι R (L := L)

/-- The span of products of an element of PBW degree at most `j` with a letter of the Lie ideal
`K`, that is, of words of PBW degree at most `j + 1` ending in a letter of `K`. -/
private def idealStep (K : LieIdeal R L) (j : ℕ) : Submodule R U :=
  pbwFiltration R L j * (K : Submodule R L).map (ι : L →ₗ⁅R⁆ U).toLinearMap

private theorem ι_mem_idealStep_zero (K : LieIdeal R L) {k : L} (hk : k ∈ K) :
    ι k ∈ idealStep K 0 := by
  rw [idealStep, pbwFiltration_zero]
  simpa using Submodule.mul_mem_mul (Submodule.one_le.1 le_rfl)
    (Submodule.mem_map_of_mem (f := (ι : L →ₗ⁅R⁆ U).toLinearMap) hk)

private theorem idealStep_mono (K : LieIdeal R L) : Monotone (idealStep K) :=
  fun _ _ h => mul_le_mul' (pbwFiltration_mono R L h) le_rfl

private theorem mul_mem_idealStep (K : LieIdeal R L) {a j : ℕ} {c y : U}
    (hc : c ∈ pbwFiltration R L a) (hy : y ∈ idealStep K j) :
    c * y ∈ idealStep K (a + j) := by
  rw [idealStep, ← pbwFiltration_mul, mul_assoc]
  exact Submodule.mul_mem_mul hc (by simpa only [idealStep] using hy)

/-- Commuting a power of `ι x` past a letter of `K` stays inside the lower step. -/
private theorem pow_mul_sub_mul_pow_mem (K : LieIdeal R L) (x : L) (c : ℕ) :
    ∀ k ∈ K, ι x ^ (c + 1) * ι k - ι k * ι x ^ (c + 1) ∈ idealStep K c := by
  induction c with
  | zero =>
    intro k hk
    have h : ι x ^ (0 + 1) * ι k - ι k * ι x ^ (0 + 1) = ι ⁅x, k⁆ := by
      rw [LieHom.map_lie, Ring.lie_def]; simp
    rw [h]
    exact ι_mem_idealStep_zero K (K.lie_mem hk)
  | succ c ih =>
    intro k hk
    have hk' : ⁅x, k⁆ ∈ K := K.lie_mem hk
    have hx : ι x ∈ pbwFiltration R L 1 := ι_mem_pbwFiltration_one R L x
    have h1 : ι x * (ι x ^ (c + 1) * ι k - ι k * ι x ^ (c + 1)) ∈ idealStep K (c + 1) := by
      have := mul_mem_idealStep K hx (ih k hk)
      rwa [add_comm 1 c] at this
    have h2 : ι x ^ (c + 1) * ι ⁅x, k⁆ ∈ idealStep K (c + 1) := by
      refine Submodule.mul_mem_mul (ι_pow_mem_pbwFiltration R L x (c + 1)) ?_
      exact Submodule.mem_map_of_mem (f := (ι : L →ₗ⁅R⁆ U).toLinearMap) hk'
    have h3 := idealStep_mono K (Nat.le_succ c) (ih _ hk')
    have := add_mem h1 (sub_mem h2 h3)
    convert this using 1
    rw [LieHom.map_lie, Ring.lie_def, pow_succ' (ι x) (c + 1)]
    generalize ι x ^ (c + 1) = A
    noncomm_ring

/-- The word of the permutation `σ` applied to the letters `k, x, …, x` has `ι k` in position
`σ⁻¹ 0` and `ι x` elsewhere. -/
private theorem prod_ofFn_cons_perm (x k : L) (b : ℕ) (σ : Equiv.Perm (Fin (b + 2))) :
    (List.ofFn fun i => ι ((Fin.cons k fun _ => x : Fin (b + 2) → L) (σ i))).prod =
      ι x ^ (σ.symm 0 : ℕ) * ι k * ι x ^ (b + 1 - σ.symm 0) := by
  have : (fun i => ι ((Fin.cons k fun _ => x : Fin (b + 2) → L) (σ i))) =
      fun i => if i = σ.symm 0 then ι k else ι x := by
    funext i
    by_cases h : i = σ.symm 0
    · subst h; simp
    · have : σ i ≠ 0 := fun h' => h (by rw [← h']; simp)
      obtain ⟨j, hj⟩ := Fin.exists_succ_eq.2 this
      rw [← hj]; simp [h]
  rw [this, List.prod_ofFn_ite]

section Symmetrization

variable [Algebra ℚ R]

/-- Symmetrizing `k * x ^ (b + 1)` averages the `b + 2` positions of the letter `k` among the
`x`'s. -/
private theorem natCast_smul_pbwSymmetrizationMap_mul_pow (x k : L) (b : ℕ) :
    ((b + 2 : ℕ) : R) • pbwSymmetrizationMap R L
        (SymmetricAlgebra.ι R L k * SymmetricAlgebra.ι R L x ^ (b + 1)) =
      ∑ p ∈ Finset.range (b + 2), ι x ^ p * ι k * ι x ^ (b + 1 - p) := by
  have hprod : ∏ i : Fin (b + 2),
      SymmetricAlgebra.ι R L ((Fin.cons k fun _ => x : Fin (b + 2) → L) i) =
        SymmetricAlgebra.ι R L k * SymmetricAlgebra.ι R L x ^ (b + 1) := by
    rw [Fin.prod_univ_succ]; simp
  have hs := pbwSymmetrizationMap_prod_ι R L (b + 2) (Fin.cons k fun _ => x)
  rw [hprod] at hs
  rw [hs]
  simp only [prod_ofFn_cons_perm]
  rw [Equiv.Perm.sum_comp_symm_apply_zero
    (fun p : Fin (b + 2) => ι x ^ (p : ℕ) * ι k * ι x ^ (b + 1 - p)),
    ← Fin.sum_univ_eq_sum_range (fun p => ι x ^ p * ι k * ι x ^ (b + 1 - p)) (b + 2),
    smul_smul, ← Nat.cast_smul_eq_nsmul R, smul_smul]
  have hq : ((b + 2 : ℕ) : ℚ) * (((b + 2).factorial : ℚ)⁻¹ * ((b + 1).factorial : ℚ)) = 1 := by
    have h2 : ((b + 2).factorial : ℚ) = (b + 2) * (b + 1).factorial := by
      rw [Nat.factorial_succ]; push_cast; ring
    have h1 : ((b + 1).factorial : ℚ) ≠ 0 := by positivity
    have h3 : ((b : ℚ) + 2) ≠ 0 := by positivity
    rw [h2]
    push_cast
    field_simp
  have hscalar : ((b + 2 : ℕ) : R) * (algebraMap ℚ R (((b + 2).factorial : ℚ)⁻¹) *
      ((b + 1).factorial : ℕ)) = 1 := by
    have := congrArg (algebraMap ℚ R) hq
    simpa only [map_mul, map_natCast, map_one] using this
  rw [mul_assoc, hscalar, one_smul]

/-- The image under symmetrization of the ideal of `Sym(L)` generated by `K`. -/
private noncomputable def symmetrizedIdeal (K : LieIdeal R L) : Submodule R U :=
  (Ideal.span (SymmetricAlgebra.ι R L '' (K : Set L))).restrictScalars R |>.map
    (pbwSymmetrizationMap R L)

private theorem ι_mul_pow_mem_symmetrizedIdeal (K : LieIdeal R L) {k : L} (hk : k ∈ K)
    (x : L) (a : ℕ) :
    pbwSymmetrizationMap R L (SymmetricAlgebra.ι R L k * SymmetricAlgebra.ι R L x ^ a) ∈
      symmetrizedIdeal K := by
  refine Submodule.mem_map_of_mem (f := pbwSymmetrizationMap R L) ?_
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨k, hk, rfl⟩)

/-- Averaging the position of the letter `k ∈ K` among `b + 1` copies of `x` changes
`ι x ^ (b + 1) * ι k` by an element of the lower step, after clearing the denominator. -/
private theorem natCast_smul_sub_mem_idealStep (K : LieIdeal R L) {k : L} (hk : k ∈ K)
    (x : L) (b : ℕ) :
    ((b + 2 : ℕ) : R) • (ι x ^ (b + 1) * ι k - pbwSymmetrizationMap R L
      (SymmetricAlgebra.ι R L k * SymmetricAlgebra.ι R L x ^ (b + 1))) ∈ idealStep K b := by
  rw [smul_sub, natCast_smul_pbwSymmetrizationMap_mul_pow]
  have hconst : ((b + 2 : ℕ) : R) • (ι x ^ (b + 1) * ι k) =
      ∑ _p ∈ Finset.range (b + 2), ι x ^ (b + 1) * ι k := by
    rw [Finset.sum_const, Finset.card_range, Nat.cast_smul_eq_nsmul]
  rw [hconst, ← Finset.sum_sub_distrib]
  refine Submodule.sum_mem _ fun p hp => ?_
  obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_le (Nat.lt_succ_iff.1 (Finset.mem_range.1 hp))
  cases c with
  | zero =>
    obtain rfl : p = b + 1 := by omega
    simp only [Nat.sub_self, pow_zero, mul_one, sub_self]
    exact Submodule.zero_mem _
  | succ c =>
    have hbc : b + 1 - p = c + 1 := by omega
    have heq : ι x ^ (b + 1) * ι k - ι x ^ p * ι k * ι x ^ (b + 1 - p) =
        ι x ^ p * (ι x ^ (c + 1) * ι k - ι k * ι x ^ (c + 1)) := by
      rw [hbc, mul_sub, ← mul_assoc, ← mul_assoc, ← pow_add,
        show b + 1 = p + (c + 1) by omega]
    rw [heq]
    have := mul_mem_idealStep K (ι_pow_mem_pbwFiltration R L x p)
      (pow_mul_sub_mul_pow_mem K x c k hk)
    rwa [show p + c = b by omega] at this

/-- The products of an element of PBW degree at most `j` with a letter of `K` are symmetrizations
of elements of the ideal generated by `K`. -/
private theorem idealStep_le_symmetrizedIdeal (K : LieIdeal R L) (j : ℕ) :
    idealStep K j ≤ symmetrizedIdeal K := by
  -- Polarization reduces this to the monomials `ι x ^ (b + 1) * ι k` with `k ∈ K`: averaging the
  -- position of `k` among the `x`'s changes such a monomial by terms
  -- `ι x ^ p * (ι x ^ (c + 1) * ι k - ι k * ι x ^ (c + 1))`, which lie in a lower `idealStep`.
  induction j using Nat.strong_induction_on with
  | _ j ih =>
    refine Submodule.mul_le.2 fun m hm n hn => ?_
    obtain ⟨k, hk, hkn⟩ := hn
    obtain rfl : n = ι k := hkn.symm
    have hm' := pbwFiltration_le_span_pow R L j hm
    clear hm
    induction hm' using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨x, a, haj, rfl⟩ := hy
      cases a with
      | zero => simpa using ι_mul_pow_mem_symmetrizedIdeal K hk x 0
      | succ b =>
        have hu : IsUnit ((b + 2 : ℕ) : R) := by
          have : IsUnit (((b + 2 : ℕ) : ℚ)) := isUnit_iff_ne_zero.2 (by positivity)
          have h : IsUnit (algebraMap ℚ R (((b + 2 : ℕ) : ℚ))) := this.map (algebraMap ℚ R)
          rwa [map_natCast (algebraMap ℚ R)] at h
        have hδ := (Submodule.smul_mem_iff_of_isUnit _ hu).1
          (ih b (by omega) (natCast_smul_sub_mem_idealStep K hk x b))
        simpa only [sub_add_cancel] using
          add_mem hδ (ι_mul_pow_mem_symmetrizedIdeal K hk x (b + 1))
    | zero => simp
    | add y z _ _ hy hz => rw [add_mul]; exact add_mem hy hz
    | smul r y _ hy => rw [smul_mul_assoc]; exact Submodule.smul_mem _ r hy

/-- **The enveloping ideal of a Lie ideal lies in the symmetrization of the ideal generated by it.**
Let `K` be a Lie ideal of a Lie algebra `L` over a commutative `ℚ`-algebra. Every element of the
ideal of `U(L)` generated by `K` is the PBW symmetrization of an element of the ideal of `Sym(L)`
generated by `K`. No freeness of `L` is needed. -/
theorem envelopingIdeal_le_map_symmetrization (K : LieIdeal R L) :
    K.envelopingIdeal.restrictScalars R ≤
      ((Ideal.span (SymmetricAlgebra.ι R L '' (K : Set L))).restrictScalars R).map
        (pbwSymmetrizationMap R L) := by
  intro u hu
  let I : Ideal U :=
    { carrier := {u | ∃ j, u ∈ idealStep K j}
      add_mem' := by
        rintro y z ⟨i, hi⟩ ⟨j, hj⟩
        exact ⟨max i j, add_mem (idealStep_mono K (le_max_left i j) hi)
          (idealStep_mono K (le_max_right i j) hj)⟩
      zero_mem' := ⟨0, Submodule.zero_mem _⟩
      smul_mem' := by
        rintro c y ⟨j, hj⟩
        obtain ⟨a, ha⟩ := exists_mem_pbwFiltration R L c
        exact ⟨a + j, mul_mem_idealStep K ha hj⟩ }
  have hex : u ∈ I :=
    (LieIdeal.envelopingIdeal_le_iff (J := I)).2
      (fun k hk => (⟨0, ι_mem_idealStep_zero K hk⟩ : ∃ j, ι k ∈ idealStep K j)) hu
  obtain ⟨j, hj⟩ := hex
  exact idealStep_le_symmetrizedIdeal K j hj

end Symmetrization

end TauCeti.UniversalEnvelopingAlgebra
