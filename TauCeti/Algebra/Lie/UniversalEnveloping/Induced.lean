module

public import Mathlib.Algebra.Lie.Character
public import TauCeti.Algebra.Lie.UniversalEnveloping.Functoriality
public import TauCeti.LinearAlgebra.TensorProduct.Balanced.Actions
import TauCeti.Algebra.Lie.UniversalEnveloping.PBW.Character

/-!
# Modules induced from a character, as balanced tensor products

Let `B` be a Lie subalgebra of a Lie algebra `L` over a commutative ring `R`, and let `χ` be a
character of `B`. The module induced from the `B`-module `R_χ` (the ring `R` with `B` acting
through `χ`) is classically the tensor product `U(L) ⊗_{U(B)} R_χ` over the noncommutative ring
`U(B)`. Elsewhere it is presented without tensor products, as the quotient of `U(L)` by the left
ideal generated by the elements `ι x - χ x` for `x : B`
(`TauCeti/Algebra/Lie/UniversalEnveloping/PBW/Character.lean`). This file identifies the two.

The tensor product is Tau Ceti's `TauCeti.BalancedTensorProduct` over the ground ring `R`, for the
following actions of `U(B)`:

* `U(L)` is a right `U(B)`-module through the algebra map `U(B) → U(L)` induced by the inclusion
  of `B` (`LieSubalgebra.envelopingRightModule`);
* `R` is a left `U(B)`-module through the algebra map `U(B) → R` extending `χ`
  (`LieAlgebra.LieCharacter.envelopingModule`).

Left multiplication on the first factor makes the balanced tensor product a left `U(L)`-module.
The comparison `LieSubalgebra.balancedTensorProductEquivQuotient` is a `U(L)`-linear equivalence
sending `u ⊗ a` to the class of `a • u`, so `1 ⊗ 1` goes to the class of `1`; its inverse sends
the class of `u` to `u ⊗ 1`. It holds over every commutative ring and for every Lie subalgebra.
No Poincaré--Birkhoff--Witt input and no nonvanishing of the induced module is used, so the
comparison is valid even when the left ideal is all of `U(L)` and both sides vanish.

The module structures above are definitions rather than global instances: `envelopingModule`
depends on `χ`, so several of them can live on the same ring. Install
`LieSubalgebra.envelopingRightModule`, `LieSubalgebra.smulCommClass_envelopingRightModule` and
`TauCeti.BalancedTensorProduct.leftModule` with `attribute [local instance]`, and introduce the
action on `R` for a chosen character with `letI := χ.envelopingModule`.

## Main definitions

* `LieAlgebra.LieCharacter.envelopingModule`: for a character `χ` of any Lie algebra `L'`, the
  `U(L')`-module `R` on which `U(L')` acts through `χ`.
* `LieSubalgebra.envelopingRightModule`: `U(L)` as a right `U(B)`-module.
* `LieSubalgebra.balancedTensorProductEquivQuotient`: the comparison
  `U(L) ⊗_{U(B)} R_χ ≃ U(L) ⧸ U(L) {ι x - χ x | x : B}` of left `U(L)`-modules.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §20.3.
* J. Dixmier, *Enveloping Algebras*, §5.1.
-/

public section

open MulOpposite

attribute [local instance 100] LieRing.ofAssociativeRing

universe u v

namespace LieAlgebra.LieCharacter

variable {R : Type u} {L' : Type v} [CommRing R] [LieRing L'] [LieAlgebra R L']
  (χ' : LieCharacter R L')

/-- The **`U(L')`-module `R` of a character `χ'`** of a Lie algebra `L'`: an element `r` of `U(L')`
acts on `R` by multiplication by the value at `r` of the algebra map `U(L') → R` extending `χ'`. -/
@[instance_reducible]
noncomputable def envelopingModule : Module (UniversalEnvelopingAlgebra R L') R :=
  Module.compHom R (UniversalEnvelopingAlgebra.lift R χ').toRingHom

/-- The action of `U(L')` on `R` through `χ'` is multiplication by the value of the character. -/
@[simp]
theorem smul_eq_lift_mul (r : UniversalEnvelopingAlgebra R L') (a : R) :
    letI := χ'.envelopingModule
    r • a = UniversalEnvelopingAlgebra.lift R χ' r * a :=
  (rfl)

/-- The action of `U(L')` on `R` through `χ'` is compatible with the ground ring. -/
theorem isScalarTower_envelopingModule :
    letI := χ'.envelopingModule
    IsScalarTower R (UniversalEnvelopingAlgebra R L') R :=
  letI := χ'.envelopingModule
  ⟨fun c r a ↦ by simp [mul_assoc]⟩

end LieAlgebra.LieCharacter

namespace LieSubalgebra

open LieAlgebra TauCeti

variable {R : Type u} {L : Type v} [CommRing R] [LieRing L] [LieAlgebra R L]
  (B : LieSubalgebra R L) (χ : LieCharacter R B)

local notation "U" => _root_.UniversalEnvelopingAlgebra R L
local notation "UB" => _root_.UniversalEnvelopingAlgebra R B

/-- The universal enveloping algebra `U(L)` as a **right module over `U(B)`**, for a Lie
subalgebra `B`: an element `r` of `U(B)` acts by right multiplication by its image under the
algebra map `U(B) → U(L)` induced by the inclusion of `B`. -/
@[instance_reducible]
noncomputable def envelopingRightModule : Module UBᵐᵒᵖ U :=
  Module.compHom U (RingHom.op (UniversalEnvelopingAlgebra.map R B.incl).toRingHom)

section Smul

attribute [local instance] envelopingRightModule

/-- The right action of `U(B)` on `U(L)` is right multiplication by the image of `r`. -/
@[simp]
theorem smul_eq_mul_map_unop (r : UBᵐᵒᵖ) (w : U) :
    r • w = w * UniversalEnvelopingAlgebra.map R B.incl r.unop :=
  (rfl)

/-- The right action of `op r` on `U(L)` is right multiplication by the image of `r`. -/
theorem op_smul_eq_mul_map (r : UB) (w : U) :
    op r • w = w * UniversalEnvelopingAlgebra.map R B.incl r :=
  (rfl)

/-- Left multiplication in `U(L)` commutes with the right action of `U(B)`. -/
theorem smulCommClass_envelopingRightModule : SMulCommClass U UBᵐᵒᵖ U where
  smul_comm w r w' := by simp [mul_assoc]

/-- The right action of `U(B)` on `U(L)` is compatible with the ground ring. -/
theorem isScalarTower_envelopingRightModule : IsScalarTower R UBᵐᵒᵖ U where
  smul_assoc c r w := by simp

end Smul

attribute [local instance] envelopingRightModule smulCommClass_envelopingRightModule
attribute [local instance] BalancedTensorProduct.leftModule

local notation "I" => Submodule.span U (Set.range fun x : B ↦
  _root_.UniversalEnvelopingAlgebra.ι R (x : L) - algebraMap R U (χ x))

/-- The balanced bilinear map `u ⊗ a ↦ [a • u]` underlying the comparison. -/
private noncomputable def toQuotientBilin : U →ₗ[R] R →ₗ[R] U ⧸ I :=
  (LinearMap.lsmul R U).flip.compr₂ ((I).mkQ.restrictScalars R)

private theorem toQuotientBilin_apply (w : U) (a : R) :
    toQuotientBilin B χ w a = Submodule.Quotient.mk (a • w) :=
  (rfl)

/-- Modulo the left ideal, right multiplication by the image of `r ∈ U(B)` is multiplication by
the scalar `χ r`. -/
private theorem mk_mul_map (w : U) (r : UB) :
    (Submodule.Quotient.mk (w * UniversalEnvelopingAlgebra.map R B.incl r) : U ⧸ I) =
      Submodule.Quotient.mk (_root_.UniversalEnvelopingAlgebra.lift R χ r • w) := by
  rw [Submodule.Quotient.eq, Algebra.smul_def, Algebra.commutes, ← mul_sub]
  exact Submodule.smul_mem _ w
    (_root_.UniversalEnvelopingAlgebra.map_sub_algebraMap_lift_mem_span_range_ι_sub_algebraMap
      B χ r)

/-- The comparison map `u ⊗ a ↦ [a • u]`, as a `U(L)`-linear map. -/
private noncomputable def toQuotient :
    letI := χ.envelopingModule
    BalancedTensorProduct R UB U R →ₗ[U] U ⧸ I where
  __ := letI := χ.envelopingModule
    BalancedTensorProduct.lift (toQuotientBilin B χ) fun r w a ↦ by
      rw [toQuotientBilin_apply, toQuotientBilin_apply, op_smul_eq_mul_map,
        LieCharacter.smul_eq_lift_mul, Submodule.Quotient.mk_smul, mk_mul_map,
        ← Submodule.Quotient.mk_smul, smul_smul, mul_comm a]
  map_smul' w z := letI := χ.envelopingModule
    BalancedTensorProduct.lift_smul_left U _ _
      (fun w w' a ↦ by
        rw [toQuotientBilin_apply, toQuotientBilin_apply, ← Submodule.Quotient.mk_smul,
          smul_eq_mul, smul_eq_mul, mul_smul_comm]) w z

private theorem toQuotient_tmul (w : U) (a : R) :
    letI := χ.envelopingModule
    toQuotient B χ (BalancedTensorProduct.tmul R UB w a) =
      Submodule.Quotient.mk (a • w) := by
  let := χ.envelopingModule
  exact BalancedTensorProduct.lift_tmul (toQuotientBilin B χ) _ w a

/-- The inverse comparison map `[u] ↦ u ⊗ 1`: the left ideal annihilates `1 ⊗ 1`. -/
private noncomputable def ofQuotient :
    letI := χ.envelopingModule
    U ⧸ I →ₗ[U] BalancedTensorProduct R UB U R :=
  letI := χ.envelopingModule
  (I).liftQ (LinearMap.toSpanSingleton U _ (BalancedTensorProduct.tmul R UB 1 1)) <| by
    rw [Submodule.span_le]
    rintro _ ⟨x, rfl⟩
    have hι : (_root_.UniversalEnvelopingAlgebra.ι R (x : L) : U) =
        op (_root_.UniversalEnvelopingAlgebra.ι R x : UB) • (1 : U) := by
      rw [op_smul_eq_mul_map, one_mul, UniversalEnvelopingAlgebra.map_ι, coe_incl]
    simp only [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, sub_smul,
      BalancedTensorProduct.smul_tmul_left, smul_eq_mul, mul_one, sub_eq_zero]
    rw [hι, BalancedTensorProduct.balance, Algebra.algebraMap_eq_smul_one]
    simp [← BalancedTensorProduct.tmul_smul]

private theorem ofQuotient_mk (w : U) :
    letI := χ.envelopingModule
    ofQuotient B χ (Submodule.Quotient.mk w) = BalancedTensorProduct.tmul R UB w 1 := by
  simp [ofQuotient]

/-- **The induced module as a balanced tensor product.** For a Lie subalgebra `B` of `L` and a
character `χ` of `B`, the tensor product `U(L) ⊗_{U(B)} R_χ` is isomorphic, as a left
`U(L)`-module, to the quotient of `U(L)` by the left ideal generated by the elements `ι x - χ x`
for `x : B`. The isomorphism sends `u ⊗ a` to the class of `a • u`
(`balancedTensorProductEquivQuotient_tmul`), and its inverse sends the class of `u` to `u ⊗ 1`
(`balancedTensorProductEquivQuotient_symm_mk`). -/
noncomputable def balancedTensorProductEquivQuotient :
    letI := χ.envelopingModule
    BalancedTensorProduct R UB U R ≃ₗ[U] U ⧸ I where
  __ := toQuotient B χ
  invFun := ofQuotient B χ
  left_inv z := by
    let := χ.envelopingModule
    induction z using BalancedTensorProduct.induction_on with
    | ht w a =>
      rw [LinearMap.toFun_eq_coe, toQuotient_tmul, ofQuotient_mk,
        BalancedTensorProduct.smul_tmul, ← BalancedTensorProduct.tmul_smul, smul_eq_mul, mul_one]
    | ha z z' hz hz' => simp only [LinearMap.toFun_eq_coe, map_add] at hz hz' ⊢; rw [hz, hz']
  right_inv q := by
    induction q using Submodule.Quotient.induction_on with
    | H w => rw [ofQuotient_mk, LinearMap.toFun_eq_coe, toQuotient_tmul, one_smul]

/-- The comparison sends `u ⊗ a` to the class of `a • u`. -/
@[simp]
theorem balancedTensorProductEquivQuotient_tmul (w : U) (a : R) :
    letI := χ.envelopingModule
    balancedTensorProductEquivQuotient B χ (BalancedTensorProduct.tmul R UB w a) =
      Submodule.Quotient.mk (a • w) :=
  toQuotient_tmul B χ w a

/-- The inverse comparison sends the class of `u` to `u ⊗ 1`. -/
@[simp]
theorem balancedTensorProductEquivQuotient_symm_mk (w : U) :
    letI := χ.envelopingModule
    (balancedTensorProductEquivQuotient B χ).symm (Submodule.Quotient.mk w) =
      BalancedTensorProduct.tmul R UB w 1 :=
  ofQuotient_mk B χ w

end LieSubalgebra
