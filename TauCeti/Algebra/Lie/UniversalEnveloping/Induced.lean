module

public import Mathlib.Algebra.Lie.Character
public import TauCeti.Algebra.Lie.UniversalEnveloping.Functoriality
public import TauCeti.LinearAlgebra.TensorProduct.Balanced.Extension
import TauCeti.Algebra.Lie.UniversalEnveloping.PBW.Character

/-!
# Modules induced from a character, as extensions of scalars

Let `B` be a Lie subalgebra of a Lie algebra `L` over a commutative ring `R`, and let `χ` be a
character of `B`. The module induced from the `B`-module `R_χ` (the ring `R` with `B` acting
through `χ`) is classically the tensor product `U(L) ⊗_{U(B)} R_χ` over the noncommutative ring
`U(B)`. Elsewhere it is presented without tensor products, as the quotient of `U(L)` by the left
ideal generated by the elements `ι x - χ x` for `x : B`
(`TauCeti/Algebra/Lie/UniversalEnveloping/PBW/Character.lean`). This file identifies the two.

The tensor product is the extension of scalars `TauCeti.BalancedExtension` of the left
`U(B)`-module `R_χ` along the algebra map `U(B) → U(L)` induced by the inclusion of `B`; the
action of `U(B)` on `R` is through the algebra map `U(B) → R` extending `χ`
(`LieAlgebra.LieCharacter.envelopingModule`). Left multiplication on the first factor makes it a
left `U(L)`-module.

The comparison `LieSubalgebra.balancedExtensionEquivQuotient` is a `U(L)`-linear equivalence
sending `u ⊗ a` to the class of `a • u`, so `1 ⊗ 1` goes to the class of `1`; its inverse sends
the class of `u` to `u ⊗ 1`. It is obtained from the universal property of extension of scalars
(`TauCeti.BalancedExtension.lift`). It holds over every commutative ring and for every Lie
subalgebra. No Poincaré--Birkhoff--Witt input and no nonvanishing of the induced module is used,
so the comparison is valid even when the left ideal is all of `U(L)` and both sides vanish.

The module structure on `R` is a definition rather than a global instance: `envelopingModule`
depends on `χ`, so several of them can live on the same ring. Introduce it for a chosen character
with `letI := χ.envelopingModule`.

## Main definitions

* `LieAlgebra.LieCharacter.envelopingModule`: for a character `χ` of any Lie algebra `L'`, the
  `U(L')`-module `R` on which `U(L')` acts through `χ`.
* `LieSubalgebra.balancedExtensionEquivQuotient`: the comparison
  `U(L) ⊗_{U(B)} R_χ ≃ U(L) ⧸ U(L) {ι x - χ x | x : B}` of left `U(L)`-modules.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §20.3.
* J. Dixmier, *Enveloping Algebras*, §5.1.
-/

public section

attribute [local instance 100] LieRing.ofAssociativeRing

universe u v

namespace LieAlgebra.LieCharacter

variable {R : Type u} {L' : Type v} [CommRing R] [LieRing L'] [LieAlgebra R L']
  (χ' : LieCharacter R L')

/-- The **`U(L')`-module `R` of a character `χ'`** of a Lie algebra `L'`: an element `r` of `U(L')`
acts on `R` by multiplication by the value at `r` of the algebra map `U(L') → R` extending `χ'`. -/
@[instance_reducible]
noncomputable def envelopingModule : Module (UniversalEnvelopingAlgebra R L') R :=
  Module.compHom R (UniversalEnvelopingAlgebra.lift R χ').toRingHom

/-- The action of `U(L')` on `R` through `χ'` is multiplication by the value of the character. -/
@[simp]
theorem smul_eq_lift_mul (r : UniversalEnvelopingAlgebra R L') (a : R) :
    letI := χ'.envelopingModule
    r • a = UniversalEnvelopingAlgebra.lift R χ' r * a :=
  (rfl)

/-- The action of `U(L')` on `R` through `χ'` is compatible with the ground ring. -/
theorem isScalarTower_envelopingModule :
    letI := χ'.envelopingModule
    IsScalarTower R (UniversalEnvelopingAlgebra R L') R :=
  letI := χ'.envelopingModule
  ⟨fun c r a ↦ by simp [mul_assoc]⟩

end LieAlgebra.LieCharacter

namespace LieSubalgebra

open LieAlgebra TauCeti

variable {R : Type u} {L : Type v} [CommRing R] [LieRing L] [LieAlgebra R L]
  (B : LieSubalgebra R L) (χ : LieCharacter R B)

local notation "U" => _root_.UniversalEnvelopingAlgebra R L
local notation "UB" => _root_.UniversalEnvelopingAlgebra R B
local notation "Φ" => RingHomClass.toRingHom (UniversalEnvelopingAlgebra.map R B.incl)

local notation "I" => Submodule.span U (Set.range fun x : B ↦
  _root_.UniversalEnvelopingAlgebra.ι R (x : L) - algebraMap R U (χ x))

/-- Modulo the left ideal, right multiplication by the image of `r ∈ U(B)` is multiplication by
the scalar `χ r`. -/
private theorem mk_mul_map (w : U) (r : UB) :
    (Submodule.Quotient.mk (w * UniversalEnvelopingAlgebra.map R B.incl r) : U ⧸ I) =
      Submodule.Quotient.mk (_root_.UniversalEnvelopingAlgebra.lift R χ r • w) := by
  rw [Submodule.Quotient.eq, Algebra.smul_def, Algebra.commutes, ← mul_sub]
  exact Submodule.smul_mem _ w
    (_root_.UniversalEnvelopingAlgebra.map_sub_algebraMap_lift_mem_span_range_ι_sub_algebraMap
      B χ r)

/-- The semilinear map `a ↦ [a • 1]` from `R_χ` to the quotient, whose extension of scalars is
the comparison. -/
private noncomputable def toQuotientAux :
    letI := χ.envelopingModule
    R →ₛₗ[Φ] U ⧸ I :=
  letI := χ.envelopingModule
  { toFun a := Submodule.Quotient.mk (a • (1 : U))
    map_add' a a' := by rw [add_smul, Submodule.Quotient.mk_add]
    map_smul' r a := by
      rw [LieCharacter.smul_eq_lift_mul, mul_smul, RingHom.coe_coe,
        ← Submodule.Quotient.mk_smul, smul_eq_mul, ← mk_mul_map, smul_mul_assoc, one_mul,
        mul_smul_comm, mul_one] }

private theorem toQuotientAux_apply (a : R) :
    letI := χ.envelopingModule
    toQuotientAux B χ a = Submodule.Quotient.mk (a • (1 : U)) :=
  (rfl)

/-- In the induced module, `Φ r ⊗ 1 = 1 ⊗ χ r` for `r ∈ U(B)`. -/
private theorem tmul_map_one (r : UB) :
    letI := χ.envelopingModule
    BalancedExtension.tmul Φ (UniversalEnvelopingAlgebra.map R B.incl r) (1 : R) =
      BalancedExtension.tmul Φ 1 (_root_.UniversalEnvelopingAlgebra.lift R χ r) := by
  let := χ.envelopingModule
  rw [← mul_one (_root_.UniversalEnvelopingAlgebra.lift R χ r), ← LieCharacter.smul_eq_lift_mul,
    BalancedExtension.tmul_smul, one_mul]
  rfl

/-- The inverse comparison map `[u] ↦ u ⊗ 1`: the left ideal annihilates `1 ⊗ 1`. -/
private noncomputable def ofQuotient :
    letI := χ.envelopingModule
    U ⧸ I →ₗ[U] BalancedExtension Φ R :=
  letI := χ.envelopingModule
  (I).liftQ (LinearMap.toSpanSingleton U _ (BalancedExtension.tmul Φ 1 1)) <| by
    rw [Submodule.span_le]
    rintro _ ⟨x, rfl⟩
    have hx : _root_.UniversalEnvelopingAlgebra.ι R (x : L) - algebraMap R U (χ x) =
        UniversalEnvelopingAlgebra.map R B.incl
          (_root_.UniversalEnvelopingAlgebra.ι R x - algebraMap R UB (χ x)) := by
      rw [map_sub, AlgHom.commutes, UniversalEnvelopingAlgebra.map_ι, coe_incl]
    rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.toSpanSingleton_apply,
      BalancedExtension.smul_tmul, mul_one]
    beta_reduce
    rw [hx, tmul_map_one, map_sub, _root_.UniversalEnvelopingAlgebra.lift_ι_apply, AlgHom.commutes,
      Algebra.algebraMap_self, RingHom.id_apply, sub_self, BalancedExtension.tmul_zero]

private theorem ofQuotient_mk (w : U) :
    letI := χ.envelopingModule
    ofQuotient B χ (Submodule.Quotient.mk w) = BalancedExtension.tmul Φ w 1 := by
  let := χ.envelopingModule
  rw [ofQuotient, Submodule.liftQ_apply, LinearMap.toSpanSingleton_apply,
    BalancedExtension.smul_tmul, mul_one]

/-- **The induced module as an extension of scalars.** For a Lie subalgebra `B` of `L` and a
character `χ` of `B`, the extension of scalars `U(L) ⊗_{U(B)} R_χ` is isomorphic, as a left
`U(L)`-module, to the quotient of `U(L)` by the left ideal generated by the elements `ι x - χ x`
for `x : B`. The isomorphism sends `u ⊗ a` to the class of `a • u`
(`balancedExtensionEquivQuotient_tmul`), and its inverse sends the class of `u` to `u ⊗ 1`
(`balancedExtensionEquivQuotient_symm_mk`). -/
noncomputable def balancedExtensionEquivQuotient :
    letI := χ.envelopingModule
    BalancedExtension Φ R ≃ₗ[U] U ⧸ I :=
  letI := χ.envelopingModule
  LinearEquiv.ofLinearMap (BalancedExtension.lift (toQuotientAux B χ)) (ofQuotient B χ)
    (by
      ext
      rw [LinearMap.comp_apply, LinearMap.comp_apply, Submodule.mkQ_apply, ofQuotient_mk,
        BalancedExtension.lift_tmul, toQuotientAux_apply, one_smul, one_smul, LinearMap.id_comp,
        Submodule.mkQ_apply])
    (BalancedExtension.hom_ext fun a ↦ by
      rw [LinearMap.comp_apply, BalancedExtension.lift_tmul, toQuotientAux_apply, one_smul,
        ofQuotient_mk, Algebra.smul_def, mul_one,
        ← AlgHom.commutes (UniversalEnvelopingAlgebra.map R B.incl), tmul_map_one,
        AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, LinearMap.id_apply])

/-- The comparison sends `u ⊗ a` to the class of `a • u`. -/
@[simp]
theorem balancedExtensionEquivQuotient_tmul (w : U) (a : R) :
    letI := χ.envelopingModule
    balancedExtensionEquivQuotient B χ (BalancedExtension.tmul Φ w a) =
      Submodule.Quotient.mk (a • w) := by
  let := χ.envelopingModule
  rw [balancedExtensionEquivQuotient, LinearEquiv.coe_ofLinearMap, BalancedExtension.lift_tmul,
    toQuotientAux_apply, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_smul_comm, mul_one]

/-- The inverse comparison sends the class of `u` to `u ⊗ 1`. -/
@[simp]
theorem balancedExtensionEquivQuotient_symm_mk (w : U) :
    letI := χ.envelopingModule
    (balancedExtensionEquivQuotient B χ).symm (Submodule.Quotient.mk w) =
      BalancedExtension.tmul Φ w 1 :=
  ofQuotient_mk B χ w

end LieSubalgebra
