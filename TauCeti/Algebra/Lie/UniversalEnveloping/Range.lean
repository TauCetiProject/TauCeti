module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Basic

/-!
# The image of a universal enveloping algebra

A Lie homomorphism `f : L → A` into an associative algebra extends to an algebra homomorphism
`UniversalEnvelopingAlgebra.lift R f : U(L) → A`. Its image is the subalgebra of `A` generated by
the image of `f`, because `U(L)` is generated by its canonical Lie generators. Consequently a
subalgebra contains the whole image as soon as it contains the values of `f`, and an element of `A`
commutes with the whole image as soon as it commutes with the values of `f`.

These are the facts used to study the image of `U(L)` under a representation, such as the
subalgebra of a Clifford algebra generated by a quadratic lift of a Lie action.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.range_lift_eq_adjoin`: the image of `lift R f` is the
  subalgebra generated by the image of `f`.
* `TauCeti.UniversalEnvelopingAlgebra.range_lift_le_iff`: a subalgebra contains the image of
  `lift R f` exactly when it contains every value of `f`.
* `TauCeti.UniversalEnvelopingAlgebra.mem_centralizer_range_lift_iff`: an element centralizes the
  image of `lift R f` exactly when it commutes with every value of `f`.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

variable {R L A : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] [Ring A] [Algebra R A]

variable (R) in
/-- **The image of the lift of a Lie homomorphism** is the subalgebra generated by the image of the
Lie homomorphism, since the canonical Lie generators generate `U(L)`. -/
theorem range_lift_eq_adjoin (f : L →ₗ⁅R⁆ A) :
    (_root_.UniversalEnvelopingAlgebra.lift R f).range = Algebra.adjoin R (Set.range f) := by
  rw [← Algebra.map_top, ← adjoin_range_ι R L, AlgHom.map_adjoin, ← Set.range_comp,
    _root_.UniversalEnvelopingAlgebra.ι_comp_lift]

/-- A subalgebra contains the image of the lift of a Lie homomorphism exactly when it contains
every value of the Lie homomorphism. -/
theorem range_lift_le_iff {f : L →ₗ⁅R⁆ A} {S : Subalgebra R A} :
    (_root_.UniversalEnvelopingAlgebra.lift R f).range ≤ S ↔ ∀ x, f x ∈ S := by
  rw [range_lift_eq_adjoin, Algebra.adjoin_le_iff, Set.range_subset_iff]
  rfl

/-- An element centralizes the image of the lift of a Lie homomorphism exactly when it commutes
with every value of the Lie homomorphism. -/
theorem mem_centralizer_range_lift_iff {f : L →ₗ⁅R⁆ A} {a : A} :
    a ∈ Subalgebra.centralizer R ((_root_.UniversalEnvelopingAlgebra.lift R f).range : Set A) ↔
      ∀ x, f x * a = a * f x := by
  refine ⟨fun h x ↦ h _ ⟨_root_.UniversalEnvelopingAlgebra.ι R x,
    _root_.UniversalEnvelopingAlgebra.lift_ι_apply R f x⟩, fun h ↦ ?_⟩
  -- The centralizer of `{a}` is a subalgebra containing every value of `f`.
  have hle : (_root_.UniversalEnvelopingAlgebra.lift R f).range ≤
      Subalgebra.centralizer R {a} :=
    range_lift_le_iff.2 fun x ↦ (Subalgebra.mem_centralizer_iff R).2 fun b hb ↦ by
      rw [Set.mem_singleton_iff.1 hb, h x]
  exact (Subalgebra.mem_centralizer_iff R).2 fun b hb ↦
    ((Subalgebra.mem_centralizer_iff R).1 (hle hb) a rfl).symm

end TauCeti.UniversalEnvelopingAlgebra
