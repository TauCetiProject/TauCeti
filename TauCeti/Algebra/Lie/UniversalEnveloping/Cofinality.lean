module

public import TauCeti.Algebra.Lie.UniversalEnveloping.DegreeFiltration
public import TauCeti.Algebra.Lie.UniversalEnveloping.PBW.Basic
public import TauCeti.RingTheory.GradedAlgebra.Generators
import TauCeti.RingTheory.Ideal.Operations

/-!
# Cofinality of the degree and augmentation filtrations

Let `L` be a graded Lie algebra with an integral degree `d` and no components of negative degree,
and let `U(L)` carry its total-degree filtration
`TauCeti.UniversalEnvelopingAlgebra.degreeFiltration`. If `L` is generated as a Lie algebra by
homogeneous elements of degree at most `B`, then every element of `U(L)` of filtration order
greater than `B * (k - 1)` lies in the `k`-th power of the augmentation ideal. The generators need
not form a basis or a finite family.

For a grading supported in strictly positive degrees, the reverse inclusion
`TauCeti.UniversalEnvelopingAlgebra.augmentation_pow_le_degreeFiltration` puts the `k`-th
augmentation power in filtration order `k`. Together the two inclusions make the degree
filtration and the augmentation filtration cofinal in each other, so they define the same
completion. For generators of degree one, as in a free Lie algebra graded by word length, the
two filtrations coincide.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.degreeFiltration_le_augmentation_pow`: filtration order
  `B * (k - 1) + 1` lies in the `k`-th augmentation power.
* `TauCeti.UniversalEnvelopingAlgebra.degreeFiltration_eq_augmentation_pow`: for a grading in
  strictly positive degrees generated in degree at most one, the two filtrations coincide.

## Attribution

Adapted from `Mei/Algebra/Lie/UniversalEnveloping/Cofinality.lean` in
[yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`9cf969cdee9748087aae45dbf4888a130890655c` (Apache 2.0). Original copyright and author credit
are retained.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

open _root_.UniversalEnvelopingAlgebra

variable {Γ R L S : Type*} [AddCommMonoid Γ] [CommRing R] [LieRing L] [LieAlgebra R L]
  [DecidableEq Γ] (ℒ : Γ → Submodule R L) [GradedLieAlgebra ℒ] (d : Γ →+ ℤ)

/-- If `L` is generated by homogeneous elements of degree at most `B`, then every element of
`U(L)` of filtration order at least `B * (k - 1) + 1` lies in the `k`-th power of the augmentation
ideal. -/
theorem degreeFiltration_le_augmentation_pow (hneg : ∀ n, d n < 0 → ℒ n = ⊥)
    (e : S → L) (deg : S → Γ) (he : LieSubalgebra.lieSpan R L (Set.range e) = ⊤)
    (hhom : ∀ s, e s ∈ ℒ (deg s)) (B : ℕ) (hB : ∀ s, d (deg s) ≤ B) (k : ℕ) :
    (degreeFiltration ℒ d hneg).ideal (B * (k - 1) + 1) ≤
      (HopfIdeal.augmentation R (UniversalEnvelopingAlgebra R L)).toIdeal ^ k := by
  have hgen : Algebra.adjoin R (Set.range fun s => ι R (e s)) = ⊤ := by
    simpa only [← Set.range_comp, Function.comp_def] using adjoin_image_ι_eq_top R L he
  rw [degreeFiltration_ideal_le_iff]
  intro n hn x hx
  -- The piece of degree `n` is spanned by words in the generators of total degree `n`, and each
  -- such word has at least `k` letters because every letter has degree at most `B`.
  rw [GradedAlgebra.grade_eq_span_list_prod_map (homogeneousSubmodule ℒ) (fun s => ι R (e s)) deg
    hgen
    (fun s => ι_mem_homogeneousSubmodule ℒ (hhom s)) n] at hx
  refine (Submodule.span_le (p := (_ ^ k : Ideal _).restrictScalars R)).mpr ?_ hx
  rintro _ ⟨l, rfl, rfl⟩
  have hlen : k ≤ l.length := by
    have hle : (l.map fun s => d (deg s)).sum ≤ l.length • (B : ℤ) := by
      simpa only [List.length_map] using List.sum_le_length_nsmul (l.map fun s => d (deg s)) _ (by
        intro x hx
        obtain ⟨s, -, rfl⟩ := List.mem_map.mp hx
        exact hB s)
    rw [map_list_sum, List.map_map, Function.comp_def] at hn
    rw [nsmul_eq_mul] at hle
    by_contra hlt
    have hlen' : (l.length : ℤ) + 1 ≤ k := by omega
    have := mul_le_mul_of_nonneg_right hlen' (Int.natCast_nonneg B)
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · omega
    · have hk1 : ((k - 1 : ℕ) : ℤ) = k - 1 := by omega
      push_cast [hk1] at hn
      nlinarith
  have hprod := Ideal.list_prod_mem_pow (I := (HopfIdeal.augmentation R _).toIdeal)
    (l := l.map fun s => ι R (e s)) (by
      simp only [List.mem_map]
      rintro _ ⟨s, -, rfl⟩
      exact HopfIdeal.mem_toIdeal.mpr (ι_mem_augmentation R L (e s)))
  rw [List.length_map] at hprod
  exact Ideal.pow_le_pow_right hlen hprod

/-- If `L` is supported in strictly positive degrees and generated by homogeneous elements of
degree at most one, the degree filtration of `U(L)` is the filtration by powers of the
augmentation ideal. -/
theorem degreeFiltration_eq_augmentation_pow (hpos : ∀ n, d n ≤ 0 → ℒ n = ⊥)
    (e : S → L) (deg : S → Γ) (he : LieSubalgebra.lieSpan R L (Set.range e) = ⊤)
    (hhom : ∀ s, e s ∈ ℒ (deg s)) (hdeg : ∀ s, d (deg s) ≤ 1) (k : ℕ) :
    (degreeFiltration ℒ d (fun n hn => hpos n hn.le)).ideal k =
      (HopfIdeal.augmentation R (UniversalEnvelopingAlgebra R L)).toIdeal ^ k := by
  refine le_antisymm ?_ (augmentation_pow_le_degreeFiltration ℒ d hpos k)
  rcases k with _ | k
  · simp
  · simpa only [Nat.add_sub_cancel, one_mul] using
      degreeFiltration_le_augmentation_pow ℒ d _ e deg he hhom 1 (by exact_mod_cast hdeg) (k + 1)

end TauCeti.UniversalEnvelopingAlgebra
