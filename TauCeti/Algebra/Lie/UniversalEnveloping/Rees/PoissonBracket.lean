/-!
# The divided commutator of the PBW Rees algebra and its zero-fibre Poisson bracket

Let `L` be a Lie algebra over a commutative ring `R`, with no freeness, finite-rank, or
characteristic-zero hypothesis. Because commutators in `UniversalEnvelopingAlgebra R L` drop PBW
filtration degree by at least one (`mul_sub_mul_mem_pbwFiltrationPrevious`), the commutator
`a * b - b * a` of any two elements of `reesAlgebra R L` has vanishing constant term and `n + 1`-st
coefficient in `pbwFiltration R L n`. Dividing by the central parameter `reesParameter R L` inside
`U(L)[X]` therefore produces a unique `R`-bilinear **divided commutator**
`reesDividedCommutator R L : reesAlgebra R L →ₗ[R] reesAlgebra R L →ₗ[R] reesAlgebra R L` obeying

`reesParameter R L * reesDividedCommutator R L a b = a * b - b * a`.

Because multiplication by `reesParameter R L` is central and injective
(`coeffSubalgebra.commute_X`, `coeffSubalgebra.X_mul_injective`), the generator formula,
alternation, skew-symmetry, left and right Leibniz rules, `reesParameter`-linearity, naturality
along Lie homomorphisms, and the **Jacobi identity** hold already in `reesAlgebra R L`: the Jacobi
identity cancels `reesParameter R L` twice from the associative Jacobi identity for commutators.

When `L` is free as an `R`-module, `reesSpecializationZero R L` surjects `reesAlgebra R L` onto
`SymmetricAlgebra R L` with kernel generated by `reesParameter R L` (`ker_reesSpecializationZero`).
By `reesParameter`-linearity of `reesDividedCommutator`, descending modulo `reesParameter R L` in
both arguments yields the canonical **zero-fibre Poisson bracket** `reesZeroFiberBracket R L` on
`SymmetricAlgebra R L`, establishing `exists_reesZeroFiberBracket` and uniqueness of any bilinear
map with the same divided-commutator property. All biderivation, alternation, Jacobi, degree `-1`
homogeneity, Lie invariance, and naturality properties specialize immediately from
`reesDividedCommutator`. When `L` admits a finite basis `b`, evaluating
`reesZeroFiberBracket R L p q` at `ξ : Module.Dual R L` gives the linear Kirillov–Kostant–Souriau
formula `ξ ⁅b.symmetricGradient p ξ, b.symmetricGradient q ξ⁆`
(`lift_reesZeroFiberBracket_eq_lie_symmetricGradient`).

## Main definitions

* `TauCeti.UniversalEnvelopingAlgebra.reesDividedCommutator`: the divided commutator `(ab - ba)/ħ`
  on `reesAlgebra R L`, requiring no freeness hypothesis on `L`.
* `TauCeti.UniversalEnvelopingAlgebra.reesZeroFiberBracket`: the induced Poisson bracket on
  `SymmetricAlgebra R L` when `[Module.Free R L]`.
* `TauCeti.UniversalEnvelopingAlgebra.reesZeroFiberDerivation`: `reesZeroFiberBracket R L p` bundled
  as an `R`-derivation of `SymmetricAlgebra R L`.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.reesParameter_mul_reesDividedCommutator`,
  `TauCeti.UniversalEnvelopingAlgebra.reesDividedCommutator_jacobi`: defining equation and exact
  Jacobi identity of the divided commutator.
* `TauCeti.UniversalEnvelopingAlgebra.exists_reesZeroFiberBracket`,
  `TauCeti.UniversalEnvelopingAlgebra.eq_reesZeroFiberBracket_of_commutator_eq`: existence and
  uniqueness of the zero-fibre bracket characterized by `a * b - b * a = ħ * c`.
* `TauCeti.UniversalEnvelopingAlgebra.reesZeroFiberBracket_self`,
  `TauCeti.UniversalEnvelopingAlgebra.reesZeroFiberBracket_mul_left`,
  `TauCeti.UniversalEnvelopingAlgebra.reesZeroFiberBracket_mul_right`,
  `TauCeti.UniversalEnvelopingAlgebra.eq_reesZeroFiberBracket_of_leibniz`,
  `TauCeti.UniversalEnvelopingAlgebra.reesZeroFiberBracket_jacobi`: alternation, Leibniz rules,
  biderivation uniqueness, and Jacobi identity on `SymmetricAlgebra R L`.
* `TauCeti.UniversalEnvelopingAlgebra.reesZeroFiberBracket_mem_homogeneousSubmodule`,
  `TauCeti.UniversalEnvelopingAlgebra.forall_reesZeroFiberBracket_eq_zero_iff_mem_lieInvariants`,
  `TauCeti.UniversalEnvelopingAlgebra.map_reesZeroFiberBracket`: degree `-1` homogeneity, equality
  of the Poisson centre with `lieInvariants R L L`, and naturality under Lie homomorphisms.
* `TauCeti.UniversalEnvelopingAlgebra.lift_reesZeroFiberBracket_eq_lie_symmetricGradient`:
  evaluation at `ξ ∈ L*` equals `ξ ⁅b.symmetricGradient p ξ, b.symmetricGradient q ξ⁆`.

## References

* J. Dixmier, *Enveloping Algebras*, Graduate Studies in Mathematics 11, AMS (1996), §§2.3–2.4, for
  filtered enveloping algebras, their Rees algebras, and Lie invariants in the symmetric algebra.
* S. Gutt, *Deformation Quantization and Symmetries*, Lecture 1, slide 14 (2019), solely for the
  real characteristic-zero sign convention `{ℓ_x, ℓ_y}(ξ) = ξ([x, y])`; the arbitrary-ring divided
  commutator, zero-fibre bracket, and polynomial evaluation identity are derived directly from the
  PBW Rees algebra, injective multiplication by `reesParameter`, and the Leibniz rule.
-/

public section

open Polynomial

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

section DividedCommutator

variable (R : Type u) (L : Type v) [CommRing R] [LieRing L] [LieAlgebra R L]

attribute [local instance 100] LieRing.ofAssociativeRing

local notation "U" => _root_.UniversalEnvelopingAlgebra R L

/-- Every coefficient of a commutator in `reesAlgebra R L` lies one step lower in the PBW
filtration. -/
theorem commutator_coeff_mem_pbwFiltrationPrevious (a b : reesAlgebra R L) (n : ℕ) :
    ((a * b - b * a : reesAlgebra R L) : U[X]).coeff n ∈ pbwFiltrationPrevious R L n := by
  rw [Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_mul, coeff_sub, coeff_mul, coeff_mul]
  have hswap :
      (∑ x ∈ Finset.antidiagonal n, (b : U[X]).coeff x.1 * (a : U[X]).coeff x.2) =
        ∑ x ∈ Finset.antidiagonal n, (b : U[X]).coeff x.2 * (a : U[X]).coeff x.1 := by
    refine Finset.sum_equiv (Equiv.prodComm ℕ ℕ) ?_ fun x _ ↦ rfl
    intro x
    simp [Finset.mem_antidiagonal, add_comm]
  rw [hswap, ← Finset.sum_sub_distrib]
  refine Submodule.sum_mem _ fun x hx ↦ ?_
  rw [← Finset.mem_antidiagonal.mp hx]
  exact mul_sub_mul_mem_pbwFiltrationPrevious R L
    (mem_coeffSubalgebra_iff.mp a.2 x.1) (mem_coeffSubalgebra_iff.mp b.2 x.2)

private noncomputable def reesDividedCommutatorAux (a b : reesAlgebra R L) : reesAlgebra R L :=
  ⟨((a * b - b * a : reesAlgebra R L) : U[X]).divX, mem_coeffSubalgebra_iff.mpr fun n ↦ by
    rw [coeff_divX, ← pbwFiltrationPrevious_succ]
    exact commutator_coeff_mem_pbwFiltrationPrevious R L a b (n + 1)⟩

private theorem reesParameter_mul_reesDividedCommutatorAux (a b : reesAlgebra R L) :
    reesParameter R L * reesDividedCommutatorAux R L a b = a * b - b * a := by
  apply Subtype.ext
  have h0 : ((a * b - b * a : reesAlgebra R L) : U[X]).coeff 0 = 0 := by
    have hmem := commutator_coeff_mem_pbwFiltrationPrevious R L a b 0
    rwa [pbwFiltrationPrevious_zero, Submodule.mem_bot] at hmem
  rw [Subalgebra.coe_mul, coeffSubalgebra.coe_X, reesDividedCommutatorAux,
    ← add_zero (Polynomial.X * _), ← C_0, ← h0, X_mul_divX_add]

private theorem reesParameter_mul_cancel {x y : reesAlgebra R L}
    (h : reesParameter R L * x = reesParameter R L * y) : x = y :=
  coeffSubalgebra.X_mul_injective (pbwFiltration R L) (one_mem_pbwFiltration R L 1) h

private theorem commute_reesParameter (a : reesAlgebra R L) :
    Commute (reesParameter R L) a :=
  coeffSubalgebra.commute_X (pbwFiltration R L) (one_mem_pbwFiltration R L 1) a

/-- The **divided commutator** on the PBW Rees algebra, sending `(a, b)` to the unique element `c`
satisfying `reesParameter R L * c = a * b - b * a`. Requires no freeness hypothesis on `L`. -/
noncomputable def reesDividedCommutator :
    reesAlgebra R L →ₗ[R] reesAlgebra R L →ₗ[R] reesAlgebra R L :=
  LinearMap.mk₂ R (reesDividedCommutatorAux R L)
    (fun a₁ a₂ b ↦ reesParameter_mul_cancel R L <| by
      rw [mul_add, reesParameter_mul_reesDividedCommutatorAux,
        reesParameter_mul_reesDividedCommutatorAux, reesParameter_mul_reesDividedCommutatorAux]
      noncomm_ring)
    (fun r a b ↦ reesParameter_mul_cancel R L <| by
      rw [mul_smul_comm, reesParameter_mul_reesDividedCommutatorAux,
        reesParameter_mul_reesDividedCommutatorAux, smul_mul_assoc, mul_smul_comm, smul_sub])
    (fun a b₁ b₂ ↦ reesParameter_mul_cancel R L <| by
      rw [mul_add, reesParameter_mul_reesDividedCommutatorAux,
        reesParameter_mul_reesDividedCommutatorAux, reesParameter_mul_reesDividedCommutatorAux]
      noncomm_ring)
    (fun r a b ↦ reesParameter_mul_cancel R L <| by
      rw [mul_smul_comm, reesParameter_mul_reesDividedCommutatorAux,
        reesParameter_mul_reesDividedCommutatorAux, mul_smul_comm, smul_mul_assoc, smul_sub])

@[simp]
theorem coe_reesDividedCommutator (a b : reesAlgebra R L) :
    (reesDividedCommutator R L a b : U[X]) =
      ((a * b - b * a : reesAlgebra R L) : U[X]).divX :=
  (rfl)

/-- **Defining relation of the divided commutator.** -/
@[simp]
theorem reesParameter_mul_reesDividedCommutator (a b : reesAlgebra R L) :
    reesParameter R L * reesDividedCommutator R L a b = a * b - b * a :=
  reesParameter_mul_reesDividedCommutatorAux R L a b

@[simp]
theorem reesDividedCommutator_mul_reesParameter (a b : reesAlgebra R L) :
    reesDividedCommutator R L a b * reesParameter R L = a * b - b * a := by
  rw [← (commute_reesParameter R L _).eq, reesParameter_mul_reesDividedCommutator]

/-- `reesDividedCommutator R L a b` is the unique solution `c` to `a * b - b * a = ħ * c`. -/
theorem reesDividedCommutator_eq_iff {a b c : reesAlgebra R L} :
    reesDividedCommutator R L a b = c ↔ a * b - b * a = reesParameter R L * c := by
  refine ⟨fun h ↦ by rw [← h, reesParameter_mul_reesDividedCommutator], fun h ↦ ?_⟩
  exact reesParameter_mul_cancel R L (by rw [reesParameter_mul_reesDividedCommutator, h])

@[simp]
theorem reesDividedCommutator_reesGenerator (x y : L) :
    reesDividedCommutator R L (reesGenerator R L x) (reesGenerator R L y) =
      reesGenerator R L ⁅x, y⁆ :=
  reesDividedCommutator_eq_iff R L |>.mpr (reesGenerator_mul_sub_mul R L x y)

@[simp]
theorem reesDividedCommutator_self (a : reesAlgebra R L) :
    reesDividedCommutator R L a a = 0 :=
  reesDividedCommutator_eq_iff R L |>.mpr (by simp)

theorem reesDividedCommutator_swap (a b : reesAlgebra R L) :
    reesDividedCommutator R L a b = -(reesDividedCommutator R L b a) :=
  eq_neg_iff_add_eq_zero.mpr <| reesParameter_mul_cancel R L <| by
    rw [mul_add, reesParameter_mul_reesDividedCommutator, reesParameter_mul_reesDividedCommutator,
      mul_zero, sub_add_sub_cancel, sub_self]

theorem reesDividedCommutator_of_commute {a b : reesAlgebra R L} (h : Commute a b) :
    reesDividedCommutator R L a b = 0 :=
  reesDividedCommutator_eq_iff R L |>.mpr (by simp [h.eq])

@[simp]
theorem reesDividedCommutator_reesParameter_left (a : reesAlgebra R L) :
    reesDividedCommutator R L (reesParameter R L) a = 0 :=
  reesDividedCommutator_of_commute R L (commute_reesParameter R L a)

@[simp]
theorem reesDividedCommutator_reesParameter_right (a : reesAlgebra R L) :
    reesDividedCommutator R L a (reesParameter R L) = 0 :=
  reesDividedCommutator_of_commute R L (commute_reesParameter R L a).symm

@[simp]
theorem reesDividedCommutator_algebraMap_left (r : R) (a : reesAlgebra R L) :
    reesDividedCommutator R L (algebraMap R (reesAlgebra R L) r) a = 0 :=
  reesDividedCommutator_of_commute R L (Algebra.commutes r a)

@[simp]
theorem reesDividedCommutator_algebraMap_right (a : reesAlgebra R L) (r : R) :
    reesDividedCommutator R L a (algebraMap R (reesAlgebra R L) r) = 0 :=
  reesDividedCommutator_of_commute R L (Algebra.commutes r a).symm

@[simp]
theorem reesDividedCommutator_one_left (a : reesAlgebra R L) :
    reesDividedCommutator R L 1 a = 0 := by
  simpa using reesDividedCommutator_algebraMap_left R L 1 a

@[simp]
theorem reesDividedCommutator_one_right (a : reesAlgebra R L) :
    reesDividedCommutator R L a 1 = 0 := by
  simpa using reesDividedCommutator_algebraMap_right R L a 1

/-- **Right Leibniz rule** for `reesDividedCommutator` in `reesAlgebra R L`. -/
theorem reesDividedCommutator_mul_right (a b c : reesAlgebra R L) :
    reesDividedCommutator R L a (b * c) =
      b * reesDividedCommutator R L a c + reesDividedCommutator R L a b * c :=
  reesParameter_mul_cancel R L <| by
    rw [reesParameter_mul_reesDividedCommutator, mul_add,
      (commute_reesParameter R L b).left_comm, reesParameter_mul_reesDividedCommutator,
      ← mul_assoc (reesParameter R L), reesParameter_mul_reesDividedCommutator]
    simp only [mul_sub, sub_mul, mul_assoc]
    abel

/-- **Left Leibniz rule** for `reesDividedCommutator` in `reesAlgebra R L`. -/
theorem reesDividedCommutator_mul_left (a b c : reesAlgebra R L) :
    reesDividedCommutator R L (a * b) c =
      a * reesDividedCommutator R L b c + reesDividedCommutator R L a c * b :=
  reesParameter_mul_cancel R L <| by
    rw [reesParameter_mul_reesDividedCommutator, mul_add,
      (commute_reesParameter R L a).left_comm, reesParameter_mul_reesDividedCommutator,
      ← mul_assoc (reesParameter R L), reesParameter_mul_reesDividedCommutator]
    simp only [mul_sub, sub_mul, mul_assoc]
    abel

@[simp]
theorem reesDividedCommutator_reesParameter_mul_left (a b : reesAlgebra R L) :
    reesDividedCommutator R L (reesParameter R L * a) b =
      reesParameter R L * reesDividedCommutator R L a b := by
  rw [reesDividedCommutator_mul_left, reesDividedCommutator_reesParameter_left, zero_mul, add_zero]

@[simp]
theorem reesDividedCommutator_reesParameter_mul_right (a b : reesAlgebra R L) :
    reesDividedCommutator R L a (reesParameter R L * b) =
      reesParameter R L * reesDividedCommutator R L a b := by
  rw [reesDividedCommutator_mul_right, reesDividedCommutator_reesParameter_right, zero_mul,
    add_zero]

/-- **Exact Jacobi identity** for `reesDividedCommutator` in `reesAlgebra R L`, proved by
cancelling `reesParameter R L` twice from the associative Jacobi identity. -/
theorem reesDividedCommutator_jacobi (a b c : reesAlgebra R L) :
    reesDividedCommutator R L (reesDividedCommutator R L a b) c +
      reesDividedCommutator R L (reesDividedCommutator R L b c) a +
      reesDividedCommutator R L (reesDividedCommutator R L c a) b = 0 := by
  apply reesParameter_mul_cancel R L
  apply reesParameter_mul_cancel R L
  simp only [mul_zero, mul_add, reesParameter_mul_reesDividedCommutator, mul_sub]
  rw [← mul_assoc (reesParameter R L), reesParameter_mul_reesDividedCommutator,
    (commute_reesParameter R L c).left_comm, reesParameter_mul_reesDividedCommutator,
    ← mul_assoc (reesParameter R L), reesParameter_mul_reesDividedCommutator,
    (commute_reesParameter R L a).left_comm, reesParameter_mul_reesDividedCommutator,
    ← mul_assoc (reesParameter R L), reesParameter_mul_reesDividedCommutator,
    (commute_reesParameter R L b).left_comm, reesParameter_mul_reesDividedCommutator]
  noncomm_ring [neg_neg]

/-- Naturality of `reesDividedCommutator` along a Lie algebra homomorphism. -/
@[simp]
theorem reesMap_reesDividedCommutator {M : Type w} [LieRing M] [LieAlgebra R M]
    (f : L →ₗ⁅R⁆ M) (a b : reesAlgebra R L) :
    reesMap R f (reesDividedCommutator R L a b) =
      reesDividedCommutator R M (reesMap R f a) (reesMap R f b) :=
  ((reesDividedCommutator_eq_iff R M).mpr <| by
    calc
      reesMap R f a * reesMap R f b - reesMap R f b * reesMap R f a
        = reesMap R f (a * b - b * a) := by simp
      _ = reesMap R f (reesParameter R L * reesDividedCommutator R L a b) := by
          rw [← reesParameter_mul_reesDividedCommutator]
      _ = reesParameter R M * reesMap R f (reesDividedCommutator R L a b) := by
          rw [map_mul, reesMap_reesParameter]).symm

/-- Over an abelian Lie algebra, `reesAlgebra R L` is commutative (`Abelian.instCommRing`), so its
divided commutator vanishes identically. -/
@[simp]
theorem reesDividedCommutator_eq_zero [IsLieAbelian L] (a b : reesAlgebra R L) :
    reesDividedCommutator R L a b = 0 :=
  reesDividedCommutator_of_commute R L (mul_comm a b)

end DividedCommutator

/-! ### The zero-fibre Poisson bracket -/

section ZeroFiberBracket

variable (R : Type u) (L : Type v) [CommRing R] [LieRing L] [LieAlgebra R L] [Module.Free R L]

private theorem reesSpecializationZero_toLinearMap_surjective :
    Function.Surjective (reesSpecializationZero R L).toLinearMap :=
  reesSpecializationZero_surjective R L

private theorem ker_le_reesDividedCommutator_right (a : reesAlgebra R L) :
    LinearMap.ker (reesSpecializationZero R L).toLinearMap ≤
      LinearMap.ker ((reesSpecializationZero R L).toLinearMap ∘ₗ reesDividedCommutator R L a) := by
  intro b hb
  obtain ⟨q, rfl⟩ :=
    (reesSpecializationZero_eq_zero_iff_exists_reesParameter_mul R L b).mp
      (LinearMap.mem_ker.mp hb)
  rw [LinearMap.mem_ker, LinearMap.comp_apply, AlgHom.toLinearMap_apply]
  simp [mul_comm]

private noncomputable def reesZeroFiberBracketRight (a : reesAlgebra R L) :
    SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L :=
  let π := (reesSpecializationZero R L).toLinearMap
  ((LinearMap.ker π).liftQ (π ∘ₗ reesDividedCommutator R L a)
      (ker_le_reesDividedCommutator_right R L a)) ∘ₗ
    (π.quotKerEquivOfSurjective
      (reesSpecializationZero_toLinearMap_surjective R L)).symm.toLinearMap

private theorem reesZeroFiberBracketRight_apply (a b : reesAlgebra R L) :
    reesZeroFiberBracketRight R L a (reesSpecializationZero R L b) =
      reesSpecializationZero R L (reesDividedCommutator R L a b) :=
  congrArg
    ((LinearMap.ker (reesSpecializationZero R L).toLinearMap).liftQ
      ((reesSpecializationZero R L).toLinearMap ∘ₗ reesDividedCommutator R L a)
      (ker_le_reesDividedCommutator_right R L a))
    (LinearMap.quotKerEquivOfSurjective_symm_apply (reesSpecializationZero R L).toLinearMap
      (reesSpecializationZero_toLinearMap_surjective R L) b)

private noncomputable def reesZeroFiberBracketRightLinear :
    reesAlgebra R L →ₗ[R] SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L where
  toFun := reesZeroFiberBracketRight R L
  map_add' a₁ a₂ := LinearMap.ext fun q ↦ by
    obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
    simp [reesZeroFiberBracketRight_apply]
  map_smul' r a := LinearMap.ext fun q ↦ by
    obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
    simp [reesZeroFiberBracketRight_apply]

private theorem ker_le_reesZeroFiberBracketRightLinear :
    LinearMap.ker (reesSpecializationZero R L).toLinearMap ≤
      LinearMap.ker (reesZeroFiberBracketRightLinear R L) := by
  intro a ha
  obtain ⟨p, rfl⟩ :=
    (reesSpecializationZero_eq_zero_iff_exists_reesParameter_mul R L a).mp
      (LinearMap.mem_ker.mp ha)
  rw [LinearMap.mem_ker]
  ext q
  obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
  rw [reesZeroFiberBracketRightLinear, LinearMap.coe_mk, AddHom.coe_mk, LinearMap.zero_apply]
  simp [reesZeroFiberBracketRight_apply, mul_comm]

/-- The **zero-fibre Poisson bracket** on `SymmetricAlgebra R L`, induced by descending
`reesDividedCommutator R L` modulo `reesParameter R L` in both arguments. -/
noncomputable def reesZeroFiberBracket :
    SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L :=
  let π := (reesSpecializationZero R L).toLinearMap
  ((LinearMap.ker π).liftQ (reesZeroFiberBracketRightLinear R L)
      (ker_le_reesZeroFiberBracketRightLinear R L)) ∘ₗ
    (π.quotKerEquivOfSurjective
      (reesSpecializationZero_toLinearMap_surjective R L)).symm.toLinearMap

/-- `reesZeroFiberBracket` intertwines `reesSpecializationZero` with `reesDividedCommutator`. -/
@[simp]
theorem reesZeroFiberBracket_reesSpecializationZero (a b : reesAlgebra R L) :
    reesZeroFiberBracket R L (reesSpecializationZero R L a) (reesSpecializationZero R L b) =
      reesSpecializationZero R L (reesDividedCommutator R L a b) := by
  have h :
      reesZeroFiberBracket R L (reesSpecializationZero R L a) =
        reesZeroFiberBracketRight R L a :=
    congrArg
      ((LinearMap.ker (reesSpecializationZero R L).toLinearMap).liftQ
        (reesZeroFiberBracketRightLinear R L) (ker_le_reesZeroFiberBracketRightLinear R L))
      (LinearMap.quotKerEquivOfSurjective_symm_apply (reesSpecializationZero R L).toLinearMap
        (reesSpecializationZero_toLinearMap_surjective R L) a)
  rw [h, reesZeroFiberBracketRight_apply]

/-- **Divided-commutator characterization of `reesZeroFiberBracket`.** Whenever
`a * b - b * a = reesParameter R L * c` in `reesAlgebra R L`, the bracket of the zero-fibre
specializations of `a` and `b` is the specialization of `c`. -/
theorem reesZeroFiberBracket_apply_of_commutator_eq {R L} [CommRing R]
    [LieRing L] [LieAlgebra R L] [Module.Free R L]
    {a b c : reesAlgebra R L} (h : a * b - b * a = reesParameter R L * c) :
    reesZeroFiberBracket R L (reesSpecializationZero R L a) (reesSpecializationZero R L b) =
      reesSpecializationZero R L c := by
  rw [reesZeroFiberBracket_reesSpecializationZero,
    (reesDividedCommutator_eq_iff R L).mpr h]

/-- **Uniqueness of the zero-fibre bracket.** Any `R`-bilinear map on `SymmetricAlgebra R L`
satisfying the divided-commutator relation on `reesAlgebra R L` equals
`reesZeroFiberBracket R L`. -/
theorem eq_reesZeroFiberBracket_of_commutator_eq {R L} [CommRing R]
    [LieRing L] [LieAlgebra R L] [Module.Free R L]
    {B : SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L}
    (hB : ∀ a b c : reesAlgebra R L,
      a * b - b * a = reesParameter R L * c →
      B (reesSpecializationZero R L a) (reesSpecializationZero R L b) =
        reesSpecializationZero R L c) :
    B = reesZeroFiberBracket R L := by
  ext p q : 2
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
  rw [reesZeroFiberBracket_reesSpecializationZero]
  exact hB a b (reesDividedCommutator R L a b)
    (reesParameter_mul_reesDividedCommutator R L a b).symm

/-- On the zero fibre of the PBW Rees algebra of a Lie algebra that is free as a module over a
commutative ring, the commutator divided by the central parameter defines an `R`-bilinear bracket on
the symmetric algebra: whenever `a * b - b * a = ħ * c` in the Rees algebra, the bracket of the
zero-fibre classes of `a` and `b` is the class of `c`. -/
theorem exists_reesZeroFiberBracket (R : Type u) [CommRing R]
    (L : Type v) [LieRing L] [LieAlgebra R L] [Module.Free R L] :
    ∃ B : SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L,
      ∀ a b c : reesAlgebra R L,
        a * b - b * a = reesParameter R L * c →
        B (reesSpecializationZero R L a) (reesSpecializationZero R L b) =
          reesSpecializationZero R L c :=
  ⟨reesZeroFiberBracket R L, fun _ _ _ ↦ reesZeroFiberBracket_apply_of_commutator_eq⟩

/-- On symmetric-algebra generators, `reesZeroFiberBracket` recovers the Lie bracket of `L`. -/
@[simp]
theorem reesZeroFiberBracket_ι_ι (x y : L) :
    reesZeroFiberBracket R L (SymmetricAlgebra.ι R L x) (SymmetricAlgebra.ι R L y) =
      SymmetricAlgebra.ι R L ⁅x, y⁆ := by
  rw [← reesSpecializationZero_reesGenerator R L x, ← reesSpecializationZero_reesGenerator R L y,
    reesZeroFiberBracket_reesSpecializationZero, reesDividedCommutator_reesGenerator,
    reesSpecializationZero_reesGenerator]

/-- **Alternation** of `reesZeroFiberBracket`. -/
@[simp]
theorem reesZeroFiberBracket_self (p : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L p p = 0 := by
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  simp [reesZeroFiberBracket_reesSpecializationZero]

/-- **Skew-symmetry** of `reesZeroFiberBracket`. -/
theorem reesZeroFiberBracket_swap (p q : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L p q = -(reesZeroFiberBracket R L q p) := by
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
  rw [reesZeroFiberBracket_reesSpecializationZero, reesZeroFiberBracket_reesSpecializationZero,
    reesDividedCommutator_swap, map_neg]

@[simp]
theorem reesZeroFiberBracket_algebraMap_left (r : R) (p : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L (algebraMap R (SymmetricAlgebra R L) r) p = 0 := by
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  rw [← (reesSpecializationZero R L).commutes r, reesZeroFiberBracket_reesSpecializationZero,
    reesDividedCommutator_algebraMap_left, map_zero]

@[simp]
theorem reesZeroFiberBracket_algebraMap_right (p : SymmetricAlgebra R L) (r : R) :
    reesZeroFiberBracket R L p (algebraMap R (SymmetricAlgebra R L) r) = 0 := by
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  rw [← (reesSpecializationZero R L).commutes r, reesZeroFiberBracket_reesSpecializationZero,
    reesDividedCommutator_algebraMap_right, map_zero]

@[simp]
theorem reesZeroFiberBracket_one_left (p : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L 1 p = 0 := by
  simpa using reesZeroFiberBracket_algebraMap_left R L 1 p

@[simp]
theorem reesZeroFiberBracket_one_right (p : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L p 1 = 0 := by
  simpa using reesZeroFiberBracket_algebraMap_right R L p 1

/-- **Right Leibniz rule** for `reesZeroFiberBracket`. -/
theorem reesZeroFiberBracket_mul_right (p q r : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L p (q * r) =
      q * reesZeroFiberBracket R L p r + reesZeroFiberBracket R L p q * r := by
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
  obtain ⟨c, rfl⟩ := reesSpecializationZero_surjective R L r
  rw [← map_mul, reesZeroFiberBracket_reesSpecializationZero, reesDividedCommutator_mul_right,
    map_add, map_mul, map_mul, reesZeroFiberBracket_reesSpecializationZero,
    reesZeroFiberBracket_reesSpecializationZero]

/-- **Left Leibniz rule** for `reesZeroFiberBracket`. -/
theorem reesZeroFiberBracket_mul_left (p q r : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L (p * q) r =
      p * reesZeroFiberBracket R L q r + reesZeroFiberBracket R L p r * q := by
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
  obtain ⟨c, rfl⟩ := reesSpecializationZero_surjective R L r
  rw [← map_mul, reesZeroFiberBracket_reesSpecializationZero, reesDividedCommutator_mul_left,
    map_add, map_mul, map_mul, reesZeroFiberBracket_reesSpecializationZero,
    reesZeroFiberBracket_reesSpecializationZero]

/-- `reesZeroFiberBracket R L p` bundled as an `R`-derivation of `SymmetricAlgebra R L`. -/
noncomputable def reesZeroFiberDerivation (p : SymmetricAlgebra R L) :
    Derivation R (SymmetricAlgebra R L) (SymmetricAlgebra R L) where
  toLinearMap := reesZeroFiberBracket R L p
  map_one_eq_zero' := reesZeroFiberBracket_one_right R L p
  leibniz' q r := by
    rw [reesZeroFiberBracket_mul_right, smul_eq_mul, smul_eq_mul,
      mul_comm (reesZeroFiberBracket R L p q), add_comm]

@[simp]
theorem reesZeroFiberDerivation_apply (p q : SymmetricAlgebra R L) :
    reesZeroFiberDerivation R L p q = reesZeroFiberBracket R L p q :=
  (rfl)

/-- **Biderivation uniqueness.** `reesZeroFiberBracket R L` is the unique `R`-bilinear biderivation
of `SymmetricAlgebra R L` sending `(ι x, ι y)` to `ι ⁅x, y⁆`. -/
theorem eq_reesZeroFiberBracket_of_leibniz {R L} [CommRing R]
    [LieRing L] [LieAlgebra R L] [Module.Free R L]
    {B : SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L}
    (hι : ∀ x y : L, B (SymmetricAlgebra.ι R L x) (SymmetricAlgebra.ι R L y) =
      SymmetricAlgebra.ι R L ⁅x, y⁆)
    (hleft : ∀ p q r : SymmetricAlgebra R L, B (p * q) r = p * B q r + B p r * q)
    (hright : ∀ p q r : SymmetricAlgebra R L, B p (q * r) = q * B p r + B p q * r) :
    B = reesZeroFiberBracket R L := by
  have hone_right : ∀ p : SymmetricAlgebra R L, B p 1 = 0 := fun p ↦ by
    have h1 := hright p 1 1
    rw [mul_one, one_mul, mul_one] at h1
    exact right_eq_add.mp h1
  have hone_left : ∀ r : SymmetricAlgebra R L, B 1 r = 0 := fun r ↦ by
    have h1 := hleft 1 1 r
    rw [mul_one, one_mul, mul_one] at h1
    exact right_eq_add.mp h1
  have halg_right : ∀ (p : SymmetricAlgebra R L) (c : R),
      B p (algebraMap R (SymmetricAlgebra R L) c) = 0 := fun p c ↦ by
    rw [Algebra.algebraMap_eq_smul_one, map_smul, hone_right, smul_zero]
  have halg_left : ∀ (c : R) (r : SymmetricAlgebra R L),
      B (algebraMap R (SymmetricAlgebra R L) c) r = 0 := fun c r ↦ by
    rw [Algebra.algebraMap_eq_smul_one, LinearMap.map_smul₂, hone_left, smul_zero]
  have hgen : ∀ (x : L) (q : SymmetricAlgebra R L),
      B (SymmetricAlgebra.ι R L x) q = reesZeroFiberBracket R L (SymmetricAlgebra.ι R L x) q := by
    intro x q
    induction q using SymmetricAlgebra.induction with
    | algebraMap c => simp [halg_right]
    | ι y => simp [hι]
    | mul q₁ q₂ h₁ h₂ => simp [hright, reesZeroFiberBracket_mul_right, h₁, h₂]
    | add q₁ q₂ h₁ h₂ => simp [h₁, h₂]
  ext p q : 2
  induction p using SymmetricAlgebra.induction with
  | algebraMap c => simp [halg_left]
  | ι x => exact hgen x q
  | mul p₁ p₂ h₁ h₂ => simp [hleft, reesZeroFiberBracket_mul_left, h₁, h₂]
  | add p₁ p₂ h₁ h₂ => simp [h₁, h₂]

/-- **Jacobi identity** for `reesZeroFiberBracket` on `SymmetricAlgebra R L`. -/
theorem reesZeroFiberBracket_jacobi (p q r : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L (reesZeroFiberBracket R L p q) r +
      reesZeroFiberBracket R L (reesZeroFiberBracket R L q r) p +
      reesZeroFiberBracket R L (reesZeroFiberBracket R L r p) q = 0 := by
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
  obtain ⟨c, rfl⟩ := reesSpecializationZero_surjective R L r
  simp only [reesZeroFiberBracket_reesSpecializationZero, ← map_add,
    reesDividedCommutator_jacobi, map_zero]

/-- Derivation form of the Jacobi identity: bracketing with `reesZeroFiberBracket R L p q` acts as
the commutator of the derivations `reesZeroFiberBracket R L p` and `reesZeroFiberBracket R L q`. -/
theorem reesZeroFiberBracket_reesZeroFiberBracket (p q r : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L (reesZeroFiberBracket R L p q) r =
      reesZeroFiberBracket R L p (reesZeroFiberBracket R L q r) -
        reesZeroFiberBracket R L q (reesZeroFiberBracket R L p r) := by
  have hj := reesZeroFiberBracket_jacobi R L p q r
  rw [reesZeroFiberBracket_swap R L (reesZeroFiberBracket R L q r) p,
    reesZeroFiberBracket_swap R L r p, map_neg, LinearMap.neg_apply,
    reesZeroFiberBracket_swap R L (reesZeroFiberBracket R L p r) q, neg_neg] at hj
  calc
    reesZeroFiberBracket R L (reesZeroFiberBracket R L p q) r
      = (reesZeroFiberBracket R L (reesZeroFiberBracket R L p q) r +
          -(reesZeroFiberBracket R L p (reesZeroFiberBracket R L q r)) +
          reesZeroFiberBracket R L q (reesZeroFiberBracket R L p r)) +
        (reesZeroFiberBracket R L p (reesZeroFiberBracket R L q r) -
          reesZeroFiberBracket R L q (reesZeroFiberBracket R L p r)) := by abel
    _ = reesZeroFiberBracket R L p (reesZeroFiberBracket R L q r) -
        reesZeroFiberBracket R L q (reesZeroFiberBracket R L p r) := by rw [hj, zero_add]

/-- Bracketing on the left with a generator `ι x` agrees with the adjoint Lie-module derivation
`⁅x, q⁆` of `TauCeti.SymmetricAlgebra.lieModuleDerivation`. -/
theorem reesZeroFiberBracket_ι_left (x : L) (q : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L (SymmetricAlgebra.ι R L x) q = ⁅x, q⁆ := by
  rw [← reesZeroFiberDerivation_apply, TauCeti.SymmetricAlgebra.lie_eq_lieModuleDerivation]
  exact Derivation.congr_fun (SymmetricAlgebra.derivation_ext fun y ↦ by simp) q

/-- Bracketing on the right with a generator `ι y` is `-⁅y, p⁆`. -/
theorem reesZeroFiberBracket_ι_right (p : SymmetricAlgebra R L) (y : L) :
    reesZeroFiberBracket R L p (SymmetricAlgebra.ι R L y) = -⁅y, p⁆ := by
  rw [reesZeroFiberBracket_swap, reesZeroFiberBracket_ι_left]

/-- **Poisson centre equals Lie invariants.** An element of `SymmetricAlgebra R L` Poisson-commutes
with all of `SymmetricAlgebra R L` if and only if it belongs to
`TauCeti.SymmetricAlgebra.lieInvariants R L L`. -/
theorem forall_reesZeroFiberBracket_eq_zero_iff_mem_lieInvariants {p : SymmetricAlgebra R L} :
    (∀ q : SymmetricAlgebra R L, reesZeroFiberBracket R L p q = 0) ↔
      p ∈ TauCeti.SymmetricAlgebra.lieInvariants R L L := by
  rw [TauCeti.SymmetricAlgebra.mem_lieInvariants]
  refine ⟨fun h x ↦ ?_, fun hp q ↦ ?_⟩
  · have hx := h (SymmetricAlgebra.ι R L x)
    rw [reesZeroFiberBracket_ι_right, neg_eq_zero,
      TauCeti.SymmetricAlgebra.lie_eq_lieModuleDerivation] at hx
    exact hx
  · induction q using SymmetricAlgebra.induction with
    | algebraMap r => simp
    | ι x =>
      rw [reesZeroFiberBracket_ι_right, TauCeti.SymmetricAlgebra.lie_eq_lieModuleDerivation,
        hp x, neg_zero]
    | mul q₁ q₂ h₁ h₂ => simp [reesZeroFiberBracket_mul_right, h₁, h₂]
    | add q₁ q₂ h₁ h₂ => simp [h₁, h₂]

/-- Commuting elements of `reesAlgebra R L` specialize to Poisson-commuting elements of
`SymmetricAlgebra R L`. -/
theorem reesZeroFiberBracket_reesSpecializationZero_of_commute {a b : reesAlgebra R L}
    (h : Commute a b) :
    reesZeroFiberBracket R L (reesSpecializationZero R L a) (reesSpecializationZero R L b) = 0 := by
  rw [reesZeroFiberBracket_reesSpecializationZero, reesDividedCommutator_of_commute R L h, map_zero]

/-- Every central element of `reesAlgebra R L` specializes to a Lie-invariant (Poisson-central)
element of `SymmetricAlgebra R L`. -/
theorem reesSpecializationZero_mem_lieInvariants_of_mem_center {z : reesAlgebra R L}
    (hz : z ∈ Subalgebra.center R (reesAlgebra R L)) :
    reesSpecializationZero R L z ∈ TauCeti.SymmetricAlgebra.lieInvariants R L L := by
  rw [← forall_reesZeroFiberBracket_eq_zero_iff_mem_lieInvariants]
  intro q
  obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
  exact reesZeroFiberBracket_reesSpecializationZero_of_commute R L
    (Subalgebra.mem_center_iff.mp hz b).symm

/-- **Degree `-1` homogeneity.** The zero-fibre Poisson bracket carries degrees `(m, n)` into degree
`m + n - 1` (with `0 - 1 = 0`, where the bracket with a scalar vanishes). -/
theorem reesZeroFiberBracket_mem_homogeneousSubmodule {m n : ℕ}
    {p q : SymmetricAlgebra R L}
    (hp : p ∈ TauCeti.SymmetricAlgebra.homogeneousSubmodule R L m)
    (hq : q ∈ TauCeti.SymmetricAlgebra.homogeneousSubmodule R L n) :
    reesZeroFiberBracket R L p q ∈
      TauCeti.SymmetricAlgebra.homogeneousSubmodule R L (m + n - 1) := by
  induction hp using Submodule.pow_induction_on_left' with
  | algebraMap r => simp
  | add p₁ p₂ k _ _ ih₁ ih₂ =>
    rw [LinearMap.map_add₂]
    exact Submodule.add_mem _ ih₁ ih₂
  | mem_mul a ha k p' hp' ih =>
    obtain ⟨x, rfl⟩ := ha
    rw [Nat.succ_add, Nat.succ_sub_one, reesZeroFiberBracket_mul_left,
      reesZeroFiberBracket_ι_left]
    refine Submodule.add_mem _ ?_ ?_
    · rcases Nat.eq_zero_or_pos (k + n) with hkn | hkn
      · obtain ⟨-, rfl⟩ := Nat.add_eq_zero_iff.mp hkn
        obtain ⟨r, rfl⟩ : q ∈ (1 : Submodule R (SymmetricAlgebra R L)) := by
          simpa [pow_zero] using hq
        simp
      · have hdeg : 1 + (k + n - 1) = k + n := by omega
        rw [← hdeg]
        exact SetLike.mul_mem_graded
          (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule R L x) ih
    · rw [add_comm k n]
      exact SetLike.mul_mem_graded
        (TauCeti.SymmetricAlgebra.lieModuleDerivation_mem_homogeneousSubmodule R L L x hq) hp'

/-- **Naturality of `reesZeroFiberBracket`.** Any Lie algebra homomorphism between free `R`-modules
induces a Poisson algebra homomorphism on symmetric algebras. -/
@[simp]
theorem map_reesZeroFiberBracket {M : Type w} [LieRing M] [LieAlgebra R M] [Module.Free R M]
    (f : L →ₗ⁅R⁆ M) (p q : SymmetricAlgebra R L) :
    SymmetricAlgebra.map R f.toLinearMap (reesZeroFiberBracket R L p q) =
      reesZeroFiberBracket R M (SymmetricAlgebra.map R f.toLinearMap p)
        (SymmetricAlgebra.map R f.toLinearMap q) := by
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
  rw [reesZeroFiberBracket_reesSpecializationZero, ← reesSpecializationZero_reesMap,
    ← reesSpecializationZero_reesMap, ← reesSpecializationZero_reesMap,
    reesMap_reesDividedCommutator, reesZeroFiberBracket_reesSpecializationZero]

/-- Over an abelian Lie algebra free over `R`, the zero-fibre Poisson bracket vanishes. -/
@[simp]
theorem reesZeroFiberBracket_eq_zero [IsLieAbelian L] (p q : SymmetricAlgebra R L) :
    reesZeroFiberBracket R L p q = 0 := by
  obtain ⟨a, rfl⟩ := reesSpecializationZero_surjective R L p
  obtain ⟨b, rfl⟩ := reesSpecializationZero_surjective R L q
  simp [reesZeroFiberBracket_reesSpecializationZero]

/-- Scaling check on generators: if `⁅x, y⁆ = c • y`, then `{ι x, ι y} = c • ι y`. -/
theorem reesZeroFiberBracket_ι_of_lie_eq_smul {x y : L} {c : R} (h : ⁅x, y⁆ = c • y) :
    reesZeroFiberBracket R L (SymmetricAlgebra.ι R L x) (SymmetricAlgebra.ι R L y) =
      c • SymmetricAlgebra.ι R L y := by
  rw [reesZeroFiberBracket_ι_ι, h, map_smul]

/-- Quadratic scaling check testing the Leibniz rule beyond linear generators: if `⁅x, y⁆ = c • y`,
then `{(ι x) ^ 2, ι y} = (2 * c) • (ι x * ι y)`. -/
theorem reesZeroFiberBracket_sq_ι_of_lie_eq_smul {x y : L} {c : R} (h : ⁅x, y⁆ = c • y) :
    reesZeroFiberBracket R L (SymmetricAlgebra.ι R L x ^ 2) (SymmetricAlgebra.ι R L y) =
      (2 * c) • (SymmetricAlgebra.ι R L x * SymmetricAlgebra.ι R L y) := by
  rw [sq, reesZeroFiberBracket_mul_left, reesZeroFiberBracket_ι_of_lie_eq_smul R L h,
    Algebra.mul_smul_comm, Algebra.smul_mul_assoc,
    mul_comm (SymmetricAlgebra.ι R L y) (SymmetricAlgebra.ι R L x), ← add_smul, ← two_mul]

end ZeroFiberBracket

/-! ### Evaluation of the zero-fibre Poisson bracket via `symmetricGradient` -/

section LinearPoissonEvaluation

/-- Evaluating `reesZeroFiberBracket R L p q` at `ξ : Module.Dual R L` gives the linear Poisson
formula `ξ ⁅b.symmetricGradient p ξ, b.symmetricGradient q ξ⁆`, for any finite basis `b` of `L`. -/
theorem lift_reesZeroFiberBracket_apply {R : Type u} [CommRing R]
    (L : Type v) [LieRing L] [LieAlgebra R L] [Module.Free R L] {ι : Type w} [Fintype ι]
    (b : Module.Basis ι R L) (p q : SymmetricAlgebra R L) (ξ : Module.Dual R L) :
    SymmetricAlgebra.lift ξ (reesZeroFiberBracket R L p q) =
      ξ ⁅b.symmetricGradient p ξ, b.symmetricGradient q ξ⁆ := by
  have hgen : ∀ (x : L) (r : SymmetricAlgebra R L),
      SymmetricAlgebra.lift ξ (reesZeroFiberBracket R L (SymmetricAlgebra.ι R L x) r) =
        ξ ⁅x, b.symmetricGradient r ξ⁆ := by
    intro x r
    induction r using SymmetricAlgebra.induction with
    | algebraMap c => simp
    | ι y => simp
    | mul r₁ r₂ h₁ h₂ =>
      rw [reesZeroFiberBracket_mul_right, map_add, map_mul, map_mul, h₁, h₂,
        b.symmetricGradient_mul, lie_add, lie_smul, lie_smul, map_add, LinearMap.map_smul,
        LinearMap.map_smul, smul_eq_mul, smul_eq_mul]
      ring
    | add r₁ r₂ h₁ h₂ => simp [h₁, h₂]
  induction p using SymmetricAlgebra.induction with
  | algebraMap c => simp
  | ι x => rw [b.symmetricGradient_ι, hgen]
  | mul p₁ p₂ h₁ h₂ =>
    rw [reesZeroFiberBracket_mul_left, map_add, map_mul, map_mul, h₁, h₂,
      b.symmetricGradient_mul, add_lie, smul_lie, smul_lie, map_add, LinearMap.map_smul,
      LinearMap.map_smul, smul_eq_mul, smul_eq_mul]
    ring
  | add p₁ p₂ h₁ h₂ => simp [h₁, h₂]

/-- Every `R`-bilinear bracket on `SymmetricAlgebra R L` satisfying the divided-commutator equation
of `exists_reesZeroFiberBracket` evaluates at `ξ ∈ L*` by the linear Poisson formula
`{p, q}(ξ) = ξ ⁅b.symmetricGradient p ξ, b.symmetricGradient q ξ⁆` (over `R = ℝ`, matching the sign
convention `P_ξ(X, Y) = ξ([X, Y])` of Gutt, *Deformation Quantization and Symmetries*, Lecture 1,
slide 14). -/
theorem lift_reesZeroFiberBracket_eq_lie_symmetricGradient {R : Type u} [CommRing R]
    (L : Type v) [LieRing L] [LieAlgebra R L] [Module.Free R L] {ι : Type w} [Fintype ι]
    (b : Module.Basis ι R L)
    (B : SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L →ₗ[R] SymmetricAlgebra R L)
    (hB : ∀ a c d : reesAlgebra R L,
      a * c - c * a = reesParameter R L * d →
      B (reesSpecializationZero R L a) (reesSpecializationZero R L c) =
        reesSpecializationZero R L d)
    (p q : SymmetricAlgebra R L) (ξ : Module.Dual R L) :
    SymmetricAlgebra.lift ξ (B p q) = ξ ⁅b.symmetricGradient p ξ, b.symmetricGradient q ξ⁆ := by
  rw [eq_reesZeroFiberBracket_of_commutator_eq hB]
  exact lift_reesZeroFiberBracket_apply L b p q ξ

end LinearPoissonEvaluation

end TauCeti.UniversalEnvelopingAlgebra
