module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Module

/-!
# Cyclic modules over the universal enveloping algebra

Let `L` be a Lie algebra over a commutative ring `R`, with universal enveloping algebra `U(L)`, and
let `J` be a left ideal of `U(L)`, that is a `U(L)`-submodule of `U(L)`. The quotient `U(L) ⧸ J` is
a `U(L)`-module generated by the class of `1`, and through
`TauCeti.UniversalEnvelopingAlgebra.asLieRingModule` an `L`-module. This file packages it as
`TauCeti.UniversalEnvelopingAlgebra.CyclicModule J`, with its canonical projection and generator.

Its universal property,
`TauCeti.UniversalEnvelopingAlgebra.existsUnique_lieModuleHom_apply_cyclicGenerator`, says that for
every vector `v` of an `L`-module `N` annihilated by `J`, zero allowed, there is a unique
homomorphism of `L`-modules `U(L) ⧸ J → N` sending the generator to `v`. It runs on the
enveloping-algebra dictionary of `TauCeti/Algebra/Lie/UniversalEnveloping/Module.lean`: Lie module
homomorphisms out of `U(L) ⧸ J` are `U(L)`-linear maps, and the Lie submodule generated by the
generator is its `U(L)`-span.

Verma modules are of this form, for the left ideal generated by the relations saying that the
generator has a given weight and is killed by the raising operators: both the finite-type
`TauCeti.VermaModule` of `TauCeti/Algebra/Lie/HighestWeight/Verma.lean` and the Kac–Moody
`TauCeti.KacMoody.VermaModule` are cyclic modules. The construction and its API are extracted from
the original quotient construction of the finite-type Verma module.

## Main definitions

* `TauCeti.UniversalEnvelopingAlgebra.CyclicModule J`: the quotient `U(L) ⧸ J`, with its
  `R`-module, `U(L)`-module and `L`-module structures.
* `TauCeti.UniversalEnvelopingAlgebra.cyclicMk J`: the canonical projection `U(L) → U(L) ⧸ J`, as
  a `U(L)`-linear map.
* `TauCeti.UniversalEnvelopingAlgebra.cyclicGenerator J`: the class of `1`.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.lie_cyclicGenerator_eq_smul_of_sub_mem` and
  `TauCeti.UniversalEnvelopingAlgebra.lie_cyclicGenerator_eq_zero_of_mem`: degree-one relations
  `ι x - c` and `ι x` in `J` make `x` act on the generator by `c` and by zero.
* `TauCeti.UniversalEnvelopingAlgebra.representation_cyclicModule_apply`: the enveloping
  representation induced by the `L`-action is the `U(L)`-module structure of `U(L) ⧸ J`.
* `TauCeti.UniversalEnvelopingAlgebra.lieSpan_cyclicGenerator_eq_top`: the generator generates
  `U(L) ⧸ J` as an `L`-module.
* `TauCeti.UniversalEnvelopingAlgebra.existsUnique_lieModuleHom_apply_cyclicGenerator`: the
  universal property.
* `TauCeti.UniversalEnvelopingAlgebra.exists_surjective_lieModuleHom_cyclicModule`: every
  `L`-module generated by a vector annihilated by `J` is a quotient of `U(L) ⧸ J`.
* `TauCeti.UniversalEnvelopingAlgebra.cyclicGenerator_eq_zero_iff` and
  `TauCeti.UniversalEnvelopingAlgebra.subsingleton_cyclicModule_iff`: the generator, and the
  module, vanish exactly when `J` is all of `U(L)`.
-/

public section

open UniversalEnvelopingAlgebra

universe u v w

namespace TauCeti.UniversalEnvelopingAlgebra

variable {R : Type u} {L : Type v} [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "U" => _root_.UniversalEnvelopingAlgebra R L

/-! ### The cyclic module and its structures -/

/-- **The cyclic module** `U(L) ⧸ J` of a left ideal `J` of the universal enveloping algebra. -/
def CyclicModule (J : Submodule U U) : Type max u v :=
  U ⧸ J

-- The local notation `U` is not available in `variable` binders, so the type is written out.
variable (J : Submodule (_root_.UniversalEnvelopingAlgebra R L)
  (_root_.UniversalEnvelopingAlgebra R L))

noncomputable instance : AddCommGroup (CyclicModule J) :=
  inferInstanceAs (AddCommGroup (U ⧸ J))

noncomputable instance : Module U (CyclicModule J) :=
  inferInstanceAs (Module U (U ⧸ J))

noncomputable instance : Module R (CyclicModule J) :=
  inferInstanceAs (Module R (U ⧸ J))

instance : IsScalarTower R U (CyclicModule J) :=
  inferInstanceAs (IsScalarTower R U (U ⧸ J))

noncomputable instance : LieRingModule L (CyclicModule J) :=
  asLieRingModule R L (CyclicModule J)

noncomputable instance : LieModule R L (CyclicModule J) :=
  asLieModule R L (CyclicModule J)

/-- The `L`-action on the cyclic module is the action of the canonical Lie generators of `U(L)`.
This is the compatibility hypothesis the enveloping-algebra dictionary consumes. -/
theorem cyclicModule_ι_smul (x : L) (m : CyclicModule J) : (ι R x : U) • m = ⁅x, m⁆ :=
  (asLieRingModule_bracket R L (CyclicModule J) x m).symm

/-- **The enveloping representation of the cyclic module is its `U(L)`-module structure**: the
action of `U(L)` induced by the `L`-action, `TauCeti.UniversalEnvelopingAlgebra.representation`, is
the scalar action of `U(L)` on the quotient `U(L) ⧸ J`. -/
theorem representation_cyclicModule_apply (u : U) (m : CyclicModule J) :
    representation R L (CyclicModule J) u m = u • m := by
  induction u using induction_ι generalizing m with
  | ι x => rw [representation_ι_apply, cyclicModule_ι_smul]
  | algebraMap r => rw [AlgHom.commutes, Module.algebraMap_end_apply, algebraMap_smul]
  | add u w hu hw => rw [map_add, LinearMap.add_apply, hu, hw, add_smul]
  | mul u w hu hw => rw [map_mul, mul_apply_eq_comp, hw, hu, mul_smul]

/-- **The canonical projection** `U(L) → U(L) ⧸ J`, as a `U(L)`-linear map. -/
noncomputable def cyclicMk : U →ₗ[U] CyclicModule J :=
  Submodule.mkQ J

theorem cyclicMk_surjective : Function.Surjective (cyclicMk J) :=
  Submodule.mkQ_surjective _

theorem cyclicMk_eq_iff {u w : U} : cyclicMk J u = cyclicMk J w ↔ u - w ∈ J :=
  Submodule.Quotient.eq _

@[simp]
theorem cyclicMk_eq_zero_iff {u : U} : cyclicMk J u = 0 ↔ u ∈ J :=
  Submodule.Quotient.mk_eq_zero _

@[simp]
theorem smul_cyclicMk (u w : U) : u • cyclicMk J w = cyclicMk J (u * w) :=
  (Submodule.Quotient.mk_smul _ u w).symm

/-- **The canonical generator** of the cyclic module, the class of `1`. -/
noncomputable def cyclicGenerator : CyclicModule J :=
  cyclicMk J 1

/-- The canonical projection sends `1` to the canonical generator. -/
@[simp]
theorem cyclicMk_one : cyclicMk J 1 = cyclicGenerator J :=
  (rfl)

@[simp]
theorem smul_cyclicGenerator (u : U) : u • cyclicGenerator J = cyclicMk J u := by
  rw [← cyclicMk_one, smul_cyclicMk, mul_one]

/-- **A Lie generator acts on the canonical generator by a scalar** `c` as soon as `ι x - c` lies
in `J`. -/
theorem lie_cyclicGenerator_eq_smul_of_sub_mem {x : L} {c : R}
    (h : (ι R x : U) - algebraMap R U c ∈ J) : ⁅x, cyclicGenerator J⁆ = c • cyclicGenerator J := by
  rw [← cyclicModule_ι_smul, smul_cyclicGenerator, ← algebraMap_smul U c, smul_cyclicGenerator,
    cyclicMk_eq_iff]
  exact h

/-- **A Lie generator kills the canonical generator** as soon as `ι x` lies in `J`. -/
theorem lie_cyclicGenerator_eq_zero_of_mem {x : L} (h : (ι R x : U) ∈ J) :
    ⁅x, cyclicGenerator J⁆ = 0 := by
  rw [← cyclicModule_ι_smul, smul_cyclicGenerator, cyclicMk_eq_zero_iff]
  exact h

/-- The canonical generator spans the cyclic module over `U(L)`. -/
theorem span_cyclicGenerator_eq_top : Submodule.span U {cyclicGenerator J} = ⊤ := by
  refine top_le_iff.mp fun m _ => ?_
  obtain ⟨u, rfl⟩ := cyclicMk_surjective J m
  rw [← smul_cyclicGenerator]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- **The canonical generator generates the cyclic module** as an `L`-module. -/
theorem lieSpan_cyclicGenerator_eq_top : LieSubmodule.lieSpan R L {cyclicGenerator J} = ⊤ := by
  refine (lieSubmoduleOrderIso (cyclicModule_ι_smul J)).injective ?_
  rw [lieSubmoduleOrderIso_lieSpan, span_cyclicGenerator_eq_top, OrderIso.map_top]

/-! ### The universal property -/

section UniversalProperty

variable {N : Type w} [AddCommGroup N] [Module R N] [LieRingModule L N] [LieModule R L N]

/-- **The universal property of the cyclic module.** If the left ideal `J` acts by zero on a vector
`v` of an `L`-module `N`, then there is a unique homomorphism of `L`-modules `U(L) ⧸ J → N` sending
the canonical generator to `v`. The vector `v` may be zero. -/
theorem existsUnique_lieModuleHom_apply_cyclicGenerator {v : N}
    (hv : ∀ u ∈ J, representation R L N u v = 0) :
    ∃! φ : CyclicModule J →ₗ⁅R,L⁆ N, φ (cyclicGenerator J) = v := by
  let _ : Module U N := asModule R L N
  have _ : IsScalarTower R U N := isScalarTower_asModule R L N
  have hN := asModule_ι_smul R L N
  have hM := cyclicModule_ι_smul J
  -- The `U(L)`-linear map `u ↦ u • v` kills `J`, so it descends to the quotient.
  have hker : J ≤ LinearMap.ker (LinearMap.toSpanSingleton U N v) := fun u hu => by
    rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, asModule_smul_def]
    exact hv u hu
  set g : CyclicModule J →ₗ[U] N := Submodule.liftQ J (LinearMap.toSpanSingleton U N v) hker
  have hg : ∀ u : U, g (cyclicMk J u) = u • v := fun u =>
    (Submodule.liftQ_apply _ _ _).trans (LinearMap.toSpanSingleton_apply _ _ _ u)
  refine ⟨(lieModuleHomEquiv hM hN).symm g, ?_, fun ψ hψ => ?_⟩
  · beta_reduce
    rw [coe_lieModuleHomEquiv_symm, ← cyclicMk_one, hg, one_smul]
  · refine (lieModuleHomEquiv hM hN).injective ?_
    rw [LinearEquiv.apply_symm_apply]
    refine LinearMap.ext_on (span_cyclicGenerator_eq_top J) ?_
    rintro x rfl
    rw [coe_lieModuleHomEquiv, hψ, ← cyclicMk_one, hg, one_smul]

/-- **Every module generated by a vector annihilated by `J` is a quotient of `U(L) ⧸ J`**: if `J`
acts by zero on `v` and `v` generates `N`, then a surjective homomorphism `U(L) ⧸ J → N` sends the
canonical generator to `v`. -/
theorem exists_surjective_lieModuleHom_cyclicModule {v : N}
    (hv : ∀ u ∈ J, representation R L N u v = 0) (hgen : LieSubmodule.lieSpan R L {v} = ⊤) :
    ∃ φ : CyclicModule J →ₗ⁅R,L⁆ N, Function.Surjective φ ∧ φ (cyclicGenerator J) = v := by
  obtain ⟨φ, hφ, -⟩ := existsUnique_lieModuleHom_apply_cyclicGenerator J hv
  refine ⟨φ, ?_, hφ⟩
  rw [← LieModuleHom.range_eq_top, ← top_le_iff, ← hgen, LieSubmodule.lieSpan_le]
  rintro w rfl
  exact ⟨cyclicGenerator J, hφ⟩

end UniversalProperty

/-! ### Nonvanishing -/

/-- **The canonical generator vanishes exactly when `J` is all of `U(L)`.** -/
theorem cyclicGenerator_eq_zero_iff : cyclicGenerator J = 0 ↔ J = ⊤ := by
  rw [← cyclicMk_one, cyclicMk_eq_zero_iff]
  refine ⟨fun h => eq_top_iff.mpr fun u _ => ?_, fun h => h ▸ trivial⟩
  simpa using Submodule.smul_mem J u h

/-- **The cyclic module vanishes exactly when `J` is all of `U(L)`.** -/
theorem subsingleton_cyclicModule_iff : Subsingleton (CyclicModule J) ↔ J = ⊤ :=
  -- `CyclicModule J` is by definition the quotient `U ⧸ J`, for which the criterion is stated.
  Submodule.Quotient.subsingleton_iff

end TauCeti.UniversalEnvelopingAlgebra
