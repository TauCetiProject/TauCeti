module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Functoriality
public import TauCeti.Algebra.Lie.UniversalEnveloping.LieIdeal

/-!
# The kernel of the enveloping algebra map of a surjection

For a surjective homomorphism `f : L → M` of Lie algebras over a commutative ring, the kernel of
the induced algebra homomorphism `U(L) → U(M)` is the ideal of `U(L)` generated by the kernel of
`f`. This is the enveloping-algebra counterpart of right exactness of the symmetric algebra
(`SymmetricAlgebra.ker_map_of_surjective`). No freeness is assumed.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.ker_map_of_surjective`: `ker U(f)` is the enveloping ideal
  of `ker f`.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

variable (R : Type*) {L M : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [LieRing M] [LieAlgebra R M]

/-- **The kernel of the enveloping algebra map of a surjection** is the ideal generated by the
kernel of the surjection. -/
theorem ker_map_of_surjective (f : L →ₗ⁅R⁆ M) (hf : Function.Surjective f) :
    RingHom.ker (map R f) = f.ker.envelopingIdeal := by
  apply le_antisymm
  · intro u hu
    set W := f.ker.envelopingIdeal
    let q := Ideal.Quotient.mkₐ R W
    -- `ι` followed by the quotient map kills the kernel of `f`, so it descends along `f`.
    have hq : ∀ a b : L, f a = f b → q (_root_.UniversalEnvelopingAlgebra.ι R a) =
        q (_root_.UniversalEnvelopingAlgebra.ι R b) := by
      intro a b hab
      rw [← sub_eq_zero, ← map_sub, ← map_sub, Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.eq_zero_iff_mem]
      exact f.ker.ι_mem_envelopingIdeal (LieHom.mem_ker.2 (by rw [map_sub, hab, sub_self]))
    let g : M → _root_.UniversalEnvelopingAlgebra R L ⧸ W := fun y =>
      q (_root_.UniversalEnvelopingAlgebra.ι R (Function.surjInv hf y))
    have hg : ∀ a, g (f a) = q (_root_.UniversalEnvelopingAlgebra.ι R a) := fun a =>
      hq _ _ (Function.surjInv_eq hf (f a))
    let θ : M →ₗ⁅R⁆ _root_.UniversalEnvelopingAlgebra R L ⧸ W :=
      { toFun := g
        map_add' := fun y y' => by
          obtain ⟨a, rfl⟩ := hf y
          obtain ⟨b, rfl⟩ := hf y'
          rw [← map_add f a b, hg]
          simp only [hg, map_add]
        map_smul' := fun c y => by
          obtain ⟨a, rfl⟩ := hf y
          rw [← map_smul f c a, hg]
          simp only [hg, map_smul, RingHom.id_apply]
        map_lie' := fun {y y'} => by
          obtain ⟨a, rfl⟩ := hf y
          obtain ⟨b, rfl⟩ := hf y'
          rw [← LieHom.map_lie f a b, hg, LieHom.map_lie]
          simp only [hg, Ring.lie_def, map_sub, map_mul] }
    have hθ : ∀ a, θ (f a) = q (_root_.UniversalEnvelopingAlgebra.ι R a) := hg
    have hcomp : (_root_.UniversalEnvelopingAlgebra.lift R θ).comp (map R f) = q := by
      apply _root_.UniversalEnvelopingAlgebra.hom_ext
      ext a
      simp [hθ]
    have : q u = 0 := by
      rw [← hcomp]
      simp [(RingHom.mem_ker.1 hu)]
    exact Ideal.Quotient.eq_zero_iff_mem.1 this
  · refine LieIdeal.envelopingIdeal_le_iff.2 fun x hx => ?_
    rw [RingHom.mem_ker, map_ι, (LieHom.mem_ker.1 hx : f x = 0), map_zero]

end TauCeti.UniversalEnvelopingAlgebra
