module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Functoriality
public import TauCeti.Algebra.Lie.UniversalEnveloping.LieIdeal
public import TauCeti.Algebra.Lie.UniversalEnveloping.Module

/-!
# Kernels of enveloping algebra maps

For a surjective homomorphism `f : L → M` of Lie algebras over a commutative ring, the kernel of
the induced algebra homomorphism `U(L) → U(M)` is the ideal of `U(L)` generated by the kernel of
`f`. This is the enveloping-algebra counterpart of right exactness of the symmetric algebra
(`SymmetricAlgebra.ker_map_of_surjective`). No freeness is assumed.

The kernel of the representation `U(L) → End M` of a Lie module, the annihilator of `M` in `U(L)`,
depends only on the isomorphism class of `M`, and the annihilator of a direct sum is the
intersection of the annihilators of the summands. In particular a direct sum of copies of one
module has the same annihilator as the module, which is how the image of `U(L)` acting on an
isotypic module is identified with its image acting on a single summand.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.ker_map_of_surjective`: `ker U(f)` is the enveloping ideal
  of `ker f`.
* `TauCeti.UniversalEnvelopingAlgebra.ker_representation_le_of_surjective`: the annihilator of a
  Lie module annihilates every quotient.
* `TauCeti.UniversalEnvelopingAlgebra.ker_representation_eq_of_lieModuleEquiv`: isomorphic Lie
  modules have the same annihilator in `U(L)`.
* `TauCeti.UniversalEnvelopingAlgebra.ker_representation_directSum`: the annihilator of a direct
  sum is the intersection of the annihilators of the summands.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

variable (R : Type*) {L M : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [LieRing M] [LieAlgebra R M]

/-- **The kernel of the enveloping algebra map of a surjection** is the ideal generated by the
kernel of the surjection. -/
theorem ker_map_of_surjective (f : L →ₗ⁅R⁆ M) (hf : Function.Surjective f) :
    RingHom.ker (map R f) = f.ker.envelopingIdeal := by
  apply le_antisymm
  · intro u hu
    set W := f.ker.envelopingIdeal
    let q := Ideal.Quotient.mkₐ R W
    -- `ι` followed by the quotient map kills the kernel of `f`, so it descends along `f`.
    have hq : ∀ a b : L, f a = f b → q (_root_.UniversalEnvelopingAlgebra.ι R a) =
        q (_root_.UniversalEnvelopingAlgebra.ι R b) := by
      intro a b hab
      rw [← sub_eq_zero, ← map_sub, ← map_sub, Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.eq_zero_iff_mem]
      exact f.ker.ι_mem_envelopingIdeal (LieHom.mem_ker.2 (by rw [map_sub, hab, sub_self]))
    let g : M → _root_.UniversalEnvelopingAlgebra R L ⧸ W := fun y =>
      q (_root_.UniversalEnvelopingAlgebra.ι R (Function.surjInv hf y))
    have hg : ∀ a, g (f a) = q (_root_.UniversalEnvelopingAlgebra.ι R a) := fun a =>
      hq _ _ (Function.surjInv_eq hf (f a))
    let θ : M →ₗ⁅R⁆ _root_.UniversalEnvelopingAlgebra R L ⧸ W :=
      { toFun := g
        map_add' := fun y y' => by
          obtain ⟨a, rfl⟩ := hf y
          obtain ⟨b, rfl⟩ := hf y'
          rw [← map_add f a b, hg]
          simp only [hg, map_add]
        map_smul' := fun c y => by
          obtain ⟨a, rfl⟩ := hf y
          rw [← map_smul f c a, hg]
          simp only [hg, map_smul, RingHom.id_apply]
        map_lie' := fun {y y'} => by
          obtain ⟨a, rfl⟩ := hf y
          obtain ⟨b, rfl⟩ := hf y'
          rw [← LieHom.map_lie f a b, hg, LieHom.map_lie]
          simp only [hg, Ring.lie_def, map_sub, map_mul] }
    have hθ : ∀ a, θ (f a) = q (_root_.UniversalEnvelopingAlgebra.ι R a) := hg
    have hcomp : (_root_.UniversalEnvelopingAlgebra.lift R θ).comp (map R f) = q := by
      apply _root_.UniversalEnvelopingAlgebra.hom_ext
      ext a
      simp [hθ]
    have : q u = 0 := by
      rw [← hcomp]
      simp [(RingHom.mem_ker.1 hu)]
    exact Ideal.Quotient.eq_zero_iff_mem.1 this
  · refine LieIdeal.envelopingIdeal_le_iff.2 fun x hx => ?_
    rw [RingHom.mem_ker, map_ι, (LieHom.mem_ker.1 hx : f x = 0), map_zero]

section Representation

variable {R} {V W : Type*} [AddCommGroup V] [Module R V] [LieRingModule L V] [LieModule R L V]
  [AddCommGroup W] [Module R W] [LieRingModule L W] [LieModule R L W]

/-- **The annihilator of a Lie module annihilates its quotients**: along a surjective morphism of
Lie modules, the kernel of the enveloping-algebra representation can only grow. -/
theorem ker_representation_le_of_surjective {f : V →ₗ⁅R,L⁆ W} (hf : Function.Surjective f) :
    RingHom.ker (representation R L V) ≤ RingHom.ker (representation R L W) := by
  intro u hu
  rw [RingHom.mem_ker] at hu ⊢
  ext w
  obtain ⟨v, rfl⟩ := hf w
  rw [← map_representation, hu, LinearMap.zero_apply, map_zero, LinearMap.zero_apply]

/-- **Isomorphic Lie modules have the same annihilator in the enveloping algebra.** -/
theorem ker_representation_eq_of_lieModuleEquiv (e : V ≃ₗ⁅R,L⁆ W) :
    RingHom.ker (representation R L V) = RingHom.ker (representation R L W) :=
  le_antisymm (ker_representation_le_of_surjective (f := e.toLieModuleHom) e.surjective)
    (ker_representation_le_of_surjective (f := e.symm.toLieModuleHom) e.symm.surjective)

/-- **The annihilator of a direct sum** of Lie modules in the enveloping algebra is the
intersection of the annihilators of the summands. -/
theorem ker_representation_directSum {ι : Type*} {P : ι → Type*}
    [∀ i, AddCommGroup (P i)] [∀ i, Module R (P i)] [∀ i, LieRingModule L (P i)]
    [∀ i, LieModule R L (P i)] :
    RingHom.ker (representation R L (DirectSum ι P)) =
      ⨅ i, RingHom.ker (representation R L (P i)) := by
  classical
  ext u
  simp only [RingHom.mem_ker, Submodule.mem_iInf]
  refine ⟨fun hu i ↦ LinearMap.ext fun x ↦ DirectSum.of_injective (β := P) i ?_,
    fun hu ↦ DirectSum.linearMap_ext R fun i ↦ LinearMap.ext fun x ↦ ?_⟩
  · have h := representation_lof (R := R) (L := L) i u x
    rw [hu, LinearMap.zero_apply] at h
    rw [← DirectSum.lof_eq_of R, ← h, LinearMap.zero_apply, map_zero]
  · rw [LinearMap.comp_apply, representation_lof, hu i, LinearMap.zero_apply, map_zero,
      LinearMap.zero_comp, LinearMap.zero_apply]

end Representation

end TauCeti.UniversalEnvelopingAlgebra
