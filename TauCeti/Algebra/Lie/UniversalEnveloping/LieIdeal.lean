module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Basic
public import Mathlib.Algebra.Lie.Ideal
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Lie ideals in universal enveloping algebras

A Lie ideal `I` of `L` generates a two-sided ideal of the universal enveloping algebra `U(L)`.
Although `Ideal.span (ι '' I)` is initially only a left ideal, the commutator relation
`ι x * ι y = ι [x, y] + ι y * ι x` and the Lie-ideal property show that it is also
closed under multiplication on the right.

The final two results identify the ideal generated by `I` after quotienting by a two-sided ideal
`J`. In particular, the preimage in `U(L)` of the ideal generated by the image of `I` in `U(L) / J`
is exactly `J ⊔ I.envelopingIdeal`. This is the ideal construction used in the Ado--Iwasawa
proof: `I` is the nilradical and `J` is a power of the augmentation ideal.

These declarations live in the root `LieIdeal` namespace, extending Mathlib's API and supporting
receiver notation on the Lie ideal.

## Main definitions and results

* `LieIdeal.envelopingIdeal`: the ideal of `U(L)` generated by a Lie ideal `I`.
* `LieIdeal.envelopingIdeal_eq_span`: its description as the span of the canonical images.
* `LieIdeal.envelopingIdeal_le_iff`: its universal property as a generated ideal.
* `LieIdeal.envelopingIdeal.isTwoSided`: the generated ideal is two-sided.
* `LieIdeal.envelopingIdeal_map_quotientMk`: its image in a quotient is generated by the images
  of the elements of `I`.
* `LieIdeal.comap_span_image_ι_quotientMk`: the preimage of that ideal is
  `J ⊔ I.envelopingIdeal`.

## References

The ideal construction and its use in the proof of Ado's theorem follow W. Fulton and J. Harris,
*Representation Theory: A First Course*, Appendix E.
-/

public section

namespace TauCeti

universe u v

variable {R : Type u} {L : Type v} [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "U" => UniversalEnvelopingAlgebra R L

-- Mathlib does not register the Lie ring of an associative ring as a global instance; the
-- commutator relation in the enveloping algebra is used below.
attribute [local instance 100] LieRing.ofAssociativeRing

/-- **The ideal generated by a Lie ideal in the universal enveloping algebra.** For a Lie ideal
`I` of `L`, this is initially the left ideal spanned by the canonical images of its elements.
`LieIdeal.envelopingIdeal.isTwoSided` shows that it is also a two-sided ideal. -/
def _root_.LieIdeal.envelopingIdeal (I : LieIdeal R L) : Ideal U :=
  Ideal.span (UniversalEnvelopingAlgebra.ι R '' (I : Set L))

/-- The enveloping ideal of `I` is the ideal spanned by the canonical images of its elements. -/
theorem _root_.LieIdeal.envelopingIdeal_eq_span (I : LieIdeal R L) :
    I.envelopingIdeal = Ideal.span (UniversalEnvelopingAlgebra.ι R '' (I : Set L)) :=
  (rfl)

/-- **The universal property of the enveloping ideal.** It is contained in an ideal `J` exactly
when `J` contains the canonical image of every element of the Lie ideal. -/
@[simp]
theorem _root_.LieIdeal.envelopingIdeal_le_iff {I : LieIdeal R L} {J : Ideal U} :
    I.envelopingIdeal ≤ J ↔
      ∀ x : L, x ∈ I → UniversalEnvelopingAlgebra.ι R x ∈ J := by
  rw [I.envelopingIdeal_eq_span, Ideal.span_le]
  constructor
  · intro h x hx
    exact h ⟨x, hx, rfl⟩
  · rintro h _ ⟨x, hx, rfl⟩
    exact h x hx

/-- A member of a Lie ideal maps into the ideal it generates in the enveloping algebra. -/
theorem _root_.LieIdeal.ι_mem_envelopingIdeal (I : LieIdeal R L) {x : L} (hx : x ∈ I) :
    UniversalEnvelopingAlgebra.ι R x ∈ I.envelopingIdeal :=
  Ideal.subset_span ⟨x, hx, rfl⟩

/-- The enveloping ideal construction is monotone. -/
@[gcongr]
theorem _root_.LieIdeal.envelopingIdeal_mono {I J : LieIdeal R L} (h : I ≤ J) :
    I.envelopingIdeal ≤ J.envelopingIdeal :=
  LieIdeal.envelopingIdeal_le_iff.mpr fun _ hx => J.ι_mem_envelopingIdeal (h hx)

/-- The zero Lie ideal generates the zero ideal of the universal enveloping algebra. -/
@[simp]
theorem _root_.LieIdeal.envelopingIdeal_bot :
    (⊥ : LieIdeal R L).envelopingIdeal = ⊥ := by
  apply le_antisymm
  · rw [LieIdeal.envelopingIdeal_le_iff]
    intro x hx
    simp only [LieSubmodule.mem_bot] at hx
    subst x
    simpa only [map_zero] using (⊥ : Ideal U).zero_mem
  · exact bot_le

/-- The enveloping ideal construction preserves binary suprema. -/
@[simp]
theorem _root_.LieIdeal.envelopingIdeal_sup (I J : LieIdeal R L) :
    (I ⊔ J).envelopingIdeal = I.envelopingIdeal ⊔ J.envelopingIdeal := by
  apply le_antisymm
  · rw [LieIdeal.envelopingIdeal_le_iff]
    intro x hx
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
    rw [map_add]
    exact add_mem
      ((show I.envelopingIdeal ≤ I.envelopingIdeal ⊔ J.envelopingIdeal from le_sup_left)
        (I.ι_mem_envelopingIdeal hy))
      ((show J.envelopingIdeal ≤ I.envelopingIdeal ⊔ J.envelopingIdeal from le_sup_right)
        (J.ι_mem_envelopingIdeal hz))
  · exact sup_le (LieIdeal.envelopingIdeal_mono le_sup_left)
      (LieIdeal.envelopingIdeal_mono le_sup_right)

/-- The top Lie ideal generates the ideal spanned by all canonical Lie generators. -/
@[simp]
theorem _root_.LieIdeal.envelopingIdeal_top :
    (⊤ : LieIdeal R L).envelopingIdeal =
      Ideal.span (Set.range (UniversalEnvelopingAlgebra.ι R)) := by
  rw [LieIdeal.envelopingIdeal_eq_span]
  congr 1
  ext x
  simp

/-- **The ideal generated by a Lie ideal is two-sided.** Right multiplication by a canonical
generator preserves it because commuting that generator to the left produces the image of a Lie
bracket, which remains in the Lie ideal. Induction on the generators then gives closure under
right multiplication by every element of `U(L)`. -/
instance _root_.LieIdeal.envelopingIdeal.isTwoSided (I : LieIdeal R L) :
    I.envelopingIdeal.IsTwoSided := by
  constructor
  intro a b ha
  induction b using UniversalEnvelopingAlgebra.induction_ι R L generalizing a with
  | ι y =>
    induction ha using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨x, hx, rfl⟩ := hz
      have hxy : ⁅x, y⁆ ∈ I := lie_mem_left R L I x y hx
      have hmap := (UniversalEnvelopingAlgebra.ι R).map_lie x y
      rw [LieRing.of_associative_ring_bracket] at hmap
      rw [(eq_sub_iff_add_eq.mp hmap).symm]
      exact I.envelopingIdeal.add_mem (I.ι_mem_envelopingIdeal hxy)
        (I.envelopingIdeal.mul_mem_left (UniversalEnvelopingAlgebra.ι R y)
          (I.ι_mem_envelopingIdeal hx))
    | zero => rw [zero_mul]; exact I.envelopingIdeal.zero_mem
    | add x y _ _ hx hy => rw [add_mul]; exact I.envelopingIdeal.add_mem hx hy
    | smul c x _ hx =>
      rw [smul_eq_mul, mul_assoc]
      exact I.envelopingIdeal.mul_mem_left c hx
  | algebraMap r =>
    rw [← Algebra.commutes r a]
    exact I.envelopingIdeal.mul_mem_left _ ha
  | add b c hb hc =>
    rw [mul_add]
    exact I.envelopingIdeal.add_mem (hb ha) (hc ha)
  | mul b c hb hc =>
    rw [← mul_assoc]
    exact hc (hb ha)

/-- The image in `U(L) / J` of the enveloping ideal generated by `I` is the ideal spanned by the
images of the elements of `I`. -/
theorem _root_.LieIdeal.envelopingIdeal_map_quotientMk (I : LieIdeal R L) (J : Ideal U)
    [J.IsTwoSided] :
    I.envelopingIdeal.map (Ideal.Quotient.mk J) =
      Ideal.span
        ((fun x : L => Ideal.Quotient.mk J (UniversalEnvelopingAlgebra.ι R x)) ''
          (I : Set L)) := by
  rw [I.envelopingIdeal_eq_span, Ideal.map_span, Set.image_image]

/-- **The preimage formula for an enveloping ideal in a quotient.** The preimage in `U(L)` of the
ideal generated by the image of `I` in `U(L) / J` is the supremum of `J` and the ideal generated
by `I` in `U(L)`. -/
theorem _root_.LieIdeal.comap_span_image_ι_quotientMk (I : LieIdeal R L) (J : Ideal U)
    [J.IsTwoSided] :
    (Ideal.span
          ((fun x : L => Ideal.Quotient.mk J (UniversalEnvelopingAlgebra.ι R x)) ''
            (I : Set L))).comap
        (Ideal.Quotient.mk J) =
      J ⊔ I.envelopingIdeal := by
  rw [← I.envelopingIdeal_map_quotientMk J, Ideal.comap_map_quotientMk]

end TauCeti
