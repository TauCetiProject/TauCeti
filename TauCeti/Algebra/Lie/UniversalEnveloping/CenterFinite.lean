module

public import TauCeti.Algebra.Lie.UniversalEnveloping.FiniteOverCenter
public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.CentralExtension

/-!
# The center of an enveloping algebra in positive characteristic

In prime characteristic the enveloping algebra of a finite-dimensional Lie algebra is
finite over the Noetherian algebra generated by central `p`-polynomials. Consequently it
is finite over its whole center, and that center is Noetherian. The central augmentation
ideal is extended from an ideal of this commutative center, so Mathlib's generalized
Krull intersection theorem describes the elements in every power of that ideal.

This is the commutative-algebra step in G. Hochschild, *An Addition to Ado's Theorem*,
Proc. Amer. Math. Soc. **17** (1966), 531–533.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v

variable (K : Type u) (L : Type v) [Field K] [LieRing L] [LieAlgebra K L]

local notation "U" => _root_.UniversalEnvelopingAlgebra K L

private theorem center_noetherian_and_finite (p : ℕ) [Fact p.Prime] [CharP K p]
    [FiniteDimensional K L] :
    IsNoetherianRing (Subalgebra.center K U) ∧
      Module.Finite (Subalgebra.center K U) U := by
  obtain ⟨_, _, c, _, _, h⟩ := exists_pCentralGenerators_moduleFinite K L p
  let S := Algebra.adjoin K (Set.range c)
  have hNoetherian : IsNoetherianRing S := h.1
  have hFinite : Module.Finite S U := h.2
  exact ⟨@Subalgebra.isNoetherianRing_center_of_finite K U _ _ _ S
      hNoetherian hFinite,
    @Subalgebra.finite_over_center_of_finite K U _ _ _ S hFinite⟩

/-- In positive characteristic, the center of `U(L)` is Noetherian. -/
theorem isNoetherianRing_center (p : ℕ) [Fact p.Prime] [CharP K p]
    [FiniteDimensional K L] : IsNoetherianRing (Subalgebra.center K U) :=
  (center_noetherian_and_finite K L p).1

/-- In positive characteristic, `U(L)` is finite over its center. -/
theorem moduleFinite_over_center (p : ℕ) [Fact p.Prime] [CharP K p]
    [FiniteDimensional K L] : Module.Finite (Subalgebra.center K U) U :=
  (center_noetherian_and_finite K L p).2

/-- Krull intersection for the full central augmentation ideal of `U(L)` in positive
characteristic: an element lies in every power exactly when a central element of
augmentation zero fixes it by multiplication. -/
theorem mem_iInf_centralAugmentationIdeal_pow_iff (p : ℕ) [Fact p.Prime] [CharP K p]
    [FiniteDimensional K L] (x : U) :
    x ∈ ⨅ n : ℕ, HopfIdeal.centralAugmentationIdeal K U ^ n ↔
      ∃ z ∈ HopfIdeal.centralAugmentationCenterIdeal K U, (z : U) * x = x := by
  exact @HopfIdeal.mem_iInf_centralAugmentationIdeal_pow_iff K U _ _ _
    (isNoetherianRing_center K L p) (moduleFinite_over_center K L p) x

end TauCeti.UniversalEnvelopingAlgebra
