module

public import TauCeti.Algebra.Lie.UniversalEnveloping.PCenter

/-!
# The central augmentation ideal of a universal enveloping algebra

For a Lie algebra `L` over a commutative ring `R`, let `U(L)` be its universal enveloping
algebra.  This file packages the intersection

`C(L) = Z(U(L)) ∩ U⁺(L)`

of the centre with the augmentation ideal, and the ideal `U(L) C(L)` that it generates.  The
generated ideal is two-sided: its generators are central, so a right multiplier can be moved to
the left before the defining left-ideal closure is applied.  It is also a proper ideal whenever
`R` is nontrivial, since it is contained in the augmentation ideal.

In positive characteristic, the central `p`-polynomials attached to elements of `L` belong to
`C(L)`.  If `x` is nilpotent in the adjoint representation, a Frobenius power of `ι x` itself
belongs to `C(L)`.  Taking powers then puts an explicit power of `ι x` in every power of the
generated ideal.  This is the input that later makes `x` act nilpotently on a quotient by such a
power.

## Main definitions and results

* `TauCeti.UniversalEnvelopingAlgebra.centralAugmentation`: the submodule
  `Z(U(L)) ∩ U⁺(L)`.
* `TauCeti.UniversalEnvelopingAlgebra.centralAugmentationIdeal`: the ideal generated by that
  intersection.
* `TauCeti.UniversalEnvelopingAlgebra.instIsTwoSidedCentralAugmentationIdeal`: the generated ideal
  is two-sided.
* `TauCeti.UniversalEnvelopingAlgebra.exists_finset_span_eq_centralAugmentationIdeal`: over a
  left-Noetherian enveloping algebra, finitely many elements of the intersection generate the
  ideal.
* `TauCeti.UniversalEnvelopingAlgebra.exists_pCentralPolynomial_mem_centralAugmentation`: a
  central `p`-polynomial belongs to the intersection.
* The final theorem puts an explicit power of `ι x` in every power of the generated ideal when
  `ad x` is nilpotent.

## References

* G. Hochschild, *An Addition to Ado's Theorem*, Proceedings of the American Mathematical
  Society **17** (1966), 531--533.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v

variable (R : Type u) (L : Type v) [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "U" => _root_.UniversalEnvelopingAlgebra R L

/-- The central part of the augmentation ideal of `U(L)`, namely `Z(U(L)) ∩ U⁺(L)`.

It is packaged as an `R`-submodule because it is used as a set of generators.  It is not a
unital subalgebra: over a nontrivial base ring, `1` does not belong to the augmentation ideal. -/
noncomputable def centralAugmentation : Submodule R U :=
  (Subalgebra.center R U).toSubmodule ⊓
    (HopfIdeal.augmentation R U).toIdeal.restrictScalars R

/-- Membership in the central augmentation submodule means being both central and augmented. -/
@[simp]
theorem mem_centralAugmentation {z : U} :
    z ∈ centralAugmentation R L ↔
      z ∈ Subalgebra.center R U ∧ z ∈ (HopfIdeal.augmentation R U).toIdeal := by
  simp [centralAugmentation]

/-- The central augmentation submodule is contained in the centre. -/
theorem centralAugmentation_le_center :
    centralAugmentation R L ≤ (Subalgebra.center R U).toSubmodule :=
  inf_le_left

/-- The central augmentation submodule is contained in the augmentation ideal. -/
theorem centralAugmentation_le_augmentation :
    centralAugmentation R L ≤
      (HopfIdeal.augmentation R U).toIdeal.restrictScalars R :=
  inf_le_right

/-- The ideal of `U(L)` generated by its central elements of augmentation zero. -/
noncomputable def centralAugmentationIdeal : Ideal U :=
  Ideal.span (centralAugmentation R L : Set U)

/-- The universal property of the central augmentation ideal. -/
@[simp]
theorem centralAugmentationIdeal_le_iff {I : Ideal U} :
    centralAugmentationIdeal R L ≤ I ↔
      (centralAugmentation R L : Set U) ⊆ I := by
  rw [centralAugmentationIdeal, Ideal.span_le]

/-- A central element of augmentation zero belongs to the ideal generated by all such elements. -/
theorem mem_centralAugmentationIdeal {z : U} (hz : z ∈ centralAugmentation R L) :
    z ∈ centralAugmentationIdeal R L :=
  Ideal.subset_span hz

/-- The ideal generated by the central elements of augmentation zero is two-sided. -/
instance instIsTwoSidedCentralAugmentationIdeal :
    (centralAugmentationIdeal R L).IsTwoSided where
  mul_mem_of_left b ha := by
    refine Submodule.span_induction (p := fun a _ ↦ a * b ∈ centralAugmentationIdeal R L)
      (fun a ha ↦ ?_) (by simp) (fun x y _ _ hx hy ↦ ?_)
      (fun c x _ hx ↦ ?_) ha
    · rw [← (Subalgebra.mem_center_iff.mp ((mem_centralAugmentation R L).mp ha).1 b)]
      exact Ideal.mul_mem_left _ b (mem_centralAugmentationIdeal R L ha)
    · rw [add_mul]
      exact Ideal.add_mem _ hx hy
    · rw [smul_eq_mul, mul_assoc]
      exact Ideal.mul_mem_left _ c hx

/-- The central augmentation ideal is contained in the augmentation ideal. -/
theorem centralAugmentationIdeal_le_augmentation :
    centralAugmentationIdeal R L ≤ (HopfIdeal.augmentation R U).toIdeal := by
  rw [centralAugmentationIdeal, Ideal.span_le]
  exact fun _ hz ↦ ((mem_centralAugmentation R L).mp hz).2

/-- Over a nontrivial base ring, the central augmentation ideal is proper. -/
theorem centralAugmentationIdeal_ne_top [Nontrivial R] :
    centralAugmentationIdeal R L ≠ ⊤ := by
  have hproper : (HopfIdeal.augmentation R U).toIdeal ≠ ⊤ := by
    rw [HopfIdeal.augmentation_toIdeal]
    exact RingHom.ker_ne_top _
  exact ne_top_of_le_ne_top hproper (centralAugmentationIdeal_le_augmentation R L)

/-- A left-Noetherian enveloping algebra admits a finite generating set for its central
augmentation ideal whose members are themselves central and of augmentation zero.

The containment of the generators in `centralAugmentation R L` is essential: finite generation
of the ideal alone could choose arbitrary linear combinations and would not provide the central
scalars used in the positive-characteristic construction. -/
theorem exists_finset_span_eq_centralAugmentationIdeal [IsNoetherianRing U] :
    ∃ s : Finset U, (s : Set U) ⊆ centralAugmentation R L ∧
      Ideal.span (s : Set U) = centralAugmentationIdeal R L := by
  have hfg : (Ideal.span (centralAugmentation R L : Set U)).FG :=
    Ideal.fg_of_isNoetherianRing _
  obtain ⟨s, hs, hspan⟩ :=
    (Submodule.fg_span_iff_fg_span_finset_subset
      (R := U) (centralAugmentation R L : Set U)).mp hfg
  exact ⟨s, hs, hspan.symm⟩

section ExpChar

variable {R L}

/-- A central `p`-polynomial with zero constant term belongs to the central augmentation
submodule. -/
theorem pPolynomial_ι_mem_centralAugmentation {p : ℕ} (hp : p ≠ 0) (e : ℕ)
    (a : Fin e → R) (x : L)
    (hcentral : _root_.UniversalEnvelopingAlgebra.ι R x ^ p ^ e +
        ∑ i : Fin e, a i • _root_.UniversalEnvelopingAlgebra.ι R x ^ p ^ (i : ℕ) ∈
      Subalgebra.center R U) :
    _root_.UniversalEnvelopingAlgebra.ι R x ^ p ^ e +
        ∑ i : Fin e, a i • _root_.UniversalEnvelopingAlgebra.ι R x ^ p ^ (i : ℕ) ∈
      centralAugmentation R L := by
  rw [mem_centralAugmentation]
  exact ⟨hcentral, pPolynomial_ι_mem_augmentation_toIdeal R L hp e a x⟩

/-- Every element has a central `p`-polynomial in the central augmentation submodule as soon as
`Module.End R L` is Noetherian. -/
theorem exists_pCentralPolynomial_mem_centralAugmentation (p : ℕ) [ExpChar R p]
    [IsNoetherian R (Module.End R L)] (x : L) :
    ∃ (e : ℕ) (a : Fin e → R),
      _root_.UniversalEnvelopingAlgebra.ι R x ^ p ^ e +
          ∑ i : Fin e, a i • _root_.UniversalEnvelopingAlgebra.ι R x ^ p ^ (i : ℕ) ∈
        centralAugmentation R L := by
  obtain ⟨e, a, hcentral⟩ := exists_pCentralPolynomial_of_isNoetherian R L p x
  exact ⟨e, a, pPolynomial_ι_mem_centralAugmentation (expChar_ne_zero R p) e a x hcentral⟩

/-- If `ad x` is nilpotent in exponential characteristic `p ≠ 1`, then a Frobenius power of
`ι x` belongs to the central augmentation submodule. -/
theorem exists_pow_ι_mem_centralAugmentation_of_isNilpotent_ad (p : ℕ) [ExpChar R p]
    (hp : p ≠ 1) {x : L} (h : IsNilpotent (LieAlgebra.ad R L x)) :
    ∃ e : ℕ, _root_.UniversalEnvelopingAlgebra.ι R x ^ p ^ e ∈ centralAugmentation R L := by
  obtain ⟨e, hcentral⟩ := exists_pow_ι_mem_center_of_isNilpotent_ad p hp h
  refine ⟨e, (mem_centralAugmentation R L).mpr ⟨hcentral, ?_⟩⟩
  exact pow_ι_mem_augmentation_toIdeal R L x (pow_ne_zero e (expChar_ne_zero R p))

/-- If `ad x` is nilpotent, every power of the central augmentation ideal contains the
corresponding power of a Frobenius power of `ι x`. -/
theorem exists_pow_mul_ι_mem_centralAugmentationIdeal_pow_of_isNilpotent_ad
    (p : ℕ) [ExpChar R p] (hp : p ≠ 1) {x : L}
    (h : IsNilpotent (LieAlgebra.ad R L x)) (n : ℕ) :
    ∃ e : ℕ, _root_.UniversalEnvelopingAlgebra.ι R x ^ (p ^ e * n) ∈
      centralAugmentationIdeal R L ^ n := by
  obtain ⟨e, he⟩ := exists_pow_ι_mem_centralAugmentation_of_isNilpotent_ad p hp h
  refine ⟨e, ?_⟩
  rw [pow_mul]
  exact Ideal.pow_mem_pow (mem_centralAugmentationIdeal R L he) n

end ExpChar

section Field

variable (K : Type u) [Field K]
variable (L : Type v) [LieRing L] [LieAlgebra K L]

/-- Every element of a finite-dimensional Lie algebra over a field of characteristic `p` has a
central `p`-polynomial in `Z(U(L)) ∩ U⁺(L)`. -/
theorem exists_pCentralPolynomial_mem_centralAugmentation_of_finiteDimensional
    (p : ℕ) [Fact p.Prime] [CharP K p] [FiniteDimensional K L] (x : L) :
    ∃ (e : ℕ) (a : Fin e → K),
      _root_.UniversalEnvelopingAlgebra.ι K x ^ p ^ e +
          ∑ i : Fin e, a i • _root_.UniversalEnvelopingAlgebra.ι K x ^ p ^ (i : ℕ) ∈
        centralAugmentation K L :=
  exists_pCentralPolynomial_mem_centralAugmentation (R := K) (L := L) p x

end Field

end TauCeti.UniversalEnvelopingAlgebra
