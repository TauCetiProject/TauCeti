module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Functoriality

/-!
# Naturality of the universal property of the enveloping algebra

A Lie homomorphism `σ : L → A` into an associative algebra extends uniquely to an algebra
homomorphism `UniversalEnvelopingAlgebra.lift R σ : U(L) → A`. This file records how that
extension interacts with the two kinds of maps a representation-theoretic argument moves along.

* Along a Lie homomorphism `f : L → M` of the source, lifting `σ : M → A` after the induced map
  `TauCeti.UniversalEnvelopingAlgebra.map R f : U(L) → U(M)` is lifting `σ ∘ f`
  (`TauCeti.UniversalEnvelopingAlgebra.lift_comp_map`). Restricting a representation of `M` to
  `L` therefore restricts the corresponding `U(M)`-action along `U(L) → U(M)`.
* Along a linear map `f : M → N` between two modules on which `L` acts through Lie homomorphisms
  `σ` and `τ` into their endomorphisms, intertwining the actions of `L` already intertwines the
  actions of all of `U(L)` (`UniversalEnvelopingAlgebra.map_lift_apply_of_map_apply`),
  because `U(L)` is generated by `L`.

Both statements are about lifts of Lie homomorphisms rather than about Lie module instances, so
they apply to actions given as data, such as the differential of a group representation. The
second is the instance-free form of `TauCeti.UniversalEnvelopingAlgebra.map_representation`.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.lift_comp_map`: lifting after an enveloping-algebra map is
  lifting the composite Lie homomorphism.
* `UniversalEnvelopingAlgebra.map_lift_apply_of_map_apply`: a linear map intertwining two
  actions of `L` intertwines the corresponding actions of `U(L)`.
-/

public section

-- Mathlib does not register the Lie ring of an associative ring as a global instance; the
-- targets of the lifted Lie homomorphisms carry it.
attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti.UniversalEnvelopingAlgebra

variable (R : Type*) [CommRing R]
variable {L M : Type*} [LieRing L] [LieAlgebra R L] [LieRing M] [LieAlgebra R M]

/-- Lifting a Lie homomorphism `σ` out of `M` after the enveloping-algebra map of `f : L → M` is
lifting the composite `σ ∘ f`. -/
@[simp]
theorem lift_comp_map {A : Type*} [Ring A] [Algebra R A] (f : L →ₗ⁅R⁆ M) (σ : M →ₗ⁅R⁆ A) :
    (_root_.UniversalEnvelopingAlgebra.lift R σ).comp (map R f) =
      _root_.UniversalEnvelopingAlgebra.lift R (σ.comp f) := by
  apply _root_.UniversalEnvelopingAlgebra.hom_ext
  apply LieHom.ext
  intro x
  simp only [AlgHom.coe_toLieHom, LieHom.comp_apply, AlgHom.comp_apply, map_ι,
    _root_.UniversalEnvelopingAlgebra.lift_ι_apply]

end TauCeti.UniversalEnvelopingAlgebra

namespace UniversalEnvelopingAlgebra

variable {R : Type*} [CommRing R] {L : Type*} [LieRing L] [LieAlgebra R L]

/-- **A linear map intertwining two actions of `L` intertwines their extensions to `U(L)`**: if
`f (σ x m) = τ x (f m)` for every `x : L`, then `f (lift σ u m) = lift τ u (f m)` for every
element `u` of the enveloping algebra. -/
theorem map_lift_apply_of_map_apply {V W : Type*} [AddCommGroup V] [Module R V]
    [AddCommGroup W] [Module R W] {σ : L →ₗ⁅R⁆ Module.End R V} {τ : L →ₗ⁅R⁆ Module.End R W}
    (f : V →ₗ[R] W) (h : ∀ x v, f (σ x v) = τ x (f v))
    (u : UniversalEnvelopingAlgebra R L) (v : V) :
    f (lift R σ u v) = lift R τ u (f v) := by
  induction u using TauCeti.UniversalEnvelopingAlgebra.induction_ι generalizing v with
  | ι x => simp only [lift_ι_apply, h]
  | algebraMap r => simp only [AlgHom.commutes, Module.algebraMap_end_apply, map_smul]
  | add a b ha hb => simp only [map_add, LinearMap.add_apply, ha, hb]
  | mul a b ha hb => simp only [map_mul, Module.End.mul_apply, ha, hb]

end UniversalEnvelopingAlgebra
