module

public import TauCeti.Algebra.Lie.UniversalEnveloping.PBW.Polynomial.Basis
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Form
public import TauCeti.RingTheory.Polynomial.Binomial.Basis
public import TauCeti.RingTheory.DividedPowers.Basis
public import Mathlib.LinearAlgebra.Basis.Submodule

/-!
# Mixed binomial and divided-power PBW bases

For an ordered basis `b` of a rational Lie algebra, mark the Cartan coordinates by a finite set
`c`. The products, in increasing coordinate order, of binomial coefficients on the marked
coordinates and divided powers on the other coordinates form the rational basis
`Module.Basis.pbwKostantBasis`. In a negative-root, Cartan, positive-root ordering these are
exactly the monomials `F⁽ᵃ⁾ ∏ⱼ (Hⱼ choose bⱼ) E⁽ᶜ⁾`.

Their integral span has a canonical integral basis and unique finite integral expansions.
Every monomial belongs to the Kostant subring generated by the corresponding root and Cartan
families. Equality of that subring with the integral span requires integral straightening:
no such equality or multiplicative closure of the span is asserted here. No root-system,
commuting-Cartan, or Chevalley assumptions are needed for the basis and independence results.

The construction applies the ordered polynomial PBW equivalence to the binomial polynomial
basis on Cartan coordinates and the factorial-normalized monomial basis on root coordinates.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace Module.Basis

open Polynomial TauCeti TauCeti.Associative TauCeti.UniversalEnvelopingAlgebra

attribute [local instance] TauCeti.moduleNNRat

variable {L : Type*} [LieRing L] [LieAlgebra ℚ L] {n : ℕ} (b : Basis (Fin n) ℚ L)

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L

private noncomputable def mixedPolynomialBasis (c : Finset (Fin n)) (i : Fin n) :
    Basis ℕ ℚ ℚ[X] :=
  if i ∈ c then binomialPolynomialBasis ℚ else dividedPowerPolynomialBasis

private theorem aeval_mixedPolynomialBasis (c : Finset (Fin n)) (i : Fin n) (k : ℕ) (x : U) :
    aeval x (mixedPolynomialBasis c i k) =
      if i ∈ c then Ring.choose x k else dividedPower k x := by
  by_cases hi : i ∈ c
  · simp only [mixedPolynomialBasis, hi, ↓reduceIte, binomialPolynomialBasis_apply]
    simpa only [aeval_X] using Ring.map_choose (aeval x) (X : ℚ[X]) k
  · simp only [mixedPolynomialBasis, hi, ↓reduceIte, dividedPowerPolynomialBasis_apply,
      map_dividedPower, aeval_X]

/-- The ordered mixed PBW basis, using Cartan binomials at the coordinates in `c` and root
divided powers at the remaining coordinates. It is a rational basis without any Chevalley
relations or commutativity assumptions on the marked coordinates. -/
noncomputable def pbwKostantBasis (c : Finset (Fin n)) : Basis (Fin n → ℕ) ℚ U :=
  b.pbwPolynomialBasis (mixedPolynomialBasis c)

/-- A mixed PBW basis vector is the increasing product of Cartan binomials and root divided
powers specified by its exponent vector. -/
theorem pbwKostantBasis_apply (c : Finset (Fin n)) (a : Fin n → ℕ) :
    b.pbwKostantBasis c a =
      (List.ofFn fun i => if i ∈ c then Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (b i))
        (a i) else dividedPower (a i) (_root_.UniversalEnvelopingAlgebra.ι ℚ (b i))).prod := by
  rw [pbwKostantBasis, pbwPolynomialBasis_apply]
  simp only [aeval_mixedPolynomialBasis]

/-- The constant mixed PBW monomial is the identity. -/
@[simp]
theorem pbwKostantBasis_zero (c : Finset (Fin n)) : b.pbwKostantBasis c 0 = 1 := by
  simp [pbwKostantBasis_apply]

/-- Each mixed PBW monomial lies in the Kostant form generated by the unmarked basis vectors as
roots and the marked basis vectors as Cartan generators. -/
theorem pbwKostantBasis_mem_kostantForm (c : Finset (Fin n)) (a : Fin n → ℕ) :
    b.pbwKostantBasis c a ∈
      kostantForm (fun i : {i // i ∉ c} => b i) (fun i : {i // i ∈ c} => b i) := by
  rw [pbwKostantBasis_apply]
  apply Subring.list_prod_mem
  intro x hx
  simp only [List.mem_ofFn] at hx
  obtain ⟨i, rfl⟩ := hx
  split_ifs with hi
  · exact ringChoose_mem_kostantForm (fun j : {i // i ∉ c} => b j)
      (fun j : {i // i ∈ c} => b j) ⟨i, hi⟩ (a i)
  · exact dividedPower_mem_kostantForm (fun j : {i // i ∉ c} => b j)
      (fun j : {i // i ∈ c} => b j) ⟨i, hi⟩ (a i)

/-- The integral span of the mixed PBW monomials. It is not asserted to be a subring for an
arbitrary rational Lie basis. -/
noncomputable def pbwKostantLattice (c : Finset (Fin n)) : Submodule ℤ U :=
  Submodule.span ℤ (Set.range (b.pbwKostantBasis c))

/-- The defining span of the mixed PBW lattice. -/
theorem pbwKostantLattice_def (c : Finset (Fin n)) :
    b.pbwKostantLattice c = Submodule.span ℤ (Set.range (b.pbwKostantBasis c)) :=
  (rfl)

/-- Rational PBW independence gives an integral basis of the mixed monomial lattice. -/
noncomputable def pbwKostantLatticeBasis (c : Finset (Fin n)) :
    Basis (Fin n → ℕ) ℤ (b.pbwKostantLattice c) :=
  Basis.span ((b.pbwKostantBasis c).linearIndependent.restrict_scalars' ℤ)

/-- The integral basis vector is the corresponding mixed PBW monomial in the enveloping
algebra. -/
@[simp]
theorem coe_pbwKostantLatticeBasis (c : Finset (Fin n)) (a : Fin n → ℕ) :
    (b.pbwKostantLatticeBasis c a : U) = b.pbwKostantBasis c a :=
  Basis.coe_span_apply _ a

/-- Membership in the mixed PBW lattice is equivalent to a unique finite integral expansion
in its ordered monomials. -/
theorem mem_pbwKostantLattice_iff (c : Finset (Fin n)) (x : U) :
    x ∈ b.pbwKostantLattice c ↔
      ∃! a : (Fin n → ℕ) →₀ ℤ, a.sum (fun k z => z • b.pbwKostantBasis c k) = x := by
  rw [pbwKostantLattice_def]
  exact LinearIndependent.mem_span_range_iff_existsUnique
    ((b.pbwKostantBasis c).linearIndependent.restrict_scalars' ℤ) x

end Module.Basis
