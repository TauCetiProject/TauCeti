/-!
# Every admissible lattice has a weight basis

The split maximal torus of
`TauCeti/Algebra/Lie/UniversalEnveloping/Kostant/RootSubgroup/Torus/Basic.lean`, the matrix
coordinates of
`TauCeti/Algebra/Lie/UniversalEnveloping/Kostant/RootSubgroup/Coordinate.lean` and the group scheme
generated by the root subgroups all take a **weight basis** of the Kostant-stable lattice `M ≤ V` as
a hypothesis: an integral basis `b : Basis η ℤ M` together with `wt : η → κ → ℤ` such that every
`b x` is a joint eigenvector of the designated Cartan operators with integral eigenvalues `wt x`.
This file constructs one, so that nothing downstream has to assume it: a Kostant-stable subgroup
that is finitely generated over `ℤ` and lies in the span of the integral joint weight spaces has a
weight basis, and its weights are the finitely many weights of the lattice.

Three ingredients combine. Generic independence of joint eigenspaces separates the integral
weights. Humphreys' Lemma 27.1
(`TauCeti.UniversalEnvelopingAlgebra.jointWeightComponent_mem_of_kostantStable`) says that `M`
contains every joint weight component of each of its elements, which cuts `M` into weight
sublattices summing to `M`. Finally, torsion-freeness of a rational vector space makes each weight
sublattice a finitely generated torsion-free `ℤ`-module, hence free, because `ℤ` is a principal
ideal domain. Collecting bases of the summands along the resulting internal direct sum
(`DirectSum.IsInternal.collectedBasis`) produces the weight basis, indexed by pairs of a weight and
a basis index of that weight sublattice.

The weight of a basis vector is therefore literally the first component of its index, so the weight
function needs no separate construction: `Sigma.fst` is it. Only finitely many weights contribute,
by generic finiteness of independent submodules in a finitely generated module
(`Submodule.finite_ne_bot_of_iSupIndep`).

A `ℤ`-basis of a lattice is never canonical, and neither is this one: bases of the individual weight
sublattices are chosen. What *is* canonical is the decomposition into weight sublattices, so the
choice is confined to one weight space at a time.

## Main declarations

* `TauCeti.UniversalEnvelopingAlgebra.jointWeightSpace`: the joint eigenspace of the designated
  Cartan operators for an integral weight.
* `TauCeti.UniversalEnvelopingAlgebra.weightSublattice`: the weight sublattice cut out of a
  subgroup `M ≤ V` by a weight.
* `TauCeti.UniversalEnvelopingAlgebra.kostantWeightBasis`: the weight basis itself, with
  `TauCeti.UniversalEnvelopingAlgebra.isCartanWeightVector_kostantWeightBasis` recording that its
  vectors have the advertised weights.
* `TauCeti.UniversalEnvelopingAlgebra.kostantWeightBasisFin`: the same basis indexed by `Fin n`,
  which is the shape the coordinate and group-scheme constructions consume.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.map_mem_iSup_jointWeightSpace`: a morphism of Lie modules
  maps the span of the integral joint weight spaces into that of its target.
* `TauCeti.UniversalEnvelopingAlgebra.eq_zero_of_isCartanWeightVector_of_sum_eq_zero`: vectors of
  pairwise distinct integral weights are independent.
* `TauCeti.UniversalEnvelopingAlgebra.IsCartanWeightVector.eq_zero_of_forall_ne`: in a space spanned
  by weight vectors, a weight vector of any other weight is zero.
* `TauCeti.UniversalEnvelopingAlgebra.isNilpotent_of_isCartanWeightVector`: on a space spanned by
  finitely many weight vectors, a root vector with a nonzero root acts nilpotently.
* `TauCeti.UniversalEnvelopingAlgebra.isInternal_weightSublattice`: a Kostant-stable subgroup lying
  in the span of the integral joint weight spaces is their internal direct sum.
* `TauCeti.UniversalEnvelopingAlgebra.mem_range_kostantWeightFin_iff`: the weights recorded by the
  numbered weight basis are exactly those whose weight sublattice is nonzero.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §27.1.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

open Finset

universe u v w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι : Type w} {κ : Type*}
variable {V : Type v} [AddCommGroup V] [Module ℚ V]

attribute [local instance] TauCeti.moduleNNRat
attribute [local instance] HasUniqueDiv.of_module_rat

variable (e : ι → L) (h : κ → L)
  (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)

/-! ## Weight spaces and weight sublattices -/

/-- The **joint weight space** of an integral weight `μ`: the vectors on which every designated
Cartan vector `h j` acts by the scalar `μ j`. -/
def jointWeightSpace (μ : κ → ℤ) : Submodule ℚ V :=
  ⨅ j : κ, Module.End.eigenspace (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h j))) ((μ j : ℚ))

/-- Membership in a joint weight space is exactly being a weight vector for that weight. -/
@[simp]
theorem mem_jointWeightSpace_iff {μ : κ → ℤ} {x : V} :
    x ∈ jointWeightSpace h ρ μ ↔ IsCartanWeightVector h ρ μ x := by
  rw [jointWeightSpace, Submodule.mem_iInf, isCartanWeightVector_iff_mem_eigenspace]

/-- **A morphism of Lie modules respects the integral weight spaces**: it maps a vector in the span
of the integral joint weight spaces of `M` into the span of those of `N`. -/
theorem map_mem_iSup_jointWeightSpace {M N : Type*} [AddCommGroup M] [Module ℚ M]
    [LieRingModule L M] [LieModule ℚ L M] [AddCommGroup N] [Module ℚ N] [LieRingModule L N]
    [LieModule ℚ L N] {m : M} (hm : m ∈ ⨆ μ : κ → ℤ, jointWeightSpace h (representation ℚ L M) μ)
    (f : M →ₗ⁅ℚ,L⁆ N) : f m ∈ ⨆ μ : κ → ℤ, jointWeightSpace h (representation ℚ L N) μ := by
  have hle : (⨆ μ : κ → ℤ, jointWeightSpace h (representation ℚ L M) μ).map
      (f : M →ₗ[ℚ] N) ≤ ⨆ μ : κ → ℤ, jointWeightSpace h (representation ℚ L N) μ := by
    rw [Submodule.map_iSup]
    refine iSup_mono fun μ => Submodule.map_le_iff_le_comap.mpr fun v hv => ?_
    rw [Submodule.mem_comap, mem_jointWeightSpace_iff]
    exact ((mem_jointWeightSpace_iff h _).1 hv).map f
  exact hle (Submodule.mem_map_of_mem hm)

/-- The **weight sublattice** of weight `μ` of a subgroup `M ≤ V`: the part of `M` on which every
designated Cartan vector `h j` acts by the scalar `μ j`. -/
def weightSublattice (μ : κ → ℤ) : Submodule ℤ M :=
  ((jointWeightSpace h ρ μ).restrictScalars ℤ).comap
    (AddMonoidHom.toIntLinearMap M.subtype)

@[simp]
theorem mem_weightSublattice_iff {μ : κ → ℤ} {x : M} :
    x ∈ weightSublattice h ρ M μ ↔ IsCartanWeightVector h ρ μ (x : V) := by
  rw [weightSublattice, Submodule.mem_comap, Submodule.restrictScalars_mem,
    mem_jointWeightSpace_iff]
  rfl

/-- The weight slice of a subgroup spanning a rational representation spans the corresponding
rational joint weight space. No stability or finite-generation assumption is needed. -/
theorem span_weightSublattice_eq_jointWeightSpace (N : Submodule ℤ V)
    (hN : Submodule.span ℚ (N : Set V) = ⊤) (μ : κ → ℤ) :
    Submodule.span ℚ
        ((fun x : N.toAddSubgroup => (x : V)) ''
          (weightSublattice h ρ N.toAddSubgroup μ : Set N.toAddSubgroup)) =
      jointWeightSpace h ρ μ := by
  refine le_antisymm (Submodule.span_le.mpr ?_) ?_
  · rintro _ ⟨x, hx, rfl⟩
    exact (mem_jointWeightSpace_iff h ρ).mpr
      ((mem_weightSublattice_iff h ρ N.toAddSubgroup).mp hx)
  · intro x hx
    obtain ⟨r, hr0, hrN⟩ := Submodule.IsLattice.exists_ne_zero_smul_mem ℚ N hN x
    have hrW : r • x ∈ jointWeightSpace h ρ μ :=
      ((jointWeightSpace h ρ μ).restrictScalars ℤ).smul_mem r hx
    have hrQ : (r : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hr0
    rw [← inv_smul_smul₀ hrQ x, Int.cast_smul_eq_zsmul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span
      ⟨⟨r • x, hrN⟩, (mem_weightSublattice_iff h ρ N.toAddSubgroup).mpr
        ((mem_jointWeightSpace_iff h ρ).mp hrW), rfl⟩)

/-! ## Independence of weight vectors -/

/-- **The joint weight spaces of distinct integral weights are independent.** This is generic
independence of joint eigenspaces, restricted along the injective cast of integral weights. -/
theorem iSupIndep_jointWeightSpace : iSupIndep (jointWeightSpace h ρ) := by
  have hind' : iSupIndep fun μ : κ → ℚ =>
      ⨅ j : κ, Module.End.eigenspace
        (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h j))) (μ j) :=
    iSupIndep_iInf_eigenspace fun j =>
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h j))
  suffices iSupIndep (fun μ : κ → ℤ => jointWeightSpace h ρ μ) by simpa only
  simpa only [jointWeightSpace, Function.comp_def] using
    hind'.comp fun μ ν hμν => by
      ext j
      exact_mod_cast congr_fun hμν j

/-- **Weight vectors of pairwise distinct weights are independent.** If a finite family of joint
eigenvectors of the designated Cartan operators, indexed by pairwise distinct integral weights, sums
to zero, then every member of the family is zero. -/
theorem eq_zero_of_isCartanWeightVector_of_sum_eq_zero {s : Finset (κ → ℤ)} {w : (κ → ℤ) → V}
    (hw : ∀ l ∈ s, IsCartanWeightVector h ρ l (w l)) (hsum : ∑ l ∈ s, w l = 0)
    {l₀ : κ → ℤ} (hl₀ : l₀ ∈ s) : w l₀ = 0 :=
  (iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero _).1 (iSupIndep_jointWeightSpace h ρ) s w
    (fun l hl => (mem_jointWeightSpace_iff h ρ).2 (hw l hl)) hsum l₀ hl₀

variable {h ρ} in
/-- **A weight vector of a weight missing from a spanning family of weight vectors is zero.** If
`V` is spanned by weight vectors `b k` of weights `wt k`, then `V` is the sum of the joint weight
spaces of the weights `wt k`, which meets the joint weight space of any other weight only in zero.
-/
theorem IsCartanWeightVector.eq_zero_of_forall_ne {η : Type*} {b : η → V} {wt : η → κ → ℤ}
    (hb : ∀ k, IsCartanWeightVector h ρ (wt k) (b k))
    (hspan : Submodule.span ℚ (Set.range b) = ⊤) {μ : κ → ℤ} {v : V}
    (hv : IsCartanWeightVector h ρ μ v) (hμ : ∀ k, wt k ≠ μ) : v = 0 := by
  have hle : Submodule.span ℚ (Set.range b) ≤
      ⨆ (ν : κ → ℤ) (_ : ν ≠ μ), jointWeightSpace h ρ ν := by
    rw [Submodule.span_le]
    rintro _ ⟨k, rfl⟩
    exact Submodule.mem_iSup_of_mem (wt k) <| Submodule.mem_iSup_of_mem (hμ k) <|
      (mem_jointWeightSpace_iff h ρ).2 (hb k)
  rw [hspan] at hle
  exact (Submodule.disjoint_def.1 (iSupIndep_jointWeightSpace h ρ μ)) v
    ((mem_jointWeightSpace_iff h ρ).2 hv) (hle Submodule.mem_top)

/-! ## Nilpotence of root vectors -/

/-- **A root vector acts nilpotently on a space spanned by finitely many weight vectors.** Let `x`
be an eigenvector of the designated Cartan vectors under the adjoint action, with a nonzero integral
root `α`. Then `ρ(x)ⁿ` raises the weight of a weight vector by `n α`. Only finitely many weights
occur among a finite spanning family of weight vectors, so a large enough power of `ρ(x)` carries
every vector of the family to a weight vector of an absent weight, which is zero. -/
theorem isNilpotent_of_isCartanWeightVector {η : Type*} [Finite η] {b : η → V}
    {wt : η → κ → ℤ} (hb : ∀ k, IsCartanWeightVector h ρ (wt k) (b k))
    (hspan : Submodule.span ℚ (Set.range b) = ⊤) {x : L} {α : κ → ℤ}
    (hα : ∀ j, ⁅h j, x⁆ = (α j : ℚ) • x) (hα0 : α ≠ 0) :
    IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ x)) := by
  -- The exponents `n` for which some `wt k + n • α` is again a weight of the family.
  have hfin : {n : ℕ | ∃ k, wt k + n • α ∈ Set.range wt}.Finite := by
    have hinj (k : η) : Function.Injective fun n : ℕ => wt k + n • α := fun m n hmn =>
      IsAddTorsionFree.nsmul_left_injective hα0 (add_left_cancel hmn)
    rw [Set.ofPred_exists]
    exact Set.finite_iUnion fun k => (Set.finite_range wt).preimage (hinj k).injOn
  obtain ⟨N, hN⟩ := hfin.bddAbove
  refine ⟨N + 1, LinearMap.ext_on_range hspan fun k => ?_⟩
  rw [LinearMap.zero_apply]
  refine (IsCartanWeightVector.pow_rootVector (fun _ : Unit => x) (i := ()) hα (hb k)
    (N + 1)).eq_zero_of_forall_ne hb hspan fun k' hk' => ?_
  have : N + 1 ≤ N := hN ⟨k, k', hk'⟩
  omega

/-- **The weight sublattices of a subgroup are independent.** -/
theorem iSupIndep_weightSublattice : iSupIndep (weightSublattice h ρ M) := by
  classical
  rw [iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero]
  intro s w hw hsum μ hμ
  apply Subtype.ext
  exact eq_zero_of_isCartanWeightVector_of_sum_eq_zero h ρ
    (fun ν hν => (mem_weightSublattice_iff h ρ M).1 (hw ν hν))
    (by simpa only [AddSubmonoidClass.coe_finsetSum, ZeroMemClass.coe_zero] using
      congr_arg (fun x : M => (x : V)) hsum) hμ

/-- **A Kostant-stable subgroup is spanned by its weight sublattices**, provided each of its
elements lies in the span of the joint weight spaces. -/
theorem iSup_weightSublattice_eq_top
    (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M)
    (hV : ∀ x : M, (x : V) ∈ ⨆ μ : κ → ℤ, jointWeightSpace h ρ μ) :
    ⨆ μ : κ → ℤ, weightSublattice h ρ M μ = ⊤ := by
  classical
  refine eq_top_iff.2 fun x _ => ?_
  have hxV : (x : V) ∈ ⨆ μ : κ → ℤ, jointWeightSpace h ρ μ := hV x
  rw [Submodule.mem_iSup_iff_exists_dfinsupp'] at hxV
  obtain ⟨f, hf⟩ := hxV
  rw [DFinsupp.sum] at hf
  have hwt : ∀ ν : κ → ℤ, IsCartanWeightVector h ρ ν ((f ν : V)) :=
    fun ν => (mem_jointWeightSpace_iff h ρ).1 (f ν).2
  have hmem : ∀ ν : κ → ℤ, ((f ν : V)) ∈ M := by
    intro ν
    by_cases hν : ν ∈ f.support
    · exact jointWeightComponent_mem_of_kostantStable e h ρ hM
        (fun l _ j => Module.End.mem_eigenspace_iff.1
          ((isCartanWeightVector_iff_mem_eigenspace h ρ).1 (hwt l) j))
        (by rw [hf]; exact x.2) hν
    · rw [DFinsupp.notMem_support_iff] at hν
      rw [hν, ZeroMemClass.coe_zero]
      exact AddSubgroup.zero_mem M
  have hxsum : x = ∑ ν ∈ f.support, (⟨(f ν : V), hmem ν⟩ : M) :=
    Subtype.ext (by rw [AddSubmonoidClass.coe_finsetSum]; exact hf.symm)
  rw [hxsum]
  exact sum_mem fun ν _ => Submodule.mem_iSup_of_mem ν
    ((mem_weightSublattice_iff h ρ M).2 (hwt ν))

/-- **An admissible lattice is the direct sum of its weight sublattices.** The `DecidableEq`
hypothesis is the one `DirectSum.IsInternal` itself carries; the constructions below supply it
classically, so it does not propagate into the weight basis. -/
theorem isInternal_weightSublattice [DecidableEq (κ → ℤ)]
    (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M)
    (hV : ∀ x : M, (x : V) ∈ ⨆ μ : κ → ℤ, jointWeightSpace h ρ μ) :
    DirectSum.IsInternal (weightSublattice h ρ M) :=
  DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
    (iSupIndep_weightSublattice h ρ M) (iSup_weightSublattice_eq_top e h ρ M hM hV)

/-! ## The weight basis -/

section WeightBasis

variable [Module.Finite ℤ M]

/-- The weight sublattices of a finitely generated lattice in a rational vector space are finitely
generated and torsion-free, hence free: `ℤ` is a principal ideal domain. -/
instance instFreeWeightSublattice (μ : κ → ℤ) : Module.Free ℤ (weightSublattice h ρ M μ) := by
  have : IsNoetherian ℤ M := isNoetherian_of_isNoetherianRing_of_finite ℤ M
  infer_instance

variable (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M)
  (hV : ∀ x : M, (x : V) ∈ ⨆ μ : κ → ℤ, jointWeightSpace h ρ μ)

include e hM hV in
/-- **A weight basis of an admissible lattice.** A finitely generated Kostant-stable subgroup lying
in the span of the integral weight spaces has a basis of weight vectors: collect a basis of each
weight sublattice along the direct-sum decomposition.

The weight of the basis vector indexed by `a` is the first component `a.1` of its index, so
`Sigma.fst` is the weight function such a basis is paired with;
`TauCeti.UniversalEnvelopingAlgebra.isCartanWeightVector_kostantWeightBasis` is the corresponding
weight hypothesis. -/
noncomputable def kostantWeightBasis :
    Module.Basis
      (Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)) ℤ M :=
  letI := Classical.decEq (κ → ℤ)
  (isInternal_weightSublattice e h ρ M hM hV).collectedBasis fun μ =>
    Module.Free.chooseBasis ℤ (weightSublattice h ρ M μ)

/-- Each vector of the weight basis lies in the weight sublattice its index names. -/
theorem kostantWeightBasis_mem
    (a : Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)) :
    kostantWeightBasis e h ρ M hM hV a ∈ weightSublattice h ρ M a.1 :=
  letI := Classical.decEq (κ → ℤ)
  DirectSum.IsInternal.collectedBasis_mem _ _ a

/-- **The weight basis consists of weight vectors**, of the weights recorded by the first component
of the index. This is the weight hypothesis that the split maximal torus, the matrix coordinates and
the generated group scheme take as given. -/
theorem isCartanWeightVector_kostantWeightBasis
    (a : Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)) :
    IsCartanWeightVector h ρ (Sigma.fst a)
      ((kostantWeightBasis e h ρ M hM hV a : M) : V) :=
  (mem_weightSublattice_iff h ρ M).1 (kostantWeightBasis_mem e h ρ M hM hV a)

/-- A weight sublattice that has a basis index is nonzero. -/
theorem weightSublattice_ne_bot_of_chooseBasisIndex {μ : κ → ℤ}
    (j : Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)) :
    weightSublattice h ρ M μ ≠ ⊥ :=
  Submodule.nontrivial_iff_ne_bot.mp
    (nontrivial_of_ne _ _ ((Module.Free.chooseBasis ℤ (weightSublattice h ρ M μ)).ne_zero j))

/-- The index of the weight basis is finite, since the lattice is finitely generated: its weight
sublattices are independent, so only finitely many of them are nonzero, and each is a finitely
generated free `ℤ`-module. Neither Kostant-stability nor lying in the span of the integral weight
spaces is needed, so the numbering of the index below needs neither either. -/
theorem finite_kostantWeightBasis_index :
    Finite (Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)) := by
  have : IsNoetherian ℤ M := isNoetherian_of_isNoetherianRing_of_finite ℤ M
  have hfin : {μ : κ → ℤ | weightSublattice h ρ M μ ≠ ⊥}.Finite :=
    Submodule.finite_ne_bot_of_iSupIndep (iSupIndep_weightSublattice h ρ M)
  have := hfin.to_subtype
  have (μ : κ → ℤ) : Finite (Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)) :=
    Module.Finite.finite_basis (Module.Free.chooseBasis ℤ (weightSublattice h ρ M μ))
  exact Finite.of_surjective
    (Sigma.map (Subtype.val : {μ : κ → ℤ | weightSublattice h ρ M μ ≠ ⊥} → κ → ℤ) fun _ j => j)
    fun a => ⟨⟨⟨a.1, weightSublattice_ne_bot_of_chooseBasisIndex h ρ M a.2⟩, a.2⟩, rfl⟩

include e hM hV in
/-- The weight basis has one vector for each unit of rank: its index has cardinality the rank of the
lattice, which is therefore the length of the `Fin`-indexed reindexing
`TauCeti.UniversalEnvelopingAlgebra.kostantWeightBasisFin`. -/
theorem nat_card_kostantWeightBasis_index_eq_finrank :
    Nat.card (Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)) =
      Module.finrank ℤ M := by
  classical
  exact (Module.finrank_eq_nat_card_basis (kostantWeightBasis e h ρ M hM hV)).symm

/-- The numbering of the weight-basis index by `Fin n` along which the weight basis is reindexed;
it exists because the index is finite. -/
noncomputable def kostantWeightBasisIndexEquivFin :
    (Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)) ≃
      Fin (Nat.card (Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ))) :=
  have := finite_kostantWeightBasis_index h ρ M
  Finite.equivFin _

include e hM hV in
/-- The weight basis reindexed by `Fin n`, the shape in which the coordinate and group-scheme
constructions read a basis of an admissible lattice. -/
noncomputable def kostantWeightBasisFin :
    Module.Basis
      (Fin (Nat.card (Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ))))
      ℤ M :=
  (kostantWeightBasis e h ρ M hM hV).reindex (kostantWeightBasisIndexEquivFin h ρ M)

/-- The `Fin`-indexed weight basis is the weight basis read through the numbering of its index. -/
@[simp]
theorem kostantWeightBasisFin_apply
    (x : Fin (Nat.card
      (Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)))) :
    kostantWeightBasisFin e h ρ M hM hV x =
      kostantWeightBasis e h ρ M hM hV ((kostantWeightBasisIndexEquivFin h ρ M).symm x) :=
  Module.Basis.reindex_apply _ _ _

/-- The weight of the `x`-th vector of the `Fin`-indexed weight basis: the first component of the
index numbered `x`. It is a function of the numbering alone, so it is defined for any finitely
generated subgroup, whether or not that subgroup has a weight basis. -/
noncomputable def kostantWeightFin :
    Fin (Nat.card (Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ))) →
      κ → ℤ :=
  fun x => ((kostantWeightBasisIndexEquivFin h ρ M).symm x).1

/-- **The `Fin`-indexed weight basis consists of weight vectors** of the recorded weights. -/
theorem isCartanWeightVector_kostantWeightBasisFin
    (x : Fin (Nat.card
      (Σ μ : κ → ℤ, Module.Free.ChooseBasisIndex ℤ (weightSublattice h ρ M μ)))) :
    IsCartanWeightVector h ρ (kostantWeightFin h ρ M x)
      ((kostantWeightBasisFin e h ρ M hM hV x : M) : V) := by
  rw [kostantWeightBasisFin_apply]
  exact isCartanWeightVector_kostantWeightBasis e h ρ M hM hV _

/-- **The weights recorded by the `Fin`-indexed weight basis are exactly the weights of the
lattice**: an integral weight is carried by some vector of the basis if and only if its weight
sublattice is nonzero. -/
theorem mem_range_kostantWeightFin_iff {μ : κ → ℤ} :
    μ ∈ Set.range (kostantWeightFin h ρ M) ↔ weightSublattice h ρ M μ ≠ ⊥ := by
  refine ⟨?_, fun hμ => ?_⟩
  · rintro ⟨x, rfl⟩
    exact weightSublattice_ne_bot_of_chooseBasisIndex h ρ M
      ((kostantWeightBasisIndexEquivFin h ρ M).symm x).2
  · have := Submodule.nontrivial_iff_ne_bot.mpr hμ
    obtain ⟨j⟩ := (Module.Free.chooseBasis ℤ (weightSublattice h ρ M μ)).index_nonempty
    exact ⟨kostantWeightBasisIndexEquivFin h ρ M ⟨μ, j⟩, by
      simp only [kostantWeightFin, Equiv.symm_apply_apply]⟩

end WeightBasis

end TauCeti.UniversalEnvelopingAlgebra
