module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Generated.Basic
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Weight.Torus
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Points
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Torus.Basic

/-!
# A represented weight torus inside a subgroup scheme generated over an arbitrary base

A Chevalley--Demazure carrier built inside `GLₙ` over a ring `A` is often presented as the closed
subgroup scheme generated by the coordinate maps of its numbered root subgroups *and* of its split
weight torus. This file gives the criterion under which the torus is already contained in the
subgroup scheme generated by any family of coordinate maps whose points include the represented
root-subgroup matrices, and deduces that such a family's defining Hopf ideal is killed by the
weight-torus coordinate map over `A`.

The integral counterpart is
`kostantGeneratedDefiningIdeal_toIdeal_le_torus_ker_of_universal_torus_mem_elementary`, which is
the `A = ℤ` case of `commonKernelHopfIdeal_toIdeal_le_ker_weightTorusBaseChangeCoordinateMap`
below and is deduced from it. The equality of Hopf ideals that the integral toral closure then
derives,
`kostantToralDefiningIdeal_eq_kostantGeneratedDefiningIdeal_of_universal_torus_mem_elementary`,
is left to the specializing carrier file: an equality of integral Hopf ideals does not transfer
along a base change which is not known to be flat, so a carrier generated afresh over `A` needs
the containment over `A` that this file supplies. The two inputs are pointwise and come from the
carrier: that the represented root-subgroup matrices over the test ring are points of the
generated scheme, and that the represented universal weight-torus point over that ring lies in
the elementary subgroup the root subgroups generate. The second is an integral statement about
the represented lattice, so a carrier proves it once and uses it over every base.

Nothing here asserts flatness, reducedness, or finite type, and nothing identifies the generated
scheme with the base change of an integral one.

## Main results

* `kostantTorusMatrix_mem_generatedPointsSubgroup`: a represented weight-torus matrix over a test
  ring is a point of the generated subgroup scheme.
* `commonKernelHopfIdeal_toIdeal_le_ker_weightTorusBaseChangeCoordinateMap`: the generated
  defining Hopf ideal is killed by the weight-torus coordinate map over `A`, so adjoining the
  torus to the generating family does not shrink it.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Section 3.
* W. C. Waterhouse, *Introduction to Affine Group Schemes*, Section 1.4.

The argument generalizes the integral one for the Kostant toral closure in
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Generation`,
with the universal point of the split torus taken over the base `A` rather than over `ℤ`; that
module's integral containment is the `A = ℤ` case and is deduced from here.
-/

public section

open CategoryTheory WithConv

namespace TauCeti.UniversalEnvelopingAlgebra

universe u w v t

-- Match tensor products to the `ℤ`-algebra structure used by scalar extension.
attribute [local instance high] Algebra.toModule

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {I : Type w} {κ : Type} [Fintype κ]
variable {V : Type} [AddCommGroup V] [Module ℚ V]

variable (e : I → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ m ∈ M, ρ u m ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable {n : ℕ} (b : Module.Basis (Fin n) ℤ M)
variable (wt : Fin n → κ → ℤ)

section Pointwise

variable {A : Type t} [CommRing A]
variable {ι : Type v} {K : ι → _root_.CommHopfAlgCat.{t} A}
variable (f : ∀ i, GeneralLinear.coordinateHopfAlgebra A n ⟶ K i)

/-- **A represented weight-torus matrix is a point of a root-generated subgroup scheme.** If every
represented root-subgroup matrix over `B` is a point of the subgroup scheme generated by `f`, and
the represented weight-torus point `s` over `B` lies in the elementary subgroup the root subgroups
generate, then the represented matrix of `s` is a point of that subgroup scheme.

Both hypotheses and the conclusion are pointwise; the scheme-theoretic consequence is
`commonKernelHopfIdeal_toIdeal_le_ker_weightTorusBaseChangeCoordinateMap` below. -/
theorem kostantTorusMatrix_mem_generatedPointsSubgroup
    (B : Type*) [CommRing B] [Algebra A B]
    (hroot : ∀ (i : I) (q : HopfAlgebra.points
      (R := ℤ) (H := AdditiveGroup.coordinateHopfAlgebra ℤ) (CommAlgCat.of ℤ B)),
        kostantRootSubgroupMatrix e h ρ M hM i (hnil i) b q ∈
          GeneralLinear.generatedPointsSubgroup n f B)
    (s : κ → Bˣ)
    (hs : kostantTorusPoints M b wt (CommAlgCat.of ℤ B) s ∈
      kostantElementarySubgroup e h ρ M hM hnil (CommAlgCat.of ℤ B)) :
    kostantTorusMatrix M b wt s ∈ GeneralLinear.generatedPointsSubgroup n f B := by
  apply map_kostantElementarySubgroup_le_of_matrix_mem e h ρ M hM hnil b B hroot
  rw [← basisMatrix_kostantTorusPoints M b wt s]
  exact ⟨_, hs, rfl⟩

end Pointwise

section BaseChange

-- The base ring stays in `Type`, which is where a prime field `ZMod p` lives:
-- `GeneralLinear.weightTorusBaseChangeCoordinateMap_eq` identifies the transported weight-torus
-- map with the one built directly over the base only within a single universe.
variable (A : Type) [CommRing A]
variable {ι : Type v} {K : ι → _root_.CommHopfAlgCat.{0} A}
variable (f : ∀ i, GeneralLinear.coordinateHopfAlgebra A n ⟶ K i)

/-- **The largest Hopf ideal killed by a root-generating family is killed by the weight torus
too.** The pointwise hypotheses are tested on the coordinate ring of the split torus itself, and
the torus hypothesis is needed only at its universal point, which is the generic torus element.
Together with `TauCeti.CommHopfAlgCat.le_commonKernelHopfIdeal_iff` this is what lets a carrier
presented as the subgroup scheme generated by its root subgroups *and* its weight torus drop the
torus from that family. -/
theorem commonKernelHopfIdeal_toIdeal_le_ker_weightTorusBaseChangeCoordinateMap
    (hroot : ∀ (i : I) (q : HopfAlgebra.points
      (R := ℤ) (H := AdditiveGroup.coordinateHopfAlgebra ℤ)
      (CommAlgCat.of ℤ (DiagonalizableGroup.coordinateRing A
        (SplitTorus.characterGroup κ)).obj)),
        kostantRootSubgroupMatrix e h ρ M hM i (hnil i) b q ∈
          GeneralLinear.generatedPointsSubgroup n f
            (DiagonalizableGroup.coordinateRing A (SplitTorus.characterGroup κ)).obj)
    (huniv :
      let T := (DiagonalizableGroup.coordinateRing A (SplitTorus.characterGroup κ)).obj
      let B := CommAlgCat.of A T
      let q : HopfAlgebra.points
          (R := A) (H := DiagonalizableGroup.coordinateRing A
            (SplitTorus.characterGroup κ)) B := toConv (AlgHom.id A T)
      kostantTorusPoints M b wt (CommAlgCat.of ℤ T) (SplitTorus.pointsMulEquiv q) ∈
        kostantElementarySubgroup e h ρ M hM hnil (CommAlgCat.of ℤ T)) :
    (CommHopfAlgCat.commonKernelHopfIdeal f).toIdeal ≤
      RingHom.ker
        (GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ A wt).hom.toAlgHom.toRingHom := by
  let T := (DiagonalizableGroup.coordinateRing A (SplitTorus.characterGroup κ)).obj
  let B := CommAlgCat.of A T
  let q : HopfAlgebra.points
      (R := A) (H := DiagonalizableGroup.coordinateRing A (SplitTorus.characterGroup κ)) B :=
    toConv (AlgHom.id A T)
  have hs : kostantTorusPoints M b wt (CommAlgCat.of ℤ T) (SplitTorus.pointsMulEquiv q) ∈
      kostantElementarySubgroup e h ρ M hM hnil (CommAlgCat.of ℤ T) := huniv
  have hpoint : (CommHopfAlgCat.mapPointsFunctor
      (GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ A wt)).app B q =
      toConv (GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ A wt).hom.toAlgHom := by
    rw [CommHopfAlgCat.mapPointsFunctor_app_apply, WithConv.ofConv_toConv, AlgHom.id_comp]
  have hmatrix : GeneralLinear.pointsMulEquiv n
      ((CommHopfAlgCat.mapPointsFunctor
        (GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ A wt)).app B q) =
      kostantTorusMatrix M b wt (SplitTorus.pointsMulEquiv q) := by
    rw [GeneralLinear.weightTorusBaseChangeCoordinateMap_eq,
      GeneralLinear.pointsMulEquiv_mapPointsFunctor_weightTorusCoordinateMap,
      kostantTorusMatrix_apply]
  rw [← GeneralLinear.pointToGeneralLinear_mem_hopfIdealPointsSubgroup_iff_toIdeal_le_ker n
      (CommHopfAlgCat.commonKernelHopfIdeal f) T
      (GeneralLinear.weightTorusBaseChangeCoordinateMap ℤ A wt).hom.toAlgHom,
    ← GeneralLinear.pointsMulEquiv_apply, ← hpoint, hmatrix,
    ← GeneralLinear.generatedPointsSubgroup_def]
  exact kostantTorusMatrix_mem_generatedPointsSubgroup e h ρ M hM hnil b wt f T hroot _ hs

end BaseChange

end TauCeti.UniversalEnvelopingAlgebra
