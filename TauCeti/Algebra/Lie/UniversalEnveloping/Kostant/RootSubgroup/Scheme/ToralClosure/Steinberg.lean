module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Frobenius
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.NumberedSymmetry

/-!
# Graph-twisted Frobenius on the points of a Kostant toral closure

A lattice symmetry permuting the numbered root operators and the weight components normalizes
all points of the integral toral closure, not just its elementary subgroup. Compose its
conjugation action with the entrywise Frobenius to obtain `kostantToralSteinberg`.
The root parameters transform by `xᵢ(u) ↦ x_{σ i}(u^(p^k))`, and the torus parameters by
`s ↦ (s^(p^k)) ∘ τ⁻¹`. No monomial action on a weight basis is required.

The symmetry is integral, so it commutes with Frobenius on the whole point group. Consequently,
if its matrix has order dividing `m`, the `m`-th power of the composite is the `p^(k*m)`-power
Frobenius. This supplies the ordinary and graph-twisted endomorphisms on represented toral
closures without assuming that their field-valued points are generated by roots.
There is no assertion here that the fixed group is finite or simple.

The construction uses `kostantNumberedSymmetryPoints` and its naturality and order theorems,
together with the toral normalization theorem and `kostantToralFrobenius`. It is the whole-point
counterpart of `kostantElementarySteinberg`. The existing `DynkinType.geckTwistedFrobenius`
is the analogous construction on the adjoint Geck carrier. In contrast, this construction can
be applied to the full-weight module `DynkinType.scModule` with lattice `DynkinType.scLattice`,
which realizes the simply connected form rather than the adjoint form. Specialization still
requires its numbered symmetry and weight-compatibility data; no such identification is
asserted here.

## References

* R. W. Carter, *Finite Groups of Lie Type: Conjugacy Classes and Complex Characters*, §1.15–1.17.
* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 11.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

open WithConv

universe u v w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L] {I : Type w} {κ : Type} [Finite κ]
variable {V : Type} [AddCommGroup V] [Module ℚ V]
variable (e : I → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V) (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable {n : ℕ} (b : Module.Basis (Fin n) ℤ M) (wt : Fin n → κ → ℤ)
variable (σ : I → I) (θ : V ≃ₗ[ℚ] V) (hθM : ∀ v, θ v ∈ M ↔ v ∈ M)
variable (hθe : ∀ i, ∀ v : V,
  θ (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) v) =
    ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e (σ i))) (θ v))
variable (hσ : Function.Surjective σ) (τ : Equiv.Perm κ)
variable (hwt : ∀ i j, b.repr (θ.toAddEquiv.invariantRestrict M hθM (b j)) i ≠ 0 →
  ∀ a, wt i (τ a) = wt j a)
variable (p k : ℕ) (A : Type v) [CommRing A] [ExpChar A p]

/-- The composite of a numbered lattice symmetry with Frobenius on all points of the toral
closure. The symmetry acts after Frobenius; it is not transported from an elementary group. -/
noncomputable def kostantToralSteinberg :
    kostantToralPointsSubgroup e h ρ M hM hnil b wt A →*
      kostantToralPointsSubgroup e h ρ M hM hnil b wt A :=
  (kostantNumberedSymmetryPoints M b θ hθM A _
    (map_kostantToralPointsSubgroup_conj_numberedSymmetryMatrix
      e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt A)).toMonoidHom.comp
    (kostantToralFrobenius e h ρ M hM hnil b wt p k A)

/-- On matrices the twisted Frobenius is integral conjugation after entrywise Frobenius. -/
@[simp]
theorem coe_kostantToralSteinberg (g : kostantToralPointsSubgroup e h ρ M hM hnil b wt A) :
    (kostantToralSteinberg e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt p k A g :
        Matrix.GeneralLinearGroup (Fin n) A) =
      kostantNumberedSymmetryMatrix M b θ hθM A *
        Matrix.GeneralLinearGroup.map (iterateFrobenius A p k) g *
        (kostantNumberedSymmetryMatrix M b θ hθM A)⁻¹ := by
  simp only [kostantToralSteinberg, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    coe_kostantNumberedSymmetryPoints, coe_kostantToralFrobenius]

/-- Twisted Frobenius permutes the numbered root subgroups and raises their parameters to
`p ^ k`. -/
@[simp]
theorem kostantToralSteinberg_kostantRootSubgroupMatrix (i : I) (t : Multiplicative A) :
    kostantToralSteinberg e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt p k A
        ⟨kostantRootSubgroupMatrix e h ρ M hM i (hnil i) b
          ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm t),
          kostantGeneratedPointsSubgroup_le_toralPoints e h ρ M hM hnil b wt A
            (kostantRootSubgroupMatrix_mem_generatedPoints e h ρ M hM hnil b A i _)⟩ =
      ⟨kostantRootSubgroupMatrix e h ρ M hM (σ i) (hnil (σ i)) b
          ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm
            (Multiplicative.ofAdd (Multiplicative.toAdd t ^ p ^ k))),
        kostantGeneratedPointsSubgroup_le_toralPoints e h ρ M hM hnil b wt A
          (kostantRootSubgroupMatrix_mem_generatedPoints e h ρ M hM hnil b A (σ i) _)⟩ := by
  apply Subtype.ext
  rw [coe_kostantToralSteinberg, map_iterateFrobenius_kostantRootSubgroupMatrix,
    kostantNumberedSymmetryMatrix_conj_kostantRootSubgroupMatrix e h ρ M hM hnil b σ θ hθM hθe]

/-- Twisted Frobenius raises torus parameters to `p ^ k` and relabels them by the inverse
permutation. This holds even when the lattice symmetry is not monomial in the weight basis. -/
@[simp]
theorem kostantToralSteinberg_kostantTorusMatrix [Fintype κ] (s : κ → Aˣ) :
    kostantToralSteinberg e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt p k A
        ⟨diagGL fun i => torusCharacter s (wt i), by
          simpa only [kostantTorusMatrix_apply] using
            kostantTorusMatrix_mem_toralPoints e h ρ M hM hnil b wt A s⟩ =
      ⟨kostantTorusMatrix M b wt (MulEquiv.arrowCongr τ (MulEquiv.refl Aˣ) (s ^ p ^ k)),
        kostantTorusMatrix_mem_toralPoints e h ρ M hM hnil b wt A _⟩ := by
  apply Subtype.ext
  rw [coe_kostantToralSteinberg]
  dsimp only
  rw [← kostantTorusMatrix_apply M b wt s, map_iterateFrobenius_kostantTorusMatrix,
    kostantTorusMatrix_apply, kostantTorusMatrix_apply]
  refine kostantNumberedSymmetryMatrix_conj_diagGL M b θ hθM A _ _ fun i j hij => ?_
  rw [torusCharacter_mulEquivArrowCongr]
  exact congrArg (torusCharacter (s ^ p ^ k)) (funext (hwt i j hij))

/-- Iterates separate into the symmetry power and the corresponding Frobenius iterate. -/
-- Fix the composition-monoid structure, rather than the pointwise operations on homomorphisms.
theorem kostantToralSteinberg_pow (m : ℕ) :
    (show Monoid.End _ from
      kostantToralSteinberg e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt p k A) ^ m =
      (show Monoid.End _ from (kostantNumberedSymmetryPoints M b θ hθM A _
        (map_kostantToralPointsSubgroup_conj_numberedSymmetryMatrix
          e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt A)).toMonoidHom) ^ m *
        (show Monoid.End _ from kostantToralFrobenius e h ρ M hM hnil b wt p (k * m) A) := by
  let γ := kostantNumberedSymmetryPoints M b θ hθM A _
    (map_kostantToralPointsSubgroup_conj_numberedSymmetryMatrix
      e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt A)
  have hnorm := map_kostantToralPointsSubgroup_conj_numberedSymmetryMatrix
    e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt A
  have hc := comp_kostantNumberedSymmetryPoints M b θ hθM _ hnorm _ hnorm
    (iterateFrobenius A p k) (kostantToralFrobenius e h ρ M hM hnil b wt p k A)
    (coe_kostantToralFrobenius e h ρ M hM hnil b wt p k A)
  have hcomm : Commute (show Monoid.End _ from γ.toMonoidHom)
      (kostantToralFrobenius e h ρ M hM hnil b wt p k A) := by
    -- `Commute` uses composition-monoid multiplication. Expose its defining `comp`
    -- equality to match the naturality theorem, rather than relying on implicit unfolding.
    change γ.toMonoidHom.comp (kostantToralFrobenius e h ρ M hM hnil b wt p k A) =
      (kostantToralFrobenius e h ρ M hM hnil b wt p k A).comp γ.toMonoidHom
    exact hc.symm
  -- Multiplication in the composition monoid is `MonoidHom.comp`; record the conversion
  -- explicitly before applying the abstract commuting-product power law.
  have hmul : (show Monoid.End _ from
      kostantToralSteinberg e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt p k A) =
      (show Monoid.End _ from γ.toMonoidHom) *
        (show Monoid.End _ from kostantToralFrobenius e h ρ M hM hnil b wt p k A) := rfl
  rw [hmul, ← kostantToralFrobenius_mul]
  exact hcomm.mul_pow m

/-- If the symmetry matrix has order dividing `m`, the `m`-th power of twisted Frobenius is
plain Frobenius. No generation assertion about the point group is needed. -/
-- Each `show` selects the composition-monoid structure on bundled homomorphisms.
theorem
    kostantToralSteinberg_pow_eq_kostantToralFrobenius_of_numberedSymmetryMatrix_pow_eq_one {m : ℕ}
    (hm : kostantNumberedSymmetryMatrix M b θ hθM A ^ m = 1) :
    (show Monoid.End _ from
      kostantToralSteinberg e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt p k A) ^ m =
      (show Monoid.End _ from kostantToralFrobenius e h ρ M hM hnil b wt p (k * m) A) := by
  rw [kostantToralSteinberg_pow]
  have hγ := kostantNumberedSymmetryPoints_pow_eq_one M b θ hθM A _
    (map_kostantToralPointsSubgroup_conj_numberedSymmetryMatrix
      e h ρ M hM hnil b wt σ θ hθM hθe hσ τ hwt A) hm
  -- For the evaluation action of `MulAut`, forgetting the action is exactly forgetting
  -- the inverse. Record this wrapper conversion before transporting the power relation.
  have heval (δ : MulAut (kostantToralPointsSubgroup e h ρ M hM hnil b wt A)) :
      MulDistribMulAction.toMonoidEnd
        (MulAut (kostantToralPointsSubgroup e h ρ M hM hnil b wt A))
        (kostantToralPointsSubgroup e h ρ M hM hnil b wt A) δ = δ.toMonoidHom := rfl
  have hp := congrArg (MulDistribMulAction.toMonoidEnd
    (MulAut (kostantToralPointsSubgroup e h ρ M hM hnil b wt A))
    (kostantToralPointsSubgroup e h ρ M hM hnil b wt A)) hγ
  rw [map_pow, map_one, heval] at hp
  exact (congrArg (fun f : Monoid.End (kostantToralPointsSubgroup e h ρ M hM hnil b wt A) =>
    f * (show Monoid.End _ from kostantToralFrobenius e h ρ M hM hnil b wt p (k * m) A))
      hp).trans (one_mul _)

end TauCeti.UniversalEnvelopingAlgebra
