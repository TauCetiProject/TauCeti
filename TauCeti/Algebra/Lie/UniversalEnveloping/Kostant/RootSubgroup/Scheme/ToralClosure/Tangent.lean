module

public import TauCeti.Algebra.AlgebraicGroup.AdditiveGroup.Differential
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Tangent
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Tangent
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ClosedImmersion
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Basic
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent

/-!
# Root vectors of a Kostant toral closure

Fix a finite free Kostant-stable lattice with a basis and an integer weight for each basis vector,
and let `G` be the closed subgroup scheme of `GLₙ` generated by the represented root subgroups and
the weight torus (`TauCeti.UniversalEnvelopingAlgebra.kostantToralDefiningIdeal`). This file reads
the root vectors of `G` off its factored root-subgroup maps `xᵢ : 𝔾ₐ → G`.

The differential of `xᵢ` sends an additive tangent vector `c` to `c` times the integral matrix of
the represented root generator, over every commutative coefficient ring. Its value at the additive
unit tangent vector is the normalized root vector
`TauCeti.UniversalEnvelopingAlgebra.kostantToralRootVector`, which is stable under coefficient
change. When the factored coordinate map is surjective, the differential is injective, so its image
is the line spanned by that nonzero vector. When the basis consists of Cartan weight vectors and
the root generator has weight `α`, the integral root matrix is supported on the basis pairs whose
weight difference is `α`.

Nothing here asserts that these lines are full weight spaces, that the weight torus is maximal, or
that the toral closure is reductive.

## Main declarations

All in the namespace `TauCeti.UniversalEnvelopingAlgebra`:

* `kostantRootGeneratorIntMatrix_eq_zero_of_weight_ne`: the integral root matrix vanishes off its
  weight difference.
* `tangentMatrix_derivationComp_kostantRootSubgroupToralCoordinateMap`: the differential of a
  factored root subgroup is the tangent parameter times the integral root matrix.
* `kostantToralRootVector`: the normalized root vector, with
  `tangentMatrix_kostantToralRootVector` and
  `range_derivationCompLieHom_kostantRootSubgroupToralCoordinateMap_eq_span`.

## References

* J. S. Milne, *Algebraic Groups* (2017), §10.a and §21.1.
* B. Conrad, *Reductive Group Schemes* (2014), §5.1.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1–2.

The matrix calculation is the Kostant root-subgroup tangent theorem of
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent`, transported through
the toral-closure quotient.
-/

public section

open CategoryTheory

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

-- Use the algebra-induced integer module consistently for the counit coefficient synonyms.
attribute [local instance high] Algebra.toModule

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {I : Type w} {κ : Type}
variable {V : Type} [AddCommGroup V] [Module ℚ V]
variable (e : I → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ m ∈ M, ρ u m ∈ M)

/-! ## Weight support of the integral root matrices -/

section Support

variable {η : Type*} [Finite η] (b : Module.Basis η ℤ M) (wt : η → κ → ℤ)

/-- **An integral root matrix has no entries outside its weight difference.** If the lattice
basis consists of Cartan weight vectors and the root generator `eᵢ` has weight `α`, the `(r, s)`
entry of its integral matrix vanishes unless the weight of `r` minus the weight of `s` is `α`. -/
theorem kostantRootGeneratorIntMatrix_eq_zero_of_weight_ne (i : I) {α : κ → ℤ}
    (hα : ∀ j, ⁅h j, e i⁆ = (α j : ℚ) • e i)
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V)) {r s : η}
    (hrs : wt r - wt s ≠ α) :
    kostantRootGeneratorIntMatrix e h ρ M hM i b r s = 0 := by
  classical
  have := Fintype.ofFinite η
  rw [kostantRootGeneratorIntMatrix_eq_toMatrix, LinearMap.toMatrix_apply]
  exact repr_eq_zero_of_isCartanWeightVector e h ρ M hM b wt hwt
    (isCartanWeightVector_coe_kostantRootOperator e h ρ M hM i hα (hwt s))
    fun hr ↦ hrs (sub_eq_iff_eq_add'.mpr hr)

end Support

/-! ## The root differentials -/

variable [Finite κ]
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable {n : ℕ} (b : Module.Basis (Fin n) ℤ M) (wt : Fin n → κ → ℤ)
variable {B : Type v} [CommRing B]

/-- The differential of a factored root subgroup of the Kostant toral closure is its integral
root matrix multiplied by the additive tangent parameter, over every coefficient ring. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem tangentMatrix_derivationComp_kostantRootSubgroupToralCoordinateMap (i : I)
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    GeneralLinear.tangentMatrix n
        (HopfIdeal.quotientLieHom (B := B) (kostantToralDefiningIdeal e h ρ M hM hnil b wt)
          (derivationComp (B := B)
            (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom d)) =
      AdditiveGroup.gaTangentLinearEquiv d •
        (kostantRootGeneratorIntMatrix e h ρ M hM i b).map (Int.cast : ℤ → B) := by
  have hcomp : (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom.comp
      (Bialgebra.Quotient.mkBialgHom (kostantToralDefiningIdeal e h ρ M hM hnil b wt).toIdeal) =
      (kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b).hom := by
    rw [← CommHopfAlgCat.hom_mkQuotient, ← CommHopfAlgCat.hom_comp,
      mkQuotient_comp_kostantRootSubgroupToralCoordinateMap]
  rw [HopfIdeal.quotientLieHom_apply, ← LinearMap.comp_apply, ← derivationComp_comp, hcomp]
  simpa only [kostantRootGeneratorIntMatrix_eq_toMatrix, algebraMap_int_eq,
    Int.coe_castRingHom] using
    tangentMatrix_derivationComp_kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b d

/-- A factored root-subgroup differential of the Kostant toral closure is injective when the
factored coordinate map is surjective, including when the coefficient ring has nilpotents. -/
theorem derivationComp_kostantRootSubgroupToralCoordinateMap_injective (i : I)
    (hi : Function.Surjective (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom) :
    Function.Injective (derivationComp (B := B)
      (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom) :=
  derivationComp_injective_of_surjective _ hi

/-- The normalized root vector of the Kostant toral closure, with values in `B`, is the image of
the additive unit tangent vector under a factored root-subgroup differential. -/
noncomputable def kostantToralRootVector (i : I) :
    Derivation ℤ (GeneralLinear.coordinateHopfAlgebra ℤ n ⧸
        (kostantToralDefiningIdeal e h ρ M hM hnil b wt).toIdeal)
      (Bialgebra.CounitAlgebra ℤ (GeneralLinear.coordinateHopfAlgebra ℤ n ⧸
        (kostantToralDefiningIdeal e h ρ M hM hnil b wt).toIdeal) B) :=
  derivationComp (B := B) (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom
    ((AdditiveGroup.gaTangentLinearEquiv (R := ℤ) (B := B)).symm 1)

/-- The normalized root vector is the factored root-subgroup differential at the additive unit
tangent vector. -/
theorem kostantToralRootVector_def (i : I) :
    kostantToralRootVector e h ρ M hM hnil b wt (B := B) i =
      derivationComp (B := B) (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom
        ((AdditiveGroup.gaTangentLinearEquiv (R := ℤ) (B := B)).symm 1) := by
  rw [kostantToralRootVector]

/-- The matrix of a normalized root vector of the Kostant toral closure is its integral root
matrix. -/
@[simp]
theorem tangentMatrix_kostantToralRootVector (i : I) :
    GeneralLinear.tangentMatrix n
        (HopfIdeal.quotientLieHom (B := B) (kostantToralDefiningIdeal e h ρ M hM hnil b wt)
          (kostantToralRootVector e h ρ M hM hnil b wt (B := B) i)) =
      (kostantRootGeneratorIntMatrix e h ρ M hM i b).map (Int.cast : ℤ → B) := by
  rw [kostantToralRootVector_def,
    tangentMatrix_derivationComp_kostantRootSubgroupToralCoordinateMap,
    LinearEquiv.apply_symm_apply, one_smul]

/-- The differential with additive parameter `c` is `c` times the normalized root vector. -/
theorem derivationComp_kostantRootSubgroupToralCoordinateMap_eq_smul_kostantToralRootVector
    (i : I)
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    derivationComp (B := B) (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom d =
      AdditiveGroup.gaTangentLinearEquiv d •
        kostantToralRootVector e h ρ M hM hnil b wt (B := B) i :=
  AdditiveGroup.derivationComp_eq_smul _ d

/-- Coefficient change preserves the normalized root vector of the Kostant toral closure. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem mapValue_kostantToralRootVector {C : Type*} [CommRing C] (φ : B →ₐ[ℤ] C) (i : I) :
    Derivation.mapValue φ (kostantToralRootVector e h ρ M hM hnil b wt (B := B) i) =
      kostantToralRootVector e h ρ M hM hnil b wt (B := C) i :=
  AdditiveGroup.mapValue_derivationComp_gaTangentLinearEquiv_symm_one φ _

/-- The image of each factored root-subgroup differential is precisely its normalized root
line. -/
theorem range_derivationCompLieHom_kostantRootSubgroupToralCoordinateMap_eq_span (i : I) :
    (derivationCompLieHom (B := B)
        (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom).range.toSubmodule =
      B ∙ kostantToralRootVector e h ρ M hM hnil b wt (B := B) i :=
  AdditiveGroup.range_derivationCompLieHom_eq_span B _

/-- A normalized root vector of the Kostant toral closure is nonzero over every nontrivial
coefficient ring when its factored coordinate map is surjective.
Use this directly: simplification changes the inherited integer module in the zero derivation
before this statement can match. -/
theorem kostantToralRootVector_ne_zero [Nontrivial B] (i : I)
    (hi : Function.Surjective (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom) :
    kostantToralRootVector e h ρ M hM hnil b wt (B := B) i ≠ 0 :=
  AdditiveGroup.derivationComp_gaTangentLinearEquiv_symm_one_ne_zero _
    (derivationComp_kostantRootSubgroupToralCoordinateMap_injective e h ρ M hM hnil b wt i hi)

end TauCeti.UniversalEnvelopingAlgebra
