import Mathlib.RingTheory.AdjoinRoot

/-!
# Coroot values in the elementary group, and why the weight torus is redundant

The points of a Kostant carrier over a value ring `A` are generated by two families: the root
subgroups `xᵢ(t)`, generating the elementary group
`TauCeti.UniversalEnvelopingAlgebra.kostantElementarySubgroup`, and the split weight torus `t(s)`.
This file shows that the second family is already contained in the first whenever the designated
Cartan vectors are the coroots of root pairs: the torus contributes no new points.

The mechanism is Chevalley's rank-one identity. Write `n = xᵢ(1) xⱼ(-1) xᵢ(1)` for the Weyl
representative of a root pair `(eᵢ, eⱼ)` whose `sl₂` triple has Cartan index `c`, and `h_c(u)` for
the coordinate cocharacter at `c`, which scales a weight vector of weight `μ` by `u ^ μ(c)`. Then
for every unit `u` of the value ring

```text
xᵢ(u) xⱼ(-u⁻¹) xᵢ(u) = h_c(u) n,
```

so `h_c(u)` is a product of root subgroup elements. The identity is proved in two steps.

* **At a square.** If `u = v²`, conjugation by `h_c(v)` multiplies the parameter of `xᵢ` by
  `v²` and that of `xⱼ` by `v⁻²`, since the root of `eᵢ` takes the value two at its own coroot.
  So the left side is `h_c(v) n h_c(v)⁻¹`, and the Weyl element inverts the coroot,
  `n h_c(v)⁻¹ n⁻¹ = h_c(v)`, which leaves `h_c(v)² n = h_c(u) n`.
* **In general.** Adjoin a square root of `u` to `A`, as `A[X] ⧸ (X² - u)`. That extension is
  injective because `X² - u` is monic, and scalar extension along an injective map of value rings
  is injective on automorphisms of the free lattice, so the identity over the extension, where
  `u` is a square, descends to `A`.

No condition on the coordinates of the root is needed, in contrast with the torus values
`α(s)` that conjugation over `A` itself reaches: these cover every unit of every value ring
exactly when those coordinates are setwise coprime, which fails at the rank-one row `(2)` and at
the long simple roots of `B₂` and `Cₙ`. When every Cartan index carries such a root pair, the
whole torus lies in the elementary group, and the Borel-type join of the torus with all root
subgroups collapses to the elementary group.

Nothing here identifies the elementary group with the points of the toral closure group scheme,
which is a separate statement that this file does not use or prove: the comparison is between two
subgroups of `Aut_A(A ⊗[ℤ] M)`, both generated by named elements.

## Main results

* `kostantRootSubgroupParam_mul_mul_eq_kostantCoordinateCocharacter_mul_kostantWeylGL`: the
  rank-one identity `xᵢ(u) xⱼ(-u⁻¹) xᵢ(u) = h_c(u) n`, over every value ring.
* `TauCeti.UniversalEnvelopingAlgebra.kostantCoordinateCocharacter_mem_kostantElementarySubgroup`:
  every coroot value lies in the elementary group.
* `TauCeti.UniversalEnvelopingAlgebra.kostantTorusSubgroup_le_kostantElementarySubgroup` and
  `kostantTorusSubsystemSubgroup_univ_eq_kostantElementarySubgroup`: with a root pair at every
  Cartan index, the weight torus and then the whole Borel-type join are contained in the
  elementary group.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3, Lemma 20 and Corollary 5.
* R. W. Carter, *Simple Groups of Lie Type*, §§6.4 and 7.1.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §§25--27.
-/

public section

open TensorProduct

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι : Type*} {κ : Type*}
variable {V : Type v} [AddCommGroup V] [Module ℚ V]

variable (e : ι → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))

attribute [local instance 100] LieRing.ofAssociativeRing

-- Match tensor products to the `ℤ`-algebra instance stored by `CommAlgCat` objects.
attribute [local instance high] Algebra.toModule

/-! ## Coroot values in the elementary group -/

section Coroot

variable {η : Type*} (b : Module.Basis η ℤ M) (wt : η → κ → ℤ)
variable [Fintype κ] [DecidableEq κ]

/-- The rank-one identity at a square parameter `v²`, where it is the conjugate of the Weyl
representative by the coroot value `h_c(v)`. -/
private theorem kostantRootSubgroupParam_mul_mul_eq_of_sq
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V))
    {i j : ι} {c : κ} {α : κ → ℤ}
    (hT : IsSl2Triple (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
    (hi : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
    (hj : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
    (hα : ∀ j', ⁅h j', e i⁆ = (α j' : ℚ) • e i)
    (hαneg : ∀ j', ⁅h j', e j⁆ = -((α j' : ℚ) • e j)) (B : CommAlgCat.{w} ℤ) (v : Bˣ) :
    kostantRootSubgroupParam e h ρ M hM i hi B (Multiplicative.ofAdd ((v ^ 2 : Bˣ) : B)) *
        kostantRootSubgroupParam e h ρ M hM j hj B
          (Multiplicative.ofAdd (-(((v ^ 2)⁻¹ : Bˣ) : B))) *
        kostantRootSubgroupParam e h ρ M hM i hi B
          (Multiplicative.ofAdd ((v ^ 2 : Bˣ) : B)) =
      kostantCoordinateCocharacter M b wt B c (v ^ 2) *
        kostantWeylGL e h ρ M hM hi hj B := by
  have hc : α c = 2 := rootWeight_apply_coroot_eq_two e h ρ hT (hα c)
  have hαneg' : ∀ j', ⁅h j', e j⁆ = (((-α) j' : ℤ) : ℚ) • e j := fun j' => by
    rw [hαneg j', Pi.neg_apply, Int.cast_neg, neg_smul]
  set d := kostantCoordinateCocharacter M b wt B c v
  have hd : d = kostantTorusPoints M b wt B (Pi.mulSingle c v) :=
    kostantCoordinateCocharacter_apply M b wt B c v
  have hxi : ∀ t : B, d * kostantRootSubgroupParam e h ρ M hM i hi B
      (Multiplicative.ofAdd t) * d⁻¹ =
        kostantRootSubgroupParam e h ρ M hM i hi B
          (Multiplicative.ofAdd (((v ^ 2 : Bˣ) : B) * t)) := fun t => by
    rw [hd, kostantTorusPoints_conj_kostantRootSubgroupParam e h ρ M hM b wt hwt hα hi,
      torusCharacter_mulSingle, hc, toAdd_ofAdd, zpow_ofNat]
  have hxj : ∀ t : B, d * kostantRootSubgroupParam e h ρ M hM j hj B
      (Multiplicative.ofAdd t) * d⁻¹ =
        kostantRootSubgroupParam e h ρ M hM j hj B
          (Multiplicative.ofAdd ((((v ^ 2)⁻¹ : Bˣ) : B) * t)) := fun t => by
    rw [hd, kostantTorusPoints_conj_kostantRootSubgroupParam e h ρ M hM b wt hwt hαneg' hj,
      torusCharacter_mulSingle, Pi.neg_apply, hc, toAdd_ofAdd, zpow_neg, zpow_ofNat]
  -- The Weyl element inverts the coroot: `n h_c(v)⁻¹ n⁻¹ = h_c(v)`.
  have hw : kostantWeylGL e h ρ M hM hi hj B * d⁻¹ *
      (kostantWeylGL e h ρ M hM hi hj B)⁻¹ = d := by
    rw [hd, ← map_inv, ← Pi.mulSingle_inv, kostantWeylGL_conj_kostantTorusPoints e h ρ M hM
      hi hj hT hα hαneg b wt hwt, weylReflectTorusPoint_apply,
      torusCharacter_mulSingle, hc, ← Pi.mulSingle_mul]
    congr 2
    group
  have hconj : d * kostantWeylGL e h ρ M hM hi hj B * d⁻¹ =
      kostantRootSubgroupParam e h ρ M hM i hi B (Multiplicative.ofAdd ((v ^ 2 : Bˣ) : B)) *
        kostantRootSubgroupParam e h ρ M hM j hj B
          (Multiplicative.ofAdd (-(((v ^ 2)⁻¹ : Bˣ) : B))) *
        kostantRootSubgroupParam e h ρ M hM i hi B
          (Multiplicative.ofAdd ((v ^ 2 : Bˣ) : B)) := by
    rw [kostantWeylGL_eq_kostantRootSubgroupParam_mul]
    have hsplit : ∀ x y z : LinearMap.GeneralLinearGroup B (B ⊗[ℤ] M),
        d * (x * y * z) * d⁻¹ = (d * x * d⁻¹) * (d * y * d⁻¹) * (d * z * d⁻¹) := fun x y z => by
      group
    rw [hsplit, hxi, hxj, mul_one, mul_neg, mul_one]
  rw [← hconj, map_pow]
  calc d * kostantWeylGL e h ρ M hM hi hj B * d⁻¹
      = d * (kostantWeylGL e h ρ M hM hi hj B * d⁻¹ *
          (kostantWeylGL e h ρ M hM hi hj B)⁻¹) *
          kostantWeylGL e h ρ M hM hi hj B := by group
    _ = d ^ 2 * kostantWeylGL e h ρ M hM hi hj B := by rw [hw, sq]

/-- **Chevalley's rank-one identity** `xᵢ(u) xⱼ(-u⁻¹) xᵢ(u) = h_c(u) n`, over every value ring
and at every unit `u`. Here `(eᵢ, eⱼ)` is a root pair whose `sl₂` triple has Cartan index `c`,
`h_c(u)` is the coordinate cocharacter at `c` and `n = xᵢ(1) xⱼ(-1) xᵢ(1)` is the Weyl
representative, and `α` is the weight of `eᵢ`, so that `eⱼ` has weight `-α`. -/
theorem kostantRootSubgroupParam_mul_mul_eq_kostantCoordinateCocharacter_mul_kostantWeylGL
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V))
    {i j : ι} {c : κ} {α : κ → ℤ}
    (hT : IsSl2Triple (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
    (hi : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
    (hj : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
    (hα : ∀ j', ⁅h j', e i⁆ = (α j' : ℚ) • e i)
    (hαneg : ∀ j', ⁅h j', e j⁆ = -((α j' : ℚ) • e j)) (A : CommAlgCat.{w} ℤ) (u : Aˣ) :
    kostantRootSubgroupParam e h ρ M hM i hi A (Multiplicative.ofAdd (u : A)) *
        kostantRootSubgroupParam e h ρ M hM j hj A
          (Multiplicative.ofAdd (-((u⁻¹ : Aˣ) : A))) *
        kostantRootSubgroupParam e h ρ M hM i hi A (Multiplicative.ofAdd (u : A)) =
      kostantCoordinateCocharacter M b wt A c u *
        kostantWeylGL e h ρ M hM hi hj A := by
  -- The identity holds at a square `v²` by `kostantRootSubgroupParam_mul_mul_eq_of_sq`. In
  -- general, adjoin a square root of `u` along the injective map `A → A[X] ⧸ (X² - u)`, and use
  -- that scalar extension along it is injective on automorphisms of the free lattice.
  rcases subsingleton_or_nontrivial A with hA | hA
  · exact Subsingleton.elim _ _
  let f : Polynomial A := Polynomial.X ^ 2 - Polynomial.C (u : A)
  have hmonic : f.Monic := Polynomial.monic_X_pow_sub_C _ two_ne_zero
  have hdeg : 0 < f.degree := by
    rw [Polynomial.degree_X_pow_sub_C two_pos]
    exact_mod_cast two_pos
  let B : CommAlgCat.{w} ℤ := CommAlgCat.of ℤ (AdjoinRoot f)
  let φ : A ⟶ B := CommAlgCat.ofHom
    { toRingHom := AdjoinRoot.of f
      commutes' := fun n => by
        rw [eq_intCast (algebraMap ℤ A), eq_intCast (algebraMap ℤ (AdjoinRoot f))]
        exact map_intCast _ n }
  have hφ : Function.Injective φ.hom :=
    AdjoinRoot.of.injective_of_monic_of_degree_pos hmonic hdeg
  -- `φ` is `AdjoinRoot.of f` by construction, so the root equation is read off `eval₂_root`.
  have hroot : AdjoinRoot.root f ^ 2 = φ.hom (u : A) := by
    have := AdjoinRoot.eval₂_root f
    simp only [f, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
      sub_eq_zero] at this
    exact this
  have hunit : IsUnit (AdjoinRoot.root f : B) :=
    (isUnit_pow_iff two_ne_zero).1 (hroot ▸ (u.isUnit.map φ.hom))
  let r : Bˣ := hunit.unit
  have hr : Units.map φ.hom.toRingHom.toMonoidHom u = r ^ 2 :=
    Units.ext (by simp [r, hroot])
  -- Compare both sides after scalar extension to `B`, where the identity holds at `r ^ 2`.
  have : Module.Free ℤ M := Module.Free.of_basis b
  apply GeneralLinear.mapScalarExtensionAutomorphisms_injective φ
    (GeneralLinear.scalarExtensionMap_injective φ hφ)
  have hu : φ.hom (u : A) = ((r ^ 2 : Bˣ) : B) := by
    simp [← hr]
  have hu' : φ.hom (-((u⁻¹ : Aˣ) : A)) = -(((r ^ 2)⁻¹ : Bˣ) : B) := by
    simp [← hr]
  rw [map_mul, map_mul, map_mul, mapScalarExtensionAutomorphisms_kostantRootSubgroupParam,
    mapScalarExtensionAutomorphisms_kostantRootSubgroupParam,
    mapScalarExtensionAutomorphisms_kostantCoordinateCocharacter,
    mapScalarExtensionAutomorphisms_kostantWeylGL, toAdd_ofAdd, toAdd_ofAdd, hu, hu', hr]
  exact kostantRootSubgroupParam_mul_mul_eq_of_sq e h ρ M hM b wt hwt hT hi hj hα hαneg B r

/-- **Every coroot value lies in the elementary group.** By Chevalley's rank-one identity,
`h_c(u) = xᵢ(u) xⱼ(-u⁻¹) xᵢ(u) n⁻¹` is a product of root subgroup elements, for every unit `u`
and with no condition on the coordinates of the root. -/
theorem kostantCoordinateCocharacter_mem_kostantElementarySubgroup
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V))
    {i j : ι} {c : κ} {α : κ → ℤ}
    (hT : IsSl2Triple (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
    (hα : ∀ j', ⁅h j', e i⁆ = (α j' : ℚ) • e i)
    (hαneg : ∀ j', ⁅h j', e j⁆ = -((α j' : ℚ) • e j)) (A : CommAlgCat.{w} ℤ) (u : Aˣ) :
    kostantCoordinateCocharacter M b wt A c u ∈
      kostantElementarySubgroup e h ρ M hM hnil A := by
  rw [eq_mul_inv_iff_mul_eq.2
    (kostantRootSubgroupParam_mul_mul_eq_kostantCoordinateCocharacter_mul_kostantWeylGL
      e h ρ M hM b wt hwt hT (hnil i) (hnil j) hα hαneg A u).symm]
  exact mul_mem (mul_mem (mul_mem
    (kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A i _)
    (kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A j _))
    (kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A i _))
    (inv_mem (kostantWeylGL_mem_kostantElementarySubgroup e h ρ M hM hnil i j A))

omit [DecidableEq κ] in
/-- **The weight torus lies in the elementary group.** A torus point is the product over the
Cartan indices of its coroot values, so a root pair at every index puts the whole torus inside
the group generated by the root subgroups. -/
theorem kostantTorusSubgroup_le_kostantElementarySubgroup
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V))
    (rt : ι → κ → ℤ) (hrt : ∀ i j, ⁅h j, e i⁆ = (rt i j : ℚ) • e i)
    (raise lower : κ → ι)
    (hT : ∀ c, IsSl2Triple (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e (raise c))))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e (lower c)))))
    (hopp : ∀ c, rt (lower c) = -rt (raise c))
    (A : CommAlgCat.{w} ℤ) :
    kostantTorusSubgroup M b wt A ≤ kostantElementarySubgroup e h ρ M hM hnil A := by
  classical
  rw [kostantTorusSubgroup_eq_range]
  rintro - ⟨s, rfl⟩
  have key : s ∈ (kostantElementarySubgroup e h ρ M hM hnil A).comap
      (kostantTorusPoints M b wt A) := by
    rw [← Finset.univ_prod_mulSingle s]
    refine prod_mem fun c _ => Subgroup.mem_comap.2 ?_
    rw [← kostantCoordinateCocharacter_apply]
    exact kostantCoordinateCocharacter_mem_kostantElementarySubgroup e h ρ M hM hnil b wt hwt
      (hT c) (hrt (raise c)) (fun j' => by rw [hrt (lower c) j', hopp c, Pi.neg_apply,
        Int.cast_neg, neg_smul]) A (s c)
  exact Subgroup.mem_comap.1 key

omit [DecidableEq κ] in
/-- **The Borel-type join of the torus with every root subgroup is the elementary group.** With a
root pair at every Cartan index the torus is redundant, so adjoining it to the root subgroups adds
nothing. -/
theorem kostantTorusSubsystemSubgroup_univ_eq_kostantElementarySubgroup
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V))
    (rt : ι → κ → ℤ) (hrt : ∀ i j, ⁅h j, e i⁆ = (rt i j : ℚ) • e i)
    (raise lower : κ → ι)
    (hT : ∀ c, IsSl2Triple (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e (raise c))))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e (lower c)))))
    (hopp : ∀ c, rt (lower c) = -rt (raise c))
    (A : CommAlgCat.{w} ℤ) :
    kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt Set.univ A =
      kostantElementarySubgroup e h ρ M hM hnil A := by
  classical
  rw [kostantTorusSubsystemSubgroup_univ, ← kostantTorusSubgroup_eq_range,
    sup_eq_left]
  exact kostantTorusSubgroup_le_kostantElementarySubgroup e h ρ M hM hnil b wt hwt rt hrt
    raise lower hT hopp A

end Coroot

end TauCeti.UniversalEnvelopingAlgebra
