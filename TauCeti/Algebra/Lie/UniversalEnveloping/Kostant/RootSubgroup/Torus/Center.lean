module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Borel

/-!
# Central points of the Kostant weight torus

Let `U_ℤ = kostantForm e h` act on a rational representation `V` preserving a lattice `M` with a
weight basis, so that the split torus `T(A)` acts diagonally on `A ⊗[ℤ] M` over every commutative
ring `A`. For a set `S` of root indices, let `B_S(A) = U_S(A) ⬝ T(A)` be the subgroup generated by
the torus and the root subgroups `xᵢ` with `i ∈ S`, the root vector `eᵢ` having weight `α i`.

This file determines which torus points are central in `B_S(A)`. The pinning equation
`t(s) xᵢ(u) t(s)⁻¹ = xᵢ(α(s) u)` shows that `t(s)` commutes with `xᵢ` as soon as the root character
`α i` takes the value one at `s`, and the torus is commutative, so

```text
t(s) ∈ Z(B_S(A))   if   (α i)(s) = 1 for every i ∈ S.
```

Conversely, if `t(s)` commutes with `xᵢ(1)`, the pinning equation gives `xᵢ((α i)(s)) = xᵢ(1)`, so
`(α i)(s) = 1` once the root subgroup `xᵢ` is a faithful copy of the additive group over `A`
(`torusCharacter_eq_one_of_commute_kostantRootSubgroupParam`).
Faithfulness holds, for instance, when `eᵢ` carries a basis vector to a unit multiple of another
and squares to zero on it (`kostantRootSubgroupPoints_injective`); it fails when the root operator
vanishes on `A ⊗[ℤ] M`, and then `xᵢ` is trivial and imposes no condition.
Under that faithfulness the torus points centralizing `B_S(A)` are therefore exactly the common
kernel of the root characters,

```text
T(A) ∩ Z(B_S(A)) = t(⋂_{i ∈ S} ker (α i)).
```

When `S` consists of all the roots, `B_S(A)` is the group generated by the root subgroups and the
torus, and the common kernel of the roots is the group of torus points killed by the root lattice
`Q`, that is `Hom(Λ / Q, Aˣ)` for the character lattice `Λ` of the torus. Over a field `k` this is
the torus part of Steinberg's description of the centre of `E(k)` (Lemma 28(d)); that the whole
centre lies in the torus needs the Bruhat decomposition and is not treated here.

Centrality is stated as membership in `Subgroup.centralizer` of `B_S(A)` inside the ambient
general linear group; since every torus point lies in `B_S(A)`, this is membership in its centre.

## Main results

All declarations are in the namespace `TauCeti.UniversalEnvelopingAlgebra`.

* `kostantTorusPoints_mem_centralizer_kostantTorusSubsystemSubgroup`: a torus point killed by the
  roots in `S` centralizes `B_S(A)`.
* `kostantTorusPoints_mem_centralizer_kostantTorusSubsystemSubgroup_iff`: the resulting
  characterization of the central torus points.
* `comap_kostantTorusPoints_centralizer_kostantTorusSubsystemSubgroup_eq_iInf_ker`: its subgroup
  form `t⁻¹(Z(B_S(A))) = ⋂_{i ∈ S} ker (α i)`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, AMS University Lecture Series 66 (2016),
  Chapter 3, Lemma 28.
* R. W. Carter, *Simple Groups of Lie Type*, §7.1.
-/

public section

open TensorProduct

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι : Type*} {κ : Type*}
variable {V : Type v} [AddCommGroup V] [Module ℚ V]

variable (e : ι → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable {η : Type*} (b : Module.Basis η ℤ M) (wt : η → κ → ℤ)

-- Match tensor products to the `ℤ`-algebra instance stored by `CommAlgCat` objects.
attribute [local instance high] Algebra.toModule

variable [Fintype κ]
variable (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V))
variable (α : ι → κ → ℤ) {S : Set ι}
variable (hα : ∀ i ∈ S, ∀ j, ⁅h j, e i⁆ = (α i j : ℚ) • e i)
variable (A : CommAlgCat.{w} ℤ)

include hwt hα in
/-- **Torus points killed by the roots are central.** If every root character `α i` with `i ∈ S`
takes the value one at `s`, the torus point `t(s)` commutes with every element of the group
`B_S(A)` generated by the torus and the root subgroups indexed by `S`. -/
theorem kostantTorusPoints_mem_centralizer_kostantTorusSubsystemSubgroup {s : κ → Aˣ}
    (hs : ∀ i ∈ S, torusCharacter s (α i) = 1) :
    kostantTorusPoints M b wt A s ∈
      Subgroup.centralizer (kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt S A : Set _) := by
  suffices hle : kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt S A ≤
      Subgroup.centralizer {kostantTorusPoints M b wt A s} from
    Subgroup.mem_centralizer_iff.2 fun g hg =>
      (Subgroup.mem_centralizer_iff.1 (hle hg) _ rfl).symm
  refine (kostantTorusSubsystemSubgroup_le_iff e h ρ M hM hnil b wt).2
    ⟨fun i hi u => ?_, fun r => ?_⟩
  · rw [Subgroup.mem_centralizer_singleton_iff, eq_comm, ← mul_inv_eq_iff_eq_mul,
      kostantTorusPoints_conj_kostantRootSubgroupParam e h ρ M hM b wt hwt (hα i hi) (hnil i),
      hs i hi]
    simp
  · rw [Subgroup.mem_centralizer_singleton_iff, ← map_mul, ← map_mul, mul_comm]

include hwt hα in
/-- **The central torus points of `B_S(A)`.** When every root subgroup indexed by `S` is a faithful
copy of the additive group over `A`, a torus point centralizes `B_S(A)` exactly when every root
character `α i` with `i ∈ S` takes the value one at it. -/
theorem kostantTorusPoints_mem_centralizer_kostantTorusSubsystemSubgroup_iff
    (hinj : ∀ i ∈ S, Function.Injective (kostantRootSubgroupParam e h ρ M hM i (hnil i) A))
    (s : κ → Aˣ) :
    kostantTorusPoints M b wt A s ∈
        Subgroup.centralizer (kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt S A : Set _) ↔
      ∀ i ∈ S, torusCharacter s (α i) = 1 :=
  ⟨fun hc i hi => torusCharacter_eq_one_of_commute_kostantRootSubgroupParam e h ρ M hM b wt hwt
      (hα i hi) (hnil i) A (hinj i hi)
      (Subgroup.mem_centralizer_iff.1 hc _
        (kostantRootSubgroupParam_mem_kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt hi A
          _)).symm,
    kostantTorusPoints_mem_centralizer_kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt hwt α hα
      A⟩

include hwt hα in
/-- **The torus part of the centre of `B_S(A)`, as a subgroup.** When every root subgroup indexed
by `S` is injective over `A`, the torus points centralizing `B_S(A)` form the common kernel of the
root characters `α i`, `i ∈ S`. -/
theorem comap_kostantTorusPoints_centralizer_kostantTorusSubsystemSubgroup_eq_iInf_ker
    (hinj : ∀ i ∈ S, Function.Injective (kostantRootSubgroupParam e h ρ M hM i (hnil i) A)) :
    (Subgroup.centralizer (kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt S A : Set _)).comap
        (kostantTorusPoints M b wt A) =
      ⨅ i ∈ S, (weightChar A (α i)).ker := by
  ext s
  simp only [Subgroup.mem_comap, Subgroup.mem_iInf, MonoidHom.mem_ker, weightChar_apply]
  exact kostantTorusPoints_mem_centralizer_kostantTorusSubsystemSubgroup_iff e h ρ M hM hnil b wt
    hwt α hα A hinj s

end TauCeti.UniversalEnvelopingAlgebra
