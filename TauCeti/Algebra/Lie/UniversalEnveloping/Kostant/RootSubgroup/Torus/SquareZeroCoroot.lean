module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Torus.Coroot

/-!
# Square-zero root vectors make the weight torus redundant

`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Torus.Coroot` puts a coroot value
`h_α(u)` of a Kostant carrier in the elementary group generated by the root subgroups whenever `u`
is a value `α(s)` of the root on the weight torus, which reaches every unit exactly when the
coordinates of `α` are setwise coprime. That criterion fails at a long simple root of `B₂` and of
`Cₙ`, whose row of the Cartan matrix is `(2, -2)` up to padding, and at the rank-one row `(2)`.

This file supplies the criterion that covers those cases. It needs nothing about the coordinates of
the root and instead asks that the raising and lowering operators act with square zero, which for a
weight module says that the `α`-string through every weight has length at most two. Writing `E` and
`F` for the two operators and `u` for a unit of the value ring, the Chevalley rank-one identity

```text
x_α(u) x_{-α}(-u⁻¹) x_α(u) = h_α(u) · n_α,      n_α = x_α(1) x_{-α}(-1) x_α(1),
```

holds because both sides are `1 + u E - u⁻¹ F - E F - F E`: the square-zero hypothesis truncates
each exponential to `1 + t E`, and `E F` and `F E` are then orthogonal idempotents projecting onto
the two ends of every `α`-string, with `h_α(u)` acting by `u` on one and `u⁻¹` on the other.

Since `n_α` is itself a product of root subgroup elements, the identity puts `h_α(u)` in the
elementary group for *every* unit `u`, so the weight torus of a carrier all of whose numbered root
operators square to zero is redundant. The standard symplectic carrier of type `Cₙ`, whose
representation is the standard one, is of that kind.

## Main results

* `kostantRootSubgroupParam_val_of_sq_eq_zero`: a square-zero root operator exponentiates to
  `1 + t E`.
* `kostantCoordinateCocharacter_mem_kostantElementarySubgroup_of_sq_eq_zero`: the coroot value at
  every unit lies in the elementary group.
* `kostantTorusSubgroup_le_kostantElementarySubgroup_of_forall_coordinateCocharacter` and
  `kostantTorusSubsystemSubgroup_univ_eq_kostantElementarySubgroup_of_sq_eq_zero`: the weight
  torus, and then the Borel-type join, collapse into the elementary group.

All names below live in the `TauCeti.UniversalEnvelopingAlgebra` namespace.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3, Lemma 20 and Corollary 5.
* R. W. Carter, *Simple Groups of Lie Type*, §6.4.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

open TensorProduct

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι : Type*} {κ : Type*}
variable {V : Type v} [AddCommGroup V] [Module ℚ V]

variable (e : ι → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))

attribute [local instance 100] LieRing.ofAssociativeRing

-- Match tensor products to the `ℤ`-algebra instance stored by `CommAlgCat` objects.
attribute [local instance high] Algebra.toModule

/-! ## Square-zero root operators -/

section SquareZero

/-- **A square-zero root operator exponentiates to `1 + t X_α`.** All divided powers beyond the
first vanish, so the root subgroup element is affine in its parameter. -/
theorem kostantRootSubgroupParam_val_of_sq_eq_zero (i : ι)
    (hsq : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) ^ 2 = 0)
    (A : CommAlgCat.{w} ℤ) (t : Multiplicative A) :
    (kostantRootSubgroupParam e h ρ M hM i (hnil i) A t).val =
      1 + Multiplicative.toAdd t • (kostantRootOperator e h ρ M hM i).baseChange A := by
  refine LinearMap.ext fun z => ?_
  induction z using TensorProduct.inductionOn with
  | tmul a m =>
      rw [kostantRootSubgroupParam_val_apply,
        baseChangeExp_tmul_of_pow_eq_zero _ M _ hsq, Finset.sum_range_succ, Finset.sum_range_one,
        integralDividedPower_zero]
      simp only [LinearMap.add_apply, Module.End.one_apply, LinearMap.smul_apply,
        LinearMap.baseChange_tmul, pow_zero, pow_one, one_mul, smul_tmul', smul_eq_mul]
      -- The remaining difference is the unexposed body of `kostantRootOperator`, the first
      -- divided power; the two agree on `V` by `coe_kostantRootOperator_apply`.
      refine congrArg (fun p : M => a ⊗ₜ[ℤ] m + (Multiplicative.toAdd t * a) ⊗ₜ[ℤ] p) ?_
      refine Subtype.ext ?_
      rw [coe_integralDividedPower_apply, coe_kostantRootOperator_apply,
        Associative.dividedPower_one, Module.End.smul_def]
  | add z₁ z₂ h₁ h₂ => simp only [map_add, h₁, h₂]

/-! ## Halving the `sl₂` relation -/

section RankOne

variable {R : Type*} [Ring R] [Algebra ℚ R] {E F H : R}

/-- **A square-zero raising operator satisfies `E F E = E`.** Both `H E` and `-E H` equal `E F E`
once `E ^ 2 = 0`, so the `sl₂` relation `H E - E H = 2 E` halves to the displayed identity. -/
private theorem mul_mul_self_eq_of_sq_eq_zero (hEE : E * E = 0) (hef : E * F - F * E = H)
    (hhe : H * E - E * H = (2 : ℚ) • E) : E * F * E = E := by
  have h1 : E * F * E = H * E := by
    have h := congrArg (fun T => T * E) hef
    simp only [sub_mul] at h
    rw [mul_assoc F E E, hEE, mul_zero, sub_zero] at h
    exact h
  have h2 : E * H = -(E * F * E) := by
    have h := congrArg (fun T => E * T) hef
    simp only [mul_sub] at h
    rw [← mul_assoc, hEE, zero_mul, zero_sub, ← mul_assoc] at h
    exact h.symm.trans (by ring_nf)
  have key : (2 : ℚ) • (E * F * E) = (2 : ℚ) • E := by
    rw [← hhe, ← h1, h2, two_smul]
    abel
  have h2inv := congrArg (fun z : R => ((2 : ℚ)⁻¹) • z) key
  simpa only [smul_smul, inv_mul_cancel₀ (two_ne_zero (α := ℚ)), one_smul] using h2inv

end RankOne

/-! ## The rank-one identity in an endomorphism ring -/

section NormalForm

variable {B : Type*} [CommRing B] {N : Type*} [AddCommGroup N] [Module B N]
variable {E F : Module.End B N}

/-- **The rank-one product of three square-zero exponentials.** When the two parameters multiply to
`-1`, the product `x(α) y(β) x(α)` is `1 + α E + β F - E F - F E`. -/
private theorem sq_zero_triple_product (hEE : E * E = 0) (hEFE : E * F * E = E) {α β : B}
    (hαβ : α * β = -1) :
    (1 + α • E) * (1 + β • F) * (1 + α • E) =
      1 + α • E + β • F - E * F - F * E := by
  have hβα : β * α = -1 := by rw [mul_comm]; exact hαβ
  have step1 : (1 + β • F) * (1 + α • E) = 1 + α • E + β • F - F * E := by
    rw [add_mul, one_mul, smul_mul_assoc, mul_add, mul_one, mul_smul_comm, smul_add, smul_smul,
      hβα, neg_one_smul]
    abel
  have step2 : E * (1 + α • E + β • F - F * E) = β • (E * F) := by
    simp only [mul_sub, mul_add, mul_one, mul_smul_comm, ← mul_assoc, hEE, hEFE, smul_zero,
      add_zero]
    abel
  rw [mul_assoc, step1, add_mul, one_mul, smul_mul_assoc, step2, smul_smul, hαβ, neg_one_smul]
  abel

/-- **The coroot value times the Weyl representative.** Multiplying the normal form at parameters
`(1, -1)` by the diagonal element `1 + (α - 1) E F + (β - 1) F E` rescales its two root terms. -/
private theorem torus_mul_weyl (hEE : E * E = 0) (hFF : F * F = 0)
    (hEFE : E * F * E = E) (hFEF : F * E * F = F) (α β : B) :
    (1 + (α - 1) • (E * F) + (β - 1) • (F * E)) *
        (1 + (1 : B) • E + (-1 : B) • F - E * F - F * E) =
      1 + α • E + (-β) • F - E * F - F * E := by
  have hQE : F * E * E = 0 := by rw [mul_assoc, hEE, mul_zero]
  have hPF : E * F * F = 0 := by rw [mul_assoc, hFF, mul_zero]
  have hPP : E * F * (E * F) = E * F := by rw [← mul_assoc, hEFE]
  have hQQ : F * E * (F * E) = F * E := by rw [← mul_assoc, hFEF]
  have hPQ : E * F * (F * E) = 0 := by rw [← mul_assoc, mul_assoc E F F, hFF, mul_zero, zero_mul]
  have hQP : F * E * (E * F) = 0 := by rw [← mul_assoc, mul_assoc F E E, hEE, mul_zero, zero_mul]
  have hPW : E * F * (1 + (1 : B) • E + (-1 : B) • F - E * F - F * E) = E := by
    rw [mul_sub, mul_sub, mul_add, mul_add, mul_one, mul_smul_comm, mul_smul_comm, hEFE, hPF,
      hPP, hPQ, smul_zero, one_smul]
    abel
  have hQW : F * E * (1 + (1 : B) • E + (-1 : B) • F - E * F - F * E) = (-1 : B) • F := by
    rw [mul_sub, mul_sub, mul_add, mul_add, mul_one, mul_smul_comm, mul_smul_comm, hQE, hFEF,
      hQP, hQQ, smul_zero]
    abel
  rw [add_mul, add_mul, one_mul, smul_mul_assoc, smul_mul_assoc, hPW, hQW, smul_smul]
  simp only [sub_smul, one_smul, neg_smul, mul_neg, mul_one]
  abel

end NormalForm





/-! ## The two idempotents on a weight vector -/

section WeightProjection

variable {E F H : Module.End ℚ V}

/-- **The two square-zero products split a weight vector.** The products `E F` and `F E` are
orthogonal idempotents whose difference is `H`, so a nonzero `H`-eigenvector has eigenvalue `1`, `0`
or `-1`, and in the outer two cases it is fixed by `E F` respectively by `F E` while the other
product kills it. -/
private theorem proj_apply_of_isCartanWeight (hEE : E * E = 0) (hFF : F * F = 0)
    (hEFE : E * F * E = E) (hFEF : F * E * F = F) (hef : E * F - F * E = H) {m : ℤ} {v : V}
    (hv : H v = (m : ℚ) • v) (hv0 : v ≠ 0) :
    (m = 1 ∧ (E * F) v = v ∧ (F * E) v = 0) ∨ (m = 0 ∧ (E * F) v = 0 ∧ (F * E) v = 0) ∨
      (m = -1 ∧ (E * F) v = 0 ∧ (F * E) v = v) := by
  have hPP : E * F * (E * F) = E * F := by rw [← mul_assoc, hEFE]
  have hQQ : F * E * (F * E) = F * E := by rw [← mul_assoc, hFEF]
  have hPQ : E * F * (F * E) = 0 := by rw [← mul_assoc, mul_assoc E F F, hFF, mul_zero, zero_mul]
  have hQP : F * E * (E * F) = 0 := by rw [← mul_assoc, mul_assoc F E E, hEE, mul_zero, zero_mul]
  have hRP : (1 - E * F - F * E) * (E * F) = 0 := by
    rw [sub_mul, sub_mul, one_mul, hPP, hQP]
    abel
  have hRQ : (1 - E * F - F * E) * (F * E) = 0 := by
    rw [sub_mul, sub_mul, one_mul, hPQ, hQQ]
    abel
  have hbase : (E * F) v - (F * E) v = (m : ℚ) • v := by
    rw [← LinearMap.sub_apply, hef, hv]
  have k1 : ((1 : ℚ) - m) • ((E * F) v) = 0 := by
    have hap := congrArg (fun w => (E * F) w) hbase
    simp only [map_sub, map_smul, ← Module.End.mul_apply, hPP, hPQ, LinearMap.zero_apply,
      sub_zero] at hap
    rw [sub_smul, one_smul, ← hap, sub_self]
  have k2 : ((1 : ℚ) + m) • ((F * E) v) = 0 := by
    have hap := congrArg (fun w => (F * E) w) hbase
    simp only [map_sub, map_smul, ← Module.End.mul_apply, hQQ, hQP, LinearMap.zero_apply,
      zero_sub] at hap
    rw [add_smul, one_smul, ← hap, add_neg_cancel]
  have k3 : (m : ℚ) • (v - (E * F) v - (F * E) v) = 0 := by
    have hRv : (1 - E * F - F * E) ((m : ℚ) • v) =
        (m : ℚ) • (v - (E * F) v - (F * E) v) := by
      rw [map_smul, LinearMap.sub_apply, LinearMap.sub_apply, Module.End.one_apply]
    rw [← hRv, ← hbase, map_sub, ← Module.End.mul_apply, ← Module.End.mul_apply, hRP, hRQ,
      LinearMap.zero_apply, sub_zero]
  have hPv : m ≠ 1 → (E * F) v = 0 := fun hm => by
    have hne : ((1 : ℚ) - m) ≠ 0 := fun hz => hm (by exact_mod_cast (sub_eq_zero.1 hz).symm)
    exact (smul_eq_zero.1 k1).resolve_left hne
  have hQv : m ≠ -1 → (F * E) v = 0 := fun hm => by
    have hne : ((1 : ℚ) + m) ≠ 0 := fun hz =>
      hm (by exact_mod_cast (neg_eq_of_add_eq_zero_right hz).symm)
    exact (smul_eq_zero.1 k2).resolve_left hne
  have hsum : m ≠ 0 → v - (E * F) v - (F * E) v = 0 := fun hm =>
    (smul_eq_zero.1 k3).resolve_left (Int.cast_ne_zero.2 hm)
  have hm : m = 1 ∨ m = 0 ∨ m = -1 := by
    by_contra hcon
    push Not at hcon
    refine hv0 ?_
    have hz := hsum hcon.2.1
    rwa [hPv hcon.1, hQv hcon.2.2, sub_zero, sub_zero] at hz
  rcases hm with hm | hm | hm
  · refine Or.inl ⟨hm, ?_, hQv (by omega)⟩
    have hz := hsum (by omega)
    rw [hQv (by omega), sub_zero, sub_eq_zero] at hz
    exact hz.symm
  · exact Or.inr (Or.inl ⟨hm, hPv (by omega), hQv (by omega)⟩)
  · refine Or.inr (Or.inr ⟨hm, hPv (by omega), ?_⟩)
    have hz := hsum (by omega)
    rw [hPv (by omega), sub_zero, sub_eq_zero] at hz
    exact hz.symm

end WeightProjection

variable {i j : ι} {c : κ}

/-- The integral root operator computes the ambient action on a product. -/
private theorem coe_kostantRootOperator_mul_apply (k l : ι) (v : M) :
    (((kostantRootOperator e h ρ M hM k * kostantRootOperator e h ρ M hM l) v : M) : V) =
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e k))
        (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e l)) (v : V)) := by
  rw [Module.End.mul_apply, coe_kostantRootOperator_apply, coe_kostantRootOperator_apply]

/-- The integral root operator computes the ambient action on a triple product. -/
private theorem coe_kostantRootOperator_mul_mul_apply (k l n : ι) (v : M) :
    (((kostantRootOperator e h ρ M hM k * kostantRootOperator e h ρ M hM l *
        kostantRootOperator e h ρ M hM n) v : M) : V) =
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e k))
        (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e l))
          (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e n)) (v : V))) := by
  rw [Module.End.mul_apply, coe_kostantRootOperator_mul_apply, coe_kostantRootOperator_apply]

/-- A vanishing product of ambient root vectors makes the product of integral root operators
vanish. -/
private theorem kostantRootOperator_mul_eq_zero {k l : ι}
    (hkl : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e k)) *
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e l)) = 0) :
    kostantRootOperator e h ρ M hM k * kostantRootOperator e h ρ M hM l = 0 := by
  refine LinearMap.ext fun v => Subtype.ext ?_
  rw [coe_kostantRootOperator_mul_apply, ← Module.End.mul_apply, hkl]
  simp

/-- The triple-product identity of ambient root vectors transfers to the integral root
operators. -/
private theorem kostantRootOperator_mul_mul_eq {k l : ι}
    (hkl : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e k)) *
        ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e l)) *
        ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e k)) =
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e k))) :
    kostantRootOperator e h ρ M hM k * kostantRootOperator e h ρ M hM l *
        kostantRootOperator e h ρ M hM k = kostantRootOperator e h ρ M hM k := by
  refine LinearMap.ext fun v => Subtype.ext ?_
  rw [coe_kostantRootOperator_mul_mul_apply, coe_kostantRootOperator_apply,
    ← Module.End.mul_apply, ← Module.End.mul_apply, hkl]

end SquareZero

/-! ## The weight torus of a carrier with square-zero root operators -/

section Main

variable {η : Type*} (b : Module.Basis η ℤ M) (wt : η → κ → ℤ)
variable [Fintype κ] [DecidableEq κ]

/-- **A square-zero `sl₂` pair puts every coroot value in the elementary group.** The rank-one
identity `x_α(u) x_{-α}(-u⁻¹) x_α(u) = h_α(u) n_α` exhibits the coroot value at an arbitrary unit as
a product of root subgroup elements, with no coprimality condition on the coordinates of `α`. -/
theorem kostantCoordinateCocharacter_mem_kostantElementarySubgroup_of_sq_eq_zero
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V))
    (hT : IsSl2Triple (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
    (hsqi : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) ^ 2 = 0)
    (hsqj : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) ^ 2 = 0)
    (A : CommAlgCat.{w} ℤ) (u : Aˣ) :
    kostantCoordinateCocharacter M b wt A c u ∈
      kostantElementarySubgroup e h ρ M hM hnil A := by
  have hEE : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) *
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) = 0 := by rw [← pow_two]; exact hsqi
  have hFF : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) *
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) = 0 := by rw [← pow_two]; exact hsqj
  have hef : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) *
        ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) -
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) *
        ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) =
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)) := by
    have hb := hT.lie_e_f
    rwa [LieRing.of_associative_ring_bracket] at hb
  have hhe : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)) *
        ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) -
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) *
        ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)) =
      (2 : ℚ) • ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) := by
    have hb := IsSl2Triple.lie_h_e_smul ℚ hT
    rwa [LieRing.of_associative_ring_bracket] at hb
  have hhf : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)) *
        ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) -
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) *
        ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)) =
      -((2 : ℚ) • ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))) := by
    have hb := IsSl2Triple.lie_lie_smul_f ℚ hT
    rwa [LieRing.of_associative_ring_bracket] at hb
  have hEFE := mul_mul_self_eq_of_sq_eq_zero hEE hef hhe
  have hFEF : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) *
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) *
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) =
      ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) := by
    refine mul_mul_self_eq_of_sq_eq_zero hFF
      (H := -ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c))) ?_ ?_
    · rw [← hef]; abel
    · have hneg : -ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)) *
            ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) -
          ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) *
            -ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)) =
          -(ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)) *
              ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) -
            ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) *
              ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c))) := by
        rw [neg_mul, mul_neg]; abel
      rw [hneg, hhf, neg_neg]
  -- the integral root operators and their base changes
  have hXX := kostantRootOperator_mul_eq_zero e h ρ M hM hEE
  have hYY := kostantRootOperator_mul_eq_zero e h ρ M hM hFF
  have hXYX := kostantRootOperator_mul_mul_eq e h ρ M hM hEFE
  have hYXY := kostantRootOperator_mul_mul_eq e h ρ M hM hFEF
  set X := kostantRootOperator e h ρ M hM i with hXdef
  set Y := kostantRootOperator e h ρ M hM j with hYdef
  set E' := X.baseChange (A : Type w) with hE'def
  set F' := Y.baseChange (A : Type w) with hF'def
  have hE'E' : E' * E' = 0 := by
    rw [hE'def, ← LinearMap.baseChange_mul, hXX, LinearMap.baseChange_zero]
  have hF'F' : F' * F' = 0 := by
    rw [hF'def, ← LinearMap.baseChange_mul, hYY, LinearMap.baseChange_zero]
  have hE'F'E' : E' * F' * E' = E' := by
    rw [hE'def, hF'def, ← LinearMap.baseChange_mul, ← LinearMap.baseChange_mul, hXYX]
  have hF'E'F' : F' * E' * F' = F' := by
    rw [hE'def, hF'def, ← LinearMap.baseChange_mul, ← LinearMap.baseChange_mul, hYXY]
  -- the normal form of a triple product of root subgroup elements
  have hparam : ∀ t : A, (kostantRootSubgroupParam e h ρ M hM i (hnil i) A
      (Multiplicative.ofAdd t)).val = 1 + t • E' := fun t => by
    rw [kostantRootSubgroupParam_val_of_sq_eq_zero e h ρ M hM hnil i hsqi A
      (Multiplicative.ofAdd t), toAdd_ofAdd]
  have hparam' : ∀ t : A, (kostantRootSubgroupParam e h ρ M hM j (hnil j) A
      (Multiplicative.ofAdd t)).val = 1 + t • F' := fun t => by
    rw [kostantRootSubgroupParam_val_of_sq_eq_zero e h ρ M hM hnil j hsqj A
      (Multiplicative.ofAdd t), toAdd_ofAdd]
  have htriple : ∀ α β : A, α * β = -1 →
      ((kostantRootSubgroupParam e h ρ M hM i (hnil i) A (Multiplicative.ofAdd α)) *
        (kostantRootSubgroupParam e h ρ M hM j (hnil j) A (Multiplicative.ofAdd β)) *
        (kostantRootSubgroupParam e h ρ M hM i (hnil i) A
          (Multiplicative.ofAdd α))).val =
        1 + α • E' + β • F' - E' * F' - F' * E' := by
    intro α β hαβ
    rw [Units.val_mul, Units.val_mul, hparam, hparam']
    exact sq_zero_triple_product hE'E' hE'F'E' hαβ
  -- the coordinate cocharacter in the same normal form
  have htorus : (kostantCoordinateCocharacter M b wt A c u).val =
      1 + ((u : A) - 1) • (E' * F') + ((((u⁻¹ : Aˣ) : A)) - 1) • (F' * E') := by
    refine (b.baseChange A).ext fun x => ?_
    have hbx0 : ((b x : M) : V) ≠ 0 := by
      simpa only [ne_eq, ZeroMemClass.coe_eq_zero] using b.ne_zero x
    have hPcoe : (((X * Y) (b x) : M) : V) =
        (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) *
          ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))) ((b x : M) : V) := by
      rw [hXdef, hYdef, coe_kostantRootOperator_mul_apply, Module.End.mul_apply]
    have hQcoe : (((Y * X) (b x) : M) : V) =
        (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j)) *
          ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))) ((b x : M) : V) := by
      rw [hXdef, hYdef, coe_kostantRootOperator_mul_apply, Module.End.mul_apply]
    have hEF : E' * F' = (X * Y).baseChange (A : Type w) := by
      rw [hE'def, hF'def, LinearMap.baseChange_mul]
    have hFE : F' * E' = (Y * X).baseChange (A : Type w) := by
      rw [hE'def, hF'def, LinearMap.baseChange_mul]
    have hwtx := (isCartanWeightVector_iff h ρ).1 (hwt x) c
    rcases proj_apply_of_isCartanWeight hEE hFF hEFE hFEF hef hwtx hbx0 with
      ⟨hm, hP, hQ⟩ | ⟨hm, hP, hQ⟩ | ⟨hm, hP, hQ⟩
    · have hPM : (X * Y) (b x) = b x := Subtype.ext (by rw [hPcoe, hP])
      have hQM : (Y * X) (b x) = 0 := Subtype.ext (by rw [hQcoe, hQ, ZeroMemClass.coe_zero])
      rw [Module.Basis.baseChange_apply, kostantCoordinateCocharacter_tmul_basis, hm, hEF, hFE]
      simp only [LinearMap.add_apply, Module.End.one_apply, LinearMap.smul_apply,
        LinearMap.baseChange_tmul, hPM, hQM, tmul_zero, smul_zero, add_zero, smul_tmul',
        smul_eq_mul, mul_one, zpow_one]
      rw [← add_tmul]
      ring_nf
    · have hPM : (X * Y) (b x) = 0 := Subtype.ext (by rw [hPcoe, hP, ZeroMemClass.coe_zero])
      have hQM : (Y * X) (b x) = 0 := Subtype.ext (by rw [hQcoe, hQ, ZeroMemClass.coe_zero])
      rw [Module.Basis.baseChange_apply, kostantCoordinateCocharacter_tmul_basis, hm, hEF, hFE]
      simp only [LinearMap.add_apply, Module.End.one_apply, LinearMap.smul_apply,
        LinearMap.baseChange_tmul, hPM, hQM, tmul_zero, smul_zero, add_zero, zpow_zero,
        Units.val_one, mul_one]
    · have hPM : (X * Y) (b x) = 0 := Subtype.ext (by rw [hPcoe, hP, ZeroMemClass.coe_zero])
      have hQM : (Y * X) (b x) = b x := Subtype.ext (by rw [hQcoe, hQ])
      rw [Module.Basis.baseChange_apply, kostantCoordinateCocharacter_tmul_basis, hm, hEF, hFE]
      simp only [LinearMap.add_apply, Module.End.one_apply, LinearMap.smul_apply,
        LinearMap.baseChange_tmul, hPM, hQM, tmul_zero, smul_zero, add_zero, smul_tmul',
        smul_eq_mul, mul_one, zpow_neg, zpow_one]
      rw [← add_tmul]
      ring_nf
  -- the Weyl representative at parameter one, and the final factorization
  have hunit : (u : A) * (-(((u⁻¹ : Aˣ) : A))) = -1 := by simp
  have hone : (1 : A) * (-1 : A) = -1 := one_mul _
  have hfactor : kostantCoordinateCocharacter M b wt A c u =
      ((kostantRootSubgroupParam e h ρ M hM i (hnil i) A (Multiplicative.ofAdd (u : A))) *
        (kostantRootSubgroupParam e h ρ M hM j (hnil j) A
          (Multiplicative.ofAdd (-(((u⁻¹ : Aˣ) : A))))) *
        (kostantRootSubgroupParam e h ρ M hM i (hnil i) A
          (Multiplicative.ofAdd (u : A)))) *
      ((kostantRootSubgroupParam e h ρ M hM i (hnil i) A (Multiplicative.ofAdd (1 : A))) *
        (kostantRootSubgroupParam e h ρ M hM j (hnil j) A (Multiplicative.ofAdd (-(1 : A)))) *
        (kostantRootSubgroupParam e h ρ M hM i (hnil i) A
          (Multiplicative.ofAdd (1 : A))))⁻¹ := by
    refine (eq_mul_inv_iff_mul_eq.2 ?_)
    refine Units.ext ?_
    rw [Units.val_mul, htorus, htriple 1 (-1) hone, htriple (u : A) _ hunit]
    exact torus_mul_weyl hE'E' hF'F' hE'F'E' hF'E'F' _ _
  rw [hfactor]
  refine mul_mem (mul_mem (mul_mem ?_ ?_) ?_) (inv_mem (mul_mem (mul_mem ?_ ?_) ?_)) <;>
    exact kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A _ _

-- The assembly of a torus point out of its coordinate cocharacters is the step that the
-- coprimality criterion `kostantTorusSubgroup_le_kostantElementarySubgroup` also performs; it is
-- isolated here so that each coordinate may be discharged by whichever criterion applies to it.
/-- **The weight torus lies in the elementary group** as soon as every coordinate cocharacter
does. -/
theorem kostantTorusSubgroup_le_kostantElementarySubgroup_of_forall_coordinateCocharacter
    (A : CommAlgCat.{w} ℤ)
    (hcoord : ∀ (d : κ) (v : (A : Type w)ˣ), kostantCoordinateCocharacter M b wt A d v ∈
      kostantElementarySubgroup e h ρ M hM hnil A) :
    kostantTorusSubgroup M b wt A ≤ kostantElementarySubgroup e h ρ M hM hnil A := by
  classical
  rw [kostantTorusSubgroup_eq_range]
  rintro - ⟨s, rfl⟩
  have key : s ∈ (kostantElementarySubgroup e h ρ M hM hnil A).comap
      (kostantTorusPoints M b wt A) := by
    rw [← Finset.univ_prod_mulSingle s]
    refine prod_mem fun d _ => Subgroup.mem_comap.2 ?_
    rw [← kostantCoordinateCocharacter_apply]
    exact hcoord d (s d)
  exact Subgroup.mem_comap.1 key

omit [DecidableEq κ] in
/-- **The Borel-type join of the weight torus with every root subgroup is the elementary group**
when every numbered root operator squares to zero. -/
theorem kostantTorusSubsystemSubgroup_univ_eq_kostantElementarySubgroup_of_sq_eq_zero
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V)) (raise lower : κ → ι)
    (hT : ∀ d, IsSl2Triple (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h d)))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e (raise d))))
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e (lower d)))))
    (hsq : ∀ k, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e k)) ^ 2 = 0)
    (A : CommAlgCat.{w} ℤ) :
    kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt Set.univ A =
      kostantElementarySubgroup e h ρ M hM hnil A := by
  classical
  rw [kostantTorusSubsystemSubgroup_univ, ← kostantTorusSubgroup_eq_range, sup_eq_left]
  exact kostantTorusSubgroup_le_kostantElementarySubgroup_of_forall_coordinateCocharacter e h ρ M
    hM hnil b wt A fun d v =>
      kostantCoordinateCocharacter_mem_kostantElementarySubgroup_of_sq_eq_zero e h ρ M hM hnil b wt
        hwt (hT d) (hsq (raise d)) (hsq (lower d)) A v

end Main

end TauCeti.UniversalEnvelopingAlgebra
