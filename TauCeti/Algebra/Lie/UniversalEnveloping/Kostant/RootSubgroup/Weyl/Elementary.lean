module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Elementary.Basic
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Weyl.Basic

/-!
# The Weyl representative and Steinberg's elements in the elementary group

The Weyl representative of a root pair `(eᵢ, eⱼ)` is defined in
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Weyl.Basic` as the scalar extension
of an integral automorphism of the admissible lattice, and identified there with the product of
divided-power exponentials `exp(ρ eᵢ) exp(-ρ eⱼ) exp(ρ eᵢ)`. This file reads that product in the
parametrized root subgroups `xᵢ(t)` of
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Elementary.Basic`:

```text
n = xᵢ(1) xⱼ(-1) xᵢ(1),
```

so that `n` is visibly an element of the elementary group generated by the root subgroups.

The two files this sits between are independent of each other, which is why the identification
lives here rather than in either. No `sl₂` relation between `eᵢ` and `eⱼ` is used for it: the
statement is about the three exponentials alone.

Following Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 19, the same product with a
unit parameter `u` of the value ring defines

```text
n_α(u) = xᵢ(u) xⱼ(-u⁻¹) xᵢ(u),
```

which is `n` at `u = 1`. Its inverse, elementary-group membership and naturality in the value ring
only use that the root subgroups are homomorphisms. Finally, when `(h c, eᵢ, eⱼ)` maps to an `sl₂`
triple, the interchange `n xᵢ(t) n⁻¹ = xⱼ(-t)` of
`TauCeti.UniversalEnvelopingAlgebra.kostantWeylPoints_conj_baseChangeExp` is restated in the general
linear group of the points, where the parametrized root subgroups live. The relations of `n_α(u)`
with the weight torus are in
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Weyl.RankOne`.

## Main definitions

* `TauCeti.UniversalEnvelopingAlgebra.kostantWeylParam`: Steinberg's element `n_α(u)`.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.kostantWeylGL_eq_kostantRootSubgroupParam_mul`: the Weyl
  representative is the product `xᵢ(1) xⱼ(-1) xᵢ(1)` of parametrized root-subgroup elements.
* `TauCeti.UniversalEnvelopingAlgebra.kostantWeylGL_mem_kostantElementarySubgroup`: it therefore
  belongs to the elementary group.
* `TauCeti.UniversalEnvelopingAlgebra.mapScalarExtensionAutomorphisms_kostantWeylGL`: it is
  natural in the value ring.
* `TauCeti.UniversalEnvelopingAlgebra.kostantWeylParam_one` and
  `TauCeti.UniversalEnvelopingAlgebra.kostantWeylParam_inv`: `n_α(1) = n` and
  `n_α(u)⁻¹ = n_α(-u)`.
* `TauCeti.UniversalEnvelopingAlgebra.kostantWeylGL_conj_kostantRootSubgroupParam_e`: the Weyl
  representative carries `xᵢ(t)` to `xⱼ(-t)`.

## References

* R. W. Carter, *Simple Groups of Lie Type*, §6.4.
* R. Steinberg, *Lectures on Chevalley Groups*, AMS University Lecture Series 66 (2016),
  Chapter 3, Lemma 19.
-/

public section

open TensorProduct

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι : Type*} {κ : Type*}
variable {V : Type v} [AddCommGroup V] [Module ℚ V]

variable (e : ι → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M)

attribute [local instance 100] LieRing.ofAssociativeRing

-- Match tensor products to the `ℤ`-algebra instance stored by `CommAlgCat` objects.
attribute [local instance high] Algebra.toModule

variable {i j : ι}
variable (hi : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable (hj : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))

/-- **The Weyl representative is the Chevalley product `xᵢ(1) xⱼ(-1) xᵢ(1)`**, written in the
parametrized root subgroups. -/
theorem kostantWeylGL_eq_kostantRootSubgroupParam_mul (A : CommAlgCat.{w} ℤ) :
    kostantWeylGL e h ρ M hM hi hj A =
      kostantRootSubgroupParam e h ρ M hM i hi A (Multiplicative.ofAdd (1 : A)) *
        kostantRootSubgroupParam e h ρ M hM j hj A (Multiplicative.ofAdd (-1 : A)) *
        kostantRootSubgroupParam e h ρ M hM i hi A (Multiplicative.ofAdd (1 : A)) := by
  refine Units.ext ?_
  rw [kostantWeylGL_val, kostantWeylPoints_toLinearMap_eq]
  refine LinearMap.ext fun z => ?_
  simp only [Units.val_mul, mul_apply_eq_comp, kostantRootSubgroupParam_val_apply,
    toAdd_ofAdd]

/-- **Scalar extension of the Weyl representative.** Extending scalars along a morphism of value
rings carries the Weyl representative over `A` to the one over `B`: its three factors have the
integer parameters `1` and `-1`, which every morphism fixes. -/
theorem mapScalarExtensionAutomorphisms_kostantWeylGL {A B : CommAlgCat.{w} ℤ} (φ : A ⟶ B) :
    GeneralLinear.mapScalarExtensionAutomorphisms (V := M) φ (kostantWeylGL e h ρ M hM hi hj A) =
      kostantWeylGL e h ρ M hM hi hj B := by
  rw [kostantWeylGL_eq_kostantRootSubgroupParam_mul,
    kostantWeylGL_eq_kostantRootSubgroupParam_mul, map_mul, map_mul,
    mapScalarExtensionAutomorphisms_kostantRootSubgroupParam,
    mapScalarExtensionAutomorphisms_kostantRootSubgroupParam, toAdd_ofAdd, toAdd_ofAdd,
    map_neg, map_one φ.hom]

include e hM in
/-- **The Weyl representative lies in the elementary group**, being a product of three
root-subgroup elements. -/
theorem kostantWeylGL_mem_kostantElementarySubgroup
    (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
    (i j : ι) (A : CommAlgCat.{w} ℤ) :
    kostantWeylGL e h ρ M hM (hnil i) (hnil j) A ∈
      kostantElementarySubgroup e h ρ M hM hnil A := by
  rw [kostantWeylGL_eq_kostantRootSubgroupParam_mul]
  exact mul_mem
    (mul_mem (kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A i _)
      (kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A j _))
    (kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A i _)

/-! ## Steinberg's element `n_α(u)` -/

section Param

/-- **Steinberg's element** `n_α(u) = xᵢ(u) xⱼ(-u⁻¹) xᵢ(u)` of a pair of Kostant root subgroups,
at a unit `u` of the value ring. At `u = 1` it is the Weyl representative
`TauCeti.UniversalEnvelopingAlgebra.kostantWeylGL` (`kostantWeylParam_one`). -/
noncomputable def kostantWeylParam (A : CommAlgCat.{w} ℤ) (u : Aˣ) :
    LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M) :=
  kostantRootSubgroupParam e h ρ M hM i hi A (Multiplicative.ofAdd (u : A)) *
    kostantRootSubgroupParam e h ρ M hM j hj A (Multiplicative.ofAdd (-((u⁻¹ : Aˣ) : A))) *
    kostantRootSubgroupParam e h ρ M hM i hi A (Multiplicative.ofAdd (u : A))

/-- Steinberg's element is the product `xᵢ(u) xⱼ(-u⁻¹) xᵢ(u)` of root subgroup elements. -/
theorem kostantWeylParam_def (A : CommAlgCat.{w} ℤ) (u : Aˣ) :
    kostantWeylParam e h ρ M hM hi hj A u =
      kostantRootSubgroupParam e h ρ M hM i hi A (Multiplicative.ofAdd (u : A)) *
        kostantRootSubgroupParam e h ρ M hM j hj A (Multiplicative.ofAdd (-((u⁻¹ : Aˣ) : A))) *
        kostantRootSubgroupParam e h ρ M hM i hi A (Multiplicative.ofAdd (u : A)) :=
  (rfl)

/-- At the parameter `1`, Steinberg's element is the Weyl representative `xᵢ(1) xⱼ(-1) xᵢ(1)`. -/
@[simp]
theorem kostantWeylParam_one (A : CommAlgCat.{w} ℤ) :
    kostantWeylParam e h ρ M hM hi hj A 1 = kostantWeylGL e h ρ M hM hi hj A := by
  rw [kostantWeylParam_def, kostantWeylGL_eq_kostantRootSubgroupParam_mul, inv_one,
    Units.val_one]

/-- **The inverse of Steinberg's element** is `n_α(u)⁻¹ = n_α(-u)`: inverting the product reverses
its palindromic order and negates each parameter. -/
@[simp]
theorem kostantWeylParam_inv (A : CommAlgCat.{w} ℤ) (u : Aˣ) :
    (kostantWeylParam e h ρ M hM hi hj A u)⁻¹ = kostantWeylParam e h ρ M hM hi hj A (-u) := by
  simp only [kostantWeylParam_def, mul_inv_rev, ← map_inv, ← ofAdd_neg, inv_neg, Units.val_neg,
    neg_neg, mul_assoc]

/-- Steinberg's element lies in the elementary group, being a product of three root subgroup
elements. -/
theorem kostantWeylParam_mem_kostantElementarySubgroup
    (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
    (i j : ι) (A : CommAlgCat.{w} ℤ) (u : Aˣ) :
    kostantWeylParam e h ρ M hM (hnil i) (hnil j) A u ∈
      kostantElementarySubgroup e h ρ M hM hnil A := by
  rw [kostantWeylParam_def]
  exact mul_mem
    (mul_mem (kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A i _)
      (kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A j _))
    (kostantRootSubgroupParam_mem_kostantElementarySubgroup e h ρ M hM hnil A i _)

/-- **Scalar extension of Steinberg's element.** Extending scalars along a morphism `φ` of value
rings carries `n_α(u)` over `A` to `n_α(φ u)` over `B`. -/
theorem mapScalarExtensionAutomorphisms_kostantWeylParam {A B : CommAlgCat.{w} ℤ} (φ : A ⟶ B)
    (u : Aˣ) :
    GeneralLinear.mapScalarExtensionAutomorphisms (V := M) φ
        (kostantWeylParam e h ρ M hM hi hj A u) =
      kostantWeylParam e h ρ M hM hi hj B (Units.map (φ.hom : A →* B) u) := by
  rw [kostantWeylParam_def, kostantWeylParam_def, map_mul, map_mul,
    mapScalarExtensionAutomorphisms_kostantRootSubgroupParam,
    mapScalarExtensionAutomorphisms_kostantRootSubgroupParam, toAdd_ofAdd, toAdd_ofAdd, map_neg,
    Units.coe_map, Units.coe_map_inv, MonoidHom.coe_ofClass]

end Param

/-! ## The Weyl representative on the root subgroups -/

section WeylGL

variable {c : κ}
variable (hT : IsSl2Triple (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)))
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)))
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))

include hT in
/-- **The Weyl representative interchanges the two root subgroups**, in the general linear group
of the points: `n xᵢ(t) n⁻¹ = xⱼ(-t)` over every value ring. -/
theorem kostantWeylGL_conj_kostantRootSubgroupParam_e (A : CommAlgCat.{w} ℤ) (t : A) :
    kostantWeylGL e h ρ M hM hi hj A *
        kostantRootSubgroupParam e h ρ M hM i hi A (Multiplicative.ofAdd t) *
        (kostantWeylGL e h ρ M hM hi hj A)⁻¹ =
      kostantRootSubgroupParam e h ρ M hM j hj A (Multiplicative.ofAdd (-t)) := by
  refine Units.ext ?_
  rw [Units.val_mul, Units.val_mul, kostantWeylGL_val, kostantWeylGL_inv_val,
    kostantRootSubgroupParam_apply, kostantRootSubgroupParam_apply, kostantRootSubgroupPoints_val,
    kostantRootSubgroupPoints_val, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply,
    toAdd_ofAdd, toAdd_ofAdd]
  exact kostantWeylPoints_conj_baseChangeExp e h ρ M hM hi hj hT t

end WeylGL

end TauCeti.UniversalEnvelopingAlgebra
