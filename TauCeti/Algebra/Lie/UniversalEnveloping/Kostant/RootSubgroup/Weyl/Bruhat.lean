module

public import TauCeti.Algebra.Group.RankOne.Bruhat
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Weyl.RankOne

/-!
# Bruhat forms for a Kostant root pair

Over a field, the subgroup generated by an opposite pair of divided-power root groups has
the two Bruhat forms `x(a) h(s)` and `x(a) h(s) n x(b)`. Here `h` is the coordinate
cocharacter of the pair and `n = x(1) y(-1) x(1)`. The proof uses the integral rank-one
relations, so it applies to arbitrary nilpotent root actions on a Kostant-stable lattice,
including representations with long root strings and adjoint representations.

The nonzero negative-root factorization is proved over any commutative ring at a unit
parameter. Over a field it supplies the exchange step needed to collect all words in the
two root groups. No injectivity, cell separation or uniqueness is asserted; these depend
on the particular representation. This is a rank-one statement, not a Bruhat decomposition
of the whole toral closure or of a higher-rank elementary group.

The central inputs are `kostantWeylParam_def`, Chevalley's identity
`kostantRootSubgroupParam_mul_mul_eq_kostantCoordinateCocharacter_mul_kostantWeylGL`,
and the conjugation and square relations in `Weyl.RankOne`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 19–20 and Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §6.4.
-/

public section

open TensorProduct Multiplicative

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

attribute [local instance 100] LieRing.ofAssociativeRing
-- Match tensor products to the integral algebra instance stored by `CommAlgCat` objects.
attribute [local instance high] Algebra.toModule

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι κ : Type*} [Fintype κ] [DecidableEq κ]
variable {V : Type v} [AddCommGroup V] [Module ℚ V]
variable (e : ι → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ z ∈ kostantForm e h, ∀ m ∈ M, ρ z m ∈ M)
variable {i j : ι}
variable (hi : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable (hj : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
variable {η : Type*} (b : Module.Basis η ℤ M) (wt : η → κ → ℤ)
variable (hwt : ∀ q, IsCartanWeightVector h ρ (wt q) ((b q : M) : V))
variable {c : κ} {α : κ → ℤ}
variable (hT : IsSl2Triple (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (h c)))
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)))
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
variable (hα : ∀ q, ⁅h q, e i⁆ = (α q : ℚ) • e i)
variable (hαneg : ∀ q, ⁅h q, e j⁆ = -((α q : ℚ) • e j))

include hwt hT hα hαneg

/-- A negative root element at a unit parameter lies in the Weyl-containing Bruhat form,
with its explicit root and coroot coordinates. -/
theorem kostantRootSubgroupParam_f_eq_mul_kostantCoordinateCocharacter_mul_kostantWeylGL_mul
    (A : CommAlgCat.{w} ℤ) (u : Aˣ) :
    kostantRootSubgroupParam e h ρ M hM j hj A (ofAdd (u : A)) =
      kostantRootSubgroupParam e h ρ M hM i hi A (ofAdd ((u⁻¹ : Aˣ) : A)) *
        kostantCoordinateCocharacter M b wt A c (-u⁻¹) *
        kostantWeylGL e h ρ M hM hi hj A *
        kostantRootSubgroupParam e h ρ M hM i hi A (ofAdd ((u⁻¹ : Aˣ) : A)) := by
  rw [kostantRootSubgroupParam_f_eq_mul_kostantWeylParam e h ρ M hM hi hj A u,
    kostantWeylParam_def,
    kostantRootSubgroupParam_mul_mul_eq_kostantCoordinateCocharacter_mul_kostantWeylGL
      e h ρ M hM b wt hwt hT hi hj hα hαneg]
  simp only [mul_assoc]

/-- The rank-one exchange identity at a unit parameter:
`n xᵢ(u) n = xᵢ(-u⁻¹) h_c(-u⁻¹) n xᵢ(-u⁻¹)`, over every value ring. -/
theorem kostantWeylGL_mul_kostantRootSubgroupParam_mul_kostantWeylGL
    (A : CommAlgCat.{w} ℤ) (u : Aˣ) :
    kostantWeylGL e h ρ M hM hi hj A *
        kostantRootSubgroupParam e h ρ M hM i hi A (ofAdd (u : A)) *
        kostantWeylGL e h ρ M hM hi hj A =
      kostantRootSubgroupParam e h ρ M hM i hi A (ofAdd (-((u⁻¹ : Aˣ) : A))) *
        kostantCoordinateCocharacter M b wt A c (-u⁻¹) *
        kostantWeylGL e h ρ M hM hi hj A *
        kostantRootSubgroupParam e h ρ M hM i hi A (ofAdd (-((u⁻¹ : Aˣ) : A))) := by
  let x := kostantRootSubgroupParam e h ρ M hM i hi A
  let d := kostantCoordinateCocharacter M b wt A c
  let n := kostantWeylGL e h ρ M hM hi hj A
  have hconj := kostantWeylGL_conj_kostantRootSubgroupParam_e
    e h ρ M hM hi hj hT A (u : A)
  have hsq : n * n = d (-1) :=
    kostantWeylGL_mul_self e h ρ M hM hi hj b wt hwt hT hα hαneg A
  have hcentral : Commute (d (-1)) (x (ofAdd (-((u⁻¹ : Aˣ) : A)))) := by
    have hz := kostantCoordinateCocharacter_conj_kostantRootSubgroupParam
      e h ρ M hM b wt hwt hT hi hα A (-1) (-((u⁻¹ : Aˣ) : A))
    simp only [Units.val_neg, Units.val_one, neg_sq, one_pow, one_mul] at hz
    exact mul_inv_eq_iff_eq_mul.mp hz
  have hf := kostantRootSubgroupParam_f_eq_mul_kostantCoordinateCocharacter_mul_kostantWeylGL_mul
    e h ρ M hM hi hj b wt hwt hT hα hαneg A (-u)
  simp only [inv_neg, Units.val_neg, neg_neg] at hf
  calc
    _ = kostantRootSubgroupParam e h ρ M hM j hj A (ofAdd (-(u : A))) * (n * n) := by
      dsimp only [n]
      rw [← hconj]
      group
    _ = x (ofAdd (-((u⁻¹ : Aˣ) : A))) * d u⁻¹ * n *
        x (ofAdd (-((u⁻¹ : Aˣ) : A))) * d (-1) := by rw [hf, hsq]
    _ = x (ofAdd (-((u⁻¹ : Aˣ) : A))) * (d u⁻¹ * d (-1)) * n *
        x (ofAdd (-((u⁻¹ : Aˣ) : A))) := by
      rw [mul_assoc _ (x (ofAdd (-((u⁻¹ : Aˣ) : A)))), ← hcentral.eq, ← hsq]
      group
    _ = _ := by rw [← d.map_mul, mul_neg, mul_one]

/-- An opposite pair generates the same subgroup as its positive root group, coroot and
Weyl representative. This equality holds over every commutative ring. -/
theorem closure_kostantRootPair_eq (A : CommAlgCat.{w} ℤ) :
    Subgroup.closure (Set.range (kostantRootSubgroupParam e h ρ M hM i hi A) ∪
        Set.range (kostantRootSubgroupParam e h ρ M hM j hj A)) =
      Subgroup.closure (Set.range (kostantRootSubgroupParam e h ρ M hM i hi A) ∪
        Set.range (kostantCoordinateCocharacter M b wt A c) ∪
          {kostantWeylGL e h ρ M hM hi hj A}) := by
  let x := kostantRootSubgroupParam e h ρ M hM i hi A
  let y := kostantRootSubgroupParam e h ρ M hM j hj A
  let d := kostantCoordinateCocharacter M b wt A c
  let n := kostantWeylGL e h ρ M hM hi hj A
  apply le_antisymm
  · refine (Subgroup.closure_le _).mpr ?_
    rintro z (⟨r, rfl⟩ | ⟨r, rfl⟩)
    · exact Subgroup.subset_closure (Or.inl (Or.inl ⟨r, rfl⟩))
    · have hx : x (ofAdd (-toAdd r)) ∈
          Subgroup.closure (Set.range x ∪ Set.range d ∪ {n}) :=
        Subgroup.subset_closure (Or.inl (Or.inl ⟨_, rfl⟩))
      have hnmem : n ∈ Subgroup.closure (Set.range x ∪ Set.range d ∪ {n}) :=
        Subgroup.subset_closure (Or.inr rfl)
      have hz := kostantWeylGL_conj_kostantRootSubgroupParam_e
        e h ρ M hM hi hj hT A (-toAdd r)
      simp only [neg_neg, ofAdd_toAdd] at hz
      rw [← hz]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hnmem hx) (Subgroup.inv_mem _ hnmem)
  · have hx (r : Multiplicative A) : x r ∈ Subgroup.closure (Set.range x ∪ Set.range y) :=
      Subgroup.subset_closure (Or.inl ⟨r, rfl⟩)
    have hy (r : Multiplicative A) : y r ∈ Subgroup.closure (Set.range x ∪ Set.range y) :=
      Subgroup.subset_closure (Or.inr ⟨r, rfl⟩)
    have hnmem : n ∈ Subgroup.closure (Set.range x ∪ Set.range y) := by
      dsimp only [n]
      rw [kostantWeylGL_eq_kostantRootSubgroupParam_mul]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (hx _) (hy _)) (hx _)
    refine (Subgroup.closure_le _).mpr ?_
    rintro z ((⟨r, rfl⟩ | ⟨s, rfl⟩) | hz)
    · exact hx r
    · have hw := kostantRootSubgroupParam_mul_mul_eq_kostantCoordinateCocharacter_mul_kostantWeylGL
        e h ρ M hM b wt hwt hT hi hj hα hαneg A s
      have hd : d s = (x (ofAdd (s : A)) * y (ofAdd (-((s⁻¹ : Aˣ) : A))) *
          x (ofAdd (s : A))) * n⁻¹ := by
        rw [hw]
        dsimp only [d, n]
        group
      rw [hd]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ (hx _) (hy _)) (hx _))
        (Subgroup.inv_mem _ hnmem)
    · exact Set.mem_singleton_iff.mp hz ▸ hnmem

/-- Over a field, every word in an opposite pair of Kostant root groups has one of the two
rank-one Bruhat forms, and every such form belongs to the generated subgroup. -/
theorem mem_closure_kostantRootPair_iff (K : Type w) [Field K]
    (g : LinearMap.GeneralLinearGroup K (K ⊗[ℤ] M)) :
    g ∈ Subgroup.closure
        (Set.range (kostantRootSubgroupParam e h ρ M hM i hi (CommAlgCat.of ℤ K)) ∪
          Set.range (kostantRootSubgroupParam e h ρ M hM j hj (CommAlgCat.of ℤ K))) ↔
      (∃ a s, g = kostantRootSubgroupParam e h ρ M hM i hi (CommAlgCat.of ℤ K) (ofAdd a) *
        kostantCoordinateCocharacter M b wt K c s) ∨
      ∃ a s r, g = kostantRootSubgroupParam e h ρ M hM i hi (CommAlgCat.of ℤ K) (ofAdd a) *
        kostantCoordinateCocharacter M b wt K c s *
        kostantWeylGL e h ρ M hM hi hj (CommAlgCat.of ℤ K) *
        kostantRootSubgroupParam e h ρ M hM i hi (CommAlgCat.of ℤ K) (ofAdd r) := by
  let A := CommAlgCat.of ℤ K
  let x := kostantRootSubgroupParam e h ρ M hM i hi A
  let d := kostantCoordinateCocharacter M b wt A c
  let n := kostantWeylGL e h ρ M hM hi hj A
  have hconj := kostantCoordinateCocharacter_conj_kostantRootSubgroupParam
    e h ρ M hM b wt hwt hT hi hα A
  have hn (s : Kˣ) : n * d s = d s⁻¹ * n := by
    have hz := kostantWeylParam_conj_kostantCoordinateCocharacter
      e h ρ M hM hi hj b wt hwt hT hα hαneg A 1 s
    rw [kostantWeylParam_one] at hz
    exact mul_inv_eq_iff_eq_mul.mp hz
  have hsq : n * n = d (-1) :=
    kostantWeylGL_mul_self e h ρ M hM hi hj b wt hwt hT hα hαneg A
  rw [closure_kostantRootPair_eq e h ρ M hM hi hj b wt hwt hT hα hαneg]
  exact x.mem_closure_rankOne_iff d n hconj hn hsq
    (kostantWeylGL_mul_kostantRootSubgroupParam_mul_kostantWeylGL
      e h ρ M hM hi hj b wt hwt hT hα hαneg A) g

end TauCeti.UniversalEnvelopingAlgebra
