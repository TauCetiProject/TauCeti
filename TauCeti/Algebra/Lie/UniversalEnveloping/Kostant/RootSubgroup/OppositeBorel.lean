module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Borel
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.PositiveSubsystem

/-!
# A positive Kostant subsystem group meets the opposite Borel-type group trivially

Let a Kostant form act on an integral lattice `M` with a finite weight basis `b` indexed by a
linearly ordered type, and let `S` and `S'` be two sets of distinguished root vectors. Suppose that
the root vectors indexed by `S` raise weights towards the beginning of the basis and those indexed
by `S'` move them towards its end: if a positive divided power of `eᵢ` carries the weight at basis
index `s` to the weight at `r`, then `r < s` for `i ∈ S` and `s < r` for `i ∈ S'`. For a positive
system of roots of a Chevalley system, `S` is the set of positive roots, `S'` the set of negative
ones, and the hypothesis holds for a basis ordered compatibly with the dominance order.

Over every commutative ring `A`, write `U_S(A)` for the subgroup generated by the root subgroups
indexed by `S` and `B_{S'}(A) = U_{S'}(A) ⬝ T(A)` for the subgroup generated by the split torus and
the root subgroups indexed by `S'`. This file proves

```text
U_S(A) ∩ B_{S'}(A) = 1.
```

In the ordered weight basis `U_S(A)` is upper unitriangular
(`TauCeti.UniversalEnvelopingAlgebra.map_kostantSubsystemSubgroup_le_upperUnitriangular`). The torus
acts diagonally
(`TauCeti.UniversalEnvelopingAlgebra.basisMatrix_kostantTorusPoints_mem_upperTriangular`) and the
root subgroups indexed by `S'` are lower unitriangular, so `B_{S'}(A)` is
lower triangular: this is the statement that a Borel-type group generated by positive root
subgroups and the torus is upper triangular, applied to the reversed order. A matrix that is both
upper unitriangular and lower triangular is the identity
(`Module.Basis.eq_one_of_toMatrix_mem_upperUnitriangularGroup_of_reindex_toDual`).
Taking `S'` empty gives `U_S(A) ∩ T(A) = 1`, and the same comparison of the two orders, without
the torus, gives `U_S(A) ∩ U_{S'}(A) = 1` for a Cartan index type that need not be finite.

For a Chevalley group over a field this is the statement `U ∩ B⁻ = 1` behind the uniqueness of
the normal form in the Bruhat decomposition.

## Main results

All in the namespace `TauCeti.UniversalEnvelopingAlgebra`:

* `map_kostantTorusSubsystemSubgroup_le_upperTriangular`: a Borel-type group generated by the
  torus and positive root subgroups is upper triangular in an ordered weight basis.
* `kostantSubsystemSubgroup_inf_kostantTorusSubsystemSubgroup_eq_bot`: `U_S(A) ∩ B_{S'}(A) = 1`.
* `kostantSubsystemSubgroup_inf_kostantSubsystemSubgroup_eq_bot` and
  `kostantSubsystemSubgroup_inf_range_kostantTorusPoints_eq_bot`: `U_S(A) ∩ U_{S'}(A) = 1` and
  `U_S(A) ∩ T(A) = 1`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, AMS University Lecture Series 66 (2016),
  Chapter 3.
-/

public section

open CategoryTheory TensorProduct

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w x

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι : Type w} {κ : Type*} [Fintype κ]
variable {V : Type x} [AddCommGroup V] [Module ℚ V]

variable (e : ι → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable {η : Type*} [LinearOrder η]
variable (b : Module.Basis η ℤ M) (wt : η → κ → ℤ)
variable (α : ι → κ → ℤ)

-- Match tensor products to the `ℤ`-algebra instance stored by `CommAlgCat` objects.
attribute [local instance high] Algebra.toModule


/-! ## The Borel-type group of a positive subsystem is upper triangular -/

/-- **A Borel-type group generated by the torus and positive root subgroups is upper triangular**
in an ordered weight basis: if each root vector indexed by `S` moves weights strictly towards the
beginning of the basis, then every element of `B_S(A) = U_S(A) ⬝ T(A)` has an upper-triangular
matrix in that basis. -/
theorem map_kostantTorusSubsystemSubgroup_le_upperTriangular [Fintype η]
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V)) (S : Set ι)
    (hα : ∀ i ∈ S, ∀ j, ⁅h j, e i⁆ = (α i j : ℚ) • e i)
    (hpos : ∀ i ∈ S, ∀ {r s : η} {m : ℕ}, 0 < m → wt r = wt s + m • α i → r < s)
    (A : Type v) [CommRing A] :
    (kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt S (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (b.baseChange A)).toMulEquiv) ≤
      upperTriangularGroup η A := by
  rw [kostantTorusSubsystemSubgroup_eq_sup, Subgroup.map_sup, sup_le_iff]
  refine ⟨(map_kostantSubsystemSubgroup_le_upperUnitriangular e h ρ M hM hnil b wt α S hwt hα
    hpos A).trans UpperTriangularGroup.upperUnitriangularGroup_le_upperTriangularGroup, ?_⟩
  rintro - ⟨-, ⟨s, rfl⟩, rfl⟩
  exact basisMatrix_kostantTorusPoints_mem_upperTriangular M b wt A s

/-! ## The trivial intersection -/

omit [Fintype κ] [LinearOrder η] in
/-- Reindexing a weight basis by the reversed order keeps each basis vector a weight vector of the
same weight. -/
private theorem isCartanWeightVector_reindex_toDual
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V)) (y : ηᵒᵈ) :
    IsCartanWeightVector h ρ ((wt ∘ OrderDual.toDual.symm) y)
      ((b.reindex OrderDual.toDual y : M) : V) := by
  simpa using hwt (OrderDual.ofDual y)

/-- **A positive subsystem group meets the opposite Borel-type group trivially:**
`U_S(A) ∩ B_{S'}(A) = 1`, when the root vectors indexed by `S` move weights strictly towards the
beginning of the ordered weight basis and those indexed by `S'` strictly towards its end.

In the ordered weight basis the first group is upper unitriangular and the second lower
triangular. -/
theorem kostantSubsystemSubgroup_inf_kostantTorusSubsystemSubgroup_eq_bot [Finite η]
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V)) (S S' : Set ι)
    (hα : ∀ i ∈ S, ∀ j, ⁅h j, e i⁆ = (α i j : ℚ) • e i)
    (hα' : ∀ i ∈ S', ∀ j, ⁅h j, e i⁆ = (α i j : ℚ) • e i)
    (hpos : ∀ i ∈ S, ∀ {r s : η} {m : ℕ}, 0 < m → wt r = wt s + m • α i → r < s)
    (hneg : ∀ i ∈ S', ∀ {r s : η} {m : ℕ}, 0 < m → wt r = wt s + m • α i → s < r)
    (A : Type v) [CommRing A] :
    kostantSubsystemSubgroup e h ρ M hM hnil S (CommAlgCat.of ℤ A) ⊓
        kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt S' (CommAlgCat.of ℤ A) = ⊥ := by
  have := Fintype.ofFinite η
  -- Reverse the order of the basis, so that the root vectors indexed by `S'` become positive.
  -- The torus, and hence `B_{S'}(A)`, does not depend on how the weight basis is indexed.
  have hT : kostantTorusPoints M (b.reindex OrderDual.toDual) (wt ∘ OrderDual.toDual.symm)
      (CommAlgCat.of ℤ A) = kostantTorusPoints M b wt (CommAlgCat.of ℤ A) := by
    refine MonoidHom.ext fun s => Units.ext <| (b.baseChange _).ext fun x => ?_
    have hx : b x = b.reindex OrderDual.toDual (OrderDual.toDual x) := by simp
    rw [Module.Basis.baseChange_apply, kostantTorusPoints_tmul_basis M b wt, hx,
      kostantTorusPoints_tmul_basis]
    simp
  have hB : kostantTorusSubsystemSubgroup e h ρ M hM hnil b wt S' (CommAlgCat.of ℤ A) =
      kostantTorusSubsystemSubgroup e h ρ M hM hnil (b.reindex OrderDual.toDual)
        (wt ∘ OrderDual.toDual.symm) S' (CommAlgCat.of ℤ A) := by
    rw [kostantTorusSubsystemSubgroup_eq_sup, kostantTorusSubsystemSubgroup_eq_sup, hT]
  have hneg' : ∀ i ∈ S', ∀ {r s : ηᵒᵈ} {m : ℕ}, 0 < m →
      (wt ∘ OrderDual.toDual.symm) r = (wt ∘ OrderDual.toDual.symm) s + m • α i → r < s :=
    fun i hi _ _ _ hm hrs => hneg i hi hm hrs
  rw [eq_bot_iff]
  rintro g ⟨hgU, hgB⟩
  rw [hB] at hgB
  -- The matrix of `g` is upper unitriangular in the original order and upper triangular in the
  -- reversed order.
  have hY := map_kostantTorusSubsystemSubgroup_le_upperTriangular e h ρ M hM hnil
    (b.reindex OrderDual.toDual) (wt ∘ OrderDual.toDual.symm) α
    (isCartanWeightVector_reindex_toDual h ρ M b wt hwt) S' hα' hneg' A ⟨g, hgB, rfl⟩
  rw [Module.Basis.baseChange_reindex] at hY
  exact Subgroup.mem_bot.2 <|
    (b.baseChange A).eq_one_of_toMatrix_mem_upperUnitriangularGroup_of_reindex_toDual
      (map_kostantSubsystemSubgroup_le_upperUnitriangular e h ρ M hM hnil b wt α S hwt hα hpos A
        ⟨g, hgU, rfl⟩) hY

omit [Fintype κ] in
/-- **Opposite subsystem groups meet trivially:** `U_S(A) ∩ U_{S'}(A) = 1` when the root vectors
indexed by `S` move weights strictly towards the beginning of an ordered weight basis and those
indexed by `S'` strictly towards its end.

Both groups are upper unitriangular, the first in the given order and the second in the reversed
order, so no finiteness of the Cartan index type is needed. -/
theorem kostantSubsystemSubgroup_inf_kostantSubsystemSubgroup_eq_bot [Finite η]
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V)) (S S' : Set ι)
    (hα : ∀ i ∈ S, ∀ j, ⁅h j, e i⁆ = (α i j : ℚ) • e i)
    (hα' : ∀ i ∈ S', ∀ j, ⁅h j, e i⁆ = (α i j : ℚ) • e i)
    (hpos : ∀ i ∈ S, ∀ {r s : η} {m : ℕ}, 0 < m → wt r = wt s + m • α i → r < s)
    (hneg : ∀ i ∈ S', ∀ {r s : η} {m : ℕ}, 0 < m → wt r = wt s + m • α i → s < r)
    (A : Type v) [CommRing A] :
    kostantSubsystemSubgroup e h ρ M hM hnil S (CommAlgCat.of ℤ A) ⊓
        kostantSubsystemSubgroup e h ρ M hM hnil S' (CommAlgCat.of ℤ A) = ⊥ := by
  have := Fintype.ofFinite η
  -- Reverse the order of the basis, so that the root vectors indexed by `S'` become positive.
  have hneg' : ∀ i ∈ S', ∀ {r s : ηᵒᵈ} {m : ℕ}, 0 < m →
      (wt ∘ OrderDual.toDual.symm) r = (wt ∘ OrderDual.toDual.symm) s + m • α i → r < s :=
    fun i hi _ _ _ hm hrs => hneg i hi hm hrs
  rw [eq_bot_iff]
  rintro g ⟨hgU, hgU'⟩
  have hY := UpperTriangularGroup.upperUnitriangularGroup_le_upperTriangularGroup <|
    map_kostantSubsystemSubgroup_le_upperUnitriangular e h ρ M hM hnil
      (b.reindex OrderDual.toDual) (wt ∘ OrderDual.toDual.symm) α S'
      (isCartanWeightVector_reindex_toDual h ρ M b wt hwt) hα' hneg' A ⟨g, hgU', rfl⟩
  rw [Module.Basis.baseChange_reindex] at hY
  exact Subgroup.mem_bot.2 <|
    (b.baseChange A).eq_one_of_toMatrix_mem_upperUnitriangularGroup_of_reindex_toDual
      (map_kostantSubsystemSubgroup_le_upperUnitriangular e h ρ M hM hnil b wt α S hwt hα hpos A
        ⟨g, hgU, rfl⟩) hY

/-- **A positive subsystem group meets the torus trivially:** `U_S(A) ∩ T(A) = 1` when the root
vectors indexed by `S` move weights strictly towards the beginning of an ordered weight basis. -/
theorem kostantSubsystemSubgroup_inf_range_kostantTorusPoints_eq_bot [Finite η]
    (hwt : ∀ x, IsCartanWeightVector h ρ (wt x) ((b x : M) : V)) (S : Set ι)
    (hα : ∀ i ∈ S, ∀ j, ⁅h j, e i⁆ = (α i j : ℚ) • e i)
    (hpos : ∀ i ∈ S, ∀ {r s : η} {m : ℕ}, 0 < m → wt r = wt s + m • α i → r < s)
    (A : Type v) [CommRing A] :
    kostantSubsystemSubgroup e h ρ M hM hnil S (CommAlgCat.of ℤ A) ⊓
        (kostantTorusPoints M b wt (CommAlgCat.of ℤ A)).range = ⊥ := by
  rw [← kostantTorusSubsystemSubgroup_empty e h ρ M hM hnil b wt]
  exact kostantSubsystemSubgroup_inf_kostantTorusSubsystemSubgroup_eq_bot e h ρ M hM hnil b wt α
    hwt S ∅ hα (fun _ hi => hi.elim) hpos (fun _ hi => hi.elim) A

end TauCeti.UniversalEnvelopingAlgebra
