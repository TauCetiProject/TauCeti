public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.CartanLattice
public import Mathlib.Algebra.Lie.BaseChange

/-!
# Opposite-root straightening over the full Chevalley lattice

In every rank, rationalized opposite Chevalley root vectors satisfy the `sl₂`
relations with their actual coroot in the full cocharacter lattice. Their divided-power
product has integral coefficients in the subring generated by the toral binomials.
The Cartan span lemma retains all central toral directions and requires no integral
splitting of the coroot.

The product formula uses `TauCeti.Sl2.dividedPower_ι_e_mul_dividedPower_ι_f`;
its coefficient integrality uses integral binomial translation in `Kostant.CartanLattice`.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace RootPairing.ChevalleyLieAlgebra

open Module
open scoped TensorProduct
open TauCeti.UniversalEnvelopingAlgebra

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y] [Finite ι]
variable {P : RootPairing ι ℤ X Y} (c : P.ChevalleyConstants)

/-- Rationalized Cartan vectors commute. -/
theorem tmul_cartan_lie_tmul_cartan (y z : Y) :
    ⁅(1 : ℚ) ⊗ₜ[ℤ] cartan c y, (1 : ℚ) ⊗ₜ[ℤ] cartan c z⁆ = 0 := by
  simp [LieAlgebra.ExtendScalars.bracket_tmul]

/-- The bracket of rationalized opposite root vectors is the rationalized coroot. -/
theorem tmul_root_lie_tmul_root_reflectionPerm (i : ι) :
    ⁅(1 : ℚ) ⊗ₜ[ℤ] root c i, (1 : ℚ) ⊗ₜ[ℤ] root c (P.reflectionPerm i i)⁆ =
      (1 : ℚ) ⊗ₜ[ℤ] cartan c (P.coroot i) := by
  simp [LieAlgebra.ExtendScalars.bracket_tmul]

/-- A rationalized coroot acts with weight two on its root vector. -/
theorem tmul_cartan_coroot_lie_tmul_root (i : ι) :
    ⁅(1 : ℚ) ⊗ₜ[ℤ] cartan c (P.coroot i), (1 : ℚ) ⊗ₜ[ℤ] root c i⁆ =
      2 • ((1 : ℚ) ⊗ₜ[ℤ] root c i) := by
  simp [LieAlgebra.ExtendScalars.bracket_tmul, P.root_coroot_eq_pairing,
    two_smul, TensorProduct.tmul_add]

/-- A rationalized coroot acts with weight minus two on its opposite root vector. -/
theorem tmul_cartan_coroot_lie_tmul_root_reflectionPerm (i : ι) :
    ⁅(1 : ℚ) ⊗ₜ[ℤ] cartan c (P.coroot i),
      (1 : ℚ) ⊗ₜ[ℤ] root c (P.reflectionPerm i i)⁆ =
      -(2 • ((1 : ℚ) ⊗ₜ[ℤ] root c (P.reflectionPerm i i))) := by
  simp [LieAlgebra.ExtendScalars.bracket_tmul, P.root_coroot_eq_pairing,
    two_smul, TensorProduct.tmul_add, TensorProduct.tmul_neg]

/-- Every rationalized Cartan vector lies in the integer span of the rationalized
Cartan vectors attached to an integral basis of the full cocharacter lattice. -/
theorem tmul_cartan_mem_span_tmul_cartan_basis {J : Type*} (bY : Basis J ℤ Y) (y : Y) :
    (1 : ℚ) ⊗ₜ[ℤ] cartan c y ∈
      Submodule.span ℤ (Set.range fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j)) := by
  let f : Y →ₗ[ℤ] ℚ ⊗[ℤ] ChevalleyLieAlgebra c :=
    (TensorProduct.mk ℤ ℚ _ 1).comp (cartan c)
  have hspan : Submodule.span ℤ (Set.range (f ∘ bY)) = LinearMap.range f := by
    rw [Set.range_comp, ← Submodule.map_span, bY.span_eq, Submodule.map_top]
  exact hspan.symm ▸ (LinearMap.mem_range_self f y)

attribute [local instance] TauCeti.moduleNNRat

open TauCeti.Associative Finset

local notation "ιℚ" => _root_.UniversalEnvelopingAlgebra.ι ℚ

/-- The opposite-root straightening formula in the rational enveloping algebra of the
full Chevalley Lie algebra. The middle argument is the actual coroot in `Y`.
This calculation works in every rank. -/
theorem dividedPower_root_mul_dividedPower_opposite (i : ι) (m n : ℕ) :
    dividedPower m (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] root c i)) *
        dividedPower n (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] root c (P.reflectionPerm i i))) =
      ∑ k ∈ range (min m n + 1),
        dividedPower (n - k) (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] root c (P.reflectionPerm i i))) *
          Ring.choose (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] cartan c (P.coroot i)) -
            (m + n : ℕ) + (2 * k : ℕ)) k *
          dividedPower (m - k) (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] root c i)) := by
  apply TauCeti.Sl2.dividedPower_ι_e_mul_dividedPower_ι_f
  · exact tmul_root_lie_tmul_root_reflectionPerm c i
  · exact tmul_cartan_coroot_lie_tmul_root c i
  · exact tmul_cartan_coroot_lie_tmul_root_reflectionPerm c i

/-- Every shifted coroot binomial occurring in opposite-root straightening belongs to
the full toral binomial subring. In particular no denominator is introduced by expressing
the coroot in the chosen basis of `Y`. This holds in every rank. -/
theorem ringChoose_coroot_add_intCast_mem {J : Type*} (bY : Basis J ℤ Y)
    (i : ι) (z : ℤ) (n : ℕ) :
    Ring.choose (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] cartan c (P.coroot i)) + z) n ∈
      Subring.closure (kostantCartanGenerators
        (fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j))) := by
  apply ringChoose_add_intCast_mem_closure_kostantCartanGenerators_of_mem_span
    _ (fun i j => tmul_cartan_lie_tmul_cartan c (bY i) (bY j))
    (tmul_cartan_mem_span_tmul_cartan_basis c bY (P.coroot i))

end RootPairing.ChevalleyLieAlgebra
