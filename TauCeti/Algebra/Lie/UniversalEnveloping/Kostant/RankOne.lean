/-!
# Rank-one Kostant forms with a full toral lattice

The two root vectors form an `sl₂` triple with their coroot, but the toral lattice may
have arbitrary rank. In particular the coroot need not be a lattice basis vector or
split off together with the central lattice. Opposite-root straightening has integral
coefficients in the subring generated by the binomials of the full toral lattice.

The collection argument uses the `sl₂` straightening formula from
`TauCeti.Algebra.Lie.Sl2.Straightening`, integral binomial translation, and the
commuting-binomial spanning theorem. Independence uses the mixed rational PBW basis.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

open Associative Finset

attribute [local instance] TauCeti.moduleNNRat
attribute [local instance 100] LieRing.ofAssociativeRing

variable {L : Type*} [LieRing L] [LieAlgebra ℚ L] {κ : Type*}

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L
local notation "ι" => _root_.UniversalEnvelopingAlgebra.ι ℚ

private noncomputable abbrev toralRing (h : κ → L) : Subring U :=
  Subring.closure (kostantCartanGenerators h)

private noncomputable def collectedSpan (h : κ → L) (e f : L) : AddSubgroup U :=
  AddSubgroup.closure {u | ∃ a : ℕ, ∃ t ∈ toralRing h, ∃ c : ℕ,
    dividedPower a (ι f) * t * dividedPower c (ι e) = u}

private theorem collected_mem (h : κ → L) (e f : L) (a c : ℕ)
    {t : U} (ht : t ∈ toralRing h) :
    dividedPower a (ι f) * t * dividedPower c (ι e) ∈ collectedSpan h e f :=
  AddSubgroup.subset_closure ⟨a, t, ht, c, rfl⟩

private theorem generator_mul_collected_mem (h : κ → L) (e f h₀ : L)
    (w : κ → ℤ) (hcomm : ∀ i j, ⁅h i, h j⁆ = 0)
    (hh₀ : h₀ ∈ Submodule.span ℤ (Set.range h))
    (hef : ⁅e, f⁆ = h₀) (hhe : ⁅h₀, e⁆ = 2 • e) (hhf : ⁅h₀, f⁆ = -(2 • f))
    (hwe : ∀ j, ⁅h j, e⁆ = w j • e) (hwf : ∀ j, ⁅h j, f⁆ = -(w j • f))
    {r : U} (hr : r ∈ kostantGenerators ![e, f] h)
    (a c : ℕ) {t : U} (ht : t ∈ toralRing h) :
    r * (dividedPower a (ι f) * t * dividedPower c (ι e)) ∈ collectedSpan h e f := by
  rcases mem_kostantGenerators_iff.mp hr with ⟨i, n, rfl⟩ | ⟨j, n, rfl⟩
  · fin_cases i
    · simp only [Fin.zero_eta, Matrix.cons_val_zero]
      rw [← mul_assoc, ← mul_assoc,
        Sl2.dividedPower_ι_e_mul_dividedPower_ι_f hef hhe hhf, sum_mul, sum_mul]
      refine sum_mem fun k _ => ?_
      obtain ⟨t', ht', heq⟩ := exists_mem_closure_kostantCartanGenerators_dividedPower_mul_eq h e
        w hwe (n - k) ht
      have hmid : Ring.choose (ι h₀ - (n + a : ℕ) + (2 * k : ℕ)) k ∈ toralRing h := by
        simpa [Int.cast_sub, sub_add_eq_add_sub, add_sub_assoc] using
          ringChoose_add_intCast_mem_closure_kostantCartanGenerators_of_mem_span h hcomm hh₀
            ((2 * k : ℕ) - (n + a : ℕ) : ℤ) k
      simp only [mul_assoc]
      rw [← mul_assoc (dividedPower (n - k) (ι e)), heq]
      simp only [← mul_assoc]
      rw [mul_assoc _ _ (dividedPower c (ι e)), mul_dividedPower]
      simpa only [← mul_assoc, mul_smul_comm, smul_mul_assoc] using
        (collectedSpan h e f).nsmul_mem
          (collected_mem h e f (a - k) (n - k + c) (mul_mem hmid ht')) _
    · simp only [Fin.mk_one, Matrix.cons_val_one, Matrix.cons_val_zero]
      rw [← mul_assoc, ← mul_assoc, mul_dividedPower]
      simpa only [smul_mul_assoc] using
        (collectedSpan h e f).nsmul_mem (collected_mem h e f (n + a) c ht) _
  · obtain ⟨t', ht', heq⟩ := exists_mem_closure_kostantCartanGenerators_mul_dividedPower_eq
      (fun _ : Unit => f) h (fun j _ => -w j) (fun j _ => by simpa using hwf j) () a
      (Subring.subset_closure (ringChoose_mem_kostantCartanGenerators h j n))
    rw [← mul_assoc, ← mul_assoc, heq, mul_assoc _ t' t]
    exact collected_mem h e f a c (mul_mem ht' ht)

/-- With the coroot in the integral span of a commuting toral family, the rank-one Kostant
form is the integral span of lowering divided powers, a toral-subring element, and raising
divided powers, in that order. All central toral directions are retained. -/
theorem toAddSubgroup_kostantForm_eq_closure_rankOne (h : κ → L) (e f h₀ : L)
    (w : κ → ℤ) (hcomm : ∀ i j, ⁅h i, h j⁆ = 0)
    (hh₀ : h₀ ∈ Submodule.span ℤ (Set.range h))
    (hef : ⁅e, f⁆ = h₀) (hhe : ⁅h₀, e⁆ = 2 • e) (hhf : ⁅h₀, f⁆ = -(2 • f))
    (hwe : ∀ j, ⁅h j, e⁆ = w j • e) (hwf : ∀ j, ⁅h j, f⁆ = -(w j • f)) :
    (kostantForm ![e, f] h).toAddSubgroup = AddSubgroup.closure
      {u : U | ∃ a : ℕ, ∃ t ∈ Subring.closure (kostantCartanGenerators h), ∃ c : ℕ,
        dividedPower a (ι f) * t * dividedPower c (ι e) = u} := by
  rw [kostantForm_def]
  apply Subring.toAddSubgroup_closure_eq_of_one_mem_of_subset_of_left_mul_mem
  · simpa only [dividedPower_zero, one_mul, mul_one, collectedSpan] using
      collected_mem h e f 0 0 (one_mem (toralRing h))
  · rintro _ ⟨a, t, ht, c, rfl⟩
    have hC : toralRing h ≤ kostantForm ![e, f] h := by
      rw [kostantForm_def]
      exact Subring.closure_mono Set.subset_union_right
    simpa only [kostantForm_def, Matrix.cons_val_one, Matrix.cons_val_zero, SetLike.mem_coe] using
      mul_mem (mul_mem (dividedPower_mem_kostantForm ![e, f] h 1 a) (hC ht))
        (dividedPower_mem_kostantForm ![e, f] h 0 c)
  · rintro r hr _ ⟨a, t, ht, c, rfl⟩
    exact generator_mul_collected_mem h e f h₀ w hcomm hh₀ hef hhe hhf hwe hwf (by
      simpa only [mem_kostantGenerators_iff, Set.mem_union, mem_kostantRootGenerators_iff,
        mem_kostantCartanGenerators_iff] using hr) a c ht

/-- The ordered lowering--toral--raising monomial, with one binomial coefficient for
each element of the full toral family. -/
noncomputable def rankOneKostantMonomial {r : ℕ} (h : Fin r → L) (e f : L)
    (a : ℕ) (b : Fin r → ℕ) (c : ℕ) : U :=
  dividedPower a (ι f) * (List.ofFn fun j => Ring.choose (ι (h j)) (b j)).prod *
    dividedPower c (ι e)

/-- The value of an ordered rank-one Kostant monomial. -/
theorem rankOneKostantMonomial_def {r : ℕ} (h : Fin r → L) (e f : L)
    (a : ℕ) (b : Fin r → ℕ) (c : ℕ) :
    rankOneKostantMonomial h e f a b c =
      dividedPower a (ι f) * (List.ofFn fun j => Ring.choose (ι (h j)) (b j)).prod *
        dividedPower c (ι e) := (rfl)

/-- The monomial with all exponents zero is the identity. -/
@[simp]
theorem rankOneKostantMonomial_zero {r : ℕ} (h : Fin r → L) (e f : L) :
    rankOneKostantMonomial h e f 0 0 0 = 1 := by
  simp [rankOneKostantMonomial_def]

/-- **Integral rank-one spanning over the full toral lattice.** If the coroot is an
integer combination of the commuting toral generators, then the generated Kostant form
is the additive integer span of the ordered lowering, toral-binomial and raising monomials.
No integral central/derived splitting is required. -/
theorem toAddSubgroup_kostantForm_eq_closure_rankOneKostantMonomial {r : ℕ}
    (h : Fin r → L) (e f h₀ : L) (w : Fin r → ℤ)
    (hcomm : ∀ i j, ⁅h i, h j⁆ = 0)
    (hh₀ : h₀ ∈ Submodule.span ℤ (Set.range h))
    (hef : ⁅e, f⁆ = h₀) (hhe : ⁅h₀, e⁆ = 2 • e) (hhf : ⁅h₀, f⁆ = -(2 • f))
    (hwe : ∀ j, ⁅h j, e⁆ = w j • e) (hwf : ∀ j, ⁅h j, f⁆ = -(w j • f)) :
    (kostantForm ![e, f] h).toAddSubgroup = AddSubgroup.closure
      {u : U | ∃ a b c, rankOneKostantMonomial h e f a b c = u} := by
  rw [toAddSubgroup_kostantForm_eq_closure_rankOne h e f h₀ w hcomm hh₀ hef hhe hhf hwe hwf]
  have hC : (toralRing h).toAddSubgroup = AddSubgroup.closure
      (Set.range fun b : Fin r → ℕ => (List.ofFn fun j => Ring.choose (ι (h j)) (b j)).prod) := by
    have hgen : kostantCartanGenerators h =
        Set.range (fun p : Fin r × ℕ => Ring.choose (ι (h p.1)) p.2) := by
      ext x
      simp only [mem_kostantCartanGenerators_iff, Set.mem_range, Prod.exists]
    rw [toralRing, hgen]
    exact toAddSubgroup_subringClosure_range_ringChoose_eq_closure_range_prod_ofFn
      (fun j => ι (h j)) (fun i j => commute_of_lie_eq_zero (AlgHom.id ℚ _) (hcomm i j))
  apply le_antisymm
  · apply (AddSubgroup.closure_le _).mpr
    rintro _ ⟨a, t, ht, c, rfl⟩
    rw [← Subring.mem_toAddSubgroup, hC] at ht
    induction ht using AddSubgroup.closure_induction with
    | mem t ht =>
        obtain ⟨b, rfl⟩ := ht
        exact AddSubgroup.subset_closure ⟨a, b, c, rfl⟩
    | zero => simp
    | add x y _ _ hx hy => simpa only [mul_add, add_mul, SetLike.mem_coe] using add_mem hx hy
    | neg x _ hx => simpa only [mul_neg, neg_mul, SetLike.mem_coe] using neg_mem hx
  · apply (AddSubgroup.closure_le _).mpr
    rintro _ ⟨a, b, c, rfl⟩
    apply collected_mem
    rw [← Subring.mem_toAddSubgroup, hC]
    exact AddSubgroup.subset_closure ⟨b, rfl⟩

end TauCeti.UniversalEnvelopingAlgebra

namespace Module.Basis

open TauCeti TauCeti.Associative TauCeti.UniversalEnvelopingAlgebra

attribute [local instance] TauCeti.moduleNNRat

variable {L : Type*} [LieRing L] [LieAlgebra ℚ L] {r : ℕ}

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L

private def rankOneExponents (r : ℕ) : ((ℕ × (Fin r → ℕ)) × ℕ) ≃ (Fin (r + 2) → ℕ) :=
  ((Equiv.prodAssoc ℕ (Fin r → ℕ) ℕ).trans
    ((Equiv.refl ℕ).prodCongr ((Equiv.prodComm (Fin r → ℕ) ℕ).trans
      (Fin.snocEquiv fun _ : Fin (r + 1) => ℕ)))).trans
    (Fin.consEquiv fun _ : Fin (r + 2) => ℕ)

/-- The rational PBW basis with the first and last coordinates treated as root vectors
and all intervening coordinates treated as Cartan vectors. No bracket relations are needed. -/
noncomputable def rankOneKostantRationalBasis (b : Basis (Fin (r + 2)) ℚ L) :
    Basis ((ℕ × (Fin r → ℕ)) × ℕ) ℚ U :=
  (b.pbwKostantBasis (Finset.Ioo 0 (Fin.last (r + 1)))).reindex (rankOneExponents r).symm

/-- The rational rank-one basis vector has lowering, full toral-binomial, raising order. -/
@[simp]
theorem rankOneKostantRationalBasis_apply (b : Basis (Fin (r + 2)) ℚ L)
    (p : (ℕ × (Fin r → ℕ)) × ℕ) :
    b.rankOneKostantRationalBasis p = rankOneKostantMonomial
      (fun j => b j.castSucc.succ) (b (Fin.last (r + 1))) (b 0) p.1.1 p.1.2 p.2 := by
  classical
  have hmid (j : Fin r) : j.castSucc.succ ∈ Finset.Ioo 0 (Fin.last (r + 1)) := by
    simp only [Finset.mem_Ioo, Fin.lt_def, Fin.val_zero, Fin.val_succ, Fin.val_castSucc,
      Fin.val_last]
    omega
  rw [rankOneKostantRationalBasis, reindex_apply, pbwKostantBasis_apply,
    List.ofFn_succ, List.prod_cons, List.ofFn_succ', List.prod_concat,
    rankOneKostantMonomial_def]
  simp [rankOneExponents, hmid, ← mul_assoc]

private theorem rankOneKostantForm_closure (b : Basis (Fin (r + 2)) ℚ L)
    (h₀ : L) (w : Fin r → ℤ)
    (hcomm : ∀ i j : Fin r, ⁅b i.castSucc.succ, b j.castSucc.succ⁆ = 0)
    (hh₀ : h₀ ∈ Submodule.span ℤ (Set.range fun j : Fin r => b j.castSucc.succ))
    (hef : ⁅b (Fin.last (r + 1)), b 0⁆ = h₀)
    (hhe : ⁅h₀, b (Fin.last (r + 1))⁆ = 2 • b (Fin.last (r + 1)))
    (hhf : ⁅h₀, b 0⁆ = -(2 • b 0))
    (hwe : ∀ j, ⁅b j.castSucc.succ, b (Fin.last (r + 1))⁆ = w j • b (Fin.last (r + 1)))
    (hwf : ∀ j, ⁅b j.castSucc.succ, b 0⁆ = -(w j • b 0)) :
    (kostantForm ![b (Fin.last (r + 1)), b 0] (fun j : Fin r => b j.castSucc.succ)).toAddSubgroup =
      AddSubgroup.closure (Set.range b.rankOneKostantRationalBasis) := by
  rw [toAddSubgroup_kostantForm_eq_closure_rankOneKostantMonomial _ _ _ h₀ w hcomm hh₀
    hef hhe hhf hwe hwf]
  congr 1
  ext x
  simp only [Set.mem_ofPred_eq, Set.mem_range, Prod.exists, rankOneKostantRationalBasis_apply]

/-- The integral PBW basis of a rank-one Kostant form with an arbitrary full toral
lattice. The coroot is an integral combination of the middle basis vectors; no central
splitting or coroot basis vector is assumed. -/
noncomputable def rankOneKostantFormBasis (b : Basis (Fin (r + 2)) ℚ L)
    (h₀ : L) (w : Fin r → ℤ)
    (hcomm : ∀ i j : Fin r, ⁅b i.castSucc.succ, b j.castSucc.succ⁆ = 0)
    (hh₀ : h₀ ∈ Submodule.span ℤ (Set.range fun j : Fin r => b j.castSucc.succ))
    (hef : ⁅b (Fin.last (r + 1)), b 0⁆ = h₀)
    (hhe : ⁅h₀, b (Fin.last (r + 1))⁆ = 2 • b (Fin.last (r + 1)))
    (hhf : ⁅h₀, b 0⁆ = -(2 • b 0))
    (hwe : ∀ j, ⁅b j.castSucc.succ, b (Fin.last (r + 1))⁆ = w j • b (Fin.last (r + 1)))
    (hwf : ∀ j, ⁅b j.castSucc.succ, b 0⁆ = -(w j • b 0)) :
    Basis ((ℕ × (Fin r → ℕ)) × ℕ) ℤ
      (kostantForm ![b (Fin.last (r + 1)), b 0] (fun j : Fin r => b j.castSucc.succ)) :=
  b.rankOneKostantRationalBasis.addSubgroupOfClosure _
    (rankOneKostantForm_closure b h₀ w hcomm hh₀ hef hhe hhf hwe hwf)

/-- The integral basis has precisely the expected ordered monomial values. -/
@[simp]
theorem coe_rankOneKostantFormBasis (b : Basis (Fin (r + 2)) ℚ L)
    (h₀ : L) (w : Fin r → ℤ)
    (hcomm : ∀ i j : Fin r, ⁅b i.castSucc.succ, b j.castSucc.succ⁆ = 0)
    (hh₀ : h₀ ∈ Submodule.span ℤ (Set.range fun j : Fin r => b j.castSucc.succ))
    (hef : ⁅b (Fin.last (r + 1)), b 0⁆ = h₀)
    (hhe : ⁅h₀, b (Fin.last (r + 1))⁆ = 2 • b (Fin.last (r + 1)))
    (hhf : ⁅h₀, b 0⁆ = -(2 • b 0))
    (hwe : ∀ j, ⁅b j.castSucc.succ, b (Fin.last (r + 1))⁆ = w j • b (Fin.last (r + 1)))
    (hwf : ∀ j, ⁅b j.castSucc.succ, b 0⁆ = -(w j • b 0))
    (p : (ℕ × (Fin r → ℕ)) × ℕ) :
    (b.rankOneKostantFormBasis h₀ w hcomm hh₀ hef hhe hhf hwe hwf p : U) =
      rankOneKostantMonomial (fun j => b j.castSucc.succ)
        (b (Fin.last (r + 1))) (b 0) p.1.1 p.1.2 p.2 := by
  exact (b.rankOneKostantRationalBasis.addSubgroupOfClosure_apply _ _ p).trans
    (rankOneKostantRationalBasis_apply b p)

end Module.Basis

namespace RootPairing.ChevalleyLieAlgebra

open Module
open scoped TensorProduct

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y] [Finite ι]
variable {P : RootPairing ι ℤ X Y} (c : P.ChevalleyConstants) {r : ℕ}

private noncomputable def rankOneIndices (s : Fin 2 ≃ ι) : Fin (r + 2) ≃ (Fin r ⊕ ι) where
  toFun k := Fin.cases (.inr (s 0))
    (Fin.lastCases (.inr (s 1)) fun j => .inl j) k
  invFun k := k.elim (fun j => j.castSucc.succ)
    (fun i => if s.symm i = 0 then 0 else Fin.last (r + 1))
  left_inv k := by
    refine Fin.cases ?_ (fun j => ?_) k
    · simp
    · refine Fin.lastCases ?_ (fun j => ?_) j <;> simp [← Fin.succ_last]
  right_inv k := by
    rcases k with j | i
    · simp
    · obtain ⟨j, rfl⟩ := s.surjective i
      fin_cases j <;> simp [← Fin.succ_last]

/-- The scalar-extended Chevalley basis in lowering, full cocharacter basis, raising order.
The root enumeration labels the lowering root by `0` and the raising root by `1`. -/
noncomputable def rankOneLieBasis (bY : Basis (Fin r) ℤ Y) (s : Fin 2 ≃ ι) :
    Basis (Fin (r + 2)) ℚ (ℚ ⊗[ℤ] ChevalleyLieAlgebra c) :=
  ((basis c bY).baseChange ℚ).reindex (rankOneIndices s).symm

@[simp]
theorem rankOneLieBasis_zero (bY : Basis (Fin r) ℤ Y) (s : Fin 2 ≃ ι) :
    rankOneLieBasis c bY s 0 = 1 ⊗ₜ[ℤ] root c (s 0) := by
  simp [rankOneLieBasis, rankOneIndices]

@[simp]
theorem rankOneLieBasis_middle (bY : Basis (Fin r) ℤ Y) (s : Fin 2 ≃ ι) (j : Fin r) :
    rankOneLieBasis c bY s j.castSucc.succ = 1 ⊗ₜ[ℤ] cartan c (bY j) := by
  simp [rankOneLieBasis, rankOneIndices]

@[simp]
theorem rankOneLieBasis_last (bY : Basis (Fin r) ℤ Y) (s : Fin 2 ≃ ι) :
    rankOneLieBasis c bY s (Fin.last (r + 1)) = 1 ⊗ₜ[ℤ] root c (s 1) := by
  simp [rankOneLieBasis, rankOneIndices, ← Fin.succ_last]

open TauCeti.UniversalEnvelopingAlgebra

private theorem rankOneForm_eq (bY : Basis (Fin r) ℤ Y) (s : Fin 2 ≃ ι) :
    kostantForm ![1 ⊗ₜ[ℤ] root c (s 1), 1 ⊗ₜ[ℤ] root c (s 0)]
        (fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j)) =
      kostantForm (fun i => (1 : ℚ) ⊗ₜ[ℤ] root c i)
        (fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j)) := by
  apply le_antisymm <;> rw [kostantForm_le_iff]
  · constructor
    · intro i n
      fin_cases i
      · exact dividedPower_mem_kostantForm _ _ (s 1) n
      · exact dividedPower_mem_kostantForm _ _ (s 0) n
    · exact ringChoose_mem_kostantForm _ _
  · constructor
    · intro i n
      obtain ⟨j, rfl⟩ := s.surjective i
      fin_cases j
      · exact dividedPower_mem_kostantForm _ _ 1 n
      · exact dividedPower_mem_kostantForm _ _ 0 n
    · exact ringChoose_mem_kostantForm _ _

private theorem coroot_mem_span_cartan (bY : Basis (Fin r) ℤ Y) (i : ι) :
    (1 : ℚ) ⊗ₜ[ℤ] cartan c (P.coroot i) ∈
      Submodule.span ℤ (Set.range fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j)) := by
  let f : Y →ₗ[ℤ] ℚ ⊗[ℤ] ChevalleyLieAlgebra c :=
    (TensorProduct.mk ℤ ℚ _ 1).comp (cartan c)
  have hspan : Submodule.span ℤ (Set.range (f ∘ bY)) = LinearMap.range f := by
    rw [Set.range_comp, ← Submodule.map_span, bY.span_eq, Submodule.map_top]
  exact hspan.symm ▸ (LinearMap.mem_range_self f (P.coroot i))

private theorem rankOneForm_closure (bY : Basis (Fin r) ℤ Y) (s : Fin 2 ≃ ι)
    (hs : s 0 = P.reflectionPerm (s 1) (s 1)) :
    (kostantForm (fun i => (1 : ℚ) ⊗ₜ[ℤ] root c i)
      (fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j))).toAddSubgroup =
      AddSubgroup.closure (Set.range (rankOneLieBasis c bY s).rankOneKostantRationalBasis) := by
  have hpair : P.toLinearMap (P.root (s 1)) (P.coroot (s 1)) = 2 := by
    simp [P.root_coroot_eq_pairing]
  have h := Module.Basis.rankOneKostantForm_closure (rankOneLieBasis c bY s)
    ((1 : ℚ) ⊗ₜ[ℤ] cartan c (P.coroot (s 1)))
    (fun j => P.toLinearMap (P.root (s 1)) (bY j))
  simp only [rankOneLieBasis_middle, rankOneLieBasis_zero, rankOneLieBasis_last] at h
  rw [← rankOneForm_eq c bY s]
  apply h
  · intro i j; simp [LieAlgebra.ExtendScalars.bracket_tmul]
  · exact coroot_mem_span_cartan c bY (s 1)
  · simp [hs, LieAlgebra.ExtendScalars.bracket_tmul]
  · simp [LieAlgebra.ExtendScalars.bracket_tmul, hpair, two_smul, TensorProduct.tmul_add]
  · simp [hs, LieAlgebra.ExtendScalars.bracket_tmul, hpair, two_smul, TensorProduct.tmul_add,
    TensorProduct.tmul_neg]
  · intro j
    simp [LieAlgebra.ExtendScalars.bracket_tmul, TensorProduct.tmul_smul]
  · intro j
    simp [hs, LieAlgebra.ExtendScalars.bracket_tmul, TensorProduct.tmul_neg,
      TensorProduct.tmul_smul]

/-- **Full-toral rank-one Kostant PBW basis.** For a root datum with exactly one root
and its opposite, the ordered lowering divided powers, binomials in a basis of the whole
cocharacter lattice, and raising divided powers form an integral basis of the subring they
generate in the rational enveloping algebra of its Chevalley Lie algebra. -/
noncomputable def rankOneKostantBasis (bY : Basis (Fin r) ℤ Y) (s : Fin 2 ≃ ι)
    (hs : s 0 = P.reflectionPerm (s 1) (s 1)) :
    Basis ((ℕ × (Fin r → ℕ)) × ℕ) ℤ
      (kostantForm (fun i => (1 : ℚ) ⊗ₜ[ℤ] root c i)
        (fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j))) :=
  (rankOneLieBasis c bY s).rankOneKostantRationalBasis.addSubgroupOfClosure _
    (rankOneForm_closure c bY s hs)

/-- The full-toral rank-one integral PBW basis consists of the stated ordered monomials. -/
@[simp]
theorem coe_rankOneKostantBasis (bY : Basis (Fin r) ℤ Y) (s : Fin 2 ≃ ι)
    (hs : s 0 = P.reflectionPerm (s 1) (s 1)) (p : (ℕ × (Fin r → ℕ)) × ℕ) :
    (rankOneKostantBasis c bY s hs p :
      _root_.UniversalEnvelopingAlgebra ℚ (ℚ ⊗[ℤ] ChevalleyLieAlgebra c)) =
      rankOneKostantMonomial (fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j))
        (1 ⊗ₜ[ℤ] root c (s 1)) (1 ⊗ₜ[ℤ] root c (s 0)) p.1.1 p.1.2 p.2 := by
  exact ((rankOneLieBasis c bY s).rankOneKostantRationalBasis.addSubgroupOfClosure_apply
    _ _ p).trans (by simp only [Module.Basis.rankOneKostantRationalBasis_apply,
      rankOneLieBasis_middle, rankOneLieBasis_last, rankOneLieBasis_zero])

attribute [local instance] TauCeti.moduleNNRat

open TauCeti.Associative Finset

local notation "ιℚ" => _root_.UniversalEnvelopingAlgebra.ι ℚ

/-- The opposite-root straightening formula in the rational enveloping algebra of the
full Chevalley Lie algebra. The middle argument is the actual coroot in `Y`.
This calculation works in every rank. -/
theorem dividedPower_root_mul_dividedPower_opposite (i : ι) (m n : ℕ) :
    dividedPower m (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] root c i)) *
        dividedPower n (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] root c (P.reflectionPerm i i))) =
      ∑ k ∈ range (min m n + 1),
        dividedPower (n - k) (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] root c (P.reflectionPerm i i))) *
          Ring.choose (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] cartan c (P.coroot i)) -
            (m + n : ℕ) + (2 * k : ℕ)) k *
          dividedPower (m - k) (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] root c i)) := by
  apply TauCeti.Sl2.dividedPower_ι_e_mul_dividedPower_ι_f
  · simp [LieAlgebra.ExtendScalars.bracket_tmul]
  · simp [LieAlgebra.ExtendScalars.bracket_tmul, P.root_coroot_eq_pairing,
      two_smul, TensorProduct.tmul_add]
  · simp [LieAlgebra.ExtendScalars.bracket_tmul, P.root_coroot_eq_pairing,
      two_smul, TensorProduct.tmul_add, TensorProduct.tmul_neg]

/-- Every shifted coroot binomial occurring in opposite-root straightening belongs to
the full toral binomial subring. In particular no denominator is introduced by expressing
the coroot in the chosen basis of `Y`. This holds in every rank. -/
theorem ringChoose_coroot_add_intCast_mem (bY : Basis (Fin r) ℤ Y)
    (i : ι) (z : ℤ) (n : ℕ) :
    Ring.choose (ιℚ ((1 : ℚ) ⊗ₜ[ℤ] cartan c (P.coroot i)) + z) n ∈
      Subring.closure (kostantCartanGenerators
        (fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j))) := by
  apply ringChoose_add_intCast_mem_closure_kostantCartanGenerators_of_mem_span
    _ (fun i j => by simp [LieAlgebra.ExtendScalars.bracket_tmul])
    (coroot_mem_span_cartan c bY i)

/-- Membership in the full-toral rank-one Kostant form is equivalent to a unique finite
integer expansion in the ordered monomials. -/
theorem mem_rankOneKostantForm_iff_existsUnique (bY : Basis (Fin r) ℤ Y) (s : Fin 2 ≃ ι)
    (hs : s 0 = P.reflectionPerm (s 1) (s 1))
    (x : _root_.UniversalEnvelopingAlgebra ℚ (ℚ ⊗[ℤ] ChevalleyLieAlgebra c)) :
    x ∈ kostantForm (fun i => (1 : ℚ) ⊗ₜ[ℤ] root c i)
        (fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j)) ↔
      ∃! a : ((ℕ × (Fin r → ℕ)) × ℕ) →₀ ℤ,
        a.sum (fun p z => z • rankOneKostantMonomial
          (fun j => (1 : ℚ) ⊗ₜ[ℤ] cartan c (bY j))
          (1 ⊗ₜ[ℤ] root c (s 1)) (1 ⊗ₜ[ℤ] root c (s 0)) p.1.1 p.1.2 p.2) = x := by
  rw [← Subring.mem_toAddSubgroup, rankOneForm_closure c bY s hs,
    ← Submodule.span_int_eq_addSubgroupClosure, Submodule.mem_toAddSubgroup]
  simpa only [Module.Basis.rankOneKostantRationalBasis_apply, rankOneLieBasis_middle,
    rankOneLieBasis_last, rankOneLieBasis_zero] using
      LinearIndependent.mem_span_range_iff_existsUnique
        ((rankOneLieBasis c bY s).rankOneKostantRationalBasis.linearIndependent.restrict_scalars'
          ℤ) x

end RootPairing.ChevalleyLieAlgebra


