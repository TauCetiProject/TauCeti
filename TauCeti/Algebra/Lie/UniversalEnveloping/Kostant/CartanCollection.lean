module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Form
public import TauCeti.Algebra.Lie.UniversalEnveloping.Commutation
public import TauCeti.Algebra.Ring.Subgroup
public import Mathlib.Algebra.Ring.Subring.MulOpposite

/-!
# Integral root–Cartan collection

Suppose each designated root vector is an integral weight vector for each designated Cartan
vector. The Kostant form is then spanned over the integers by products `r * c`, with `r` in the
subring generated by root divided powers and `c` in the subring generated by Cartan binomial
coefficients. Thus all Cartan factors can be collected on the right without introducing rational
coefficients.

The argument uses the binomial/divided-power commutation rule and integral translation of
binomial coefficients. It does not order factors within either subring, assert independence,
or require the Cartan vectors to commute. In particular this is a collection statement, not an
integral PBW basis theorem. It applies to a positive or negative root family separately as well
as to the family of all roots.

## Main results

* `exists_mem_closure_kostantCartanGenerators_mul_dividedPower_eq`: move a Cartan subring element
  past a root divided power within the same Cartan subring.
* `TauCeti.UniversalEnvelopingAlgebra.toAddSubgroup_kostantForm_eq_closure_root_mul_cartan`:
  the exact integral root–Cartan spanning statement.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

variable {L : Type*} [LieRing L] [LieAlgebra ℚ L] {ι κ : Type*}

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L

attribute [local instance] TauCeti.moduleNNRat

/-- If every designated root vector has integral weight under every designated Cartan vector,
a Cartan subring element can be moved past any root divided power. The translated factor remains
in the same Cartan subring. -/
theorem exists_mem_closure_kostantCartanGenerators_mul_dividedPower_eq
    (e : ι → L) (h : κ → L) (w : κ → ι → ℤ)
    (hw : ∀ j i, ⁅h j, e i⁆ = w j i • e i) (i : ι) (n : ℕ)
    {c : U} (hc : c ∈ Subring.closure (kostantCartanGenerators h)) :
    ∃ c' ∈ Subring.closure (kostantCartanGenerators h),
      c * Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) =
        Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) * c' := by
  induction hc using Subring.closure_induction with
  | mem c hc =>
      obtain ⟨j, m, rfl⟩ := mem_kostantCartanGenerators_iff.mp hc
      refine ⟨Ring.choose
        (_root_.UniversalEnvelopingAlgebra.ι ℚ (h j) + ((n * w j i : ℤ) : U)) m, ?_,
        ringChoose_ι_mul_dividedPower_ι (hw j i) m n⟩
      exact Ring.choose_add_intCast_mem (fun k _ =>
        Subring.subset_closure (ringChoose_mem_kostantCartanGenerators h j k)) _
  | zero => exact ⟨0, zero_mem _, by simp⟩
  | one => exact ⟨1, one_mem _, by simp⟩
  | add a b _ _ ha hb =>
      obtain ⟨a', ha', hea⟩ := ha
      obtain ⟨b', hb', heb⟩ := hb
      exact ⟨a' + b', add_mem ha' hb', by simp only [add_mul, mul_add, hea, heb]⟩
  | neg a _ ha =>
      obtain ⟨a', ha', hea⟩ := ha
      exact ⟨-a', neg_mem ha', by simp only [neg_mul, mul_neg, hea]⟩
  | mul a b _ _ ha hb =>
      obtain ⟨a', ha', hea⟩ := ha
      obtain ⟨b', hb', heb⟩ := hb
      exact ⟨a' * b', mul_mem ha' hb', by
        rw [mul_assoc, heb, ← mul_assoc, hea, mul_assoc]⟩

/-- **Integral root–Cartan collection.** If every root vector has integral weight under every
Cartan vector, the Kostant form is exactly the integer span of products from its root and Cartan
subrings, in that order. No commutativity, independence, finiteness or Lie-generation hypothesis
on the designated families is needed. -/
theorem toAddSubgroup_kostantForm_eq_closure_root_mul_cartan
    (e : ι → L) (h : κ → L) (w : κ → ι → ℤ)
    (hw : ∀ j i, ⁅h j, e i⁆ = w j i • e i) :
    (kostantForm e h).toAddSubgroup = AddSubgroup.closure
      {u : U | ∃ a ∈ Subring.closure (kostantRootGenerators e),
        ∃ b ∈ Subring.closure (kostantCartanGenerators h), a * b = u} := by
  let R := Subring.closure (kostantRootGenerators e)
  let C := Subring.closure (kostantCartanGenerators h)
  let P := AddSubgroup.closure {u : U | ∃ a ∈ R, ∃ b ∈ C, a * b = u}
  have hprod {a b : U} (ha : a ∈ R) (hb : b ∈ C) : a * b ∈ P :=
    AddSubgroup.subset_closure ⟨a, ha, b, hb, rfl⟩
  -- A rightmost root factor passes through the Cartan block and joins the root block;
  -- a rightmost Cartan factor simply joins the Cartan block.
  have hroot {r : U} (hr : r ∈ kostantRootGenerators e) {p : U} (hp : p ∈ P) :
      p * r ∈ P := by
    obtain ⟨i, n, rfl⟩ := mem_kostantRootGenerators_iff.mp hr
    refine ((AddSubgroup.closure_le
      (P.comap (AddMonoidHom.mulRight _))).2 ?_) hp
    rintro _ ⟨a, ha, b, hb, rfl⟩
    obtain ⟨b', hb', heq⟩ :=
      exists_mem_closure_kostantCartanGenerators_mul_dividedPower_eq e h w hw i n hb
    -- Expose preimage membership so associativity can rewrite the product.
    change (a * b) * _ ∈ P
    rw [mul_assoc, heq, ← mul_assoc]
    exact hprod (R.mul_mem ha (Subring.subset_closure
      (dividedPower_mem_kostantRootGenerators e i n))) hb'
  have hcartan {c : U} (hc : c ∈ C) {p : U} (hp : p ∈ P) : p * c ∈ P := by
    refine ((AddSubgroup.closure_le
      (P.comap (AddMonoidHom.mulRight c))).2 ?_) hp
    rintro _ ⟨a, ha, b, hb, rfl⟩
    -- Expose preimage membership so associativity can rewrite the product.
    change (a * b) * c ∈ P
    rw [mul_assoc]
    exact hprod ha (C.mul_mem hb hc)
  apply le_antisymm
  · intro u hu
    -- Left multipliers on the opposite ring are right multipliers on the original ring.
    let M := (P.comap (MulOpposite.opAddEquiv.symm.toAddMonoidHom)).multiplierRing.unop
    have hM {x : U} : x ∈ M ↔ ∀ p ∈ P, p * x ∈ P := by
      rw [Subring.mem_unop, AddSubgroup.mem_multiplierRing]
      -- Reindex the opposite-ring condition by the original ring's elements.
      exact MulOpposite.op_surjective.forall
    have hstable : kostantForm e h ≤ M := by
      apply (kostantForm_le_iff e h M).2
      constructor
      · intro i n
        exact hM.mpr fun p hp => hroot (dividedPower_mem_kostantRootGenerators e i n) hp
      · intro j n
        exact hM.mpr fun p hp => hcartan (Subring.subset_closure
          (ringChoose_mem_kostantCartanGenerators h j n)) hp
    have hone : (1 : U) ∈ P := by simpa only [mul_one] using hprod R.one_mem C.one_mem
    simpa only [one_mul] using hM.mp (hstable hu) 1 hone
  · have hR : R ≤ kostantForm e h := by
      rw [kostantForm_def]
      exact Subring.closure_mono Set.subset_union_left
    have hC : C ≤ kostantForm e h := by
      rw [kostantForm_def]
      exact Subring.closure_mono Set.subset_union_right
    apply (AddSubgroup.closure_le _).mpr
    rintro u ⟨a, ha, b, hb, rfl⟩
    exact (kostantForm e h).mul_mem (hR ha) (hC hb)

end TauCeti.UniversalEnvelopingAlgebra
