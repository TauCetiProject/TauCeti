/-!
# The Kostant orbit of a highest weight vector

Let `b` be a `LieAlgebra.Basis` of a rational Lie algebra `L`, with raising, lowering and Cartan
generators `eᵢ`, `fᵢ`, `hᵢ` and Cartan matrix `A`, and let `U_ℤ = b.kostantForm` be the subring of
`U(L)` generated by the divided powers `eᵢ⁽ⁿ⁾`, `fᵢ⁽ⁿ⁾` and the binomial coefficients
`(hᵢ choose n)`. For a representation `ρ` of `U(L)` and a vector `v` killed by every `eᵢ` and of
integral weight `μ`, this file describes the integral orbit `U_ℤ v` and proves that it is a
finitely generated abelian group when the representation is finite-dimensional.

The description is Steinberg's `U_ℤ v = U⁻_ℤ v`: the orbit is the `ℤ`-span of the vectors
`fᵢ₁⁽ⁿ¹⁾ ⋯ fᵢₖ⁽ⁿᵏ⁾ v`, the **lowering words** applied to `v`. One inclusion is clear. For the other,
the span of the lowering words is stable under every generator of `U_ℤ`:

* under `fᵢ⁽ⁿ⁾`, since this prepends a letter to a word;
* under the Cartan binomials, since each word applied to `v` is a weight vector of the integral
  weight `μ - ∑ nₖ αᵢₖ`, on which `(hⱼ - c choose k)` acts by an integer;
* under `eⱼ⁽ᵐ⁾`, by induction on the word: `eⱼ⁽ᵐ⁾` commutes with `fᵢ⁽ⁿ⁾` for `i ≠ j`, and for
  `i = j` the rank-one straightening formula `TauCeti.Sl2.dividedPower_ι_e_mul_dividedPower_ι_f`
  moves it past `fⱼ⁽ⁿ⁾` at the cost of integral Cartan binomials and lower divided powers, until
  it reaches `v`, which it kills.

This argument needs only the rank-one straightening formula, not the integral
Poincaré–Birkhoff–Witt theorem for the whole Kostant form.

Finite generation then follows from finiteness of the set of weights. Since the Cartan matrix is
nondegenerate, there is a rational combination `T` of the operators `ρ(hⱼ)` taking the value `1`
on every simple root, and `T` acts on a lowering word of total degree `d` applied to `v` by a
scalar that decreases by one per unit of degree. As `T` has finitely many eigenvalues, only words of
bounded degree survive, and finitely many words of bounded degree generate the orbit.

Together with the weight decomposition, these are the hypotheses under which
`TauCeti.UniversalEnvelopingAlgebra.kostantWeightBasis` gives the orbit a basis of weight vectors.

## Main definitions and results

* `LieAlgebra.Basis.loweringWord`: the product `fᵢ₁⁽ⁿ¹⁾ ⋯ fᵢₖ⁽ⁿᵏ⁾` attached to a list of letters.
* `LieAlgebra.Basis.isCartanWeightVector_loweringWord`: a lowering word lowers the weight of a
  weight vector by `∑ nₖ αᵢₖ`.
* `LieAlgebra.Basis.orbitOfRep_kostantForm_singleton_eq_span_loweringWord`: `U_ℤ v` is the
  `ℤ`-span of the lowering words applied to `v`.
* `LieAlgebra.Basis.fg_orbitOfRep_kostantForm_singleton`: in a finite-dimensional representation,
  `U_ℤ v` is finitely generated over `ℤ`.
* `LieAlgebra.Basis.mem_iSup_jointWeightSpace_of_mem_orbitOfRep_kostantForm_singleton`: `U_ℤ v`
  lies in the span of the integral weight spaces.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, AMS University Lecture Series 66 (2016),
  Chapter 2, Theorem 2 and its Corollary 1.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §26.2 and
  §27.1.
-/

public section

namespace LieAlgebra.Basis

open Set TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {ι L : Type*} [Finite ι] [LieRing L] [LieAlgebra ℚ L]
  {H : _root_.LieSubalgebra ℚ L} (b : _root_.LieAlgebra.Basis ι H)

attribute [local instance] TauCeti.moduleNNRat

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L

/-! ### Lowering words -/

/-- The **lowering word** of a list of letters `(iₖ, nₖ)`: the product `fᵢ₁⁽ⁿ¹⁾ ⋯ fᵢₖ⁽ⁿᵏ⁾` of
divided powers of the lowering generators in the universal enveloping algebra. -/
def loweringWord (l : List (ι × ℕ)) : U :=
  (l.map fun p =>
    TauCeti.Associative.dividedPower p.2 (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f p.1))).prod

/-- The empty lowering word is `1`. -/
@[simp]
theorem loweringWord_nil : b.loweringWord [] = 1 := by
  simp [loweringWord]

/-- Prepending a letter `(i, n)` multiplies a lowering word on the left by `fᵢ⁽ⁿ⁾`. -/
@[simp]
theorem loweringWord_cons (p : ι × ℕ) (l : List (ι × ℕ)) :
    b.loweringWord (p :: l) =
      TauCeti.Associative.dividedPower p.2 (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f p.1)) *
        b.loweringWord l := by
  simp [loweringWord]

/-- Letters of exponent zero contribute the factor `1`, so they can be dropped from a lowering
word. -/
theorem loweringWord_filter_ne_zero (l : List (ι × ℕ)) :
    b.loweringWord (l.filter fun p => p.2 ≠ 0) = b.loweringWord l := by
  induction l with
  | nil => rfl
  | cons p l ih =>
    by_cases hp : p.2 = 0 <;> simp_all

/-- Every lowering word lies in the simple-generator Kostant form. -/
theorem loweringWord_mem_kostantForm (l : List (ι × ℕ)) :
    b.loweringWord l ∈ b.kostantForm := by
  induction l with
  | nil => simp
  | cons p l ih =>
    have hf := b.dividedPower_mem_kostantForm (.inr p.1) p.2
    rw [rootGenerator_inr] at hf
    rw [loweringWord_cons]
    exact b.kostantForm.mul_mem hf ih

variable {V : Type*} [AddCommGroup V] [Module ℚ V]
  (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)

/-- **A lowering word lowers weights by its content.** If `v` is a weight vector of integral weight
`μ` for the Cartan generators, then the lowering word of `(i₁, n₁), …, (iₖ, nₖ)` applied to `v` is
a weight vector of weight `μ - ∑ nₖ αᵢₖ`, where the weight `αᵢ` of `eᵢ` is the `i`-th row of the
Cartan matrix. -/
theorem isCartanWeightVector_loweringWord {μ : ι → ℤ} {v : V}
    (hv : IsCartanWeightVector b.h ρ μ v) (l : List (ι × ℕ)) :
    IsCartanWeightVector b.h ρ (μ - (l.map fun p => p.2 • b.A p.1).sum)
      (ρ (b.loweringWord l) v) := by
  induction l with
  | nil => simpa using hv
  | cons p l ih =>
    have hα (j : ι) : ⁅b.h j, rootGenerator b (.inr p.1)⁆ =
        ((rootGeneratorWeight b (.inr p.1) j : ℤ) : ℚ) • rootGenerator b (.inr p.1) :=
      b.lie_h_rootGenerator (.inr p.1) j
    have h := ih.integralDividedPower (rootGenerator b) hα p.2
    have hw : rootGeneratorWeight b (.inr p.1) = -b.A p.1 := by
      ext j
      simp
    convert h using 1
    · simp only [hw, List.map_cons, List.sum_cons, smul_neg]
      abel
    · simp [Module.End.smul_def, TauCeti.Associative.map_dividedPower]

/-! ### The orbit of a highest weight vector -/

variable {μ : ι → ℤ} {v : V}

/-- Applying `fᵢ⁽ⁿ⁾` to a lowering word applied to `v` prepends the letter `(i, n)`. -/
private theorem dividedPower_f_apply_loweringWord (i : ι) (n : ℕ) (l : List (ι × ℕ)) :
    ρ (TauCeti.Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f i)))
        (ρ (b.loweringWord l) v) =
      ρ (b.loweringWord ((i, n) :: l)) v := by
  rw [loweringWord_cons, map_mul, Module.End.mul_apply]

/-- The divided powers of the lowering generators preserve the span of the lowering words applied
to `v`. -/
private theorem dividedPower_f_apply_mem_span_loweringWord (i : ι) (n : ℕ) {x : V}
    (hx : x ∈ Submodule.span ℤ (range fun l => ρ (b.loweringWord l) v)) :
    ρ (TauCeti.Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f i))) x ∈
      Submodule.span ℤ (range fun l => ρ (b.loweringWord l) v) :=
  (Submodule.image_span_subset (LinearMap.restrictScalars ℤ _) _ _).2 (by
    rintro _ ⟨l, rfl⟩
    rw [LinearMap.restrictScalars_apply, b.dividedPower_f_apply_loweringWord ρ]
    exact Submodule.subset_span ⟨_, rfl⟩) ⟨x, hx, rfl⟩

/-- The integer translates of the Cartan binomials preserve the span of the lowering words
applied to a weight vector of integral weight. -/
private theorem ringChoose_add_intCast_apply_mem_span_loweringWord
    (hv : IsCartanWeightVector b.h ρ μ v) (j : ι) (c : ℤ) (k : ℕ) {x : V}
    (hx : x ∈ Submodule.span ℤ (range fun l => ρ (b.loweringWord l) v)) :
    Ring.choose (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.h j)) + (c : Module.End ℚ V)) k x ∈
      Submodule.span ℤ (range fun l => ρ (b.loweringWord l) v) := by
  refine TauCeti.ringChoose_end_apply_mem_span_of_apply_eq_intCast_smul
    (weight := fun l => (μ - (l.map fun p => p.2 • b.A p.1).sum) j + c) (fun l => ?_) k hx
  rw [LinearMap.add_apply,
    (isCartanWeightVector_iff b.h ρ).1 (b.isCartanWeightVector_loweringWord ρ hv l) j]
  simp [add_smul, Int.cast_smul_eq_zsmul]

/-- The divided powers of the raising generators preserve the span of the lowering words applied
to a highest weight vector of integral weight: this is the induction on the word, using the
rank-one straightening formula to move `eⱼ⁽ᵐ⁾` past `fⱼ⁽ⁿ⁾`. -/
private theorem dividedPower_e_apply_loweringWord_mem_span
    (hv : IsCartanWeightVector b.h ρ μ v)
    (he : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0)
    (l : List (ι × ℕ)) (j : ι) (m : ℕ) :
    ρ (TauCeti.Associative.dividedPower m (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e j)))
        (ρ (b.loweringWord l) v) ∈
      Submodule.span ℤ (range fun l => ρ (b.loweringWord l) v) := by
  induction l generalizing m with
  | nil =>
    -- On `v` itself, `eⱼ⁽ᵐ⁾` is the identity for `m = 0` and zero otherwise.
    rw [loweringWord_nil, map_one, Module.End.one_apply]
    rcases m with _ | m
    · rw [TauCeti.Associative.dividedPower_zero, map_one, Module.End.one_apply]
      exact Submodule.subset_span ⟨[], by simp⟩
    · have h0 : TauCeti.Associative.dividedPower (m + 1)
          (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e j))) • v = 0 := by
        rw [TauCeti.Associative.dividedPower_apply_eq_zero_iff, pow_succ, Module.End.mul_apply,
          he, map_zero]
      rw [TauCeti.Associative.map_dividedPower, ← Module.End.smul_def, h0]
      exact zero_mem _
  | cons p l ih =>
    obtain ⟨i, n⟩ := p
    rw [loweringWord_cons, map_mul, Module.End.mul_apply, ← Module.End.mul_apply, ← map_mul]
    by_cases hji : j = i
    · -- Same index: straighten `eⱼ⁽ᵐ⁾ fⱼ⁽ⁿ⁾` into `fⱼ⁽ⁿ⁻ᵏ⁾ (hⱼ - m - n + 2k choose k) eⱼ⁽ᵐ⁻ᵏ⁾`.
      subst hji
      rw [TauCeti.Sl2.dividedPower_ι_e_mul_dividedPower_ι_f (b.sl2 j).lie_e_f
        (b.sl2 j).lie_h_e_nsmul (b.sl2 j).lie_h_f_nsmul m n, map_sum, LinearMap.sum_apply]
      refine Submodule.sum_mem _ fun k _ => ?_
      rw [map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply]
      refine b.dividedPower_f_apply_mem_span_loweringWord ρ j _ ?_
      have hshift : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.h j) - ((m + n : ℕ) : U) +
          ((2 * k : ℕ) : U)) = ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.h j)) +
            (((2 * k : ℕ) : ℤ) - ((m + n : ℕ) : ℤ) : ℤ) := by
        simp only [map_add, map_sub, map_natCast]
        push_cast
        abel
      rw [Ring.map_choose, hshift]
      exact b.ringChoose_add_intCast_apply_mem_span_loweringWord ρ hv j _ k (ih (m - k))
    · -- Different indices: `eⱼ` and `fᵢ` commute.
      have hc : Commute (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e j)))
          (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f i))) :=
        commute_of_lie_eq_zero ρ (b.lie_e_f_ne j i hji)
      have hcomm : ρ (TauCeti.Associative.dividedPower m
            (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e j)) *
          TauCeti.Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f i))) =
          ρ (TauCeti.Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f i))) *
            ρ (TauCeti.Associative.dividedPower m
              (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e j))) := by
        simp only [map_mul, TauCeti.Associative.map_dividedPower]
        exact (TauCeti.Associative.commute_dividedPower_dividedPower hc m n).eq
      rw [hcomm, Module.End.mul_apply]
      exact b.dividedPower_f_apply_mem_span_loweringWord ρ i n (ih m)

/-- **The Kostant orbit of a highest weight vector is spanned by its lowering words**
(Steinberg's `U_ℤ v = U⁻_ℤ v`). If `v` is killed by every raising generator and is a weight
vector of integral weight, then its orbit under the simple-generator Kostant form is the `ℤ`-span
of the vectors `fᵢ₁⁽ⁿ¹⁾ ⋯ fᵢₖ⁽ⁿᵏ⁾ v`. -/
theorem orbitOfRep_kostantForm_singleton_eq_span_loweringWord
    (hv : IsCartanWeightVector b.h ρ μ v)
    (he : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0) :
    Subring.orbitOfRep b.kostantForm ρ {v} =
      Submodule.span ℤ (range fun l => ρ (b.loweringWord l) v) := by
  refine le_antisymm ?_ ?_
  · rw [Subring.orbitOfRep_le_iff]
    rintro u hu x rfl
    refine kostantForm_apply_mem (rootGenerator b) b.h ρ _ (fun i n x hx => ?_)
      (fun j k x hx => ?_) u (by rwa [← kostantForm_def]) (Submodule.subset_span ⟨[], by simp⟩)
    · rcases i with i | i
      · rw [rootGenerator_inl]
        exact (Submodule.image_span_subset (LinearMap.restrictScalars ℤ _) _ _).2
          (by rintro _ ⟨l, rfl⟩; exact b.dividedPower_e_apply_loweringWord_mem_span ρ hv he l i n)
          ⟨x, hx, rfl⟩
      · rw [rootGenerator_inr]
        exact b.dividedPower_f_apply_mem_span_loweringWord ρ i n hx
    · have h := b.ringChoose_add_intCast_apply_mem_span_loweringWord ρ hv j 0 k hx
      rwa [Int.cast_zero, add_zero, ← Ring.map_choose] at h
  · rw [Submodule.span_le]
    rintro _ ⟨l, rfl⟩
    exact Subring.apply_mem_orbitOfRep _ _ _ (b.loweringWord_mem_kostantForm l) rfl

/-- **The Kostant orbit of a highest weight vector lies in the span of the integral weight
spaces**: each of its lowering words applied to `v` is a weight vector of integral weight. -/
theorem mem_iSup_jointWeightSpace_of_mem_orbitOfRep_kostantForm_singleton
    (hv : IsCartanWeightVector b.h ρ μ v)
    (he : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0)
    {x : V} (hx : x ∈ Subring.orbitOfRep b.kostantForm ρ {v}) :
    x ∈ ⨆ ν : ι → ℤ, jointWeightSpace b.h ρ ν := by
  rw [b.orbitOfRep_kostantForm_singleton_eq_span_loweringWord ρ hv he] at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, rfl⟩ := hx
    exact Submodule.mem_iSup_of_mem _
      ((mem_jointWeightSpace_iff b.h ρ).2 (b.isCartanWeightVector_loweringWord ρ hv l))
  | zero => exact zero_mem _
  | add x y _ _ hx hy => exact add_mem hx hy
  | smul z x _ hx => exact Submodule.smul_of_tower_mem _ z hx

/-! ### Finite generation -/

/-- A rational combination of the Cartan generators taking the value `1` on every simple root
exists because the Cartan matrix is nondegenerate. -/
private theorem exists_sum_A_mul_eq_one [Fintype ι] :
    ∃ y : ι → ℚ, ∀ i, ∑ j, (b.A i j : ℚ) * y j = 1 := by
  classical
  let A : Matrix ι ι ℚ := (Int.castRingHom ℚ).mapMatrix b.A
  have hA : IsUnit A.det := by
    rw [isUnit_iff_ne_zero, ← RingHom.map_det, eq_intCast, Int.cast_ne_zero]
    exact b.nondegen.det_ne_zero
  obtain ⟨y, h⟩ := Matrix.mulVec_surjective_iff_isUnit.2 (A.isUnit_iff_isUnit_det.2 hA) 1
  refine ⟨y, fun i => ?_⟩
  simpa [Matrix.mulVec, dotProduct, A] using congrFun h i

/-- The pairing of `y` with the weight of a lowering word applied to `v` drops by one per unit of
the total degree of the word. -/
private theorem sum_mul_weight_loweringWord [Fintype ι] {y : ι → ℚ}
    (hy : ∀ i, ∑ j, (b.A i j : ℚ) * y j = 1) (l : List (ι × ℕ)) :
    ∑ j, y j * (((μ - (l.map fun p => p.2 • b.A p.1).sum) j : ℤ) : ℚ) =
      ∑ j, y j * (μ j : ℚ) - ((l.map Prod.snd).sum : ℕ) := by
  induction l with
  | nil => simp
  | cons p l ih =>
    have hp : ∑ j, y j * (((p.2 • b.A p.1) j : ℤ) : ℚ) = p.2 := by
      calc _ = (p.2 : ℚ) * ∑ j, (b.A p.1 j : ℚ) * y j := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            simp only [Pi.smul_apply, nsmul_eq_mul, Int.cast_mul, Int.cast_natCast]
            ring
        _ = p.2 := by rw [hy p.1, mul_one]
    have hsplit (j : ι) : (((μ - ((p :: l).map fun p => p.2 • b.A p.1).sum) j : ℤ) : ℚ) =
        (((μ - (l.map fun p => p.2 • b.A p.1).sum) j : ℤ) : ℚ) - (((p.2 • b.A p.1) j : ℤ) : ℚ) := by
      simp only [List.map_cons, List.sum_cons, Pi.sub_apply, Pi.add_apply, Int.cast_sub,
        Int.cast_add]
      ring
    simp only [hsplit, mul_sub, Finset.sum_sub_distrib, ih, hp]
    simp only [List.map_cons, List.sum_cons, Nat.cast_add]
    ring

/-- The total degree of a lowering word that does not annihilate `v` is bounded, in a
finite-dimensional representation. -/
private theorem exists_sum_le_of_loweringWord_apply_ne_zero [FiniteDimensional ℚ V]
    (hv : IsCartanWeightVector b.h ρ μ v) :
    ∃ K : ℕ, ∀ l : List (ι × ℕ), ρ (b.loweringWord l) v ≠ 0 → (l.map Prod.snd).sum ≤ K := by
  classical
  have := Fintype.ofFinite ι
  obtain ⟨y, hy⟩ := b.exists_sum_A_mul_eq_one
  let T : Module.End ℚ V := ∑ j, y j • ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.h j))
  obtain ⟨B, hB⟩ := T.finite_hasEigenvalue.bddBelow
  refine ⟨⌈∑ j, y j * (μ j : ℚ) - B⌉₊, fun l hl => ?_⟩
  -- The lowering word applied to `v` is an eigenvector of `T`.
  have hT : T (ρ (b.loweringWord l) v) =
      (∑ j, y j * (μ j : ℚ) - ((l.map Prod.snd).sum : ℕ)) • ρ (b.loweringWord l) v := by
    rw [← b.sum_mul_weight_loweringWord hy l, Finset.sum_smul]
    simp only [T, LinearMap.sum_apply, LinearMap.smul_apply,
      (isCartanWeightVector_iff b.h ρ).1 (b.isCartanWeightVector_loweringWord ρ hv l), smul_smul]
  have heig : T.HasEigenvalue (∑ j, y j * (μ j : ℚ) - ((l.map Prod.snd).sum : ℕ)) :=
    Module.End.hasEigenvalue_of_hasEigenvector
      (Module.End.hasEigenvector_iff.2 ⟨Module.End.mem_eigenspace_iff.2 hT, hl⟩)
  have hle := hB heig
  exact_mod_cast (show (((l.map Prod.snd).sum : ℕ) : ℚ) ≤ ⌈∑ j, y j * (μ j : ℚ) - B⌉₊ by
    linarith [Nat.le_ceil (∑ j, y j * (μ j : ℚ) - B)])

/-- **The Kostant orbit of a highest weight vector is finitely generated.** In a
finite-dimensional representation, the orbit of a vector killed by every raising generator and of
integral weight is a finitely generated `ℤ`-submodule. -/
theorem fg_orbitOfRep_kostantForm_singleton [FiniteDimensional ℚ V]
    (hv : IsCartanWeightVector b.h ρ μ v)
    (he : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0) :
    (Subring.orbitOfRep b.kostantForm ρ {v}).FG := by
  obtain ⟨K, hK⟩ := b.exists_sum_le_of_loweringWord_apply_ne_zero ρ hv
  -- The words of length at most `K` with letters of exponent at most `K` suffice.
  let w : List (ι × Fin (K + 1)) → V := fun l =>
    ρ (b.loweringWord (l.map fun p => (p.1, (p.2 : ℕ)))) v
  rw [Submodule.fg_def]
  refine ⟨w '' {l | l.length ≤ K}, (List.finite_length_le _ K).image w, le_antisymm ?_ ?_⟩
  · rw [Submodule.span_le]
    rintro _ ⟨l, -, rfl⟩
    exact Subring.apply_mem_orbitOfRep _ _ _ (b.loweringWord_mem_kostantForm _) rfl
  · rw [b.orbitOfRep_kostantForm_singleton_eq_span_loweringWord ρ hv he, Submodule.span_le]
    rintro _ ⟨l, rfl⟩
    dsimp only
    by_cases hl : ρ (b.loweringWord l) v = 0
    · rw [hl]
      exact zero_mem _
    have hsum := hK l hl
    set l₀ := l.filter fun p => p.2 ≠ 0
    have hsub : (l₀.map Prod.snd).sum ≤ (l.map Prod.snd).sum :=
      ((List.filter_sublist).map Prod.snd).sum_le_sum fun _ _ => Nat.zero_le _
    have hlt : ∀ p ∈ l₀, p.2 < K + 1 := fun p hp =>
      Nat.lt_succ_of_le ((List.le_sum_of_mem (List.mem_map_of_mem
        (List.mem_of_mem_filter hp))).trans hsum)
    have hlen : l₀.length ≤ K := by
      refine le_trans ?_ (hsub.trans hsum)
      rw [← List.length_map Prod.snd]
      refine List.length_le_sum_of_one_le _ fun n hn => ?_
      obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hn
      exact Nat.one_le_iff_ne_zero.2 (by simpa using (List.mem_filter.1 hp).2)
    refine Submodule.subset_span ⟨l₀.pmap (fun p hp => (p.1, ⟨p.2, hp⟩)) hlt, ?_, ?_⟩
    · simpa using hlen
    · simp only [w, List.map_pmap, List.pmap_eq_map, List.map_id', l₀,
        b.loweringWord_filter_ne_zero]

end

end LieAlgebra.Basis
