module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.HopfAlgebra

/-!
# Integral Hopf functoriality of Kostant forms

A rational Lie homomorphism maps a Kostant form onto the form generated by the image root
and Cartan families. The restricted map `kostantFormMap` is a bialgebra homomorphism over `ℤ`,
not just a ring homomorphism: it respects the integral comultiplication and counit. This lets
transport of the integral enveloping form retain its Hopf operations, rather than checking
compatibility only after rationalization.

The compatibility proofs use `mapBialgHom` on rational enveloping algebras and the faithful
inclusion `kostantTensorMap` of the integral tensor square into the rational tensor square.
No generation, finite-dimensionality, or Chevalley relations are needed. Identity and
composition laws make the construction functorial in the Lie map.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

open scoped TensorProduct

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {I : Type v} {J : Type w}
variable {M : Type*} [LieRing M] [LieAlgebra ℚ M]
variable (f : L →ₗ⁅ℚ⁆ M) (e : I → L) (h : J → L)

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L
local notation "K" => kostantForm (L := L)

/-- The restriction of the rational enveloping map as an integral algebra map. -/
private noncomputable def kostantRestriction :
    K e h →ₐ[ℤ] kostantForm (fun i => f (e i)) (fun i => f (h i)) :=
  ((map ℚ f).toRingHom.restrict _ _ fun x hx => by
    rw [← map_kostantForm f e h]
    exact ⟨x, hx, rfl⟩).toIntAlgHom

private theorem coe_kostantRestriction (x : K e h) :
    (kostantRestriction f e h x : _root_.UniversalEnvelopingAlgebra ℚ M) = map ℚ f x :=
  (rfl)

private theorem kostantTensorMap_map_restriction (t : K e h ⊗[ℤ] K e h) :
    kostantTensorMap (fun i => f (e i)) (fun i => f (h i))
        (Algebra.TensorProduct.map (kostantRestriction f e h) (kostantRestriction f e h) t) =
      Algebra.TensorProduct.map (map ℚ f) (map ℚ f) (kostantTensorMap e h t) := by
  induction t using TensorProduct.inductionOn with
  | add x y hx hy => simp only [map_add, hx, hy]
  | tmul x y =>
      simp only [Algebra.TensorProduct.map_tmul, kostantTensorMap_tmul,
        coe_kostantRestriction]

/-- A Lie homomorphism induces a bialgebra homomorphism of the Kostant integral forms
attached to a family and its image. Thus comultiplication and counit commute with integral
transport, before extending scalars to the rationals. -/
noncomputable def kostantFormMap :
    K e h →ₐc[ℤ] kostantForm (fun i => f (e i)) (fun i => f (h i)) :=
  .ofAlgHom (kostantRestriction f e h)
    (by
      ext x
      apply Int.cast_injective (α := ℚ)
      simp only [AlgHom.comp_apply, Bialgebra.counitAlgHom_apply, kostantForm_counit,
        AlgHom.toLinearMap_apply, intCast_kostantFormCounit_apply, coe_kostantRestriction]
      simpa only [AlgHom.comp_apply, mapBialgHom_toAlgHom,
        Bialgebra.counitAlgHom_apply] using
        DFunLike.congr_fun (BialgHom.counitAlgHom_comp (mapBialgHom ℚ f)) (x : U))
    (by
      ext x
      apply kostantTensorMap_injective (fun i => f (e i)) (fun i => f (h i))
      simp only [AlgHom.comp_apply, Bialgebra.comulAlgHom_apply, kostantForm_comul,
        AlgHom.toLinearMap_apply, kostantTensorMap_map_restriction,
        kostantTensorMap_kostantFormComul_apply, coe_kostantRestriction]
      simpa only [AlgHom.comp_apply, mapBialgHom_toAlgHom,
        Bialgebra.comulAlgHom_apply] using
        DFunLike.congr_fun (BialgHom.map_comp_comulAlgHom (mapBialgHom ℚ f)) (x : U))

/-- The integral bialgebra map agrees with the rational enveloping-algebra map. -/
@[simp]
theorem coe_kostantFormMap_apply (x : K e h) :
    (kostantFormMap f e h x : _root_.UniversalEnvelopingAlgebra ℚ M) = map ℚ f x :=
  (rfl)

/-- The restricted map is onto the form generated by the image families. No surjectivity
hypothesis on the Lie homomorphism is needed. -/
theorem kostantFormMap_surjective : Function.Surjective (kostantFormMap f e h) := by
  intro y
  have hy : (y : _root_.UniversalEnvelopingAlgebra ℚ M) ∈
      (K e h).map (map ℚ f).toRingHom := by
    rw [map_kostantForm]
    exact y.property
  obtain ⟨x, hx, hxy⟩ := hy
  exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩

/-- The identity Lie map induces the identity integral bialgebra map. -/
@[simp]
theorem kostantFormMap_id :
    kostantFormMap (LieHom.id : L →ₗ⁅ℚ⁆ L) e h = BialgHom.id ℤ (K e h) := by
  apply BialgHom.ext
  intro x
  apply Subtype.ext
  rw [coe_kostantFormMap_apply, map_id]
  rfl

/-- Composition of Lie maps induces composition of the integral bialgebra maps. -/
@[simp]
theorem kostantFormMap_comp {N : Type*} [LieRing N] [LieAlgebra ℚ N]
    (g : M →ₗ⁅ℚ⁆ N) :
    kostantFormMap (g.comp f) e h =
      (kostantFormMap g (fun i => f (e i)) (fun i => f (h i))).comp
        (kostantFormMap f e h) := by
  apply BialgHom.ext
  intro x
  have hx : (kostantFormMap (g.comp f) e h x : _root_.UniversalEnvelopingAlgebra ℚ N) =
      (kostantFormMap g (fun i => f (e i)) (fun i => f (h i))
        (kostantFormMap f e h x) : _root_.UniversalEnvelopingAlgebra ℚ N) := by
    simp only [coe_kostantFormMap_apply, map_comp, AlgHom.comp_apply]
  exact (Subtype.ext hx).trans
    (BialgHom.comp_apply (kostantFormMap g (fun i => f (e i)) (fun i => f (h i)))
      (kostantFormMap f e h) x).symm

end TauCeti.UniversalEnvelopingAlgebra
