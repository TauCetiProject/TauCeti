/-!
# The Kostant orbit of a highest-weight vector

Let `b` be a `LieAlgebra.Basis` of a rational Lie algebra `L`, with raising generators `eᵢ`,
lowering generators `fᵢ` and Cartan generators `hᵢ`, and let `U_ℤ = b.kostantForm` be the
subring of `U(L)` generated by the divided powers `eᵢ⁽ⁿ⁾`, `fᵢ⁽ⁿ⁾` and the binomial coefficients
`(hᵢ choose n)`. Let `ρ` be a representation of `U(L)` on a rational vector space `V`, and let
`v ∈ V` be a highest-weight vector of integral weight `λ`:

```text
eᵢ v = 0,   hᵢ v = λᵢ v,   λᵢ ∈ ℤ.
```

This file proves that the integral orbit `U_ℤ · v` is the `ℤ`-span of the lowering monomials

```text
f_{i₁}^{(n₁)} f_{i₂}^{(n₂)} ⋯ f_{iₖ}^{(nₖ)} v,
```

that each of these is a weight vector of integral weight, and that the orbit is finitely
generated over `ℤ` as soon as `V` is finite-dimensional. If moreover `v` generates `V` as a
`U(L)`-module, then together with the existing stability and spanning results for Kostant orbits
this makes `U_ℤ · v` an admissible lattice in `V`, to which the weight-basis construction
`TauCeti.UniversalEnvelopingAlgebra.kostantWeightBasis` applies. In general the same holds with
`V` replaced by the `U(L)`-submodule generated by `v`.
This is Steinberg, *Lectures on Chevalley Groups*, Chapter 2, Corollary 1 to Theorem 2.

## Main definitions and results

* `LieAlgebra.Basis.loweringMonomial`: the lowering monomial of a word in the lowering generators.
* `LieAlgebra.Basis.isCartanWeightVector_loweringMonomial`: a lowering monomial applied to `v` is
  a weight vector, of weight `λ` minus the corresponding combination of simple roots.
* `LieAlgebra.Basis.orbitOfRep_kostantForm_eq_span_loweringMonomial`: the orbit `U_ℤ · v` is the
  integral span of the lowering monomials applied to `v`.
* `LieAlgebra.Basis.orbitOfRep_kostantForm_le_iSup_jointWeightSpace`: the orbit lies in the span
  of the integral joint weight spaces.
* `LieAlgebra.Basis.fg_orbitOfRep_kostantForm`: the orbit is finitely generated over `ℤ` when `V`
  is finite-dimensional.
* `LieAlgebra.Basis.exists_eq_zsmul_of_mem_orbitOfRep_kostantForm`: the vectors of weight `λ` in
  the orbit are the integral multiples of `v`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 2, Corollary 1 to Theorem 2.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §27.
-/

public section

namespace LieAlgebra.Basis

open Set TauCeti.UniversalEnvelopingAlgebra
open TauCeti.Associative (dividedPower)

variable {ι L : Type*} [Finite ι] [LieRing L] [LieAlgebra ℚ L]
  {H : _root_.LieSubalgebra ℚ L} (b : _root_.LieAlgebra.Basis ι H)
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
  (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)

attribute [local instance] TauCeti.moduleNNRat
attribute [local instance 100] LieRing.ofAssociativeRing

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L

/-! ## Lowering monomials -/

/-- The lowering monomial `f_{i₁}^{(n₁ + 1)} ⋯ f_{iₖ}^{(nₖ + 1)}` attached to the word
`[(i₁, n₁), …, (iₖ, nₖ)]`.

The exponents are shifted by one, so that every letter has positive degree; the divided power of
degree zero is `1` and contributes nothing to a monomial. -/
noncomputable def loweringMonomial (l : List (ι × ℕ)) : U :=
  (l.map fun p => dividedPower (p.2 + 1) (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f p.1))).prod

theorem loweringMonomial_def (l : List (ι × ℕ)) :
    b.loweringMonomial l =
      (l.map fun p => dividedPower (p.2 + 1)
        (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f p.1))).prod :=
  (rfl)

@[simp]
theorem loweringMonomial_nil : b.loweringMonomial [] = 1 := (rfl)

@[simp]
theorem loweringMonomial_cons (p : ι × ℕ) (l : List (ι × ℕ)) :
    b.loweringMonomial (p :: l) =
      dividedPower (p.2 + 1) (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f p.1)) *
        b.loweringMonomial l := by
  simp [loweringMonomial]

@[simp]
theorem loweringMonomial_append (l₁ l₂ : List (ι × ℕ)) :
    b.loweringMonomial (l₁ ++ l₂) = b.loweringMonomial l₁ * b.loweringMonomial l₂ := by
  simp [loweringMonomial]

/-- Every lowering monomial lies in the Kostant form of the basis. -/
theorem loweringMonomial_mem_kostantForm (l : List (ι × ℕ)) :
    b.loweringMonomial l ∈ b.kostantForm := by
  induction l with
  | nil => exact (b.kostantForm).one_mem
  | cons p l ih =>
    rw [loweringMonomial_cons]
    exact (b.kostantForm).mul_mem
      (by simpa using b.dividedPower_mem_kostantForm (.inr p.1) (p.2 + 1)) ih

/-! ## Weights of lowering monomials -/

variable {b ρ}
variable {v : V} {wt : ι → ℤ}

variable (b) in
/-- **Lowering monomials produce weight vectors.** If `v` has integral weight `λ`, then the
lowering monomial of a word `[(i₁, n₁), …, (iₖ, nₖ)]` sends it to a weight vector of weight
`λ - ∑ (nₖ + 1) αᵢₖ`, where `αᵢ` is the row `b.A i` of the Cartan matrix. -/
theorem isCartanWeightVector_loweringMonomial
    (hv : IsCartanWeightVector b.h ρ wt v)
    (l : List (ι × ℕ)) :
    IsCartanWeightVector b.h ρ
      (wt - (l.map fun p => (p.2 + 1) • b.A p.1).sum) (ρ (b.loweringMonomial l) v) := by
  induction l with
  | nil => simpa using hv
  | cons p l ih =>
    have hα : ∀ j, ⁅b.h j, b.f p.1⁆ = ((-b.A p.1) j : ℚ) • b.f p.1 := fun j => by
      rw [b.lie_h_f, Pi.neg_apply, Int.cast_smul_eq_zsmul]
    have h := IsCartanWeightVector.integralDividedPower b.f hα ih (p.2 + 1)
    rw [Module.End.smul_def, ← TauCeti.Associative.map_dividedPower] at h
    rw [loweringMonomial_cons, map_mul, Module.End.mul_apply]
    convert h using 2
    rw [List.map_cons, List.sum_cons, smul_neg]
    abel

/-! ## Stability of the span of the lowering monomials -/

/- The argument does not use the integral Poincaré–Birkhoff–Witt theorem. The span `N` of the
lowering monomials is visibly stable under the `fᵢ⁽ⁿ⁾`. The Cartan binomials preserve it because
it is spanned by vectors of integral weight. A raising divided power `eᵢ⁽ᵐ⁾` commutes with the
`fⱼ⁽ⁿ⁾` for `j ≠ i`, and the rank-one straightening formula
`TauCeti.Sl2.dividedPower_ι_e_mul_dividedPower_ι_f` moves it past `fᵢ⁽ⁿ⁾` at the cost of Cartan
binomials and smaller raising divided powers. An induction on the length of the monomial
therefore pushes it onto `v`, which it kills. -/

/-- The vector `v` is the lowering monomial of the empty word. -/
private theorem self_mem_span_loweringMonomial :
    v ∈ Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v) :=
  Submodule.subset_span ⟨[], by simp⟩

/-- An element of `U(L)` preserves the span of the lowering monomials as soon as it sends every
lowering monomial into it. -/
private theorem apply_mem_span_loweringMonomial {u : U}
    (hu : ∀ l, ρ u (ρ (b.loweringMonomial l) v) ∈
      Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v))
    {x : V} (hx : x ∈ Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v)) :
    ρ u x ∈ Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v) := by
  have hle : Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v) ≤
      (Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v)).comap
        ((ρ u).restrictScalars ℤ) :=
    Submodule.span_le.2 (range_subset_iff.2 hu)
  exact hle hx

/-- The divided powers of a lowering generator preserve the span of the lowering monomials. -/
private theorem dividedPower_ι_f_apply_mem_span (i : ι) (n : ℕ) {x : V}
    (hx : x ∈ Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v)) :
    ρ (dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f i))) x ∈
      Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v) := by
  refine apply_mem_span_loweringMonomial (fun l => ?_) hx
  cases n with
  | zero => simpa using Submodule.subset_span (mem_range_self l)
  | succ n =>
    refine Submodule.subset_span ⟨(i, n) :: l, ?_⟩
    simp [map_mul, Module.End.mul_apply]

/-- A binomial coefficient of an element acting on every lowering monomial by an integer
preserves the span of the lowering monomials. -/
private theorem ringChoose_apply_mem_span {y : U}
    (hy : ∀ l, ∃ z : ℤ, ρ y (ρ (b.loweringMonomial l) v) = (z : ℚ) • ρ (b.loweringMonomial l) v)
    (k : ℕ) {x : V} (hx : x ∈ Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v)) :
    ρ (Ring.choose y k) x ∈ Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v) := by
  choose z hz using hy
  rw [Ring.map_choose]
  exact TauCeti.ringChoose_end_apply_mem_span_of_apply_eq_intCast_smul hz k hx

/-- An integer translate of a Cartan generator acts on each lowering monomial by an integer. -/
private theorem exists_ι_h_add_intCast_apply_loweringMonomial
    (hv : IsCartanWeightVector b.h ρ wt v) (j : ι) (c : ℤ) (l : List (ι × ℕ)) :
    ∃ z : ℤ, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.h j) + (c : U))
        (ρ (b.loweringMonomial l) v) = (z : ℚ) • ρ (b.loweringMonomial l) v := by
  refine ⟨(wt - (l.map fun p => (p.2 + 1) • b.A p.1).sum) j + c, ?_⟩
  rw [map_add, map_intCast, LinearMap.add_apply,
    (isCartanWeightVector_iff b.h ρ).1 (b.isCartanWeightVector_loweringMonomial hv l) j,
    Module.End.intCast_apply, ← Int.cast_smul_eq_zsmul ℚ, ← add_smul]
  push_cast
  rfl

/-- **Raising divided powers on lowering monomials.** If `v` is a highest-weight vector of
integral weight, a divided power of a raising generator sends every lowering monomial applied to
`v` into the integral span of those monomials. -/
private theorem dividedPower_ι_e_apply_loweringMonomial_mem
    (hv : IsCartanWeightVector b.h ρ wt v)
    (hve : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0) (i : ι)
    (l : List (ι × ℕ)) (m : ℕ) :
    ρ (dividedPower m (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)))
        (ρ (b.loweringMonomial l) v) ∈
      Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v) := by
  induction l generalizing m with
  | nil =>
    cases m with
    | zero => simpa using self_mem_span_loweringMonomial
    | succ m =>
      have h0 := (TauCeti.Associative.dividedPower_apply_eq_zero_iff
        (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i))) (m + 1) v).2
          (by rw [pow_succ, Module.End.mul_apply, hve i, map_zero])
      rw [Module.End.smul_def] at h0
      rw [loweringMonomial_nil, map_one, Module.End.one_apply, TauCeti.Associative.map_dividedPower,
        h0]
      exact Submodule.zero_mem _
  | cons p l ih =>
    obtain ⟨j, k⟩ := p
    rw [loweringMonomial_cons, map_mul, Module.End.mul_apply, ← Module.End.mul_apply, ← map_mul]
    by_cases hij : j = i
    · subst hij
      have hsl2 := b.sl2 j
      rw [TauCeti.Sl2.dividedPower_ι_e_mul_dividedPower_ι_f hsl2.lie_e_f hsl2.lie_h_e_nsmul
        hsl2.lie_h_f_nsmul, map_sum, LinearMap.sum_apply]
      refine Submodule.sum_mem _ fun r _ => ?_
      rw [map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply]
      refine dividedPower_ι_f_apply_mem_span j _ (ringChoose_apply_mem_span (fun l' => ?_) r
        (ih (m - r)))
      obtain ⟨z, hz⟩ := exists_ι_h_add_intCast_apply_loweringMonomial hv j
        ((2 * r : ℕ) - (m + (k + 1) : ℕ) : ℤ) l'
      exact ⟨z, by rw [← hz]; congr 2; push_cast; abel⟩
    · have hcomm : Commute (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i))
          (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.f j)) := by
        rw [commute_iff_lie_eq, ← LieHom.map_lie, b.lie_e_f_ne i j (Ne.symm hij), map_zero]
      rw [(TauCeti.Associative.commute_dividedPower_dividedPower hcomm m (k + 1)).eq, map_mul,
        Module.End.mul_apply]
      exact dividedPower_ι_f_apply_mem_span j (k + 1) (ih m)

/-- **The span of the lowering monomials is stable under the Kostant form.** -/
private theorem kostantForm_le_stabilizer_span_loweringMonomial
    (hv : IsCartanWeightVector b.h ρ wt v)
    (hve : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0) :
    b.kostantForm ≤
      stabilizer ρ (Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v)) := by
  rw [kostantForm_def]
  refine kostantForm_le_stabilizer _ _ _ _ (fun i n x hx => ?_) (fun j n x hx => ?_)
  · cases i with
    | inl i =>
      rw [rootGenerator_inl]
      exact apply_mem_span_loweringMonomial
        (fun l => dividedPower_ι_e_apply_loweringMonomial_mem hv hve i l n) hx
    | inr i =>
      rw [rootGenerator_inr]
      exact dividedPower_ι_f_apply_mem_span i n hx
  · refine ringChoose_apply_mem_span (fun l => ?_) n hx
    simpa using exists_ι_h_add_intCast_apply_loweringMonomial hv j 0 l

variable (b) in
/-- **The Kostant orbit of a highest-weight vector.** If `v` is annihilated by the raising
generators and has integral weight, then its orbit under the Kostant form is the integral span of
the lowering monomials applied to `v`. -/
theorem orbitOfRep_kostantForm_eq_span_loweringMonomial
    (hv : IsCartanWeightVector b.h ρ wt v)
    (hve : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0) :
    Subring.orbitOfRep b.kostantForm ρ {v} =
      Submodule.span ℤ (range fun l => ρ (b.loweringMonomial l) v) := by
  refine le_antisymm ((Subring.orbitOfRep_le_iff _ _ _ _).2 fun u hu x hx => ?_)
    (Submodule.span_le.2 (range_subset_iff.2 fun l =>
      Subring.apply_mem_orbitOfRep _ _ _ (b.loweringMonomial_mem_kostantForm l)
        (mem_singleton v)))
  rw [mem_singleton_iff.1 hx]
  exact (mem_stabilizer_iff ρ _ u).1
    (kostantForm_le_stabilizer_span_loweringMonomial hv hve hu) v
    self_mem_span_loweringMonomial

variable (b) in
/-- **The Kostant orbit of a highest-weight vector has integral weights.** Every element of the
orbit is a sum of weight vectors of integral weight. This is the weight hypothesis of
`TauCeti.UniversalEnvelopingAlgebra.kostantWeightBasis`. -/
theorem orbitOfRep_kostantForm_le_iSup_jointWeightSpace
    (hv : IsCartanWeightVector b.h ρ wt v)
    (hve : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0) :
    Subring.orbitOfRep b.kostantForm ρ {v} ≤
      (⨆ μ : ι → ℤ, jointWeightSpace b.h ρ μ).restrictScalars ℤ := by
  rw [b.orbitOfRep_kostantForm_eq_span_loweringMonomial hv hve]
  refine Submodule.span_le.2 (range_subset_iff.2 fun l => ?_)
  exact Submodule.mem_iSup_of_mem _
    ((mem_jointWeightSpace_iff b.h ρ).2 (b.isCartanWeightVector_loweringMonomial hv l))

/-! ## Finite generation -/

section Finite

/- Finite generation uses a height element. The Cartan matrix of `b` is nondegenerate, so there
is a rational combination `h₀` of the `hⱼ` with `αᵢ(h₀) = 1` for every simple root. A lowering
monomial of total degree `d` lowers the `h₀`-eigenvalue by exactly `d`; since `h₀` has only
finitely many eigenvalues on a finite-dimensional `V`, the monomials of large degree vanish on
`v`, and the remaining ones form a finite set. -/

/-- Pairing the simple-root combination of a word with a height vector returns the total degree
of the word. -/
private theorem sum_mul_sum_map_eq [Fintype ι] {a : ι → ℚ}
    (ha : ∀ i, ∑ j, (b.A i j : ℚ) * a j = 1) (l : List (ι × ℕ)) :
    ∑ j, a j * ((l.map fun p => (p.2 + 1) • b.A p.1).sum j : ℚ) =
      ((l.map fun p => p.2 + 1).sum : ℕ) := by
  induction l with
  | nil => simp
  | cons p l ih =>
    have hp : ∑ j, a j * (((p.2 + 1) • b.A p.1) j : ℚ) = ((p.2 + 1 : ℕ) : ℚ) := by
      calc ∑ j, a j * (((p.2 + 1) • b.A p.1) j : ℚ)
          = ((p.2 + 1 : ℕ) : ℚ) * ∑ j, (b.A p.1 j : ℚ) * a j := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            simp only [Pi.smul_apply, nsmul_eq_mul, Int.cast_mul, Int.cast_natCast]
            ring
        _ = ((p.2 + 1 : ℕ) : ℚ) := by rw [ha, mul_one]
    rw [List.map_cons, List.sum_cons, List.map_cons, List.sum_cons]
    simp only [Pi.add_apply, Int.cast_add, mul_add, Finset.sum_add_distrib]
    rw [hp, ih]
    push_cast
    ring

/-- **A height endomorphism.** Some rational combination `T` of the Cartan generators acts on
every vector of weight `λ` by a scalar `c`, and on the lowering monomial of a word of total degree
`d` applied to `v` by `c - d`. -/
private theorem exists_height_endomorphism
    (hv : IsCartanWeightVector b.h ρ wt v) :
    ∃ (T : Module.End ℚ V) (c : ℚ),
      (∀ y, IsCartanWeightVector b.h ρ wt y → T y = c • y) ∧
      ∀ l : List (ι × ℕ), T (ρ (b.loweringMonomial l) v) =
        (c - ((l.map fun p => p.2 + 1).sum : ℕ)) • ρ (b.loweringMonomial l) v := by
  have := Fintype.ofFinite ι
  obtain ⟨a, ha⟩ := b.exists_sum_A_mul_eq_one ℚ
  have hT : ∀ (μ : ι → ℤ) (y : V),
      IsCartanWeightVector b.h ρ μ y →
        (∑ j, a j • ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.h j))) y =
          (∑ j, a j * μ j) • y := by
    intro μ y hy
    simp only [LinearMap.sum_apply, LinearMap.smul_apply,
      (isCartanWeightVector_iff b.h ρ).1 hy, smul_smul,
      ← Finset.sum_smul]
  refine ⟨∑ j, a j • ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.h j)), ∑ j, a j * wt j,
    hT wt, fun l => ?_⟩
  rw [hT _ _ (b.isCartanWeightVector_loweringMonomial hv l)]
  congr 1
  rw [← sum_mul_sum_map_eq ha l, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [Pi.sub_apply, Int.cast_sub]
  ring

/-- **Lowering monomials of large degree kill `v`.** On a finite-dimensional module, the lowering
monomials that do not annihilate a vector of integral weight have bounded total degree. -/
private theorem exists_forall_loweringMonomial_ne_zero_le [FiniteDimensional ℚ V]
    (hv : IsCartanWeightVector b.h ρ wt v) :
    ∃ K : ℕ, ∀ l : List (ι × ℕ), ρ (b.loweringMonomial l) v ≠ 0 →
      (l.map fun p => p.2 + 1).sum ≤ K := by
  obtain ⟨T, c, -, hT⟩ := exists_height_endomorphism hv
  obtain ⟨D, hD⟩ := ((Module.End.finite_hasEigenvalue T).image (c - ·)).bddAbove
  refine ⟨⌈D⌉₊, fun l hl => ?_⟩
  have hev : T.HasEigenvalue (c - ((l.map fun p => p.2 + 1).sum : ℕ)) :=
    Module.End.hasEigenvalue_of_hasEigenvector
      (Module.End.hasEigenvector_iff.2 ⟨Module.End.mem_eigenspace_iff.2 (hT l), hl⟩)
  have hle : (((l.map fun p => p.2 + 1).sum : ℕ) : ℚ) ≤ D := hD ⟨_, hev, by ring⟩
  exact_mod_cast hle.trans (Nat.le_ceil D)

variable (b) in
/-- **The Kostant orbit of a highest-weight vector is finitely generated.** If `V` is
finite-dimensional and `v` is annihilated by the raising generators and has integral weight, its
orbit `U_ℤ · v` under the Kostant form is a finitely generated `ℤ`-module. -/
theorem fg_orbitOfRep_kostantForm [FiniteDimensional ℚ V]
    (hv : IsCartanWeightVector b.h ρ wt v)
    (hve : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0) :
    (Subring.orbitOfRep b.kostantForm ρ {v}).FG := by
  obtain ⟨K, hK⟩ := exists_forall_loweringMonomial_ne_zero_le hv
  rw [b.orbitOfRep_kostantForm_eq_span_loweringMonomial hv hve]
  convert Submodule.fg_span ((List.finite_setOf_sum_map_snd_add_one_le ι K).image
    fun l => ρ (b.loweringMonomial l) v) using 1
  refine le_antisymm (Submodule.span_le.2 (range_subset_iff.2 fun l => ?_))
    (Submodule.span_mono (image_subset_range _ _))
  by_cases hl : ρ (b.loweringMonomial l) v = 0
  · rw [hl]
    exact Submodule.zero_mem _
  · exact Submodule.subset_span ⟨l, hK l hl, rfl⟩

variable (b) in
/-- **The highest weight occurs once in the Kostant orbit.** If `v` is annihilated by the raising
generators and has integral weight `λ`, then every vector of weight `λ` in its orbit `U_ℤ · v` is
an integral multiple of `v`. -/
theorem exists_eq_zsmul_of_mem_orbitOfRep_kostantForm
    (hv : IsCartanWeightVector b.h ρ wt v)
    (hve : ∀ i, ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (b.e i)) v = 0) {x : V}
    (hx : x ∈ Subring.orbitOfRep b.kostantForm ρ {v})
    (hxw : IsCartanWeightVector b.h ρ wt x) :
    ∃ n : ℤ, x = n • v := by
  classical
  obtain ⟨T, c, hTw, hT⟩ := exists_height_endomorphism hv
  rw [b.orbitOfRep_kostantForm_eq_span_loweringMonomial hv hve,
    Finsupp.mem_span_range_iff_exists_finsupp] at hx
  obtain ⟨f, rfl⟩ := hx
  refine ⟨f [], sub_eq_zero.1 ?_⟩
  -- The remainder after removing the empty word lies in the `T`-eigenspace of `c`, and also in
  -- the span of the eigenspaces of the strictly smaller eigenvalues of the nonempty words.
  have hrest : (f.sum fun l n => n • ρ (b.loweringMonomial l) v) - f [] • v =
      ∑ l ∈ f.support.erase [], f l • ρ (b.loweringMonomial l) v := by
    by_cases h : [] ∈ f.support
    · rw [Finset.sum_erase_eq_sub h, Finsupp.sum]
      simp
    · rw [Finset.erase_eq_of_notMem h, Finsupp.notMem_support_iff.1 h, zero_smul, sub_zero,
        Finsupp.sum]
  refine Submodule.disjoint_def.1 ((Module.End.eigenspaces_iSupIndep T) c) _
    (Module.End.mem_eigenspace_iff.2 ?_) ?_
  · rw [map_sub, map_zsmul, hTw _ hxw, hTw _ hv, smul_sub, smul_comm]
  · rw [hrest]
    refine Submodule.sum_mem _ fun l hl => ?_
    have hne : c - ((l.map fun p => p.2 + 1).sum : ℕ) ≠ c := by
      obtain _ | ⟨p, l⟩ := l
      · exact absurd rfl (Finset.ne_of_mem_erase hl)
      · simp only [List.map_cons, List.sum_cons, ne_eq, sub_eq_self, Nat.cast_eq_zero]
        omega
    exact Submodule.mem_iSup_of_mem _ (Submodule.mem_iSup_of_mem hne
      (Submodule.smul_of_tower_mem _ _ (Module.End.mem_eigenspace_iff.2 (hT l))))

end Finite

end LieAlgebra.Basis
